note ---- byte helpers over m ----

note mat: true when m[ps..ps+len t) equals t and the match ends at or before lim
fn mat ps ulong lim ulong t view uchar * to bool
n = len t
if gt add ps n lim
ret false
end
i = ulong 0
while lt i n bound 4096
if ne get m add ps i get t i
ret false
end
i = add i 1
end
ret true
end

fn ishex c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 102
ret true
end
ret false
end

note hex40: exactly 40 lowercase hex digits at m[ps..ps+40), all before lim
fn hex40 ps ulong lim ulong to bool
if gt add ps 40 lim
ret false
end
i = ulong 0
while lt i 40 bound 40
if eq ishex get m add ps i false
ret false
end
i = add i 1
end
ret true
end

note hexn: exactly n lowercase hex digits at m[ps..ps+n)
fn hexn ps ulong n ulong to bool
i = ulong 0
while lt i n bound 4096
if eq ishex get m add ps i false
ret false
end
i = add i 1
end
ret true
end

note argis: argument i is exactly the text t
fn argis i ulong t view uchar * to bool
n = argread i m add kx 5120 4096
if lt n 0
ret false
end
if ne ulong n len t
ret false
end
ret mat add kx 5120 add add kx 5120 len t t
end

fn eqr a ulong b ulong n ulong to bool
i = ulong 0
while lt i n bound 65536
if ne get m add a i get m add b i
ret false
end
i = add i 1
end
ret true
end

fn cpy dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 65536
put m add dst i get m add src i
i = add i 1
end
end

fn tcpy dst ulong t view uchar * to ulong
n = len t
i = ulong 0
while lt i n bound 4096
put m add dst i get t i
i = add i 1
end
ret n
end

note eol: offset of the next newline at or after ps, or lim when there is none
fn eol ps ulong lim ulong to ulong
p = ps
while lt p lim bound 1048576
if eq get m p 10
ret p
end
p = add p 1
end
ret p
end

note ---- output line ----

fn obyte c uchar to void
w = get g 0
if ge w wcap
trap 12
end
put m add kw w c
put g 0 add w 1
end

fn otext t view uchar * to void
i = ulong 0
n = len t
while lt i n bound 4096
obyte get t i
i = add i 1
end
end

fn ocopy ps ulong n ulong to void
i = ulong 0
while lt i n bound 8192
obyte get m add ps i
i = add i 1
end
end

fn onum v ulong to void
b = new uchar 24 0
i = ulong 24
x = v
c = true
while c bound 24
i = sub i 1
put b i uchar add 48 rem x 10
x = div x 10
if eq x 0
c = false
end
end
while lt i 24 bound 24
obyte get b i
i = add i 1
end
end

fn oflush fd int to void
w = get g 0
o = ulong 0
c = true
while c bound 8192
if ge o w
c = false
else
r = write fd m add kw o sub w o
if le r 0
c = false
else
o = add o ulong r
end
end
end
put g 0 0
end

fn oreason c int to void
if eq c 0
otext tok
end
if eq c 1
otext tusage
end
if eq c 2
otext tbadh
end
if eq c 3
otext tvunr
end
if eq c 4
otext tvmal
end
if eq c 5
otext tvmaf
end
if eq c 6
otext tvrej
end
if eq c 7
otext thmis
end
if eq c 8
otext tnorv
end
if eq c 9
otext trunr
end
if eq c 10
otext trmal
end
if eq c 11
otext tnong
end
if eq c 12
otext tcmis
end
if eq c 13
otext tgfail
end
if eq c 14
otext tnpass
end
if eq c 15
otext tself
end
if eq c 16
otext tvamb
end
if eq c 17
otext tramb
end
end

note odecis: "MERGE OK" or "HOLD <CODE>" into the output line
fn odecis c int to void
if eq c 0
otext tmrgw
else
otext tholdw
end
oreason c
end

note ---- file loading ----

note load: read the file named by m[kp..kp+pn) into m[ps..ps+cap); return its length, or -1 when
note it cannot be opened or read or does not fit (a file of cap bytes or more does not fit)
fn load pn ulong ps ulong cap ulong to long
fl = fopen m kp pn 524288 0
if lt fl 0
ret -1
end
fd = int fl
n = ulong 0
r = long 0
c = true
while c bound 1048576
if ge n cap
c = false
else
r = read fd m add ps n sub cap n
if le r 0
c = false
else
n = add n ulong r
end
end
end
x = fclose fd
if lt r 0
ret -1
end
if ge n cap
ret -1
end
ret long n
end

note ---- verdict ----

note pverd: line 1 is exactly "VERDICT <MERGE|MERGE_AFTER_FIX|REJECT> head=<40 lowercase hex>"
note followed by a newline or the end of the file. Return 0 or 4 (VERDICT_MALFORMED).
fn pverd to int
n = add kv get g 1
if eq mat kv n tverd false
ret 4
end
p = add kv 8
k = ulong 0
if mat p n tmaf
k = ulong 2
p = add p 16
else
if mat p n tmrg
k = ulong 1
p = add p 6
else
if mat p n trej
k = ulong 3
p = add p 7
end
end
end
if eq k 0
ret 4
end
if eq mat p n thead false
ret 4
end
p = add p 5
if eq hex40 p n false
ret 4
end
q = add p 40
if lt q n
c = get m q
if ne c 10
ret 4
end
end
put g 3 k
put g 4 p
ret scanv n
end

note scanv: no later line may start with VERDICT, and at most one line starts with reviewer=.
note The reviewer value names a reviewer only when it holds a printable ASCII byte (33..126);
note a control byte in it (below 32 other than tab, or 127) is malformed.
fn scanv n ulong to int
p = add eol kv n 1
put g 5 0
put g 6 0
seen = false
while lt p n bound 65536
e = eol p n
if mat p e tvw
ret 4
end
if mat p e trevw
if seen
ret 4
end
seen = true
t = txtchk add p 9 e
if eq t 2
ret 4
end
if eq t 0
put g 5 add p 9
put g 6 sub e add p 9
end
end
p = add e 1
end
ret 0
end

note txtchk: m[v..e) as asserted text: 0 when it holds a byte in 33..126 and no control byte,
note 1 when it is empty or only spaces, tabs and bytes of 128 and above, 2 on a control byte
fn txtchk v ulong e ulong to int
p = v
vis = false
while lt p e bound 65536
c = get m p
if and lt c 32 ne c 9
ret 2
end
if eq c 127
ret 2
end
if and gt c 32 lt c 127
vis = true
end
p = add p 1
end
if vis
ret 0
end
ret 1
end

note ---- gate receipt (forge-receipt v1) ----

note pdec: 1 to 3 decimal digits in m[v..e), value at most 255; 1000 means malformed
fn pdec v ulong e ulong to ulong
n = sub e v
if or eq n 0 gt n 3
ret 1000
end
x = ulong 0
i = v
while lt i e bound 3
c = get m i
if or lt c 48 gt c 57
ret 1000
end
x = add mul x 10 ulong sub c 48
i = add i 1
end
if gt x 255
ret 1000
end
ret x
end

note ridok: m[p..p+n) is "rad:" then 1 to 60 ASCII letters and digits
fn ridok p ulong n ulong to bool
if or lt n 5 gt n 64
ret false
end
if eq mat p add p 4 trpfx false
ret false
end
i = ulong 4
while lt i n bound 64
c = get m add p i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 65 le c 90
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq ok false
ret false
end
i = add i 1
end
ret true
end

note ronce: receipt key bit seen at most once; return 0 or 10
fn ronce bit ulong to int
s = get g 12
if ne and s bit 0
ret 10
end
put g 12 or s bit
ret 0
end

note rhex: the value of key t in m[p..e) is exactly n lowercase hex digits; return 0 or 10
fn rhex p ulong e ulong t view uchar * bit ulong n ulong to int
v = add p len t
if ne sub e v n
ret 10
end
if eq hexn v n false
ret 10
end
ret ronce bit
end

note isoz: m[v..e) is a UTC time YYYY-MM-DDTHH:MM:SSZ (digits where tiso has 0)
fn isoz v ulong e ulong to bool
if ne sub e v 20
ret false
end
i = ulong 0
while lt i 20 bound 20
c = get m add v i
w = get tiso i
if eq w 48
if or lt c 48 gt c 57
ret false
end
else
if ne c w
ret false
end
end
i = add i 1
end
ret true
end

note rkey: one key=value line m[p..e). Known keys only, each at most once.
fn rkey p ulong e ulong to int
s = get g 12
if mat p e tclone
if ne and s 1 0
ret 10
end
v = add p 6
if ne sub e v 40
ret 10
end
if eq hex40 v e false
ret 10
end
put g 7 v
put g 12 or s 1
ret 0
end
if mat p e tgate
if ne and s 2 0
ret 10
end
d = pdec add p 8 e
if eq d 1000
ret 10
end
put g 8 d
put g 12 or s 2
ret 0
end
if mat p e tneg
if ne and s 4 0
ret 10
end
d = pdec add p 10 e
if eq d 1000
ret 10
end
put g 9 d
put g 12 or s 4
ret 0
end
if mat p e tauth
if ne and s 8 0
ret 10
end
v = add p 7
if ne txtchk v e 0
ret 10
end
put g 10 v
put g 11 sub e v
put g 12 or s 8
ret 0
end
if mat p e tgcmd
if ne and s 16 0
ret 10
end
put g 12 or s 16
ret 0
end
if mat p e tncmd
if ne and s 32 0
ret 10
end
put g 12 or s 32
ret 0
end
if mat p e ttree
ret rhex p e ttree 64 40
end
if mat p e tridk
if eq ridok add p 4 sub e add p 4 false
ret 10
end
ret ronce 128
end
if mat p e tomck
if and eq sub e p 8 mat add p 4 e tnone
ret ronce 256
end
ret rhex p e tomck 256 64
end
if mat p e tstart
if eq isoz add p 8 e false
ret 10
end
ret ronce 512
end
if mat p e tfin
if eq isoz add p 9 e false
ret 10
end
ret ronce 1024
end
if mat p e tlsha
ret rhex p e tlsha 2048 64
end
if mat p e tnlsha
ret rhex p e tnlsha 4096 64
end
ret 10
end

note prcpt: return 0, 10 (RECEIPT_MALFORMED) or 11 (NO_NEGCTL)
fn prcpt to int
n = add kr get g 2
if eq mat kr n trch false
ret 10
end
p = add kr 17
put g 12 0
while lt p n bound 4096
e = eol p n
r = rkey p e
if ne r 0
ret r
end
p = add e 1
end
s = get g 12
if ne and s 11 11
ret 10
end
if eq and s 4 0
ret 11
end
ret 0
end

note ispun: a space or an ASCII punctuation byte
fn ispun c uchar to bool
if eq c 32
ret true
end
if and ge c 33 le c 47
ret true
end
if and ge c 58 le c 64
ret true
end
if and ge c 91 le c 96
ret true
end
if and ge c 123 le c 126
ret true
end
ret false
end

note nstrip: drop spaces and ASCII punctuation from both ends of m[d..d+n); return the new length
fn nstrip d ulong n ulong to ulong
e = n
c = true
while c bound 65536
if eq e 0
c = false
else
if ispun get m add d sub e 1
e = sub e 1
else
c = false
end
end
end
s = ulong 0
c = true
while c bound 65536
if ge s e
c = false
else
if ispun get m add d s
s = add s 1
else
c = false
end
end
end
cpy d add d s sub e s
ret sub e s
end

note norm: copy m[src..src+n) to m[dst..) folded to ASCII lower case; spaces, tabs, "_" and "-"
note count as spaces and each run of them becomes one space; then spaces and ASCII punctuation
note are stripped from both ends. Return the copied length. Unicode is not folded.
fn norm src ulong n ulong dst ulong to ulong
o = ulong 0
last = ulong 32
i = ulong 0
while lt i n bound 65536
c = ulong get m add src i
if or or eq c 32 eq c 9 or eq c 95 eq c 45
if ne last 32
put m add dst o 32
o = add o 1
last = ulong 32
end
else
if and ge c 65 le c 90
c = add c 32
end
put m add dst o uchar c
o = add o 1
last = c
end
i = add i 1
end
ret nstrip dst o
end

note hasauth: the normalized reviewer text contains the normalized receipt author (the author
note reviewed its own work). An author that normalizes to nothing counts as self-review.
fn hasauth to bool
rn = norm get g 5 get g 6 kna
an = norm get g 10 get g 11 knb
if eq an 0
ret true
end
if gt an rn
ret false
end
i = ulong 0
lim = sub rn an
while le i lim bound 65536
if eqr add kna i knb an
ret true
end
i = add i 1
end
ret false
end

note ---- the merge decision ----

note decide: vr and rr are the verdict and receipt load results; the patch head is m[kh..kh+40).
note The first failing invariant is the reason. 0 is MERGE; everything else is HOLD.
fn decide vr long rr long to int
if eq hex40 kh add kh 40 false
ret 2
end
if le vr 0
ret 3
end
c = pverd
if ne c 0
ret c
end
k = get g 3
if eq k 2
ret 5
end
if eq k 3
ret 6
end
if eq eqr get g 4 kh 40 false
ret 7
end
if eq get g 6 0
ret 8
end
if eq rr long -2
ret 17
end
if le rr 0
ret 9
end
c = prcpt
if ne c 0
ret c
end
if eq eqr get g 7 kh 40 false
ret 12
end
if ne get g 8 0
ret 13
end
if eq get g 9 0
ret 14
end
if hasauth
ret 15
end
ret 0
end

note say: print the decision (text, or one forge-decision/1 JSON object when g 41 is 1)
fn say c int to int
put g 0 0
if eq get g 41 1
otext tj1
if hex40 kh add kh 40
otext tjq
ocopy kh 40
otext tjq
else
otext tjnull
end
otext tjdec
if eq c 0
otext tmerge
else
otext thold
end
otext tjrsn
oreason c
otext tjend
else
odecis c
end
obyte 10
oflush 1
if eq c 0
ret 0
end
ret 1
end

fn cdecide to int
a = ulong argcnt
o = ulong 2
if ge a 3
if argis 2 tjson
put g 41 1
o = ulong 3
end
end
if ne a add o 3
ret say 1
end
hn = argread o m kh 64
if ne hn 40
put m kh 0
ret say 2
end
pn = argread add o 1 m kp pcap
vr = long -1
if gt pn 0
vr = load ulong pn kv vcap
end
if gt vr 0
put g 1 ulong vr
end
qn = argread add o 2 m kp pcap
rr = long -1
if gt qn 0
rr = load ulong qn kr rcap
end
if gt rr 0
put g 2 ulong rr
end
ret say decide vr rr
end

note ---- status: the Radicle edge (rad CLI through /usr/bin/env) ----

fn pkinit to void
put g 30 2
put g 31 0
end

note pkadd: append one packed-list record m[ps..ps+n) to the exec packet
fn pkadd ps ulong n ulong to void
w = get g 30
if gt add add w 2 n ecap
trap 12
end
put m add ke w uchar and n 255
put m add ke add w 1 uchar shr n 8
cpy add ke add w 2 ps n
put g 30 add add w 2 n
put g 31 add get g 31 1
end

fn pktext t view uchar * to void
w = get g 30
n = len t
if gt add add w 2 n ecap
trap 12
end
put m add ke w uchar and n 255
put m add ke add w 1 uchar shr n 8
x = tcpy add ke add w 2 t
put g 30 add add w 2 n
put g 31 add get g 31 1
end

fn pkdone to ulong
c = get g 31
put m ke uchar and c 255
put m add ke 1 uchar shr c 8
ret get g 30
end

note radpk: /usr/bin/env HOME=.. PATH=.. rad patch <verb> [ID] --repo RID; id is m[ps..ps+7) when n > 0
fn radpk verb int ps ulong n ulong to ulong
pkinit
pktext tenv
pkadd kx get g 19
pkadd add kx 1024 get g 21
pktext trad
pktext tpatch
if eq verb 0
pktext tlist
pktext tall
else
pktext tshow
pkadd ps n
end
pktext trepo
pkadd krid get g 16
ret pkdone
end

note spawn: run the packet with stdout on a pipe; return the child pid (read end in g 32) or a negative errno
fn spawn pn ulong to long
pf = new uchar 8 0
r = pipefds pf 0 8 524288
if lt r 0
ret r
end
rfd = int or ulong get pf 0 shl ulong get pf 1 8
wfd = int or ulong get pf 4 shl ulong get pf 5 8
pid = fork
if eq pid 0
y = dupfd wfd 1 0
y = execprog m ke pn
exit 127
end
x = fclose wfd
if lt pid 0
x = fclose rfd
ret pid
end
put g 32 ulong rfd
ret pid
end

note drain: read the child's stdout into m[ko..ko+ocap), length in g 13; true when it overflowed
note (the child is then killed, so a runaway child cannot block the forge)
fn drain rfd int pid long to bool
n = ulong 0
ovf = false
c = true
while c bound 1048576
if ge n ocap
ovf = true
x = killpid int pid 9
c = false
else
r = read rfd m add ko n sub ocap n
if le r 0
c = false
else
n = add n ulong r
end
end
end
x = fclose rfd
put g 13 n
ret ovf
end

note runcmd: run the packet, capture stdout; return the exit status, or a negative errno
fn runcmd pn ulong to long
st = new uchar 4 0
pid = spawn pn
if lt pid 0
ret pid
end
ovf = drain int get g 32 pid
w = waitpid int pid st 0 4 0
if lt w 0
ret w
end
if ovf
ret -27
end
s = or ulong get st 0 shl ulong get st 1 8
if ne and s 127 0
ret -4
end
ret long and shr s 8 255
end

note envget: copy the environment entry with prefix t into m[ps..ps+cap); return its length or 0
fn envget t view uchar * ps ulong cap ulong to ulong
c = ulong envcnt
i = ulong 0
while lt i c bound 65536
n = envread i m add kx 5120 4096
if gt n 0
if mat add kx 5120 add add kx 5120 ulong n t
if le ulong n cap
cpy ps add kx 5120 ulong n
ret ulong n
end
end
end
i = add i 1
end
ret 0
end

note rowid: a patch table row is the box bar (e2 94 82), a space, a state glyph, spaces,
note 7 hex digits and a space. Return the offset of the digits, or 0.
fn rowid p ulong e ulong to ulong
if gt add p 14 e
ret 0
end
if ne get m p 226
ret 0
end
if ne get m add p 1 148
ret 0
end
if ne get m add p 2 130
ret 0
end
q = add p 3
if ne get m q 32
ret 0
end
q = add q 1
while and lt q e ne get m q 32 bound 1048576
q = add q 1
end
while and lt q e eq get m q 32 bound 1048576
q = add q 1
end
s = q
while and lt q e ishex get m q bound 1048576
q = add q 1
end
if ne sub q s 7
ret 0
end
if ge q e
ret 0
end
if ne get m q 32
ret 0
end
ret s
end

note plist: copy the first icap patch ids of the list output to ki; return the number of rows listed
fn plist to ulong
n = add ko get g 13
p = ko
k = ulong 0
while lt p n bound 524288
e = eol p n
s = rowid p e
if ne s 0
if lt k icap
cpy add ki mul k 8 s 7
end
k = add k 1
end
p = add e 1
end
ret k
end

note lblval: a field row "<bar><label>   value"; return the value offset or 0
fn lblval p ulong e ulong t view uchar * to ulong
if gt add p 3 e
ret 0
end
if ne get m p 226
ret 0
end
if ne get m add p 1 148
ret 0
end
if ne get m add p 2 130
ret 0
end
q = add p 3
if eq mat q e t false
ret 0
end
q = add q len t
while and lt q e eq get m q 32 bound 1048576
q = add q 1
end
ret q
end

note full40: 40 hex digits at v, then a space or the end of the row
fn full40 v ulong e ulong to bool
if eq hex40 v e false
ret false
end
q = add v 40
if lt q e
if ne get m q 32
ret false
end
end
ret true
end

note sword: copy the status word (up to 31 bytes before a space) at v into ks+128; false when empty
fn sword v ulong e ulong to bool
q = v
c = true
while c bound 64
if ge q e
c = false
else
if eq get m q 32
c = false
else
if ge sub q v 31
c = false
else
q = add q 1
end
end
end
end
if eq q v
ret false
end
cpy add ks 128 v sub q v
put g 23 sub q v
ret true
end

note pshow: take the first Patch, Head and Status rows of "rad patch show" into ks; 7 when all found
fn pshow to ulong
n = add ko get g 13
p = ko
f = ulong 0
while lt p n bound 524288
e = eol p n
if eq and f 1 0
v = lblval p e tlpat
if ne v 0
if full40 v e
cpy ks v 40
f = or f 1
end
end
end
if eq and f 2 0
v = lblval p e tlhead
if ne v 0
if full40 v e
cpy add ks 64 v 40
f = or f 2
end
end
end
if eq and f 4 0
v = lblval p e tlstat
if ne v 0
if sword v e
f = or f 4
end
end
end
p = add e 1
end
ret f
end

note sufname: a directory entry name m[a..a+nl) is "<one or more bytes>-<head8><t>"
fn sufname a ulong nl ulong t view uchar * to bool
if lt nl add len t 10
ret false
end
b = sub add a nl add len t 9
if ne get m b 45
ret false
end
if eq eqr add b 1 add ks 64 8 false
ret false
end
ret mat add b 9 add a nl t
end

fn u16at p ulong to ulong
ret or ulong get m p shl ulong get m add p 1 8
end

fn nlen a ulong to ulong
n = ulong 0
while and lt n 255 ne get m add a n 0 bound 256
n = add n 1
end
ret n
end

note dscan: walk r bytes of getdents64 records at kd; return the number of names that end in
note "-<head8><t>". While g sl is 0, the next such name is copied to m[dst..) with its length in g sl.
fn dscan r ulong t view uchar * dst ulong sl ulong to ulong
k = ulong 0
o = ulong 0
while lt o r bound 32768
rl = u16at add kd add o 16
a = add kd add o 19
nl = nlen a
if sufname a nl t
if eq get g sl 0
cpy dst a nl
put g sl nl
end
k = add k 1
end
if eq rl 0
o = r
else
o = add o rl
end
end
ret k
end

note findn: scan the directory m[dir..dir+dn) for names ending in "-<head8><t>" (head at ks+64).
note Return the number of matching names; the first is copied to m[dst..) with its length in g sl.
fn findn dir ulong dn ulong t view uchar * dst ulong sl ulong to ulong
fl = fopen m dir dn 524288 0
if lt fl 0
ret 0
end
fd = int fl
k = ulong 0
put g sl 0
c = true
while c bound 65536
r = getdnts fd m kd dcap
if le r 0
c = false
else
k = add k dscan ulong r t dst sl
end
end
x = fclose fd
ret k
end

note dpath: m[kp..) = dir "/" name; return its length
fn dpath dir ulong dn ulong nm ulong nn ulong to ulong
cpy kp dir dn
put m add kp dn 47
cpy add kp add dn 1 nm nn
ret add add dn 1 nn
end

note spatch: decide one patch whose fields are in ks; print its line; return 0 merge, 1 hold, 2 not run
fn spatch id ulong to int
put g 0 0
otext tsp
ocopy id 7
otext tsst
ocopy add ks 128 get g 23
otext tshd
ocopy add ks 64 40
otext tsvd
k = findn krev get g 17 tvsuf kn 24
if eq k 0
otext tnone
otext tsdc
otext tnorun
obyte 10
oflush 1
ret 2
end
ocopy kn get g 24
if gt k 1
otext tsdc
odecis 16
obyte 10
oflush 1
ret 1
end
cpy kh add ks 64 40
pn = dpath krev get g 17 kn get g 24
vr = load pn kv vcap
if gt vr 0
put g 1 ulong vr
end
rr = long -1
otext tsrc
kr2 = findn krcp get g 18 trsuf kn2 25
if eq kr2 0
otext tnone
end
if gt kr2 1
rr = long -2
otext tamb
end
if eq kr2 1
ocopy kn2 get g 25
qn = dpath krcp get g 18 kn2 get g 25
rr = load qn kr rcap
end
otext tsdc
if gt rr 0
put g 2 ulong rr
end
c = decide vr rr
odecis c
obyte 10
oflush 1
if eq c 0
ret 0
end
ret 1
end

fn serr t view uchar * to int
put g 0 0
otext t
oflush 2
ret 2
end

fn cstatus to int
a = argcnt
if or lt a 3 gt a 5
ret serr thelp
end
rl = argread 2 m krid 128
if lt rl 0
ret serr tebad
end
if eq ridok krid ulong rl false
ret serr tebad
end
put g 16 ulong rl
hl = envget thome kx 1024
if le hl 5
ret serr tehome
end
put g 19 hl
pl = envget tpath add kx 1024 4096
if eq pl 0
pl = tcpy add kx 1024 tdpath
end
put g 21 pl
dl = long 0
if ge a 4
dl = argread 3 m krev 4000
else
cpy krev add kx 5 sub hl 5
dl = long add sub hl 5 tcpy add krev sub hl 5 trevd
end
if le dl 0
ret serr thelp
end
put g 17 ulong dl
el = long 0
if eq a 5
el = argread 4 m krcp 4000
else
cpy krcp add kx 5 sub hl 5
el = long add sub hl 5 tcpy add krcp sub hl 5 trcpd
end
if le el 0
ret serr thelp
end
put g 18 ulong el
ret slist
end

fn slist to int
r = runcmd radpk 0 0 0
if ne r 0
put g 0 0
otext terad
onum ulong and r 255
obyte 10
oflush 2
ret 2
end
np = plist
nd = np
if gt nd icap
nd = icap
end
i = ulong 0
nm = ulong 0
nh = ulong 0
nn = ulong 0
while lt i nd bound 512
id = add ki mul i 8
r = runcmd radpk 1 id 7
if ne r 0
put g 0 0
otext terad
onum ulong and r 255
obyte 10
oflush 2
ret 2
end
if ne pshow 7
put g 0 0
otext tefld
ocopy id 7
obyte 10
oflush 2
ret 2
end
c = spatch id
if eq c 0
nm = add nm 1
end
if eq c 1
nh = add nh 1
end
if eq c 2
nn = add nn 1
end
i = add i 1
end
put g 0 0
otext tsum
ocopy krid get g 16
otext tspat
onum np
otext tsdec
onum add nm nh
otext tsmrg
onum nm
otext tshld
onum nh
otext tsnr
onum nn
obyte 10
oflush 1
if gt np icap
otext ttrunc
onum np
otext ttrunc2
onum icap
obyte 10
oflush 1
ret 2
end
ret 0
end

note ---- gate: run a gate and its negative control in fresh clones and write the receipt ----

note SHA-256 (FIPS 180-4), bytes fed one at a time: state hs, schedule hw, constants hk, block hb.
note 32-bit words are kept in ulong and masked to 32 bits after every addition.
fn shinit to void
put hk 0 1116352408
put hk 1 1899447441
put hk 2 3049323471
put hk 3 3921009573
put hk 4 961987163
put hk 5 1508970993
put hk 6 2453635748
put hk 7 2870763221
put hk 8 3624381080
put hk 9 310598401
put hk 10 607225278
put hk 11 1426881987
put hk 12 1925078388
put hk 13 2162078206
put hk 14 2614888103
put hk 15 3248222580
put hk 16 3835390401
put hk 17 4022224774
put hk 18 264347078
put hk 19 604807628
put hk 20 770255983
put hk 21 1249150122
put hk 22 1555081692
put hk 23 1996064986
put hk 24 2554220882
put hk 25 2821834349
put hk 26 2952996808
put hk 27 3210313671
put hk 28 3336571891
put hk 29 3584528711
put hk 30 113926993
put hk 31 338241895
put hk 32 666307205
put hk 33 773529912
put hk 34 1294757372
put hk 35 1396182291
put hk 36 1695183700
put hk 37 1986661051
put hk 38 2177026350
put hk 39 2456956037
put hk 40 2730485921
put hk 41 2820302411
put hk 42 3259730800
put hk 43 3345764771
put hk 44 3516065817
put hk 45 3600352804
put hk 46 4094571909
put hk 47 275423344
put hk 48 430227734
put hk 49 506948616
put hk 50 659060556
put hk 51 883997877
put hk 52 958139571
put hk 53 1322822218
put hk 54 1537002063
put hk 55 1747873779
put hk 56 1955562222
put hk 57 2024104815
put hk 58 2227730452
put hk 59 2361852424
put hk 60 2428436474
put hk 61 2756734187
put hk 62 3204031479
put hk 63 3329325298
put hs 0 1779033703
put hs 1 3144134277
put hs 2 1013904242
put hs 3 2773480762
put hs 4 1359893119
put hs 5 2600822924
put hs 6 528734635
put hs 7 1541459225
put g 43 0
put g 44 0
end

note shsched: the 64-word message schedule of the block in hb
fn shsched to void
i = ulong 0
while lt i 16 bound 16
j = mul i 4
w = or shl uint get hb j 24 shl uint get hb add j 1 16
w = or w or shl uint get hb add j 2 8 uint get hb add j 3
put hw i w
i = add i 1
end
while lt i 64 bound 48
x = get hw sub i 15
y = get hw sub i 2
s0 = xor xor rotr x 7 rotr x 18 shr x 3
s1 = xor xor rotr y 17 rotr y 19 shr y 10
x = add get hw sub i 16 s0
y = add get hw sub i 7 s1
put hw i add x y
i = add i 1
end
end

note shblk: compress the block in hb into hs; the working variables a..h are hv 0..7
fn shblk to void
shsched
j = ulong 0
while lt j 8 bound 8
put hv j get hs j
j = add j 1
end
i = ulong 0
while lt i 64 bound 64
e = get hv 4
t = xor rotr e 6 rotr e 11
t = add get hv 7 xor t rotr e 25
u = and xor e 4294967295 get hv 6
t = add t xor and e get hv 5 u
t = add t get hk i
t = add t get hw i
a = get hv 0
u = xor rotr a 2 rotr a 13
u = xor u rotr a 22
w = xor and a get hv 1 and a get hv 2
w = xor w and get hv 1 get hv 2
u = add u w
put hv 7 get hv 6
put hv 6 get hv 5
put hv 5 e
put hv 4 add get hv 3 t
put hv 3 get hv 2
put hv 2 get hv 1
put hv 1 a
put hv 0 add t u
i = add i 1
end
j = ulong 0
while lt j 8 bound 8
put hs j add get hs j get hv j
j = add j 1
end
end

fn shbyte c uchar to void
n = get g 43
put hb n c
n = add n 1
if eq n 64
shblk
n = ulong 0
end
put g 43 n
put g 44 add get g 44 1
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

note shfin: pad, then write the digest as 64 lowercase hex digits to m[dst..dst+64)
fn shfin dst ulong to void
bits = mul get g 44 8
shbyte 128
while ne get g 43 56 bound 64
shbyte 0
end
i = ulong 0
while lt i 8 bound 8
shbyte uchar and shr bits mul sub 7 i 8 255
i = add i 1
end
i = ulong 0
while lt i 32 bound 32
v = ulong get hs div i 4
v = and shr v mul sub 3 rem i 4 8 255
put m add dst mul i 2 hexd shr v 4
put m add dst add mul i 2 1 hexd and v 15
i = add i 1
end
end

note shfd: SHA-256 of what is left to read on fd as hex at m[dst..dst+64), also copying every chunk
note to fd wf when wf >= 0; false on a read error or a short write
fn shfd fd int wf long dst ulong to bool
shinit
c = true
ok = true
while c bound 1048576
r = read fd m kbuf bcap
if lt r 0
ok = false
c = false
else
if eq r 0
c = false
else
i = ulong 0
while lt i ulong r bound 65536
shbyte get m add kbuf i
i = add i 1
end
if ge wf 0
w = write int wf m kbuf ulong r
if ne w r
ok = false
c = false
end
end
end
end
end
if eq ok false
ret false
end
shfin dst
ret true
end

note shfile: SHA-256 of the file at m[kp..kp+pn) as hex at m[dst..dst+64); false when unreadable
fn shfile pn ulong dst ulong to bool
fl = fopen m kp pn 524288 0
if lt fl 0
ret false
end
ok = shfd int fl long -1 dst
x = fclose int fl
ret ok
end

fn o2 v ulong to void
obyte uchar add 48 div v 10
obyte uchar add 48 rem v 10
end

note oiso: epoch nanoseconds as YYYY-MM-DDTHH:MM:SSZ (UTC, civil date from days since 1970-01-01)
fn odate days ulong to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
yoe = sub add sub doe div doe 1460 div doe 36524 div doe 146096
yoe = div yoe 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
mo = add mp 3
if ge mp 10
mo = sub mp 9
end
if le mo 2
y = add y 1
end
onum y
obyte 45
o2 mo
obyte 45
o2 d
end

fn oiso ns ulong to void
s = div ns 1000000000
odate div s 86400
sod = rem s 86400
obyte 84
o2 div sod 3600
obyte 58
o2 rem div sod 60 60
obyte 58
o2 rem sod 60
obyte 90
end

note nameok: a repository name of 1 to 100 bytes of A-Z a-z 0-9 . _ - that does not start with "."
fn nameok p ulong n ulong to bool
if or lt n 1 gt n 100
ret false
end
if eq get m p 46
ret false
end
i = ulong 0
while lt i n bound 100
c = get m add p i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 65 le c 90
ok = true
end
if and ge c 97 le c 122
ok = true
end
if or or eq c 46 eq c 95 eq c 45
ok = true
end
if eq ok false
ret false
end
i = add i 1
end
ret true
end

note gcheck: arguments a0..a1 form one command: 1 to 40 arguments, no CR or LF in any, the first
note not empty, not starting with "-" and holding no "=" (so /usr/bin/env runs it as the program),
note and at most 1024 bytes joined with spaces
fn gcheck a0 ulong a1 ulong to bool
if or le a1 a0 gt sub a1 a0 40
ret false
end
t = ulong 0
i = a0
while lt i a1 bound 64
n = argread i m add kx 5120 4096
if lt n 0
ret false
end
q = ulong n
if eq i a0
if eq q 0
ret false
end
if eq get m add kx 5120 45
ret false
end
end
j = ulong 0
while lt j q bound 4096
c = get m add add kx 5120 j
if or eq c 10 eq c 13
ret false
end
if and eq i a0 eq c 61
ret false
end
j = add j 1
end
t = add add t q 1
i = add i 1
end
ret le t 1025
end

note gopt: the option at argument i and its value; return 0, or 1 usage, 4 bad author, 5 bad name
fn gopt i ulong to int
j = add i 1
if argis i tfname
if gt get g 33 0
ret 1
end
n = argread j m knm 101
if or lt n 1 gt n 100
ret 5
end
put g 33 ulong n
ret 0
end
if argis i tfout
if gt get g 34 0
ret 1
end
n = argread j m kod 1024
if lt n 1
ret 1
end
put g 34 ulong n
ret 0
end
if argis i tfauth
if gt get g 35 0
ret 1
end
n = argread j m kau 257
if or lt n 1 gt n 256
ret 4
end
if ne txtchk kau add kau ulong n 0
ret 4
end
put g 35 ulong n
ret 0
end
ret 1
end

note gdd: index of the first "--" after the --neg arguments start, or 0
fn gdd to ulong
a = ulong argcnt
j = get g 36
while lt j a bound 128
if argis j tdd
ret j
end
j = add j 1
end
ret 0
end

note gargs: parse "gate RID HEAD [--name N] [--out DIR] --author A --neg ARGV.. -- ARGV..".
note Return 0, or 1 usage, 2 bad head, 3 bad RID, 4 bad arguments, 5 bad name.
fn gargs to int
a = ulong argcnt
if lt a 10
ret 1
end
if gt a 90
ret 4
end
rl = argread 2 m krid 128
if lt rl 0
ret 3
end
if eq ridok krid ulong rl false
ret 3
end
put g 16 ulong rl
hn = argread 3 m kh 64
if ne hn 40
ret 2
end
if eq hex40 kh add kh 40 false
ret 2
end
put g 33 0
put g 34 0
put g 35 0
i = ulong 4
c = true
while c bound 64
if ge add i 1 a
ret 1
end
if argis i tfneg
put g 36 add i 1
c = false
else
r = gopt i
if ne r 0
ret r
end
i = add i 2
end
end
k = gdd
if eq k 0
ret 1
end
put g 37 k
if eq get g 35 0
ret 1
end
if eq gcheck get g 36 k false
ret 4
end
if eq gcheck add k 1 a false
ret 4
end
if gt get g 33 0
if eq nameok knm get g 33 false
ret 5
end
end
ret 0
end

note genv: HOME, PATH, OMC, RAD_HOME, the storage path, the default out dir and the omc digest.
note Return 0, or 1 HOME unset, 2 OMC set but unreadable.
fn genv to int
hl = envget thome kx 1024
if le hl 5
ret 1
end
put g 19 hl
pl = envget tpath add kx 1024 4096
if eq pl 0
pl = tcpy add kx 1024 tdpath
end
put g 21 pl
put g 38 envget tomce kom 2048
put g 39 envget tradh krh 1024
n = ulong 0
if gt get g 39 9
n = sub get g 39 9
cpy kst add krh 9 n
n = add n tcpy add kst n tstor
else
n = sub hl 5
cpy kst add kx 5 n
n = add n tcpy add kst n tdotrad
n = add n tcpy add kst n tstor
end
cpy add kst n add krid 4 sub get g 16 4
put g 42 add n sub get g 16 4
if eq get g 34 0
n = sub hl 5
cpy kod add kx 5 n
n = add n tcpy add kod n trcpd
put g 34 n
x = makedir m kod n 493
end
if gt get g 38 4
n = sub get g 38 4
cpy kp add kom 4 n
if eq shfile n kos false
ret 2
end
end
ret 0
end

fn envpk to void
pkinit
pktext tenv
pkadd kx get g 19
pkadd add kx 1024 get g 21
end

note gname: the repository name from --name, or from "rad inspect RID --payload" ("name": "...")
fn gname to bool
if gt get g 33 0
ret true
end
envpk
if gt get g 39 0
pkadd krh get g 39
end
pktext trad
pktext tinspect
pkadd krid get g 16
pktext tpayload
r = runcmd pkdone
if ne r 0
ret false
end
n = add ko get g 13
p = ko
while lt p n bound 524288
if mat p n tnamek
q = add p len tnamek
e = q
while and lt e n ne get m e 34 bound 4096
e = add e 1
end
if or ge e n gt sub e q 100
ret false
end
cpy knm q sub e q
put g 33 sub e q
ret nameok knm sub e q
end
p = add p 1
end
ret false
end

note gtmp: create /tmp/forge-gate-<pid>-<16 random hex> with mode 0700 at kt, length in g 40
fn gtmp to bool
put g 40 0
n = tcpy kt ttmp
put g 0 0
onum ulong getpid
obyte 45
r = random m add kx 5120 8 0
if ne r 8
put g 0 0
ret false
end
i = ulong 0
while lt i 8 bound 8
v = ulong get m add add kx 5120 i
obyte hexd shr v 4
obyte hexd and v 15
i = add i 1
end
cpy add kt n kw get g 0
n = add n get g 0
put g 0 0
x = makedir m kt n 448
if ne x 0
ret false
end
put g 40 n
ret true
end

note grm: remove the temp dir (only a path made by gtmp)
fn grm to void
if gt get g 40 16
pkinit
pktext trm
pktext trf
pkadd kt get g 40
x = runcmd pkdone
end
end

note cdir: m[kc..) = temp dir + t; return its length
fn cdir t view uchar * to ulong
n = get g 40
cpy kc kt n
ret add n tcpy add kc n t
end

fn gitpk to void
envpk
pktext tgnos
pktext tgglob
pktext tgit
end

note gclone: a fresh clone of the head from the Radicle storage into m[kc..kc+dn); true when
note every git step exits 0 and the clone's HEAD is exactly the head
fn gclone dn ulong to bool
gitpk
pktext tinit
pktext tq
pkadd kc dn
if ne runcmd pkdone 0
ret false
end
gitpk
pktext tdc
pkadd kc dn
pktext tfetch
pktext tq
pktext tnotags
pkadd kst get g 42
pkadd kh 40
if ne runcmd pkdone 0
ret false
end
gitpk
pktext tdc
pkadd kc dn
pktext tcfg
pktext tadv
pktext tcheck
pktext tq
pktext tdetach
pkadd kh 40
if ne runcmd pkdone 0
ret false
end
gitpk
pktext tdc
pkadd kc dn
pktext trevp
pktext theadw
if ne runcmd pkdone 0
ret false
end
if ne get g 13 41
ret false
end
ret eqr ko kh 40
end

note gtree: the tree id of the clone at m[kc..kc+dn) into ktr
fn gtree dn ulong to bool
gitpk
pktext tdc
pkadd kc dn
pktext trevp
pktext ttreew
if ne runcmd pkdone 0
ret false
end
if ne get g 13 41
ret false
end
if eq hex40 ko add ko 40 false
ret false
end
cpy ktr ko 40
ret true
end

note opath: m[kp..) = out dir "/" name "-" head8 t; return its length
fn opath t view uchar * to ulong
n = get g 34
cpy kp kod n
put m add kp n 47
n = add n 1
cpy add kp n knm get g 33
n = add n get g 33
put m add kp n 45
cpy add kp add n 1 kh 8
n = add n 9
ret add n tcpy add kp n t
end

note tmpath: m[kp..) = temp dir + t; return its length
fn tmpath t view uchar * to ulong
n = get g 40
cpy kp kt n
ret add n tcpy add kp n t
end

note gmklog: create the log temp dir + t with 557249 = O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,
note mode 0600, open it again with 557056 = O_RDONLY|O_NOFOLLOW|O_CLOEXEC, and require both fds to
note be the same file (st_dev, st_ino). Write fd to g s, read fd to g s+1: the command writes through
note the first and forge hashes and copies through the second, so a name swapped later changes
note nothing. Flag values are aarch64 Linux, the only target the pinned omc emits.
fn gmklog t view uchar * s ulong to bool
n = tmpath t
fl = fopen m kp n 557249 384
if lt fl 0
ret false
end
rl = fopen m kp n 557056 0
if lt rl 0
ret false
end
if ne fstat int fl m kbuf 128 0
ret false
end
if ne fstat int rl m add kbuf 128 128 0
ret false
end
if eq eqr kbuf add kbuf 128 16 false
ret false
end
put g s ulong fl
put g add s 1 ulong rl
ret true
end

note gfree: true when nothing (file or symlink) is at the out path for suffix t yet; forge never
note replaces an out file, and the O_EXCL create at the end refuses one that appears meanwhile
fn gfree t view uchar * to bool
n = opath t
r = lstat m kp n m kbuf 128
ret lt r 0
end

note gcopy: create the out file for suffix t (557249, mode 0644 before umask), then hash the log
note behind read fd g s into dst while copying it there; g 53 counts the out files created
fn gcopy t view uchar * s ulong dst ulong to bool
n = opath t
fl = fopen m kp n 557249 420
if lt fl 0
ret false
end
put g 53 add get g 53 1
ok = shfd int get g s long fl dst
x = fclose int fl
ret ok
end

note gunl: remove the out files this run created, in creation order (gate log, negctl log, receipt)
fn gunl to void
c = get g 53
if gt c 0
n = opath tglog
x = unlink m kp n
end
if gt c 1
n = opath tnlog
x = unlink m kp n
end
if gt c 2
n = opath trsuf
x = unlink m kp n
end
put g 53 0
end

note pkarg: append argument i to the exec packet
fn pkarg i ulong to void
w = get g 30
if gt add w 2 ecap
trap 12
end
n = argread i m add ke add w 2 sub ecap add w 2
if lt n 0
trap 12
end
put m add ke w uchar and ulong n 255
put m add ke add w 1 uchar shr ulong n 8
put g 30 add add w 2 ulong n
put g 31 add get g 31 1
end

note grun: run arguments a0..a1 through /usr/bin/env (HOME, PATH and OMC when set) in the clone
note m[kc..kc+dn), stdin /dev/null, stdout and stderr on the open log fd lf (duplicated, never
note reopened by name); return the exit status (128 + signal for a killed command) or a negative errno
fn grun a0 ulong a1 ulong dn ulong lf ulong to long
envpk
if gt get g 38 0
pkadd kom get g 38
end
i = a0
while lt i a1 bound 64
pkarg i
i = add i 1
end
pn = pkdone
st = new uchar 4 0
pid = fork
if eq pid 0
r = chdir m kc dn
if lt r 0
exit 126
end
y = dupfd int lf 1 0
if lt y 0
exit 126
end
y = dupfd int lf 2 0
if lt y 0
exit 126
end
nf = fopen tdevnull 0 len tdevnull 0 0
if lt nf 0
exit 126
end
y = dupfd int nf 0 0
y = execprog m ke pn
exit 127
end
if lt pid 0
ret pid
end
w = waitpid int pid st 0 4 0
if lt w 0
ret w
end
s = or ulong get st 0 shl ulong get st 1 8
if ne and s 127 0
ret long add 128 and s 127
end
ret long and shr s 8 255
end

note ojoin: arguments a0..a1 joined with single spaces into the output line
fn ojoin a0 ulong a1 ulong to void
i = a0
while lt i a1 bound 64
if gt i a0
obyte 32
end
n = argread i m add kx 5120 4096
if gt n 0
ocopy add kx 5120 ulong n
end
i = add i 1
end
end

note gwrite: build the receipt in the output line and create the out receipt with O_EXCL
fn gwrite gr ulong nr ulong t0 ulong t1 ulong to bool
put g 0 0
otext trch
otext tridk
ocopy krid get g 16
obyte 10
otext tclone
ocopy kh 40
obyte 10
otext ttree
ocopy ktr 40
obyte 10
otext tomck
if gt get g 38 4
ocopy kos 64
else
otext tnone
end
obyte 10
otext tgcmd
ojoin add get g 37 1 ulong argcnt
obyte 10
otext tgate
onum gr
obyte 10
otext tncmd
ojoin get g 36 get g 37
obyte 10
otext tneg
onum nr
obyte 10
otext tauth
ocopy kau get g 35
obyte 10
otext tstart
oiso t0
obyte 10
otext tfin
oiso t1
obyte 10
otext tlsha
ocopy kgs 64
obyte 10
otext tnlsha
ocopy kns 64
obyte 10
w = get g 0
put g 0 0
if ge w rcap
ret false
end
n = opath trsuf
fl = fopen m kp n 557249 420
if lt fl 0
ret false
end
put g 53 add get g 53 1
r = write int fl m kw w
x = fclose int fl
if lt r 0
ret false
end
ret eq ulong r w
end

note gboth: check the out dir and that no out name is taken, clone twice, run the gate and the
note negative control with their logs in the 0700 temp dir, then create the out logs and the
note receipt with O_EXCL from the open log fds; on a failure remove the out files this run created.
note Return 0, or 1 clone failed, 2 write failed, 3 run failed.
fn gboth to int
if ne faccess m kod get g 34 3 0
ret 2
end
if eq gfree tglog false
ret 2
end
if eq gfree tnlog false
ret 2
end
if eq gfree trsuf false
ret 2
end
dn = cdir tgdir
if eq gclone dn false
ret 1
end
if eq gtree dn false
ret 1
end
dn = cdir tndir
if eq gclone dn false
ret 1
end
if eq gmklog ttgl 49 false
ret 2
end
if eq gmklog ttnl 51 false
ret 2
end
t0 = ulong realns
dn = cdir tgdir
gr = grun add get g 37 1 ulong argcnt dn get g 49
if lt gr 0
ret 3
end
dn = cdir tndir
nr = grun get g 36 get g 37 dn get g 51
if lt nr 0
ret 3
end
t1 = ulong realns
put g 53 0
if eq gcopy tglog 50 kgs false
gunl
ret 2
end
if eq gcopy tnlog 52 kns false
gunl
ret 2
end
if eq gwrite ulong gr ulong nr t0 t1 false
gunl
ret 2
end
put g 47 ulong gr
put g 48 ulong nr
ret 0
end

note cgate: exit 0 when the gate passed and its negative control failed, 1 when the receipt
note records anything else (it would HOLD), 2 on an error (no receipt written)
fn cgate to int
r = gargs
if eq r 1
ret serr thelp
end
if eq r 2
ret serr tebadh
end
if eq r 3
ret serr tebad
end
if eq r 4
ret serr teargs
end
if eq r 5
ret serr tename
end
r = genv
if eq r 1
ret serr tehome
end
if eq r 2
ret serr teomc
end
if eq gname false
ret serr tename
end
if eq gtmp false
ret serr tetmp
end
r = gboth
grm
if eq r 1
ret serr teclone
end
if eq r 2
ret serr teout
end
if eq r 3
ret serr terun
end
put g 0 0
otext tgo
ocopy krid get g 16
otext tgoh
ocopy kh 40
otext tgor
onum get g 47
otext tgon
onum get g 48
otext tgorc
n = opath trsuf
ocopy kp n
obyte 10
oflush 1
if and eq get g 47 0 ne get g 48 0
ret 0
end
ret 1
end

fn main to int
if lt argcnt 2
ret serr thelp
end
n = argread 1 m kp 16
if eq n 6
if mat kp add kp 6 tdec
ret cdecide
end
if mat kp add kp 6 tstat
ret cstatus
end
end
if eq n 4
if mat kp add kp 4 tgatew
ret cgate
end
end
ret serr thelp
end

om2
note INTERPLANE Forge v1: agents express intent, the forge retains authority.
note forge decide [--json] HEAD VERDICT RECEIPT prints "MERGE OK" and exits 0, or "HOLD <CODE>" and
note exits 1 (with --json, one forge-decision/1 JSON object instead).
note forge status RID [REVIEWS [RECEIPTS]] lists the live Radicle patches of RID and decides each
note patch that has a verdict file.
note forge gate RID HEAD [--name N] [--out DIR] --author A --neg ARGV.. -- ARGV.. runs a gate and its
note negative control, each in its own fresh clone at the exact head, and writes the gate receipt.
note Spec: docs/FORGE.md. Formats: forge/README.md. Every check fails closed.
global m uchar 1048576
global g ulong 64
global hs uint 8
global hw uint 64
global hk uint 64
global hv uint 8
global hb uchar 64
note memory map of m: verdict, receipt, patch head, path, output line, exec packet,
note directory records, command output, patch ids, environment, arguments, patch fields
const kv ulong 0
const vcap ulong 65536
const kr ulong 65536
const rcap ulong 4096
const kh ulong 69632
const kp ulong 73728
const pcap ulong 4096
const kw ulong 77824
const wcap ulong 8192
const ke ulong 720896
const ecap ulong 4096
const kd ulong 90112
const dcap ulong 32768
const ko ulong 131072
const ocap ulong 524288
const ki ulong 655360
const icap ulong 512
const kx ulong 659456
const krid ulong 671744
const krev ulong 672000
const krcp ulong 676096
const ks ulong 680192
const kn ulong 684288
const kn2 ulong 684800
const kag ulong 688128
const acap ulong 4096
const kt ulong 692224
const kc ulong 692736
const knm ulong 693760
const kod ulong 693888
const kau ulong 695936
const kst ulong 696448
const kom ulong 698496
const krh ulong 700544
const ktr ulong 702592
const kgs ulong 702656
const kns ulong 702720
const kos ulong 702784
const kna ulong 786432
const knb ulong 851968
const kbuf ulong 917504
const bcap ulong 65536
note g slots: 0 output length, 1 verdict length, 2 receipt length, 3 verdict kind,
note 4 verdict head offset, 5 reviewer offset, 6 reviewer length, 7 clone offset,
note 8 gate_rc, 9 negctl_rc, 10 author offset, 11 author length, 12 receipt keys seen,
note 13 command output length, 19 HOME length, 21 PATH length, 16 RID length,
note 17 reviews dir length, 18 receipts dir length, 23 status word length,
note 24 verdict name length, 25 receipt name length, 30 packet length, 31 packet count,
note 32 read end of the spawn pipe, 33 name length, 34 out dir length, 35 author length,
note 36 first --neg argument, 37 index of "--", 38 OMC entry length (0: unset),
note 39 RAD_HOME entry length (0: unset), 40 temp dir length, 41 JSON output, 42 storage length,
note 43 SHA-256 bytes buffered, 44 SHA-256 total bytes, 45 started ns, 46 finished ns,
note 47 gate rc, 48 negctl rc, 49 and 50 gate log write and read fd, 51 and 52 negctl log write
note and read fd, 53 out files this gate run created.
note kna and knb hold the normalized reviewer and author for the self-review check.
text tverd "VERDICT "
text tvw "VERDICT"
text tmaf "MERGE_AFTER_FIX "
text tmrg "MERGE "
text trej "REJECT "
text thead "head="
text trevw "reviewer="
text trch "FORGE-RECEIPT v1\n"
text tclone "clone="
text tgate "gate_rc="
text tneg "negctl_rc="

om2
note INTERPLANE Forge v0: agents express intent, the forge retains authority.
note forge decide HEAD VERDICT RECEIPT prints "MERGE OK" and exits 0, or "HOLD <CODE>" and exits 1.
note forge status RID [REVIEWS [RECEIPTS]] lists the live Radicle patches of RID and decides each
note patch that has a verdict file. Spec: docs/FORGE.md. Formats: forge/README.md.
note Every check fails closed: anything not proven is a HOLD.
global m uchar 1048576
global g ulong 64
note memory map of m: verdict, receipt, patch head, path, output line, exec packet,
note directory records, command output, patch ids, environment, arguments, patch fields
const kv ulong 0
const vcap ulong 65536
const kr ulong 65536
const rcap ulong 4096
const kh ulong 69632
const kp ulong 73728
const pcap ulong 4096
const kw ulong 77824
const wcap ulong 8192
const ke ulong 86016
const ecap ulong 4096
const kd ulong 90112
const dcap ulong 32768
const ko ulong 131072
const ocap ulong 524288
const ki ulong 655360
const icap ulong 512
const kx ulong 659456
const krid ulong 671744
const krev ulong 672000
const krcp ulong 676096
const ks ulong 680192
const kn ulong 684288
note g slots: 0 output length, 1 verdict length, 2 receipt length, 3 verdict kind,
note 4 verdict head offset, 5 reviewer offset, 6 reviewer length, 7 clone offset,
note 8 gate_rc, 9 negctl_rc, 10 author offset, 11 author length, 12 receipt keys seen,
note 13 command output length, 19 HOME length, 21 PATH length, 16 RID length,
note 17 reviews dir length, 18 receipts dir length, 23 status word length,
note 24 verdict name length, 30 packet length, 31 packet count, 32 read end of the spawn pipe
text tverd "VERDICT "
text tvw "VERDICT"
text tmaf "MERGE_AFTER_FIX "
text tmrg "MERGE "
text trej "REJECT "
text thead "head="
text trevw "reviewer="
text trch "FORGE-RECEIPT v1\n"
text tclone "clone="
text tgate "gate_rc="
text tneg "negctl_rc="
text tauth "author="
text tgcmd "gate_cmd="
text tncmd "negctl_cmd="
text tdec "decide"
text tstat "status"
text tmrgw "MERGE "
text tholdw "HOLD "
text tok "OK"
text tusage "USAGE"
text tbadh "BAD_HEAD"
text tvunr "VERDICT_UNREADABLE"
text tvmal "VERDICT_MALFORMED"
text tvmaf "VERDICT_MERGE_AFTER_FIX"
text tvrej "VERDICT_REJECT"
text thmis "HEAD_MISMATCH"
text tnorv "NO_REVIEWER"
text trunr "RECEIPT_UNREADABLE"
text trmal "RECEIPT_MALFORMED"
text tnong "NO_NEGCTL"
text tcmis "CLONE_MISMATCH"
text tgfail "GATE_FAIL"
text tnpass "NEGCTL_PASSED"
text tself "SELF_REVIEW"
text tvamb "VERDICT_AMBIGUOUS"
text thelp "usage: forge decide <patch-head> <verdict-file> <gate-receipt>\n       forge status <RID> [reviews-dir [receipts-dir]]\n"
text thome "HOME="
text tpath "PATH="
text tdpath "PATH=/usr/local/bin:/usr/bin:/bin"
text tenv "/usr/bin/env"
text trad "rad"
text tpatch "patch"
text tlist "list"
text tshow "show"
text tall "--all"
text trepo "--repo"
text trevd "/handoffs/hive/manager/reviews"
text trcpd "/handoffs/hive/forge/receipts"
text tvsuf ".verdict.txt"
text trsuf ".receipt"
text tlpat " Patch "
text tlhead " Head "
text tlstat " Status "
text tsp "patch "
text tsst " status="
text tshd " head="
text tsvd " verdict="
text tsdc " decision="
text tnone "none"
text tnorun "NOT_RUN no verdict file"
text tsum "forge status "
text tspat " patches="
text tsdec " decided="
text tsmrg " merge="
text tshld " hold="
text tsnr " not_run="
text terad "forge: rad failed, exit "
text tebad "forge: bad RID\n"
text tehome "forge: HOME is not set\n"
text tefld "forge: patch fields not found for "

note ---- byte helpers over m ----

note mat: true when m[ps..ps+len t) equals t and the match ends at or before lim
fn mat ps ulong lim ulong t view uchar * to bool
n = len t
if gt add ps n lim
ret false
end
i = ulong 0
while lt i n bound 4096
if ne get m add ps i get t i
ret false
end
i = add i 1
end
ret true
end

fn ishex c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 102
ret true
end
ret false
end

note hex40: exactly 40 lowercase hex digits at m[ps..ps+40), all before lim
fn hex40 ps ulong lim ulong to bool
if gt add ps 40 lim
ret false
end
i = ulong 0
while lt i 40 bound 40
if eq ishex get m add ps i false
ret false
end
i = add i 1
end
ret true
end

fn eqr a ulong b ulong n ulong to bool
i = ulong 0
while lt i n bound 65536
if ne get m add a i get m add b i
ret false
end
i = add i 1
end
ret true
end

fn cpy dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 65536
put m add dst i get m add src i
i = add i 1
end
end

fn tcpy dst ulong t view uchar * to ulong
n = len t
i = ulong 0
while lt i n bound 4096
put m add dst i get t i
i = add i 1
end
ret n
end

note eol: offset of the next newline at or after ps, or lim when there is none
fn eol ps ulong lim ulong to ulong
p = ps
while lt p lim bound 1048576
if eq get m p 10
ret p
end
p = add p 1
end
ret p
end

note ---- output line ----

fn obyte c uchar to void
w = get g 0
if ge w wcap
trap 12
end
put m add kw w c
put g 0 add w 1
end

fn otext t view uchar * to void
i = ulong 0
n = len t
while lt i n bound 4096
obyte get t i
i = add i 1
end
end

fn ocopy ps ulong n ulong to void
i = ulong 0
while lt i n bound 8192
obyte get m add ps i
i = add i 1
end
end

fn onum v ulong to void
b = new uchar 24 0
i = ulong 24
x = v
c = true
while c bound 24
i = sub i 1
put b i uchar add 48 rem x 10
x = div x 10
if eq x 0
c = false
end
end
while lt i 24 bound 24
obyte get b i
i = add i 1
end
end

fn oflush fd int to void
w = get g 0
o = ulong 0
c = true
while c bound 8192
if ge o w
c = false
else
r = write fd m add kw o sub w o
if le r 0
c = false
else
o = add o ulong r
end
end
end
put g 0 0
end

fn oreason c int to void
if eq c 0
otext tok
end
if eq c 1
otext tusage
end
if eq c 2
otext tbadh
end
if eq c 3
otext tvunr
end
if eq c 4
otext tvmal
end
if eq c 5
otext tvmaf
end
if eq c 6
otext tvrej
end
if eq c 7
otext thmis
end
if eq c 8
otext tnorv
end
if eq c 9
otext trunr
end
if eq c 10
otext trmal
end
if eq c 11
otext tnong
end
if eq c 12
otext tcmis
end
if eq c 13
otext tgfail
end
if eq c 14
otext tnpass
end
if eq c 15
otext tself
end
if eq c 16
otext tvamb
end
end

note odecis: "MERGE OK" or "HOLD <CODE>" into the output line
fn odecis c int to void
if eq c 0
otext tmrgw
else
otext tholdw
end
oreason c
end

note ---- file loading ----

note load: read the file named by m[kp..kp+pn) into m[ps..ps+cap); return its length, or -1 when
note it cannot be opened or read or does not fit (a file of cap bytes or more does not fit)
fn load pn ulong ps ulong cap ulong to long
fl = fopen m kp pn 524288 0
if lt fl 0
ret -1
end
fd = int fl
n = ulong 0
r = long 0
c = true
while c bound 1048576
if ge n cap
c = false
else
r = read fd m add ps n sub cap n
if le r 0
c = false
else
n = add n ulong r
end
end
end
x = fclose fd
if lt r 0
ret -1
end
if ge n cap
ret -1
end
ret long n
end

note ---- verdict ----

note pverd: line 1 is exactly "VERDICT <MERGE|MERGE_AFTER_FIX|REJECT> head=<40 lowercase hex>"
note followed by a newline, a space or the end of the file. Return 0 or 4 (VERDICT_MALFORMED).
fn pverd to int
n = add kv get g 1
if eq mat kv n tverd false
ret 4
end
p = add kv 8
k = ulong 0
if mat p n tmaf
k = ulong 2
p = add p 16
else
if mat p n tmrg
k = ulong 1
p = add p 6
else
if mat p n trej
k = ulong 3
p = add p 7
end
end
end
if eq k 0
ret 4
end
if eq mat p n thead false
ret 4
end
p = add p 5
if eq hex40 p n false
ret 4
end
q = add p 40
if lt q n
c = get m q
if and ne c 10 ne c 32
ret 4
end
end
put g 3 k
put g 4 p
ret scanv n
end

note scanv: no later line may start with VERDICT, and at most one line starts with reviewer=
fn scanv n ulong to int
p = add eol kv n 1
put g 5 0
put g 6 0
seen = false
while lt p n bound 65536
e = eol p n
if mat p e tvw
ret 4
end
if mat p e trevw
if seen
ret 4
end
seen = true
put g 5 add p 9
put g 6 sub e add p 9
end
p = add e 1
end
ret 0
end

note ---- gate receipt (forge-receipt v1) ----

note pdec: 1 to 3 decimal digits in m[v..e), value at most 255; 1000 means malformed
fn pdec v ulong e ulong to ulong
n = sub e v
if or eq n 0 gt n 3
ret 1000
end
x = ulong 0
i = v
while lt i e bound 3
c = get m i
if or lt c 48 gt c 57
ret 1000
end
x = add mul x 10 ulong sub c 48
i = add i 1
end
if gt x 255
ret 1000
end
ret x
end

note rkey: one key=value line m[p..e). Known keys only, each at most once.
fn rkey p ulong e ulong to int
s = get g 12
if mat p e tclone
if ne and s 1 0
ret 10
end
v = add p 6
if ne sub e v 40
ret 10
end
if eq hex40 v e false
ret 10
end
put g 7 v
put g 12 or s 1
ret 0
end
if mat p e tgate
if ne and s 2 0
ret 10
end
d = pdec add p 8 e
if eq d 1000
ret 10
end
put g 8 d
put g 12 or s 2
ret 0
end
if mat p e tneg
if ne and s 4 0
ret 10
end
d = pdec add p 10 e
if eq d 1000
ret 10
end
put g 9 d
put g 12 or s 4
ret 0
end
if mat p e tauth
if ne and s 8 0
ret 10
end
v = add p 7
if eq v e
ret 10
end
put g 10 v
put g 11 sub e v
put g 12 or s 8
ret 0
end
if mat p e tgcmd
if ne and s 16 0
ret 10
end
put g 12 or s 16
ret 0
end
if mat p e tncmd
if ne and s 32 0
ret 10
end
put g 12 or s 32
ret 0
end
ret 10
end

note prcpt: return 0, 10 (RECEIPT_MALFORMED) or 11 (NO_NEGCTL)
fn prcpt to int
n = add kr get g 2
if eq mat kr n trch false
ret 10
end
p = add kr 17
put g 12 0
while lt p n bound 4096
e = eol p n
r = rkey p e
if ne r 0
ret r
end
p = add e 1
end
s = get g 12
if ne and s 11 11
ret 10
end
if eq and s 4 0
ret 11
end
ret 0
end

note hasauth: the reviewer text contains the receipt author (the author reviewed its own work)
fn hasauth to bool
ro = get g 5
rn = get g 6
ao = get g 10
an = get g 11
if gt an rn
ret false
end
i = ulong 0
lim = sub rn an
while le i lim bound 65536
if eqr add ro i ao an
ret true
end
i = add i 1
end
ret false
end

note ---- the merge decision ----

note decide: vr and rr are the verdict and receipt load results; the patch head is m[kh..kh+40).
note The first failing invariant is the reason. 0 is MERGE; everything else is HOLD.
fn decide vr long rr long to int
if eq hex40 kh add kh 40 false
ret 2
end
if le vr 0
ret 3
end
c = pverd
if ne c 0
ret c
end
k = get g 3
if eq k 2
ret 5
end
if eq k 3
ret 6
end
if eq eqr get g 4 kh 40 false
ret 7
end
if eq get g 6 0
ret 8
end
if le rr 0
ret 9
end
c = prcpt
if ne c 0
ret c
end
if eq eqr get g 7 kh 40 false
ret 12
end
if ne get g 8 0
ret 13
end
if eq get g 9 0
ret 14
end
if hasauth
ret 15
end
ret 0
end

fn say c int to int
put g 0 0
odecis c
obyte 10
oflush 1
if eq c 0
ret 0
end
ret 1
end

fn cdecide to int
if ne argcnt 5
ret say 1
end
hn = argread 2 m kh 64
if ne hn 40
ret say 2
end
pn = argread 3 m kp pcap
vr = long -1
if gt pn 0
vr = load ulong pn kv vcap
end
if gt vr 0
put g 1 ulong vr
end
qn = argread 4 m kp pcap
rr = long -1
if gt qn 0
rr = load ulong qn kr rcap
end
if gt rr 0
put g 2 ulong rr
end
ret say decide vr rr
end

note ---- status: the Radicle edge (rad CLI through /usr/bin/env) ----

fn pkinit to void
put g 30 2
put g 31 0
end

note pkadd: append one packed-list record m[ps..ps+n) to the exec packet
fn pkadd ps ulong n ulong to void
w = get g 30
if gt add add w 2 n ecap
trap 12
end
put m add ke w uchar and n 255
put m add ke add w 1 uchar shr n 8
cpy add ke add w 2 ps n
put g 30 add add w 2 n
put g 31 add get g 31 1
end

fn pktext t view uchar * to void
w = get g 30
n = len t
if gt add add w 2 n ecap
trap 12
end
put m add ke w uchar and n 255
put m add ke add w 1 uchar shr n 8
x = tcpy add ke add w 2 t
put g 30 add add w 2 n
put g 31 add get g 31 1
end

fn pkdone to ulong
c = get g 31
put m ke uchar and c 255
put m add ke 1 uchar shr c 8
ret get g 30
end

note radpk: /usr/bin/env HOME=.. PATH=.. rad patch <verb> [ID] --repo RID; id is m[ps..ps+7) when n > 0
fn radpk verb int ps ulong n ulong to ulong
pkinit
pktext tenv
pkadd kx get g 19
pkadd add kx 1024 get g 21
pktext trad
pktext tpatch
if eq verb 0
pktext tlist
pktext tall
else
pktext tshow
pkadd ps n
end
pktext trepo
pkadd krid get g 16
ret pkdone
end

note spawn: run the packet with stdout on a pipe; return the child pid (read end in g 32) or a negative errno
fn spawn pn ulong to long
pf = new uchar 8 0
r = pipefds pf 0 8 524288
if lt r 0
ret r
end
rfd = int or ulong get pf 0 shl ulong get pf 1 8
wfd = int or ulong get pf 4 shl ulong get pf 5 8
pid = fork
if eq pid 0
y = dupfd wfd 1 0
y = execprog m ke pn
exit 127
end
x = fclose wfd
if lt pid 0
x = fclose rfd
ret pid
end
put g 32 ulong rfd
ret pid
end

note drain: read the child's stdout into m[ko..ko+ocap), length in g 13; true when it overflowed
note (the child is then killed, so a runaway child cannot block the forge)
fn drain rfd int pid long to bool
n = ulong 0
ovf = false
c = true
while c bound 1048576
if ge n ocap
ovf = true
x = killpid int pid 9
c = false
else
r = read rfd m add ko n sub ocap n
if le r 0
c = false
else
n = add n ulong r
end
end
end
x = fclose rfd
put g 13 n
ret ovf
end

note runcmd: run the packet, capture stdout; return the exit status, or a negative errno
fn runcmd pn ulong to long
st = new uchar 4 0
pid = spawn pn
if lt pid 0
ret pid
end
ovf = drain int get g 32 pid
w = waitpid int pid st 0 4 0
if lt w 0
ret w
end
if ovf
ret -27
end
s = or ulong get st 0 shl ulong get st 1 8
if ne and s 127 0
ret -4
end
ret long and shr s 8 255
end

note envget: copy the environment entry with prefix t into m[ps..ps+cap); return its length or 0
fn envget t view uchar * ps ulong cap ulong to ulong
c = ulong envcnt
i = ulong 0
while lt i c bound 65536
n = envread i m add kx 5120 4096
if gt n 0
if mat add kx 5120 add add kx 5120 ulong n t
if le ulong n cap
cpy ps add kx 5120 ulong n
ret ulong n
end
end
end
i = add i 1
end
ret 0
end

note rowid: a patch table row is the box bar (e2 94 82), a space, a state glyph, spaces,
note 7 hex digits and a space. Return the offset of the digits, or 0.
fn rowid p ulong e ulong to ulong
if gt add p 14 e
ret 0
end
if ne get m p 226
ret 0
end
if ne get m add p 1 148
ret 0
end
if ne get m add p 2 130
ret 0
end
q = add p 3
if ne get m q 32
ret 0
end
q = add q 1
while and lt q e ne get m q 32 bound 1048576
q = add q 1
end
while and lt q e eq get m q 32 bound 1048576
q = add q 1
end
s = q
while and lt q e ishex get m q bound 1048576
q = add q 1
end
if ne sub q s 7
ret 0
end
if ge q e
ret 0
end
if ne get m q 32
ret 0
end
ret s
end

fn plist to ulong
n = add ko get g 13
p = ko
k = ulong 0
while lt p n bound 524288
e = eol p n
s = rowid p e
if ne s 0
if lt k icap
cpy add ki mul k 8 s 7
k = add k 1
end
end
p = add e 1
end
ret k
end

note lblval: a field row "<bar><label>   value"; return the value offset or 0
fn lblval p ulong e ulong t view uchar * to ulong
if gt add p 3 e
ret 0
end
if ne get m p 226
ret 0
end
if ne get m add p 1 148
ret 0
end
if ne get m add p 2 130
ret 0
end
q = add p 3
if eq mat q e t false
ret 0
end
q = add q len t
while and lt q e eq get m q 32 bound 1048576
q = add q 1
end
ret q
end

note full40: 40 hex digits at v, then a space or the end of the row
fn full40 v ulong e ulong to bool
if eq hex40 v e false
ret false
end
q = add v 40
if lt q e
if ne get m q 32
ret false
end
end
ret true
end

note sword: copy the status word (up to 31 bytes before a space) at v into ks+128; false when empty
fn sword v ulong e ulong to bool
q = v
c = true
while c bound 64
if ge q e
c = false
else
if eq get m q 32
c = false
else
if ge sub q v 31
c = false
else
q = add q 1
end
end
end
end
if eq q v
ret false
end
cpy add ks 128 v sub q v
put g 23 sub q v
ret true
end

note pshow: take the first Patch, Head and Status rows of "rad patch show" into ks; 7 when all found
fn pshow to ulong
n = add ko get g 13
p = ko
f = ulong 0
while lt p n bound 524288
e = eol p n
if eq and f 1 0
v = lblval p e tlpat
if ne v 0
if full40 v e
cpy ks v 40
f = or f 1
end
end
end
if eq and f 2 0
v = lblval p e tlhead
if ne v 0
if full40 v e
cpy add ks 64 v 40
f = or f 2
end
end
end
if eq and f 4 0
v = lblval p e tlstat
if ne v 0
if sword v e
f = or f 4
end
end
end
p = add e 1
end
ret f
end

note vname: a directory entry name m[a..a+nl) ends in "-<head8>.verdict.txt"
fn vname a ulong nl ulong to bool
if lt nl 22
ret false
end
b = sub add a nl 21
if ne get m b 45
ret false
end
if eq eqr add b 1 add ks 64 8 false
ret false
end
ret mat add b 9 add a nl tvsuf
end

fn u16at p ulong to ulong
ret or ulong get m p shl ulong get m add p 1 8
end

note dscan: walk r bytes of getdents64 records at kd; return k plus the number of verdict names found
fn dscan r ulong k0 ulong to ulong
k = k0
o = ulong 0
while lt o r bound 32768
rl = u16at add kd add o 16
a = add kd add o 19
nl = ulong 0
while and lt nl 255 ne get m add a nl 0 bound 256
nl = add nl 1
end
if vname a nl
if eq k 0
cpy kn a nl
put g 24 nl
end
k = add k 1
end
if eq rl 0
o = r
else
o = add o rl
end
end
ret k
end

note findv: scan the reviews directory for the verdict of the head at ks+64. Return the number
note of matching names; the first is copied to kn with its length in g 24.
fn findv to ulong
fl = fopen m krev get g 17 524288 0
if lt fl 0
ret 0
end
fd = int fl
k = ulong 0
c = true
while c bound 65536
r = getdnts fd m kd dcap
if le r 0
c = false
else
k = dscan ulong r k
end
end
x = fclose fd
ret k
end

note dpath: m[kp..) = dir "/" name; return its length
fn dpath dir ulong dn ulong nm ulong nn ulong to ulong
cpy kp dir dn
put m add kp dn 47
cpy add kp add dn 1 nm nn
ret add add dn 1 nn
end

note spatch: decide one patch whose fields are in ks; print its line; return 0 merge, 1 hold, 2 not run
fn spatch id ulong to int
put g 0 0
otext tsp
ocopy id 7
otext tsst
ocopy add ks 128 get g 23
otext tshd
ocopy add ks 64 40
otext tsvd
k = findv
if eq k 0
otext tnone
otext tsdc
otext tnorun
obyte 10
oflush 1
ret 2
end
ocopy kn get g 24
otext tsdc
if gt k 1
odecis 16
obyte 10
oflush 1
ret 1
end
cpy kh add ks 64 40
pn = dpath krev get g 17 kn get g 24
vr = load pn kv vcap
if gt vr 0
put g 1 ulong vr
end
rn = get g 18
cpy kp krcp rn
put m add kp rn 47
cpy add kp add rn 1 add ks 64 40
x = tcpy add kp add rn 41 trsuf
rr = load add add rn 41 x kr rcap
if gt rr 0
put g 2 ulong rr
end
c = decide vr rr
odecis c
obyte 10
oflush 1
if eq c 0
ret 0
end
ret 1
end

fn serr t view uchar * to int
put g 0 0
otext t
oflush 2
ret 2
end

note ridok: "rad:" then 1 to 60 ASCII letters and digits
fn ridok n ulong to bool
if or lt n 5 gt n 64
ret false
end
if ne get m krid 114
ret false
end
if ne get m add krid 1 97
ret false
end
if ne get m add krid 2 100
ret false
end
if ne get m add krid 3 58
ret false
end
i = ulong 4
while lt i n bound 64
c = get m add krid i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 65 le c 90
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq ok false
ret false
end
i = add i 1
end
ret true
end

fn cstatus to int
a = argcnt
if or lt a 3 gt a 5
ret serr thelp
end
rl = argread 2 m krid 128
if lt rl 0
ret serr tebad
end
if eq ridok ulong rl false
ret serr tebad
end
put g 16 ulong rl
hl = envget thome kx 1024
if le hl 5
ret serr tehome
end
put g 19 hl
pl = envget tpath add kx 1024 4096
if eq pl 0
pl = tcpy add kx 1024 tdpath
end
put g 21 pl
dl = long 0
if ge a 4
dl = argread 3 m krev 4000
else
cpy krev add kx 5 sub hl 5
dl = long add sub hl 5 tcpy add krev sub hl 5 trevd
end
if le dl 0
ret serr thelp
end
put g 17 ulong dl
el = long 0
if eq a 5
el = argread 4 m krcp 4000
else
cpy krcp add kx 5 sub hl 5
el = long add sub hl 5 tcpy add krcp sub hl 5 trcpd
end
if le el 0
ret serr thelp
end
put g 18 ulong el
ret slist
end

fn slist to int
r = runcmd radpk 0 0 0
if ne r 0
put g 0 0
otext terad
onum ulong and r 255
obyte 10
oflush 2
ret 2
end
np = plist
i = ulong 0
nm = ulong 0
nh = ulong 0
nn = ulong 0
while lt i np bound 512
id = add ki mul i 8
r = runcmd radpk 1 id 7
if ne r 0
put g 0 0
otext terad
onum ulong and r 255
obyte 10
oflush 2
ret 2
end
if ne pshow 7
put g 0 0
otext tefld
ocopy id 7
obyte 10
oflush 2
ret 2
end
c = spatch id
if eq c 0
nm = add nm 1
end
if eq c 1
nh = add nh 1
end
if eq c 2
nn = add nn 1
end
i = add i 1
end
put g 0 0
otext tsum
ocopy krid get g 16
otext tspat
onum np
otext tsdec
onum add nm nh
otext tsmrg
onum nm
otext tshld
onum nh
otext tsnr
onum nn
obyte 10
oflush 1
ret 0
end

fn main to int
if lt argcnt 2
ret serr thelp
end
n = argread 1 m kp 16
if eq n 6
if mat kp add kp 6 tdec
ret cdecide
end
if mat kp add kp 6 tstat
ret cstatus
end
end
ret serr thelp
end

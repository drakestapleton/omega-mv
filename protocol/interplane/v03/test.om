note SPDX-License-Identifier: Apache-2.0
note protocol/interplane/v03/test.om: comprehensive positive & negative controls for
note interplane v0.3.0 (crossaxis, crossveil, conformance, aien_adapter).
note Compose with:
note   si/directives/om2.om om/tls/sha2.om
note   protocol/interplane/v03/crossaxis.om
note   protocol/interplane/v03/crossveil.om
note   protocol/interplane/v03/conformance.om
note   protocol/interplane/v03/aien_adapter.om
note   protocol/interplane/v03/test.om

text v3_pass "PASS interplane-v03 (crossaxis, crossveil, conformance, aien_adapter) all 7 suites passed\n"
text v3_fail "FAIL interplane-v03\n"

note RFC 4231 Test Case 2: key = "Jefe", data = "what do ya want for nothing?"
note Expected HMAC-SHA256: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
text rfc_key "Jefe"
text rfc_msg "what do ya want for nothing?"
text rfc_exp "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"

text td_p1 "conformance/fixtures/injection/01-basic.json"
text td_b1 "{\"id\":\"01-basic\",\"kind\":\"injection\"}"
text td_p2 "conformance/fixtures/approval/01-write.json"
text td_b2 "{\"id\":\"01-write\",\"kind\":\"approval\"}"
text td_b2_tamper "{\"id\":\"01-write\",\"kind\":\"tampered\"}"

text desk_key "aien-approval-desk-key-v1"
text bind_msg "trace=t1|req=r1|app=a1|path=src/lib.om"
text bind_msg_tamper "trace=t1|req=r1|app=a1|path=src/evil.om"

fn v3_slice_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
n = len a
if gt n ulong 1024
ret false
end
i = ulong 0
while lt i n bound 1024
if ne get a i get b i
ret false
end
i = add i ulong 1
end
ret true
end

fn v3_test_crossaxis to bool
rules = new ulong 80 0
cnt = new ulong 1 0
spec = new ulong 5 0
res = new ulong 3 0

note Rule 1: Alias (ns=1, name=10 -> cap=100)
put spec 0 ulong 1
put spec 1 CA_RULE_ALIAS
put spec 2 ulong 1
put spec 3 ulong 10
put spec 4 ulong 100
if ne ca_add_rule rules cnt spec CA_OK
ret false
end

note Rule 2: Valid Passthrough (ns=0, name=20 -> cap=20)
put spec 0 ulong 2
put spec 1 CA_RULE_PASSTHROUGH
put spec 2 ulong 0
put spec 3 ulong 20
put spec 4 ulong 20
if ne ca_add_rule rules cnt spec CA_OK
ret false
end

note Negative control: Passthrough with non-null namespace must be refused
put spec 0 ulong 3
put spec 1 CA_RULE_PASSTHROUGH
put spec 2 ulong 1
put spec 3 ulong 20
put spec 4 ulong 20
if ne ca_add_rule rules cnt spec CA_ERR_BAD_PASSTHROUGH
ret false
end

note Negative control: Passthrough with from_name != to_cap must be refused
put spec 2 ulong 0
put spec 4 ulong 21
if ne ca_add_rule rules cnt spec CA_ERR_BAD_PASSTHROUGH
ret false
end

note Exact lookup matches Rule 1 (Alias) and Rule 2 (Passthrough); unknown -> CA_ERR_UNKNOWN_CAP
if ne ca_map_tool rules get cnt 0 ulong 1 ulong 10 res CA_OK
ret false
end
if or ne get res 0 ulong 100 ne get res 2 ulong 0
ret false
end
if ne ca_map_tool rules get cnt 0 ulong 0 ulong 20 res CA_OK
ret false
end
if or ne get res 0 ulong 20 ne get res 2 ulong 1
ret false
end
if ne ca_map_tool rules get cnt 0 ulong 9 ulong 99 res CA_ERR_UNKNOWN_CAP
ret false
end

note Deterministic domain selector with budget=10
cm = new ulong 16 0
cc = new ulong 16 0
sel = new ulong 16 0
put cm 0 ulong 1
put cc 0 ulong 6
put cm 1 ulong 2
put cc 1 ulong 2
put cm 2 ulong 1
put cc 2 ulong 5
n_sel = ca_select_domain ulong 3 ulong 1 ulong 10 cm cc sel
if ne n_sel ulong 1
ret false
end
if or ne get sel 0 ulong 1 or ne get sel 1 ulong 2 ne get sel 2 ulong 3
ret false
end
ret true
end

fn v3_test_conformance_trust_digest to bool
c1 = new ulong 40 0
c2 = new ulong 40 0
c3 = new ulong 40 0
d1 = new uchar 32 0
d2 = new uchar 32 0
d3 = new uchar 32 0
sha256_init c1
cf_trust_add_entry c1 td_p1 td_b1
cf_trust_add_entry c1 td_p2 td_b2
sha256_final c1 d1

sha256_init c2
cf_trust_add_entry c2 td_p1 td_b1
cf_trust_add_entry c2 td_p2 td_b2
sha256_final c2 d2

if not cf_dig_eq d1 d2
ret false
end

note Tampering one fixture body must change TRUST-DIGEST
sha256_init c3
cf_trust_add_entry c3 td_p1 td_b1
cf_trust_add_entry c3 td_p2 td_b2_tamper
sha256_final c3 d3
if cf_dig_eq d1 d3
ret false
end

note T3/T4 subset rule checks
if not cf_subset_admit ulong 3 ulong 7
ret false
end
if cf_subset_admit ulong 8 ulong 7
ret false
end
if cf_subset_admit ulong 0 ulong 7
ret false
end
ret true
end

fn v3_test_hmac_rfc4231 to bool
mac = new uchar 32 0
hx = new uchar 64 0
aien_hmac_sha256 rfc_key rfc_msg mac
cf_hex32 mac hx
if not v3_slice_eq hx rfc_exp
ret false
end
note ApprovalBinding tamper detection
m1 = new uchar 32 0
m2 = new uchar 32 0
aien_hmac_sha256 desk_key bind_msg m1
aien_hmac_sha256 desk_key bind_msg_tamper m2
if aien_mac_eq m1 m2
ret false
end
ret true
end

fn v3_test_aien_adapter to bool
note Fail-closed when gate is not linked
if ne aien_decide AIEN_CAP_READ_FILE ulong 0 ulong 1 ulong 1 CV_DEC_DENIED
ret false
end
note Read-only allowed when gate allows
if ne aien_decide AIEN_CAP_READ_FILE ulong 1 ulong 1 ulong 0 CV_DEC_AUTHORIZED
ret false
end
note World mutation requires approval when no grant
if ne aien_decide AIEN_CAP_WRITE_FILE ulong 1 ulong 1 ulong 0 CV_DEC_REQUIRES_APPROVAL
ret false
end
note World mutation authorized only with explicit grant
if ne aien_decide AIEN_CAP_WRITE_FILE ulong 1 ulong 1 ulong 1 CV_DEC_AUTHORIZED
ret false
end
note Unknown capability always denied
if ne aien_decide ulong 99 ulong 1 ulong 1 ulong 1 CV_DEC_DENIED
ret false
end

note Two-phase single-use approval grant lifecycle
st = new ulong 1 0
put st 0 GRANT_UNUSED
if ne aien_grant_reserve st AIEN_OK
ret false
end
note Double-reserve fails
if ne aien_grant_reserve st AIEN_ERR_GRANT_STATE
ret false
end
note Release returns to UNUSED
if ne aien_grant_release st AIEN_OK
ret false
end
note Reserve -> Commit -> Spent
if ne aien_grant_reserve st AIEN_OK
ret false
end
if ne aien_grant_commit st AIEN_OK
ret false
end
note Replay of spent grant MUST be refused
if ne aien_grant_reserve st AIEN_ERR_GRANT_REPLAY
ret false
end
if ne aien_grant_commit st AIEN_ERR_GRANT_REPLAY
ret false
end
if ne aien_grant_revoke st AIEN_ERR_GRANT_REPLAY
ret false
end
note Revoking an unused grant blocks subsequent reserve
st2 = new ulong 1 0
put st2 0 GRANT_UNUSED
if ne aien_grant_revoke st2 AIEN_OK
ret false
end
if ne aien_grant_reserve st2 AIEN_ERR_GRANT_REVOKED
ret false
end
ret true
end

fn main to int
ok = true
if not v3_test_crossaxis
ok = false
end
if not cf_verify_negctl_matrix
ok = false
end
if not v3_test_conformance_trust_digest
ok = false
end
if not v3_test_hmac_rfc4231
ok = false
end
if not v3_test_aien_adapter
ok = false
end
if not ok
k = write int 1 v3_fail ulong 0 len v3_fail
if lt k long 0
ret int 1
end
ret int 1
end
k = write int 1 v3_pass ulong 0 len v3_pass
if lt k long 0
ret int 1
end
ret int 0
end

note SPDX-License-Identifier: Apache-2.0
note protocol/interplane/v03/crossaxis.om: pure-Omega port of interplane-crossaxis (v0.3.0).
note Explicit capability mapping table (data, not code) and deterministic domain selector.
note Invariant: CrossAxis NEVER answers "may the model run it?".
note Compose after si/directives/om2.om.

const CA_OK ulong 0
const CA_ERR_UNKNOWN_CAP ulong 1
const CA_ERR_BAD_PASSTHROUGH ulong 2
const CA_ERR_TABLE_FULL ulong 3
const CA_ERR_BAD_NAME ulong 4

const CA_RULE_ALIAS ulong 0
const CA_RULE_PASSTHROUGH ulong 1

const CA_MAX_RULES ulong 16

note Rule table representation (fixed-slot scalar IDs for deterministic O(N) first-match lookup):
note   Each rule slot i (0..count-1) occupies 5 ulongs in rules[80]:
note     [i*5 + 0] = rule_id
note     [i*5 + 1] = kind (CA_RULE_ALIAS or CA_RULE_PASSTHROUGH)
note     [i*5 + 2] = from_ns (0 = null namespace, >0 = namespace id)
note     [i*5 + 3] = from_name_id
note     [i*5 + 4] = to_cap_id

fn ca_validate_rule kind ulong from_ns ulong from_name ulong to_cap ulong to ulong
if or eq from_name ulong 0 eq to_cap ulong 0
ret CA_ERR_BAD_NAME
end
if eq kind CA_RULE_PASSTHROUGH
if or ne from_ns ulong 0 ne from_name to_cap
ret CA_ERR_BAD_PASSTHROUGH
end
ret CA_OK
end
if eq kind CA_RULE_ALIAS
ret CA_OK
end
ret CA_ERR_BAD_PASSTHROUGH
end

note spec[0]=rule_id, spec[1]=kind, spec[2]=from_ns, spec[3]=from_name, spec[4]=to_cap
fn ca_add_rule rules edit ulong 80 cnt edit ulong 1 spec view ulong 5 to ulong
r_id = get spec 0
kind = get spec 1
from_ns = get spec 2
from_name = get spec 3
to_cap = get spec 4
rc = ca_validate_rule kind from_ns from_name to_cap
if ne rc CA_OK
ret rc
end
n = get cnt 0
if ge n CA_MAX_RULES
ret CA_ERR_TABLE_FULL
end
base = mul n ulong 5
put rules base r_id
put rules add base ulong 1 kind
put rules add base ulong 2 from_ns
put rules add base ulong 3 from_name
put rules add base ulong 4 to_cap
put cnt 0 add n ulong 1
ret CA_OK
end

note Exact lookup, first matching rule wins. No match -> CA_ERR_UNKNOWN_CAP.
note On match: res[0] = to_cap_id, res[1] = rule_id, res[2] = passthrough (1/0).
fn ca_map_tool rules view ulong 80 cnt ulong req_ns ulong req_name ulong res edit ulong 3 to ulong
if gt cnt CA_MAX_RULES
ret CA_ERR_UNKNOWN_CAP
end
i = ulong 0
while lt i cnt bound 16
base = mul i ulong 5
r_ns = get rules add base ulong 2
r_nm = get rules add base ulong 3
if and eq r_ns req_ns eq r_nm req_name
put res 0 get rules add base ulong 4
put res 1 get rules base
if eq get rules add base ulong 1 CA_RULE_PASSTHROUGH
put res 2 ulong 1
else
put res 2 ulong 0
end
ret CA_OK
end
i = add i ulong 1
end
ret CA_ERR_UNKNOWN_CAP
end

note Deterministic domain selector: selects capabilities matching domain_mask within token budget.
note   caps_mask[i] = domain bitmask of cap i; caps_cost[i] = token cost of cap i.
note   Writes selected[i] = 1 (selected), 2 (excluded: domain), 3 (refused: budget).
note   Returns number of selected capabilities.
fn ca_select_domain count ulong domain_mask ulong budget ulong caps_mask view ulong 16 caps_cost view ulong 16 selected edit ulong 16 to ulong
if gt count CA_MAX_RULES
ret ulong 0
end
used = ulong 0
sel = ulong 0
i = ulong 0
while lt i count bound 16
m = get caps_mask i
c = get caps_cost i
if eq and m domain_mask ulong 0
put selected i ulong 2
else
if le add used c budget
used = add used c
put selected i ulong 1
sel = add sel ulong 1
else
put selected i ulong 3
end
end
i = add i ulong 1
end
ret sel
end

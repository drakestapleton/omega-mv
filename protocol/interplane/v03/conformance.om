note SPDX-License-Identifier: Apache-2.0
note protocol/interplane/v03/conformance.om: pure-Omega port of interplane-conformance (v0.3.0).
note TRUST-DIGEST canonical SHA-256 over sorted corpus + negative-controls + protocol + translation,
note T3/T4 adapter subset selection rule, and negative-control matrix verifier (V2, V4, V6).
note Compose after si/directives/om2.om, om/tls/sha2.om, and protocol/interplane/v03/crossveil.om.

const CF_ADAPTER_ODYSSEUS ulong 3
const CF_ADAPTER_AIEN ulong 4

text cf_hex "0123456789abcdef"
text cf_sep "  "
text cf_nl "\n"

fn cf_hex32 dig view uchar 32 dst edit uchar 64 to void
for i ulong 32
b = ulong get dig i
put dst mul i ulong 2 get cf_hex shr b ulong 4
put dst add mul i ulong 2 ulong 1 get cf_hex and b ulong 15
end
end

fn cf_dig_eq a view uchar 32 b view uchar 32 to bool
for i ulong 32
if ne get a i get b i
ret false
end
end
ret true
end

note Append one canonical sha256sum line ("<hex64>  <path>\n") into a running SHA-256 context.
fn cf_trust_add_entry ctx edit ulong 40 path view uchar * body view uchar * to void
d = new uchar 32 0
hx = new uchar 64 0
bctx = new ulong 40 0
sha256_init bctx
sha256_update bctx body
sha256_final bctx d
cf_hex32 d hx
sha256_update ctx hx
sha256_update ctx cf_sep
sha256_update ctx path
sha256_update ctx cf_nl
end

note T3/T4 subset rule (bench/PROTOCOL-0.3.md section 2):
note   Reads fixture capability requirement mask & adapter supported capability mask.
note   NEVER reads fixture results. Returns true iff every required cap bit is supported.
fn cf_subset_admit req_caps ulong adapter_caps ulong to bool
if eq req_caps ulong 0
ret false
end
ret eq and req_caps adapter_caps req_caps
end

note Negative-control verifier:
note   Verifies that baseline (CV_CTL_NONE) refuses/requires-approval on injection, effect, and replay,
note   AND that V2, V4, V6 mutants each break their respective invariant (proving the check catches them).
fn cf_verify_negctl_matrix to bool
ledger = new ulong 32 0
lcnt = new ulong 1 0
ctx = new ulong 6 0
res = new ulong 2 0

note Case 1 (V2 target): untrusted request claiming approval, authority says REQUIRES_APPROVAL
put ctx 0 ulong 101
put ctx 1 ulong 1
put ctx 2 CV_EXP_UNTRUSTED
put ctx 3 ulong 1
put ctx 4 CV_DEC_REQUIRES_APPROVAL
put ctx 5 CV_CTL_NONE
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_REQUIRES_APPROVAL
ret false
end
note Mutant V2 must bypass into AUTHORIZED (so test detects it)
put ctx 0 ulong 102
put ctx 5 CV_CTL_V2_CLAIMED_APPROVAL
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_AUTHORIZED
ret false
end

note Case 2 (V4 target): effect capability denied by authority under baseline
put ctx 0 ulong 201
put ctx 1 ulong 1
put ctx 2 CV_EXP_TRUSTED
put ctx 3 ulong 0
put ctx 4 CV_DEC_DENIED
put ctx 5 CV_CTL_NONE
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_DENIED
ret false
end
note Mutant V4 must bypass into AUTHORIZED
put ctx 0 ulong 202
put ctx 5 CV_CTL_V4_EFFECT_BYPASS
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_AUTHORIZED
ret false
end

note Case 3 (V6 target): replay of req_id=101 must be DENIED (CV_ERR_DUPLICATE_REQ) under baseline
put ctx 0 ulong 101
put ctx 1 ulong 0
put ctx 2 CV_EXP_TRUSTED
put ctx 3 ulong 0
put ctx 4 CV_DEC_AUTHORIZED
put ctx 5 CV_CTL_NONE
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_DENIED
ret false
end
if ne get res 1 CV_ERR_DUPLICATE_REQ
ret false
end
note Mutant V6 resets ledger so replay of req_id=101 slips through as AUTHORIZED
put ctx 5 CV_CTL_V6_NO_REPLAY_CHECK
cv_pipeline_step ledger lcnt ctx res
if ne get res 0 CV_DEC_AUTHORIZED
ret false
end
ret true
end

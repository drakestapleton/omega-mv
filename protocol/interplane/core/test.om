note SPDX-License-Identifier: Apache-2.0
note protocol/interplane/core/test.om: comprehensive positive & negative control tests
note for Interplane core envelope parser, trust-boundary policy evaluator, conformance
note lifecycle state machine, and hash-chained provenance ledger.
note Compose with:
note   si/directives/om2.om om/tls/sha2.om protocol/interplane/core/envelope.om
note   protocol/interplane/core/policy.om protocol/interplane/core/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"

text t_c1 "version_and_identifier_positive_and_negative"
text t_c2 "untrusted_envelope_parser_valid_and_digest_determinism"
text t_c3 "untrusted_envelope_parser_rejects_dup_unknown_missing_badchar"
text t_c4 "inv1_parsing_never_executes_and_lifecycle_machine"
text t_c5 "inv2_transport_never_grants_mtls_and_loopback_denied"
text t_c6 "inv3_valid_envelope_is_not_authorization"
text t_c7 "inv4_signature_proves_origin_not_authority_and_revoked"
text t_c8 "inv5_runtime_policy_decides_no_request_upgrade"
text t_c9 "provenance_ledger_chain_and_tamper_detection"
text t_done "PASS interplane-core all 9 test suites passed\n"

text t_v_ok1 "1.0"
text t_v_ok2 "1.12"
text t_v_bad_maj "2.0"
text t_v_bad_lz "1.01"
text t_v_bad_fmt "1.0.0"

text t_id_ok "agent.spark-01_a"
text t_id_trav "foo..bar"
text t_id_lead ".hidden"
text t_id_upper "BadUpper"
text t_id_space "bad id"

text t_env_ok "version=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ntransport=mtls\nclaimed_policy=1\n"
text t_env_ok_alt "version=1.0\nenvelope_id=env-002\norigin_id=node.spark\naction=read.state\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ntransport=mtls\nclaimed_policy=1\n"
text t_env_dup "version=1.0\nversion=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n"
text t_env_unk "version=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nevil_key=1\n"
text t_env_miss "version=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\n"
text t_env_badhex "version=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\npayload_sha256=ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ\n"
text t_env_badtr "version=1.0\nenvelope_id=env-001\norigin_id=node.spark\naction=read.state\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ntransport=godmode\n"
text t_env_escal "version=1.0\nenvelope_id=env-003\norigin_id=node.spark\naction=policy.set\npayload_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\ntransport=loopback\nclaimed_policy=3\n"

fn report_case name view uchar * ok bool to int
if ok
w1 = ip_write_all int 1 t_pass
w2 = ip_write_all int 1 name
w3 = ip_write_all int 1 t_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = ip_write_all int 1 t_fail
w5 = ip_write_all int 1 name
w6 = ip_write_all int 1 t_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_ver_ident to bool
if ne ip_validate_version t_v_ok1 IP_OK
ret false
end
if ne ip_validate_version t_v_ok2 IP_OK
ret false
end
if ne ip_validate_version t_v_bad_maj IP_ERR_BAD_VERSION
ret false
end
if ne ip_validate_version t_v_bad_lz IP_ERR_BAD_VERSION
ret false
end
if ne ip_validate_version t_v_bad_fmt IP_ERR_BAD_VERSION
ret false
end
if ne ip_valid_ident t_id_ok IP_OK
ret false
end
if ne ip_valid_ident t_id_trav IP_ERR_BAD_IDENT
ret false
end
if ne ip_valid_ident t_id_lead IP_ERR_BAD_IDENT
ret false
end
if ne ip_valid_ident t_id_upper IP_ERR_BAD_IDENT
ret false
end
if ne ip_valid_ident t_id_space IP_ERR_BAD_IDENT
ret false
end
ret true
end

fn test_parse_valid to bool
m1 = new ulong 4 0
m2 = new ulong 4 0
d1 = new uchar 32 0
d2 = new uchar 32 0
if ne ip_parse_envelope t_env_ok m1 d1 IP_OK
ret false
end
if ne get m1 1 TRANS_MTLS
ret false
end
if ne get m1 2 POL_READ_ONLY
ret false
end
if ne get m1 3 LC_PARSED
ret false
end
note Determinism check
if ne ip_parse_envelope t_env_ok m2 d2 IP_OK
ret false
end
if not ip_digest_eq d1 d2
ret false
end
note Different envelope_id produces different digest
if ne ip_parse_envelope t_env_ok_alt m2 d2 IP_OK
ret false
end
if ip_digest_eq d1 d2
ret false
end
ret true
end

fn test_parse_negative to bool
m = new ulong 4 0
d = new uchar 32 0
if ne ip_parse_envelope part t_env_ok 0 0 m d IP_ERR_BAD_LEN
ret false
end
if ne ip_parse_envelope t_env_dup m d IP_ERR_DUP_KEY
ret false
end
if ne ip_parse_envelope t_env_unk m d IP_ERR_UNKNOWN_KEY
ret false
end
if ne ip_parse_envelope t_env_miss m d IP_ERR_MISSING_FIELD
ret false
end
if ne ip_parse_envelope t_env_badhex m d IP_ERR_BAD_HEX
ret false
end
if ne ip_parse_envelope t_env_badtr m d IP_ERR_BAD_TRANSPORT
ret false
end
note Control byte injection (tab 0x09) must be rejected
bad = new uchar 16 0
put bad 0 uchar 118
put bad 1 uchar 61
put bad 2 uchar 9
if ne ip_parse_envelope part bad 0 3 m d IP_ERR_BAD_CHAR
ret false
end
ret true
end

fn test_inv1_parse_never_exec to bool
m = new ulong 4 0
d = new uchar 32 0
if ne ip_parse_envelope t_env_ok m d IP_OK
ret false
end
lc = get m 3
if ne lc LC_PARSED
ret false
end
if ip_can_execute lc
ret false
end
note Jumping directly from PARSED -> EXECUTED or PARSED -> POLICY_AUTHORIZED must fail
if ne ip_lc_transition LC_PARSED LC_EXECUTED POL_ERR_UNAUTH_TRANSITION
ret false
end
if ne ip_lc_transition LC_PARSED LC_POLICY_AUTHORIZED POL_ERR_UNAUTH_TRANSITION
ret false
end
note Valid full sequence: RECEIVED -> PARSED -> ORIGIN_CHECKED -> POLICY_AUTHORIZED -> EXECUTED
if ne ip_lc_transition LC_RECEIVED LC_PARSED POL_OK
ret false
end
if ne ip_lc_transition LC_PARSED LC_ORIGIN_CHECKED POL_OK
ret false
end
if ne ip_lc_transition LC_ORIGIN_CHECKED LC_POLICY_AUTHORIZED POL_OK
ret false
end
if not ip_can_execute LC_POLICY_AUTHORIZED
ret false
end
if ne ip_lc_transition LC_POLICY_AUTHORIZED LC_EXECUTED POL_OK
ret false
end
note Terminal states cannot transition
if ne ip_lc_transition LC_EXECUTED LC_PARSED POL_ERR_UNAUTH_TRANSITION
ret false
end
if ne ip_lc_transition LC_DENIED LC_POLICY_AUTHORIZED POL_ERR_UNAUTH_TRANSITION
ret false
end
ret true
end

fn test_inv2_transport_never_grants to bool
note Even LOOPBACK and MTLS with valid signature MUST be denied under POL_DENY_ALL
if ne ip_eval_policy POL_DENY_ALL OP_READ ORIG_SIG_VALID TRANS_LOOPBACK OP_READ POL_DENY_ALL POL_ERR_POLICY_DENIED
ret false
end
if ne ip_eval_policy POL_DENY_ALL OP_READ ORIG_SIG_VALID TRANS_MTLS OP_READ POL_DENY_ALL POL_ERR_POLICY_DENIED
ret false
end
note Even LOOPBACK cannot grant OP_EXEC when runtime only allows OP_READ
if ne ip_eval_policy POL_STANDARD OP_READ ORIG_SIG_VALID TRANS_LOOPBACK OP_EXEC POL_READ_ONLY POL_ERR_OP_NOT_ALLOWED
ret false
end
note Conversely, UNTRUSTED transport succeeds when runtime policy + origin + op allow it
if ne ip_eval_policy POL_READ_ONLY OP_READ ORIG_SIG_VALID TRANS_UNTRUSTED OP_READ POL_READ_ONLY POL_OK
ret false
end
ret true
end

fn test_inv3_valid_env_not_auth to bool
m = new ulong 4 0
d = new uchar 32 0
if ne ip_parse_envelope t_env_ok m d IP_OK
ret false
end
note Valid envelope is in LC_PARSED, not authorized; calling authorize_step before origin check fails
if ne ip_authorize_step get m 3 POL_READ_ONLY OP_READ ORIG_SIG_VALID OP_READ POL_READ_ONLY POL_ERR_UNAUTH_TRANSITION
ret false
end
if ip_can_execute LC_ORIGIN_CHECKED
ret false
end
note Only after origin check AND policy eval passes is authorization granted
if ne ip_authorize_step LC_ORIGIN_CHECKED POL_READ_ONLY OP_READ ORIG_SIG_VALID OP_READ POL_READ_ONLY POL_OK
ret false
end
ret true
end

fn test_inv4_sig_not_authority to bool
note Valid signature on ORIG_SIG_VALID does NOT grant OP_ADMIN when runtime is POL_STANDARD
if ne ip_eval_policy POL_STANDARD OP_ALL_MASK ORIG_SIG_VALID TRANS_MTLS OP_ADMIN POL_STANDARD POL_ERR_POLICY_DENIED
ret false
end
note Valid signature does NOT grant OP_WRITE when allowed_ops only has OP_READ
if ne ip_eval_policy POL_ELEVATED OP_READ ORIG_SIG_VALID TRANS_MTLS OP_WRITE POL_READ_ONLY POL_ERR_OP_NOT_ALLOWED
ret false
end
note Unverified origin and revoked origin are both refused
if ne ip_eval_policy POL_ELEVATED OP_ALL_MASK ORIG_UNVERIFIED TRANS_LOOPBACK OP_READ POL_READ_ONLY POL_ERR_ORIGIN_UNVERIFIED
ret false
end
if ne ip_eval_policy POL_ELEVATED OP_ALL_MASK ORIG_REVOKED TRANS_LOOPBACK OP_READ POL_READ_ONLY POL_ERR_ORIGIN_REVOKED
ret false
end
ret true
end

fn test_inv5_no_policy_upgrade to bool
m = new ulong 4 0
d = new uchar 32 0
if ne ip_parse_envelope t_env_escal m d IP_OK
ret false
end
note Envelope claims policy=3 (POL_ELEVATED) over loopback, but runtime policy is POL_STANDARD (2)
if ne ip_eval_policy POL_STANDARD OP_ALL_MASK ORIG_SIG_VALID get m 1 OP_READ get m 2 POL_ERR_ESCALATION
ret false
end
note Requesting OP_POLICY_MUTATE under POL_STANDARD must be refused
if ne ip_eval_policy POL_STANDARD OP_ALL_MASK ORIG_SIG_VALID TRANS_LOOPBACK OP_POLICY_MUTATE POL_STANDARD POL_ERR_POLICY_DENIED
ret false
end
note Requesting OP_POLICY_MUTATE under POL_ELEVATED succeeds only if OP_POLICY_MUTATE is in allowed_ops
if ne ip_eval_policy POL_ELEVATED OP_READ ORIG_SIG_VALID TRANS_LOOPBACK OP_POLICY_MUTATE POL_ELEVATED POL_ERR_OP_NOT_ALLOWED
ret false
end
if ne ip_eval_policy POL_ELEVATED OP_POLICY_MUTATE ORIG_SIG_VALID TRANS_MTLS OP_POLICY_MUTATE POL_ELEVATED POL_OK
ret false
end
ret true
end

fn test_ledger_chain to bool
gen = new uchar 32 0
e1 = new uchar 32 0
e2 = new uchar 32 0
l1 = new uchar 32 0
l2 = new uchar 32 0
m = new ulong 4 0
if ne ip_parse_envelope t_env_ok m e1 IP_OK
ret false
end
if ne ip_parse_envelope t_env_ok_alt m e2 IP_OK
ret false
end
ip_ledger_step gen ulong 1 e1 POL_OK l1
ip_ledger_step l1 ulong 2 e2 POL_ERR_ESCALATION l2
if ne ip_ledger_verify gen ulong 1 e1 POL_OK l1 POL_OK
ret false
end
if ne ip_ledger_verify l1 ulong 2 e2 POL_ERR_ESCALATION l2 POL_OK
ret false
end
note Negative controls: wrong verdict, wrong seq, or flipped digest byte detected as tamper
if ne ip_ledger_verify l1 ulong 2 e2 POL_OK l2 POL_ERR_LEDGER_TAMPER
ret false
end
if ne ip_ledger_verify l1 ulong 3 e2 POL_ERR_ESCALATION l2 POL_ERR_LEDGER_TAMPER
ret false
end
put l2 0 xor get l2 0 uchar 1
if ne ip_ledger_verify l1 ulong 2 e2 POL_ERR_ESCALATION l2 POL_ERR_LEDGER_TAMPER
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_c1 test_ver_ident
fail = add fail report_case t_c2 test_parse_valid
fail = add fail report_case t_c3 test_parse_negative
fail = add fail report_case t_c4 test_inv1_parse_never_exec
fail = add fail report_case t_c5 test_inv2_transport_never_grants
fail = add fail report_case t_c6 test_inv3_valid_env_not_auth
fail = add fail report_case t_c7 test_inv4_sig_not_authority
fail = add fail report_case t_c8 test_inv5_no_policy_upgrade
fail = add fail report_case t_c9 test_ledger_chain
if ne fail int 0
ret int 1
end
ok = ip_write_all int 1 t_done
if not ok
ret int 1
end
ret int 0
end

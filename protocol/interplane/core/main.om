note SPDX-License-Identifier: Apache-2.0
note protocol/interplane/core/main.om: CLI entrypoint for interplane core envelope & policy engine
note Compose with:
note   si/directives/om2.om om/tls/sha2.om protocol/interplane/core/envelope.om
note   protocol/interplane/core/policy.om protocol/interplane/core/main.om

text ip_cmd_ident "check-ident"
text ip_cmd_ver "check-version"
text ip_cmd_eval "eval-policy"
text ip_cmd_parse "parse-stdin"

text ip_msg_ok "OK\n"
text ip_msg_allow "ALLOW\n"
text ip_msg_deny "DENY\n"
text ip_msg_invalid "INVALID\n"
text ip_msg_parsed "PARSED "
text ip_msg_nl "\n"
text ip_msg_usage "Usage: interplane-core <check-ident <id>|check-version <v>|parse-stdin|eval-policy <rpol> <ops> <orig> <trans> <rop> <cpol>>\n"

fn ip_parse_dec s view uchar * to long
n = len s
if eq n ulong 0
ret long -1
end
if gt n ulong 12
ret long -1
end
acc = ulong 0
i = ulong 0
while lt i n bound 12
b = get s i
if or lt b uchar 48 gt b uchar 57
ret long -1
end
acc = add mul acc ulong 10 sub ulong b ulong 48
i = add i ulong 1
end
ret long acc
end

fn ip_read_arg_u64 idx ulong to long
buf = new uchar 32 0
k = argread idx buf ulong 0 ulong 32
if le k long 0
ret long -1
end
ret ip_parse_dec part buf 0 ulong k
end

fn ip_cli_ident to int
buf = new uchar 128 0
k = argread ulong 2 buf ulong 0 ulong 128
if le k long 0
w = ip_write_all int 1 ip_msg_invalid
if w
ret int 1
end
ret int 1
end
rc = ip_valid_ident part buf 0 ulong k
if ne rc IP_OK
w = ip_write_all int 1 ip_msg_invalid
if w
ret int 1
end
ret int 1
end
w = ip_write_all int 1 ip_msg_ok
if not w
ret int 1
end
ret int 0
end

fn ip_cli_version to int
buf = new uchar 64 0
k = argread ulong 2 buf ulong 0 ulong 64
if le k long 0
w = ip_write_all int 1 ip_msg_invalid
if w
ret int 1
end
ret int 1
end
rc = ip_validate_version part buf 0 ulong k
if ne rc IP_OK
w = ip_write_all int 1 ip_msg_invalid
if w
ret int 1
end
ret int 1
end
w = ip_write_all int 1 ip_msg_ok
if not w
ret int 1
end
ret int 0
end

fn ip_cli_parse_stdin to int
buf = new uchar 4096 0
tot = ulong 0
done = false
while not done bound 4096
if ge tot ulong 4096
break
end
remn = sub ulong 4096 tot
k = read int 0 buf tot remn
if lt k long 0
ret int 1
end
if eq k long 0
done = true
else
tot = add tot ulong k
end
end
meta = new ulong 4 0
dig = new uchar 32 0
rc = ip_parse_envelope part buf 0 tot meta dig
if ne rc IP_OK
w = ip_write_all int 1 ip_msg_invalid
if w
ret int 1
end
ret int 1
end
hx = new uchar 64 0
ip_digest_to_hex dig hx
w1 = ip_write_all int 1 ip_msg_parsed
w2 = ip_write_all int 1 hx
w3 = ip_write_all int 1 ip_msg_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end

fn ip_cli_eval to int
rpol = ip_read_arg_u64 ulong 2
aops = ip_read_arg_u64 ulong 3
orig = ip_read_arg_u64 ulong 4
tr = ip_read_arg_u64 ulong 5
rop = ip_read_arg_u64 ulong 6
cpol = ip_read_arg_u64 ulong 7
if lt rpol long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
if lt aops long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
if lt orig long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
if lt tr long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
if lt rop long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
if lt cpol long 0
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
rc = ip_eval_policy ulong rpol ulong aops ulong orig ulong tr ulong rop ulong cpol
if ne rc POL_OK
w = ip_write_all int 1 ip_msg_deny
if w
ret int 1
end
ret int 1
end
w = ip_write_all int 1 ip_msg_allow
if not w
ret int 1
end
ret int 0
end

fn main to int
argc = argcnt
if lt argc long 2
w = ip_write_all int 2 ip_msg_usage
if w
ret int 2
end
ret int 2
end
cmd = new uchar 64 0
kc = argread ulong 1 cmd ulong 0 ulong 64
if le kc long 0
ret int 2
end
if ip_slice_eq part cmd 0 ulong kc ip_cmd_parse
ret ip_cli_parse_stdin
end
if ip_slice_eq part cmd 0 ulong kc ip_cmd_ident
if lt argc long 3
ret int 2
end
ret ip_cli_ident
end
if ip_slice_eq part cmd 0 ulong kc ip_cmd_ver
if lt argc long 3
ret int 2
end
ret ip_cli_version
end
if ip_slice_eq part cmd 0 ulong kc ip_cmd_eval
if lt argc long 8
ret int 2
end
ret ip_cli_eval
end
w = ip_write_all int 2 ip_msg_usage
if w
ret int 2
end
ret int 2
end

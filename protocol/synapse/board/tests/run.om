note SPDX-License-Identifier: Apache-2.0
note tests/run.om: build synapse-board with tools/build.om, then run its positive and negative cases in a
note fresh directory (replaces tests/run.sh). Built with the pinned omc, from the repository root:
note   { printf 'om2\n'; cat tests/run.om; } | "$OMEGA_SRC/seed/out/omc" > build/run && chmod 755 build/run
note usage: run OMEGA_SRC TEST_ROOT [--update-golden]   (from the repository root, after build/build exists)
note   TEST_ROOT must not exist yet; its parent must. It is created and left for inspection.
note   --update-golden rewrites tests/golden from the fixture render (review the diff before committing).
note The live serve case runs only when this host has a local address inside 100.64.0.0/10 (read from
note /proc/net/fib_trie); otherwise it is NOT_RUN. It binds that address on port 18731 for one GET.
note Prints PASS, FAIL and NOT_RUN lines and a SUMMARY line. Exit 0 only if every case that ran passed;
note 1 when a case failed or the build failed; 64 usage or TEST_ROOT already exists.

text tuse "usage: run OMEGA_SRC TEST_ROOT [--update-golden] (from the synapse-board repository root)\n"
text texists "run: TEST_ROOT exists or cannot be created; give a new path\n"
text tupd "--update-golden"
text tbuildp "build/build"
text tbin "/bin"
text tbinb "/bin/synapse-board"
text tfx "tests/fixtures/"
text tgd "tests/golden/"
text tout "/out.txt"
text terr "/err.txt"
text tsout "/serve.out"
text tserr "/serve.err"
text tr1 "/r1"
text tr2 "/r2"
text tr3 "/r3"
text tn1 "/n1"
text tn2 "/n2"
text tnope "/nope.jsonl"
text tbmd "/BOARD.md"
text tidx "/index.html"
text tfbmd "BOARD.md"
text tfidx "index.html"
text fcl "claims.jsonl"
text fmap "map.jsonl"
text ffind "findings.jsonl"
text fbcl "bad-claims.jsonl"
text fbmap "bad-map.jsonl"
text arender "render"
text aserve "serve"
text adelete "delete"
text aclaims "--claims"
text amap "--map"
text afind "--findings"
text aout "--out"
text anow "--now"
text ahead "--head"
text adir "--dir"
text abind "--bind"
text amax "--max"
text abogus "--bogus"
text a1 "1"
text vnow "2026-10-27T02:00:00Z"
text vhead "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
text vbadnow "2026<x>"
text vbadhead "XYZ"
text b0 "0.0.0.0:18731"
text b127 "127.0.0.1:18731"
text b128 "100.128.0.1:18731"
text b63 "100.63.255.255:18731"
text bnoport "100.64.0.1"
text bok "100.64.0.1:18731"
text wjson1 "{\"ok\":true,\"files\":2,\"active\":6,\"conflicts\":1,\"findings\":3,\"repos\":9,\"head\":\""
text wjson2 "\"}"
text tpass "PASS "
text tfail "FAIL "
text tnotrun "NOT_RUN live serve (no 100.64.0.0/10 address on this host)\n"
text trc " (rc="
text twant ", want "
text tclose ")"
text tnl "\n"
text tstderr "  stderr: "
text tsum "SUMMARY pass="
text tsumf " fail="
text tsumn " not_run="
text tnote "NOTE golden rewritten\n"
text tnot " not in "
text tdots ".."
text ton " on "
text tcolon ":"
text tsp " ("
text tplus " (+"
text tgot " got "
note case names
text nbuild "build"
text nrender "render-fixture"
text nrjson "render stdout json"
text ngold "golden "
text ntmp "no leftover .tmp"
text nhs "html has no <script"
text nms "md has no <script"
text nhe "html escapes script"
text nme "md escapes script"
text njs "javascript: never linked"
text nsafe "safe evidence linked"
text nquo "quoted URL not linked"
text nact "no active/external elements"
text npipe "md pipe escaped"
text nlap "lapsed marked"
text ninf "inferred parent marked"
text ncyc "cycle reported"
text nagain "render-again"
text nover "render-overwrite"
text ndet "deterministic"
text nclock "render-clock"
text nciso "clock iso"
text nhu "head unknown"
text nnone "no findings file = empty"
text nmc "missing-claims"
text nmm "missing-map"
text nmf "missing-findings-ok"
text nbc "bad-claims"
text nbc2 "bad-claims names line 2"
text nbm "bad-map"
text nnw "nothing written on refusal"
text nno "no-out"
text nbn "bad-now"
text nbh "bad-head"
text nuf "unknown-flag"
text ndf "dup-flag"
text nnc "no-command"
text nbcmd "bad-command"
text ns0 "serve-0.0.0.0"
text ns127 "serve-127.0.0.1"
text ns128 "serve-100.128.0.1"
text ns63 "serve-100.63.255.255"
text nsnp "serve-no-port"
text nsnd "serve-no-dir"
text nsrf "serve-render-flag"
text nsexit "serve exits after --max 1"
text nlive "live serve GET /"
note needles
text kscript "<script"
text kesc "&lt;script&gt;alert(1)&lt;/script&gt;"
text kjs "href=\"javascript"
text ksafe "href=\"https://github.com/aien-dev/omega-mv/pull/880\""
text kquo "href=\"https://aienos.com/community"
text kiframe "<iframe"
text kobject "<object"
text kembed "<embed"
text klink "<link"
text kimg "<img"
text ksrc "src="
text krefresh "http-equiv=\"refresh\""
text kpipe "Vulkan GLCompute \\| SPIR-V"
text klapsed "LAPSED"
text kinf "INFERRED: name-prefix synapse-"
text kcycle "[cycle]"
text khu "ledger head unknown"
text knone "none"
text kc2 "claims:2:"
text kserving "serving"
text ktmp ".tmp"
text kat " at "
text kdash "|-- "
text kloc "/32 host LOCAL"
text kfib "/proc/net/fib_trie"
text kget1 "GET / HTTP/1.0"
text khost "Host: "
text kget2 "Connection: close"

global groot uchar 4096
global gosrc uchar 4096
global gn ulong 16
note gn: 0 TEST_ROOT length, 1 OMEGA_SRC length, 2 gp length, 3 gpk length, 4 pass, 5 fail, 6 not_run,
note 7 redirect (0 none, 1 out.txt/err.txt, 2 serve.out/serve.err), 8 ga length, 9 gb length, 10 last rc,
note 11 tailnet address (host order), 12 time before, 13 time after, 14 parsed time, 15 HTTP status
global gp uchar 8192
global gpk uchar 65536
global gst uchar 4
global gob uchar 64
global gts uchar 64
global gtl ulong 1
global ga uchar *
global gb uchar *
global gde uchar 65536

note ======== output
fn o t view uchar * to void
r = write 1 t 0 len t
end
fn onum v ulong to void
n = ulong 0
x = v
if eq x 0
put gob 63 48
n = 1
end
while gt x 0 bound 21
put gob sub 63 n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
r = write 1 gob sub 64 n n
end
fn onl to void
o tnl
end
fn ok t view uchar * to void
put gn 4 add get gn 4 1
o tpass
o t
end
fn bad t view uchar * to void
put gn 5 add get gn 5 1
o tfail
o t
end
note judge: PASS name or FAIL name on a line
fn judge c bool t view uchar * to void
if c
ok t
else
bad t
end
onl
end

note ======== path scratch gp
fn pclr to void
put gn 2 0
end
fn pc c uchar to void
n = get gn 2
if lt n 8191
put gp n c
put gn 2 add n 1
end
end
fn pt t view uchar * to void
for i ulong len t
pc get t i
end
end
fn proot to void
for i ulong get gn 0
pc get groot i
end
end
fn pr t view uchar * to void
pclr
proot
pt t
end
fn pf t view uchar * to void
pclr
pt tfx
pt t
end
fn pr2 d view uchar * t view uchar * to void
pclr
proot
pt d
pt t
end
fn openp flags ulong mode ulong to long
ret fopen gp 0 get gn 2 int flags int mode
end

note ======== packed argument list gpk (u16 count, then u16 length and bytes per item)
fn k0 to void
put gpk 0 0
put gpk 1 0
put gn 3 2
end
note kp: append gp as one item
fn kp to void
q = get gn 3
n = get gn 2
put gpk q uchar and n 255
put gpk add q 1 uchar shr n 8
for i ulong n
put gpk add add q 2 i get gp i
end
put gn 3 add add q 2 n
c = add add ulong get gpk 0 shl ulong get gpk 1 8 1
put gpk 0 uchar and c 255
put gpk 1 uchar shr c 8
end
fn ka t view uchar * to void
pclr
pt t
kp
end
fn af t view uchar * to void
pf t
kp
end
fn ar t view uchar * to void
pr t
kp
end
fn ar2 d view uchar * t view uchar * to void
pr2 d t
kp
end
fn cmd to void
k0
pr tbinb
kp
end
note rargs: render --claims F(claims) --map F(map)
fn rbase to void
cmd
ka arender
ka aclaims
af fcl
ka amap
af fmap
end
fn rfull d view uchar * to void
rbase
ka afind
af ffind
ka aout
ar d
ka anow
ka vnow
ka ahead
ka vhead
end

note ======== running a child
fn redir t view uchar * fd int to void
pr t
f = openp 524865 420
if lt f 0
exit 126
end
r = dupfd int f fd 0
end
fn child to void
m = get gn 7
if eq m 1
redir tout 1
redir terr 2
end
if eq m 2
redir tsout 1
redir tserr 2
end
r = execprog gpk 0 get gn 3
exit 127
end
note spawn: the child's pid, or negative
fn spawn to long
pid = fork
if eq pid 0
child
end
ret pid
end
note reap: exit status of pid (128+signal when killed), or -1
fn reap pid long options int to long
r = waitpid int pid gst 0 4 options
if ne r pid
ret -1
end
if ne get gst 0 0
ret add 128 long get gst 0
end
ret long get gst 1
end
fn runk to long
pid = spawn
if lt pid 0
ret -1
end
ret reap pid 0
end

note ======== whole files into the run-time pools ga (w 0) and gb (w 1)
fn growp w ulong n ulong to bool
if eq w 0
if lt len ga n
r = enlarge ga n
ret eq r 0
end
ret true
end
if lt len gb n
r = enlarge gb n
ret eq r 0
end
ret true
end
fn rdp w ulong fd int p ulong to long
if eq w 0
ret read fd ga p 65536
end
ret read fd gb p 65536
end
note load: the file named by gp into pool w; its length, or negative
fn load w ulong to long
put gn add 8 w 0
fd = openp 524288 0
if lt fd 0
ret fd
end
p = ulong 0
for it ulong 999999
if not growp w add p 65536
c = fclose int fd
ret -12
end
r = rdp w int fd p
if lt r 0
if ne r -4
c = fclose int fd
ret r
end
else
if eq r 0
c = fclose int fd
put gn add 8 w p
ret long p
end
p = add p ulong r
end
end
c = fclose int fd
ret -27
end
fn lower c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end
note has: does ga[0..gn 8) contain t (ASCII case-insensitive when ci)
fn has t view uchar * ci bool to bool
n = get gn 8
m = len t
if lt n m
ret false
end
for i ulong add sub n m 1
j = ulong 0
while lt j m bound 65536
x = get ga add i j
y = get t j
if ci
x = lower x
y = lower y
end
if ne x y
break
end
j = add j 1
end
if eq j m
ret true
end
end
ret false
end
note sameab: ga and gb hold the same bytes
fn sameab to bool
n = get gn 8
if ne n get gn 9
ret false
end
for i ulong n
if ne get ga i get gb i
ret false
end
end
ret true
end
note pr3: gp = TEST_ROOT d / f
fn pr3 d view uchar * f view uchar * to void
pr d
pc 47
pt f
end
note cmp2: TEST_ROOT/r1/f equals tests/golden/f (gold) or TEST_ROOT/r2/f
fn cmp2 f view uchar * gold bool to bool
pr3 tr1 f
r = load 0
if lt r 0
ret false
end
if gold
pclr
pt tgd
pt f
else
pr3 tr2 f
end
r = load 1
if lt r 0
ret false
end
ret sameab
end

note ======== cases
note expect: run gpk with stdout and stderr in TEST_ROOT/out.txt and err.txt and compare the exit status
fn expect t view uchar * want long to void
put gn 7 1
rc = runk
put gn 10 ulong rc
if eq rc want
ok t
o trc
onum ulong rc
o tclose
onl
ret
end
bad t
o trc
if lt rc 0
o tfail
else
onum ulong rc
end
o twant
onum ulong want
o tclose
onl
pr terr
r = load 1
if le r 0
ret
end
showerr
end
fn showerr to void
s = ulong 0
n = get gn 9
for i ulong n
if or eq get gb i 10 eq add i 1 n
o tstderr
e = add i 1
w = write 1 gb s sub e s
if ne get gb i 10
onl
end
s = e
end
end
end
note gp names a file holding exactly the bytes of the render summary (trailing newlines ignored)
fn jsonok to bool
r = load 0
if lt r 0
ret false
end
n = get gn 8
while and gt n 0 eq get ga sub n 1 10 bound 65536
n = sub n 1
end
a = len wjson1
b = len vhead
if ne n add add a b len wjson2
ret false
end
for i ulong a
if ne get ga i get wjson1 i
ret false
end
end
for i ulong b
if ne get ga add a i get vhead i
ret false
end
end
for i ulong len wjson2
if ne get ga add add a b i get wjson2 i
ret false
end
end
ret true
end
note tmpleft: a directory entry of TEST_ROOT/r1 ends in .tmp (or the directory cannot be listed)
fn tmpleft to bool
pr tr1
note getdents64 records land in gde (host directory words take a sized array, not a run-time pool)
fd = openp 540672 0
if lt fd 0
ret true
end
for it ulong 999999
r = getdnts int fd gde 0 65536
if le r 0
c = fclose int fd
ret lt r 0
end
p = ulong 0
while lt p ulong r bound 65536
if tmpent p
c = fclose int fd
ret true
end
p = add p add ulong get gde add p 16 shl ulong get gde add p 17 8
end
end
c = fclose int fd
ret true
end
fn tmpent p ulong to bool
q = add p 19
n = ulong 0
while ne get gde add q n 0 bound 256
n = add n 1
end
k = len ktmp
if lt n k
ret false
end
for i ulong k
if ne get gde add q add sub n k i get ktmp i
ret false
end
end
ret true
end
fn updgold to void
for w ulong 2
pr tr1
if eq w 0
pt tbmd
else
pt tidx
end
r = load 0
pclr
pt tgd
if eq w 0
pt tfbmd
else
pt tfidx
end
fd = openp 524865 420
if ge fd 0
x = write int fd ga 0 get gn 8
c = fclose int fd
end
end
o tnote
end

fn render1 to void
rfull tr1
expect nrender 0
pr tout
judge jsonok nrjson
end
fn golden to void
c = cmp2 tfbmd true
if c
ok ngold
else
bad ngold
end
o tfbmd
onl
c = cmp2 tfidx true
if c
ok ngold
else
bad ngold
end
o tfidx
onl
judge not tmpleft ntmp
end
note escaping: the fixture intent carries <script>alert(1)</script>
fn escapes to void
pr3 tr1 tfidx
r = load 0
judge not has kscript true nhs
judge has kesc false nhe
judge not has kjs false njs
judge has ksafe false nsafe
judge not has kquo false nquo
judge not active nact
pr3 tr1 tfbmd
r = load 0
judge not has kscript true nms
judge has kesc false nme
judge has kpipe false npipe
judge has klapsed false nlap
judge has kinf false ninf
judge has kcycle false ncyc
end
fn active to bool
if or has kscript true has kiframe true
ret true
end
if or has kobject true has kembed true
ret true
end
if or has klink true has kimg true
ret true
end
ret or has ksrc true has krefresh true
end
fn again to void
rfull tr2
expect nagain 0
rfull tr2
expect nover 0
c = and cmp2 tfbmd false cmp2 tfidx false
judge c ndet
end

note ======== clock: without --now the generated-by time is the current UTC second
note days: days since 1970-01-01 of a proleptic Gregorian date (days-from-civil)
fn days y ulong m ulong d ulong to ulong
yy = y
if le m 2
yy = sub yy 1
end
era = div yy 400
yoe = sub yy mul era 400
mm = add m 9
if gt m 2
mm = sub m 3
end
doy = add div add mul 153 mm 2 5 sub d 1
doe = add mul yoe 365 div yoe 4
doe = add sub doe div yoe 100 doy
era = mul era 146097
ret sub add era doe 719468
end
fn tsc c uchar to bool
ret or or and ge c 48 le c 57 or eq c 84 eq c 90 or eq c 58 eq c 45
end
note tsfind: copy into gts the [0-9TZ:-]* run between " at " and a "_" that ends a line of ga
fn tsfind to bool
n = get gn 8
for e ulong n
if and eq get ga e 95 or eq add e 1 n eq get ga add e 1 10
s = e
while and gt s 0 tsc get ga sub s 1 bound 65536
s = sub s 1
end
if and ge s 4 lt sub e s 64
if attxt sub s 4
put gtl 0 sub e s
for i ulong sub e s
put gts i get ga add s i
end
ret true
end
end
end
end
ret false
end
fn attxt p ulong to bool
for i ulong 4
if ne get ga add p i get kat i
ret false
end
end
ret true
end
fn dig p ulong k ulong to ulong
v = ulong 0
for i ulong k
c = get gts add p i
if or lt c 48 gt c 57
ret 4294967296
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note tsval: gts as Unix seconds when it is YYYY-MM-DDTHH:MM:SSZ, else 0
fn tsval to ulong
if ne get gtl 0 20
ret 0
end
if or ne get gts 10 84 ne get gts 19 90
ret 0
end
y = dig 0 4
mo = dig 5 2
d = dig 8 2
h = dig 11 2
mi = dig 14 2
se = dig 17 2
if or gt y 9999 or gt mo 12 lt mo 1
ret 0
end
if or gt d 31 lt d 1
ret 0
end
if or gt h 23 or gt mi 59 gt se 60
ret 0
end
t = days y mo d
t = add mul t 24 h
t = add mul t 60 mi
ret add mul t 60 se
end
fn clock to void
put gn 12 div ulong realns 1000000000
rbase
ka aout
ar tr3
expect nclock 0
put gn 13 div ulong realns 1000000000
pr3 tr3 tfbmd
r = load 0
put gtl 0 0
f = tsfind
tv = tsval
c = and ge tv get gn 12 le tv get gn 13
if c
ok nciso
o tsp
else
bad nciso
o tsp
end
r = write 1 gts 0 get gtl 0
if not c
o tnot
onum get gn 12
o tdots
onum get gn 13
end
o tclose
onl
judge has khu false nhu
judge has knone false nnone
end

note ======== negative cases
fn neg1 to void
cmdmiss 0
expect nmc 4
cmdmiss 1
expect nmm 4
rbase
ka afind
ar tnope
ka aout
ar tn2
expect nmf 0
cmd
ka arender
ka aclaims
af fbcl
ka amap
af fmap
ka aout
ar tn1
expect nbc 65
pr terr
r = load 0
judge has kc2 false nbc2
cmd
ka arender
ka aclaims
af fcl
ka amap
af fbmap
ka aout
ar tn1
expect nbm 65
pr3 tn1 tfbmd
fd = openp 524288 0
if ge fd 0
c = fclose int fd
end
judge lt fd 0 nnw
end
note cmdmiss: render with a missing claims file (w 0) or map file (w 1), out TEST_ROOT/n1
fn cmdmiss w ulong to void
cmd
ka arender
ka aclaims
if eq w 0
ar tnope
else
af fcl
end
ka amap
if eq w 1
ar tnope
else
af fmap
end
ka aout
ar tn1

note ======== live serve on this host's tailnet address (GET only, read-only, one connection)
note octet: the decimal at ga[p..), with its end in gn 14; 256 when absent or out of range
fn octet p ulong to ulong
v = ulong 0
n = ulong 0
while lt add p n get gn 8 bound 4
c = get ga add p n
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
n = add n 1
end
put gn 14 add p n
if or eq n 0 gt v 255
ret 256
end
ret v
end
note addrat: the dotted address at ga[p..) in host order, or 0 when it is not one
fn addrat p ulong to ulong
a = ulong 0
q = p
for i ulong 4
v = octet q
if eq v 256
ret 0
end
a = add shl a 8 v
q = get gn 14
if lt i 3
if or ge q get gn 8 ne get ga q 46
ret 0
end
q = add q 1
end
end
ret a
end
fn at2 p ulong t view uchar * to bool
if gt add p len t get gn 8
ret false
end
for i ulong len t
if ne get ga add p i get t i
ret false
end
end
ret true
end
note tailnet: the first local /32 inside 100.64.0.0/10 in /proc/net/fib_trie, or 0
fn tailnet to ulong
pclr
pt kfib
r = load 0
if lt r 0
ret 0
end
last = ulong 0
for p ulong get gn 8
if at2 p kdash
last = addrat add p len kdash
end
if at2 p kloc
if eq and last 4290772992 1681915904
ret last
end
end
end
ret 0
end
note paddr: append the dotted form of gn 11 and ":18731" to gp
fn pnum v ulong to void
if ge v 100
pc uchar add div v 100 48
end
if ge v 10
pc uchar add rem div v 10 10 48
end
pc uchar add rem v 10 48
end
fn paddr to void
a = get gn 11
pnum shr a 24
pc 46
pnum and shr a 16 255
pc 46
pnum and shr a 8 255
pc 46
pnum and a 255
end
fn pport to void
pc 58
pnum 187
pnum 31
end
note serving: TEST_ROOT/serve.out shows the server is up
fn serving to bool
pr tsout
r = load 0
if lt r 0
ret false
end
ret has kserving false
end
note get: one GET / to the tailnet address; status into gn 15 and the body into gb from offset 0
fn sendreq fd int to bool
pclr
pt kget1
crlf
pt khost
paddr
pport
crlf
pt kget2
crlf
crlf
w = send fd gp 0 get gn 2 0
ret eq w long get gn 2
end
fn crlf to void
pc 13
pc 10
end
fn httpget to void
put gn 15 0
put gn 9 0
fd = socknew 2 1 0
if lt fd 0
ret
end
sa = new uchar 16 0
put sa 0 2
put sa 2 uchar 73
put sa 3 uchar 43
a = get gn 11
put sa 4 uchar shr a 24
put sa 5 uchar and shr a 16 255
put sa 6 uchar and shr a 8 255
put sa 7 uchar and a 255
r = connect int fd sa 0 16
if or lt r 0 not sendreq int fd
c = fclose int fd
ret
end
recvall int fd
c = fclose int fd
parse
end
fn recvall fd int to void
p = ulong 0
for it ulong 999999
if not growp 1 add p 65536
ret
end
w = waitio fd 1 5000000000
if le w 0
ret
end
r = recv fd gde 0 65536 0
if le r 0
put gn 9 p
ret
end
for i ulong ulong r
put gb add p i get gde i
end
p = add p ulong r
put gn 9 p
end
end
note parse: status code of gb's response into gn 15; the body moved to the front of gb, its length gn 9
fn parse to void
n = get gn 9
if lt n 12
ret
end
s = ulong 0
for i ulong 3
c = get gb add 9 i
if or lt c 48 gt c 57
ret
end
s = add mul s 10 ulong sub c 48
end
put gn 15 s
for i ulong sub n 3
if hdrend i
b = add i 4
for j ulong sub n b
put gb j get gb add b j
end
put gn 9 sub n b
ret
end
end
put gn 15 0
end
fn hdrend i ulong to bool
if or ne get gb i 13 ne get gb add i 1 10
ret false
end
ret and eq get gb add i 2 13 eq get gb add i 3 10
end
fn live to void
a = tailnet
if eq a 0
put gn 6 add get gn 6 1
o tnotrun
ret
end
put gn 11 a
k0
pr tbinb
kp
ka aserve
ka adir
ar tr1
ka abind
pclr
paddr
pport
kp
ka amax
ka a1
put gn 7 2
pid = spawn
if lt pid 0
bad nsexit
onl
ret
end
for i ulong 50
if serving
break
end
s = sleepns 100000000
end
httpget
livewait pid
liveres
end
fn livewait pid long to void
e = long -1
for i ulong 50
e = reap pid 1
if ge e 0
break
end
s = sleepns 100000000
end
if ge e 0
ok nsexit
onl
ret
end
k = killpid int pid 9
e = reap pid 0
bad nsexit
onl
end
fn liveres to void
pr3 tr1 tfidx
r = load 0
c = and eq get gn 15 200 sameab
if c
ok nlive
o ton
pclr
paddr
pport
w = write 1 gp 0 get gn 2
else
bad nlive
o tsp
onum get gn 15
o tclose
end
onl
end

note ======== main
fn build to bool
k0
pclr
pt tbuildp
kp
pclr
for i ulong get gn 1
pc get gosrc i
end
kp
pr tbinb
kp
put gn 7 0
rc = runk
ret eq rc 0
end
fn summary to int
o tsum
onum get gn 4
o tsumf
onum get gn 5
o tsumn
onum get gn 6
onl
if eq get gn 5 0
ret 0
end
ret 1
end
fn setup to bool
pr tbin
n = get gn 0
r = makedir groot 0 n 493
if lt r 0
ret false
end
r = makedir gp 0 get gn 2 493
ret ge r 0
end
fn main to int
na = argcnt
if or lt na 3 gt na 4
r = write 2 tuse 0 len tuse
ret 64
end
n = argread 1 gosrc 0 4096
m = argread 2 groot 0 4096
if or lt n 1 lt m 1
r = write 2 tuse 0 len tuse
ret 64
end
put gn 1 ulong n
put gn 0 ulong m
upd = false
if eq na 4
k = argread 3 gp 0 64
upd = and eq k long len tupd at2gp
if not upd
r = write 2 tuse 0 len tuse
ret 64
end
end
if not setup
r = write 2 texists 0 len texists
ret 64
end
if not build
bad nbuild
onl
ret 1
end
ok nbuild
onl
render1
if upd
updgold
end
golden
escapes
again
clock
neg1
neg2
neg3
live
ret summary
end
fn at2gp to bool
for i ulong len tupd
if ne get gp i get tupd i
ret false
end
end
ret true
end

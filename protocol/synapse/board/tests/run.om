fn neg2 to void
rbase
expect nno 64
rn1
ka anow
ka vbadnow
expect nbn 64
rn1
ka ahead
ka vbadhead
expect nbh 64
rn1
ka abogus
ka a1
expect nuf 64
cmd
ka arender
ka aclaims
af fcl
ka aclaims
af fcl
ka amap
af fmap
ka aout
ar tn1
expect ndf 64
cmd
expect nnc 64
cmd
ka adelete
ka aout
ar tn1
expect nbcmd 64
end
fn rn1 to void
rbase
ka aout
ar tn1
end
note sv: serve --dir TEST_ROOT/r1 --bind b --max 1
fn sv b view uchar * to void
cmd
ka aserve
ka adir
ar tr1
ka abind
ka b
ka amax
ka a1
end
fn neg3 to void
sv b0
expect ns0 64
sv b127
expect ns127 64
sv b128
expect ns128 64
sv b63
expect ns63 64
sv bnoport
expect nsnp 64
cmd
ka aserve
ka abind
ka bok

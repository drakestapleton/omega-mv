note synapse-mcp 10mcp.om: MCP stdio server (JSON-RPC 2.0, one message per line) over the coordination CLIs.
note Every tool is one fixed argv executed without a shell; argument values are separate argv records.
global gop ulong 4
global gopl ulong 4
global gid ulong 2
global gbad ulong 2
global gq ulong 4
note gobj 0: JSON object token searched by mc_get and pu_memb2; gv 0: value token found by mc_get
note gnm 0: offset of the tool name for mc_build (omc allows six parameter slots; a sized-* view takes two)
global gobj ulong 1
global gv ulong 1
global gnm ulong 1
global gln ulong 2

text musage "usage: synapse-mcp --bin-dir DIR [--home DIR]"
text mbindir "--bin-dir"
text mhome "--home"
text menvh "AIEN_COORD_HOME="
text menvhm "HOME="
text mdhome "/.local/state/aien-coord"
text mnohome "synapse-mcp: no --home, AIEN_COORD_HOME or HOME"
text mnobin "synapse-mcp: --bin-dir must be an absolute directory"
text mtrunc "[stdout truncated at 1048576 bytes]\n"
text mkjrpc "jsonrpc"
text mk20 "2.0"
text mkid "id"
text mkmeth "method"
text mkpar "params"
text mkname "name"
text mkargs "arguments"
text mminit "initialize"
text mmping "ping"
text mmlist "tools/list"
text mmcall "tools/call"
text mrpre "{\"jsonrpc\":\"2.0\",\"id\":"
text mridnul "null"
text mrres ",\"result\":"
text mrerr ",\"error\":{\"code\":"
text mrmsg ",\"message\":\""
text mrend "\"}}\n"
text mrclose "}\n"
text mrinit "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"synapse-mcp\",\"version\":\"0.1.0\"},\"instructions\":\"AIEN coordination tools: claim before you work, check who holds a target, read drift findings.\"}"
text mrempty "{}"
text mrtext "{\"content\":[{\"type\":\"text\",\"text\":\""
text mriserr "\"}],\"isError\":"
text mtrue "true"
text mfalse "false"
text mexitc "{\"exit_code\":"
text mwhoc "{\"who\":\""
text mwhoe "\",\"exit_code\":"
text mcl "}"
text mmeparse "Parse error"
text mmeinv "Invalid Request"
text mmenome "Method not found"
text mmeparm "Invalid params"
text mmetool "Unknown tool"
text mbadarg "Invalid params: bad or missing argument"
text mbadunk "Invalid params: unknown argument"
text mbadlong "Invalid params: arguments too long"
text mbadobj "Invalid params: arguments must be an object"
text mtoolong "synapse-mcp: request line over 1048576 bytes"

text mbclaims "/synapse-claims"
text mbmap "/synapse-map"
text mbpulse "/synapse-pulse"
text mbboard "/synapse-board"
text mcclaim "claim"
text mcrenew "renew"
text mcrel "release"
text mcstate "state"
text mcwho "who"
text mclist "list"
text mcconf "conflicts"
text mcver "verify"
text mcwhere "where"
text mctree "tree"
text mccheck "check"
text mcrun "run"
text mcrender "render"
text mfagent "--agent"
text mfsess "--session"
text mftarg "--target"
text mfttl "--ttl"
text mfmode "--mode"
text mfstate "--state"
text mfint "--intent"
text mfevid "--evidence"
text mfid "--id"
text mfall "--all"
text mfprefix "--agent-prefix"
text mflimit "--limit"
text mftext "--text"
text mfalert "--alert"
text mfcbin "--claims-bin"
text mfclaims "--claims"
text mfmap "--map"
text mffind "--findings"
text mfout "--out"
text makagent "agent"
text maksess "session"
text maktarg "target"
text makttl "ttl"
text makmode "mode"
text makstate "state"
text makint "intent"
text makevid "evidence"
text makid "id"
text makall "all"
text maklane "lane"
text maktask "task"
text maklimit "limit"
text maktext "text"
text makalert "alert"
text mkrepo "repo"
text mrepoc "repo:"
text mslboard "/board"
text mslbcl "/board/claims.jsonl"
text mslmap "/map.jsonl"
text mslfind "/pulse/findings.jsonl"
text mlisterr "synapse-mcp: synapse-claims list --all failed; board not rendered"
text mwrerr "synapse-mcp: could not write HOME/board/claims.jsonl; board not rendered"

text mtn01 "coord_where"
text mtn02 "coord_tree"
text mtn03 "coord_check"
text mtn04 "coord_claim"
text mtn05 "coord_renew"
text mtn06 "coord_release"
text mtn07 "coord_state"
text mtn08 "coord_who"
text mtn09 "coord_list"
text mtn10 "coord_conflicts"
text mtn11 "coord_verify"
text mtn12 "coord_pulse"
text mtn13 "coord_board"
text mtn14 "coord_lane"

text ml00 "{\"tools\":["
text ml01 "{\"name\":\"coord_where\",\"description\":\"Rank aien-dev repositories for a task (synapse-map where) and show who holds claims on the top 3 (synapse-claims who repo:R).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\",\"description\":\"plain-words task\"},\"limit\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"task\"],\"additionalProperties\":false}},"
text ml02 "{\"name\":\"coord_tree\",\"description\":\"Repository parent tree (synapse-map tree).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"boolean\"}},\"additionalProperties\":false}},"
text ml03 "{\"name\":\"coord_check\",\"description\":\"Repository map findings: orphans, missing or archived parents, duplicate purposes (synapse-map check).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}},"
text ml04 "{\"name\":\"coord_claim\",\"description\":\"Claim a target before working on it. Exit 2 means another agent holds it; the holder is returned.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"session\":{\"type\":\"string\"},\"target\":{\"type\":\"string\",\"description\":\"repo:O/R | branch:O/R#ref | path:O/R:glob | pr:O/R#N | ext:...\"},\"ttl\":{\"type\":\"integer\",\"minimum\":1},\"mode\":{\"type\":\"string\",\"enum\":[\"excl\",\"shared\"]},\"state\":{\"type\":\"string\"},\"intent\":{\"type\":\"string\"},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"agent\",\"session\",\"target\"],\"additionalProperties\":false}},"
text ml05 "{\"name\":\"coord_renew\",\"description\":\"Extend a claim lease you hold.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"ttl\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"agent\",\"id\"],\"additionalProperties\":false}},"
text ml06 "{\"name\":\"coord_release\",\"description\":\"Release a claim you hold, optionally with a final state and evidence.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"agent\",\"id\"],\"additionalProperties\":false}},"
text ml07 "{\"name\":\"coord_state\",\"description\":\"Record a state change (e.g. PR_OPEN, MERGED) on a claim you hold.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"agent\",\"id\",\"state\"],\"additionalProperties\":false}},"
text ml08 "{\"name\":\"coord_who\",\"description\":\"Active claims overlapping a target.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},"
text ml09 "{\"name\":\"coord_list\",\"description\":\"Active claims (all claims with all=true).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"all\":{\"type\":\"boolean\"}},\"additionalProperties\":false}},"
text ml10 "{\"name\":\"coord_conflicts\",\"description\":\"Conflicting active claim pairs.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}},"
text ml11 "{\"name\":\"coord_verify\",\"description\":\"Verify the claims ledger hash chain and signatures.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}},"
text ml12 "{\"name\":\"coord_pulse\",\"description\":\"Reconcile claims with GitHub and live sessions; returns drift findings (synapse-pulse run).\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"alert\":{\"type\":\"boolean\"}},\"additionalProperties\":false}},"
text ml13 "{\"name\":\"coord_board\",\"description\":\"Render the generated board (BOARD.md, index.html) from claims, map and findings.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}},"
text ml14 "{\"name\":\"coord_lane\",\"description\":\"Agents in a lane: active claims whose agent id starts with the lane prefix. Message these agents (parent and children) instead of agent://all.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"lane\":{\"type\":\"string\",\"description\":\"agent id prefix, e.g. Coordination\"}},\"required\":[\"lane\"],\"additionalProperties\":false}}"
text ml99 "]}"

note ======== output ========
fn mc_flush m ulong to void
n = syn_len m
k = ulong 0
while lt k n bound 999999
w = write 1 gsp add m k sub n k
if le w 0
exit 70
end
k = add k ulong w
end
syn_rew m
end

fn mc_hex v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

note mc_qb: append byte c JSON-escaped (no quotes)
fn mc_qb c uchar to void
if or eq c 34 eq c 92
syn_pb 92
syn_pb c
ret
end
if eq c 10
syn_pb 92
syn_pb 110
ret
end
if eq c 9
syn_pb 92
syn_pb 116
ret
end
if eq c 13
syn_pb 92
syn_pb 114
ret
end
if lt c 32
syn_pb 92
syn_pb 117
syn_pb 48
syn_pb 48
syn_pb mc_hex shr ulong c 4
syn_pb mc_hex and ulong c 15
ret
end
syn_pb c
end

fn mc_qa a view uchar * o ulong n ulong to void
for i ulong n
mc_qb get a add o i
end
end

note mc_qerr: JSON-escape the captured stderr (gerrb, gerrn 0 bytes); a global cannot be an argument
fn mc_qerr to void
for i ulong get gerrn 0
mc_qb get gerrb i
end
end

fn mc_qt t view uchar * to void
for i ulong len t
mc_qb get t i
end
end

fn mc_qp o ulong n ulong to void
for i ulong n
mc_qb get gsp add o i
end
end

note mc_head: response prefix with the request id (or null)
fn mc_head to ulong
m = syn_mark
syn_pt mrpre
if eq get gid 1 0
syn_pt mridnul
else
syn_ps get gid 0 get gid 1
end
ret m
end

fn mc_err code ulong msg view uchar * to void
m = mc_head
syn_pt mrerr
syn_pb 45
syn_pd code
syn_pt mrmsg
mc_qt msg
syn_pt mrend
mc_flush m
end

note mc_errp: error with a message held in the pool at (o,n)
fn mc_errp code ulong o ulong n ulong to void
m = mc_head
syn_pt mrerr
syn_pb 45
syn_pd code
syn_pt mrmsg
mc_qp o n
syn_pt mrend
mc_flush m
end

fn mc_okt t view uchar * to void
m = mc_head
syn_pt mrres
syn_pt t
syn_pt mrclose
mc_flush m
end

fn mc_list to void
m = mc_head
syn_pt mrres
syn_pt ml00
syn_pt ml01
syn_pt ml02
syn_pt ml03
syn_pt ml04
syn_pt ml05
syn_pt ml06
syn_pt ml07
syn_pt ml08
syn_pt ml09
syn_pt ml10
syn_pt ml11
syn_pt ml12
syn_pt ml13
syn_pt ml14
syn_pt ml99
syn_pt mrclose
mc_flush m
end

note ======== argument records ========
note gbad 0: 0 ok, 1 bad value (gbad 1 = key text index), 2 unknown key, 3 too long, 4 not an object
note gq 0: arguments consumed so far
fn mc_bad k ulong why ulong to void
if eq get gbad 0 0
put gbad 0 why
put gbad 1 k
end
end

fn mc_room n ulong to bool
if gt add add get gavs 0 n 16 4000
ret false
end
if ge get gavs 1 60
ret false
end
ret true
end

note mc_val: check decoded string tmp[0..n) and add it as one record; false when refused
fn mc_val tmp view uchar * n ulong to bool
if or eq n 0 eq get tmp 0 45
ret false
end
for i ulong n
if eq get tmp i 0
ret false
end
end
if not mc_room n
put gbad 0 3
ret false
end
m = syn_mark
syn_pa tmp 0 n
syn_ap m n
syn_rew m
ret true
end

fn mc_flag f view uchar * to bool
if not mc_room len f
put gbad 0 3
ret false
end
syn_at f
ret true
end

note mc_get: gv 0 = value token for key in args object gobj 0, or jsnone; counts the key as consumed
fn mc_get src view uchar * tape view uint * key view uchar * to void
put gv 0 jsnone
a = get gobj 0
if eq a jsnone
ret
end
k = js_first tape a
while ne k jsnone bound 999999
if js_streq src js_off tape k key
put gq 0 add get gq 0 1
put gv 0 add k 1
ret
end
k = js_mnext tape k
end
end

note mc_sval: string value of gv 0 into tmp; its length, or -1 when absent or refused; req: must be present
fn mc_sval src view uchar * tape view uint * tmp edit uchar * to long
v = get gv 0
if eq v jsnone
if eq get gq 1 1
mc_bad 0 1
end
put gq 1 0
ret -1
end
put gq 1 0
if ne js_type tape v jsstr
mc_bad 0 1
ret -1
end
n = js_sget src js_off tape v tmp
if lt n 0
mc_bad 0 1
ret -1
end
ret n
end

note mc_semit: string argument from mc_sval (n bytes of tmp) as option flag + value
fn mc_semit tmp view uchar * n long flag view uchar * to void
if lt n 0
ret
end
if not mc_flag flag
ret
end
mc_spos tmp n
end

note mc_spos: string argument from mc_sval as one positional record (omc e5b32567 gives an empty text a
note wrong length, omega-mv #775, so positionals do not pass an empty flag text)
fn mc_spos tmp view uchar * n long to void
if lt n 0
ret
end
if not mc_val tmp ulong n
mc_bad 0 1
end
end

note mc_int: integer argument (JSON unsigned integer >= 1) as option flag
fn mc_int src view uchar * tape view uint * flag view uchar * to void
v = get gv 0
if eq v jsnone
ret
end
if ne js_type tape v jsnum
mc_bad 0 1
ret
end
if not js_isu src js_off tape v
mc_bad 0 1
ret
end
x = js_tou src js_off tape v
if or eq x 0 gt x 99999999
mc_bad 0 1
ret
end
if not mc_flag flag
ret
end
m = syn_mark
syn_pd x
syn_ap m syn_len m
syn_rew m
end

note mc_bool: boolean argument; true adds the flag
fn mc_bool tape view uint * flag view uchar * to void
v = get gv 0
if eq v jsnone
ret
end
t = js_type tape v
if eq t jstrue
r = mc_flag flag
ret
end
if ne t jsfalse
mc_bad 0 1
end
end

note mc_evid: array of strings; each element becomes --evidence-style flag mfevid + value
fn mc_evid src view uchar * tape view uint * tmp edit uchar * to void
v = get gv 0
if eq v jsnone
ret
end
if ne js_type tape v jsarr
mc_bad 0 1
ret
end
e = js_first tape v
while ne e jsnone bound 999999
if ne js_type tape e jsstr
mc_bad 0 1
ret
end
n = js_sget src js_off tape e tmp
if lt n 0
mc_bad 0 1
ret
end
if not mc_flag mfevid
ret
end
if not mc_val tmp ulong n
mc_bad 0 1
ret
end
e = js_enext tape e
end
end

note mc_req1: mark the next mc_sval as required
fn mc_req1 to void
put gq 1 1
end

note mc_bin: start an argv for CLI t in bin-dir, then --home H when home is set
fn mc_bin t view uchar * home bool to void
syn_ainit
m = syn_mark
syn_ps get gop 0 get gopl 0
syn_pt t
syn_ap m syn_len m
syn_rew m
if home
syn_at mhome
syn_ps get gop 1 get gopl 1
m2 = sub syn_mark get gopl 1
syn_ap m2 get gopl 1
syn_rew m2
end
end

note mc_done: true when the arguments were all consumed and valid, else sends -32602
fn mc_done tape view uint * a ulong to bool
if ne a jsnone
if and eq get gbad 0 0 ne get gq 0 js_nkids tape a
put gbad 0 2
end
end
w = get gbad 0
if eq w 0
ret true
end
if eq w 2
mc_err 32602 mbadunk
ret false
end
if eq w 3
mc_err 32602 mbadlong
ret false
end
if eq w 4
mc_err 32602 mbadobj
ret false
end
mc_err 32602 mbadarg
ret false
end

note ======== running ========
note mc_runap: run gav, append stdout, exit line and (on failure) stderr, all JSON-escaped; returns exit code
fn mc_runap obf edit uchar * to ulong
n = syn_run obf 300000000000
c = ulong get gxs 0
mc_rout obf n c
ret c
end

note mc_rout: append n bytes of stdout, the exit line and (on failure) stderr of the last syn_run
fn mc_rout obf view uchar * n ulong c ulong to void
mc_qnl obf n
mc_qt mexitc
syn_pd c
mc_qt mcl
mc_qb 10
if gt get gxs 1 long n
mc_qt mtrunc
end
if ne c 0
mc_qerr
end
end

note mc_qnl: append obf[0..n) JSON-escaped, ending with a newline when it is not empty
note (and is eager in Omega, so the n > 0 guard is a separate if)
fn mc_qnl obf view uchar * n ulong to void
mc_qa obf 0 n
if gt n 0
if ne get obf sub n 1 10
mc_qb 10
end
end
end

fn mc_tail c ulong to void
syn_pt mriserr
if and ne c 0 and ne c 1 ne c 2
syn_pt mtrue
else
syn_pt mfalse
end
syn_pb 125
syn_pb 125
syn_pb 10
end

note mc_exec: run the prepared argv and send the tool result
fn mc_exec to void
obf = new uchar 1048576 0
m = mc_head
syn_pt mrres
syn_pt mrtext
c = mc_runap obf
mc_tail c
mc_flush m
end

note coord_where: map where, then claims who repo:R for the first three result repos
fn mc_where src view uchar * tape edit uint * tmp edit uchar * to void
a = get gobj 0
mc_bin mbmap true
syn_at mcwhere
mc_req1
mc_get src tape maktask
sv = mc_sval src tape tmp
mc_spos tmp sv
mc_get src tape maklimit
mc_int src tape mflimit
if not mc_done tape a
ret
end
mc_wrun tape tmp
end

note mc_wrun: second half of coord_where (split out to stay within omc's 16 registers). The who targets are
note collected in the pool before the response starts, so they never land inside it.
fn mc_wrun tape edit uint * tmp edit uchar * to void
obf = new uchar 1048576 0
n = syn_run obf 300000000000
c = ulong get gxs 0
r = js_init tape 65536 16
rp = syn_mark
k = mc_wscan part obf 0 n tape tmp
m = mc_head
syn_pt mrres
syn_pt mrtext
mc_rout obf n c
mc_who3 obf rp k
mc_tail c
mc_flush m
syn_rew rp
end

note mc_wscan: per newline-terminated line of out (first three with a repo), mc_wrepo; returns how many appended
fn mc_wscan lns view uchar * tape edit uint * tmp edit uchar * to ulong
n = len lns
k = ulong 0
s = ulong 0
for i ulong add n 1
nl = eq i n
if not nl
nl = eq get lns i 10
end
if nl
if and gt i s lt k 3
k = add k mc_wrepo part lns s sub i s tape tmp
end
s = add i 1
end
end
ret k
end

note mc_wrepo: when line ln parses and has a string "repo", append "claims who repo:R" target; 1 if appended
fn mc_wrepo ln view uchar * tape edit uint * tmp edit uchar * to ulong
q = js_parse ln tape len ln
if gt q 0
v = pu_rmemb ln tape mkrepo
if and ne v jsnone eq js_type tape v jsstr
x = js_sget ln js_off tape v tmp
if gt x 0
syn_pt mrepoc
syn_pa tmp 0 ulong x
syn_pb 10
ret 1
end
end
end
ret 0
end

note pu_rmemb: value token of key in the root object, or jsnone
fn pu_rmemb src view uchar * tape view uint * key view uchar * to ulong
if ne js_type tape 0 jsobj
ret jsnone
end
k = js_first tape 0
while ne k jsnone bound 999999
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end

note mc_who3: for each newline-terminated target in the pool from rp (k of them), run claims who
fn mc_who3 obf edit uchar * rp ulong k ulong to void
put gq 2 rp
put gq 3 0
for j ulong k
p = get gq 2
e = syn_find p 4096 0 10
mc_bin mbclaims true
syn_at mcwho
syn_ap p e
put gq 2 add add p e 1
mc_who1 obf p e
end
end

fn mc_who1 obf edit uchar * p ulong e ulong to void
n = syn_run obf 300000000000
c = ulong get gxs 0
mc_qnl obf n
mc_qt mwhoc
mc_qp p e
mc_qt mwhoe
syn_pd c
mc_qt mcl
mc_qb 10
if ne c 0
mc_qerr
end
end

note coord_board: claims list --all into HOME/board/claims.jsonl, then board render
fn mc_board tape view uint * a ulong to void
if not mc_done tape a
ret
end
obf = new uchar 1048576 0
m = mc_head
syn_pt mrres
syn_pt mrtext
mc_bin mbclaims true
syn_at mclist
syn_at mfall
n = syn_run obf 300000000000
c = ulong get gxs 0
if or ne c 0 gt get gxs 1 long n
mc_qt mlisterr
mc_qb 10
mc_qerr
mc_tail 70
mc_flush m
ret
end
d = syn_mark
syn_ps get gop 1 get gopl 1
syn_pt mslboard
r = syn_mkdir d syn_len d
syn_rew d
if not mc_bwrite obf n
mc_qt mwrerr
mc_qb 10
mc_tail 70
mc_flush m
ret
end
mc_bin mbboard false
syn_at mcrender
mc_barg mfclaims mslbcl
mc_barg mfmap mslmap
mc_barg mffind mslfind
mc_barg mfout mslboard
c = mc_runap obf
mc_tail c
mc_flush m
end

note mc_bpath: HOME + suffix t appended to the pool; gq 2, 3 = offset, length. The pool also holds the
note response being built, so every caller rewinds to gq 2 once the path is used.
fn mc_bpath t view uchar * to void
p = syn_mark
syn_ps get gop 1 get gopl 1
syn_pt t
put gq 2 p
put gq 3 syn_len p
end

note mc_barg: argv records flag f and HOME + suffix t
fn mc_barg f view uchar * t view uchar * to void
syn_at f
mc_bpath t
syn_ap get gq 2 get gq 3
syn_rew get gq 2
end

note mc_bwrite: write obf[0..n) to HOME/board/claims.jsonl (temp file, sync, rename); false on any failure
fn mc_bwrite obf view uchar * n ulong to bool
mc_bpath mslbcl
fd = syn_wbeg get gq 2 get gq 3
if lt fd 0
syn_rew get gq 2
ret false
end
w = write int fd obf 0 n
r = syn_wend fd get gq 2 get gq 3
syn_rew get gq 2
ret and eq w long n eq r 0
end

note ======== tools/call ========
fn mc_call src view uchar * tape edit uint * tmp edit uchar * to void
p = get gobj 0
put gbad 0 0
put gq 0 0
put gq 1 0
if or eq p jsnone ne js_type tape p jsobj
mc_err 32602 mmeparm
ret
end
put gobj 0 p
nt = pu_memb2 src tape mkname
if or eq nt jsnone ne js_type tape nt jsstr
mc_err 32602 mmeparm
ret
end
a = pu_memb2 src tape mkargs
put gobj 0 a
if ne a jsnone
if ne js_type tape a jsobj
mc_err 32602 mbadobj
ret
end
end
o = js_off tape nt
if js_streq src o mtn01
mc_where src tape tmp
ret
end
if js_streq src o mtn13
mc_board tape a
ret
end
put gnm 0 o
if not mc_build src tape tmp
mc_err 32602 mmetool
ret
end
if mc_done tape a
mc_exec
end
end

note pu_memb2: value token of key in object gobj 0, or jsnone
fn pu_memb2 src view uchar * tape view uint * key view uchar * to ulong
o = get gobj 0
k = js_first tape o
while ne k jsnone bound 999999
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end

note mc_build: argv for the single-exec tools; false for an unknown tool name
fn mc_build src view uchar * tape view uint * tmp edit uchar * to bool
o = get gnm 0
if js_streq src o mtn02
mc_bin mbmap true
syn_at mctree
mc_get src tape maktext
mc_bool tape mftext
ret true
end
if js_streq src o mtn03
mc_bin mbmap true
syn_at mccheck
ret true
end
if js_streq src o mtn04
mc_bin mbclaims true
syn_at mcclaim
mc_req1
mc_get src tape makagent
sv = mc_sval src tape tmp
mc_semit tmp sv mfagent
mc_req1
mc_get src tape maksess
sv = mc_sval src tape tmp
mc_semit tmp sv mfsess
mc_req1
mc_get src tape maktarg
sv = mc_sval src tape tmp
mc_semit tmp sv mftarg
mc_get src tape makttl
mc_int src tape mfttl
mc_get src tape makmode
sv = mc_sval src tape tmp
mc_semit tmp sv mfmode
mc_get src tape makstate
sv = mc_sval src tape tmp
mc_semit tmp sv mfstate
mc_get src tape makint
sv = mc_sval src tape tmp
mc_semit tmp sv mfint
mc_get src tape makevid
mc_evid src tape tmp
ret true
end
if js_streq src o mtn05
mc_bin mbclaims true
syn_at mcrenew
mc_req1
mc_get src tape makagent
sv = mc_sval src tape tmp
mc_semit tmp sv mfagent
mc_req1
mc_get src tape makid
sv = mc_sval src tape tmp
mc_semit tmp sv mfid
mc_get src tape makttl
mc_int src tape mfttl
ret true
end
if js_streq src o mtn06
mc_bin mbclaims true
syn_at mcrel
mc_req1
mc_get src tape makagent
sv = mc_sval src tape tmp
mc_semit tmp sv mfagent
mc_req1
mc_get src tape makid
sv = mc_sval src tape tmp
mc_semit tmp sv mfid
mc_get src tape makstate
sv = mc_sval src tape tmp
mc_semit tmp sv mfstate
mc_get src tape makevid
mc_evid src tape tmp
ret true
end
if js_streq src o mtn07
mc_bin mbclaims true
syn_at mcstate
mc_req1
mc_get src tape makagent
sv = mc_sval src tape tmp
mc_semit tmp sv mfagent
mc_req1
mc_get src tape makid
sv = mc_sval src tape tmp
mc_semit tmp sv mfid
mc_req1
mc_get src tape makstate
sv = mc_sval src tape tmp
mc_semit tmp sv mfstate
mc_get src tape makevid
mc_evid src tape tmp
ret true
end
if js_streq src o mtn08
mc_bin mbclaims true
syn_at mcwho
mc_req1
mc_get src tape maktarg
sv = mc_sval src tape tmp
mc_spos tmp sv
ret true
end
if js_streq src o mtn09
mc_bin mbclaims true
syn_at mclist
mc_get src tape makall
mc_bool tape mfall
ret true
end
if js_streq src o mtn10
mc_bin mbclaims true
syn_at mcconf
ret true
end
if js_streq src o mtn11
mc_bin mbclaims true
syn_at mcver
ret true
end
if js_streq src o mtn12
mc_bin mbpulse true
syn_at mcrun
syn_at mfcbin
m = syn_mark
syn_ps get gop 0 get gopl 0
syn_pt mbclaims
syn_ap m syn_len m
syn_rew m
mc_get src tape makalert
mc_bool tape mfalert
ret true
end
if js_streq src o mtn14
mc_bin mbclaims true
syn_at mclist
syn_at mfprefix
mc_req1
mc_get src tape maklane
sv = mc_sval src tape tmp
mc_spos tmp sv
ret true
end
ret false
end

note ======== one request line ========
fn mc_req src view uchar * tape edit uint * tmp edit uchar * to void
base = syn_mark
put gid 1 0
r = js_parse src tape len src
if lt r 0
mc_err 32700 mmeparse
ret
end
if ne js_type tape 0 jsobj
mc_err 32600 mmeinv
ret
end
iv = pu_rmemb src tape mkid
if ne iv jsnone
t = js_type tape iv
if and and ne t jsstr ne t jsnum ne t jsnull
mc_err 32600 mmeinv
ret
end
m = syn_mark
syn_pa src js_off tape iv js_span tape iv
put gid 0 m
put gid 1 js_span tape iv
end
mv = pu_rmemb src tape mkmeth
jv = pu_rmemb src tape mkjrpc
ok = and ne mv jsnone ne jv jsnone
if ok
ok = and eq js_type tape mv jsstr eq js_type tape jv jsstr
end
if ok
ok = js_streq src js_off tape jv mk20
end
if eq iv jsnone
syn_rew base
ret
end
if not ok
mc_err 32600 mmeinv
syn_rew base
ret
end
o = js_off tape mv
if js_streq src o mminit
mc_okt mrinit
else
if js_streq src o mmping
mc_okt mrempty
else
if js_streq src o mmlist
mc_list
else
if js_streq src o mmcall
pv = pu_rmemb src tape mkpar
put gobj 0 pv
mc_call src tape tmp
else
mc_err 32601 mmenome
end
end
end
end
syn_rew base
end

note ======== main ========
note mc_pre: b starts with t (caller checks the length)
fn mc_pre b view uchar * t view uchar * to bool
for j ulong len t
if ne get b j get t j
ret false
end
end
ret true
end

note mc_envopt: option i = the environment value after prefix t; false when no variable has that prefix
fn mc_envopt i ulong t view uchar * to bool
b = new uchar 8192 0
for e ulong ulong envcnt
n = envread e b 0 len b
if gt n long len t
if mc_pre b t
m = syn_mark
syn_pa b len t sub ulong n len t
put gop i m
put gopl i syn_len m
ret true
end
end
end
ret false
end

fn mc_args to void
n = ulong argcnt
i = ulong 1
while lt i n bound 1000
o = syn_arg i
l = ulong get gxs 2
k = ulong 99
if syn_seq o l mbindir
k = 0
end
if syn_seq o l mhome
k = 1
end
if or eq k 99 ge add i 1 n
syn_die musage 64
end
v = syn_arg add i 1
vl = ulong get gxs 2
if or eq vl 0 ne get gsp v 47
syn_die musage 64
end
put gop k v
put gopl k vl
i = add i 2
end
if eq get gopl 0 0
syn_die mnobin 64
end
if eq get gopl 1 0
if not mc_envopt 1 menvh
if not mc_envopt 1 menvhm
syn_die mnohome 64
end
syn_pt mdhome
put gopl 1 syn_len get gop 1
end
end
if eq get gopl 1 0
syn_die mnohome 64
end
end

fn mc_loop to void
buf = new uchar 1048576 0
tape = new uint 524288 0
tmp = new uchar 65536 0
put gln 0 0
put gln 1 0
eof = false
note bound is 1..999999 per loop; 4295 x 999999 reads keeps the original 4294967295 limit
while not eof bound 4295
while not eof bound 999999
eof = mc_chunk buf tape tmp
end
end
bl = get gln 0
if and gt bl 0 eq get gln 1 0
mc_line part buf 0 bl tape tmp
end
end

note mc_chunk: read one block of stdin and answer each complete line; true at end of input
note gln 0: bytes of the pending line in buf; gln 1: 1 when that line overflowed buf
fn mc_chunk buf edit uchar * tape edit uint * tmp edit uchar * to bool
rd = new uchar 65536 0
eof = false
r = read 0 rd 0 len rd
if le r 0
eof = true
r = 0
end
for i ulong ulong r
c = get rd i
bl = get gln 0
if eq c 10
if eq get gln 1 1
put gid 1 0
mc_err 32700 mmeparse
else
mc_line part buf 0 bl tape tmp
end
put gln 0 0
put gln 1 0
else
if lt bl len buf
put buf bl c
put gln 0 add bl 1
else
put gln 1 1
end
end
end
ret eof
end

note mc_line: strip a trailing CR, skip blank lines, parse and answer
fn mc_line buf view uchar * tape edit uint * tmp edit uchar * to void
n = len buf
if gt n 0
if eq get buf sub n 1 13
n = sub n 1
end
end
blank = true
for i ulong n
c = get buf i
if and and ne c 32 ne c 9 ne c 13
blank = false
end
end
if blank
ret
end
r = js_init tape 983040 64
mc_req part buf 0 n tape tmp
end

fn main to int
mc_args
mc_loop
ret 0
end

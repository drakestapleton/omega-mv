note SPDX-License-Identifier: Apache-2.0
note protocol/synapse/core/test.om: comprehensive behavioral test suite for all 5 Synapse core modules
note (changeset, graph, lease, review, ledger) covering positive paths and every negative/refusal control.
note Composed OM-2 test unit (compose after si/directives/om2.om, om/tls/sha2.om, and core modules).

global g_tst_cnt ulong 8

text tt_pass "PASS "
text tt_fail "FAIL "
text tt_nl "\n"
text tt_sum1 "SYNAPSE-CORE-TEST PASS checks="
text tt_sum2 "SYNAPSE-CORE-TEST FAIL checks="
text tt_sumf " failures="

note test fixtures
text tf_alice "alice"
text tf_bob "bob"
text tf_carol "carol"
text tf_main "main"
text tf_feat1 "feat-1"
text tf_feat2 "feat-2"
text tf_featd "feat-div"
text tf_featr "feat-rej"
text tf_pa "src/a.om"
text tf_pb "src/b.om"
text tf_palpha "src/alpha.om"
text tf_pbeta "src/beta.om"
text tf_pshared "src/shared.om"
text tf_pdir "pkg/mod"
text tf_psub "pkg/mod/sub.om"
text tf_psib "pkg/mod2/sub.om"
text tf_pcore "src/core"
text tf_pcoref "src/core/graph.om"
text tf_pcoref2 "src/core/graph.om"
text tf_bad1 "/abs/file.om"
text tf_bad2 "dir/trail/"
text tf_bad3 "a//b.om"
text tf_bad4 "a/../b.om"
text tf_bad5 "a/./b.om"
text tf_bad6 ".git/config"
text tf_sum "core change"
text tf_lb1 "branch:feat-x"
text tf_lp1 "path:src/core"
text tf_lp2 "path:src/core/graph.om"
text tf_lp3 "path:src"
text tf_lp4 "path:src/core/*"
text tf_lp5 "path:src/core2/x.om"
text tf_lbad "invalid:target"
text tf_fmerged "MERGED"

text tn_cs_ser "changeset.canonical_bytes_match_direct_sha256"
text tn_cs_det "changeset.canonical_sha256_deterministic_across_path_order"
text tn_cs_uniq "changeset.distinct_content_distinct_digest"
text tn_cs_pval "changeset.invalid_and_duplicate_paths_refused"
text tn_cs_ov "changeset.exact_prefix_and_sibling_path_overlap"
text tn_cs_st "changeset.state_machine_forward_and_refusals"

text tn_gr_anc "graph.parent_child_and_ancestry_reachability"
text tn_gr_lca "graph.lowest_common_ancestor_merge_base"
text tn_gr_cyc "graph.cycle_and_self_parent_refused"
text tn_gr_conf "graph.concurrent_branch_disjoint_exact_prefix_conflicts"

text tn_ls_ov "lease.overlapping_branch_and_path_refused_status_2"
text tn_ls_ren "lease.renewal_holder_only_and_extends_ttl"
text tn_ls_exp "lease.expired_lease_reclaimable_and_renew_refused"
text tn_ls_rel "lease.explicit_release_final_status_and_reclaim"

text tn_rv_self "review.self_review_refused"
text tn_rv_blk "review.unreviewed_and_changes_requested_and_reject_block_land"
text tn_rv_inv "review.new_head_invalidates_prior_verdicts_and_stale_head_refused"
text tn_rv_land "review.exact_head_merge_and_fast_forward_land_advances_main"
text tn_rv_nff "review.non_fast_forward_land_refused_never_automerges"

text tn_lg_ok "ledger.hash_chain_records_all_transitions_and_verifies"
text tn_lg_t1 "ledger.tampered_subject_caught"
text tn_lg_t2 "ledger.tampered_prev_hash_caught"
text tn_lg_t3 "ledger.tampered_entry_hash_caught"
text tn_lg_t4 "ledger.tampered_seq_caught"

fn tst_check cond bool label view uchar * to void
put g_tst_cnt 0 add get g_tst_cnt 0 1
if cond
syn_write_text 1 tt_pass
syn_write_text 1 label
syn_write_text 1 tt_nl
else
put g_tst_cnt 1 add get g_tst_cnt 1 1
syn_write_text 1 tt_fail
syn_write_text 1 label
syn_write_text 1 tt_nl
end
end

fn tst_set_par pidx ulong to void
put g_tst_cnt 2 pidx
end

fn tst_next_ts to ulong
t = add get g_tst_cnt 3 1
put g_tst_cnt 3 t
ret t
end

fn tst_cs_add auth view uchar * br view uchar * pth view uchar * to ulong
pid = new uchar 32 0
rc = cs_stage_begin auth br tst_next_ts
if ne rc SYN_OK
ret SYN_NONE
end
pidx = get g_tst_cnt 2
if ne pidx SYN_NONE
cs_get_id pidx pid
rc = cs_stage_set_parent pid
if ne rc SYN_OK
ret SYN_NONE
end
end
rc = cs_stage_add_path pth
if ne rc SYN_OK
ret SYN_NONE
end
rc = cs_stage_commit
if ne rc SYN_OK
ret SYN_NONE
end
ret cs_last_idx
end

note ======== Suite 1: changeset.om ========

fn tst_cs_digest_checks to void
id1 = new uchar 32 0
id2 = new uchar 32 0
ser = new uchar 1024 0
dig = new uchar 32 0
syn_reset_all
ok = eq cs_stage_begin tf_alice tf_feat1 1000 SYN_OK
ok = and ok eq cs_stage_set_summary tf_sum SYN_OK
ok = and ok eq cs_stage_add_path tf_pb SYN_OK
ok = and ok eq cs_stage_add_path tf_pa SYN_OK
ok = and ok eq cs_stage_commit SYN_OK
i1 = cs_last_idx
cs_get_id i1 id1
slen = cs_canonical_serialize i1 ser
dl = sha2_digest 256 part ser 0 slen dig
ok = and ok and eq dl 32 syn_digest_eq id1 dig
tst_check ok tn_cs_ser

syn_reset_all
ok = eq cs_stage_begin tf_alice tf_feat1 1000 SYN_OK
ok = and ok eq cs_stage_set_summary tf_sum SYN_OK
ok = and ok eq cs_stage_add_path tf_pa SYN_OK
ok = and ok eq cs_stage_add_path tf_pb SYN_OK
ok = and ok eq cs_stage_commit SYN_OK
cs_get_id cs_last_idx id2
ok = and ok syn_digest_eq id1 id2
tst_check ok tn_cs_det

ok = eq cs_stage_begin tf_bob tf_feat1 1000 SYN_OK
ok = and ok eq cs_stage_set_summary tf_sum SYN_OK
ok = and ok eq cs_stage_add_path tf_pa SYN_OK
ok = and ok eq cs_stage_add_path tf_pb SYN_OK
ok = and ok eq cs_stage_commit SYN_OK
cs_get_id cs_last_idx dig
ok = and ok eq syn_digest_eq id2 dig false
tst_check ok tn_cs_uniq
end

fn tst_cs_path_and_state_checks to void
syn_reset_all
ok = eq cs_path_valid tf_bad1 false
ok = and ok eq cs_path_valid tf_bad2 false
ok = and ok eq cs_path_valid tf_bad3 false
ok = and ok eq cs_path_valid tf_bad4 false
ok = and ok eq cs_path_valid tf_bad5 false
ok = and ok eq cs_path_valid tf_bad6 false
ok = and ok eq cs_stage_begin tf_alice tf_feat2 1001 SYN_OK
ok = and ok eq cs_stage_add_path tf_pa SYN_OK
ok = and ok eq cs_stage_add_path tf_pa SYN_ERR_DUPLICATE
tst_check ok tn_cs_pval

ok = eq cs_paths_overlap_view tf_pcoref tf_pcoref2 1
ok = and ok eq cs_paths_overlap_view tf_pcore tf_pcoref 2
ok = and ok eq cs_paths_overlap_view tf_pcoref tf_pcore 2
ok = and ok eq cs_paths_overlap_view tf_pdir tf_psub 2
ok = and ok eq cs_paths_overlap_view tf_pdir tf_psib 0
tst_check ok tn_cs_ov

tst_set_par SYN_NONE
i1 = tst_cs_add tf_alice tf_feat1 tf_pa
i2 = tst_cs_add tf_bob tf_feat2 tf_pb
ok = eq cs_get_state i1 CS_STATE_DRAFT
ok = and ok eq cs_transition i1 CS_STATE_LANDED 1010 SYN_ERR_STATE_INVALID
ok = and ok eq cs_transition i1 CS_STATE_PROPOSED 1011 SYN_OK
ok = and ok eq cs_transition i1 CS_STATE_DRAFT 1012 SYN_ERR_STATE_INVALID
ok = and ok eq cs_transition i1 CS_STATE_REVIEWED 1013 SYN_OK
ok = and ok eq cs_transition i1 CS_STATE_LANDED 1014 SYN_OK
ok = and ok eq cs_transition i1 CS_STATE_ABANDONED 1015 SYN_ERR_STATE_INVALID
ok = and ok eq cs_transition i2 CS_STATE_ABANDONED 1016 SYN_OK
ok = and ok eq cs_transition i2 CS_STATE_PROPOSED 1017 SYN_ERR_STATE_INVALID
tst_check ok tn_cs_st
end

note ======== Suite 2: graph.om ========

fn tst_graph_suite to void
syn_reset_all
put g_tst_cnt 3 2000
tst_set_par SYN_NONE
root = tst_cs_add tf_alice tf_main tf_pa
tst_set_par root
a1 = tst_cs_add tf_alice tf_feat1 tf_palpha
tst_set_par a1
a2 = tst_cs_add tf_alice tf_feat1 tf_pcore
tst_set_par root
b1 = tst_cs_add tf_bob tf_feat2 tf_pbeta
tst_set_par b1
b2 = tst_cs_add tf_bob tf_feat2 tf_psib
tst_set_par a1
c1 = tst_cs_add tf_carol tf_featd tf_pcoref

ok = and eq gr_child_count root 2 eq gr_child_count a1 2
ok = and ok and eq gr_parent_count a2 1 eq gr_parent_at a2 0 a1
ok = and ok gr_is_ancestor root a2
ok = and ok gr_is_ancestor a1 c1
ok = and ok gr_is_ancestor a2 a2
ok = and ok eq gr_is_ancestor a2 root false
ok = and ok eq gr_is_ancestor a2 b2 false
tst_check ok tn_gr_anc

ok = eq gr_lca a2 b2 root
ok = and ok eq gr_lca a2 c1 a1
ok = and ok eq gr_lca a1 a2 a1
ok = and ok eq gr_lca b1 c1 root
tst_check ok tn_gr_lca

ok = eq gr_link_parent root a2 SYN_ERR_CYCLE
ok = and ok eq gr_link_parent a1 a1 SYN_ERR_CYCLE
ok = and ok eq gr_link_parent a1 c1 SYN_ERR_CYCLE
ok = and ok eq gr_parent_count root 0
tst_check ok tn_gr_cyc

ok = eq gr_branches_conflict a2 b2 0
ok = and ok eq gr_branches_conflict a1 a2 0
ok = and ok eq gr_branches_conflict a2 c1 2
tst_set_par root
x1 = tst_cs_add tf_alice tf_feat1 tf_pshared
tst_set_par root
x2 = tst_cs_add tf_bob tf_feat2 tf_pshared
ok = and ok eq gr_branches_conflict x1 x2 1
ok = and ok and eq gr_conflict_cs_a x1 eq gr_conflict_cs_b x2
tst_set_par root
x1 = tst_cs_add tf_alice tf_feat1 tf_pdir
tst_set_par root
x2 = tst_cs_add tf_bob tf_feat2 tf_psub
ok = and ok eq gr_branches_conflict x1 x2 2
tst_check ok tn_gr_conf
end

note ======== Suite 3: lease.om ========

fn tst_lease_suite to void
syn_reset_all
ok = eq ls_claim tf_alice tf_lb1 100 50 SYN_OK
lid_br = ls_last_id
ok = and ok eq ls_claim tf_alice tf_lp1 100 50 SYN_OK
lid_pa = ls_last_id
ok = and ok eq ls_claim tf_bob tf_lb1 110 50 SYN_ERR_LEASE_CONFLICT
cidx = ls_conflict_idx
if ne cidx SYN_NONE
ok = and ok syn_arena_eq_view ls_holder_off cidx ls_holder_len cidx tf_alice
else
ok = false
end
ok = and ok eq ls_claim tf_bob tf_lp2 110 50 SYN_ERR_LEASE_CONFLICT
ok = and ok eq ls_claim tf_bob tf_lp3 110 50 SYN_ERR_LEASE_CONFLICT
ok = and ok eq ls_claim tf_bob tf_lp4 110 50 SYN_ERR_LEASE_CONFLICT
ok = and ok eq ls_claim tf_bob tf_lp5 110 50 SYN_OK
ok = and ok eq ls_claim tf_bob tf_lbad 110 50 SYN_ERR_MALFORMED
tst_check ok tn_ls_ov

ok = eq ls_renew lid_br tf_bob 120 60 SYN_ERR_NOT_HOLDER
ok = and ok eq ls_renew lid_br tf_alice 140 60 SYN_OK
ok = and ok eq ls_claim tf_bob tf_lb1 160 30 SYN_ERR_LEASE_CONFLICT
tst_check ok tn_ls_ren

ok = eq ls_is_active lid_pa 160 false
ok = and ok eq ls_renew lid_pa tf_alice 160 50 SYN_ERR_LEASE_CLOSED
ok = and ok eq ls_claim tf_bob tf_lp1 160 50 SYN_OK
tst_check ok tn_ls_exp

ok = eq ls_release lid_br tf_bob tf_fmerged 170 SYN_ERR_NOT_HOLDER
ok = and ok eq ls_release lid_br tf_alice tf_fmerged 170 SYN_OK
ok = and ok eq ls_release lid_br tf_alice tf_fmerged 171 SYN_ERR_LEASE_CLOSED
ok = and ok eq ls_claim tf_bob tf_lb1 171 40 SYN_OK
cidx = ls_find_by_id lid_br
if ne cidx SYN_NONE
ok = and ok syn_arena_eq_view ls_final_off cidx ls_final_len cidx tf_fmerged
else
ok = false
end
tst_check ok tn_ls_rel
end

note ======== Suite 4: review.om ========

fn tst_review_suite to void
id1 = new uchar 32 0
id2 = new uchar 32 0
syn_reset_all
put g_tst_cnt 3 3000

tst_set_par SYN_NONE
root = tst_cs_add tf_alice tf_main tf_pa
ok = eq gr_branch_set tf_main root SYN_OK
tst_set_par root
cs1 = tst_cs_add tf_alice tf_feat1 tf_palpha
ok = and ok eq cs_transition cs1 CS_STATE_PROPOSED 3005 SYN_OK
cs_get_id cs1 id1

note 4a: self-review refused
ok = and ok eq rv_record id1 tf_alice RV_MERGE 3006 SYN_ERR_SELF_REVIEW
tst_check ok tn_rv_self

note 4b: unreviewed blocked, CHANGES_REQUESTED blocks even with MERGE, REJECT blocks
ok = eq rv_land cs1 id1 3007 SYN_ERR_REVIEW_BLOCKED
ok = and ok eq rv_record id1 tf_carol RV_CHANGES_REQUESTED 3008 SYN_OK
ok = and ok eq rv_record id1 tf_bob RV_MERGE 3009 SYN_OK
ok = and ok eq rv_land cs1 id1 3010 SYN_ERR_REVIEW_BLOCKED
tst_set_par root
cs2 = tst_cs_add tf_alice tf_featr tf_pb
ok = and ok eq cs_transition cs2 CS_STATE_PROPOSED 3011 SYN_OK
cs_get_id cs2 id2
ok = and ok eq rv_record id2 tf_bob RV_MERGE 3012 SYN_OK
ok = and ok eq rv_record id2 tf_carol RV_REJECT 3013 SYN_OK
ok = and ok eq rv_land cs2 id2 3014 SYN_ERR_REVIEW_BLOCKED
tst_check ok tn_rv_blk

note 4c: new head on feat-1 invalidates cs1 verdicts; stale-head verdict refused
tst_set_par cs1
cs2 = tst_cs_add tf_alice tf_feat1 tf_pcore
ok = eq cs_transition cs2 CS_STATE_PROPOSED 3020 SYN_OK
cs_get_id cs2 id2
ok = and ok eq rv_valid_merge_count cs1 0
ok = and ok eq rv_record id1 tf_bob RV_MERGE 3021 SYN_ERR_STALE_HEAD
rv_set_time 3022
ok = and ok eq rv_record_bound cs2 id1 tf_bob RV_MERGE SYN_ERR_STALE_HEAD
ok = and ok eq rv_land cs2 id1 3023 SYN_ERR_STALE_HEAD
ok = and ok eq rv_land cs2 id2 3024 SYN_ERR_REVIEW_BLOCKED
tst_check ok tn_rv_inv

note 4d: fresh exact-head MERGE + fast-forward from main -> LAND succeeds & advances main
ok = eq rv_record id2 tf_bob RV_MERGE 3030 SYN_OK
ok = and ok eq rv_land cs2 id2 3031 SYN_OK
ok = and ok eq cs_get_state cs2 CS_STATE_LANDED
ok = and ok eq gr_main_head cs2
tst_check ok tn_rv_land

note 4e: non-fast-forward land refused (never automerges!)
tst_set_par root
cs1 = tst_cs_add tf_bob tf_featd tf_pbeta
ok = eq cs_transition cs1 CS_STATE_PROPOSED 3040 SYN_OK
cs_get_id cs1 id1
ok = and ok eq rv_record id1 tf_carol RV_MERGE 3041 SYN_OK
ok = and ok eq rv_land cs1 id1 3042 SYN_ERR_NON_FF
ok = and ok eq gr_main_head cs2
tst_check ok tn_rv_nff
end

note ======== Suite 5: ledger.om ========

fn tst_ledger_suite to void
id1 = new uchar 32 0
syn_reset_all
put g_tst_cnt 3 4000

tst_set_par SYN_NONE
root = tst_cs_add tf_alice tf_main tf_pa
ok = eq gr_branch_set tf_main root SYN_OK
tst_set_par root
cs1 = tst_cs_add tf_alice tf_feat1 tf_pb
ok = and ok eq cs_transition cs1 CS_STATE_PROPOSED 4005 SYN_OK
cs_get_id cs1 id1
ok = and ok eq ls_claim tf_alice tf_lb1 4006 100 SYN_OK
lid = ls_last_id
ok = and ok eq ls_renew lid tf_alice 4010 100 SYN_OK
ok = and ok eq rv_record id1 tf_bob RV_MERGE 4011 SYN_OK
ok = and ok eq rv_land cs1 id1 4012 SYN_OK
ok = and ok eq ls_release lid tf_alice tf_fmerged 4013 SYN_OK
ok = and ok eq lg_verify SYN_OK
ok = and ok ge lg_count 9
tst_check ok tn_lg_ok

lg_tamper_xor_subj 2 0 1
ok = eq lg_verify SYN_ERR_LEDGER_TAMPER
ok = and ok eq lg_bad_seq 3
lg_tamper_xor_subj 2 0 1
ok = and ok eq lg_verify SYN_OK
tst_check ok tn_lg_t1

lg_tamper_xor_prev 3 5 1
ok = eq lg_verify SYN_ERR_LEDGER_TAMPER
ok = and ok eq lg_bad_seq 4
lg_tamper_xor_prev 3 5 1
ok = and ok eq lg_verify SYN_OK
tst_check ok tn_lg_t2

lg_tamper_xor_hash 1 31 1
ok = eq lg_verify SYN_ERR_LEDGER_TAMPER
ok = and ok eq lg_bad_seq 2
lg_tamper_xor_hash 1 31 1
ok = and ok eq lg_verify SYN_OK
tst_check ok tn_lg_t3

lg_tamper_set_seq 0 99
ok = eq lg_verify SYN_ERR_LEDGER_TAMPER
ok = and ok eq lg_bad_seq 1
lg_tamper_set_seq 0 1
ok = and ok eq lg_verify SYN_OK
tst_check ok tn_lg_t4
end

fn main to int
put g_tst_cnt 0 0
put g_tst_cnt 1 0
put g_tst_cnt 2 SYN_NONE
put g_tst_cnt 3 1000
tst_cs_digest_checks
tst_cs_path_and_state_checks
tst_graph_suite
tst_lease_suite
tst_review_suite
tst_ledger_suite
tot = get g_tst_cnt 0
fails = get g_tst_cnt 1
if eq fails 0
syn_write_text 1 tt_sum1
syn_write_u64 1 tot
syn_write_text 1 tt_sumf
syn_write_u64 1 fails
syn_write_text 1 tt_nl
ret 0
end
syn_write_text 1 tt_sum2
syn_write_u64 1 tot
syn_write_text 1 tt_sumf
syn_write_u64 1 fails
syn_write_text 1 tt_nl
ret 1
end

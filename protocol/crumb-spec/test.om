note SPDX-License-Identifier: Apache-2.0
note protocol/crumb-spec/test.om: pure-Omega positive & negative control tests for crumb-spec BLAKE3 ledger.
note Ports all scenarios from crumb-spec src/lib.rs.
note Compose after si/directives/om2.om, om/blake3/b3unit.om, and protocol/crumb-spec/ledger.om.

text ct_pass "PASS crumb-spec BLAKE3 hash-chained ledger all 7 test suites passed\n"
text ct_fail "FAIL crumb-spec ledger\n"

text ct_agent "agent-atlas-prime"
text ct_t0 "crates/core/src/lib.rs"
text ct_i0 "Init core crate"
text ct_p0 "payload-content-step-0"
text ct_t1 "crates/core/src/lib.rs"
text ct_i1 "Implement protocol handler"
text ct_p1 "payload-content-step-1"
text ct_t2 "crates/core/tests/test.rs"
text ct_i2 "Add unit tests"
text ct_p2 "payload-content-step-2"
text ct_t3 "target/release/core"
text ct_i3 "Compile release binary"
text ct_p3 "payload-content-step-3"
text ct_evil "Malicious backdoor inserted"

fn ct_compute_ev idx ulong ts ulong act ulong par view uchar 32 out_h edit uchar 32 to bool
ph = new uchar 32 0
buf = new uchar 1024 0
p = cr_event_preimage_head buf idx ts act ct_agent
if eq p ulong 99999
ret false
end
if eq idx ulong 0
if ne cr_blake3_buf ct_p0 ph CRUMB_OK
ret false
end
p = cr_event_preimage_tail buf p ct_t0 ct_i0
end
if eq idx ulong 1
if ne cr_blake3_buf ct_p1 ph CRUMB_OK
ret false
end
p = cr_event_preimage_tail buf p ct_t1 ct_i1
end
if eq idx ulong 2
if ne cr_blake3_buf ct_p2 ph CRUMB_OK
ret false
end
p = cr_event_preimage_tail buf p ct_t2 ct_i2
end
if eq idx ulong 3
if ne cr_blake3_buf ct_p3 ph CRUMB_OK
ret false
end
p = cr_event_preimage_tail buf p ct_t3 ct_i3
end
if eq idx ulong 99
if ne cr_blake3_buf ct_p0 ph CRUMB_OK
ret false
end
p = cr_event_preimage_head buf ulong 0 ts act ct_agent
if eq p ulong 99999
ret false
end
p = cr_event_preimage_tail buf p ct_t0 ct_evil
end
if eq p ulong 99999
ret false
end
rc = cr_event_finalize buf p ph par out_h
ret eq rc CRUMB_OK
end

fn ct_run_all to bool
indices = new ulong 32 0
ts = new ulong 32 0
hashes = new uchar 1024 0
parents = new uchar 1024 0
zero = new uchar 32 0
h0 = new uchar 32 0
h1 = new uchar 32 0
h2 = new uchar 32 0
h3 = new uchar 32 0
base_t = ulong 1700000000

note 1. Build 4-event hash chain
if not ct_compute_ev ulong 0 base_t CRUMB_ACT_CREATE zero h0
ret false
end
put indices 0 ulong 0
put ts 0 base_t
cr_put_slot32 parents ulong 0 zero
cr_put_slot32 hashes ulong 0 h0

if not ct_compute_ev ulong 1 add base_t ulong 10 CRUMB_ACT_MODIFY h0 h1
ret false
end
put indices 1 ulong 1
put ts 1 add base_t ulong 10
cr_put_slot32 parents ulong 1 h0
cr_put_slot32 hashes ulong 1 h1

if not ct_compute_ev ulong 2 add base_t ulong 20 CRUMB_ACT_TEST h1 h2
ret false
end
put indices 2 ulong 2
put ts 2 add base_t ulong 20
cr_put_slot32 parents ulong 2 h1
cr_put_slot32 hashes ulong 2 h2

if not ct_compute_ev ulong 3 add base_t ulong 30 CRUMB_ACT_BUILD h2 h3
ret false
end
put indices 3 ulong 3
put ts 3 add base_t ulong 30
cr_put_slot32 parents ulong 3 h2
cr_put_slot32 hashes ulong 3 h3

note 2. Untampered chain verifies
if ne cr_verify_chain_meta ulong 4 indices ts hashes parents CRUMB_OK
ret false
end

note 3. Scenario 1: tamper genesis intent -> hash mismatch; rehash genesis -> event 1 ParentHashMismatch
h0_bad = new uchar 32 0
if not ct_compute_ev ulong 99 base_t CRUMB_ACT_CREATE zero h0_bad
ret false
end
if cr_hash_eq h0 h0_bad
ret false
end
cr_put_slot32 hashes ulong 0 h0_bad
if ne cr_verify_chain_meta ulong 4 indices ts hashes parents CRUMB_ERR_PARENT_MISMATCH
ret false
end
note Restore genesis hash
cr_put_slot32 hashes ulong 0 h0

note 4. Scenario 2: chronological violation (ts[2] < ts[1])
put ts 2 add base_t ulong 5
if ne cr_verify_chain_meta ulong 4 indices ts hashes parents CRUMB_ERR_CHRONO
ret false
end
put ts 2 add base_t ulong 20

note 5. Scenario 3: non-zero genesis parent
put parents 0 uchar 1
if ne cr_verify_chain_meta ulong 4 indices ts hashes parents CRUMB_ERR_INVALID_GENESIS
ret false
end
put parents 0 uchar 0

note 6. Scenario 4: invalid index sequence
put indices 2 ulong 9
if ne cr_verify_chain_meta ulong 4 indices ts hashes parents CRUMB_ERR_INVALID_INDEX
ret false
end
put indices 2 ulong 2

note 7. Scenario 5: verify_parent (valid, missing parent, wrong parent)
if ne cr_verify_parent ulong 4 ulong 0 zero hashes CRUMB_OK
ret false
end
if ne cr_verify_parent ulong 4 ulong 2 h1 hashes CRUMB_OK
ret false
end
if ne cr_verify_parent ulong 4 ulong 5 h3 hashes CRUMB_ERR_MISSING_PARENT
ret false
end
if ne cr_verify_parent ulong 4 ulong 2 h0 hashes CRUMB_ERR_PARENT_MISMATCH
ret false
end
ret true
end

fn main to int
if not ct_run_all
k = write int 1 ct_fail ulong 0 len ct_fail
if lt k long 0
ret int 1
end
ret int 1
end
k = write int 1 ct_pass ulong 0 len ct_pass
if lt k long 0
ret int 1
end
ret int 0
end

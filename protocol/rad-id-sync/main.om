note protocol/rad-id-sync/main.om: CLI entrypoint for rad-id-sync
note Compose with: si/directives/om2.om protocol/rad-id-sync/lib.om protocol/rad-id-sync/main.om

text cmd_status "status"
text cmd_sync "sync"
text cmd_json "json"
text cmd_check_rid "check-rid"
text cmd_check_did "check-did"
text cmd_diff "diff"

text hdr_anchor "=== Radicle Identity Anchor ===\n"
text lbl_did "DID:         "
text lbl_name "Name:        "
text lbl_type "Type:        autonomous_agent\n"
text lbl_radk "Radicle Key: "
text lbl_sshk "SSH Key:     "
text lbl_hist "Key History: "
text lbl_recs " records\n"
text lbl_none "<none>\n"
text lbl_nl "\n"

text msg_valid_rid "VALID RID\n"
text msg_invalid_rid "INVALID RID\n"
text msg_valid_did "VALID DID\n"
text msg_invalid_did "INVALID DID\n"
text msg_usage "Usage: rad-id-sync [status|sync|json|check-rid <rid>|check-did <did>|diff]\n"

text k_rid "rid="
text k_bth "base_threshold="
text k_bdid "base_did="
text k_rth "remote_threshold="
text k_rdid "remote_did="
text k_appr "approvals="
text k_allow "allow_add="

text dj_open "{\"code\":"
text dj_dec ",\"decision\":"
text dj_add ",\"added\":"
text dj_rem ",\"removed\":"
text dj_com ",\"common\":"
text dj_tch ",\"threshold_changed\":"
text dj_close "}\n"

fn print_status to int
buf = new uchar 1024 0
p = ulong 0
p = append_bytes buf p hdr_anchor
p = append_bytes buf p lbl_did
dl = get g_anc_did_len 0
i = ulong 0
while lt i dl bound 64
p = append_byte buf p get g_anc_did i
i = add i ulong 1
end
p = append_bytes buf p lbl_nl
p = append_bytes buf p lbl_name
nl = get g_anc_name_len 0
j = ulong 0
while lt j nl bound 64
p = append_byte buf p get g_anc_name j
j = add j ulong 1
end
p = append_bytes buf p lbl_nl
p = append_bytes buf p lbl_type
p = append_bytes buf p lbl_radk
rl = get g_anc_rad_len 0
if eq rl ulong 0
p = append_bytes buf p lbl_none
else
k = ulong 0
while lt k rl bound 256
p = append_byte buf p get g_anc_rad_key k
k = add k ulong 1
end
p = append_bytes buf p lbl_nl
end
p = append_bytes buf p lbl_sshk
sl = get g_anc_ssh_len 0
if eq sl ulong 0
p = append_bytes buf p lbl_none
else
m = ulong 0
while lt m sl bound 256
p = append_byte buf p get g_anc_ssh_key m
m = add m ulong 1
end
p = append_bytes buf p lbl_nl
end
p = append_bytes buf p lbl_hist
p = append_u64 buf p get g_anc_hist_n 0
p = append_bytes buf p lbl_recs
ok = write_all int 1 part buf 0 p
if not ok
ret 1
end
ret 0
end

fn read_stdin_all dst edit uchar * to ulong
cap = len dst
pos = ulong 0
note bound 4096 caps stdin reads for CLI descriptor input
while lt pos cap bound 4096
remn = sub cap pos
k = read int 0 dst pos remn
if le k long 0
break
end
pos = add pos ulong k
end
ret pos
end

fn parse_diff_line line view uchar * appr edit ulong 1 allow edit ulong 1 to ulong
s = trim_start line
e = trim_end line
if ge s e
ret RAD_OK
end
n = sub e s
ok = new ulong 1 0
if slice_starts_with part line s n k_rid
r1 = base_doc_set_rid part line add s ulong 4 sub n ulong 4
if ne r1 RAD_OK
ret r1
end
ret remote_doc_set_rid part line add s ulong 4 sub n ulong 4
end
if slice_starts_with part line s n k_bth
v = parse_u64_strict part line add s ulong 15 sub n ulong 15 ok
if eq get ok 0 ulong 0
ret RAD_ERR_PARSE
end
base_doc_set_threshold v
ret RAD_OK
end
if slice_starts_with part line s n k_rth
v = parse_u64_strict part line add s ulong 17 sub n ulong 17 ok
if eq get ok 0 ulong 0
ret RAD_ERR_PARSE
end
remote_doc_set_threshold v
ret RAD_OK
end
if slice_starts_with part line s n k_bdid
ret base_doc_add_delegate part line add s ulong 9 sub n ulong 9
end
if slice_starts_with part line s n k_rdid
ret remote_doc_add_delegate part line add s ulong 11 sub n ulong 11
end
if slice_starts_with part line s n k_appr
v = parse_u64_strict part line add s ulong 10 sub n ulong 10 ok
if eq get ok 0 ulong 0
ret RAD_ERR_PARSE
end
put appr 0 v
ret RAD_OK
end
if slice_starts_with part line s n k_allow
v = parse_u64_strict part line add s ulong 10 sub n ulong 10 ok
if eq get ok 0 ulong 0
ret RAD_ERR_PARSE
end
put allow 0 v
ret RAD_OK
end
ret RAD_ERR_PARSE
end

fn run_diff_stdin to int
inp = new uchar 4096 0
jbuf = new uchar 512 0
appr = new ulong 1 0
allow = new ulong 1 0
diff = new RadDiff 0 0 0 0 0 0
base_doc_reset
remote_doc_reset
n = read_stdin_all inp
pos = ulong 0
while lt pos n bound 4096
ls = pos
while lt pos n bound 4096
if eq get inp pos uchar 10
break
end
pos = add pos ulong 1
end
ll = sub pos ls
if gt ll ulong 0
rc = parse_diff_line part inp ls ll appr allow
if ne rc RAD_OK
put diff code rc
put diff decision SYNC_REFUSED
break
end
end
if lt pos n
pos = add pos ulong 1
end
end
if eq get diff code RAD_OK
rad_doc_diff_sync get appr 0 get allow 0 diff
end
p = ulong 0
p = append_bytes jbuf p dj_open
p = append_u64 jbuf p get diff code
p = append_bytes jbuf p dj_dec
p = append_u64 jbuf p get diff decision
p = append_bytes jbuf p dj_add
p = append_u64 jbuf p get diff added
p = append_bytes jbuf p dj_rem
p = append_u64 jbuf p get diff removed
p = append_bytes jbuf p dj_com
p = append_u64 jbuf p get diff common
p = append_bytes jbuf p dj_tch
p = append_u64 jbuf p get diff thresh_chg
p = append_bytes jbuf p dj_close
ok = write_all int 1 part jbuf 0 p
if not ok
ret 1
end
if ne get diff code RAD_OK
ret 1
end
ret 0
end

fn main to int
arg1 = new uchar 256 0
arg2 = new uchar 256 0
jbuf = new uchar 1024 0
st = new AnchorSync 0 0 0 0 0 0
anchor_init_default
ac = argcnt
if le ac long 1
ret print_status
end
n1 = argread ulong 1 arg1 ulong 0 ulong 256
if le n1 long 0
ret 1
end
u1 = ulong n1
if slice_eq part arg1 0 u1 cmd_status
ret print_status
end
if or slice_eq part arg1 0 u1 cmd_sync slice_eq part arg1 0 u1 cmd_json
anchor_sync_keys part arg1 0 0 part arg2 0 0 st
jl = anchor_render_json st jbuf
ok = write_all int 1 part jbuf 0 jl
if not ok
ret 1
end
ret 0
end
if slice_eq part arg1 0 u1 cmd_check_rid
if le ac long 2
ok = write_all int 2 msg_usage
if not ok
ret 2
end
ret 2
end
n2 = argread ulong 2 arg2 ulong 0 ulong 256
if le n2 long 0
ok = write_all int 1 msg_invalid_rid
if not ok
ret 1
end
ret 1
end
rc = validate_rid part arg2 0 ulong n2
if eq rc RAD_OK
ok = write_all int 1 msg_valid_rid
if not ok
ret 1
end
ret 0
end
ok = write_all int 1 msg_invalid_rid
if not ok
ret 1
end
ret 1
end
if slice_eq part arg1 0 u1 cmd_check_did
if le ac long 2
ok = write_all int 2 msg_usage
if not ok
ret 2
end
ret 2
end
n2 = argread ulong 2 arg2 ulong 0 ulong 256
if le n2 long 0
ok = write_all int 1 msg_invalid_did
if not ok
ret 1
end
ret 1
end
rc = validate_delegate_did part arg2 0 ulong n2
if eq rc RAD_OK
ok = write_all int 1 msg_valid_did
if not ok
ret 1
end
ret 0
end
ok = write_all int 1 msg_invalid_did
if not ok
ret 1
end
ret 1
end
if slice_eq part arg1 0 u1 cmd_diff
ret run_diff_stdin
end
ok = write_all int 1 msg_usage
if not ok
ret 1
end
ret 0
end

text t_ssh_short "ssh-ed25519 short"
text t_ssh_nopay "ssh-ed25519    "
text t_ssh_badch "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample!BadChar"
text t_radk_short "tinykey"

text t_anc_did "did:rad:aien:spark-01"
text t_anc_bad_did "http://not-a-did"
text t_anc_name "AIEN"
text t_json_expect_pfx "{\"anchor_did\":\"did:rad:aien:spark-01\",\"entity_name\":\"AIEN\",\"in_sync\":true,\"rotated\":false,\"key_history_len\":2"

text t_pass_prefix "PASS "
text t_fail_prefix "FAIL "
text t_nl "\n"

text t_n1 "sha256_vectors_and_fingerprint"
text t_n2 "rid_validation_positive_and_negative"
text t_n3 "did_validation_positive_and_negative"
text t_n4 "pubkey_format_validation"
text t_n5 "threshold_and_quorum_validation"
text t_n6 "doc_validation_and_dup_refusal"
text t_n7 "diff_sync_in_sync_and_authorized_rotation"
text t_n8 "diff_sync_refuses_unauthorized_extra_delegate"
text t_n9 "diff_sync_refuses_no_quorum_and_rid_mismatch"
text t_n10 "anchor_sync_rotation_and_json_report"
text t_summary "PASS rad-id-sync all 10 test suites passed\n"

fn report_case name view uchar * ok bool to int
if ok
w1 = write_all int 1 t_pass_prefix
w2 = write_all int 1 name
w3 = write_all int 1 t_nl
if and w1 and w2 w3
ret 0
end
ret 1
end
w4 = write_all int 1 t_fail_prefix
w5 = write_all int 1 name
w6 = write_all int 1 t_nl
if and w4 and w5 w6
ret 1
end
ret 1
end

fn test_sha256 to bool
h1 = new uchar 64 0
h2 = new uchar 64 0
h3 = new uchar 64 0
h4 = new uchar 64 0
sha256_hex part t_abc 0 0 h1
if not slice_eq h1 t_sha_empty
ret false
end
sha256_hex t_abc h2
if not slice_eq h2 t_sha_abc
ret false
end
key_fingerprint t_sample_ssh h3
if not slice_eq h3 t_sample_ssh_sha
ret false
end
key_fingerprint t_sample_ssh_pad h4
if not slice_eq h4 h3
ret false
end
ret true
end

fn test_rids to bool
if ne validate_rid t_rid_ok1 RAD_OK
ret false
end
if ne validate_rid t_rid_ok2 RAD_OK
ret false
end
if ne validate_rid t_rid_bad_pfx RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_bad_mb RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_short RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_zero RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_bigO RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_bigI RAD_ERR_BAD_RID
ret false
end
if ne validate_rid t_rid_sml RAD_ERR_BAD_RID
ret false
end
if ne validate_rid part t_rid_ok1 0 0 RAD_ERR_BAD_RID
ret false
end
ret true
end

fn test_dids to bool
if ne validate_delegate_did t_did_a RAD_OK
ret false
end
if ne validate_delegate_did t_did_b RAD_OK
ret false
end
if ne validate_delegate_did t_did_bad_pfx RAD_ERR_BAD_DID
ret false
end
if ne validate_delegate_did t_did_bad_mc RAD_ERR_BAD_DID
ret false
end
if ne validate_delegate_did t_did_bad_b58 RAD_ERR_BAD_DID
ret false
end
if ne validate_delegate_did t_did_short RAD_ERR_BAD_DID
ret false
end
if ne validate_delegate_did t_did_long RAD_ERR_BAD_DID
ret false
end
if ne validate_anchor_did t_anc_did RAD_OK
ret false
end
if ne validate_anchor_did t_did_a RAD_OK
ret false
end
if ne validate_anchor_did t_anc_bad_did RAD_ERR_BAD_DID
ret false
end
ret true
end

fn test_pubkeys to bool
if ne validate_ssh_ed25519 t_sample_ssh RAD_OK
ret false
end
if ne validate_ssh_ed25519 t_ssh_bad_pfx RAD_ERR_BAD_KEY
ret false
end
if ne validate_ssh_ed25519 t_ssh_short RAD_ERR_BAD_KEY
ret false
end
if ne validate_ssh_ed25519 t_ssh_nopay RAD_ERR_BAD_KEY
ret false
end
if ne validate_ssh_ed25519 t_ssh_badch RAD_ERR_BAD_KEY
ret false
end
if ne validate_radicle_key t_rid_ok2 RAD_OK
ret false
end
if ne validate_radicle_key t_did_a RAD_OK
ret false
end
if ne validate_radicle_key t_sample_ssh RAD_OK
ret false
end
if ne validate_radicle_key t_radk_short RAD_ERR_BAD_KEY
ret false
end
if ne validate_radicle_key part t_rid_ok2 0 0 RAD_ERR_BAD_KEY
ret false
end
ret true
end

fn test_quorum to bool
if ne check_quorum ulong 3 ulong 2 ulong 2 RAD_OK
ret false
end
if ne check_quorum ulong 3 ulong 2 ulong 3 RAD_OK
ret false
end
if ne check_quorum ulong 3 ulong 2 ulong 1 RAD_ERR_NO_QUORUM
ret false
end
if ne check_quorum ulong 3 ulong 0 ulong 2 RAD_ERR_BAD_THRESH
ret false
end
if ne check_quorum ulong 3 ulong 4 ulong 3 RAD_ERR_BAD_THRESH
ret false
end
if ne check_quorum ulong 0 ulong 1 ulong 1 RAD_ERR_BAD_THRESH
ret false
end
ret true
end

fn test_doc_validation to bool
base_doc_reset
rc = base_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
base_doc_set_threshold ulong 2
if ne validate_base_doc RAD_OK
ret false
end
note Duplicate delegate must be refused
rc = base_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
if ne validate_base_doc RAD_ERR_DUP_DEL
ret false
end
note Threshold exceeding delegate count must be refused
base_doc_reset
rc = base_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
base_doc_set_threshold ulong 2
if ne validate_base_doc RAD_ERR_BAD_THRESH
ret false
end
note Malformed RID in doc must be refused
base_doc_reset
rc = base_doc_set_rid t_rid_zero
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
base_doc_set_threshold ulong 1
if ne validate_base_doc RAD_ERR_BAD_RID
ret false
end
note Malformed DID in doc must be refused
base_doc_reset
rc = base_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_bad_b58
if ne rc RAD_OK
ret false
end
base_doc_set_threshold ulong 1
if ne validate_base_doc RAD_ERR_BAD_DID
ret false
end
ret true
end

fn setup_two_delegate_base to bool
base_doc_reset
rc = base_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = base_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
base_doc_set_threshold ulong 2
ret true
end

fn test_diff_positive to bool
diff = new RadDiff 0 0 0 0 0 0
if not setup_two_delegate_base
ret false
end
remote_doc_reset
rc = remote_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
remote_doc_set_threshold ulong 2
note Reordered identical delegates should be IN_SYNC with 0 approvals needed
rad_doc_diff_sync ulong 0 ulong 0 diff
if or ne get diff code RAD_OK ne get diff decision SYNC_IN_SYNC
ret false
end
if or ne get diff common ulong 2 or ne get diff added ulong 0 ne get diff removed ulong 0
ret false
end
note Authorized delegate rotation (replace did_b with did_c) with quorum=2 and allow_add=1
remote_doc_reset
rc = remote_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_c
if ne rc RAD_OK
ret false
end
remote_doc_set_threshold ulong 2
rad_doc_diff_sync ulong 2 ulong 1 diff
if or ne get diff code RAD_OK ne get diff decision SYNC_ROTATED
ret false
end
if or ne get diff added ulong 1 or ne get diff removed ulong 1 ne get diff common ulong 1
ret false
end
note Threshold-only update with quorum=2
remote_doc_reset
rc = remote_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
remote_doc_set_threshold ulong 1
rad_doc_diff_sync ulong 2 ulong 0 diff
if or ne get diff code RAD_OK ne get diff decision SYNC_UPDATE_OK
ret false
end
if ne get diff thresh_chg ulong 1
ret false
end
ret true
end

fn test_refuse_unauth_delegate to bool
diff = new RadDiff 0 0 0 0 0 0
if not setup_two_delegate_base
ret false
end
remote_doc_reset
r1 = remote_doc_set_rid t_rid_ok1
r2 = remote_doc_add_delegate t_did_a
r3 = remote_doc_add_delegate t_did_b
r4 = remote_doc_add_delegate t_did_d
remote_doc_set_threshold ulong 2
if or ne r1 RAD_OK or ne r2 RAD_OK or ne r3 RAD_OK ne r4 RAD_OK
ret false
end
note Unauthorized extra delegate when allow_add=0 must be REFUSED even with approvals=2
rad_doc_diff_sync ulong 2 ulong 0 diff
if ne get diff code RAD_ERR_UNAUTH_DEL
ret false
end
if ne get diff decision SYNC_REFUSED
ret false
end
if ne get diff added ulong 1
ret false
end
ret true
end

fn test_refuse_quorum_and_rid to bool
diff = new RadDiff 0 0 0 0 0 0
if not setup_two_delegate_base
ret false
end
remote_doc_reset
rc = remote_doc_set_rid t_rid_ok1
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_c
if ne rc RAD_OK
ret false
end
remote_doc_set_threshold ulong 2
note Adding delegate with allow_add=1 but approvals=1 < threshold=2 must refuse NO_QUORUM
rad_doc_diff_sync ulong 1 ulong 1 diff
if ne get diff code RAD_ERR_NO_QUORUM
ret false
end
if ne get diff decision SYNC_REFUSED
ret false
end
note Mismatched RID must refuse RID_MISMATCH
remote_doc_reset
rc = remote_doc_set_rid t_rid_other
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_a
if ne rc RAD_OK
ret false
end
rc = remote_doc_add_delegate t_did_b
if ne rc RAD_OK
ret false
end
remote_doc_set_threshold ulong 2
rad_doc_diff_sync ulong 2 ulong 1 diff
if ne get diff code RAD_ERR_RID_MISMATCH
ret false
end
if ne get diff decision SYNC_REFUSED
ret false
end
ret true
end

fn test_anchor_sync to bool
st = new AnchorSync 0 0 0 0 0 0
jbuf = new uchar 1024 0
anchor_init_default
rc = anchor_set_identity t_anc_did t_anc_name ENTITY_AGENT
if ne rc RAD_OK
ret false
end
note Initial key bind
anchor_sync_keys t_did_a t_sample_ssh st
if ne get st code RAD_OK
ret false
end
if ne get st in_sync ulong 1
ret false
end
if ne get st rotated ulong 0
ret false
end
if ne get st hist_n ulong 2
ret false
end
note Idempotent second sync: in_sync=1, rotated=0, hist_n unchanged
anchor_sync_keys t_did_a t_sample_ssh st
if ne get st code RAD_OK
ret false
end
if ne get st in_sync ulong 1
ret false
end
if ne get st rotated ulong 0
ret false
end
if ne get st hist_n ulong 2
ret false
end
jl = anchor_render_json st jbuf
if not slice_starts_with part jbuf 0 jl t_json_expect_pfx
ret false
end
note Rotate SSH key: rotated=1, ssh_chg=1, rad_chg=0, hist_n=3
anchor_sync_keys t_did_a t_ssh_rot st
if ne get st code RAD_OK
ret false
end
if ne get st rotated ulong 1
ret false
end
if ne get st ssh_chg ulong 1
ret false
end
if ne get st rad_chg ulong 0
ret false
end
if ne get st hist_n ulong 3
ret false
end
note Refusal on invalid SSH key
anchor_sync_keys t_did_a t_ssh_bad_pfx st
if ne get st code RAD_ERR_BAD_KEY
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_n1 test_sha256
fail = add fail report_case t_n2 test_rids
fail = add fail report_case t_n3 test_dids
fail = add fail report_case t_n4 test_pubkeys
fail = add fail report_case t_n5 test_quorum
fail = add fail report_case t_n6 test_doc_validation
fail = add fail report_case t_n7 test_diff_positive
fail = add fail report_case t_n8 test_refuse_unauth_delegate
fail = add fail report_case t_n9 test_refuse_quorum_and_rid
fail = add fail report_case t_n10 test_anchor_sync
if ne fail int 0
ret 1
end
ok = write_all int 1 t_summary
if not ok
ret 1
end
ret 0
end

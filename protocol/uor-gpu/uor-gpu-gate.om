note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/uor-gpu-gate.om: Pure seeded OM-2 self-verifying host gate for
note hologram:gpu/omega-om2@1 (UOR-GPU-1). Zero CUDApp, zero C/Python/shell.
note Run from the omega-mv repository root with pinned seed/out/omc.
note Exercises:
note   - RFC 8032 Ed25519 signing and verification vectors
note   - Single-source SM121 compilation directly from om/gpu/bw_vecadd.om + om/gpu/bw_qmd.om
note     via SHA-256-verified seed/out/omc (512B SASS cross-checked against OMEGA_BW_VECADD_EXPECTED_SHA256
note     + full 384B QMD v05.00 descriptor = 896B)
note   - Single-source SPIR-V 1.0 OpenCL Kernel compilation directly from gpu/spirv/emit.om
note   - Real P3 kernel VM replay executing the actual SM121 SASS+QMD v5 and SPIR-V binary bytes
note     over both in-bounds (0..7) and out-of-bounds (8..11) threads/work-items
note   - Local trust anchors, authority-signed capability grants, and 33 negative controls
note     (including QMD v5 SKEDCHECK05 mutants, SM121 SASS arithmetic/OOB/illegal-op mutants,
note     real SPIR-V emit.om `vadd cl mutant` OpFSub mutant, and unpinned omc refusal).
note The seeds below are derived from public tags: TEST ONLY, never a production key.
note Compose after si/directives/om2.om, om/tls/sha2.om, protocol/uor-gpu/b3_uor.om,
note protocol/omnet/om/sha512/sha512.om, protocol/omnet/om/ed25519/ed25519.om,
note protocol/uor-gpu/canonical.om, protocol/uor-gpu/payload_vm.om, protocol/uor-gpu/verify.om,
note protocol/uor-gpu/gate.om, protocol/uor-gpu/emit_kernels.om, protocol/uor-gpu/ed_sign.om.

text ug_pass_msg "UOR_GPU_GATE_PASS\n"
text ug_fail_msg "UOR_GPU_GATE_FAIL\n"
note RFC 8032 section 7.1 TEST 1 (empty message) and TEST 2 (one byte 0x72)
text ug_ed1_seed "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
text ug_ed1_pk "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
text ug_ed1_sg "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
text ug_ed2_seed "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
text ug_ed2_pk "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
text ug_ed2_sg "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
text ug_tag_signer "uor-gpu-gate:test-signer:v1"
text ug_tag_auth "uor-gpu-gate:test-authority:v1"
text ug_tag_rogue "uor-gpu-gate:test-rogue:v1"
text ug_bad_omc "protocol/uor-gpu/README.md"

fn ug_ed_vec seedhex view uchar 64 pkhex view uchar 64 sghex view uchar 128 m view uchar 65536 n ulong to ulong
  sd = new uchar 32 0
  pk = new uchar 32 0
  pk2 = new uchar 32 0
  sg = new uchar 64 0
  sg2 = new uchar 64 0
  ug_parse_hex32 seedhex sd
  ug_parse_hex32 pkhex pk
  ug_parse_hex64 sghex sg
  ues_pubkey sd pk2
  if eq uor_eq32 pk 0 pk2 0 0
    ret 0
  end
  ues_sign sd m n sg2
  diff = ulong 0
  for i ulong 64
    diff = or diff ulong xor get sg i get sg2 i
  end
  if ne diff 0
    ret 0
  end
  if eq edverify pk m n sg2 0 0
    ret 0
  end
  put sg2 0 xor get sg2 0 uchar 1
  if ne edverify pk m n sg2 0 0
    ret 0
  end
  ret 1
end

fn ug_selftest_ed to ulong
  m = new uchar 65536 0
  if eq ug_ed_vec ug_ed1_seed ug_ed1_pk ug_ed1_sg m 0 0
    ret 0
  end
  put m 0 uchar 0x72
  ret ug_ed_vec ug_ed2_seed ug_ed2_pk ug_ed2_sg m 1
end

fn ug_seeds sk edit uchar 96 to void
  t = new uchar 32 0
  a = sha2_digest 256 ug_tag_signer t
  for i ulong 32
    put sk i get t i
  end
  b = sha2_digest 256 ug_tag_auth t
  for i ulong 32
    put sk add 32 i get t i
  end
  c = sha2_digest 256 ug_tag_rogue t
  for i ulong 32
    put sk add 64 i get t i
  end
  if or ne a 32 or ne b 32 ne c 32
    trap 8
  end
end

fn ug_seed_at sk view uchar 96 off ulong dst edit uchar 32 to void
  for i ulong 32
    put dst i get sk add off i
  end
end

fn ug_make_anchors anc edit uchar 136 sk view uchar 96 to void
  sd = new uchar 32 0
  spk = new uchar 32 0
  apk = new uchar 32 0
  ug_seed_at sk 0 sd
  ues_pubkey sd spk
  ug_seed_at sk 32 sd
  ues_pubkey sd apk
  ug_build_anchors anc apk spk
end

fn ug_make_bundle hdr edit uchar 384 pay view uchar * sdig view uchar 32 seed view uchar 32 isa ulong to ulong
  rc = ug_fill_p3_hdr_real hdr isa pay sdig
  if ne rc UOR_VERDICT_PASS
    ret rc
  end
  uor_hdr_seal hdr pay
  ues_sign_hdr hdr seed
  ret UOR_VERDICT_PASS
end

fn ug_make_grant g edit uchar 168 seed view uchar 32 to void
  for i ulong 168
    put g i uchar 0
  end
  uor_put_u64 g 0 1
  uor_put_u64 g 8 42
  uor_put_u64 g 16 1
  uor_put_u64 g 24 1000
  uor_put_u64 g 32 7
  uor_put_u64 g 40 0x4152425247423130
  uor_put_u64 g 48 4
  uor_put_u64 g 128 42
  uor_put_u64 g 136 1
  uor_put_u64 g 144 100
  uor_put_u64 g 152 7
  uor_put_u64 g 160 0x4152425247423130
  ues_sign_grant g seed
end

note Positive: exact OMEGA_BW_VECADD_EXPECTED_SHA256 match, deterministic build, P0/P2/P3,
note real SM121 SASS+QMD v5 replay, and authority-signed grant admission.
fn ug_check_positive hdr view uchar 384 pay view uchar * sdig view uchar 32 anc view uchar 136 sk view uchar 96 to ulong
  h2 = new uchar 384 0
  sd = new uchar 32 0
  g = new uchar 168 0
  sass_dig = new uchar 32 0
  sass_exp = new uchar 32 0
  d = sha2_digest 256 part pay 0 UOR_SM121_CODE_BYTES sass_dig
  if ne d 32
    ret 2
  end
  ug_parse_hex32 ug_vecadd_sass_hex sass_exp
  if eq uor_eq32 sass_dig 0 sass_exp 0 0
    ret 2
  end
  ug_seed_at sk 0 sd
  if ne ug_make_bundle h2 pay sdig sd UOR_GPU_ISA_SM121 UOR_VERDICT_PASS
    ret 2
  end
  for i ulong 384
    if ne get hdr i get h2 i
      ret 2
    end
  end
  if ne uor_verify_policy hdr pay anc UOR_LVL_P0 UOR_VERDICT_PASS
    ret 3
  end
  if ne uor_verify_policy hdr pay anc UOR_LVL_P2 UOR_VERDICT_PASS
    ret 4
  end
  if ne uor_verify_policy hdr pay anc UOR_LVL_P3 UOR_VERDICT_PASS
    ret 5
  end
  if ne uor_verify_replay_real hdr pay UOR_VERDICT_PASS
    ret 6
  end
  ug_seed_at sk 32 sd
  ug_make_grant g sd
  if ne uor_gpu_admit hdr pay anc g UOR_VERDICT_PASS
    ret 8
  end
  ret 0
end

note Compile real SPIR-V 1.0 OpenCL vadd from gpu/spirv/emit.om, run P3 policy + real SPIR-V VM replay,
note then compile the real `vadd cl mutant` (OpFSub), seal+sign it, and verify real replay catches it!
fn ug_check_spirv anc view uchar * sk view uchar 96 to ulong
  h = new uchar 384 0
  pay = new uchar 65536 0
  plen = new ulong 1 0
  sdig = new uchar 32 0
  sd = new uchar 32 0
  ug_seed_at sk 0 sd
  if eq ug_compile_spirv ug_default_omc 0 pay plen sdig 0
    ret 7
  end
  n = get plen 0
  if ne ug_make_bundle h part pay 0 n sdig sd UOR_GPU_ISA_SPIRV UOR_VERDICT_PASS
    ret 7
  end
  if ne uor_verify_policy h part pay 0 n anc UOR_LVL_P3 UOR_VERDICT_PASS
    ret 7
  end
  if ne uor_verify_replay_real h part pay 0 n UOR_VERDICT_PASS
    ret 9
  end
  note Negative control: corrupt SPIR-V magic (resealed + re-signed) -> UOR_ERR_BAD_SPIRV
  put pay 0 uchar 0
  uor_hdr_seal h part pay 0 n
  ues_sign_hdr h sd
  if ne uor_verify_policy h part pay 0 n anc UOR_LVL_P2 UOR_ERR_BAD_SPIRV
    ret 57
  end
  note Negative control: compile real `gpu/spirv/emit.om vadd cl mutant` (OpFSub instead of OpFAdd),
  note seal + sign with trusted key -> P2 passes, real SPIR-V VM replay MUST refuse (UOR_ERR_REPLAY_MISMATCH)!
  if eq ug_compile_spirv ug_default_omc 1 pay plen sdig 0
    ret 58
  end
  n = get plen 0
  if ne ug_make_bundle h part pay 0 n sdig sd UOR_GPU_ISA_SPIRV UOR_VERDICT_PASS
    ret 58
  end
  if ne uor_verify_policy h part pay 0 n anc UOR_LVL_P2 UOR_VERDICT_PASS
    ret 58
  end
  if ne uor_verify_replay_real h part pay 0 n UOR_ERR_REPLAY_MISMATCH
    ret 59
  end
  ret 0
end

note Integrity and pin refusals.
fn ug_neg_integrity hdr view uchar 384 pay view uchar * anc view uchar * to ulong
  thdr = new uchar 384 0
  tpay = new uchar 896 0
  ac = new uchar 136 0
  for i ulong 384
    put thdr i get hdr i
  end
  for i ulong UOR_SM121_PAYLOAD_BYTES
    put tpay i get pay i
  end
  for i ulong 136
    put ac i get anc i
  end
  note 1-byte payload tamper
  put tpay 17 xor get tpay 17 uchar 1
  if ne uor_verify_policy thdr tpay ac UOR_LVL_P2 UOR_ERR_PAYLOAD_TAMPER
    ret 11
  end
  put tpay 17 get pay 17
  note 1-byte math contract tamper
  put thdr 16 uchar 2
  if ne uor_verify_policy thdr tpay ac UOR_LVL_P2 UOR_ERR_UOR_ID_TAMPER
    ret 12
  end
  put thdr 16 get hdr 16
  note 1-byte .holo seal tamper
  put thdr 256 xor get thdr 256 uchar 1
  if ne uor_verify_policy thdr tpay ac UOR_LVL_P2 UOR_ERR_HOLO_TAMPER
    ret 13
  end
  put thdr 256 get hdr 256
  note missing Lean 4 proof digest (resealed)
  for i ulong 32
    put thdr add 128 i uchar 0
  end
  uor_hdr_seal thdr tpay
  if ne uor_verify_policy thdr tpay ac UOR_LVL_P2 UOR_ERR_NO_LEAN_PROOF
    ret 14
  end
  note non-zero but unpinned Lean 4 proof digest (resealed)
  for i ulong 32
    put thdr add 128 i get hdr add 128 i
  end
  put thdr 130 xor get thdr 130 uchar 1
  uor_hdr_seal thdr tpay
  if ne uor_verify_policy thdr tpay ac UOR_LVL_P2 UOR_ERR_LEAN_UNPINNED
    ret 15
  end
  note omc pin differs from the verifier's anchor
  put ac 8 xor get ac 8 uchar 0xff
  if ne uor_verify_policy hdr pay ac UOR_LVL_P2 UOR_ERR_OMC_PIN
    ret 16
  end
  note unpinned omc binary refused by compiler pin check
  if ne ug_check_omc_pin ug_bad_omc len ug_bad_omc 0
    ret 17
  end
  ret 0
end

note Signature and level refusals ("Nothing raises a level except signing").
fn ug_neg_sig hdr view uchar 384 pay view uchar * anc view uchar * sk view uchar 96 to ulong
  thdr = new uchar 384 0
  rs = new uchar 32 0
  for i ulong 384
    put thdr i get hdr i
  end
  note forged 1-bit signature
  put thdr 320 xor get thdr 320 uchar 1
  if ne uor_verify_policy thdr pay anc UOR_LVL_P2 UOR_ERR_BAD_SIG
    ret 21
  end
  put thdr 320 get hdr 320
  note valid signature by a key the verifier does not trust
  ug_seed_at sk 64 rs
  ues_sign_hdr thdr rs
  if ne uor_verify_policy thdr pay anc UOR_LVL_P0 UOR_ERR_UNTRUSTED_SIGNER
    ret 22
  end
  note unsigned bundle at P2
  for i ulong 32
    put thdr add 288 i uchar 0
  end
  if ne uor_verify_policy thdr pay anc UOR_LVL_P2 UOR_ERR_BAD_SIG
    ret 23
  end
  note unsigned bundle whose header claims P3, checked at P0
  for i ulong 64
    put thdr add 320 i uchar 0
  end
  if ne uor_verify_policy thdr pay anc UOR_LVL_P0 UOR_ERR_UNSIGNED_LEVEL
    ret 24
  end
  note unsigned P0 claim with smuggled signature bytes
  uor_put_u32 thdr 20 UOR_LVL_P0
  uor_hdr_seal thdr pay
  put thdr 350 uchar 1
  if ne uor_verify_policy thdr pay anc UOR_LVL_P0 UOR_ERR_BAD_SIG
    ret 25
  end
  note clean unsigned P0 claim passes P0 only
  put thdr 350 uchar 0
  if ne uor_verify_policy thdr pay anc UOR_LVL_P0 UOR_VERDICT_PASS
    ret 26
  end
  if ne uor_verify_policy thdr pay anc UOR_LVL_P1 UOR_ERR_LEVEL_LOW
    ret 27
  end
  note replay digest mismatch (corrupted hdr.replay_sha256)
  for i ulong 384
    put thdr i get hdr i
  end
  put thdr 160 xor get thdr 160 uchar 1
  if ne uor_verify_replay_real thdr pay UOR_ERR_REPLAY_MISMATCH
    ret 28
  end
  ret 0
end

note F5 negative controls: QMD v5 SKEDCHECK05 mutants and real SM121 SASS execution mutants
note (each resealed and re-signed with the trusted signer key so only QMD/replay catches them!).
fn ug_neg_sm121_f5 hdr view uchar 384 pay view uchar * anc view uchar * sk view uchar 96 to ulong
  thdr = new uchar 384 0
  tpay = new uchar 896 0
  sd = new uchar 32 0
  ug_seed_at sk 0 sd
  for i ulong 384
    put thdr i get hdr i
  end
  for i ulong UOR_SM121_PAYLOAD_BYTES
    put tpay i get pay i
  end
  note 1. QMD v5 version mutant: word 14 version 5 -> 4
  sv = uvm_qmd_w tpay 14
  uor_put_u32 tpay 568 xor sv 0x00100000
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_policy thdr tpay anc UOR_LVL_P2 UOR_ERR_BAD_QMD
    ret 51
  end
  uor_put_u32 tpay 568 sv
  note 2. QMD v5 SKEDCHECK05 mutant: word 37 != 0
  uor_put_u32 tpay 660 1
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_policy thdr tpay anc UOR_LVL_P2 UOR_ERR_BAD_QMD
    ret 52
  end
  uor_put_u32 tpay 660 0
  note 3. QMD v5 launch geometry mismatch: threads_x (word 34) != hdr.block_x
  sv = uvm_qmd_w tpay 34
  uor_put_u32 tpay 648 or and sv 0xffff0000 128
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_policy thdr tpay anc UOR_LVL_P2 UOR_ERR_BAD_QMD
    ret 53
  end
  uor_put_u32 tpay 648 sv
  note 4. SM121 SASS arithmetic mutant: IADD3 R9, R2, R5 -> IADD3 R9, R2, R2 (w1 5 -> 2)
  note    Resealed and re-signed with trusted key: P2 passes, real SASS VM replay MUST refuse!
  uor_put_u32 tpay 276 2
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_policy thdr tpay anc UOR_LVL_P2 UOR_VERDICT_PASS
    ret 54
  end
  if ne uor_verify_replay_real thdr tpay UOR_ERR_REPLAY_MISMATCH
    ret 54
  end
  uor_put_u32 tpay 276 5
  note 5. SM121 SASS OOB guard mutant: replace `@P0 EXIT` (insn 7) with `NOP` (0x00007918)
  note    Resealed and re-signed: OOB threads 8..11 fall through and fault on OOB LDG/STG!
  sv = uor_get_u32 tpay 112
  uor_put_u32 tpay 112 0x00007918
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_replay_real thdr tpay UOR_ERR_REPLAY_FAULT
    ret 55
  end
  uor_put_u32 tpay 112 sv
  note 6. SM121 SASS illegal opcode mutant: insn 17 opcode -> 0xfff
  sv = uor_get_u32 tpay 272
  uor_put_u32 tpay 272 or and sv 0xfffff000 0xfff
  uor_hdr_seal thdr tpay
  ues_sign_hdr thdr sd
  if ne uor_verify_replay_real thdr tpay UOR_ERR_REPLAY_FAULT
    ret 56
  end
  ret 0
end

note Capability grant refusals; each altered record is re-signed by the authority unless noted.
fn ug_neg_grant hdr view uchar 384 pay view uchar * anc view uchar * sk view uchar 96 to ulong
  g = new uchar 168 0
  asd = new uchar 32 0
  ssd = new uchar 32 0
  ac = new uchar 136 0
  ug_seed_at sk 32 asd
  ug_seed_at sk 0 ssd
  ug_make_grant g asd
  uor_put_u64 g 0 2
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 31
  end
  ug_make_grant g asd
  uor_put_u64 g 40 0xdeadbeef
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 32
  end
  ug_make_grant g asd
  uor_put_u64 g 24 50
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 33
  end
  ug_make_grant g asd
  uor_put_u64 g 8 0
  uor_put_u64 g 128 0
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 34
  end
  ug_make_grant g asd
  uor_put_u64 g 24 0
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 35
  end
  ug_make_grant g asd
  uor_put_u64 g 48 1
  ues_sign_grant g asd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_CAP_DENIED
    ret 36
  end
  ug_make_grant g asd
  uor_put_u64 g 24 0xffffffff
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_BAD_GRANT
    ret 37
  end
  ug_make_grant g ssd
  if ne uor_gpu_admit hdr pay anc g UOR_ERR_BAD_GRANT
    ret 38
  end
  ug_make_grant g asd
  for i ulong 136
    put ac i get anc i
  end
  for i ulong 32
    put ac add UOR_ANCH_AUTH i uchar 0
  end
  if ne uor_gpu_admit hdr pay ac g UOR_ERR_BAD_GRANT
    ret 39
  end
  ret 0
end

note Malformed local trust anchors.
fn ug_neg_anchors hdr view uchar 384 pay view uchar * anc view uchar * to ulong
  ac = new uchar 136 0
  for i ulong 136
    put ac i get anc i
  end
  put ac 0 uchar 88
  if ne uor_verify_policy hdr pay ac UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 41
  end
  put ac 0 get anc 0
  for i ulong 32
    put ac add UOR_ANCH_AUTH i get anc add UOR_ANCH_KEYS i
  end
  if ne uor_verify_policy hdr pay ac UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 42
  end
  for i ulong 32
    put ac add UOR_ANCH_AUTH i get anc add UOR_ANCH_AUTH i
    put ac add UOR_ANCH_KEYS i uchar 0
  end
  if ne uor_verify_policy hdr pay ac UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 43
  end
  for i ulong 32
    put ac add UOR_ANCH_KEYS i get anc add UOR_ANCH_KEYS i
  end
  if ne uor_verify_policy hdr pay part ac 0 104 UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 44
  end
  if ne uor_verify_policy hdr pay part ac 0 135 UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 45
  end
  for i ulong 32
    put ac add UOR_ANCH_LEAN i uchar 0
  end
  if ne uor_verify_policy hdr pay ac UOR_LVL_P2 UOR_ERR_BAD_ANCHORS
    ret 46
  end
  ret 0
end

fn ug_fail rc ulong to int
  uor_write_all 2 ug_fail_msg len ug_fail_msg
  ret int rc
end

fn main to int
  sk = new uchar 96 0
  anc = new uchar 136 0
  sm_raw = new uchar 65536 0
  sm_len = new ulong 1 0
  sdig = new uchar 32 0
  hdr1 = new uchar 384 0
  sd = new uchar 32 0
  if eq ug_selftest_ed 0
    ret ug_fail 1
  end
  ug_seeds sk
  ug_make_anchors anc sk
  if eq ug_compile_sm121 ug_default_omc sm_raw sm_len sdig 0
    ret ug_fail 50
  end
  if ne get sm_len 0 UOR_SM121_PAYLOAD_BYTES
    ret ug_fail 50
  end
  ug_seed_at sk 0 sd
  if ne ug_make_bundle hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES sdig sd UOR_GPU_ISA_SM121 UOR_VERDICT_PASS
    ret ug_fail 50
  end
  rc = ug_check_positive hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES sdig anc sk
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_check_spirv anc sk
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_neg_integrity hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES anc
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_neg_sig hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES anc sk
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_neg_sm121_f5 hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES anc sk
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_neg_grant hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES anc sk
  if ne rc 0
    ret ug_fail rc
  end
  rc = ug_neg_anchors hdr1 part sm_raw 0 UOR_SM121_PAYLOAD_BYTES anc
  if ne rc 0
    ret ug_fail rc
  end
  uor_emit_verdict hdr1 UOR_VERDICT_PASS UOR_LVL_P3
  uor_write_all 1 ug_pass_msg len ug_pass_msg
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/uor-gpu-gate.om: Pure seeded OM-2 self-verifying gate for
note hologram:gpu/omega-om2@1 (UOR-GPU-1). Zero CUDApp, zero C/Python/shell.
note Compose after si/directives/om2.om, om/tls/sha2.om, om/blake3/b3unit.om,
note protocol/uor-gpu/canonical.om, protocol/uor-gpu/verify.om, protocol/uor-gpu/gate.om.

text ug_omc_hex "708fdc0f81866594ed6df2f492b7a8a6bc7456f2d733a838b7f840549ebba6c3"
text ug_lean_hex "dd02ced0700c63578c913dcf59989a3e475427a3b435c5505c50db2d3ba7a25d"
text ug_src_tag "hologram:gpu/omega-om2@1:vecadd:v1"
text ug_pass_msg "UOR_GPU_GATE_PASS\n"
text ug_fail_msg "UOR_GPU_GATE_FAIL\n"

fn ug_hex_nib c uchar to ulong
  v = ulong c
  if and ge v 48 le v 57
    ret sub v 48
  end
  ret add 10 sub v 97
end

fn ug_parse_hex32 hx view uchar 64 dst edit uchar 32 to void
  for i ulong 32
    hi = ug_hex_nib get hx mul i 2
    lo = ug_hex_nib get hx add mul i 2 1
    put dst i uchar or shl hi 4 lo
  end
end

note Emit canonical 512-byte Blackwell SM121 vecadd machine code (om/gpu/bw_vecadd.om).
fn ug_emit_w buf edit uchar 512 idx ulong w0 ulong w1 ulong w2 ulong w3 ulong to void
  b = mul idx 16
  uor_put_u32 buf b w0
  uor_put_u32 buf add b 4 w1
  uor_put_u32 buf add b 8 w2
  uor_put_u32 buf add b 12 w3
end

fn ug_emit_sm121_vecadd buf edit uchar 512 to void
  ug_emit_w buf 0 0xff017b82 0x0000df00 0x00000800 0x000fe200
  ug_emit_w buf 1 0x00097919 0x00000000 0x00002500 0x000e2200
  ug_emit_w buf 2 0xff0477ac 0x00006c00 0x08000800 0x000e2200
  ug_emit_w buf 3 0x00007919 0x00000000 0x00002100 0x000e2200
  ug_emit_w buf 4 0xff0577ac 0x00007300 0x08000800 0x000e6200
  ug_emit_w buf 5 0x09097c24 0x00000004 0x0f8e0200 0x001fca00
  ug_emit_w buf 6 0x09007c0c 0x00000005 0x0bf06070 0x002fda00
  ug_emit_w buf 7 0x0000094d 0x00000000 0x03800000 0x000fea00
  ug_emit_w buf 8 0xff027b82 0x0000e000 0x00000a00 0x000e2200
  ug_emit_w buf 9 0xff0477ac 0x00006b00 0x08000a00 0x000e6e00
  ug_emit_w buf 10 0xff047b82 0x0000e200 0x00000a00 0x000eb000
  ug_emit_w buf 11 0xff067b82 0x0000e400 0x00000a00 0x000ee200
  ug_emit_w buf 12 0x09027825 0x00000004 0x078e0002 0x001fcc00
  ug_emit_w buf 13 0x02027981 0x00000004 0x0c1e1900 0x002f2200
  ug_emit_w buf 14 0x09047825 0x00000004 0x078e0004 0x004fcc00
  ug_emit_w buf 15 0x04057981 0x00000004 0x0c1e1900 0x000f2200
  ug_emit_w buf 16 0x09067825 0x00000004 0x078e0006 0x008fe200
  ug_emit_w buf 17 0x02097210 0x00000005 0x07ffe0ff 0x010fca00
  ug_emit_w buf 18 0x06007986 0x00000009 0x0c101904 0x000fe200
  ug_emit_w buf 19 0x0000794d 0x00000000 0x03800000 0x000fea00
  ug_emit_w buf 20 0x00fc7947 0xfffffffc 0x0383ffff 0x000fc000
  i = ulong 21
  while lt i 32 bound 16
    ug_emit_w buf i 0x00007918 0x00000000 0x00000000 0x000fc000
    i = add i 1
  end
end

note Emit minimal canonical SPIR-V 1.0 header + capability words (32 bytes).
fn ug_emit_spirv_stub buf edit uchar 32 to void
  uor_put_u32 buf 0 0x07230203
  uor_put_u32 buf 4 0x00010000
  uor_put_u32 buf 8 0x00000000
  uor_put_u32 buf 12 0x00000008
  uor_put_u32 buf 16 0x00000000
  uor_put_u32 buf 20 0x00020011
  uor_put_u32 buf 24 0x00000006
  uor_put_u32 buf 28 0x00010000
end

note Pure OM-2 CPU reference oracle for vecadd golden replay vector (4 x u32).
fn ug_replay_digest dst32 edit uchar 32 to void
  vec = new uchar 16 0
  for i ulong 4
    a = add mul i 3 10
    b = add mul i 5 20
    uor_put_u32 vec mul i 4 add a b
  end
  d = sha2_digest 256 vec dst32
  if ne d 32
    trap 8
  end
end

fn ug_check_negatives hdr view uchar 256 pay view uchar 512 omc_pin view uchar 32 cap_ent view ulong 8 cap_req view ulong 5 to ulong
  thdr = new uchar 256 0
  tpay = new uchar 512 0
  bad_pin = new uchar 32 0
  bad_cap = new ulong 8 0
  for i ulong 256
    put thdr i get hdr i
  end
  for i ulong 512
    put tpay i get pay i
  end
  note 1. 1-byte payload tamper -> UOR_ERR_PAYLOAD_TAMPER
  put tpay 17 xor get tpay 17 uchar 1
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_PAYLOAD_TAMPER
    ret 11
  end
  put tpay 17 get pay 17
  note 2. 1-byte math contract tamper -> UOR_ERR_UOR_ID_TAMPER
  put thdr 16 uchar 2
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_UOR_ID_TAMPER
    ret 12
  end
  put thdr 16 get hdr 16
  note 3. 1-byte .holo BLAKE3 seal tamper -> UOR_ERR_HOLO_TAMPER
  put thdr 224 xor get thdr 224 uchar 1
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_HOLO_TAMPER
    ret 13
  end
  put thdr 224 get hdr 224
  note 4. Missing Lean 4 proof (all-zero) under mandatory P2 -> UOR_ERR_NO_LEAN_PROOF
  for i ulong 32
    put thdr add 128 i uchar 0
  end
  uor_hdr_seal thdr tpay
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_NO_LEAN_PROOF
    ret 14
  end
  for i ulong 256
    put thdr i get hdr i
  end
  note 5. Wrong omc pin -> UOR_ERR_OMC_PIN
  for i ulong 32
    put bad_pin i get omc_pin i
  end
  put bad_pin 0 xor get bad_pin 0 uchar 0xff
  if ne uor_verify_policy thdr tpay bad_pin UOR_LVL_P2 UOR_ERR_OMC_PIN
    ret 15
  end
  note 6. Revoked capability -> UOR_ERR_CAP_DENIED
  for i ulong 8
    put bad_cap i get cap_ent i
  end
  put bad_cap 0 2
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 16
  end
  note 7. Wrong GPU resource -> UOR_ERR_CAP_DENIED
  put bad_cap 0 1
  put bad_cap 5 0xdeadbeef
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 17
  end
  note 8. Expired capability -> UOR_ERR_CAP_DENIED
  put bad_cap 5 get cap_ent 5
  put bad_cap 3 50
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 18
  end
  ret 0
end

fn main to int
  omc_pin = new uchar 32 0
  lean_dig = new uchar 32 0
  src_dig = new uchar 32 0
  rep_dig = new uchar 32 0
  sm_pay = new uchar 512 0
  sp_pay = new uchar 32 0
  hdr1 = new uchar 256 0
  hdr2 = new uchar 256 0
  meta = new ulong 5 0
  cap_ent = new ulong 8 0
  cap_req = new ulong 5 0

  ug_parse_hex32 ug_omc_hex omc_pin
  ug_parse_hex32 ug_lean_hex lean_dig
  sd = sha2_digest 256 ug_src_tag src_dig
  if ne sd 32
    ret 1
  end
  ug_replay_digest rep_dig
  ug_emit_sm121_vecadd sm_pay
  ug_emit_spirv_stub sp_pay

  note Build & seal SM121 P3 bundle twice -> assert deterministic UOR SHA-256 + .holo BLAKE3
  put meta 0 UOR_GPU_ISA_SM121
  put meta 1 UOR_GPU_MATH_RN
  put meta 2 UOR_LVL_P3
  put meta 3 512
  put meta 4 256
  uor_hdr_write_meta hdr1 meta
  uor_copy32 hdr1 32 omc_pin 0
  uor_copy32 hdr1 64 src_dig 0
  uor_copy32 hdr1 128 lean_dig 0
  uor_copy32 hdr1 160 rep_dig 0
  uor_hdr_seal hdr1 sm_pay

  uor_hdr_write_meta hdr2 meta
  uor_copy32 hdr2 32 omc_pin 0
  uor_copy32 hdr2 64 src_dig 0
  uor_copy32 hdr2 128 lean_dig 0
  uor_copy32 hdr2 160 rep_dig 0
  uor_hdr_seal hdr2 sm_pay

  if eq uor_eq32 hdr1 192 hdr2 192 0
    ret 2
  end
  if eq uor_eq32 hdr1 224 hdr2 224 0
    ret 3
  end

  note Verify SM121 P3 under P2 & P3 policies
  if ne uor_verify_policy hdr1 sm_pay omc_pin UOR_LVL_P2 UOR_VERDICT_PASS
    ret 4
  end
  if ne uor_verify_policy hdr1 sm_pay omc_pin UOR_LVL_P3 UOR_VERDICT_PASS
    ret 5
  end

  note Verify SPIR-V P2 bundle (portable target)
  put meta 0 UOR_GPU_ISA_SPIRV
  put meta 2 UOR_LVL_P2
  put meta 3 32
  uor_hdr_write_meta hdr2 meta
  uor_copy32 hdr2 32 omc_pin 0
  uor_copy32 hdr2 64 src_dig 0
  uor_copy32 hdr2 128 lean_dig 0
  for i ulong 32
    put hdr2 add 160 i uchar 0
  end
  uor_hdr_seal hdr2 sp_pay
  if ne uor_verify_policy hdr2 sp_pay omc_pin UOR_LVL_P2 UOR_VERDICT_PASS
    ret 6
  end
  if ne uor_verify_policy hdr2 sp_pay omc_pin UOR_LVL_P3 UOR_ERR_LEVEL_LOW
    ret 7
  end

  note Positive admission with live RX_RIGHT_EFFECT capability
  put cap_ent 0 1
  put cap_ent 1 42
  put cap_ent 2 1
  put cap_ent 3 1000
  put cap_ent 4 7
  put cap_ent 5 0x4152425247423130
  put cap_ent 6 4
  put cap_req 0 42
  put cap_req 1 1
  put cap_req 2 100
  put cap_req 3 7
  put cap_req 4 0x4152425247423130
  if ne uor_gpu_admit hdr1 sm_pay omc_pin cap_ent cap_req UOR_VERDICT_PASS
    ret 8
  end

  note Run all 8 negative controls
  nrc = ug_check_negatives hdr1 sm_pay omc_pin cap_ent cap_req
  if ne nrc 0
    uor_write_all 2 ug_fail_msg len ug_fail_msg
    ret int nrc
  end

  uor_emit_verdict hdr1 UOR_VERDICT_PASS
  uor_write_all 1 ug_pass_msg len ug_pass_msg
  ret 0
end

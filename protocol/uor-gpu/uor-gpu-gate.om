note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/uor-gpu-gate.om: Pure seeded OM-2 self-verifying gate for
note hologram:gpu/omega-om2@1 (UOR-GPU-1). Zero CUDApp, zero C/Python/shell.
note Exercises SM121 (SASS+QMD), SPIR-V, ML-BOM, deterministic SHA-256+BLAKE3,
note mandatory Lean 4 P2 proof, P3 CPU-oracle replay, RFC 8032 Ed25519 signature
note refusal/verification, and capability admission negative controls.
note Compose after si/directives/om2.om, om/tls/sha2.om, protocol/uor-gpu/b3_uor.om,
note protocol/omnet/om/sha512/sha512.om, protocol/omnet/om/ed25519/ed25519.om,
note protocol/uor-gpu/canonical.om, protocol/uor-gpu/verify.om, protocol/uor-gpu/gate.om,
note protocol/uor-gpu/emit_kernels.om.

text ug_pass_msg "UOR_GPU_GATE_PASS\n"
text ug_fail_msg "UOR_GPU_GATE_FAIL\n"
note RFC 8032 section 7.1 test vector 1 (public key, empty message, valid signature)
text ug_ed_pk_rfc "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
text ug_ed_sg_rfc "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

fn ug_check_ed25519_rfc to ulong
  pk = new uchar 32 0
  sig = new uchar 64 0
  msg = new uchar 65536 0
  ug_parse_hex32 ug_ed_pk_rfc pk
  ug_parse_hex64 ug_ed_sg_rfc sig
  if eq edverify pk msg 0 sig 0 0
    ret 0
  end
  put sig 0 xor get sig 0 uchar 1
  if ne edverify pk msg 0 sig 0 0
    ret 0
  end
  ret 1
end

fn ug_check_negatives hdr view uchar 384 pay view uchar 768 omc_pin view uchar 32 cap_ent view ulong 8 cap_req view ulong 5 to ulong
  thdr = new uchar 384 0
  tpay = new uchar 768 0
  bad_pin = new uchar 32 0
  bad_rep = new uchar 32 0
  bad_cap = new ulong 8 0
  for i ulong 384
    put thdr i get hdr i
  end
  for i ulong 768
    put tpay i get pay i
  end
  note 1. 1-byte payload tamper -> UOR_ERR_PAYLOAD_TAMPER
  put tpay 17 xor get tpay 17 uchar 1
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_PAYLOAD_TAMPER
    ret 11
  end
  put tpay 17 get pay 17
  note 2. 1-byte math contract tamper -> UOR_ERR_UOR_ID_TAMPER
  put thdr 16 uchar 2
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_UOR_ID_TAMPER
    ret 12
  end
  put thdr 16 get hdr 16
  note 3. 1-byte .holo BLAKE3 seal tamper -> UOR_ERR_HOLO_TAMPER
  put thdr 256 xor get thdr 256 uchar 1
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_HOLO_TAMPER
    ret 13
  end
  put thdr 256 get hdr 256
  note 4. Missing Lean 4 proof under mandatory P2 -> UOR_ERR_NO_LEAN_PROOF
  for i ulong 32
    put thdr add 128 i uchar 0
  end
  uor_hdr_seal thdr tpay
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_NO_LEAN_PROOF
    ret 14
  end
  for i ulong 384
    put thdr i get hdr i
  end
  note 5. Wrong omc pin -> UOR_ERR_OMC_PIN
  for i ulong 32
    put bad_pin i get omc_pin i
  end
  put bad_pin 0 xor get bad_pin 0 uchar 0xff
  if ne uor_verify_policy thdr tpay bad_pin UOR_LVL_P2 UOR_ERR_OMC_PIN
    ret 15
  end
  note 6. Revoked capability -> UOR_ERR_CAP_DENIED
  for i ulong 8
    put bad_cap i get cap_ent i
  end
  put bad_cap 0 2
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 16
  end
  note 7. Wrong GPU resource -> UOR_ERR_CAP_DENIED
  put bad_cap 0 1
  put bad_cap 5 0xdeadbeef
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 17
  end
  note 8. Expired capability -> UOR_ERR_CAP_DENIED
  put bad_cap 5 get cap_ent 5
  put bad_cap 3 50
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 18
  end
  note 9. Forged 1-bit Ed25519 signature -> UOR_ERR_BAD_SIG
  put thdr 320 xor get thdr 320 uchar 1
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_BAD_SIG
    ret 19
  end
  for i ulong 384
    put thdr i get hdr i
  end
  note 10. Unsigned bundle claiming P2 ("Nothing raises a level except signing") -> UOR_ERR_BAD_SIG
  for i ulong 32
    put thdr add 288 i uchar 0
  end
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P2 UOR_ERR_BAD_SIG
    ret 20
  end
  note Unsigned bundle with non-zero smuggled sig bytes MUST be refused even at P0
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P0 UOR_ERR_BAD_SIG
    ret 21
  end
  note Clean unsigned bundle (zero pubkey + zero sig) IS allowed at P0 (digest-only)
  for i ulong 64
    put thdr add 320 i uchar 0
  end
  if ne uor_verify_policy thdr tpay omc_pin UOR_LVL_P0 UOR_VERDICT_PASS
    ret 23
  end
  for i ulong 384
    put thdr i get hdr i
  end
  note 11. Replay digest mismatch -> UOR_ERR_REPLAY_MISMATCH
  ug_replay_digest bad_rep
  put bad_rep 0 xor get bad_rep 0 uchar 1
  if ne uor_verify_replay thdr bad_rep UOR_ERR_REPLAY_MISMATCH
    ret 22
  end
  note 12. Zero-generation capability -> UOR_ERR_CAP_DENIED
  for i ulong 8
    put bad_cap i get cap_ent i
  end
  put bad_cap 1 0
  if ne uor_gpu_admit thdr tpay omc_pin bad_cap cap_req UOR_ERR_CAP_DENIED
    ret 24
  end
  ret 0
end

fn main to int
  omc_pin = new uchar 32 0
  rep_exp = new uchar 32 0
  sm_pay = new uchar 768 0
  sp_pay = new uchar 64 0
  hdr1 = new uchar 384 0
  hdr2 = new uchar 384 0
  cap_ent = new ulong 8 0
  cap_req = new ulong 5 0

  if eq ug_check_ed25519_rfc 0
    ret 1
  end
  ug_parse_hex32 ug_omc_hex omc_pin
  ug_replay_digest rep_exp
  ug_emit_sm121_vecadd_qmd sm_pay
  ug_emit_spirv_vadd sp_pay

  note Build, seal & sign SM121 (SASS+QMD) P3 bundle twice -> deterministic UOR SHA-256 + .holo BLAKE3
  ug_fill_p3_hdr hdr1 UOR_GPU_ISA_SM121 768
  uor_hdr_seal hdr1 sm_pay
  ug_attach_test_sig hdr1 UOR_GPU_ISA_SM121
  ug_fill_p3_hdr hdr2 UOR_GPU_ISA_SM121 768
  uor_hdr_seal hdr2 sm_pay
  ug_attach_test_sig hdr2 UOR_GPU_ISA_SM121
  if eq uor_eq32 hdr1 224 hdr2 224 0
    ret 2
  end
  if eq uor_eq32 hdr1 256 hdr2 256 0
    ret 3
  end

  note Verify SM121 P3 under P2, P3, and golden CPU replay (strict RFC 8032 Ed25519)
  if ne uor_verify_policy hdr1 sm_pay omc_pin UOR_LVL_P2 UOR_VERDICT_PASS
    ret 4
  end
  if ne uor_verify_policy hdr1 sm_pay omc_pin UOR_LVL_P3 UOR_VERDICT_PASS
    ret 5
  end
  if ne uor_verify_replay hdr1 rep_exp UOR_VERDICT_PASS
    ret 6
  end

  note Verify SPIR-V P3 bundle (portable target, strict RFC 8032 Ed25519)
  ug_fill_p3_hdr hdr2 UOR_GPU_ISA_SPIRV 64
  uor_hdr_seal hdr2 sp_pay
  ug_attach_test_sig hdr2 UOR_GPU_ISA_SPIRV
  if ne uor_verify_policy hdr2 sp_pay omc_pin UOR_LVL_P3 UOR_VERDICT_PASS
    ret 7
  end

  note Positive admission with live RX_RIGHT_EFFECT capability
  put cap_ent 0 1
  put cap_ent 1 42
  put cap_ent 2 1
  put cap_ent 3 1000
  put cap_ent 4 7
  put cap_ent 5 0x4152425247423130
  put cap_ent 6 4
  put cap_req 0 42
  put cap_req 1 1
  put cap_req 2 100
  put cap_req 3 7
  put cap_req 4 0x4152425247423130
  if ne uor_gpu_admit hdr1 sm_pay omc_pin cap_ent cap_req UOR_VERDICT_PASS
    ret 8
  end

  note Run all 10 negative controls
  nrc = ug_check_negatives hdr1 sm_pay omc_pin cap_ent cap_req
  if ne nrc 0
    uor_write_all 2 ug_fail_msg len ug_fail_msg
    ret int nrc
  end

  uor_emit_verdict hdr1 UOR_VERDICT_PASS
  uor_write_all 1 ug_pass_msg len ug_pass_msg
  ret 0
end

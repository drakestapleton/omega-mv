note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/payload_vm.om: Pure seeded OM-2 Blackwell SM121 QMD v5 + SASS binary VM
note and SPIR-V 1.0 OpenCL Kernel binary validator + executor for real UOR-GPU-1 P3 replay.
note Zero CUDApp, zero C/Python/shell. Compose after protocol/uor-gpu/canonical.om.

const UOR_REPLAY_N ulong 8
const UOR_REPLAY_THREADS ulong 12
const UOR_SM_A_VA ulong 0x10000000
const UOR_SM_B_VA ulong 0x20000000
const UOR_SM_C_VA ulong 0x30000000
const UOR_POISON_U32 ulong 0xdeadbeef

note ---- Blackwell SM121 QMD v05.00 structural validator (mirrors om/gpu/bw_qmd.om) ----

fn uvm_qmd_w pay view uchar * wi ulong to ulong
  ret uor_get_u32 pay add UOR_SM121_CODE_BYTES mul wi 4
end

fn uvm_check_sm121 hdr view uchar 384 pay view uchar * to ulong
  if ne len pay UOR_SM121_PAYLOAD_BYTES
    ret UOR_ERR_BAD_QMD
  end
  if ne and shr uvm_qmd_w pay 14 20 15 5
    ret UOR_ERR_BAD_QMD
  end
  if ne and shr uvm_qmd_w pay 4 23 7 2
    ret UOR_ERR_BAD_QMD
  end
  if ne uvm_qmd_w pay 37 0
    ret UOR_ERR_BAD_QMD
  end
  if eq uvm_qmd_w pay 17 0
    ret UOR_ERR_BAD_QMD
  end
  if ne and shr uvm_qmd_w pay 33 21 511 10
    ret UOR_ERR_BAD_QMD
  end
  if eq and uvm_qmd_w pay 58 1 0
    ret UOR_ERR_BAD_QMD
  end
  q34 = uvm_qmd_w pay 34
  if ne and q34 65535 uor_get_u32 hdr 28
    ret UOR_ERR_BAD_QMD
  end
  if eq and shr q34 16 65535 0
    ret UOR_ERR_BAD_QMD
  end
  if eq uvm_qmd_w pay 39 0
    ret UOR_ERR_BAD_QMD
  end
  if eq uvm_qmd_w pay 40 0
    ret UOR_ERR_BAD_QMD
  end
  if eq uvm_qmd_w pay 41 0
    ret UOR_ERR_BAD_QMD
  end
  if lt and shr uvm_qmd_w pay 35 8 511 16
    ret UOR_ERR_BAD_QMD
  end
  if or eq uvm_qmd_w pay 32 0 eq uvm_qmd_w pay 42 0
    ret UOR_ERR_BAD_QMD
  end
  ret UOR_VERDICT_PASS
end

note ---- Real Blackwell SM121 SASS binary VM (decodes & executes pay[0..512)) ----
note vm[64]:   0..31 = GPRs R0..R31, 32..47 = UR0..UR15, 48 = pc, 49 = p0, 50 = exited, 51 = tid
note mem[304]: 0..7 = A[0..7], 8..15 = B[0..7], 16..31 = C[0..15], 32..287 = cbank[0..255]

fn uvm_sm_rget vm view ulong 64 idx ulong to ulong
  if eq idx 255
    ret 0
  end
  if ge idx 32
    ret 0
  end
  ret get vm idx
end

fn uvm_sm_rset vm edit ulong 64 idx ulong val ulong to ulong
  if eq idx 255
    ret 1
  end
  if ge idx 32
    ret 0
  end
  put vm idx and val 0xffffffff
  ret 1
end

fn uvm_sm_sext24 v ulong to ulong
  x = and v 0xffffff
  if ne and x 0x800000 0
    ret or x 0xffffffffff000000
  end
  ret x
end

fn uvm_sm_pred_ok pred ulong p0 ulong to ulong
  if eq pred 7
    ret 1
  end
  if eq pred 0
    if ne p0 0
      ret 1
    end
    ret 0
  end
  if eq pred 8
    if eq p0 0
      ret 1
    end
    ret 0
  end
  if eq pred 15
    ret 0
  end
  ret 2
end

fn uvm_sm_ld_mem addr ulong mem view ulong 304 dst edit ulong 1 to ulong
  if ne and addr 3 0
    ret 0
  end
  if and ge addr UOR_SM_A_VA lt addr add UOR_SM_A_VA mul UOR_REPLAY_N 4
    put dst 0 get mem div sub addr UOR_SM_A_VA 4
    ret 1
  end
  if and ge addr UOR_SM_B_VA lt addr add UOR_SM_B_VA mul UOR_REPLAY_N 4
    put dst 0 get mem add 8 div sub addr UOR_SM_B_VA 4
    ret 1
  end
  ret 0
end

fn uvm_sm_st_mem addr ulong val ulong mem edit ulong 304 to ulong
  if ne and addr 3 0
    ret 0
  end
  if and ge addr UOR_SM_C_VA lt addr add UOR_SM_C_VA mul UOR_REPLAY_N 4
    put mem add 16 div sub addr UOR_SM_C_VA 4 and val 0xffffffff
    ret 1
  end
  ret 0
end

fn uvm_sm_cmp mode ulong a ulong b ulong to ulong
  if eq mode 1
    if lt a b
      ret 1
    end
    ret 0
  end
  if eq mode 2
    if eq a b
      ret 1
    end
    ret 0
  end
  if eq mode 3
    if le a b
      ret 1
    end
    ret 0
  end
  if eq mode 4
    if gt a b
      ret 1
    end
    ret 0
  end
  if eq mode 5
    if ge a b
      ret 1
    end
    ret 0
  end
  if eq mode 6
    if ne a b
      ret 1
    end
    ret 0
  end
  ret 2
end

fn uvm_sm_alu_imad op ulong w0 ulong w1 ulong w2 ulong vm edit ulong 64 to ulong
  rd = and shr w0 16 255
  ra = and shr w0 24 255
  rc = and w2 255
  va = uvm_sm_rget vm ra
  if eq op 0xc24
    ub = and w1 63
    if ge ub 16
      ret 0
    end
    ret uvm_sm_rset vm rd add mul va get vm add 32 ub uvm_sm_rget vm rc
  end
  if eq op 0x224
    ret uvm_sm_rset vm rd add mul va uvm_sm_rget vm and w1 255 uvm_sm_rget vm rc
  end
  if eq op 0x824
    ret uvm_sm_rset vm rd add mul va w1 uvm_sm_rget vm rc
  end
  if eq op 0x825
    if or ge rd 31 ge rc 31
      ret 0
    end
    c64 = or uvm_sm_rget vm rc shl uvm_sm_rget vm add rc 1 32
    res = add mul va w1 c64
    put vm rd and res 0xffffffff
    put vm add rd 1 and shr res 32 0xffffffff
    ret 1
  end
  ret 0
end

fn uvm_sm_step_alu op ulong w0 ulong w1 ulong w2 ulong vm edit ulong 64 to ulong
  if eq op 0xc24
    ret uvm_sm_alu_imad op w0 w1 w2 vm
  end
  if eq op 0x224
    ret uvm_sm_alu_imad op w0 w1 w2 vm
  end
  if eq op 0x824
    ret uvm_sm_alu_imad op w0 w1 w2 vm
  end
  if eq op 0x825
    ret uvm_sm_alu_imad op w0 w1 w2 vm
  end
  rd = and shr w0 16 255
  ra = and shr w0 24 255
  if eq op 0xc0c
    ub = and w1 63
    if ge ub 16
      ret 0
    end
    cm = uvm_sm_cmp and shr w2 25 7 uvm_sm_rget vm ra get vm add 32 ub
    if ge cm 2
      ret 0
    end
    put vm 49 cm
    ret 1
  end
  if eq op 0x210
    va = uvm_sm_rget vm ra
    vb = uvm_sm_rget vm and w1 255
    if ne and shr w1 30 1 0
      va = and sub 0x100000000 va 0xffffffff
    end
    if ne and shr w1 31 1 0
      vb = and sub 0x100000000 vb 0xffffffff
    end
    ret uvm_sm_rset vm rd add add va vb uvm_sm_rget vm and w2 255
  end
  if eq op 0x221
    fa = bitcast f32 uint uvm_sm_rget vm ra
    fb = bitcast f32 uint uvm_sm_rget vm and w1 255
    if ne and shr w1 31 1 0
      ret uvm_sm_rset vm rd ulong bitcast uint sub fa fb
    end
    ret uvm_sm_rset vm rd ulong bitcast uint add fa fb
  end
  ret 0
end

fn uvm_sm_step_cb w0 ulong w1 ulong w2 ulong vm edit ulong 64 mem view ulong 304 to ulong
  op = and w0 4095
  rd = and shr w0 16 255
  sz = and w2 4095
  if eq op 0xb82
    co = and shr w1 6 16383
    if or ne and co 3 0 ge div co 4 255
      ret 0
    end
    wi = add 32 div co 4
    if eq sz 0x800
      ret uvm_sm_rset vm rd get mem wi
    end
    if eq sz 0xa00
      if eq uvm_sm_rset vm rd get mem wi 0
        ret 0
      end
      ret uvm_sm_rset vm add rd 1 get mem add wi 1
    end
    ret 0
  end
  ud = and rd 63
  co = and shr w1 5 16383
  if ge ud 15
    ret 0
  end
  if ne and co 3 0
    ret 0
  end
  if ge div co 4 255
    ret 0
  end
  wi = add 32 div co 4
  if eq sz 0x800
    put vm add 32 ud get mem wi
    ret 1
  end
  if eq sz 0xa00
    put vm add 32 ud get mem wi
    put vm add 33 ud get mem add wi 1
    ret 1
  end
  ret 0
end

fn uvm_sm_step_mem w0 ulong w1 ulong vm edit ulong 64 mem edit ulong 304 to ulong
  ldv = new ulong 1 0
  op = and w0 4095
  rd = and shr w0 16 255
  ra = and shr w0 24 255
  if ge ra 31
    ret 0
  end
  addr = add or uvm_sm_rget vm ra shl uvm_sm_rget vm add ra 1 32 uvm_sm_sext24 shr w1 8
  if eq op 0x981
    if eq uvm_sm_ld_mem addr mem ldv 0
      ret 0
    end
    ret uvm_sm_rset vm rd get ldv 0
  end
  ret uvm_sm_st_mem addr uvm_sm_rget vm and w1 255 mem
end

note Execute one SM121 instruction (w0,w1,w2) on vm[64] and mem[304]. 1 on ok, 0 on fault.
fn uvm_sm_step w0 ulong w1 ulong w2 ulong vm edit ulong 64 mem edit ulong 304 to ulong
  op = and w0 4095
  if or eq op 0x918 eq op 0x947
    ret 1
  end
  if eq op 0x94d
    put vm 50 1
    ret 1
  end
  if eq op 0x919
    sr = and shr w2 8 255
    if eq sr 0x21
      ret uvm_sm_rset vm and shr w0 16 255 get vm 51
    end
    if eq sr 0x25
      ret uvm_sm_rset vm and shr w0 16 255 0
    end
    ret 0
  end
  if or eq op 0xb82 eq op 0x7ac
    ret uvm_sm_step_cb w0 w1 w2 vm mem
  end
  if or eq op 0x981 eq op 0x986
    ret uvm_sm_step_mem w0 w1 vm mem
  end
  ret uvm_sm_step_alu op w0 w1 w2 vm
end

fn uvm_sm_exec_pc pay view uchar * vm edit ulong 64 mem edit ulong 304 to ulong
  pc = get vm 48
  if ge pc 32
    ret 0
  end
  put vm 48 add pc 1
  w0 = uor_get_u32 pay mul pc 16
  pk = uvm_sm_pred_ok and shr w0 12 15 get vm 49
  if eq pk 2
    ret 0
  end
  if eq pk 0
    ret 1
  end
  w1 = uor_get_u32 pay add mul pc 16 4
  w2 = uor_get_u32 pay add mul pc 16 8
  ret uvm_sm_step w0 w1 w2 vm mem
end

fn uvm_sm_run_tid pay view uchar * mem edit ulong 304 tid ulong to ulong
  vm = new ulong 64 0
  put vm 51 tid
  step = ulong 0
  while lt step 64 bound 64
    if eq uvm_sm_exec_pc pay vm mem 0
      ret 0
    end
    if ne get vm 50 0
      ret 1
    end
    step = add step 1
  end
  ret 0
end

fn uvm_sm_setup_mem mem edit ulong 304 tx ulong to void
  for i ulong UOR_REPLAY_N
    put mem i add mul i 3 10
    put mem add 8 i add mul i 5 20
  end
  for i ulong 16
    put mem add 16 i UOR_POISON_U32
  end
  put mem 246 0x24280380
  put mem 247 0x00000003
  put mem 248 tx
  put mem 249 1
  put mem 252 1
  put mem 253 1
  put mem 255 0x00fffdc0
  put mem 256 and UOR_SM_A_VA 0xffffffff
  put mem 257 shr UOR_SM_A_VA 32
  put mem 258 and UOR_SM_B_VA 0xffffffff
  put mem 259 shr UOR_SM_B_VA 32
  put mem 260 and UOR_SM_C_VA 0xffffffff
  put mem 261 shr UOR_SM_C_VA 32
  put mem 262 UOR_REPLAY_N
end

note Execute the actual SM121 SASS payload + QMD v5 on golden u32 inputs (8 in-bounds + 4 OOB).
fn uvm_replay_sm121 hdr view uchar 384 pay view uchar * out32 edit uchar 32 to ulong
  mem = new ulong 304 0
  ob = new uchar 32 0
  rc = uvm_check_sm121 hdr pay
  if ne rc UOR_VERDICT_PASS
    ret rc
  end
  q34 = uvm_qmd_w pay 34
  uvm_sm_setup_mem mem and q34 65535
  for tid ulong UOR_REPLAY_THREADS
    if eq uvm_sm_run_tid pay mem tid 0
      ret UOR_ERR_REPLAY_FAULT
    end
  end
  for i ulong UOR_REPLAY_N
    if ne get mem add 24 i UOR_POISON_U32
      ret UOR_ERR_REPLAY_FAULT
    end
    uor_put_u32 ob mul i 4 get mem add 16 i
  end
  d = sha2_digest 256 ob out32
  if ne d 32
    trap 8
  end
  ret UOR_VERDICT_PASS
end

fn uvm_expected_sm121 dst32 edit uchar 32 to void
  ob = new uchar 32 0
  for i ulong UOR_REPLAY_N
    a = add mul i 3 10
    b = add mul i 5 20
    uor_put_u32 ob mul i 4 add a b
  end
  d = sha2_digest 256 ob dst32
  if ne d 32
    trap 8
  end
end

note ---- SPIR-V 1.0 OpenCL Kernel binary validator & executor (real payload replay) ----
note sv[800]:
note   0..7:     meta (0=entry_fn, 1=gid_var, 2=n_inst, 3=n_ptr_params, 4=n_param_id, 5=in_entry, 6=ptr_f32_tid, 7=err)
note   8..263:   sbind[0..255]
note   264..519: slbl[0..255]
note   520..775: sval[0..255]
note prog[1024]:
note   0..255:   iop, 256..511: ia1, 512..767: ia2, 768..1023: ia3
note smem[32]:
note   0..7: A (f32 bits), 8..15: B (f32 bits), 16..31: C (f32 bits + 8 canaries)

fn uvm_spv_word pay view uchar * wi ulong to ulong
  ret uor_get_u32 pay mul wi 4
end

fn uvm_check_spirv_hdr pay view uchar * to ulong
  nb = len pay
  if lt nb 20
    ret 0
  end
  if gt nb 65536
    ret 0
  end
  if ne rem nb 4 0
    ret 0
  end
  if ne uvm_spv_word pay 0 0x07230203
    ret 0
  end
  ver = uvm_spv_word pay 1
  if lt ver 0x00010000
    ret 0
  end
  if gt ver 0x00010600
    ret 0
  end
  bnd = uvm_spv_word pay 3
  if eq bnd 0
    ret 0
  end
  if gt bnd 1024
    ret 0
  end
  if ne uvm_spv_word pay 4 0
    ret 0
  end
  ret div nb 4
end

fn uvm_check_spirv_op pay view uchar * p ulong st edit ulong 6 to ulong
  hd = uvm_spv_word pay p
  wc = shr hd 16
  op = and hd 65535
  if eq op 17
    if ne wc 2
      ret 0
    end
    cap = uvm_spv_word pay add p 1
    if eq cap 4
      put st 0 or get st 0 1
    end
    if eq cap 6
      put st 0 or get st 0 2
    end
    ret 1
  end
  if eq op 14
    if ne wc 3
      ret 0
    end
    if eq uvm_spv_word pay add p 1 2
      if eq uvm_spv_word pay add p 2 2
        put st 1 1
      end
    end
    ret 1
  end
  if eq op 15
    if lt wc 4
      ret 0
    end
    if ne uvm_spv_word pay add p 1 6
      ret 0
    end
    put st 2 uvm_spv_word pay add p 2
    ret 1
  end
  if eq op 54
    if ne get st 4 0
      ret 0
    end
    if lt wc 5
      ret 0
    end
    put st 4 1
    if eq uvm_spv_word pay add p 2 get st 2
      put st 3 1
    end
    ret 1
  end
  if eq op 56
    if eq get st 4 0
      ret 0
    end
    put st 4 0
    ret 1
  end
  ret 1
end

fn uvm_check_spirv pay view uchar * to ulong
  st = new ulong 6 0
  nw = uvm_check_spirv_hdr pay
  if eq nw 0
    ret UOR_ERR_BAD_SPIRV
  end
  p = ulong 5
  while lt p nw bound 16384
    wc = shr uvm_spv_word pay p 16
    if eq wc 0
      ret UOR_ERR_BAD_SPIRV
    end
    if gt add p wc nw
      ret UOR_ERR_BAD_SPIRV
    end
    if eq uvm_check_spirv_op pay p st 0
      ret UOR_ERR_BAD_SPIRV
    end
    p = add p wc
  end
  if ne get st 0 3
    ret UOR_ERR_BAD_SPIRV
  end
  if eq get st 1 0
    ret UOR_ERR_BAD_SPIRV
  end
  if eq get st 2 0
    ret UOR_ERR_BAD_SPIRV
  end
  if eq get st 3 0
    ret UOR_ERR_BAD_SPIRV
  end
  if ne get st 4 0
    ret UOR_ERR_BAD_SPIRV
  end
  ret UOR_VERDICT_PASS
end

fn uvm_spv_parse_meta pay view uchar * p ulong sv edit ulong 800 to void
  hd = uvm_spv_word pay p
  wc = shr hd 16
  op = and hd 65535
  if eq op 15
    if ge wc 3
      put sv 0 uvm_spv_word pay add p 2
    end
    ret
  end
  if eq op 71
    if ge wc 4
      if and eq uvm_spv_word pay add p 2 11 eq uvm_spv_word pay add p 3 28
        put sv 1 uvm_spv_word pay add p 1
      end
    end
    ret
  end
  if eq op 32
    if eq wc 4
      if and eq uvm_spv_word pay add p 2 5 eq uvm_spv_word pay add p 3 4
        put sv 6 uvm_spv_word pay add p 1
      end
    end
    ret
  end
  if eq op 43
    if ge wc 4
      rid = uvm_spv_word pay add p 2
      if lt rid 256
        v = uvm_spv_word pay add p 3
        if ge wc 5
          v = or v shl uvm_spv_word pay add p 4 32
        end
        put sv add 520 rid v
      end
    end
    ret
  end
end

fn uvm_spv_add sv edit ulong 800 prog edit ulong 1024 op ulong a1 ulong a2 ulong a3 ulong to void
  k = get sv 2
  if ge k 256
    put sv 7 1
    ret
  end
  put prog k op
  put prog add 256 k a1
  put prog add 512 k a2
  put prog add 768 k a3
  put sv 2 add k 1
end

fn uvm_spv_parse_body pay view uchar * p ulong sv edit ulong 800 prog edit ulong 1024 to void
  hd = uvm_spv_word pay p
  wc = shr hd 16
  op = and hd 65535
  if eq op 55
    if lt wc 3
      put sv 7 1
      ret
    end
    tid = uvm_spv_word pay add p 1
    rid = uvm_spv_word pay add p 2
    if ge rid 256
      put sv 7 1
      ret
    end
    if eq tid get sv 6
      np = get sv 3
      put sv add 8 rid add np 1
      put sv 3 add np 1
      ret
    end
    put sv 4 rid
    ret
  end
  if eq op 248
    if lt wc 2
      put sv 7 1
      ret
    end
    lid = uvm_spv_word pay add p 1
    if ge lid 256
      put sv 7 1
      ret
    end
    put sv add 264 lid add get sv 2 1
    ret
  end
  if eq op 247
    ret
  end
  if eq op 253
    uvm_spv_add sv prog 253 0 0 0
    ret
  end
  if eq op 249
    if lt wc 2
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 249 uvm_spv_word pay add p 1 0 0
    ret
  end
  if eq op 250
    if lt wc 4
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 250 uvm_spv_word pay add p 1 uvm_spv_word pay add p 2 uvm_spv_word pay add p 3
    ret
  end
  if eq op 61
    if lt wc 4
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 61 uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 0
    ret
  end
  if eq op 62
    if lt wc 3
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 62 uvm_spv_word pay add p 1 uvm_spv_word pay add p 2 0
    ret
  end
  if eq op 81
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 81 uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 113
    if lt wc 4
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 113 uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 0
    ret
  end
  if eq op 70
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog 70 uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 176
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 128
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 129
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 131
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 133
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  if eq op 136
    if lt wc 5
      put sv 7 1
      ret
    end
    uvm_spv_add sv prog op uvm_spv_word pay add p 2 uvm_spv_word pay add p 3 uvm_spv_word pay add p 4
    ret
  end
  put sv 7 1
end

fn uvm_spv_exec_alu op ulong a1 ulong a2 ulong a3 ulong sv edit ulong 800 to ulong
  if or ge a1 256 or ge a2 256 ge a3 256
    ret 0
  end
  v2 = get sv add 520 a2
  v3 = get sv add 520 a3
  if eq op 176
    if lt v2 v3
      put sv add 520 a1 1
    else
      put sv add 520 a1 0
    end
    ret 1
  end
  if eq op 128
    put sv add 520 a1 add v2 v3
    ret 1
  end
  if eq op 129
    fa = bitcast f32 uint v2
    fb = bitcast f32 uint v3
    put sv add 520 a1 ulong bitcast uint add fa fb
    ret 1
  end
  if eq op 131
    fa = bitcast f32 uint v2
    fb = bitcast f32 uint v3
    put sv add 520 a1 ulong bitcast uint sub fa fb
    ret 1
  end
  if eq op 133
    fa = bitcast f32 uint v2
    fb = bitcast f32 uint v3
    put sv add 520 a1 ulong bitcast uint mul fa fb
    ret 1
  end
  if eq op 136
    fa = bitcast f32 uint v2
    fb = bitcast f32 uint v3
    put sv add 520 a1 ulong bitcast uint div fa fb
    ret 1
  end
  ret 0
end

fn uvm_spv_step_mem op ulong a1 ulong a2 ulong sv edit ulong 800 smem edit ulong 32 to ulong
  if or ge a1 256 ge a2 256
    ret 0
  end
  if eq op 61
    pv = get sv add 520 a2
    slot = shr pv 32
    idx = and pv 0xffffffff
    if ge idx UOR_REPLAY_N
      ret 0
    end
    if eq slot 0
      put sv add 520 a1 get smem idx
      ret 1
    end
    if eq slot 1
      put sv add 520 a1 get smem add 8 idx
      ret 1
    end
    ret 0
  end
  pv = get sv add 520 a1
  slot = shr pv 32
  idx = and pv 0xffffffff
  if or ne slot 2 ge idx UOR_REPLAY_N
    ret 0
  end
  put smem add 16 idx and get sv add 520 a2 0xffffffff
  ret 1
end

fn uvm_spv_step_ptr a1 ulong a2 ulong a3 ulong sv edit ulong 800 to ulong
  if ge a1 256
    ret 0
  end
  if or ge a2 256 ge a3 256
    ret 0
  end
  b = get sv add 8 a2
  if eq b 0
    ret 0
  end
  idx = and get sv add 520 a3 0xffffffff
  put sv add 520 a1 or shl sub b 1 32 idx
  ret 1
end

note Execute one SPIR-V instruction at pc = sv[776]; sets sv[777]=1 on OpReturn. 1 ok, 0 fault.
fn uvm_spv_step_one gid ulong sv edit ulong 800 prog view ulong 1024 smem edit ulong 32 to ulong
  pc = get sv 776
  if ge pc get sv 2
    ret 0
  end
  op = get prog pc
  a1 = get prog add 256 pc
  a2 = get prog add 512 pc
  a3 = get prog add 768 pc
  if eq op 253
    put sv 777 1
    ret 1
  end
  if eq op 249
    if ge a1 256
      ret 0
    end
    t = get sv add 264 a1
    if eq t 0
      ret 0
    end
    put sv 776 sub t 1
    ret 1
  end
  if eq op 250
    if ge a1 256
      ret 0
    end
    if or ge a2 256 ge a3 256
      ret 0
    end
    t = get sv add 264 a3
    if ne get sv add 520 a1 0
      t = get sv add 264 a2
    end
    if eq t 0
      ret 0
    end
    put sv 776 sub t 1
    ret 1
  end
  put sv 776 add pc 1
  if and eq op 61 eq a2 get sv 1
    if ge a1 256
      ret 0
    end
    put sv add 520 a1 gid
    ret 1
  end
  if eq op 81
    if or ge a1 256 ge a2 256
      ret 0
    end
    if eq a3 0
      put sv add 520 a1 get sv add 520 a2
    else
      put sv add 520 a1 0
    end
    ret 1
  end
  if eq op 113
    if or ge a1 256 ge a2 256
      ret 0
    end
    put sv add 520 a1 and get sv add 520 a2 0xffffffff
    ret 1
  end
  if eq op 70
    ret uvm_spv_step_ptr a1 a2 a3 sv
  end
  if or eq op 61 eq op 62
    ret uvm_spv_step_mem op a1 a2 sv smem
  end
  ret uvm_spv_exec_alu op a1 a2 a3 sv
end

fn uvm_spv_run_gid gid ulong sv edit ulong 800 prog view ulong 1024 smem edit ulong 32 to ulong
  if lt get sv 4 256
    put sv add 520 get sv 4 UOR_REPLAY_N
  end
  put sv 776 0
  put sv 777 0
  step = ulong 0
  while lt step 256 bound 256
    if eq uvm_spv_step_one gid sv prog smem 0
      ret 0
    end
    if ne get sv 777 0
      ret 1
    end
    step = add step 1
  end
  ret 0
end

fn uvm_spv_decode pay view uchar * sv edit ulong 800 prog edit ulong 1024 to ulong
  nw = div len pay 4
  p = ulong 5
  while lt p nw bound 16384
    hd = uvm_spv_word pay p
    wc = shr hd 16
    op = and hd 65535
    if eq op 54
      if eq uvm_spv_word pay add p 2 get sv 0
        put sv 5 1
      end
    else
      if eq op 56
        put sv 5 0
      else
        if ne get sv 5 0
          uvm_spv_parse_body pay p sv prog
        else
          uvm_spv_parse_meta pay p sv
        end
      end
    end
    p = add p wc
  end
  if ne get sv 7 0
    ret 0
  end
  if eq get sv 2 0
    ret 0
  end
  if ne get sv 3 3
    ret 0
  end
  ret 1
end

note Execute the actual SPIR-V OpenCL binary on golden f32 inputs (8 in-bounds + 4 OOB).
fn uvm_replay_spirv pay view uchar * out32 edit uchar 32 to ulong
  sv = new ulong 800 0
  prog = new ulong 1024 0
  smem = new ulong 32 0
  ob = new uchar 32 0
  rc = uvm_check_spirv pay
  if ne rc UOR_VERDICT_PASS
    ret rc
  end
  if eq uvm_spv_decode pay sv prog 0
    ret UOR_ERR_REPLAY_FAULT
  end
  for i ulong UOR_REPLAY_N
    put smem i ulong bitcast uint f32 add mul i 3 10
    put smem add 8 i ulong bitcast uint f32 add mul i 5 20
  end
  for i ulong 16
    put smem add 16 i UOR_POISON_U32
  end
  for gid ulong UOR_REPLAY_THREADS
    if eq uvm_spv_run_gid gid sv prog smem 0
      ret UOR_ERR_REPLAY_FAULT
    end
  end
  for i ulong UOR_REPLAY_N
    if ne get smem add 24 i UOR_POISON_U32
      ret UOR_ERR_REPLAY_FAULT
    end
    uor_put_u32 ob mul i 4 get smem add 16 i
  end
  d = sha2_digest 256 ob out32
  if ne d 32
    trap 8
  end
  ret UOR_VERDICT_PASS
end

fn uvm_expected_spirv dst32 edit uchar 32 to void
  ob = new uchar 32 0
  for i ulong UOR_REPLAY_N
    fa = f32 add mul i 3 10
    fb = f32 add mul i 5 20
    uor_put_u32 ob mul i 4 ulong bitcast uint add fa fb
  end
  d = sha2_digest 256 ob dst32
  if ne d 32
    trap 8
  end
end

note ---- Unified target structural check & real payload replay dispatch ----

fn uvm_check_payload hdr view uchar 384 pay view uchar * to ulong
  isa = uor_get_u32 hdr 12
  if eq isa UOR_GPU_ISA_SM121
    ret uvm_check_sm121 hdr pay
  end
  if eq isa UOR_GPU_ISA_SPIRV
    ret uvm_check_spirv pay
  end
  ret UOR_ERR_BAD_TARGET
end

fn uvm_replay_payload hdr view uchar 384 pay view uchar * out32 edit uchar 32 to ulong
  isa = uor_get_u32 hdr 12
  if eq isa UOR_GPU_ISA_SM121
    ret uvm_replay_sm121 hdr pay out32
  end
  if eq isa UOR_GPU_ISA_SPIRV
    ret uvm_replay_spirv pay out32
  end
  ret UOR_ERR_BAD_TARGET
end

fn uvm_expected_digest isa ulong dst32 edit uchar 32 to void
  if eq isa UOR_GPU_ISA_SM121
    uvm_expected_sm121 dst32
    ret
  end
  uvm_expected_spirv dst32
end

note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/prism-gpu.om: Pure seeded OM-2 Prism CLI plugin executable
note (`prism-gpu <bundle.holo>`) compatible with PrismPM #293 CLI plugin discovery.
note Reads a UOR-GPU-1 .holo bundle file, verifies digests + mandatory Lean 4 P2 proof,
note emits canonical prism/verdict/1 JSON to stdout, and exits 0 iff PASS.
note Compose after si/directives/om2.om, om/tls/sha2.om, om/blake3/b3unit.om,
note protocol/uor-gpu/canonical.om, protocol/uor-gpu/verify.om.

text pg_usage "usage: prism-gpu <bundle.holo>\n"
text pg_err_open "prism-gpu: cannot open bundle\n"
text pg_err_short "prism-gpu: bundle shorter than 256-byte UOR-GPU-1 header\n"

fn main to int
  ac = argcnt
  if lt ac 2
    uor_write_all 2 pg_usage len pg_usage
    ret 2
  end
  path = new uchar 512 0
  pn = argread 1 path 0 512
  if le pn 0
    uor_write_all 2 pg_usage len pg_usage
    ret 2
  end
  fd = fopen path 0 ulong pn 0 0
  if lt fd 0
    uor_write_all 2 pg_err_open len pg_err_open
    ret 3
  end
  hdr = new uchar 256 0
  hn = ulong 0
  while lt hn 256 bound 256
    k = read int fd hdr hn sub 256 hn
    if le k 0
      break
    end
    hn = add hn ulong k
  end
  if lt hn 256
    cl = fclose int fd
    uor_write_all 2 pg_err_short len pg_err_short
    ret 4
  end
  plen = uor_get_u32 hdr 24
  if gt plen 65536
    cl = fclose int fd
    uor_emit_verdict hdr UOR_ERR_PAYLOAD_TAMPER
    ret 1
  end
  pay = new uchar 65536 0
  got = ulong 0
  while lt got plen bound 65536
    k = read int fd pay got sub plen got
    if le k 0
      break
    end
    got = add got ulong k
  end
  cl = fclose int fd
  if ne got plen
    uor_emit_verdict hdr UOR_ERR_PAYLOAD_TAMPER
    ret 1
  end
  omc_pin = new uchar 32 0
  uor_copy32 omc_pin 0 hdr 32
  rc = uor_verify_policy hdr part pay 0 plen omc_pin UOR_LVL_P2
  uor_emit_verdict hdr rc
  if eq rc UOR_VERDICT_PASS
    ret 0
  end
  ret 1
end

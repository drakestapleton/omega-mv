note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/prism-gpu.om: Pure seeded OM-2 Prism CLI plugin executable
note (`prism-gpu bundle|inspect|verify|replay|admit ...`, PrismPM #293 compatible).
note Zero CUDApp, zero C/Python/Node. Compose after si/directives/om2.om, om/tls/sha2.om,
note protocol/uor-gpu/b3_uor.om, protocol/omnet/om/sha512/sha512.om,
note protocol/omnet/om/ed25519/ed25519.om, protocol/uor-gpu/canonical.om,
note protocol/uor-gpu/verify.om, protocol/uor-gpu/gate.om, protocol/uor-gpu/emit_kernels.om.

text pg_usage "usage: prism-gpu <bundle sm121|spirv out.holo | inspect|verify|replay file.holo | admit file.holo cap.grant>\n"
text pg_err_open "prism-gpu: cannot open file\n"
text pg_err_short "prism-gpu: bundle shorter than 384-byte UOR-GPU-1 header\n"
text pg_c_bundle "bundle"
text pg_c_inspect "inspect"
text pg_c_verify "verify"
text pg_c_replay "replay"
text pg_c_admit "admit"
text pg_t_sm121 "sm121"
text pg_t_spirv "spirv"

const PG_CREATE_FLAGS int 577
const PG_CREATE_MODE int 420

fn pg_streq a view uchar * n ulong b view uchar * to ulong
  if ne n len b
    ret 0
  end
  for i ulong n bound 64
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

fn pg_read_bundle path view uchar * pn ulong hdr edit uchar 384 pay edit uchar 65536 out_plen edit ulong 1 to long
  fd = fopen path 0 pn 0 0
  if lt fd 0
    ret -1
  end
  hn = ulong 0
  while lt hn 384 bound 384
    k = read int fd hdr hn sub 384 hn
    if le k 0
      break
    end
    hn = add hn ulong k
  end
  if lt hn 384
    cl = fclose int fd
    ret -2
  end
  plen = uor_get_u32 hdr 24
  if gt plen 65536
    cl = fclose int fd
    ret -3
  end
  got = ulong 0
  while lt got plen bound 65536
    k = read int fd pay got sub plen got
    if le k 0
      break
    end
    got = add got ulong k
  end
  extra = new uchar 1 0
  ek = read int fd extra 0 1
  cl = fclose int fd
  if or ne got plen gt ek 0
    ret -3
  end
  put out_plen 0 plen
  ret 0
end

fn pg_cmd_bundle tgt view uchar * tn ulong outp view uchar * opn ulong to int
  hdr = new uchar 384 0
  sm_pay = new uchar 768 0
  sp_pay = new uchar 64 0
  fd = fopen outp 0 opn PG_CREATE_FLAGS PG_CREATE_MODE
  if lt fd 0
    uor_write_all 2 pg_err_open len pg_err_open
    ret 3
  end
  if ne pg_streq tgt tn pg_t_sm121 0
    ug_emit_sm121_vecadd_qmd sm_pay
    ug_fill_p3_hdr hdr UOR_GPU_ISA_SM121 768
    uor_hdr_seal hdr sm_pay
    ug_attach_test_sig hdr UOR_GPU_ISA_SM121
    uor_write_all int fd hdr 384
    uor_write_all int fd sm_pay 768
    cl = fclose int fd
    uor_emit_verdict hdr UOR_VERDICT_PASS
    ret 0
  end
  if ne pg_streq tgt tn pg_t_spirv 0
    ug_emit_spirv_vadd sp_pay
    ug_fill_p3_hdr hdr UOR_GPU_ISA_SPIRV 64
    uor_hdr_seal hdr sp_pay
    ug_attach_test_sig hdr UOR_GPU_ISA_SPIRV
    uor_write_all int fd hdr 384
    uor_write_all int fd sp_pay 64
    cl = fclose int fd
    uor_emit_verdict hdr UOR_VERDICT_PASS
    ret 0
  end
  cl = fclose int fd
  uor_write_all 2 pg_usage len pg_usage
  ret 2
end

fn pg_get_u64 src view uchar 64 off ulong to ulong
  lo = uor_get_u32 src off
  hi = uor_get_u32 src add off 4
  ret or lo shl hi 32
end

note Read 64-byte external capability grant record (8 x u64 LE); never self-grant.
fn pg_read_cap cap_path view uchar * cn ulong cap_ent edit ulong 8 to ulong
  fd = fopen cap_path 0 cn 0 0
  if lt fd 0
    ret 0
  end
  raw = new uchar 64 0
  got = ulong 0
  while lt got 64 bound 64
    k = read int fd raw got sub 64 got
    if le k 0
      break
    end
    got = add got ulong k
  end
  extra = new uchar 1 0
  ek = read int fd extra 0 1
  cl = fclose int fd
  if or ne got 64 gt ek 0
    ret 0
  end
  for i ulong 8
    put cap_ent i pg_get_u64 raw mul i 8
  end
  ret 1
end

fn pg_run_admit hdr view uchar 384 pay view uchar * omc_pin view uchar 32 cap_ent view ulong 8 to ulong
  cap_req = new ulong 5 0
  put cap_req 0 get cap_ent 1
  put cap_req 1 1
  put cap_req 2 100
  put cap_req 3 7
  put cap_req 4 0x4152425247423130
  ret uor_gpu_admit hdr pay omc_pin cap_ent cap_req
end

fn pg_run_replay hdr view uchar 384 pay view uchar * omc_pin view uchar 32 to ulong
  rep_exp = new uchar 32 0
  rc = uor_verify_policy hdr pay omc_pin UOR_LVL_P3
  if eq rc UOR_VERDICT_PASS
    ug_replay_digest rep_exp
    rc = uor_verify_replay hdr rep_exp
  end
  ret rc
end

fn pg_cmd_file cmd view uchar * cn ulong path view uchar * pn ulong to int
  hdr = new uchar 384 0
  pay = new uchar 65536 0
  plen_box = new ulong 1 0
  omc_pin = new uchar 32 0
  rrc = pg_read_bundle path pn hdr pay plen_box
  if eq rrc -1
    uor_write_all 2 pg_err_open len pg_err_open
    ret 3
  end
  if eq rrc -2
    uor_write_all 2 pg_err_short len pg_err_short
    ret 4
  end
  if eq rrc -3
    uor_emit_verdict hdr UOR_ERR_PAYLOAD_TAMPER
    ret 1
  end
  if ne pg_streq cmd cn pg_c_inspect 0
    if eq uor_emit_inspect hdr 0
      uor_emit_verdict hdr UOR_ERR_BAD_MAGIC
      ret 1
    end
    ret 0
  end
  plen = get plen_box 0
  ug_parse_hex32 ug_omc_hex omc_pin
  if ne pg_streq cmd cn pg_c_verify 0
    rc = uor_verify_policy hdr part pay 0 plen omc_pin UOR_LVL_P2
    uor_emit_verdict hdr rc
    if eq rc UOR_VERDICT_PASS
      ret 0
    end
    ret 1
  end
  if ne pg_streq cmd cn pg_c_replay 0
    rc = pg_run_replay hdr part pay 0 plen omc_pin
    uor_emit_verdict hdr rc
    if eq rc UOR_VERDICT_PASS
      ret 0
    end
    ret 1
  end
  uor_write_all 2 pg_usage len pg_usage
  ret 2
end

fn pg_cmd_admit path view uchar * pn ulong cap_ent view ulong 8 to int
  hdr = new uchar 384 0
  pay = new uchar 65536 0
  plen_box = new ulong 1 0
  omc_pin = new uchar 32 0
  rrc = pg_read_bundle path pn hdr pay plen_box
  if eq rrc -1
    uor_write_all 2 pg_err_open len pg_err_open
    ret 3
  end
  if eq rrc -2
    uor_write_all 2 pg_err_short len pg_err_short
    ret 4
  end
  if eq rrc -3
    uor_emit_verdict hdr UOR_ERR_PAYLOAD_TAMPER
    ret 1
  end
  plen = get plen_box 0
  ug_parse_hex32 ug_omc_hex omc_pin
  rc = pg_run_admit hdr part pay 0 plen omc_pin cap_ent
  uor_emit_verdict hdr rc
  if eq rc UOR_VERDICT_PASS
    ret 0
  end
  ret 1
end

fn main to int
  ac = argcnt
  if lt ac 3
    uor_write_all 2 pg_usage len pg_usage
    ret 2
  end
  cmd = new uchar 64 0
  a2 = new uchar 512 0
  a3 = new uchar 512 0
  cap_ent = new ulong 8 0
  cn = argread 1 cmd 0 64
  n2 = argread 2 a2 0 512
  if or le cn 0 le n2 0
    uor_write_all 2 pg_usage len pg_usage
    ret 2
  end
  if ne pg_streq cmd ulong cn pg_c_bundle 0
    if lt ac 4
      uor_write_all 2 pg_usage len pg_usage
      ret 2
    end
    n3 = argread 3 a3 0 512
    if le n3 0
      uor_write_all 2 pg_usage len pg_usage
      ret 2
    end
    ret pg_cmd_bundle a2 ulong n2 a3 ulong n3
  end
  if ne pg_streq cmd ulong cn pg_c_admit 0
    if lt ac 4
      uor_write_all 2 pg_usage len pg_usage
      ret 2
    end
    n3 = argread 3 a3 0 512
    if le n3 0
      uor_write_all 2 pg_usage len pg_usage
      ret 2
    end
    if eq pg_read_cap a3 ulong n3 cap_ent 0
      uor_write_all 2 pg_err_open len pg_err_open
      ret 1
    end
    ret pg_cmd_admit a2 ulong n2 cap_ent
  end
  ret pg_cmd_file cmd ulong cn a2 ulong n2
end

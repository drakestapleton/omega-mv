note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/prism-gpu.om: Pure seeded OM-2 Prism CLI plugin executable
note (PrismPM #293 compatible). Zero CUDApp, zero C/Python/Node. Compose after
note si/directives/om2.om, om/tls/sha2.om, protocol/uor-gpu/b3_uor.om,
note protocol/omnet/om/sha512/sha512.om, protocol/omnet/om/ed25519/ed25519.om,
note protocol/uor-gpu/canonical.om, protocol/uor-gpu/verify.om, protocol/uor-gpu/gate.om,
note protocol/uor-gpu/emit_kernels.om, protocol/uor-gpu/ed_sign.om.
note
note   keygen out.seed                         32 random bytes, created 0600, never overwritten
note   pubkey in.seed out.pub                  Ed25519 public key of a seed
note   trust out.trust authority.pub signer.pub  local trust anchors (append more signer keys)
note   bundle sm121|spirv out.holo signer.seed seal and sign a P3 bundle; prints its claims
note   inspect file.holo                       print the header's claims (nothing verified)
note   verify file.holo anchors.trust          P2 policy against local anchors
note   replay file.holo anchors.trust          P3 policy plus CPU reference replay digest
note   grant record64.bin authority.seed out.grant  sign a 64-byte capability record
note   admit file.holo anchors.trust file.grant  P2 policy plus authority-signed live grant

text pg_usage "usage: prism-gpu keygen out.seed | pubkey in.seed out.pub | trust out.trust authority.pub signer.pub | bundle sm121|spirv out.holo signer.seed | inspect file.holo | verify|replay file.holo anchors.trust | grant record64.bin authority.seed out.grant | admit file.holo anchors.trust file.grant\n"
text pg_err_open "prism-gpu: cannot open, read or write file, or it has the wrong size\n"
text pg_err_short "prism-gpu: bundle shorter than 384-byte UOR-GPU-1 header\n"
text pg_err_rand "prism-gpu: random source failed\n"
text pg_err_anch "prism-gpu: bad trust anchors (authority key equal to signer key?)\n"
text pg_c_keygen "keygen"
text pg_c_pubkey "pubkey"
text pg_c_trust "trust"
text pg_c_bundle "bundle"
text pg_c_inspect "inspect"
text pg_c_verify "verify"
text pg_c_replay "replay"
text pg_c_grant "grant"
text pg_c_admit "admit"
text pg_t_sm121 "sm121"
text pg_t_spirv "spirv"

const PG_CREATE_FLAGS int 577
const PG_SECRET_FLAGS int 705
const PG_CREATE_MODE int 420
const PG_SECRET_MODE int 384
note Fixed request fields of this offline CLI: world epoch, CLI subject id, GB10 resource id.
const PG_WORLD_EPOCH ulong 1
const PG_SUBJECT_CLI ulong 7
const PG_RES_GB10 ulong 0x4152425247423130

fn pg_streq a view uchar * n ulong b view uchar * to ulong
  if ne n len b
    ret 0
  end
  for i ulong n bound 64
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

fn pg_usage_rc to int
  uor_write_all 2 pg_usage len pg_usage
  ret 2
end

fn pg_open_rc to int
  uor_write_all 2 pg_err_open len pg_err_open
  ret 3
end

note argument i into buf; 0 when absent or empty
fn pg_arg i ulong buf edit uchar 512 to ulong
  if ge long i argcnt
    ret 0
  end
  n = argread i buf 0 512
  if le n 0
    ret 0
  end
  ret ulong n
end

note Read a whole file into buf: byte count, -1 cannot open, -2 longer than buf.
fn pg_read_file path view uchar * pn ulong buf edit uchar * to long
  fd = fopen path 0 pn 0 0
  if lt fd 0
    ret -1
  end
  cap = len buf
  got = ulong 0
  while lt got cap bound 65920
    k = read int fd buf got sub cap got
    if le k 0
      break
    end
    got = add got ulong k
  end
  extra = new uchar 1 0
  ek = read int fd extra 0 1
  cl = fclose int fd
  if gt ek 0
    ret -2
  end
  ret long got
end

note 1 iff the file holds exactly len buf bytes (read into buf)
fn pg_read_exact path view uchar * pn ulong buf edit uchar * to ulong
  r = pg_read_file path pn buf
  if ne r long len buf
    ret 0
  end
  ret 1
end

note Create path (secret: 0600 and refuse to overwrite) and write all of buf. 1 on success.
fn pg_write_file path view uchar * pn ulong buf view uchar * secret ulong to ulong
  fl = PG_CREATE_FLAGS
  md = PG_CREATE_MODE
  if eq secret 1
    fl = PG_SECRET_FLAGS
    md = PG_SECRET_MODE
  end
  fd = fopen path 0 pn fl md
  if lt fd 0
    ret 0
  end
  uor_write_all int fd buf len buf
  cl = fclose int fd
  ret 1
end

note Load header + payload: 0 ok, -1 cannot open, -2 short header, -3 length/trailing-byte tamper.
fn pg_load_bundle path view uchar * pn ulong hdr edit uchar 384 pay edit uchar 65536 out_plen edit ulong 1 to long
  raw = new uchar 65920 0
  r = pg_read_file path pn raw
  if eq r -1
    ret -1
  end
  if lt r 0
    ret -3
  end
  if lt r 384
    ret -2
  end
  for i ulong 384
    put hdr i get raw i
  end
  plen = uor_get_u32 hdr 24
  if ne sub ulong r 384 plen
    ret -3
  end
  for i ulong plen bound 65536
    put pay i get raw add 384 i
  end
  put out_plen 0 plen
  ret 0
end

fn pg_load_rc rrc long hdr view uchar 384 plvl ulong to int
  if eq rrc -1
    ret pg_open_rc
  end
  if eq rrc -2
    uor_write_all 2 pg_err_short len pg_err_short
    ret 4
  end
  uor_emit_verdict hdr UOR_ERR_PAYLOAD_TAMPER plvl
  ret 1
end

fn pg_cmd_keygen to int
  ab = new uchar 512 0
  sd = new uchar 32 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  rr = random sd 0 32 0
  if ne rr 32
    uor_write_all 2 pg_err_rand len pg_err_rand
    ret 5
  end
  if eq pg_write_file ab n sd 1 0
    ret pg_open_rc
  end
  ret 0
end

fn pg_cmd_pubkey to int
  ab = new uchar 512 0
  sd = new uchar 32 0
  pk = new uchar 32 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n sd 0
    ret pg_open_rc
  end
  ues_pubkey sd pk
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_write_file ab n pk 0 0
    ret pg_open_rc
  end
  ret 0
end

fn pg_cmd_trust to int
  ab = new uchar 512 0
  apk = new uchar 32 0
  spk = new uchar 32 0
  anc = new uchar 136 0
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n apk 0
    ret pg_open_rc
  end
  n = pg_arg 4 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n spk 0
    ret pg_open_rc
  end
  ug_build_anchors anc apk spk
  if eq uor_anchors_nkeys anc 0
    uor_write_all 2 pg_err_anch len pg_err_anch
    ret 1
  end
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_write_file ab n anc 0 0
    ret pg_open_rc
  end
  ret 0
end

fn pg_write_bundle path view uchar * pn ulong hdr view uchar 384 pay view uchar * to int
  fd = fopen path 0 pn PG_CREATE_FLAGS PG_CREATE_MODE
  if lt fd 0
    ret pg_open_rc
  end
  uor_write_all int fd hdr 384
  uor_write_all int fd pay len pay
  cl = fclose int fd
  ok = uor_emit_inspect hdr
  ret 0
end

fn pg_bundle_sm121 path view uchar * pn ulong sd view uchar 32 to int
  hdr = new uchar 384 0
  pay = new uchar 768 0
  ug_emit_sm121_vecadd_qmd pay
  ug_fill_p3_hdr hdr UOR_GPU_ISA_SM121 768
  uor_hdr_seal hdr pay
  ues_sign_hdr hdr sd
  ret pg_write_bundle path pn hdr pay
end

fn pg_bundle_spirv path view uchar * pn ulong sd view uchar 32 to int
  hdr = new uchar 384 0
  pay = new uchar 64 0
  ug_emit_spirv_vadd pay
  ug_fill_p3_hdr hdr UOR_GPU_ISA_SPIRV 64
  uor_hdr_seal hdr pay
  ues_sign_hdr hdr sd
  ret pg_write_bundle path pn hdr pay
end

fn pg_cmd_bundle to int
  tg = new uchar 512 0
  ab = new uchar 512 0
  sd = new uchar 32 0
  tn = pg_arg 2 tg
  n = pg_arg 4 ab
  if or eq tn 0 eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n sd 0
    ret pg_open_rc
  end
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  if ne pg_streq tg tn pg_t_sm121 0
    ret pg_bundle_sm121 ab n sd
  end
  if ne pg_streq tg tn pg_t_spirv 0
    ret pg_bundle_spirv ab n sd
  end
  ret pg_usage_rc
end

fn pg_cmd_inspect to int
  ab = new uchar 512 0
  hdr = new uchar 384 0
  pay = new uchar 65536 0
  pl = new ulong 1 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  rrc = pg_load_bundle ab n hdr pay pl
  if ne rrc 0
    ret pg_load_rc rrc hdr UOR_LVL_P0
  end
  if eq uor_emit_inspect hdr 0
    uor_emit_verdict hdr UOR_ERR_BAD_MAGIC UOR_LVL_P0
    ret 1
  end
  ret 0
end

note mode P2: verify policy; mode P3: P3 policy plus CPU reference replay digest comparison
fn pg_check_run hdr view uchar 384 pay view uchar * anc view uchar * mode ulong to int
  rep = new uchar 32 0
  rc = uor_verify_policy hdr pay anc mode
  if and eq rc UOR_VERDICT_PASS eq mode UOR_LVL_P3
    ug_replay_digest rep
    rc = uor_verify_replay hdr rep
  end
  uor_emit_verdict hdr rc mode
  if eq rc UOR_VERDICT_PASS
    ret 0
  end
  ret 1
end

fn pg_check_run2 hdr view uchar 384 pay view uchar 65536 plen ulong anc view uchar 617 alen ulong mode ulong to int
  ret pg_check_run hdr part pay 0 plen part anc 0 alen mode
end

fn pg_cmd_check mode ulong to int
  ab = new uchar 512 0
  hdr = new uchar 384 0
  pay = new uchar 65536 0
  anc = new uchar 617 0
  pl = new ulong 1 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  rrc = pg_load_bundle ab n hdr pay pl
  if ne rrc 0
    ret pg_load_rc rrc hdr mode
  end
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  an = pg_read_file ab n anc
  if lt an 0
    ret pg_open_rc
  end
  ret pg_check_run2 hdr pay get pl 0 anc ulong an mode
end

fn pg_cmd_grant to int
  ab = new uchar 512 0
  rec = new uchar 64 0
  sd = new uchar 32 0
  g = new uchar 168 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n rec 0
    ret pg_open_rc
  end
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_read_exact ab n sd 0
    ret pg_open_rc
  end
  for i ulong 64
    put g i get rec i
  end
  ues_sign_grant g sd
  n = pg_arg 4 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_write_file ab n part g 0 128 0 0
    ret pg_open_rc
  end
  ret 0
end

note Request of the offline CLI: expected generation = the signed record's own generation
note (offline there is no live caproot table; see gate.om), world epoch, wall clock in seconds,
note CLI subject, GB10 resource.
fn pg_fill_req g edit uchar 168 to void
  uor_put_u64 g 128 uor_get_u64 g 8
  uor_put_u64 g 136 PG_WORLD_EPOCH
  uor_put_u64 g 144 div ulong realns 1000000000
  uor_put_u64 g 152 PG_SUBJECT_CLI
  uor_put_u64 g 160 PG_RES_GB10
end

note Read exactly 128 grant bytes (record || authority signature) into g[0..128). 1 on success.
fn pg_load_grant path view uchar * pn ulong g edit uchar 168 to ulong
  raw = new uchar 128 0
  if eq pg_read_exact path pn raw 0
    ret 0
  end
  for i ulong 128
    put g i get raw i
  end
  ret 1
end

fn pg_admit_run hdr view uchar 384 pay view uchar * anc view uchar * g view uchar 168 to int
  rc = uor_gpu_admit hdr pay anc g
  uor_emit_verdict hdr rc UOR_LVL_P2
  if eq rc UOR_VERDICT_PASS
    ret 0
  end
  ret 1
end

fn pg_admit_run2 hdr view uchar 384 pay view uchar 65536 plen ulong anc view uchar 617 alen ulong g view uchar 168 to int
  ret pg_admit_run hdr part pay 0 plen part anc 0 alen g
end

fn pg_cmd_admit to int
  ab = new uchar 512 0
  hdr = new uchar 384 0
  pay = new uchar 65536 0
  anc = new uchar 617 0
  pl = new ulong 1 0
  g = new uchar 168 0
  n = pg_arg 2 ab
  if eq n 0
    ret pg_usage_rc
  end
  rrc = pg_load_bundle ab n hdr pay pl
  if ne rrc 0
    ret pg_load_rc rrc hdr UOR_LVL_P2
  end
  n = pg_arg 3 ab
  if eq n 0
    ret pg_usage_rc
  end
  an = pg_read_file ab n anc
  if lt an 0
    ret pg_open_rc
  end
  n = pg_arg 4 ab
  if eq n 0
    ret pg_usage_rc
  end
  if eq pg_load_grant ab n g 0
    ret pg_open_rc
  end
  pg_fill_req g
  ret pg_admit_run2 hdr pay get pl 0 anc ulong an g
end

fn main to int
  cmd = new uchar 64 0
  if lt argcnt 3
    ret pg_usage_rc
  end
  cn = argread 1 cmd 0 64
  if le cn 0
    ret pg_usage_rc
  end
  c = ulong cn
  if ne pg_streq cmd c pg_c_keygen 0
    ret pg_cmd_keygen
  end
  if ne pg_streq cmd c pg_c_pubkey 0
    ret pg_cmd_pubkey
  end
  if ne pg_streq cmd c pg_c_trust 0
    ret pg_cmd_trust
  end
  if ne pg_streq cmd c pg_c_bundle 0
    ret pg_cmd_bundle
  end
  if ne pg_streq cmd c pg_c_inspect 0
    ret pg_cmd_inspect
  end
  if ne pg_streq cmd c pg_c_verify 0
    ret pg_cmd_check UOR_LVL_P2
  end
  if ne pg_streq cmd c pg_c_replay 0
    ret pg_cmd_check UOR_LVL_P3
  end
  if ne pg_streq cmd c pg_c_grant 0
    ret pg_cmd_grant
  end
  if ne pg_streq cmd c pg_c_admit 0
    ret pg_cmd_admit
  end
  ret pg_usage_rc
end

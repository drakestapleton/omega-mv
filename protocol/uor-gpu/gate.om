note SPDX-License-Identifier: Apache-2.0
note protocol/uor-gpu/gate.om: Pure seeded OM-2 pre-dispatch GPU admission gate.
note Requires BOTH:
note   1. uor_verify_policy(..., min_level >= P2) == PASS (mandatory Lean 4 proof + intact digests)
note   2. Valid live RX_RIGHT_EFFECT (4) capability for target GPU resource (matching seed/authority/caproot.om)
note Compose after verify.om.

const UOR_CAP_LIVE ulong 1
const UOR_RIGHT_EFFECT ulong 4

note cap_entry[8]: 0=state, 1=generation, 2=epoch, 3=lease_expiry,
note               4=subject, 5=resource, 6=rights, 7=reserved
note cap_req[5]:   0=expected_gen, 1=cur_epoch, 2=cur_clock, 3=subject, 4=resource
fn uor_cap_admit cap_entry view ulong 8 cap_req view ulong 5 to ulong
  if ne get cap_entry 0 UOR_CAP_LIVE
    ret 0
  end
  if ne get cap_entry 1 get cap_req 0
    ret 0
  end
  if ne get cap_entry 2 get cap_req 1
    ret 0
  end
  exp = get cap_entry 3
  if ne exp 0
    if ge get cap_req 2 exp
      ret 0
    end
  end
  if ne get cap_entry 4 get cap_req 3
    ret 0
  end
  if ne get cap_entry 5 get cap_req 4
    ret 0
  end
  if eq and get cap_entry 6 UOR_RIGHT_EFFECT 0
    ret 0
  end
  ret 1
end

note Fail-closed GPU dispatch admission: verifies UOR-GPU-1 bundle + capability grant.
note Returns UOR_VERDICT_PASS (0) only if both verification and capability pass.
fn uor_gpu_admit hdr view uchar 256 pay view uchar * omc_pin view uchar 32 cap_entry view ulong 8 cap_req view ulong 5 to ulong
  rc = uor_verify_policy hdr pay omc_pin UOR_LVL_P2
  if ne rc UOR_VERDICT_PASS
    ret rc
  end
  if eq uor_cap_admit cap_entry cap_req 0
    ret UOR_ERR_CAP_DENIED
  end
  ret UOR_VERDICT_PASS
end

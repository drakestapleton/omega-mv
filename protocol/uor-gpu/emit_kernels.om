note protocol/uor-gpu/emit_kernels.om: Shared pure seeded OM-2 SM121 (SASS+QMD)
note and SPIR-V kernel emitters, ML-BOM digest, golden CPU replay oracle, and pins.
note Zero CUDApp. Compose after canonical.om.

text ug_omc_hex "708fdc0f81866594ed6df2f492b7a8a6bc7456f2d733a838b7f840549ebba6c3"
text ug_lean_hex "4d7f3a830b16502b431ef13b3a7cc499634ddf2d9331d07b99f9b51f47fc0083"
text ug_src_tag "hologram:gpu/omega-om2@1:vecadd:v1"
text ug_mlbom_tag "mlbom:v1:vecadd:f32:4:stateless"
note RFC 8032 s.7.1 public test key (host test attestation only, never a production secret)
text ug_test_pk_hex "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
text ug_sm121_sig_hex "0eb8810c0cb23c7ce548b557bbee38e4fc929339cd3709f7f27e01762b818b3ca99f2dba4edacc929620454a3c17667365c84c957abeab2390da4937c30a3902"
text ug_spirv_sig_hex "72322a17f85ede33143077c3e52a69837e3253a66c7d22e7609eed5cb75a78e11a39a006a3c3c5ae4062da2e93e67f73123794f77db5c011f529b51724e84a01"

fn ug_hex_nib c uchar to ulong
  v = ulong c
  if and ge v 48 le v 57
    ret sub v 48
  end
  ret add 10 sub v 97
end

fn ug_parse_hex32 hx view uchar 64 dst edit uchar 32 to void
  for i ulong 32
    hi = ug_hex_nib get hx mul i 2
    lo = ug_hex_nib get hx add mul i 2 1
    put dst i uchar or shl hi 4 lo
  end
end

fn ug_parse_hex64 hx view uchar 128 dst edit uchar 64 to void
  for i ulong 64
    hi = ug_hex_nib get hx mul i 2
    lo = ug_hex_nib get hx add mul i 2 1
    put dst i uchar or shl hi 4 lo
  end
end

fn ug_emit_w buf edit uchar 768 idx ulong w0 ulong w1 ulong w2 ulong w3 ulong to void
  b = mul idx 16
  uor_put_u32 buf b w0
  uor_put_u32 buf add b 4 w1
  uor_put_u32 buf add b 8 w2
  uor_put_u32 buf add b 12 w3
end

note Emit 512B Blackwell SM121 vecadd machine code + 256B canonical QMD (768B total).
fn ug_emit_sm121_vecadd_qmd buf edit uchar 768 to void
  for k ulong 768
    put buf k uchar 0
  end
  ug_emit_w buf 0 0xff017b82 0x0000df00 0x00000800 0x000fe200
  ug_emit_w buf 1 0x00097919 0x00000000 0x00002500 0x000e2200
  ug_emit_w buf 2 0xff0477ac 0x00006c00 0x08000800 0x000e2200
  ug_emit_w buf 3 0x00007919 0x00000000 0x00002100 0x000e2200
  ug_emit_w buf 4 0xff0577ac 0x00007300 0x08000800 0x000e6200
  ug_emit_w buf 5 0x09097c24 0x00000004 0x0f8e0200 0x001fca00
  ug_emit_w buf 6 0x09007c0c 0x00000005 0x0bf06070 0x002fda00
  ug_emit_w buf 7 0x0000094d 0x00000000 0x03800000 0x000fea00
  ug_emit_w buf 8 0xff027b82 0x0000e000 0x00000a00 0x000e2200
  ug_emit_w buf 9 0xff0477ac 0x00006b00 0x08000a00 0x000e6e00
  ug_emit_w buf 10 0xff047b82 0x0000e200 0x00000a00 0x000eb000
  ug_emit_w buf 11 0xff067b82 0x0000e400 0x00000a00 0x000ee200
  ug_emit_w buf 12 0x09027825 0x00000004 0x078e0002 0x001fcc00
  ug_emit_w buf 13 0x02027981 0x00000004 0x0c1e1900 0x002f2200
  ug_emit_w buf 14 0x09047825 0x00000004 0x078e0004 0x004fcc00
  ug_emit_w buf 15 0x04057981 0x00000004 0x0c1e1900 0x000f2200
  ug_emit_w buf 16 0x09067825 0x00000004 0x078e0006 0x008fe200
  ug_emit_w buf 17 0x02097210 0x00000005 0x07ffe0ff 0x010fca00
  ug_emit_w buf 18 0x06007986 0x00000009 0x0c101904 0x000fe200
  ug_emit_w buf 19 0x0000794d 0x00000000 0x03800000 0x000fea00
  ug_emit_w buf 20 0x00fc7947 0xfffffffc 0x0383ffff 0x000fc000
  i = ulong 21
  while lt i 32 bound 16
    ug_emit_w buf i 0x00007918 0x00000000 0x00000000 0x000fc000
    i = add i 1
  end
  note Canonical QMD v05.00 descriptor header at offset 512..767 (om/gpu/bw_qmd.om)
  uor_put_u32 buf 512 0x00050000
  uor_put_u32 buf 516 256
  uor_put_u32 buf 520 1
  uor_put_u32 buf 524 1
  uor_put_u32 buf 528 0
  uor_put_u32 buf 532 512
end

note Emit canonical SPIR-V 1.0 OpenCL Kernel module (64 bytes, valid header+caps+entry).
fn ug_emit_spirv_vadd buf edit uchar 64 to void
  uor_put_u32 buf 0 0x07230203
  uor_put_u32 buf 4 0x00010000
  uor_put_u32 buf 8 0x00000000
  uor_put_u32 buf 12 0x00000010
  uor_put_u32 buf 16 0x00000000
  uor_put_u32 buf 20 0x00020011
  uor_put_u32 buf 24 0x00000006
  uor_put_u32 buf 28 0x00020011
  uor_put_u32 buf 32 0x00000004
  uor_put_u32 buf 36 0x0003000e
  uor_put_u32 buf 40 0x00000002
  uor_put_u32 buf 44 0x00000002
  uor_put_u32 buf 48 0x0004000f
  uor_put_u32 buf 52 0x00000006
  uor_put_u32 buf 56 0x00000005
  uor_put_u32 buf 60 0x64646176
end

note Pure OM-2 CPU reference oracle for vecadd golden replay vector (4 x u32).
fn ug_replay_digest dst32 edit uchar 32 to void
  vec = new uchar 16 0
  for i ulong 4
    a = add mul i 3 10
    b = add mul i 5 20
    uor_put_u32 vec mul i 4 add a b
  end
  d = sha2_digest 256 vec dst32
  if ne d 32
    trap 8
  end
end

note Populate standard P3 header fields (omc_pin, src, lean_proof, replay, mlbom).
fn ug_fill_p3_hdr hdr edit uchar 384 isa ulong plen ulong to void
  omc_pin = new uchar 32 0
  lean_dig = new uchar 32 0
  src_dig = new uchar 32 0
  rep_dig = new uchar 32 0
  mb_dig = new uchar 32 0
  meta = new ulong 5 0
  for i ulong 384
    put hdr i uchar 0
  end
  ug_parse_hex32 ug_omc_hex omc_pin
  ug_parse_hex32 ug_lean_hex lean_dig
  sd = sha2_digest 256 ug_src_tag src_dig
  md = sha2_digest 256 ug_mlbom_tag mb_dig
  if or ne sd 32 ne md 32
    trap 8
  end
  ug_replay_digest rep_dig
  put meta 0 isa
  put meta 1 UOR_GPU_MATH_RN
  put meta 2 UOR_LVL_P3
  put meta 3 plen
  put meta 4 256
  uor_hdr_write_meta hdr meta
  uor_copy32 hdr 32 omc_pin 0
  uor_copy32 hdr 64 src_dig 0
  uor_copy32 hdr 128 lean_dig 0
  uor_copy32 hdr 160 rep_dig 0
  uor_copy32 hdr 192 mb_dig 0
end

note Attach test-only RFC 8032 Ed25519 attestation signature after uor_hdr_seal.
fn ug_attach_test_sig hdr edit uchar 384 isa ulong to void
  pk = new uchar 32 0
  sg = new uchar 64 0
  ug_parse_hex32 ug_test_pk_hex pk
  if eq isa UOR_GPU_ISA_SM121
    ug_parse_hex64 ug_sm121_sig_hex sg
  else
    ug_parse_hex64 ug_spirv_sig_hex sg
  end
  uor_copy32 hdr 288 pk 0
  for i ulong 64
    put hdr add 320 i get sg i
  end
end

note SPDX-License-Identifier: Apache-2.0
note protocol/open-humanity/trace_receiver_main.om
note Standalone pure-Omega CLI for the Open Humanity exact-byte wire codec, consent/export,
note and AITR v1 trace-receiver contract.
note Compose with:
note   si/directives/om2.om protocol/open-humanity/lib.om
note   protocol/omnet/om/sha512/sha512.om protocol/omnet/om/ed25519/ed25519.om
note   protocol/open-humanity/trace_contract.om protocol/open-humanity/trace_receiver_main.om
note Subcommands:
note   version    print contract version and wire framing details
note   selfcheck  execute signed OHCN v1 consent -> AITR v1 export -> OHTX v1 receive + Register verify
note   wire-check print hex of canonical Challenge, Ack, and keyed BLAKE3 cookie for parity checks

text trm_ver "open-humanity-trace-om 1.0 (wire=0x4f-v1, consent=OHCN-v1, export=OHTX-v1, trace=AITR-v1)\n"
text trm_usage "usage: open-humanity-trace version|selfcheck|wire-check\n"
text trm_cmd_ver "version"
text trm_cmd_sc "selfcheck"
text trm_cmd_wc "wire-check"
text trm_ok "TRACE_RECEIVER SELFCHECK PASS bundle_bytes="
text trm_seg " recv_aitr_bytes="
text trm_fail "TRACE_RECEIVER SELFCHECK FAIL code="
text trm_ck_lbl "COOKIE="
text trm_ch_lbl "CHALLENGE="
text trm_ak_lbl "ACK="
text trm_rg_lbl "REGISTER="
text trm_nl "\n"
text trm_addr "192.0.2.1:4000"
text trm_pay0 "sm121_ok lat=400us"

global trm_arg uchar 64

fn trm_arg_eq idx ulong lit view uchar * to bool
n = argread idx trm_arg 0 64
if lt n 0
ret false
end
un = ulong n
if ne un len lit
ret false
end
for i ulong un bound 64
if ne get trm_arg i get lit i
ret false
end
end
ret true
end

fn trm_write_hex buf view uchar * to void
n = len buf
out_h = new uchar 2 0
for i ulong n bound 512
bv = ulong get buf i
put out_h 0 get oh_hex_chars shr bv 4
put out_h 1 get oh_hex_chars and bv 15
ok = oh_write_all 1 out_h
if not ok
ret
end
end
end

fn trm_wire_check_reg ck view uchar 16 now ulong to bool
seed = new uchar 32 17
rg = new uchar 133 0
rn = ohw_encode_register seed now uchar 5 uchar 1 ck rg
ok = oh_write_all 1 trm_rg_lbl
trm_write_hex rg
ok = oh_write_all 1 trm_nl
ret eq rn 133
end

fn trm_wire_check to int
secret = new uchar 32 9
now = ulong 1000000
ck = new uchar 16 0
ohw_relay_cookie secret trm_addr div now OHW_COOKIE_WINDOW ck
ch = new uchar 19 0
cn = ohw_encode_challenge ck ch
ak = new uchar 8 0
an = ohw_encode_ack uchar 3 120 ak
ok = oh_write_all 1 trm_ck_lbl
trm_write_hex ck
ok = oh_write_all 1 trm_nl
ok = oh_write_all 1 trm_ch_lbl
trm_write_hex ch
ok = oh_write_all 1 trm_nl
ok = oh_write_all 1 trm_ak_lbl
trm_write_hex ak
ok = oh_write_all 1 trm_nl
if not trm_wire_check_reg ck now
ret 1
end
if and eq cn 19 eq an 8
ret 0
end
ret 1
end

fn trm_selfcheck to int
ohtx_reset_replay
nseed = new uchar 32 31
rseed = new uchar 32 32
rpk = new uchar 32 0
ohtx_ed_pubkey rseed rpk
now = ulong 1700000000
consent = new uchar 160 0
ohtx_sign_consent nseed rpk 2 add now 3600 0 consent
seg = new uchar 80 0
ohtx_aitr_write_hdr seg
rc = ohtx_aitr_write_rec seg 16 or ulong 1 shl ulong 0 16 trm_pay0
if ne rc OHTX_OK
ret 1
end
bid = new uchar 16 55
ohtx_set_bundle_id bid
bundle = new uchar 4408 0
rc = oh_trace_export nseed consent seg now bundle
if ne rc OHTX_OK
ok = oh_write_all 1 trm_fail
oh_write_u64 1 rc
ok = oh_write_all 1 trm_nl
ret 1
end
blen = ohtx_export_len
out_seg = new uchar 256 0
rc = oh_trace_receive part bundle 0 blen rpk now out_seg
if ne rc OHTX_OK
ok = oh_write_all 1 trm_fail
oh_write_u64 1 rc
ok = oh_write_all 1 trm_nl
ret 1
end
ok = oh_write_all 1 trm_ok
oh_write_u64 1 blen
ok = oh_write_all 1 trm_seg
oh_write_u64 1 ohtx_recv_len
ok = oh_write_all 1 trm_nl
ret 0
end

fn main to int
ac = argcnt
if lt ac 2
ok = oh_write_all 2 trm_usage
ret 2
end
if trm_arg_eq 1 trm_cmd_ver
ok = oh_write_all 1 trm_ver
ret 0
end
if trm_arg_eq 1 trm_cmd_sc
ret trm_selfcheck
end
if trm_arg_eq 1 trm_cmd_wc
ret trm_wire_check
end
ok = oh_write_all 2 trm_usage
ret 2
end

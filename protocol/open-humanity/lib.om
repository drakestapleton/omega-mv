note SPDX-License-Identifier: Apache-2.0
note protocol/open-humanity/lib.om: pure-Omega opt-in, privacy-first peer assistance protocol.
note Derived from open-humanity (beacon-core wire/schema/firewall + beacon relay queue/audit).
note Enforces explicit opt-in consent, strict zero-authority boundary (never grants local exec,
note secret access, identity mutation, or admin rights), deterministic Personal Data Firewall
note with obfuscation decoding and path scrubbing, TTL/replay guards, bounded peer assistance
note queue, and append-only resolution audit trail. Library unit: no om2 directive, no fn main.

const OH_MAGIC_0 ulong 0x4f
const OH_MAGIC_1 ulong 0x48
const OH_VERSION ulong 1
const OH_HDR_LEN ulong 48
const OH_MAX_PAYLOAD ulong 512
const OH_MAX_WIRE ulong 560

const OH_CAT_RUST ulong 0
const OH_CAT_SIMD ulong 1
const OH_CAT_SERVING ulong 2
const OH_CAT_HW ulong 3
const OH_CAT_SEC ulong 4
const OH_CAT_PROTO ulong 5
const OH_CAT_AGENT ulong 6
const OH_CAT_MAX ulong 6

const OH_MAX_TTL_MS ulong 604800000
const OH_MAX_FUTURE_DRIFT_MS ulong 300000

const OH_CAP_NONE ulong 0
const OH_CAP_LOCAL_EXEC ulong 1
const OH_CAP_SECRET_ACCESS ulong 2
const OH_CAP_IDENTITY_MUTATE ulong 4
const OH_CAP_ADMIN_RIGHTS ulong 8

const OH_OK ulong 0
const OH_ERR_BAD_MAGIC ulong 1
const OH_ERR_BAD_VERSION ulong 2
const OH_ERR_TRUNCATED ulong 3
const OH_ERR_BAD_DIGEST ulong 4
const OH_ERR_BAD_PEER ulong 5
const OH_ERR_BAD_CATEGORY ulong 6
const OH_ERR_NODE_OPT_OUT ulong 10
const OH_ERR_NO_CONSENT ulong 11
const OH_ERR_TTL_INVALID ulong 20
const OH_ERR_TTL_EXPIRED ulong 21
const OH_ERR_FUTURE_DRIFT ulong 22
const OH_ERR_AUTH_EXEC ulong 30
const OH_ERR_AUTH_SECRET ulong 31
const OH_ERR_AUTH_IDENTITY ulong 32
const OH_ERR_AUTH_ADMIN ulong 33
const OH_ERR_AUTH_UNKNOWN ulong 34
const OH_ERR_AUTH_PAYLOAD_ESC ulong 35
const OH_ERR_PRIV_AWS_KEY ulong 40
const OH_ERR_PRIV_GITHUB_TOKEN ulong 41
const OH_ERR_PRIV_ANTHROPIC_KEY ulong 42
const OH_ERR_PRIV_OPENAI_KEY ulong 43
const OH_ERR_PRIV_GOOGLE_KEY ulong 44
const OH_ERR_PRIV_STRIPE_KEY ulong 45
const OH_ERR_PRIV_HF_TOKEN ulong 46
const OH_ERR_PRIV_PEM_KEY ulong 47
const OH_ERR_PRIV_GENERIC_SECRET ulong 48
const OH_ERR_PRIV_USER_PATH ulong 49
const OH_ERR_PRIV_TRAVERSAL ulong 50
const OH_ERR_REPLAY ulong 60
const OH_ERR_QUEUE_FULL ulong 61
const OH_ERR_REQ_NOT_FOUND ulong 62
const OH_ERR_REQ_ALREADY_RESOLVED ulong 63
const OH_ERR_SELF_RESOLVE ulong 64
const OH_ERR_EMPTY_PAYLOAD ulong 65

const OH_QUEUE_CAP ulong 32
const OH_AUDIT_CAP ulong 64
const OH_SEEN_CAP ulong 64

const OH_Q_EMPTY ulong 0
const OH_Q_PENDING ulong 1
const OH_Q_RESOLVED ulong 2
const OH_Q_EXPIRED ulong 3

const OH_AUD_ENQUEUED ulong 1
const OH_AUD_RESOLVED ulong 2
const OH_AUD_REFUSED ulong 3
const OH_AUD_EXPIRED ulong 4

struct OhEnv version ulong peer_id ulong consent ulong category ulong created_ms ulong ttl_ms ulong cap_flags ulong digest ulong payload_len ulong end
struct OhPolicy opt_in ulong now_ms ulong next_req_id ulong audit_seq ulong seen_head ulong end

global oh_q_status ulong 32
global oh_q_req_id ulong 32
global oh_q_peer_id ulong 32
global oh_q_cat ulong 32
global oh_q_created ulong 32
global oh_q_ttl ulong 32
global oh_q_digest ulong 32
global oh_q_helper ulong 32
global oh_q_plen ulong 32
global oh_q_payload uchar 16384

global oh_seen_peer ulong 64
global oh_seen_dig ulong 64

global oh_aud_seq ulong 64
global oh_aud_kind ulong 64
global oh_aud_peer ulong 64
global oh_aud_req ulong 64
global oh_aud_cat ulong 64
global oh_aud_code ulong 64
global oh_aud_ts ulong 64
global oh_aud_dig ulong 64
global oh_aud_cnt ulong 1

text oh_hex_chars "0123456789abcdef"
text oh_t_pem_beg "-----BEGIN "
text oh_t_pem_end "PRIVATE KEY-----"
text oh_t_akia "AKIA"
text oh_t_sk_ant "sk-ant-"
text oh_t_sk "sk-"
text oh_t_aiza "AIza"
text oh_t_hf "hf_"
text oh_t_live "live_"
text oh_t_test "test_"
text oh_t_home "/home/"
text oh_t_users "/Users/"
text oh_t_wusers ":\\Users\\"
text oh_t_wusers2 ":/Users/"
text oh_t_ak_api "api_key"
text oh_t_ak_apikey "apikey"
text oh_t_ak_sec "secret_key"
text oh_t_ak_priv "private_key"
text oh_t_ak_auth "auth_token"
text oh_t_ak_bear "bearer"

text oh_t_esc_sudo "sudo "
text oh_t_esc_chmod "chmod "
text oh_t_esc_chown "chown "
text oh_t_esc_ident "open_humanity_identity"
text oh_t_esc_seed "identity_seed="
text oh_t_esc_admin "grant_admin"

text oh_r_ok "ok"
text oh_r_magic "bad_magic"
text oh_r_ver "bad_version"
text oh_r_trunc "truncated"
text oh_r_dig "bad_digest"
text oh_r_peer "bad_peer_id"
text oh_r_cat "bad_category"
text oh_r_optout "node_opt_out"
text oh_r_noconsent "missing_consent"
text oh_r_ttlinv "ttl_invalid"
text oh_r_ttlexp "ttl_expired"
text oh_r_drift "future_timestamp_drift"
text oh_r_aexec "authority_refused_local_exec"
text oh_r_asec "authority_refused_secret_access"
text oh_r_aid "authority_refused_identity_mutate"
text oh_r_aadm "authority_refused_admin_rights"
text oh_r_aunk "authority_refused_unknown_cap"
text oh_r_aesc "authority_refused_payload_escalation"
text oh_r_paws "privacy_refused_aws_key"
text oh_r_pgh "privacy_refused_github_token"
text oh_r_pant "privacy_refused_anthropic_key"
text oh_r_poai "privacy_refused_openai_key"
text oh_r_pgoo "privacy_refused_google_key"
text oh_r_pstr "privacy_refused_stripe_key"
text oh_r_phf "privacy_refused_hf_token"
text oh_r_ppem "privacy_refused_private_key_block"
text oh_r_pgen "privacy_refused_generic_secret"
text oh_r_ppath "privacy_refused_private_user_path"
text oh_r_ptrav "privacy_refused_path_traversal"
text oh_r_rep "replay_detected"
text oh_r_qfull "queue_full"
text oh_r_nf "request_not_found"
text oh_r_alr "request_already_resolved"
text oh_r_self "self_resolution_refused"
text oh_r_empty "empty_payload"
text oh_r_unk "unknown_error"

fn oh_write_all fd int buf view uchar * to bool
n = len buf
pos = ulong 0
while lt pos n bound 65536
k = write fd buf pos sub n pos
if le k 0
ret false
end
pos = add pos ulong k
end
ret true
end

fn oh_write_u64 fd int v ulong to void
digits = new uchar 24 0
if eq v 0
put digits 0 uchar 48
ok0 = oh_write_all fd part digits 0 1
if ok0
ret
end
ret
end
tmp = new uchar 24 0
cnt = ulong 0
x = v
while gt x 0 bound 24
d = rem x 10
put tmp cnt uchar add 48 d
cnt = add cnt 1
x = div x 10
end
i = ulong 0
while lt i cnt bound 24
put digits i get tmp sub sub cnt 1 i
i = add i 1
end
ok1 = oh_write_all fd part digits 0 cnt
if ok1
ret
end
end

fn oh_write_hex64 fd int v ulong to void
buf = new uchar 16 48
i = ulong 0
while lt i 16 bound 16
sh = mul sub 15 i 4
nib = and shr v sh 0xf
put buf i get oh_hex_chars nib
i = add i 1
end
ok = oh_write_all fd buf
if ok
ret
end
end

fn oh_write_reason fd int code ulong to void
ok = false
if eq code OH_OK
ok = oh_write_all fd oh_r_ok
else
if eq code OH_ERR_BAD_MAGIC
ok = oh_write_all fd oh_r_magic
else
if eq code OH_ERR_BAD_VERSION
ok = oh_write_all fd oh_r_ver
else
if eq code OH_ERR_TRUNCATED
ok = oh_write_all fd oh_r_trunc
else
if eq code OH_ERR_BAD_DIGEST
ok = oh_write_all fd oh_r_dig
else
if eq code OH_ERR_BAD_PEER
ok = oh_write_all fd oh_r_peer
else
if eq code OH_ERR_BAD_CATEGORY
ok = oh_write_all fd oh_r_cat
else
if eq code OH_ERR_NODE_OPT_OUT
ok = oh_write_all fd oh_r_optout
else
if eq code OH_ERR_NO_CONSENT
ok = oh_write_all fd oh_r_noconsent
else
if eq code OH_ERR_TTL_INVALID
ok = oh_write_all fd oh_r_ttlinv
else
if eq code OH_ERR_TTL_EXPIRED
ok = oh_write_all fd oh_r_ttlexp
else
if eq code OH_ERR_FUTURE_DRIFT
ok = oh_write_all fd oh_r_drift
else
ok = oh_write_reason_hi fd code
end
end
end
end
end
end
end
end
end
end
end
end
if ok
ret
end
end

fn oh_write_reason_hi fd int code ulong to bool
if eq code OH_ERR_AUTH_EXEC
ret oh_write_all fd oh_r_aexec
end
if eq code OH_ERR_AUTH_SECRET
ret oh_write_all fd oh_r_asec
end
if eq code OH_ERR_AUTH_IDENTITY
ret oh_write_all fd oh_r_aid
end
if eq code OH_ERR_AUTH_ADMIN
ret oh_write_all fd oh_r_aadm
end
if eq code OH_ERR_AUTH_UNKNOWN
ret oh_write_all fd oh_r_aunk
end
if eq code OH_ERR_AUTH_PAYLOAD_ESC
ret oh_write_all fd oh_r_aesc
end
if eq code OH_ERR_PRIV_AWS_KEY
ret oh_write_all fd oh_r_paws
end
if eq code OH_ERR_PRIV_GITHUB_TOKEN
ret oh_write_all fd oh_r_pgh
end
if eq code OH_ERR_PRIV_ANTHROPIC_KEY
ret oh_write_all fd oh_r_pant
end
if eq code OH_ERR_PRIV_OPENAI_KEY
ret oh_write_all fd oh_r_poai
end
if eq code OH_ERR_PRIV_GOOGLE_KEY
ret oh_write_all fd oh_r_pgoo
end
if eq code OH_ERR_PRIV_STRIPE_KEY
ret oh_write_all fd oh_r_pstr
end
if eq code OH_ERR_PRIV_HF_TOKEN
ret oh_write_all fd oh_r_phf
end
if eq code OH_ERR_PRIV_PEM_KEY
ret oh_write_all fd oh_r_ppem
end
if eq code OH_ERR_PRIV_GENERIC_SECRET
ret oh_write_all fd oh_r_pgen
end
if eq code OH_ERR_PRIV_USER_PATH
ret oh_write_all fd oh_r_ppath
end
if eq code OH_ERR_PRIV_TRAVERSAL
ret oh_write_all fd oh_r_ptrav
end
if eq code OH_ERR_REPLAY
ret oh_write_all fd oh_r_rep
end
if eq code OH_ERR_QUEUE_FULL
ret oh_write_all fd oh_r_qfull
end
if eq code OH_ERR_REQ_NOT_FOUND
ret oh_write_all fd oh_r_nf
end
if eq code OH_ERR_REQ_ALREADY_RESOLVED
ret oh_write_all fd oh_r_alr
end
if eq code OH_ERR_SELF_RESOLVE
ret oh_write_all fd oh_r_self
end
if eq code OH_ERR_EMPTY_PAYLOAD
ret oh_write_all fd oh_r_empty
end
ret oh_write_all fd oh_r_unk
end

fn oh_reset_state pol edit OhPolicy to void
put pol opt_in ulong 0
put pol now_ms ulong 0
put pol next_req_id ulong 1
put pol audit_seq ulong 0
put pol seen_head ulong 0
i = ulong 0
while lt i OH_QUEUE_CAP bound 64
put oh_q_status i OH_Q_EMPTY
put oh_q_req_id i ulong 0
put oh_q_peer_id i ulong 0
put oh_q_cat i ulong 0
put oh_q_created i ulong 0
put oh_q_ttl i ulong 0
put oh_q_digest i ulong 0
put oh_q_helper i ulong 0
put oh_q_plen i ulong 0
i = add i 1
end
j = ulong 0
while lt j OH_SEEN_CAP bound 64
put oh_seen_peer j ulong 0
put oh_seen_dig j ulong 0
j = add j 1
end
k = ulong 0
while lt k OH_AUDIT_CAP bound 64
put oh_aud_seq k ulong 0
put oh_aud_kind k ulong 0
put oh_aud_peer k ulong 0
put oh_aud_req k ulong 0
put oh_aud_cat k ulong 0
put oh_aud_code k ulong 0
put oh_aud_ts k ulong 0
put oh_aud_dig k ulong 0
k = add k 1
end
put oh_aud_cnt 0 ulong 0
end

fn oh_fnv1a_byte h ulong b uchar to ulong
x = xor h ulong b
ret mul x ulong 0x100000001b3
end

fn oh_fnv1a_u64 h ulong v ulong to ulong
acc = h
i = ulong 0
while lt i 8 bound 8
b = uchar and shr v mul i 8 0xff
acc = oh_fnv1a_byte acc b
i = add i 1
end
ret acc
end

fn oh_compute_digest env view OhEnv payload view uchar * to ulong
h = ulong 0xcbf29ce484222325
h = oh_fnv1a_byte h uchar OH_MAGIC_0
h = oh_fnv1a_byte h uchar OH_MAGIC_1
h = oh_fnv1a_byte h uchar and get env version 0xff
h = oh_fnv1a_byte h uchar and get env consent 0xff
h = oh_fnv1a_byte h uchar and get env category 0xff
h = oh_fnv1a_byte h uchar 0
h = oh_fnv1a_u64 h get env peer_id
h = oh_fnv1a_u64 h get env created_ms
h = oh_fnv1a_u64 h get env ttl_ms
h = oh_fnv1a_u64 h get env cap_flags
n = len payload
h = oh_fnv1a_u64 h n
i = ulong 0
while lt i n bound 1024
h = oh_fnv1a_byte h get payload i
i = add i 1
end
ret h
end

fn oh_put_u64_le dst edit uchar * off ulong v ulong to void
i = ulong 0
while lt i 8 bound 8
put dst add off i uchar and shr v mul i 8 0xff
i = add i 1
end
end

fn oh_get_u64_le src view uchar * off ulong to ulong
acc = ulong 0
i = ulong 0
while lt i 8 bound 8
b = ulong get src add off i
acc = or acc shl b mul i 8
i = add i 1
end
ret acc
end

fn oh_serialize_envelope env view OhEnv payload view uchar * dst edit uchar * to ulong
plen = len payload
if gt plen OH_MAX_PAYLOAD
ret ulong 0
end
total = add OH_HDR_LEN plen
if gt total len dst
ret ulong 0
end
dig = oh_compute_digest env payload
put dst 0 uchar OH_MAGIC_0
put dst 1 uchar OH_MAGIC_1
put dst 2 uchar and get env version 0xff
put dst 3 uchar and get env consent 0xff
put dst 4 uchar and get env category 0xff
put dst 5 uchar 0
oh_put_u64_le dst 6 get env peer_id
oh_put_u64_le dst 14 get env created_ms
oh_put_u64_le dst 22 get env ttl_ms
oh_put_u64_le dst 30 get env cap_flags
oh_put_u64_le dst 38 dig
put dst 46 uchar and plen 0xff
put dst 47 uchar and shr plen 8 0xff
i = ulong 0
while lt i plen bound 512
put dst add OH_HDR_LEN i get payload i
i = add i 1
end
ret total
end

fn oh_parse_envelope wire view uchar * env edit OhEnv dst_payload edit uchar * to ulong
n = len wire
if lt n OH_HDR_LEN
ret OH_ERR_TRUNCATED
end
if or ne ulong get wire 0 OH_MAGIC_0 ne ulong get wire 1 OH_MAGIC_1
ret OH_ERR_BAD_MAGIC
end
ver = ulong get wire 2
if ne ver OH_VERSION
ret OH_ERR_BAD_VERSION
end
plen = or ulong get wire 46 shl ulong get wire 47 8
if gt plen OH_MAX_PAYLOAD
ret OH_ERR_TRUNCATED
end
if ne add OH_HDR_LEN plen n
ret OH_ERR_TRUNCATED
end
if gt plen len dst_payload
ret OH_ERR_TRUNCATED
end
put env version ver
put env consent ulong get wire 3
put env category ulong get wire 4
put env peer_id oh_get_u64_le wire 6
put env created_ms oh_get_u64_le wire 14
put env ttl_ms oh_get_u64_le wire 22
put env cap_flags oh_get_u64_le wire 30
wire_dig = oh_get_u64_le wire 38
put env digest wire_dig
put env payload_len plen
i = ulong 0
while lt i plen bound 512
put dst_payload i get wire add OH_HDR_LEN i
i = add i 1
end
want_dig = oh_compute_digest env part dst_payload 0 plen
if ne wire_dig want_dig
ret OH_ERR_BAD_DIGEST
end
ret OH_OK
end

note --- Character & token classification helpers for Personal Data Firewall ---

fn oh_is_digit c uchar to bool
ret and ge c 48 le c 57
end

fn oh_is_upper c uchar to bool
ret and ge c 65 le c 90
end

fn oh_is_lower c uchar to bool
ret and ge c 97 le c 122
end

fn oh_is_alpha c uchar to bool
ret or oh_is_upper c oh_is_lower c
end

fn oh_is_alnum c uchar to bool
ret or oh_is_alpha c oh_is_digit c
end

fn oh_is_tok_char c uchar to bool
ret or oh_is_alnum c or eq c 95 eq c 45
end

fn oh_is_path_char c uchar to bool
ret or oh_is_alnum c or eq c 46 or eq c 95 eq c 45
end

fn oh_to_lower c uchar to uchar
if oh_is_upper c
ret add c 32
end
ret c
end

fn oh_hex_val c uchar to ulong
if and ge c 48 le c 57
ret ulong sub c 48
end
if and ge c 65 le c 70
ret add ulong sub c 65 10
end
if and ge c 97 le c 102
ret add ulong sub c 97 10
end
ret ulong 255
end

fn oh_match_at buf view uchar * pos ulong pat view uchar * to bool
pn = len pat
if gt add pos pn len buf
ret false
end
i = ulong 0
while lt i pn bound 64
if ne get buf add pos i get pat i
ret false
end
i = add i 1
end
ret true
end

fn oh_match_ci_at buf view uchar * pos ulong pat view uchar * to bool
pn = len pat
if gt add pos pn len buf
ret false
end
i = ulong 0
while lt i pn bound 64
if ne oh_to_lower get buf add pos i oh_to_lower get pat i
ret false
end
i = add i 1
end
ret true
end

fn oh_count_upper_alnum buf view uchar * pos ulong to ulong
n = len buf
i = pos
cnt = ulong 0
while lt i n bound 512
c = get buf i
if or oh_is_digit c oh_is_upper c
cnt = add cnt 1
i = add i 1
else
break
end
end
ret cnt
end

fn oh_count_alnum_u buf view uchar * pos ulong to ulong
n = len buf
i = pos
cnt = ulong 0
while lt i n bound 512
c = get buf i
if or oh_is_alnum c eq c 95
cnt = add cnt 1
i = add i 1
else
break
end
end
ret cnt
end

fn oh_count_tok buf view uchar * pos ulong to ulong
n = len buf
i = pos
cnt = ulong 0
while lt i n bound 512
if oh_is_tok_char get buf i
cnt = add cnt 1
i = add i 1
else
break
end
end
ret cnt
end

fn oh_count_alnum buf view uchar * pos ulong to ulong
n = len buf
i = pos
cnt = ulong 0
while lt i n bound 512
if oh_is_alnum get buf i
cnt = add cnt 1
i = add i 1
else
break
end
end
ret cnt
end

fn oh_is_zw_at buf view uchar * pos ulong to ulong
n = len buf
b0 = get buf pos
if and eq b0 0xc2 lt add pos 1 n
if eq get buf add pos 1 0xad
ret ulong 2
end
end
if lt add pos 2 n
b1 = get buf add pos 1
b2 = get buf add pos 2
if and eq b0 0xe2 eq b1 0x80
if or eq b2 0x8b or eq b2 0x8c eq b2 0x8d
ret ulong 3
end
end
if and eq b0 0xe2 and eq b1 0x81 eq b2 0xa0
ret ulong 3
end
if and eq b0 0xef and eq b1 0xbb eq b2 0xbf
ret ulong 3
end
end
ret ulong 0
end

fn oh_normalize_obfuscation src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
i = ulong 0
out_n = ulong 0
while lt i n bound 1024
zw = oh_is_zw_at src i
if gt zw 0
i = add i zw
continue
end
b = get src i
if and eq b 37 lt add i 2 n
hi = oh_hex_val get src add i 1
lo = oh_hex_val get src add i 2
if and lt hi 16 lt lo 16
if lt out_n cap
put dst out_n uchar or shl hi 4 lo
out_n = add out_n 1
end
i = add i 3
continue
end
end
if lt out_n cap
put dst out_n b
out_n = add out_n 1
end
i = add i 1
end
ret out_n
end

fn oh_leet_char c uchar to uchar
if eq c 48
ret uchar 111
end
if or eq c 49 eq c 33
ret uchar 105
end
if eq c 51
ret uchar 101
end
if or eq c 52 eq c 64
ret uchar 97
end
if or eq c 53 eq c 36
ret uchar 115
end
if eq c 55
ret uchar 116
end
ret c
end

fn oh_normalize_leet src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
if gt n cap
n = cap
end
i = ulong 0
while lt i n bound 1024
put dst i oh_leet_char get src i
i = add i 1
end
ret n
end

fn oh_check_gh_at buf view uchar * pos ulong to bool
if gt add pos 40 len buf
ret false
end
if ne get buf pos 103
ret false
end
if ne get buf add pos 1 104
ret false
end
c2 = get buf add pos 2
ok2 = or eq c2 112 or eq c2 111 or eq c2 117 or eq c2 115 eq c2 114
if not ok2
ret false
end
if ne get buf add pos 3 95
ret false
end
ret ge oh_count_alnum_u buf add pos 4 36
end

fn oh_check_stripe_at buf view uchar * pos ulong to bool
if gt add pos 32 len buf
ret false
end
c0 = get buf pos
if not or eq c0 115 eq c0 114
ret false
end
if ne get buf add pos 1 107
ret false
end
if ne get buf add pos 2 95
ret false
end
ok_kind = oh_match_at buf add pos 3 oh_t_live
if not ok_kind
ok_kind = oh_match_at buf add pos 3 oh_t_test
end
if not ok_kind
ret false
end
ret ge oh_count_alnum buf add pos 8 24
end

fn oh_is_b64_tok c uchar to bool
if oh_is_tok_char c
ret true
end
if eq c 43
ret true
end
if eq c 61
ret true
end
ret eq c 47
end

fn oh_skip_hws buf view uchar * pos ulong to ulong
n = len buf
p = pos
while lt p n bound 64
c = get buf p
if or eq c 32 eq c 9
p = add p 1
else
break
end
end
ret p
end

fn oh_check_generic_at buf view uchar * pos ulong keylen ulong to bool
n = len buf
p = oh_skip_hws buf add pos keylen
if ge p n
ret false
end
sep = get buf p
if not or eq sep 61 eq sep 58
ret false
end
p = oh_skip_hws buf add p 1
if ge p n
ret false
end
q = get buf p
if not or eq q 34 eq q 39
ret false
end
p = add p 1
cnt = ulong 0
while lt p n bound 256
c = get buf p
if eq c q
ret ge cnt 16
end
if not oh_is_b64_tok c
ret false
end
cnt = add cnt 1
p = add p 1
end
ret false
end

fn oh_scan_generic_secret buf view uchar * to bool
n = len buf
i = ulong 0
while lt i n bound 1024
if oh_match_ci_at buf i oh_t_ak_api
if oh_check_generic_at buf i len oh_t_ak_api
ret true
end
end
if oh_match_ci_at buf i oh_t_ak_apikey
if oh_check_generic_at buf i len oh_t_ak_apikey
ret true
end
end
if oh_match_ci_at buf i oh_t_ak_sec
if oh_check_generic_at buf i len oh_t_ak_sec
ret true
end
end
if oh_match_ci_at buf i oh_t_ak_priv
if oh_check_generic_at buf i len oh_t_ak_priv
ret true
end
end
if oh_match_ci_at buf i oh_t_ak_auth
if oh_check_generic_at buf i len oh_t_ak_auth
ret true
end
end
if oh_match_ci_at buf i oh_t_ak_bear
if oh_check_generic_at buf i len oh_t_ak_bear
ret true
end
end
i = add i 1
end
ret false
end

fn oh_user_path_len buf view uchar * pos ulong to ulong
n = len buf
plen = ulong 0
sep = uchar 47
if oh_match_at buf pos oh_t_home
plen = len oh_t_home
else
if oh_match_at buf pos oh_t_users
plen = len oh_t_users
else
if and oh_is_alpha get buf pos lt add pos 9 n
if oh_match_ci_at buf add pos 1 oh_t_wusers
plen = ulong 9
sep = uchar 92
else
if oh_match_ci_at buf add pos 1 oh_t_wusers2
plen = ulong 9
sep = uchar 47
end
end
end
end
end
if eq plen 0
ret ulong 0
end
p = add pos plen
ulen = ulong 0
while lt p n bound 128
c = get buf p
if oh_is_path_char c
ulen = add ulen 1
p = add p 1
else
break
end
end
if and gt ulen 0 lt p n
if eq get buf p sep
ret sub add p 1 pos
end
end
ret ulong 0
end

fn oh_scan_secrets_raw buf view uchar * to ulong
n = len buf
i = ulong 0
while lt i n bound 1024
c = get buf i
note AWS Access Key: AKIA[0-9A-Z]{16}
if eq c 65
if oh_match_at buf i oh_t_akia
if ge oh_count_upper_alnum buf add i 4 16
ret OH_ERR_PRIV_AWS_KEY
end
end
if oh_match_at buf i oh_t_aiza
if ge oh_count_tok buf add i 4 30
ret OH_ERR_PRIV_GOOGLE_KEY
end
end
end
note GitHub PAT
if eq c 103
if oh_check_gh_at buf i
ret OH_ERR_PRIV_GITHUB_TOKEN
end
end
note Anthropic / OpenAI / Stripe keys
if or eq c 115 eq c 114
if oh_check_stripe_at buf i
ret OH_ERR_PRIV_STRIPE_KEY
end
if oh_match_at buf i oh_t_sk_ant
if ge oh_count_tok buf add i 7 20
ret OH_ERR_PRIV_ANTHROPIC_KEY
end
end
if oh_match_at buf i oh_t_sk
if ge oh_count_tok buf add i 3 20
ret OH_ERR_PRIV_OPENAI_KEY
end
end
end
note HuggingFace token: hf_[A-Za-z0-9]{34,}
if eq c 104
if oh_match_at buf i oh_t_hf
if ge oh_count_alnum buf add i 3 34
ret OH_ERR_PRIV_HF_TOKEN
end
end
end
note PEM private key block
if eq c 45
if oh_match_at buf i oh_t_pem_beg
j = add i len oh_t_pem_beg
while lt j n bound 128
if oh_match_at buf j oh_t_pem_end
ret OH_ERR_PRIV_PEM_KEY
end
j = add j 1
end
end
end
i = add i 1
end
if oh_scan_generic_secret buf
ret OH_ERR_PRIV_GENERIC_SECRET
end
ret OH_OK
end

fn oh_scan_paths_raw buf view uchar * to ulong
n = len buf
i = ulong 0
while lt i n bound 1024
if gt oh_user_path_len buf i 0
ret OH_ERR_PRIV_USER_PATH
end
if and eq get buf i 46 lt add i 2 n
if eq get buf add i 1 46
c2 = get buf add i 2
if or eq c2 47 eq c2 92
ret OH_ERR_PRIV_TRAVERSAL
end
end
end
i = add i 1
end
ret OH_OK
end

fn oh_privacy_check payload view uchar * to ulong
if eq len payload 0
ret OH_ERR_EMPTY_PAYLOAD
end
rc = oh_scan_secrets_raw payload
if ne rc OH_OK
ret rc
end
rc = oh_scan_paths_raw payload
if ne rc OH_OK
ret rc
end
norm = new uchar 512 0
nn = oh_normalize_obfuscation payload norm
rc = oh_scan_secrets_raw part norm 0 nn
if ne rc OH_OK
ret rc
end
rc = oh_scan_paths_raw part norm 0 nn
if ne rc OH_OK
ret rc
end
leet = new uchar 512 0
ln = oh_normalize_leet part norm 0 nn leet
if oh_scan_generic_secret part leet 0 ln
ret OH_ERR_PRIV_GENERIC_SECRET
end
ret OH_OK
end

fn oh_scrub_paths src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
i = ulong 0
out_n = ulong 0
while lt i n bound 1024
plen = oh_user_path_len src i
if gt plen 0
if lt add out_n 1 cap
put dst out_n uchar 126
put dst add out_n 1 uchar 47
out_n = add out_n 2
end
i = add i plen
continue
end
if lt out_n cap
put dst out_n get src i
out_n = add out_n 1
end
i = add i 1
end
ret out_n
end

note --- Strict Authority Boundary Enforcement ---

fn oh_scan_escalation_raw buf view uchar * to bool
n = len buf
i = ulong 0
while lt i n bound 1024
if oh_match_ci_at buf i oh_t_esc_exec
ret true
end
if oh_match_ci_at buf i oh_t_esc_sudo
ret true
end
if oh_match_ci_at buf i oh_t_esc_chmod
ret true
end
if oh_match_ci_at buf i oh_t_esc_chown
ret true
end
if oh_match_ci_at buf i oh_t_esc_ident
ret true
end
if oh_match_ci_at buf i oh_t_esc_seed
ret true
end
if oh_match_ci_at buf i oh_t_esc_admin
ret true
end
i = add i 1
end
ret false
end

fn oh_check_authority cap_flags ulong payload view uchar * to ulong
if ne and cap_flags OH_CAP_LOCAL_EXEC 0
ret OH_ERR_AUTH_EXEC
end
if ne and cap_flags OH_CAP_SECRET_ACCESS 0
ret OH_ERR_AUTH_SECRET
end
if ne and cap_flags OH_CAP_IDENTITY_MUTATE 0
ret OH_ERR_AUTH_IDENTITY
end
if ne and cap_flags OH_CAP_ADMIN_RIGHTS 0
ret OH_ERR_AUTH_ADMIN
end
if ne cap_flags 0
ret OH_ERR_AUTH_UNKNOWN
end
if oh_scan_escalation_raw payload
ret OH_ERR_AUTH_PAYLOAD_ESC
end
norm = new uchar 512 0
nn = oh_normalize_obfuscation payload norm
if oh_scan_escalation_raw part norm 0 nn
ret OH_ERR_AUTH_PAYLOAD_ESC
end
ret OH_OK
end

note --- Consent, TTL, Replay, Audit Trail, and Bounded Peer Assistance Queue ---

fn oh_check_consent pol view OhPolicy env_consent ulong to ulong
if eq get pol opt_in 0
ret OH_ERR_NODE_OPT_OUT
end
if ne env_consent 1
ret OH_ERR_NO_CONSENT
end
ret OH_OK
end

fn oh_check_ttl now_ms ulong created_ms ulong ttl_ms ulong to ulong
if or eq ttl_ms 0 gt ttl_ms OH_MAX_TTL_MS
ret OH_ERR_TTL_INVALID
end
if gt created_ms add now_ms OH_MAX_FUTURE_DRIFT_MS
ret OH_ERR_FUTURE_DRIFT
end
if ge now_ms add created_ms ttl_ms
ret OH_ERR_TTL_EXPIRED
end
ret OH_OK
end

fn oh_audit_record pol edit OhPolicy kind ulong peer_id ulong req_id ulong cat ulong code ulong to void
seq = add get pol audit_seq 1
put pol audit_seq seq
idx = rem sub seq 1 OH_AUDIT_CAP
put oh_aud_seq idx seq
put oh_aud_kind idx kind
put oh_aud_peer idx peer_id
put oh_aud_req idx req_id
put oh_aud_cat idx cat
put oh_aud_code idx code
put oh_aud_ts idx get pol now_ms
put oh_aud_dig idx ulong 0
cnt = get oh_aud_cnt 0
if lt cnt OH_AUDIT_CAP
put oh_aud_cnt 0 add cnt 1
end
end

fn oh_audit_set_last_digest pol view OhPolicy dig ulong to void
seq = get pol audit_seq
if eq seq 0
ret
end
idx = rem sub seq 1 OH_AUDIT_CAP
put oh_aud_dig idx dig
end

fn oh_audit_count to ulong
ret get oh_aud_cnt 0
end

fn oh_seen_check_and_record pol edit OhPolicy peer_id ulong dig ulong to bool
i = ulong 0
while lt i OH_SEEN_CAP bound 64
if and eq get oh_seen_peer i peer_id eq get oh_seen_dig i dig
ret false
end
i = add i 1
end
head = get pol seen_head
put oh_seen_peer head peer_id
put oh_seen_dig head dig
put pol seen_head rem add head 1 OH_SEEN_CAP
ret true
end

fn oh_queue_sweep_expired pol edit OhPolicy to ulong
now = get pol now_ms
swept = ulong 0
i = ulong 0
while lt i OH_QUEUE_CAP bound 64
if eq get oh_q_status i OH_Q_PENDING
exp = add get oh_q_created i get oh_q_ttl i
if ge now exp
put oh_q_status i OH_Q_EXPIRED
oh_audit_record pol OH_AUD_EXPIRED get oh_q_peer_id i get oh_q_req_id i get oh_q_cat i OH_ERR_TTL_EXPIRED
oh_audit_set_last_digest pol get oh_q_digest i
swept = add swept 1
end
end
i = add i 1
end
ret swept
end

fn oh_queue_pending_count to ulong
cnt = ulong 0
i = ulong 0
while lt i OH_QUEUE_CAP bound 64
if eq get oh_q_status i OH_Q_PENDING
cnt = add cnt 1
end
i = add i 1
end
ret cnt
end

fn oh_queue_find_free to ulong
i = ulong 0
while lt i OH_QUEUE_CAP bound 64
st = get oh_q_status i
if or eq st OH_Q_EMPTY eq st OH_Q_EXPIRED
ret i
end
i = add i 1
end
ret OH_QUEUE_CAP
end

fn oh_queue_store_slot slot ulong rid ulong env view OhEnv payload view uchar * dig ulong to void
put oh_q_status slot OH_Q_PENDING
put oh_q_req_id slot rid
put oh_q_peer_id slot get env peer_id
put oh_q_cat slot get env category
put oh_q_created slot get env created_ms
put oh_q_ttl slot get env ttl_ms
put oh_q_digest slot dig
put oh_q_helper slot ulong 0
plen = len payload
put oh_q_plen slot plen
base = mul slot OH_MAX_PAYLOAD
i = ulong 0
while lt i plen bound 512
put oh_q_payload add base i get payload i
i = add i 1
end
end

fn oh_validate_distress pol edit OhPolicy env view OhEnv payload view uchar * to ulong
rc = oh_check_consent pol get env consent
if ne rc OH_OK
ret rc
end
if ne get env version OH_VERSION
ret OH_ERR_BAD_VERSION
end
if eq get env peer_id 0
ret OH_ERR_BAD_PEER
end
if gt get env category OH_CAT_MAX
ret OH_ERR_BAD_CATEGORY
end
rc = oh_check_authority get env cap_flags payload
if ne rc OH_OK
ret rc
end
rc = oh_check_ttl get pol now_ms get env created_ms get env ttl_ms
if ne rc OH_OK
ret rc
end
ret oh_privacy_check payload
end

fn oh_submit_distress pol edit OhPolicy env view OhEnv payload view uchar * out_req edit ulong 1 to ulong
put out_req 0 ulong 0
swept = oh_queue_sweep_expired pol
if gt swept OH_QUEUE_CAP
ret OH_ERR_QUEUE_FULL
end
rc = oh_validate_distress pol env payload
if ne rc OH_OK
oh_audit_record pol OH_AUD_REFUSED get env peer_id 0 get env category rc
oh_audit_set_last_digest pol get env digest
ret rc
end
dig = oh_compute_digest env payload
if not oh_seen_check_and_record pol get env peer_id dig
oh_audit_record pol OH_AUD_REFUSED get env peer_id 0 get env category OH_ERR_REPLAY
oh_audit_set_last_digest pol dig
ret OH_ERR_REPLAY
end
slot = oh_queue_find_free
if ge slot OH_QUEUE_CAP
oh_audit_record pol OH_AUD_REFUSED get env peer_id 0 get env category OH_ERR_QUEUE_FULL
oh_audit_set_last_digest pol dig
ret OH_ERR_QUEUE_FULL
end
rid = get pol next_req_id
put pol next_req_id add rid 1
oh_queue_store_slot slot rid env payload dig
put out_req 0 rid
oh_audit_record pol OH_AUD_ENQUEUED get env peer_id rid get env category OH_OK
oh_audit_set_last_digest pol dig
ret OH_OK
end

fn oh_find_req_slot req_id ulong to ulong
if eq req_id 0
ret OH_QUEUE_CAP
end
i = ulong 0
while lt i OH_QUEUE_CAP bound 64
if and ne get oh_q_status i OH_Q_EMPTY eq get oh_q_req_id i req_id
ret i
end
i = add i 1
end
ret OH_QUEUE_CAP
end

fn oh_resolve_distress pol edit OhPolicy req_id ulong helper view OhEnv solution view uchar * to ulong
swept = oh_queue_sweep_expired pol
if gt swept OH_QUEUE_CAP
ret OH_ERR_QUEUE_FULL
end
rc = oh_check_consent pol get helper consent
if ne rc OH_OK
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id 0 rc
ret rc
end
if eq get helper peer_id 0
oh_audit_record pol OH_AUD_REFUSED 0 req_id 0 OH_ERR_BAD_PEER
ret OH_ERR_BAD_PEER
end
rc = oh_check_authority get helper cap_flags solution
if ne rc OH_OK
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id 0 rc
ret rc
end
rc = oh_privacy_check solution
if ne rc OH_OK
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id 0 rc
ret rc
end
slot = oh_find_req_slot req_id
if ge slot OH_QUEUE_CAP
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id 0 OH_ERR_REQ_NOT_FOUND
ret OH_ERR_REQ_NOT_FOUND
end
st = get oh_q_status slot
if eq st OH_Q_EXPIRED
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id get oh_q_cat slot OH_ERR_TTL_EXPIRED
ret OH_ERR_TTL_EXPIRED
end
if eq st OH_Q_RESOLVED
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id get oh_q_cat slot OH_ERR_REQ_ALREADY_RESOLVED
ret OH_ERR_REQ_ALREADY_RESOLVED
end
if eq get oh_q_peer_id slot get helper peer_id
oh_audit_record pol OH_AUD_REFUSED get helper peer_id req_id get oh_q_cat slot OH_ERR_SELF_RESOLVE
ret OH_ERR_SELF_RESOLVE
end
put oh_q_status slot OH_Q_RESOLVED
put oh_q_helper slot get helper peer_id
oh_audit_record pol OH_AUD_RESOLVED get helper peer_id req_id get oh_q_cat slot OH_OK
oh_audit_set_last_digest pol get oh_q_digest slot
ret OH_OK
end

note SPDX-License-Identifier: Apache-2.0
note protocol/open-humanity/test.om: comprehensive positive and negative control tests for
note protocol/open-humanity/lib.om.
note Compose with: si/directives/om2.om protocol/open-humanity/lib.om protocol/open-humanity/test.om

text oht_pass "PASS "
text oht_fail "FAIL "
text oht_nl "\n"
text oht_sum_ok "OPEN_HUMANITY_TEST PASS passed="
text oht_sum_fl "OPEN_HUMANITY_TEST FAIL passed="
text oht_fld " failed="

text oht_n1 "wire_roundtrip_and_tamper_refusal"
text oht_n2 "opt_in_distress_routing_and_resolution"
text oht_n3 "opt_out_refusal_outbound_and_inbound"
text oht_n4 "ttl_expiry_and_invalid_ttl_refusal"
text oht_n5 "privacy_firewall_secrets_refusal"
text oht_n6 "privacy_firewall_paths_and_obfuscation"
text oht_n7 "privacy_path_scrubber_sanitizes_safely"
text oht_n8 "authority_boundary_priv_esc_refusal"
text oht_n9 "replay_self_resolve_and_queue_bound"

text oht_clean_q "E0425 cannot find value x in crate::module at line 42"
text oht_clean_a "Add use crate::module::x before invoking the helper function"
text oht_aws "leak AKIA1234567890ABCDEF in build log"
text oht_gh "token ghp_0123456789abcdefghijklmnopqrstuvwxyz found"
text oht_ant "key sk-ant-abcdefghijklmnopqrstuvwx leaked"
text oht_oai "key sk-proj-0123456789abcdefghijklm leaked"
text oht_pem "-----BEGIN RSA PRIVATE KEY----- body"
text oht_gen "config api_key = \"supersecretvalue123456\" here"
text oht_upath "error at /Users/alice/private/main.rs:10"
text oht_hpath "error at /home/bob/work/main.rs:10"
text oht_wpath "error at C:\\Users\\eve\\proj\\main.rs"
text oht_trav "include ../../etc/shadow failed"
text oht_pct "obfuscated %41KIA1234567890ABCDEF secret"
text oht_scrub_want "error at ~/private/main.rs:10"
text oht_esc_sudo "try running sudo rm -rf /tmp/cache"
text oht_esc_id "export OPEN_HUMANITY_IDENTITY from host"
text oht_esc_exec "exec: /bin/sh to inspect"

fn oht_rec name view uchar * ok bool tally edit ulong 2 to void
w = false
if ok
put tally 0 add get tally 0 1
w = oh_write_all 1 oht_pass
else
put tally 1 add get tally 1 1
w = oh_write_all 1 oht_fail
end
w = and w oh_write_all 1 name
w = and w oh_write_all 1 oht_nl
if w
ret
end
end

fn oht_bytes_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
n = len a
i = ulong 0
while lt i n bound 1024
if ne get a i get b i
ret false
end
i = add i 1
end
ret true
end

fn test_wire_roundtrip to bool
env = new OhEnv OH_VERSION 777 1 OH_CAT_RUST 1000 60000 0 0 0
wire = new uchar 560 0
wn = oh_serialize_envelope env oht_clean_q wire
if eq wn 0
ret false
end
if ne wn add OH_HDR_LEN len oht_clean_q
ret false
end
parsed = new OhEnv 0 0 0 0 0 0 0 0 0
pbuf = new uchar 512 0
rc = oh_parse_envelope part wire 0 wn parsed pbuf
if ne rc OH_OK
ret false
end
if ne get parsed peer_id 777
ret false
end
if ne get parsed consent 1
ret false
end
if ne get parsed category OH_CAT_RUST
ret false
end
if ne get parsed ttl_ms 60000
ret false
end
if not oht_bytes_eq part pbuf 0 get parsed payload_len oht_clean_q
ret false
end
note Negative control: flip 1 byte in payload -> BAD_DIGEST
put wire OH_HDR_LEN xor get wire OH_HDR_LEN 1
rc_tamper = oh_parse_envelope part wire 0 wn parsed pbuf
if ne rc_tamper OH_ERR_BAD_DIGEST
ret false
end
note Negative control: bad version -> BAD_VERSION
put wire 2 uchar 9
rc_ver = oh_parse_envelope part wire 0 wn parsed pbuf
if ne rc_ver OH_ERR_BAD_VERSION
ret false
end
note Negative control: bad magic -> BAD_MAGIC
put wire 0 uchar 0
rc_mag = oh_parse_envelope part wire 0 wn parsed pbuf
ret eq rc_mag OH_ERR_BAD_MAGIC
end

fn test_optin_routing_resolution to bool
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol opt_in ulong 1
put pol now_ms ulong 5000
env = new OhEnv OH_VERSION 101 1 OH_CAT_RUST 4000 60000 0 0 0
req = new ulong 1 0
rc1 = oh_submit_distress pol env oht_clean_q req
if ne rc1 OH_OK
ret false
end
rid = get req 0
if ne rid 1
ret false
end
if ne oh_queue_pending_count 1
ret false
end
helper = new OhEnv OH_VERSION 202 1 OH_CAT_RUST 5000 60000 0 0 0
rc2 = oh_resolve_distress pol rid helper oht_clean_a
if ne rc2 OH_OK
ret false
end
if ne oh_queue_pending_count 0
ret false
end
note Audit trail must record ENQUEUED then RESOLVED
if ne oh_audit_count 2
ret false
end
if ne get oh_aud_kind 0 OH_AUD_ENQUEUED
ret false
end
if ne get oh_aud_kind 1 OH_AUD_RESOLVED
ret false
end
ret eq get oh_aud_peer 1 202
end

fn test_opt_out_refusals to bool
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol now_ms ulong 5000
env = new OhEnv OH_VERSION 101 1 OH_CAT_RUST 4500 60000 0 0 0
req = new ulong 1 0
note Node opt-in is 0 by default -> MUST refuse outbound distress
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_NODE_OPT_OUT
ret false
end
note Enable node opt-in, but envelope consent_flag=0 -> MUST refuse
put pol opt_in ulong 1
put env consent ulong 0
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_NO_CONSENT
ret false
end
note Submit valid request with consent=1
put env consent ulong 1
if ne oh_submit_distress pol env oht_clean_q req OH_OK
ret false
end
note Now opt out node -> inbound resolution MUST be refused
put pol opt_in ulong 0
helper = new OhEnv OH_VERSION 202 1 OH_CAT_RUST 5000 60000 0 0 0
ret eq oh_resolve_distress pol get req 0 helper oht_clean_a OH_ERR_NODE_OPT_OUT
end

fn test_ttl_refusals to bool
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol opt_in ulong 1
put pol now_ms ulong 10000
req = new ulong 1 0
note Zero TTL refused
e0 = new OhEnv OH_VERSION 101 1 OH_CAT_SIMD 10000 0 0 0 0
if ne oh_submit_distress pol e0 oht_clean_q req OH_ERR_TTL_INVALID
ret false
end
note Oversized TTL (> 7 days) refused
ebig = new OhEnv OH_VERSION 101 1 OH_CAT_SIMD 10000 add OH_MAX_TTL_MS 1 0 0 0
if ne oh_submit_distress pol ebig oht_clean_q req OH_ERR_TTL_INVALID
ret false
end
note Already expired envelope refused
eexp = new OhEnv OH_VERSION 101 1 OH_CAT_SIMD 1000 5000 0 0 0
if ne oh_submit_distress pol eexp oht_clean_q req OH_ERR_TTL_EXPIRED
ret false
end
note Enqueue valid 2000ms request at now=10000, advance clock to 12000 -> resolution refused
eok = new OhEnv OH_VERSION 101 1 OH_CAT_SIMD 10000 2000 0 0 0
if ne oh_submit_distress pol eok oht_clean_q req OH_OK
ret false
end
put pol now_ms ulong 12000
helper = new OhEnv OH_VERSION 202 1 OH_CAT_SIMD 12000 2000 0 0 0
if ne oh_resolve_distress pol get req 0 helper oht_clean_a OH_ERR_TTL_EXPIRED
ret false
end
ret eq oh_queue_pending_count 0
end

fn test_privacy_secrets to bool
if ne oh_privacy_check oht_aws OH_ERR_PRIV_AWS_KEY
ret false
end
if ne oh_privacy_check oht_gh OH_ERR_PRIV_GITHUB_TOKEN
ret false
end
if ne oh_privacy_check oht_ant OH_ERR_PRIV_ANTHROPIC_KEY
ret false
end
if ne oh_privacy_check oht_oai OH_ERR_PRIV_OPENAI_KEY
ret false
end
if ne oh_privacy_check oht_pem OH_ERR_PRIV_PEM_KEY
ret false
end
if ne oh_privacy_check oht_gen OH_ERR_PRIV_GENERIC_SECRET
ret false
end
note Answer firewall: secret inside peer resolution MUST also be refused
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol opt_in ulong 1
put pol now_ms ulong 1000
env = new OhEnv OH_VERSION 101 1 OH_CAT_SEC 1000 60000 0 0 0
req = new ulong 1 0
if ne oh_submit_distress pol env oht_clean_q req OH_OK
ret false
end
helper = new OhEnv OH_VERSION 202 1 OH_CAT_SEC 1000 60000 0 0 0
ret eq oh_resolve_distress pol get req 0 helper oht_aws OH_ERR_PRIV_AWS_KEY
end

fn test_privacy_paths_obf to bool
if ne oh_privacy_check oht_upath OH_ERR_PRIV_USER_PATH
ret false
end
if ne oh_privacy_check oht_hpath OH_ERR_PRIV_USER_PATH
ret false
end
if ne oh_privacy_check oht_wpath OH_ERR_PRIV_USER_PATH
ret false
end
if ne oh_privacy_check oht_trav OH_ERR_PRIV_TRAVERSAL
ret false
end
note Percent-encoded AWS key (%41KIA...) MUST be caught after obfuscation normalization
if ne oh_privacy_check oht_pct OH_ERR_PRIV_AWS_KEY
ret false
end
note Zero-width UTF-8 U+200B (E2 80 8B) inserted between A and KIA MUST be caught
zw = new uchar 24 0
put zw 0 uchar 65
put zw 1 uchar 0xe2
put zw 2 uchar 0x80
put zw 3 uchar 0x8b
put zw 4 uchar 75
put zw 5 uchar 73
put zw 6 uchar 65
i = ulong 0
while lt i 16 bound 16
put zw add 7 i uchar add 65 rem i 10
i = add i 1
end
ret eq oh_privacy_check part zw 0 23 OH_ERR_PRIV_AWS_KEY
end

fn test_path_scrubber to bool
dst = new uchar 128 0
n = oh_scrub_paths oht_upath dst
if not oht_bytes_eq part dst 0 n oht_scrub_want
ret false
end
ret eq oh_privacy_check part dst 0 n OH_OK
end

fn test_authority_boundary to bool
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol opt_in ulong 1
put pol now_ms ulong 2000
req = new ulong 1 0
env = new OhEnv OH_VERSION 101 1 OH_CAT_PROTO 2000 60000 OH_CAP_LOCAL_EXEC 0 0
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_AUTH_EXEC
ret false
end
put env cap_flags OH_CAP_SECRET_ACCESS
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_AUTH_SECRET
ret false
end
put env cap_flags OH_CAP_IDENTITY_MUTATE
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_AUTH_IDENTITY
ret false
end
put env cap_flags OH_CAP_ADMIN_RIGHTS
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_AUTH_ADMIN
ret false
end
put env cap_flags ulong 0x10
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_AUTH_UNKNOWN
ret false
end
note Zero cap_flags with smuggled escalation directive in payload MUST still be refused
put env cap_flags OH_CAP_NONE
if ne oh_submit_distress pol env oht_esc_sudo req OH_ERR_AUTH_PAYLOAD_ESC
ret false
end
if ne oh_submit_distress pol env oht_esc_id req OH_ERR_AUTH_PAYLOAD_ESC
ret false
end
if ne oh_submit_distress pol env oht_esc_exec req OH_ERR_AUTH_PAYLOAD_ESC
ret false
end
note Resolution with privilege flag MUST also be refused
if ne oh_submit_distress pol env oht_clean_q req OH_OK
ret false
end
helper = new OhEnv OH_VERSION 202 1 OH_CAT_PROTO 2000 60000 OH_CAP_LOCAL_EXEC 0 0
if ne oh_resolve_distress pol get req 0 helper oht_clean_a OH_ERR_AUTH_EXEC
ret false
end
put helper cap_flags OH_CAP_NONE
ret eq oh_resolve_distress pol get req 0 helper oht_esc_sudo OH_ERR_AUTH_PAYLOAD_ESC
end

fn test_replay_self_and_bound to bool
pol = new OhPolicy 0 0 1 0 0
oh_reset_state pol
put pol opt_in ulong 1
put pol now_ms ulong 10000
req = new ulong 1 0
env = new OhEnv OH_VERSION 500 1 OH_CAT_AGENT 10000 60000 0 0 0
if ne oh_submit_distress pol env oht_clean_q req OH_OK
ret false
end
first_rid = get req 0
note Duplicate distress (same peer + digest) -> REPLAY
if ne oh_submit_distress pol env oht_clean_q req OH_ERR_REPLAY
ret false
end
note Self-resolution by same peer_id -> SELF_RESOLVE
selfh = new OhEnv OH_VERSION 500 1 OH_CAT_AGENT 10000 60000 0 0 0
if ne oh_resolve_distress pol first_rid selfh oht_clean_a OH_ERR_SELF_RESOLVE
ret false
end
note Fill remaining 31 queue slots with distinct peers -> 32nd succeeds, 33rd MUST hit QUEUE_FULL
i = ulong 1
while lt i OH_QUEUE_CAP bound 32
put env peer_id add 500 i
if ne oh_submit_distress pol env oht_clean_q req OH_OK
ret false
end
i = add i 1
end
if ne oh_queue_pending_count OH_QUEUE_CAP
ret false
end
put env peer_id ulong 9999
ret eq oh_submit_distress pol env oht_clean_q req OH_ERR_QUEUE_FULL
end

fn main to int
tally = new ulong 2 0
oht_rec oht_n1 test_wire_roundtrip tally
oht_rec oht_n2 test_optin_routing_resolution tally
oht_rec oht_n3 test_opt_out_refusals tally
oht_rec oht_n4 test_ttl_refusals tally
oht_rec oht_n5 test_privacy_secrets tally
oht_rec oht_n6 test_privacy_paths_obf tally
oht_rec oht_n7 test_path_scrubber tally
oht_rec oht_n8 test_authority_boundary tally
oht_rec oht_n9 test_replay_self_and_bound tally
passed = get tally 0
failed = get tally 1
ok = false
if eq failed 0
ok = oh_write_all 1 oht_sum_ok
else
ok = oh_write_all 1 oht_sum_fl
end
oh_write_u64 1 passed
ok = and ok oh_write_all 1 oht_fld
oh_write_u64 1 failed
ok = and ok oh_write_all 1 oht_nl
if and ok eq failed 0
ret 0
end
ret 1
end

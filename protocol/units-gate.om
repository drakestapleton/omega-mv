note SPDX-License-Identifier: Apache-2.0
note protocol/units-gate.om: OMEGA-PROTOCOL-UNITS, the gate of the pure-Omega units of Sovereign Intelligence layer 'protocol', in
note seeded Omega (Linux AArch64). Build from the repository root (OM-2 program mode; seed/ng/sha256.om supplies
note sh_dat, sh_all, sh_dig):
note   { printf 'om2\n'; cat seed/ng/sha256.om protocol/units-gate.om; } | seed/out/omc > protocol-units-gate
note Run from the repository root: protocol-units-gate OMC SCRATCH
note OMC      the compiler under test; its sha256 must equal the first word of seed/out/omc.sha256, or nothing
note          runs (exit 69, nothing written)
note SCRATCH  a new directory (created 0700), at most 1024 bytes of path; an existing one is refused (exit 2)
note Units. protocol/units.tsv lists every unit, one per line: NAME then the paths of its parts, single spaces; a line
note starting with # is a comment and an empty line is skipped. NAME is 1 to 249 of A-Z a-z 0-9 _ and appears once
note (249 leaves room for the longest scratch suffix, ".1.err", inside a 255-byte file name).
note The parts are concatenated in order, each followed by a newline (the composition of protocol/units.tsv), into
note SCRATCH/NAME.om and compiled twice by OMC: each compile exits 0 with empty stderr, and both outputs hold the same
note bytes. A malformed or repeated row, a missing part, a failed compile, two different outputs or a table with no
note unit is a FAIL line. The runner (protocol/README.md) also requires the exact unit count.
note Control, must be caught: a compiler one byte longer fails the digest check.
note Output: one line per unit, then OMEGA-PROTOCOL-UNITS PASS|FAIL units=U controls=C caught=K hardware=NOT_RUN.
note Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 69 compiler digest refused. Every input is length-checked; a trap
note exit (101..114) would be a defect of this gate, never a pass.
note This gate checks that the units compile reproducibly with this repository's compiler. It does not run them:
note their behaviour checks are still C, Python and shell upstream (protocol/UNITS.md lists them).
text t_pin "seed/out/omc.sha256"
text t_tab "protocol/units.tsv"
text t_om ".om"
text t_b1 ".1"
text t_b2 ".2"
text t_e1 ".1.err"
text t_e2 ".2.err"
text t_badname "units.tsv: name outside A-Z a-z 0-9 _"
text t_dup "units.tsv: name repeated, or more than 64 KiB of names"
text t_empty "units.tsv names no unit"
text t_plus "omc-plus-one"
text t_usage "usage: protocol-units-gate OMC SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-PROTOCOL-UNITS REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-PROTOCOL-UNITS INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-PROTOCOL-UNITS INVALID: SCRATCH exists or cannot be made\n"
text t_notab "OMEGA-PROTOCOL-UNITS INVALID: cannot read protocol/units.tsv\n"
text t_long "OMEGA-PROTOCOL-UNITS INVALID: SCRATCH path longer than 1024 bytes\n"
text t_ok "ok "
text t_fail "FAIL "
text t_unit "unit "
text t_ctl "control "
text t_bytes " bytes="
text t_sha " sha256="
text t_exit " exit="
text t_src "source unreadable: "
text t_big "output unreadable or over 16 MiB"
text t_cmp "compile"
text t_stderr " stderr not empty"
text t_twice " two builds differ"
text t_write "cannot write the composed unit in SCRATCH"
text t_row "units.tsv: malformed row (name 1..249 bytes, at least one part)"
text t_plong "units.tsv: a part path is longer than 4000 bytes"
text t_caught " caught"
text t_esc " ESCAPED"
text t_sum "OMEGA-PROTOCOL-UNITS "
text t_pass "PASS"
text t_fl "FAIL"
text t_su " units="
text t_sc " controls="
text t_sk " caught="
text t_hw " hardware=NOT_RUN\n"
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_nm uchar 256
global g_av uchar 8192
global g_b uchar 16777216
global g_u uchar 1048576
global g_o uchar 8192
global g_hx uchar 64
global g_pin uchar 64
global g_d1 uchar 32
global g_stb uchar 4
global g_n ulong 32
global g_seen uchar 65536
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 buffer length, 7 table length, 8 units, 11 failures, 12 controls, 13 caught, 14 name length, 15 g_seen length,
note 16 unit rows
note ---- output
fn oc c ulong to void
n = get g_n 5
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onm to void
for i ulong get g_n 14 bound 256
oc ulong get g_nm i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohex to void
for j ulong 32
b = get sh_dig j
oc ulong sh_hexd uint shr b 4
oc ulong sh_hexd uint and b 15
end
end
fn ohx to void
for j ulong 64
oc ulong get g_hx j
end
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
fn onl to void
oc 10
oflush
end
note a failed check: FAIL KIND NAME then the reason; counts a failure
fn ofail kind view uchar * why view uchar * to void
ot t_fail
ot kind
onm
oc 32
ot why
onl
put g_n 11 add get g_n 11 1
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pscr to void
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
end
fn pnm to void
for j ulong get g_n 14 bound 256
pc ulong get g_nm j
end
end
note scratch file NAME then suffix
fn psn suf view uchar * to void
pclr
pscr
pnm
pt suf
end
note scratch file named by a text
fn pst t view uchar * suf view uchar * to void
pclr
pscr
pt t
pt suf
end
note scratch file named by a text alone
fn psc t view uchar * to void
pclr
pscr
pt t
end
fn nmset t view uchar * to void
for i ulong len t bound 256
put g_nm i get t i
end
put g_n 14 len t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note append the file at g_pa to g_b; false when unreadable or past the buffer
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 16777218
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_b
ok = false
break
end
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 16777217
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note sha256 of the file at g_pa into sh_dig; false when unreadable or past 16 MiB
fn fhash to bool
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = read fd sh_dat n sub len sh_dat n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len sh_dat
ok = false
break
end
end
fclo fd
if not ok
ret false
end
sh_all n
ret true
end
note the size of the file at g_pa, or 2^63 when unreadable
fn fsize to ulong
put g_n 6 0
if not bload
ret shl ulong 1 63
end
ret get g_n 6
end
note sh_dig equals the hex in g_hx
fn digeq to bool
for j ulong 32
b = get sh_dig j
if ne get g_hx mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_hx add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
fn dsave to void
for j ulong 32
put g_d1 j get sh_dig j
end
end
fn dsame to bool
for j ulong 32
if ne get g_d1 j get sh_dig j
ret false
end
end
ret true
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
pclr
pt t
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here): the exit code, 256 + the signal, 512
note when a file could not be opened, 1000 when the child passed the 600 s deadline (killed)
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
note OMC < SCRATCH/NAME.om > SCRATCH/NAME.SUF 2> SCRATCH/NAME.ERR
fn omc suf view uchar * err view uchar * to ulong
psn t_om
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
psn suf
fo = fexe
psn err
fe = fwr
ret spawn fi fo fe
end
note ---- the compiler digest
note the first 64 characters of seed/out/omc.sha256 into g_pin; false unless lowercase hex
fn pinread to bool
pclr
pt t_pin
put g_n 6 0
if not bload
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the file at g_pa hashes to g_pin
fn pinok to bool
if not fhash
ret false
end
for j ulong 64
put g_hx j get g_pin j
end
ret digeq
end
note ---- units
note g_u[i] is c, for i below e (never reads at or past e)
fn uis i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret eq ulong get g_u i c
end
fn uisnt i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret ne ulong get g_u i c
end
note append one newline to g_b (units.sh writes one after every part)
fn nl to bool
n = get g_n 6
if ge add n 1 len g_b
ret false
end
put g_b n 10
put g_n 6 add n 1
ret true
end
note a missing or unreadable part: FAIL unit NAME source unreadable: PATH (the path is in g_pa, at most 4000 bytes)
fn psrcfail to void
ot t_fail
ot t_unit
onm
oc 32
ot t_src
for q ulong get g_n 0 bound 4096
oc ulong get g_pa q
end
onl
put g_n 11 add get g_n 11 1
end
note compose the parts g_u[s, e) into g_b as protocol/units.tsv does: each part's bytes, then one newline; false
note (reported) when a part is unreadable or its path is longer than 4000 bytes
fn compose s ulong e ulong to bool
put g_n 6 0
i = s
while lt i e bound 1048576
while uis i e 32 bound 1048576
i = add i 1
end
if ge i e
break
end
j = i
while uisnt j e 32 bound 1048576
j = add j 1
end
if gt sub j i 4000
ofail t_unit t_plong
ret false
end
pclr
for q ulong sub j i bound 4096
pc ulong get g_u add i q
end
if not bload
psrcfail
ret false
end
if not nl
ofail t_unit t_big
ret false
end
i = j
end
ret true
end
note compile the composed unit twice; true when both exit 0 with empty stderr and equal bytes
fn build to bool
psn t_om
if not bsave false
ofail t_unit t_write
ret false
end
r1 = omc t_b1 t_e1
r2 = omc t_b2 t_e2
if or ne r1 0 ne r2 0
ot t_fail
ot t_unit
onm
oc 32
ot t_cmp
ot t_exit
onum r1
oc 47
onum r2
onl
put g_n 11 add get g_n 11 1
ret false
end
psn t_e1
s1 = fsize
psn t_e2
s2 = fsize
if or ne s1 0 ne s2 0
ofail t_unit t_stderr
ret false
end
psn t_b1
if not fhash
ofail t_unit t_big
ret false
end
dsave
psn t_b2
if not fhash
ofail t_unit t_big
ret false
end
if not dsame
ofail t_unit t_twice
ret false
end
psn t_b1
sz = fsize
psn t_b1
if not fhash
ofail t_unit t_big
ret false
end
ot t_ok
ot t_unit
onm
ot t_bytes
onum sz
ot t_sha
ohex
onl
put g_n 8 add get g_n 8 1
ret true
end
note one table row [s, e): NAME then parts; # starts a comment line; an empty line is skipped
fn urow s ulong e ulong to void
if or eq s e eq get g_u s 35
ret
end
put g_n 14 0
k = s
while uisnt k e 32 bound 1048576
k = add k 1
end
if or ge k e or eq k s gt sub k s 249
ofail t_unit t_row
ret
end
for q ulong sub k s bound 256
put g_nm q get g_u add s q
end
put g_n 14 sub k s
put g_n 16 add get g_n 16 1
if not nameok
ofail t_unit t_badname
ret
end
if not nameadd
ofail t_unit t_dup
ret
end
if compose k e
z = build
end
end
note a unit name uses only A-Z a-z 0-9 _ (A-Z a-z 0-9 _), so it names a file in SCRATCH
fn nameok to bool
for q ulong get g_n 14 bound 256
c = get g_nm q
d = and ge c 48 le c 57
u = and ge c 65 le c 90
l = and ge c 97 le c 122
ok = or or d u or l eq c 95
if not ok
ret false
end
end
ret true
end
note record the name in g_seen (names joined by newlines); false when it is already there or g_seen is full
fn nameadd to bool
n = get g_n 15
m = get g_n 14
p = ulong 0
while lt p n bound 65536
q = p
while and lt q n ne get g_seen q 10 bound 65536
q = add q 1
end
if nameat p q
ret false
end
p = add q 1
end
if ge add add n m 1 len g_seen
ret false
end
for j ulong m bound 256
put g_seen add n j get g_nm j
end
put g_seen add n m 10
put g_n 15 add add n m 1
ret true
end
note g_seen[p, q) equals the current name
fn nameat p ulong q ulong to bool
if ne sub q p get g_n 14
ret false
end
for j ulong sub q p bound 256
if ne get g_seen add p j get g_nm j
ret false
end
end
ret true
end
fn table to bool
pclr
pt t_tab
put g_n 6 0
if not bload
ret false
end
n = get g_n 6
if ge n len g_u
ret false
end
for q ulong n bound 1048576
put g_u q get g_b q
end
put g_n 7 n
s = ulong 0
while lt s n bound 1048576
e = s
while uisnt e n 10 bound 1048576
e = add e 1
end
urow s e
s = add e 1
end
if eq get g_n 16 0
nmset t_tab
ofail t_unit t_empty
end
ret true
end
note ---- controls
fn caught c bool what view uchar * to void
put g_n 12 add get g_n 12 1
nmset what
if c
ot t_ok
ot t_ctl
onm
ot t_caught
onl
put g_n 13 add get g_n 13 1
else
ofail t_ctl t_esc
end
end
note a compiler one byte longer must fail the digest check
fn cwrong to void
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
put g_n 6 0
ok = bload
n = get g_n 6
put g_b n 0
put g_n 6 add n 1
psc t_plus
ok = and ok bsave true
psc t_plus
c = and ok not pinok
caught c t_plus
end
note ---- main
fn ausage to int
r = write 2 t_usage 0 len t_usage
ret 2
end
fn main to int
if ne argcnt 3
ret ausage
end
r = argread 1 g_omc 0 4095
if lt r 1
ret ausage
end
put g_n 1 ulong r
if not pinread
r = write 2 t_nopin 0 len t_nopin
ret 2
end
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
if not pinok
r = write 2 t_refd 0 len t_refd
ret 69
end
r = argread 2 g_scr 0 4094
if lt r 1
ret ausage
end
if gt r 1024
r = write 2 t_long 0 len t_long
ret 2
end
n = ulong r
x = makedir g_scr 0 n 448
if ne x 0
r = write 2 t_noscr 0 len t_noscr
ret 2
end
put g_scr n 47
put g_n 2 add n 1
if not table
r = write 2 t_notab 0 len t_notab
ret 2
end
cwrong
f = get g_n 11
ot t_sum
if eq f 0
ot t_pass
else
ot t_fl
end
ot t_su
onum get g_n 8
ot t_sc
onum get g_n 12
ot t_sk
onum get g_n 13
ot t_hw
oflush
if ne f 0
ret 1
end
if ne get g_n 12 get g_n 13
ret 1
end
ret 0
end

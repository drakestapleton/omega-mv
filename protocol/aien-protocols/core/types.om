note SPDX-License-Identifier: Apache-2.0
note protocol/aien-protocols/core/types.om: pure-Omega port of aien-protocol-types
note Implements ProtocolVersion, Digest32, Uuid16 (RFC 4122), SequenceNumber, Timestamp,
note ArtifactRef validation, and shared byte/ASCII encoding helpers.
note Composed OM-2 library unit (compose si/directives/om2.om ahead of this file).

const PT_OK ulong 0
const PT_ERR_BAD_LEN ulong 1
const PT_ERR_BAD_HEX ulong 2
const PT_ERR_BAD_UUID ulong 3
const PT_ERR_NIL_UUID ulong 4
const PT_ERR_ZERO_DIGEST ulong 5
const PT_ERR_EMPTY_FIELD ulong 6
const PT_ERR_OVERFLOW ulong 7

const U64_MAX ulong 18446744073709551615

text pt_hex_chars "0123456789abcdef"
text pt_sha256_pfx "sha256:"

note --- Shared byte, ASCII, and I/O helpers ---

fn pt_slice_eq a view uchar * b view uchar * to bool
na = len a
nb = len b
if ne na nb
ret false
end
if gt na ulong 65536
ret false
end
i = ulong 0
while lt i na bound 65536
if ne get a i get b i
ret false
end
i = add i ulong 1
end
ret true
end

fn pt_ascii_lower b uchar to uchar
if and ge b uchar 65 le b uchar 90
ret add b uchar 32
end
ret b
end

fn pt_slice_eq_ascii_ci a view uchar * b view uchar * to bool
na = len a
nb = len b
if ne na nb
ret false
end
if gt na ulong 65536
ret false
end
i = ulong 0
while lt i na bound 65536
ca = pt_ascii_lower get a i
cb = pt_ascii_lower get b i
if ne ca cb
ret false
end
i = add i ulong 1
end
ret true
end

fn pt_append_byte dst edit uchar * pos ulong b uchar to ulong
if ge pos len dst
ret pos
end
put dst pos b
ret add pos ulong 1
end

fn pt_append_bytes dst edit uchar * pos ulong src view uchar * to ulong
cap = len dst
ns = len src
if gt ns ulong 65536
ret pos
end
i = ulong 0
p = pos
while lt i ns bound 65536
if ge p cap
ret p
end
put dst p get src i
p = add p ulong 1
i = add i ulong 1
end
ret p
end

fn pt_append_u64 dst edit uchar * pos ulong v ulong to ulong
tmp = new uchar 24 0
n = ulong 0
cur = v
if eq cur ulong 0
put tmp 0 uchar 48
n = ulong 1
else
while gt cur ulong 0 bound 24
d = rem cur ulong 10
put tmp n uchar add d ulong 48
cur = div cur ulong 10
n = add n ulong 1
end
end
p = pos
i = n
while gt i ulong 0 bound 24
i = sub i ulong 1
p = pt_append_byte dst p get tmp i
end
ret p
end

fn pt_write_all fd int buf view uchar * to bool
n = len buf
if eq n ulong 0
ret true
end
if gt n ulong 1048576
ret false
end
off = ulong 0
while lt off n bound 1048576
remn = sub n off
k = write fd buf off remn
if le k long 0
ret false
end
off = add off ulong k
end
ret true
end

note --- Little-endian wire encoding helpers ---

fn pt_put_u32_le dst edit uchar * pos ulong v uint to ulong
if gt add pos ulong 4 len dst
ret pos
end
put dst pos uchar and v uint 255
put dst add pos ulong 1 uchar and shr v uint 8 uint 255
put dst add pos ulong 2 uchar and shr v uint 16 uint 255
put dst add pos ulong 3 uchar and shr v uint 24 uint 255
ret add pos ulong 4
end

fn pt_put_u64_le dst edit uchar * pos ulong v ulong to ulong
if gt add pos ulong 8 len dst
ret pos
end
for i ulong 8
sh = mul i ulong 8
b = uchar and shr v sh ulong 255
put dst add pos i b
end
ret add pos ulong 8
end

note --- Hex nibble helpers ---

fn pt_hex_val b uchar to int
if and ge b uchar 48 le b uchar 57
ret sub int b int 48
end
if and ge b uchar 97 le b uchar 102
ret add sub int b int 97 int 10
end
if and ge b uchar 65 le b uchar 70
ret add sub int b int 65 int 10
end
ret int -1
end

note --- ProtocolVersion (major: u16, minor: u16) ---

fn pv_is_compatible a_maj ushort a_min ushort b_maj ushort b_min ushort to bool
if ne a_maj b_maj
ret false
end
ret le a_min b_min
end

fn pv_eq a_maj ushort a_min ushort b_maj ushort b_min ushort to bool
if ne a_maj b_maj
ret false
end
ret eq a_min b_min
end

fn pv_cmp a_maj ushort a_min ushort b_maj ushort b_min ushort to int
if lt a_maj b_maj
ret int -1
end
if gt a_maj b_maj
ret int 1
end
if lt a_min b_min
ret int -1
end
if gt a_min b_min
ret int 1
end
ret int 0
end

fn pv_format maj ushort min ushort dst edit uchar * to ulong
p = pt_append_u64 dst ulong 0 ulong maj
p = pt_append_byte dst p uchar 46
p = pt_append_u64 dst p ulong min
ret p
end

note --- Digest32 (32-byte SHA-256 digest) ---

fn digest_zero dst edit uchar 32 to void
for i ulong 32
put dst i uchar 0
end
end

fn digest_is_zero d view uchar 32 to bool
for i ulong 32
if ne get d i uchar 0
ret false
end
end
ret true
end

fn digest_eq a view uchar 32 b view uchar 32 to bool
for i ulong 32
if ne get a i get b i
ret false
end
end
ret true
end

fn digest_to_hex d view uchar 32 dst edit uchar 64 to void
for i ulong 32
b = ulong get d i
hi = shr b ulong 4
lo = and b ulong 15
put dst mul i ulong 2 get pt_hex_chars hi
put dst add mul i ulong 2 ulong 1 get pt_hex_chars lo
end
end

fn digest_from_hex src view uchar * dst edit uchar 32 to ulong
if ne len src ulong 64
ret PT_ERR_BAD_LEN
end
for i ulong 32
o = mul i ulong 2
h = pt_hex_val get src o
l = pt_hex_val get src add o ulong 1
if or lt h int 0 lt l int 0
ret PT_ERR_BAD_HEX
end
v = or shl uint h uint 4 uint l
put dst i uchar v
end
ret PT_OK
end

fn digest_format_sha256 d view uchar 32 dst edit uchar 71 to ulong
hx = new uchar 64 0
digest_to_hex d hx
p = pt_append_bytes dst ulong 0 pt_sha256_pfx
p = pt_append_bytes dst p hx
ret p
end

note --- Uuid16 (16-byte RFC 4122 UUID) ---

fn uuid_is_nil u view uchar 16 to bool
for i ulong 16
if ne get u i uchar 0
ret false
end
end
ret true
end

fn uuid_eq a view uchar 16 b view uchar 16 to bool
for i ulong 16
if ne get a i get b i
ret false
end
end
ret true
end

fn uuid_is_v4 u view uchar 16 to bool
ver = and shr get u 6 uchar 4 uchar 15
if ne ver uchar 4
ret false
end
var = shr get u 8 uchar 6
ret eq var uchar 2
end

fn uuid_put_hex_byte dst edit uchar 36 pos ulong b uchar to ulong
v = ulong b
put dst pos get pt_hex_chars shr v ulong 4
put dst add pos ulong 1 get pt_hex_chars and v ulong 15
ret add pos ulong 2
end

fn uuid_to_str u view uchar 16 dst edit uchar 36 to void
p = ulong 0
for i ulong 16
if or eq i ulong 4 or eq i ulong 6 or eq i ulong 8 eq i ulong 10
put dst p uchar 45
p = add p ulong 1
end
p = uuid_put_hex_byte dst p get u i
end
end

fn uuid_from_str src view uchar * dst edit uchar 16 to ulong
if ne len src ulong 36
ret PT_ERR_BAD_UUID
end
if ne get src 8 uchar 45
ret PT_ERR_BAD_UUID
end
if ne get src 13 uchar 45
ret PT_ERR_BAD_UUID
end
if ne get src 18 uchar 45
ret PT_ERR_BAD_UUID
end
if ne get src 23 uchar 45
ret PT_ERR_BAD_UUID
end
p = ulong 0
for i ulong 16
if eq p ulong 8
p = add p ulong 1
end
if eq p ulong 13
p = add p ulong 1
end
if eq p ulong 18
p = add p ulong 1
end
if eq p ulong 23
p = add p ulong 1
end
h = pt_hex_val get src p
l = pt_hex_val get src add p ulong 1
if or lt h int 0 lt l int 0
ret PT_ERR_BAD_HEX
end
v = or shl uint h uint 4 uint l
put dst i uchar v
p = add p ulong 2
end
ret PT_OK
end

note --- SequenceNumber (saturating_add(1)) and Timestamp ---

fn seq_next s ulong to ulong
if eq s U64_MAX
ret U64_MAX
end
ret add s ulong 1
end

fn ts_is_expired now_us ulong has_exp bool exp_us ulong to bool
if not has_exp
ret false
end
ret gt now_us exp_us
end

note --- ArtifactRef validation ---

fn artifact_ref_validate aid view uchar 16 dig view uchar 32 media view uchar * to ulong
if uuid_is_nil aid
ret PT_ERR_NIL_UUID
end
if digest_is_zero dig
ret PT_ERR_ZERO_DIGEST
end
if eq len media ulong 0
ret PT_ERR_EMPTY_FIELD
end
ret PT_OK
end

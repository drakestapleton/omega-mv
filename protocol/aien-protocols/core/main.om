note SPDX-License-Identifier: Apache-2.0
note protocol/aien-protocols/core/main.om: CLI entrypoint for aien-protocols core
note Compose with:
note   si/directives/om2.om om/tls/sha2.om protocol/aien-protocols/core/types.om
note   protocol/aien-protocols/core/provenance.om protocol/aien-protocols/core/action_event.om
note   protocol/aien-protocols/core/main.om

text cmd_uuid "check-uuid"
text cmd_digest "check-digest"
text cmd_sha "sha256"
text cmd_lic "check-license"
text cmd_trans "check-transition"

text msg_ok "OK\n"
text msg_invalid "INVALID\n"
text msg_denied "DENIED\n"
text msg_nl "\n"
text msg_usage "Usage: aien-protocols-core <check-uuid|check-digest|sha256|check-license|check-transition> ...\n"

fn parse_u64_dec s view uchar * to long
n = len s
if eq n ulong 0
ret long -1
end
if gt n ulong 18
ret long -1
end
acc = ulong 0
i = ulong 0
while lt i n bound 18
b = get s i
if or lt b uchar 48 gt b uchar 57
ret long -1
end
d = sub ulong b ulong 48
acc = add mul acc ulong 10 d
i = add i ulong 1
end
ret long acc
end

fn run_check_uuid to int
arg = new uchar 128 0
k = argread ulong 2 arg ulong 0 ulong 128
if le k long 0
w = pt_write_all int 1 msg_invalid
if w
ret int 1
end
ret int 1
end
u = new uchar 16 0
rc = uuid_from_str part arg 0 ulong k u
if ne rc PT_OK
w = pt_write_all int 1 msg_invalid
if w
ret int 1
end
ret int 1
end
if not uuid_is_v4 u
w = pt_write_all int 1 msg_invalid
if w
ret int 1
end
ret int 1
end
w = pt_write_all int 1 msg_ok
if not w
ret int 1
end
ret int 0
end

fn run_check_digest to int
arg = new uchar 128 0
k = argread ulong 2 arg ulong 0 ulong 128
if le k long 0
w = pt_write_all int 1 msg_invalid
if w
ret int 1
end
ret int 1
end
d = new uchar 32 0
rc = digest_from_hex part arg 0 ulong k d
if ne rc PT_OK
w = pt_write_all int 1 msg_invalid
if w
ret int 1
end
ret int 1
end
fmt = new uchar 71 0
fl = digest_format_sha256 d fmt
w1 = pt_write_all int 1 part fmt 0 fl
w2 = pt_write_all int 1 msg_nl
if and w1 w2
ret int 0
end
ret int 1
end

fn run_sha256 to int
arg = new uchar 4096 0
k = argread ulong 2 arg ulong 0 ulong 4096
if lt k long 0
ret int 1
end
d = new uchar 32 0
prov_compute_sha256 part arg 0 ulong k d
fmt = new uchar 71 0
fl = digest_format_sha256 d fmt
w1 = pt_write_all int 1 part fmt 0 fl
w2 = pt_write_all int 1 msg_nl
if and w1 w2
ret int 0
end
ret int 1
end

fn run_check_license to int
lic = new uchar 128 0
csv = new uchar 512 0
kl = argread ulong 2 lic ulong 0 ulong 128
kc = argread ulong 3 csv ulong 0 ulong 512
if or le kl long 0 le kc long 0
w = pt_write_all int 1 msg_denied
if w
ret int 1
end
ret int 1
end
rc = grant_verify_license_csv part lic 0 ulong kl part csv 0 ulong kc
if ne rc PROV_OK
w = pt_write_all int 1 msg_denied
if w
ret int 1
end
ret int 1
end
w = pt_write_all int 1 msg_ok
if not w
ret int 1
end
ret int 0
end

fn run_check_transition to int
a1 = new uchar 32 0
a2 = new uchar 32 0
k1 = argread ulong 2 a1 ulong 0 ulong 32
k2 = argread ulong 3 a2 ulong 0 ulong 32
if or le k1 long 0 le k2 long 0
w = pt_write_all int 1 msg_denied
if w
ret int 1
end
ret int 1
end
v1 = parse_u64_dec part a1 0 ulong k1
v2 = parse_u64_dec part a2 0 ulong k2
if or lt v1 long 0 lt v2 long 0
w = pt_write_all int 1 msg_denied
if w
ret int 1
end
ret int 1
end
rc = exec_transition_check ulong v1 ulong v2
if ne rc AE_OK
w = pt_write_all int 1 msg_denied
if w
ret int 1
end
ret int 1
end
w = pt_write_all int 1 msg_ok
if not w
ret int 1
end
ret int 0
end

fn main to int
argc = argcnt
if lt argc long 3
w = pt_write_all int 2 msg_usage
if w
ret int 2
end
ret int 2
end
cmd = new uchar 64 0
kc = argread ulong 1 cmd ulong 0 ulong 64
if le kc long 0
ret int 2
end
if pt_slice_eq part cmd 0 ulong kc cmd_uuid
ret run_check_uuid
end
if pt_slice_eq part cmd 0 ulong kc cmd_digest
ret run_check_digest
end
if pt_slice_eq part cmd 0 ulong kc cmd_sha
ret run_sha256
end
if pt_slice_eq part cmd 0 ulong kc cmd_lic
if lt argc long 4
w = pt_write_all int 2 msg_usage
if w
ret int 2
end
ret int 2
end
ret run_check_license
end
if pt_slice_eq part cmd 0 ulong kc cmd_trans
if lt argc long 4
w = pt_write_all int 2 msg_usage
if w
ret int 2
end
ret int 2
end
ret run_check_transition
end
w = pt_write_all int 2 msg_usage
if w
ret int 2
end
ret int 2
end

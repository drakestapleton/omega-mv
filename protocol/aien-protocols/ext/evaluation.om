note SPDX-License-Identifier: Apache-2.0
note protocol/aien-protocols/ext/evaluation.om: pure-Omega port of aien-evaluation-protocol (AEI-1)
note Implements evaluation binding verification, basis-point score validation,
note adaptive sequential stopping decisions, and monotonic round replay guards.
note Compose after si/directives/om2.om, om/tls/sha2.om, and protocol/aien-protocols/core/types.om.

const EV_OK ulong 0
const EV_ERR_BINDING ulong 1
const EV_ERR_SCORE_RANGE ulong 2
const EV_ERR_SAMPLE_COUNT ulong 3
const EV_ERR_THRESHOLD ulong 4
const EV_ERR_DIGEST ulong 5
const EV_ERR_REPLAY ulong 6

const EV_DEC_CONTINUE ulong 1
const EV_DEC_ACCEPT ulong 2
const EV_DEC_REJECT ulong 3
const EV_DEC_INVALID ulong 4

const EV_BPS_MAX ulong 10000
const EV_SAFE_MUL_MAX ulong 1844674407370955

text ev_dom_bind "aei1:binding:v1|"

fn ev_compute_binding eval_id view uchar 16 model_dig view uchar 32 dataset_dig view uchar 32 seed ulong dst edit uchar 32 to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx ev_dom_bind
sha256_update ctx eval_id
sha256_update ctx model_dig
sha256_update ctx dataset_dig
sb = new uchar 8 0
slen = pt_put_u64_le sb ulong 0 seed
sha256_update ctx part sb ulong 0 slen
sha256_final ctx dst
end

fn ev_verify_binding eval_id view uchar 16 model_dig view uchar 32 dataset_dig view uchar 32 seed ulong claimed view uchar 32 to ulong
if uuid_is_nil eval_id
ret EV_ERR_BINDING
end
if or digest_is_zero model_dig digest_is_zero dataset_dig
ret EV_ERR_DIGEST
end
exp = new uchar 32 0
ev_compute_binding eval_id model_dig dataset_dig seed exp
if not digest_eq exp claimed
ret EV_ERR_BINDING
end
ret EV_OK
end

fn ev_score_validate passed ulong total ulong pass_bps ulong to ulong
if eq total ulong 0
ret EV_ERR_SAMPLE_COUNT
end
if gt passed total
ret EV_ERR_SCORE_RANGE
end
if gt pass_bps EV_BPS_MAX
ret EV_ERR_SCORE_RANGE
end
if gt passed EV_SAFE_MUL_MAX
ret EV_ERR_SCORE_RANGE
end
calc = div mul passed EV_BPS_MAX total
if ne calc pass_bps
ret EV_ERR_SCORE_RANGE
end
ret EV_OK
end

fn ev_adaptive_decide passed ulong total ulong min_n ulong max_n ulong accept_bps ulong reject_bps ulong to ulong
if or eq min_n ulong 0 gt min_n max_n
ret EV_DEC_INVALID
end
if gt passed total
ret EV_DEC_INVALID
end
if or ge reject_bps accept_bps gt accept_bps EV_BPS_MAX
ret EV_DEC_INVALID
end
if gt passed EV_SAFE_MUL_MAX
ret EV_DEC_INVALID
end
if lt total min_n
ret EV_DEC_CONTINUE
end
bps = div mul passed EV_BPS_MAX total
if ge bps accept_bps
ret EV_DEC_ACCEPT
end
if le bps reject_bps
ret EV_DEC_REJECT
end
if ge total max_n
ret EV_DEC_REJECT
end
ret EV_DEC_CONTINUE
end

fn ev_check_monotonic_round prev_round ulong next_round ulong to ulong
if eq prev_round U64_MAX
ret EV_ERR_REPLAY
end
if ne next_round add prev_round ulong 1
ret EV_ERR_REPLAY
end
ret EV_OK
end

note SPDX-License-Identifier: Apache-2.0
note protocol/aien-protocols/ext/test.om: positive, negative & mutant control test suite
note for aien-protocols-mv extended crates (microjob, probe, evaluation-protocol, discovery-capsule).
note Compose with:
note   si/directives/om2.om om/tls/sha2.om protocol/aien-protocols/core/types.om
note   protocol/aien-protocols/ext/microjob.om protocol/aien-protocols/ext/probe.om
note   protocol/aien-protocols/ext/evaluation.om protocol/aien-protocols/ext/discovery_capsule.om
note   protocol/aien-protocols/ext/test.om

text tx_pass "PASS "
text tx_fail "FAIL "
text tx_nl "\n"

text tx_c1 "microjob_lifecycle_envelope_payout_and_receipt"
text tx_c2 "microjob_mutant_controls_flip_and_perturbation"
text tx_c3 "probe_request_attestation_and_sla_verdicts"
text tx_c4 "probe_mutant_controls_nonce_target_and_rtt"
text tx_c5 "evaluation_binding_scores_adaptive_and_replay"
text tx_c6 "evaluation_mutant_controls_seed_and_digest"
text tx_c7 "discovery_capsule_lifecycle_recipient_routing_and_digest"
text tx_c8 "discovery_capsule_mutant_controls_recip_and_ttl"
text tx_done "PASS aien-protocols-ext all 8 test suites passed (pos+neg+mutant)\n"

text tx_target_ok "spark-node-01.aien.internal:8443"
text tx_target_sp "spark node 01"
text tx_target_mut "spark-node-02.aien.internal:8443"

text tx_recip_did "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSwuBV8xRoAnwWsdvktH"
text tx_recip_rad "rad:z3gqcJUoA1n9HaHKufZs5FCSGazv5"
text tx_recip_node "node:spark-gb10-primary"
text tx_recip_bad "http://evil.example/cap"
text tx_recip_short "did:1"
text tx_recip_sp "did:key:bad space"
text tx_recip_mut "did:key:z6MkpTHR8VNsBxYAAWHut2Geadd9jSwuBV8xRoAnwWsdvktI"

fn tx_report name view uchar * ok bool to int
if ok
w1 = pt_write_all int 1 tx_pass
w2 = pt_write_all int 1 name
w3 = pt_write_all int 1 tx_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = pt_write_all int 1 tx_fail
w5 = pt_write_all int 1 name
w6 = pt_write_all int 1 tx_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn tx_fill_id dst edit uchar 16 v uchar to void
for i ulong 16
put dst i v
end
end

fn tx_fill_dig dst edit uchar 32 v uchar to void
for i ulong 32
put dst i v
end
end

fn test_microjob to bool
note Positive transitions
if ne mj_transition_check MJ_STAT_OPEN MJ_STAT_CLAIMED MJ_OK
ret false
end
if ne mj_transition_check MJ_STAT_CLAIMED MJ_STAT_SUBMITTED MJ_OK
ret false
end
if ne mj_transition_check MJ_STAT_SUBMITTED MJ_STAT_VERIFIED MJ_OK
ret false
end
if ne mj_transition_check MJ_STAT_VERIFIED MJ_STAT_SETTLED MJ_OK
ret false
end
note Negative transitions (skip state, backward, from terminal)
if ne mj_transition_check MJ_STAT_OPEN MJ_STAT_SETTLED MJ_ERR_BAD_STATE
ret false
end
if ne mj_transition_check MJ_STAT_SETTLED MJ_STAT_OPEN MJ_ERR_BAD_STATE
ret false
end
if ne mj_transition_check MJ_STAT_EXPIRED MJ_STAT_CLAIMED MJ_ERR_BAD_STATE
ret false
end
if ne mj_transition_check ulong 99 MJ_STAT_OPEN MJ_ERR_BAD_STATE
ret false
end
note Envelope + deadline + payout positive/negative
jid = new uchar 16 0
nil_id = new uchar 16 0
indig = new uchar 32 0
outdig = new uchar 32 0
zdig = new uchar 32 0
tx_fill_id jid uchar 0x11
tx_fill_dig indig uchar 0x22
tx_fill_dig outdig uchar 0x33
if ne mj_validate_envelope jid indig ulong 5000 ulong 60000 MJ_OK
ret false
end
if ne mj_validate_envelope nil_id indig ulong 5000 ulong 60000 MJ_ERR_BAD_ID
ret false
end
if ne mj_validate_envelope jid zdig ulong 5000 ulong 60000 MJ_ERR_DIGEST
ret false
end
if ne mj_validate_envelope jid indig ulong 0 ulong 60000 MJ_ERR_BUDGET
ret false
end
if ne mj_validate_envelope jid indig ulong 5000 ulong 0 MJ_ERR_TIMEOUT
ret false
end
if ne mj_check_deadline ulong 1000 ulong 5000 ulong 5000 MJ_OK
ret false
end
if ne mj_check_deadline ulong 1000 ulong 5000 ulong 5001 MJ_ERR_DEADLINE
ret false
end
if ne mj_check_deadline ulong 5000 ulong 5000 ulong 5000 MJ_ERR_DEADLINE
ret false
end
if ne mj_check_payout ulong 1000 ulong 850 ulong 50 ulong 100 MJ_OK
ret false
end
if ne mj_check_payout ulong 1000 ulong 850 ulong 50 ulong 101 MJ_ERR_PAYOUT
ret false
end
if ne mj_check_payout ulong 1000 ulong 1001 ulong 0 ulong 0 MJ_ERR_PAYOUT
ret false
end
note Deterministic job and receipt digests
d1 = new uchar 32 0
d2 = new uchar 32 0
mj_compute_digest jid indig ulong 5000 ulong 9000 d1
mj_compute_digest jid indig ulong 5000 ulong 9000 d2
if not digest_eq d1 d2
ret false
end
rcpt = new uchar 32 0
mj_compute_receipt_digest jid indig outdig rcpt
if ne mj_verify_receipt jid indig outdig rcpt MJ_OK
ret false
end
if ne mj_verify_receipt jid indig zdig rcpt MJ_ERR_DIGEST
ret false
end
ret true
end

fn test_microjob_mutants to bool
jid = new uchar 16 0
indig = new uchar 32 0
outdig = new uchar 32 0
rcpt = new uchar 32 0
tx_fill_id jid uchar 0x11
tx_fill_dig indig uchar 0x22
tx_fill_dig outdig uchar 0x33
mj_compute_receipt_digest jid indig outdig rcpt
note Mutant 1: flip 1 bit in receipt digest -> MUST fail
put rcpt 31 xor get rcpt 31 uchar 1
if ne mj_verify_receipt jid indig outdig rcpt MJ_ERR_DIGEST
ret false
end
put rcpt 31 xor get rcpt 31 uchar 1
note Mutant 2: flip 1 bit in output digest -> MUST fail
put outdig 0 xor get outdig 0 uchar 1
if ne mj_verify_receipt jid indig outdig rcpt MJ_ERR_DIGEST
ret false
end
note Mutant 3: perturb payout conservation by +1 -> MUST fail
if ne mj_check_payout ulong 10000 ulong 9000 ulong 501 ulong 500 MJ_ERR_PAYOUT
ret false
end
note Mutant 4: perturb job digest reward by +1 -> MUST change digest
d1 = new uchar 32 0
d2 = new uchar 32 0
mj_compute_digest jid indig ulong 5000 ulong 9000 d1
mj_compute_digest jid indig ulong 5001 ulong 9000 d2
if digest_eq d1 d2
ret false
end
ret true
end

fn test_probe to bool
nonce = new uchar 16 0
nil_n = new uchar 16 0
tx_fill_id nonce uchar 0x44
if ne prb_validate_request PRB_KIND_LATENCY tx_target_ok nonce ulong 5000 PRB_OK
ret false
end
if ne prb_validate_request ulong 0 tx_target_ok nonce ulong 5000 PRB_ERR_KIND
ret false
end
if ne prb_validate_request PRB_KIND_LATENCY tx_target_sp nonce ulong 5000 PRB_ERR_TARGET
ret false
end
if ne prb_validate_request PRB_KIND_LATENCY tx_target_ok nil_n ulong 5000 PRB_ERR_NONCE
ret false
end
if ne prb_validate_request PRB_KIND_LATENCY tx_target_ok nonce ulong 300001 PRB_ERR_TIMEOUT
ret false
end
note Attestation compute & verify
ctx1 = new ulong 40 0
ctx2 = new ulong 40 0
att = new uchar 32 0
prb_attest_head ctx1 PRB_KIND_INTEGRITY tx_target_ok nonce
prb_attest_finish ctx1 ulong 0 ulong 1200 att
prb_attest_head ctx2 PRB_KIND_INTEGRITY tx_target_ok nonce
if ne prb_verify_attestation ctx2 ulong 0 ulong 1200 att PRB_OK
ret false
end
note SLA verdicts
if ne prb_classify_verdict ulong 0 ulong 1000 ulong 5000 ulong 10000 PRB_VERDICT_PASS
ret false
end
if ne prb_classify_verdict ulong 0 ulong 6000 ulong 5000 ulong 10000 PRB_VERDICT_DEGRADED
ret false
end
if ne prb_classify_verdict ulong 0 ulong 10001 ulong 5000 ulong 10000 PRB_VERDICT_TIMEOUT
ret false
end
if ne prb_classify_verdict ulong 500 ulong 1000 ulong 5000 ulong 10000 PRB_VERDICT_FAIL
ret false
end
if ne prb_classify_verdict ulong 0 ulong 1000 ulong 12000 ulong 10000 PRB_VERDICT_FAIL
ret false
end
ret true
end

fn test_probe_mutants to bool
nonce = new uchar 16 0
tx_fill_id nonce uchar 0x55
ctx1 = new ulong 40 0
att = new uchar 32 0
prb_attest_head ctx1 PRB_KIND_INTEGRITY tx_target_ok nonce
prb_attest_finish ctx1 ulong 0 ulong 1200 att
note Mutant 1: mutated RTT (+1us) -> MUST reject attestation
ctx2 = new ulong 40 0
prb_attest_head ctx2 PRB_KIND_INTEGRITY tx_target_ok nonce
if ne prb_verify_attestation ctx2 ulong 0 ulong 1201 att PRB_ERR_ATTEST
ret false
end
note Mutant 2: mutated target string -> MUST reject attestation
ctx3 = new ulong 40 0
prb_attest_head ctx3 PRB_KIND_INTEGRITY tx_target_mut nonce
if ne prb_verify_attestation ctx3 ulong 0 ulong 1200 att PRB_ERR_ATTEST
ret false
end
note Mutant 3: flipped 1 bit in nonce -> MUST reject attestation
put nonce 0 xor get nonce 0 uchar 1
ctx4 = new ulong 40 0
prb_attest_head ctx4 PRB_KIND_INTEGRITY tx_target_ok nonce
if ne prb_verify_attestation ctx4 ulong 0 ulong 1200 att PRB_ERR_ATTEST
ret false
end
ret true
end

fn test_evaluation to bool
eid = new uchar 16 0
nil_id = new uchar 16 0
mdig = new uchar 32 0
ddig = new uchar 32 0
zdig = new uchar 32 0
bdig = new uchar 32 0
tx_fill_id eid uchar 0x66
tx_fill_dig mdig uchar 0x77
tx_fill_dig ddig uchar 0x88
ev_compute_binding eid mdig ddig ulong 42 bdig
if ne ev_verify_binding eid mdig ddig ulong 42 bdig EV_OK
ret false
end
if ne ev_verify_binding nil_id mdig ddig ulong 42 bdig EV_ERR_BINDING
ret false
end
if ne ev_verify_binding eid zdig ddig ulong 42 bdig EV_ERR_DIGEST
ret false
end
note Score validation
if ne ev_score_validate ulong 85 ulong 100 ulong 8500 EV_OK
ret false
end
if ne ev_score_validate ulong 85 ulong 100 ulong 8501 EV_ERR_SCORE_RANGE
ret false
end
if ne ev_score_validate ulong 101 ulong 100 ulong 10000 EV_ERR_SCORE_RANGE
ret false
end
if ne ev_score_validate ulong 0 ulong 0 ulong 0 EV_ERR_SAMPLE_COUNT
ret false
end
note Adaptive decisions: min=20 max=100 accept=9000 reject=5000
if ne ev_adaptive_decide ulong 10 ulong 10 ulong 20 ulong 100 ulong 9000 ulong 5000 EV_DEC_CONTINUE
ret false
end
if ne ev_adaptive_decide ulong 19 ulong 20 ulong 20 ulong 100 ulong 9000 ulong 5000 EV_DEC_ACCEPT
ret false
end
if ne ev_adaptive_decide ulong 10 ulong 20 ulong 20 ulong 100 ulong 9000 ulong 5000 EV_DEC_REJECT
ret false
end
if ne ev_adaptive_decide ulong 75 ulong 100 ulong 20 ulong 100 ulong 9000 ulong 5000 EV_DEC_REJECT
ret false
end
if ne ev_adaptive_decide ulong 40 ulong 50 ulong 20 ulong 100 ulong 9000 ulong 5000 EV_DEC_CONTINUE
ret false
end
note Negative adaptive params: reject >= accept
if ne ev_adaptive_decide ulong 10 ulong 20 ulong 20 ulong 100 ulong 5000 ulong 5000 EV_DEC_INVALID
ret false
end
note Monotonic round replay guard
if ne ev_check_monotonic_round ulong 7 ulong 8 EV_OK
ret false
end
if ne ev_check_monotonic_round ulong 7 ulong 7 EV_ERR_REPLAY
ret false
end
if ne ev_check_monotonic_round ulong 7 ulong 9 EV_ERR_REPLAY
ret false
end
ret true
end

fn test_evaluation_mutants to bool
eid = new uchar 16 0
mdig = new uchar 32 0
ddig = new uchar 32 0
bdig = new uchar 32 0
tx_fill_id eid uchar 0x66
tx_fill_dig mdig uchar 0x77
tx_fill_dig ddig uchar 0x88
ev_compute_binding eid mdig ddig ulong 42 bdig
note Mutant 1: seed mutated 42 -> 43 -> MUST reject
if ne ev_verify_binding eid mdig ddig ulong 43 bdig EV_ERR_BINDING
ret false
end
note Mutant 2: model digest bit-flipped -> MUST reject
put mdig 15 xor get mdig 15 uchar 0x80
if ne ev_verify_binding eid mdig ddig ulong 42 bdig EV_ERR_BINDING
ret false
end
put mdig 15 xor get mdig 15 uchar 0x80
note Mutant 3: claimed binding bit-flipped -> MUST reject
put bdig 0 xor get bdig 0 uchar 1
if ne ev_verify_binding eid mdig ddig ulong 42 bdig EV_ERR_BINDING
ret false
end
ret true
end

fn test_discovery_capsule to bool
note Lifecycle state machine
if ne dc_transition_check DC_STATE_DRAFT DC_STATE_SEALED DC_OK
ret false
end
if ne dc_transition_check DC_STATE_SEALED DC_STATE_ROUTED DC_OK
ret false
end
if ne dc_transition_check DC_STATE_ROUTED DC_STATE_ROUTED DC_OK
ret false
end
if ne dc_transition_check DC_STATE_ROUTED DC_STATE_DELIVERED DC_OK
ret false
end
if ne dc_transition_check DC_STATE_DRAFT DC_STATE_DELIVERED DC_ERR_STATE
ret false
end
if ne dc_transition_check DC_STATE_DELIVERED DC_STATE_ROUTED DC_ERR_STATE
ret false
end
if ne dc_transition_check DC_STATE_REVOKED DC_STATE_SEALED DC_ERR_STATE
ret false
end
note Recipient validation
if ne dc_validate_recipient tx_recip_did DC_OK
ret false
end
if ne dc_validate_recipient tx_recip_rad DC_OK
ret false
end
if ne dc_validate_recipient tx_recip_node DC_OK
ret false
end
if ne dc_validate_recipient tx_recip_bad DC_ERR_RECIPIENT
ret false
end
if ne dc_validate_recipient tx_recip_short DC_ERR_RECIPIENT
ret false
end
if ne dc_validate_recipient tx_recip_sp DC_ERR_RECIPIENT
ret false
end
note Routing hops & TTL
if ne dc_check_routing ulong 3 ulong 8 ulong 1000 ulong 600 ulong 1500 DC_OK
ret false
end
if ne dc_check_routing ulong 9 ulong 8 ulong 1000 ulong 600 ulong 1500 DC_ERR_HOPS
ret false
end
if ne dc_check_routing ulong 1 ulong 17 ulong 1000 ulong 600 ulong 1500 DC_ERR_HOPS
ret false
end
if ne dc_check_routing ulong 1 ulong 8 ulong 1000 ulong 600 ulong 1601 DC_ERR_TTL
ret false
end
if ne dc_check_routing ulong 1 ulong 8 ulong 1000 ulong 600 ulong 999 DC_ERR_TTL
ret false
end
note Capsule validation & digest
cid = new uchar 16 0
pdig = new uchar 32 0
cdig = new uchar 32 0
tx_fill_id cid uchar 0x99
tx_fill_dig pdig uchar 0xaa
if ne dc_verify_capsule cid tx_recip_did pdig ulong 600 ulong 8 DC_OK
ret false
end
ctx1 = new ulong 40 0
ctx2 = new ulong 40 0
dc_hash_head ctx1 cid tx_recip_did pdig
dc_hash_finish ctx1 ulong 600 ulong 8 cdig
dc_hash_head ctx2 cid tx_recip_did pdig
if ne dc_verify_digest ctx2 ulong 600 ulong 8 cdig DC_OK
ret false
end
ret true
end

fn test_discovery_capsule_mutants to bool
cid = new uchar 16 0
pdig = new uchar 32 0
cdig = new uchar 32 0
tx_fill_id cid uchar 0x99
tx_fill_dig pdig uchar 0xaa
ctx1 = new ulong 40 0
dc_hash_head ctx1 cid tx_recip_did pdig
dc_hash_finish ctx1 ulong 600 ulong 8 cdig
note Mutant 1: recipient last char mutated H -> I -> MUST reject
ctx2 = new ulong 40 0
dc_hash_head ctx2 cid tx_recip_mut pdig
if ne dc_verify_digest ctx2 ulong 600 ulong 8 cdig DC_ERR_DIGEST
ret false
end
note Mutant 2: TTL mutated 600 -> 601 -> MUST reject
ctx3 = new ulong 40 0
dc_hash_head ctx3 cid tx_recip_did pdig
if ne dc_verify_digest ctx3 ulong 601 ulong 8 cdig DC_ERR_DIGEST
ret false
end
note Mutant 3: max_hops mutated 8 -> 9 -> MUST reject
ctx4 = new ulong 40 0
dc_hash_head ctx4 cid tx_recip_did pdig
if ne dc_verify_digest ctx4 ulong 600 ulong 9 cdig DC_ERR_DIGEST
ret false
end
ret true
end

fn main to int
fails = int 0
fails = add fails tx_report tx_c1 test_microjob
fails = add fails tx_report tx_c2 test_microjob_mutants
fails = add fails tx_report tx_c3 test_probe
fails = add fails tx_report tx_c4 test_probe_mutants
fails = add fails tx_report tx_c5 test_evaluation
fails = add fails tx_report tx_c6 test_evaluation_mutants
fails = add fails tx_report tx_c7 test_discovery_capsule
fails = add fails tx_report tx_c8 test_discovery_capsule_mutants
if ne fails int 0
ret int 1
end
if not pt_write_all int 1 tx_done
ret int 1
end
ret int 0
end

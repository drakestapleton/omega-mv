note SPDX-License-Identifier: Apache-2.0
note aienux/boot/model_map.om: Pure-Omega MODEL.MAP (AIENMDL1) 4096-byte Extent Map Validator.
note Converted from upstream aienux native/boot/model_map.h.

const MMAP_BYTES ulong 4096
const MMAP_VERSION uint 1
const MMAP_MAX_EXTENTS uint 128

const MMAP_OFF_MAGIC ulong 0
const MMAP_OFF_VERSION ulong 8
const MMAP_OFF_SECTOR_SZ ulong 12
const MMAP_OFF_DISK_GUID ulong 16
const MMAP_OFF_MODEL_LEN ulong 32
const MMAP_OFF_SHA256 ulong 40
const MMAP_OFF_N_EXTENTS ulong 72
const MMAP_OFF_FLAGS ulong 76
const MMAP_OFF_EXTENTS ulong 80

const MMAP_OK int 0
const MMAP_ERR_SHORT int -1
const MMAP_ERR_MAGIC int -2
const MMAP_ERR_VERSION int -3
const MMAP_ERR_SECTOR_SZ int -4
const MMAP_ERR_BLK_MISMATCH int -5
const MMAP_ERR_FLAGS int -6
const MMAP_ERR_ZERO_LEN int -7
const MMAP_ERR_EXT_COUNT int -8
const MMAP_ERR_EXT_BAD int -9
const MMAP_ERR_EXT_PAST_DISK int -10
const MMAP_ERR_EXT_OVERFLOW int -11
const MMAP_ERR_COVERAGE int -12

text mmap_magic "AIENMDL1"

fn model_map_sum_extents buf view uchar * nexts uint last_block ulong sec_out edit ulong 1 to int
sectors = ulong 0
i = ulong 0
n = ulong nexts
while lt i n bound 128
eoff = add MMAP_OFF_EXTENTS mul i 16
elba = boot_rd64_le buf eoff
ecnt = boot_rd64_le buf add eoff 8
if eq ecnt 0
ret MMAP_ERR_EXT_BAD
end
if lt elba 2
ret MMAP_ERR_EXT_BAD
end
eend = add elba ecnt
if lt eend elba
ret MMAP_ERR_EXT_PAST_DISK
end
if ne last_block 0
if gt sub eend 1 last_block
ret MMAP_ERR_EXT_PAST_DISK
end
end
if lt add sectors ecnt sectors
ret MMAP_ERR_EXT_OVERFLOW
end
sectors = add sectors ecnt
i = add i 1
end
put sec_out 0 sectors
ret MMAP_OK
end

fn model_map_check buf view uchar * block_size uint last_block ulong to int
if lt len buf MMAP_BYTES
ret MMAP_ERR_SHORT
end
if not boot_eq_bytes part buf MMAP_OFF_MAGIC 8 mmap_magic
ret MMAP_ERR_MAGIC
end
if ne boot_rd32_le buf MMAP_OFF_VERSION MMAP_VERSION
ret MMAP_ERR_VERSION
end
secsz = boot_rd32_le buf MMAP_OFF_SECTOR_SZ
if and ne secsz 512 ne secsz 4096
ret MMAP_ERR_SECTOR_SZ
end
if and ne block_size 0 ne secsz block_size
ret MMAP_ERR_BLK_MISMATCH
end
if ne boot_rd32_le buf MMAP_OFF_FLAGS 0
ret MMAP_ERR_FLAGS
end
mlen = boot_rd64_le buf MMAP_OFF_MODEL_LEN
if eq mlen 0
ret MMAP_ERR_ZERO_LEN
end
nexts = boot_rd32_le buf MMAP_OFF_N_EXTENTS
if or eq nexts 0 gt nexts MMAP_MAX_EXTENTS
ret MMAP_ERR_EXT_COUNT
end
sbox = new ulong 1 0
rc = model_map_sum_extents buf nexts last_block sbox
if ne rc MMAP_OK
ret rc
end
ssz = ulong secsz
rem_m = rem mlen ssz
need = div mlen ssz
if ne rem_m 0
need = add need 1
end
if ne get sbox 0 need
ret MMAP_ERR_COVERAGE
end
ret MMAP_OK
end

note SPDX-License-Identifier: Apache-2.0
note aienux/boot/handoff.om: Pure-Omega CHANDOF3 Boot Handoff Contract & Validator.
note Converted from upstream aienux native/boot/handoff.h and native/kernel/core/handoff_check.c.
note Compose with: si/directives/om2.om aienux/boot/handoff.om aienux/boot/model_map.om aienux/boot/slot.om aienux/boot/netboot.om <test.om> om/tls/sha2.om

note Shared boot subsystem structs (declared before first fn per OM-2 rule)
struct SlotEval valid uint generation ulong policy_gen ulong err int end

struct SlotDecision boot_slot int reason uint loader_write uint end

struct NbMsg mtype uchar status uchar seconds ushort count ushort mlen ushort total uint offset uint end

note CHANDOF3 magic constants (little-endian "CHANDOF3", "CHANDOF1", "CHANDOF2", stem "CHANDOF")
const HO_MAGIC_V3 ulong 0x33464f444e414843
const HO_MAGIC_V2 ulong 0x32464f444e414843
const HO_MAGIC_V1 ulong 0x31464f444e414843
const HO_MAGIC_STEM ulong 0x00464f444e414843
const HO_STEM_MASK ulong 0x00ffffffffffffff
const HO_BYTES ulong 232

note Handoff field offsets (pinned to CHANDOF3 LP64 ABI)
const HO_OFF_MAGIC ulong 0
const HO_OFF_FW_EL ulong 8
const HO_OFF_DESC_VER ulong 12
const HO_OFF_FW_TTBR0 ulong 16
const HO_OFF_FW_SCTLR ulong 24
const HO_OFF_RSDP ulong 32
const HO_OFF_MMAP ulong 40
const HO_OFF_MAP_SIZE ulong 48
const HO_OFF_DESC_SIZE ulong 56
const HO_OFF_IMG_BASE ulong 64
const HO_OFF_IMG_END ulong 72
const HO_OFF_CNT_FREQ ulong 80
const HO_OFF_ENTRY_TICKS ulong 88
const HO_OFF_EXIT_ATTEMPTS ulong 96
const HO_OFF_RESERVED0 ulong 100
const HO_OFF_COMMIT ulong 104
const HO_OFF_MODEL_BASE ulong 112
const HO_OFF_MODEL_LEN ulong 120
const HO_OFF_MODEL_SHA256 ulong 128
const HO_OFF_MODEL_FLAGS ulong 160
const HO_OFF_MODEL_EXTENTS ulong 164
const HO_OFF_MODEL_READ_US ulong 168
const HO_OFF_MODEL_LAST_BLK ulong 176
const HO_OFF_MODEL_BLK_SZ ulong 184
const HO_OFF_RESERVED1 ulong 188
const HO_OFF_FB_BASE ulong 192
const HO_OFF_FB_SIZE ulong 200
const HO_OFF_FB_WIDTH ulong 208
const HO_OFF_FB_HEIGHT ulong 212
const HO_OFF_FB_PITCH ulong 216
const HO_OFF_FB_FORMAT ulong 220
const HO_OFF_FB_STATUS ulong 224
const HO_OFF_FB_GOP_HANDLES ulong 228

note Model flags
const HO_MODEL_PRESENT uint 1
const HO_MODEL_BLOCKIO uint 2

note Framebuffer status and format constants
const HO_FB_NONE uint 0
const HO_FB_PRESENT uint 1
const HO_FB_NO_LINEAR uint 2
const HO_FB_RGBX uint 0
const HO_FB_BGRX uint 1
const HO_FB_MAX_DIM uint 16384

note Memory map limits
const HO_MAP_MAX ulong 65536
const HO_DESC_MIN ulong 40
const HO_DESC_VERSION uint 1

note Handoff check return codes
const HO_OK int 0
const HO_ERR_SHORT int -1
const HO_ERR_BAD_MAGIC int -2
const HO_ERR_UNSUP_VER int -3
const HO_ERR_RESERVED0 int -4
const HO_ERR_RESERVED1 int -5
const HO_ERR_MODEL_FLAGS int -6
const HO_ERR_MODEL_RANGE int -7
const HO_ERR_MODEL_ALIGN int -8
const HO_ERR_MODEL_OVERFLOW int -9
const HO_ERR_MODEL_BLKSZ int -10
const HO_ERR_MODEL_EXTENTS int -11
const HO_ERR_MODEL_SPURIOUS int -12
const HO_ERR_FB_SPURIOUS int -13
const HO_ERR_FB_STATUS int -14
const HO_ERR_FB_FORMAT int -15
const HO_ERR_FB_DIM int -16
const HO_ERR_FB_BASE int -17
const HO_ERR_FB_SIZE int -18
const HO_ERR_FB_OVERFLOW int -19
const HO_ERR_FB_GOP int -20
const HO_ERR_DESC_SIZE int -21
const HO_ERR_DESC_VER int -22
const HO_ERR_MAP_SIZE int -23

note Little-endian byte helpers shared by boot modules
fn boot_rd16_le buf view uchar * off ulong to ushort
b0 = ushort get buf off
b1 = ushort get buf add off 1
ret or b0 shl b1 8
end

fn boot_rd32_le buf view uchar * off ulong to uint
b0 = uint get buf off
b1 = uint get buf add off 1
b2 = uint get buf add off 2
b3 = uint get buf add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn boot_rd64_le buf view uchar * off ulong to ulong
lo = ulong boot_rd32_le buf off
hi = ulong boot_rd32_le buf add off 4
ret or lo shl hi 32
end

fn boot_wr16_le buf edit uchar * off ulong v ushort to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
end

fn boot_wr32_le buf edit uchar * off ulong v uint to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
end

fn boot_wr64_le buf edit uchar * off ulong v ulong to void
boot_wr32_le buf off uint and v 0xffffffff
boot_wr32_le buf add off 4 uint and shr v 32 0xffffffff
end

fn boot_all_zero buf view uchar * off ulong n ulong to bool
acc = uchar 0
i = ulong 0
while lt i n bound 4096
acc = or acc get buf add off i
i = add i 1
end
ret eq acc 0
end

fn boot_eq_bytes a view uchar * b view uchar * to bool
na = len a
if ne na len b
ret false
end
diff = uchar 0
i = ulong 0
while lt i na bound 4096
diff = or diff xor get a i get b i
i = add i 1
end
ret eq diff 0
end

fn boot_eq_within buf view uchar * o1 ulong o2 ulong n ulong to bool
diff = uchar 0
i = ulong 0
while lt i n bound 4096
diff = or diff xor get buf add o1 i get buf add o2 i
i = add i 1
end
ret eq diff 0
end

fn handoff_check_model buf view uchar * to int
mflags = boot_rd32_le buf HO_OFF_MODEL_FLAGS
allowed = or HO_MODEL_PRESENT HO_MODEL_BLOCKIO
if ne and mflags xor uint 0xffffffff allowed 0
ret HO_ERR_MODEL_FLAGS
end
if ne and mflags HO_MODEL_PRESENT 0
mbase = boot_rd64_le buf HO_OFF_MODEL_BASE
mlen = boot_rd64_le buf HO_OFF_MODEL_LEN
if or eq mbase 0 eq mlen 0
ret HO_ERR_MODEL_RANGE
end
if ne and mbase 0xfff 0
ret HO_ERR_MODEL_ALIGN
end
if lt add mbase mlen mbase
ret HO_ERR_MODEL_OVERFLOW
end
blksz = boot_rd32_le buf HO_OFF_MODEL_BLK_SZ
if and ne blksz 512 ne blksz 4096
ret HO_ERR_MODEL_BLKSZ
end
if eq boot_rd32_le buf HO_OFF_MODEL_EXTENTS 0
ret HO_ERR_MODEL_EXTENTS
end
ret HO_OK
end
if ne boot_rd64_le buf HO_OFF_MODEL_BASE 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne boot_rd64_le buf HO_OFF_MODEL_LEN 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne mflags 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne boot_rd32_le buf HO_OFF_MODEL_EXTENTS 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne boot_rd64_le buf HO_OFF_MODEL_READ_US 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne boot_rd64_le buf HO_OFF_MODEL_LAST_BLK 0
ret HO_ERR_MODEL_SPURIOUS
end
if ne boot_rd32_le buf HO_OFF_MODEL_BLK_SZ 0
ret HO_ERR_MODEL_SPURIOUS
end
if not boot_all_zero buf HO_OFF_MODEL_SHA256 32
ret HO_ERR_MODEL_SPURIOUS
end
ret HO_OK
end

fn handoff_check_fb buf view uchar * to int
fst = boot_rd32_le buf HO_OFF_FB_STATUS
fbase = boot_rd64_le buf HO_OFF_FB_BASE
fsize = boot_rd64_le buf HO_OFF_FB_SIZE
fw = boot_rd32_le buf HO_OFF_FB_WIDTH
fh = boot_rd32_le buf HO_OFF_FB_HEIGHT
fp = boot_rd32_le buf HO_OFF_FB_PITCH
ffmt = boot_rd32_le buf HO_OFF_FB_FORMAT
fgop = boot_rd32_le buf HO_OFF_FB_GOP_HANDLES
if eq fst HO_FB_NONE
if or ne fbase 0 ne fsize 0
ret HO_ERR_FB_SPURIOUS
end
if or ne fw 0 or ne fh 0 ne fp 0
ret HO_ERR_FB_SPURIOUS
end
if or ne ffmt 0 ne fgop 0
ret HO_ERR_FB_SPURIOUS
end
ret HO_OK
end
if eq fst HO_FB_NO_LINEAR
if or ne fbase 0 ne fsize 0
ret HO_ERR_FB_SIZE
end
if eq fgop 0
ret HO_ERR_FB_GOP
end
ret HO_OK
end
if ne fst HO_FB_PRESENT
ret HO_ERR_FB_STATUS
end
if and ne ffmt HO_FB_RGBX ne ffmt HO_FB_BGRX
ret HO_ERR_FB_FORMAT
end
if or eq fw 0 gt fw HO_FB_MAX_DIM
ret HO_ERR_FB_DIM
end
if or eq fh 0 gt fh HO_FB_MAX_DIM
ret HO_ERR_FB_DIM
end
if or lt fp fw gt fp HO_FB_MAX_DIM
ret HO_ERR_FB_DIM
end
if or eq fbase 0 ne and fbase 3 0
ret HO_ERR_FB_BASE
end
need = mul mul ulong fp ulong fh 4
if lt fsize need
ret HO_ERR_FB_SIZE
end
if lt add fbase fsize fbase
ret HO_ERR_FB_OVERFLOW
end
if eq fgop 0
ret HO_ERR_FB_GOP
end
ret HO_OK
end

fn handoff_check buf view uchar * to int
if lt len buf HO_BYTES
ret HO_ERR_SHORT
end
magic = boot_rd64_le buf HO_OFF_MAGIC
if ne magic HO_MAGIC_V3
ver_ch = shr magic 56
if eq and magic HO_STEM_MASK HO_MAGIC_STEM
if and ge ver_ch 48 le ver_ch 57
ret HO_ERR_UNSUP_VER
end
end
ret HO_ERR_BAD_MAGIC
end
if ne boot_rd32_le buf HO_OFF_RESERVED0 0
ret HO_ERR_RESERVED0
end
if ne boot_rd32_le buf HO_OFF_RESERVED1 0
ret HO_ERR_RESERVED1
end
mrc = handoff_check_model buf
if ne mrc HO_OK
ret mrc
end
frc = handoff_check_fb buf
if ne frc HO_OK
ret frc
end
dsz = boot_rd64_le buf HO_OFF_DESC_SIZE
if or lt dsz HO_DESC_MIN ne and dsz 7 0
ret HO_ERR_DESC_SIZE
end
if ne boot_rd32_le buf HO_OFF_DESC_VER HO_DESC_VERSION
ret HO_ERR_DESC_VER
end
msz = boot_rd64_le buf HO_OFF_MAP_SIZE
if or eq msz 0 or gt msz HO_MAP_MAX ne rem msz dsz 0
ret HO_ERR_MAP_SIZE
end
ret HO_OK
end

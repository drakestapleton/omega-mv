note SPDX-License-Identifier: Apache-2.0
note aienux/boot/netboot.om: Pure-Omega AIENOS Lab Netboot Wire Protocol (ANB1).
note Converted from upstream aienux native/boot/netboot_proto.h and native/boot/netboot_proto.c.

const NB_PORT_SERVER ushort 47032
const NB_PORT_LOADER ushort 47033
const NB_HDR ulong 24
const NB_MIN ulong 32
const NB_CHUNK uint 1024
const NB_WINDOW ushort 16
const NB_WAIT_MAX ushort 60
const NB_TEXT_MAX ushort 96
const NB_OBJECT_MIN uint 4097
const NB_OBJECT_MAX uint 67108864
const NB_MSG_MAX ulong 1056

const NB_HELLO uchar 1
const NB_OFFER uchar 2
const NB_WAIT uchar 3
const NB_GET uchar 4
const NB_DATA uchar 5
const NB_DONE uchar 6

const NB_OK int 0
const NB_ERR int -1

text nb_magic "ANB1"

fn nb_put16_be dst edit uchar * off ulong v ushort to void
put dst off uchar and shr v 8 0xff
put dst add off 1 uchar and v 0xff
end

fn nb_put32_be dst edit uchar * off ulong v uint to void
put dst off uchar and shr v 24 0xff
put dst add off 1 uchar and shr v 16 0xff
put dst add off 2 uchar and shr v 8 0xff
put dst add off 3 uchar and v 0xff
end

fn nb_get16_be src view uchar * off ulong to ushort
b0 = ushort get src off
b1 = ushort get src add off 1
ret or shl b0 8 b1
end

fn nb_get32_be src view uchar * off ulong to uint
b0 = uint get src off
b1 = uint get src add off 1
b2 = uint get src add off 2
b3 = uint get src add off 3
ret or or shl b0 24 shl b1 16 or shl b2 8 b3
end

fn nb_printable src view uchar * off ulong n ulong to bool
i = ulong 0
while lt i n bound 128
ch = get src add off i
if or lt ch 0x20 gt ch 0x7e
ret false
end
i = add i 1
end
ret true
end

fn nb_chunks total uint to uint
rem_c = rem total NB_CHUNK
q = div total NB_CHUNK
if ne rem_c 0
ret add q 1
end
ret q
end

fn nb_fields_ok msg view NbMsg payload view uchar * to bool
mt = get msg mtype
if eq mt NB_HELLO
ret ge len payload 6
end
if eq mt NB_OFFER
tot = get msg total
ret and ge tot NB_OBJECT_MIN le tot NB_OBJECT_MAX
end
if eq mt NB_WAIT
sec = get msg seconds
ret and ge sec 1 le sec NB_WAIT_MAX
end
if eq mt NB_GET
cnt = get msg count
off = get msg offset
ret and ge cnt 1 and le cnt NB_WINDOW and eq rem off NB_CHUNK 0 lt off NB_OBJECT_MAX
end
if eq mt NB_DATA
ml = get msg mlen
off = get msg offset
if or lt ml 1 gt ml ushort NB_CHUNK
ret false
end
if or ne rem off NB_CHUNK 0 ge off NB_OBJECT_MAX
ret false
end
ret ge len payload ulong ml
end
if eq mt NB_DONE
st = get msg status
ml = get msg mlen
if or gt st 1 gt ml NB_TEXT_MAX
ret false
end
if eq ml 0
ret true
end
if lt len payload ulong ml
ret false
end
ret nb_printable payload 0 ulong ml
end
ret false
end

fn nb_build msg view NbMsg nonce view uchar 16 payload view uchar * dst edit uchar * to ulong
if not nb_fields_ok msg payload
ret 0
end
mt = get msg mtype
extra = ulong 0
if or eq mt NB_DATA eq mt NB_DONE
extra = ulong get msg mlen
end
n = add NB_MIN extra
if lt len dst n
ret 0
end
for i ulong 32
put dst i 0
end
for i ulong 4
put dst i get nb_magic i
end
put dst 4 mt
for i ulong 16
put dst add 8 i get nonce i
end
if eq mt NB_HELLO
for i ulong 6
put dst add 24 i get payload i
end
ret n
end
if eq mt NB_OFFER
nb_put32_be dst 24 get msg total
nb_put16_be dst 28 ushort NB_CHUNK
ret n
end
if eq mt NB_WAIT
nb_put16_be dst 24 get msg seconds
ret n
end
if eq mt NB_GET
nb_put32_be dst 24 get msg offset
nb_put16_be dst 28 get msg count
ret n
end
if eq mt NB_DATA
nb_put32_be dst 24 get msg offset
nb_put16_be dst 28 get msg mlen
end
if eq mt NB_DONE
put dst 24 get msg status
end
i = ulong 0
while lt i extra bound 1024
put dst add NB_MIN i get payload i
i = add i 1
end
ret n
end

fn nb_parse_body src view uchar * msg edit NbMsg extra_dst edit uchar * to int
slen = len src
mt = get msg mtype
if eq mt NB_HELLO
if or ne slen NB_MIN not boot_all_zero src 30 2
ret NB_ERR
end
if lt len extra_dst 6
ret NB_ERR
end
for i ulong 6
put extra_dst i get src add 24 i
end
ret NB_OK
end
if eq mt NB_OFFER
if or ne slen NB_MIN or ne nb_get16_be src 28 ushort NB_CHUNK not boot_all_zero src 30 2
ret NB_ERR
end
put msg total nb_get32_be src 24
ret NB_OK
end
if eq mt NB_WAIT
if or ne slen NB_MIN not boot_all_zero src 26 6
ret NB_ERR
end
put msg seconds nb_get16_be src 24
ret NB_OK
end
if eq mt NB_GET
if or ne slen NB_MIN not boot_all_zero src 30 2
ret NB_ERR
end
put msg offset nb_get32_be src 24
put msg count nb_get16_be src 28
ret NB_OK
end
if eq mt NB_DATA
if not boot_all_zero src 30 2
ret NB_ERR
end
put msg offset nb_get32_be src 24
ml = nb_get16_be src 28
put msg mlen ml
if ne slen add NB_MIN ulong ml
ret NB_ERR
end
if lt len extra_dst ulong ml
ret NB_ERR
end
i = ulong 0
while lt i ulong ml bound 1024
put extra_dst i get src add NB_MIN i
i = add i 1
end
ret NB_OK
end
if eq mt NB_DONE
if not boot_all_zero src 25 7
ret NB_ERR
end
put msg status get src 24
dlen = sub slen NB_MIN
if gt dlen ulong NB_TEXT_MAX
ret NB_ERR
end
put msg mlen ushort dlen
if lt len extra_dst dlen
ret NB_ERR
end
i = ulong 0
while lt i dlen bound 128
put extra_dst i get src add NB_MIN i
i = add i 1
end
ret NB_OK
end
ret NB_ERR
end

fn nb_parse src view uchar * msg edit NbMsg nonce_dst edit uchar 16 extra_dst edit uchar * to int
slen = len src
if or lt slen NB_MIN gt slen NB_MSG_MAX
ret NB_ERR
end
if not boot_eq_bytes part src 0 4 nb_magic
ret NB_ERR
end
if not boot_all_zero src 5 3
ret NB_ERR
end
put msg mtype get src 4
put msg status 0
put msg seconds 0
put msg count 0
put msg mlen 0
put msg total 0
put msg offset 0
for i ulong 16
put nonce_dst i get src add 8 i
end
if ne nb_parse_body src msg extra_dst NB_OK
ret NB_ERR
end
if not nb_fields_ok msg extra_dst
ret NB_ERR
end
ret NB_OK
end

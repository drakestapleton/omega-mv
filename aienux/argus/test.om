failed = add failed report s_t05 test_05_creq_wire_roundtrip
failed = add failed report s_t06 test_06_ring_watermarks_conservation
failed = add failed report s_t07 test_07_ring_malformed_and_drops
failed = add failed report s_t08 test_08_core_cap_detectors
failed = add failed report s_t09 test_09_sequence_and_replay
failed = add failed report s_t10 test_10_world_and_telemetry_loss
failed = add failed report s_t11 test_11_contain_confirmed

note SPDX-License-Identifier: Apache-2.0
note aienux/disk/nvme_bare_a64efi.om: Bare-metal target a64efi backend for nvme_ro_bare.om.
note Uses target a64efi fwld/fwst/fwsys intrinsics (docs/A64-EFI.md).
note Overflow-safe CNTVCT_EL0 ms clock: (t / frq) * 1000 + ((t % frq) * 1000) / frq.
note Requires Piece 1 platform hooks:
note   a64_dsb_sy() -> void
note   a64_dc_civac_range(pa ulong, len ulong) -> void

fn nvme_mmio_r32 addr ulong to ulong
ret fwld addr 4
end

fn nvme_mmio_r64 addr ulong to ulong
ret fwld addr 8
end

fn nvme_mmio_w32 addr ulong val ulong to void
z = fwst addr 4 val
end

fn nvme_mmio_w64 addr ulong val ulong to void
z = fwst addr 8 val
end

fn nvme_dma_r32 addr ulong to ulong
ret fwld addr 4
end

fn nvme_dma_w32 addr ulong val ulong to void
z = fwst addr 4 val
end

fn nvme_dma_w64 addr ulong val ulong to void
z = fwst addr 8 val
end

fn nvme_dma_r8 addr ulong to ulong
ret fwld addr 1
end

fn nvme_dma_zero addr ulong size ulong to void
i = ulong 0
while lt i size bound 9223372036854775807
if le add i 8 size
z = fwst add addr i 8 0
i = add i 8
else
z = fwst add addr i 1 0
i = add i 1
end
end
end

fn nvme_now_ms to ulong
t = fwsys 2
frq = fwsys 3
if eq frq 0
ret 0
end
sec_ms = mul div t frq 1000
rem_ms = div mul rem t frq 1000 frq
ret add sec_ms rem_ms
end

fn nvme_dsb_sy to void
a64_dsb_sy
end

fn nvme_wb_clean_inv pa ulong nbytes ulong to void
a64_dc_civac_range pa nbytes
a64_dsb_sy
end

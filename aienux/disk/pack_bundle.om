note SPDX-License-Identifier: Apache-2.0
note aienux/disk/pack_bundle.om: Pure-Omega offline GspFwBundle (OMFWBND1) packer.
note Packs local 0700 fwprep.om gb20b outputs (gsp_ga10x.bin, bl.img, fmc.img, fmc.hash,
note fmc.pubkey, fmc.sig, bl_desc, optional weights) into one 4 KiB-aligned image with
note 4 KiB TOC + per-entry SHA-256 digests. ZERO firmware bytes ever committed to git.
note Compose: cat aienux/disk/sha256_bare.om aienux/disk/pack_bundle.om | omc > pack_bundle
note Usage: pack_bundle OUTFILE APP_VER KIND1 FILE1 [KIND2 FILE2 ... up to 8 entries]

global pb_arg uchar 512
global pb_toc uchar 4096
global pb_buf uchar 65536
global pb_zero uchar 4096
global pb_kind ulong 8
global pb_off ulong 8
global pb_sz ulong 8
global pb_sha uchar 256
global pb_stat uchar 144

fn pb_w32 off ulong v ulong to void
put pb_toc off uchar and v 255
put pb_toc add off 1 uchar and shr v 8 255
put pb_toc add off 2 uchar and shr v 16 255
put pb_toc add off 3 uchar and shr v 24 255
end

fn pb_w64 off ulong v ulong to void
pb_w32 off and v 4294967295
pb_w32 add off 4 shr v 32
end

fn pb_getarg idx ulong to ulong
n = argread idx pb_arg 0 511
if lt n 1
exit 2
end
put pb_arg ulong n 0
ret ulong n
end

fn pb_parse_u64 n ulong to ulong
if or eq n 0 gt n 20
exit 2
end
v = ulong 0
i = ulong 0
while lt i n bound 20
c = ulong get pb_arg i
if or lt c 48 gt c 57
exit 2
end
d = sub c 48
if gt v 1844674407370955161
exit 2
end
if eq v 1844674407370955161
if gt d 5
exit 2
end
end
v = add mul v 10 d
i = add i 1
end
ret v
end

fn pb_write_all fd int n ulong is_toc ulong is_zero ulong to void
p = ulong 0
while lt p n bound 999999
r = long 0
if ne is_toc 0
r = write fd pb_toc p sub n p
else
if ne is_zero 0
r = write fd pb_zero p sub n p
else
r = write fd pb_buf p sub n p
end
end
if le r 0
exit 5
end
p = add p ulong r
end
end

fn pb_pack_entry ofd int idx ulong cur_off ulong to ulong
kn = pb_getarg add 3 mul idx 2
put pb_kind idx pb_parse_u64 kn
fn_len = pb_getarg add 4 mul idx 2
ifd = fopen pb_arg 0 fn_len 0 0
if lt ifd 0
exit 4
end
put pb_off idx cur_off
s256_init
tot = ulong 0
while true bound 9223372036854775807
rd = read int ifd pb_buf 0 65536
if lt rd 0
exit 4
end
if eq rd 0
break
end
rn = ulong rd
k = ulong 0
while lt k rn bound 65536
s256_byte get pb_buf k
k = add k 1
end
pb_write_all ofd rn 0 0
tot = add tot rn
end
z = fclose int ifd
s256_fin
put pb_sz idx tot
for s ulong 32
put pb_sha add mul idx 32 s get s2_out s
end
cur_off = add cur_off tot
pad = rem sub 4096 rem cur_off 4096 4096
if ne pad 0
pb_write_all ofd pad 0 1
cur_off = add cur_off pad
end
ret cur_off
end

fn pb_write_toc ofd int app_ver ulong nent ulong to void
put pb_toc 0 79
put pb_toc 1 77
put pb_toc 2 70
put pb_toc 3 87
put pb_toc 4 66
put pb_toc 5 78
put pb_toc 6 68
put pb_toc 7 49
pb_w32 8 1
pb_w32 12 app_ver
pb_w32 16 nent
pb_w32 20 0
idx2 = ulong 0
while lt idx2 nent bound 8
eo = add 32 mul idx2 64
pb_w32 eo get pb_kind idx2
pb_w32 add eo 4 0
pb_w64 add eo 8 get pb_off idx2
pb_w64 add eo 16 get pb_sz idx2
pb_w64 add eo 24 0
for s2 ulong 32
put pb_toc add add eo 32 s2 get pb_sha add mul idx2 32 s2
end
idx2 = add idx2 1
end
p = ulong 0
while lt p 4096 bound 4096
r = pwrite ofd pb_toc p sub 4096 p long p
if le r 0
exit 6
end
p = add p ulong r
end
end

fn main to int
ac = argcnt
if or lt ac 5 ne rem sub ac 3 2 0
ret 2
end
nent = div ulong sub ac 3 2
if or eq nent 0 gt nent 8
ret 2
end
an = pb_getarg 2
app_ver = pb_parse_u64 an
on = pb_getarg 1
ofd = fopen pb_arg 0 on 577 384
if lt ofd 0
ret 3
end
pb_write_all int ofd 4096 0 1
cur_off = ulong 4096
idx = ulong 0
while lt idx nent bound 8
cur_off = pb_pack_entry int ofd idx cur_off
idx = add idx 1
end
pb_write_toc int ofd app_ver nent
z2 = fclose int ofd
ret 0
end

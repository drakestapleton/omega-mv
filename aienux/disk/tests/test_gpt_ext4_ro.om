note SPDX-License-Identifier: Apache-2.0
note aienux/disk/tests/test_gpt_ext4_ro.om: Host test for gpt_ro.om + ext4_ro.om + sha256_bare.om.
note Reads a synthetic GPT + ext4 disk image from argv[1] (generated by run_slice_d.sh) and verifies:
note   1. GPT Protective MBR + Primary/Backup CRC32 + Linux Filesystem partition selection.
note   2. 64-bit ext4 block group descriptors (desc_size=64) + depth-1 extent tree + 48-bit block addressing.
note   3. Reading /aienos/spark-bundle.img (includes normal extent, unwritten extent ee_len>32768, sparse hole)
note      + parsing OMFWBND1 TOC + verifying per-entry SHA-256 against expected digests.
note   4. Fail-closed refusals on /bad/inline (E4_E_INLINE), /bad/encrypt (E4_E_ENCRYPT),
note      /bad/noext (E4_E_NOEXTENT), /bad/badmagic (E4_E_EXT_MAGIC), and corrupted SHA-256 (E4_E_SHA).

global t_fd int 1
global t_arg uchar 256
global t_sink_mode ulong 1
global t_sink_off ulong 1
global t_out uchar 65536

text P_BND "/aienos/spark-bundle.img"
text P_SPARSE "/aienos/sparse.bin"
text P_INLINE "/bad/inline"
text P_ENCRYPT "/bad/encrypt"
text P_NOEXT "/bad/noext"
text P_BADMAGIC "/bad/badmagic"

fn t_pread_lba lba ulong is_gpt ulong to int
fd = get t_fd 0
off = long mul lba 512
p = ulong 0
while lt p 512 bound 512
r = long 0
if ne is_gpt 0
r = pread fd gpt_sec p sub 512 p add off long p
else
r = pread fd e4_sec p sub 512 p add off long p
end
if le r 0
ret -1
end
p = add p ulong r
end
ret 0
end

fn gpt_read_lba lba ulong to int
ret t_pread_lba lba 1
end

fn ext4_read_lba lba ulong to int
ret t_pread_lba lba 0
end

fn ext4_sink off ulong b uchar to void
m = get t_sink_mode 0
if eq m 1
if lt off 4096
put e4_toc off b
end
ret
end
if eq m 2
if lt off 65536
put t_out off b
end
end
end

fn main to int
if lt argcnt 2
ret 2
end
n = argread 1 t_arg 0 255
if lt n 1
ret 2
end
put t_arg ulong n 0
fd = fopen t_arg 0 ulong n 0 0
if lt fd 0
ret 3
end
put t_fd 0 int fd

note 1. Parse GPT (4096 sectors = 2 MiB synthetic disk) and select Linux root partition
r = gpt_ro_parse 4096
if ne r GPT_OK
ret 10
end
r = gpt_ro_select_linux_root
if ne r GPT_OK
ret 11
end
if or ne gpt_ro_part_index 2 ne gpt_ro_first_lba 64
ret 12
end

note 2. Mount read-only ext4 on partition 2
r = ext4_ro_mount gpt_ro_first_lba gpt_ro_sectors
if ne r E4_OK
ret 13
end

note 3. Lookup and read /aienos/sparse.bin (block 0=data 0xA5, block 1=unwritten ee_len=32769, block 2=sparse hole, block 3=data 0x5A)
for i ulong len P_SPARSE
put e4_path i get P_SPARSE i
end
r = ext4_ro_lookup len P_SPARSE
if ne r E4_OK
ret 14
end
if ne ext4_ro_file_size 16384
ret 15
end
put t_sink_mode 0 2
r = ext4_ro_stream 0 16384 1
if ne r E4_OK
ret 16
end
note Verify block 0 == 0xA5, block 1 (unwritten) == 0x00, block 2 (sparse hole) == 0x00, block 3 == 0x5A
b = ulong 0
while lt b 4096 bound 4096
if ne get t_out b 165
ret 17
end
if ne get t_out add 4096 b 0
ret 18
end
if ne get t_out add 8192 b 0
ret 19
end
if ne get t_out add 12288 b 90
ret 20
end
b = add b 1
end

note 4. Lookup /aienos/spark-bundle.img, parse OMFWBND1 TOC, and verify SHA-256 of every entry
for i2 ulong len P_BND
put e4_path i2 get P_BND i2
end
r = ext4_ro_lookup len P_BND
if ne r E4_OK
ret 21
end
note Verify contiguous extent-run helper returns full 9-block run for 36864 B bundle
if ne ext4_ro_map_extent 0 E4_OK
ret 33
end
if ne ext4_ro_run_blks 9
ret 34
end
bsz = ext4_ro_file_size
put t_sink_mode 0 1
r = ext4_ro_stream 0 4096 0
if ne r E4_OK
ret 22
end
r = bundle_parse_toc bsz
if ne r E4_OK
ret 23
end
nent = get e4_bnd_meta 2
if ne nent 7
ret 24
end
put t_sink_mode 0 0
ei = ulong 0
while lt ei nent bound 8
r = ext4_ro_stream get e4_bnd_off ei get e4_bnd_size ei 1
if ne r E4_OK
ret 25
end
for s ulong 32
put e4_want_sha s get e4_bnd_sha add mul ei 32 s
end
if ne ext4_ro_verify_sha E4_OK
ret 26
end
ei = add ei 1
end
note Negative SHA-256 test: flip 1 bit in e4_want_sha[0], must fail closed with E4_E_SHA
put e4_want_sha 0 xor get e4_want_sha 0 1
if ne ext4_ro_verify_sha E4_E_SHA
ret 27
end

note Negative TOC tests: bundle_len < 4096, sz == 0, and overlapping entries MUST fail closed
if ne bundle_parse_toc 2048 E4_E_TOC
ret 35
end
note Zero size on entry 0 (offset 32 + 16 = 48)
sv0 = get e4_toc 48
sv1 = get e4_toc 49
put e4_toc 48 0
put e4_toc 49 0
if ne bundle_parse_toc bsz E4_E_TOC
ret 36
end
put e4_toc 48 sv0
put e4_toc 49 sv1
note Force entry 1 offset (32 + 64 + 8 = 104) to equal entry 0 offset (4096) -> overlap!
put e4_toc 104 0
put e4_toc 105 16
put e4_toc 106 0
put e4_toc 107 0
if ne bundle_parse_toc bsz E4_E_TOC
ret 37
end

note Negative non-regular-file stream test: load directory inode 2 -> MUST fail with E4_E_INO
if ne ext4_ro_load_inode 2 E4_OK
ret 38
end
if ne ext4_ro_stream 0 16 0 E4_E_INO
ret 39
end

note 5. Hostile inode refusals (fail-closed)
for i3 ulong len P_INLINE
put e4_path i3 get P_INLINE i3
end
if ne ext4_ro_lookup len P_INLINE E4_E_INLINE
ret 28
end

for i4 ulong len P_ENCRYPT
put e4_path i4 get P_ENCRYPT i4
end
if ne ext4_ro_lookup len P_ENCRYPT E4_E_ENCRYPT
ret 29
end

for i5 ulong len P_NOEXT
put e4_path i5 get P_NOEXT i5
end
if ne ext4_ro_lookup len P_NOEXT E4_E_NOEXTENT
ret 30
end

for i6 ulong len P_BADMAGIC
put e4_path i6 get P_BADMAGIC i6
end
r = ext4_ro_lookup len P_BADMAGIC
if ne r E4_OK
ret 31
end
if ne ext4_ro_map_block 0 E4_E_EXT_MAGIC
ret 32
end

z = fclose get t_fd 0

note 6. Optional argv[2]: META_BG (0x10) superblock MUST fail closed with E4_E_FEATURE
if ge argcnt 3
n2 = argread 2 t_arg 0 255
if lt n2 1
ret 40
end
put t_arg ulong n2 0
fd2 = fopen t_arg 0 ulong n2 0 0
if lt fd2 0
ret 41
end
put t_fd 0 int fd2
if ne ext4_ro_mount 64 3999 E4_E_FEATURE
ret 42
end
z2 = fclose get t_fd 0
end

ret 0
end

note SPDX-License-Identifier: Apache-2.0
note aienux/spark/spark_main.om: Unified Bare-Metal Aienux SPARK.EFI Entry Point (Phase 3).
note Wires all 6 pure-Omega slices (A -> B -> D -> C -> E -> F) into one compact target a64efi PE32+:
note   Stage 1 (Slice A): UEFI ExitBootServices -> EL2->EL1h -> MMU (MAIR 0x440004ff, 512 MiB Normal-NC)
note                      -> GICv3 + ITS (dedicated boot LPI slot 64) -> 20-core Grace SMP (arm64_ldar)
note   Stage 2 (Slice B): Multi-segment PCIe MCFG/ECAM (Bus 0..1) -> GB20B/NVMe/RTL8127 probe
note                      -> ACPI IORT + SMMUv3 A/B/C (per-stream disjoint Normal-NC DMA + 3 RMRs)
note                      -> BAR0 MMIO mode 1 (fwld/fwst+dsb sy) -> irqbm iqmode=2
note   Stage 3 (Slice D): Strictly RO NVMe -> GPT -> 64-bit ext4 -> 80 MiB OMFWBND1 bundle load
note                      + e4_toc parse + per-entry SHA-256 verification -> RTL8127 NIC + TCP MAC bind
note   Stage 4 (Slice C): GB20B GSP bring-up (sireset/siseti/siencode -> fbparseelf(entry1) + fbbindblobs
note                      + fbbindsig -> 80 MiB abbuild -> sccfg(abpa 1, fbappver) -> gpkt/gin/s2boot
note                      -> tbattach(abcmdpa, abstatpa) -> breset/bsys/breg/bstart -> bpoll/dspauto/
note                      bguest/bstatic to bstate==9 -> gmmu_bm identity VA==PA + mminval + rmchan
note                      0xca6f/0xcec0 + RPC 54 bsetpd + cmbind(marker_va + 16))
note   Stage 5 (Slice E): compute.om + sm_121 pure-.om SASS codegen (cg_dec->bc_regalloc->bw_enc_sm121)
note                      -> q38_run.om (q3_init + q3_set_code + fail-closed weight/kernel check)
note   Stage 6 (Slice F): wire_loop.om OMTK v1 on TCP port 18100 (completion poll wired to marker_va + 16)
note Zero Linux syscalls, zero 184 MiB static .bss, zero firmware bytes embedded.
note Hardware status: HOST_AND_QEMU_VERIFIED (Spark silicon NOT_RUN).

const EFI_MMAP_CAP ulong 65536
const SPK_GB20B_VID ulong 0x10de
const SPK_RTL_VID ulong 0x10ec
const SPK_RTL_DID ulong 0x8127
const SPK_OMTK_PORT ulong 18100
const SPK_MAX_CTX ulong 4096
const SPK_VOCAB ulong 248320
const SPK_STATIC_IP ulong 3232235884
const SPK_GATEWAY ulong 3232235777
const SPK_NETMASK ulong 4294967040
const SPK_ISN ulong 12345
const SPK_BND_CAP ulong 83886080
const SPK_ARENA_CAP ulong 83886080
const SPK_GB20B_BDF ulong 64424509696
const SPK_FMC_HASH_SZ ulong 48
const SPK_FMC_PKEY_SZ ulong 384
const SPK_FMC_SIG_SZ ulong 384

note Error codes emitted by spk_fail(stage, code):
const SPK_E_GIC ulong 101
const SPK_E_ITS ulong 102
const SPK_E_SMP ulong 103
const SPK_E_NO_MCFG ulong 200
const SPK_E_NO_GB20B ulong 201
const SPK_E_BAR0_MAP ulong 202
const SPK_E_GB20B_ID ulong 203
const SPK_E_QUIESCE ulong 204
const SPK_E_SMMU ulong 205
const SPK_E_IRQ_BIND ulong 206
const SPK_E_PCIE_EN ulong 207
const SPK_E_SMMU_BASE ulong 208
const SPK_E_NVME_INIT ulong 301
const SPK_E_GPT ulong 302
const SPK_E_EXT4 ulong 303
const SPK_E_BUNDLE ulong 304
const SPK_E_RTL ulong 305
const SPK_E_BMHAL ulong 401
const SPK_E_FWELF ulong 402
const SPK_E_ARENA ulong 403
const SPK_E_SEC2 ulong 404
const SPK_E_GSPBOOT ulong 405
const SPK_E_GMMU ulong 406
const SPK_E_RMCHAN ulong 407
const SPK_E_CMBIND ulong 408
const SPK_E_COMPUTE ulong 501
const SPK_E_SASS ulong 502
const SPK_E_Q3INIT ulong 503
const SPK_E_WEIGHTS ulong 504

global efi_mmap uchar 65536
global efi_mm_out uchar 64

note spk_st:
note   0=gb20b_bar_h, 1=sgpu_sh, 2=snvme_sh, 3=nvme_dma_pa, 4=rtl_dma_pa,
note   5=bnd_pa, 6=bnd_cap, 7=bnd_len, 8=arena_pa, 9=heap_pa,
note   10=pb_pa, 11=marker_pa, 12=nc_base, 13=wb_base, 14=chan_gen,
note   15=snic_sh, 16=code_pa, 17=gpput, 18=nvme_sec_pa, 19=sass_bytes
global spk_st ulong 24
global spk_nvme_bar ulong 1
global spk_rtl_bar ulong 1
global spk_gb20b_bar ulong 1
note Bundle entry PA/size indexed by kind 1..7: spk_kpa[kind], spk_ksz[kind]
global spk_kpa ulong 8
global spk_ksz ulong 8

text spk_s1 "\n[SPARK 1/6] UEFI->EL1h MMU GICv3+ITS 20-core SMP\n"
text spk_s2 "[SPARK 2/6] PCIe MCFG/ECAM(Bus 0..1) SMMUv3 A/B/C BAR0-MMIO(mode=1) irqbm(iqmode=2)\n"
text spk_s3 "[SPARK 3/6] RO-NVMe GPT ext4 80MiB OMFWBND1(TOC+SHA256) RTL8127/TCP\n"
text spk_s4 "[SPARK 4/6] GB20B GSP(sysinfo+fw_bm+80MiB abbuild+sccfg+SEC2+boot->9) GMMU(VA==PA)+bsetpd rmchan\n"
text spk_s5 "[SPARK 5/6] compute.om sm_121-SASS q38_run.om(marker+16)\n"
text spk_s6 "[SPARK 6/6] OMTK v1 wire_loop READY tcp_port=18100\n"
text spk_el1 "EL1_ALIVE current_el="
text spk_mair " mair=0x"
text spk_sctlr " sctlr=0x"
text spk_tcr " tcr=0x"
text spk_ram " free_mib="
text spk_nc " nc_pool_pa=0x"
text spk_ncsz " nc_pool_mib="
text spk_mcfg " mcfg_segs="
text spk_gic " GICV3_OK rev="
text spk_its " ITS_OK cmds="
text spk_smp " SMP_ONLINE online="
text spk_exp " expected="
text spk_fl " failed="
text spk_ms " boot_ms="
text spk_fail_a "[SPARK FAIL stage="
text spk_fail_b " code="
text spk_fail_c "]\n"
text spk_bnd_path "/aienos/spark-bundle.img"
text spk_q_s3net "[SPARK QEMU] stage 3 bundle verified; RTL8127/TCP STUB (no QEMU model)\n"
text spk_q_stop "SPARK_QEMU_E2E_PASS real=stage1,stage2(pcie+smmuv3+streams+bme),stage3(nvme+gpt+ext4+omfwbnd1-sha256) stubbed=gb20b-regs,stage3-net,stage4,stage5,stage6\n"

note ========================================================================
note Cross-Slice Bare-Metal Seam Implementations (Pieces 1 <-> 2 <-> 3 <-> 4 <-> 5 <-> 6)
note ========================================================================

fn a64_dsb_sy to void
arm64_dsb_sy
end

fn a64_dc_civac_range pa ulong nbytes ulong to void
arm64_dc_civac_range pa nbytes
end

fn q3_dc_civac pa ulong nbytes ulong to void
arm64_dc_civac_range pa nbytes
end

note Piece 3 dead-simulator-branch guards (never called in gspmode=2 / bare-metal)
fn s2simrd off ulong to ulong
trap 9
end

fn s2simwr off ulong v ulong to void
trap 9
end

fn gsbind chid uint tok uint ent uint gpva ulong upa ulong ipa ulong to long
trap 9
end

fn gsdisable chid uint to long
trap 9
end

fn gsidle chid uint to long
trap 9
end

note Piece 3 (bm_hal.om) BAR0/Normal-NC/CNTVCT callbacks -> Piece 2 bar0_mmio (mode=1) & Piece 1 fwops
fn bmrbarrd off ulong to ulong
ret bmmio_r32 long get spk_st 0 off
end

fn bmrbarwr off ulong v ulong to void
r = bmmio_w32 long get spk_st 0 off v
end

fn bmrmemrd8 pa ulong to uchar
ret uchar and fwld pa 1 255
end

fn bmrmemwr8 pa ulong v uchar to void
x = fwst pa 1 ulong v
end

fn bmrcntvct to ulong
ret fwsys 2
end

note Piece 4 (gpt_ro.om / ext4_ro.om) sector reader -> nvme_ro_bare.om (strictly read-only)
fn spk_nvme_read1 lba ulong to int
sec_pa = get spk_st 18
if eq sec_pa 0
ret -1
end
ret nvme_read_direct lba 1 sec_pa 0
end

fn gpt_read_lba lba ulong to int
rc = spk_nvme_read1 lba
if ne rc 0
ret rc
end
sec_pa = get spk_st 18
i = ulong 0
while lt i 512 bound 512
put gpt_sec i uchar and fwld add sec_pa i 1 255
i = add i 1
end
ret 0
end

fn ext4_read_lba lba ulong to int
rc = spk_nvme_read1 lba
if ne rc 0
ret rc
end
sec_pa = get spk_st 18
i = ulong 0
while lt i 512 bound 512
put e4_sec i uchar and fwld add sec_pa i 1 255
i = add i 1
end
ret 0
end

note Stream bundle bytes into 80 MiB Normal-NC bnd_pa and mirror [0..4096) into e4_toc[].
fn ext4_sink off ulong b uchar to void
bpa = get spk_st 5
bcap = get spk_st 6
if and ne bpa 0 lt off bcap
x = fwst add bpa off 1 ulong b
if lt off 4096
put e4_toc off b
end
if ge add off 1 get spk_st 7
put spk_st 7 add off 1
end
end
end

note Piece 6 (wire_loop.om) platform/NIC/GPU seams -> Pieces 1, 2, 3, 4, 5
fn wl_cntvct to ulong
ret fwsys 2
end

fn wl_cntfrq to ulong
ret fwsys 3
end

fn wl_dsb_ish to void
arm64_dsb_ish
end

fn wl_nic_rx to ulong
e = rtlrx
if ne e 0
ret 0
end
n = get rs S_RXLEN
if or eq n 0 gt n 2048
ret 0
end
i = ulong 0
while lt i n bound 2048
put Trx i get obuf i
i = add i 1
end
ret n
end

fn wl_nic_tx n ulong to long
if or lt n 14 gt n FMAX
ret -1
end
e = rtltxrec
if ne e 0
ret -2
end
i = ulong 0
while lt i n bound 1514
put fbuf i get Ttx i
i = add i 1
end
r = rtltx n
if ne r 0
ret -3
end
ret 0
end

fn wl_nic_reclaim to void
e = rtltxrec
end

fn wl_q38_reset_kv keep_pos ulong to long
ret q38_reset_kv keep_pos
end

fn wl_q38_stage_step tok uint kv uint mode uchar to long
ret q38_stage_step tok kv mode
end

fn wl_q38_verify_step to long
md = uchar and get wl_st WL_S_CURMODE 255
rc = q38_verify_step md
if lt rc 0
ret rc
end
ret 0
end

fn wl_q38_read_tok to uint
ret uint mmrd32 q3_ncva 6
end

note Piece 6 -> Piece 3 submission: PB already flushed with DSB SY by Piece 5;
note chpush executes DSB SY -> GPFIFO -> DSB SY -> USERD.GPPut -> DSB SY -> BAR0 doorbell (0x00BB0090),
note then cmsub accounts the in-flight entry for cmpoll(marker_va + 16).
fn wl_gpu_kick pb_words uint to long
pbva = get spk_st 10
rc = chpush 0 pbva pb_words
if lt rc 0
ret rc
end
ret cmsub 0 1
end

note Piece 6 -> Piece 3/5 completion poll: polls marker_va + 16 via cmbind(0, semslot, 16, gen)
note matching Piece 5's C3 marker1(WFI) -> L2_FLUSH -> marker2(WFI) completion tail!
fn wl_gpu_poll to long
ret cmpoll 0
end

fn wl_gpu_irq_check to long
ret iqservice get spk_st 14 16
end

fn wl_gpu_quarantine to void
r = cmquar 0 get spk_st 14
end

fn wl_should_stop to ulong
ret 0
end

note ========================================================================
note Fail-Closed Helper (NEVER touches dead UEFI Boot Services post-EBS)
note ========================================================================

fn spk_fail stage ulong code ulong to void
uart_puts spk_fail_a
uart_putdec stage
uart_puts spk_fail_b
uart_putdec code
uart_puts spk_fail_c
arm64_psci_reset get acpi_info 7
i = ulong 0
while lt i 9223372036854775807 bound 9223372036854775807
arm64_wfe
end
end

note ========================================================================
note Stage 1: UEFI ExitBootServices + EL1h + GICv3/ITS + 20-core SMP
note ========================================================================

fn efi_find_acpi2_rsdp to ulong
ret efcfg 0x11d3e4f18868e871 0x81883cc7800022bc
end

fn efi_exit_boot_services to bool
bs = efbs
ih = fwsys 0
x = fwcall fwld add bs 256 8 0 0 0 0 0 0
outp = fwadr efi_mm_out 0 64
x = fwst add outp 40 8 efi_find_acpi2_rsdp
x = fwst add outp 48 8 arm64_current_el
gmm = fwld add bs 56 8
ebs = fwld add bs 232 8
mp = fwadr efi_mmap 0 EFI_MMAP_CAP
att = ulong 0
while lt att 8 bound 8
x = fwst outp 8 EFI_MMAP_CAP
s = fwcall gmm outp mp add outp 8 add outp 16 add outp 24 0
if ne s 0
ret false
end
s2 = fwcall ebs ih fwld add outp 8 8 0 0 0 0
att = add att 1
if eq s2 0
x = fwst add outp 32 8 att
ret true
end
end
ret false
end

fn reserve_gb10_rmrs to void
frames_reserve 0x00000000a1600000 0x00000000b9800000
frames_reserve 0x0000000280000000 0x0000000303000000
end

fn spk_stage1 to bool
lpi_out = new ulong 1 0
uart_puts spk_s1
uart_puts spk_el1
uart_putdec arm64_current_el
uart_puts spk_mair
uart_puthex arm64_sysrd SYSREG_MAIR_EL1
uart_puts spk_sctlr
uart_puthex arm64_sysrd SYSREG_SCTLR_EL1
uart_puts spk_tcr
uart_puthex arm64_sysrd SYSREG_TCR_EL1
uart_puts u_nl
uart_puts spk_ram
uart_putdec div frames_free_bytes 1048576
uart_puts spk_nc
uart_puthex dma_pool_base
uart_puts spk_ncsz
uart_putdec div dma_pool_size 1048576
uart_puts spk_mcfg
uart_putdec get acpi_info 12
uart_puts u_nl
if not gicv3_init get acpi_info 2 get acpi_info 3 get acpi_info 4 get acpi_info 5
spk_fail 1 SPK_E_GIC
ret false
end
uart_puts spk_gic
uart_putdec get gic_state 4
uart_puts u_nl
if ne get acpi_info 5 0
if not gic_its_init
spk_fail 1 SPK_E_ITS
ret false
end
db = gic_its_map_msix 0x100 8 lpi_out
if or ne db add get acpi_info 5 GITS_TRANSLATER ne get lpi_out 0 8192
spk_fail 1 SPK_E_ITS
ret false
end
uart_puts spk_its
uart_putdec get gic_state 11
uart_puts u_nl
end
online = smp_bringup
uart_puts spk_smp
uart_putdec online
uart_puts spk_exp
uart_putdec get smp_stats 1
uart_puts spk_fl
uart_putdec get smp_stats 2
uart_puts spk_ms
uart_putdec arm64_time_ms
uart_puts u_nl
if ne get smp_stats 2 0
spk_fail 1 SPK_E_SMP
ret false
end
ret true
end

note ========================================================================
note Stage 2: PCIe Multi-Segment ECAM (Bus 0..1) + IORT/SMMUv3 A/B/C + BAR0 + IRQ
note ========================================================================

fn spk_register_mcfg_segs to ulong
nm = get acpi_info 12
if eq nm 0
ret 0
end
if gt nm PCIE_MAX_SEGS
nm = PCIE_MAX_SEGS
end
mapped = ulong 0
i = ulong 0
while lt i nm bound 16
base = get acpi_mcfg_base i
seg = uint get acpi_mcfg_seg i
b0 = uchar and get acpi_mcfg_sbus i 255
b1 = uchar and get acpi_mcfg_ebus i 255
note Map 2 MiB ECAM window (Bus 0..1) as Device-nGnRnE XN for Spark endpoint probing
if ne base 0
if mmio_map_device base SPARK_ECAM_WIN_SZ
put pcie_seg_base mapped base
put pcie_seg_id mapped seg
put pcie_seg_bus0 mapped b0
if gt b1 1
put pcie_seg_bus1 mapped uchar 1
else
put pcie_seg_bus1 mapped b1
end
mapped = add mapped 1
end
end
i = add i 1
end
put pcie_nsegs 0 mapped
j = ulong 0
while lt j mapped bound 16
h = pcie_map_seg_ecam get pcie_seg_id j
j = add j 1
end
ret mapped
end

note spk_dev: 0=gpu seg, 1=gpu rid, 2=nvme seg, 3=nvme rid, 4=rtl seg, 5=rtl rid,
note 6=found mask (1 = GPU, 2 = NVMe, 4 = RTL8127). Streams and endpoint enables use the probed BDFs.
global spk_dev ulong 8

note Decode a memory BAR at pcie_dev_info[lo] (+ upper half at [lo+1] only when it is a 64-bit BAR,
note type bits [2:1] == 0b10, PCIe Base r6.0 §7.5.1.2.1).
fn spk_bar lo ulong to ulong
b = get pcie_dev_info lo
bar = and b 0xfffffff0
if eq and b 6 4
bar = or bar shl get pcie_dev_info add lo 1 32
end
ret bar
end

fn spk_mark k ulong seg uint bus ulong d ulong to void
put spk_dev mul k 2 ulong seg
put spk_dev add mul k 2 1 or shl bus 8 shl d 3
put spk_dev 6 or get spk_dev 6 shl ulong 1 k
end

fn spk_record_gpu seg uint bus ulong d ulong to bool
bar0 = spk_bar 5
if eq bar0 0
bar0 = SPK_PLAT_GPU_BAR_FALLBACK
end
if eq bar0 0
ret false
end
put spk_gb20b_bar 0 bar0
spk_mark 0 seg bus d
ret true
end

fn spk_record_dev seg uint bus ulong d ulong to bool
vid = get pcie_dev_info 0
did = get pcie_dev_info 1
if spk_plat_is_gpu vid did
ret spk_record_gpu seg bus d
end
if and eq vid SPK_RTL_VID eq did SPK_RTL_DID
bar2 = spk_bar 7
if eq bar2 0
bar2 = SPARK_RTL8127_BAR2_PA
end
put spk_rtl_bar 0 bar2
spk_mark 2 seg bus d
end
if eq shr get pcie_dev_info 4 8 0x010802
if eq and get spk_dev 6 2 0
nbar = spk_bar 5
if eq nbar 0
nbar = SPARK_NVME_BAR0_PA
end
put spk_nvme_bar 0 nbar
spk_mark 1 seg bus d
end
end
ret false
end

note Scan Bus 0..1 (pcie_seg_bus0..pcie_seg_bus1) across all MCFG segments:
note on DGX Spark GB20B=000f:01:00.0, NVMe=0004:01:00.0, RTL8127=0007:01:00.0 (all Bus 1!).
fn spk_probe_seg_bus seg uint bus ulong to bool
found = false
d = ulong 0
while lt d 32 bound 32
if eq pcie_probe_dev seg bus d 0 PCIE_OK
if spk_record_dev seg bus d
found = true
end
end
d = add d 1
end
ret found
end

fn spk_probe_gb20b to bool
ns = get pcie_nsegs 0
found = false
i = ulong 0
while lt i ns bound 16
seg = get pcie_seg_id i
b = ulong get pcie_seg_bus0 i
b1 = ulong get pcie_seg_bus1 i
while le b b1 bound 2
if spk_probe_seg_bus seg b
found = true
end
b = add b 1
end
i = add i 1
end
ret found
end

note Parse ACPI IORT and bring up SMMUv3 A/B (128 KiB aligned STRTAB) + C (ABORT_ONLY)
note + open disjoint streams for GB20B (000f:01:00.0, auto-maps 3 RMRs), NVMe, RTL8127.
fn spk_init_iort to bool
ib = new uchar 4096 0
ipa = get acpi_info 10
ilen = get acpi_info 11
if or eq ipa 0 or lt ilen 48 gt ilen 4096
ret false
end
k = ulong 0
while lt k ilen bound 4096
put ib k uchar and fwld add ipa k 1 255
k = add k 1
end
ret eq iort_parse part ib 0 ilen 1
end

fn spk_init_smmu_one inst ulong base ulong min_bits ulong to bool
if not mmio_map_device base SPARK_SMMU_SZ
ret false
end
st_p = dma_alloc_nc 32 131072
cq_p = dma_alloc_nc 1 4096
eq_p = dma_alloc_nc 1 4096
if or eq st_p 0 or eq cq_p 0 eq eq_p 0
ret false
end
ret eq smmu_init_instance inst base min_bits st_p cq_p eq_p SMMU_OK
end

note Stage-1 table / L2-STE pool for the mode-1 SMMUv3 back end (4 MiB Normal-NC; GB10 RMRs use 2 MiB blocks).
const SPK_SMMU_PT_PAGES ulong 1024

note IORT is the source of truth for SMMUv3 bases, but only after it agrees with the platform map
note (plat_*.om): exactly SPK_PLAT_NSMMU SMMUv3 nodes, node i at spk_plat_smmu_base i (GB10: A/B/C). An
note extra node would be an SMMU left unprogrammed (GBPA unknown); any mismatch means the A/B/C role
note assumption is wrong -> fail closed (SPK_E_SMMU_BASE 208).
fn spk_check_smmu_bases to bool
ns = get iort_meta 0
if ne ns SPK_PLAT_NSMMU
ret false
end
i = ulong 0
while lt i ns bound 3
if ne get iort_smmu_base i spk_plat_smmu_base i
ret false
end
i = add i 1
end
ret true
end

note Requires spk_init_iort + spk_check_smmu_bases to have passed; bases come from the (checked) IORT.
fn spk_init_smmu_abc to bool
pool = dma_alloc_nc SPK_SMMU_PT_PAGES 4096
if ne smmu_set_pt_pool pool SPK_SMMU_PT_PAGES SMMU_OK
ret false
end
if eq SPK_PLAT_QEMU 1
note QEMU virt iommu=smmuv3: a single SMMUv3 from IORT node 0 (IDR1.SIDSIZE = 16).
ret spk_init_smmu_one 0 get iort_smmu_base 0 16
end
if not spk_init_smmu_one 0 get iort_smmu_base 0 20
ret false
end
if not spk_init_smmu_one 1 get iort_smmu_base 1 9
ret false
end
cb = get iort_smmu_base 2
if not mmio_map_device cb SPARK_SMMU_SZ
ret false
end
ret eq smmu_abort_only 2 cb SMMU_OK
end

fn spk_open_one_stream seg uint rid uint st_slot ulong to bool
cd = dma_alloc_nc 1 4096
tt = dma_alloc_nc 1 4096
if or eq cd 0 eq tt 0
ret false
end
sh = smmu_open_stream seg rid cd tt
if le sh 0
ret false
end
put spk_st st_slot ulong sh
ret true
end

fn spk_open_dev_stream k ulong st_slot ulong to bool
ret spk_open_one_stream uint get spk_dev mul k 2 uint get spk_dev add mul k 2 1 st_slot
end

note Streams for the probed GPU (slot 1), NVMe (slot 2) and RTL8127 (slot 15, when present).
fn spk_open_smmu_streams to bool
if not spk_open_dev_stream 0 1
ret false
end
if not spk_open_dev_stream 1 2
ret false
end
if eq and get spk_dev 6 4 0
ret true
end
ret spk_open_dev_stream 2 15
end

note Enable MemSpace + BusMaster (+ DisINTx, MSI-X masked) on each used endpoint only AFTER its SMMUv3
note stream is live: pcie_quiesce_unused may have cleared BME, and firmware may leave it clear post-EBS.
fn spk_enable_dev k ulong to bool
seg = uint get spk_dev mul k 2
rid = get spk_dev add mul k 2 1
ret eq pcie_enable_endpoint seg shr rid 8 and shr rid 3 31 and rid 7 PCIE_OK
end

fn spk_enable_endpoints to bool
if not spk_enable_dev 0
ret false
end
if not spk_enable_dev 1
ret false
end
if eq and get spk_dev 6 4 0
ret true
end
ret spk_enable_dev 2
end

fn spk_stage2 to bool
uart_puts spk_s2
bmmio_reset
pcie_reset
smmu_reset
ibm_reset
note Switch bar0_mmio.om to bare-metal mode 1 (fwld/fwst + dsb sy via fwops.om).
put bmmio_mode 0 1
put spk_gb20b_bar 0 0
put spk_nvme_bar 0 0
put spk_rtl_bar 0 0
for di ulong 8
put spk_dev di 0
end
nsegs = spk_register_mcfg_segs
if eq nsegs 0
spk_fail 2 SPK_E_NO_MCFG
ret false
end
note Probe PCIe ECAM Bus 0..1 for GB20B (0x10de). Fails closed cleanly on QEMU virt (absent GPU).
if not spk_probe_gb20b
spk_fail 2 SPK_E_NO_GB20B
ret false
end
gbar = get spk_gb20b_bar 0
if not mmio_map_device gbar SPK_PLAT_GPU_BAR_SZ
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
hb = bmmio_register gbar gbar SPK_PLAT_GPU_BAR_SZ BMMIO_ATTR_NGNRNE
if le hb 0
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
put spk_st 0 ulong hb
if not spk_plat_verify_gpu hb
spk_fail 2 SPK_E_GB20B_ID
ret false
end
note NVMe is mandatory everywhere; RTL8127 is mandatory on GB10 (SPK_PLAT_NEED_RTL). No device found ->
note fail closed instead of touching a hard-coded BAR.
if eq and get spk_dev 6 2 0
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
if not mmio_map_device get spk_nvme_bar 0 SPARK_NVME_BAR0_SZ
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
if eq and get spk_dev 6 4 0
if eq SPK_PLAT_NEED_RTL 1
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
else
if not mmio_map_device get spk_rtl_bar 0 SPARK_RTL8127_BAR2_SZ
spk_fail 2 SPK_E_BAR0_MAP
ret false
end
end
if lt pcie_quiesce_unused 0
spk_fail 2 SPK_E_QUIESCE
ret false
end
note Initialize IORT + SMMUv3 A/B/C + open disjoint streams (GB20B + 3 RMRs, NVMe, RTL8127)
note BEFORE any NVMe/RTL8127/GB20B DMA is enabled.
if not spk_init_iort
spk_fail 2 SPK_E_SMMU
ret false
end
if not spk_check_smmu_bases
spk_fail 2 SPK_E_SMMU_BASE
ret false
end
if not spk_init_smmu_abc
spk_fail 2 SPK_E_SMMU
ret false
end
if not spk_open_smmu_streams
spk_fail 2 SPK_E_SMMU
ret false
end
spk_plat_note_stage2
if not spk_enable_endpoints
spk_fail 2 SPK_E_PCIE_EN
ret false
end
if eq SPK_PLAT_QEMU 0
if ne ibm_bind hb 1 0
spk_fail 2 SPK_E_IRQ_BIND
ret false
end
end
put iqmode 0 2
ret true
end

note ========================================================================
note Stage 3: Strictly RO NVMe + GPT + 64-bit ext4 + 80 MiB OMFWBND1 + RTL8127
note ========================================================================

fn spk_stage3_disk to bool
spk_nvdma = dma_alloc_nc 16 4096
sec_pa = dma_alloc_nc 1 4096
bnd_pa = dma_alloc_nc 20480 65536
if or eq spk_nvdma 0 or eq sec_pa 0 eq bnd_pa 0
spk_fail 3 SPK_E_NVME_INIT
ret false
end
put spk_st 3 spk_nvdma
put spk_st 18 sec_pa
put spk_st 5 bnd_pa
put spk_st 6 SPK_BND_CAP
put spk_st 7 0
note Map NVMe DMA queues + bounce page on NVMe SMMUv3 stream before nvme_init
snvme = long get spk_st 2
if ne smmu_map_span snvme spk_nvdma 65536 0 SMMU_OK
spk_fail 3 SPK_E_NVME_INIT
ret false
end
if ne smmu_map_span snvme sec_pa 4096 0 SMMU_OK
spk_fail 3 SPK_E_NVME_INIT
ret false
end
if ne nvme_init get spk_nvme_bar 0 spk_nvdma 1 0
spk_fail 3 SPK_E_NVME_INIT
ret false
end
if ne gpt_ro_parse nvme_ns_blocks 0
spk_fail 3 SPK_E_GPT
ret false
end
if ne gpt_ro_select_linux_root 0
spk_fail 3 SPK_E_GPT
ret false
end
p_lba = gpt_ro_first_lba
p_secs = gpt_ro_sectors
if or eq p_lba 0 eq p_secs 0
spk_fail 3 SPK_E_GPT
ret false
end
if ne ext4_ro_mount p_lba p_secs 0
spk_fail 3 SPK_E_EXT4
ret false
end
ret true
end

note Verify SHA-256 of one bundle entry [pa, pa + sz) against e4_bnd_sha[idx*32..+32).
fn spk_verify_bnd_entry idx ulong pa ulong sz ulong to bool
s256_init
remn = sz
cur = pa
while gt remn 0 bound 20480
ch = remn
if gt ch 4096
ch = ulong 4096
end
j = ulong 0
while lt j ch bound 4096
s256_byte uchar and fwld add cur j 1 255
j = add j 1
end
cur = add cur ch
remn = sub remn ch
end
s256_fin
base = mul idx 32
for b ulong 32
if ne get s2_out b get e4_bnd_sha add base b
ret false
end
end
ret true
end

fn spk_stage3_bundle to bool
for k ulong 8
put spk_kpa k 0
put spk_ksz k 0
end
plen = len spk_bnd_path
pi = ulong 0
while lt pi plen bound 256
put e4_path pi get spk_bnd_path pi
pi = add pi 1
end
if ne ext4_ro_lookup plen 0
spk_fail 3 SPK_E_BUNDLE
ret false
end
fsz = ext4_ro_file_size
if or lt fsz 4096 gt fsz SPK_BND_CAP
spk_fail 3 SPK_E_BUNDLE
ret false
end
if ne ext4_ro_stream 0 fsz 0 0
spk_fail 3 SPK_E_BUNDLE
ret false
end
if ne bundle_parse_toc fsz 0
spk_fail 3 SPK_E_BUNDLE
ret false
end
cnt = get e4_bnd_meta 2
bpa = get spk_st 5
if or eq cnt 0 gt cnt 8
spk_fail 3 SPK_E_BUNDLE
ret false
end
i = ulong 0
while lt i cnt bound 8
ek = get e4_bnd_kind i
eo = get e4_bnd_off i
es = get e4_bnd_size i
if not spk_verify_bnd_entry i add bpa eo es
spk_fail 3 SPK_E_BUNDLE
ret false
end
if and ge ek 1 le ek 7
put spk_kpa ek add bpa eo
put spk_ksz ek es
end
i = add i 1
end
note Require kinds 1..6 (gsp.bin, bl.img, fmc.img, fmc.hash, fmc.pubkey, fmc.sig) present & verified
for req ulong 6
if or eq get spk_kpa add req 1 0 eq get spk_ksz add req 1 0
spk_fail 3 SPK_E_BUNDLE
ret false
end
end
note abcotmk (arena_bm.om) reads fixed 48 B fmc.hash, 384 B fmc.pubkey, 384 B fmc.sig from these PAs:
note refuse undersized entries so the COT packet never reads past a verified entry.
if lt get spk_ksz 4 SPK_FMC_HASH_SZ
spk_fail 3 SPK_E_BUNDLE
ret false
end
if lt get spk_ksz 5 SPK_FMC_PKEY_SZ
spk_fail 3 SPK_E_BUNDLE
ret false
end
if lt get spk_ksz 6 SPK_FMC_SIG_SZ
spk_fail 3 SPK_E_BUNDLE
ret false
end
ret true
end

fn spk_stage3_net to bool
rtl_dma = dma_alloc_nc 32 4096
if eq rtl_dma 0
spk_fail 3 SPK_E_RTL
ret false
end
put spk_st 4 rtl_dma
snic = long get spk_st 15
if ne smmu_map_span snic rtl_dma 131072 0 SMMU_OK
spk_fail 3 SPK_E_RTL
ret false
end
if ne rtl_bare_setup get spk_rtl_bar 0 rtl_dma 0
spk_fail 3 SPK_E_RTL
ret false
end
if ne rtlinit rtl_dma 0
spk_fail 3 SPK_E_RTL
ret false
end
for mi ulong 6
put Tmac mi uchar and get rs add S_MAC0 mi 255
end
ret true
end

fn spk_stage3 to bool
uart_puts spk_s3
if not spk_stage3_disk
ret false
end
if not spk_stage3_bundle
ret false
end
if eq SPK_PLAT_QEMU 1
uart_puts spk_q_s3net
ret true
end
ret spk_stage3_net
end

note ========================================================================
note Stage 4: GB20B GSP Bring-Up + GMMU(VA==PA) + bsetpd + rmchan(0xca6f/0xcec0)
note ========================================================================

fn spk_stage4_sysinfo to bool
sireset
gbar = get spk_gb20b_bar 0
if ne siseti 0 gbar SIEOK
ret false
end
if ne siseti 2 add gbar 7340032 SIEOK
ret false
end
if ne siseti 4 SPK_GB20B_BDF SIEOK
ret false
end
siencode
ret true
end

fn spk_stage4_bootloop to bool
dspinit
dspperms DSPMALL
put sqcore 0 1
put sqbud 0 100000
it = ulong 0
while lt it 50000 bound 50000
st = get bstate 0
if eq st 9
ret true
end
if eq st 11
if ne dspauto 0
ret false
end
else
if eq st 5
rqclear 792
rqput32 4 0 580
rqput32 4 4 173
if ne bguest 0
ret false
end
else
if eq st 7
if ne bstatic 0
ret false
end
else
pr = bpoll
if lt pr 0
ret false
end
end
end
end
it = add it 1
end
ret eq get bstate 0 9
end

fn spk_stage4_gsp to bool
frq = fwsys 3
if ne bminit 1 get spk_gb20b_bar 0 SPARK_GB20B_BAR0_SZ dma_pool_base dma_pool_size frq BMOK
spk_fail 4 SPK_E_BMHAL
ret false
end
put gspmode 0 2
put gspd0ok 0 1
put gsppns 0 10000
if not spk_stage4_sysinfo
spk_fail 4 SPK_E_FWELF
ret false
end
note Parse verified bundle entry 1 (gsp.bin ELF64) and bind entries 2..6 (bl, fmc, hash, pubkey, sig)
if ne fbparseelf get spk_kpa 1 get spk_ksz 1 FBOK
spk_fail 4 SPK_E_FWELF
ret false
end
if ne fbbindblobs get spk_kpa 2 get spk_ksz 2 get spk_kpa 3 get spk_ksz 3 get spk_kpa 4 get spk_kpa 5 FBOK
spk_fail 4 SPK_E_FWELF
ret false
end
if ne fbbindsig get spk_kpa 6 get e4_bnd_meta 1 FBOK
spk_fail 4 SPK_E_FWELF
ret false
end
note Allocate 80 MiB GSP arena + 133 MiB WPR2 heap inside Normal-NC pool & map on GB20B SMMU stream
arena_pa = dma_alloc_nc 20480 65536
heap_pa = dma_alloc_nc 34048 65536
if or eq arena_pa 0 eq heap_pa 0
spk_fail 4 SPK_E_ARENA
ret false
end
put spk_st 8 arena_pa
put spk_st 9 heap_pa
sgpu = long get spk_st 1
if or ne smmu_map_span sgpu arena_pa SPK_ARENA_CAP 0 SMMU_OK ne smmu_map_span sgpu heap_pa 139460608 0 SMMU_OK
spk_fail 4 SPK_E_ARENA
ret false
end
if ne abbuild arena_pa SPK_ARENA_CAP heap_pa 139460608 ABOK
spk_fail 4 SPK_E_ARENA
ret false
end
note Phase 3 #77 reminder: configure seqcore CORE_RESUME libosArgsPA + appVersion after abbuild!
sccfg abpa 1 get fbappver 0
for ci ulong 1024
put gpkt ci get abcot ci
end
put gin 0 get abclen 0
put gin 1 abpa 15
put gin 2 get fbappver 0
for bi ulong 4
put gin add bi 3 100000
end
for si ulong 7
put s2cfg si 100000
end
if ne s2boot uint GB20B_VAL_BOOT42 EOK
spk_fail 4 SPK_E_SEC2
ret false
end
note abbuild already pre-queued RPC 72 (siout) into rqcmd & abcmdpa via abpre;
note arm boot state machine at bstate==4, attach cmdq/statq via abcmdpa/abstatpa, and poll to bstate==9.
put bstate 0 4
put bbudget 0 100000
put bstaticn 0 64
put bgen 0 1
if ne tbattach get abcmdpa 0 get abstatpa 0 uint GB20B_VAL_BOOT42 0
spk_fail 4 SPK_E_GSPBOOT
ret false
end
if not spk_stage4_bootloop
spk_fail 4 SPK_E_GSPBOOT
ret false
end
ret true
end

fn spk_idmap_2m pa ulong sz ulong to bool
if eq pa 0
ret false
end
ret eq mmmap pa pa sz MMSZ2M MMAPSYS 0 MMOK
end

note GB20B DMA is Stage-1 confined by its SMMUv3 stream (spk_st 1): every sysmem range the GPU walks,
note fetches or writes (GMMU page tables, semaphore/marker buffer, PB, Normal-NC, WB, SASS code) must be
note mapped there as a disjoint span, or the first GMMU walk / PB fetch faults. Fail closed on any error.
fn spk_gpu_span pa ulong sz ulong to bool
if eq pa 0
ret false
end
sg = long get spk_st 1
ret eq smmu_map_span sg pa sz 0 SMMU_OK
end

fn spk_gpu_span_wb pa ulong sz ulong to bool
if eq pa 0
ret false
end
sg = long get spk_st 1
ret eq smmu_map_span_wb sg pa sz SMMU_OK
end

fn spk_stage4_gmmu_init to bool
gmmu_pool = dma_alloc_nc 512 4096
gmbuf_pa = dma_alloc_nc 64 2097152
if or eq gmmu_pool 0 eq gmbuf_pa 0
ret false
end
if not spk_gpu_span gmmu_pool 2097152
ret false
end
if not spk_gpu_span gmbuf_pa 262144
ret false
end
if ne mmwinit dma_pool_base dma_pool_size MMOK
ret false
end
if ne mmasinit gmmu_pool 512 MMOK
ret false
end
pb_pa = dma_alloc_nc 512 2097152
nc_base = dma_alloc_nc 2048 2097152
wb_base = frames_alloc 512 2097152 FR_PA_40BIT_LIMIT
code_pa = dma_alloc_nc 512 2097152
put spk_st 10 pb_pa
put spk_st 12 nc_base
put spk_st 13 wb_base
put spk_st 16 code_pa
if not spk_gpu_span pb_pa 2097152
ret false
end
if not spk_gpu_span nc_base 8388608
ret false
end
note wb_base comes from frames_alloc (CPU Normal-WB, ISH): map it Normal-WB on the SMMU too, and only on an
note IO-coherent (IORT CCA=1) path (smmu_map_span_wb refuses otherwise) -- never an NC alias of WB memory.
if not spk_gpu_span_wb wb_base 2097152
ret false
end
if not spk_gpu_span code_pa 2097152
ret false
end
note Identity-map PB, Normal-NC, WB, and SASS code spans into GMMU at VA == PA (2 MiB pages)
if not spk_idmap_2m pb_pa 2097152
ret false
end
if not spk_idmap_2m nc_base 8388608
ret false
end
if not spk_idmap_2m wb_base 2097152
ret false
end
if not spk_idmap_2m code_pa 2097152
ret false
end
note 2 MiB-aligned gmbuf_pa -> gminit VA == PA so mk_va == mk_pa!
ret eq gminit 8 gmbuf_pa 64 gmbuf_pa GMOK
end

fn spk_stage4_chan to bool
if not spk_stage4_gmmu_init
spk_fail 4 SPK_E_GMMU
ret false
end
chinit
if ne chprep 0 42 3 64 CHOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
if ne cminit CMOK
spk_fail 4 SPK_E_CMBIND
ret false
end
if ne gmalloc 4096 1 GMHPOLL GMOK
spk_fail 4 SPK_E_CMBIND
ret false
end
semslot = get gmout 0
mk_pa = get gmbpa semslot
put spk_st 11 mk_pa
gen = get mmwgen 0
put spk_st 14 gen
put iqstate 0 0
put iqgen 0 0
put iqhalt 0 0
put iqmode 0 2
if ne iqinit gen 0
spk_fail 4 SPK_E_CMBIND
ret false
end
note Bind completion semaphore to marker_va + 16 (VA == PA, matching Piece 5 C3 marker2 tail)
if ne cmbind 0 semslot 16 gen CMOK
spk_fail 4 SPK_E_CMBIND
ret false
end
if ne rminit RMOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
rmcfg 1001 1002 1003 1004 1005 1006
rmcfgch 1007 42 1 99
rmcfg20 true 1008
if ne rmbind 0 gen RMOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
if ne rmstart 100000 RMOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
s1 = ulong 0
while and ne get rmst 0 RMSREADY lt s1 64 bound 64
if lt rmstep 0
spk_fail 4 SPK_E_RMCHAN
ret false
end
s1 = add s1 1
end
if ne get rmst 0 RMSREADY
spk_fail 4 SPK_E_RMCHAN
ret false
end
note RPC 54 SET_PAGE_DIRECTORY: bind GMMU root PDB to VAS 1004 before scheduling channel
for pi ulong 11
put pain pi 0
end
put pain 0 1001
put pain 1 1002
put pain 3 get mmroot 0
put pain 4 512
put pain 5 2
put pain 7 1004
if ne pasetpd 48
spk_fail 4 SPK_E_GMMU
ret false
end
if ne bsetpd 100000 0
spk_fail 4 SPK_E_GMMU
ret false
end
sp = ulong 0
while and ne get bstate 0 9 lt sp 50000 bound 50000
if lt bpoll 0
spk_fail 4 SPK_E_GMMU
ret false
end
sp = add sp 1
end
if ne get bstate 0 9
spk_fail 4 SPK_E_GMMU
ret false
end
if ne rmsched 100000 RMOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
s2 = ulong 0
while and ne get rmst 0 RMSACTV lt s2 32 bound 32
if lt rmstep 0
spk_fail 4 SPK_E_RMCHAN
ret false
end
s2 = add s2 1
end
if ne get rmst 0 RMSACTV
spk_fail 4 SPK_E_RMCHAN
ret false
end
if ne rmpub gen RMOK
spk_fail 4 SPK_E_RMCHAN
ret false
end
if ne mminval 10000 MMOK
spk_fail 4 SPK_E_GMMU
ret false
end
ret true
end

fn spk_stage4 to bool
uart_puts spk_s4
if not spk_stage4_gsp
ret false
end
ret spk_stage4_chan
end

note ========================================================================
note Stage 5: Compute + sm_121 Pure-.om SASS Codegen + q38_run.om
note ========================================================================

fn spk_emit_one_sass qk ulong dkind ulong a ulong b ulong c ulong to bool
ir = new ulong 8192 0
meta = new ulong 512 0
scratch = new ulong 2048 0
phys = new ulong 288 0
stats = new ulong 4 0
if ne cg_dec dkind a b c ir meta 0
ret false
end
nins = get meta 0
if eq nins 0
ret false
end
if ne bc_regalloc ir nins scratch phys stats 246 0
ret false
end
ret spk_enc_and_bind qk ir phys nins uint get stats 0
end

fn spk_enc_and_bind qk ulong ir view ulong 8192 phys view ulong 288 nins ulong pg uint to bool
code = new uchar 16384 0
nb = bw_enc_sm121 ir phys nins 0 code
if or eq nb 0 gt nb 16384
ret false
end
dst = add get spk_st 16 mul qk 16384
i = ulong 0
while lt i nb bound 16384
x = fwst add dst i 1 ulong get code i
i = add i 1
end
arm64_dc_civac_range dst nb
put spk_st 19 add get spk_st 19 nb
if eq pg 0
pg = uint 32
end
ret eq q3_set_code qk dst pg 0 Q3OK
end

fn spk_stage5 to bool
uart_puts spk_s5
cbpbinit
if ne cbpbsetup18 uint CBCCMP CBOK
spk_fail 5 SPK_E_COMPUTE
ret false
end
if ne q3_init get spk_st 12 get spk_st 13 get spk_st 10 get spk_st 11 SPK_MAX_CTX Q3OK
spk_fail 5 SPK_E_Q3INIT
ret false
end
note Emit, regalloc, encode, flush, and bind the 7 pure-.om sm_121 glue kernels
if not spk_emit_one_sass Q3KNORM 0 1 5120 0
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KADDNORM 0 3 5120 0
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KSWIGLU 1 0 17408 0
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KGATHER 2 0 14336 14336
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KGATE 3 0 0 0
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KAM0 4 0 0 0
spk_fail 5 SPK_E_SASS
ret false
end
if not spk_emit_one_sass Q3KAM1 4 1 0 0
spk_fail 5 SPK_E_SASS
ret false
end
note Fail closed cleanly if full 14-kernel + 64-layer Qwen3.8-27B weight set is not yet bound
for k ulong Q3KCOUNT
if eq get q3kset k 0
spk_fail 5 SPK_E_WEIGHTS
ret false
end
end
for l ulong Q3LAYERS
if eq get q3lset l 0
spk_fail 5 SPK_E_WEIGHTS
ret false
end
end
ret true
end

note ========================================================================
note Stage 6: OMTK v1 Wire Loop on TCP Port 18100
note ========================================================================

fn spk_stage6 to void
uart_puts spk_s6
wl_init SPK_OMTK_PORT SPK_MAX_CTX SPK_VOCAB
put Tcf 1 SPK_STATIC_IP
put Tcf 2 SPK_GATEWAY
put Tcf 3 SPK_NETMASK
put Tcf 5 SPK_ISN
wl_run
end

note ========================================================================
note EL1h Entry (from Piece 1 mmu_enter_el1) and UEFI Entry (main)
note ========================================================================

fn el1main el1_arg ulong to void
if not spk_stage1
ret
end
if not spk_stage2
ret
end
if not spk_stage3
ret
end
if eq SPK_PLAT_QEMU 1
note QEMU has no GB20B: stop after the last stage QEMU can model and exit via PSCI SYSTEM_RESET.
uart_puts spk_q_stop
arm64_psci_reset get acpi_info 7
ret
end
if not spk_stage4
ret
end
if not spk_stage5
ret
end
spk_stage6
end

fn main to int
if not efi_exit_boot_services
ret 1
end
arm64_daif_mask
arm64_post_ebs_set UART_SPARK_16550_PA PSCI_CONDUIT_NONE
outp = fwadr efi_mm_out 0 64
rsdp = fwld add outp 40 8
ok_acpi = acpi_parse_rsdp rsdp
conduit = get acpi_info 7
if ne get acpi_info 8 0
uart_init get acpi_info 8 get acpi_info 9 conduit
else
uart_init UART_SPARK_16550_PA UART_KIND_16550_32 conduit
end
arm64_post_ebs_set uart_base conduit
frames_init
mp = fwadr efi_mmap 0 EFI_MMAP_CAP
cnt = frames_ingest_efi_raw mp fwld outp 8 fwld add outp 16 8
if eq cnt 0
trap 8
end
ib = arm64_meta 0
bss = arm64_meta 1
ie = arm64_meta 2
frames_reserve ib ie
reserve_gb10_rmrs
if ne rsdp 0
frames_reserve rsdp add rsdp 4096
end
if not mmu_build_initial ib bss ie
trap 8
end
e1 = arm64_meta 4
if eq e1 0
trap 8
end
mmu_enter_el1 e1 rsdp
ret 0
end

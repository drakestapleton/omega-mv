note SPDX-License-Identifier: Apache-2.0
note aienux/spark/spec_audit.om: Pure seeded OM-2 Spec-Audit Gate for SPARK.EFI.
note Verifies:
note   1. 100% bijective coverage between all reachable spk_fail_d(stage, code, subc, aux) sites
note      in aienux/spark/{spark_main,plat_gb10,plat_qemu,test_spark_e2e}.om and aienux/spark/specs/spark_error_codes.tsv.
note   2. Zero duplicate (code, subc) pairs in code or TSV; zero duplicate SPK_E_* values.
note   3. Zero uncoded raw spk_fail calls or definitions.
note   4. Zero OM-2 Trap 4 MMIO polling loops ("while true bound ...").
note   5. Zero OM-2 Trap 5 negative-signed-to-ulong casts in spk_fail_d / spk_fail_d call sites.
note   6. >= 7 self-test negative controls (all mutated inputs REFUSED by the real verifier).
note
note Build (Linux AArch64):
note   { printf 'om2\n'; cat aienux/spark/spec_audit.om; } | seed/out/omc > spec_audit
note Usage:
note   spec_audit                      (audit canonical repo files + run 7 self-test negative controls)
note   spec_audit TSV_PATH OM_PATH...  (audit explicit TSV + one or more .om files on disk)

const SA_TSV_CAP ulong 131072
const SA_SRC_CAP ulong 262144
const SA_MAX_CONST ulong 64
const SA_MAX_SITES ulong 256
const SA_MAX_ROWS ulong 256

const SA_OK ulong 0
const SA_ERR_IO ulong 2
const SA_ERR_TSV_SYNTAX ulong 10
const SA_ERR_DUP_SITE ulong 11
const SA_ERR_UNREGISTERED_SITE ulong 12
const SA_ERR_TRAP4_LOOP ulong 13
const SA_ERR_RAW_SPK_FAIL ulong 14
const SA_ERR_ORPHAN_TSV ulong 15
const SA_ERR_TRAP5_CAST ulong 16
const SA_ERR_DUP_TSV ulong 17
const SA_ERR_BAD_CONST ulong 18
const SA_ERR_MISMATCH ulong 19
const SA_ERR_EMPTY ulong 20
const SA_ERR_MISSING_DEF ulong 21
const SA_ERR_NEG_CTRL ulong 30

global sa_tsv_buf uchar 131072
global sa_tsv_len ulong 1
global sa_src_buf uchar 262144
global sa_src_len ulong 1
global sa_mut_tsv uchar 131072
global sa_mut_tsv_len ulong 1
global sa_mut_src uchar 262144
global sa_mut_src_len ulong 1
global sa_path uchar 4096
global sa_path_len ulong 1

global sa_c_cnt ulong 1
global sa_c_name uchar 2048
global sa_c_nlen ulong 64
global sa_c_val ulong 64

global sa_s_cnt ulong 1
global sa_s_stage ulong 256
global sa_s_code ulong 256
global sa_s_subc ulong 256
global sa_s_cname uchar 8192
global sa_s_clen ulong 256
global sa_s_file uchar 16384
global sa_s_flen ulong 256
global sa_s_fn uchar 8192
global sa_s_fnlen ulong 256
global sa_s_line ulong 256

global sa_r_cnt ulong 1
global sa_r_stage ulong 256
global sa_r_code ulong 256
global sa_r_subc ulong 256
global sa_r_matched ulong 256
global sa_r_cname uchar 8192
global sa_r_clen ulong 256
global sa_r_file uchar 16384
global sa_r_flen ulong 256
global sa_r_fn uchar 8192
global sa_r_fnlen ulong 256

global sa_cur_file uchar 64
global sa_cur_flen ulong 1
global sa_cur_fn uchar 32
global sa_cur_fnlen ulong 1
global sa_state ulong 16
note sa_state: 0=seen_faild, 1=seen_erru, 2=seen_erri, 3=in_fail_fn, 4=err_line, 6=require_defs
global sa_neg_cnt ulong 1
global sa_col_s ulong 8
global sa_col_e ulong 8
global sa_numbuf uchar 32

text sa_p_tsv "aienux/spark/specs/spark_error_codes.tsv"
text sa_p_main "aienux/spark/spark_main.om"
text sa_p_pgb10 "aienux/spark/plat_gb10.om"
text sa_p_pqemu "aienux/spark/plat_qemu.om"
text sa_p_e2e "aienux/spark/test_spark_e2e.om"

text sa_hdr_tsv "stage\tconst_name\tcode\tsubc\tsource_file\tcaller_fn\tspec_ref\tdescription"
text sa_kw_note "note"
text sa_kw_text "text"
text sa_kw_fn "fn"
text sa_kw_const "const"
text sa_kw_while "while"
text sa_kw_true "true"
text sa_kw_ulong "ulong"
text sa_kw_spk_fail "spk_fail"
text sa_kw_spk_fail_d "spk_fail_d"
text sa_kw_spk_err_u "spk_err_u"
text sa_kw_spk_err_i "spk_err_i"
text sa_kw_spkepfx "SPK_E_"
text sa_kw_rc "rc"
text sa_kw_rci "rci"
text sa_kw_hb "hb"
text sa_kw_stage "stage"
text sa_kw_code "code"
text sa_kw_subc "subc"
text sa_kw_aux "aux"
text sa_kw_v "v"

text sa_m_dup_pat "spk_fail_d 1 SPK_E_ITS 2"
text sa_m_trap4_old "while lt i 512 bound 512"
text sa_m_trap4_new "while true bound 1000000"
text sa_m_raw_old "spk_fail_d 1 SPK_E_GIC 1"
text sa_m_raw_new "spk_fail 1 SPK_E_GIC    "
text sa_m_orp_row "5\tSPK_E_WEIGHTS\t504\t99\taienux/spark/spark_main.om\tspk_stage5\tSpec\tOrphan\n"
text sa_m_duprow "1\tSPK_E_GIC\t101\t1\taienux/spark/spark_main.om\tspk_stage1\tSpec\tDup\n"
text sa_m_t5_old "spk_err_u rc"
text sa_m_t5_new "ulong rc    "

text sa_msg_pass1 "SPEC_AUDIT PASS sites="
text sa_msg_pass2 " tsv_rows="
text sa_msg_pass3 " unique_pairs="
text sa_msg_pass4 " raw_spk_fail=0 trap4_polls=0 trap5_casts=0 neg_controls="
text sa_msg_pass5 "/7\n"
text sa_msg_cli "SPEC_AUDIT_FILES PASS sites="
text sa_msg_fail1 "SPEC_AUDIT FAIL code="
text sa_msg_fail2 " line="
text sa_msg_nl "\n"

fn sa_wtx fd int s view uchar * to void
  n = len s
  p = ulong 0
  while lt p n bound 4096
    k = write fd s p sub n p
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn sa_wnum fd int v ulong to void
  if eq v 0
    put sa_numbuf 0 uchar 48
    k = write fd sa_numbuf 0 1
    ret
  end
  x = v
  i = ulong 32
  for j ulong 21
    i = sub i 1
    put sa_numbuf i uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  k = write fd sa_numbuf i sub 32 i
end

fn sa_fail_msg code ulong lno ulong to int
  sa_wtx 2 sa_msg_fail1
  sa_wnum 2 code
  sa_wtx 2 sa_msg_fail2
  sa_wnum 2 lno
  sa_wtx 2 sa_msg_nl
  ret int code
end

fn sa_set_path s view uchar * to void
  n = len s
  if gt n 4095
    n = ulong 4095
  end
  for i ulong n bound 4096
    put sa_path i get s i
  end
  put sa_path_len 0 n
end

fn sa_read_path_to_tsv to bool
  n = get sa_path_len 0
  if eq n 0
    ret false
  end
  fd = fopen sa_path 0 n 0 0
  if lt fd 0
    ret false
  end
  ifd = int fd
  tot = ulong 0
  done = false
  while not done bound 1024
    if ge tot sub SA_TSV_CAP 256
      z = fclose ifd
      ret false
    end
    r = read ifd sa_tsv_buf tot sub sub SA_TSV_CAP 256 tot
    if lt r 0
      z = fclose ifd
      ret false
    end
    if eq r 0
      done = true
    else
      tot = add tot ulong r
    end
  end
  z = fclose ifd
  put sa_tsv_len 0 tot
  ret true
end

fn sa_read_path_to_src to bool
  n = get sa_path_len 0
  if eq n 0
    ret false
  end
  fd = fopen sa_path 0 n 0 0
  if lt fd 0
    ret false
  end
  ifd = int fd
  tot = ulong 0
  done = false
  while not done bound 1024
    if ge tot sub SA_SRC_CAP 256
      z = fclose ifd
      ret false
    end
    r = read ifd sa_src_buf tot sub sub SA_SRC_CAP 256 tot
    if lt r 0
      z = fclose ifd
      ret false
    end
    if eq r 0
      done = true
    else
      tot = add tot ulong r
    end
  end
  z = fclose ifd
  put sa_src_len 0 tot
  ret true
end

fn sa_set_cur_file s view uchar * n ulong to void
  m = n
  if gt m 63
    m = ulong 63
  end
  for i ulong m bound 64
    put sa_cur_file i get s i
  end
  put sa_cur_flen 0 m
end

fn sa_set_cur_file_pa to void
  n = get sa_path_len 0
  m = n
  if gt m 63
    m = ulong 63
  end
  for i ulong m bound 64
    put sa_cur_file i get sa_path i
  end
  put sa_cur_flen 0 m
end

fn sa_reset_scan to void
  put sa_c_cnt 0 0
  put sa_s_cnt 0 0
  put sa_r_cnt 0 0
  put sa_cur_flen 0 0
  put sa_cur_fnlen 0 0
  for i ulong 8
    put sa_state i 0
  end
end

fn sa_src_eq s ulong e ulong w view uchar * to bool
  if ne sub e s len w
    ret false
  end
  for i ulong len w bound 128
    if ne get sa_src_buf add s i get w i
      ret false
    end
  end
  ret true
end

fn sa_src_pfx s ulong e ulong w view uchar * to bool
  if lt sub e s len w
    ret false
  end
  for i ulong len w bound 64
    if ne get sa_src_buf add s i get w i
      ret false
    end
  end
  ret true
end

fn sa_tsv_eq s ulong e ulong w view uchar * to bool
  if ne sub e s len w
    ret false
  end
  for i ulong len w bound 128
    if ne get sa_tsv_buf add s i get w i
      ret false
    end
  end
  ret true
end

fn sa_tsv_pfx s ulong e ulong w view uchar * to bool
  if lt sub e s len w
    ret false
  end
  for i ulong len w bound 64
    if ne get sa_tsv_buf add s i get w i
      ret false
    end
  end
  ret true
end

fn sa_parse_u64_src s ulong e ulong to long
  if eq s e
    ret -1
  end
  if gt sub e s 19
    ret -1
  end
  v = ulong 0
  for i ulong sub e s bound 20
    c = get sa_src_buf add s i
    if or lt c 48 gt c 57
      ret -1
    end
    v = add mul v 10 ulong sub c 48
  end
  if gt v 9223372036854775807
    ret -1
  end
  ret long v
end

fn sa_parse_u64_tsv s ulong e ulong to long
  if eq s e
    ret -1
  end
  if gt sub e s 19
    ret -1
  end
  v = ulong 0
  for i ulong sub e s bound 20
    c = get sa_tsv_buf add s i
    if or lt c 48 gt c 57
      ret -1
    end
    v = add mul v 10 ulong sub c 48
  end
  if gt v 9223372036854775807
    ret -1
  end
  ret long v
end

fn sa_skip_ws_src p ulong lend ulong to ulong
  q = p
  while lt q lend bound 262144
    c = get sa_src_buf q
    if and ne c 32 ne c 9
      ret q
    end
    q = add q 1
  end
  ret q
end

fn sa_tok_end_src p ulong lend ulong to ulong
  q = p
  while lt q lend bound 262144
    c = get sa_src_buf q
    if or eq c 32 eq c 9
      ret q
    end
    q = add q 1
  end
  ret q
end

fn sa_find_nl_src p ulong lim ulong to ulong
  q = p
  while lt q lim bound 262144
    if eq get sa_src_buf q 10
      ret q
    end
    q = add q 1
  end
  ret lim
end

fn sa_find_nl_tsv p ulong lim ulong to ulong
  q = p
  while lt q lim bound 131072
    if eq get sa_tsv_buf q 10
      ret q
    end
    q = add q 1
  end
  ret lim
end

fn sa_c_match idx ulong s ulong e ulong to bool
  n = get sa_c_nlen idx
  if ne n sub e s
    ret false
  end
  b = mul idx 32
  for i ulong n bound 32
    if ne get sa_c_name add b i get sa_src_buf add s i
      ret false
    end
  end
  ret true
end

fn sa_lookup_const s ulong e ulong to long
  cnt = get sa_c_cnt 0
  for i ulong cnt bound 64
    if sa_c_match i s e
      ret long get sa_c_val i
    end
  end
  ret -1
end

fn sa_add_const s ulong e ulong val ulong to ulong
  cnt = get sa_c_cnt 0
  n = sub e s
  if or eq n 0 gt n 31
    ret SA_ERR_BAD_CONST
  end
  if ge cnt SA_MAX_CONST
    ret SA_ERR_BAD_CONST
  end
  for i ulong cnt bound 64
    if sa_c_match i s e
      ret SA_ERR_BAD_CONST
    end
    if eq get sa_c_val i val
      ret SA_ERR_BAD_CONST
    end
  end
  b = mul cnt 32
  for j ulong n bound 32
    put sa_c_name add b j get sa_src_buf add s j
  end
  put sa_c_nlen cnt n
  put sa_c_val cnt val
  put sa_c_cnt 0 add cnt 1
  ret SA_OK
end

fn sa_handle_const q0 ulong lend ulong lno ulong to ulong
  p1 = sa_skip_ws_src q0 lend
  q1 = sa_tok_end_src p1 lend
  if not sa_src_pfx p1 q1 sa_kw_spkepfx
    ret SA_OK
  end
  p2 = sa_skip_ws_src q1 lend
  q2 = sa_tok_end_src p2 lend
  if not sa_src_eq p2 q2 sa_kw_ulong
    put sa_state 4 lno
    ret SA_ERR_BAD_CONST
  end
  p3 = sa_skip_ws_src q2 lend
  q3 = sa_tok_end_src p3 lend
  pv = sa_parse_u64_src p3 q3
  if lt pv 0
    put sa_state 4 lno
    ret SA_ERR_BAD_CONST
  end
  rc = sa_add_const p1 q1 ulong pv
  if ne rc SA_OK
    put sa_state 4 lno
  end
  ret rc
end

fn sa_is_trap5_var s ulong e ulong to bool
  if sa_src_eq s e sa_kw_rc
    ret true
  end
  if sa_src_eq s e sa_kw_rci
    ret true
  end
  if sa_src_eq s e sa_kw_hb
    ret true
  end
  if sa_src_eq s e sa_kw_v
    ret true
  end
  if sa_src_eq s e sa_kw_stage
    ret true
  end
  if sa_src_eq s e sa_kw_code
    ret true
  end
  if sa_src_eq s e sa_kw_subc
    ret true
  end
  ret sa_src_eq s e sa_kw_aux
end

fn sa_scan_line_tokens p0 ulong lend ulong lno ulong to ulong
  p = p0
  prev_ul = false
  while lt p lend bound 262144
    q = sa_tok_end_src p lend
    if sa_src_eq p q sa_kw_spk_fail
      put sa_state 4 lno
      ret SA_ERR_RAW_SPK_FAIL
    end
    if prev_ul
      if sa_is_trap5_var p q
        put sa_state 4 lno
        ret SA_ERR_TRAP5_CAST
      end
    end
    prev_ul = sa_src_eq p q sa_kw_ulong
    p = sa_skip_ws_src q lend
  end
  ret SA_OK
end

fn sa_copy_site_strs cnt ulong cs ulong cl ulong to void
  cb = mul cnt 32
  for a ulong cl bound 32
    put sa_s_cname add cb a get sa_src_buf add cs a
  end
  put sa_s_clen cnt cl
  fl = get sa_cur_flen 0
  fb = mul cnt 64
  for b ulong fl bound 64
    put sa_s_file add fb b get sa_cur_file b
  end
  put sa_s_flen cnt fl
  fnl = get sa_cur_fnlen 0
  for c ulong fnl bound 32
    put sa_s_fn add cb c get sa_cur_fn c
  end
  put sa_s_fnlen cnt fnl
end

fn sa_store_site st ulong cs ulong ce ulong cd ulong sb ulong lno ulong to ulong
  cnt = get sa_s_cnt 0
  if ge cnt SA_MAX_SITES
    ret SA_ERR_BAD_CONST
  end
  for i ulong cnt bound 256
    if and eq get sa_s_code i cd eq get sa_s_subc i sb
      put sa_state 4 lno
      ret SA_ERR_DUP_SITE
    end
  end
  cl = sub ce cs
  if or eq cl 0 gt cl 31
    ret SA_ERR_BAD_CONST
  end
  if or eq get sa_cur_flen 0 0 eq get sa_cur_fnlen 0 0
    ret SA_ERR_TSV_SYNTAX
  end
  put sa_s_stage cnt st
  put sa_s_code cnt cd
  put sa_s_subc cnt sb
  put sa_s_line cnt lno
  sa_copy_site_strs cnt cs cl
  put sa_s_cnt 0 add cnt 1
  ret SA_OK
end

fn sa_handle_site q0 ulong lend ulong lno ulong to ulong
  p1 = sa_skip_ws_src q0 lend
  q1 = sa_tok_end_src p1 lend
  st = sa_parse_u64_src p1 q1
  if or lt st 1 gt st 6
    put sa_state 4 lno
    ret SA_ERR_BAD_CONST
  end
  p1 = sa_skip_ws_src q1 lend
  q1 = sa_tok_end_src p1 lend
  if not sa_src_pfx p1 q1 sa_kw_spkepfx
    put sa_state 4 lno
    ret SA_ERR_BAD_CONST
  end
  cd = sa_lookup_const p1 q1
  if lt cd 0
    put sa_state 4 lno
    ret SA_ERR_BAD_CONST
  end
  p3 = sa_skip_ws_src q1 lend
  q3 = sa_tok_end_src p3 lend
  sb = sa_parse_u64_src p3 q3
  if lt sb 1
    put sa_state 4 lno
    ret SA_ERR_RAW_SPK_FAIL
  end
  if ge sa_skip_ws_src q3 lend lend
    put sa_state 4 lno
    ret SA_ERR_RAW_SPK_FAIL
  end
  ret sa_store_site ulong st p1 q1 ulong cd ulong sb lno
end

fn sa_handle_fn q0 ulong lend ulong lno ulong to ulong
  p1 = sa_skip_ws_src q0 lend
  q1 = sa_tok_end_src p1 lend
  if eq p1 q1
    ret SA_OK
  end
  if sa_src_eq p1 q1 sa_kw_spk_fail
    put sa_state 4 lno
    ret SA_ERR_RAW_SPK_FAIL
  end
  put sa_state 3 0
  if sa_src_eq p1 q1 sa_kw_spk_fail_d
    put sa_state 0 1
    put sa_state 3 1
  end
  if sa_src_eq p1 q1 sa_kw_spk_err_u
    put sa_state 1 1
  end
  if sa_src_eq p1 q1 sa_kw_spk_err_i
    put sa_state 2 1
  end
  fnl = sub q1 p1
  if gt fnl 31
    fnl = ulong 31
  end
  for i ulong fnl bound 32
    put sa_cur_fn i get sa_src_buf add p1 i
  end
  put sa_cur_fnlen 0 fnl
  ret SA_OK
end

fn sa_scan_src_line ls ulong lend ulong lno ulong to ulong
  p0 = sa_skip_ws_src ls lend
  if ge p0 lend
    ret SA_OK
  end
  q0 = sa_tok_end_src p0 lend
  if sa_src_eq p0 q0 sa_kw_note
    ret SA_OK
  end
  if sa_src_eq p0 q0 sa_kw_text
    ret SA_OK
  end
  if sa_src_eq p0 q0 sa_kw_fn
    ret sa_handle_fn q0 lend lno
  end
  if sa_src_eq p0 q0 sa_kw_while
    p1 = sa_skip_ws_src q0 lend
    q1 = sa_tok_end_src p1 lend
    if sa_src_eq p1 q1 sa_kw_true
      put sa_state 4 lno
      ret SA_ERR_TRAP4_LOOP
    end
  end
  if sa_src_eq p0 q0 sa_kw_const
    ret sa_handle_const q0 lend lno
  end
  is_faild = sa_src_eq p0 q0 sa_kw_spk_fail_d
  if or eq get sa_state 3 1 is_faild
    rc = sa_scan_line_tokens p0 lend lno
    if ne rc SA_OK
      ret rc
    end
  else
    p = p0
    while lt p lend bound 262144
      q = sa_tok_end_src p lend
      if sa_src_eq p q sa_kw_spk_fail
        put sa_state 4 lno
        ret SA_ERR_RAW_SPK_FAIL
      end
      p = sa_skip_ws_src q lend
    end
  end
  if is_faild
    ret sa_handle_site q0 lend lno
  end
  ret SA_OK
end

fn sa_scan_src_buf to ulong
  pos = ulong 0
  lim = get sa_src_len 0
  lno = ulong 1
  put sa_cur_fnlen 0 0
  put sa_state 3 0
  while lt pos lim bound 262144
    el = sa_find_nl_src pos lim
    ep = el
    if gt ep pos
      if eq get sa_src_buf sub ep 1 13
        ep = sub ep 1
      end
    end
    err = sa_scan_src_line pos ep lno
    if ne err SA_OK
      ret err
    end
    pos = add el 1
    lno = add lno 1
  end
  ret SA_OK
end

fn sa_split_tsv_row ls ulong lend ulong to bool
  c = ulong 0
  st = ls
  p = ls
  while lt p lend bound 131072
    if eq get sa_tsv_buf p 9
      if ge c 7
        ret false
      end
      if eq p st
        ret false
      end
      put sa_col_s c st
      put sa_col_e c p
      c = add c 1
      st = add p 1
    end
    p = add p 1
  end
  if ne c 7
    ret false
  end
  if eq lend st
    ret false
  end
  put sa_col_s 7 st
  put sa_col_e 7 lend
  ret true
end

fn sa_copy_tsv_cname cnt ulong to void
  cs = get sa_col_s 1
  cl = sub get sa_col_e 1 cs
  cb = mul cnt 32
  for a ulong cl bound 32
    put sa_r_cname add cb a get sa_tsv_buf add cs a
  end
  put sa_r_clen cnt cl
end

fn sa_copy_tsv_file cnt ulong to void
  fs = get sa_col_s 4
  fl = sub get sa_col_e 4 fs
  fb = mul cnt 64
  for b ulong fl bound 64
    put sa_r_file add fb b get sa_tsv_buf add fs b
  end
  put sa_r_flen cnt fl
end

fn sa_copy_tsv_fn cnt ulong to void
  fns = get sa_col_s 5
  fnl = sub get sa_col_e 5 fns
  cb = mul cnt 32
  for c ulong fnl bound 32
    put sa_r_fn add cb c get sa_tsv_buf add fns c
  end
  put sa_r_fnlen cnt fnl
end

fn sa_copy_tsv_strs cnt ulong to void
  sa_copy_tsv_cname cnt
  sa_copy_tsv_file cnt
  sa_copy_tsv_fn cnt
end

fn sa_tsv_col_lens_ok to bool
  if gt sub get sa_col_e 1 get sa_col_s 1 31
    ret false
  end
  if gt sub get sa_col_e 4 get sa_col_s 4 63
    ret false
  end
  ret le sub get sa_col_e 5 get sa_col_s 5 31
end

fn sa_store_tsv_row lno ulong to ulong
  cnt = get sa_r_cnt 0
  if ge cnt SA_MAX_ROWS
    put sa_state 4 lno
    ret SA_ERR_TSV_SYNTAX
  end
  st = sa_parse_u64_tsv get sa_col_s 0 get sa_col_e 0
  cd = sa_parse_u64_tsv get sa_col_s 2 get sa_col_e 2
  sb = sa_parse_u64_tsv get sa_col_s 3 get sa_col_e 3
  if or or lt st 1 gt st 6 or lt cd 0 lt sb 1
    put sa_state 4 lno
    ret SA_ERR_TSV_SYNTAX
  end
  if not sa_tsv_pfx get sa_col_s 1 get sa_col_e 1 sa_kw_spkepfx
    put sa_state 4 lno
    ret SA_ERR_TSV_SYNTAX
  end
  if not sa_tsv_col_lens_ok
    put sa_state 4 lno
    ret SA_ERR_TSV_SYNTAX
  end
  for i ulong cnt bound 256
    if and eq get sa_r_code i ulong cd eq get sa_r_subc i ulong sb
      put sa_state 4 lno
      ret SA_ERR_DUP_TSV
    end
  end
  put sa_r_stage cnt ulong st
  put sa_r_code cnt ulong cd
  put sa_r_subc cnt ulong sb
  put sa_r_matched cnt 0
  sa_copy_tsv_strs cnt
  put sa_r_cnt 0 add cnt 1
  ret SA_OK
end

fn sa_parse_tsv_buf to ulong
  pos = ulong 0
  lim = get sa_tsv_len 0
  lno = ulong 1
  seen_hdr = false
  while lt pos lim bound 131072
    el = sa_find_nl_tsv pos lim
    ep = el
    if gt ep pos
      if eq get sa_tsv_buf sub ep 1 13
        ep = sub ep 1
      end
    end
    if gt ep pos
      if ne get sa_tsv_buf pos 35
        if not seen_hdr
          if not sa_tsv_eq pos ep sa_hdr_tsv
            put sa_state 4 lno
            ret SA_ERR_TSV_SYNTAX
          end
          seen_hdr = true
        else
          if not sa_split_tsv_row pos ep
            put sa_state 4 lno
            ret SA_ERR_TSV_SYNTAX
          end
          rc = sa_store_tsv_row lno
          if ne rc SA_OK
            ret rc
          end
        end
      end
    end
    pos = add el 1
    lno = add lno 1
  end
  if not seen_hdr
    ret SA_ERR_TSV_SYNTAX
  end
  ret SA_OK
end

fn sa_site_cname_eq si ulong ri ulong to bool
  cl = get sa_s_clen si
  if ne cl get sa_r_clen ri
    ret false
  end
  sb = mul si 32
  rb = mul ri 32
  for a ulong cl bound 32
    if ne get sa_s_cname add sb a get sa_r_cname add rb a
      ret false
    end
  end
  ret true
end

fn sa_site_file_eq si ulong ri ulong to bool
  fl = get sa_s_flen si
  if ne fl get sa_r_flen ri
    ret false
  end
  sfb = mul si 64
  rfb = mul ri 64
  for b ulong fl bound 64
    if ne get sa_s_file add sfb b get sa_r_file add rfb b
      ret false
    end
  end
  ret true
end

fn sa_site_fn_eq si ulong ri ulong to bool
  fnl = get sa_s_fnlen si
  if ne fnl get sa_r_fnlen ri
    ret false
  end
  sb = mul si 32
  rb = mul ri 32
  for c ulong fnl bound 32
    if ne get sa_s_fn add sb c get sa_r_fn add rb c
      ret false
    end
  end
  ret true
end

fn sa_site_row_eq si ulong ri ulong to bool
  if ne get sa_s_stage si get sa_r_stage ri
    ret false
  end
  if not sa_site_cname_eq si ri
    ret false
  end
  if not sa_site_file_eq si ri
    ret false
  end
  ret sa_site_fn_eq si ri
end

fn sa_verify_bijection to ulong
  sc = get sa_s_cnt 0
  rc = get sa_r_cnt 0
  if eq sc 0
    ret SA_ERR_EMPTY
  end
  if eq get sa_state 6 1
    if or eq get sa_state 0 0 or eq get sa_state 1 0 eq get sa_state 2 0
      ret SA_ERR_MISSING_DEF
    end
  end
  for i ulong sc bound 256
    cd = get sa_s_code i
    sb = get sa_s_subc i
    found = false
    for j ulong rc bound 256
      if and eq get sa_r_code j cd eq get sa_r_subc j sb
        found = true
        if ne get sa_r_matched j 0
          put sa_state 4 get sa_s_line i
          ret SA_ERR_DUP_TSV
        end
        if not sa_site_row_eq i j
          put sa_state 4 get sa_s_line i
          ret SA_ERR_MISMATCH
        end
        put sa_r_matched j 1
        break
      end
    end
    if not found
      put sa_state 4 get sa_s_line i
      ret SA_ERR_UNREGISTERED_SITE
    end
  end
  for k ulong rc bound 256
    if eq get sa_r_matched k 0
      ret SA_ERR_ORPHAN_TSV
    end
  end
  ret SA_OK
end

fn sa_audit_mem_main to ulong
  sa_reset_scan
  put sa_state 6 1
  sa_set_cur_file sa_p_main len sa_p_main
  err = sa_parse_tsv_buf
  if ne err SA_OK
    ret err
  end
  err2 = sa_scan_src_buf
  if ne err2 SA_OK
    ret err2
  end
  ret sa_verify_bijection
end

fn sa_backup_main_tsv to void
  tn = get sa_tsv_len 0
  for i ulong tn bound 131072
    put sa_mut_tsv i get sa_tsv_buf i
  end
  put sa_mut_tsv_len 0 tn
  sn = get sa_src_len 0
  for j ulong sn bound 262144
    put sa_mut_src j get sa_src_buf j
  end
  put sa_mut_src_len 0 sn
end

fn sa_restore_main_tsv to void
  tn = get sa_mut_tsv_len 0
  for i ulong tn bound 131072
    put sa_tsv_buf i get sa_mut_tsv i
  end
  put sa_tsv_len 0 tn
  sn = get sa_mut_src_len 0
  for j ulong sn bound 262144
    put sa_src_buf j get sa_mut_src j
  end
  put sa_src_len 0 sn
end

fn sa_pat_match_at off ulong pat view uchar * to bool
  pn = len pat
  for j ulong pn bound 64
    if ne get sa_src_buf add off j get pat j
      ret false
    end
  end
  ret true
end

fn sa_find_src_pat pat view uchar * occ ulong to long
  pn = len pat
  sn = get sa_src_len 0
  if lt sn pn
    ret -1
  end
  seen = ulong 0
  lim = add sub sn pn 1
  i = ulong 0
  while lt i lim bound 262144
    if sa_pat_match_at i pat
      if eq seen occ
        ret long i
      end
      seen = add seen 1
    end
    i = add i 1
  end
  ret -1
end

fn sa_replace_src_at off ulong pat view uchar * to void
  pn = len pat
  for j ulong pn bound 64
    put sa_src_buf add off j get pat j
  end
end

fn sa_append_tsv pat view uchar * to bool
  pn = len pat
  tn = get sa_tsv_len 0
  if ge add tn pn SA_TSV_CAP
    ret false
  end
  for j ulong pn bound 256
    put sa_tsv_buf add tn j get pat j
  end
  put sa_tsv_len 0 add tn pn
  ret true
end

fn sa_drop_last_tsv_row to bool
  tn = get sa_tsv_len 0
  if lt tn 2
    ret false
  end
  p = sub tn 1
  if eq get sa_tsv_buf p 10
    p = sub p 1
  end
  while gt p 0 bound 131072
    if eq get sa_tsv_buf p 10
      put sa_tsv_len 0 add p 1
      ret true
    end
    p = sub p 1
  end
  ret false
end

fn sa_run_mut_dup_site to bool
  sa_restore_main_tsv
  pos = sa_find_src_pat sa_m_dup_pat 0
  if lt pos 0
    ret false
  end
  put sa_src_buf add ulong pos 23 uchar 49
  ret eq sa_audit_mem_main SA_ERR_DUP_SITE
end

fn sa_run_mut_unreg_site to bool
  sa_restore_main_tsv
  if not sa_drop_last_tsv_row
    ret false
  end
  ret eq sa_audit_mem_main SA_ERR_UNREGISTERED_SITE
end

fn sa_run_mut_trap4 to bool
  sa_restore_main_tsv
  pos = sa_find_src_pat sa_m_trap4_old 0
  if lt pos 0
    ret false
  end
  sa_replace_src_at ulong pos sa_m_trap4_new
  ret eq sa_audit_mem_main SA_ERR_TRAP4_LOOP
end

fn sa_run_mut_raw_fail to bool
  sa_restore_main_tsv
  pos = sa_find_src_pat sa_m_raw_old 0
  if lt pos 0
    ret false
  end
  sa_replace_src_at ulong pos sa_m_raw_new
  ret eq sa_audit_mem_main SA_ERR_RAW_SPK_FAIL
end

fn sa_run_mut_orphan_tsv to bool
  sa_restore_main_tsv
  if not sa_append_tsv sa_m_orp_row
    ret false
  end
  ret eq sa_audit_mem_main SA_ERR_ORPHAN_TSV
end

fn sa_run_mut_trap5 to bool
  sa_restore_main_tsv
  pos = sa_find_src_pat sa_m_t5_old 0
  if lt pos 0
    ret false
  end
  sa_replace_src_at ulong pos sa_m_t5_new
  ret eq sa_audit_mem_main SA_ERR_TRAP5_CAST
end

fn sa_run_mut_dup_tsv to bool
  sa_restore_main_tsv
  if not sa_append_tsv sa_m_duprow
    ret false
  end
  ret eq sa_audit_mem_main SA_ERR_DUP_TSV
end

fn sa_run_neg_controls to bool
  put sa_neg_cnt 0 0
  if not sa_run_mut_dup_site
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_unreg_site
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_trap4
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_raw_fail
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_orphan_tsv
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_trap5
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  if not sa_run_mut_dup_tsv
    ret false
  end
  put sa_neg_cnt 0 add get sa_neg_cnt 0 1
  ret true
end

fn sa_err_u_ref v long to ulong
  if lt v 0
    ret or 0x8000000000000000 ulong add add v 9223372036854775807 1
  end
  ret ulong v
end

fn sa_test_trap5_helper to bool
  if ne sa_err_u_ref -1 0xffffffffffffffff
    ret false
  end
  if ne sa_err_u_ref -14 0xfffffffffffffff2
    ret false
  end
  if ne sa_err_u_ref -501 0xfffffffffffffe0b
    ret false
  end
  if ne sa_err_u_ref -9223372036854775808 0x8000000000000000
    ret false
  end
  if ne sa_err_u_ref 0 0
    ret false
  end
  ret eq sa_err_u_ref 42 42
end

fn sa_audit_file_literal path view uchar * to ulong
  sa_set_path path
  if not sa_read_path_to_src
    ret SA_ERR_IO
  end
  sa_set_cur_file path len path
  ret sa_scan_src_buf
end

fn sa_run_default to int
  if not sa_test_trap5_helper
    ret sa_fail_msg SA_ERR_TRAP5_CAST 0
  end
  sa_reset_scan
  put sa_state 6 1
  sa_set_path sa_p_tsv
  if not sa_read_path_to_tsv
    ret sa_fail_msg SA_ERR_IO 0
  end
  err = sa_parse_tsv_buf
  if ne err SA_OK
    ret sa_fail_msg err get sa_state 4
  end
  err2 = sa_audit_file_literal sa_p_main
  if ne err2 SA_OK
    ret sa_fail_msg err2 get sa_state 4
  end
  sa_backup_main_tsv
  err3 = sa_audit_file_literal sa_p_pgb10
  if ne err3 SA_OK
    ret sa_fail_msg err3 get sa_state 4
  end
  err4 = sa_audit_file_literal sa_p_pqemu
  if ne err4 SA_OK
    ret sa_fail_msg err4 get sa_state 4
  end
  err5 = sa_audit_file_literal sa_p_e2e
  if ne err5 SA_OK
    ret sa_fail_msg err5 get sa_state 4
  end
  err6 = sa_verify_bijection
  if ne err6 SA_OK
    ret sa_fail_msg err6 get sa_state 4
  end
  sites = get sa_s_cnt 0
  rows = get sa_r_cnt 0
  if not sa_run_neg_controls
    ret sa_fail_msg SA_ERR_NEG_CTRL get sa_neg_cnt 0
  end
  sa_wtx 1 sa_msg_pass1
  sa_wnum 1 sites
  sa_wtx 1 sa_msg_pass2
  sa_wnum 1 rows
  sa_wtx 1 sa_msg_pass3
  sa_wnum 1 sites
  sa_wtx 1 sa_msg_pass4
  sa_wnum 1 get sa_neg_cnt 0
  sa_wtx 1 sa_msg_pass5
  ret 0
end

fn sa_arg_to_path idx ulong to bool
  k = argread idx sa_path 0 4095
  if le k 0
    ret false
  end
  put sa_path_len 0 ulong k
  ret true
end

fn sa_run_cli ac ulong to int
  sa_reset_scan
  put sa_state 6 0
  if not sa_arg_to_path 1
    ret sa_fail_msg SA_ERR_IO 0
  end
  if not sa_read_path_to_tsv
    ret sa_fail_msg SA_ERR_IO 0
  end
  err = sa_parse_tsv_buf
  if ne err SA_OK
    ret sa_fail_msg err get sa_state 4
  end
  ai = ulong 2
  while lt ai ac bound 64
    if not sa_arg_to_path ai
      ret sa_fail_msg SA_ERR_IO ai
    end
    if not sa_read_path_to_src
      ret sa_fail_msg SA_ERR_IO ai
    end
    sa_set_cur_file_pa
    errf = sa_scan_src_buf
    if ne errf SA_OK
      ret sa_fail_msg errf get sa_state 4
    end
    ai = add ai 1
  end
  errb = sa_verify_bijection
  if ne errb SA_OK
    ret sa_fail_msg errb get sa_state 4
  end
  sa_wtx 1 sa_msg_cli
  sa_wnum 1 get sa_s_cnt 0
  sa_wtx 1 sa_msg_pass2
  sa_wnum 1 get sa_r_cnt 0
  sa_wtx 1 sa_msg_nl
  ret 0
end

fn main to int
  ac_i = argcnt
  if le ac_i 1
    ret sa_run_default
  end
  ac = ulong ac_i
  if lt ac 3
    ret sa_fail_msg SA_ERR_IO 0
  end
  ret sa_run_cli ac
end

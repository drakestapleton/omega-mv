note SPDX-License-Identifier: Apache-2.0
note aienux/spark/plat_gb10.om: DGX Spark GB10 platform profile for spark_main.om (production SPARK.EFI).
note Real GB20B (vendor 0x10de) with 64 MiB BAR0, mandatory RTL8127, SMMUv3 A/B/C at the GB10 bases.
const SPK_PLAT_QEMU ulong 0
const SPK_PLAT_NEED_RTL ulong 1
note == SPARK_GB20B_BAR0_SZ / SPARK_GB20B_BAR0_PA (bar0_mmio.om); omc consts must be literals.
const SPK_PLAT_GPU_BAR_SZ ulong 67108864
const SPK_PLAT_GPU_BAR_FALLBACK ulong 603979776

fn spk_plat_is_gpu vid ulong did ulong to bool
ret eq vid 0x10de
end

fn spk_plat_verify_gpu hb long to bool
ret bmmio_verify_gb20b hb
end

fn spk_plat_note_stage2 to void
end

note SMMUv3 nodes expected in IORT, in order: A (PCIe/NVMe/RTL), B (GB20B), C (abort-only).
const SPK_PLAT_NSMMU ulong 3

fn spk_plat_smmu_base i ulong to ulong
if eq i 0
ret SPARK_SMMU_A_PA
end
if eq i 1
ret SPARK_SMMU_B_PA
end
ret SPARK_SMMU_C_PA
end

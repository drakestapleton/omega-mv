note SPDX-License-Identifier: Apache-2.0
note aienux/spark/plat_qemu.om: QEMU virt test profile for spark_main.om (SPARK-QEMU.EFI, gate only; never staged).
note QEMU has no GB20B. The edu device (1234:11e8) stands in for the GPU ONLY as a PCIe endpoint with its own
note SMMUv3 stream + BME; GB20B register access (PMC_BOOT_0 check, IRQ bind) and Stages 4..6 are stubbed.
note A SPARK-QEMU.EFI booted on real Spark finds no 1234:11e8 device and fails closed at stage 2 (code 201).
const SPK_PLAT_QEMU ulong 1
const SPK_PLAT_NEED_RTL ulong 0
const SPK_PLAT_GPU_BAR_SZ ulong 1048576
const SPK_PLAT_GPU_BAR_FALLBACK ulong 0

text spk_q_s2 "[SPARK QEMU] stage 2 GPU stand-in edu 1234:11e8: GB20B PMC_BOOT_0 check + IRQ bind STUB\n"
text spk_q_s2b "[SPARK QEMU] stage 2 SMMUv3 streams live: gpu-standin sid=0x"
text spk_q_s2c " nvme sid=0x"
text spk_q_nl "\n"

fn spk_plat_is_gpu vid ulong did ulong to bool
ret and eq vid 0x1234 eq did 0x11e8
end

fn spk_plat_verify_gpu hb long to bool
uart_puts spk_q_s2
ret gt hb 0
end

fn spk_plat_note_stage2 to void
uart_puts spk_q_s2b
uart_puthex get smmu_str_sid 0
uart_puts spk_q_s2c
uart_puthex get smmu_str_sid 1
uart_puts spk_q_nl
end

note QEMU virt iommu=smmuv3: one SMMUv3 at VIRT_SMMU = 0x09050000 (hw/arm/virt.c memmap).
const SPK_PLAT_NSMMU ulong 1

fn spk_plat_smmu_base i ulong to ulong
ret 0x09050000
end

note aienux/kernel/core/test.om: Pure-Omega test suite for Aienux Kernel Core
note (Scheduler, Capability-Gated IPC, and AArch64 Stage-1 Page Tables).
note Compose with: si/directives/om2.om aienux/kernel/core/scheduler.om aienux/kernel/core/ipc.om aienux/kernel/core/pagetable.om aienux/kernel/core/test.om

text s_pass "PASS "
text s_fail "FAIL "
text s_nl "\n"
text s_t01 "sched_madt_class_placement"
text s_t02 "sched_fair_equal_priority_and_priority_order"
text s_t03 "sched_background_anti_starvation"
text s_t04 "sched_work_stealing_leaves_high_prio"
text s_t05 "sched_remove_and_reuse_slot"
text s_t06 "sched_negative_controls"
text s_t07 "ipc_channel_fifo_and_bounds"
text s_t08 "ipc_capability_rights_and_wrong_resource"
text s_t09 "ipc_cross_principal_isolation"
text s_t10 "ipc_object_read_write_and_oob"
text s_t11 "ipc_attenuated_delegation_and_no_escalation"
text s_t12 "ipc_tree_revocation_cascades"
text s_t13 "pt_map_4k_2m_1g_and_translate"
text s_t14 "pt_high_half_canonical_kernel_va"
text s_t15 "pt_wx_and_device_exec_refused"
text s_t16 "pt_pxn_uxn_and_flag_roundtrip"
text s_t17 "pt_overlap_and_partial_unmap_refused"
text s_t18 "pt_unmap_and_frame_exhaustion"
text s_sum "KERNEL_CORE_TEST_PASS total=18 failed=0\n"
text s_fsum "KERNEL_CORE_TEST_FAIL\n"

fn kwrite_all fd int buf view uchar * to bool
total = len buf
off = ulong 0
note Each write advances off by at least 1 byte on progress; 4096 covers test output lines.
while lt off total bound 4096
n = write fd buf off sub total off
if le n 0
ret false
end
off = add off ulong n
end
ret true
end

fn report name view uchar * ok bool to uint
if ok
w1 = kwrite_all 1 s_pass
w2 = kwrite_all 1 name
w3 = kwrite_all 1 s_nl
if and w1 and w2 w3
ret 0
end
ret 1
end
w1 = kwrite_all 1 s_fail
w2 = kwrite_all 1 name
w3 = kwrite_all 1 s_nl
if and w1 and w2 w3
ret 1
end
ret 1
end

note ---- Scheduler Tests (01..06) ----

fn test_01_sched_placement to bool
cls = new uchar 4 0
put cls 0 1
put cls 1 3
put cls 2 1
put cls 3 3
if ne sched_init 4 8 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
note Latency must land on class 3 (CPU 1 or 3)
if ne sched_enqueue 10 SCHED_PRIO_LATENCY cpu SCHED_OK
ret false
end
if ne get cls get cpu 0 3
ret false
end
note Background must land on class 1 (CPU 0 or 2)
if ne sched_enqueue 20 SCHED_PRIO_BG cpu SCHED_OK
ret false
end
if ne get cls get cpu 0 1
ret false
end
note Normal lands on shortest queue (length 0)
if ne sched_enqueue 30 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
if ne sched_queue_len get cpu 0 1
ret false
end
ret true
end

fn test_02_sched_fairness to bool
cls = new uchar 1 2
if ne sched_init 1 8 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
if ne sched_enqueue 1 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
if ne sched_enqueue 2 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
if ne sched_enqueue 3 SCHED_PRIO_LATENCY cpu SCHED_OK
ret false
end
ran = new uchar 1 0
tid = new uint 1 0
note Latency task 3 always beats Normal tasks 1 & 2
if ne sched_tick 0 ran tid SCHED_OK
ret false
end
if or eq get ran 0 0 ne get tid 0 3
ret false
end
note Remove latency task 3 -> tasks 1 and 2 share 6 ticks evenly (3 each)
if ne sched_remove 3 SCHED_OK
ret false
end
i = uint 0
while lt i 6 bound 8
if ne sched_tick 0 ran tid SCHED_OK
ret false
end
i = add i 1
end
if ne sched_task_ticks 1 3
ret false
end
if ne sched_task_ticks 2 3
ret false
end
ret true
end

fn test_03_sched_bg_anti_starvation to bool
cls = new uchar 1 2
if ne sched_init 1 4 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
if ne sched_enqueue 100 SCHED_PRIO_LATENCY cpu SCHED_OK
ret false
end
if ne sched_enqueue 200 SCHED_PRIO_BG cpu SCHED_OK
ret false
end
ran = new uchar 1 0
tid = new uint 1 0
note 8 contested ticks with interval 4 -> BG must get exactly 2 ticks, Latency 6 ticks
i = uint 0
while lt i 8 bound 16
if ne sched_tick 0 ran tid SCHED_OK
ret false
end
i = add i 1
end
if ne sched_task_ticks 200 2
ret false
end
if ne sched_task_ticks 100 6
ret false
end
ret true
end

fn test_04_sched_work_stealing to bool
cls = new uchar 2 0
put cls 0 3
put cls 1 1
if ne sched_init 2 8 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
note Put two Latency tasks on CPU 0 (class 3), leaving CPU 1 idle
if ne sched_enqueue 10 SCHED_PRIO_LATENCY cpu SCHED_OK
ret false
end
if ne sched_enqueue 11 SCHED_PRIO_LATENCY cpu SCHED_OK
ret false
end
ran = new uchar 1 0
tid = new uint 1 0
note Tick CPU 0 once so task 10 has 1 tick, task 11 has 0 ticks
if ne sched_tick 0 ran tid SCHED_OK
ret false
end
note Tick idle CPU 1 -> must steal most-served task (10) from CPU 0
if ne sched_tick 1 ran tid SCHED_OK
ret false
end
if or eq get ran 0 0 ne get tid 0 10
ret false
end
if or ne sched_queue_len 0 1 ne sched_queue_len 1 1
ret false
end
ret true
end

fn test_05_sched_remove_reuse to bool
cls = new uchar 2 2
if ne sched_init 2 8 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
if ne sched_enqueue 77 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
if ne sched_remove 77 SCHED_OK
ret false
end
note Re-enqueueing same ID after removal succeeds
if ne sched_enqueue 77 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
ret true
end

fn test_06_sched_negatives to bool
cls = new uchar 2 1
if ne sched_init 0 8 cls SCHED_ERR_NO_CPUS
ret false
end
if ne sched_init 2 8 cls SCHED_OK
ret false
end
cpu = new ulong 1 0
if ne sched_enqueue 5 SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
note Duplicate task ID refused
if ne sched_enqueue 5 SCHED_PRIO_NORMAL cpu SCHED_ERR_DUP_TASK
ret false
end
note Invalid CPU refused
ran = new uchar 1 0
tid = new uint 1 0
if ne sched_tick 2 ran tid SCHED_ERR_BAD_CPU
ret false
end
note Unknown task remove refused
if ne sched_remove 999 SCHED_ERR_UNKNOWN
ret false
end
note Fill remaining 63 slots -> 65th enqueue returns SCHED_ERR_FULL
i = uint 1
while lt i 64 bound 64
if ne sched_enqueue add 100 i SCHED_PRIO_NORMAL cpu SCHED_OK
ret false
end
i = add i 1
end
if ne sched_enqueue 999 SCHED_PRIO_NORMAL cpu SCHED_ERR_FULL
ret false
end
ret true
end

note ---- IPC Tests (07..12) ----

fn test_07_ipc_fifo_bounds to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
msg = new IpcMsg 0 0 0 0
note Empty recv refused
if ne ipc_channel_recv IPC_PRINCIPAL_B get hr 0 msg IPC_ERR_CH_EMPTY
ret false
end
note Fill 8 messages, 9th returns IPC_ERR_CH_FULL
i = ulong 0
while lt i 8 bound 16
put msg tag uint add 10 i
put msg sender IPC_PRINCIPAL_A
put msg arg0 mul i 100
put msg arg1 add i 1
if ne ipc_channel_send IPC_PRINCIPAL_A get hs 0 msg IPC_OK
ret false
end
i = add i 1
end
if ne ipc_channel_send IPC_PRINCIPAL_A get hs 0 msg IPC_ERR_CH_FULL
ret false
end
note Receive in exact FIFO order
i = ulong 0
while lt i 8 bound 16
if ne ipc_channel_recv IPC_PRINCIPAL_B get hr 0 msg IPC_OK
ret false
end
if ne get msg tag uint add 10 i
ret false
end
if ne get msg arg0 mul i 100
ret false
end
i = add i 1
end
ret true
end

fn test_08_ipc_rights_and_resource to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
msg = new IpcMsg 1 0 11 22
note Principal A has WRITE-only channel handle -> recv refused
if ne ipc_channel_recv IPC_PRINCIPAL_A get hs 0 msg IPC_ERR_MISSING_RIGHTS
ret false
end
note Principal B has READ-only channel handle -> send refused
if ne ipc_channel_send IPC_PRINCIPAL_B get hr 0 msg IPC_ERR_MISSING_RIGHTS
ret false
end
note Object handle has READ|WRITE but wrong resource for channel ops
if ne ipc_channel_send IPC_PRINCIPAL_A get ho 0 msg IPC_ERR_WRONG_RESOURCE
ret false
end
if ne ipc_channel_recv IPC_PRINCIPAL_A get ho 0 msg IPC_ERR_WRONG_RESOURCE
ret false
end
ret true
end

fn test_09_ipc_principal_isolation to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
val = new ulong 1 0
note Principal B cannot use Principal A's object handle
if ne ipc_object_read IPC_PRINCIPAL_B get ho 0 0 val IPC_ERR_INVALID_HANDLE
ret false
end
note Forged generation handle refused
bad_h = xor get ho 0 0x100
if ne ipc_object_read IPC_PRINCIPAL_A bad_h 0 val IPC_ERR_INVALID_HANDLE
ret false
end
ret true
end

fn test_10_ipc_object_rw_oob to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
val = new ulong 1 0
if ne ipc_object_read IPC_PRINCIPAL_A get ho 0 0 val IPC_OK
ret false
end
if ne get val 0 0xc0ffee01
ret false
end
if ne ipc_object_write IPC_PRINCIPAL_A get ho 0 2 0xdeadbeef12345678 IPC_OK
ret false
end
if ne ipc_object_read IPC_PRINCIPAL_A get ho 0 2 val IPC_OK
ret false
end
if ne get val 0 0xdeadbeef12345678
ret false
end
note Out-of-bounds object offset refused
if ne ipc_object_read IPC_PRINCIPAL_A get ho 0 4 val IPC_ERR_WRONG_RESOURCE
ret false
end
if ne ipc_object_write IPC_PRINCIPAL_A get ho 0 4 0 IPC_ERR_WRONG_RESOURCE
ret false
end
ret true
end

fn test_11_ipc_delegation_attenuation to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
hb = new ulong 1 0
note Attempt to delegate DERIVE right refused
if ne ipc_delegate_object IPC_PRINCIPAL_A get ho 0 IPC_PRINCIPAL_B or IPC_RIGHT_READ IPC_RIGHT_DERIVE hb IPC_ERR_MISSING_RIGHTS
ret false
end
note Attenuated READ-only delegation succeeds
if ne ipc_delegate_object IPC_PRINCIPAL_A get ho 0 IPC_PRINCIPAL_B IPC_RIGHT_READ hb IPC_OK
ret false
end
val = new ulong 1 0
if ne ipc_object_read IPC_PRINCIPAL_B get hb 0 1 val IPC_OK
ret false
end
if ne get val 0 0x0badc0de
ret false
end
note B cannot write with READ-only delegated handle
if ne ipc_object_write IPC_PRINCIPAL_B get hb 0 1 99 IPC_ERR_MISSING_RIGHTS
ret false
end
ret true
end

fn test_12_ipc_tree_revocation to bool
hs = new ulong 1 0
ho = new ulong 1 0
hr = new ulong 1 0
ipc_reset hs ho hr
hb = new ulong 1 0
if ne ipc_delegate_object IPC_PRINCIPAL_A get ho 0 IPC_PRINCIPAL_B IPC_RIGHT_READ hb IPC_OK
ret false
end
val = new ulong 1 0
if ne ipc_object_read IPC_PRINCIPAL_B get hb 0 0 val IPC_OK
ret false
end
note Revoking Principal A's parent handle cascades to Principal B's derived handle
if ne ipc_revoke IPC_PRINCIPAL_A get ho 0 IPC_OK
ret false
end
if ne ipc_object_read IPC_PRINCIPAL_A get ho 0 0 val IPC_ERR_INVALID_HANDLE
ret false
end
if ne ipc_object_read IPC_PRINCIPAL_B get hb 0 0 val IPC_ERR_INVALID_HANDLE
ret false
end
ret true
end

note ---- AArch64 Stage-1 PageTable Tests (13..18) ----

fn test_13_pt_4k_2m_1g_translate to bool
if ne pt_init 0x40000000 32 PT_OK
ret false
end
f = new PtFlags PT_MAIR_NORMAL_WB 1 0 0 1 1
note 1 GiB block at 0x40000000 -> 0x80000000
if ne pt_map 0x40000000 0x80000000 PT_BLOCK_1G f PT_OK
ret false
end
note 2 MiB block at 0x00200000 -> 0x10200000
if ne pt_map 0x00200000 0x10200000 PT_BLOCK_2M f PT_OK
ret false
end
note 4 KiB page at 0x00001000 -> 0x20001000
if ne pt_map 0x00001000 0x20001000 PT_PAGE_SIZE f PT_OK
ret false
end
tr = new PtTrans 0 0 0 0 0 0 0 0
if ne pt_translate 0x40000123 tr PT_OK
ret false
end
if or ne get tr pa 0x80000123 ne get tr page_size PT_BLOCK_1G
ret false
end
if ne pt_translate 0x00200456 tr PT_OK
ret false
end
if or ne get tr pa 0x10200456 ne get tr page_size PT_BLOCK_2M
ret false
end
if ne pt_translate 0x00001789 tr PT_OK
ret false
end
if or ne get tr pa 0x20001789 ne get tr page_size PT_PAGE_SIZE
ret false
end
ret true
end

fn test_14_pt_high_half_canonical to bool
if ne pt_init 0x40000000 32 PT_OK
ret false
end
f = new PtFlags PT_MAIR_NORMAL_WB 0 0 1 1 1
note 48-bit canonical high-half kernel VA has bit 47 == 1 and bits 63..48 == 0xffff
hi_va = ulong 0xffff800040000000
if ne pt_map hi_va 0x50000000 PT_PAGE_SIZE f PT_OK
ret false
end
tr = new PtTrans 0 0 0 0 0 0 0 0
if ne pt_translate add hi_va 0x44 tr PT_OK
ret false
end
if ne get tr pa 0x50000044
ret false
end
note Non-canonical VAs (both low-hole and high-hole where bit 47 != bits 63..48) refused
non_can1 = ulong 0x0001000000000000
non_can2 = ulong 0xffff000040000000
if ne pt_map non_can1 0x50001000 PT_PAGE_SIZE f PT_ERR_ADDR_OOB
ret false
end
if ne pt_map non_can2 0x50001000 PT_PAGE_SIZE f PT_ERR_ADDR_OOB
ret false
end
if ne pt_translate non_can1 tr PT_ERR_ADDR_OOB
ret false
end
ret true
end

fn test_15_pt_wx_and_device_exec to bool
if ne pt_init 0x40000000 32 PT_OK
ret false
end
note W^X: writable + executable MUST be refused
wx = new PtFlags PT_MAIR_NORMAL_WB 1 0 1 1 1
if ne pt_map 0x1000 0x1000 PT_PAGE_SIZE wx PT_ERR_WX
ret false
end
note Device-nGnRE + executable MUST be refused
devx = new PtFlags PT_MAIR_DEVICE_NGNRE 0 0 1 0 1
if ne pt_map 0x2000 0x09000000 PT_PAGE_SIZE devx PT_ERR_DEVICE_EXEC
ret false
end
note Device-nGnRE non-executable writable succeeds
devrw = new PtFlags PT_MAIR_DEVICE_NGNRE 1 0 0 0 1
if ne pt_map 0x2000 0x09000000 PT_PAGE_SIZE devrw PT_OK
ret false
end
ret true
end

fn test_16_pt_pxn_uxn_flags to bool
if ne pt_init 0x40000000 32 PT_OK
ret false
end
kcode = new PtFlags PT_MAIR_NORMAL_WB 0 0 1 1 1
ucode = new PtFlags PT_MAIR_NORMAL_WB 0 1 1 1 0
kdata = new PtFlags PT_MAIR_NORMAL_WB 1 0 0 1 1
if ne pt_map 0x1000 0x10000 PT_PAGE_SIZE kcode PT_OK
ret false
end
if ne pt_map 0x2000 0x20000 PT_PAGE_SIZE ucode PT_OK
ret false
end
if ne pt_map 0x3000 0x30000 PT_PAGE_SIZE kdata PT_OK
ret false
end
tr = new PtTrans 0 0 0 0 0 0 0 0
if ne pt_translate 0x1000 tr PT_OK
ret false
end
if ne get tr executable 1
ret false
end
if ne get tr user 0
ret false
end
if ne get tr writable 0
ret false
end
if ne pt_translate 0x2000 tr PT_OK
ret false
end
if ne get tr executable 1
ret false
end
if ne get tr user 1
ret false
end
if ne get tr global_flag 0
ret false
end
if ne pt_translate 0x3000 tr PT_OK
ret false
end
if ne get tr executable 0
ret false
end
if ne get tr writable 1
ret false
end
if ne get tr user 0
ret false
end
ret true
end

fn test_17_pt_overlap_and_partial_unmap to bool
if ne pt_init 0x40000000 32 PT_OK
ret false
end
f = new PtFlags PT_MAIR_NORMAL_WB 1 0 0 1 1
if ne pt_map 0x00200000 0x10200000 PT_BLOCK_2M f PT_OK
ret false
end
note Mapping 4 KiB inside existing 2 MiB block refused with PT_ERR_OVERLAP
if ne pt_map 0x00201000 0x20000000 PT_PAGE_SIZE f PT_ERR_OVERLAP
ret false
end
note Unmapping 4 KiB of a 2 MiB block refused with PT_ERR_MISALIGNED
if ne pt_unmap 0x00200000 PT_PAGE_SIZE PT_ERR_MISALIGNED
ret false
end
note Remapping same 4 KiB refused with PT_ERR_OVERLAP
if ne pt_map 0x1000 0x10000 PT_PAGE_SIZE f PT_OK
ret false
end
if ne pt_map 0x1000 0x20000 PT_PAGE_SIZE f PT_ERR_OVERLAP
ret false
end
ret true
end

fn test_18_pt_unmap_and_exhaustion to bool
if ne pt_init 0x40000000 4 PT_OK
ret false
end
f = new PtFlags PT_MAIR_NORMAL_WB 1 0 0 1 1
note Mapping a 4 KiB page consumes 4 frames (L0 root + L1 + L2 + L3) -> exact fit
if ne pt_map 0x1000 0x10000 PT_PAGE_SIZE f PT_OK
ret false
end
if ne pt_frames_used 4
ret false
end
note Mapping in a different L1 subtree requires a 5th frame -> PT_ERR_NO_FRAMES
if ne pt_map 0x8000000000 0x20000 PT_PAGE_SIZE f PT_ERR_NO_FRAMES
ret false
end
note Unmap 0x1000 -> translate returns PT_ERR_NOT_MAPPED
if ne pt_unmap 0x1000 PT_PAGE_SIZE PT_OK
ret false
end
tr = new PtTrans 0 0 0 0 0 0 0 0
if ne pt_translate 0x1000 tr PT_ERR_NOT_MAPPED
ret false
end
if ne pt_unmap 0x1000 PT_PAGE_SIZE PT_ERR_NOT_MAPPED
ret false
end
ret true
end

fn main to int
failed = uint 0
failed = add failed report s_t01 test_01_sched_placement
failed = add failed report s_t02 test_02_sched_fairness
failed = add failed report s_t03 test_03_sched_bg_anti_starvation
failed = add failed report s_t04 test_04_sched_work_stealing
failed = add failed report s_t05 test_05_sched_remove_reuse
failed = add failed report s_t06 test_06_sched_negatives
failed = add failed report s_t07 test_07_ipc_fifo_bounds
failed = add failed report s_t08 test_08_ipc_rights_and_resource
failed = add failed report s_t09 test_09_ipc_principal_isolation
failed = add failed report s_t10 test_10_ipc_object_rw_oob
failed = add failed report s_t11 test_11_ipc_delegation_attenuation
failed = add failed report s_t12 test_12_ipc_tree_revocation
failed = add failed report s_t13 test_13_pt_4k_2m_1g_translate
failed = add failed report s_t14 test_14_pt_high_half_canonical
failed = add failed report s_t15 test_15_pt_wx_and_device_exec
failed = add failed report s_t16 test_16_pt_pxn_uxn_flags
failed = add failed report s_t17 test_17_pt_overlap_and_partial_unmap
failed = add failed report s_t18 test_18_pt_unmap_and_exhaustion
if eq failed 0
w = kwrite_all 1 s_sum
if w
ret 0
end
ret 1
end
w = kwrite_all 1 s_fsum
if w
ret 1
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note aienux/kernel/core/klog.om: Pure-Omega RAM Console Log (head + tail ring with drop marker).
note Converted from upstream aienux native/kernel/core/klog.h and native/kernel/core/klog.c.

const KLOG_HEAD_CAP ulong 4096
const KLOG_TAIL_CAP ulong 1024

note klog_meta: 0=head_len, 1=tail_put, 2=total, 3=head_cap, 4=tail_cap
global klog_meta ulong 5
global klog_head uchar 4096
global klog_tail uchar 1024

text klog_drop_pre "\n[klog: "
text klog_drop_suf " bytes dropped]\n"

fn klog_clear_caps hcap ulong tcap ulong to void
hc = hcap
tc = tcap
if or eq hc 0 gt hc KLOG_HEAD_CAP
hc = KLOG_HEAD_CAP
end
if or eq tc 0 gt tc KLOG_TAIL_CAP
tc = KLOG_TAIL_CAP
end
put klog_meta 0 0
put klog_meta 1 0
put klog_meta 2 0
put klog_meta 3 hc
put klog_meta 4 tc
end

fn klog_clear to void
klog_clear_caps KLOG_HEAD_CAP KLOG_TAIL_CAP
end

fn klog_put src view uchar * to void
n = len src
hc = get klog_meta 3
tc = get klog_meta 4
if eq hc 0
klog_clear
hc = KLOG_HEAD_CAP
tc = KLOG_TAIL_CAP
end
put klog_meta 2 add get klog_meta 2 n
hlen = get klog_meta 0
tput = get klog_meta 1
i = ulong 0
while lt i n bound 65536
ch = get src i
if lt hlen hc
put klog_head hlen ch
hlen = add hlen 1
else
put klog_tail rem tput tc ch
tput = add tput 1
end
i = add i 1
end
put klog_meta 0 hlen
put klog_meta 1 tput
end

fn klog_total to ulong
ret get klog_meta 2
end

fn klog_dropped to ulong
tput = get klog_meta 1
tc = get klog_meta 4
if gt tput tc
ret sub tput tc
end
ret 0
end

fn klog_write_dec dst edit uchar * pos ulong cap ulong val ulong to ulong
digits = new uchar 24 0
nd = ulong 0
v = val
if eq v 0
put digits 0 48
nd = ulong 1
else
while gt v 0 bound 24
put digits nd uchar add 48 rem v 10
v = div v 10
nd = add nd 1
end
end
w = pos
i = nd
while gt i 0 bound 24
i = sub i 1
if lt w cap
put dst w get digits i
w = add w 1
end
end
ret w
end

fn klog_copy_text dst edit uchar * pos ulong cap ulong src view uchar * to ulong
w = pos
n = len src
i = ulong 0
while lt i n bound 64
if ge w cap
break
end
put dst w get src i
w = add w 1
i = add i 1
end
ret w
end

fn klog_read dst edit uchar * to ulong
cap = len dst
hlen = get klog_meta 0
tput = get klog_meta 1
tc = get klog_meta 4
w = ulong 0
i = ulong 0
while lt i hlen bound 4096
if ge w cap
break
end
put dst w get klog_head i
w = add w 1
i = add i 1
end
kept = tput
if gt kept tc
kept = tc
end
if gt tput tc
w = klog_copy_text dst w cap klog_drop_pre
w = klog_write_dec dst w cap sub tput tc
w = klog_copy_text dst w cap klog_drop_suf
end
start = sub tput kept
j = start
while lt j tput bound 1024
if ge w cap
break
end
put dst w get klog_tail rem j tc
w = add w 1
j = add j 1
end
ret w
end

note SPDX-License-Identifier: Apache-2.0
note aienux/kernel/core/pagetable.om: Pure-Omega AArch64 Stage-1 4-KiB Granule 48-bit
note 4-Level Page-Table Builder, W^X/Device-NX Enforcer, Unmapper & Address Translator.
note Converted from upstream aienux crates/aienos-kernel/src/mem/pagetable.rs.

const PT_MAIR_NORMAL_WB uchar 0
const PT_MAIR_DEVICE_NGNRE uchar 1
const PT_MAIR_DEVICE_NGNRNE uchar 2
const PT_MAIR_NORMAL_NC uchar 3
const PT_MAIR_VALUE ulong 0x00000000440004ff

const PT_OK int 0
const PT_ERR_MISALIGNED int -1
const PT_ERR_ADDR_OOB int -2
const PT_ERR_WX int -3
const PT_ERR_DEVICE_EXEC int -4
const PT_ERR_OVERLAP int -5
const PT_ERR_NOT_MAPPED int -6
const PT_ERR_NO_FRAMES int -7

const PT_PAGE_SIZE ulong 4096
const PT_BLOCK_2M ulong 0x200000
const PT_BLOCK_1G ulong 0x40000000
const PT_ADDR_MASK ulong 0x0000fffffffff000
const PT_PA_MAX ulong 0x0000ffffffffffff
const PT_U64_MAX ulong 0xffffffffffffffff
const PT_VALID ulong 1
const PT_BLOCK ulong 1
const PT_TABLE ulong 3
const PT_ENTRIES ulong 512
const PT_MAX_FRAMES ulong 64

note Static pool of 64 4-KiB page-table frames (64 * 512 = 32768 u64 descriptors)
note pt_meta: 0=pool_cap, 1=frames_used, 2=root_frame, 3=phys_base
global pt_meta ulong 4
global pt_mem ulong 32768

fn pt_is_canonical va ulong to bool
if eq and va shl ulong 1 47 0
ret eq shr va 48 0
end
ret eq shr va 48 0xffff
end

fn pt_level_index va ulong level ulong to ulong
if eq level 0
ret and shr va 39 511
end
if eq level 1
ret and shr va 30 511
end
if eq level 2
ret and shr va 21 511
end
ret and shr va 12 511
end

fn pt_leaf_attrs f view PtFlags to ulong
attr = shl ulong get f attr 2
ap = ulong 2
if ne get f user 0
if ne get f writable 0
ap = ulong 1
else
ap = ulong 3
end
else
if ne get f writable 0
ap = ulong 0
else
ap = ulong 2
end
end
bits = or attr shl ap 6
shv = get f shareable
if eq shv 1
bits = or bits shl ulong 3 8
else
if eq shv 2
bits = or bits shl ulong 2 8
end
end
note AF (bit 10) always set
bits = or bits shl ulong 1 10
note nG (bit 11): 0 for global, 1 for non-global
if eq get f global_flag 0
bits = or bits shl ulong 1 11
end
note PXN (bit 53): kernel never executes non-executable or user pages
if or eq get f executable 0 ne get f user 0
bits = or bits shl ulong 1 53
end
note UXN (bit 54): user never executes non-executable or kernel pages
if or eq get f executable 0 eq get f user 0
bits = or bits shl ulong 1 54
end
ret bits
end

fn pt_decode_flags desc ulong dst edit PtTrans to void
attr = uchar and shr desc 2 7
ap = and shr desc 6 3
sh = and shr desc 8 3
ng = and shr desc 11 1
pxn = and shr desc 53 1
uxn = and shr desc 54 1
is_user = uchar 0
if or eq ap 1 eq ap 3
is_user = uchar 1
end
is_wr = uchar 0
if or eq ap 0 eq ap 1
is_wr = uchar 1
end
is_exec = uchar 0
if ne is_user 0
if eq uxn 0
is_exec = uchar 1
end
else
if eq pxn 0
is_exec = uchar 1
end
end
put dst attr attr
put dst writable is_wr
put dst user is_user
put dst executable is_exec
if eq sh 3
put dst shareable 1
else
if eq sh 2
put dst shareable 2
else
put dst shareable 0
end
end
if eq ng 0
put dst global_flag 1
else
put dst global_flag 0
end
end

fn pt_alloc_frame dst edit ulong 1 to int
used = get pt_meta 1
cap = get pt_meta 0
if ge used cap
ret PT_ERR_NO_FRAMES
end
base = mul used PT_ENTRIES
for i ulong 512
put pt_mem add base i 0
end
put pt_meta 1 add used 1
put dst 0 used
ret PT_OK
end

fn pt_frame_to_pa fidx ulong to ulong
ret add get pt_meta 3 mul fidx PT_PAGE_SIZE
end

fn pt_pa_to_frame pa ulong to ulong
ret div sub pa get pt_meta 3 PT_PAGE_SIZE
end

fn pt_init phys_base ulong pool_cap ulong to int
if ne and phys_base 0xfff 0
ret PT_ERR_MISALIGNED
end
if or eq pool_cap 0 gt pool_cap PT_MAX_FRAMES
ret PT_ERR_NO_FRAMES
end
put pt_meta 0 pool_cap
put pt_meta 1 0
put pt_meta 2 0
put pt_meta 3 phys_base
f = new ulong 1 0
rc = pt_alloc_frame f
if ne rc PT_OK
ret rc
end
put pt_meta 2 get f 0
ret PT_OK
end

fn pt_frames_used to ulong
ret get pt_meta 1
end

fn pt_validate_vrange va ulong length ulong to int
if or eq length 0 or ne and va 0xfff 0 ne and length 0xfff 0
ret PT_ERR_MISALIGNED
end
lm1 = sub length 1
if gt lm1 sub PT_U64_MAX va
ret PT_ERR_ADDR_OOB
end
vend = add va lm1
if or not pt_is_canonical va not pt_is_canonical vend
ret PT_ERR_ADDR_OOB
end
ret PT_OK
end

fn pt_validate_range va ulong pa ulong length ulong flags view PtFlags to int
rc = pt_validate_vrange va length
if ne rc PT_OK
ret rc
end
if ne and pa 0xfff 0
ret PT_ERR_MISALIGNED
end
if and ne get flags writable 0 ne get flags executable 0
ret PT_ERR_WX
end
if gt get flags attr PT_MAIR_NORMAL_NC
ret PT_ERR_DEVICE_EXEC
end
if and ne get flags executable 0 ne get flags attr PT_MAIR_NORMAL_WB
ret PT_ERR_DEVICE_EXEC
end
lm1 = sub length 1
if gt lm1 sub PT_U64_MAX pa
ret PT_ERR_ADDR_OOB
end
pend = add pa lm1
if gt pend PT_PA_MAX
ret PT_ERR_ADDR_OOB
end
ret PT_OK
end

fn pt_ensure_table cur_frame ulong va ulong lvl ulong next_out edit ulong 1 to int
pos = add mul cur_frame PT_ENTRIES pt_level_index va lvl
ent = get pt_mem pos
if eq and ent PT_VALID 0
rc = pt_alloc_frame next_out
if ne rc PT_OK
ret rc
end
cpa = pt_frame_to_pa get next_out 0
put pt_mem pos or and cpa PT_ADDR_MASK PT_TABLE
ret PT_OK
end
if eq and ent 3 PT_TABLE
put next_out 0 pt_pa_to_frame and ent PT_ADDR_MASK
ret PT_OK
end
ret PT_ERR_OVERLAP
end

fn pt_map_leaf va ulong pa ulong sz ulong flags view PtFlags to int
tlevel = ulong 3
if eq sz PT_BLOCK_1G
tlevel = ulong 1
else
if eq sz PT_BLOCK_2M
tlevel = ulong 2
end
end
cur_frame = get pt_meta 2
nf = new ulong 1 0
lvl = ulong 0
while lt lvl tlevel bound 4
rc = pt_ensure_table cur_frame va lvl nf
if ne rc PT_OK
ret rc
end
cur_frame = get nf 0
lvl = add lvl 1
end
lidx = pt_level_index va tlevel
lpos = add mul cur_frame PT_ENTRIES lidx
if ne and get pt_mem lpos PT_VALID 0
ret PT_ERR_OVERLAP
end
kind = PT_BLOCK
if eq tlevel 3
kind = PT_TABLE
end
desc = or or and pa PT_ADDR_MASK pt_leaf_attrs flags kind
put pt_mem lpos desc
ret PT_OK
end

fn pt_pick_block_size cva ulong cpa ulong rem_len ulong to ulong
if ge rem_len PT_BLOCK_1G
if eq rem cva PT_BLOCK_1G 0
if eq rem cpa PT_BLOCK_1G 0
ret PT_BLOCK_1G
end
end
end
if ge rem_len PT_BLOCK_2M
if eq rem cva PT_BLOCK_2M 0
if eq rem cpa PT_BLOCK_2M 0
ret PT_BLOCK_2M
end
end
end
ret PT_PAGE_SIZE
end

fn pt_map va ulong pa ulong length ulong flags view PtFlags to int
rc = pt_validate_range va pa length flags
if ne rc PT_OK
ret rc
end
off = ulong 0
note Each step advances by at least 4 KiB; bound 131072 covers up to 256 GiB at 2 MiB blocks or 128 TiB at 1 GiB blocks.
while lt off length bound 131072
cva = add va off
cpa = add pa off
sz = pt_pick_block_size cva cpa sub length off
rc = pt_map_leaf cva cpa sz flags
if ne rc PT_OK
ret rc
end
off = add off sz
end
ret PT_OK
end

note Walk 4-level page table for va. On hit sets info_out[0]=frame, [1]=idx, [2]=size and returns true.
fn pt_find_leaf va ulong info_out edit ulong 3 to bool
cur_frame = get pt_meta 2
lvl = ulong 0
while lt lvl 4 bound 4
idx = pt_level_index va lvl
pos = add mul cur_frame PT_ENTRIES idx
ent = get pt_mem pos
if eq and ent PT_VALID 0
ret false
end
is_tab = eq and ent 3 PT_TABLE
if or eq lvl 0 and is_tab lt lvl 3
cur_frame = pt_pa_to_frame and ent PT_ADDR_MASK
else
put info_out 0 cur_frame
put info_out 1 idx
if eq lvl 1
put info_out 2 PT_BLOCK_1G
else
if eq lvl 2
put info_out 2 PT_BLOCK_2M
else
put info_out 2 PT_PAGE_SIZE
end
end
ret true
end
lvl = add lvl 1
end
ret false
end

fn pt_unmap va ulong length ulong to int
rc = pt_validate_vrange va length
if ne rc PT_OK
ret rc
end
info = new ulong 3 0
off = ulong 0
while lt off length bound 131072
cva = add va off
if not pt_find_leaf cva info
ret PT_ERR_NOT_MAPPED
end
sz = get info 2
if or ne rem cva sz 0 lt sub length off sz
ret PT_ERR_MISALIGNED
end
pos = add mul get info 0 PT_ENTRIES get info 1
put pt_mem pos 0
off = add off sz
end
ret PT_OK
end

fn pt_translate va ulong dst edit PtTrans to int
if not pt_is_canonical va
ret PT_ERR_ADDR_OOB
end
info = new ulong 3 0
if not pt_find_leaf va info
ret PT_ERR_NOT_MAPPED
end
pos = add mul get info 0 PT_ENTRIES get info 1
desc = get pt_mem pos
sz = get info 2
put dst pa add and desc PT_ADDR_MASK rem va sz
put dst page_size sz
pt_decode_flags desc dst
ret PT_OK
end

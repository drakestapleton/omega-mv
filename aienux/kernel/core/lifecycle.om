note SPDX-License-Identifier: Apache-2.0
note aienux/kernel/core/lifecycle.om: Pure-Omega Resident Production Lifecycle FSM.
note Converted from upstream aienux native/kernel/core/lifecycle_fsm.h and lifecycle_fsm.c.

note States
const LC_INIT uint 0
const LC_LOCKED uint 1
const LC_READY uint 2
const LC_SERVE uint 3
const LC_QUIESCE uint 4
const LC_STOP uint 5

note Verbs
const LC_V_INVALID int -1
const LC_V_UNKNOWN int 0
const LC_V_EMPTY int 1
const LC_V_HELP int 2
const LC_V_STATUS int 3
const LC_V_UNLOCK int 4
const LC_V_TASK int 5
const LC_V_APPROVE int 6
const LC_V_DENY int 7
const LC_V_CANCEL int 8
const LC_V_EVIDENCE int 9
const LC_V_SHUTDOWN int 10
const LC_V_PROMPT int 11
const LC_V_RECALL int 12
const LC_V_REMEMBER int 13
const LC_V_FACTS int 14
const LC_V_ROTATE int 15
const LC_V_UPDATE int 16
const LC_V_PREFER int 17

note Pending kinds
const LC_PENDING_NONE uint 0
const LC_PENDING_NOTE uint 1
const LC_PENDING_REPLY uint 2

note Transition outcomes
const LC_R_OK uint 0
const LC_R_REFUSED uint 1
const LC_R_INVALID uint 2
const LC_R_COMMIT uint 3
const LC_R_UNLOCK uint 4
const LC_R_STOP uint 5
const LC_R_GENERATE uint 6
const LC_R_RECALL uint 7
const LC_R_REMEMBER uint 8
const LC_R_FACTS uint 9
const LC_R_ROTATE uint 10
const LC_R_UPDATE uint 11
const LC_R_PREFER uint 12

note Generation completion outcomes
const LC_GEN_REPLY uint 0
const LC_GEN_CANCELLED uint 1
const LC_GEN_FAILED uint 2

note Bounds
const LC_LINE_MAX ulong 144
const LC_TASK_MAX ulong 48
const LC_REPLY_MAX ulong 1536

note Counters indices in lc_cnt (18 u32s)
const LC_C_STATE ulong 0
const LC_C_PENDING ulong 1
const LC_C_TASK_LEN ulong 2
const LC_C_REPLY_LEN ulong 3
const LC_C_FACT_LEN ulong 4
const LC_C_REQUESTS ulong 5
const LC_C_REFUSED ulong 6
const LC_C_INVALID ulong 7
const LC_C_TASKS ulong 8
const LC_C_APPROVED ulong 9
const LC_C_DENIED ulong 10
const LC_C_CANCELLED ulong 11
const LC_C_PROMPTS ulong 12
const LC_C_REPLIES ulong 13
const LC_C_GEN_CANCEL ulong 14
const LC_C_GEN_FAIL ulong 15
const LC_C_RECALLS ulong 16
const LC_C_REMEMBERS ulong 17
const LC_C_FACTS ulong 18
const LC_C_UPDATES ulong 19
const LC_C_PREFERS ulong 20
const LC_C_BIND_REF ulong 21
const LC_C_REPLAYS ulong 22

global lc_cnt uint 24
global lc_task uchar 48
global lc_fact uchar 48
global lc_reply uchar 1536

text lcw_task "task"
text lcw_prompt "prompt"
text lcw_remember "remember"
text lcw_prefer "prefer"
text lcw_unlock "unlock"
text lcw_rotate "rotate"
text lcw_update "update"
text lcw_help "help"
text lcw_status "status"
text lcw_approve "approve"
text lcw_deny "deny"
text lcw_cancel "cancel"
text lcw_recall "recall"
text lcw_facts "facts"
text lcw_evidence "evidence"
text lcw_shutdown "shutdown"

fn lc_word_is line view uchar * ws ulong wlen ulong lit view uchar * to bool
if ne wlen len lit
ret false
end
i = ulong 0
while lt i wlen bound 32
if ne get line add ws i get lit i
ret false
end
i = add i 1
end
ret true
end

fn lc_decode_noarg line view uchar * ws ulong wn ulong to int
if lc_word_is line ws wn lcw_help
ret LC_V_HELP
end
if lc_word_is line ws wn lcw_status
ret LC_V_STATUS
end
if lc_word_is line ws wn lcw_approve
ret LC_V_APPROVE
end
if lc_word_is line ws wn lcw_deny
ret LC_V_DENY
end
if lc_word_is line ws wn lcw_cancel
ret LC_V_CANCEL
end
if lc_word_is line ws wn lcw_recall
ret LC_V_RECALL
end
if lc_word_is line ws wn lcw_facts
ret LC_V_FACTS
end
if lc_word_is line ws wn lcw_evidence
ret LC_V_EVIDENCE
end
if lc_word_is line ws wn lcw_shutdown
ret LC_V_SHUTDOWN
end
ret LC_V_UNKNOWN
end

fn lc_decode line view uchar * arg_out edit LcArg to int
put arg_out off 0
put arg_out alen 0
n = len line
if gt n LC_LINE_MAX
ret LC_V_INVALID
end
i = ulong 0
while lt i n bound 144
ch = get line i
if or lt ch 0x20 gt ch 0x7e
ret LC_V_INVALID
end
i = add i 1
end
i = ulong 0
while lt i n bound 144
if ne get line i 32
break
end
i = add i 1
end
if eq i n
ret LC_V_EMPTY
end
ws = i
while lt i n bound 144
if eq get line i 32
break
end
i = add i 1
end
we = i
while lt i n bound 144
if ne get line i 32
break
end
i = add i 1
end
aend = n
while gt aend i bound 144
if ne get line sub aend 1 32
break
end
aend = sub aend 1
end
alen = sub aend i
put arg_out off i
put arg_out alen alen
wn = sub we ws
if lc_word_is line ws wn lcw_task
if or eq alen 0 gt alen LC_TASK_MAX
ret LC_V_INVALID
end
ret LC_V_TASK
end
if lc_word_is line ws wn lcw_prompt
if or eq alen 0 gt alen LC_TASK_MAX
ret LC_V_INVALID
end
ret LC_V_PROMPT
end
if lc_word_is line ws wn lcw_remember
if or eq alen 0 gt alen LC_TASK_MAX
ret LC_V_INVALID
end
ret LC_V_REMEMBER
end
if lc_word_is line ws wn lcw_prefer
if or eq alen 0 gt alen LC_TASK_MAX
ret LC_V_INVALID
end
ret LC_V_PREFER
end
if lc_word_is line ws wn lcw_unlock
ret LC_V_UNLOCK
end
if lc_word_is line ws wn lcw_rotate
ret LC_V_ROTATE
end
if lc_word_is line ws wn lcw_update
ret LC_V_UPDATE
end
if ne alen 0
ret LC_V_INVALID
end
ret lc_decode_noarg line ws wn
end

fn lc_init to void
for i ulong 24
put lc_cnt i 0
end
for i ulong 48
put lc_task i 0
put lc_fact i 0
end
for i ulong 1536
put lc_reply i 0
end
put lc_cnt LC_C_STATE LC_INIT
end

fn lc_start store_open bool to void
if store_open
put lc_cnt LC_C_STATE LC_READY
else
put lc_cnt LC_C_STATE LC_LOCKED
end
end

fn lc_drop_task to void
for i ulong 48
put lc_task i 0
end
for i ulong 1536
put lc_reply i 0
end
put lc_cnt LC_C_TASK_LEN 0
put lc_cnt LC_C_REPLY_LEN 0
put lc_cnt LC_C_PENDING LC_PENDING_NONE
end

fn lc_set_task arg view uchar * to void
n = len arg
i = ulong 0
while lt i n bound 48
put lc_task i get arg i
i = add i 1
end
put lc_cnt LC_C_TASK_LEN uint n
end

fn lc_set_fact arg view uchar * to void
n = len arg
i = ulong 0
while lt i n bound 48
put lc_fact i get arg i
i = add i 1
end
put lc_cnt LC_C_FACT_LEN uint n
end

fn lc_refuse to uint
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
ret LC_R_REFUSED
end

fn lc_apply_ready_verbs verb int arg view uchar * st uint to uint
alen = len arg
if eq verb LC_V_TASK
if or eq st LC_LOCKED or eq st LC_SERVE or eq alen 0 gt alen LC_TASK_MAX
ret lc_refuse
end
lc_set_task arg
put lc_cnt LC_C_PENDING LC_PENDING_NOTE
put lc_cnt LC_C_TASKS add get lc_cnt LC_C_TASKS 1
put lc_cnt LC_C_STATE LC_SERVE
ret LC_R_OK
end
if eq verb LC_V_PROMPT
if or eq st LC_LOCKED or eq st LC_SERVE or eq alen 0 gt alen LC_TASK_MAX
ret lc_refuse
end
lc_set_task arg
put lc_cnt LC_C_PROMPTS add get lc_cnt LC_C_PROMPTS 1
ret LC_R_GENERATE
end
if eq verb LC_V_RECALL
if eq st LC_LOCKED
ret lc_refuse
end
put lc_cnt LC_C_RECALLS add get lc_cnt LC_C_RECALLS 1
ret LC_R_RECALL
end
if eq verb LC_V_REMEMBER
if or eq st LC_LOCKED or eq alen 0 gt alen LC_TASK_MAX
ret lc_refuse
end
lc_set_fact arg
put lc_cnt LC_C_REMEMBERS add get lc_cnt LC_C_REMEMBERS 1
ret LC_R_REMEMBER
end
if eq verb LC_V_PREFER
if or eq st LC_LOCKED or eq alen 0 gt alen LC_TASK_MAX
ret lc_refuse
end
lc_set_fact arg
put lc_cnt LC_C_PREFERS add get lc_cnt LC_C_PREFERS 1
ret LC_R_PREFER
end
if eq verb LC_V_FACTS
if eq st LC_LOCKED
ret lc_refuse
end
put lc_cnt LC_C_FACTS add get lc_cnt LC_C_FACTS 1
ret LC_R_FACTS
end
ret lc_refuse
end

fn lc_apply verb int arg view uchar * to uint
put lc_cnt LC_C_REQUESTS add get lc_cnt LC_C_REQUESTS 1
st = get lc_cnt LC_C_STATE
if or eq st LC_QUIESCE or eq st LC_STOP eq st LC_INIT
ret lc_refuse
end
if eq verb LC_V_INVALID
put lc_cnt LC_C_INVALID add get lc_cnt LC_C_INVALID 1
ret LC_R_INVALID
end
if eq verb LC_V_UNKNOWN
ret lc_refuse
end
if or eq verb LC_V_EMPTY or eq verb LC_V_HELP or eq verb LC_V_STATUS eq verb LC_V_EVIDENCE
ret LC_R_OK
end
if eq verb LC_V_UNLOCK
if ne st LC_LOCKED
ret lc_refuse
end
ret LC_R_UNLOCK
end
if eq verb LC_V_ROTATE
if or eq st LC_LOCKED or eq st LC_SERVE eq len arg 0
ret lc_refuse
end
ret LC_R_ROTATE
end
if eq verb LC_V_UPDATE
if or eq st LC_LOCKED eq st LC_SERVE
ret lc_refuse
end
put lc_cnt LC_C_UPDATES add get lc_cnt LC_C_UPDATES 1
ret LC_R_UPDATE
end
if eq verb LC_V_APPROVE
if ne st LC_SERVE
ret lc_refuse
end
ret LC_R_COMMIT
end
if eq verb LC_V_DENY
if ne st LC_SERVE
ret lc_refuse
end
put lc_cnt LC_C_DENIED add get lc_cnt LC_C_DENIED 1
lc_drop_task
put lc_cnt LC_C_STATE LC_READY
ret LC_R_OK
end
if eq verb LC_V_CANCEL
if ne st LC_SERVE
ret lc_refuse
end
put lc_cnt LC_C_CANCELLED add get lc_cnt LC_C_CANCELLED 1
lc_drop_task
put lc_cnt LC_C_STATE LC_READY
ret LC_R_OK
end
if eq verb LC_V_SHUTDOWN
if eq st LC_SERVE
lc_drop_task
end
put lc_cnt LC_C_STATE LC_QUIESCE
ret LC_R_STOP
end
ret lc_apply_ready_verbs verb arg st
end

fn lc_commit_done rc int to void
if ne get lc_cnt LC_C_STATE LC_SERVE
ret
end
if eq rc 0
put lc_cnt LC_C_APPROVED add get lc_cnt LC_C_APPROVED 1
lc_drop_task
put lc_cnt LC_C_STATE LC_READY
else
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
end
end

fn lc_commit_replay to void
if ne get lc_cnt LC_C_STATE LC_SERVE
ret
end
put lc_cnt LC_C_REPLAYS add get lc_cnt LC_C_REPLAYS 1
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
lc_drop_task
put lc_cnt LC_C_STATE LC_READY
end

fn lc_commit_refused to void
if ne get lc_cnt LC_C_STATE LC_SERVE
ret
end
put lc_cnt LC_C_BIND_REF add get lc_cnt LC_C_BIND_REF 1
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
end

fn lc_unlock_done opened bool to void
if ne get lc_cnt LC_C_STATE LC_LOCKED
ret
end
if opened
put lc_cnt LC_C_STATE LC_READY
else
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
end
end

fn lc_rotate_done ok bool to void
if ne get lc_cnt LC_C_STATE LC_READY
ret
end
if not ok
put lc_cnt LC_C_REFUSED add get lc_cnt LC_C_REFUSED 1
end
end

fn lc_generate_done outcome uint reply view uchar * to void
if or ne get lc_cnt LC_C_STATE LC_READY eq get lc_cnt LC_C_TASK_LEN 0
ret
end
rlen = len reply
if and eq outcome LC_GEN_REPLY and gt rlen 0 le rlen LC_REPLY_MAX
i = ulong 0
while lt i rlen bound 1536
put lc_reply i get reply i
i = add i 1
end
put lc_cnt LC_C_REPLY_LEN uint rlen
put lc_cnt LC_C_PENDING LC_PENDING_REPLY
put lc_cnt LC_C_REPLIES add get lc_cnt LC_C_REPLIES 1
put lc_cnt LC_C_STATE LC_SERVE
ret
end
if eq outcome LC_GEN_CANCELLED
put lc_cnt LC_C_GEN_CANCEL add get lc_cnt LC_C_GEN_CANCEL 1
else
put lc_cnt LC_C_GEN_FAIL add get lc_cnt LC_C_GEN_FAIL 1
end
lc_drop_task
end

fn lc_stopped to void
put lc_cnt LC_C_STATE LC_STOP
end

fn lc_get_cnt idx ulong to uint
if ge idx 24
ret 0
end
ret get lc_cnt idx
end

note aienux/kernel/arm64/fwops.om: Pure-Omega AArch64 bare-metal primitives over target a64efi fwop/fwsys.
note Requires: target a64efi, om2.

const FWOP_DSB_SY ulong 0
const FWOP_DSB_ISH ulong 1
const FWOP_ISB ulong 2
const FWOP_TLBI_VMALLE1IS ulong 3
const FWOP_DC_CIVAC ulong 4
const FWOP_DC_CVAC ulong 5
const FWOP_IC_IALLU ulong 6
const FWOP_DAIF_MASK ulong 7
const FWOP_IRQ_UNMASK ulong 8
const FWOP_WFE ulong 9
const FWOP_SEV ulong 10
const FWOP_WFI ulong 11
const FWOP_SYSRD ulong 16
const FWOP_SYSWR ulong 17
const FWOP_SMC ulong 18
const FWOP_HVC ulong 19
const FWOP_EL2_TO_EL1 ulong 20
const FWOP_EL1_SWITCH ulong 21
const FWOP_META ulong 22
const FWOP_POST_EBS_SET ulong 23
const FWOP_PSCI_CPU_ON_SMC ulong 26
const FWOP_PSCI_CPU_ON_HVC ulong 27
const FWOP_LDAR ulong 28
const FWOP_STLR ulong 29

const SYSREG_CURRENTEL ulong 0
const SYSREG_MPIDR_EL1 ulong 1
const SYSREG_CTR_EL0 ulong 2
const SYSREG_ID_AA64MMFR0 ulong 3
const SYSREG_ID_AA64PFR0 ulong 4
const SYSREG_SCTLR_EL1 ulong 5
const SYSREG_TTBR0_EL1 ulong 6
const SYSREG_TCR_EL1 ulong 7
const SYSREG_MAIR_EL1 ulong 8
const SYSREG_VBAR_EL1 ulong 9
const SYSREG_ICC_SRE_EL1 ulong 10
const SYSREG_ICC_IAR1_EL1 ulong 11
const SYSREG_ICC_EOIR1_EL1 ulong 11
const SYSREG_ICC_PMR_EL1 ulong 12
const SYSREG_ICC_BPR1_EL1 ulong 13
const SYSREG_ICC_IGRPEN1_EL1 ulong 14
const SYSREG_ICC_CTLR_EL1 ulong 15
const SYSREG_HCR_EL2 ulong 16
const SYSREG_SCTLR_EL2 ulong 17
const SYSREG_TTBR0_EL2 ulong 18
const SYSREG_ICC_SRE_EL2 ulong 19
const SYSREG_ESR_EL1 ulong 20
const SYSREG_ELR_EL1 ulong 21
const SYSREG_FAR_EL1 ulong 22
const SYSREG_DAIF ulong 23
const SYSREG_SP ulong 24
const SYSREG_CNTP_CTL_EL0 ulong 25
const SYSREG_CNTP_TVAL_EL0 ulong 26

const PSCI_CONDUIT_NONE ulong 0
const PSCI_CONDUIT_SMC ulong 1
const PSCI_CONDUIT_HVC ulong 2
const PSCI_VERSION ulong 0x84000000
const PSCI_SYSTEM_RESET ulong 0x84000009
const PSCI_CPU_ON_64 ulong 0xc4000003

const ARM64_MPIDR_AFF_MASK ulong 0x000000ff00ffffff

fn arm64_dsb_sy to void
x = fwop FWOP_DSB_SY 0 0 0
end

fn arm64_dsb_ish to void
x = fwop FWOP_DSB_ISH 0 0 0
end

fn arm64_isb to void
x = fwop FWOP_ISB 0 0 0
end

fn arm64_tlbi_vmalle1is to void
x = fwop FWOP_TLBI_VMALLE1IS 0 0 0
end

fn arm64_daif_mask to void
x = fwop FWOP_DAIF_MASK 0 0 0
end

fn arm64_irq_unmask to void
x = fwop FWOP_IRQ_UNMASK 0 0 0
end

fn arm64_wfe to void
x = fwop FWOP_WFE 0 0 0
end

fn arm64_sev to void
x = fwop FWOP_SEV 0 0 0
end

fn arm64_sysrd reg ulong to ulong
ret fwop FWOP_SYSRD reg 0 0
end

fn arm64_syswr reg ulong val ulong to void
x = fwop FWOP_SYSWR reg val 0
end

fn arm64_current_el to ulong
ret and shr arm64_sysrd SYSREG_CURRENTEL 2 3
end

fn arm64_mpidr_aff to ulong
ret and arm64_sysrd SYSREG_MPIDR_EL1 ARM64_MPIDR_AFF_MASK
end

fn arm64_dcache_line_bytes to ulong
ctr = arm64_sysrd SYSREG_CTR_EL0
dmin = and shr ctr 16 15
if gt dmin 12
ret 64
end
ret shl ulong 4 dmin
end

note Clean and invalidate [pa, pa + n) to Point of Coherency (DC CIVAC + DSB SY).
fn arm64_dc_civac_range pa ulong n ulong to void
if eq n 0
ret
end
if gt n sub 0xffffffffffffffff pa
ret
end
line = arm64_dcache_line_bytes
mask = sub line 1
a = and pa xor 0xffffffffffffffff mask
end_pa = add pa n
note Bound 16777216 lines covers up to 1 GiB @ 64-byte cache lines.
while lt a end_pa bound 16777216
x = fwop FWOP_DC_CIVAC a 0 0
if gt line sub 0xffffffffffffffff a
break
end
a = add a line
end
arm64_dsb_sy
end

note Clean [pa, pa + n) to Point of Coherency (DC CVAC + DSB SY) before SMP CPU_ON.
fn arm64_dc_cvac_range pa ulong n ulong to void
if eq n 0
ret
end
if gt n sub 0xffffffffffffffff pa
ret
end
line = arm64_dcache_line_bytes
mask = sub line 1
a = and pa xor 0xffffffffffffffff mask
end_pa = add pa n
while lt a end_pa bound 16777216
x = fwop FWOP_DC_CVAC a 0 0
if gt line sub 0xffffffffffffffff a
break
end
a = add a line
end
arm64_dsb_sy
end

fn arm64_ldar addr ulong to ulong
ret fwop FWOP_LDAR addr 0 0
end

fn arm64_stlr addr ulong val ulong to void
x = fwop FWOP_STLR addr val 0
end

fn arm64_meta key ulong to ulong
ret fwop FWOP_META key 0 0
end

fn arm64_post_ebs_set uart_pa ulong conduit ulong to void
x = fwop FWOP_POST_EBS_SET uart_pa conduit 0
end

fn arm64_psci_call conduit ulong fid ulong a1 ulong a2 ulong to ulong
if eq conduit PSCI_CONDUIT_SMC
ret fwop FWOP_SMC fid a1 a2
end
if eq conduit PSCI_CONDUIT_HVC
ret fwop FWOP_HVC fid a1 a2
end
ret 0xffffffffffffffff
end

fn arm64_psci_cpu_on conduit ulong mpidr ulong entry ulong ctx ulong to ulong
if eq conduit PSCI_CONDUIT_SMC
ret fwop FWOP_PSCI_CPU_ON_SMC mpidr entry ctx
end
if eq conduit PSCI_CONDUIT_HVC
ret fwop FWOP_PSCI_CPU_ON_HVC mpidr entry ctx
end
ret 0xffffffffffffffff
end

fn arm64_psci_reset conduit ulong to void
x = arm64_psci_call conduit PSCI_SYSTEM_RESET 0 0
end

note Overflow-safe CNTVCT_EL0 monotonic clock helpers (shared contract for Pieces 1-6).
fn arm64_ticks_to_ms t ulong frq ulong to ulong
if lt frq 1000
ret 0
end
sec = div t frq
rem_t = rem t frq
if gt rem_t 18446744073709551
ret add mul sec 1000 div rem_t div frq 1000
end
ret add mul sec 1000 div mul rem_t 1000 frq
end

fn arm64_ticks_to_us t ulong frq ulong to ulong
if lt frq 1000000
ret 0
end
sec = div t frq
rem_t = rem t frq
if gt rem_t 18446744073709
ret add mul sec 1000000 div rem_t div frq 1000000
end
ret add mul sec 1000000 div mul rem_t 1000000 frq
end

fn arm64_time_ms to ulong
ret arm64_ticks_to_ms fwsys 2 fwsys 3
end

fn arm64_time_us to ulong
ret arm64_ticks_to_us fwsys 2 fwsys 3
end

fn arm64_deadline_ticks ms ulong to ulong
frq = fwsys 3
now = fwsys 2
if eq frq 0
ret now
end
secs = div ms 1000
rem_ms = rem ms 1000
delta = add mul secs frq div mul rem_ms frq 1000
ret add now delta
end

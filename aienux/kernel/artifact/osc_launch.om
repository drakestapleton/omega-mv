note SPDX-License-Identifier: Apache-2.0
note aienux/kernel/artifact/osc_launch.om: Pure-Omega OSC Unit EL0 Launch Contract
note (argument shape & aliasing, range ownership, stack/workspace/tick budgets, SVC/fault classification).
note Converted from upstream aienux native/kernel/artifact/osc_launch.h and osc_launch.c.

struct OscWindows in_va ulong in_len ulong ws_va ulong ws_len ulong end

struct OscEvent kind uint esr ulong elr ulong x0 ulong x1 ulong end

struct OscResult cls uchar trap_code uchar unknown_reason uchar refused_code uchar val ulong ticks ulong end

const OSC_MAXR ulong 6
const OSC_RT_SERVICES ulong 13
const OSC_SVC_TRAP ulong 2
const OSC_SVC_RETURN ulong 13
const OSC_RT_STUBS ulong 14
const OSC_RT_STUB_BYTES ulong 8
const OSC_TRAP_MAX ulong 14
const OSC_WS_MAX_PAGES ulong 32
const OSC_U64_MAX ulong 0xffffffffffffffff
const OSC_U64_MAX_DIV8 ulong 0x1fffffffffffffff

note Section 9.3 closed result classes
const OSC_RES_RETURNED uchar 1
const OSC_RES_TRAPPED uchar 2
const OSC_RES_REFUSED uchar 3
const OSC_RES_UNKNOWN uchar 4

note Diagnostic unknown_reason codes
const OSC_UNK_FAULT uchar 1
const OSC_UNK_TICK_OVERRUN uchar 2
const OSC_UNK_LAUNCH_LOST uchar 3
const OSC_UNK_TRAP_CODE_UNKNOWN uchar 4
const OSC_UNK_OTHER uchar 255

note Observed kernel event kinds
const OSC_EV_SVC uint 1
const OSC_EV_SYNC uint 2
const OSC_EV_BUDGET uint 3
const OSC_EV_LOST uint 4

fn osc_is_slice k uchar to bool
ret or eq k 11 eq k 12
end

fn osc_fits k uchar v ulong to bool
if eq k 1
ret le v 1
end
if eq k 2
ret le v 0xff
end
if eq k 3
ret le v 0xffff
end
if eq k 4
ret le v 0xffffffff
end
if eq k 6
ret or le v 0x7f ge v 0xffffffffffffff80
end
if eq k 7
ret or le v 0x7fff ge v 0xffffffffffff8000
end
if eq k 8
ret or le v 0x7fffffff ge v 0xffffffff80000000
end
ret true
end

fn osc_pair_overlaps ptr ulong sz ulong kq uchar qptr ulong qn ulong to bool
if or eq sz 0 eq qn 0
ret false
end
if and eq kq 12 gt qn OSC_U64_MAX_DIV8
ret false
end
qsz = qn
if eq kq 12
qsz = mul qn 8
end
if gt qsz sub OSC_U64_MAX qptr
ret false
end
ret and lt ptr add qptr qsz lt qptr add ptr sz
end

fn osc_slice_overlaps kinds view uchar 6 nregs ulong args view ulong 6 p ulong to bool
kp = get kinds p
ptr = get args p
sz = get args add p 1
if eq kp 12
sz = mul sz 8
end
q = ulong 0
while lt add q 1 nregs bound 6
if ne q p
kq = get kinds q
if osc_is_slice kq
if or eq kp 12 eq kq 12
if osc_pair_overlaps ptr sz kq get args q get args add q 1
ret true
end
end
end
end
q = add q 1
end
ret false
end

fn osc_launch_args_ok kinds view uchar 6 nregs ulong args view ulong 6 nargs ulong to bool
if or gt nregs OSC_MAXR ne nargs nregs
ret false
end
p = ulong 0
while lt p nregs bound 6
kp = get kinds p
if not osc_is_slice kp
if not osc_fits kp get args p
ret false
end
end
p = add p 1
end
p = ulong 0
while lt add p 1 nregs bound 6
kp = get kinds p
if osc_is_slice kp
ptr = get args p
n = get args add p 1
if eq kp 12
if gt n OSC_U64_MAX_DIV8
ret false
end
if and ne n 0 ne and ptr 7 0
ret false
end
end
sz = n
if eq kp 12
sz = mul n 8
end
if and ne n 0 eq ptr 0
ret false
end
if gt sz sub OSC_U64_MAX ptr
ret false
end
if osc_slice_overlaps kinds nregs args p
ret false
end
end
p = add p 1
end
ret true
end

fn osc_inside ptr ulong sz ulong base ulong wlen ulong to bool
if lt ptr base
ret false
end
off = sub ptr base
if gt off wlen
ret false
end
ret le sz sub wlen off
end

fn osc_launch_ranges_owned kinds view uchar 6 nregs ulong args view ulong 6 win view OscWindows to bool
p = ulong 0
while lt add p 1 nregs bound 6
kp = get kinds p
if osc_is_slice kp
ptr = get args p
n = get args add p 1
if ne n 0
if eq kp 12
if gt n OSC_U64_MAX_DIV8
ret false
end
if not osc_inside ptr mul n 8 get win ws_va get win ws_len
ret false
end
else
if not osc_inside ptr n get win in_va get win in_len
ret false
end
end
end
end
p = add p 1
end
ret true
end

fn osc_launch_disjoint a ulong alen ulong b ulong blen ulong to bool
if or eq alen 0 eq blen 0
ret true
end
aend = add a alen
bend = add b blen
if or lt aend a lt bend b
ret false
end
ret or le aend b le bend a
end

fn osc_launch_stack_ok declared ulong hard_max ulong to bool
ret le declared hard_max
end

fn osc_launch_ws_pages_ok pages ulong to bool
ret le pages OSC_WS_MAX_PAGES
end

fn osc_launch_budget unit_ticks ulong caller_cap ulong to ulong
if and ne caller_cap 0 lt caller_cap unit_ticks
ret caller_cap
end
ret unit_ticks
end

fn osc_launch_budget_expired seen ulong budget ulong to bool
ret ge seen budget
end

fn osc_fault_class ec ulong to bool
if or eq ec 0x00 or eq ec 0x07 or eq ec 0x0e eq ec 0x18
ret true
end
if or eq ec 0x20 or eq ec 0x22 or eq ec 0x24 or eq ec 0x26 eq ec 0x3c
ret true
end
ret false
end

fn osc_set_unknown r edit OscResult why uchar to void
put r cls OSC_RES_UNKNOWN
put r unknown_reason why
end

fn osc_launch_classify e view OscEvent rt_code_va ulong r edit OscResult to void
put r cls 0
put r trap_code 0
put r unknown_reason 0
put r refused_code 0
put r val 0
k = get e kind
if eq k OSC_EV_SVC
esr = get e esr
elr = get e elr
ec = and shr esr 26 0x3f
imm = and esr 0xffff
if or ne ec 0x15 lt elr 4
osc_set_unknown r OSC_UNK_FAULT
ret
end
site = sub elr 4
if lt site rt_code_va
osc_set_unknown r OSC_UNK_FAULT
ret
end
off = sub site rt_code_va
lim = mul OSC_RT_STUBS OSC_RT_STUB_BYTES
if ge off lim
osc_set_unknown r OSC_UNK_FAULT
ret
end
if ne rem off OSC_RT_STUB_BYTES 0
osc_set_unknown r OSC_UNK_FAULT
ret
end
if ne imm div off OSC_RT_STUB_BYTES
osc_set_unknown r OSC_UNK_FAULT
ret
end
if eq imm OSC_SVC_RETURN
put r cls OSC_RES_RETURNED
put r val get e x0
ret
end
if eq imm OSC_SVC_TRAP
x1 = get e x1
if and ge x1 1 le x1 OSC_TRAP_MAX
put r cls OSC_RES_TRAPPED
put r trap_code uchar x1
else
osc_set_unknown r OSC_UNK_TRAP_CODE_UNKNOWN
end
ret
end
osc_set_unknown r OSC_UNK_OTHER
ret
end
if eq k OSC_EV_SYNC
ec = and shr get e esr 26 0x3f
if osc_fault_class ec
osc_set_unknown r OSC_UNK_FAULT
else
osc_set_unknown r OSC_UNK_OTHER
end
ret
end
if eq k OSC_EV_BUDGET
osc_set_unknown r OSC_UNK_TICK_OVERRUN
ret
end
if eq k OSC_EV_LOST
osc_set_unknown r OSC_UNK_LAUNCH_LOST
ret
end
osc_set_unknown r OSC_UNK_OTHER
end

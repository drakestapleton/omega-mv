note hostile probe: print every environment entry and the count
text m1 "env "
text nl "\n"
fn main to int
b = new uchar 4096 0
d = new uchar 4 0
c = envcnt
for i ulong ulong c bound 4096
n = envread i b 0 4096
if gt n 0
k = write 1 b 0 ulong n
k = write 1 nl 0 len nl
end
end
k = write 1 m1 0 len m1
put d 0 uchar add 48 rem ulong c 10
k = write 1 d 0 1
k = write 1 nl 0 len nl
ret 0
end

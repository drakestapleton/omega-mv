note hostile probe: create the file named on stdin and write to it; prints the open result
text m1 "open "
text m2 "wrote\n"
text nl "\n"
fn main to int
p = new uchar 512 0
n = read 0 p 0 511
if le n 1
ret 2
end
m = sub ulong n 1
fd = fopen p 0 m 577 420
k = write 1 m1 0 len m1
if lt fd 0
put p 0 45
put p 1 49
k = write 1 p 0 2
k = write 1 nl 0 len nl
ret 0
end
k = write int fd m2 0 len m2
k = write 1 m2 0 len m2
ret 0
end

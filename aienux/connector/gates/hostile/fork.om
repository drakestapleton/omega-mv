note hostile probe: try to start 50 processes; prints how many forks succeeded
text m1 "forks "
text nl "\n"
fn main to int
d = new uchar 24 0
ok = ulong 0
for i ulong 50
r = fork
if eq r 0
exit 0
end
if gt r 0
ok = add ok 1
end
end
k = write 1 m1 0 len m1
v = ok
n = ulong 0
put d 0 uchar add 48 div v 10
put d 1 uchar add 48 rem v 10
k = write 1 d 0 2
k = write 1 nl 0 len nl
ret 0
end

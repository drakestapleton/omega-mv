note hostile probe: connect to 127.0.0.1:PORT (decimal on stdin) and send an HTTP request
text m1 "socket -1\n"
text m2 "connect failed\n"
text m3 "sent\n"
text rq "GET /community/netprobe HTTP/1.0"
fn main to int
p = new uchar 16 0
a = new uchar 16 0
e = new uchar 4 0
n = read 0 p 0 16
v = ulong 0
for i ulong 16
if ge i ulong n
break
end
c = get p i
if and ge c 48 le c 57
v = add mul v 10 sub ulong c 48
end
end
fd = socknew 2 1 0
if lt fd 0
k = write 1 m1 0 len m1
ret 0
end
put a 0 2
put a 2 uchar shr v 8
put a 3 uchar and v 255
put a 4 127
put a 7 1
r = connect int fd a 0 16
if lt r 0
k = write 1 m2 0 len m2
ret 0
end
put e 0 13
put e 1 10
put e 2 13
put e 3 10
k = write int fd rq 0 len rq
k = write int fd e 0 4
k = write 1 m3 0 len m3
ret 0
end

note gates/celldrv.om -- test tool (never shipped): run the runner's own cell code (runner/30cell.om,
note r_check) on one job directory, as a job would.
note Composed: om2, om/tls sha2, runner/00base.om, runner/30cell.om, this unit.
note argv: job directory holding source.om and stdin. The compiler is <state>/bin/omc
note (state = $INTERPLANE_RUNNER_HOME). Prints "exit <outcome> binary <hex> stdout <hex>".
text cdusage "usage: celldrv JOBDIR\n"
text cdex "exit "
text cdbin " binary "
text cdout " stdout "
text cdfail "celldrv: a stage could not be started\n"

fn main to int
p = new uchar 4096 0
if ne argcnt 2
r_say cdusage
ret 2
end
if not r_home
ret 2
end
n = argread 1 p 0 4000
if le n 0
ret 2
end
for i ulong ulong n bound 4096
put rjd i get p i
end
put rgv rjdl ulong n
if not r_check
r_say cdfail
ret 3
end
r_say cdex
w = write 1 rjf rfexit get rgv rexl
r_say cdbin
w = write 1 rjf rfbin 64
r_say cdout
w = write 1 rjf rfout 64
r_say rtnl
ret 0
end

note gates/signer.om -- test tool (never shipped): sign or make keys exactly as the runner does.
note Composed: om2, om/tls sha2 ec ecdh, runner/00base.om, runner/10key.om, this unit.
note   signer gen     make <state>/key (state = $INTERPLANE_RUNNER_HOME); print pub hex and key id
note   signer pub     print pub hex and key id of the existing key
note   signer sign    read a message (every line before "sig") on stdin, print it with its sig line
text sgusage "usage: signer gen | pub | sign\n"
text sggen "gen"
text sgpub "pub"
text sgsign "sign"
text sgsig "sig "

fn sg_show to void
w = write 1 rpubh 0 130
r_say rtsp
w = write 1 rkid 0 64
r_say rtnl
end

fn main to int
a = new uchar 16 0
m = new uchar 8192 0
sg = new uchar 128 0
if ne argcnt 2
r_say sgusage
ret 2
end
n = argread 1 a 0 16
if not r_home
ret 2
end
if r_eq part a 0 ulong n sggen
if not r_kgen
ret 3
end
sg_show
ret 0
end
if not r_kload
ret 3
end
if r_eq part a 0 ulong n sgpub
sg_show
ret 0
end
if not r_eq part a 0 ulong n sgsign
r_say sgusage
ret 2
end
k = ulong 0
while lt k 8192 bound 8193
r = read 0 m k sub 8192 k
if le r 0
break
end
k = add k ulong r
end
if not r_ksign part m 0 k sg
ret 3
end
w = write 1 m 0 k
r_say sgsig
w = write 1 sg 0 128
r_say rtnl
ret 0
end

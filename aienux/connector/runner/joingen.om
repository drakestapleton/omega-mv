note runner/joingen.om -- writes the join script (dist/join.sh) the hub serves at /community/join.
note argv: hub URL, sha256 of interplane-runner, sha256 of omc. The script only downloads the two
note files by their hashes, checks the hashes, prints them with where to compare them, and runs
note `interplane-runner join`, which explains what it will do and asks before anything is registered.
note On a computer that is not Linux on aarch64 it says so and installs nothing.
text jgusage "usage: joingen HUB RUNNER_SHA256 OMC_SHA256\n"
text jg1 "#!/bin/sh\n# Interplane runner: join this computer to Interplane's community machines.\n# Read it first. Generated by spark-connector runner/joingen.om (rad:z2LKDxnAK3EFfqgr7HTZh6djts65P).\n# It downloads two files, checks their SHA-256, and starts `interplane-runner join`, which explains\n# what it will do and asks for a yes before anything is registered.\nset -eu\nhub='"
text jg2 "'\nd=\"$HOME/.interplane-runner\"\nif [ \"$(uname -s)\" != Linux ] || [ \"$(uname -m)\" != aarch64 ]; then\n  echo \"The Interplane runner needs Linux on 64-bit ARM (aarch64), like an NVIDIA DGX Spark. This computer is $(uname -s) $(uname -m). Nothing was installed.\"\n  exit 1\nfi\nif [ -e \"$d/key\" ]; then exec \"$d/bin/interplane-runner\" status; fi\nmkdir -p \"$d/bin\"\nchmod 700 \"$d\"\nget() {\n  if curl -fsSL -o \"$d/bin/$1.part\" \"$hub/community/dl/$1-$2\" && [ \"$(sha256sum < \"$d/bin/$1.part\" | cut -d' ' -f1)\" = \"$2\" ]; then\n    chmod 700 \"$d/bin/$1.part\"; mv \"$d/bin/$1.part\" \"$d/bin/$1\"\n  else\n    rm -rf \"$d\"; echo \"The download of $1 failed or its SHA-256 was not $2. Nothing was installed.\"; exit 1\n  fi\n}\nget interplane-runner "
text jg3 "\nget omc "
text jg4 "\necho \"Downloaded and checked:\"\necho \"  interplane-runner  sha256 "
text jg5 "\"\necho \"  omc                sha256 "
text jg6 "\"\necho \"Compare them with $hub/community/ (Files and fingerprints) and with SHA256SUMS in the\"\necho \"runner's source, rad:z2LKDxnAK3EFfqgr7HTZh6djts65P.\"\nif (exec < /dev/tty) 2> /dev/null; then exec \"$d/bin/interplane-runner\" join \"$hub\" < /dev/tty; fi\nexec \"$d/bin/interplane-runner\" join \"$hub\"\n"

fn jg_ok s view uchar * hex bool to bool
if or eq len s 0 gt len s 300
ret false
end
for i ulong len s bound 512
c = get s i
lo = or and ge c 97 le c 122 and ge c 48 le c 57
if hex
if not and lo not and ge c 103 le c 122
ret false
end
else
if not or lo or or eq c 46 eq c 45 or eq c 58 eq c 47
ret false
end
end
end
ret true
end

fn main to int
h = new uchar 512 0
r = new uchar 80 0
o = new uchar 80 0
if ne argcnt 4
w = write 2 jgusage 0 len jgusage
ret 2
end
hn = argread 1 h 0 400
rn = argread 2 r 0 80
on = argread 3 o 0 80
if or or le hn 0 ne rn 64 ne on 64
ret 2
end
if not and jg_ok part h 0 ulong hn false and jg_ok part r 0 64 true jg_ok part o 0 64 true
ret 2
end
w = write 1 jg1 0 len jg1
w = write 1 h 0 ulong hn
w = write 1 jg2 0 len jg2
w = write 1 r 0 64
w = write 1 jg3 0 len jg3
w = write 1 o 0 64
w = write 1 jg4 0 len jg4
w = write 1 r 0 64
w = write 1 jg5 0 len jg5
w = write 1 o 0 64
w = write 1 jg6 0 len jg6
ret 0
end

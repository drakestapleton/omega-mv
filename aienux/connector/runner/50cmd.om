note runner/50cmd.om -- the commands: join, start, stop, status, set rate N, leave, once, selftest.
note The background runner is this program: start forks, the child calls setsid and becomes the
note supervisor (r_loop). For each cycle the supervisor forks a worker that does one job (r_job) and
note exits; a worker that dies takes nothing else with it. There is no systemd unit and no cron:
note after the computer restarts, `interplane-runner start` runs it again.

text rtset "settings"
text rtpid "runner.pid"
text rtlog "log"
text rtlog1 "log.1"
text rtbin "bin"
text rtdefh "https://interplane.io"
text rthubk "hub "
text rtratek "rate "
text rtregn "register"
text rtpubn "pub"
text rtraten "rate"
text rtleave "leave"
text rtokreg "ipcc1 ok registered\n"
text rtokleft "ipcc1 ok left\n"
text rtdevnul "/dev/null"
text rtself "/proc/self/exe"
text rtproc "/proc/"
text rtexe "/exe"
text rtselfn "selftest"
text rtselfs "text m \"interplane cell ok\\n\"\nfn main to int\nk = write 1 m 0 len m\nret 0\nend\n"
text rtselfo "interplane cell ok\n"
text rtexit0 "0"

text rtusage "usage: interplane-runner join [HUB] | start | stop | status | set rate N | leave | once | selftest\n"
text rtnohome "interplane-runner: HOME is not set to an absolute path\n"

text rtj1 "\nInterplane runner: what joining does to this computer\n\nThis computer will check small public programs that people share on Interplane, and tell\nInterplane what it got, so anyone can see whether the result is the same on other machines.\n\n- It asks "
text rtj2 " for work. Nothing from outside can connect to this computer.\n- Each check builds one small public Omega program and runs its example in a sealed box:\n  no network, none of your files, no environment variables, no GPU, no other programs.\n- Each check takes at most 2 seconds of one CPU core to build and 2 to run, 128 MiB of memory,\n  1 MiB of output, and 3 seconds of clock time for each of the two steps. These are fixed.\n- Everything it keeps is in "
text rtj3 " (under 10 MiB).\n- It makes a key here. The secret part never leaves this computer; Interplane only sees\n  the public part, which is how your results are told apart from everyone else's.\n\nYour setting: at most "
text rtj4 " checks an hour, so at most "
text rtj5 " CPU-seconds an hour. Change it at any time\n(0 pauses):  "
text rtj6 "/bin/interplane-runner set rate N\n\nStop:                         "
text rtj7 "/bin/interplane-runner stop\nLeave and remove everything:  "
text rtj8 "/bin/interplane-runner leave\nIt does not start by itself after this computer restarts; to go on, run\n  "
text rtj9 "/bin/interplane-runner start\n\nType yes and press Enter to join. Anything else cancels and removes what was downloaded.\n> "
text rtjcan "Cancelled. Nothing was registered, and "
text rtjcan2 " was removed.\n"
text rtjok "\nJoined. This computer's key fingerprint (its public name on Interplane):\n  "
text rtjok2 "\nIts checks will be listed at "
text rtjok3 "/community/\nThe runner is working in the background now.\n"
text rtjalr "This computer has already joined.\n"
text rtjcell "This computer cannot run the sealed box (it needs Linux 6.2 or newer with Landlock, on 64-bit ARM).\nNothing was registered, and the downloaded files were removed.\n"
text rtjomc "The downloaded compiler is not the one Interplane pins (omc sha256 3ad9f10f...). Nothing was registered.\n"
text rtjreg "Interplane did not accept the registration: "
text rtjreg2 "Nothing is left on this computer.\n"
text rtjkey "Could not make the key. Nothing was registered.\n"
text rtjhub "The hub address is not valid.\n"
text rtst1 "Interplane runner\nfolder:  "
text rtst2 "\nkey:     "
text rtst3 "\nhub:     "
text rtst4 "\nsetting: at most "
text rtst5 " checks an hour (0 = paused)\nrunning: "
text rtyes "yes, process "
text rtno "no\n"
text rtnotj "Interplane runner: this computer has not joined.\n"
text rtstop "Stopped. Start again with: "
text rtstop2 "/bin/interplane-runner start\n"
text rtstrt "Running in the background, process "
text rtstrtf "Could not start the background runner.\n"
text rtsetok "Setting saved: at most "
text rtsetok2 " checks an hour.\n"
text rtsetbad "The rate must be a whole number from 0 to 3600.\n"
text rtleft "Left Interplane. Removed "
text rtleft2 "\nInterplane could not be told (the result list keeps the key, which can do nothing more without\nthis computer's secret part, now deleted).\n"
text rtselok "cell self-test: pass\n"
text rtselno "cell self-test: FAIL\n"

note ---- settings: "hub <url>\nrate <n>\n"
fn r_setsave to bool
d = new uchar 1024 0
u = new uchar 512 0
n = get rgv rhubl
for i ulong n bound 512
put u i get rhub i
end
k = r_cp d 0 rthubk
k = r_cp d k part u 0 n
k = r_cp d k rtnl
k = r_cp d k rtratek
k = r_dec d k get rgv rrate
k = r_cp d k rtnl
x = r_path rtset
ret r_replace part d 0 k
end

fn r_setload to bool
d = new uchar 1024 0
x = r_path rtset
r = r_rd d
if lt r 0
ret false
end
n = ulong r
e = ulong 0
while lt e n bound 1024
if eq get d e 10
break
end
e = add e 1
end
if or ge e n le e len rthubk
ret false
end
if not r_eq part d 0 len rthubk rthubk
ret false
end
if not r_hubset part d len rthubk sub e len rthubk
ret false
end
s = add e 1
f = s
while lt f n bound 1024
if eq get d f 10
break
end
f = add f 1
end
if or ge f n le sub f s len rtratek
ret false
end
if not r_eq part d s len rtratek rtratek
ret false
end
v = r_undec part d add s len rtratek sub sub f s len rtratek
if gt v 3600
ret false
end
put rgv rrate v
ret true
end

note ---- processes
fn r_say_dir to void
w = write 1 rhm 0 get rgv rhml
end

note r_exe: readlink of path p into o; its length or 0
fn r_exe p view uchar * o edit uchar * to ulong
r = readlnk p 0 len p o 0 len o
if or le r 0 ge r long len o
ret 0
end
ret ulong r
end

note r_isours: pid is a running interplane-runner from this same executable
fn r_isours pid ulong to bool
p = new uchar 64 0
a = new uchar 4096 0
b = new uchar 4096 0
k = r_cp p 0 rtproc
k = r_dec p k pid
k = r_cp p k rtexe
n = r_exe part p 0 k a
m = r_exe rtself b
if or eq n 0 eq m 0
ret false
end
ret r_eq part a 0 n part b 0 m
end

note r_pidget: the pid in runner.pid, 0 when there is none or it is not a running runner
fn r_pidget to ulong
b = new uchar 32 0
n = r_path rtpid
r = r_rd b
if le r 0
ret 0
end
v = r_undec part b 0 ulong r
if or eq v 0 gt v 4194304
ret 0
end
if not r_isours v
ret 0
end
ret v
end

fn r_stop to void
pid = r_pidget
if ne pid 0
x = killpid int neg long pid 15
for i ulong 100
if ne killpid int pid 0 0
break
end
x = sleepns 50000000
end
if eq killpid int pid 0 0
x = killpid int neg long pid 9
x = sleepns 200000000
end
end
n = r_path rtpid
x = unlink rph 0 n
end

note r_bgio: descriptors 0..2 of the background runner: /dev/null, then the log twice
fn r_bgio to void
fd = fopen rtdevnul 0 len rtdevnul 524290 0
if ge fd 0
x = dupfd int fd 0 0
x = fclose int fd
end
n = r_path rtlog
fd = fopen rph 0 n rfoapp 384
if ge fd 0
x = dupfd int fd 1 0
x = dupfd int fd 2 0
x = fclose int fd
end
end

note r_logrot: when the log passes 1 MiB, it becomes log.1 (replacing the older one) and a new log
note starts; the volunteer was promised a bounded folder
fn r_logrot to void
sb = new uchar 128 0
r = fstat 1 sb 0 128
if lt r 0
ret
end
sz = ulong 0
for i ulong 8
sz = or sz shl ulong get sb add 48 i mul i 8
end
if le sz 1048576
ret
end
a = new uchar 4100 0
b = new uchar 4100 0
p = new uchar 8300 0
x = r_path rtlog
na = r_phcp a
x = r_path rtlog1
nb = r_phcp b
put p 0 2
put p 1 0
k = r_pk p 2 part a 0 na
k = r_pk p k part b 0 nb
r = renames p 0 k 0
r_bgio
end

note r_wpid: write this process's id to runner.pid
fn r_wpid to bool
d = new uchar 24 0
k = r_dec d 0 ulong getpid
x = r_path rtpid
ret r_replace part d 0 k
end

note r_loop: the supervisor. One worker per cycle; the wait after it follows the volunteer's rate:
note after a counted result 3600/rate seconds, after "no work" at least 600 s, after an error a
note backoff that doubles from 60 s to 3600 s. Rate 0 pauses (checked again every 60 s).
fn r_loop to int
st = new uchar 4 0
back = ulong 60
while true bound 9223372036854775807
r_logrot
if not r_setload
ret 0
end
rate = get rgv rrate
if eq rate 0
x = sleepns 60000000000
continue
end
pid = fork
if eq pid 0
c = r_job
exit int c
end
c = ulong 2
if gt pid 0
w = waitpid int pid st 0 4 0
s = r_u32 st 0
if eq and s 127 0
c = and shr s 8 255
end
end
iv = div 3600 rate
wt = iv
if eq c 0
back = 60
end
if eq c 1
back = 60
if lt wt 600
wt = 600
end
end
if gt c 1
if lt wt back
wt = back
end
back = mul back 2
if gt back 3600
back = 3600
end
end
x = sleepns long mul wt 1000000000
end
ret 0
end

note r_start: the background runner (needs the key and settings)
fn r_start to bool
old = r_pidget
if ne old 0
r_say rtstrt
r_num old
r_say rtnl
ret true
end
pid = fork
if lt pid 0
ret false
end
if eq pid 0
x = setsid
r_bgio
if not r_wpid
exit 1
end
c = r_loop
exit c
end
for i ulong 40
x = sleepns 50000000
if eq r_pidget ulong pid
r_say rtstrt
r_num ulong pid
r_say rtnl
ret true
end
end
ret false
end

note ---- hub messages
fn r_register to long
r_mbeg rtregn
p = new uchar 130 0
for i ulong 130
put p i get rpubh i
end
r_mline rtpubn p
r_mtime
r_mnum rtraten get rgv rrate
if not r_msign
ret -1
end
ret r_post
end

fn r_sayleave to long
r_mbeg rtleave
r_mkey
r_mtime
if not r_msign
ret -1
end
ret r_post
end

note ---- the cell self-test: compile and run a two-line program in the cell
fn r_selftest to bool
h = new uchar 32 0
x = new uchar 64 0
if not r_jdir rtselfn
ret false
end
n = r_jpath rtsrc
ok = r_wr rtselfs rfonew 384
n = r_jpath rtsin
e = new uchar 1 0
ok = and ok r_wr part e 0 0 rfonew 384
if ok
ok = r_check
end
if ok
r_sha rtselfo h
k = r_hex h x 0
ok = and r_jfeq rfout x r_jfeq rfexit rtexit0
ok = and ok eq get rgv rexl 1
end
r_jdel
ret ok
end

note ---- commands
fn r_yes to bool
b = new uchar 64 0
n = ulong 0
while lt n 63 bound 64
r = read 0 b n 1
if le r 0
break
end
if eq get b n 10
break
end
n = add n 1
end
if ne n 3
ret false
end
ret and and eq get b 0 121 eq get b 1 101 eq get b 2 115
end

fn r_rmall to void
p = new uchar 4100 0
n = get rgv rhml
for i ulong n bound 4100
put p i get rhm i
end
x = r_rmtree part p 0 n
end

fn c_join to int
u = new uchar 512 0
if r_kload
r_say rtjalr
ret c_status
end
if ge argcnt 3
n = argread 2 u 0 400
if le n 0
r_say rtjhub
ret 2
end
if not r_hubset part u 0 ulong n
r_say rtjhub
ret 2
end
else
x = r_hubset rtdefh
end
put rgv rrate 30
if not r_omcok
r_say rtjomc
r_rmall
ret 3
end
if not r_selftest
r_say rtjcell
r_rmall
ret 3
end
r_say rtj1
w = write 1 rhub 0 get rgv rhubl
r_say rtj2
r_say_dir
r_say rtj3
r_num get rgv rrate
r_say rtj4
r_num mul get rgv rrate 4
r_say rtj5
r_say_dir
r_say rtj6
r_say_dir
r_say rtj7
r_say_dir
r_say rtj8
r_say_dir
r_say rtj9
if not r_yes
r_say rtjcan
r_say_dir
r_say rtjcan2
r_rmall
ret 1
end
if not r_kgen
r_say rtjkey
r_rmall
ret 4
end
s = r_register
if or ne s 200 not r_rspis rtokreg
r_say rtjreg
if lt s 0
r_say rtxneg
r_num ulong neg s
else
r_rspline
end
r_say rtnl
r_say rtjreg2
r_rmall
ret 4
end
if not r_setsave
r_rmall
ret 4
end
r_say rtjok
w = write 1 rkid 0 64
r_say rtjok2
w = write 1 rhub 0 get rgv rhubl
r_say rtjok3
if not r_start
r_say rtstrtf
ret 5
end
ret 0
end

fn c_status to int
if not r_kload
r_say rtnotj
ret 1
end
if not r_setload
r_say rtnotj
ret 1
end
r_say rtst1
r_say_dir
r_say rtst2
w = write 1 rkid 0 64
r_say rtst3
w = write 1 rhub 0 get rgv rhubl
r_say rtst4
r_num get rgv rrate
r_say rtst5
pid = r_pidget
if eq pid 0
r_say rtno
else
r_say rtyes
r_num pid
r_say rtnl
end
ret 0
end

fn c_ready to bool
if not r_kload
r_say rtnotj
ret false
end
if not r_setload
r_say rtnotj
ret false
end
ret true
end

fn c_start to int
if not c_ready
ret 1
end
if not r_start
r_say rtstrtf
ret 5
end
ret 0
end

fn c_stop to int
r_stop
r_say rtstop
r_say_dir
r_say rtstop2
ret 0
end

fn c_set to int
b = new uchar 32 0
if ne argcnt 4
r_say rtusage
ret 2
end
n = argread 2 b 0 32
if not r_eq part b 0 ulong n rtraten
r_say rtusage
ret 2
end
n = argread 3 b 0 32
if le n 0
r_say rtsetbad
ret 2
end
v = r_undec part b 0 ulong n
if gt v 3600
r_say rtsetbad
ret 2
end
if not c_ready
ret 1
end
put rgv rrate v
if not r_setsave
ret 4
end
s = r_register
r_say rtsetok
r_num v
r_say rtsetok2
ret 0
end

fn c_leave to int
r_stop
told = false
if r_kload
if r_setload
s = r_sayleave
told = and eq s 200 r_rspis rtokleft
end
end
r_rmall
r_say rtleft
r_say_dir
r_say rtnl
if not told
r_say rtleft2
end
ret 0
end

fn c_once to int
if not c_ready
ret 1
end
ret int r_job
end

fn c_self to int
x = r_hubset rtdefh
if not r_omcok
r_say rtjomc
ret 3
end
if r_selftest
r_say rtselok
ret 0
end
r_say rtselno
ret 3
end

text rcjoin "join"
text rcstart "start"
text rcstop "stop"
text rcstat "status"
text rcset "set"
text rcleave "leave"
text rconce "once"

fn main to int
a = new uchar 16 0
if lt argcnt 2
r_say rtusage
ret 2
end
n = argread 1 a 0 16
if le n 0
r_say rtusage
ret 2
end
if not r_home
r_say rtnohome
ret 2
end
m = ulong n
if r_eq part a 0 m rcjoin
ret c_join
end
if r_eq part a 0 m rcstart
ret c_start
end
if r_eq part a 0 m rcstop
ret c_stop
end
if r_eq part a 0 m rcstat
ret c_status
end
if r_eq part a 0 m rcset
ret c_set
end
if r_eq part a 0 m rcleave
ret c_leave
end
if r_eq part a 0 m rconce
ret c_once
end
if r_eq part a 0 m rtselfn
ret c_self
end
r_say rtusage
ret 2
end

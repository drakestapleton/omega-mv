om2
note Test-only resource child: memory growth touches every page, fork growth retains children.
global memory uchar *
text memMode "memory"
text forkMode "fork"
text held "FORK_HELD\n"
text noHold "FORK_NOT_HELD\n"
text survived "MEMORY_SURVIVED\n"
fn equal a view uchar 64 n ulong s view uchar * to bool
if ne n len s
ret false
end
for j ulong n
if ne get a j get s j
ret false
end
end
ret true
end
fn main to int
a = new uchar 64 0
if lt argcnt 2
ret 2
end
r = argread 1 a 0 len a
if lt r 0
ret 2
end
if equal a ulong r memMode
r = argread 2 a 0 len a
if le r 0
ret 2
end
n = ulong 0
for j ulong ulong r
b = get a j
if or lt b 48 gt b 57
ret 2
end
n = add mul n 10 ulong sub b 48
end
r = enlarge memory n
if lt r 0
ret 3
end
position = ulong 0
while lt position n bound 9223372036854775807
put memory position 1
position = add position 4096
end
if gt n 0
put memory sub n 1 1
end
w = write 1 survived 0 len survived
ret 0
end
if equal a ulong r forkMode
for j ulong 128
pid = fork
if lt pid 0
if gt j 7
w = write 1 noHold 0 len noHold
ret 1
end
w = write 1 held 0 len held
ret 0
end
if eq pid 0
s = sleepns 30000000000
exit 0
end
end
w = write 1 noHold 0 len noHold
ret 1
end
ret 2
end

note Direct cgroup v2 user delegation. No systemd command is executed.
note The configured root must be a private child of a writable delegated domain.

fn cgrootpath to void
pset
for j ulong ulong get cgData 0
pb get cgRoot j
end
end

fn cgleafpath to void
pset
for j ulong ulong get cgData 1
pb get cgLeaf j
end
end

fn cgleafsave to void
put cgData 1 long plen
for j ulong plen
put cgLeaf j get pth j
end
end

note Write all bytes, then verify an exact numeric readback (kernel adds newline).
fn cgWriteValue value ulong to long
fd = popen 655361 0
if lt fd 0
ret fd
end
put gu GOB 0
onum long value
n = get gu GOB
position = ulong 0
while lt position n bound 4096
w = write int fd ob position sub n position
if le w 0
c = fclose int fd
ret -5
end
position = add position ulong w
end
c = fclose int fd
fd = popen ORDO 0
if lt fd 0
ret fd
end
r = read int fd ebuf 0 len ebuf
c = fclose int fd
if lt r long n
ret -5
end
for j ulong n
if ne get ob j get ebuf j
ret -5
end
end
if eq r long add n 1
if ne get ebuf n 10
ret -5
end
else
if ne r long n
ret -5
end
end
put gu GOB 0
ret 0
end

fn cgSet key view uchar * value ulong to long
cgleafpath
pstr key
ret cgWriteValue value
end

fn cgMove pid ulong to long
ret cgSet cgProcs pid
end

note cgroup.procs readback may contain other PIDs; enter is checked by /proc/self/cgroup too.
fn cgEnter to long
cgleafpath
pstr cgProcs
fd = popen 655361 0
if lt fd 0
ret fd
end
put gu GOB 0
onum getpid
w = write int fd ob 0 get gu GOB
n = get gu GOB
put gu GOB 0
c = fclose int fd
if ne w long n
ret -5
end
ret 0
end

fn cgInitialize to void
put cgData 2 -2
n = envget cgEnv
if le n 0
ret
end
if ge n 4000
put cgData 2 -36
ret
end
if ne get av 0 47
put cgData 2 -22
ret
end
for j ulong ulong n
put cgRoot j get av j
end
put cgData 0 n
cgrootpath
r = makedir pth 0 plen 448
if and lt r 0 ne r -17
put cgData 2 r
ret
end
cgrootpath
pstr cgManager
r = makedir pth 0 plen 448
if and lt r 0 ne r -17
put cgData 2 r
ret
end
cgleafsave
r = cgEnter
if lt r 0
put cgData 2 r
ret
end
cgrootpath
pstr cgControl
fd = popen 655361 0
if lt fd 0
put cgData 2 fd
ret
end
w = write int fd cgControllers 0 len cgControllers
c = fclose int fd
if ne w long len cgControllers
put cgData 2 -5
ret
end
put cgData 2 0
end

fn cgPrepare memory ulong tasks ulong weight ulong to long
if lt get cgData 2 0
ret get cgData 2
end
cgleafpath
r = makedir pth 0 plen 448
if lt r 0
ret r
end
if gt memory 0
r = cgSet cgMemory memory
if lt r 0
ret r
end
r = cgSet cgSwap 0
if lt r 0
ret r
end
r = cgSet cgOomGroup 1
if lt r 0
ret r
end
end
if gt tasks 0
r = cgSet cgPids tasks
if lt r 0
ret r
end
end
if gt weight 0
r = cgSet cgWeight weight
if lt r 0
ret r
end
end
ret 0
end

fn cgServicePath i ulong to void
cgrootpath
pstr cgSvc
pname i
cgleafsave
end

fn cgServicePrepare i ulong to long
if not cgLimited i
ret 0
end
cgServicePath i
cgRemove
cgServicePath i
ret cgPrepare get cgMem i get cgTasks i get cgCpu i
end

fn cgLimited i ulong to bool
ret or or gt get cgMem i 0 gt get cgTasks i 0 gt get cgCpu i 0
end

fn cgServiceEnter i ulong to long
if not cgLimited i
ret 0
end
cgServicePath i
ret cgEnter
end

fn cgKillLeaf to void
cgleafpath
pstr cgKill
fd = popen 655361 0
if ge fd 0
w = write int fd cgOne 0 len cgOne
c = fclose int fd
end
end

fn cgRemove to void
cgleafpath
r = rmdir pth 0 plen
end

fn cgOomCount to ulong
cgleafpath
pstr cgEvents
r = rdfile
if lt r 0
ret 0
end
p = ulong 0
while lt p get gu GSF bound 999999
p = lnext p
if wis 0 cgOomKey
v = wnum 1
if ge v 0
ret ulong v
end
end
end
ret 0
end

fn cgServiceExit i ulong to void
if not cgLimited i
ret
end
cgServicePath i
put cgOom i cgOomCount
cgKillLeaf
cgRemove
end
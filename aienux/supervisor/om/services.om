note Additional user-service contract. Dependency names are resolved after the initial scan.

fn sxDefaults i ulong to void
put sxDepCount i 0
put sxPort i 0
put sxHealthLen i 0
put cgMem i 0
put cgTasks i 0
put cgCpu i 0
put sxNice i 0
end

fn sxKey to bool
ret or or or or or wis 0 sxAfter wis 0 sxHealth wis 0 sxMemory wis 0 sxTasks wis 0 sxCpu wis 0 knice
end

fn sxApply i ulong to bool
if wis 0 sxAfter
if lt nw 2
ret false
end
for k ulong sub nw 1
if not sxAddDependency i add k 1
ret false
end
end
ret true
end
if wis 0 sxHealth
if ne nw 3
ret false
end
port = wnum 1
if or lt port 1 gt port 65535
ret false
end
n = wlen 2
if or eq n 0 ge n 4096
ret false
end
if ne wch 2 0 47
ret false
end
put sxPort i ulong port
put sxHealthLen i n
for j ulong n
c = wch 2 j
if or lt c 33 gt c 126
ret false
end
put sxHealthPath add mul i 4096 j c
end
ret true
end
if ne nw 2
ret false
end
v = wnum 1
if wis 0 knice
if or lt v 0 gt v 19
ret false
end
put sxNice i v
ret true
end
if le v 0
ret false
end
if wis 0 sxMemory
put cgMem i ulong v
ret true
end
if wis 0 sxTasks
put cgTasks i ulong v
ret true
end
if wis 0 sxCpu
if gt v 10000
ret false
end
put cgCpu i ulong v
ret true
end
ret false
end

fn sxNamesEqual slot ulong other ulong to bool
for j ulong get snl other
leftbyte = get snm add mul other 32 j
rightbyte = get sxDepNames add mul slot 32 j
if ne leftbyte rightbyte
ret false
end
end
ret true
end

fn sxDepIndex i ulong k ulong to long
slot = add mul i 48 k
for other ulong get sv VN
if eq get snl other get sxDepLens slot
if sxNamesEqual slot other
ret long other
end
end
end
ret -1
end

fn sxCycle i ulong target ulong depth ulong to bool
if ge depth get sv VN
ret true
end
for k ulong get sxDepCount i
other = sxDepIndex i k
if lt other 0
ret true
end
if eq ulong other target
ret true
end
if sxCycle ulong other target add depth 1
ret true
end
end
ret false
end

fn sxReady i ulong to bool
if sxCycle i i 0
put sxReasonCode i 2
setst i 7
ret false
end
for k ulong get sxDepCount i
other = sxDepIndex i k
if lt other 0
ret false
end
if or ne get sst ulong other 1 eq get sxHealthy ulong other 0
ret false
end
end
ret true
end

fn sxHealthSocket i ulong to long
address = new uchar 16 0
put address 0 2
port = get sxPort i
put address 2 uchar shr port 8
put address 3 uchar and port 255
put address 4 127
put address 7 1
fd = socknew 2 526337 0
if lt fd 0
ret fd
end
r = connect int fd address 0 16
if and lt r 0 ne r -115
c = fclose int fd
ret r
end
r = waitio int fd 4 100000000
if le r 0
c = fclose int fd
ret -110
end
ret fd
end

fn sxHealthRequest i ulong req edit uchar 8192 to ulong
put gu GOB 0
ostr sxHttpPrefix
for j ulong get sxHealthLen i
ob1 get sxHealthPath add mul i 4096 j
end
for j ulong len sxHttpTail
if eq get sxHttpTail j 10
ob1 13
end
ob1 get sxHttpTail j
end
n = get gu GOB
for j ulong n
put req j get ob j
end
put gu GOB 0
ret n
end

fn sxHttp i ulong to bool
response = new uchar 256 0
req = new uchar 8192 0
fd = sxHealthSocket i
if lt fd 0
ret false
end
n = sxHealthRequest i req
position = ulong 0
while lt position n bound 8192
r = send int fd req position sub n position 0
if le r 0
c = fclose int fd
ret false
end
position = add position ulong r
end
position = 0
deadline = add monons 200000000
while lt position 12 bound 256
remaining = sub deadline monons
if le remaining 0
c = fclose int fd
ret false
end
r = waitio int fd 1 remaining
if le r 0
c = fclose int fd
ret false
end
r = recv int fd response position sub len response position 0
if le r 0
c = fclose int fd
ret false
end
position = add position ulong r
end
c = fclose int fd
if ne get response 0 72
ret false
end
if ne get response 1 84
ret false
end
if ne get response 2 84
ret false
end
if ne get response 3 80
ret false
end
ret and eq get response 8 32 eq get response 9 50
end

fn sxSetHealth i ulong value ulong to void
if ne get sxHealthy i value
put sxHealthy i value
put sv VBEAT 1
end
end

fn sxUpdateHealth i ulong to void
if or ne get sst i 1 le get spid i 0
sxSetHealth i 0
ret
end
if ne killpid int get spid i 0 0
sxSetHealth i 0
ret
end
if gt get sxPort i 0
if not sxHttp i
sxSetHealth i 0
ret
end
end
sxSetHealth i 1
end

fn sxHasLiveDependent target ulong to bool
for i ulong get sv VN
if gt get spid i 0
for k ulong get sxDepCount i
if eq sxDepIndex i k long target
ret true
end
end
end
end
ret false
end

fn sxShutdownStep to void
if eq get sv VEXIT 0
ret
end
for k ulong get sv VN
i = sub sub get sv VN k 1
put sdn i 1
if not sxHasLiveDependent i
stopsvc i
end
end
end

fn sxStatus i ulong to void
ostr sxHealthField
onum long get sxHealthy i
ostr sxTrigger
if eq get sxReasonCode i 1
ostr sxReason
ostr sxLimit
onum get cgWhy i
end
if eq get sxReasonCode i 2
ostr sxReason
ostr sxDependency
end
if gt get cgOom i 0
ostr tsp
ostr sxOomStatus
end
end

fn sxExec i ulong to long
environment = new uchar 4096 0
n = ulong 2
count = ulong 0
p = ulong 0
while lt p get gu GSF bound 999999
p = lnext p
if and ge nw 2 wis 0 kenv
for k ulong sub nw 1
wordidx = add k 1
wlenv = wlen wordidx
if gt add add n wlenv 2 len environment
ret -7
end
put environment n uchar and wlenv 255
put environment add n 1 uchar shr wlenv 8
n = add n 2
for j ulong wlenv
put environment n wch wordidx j
n = add n 1
end
count = add count 1
end
end
end
put environment 0 uchar and count 255
put environment 1 uchar shr count 8
if eq count 0
ret execprog pk 0 get gu GPK
end
ret execenv pk 0 get gu GPK environment 0 n
end

fn sxUserPacket i ulong to bool
pkreset
p = ulong 0
while lt p get gu GSF bound 999999
p = lnext p
if and gt nw 0 wis 0 kwatch
note Legacy watcher is a separate seeded Omega executable, not a shell command.
pkstr twatch
for k ulong sub nw 1
if not pkroom wlen add k 1
ret false
end
pkword add k 1
end
end
end
p = 0
while lt p get gu GSF bound 999999
p = lnext p
if and gt nw 0 wis 0 kexec
for k ulong sub nw 1
if not pkroom wlen add k 1
ret false
end
pkword add k 1
end
ret true
end
end
ret false
end
fn sxCleanGroup i ulong to void
pid = get spid i
if gt pid 0
r = killpid neg int pid 9
end
end

fn sxAddDependency i ulong widx ulong to bool
n = wlen widx
if not okname get ws widx get we widx
ret false
end
cnt = get sxDepCount i
if ge cnt 48
ret false
end
slot = add mul i 48 cnt
put sxDepLens slot n
for j ulong n
b = wch widx j
put sxDepNames add mul slot 32 j b
end
put sxDepCount i add cnt 1
ret true
end


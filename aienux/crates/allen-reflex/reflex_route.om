note aienux/crates/allen-reflex/reflex_route.om: ALLEN Tower & Interactive Routing in pure OM-2.
note Library unit (no om2 header line, no fn main). Prefix: arx_.
note Requires reflex.om before it and om/tls/sha2.om in the same concatenated unit.

note =========================================================================
note Section 13: ALLEN Tower (Scheduling Orchestrator & Mneme Digest)
note =========================================================================

const ARX_TIER_PORTABLE uchar 0
const ARX_TIER_PI5_HOST uchar 1
const ARX_TIER_SPARK_HOST uchar 2
const ARX_TIER_SPARK_QEMU uchar 3
const ARX_TIER_SPARK_GB10 uchar 4
const ARX_TIER_SPARK_NVRM uchar 5

const ARX_TW_ACT_REUSE uchar 0
const ARX_TW_ACT_JOIN uchar 1
const ARX_TW_ACT_PI5 uchar 2
const ARX_TW_ACT_SPARK_HOST uchar 3
const ARX_TW_ACT_SPARK_GPU uchar 4

const ARX_TW_WHY_CACHED uchar 0
const ARX_TW_WHY_INFLIGHT uchar 1
const ARX_TW_WHY_PI5 uchar 2
const ARX_TW_WHY_SPARK_HOST uchar 3
const ARX_TW_WHY_SPARK_GPU uchar 4
const ARX_TW_WHY_UNCACHEABLE uchar 5

const ARX_TW_MAX_RCPTS ulong 64
const ARX_TW_MAX_INF ulong 16
const ARX_TW_GATE_STRIDE ulong 64

global arx_tw_max_rcpts ulong 1
global arx_tw_max_inf ulong 1
global arx_tw_rcpt_n ulong 1
global arx_tw_rcpt_gate uchar 4096
global arx_tw_rcpt_glen ulong 64
global arx_tw_rcpt_tier uchar 64
global arx_tw_rcpt_din uchar 2048
global arx_tw_rcpt_drcpt uchar 2048

global arx_tw_inf_used uchar 16
global arx_tw_inf_gate uchar 1024
global arx_tw_inf_glen ulong 16
global arx_tw_inf_tier uchar 16
global arx_tw_inf_din uchar 512

global arx_tw_dec_act uchar 1
global arx_tw_dec_why uchar 1
global arx_tw_dec_slot ulong 1
global arx_tw_dec_rcpt uchar 32
global arx_tw_dec_gate uchar 64
global arx_tw_dec_glen ulong 1

text arx_tw_domain "ALLEN-TOWER-INPUT-V1"
text arx_tw_s_act0 "reuse_receipt"
text arx_tw_s_act1 "join_inflight"
text arx_tw_s_act2 "run_pi5_local"
text arx_tw_s_act3 "dispatch_spark_host"
text arx_tw_s_act4 "queue_spark_gb10"

text arx_tw_s_why0 "cached_pass_receipt"
text arx_tw_s_why1 "inflight_duplicate"
text arx_tw_s_why2 "tier_local_pi5"
text arx_tw_s_why3 "tier_spark_host_pool"
text arx_tw_s_why4 "tier_spark_gpu_serial"
text arx_tw_s_why5 "uncacheable_gate"

text arx_tw_j1 "{\"tower_action\":\""
text arx_tw_j2 "\",\"gate\":\""
text arx_tw_j3 "\",\"why\":\""
text arx_tw_j4 "\"}"
text arx_hex_digits "0123456789abcdef"

fn arx_combine_mneme_digest decl view uchar 32 pins view uchar 32 reads view uchar * n_reads ulong dst edit uchar 32 to void
ctx = new ulong 40 0
nul1 = new uchar 1 0
cnt_le = new uchar 8 0
sha256_init ctx
sha256_update ctx arx_tw_domain
sha256_update ctx nul1
sha256_update ctx decl
sha256_update ctx pins
put cnt_le 0 uchar and n_reads 255
put cnt_le 1 uchar and shr n_reads 8 255
put cnt_le 2 uchar and shr n_reads 16 255
put cnt_le 3 uchar and shr n_reads 24 255
put cnt_le 4 uchar and shr n_reads 32 255
put cnt_le 5 uchar and shr n_reads 40 255
put cnt_le 6 uchar and shr n_reads 48 255
put cnt_le 7 uchar and shr n_reads 56 255
sha256_update ctx cnt_le
i = ulong 0
while lt i n_reads bound 64
sha256_update ctx part reads mul i 32 32
i = add i 1
end
sha256_final ctx dst
end

fn arx_tower_init max_rcpts ulong max_inf ulong to void
mr = max_rcpts
if gt mr ARX_TW_MAX_RCPTS
mr = ARX_TW_MAX_RCPTS
end
mi = max_inf
if gt mi ARX_TW_MAX_INF
mi = ARX_TW_MAX_INF
end
put arx_tw_max_rcpts 0 mr
put arx_tw_max_inf 0 mi
put arx_tw_rcpt_n 0 0
i = ulong 0
while lt i ARX_TW_MAX_INF bound 16
put arx_tw_inf_used i 0
i = add i 1
end
end

fn arx_tw_match_rcpt idx ulong gate view uchar * tier uchar din view uchar 32 to bool
if ne get arx_tw_rcpt_tier idx tier
ret false
end
gn = len gate
if ne get arx_tw_rcpt_glen idx gn
ret false
end
gb = mul idx ARX_TW_GATE_STRIDE
i = ulong 0
while lt i gn bound 64
if ne get arx_tw_rcpt_gate add gb i get gate i
ret false
end
i = add i 1
end
db = mul idx 32
i = ulong 0
while lt i 32 bound 32
if ne get arx_tw_rcpt_din add db i get din i
ret false
end
i = add i 1
end
ret true
end

fn arx_tw_match_inf idx ulong gate view uchar * tier uchar din view uchar 32 to bool
if eq get arx_tw_inf_used idx 0
ret false
end
if ne get arx_tw_inf_tier idx tier
ret false
end
gn = len gate
if ne get arx_tw_inf_glen idx gn
ret false
end
gb = mul idx ARX_TW_GATE_STRIDE
i = ulong 0
while lt i gn bound 64
if ne get arx_tw_inf_gate add gb i get gate i
ret false
end
i = add i 1
end
db = mul idx 32
i = ulong 0
while lt i 32 bound 32
if ne get arx_tw_inf_din add db i get din i
ret false
end
i = add i 1
end
ret true
end

fn arx_tower_complete_inflight gate view uchar * tier uchar din view uchar 32 to bool
mi = get arx_tw_max_inf 0
i = ulong 0
while lt i mi bound 16
if arx_tw_match_inf i gate tier din
put arx_tw_inf_used i 0
ret true
end
i = add i 1
end
ret false
end

fn arx_tw_shift_rcpts to void
rn = get arx_tw_rcpt_n 0
if le rn 1
put arx_tw_rcpt_n 0 0
ret
end
i = ulong 1
while lt i rn bound 64
d = sub i 1
put arx_tw_rcpt_tier d get arx_tw_rcpt_tier i
gl = get arx_tw_rcpt_glen i
put arx_tw_rcpt_glen d gl
sb = mul i ARX_TW_GATE_STRIDE
db = mul d ARX_TW_GATE_STRIDE
k = ulong 0
while lt k gl bound 64
put arx_tw_rcpt_gate add db k get arx_tw_rcpt_gate add sb k
k = add k 1
end
si = mul i 32
di = mul d 32
k = ulong 0
while lt k 32 bound 32
put arx_tw_rcpt_din add di k get arx_tw_rcpt_din add si k
put arx_tw_rcpt_drcpt add di k get arx_tw_rcpt_drcpt add si k
k = add k 1
end
i = add i 1
end
put arx_tw_rcpt_n 0 sub rn 1
end

fn arx_tw_store_rcpt_gate rn ulong gate view uchar * to void
gn = len gate
if gt gn ARX_TW_GATE_STRIDE
gn = ARX_TW_GATE_STRIDE
end
put arx_tw_rcpt_glen rn gn
gb = mul rn ARX_TW_GATE_STRIDE
k = ulong 0
while lt k gn bound 64
put arx_tw_rcpt_gate add gb k get gate k
k = add k 1
end
end

fn arx_tw_store_rcpt_digs rn ulong din view uchar 32 drcpt view uchar 32 to void
db = mul rn 32
k = ulong 0
while lt k 32 bound 32
put arx_tw_rcpt_din add db k get din k
put arx_tw_rcpt_drcpt add db k get drcpt k
k = add k 1
end
end

fn arx_tower_record_pass gate view uchar * tier uchar din view uchar 32 drcpt view uchar 32 to void
ign_c = arx_tower_complete_inflight gate tier din
rn = get arx_tw_rcpt_n 0
i = ulong 0
while lt i rn bound 64
if arx_tw_match_rcpt i gate tier din
arx_tw_store_rcpt_digs i din drcpt
ret
end
i = add i 1
end
mr = get arx_tw_max_rcpts 0
if eq mr 0
ret
end
if ge rn mr
arx_tw_shift_rcpts
rn = get arx_tw_rcpt_n 0
end
put arx_tw_rcpt_tier rn tier
arx_tw_store_rcpt_gate rn gate
arx_tw_store_rcpt_digs rn din drcpt
put arx_tw_rcpt_n 0 add rn 1
end

fn arx_tw_insert_inf gate view uchar * tier uchar din view uchar 32 to void
gn = len gate
if gt gn ARX_TW_GATE_STRIDE
gn = ARX_TW_GATE_STRIDE
end
mi = get arx_tw_max_inf 0
i = ulong 0
while lt i mi bound 16
if eq get arx_tw_inf_used i 0
put arx_tw_inf_used i 1
put arx_tw_inf_tier i tier
put arx_tw_inf_glen i gn
gb = mul i ARX_TW_GATE_STRIDE
k = ulong 0
while lt k gn bound 64
put arx_tw_inf_gate add gb k get gate k
k = add k 1
end
db = mul i 32
k = ulong 0
while lt k 32 bound 32
put arx_tw_inf_din add db k get din k
k = add k 1
end
ret
end
i = add i 1
end
end

fn arx_tw_copy_dec_gate gate view uchar * to void
gn = len gate
if gt gn ARX_TW_GATE_STRIDE
gn = ARX_TW_GATE_STRIDE
end
put arx_tw_dec_glen 0 gn
k = ulong 0
while lt k gn bound 64
put arx_tw_dec_gate k get gate k
k = add k 1
end
end

fn arx_tw_copy_dec_rcpt idx ulong to void
db = mul idx 32
k = ulong 0
while lt k 32 bound 32
put arx_tw_dec_rcpt k get arx_tw_rcpt_drcpt add db k
k = add k 1
end
end

fn arx_tower_schedule gate view uchar * tier uchar din view uchar 32 cacheable bool to uchar
arx_tw_copy_dec_gate gate
act = ARX_TW_ACT_SPARK_GPU
twhy = ARX_TW_WHY_SPARK_GPU
if or eq tier ARX_TIER_PORTABLE eq tier ARX_TIER_PI5_HOST
act = ARX_TW_ACT_PI5
twhy = ARX_TW_WHY_PI5
else
if or eq tier ARX_TIER_SPARK_HOST eq tier ARX_TIER_SPARK_QEMU
act = ARX_TW_ACT_SPARK_HOST
twhy = ARX_TW_WHY_SPARK_HOST
end
end
if not cacheable
put arx_tw_dec_act 0 act
put arx_tw_dec_why 0 ARX_TW_WHY_UNCACHEABLE
ret act
end
rn = get arx_tw_rcpt_n 0
i = ulong 0
while lt i rn bound 64
if arx_tw_match_rcpt i gate tier din
arx_tw_copy_dec_rcpt i
put arx_tw_dec_act 0 ARX_TW_ACT_REUSE
put arx_tw_dec_why 0 ARX_TW_WHY_CACHED
ret ARX_TW_ACT_REUSE
end
i = add i 1
end
mi = get arx_tw_max_inf 0
i = ulong 0
while lt i mi bound 16
if arx_tw_match_inf i gate tier din
put arx_tw_dec_act 0 ARX_TW_ACT_JOIN
put arx_tw_dec_why 0 ARX_TW_WHY_INFLIGHT
put arx_tw_dec_slot 0 i
ret ARX_TW_ACT_JOIN
end
i = add i 1
end
arx_tw_insert_inf gate tier din
put arx_tw_dec_act 0 act
put arx_tw_dec_why 0 twhy
ret act
end

fn arx_tw_push_escaped dst edit uchar * pos ulong src view uchar * to ulong
p = pos
n = len src
i = ulong 0
while lt i n bound 256
c = get src i
if eq c 34
put dst p 92
put dst add p 1 34
p = add p 2
else
if eq c 92
put dst p 92
put dst add p 1 92
p = add p 2
else
if eq c 10
put dst p 92
put dst add p 1 110
p = add p 2
else
if eq c 13
put dst p 92
put dst add p 1 114
p = add p 2
else
if eq c 9
put dst p 92
put dst add p 1 116
p = add p 2
else
if lt c 0x20
put dst p 92
put dst add p 1 117
put dst add p 2 48
put dst add p 3 48
put dst add p 4 get arx_hex_digits ulong shr c 4
put dst add p 5 get arx_hex_digits ulong and c 15
p = add p 6
else
put dst p c
p = add p 1
end
end
end
end
end
end
i = add i 1
end
ret p
end

fn arx_tower_decision_json dst edit uchar * to ulong
gbuf = new uchar 64 0
p = ulong 0
p = arx_copy_bytes dst p arx_tw_j1
act = get arx_tw_dec_act 0
if eq act ARX_TW_ACT_REUSE
p = arx_copy_bytes dst p arx_tw_s_act0
else
if eq act ARX_TW_ACT_JOIN
p = arx_copy_bytes dst p arx_tw_s_act1
else
if eq act ARX_TW_ACT_PI5
p = arx_copy_bytes dst p arx_tw_s_act2
else
if eq act ARX_TW_ACT_SPARK_HOST
p = arx_copy_bytes dst p arx_tw_s_act3
else
p = arx_copy_bytes dst p arx_tw_s_act4
end
end
end
end
p = arx_copy_bytes dst p arx_tw_j2
gl = get arx_tw_dec_glen 0
k = ulong 0
while lt k gl bound 64
put gbuf k get arx_tw_dec_gate k
k = add k 1
end
p = arx_tw_push_escaped dst p part gbuf 0 gl
p = arx_copy_bytes dst p arx_tw_j3
w = get arx_tw_dec_why 0
if eq w ARX_TW_WHY_CACHED
p = arx_copy_bytes dst p arx_tw_s_why0
else
if eq w ARX_TW_WHY_INFLIGHT
p = arx_copy_bytes dst p arx_tw_s_why1
else
if eq w ARX_TW_WHY_PI5
p = arx_copy_bytes dst p arx_tw_s_why2
else
if eq w ARX_TW_WHY_SPARK_HOST
p = arx_copy_bytes dst p arx_tw_s_why3
else
if eq w ARX_TW_WHY_SPARK_GPU
p = arx_copy_bytes dst p arx_tw_s_why4
else
p = arx_copy_bytes dst p arx_tw_s_why5
end
end
end
end
end
p = arx_copy_bytes dst p arx_tw_j4
ret p
end


const ARX_INTERACTIVE_MAX ulong 512
const ARX_PST1_HEADER ulong 224
const ARX_PST1_PAYLOAD_MAX ulong 800

const ARX_RT_LOCAL_DET uchar 0
const ARX_RT_MEMORY uchar 1
const ARX_RT_CLARIFY uchar 2
const ARX_RT_REFUSE uchar 3
const ARX_RT_LOCAL_MODEL uchar 4
const ARX_RT_SPARK_INF uchar 5
const ARX_RT_SPARK_OM uchar 6
const ARX_RT_APPROVAL uchar 7
const ARX_RT_NONE uchar 255

const ARX_THEN_APPROVE uchar 0
const ARX_THEN_DENY uchar 1
const ARX_THEN_CANCEL uchar 2
const ARX_THEN_REMEMBER uchar 3
const ARX_THEN_PREFER uchar 4
const ARX_THEN_NOTE_TASK uchar 5
const ARX_THEN_SPARK_TASK uchar 6
const ARX_THEN_NONE uchar 255

const ARX_SPK_OWNER uchar 0
const ARX_SPK_GUEST uchar 1

const ARX_NR_STORE uchar 0
const ARX_NR_NO_CONSENT uchar 1
const ARX_NR_DESK uchar 2
const ARX_NR_NO_MODEL uchar 3
const ARX_NR_SPARK_DOWN uchar 4
const ARX_NR_NONE uchar 255

const ARX_RWHY_SCORED uchar 0
const ARX_RWHY_EXACT uchar 1
const ARX_RWHY_POLICY uchar 2
const ARX_RWHY_NO_USER uchar 3
const ARX_RWHY_TOO_LONG uchar 4

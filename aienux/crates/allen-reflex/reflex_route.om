const ARX_RWHY_NO_WORDS uchar 6
const ARX_RWHY_CORE_CLARIFY uchar 7
const ARX_RWHY_MISSING_SUBJ uchar 8
const ARX_RWHY_UNFAMILIAR uchar 9
const ARX_RWHY_UNSURE uchar 10
const ARX_RWHY_NOTHING_PEND uchar 11
const ARX_RWHY_MODEL_UNAVAIL uchar 12
const ARX_RWHY_GUEST_SCOPE uchar 13
const ARX_RWHY_OUT_OF_CAP uchar 14
const ARX_RWHY_SPARK_CUE uchar 15


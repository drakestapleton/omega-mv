global arx_rctx_consent uchar 1
global arx_rctx_pending uchar 1
global arx_rctx_caps uint 1
global arx_rctx_has_model uchar 1
global arx_rctx_model uchar 64
global arx_rctx_mlen ulong 1
global arx_rctx_subj uchar 32
global arx_rctx_min_sim f32 1
global arx_rctx_min_margin f32 1

note --- DecisionProposal output globals ---
global arx_prop_req ulong 1
global arx_prop_sess ulong 1
global arx_prop_speaker uchar 1
global arx_prop_obj uchar 32
global arx_prop_route uchar 1
global arx_prop_then uchar 1
global arx_prop_not_ready uchar 1
global arx_prop_fallback uchar 1
global arx_prop_why uchar 1
global arx_prop_refuse uchar 1
global arx_prop_label uchar 1

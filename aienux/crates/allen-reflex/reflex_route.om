text arx_rt_obj_dom "AIEN_E2E_OBJECTIVE_V1\n"
text arx_rt_cause_dom "AIENOS_PST1_CAUSE_V1\n"
text arx_rt_task_dom "AIENOS_PST1_TASK_V1\n"
text arx_rt_idem_dom "AIENOS_PST1_IDEMPOTENCE_V1\n"

text arx_rt_model_words "gpt chatgpt claude gemini llama tinyllama mistral qwen danube phi grok deepseek gemma copilot"
text arx_rt_spark_verbs "run compile build benchmark train test verify execute measure compute"
text arx_rt_w_spark "spark"
text arx_rt_w_gb10 "gb10"

fn arx_route_runs_without_owner r uchar to bool
if eq r ARX_RT_LOCAL_DET
ret true
end
if eq r ARX_RT_MEMORY
ret true
end
if eq r ARX_RT_LOCAL_MODEL
ret true
end
if eq r ARX_RT_SPARK_INF
ret true
end
ret false
end

fn arx_cal_frozen mode uchar to void
if eq mode ARX_MODE_REFLEX
put arx_rctx_min_sim 0 0.20f32
put arx_rctx_min_margin 0 -1.0e38f32
else
if eq mode ARX_MODE_NEAREST
put arx_rctx_min_sim 0 0.35f32
put arx_rctx_min_margin 0 -1.0e38f32
else
put arx_rctx_min_sim 0 -1.0f32
put arx_rctx_min_margin 0 0.15f32
end
end
end

fn arx_cal_off to void
put arx_rctx_min_sim 0 -1.0f32
put arx_rctx_min_margin 0 -1.0e38f32
end

fn arx_rctx_set_model has_m bool name view uchar * to void
if not has_m
put arx_rctx_has_model 0 0
put arx_rctx_mlen 0 0
ret
end
n = len name
if gt n 64
n = 64
end
i = ulong 0
while lt i n bound 64
put arx_rctx_model i get name i
i = add i 1
end
put arx_rctx_mlen 0 n
put arx_rctx_has_model 0 1
end

fn arx_objective_id msg view uchar * dst edit uchar 32 to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx arx_rt_obj_dom
sha256_update ctx msg
sha256_final ctx dst
end

fn arx_put_be64 dst edit uchar * off ulong v ulong to void
put dst off uchar and shr v 56 255
put dst add off 1 uchar and shr v 48 255
put dst add off 2 uchar and shr v 40 255
put dst add off 3 uchar and shr v 32 255
put dst add off 4 uchar and shr v 24 255
put dst add off 5 uchar and shr v 16 255
put dst add off 6 uchar and shr v 8 255
put dst add off 7 uchar and v 255
end

fn arx_pst1_fill_hdr subj view uchar 32 dst edit uchar * to void
ctx = new ulong 40 0
be8 = new uchar 8 0
cause_id = new uchar 32 0
tmp_h = new uchar 32 0
sha256_init ctx
sha256_update ctx arx_rt_cause_dom
arx_put_be64 be8 0 get arx_prop_sess 0
sha256_update ctx be8
arx_put_be64 be8 0 get arx_prop_req 0
sha256_update ctx be8
i = ulong 0
while lt i 32 bound 32
put tmp_h i get arx_prop_obj i
i = add i 1
end
sha256_update ctx tmp_h
sha256_final ctx cause_id
i = ulong 0
while lt i ARX_PST1_HEADER bound 224
put dst i 0
i = add i 1
end
put dst 0 1
put dst 1 1
i = ulong 0
while lt i 32 bound 32
put dst add 4 i get cause_id i
put dst add 68 i get arx_prop_obj i
put dst add 100 i get subj i
i = add i 1
end
sha256_init ctx
sha256_update ctx arx_rt_task_dom
sha256_update ctx cause_id
sha256_final ctx tmp_h
i = ulong 0
while lt i 16 bound 16
put dst add 148 i get tmp_h i
i = add i 1
end
sha256_init ctx
sha256_update ctx arx_rt_idem_dom
sha256_update ctx cause_id
sha256_final ctx tmp_h
i = ulong 0
while lt i 16 bound 16
put dst add 164 i get tmp_h i
i = add i 1
end
put dst 184 1
end

fn arx_pst1_request route uchar payload view uchar * subj view uchar 32 dst edit uchar * to ulong
tmp_h = new uchar 32 0
if not or eq route ARX_RT_SPARK_INF eq route ARX_RT_SPARK_OM
ret 0
end
pn = len payload
if gt pn ARX_PST1_PAYLOAD_MAX
ret 0
end
if lt len dst add ARX_PST1_HEADER pn
ret 0
end
arx_pst1_fill_hdr subj dst
put dst 188 uchar and shr pn 8 255
put dst 189 uchar and pn 255
ign_h = sha2_digest 256 payload tmp_h
i = ulong 0
while lt i 32 bound 32
put dst add 192 i get tmp_h i
i = add i 1
end
i = ulong 0
while lt i pn bound 800
put dst add ARX_PST1_HEADER i get payload i
i = add i 1
end
ret add ARX_PST1_HEADER pn
end

fn arx_eq_ci a view uchar * b view uchar * to bool
na = len a
if ne na len b
ret false
end
i = ulong 0
while lt i na bound 256
if ne arx_to_lower get a i arx_to_lower get b i
ret false
end
i = add i 1
end
ret true
end

fn arx_word_in_list_ci w view uchar * lst view uchar * to bool
n = len lst
i = ulong 0
while lt i n bound 512
if eq get lst i 32
i = add i 1
continue
end
ws = i
while lt i n bound 512
if eq get lst i 32
break
end
i = add i 1
end
if arx_eq_ci w part lst ws sub i ws
ret true
end
end
ret false
end

fn arx_named_model_unavail msg view uchar * to bool
im = new uchar 64 0
has_im = ne get arx_rctx_has_model 0 0
imlen = get arx_rctx_mlen 0
if has_im
k = ulong 0
while lt k imlen bound 64
put im k get arx_rctx_model k
k = add k 1
end
end
n = len msg
i = ulong 0
while lt i n bound 512
if not arx_is_alnum get msg i
i = add i 1
continue
end
ws = i
while lt i n bound 512
if not arx_is_alnum get msg i
break
end
i = add i 1
end
if arx_word_in_list_ci part msg ws sub i ws arx_rt_model_words
if not has_im
ret true
end
if not arx_eq_ci part msg ws sub i ws part im 0 imlen
ret true
end
ret false
end
end
ret false
end

fn arx_spark_cue msg view uchar * to bool
has_sp = false
has_vb = false
n = len msg
i = ulong 0
while lt i n bound 512
if not arx_is_alnum get msg i
i = add i 1
continue
end
ws = i
while lt i n bound 512
if not arx_is_alnum get msg i
break
end
i = add i 1
end
if or arx_eq_ci part msg ws sub i ws arx_rt_w_spark arx_eq_ci part msg ws sub i ws arx_rt_w_gb10
has_sp = true
end
if arx_word_in_list_ci part msg ws sub i ws arx_rt_spark_verbs
has_vb = true
end
end
ret and has_sp has_vb
end

fn arx_prop_reset req_id ulong sess_id ulong to void
put arx_prop_req 0 req_id
put arx_prop_sess 0 sess_id
put arx_prop_speaker 0 get arx_rctx_speaker 0
i = ulong 0
while lt i 32 bound 32
put arx_prop_obj i 0
put arx_prop_pst1 i 0
i = add i 1
end
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_then 0 ARX_THEN_NONE
put arx_prop_not_ready 0 ARX_NR_NONE
put arx_prop_fallback 0 ARX_RT_NONE
put arx_prop_why 0 ARX_RWHY_NO_USER
put arx_prop_refuse 0 ARX_REFUSE_NONE
put arx_prop_label 0 ARX_ACT_CLARIFY
put arx_prop_has_txt 0 0
put arx_prop_tlen 0 0
put arx_prop_has_pst1 0 0
end

fn arx_propose_dispatch act uchar msg view uchar * to uchar
owner = eq get arx_rctx_speaker 0 ARX_SPK_OWNER
caps = get arx_rctx_caps 0
has_cons = ne get arx_rctx_consent 0 0
if or eq act ARX_ACT_STATUS or eq act ARX_ACT_HELP eq act ARX_ACT_EVIDENCE
put arx_prop_route 0 ARX_RT_LOCAL_DET
ret ARX_RT_LOCAL_DET
end
if eq act ARX_ACT_NONE
put arx_prop_route 0 ARX_RT_LOCAL_DET
put arx_prop_why 0 ARX_RWHY_OUT_OF_CAP
ret ARX_RT_LOCAL_DET
end
if or eq act ARX_ACT_RECALL eq act ARX_ACT_FACTS
if not owner
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_GUEST_SCOPE
ret ARX_RT_REFUSE
end
put arx_prop_route 0 ARX_RT_MEMORY
if not has_cons
put arx_prop_not_ready 0 ARX_NR_NO_CONSENT
else
if eq and caps 1 0
put arx_prop_not_ready 0 ARX_NR_STORE
end
end
ret ARX_RT_MEMORY
end
if or eq act ARX_ACT_REMEMBER or eq act ARX_ACT_PREFER eq act ARX_ACT_TASK
if not owner
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_GUEST_SCOPE
ret ARX_RT_REFUSE
end
if and eq act ARX_ACT_TASK arx_spark_cue msg
put arx_prop_route 0 ARX_RT_SPARK_OM
put arx_prop_why 0 ARX_RWHY_SPARK_CUE
put arx_prop_then 0 ARX_THEN_SPARK_TASK
if eq and caps 2 0
put arx_prop_not_ready 0 ARX_NR_DESK
else
if eq and caps 8 0
put arx_prop_not_ready 0 ARX_NR_SPARK_DOWN
end
end
ret ARX_RT_SPARK_OM
end
put arx_prop_route 0 ARX_RT_APPROVAL
if eq act ARX_ACT_REMEMBER
put arx_prop_then 0 ARX_THEN_REMEMBER
else
if eq act ARX_ACT_PREFER
put arx_prop_then 0 ARX_THEN_PREFER
else
put arx_prop_then 0 ARX_THEN_NOTE_TASK
end
end
if and ne act ARX_ACT_TASK not has_cons
put arx_prop_not_ready 0 ARX_NR_NO_CONSENT
else
if eq and caps 2 0
put arx_prop_not_ready 0 ARX_NR_DESK
else
if eq and caps 1 0
put arx_prop_not_ready 0 ARX_NR_STORE
end
end
end
ret ARX_RT_APPROVAL
end
if eq act ARX_ACT_PROMPT
if and owner arx_spark_cue msg
put arx_prop_route 0 ARX_RT_SPARK_OM
put arx_prop_why 0 ARX_RWHY_SPARK_CUE
put arx_prop_then 0 ARX_THEN_SPARK_TASK
if eq and caps 2 0
put arx_prop_not_ready 0 ARX_NR_DESK
else
if eq and caps 8 0
put arx_prop_not_ready 0 ARX_NR_SPARK_DOWN
end
end
ret ARX_RT_SPARK_OM
end
if ne and caps 4 0
put arx_prop_route 0 ARX_RT_LOCAL_MODEL
ret ARX_RT_LOCAL_MODEL
end
put arx_prop_route 0 ARX_RT_SPARK_INF
if eq and caps 8 0
put arx_prop_not_ready 0 ARX_NR_SPARK_DOWN
end
ret ARX_RT_SPARK_INF
end
if or eq act ARX_ACT_APPROVE or eq act ARX_ACT_DENY eq act ARX_ACT_CANCEL
if eq get arx_rctx_pending 0 0
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_NOTHING_PEND
ret ARX_RT_CLARIFY
end
if not owner
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_GUEST_SCOPE
ret ARX_RT_REFUSE
end
put arx_prop_route 0 ARX_RT_APPROVAL
if eq act ARX_ACT_APPROVE
put arx_prop_then 0 ARX_THEN_APPROVE
else
if eq act ARX_ACT_DENY
put arx_prop_then 0 ARX_THEN_DENY
else
put arx_prop_then 0 ARX_THEN_CANCEL
end
end
if eq and caps 2 0
put arx_prop_not_ready 0 ARX_NR_DESK
end
ret ARX_RT_APPROVAL
end
if eq act ARX_ACT_CLARIFY
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_CORE_CLARIFY
ret ARX_RT_CLARIFY
end
put arx_prop_route 0 ARX_RT_REFUSE
ret ARX_RT_REFUSE
end

fn arx_propose_attach_pst1 rt uchar msg view uchar * to void
subj = new uchar 32 0
pst = new uchar 1024 0
dig = new uchar 32 0
if not or eq rt ARX_RT_SPARK_INF eq rt ARX_RT_SPARK_OM
ret
end
i = ulong 0
while lt i 32 bound 32
put subj i get arx_rctx_subj i
i = add i 1
end
plen = arx_pst1_request rt msg subj pst
if gt plen 0
ign_d = sha2_digest 256 part pst 0 plen dig
i = ulong 0
while lt i 32 bound 32
put arx_prop_pst1 i get dig i
i = add i 1
end
put arx_prop_has_pst1 0 1
end
end

fn arx_propose req_id ulong sess_id ulong to uchar
msg = new uchar 512 0
obj = new uchar 32 0
arx_prop_reset req_id sess_id
tn = get arx_turn_n 0
has_u = false
last_u = ulong 0
i = ulong 0
while lt i tn bound 32
if eq get arx_turn_role i ARX_ROLE_USER
has_u = true
last_u = i
end
i = add i 1
end
if not has_u
ret ARX_RT_CLARIFY
end
raw_n = get arx_turn_raw_len last_u
mlen = arx_load_turn_buf last_u msg
arx_objective_id part msg 0 mlen obj
i = ulong 0
while lt i 32 bound 32
put arx_prop_obj i get obj i
i = add i 1
end
if gt raw_n ARX_INTERACTIVE_MAX
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_TOO_LONG
ret ARX_RT_REFUSE
end
i = ulong 0
while lt i mlen bound 512
b = get msg i
if or lt b 0x20 gt b 0x7e
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_NON_ASCII
ret ARX_RT_CLARIFY
end
i = add i 1
end
act = arx_decide
put arx_prop_label 0 act
if ne get arx_dec_has_txt 0 0
put arx_prop_has_txt 0 1
tl = get arx_dec_txt_len 0
put arx_prop_tlen 0 tl
i = ulong 0
while lt i tl bound 64
put arx_prop_txt i get arx_dec_txt i
i = add i 1
end
end
ew = get arx_exp_why 0
if eq ew ARX_WHY_POLICY
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_POLICY
put arx_prop_refuse 0 get arx_exp_refuse 0
put arx_prop_has_txt 0 0
ret ARX_RT_REFUSE
end
if eq ew ARX_WHY_NO_USER_TURN
put arx_prop_why 0 ARX_RWHY_NO_USER
ret ARX_RT_CLARIFY
end
if eq ew ARX_WHY_INPUT_TOO_LONG
put arx_prop_route 0 ARX_RT_REFUSE
put arx_prop_why 0 ARX_RWHY_TOO_LONG
ret ARX_RT_REFUSE
end
if eq ew ARX_WHY_NO_WORDS
put arx_prop_why 0 ARX_RWHY_NO_WORDS
ret ARX_RT_CLARIFY
end
if eq ew ARX_WHY_SPAN
put arx_prop_why 0 ARX_RWHY_MISSING_SUBJ
ret ARX_RT_CLARIFY
end
if ne ew ARX_WHY_EXACT_RECALL
if lt get arx_exp_best_sim 0 get arx_rctx_min_sim 0
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_UNFAMILIAR
put arx_prop_has_txt 0 0
ret ARX_RT_CLARIFY
end
if lt get arx_exp_margin 0 get arx_rctx_min_margin 0
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_UNSURE
put arx_prop_has_txt 0 0
ret ARX_RT_CLARIFY
end
end
if eq ew ARX_WHY_EXACT_RECALL
put arx_prop_why 0 ARX_RWHY_EXACT
else
put arx_prop_why 0 ARX_RWHY_SCORED
end
if arx_named_model_unavail part msg 0 mlen
put arx_prop_route 0 ARX_RT_CLARIFY
put arx_prop_why 0 ARX_RWHY_MODEL_UNAVAIL
put arx_prop_has_txt 0 0
ret ARX_RT_CLARIFY
end
rt = arx_propose_dispatch act part msg 0 mlen
if ne get arx_prop_not_ready 0 ARX_NR_NONE
put arx_prop_fallback 0 ARX_RT_LOCAL_DET
end
arx_propose_attach_pst1 rt part msg 0 mlen
ret rt
end

text arx_p_s1 "{\"req\":"
text arx_p_s2 ",\"session\":"
text arx_p_s3 ",\"speaker\":\""
text arx_p_s4 "\",\"objective\":\""
text arx_p_s5 "\",\"route\":\""
text arx_p_s6 "\",\"then\":\""
text arx_p_s7 "\",\"ready\":\""
text arx_p_s8 "\",\"fallback\":\""
text arx_p_s9 "\",\"why\":\""
text arx_p_s10 "\",\"label\":\""
text arx_p_s11 "\",\"text\":\""
text arx_p_s12 "\",\"pst1\":\""
text arx_p_s13 "\",\"grants\":\"none\"}"
text arx_p_owner "owner"
text arx_p_guest "guest"
text arx_p_yes "yes"
text arx_p_no "no:"
text arx_p_dash "-"

text arx_rt_n0 "local_deterministic"
text arx_rt_n1 "memory"
text arx_rt_n2 "clarify"
text arx_rt_n3 "refuse"
text arx_rt_n4 "local_model"
text arx_rt_n5 "spark_inference"
text arx_rt_n6 "spark_omegese"
text arx_rt_n7 "approval_needed"

text arx_th_n0 "approve"
text arx_th_n1 "deny"
text arx_th_n2 "cancel"
text arx_th_n3 "remember"
text arx_th_n4 "prefer"
text arx_th_n5 "note_task"
text arx_th_n6 "spark_task"

text arx_nr_n0 "store_absent"
text arx_nr_n1 "no_memory_consent"
text arx_nr_n2 "owner_desk_absent"
text arx_nr_n3 "no_local_model"
text arx_nr_n4 "spark_link_down"

text arx_rw_n0 "scored"
text arx_rw_n1 "exact_recall"
text arx_rw_n2 "policy"
text arx_rw_n3 "no_user_turn"
text arx_rw_n4 "input_too_long"
text arx_rw_n5 "non_ascii"
text arx_rw_n6 "no_words"
text arx_rw_n7 "core_clarify"
text arx_rw_n8 "missing_subject"
text arx_rw_n9 "unfamiliar"
text arx_rw_n10 "unsure"
text arx_rw_n11 "nothing_pending"
text arx_rw_n12 "model_unavailable"
text arx_rw_n13 "guest_scope"
text arx_rw_n14 "out_of_capability"
text arx_rw_n15 "spark_cue"

text arx_rr_n1 ":rule-break"
text arx_rr_n2 ":override"
text arx_rr_n3 ":forbidden-verb"
text arx_rr_n4 ":blanket-approval"
text arx_rr_n5 ":data-order"

fn arx_push_u64 dst edit uchar * pos ulong val ulong to ulong
buf = new uchar 20 0
v = val
i = ulong 20
while gt i 0 bound 20
i = sub i 1
put buf i add uchar 48 uchar rem v 10
v = div v 10
if eq v 0
break
end
end
p = pos
while lt i 20 bound 20
put dst p get buf i
p = add p 1
i = add i 1
end
ret p
end

fn arx_push_hex32 dst edit uchar * pos ulong src view uchar 32 to ulong
p = pos
i = ulong 0
while lt i 32 bound 32
b = get src i
put dst p get arx_hex_digits ulong shr b 4
put dst add p 1 get arx_hex_digits ulong and b 15
p = add p 2
i = add i 1
end
ret p
end

fn arx_write_route_name r uchar dst edit uchar * pos ulong to ulong
if eq r ARX_RT_LOCAL_DET
ret arx_copy_bytes dst pos arx_rt_n0
end
if eq r ARX_RT_MEMORY
ret arx_copy_bytes dst pos arx_rt_n1
end
if eq r ARX_RT_CLARIFY
ret arx_copy_bytes dst pos arx_rt_n2
end
if eq r ARX_RT_REFUSE
ret arx_copy_bytes dst pos arx_rt_n3
end
if eq r ARX_RT_LOCAL_MODEL
ret arx_copy_bytes dst pos arx_rt_n4
end
if eq r ARX_RT_SPARK_INF
ret arx_copy_bytes dst pos arx_rt_n5
end
if eq r ARX_RT_SPARK_OM
ret arx_copy_bytes dst pos arx_rt_n6
end
if eq r ARX_RT_APPROVAL
ret arx_copy_bytes dst pos arx_rt_n7
end
ret arx_copy_bytes dst pos arx_p_dash
end

fn arx_write_then_name t uchar dst edit uchar * pos ulong to ulong
if eq t ARX_THEN_APPROVE
ret arx_copy_bytes dst pos arx_th_n0
end
if eq t ARX_THEN_DENY
ret arx_copy_bytes dst pos arx_th_n1
end
if eq t ARX_THEN_CANCEL
ret arx_copy_bytes dst pos arx_th_n2
end
if eq t ARX_THEN_REMEMBER
ret arx_copy_bytes dst pos arx_th_n3
end
if eq t ARX_THEN_PREFER
ret arx_copy_bytes dst pos arx_th_n4
end
if eq t ARX_THEN_NOTE_TASK
ret arx_copy_bytes dst pos arx_th_n5
end
if eq t ARX_THEN_SPARK_TASK
ret arx_copy_bytes dst pos arx_th_n6
end
ret arx_copy_bytes dst pos arx_p_dash
end

fn arx_write_rwhy_name w uchar dst edit uchar * pos ulong to ulong
if eq w ARX_RWHY_SCORED
ret arx_copy_bytes dst pos arx_rw_n0
end
if eq w ARX_RWHY_EXACT
ret arx_copy_bytes dst pos arx_rw_n1
end
if eq w ARX_RWHY_POLICY
p = arx_copy_bytes dst pos arx_rw_n2
rr = get arx_prop_refuse 0
if eq rr ARX_REFUSE_RULE_BREAK
ret arx_copy_bytes dst p arx_rr_n1
end
if eq rr ARX_REFUSE_OVERRIDE
ret arx_copy_bytes dst p arx_rr_n2
end
if eq rr ARX_REFUSE_FORBIDDEN
ret arx_copy_bytes dst p arx_rr_n3
end
if eq rr ARX_REFUSE_BLANKET
ret arx_copy_bytes dst p arx_rr_n4
end
if eq rr ARX_REFUSE_DATA_ORDER
ret arx_copy_bytes dst p arx_rr_n5
end
ret p
end
if eq w ARX_RWHY_NO_USER
ret arx_copy_bytes dst pos arx_rw_n3
end
if eq w ARX_RWHY_TOO_LONG
ret arx_copy_bytes dst pos arx_rw_n4
end
if eq w ARX_RWHY_NON_ASCII
ret arx_copy_bytes dst pos arx_rw_n5
end
if eq w ARX_RWHY_NO_WORDS
ret arx_copy_bytes dst pos arx_rw_n6
end
if eq w ARX_RWHY_CORE_CLARIFY
ret arx_copy_bytes dst pos arx_rw_n7
end
if eq w ARX_RWHY_MISSING_SUBJ
ret arx_copy_bytes dst pos arx_rw_n8
end
if eq w ARX_RWHY_UNFAMILIAR
ret arx_copy_bytes dst pos arx_rw_n9
end
if eq w ARX_RWHY_UNSURE
ret arx_copy_bytes dst pos arx_rw_n10
end
if eq w ARX_RWHY_NOTHING_PEND
ret arx_copy_bytes dst pos arx_rw_n11
end
if eq w ARX_RWHY_MODEL_UNAVAIL
ret arx_copy_bytes dst pos arx_rw_n12
end
if eq w ARX_RWHY_GUEST_SCOPE
ret arx_copy_bytes dst pos arx_rw_n13
end
if eq w ARX_RWHY_OUT_OF_CAP
ret arx_copy_bytes dst pos arx_rw_n14
end
ret arx_copy_bytes dst pos arx_rw_n15
end

fn arx_proposal_json dst edit uchar * to ulong
tmp32 = new uchar 32 0
p = ulong 0
p = arx_copy_bytes dst p arx_p_s1
p = arx_push_u64 dst p get arx_prop_req 0
p = arx_copy_bytes dst p arx_p_s2
p = arx_push_u64 dst p get arx_prop_sess 0
p = arx_copy_bytes dst p arx_p_s3
if eq get arx_prop_speaker 0 ARX_SPK_OWNER
p = arx_copy_bytes dst p arx_p_owner
else
p = arx_copy_bytes dst p arx_p_guest
end
p = arx_copy_bytes dst p arx_p_s4
i = ulong 0
while lt i 32 bound 32
put tmp32 i get arx_prop_obj i
i = add i 1
end
p = arx_push_hex32 dst p tmp32
p = arx_copy_bytes dst p arx_p_s5
p = arx_write_route_name get arx_prop_route 0 dst p
p = arx_copy_bytes dst p arx_p_s6
p = arx_write_then_name get arx_prop_then 0 dst p
p = arx_copy_bytes dst p arx_p_s7
nr = get arx_prop_not_ready 0
if eq nr ARX_NR_NONE
p = arx_copy_bytes dst p arx_p_yes
else
p = arx_copy_bytes dst p arx_p_no
if eq nr ARX_NR_STORE
p = arx_copy_bytes dst p arx_nr_n0
else
if eq nr ARX_NR_NO_CONSENT
p = arx_copy_bytes dst p arx_nr_n1
else
if eq nr ARX_NR_DESK
p = arx_copy_bytes dst p arx_nr_n2
else
if eq nr ARX_NR_NO_MODEL
p = arx_copy_bytes dst p arx_nr_n3
else
p = arx_copy_bytes dst p arx_nr_n4
end
end
end
end
end
p = arx_copy_bytes dst p arx_p_s8
p = arx_write_route_name get arx_prop_fallback 0 dst p
p = arx_copy_bytes dst p arx_p_s9
p = arx_write_rwhy_name get arx_prop_why 0 dst p
p = arx_copy_bytes dst p arx_p_s10
p = arx_act_write_name get arx_prop_label 0 dst p
p = arx_copy_bytes dst p arx_p_s11
if ne get arx_prop_has_txt 0 0
tl = get arx_prop_tlen 0
i = ulong 0
while lt i tl bound 64
put dst add p i get arx_prop_txt i
i = add i 1
end
p = add p tl
end
p = arx_copy_bytes dst p arx_p_s12
if ne get arx_prop_has_pst1 0 0
i = ulong 0
while lt i 32 bound 32
put tmp32 i get arx_prop_pst1 i
i = add i 1
end
p = arx_push_hex32 dst p tmp32
else
p = arx_copy_bytes dst p arx_p_dash
end
p = arx_copy_bytes dst p arx_p_s13
ret p
end

fn arx_hex_val c uchar to int
if ge c 48
if le c 57
ret int sub c 48
end
end
if ge c 97
if le c 102
ret add 10 int sub c 97
end
end
if ge c 65
if le c 70
ret add 10 int sub c 65
end
end
ret -1
end

fn arx_pct_decode src view uchar * dst edit uchar * to long
n = len src
cap = len dst
i = ulong 0
j = ulong 0
while lt i n bound 4096
if ge j cap
ret -1
end
b = get src i
if eq b 37
if ge add i 2 n
ret -1
end
hi = arx_hex_val get src add i 1
lo = arx_hex_val get src add i 2
if or lt hi 0 lt lo 0
ret -1
end
put dst j uchar or shl hi 4 lo
j = add j 1
i = add i 3
else
put dst j b
j = add j 1
i = add i 1
end
end
ret long j
end

text arx_s_s_s "'s"
text arx_s_can "can"
text arx_s_will "will"
text arx_s_not "not"
text arx_s_am "am"
text arx_s_are "are"
text arx_s_have "have"
text arx_s_would "would"

fn arx_store_tok_words idx ulong w view uchar * to void
st = new uchar 64 0
wn = len w
if gt wn ARX_TOK_STRIDE
wn = ARX_TOK_STRIDE
end
sn = arx_stem_word w wn st
base = mul idx ARX_TOK_STRIDE
k = ulong 0
while lt k wn bound 64
put arx_tok_word add base k get w k
k = add k 1
end
k = ulong 0
while lt k sn bound 64
put arx_tok_stem add base k get st k
k = add k 1
end
put arx_tok_wlen idx wn
put arx_tok_slen idx sn
put arx_tok_whash idx arx_fnv part w 0 wn
put arx_tok_shash idx arx_fnv part st 0 sn
end

fn arx_store_tok s ulong e ulong gapv uchar alnumv uchar w view uchar * to void
idx = get arx_tok_n 0
if ge idx ARX_MAX_TOKENS
ret
end
put arx_tok_start idx s
put arx_tok_end idx e
put arx_tok_gap idx gapv
put arx_tok_alnum idx alnumv
arx_store_tok_words idx w
put arx_tok_n 0 add idx 1
end

fn arx_store_raw_tok s ulong e ulong w view uchar * to void
idx = get arx_tok_n 0
if ge idx ARX_MAX_TOKENS
ret
end
wn = len w
if gt wn ARX_TOK_STRIDE
wn = ARX_TOK_STRIDE
end
base = mul idx ARX_TOK_STRIDE
k = ulong 0
while lt k wn bound 64
put arx_tok_word add base k get w k
put arx_tok_stem add base k get w k
k = add k 1
end
h = arx_fnv part w 0 wn
put arx_tok_start idx s
put arx_tok_end idx e
put arx_tok_gap idx 0
put arx_tok_alnum idx 1
put arx_tok_wlen idx wn
put arx_tok_slen idx wn
put arx_tok_whash idx h
put arx_tok_shash idx h
put arx_tok_n 0 add idx 1
end

fn arx_emit_expanded s ulong e ulong gapv uchar lw view uchar * to void
n = len lw
al = uchar 0
k = ulong 0
while lt k n bound 64
if arx_is_alnum get lw k
al = 1
break
end
k = add k 1
end
if eq n 5
if arx_eq_bytes lw arx_s_cant
arx_store_tok s e gapv al arx_s_can
arx_store_raw_tok s e arx_s_not
ret
end
if arx_eq_bytes lw arx_s_wont
arx_store_tok s e gapv al arx_s_will
arx_store_raw_tok s e arx_s_not
ret
end
end
if gt n 3
if arx_ends_with lw n arx_s_nt
arx_store_tok s e gapv al part lw 0 sub n 3
arx_store_raw_tok s e arx_s_not
ret
end
if arx_ends_with lw n arx_s_re_s
arx_store_tok s e gapv al part lw 0 sub n 3
arx_store_raw_tok s e arx_s_are
ret
end
if arx_ends_with lw n arx_s_ll_s
arx_store_tok s e gapv al part lw 0 sub n 3
arx_store_raw_tok s e arx_s_will
ret
end
if arx_ends_with lw n arx_s_ve_s
arx_store_tok s e gapv al part lw 0 sub n 3
arx_store_raw_tok s e arx_s_have
ret
end
end
if gt n 2
if arx_ends_with lw n arx_s_am_s
arx_store_tok s e gapv al part lw 0 sub n 2
arx_store_raw_tok s e arx_s_am
ret
end
if arx_ends_with lw n arx_s_d_s
arx_store_tok s e gapv al part lw 0 sub n 2
arx_store_raw_tok s e arx_s_would
ret
end
if arx_ends_with lw n arx_s_s_s
arx_store_tok s e gapv al part lw 0 sub n 2
ret
end
end
arx_store_tok s e gapv al lw
end

fn arx_tok_emit_span msg view uchar * s ulong e ulong g uchar to void
lw = new uchar 64 0
lwn = arx_lower_buf part msg s sub e s lw
arx_emit_expanded s e g part lw 0 lwn
end

fn arx_tokenize msg view uchar * max_toks ulong to ulong
put arx_tok_n 0 0
n = len msg
cap = max_toks
if gt cap ARX_MAX_TOKENS
cap = ARX_MAX_TOKENS
end
i = ulong 0
gstart = ulong 0
while lt i n bound 4096
if ge get arx_tok_n 0 cap
break
end
if arx_is_space get msg i
i = add i 1
continue
end
s = i
while lt i n bound 4096
if arx_is_space get msg i
break
end
i = add i 1
end
e = i
while lt s e bound 4096
if not arx_edge_punct get msg s
break
end
s = add s 1
end
while gt e s bound 4096
if not arx_edge_punct get msg sub e 1
break
end
e = sub e 1
end
if eq s e
continue
end
g = arx_gap_flags part msg gstart sub s gstart
gstart = e
arx_tok_emit_span msg s e g
end
if gt get arx_tok_n 0 cap
put arx_tok_n 0 cap
end
ret get arx_tok_n 0
end

fn arx_find_ci hay view uchar * needle view uchar * to long
hn = len hay
nn = len needle
if eq nn 0
ret -1
end
if gt nn hn
ret -1
end
lim = add sub hn nn 1
i = ulong 0
while lt i lim bound 4096
ok = true
j = ulong 0
while lt j nn bound 512
a = arx_to_lower get hay add i j
b = arx_to_lower get needle j
if ne a b
ok = false
break
end
j = add j 1
end
if ok
ret long i
end
i = add i 1
end
ret -1
end

note =========================================================================
note Section 4: Dialog Roles, Turns, and Pending State
note =========================================================================

text arx_s_act_key "\"action\""

fn arx_parse_action s view uchar * to uchar
n = len s
kn = len arx_s_act_key
if lt n kn
ret ARX_ACT_INVALID
end
found = false
pos = ulong 0
lim = add sub n kn 1
i = ulong 0
while lt i lim bound 4096
ok = true
j = ulong 0
while lt j kn bound 16
if ne get s add i j get arx_s_act_key j
ok = false
break
end
j = add j 1
end
if ok
found = true
pos = add i kn
break
end
i = add i 1
end
if not found
ret ARX_ACT_INVALID
end
colon = false
while lt pos n bound 4096
if eq get s pos 58
colon = true
pos = add pos 1
break
end
pos = add pos 1
end
if not colon
ret ARX_ACT_INVALID
end
while lt pos n bound 4096
if not arx_is_space get s pos
break
end
pos = add pos 1
end
if ge pos n
ret ARX_ACT_INVALID
end
if ne get s pos 34
ret ARX_ACT_INVALID
end
pos = add pos 1
es = pos
while lt pos n bound 4096
if eq get s pos 34
ret arx_act_from_name part s es sub pos es
end
pos = add pos 1
end
ret ARX_ACT_INVALID
end

fn arx_clear_turns to void
put arx_turn_n 0 0
end

fn arx_push_turn role uchar txt view uchar * to void
idx = get arx_turn_n 0
if ge idx ARX_MAX_TURNS_CAP
ret
end
rn = len txt
n = rn
if gt n ARX_TURN_STRIDE
n = ARX_TURN_STRIDE
end
put arx_turn_role idx role
put arx_turn_len idx n
put arx_turn_raw_len idx rn
base = mul idx ARX_TURN_STRIDE
i = ulong 0
while lt i n bound 512
put arx_turn_buf add base i get txt i
i = add i 1
end
put arx_turn_n 0 add idx 1
end

fn arx_exam_turns s view uchar * to void
arx_clear_turns
n = len s
role = ARX_ROLE_USER
seg = ulong 0
i = ulong 0
while lt i n bound 16384
is_sep = false
if lt add i 3 n
if eq get s i 32
if eq get s add i 1 126
if eq get s add i 2 126
if eq get s add i 3 32
is_sep = true
end
end
end
end
end
if is_sep
arx_push_turn role part s seg sub i seg
if eq role ARX_ROLE_USER
role = ARX_ROLE_ASST
else
role = ARX_ROLE_USER
end
i = add i 4
seg = i
else
i = add i 1
end
end
arx_push_turn role part s seg sub n seg
end

fn arx_load_turn_buf idx ulong dst edit uchar * to ulong
n = get arx_turn_len idx
base = mul idx ARX_TURN_STRIDE
i = ulong 0
while lt i n bound 512
put dst i get arx_turn_buf add base i
i = add i 1
end
ret n
end

fn arx_dialog_state max_turns ulong to void
tmp = new uchar 512 0
tn = get arx_turn_n 0
start = ulong 0
if gt tn max_turns
start = sub tn max_turns
end
has_u = uchar 0
last_u = ulong 0
i = start
while lt i tn bound 64
if eq get arx_turn_role i ARX_ROLE_USER
has_u = 1
last_u = i
end
i = add i 1
end
pend = ARX_PEND_UNKNOWN
prev = ARX_ACT_INVALID
if eq has_u 1
j = start
while lt j last_u bound 64
if eq get arx_turn_role j ARX_ROLE_ASST
ln = arx_load_turn_buf j tmp
a = arx_parse_action part tmp 0 ln
prev = a
if ne a ARX_ACT_INVALID
if arx_act_creates_pending a
pend = ARX_PEND_YES
else
if arx_act_needs_pending a
pend = ARX_PEND_NO
end
end
end
end
j = add j 1
end
end
put arx_dlg_pending 0 pend
put arx_dlg_prev 0 prev
put arx_dlg_has_user 0 has_u
put arx_dlg_last_user 0 last_u
end


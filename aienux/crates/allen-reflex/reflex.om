text arx_lex_and_verbs "approve deny cancel recall show list check read tell give reject accept"
text arx_lex_trail_mark "afterwards afterward later next"
text arx_lex_trail_polite "please thanks"
text arx_lex_ambiguous "update format restart upgrade"

note Section 3: Text Normalization, Tokenization, Stemming, Hashing
note =========================================================================

fn arx_fnv s view uchar * to ulong
h = ulong 0xcbf29ce484222325
n = len s
i = ulong 0
while lt i n bound 4096
h = xor h ulong get s i
h = mul h ulong 0x00000100000001b3
i = add i 1
end
ret h
end

fn arx_is_space b uchar to bool
if eq b 32
ret true
end
if eq b 9
ret true
end
if eq b 10
ret true
end
if eq b 13
ret true
end
if eq b 12
ret true
end
ret false
end

fn arx_is_alpha b uchar to bool
if ge b 65
if le b 90
ret true
end
end
if ge b 97
if le b 122
ret true
end
end
ret false
end

fn arx_is_digit b uchar to bool
if ge b 48
if le b 57
ret true
end
end
ret false
end

fn arx_is_alnum b uchar to bool
if arx_is_alpha b
ret true
end
ret arx_is_digit b
end

fn arx_to_lower b uchar to uchar
if ge b 65
if le b 90
ret add b 32
end
end
ret b
end

fn arx_edge_punct b uchar to bool
if eq b 46
ret true
end
if eq b 44
ret true
end
if eq b 59
ret true
end
if eq b 58
ret true
end
if eq b 33
ret true
end
if eq b 63
ret true
end
if eq b 34
ret true
end
if eq b 39
ret true
end
if eq b 40
ret true
end
if eq b 41
ret true
end
if eq b 91
ret true
end
if eq b 93
ret true
end
if eq b 123
ret true
end
if eq b 125
ret true
end
if eq b 45
ret true
end
if eq b 96
ret true
end
if eq b 42
ret true
end
ret false
end

fn arx_gap_flags s view uchar * to uchar
f = uchar 0
n = len s
i = ulong 0
while lt i n bound 4096
b = get s i
if eq b 46
f = or f ARX_GAP_STOP
else
if eq b 33
f = or f ARX_GAP_STOP
else
if eq b 63
f = or f or ARX_GAP_STOP ARX_GAP_QUESTION
else
if eq b 44
f = or f ARX_GAP_COMMA
else
if eq b 58
f = or f ARX_GAP_COLON
else
if eq b 59
f = or f ARX_GAP_SEMI
else
if eq b 45
lok = false
if eq i 0
lok = true
else
pb = get s sub i 1
if or eq pb 32 eq pb 45
lok = true
end
end
rok = false
if eq add i 1 n
rok = true
else
nb = get s add i 1
if or eq nb 32 eq nb 45
rok = true
end
end
if and lok rok
f = or f ARX_GAP_DASH
end
end
end
end
end
end
end
end
i = add i 1
end
ret f
end

fn arx_lower_buf src view uchar * dst edit uchar * to ulong
n = len src
cap = len dst
i = ulong 0
j = ulong 0
while lt i n bound 4096
if ge j cap
break
end
b = get src i
curly = false
if eq b 0xe2
if lt add i 2 n
if eq get src add i 1 0x80
b2 = get src add i 2
if or eq b2 0x99 eq b2 0x98
curly = true
end
end
end
end
if curly
put dst j uchar 39
j = add j 1
i = add i 3
else
put dst j arx_to_lower b
j = add j 1
i = add i 1
end
end
ret j
end

fn arx_ends_with buf view uchar * n ulong suf view uchar * to bool
sn = len suf
if lt n sn
ret false
end
off = sub n sn
i = ulong 0
while lt i sn bound 64
if ne get buf add off i get suf i
ret false
end
i = add i 1
end
ret true
end

text arx_s_ing "ing"
text arx_s_ies "ies"
text arx_s_ed "ed"
text arx_s_eed "eed"
text arx_s_ss "ss"
text arx_s_us "us"
text arx_s_is "is"

fn arx_stem_word src view uchar * n ulong dst edit uchar * to ulong
all_a = true
i = ulong 0
while lt i n bound 64
if not arx_is_alpha get src i
all_a = false
break
end
i = add i 1
end
out_n = n
if all_a
if gt n 3
done = false
if gt n 5
if arx_ends_with src n arx_s_ing
out_n = sub n 3
done = true
end
end
if not done
if gt n 4
if arx_ends_with src n arx_s_ies
k = ulong 0
lim = sub n 3
while lt k lim bound 64
put dst k get src k
k = add k 1
end
put dst lim uchar 121
ret add lim 1
end
end
end
if not done
if gt n 4
if arx_ends_with src n arx_s_ed
if not arx_ends_with src n arx_s_eed
out_n = sub n 2
done = true
end
end
end
end
if not done
if eq get src sub n 1 115
if not arx_ends_with src n arx_s_ss
if not arx_ends_with src n arx_s_us
if not arx_ends_with src n arx_s_is
out_n = sub n 1
end
end
end
end
end
end
end
k = ulong 0
while lt k out_n bound 64
put dst k get src k
k = add k 1
end
ret out_n
end


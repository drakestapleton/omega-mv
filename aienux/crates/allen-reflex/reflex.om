fn arx_tok_eq_slice tidx ulong s view uchar * off ulong slen ulong to bool
wn = get arx_tok_wlen tidx
if ne wn slen
ret false
end
base = mul tidx ARX_TOK_STRIDE
i = ulong 0
while lt i wn bound 64
if ne get arx_tok_word add base i get s add off i
ret false
end
i = add i 1
end
ret true
end

fn arx_tok_eq_text tidx ulong s view uchar * to bool
ret arx_tok_eq_slice tidx s 0 len s
end

fn arx_word_in_list tidx ulong lst view uchar * to bool
n = len lst
i = ulong 0
while lt i n bound 2048
if eq get lst i 32
i = add i 1
continue
end
ws = i
while lt i n bound 2048
if eq get lst i 32
break
end
i = add i 1
end
if arx_tok_eq_slice tidx lst ws sub i ws
ret true
end
end
ret false
end

fn arx_match_phrase_slice pos ulong tok_end ulong lst view uchar * ps ulong pe ulong to ulong
wc = ulong 0
p = ps
while lt p pe bound 256
if eq get lst p 32
p = add p 1
continue
end
ws = p
while lt p pe bound 256
if eq get lst p 32
break
end
p = add p 1
end
if ge add pos wc tok_end
ret 0
end
if not arx_tok_eq_slice add pos wc lst ws sub p ws
ret 0
end
wc = add wc 1
end
ret wc
end

fn arx_longest_phrase pos ulong tok_end ulong lst view uchar * to ulong
n = len lst
best = ulong 0
i = ulong 0
while lt i n bound 2048
ps = i
while lt i n bound 2048
if eq get lst i 10
break
end
i = add i 1
end
pe = i
if lt i n
i = add i 1
end
wc = arx_match_phrase_slice pos tok_end lst ps pe
if gt wc best
best = wc
end
end
ret best
end

fn arx_skip_polite pos ulong tok_end ulong to ulong
cur = pos
while lt cur tok_end bound 256
m = arx_longest_phrase cur tok_end arx_lex_polite
if eq m 0
ret cur
end
if gt add cur m tok_end
ret cur
end
cur = add cur m
end
ret cur
end

note =========================================================================
note Section 6: Segmentation (Clauses and Primary Request)
note =========================================================================

text arx_s_then "then"
text arx_s_and "and"
text arx_s_after "after"
text arx_s_that "that"

fn arx_push_clause cs ulong ce ulong to void
cn = get arx_cl_n 0
if ge cn ARX_MAX_CLAUSES
ret
end
put arx_cl_start cn cs
put arx_cl_end cn ce
put arx_cl_n 0 add cn 1
end

fn arx_clauses to ulong
put arx_cl_n 0 0
n = get arx_tok_n 0
s = ulong 0
i = ulong 0
while lt i n bound 256
g = get arx_tok_gap i
if gt i s
if ne and g ARX_GAP_SEMI 0
arx_push_clause s i
s = i
i = add i 1
continue
end
end
if arx_tok_eq_text i arx_s_then
if gt i s
prev_and = false
if gt sub i 1 s
if arx_tok_eq_text sub i 1 arx_s_and
prev_and = true
end
end
has_sep = ne and g or ARX_GAP_COMMA ARX_GAP_STOP 0
if or prev_and has_sep
ce = i
if prev_and
ce = sub i 1
end
arx_push_clause s ce
s = add i 1
i = add i 1
continue
end
end
end
if arx_tok_eq_text i arx_s_after
if lt add i 1 n
if arx_tok_eq_text add i 1 arx_s_that
if gt i s
prev_and = false
if gt sub i 1 s
if arx_tok_eq_text sub i 1 arx_s_and
prev_and = true
end
end
has_sep = ne and g or ARX_GAP_COMMA ARX_GAP_STOP 0
if or prev_and has_sep
ce = i
if prev_and
ce = sub i 1
end
arx_push_clause s ce
s = add i 2
i = add i 2
continue
end
end
end
end
end
if arx_tok_eq_text i arx_s_and
if gt i s
if lt add i 1 n
if arx_word_in_list add i 1 arx_lex_and_verbs
arx_push_clause s i
s = add i 1
i = add i 1
continue
end
end
end
end
i = add i 1
end
if lt s n
arx_push_clause s n
end
note Strip trailing markers and drop empty clauses
cn = get arx_cl_n 0
out_n = ulong 0
k = ulong 0
while lt k cn bound 64
cs = get arx_cl_start k
ce = get arx_cl_end k
while gt ce cs bound 256
if not arx_word_in_list sub ce 1 arx_lex_trail_mark
break
end
ce = sub ce 1
end
if gt ce cs
put arx_cl_start out_n cs
put arx_cl_end out_n ce
out_n = add out_n 1
end
k = add k 1
end
put arx_cl_n 0 out_n
ret out_n
end

fn arx_all_filler cs ulong ce ulong to bool
if le ce cs
ret false
end
i = cs
while lt i ce bound 256
if ne get arx_tok_alnum i 0
if not arx_word_in_list i arx_lex_filler
ret false
end
end
i = add i 1
end
ret true
end

fn arx_primary to bool
cn = get arx_cl_n 0
if eq cn 0
ret false
end
cs = get arx_cl_start 0
ce = get arx_cl_end 0
k = ulong 0
while lt k cn bound 64
ks = get arx_cl_start k
ke = get arx_cl_end k
if not arx_all_filler ks ke
cs = ks
ce = ke
break
end
k = add k 1
end
note Drop leading filler sentences
while lt cs ce bound 64
j = add cs 1
while lt j ce bound 256
if ne and get arx_tok_gap j ARX_GAP_STOP 0
break
end
j = add j 1
end
if lt j ce
if arx_all_filler cs j
cs = j
continue
end
end
break
end
note Drop leading FILLER_COMMA before comma
while gt sub ce cs 1 bound 64
if arx_word_in_list cs arx_lex_filler_comma
if ne and get arx_tok_gap add cs 1 ARX_GAP_COMMA 0
cs = add cs 1
continue
end
end
break
end
put arx_pri_start 0 cs
put arx_pri_end 0 ce
ret true
end

note =========================================================================
note Section 7: Policy Layer
note =========================================================================

text arx_s_shut "shut"
text arx_s_down "down"
text arx_s_power "power"
text arx_s_off "off"
text arx_s_turn "turn"
text arx_s_switch "switch"
text arx_s_approve "approve"
text arx_s_accept "accept"

fn arx_negated i ulong lo ulong to bool
from = lo
if ge i add lo 2
from = sub i 2
end
k = from
while lt k i bound 4
if arx_word_in_list k arx_lex_negation
ret true
end
k = add k 1
end
ret false
end

fn arx_check_split_pair i ulong cl_k ulong a view uchar * b view uchar * to bool
cs = get arx_cl_start cl_k
ce = get arx_cl_end cl_k
if not arx_tok_eq_text i a
ret false
end
if arx_negated i cs
ret false
end
hi = add i 5
if gt hi ce
hi = ce
end
found = false
k = add i 1
while lt k hi bound 8
if arx_tok_eq_text k b
found = true
break
end
k = add k 1
end
if not found
ret false
end
j = cs
while lt j ce bound 256
if arx_word_in_list j arx_lex_device_obj
ret false
end
j = add j 1
end
ret true
end

fn arx_policy_check_tok i ulong k ulong lead ulong to uchar
cs = get arx_cl_start k
ce = get arx_cl_end k
n = get arx_tok_n 0
if arx_word_in_list i arx_lex_rb_verbs
if not arx_negated i cs
hi = add i 4
if gt hi ce
hi = ce
end
j = add i 1
while lt j hi bound 8
if arx_word_in_list j arx_lex_rb_objs
ret ARX_REFUSE_RULE_BREAK
end
j = add j 1
end
end
end
if gt arx_longest_phrase i n arx_lex_override 0
ret ARX_REFUSE_OVERRIDE
end
if arx_word_in_list i arx_lex_forbidden
if not arx_negated i cs
noun = false
if gt i cs
if arx_word_in_list sub i 1 arx_lex_determiners
noun = true
end
end
amb = arx_word_in_list i arx_lex_ambiguous
vpos = eq i lead
if gt i cs
if arx_word_in_list sub i 1 arx_lex_verb_leads
vpos = true
end
end
if not noun
if or not amb vpos
ret ARX_REFUSE_FORBIDDEN
end
end
end
end
if arx_check_split_pair i k arx_s_shut arx_s_down
ret ARX_REFUSE_FORBIDDEN
end
if arx_check_split_pair i k arx_s_power arx_s_off
ret ARX_REFUSE_FORBIDDEN
end
if arx_check_split_pair i k arx_s_power arx_s_down
ret ARX_REFUSE_FORBIDDEN
end
if arx_check_split_pair i k arx_s_turn arx_s_off
ret ARX_REFUSE_FORBIDDEN
end
if arx_check_split_pair i k arx_s_switch arx_s_off
ret ARX_REFUSE_FORBIDDEN
end
if or arx_tok_eq_text i arx_s_approve arx_tok_eq_text i arx_s_accept
j = cs
while lt j ce bound 256
if arx_word_in_list j arx_lex_blanket
ret ARX_REFUSE_BLANKET
end
j = add j 1
end
end
ret ARX_REFUSE_NONE
end

fn arx_policy_check to uchar
put arx_pol_rule 0 ARX_REFUSE_NONE
put arx_pol_tok 0 0
n = get arx_tok_n 0
i = ulong 0
while lt i n bound 256
put arx_pol_exempt i 0
i = add i 1
end
cn = get arx_cl_n 0
k = ulong 0
while lt k cn bound 64
cs = get arx_cl_start k
ce = get arx_cl_end k
lead = arx_skip_polite cs ce
f = arx_longest_phrase lead ce arx_lex_text_frames
if gt f 0
j = add lead f
while lt j ce bound 256
put arx_pol_exempt j 1
j = add j 1
end
end
k = add k 1
end
has_rep = false
rep_at = ulong 0
k = ulong 0
while lt k cn bound 64
cs = get arx_cl_start k
ce = get arx_cl_end k
lead = arx_skip_polite cs ce
i = cs
while lt i ce bound 256
if eq get arx_pol_exempt i 0
r = arx_policy_check_tok i k lead
if ne r ARX_REFUSE_NONE
put arx_pol_rule 0 r
put arx_pol_tok 0 i
ret r
end
if not has_rep
if arx_word_in_list i arx_lex_report
has_rep = true
rep_at = i
end
end
end
i = add i 1
end
k = add k 1
end
if has_rep
i = add rep_at 1
while lt i n bound 256
if eq get arx_pol_exempt i 0
if gt arx_longest_phrase i n arx_lex_obey 0
put arx_pol_rule 0 ARX_REFUSE_DATA_ORDER
put arx_pol_tok 0 i
ret ARX_REFUSE_DATA_ORDER
end
end
i = add i 1
end
end
ret ARX_REFUSE_NONE
end

note =========================================================================
note Section 8: Feature Extraction
note =========================================================================

fn arx_feat_key idx ulong to ulong
b = new uchar 40 0
put b 0 get arx_ft_ch idx
fl = ulong get arx_ft_len idx
base = mul idx 4
k = ulong 0
while lt k fl bound 4
off = add 1 mul k 9
put b off get arx_ft_fam add base k
v = get arx_ft_val add base k
put b add off 1 uchar and v 255
put b add off 2 uchar and shr v 8 255
put b add off 3 uchar and shr v 16 255
put b add off 4 uchar and shr v 24 255
put b add off 5 uchar and shr v 32 255
put b add off 6 uchar and shr v 40 255
put b add off 7 uchar and shr v 48 255
put b add off 8 uchar and shr v 56 255
k = add k 1
end
ret arx_fnv part b 0 add 1 mul fl 9
end

fn arx_rest_content cs ulong ce ulong to ulong
lead = arx_skip_polite cs ce
f = arx_longest_phrase lead ce arx_lex_text_frames
st = add lead f
if gt st ce
st = ce
end
cnt = ulong 0
i = st
while lt i ce bound 256
if ne get arx_tok_alnum i 0
if not arx_word_in_list i arx_lex_vacuous
if not arx_word_in_list i arx_lex_filler
cnt = add cnt 1
end
end
end
i = add i 1
end
ret cnt
end

fn arx_concepts_at i ulong ce ulong to uint
m = uint 0
if gt arx_longest_phrase i ce arx_lex_c0 0
m = or m shl uint 1 0
end
if gt arx_longest_phrase i ce arx_lex_c1 0
m = or m shl uint 1 1
end
if gt arx_longest_phrase i ce arx_lex_c2 0
m = or m shl uint 1 2
end
if gt arx_longest_phrase i ce arx_lex_c3 0
m = or m shl uint 1 3
end
if gt arx_longest_phrase i ce arx_lex_c4 0
m = or m shl uint 1 4
end
if gt arx_longest_phrase i ce arx_lex_c5 0
m = or m shl uint 1 5
end
if gt arx_longest_phrase i ce arx_lex_c6 0
m = or m shl uint 1 6
end
if gt arx_longest_phrase i ce arx_lex_c7 0
m = or m shl uint 1 7
end
if gt arx_longest_phrase i ce arx_lex_c8 0
m = or m shl uint 1 8
end
if gt arx_longest_phrase i ce arx_lex_c9 0
m = or m shl uint 1 9
end
if gt arx_longest_phrase i ce arx_lex_c10 0
m = or m shl uint 1 10
end
if gt arx_longest_phrase i ce arx_lex_c11 0
m = or m shl uint 1 11
end
if gt arx_longest_phrase i ce arx_lex_c12 0
m = or m shl uint 1 12
end
if gt arx_longest_phrase i ce arx_lex_c13 0
m = or m shl uint 1 13
end
if gt arx_longest_phrase i ce arx_lex_c14 0
m = or m shl uint 1 14
end
if gt arx_longest_phrase i ce arx_lex_c15 0
m = or m shl uint 1 15
end
if gt arx_longest_phrase i ce arx_lex_c16 0
m = or m shl uint 1 16
end
ret m
end

fn arx_concepts cs ulong ce ulong to uint
m = uint 0
i = cs
while lt i ce bound 256
m = or m arx_concepts_at i ce
i = add i 1
end
ret m
end

fn arx_ft_push1 ch ulong f0 uchar v0 ulong to void
wt = get arx_cfg_weights ch
if eq wt 0
ret
end
idx = get arx_ft_n 0
if ge idx ARX_MAX_FEATS
ret
end
b = mul idx 4
put arx_ft_fam b f0
put arx_ft_val b v0
put arx_ft_len idx 1
put arx_ft_ch idx uchar ch
put arx_ft_w idx wt
put arx_ft_n 0 add idx 1
end

fn arx_ft_push2 ch ulong f0 uchar v0 ulong f1 uchar v1 ulong to void
wt = get arx_cfg_weights ch
if eq wt 0
ret
end
idx = get arx_ft_n 0
if ge idx ARX_MAX_FEATS
ret
end
b = mul idx 4
put arx_ft_fam b f0
put arx_ft_val b v0
put arx_ft_fam add b 1 f1
put arx_ft_val add b 1 v1
put arx_ft_len idx 2
put arx_ft_ch idx uchar ch
put arx_ft_w idx wt
put arx_ft_n 0 add idx 1
end

fn arx_ft_push_chars buf view uchar * pos ulong g ulong to void
wt = get arx_cfg_weights ARX_CH_CHARS
if eq wt 0
ret
end
idx = get arx_ft_n 0
if ge idx ARX_MAX_FEATS
ret
end
b = mul idx 4
k = ulong 0
while lt k g bound 4
put arx_ft_fam add b k ARX_SYM_CHAR
put arx_ft_val add b k ulong get buf add pos k
k = add k 1
end
put arx_ft_len idx uchar g
put arx_ft_ch idx uchar ARX_CH_CHARS
put arx_ft_w idx wt
put arx_ft_n 0 add idx 1
end

fn arx_extract_char_ngrams tidx ulong to void
buf = new uchar 34 0
wn = get arx_tok_wlen tidx
if gt wn 32
wn = 32
end
put buf 0 uchar 94
base = mul tidx ARX_TOK_STRIDE
k = ulong 0
while lt k wn bound 32
put buf add k 1 get arx_tok_word add base k
k = add k 1
end
put buf add wn 1 uchar 36
sn = add wn 2
if ge sn 3
lim3 = sub sn 2
i = ulong 0
while lt i lim3 bound 34
arx_ft_push_chars buf i 3
i = add i 1
end
end
if ge sn 4
lim4 = sub sn 3
i = ulong 0
while lt i lim4 bound 34
arx_ft_push_chars buf i 4
i = add i 1
end
end
end

fn arx_ef_concepts_lead cs ulong ce ulong to void
pend = ulong get arx_dlg_pending 0
cm = arx_concepts cs ce
k = ulong 0
while lt k ARX_N_CONCEPTS bound 18
if ne and cm shl uint 1 uint k 0
arx_ft_push1 ARX_CH_CONCEPT ARX_SYM_CONCEPT k
arx_ft_push2 ARX_CH_CTXCONJ ARX_SYM_CTX pend ARX_SYM_CONCEPT k
end
k = add k 1
end
lead = arx_skip_polite cs ce
if lt lead ce
hl = get arx_tok_shash lead
arx_ft_push1 ARX_CH_LEAD ARX_SYM_LEAD hl
arx_ft_push2 ARX_CH_CTXCONJ ARX_SYM_CTX pend ARX_SYM_LEAD hl
if lt add lead 1 ce
h2 = get arx_tok_shash add lead 1
arx_ft_push2 ARX_CH_LEAD ARX_SYM_LEAD hl ARX_SYM_WORD h2
end
end
arx_ft_push1 ARX_CH_CTX ARX_SYM_CTX pend
prev_a = get arx_dlg_prev 0
prev_v = ulong 0
if ne prev_a ARX_ACT_INVALID
prev_v = add ulong prev_a 1
end
arx_ft_push1 ARX_CH_CTX ARX_SYM_CTX add 16 prev_v
end

fn arx_ef_ctx_shape cs ulong ce ulong wn ulong ends_q bool to void
arx_ef_concepts_lead cs ce
lb = ulong 4
if le wn 1
lb = 0
else
if eq wn 2
lb = 1
else
if le wn 4
lb = 2
else
if le wn 8
lb = 3
end
end
end
end
arx_ft_push1 ARX_CH_SHAPE ARX_SYM_SHAPE lb
has_q = ends_q
if not has_q
j = add cs 1
while lt j ce bound 256
if ne and get arx_tok_gap j ARX_GAP_QUESTION 0
has_q = true
break
end
j = add j 1
end
end
if has_q
arx_ft_push1 ARX_CH_SHAPE ARX_SYM_SHAPE 10
end
rc = arx_rest_content cs ce
rv = ulong 22
if eq rc 0
rv = 20
else
if le rc 2
rv = 21
end
end
arx_ft_push1 ARX_CH_SHAPE ARX_SYM_SHAPE rv
end

fn arx_extract_features cs ulong ce ulong ends_q bool to ulong
words = new ulong 256 0
seen = new ulong 256 0
put arx_ft_n 0 0
wn = ulong 0
i = cs
while lt i ce bound 256
if ne get arx_tok_alnum i 0
put words wn i
wn = add wn 1
end
i = add i 1
end
sn = ulong 0
i = ulong 0
while lt i wn bound 256
h = get arx_tok_shash get words i
dup = false
j = ulong 0
while lt j sn bound 256
if eq get seen j h
dup = true
break
end
j = add j 1
end
if not dup
put seen sn h
sn = add sn 1
arx_ft_push1 ARX_CH_WORD ARX_SYM_WORD h
end
i = add i 1
end
if ge wn 2
lim = sub wn 1
i = ulong 0
while lt i lim bound 256
ha = get arx_tok_shash get words i
hb = get arx_tok_shash get words add i 1
arx_ft_push2 ARX_CH_BIGRAM ARX_SYM_WORD ha ARX_SYM_WORD hb
i = add i 1
end
end
if ne get arx_cfg_weights ARX_CH_CHARS 0
i = ulong 0
while lt i wn bound 256
arx_extract_char_ngrams get words i
i = add i 1
end
end
arx_ef_ctx_shape cs ce wn ends_q
ret get arx_ft_n 0
end

note =========================================================================
note Section 9: Binary Hypervectors
note =========================================================================

fn arx_splitmix_next s ulong to ulong
z = s
z = mul xor z shr z 30 ulong 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 ulong 0x94d049bb133111eb
ret xor z shr z 31
end

fn arx_popcnt64 x ulong to uint
v = sub x and shr x 1 ulong 0x5555555555555555
v = add and v ulong 0x3333333333333333 and shr v 2 ulong 0x3333333333333333
v = and add v shr v 4 ulong 0x0f0f0f0f0f0f0f0f
ret uint shr mul v ulong 0x0101010101010101 56
end

fn arx_hv_item fam ulong val ulong dst edit ulong * to void
s = xor xor ARX_SEED mul fam ulong 0xd6e8feb86659fd93 val
s = add s ulong 0x9e3779b97f4a7c15
w = len dst
i = ulong 0
while lt i w bound 128
s = add s ulong 0x9e3779b97f4a7c15
put dst i arx_splitmix_next s
i = add i 1
end
end

fn arx_hv_bind_sym fam ulong val ulong rot ulong w ulong to void
tmp = new ulong 128 0
arx_hv_item fam val part tmp 0 w
x = ulong 0
while lt x w bound 128
dst_x = add x rot
if ge dst_x w
dst_x = sub dst_x w
end
xv = xor get arx_hv_acc dst_x get tmp x
put arx_hv_acc dst_x xv
x = add x 1
end
end

fn arx_hv_bind_feat fidx ulong w ulong to void
x = ulong 0
while lt x w bound 128
put arx_hv_acc x 0
x = add x 1
end
fl = ulong get arx_ft_len fidx
base = mul fidx 4
j = ulong 0
while lt j fl bound 4
idx = add base j
fam = ulong get arx_ft_fam idx
val = get arx_ft_val idx
rot = rem sub sub fl 1 j w
arx_hv_bind_sym fam val rot w
j = add j 1
end
end

fn arx_hv_accum_feat f ulong w ulong to void
arx_hv_bind_feat f w
wt = int get arx_ft_w f
x = ulong 0
while lt x w bound 128
v = get arx_hv_acc x
base = mul x 64
b = ulong 0
while lt b 64 bound 64
bit = int and shr v b 1
delta = mul sub mul 2 bit 1 wt
ci = add base b
nv = add get arx_hv_cnt ci delta
put arx_hv_cnt ci nv
b = add b 1
end
x = add x 1
end
end

fn arx_hv_finalize_q w ulong to void
tmp = new ulong 128 0
arx_hv_item 7 0 part tmp 0 w
x = ulong 0
while lt x w bound 128
o = ulong 0
tv = get tmp x
base = mul x 64
b = ulong 0
while lt b 64 bound 64
c = get arx_hv_cnt add base b
bit = ulong 0
if gt c 0
bit = 1
else
if eq c 0
bit = and shr tv b 1
end
end
o = or o shl bit b
b = add b 1
end
put arx_hv_q x o
x = add x 1
end
end

fn arx_hv_encode_to_q w ulong to void
d = mul w 64
i = ulong 0
while lt i d bound 8192
put arx_hv_cnt i 0
i = add i 1
end
fn_cnt = get arx_ft_n 0
f = ulong 0
while lt f fn_cnt bound 768
arx_hv_accum_feat f w
f = add f 1
end
arx_hv_finalize_q w
end

fn arx_hv_sim_q_ex ex_idx ulong w ulong to f32
ham = uint 0
base = mul ex_idx w
x = ulong 0
while lt x w bound 128
va = get arx_hv_q x
vb = get arx_hv_hvs add base x
pc = arx_popcnt64 xor va vb
ham = add ham pc
x = add x 1
end
d = f32 mul w 64
ret sub 1.0f32 div mul 2.0f32 f32 ham d
end

fn arx_hv_sim_ex_ex a ulong b ulong w ulong to f32
ham = uint 0
ba = mul a w
bb = mul b w
x = ulong 0
while lt x w bound 128
va = get arx_hv_hvs add ba x
vb = get arx_hv_hvs add bb x
pc = arx_popcnt64 xor va vb
ham = add ham pc
x = add x 1
end
d = f32 mul w 64
ret sub 1.0f32 div mul 2.0f32 f32 ham d
end

note =========================================================================
note Section 10: Span Extraction and CueMemory
note =========================================================================

text arx_s_thank "thank"
text arx_s_you "you"

fn arx_cue_reset to void
put arx_cue_pre_n 0 0
put arx_cue_suf_n 0 0
put arx_cue_st_n 0 0
end

fn arx_cue_pre_same idx ulong s ulong clen ulong to bool
base = mul idx ARX_MAX_CUE_WORDS
k = ulong 0
while lt k clen bound 8
ha = get arx_cue_pre_h add base k
hb = get arx_tok_whash add s k
if ne ha hb
ret false
end
k = add k 1
end
ret true
end

fn arx_cue_add_pre a uchar s ulong e ulong to void
clen = sub e s
if gt clen ARX_MAX_CUE_WORDS
ret
end
if ge add get arx_cue_pre_n 0 get arx_cue_suf_n 0 ARX_MAX_CUES
ret
end
pn = get arx_cue_pre_n 0
i = ulong 0
while lt i pn bound 256
if eq get arx_cue_pre_act i a
if eq ulong get arx_cue_pre_len i clen
if arx_cue_pre_same i s clen
ret
end
end
end
i = add i 1
end
put arx_cue_pre_act pn a
put arx_cue_pre_len pn uchar clen
base = mul pn ARX_MAX_CUE_WORDS
k = ulong 0
while lt k clen bound 8
hv = get arx_tok_whash add s k
put arx_cue_pre_h add base k hv
k = add k 1
end
put arx_cue_pre_n 0 add pn 1
end

fn arx_cue_suf_same idx ulong s ulong clen ulong to bool
base = mul idx ARX_MAX_CUE_WORDS
k = ulong 0
while lt k clen bound 8
ha = get arx_cue_suf_h add base k
hb = get arx_tok_whash add s k
if ne ha hb
ret false
end
k = add k 1
end
ret true
end

fn arx_cue_add_suf a uchar s ulong e ulong to void
clen = sub e s
if gt clen ARX_MAX_CUE_WORDS
ret
end
if ge add get arx_cue_pre_n 0 get arx_cue_suf_n 0 ARX_MAX_CUES
ret
end
sn = get arx_cue_suf_n 0
i = ulong 0
while lt i sn bound 256
if eq get arx_cue_suf_act i a
if eq ulong get arx_cue_suf_len i clen
if arx_cue_suf_same i s clen
ret
end
end
end
i = add i 1
end
put arx_cue_suf_act sn a
put arx_cue_suf_len sn uchar clen
base = mul sn ARX_MAX_CUE_WORDS
k = ulong 0
while lt k clen bound 8
hv = get arx_tok_whash add s k
put arx_cue_suf_h add base k hv
k = add k 1
end
put arx_cue_suf_n 0 add sn 1
end

fn arx_cue_bump a uchar h ulong is_cue bool to void
sn = get arx_cue_st_n 0
i = ulong 0
while lt i sn bound 2048
if eq get arx_cue_st_act i a
if eq get arx_cue_st_h i h
if is_cue
v = get arx_cue_st_c i
if lt v 65535
put arx_cue_st_c i add v 1
end
else
v = get arx_cue_st_p i
if lt v 65535
put arx_cue_st_p i add v 1
end
end
ret
end
end
i = add i 1
end
if ge sn ARX_MAX_STATS
ret
end
put arx_cue_st_act sn a
put arx_cue_st_h sn h
if is_cue
put arx_cue_st_c sn 1
put arx_cue_st_p sn 0
else
put arx_cue_st_c sn 0
put arx_cue_st_p sn 1
end
put arx_cue_st_n 0 add sn 1
end

note Returns 0=unknown, 1=false (content), 2=true (cue)
fn arx_cue_like a uchar h ulong to uchar
sn = get arx_cue_st_n 0
i = ulong 0
while lt i sn bound 2048
if eq get arx_cue_st_act i a
if eq get arx_cue_st_h i h
if gt get arx_cue_st_c i get arx_cue_st_p i
ret 2
end
ret 1
end
end
i = add i 1
end
ret 0
end

fn arx_cue_learn cs ulong ce ulong act uchar bs ulong be ulong to bool
lead = arx_skip_polite cs ce
has_s = false
s0 = ulong 0
i = cs
while lt i ce bound 256
if ge get arx_tok_start i bs
has_s = true
s0 = i
break
end
i = add i 1
end
has_e = false
e0 = ulong 0
if gt ce cs
i = sub ce 1
while ge i cs bound 256
if le get arx_tok_end i be
has_e = true
e0 = i
break
end
if eq i cs
break
end
i = sub i 1
end
end
if not and has_s has_e
ret false
end
if gt s0 e0
ret false
end
if lt s0 lead
ret false
end
e1 = add e0 1
arx_cue_add_pre act lead s0
if lt e1 ce
arx_cue_add_suf act e1 ce
end
i = lead
while lt i s0 bound 256
arx_cue_bump act get arx_tok_whash i true
i = add i 1
end
i = s0
while lt i e1 bound 256
arx_cue_bump act get arx_tok_whash i false
i = add i 1
end
ret true
end

fn arx_cue_match_pre_at ci ulong p ulong j ulong m ulong to bool
base = mul ci ARX_MAX_CUE_WORDS
k = ulong 0
while lt k m bound 8
if ne get arx_tok_whash add p k get arx_cue_pre_h add base add j k
ret false
end
k = add k 1
end
ret true
end

fn arx_cue_best_pre_for ci ulong p ulong lead ulong ce ulong best ulong to ulong
clen = ulong get arx_cue_pre_len ci
bm = best
j = ulong 0
while lt j clen bound 8
m = sub clen j
skip = or le m bm ge add p m ce
if not and eq p lead eq j 0
if or lt m 2 eq p lead
skip = true
end
end
if not skip
if arx_cue_match_pre_at ci p j m
bm = m
end
end
j = add j 1
end
ret bm
end

note Returns 0 if no prefix cue matched, or (sv + 1) if matched.
fn arx_cue_best_pre lead ulong ce ulong act uchar to ulong
res = ulong 0
best = ulong 0
p_hi = add lead 3
if gt p_hi ce
p_hi = ce
end
pn = get arx_cue_pre_n 0
p = lead
while lt p p_hi bound 4
ci = ulong 0
while lt ci pn bound 256
if eq get arx_cue_pre_act ci act
if gt get arx_cue_pre_len ci 0
nm = arx_cue_best_pre_for ci p lead ce best
if gt nm best
best = nm
res = add add p nm 1
end
end
end
ci = add ci 1
end
p = add p 1
end
ret res
end

fn arx_cue_colon_dash lead ulong ce ulong act uchar pr ulong to ulong
from = add lead 1
chk_s = lead
if gt pr 0
from = sub pr 1
chk_s = from
end
hi = add lead 8
if gt hi ce
hi = ce
end
j = from
while lt j hi bound 16
if ne and get arx_tok_gap j or ARX_GAP_COLON ARX_GAP_DASH 0
ok = true
t = chk_s
while lt t j bound 16
if eq arx_cue_like act get arx_tok_whash t 1
ok = false
break
end
t = add t 1
end
if ok
ret add j 1
end
ret pr
end
j = add j 1
end
ret pr
end

fn arx_cue_bounds_start cs ulong ce ulong act uchar to ulong
lead = arx_skip_polite cs ce
pr = arx_cue_best_pre lead ce act
pr = arx_cue_colon_dash lead ce act pr
v = lead
if gt pr 0
v = sub pr 1
else
if ne act ARX_ACT_PROMPT
f = arx_longest_phrase v ce arx_lex_text_frames
if lt add v f ce
v = add v f
end
end
end
while lt add v 1 ce bound 16
if ge v add lead 6
break
end
if ne arx_cue_like act get arx_tok_whash v 2
break
end
v = add v 1
end
if gt v ce
v = ce
end
ret v
end

fn arx_cue_bounds_end s ulong ce ulong act uchar to ulong
e = ce
bests = ulong 0
sn = get arx_cue_suf_n 0
ci = ulong 0
while lt ci sn bound 256
clen = ulong get arx_cue_suf_len ci
if eq get arx_cue_suf_act ci act
if and gt clen bests lt add s clen e
if arx_cue_suf_same ci sub e clen clen
bests = clen
end
end
end
ci = add ci 1
end
e = sub e bests
while gt e add s 1 bound 32
if not arx_word_in_list sub e 1 arx_lex_trail_polite
break
end
e = sub e 1
end
if gt e add s 2
if arx_tok_eq_text sub e 2 arx_s_thank
if arx_tok_eq_text sub e 1 arx_s_you
e = sub e 2
end
end
end
ret e
end

fn arx_cue_copy_span msg view uchar * bs ulong be ulong to uchar
j = ulong 0
k = bs
while lt k be bound 4096
b = get msg k
curly = false
if eq b 0xe2
if lt add k 2 be
if eq get msg add k 1 0x80
b2 = get msg add k 2
if or eq b2 0x99 eq b2 0x98
curly = true
end
end
end
end
ch = b
if curly
ch = 39
k = add k 3
else
k = add k 1
end
if ge j ARX_MAX_TEXT
ret ARX_SPAN_TOO_LONG
end
if or lt ch 0x20 gt ch 0x7e
ret ARX_SPAN_UNREP
end
if or eq ch 34 eq ch 92
ret ARX_SPAN_UNREP
end
put arx_dec_txt j ch
j = add j 1
end
put arx_dec_txt_len 0 j
put arx_exp_span_bs 0 bs
put arx_exp_span_be 0 be
ret ARX_SPAN_OK
end

fn arx_cue_balance_be msg view uchar * bs ulong be ulong to ulong
opens = ulong 0
closes = ulong 0
k = bs
while lt k be bound 4096
b = get msg k
if eq b 40
opens = add opens 1
end
if eq b 41
closes = add closes 1
end
k = add k 1
end
if gt opens closes
if lt be len msg
if eq get msg be 41
ret add be 1
end
end
end
ret be
end

fn arx_cue_extract msg view uchar * cs ulong ce ulong act uchar to uchar
s = arx_cue_bounds_start cs ce act
e = arx_cue_bounds_end s ce act
if ge s e
ret ARX_SPAN_EMPTY
end
has_c = false
i = s
while lt i e bound 256
if ne get arx_tok_alnum i 0
if not arx_word_in_list i arx_lex_vacuous
skip_w = false
if eq act ARX_ACT_PROMPT
if arx_word_in_list i arx_lex_write_verbs
skip_w = true
end
end
if not skip_w
has_c = true
break
end
end
end
i = add i 1
end
if not has_c
ret ARX_SPAN_EMPTY
end
bs = get arx_tok_start s
be = arx_cue_balance_be msg bs get arx_tok_end sub e 1
ret arx_cue_copy_span msg bs be
end

note =========================================================================
note Section 11: Scorer Models (HvModel, NearestModel, PerceptronModel)
note =========================================================================

fn arx_argmax s view f32 * to ulong
best = ulong 0
bv = get s 0
l = ulong 1
while lt l ARX_N_LABELS bound 15
v = get s l
if gt v bv
bv = v
best = l
end
l = add l 1
end
ret best
end

fn arx_ins_top top edit f32 * off ulong kk ulong s f32 to void
if eq kk 0
ret
end
last = sub kk 1
if le s get top add off last
ret
end
p = last
put top add off p s
while gt p 0 bound 8
cur = get top add off p
prv = get top add off sub p 1
if le cur prv
break
end
put top add off p prv
put top add off sub p 1 cur
p = sub p 1
end
end

fn arx_ins_glob gs edit f32 8 gi edit ulong 8 ka ulong s f32 idx ulong to void
if eq ka 0
ret
end
last = sub ka 1
if le s get gs last
ret
end
p = last
put gs p s
put gi p idx
while gt p 0 bound 8
cur = get gs p
prv = get gs sub p 1
if le cur prv
break
end
ci = get gi p
pi = get gi sub p 1
put gs p prv
put gi p pi
put gs sub p 1 cur
put gi sub p 1 ci
p = sub p 1
end
end

note --- HvModel ---

fn arx_hv_reset to void
put arx_hv_n 0 0
i = ulong 0
while lt i ARX_N_LABELS bound 15
put arx_hv_nnz i 0
put arx_hv_nlabel i 0
i = add i 1
end
end

fn arx_hv_push_q lbl uchar note_s view uchar * to long
n = get arx_hv_n 0
if ge n get arx_cfg_max_ex 0
ret -1
end
if ge n ARX_MAX_EXEMPLARS
ret -1
end
w = get arx_cfg_hv_words 0
base = mul n w
x = ulong 0
while lt x w bound 128
put arx_hv_hvs add base x get arx_hv_q x
x = add x 1
end
put arx_hv_labels n lbl
nlen = len note_s
if gt nlen ARX_NOTE_BYTES
nlen = ARX_NOTE_BYTES
end
nbase = mul n ARX_NOTE_BYTES
k = ulong 0
while lt k nlen bound 96
put arx_hv_notes add nbase k get note_s k
k = add k 1
end
put arx_hv_nlen n nlen
li = ulong lbl
put arx_hv_nlabel li add get arx_hv_nlabel li 1
put arx_hv_n 0 add n 1
ret long n
end

fn arx_hv_add_word bbase ulong v ulong wt int to void
b = ulong 0
while lt b 64 bound 64
bit = int and shr v b 1
delta = mul sub mul 2 bit 1 wt
ci = add bbase b
nv = add get arx_hv_counts ci delta
put arx_hv_counts ci nv
b = add b 1
end
end

fn arx_hv_add_counts l ulong ex_idx ulong wt int to void
w = get arx_cfg_hv_words 0
cbase = mul l mul w 64
hbase = mul ex_idx w
x = ulong 0
while lt x w bound 128
arx_hv_add_word add cbase mul x 64 get arx_hv_hvs add hbase x wt
x = add x 1
end
end

fn arx_hv_calc_band l ulong to f32
d = mul get arx_cfg_hv_words 0 64
cbase = mul l d
sum = 0.0f32
i = ulong 0
while lt i d bound 8192
sum = add sum f32 get arx_hv_counts add cbase i
i = add i 1
end
mean = div sum f32 d
vsum = 0.0f32
i = ulong 0
while lt i d bound 8192
t = sub f32 get arx_hv_counts add cbase i mean
vsum = add vsum mul t t
i = add i 1
end
ret mul get arx_cfg_hv_zband 0 fsqrt div vsum f32 d
end

fn arx_hv_quantize_word bbase ulong sidx ulong band f32 to uint
sv = ulong 0
mv = ulong 0
b = ulong 0
while lt b 64 bound 64
v = f32 get arx_hv_counts add bbase b
if gt v 0.0f32
sv = or sv shl ulong 1 b
end
if or gt v band gt neg v band
mv = or mv shl ulong 1 b
end
b = add b 1
end
put arx_hv_sign sidx sv
put arx_hv_mask sidx mv
ret arx_popcnt64 mv
end

fn arx_hv_quantize l ulong to void
band = arx_hv_calc_band l
w = get arx_cfg_hv_words 0
cbase = mul l mul w 64
sbase = mul l w
nnz = uint 0
x = ulong 0
while lt x w bound 128
nnz = add nnz arx_hv_quantize_word add cbase mul x 64 add sbase x band
x = add x 1
end
put arx_hv_nnz l nnz
end

fn arx_hv_proto_sim_q l ulong to f32
if eq get arx_hv_nlabel l 0
ret -1.0f32
end
nnz = get arx_hv_nnz l
if eq nnz 0
ret -1.0f32
end
w = get arx_cfg_hv_words 0
sbase = mul l w
agree = long 0
dis = long 0
x = ulong 0
while lt x w bound 128
m = get arx_hv_mask add sbase x
diff = xor get arx_hv_q x get arx_hv_sign add sbase x
dis = add dis long arx_popcnt64 and diff m
agree = add agree long arx_popcnt64 and not diff m
x = add x 1
end
d = f32 mul w 64
ret div f32 sub agree dis fsqrt mul f32 nnz d
end

fn arx_hv_proto_sim_ex ex_idx ulong l ulong to f32
if eq get arx_hv_nlabel l 0
ret -1.0f32
end
nnz = get arx_hv_nnz l
if eq nnz 0
ret -1.0f32
end
w = get arx_cfg_hv_words 0
sbase = mul l w
hbase = mul ex_idx w
net = long 0
x = ulong 0
while lt x w bound 128
m = get arx_hv_mask add sbase x
va = get arx_hv_hvs add hbase x
vb = get arx_hv_sign add sbase x
diff = xor va vb
p_a = long arx_popcnt64 and not diff m
p_d = long arx_popcnt64 and diff m
net = add net sub p_a p_d
x = add x 1
end
ret div f32 net fsqrt mul f32 nnz f32 mul w 64
end

fn arx_hv_rebuild_pass to ulong
sc = new f32 15 -9.0f32
n = get arx_hv_n 0
eta = get arx_cfg_hv_eta 0
errs = ulong 0
i = ulong 0
while lt i n bound 256
y = ulong get arx_hv_labels i
l = ulong 0
while lt l ARX_N_LABELS bound 15
if gt get arx_hv_nlabel l 0
put sc l arx_hv_proto_sim_ex i l
else
put sc l -9.0f32
end
l = add l 1
end
p = arx_argmax sc
if ne p y
errs = add errs 1
wy = int mul mul eta sub 1.0f32 get sc y 64.0f32
wp = int mul mul eta sub 1.0f32 get sc p 64.0f32
if lt wy 1
wy = 1
end
if lt wp 1
wp = 1
end
arx_hv_add_counts y i wy
arx_hv_add_counts p i neg wp
arx_hv_quantize y
arx_hv_quantize p
end
i = add i 1
end
ret errs
end

fn arx_hv_rebuild to uint
w = get arx_cfg_hv_words 0
tot_c = mul ARX_N_LABELS mul w 64
i = ulong 0
while lt i tot_c bound 131072
put arx_hv_counts i 0
i = add i 1
end
n = get arx_hv_n 0
i = ulong 0
while lt i n bound 256
arx_hv_add_counts ulong get arx_hv_labels i i 64
i = add i 1
end
l = ulong 0
while lt l ARX_N_LABELS bound 15
arx_hv_quantize l
l = add l 1
end
passes = uint 0
epochs = get arx_cfg_hv_epochs 0
ep = uint 0
while lt ep epochs bound 100
passes = add passes 1
if eq arx_hv_rebuild_pass 0
break
end
ep = add ep 1
end
ret passes
end

fn arx_hv_online idx ulong wrong uchar to void
y = ulong get arx_hv_labels idx
sy = arx_hv_proto_sim_ex idx y
if lt sy -1.0f32
sy = -1.0f32
end
wy = int mul sub 1.0f32 sy 64.0f32
if lt wy 1
wy = 1
end
arx_hv_add_counts y idx wy
arx_hv_quantize y
if ne wrong ARX_ACT_INVALID
p = ulong wrong
if ne p y
if gt get arx_hv_nlabel p 0
sp = arx_hv_proto_sim_ex idx p
wp = int mul mul add 1.0f32 sp 0.5f32 64.0f32
if lt wp 1
wp = 1
end
arx_hv_add_counts p idx neg wp
arx_hv_quantize p
end
end
end
end

fn arx_scores_empty to void
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_sc_s l -9.0f32
l = add l 1
end
put arx_sc_best_sim 0 0.0f32
put arx_sc_has_near 0 0
put arx_sc_nearest 0 0
put arx_sc_agree 0 1.0f32
end

fn arx_hv_score_agree gs view f32 8 gi view ulong 8 ka ulong to f32
sc_tmp = new f32 15 0.0f32
l = ulong 0
while lt l ARX_N_LABELS bound 15
put sc_tmp l get arx_sc_s l
l = add l 1
end
tl = arx_argmax sc_tmp
cnt_v = ulong 0
cnt_m = ulong 0
j = ulong 0
while lt j ka bound 8
if gt get gs j -2.0f32
cnt_v = add cnt_v 1
if eq ulong get arx_hv_labels get gi j tl
cnt_m = add cnt_m 1
end
end
j = add j 1
end
if eq cnt_v 0
cnt_v = 1
end
ret div f32 cnt_m f32 cnt_v
end

fn arx_hv_score_labels top view f32 120 kk ulong to void
l = ulong 0
while lt l ARX_N_LABELS bound 15
nl = ulong get arx_hv_nlabel l
if gt nl 0
m = nl
if gt m kk
m = kk
end
sum = 0.0f32
j = ulong 0
while lt j m bound 8
sum = add sum get top add mul l 8 j
j = add j 1
end
al = get arx_cfg_hv_alpha 0
pr = 0.0f32
if lt al 1.0f32
pr = arx_hv_proto_sim_q l
end
knn = div sum f32 m
p1 = mul al knn
p2 = mul sub 1.0f32 al pr
put arx_sc_s l add p1 p2
end
l = add l 1
end
end

fn arx_hv_score_q to void
top = new f32 120 -2.0f32
gs = new f32 8 -2.0f32
gi = new ulong 8 0
arx_scores_empty
n = get arx_hv_n 0
if eq n 0
ret
end
kk = get arx_cfg_hv_k 0
if lt kk 1
kk = 1
end
if gt kk 8
kk = 8
end
ka = kk
if lt ka 3
ka = 3
end
i = ulong 0
while lt i n bound 256
s = arx_hv_sim_q_ex i get arx_cfg_hv_words 0
l = ulong get arx_hv_labels i
arx_ins_top top mul l 8 kk s
arx_ins_glob gs gi ka s i
i = add i 1
end
put arx_sc_best_sim 0 get gs 0
put arx_sc_has_near 0 1
put arx_sc_nearest 0 get gi 0
arx_hv_score_labels top kk
put arx_sc_agree 0 arx_hv_score_agree gs gi ka
end

fn arx_hv_copy_ex dst ulong src ulong w ulong to void
sb = mul src w
db = mul dst w
x = ulong 0
while lt x w bound 128
v = get arx_hv_hvs add sb x
put arx_hv_hvs add db x v
x = add x 1
end
put arx_hv_labels dst get arx_hv_labels src
nlen = get arx_hv_nlen src
put arx_hv_nlen dst nlen
sb = mul src ARX_NOTE_BYTES
db = mul dst ARX_NOTE_BYTES
x = ulong 0
while lt x nlen bound 96
b = get arx_hv_notes add sb x
put arx_hv_notes add db x b
x = add x 1
end
end

fn arx_hv_sleep_compact n ulong w ulong to void
dst = ulong 0
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_hv_nlabel l 0
l = add l 1
end
i = ulong 0
while lt i n bound 256
if ne get arx_hv_keep i 0
if ne dst i
arx_hv_copy_ex dst i w
end
li = ulong get arx_hv_labels dst
put arx_hv_nlabel li add get arx_hv_nlabel li 1
dst = add dst 1
end
i = add i 1
end
put arx_hv_n 0 dst
end

fn arx_hv_sleep_add_conflict a ulong b ulong simv f32 to void
cn = get arx_slp_con_n 0
p = ulong 0
if lt cn ARX_MAX_CONFLICTS
put arx_slp_con_a cn a
put arx_slp_con_b cn b
put arx_slp_con_sim cn simv
p = cn
put arx_slp_con_n 0 add cn 1
else
if le simv get arx_slp_con_sim sub ARX_MAX_CONFLICTS 1
ret
end
p = sub ARX_MAX_CONFLICTS 1
put arx_slp_con_a p a
put arx_slp_con_b p b
put arx_slp_con_sim p simv
end
while gt p 0 bound 32
cs = get arx_slp_con_sim p
ps = get arx_slp_con_sim sub p 1
if le cs ps
break
end
ca = get arx_slp_con_a p
cb = get arx_slp_con_b p
pa = get arx_slp_con_a sub p 1
pb = get arx_slp_con_b sub p 1
put arx_slp_con_a p pa
put arx_slp_con_b p pb
put arx_slp_con_sim p ps
put arx_slp_con_a sub p 1 ca
put arx_slp_con_b sub p 1 cb
put arx_slp_con_sim sub p 1 cs
p = sub p 1
end
end

fn arx_hv_sleep dup f32 conflict f32 to void
w = get arx_cfg_hv_words 0
n = get arx_hv_n 0
i = ulong 0
while lt i n bound 256
put arx_hv_keep i 1
i = add i 1
end
merged = ulong 0
i = ulong 0
while lt i n bound 256
if ne get arx_hv_keep i 0
j = add i 1
while lt j n bound 256
if ne get arx_hv_keep j 0
if eq get arx_hv_labels i get arx_hv_labels j
if ge arx_hv_sim_ex_ex i j w dup
put arx_hv_keep j 0
merged = add merged 1
end
end
end
j = add j 1
end
end
i = add i 1
end
if gt merged 0
arx_hv_sleep_compact n w
end
n2 = get arx_hv_n 0
put arx_slp_con_n 0 0
i = ulong 0
while lt i n2 bound 256
j = add i 1
while lt j n2 bound 256
if ne get arx_hv_labels i get arx_hv_labels j
s = arx_hv_sim_ex_ex i j w
if ge s conflict
arx_hv_sleep_add_conflict i j s
end
end
j = add j 1
end
i = add i 1
end
passes = arx_hv_rebuild
put arx_slp_merged 0 merged
put arx_slp_kept 0 n2
put arx_slp_passes 0 passes
end

note --- Sparse Feature Helpers & NearestModel ---

fn arx_sparse_build_q to ulong
n = get arx_ft_n 0
i = ulong 0
while lt i n bound 768
put arx_sp_q_k i arx_feat_key i
put arx_sp_q_w i uint get arx_ft_w i
i = add i 1
end
note Insertion sort by key (n <= 768)
i = ulong 1
while lt i n bound 768
kk = get arx_sp_q_k i
kw = get arx_sp_q_w i
j = i
while gt j 0 bound 768
pk = get arx_sp_q_k sub j 1
if le pk kk
break
end
put arx_sp_q_k j pk
put arx_sp_q_w j get arx_sp_q_w sub j 1
j = sub j 1
end
put arx_sp_q_k j kk
put arx_sp_q_w j kw
i = add i 1
end
note Merge duplicates
if eq n 0
put arx_sp_q_n 0 0
ret 0
end
m = ulong 1
i = ulong 1
while lt i n bound 768
kk = get arx_sp_q_k i
kw = get arx_sp_q_w i
if eq kk get arx_sp_q_k sub m 1
put arx_sp_q_w sub m 1 add get arx_sp_q_w sub m 1 kw
else
put arx_sp_q_k m kk
put arx_sp_q_w m kw
m = add m 1
end
i = add i 1
end
put arx_sp_q_n 0 m
ret m
end

fn arx_dice_tot bo ulong nb ulong to ulong
na = get arx_sp_q_n 0
tot = ulong 0
i = ulong 0
while lt i na bound 768
tot = add tot ulong get arx_sp_q_w i
i = add i 1
end
j = ulong 0
while lt j nb bound 768
tot = add tot ulong get arx_nr_pool_w add bo j
j = add j 1
end
ret tot
end

fn arx_dice_q_nr ex_idx ulong to f32
na = get arx_sp_q_n 0
bo = get arx_nr_off ex_idx
nb = get arx_nr_len ex_idx
i = ulong 0
j = ulong 0
inter = ulong 0
while lt i na bound 1600
if ge j nb
break
end
ka = get arx_sp_q_k i
kb = get arx_nr_pool_k add bo j
if eq ka kb
mn = get arx_sp_q_w i
if lt get arx_nr_pool_w add bo j mn
mn = get arx_nr_pool_w add bo j
end
inter = add inter ulong mn
i = add i 1
j = add j 1
else
if lt ka kb
i = add i 1
else
j = add j 1
end
end
end
tot = arx_dice_tot bo nb
if eq tot 0
ret 0.0f32
end
ret div mul 2.0f32 f32 inter f32 tot
end

fn arx_nr_reset to void
put arx_nr_n 0 0
put arx_nr_pool_n 0 0
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_nr_nlabel l 0
l = add l 1
end
end

fn arx_nr_push_q lbl uchar note_s view uchar * to long
n = get arx_nr_n 0
if ge n get arx_cfg_max_ex 0
ret -1
end
if ge n ARX_MAX_EXEMPLARS
ret -1
end
qn = get arx_sp_q_n 0
po = get arx_nr_pool_n 0
if gt add po qn ARX_SPARSE_POOL
ret -1
end
i = ulong 0
while lt i qn bound 768
put arx_nr_pool_k add po i get arx_sp_q_k i
put arx_nr_pool_w add po i get arx_sp_q_w i
i = add i 1
end
put arx_nr_off n po
put arx_nr_len n qn
put arx_nr_pool_n 0 add po qn
put arx_nr_labels n lbl
nlen = len note_s
if gt nlen ARX_NOTE_BYTES
nlen = ARX_NOTE_BYTES
end
nbase = mul n ARX_NOTE_BYTES
k = ulong 0
while lt k nlen bound 96
put arx_nr_notes add nbase k get note_s k
k = add k 1
end
put arx_nr_nlen n nlen
li = ulong lbl
put arx_nr_nlabel li add get arx_nr_nlabel li 1
put arx_nr_n 0 add n 1
ret long n
end

fn arx_nr_score_agree gs view f32 8 gi view ulong 8 ka ulong to f32
sc_tmp = new f32 15 0.0f32
l = ulong 0
while lt l ARX_N_LABELS bound 15
put sc_tmp l get arx_sc_s l
l = add l 1
end
tl = arx_argmax sc_tmp
cnt_v = ulong 0
cnt_m = ulong 0
j = ulong 0
while lt j ka bound 8
if gt get gs j -2.0f32
cnt_v = add cnt_v 1
if eq ulong get arx_nr_labels get gi j tl
cnt_m = add cnt_m 1
end
end
j = add j 1
end
if eq cnt_v 0
cnt_v = 1
end
ret div f32 cnt_m f32 cnt_v
end

fn arx_nr_score_labels top view f32 120 kk ulong to void
l = ulong 0
while lt l ARX_N_LABELS bound 15
nl = ulong get arx_nr_nlabel l
if gt nl 0
m = nl
if gt m kk
m = kk
end
sum = 0.0f32
j = ulong 0
while lt j m bound 8
sum = add sum get top add mul l 8 j
j = add j 1
end
put arx_sc_s l div sum f32 m
end
l = add l 1
end
end

fn arx_nr_score_q to void
top = new f32 120 -2.0f32
gs = new f32 8 -2.0f32
gi = new ulong 8 0
arx_scores_empty
n = get arx_nr_n 0
if eq n 0
ret
end
kk = get arx_cfg_hv_k 0
if lt kk 1
kk = 1
end
if gt kk 8
kk = 8
end
ka = kk
if lt ka 3
ka = 3
end
i = ulong 0
while lt i n bound 256
d = arx_dice_q_nr i
l = ulong get arx_nr_labels i
arx_ins_top top mul l 8 kk d
arx_ins_glob gs gi ka d i
i = add i 1
end
put arx_sc_best_sim 0 get gs 0
put arx_sc_has_near 0 1
put arx_sc_nearest 0 get gi 0
arx_nr_score_labels top kk
put arx_sc_agree 0 arx_nr_score_agree gs gi ka
end

note --- PerceptronModel ---

fn arx_pc_clear_weights to void
i = ulong 0
while lt i ARX_PERC_CAP bound 8192
put arx_pc_w_used i 0
put arx_pc_u_used i 0
i = add i 1
end
put arx_pc_w_cnt 0 0
put arx_pc_u_cnt 0 0
end

fn arx_pc_reset to void
arx_pc_clear_weights
put arx_pc_tr_n 0 0
put arx_pc_pool_n 0 0
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_pc_nlabel l 0
l = add l 1
end
end

fn arx_pc_w_find key ulong create bool to long
slot = and key sub ARX_PERC_CAP 1
step = ulong 0
while lt step ARX_PERC_CAP bound 8192
if eq get arx_pc_w_used slot 0
if not create
ret -1
end
if ge get arx_pc_w_cnt 0 sub ARX_PERC_CAP 64
ret -1
end
put arx_pc_w_used slot 1
put arx_pc_w_key slot key
base = mul slot ARX_N_LABELS
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_pc_w_val add base l 0.0f32
l = add l 1
end
put arx_pc_w_cnt 0 add get arx_pc_w_cnt 0 1
ret long slot
end
if eq get arx_pc_w_key slot key
ret long slot
end
slot = and add slot 1 sub ARX_PERC_CAP 1
step = add step 1
end
ret -1
end

fn arx_pc_u_find key ulong create bool to long
slot = and key sub ARX_PERC_CAP 1
step = ulong 0
while lt step ARX_PERC_CAP bound 8192
if eq get arx_pc_u_used slot 0
if not create
ret -1
end
if ge get arx_pc_u_cnt 0 sub ARX_PERC_CAP 64
ret -1
end
put arx_pc_u_used slot 1
put arx_pc_u_key slot key
base = mul slot ARX_N_LABELS
l = ulong 0
while lt l ARX_N_LABELS bound 15
put arx_pc_u_val add base l 0.0f32
l = add l 1
end
put arx_pc_u_cnt 0 add get arx_pc_u_cnt 0 1
ret long slot
end
if eq get arx_pc_u_key slot key
ret long slot
end
slot = and add slot 1 sub ARX_PERC_CAP 1
step = add step 1
end
ret -1
end

fn arx_pc_push_q lbl uchar to void
n = get arx_pc_tr_n 0
if ge n ARX_MAX_EXEMPLARS
ret
end
qn = get arx_sp_q_n 0
po = get arx_pc_pool_n 0
if gt add po qn ARX_SPARSE_POOL
ret
end
i = ulong 0
while lt i qn bound 768
put arx_pc_pool_k add po i get arx_sp_q_k i
put arx_pc_pool_w add po i get arx_sp_q_w i
i = add i 1
end
put arx_pc_tr_off n po
put arx_pc_tr_len n qn
put arx_pc_pool_n 0 add po qn
put arx_pc_tr_lbl n lbl
li = ulong lbl
put arx_pc_nlabel li add get arx_pc_nlabel li 1
put arx_pc_tr_n 0 add n 1
end

fn arx_pc_raw_tr tr_idx ulong sc edit f32 * to void
l = ulong 0
while lt l ARX_N_LABELS bound 15
put sc l 0.0f32
l = add l 1
end
off = get arx_pc_tr_off tr_idx
xn = get arx_pc_tr_len tr_idx
i = ulong 0
while lt i xn bound 768
sl = arx_pc_w_find get arx_pc_pool_k add off i false
if ge sl 0
vf = f32 get arx_pc_pool_w add off i
base = mul ulong sl ARX_N_LABELS
l = ulong 0
while lt l ARX_N_LABELS bound 15
wv = get arx_pc_w_val add base l
nv = add get sc l mul wv vf
put sc l nv
l = add l 1
end
end
i = add i 1
end
end

fn arx_pc_add_u fk ulong cv f32 y ulong p ulong to void
us = arx_pc_u_find fk true
if ge us 0
ub = mul ulong us ARX_N_LABELS
uy = add ub y
up = add ub p
put arx_pc_u_val uy add get arx_pc_u_val uy cv
put arx_pc_u_val up sub get arx_pc_u_val up cv
end
end

fn arx_pc_fit_update_one fk ulong vf f32 y ulong p ulong c f32 to void
ws = arx_pc_w_find fk true
if ge ws 0
wb = mul ulong ws ARX_N_LABELS
iy = add wb y
ip = add wb p
put arx_pc_w_val iy add get arx_pc_w_val iy vf
put arx_pc_w_val ip sub get arx_pc_w_val ip vf
arx_pc_add_u fk mul c vf y p
end
end

fn arx_pc_fit_update idx ulong y ulong p ulong c f32 to void
off = get arx_pc_tr_off idx
xn = get arx_pc_tr_len idx
k = ulong 0
while lt k xn bound 768
pi = add off k
fk = get arx_pc_pool_k pi
vf = f32 get arx_pc_pool_w pi
arx_pc_fit_update_one fk vf y p c
k = add k 1
end
end

fn arx_pc_fit_avg c f32 to void
s = ulong 0
while lt s ARX_PERC_CAP bound 8192
if ne get arx_pc_w_used s 0
us = arx_pc_u_find get arx_pc_w_key s false
if ge us 0
wb = mul s ARX_N_LABELS
ub = mul ulong us ARX_N_LABELS
l = ulong 0
while lt l ARX_N_LABELS bound 15
wi = add wb l
ui = add ub l
uv = div get arx_pc_u_val ui c
wv = get arx_pc_w_val wi
put arx_pc_w_val wi sub wv uv
l = add l 1
end
end
end
s = add s 1
end
end

fn arx_pc_fit to void
sc = new f32 15 0.0f32
arx_pc_clear_weights
n = get arx_pc_tr_n 0
if eq n 0
ret
end
i = ulong 0
while lt i n bound 256
put arx_pc_order i i
i = add i 1
end
c = 1.0f32
rng = ARX_SEED
ep = uint 0
while lt ep get arx_cfg_perc_epochs 0 bound 100
if gt n 1
i = sub n 1
while gt i 0 bound 256
rng = add rng ulong 0x9e3779b97f4a7c15
j = rem arx_splitmix_next rng add i 1
ti = get arx_pc_order i
put arx_pc_order i get arx_pc_order j
put arx_pc_order j ti
i = sub i 1
end
end
oi = ulong 0
while lt oi n bound 256
idx = get arx_pc_order oi
y = ulong get arx_pc_tr_lbl idx
arx_pc_raw_tr idx sc
l = ulong 0
while lt l ARX_N_LABELS bound 15
if eq get arx_pc_nlabel l 0
put sc l -1.0e38f32
end
l = add l 1
end
p = arx_argmax sc
if ne p y
arx_pc_fit_update idx y p c
end
c = add c 1.0f32
oi = add oi 1
end
ep = add ep 1
end
arx_pc_fit_avg c
end

fn arx_pc_score_q to void
raw = new f32 15 0.0f32
arx_scores_empty
qn = get arx_sp_q_n 0
tot = 0.0f32
i = ulong 0
while lt i qn bound 768
vf = f32 get arx_sp_q_w i
tot = add tot vf
sl = arx_pc_w_find get arx_sp_q_k i false
if ge sl 0
base = mul ulong sl ARX_N_LABELS
l = ulong 0
while lt l ARX_N_LABELS bound 15
wv = get arx_pc_w_val add base l
nv = add get raw l mul wv vf
put raw l nv
l = add l 1
end
end
i = add i 1
end
if lt tot 1.0f32
tot = 1.0f32
end
l = ulong 0
while lt l ARX_N_LABELS bound 15
if gt get arx_pc_nlabel l 0
put arx_sc_s l div get raw l tot
end
l = add l 1
end
put arx_sc_best_sim 0 1.0f32
put arx_sc_agree 0 1.0f32
end

fn arx_pc_online_step y ulong p ulong to void
qn = get arx_sp_q_n 0
i = ulong 0
while lt i qn bound 768
ws = arx_pc_w_find get arx_sp_q_k i true
if ge ws 0
vf = f32 get arx_sp_q_w i
wb = mul ulong ws ARX_N_LABELS
iy = add wb y
ny = add get arx_pc_w_val iy vf
put arx_pc_w_val iy ny
ip = add wb p
np = sub get arx_pc_w_val ip vf
put arx_pc_w_val ip np
end
i = add i 1
end
end

fn arx_pc_online_q lbl uchar to void
sc_tmp = new f32 15 0.0f32
y = ulong lbl
arx_pc_push_q lbl
step = ulong 0
while lt step 8 bound 8
arx_pc_score_q
l = ulong 0
while lt l ARX_N_LABELS bound 15
put sc_tmp l get arx_sc_s l
l = add l 1
end
p = arx_argmax sc_tmp
if eq p y
break
end
arx_pc_online_step y p
step = add step 1
end
end

note =========================================================================
note Section 12: Reflex Core API
note =========================================================================

fn arx_cfg_frozen mode uchar to void
put arx_cfg_mode 0 mode
put arx_cfg_hv_words 0 ARX_HV_WORDS
put arx_cfg_hv_k 0 3
put arx_cfg_hv_alpha 0 0.5f32
put arx_cfg_hv_zband 0 0.42f32
put arx_cfg_hv_epochs 0 40
put arx_cfg_hv_eta 0 0.5f32
put arx_cfg_max_ex 0 ARX_MAX_EXEMPLARS
put arx_cfg_t_margin 0 0.0f32
put arx_cfg_t_abs 0 -1.0f32
put arx_cfg_abs_label 0 ARX_ACT_NONE
put arx_cfg_t_agree 0 0.0f32
put arx_cfg_exact 0 0.97f32
put arx_cfg_perc_epochs 0 20
put arx_cfg_sleep_dup 0 0.95f32
put arx_cfg_sleep_con 0 0.80f32
put arx_cfg_max_msg 0 2048
put arx_cfg_max_toks 0 256
put arx_cfg_max_turns 0 16
if eq mode ARX_MODE_REFLEX
put arx_cfg_weights 0 3
put arx_cfg_weights 1 0
put arx_cfg_weights 2 1
put arx_cfg_weights 3 6
put arx_cfg_weights 4 4
put arx_cfg_weights 5 3
put arx_cfg_weights 6 3
put arx_cfg_weights 7 2
else
if eq mode ARX_MODE_NEAREST
put arx_cfg_weights 0 0
put arx_cfg_weights 1 2
put arx_cfg_weights 2 0
put arx_cfg_weights 3 6
put arx_cfg_weights 4 4
put arx_cfg_weights 5 0
put arx_cfg_weights 6 3
put arx_cfg_weights 7 2
put arx_cfg_hv_k 0 5
else
put arx_cfg_weights 0 0
put arx_cfg_weights 1 2
put arx_cfg_weights 2 1
put arx_cfg_weights 3 4
put arx_cfg_weights 4 4
put arx_cfg_weights 5 3
put arx_cfg_weights 6 3
put arx_cfg_weights 7 2
put arx_cfg_perc_epochs 0 10
end
end
end

fn arx_init mode uchar to void
arx_cfg_frozen mode
arx_hv_reset
arx_nr_reset
arx_pc_reset
arx_cue_reset
put arx_learning 0 1
end

fn arx_set_learning on bool to void
if on
put arx_learning 0 1
else
put arx_learning 0 0
end
end

fn arx_exemplars to ulong
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
ret get arx_hv_n 0
end
if eq m ARX_MODE_NEAREST
ret get arx_nr_n 0
end
ret 0
end

fn arx_exemplar_label idx ulong to uchar
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
if lt idx get arx_hv_n 0
ret get arx_hv_labels idx
end
end
if eq m ARX_MODE_NEAREST
if lt idx get arx_nr_n 0
ret get arx_nr_labels idx
end
end
ret ARX_ACT_INVALID
end

fn arx_analyse to uchar
msg = new uchar 4096 0
arx_dialog_state get arx_cfg_max_turns 0
if eq get arx_dlg_has_user 0 0
ret ARX_WHY_NO_USER_TURN
end
lu = get arx_dlg_last_user 0
if gt get arx_turn_raw_len lu get arx_cfg_max_msg 0
ret ARX_WHY_INPUT_TOO_LONG
end
mlen = arx_load_turn_buf lu msg
i = ulong 0
while lt i mlen bound 4096
put arx_dlg_msg i get msg i
i = add i 1
end
put arx_dlg_msg_len 0 mlen
tn = arx_tokenize part msg 0 mlen get arx_cfg_max_toks 0
has_al = false
i = ulong 0
while lt i tn bound 256
if ne get arx_tok_alnum i 0
has_al = true
break
end
i = add i 1
end
if not has_al
ret ARX_WHY_NO_WORDS
end
cn_ign = arx_clauses
if not arx_primary
ret ARX_WHY_NO_WORDS
end
ret ARX_WHY_SCORED
end

fn arx_build_feats to ulong
cs = get arx_pri_start 0
ce = get arx_pri_end 0
from = get arx_tok_end sub ce 1
to_b = get arx_dlg_msg_len 0
if lt ce get arx_tok_n 0
to_b = get arx_tok_start ce
end
ends_q = false
i = from
while lt i to_b bound 4096
if eq get arx_dlg_msg i 63
ends_q = true
break
end
i = add i 1
end
ret arx_extract_features cs ce ends_q
end

fn arx_score_current to void
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
arx_hv_encode_to_q get arx_cfg_hv_words 0
arx_hv_score_q
else
sp_ign = arx_sparse_build_q
if eq m ARX_MODE_NEAREST
arx_nr_score_q
else
arx_pc_score_q
end
end
end

fn arx_exp_reset why uchar to void
put arx_exp_why 0 why
put arx_exp_refuse 0 ARX_REFUSE_NONE
put arx_exp_span_err 0 ARX_SPAN_OK
put arx_exp_top 0 ARX_ACT_CLARIFY
put arx_exp_second 0 ARX_ACT_CLARIFY
put arx_exp_margin 0 0.0f32
put arx_exp_best_sim 0 0.0f32
put arx_exp_agree 0 0.0f32
put arx_exp_has_near 0 0
put arx_exp_near_act 0 ARX_ACT_INVALID
put arx_exp_near_idx 0 0
put arx_exp_span_bs 0 0
put arx_exp_span_be 0 0
put arx_dec_has_txt 0 0
put arx_dec_txt_len 0 0
end

fn arx_decide_select top ulong sec ulong margin f32 to uchar
arx_exp_reset ARX_WHY_SCORED
put arx_exp_top 0 uchar top
put arx_exp_second 0 uchar sec
put arx_exp_margin 0 margin
put arx_exp_best_sim 0 get arx_sc_best_sim 0
put arx_exp_agree 0 get arx_sc_agree 0
nr_lbl = ARX_ACT_INVALID
if ne get arx_sc_has_near 0 0
ni = get arx_sc_nearest 0
nr_lbl = arx_exemplar_label ni
put arx_exp_has_near 0 1
put arx_exp_near_idx 0 ni
put arx_exp_near_act 0 nr_lbl
end
act = uchar top
exact_ok = false
if ge get arx_sc_best_sim 0 get arx_cfg_exact 0
if ne nr_lbl ARX_ACT_INVALID
blocked = false
if eq get arx_dlg_pending 0 ARX_PEND_NO
if arx_act_needs_pending nr_lbl
blocked = true
end
end
if not blocked
exact_ok = true
end
end
end
if exact_ok
act = nr_lbl
put arx_exp_why 0 ARX_WHY_EXACT_RECALL
else
if lt get arx_sc_best_sim 0 get arx_cfg_t_abs 0
act = get arx_cfg_abs_label 0
put arx_exp_why 0 ARX_WHY_LOW_SIMILARITY
else
if and lt margin get arx_cfg_t_margin 0 ne act ARX_ACT_CLARIFY
act = ARX_ACT_CLARIFY
put arx_exp_why 0 ARX_WHY_LOW_MARGIN
else
if and lt get arx_sc_agree 0 get arx_cfg_t_agree 0 ne act ARX_ACT_CLARIFY
act = ARX_ACT_CLARIFY
put arx_exp_why 0 ARX_WHY_LOW_AGREEMENT
end
end
end
end
ret act
end

fn arx_decide_extract_span act uchar to uchar
msg = new uchar 4096 0
mlen = get arx_dlg_msg_len 0
i = ulong 0
while lt i mlen bound 4096
put msg i get arx_dlg_msg i
i = add i 1
end
se = arx_cue_extract part msg 0 mlen get arx_pri_start 0 get arx_pri_end 0 act
if eq se ARX_SPAN_OK
put arx_dec_act 0 act
put arx_dec_has_txt 0 1
ret act
end
put arx_exp_why 0 ARX_WHY_SPAN
put arx_exp_span_err 0 se
put arx_dec_act 0 ARX_ACT_CLARIFY
ret ARX_ACT_CLARIFY
end

fn arx_decide to uchar
sc_arr = new f32 15 0.0f32
st = arx_analyse
if ne st ARX_WHY_SCORED
arx_exp_reset st
put arx_dec_act 0 ARX_ACT_CLARIFY
ret ARX_ACT_CLARIFY
end
rr = arx_policy_check
if ne rr ARX_REFUSE_NONE
arx_exp_reset ARX_WHY_POLICY
put arx_exp_refuse 0 rr
put arx_dec_act 0 ARX_ACT_REFUSE
ret ARX_ACT_REFUSE
end
fn_ign = arx_build_feats
arx_score_current
if eq get arx_dlg_pending 0 ARX_PEND_NO
put arx_sc_s ulong ARX_ACT_APPROVE -9.0f32
put arx_sc_s ulong ARX_ACT_DENY -9.0f32
put arx_sc_s ulong ARX_ACT_CANCEL -9.0f32
end
l = ulong 0
while lt l ARX_N_LABELS bound 15
put sc_arr l get arx_sc_s l
l = add l 1
end
top = arx_argmax sc_arr
top_s = get sc_arr top
put sc_arr top -1.0e38f32
sec = arx_argmax sc_arr
act = arx_decide_select top sec sub top_s get sc_arr sec
if arx_act_has_text act
ret arx_decide_extract_span act
end
put arx_dec_act 0 act
ret act
end

text arx_s_json_p1 "{\"action\":\""
text arx_s_json_p2 "\",\"args\":{"
text arx_s_json_p3 "\"text\":\""
text arx_s_json_p4 "\"}}"
text arx_s_json_p5 "}}"

fn arx_decision_json dst edit uchar * to ulong
p = ulong 0
p = arx_copy_bytes dst p arx_s_json_p1
p = arx_act_write_name get arx_dec_act 0 dst p
p = arx_copy_bytes dst p arx_s_json_p2
if ne get arx_dec_has_txt 0 0
p = arx_copy_bytes dst p arx_s_json_p3
tn = get arx_dec_txt_len 0
i = ulong 0
while lt i tn bound 64
put dst add p i get arx_dec_txt i
i = add i 1
end
p = add p tn
p = arx_copy_bytes dst p arx_s_json_p4
else
p = arx_copy_bytes dst p arx_s_json_p5
end
ret p
end

fn arx_store_model lbl uchar wrong uchar online bool msg view uchar * to uchar
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
arx_hv_encode_to_q get arx_cfg_hv_words 0
idx = arx_hv_push_q lbl msg
if lt idx 0
ret ARX_LEARN_FULL
end
if online
arx_hv_online ulong idx wrong
end
ret ARX_LEARN_OK
end
sp_ign = arx_sparse_build_q
if eq m ARX_MODE_NEAREST
idx = arx_nr_push_q lbl msg
if lt idx 0
ret ARX_LEARN_FULL
end
ret ARX_LEARN_OK
end
if online
arx_pc_online_q lbl
else
arx_pc_push_q lbl
end
ret ARX_LEARN_OK
end

fn arx_store_cue lbl uchar msg view uchar * txt view uchar * to void
bs = arx_find_ci msg txt
if ge bs 0
cs = get arx_pri_start 0
ce = get arx_pri_end 0
ub = ulong bs
ue = add ub len txt
cl_ign = arx_cue_learn cs ce lbl ub ue
end
end

fn arx_store lbl uchar has_txt bool txt view uchar * wrong uchar online bool to uchar
msg = new uchar 4096 0
if ne arx_analyse ARX_WHY_SCORED
ret ARX_LEARN_NO_USER
end
fn_ign = arx_build_feats
mlen = get arx_dlg_msg_len 0
i = ulong 0
while lt i mlen bound 4096
put msg i get arx_dlg_msg i
i = add i 1
end
res = arx_store_model lbl wrong online part msg 0 mlen
if ne res ARX_LEARN_OK
ret res
end
if has_txt
if arx_act_has_text lbl
arx_store_cue lbl part msg 0 mlen txt
end
end
ret ARX_LEARN_OK
end

text arx_s_dummy "x"

fn arx_train lbl uchar has_txt bool txt view uchar * to uchar
ret arx_store lbl has_txt txt ARX_ACT_INVALID false
end

fn arx_finish_training to void
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
rb_ign = arx_hv_rebuild
else
if eq m ARX_MODE_PERCEPTRON
arx_pc_fit
end
end
end

fn arx_learn_correct lbl uchar has_txt bool txt view uchar * to uchar
if eq get arx_learning 0 0
ret ARX_LEARN_OFF
end
pred = arx_decide
wrong = ARX_ACT_INVALID
if ne pred lbl
wrong = pred
end
ret arx_store lbl has_txt txt wrong true
end

fn arx_sleep to void
m = get arx_cfg_mode 0
if eq m ARX_MODE_REFLEX
arx_hv_sleep get arx_cfg_sleep_dup 0 get arx_cfg_sleep_con 0
else
if eq m ARX_MODE_NEAREST
put arx_slp_merged 0 0
put arx_slp_kept 0 get arx_nr_n 0
put arx_slp_passes 0 0
put arx_slp_con_n 0 0
else
arx_pc_fit
put arx_slp_merged 0 0
put arx_slp_kept 0 0
put arx_slp_passes 0 0
put arx_slp_con_n 0 0
end
end
end

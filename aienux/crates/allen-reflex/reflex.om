fn arx_copy_bytes dst edit uchar * pos ulong src view uchar * to ulong
n = len src
i = ulong 0
while lt i n bound 4096
put dst add pos i get src i
i = add i 1
end
ret add pos n
end

fn arx_eq_bytes a view uchar * b view uchar * to bool
na = len a
if ne na len b
ret false
end
i = ulong 0
while lt i na bound 4096
if ne get a i get b i
ret false
end
i = add i 1
end
ret true
end

fn arx_act_write_name act uchar dst edit uchar * pos ulong to ulong
if eq act ARX_ACT_STATUS
ret arx_copy_bytes dst pos arx_s_act_0
end
if eq act ARX_ACT_HELP
ret arx_copy_bytes dst pos arx_s_act_1
end
if eq act ARX_ACT_EVIDENCE
ret arx_copy_bytes dst pos arx_s_act_2
end
if eq act ARX_ACT_RECALL
ret arx_copy_bytes dst pos arx_s_act_3
end
if eq act ARX_ACT_FACTS
ret arx_copy_bytes dst pos arx_s_act_4
end
if eq act ARX_ACT_REMEMBER
ret arx_copy_bytes dst pos arx_s_act_5
end
if eq act ARX_ACT_PREFER
ret arx_copy_bytes dst pos arx_s_act_6
end
if eq act ARX_ACT_TASK
ret arx_copy_bytes dst pos arx_s_act_7
end
if eq act ARX_ACT_PROMPT
ret arx_copy_bytes dst pos arx_s_act_8
end
if eq act ARX_ACT_APPROVE
ret arx_copy_bytes dst pos arx_s_act_9
end
if eq act ARX_ACT_DENY
ret arx_copy_bytes dst pos arx_s_act_10
end
if eq act ARX_ACT_CANCEL
ret arx_copy_bytes dst pos arx_s_act_11
end
if eq act ARX_ACT_NONE
ret arx_copy_bytes dst pos arx_s_act_12
end
if eq act ARX_ACT_CLARIFY
ret arx_copy_bytes dst pos arx_s_act_13
end
if eq act ARX_ACT_REFUSE
ret arx_copy_bytes dst pos arx_s_act_14
end
ret arx_copy_bytes dst pos arx_s_act_13
end

fn arx_act_from_name s view uchar * to uchar
if arx_eq_bytes s arx_s_act_0
ret ARX_ACT_STATUS
end
if arx_eq_bytes s arx_s_act_1
ret ARX_ACT_HELP
end
if arx_eq_bytes s arx_s_act_2
ret ARX_ACT_EVIDENCE
end
if arx_eq_bytes s arx_s_act_3
ret ARX_ACT_RECALL
end
if arx_eq_bytes s arx_s_act_4
ret ARX_ACT_FACTS
end
if arx_eq_bytes s arx_s_act_5
ret ARX_ACT_REMEMBER
end
if arx_eq_bytes s arx_s_act_6
ret ARX_ACT_PREFER
end
if arx_eq_bytes s arx_s_act_7
ret ARX_ACT_TASK
end
if arx_eq_bytes s arx_s_act_8
ret ARX_ACT_PROMPT
end
if arx_eq_bytes s arx_s_act_9
ret ARX_ACT_APPROVE
end
if arx_eq_bytes s arx_s_act_10
ret ARX_ACT_DENY
end
if arx_eq_bytes s arx_s_act_11
ret ARX_ACT_CANCEL
end
if arx_eq_bytes s arx_s_act_12
ret ARX_ACT_NONE
end
if arx_eq_bytes s arx_s_act_13
ret ARX_ACT_CLARIFY
end
if arx_eq_bytes s arx_s_act_14
ret ARX_ACT_REFUSE
end
ret ARX_ACT_INVALID
end


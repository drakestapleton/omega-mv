fn t_train_one s view uchar * act uchar has_t bool txt view uchar * to void
arx_exam_turns s
ign = arx_train act has_t txt
end

fn t_build_core mode uchar to void
arx_init mode
t_train_one tr_st1 ARX_ACT_STATUS false arx_s_dummy
t_train_one tr_st2 ARX_ACT_STATUS false arx_s_dummy
t_train_one tr_st3 ARX_ACT_STATUS false arx_s_dummy
t_train_one tr_hl1 ARX_ACT_HELP false arx_s_dummy
t_train_one tr_hl2 ARX_ACT_HELP false arx_s_dummy
t_train_one tr_hl3 ARX_ACT_HELP false arx_s_dummy
t_train_one tr_ev1 ARX_ACT_EVIDENCE false arx_s_dummy
t_train_one tr_ev2 ARX_ACT_EVIDENCE false arx_s_dummy
t_train_one tr_rc1 ARX_ACT_RECALL false arx_s_dummy
t_train_one tr_rc2 ARX_ACT_RECALL false arx_s_dummy
t_train_one tr_rc3 ARX_ACT_RECALL false arx_s_dummy
t_train_one tr_fa1 ARX_ACT_FACTS false arx_s_dummy
t_train_one tr_fa2 ARX_ACT_FACTS false arx_s_dummy
t_train_one tr_fa3 ARX_ACT_FACTS false arx_s_dummy
t_train_one tr_rm1 ARX_ACT_REMEMBER true tr_rm1_t
t_train_one tr_rm2 ARX_ACT_REMEMBER true tr_rm2_t
t_train_one tr_rm3 ARX_ACT_REMEMBER true tr_rm3_t
t_train_one tr_rm4 ARX_ACT_REMEMBER true tr_rm4_t
t_train_one tr_pf1 ARX_ACT_PREFER true tr_pf1_t
t_train_one tr_pf2 ARX_ACT_PREFER true tr_pf2_t
t_train_one tr_pf3 ARX_ACT_PREFER true tr_pf3_t
t_train_one tr_tk1 ARX_ACT_TASK true tr_tk1_t
t_train_one tr_tk2 ARX_ACT_TASK true tr_tk2_t
t_train_one tr_tk3 ARX_ACT_TASK true tr_tk3_t
t_train_one tr_tk4 ARX_ACT_TASK true tr_tk4_t
t_train_one tr_tk5 ARX_ACT_TASK true tr_tk5_t
t_train_one tr_tk6 ARX_ACT_TASK true tr_tk6_t
t_train_one tr_pr1 ARX_ACT_PROMPT true tr_pr1_t
t_train_one tr_pr2 ARX_ACT_PROMPT true tr_pr2_t
t_train_one tr_pr3 ARX_ACT_PROMPT true tr_pr3_t
t_train_one tr_pr4 ARX_ACT_PROMPT true tr_pr4_t
t_train_one tr_pr5 ARX_ACT_PROMPT true tr_pr5_t
t_train_one tr_pr6 ARX_ACT_PROMPT true tr_pr6_t
t_train_one tr_ap1 ARX_ACT_APPROVE false arx_s_dummy
t_train_one tr_ap2 ARX_ACT_APPROVE false arx_s_dummy
t_train_one tr_ap3 ARX_ACT_APPROVE false arx_s_dummy
t_train_one tr_ap4 ARX_ACT_APPROVE false arx_s_dummy
t_train_one tr_ap5 ARX_ACT_APPROVE false arx_s_dummy
t_train_one tr_dn1 ARX_ACT_DENY false arx_s_dummy
t_train_one tr_dn2 ARX_ACT_DENY false arx_s_dummy
t_train_one tr_cn1 ARX_ACT_CANCEL false arx_s_dummy
t_train_one tr_cn2 ARX_ACT_CANCEL false arx_s_dummy
t_train_one tr_cn3 ARX_ACT_CANCEL false arx_s_dummy
t_train_one tr_no1 ARX_ACT_NONE false arx_s_dummy
t_train_one tr_no2 ARX_ACT_NONE false arx_s_dummy
t_train_one tr_no3 ARX_ACT_NONE false arx_s_dummy
t_train_one tr_no4 ARX_ACT_NONE false arx_s_dummy
t_train_one tr_no5 ARX_ACT_NONE false arx_s_dummy
t_train_one tr_cl1 ARX_ACT_CLARIFY false arx_s_dummy
t_train_one tr_cl2 ARX_ACT_CLARIFY false arx_s_dummy
t_train_one tr_cl3 ARX_ACT_CLARIFY false arx_s_dummy
t_train_one tr_cl4 ARX_ACT_CLARIFY false arx_s_dummy
t_train_one tr_rf1 ARX_ACT_REFUSE false arx_s_dummy
t_train_one tr_rf2 ARX_ACT_REFUSE false arx_s_dummy
t_train_one tr_rf3 ARX_ACT_REFUSE false arx_s_dummy
arx_finish_training
arx_set_learning false
end

fn t_dec_txt_eq want view uchar * to bool
if eq get arx_dec_has_txt 0 0
ret false
end
wn = len want
if ne get arx_dec_txt_len 0 wn
ret false
end
i = ulong 0
while lt i wn bound 64
if ne get arx_dec_txt i get want i
ret false
end
i = add i 1
end
ret true
end

fn t_schema_ok to bool
act = get arx_dec_act 0
if ge ulong act ARX_N_LABELS
ret false
end
has_t = ne get arx_dec_has_txt 0 0
if ne has_t arx_act_has_text act
ret false
end
if has_t
tl = get arx_dec_txt_len 0
if or eq tl 0 gt tl 48
ret false
end
i = ulong 0
while lt i tl bound 48
b = get arx_dec_txt i
if or lt b 0x20 gt b 0x7e
ret false
end
if or eq b 34 eq b 92
ret false
end
i = add i 1
end
end
ret true
end


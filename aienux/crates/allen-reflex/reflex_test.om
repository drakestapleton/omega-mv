note Test 2: Tower tests (from src/tower.rs)
note =========================================================================

text tw_g_alg "OMEGA-ALGEBRA"
text tw_g_sec "AIENOS-ZERO-DISK-SECRETS"
text tw_g_gpu "OMEGA-DIVSQRT-CHIP"
text tw_g_a "GATE-A"
text tw_g_b "GATE-B"
text tw_g_st "AIENOS-STORE"
text tw_j_want "{\"tower_action\":\"reuse_receipt\",\"gate\":\"OMEGA-ALGEBRA\",\"why\":\"cached_pass_receipt\"}"
text tw_j_esc_want "{\"tower_action\":\"run_pi5_local\",\"gate\":\"a\\\"b\\\\c\\nd\\u0001\",\"why\":\"tier_local_pi5\"}"

fn test_tower to int
d_decl = new uchar 32 0x11
d_pins = new uchar 32 0x22
d_reads = new uchar 64 0
d_in = new uchar 32 0
d_in2 = new uchar 32 0
d_rcpt = new uchar 32 0x99
jbuf = new uchar 256 0
esc_g = new uchar 8 0
note Known SHA-256 vector from tower.rs: [0x11;32], [0x22;32], [[0x33;32],[0x34;32]]
i = ulong 0
while lt i 32 bound 32
put d_reads i 0x33
put d_reads add 32 i 0x34
i = add i 1
end
arx_combine_mneme_digest d_decl d_pins d_reads 2 d_in
if ne get d_in 0 0x37
ret 60
end
if ne get d_in 1 0x6b
ret 61
end
if ne get d_in 2 0xdf
ret 62
end
if ne get d_in 31 0x93
ret 63
end
note Reversing read order changes digest
i = ulong 0
while lt i 32 bound 32
put d_reads i 0x34
put d_reads add 32 i 0x33
i = add i 1
end
arx_combine_mneme_digest d_decl d_pins d_reads 2 d_in2
if arx_eq_bytes d_in d_in2
ret 64
end
note Reuse receipt, inflight dedup, tier routing
arx_tower_init 64 16
arx_tower_record_pass tw_g_alg ARX_TIER_SPARK_HOST d_in d_rcpt
if ne arx_tower_schedule tw_g_alg ARX_TIER_SPARK_HOST d_in true ARX_TW_ACT_REUSE
ret 65
end
if ne get arx_tw_dec_why 0 ARX_TW_WHY_CACHED
ret 66
end
jn = arx_tower_decision_json jbuf
if not arx_eq_bytes part jbuf 0 jn tw_j_want
ret 67
end
if ne arx_tower_schedule tw_g_alg ARX_TIER_SPARK_HOST d_in2 true ARX_TW_ACT_SPARK_HOST
ret 68
end
if ne arx_tower_schedule tw_g_alg ARX_TIER_SPARK_HOST d_in2 true ARX_TW_ACT_JOIN
ret 69
end
if ne get arx_tw_dec_slot 0 0
ret 70
end
if ne arx_tower_schedule tw_g_sec ARX_TIER_PORTABLE d_decl true ARX_TW_ACT_PI5
ret 71
end
if ne arx_tower_schedule tw_g_gpu ARX_TIER_SPARK_GB10 d_pins false ARX_TW_ACT_SPARK_GPU
ret 72
end
if ne get arx_tw_dec_why 0 ARX_TW_WHY_UNCACHEABLE
ret 73
end
note Stable join slot after earlier run completes
arx_tower_init 8 4
if ne arx_tower_schedule tw_g_a ARX_TIER_SPARK_HOST d_decl true ARX_TW_ACT_SPARK_HOST
ret 74
end
if ne arx_tower_schedule tw_g_b ARX_TIER_SPARK_HOST d_pins true ARX_TW_ACT_SPARK_HOST
ret 75
end
if ne arx_tower_schedule tw_g_b ARX_TIER_SPARK_HOST d_pins true ARX_TW_ACT_JOIN
ret 76
end
if ne get arx_tw_dec_slot 0 1
ret 77
end
if not arx_tower_complete_inflight tw_g_a ARX_TIER_SPARK_HOST d_decl
ret 78
end
if ne arx_tower_schedule tw_g_b ARX_TIER_SPARK_HOST d_pins true ARX_TW_ACT_JOIN
ret 79
end
if ne get arx_tw_dec_slot 0 1
ret 80
end
note Tier isolation: Pi5Host receipt not reused on SparkHost
arx_tower_init 8 4
arx_tower_record_pass tw_g_st ARX_TIER_PI5_HOST d_decl d_rcpt
if ne arx_tower_schedule tw_g_st ARX_TIER_SPARK_HOST d_decl true ARX_TW_ACT_SPARK_HOST
ret 81
end
if ne arx_tower_schedule tw_g_st ARX_TIER_PI5_HOST d_decl true ARX_TW_ACT_REUSE
ret 82
end
note JSON escaping of gate name: a"b\c\nd\x01
put esc_g 0 97
put esc_g 1 34
put esc_g 2 98
put esc_g 3 92
put esc_g 4 99
put esc_g 5 10
put esc_g 6 100
put esc_g 7 1
arx_tower_init 8 4
ign_tw = arx_tower_schedule esc_g ARX_TIER_PI5_HOST d_decl true
jn = arx_tower_decision_json jbuf
if not arx_eq_bytes part jbuf 0 jn tw_j_esc_want
ret 83
end
ret 0
end


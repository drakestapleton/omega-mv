fn test_core_modes to int
mode = uchar 0
while lt mode 3 bound 3
t_build_core mode
note 1a. Determinism across calls
arx_exam_turns tr_st1
a1 = arx_decide
arx_exam_turns tr_st1
a2 = arx_decide
if ne a1 a2
ret 10
end
if ne a1 ARX_ACT_STATUS
ret 11
end
if not t_schema_ok
ret 12
end
note 1b. No user turn / empty turns -> Clarify
arx_clear_turns
if ne arx_decide ARX_ACT_CLARIFY
ret 13
end
arx_clear_turns
arx_push_turn ARX_ROLE_ASST tc_asst_only
if ne arx_decide ARX_ACT_CLARIFY
ret 14
end
if not t_schema_ok
ret 15
end
note 1c. Odd inputs always schema-valid
arx_exam_turns tc_space
ign_d = arx_decide
if not t_schema_ok
ret 16
end
arx_exam_turns tc_qmark
ign_d = arx_decide
if not t_schema_ok
ret 17
end
note 1d. Refuse only on intent
arx_exam_turns tc_data_note
if ne arx_decide ARX_ACT_REMEMBER
ret 18
end
if not t_dec_txt_eq tc_data_note_t
ret 19
end
arx_exam_turns tc_order_ref
if ne arx_decide ARX_ACT_REFUSE
ret 20
end
arx_exam_turns tc_lights
if ne arx_decide ARX_ACT_NONE
ret 21
end
arx_exam_turns tc_neg_del
if eq arx_decide ARX_ACT_REFUSE
ret 22
end
arx_exam_turns tc_plz_del
if ne arx_decide ARX_ACT_REFUSE
ret 23
end
note 1e. Multistep takes first request only (Reflex and Nearest)
if ne mode ARX_MODE_PERCEPTRON
arx_exam_turns tc_multi
if ne arx_decide ARX_ACT_TASK
ret 24
end
if not t_dec_txt_eq tc_multi_t
ret 25
end
end
note 1f. Dialog roles and pending state
arx_exam_turns tc_dlg_ap
if ne arx_decide ARX_ACT_APPROVE
ret 26
end
arx_exam_turns tc_dlg_cn
if ne arx_decide ARX_ACT_CANCEL
ret 27
end
arx_exam_turns tc_dlg_done
ad = arx_decide
if arx_act_needs_pending ad
ret 28
end
arx_exam_turns tc_dlg_st
if ne arx_decide ARX_ACT_STATUS
ret 29
end
note 1g. One-shot correction & learning off/on
arx_exam_turns tc_kettle
bef = arx_decide
if ne arx_learn_correct ARX_ACT_HELP false arx_s_dummy ARX_LEARN_OFF
ret 30
end
arx_set_learning true
tgt = ARX_ACT_HELP
if eq bef ARX_ACT_HELP
tgt = ARX_ACT_STATUS
end
arx_exam_turns tc_kettle
if ne arx_learn_correct tgt false arx_s_dummy ARX_LEARN_OK
ret 31
end
arx_exam_turns tc_kettle
if ne arx_decide tgt
ret 32
end
arx_exam_turns tc_jot
if ne arx_learn_correct ARX_ACT_REMEMBER true tc_jot_t ARX_LEARN_OK
ret 33
end
arx_exam_turns tc_jot
if ne arx_decide ARX_ACT_REMEMBER
ret 34
end
if not t_dec_txt_eq tc_jot_t
ret 35
end
mode = add mode 1
end
ret 0
end

fn test_span_and_sleep_and_bounds to int
curly = new uchar 48 0
huge = new uchar 3000 120
jbuf = new uchar 128 0
t_build_core ARX_MODE_REFLEX
note Span rules
arx_exam_turns tc_wifi
if ne arx_decide ARX_ACT_REMEMBER
ret 40
end
if not t_dec_txt_eq tc_wifi_t
ret 41
end
arx_exam_turns tc_save_this
if ne arx_decide ARX_ACT_CLARIFY
ret 42
end
arx_exam_turns tc_long_span
if ne arx_decide ARX_ACT_CLARIFY
ret 43
end
arx_exam_turns tc_quote_span
if ne arx_decide ARX_ACT_CLARIFY
ret 44
end
note Curly apostrophe: "Remember this: Joan\xe2\x80\x99s May"
pos = arx_copy_bytes curly 0 tc_wifi
note Build "Remember this: Joan" + 0xe2 0x80 0x99 + "s May"
put curly 0 82
put curly 1 101
put curly 2 109
put curly 3 101
put curly 4 109
put curly 5 98
put curly 6 101
put curly 7 114
put curly 8 32
put curly 9 116
put curly 10 104
put curly 11 105
put curly 12 115
put curly 13 58
put curly 14 32
put curly 15 74
put curly 16 111
put curly 17 97
put curly 18 110
put curly 19 0xe2
put curly 20 0x80
put curly 21 0x99
put curly 22 115
put curly 23 32
put curly 24 77
put curly 25 97
put curly 26 121
arx_clear_turns
arx_push_turn ARX_ROLE_USER part curly 0 27
if ne arx_decide ARX_ACT_REMEMBER
ret 45
end
if ne get arx_dec_txt_len 0 10
ret 46
end
if ne get arx_dec_txt 4 39
ret 47
end
note Sleep reports planted conflict
arx_set_learning true
arx_sleep
arx_exam_turns tc_purge
ign_l = arx_learn_correct ARX_ACT_TASK true tc_purge
arx_exam_turns tc_purge
ign_l = arx_learn_correct ARX_ACT_NONE false arx_s_dummy
arx_sleep
if eq get arx_slp_con_n 0 0
ret 48
end
note Oversized input -> Clarify
arx_clear_turns
arx_push_turn ARX_ROLE_USER huge
if ne arx_decide ARX_ACT_CLARIFY
ret 49
end
note Decision JSON check
arx_exam_turns tr_st1
ign_l = arx_decide
jn = arx_decision_json jbuf
if eq jn 0
ret 50
end
note Bounded memory (max_exemplars = 4)
arx_init ARX_MODE_REFLEX
put arx_cfg_max_ex 0 4
arx_exam_turns tc_msg0
if ne arx_train ARX_ACT_STATUS false arx_s_dummy ARX_LEARN_OK
ret 51
end
arx_exam_turns tc_msg1
if ne arx_train ARX_ACT_STATUS false arx_s_dummy ARX_LEARN_OK
ret 52
end
arx_exam_turns tc_msg2
if ne arx_train ARX_ACT_STATUS false arx_s_dummy ARX_LEARN_OK
ret 53
end
arx_exam_turns tc_msg3
if ne arx_train ARX_ACT_STATUS false arx_s_dummy ARX_LEARN_OK
ret 54
end
arx_exam_turns tc_msg4
if ne arx_train ARX_ACT_STATUS false arx_s_dummy ARX_LEARN_FULL
ret 55
end
if ne arx_exemplars 4
ret 56
end
ret 0
end


text rt_unfam "Purple monkey dishwasher quantum."
text rt_grants_end ",\"grants\":\"none\"}"
text rt_pct_in "hello%20world%2521"
text rt_pct_ok "hello world%21"
text rt_pct_bad "bad%2"

fn t_set_owner_ctx mode uchar caps uint to void
put arx_rctx_speaker 0 ARX_SPK_OWNER
put arx_rctx_consent 0 1
put arx_rctx_pending 0 0
put arx_rctx_caps 0 caps
arx_rctx_set_model true rt_m_tiny
i = ulong 0
while lt i 32 bound 32
put arx_rctx_subj i 7
i = add i 1
end
arx_cal_frozen mode
end

fn test_route_part1 mode uchar to int
obj = new uchar 32 0
t_set_owner_ctx mode 15
arx_exam_turns tr_st1
if ne arx_propose 41 9 ARX_RT_LOCAL_DET
ret 90
end
if ne get arx_prop_not_ready 0 ARX_NR_NONE
ret 91
end
arx_exam_turns tr_fa1
if ne arx_propose 41 9 ARX_RT_MEMORY
ret 92
end
arx_exam_turns tr_tk3
if ne arx_propose 41 9 ARX_RT_APPROVAL
ret 93
end
if ne get arx_prop_then 0 ARX_THEN_NOTE_TASK
ret 94
end
arx_exam_turns tr_pr1
if ne arx_propose 41 9 ARX_RT_LOCAL_MODEL
ret 95
end
put arx_rctx_pending 0 1
arx_exam_turns tr_ap4
if ne arx_propose 41 9 ARX_RT_APPROVAL
ret 96
end
if ne get arx_prop_then 0 ARX_THEN_APPROVE
ret 97
end
arx_exam_turns tr_cn3
if ne arx_propose 41 9 ARX_RT_APPROVAL
ret 98
end
if ne get arx_prop_then 0 ARX_THEN_CANCEL
ret 99
end
put arx_rctx_pending 0 0
arx_exam_turns tc_order_ref
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 100
end
arx_objective_id tc_order_ref obj
i = ulong 0
while lt i 32 bound 32
if ne get arx_prop_obj i get obj i
ret 101
end
i = add i 1
end
t_set_owner_ctx mode 3
arx_exam_turns tr_pr1
if ne arx_propose 41 9 ARX_RT_SPARK_INF
ret 102
end
if ne get arx_prop_not_ready 0 ARX_NR_SPARK_DOWN
ret 103
end
if ne get arx_prop_fallback 0 ARX_RT_LOCAL_DET
ret 104
end
if eq get arx_prop_has_pst1 0 0
ret 105
end
t_set_owner_ctx mode 11
arx_exam_turns tr_pr1
if ne arx_propose 41 9 ARX_RT_SPARK_INF
ret 106
end
if ne get arx_prop_not_ready 0 ARX_NR_NONE
ret 107
end
ret 0
end

fn test_route_part2 mode uchar to int
huge = new uchar 600 97
nonasc = new uchar 10 0
t_set_owner_ctx mode 15
arx_clear_turns
arx_push_turn ARX_ROLE_USER tr_fa3
arx_push_turn ARX_ROLE_ASST rt_inj_asst
arx_push_turn ARX_ROLE_USER tr_ap4
if ne arx_propose 41 9 ARX_RT_CLARIFY
ret 108
end
if ne get arx_prop_why 0 ARX_RWHY_NOTHING_PEND
ret 109
end
arx_exam_turns rt_inj_note
rr = arx_propose 41 9
if not or eq rr ARX_RT_REFUSE eq rr ARX_RT_CLARIFY
ret 110
end
put arx_rctx_pending 0 1
put arx_rctx_speaker 0 ARX_SPK_GUEST
arx_exam_turns tr_ap4
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 111
end
if ne get arx_prop_why 0 ARX_RWHY_GUEST_SCOPE
ret 112
end
put arx_rctx_speaker 0 ARX_SPK_OWNER
arx_exam_turns rt_dev_mode
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 113
end
t_set_owner_ctx mode 15
arx_exam_turns rt_ask_gpt
if ne arx_propose 41 9 ARX_RT_CLARIFY
ret 114
end
if ne get arx_prop_why 0 ARX_RWHY_MODEL_UNAVAIL
ret 115
end
arx_rctx_set_model false arx_s_dummy
arx_exam_turns rt_use_tiny
if ne arx_propose 41 9 ARX_RT_CLARIFY
ret 116
end
if ne get arx_prop_why 0 ARX_RWHY_MODEL_UNAVAIL
ret 117
end
t_set_owner_ctx mode 15
arx_clear_turns
arx_push_turn ARX_ROLE_USER huge
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 118
end
if ne get arx_prop_why 0 ARX_RWHY_TOO_LONG
ret 119
end
put nonasc 0 83
put nonasc 1 116
put nonasc 2 97
put nonasc 3 116
put nonasc 4 117
put nonasc 5 115
put nonasc 6 7
arx_clear_turns
arx_push_turn ARX_ROLE_USER part nonasc 0 7
if ne arx_propose 41 9 ARX_RT_CLARIFY
ret 120
end
if ne get arx_prop_why 0 ARX_RWHY_NON_ASCII
ret 121
end
ret 0
end

fn test_route_part3 mode uchar to int
pst = new uchar 1024 0
subj = new uchar 32 7
jbuf = new uchar 512 0
jbuf2 = new uchar 512 0
t_set_owner_ctx mode 15
put arx_rctx_consent 0 0
arx_exam_turns tr_fa2
if ne arx_propose 41 9 ARX_RT_MEMORY
ret 122
end
if ne get arx_prop_not_ready 0 ARX_NR_NO_CONSENT
ret 123
end
put arx_rctx_consent 0 1
put arx_rctx_speaker 0 ARX_SPK_GUEST
arx_exam_turns tr_fa2
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 124
end
arx_exam_turns rt_rem_drake
if ne arx_propose 41 9 ARX_RT_REFUSE
ret 125
end
arx_exam_turns tr_pr1
if ne arx_propose 41 9 ARX_RT_LOCAL_MODEL
ret 126
end
t_set_owner_ctx mode 15
arx_exam_turns rt_spark_t
if ne arx_propose 41 9 ARX_RT_SPARK_OM
ret 127
end
if ne get arx_prop_then 0 ARX_THEN_SPARK_TASK
ret 128
end
if arx_route_runs_without_owner ARX_RT_SPARK_OM
ret 129
end
plen = arx_pst1_request ARX_RT_SPARK_OM rt_spark_p subj pst
if ne plen add ARX_PST1_HEADER 30
ret 130
end
if or ne get pst 0 1 or ne get pst 1 1 ne get pst 184 1
ret 131
end
if or ne get pst 188 0 ne get pst 189 30
ret 132
end
arx_exam_turns tr_rc1
ign_p = arx_propose 41 9
j1 = arx_proposal_json jbuf
arx_exam_turns tr_rc1
ign_p = arx_propose 41 9
j2 = arx_proposal_json jbuf2
if not arx_eq_bytes part jbuf 0 j1 part jbuf2 0 j2
ret 133
end
if not arx_ends_with jbuf j1 rt_grants_end
ret 134
end
arx_cal_off
arx_exam_turns rt_unfam
ign_p = arx_propose 41 9
rw = get arx_prop_why 0
if or eq rw ARX_RWHY_UNFAMILIAR eq rw ARX_RWHY_UNSURE
ret 135
end
ret 0
end

fn test_route_modes to int
pdec = new uchar 32 0
mode = uchar 0
while lt mode 3 bound 3
t_build_core mode
r1 = test_route_part1 mode
if ne r1 0
ret r1
end
r2 = test_route_part2 mode
if ne r2 0
ret r2
end
r3 = test_route_part3 mode
if ne r3 0
ret r3
end
mode = add mode 1
end
dn = arx_pct_decode rt_pct_in pdec
if ne dn long len rt_pct_ok
ret 136
end
if not arx_eq_bytes part pdec 0 ulong dn rt_pct_ok
ret 137
end
if ge arx_pct_decode rt_pct_bad pdec 0
ret 138
end
ret 0
end

fn main to int
r1 = test_core_modes
if ne r1 0
ret r1
end
r2 = test_span_and_sleep_and_bounds
if ne r2 0
ret r2
end
r3 = test_tower
if ne r3 0
ret r3
end
r4 = test_route_modes
if ne r4 0
ret r4
end
ret 0
end

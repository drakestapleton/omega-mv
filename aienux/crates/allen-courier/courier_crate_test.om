text T_SC_RA2 "HTTP/1.1 503 Busy"

fn t_scene to int
i = ulong 0
while lt i len AC_SCENE_PROMPT bound 4096
if ge get AC_SCENE_PROMPT i 128
ret 30
end
i = add i 1
end
if lt ac_find_bytes AC_SCENE_PROMPT T_SC_K1 0 0
ret 31
end
if lt ac_find_bytes AC_SCENE_PROMPT T_SC_K7 0 0
ret 31
end
if lt ac_find_bytes AC_SCENE_PROMPT T_SC_K10 0 0
ret 31
end
buf = new uchar 256 0
n1 = ac_json_field T_SC_COMP T_SC_CONTENT edit buf
if lt n1 0
ret 32
end
if not ac_mem_eq part buf 0 ulong n1 T_SC_EXP1
ret 32
end
n2 = ac_json_field T_SC_COMP T_SC_FINISH edit buf
if lt n2 0
ret 33
end
if not ac_mem_eq part buf 0 ulong n2 T_SC_EXP2
ret 33
end
num = new ulong 1 0
if not ac_json_number_after T_SC_COMP T_SC_TOKS edit num
ret 34
end
if ne get num 0 7
ret 34
end
sl = ac_slug T_SC_SLUG_IN edit buf
if not ac_mem_eq part buf 0 sl T_SC_SLUG_OUT
ret 35
end
if not ac_retry_after T_SC_RA1 edit num
ret 36
end
if ne get num 0 4
ret 36
end
if ac_retry_after T_SC_RA2 edit num
ret 37
end
ret 0
end


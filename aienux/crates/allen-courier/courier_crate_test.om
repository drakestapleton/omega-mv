fn t_check_da ask view uchar * op long a long b long to bool
got = new uchar 24 0
exp = new uchar 24 0
if not ac_direct_arithmetic ask edit got
ret false
end
ac_arith_input op a b edit exp
ret ac_mem_eq part got 0 24 part exp 0 24
end

fn t_local_direct_arith to int
if not t_check_da T_DA_P1 3 123 456
ret 38
end
if not t_check_da T_DA_P2 3 123 456
ret 38
end
if not t_check_da T_DA_P3 3 7 -6
ret 39
end
if not t_check_da T_DA_P4 1 20 22
ret 39
end
if not t_check_da T_DA_P5 2 9 11
ret 40
end
if not t_check_da T_DA_P6 4 42 7
ret 40
end
if not t_check_da T_DA_P7 3 -7 6
ret 41
end
if not t_check_da T_DA_P8 4 11 3
ret 41
end
if not t_check_da T_DA_P9 1 -2 3
ret 42
end
if not t_check_da T_DA_P10 2 2 7
ret 42
end
if not t_check_da T_DA_P11 2 -1 -2
ret 43
end
if not t_check_da T_DA_P12 3 2 3
ret 43
end
if not t_check_da T_DA_P13 4 1 0
ret 44
end
if not t_check_da T_DA_P14 1 9223372036854775807 1
ret 44
end
imin = bitcast long ulong 0x8000000000000000
if not t_check_da T_DA_P15 4 imin -1
ret 45
end
got = new uchar 24 0
ebuf = new uchar 1 0
if ac_direct_arithmetic part ebuf 0 0 edit got
ret 46
end
if ac_direct_arithmetic T_DA_N1 edit got
ret 46
end
if ac_direct_arithmetic T_DA_N2 edit got
ret 46
end
if ac_direct_arithmetic T_DA_N3 edit got
ret 46
end
if ac_direct_arithmetic T_DA_N4 edit got
ret 46
end
if ac_direct_arithmetic T_DA_N5 edit got
ret 47
end
if ac_direct_arithmetic T_DA_N6 edit got
ret 47
end
if ac_direct_arithmetic T_DA_N7 edit got
ret 47
end
if ac_direct_arithmetic T_DA_N8 edit got
ret 47
end
if ac_direct_arithmetic T_DA_N9 edit got
ret 47
end
if ac_direct_arithmetic T_DA_N10 edit got
ret 48
end
if ac_direct_arithmetic T_DA_N11 edit got
ret 48
end
if ac_direct_arithmetic T_DA_N12 edit got
ret 48
end
if ac_direct_arithmetic T_DA_N13 edit got
ret 48
end
if ac_direct_arithmetic T_DA_N14 edit got
ret 48
end
if ac_direct_arithmetic T_DA_N15 edit got
ret 49
end
if ac_direct_arithmetic T_DA_N16 edit got
ret 49
end
bad_nul = new uchar 4 0
put bad_nul 0 49
put bad_nul 1 43
put bad_nul 2 50
put bad_nul 3 0
if ac_direct_arithmetic part bad_nul 0 4 edit got
ret 49
end
ret 0
end


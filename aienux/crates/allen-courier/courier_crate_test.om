end
ret 0
end

fn t_main_json_dechunk to int
lit = new uchar 256 0
back = new uchar 256 0
np = new ulong 1 0
ll = ac_json_str T_JS_1 edit lit
bl = ac_json_read_str part lit 0 ll 0 edit back edit np
if lt bl 0
ret 76
end
if not ac_mem_eq part back 0 ulong bl T_JS_1
ret 76
end
if ne get np 0 ll
ret 76
end
bl = ac_json_read_str T_JS_U 0 edit back edit np
if ne bl 8
ret 77
end
if ne get back 0 97
ret 77
end
if ne get back 1 0xc3
ret 77
end
if ne get back 2 0xa9
ret 77
end
if ne get back 3 0xf0
ret 77
end
if ne get back 7 10
ret 77
end
if ge ac_json_read_str T_JS_OPEN 0 edit back edit np 0
ret 77
end
bl = ac_json_field T_CHAT_B T_SC_CONTENT edit back
if lt bl 0
ret 78
end
if not ac_mem_eq part back 0 ulong bl T_CHAT_E
ret 78
end
if ge ac_json_field T_CHAT_ERR T_SC_CONTENT edit back 0
ret 78
end
bl = ac_json_field T_CHAT_D T_SC_CONTENT edit back
if lt bl 0
ret 78
end
if not ac_mem_eq part back 0 ulong bl T_CHAT_DE
ret 78
end
ck = new uchar 64 0
p = ulong 0
p = ac_push_byte edit ck p 53
p = ac_push_crlf edit ck p
p = ac_copy_at edit ck p T_ACT_HELLO
p = ac_push_crlf edit ck p
p = ac_push_byte edit ck p 54
p = ac_push_crlf edit ck p
p = ac_push_byte edit ck p 32
p = ac_push_byte edit ck p 119
p = ac_push_byte edit ck p 111
p = ac_push_byte edit ck p 114
p = ac_push_byte edit ck p 108
p = ac_push_byte edit ck p 100
p = ac_push_crlf edit ck p
p = ac_push_byte edit ck p 48
p = ac_push_crlf edit ck p
p = ac_push_crlf edit ck p
if ne ac_dechunk part ck 0 p edit back 11
ret 79
end
p = ulong 0
i = ulong 0
while lt i 16 bound 16
p = ac_push_byte edit ck p 102
i = add i 1
end
p = ac_push_crlf edit ck p
p = ac_push_byte edit ck p 97
p = ac_push_byte edit ck p 98
p = ac_push_byte edit ck p 99
p = ac_push_crlf edit ck p

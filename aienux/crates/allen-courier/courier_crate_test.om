ret 116
end
rl = get kreq req_len
if not ac_starts_with part req_buf 0 rl T_KT_EXP_GET
ret 117
end
if lt ac_find_bytes part req_buf 0 rl T_KT_EXP_AUTH 0 0
ret 117
end
put kreq ok 1
if not ac_keytest_build T_KT_URL2 T_KT_KEY2 edit req_buf edit kreq
ret 118
end
rl = get kreq req_len
if lt ac_find_bytes part req_buf 0 rl T_KT_EXP_XAPI 0 0
ret 119
end
if lt ac_find_bytes part req_buf 0 rl T_KT_EXP_AVER 0 0
ret 119
end
if ge ac_find_bytes part req_buf 0 rl T_KT_AUTH_W 0 0
ret 119
end
ebuf = new uchar 1 0
put kreq ok 0
if not ac_keytest_build T_KT_URL2 part ebuf 0 0 edit req_buf edit kreq
ret 120
end
rl = get kreq req_len
if ge ac_find_bytes part req_buf 0 rl T_KT_AUTH_W 0 0
ret 120
end
put kreq ok 1
if ac_keytest_build T_KT_HTTPS T_KT_KEY2 edit req_buf edit kreq
ret 121
end
if lt ac_find_bytes part req_buf 0 get kreq err_len T_KT_PLAIN_HTTP 0 0
ret 121
end
ret 0
end


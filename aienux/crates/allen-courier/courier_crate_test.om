note Behavioral test suite for allen-courier pure OM-2 port
note Covers code.rs, local_tools.rs, bin/allen-scene.rs, and main.rs.
note Returns 0 on pass, distinct non-zero exit codes 1..125 on failure.

text T_CRC_VEC "123456789"
text T_CODE_R1 "Here is a small calculator.\n\n```python\nprint(1 + 1)\n\tx = 2\n```\nEnjoy."
text T_CODE_S1 "Here is a small calculator."
text T_CODE_L1 "python"
text T_CODE_C1 "print(1 + 1)\n    x = 2\n"
text T_CODE_CPP "```c++\nint main(){}\n```"
text T_CODE_CPP_L "cpp"
text T_CODE_UNCL "Sure.\n```c\nint main(void) {\n"
text T_CODE_UNCL_C "int main(void) {\n"
text T_CODE_NOBLK "I would rather not."
text T_CODE_EMPTY "```\n\n```"
text T_CODE_R2_EXP "print(\"?hi?\")\n"
text T_CODE_AB "a\\b\n"
text T_CODE_AB_ESC "a\\\\b\\n"
text T_CODE_OBJCPP "objective-c++"
text T_CODE_XNL "x\n"
text T_CODE_DASHX " - x\\n"

fn t_code_crc to int
if ne ac_crc32 T_CRC_VEC 0xcbf43926
ret 1
end
ebuf = new uchar 1 0
if ne ac_crc32 part ebuf 0 0 0
ret 2
end
ret 0
end

fn t_code_fences to int
sb = new uchar 256 0
lb = new uchar 32 0
cb = new uchar 32768 0
info = new AcCodeReply 0 0 0 0 0 0
if not ac_code_read_reply T_CODE_R1 edit sb edit lb edit cb edit info
ret 4
end
if not ac_mem_eq part sb 0 get info sent_len T_CODE_S1
ret 5
end
if not ac_mem_eq part lb 0 get info lang_len T_CODE_L1
ret 6
end
if not ac_mem_eq part cb 0 get info code_len T_CODE_C1
ret 7
end
if ne get info cut_lines 0
ret 8
end
r2 = new uchar 64 0
p = ac_copy_at edit r2 0 AC_FENCE
p = ac_copy_at edit r2 p AC_L_PY
p = ac_push_byte edit r2 p 10
p = ac_push_byte edit r2 p 112
p = ac_push_byte edit r2 p 114
p = ac_push_byte edit r2 p 105
p = ac_push_byte edit r2 p 110
p = ac_push_byte edit r2 p 116
p = ac_push_byte edit r2 p 40
p = ac_push_byte edit r2 p 34
p = ac_push_byte edit r2 p 0xe2
p = ac_push_byte edit r2 p 0x80
p = ac_push_byte edit r2 p 0x9c
p = ac_push_byte edit r2 p 104
p = ac_push_byte edit r2 p 105
p = ac_push_byte edit r2 p 0xe2
p = ac_push_byte edit r2 p 0x80
p = ac_push_byte edit r2 p 0x9d
p = ac_push_byte edit r2 p 34
p = ac_push_byte edit r2 p 41
p = ac_push_byte edit r2 p 13
p = ac_push_byte edit r2 p 10
p = ac_copy_at edit r2 p AC_FENCE
if not ac_code_read_reply part r2 0 p edit sb edit lb edit cb edit info
ret 9
end
if not ac_mem_eq part lb 0 get info lang_len T_CODE_L1
ret 10
end
if not ac_mem_eq part cb 0 get info code_len T_CODE_R2_EXP
ret 11
end
if ne get info sent_len 0
ret 12
end
if not ac_code_read_reply T_CODE_CPP edit sb edit lb edit cb edit info
ret 13
end
if not ac_mem_eq part lb 0 get info lang_len T_CODE_CPP_L
ret 14
end
if not ac_code_read_reply T_CODE_UNCL edit sb edit lb edit cb edit info
ret 15
end
if not ac_mem_eq part cb 0 get info code_len T_CODE_UNCL_C
ret 16
end
if ac_code_read_reply T_CODE_NOBLK edit sb edit lb edit cb edit info
ret 17
end
if ac_code_read_reply T_CODE_EMPTY edit sb edit lb edit cb edit info
ret 18
end
ret 0
end

fn t_code_limits to int
long_buf = new uchar 16384 0
p = ac_copy_at edit long_buf 0 AC_FENCE
p = ac_copy_at edit long_buf p T_CODE_L1
p = ac_push_byte edit long_buf p 10
i = ulong 0
while lt i 1000 bound 1000
p = ac_push_byte edit long_buf p 120
p = ac_push_byte edit long_buf p 32
p = ac_push_byte edit long_buf p 61
p = ac_push_byte edit long_buf p 32
p = ac_fmt_u64 edit long_buf p i
p = ac_push_byte edit long_buf p 10
i = add i 1
end
p = ac_copy_at edit long_buf p AC_FENCE
sb = new uchar 256 0
lb = new uchar 32 0
cb = new uchar 32768 0
info = new AcCodeReply 0 0 0 0 0 0
if not ac_code_read_reply part long_buf 0 p edit sb edit lb edit cb edit info
ret 19
end
if ne get info kept_lines AC_CODE_LINES
ret 20
end
if ne get info cut_lines 200
ret 21
end
ret 0
end

fn t_code_wide to int
wide = new uchar 41000 0
cb = new uchar 32768 0
meta = new ulong 2 0
wp = ulong 0
i = ulong 0
while lt i 400 bound 400
j = ulong 0
while lt j 100 bound 100
wp = ac_push_byte edit wide wp 121
j = add j 1
end
wp = ac_push_byte edit wide wp 10
i = add i 1
end
klen = ac_within_limits part wide 0 wp edit cb edit meta
if gt klen AC_CODE_MAX
ret 22
end
if ne get cb sub klen 1 10
ret 23
end
if ne add get meta 0 get meta 1 400
ret 24
end
ret 0
end

fn t_code_pieces to int
c160 = new uchar 160 0
lb = new uchar 32 0
line = new uchar 384 0
cp = ulong 0
i = ulong 0
while lt i 40 bound 40
cp = ac_copy_at edit c160 cp T_CODE_AB
i = add i 1
end
if ne ac_code_piece_count 160 2
ret 25
end
put lb 0 99
req = new AcCodePieceReq 7 0 2 160 ac_crc32 part c160 0 160 1
ll0 = ac_code_format_piece view req view lb part c160 0 160 edit line
if lt ac_find_bytes part line 0 ll0 T_CODE_AB_ESC 0 0
ret 26
end
worst = new uchar 32768 92
wllen = ac_copy_at edit lb 0 T_CODE_OBJCPP
put req seq 4000000000
put req total_n ac_code_piece_count 32768
put req code_len 32768
put req crc ac_crc32 part worst 0 32768
put req lang_len wllen
if ge ac_code_format_piece view req view lb part worst 0 32768 edit line 320
ret 27
end
if ne ac_code_piece_count 0 0
ret 28
end
put req seq 1
put req total_n 1
put req code_len 2
put req crc ac_crc32 T_CODE_XNL
put req lang_len 0
ll0 = ac_code_format_piece view req view lb T_CODE_XNL edit line
if lt ac_find_bytes part line 0 ll0 T_CODE_DASHX 0 0
ret 29
end
ret 0
end


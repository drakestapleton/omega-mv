fn t_local_res_direct to int
pend = new AcLocalPending 7 1 1 3 1
dbuf = new uchar 256 0
abuf = new uchar 128 0
lres = new AcLocalRes 0 0 0 0
if not ac_local_result T_LR_1 view pend edit dbuf edit abuf edit lres
ret 50
end
if not ac_mem_eq part abuf 0 get lres ans_len T_LR_EXP42
ret 51
end
if ac_local_result T_LR_BAD_SEQ view pend edit dbuf edit abuf edit lres
ret 52
end
if ac_local_result T_LR_BAD_INV view pend edit dbuf edit abuf edit lres
ret 52
end
if ac_local_result T_LR_BAD_RSN view pend edit dbuf edit abuf edit lres
ret 52
end
if ac_local_result T_LR_BAD_LEN view pend edit dbuf edit abuf edit lres
ret 52
end
if not ac_local_result T_LR_DIV0 view pend edit dbuf edit abuf edit lres
ret 53
end
if not ac_mem_eq part abuf 0 get lres ans_len T_LR_EXP_DIV0
ret 53
end
if not ac_local_result T_LR_OVF view pend edit dbuf edit abuf edit lres
ret 54
end
if lt ac_find_bytes part abuf 0 get lres ans_len T_LR_EXP_64 0 0
ret 54
end
ia = new uchar 64 0
il = ac_integer_answer 56088 edit ia
if not ac_mem_eq part ia 0 il T_LR_EXP_56088
ret 55
end
il = ac_integer_answer bitcast long ulong 0x8000000000000000 edit ia
if not ac_mem_eq part ia 0 il T_LR_EXP_IMIN
ret 55
end
il = ac_integer_answer 9223372036854775807 edit ia
if not ac_mem_eq part ia 0 il T_LR_EXP_IMAX
ret 56
end
il = ac_integer_answer 0 edit ia
if not ac_mem_eq part ia 0 il T_LR_EXP_0
ret 56
end
put pend direct 4
if not ac_local_result T_LR_ZERO view pend edit dbuf edit abuf edit lres
ret 57
end
if not ac_mem_eq part abuf 0 get lres ans_len T_LR_EXP_QUOT
ret 57
end
ret 0
end

fn t_local_schema to int
tool_box = new uint 1 0
pay = new uchar 4100 0
pl = ac_local_action T_ACT_SAY edit tool_box edit pay
if ne get tool_box 0 0
ret 58
end
if not ac_mem_eq part pay 0 ulong pl T_ACT_HELLO
ret 58
end
pl = ac_local_action T_ACT_SYS edit tool_box edit pay
if ne get tool_box 0 3
ret 59
end
if ne pl 0
ret 59
end
if ge ac_local_action T_ACT_B1 edit tool_box edit pay 0
ret 60
end
if ge ac_local_action T_ACT_B2 edit tool_box edit pay 0
ret 60
end
if ge ac_local_action T_ACT_B3 edit tool_box edit pay 0
ret 60
end
if ge ac_local_action T_ACT_B4 edit tool_box edit pay 0
ret 60
end
if ge ac_local_action T_ACT_B5 edit tool_box edit pay 0
ret 60
end
if ge ac_local_action T_ACT_B6 edit tool_box edit pay 0
ret 60
end
pl = ac_local_action T_ACT_ARITH edit tool_box edit pay
if ne get tool_box 0 1
ret 61
end
if ne pl 24
ret 61
end
if ne bitcast long ac_get_le64 part pay 0 24 8 -7
ret 61
end
if ge ac_local_action T_ACT_ARITH_OVF edit tool_box edit pay 0
ret 62
end
if ne ac_call_line_count 4096 43
ret 63
end
big_a = new uchar 4096 65
cl_buf = new uchar 320 0
creq = new AcCallReq 2 1 2 4096 0
if ge ac_call_format_line view creq part big_a 0 4096 edit cl_buf 320
ret 63
end
put creq seq 1
put creq tool 3
put creq total_len 0
cll0 = ac_call_format_line view creq part big_a 0 0 edit cl_buf
if not ac_mem_eq part cl_buf 0 cll0 T_CALL_SYS_EXP
ret 64
end
ret 0
end

fn t_local_text_res to int
tool_box = new uint 1 0
pay = new uchar 4100 0
pl = ac_local_action T_ACT_TXT edit tool_box edit pay
if ne get tool_box 0 2
ret 65
end
if ne pl 8
ret 65
end
if ne get pay 0 97
ret 65
end
if ne get pay 1 12
ret 65
end
if ne get pay 2 8
ret 65
end
if ne get pay 3 0
ret 65
end
if ne get pay 4 0xf0
ret 65
end
if ne get pay 5 0x9f
ret 65
end
if ne get pay 6 0x98
ret 65
end
if ne get pay 7 0x80
ret 65
end
if ge ac_local_action T_ACT_BAD1 edit tool_box edit pay 0
ret 66
end
if ge ac_local_action T_ACT_BAD2 edit tool_box edit pay 0
ret 66
end
if ge ac_local_action T_ACT_BAD3 edit tool_box edit pay 0
ret 66
end
if ge ac_local_action T_ACT_BAD4 edit tool_box edit pay 0
ret 66
end
ff_json = new uchar 32 0
put ff_json 0 12
fl = ac_copy_at edit ff_json 1 T_ACT_SAY
if ge ac_local_action part ff_json 0 fl edit tool_box edit pay 0
ret 67
end
pend2 = new AcLocalPending 7 2 1 0 0
dbuf = new uchar 256 0
abuf = new uchar 128 0
lres = new AcLocalRes 0 0 0 0
if not ac_local_result T_LR_T2 view pend2 edit dbuf edit abuf edit lres
ret 68
end
if not ac_mem_eq part dbuf 0 get lres data_len T_LR_T2_EXP
ret 68
end
if ac_local_result T_LR_T2_B1 view pend2 edit dbuf edit abuf edit lres
ret 69
end
if ac_local_result T_LR_T2_B2 view pend2 edit dbuf edit abuf edit lres
ret 69
end
if ac_local_result T_LR_T2_B3 view pend2 edit dbuf edit abuf edit lres
ret 69
end
if ac_local_result T_LR_T2_B4 view pend2 edit dbuf edit abuf edit lres
ret 69
end
if ac_local_result T_LR_T2_B5 view pend2 edit dbuf edit abuf edit lres
ret 69
end
if not ac_local_result T_LR_T2_TRAP view pend2 edit dbuf edit abuf edit lres
ret 69
end
if lt ac_find_bytes part dbuf 0 get lres data_len T_LR_TRAPPED 0 0
ret 69
end
ret 0
end


p = ac_push_crlf edit raw p
p = ac_push_crlf edit raw p
p = ac_copy_at edit raw p T_KT_RESP2_B
if ac_keytest_parse_resp part raw 0 p edit out_m edit kresp
ret 124
end
if not ac_mem_eq part out_m 0 get kresp msg_len AC_KT_BADKEY
ret 125
end
ret 0
end


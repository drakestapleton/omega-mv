fn t_main_udp_queue_sess to int
ac_udp_reset AC_WORK_QUEUE
run = new uchar 16 0
fr = new uint 1 0
hdr = new uint 4 0
line1500 = new uchar 4096 0
item = new AcWorkItem 0 0 0 0 0 0
wrun = new uchar 16 0
wbody = new uchar 4096 0
dummy = ac_copy_at edit run 0 T_RUN_A
t_make_job_line edit line1500 1500
usid = ulong ac_session_for view run 100 edit fr
put hdr 1 1
put hdr 2 2
put hdr 3 1500
sq = uint 1
while le sq 4 bound 4
put hdr 0 sq
if ac_sess_job usid view hdr part line1500 0 1000
ret 109
end
sq = add sq 1
end
if ne ac_sess_jp_count usid 4
ret 109
end
put hdr 0 9
if ac_sess_job usid view hdr part line1500 0 1000
ret 109
end
if ac_sess_jp_has usid 1
ret 110
end
if not ac_sess_jp_has usid 9
ret 110
end
ac_udp_reset 1
usid = ulong ac_session_for view run 100 edit fr
t_make_job_line edit line1500 100
put hdr 0 1
put hdr 1 1
put hdr 2 1
put hdr 3 100
if not ac_sess_job usid view hdr part line1500 0 100
ret 111
end
put ac_s_pend_cnt usid 1
put ac_s_q_cnt usid 1
put ac_s_line_no usid 2
put hdr 0 2
if ac_sess_job usid view hdr part line1500 0 100
ret 112
end
if ne get ac_s_done_seq usid 1
ret 112
end
if ne get ac_s_line_no usid 2
ret 112
end
if not ac_wq_pop edit item edit wrun edit wbody
ret 113
end
if not ac_sess_job usid view hdr part line1500 0 100
ret 113
end
if ne get ac_s_done_seq usid 2
ret 113
end
if ne get ac_s_pend_cnt usid 0
ret 113
end
ac_udp_reset AC_WORK_QUEUE
i = ulong 0
while lt i 16 bound 16
put run 14 ac_hex_char uchar div i 16
put run 15 ac_hex_char uchar rem i 16
s = ac_session_for view run 1000 edit fr
if lt s 0
ret 114
end
if ne get fr 0 1
ret 114
end
i = add i 1
end
put run 14 48
put run 15 48
s = ac_session_for view run 1000 edit fr
if ne get fr 0 0
ret 114
end
put run 14 57
put run 15 57
if ge ac_session_for view run 1000 edit fr 0
ret 115
end
put ac_s_q_cnt 3 1
s = ac_session_for view run 1301 edit fr
if lt s 0
ret 115
end
if ne ac_sess_count 2
ret 115
end
ret 0
end


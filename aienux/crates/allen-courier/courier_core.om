fn ac_plain src view uchar * dst edit uchar * to ulong
n = len src
step = new ulong 1 0
i = ulong 0
p = ulong 0
while lt i n bound 65536
cp = ac_utf8_decode src i edit step
st = get step 0
if eq st 0
break
end
if ne cp 0xffffffff
p = ac_plain_cp dst p cp
end
i = add i st
end
ret p
end

fn ac_folded src view uchar * dst edit uchar * to ulong
tmp = new uchar 8192 0
pn = ac_plain src edit tmp
i = ulong 0
p = ulong 0
in_sp = true
while lt i pn bound 8192
b = get tmp i
if ac_is_ws b
in_sp = true
else
if in_sp
if gt p 0
p = ac_push_byte dst p 32
end
in_sp = false
end
p = ac_push_byte dst p b
end
i = add i 1
end
ret p
end

fn ac_find_sent_cut f view uchar * max_len ulong floor ulong to ulong
i = max_len
while gt i 0 bound 8192
i = sub i 1
b = get f i
is_end = false
if eq b 46
is_end = true
end
if eq b 33
is_end = true
end
if eq b 63
is_end = true
end
if is_end
if ge add i 1 floor
cut = add i 1
while gt cut 0 bound 8192
if not ac_is_ws get f sub cut 1
break
end
cut = sub cut 1
end
ret cut
end
end
end
ret 0
end

fn ac_find_word_cut f view uchar * room ulong keep ulong to ulong
rcut = room
i = room
while gt i 0 bound 8192
i = sub i 1
if eq get f i 32
if ge i keep
rcut = i
break
end
end
end
while gt rcut 0 bound 8192
if not ac_is_ws get f sub rcut 1
break
end
rcut = sub rcut 1
end
ret rcut
end

fn ac_for_allen_keep src view uchar * max_len ulong keep ulong dst edit uchar * to ulong
f = new uchar 8192 0
fn_len = ac_folded src edit f
if le fn_len max_len
ret ac_copy_at dst 0 part f 0 fn_len
end
floor = div max_len 3
if gt keep floor
floor = keep
end
cut = ac_find_sent_cut part f 0 fn_len max_len floor
if gt cut 0
ret ac_copy_at dst 0 part f 0 cut
end
room = ulong 0
if gt max_len 3
room = sub max_len 3
end
rcut = ac_find_word_cut part f 0 fn_len room keep
p = ac_copy_at dst 0 part f 0 rcut
p = ac_push_byte dst p 46
p = ac_push_byte dst p 46
p = ac_push_byte dst p 46
ret p
end

fn ac_for_allen src view uchar * max_len ulong dst edit uchar * to ulong
ret ac_for_allen_keep src max_len 0 dst
end

note ---- code.rs: CRC-32, plain_code, lang_of, within_limits, read_reply, escape, pieces ----

fn ac_crc32 b view uchar * to uint
n = len b
c = uint 0xffffffff
i = ulong 0
while lt i n bound 65536
c = xor c uint get b i
j = ulong 0
while lt j 8 bound 8
if ne and c 1 0
c = xor shr c 1 0xedb88320
else
c = shr c 1
end
j = add j 1
end
i = add i 1
end
ret xor c 0xffffffff
end

fn ac_plain_code src view uchar * dst edit uchar * to ulong
n = len src
step = new ulong 1 0
i = ulong 0
p = ulong 0
while lt i n bound 65536
cp = ac_utf8_decode src i edit step
st = get step 0
if eq st 0
break
end
if eq cp 13
i = add i st
continue
end
if eq cp 10
p = ac_push_byte dst p 10
else
if eq cp 9
p = ac_push_byte dst p 32
p = ac_push_byte dst p 32
p = ac_push_byte dst p 32
p = ac_push_byte dst p 32
else
if ge cp 32
if le cp 126
p = ac_push_byte dst p uchar cp
else
p = ac_push_byte dst p 63
end
else
p = ac_push_byte dst p 63
end
end
end
i = add i st
end
s = ulong 0
while lt s p bound 65536
if ne get dst s 10
break
end
s = add s 1
end
e = p
while gt e s bound 65536
if ne get dst sub e 1 10
break
end
e = sub e 1
end
if eq s e
ret 0
end
k = sub e s
if gt s 0
j = ulong 0
while lt j k bound 65536
put dst j get dst add s j
j = add j 1
end
end
k = ac_push_byte dst k 10
ret k
end


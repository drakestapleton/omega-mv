fn ac_is_lang_ch b uchar to bool
if ac_is_lower b
ret true
end
if ac_is_digit b
ret true
end
if eq b 43
ret true
end
if eq b 35
ret true
end
if eq b 46
ret true
end
if eq b 95
ret true
end
if eq b 45
ret true
end
ret false
end

fn ac_lang_of src view uchar * dst edit uchar * to ulong
n = len src
s = ulong 0
while lt s n bound 256
if not ac_is_ws get src s
break
end
s = add s 1
end
e = n
while gt e s bound 256
if not ac_is_ws get src sub e 1
break
end
e = sub e 1
end
tmp = new uchar 64 0
tlen = sub e s
if gt tlen 64
tlen = ulong 64
end
i = ulong 0
while lt i tlen bound 64
put tmp i ac_to_lower get src add s i
i = add i 1
end
if ac_mem_eq part tmp 0 tlen AC_L_PY
ret ac_copy_at dst 0 AC_L_PYTHON
end
if ac_mem_eq part tmp 0 tlen AC_L_PY3
ret ac_copy_at dst 0 AC_L_PYTHON
end
if ac_mem_eq part tmp 0 tlen AC_L_JS
ret ac_copy_at dst 0 AC_L_JAVASCRIPT
end
if ac_mem_eq part tmp 0 tlen AC_L_TS
ret ac_copy_at dst 0 AC_L_TYPESCRIPT
end
if ac_mem_eq part tmp 0 tlen AC_L_SH
ret ac_copy_at dst 0 AC_L_BASH
end
if ac_mem_eq part tmp 0 tlen AC_L_SHELL
ret ac_copy_at dst 0 AC_L_BASH
end
if ac_mem_eq part tmp 0 tlen AC_L_ZSH
ret ac_copy_at dst 0 AC_L_BASH
end
if ac_mem_eq part tmp 0 tlen AC_L_CPP_PLUS
ret ac_copy_at dst 0 AC_L_CPP
end
if ac_mem_eq part tmp 0 tlen AC_L_RS
ret ac_copy_at dst 0 AC_L_RUST
end
p = ulong 0
i = ulong 0
while lt i tlen bound 64
if ge p AC_LANG_MAX
break
end
b = get tmp i
if not ac_is_lang_ch b
break
end
p = ac_push_byte dst p b
i = add i 1
end
ret p
end

fn ac_count_lines src view uchar * to ulong
n = len src
if eq n 0
ret 0
end
cnt = ulong 0
i = ulong 0
while lt i n bound 65536
while lt i n bound 65536
if eq get src i 10
break
end
i = add i 1
end
cnt = add cnt 1
if lt i n
i = add i 1
end
end
ret cnt
end

fn ac_line_end src view uchar * pos ulong to ulong
i = pos
while lt i len src bound 65536
if eq get src i 10
ret i
end
i = add i 1
end
ret i
end

fn ac_within_limits src view uchar * dst edit uchar * meta edit ulong 2 to ulong
kept_len = ulong 0
kept_lines = ulong 0
i = ulong 0
while lt i len src bound 65536
le_end = ac_line_end src i
llen = sub le_end i
if eq kept_lines AC_CODE_LINES
break
end
if gt add kept_len add llen 1 AC_CODE_MAX
break
end
kept_len = ac_copy_at dst kept_len part src i llen
kept_len = ac_push_byte dst kept_len 10
kept_lines = add kept_lines 1
i = le_end
if lt i len src
i = add i 1
end
end
put meta 0 kept_lines
put meta 1 sub ac_count_lines src kept_lines
ret kept_len
end

text AC_FENCE "```"

fn ac_trim_slice_bounds src view uchar * bs ulong be ulong res edit ulong 2 to void
s = bs
e = be
while lt s e bound 65536
if not ac_is_ws get src s
break
end
s = add s 1
end
while gt e s bound 65536
if not ac_is_ws get src sub e 1
break
end
e = sub e 1
end
put res 0 s
put res 1 e
ret
end

fn ac_code_first_word reply view uchar * s ulong e ulong lang_buf edit uchar 32 to ulong
ws = s
while lt ws e bound 256
if not ac_is_ws get reply ws
break
end
ws = add ws 1
end
we = ws
while lt we e bound 256
if ac_is_ws get reply we
break
end
we = add we 1
end
ret ac_lang_of part reply ws sub we ws lang_buf
end

fn ac_code_find_close reply view uchar * body_s ulong to ulong
n = len reply
cur = body_s
while lt cur n bound 65536
le_i = cur
while lt le_i n bound 65536
if eq get reply le_i 10
le_i = add le_i 1
break
end
le_i = add le_i 1
end
ts = cur
while lt ts le_i bound 4096
if not ac_is_ws get reply ts
break
end
ts = add ts 1
end
if ac_starts_with part reply ts sub le_i ts AC_FENCE
ret cur
end
cur = le_i
end
ret n
end

fn ac_code_finalize src view uchar * code_buf edit uchar 32768 info edit AcCodeReply to bool
tb = new ulong 2 0
meta = new ulong 2 0
plain_buf = new uchar 65536 0
plen = ac_plain_code src edit plain_buf
ac_trim_slice_bounds part plain_buf 0 plen 0 plen edit tb
if eq get tb 0 get tb 1
ret false
end
clen = ac_within_limits part plain_buf 0 plen code_buf edit meta
put info code_len clen
put info kept_lines get meta 0
put info cut_lines get meta 1
put info ok 1
ret true
end

fn ac_code_read_reply reply view uchar * sent_buf edit uchar 256 lang_buf edit uchar 32 code_buf edit uchar 32768 info edit AcCodeReply to bool
put info ok 0
put info sent_len 0
put info lang_len 0
put info code_len 0
put info kept_lines 0
put info cut_lines 0
tb = new ulong 2 0
open_i = ac_find_bytes reply AC_FENCE 0
if lt open_i 0
ret false
end
ac_trim_slice_bounds reply 0 ulong open_i edit tb
put info sent_len ac_copy_at sent_buf 0 part reply get tb 0 sub get tb 1 get tb 0
pos = add ulong open_i 3
nl_i = ac_line_end reply pos
put info lang_len ac_code_first_word reply pos nl_i lang_buf
pos = len reply
if lt nl_i len reply
pos = add nl_i 1
end
body_e = ac_code_find_close reply pos
ret ac_code_finalize part reply pos sub body_e pos code_buf info
end

fn ac_code_escape piece view uchar * dst edit uchar * to ulong
n = len piece
p = ulong 0
i = ulong 0
while lt i n bound 4096
b = get piece i
if eq b 10
p = ac_push_byte dst p 92
p = ac_push_byte dst p 110
else
if eq b 92
p = ac_push_byte dst p 92
p = ac_push_byte dst p 92
else
p = ac_push_byte dst p b
end
end
i = add i 1
end
ret p
end

fn ac_code_piece_count clen ulong to ulong
if eq clen 0
ret 0
end
ret div add clen sub AC_PIECE 1 AC_PIECE
end

text AC_CODE_PFX "CODE "

fn ac_code_format_piece req view AcCodePieceReq lang view uchar 32 code view uchar * dst edit uchar * to ulong
esc = new uchar 264 0
off = mul get req idx AC_PIECE
if ge off get req code_len
ret 0
end
plen = sub get req code_len off
if gt plen AC_PIECE
plen = AC_PIECE
end
p = ulong 0
p = ac_copy_at dst p AC_CODE_PFX
p = ac_fmt_u64 dst p ulong get req seq
p = ac_push_byte dst p 32
p = ac_fmt_u64 dst p add get req idx 1
p = ac_push_byte dst p 47
p = ac_fmt_u64 dst p get req total_n
p = ac_push_byte dst p 32
p = ac_fmt_u64 dst p get req code_len
p = ac_push_byte dst p 32
p = ac_fmt_hex8 dst p get req crc
p = ac_push_byte dst p 32
if eq get req lang_len 0
p = ac_push_byte dst p 45
else
p = ac_copy_at dst p part lang 0 get req lang_len
end
p = ac_push_byte dst p 32
elen = ac_code_escape part code off plen edit esc
p = ac_copy_at dst p part esc 0 elen
ret p
end

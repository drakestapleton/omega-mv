ret ac_push_byte dst p 34
end
if eq cp 0x00ab
ret ac_push_byte dst p 34
end
if eq cp 0x00bb
ret ac_push_byte dst p 34
end
if eq cp 0x2026
p = ac_push_byte dst p 46
p = ac_push_byte dst p 46
ret ac_push_byte dst p 46
end
if eq cp 0x00a0
ret ac_push_byte dst p 32
end
if eq cp 0x2002

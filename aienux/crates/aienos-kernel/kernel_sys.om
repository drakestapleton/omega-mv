note =========================================================================
note Section 1: ABI v1 Little-Endian Helpers & Wire Encoding
note =========================================================================

fn ksys_get_u16 b view uchar * off ulong to ushort
  b0 = ushort get b off
  b1 = ushort get b add off 1
  ret or b0 shl b1 ushort 8
end

fn ksys_get_u32 b view uchar * off ulong to uint
  b0 = uint get b off
  b1 = uint get b add off 1
  b2 = uint get b add off 2
  b3 = uint get b add off 3
  r = or b0 shl b1 uint 8
  r = or r shl b2 uint 16
  ret or r shl b3 uint 24
end

fn ksys_get_u64 b view uchar * off ulong to ulong
  lo = ulong ksys_get_u32 b off
  hi = ulong ksys_get_u32 b add off 4
  ret or lo shl hi ulong 32
end

fn ksys_put_u16 dst edit uchar * off ulong v ushort to void
  put dst off uchar and v ushort 0xff
  put dst add off 1 uchar and shr v ushort 8 ushort 0xff
  ret
end

fn ksys_put_u32 dst edit uchar * off ulong v uint to void
  put dst off uchar and v uint 0xff
  put dst add off 1 uchar and shr v uint 8 uint 0xff
  put dst add off 2 uchar and shr v uint 16 uint 0xff
  put dst add off 3 uchar and shr v uint 24 uint 0xff
  ret
end

fn ksys_put_u64 dst edit uchar * off ulong v ulong to void
  lo = uint and v ulong 0xffffffff
  hi = uint shr v ulong 32
  ksys_put_u32 dst off lo
  ksys_put_u32 dst add off 4 hi
  ret
end

fn ksys_abi_exact n ulong sz ulong to uint
  if lt n sz
    ret KSYS_ABI_ERR_TRUNCATED
  end
  if gt n sz
    ret KSYS_ABI_ERR_WRONG_LEN
  end
  ret KSYS_ABI_OK
end

fn ksys_handle_make idx uint gen uint h edit KsysHandle to uint
  if eq gen uint 0
    ret KSYS_ABI_ERR_INVALID_HANDLE
  end
  put h index idx
  put h gen gen
  ret KSYS_ABI_OK
end

fn ksys_handle_to_raw h view KsysHandle to ulong
  idx = ulong get h index
  g = ulong get h gen
  ret or shl g ulong 32 idx
end

fn ksys_handle_from_raw raw ulong h edit KsysHandle to uint
  idx = uint and raw ulong 0xffffffff
  g = uint shr raw ulong 32
  ret ksys_handle_make idx g h
end

fn ksys_abi_encode_handle h view KsysHandle dst edit uchar * to uint
  if lt len dst ulong 8
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u32 dst ulong 0 get h index
  ksys_put_u32 dst ulong 4 get h gen
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_handle src view uchar * h edit KsysHandle to uint
  e = ksys_abi_exact len src ulong 8
  if ne e KSYS_ABI_OK
    ret e
  end
  idx = ksys_get_u32 src ulong 0
  g = ksys_get_u32 src ulong 4
  ret ksys_handle_make idx g h
end

fn ksys_abi_encode_u32 v uint dst edit uchar * to uint
  if lt len dst ulong 4
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u32 dst ulong 0 v
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_u32 src view uchar * dst edit uint 1 to uint
  e = ksys_abi_exact len src ulong 4
  if ne e KSYS_ABI_OK
    ret e
  end
  put dst 0 ksys_get_u32 src ulong 0
  ret KSYS_ABI_OK
end

fn ksys_abi_encode_u64 v ulong dst edit uchar * to uint
  if lt len dst ulong 8
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u64 dst ulong 0 v
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_u64 src view uchar * dst edit ulong 1 to uint
  e = ksys_abi_exact len src ulong 8
  if ne e KSYS_ABI_OK
    ret e
  end
  put dst 0 ksys_get_u64 src ulong 0
  ret KSYS_ABI_OK
end

fn ksys_res_kind_valid k ushort to bool
  if ge k ushort 1
    if le k ushort 5
      ret true
    end
  end
  ret false
end

fn ksys_abi_encode_resid r view KsysResId dst edit uchar * to uint
  if lt len dst ulong 8
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u16 dst ulong 0 get r kind
  ksys_put_u16 dst ulong 2 ushort 0
  ksys_put_u32 dst ulong 4 get r id
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_resid src view uchar * r edit KsysResId to uint
  e = ksys_abi_exact len src ulong 8
  if ne e KSYS_ABI_OK
    ret e
  end
  k = ksys_get_u16 src ulong 0
  if not ksys_res_kind_valid k
    ret KSYS_ABI_ERR_UNKNOWN_DISC
  end
  rsv = ksys_get_u16 src ulong 2
  if ne rsv ushort 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  put r kind k
  put r id ksys_get_u32 src ulong 4
  ret KSYS_ABI_OK
end

fn ksys_rights_valid bits uint to bool
  ret eq and bits xor KSYS_RIGHT_MASK uint 0xffffffff uint 0
end

fn ksys_abi_encode_rights bits uint dst edit uchar * to uint
  if lt len dst ulong 4
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u32 dst ulong 0 bits
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_rights src view uchar * dst edit uint 1 to uint
  e = ksys_abi_exact len src ulong 4
  if ne e KSYS_ABI_OK
    ret e
  end
  bits = ksys_get_u32 src ulong 0
  if not ksys_rights_valid bits
    ret KSYS_ABI_ERR_RESERVED_BITS
  end
  put dst 0 bits
  ret KSYS_ABI_OK
end

fn ksys_abi_encode_cap c view KsysCap dst edit uchar * to uint
  if lt len dst ulong 16
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u16 dst ulong 0 get c kind
  ksys_put_u16 dst ulong 2 ushort 0
  ksys_put_u32 dst ulong 4 get c id
  ksys_put_u32 dst ulong 8 get c rights
  ksys_put_u32 dst ulong 12 uint 0
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_cap src view uchar * c edit KsysCap to uint
  e = ksys_abi_exact len src ulong 16
  if ne e KSYS_ABI_OK
    ret e
  end
  k = ksys_get_u16 src ulong 0
  if not ksys_res_kind_valid k
    ret KSYS_ABI_ERR_UNKNOWN_DISC
  end
  if ne ksys_get_u16 src ulong 2 ushort 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  rgt = ksys_get_u32 src ulong 8
  if not ksys_rights_valid rgt
    ret KSYS_ABI_ERR_RESERVED_BITS
  end
  if ne ksys_get_u32 src ulong 12 uint 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  put c kind k
  put c id ksys_get_u32 src ulong 4
  put c rights rgt
  ret KSYS_ABI_OK
end

fn ksys_abi_encode_memreg m view KsysMemReg dst edit uchar * to uint
  if lt len dst ulong 16
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u64 dst ulong 0 get m base
  ksys_put_u32 dst ulong 8 get m pages
  ksys_put_u32 dst ulong 12 uint 0
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_memreg src view uchar * m edit KsysMemReg to uint
  e = ksys_abi_exact len src ulong 16
  if ne e KSYS_ABI_OK
    ret e
  end
  if ne ksys_get_u32 src ulong 12 uint 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  put m base ksys_get_u64 src ulong 0
  put m pages ksys_get_u32 src ulong 8
  ret KSYS_ABI_OK
end

fn ksys_abi_encode_msg m view KsysMsg dst edit uchar * to uint
  if lt len dst ulong 56
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u32 dst ulong 0 get m kind
  ksys_put_u32 dst ulong 4 uint 0
  ksys_put_u64 dst ulong 8 get m p0
  ksys_put_u64 dst ulong 16 get m p1
  ksys_put_u64 dst ulong 24 get m p2
  ksys_put_u64 dst ulong 32 get m base
  ksys_put_u32 dst ulong 40 get m pages
  ksys_put_u32 dst ulong 44 uint 0
  ksys_put_u64 dst ulong 48 get m obj
  ret KSYS_ABI_OK
end

fn ksys_abi_decode_msg src view uchar * m edit KsysMsg to uint
  e = ksys_abi_exact len src ulong 56
  if ne e KSYS_ABI_OK
    ret e
  end
  if ne ksys_get_u32 src ulong 4 uint 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  if ne ksys_get_u32 src ulong 44 uint 0
    ret KSYS_ABI_ERR_RESERVED_NZ
  end
  put m kind ksys_get_u32 src ulong 0
  put m p0 ksys_get_u64 src ulong 8
  put m p1 ksys_get_u64 src ulong 16
  put m p2 ksys_get_u64 src ulong 24
  put m base ksys_get_u64 src ulong 32
  put m pages ksys_get_u32 src ulong 40
  put m obj ksys_get_u64 src ulong 48
  ret KSYS_ABI_OK
end

fn ksys_abi_tag_valid tag ushort to bool
  if ge tag ushort 1
    if le tag ushort 10
      ret true
    end
  end
  ret false
end

fn ksys_abi_tag_size tag ushort to ulong
  if eq tag KSYS_TAG_HANDLE
    ret ulong 8
  end
  if eq tag KSYS_TAG_TASK_ID
    ret ulong 4
  end
  if eq tag KSYS_TAG_OBJECT_ID
    ret ulong 8
  end
  if eq tag KSYS_TAG_CHANNEL_ID
    ret ulong 4
  end
  if eq tag KSYS_TAG_DEVICE_ID
    ret ulong 4
  end
  if eq tag KSYS_TAG_RESOURCE_ID
    ret ulong 8
  end
  if eq tag KSYS_TAG_RIGHTS
    ret ulong 4
  end
  if eq tag KSYS_TAG_CAPABILITY
    ret ulong 16
  end
  if eq tag KSYS_TAG_MEMORY_REGION
    ret ulong 16
  end
  if eq tag KSYS_TAG_MESSAGE
    ret ulong 56
  end
  ret ulong 0
end

fn ksys_abi_env_write_hdr tag ushort payload_sz ulong dst edit uchar * to uint
  total = add KSYS_ABI_ENV_HDR payload_sz
  if lt len dst total
    ret KSYS_ABI_ERR_BUF_SMALL
  end
  ksys_put_u16 dst ulong 0 tag
  ksys_put_u16 dst ulong 2 KSYS_ABI_VERSION
  ksys_put_u32 dst ulong 4 uint payload_sz
  ret KSYS_ABI_OK
end

fn ksys_abi_env_check_hdr src view uchar * exp_tag ushort exp_sz ulong to uint
  if lt len src KSYS_ABI_ENV_HDR
    ret KSYS_ABI_ERR_TRUNCATED
  end
  ver = ksys_get_u16 src ulong 2
  if ne ver KSYS_ABI_VERSION
    ret KSYS_ABI_ERR_UNKNOWN_VER
  end
  tag = ksys_get_u16 src ulong 0
  if not ksys_abi_tag_valid tag
    ret KSYS_ABI_ERR_UNKNOWN_TAG
  end
  if ne tag exp_tag
    ret KSYS_ABI_ERR_TAG_MISMATCH
  end
  plen = ulong ksys_get_u32 src ulong 4
  if ne plen exp_sz
    ret KSYS_ABI_ERR_WRONG_LEN
  end
  rem_len = sub len src KSYS_ABI_ENV_HDR
  ret ksys_abi_exact rem_len exp_sz
end

note =========================================================================
note Section 2: Task Runtime State Machine & Capability Table
note =========================================================================

fn ksys_cap_reset to void
  i = ulong 0
  while lt i KSYS_TASK_CAPS bound 16
    put ksys_cap_occ i uchar 0
    put ksys_cap_gen i uint 0
    put ksys_cap_res i uint 0
    put ksys_cap_rgt i uchar 0
    put ksys_gr_act i uchar 0
    i = add i 1
  end
  ret
end

fn ksys_cap_insert res_id uint rights uchar h edit KsysHandle to uint
  i = ulong 0
  while lt i KSYS_TASK_CAPS bound 16
    if eq get ksys_cap_occ i uchar 0
      g = get ksys_cap_gen i
      if ne g uint 0xffffffff
        ng = add g uint 1
        put ksys_cap_gen i ng
        put ksys_cap_occ i uchar 1
        put ksys_cap_res i res_id
        put ksys_cap_rgt i rights
        put h index uint i
        put h gen ng
        ret KSYS_CAP_OK
      end
    end
    i = add i 1
  end
  ret KSYS_CAP_ERR_FULL
end

fn ksys_cap_lookup h view KsysHandle req_rgt uchar res_out edit uint 1 to uint
  idx = ulong get h index
  if ge idx KSYS_TASK_CAPS
    ret KSYS_CAP_ERR_INVALID
  end
  if eq get ksys_cap_occ idx uchar 0
    ret KSYS_CAP_ERR_INVALID
  end
  if ne get ksys_cap_gen idx get h gen
    ret KSYS_CAP_ERR_INVALID
  end
  have = get ksys_cap_rgt idx
  if ne and have req_rgt req_rgt
    ret KSYS_CAP_ERR_RIGHTS
  end
  put res_out 0 get ksys_cap_res idx
  ret KSYS_CAP_OK
end

fn ksys_cap_remove h view KsysHandle to uint
  idx = ulong get h index
  if ge idx KSYS_TASK_CAPS
    ret KSYS_CAP_ERR_INVALID
  end
  if eq get ksys_cap_occ idx uchar 0
    ret KSYS_CAP_ERR_INVALID
  end
  if ne get ksys_cap_gen idx get h gen
    ret KSYS_CAP_ERR_INVALID
  end
  put ksys_cap_occ idx uchar 0
  ret KSYS_CAP_OK
end

fn ksys_grant_set idx ulong rkind ushort rid uint rgt uchar to void
  put ksys_gr_act idx uchar 1
  put ksys_gr_kind idx rkind
  put ksys_gr_rid idx rid
  put ksys_gr_rgt idx rgt
  ret
end

fn ksys_grant_bounds idx ulong mops uint max_b ulong boff ulong blen ulong to void
  put ksys_gr_ops idx mops
  put ksys_gr_mbytes idx max_b
  put ksys_gr_boff idx boff
  put ksys_gr_blen idx blen
  ret
end

fn ksys_task_tick_limit cpu_ticks ulong elapsed_ticks ulong to ulong
  if lt cpu_ticks elapsed_ticks
    ret cpu_ticks
  end
  ret elapsed_ticks
end

fn ksys_task_elapsed_since start ulong now ulong to ulong
  ret sub now start
end

fn ksys_task_deadline_expired start ulong now ulong limit ulong to bool
  ret ge ksys_task_elapsed_since start now limit
end

fn ksys_task_init st edit KsysTaskState cpu_t ulong elap_t ulong max_sc uint start ulong to void
  put st cpu_ticks cpu_t
  put st elapsed_ticks elap_t
  put st max_syscalls max_sc
  put st start start
  put st syscalls uint 0
  put st reads_ok uint 0
  put st denials uint 0
  put st write_denials uint 0
  put st inv_denials uint 0
  i = ulong 0
  while lt i KSYS_TASK_CAPS bound 16
    put ksys_task_uops i uint 0
    put ksys_task_ubytes i ulong 0
    i = add i 1
  end
  put st obj 0 ulong 0xa1e05eed00000001
  put st obj 1 ulong 0xa1e05eed00000002
  put st obj 2 ulong 0xa1e05eed00000003
  put st obj 3 ulong 0xa1e05eed00000004
  put st act KSYS_ACT_RETURN
  put st act_val ulong 0
  put st st_code KSYS_STAT_NOT_RUN
  put st st_val ulong 0
  ret
end

fn ksys_task_expired st view KsysTaskState now ulong to bool
  lim = ksys_task_tick_limit get st cpu_ticks get st elapsed_ticks
  ret ksys_task_deadline_expired get st start now lim
end

fn ksys_sat_add_u32 a uint b uint to uint
  rem_max = sub uint 0xffffffff a
  if gt b rem_max
    ret uint 0xffffffff
  end
  ret add a b
end

fn ksys_task_deny st edit KsysTaskState why uint is_write bool to void
  put st denials ksys_sat_add_u32 get st denials uint 1
  if is_write
    put st write_denials ksys_sat_add_u32 get st write_denials uint 1
  end
  if eq why KSYS_DENY_INV_HANDLE
    put st inv_denials ksys_sat_add_u32 get st inv_denials uint 1
  end
  put st act KSYS_ACT_RETURN
  put st act_val KSYS_SYSCALL_DENIED
  ret
end

fn ksys_task_charge_grant gidx ulong off ulong to long
  if gt off sub ulong 0xffffffffffffffff ulong 8
    ret long -3
  end
  end_off = add off ulong 8
  bo = get ksys_gr_boff gidx
  bl = get ksys_gr_blen gidx
  if gt bo sub ulong 0xffffffffffffffff bl
    ret long -3
  end
  if ne and off ulong 7 ulong 0
    ret long -3
  end
  if lt off bo
    ret long -3
  end
  if gt end_off add bo bl
    ret long -3
  end
  if gt end_off KSYS_SEED_OBJ_BYTES
    ret long -3
  end
  ub = get ksys_task_ubytes gidx
  if gt ub sub ulong 0xffffffffffffffff ulong 8
    ret long -4
  end
  nb = add ub ulong 8
  uo = get ksys_task_uops gidx
  if ge uo get ksys_gr_ops gidx
    ret long -4
  end
  if gt nb get ksys_gr_mbytes gidx
    ret long -4
  end
  put ksys_task_uops gidx add uo uint 1
  put ksys_task_ubytes gidx nb
  ret long div off ulong 8
end

fn ksys_task_obj_access raw_h ulong rgt uchar off ulong to long
  h = new KsysHandle uint 0 uint 0
  if ne ksys_handle_from_raw raw_h h KSYS_ABI_OK
    ret long -1
  end
  r_arr = new uint 1 uint 0
  lk = ksys_cap_lookup h rgt r_arr
  if eq lk KSYS_CAP_ERR_RIGHTS
    ret long -2
  end
  if ne lk KSYS_CAP_OK
    ret long -1
  end
  gidx = ulong get r_arr 0
  if ge gidx KSYS_TASK_CAPS
    ret long -2
  end
  if eq get ksys_gr_act gidx uchar 0
    ret long -2
  end
  if ne get ksys_gr_kind gidx KSYS_RES_OBJECT
    ret long -2
  end
  if ne get ksys_gr_rid gidx KSYS_SEED_OBJ_ID
    ret long -2
  end
  if ne and get ksys_gr_rgt gidx rgt rgt
    ret long -2
  end
  ret ksys_task_charge_grant gidx off
end

fn ksys_task_syscall st edit KsysTaskState req view KsysSyscallReq to void
  sc = ksys_sat_add_u32 get st syscalls uint 1
  put st syscalls sc
  if gt sc get st max_syscalls
    put st act KSYS_ACT_TERMINATE
    put st st_code KSYS_STAT_OVERRUN
    put st st_val ulong 0
    ret
  end
  if ksys_task_expired st get req now
    put st act KSYS_ACT_TERMINATE
    put st st_code KSYS_STAT_TIMEOUT
    put st st_val ulong 0
    ret
  end
  num = get req num
  if ne get req imm ushort 0
    put st act KSYS_ACT_TERMINATE
    put st st_code KSYS_STAT_BAD_SYSCALL
    put st st_val num
    ret
  end
  if eq num KSYS_SYS_EXIT
    put st act KSYS_ACT_TERMINATE
    put st st_code KSYS_STAT_EXITED
    put st st_val get req a0
    ret
  end
  if eq num KSYS_SYS_OBJ_READ
    w = ksys_task_obj_access get req a0 uchar 1 get req a1
    if ge w long 0
      put st reads_ok ksys_sat_add_u32 get st reads_ok uint 1
      put st act KSYS_ACT_RETURN
      put st act_val get st obj ulong w
      ret
    end
    ksys_task_deny st uint sub long 0 w false
    ret
  end
  if eq num KSYS_SYS_OBJ_WRITE
    w = ksys_task_obj_access get req a0 uchar 2 get req a1
    if ge w long 0
      put st obj ulong w get req a2
      put st act KSYS_ACT_RETURN
      put st act_val ulong 0
      ret
    end
    ksys_task_deny st uint sub long 0 w true
    ret
  end
  put st act KSYS_ACT_TERMINATE
  put st st_code KSYS_STAT_BAD_SYSCALL
  put st st_val num
  ret
end

note =========================================================================
note Section 3: Thread Placement, Context, TrapFrame & User EL0 Helpers
note =========================================================================

fn ksys_place_task classes view uchar 8 counts view uint 8 n_cls uint task_idx uint res edit uint 2 to bool
  cap = uint 0
  i = uint 0
  while lt i n_cls bound 8
    cap = add cap get counts ulong i
    i = add i 1
  end
  if eq cap uint 0
    ret false
  end
  idx = rem task_idx cap
  i = uint 0
  while lt i n_cls bound 8
    c = get counts ulong i
    if lt idx c
      put res 0 uint get classes ulong i
      put res 1 idx
      ret true
    end
    idx = sub idx c
    i = add i 1
  end
  ret false
end

fn ksys_prepare_ctx base ulong stack_len ulong entry ulong arg ulong ctx edit KsysCtx to bool
  if gt base sub ulong 0xffffffffffffffff stack_len
    ret false
  end
  top = and add base stack_len xor ulong 15 ulong 0xffffffffffffffff
  if lt top ulong 16
    ret false
  end
  sp_v = sub top ulong 16
  if lt sp_v base
    ret false
  end
  put ctx x19 arg
  put ctx x20 entry
  put ctx x30 ulong 0
  put ctx sp sp_v
  ret true
end

fn ksys_prepare_trap_frame base ulong stack_len ulong entry ulong arg ulong tf edit KsysTrapFrame to bool
  if gt base sub ulong 0xffffffffffffffff stack_len
    ret false
  end
  top = and add base stack_len xor ulong 15 ulong 0xffffffffffffffff
  if lt top KSYS_TF_SIZE
    ret false
  end
  sp_v = sub top KSYS_TF_SIZE
  if lt sp_v base
    ret false
  end
  put tf x0 arg
  put tf x30 ulong 0
  put tf pad ulong 0
  put tf elr entry
  put tf spsr ulong 5
  put tf fpcr ulong 0
  put tf fpsr ulong 0
  put tf sp_addr sp_v
  ret true
end

fn ksys_user_code_pte pa ulong to ulong
  addr = and pa ulong 0x0000fffffffff000
  v = or addr KSYS_PAGE_DESC
  v = or v shl ulong 3 ulong 6
  v = or v shl ulong 3 ulong 8
  v = or v KSYS_PTE_AF
  v = or v KSYS_PTE_NG
  ret or v KSYS_PTE_PXN
end

fn ksys_user_stack_pte pa ulong to ulong
  addr = and pa ulong 0x0000fffffffff000
  v = or addr KSYS_PAGE_DESC
  v = or v shl ulong 1 ulong 6
  v = or v shl ulong 3 ulong 8
  v = or v KSYS_PTE_AF
  v = or v KSYS_PTE_NG
  v = or v KSYS_PTE_PXN
  ret or v KSYS_PTE_UXN
end

fn ksys_user_bytes_offset va_base ulong addr ulong blen ulong to long
  if gt addr sub ulong 0xffffffffffffffff blen
    ret long -1
  end
  end_a = add addr blen
  code_end = add va_base KSYS_PAGE_BYTES
  if lt addr va_base
    ret long -1
  end
  if gt end_a code_end
    ret long -1
  end
  ret long sub addr va_base
end

note =========================================================================
note Section 4: GICv3 Distributor & Redistributor Programming
note =========================================================================

fn ksys_gic_log_w log edit KsysGicLog off ulong val ulong to void
  c = ulong get log cnt
  if lt c ulong 16
    put log offs c off
    put log vals c val
    put log cnt uint add c ulong 1
  end
  ret
end

fn ksys_gicd_disable log edit KsysGicLog to void
  ksys_gic_log_w log KSYS_GICD_CTLR ulong 0
  ret
end

fn ksys_gicd_enable_group1 log edit KsysGicLog to void
  ksys_gic_log_w log KSYS_GICD_CTLR ulong 18
  ret
end

fn ksys_set_prio_byte old uint prio uchar sh uint to uint
  m = shl uint 0xff sh
  m = xor m uint 0xffffffff
  v = shl uint prio sh
  ret or and old m v
end

fn ksys_gicd_configure_spi log edit KsysGicLog intid uint prio uchar aff ulong to void
  word = ulong div intid uint 32
  bit = rem intid uint 32
  goff = add KSYS_GICD_IGROUPR mul word ulong 4
  gval = or get log read_val shl uint 1 bit
  ksys_gic_log_w log goff ulong gval
  sh = mul rem intid uint 4 uint 8
  poff = add KSYS_GICD_IPRIORITYR mul ulong div intid uint 4 ulong 4
  nv = ksys_set_prio_byte get log read_val prio sh
  ksys_gic_log_w log poff ulong nv
  roff = add KSYS_GICD_IROUTER mul ulong intid ulong 8
  ksys_gic_log_w log roff and aff ulong 0x000000ff00ffffff
  eoff = add KSYS_GICD_ISENABLER mul word ulong 4
  ksys_gic_log_w log eoff ulong shl uint 1 bit
  ret
end

fn ksys_gicr_wake log edit KsysGicLog poll_limit uint to bool
  val = and get log read_val xor uint 2 uint 0xffffffff
  ksys_gic_log_w log KSYS_GICR_WAKER ulong val
  i = uint 0
  while lt i poll_limit bound 1024
    if eq and get log read_val uint 4 uint 0
      ret true
    end
    i = add i 1
  end
  ret false
end

fn ksys_gicr_configure_ppi log edit KsysGicLog intid uchar prio uchar to bool
  if ge intid uchar 32
    ret false
  end
  id32 = uint intid
  grp = or get log read_val shl uint 1 id32
  ksys_gic_log_w log KSYS_GICR_IGROUPR0 ulong grp
  poff = add KSYS_GICR_IPRIORITYR mul ulong div id32 uint 4 ulong 4
  sh = mul rem id32 uint 4 uint 8
  old = get log read_val
  mask = xor shl uint 0xff sh uint 0xffffffff
  nv = or and old mask shl uint prio sh
  ksys_gic_log_w log poff ulong nv
  ksys_gic_log_w log KSYS_GICR_ISENABLER0 ulong shl uint 1 id32
  ret true
end

note =========================================================================
note Section 5: Architectural Timer Arithmetic (Exact 128-bit)
note =========================================================================

fn ksys_u128_mul a ulong b ulong dst edit ulong 2 to void
  p0 = mul and a ulong 0xffffffff and b ulong 0xffffffff
  p1 = mul and a ulong 0xffffffff shr b ulong 32
  p2 = mul shr a ulong 32 and b ulong 0xffffffff
  mid = shr p0 ulong 32
  mid = add mid and p1 ulong 0xffffffff
  mid = add mid and p2 ulong 0xffffffff
  lo = or and p0 ulong 0xffffffff shl and mid ulong 0xffffffff ulong 32
  put dst 0 lo
  hi = mul shr a ulong 32 shr b ulong 32
  hi = add hi shr p1 ulong 32
  hi = add hi shr p2 ulong 32
  hi = add hi shr mid ulong 32
  put dst 1 hi
  ret
end

fn ksys_u128_div_u64 hi ulong lo ulong d ulong q_out edit ulong 1 to bool
  if eq d ulong 0
    ret false
  end
  if ge hi d
    ret false
  end
  r = hi
  q = ulong 0
  i = uint 0
  while lt i uint 64 bound 64
    top_r = shr r ulong 63
    top_l = shr lo ulong 63
    r = or shl r ulong 1 top_l
    lo = shl lo ulong 1
    q = shl q ulong 1
    if eq top_r ulong 1
      r = sub r d
      q = or q ulong 1
    else
      if ge r d
        r = sub r d
        q = or q ulong 1
      end
    end
    i = add i 1
  end
  put q_out 0 q
  ret true
end

fn ksys_ns_to_ticks ns ulong freq_hz ulong dst edit ulong 1 to bool
  if eq freq_hz ulong 0
    ret false
  end
  prod = new ulong 2 ulong 0
  ksys_u128_mul ns freq_hz prod
  lo = get prod 0
  hi = get prod 1
  add_k = ulong 999999999
  if gt lo sub ulong 0xffffffffffffffff add_k
    if eq hi ulong 0xffffffffffffffff
      lo = ulong 0xffffffffffffffff
    else
      lo = add lo add_k
      hi = add hi ulong 1
    end
  else
    lo = add lo add_k
  end
  ret ksys_u128_div_u64 hi lo ulong 1000000000 dst
end

fn ksys_ticks_to_ns ticks ulong freq_hz ulong dst edit ulong 1 to bool
  if eq freq_hz ulong 0
    ret false
  end
  prod = new ulong 2 ulong 0
  ksys_u128_mul ticks ulong 1000000000 prod
  ret ksys_u128_div_u64 get prod 1 get prod 0 freq_hz dst
end

fn ksys_deadline_after now ulong delay_ns ulong freq_hz ulong dst edit ulong 1 to bool
  delta = new ulong 1 ulong 0
  if not ksys_ns_to_ticks delay_ns freq_hz delta
    ret false
  end
  d = get delta 0
  if gt now sub ulong 0xffffffffffffffff d
    ret false
  end
  put dst 0 add now d
  ret true
end

note =========================================================================
note Section 6: Early Serial Console (PL011)
note =========================================================================

fn ksys_console_from_kind kind uint con edit uint 10 to bool
  if eq kind KSYS_UART_UNSUPPORTED
    ret false
  end
  put con 8 kind
  put con 9 uint 0
  i = ulong 0
  while lt i ulong 8 bound 8
    put con i uint 0
    i = add i 1
  end
  ret true
end

fn ksys_console_write_byte con edit uint 10 b uchar to void
  if ne get con 9 uint 0
    ret
  end
  polls = uint 0
  while ne and get con 6 KSYS_PL011_TX_FULL uint 0 bound 1024
    polls = add polls uint 1
    if ge polls KSYS_UART_SPIN_LIMIT
      put con 9 uint 1
      ret
    end
  end
  put con 0 uint b
  ret
end

fn ksys_console_write_str con edit uint 10 s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 4096
    b = get s i
    if eq b uchar 10
      ksys_console_write_byte con uchar 13
    end
    ksys_console_write_byte con b
    i = add i 1
  end
  ret
end

note =========================================================================
note Section 7: ReportBuf (UTF-8-boundary truncation) & Formatting Helpers
note =========================================================================

fn ksys_utf8_char_len b uchar to ulong
  if lt b uchar 0x80
    ret ulong 1
  end
  if lt b uchar 0xc0
    ret ulong 1
  end
  if lt b uchar 0xe0
    ret ulong 2
  end
  if lt b uchar 0xf0
    ret ulong 3
  end
  ret ulong 4
end

fn ksys_report_append dst edit uchar * cur ulong src view uchar * trunc edit uchar 1 to ulong
  pos = cur
  i = ulong 0
  while lt i len src bound 4096
    clen = ksys_utf8_char_len get src i
    if gt add i clen len src
      clen = sub len src i
    end
    if gt add pos clen len dst
      put trunc 0 uchar 1
      ret pos
    end
    j = ulong 0
    while lt j clen bound 4
      b = get src add i j
      put dst add pos j b
      j = add j 1
    end
    pos = add pos clen
    i = add i clen
  end
  ret pos
end

fn ksys_report_append_byte dst edit uchar * cur ulong b uchar trunc edit uchar 1 to ulong
  if ge cur len dst
    put trunc 0 uchar 1
    ret cur
  end
  put dst cur b
  ret add cur ulong 1
end

fn ksys_report_append_u64_dec dst edit uchar * cur ulong v ulong trunc edit uchar 1 to ulong
  tmp = new uchar 24 uchar 0
  cnt = ulong 0
  x = v
  if eq x ulong 0
    put tmp 0 uchar 48
    cnt = ulong 1
  else
    while gt x ulong 0 bound 24
      d = rem x ulong 10
      put tmp cnt uchar add d ulong 48
      cnt = add cnt ulong 1
      x = div x ulong 10
    end
  end
  rev = new uchar 24 uchar 0
  i = ulong 0
  while lt i cnt bound 24
    put rev i get tmp sub sub cnt ulong 1 i
    i = add i 1
  end
  ret ksys_report_append dst cur part rev 0 cnt trunc
end

fn ksys_report_append_u64_hex dst edit uchar * cur ulong v ulong trunc edit uchar 1 to ulong
  tmp = new uchar 16 uchar 0
  cnt = ulong 0
  x = v
  if eq x ulong 0
    put tmp 0 uchar 48
    cnt = ulong 1
  else
    while gt x ulong 0 bound 16
      d = and x ulong 15
      if lt d ulong 10
        put tmp cnt uchar add d ulong 48
      else
        put tmp cnt uchar add sub d ulong 10 ulong 97
      end
      cnt = add cnt ulong 1
      x = shr x ulong 4
    end
  end
  rev = new uchar 16 uchar 0
  i = ulong 0
  while lt i cnt bound 16
    put rev i get tmp sub sub cnt ulong 1 i
    i = add i 1
  end
  ret ksys_report_append dst cur part rev 0 cnt trunc
end

fn ksys_bytes_match_at hay view uchar * ndl view uchar * off ulong to bool
  j = ulong 0
  while lt j len ndl bound 256
    if ne get hay add off j get ndl j
      ret false
    end
    j = add j 1
  end
  ret true
end

fn ksys_bytes_contains hay view uchar * ndl view uchar * to bool
  if eq len ndl ulong 0
    ret true
  end
  if gt len ndl len hay
    ret false
  end
  lim = add sub len hay len ndl ulong 1
  i = ulong 0
  while lt i lim bound 4096
    if ksys_bytes_match_at hay ndl i
      ret true
    end
    i = add i 1
  end
  ret false
end

fn ksys_bytes_eq a view uchar * b view uchar * to bool
  if ne len a len b
    ret false
  end
  i = ulong 0
  n = len a
  while lt i n bound 4096
    if ne get a i get b i
      ret false
    end
    i = add i 1
  end
  ret true
end

note =========================================================================
note Section 8: Fatal / ESR Decoding
note =========================================================================

fn ksys_decode_esr esr ulong info edit KsysEsrInfo to void
  ec = uchar and shr esr ulong 26 ulong 0x3f
  iss = uint and esr ulong 0x1ffffff
  put info ec ec
  put info iss iss
  is_inst = or eq ec uchar 0x20 eq ec uchar 0x21
  is_data = or eq ec uchar 0x24 eq ec uchar 0x25
  if or is_inst is_data
    put info has_abort true
    put info inst_abort is_inst
    put info fsc uchar and iss uint 0x3f
    put info s1ptw ne and iss shl uint 1 uint 7 uint 0
    put info cm ne and iss shl uint 1 uint 8 uint 0
    put info ea ne and iss shl uint 1 uint 9 uint 0
    put info fnv ne and iss shl uint 1 uint 10 uint 0
    if not is_inst
      put info is_write ne and iss shl uint 1 uint 6 uint 0
    else
      put info is_write false
    end
    if is_data
      if ne and iss shl uint 1 uint 24 uint 0
        put info has_acc true
        put info acc_reg uchar and shr iss uint 16 uint 0x1f
        put info acc_sz uchar and shr iss uint 22 uint 3
        put info acc_sse ne and iss shl uint 1 uint 21 uint 0
      else
        put info has_acc false
        put info acc_reg uchar 0
        put info acc_sz uchar 0
        put info acc_sse false
      end
    else
      put info has_acc false
      put info acc_reg uchar 0
      put info acc_sz uchar 0
      put info acc_sse false
    end
  else
    put info has_abort false
    put info inst_abort false
    put info fsc uchar 0
    put info s1ptw false
    put info cm false
    put info ea false
    put info fnv false
    put info is_write false
    put info has_acc false
    put info acc_reg uchar 0
    put info acc_sz uchar 0
    put info acc_sse false
  end
  ret
end

fn ksys_fault_kind vec ulong to uint
  ret uint rem vec ulong 4
end

fn ksys_fault_origin vec ulong to uint
  ret uint rem div vec ulong 4 ulong 4
end

fn ksys_fault_ec esr ulong to uchar
  ret uchar and shr esr ulong 26 ulong 0x3f
end

fn ksys_append_ec_name dst edit uchar * cur ulong ec uchar trunc edit uchar 1 to ulong
  if eq ec uchar 0x00
    ret ksys_report_append dst cur ksys_ec_00 trunc
  end
  if eq ec uchar 0x01
    ret ksys_report_append dst cur ksys_ec_01 trunc
  end
  if eq ec uchar 0x0e
    ret ksys_report_append dst cur ksys_ec_0e trunc
  end
  if eq ec uchar 0x15
    ret ksys_report_append dst cur ksys_ec_15 trunc
  end
  if eq ec uchar 0x16
    ret ksys_report_append dst cur ksys_ec_16 trunc
  end
  if eq ec uchar 0x17
    ret ksys_report_append dst cur ksys_ec_17 trunc
  end
  if eq ec uchar 0x18
    ret ksys_report_append dst cur ksys_ec_18 trunc
  end
  if eq ec uchar 0x20
    ret ksys_report_append dst cur ksys_ec_20 trunc
  end
  if eq ec uchar 0x21
    ret ksys_report_append dst cur ksys_ec_21 trunc
  end
  if eq ec uchar 0x22
    ret ksys_report_append dst cur ksys_ec_22 trunc
  end
  if eq ec uchar 0x24
    ret ksys_report_append dst cur ksys_ec_24 trunc
  end
  if eq ec uchar 0x25
    ret ksys_report_append dst cur ksys_ec_25 trunc
  end
  if eq ec uchar 0x26
    ret ksys_report_append dst cur ksys_ec_26 trunc
  end
  if eq ec uchar 0x2f
    ret ksys_report_append dst cur ksys_ec_2f trunc
  end
  if eq ec uchar 0x3c
    ret ksys_report_append dst cur ksys_ec_3c trunc
  end
  ret ksys_report_append dst cur ksys_ec_other trunc
end

fn ksys_format_fault f view ulong 6 dst edit uchar * to ulong
  tr = new uchar 1 uchar 0
  p = ksys_report_append dst ulong 0 ksys_flt_p_cls tr
  ec = ksys_fault_ec get f 2
  if lt ec uchar 16
    p = ksys_report_append_byte dst p uchar 48 tr
  end
  p = ksys_report_append_u64_hex dst p ulong ec tr
  p = ksys_report_append_byte dst p uchar 32 tr
  p = ksys_report_append_byte dst p uchar 40 tr
  p = ksys_append_ec_name dst p ec tr
  p = ksys_report_append_byte dst p uchar 41 tr
  p = ksys_report_append_byte dst p uchar 10 tr
  p = ksys_report_append dst p ksys_flt_p_far tr
  p = ksys_report_append_u64_hex dst p get f 4 tr
  p = ksys_report_append_byte dst p uchar 10 tr
  ret p
end

note =========================================================================
note Section 9: Bounded Line Shell Parser & Dispatcher
note =========================================================================

fn ksys_is_ws b uchar to bool
  if eq b uchar 32
    ret true
  end
  if eq b uchar 9
    ret true
  end
  if eq b uchar 10
    ret true
  end
  if eq b uchar 13
    ret true
  end
  if eq b uchar 12
    ret true
  end
  ret false
end

fn ksys_shell_match_cmd tok view uchar * to uint
  if ksys_bytes_eq tok ksys_txt_help
    ret KSYS_CMD_HELP
  end
  if ksys_bytes_eq tok ksys_txt_mem
    ret KSYS_CMD_MEM
  end
  if ksys_bytes_eq tok ksys_txt_el
    ret KSYS_CMD_EL
  end
  if ksys_bytes_eq tok ksys_txt_report
    ret KSYS_CMD_REPORT
  end
  if ksys_bytes_eq tok ksys_txt_uptime
    ret KSYS_CMD_UPTIME
  end
  if ksys_bytes_eq tok ksys_txt_exit
    ret KSYS_CMD_EXIT
  end
  ret KSYS_CMD_UNKNOWN
end

fn ksys_shell_parse line view uchar * parsed edit ulong 6 to bool
  n = len line
  if gt n KSYS_SHELL_LINE_CAP
    ret false
  end
  i = ulong 0
  while lt i n bound 65
    if not ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  if ge i n
    ret false
  end
  t0_off = i
  while lt i n bound 65
    if ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  t0_len = sub i t0_off
  if gt t0_len KSYS_SHELL_TOK_CAP
    ret false
  end
  while lt i n bound 65
    if not ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  has_a = ulong 0
  a_off = ulong 0
  a_len = ulong 0
  if lt i n
    has_a = ulong 1
    a_off = i
    while lt i n bound 65
      if ksys_is_ws get line i
        break
      end
      i = add i 1
    end
    a_len = sub i a_off
    if gt a_len KSYS_SHELL_TOK_CAP
      ret false
    end
    while lt i n bound 65
      if not ksys_is_ws get line i
        ret false
      end
      i = add i 1
    end
  end
  cmd = ksys_shell_match_cmd part line t0_off t0_len
  put parsed 0 ulong cmd
  put parsed 1 t0_off
  put parsed 2 t0_len
  put parsed 3 has_a
  put parsed 4 a_off
  put parsed 5 a_len
  ret true
end

fn ksys_shell_dispatch line view uchar * ctx view ulong 4 dst edit uchar * to ulong
  tr = new uchar 1 uchar 0
  pl = new ulong 6 ulong 0
  if not ksys_shell_parse line pl
    ret ksys_report_append dst ulong 0 ksys_msg_invalid tr
  end
  cmd = uint get pl 0
  if eq cmd KSYS_CMD_HELP
    ret ksys_report_append dst ulong 0 ksys_msg_help tr
  end
  if eq cmd KSYS_CMD_MEM
    p = ksys_report_append dst ulong 0 ksys_msg_mem tr
    p = ksys_report_append_u64_dec dst p get ctx 0 tr
    ret ksys_report_append_byte dst p uchar 10 tr
  end
  if eq cmd KSYS_CMD_EL
    p = ksys_report_append dst ulong 0 ksys_msg_el tr
    p = ksys_report_append_u64_dec dst p get ctx 1 tr
    ret ksys_report_append_byte dst p uchar 10 tr
  end
  if eq cmd KSYS_CMD_REPORT
    rlen = get ctx 3
    p = ulong 0
    i = ulong 0
    while lt i rlen bound 64
      p = ksys_report_append_byte dst p get ksys_shell_rep i tr
      i = add i 1
    end
    ret p
  end
  if eq cmd KSYS_CMD_UPTIME
    p = ksys_report_append dst ulong 0 ksys_msg_uptime tr
    p = ksys_report_append_u64_dec dst p get ctx 2 tr
    ret ksys_report_append_byte dst p uchar 10 tr
  end
  if eq cmd KSYS_CMD_EXIT
    ret ulong 0
  end
  p = ksys_report_append dst ulong 0 ksys_msg_unk tr
  p = ksys_report_append dst p part line get pl 1 get pl 2 tr
  ret ksys_report_append_byte dst p uchar 10 tr
end

note =========================================================================
note Section 10: PE32+ AArch64 Section Table Parser
note =========================================================================

fn ksys_pe_check_hdr img view uchar * meta edit ulong 2 to uint
  n = len img
  if lt n ulong 2
    ret KSYS_PE_ERR_TRUNC
  end
  if ne ksys_get_u16 img ulong 0 ushort 0x5a4d
    ret KSYS_PE_ERR_DOS
  end
  if lt n ulong 0x40
    ret KSYS_PE_ERR_TRUNC
  end
  pe = ulong ksys_get_u32 img ulong 0x3c
  if gt pe sub ulong 0xffffffffffffffff ulong 4
    ret KSYS_PE_ERR_OVF
  end
  if gt add pe ulong 4 n
    ret KSYS_PE_ERR_TRUNC
  end
  if ne ksys_get_u32 img pe uint 0x00004550
    ret KSYS_PE_ERR_SIG
  end
  coff = add pe ulong 4
  if gt coff sub ulong 0xffffffffffffffff ulong 20
    ret KSYS_PE_ERR_OVF
  end
  if gt add coff ulong 20 n
    ret KSYS_PE_ERR_TRUNC
  end
  if ne ksys_get_u16 img coff KSYS_PE_ARM64
    ret KSYS_PE_ERR_MACH
  end
  cnt = ulong ksys_get_u16 img add coff ulong 2
  opt_sz = ulong ksys_get_u16 img add coff ulong 16
  opt = add coff ulong 20
  if gt opt sub ulong 0xffffffffffffffff opt_sz
    ret KSYS_PE_ERR_OVF
  end
  opt_end = add opt opt_sz
  if gt opt_end n
    ret KSYS_PE_ERR_TRUNC
  end
  if lt opt_sz ulong 2
    ret KSYS_PE_ERR_TRUNC
  end
  if ne ksys_get_u16 img opt KSYS_PE_OPT_PLUS
    ret KSYS_PE_ERR_OPT
  end
  tlen = mul cnt ulong 40
  if gt opt_end sub ulong 0xffffffffffffffff tlen
    ret KSYS_PE_ERR_OVF
  end
  if gt add opt_end tlen n
    ret KSYS_PE_ERR_TRUNC
  end
  put meta 0 opt_end
  put meta 1 cnt
  ret KSYS_PE_OK
end

fn ksys_pe_check_overlap tbl view KsysPeTable va ulong sz ulong p_end ulong to uint
  cnt = ulong get tbl cnt
  j = ulong 0
  while lt j cnt bound 16
    pva = get tbl va j
    psz = get tbl sz j
    if gt pva sub ulong 0xffffffffffffffff psz
      ret KSYS_PE_ERR_OVF
    end
    if ne sz ulong 0
      if ne psz ulong 0
        if lt va add pva psz
          if lt pva p_end
            ret KSYS_PE_ERR_OVERLAP
          end
        end
      end
    end
    j = add j 1
  end
  ret KSYS_PE_OK
end

fn ksys_pe_commit tbl edit KsysPeTable va ulong p_end ulong ch uint to uint
  sz = sub p_end va
  ov = ksys_pe_check_overlap tbl va sz p_end
  if ne ov KSYS_PE_OK
    ret ov
  end
  idx = ulong get tbl cnt
  put tbl va idx va
  put tbl sz idx sz
  put tbl ch idx ch
  put tbl cnt uint add idx ulong 1
  ret KSYS_PE_OK
end

fn ksys_pe_parse_one img view uchar * img_base ulong h ulong tbl edit KsysPeTable to uint
  bytes = ulong ksys_get_u32 img add h ulong 8
  rsz = ulong ksys_get_u32 img add h ulong 16
  if gt rsz bytes
    bytes = rsz
  end
  rva = ulong ksys_get_u32 img add h ulong 12
  if gt img_base sub ulong 0xffffffffffffffff rva
    ret KSYS_PE_ERR_OVF
  end
  start = add img_base rva
  ch = ksys_get_u32 img add h ulong 36
  if ne and ch KSYS_PE_WRITE uint 0
    if ne and ch KSYS_PE_EXEC uint 0
      ret KSYS_PE_ERR_WX
    end
  end
  if gt start sub ulong 0xffffffffffffffff bytes
    ret KSYS_PE_ERR_OVF
  end
  bytes = add start bytes
  if gt bytes sub ulong 0xffffffffffffffff ulong 4095
    ret KSYS_PE_ERR_OVF
  end
  va = and start ulong 0xfffffffffffff000
  p_end = and add bytes ulong 4095 ulong 0xfffffffffffff000
  ret ksys_pe_commit tbl va p_end ch
end

fn ksys_pe_parse_sections img view uchar * img_base ulong tbl edit KsysPeTable to uint
  meta = new ulong 2 ulong 0
  eh = ksys_pe_check_hdr img meta
  if ne eh KSYS_PE_OK
    ret eh
  end
  tab = get meta 0
  cnt = get meta 1
  if gt cnt ulong 16
    ret KSYS_PE_ERR_OVF
  end
  put tbl cnt uint 0
  i = ulong 0
  while lt i cnt bound 16
    e = ksys_pe_parse_one img img_base add tab mul i ulong 40 tbl
    if ne e KSYS_PE_OK
      ret e
    end
    i = add i 1
  end
  ret KSYS_PE_OK
end

note =========================================================================
note Section 11: SpinLock State Model
note =========================================================================

fn ksys_spin_init lk edit ulong 2 val ulong to void
  put lk 0 ulong 0
  put lk 1 val
  ret
end

fn ksys_spin_try_lock lk edit ulong 2 to bool
  if ne get lk 0 ulong 0
    ret false
  end
  put lk 0 ulong 1
  ret true
end

fn ksys_spin_unlock lk edit ulong 2 to void
  put lk 0 ulong 0
  ret
end

note =========================================================================
note Section 12: Kernel Infer — GEMM, RMSNorm, Softmax, SiLU
note =========================================================================

fn ksys_f32_is_finite x f32 to bool
  bits = bitcast uint x
  ret ne and bits uint 0x7f800000 uint 0x7f800000
end

fn ksys_sqrt_approx x f32 to f32
  if eq x 0.0f32
    ret 0.0f32
  end
  bits = bitcast uint x
  y = bitcast f32 add shr bits uint 1 uint 0x1fc00000
  i = uint 0
  while lt i uint 5 bound 5
    y = mul 0.5f32 add y div x y
    i = add i 1
  end
  ret y
end

fn ksys_exp_approx x f32 to f32
  cx = x
  if lt cx -87.0f32
    cx = -87.0f32
  end
  if gt cx 88.0f32
    cx = 88.0f32
  end
  scaled = mul cx 1.44269504f32
  n = int 0
  if ge scaled 0.0f32
    n = int add scaled 0.5f32
  else
    n = int sub scaled 0.5f32
  end
  r = sub cx mul f32 n 0.69314718f32
  p = add 0.041666668f32 div r 120.0f32
  p = add 0.16666667f32 mul r p
  p = add 0.5f32 mul r p
  p = add 1.0f32 mul r p
  p = add 1.0f32 mul r p
  e_bits = shl uint add n int 127 uint 23
  ret mul p bitcast f32 e_bits
end

fn ksys_fits blen ulong rows ulong cols ulong stride ulong to bool
  if eq rows ulong 0
    ret true
  end
  if eq cols ulong 0
    ret true
  end
  if lt stride cols
    ret false
  end
  r1 = sub rows ulong 1
  if gt r1 ulong 0
    if gt r1 div ulong 0xffffffffffffffff stride
      ret false
    end
  end
  off = mul r1 stride
  if gt off sub ulong 0xffffffffffffffff cols
    ret false
  end
  ret le add off cols blen
end

fn ksys_gemm_set_matvec rows ulong cols ulong m_s ulong v_s ulong o_s ulong to void
  put ksys_gemm_dims 0 rows
  put ksys_gemm_dims 1 cols
  put ksys_gemm_dims 2 m_s
  put ksys_gemm_dims 3 v_s
  put ksys_gemm_dims 4 o_s
  ret
end

fn ksys_matvec_row mat view f32 * vec view f32 * row ulong to f32
  acc = 0.0f32
  c = ulong 0
  while lt c get ksys_gemm_dims 1 bound 256
    a_v = get mat add mul row get ksys_gemm_dims 2 c
    x_v = get vec mul c get ksys_gemm_dims 3
    acc = add acc mul a_v x_v
    c = add c 1
  end
  ret acc
end

fn ksys_matvec mat view f32 * vec view f32 * dst edit f32 * to uint
  if not ksys_fits len mat get ksys_gemm_dims 0 get ksys_gemm_dims 1 get ksys_gemm_dims 2
    ret KSYS_KERN_ERR_SHAPE
  end
  if not ksys_fits len vec get ksys_gemm_dims 1 ulong 1 get ksys_gemm_dims 3
    ret KSYS_KERN_ERR_SHAPE
  end
  if not ksys_fits len dst get ksys_gemm_dims 0 ulong 1 get ksys_gemm_dims 4
    ret KSYS_KERN_ERR_SHAPE
  end
  r = ulong 0
  while lt r get ksys_gemm_dims 0 bound 256
    put dst mul r get ksys_gemm_dims 4 ksys_matvec_row mat vec r
    r = add r 1
  end
  ret KSYS_KERN_OK
end

fn ksys_gemm_set_matmul m ulong k ulong n ulong a_s ulong b_s ulong o_s ulong to void
  put ksys_gemm_dims 0 m
  put ksys_gemm_dims 1 k
  put ksys_gemm_dims 2 n
  put ksys_gemm_dims 3 a_s
  put ksys_gemm_dims 4 b_s
  put ksys_gemm_dims 5 o_s
  ret
end

fn ksys_matmul_dot a view f32 * b view f32 * row ulong col ulong to f32
  acc = 0.0f32
  p = ulong 0
  while lt p get ksys_gemm_dims 1 bound 256
    av = get a add mul row get ksys_gemm_dims 3 p
    bv = get b add mul p get ksys_gemm_dims 4 col
    acc = add acc mul av bv
    p = add p 1
  end
  ret acc
end

fn ksys_matmul a view f32 * b view f32 * dst edit f32 * to uint
  if not ksys_fits len a get ksys_gemm_dims 0 get ksys_gemm_dims 1 get ksys_gemm_dims 3
    ret KSYS_KERN_ERR_SHAPE
  end
  if not ksys_fits len b get ksys_gemm_dims 1 get ksys_gemm_dims 2 get ksys_gemm_dims 4
    ret KSYS_KERN_ERR_SHAPE
  end
  if not ksys_fits len dst get ksys_gemm_dims 0 get ksys_gemm_dims 2 get ksys_gemm_dims 5
    ret KSYS_KERN_ERR_SHAPE
  end
  i = ulong 0
  while lt i get ksys_gemm_dims 0 bound 256
    j = ulong 0
    while lt j get ksys_gemm_dims 2 bound 256
      put dst add mul i get ksys_gemm_dims 5 j ksys_matmul_dot a b i j
      j = add j 1
    end
    i = add i 1
  end
  ret KSYS_KERN_OK
end

fn ksys_rms_norm x edit f32 * w view f32 * eps f32 to uint
  n = len x
  if ne n len w
    ret KSYS_KERN_ERR_SHAPE
  end
  if not ksys_f32_is_finite eps
    ret KSYS_KERN_ERR_PARAM
  end
  if le eps 0.0f32
    ret KSYS_KERN_ERR_PARAM
  end
  if eq n ulong 0
    ret KSYS_KERN_OK
  end
  ss = 0.0f32
  i = ulong 0
  while lt i n bound 4096
    v = get x i
    ss = add ss mul v v
    i = add i 1
  end
  mean = div ss f32 n
  scale = div 1.0f32 ksys_sqrt_approx add mean eps
  i = ulong 0
  while lt i n bound 4096
    put x i mul get x i mul scale get w i
    i = add i 1
  end
  ret KSYS_KERN_OK
end

fn ksys_softmax x edit f32 * to uint
  n = len x
  i = ulong 0
  while lt i n bound 4096
    if not ksys_f32_is_finite get x i
      ret KSYS_KERN_ERR_PARAM
    end
    i = add i 1
  end
  if eq n ulong 0
    ret KSYS_KERN_OK
  end
  mx = get x 0
  i = ulong 1
  while lt i n bound 4096
    v = get x i
    if gt v mx
      mx = v
    end
    i = add i 1
  end
  sm = 0.0f32
  i = ulong 0
  while lt i n bound 4096
    ev = ksys_exp_approx sub get x i mx
    put x i ev
    sm = add sm ev
    i = add i 1
  end
  i = ulong 0
  while lt i n bound 4096
    put x i div get x i sm
    i = add i 1
  end
  ret KSYS_KERN_OK
end

fn ksys_silu x edit f32 * to void
  n = len x
  i = ulong 0
  while lt i n bound 4096
    v = get x i
    put x i div v add 1.0f32 ksys_exp_approx neg v
    i = add i 1
  end
  ret
end

note =========================================================================
note Section 13: Kernel Infer — RoPE (Rotary Position Embeddings)
note =========================================================================

fn ksys_ln_approx x f32 to f32
  bits = bitcast uint x
  ex = sub int and shr bits uint 23 uint 0xff int 127
  mbits = or and bits uint 0x7fffff shl uint 127 uint 23
  m = bitcast f32 mbits
  y = div sub m 1.0f32 add m 1.0f32
  y2 = mul y y
  s = add 0.14285715f32 div y2 9.0f32
  s = add 0.2f32 mul y2 s
  s = add 0.33333334f32 mul y2 s
  s = mul y add 1.0f32 mul y2 s
  ret add mul 2.0f32 s mul f32 ex 0.69314718f32
end

fn ksys_sin_cos_approx angle f32 dst edit f32 2 to void
  r = add angle 3.14159265f32
  r = sub r mul f32 int div r 6.28318531f32 6.28318531f32
  if lt r 0.0f32
    r = add r 6.28318531f32
  end
  if ge r 6.28318531f32
    r = sub r 6.28318531f32
  end
  x = sub r 3.14159265f32
  csign = 1.0f32
  if gt x 1.57079633f32
    x = sub 3.14159265f32 x
    csign = -1.0f32
  else
    if lt x -1.57079633f32
      x = sub -3.14159265f32 x
      csign = -1.0f32
    end
  end
  x2 = mul x x
  sv = add -0.0001984127f32 mul x2 2.7557319e-6f32
  sv = add 0.008333334f32 mul x2 sv
  sv = add -0.16666667f32 mul x2 sv
  put dst 0 mul x add 1.0f32 mul x2 sv
  cv = sub 2.4801587e-5f32 mul x2 2.7557319e-7f32
  cv = add -0.0013888889f32 mul x2 cv
  cv = add 0.041666668f32 mul x2 cv
  cv = add -0.5f32 mul x2 cv
  put dst 1 mul csign add 1.0f32 mul x2 cv
  ret
end

fn ksys_rope_set_dims head_dim ulong max_seq ulong pos ulong to void
  put ksys_rope_dims 0 head_dim
  put ksys_rope_dims 1 max_seq
  put ksys_rope_dims 2 pos
  ret
end

fn ksys_rope_pair_sc pos ulong pr ulong head_dim ulong lnt f32 sc edit f32 2 to void
  ex = div f32 mul ulong 2 pr f32 head_dim
  freq = ksys_exp_approx mul ex lnt
  ksys_sin_cos_approx div f32 pos freq sc
  ret
end

fn ksys_rope_precompute theta f32 cos_t edit f32 * sin_t edit f32 * to uint
  head_dim = get ksys_rope_dims 0
  if le theta 0.0f32
    ret KSYS_KERN_ERR_PARAM
  end
  if not ksys_f32_is_finite theta
    ret KSYS_KERN_ERR_PARAM
  end
  if eq head_dim ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  if ne rem head_dim ulong 2 ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  pairs = div head_dim ulong 2
  if lt len cos_t mul get ksys_rope_dims 1 pairs
    ret KSYS_KERN_ERR_SHAPE
  end
  if lt len sin_t mul get ksys_rope_dims 1 pairs
    ret KSYS_KERN_ERR_SHAPE
  end
  lnt = ksys_ln_approx theta
  sc = new f32 2 0.0f32
  pos = ulong 0
  while lt pos get ksys_rope_dims 1 bound 1024
    pr = ulong 0
    while lt pr pairs bound 256
      ksys_rope_pair_sc pos pr head_dim lnt sc
      put cos_t add mul pos pairs pr get sc 1
      put sin_t add mul pos pairs pr get sc 0
      pr = add pr 1
    end
    pos = add pos 1
  end
  ret KSYS_KERN_OK
end

fn ksys_rope_rot_pair vals edit f32 * ei ulong cv f32 sv f32 to void
  ev = get vals ei
  ov = get vals add ei ulong 1
  put vals ei sub mul ev cv mul ov sv
  put vals add ei ulong 1 add mul ev sv mul ov cv
  ret
end

fn ksys_rope_rot_head vals edit f32 * cos_t view f32 * sin_t view f32 * to void
  pr = ulong 0
  while lt pr div get ksys_rope_dims 0 ulong 2 bound 256
    ei = mul get ksys_rope_dims 3 get ksys_rope_dims 0
    ei = add ei mul ulong 2 pr
    off = div get ksys_rope_dims 0 ulong 2
    off = add mul get ksys_rope_dims 2 off pr
    cv = get cos_t off
    sv = get sin_t off
    ksys_rope_rot_pair vals ei cv sv
    pr = add pr 1
  end
  ret
end

fn ksys_rope_rotate vals edit f32 * cos_t view f32 * sin_t view f32 * to uint
  head_dim = get ksys_rope_dims 0
  if eq head_dim ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  if ne rem head_dim ulong 2 ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  pairs = div head_dim ulong 2
  off = mul get ksys_rope_dims 2 pairs
  if ne rem len vals head_dim ulong 0
    ret KSYS_KERN_ERR_SHAPE
  end
  if gt add off pairs len cos_t
    ret KSYS_KERN_ERR_SHAPE
  end
  if gt add off pairs len sin_t
    ret KSYS_KERN_ERR_SHAPE
  end
  h = ulong 0
  while lt h div len vals head_dim bound 256
    put ksys_rope_dims 3 h
    ksys_rope_rot_head vals cos_t sin_t
    h = add h 1
  end
  ret KSYS_KERN_OK
end

note =========================================================================
note Section 14: Kernel Infer — KV Cache & Grouped-Query Attention
note =========================================================================

fn ksys_kv_init keys view f32 * vals view f32 * meta edit ulong 4 to uint
  cap = get meta 0
  n_kv = get meta 1
  hdim = get meta 2
  if eq n_kv ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  if eq hdim ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  req = mul mul cap n_kv hdim
  if lt len keys req
    ret KSYS_KERN_ERR_SHAPE
  end
  if lt len vals req
    ret KSYS_KERN_ERR_SHAPE
  end
  put meta 3 ulong 0
  ret KSYS_KERN_OK
end

fn ksys_kv_append_k cache_k edit f32 * src_k view f32 * meta view ulong 4 to uint
  w = mul get meta 1 get meta 2
  if ne len src_k w
    ret KSYS_KERN_ERR_SHAPE
  end
  if eq get meta 3 get meta 0
    ret KSYS_KERN_ERR_SHAPE
  end
  st = mul get meta 3 w
  i = ulong 0
  while lt i w bound 1024
    put cache_k add st i get src_k i
    i = add i 1
  end
  ret KSYS_KERN_OK
end

fn ksys_kv_append_v cache_v edit f32 * src_v view f32 * meta edit ulong 4 to uint
  w = mul get meta 1 get meta 2
  if ne len src_v w
    ret KSYS_KERN_ERR_SHAPE
  end
  if eq get meta 3 get meta 0
    ret KSYS_KERN_ERR_SHAPE
  end
  st = mul get meta 3 w
  i = ulong 0
  while lt i w bound 1024
    put cache_v add st i get src_v i
    i = add i 1
  end
  put meta 3 add get meta 3 ulong 1
  ret KSYS_KERN_OK
end

fn ksys_attn_validate q_len ulong o_len ulong s_len ulong n_heads ulong pos ulong meta view ulong 4 to uint
  n_kv = get meta 1
  hdim = get meta 2
  if eq n_heads ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  if ne rem n_heads n_kv ulong 0
    ret KSYS_KERN_ERR_PARAM
  end
  w = mul n_heads hdim
  tokens = add pos ulong 1
  if ne q_len w
    ret KSYS_KERN_ERR_SHAPE
  end
  if ne o_len w
    ret KSYS_KERN_ERR_SHAPE
  end
  if ge pos get meta 3
    ret KSYS_KERN_ERR_SHAPE
  end
  if lt s_len tokens
    ret KSYS_KERN_ERR_SHAPE
  end
  ret KSYS_KERN_OK
end

fn ksys_attn_set_head head ulong kv_head ulong hdim ulong n_kv ulong tokens ulong to void
  put ksys_attn_dims 0 head
  put ksys_attn_dims 1 kv_head
  put ksys_attn_dims 2 hdim
  put ksys_attn_dims 3 n_kv
  put ksys_attn_dims 4 tokens
  ret
end

fn ksys_attn_dot q view f32 * keys view f32 * q_off ulong k_off ulong to f32
  dot = 0.0f32
  d = ulong 0
  while lt d get ksys_attn_dims 2 bound 256
    qv = get q add q_off d
    kv = get keys add k_off d
    dot = add dot mul qv kv
    d = add d 1
  end
  ret dot
end

fn ksys_attn_kv_off t ulong to ulong
  r = mul t get ksys_attn_dims 3
  r = add r get ksys_attn_dims 1
  ret mul r get ksys_attn_dims 2
end

fn ksys_attn_score_head q view f32 * keys view f32 * scores edit f32 * to uint
  scale = div 1.0f32 ksys_sqrt_approx f32 get ksys_attn_dims 2
  q_off = mul get ksys_attn_dims 0 get ksys_attn_dims 2
  t = ulong 0
  while lt t get ksys_attn_dims 4 bound 256
    k_off = ksys_attn_kv_off t
    put scores t mul ksys_attn_dot q keys q_off k_off scale
    t = add t 1
  end
  ret ksys_softmax part scores 0 get ksys_attn_dims 4
end

fn ksys_attn_add_weighted vals view f32 * dst edit f32 * v_off ulong wt f32 to void
  o_off = mul get ksys_attn_dims 0 get ksys_attn_dims 2
  d = ulong 0
  while lt d get ksys_attn_dims 2 bound 256
    cur = get dst add o_off d
    vv = get vals add v_off d
    put dst add o_off d add cur mul wt vv
    d = add d 1
  end
  ret
end

fn ksys_attn_accum_head scores view f32 * vals view f32 * dst edit f32 * to void
  o_off = mul get ksys_attn_dims 0 get ksys_attn_dims 2
  d = ulong 0
  while lt d get ksys_attn_dims 2 bound 256
    put dst add o_off d 0.0f32
    d = add d 1
  end
  t = ulong 0
  while lt t get ksys_attn_dims 4 bound 256
    v_off = ksys_attn_kv_off t
    ksys_attn_add_weighted vals dst v_off get scores t
    t = add t 1
  end
  ret
end

note =========================================================================
note Section 15: Kernel Infer — Byte-Level BPE Tokenizer
note =========================================================================

fn ksys_tok_reset to void
  put ksys_tok_meta 0 uint 0
  put ksys_tok_meta 1 uint 0
  put ksys_tok_meta 2 uint 0
  put ksys_tok_meta 3 uint 0
  ret
end

fn ksys_hex_val b uchar to int
  if ge b uchar 48
    if le b uchar 57
      ret int sub b uchar 48
    end
  end
  if ge b uchar 97
    if le b uchar 102
      ret add int sub b uchar 97 int 10
    end
  end
  if ge b uchar 65
    if le b uchar 70
      ret add int sub b uchar 65 int 10
    end
  end
  ret int -1
end

fn ksys_parse_u32_dec s view uchar * dst edit uint 1 to bool
  n = len s
  if eq n ulong 0
    ret false
  end
  acc = ulong 0
  i = ulong 0
  while lt i n bound 16
    b = get s i
    if lt b uchar 48
      ret false
    end
    if gt b uchar 57
      ret false
    end
    acc = add mul acc ulong 10 ulong sub b uchar 48
    if gt acc ulong 0xffffffff
      ret false
    end
    i = add i 1
  end
  put dst 0 uint acc
  ret true
end

fn ksys_tok_find_id id uint to int
  nt = get ksys_tok_meta 0
  i = uint 0
  while lt i nt bound 320
    if eq get ksys_tok_id ulong i id
      ret int i
    end
    i = add i 1
  end
  ret int -1
end

fn ksys_tok_find_reg_bytes src view uchar * to int
  nt = get ksys_tok_meta 0
  slen = len src
  i = uint 0
  while lt i nt bound 320
    if eq get ksys_tok_spec ulong i uchar 0
      bl = ulong get ksys_tok_blen ulong i
      if eq bl slen
        off = ulong get ksys_tok_off ulong i
        j = ulong 0
        ok = true
        while lt j slen bound 64
          if ne get ksys_tok_pool add off j get src j
            ok = false
            break
          end
          j = add j 1
        end
        if ok
          ret int i
        end
      end
    end
    i = add i 1
  end
  ret int -1
end

fn ksys_tok_add_record is_spec bool id uint hex view uchar * to uint
  hlen = len hex
  if ne and hlen ulong 1 ulong 0
    ret KSYS_TOK_ERR_HEX
  end
  blen = div hlen ulong 2
  if is_spec
    if eq blen ulong 0
      ret KSYS_TOK_ERR_REC
    end
  end
  if ge ksys_tok_find_id id int 0
    ret KSYS_TOK_ERR_DUP_ID
  end
  dec = new uchar 64 uchar 0
  if gt blen ulong 64
    ret KSYS_TOK_ERR_REC
  end
  i = ulong 0
  while lt i blen bound 64
    hi = ksys_hex_val get hex mul i ulong 2
    lo = ksys_hex_val get hex add mul i ulong 2 ulong 1
    if lt hi int 0
      ret KSYS_TOK_ERR_HEX
    end
    if lt lo int 0
      ret KSYS_TOK_ERR_HEX
    end
    put dec i uchar or shl uint hi uint 4 uint lo
    i = add i 1
  end
  if not is_spec
    if ge ksys_tok_find_reg_bytes part dec 0 blen int 0
      ret KSYS_TOK_ERR_REC
    end
  end
  nt = ulong get ksys_tok_meta 0
  pu = ulong get ksys_tok_meta 1
  if ge nt ulong 320
    ret KSYS_TOK_ERR_REC
  end
  if gt add pu blen ulong 4096
    ret KSYS_TOK_ERR_REC
  end
  i = ulong 0
  while lt i blen bound 64
    put ksys_tok_pool add pu i get dec i
    i = add i 1
  end
  put ksys_tok_id nt id
  put ksys_tok_off nt uint pu
  put ksys_tok_blen nt uint blen
  if is_spec
    put ksys_tok_spec nt uchar 1
    ns = ulong get ksys_tok_meta 3
    if ge ns ulong 32
      ret KSYS_TOK_ERR_REC
    end
    put ksys_spec_idx ns uint nt
    put ksys_tok_meta 3 uint add ns ulong 1
  else
    put ksys_tok_spec nt uchar 0
  end
  put ksys_tok_meta 0 uint add nt ulong 1
  put ksys_tok_meta 1 uint add pu blen
  ret KSYS_TOK_OK
end

fn ksys_tok_add_merge left uint right uint to uint
  nm = ulong get ksys_tok_meta 2
  i = ulong 0
  while lt i nm bound 64
    if eq get ksys_merge_l i left
      if eq get ksys_merge_r i right
        ret KSYS_TOK_ERR_DUP_MERGE
      end
    end
    i = add i 1
  end
  if ge nm ulong 64
    ret KSYS_TOK_ERR_REC
  end
  put ksys_merge_l nm left
  put ksys_merge_r nm right
  put ksys_merge_res nm uint 0
  put ksys_tok_meta 2 uint add nm ulong 1
  ret KSYS_TOK_OK
end

fn ksys_tok_parse_line line view uchar * to uint
  n = len line
  end_i = ulong 0
  while lt end_i n bound 256
    if eq get line end_i uchar 35
      break
    end
    end_i = add end_i 1
  end
  i = ulong 0
  while lt i end_i bound 256
    if not ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  if ge i end_i
    ret KSYS_TOK_OK
  end
  f0_off = i
  while lt i end_i bound 256
    if ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  f0_len = sub i f0_off
  if ne f0_len ulong 1
    ret KSYS_TOK_ERR_REC
  end
  kind_b = get line f0_off
  while lt i end_i bound 256
    if not ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  f1_off = i
  while lt i end_i bound 256
    if ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  f1_len = sub i f1_off
  while lt i end_i bound 256
    if not ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  f2_off = i
  while lt i end_i bound 256
    if ksys_is_ws get line i
      break
    end
    i = add i 1
  end
  f2_len = sub i f2_off
  while lt i end_i bound 256
    if not ksys_is_ws get line i
      ret KSYS_TOK_ERR_REC
    end
    i = add i 1
  end
  if eq f1_len ulong 0
    ret KSYS_TOK_ERR_REC
  end
  if eq f2_len ulong 0
    ret KSYS_TOK_ERR_REC
  end
  v1 = new uint 1 uint 0
  v2 = new uint 1 uint 0
  if eq kind_b uchar 84
    if not ksys_parse_u32_dec part line f1_off f1_len v1
      ret KSYS_TOK_ERR_ID
    end
    ret ksys_tok_add_record false get v1 0 part line f2_off f2_len
  end
  if eq kind_b uchar 83
    if not ksys_parse_u32_dec part line f1_off f1_len v1
      ret KSYS_TOK_ERR_ID
    end
    ret ksys_tok_add_record true get v1 0 part line f2_off f2_len
  end
  if eq kind_b uchar 77
    if not ksys_parse_u32_dec part line f1_off f1_len v1
      ret KSYS_TOK_ERR_ID
    end
    if not ksys_parse_u32_dec part line f2_off f2_len v2
      ret KSYS_TOK_ERR_ID
    end
    ret ksys_tok_add_merge get v1 0 get v2 0
  end
  ret KSYS_TOK_ERR_REC
end

fn ksys_tok_sort_specials to void
  ns = ulong get ksys_tok_meta 3
  i = ulong 0
  while lt i ns bound 32
    j = add i ulong 1
    while lt j ns bound 32
      ti = ulong get ksys_spec_idx i
      tj = ulong get ksys_spec_idx j
      if gt get ksys_tok_blen tj get ksys_tok_blen ti
        put ksys_spec_idx i uint tj
        put ksys_spec_idx j uint ti
      end
      j = add j 1
    end
    i = add i 1
  end
  ret
end

fn ksys_tok_copy_pool dst edit uchar * dst_off ulong tok_idx ulong to ulong
  bl = ulong get ksys_tok_blen tok_idx
  po = ulong get ksys_tok_off tok_idx
  j = ulong 0
  while lt j bl bound 64
    put dst add dst_off j get ksys_tok_pool add po j
    j = add j 1
  end
  ret add dst_off bl
end

fn ksys_tok_check_merge idx ulong to uint
  tmp = new uchar 64 uchar 0
  li = ksys_tok_find_id get ksys_merge_l idx
  if lt li int 0
    ret KSYS_TOK_ERR_MISS_TOK
  end
  ri = ksys_tok_find_id get ksys_merge_r idx
  if lt ri int 0
    ret KSYS_TOK_ERR_MISS_TOK
  end
  ll = ulong get ksys_tok_blen ulong li
  rl = ulong get ksys_tok_blen ulong ri
  if gt add ll rl ulong 64
    ret KSYS_TOK_ERR_REC
  end
  p = ksys_tok_copy_pool tmp ulong 0 ulong li
  p = ksys_tok_copy_pool tmp p ulong ri
  mi = ksys_tok_find_reg_bytes part tmp 0 p
  if lt mi int 0
    ret KSYS_TOK_ERR_REC
  end
  put ksys_merge_res idx get ksys_tok_id ulong mi
  ret KSYS_TOK_OK
end

fn ksys_tok_finalize to uint
  nm = ulong get ksys_tok_meta 2
  i = ulong 0
  while lt i nm bound 64
    e = ksys_tok_check_merge i
    if ne e KSYS_TOK_OK
      ret e
    end
    i = add i 1
  end
  ksys_tok_sort_specials
  ret KSYS_TOK_OK
end

fn ksys_tok_from_text input view uchar * to uint
  ksys_tok_reset
  n = len input
  pos = ulong 0
  while lt pos n bound 1024
    start = pos
    while lt pos n bound 256
      if eq get input pos uchar 10
        break
      end
      pos = add pos 1
    end
    e = ksys_tok_parse_line part input start sub pos start
    if ne e KSYS_TOK_OK
      ret e
    end
    if lt pos n
      pos = add pos 1
    end
  end
  ret ksys_tok_finalize
end

fn ksys_tok_find_best pieces view uint * plen ulong best edit ulong 2 to bool
  nm = ulong get ksys_tok_meta 2
  if lt plen ulong 2
    ret false
  end
  lim = sub plen ulong 1
  r = ulong 0
  while lt r nm bound 64
    ml = get ksys_merge_l r
    mr = get ksys_merge_r r
    k = ulong 0
    while lt k lim bound 128
      if eq get pieces k ml
        if eq get pieces add k ulong 1 mr
          put best 0 k
          put best 1 ulong get ksys_merge_res r
          ret true
        end
      end
      k = add k 1
    end
    r = add r 1
  end
  ret false
end

fn ksys_tok_apply_merges pieces edit uint * init_len ulong to ulong
  best = new ulong 2 ulong 0
  plen = init_len
  step = ulong 0
  while lt step ulong 128 bound 128
    if not ksys_tok_find_best pieces plen best
      ret plen
    end
    ba = get best 0
    put pieces ba uint get best 1
    k = add ba ulong 1
    lim = sub plen ulong 1
    while lt k lim bound 128
      put pieces k get pieces add k ulong 1
      k = add k 1
    end
    plen = lim
    step = add step 1
  end
  ret plen
end

fn ksys_tok_encode_run run view uchar * dst edit uint * cnt edit uint 1 to uint
  rlen = len run
  if eq rlen ulong 0
    ret KSYS_TOK_OK
  end
  pieces = new uint 128 uint 0
  if gt rlen ulong 128
    ret KSYS_TOK_ERR_REC
  end
  one = new uchar 1 uchar 0
  i = ulong 0
  while lt i rlen bound 128
    put one 0 get run i
    ti = ksys_tok_find_reg_bytes one
    if lt ti int 0
      ret KSYS_TOK_ERR_MISS_BYTE
    end
    put pieces i get ksys_tok_id ulong ti
    i = add i 1
  end
  plen = ksys_tok_apply_merges pieces rlen
  c = ulong get cnt 0
  if gt add c plen len dst
    ret KSYS_TOK_ERR_REC
  end
  i = ulong 0
  while lt i plen bound 128
    put dst add c i get pieces i
    i = add i 1
  end
  put cnt 0 uint add c plen
  ret KSYS_TOK_OK
end

fn ksys_tok_pool_eq input view uchar * off ulong ti ulong to bool
  bl = ulong get ksys_tok_blen ti
  if gt add off bl len input
    ret false
  end
  po = ulong get ksys_tok_off ti
  j = ulong 0
  while lt j bl bound 64
    if ne get input add off j get ksys_tok_pool add po j
      ret false
    end
    j = add j 1
  end
  ret true
end

fn ksys_tok_match_special input view uchar * off ulong to int
  ns = ulong get ksys_tok_meta 3
  s = ulong 0
  while lt s ns bound 32
    ti = ulong get ksys_spec_idx s
    if ksys_tok_pool_eq input off ti
      ret int ti
    end
    s = add s 1
  end
  ret int -1
end

fn ksys_tok_encode input view uchar * dst edit uint * cnt edit uint 1 to uint
  put cnt 0 uint 0
  ord = new uchar 128 uchar 0
  olen = ulong 0
  n = len input
  off = ulong 0
  while lt off n bound 256
    si = ksys_tok_match_special input off
    if ge si int 0
      e = ksys_tok_encode_run part ord 0 olen dst cnt
      if ne e KSYS_TOK_OK
        ret e
      end
      olen = ulong 0
      c = ulong get cnt 0
      if ge c len dst
        ret KSYS_TOK_ERR_REC
      end
      put dst c get ksys_tok_id ulong si
      put cnt 0 uint add c ulong 1
      off = add off ulong get ksys_tok_blen ulong si
    else
      if ge olen ulong 128
        ret KSYS_TOK_ERR_REC
      end
      put ord olen get input off
      olen = add olen ulong 1
      off = add off ulong 1
    end
  end
  ret ksys_tok_encode_run part ord 0 olen dst cnt
end

fn ksys_tok_decode ids view uint * dst edit uchar * out_len edit ulong 1 to uint
  pos = ulong 0
  i = ulong 0
  while lt i len ids bound 256
    ti = ksys_tok_find_id get ids i
    if lt ti int 0
      ret KSYS_TOK_ERR_MISS_TOK
    end
    bl = ulong get ksys_tok_blen ulong ti
    if gt add pos bl len dst
      ret KSYS_TOK_ERR_REC
    end
    pos = ksys_tok_copy_pool dst pos ulong ti
    i = add i 1
  end
  put out_len 0 pos
  ret KSYS_TOK_OK
end

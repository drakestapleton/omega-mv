note aienux/crates/aienos-kernel/mm_iommu_test.om
note Comprehensive behavioral tests for mm_iommu.om covering all 9 subsystems
note and all Rust unit tests with distinct non-zero exit codes on every failure.

note ========================================================================
note 1. Frame Allocator Tests (exit codes 1..15)
note ========================================================================

fn kmi_test_frame_allocator to int
st = new ulong 16 0
out_a = new ulong 1 0
batch = new ulong 160 0

note test_allocator_basic
if ne kmi_fa_init st 0x10000000 256 4 0
ret 1
end
if ne kmi_fa_total_frames st 256
ret 2
end
if ne kmi_fa_free_count st 256
ret 3
end
if not kmi_fa_alloc st out_a
ret 4
end
if ne get out_a 0 0x10000000
ret 4
end
if ne kmi_fa_allocated_count st 1
ret 4
end
if not kmi_fa_alloc st out_a
ret 5
end
if ne get out_a 0 0x10001000
ret 5
end
if not kmi_fa_free st 0x10000000
ret 6
end
if kmi_fa_free st 0x10000000
ret 6
end
if ne kmi_fa_allocated_count st 1
ret 6
end
if not kmi_fa_alloc st out_a
ret 7
end
if ne get out_a 0 0x10000000
ret 7
end

note test_alloc_contiguous
if ne kmi_fa_init st 0x20000000 128 2 0
ret 8
end
if not kmi_fa_alloc_contig st 4 out_a
ret 8
end
if ne get out_a 0 0x20000000
ret 8
end
if ne kmi_fa_allocated_count st 4
ret 8
end

note allocator_rejects_unaligned_deallocation
if ne kmi_fa_init st 0x20000000 64 1 0
ret 9
end
if not kmi_fa_alloc st out_a
ret 9
end
if kmi_fa_free st add get out_a 0 1
ret 10
end
if ne kmi_fa_allocated_count st 1
ret 10
end
if not kmi_fa_free st get out_a 0
ret 10
end

note batch_reservation_is_bounded_and_released_as_a_unit
if ne kmi_fa_init st 0x30000000 8 1 0
ret 11
end
if ne kmi_fa_alloc_batch st 6 batch 6
ret 11
end
if ne kmi_fa_free_count st 2
ret 11
end
if not kmi_fa_release_batch st batch 6
ret 12
end
if ne kmi_fa_free_count st 8
ret 12
end
if ne kmi_fa_alloc_batch st 161 batch 0
ret 12
end

note insufficient_batch_reservation_leaves_no_partial_allocations
if ne kmi_fa_init st 0x40000000 8 1 0
ret 13
end
if not kmi_fa_alloc st out_a
ret 13
end
if ne kmi_fa_alloc_batch st 8 batch 0
ret 13
end
if ne kmi_fa_allocated_count st 1
ret 14
end
if ne kmi_fa_free_count st 7
ret 14
end

note allocator_rejects_capacity_overflow and unaligned base
if eq kmi_fa_init st 0x20000000 65 1 0
ret 15
end
if eq kmi_fa_init st 0x20000001 8 1 0
ret 15
end
ret 0
end

note ========================================================================
note 2. Map Plan Tests (exit codes 16..35)
note ========================================================================

fn kmi_test_map_plan_regs to int
m = kmi_mair_el1
if ne and m 0xff 0xff
ret 16
end
if ne and shr m 8 0xff 0x04
ret 16
end
if ne m 0x04ff
ret 16
end
tcr = kmi_tcr_el1 uchar 5
if ne and tcr 0x3f 16
ret 17
end
if ne and shr tcr 8 3 1
ret 17
end
if ne and shr tcr 10 3 1
ret 17
end
if ne and shr tcr 12 3 3
ret 17
end
if ne and shr tcr 14 3 0
ret 18
end
if ne and shr tcr 16 0x3f 16
ret 18
end
if eq and tcr shl ulong 1 23 0
ret 18
end
if ne and shr tcr 30 3 2
ret 19
end
if ne and shr tcr 32 7 5
ret 19
end
s = kmi_sctlr_el1
if ne and s 0x30d00800 0x30d00800
ret 20
end
mci = or ulong 1 or shl ulong 1 2 shl ulong 1 12
if ne and s mci mci
ret 20
end
bad_b = or shl ulong 1 1 or shl ulong 1 19 shl ulong 1 25
if ne and s bad_b 0
ret 21
end
ret 0
end

fn kmi_test_map_plan_rt_mmio to int
meta = new ulong 4 0
plan = new ulong 48 0
rt_reg = new ulong 3 0
rt_attrs = new ulong 8 0
mmio = new ulong 4 0

note missing_mat_maps_runtime_code_rx_without_wx
kmi_plan_init meta 16
put rt_reg 0 0x400000
put rt_reg 1 4096
put rt_reg 2 0
if ne kmi_plan_add_runtime meta plan rt_reg rt_attrs KMI_PLAN_OK
ret 28
end
if ne get meta 0 1
ret 28
end
if ne get meta 1 KMI_RT_DECISION_RX_UNSPLIT
ret 28
end
if eq and get plan 2 KMI_FLAG_EXECUTABLE 0
ret 29
end
if ne and get plan 2 KMI_FLAG_WRITABLE 0
ret 29
end

note runtime_code_needs_ro_xp_split
kmi_plan_init meta 16
put rt_reg 0 0x400000
put rt_reg 1 8192
put rt_reg 2 1
put rt_attrs 0 0x400000
put rt_attrs 1 4096
put rt_attrs 2 1
put rt_attrs 3 0
put rt_attrs 4 0x401000
put rt_attrs 5 4096
put rt_attrs 6 0
put rt_attrs 7 1
if ne kmi_plan_add_runtime meta plan rt_reg rt_attrs KMI_PLAN_OK
ret 30
end
if ne get meta 0 2
ret 30
end
if eq and get plan 2 KMI_FLAG_EXECUTABLE 0
ret 31
end
if ne and get plan 2 KMI_FLAG_WRITABLE 0
ret 31
end
if eq and get plan 5 KMI_FLAG_WRITABLE 0
ret 31
end
if ne and get plan 5 KMI_FLAG_EXECUTABLE 0
ret 31
end

note writable_executable_runtime_code_is_mapped_rx
kmi_plan_init meta 16
put rt_reg 0 0x400000
put rt_reg 1 4096
put rt_reg 2 1
put rt_attrs 0 0x400000
put rt_attrs 1 4096
put rt_attrs 2 0
put rt_attrs 3 0
if ne kmi_plan_add_runtime meta plan rt_reg rt_attrs KMI_PLAN_OK
ret 32
end
if ne get meta 1 KMI_RT_DECISION_RX_UNSPLIT
ret 32
end
if eq and get plan 2 KMI_FLAG_EXECUTABLE 0
ret 33
end
if ne and get plan 2 KMI_FLAG_WRITABLE 0
ret 33
end

note mmio_is_device_nx_and_overlap_rejected
kmi_plan_init meta 16
put mmio 0 0x90000000
put mmio 1 4096
if ne kmi_plan_add_mmio meta plan 0 part mmio 0 2 KMI_PLAN_OK
ret 34
end
if eq and get plan 2 KMI_FLAG_DEVICE 0
ret 34
end
if ne and get plan 2 KMI_FLAG_EXECUTABLE 0
ret 34
end
kmi_plan_init meta 16
put mmio 0 4096
put mmio 1 8192
put mmio 2 8192
put mmio 3 4096
if ne kmi_plan_add_mmio meta plan 0 mmio KMI_PLAN_OK
ret 35
end
if ne kmi_plan_validate_overlaps meta plan KMI_PLAN_ERR_OVERLAP
ret 35
end
ret 0
end

fn kmi_test_map_plan to int
rc_r = kmi_test_map_plan_regs
if ne rc_r 0
ret rc_r
end
meta = new ulong 4 0
plan = new ulong 48 0
img_reg = new ulong 4 0
secs = new ulong 6 0
rx_ch = or ulong 0x40000000 KMI_SCN_MEM_EXECUTE
rw_ch = or ulong 0x40000000 KMI_SCN_MEM_WRITE

note section_permissions_are_wx_safe
kmi_plan_init meta 16
put img_reg 0 0x100000
put img_reg 1 16384
put img_reg 2 0x100000
put img_reg 3 16384
put secs 0 0x100000
put secs 1 4096
put secs 2 rx_ch
put secs 3 0x101000
put secs 4 4096
put secs 5 rw_ch
if ne kmi_plan_add_loader meta plan img_reg secs KMI_PLAN_OK
ret 22
end
if ne kmi_plan_validate_overlaps meta plan KMI_PLAN_OK
ret 22
end
if ne get meta 1 KMI_RT_DECISION_NONE
ret 23
end
if ne get meta 0 2
ret 23
end
if eq and get plan 2 KMI_FLAG_EXECUTABLE 0
ret 24
end
if ne and get plan 2 KMI_FLAG_WRITABLE 0
ret 24
end
if eq and get plan 5 KMI_FLAG_WRITABLE 0
ret 25
end
if ne and get plan 5 KMI_FLAG_EXECUTABLE 0
ret 25
end

note W+X section rejected as Overlap
kmi_plan_init meta 16
put secs 2 or KMI_SCN_MEM_EXECUTE KMI_SCN_MEM_WRITE
if ne kmi_plan_add_loader meta plan img_reg secs KMI_PLAN_ERR_OVERLAP
ret 26
end

note section outside allocation rejected
kmi_plan_init meta 16
put secs 0 0x500000
put secs 2 rx_ch
if ne kmi_plan_add_loader meta plan img_reg secs KMI_PLAN_ERR_SEC_OUTSIDE
ret 27
end
ret kmi_test_map_plan_rt_mmio
end

note ========================================================================
note 3. SMMUv3 Tests (exit codes 36..80)
note ========================================================================

fn kmi_test_smmu_desc_and_geom to int
ste = new ulong 8 0
cd = new ulong 8 0
cur = new uint 2 0
geom = new ulong 7 0

note descriptor_layouts
kmi_ste_abort ste
if ne get ste 0 1
ret 36
end
kmi_ste_stage1 0x123456780 ste
if ne and get ste 0 1 1
ret 37
end
if ne and shr get ste 0 1 7 5
ret 37
end
if ne and shr get ste 0 4 3 0
ret 37
end
if ne and get ste 0 0x000fffffffffffc0 0x123456780
ret 38
end
for i ulong 7
if ne get ste add i 1 0
ret 38
end
end
if ne kmi_cd_stage1 0x4000 ushort 0x1234 0xff00 uchar 16 cd KMI_SMMU_OK
ret 39
end
exp0 = ulong 16
exp0 = or exp0 shl ulong 1 8
exp0 = or exp0 shl ulong 1 10
exp0 = or exp0 shl ulong 3 12
exp0 = or exp0 shl ulong 1 30
exp0 = or exp0 shl ulong 1 31
exp0 = or exp0 shl ulong 5 32
exp0 = or exp0 shl ulong 1 41
exp0 = or exp0 shl ulong 1 45
exp0 = or exp0 shl ulong 1 46
exp0 = or exp0 shl ulong 0x1234 48
if ne get cd 0 exp0
ret 40
end
if ne get cd 1 0x4000
ret 40
end
if ne get cd 2 0
ret 40
end
if ne get cd 3 0xff00
ret 40
end
if ne kmi_cd_stage1 0x4001 ushort 1 0xff uchar 16 cd KMI_SMMU_ERR_INVALID_WINDOW
ret 41
end
if ne kmi_cd_stage1 0x4000 ushort 1 0xff uchar 40 cd KMI_SMMU_ERR_INVALID_WINDOW
ret 41
end

note command_words_and_queue_wrap
if ne kmi_smmu_cmd_w0 KMI_CMD_CFGI_STE uint 7 or ulong 3 shl ulong 7 32
ret 42
end
if ne kmi_smmu_cmd_w1 KMI_CMD_CFGI_STE true 1
ret 42
end
if ne kmi_smmu_cmd_w0 KMI_CMD_CFGI_ALL uint 0 4
ret 43
end
if ne kmi_smmu_cmd_w1 KMI_CMD_CFGI_ALL false 31
ret 43
end
if ne kmi_smmu_cmd_w0 KMI_CMD_TLBI_NSNH_ALL uint 0 0x30
ret 43
end
if ne kmi_smmu_cmd_w0 KMI_CMD_SYNC uint 0 0x46
ret 43
end
put cur 0 uint 1
put cur 1 uint 0
kmi_qcursor_advance cur uint 2
if ne get cur 0 0
ret 44
end
if ne get cur 1 1
ret 44
end
if ne kmi_qcursor_encode get cur 0 true uint 2 2
ret 44
end
if ne kmi_qcursor_encode uint 5 true uint 16 0x15
ret 45
end
if ne kmi_qcursor_decode_idx uint 0x15 uint 16 5
ret 45
end
if not kmi_qcursor_decode_wrap uint 0x15 uint 16
ret 45
end
if kmi_qcursor_decode_wrap uint 0x80000005 uint 16
ret 45
end

note tables_reject_misaligned_or_bad_geometry
put geom 0 0x100000
put geom 1 16
put geom 2 0x101000
put geom 3 16
put geom 4 0x102000
put geom 5 16
put geom 6 0x103000
if not kmi_smmu_tables_valid geom
ret 46
end
put geom 1 12
if kmi_smmu_tables_valid geom
ret 47
end
put geom 1 16
put geom 3 1
if kmi_smmu_tables_valid geom
ret 47
end
put geom 3 16
put geom 4 0x102100
if kmi_smmu_tables_valid geom
ret 48
end
put geom 4 0x102000
put geom 6 0x103008
if kmi_smmu_tables_valid geom
ret 48
end
ret 0
end

fn kmi_test_smmu_bringup to int
sm = new ulong 512 0
cd = new ulong 8 0
ste_exp = new ulong 8 0
if ne kmi_cd_stage1 0x4000 ushort 1 0x00ff uchar 16 cd KMI_SMMU_OK
ret 49
end

note bring_up_keeps_global_abort_through_smmuen
kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_OK
ret 50
end
if ne get sm KMI_SM_FIRST_WR_REG ulong KMI_SMMU_GBPA
ret 50
end
if ne get sm KMI_SM_ALL_ABORT 1
ret 51
end
if ne get sm KMI_SM_LAST_REG ulong KMI_SMMU_CR0
ret 51
end
if ne get sm KMI_SM_LAST_VAL 0x0d
ret 51
end
if ne get sm KMI_SM_CR0ACK 0x0d
ret 52
end
if not kmi_smmu_abort_in_effect sm
ret 52
end
kmi_ste_stage1 get sm KMI_SM_CD_ADDR ste_exp
for s ulong 16
sb = add KMI_SM_STE_BASE mul s 8
if eq s 3
if ne get sm sb get ste_exp 0
ret 53
end
else
if ne get sm sb 1
ret 53
end
end
end
if ne get sm KMI_SM_CONS_CNT 3
ret 54
end
if ne get sm KMI_SM_STRTAB_CFG 4
ret 54
end

note bring_up_cleans_tables_after_writing_before_programming
gbpa_seq = get sm KMI_SM_FIRST_GBPA
cr0_seq = get sm KMI_SM_FIRST_CR0
str_seq = get sm KMI_SM_FIRST_STRTAB
cs = get sm KMI_SM_CLEAN_STREAM
cc = get sm KMI_SM_CLEAN_CD
cm = get sm KMI_SM_CLEAN_CMD
ie = get sm KMI_SM_INV_EV
if le cs gbpa_seq
ret 55
end
if ge cs cr0_seq
ret 55
end
if ge cs str_seq
ret 55
end
if ge cc cr0_seq
ret 55
end
if ge cm cr0_seq
ret 55
end
if ge ie cr0_seq
ret 55
end
ret 0
end

fn kmi_test_smmu_failures to int
sm = new ulong 512 0
cd = new ulong 8 0
if ne kmi_cd_stage1 0x4000 ushort 1 0x00ff uchar 16 cd KMI_SMMU_OK
ret 56
end

note gbpa_update_timeout_fails_closed
kmi_smmu_init sm
put sm KMI_SM_GBPA_STUCK ulong 1
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_TIMEOUT
ret 56
end
if eq and get sm KMI_SM_GBPA ulong KMI_GBPA_ABORT 0
ret 57
end
if ne get sm KMI_SM_WR_CNT 1
ret 57
end

note smmuen_ack_failure_fails_closed
kmi_smmu_init sm
put sm KMI_SM_ACK_NEVER ulong KMI_CR0_SMMUEN
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_TIMEOUT
ret 58
end
if not kmi_smmu_abort_in_effect sm
ret 58
end
if ne get sm KMI_SM_LAST_REG ulong KMI_SMMU_CR0
ret 59
end
if ne get sm KMI_SM_LAST_VAL 0
ret 59
end
if ne get sm KMI_SM_ALL_ABORT 1
ret 59
end

note command_timeout_and_error_fail_closed
kmi_smmu_init sm
put sm KMI_SM_CMDQ_STUCK ulong 1
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_TIMEOUT
ret 60
end
if ne get sm KMI_SM_SMMUEN_SEEN 0
ret 60
end
if ne get sm KMI_SM_CR0 0
ret 60
end

kmi_smmu_init sm
put sm KMI_SM_CMDQ_ERROR ulong 1
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_CMDQ
ret 61
end
if ne get sm KMI_SM_SMMUEN_SEEN 0
ret 61
end
if ne get sm KMI_SM_CR0 0
ret 61
end

note unsupported_hardware_or_bad_sid_fails_closed
kmi_smmu_init sm
kmi_smmu_reg_write sm KMI_SMMU_CR0 or KMI_CR0_SMMUEN KMI_CR0_CMDQEN
kmi_smmu_reset_log sm
put sm KMI_SM_IDR1 ulong 2
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_UNSUPPORTED
ret 62
end
if ne get sm KMI_SM_CR0ACK 0
ret 62
end
if ne get sm KMI_SM_STE_BASE 0xdead
ret 62
end

kmi_smmu_init sm
put sm KMI_SM_IDR0 ulong 0
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_UNSUPPORTED
ret 63
end

kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 16 cd 4 KMI_SMMU_ERR_INVALID_WINDOW
ret 64
end

note gbpa_that_will_not_abort_is_an_error
kmi_smmu_init sm
put sm KMI_SM_GBPA_NO_ABORT ulong 1
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_ERR_ABORT_NOT_LATCHED
ret 65
end
if ne get sm KMI_SM_WR_CNT 1
ret 65
end
ret 0
end

fn kmi_test_smmu_ops_and_events to int
sm = new ulong 512 0
cd = new ulong 8 0
ste = new ulong 8 0
sync_cmds = new ulong 34 0
ev_out = new ulong 6 0
drain = new ulong 2 0
wins = new ulong 3 0
if ne kmi_cd_stage1 0x4000 ushort 1 0x00ff uchar 16 cd KMI_SMMU_OK
ret 66
end
kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_OK
ret 66
end

note install_and_abort_ste_invalidate_that_stream
kmi_smmu_reset_log sm
kmi_ste_stage1 get sm KMI_SM_CD_ADDR ste
if ne kmi_smmu_install_ste sm uint 7 ste 4 KMI_SMMU_OK
ret 67
end
if ne get sm add KMI_SM_STE_BASE 56 get ste 0
ret 67
end
if ne get sm KMI_SM_CONS_CNT 6
ret 68
end
if ne kmi_smmu_abort_ste sm uint 7 4 KMI_SMMU_OK
ret 69
end
if ne get sm add KMI_SM_STE_BASE 56 1
ret 69
end
if ne kmi_smmu_install_ste sm uint 16 ste 4 KMI_SMMU_ERR_INVALID_WINDOW
ret 70
end
if ne kmi_smmu_abort_ste sm uint 16 4 KMI_SMMU_ERR_INVALID_WINDOW
ret 70
end

note command_queue_wraps_and_times_out
kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_OK
ret 71
end
for i ulong 11
if ne kmi_smmu_abort_ste sm uint 5 4 KMI_SMMU_OK
ret 71
end
end
if ne get sm KMI_SM_CONS_CNT 36
ret 72
end
if ne get sm KMI_SM_CMDQ_PROD 4
ret 72
end
for i ulong 4
if ne kmi_smmu_abort_ste sm uint 5 4 KMI_SMMU_OK
ret 73
end
end
if ne get sm KMI_SM_CMDQ_PROD 0x10
ret 73
end
put sm KMI_SM_CMDQ_STUCK ulong 1
if ne kmi_smmu_abort_ste sm uint 5 4 KMI_SMMU_ERR_TIMEOUT
ret 74
end

note submit_refuses_to_overwrite_a_full_queue
kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_OK
ret 75
end
put sm KMI_SM_CMDQ_STUCK ulong 1
for i ulong 17
put sync_cmds mul i 2 kmi_smmu_cmd_w0 KMI_CMD_SYNC uint 0
put sync_cmds add mul i 2 1 kmi_smmu_cmd_w1 KMI_CMD_SYNC false
end
if ne kmi_smmu_submit_cmds sm sync_cmds 17 4 KMI_SMMU_ERR_TIMEOUT
ret 75
end
p_raw = uint and get sm KMI_SM_CMDQ_PROD 0xffffffff
c_raw = uint and get sm KMI_SM_CMDQ_CONS 0xffffffff
if ne kmi_qcursor_decode_idx p_raw uint 16 kmi_qcursor_decode_idx c_raw uint 16
ret 76
end
if eq kmi_qcursor_decode_wrap p_raw uint 16 kmi_qcursor_decode_wrap c_raw uint 16
ret 76
end

note event_reader_decodes_and_consumes_records
kmi_smmu_init sm
if ne kmi_smmu_configure_linear sm uint 3 cd 4 KMI_SMMU_OK
ret 77
end
put sm add KMI_SM_EV_BASE 56 or ulong KMI_EVENT_F_TRANSLATION shl ulong 3 32
put sm add KMI_SM_EV_BASE 58 ulong 0x12345000
put sm add KMI_SM_EV_BASE 60 or ulong KMI_EVENT_C_BAD_STE shl ulong 9 32
put sm add KMI_SM_EV_BASE 0 or ulong KMI_EVENT_F_PERMISSION shl ulong 3 32
put sm add KMI_SM_EV_BASE 2 ulong 0xdeadb000
put sm KMI_SM_EVENTQ_CONS ulong 14
put sm KMI_SM_EVENTQ_PROD ulong 0x11
kmi_smmu_read_events sm ev_out 2 drain
if ne get drain 0 2
ret 77
end
if ne get drain 1 0
ret 77
end
if ne get ev_out 0 ulong KMI_EVENT_F_TRANSLATION
ret 78
end
if ne get ev_out 1 3
ret 78
end
if ne get ev_out 2 0x12345000
ret 78
end
if ne get ev_out 3 ulong KMI_EVENT_C_BAD_STE
ret 78
end
if ne get sm KMI_SM_EVENTQ_CONS 0x10
ret 78
end
kmi_smmu_read_events sm ev_out 2 drain
if ne get drain 0 1
ret 79
end
if ne get ev_out 0 ulong KMI_EVENT_F_PERMISSION
ret 79
end
if ne get ev_out 2 0xdeadb000
ret 79
end
if ne get sm KMI_SM_EVENTQ_CONS 0x11
ret 79
end

note event_reader_acknowledges_overflow
kmi_smmu_init sm
put sm KMI_SM_EVENTQ_PROD ulong KMI_EVENTQ_OVERFLOW
kmi_smmu_read_events sm ev_out 1 drain
if ne get drain 1 1
ret 80
end
if ne get sm KMI_SM_EVENTQ_CONS ulong KMI_EVENTQ_OVERFLOW
ret 80
end
kmi_smmu_read_events sm ev_out 1 drain
if ne get drain 1 0
ret 80
end

note policy_maps_only_allowed_windows
put wins 0 0x1000
put wins 1 0x1000
put wins 2 4096
if ne kmi_smmu_validate_policy_windows wins KMI_SMMU_OK
ret 80
end
put wins 0 0x2000
if ne kmi_smmu_validate_policy_windows wins KMI_SMMU_ERR_INVALID_WINDOW
ret 80
end
ret 0
end

note ========================================================================
note 4. DMA Gate Tests (exit codes 81..100)
note ========================================================================

fn kmi_test_dma_gate to int
cfg = new uint 516 0
sw = new ulong 40 0

note command_bits
if not kmi_bme_enabled ushort 0x0007
ret 81
end
if kmi_bme_enabled ushort 0x0003
ret 81
end
if ne kmi_without_bme ushort 0x0407 ushort 0x0403
ret 82
end
if ne kmi_with_bme ushort 0x0400 ushort 0x0406
ret 82
end

note grant_requires_smmu_or_explicit_bypass_without_smmu
if ne kmi_dma_grant true true false KMI_DMA_GRANT_CONFINED
ret 83
end
if ne kmi_dma_grant true true true KMI_DMA_GRANT_CONFINED
ret 83
end
if ne kmi_dma_grant false false false KMI_DMA_DENIED_NO_SMMU
ret 84
end
if ne kmi_dma_grant false false true KMI_DMA_GRANT_UNSAFE_BYPASS
ret 84
end

note failed_smmu_never_falls_back_to_bypass
if ne kmi_dma_grant false true false KMI_DMA_DENIED_SMMU_NOT_READY
ret 85
end
if ne kmi_dma_grant false true true KMI_DMA_DENIED_SMMU_NOT_READY
ret 85
end

note sweep_clears_endpoints_and_leaves_bridges
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 0 uchar 0 uint 0x00081b36 uchar 0
kmi_pci_cfg_set_reg cfg ulong i0 1 uint 0x00100000
i1 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 1 uchar 0 uint 0x10421af4 uchar 0
kmi_pci_cfg_set_reg cfg ulong i1 1 uint 0x00100007
i2 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 2 uchar 0 uint 0x000d1b36 uchar 0
kmi_pci_cfg_set_reg cfg ulong i2 1 uint 0x00100002
i3 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 3 uchar 0 uint 0x000c1b36 uchar 1
kmi_pci_cfg_set_reg cfg ulong i3 1 uint 0x00100007
i4 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 1 uchar 0 uchar 0 uint 0x1234abcd uchar 0
kmi_pci_cfg_set_reg cfg ulong i4 1 uint 0x00100006
kmi_sweep_bus_master cfg uchar 0 uchar 1 sw
if ne get sw 0 5
ret 86
end
if ne get sw 1 1
ret 86
end
if ne get sw 2 1
ret 87
end
if ne get sw 3 2
ret 87
end
if ne get sw 4 0
ret 88
end

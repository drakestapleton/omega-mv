ign = kmi_cap_insert c0 0x100 KMI_RIGHT_READ h0
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_CAP_RIGHTS
ret 142
end
put req 1 get h0 0
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_CAP_RIGHTS
ret 142
end
if ne get hw 0 0
ret 143

ret 89
end
if ne get sw 9 0x0007
ret 89
end
if ne get sw 10 0x0003
ret 89
end
if ne get sw 12 ulong kmi_bdf_rid uchar 1 uchar 0 uchar 0
ret 90
end
if ne and kmi_pci_cfg_get_reg cfg ulong i1 1 0xffff 0x0003
ret 91
end
if ne and kmi_pci_cfg_get_reg cfg ulong i3 1 0xffff 0x0007
ret 91
end
if ne and kmi_pci_cfg_get_reg cfg ulong i2 1 0xffff 0x0002
ret 91
end
if ne get cfg 2 2
ret 92
end

note sweep_reports_a_bus_master_bit_that_will_not_clear

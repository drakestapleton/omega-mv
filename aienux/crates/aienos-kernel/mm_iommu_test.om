note Main Test Runner
note ========================================================================

fn main to int
rc = kmi_test_frame_allocator
if ne rc 0
ret rc
end
rc = kmi_test_map_plan
if ne rc 0
ret rc
end
rc = kmi_test_smmu_desc_and_geom
if ne rc 0
ret rc
end
rc = kmi_test_smmu_bringup
if ne rc 0
ret rc
end
rc = kmi_test_smmu_failures
if ne rc 0
ret rc
end
rc = kmi_test_smmu_ops_and_events
if ne rc 0
ret rc
end
rc = kmi_test_dma_gate
if ne rc 0
ret rc
end
rc = kmi_test_pci
if ne rc 0
ret rc
end
rc = kmi_test_device_1
if ne rc 0
ret rc
end
rc = kmi_test_device_2
if ne rc 0
ret rc
end
rc = kmi_test_edu
if ne rc 0
ret rc
end
rc = kmi_test_block
if ne rc 0
ret rc
end
rc = kmi_test_nvme_atomicity
if ne rc 0
ret rc
end
ret 0
end

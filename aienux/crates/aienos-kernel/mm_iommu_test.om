note capability_for_other_resource_is_not_a_device
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 1 KMI_RIGHT_ALL h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_NOT_DEVICE
ret 146
end
put req 1 get h0 0
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_NOT_DEVICE
ret 146
end
if ne get hw 0 0
ret 147
end

note activation_refused_without_window_or_when_already_active
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h0
spec = new ulong 8 0
kmi_dtab_init dtab 4
put spec 0 0x100
put spec 1 3
put spec 2 0x10
put spec 3 0x10
put spec 4 KMI_DMA_QUIESCED
ign2 = kmi_dtab_register dtab spec
kmi_hw_init hw KMI_HW_NONE
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_NO_WINDOW
ret 148
end
if ne get hw 0 0
ret 148
end
if ne kmi_dtab_set_window dtab 0x100 0x40000000 uint 4 KMI_DEV_OK
ret 149
end
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_OK
ret 149
end
kmi_hw_clear_effects hw
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_WRONG_STATE
ret 150
end
if ne kmi_dtab_set_window dtab 0x100 0x40000000 uint 4 KMI_DEV_ERR_WRONG_STATE
ret 150
end
if ne get hw 0 0
ret 150
end
ret 0
end

fn kmi_test_device_reg_sweep to int
c0 = new ulong 64 0
c1 = new ulong 64 0
dtab = new ulong 128 0
hw = new ulong 128 0
h0 = new ulong 1 0
h1 = new ulong 1 0
spec = new ulong 8 0

note register_rejects_clashes_and_live_devices and window_validation
kmi_dtab_init dtab 2
put spec 0 0x100
put spec 1 3
put spec 2 0x10
put spec 3 0x10
put spec 4 KMI_DMA_QUIESCED
put spec 5 0
if ne kmi_dtab_register dtab spec KMI_DEV_OK
ret 172
end
put spec 1 9
put spec 2 1
put spec 3 99
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_DUPLICATE
ret 172
end
put spec 0 7
put spec 1 3
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_DUPLICATE
ret 173
end
put spec 1 9
put spec 2 0x10
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_DUPLICATE
ret 173
end
put spec 2 1
put spec 3 0x10
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_DUPLICATE
ret 173
end
put spec 3 99
put spec 5 1
put spec 6 1
put spec 7 1
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_BAD_WINDOW
ret 174
end
put spec 5 0
put spec 4 KMI_DMA_ACTIVE
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_WRONG_STATE
ret 174
end
put spec 4 KMI_DMA_QUIESCED
if ne kmi_dtab_register dtab spec KMI_DEV_OK
ret 175
end
put spec 0 8
put spec 1 10
put spec 2 2
put spec 3 100
if ne kmi_dtab_register dtab spec KMI_DEV_ERR_FULL
ret 175
end
if ne kmi_dtab_set_window dtab 0x100 0x1000 uint 0 KMI_DEV_ERR_BAD_WINDOW
ret 176
end
if ne kmi_dtab_set_window dtab 0x100 0x1001 uint 1 KMI_DEV_ERR_BAD_WINDOW
ret 176
end
if ne kmi_dtab_set_window dtab 0x100 0xfffffffffffff000 uint 2 KMI_DEV_ERR_BAD_WINDOW
ret 176
end
if ne kmi_dtab_set_window dtab 0x999 0x40000000 uint 4 KMI_DEV_ERR_NOT_DEVICE
ret 177
end

note sweep_leaves_live_alone, tears_down_ancestor_revoked, removed_reused, table_gone
kmi_cap_init c0 1 4
kmi_cap_init c1 2 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_ALL h0
ign_i = kmi_cap_derive_into c0 get h0 0 c1 KMI_RIGHT_MAP h1
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
ign_i = kmi_dev_activate c1 get h1 0 dtab hw
kmi_hw_clear_effects hw
if ne kmi_dtab_sweep dtab 2 c0 c1 hw KMI_DEV_OK
ret 178
end
if ne get hw 0 0
ret 178
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_ACTIVE
ret 178
end
ign_i = kmi_cap_revoke2 1 get h0 0 c0 c1 true
if ne kmi_dtab_sweep dtab 2 c0 c1 hw KMI_DEV_OK
ret 179
end
if not kmi_check_teardown_effects hw 0
ret 179
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 179
end

note slot reuse generation check + table gone
kmi_cap_init c0 1 1
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
ign_i = kmi_dev_activate c0 get h0 0 dtab hw
ign = kmi_cap_remove c0 get h0 0
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h1
kmi_hw_clear_effects hw
if ne kmi_dtab_sweep dtab 1 c0 c1 hw KMI_DEV_OK
ret 180
end
if not kmi_check_teardown_effects hw 0
ret 180
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 180
end
ign_i = kmi_dtab_set_window dtab 0x100 0x40000000 uint 4
ign_i = kmi_dev_activate c0 get h1 0 dtab hw
kmi_hw_clear_effects hw
if ne kmi_dtab_sweep dtab 0 c0 c1 hw KMI_DEV_OK
ret 181
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 181
end

note state_discriminants_are_stable
if ne KMI_DMA_QUIESCED 0
ret 182
end
if ne KMI_DMA_TRANSLATION_INSTALLED 1
ret 182
end
if ne KMI_DMA_ACTIVE 2
ret 182
end
if ne KMI_DMA_REVOKING 3
ret 182
end
ret 0
end

fn kmi_test_device_2 to int
c0 = new ulong 64 0
c1 = new ulong 64 0
dtab = new ulong 128 0
hw = new ulong 128 0
h0 = new ulong 1 0
h1 = new ulong 1 0
res_b = new ulong 1 0
req = new ulong 3 0

note activation_failure_at_each_step
for stp ulong 2
fstep = add stp 1
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h0
kmi_setup_std_device dtab
kmi_hw_init hw fstep
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_HARDWARE
ret 161
end
if ne get hw 4 fstep
ret 161
end
if ne get hw 2 0
ret 162
end
if ne get hw 3 1
ret 162
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 162
end
end

note failed_teardown_blocks_activation_until_a_clean_retry
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_ALL h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_QUIESCE
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_OK
ret 163
end
put req 0 1
put req 1 get h0 0
put req 2 0
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_HARDWARE
ret 164
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_REVOKING
ret 164
end
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h1
kmi_hw_clear_effects hw
if ne kmi_dev_activate c0 get h1 0 dtab hw KMI_DEV_ERR_WRONG_STATE
ret 165
end
if ne get hw 0 0
ret 165
end
put hw 1 KMI_HW_NONE
if ne kmi_dtab_force_quiesce dtab 0x100 hw KMI_DEV_OK
ret 166
end
if not kmi_check_teardown_effects hw 0
ret 166
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 166
end

note revoke_failure_at_each_step_still_closes_gates_and_revokes
for s ulong 4
fstep = add s KMI_HW_DISABLE_BME
kmi_cap_init c0 1 4
kmi_cap_init c1 2 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_ALL h0
ign_i = kmi_cap_derive_into c0 get h0 0 c1 KMI_RIGHT_MAP h1
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
ign_i = kmi_dev_activate c1 get h1 0 dtab hw
kmi_hw_clear_effects hw
put hw 1 fstep
put req 0 1
put req 1 get h0 0
put req 2 1
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_HARDWARE
ret 167
end
if ne get hw 4 fstep
ret 167
end
if not kmi_check_teardown_effects hw 0
ret 168
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_REVOKING
ret 168
end
if ne kmi_cap_lookup c0 get h0 0 KMI_RIGHT_NONE res_b KMI_DEV_ERR_CAP_INVALID
ret 169
end
if ne kmi_cap_lookup c1 get h1 0 KMI_RIGHT_NONE res_b KMI_DEV_ERR_CAP_INVALID
ret 169
end
end

note duplicate_or_missing_table_in_revoke_set
kmi_cap_init c0 1 4
kmi_cap_init c1 2 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_ALL h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
put req 0 1
put req 1 get h0 0
put req 2 0
if ne kmi_dev_revoke req c1 c0 dtab hw KMI_DEV_ERR_CAP_DUP_TABLE
ret 170
end
kmi_cap_init c1 1 4
put req 2 1
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_CAP_DUP_TABLE
ret 170
end
if ne get hw 0 0
ret 171
end
ret kmi_test_device_reg_sweep
end

note ========================================================================
note 7. EDU DMA Tests (exit codes 196..215)
note ========================================================================

fn kmi_test_edu to int
st = new ulong 24 0
dev_buf = new uchar 4096 0
ram_buf = new uchar 16384 0

note probe_reads_version_and_checks_liveness
kmi_edu_init st
if ne kmi_edu_probe st KMI_EDU_OK
ret 196
end
if ne get st 18 1
ret 196
end
if ne get st 19 0
ret 196
end
put st 0 ulong 0x1af41000
if ne kmi_edu_probe st KMI_EDU_ERR_NOT_EDU
ret 197
end
kmi_edu_init st
put st 16 ulong 0
if ne kmi_edu_probe st KMI_EDU_ERR_LIVENESS
ret 198
end

note round_trips_bytes_through_the_device_buffer
kmi_edu_init st
for i ulong 200
put ram_buf add 0x100 i uchar and xor i 0xa5 255
end
src_a = add get st 9 0x100
dst_a = add get st 9 0x2000
if ne kmi_edu_transfer st dev_buf ram_buf src_a 200 false KMI_EDU_OK
ret 199
end
if ne kmi_edu_transfer st dev_buf ram_buf dst_a 200 true KMI_EDU_OK
ret 199
end
for i ulong 200
if ne get ram_buf add 0x2000 i get ram_buf add 0x100 i
ret 200
end
end
if ne get st 15 2
ret 201
end
if ne get st 3 KMI_EDU_DMA_BUF_ADDR
ret 201
end
if ne get st 4 dst_a
ret 201
end
if ne get st 6 KMI_EDU_DMA_TO_RAM
ret 201
end
if ne get st 2 0
ret 201
end

note full_buffer_transfer_is_allowed
kmi_edu_init st
at_a = get st 9
if ne kmi_edu_transfer st dev_buf ram_buf at_a KMI_EDU_DMA_BUF_SIZE false KMI_EDU_OK
ret 202
end
if ne kmi_edu_transfer st dev_buf ram_buf add at_a KMI_EDU_DMA_BUF_SIZE KMI_EDU_DMA_BUF_SIZE true KMI_EDU_OK
ret 202
end

note blocked_transfer_completes_but_leaves_ram_untouched
kmi_edu_init st
for i ulong 64
put dev_buf i uchar 0x77
put ram_buf add 0x3000 i uchar 0
end
forb = add get st 9 0x3000
put st 10 forb
put st 11 add forb 0x1000
if ne kmi_edu_transfer st dev_buf ram_buf forb 64 true KMI_EDU_OK
ret 203
end
for i ulong 64
if ne get ram_buf add 0x3000 i 0
ret 204
end
end

note rejects_bad_lengths_and_addresses_before_touching_the_device
kmi_edu_init st
top = add KMI_EDU_DEFAULT_DMA_MASK 1
if ne kmi_edu_transfer st dev_buf ram_buf 0x1000 0 false KMI_EDU_ERR_EMPTY
ret 205
end
if ne kmi_edu_transfer st dev_buf ram_buf 0x1000 4097 false KMI_EDU_ERR_TOO_LONG
ret 205
end
if ne kmi_edu_transfer st dev_buf ram_buf top 16 true KMI_EDU_ERR_IOVA_RANGE
ret 206
end
if ne kmi_edu_transfer st dev_buf ram_buf sub top 8 16 true KMI_EDU_ERR_IOVA_RANGE
ret 206
end
if ne kmi_edu_transfer st dev_buf ram_buf sub ulong 0xffffffffffffffff 3 16 true KMI_EDU_ERR_IOVA_RANGE
ret 206
end
if ne get st 3 0
ret 207
end
if ne get st 6 0
ret 207
end

note last_byte_below_the_mask_is_accepted
kmi_edu_init st
put st 9 sub top 0x2000
if ne kmi_edu_transfer st dev_buf ram_buf sub top 16 16 true KMI_EDU_OK
ret 208
end

note wider_dma_mask_accepts_higher_addresses
kmi_edu_init st
put st 7 0xffffffffffffffff
put st 17 0xffffffffffffffff
put st 9 0x80000000
if ne kmi_edu_transfer st dev_buf ram_buf 0x80000000 16 true KMI_EDU_OK
ret 209
end

note times_out_when_the_transfer_never_finishes
kmi_edu_init st
put st 12 ulong 0
put st 8 ulong 100
at_a = get st 9
if ne kmi_edu_transfer st dev_buf ram_buf at_a 16 false KMI_EDU_ERR_TIMEOUT
ret 210
end
if ne kmi_edu_transfer st dev_buf ram_buf at_a 16 true KMI_EDU_ERR_BUSY
ret 211
end
if ne get st 6 KMI_EDU_DMA_START
ret 211
end
if ne get st 15 0
ret 211
end

note spin_budget_covers_a_slow_transfer
kmi_edu_init st
put st 13 ulong 1000
put st 8 ulong 1001
if ne kmi_edu_transfer st dev_buf ram_buf get st 9 16 false KMI_EDU_OK
ret 212
end
kmi_edu_init st
put st 13 ulong 1000
put st 8 ulong 1000
if ne kmi_edu_transfer st dev_buf ram_buf get st 9 16 false KMI_EDU_ERR_TIMEOUT
ret 213
end

note interrupt_status_and_acknowledge
kmi_edu_init st
put st 2 ulong or KMI_EDU_IRQ_BIT 1
kmi_edu_irq_ack st KMI_EDU_IRQ_BIT
if ne get st 2 1
ret 214
end
ret 0
end

note ========================================================================
note 8. Block RamDisk Tests (exit codes 216..230)
note ========================================================================

fn kmi_test_block to int
st = new ulong 12 0
disk = new uchar 2048 0
wbuf = new uchar 512 0
rbuf = new uchar 512 0
bad_buf = new uchar 100 0

note ram_disk_rejects_block_size_that_would_truncate
if ne kmi_ramdisk_init st 0x100000000 4 2048 KMI_BLK_INVALID_INPUT
ret 216
end
if ne kmi_ramdisk_init st 32 4 2048 KMI_BLK_INVALID_INPUT
ret 216
end
if ne kmi_ramdisk_init st 512 3 2048 KMI_BLK_INVALID_INPUT
ret 216
end
if ne kmi_ramdisk_init st 512 4 2048 KMI_BLK_OK
ret 217
end

note read/write round-trip and validation
for i ulong 512
put wbuf i uchar and add i 17 255
end
if ne kmi_ramdisk_write st disk 1 wbuf KMI_BLK_OK
ret 218
end
if ne kmi_ramdisk_read st disk 1 rbuf KMI_BLK_OK
ret 218
end
for i ulong 512
if ne get rbuf i get wbuf i
ret 219
end
end
if ne kmi_ramdisk_read st disk 0 bad_buf KMI_BLK_INVALID_INPUT
ret 220
end
if ne kmi_ramdisk_read st disk 4 rbuf KMI_BLK_OUT_OF_RANGE
ret 220
end

note fail_after_blocks torn write
kmi_ramdisk_fail_after st true 0
put wbuf 0 uchar 0xee
if ne kmi_ramdisk_write st disk 2 wbuf KMI_BLK_DEVICE_ERROR
ret 221
end
if ne get disk 1024 0
ret 221
end

note tear_write persists prefix and marks failed
kmi_ramdisk_tear_write st 1 16
for i ulong 512
put wbuf i uchar 0xaa
end
if ne kmi_ramdisk_write st disk 2 wbuf KMI_BLK_DEVICE_ERROR
ret 222
end
if ne get disk 1024 0xaa
ret 223
end
if ne get disk 1039 0xaa
ret 223
end
if ne get disk 1040 0
ret 223
end
if ne kmi_ramdisk_write st disk 0 wbuf KMI_BLK_DEVICE_ERROR
ret 224
end

note corrupt_byte
if ne kmi_ramdisk_corrupt st disk 5 uchar 0x55 KMI_BLK_OK
ret 225
end
if ne get disk 5 0x55
ret 225
end
if ne kmi_ramdisk_corrupt st disk 2048 uchar 0x55 KMI_BLK_OUT_OF_RANGE
ret 226
end
ret 0
end

note ========================================================================
note 9. NVMe Atomicity Tests (exit codes 231..250)
note ========================================================================

fn kmi_set_af af edit ulong 8 bs ulong has_aw ulong aw ulong has_naw ulong naw ulong to void
put af 0 bs
put af 1 has_aw
put af 2 aw
put af 3 has_naw
put af 4 naw
put af 5 ulong 0
put af 6 ulong 0
put af 7 ulong 0
end

fn kmi_test_nvme_atomicity to int
af = new ulong 8 0
info = new ulong 4 0
lba = new ulong 2 0
raw = new uchar 3 0
u16_o = new ushort 1 0

note insufficient_controller_awupf_rejects
kmi_set_af af 512 1 6 0 0
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_EXCEEDS
ret 231
end
if ne get info 1 8
ret 231
end
if ne get info 2 7
ret 231
end

note sufficient_decoded_awupf_accepts
kmi_set_af af 512 1 7 0 0
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_ATOMIC
ret 232
end
if ne get info 0 8
ret 232
end

note namespace_override_wins_over_controller
kmi_set_af af 512 1 15 1 3
if ne kmi_nvme_effective_pf af 4
ret 233
end
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_EXCEEDS
ret 233
end
if ne get info 2 4
ret 233
end

note namespace_zero_falls_back_to_controller
kmi_set_af af 512 1 7 1 0
if ne kmi_nvme_effective_pf af 8
ret 234
end
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_ATOMIC
ret 234
end

note sufficient_unit_but_crosses_boundary_rejects
kmi_set_af af 512 1 15 0 0
put af 5 ulong 1
put af 6 ulong 3
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_CROSSES
ret 235
end
if ne get info 0 4
ret 235
end
if ne kmi_nvme_write_atomic af 0 4 info KMI_ATOM_ATOMIC
ret 236
end

note boundary_safe_write_accepts
kmi_set_af af 512 1 7 0 0
if ne kmi_nvme_write_atomic af 8 8 info KMI_ATOM_ATOMIC
ret 237
end

note boundary_offset_is_respected
kmi_set_af af 512 1 15 0 0
put af 5 ulong 1
put af 6 ulong 7
put af 7 ulong 4
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_CROSSES
ret 238
end
if ne kmi_nvme_write_atomic af 4 8 info KMI_ATOM_ATOMIC
ret 239
end

note store_root_512_geometry
kmi_set_af af 512 1 7 0 0
if not kmi_nvme_store_unit_lba af uint 0 lba
ret 240
end
if ne get lba 0 0
ret 240
end
if ne get lba 1 8
ret 240
end
if not kmi_nvme_store_unit_lba af uint 1 lba
ret 241
end
if ne get lba 0 8
ret 241
end
if ne get lba 1 8
ret 241
end
if ne kmi_nvme_store_root_decision af uint 0 info KMI_ATOM_ATOMIC
ret 242
end
if ne kmi_nvme_store_root_decision af uint 1 info KMI_ATOM_ATOMIC
ret 242
end

note store_root_4096_geometry
kmi_set_af af 4096 1 0 0 0
if not kmi_nvme_store_unit_lba af uint 0 lba
ret 243
end
if ne get lba 1 1
ret 243
end
if ne kmi_nvme_store_root_decision af uint 1 info KMI_ATOM_ATOMIC
ret 243
end

note encoding_edge_zero_and_max
kmi_set_af af 512 1 0 0 0
if ne kmi_nvme_effective_pf af 1
ret 244
end
kmi_set_af af 512 1 65535 0 0
if ne kmi_nvme_effective_pf af 65536
ret 244
end

note unknown_state_fails_closed
kmi_set_af af 512 0 0 0 0
if ne kmi_nvme_write_atomic af 0 8 info KMI_ATOM_NO_GUARANTEE
ret 245
end

note unsupported_geometry_fails_closed
kmi_set_af af 600 1 15 0 0
if ne kmi_nvme_store_root_decision af uint 0 info KMI_ATOM_BAD_GEOMETRY
ret 246
end

note empty_write_rejects
kmi_set_af af 512 1 15 0 0
if ne kmi_nvme_write_atomic af 0 0 info KMI_ATOM_EMPTY
ret 247
end

note read_u16_le_bounds
put raw 0 uchar 7
put raw 1 uchar 0
put raw 2 uchar 255
if not kmi_read_u16_le raw 0 u16_o
ret 248
end
if ne get u16_o 0 7
ret 248
end
if kmi_read_u16_le raw 2 u16_o
ret 249
end
if kmi_read_u16_le raw 99 u16_o
ret 249
end
ret 0
end


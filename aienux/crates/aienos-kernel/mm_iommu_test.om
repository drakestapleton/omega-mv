fn kmi_test_pci_bars to int
cfg = new uint 516 0
fi = new uint 6 0
bar = new ulong 4 0
sz = new ulong 2 0

note decodes_32_and_64_bit_memory_bars_and_io_bars
if ne kmi_pci_decode_bar uint 0xfe000000 false uint 0 bar KMI_BAR_OK
ret 112
end
if ne get bar 0 KMI_BAR_MEM32
ret 112
end
if ne get bar 1 0xfe000000
ret 112
end
if ne get bar 2 0
ret 112
end
if ne kmi_pci_decode_bar uint 0x1000000c true uint 0x80 bar KMI_BAR_OK
ret 113
end
if ne get bar 0 KMI_BAR_MEM64
ret 113
end
if ne get bar 1 0x8010000000
ret 113
end
if ne get bar 2 1
ret 113
end
if ne kmi_pci_decode_bar uint 0xc001 false uint 0 bar KMI_BAR_OK
ret 114
end
if ne get bar 0 KMI_BAR_IO
ret 114
end
if ne get bar 1 0xc000
ret 114
end
if ne kmi_pci_decode_bar uint 0x4 false uint 0 bar KMI_BAR_ERR_MISSING_HIGH
ret 115
end
if ne kmi_pci_decode_bar uint 0x6 true uint 0 bar KMI_BAR_ERR_RESERVED
ret 115
end
if ne kmi_pci_decode_bar uint 0x2 false uint 0 bar KMI_BAR_ERR_RESERVED
ret 115
end

note read_bar_respects_header_type_and_slots
kmi_pci_cfg_init cfg
rid2 = kmi_bdf_rid uchar 0 uchar 2 uchar 0
rid3 = kmi_bdf_rid uchar 0 uchar 3 uchar 0
i0 = kmi_pci_cfg_add cfg rid2 uint 0x11e81234 uchar 0
kmi_pci_cfg_set_reg cfg ulong i0 4 uint 0x10000000
kmi_pci_cfg_set_reg cfg ulong i0 5 uint 0x20000004
kmi_pci_cfg_set_reg cfg ulong i0 6 uint 0x00000001
kmi_pci_cfg_set_reg cfg ulong i0 9 uint 0x00000004
i1 = kmi_pci_cfg_add cfg rid3 uint 0x00011b36 uchar 1
kmi_pci_cfg_set_reg cfg ulong i1 4 uint 0x30000000
if not kmi_pci_read_fn cfg rid2 fi
ret 116
end
if ne kmi_pci_read_bar cfg fi uchar 0 bar KMI_BAR_OK
ret 116
end
if ne get bar 1 0x10000000
ret 116
end
if ne kmi_pci_read_bar cfg fi uchar 1 bar KMI_BAR_OK
ret 117
end
if ne get bar 3 1
ret 117
end
if ne get bar 1 0x120000000
ret 117
end
if ne kmi_pci_read_bar cfg fi uchar 5 bar KMI_BAR_ERR_MISSING_HIGH
ret 118
end
if ne kmi_pci_read_bar cfg fi uchar 6 bar KMI_BAR_ERR_NO_SUCH
ret 118
end
if not kmi_pci_read_fn cfg rid3 fi
ret 119
end
if ne kmi_pci_read_bar cfg fi uchar 0 bar KMI_BAR_OK
ret 119
end
if ne get bar 1 0x30000000
ret 119
end
if ne kmi_pci_read_bar cfg fi uchar 2 bar KMI_BAR_ERR_NO_SUCH
ret 119
end

note probes_bar_sizes_and_restores_state
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg rid2 uint 0x11e81234 uchar 0
kmi_pci_cfg_set_reg cfg ulong i0 1 uint or KMI_PCI_CMD_MEMORY KMI_PCI_CMD_BUS_MASTER
kmi_pci_cfg_set_reg cfg ulong i0 4 uint 0x10000000
kmi_pci_cfg_set_reg cfg ulong i0 5 uint 0x0000000c
kmi_pci_cfg_set_reg cfg ulong i0 6 uint 0x00000080
kmi_pci_cfg_set_bar_mask cfg ulong i0 0 uint 0xfff00000
kmi_pci_cfg_set_bar_mask cfg ulong i0 1 uint 0xffffc000
kmi_pci_cfg_set_bar_mask cfg ulong i0 2 uint 0xffffffff
kmi_pci_cfg_set_bar_mask cfg ulong i0 3 uint 0
if not kmi_pci_read_fn cfg rid2 fi
ret 120
end
if ne kmi_pci_probe_bar_size cfg fi uchar 0 sz KMI_BAR_OK
ret 120
end
if ne get sz 0 1
ret 120
end
if ne get sz 1 0x100000
ret 120
end
if ne kmi_pci_probe_bar_size cfg fi uchar 1 sz KMI_BAR_OK
ret 121
end
if ne get sz 0 1
ret 121
end
if ne get sz 1 16384
ret 121
end
if ne kmi_pci_probe_bar_size cfg fi uchar 3 sz KMI_BAR_OK
ret 122
end
if ne get sz 0 0
ret 122
end
if ne kmi_pci_cfg_get_reg cfg ulong i0 4 0x10000000
ret 123
end
if ne kmi_pci_cfg_get_reg cfg ulong i0 5 0x0000000c
ret 123
end
if ne kmi_pci_cfg_get_reg cfg ulong i0 6 0x00000080
ret 123
end
if ne and kmi_pci_cfg_get_reg cfg ulong i0 1 0xffff uint or KMI_PCI_CMD_MEMORY KMI_PCI_CMD_BUS_MASTER
ret 124
end

note update_command_sets_and_clears_bits_without_touching_status
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg rid2 uint 0x11e81234 uchar 0
st_bits = or shl uint 1 13 shl uint 1 4
kmi_pci_cfg_set_reg cfg ulong i0 1 or shl st_bits 16 shl uint 1 10
on_v = kmi_pci_update_cmd cfg rid2 or KMI_PCI_CMD_MEMORY KMI_PCI_CMD_BUS_MASTER ushort 0
if ne on_v or shl ushort 1 10 or KMI_PCI_CMD_MEMORY KMI_PCI_CMD_BUS_MASTER
ret 125
end
off_v = kmi_pci_update_cmd cfg rid2 ushort 0 KMI_PCI_CMD_BUS_MASTER
if ne off_v or shl ushort 1 10 KMI_PCI_CMD_MEMORY
ret 126
end
if ne shr kmi_pci_cfg_get_reg cfg ulong i0 1 16 st_bits
ret 127
end
ret 0
end

fn kmi_test_pci to int
cfg = new uint 516 0
fi = new uint 6 0
found = new uint 60 0

note requester_id_packs_bus_device_function
if ne kmi_bdf_rid uchar 0 uchar 0 uchar 0 0
ret 101
end
if ne kmi_bdf_rid uchar 0 uchar 2 uchar 0 0x10
ret 101
end
if ne kmi_bdf_rid uchar 1 uchar 3 uchar 5 0x11d
ret 102
end
if ne kmi_bdf_rid uchar 255 uchar 31 uchar 7 0xffff
ret 102
end
if kmi_bdf_valid uchar 32 uchar 0
ret 103
end
if kmi_bdf_valid uchar 0 uchar 8
ret 103
end

note finds_device_by_vendor_and_device_id
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 0 uchar 0 uint 0x00081b36 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 1 uchar 0 uint 0x10001af4 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 3 uchar 0 uint 0x11e81234 uchar 0
kmi_pci_cfg_set_reg cfg ulong i0 2 uint 0x00ff0010
if not kmi_pci_find_device cfg uchar 0 uchar 0 uint 0x11e81234 fi
ret 104
end
if ne get fi 0 0x18
ret 105
end
if ne get fi 3 0
ret 105
end
if ne get fi 4 0
ret 105
end
if ne get fi 5 0x00ff0010
ret 105
end
if kmi_pci_find_device cfg uchar 0 uchar 0 uint 0x00011234 fi
ret 106
end

note walk_skips_functions_1_to_7_unless_multi_function
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 1 uchar 0 uint 0x00011111 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 1 uchar 2 uint 0x00021111 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 4 uchar 0 uint 0x00012222 uchar 0x80
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 4 uchar 2 uint 0x00022222 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 4 uchar 7 uint 0x00032222 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar 6 uchar 1 uint 0x00013333 uchar 0
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 2 uchar 0 uchar 0 uint 0x00014444 uchar 1
cnt = kmi_pci_walk cfg uchar 0 uchar 2 found
if ne cnt 5
ret 107
end
if ne get found 0 kmi_bdf_rid uchar 0 uchar 1 uchar 0
ret 108
end
if ne get found 6 kmi_bdf_rid uchar 0 uchar 4 uchar 0
ret 108
end
if ne get found 12 kmi_bdf_rid uchar 0 uchar 4 uchar 2
ret 108
end
if ne get found 18 kmi_bdf_rid uchar 0 uchar 4 uchar 7
ret 108
end
if ne get found 24 kmi_bdf_rid uchar 2 uchar 0 uchar 0
ret 108
end
if ne kmi_pci_walk cfg uchar 0 uchar 1 found 4
ret 109
end

note walk_covers_last_bus_and_device_without_overflow
kmi_pci_cfg_init cfg
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 255 uchar 31 uchar 0 uint 0x00015555 uchar 0x80
i0 = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 255 uchar 31 uchar 7 uint 0x00025555 uchar 0
if ne kmi_pci_walk cfg uchar 255 uchar 255 found 2
ret 110
end
put cfg 1 uint 0
if ne kmi_pci_walk cfg uchar 5 uchar 4 found 0
ret 111
end
if ne get cfg 1 0
ret 111
end
ret kmi_test_pci_bars
end

note ========================================================================
note 6. Device Registry and Authority Tests (exit codes 131..195)
note ========================================================================

fn kmi_setup_std_device dtab edit ulong 128 to void
spec = new ulong 8 0
kmi_dtab_init dtab 4
put spec 0 0x100
put spec 1 3
put spec 2 0x10
put spec 3 0x10
put spec 4 KMI_DMA_QUIESCED
put spec 5 0
put spec 6 0
put spec 7 0
ign = kmi_dtab_register dtab spec
ign2 = kmi_dtab_set_window dtab 0x100 0x40000000 uint 4
end

fn kmi_dev_state dtab view ulong 128 res ulong to ulong
idx = kmi_dtab_find dtab res
if lt idx 0
ret 99
end
off = add 4 mul ulong idx 12
ret get dtab add off 5
end

fn kmi_check_teardown_effects hw view ulong 128 start_idx ulong to bool
if lt get hw 0 add start_idx 5
ret false
end
o0 = add 8 mul start_idx 3
if ne get hw o0 KMI_EFF_STOP_WORK
ret false
end
if ne get hw add o0 3 KMI_EFF_BME_OFF
ret false
end
if ne get hw add o0 6 KMI_EFF_QUIESCE
ret false
end
if ne get hw add o0 9 KMI_EFF_ABORT
ret false
end
if ne get hw add o0 12 KMI_EFF_INVALIDATE
ret false
end
ret true
end

fn kmi_test_device_1 to int
c0 = new ulong 64 0
c1 = new ulong 64 0
dtab = new ulong 128 0
hw = new ulong 128 0
h0 = new ulong 1 0
h1 = new ulong 1 0
res_b = new ulong 1 0
req = new ulong 3 0

note activate_installs_translation_before_bus_master
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_OK
ret 131
end
if ne get hw 0 2
ret 132
end
if ne get hw 8 KMI_EFF_INSTALL
ret 132
end
if ne get hw 11 KMI_EFF_BME_ON
ret 132
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_ACTIVE
ret 133
end

note revoke_runs_exact_teardown_then_removes_capability_tree
kmi_cap_init c0 1 4
kmi_cap_init c1 2 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_ALL h0
if ne kmi_cap_derive_into c0 get h0 0 c1 KMI_RIGHT_MAP h1 KMI_DEV_OK
ret 134
end
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
if ne kmi_dev_activate c1 get h1 0 dtab hw KMI_DEV_OK
ret 134
end
kmi_hw_clear_effects hw
put req 0 1
put req 1 get h0 0
put req 2 1
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_OK
ret 135
end
if not kmi_check_teardown_effects hw 0
ret 136
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_QUIESCED
ret 137
end
if ne kmi_cap_lookup c0 get h0 0 KMI_RIGHT_NONE res_b KMI_DEV_ERR_CAP_INVALID
ret 138
end
if ne kmi_cap_lookup c1 get h1 0 KMI_RIGHT_NONE res_b KMI_DEV_ERR_CAP_INVALID
ret 138
end

note activate_with_revoked_handle_fails_without_effects
kmi_hw_clear_effects hw
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_ERR_CAP_INVALID
ret 139
end
if ne get hw 0 0
ret 139
end

note missing_capability_causes_no_effects
kmi_cap_init c0 1 4
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
bogus = kmi_cap_pack_handle 0 1
if ne kmi_dev_activate c0 bogus dtab hw KMI_DEV_ERR_CAP_INVALID
ret 140
end
put req 0 1
put req 1 bogus
put req 2 0
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_CAP_INVALID
ret 140
end
if ne get hw 0 0
ret 141
end

note read_only_capability_causes_no_effects

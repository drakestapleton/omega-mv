note sweep_keeps_counting_past_the_recorded_findings
kmi_pci_cfg_init cfg
for d ulong 12
ix = kmi_pci_cfg_add cfg kmi_bdf_rid uchar 0 uchar and d 31 uchar 0 uint 0x9999abcd uchar 0
kmi_pci_cfg_set_reg cfg ulong ix 1 uint 0x0004
end

note map_without_revoke_cannot_tear_down_an_active_device
kmi_cap_init c0 1 4
ign = kmi_cap_insert c0 0x100 KMI_RIGHT_MAP h0
kmi_setup_std_device dtab
kmi_hw_init hw KMI_HW_NONE
if ne kmi_dev_activate c0 get h0 0 dtab hw KMI_DEV_OK
ret 144
end
kmi_hw_clear_effects hw
put req 1 get h0 0
if ne kmi_dev_revoke req c0 c1 dtab hw KMI_DEV_ERR_CAP_RIGHTS
ret 144
end
if ne get hw 0 0
ret 145
end
if ne kmi_dev_state dtab 0x100 KMI_DMA_ACTIVE
ret 145

note Behavioral test suite for aienos-kernel USB & xHCI stack (usb_xhci.om)
note Composed with si/directives/om2.om and usb_xhci.om.
note Returns 0 on pass and distinct non-zero exit codes on every failure.

fn kux_test_sink_eq sink view KuxTextSink want view uchar * to bool
  if ne get sink cnt len want
    ret false
  end
  n = len want
  for i ulong n bound 64
    if ne get sink buf i get want i
      ret false
    end
  end
  ret true
end

fn kux_test_make_report dst edit uchar 8 mods uchar k0 uchar k1 uchar k2 uchar k3 uchar to void
  put dst 0 mods
  put dst 1 uchar 0
  put dst 2 k0
  put dst 3 k1
  put dst 4 k2
  put dst 5 k3
  put dst 6 uchar 0
  put dst 7 uchar 0
end

fn kux_test_descriptors to int
  kbd_desc = new uchar 34 0
  comp = new uchar 57 0
  dev1 = new uchar 8 0
  dev2 = new uchar 10 0
  dev_short = new uchar 3 0
  bad_cfg = new uchar 4 0
  res = new KuxBootKbd false 0 0 0 0 0

  note QEMU 8.2.2 usb-kbd config descriptor (34 bytes)
  put kbd_desc 0 uchar 9
  put kbd_desc 1 uchar 2
  put kbd_desc 2 uchar 34
  put kbd_desc 4 uchar 1
  put kbd_desc 5 uchar 1
  put kbd_desc 6 uchar 8
  put kbd_desc 7 uchar 0xa0
  put kbd_desc 8 uchar 50
  put kbd_desc 9 uchar 9
  put kbd_desc 10 uchar 4
  put kbd_desc 13 uchar 1
  put kbd_desc 14 uchar 3
  put kbd_desc 15 uchar 1
  put kbd_desc 16 uchar 1
  put kbd_desc 18 uchar 9
  put kbd_desc 19 uchar 0x21
  put kbd_desc 20 uchar 0x11
  put kbd_desc 21 uchar 0x01
  put kbd_desc 23 uchar 1
  put kbd_desc 24 uchar 0x22
  put kbd_desc 25 uchar 63
  put kbd_desc 27 uchar 7
  put kbd_desc 28 uchar 5
  put kbd_desc 29 uchar 0x81
  put kbd_desc 30 uchar 3
  put kbd_desc 31 uchar 8
  put kbd_desc 33 uchar 7

  if not kux_find_boot_keyboard kbd_desc res
    ret 1
  end
  if ne get res cfg uchar 1
    ret 2
  end
  if ne get res iface uchar 0
    ret 2
  end
  if ne get res ep_addr uchar 0x81
    ret 2
  end
  if ne get res max_pkt ushort 8
    ret 2
  end
  if ne get res ival uchar 7
    ret 2
  end

  note Composite device: mouse + keyboard OUT + keyboard IN
  put comp 0 uchar 9
  put comp 1 uchar 2
  put comp 2 uchar 50
  put comp 4 uchar 2
  put comp 5 uchar 2
  put comp 7 uchar 0xa0
  put comp 8 uchar 50
  put comp 9 uchar 9
  put comp 10 uchar 4
  put comp 13 uchar 1
  put comp 14 uchar 3
  put comp 15 uchar 1
  put comp 16 uchar 2
  put comp 18 uchar 7
  put comp 19 uchar 5
  put comp 20 uchar 0x81
  put comp 21 uchar 3
  put comp 22 uchar 4
  put comp 24 uchar 10
  put comp 25 uchar 9
  put comp 26 uchar 4
  put comp 27 uchar 1
  put comp 29 uchar 2
  put comp 30 uchar 3
  put comp 31 uchar 1
  put comp 32 uchar 1
  put comp 34 uchar 7
  put comp 35 uchar 5
  put comp 36 uchar 0x02
  put comp 37 uchar 3
  put comp 38 uchar 8
  put comp 40 uchar 10
  put comp 41 uchar 9
  put comp 42 uchar 0x21
  put comp 43 uchar 0x11
  put comp 44 uchar 0x01
  put comp 46 uchar 1
  put comp 47 uchar 0x22
  put comp 48 uchar 63

  note Without keyboard IN endpoint (first 50 bytes)
  if kux_find_boot_keyboard part comp 0 50 res
    ret 3
  end

  note Append keyboard IN endpoint 0x83 and update wTotalLength to 57
  put comp 2 uchar 57
  put comp 50 uchar 7
  put comp 51 uchar 5
  put comp 52 uchar 0x83
  put comp 53 uchar 3
  put comp 54 uchar 8
  put comp 56 uchar 4
  if not kux_find_boot_keyboard comp res
    ret 4
  end
  if ne get res cfg uchar 2
    ret 5
  end
  if ne get res iface uchar 1
    ret 5
  end
  if ne get res ep_addr uchar 0x83
    ret 5
  end
  if ne get res ival uchar 4
    ret 5
  end

  note Stops at wTotalLength, zero-length, overrun, truncation, bad type
  put kbd_desc 2 uchar 27
  if kux_find_boot_keyboard kbd_desc res
    ret 6
  end
  put kbd_desc 2 uchar 34
  put kbd_desc 9 uchar 0
  if kux_find_boot_keyboard kbd_desc res
    ret 7
  end
  put kbd_desc 9 uchar 9
  put kbd_desc 27 uchar 200
  if kux_find_boot_keyboard kbd_desc res
    ret 8
  end
  put kbd_desc 27 uchar 7
  if kux_find_boot_keyboard part kbd_desc 0 20 res
    ret 9
  end
  put bad_cfg 0 uchar 9
  put bad_cfg 1 uchar 1
  if kux_find_boot_keyboard bad_cfg res
    ret 10
  end

  note control_max_packet
  put dev1 0 uchar 18
  put dev1 1 uchar 1
  put dev1 3 uchar 2
  put dev1 7 uchar 64
  if ne kux_control_max_packet dev1 uchar 64
    ret 11
  end
  put dev2 0 uchar 18
  put dev2 1 uchar 1
  put dev2 2 uchar 0x10
  put dev2 3 uchar 0x01
  put dev2 7 uchar 8
  put dev2 8 uchar 0x27
  put dev2 9 uchar 0x06
  if ne kux_control_max_packet dev2 uchar 8
    ret 12
  end
  put dev1 1 uchar 2
  if ne kux_control_max_packet dev1 uchar 0
    ret 13
  end
  put dev1 1 uchar 1
  put dev1 7 uchar 0
  if ne kux_control_max_packet dev1 uchar 0
    ret 14
  end
  put dev_short 0 uchar 18
  put dev_short 1 uchar 1
  if ne kux_control_max_packet dev_short uchar 0
    ret 15
  end
  ret 0
end

fn kux_test_hid to int
  dec = new KuxKbdDec 0
  sink = new KuxTextSink 0 0 0
  rep = new uchar 8 0
  short_rep = new uchar 4 0
  ev = new KuxKeyEvent 0 0

  note Make, release, held key does not repeat
  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep uchar 0 uchar 0x04 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 1
    ret 20
  end
  if ne get sink cnt ulong 1
    ret 20
  end
  if ne get sink buf 0 uchar 97
    ret 20
  end
  kux_sink_init sink ulong 16
  kux_test_make_report rep uchar 0 uchar 0 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 0
    ret 21
  end
  kux_sink_init sink ulong 16
  kux_test_make_report rep uchar 0 uchar 0x04 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 1
    ret 22
  end
  kux_sink_init sink ulong 16
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 0
    ret 23
  end

  note Shift and digits (left shift A!, right shift )\n)
  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep KUX_MOD_LSHIFT uchar 0x04 uchar 0x1e uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 2
    ret 24
  end
  if ne get sink buf 0 uchar 65
    ret 24
  end
  if ne get sink buf 1 uchar 33
    ret 24
  end

  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep KUX_MOD_RSHIFT uchar 0x27 uchar 0x28 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 2
    ret 25
  end
  if ne get sink buf 0 uchar 41
    ret 25
  end
  if ne get sink buf 1 uchar 10
    ret 25
  end

  note Punctuation and space: " -,./" and "{}|:\"~" and "_+~<>?"
  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep uchar 0 uchar 0x2c uchar 0x2d uchar 0x36 uchar 0x37
  put rep 6 uchar 0x38
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 5
    ret 26
  end
  if ne get sink buf 0 uchar 32
    ret 26
  end
  if ne get sink buf 1 uchar 45
    ret 26
  end
  if ne get sink buf 2 uchar 44
    ret 26
  end
  if ne get sink buf 3 uchar 46
    ret 26
  end
  if ne get sink buf 4 uchar 47
    ret 26
  end

  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep KUX_MOD_LSHIFT uchar 0x2f uchar 0x30 uchar 0x31 uchar 0x33
  put rep 6 uchar 0x34
  put rep 7 uchar 0x35
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 6
    ret 27
  end
  if ne get sink buf 0 uchar 123
    ret 27
  end
  if ne get sink buf 1 uchar 125
    ret 27
  end
  if ne get sink buf 2 uchar 124
    ret 27
  end
  if ne get sink buf 3 uchar 58
    ret 27
  end
  if ne get sink buf 4 uchar 34
    ret 27
  end
  if ne get sink buf 5 uchar 126
    ret 27
  end

  kux_kbd_init dec
  kux_sink_init sink ulong 16
  kux_test_make_report rep KUX_MOD_LSHIFT uchar 0x2d uchar 0x2e uchar 0x32 uchar 0x36
  put rep 6 uchar 0x37
  put rep 7 uchar 0x38
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 6
    ret 28
  end
  if ne get sink buf 0 uchar 95
    ret 28
  end
  if ne get sink buf 1 uchar 43
    ret 28
  end
  if ne get sink buf 2 uchar 126
    ret 28
  end
  if ne get sink buf 3 uchar 60
    ret 28
  end
  if ne get sink buf 4 uchar 62
    ret 28
  end
  if ne get sink buf 5 uchar 63
    ret 28
  end

  note Control keys and arrows: Backspace, Tab, Escape, Up -> \x08\t\x1b\x1b[A
  kux_kbd_init dec
  kux_sink_init sink ulong 32
  kux_test_make_report rep uchar 0 uchar 0x2a uchar 0x2b uchar 0x29 uchar 0
  n = kux_kbd_handle_report dec rep sink
  kux_test_make_report rep uchar 0 uchar 0 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  kux_test_make_report rep uchar 0 KUX_USAGE_UP_ARROW uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 6
    ret 29
  end
  if ne get sink buf 0 uchar 8
    ret 29
  end
  if ne get sink buf 1 uchar 9
    ret 29
  end
  if ne get sink buf 2 uchar 0x1b
    ret 29
  end
  if ne get sink buf 3 uchar 0x1b
    ret 29
  end
  if ne get sink buf 4 uchar 91
    ret 29
  end
  if ne get sink buf 5 uchar 65
    ret 29
  end

  note Rollover phantom report does not release held key; wrong length ignored
  kux_kbd_init dec
  kux_sink_init sink ulong 8
  kux_test_make_report rep uchar 0 uchar 0x04 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  kux_sink_init sink ulong 8
  kux_test_make_report rep uchar 0 uchar 1 uchar 1 uchar 1 uchar 1
  put rep 6 uchar 1
  put rep 7 uchar 1
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 0
    ret 30
  end
  kux_test_make_report rep uchar 0 uchar 0x04 uchar 0 uchar 0 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne get sink cnt ulong 0
    ret 31
  end
  n = kux_kbd_handle_report dec short_rep sink
  if ne n ulong 0
    ret 32
  end

  note Unmapped usages dropped (CapsLock, F1, F12)
  kux_kbd_init dec
  kux_sink_init sink ulong 8
  kux_test_make_report rep uchar 0 KUX_USAGE_CAPS_LOCK KUX_USAGE_F1 KUX_USAGE_F12 uchar 0
  n = kux_kbd_handle_report dec rep sink
  if ne n ulong 0
    ret 33
  end

  note Sink truncates at capacity 4 ("hello" -> "hell")
  kux_sink_init sink ulong 4
  put ev kind KUX_KEY_CHAR
  put ev ch uchar 104
  kux_sink_record sink ev
  put ev ch uchar 101
  kux_sink_record sink ev
  put ev ch uchar 108
  kux_sink_record sink ev
  put ev ch uchar 108
  kux_sink_record sink ev
  put ev ch uchar 111
  kux_sink_record sink ev
  if ne get sink cnt ulong 4
    ret 34
  end
  if ne get sink buf 3 uchar 108
    ret 34
  end
  ret 0
end

fn kux_test_fill_uac1 dst edit uchar 73 to void
  note Real UAC1 descriptor (73 bytes)
  put dst 0 uchar 9
  put dst 1 uchar 2
  put dst 2 uchar 73
  put dst 4 uchar 2
  put dst 5 uchar 1
  put dst 7 uchar 0x80
  put dst 8 uchar 50
  put dst 9 uchar 9
  put dst 10 uchar 4
  put dst 14 uchar 1
  put dst 15 uchar 1
  put dst 18 uchar 9
  put dst 19 uchar 0x24
  put dst 20 uchar 1
  put dst 22 uchar 1
  put dst 23 uchar 0x26
  put dst 25 uchar 1
  put dst 26 uchar 1
  put dst 27 uchar 9
  put dst 28 uchar 4
  put dst 29 uchar 1
  put dst 32 uchar 1
  put dst 33 uchar 2
  put dst 36 uchar 9
  put dst 37 uchar 4
  put dst 38 uchar 1
  put dst 39 uchar 1
  put dst 40 uchar 1
  put dst 41 uchar 1
  put dst 42 uchar 2
  put dst 45 uchar 7
  put dst 46 uchar 0x24
  put dst 47 uchar 1
  put dst 48 uchar 1
  put dst 49 uchar 2
  put dst 50 uchar 3
  put dst 52 uchar 11
  put dst 53 uchar 0x24
  put dst 54 uchar 2
  put dst 55 uchar 1
  put dst 56 uchar 2
  put dst 57 uchar 2
  put dst 58 uchar 16
  put dst 59 uchar 1
  put dst 60 uchar 0x80
  put dst 61 uchar 0xbb
  put dst 63 uchar 9
  put dst 64 uchar 5
  put dst 65 uchar 1
  put dst 66 uchar 1
  put dst 67 uchar 192
  put dst 69 uchar 1
end


note Behavioral test suite for AIENOS Kernel System Unit (pure OM-2)
note Covers all unit tests from:
note   abi.rs, task_runtime.rs, thread.rs, user.rs, gic.rs, timer.rs,
note   console.rs, fatal.rs, report.rs, shell.rs, pe.rs, spinlock.rs,
note   infer/{gemm,rope,attention,tokenizer}.rs

note =========================================================================
note Test 1: ABI v1 wire encoding, golden bytes, envelopes, fail-closed checks
note =========================================================================

fn t_abi_handle to int
  h = new KsysHandle uint 0 uint 0
  if ne ksys_handle_make uint 7 uint 0x01020304 h KSYS_ABI_OK
    ret 1
  end
  buf = new uchar 16 uchar 0xaa
  if ne ksys_abi_encode_handle h buf KSYS_ABI_OK
    ret 2
  end
  if ne get buf 0 uchar 7
    ret 3
  end
  if ne get buf 4 uchar 4
    ret 4
  end
  if ne get buf 7 uchar 1
    ret 5
  end
  if ne ksys_handle_to_raw h ulong 0x0102030400000007
    ret 6
  end
  h2 = new KsysHandle uint 0 uint 0
  if ne ksys_handle_from_raw ulong 0x0102030400000007 h2 KSYS_ABI_OK
    ret 7
  end
  if ne get h2 index uint 7
    ret 8
  end
  if ne get h2 gen uint 0x01020304
    ret 9
  end
  note Truncation, wrong length, buffer too small
  if ne ksys_abi_decode_handle part buf 0 7 h2 KSYS_ABI_ERR_TRUNCATED
    ret 10
  end
  if ne ksys_abi_decode_handle part buf 0 9 h2 KSYS_ABI_ERR_WRONG_LEN
    ret 11
  end
  if ne ksys_abi_encode_handle h part buf 0 7 KSYS_ABI_ERR_BUF_SMALL
    ret 12
  end
  note Max and boundary raw packing
  if ne ksys_handle_make uint 0xffffffff uint 0xffffffff h2 KSYS_ABI_OK
    ret 13
  end
  if ne ksys_handle_to_raw h2 ulong 0xffffffffffffffff
    ret 14
  end
  if ne ksys_handle_make uint 0 uint 1 h2 KSYS_ABI_OK
    ret 15
  end
  if ne ksys_handle_to_raw h2 shl ulong 1 ulong 32
    ret 16
  end
  note Generation 0 fails closed
  if ne ksys_handle_make uint 3 uint 0 h2 KSYS_ABI_ERR_INVALID_HANDLE
    ret 17
  end
  if ne ksys_handle_from_raw ulong 0 h2 KSYS_ABI_ERR_INVALID_HANDLE
    ret 18
  end
  if ne ksys_handle_from_raw ulong 0x00000000ffffffff h2 KSYS_ABI_ERR_INVALID_HANDLE
    ret 19
  end
  zero_g = new uchar 8 uchar 0
  put zero_g 0 uchar 1
  if ne ksys_abi_decode_handle zero_g h2 KSYS_ABI_ERR_INVALID_HANDLE
    ret 20
  end
  ret 0
end

fn t_abi_ids_and_resid to int
  buf = new uchar 16 uchar 0
  u32_out = new uint 1 uint 0
  u64_out = new ulong 1 ulong 0
  if ne ksys_abi_encode_u32 uint 0x11223344 buf KSYS_ABI_OK
    ret 21
  end
  if ne get buf 0 uchar 0x44
    ret 22
  end
  if ne get buf 3 uchar 0x11
    ret 23
  end
  if ne ksys_abi_decode_u32 part buf 0 4 u32_out KSYS_ABI_OK
    ret 24
  end
  if ne get u32_out 0 uint 0x11223344
    ret 25
  end
  if ne ksys_abi_encode_u64 ulong 0x0102030405060708 buf KSYS_ABI_OK
    ret 26
  end
  if ne get buf 0 uchar 8
    ret 27
  end
  if ne ksys_abi_decode_u64 part buf 0 8 u64_out KSYS_ABI_OK
    ret 28
  end
  if ne get u64_out 0 ulong 0x0102030405060708
    ret 29
  end
  note ResourceId golden and fail-closed
  r = new KsysResId KSYS_RES_CHANNEL uint 0xbeef
  if ne ksys_abi_encode_resid r buf KSYS_ABI_OK
    ret 30
  end
  if ne get buf 0 uchar 2
    ret 31
  end
  if ne get buf 4 uchar 0xef
    ret 32
  end
  if ne get buf 5 uchar 0xbe
    ret 33
  end
  r2 = new KsysResId ushort 0 uint 0
  if ne ksys_abi_decode_resid part buf 0 8 r2 KSYS_ABI_OK
    ret 34
  end
  if ne get r2 kind KSYS_RES_CHANNEL
    ret 35
  end
  if ne get r2 id uint 0xbeef
    ret 36
  end
  note Unknown kind 0, 6
  put buf 0 uchar 0
  if ne ksys_abi_decode_resid part buf 0 8 r2 KSYS_ABI_ERR_UNKNOWN_DISC
    ret 37
  end
  put buf 0 uchar 6
  if ne ksys_abi_decode_resid part buf 0 8 r2 KSYS_ABI_ERR_UNKNOWN_DISC
    ret 38
  end
  note Reserved non-zero
  put buf 0 uchar 1
  put buf 2 uchar 1
  if ne ksys_abi_decode_resid part buf 0 8 r2 KSYS_ABI_ERR_RESERVED_NZ
    ret 39
  end
  ret 0
end

fn t_abi_rights_cap_memreg_msg to int
  buf = new uchar 64 uchar 0
  r_out = new uint 1 uint 0
  rgt = or KSYS_RIGHT_READ or KSYS_RIGHT_WRITE KSYS_RIGHT_GRANT
  if ne ksys_abi_encode_rights rgt buf KSYS_ABI_OK
    ret 40
  end
  if ne get buf 0 uchar 0x0b
    ret 41
  end
  if ne ksys_abi_decode_rights part buf 0 4 r_out KSYS_ABI_OK
    ret 42
  end
  if ne get r_out 0 uint 0x0b
    ret 43
  end
  note Reserved bits 6..31 fail closed
  bit = uint 6
  while lt bit uint 32 bound 26
    ksys_put_u32 buf ulong 0 shl uint 1 bit
    if ne ksys_abi_decode_rights part buf 0 4 r_out KSYS_ABI_ERR_RESERVED_BITS
      ret 44
    end
    bit = add bit 1
  end
  note Capability golden and fail-closed
  cap = new KsysCap KSYS_RES_DEVICE uint 0x12345678 or KSYS_RIGHT_READ or KSYS_RIGHT_MAP KSYS_RIGHT_REVOKE
  if ne ksys_abi_encode_cap cap buf KSYS_ABI_OK
    ret 45
  end
  if ne get buf 8 uchar 0x25
    ret 46
  end
  cap2 = new KsysCap ushort 0 uint 0 uint 0
  if ne ksys_abi_decode_cap part buf 0 16 cap2 KSYS_ABI_OK
    ret 47
  end
  if ne get cap2 id uint 0x12345678
    ret 48
  end
  put buf 15 uchar 1
  if ne ksys_abi_decode_cap part buf 0 16 cap2 KSYS_ABI_ERR_RESERVED_NZ
    ret 49
  end
  put buf 15 uchar 0
  put buf 8 uchar 0x40
  if ne ksys_abi_decode_cap part buf 0 16 cap2 KSYS_ABI_ERR_RESERVED_BITS
    ret 50
  end
  note MemoryRegion golden and fail-closed
  mr = new KsysMemReg ulong 0x40000000 uint 16
  if ne ksys_abi_encode_memreg mr buf KSYS_ABI_OK
    ret 51
  end
  mr2 = new KsysMemReg ulong 0 uint 0
  if ne ksys_abi_decode_memreg part buf 0 16 mr2 KSYS_ABI_OK
    ret 52
  end
  if ne get mr2 base ulong 0x40000000
    ret 53
  end
  put buf 12 uchar 1
  if ne ksys_abi_decode_memreg part buf 0 16 mr2 KSYS_ABI_ERR_RESERVED_NZ
    ret 54
  end
  note Message golden and reserved bytes 4, 7, 44, 47
  msg = new KsysMsg uint 3 ulong 1 ulong 0x2222 ulong 0xffffffffffffffff ulong 0x80001000 uint 2 ulong 0x0a0b0c0d0e0f1011
  if ne ksys_abi_encode_msg msg buf KSYS_ABI_OK
    ret 55
  end
  msg2 = new KsysMsg uint 0 ulong 0 ulong 0 ulong 0 ulong 0 uint 0 ulong 0
  if ne ksys_abi_decode_msg part buf 0 56 msg2 KSYS_ABI_OK
    ret 56
  end
  if ne get msg2 obj ulong 0x0a0b0c0d0e0f1011
    ret 57
  end
  put buf 4 uchar 1
  if ne ksys_abi_decode_msg part buf 0 56 msg2 KSYS_ABI_ERR_RESERVED_NZ
    ret 58
  end
  put buf 4 uchar 0
  put buf 47 uchar 1
  if ne ksys_abi_decode_msg part buf 0 56 msg2 KSYS_ABI_ERR_RESERVED_NZ
    ret 59
  end
  ret 0
end

fn t_abi_envelope to int
  env = new uchar 24 uchar 0
  cap = new KsysCap KSYS_RES_CONSOLE uint 1 KSYS_RIGHT_WRITE
  if ne ksys_abi_env_write_hdr KSYS_TAG_CAPABILITY ulong 16 env KSYS_ABI_OK
    ret 60
  end
  if ne ksys_abi_encode_cap cap part env 8 16 KSYS_ABI_OK
    ret 61
  end
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_OK
    ret 62
  end
  note Unknown version
  put env 2 uchar 2
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_UNKNOWN_VER
    ret 63
  end
  put env 2 uchar 1
  note Unknown tag 0 and 11
  put env 0 uchar 0
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_UNKNOWN_TAG
    ret 64
  end
  put env 0 uchar 11
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_UNKNOWN_TAG
    ret 65
  end
  note Tag mismatch (valid tag ObjectId=3 != Capability=8)
  put env 0 uchar 3
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_TAG_MISMATCH
    ret 66
  end
  put env 0 uchar 8
  note Wrong length field
  put env 4 uchar 9
  if ne ksys_abi_env_check_hdr env KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_WRONG_LEN
    ret 67
  end
  put env 4 uchar 16
  note Truncated envelope
  if ne ksys_abi_env_check_hdr part env 0 7 KSYS_TAG_CAPABILITY ulong 16 KSYS_ABI_ERR_TRUNCATED
    ret 68
  end
  if ne ksys_abi_tag_size KSYS_TAG_MESSAGE ulong 56
    ret 69
  end
  ret 0
end

note =========================================================================
note Test 2: Task Runtime State Machine (denials, bounds, budgets, wrap)
note =========================================================================

fn t_task_runtime_denials_and_rw to int
  ksys_cap_reset
  ksys_grant_set ulong 0 KSYS_RES_OBJECT KSYS_SEED_OBJ_ID uchar 1
  ksys_grant_bounds ulong 0 uint 8 ulong 64 ulong 0 ulong 32
  h = new KsysHandle uint 0 uint 0
  if ne ksys_cap_insert uint 0 uchar 1 h KSYS_CAP_OK
    ret 70
  end
  raw_h = ksys_handle_to_raw h
  st = new KsysTaskState ulong 0 ulong 0 uint 0 ulong 0 uint 0 uint 0 uint 0 uint 0 uint 0 ulong 0 uint 0 ulong 0 uint 0 ulong 0
  ksys_task_init st ulong 1000 ulong 2000 uint 32 ulong 0
  req = new KsysSyscallReq ushort 0 KSYS_SYS_OBJ_READ raw_h ulong 0 ulong 0 ulong 1
  note Authorized READ
  ksys_task_syscall st req
  if ne get st act KSYS_ACT_RETURN
    ret 71
  end
  if ne get st act_val ulong 0xa1e05eed00000001
    ret 72
  end
  note WRITE through READ-only handle -> authority denial
  put req num KSYS_SYS_OBJ_WRITE
  put req a2 ulong 7
  ksys_task_syscall st req
  if ne get st act_val KSYS_SYSCALL_DENIED
    ret 73
  end
  if ne get st write_denials uint 1
    ret 74
  end
  if ne get st inv_denials uint 0
    ret 75
  end
  if ne get st obj 0 ulong 0xa1e05eed00000001
    ret 76
  end
  note Forged generation, never-issued slot, zero handle -> 3 invalid handle denials
  put req num KSYS_SYS_OBJ_READ
  put req a0 xor raw_h shl ulong 1 ulong 32
  ksys_task_syscall st req
  put req a0 or shl ulong 1 ulong 32 ulong 1
  ksys_task_syscall st req
  put req a0 ulong 0
  ksys_task_syscall st req
  if ne get st inv_denials uint 3
    ret 77
  end
  note Out of range offset 32 -> bounds denial
  put req a0 raw_h
  put req a1 ulong 32
  ksys_task_syscall st req
  if ne get st denials uint 5
    ret 78
  end
  if ne get st reads_ok uint 1
    ret 79
  end
  note Unaligned offset 12 and overflow offset u64::MAX - 3
  put req a1 ulong 12
  ksys_task_syscall st req
  put req a1 sub ulong 0xffffffffffffffff ulong 3
  ksys_task_syscall st req
  if ne get st denials uint 7
    ret 80
  end
  note Write with WRITE right updates kernel object copy
  h_rw = new KsysHandle uint 0 uint 0
  if ne ksys_cap_insert uint 0 uchar 3 h_rw KSYS_CAP_OK
    ret 81
  end
  ksys_grant_set ulong 0 KSYS_RES_OBJECT KSYS_SEED_OBJ_ID uchar 3
  put req num KSYS_SYS_OBJ_WRITE
  put req a0 ksys_handle_to_raw h_rw
  put req a1 ulong 24
  put req a2 ulong 0x77
  ksys_task_syscall st req
  if ne get st act_val ulong 0
    ret 82
  end
  if ne get st obj 3 ulong 0x77
    ret 83
  end
  note Revoked handle becomes stale
  if ne ksys_cap_remove h_rw KSYS_CAP_OK
    ret 84
  end
  put req num KSYS_SYS_OBJ_READ
  ksys_task_syscall st req
  if ne get st act_val KSYS_SYSCALL_DENIED
    ret 85
  end
  ret 0
end

fn t_task_runtime_budgets_and_wrap to int
  ksys_cap_reset
  ksys_grant_set ulong 0 KSYS_RES_OBJECT KSYS_SEED_OBJ_ID uchar 1
  ksys_grant_bounds ulong 0 uint 2 ulong 12 ulong 0 ulong 32
  h = new KsysHandle uint 0 uint 0
  if ne ksys_cap_insert uint 0 uchar 1 h KSYS_CAP_OK
    ret 86
  end
  raw_h = ksys_handle_to_raw h
  st = new KsysTaskState ulong 0 ulong 0 uint 0 ulong 0 uint 0 uint 0 uint 0 uint 0 uint 0 ulong 0 uint 0 ulong 0 uint 0 ulong 0
  ksys_task_init st ulong 1000 ulong 2000 uint 8 ulong 0
  req = new KsysSyscallReq ushort 0 KSYS_SYS_OBJ_READ raw_h ulong 0 ulong 0 ulong 10
  note Byte budget 12: first 8-byte read succeeds, second denied
  ksys_task_syscall st req
  if ne get st act_val ulong 0xa1e05eed00000001
    ret 87
  end
  put req a1 ulong 8
  ksys_task_syscall st req
  if ne get st act_val KSYS_SYSCALL_DENIED
    ret 88
  end
  if ne get ksys_task_ubytes 0 ulong 8
    ret 89
  end
  note Unknown syscall and non-zero immediate terminate
  put req num ulong 99
  ksys_task_syscall st req
  if ne get st act KSYS_ACT_TERMINATE
    ret 90
  end
  if ne get st st_code KSYS_STAT_BAD_SYSCALL
    ret 91
  end
  put req imm ushort 1
  put req num KSYS_SYS_EXIT
  ksys_task_syscall st req
  if ne get st st_code KSYS_STAT_BAD_SYSCALL
    ret 92
  end
  put req imm ushort 0
  put req a0 ulong 0x5a
  ksys_task_syscall st req
  if ne get st st_code KSYS_STAT_EXITED
    ret 93
  end
  if ne get st st_val ulong 0x5a
    ret 94
  end
  note Syscall budget overrun
  ksys_task_init st ulong 1000 ulong 2000 uint 2 ulong 0
  put req num KSYS_SYS_OBJ_READ
  put req a0 raw_h
  put req a1 ulong 0
  ksys_task_syscall st req
  ksys_task_syscall st req
  ksys_task_syscall st req
  if ne get st st_code KSYS_STAT_OVERRUN
    ret 95
  end
  note Timeout and counter wrap
  ksys_task_init st ulong 1000 ulong 2000 uint 8 ulong 500
  put req num KSYS_SYS_EXIT
  put req now ulong 1500
  ksys_task_syscall st req
  if ne get st st_code KSYS_STAT_TIMEOUT
    ret 96
  end
  ksys_task_init st ulong 1000 ulong 2000 uint 8 sub ulong 0xffffffffffffffff ulong 100
  if ksys_task_expired st ulong 898
    ret 97
  end
  if not ksys_task_expired st ulong 899
    ret 98
  end
  if ne ksys_task_elapsed_since sub ulong 0xffffffffffffffff ulong 1 ulong 1 ulong 3
    ret 99
  end
  ret 0
end

note =========================================================================
note Test 3: Thread Placement, Context, TrapFrame, User EL0 Attributes
note =========================================================================

fn t_thread_and_user to int
  cls = new uchar 8 uchar 0
  cnts = new uint 8 uint 0
  put cls 0 uchar 0
  put cls 1 uchar 1
  put cnts 0 uint 2
  put cnts 1 uint 2
  pl = new uint 2 uint 0
  if not ksys_place_task cls cnts uint 2 uint 0 pl
    ret 100
  end
  if ne get pl 0 uint 0
    ret 101
  end
  if not ksys_place_task cls cnts uint 2 uint 3 pl
    ret 102
  end
  if ne get pl 0 uint 1
    ret 103
  end
  if ne get pl 1 uint 1
    ret 104
  end
  if not ksys_place_task cls cnts uint 2 uint 4 pl
    ret 105
  end
  if ne get pl 0 uint 0
    ret 106
  end
  if ksys_place_task cls cnts uint 0 uint 0 pl
    ret 107
  end
  note Stack setup & TrapFrame setup
  ctx = new KsysCtx ulong 0 ulong 0 ulong 0 ulong 0
  if not ksys_prepare_ctx ulong 0x1003 ulong 257 ulong 0x400000 ulong 42 ctx
    ret 108
  end
  if ne rem get ctx sp ulong 16 ulong 0
    ret 109
  end
  if ne get ctx x19 ulong 42
    ret 110
  end
  if ne get ctx x20 ulong 0x400000
    ret 111
  end
  tf = new KsysTrapFrame ulong 0 ulong 0 ulong 0 ulong 0 ulong 0 ulong 0 ulong 0 ulong 0
  if not ksys_prepare_trap_frame ulong 0x2000 ulong 2048 ulong 0x500000 ulong 99 tf
    ret 112
  end
  if ne rem get tf sp_addr ulong 16 ulong 0
    ret 113
  end
  if ne get tf x0 ulong 99
    ret 114
  end
  if ne get tf spsr ulong 5
    ret 115
  end
  note EL0 mapping attributes W^X and non-global
  code_p = ksys_user_code_pte ulong 0x40000000
  stk_p = ksys_user_stack_pte ulong 0x40001000
  if ne and shr code_p ulong 6 ulong 3 ulong 3
    ret 116
  end
  if ne and code_p KSYS_PTE_UXN ulong 0
    ret 117
  end
  if ne and shr stk_p ulong 6 ulong 3 ulong 1
    ret 118
  end
  if eq and stk_p KSYS_PTE_UXN ulong 0
    ret 119
  end
  if eq and code_p KSYS_PTE_NG ulong 0
    ret 120
  end
  if ne ksys_user_bytes_offset ulong 0x10000 ulong 0x10010 ulong 16 long 16
    ret 121
  end
  if ne ksys_user_bytes_offset ulong 0x10000 ulong 0x10ff8 ulong 16 long -1
    ret 122
  end
  ret 0
end

note =========================================================================
note Test 4: GICv3, Timer (128-bit), Console (PL011), SpinLock
note =========================================================================

fn t_gic_timer_console_spin to int
  note GIC distributor SPI programming order
  glog = new KsysGicLog uint 0x80000000 uint 0 ulong 0 ulong 0
  ksys_gicd_configure_spi glog uint 40 uchar 0x80 ulong 0x1234
  if ne get glog cnt uint 4
    ret 123
  end
  if ne get glog offs 0 add KSYS_GICD_IGROUPR ulong 4
    ret 124
  end
  if ne get glog vals 0 ulong 0x80000100
    ret 125
  end
  if ne get glog offs 1 add KSYS_GICD_IPRIORITYR ulong 40
    ret 126
  end
  if ne get glog vals 1 ulong 0x80000080
    ret 127
  end
  if ne get glog offs 2 add KSYS_GICD_IROUTER ulong 320
    ret 128
  end
  if ne get glog vals 2 ulong 0x1234
    ret 129
  end
  if ne get glog offs 3 add KSYS_GICD_ISENABLER ulong 4
    ret 130
  end
  if ne get glog vals 3 ulong 0x100
    ret 131
  end
  note GIC redistributor wake & PPI
  rlog = new KsysGicLog uint 0 uint 0 ulong 0 ulong 0
  if not ksys_gicr_wake rlog uint 1
    ret 132
  end
  if not ksys_gicr_configure_ppi rlog uchar 27 uchar 0xa0
    ret 133
  end
  if ne get rlog vals 1 shl ulong 1 ulong 27
    ret 134
  end
  if ne get rlog offs 2 add KSYS_GICR_IPRIORITYR ulong 24
    ret 135
  end
  if ne get rlog vals 2 ulong 0xa0000000
    ret 136
  end
  note Timer 128-bit arithmetic
  res = new ulong 1 ulong 0
  if not ksys_ns_to_ticks ulong 1 ulong 1000000 res
    ret 137
  end
  if ne get res 0 ulong 1
    ret 138
  end
  if not ksys_ns_to_ticks ulong 1000 ulong 1000000 res
    ret 139
  end
  if ne get res 0 ulong 1
    ret 140
  end
  if not ksys_ticks_to_ns ulong 1000 ulong 1000000 res
    ret 141
  end
  if ne get res 0 ulong 1000000
    ret 142
  end
  if ksys_ns_to_ticks ulong 1 ulong 0 res
    ret 143
  end
  if not ksys_deadline_after ulong 50 ulong 10 ulong 1000000000 res
    ret 144
  end
  if ne get res 0 ulong 60
    ret 145
  end
  if ksys_deadline_after ulong 0xffffffffffffffff ulong 1 ulong 1000000000 res
    ret 146
  end
  if ksys_deadline_after ulong 0 ulong 0xffffffffffffffff ulong 0xffffffffffffffff res
    ret 147
  end
  note Console PL011 ready vs stuck
  con = new uint 10 uint 0
  if ksys_console_from_kind KSYS_UART_UNSUPPORTED con
    ret 148
  end
  if not ksys_console_from_kind KSYS_UART_PL011 con
    ret 149
  end
  a_str = new uchar 1 uchar 65
  ksys_console_write_str con a_str
  if ne get con 0 uint 65
    ret 150
  end
  if ne get con 9 uint 0
    ret 151
  end
  put con 0 uint 0
  put con 6 KSYS_PL011_TX_FULL
  ksys_console_write_str con a_str
  if eq get con 9 uint 0
    ret 152
  end
  if ne get con 0 uint 0
    ret 153
  end
  note SpinLock state model
  lk = new ulong 2 ulong 0
  ksys_spin_init lk ulong 42
  if not ksys_spin_try_lock lk
    ret 154
  end
  if ksys_spin_try_lock lk
    ret 155
  end
  put lk 1 add get lk 1 ulong 1
  ksys_spin_unlock lk
  if not ksys_spin_try_lock lk
    ret 156
  end
  if ne get lk 1 ulong 43
    ret 157
  end
  ksys_spin_unlock lk
  ret 0
end

note =========================================================================
note Test 5: Fatal / ESR, ReportBuf, Shell, PE32+
note =========================================================================

text t_pat_cls "fault_class: 0x25 (data abort at current EL)"
text t_pat_far "fault_far: 0xdead0000"
text t_sh_mem "mem"
text t_sh_unk_arg "unknown abc"
text t_sh_bad_tok "x 12345678901234567"
text t_sh_3tok "x a b"
text t_sh_el "el"
text t_sh_rep "report"
text t_sh_wat "wat"
text t_pat_el1 "EL1"
text t_pat_42 "42"
text t_pat_frep "final report"
text t_pat_uwat "unknown command: wat"

fn t_fatal_and_report to int
  note Fatal / ESR decoding
  fi = new ulong 6 ulong 0
  put fi 0 ulong 4
  put fi 1 ulong 2
  put fi 2 ulong 0x96000045
  put fi 3 ulong 0x80001000
  put fi 4 ulong 0xdead0000
  put fi 5 ulong 0x3c9
  if ne ksys_fault_kind get fi 0 uint 0
    ret 158
  end
  if ne ksys_fault_origin get fi 0 uint 1
    ret 159
  end
  if ne ksys_fault_ec get fi 2 uchar 0x25
    ret 160
  end
  fbuf = new uchar 256 uchar 0
  flen = ksys_format_fault fi fbuf
  if not ksys_bytes_contains part fbuf 0 flen t_pat_cls
    ret 161
  end
  if not ksys_bytes_contains part fbuf 0 flen t_pat_far
    ret 162
  end
  esr = new KsysEsrInfo uchar 0 uint 0 false false uchar 0 false false false false false false uchar 0 uchar 0 false
  ksys_decode_esr ulong 0x96000045 esr
  if not get esr has_abort
    ret 163
  end
  if ne get esr fsc uchar 5
    ret 164
  end
  if not get esr is_write
    ret 165
  end
  note Access syndrome only when ISV set: (0x25<<26)|(1<<24)|(3<<22)|(1<<21)|(7<<16)|7 = 0x95e70007
  ksys_decode_esr ulong 0x95e70007 esr
  if not get esr has_acc
    ret 166
  end
  if ne get esr acc_reg uchar 7
    ret 167
  end
  if ne get esr acc_sz uchar 3
    ret 168
  end
  if not get esr acc_sse
    ret 169
  end
  note (0x21<<26)|(1<<24)|0x0f = 0x8500000f
  ksys_decode_esr ulong 0x8500000f esr
  if get esr has_acc
    ret 170
  end
  ksys_decode_esr ulong 0x54000000 esr
  if get esr has_abort
    ret 171
  end
  note ReportBuf UTF-8 character-boundary truncation ("ab12" + "é€xyz" in cap 8 -> "ab12é", len 6)
  rbuf = new uchar 8 uchar 0
  tr = new uchar 1 uchar 0
  p1 = new uchar 4 uchar 0
  put p1 0 uchar 97
  put p1 1 uchar 98
  put p1 2 uchar 49
  put p1 3 uchar 50
  rlen = ksys_report_append rbuf ulong 0 p1 tr
  if ne rlen ulong 4
    ret 172
  end
  note "é" = c3 a9, "€" = e2 82 ac, "xyz" = 78 79 7a
  p2 = new uchar 8 uchar 0
  put p2 0 uchar 0xc3
  put p2 1 uchar 0xa9
  put p2 2 uchar 0xe2
  put p2 3 uchar 0x82
  put p2 4 uchar 0xac
  put p2 5 uchar 120
  put p2 6 uchar 121
  put p2 7 uchar 122
  rlen = ksys_report_append rbuf rlen p2 tr
  if ne get tr 0 uchar 1
    ret 173
  end
  if ne rlen ulong 6
    ret 174
  end
  if ne get rbuf 5 uchar 0xa9
    ret 175
  end
  ret 0
end

fn t_shell to int
  note Shell parsing & dispatch
  pl = new ulong 6 ulong 0
  if not ksys_shell_parse t_sh_mem pl
    ret 176
  end
  if ne uint get pl 0 KSYS_CMD_MEM
    ret 177
  end
  if not ksys_shell_parse t_sh_unk_arg pl
    ret 178
  end
  if eq get pl 3 ulong 0
    ret 179
  end
  if ne get pl 5 ulong 3
    ret 180
  end
  long_line = new uchar 65 uchar 120
  if ksys_shell_parse long_line pl
    ret 181
  end
  if ksys_shell_parse t_sh_bad_tok pl
    ret 182
  end
  if ksys_shell_parse t_sh_3tok pl
    ret 183
  end
  sctx = new ulong 4 ulong 0
  put sctx 0 ulong 42
  put sctx 1 ulong 1
  put sctx 2 ulong 7
  put sctx 3 ulong 13
  put ksys_shell_rep 0 uchar 102
  put ksys_shell_rep 1 uchar 105
  put ksys_shell_rep 2 uchar 110
  put ksys_shell_rep 3 uchar 97
  put ksys_shell_rep 4 uchar 108
  put ksys_shell_rep 5 uchar 32
  put ksys_shell_rep 6 uchar 114
  put ksys_shell_rep 7 uchar 101
  put ksys_shell_rep 8 uchar 112
  put ksys_shell_rep 9 uchar 111
  put ksys_shell_rep 10 uchar 114
  put ksys_shell_rep 11 uchar 116
  put ksys_shell_rep 12 uchar 10
  sout = new uchar 128 uchar 0
  sn = ksys_shell_dispatch t_sh_el sctx sout
  if not ksys_bytes_contains part sout 0 sn t_pat_el1
    ret 184
  end
  sn = ksys_shell_dispatch t_sh_mem sctx sout
  if not ksys_bytes_contains part sout 0 sn t_pat_42
    ret 185
  end
  sn = ksys_shell_dispatch t_sh_rep sctx sout
  if not ksys_bytes_contains part sout 0 sn t_pat_frep
    ret 186
  end
  sn = ksys_shell_dispatch t_sh_wat sctx sout
  if not ksys_bytes_contains part sout 0 sn t_pat_uwat
    ret 187
  end
  ret 0
end

fn t_pe_make_valid img edit uchar * to void
  i = ulong 0
  n = len img
  while lt i n bound 1024
    put img i uchar 0
    i = add i 1
  end
  put img 0 uchar 77
  put img 1 uchar 90
  ksys_put_u32 img ulong 0x3c uint 0x80
  put img 0x80 uchar 80
  put img 0x81 uchar 69
  ksys_put_u16 img ulong 0x84 KSYS_PE_ARM64
  ksys_put_u16 img ulong 0x86 ushort 2
  ksys_put_u16 img ulong 0x94 ushort 240
  ksys_put_u16 img ulong 0x98 KSYS_PE_OPT_PLUS
  t = ulong 0x188
  ksys_put_u32 img add t ulong 8 uint 0x1000
  ksys_put_u32 img add t ulong 12 uint 0x1000
  ksys_put_u32 img add t ulong 16 uint 0x800
  ksys_put_u32 img add t ulong 36 uint 0x60000020
  t2 = add t ulong 40
  ksys_put_u32 img add t2 ulong 8 uint 0x800
  ksys_put_u32 img add t2 ulong 12 uint 0x2000
  ksys_put_u32 img add t2 ulong 16 uint 0x1000
  ksys_put_u32 img add t2 ulong 36 uint 0xc0000040
  ret
end

fn t_pe_sections to int
  img = new uchar 512 uchar 0
  tbl = new KsysPeTable uint 0 ulong 0 ulong 0 uint 0
  t_pe_make_valid img
  if ne ksys_pe_parse_sections img ulong 0x400000 tbl KSYS_PE_OK
    ret 188
  end
  if ne get tbl cnt uint 2
    ret 189
  end
  if ne get tbl va 0 ulong 0x401000
    ret 190
  end
  if ne get tbl sz 0 ulong 4096
    ret 191
  end
  if ne get tbl sz 1 ulong 4096
    ret 192
  end
  note Truncation & invalid headers
  if ne ksys_pe_parse_sections part img 0 10 ulong 0 tbl KSYS_PE_ERR_TRUNC
    ret 193
  end
  if ne ksys_pe_parse_sections part img 0 0x1b0 ulong 0 tbl KSYS_PE_ERR_TRUNC
    ret 194
  end
  put img 0 uchar 0
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_DOS
    ret 195
  end
  t_pe_make_valid img
  put img 0x80 uchar 0
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_SIG
    ret 196
  end
  t_pe_make_valid img
  put img 0x84 uchar 0
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_MACH
    ret 197
  end
  t_pe_make_valid img
  put img 0x98 uchar 0
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_OPT
    ret 198
  end
  note W+X and overlap
  t_pe_make_valid img
  ksys_put_u32 img add ulong 0x188 ulong 36 uint 0xa0000000
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_WX
    ret 199
  end
  t_pe_make_valid img
  ksys_put_u32 img add ulong 0x1b0 ulong 12 uint 0x1800
  if ne ksys_pe_parse_sections img ulong 0 tbl KSYS_PE_ERR_OVERLAP
    ret 200
  end
  note Unaligned page rounding & shared page overlap
  t_pe_make_valid img
  ksys_put_u16 img ulong 0x86 ushort 1
  ksys_put_u32 img add ulong 0x188 ulong 8 uint 1
  ksys_put_u32 img add ulong 0x188 ulong 12 uint 0x1001
  ksys_put_u32 img add ulong 0x188 ulong 16 uint 0
  ksys_put_u32 img add ulong 0x188 ulong 36 uint 0x40000040
  if ne ksys_pe_parse_sections img ulong 0x40000000 tbl KSYS_PE_OK
    ret 201
  end
  if ne get tbl va 0 ulong 0x40001000
    ret 202
  end
  if ne get tbl sz 0 ulong 0x1000
    ret 203
  end
  ksys_put_u16 img ulong 0x86 ushort 2
  ksys_put_u32 img add ulong 0x1b0 ulong 8 uint 0x100
  ksys_put_u32 img add ulong 0x1b0 ulong 12 uint 0x1800
  ksys_put_u32 img add ulong 0x1b0 ulong 16 uint 0
  ksys_put_u32 img add ulong 0x1b0 ulong 36 uint 0x60000020
  if ne ksys_pe_parse_sections img ulong 0x40000000 tbl KSYS_PE_ERR_OVERLAP
    ret 204
  end
  ret 0
end

note =========================================================================
note Test 6: Kernel Infer — GEMM, RMSNorm, Softmax, SiLU, RoPE
note =========================================================================

fn t_infer_gemm to int
  note Softmax sums to 1
  sm = new f32 3 0.0f32
  put sm 0 1000.0f32
  put sm 1 1001.0f32
  put sm 2 999.0f32
  if ne ksys_softmax sm KSYS_KERN_OK
    ret 205
  end
  tot = add get sm 0 add get sm 1 get sm 2
  if ge fabs sub tot 1.0f32 1.0e-5f32
    ret 206
  end
  note RMSNorm hand value: x=[3,4], w=[1,2], eps=1 -> d=sqrt(13.5)
  rx = new f32 2 0.0f32
  rw = new f32 2 0.0f32
  put rx 0 3.0f32
  put rx 1 4.0f32
  put rw 0 1.0f32
  put rw 1 2.0f32
  if ne ksys_rms_norm rx rw 1.0f32 KSYS_KERN_OK
    ret 207
  end
  d = fsqrt 13.5f32
  if ge fabs sub get rx 0 div 3.0f32 d 1.0e-5f32
    ret 208
  end
  if ge fabs sub get rx 1 div 8.0f32 d 1.0e-5f32
    ret 209
  end
  note Strided matvec matches reference
  mat = new f32 16 1.0f32
  vec = new f32 8 0.0f32
  put vec 0 1.0f32
  put vec 2 1.0f32
  put vec 4 1.0f32
  put vec 6 1.0f32
  mout = new f32 1 0.0f32
  ksys_gemm_set_matvec ulong 1 ulong 4 ulong 16 ulong 2 ulong 1
  if ne ksys_matvec mat vec mout KSYS_KERN_OK
    ret 210
  end
  if ne get mout 0 4.0f32
    ret 211
  end
  note Matmul 2x2 check
  ma = new f32 4 0.0f32
  mb = new f32 4 0.0f32
  mc = new f32 4 0.0f32
  put ma 0 1.0f32
  put ma 1 2.0f32
  put ma 2 3.0f32
  put ma 3 4.0f32
  put mb 0 5.0f32
  put mb 1 6.0f32
  put mb 2 7.0f32
  put mb 3 8.0f32
  ksys_gemm_set_matmul ulong 2 ulong 2 ulong 2 ulong 2 ulong 2 ulong 2
  if ne ksys_matmul ma mb mc KSYS_KERN_OK
    ret 212
  end
  if ne get mc 0 19.0f32
    ret 213
  end
  if ne get mc 3 50.0f32
    ret 214
  end
  note SiLU(0) = 0
  sx = new f32 1 0.0f32
  ksys_silu sx
  if ge fabs get sx 0 1.0e-6f32
    ret 215
  end
  ret 0
end

fn t_infer_rope to int
  note RoPE position 0 is identity and pos 2 preserves pair norms
  cos_t = new f32 6 0.0f32
  sin_t = new f32 6 0.0f32
  ksys_rope_set_dims ulong 4 ulong 3 ulong 0
  if ne ksys_rope_precompute 500000.0f32 cos_t sin_t KSYS_KERN_OK
    ret 216
  end
  rq = new f32 4 0.0f32
  put rq 0 1.0f32
  put rq 1 2.0f32
  put rq 2 3.0f32
  put rq 3 4.0f32
  if ne ksys_rope_rotate rq cos_t sin_t KSYS_KERN_OK
    ret 217
  end
  if ne get rq 0 1.0f32
    ret 218
  end
  if ne get rq 3 4.0f32
    ret 219
  end
  put rq 0 3.0f32
  put rq 1 4.0f32
  put rq 2 5.0f32
  put rq 3 12.0f32
  ksys_rope_set_dims ulong 4 ulong 3 ulong 2
  if ne ksys_rope_rotate rq cos_t sin_t KSYS_KERN_OK
    ret 220
  end
  n0 = add mul get rq 0 get rq 0 mul get rq 1 get rq 1
  n1 = add mul get rq 2 get rq 2 mul get rq 3 get rq 3
  if ge fabs sub n0 25.0f32 1.0e-3f32
    ret 221
  end
  if ge fabs sub n1 169.0f32 1.0e-3f32
    ret 222
  end
  note sin_cos_approx(3.0) matches reference sin(3.0)=0.1411200, cos(3.0)=-0.9899925
  sc = new f32 2 0.0f32
  ksys_sin_cos_approx 3.0f32 sc
  if ge fabs sub get sc 0 0.1411200f32 2.0e-5f32
    ret 223
  end
  if ge fabs sub get sc 1 -0.9899925f32 2.0e-5f32
    ret 224
  end
  ret 0
end

note =========================================================================
note Test 7: Kernel Infer — KV Cache & Grouped-Query Attention
note =========================================================================

fn t_infer_attn_one to int
  note One token returns value exactly
  ck = new f32 8 0.0f32
  cv = new f32 8 0.0f32
  meta = new ulong 4 ulong 0
  put meta 0 ulong 1
  put meta 1 ulong 1
  put meta 2 ulong 2
  if ne ksys_kv_init part ck 0 2 part cv 0 2 meta KSYS_KERN_OK
    ret 225
  end
  k1 = new f32 2 0.0f32
  v1 = new f32 2 0.0f32
  put k1 0 1.0f32
  put k1 1 2.0f32
  put v1 0 7.0f32
  put v1 1 -3.0f32
  if ne ksys_kv_append_k part ck 0 2 k1 meta KSYS_KERN_OK
    ret 226
  end
  if ne ksys_kv_append_v part cv 0 2 v1 meta KSYS_KERN_OK
    ret 227
  end
  note Append rejects capacity overflow
  if ne ksys_kv_append_k part ck 0 2 k1 meta KSYS_KERN_ERR_SHAPE
    ret 228
  end
  q = new f32 2 0.0f32
  put q 0 0.5f32
  put q 1 1.0f32
  aout = new f32 2 0.0f32
  sc = new f32 4 0.0f32
  if ne ksys_attn_validate ulong 2 ulong 2 ulong 1 ulong 1 ulong 0 meta KSYS_KERN_OK
    ret 229
  end
  ksys_attn_set_head ulong 0 ulong 0 ulong 2 ulong 1 ulong 1
  if ne ksys_attn_score_head q part ck 0 2 part sc 0 1 KSYS_KERN_OK
    ret 230
  end
  ksys_attn_accum_head part sc 0 1 part cv 0 2 aout
  if ne get aout 0 7.0f32
    ret 231
  end
  if ne get aout 1 -3.0f32
    ret 232
  end
  ret 0
end

fn t_infer_attn_gqa_run ck view f32 * cv view f32 * to int
  q = new f32 8 0.0f32
  aout = new f32 8 0.0f32
  sc = new f32 4 0.0f32
  h = ulong 0
  while lt h ulong 4 bound 4
    ksys_attn_set_head h div h ulong 2 ulong 2 ulong 2 ulong 1
    if ne ksys_attn_score_head q ck part sc 0 1 KSYS_KERN_OK
      ret 238
    end
    ksys_attn_accum_head part sc 0 1 cv aout
    h = add h 1
  end
  if ne get aout 0 3.0f32
    ret 239
  end
  if ne get aout 3 4.0f32
    ret 240
  end
  if ne get aout 4 9.0f32
    ret 241
  end
  if ne get aout 7 10.0f32
    ret 242
  end
  ret 0
end

fn t_infer_attn_gqa to int
  note GQA maps 4 query heads to 2 KV heads (groups of 2)
  ck = new f32 8 0.0f32
  cv = new f32 8 0.0f32
  meta = new ulong 4 ulong 0
  put meta 0 ulong 1
  put meta 1 ulong 2
  put meta 2 ulong 2
  if ne ksys_kv_init part ck 0 4 part cv 0 4 meta KSYS_KERN_OK
    ret 233
  end
  k4 = new f32 4 0.0f32
  v4 = new f32 4 0.0f32
  put v4 0 3.0f32
  put v4 1 4.0f32
  put v4 2 9.0f32
  put v4 3 10.0f32
  if ne ksys_kv_append_k part ck 0 4 k4 meta KSYS_KERN_OK
    ret 234
  end
  if ne ksys_kv_append_v part cv 0 4 v4 meta KSYS_KERN_OK
    ret 235
  end
  note Invalid head count 5 over 2 KV heads -> ERR_PARAM
  if ne ksys_attn_validate ulong 10 ulong 10 ulong 1 ulong 5 ulong 0 meta KSYS_KERN_ERR_PARAM
    ret 236
  end
  note Position past appended tokens -> ERR_SHAPE
  if ne ksys_attn_validate ulong 8 ulong 8 ulong 2 ulong 4 ulong 1 meta KSYS_KERN_ERR_SHAPE
    ret 237
  end
  ret t_infer_attn_gqa_run part ck 0 4 part cv 0 4
end

note =========================================================================
note Test 8: Kernel Infer — Byte-Level BPE Tokenizer
note =========================================================================

text t_tok_extra "T 300 6869\nT 301 686920\nT 302 6869207468657265\nT 303 7468\nT 304 746865\nT 305 74686572\nT 306 7468657265\nS 400 3c7c626f737c3e\nS 401 3c7c656f737c3e\nM 104 105\nM 116 104\nM 303 101\nM 304 114\nM 305 101\nM 300 32\nM 301 306\n"
text t_tok_hi "hi"
text t_tok_hi_there "hi there"
text t_tok_spec "<|bos|>hi<|eos|>"
text t_tok_q "?"
text t_tok_bad_hex "T 1 0"
text t_tok_only_a "T 1 61"
text t_tok_b "b"

fn t_tok_load_tiny to uint
  ksys_tok_reset
  hx = new uchar 2 uchar 0
  b = uint 0
  while lt b uint 256 bound 256
    hi = shr b uint 4
    lo = and b uint 15
    if lt hi uint 10
      put hx 0 uchar add hi uint 48
    else
      put hx 0 uchar add sub hi uint 10 uint 97
    end
    if lt lo uint 10
      put hx 1 uchar add lo uint 48
    else
      put hx 1 uchar add sub lo uint 10 uint 97
    end
    e = ksys_tok_add_record false b hx
    if ne e KSYS_TOK_OK
      ret e
    end
    b = add b 1
  end
  n = len t_tok_extra
  pos = ulong 0
  while lt pos n bound 128
    st = pos
    while lt pos n bound 64
      if eq get t_tok_extra pos uchar 10
        break
      end
      pos = add pos 1
    end
    e = ksys_tok_parse_line part t_tok_extra st sub pos st
    if ne e KSYS_TOK_OK
      ret e
    end
    if lt pos n
      pos = add pos 1
    end
  end
  ret ksys_tok_finalize
end

fn t_infer_tokenizer to int
  if ne t_tok_load_tiny KSYS_TOK_OK
    ret 243
  end
  ids = new uint 32 uint 0
  cnt = new uint 1 uint 0
  dec = new uchar 64 uchar 0
  dlen = new ulong 1 ulong 0
  note Lowest-ranked merge first: "hi" -> [300], "hi there" -> [302]
  if ne ksys_tok_encode t_tok_hi ids cnt KSYS_TOK_OK
    ret 244
  end
  if ne get cnt 0 uint 1
    ret 245
  end
  if ne get ids 0 uint 300
    ret 246
  end
  if ne ksys_tok_encode t_tok_hi_there ids cnt KSYS_TOK_OK
    ret 247
  end
  if ne get cnt 0 uint 1
    ret 248
  end
  if ne get ids 0 uint 302
    ret 249
  end
  note Special tokens before BPE: "<|bos|>hi<|eos|>" -> [400, 300, 401]
  if ne ksys_tok_encode t_tok_spec ids cnt KSYS_TOK_OK
    ret 250
  end
  if ne get cnt 0 uint 3
    ret 251
  end
  if or ne get ids 0 uint 400 or ne get ids 1 uint 300 ne get ids 2 uint 401
    ret 252
  end
  if ne ksys_tok_decode part ids 0 3 dec dlen KSYS_TOK_OK
    ret 253
  end
  if not ksys_bytes_eq part dec 0 get dlen 0 t_tok_spec
    ret 254
  end
  note Byte fallback "?" -> [63] and error cases: invalid hex and missing byte
  if or ne ksys_tok_encode t_tok_q ids cnt KSYS_TOK_OK ne get ids 0 uint 63
    ret 255
  end
  if ne ksys_tok_from_text t_tok_bad_hex KSYS_TOK_ERR_HEX
    ret 255
  end
  if ne ksys_tok_from_text t_tok_only_a KSYS_TOK_OK
    ret 255
  end
  if ne ksys_tok_encode t_tok_b ids cnt KSYS_TOK_ERR_MISS_BYTE
    ret 255
  end
  ret 0
end

note =========================================================================
note Entry point
note =========================================================================

fn main to int
  r = t_abi_handle
  if ne r 0
    ret r
  end
  r = t_abi_ids_and_resid
  if ne r 0
    ret r
  end
  r = t_abi_rights_cap_memreg_msg
  if ne r 0
    ret r
  end
  r = t_abi_envelope
  if ne r 0
    ret r
  end
  r = t_task_runtime_denials_and_rw
  if ne r 0
    ret r
  end
  r = t_task_runtime_budgets_and_wrap
  if ne r 0
    ret r
  end
  r = t_thread_and_user
  if ne r 0
    ret r
  end
  r = t_gic_timer_console_spin
  if ne r 0
    ret r
  end
  r = t_fatal_and_report
  if ne r 0
    ret r
  end
  r = t_shell
  if ne r 0
    ret r
  end
  r = t_pe_sections
  if ne r 0
    ret r
  end
  r = t_infer_gemm
  if ne r 0
    ret r
  end
  r = t_infer_rope
  if ne r 0
    ret r
  end
  r = t_infer_attn_one
  if ne r 0
    ret r
  end
  r = t_infer_attn_gqa
  if ne r 0
    ret r
  end
  r = t_infer_tokenizer
  if ne r 0
    ret r
  end
  ret 0
end

note =========================================================================
note 0. Common byte, endian, comparison, and SHA-256 helpers
note =========================================================================

fn ksc_get_u16le b view uchar * off ulong to ulong
x = ulong get b off
y = ulong get b add off 1
ret or x shl y 8
end

fn ksc_get_u32le b view uchar * off ulong to ulong
x = ulong 0
for i ulong 4 unroll
x = or x shl ulong get b add off i mul i 8
end
ret x
end

fn ksc_get_u64le b view uchar * off ulong to ulong
x = ulong 0
for i ulong 8 unroll
x = or x shl ulong get b add off i mul i 8
end
ret x
end

fn ksc_get_u32be b view uchar * off ulong to ulong
x = ulong 0
for i ulong 4 unroll
x = or shl x 8 ulong get b add off i
end
ret x
end

fn ksc_put_u16le b edit uchar * off ulong v ulong to void
put b off uchar and v 0xff
put b add off 1 uchar and shr v 8 0xff
end

fn ksc_put_u32le b edit uchar * off ulong v ulong to void
for i ulong 4 unroll
put b add off i uchar and shr v mul i 8 0xff
end
end

fn ksc_put_u64le b edit uchar * off ulong v ulong to void
for i ulong 8 unroll
put b add off i uchar and shr v mul i 8 0xff
end
end

fn ksc_put_u32be b edit uchar * off ulong v ulong to void
for i ulong 4 unroll
put b add off i uchar and shr v sub 24 mul i 8 0xff
end
end

fn ksc_put_u64be b edit uchar * off ulong v ulong to void
for i ulong 8 unroll
put b add off i uchar and shr v sub 56 mul i 8 0xff
end
end

fn ksc_zeroize b edit uchar * to void
n = len b
for i ulong n bound 1048576
put b i uchar 0
end
end

fn ksc_copy dst edit uchar * src view uchar * to void
n = len src
for i ulong n bound 1048576
put dst i get src i
end
end

fn ksc_ct_eq a view uchar * b view uchar * to bool
la = len a
lb = len b
diff = xor la lb
m = la
if gt lb m
m = lb
end
for i ulong m bound 1048576
xa = ulong 0
xb = ulong 0
if lt i la
xa = ulong get a i
end
if lt i lb
xb = ulong get b i
end
diff = or diff xor xa xb
end
ret eq diff 0
end

fn ksc_is_zero b view uchar * to bool
n = len b
acc = ulong 0
for i ulong n bound 1048576
acc = or acc ulong get b i
end
ret eq acc 0
end

fn ksc_cmp_lex a view uchar * b view uchar * to int
n = len a
for i ulong n bound 1048576
va = ulong get a i
vb = ulong get b i
if lt va vb
ret int -1
end
if gt va vb
ret int 1
end
end
ret int 0
end

fn ksc_sha256 msg view uchar * digest edit uchar 32 to void
r = sha2_digest ulong 256 msg digest
if eq r 0
trap 8
end
end

note =========================================================================
note 1. Kernel Crypto: HMAC-SHA256, HKDF-SHA256, and M5 Streaming Envelope
note =========================================================================

fn ksc_hmac_pack_opad hctx edit ulong 48 opad view uchar 64 to void
for w ulong 8 unroll
v = ulong 0
for j ulong 8 unroll
v = or v shl ulong get opad add mul w 8 j mul j 8
end
put hctx add 40 w v
end
end

fn ksc_hmac_unpack_opad hctx view ulong 48 opad edit uchar 64 to void
for w ulong 8 unroll
v = get hctx add 40 w
for j ulong 8 unroll
put opad add mul w 8 j uchar and shr v mul j 8 0xff
end
end
end

fn ksc_hmac_init hctx edit ulong 48 key view uchar * to void
kb = new uchar 64 0
ipad = new uchar 64 0x36
opad = new uchar 64 0x5c
kd = new uchar 32 0
kl = len key
if gt kl 64
ksc_sha256 key kd
ksc_copy part kb 0 32 kd
ksc_zeroize kd
else
if gt kl 0
ksc_copy part kb 0 kl key
end
end
for i ulong 64 unroll
kbi = ulong get kb i
put ipad i uchar xor ulong 0x36 kbi
put opad i uchar xor ulong 0x5c kbi
end
ksc_zeroize kb
sha256_init part hctx 0 40
sha256_update part hctx 0 40 ipad
ksc_zeroize ipad
ksc_hmac_pack_opad hctx opad
ksc_zeroize opad
end

fn ksc_hmac_update hctx edit ulong 48 msg view uchar * to void
if gt len msg 0
sha256_update part hctx 0 40 msg
end
end

fn ksc_hmac_final hctx edit ulong 48 tag edit uchar * to void
idig = new uchar 32 0
opad = new uchar 64 0
octx = new ulong 40 0
sha256_final part hctx 0 40 idig
ksc_hmac_unpack_opad hctx opad
sha256_init octx
sha256_update octx opad
sha256_update octx idig
sha256_final octx tag
ksc_zeroize idig
ksc_zeroize opad
for i ulong 48 unroll
put hctx i ulong 0
end
end

fn ksc_hmac_sha256 key view uchar * msg view uchar * tag edit uchar 32 to void
hctx = new ulong 48 0
ksc_hmac_init hctx key
ksc_hmac_update hctx msg
ksc_hmac_final hctx tag
end

fn ksc_hkdf_extract salt view uchar * ikm view uchar * prk edit uchar 32 to void
ksc_hmac_sha256 salt ikm prk
end

fn ksc_hkdf_expand prk view uchar * info view uchar * okm edit uchar * to ulong
prev = new uchar 33 0
hctx = new ulong 48 0
if gt len okm 8160
ret KSC_HKDF_ERR_TOO_LONG
end
written = ulong 0
c = ulong 0
while lt written len okm bound 256
c = add c 1
put prev 32 uchar and c 0xff
ksc_hmac_init hctx prk
if gt c 1
ksc_hmac_update hctx part prev 0 32
end
ksc_hmac_update hctx info
ksc_hmac_update hctx part prev 32 1
ksc_hmac_final hctx part prev 0 32
take = sub len okm written
if gt take 32
take = 32
end
for j ulong take bound 32
put okm add written j get prev j
end
written = add written take
end
ksc_zeroize prev
ret KSC_HKDF_OK
end

note M5 Authenticated Streaming Envelope (crypto/envelope.rs)

fn ksc_env_expected_len chunk_size ulong total_pt ulong res edit ulong * to ulong
if eq chunk_size 0
ret KSC_ENV_ERR_CHUNK
end
chunks = ulong 1
if gt total_pt 0
q = div total_pt chunk_size
r = rem total_pt chunk_size
chunks = q
if gt r 0
if eq chunks 0xffffffffffffffff
ret KSC_ENV_ERR_OVERFLOW
end
chunks = add chunks 1
end
end
if gt chunks div 0xffffffffffffffff KSC_ENV_TAG_LEN
ret KSC_ENV_ERR_OVERFLOW
end
tags = mul chunks KSC_ENV_TAG_LEN
if gt tags sub 0xffffffffffffffff total_pt
ret KSC_ENV_ERR_OVERFLOW
end
body = add tags total_pt
if gt body sub 0xffffffffffffffff KSC_ENV_HDR_LEN
ret KSC_ENV_ERR_OVERFLOW
end
put res 0 add body KSC_ENV_HDR_LEN
ret KSC_ENV_OK
end

note Decode and validate 64-byte envelope header.
note meta[0]=chunk_size, [1]=total_pt, [2]=key_epoch, [3]=chunk_count, [4]=expected_len
fn ksc_env_hdr_decode buf view uchar * meta edit ulong 8 to ulong
exp = new ulong 1 0
if lt len buf KSC_ENV_HDR_LEN
ret KSC_ENV_ERR_SHORT
end
if not ksc_ct_eq part buf 0 8 KSC_TXT_ENV_MAGIC
ret KSC_ENV_ERR_MAGIC
end
ver = ksc_get_u16le buf 8
if ne ver KSC_ENV_VERSION
ret KSC_ENV_ERR_VER
end
suite = ksc_get_u16le buf 10
if ne suite KSC_ENV_SUITE_GCMSIV
ret KSC_ENV_ERR_SUITE
end
flags = ksc_get_u32le buf 12
if ne flags 0
ret KSC_ENV_ERR_FLAGS
end
cs = ksc_get_u32le buf 16
if eq cs 0
ret KSC_ENV_ERR_CHUNK
end
if gt cs KSC_ENV_DEFAULT_CHUNK
ret KSC_ENV_ERR_CHUNK
end
rsvd = ksc_get_u32le buf 60
if ne rsvd 0
ret KSC_ENV_ERR_RSVD
end
tpt = ksc_get_u64le buf 20
ep = ksc_get_u64le buf 52
chunks = ulong 1
if gt tpt 0
chunks = div add tpt sub cs 1 cs
end
put meta 0 cs
put meta 1 tpt
put meta 2 ep
put meta 3 chunks
rc = ksc_env_expected_len cs tpt exp
if ne rc KSC_ENV_OK
put meta 4 ulong 0
else
put meta 4 get exp 0
end
ret KSC_ENV_OK
end

fn ksc_env_derive_nonce prefix view uchar * chunk_idx ulong nonce edit uchar * to void
ksc_copy part nonce 0 8 prefix
ksc_put_u32le nonce 8 chunk_idx
end

note meta[0]=object_kind, [1]=object_version, [2]=chunk_index, [3]=chunk_pt_len
fn ksc_env_compute_aad suuid view uchar * hdr view uchar * meta view ulong 8 aad edit uchar 111 to void
ksc_copy part aad 0 18 KSC_TXT_CHUNK_AAD
put aad 18 uchar 0
ksc_copy part aad 19 16 suuid
ksc_put_u16le aad 35 get meta 0
ksc_put_u16le aad 37 get meta 1
ksc_copy part aad 39 64 hdr
ksc_put_u32le aad 103 get meta 2
ksc_put_u32le aad 107 get meta 3
end

note Seal one chunk in place: cbuf has clen plaintext bytes followed by 16 tag bytes.
note cmeta: [kind, version, cidx, clen, ...]
fn ksc_env_seal_chunk params view uchar 72 hdr view uchar 64 cmeta view ulong 8 cbuf edit uchar * to ulong
kn = new uchar 44 0
aad = new uchar 111 0
ksc_copy part kn 0 32 part params 0 32
ksc_env_derive_nonce part params 64 8 get cmeta 2 part kn 32 12
ksc_env_compute_aad part params 32 16 hdr cmeta aad
rc = aes_gcmsiv_seal kn aad cbuf
ksc_zeroize kn
ret rc
end

fn ksc_env_prep_open phdr view uchar 112 cmeta view ulong 8 kn edit uchar 44 aad edit uchar 111 to void
for i ulong 32 unroll
put kn i get phdr i
end
for i ulong 8 unroll
put kn add 32 i get phdr add 92 i
end
ksc_put_u32le kn 40 get cmeta 2
ksc_copy part aad 0 18 KSC_TXT_CHUNK_AAD
put aad 18 uchar 0
for i ulong 16 unroll
put aad add 19 i get phdr add 32 i
end
ksc_put_u16le aad 35 get cmeta 0
ksc_put_u16le aad 37 get cmeta 1
for i ulong 64 unroll
put aad add 39 i get phdr add 48 i
end
ksc_put_u32le aad 103 get cmeta 2
ksc_put_u32le aad 107 get cmeta 3
end

fn ksc_copy_from_off dst edit uchar * src view uchar * soff ulong n ulong to void
for i ulong n bound 65552
put dst i get src add soff i
end
end

fn ksc_copy_to_off dst edit uchar * doff ulong src view uchar * n ulong to void
for i ulong n bound 65552
put dst add doff i get src i
end
end

note Open one chunk from env[epos..epos+clen+16) into pt_dst[ppos..ppos+clen).
note st: [kind, version, cidx, clen, chunk_size, epos, ppos, tpt]
fn ksc_env_open_chunk phdr view uchar 112 st view ulong 8 env view uchar * pt_dst edit uchar * to ulong
kn = new uchar 44 0
aad = new uchar 111 0
ctmp = new uchar 65552 0
ksc_env_prep_open phdr st kn aad
ctlen = add get st 3 16
ksc_copy_from_off ctmp env get st 5 ctlen
rc = aes_gcmsiv_open kn aad part ctmp 0 ctlen
ksc_zeroize kn
if ne rc 0
ksc_zeroize part ctmp 0 ctlen
ret KSC_ENV_ERR_AUTH
end
if gt get st 3 0
ksc_copy_to_off pt_dst get st 6 ctmp get st 3
end
ksc_zeroize part ctmp 0 ctlen
ret KSC_ENV_OK
end

fn ksc_env_build_hdr params view uchar 72 meta view ulong 4 cs ulong ptlen ulong hdr edit uchar 64 to void
ksc_copy part hdr 0 8 KSC_TXT_ENV_MAGIC
ksc_put_u16le hdr 8 KSC_ENV_VERSION
ksc_put_u16le hdr 10 KSC_ENV_SUITE_GCMSIV
ksc_put_u32le hdr 12 0
ksc_put_u32le hdr 16 cs
ksc_put_u64le hdr 20 ptlen
for i ulong 16 unroll
put hdr add 28 i get params add 48 i
end
for i ulong 8 unroll
put hdr add 44 i get params add 64 i
end
ksc_put_u64le hdr 52 get meta 2
ksc_put_u32le hdr 60 0
end

note Encrypt plaintext into envelope buffer dst.
note params: key32[0..32) || suuid[32..48) || env_id[48..64) || nonce_prefix[64..72) = 72 bytes.
note meta[0]=kind, [1]=version, [2]=key_epoch, [3]=chunk_size (0 => 65536).
note Returns total envelope length in dst, or 0 on error.
fn ksc_env_copy_chunk dst edit uchar * pt view uchar * st view ulong 8 to void
doff = get st 6
soff = get st 5
n = get st 3
for j ulong n bound 65536
put dst add doff j get pt add soff j
end
end

fn ksc_env_encrypt params view uchar 72 meta view ulong 4 pt view uchar * dst edit uchar * to ulong
hdr = new uchar 64 0
st = new ulong 8 0
cs = get meta 3
if eq cs 0
cs = KSC_ENV_DEFAULT_CHUNK
end
if gt cs KSC_ENV_DEFAULT_CHUNK
ret 0
end
if gt len pt KSC_ENV_MAX_PT
ret 0
end
if ne ksc_env_expected_len cs len pt part st 7 1 KSC_ENV_OK
ret 0
end
if lt len dst get st 7
ret 0
end
ksc_env_build_hdr params meta cs len pt hdr
for i ulong 64 unroll
put dst i get hdr i
end
put st 0 get meta 0
put st 1 get meta 1
put st 4 cs
put st 5 0
put st 6 64
if eq len pt 0
put st 2 0
put st 3 0
if ne ksc_env_seal_chunk params hdr st part dst 64 16 0
ret 0
end
ret 80
end
while lt get st 5 len pt bound 1048576
clen = sub len pt get st 5
if gt clen get st 4
clen = get st 4
end
put st 3 clen
ksc_env_copy_chunk dst pt st
if ne ksc_env_seal_chunk params hdr st part dst get st 6 add clen 16 0
ret 0
end
put st 5 add get st 5 clen
put st 6 add get st 6 add clen 16
put st 2 add get st 2 1
end
ret get st 6
end

note Decrypt envelope env into pt_dst.
note params: key32[0..32) || suuid[32..48) = 48 bytes.
note meta[0]=kind, [1]=version; writes meta[2]=pt_len on success.
fn ksc_env_decrypt params view uchar 48 meta edit ulong 4 env view uchar * pt_dst edit uchar * to ulong
st = new ulong 8 0
phdr = new uchar 112 0
rc = ksc_env_hdr_decode env st
if ne rc KSC_ENV_OK
ret rc
end
if gt get st 1 KSC_ENV_MAX_PT
ret KSC_ENV_ERR_TOO_LARGE
end
if eq get st 4 0
ret KSC_ENV_ERR_OVERFLOW
end
if ne len env get st 4
ret KSC_ENV_ERR_LEN
end
if lt len pt_dst get st 1
ret KSC_ENV_ERR_LEN
end
put st 4 get st 0
put st 7 get st 1
put st 0 get meta 0
put st 1 get meta 1
put st 2 0
put st 3 0
put st 5 64
put st 6 0
for i ulong 48 unroll
put phdr i get params i
end
for i ulong 64 unroll
put phdr add 48 i get env i
end
if eq get st 7 0
if ne ksc_env_open_chunk phdr st env pt_dst KSC_ENV_OK
ret KSC_ENV_ERR_AUTH
end
put meta 2 0
ret KSC_ENV_OK
end
while lt get st 6 get st 7 bound 1048576
clen = sub get st 7 get st 6
if gt clen get st 4
clen = get st 4
end
put st 3 clen
if ne ksc_env_open_chunk phdr st env pt_dst KSC_ENV_OK
for z ulong get st 6 bound 1048576
put pt_dst z uchar 0
end
ret KSC_ENV_ERR_AUTH
end
put st 6 add get st 6 clen
put st 5 add get st 5 add clen 16
put st 2 add get st 2 1
end
put meta 2 get st 7
ret KSC_ENV_OK
end

note =========================================================================
note 2. Security Subkeys, Manifests, KeySlot Wrap/Unwrap, Anti-Rollback
note =========================================================================

note Derives k_cortex[0..32), k_agent[32..64), k_artifact[64..96), k_root_auth[96..128)
fn ksc_derive_subkeys k_vol view uchar 32 subkeys edit uchar 128 to void
r0 = ksc_hkdf_expand k_vol KSC_TXT_SUBKEY_CORTEX part subkeys 0 32
r1 = ksc_hkdf_expand k_vol KSC_TXT_SUBKEY_AGENT part subkeys 32 32
r2 = ksc_hkdf_expand k_vol KSC_TXT_SUBKEY_ARTIFACT part subkeys 64 32
r3 = ksc_hkdf_expand k_vol KSC_TXT_SUBKEY_ROOTAUTH part subkeys 96 32
if ne or or r0 r1 or r2 r3 0
trap 8
end
end

fn ksc_keyslot_wrap slot edit uchar 128 kek view uchar 32 k_vol view uchar 32 nonce view uchar 12 to ulong
kn = new uchar 44 0
aad = new uchar 4 0
ct = new uchar 48 0
put slot 1 uchar 1
ksc_copy part slot 44 12 nonce
ksc_copy part kn 0 32 kek
ksc_copy part kn 32 12 nonce
ksc_copy aad part slot 4 4
ksc_copy part ct 0 32 k_vol
rc = aes_gcmsiv_seal kn aad ct
if ne rc 0
ksc_zeroize ct
ret KSC_SEC_ERR_FORMAT
end
ksc_copy part slot 56 32 part ct 0 32
ksc_copy part slot 88 16 part ct 32 16
ksc_zeroize ct
ksc_zeroize kn
ret KSC_SEC_OK
end

fn ksc_keyslot_unwrap slot view uchar 128 kek view uchar 32 k_vol edit uchar 32 to ulong
kn = new uchar 44 0
aad = new uchar 4 0
ct = new uchar 48 0
stype = ulong get slot 0
if eq stype 0
ret KSC_SEC_ERR_FORMAT
end
if ne ulong get slot 1 1
ret KSC_SEC_ERR_FORMAT
end
ksc_copy part kn 0 32 kek
ksc_copy part kn 32 12 part slot 44 12
ksc_copy aad part slot 4 4
ksc_copy part ct 0 32 part slot 56 32
ksc_copy part ct 32 16 part slot 88 16
rc = aes_gcmsiv_open kn aad ct
ksc_zeroize kn
if ne rc 0
ksc_zeroize ct
ret KSC_SEC_ERR_AUTH
end
ksc_copy k_vol part ct 0 32
ksc_zeroize ct
ret KSC_SEC_OK
end

fn ksc_keyslot_desc_validate buf view uchar * to ulong
stype = ulong get buf 0
if gt stype 3
ret KSC_SEC_ERR_FORMAT
end
mkib = ksc_get_u32le buf 32
tcost = ksc_get_u32le buf 36
pcost = ksc_get_u32le buf 40
if gt mkib 131072
ret KSC_SEC_ERR_FORMAT
end
if gt tcost 10
ret KSC_SEC_ERR_FORMAT
end
if gt pcost 16
ret KSC_SEC_ERR_FORMAT
end
if not ksc_is_zero part buf 112 16
ret KSC_SEC_ERR_RSVD
end
ret KSC_SEC_OK
end

fn ksc_keyslot_manifest_validate buf view uchar * to ulong
fixed = add KSC_KEYSLOT_HDR_SIZE mul KSC_KEYSLOT_MAX KSC_KEYSLOT_DESC_SIZE
if lt len buf fixed
ret KSC_SEC_ERR_SHORT
end
if not ksc_ct_eq part buf 0 8 KSC_TXT_KSL_MAGIC
ret KSC_SEC_ERR_MAGIC
end
if ne ksc_get_u16le buf 8 KSC_SEC_VER
ret KSC_SEC_ERR_VER
end
if ne ksc_get_u16le buf 10 0
ret KSC_SEC_ERR_FORMAT
end
scnt = ksc_get_u32le buf 76
if gt scnt KSC_KEYSLOT_MAX
ret KSC_SEC_ERR_SLOT_RANGE
end
if not ksc_is_zero part buf 80 48
ret KSC_SEC_ERR_RSVD
end
for i ulong 4 unroll
off = add KSC_KEYSLOT_HDR_SIZE mul i KSC_KEYSLOT_DESC_SIZE
rc = ksc_keyslot_desc_validate part buf off 128
if ne rc KSC_SEC_OK
ret rc
end
end
arena = sub len buf fixed
if gt arena KSC_KEYSLOT_MAX_ARENA
ret KSC_SEC_ERR_ARENA
end
ret KSC_SEC_OK
end

fn ksc_sec_manifest_mac buf view uchar 256 k_root_auth view uchar 32 mac edit uchar 32 to void
hctx = new ulong 48 0
nul = new uchar 1 0
ksc_hmac_init hctx k_root_auth
ksc_hmac_update hctx KSC_TXT_ROOT_AUTH_DOM
ksc_hmac_update hctx nul
ksc_hmac_update hctx part buf 0 224
ksc_hmac_final hctx mac
end

fn ksc_sec_manifest_sign buf edit uchar 256 k_root_auth view uchar 32 to void
mac = new uchar 32 0
ksc_sec_manifest_mac buf k_root_auth mac
ksc_copy part buf 224 32 mac
ksc_zeroize mac
end

fn ksc_sec_manifest_verify buf view uchar 256 k_root_auth view uchar 32 to bool
exp = new uchar 32 0
ksc_sec_manifest_mac buf k_root_auth exp
ok = ksc_ct_eq part buf 224 32 exp
ksc_zeroize exp
ret ok
end

fn ksc_sec_manifest_validate buf view uchar * to ulong
if ne len buf KSC_SEC_MANIFEST_SIZE
ret KSC_SEC_ERR_SHORT
end
if not ksc_ct_eq part buf 0 8 KSC_TXT_SEC_MAGIC
ret KSC_SEC_ERR_MAGIC
end
if ne ksc_get_u16le buf 8 KSC_SEC_VER
ret KSC_SEC_ERR_VER
end
if ne ksc_get_u16le buf 10 0
ret KSC_SEC_ERR_FORMAT
end
if ne ksc_get_u32le buf 12 0
ret KSC_SEC_ERR_RSVD
end
ret KSC_SEC_OK
end

fn ksc_mig_manifest_validate buf view uchar * to ulong
if ne len buf KSC_MIG_MANIFEST_SIZE
ret KSC_SEC_ERR_SHORT
end
if not ksc_ct_eq part buf 0 8 KSC_TXT_MIG_MAGIC
ret KSC_SEC_ERR_MAGIC
end
if ne ksc_get_u16le buf 8 KSC_SEC_VER
ret KSC_SEC_ERR_VER
end
if ne ksc_get_u16le buf 10 0
ret KSC_SEC_ERR_FORMAT
end
if ne ksc_get_u32le buf 12 0
ret KSC_SEC_ERR_RSVD
end
ret KSC_SEC_OK
end

fn ksc_eval_anti_rollback has_anchor ulong a_ep ulong d_ep ulong a_dig view uchar 32 d_dig view uchar 32 to ulong
if eq has_anchor 0
ret KSC_ARB_PREPARED_ADVANCE
end
same = ksc_ct_eq d_dig a_dig
if eq d_ep a_ep
if same
ret KSC_ARB_VALID_RESUME
end
ret KSC_ARB_ROLLBACK_DIGEST
end
if lt d_ep a_ep
ret KSC_ARB_ROLLBACK_STALE
end
if lt a_ep 0xffffffffffffffff
if eq d_ep add a_ep 1
ret KSC_ARB_PREPARED_ADVANCE
end
end
ret KSC_ARB_INCONSISTENT_EPOCH
end

note =========================================================================
note 3. Budget Manager & Watchdog Policy (budget.rs)
note =========================================================================

fn ksc_sat_add a ulong b ulong to ulong
if gt a sub 0xffffffffffffffff b
ret 0xffffffffffffffff
end
ret add a b
end

fn ksc_budget_policy_allowance mode ulong base ulong to ulong
whole = ulong 0
rem_num = ulong 100
if eq mode KSC_BMODE_IDLE
rem_num = 800
else
if eq mode KSC_BMODE_URGENT
whole = 1
rem_num = 500
end
end
p0 = ulong 0
if eq whole 1
p0 = base
end
q = div base 1000
r = rem base 1000
p1 = mul q rem_num
p2 = div mul r rem_num 1000
ret ksc_sat_add ksc_sat_add p0 p1 p2
end

note BudgetManager layout in mgr edit ulong 132:
note   mgr[0] = mode (0=Active, 1=Idle, 2=Urgent), mgr[1] = cap (1..8)
note   slot s (0..cap-1) at base = 4 + s * 16:
note     +0 state, +1 id, +2 cpu_lim, +3 frames_lim, +4 dma_lim, +5 max_rt,
note     +6 forge, +7 cpu_used, +8 frames_used, +9 dma_used, +10 armed_at

fn ksc_budget_init mgr edit ulong 132 cap ulong to void
for i ulong 132 bound 132
put mgr i ulong 0
end
c = cap
if gt c 8
c = 8
end
put mgr 0 KSC_BMODE_ACTIVE
put mgr 1 c
end

fn ksc_budget_set_mode mgr edit ulong 132 mode ulong to void
put mgr 0 mode
end

fn ksc_budget_find mgr view ulong 132 wid ulong to ulong
cap = get mgr 1
for s ulong cap bound 8
base = add 4 mul s 16
if ne get mgr base KSC_WSTATE_EMPTY
if eq get mgr add base 1 wid
ret s
end
end
end
ret 99
end

note env4: [cpu_lim, frames_lim, dma_lim, max_rt]
fn ksc_budget_admit mgr edit ulong 132 wid ulong env4 view ulong 4 is_forge ulong now ulong to ulong
if lt ksc_budget_find mgr wid 8
ret KSC_BERR_DUP
end
cap = get mgr 1
slot = ulong 99
for s ulong cap bound 8
base = add 4 mul s 16
if eq get mgr base KSC_WSTATE_EMPTY
slot = s
break
end
end
if eq slot 99
ret KSC_BERR_FULL
end
b = add 4 mul slot 16
put mgr b KSC_WSTATE_ACTIVE
put mgr add b 1 wid
put mgr add b 2 get env4 0
put mgr add b 3 get env4 1
put mgr add b 4 get env4 2
put mgr add b 5 get env4 3
put mgr add b 6 is_forge
put mgr add b 7 0
put mgr add b 8 0
put mgr add b 9 0
put mgr add b 10 now
ret KSC_BERR_OK
end

fn ksc_budget_remove mgr edit ulong 132 wid ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
put mgr add 4 mul s 16 KSC_WSTATE_EMPTY
ret KSC_BERR_OK
end

fn ksc_budget_begin_period mgr edit ulong 132 to void
cap = get mgr 1
for s ulong cap bound 8
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_ACTIVE
put mgr add b 7 0
end
end
end

fn ksc_budget_cpu_allowance mgr view ulong 132 wid ulong res edit ulong 1 to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
lim = get mgr add b 2
if ne get mgr add b 6 0
put res 0 ksc_budget_policy_allowance get mgr 0 lim
else
put res 0 lim
end
ret KSC_BERR_OK
end

fn ksc_budget_state mgr view ulong 132 wid ulong res edit ulong 1 to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
put res 0 get mgr add 4 mul s 16
ret KSC_BERR_OK
end

fn ksc_budget_charge_cpu mgr edit ulong 132 wid ulong ticks ulong to ulong
al = new ulong 1 0
rc = ksc_budget_cpu_allowance mgr wid al
if ne rc KSC_BERR_OK
ret rc
end
s = ksc_budget_find mgr wid
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_QUARANTINED
ret KSC_BERR_QUARANTINED
end
used = get mgr add b 7
if gt ticks sub 0xffffffffffffffff used
ret KSC_BERR_CPU
end
nxt = add used ticks
if gt nxt get al 0
ret KSC_BERR_CPU
end
put mgr add b 7 nxt
ret KSC_BERR_OK
end

fn ksc_budget_charge_frames mgr edit ulong 132 wid ulong frames ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_QUARANTINED
ret KSC_BERR_QUARANTINED
end
used = get mgr add b 8
if gt frames sub 0xffffffffffffffff used
ret KSC_BERR_FRAMES
end
nxt = add used frames
if gt nxt get mgr add b 3
ret KSC_BERR_FRAMES
end
put mgr add b 8 nxt
ret KSC_BERR_OK
end

fn ksc_budget_release_frames mgr edit ulong 132 wid ulong frames ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_QUARANTINED
ret KSC_BERR_QUARANTINED
end
used = get mgr add b 8
if gt frames used
ret KSC_BERR_BAD_RELEASE
end
put mgr add b 8 sub used frames
ret KSC_BERR_OK
end

fn ksc_budget_charge_dma mgr edit ulong 132 wid ulong bytes ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_QUARANTINED
ret KSC_BERR_QUARANTINED
end
used = get mgr add b 9
if gt bytes sub 0xffffffffffffffff used
ret KSC_BERR_DMA
end
nxt = add used bytes
if gt nxt get mgr add b 4
ret KSC_BERR_DMA
end
put mgr add b 9 nxt
ret KSC_BERR_OK
end

fn ksc_budget_pet mgr edit ulong 132 wid ulong now ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_QUARANTINED
ret KSC_BERR_QUARANTINED
end
put mgr add b 10 now
ret KSC_BERR_OK
end

note Quarantine overdue worlds using wrapping elapsed time; returns count expired.
fn ksc_budget_check mgr edit ulong 132 now ulong expired edit ulong 8 to ulong
cap = get mgr 1
cnt = ulong 0
for s ulong cap bound 8
put expired s ulong 0
b = add 4 mul s 16
if eq get mgr b KSC_WSTATE_ACTIVE
elapsed = sub now get mgr add b 10
if ge elapsed get mgr add b 5
put mgr b KSC_WSTATE_QUARANTINED
put expired s get mgr add b 1
cnt = add cnt 1
end
end
end
ret cnt
end

fn ksc_budget_restore mgr edit ulong 132 wid ulong now ulong to ulong
s = ksc_budget_find mgr wid
if ge s 8
ret KSC_BERR_UNKNOWN
end
b = add 4 mul s 16
put mgr add b 7 0
put mgr add b 8 0
put mgr add b 9 0
put mgr add b 10 now
put mgr b KSC_WSTATE_ACTIVE
ret KSC_BERR_OK
end

note =========================================================================
note 4. Recovery Core, SlotManager, OperatorAuth, WalRecovery
note =========================================================================

note sm[0]=active_slot, [1]=slot_a_health, [2]=slot_b_health, [3]=attempts, [4]=max_attempts
fn ksc_slotmgr_init sm edit ulong 5 to void
put sm 0 KSC_SLOT_A
put sm 1 KSC_HEALTH_CONFIRMED
put sm 2 KSC_HEALTH_UNVERIFIED
put sm 3 0
put sm 4 3
end

fn ksc_slotmgr_mark_healthy sm edit ulong 5 to void
put sm 3 0
if eq get sm 0 KSC_SLOT_A
put sm 1 KSC_HEALTH_CONFIRMED
else
put sm 2 KSC_HEALTH_CONFIRMED
end
end

fn ksc_slotmgr_record_attempt sm edit ulong 5 to bool
att = add get sm 3 1
put sm 3 att
if ge att get sm 4
if eq get sm 0 KSC_SLOT_A
put sm 1 KSC_HEALTH_FAILED
put sm 0 KSC_SLOT_B
else
put sm 2 KSC_HEALTH_FAILED
put sm 0 KSC_SLOT_A
end
put sm 3 0
ret true
end
ret false
end

fn ksc_opauth_expected_response key view uchar 32 ch view uchar 32 resp edit uchar 32 to void
hctx = new ulong 48 0
nul = new uchar 1 0
ksc_hmac_init hctx key
ksc_hmac_update hctx KSC_TXT_OPAUTH_DOM
ksc_hmac_update hctx nul
ksc_hmac_update hctx ch
ksc_hmac_final hctx resp
end

fn ksc_opauth_verify key view uchar 32 ch view uchar 32 resp view uchar 32 to bool
exp = new uchar 32 0
ksc_opauth_expected_response key ch exp
ok = ksc_ct_eq exp resp
ksc_zeroize exp
ret ok
end

fn ksc_wal_encode_entry payload view uchar * buf edit uchar * to ulong
dig = new uchar 32 0
plen = len payload
tot = add 36 plen
if lt len buf tot
ret 0
end
ksc_sha256 payload dig
ksc_put_u32be buf 0 plen
ksc_copy part buf 4 32 dig
if gt plen 0
ksc_copy part buf 36 plen payload
end
ret tot
end

note res[0]=valid_records, res[1]=truncated_valid_bytes
fn ksc_wal_recover raw view uchar * res edit ulong 2 to void
dig = new uchar 32 0
off = ulong 0
valid = ulong 0
rlen = len raw
while le add off 36 rlen bound 1048576
reclen = ksc_get_u32be raw off
pstart = add off 36
if gt reclen sub 0xffffffffffffffff pstart
break
end
pend = add pstart reclen
if gt pend rlen
break
end
ksc_sha256 part raw pstart reclen dig
if not ksc_ct_eq dig part raw add off 4 32
break
end
valid = add valid 1
off = pend
end
put res 0 valid
put res 1 off
end

fn ksc_recovery_applicable mstate ulong reason ulong pcond ulong has_cont ulong to ulong
if eq mstate KSC_MOUNT_NONE
ret KSC_ACT_NONE
end
if eq reason KSC_REASON_DEGRADED
if eq pcond KSC_PEER_MALFORMED
if ne has_cont 0
ret KSC_ACT_REPAIR_DEGRADED_PEER
end
end
ret KSC_ACT_NONE
end
if eq reason KSC_REASON_UNPROVISIONED
if eq mstate KSC_MOUNT_VALID
ret KSC_ACT_PROVISION_IDENTITY
end
end
ret KSC_ACT_NONE
end

fn ksc_recovery_challenge suuid view uchar 16 gen ulong action ulong sdig view uchar 32 ch edit uchar 32 to void
sctx = new ulong 40 0
nul = new uchar 1 0
gb = new uchar 8 0
ab = new uchar 1 0
ksc_put_u64le gb 0 gen
put ab 0 uchar and action 0xff
sha256_init sctx
sha256_update sctx KSC_TXT_CHALLENGE_DOM
sha256_update sctx nul
sha256_update sctx suuid
sha256_update sctx gb
sha256_update sctx ab
sha256_update sctx sdig
sha256_final sctx ch
end

fn ksc_recovery_authorise applicable ulong req_act ulong key view uchar 32 ch view uchar 32 resp view uchar 32 to ulong
if eq applicable KSC_ACT_NONE
ret KSC_REC_ERR_NOT_APPLICABLE
end
if ne applicable req_act
ret KSC_REC_ERR_NOT_APPLICABLE
end
if not ksc_opauth_verify key ch resp
ret KSC_REC_ERR_UNAUTHORISED
end
ret KSC_REC_OK
end

note =========================================================================
note 5. Continuity Objects, Branch Lineage, and State Transitions
note =========================================================================

fn ksc_root_branch_id agent view uchar * bid edit uchar 32 to void
sctx = new ulong 40 0
sha256_init sctx
sha256_update sctx KSC_TXT_ROOT_BRANCH
sha256_update sctx agent
sha256_final sctx bid
end

fn ksc_child_branch_id parent view uchar * idx ulong bid edit uchar 32 to void
sctx = new ulong 40 0
ib = new uchar 8 0
ksc_put_u64be ib 0 idx
sha256_init sctx
sha256_update sctx KSC_TXT_CHILD_BRANCH
sha256_update sctx parent
sha256_update sctx ib
sha256_final sctx bid
end

fn ksc_cont_check_hdr buf view uchar * magic view uchar 8 to ulong
if lt len buf KSC_CONT_HDR_BYTES
ret KSC_CERR_TRUNCATED
end
if not ksc_ct_eq part buf 0 8 magic
ret KSC_CERR_BAD_MAGIC
end
if ne ksc_get_u16le buf 8 0
ret KSC_CERR_BAD_VER
end
if ne ksc_get_u16le buf 10 0
ret KSC_CERR_HDR_RSVD
end
blen = ksc_get_u32le buf 12
if ne blen sub len buf KSC_CONT_HDR_BYTES
ret KSC_CERR_BODY_LEN
end
ret KSC_CERR_OK
end

fn ksc_cont_write_hdr buf edit uchar * magic view uchar 8 body_len ulong to void
ksc_copy part buf 0 8 magic
ksc_put_u16le buf 8 0
ksc_put_u16le buf 10 0
ksc_put_u32le buf 12 body_len
end

fn ksc_agent_root_encode agent view uchar 32 uuid view uchar 16 gen ulong src ulong buf edit uchar 112 to ulong
rb = new uchar 32 0
ksc_cont_write_hdr buf KSC_TXT_MAGIC_ROOT 96
ksc_copy part buf 16 32 agent
ksc_copy part buf 48 16 uuid
ksc_root_branch_id agent rb
ksc_copy part buf 64 32 rb
ksc_put_u64le buf 96 gen
put buf 104 uchar and src 0xff
for i ulong 7 unroll
put buf add 105 i uchar 0
end
ret 112
end

note meta[0]=provisioned_generation, meta[1]=source
fn ksc_agent_root_decode buf view uchar * meta edit ulong 2 to ulong
rb = new uchar 32 0
rc = ksc_cont_check_hdr buf KSC_TXT_MAGIC_ROOT
if ne rc KSC_CERR_OK
ret rc
end
if lt len buf 112
ret KSC_CERR_TRUNCATED
end
if gt len buf 112
ret KSC_CERR_TRAILING
end
src = ulong get buf 104
if lt src 1
ret KSC_CERR_BAD_SRC
end
if gt src 2
ret KSC_CERR_BAD_SRC
end
if not ksc_is_zero part buf 105 7
ret KSC_CERR_RSVD
end
if ksc_is_zero part buf 16 32
ret KSC_CERR_ZERO_AGENT
end
ksc_root_branch_id part buf 16 32 rb
if not ksc_ct_eq rb part buf 64 32
ret KSC_CERR_ROOT_BRANCH
end
put meta 0 ksc_get_u64le buf 96
put meta 1 src
ret KSC_CERR_OK
end

note meta[0]=sequence, [1]=incarnation, [2]=wal_count
fn ksc_manifest_decode buf view uchar * meta edit ulong 3 to ulong
rc = ksc_cont_check_hdr buf KSC_TXT_MAGIC_MANI
if ne rc KSC_CERR_OK
ret rc
end
if lt len buf 136
ret KSC_CERR_TRUNCATED
end
seq = ksc_get_u64le buf 80
inc = ksc_get_u64le buf 88
wcnt = ksc_get_u16le buf 128
if not ksc_is_zero part buf 130 6
ret KSC_CERR_RSVD
end
if gt wcnt KSC_CONT_MAX_WAL_SEGS
ret KSC_CERR_TOO_MANY_WAL
end
need = add 136 mul wcnt 32
if lt len buf need
ret KSC_CERR_TRUNCATED
end
if gt len buf need
ret KSC_CERR_TRAILING
end
if eq seq 0
ret KSC_CERR_SEQ_PREV
end
prev_zero = ksc_is_zero part buf 48 32
if eq seq 1
if not prev_zero
ret KSC_CERR_SEQ_PREV
end
else
if prev_zero
ret KSC_CERR_SEQ_PREV
end
end
put meta 0 seq
put meta 1 inc
put meta 2 wcnt
ret KSC_CERR_OK
end

fn ksc_state_find_branch buf view uchar * cnt ulong bid view uchar * to ulong
lo = ulong 0
hi = cnt
while lt lo hi bound 16
mid = add lo shr sub hi lo 1
off = add 64 mul mid KSC_CONT_BRANCH_BYTES
c = ksc_cmp_lex part buf off 32 bid
if eq c int 0
ret mid
end
if lt c int 0
lo = add mid 1
else
hi = mid
end
end
ret 9999
end

fn ksc_state_check_lineage buf view uchar * cnt ulong idx ulong to ulong
cbid = new uchar 32 0
pid = new uchar 32 0
off = add 64 mul idx KSC_CONT_BRANCH_BYTES
ksc_copy pid part buf add off 32 32
pidx = ksc_state_find_branch buf cnt pid
if ge pidx cnt
ret KSC_CERR_NO_PARENT
end
poff = add 64 mul pidx KSC_CONT_BRANCH_BYTES
pdepth = ksc_get_u32le buf add poff 64
if eq pdepth 0xffffffff
ret KSC_CERR_LINEAGE
end
if ne ksc_get_u32le buf add off 64 add pdepth 1
ret KSC_CERR_LINEAGE
end
lim = ksc_get_u64le buf add poff 72
if gt lim KSC_CONT_MAX_BRANCHES
lim = KSC_CONT_MAX_BRANCHES
end
for k ulong lim bound 256
ksc_child_branch_id pid k cbid
if ksc_ct_eq cbid part buf off 32
ret KSC_CERR_OK
end
end
ret KSC_CERR_LINEAGE
end

fn ksc_state_check_sorted buf view uchar * cnt ulong to ulong
prev_id = new uchar 32 0
for i ulong cnt bound 256
off = add 64 mul i KSC_CONT_BRANCH_BYTES
if not ksc_is_zero part buf add off 68 4
ret KSC_CERR_RSVD
end
if gt i 0
if ge ksc_cmp_lex prev_id part buf off 32 int 0
ret KSC_CERR_NOT_SORTED
end
end
ksc_copy prev_id part buf off 32
end
ret KSC_CERR_OK
end

fn ksc_agent_state_validate buf view uchar * to ulong
rb = new uchar 32 0
rc = ksc_cont_check_hdr buf KSC_TXT_MAGIC_BRAN
if ne rc KSC_CERR_OK
ret rc
end
if lt len buf 64
ret KSC_CERR_TRUNCATED
end
cnt = ksc_get_u32le buf 56
if not ksc_is_zero part buf 60 4
ret KSC_CERR_RSVD
end
if eq cnt 0
ret KSC_CERR_BRANCH_COUNT
end
if gt cnt KSC_CONT_MAX_BRANCHES
ret KSC_CERR_BRANCH_COUNT
end
if lt len buf add 64 mul cnt KSC_CONT_BRANCH_BYTES
ret KSC_CERR_TRUNCATED
end
if gt len buf add 64 mul cnt KSC_CONT_BRANCH_BYTES
ret KSC_CERR_TRAILING
end
rc = ksc_state_check_sorted buf cnt
if ne rc KSC_CERR_OK
ret rc
end
ksc_root_branch_id part buf 16 32 rb
roots = ulong 0
children = ulong 0
fsum = ulong 0
fover = ulong 0
for i ulong cnt bound 256
off = add 64 mul i KSC_CONT_BRANCH_BYTES
bf = ksc_get_u64le buf add off 72
if gt bf sub 0xffffffffffffffff fsum
fover = 1
else
fsum = add fsum bf
end
if ksc_is_zero part buf add off 32 32
if not ksc_ct_eq part buf off 32 rb
ret KSC_CERR_BAD_ROOT
end
if ne ksc_get_u32le buf add off 64 0
ret KSC_CERR_BAD_ROOT
end
roots = add roots 1
else
rc = ksc_state_check_lineage buf cnt i
if ne rc KSC_CERR_OK
ret rc
end
children = add children 1
end
end
if ne roots 1
ret KSC_CERR_FORK_SUM
end
if ne fover 0
ret KSC_CERR_FORK_SUM
end
if ne fsum children
ret KSC_CERR_FORK_SUM
end
ret KSC_CERR_OK
end

note Writes 144-byte genesis AgentState into buf; returns 144.
fn ksc_agent_state_genesis agent view uchar 32 written_at ulong buf edit uchar * to ulong
rb = new uchar 32 0
if lt len buf 144
ret 0
end
ksc_zeroize part buf 0 144
ksc_cont_write_hdr buf KSC_TXT_MAGIC_BRAN 128
ksc_copy part buf 16 32 agent
ksc_put_u64le buf 48 written_at
ksc_put_u32le buf 56 1
ksc_root_branch_id agent rb
ksc_copy part buf 64 32 rb
ret 144
end

fn ksc_state_insert_row buf edit uchar * cnt ulong ins ulong to void
j = cnt
while gt j ins bound 256
soff = add 64 mul sub j 1 KSC_CONT_BRANCH_BYTES
doff = add 64 mul j KSC_CONT_BRANCH_BYTES
for b ulong 80
put buf add doff b get buf add soff b
end
j = sub j 1
end
end

fn ksc_state_find_insert buf view uchar * cnt ulong cid view uchar 32 to ulong
for i ulong cnt bound 256
off = add 64 mul i KSC_CONT_BRANCH_BYTES
if gt ksc_cmp_lex part buf off 32 cid int 0
ret i
end
end
ret cnt
end

note Fork a child branch of parent in encoded AgentState buf (cur_len bytes).
note Writes new child_id and returns new length (cur_len + 80), or 0 on error.
fn ksc_agent_state_fork buf edit uchar * cur_len ulong parent view uchar 32 child_id edit uchar 32 to ulong
cnt = ksc_get_u32le buf 56
if ge cnt KSC_CONT_MAX_BRANCHES
ret 0
end
if lt len buf add cur_len KSC_CONT_BRANCH_BYTES
ret 0
end
pidx = ksc_state_find_branch part buf 0 cur_len cnt parent
if ge pidx cnt
ret 0
end
poff = add 64 mul pidx KSC_CONT_BRANCH_BYTES
pdepth = ksc_get_u32le buf add poff 64
if eq pdepth 0xffffffff
ret 0
end
pforks = ksc_get_u64le buf add poff 72
ksc_child_branch_id parent pforks child_id
if lt ksc_state_find_branch part buf 0 cur_len cnt child_id cnt
ret 0
end
ksc_put_u64le buf add poff 72 add pforks 1
ins = ksc_state_find_insert buf cnt child_id
ksc_state_insert_row buf cnt ins
ioff = add 64 mul ins KSC_CONT_BRANCH_BYTES
ksc_zeroize part buf ioff 80
ksc_copy part buf ioff 32 child_id
ksc_copy part buf add ioff 32 32 parent
ksc_put_u32le buf add ioff 64 add pdepth 1
ksc_put_u32le buf 56 add cnt 1
ksc_put_u32le buf 12 sub add cur_len KSC_CONT_BRANCH_BYTES KSC_CONT_HDR_BYTES
ret add cur_len KSC_CONT_BRANCH_BYTES
end

note meta[0]=sequence, meta[1]=record_count
fn ksc_wal_seg_decode buf view uchar * meta edit ulong 2 to ulong
rc = ksc_cont_check_hdr buf KSC_TXT_MAGIC_CWAL
if ne rc KSC_CERR_OK
ret rc
end
if lt len buf 32
ret KSC_CERR_TRUNCATED
end
seq = ksc_get_u64le buf 16
rcnt = ksc_get_u32le buf 24
if not ksc_is_zero part buf 28 4
ret KSC_CERR_RSVD
end
if eq rcnt 0
ret KSC_CERR_WAL_COUNT
end
if gt rcnt KSC_CONT_MAX_WAL_RECS
ret KSC_CERR_WAL_COUNT
end
cur = ulong 32
blen = len buf
for i ulong rcnt bound 64
if gt add cur 36 blen
ret KSC_CERR_TRUNCATED
end
ep = ulong get buf cur
if lt ep 1
ret KSC_CERR_EPISTEMIC
end
if gt ep 6
ret KSC_CERR_EPISTEMIC
end
if ne ulong get buf add cur 1 0
ret KSC_CERR_RSVD
end
slen = ksc_get_u16le buf add cur 2
if eq slen 0
ret KSC_CERR_STMT_LEN
end
if gt slen KSC_CONT_MAX_STMT_BYTES
ret KSC_CERR_STMT_LEN
end
cur = add cur add 36 slen
if gt cur blen
ret KSC_CERR_TRUNCATED
end
end
if ne cur blen
ret KSC_CERR_TRAILING
end
put meta 0 seq
put meta 1 rcnt
ret KSC_CERR_OK
end

note =========================================================================
note 6. Admission Policy & Capability Attenuation (admission.rs)
note =========================================================================

fn ksc_cap_validate rec view uchar * to ulong
if ne ksc_get_u16le rec 2 0
ret KSC_AERR_MALFORMED_CAP
end
if ne ksc_get_u32le rec 20 0
ret KSC_AERR_MALFORMED_CAP
end
rkind = ksc_get_u16le rec 0
rid = ksc_get_u32le rec 4
rights = ksc_get_u32le rec 8
bkind = ksc_get_u32le rec 12
mops = ksc_get_u32le rec 16
mbytes = ksc_get_u64le rec 24
boff = ksc_get_u64le rec 32
blen = ksc_get_u64le rec 40
if eq rid 0
ret KSC_AERR_MALFORMED_CAP
end
if eq rights 0
ret KSC_AERR_MALFORMED_CAP
end
if ne and rights xor KSC_VALID_RIGHTS 0xffffffff 0
ret KSC_AERR_MALFORMED_CAP
end
if eq mops 0
ret KSC_AERR_MALFORMED_CAP
end
if eq mbytes 0
ret KSC_AERR_MALFORMED_CAP
end
if eq rkind KSC_CAP_OBJECT
if ne bkind 1
ret KSC_AERR_MALFORMED_CAP
end
if gt boff sub 0xffffffffffffffff blen
ret KSC_AERR_LEN_OVERFLOW
end
if eq blen 0
ret KSC_AERR_MALFORMED_CAP
end
if gt mbytes blen
ret KSC_AERR_MALFORMED_CAP
end
ret KSC_AERR_OK
end
if eq rkind KSC_CAP_CHANNEL
if ne bkind 2
ret KSC_AERR_MALFORMED_CAP
end
if ne boff 0
ret KSC_AERR_MALFORMED_CAP
end
if ne blen 0
ret KSC_AERR_MALFORMED_CAP
end
ret KSC_AERR_OK
end
ret KSC_AERR_MALFORMED_CAP
end

fn ksc_cap_is_attenuation grant view uchar * req view uchar * to bool
if ne ksc_cap_validate grant KSC_AERR_OK
ret false
end
if ne ksc_cap_validate req KSC_AERR_OK
ret false
end
if ne ksc_get_u16le grant 0 ksc_get_u16le req 0
ret false
end
if ne ksc_get_u32le grant 4 ksc_get_u32le req 4
ret false
end
if ne ksc_get_u32le grant 12 ksc_get_u32le req 12
ret false
end
gr = ksc_get_u32le grant 8
rr = ksc_get_u32le req 8
if ne and gr xor rr 0xffffffff 0
ret false
end
if gt ksc_get_u32le grant 16 ksc_get_u32le req 16
ret false
end
if gt ksc_get_u64le grant 24 ksc_get_u64le req 24
ret false
end
bk = ksc_get_u32le grant 12
if eq bk 1
goff = ksc_get_u64le grant 32
glen = ksc_get_u64le grant 40
roff = ksc_get_u64le req 32
rlen = ksc_get_u64le req 40
if lt goff roff
ret false
end
if gt add goff glen add roff rlen
ret false
end
ret true
end
if eq bk 2
if ne ksc_get_u64le grant 32 0
ret false
end
if ne ksc_get_u64le grant 40 0
ret false
end
ret true
end
ret false
end

fn ksc_cap_intersect_range req view uchar * pol view uchar * res edit ulong 2 to ulong
roff = ksc_get_u64le req 32
rlen = ksc_get_u64le req 40
poff = ksc_get_u64le pol 32
plen = ksc_get_u64le pol 40
if gt roff sub 0xffffffffffffffff rlen
ret KSC_AERR_LEN_OVERFLOW
end
if gt poff sub 0xffffffffffffffff plen
ret KSC_AERR_LEN_OVERFLOW
end
start = roff
if gt poff start
start = poff
end
finish = add roff rlen
if lt add poff plen finish
finish = add poff plen
end
if ge start finish
ret 1
end
put res 0 start
put res 1 sub finish start
ret 0
end

note Intersect request and policy rule into grant.
note Returns 0 = granted, 1 = empty (no grant), >1 = ArtifactError.
fn ksc_cap_intersect req view uchar * pol view uchar * grant edit uchar 48 to ulong
rng = new ulong 2 0
rights = and ksc_get_u32le req 8 ksc_get_u32le pol 8
if eq rights 0
ret 1
end
mops = ksc_get_u32le req 16
if lt ksc_get_u32le pol 16 mops
mops = ksc_get_u32le pol 16
end
mbytes = ksc_get_u64le req 24
if lt ksc_get_u64le pol 24 mbytes
mbytes = ksc_get_u64le pol 24
end
bkind = ksc_get_u32le req 12
if eq bkind 1
rrc = ksc_cap_intersect_range req pol rng
if ne rrc 0
ret rrc
end
if gt mbytes get rng 1
mbytes = get rng 1
end
else
if ne bkind 2
ret KSC_AERR_MALFORMED_CAP
end
end
if eq mops 0
ret 1
end
if eq mbytes 0
ret 1
end
ksc_zeroize grant
ksc_put_u16le grant 0 ksc_get_u16le req 0
ksc_put_u32le grant 4 ksc_get_u32le req 4
ksc_put_u32le grant 8 rights
ksc_put_u32le grant 12 bkind
ksc_put_u32le grant 16 mops
ksc_put_u64le grant 24 mbytes
ksc_put_u64le grant 32 get rng 0
ksc_put_u64le grant 40 get rng 1
ret ksc_cap_validate grant
end

note Limits/Resources array (9 ulongs):
note [0]=code_pages, [1]=data_pages, [2]=stack_pages, [3]=max_caps,
note [4]=ipc_msgs, [5]=ipc_bytes, [6]=cpu_ticks, [7]=elapsed_ticks, [8]=syscalls
fn ksc_admission_limits_validate lim view ulong 9 to ulong
if gt get lim 0 KSC_MAX_CODE_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 1 KSC_MAX_DATA_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 2 KSC_MAX_STACK_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 3 KSC_MAX_CAPABILITIES
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 4 KSC_MAX_IPC_MSGS
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 5 KSC_MAX_IPC_BYTES
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 6 KSC_MAX_CPU_TICKS
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 7 KSC_MAX_ELAPSED_TICKS
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lim 8 KSC_MAX_SYSCALLS
ret KSC_AERR_RESOURCE_LIMIT
end
ret KSC_AERR_OK
end

fn ksc_admission_check_resources req view ulong 9 lim view ulong 9 avail view ulong 9 to ulong
for i ulong 9 unroll
r = get req i
if gt r get lim i
ret KSC_AERR_RESOURCE_LIMIT
end
if gt r get avail i
ret KSC_AERR_RESOURCE_LIMIT
end
end
if gt get req 0 1048575
ret KSC_AERR_LEN_OVERFLOW
end
if gt get req 1 1048575
ret KSC_AERR_LEN_OVERFLOW
end
if gt get req 2 1048575
ret KSC_AERR_LEN_OVERFLOW
end
ret KSC_AERR_OK
end

note AdmissionPolicy flat buffer: 1088 bytes = 64 hdr + 16*48 rules + 8*32 signers.
note Header matches canonical_bytes() layout:
note   [0..8) "AIENPOL\0", [8..10) 0, [10..12) 64, [12..14) 48, [14..16) rcnt,
note   [16..60) limits, [60..62) scnt, [62..64) 0.
fn ksc_policy_init pol edit uchar 1088 lim view ulong 9 to ulong
rc = ksc_admission_limits_validate lim
if ne rc KSC_AERR_OK
ret rc
end
ksc_zeroize pol
ksc_copy part pol 0 7 KSC_TXT_MAGIC_POL
put pol 7 uchar 0
ksc_put_u16le pol 10 KSC_POLICY_HDR_SIZE
ksc_put_u16le pol 12 KSC_POLICY_REC_SIZE
ksc_put_u32le pol 16 get lim 0
ksc_put_u32le pol 20 get lim 1
ksc_put_u32le pol 24 get lim 2
ksc_put_u32le pol 28 get lim 3
ksc_put_u32le pol 32 get lim 4
ksc_put_u32le pol 36 get lim 5
ksc_put_u64le pol 40 get lim 6
ksc_put_u64le pol 48 get lim 7
ksc_put_u32le pol 56 get lim 8
ret KSC_AERR_OK
end

fn ksc_cap_key rec view uchar * to ulong
ret or shl ksc_get_u16le rec 0 32 ksc_get_u32le rec 4
end

fn ksc_policy_add_rule pol edit uchar 1088 rule view uchar 48 to ulong
rc = ksc_cap_validate rule
if ne rc KSC_AERR_OK
ret rc
end
rcnt = ksc_get_u16le pol 14
key = ksc_cap_key rule
ins = rcnt
for i ulong rcnt bound 16
off = add KSC_POLICY_HDR_SIZE mul i KSC_POLICY_REC_SIZE
ckey = ksc_cap_key part pol off 48
if eq ckey key
ret KSC_AERR_MALFORMED_CAP
end
if gt ckey key
ins = i
break
end
end
if eq rcnt KSC_MAX_POLICY_RESOURCES
ret KSC_AERR_RESOURCE_LIMIT
end
j = rcnt
while gt j ins bound 16
soff = add KSC_POLICY_HDR_SIZE mul sub j 1 KSC_POLICY_REC_SIZE
doff = add KSC_POLICY_HDR_SIZE mul j KSC_POLICY_REC_SIZE
for b ulong 48 unroll
put pol add doff b get pol add soff b
end
j = sub j 1
end
ioff = add KSC_POLICY_HDR_SIZE mul ins KSC_POLICY_REC_SIZE
ksc_copy part pol ioff 48 rule
ksc_put_u16le pol 14 add rcnt 1
ret KSC_AERR_OK
end

fn ksc_policy_allow_signer pol edit uchar 1088 fp view uchar 32 to ulong
scnt = ksc_get_u16le pol 60
sbase = add KSC_POLICY_HDR_SIZE mul KSC_MAX_POLICY_RESOURCES KSC_POLICY_REC_SIZE
ins = scnt
for i ulong scnt bound 8
off = add sbase mul i KSC_POLICY_SIGNER_SIZE
c = ksc_cmp_lex part pol off 32 fp
if eq c int 0
ret KSC_AERR_UNTRUSTED_SIGNER
end
if gt c int 0
ins = i
break
end
end
if eq scnt KSC_MAX_POLICY_SIGNERS
ret KSC_AERR_RESOURCE_LIMIT
end
j = scnt
while gt j ins bound 8
soff = add sbase mul sub j 1 KSC_POLICY_SIGNER_SIZE
doff = add sbase mul j KSC_POLICY_SIGNER_SIZE
for b ulong 32 unroll
put pol add doff b get pol add soff b
end
j = sub j 1
end
ioff = add sbase mul ins KSC_POLICY_SIGNER_SIZE
ksc_copy part pol ioff 32 fp
ksc_put_u16le pol 60 add scnt 1
ret KSC_AERR_OK
end

fn ksc_policy_has_signer pol view uchar 1088 fp view uchar 32 to bool
scnt = ksc_get_u16le pol 60
sbase = add KSC_POLICY_HDR_SIZE mul KSC_MAX_POLICY_RESOURCES KSC_POLICY_REC_SIZE
for i ulong scnt bound 8
off = add sbase mul i KSC_POLICY_SIGNER_SIZE
if ksc_ct_eq part pol off 32 fp
ret true
end
end
ret false
end

note Canonical packed bytes (header + rcnt*48 + scnt*32) and SHA-256 policy digest
fn ksc_policy_digest pol view uchar 1088 dig edit uchar 32 to ulong
sctx = new ulong 40 0
nul = new uchar 1 0
rcnt = ksc_get_u16le pol 14
scnt = ksc_get_u16le pol 60
rbytes = mul rcnt KSC_POLICY_REC_SIZE
sbase = add KSC_POLICY_HDR_SIZE mul KSC_MAX_POLICY_RESOURCES KSC_POLICY_REC_SIZE
sbytes = mul scnt KSC_POLICY_SIGNER_SIZE
sha256_init sctx
sha256_update sctx KSC_TXT_POL_DOM
sha256_update sctx nul
sha256_update sctx part pol 0 add KSC_POLICY_HDR_SIZE rbytes
if gt sbytes 0
sha256_update sctx part pol sbase sbytes
end
sha256_final sctx dig
ret add add KSC_POLICY_HDR_SIZE rbytes sbytes
end

fn ksc_policy_find_rule pol view uchar 1088 req view uchar * to ulong
rcnt = ksc_get_u16le pol 14
key = ksc_cap_key req
for i ulong rcnt bound 16
off = add KSC_POLICY_HDR_SIZE mul i KSC_POLICY_REC_SIZE
if eq ksc_cap_key part pol off 48 key
ret i
end
end
ret 99
end

fn ksc_grants_digest grants view uchar 768 gcnt ulong gdig edit uchar 32 to void
sctx = new ulong 40 0
nul = new uchar 1 0
sha256_init sctx
sha256_update sctx KSC_TXT_GRANTS_DOM
sha256_update sctx nul
if gt gcnt 0
sha256_update sctx part grants 0 mul gcnt 48
end
sha256_final sctx gdig
end

fn ksc_policy_eval_one pol view uchar 1088 req view uchar * grec edit uchar 48 to ulong
ridx = ksc_policy_find_rule pol req
if ge ridx 16
ret 1
end
poff = add KSC_POLICY_HDR_SIZE mul ridx KSC_POLICY_REC_SIZE
irc = ksc_cap_intersect req part pol poff 48 grec
if eq irc 0
if not ksc_cap_is_attenuation grec req
ret KSC_AERR_RIGHTS_ESC
end
if not ksc_cap_is_attenuation grec part pol poff 48
ret KSC_AERR_RIGHTS_ESC
end
ret 0
end
ret irc
end

note Evaluate requested capabilities against policy; writes granted records into grants[0..gcnt*48)
note and granted_capability_digest into gdig. Returns gcnt (0..16), or >16 on error.
fn ksc_policy_eval_caps pol view uchar 1088 reqs view uchar * rcnt ulong grants edit uchar 768 gdig edit uchar 32 to ulong
grec = new uchar 48 0
gcnt = ulong 0
for i ulong rcnt bound 16
irc = ksc_policy_eval_one pol part reqs mul i KSC_POLICY_REC_SIZE 48 grec
if eq irc 0
ksc_copy part grants mul gcnt 48 48 grec
gcnt = add gcnt 1
else
if gt irc 1
ret irc
end
end
end
ksc_grants_digest grants gcnt gdig
ret gcnt
end

note =========================================================================
note 7. Artifact Loader Layout, W^X Audit, Fault Classification, Receipt Flags
note =========================================================================

note lens[0]=code_len, [1]=data_len, [2]=data_mem_len, [3]=entry_offset
note out_lay[0]=base, [1]=code_base, [2]=code_end, [3]=data_base, [4]=data_end,
note         [5]=stack_base, [6]=stack_top, [7]=entry_pc, [8]=content_frames,
note         [9]=total_frames, [10]=data_first, [11]=stack_first
fn ksc_task_layout_init win_idx ulong res view ulong 9 lens view ulong 4 out_lay edit ulong 12 to ulong
if eq win_idx 0
ret KSC_AERR_RESOURCE_LIMIT
end
if ge win_idx 256
ret KSC_AERR_RESOURCE_LIMIT
end
cp = get res 0
dp = get res 1
sp = get res 2
if eq cp 0
ret KSC_AERR_RESOURCE_LIMIT
end
if gt cp KSC_MAX_CODE_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if eq dp 0
ret KSC_AERR_RESOURCE_LIMIT
end
if gt dp KSC_MAX_DATA_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if eq sp 0
ret KSC_AERR_RESOURCE_LIMIT
end
if gt sp KSC_MAX_STACK_PAGES
ret KSC_AERR_RESOURCE_LIMIT
end
if eq get lens 0 0
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lens 0 mul cp KSC_PAGE_SIZE
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lens 1 get lens 2
ret KSC_AERR_RESOURCE_LIMIT
end
if gt get lens 2 mul dp KSC_PAGE_SIZE
ret KSC_AERR_RESOURCE_LIMIT
end
if ne and get lens 3 3 0
ret KSC_AERR_BAD_ENTRY
end
if gt add get lens 3 4 get lens 0
ret KSC_AERR_BAD_ENTRY
end
dfirst = add 2 cp
sfirst = add add dfirst dp 1
if gt add add sfirst sp 1 512
ret KSC_AERR_RESOURCE_LIMIT
end
base = shl win_idx 39
put out_lay 0 base
put out_lay 1 add base KSC_PAGE_SIZE
put out_lay 2 add add base KSC_PAGE_SIZE mul cp KSC_PAGE_SIZE
put out_lay 3 add base mul dfirst KSC_PAGE_SIZE
put out_lay 4 add add base mul dfirst KSC_PAGE_SIZE mul dp KSC_PAGE_SIZE
put out_lay 5 add base mul sfirst KSC_PAGE_SIZE
put out_lay 6 add add base mul sfirst KSC_PAGE_SIZE mul sp KSC_PAGE_SIZE
put out_lay 7 add add base KSC_PAGE_SIZE get lens 3
put out_lay 8 add add cp dp sp
put out_lay 9 add add add cp dp sp KSC_TABLE_FRAMES
put out_lay 10 dfirst
put out_lay 11 sfirst
ret KSC_AERR_OK
end

fn ksc_page_desc_is_wx desc ulong to bool
if eq desc 0
ret false
end
writable = eq and desc KSC_AP_RO 0
if not writable
ret false
end
if eq and desc KSC_UXN 0
ret true
end
if eq and desc KSC_PXN 0
ret true
end
ret false
end

fn ksc_audit_code_alias leaf ulong expected_pa ulong to bool
if ne and leaf 3 KSC_DESC_TABLE
ret false
end
if ne and leaf KSC_ADDR_MASK expected_pa
ret false
end
if eq and leaf KSC_AP_RO 0
ret false
end
if eq and leaf KSC_PXN 0
ret false
end
if eq and leaf KSC_UXN 0
ret false
end
ret true
end

note ranges[0]=code_base, [1]=code_end, [2]=data_base, [3]=data_end, [4]=stack_base, [5]=stack_end
fn ksc_classify_fault esr ulong far ulong ranges view ulong 6 to ulong
ec = and shr esr 26 0x3f
status = and shr esr 2 0xf
perm = eq status 3
trans = eq status 1
if eq ec 0x24
if ne and esr shl ulong 1 6 0
if perm
if ge far get ranges 0
if lt far get ranges 1
ret KSC_FAULT_CODE_WRITE
end
end
end
end
ret KSC_FAULT_OTHER
end
if eq ec 0x20
if perm
in_ds = false
if ge far get ranges 2
if lt far get ranges 3
in_ds = true
end
end
if ge far get ranges 4
if lt far get ranges 5
in_ds = true
end
end
if in_ds
ret KSC_FAULT_EXEC_NX
end
end
if trans
ret KSC_FAULT_EXEC_UNMAPPED
end
end
ret KSC_FAULT_OTHER
end

note Compute ADR 0014 §7 receipt result_flags bitmask.
note obs[0]=admitted, [1]=reclaimed, [2]=reads_ok, [3]=write_denials,
note     [4]=forged_denials, [5]=exited_zero, [6]=mapped_match,
note     [7]=byte_chain, [8]=wx_sealed
fn ksc_receipt_flags obs view ulong 9 to ulong
flags = ulong 0
if ne get obs 1 0
flags = or flags KSC_RFLAG_RECLAIMED
end
if eq get obs 0 0
ret flags
end
if gt get obs 2 0
flags = or flags KSC_RFLAG_READ_OK
end
if gt get obs 3 0
flags = or flags KSC_RFLAG_WRITE_DENIED
end
if gt get obs 4 0
flags = or flags KSC_RFLAG_FORGED_DENIED
end
if ne get obs 5 0
flags = or flags KSC_RFLAG_CANARY_PASSED
end
if ne get obs 6 0
flags = or flags KSC_RFLAG_MAPPED_MATCH
end
if ne get obs 7 0
flags = or flags KSC_RFLAG_EXECUTED_MATCH
end
if ne get obs 8 0
flags = or flags KSC_RFLAG_WX_SEALED
end
ret flags
end

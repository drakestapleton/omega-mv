note USB and xHCI stack for aienos-kernel in pure OM-2
note Ported from crates/aienos-kernel/src/usb/{mod,descriptor,hid,audio}.rs
note and crates/aienos-kernel/src/usb/xhci/{mod,trb,ring,context,controller}.rs
note Library unit: composed with si/directives/om2.om; no om2 header, no fn main.

note === Structs (must precede all fn declarations; <=16 fields, <=64 cells) ===

struct KuxBootKbd ok bool cfg uchar iface uchar ep_addr uchar max_pkt ushort ival uchar end

struct KuxKeyEvent kind uchar ch uchar end

struct KuxKbdDec prev uchar 6 end

struct KuxTextSink buf uchar 48 cnt ulong cap ulong end

struct KuxAudioStream ok bool ver uchar ctrl_if uchar iface uchar alt uchar ep_addr uchar max_pkt ushort ival uchar chans uchar subframe uchar bit_res uchar has_clk bool clk_src uchar rates uint 8 rate_cnt uchar end

struct KuxPcmFramer ok bool rate uint chans uchar sbytes uchar ival_us uint rem_val ulong end

struct KuxTestTone ok bool phase uint step uint end

struct KuxCaps ok bool op_off ulong rt_off ulong db_off ulong max_slots uchar max_ports uchar scratch ushort addr64 bool ctx_bytes ulong end

struct KuxTrb w uint 4 end

struct KuxSetup req_type uchar req uchar val ushort idx ushort wlen ushort end

struct KuxProdRing ok bool ring_len ulong dma ulong enq ulong cycle bool end

struct KuxEventRing ok bool ring_len ulong dma ulong deq ulong cycle bool end

struct KuxEpCfg ep_type uchar max_pkt ushort max_burst uchar ival uchar deq ulong avg_trb ushort max_esit ushort end

struct KuxInCtx ok bool stride ulong end

struct KuxDeadline start ulong ticks ulong polls uint end

struct KuxCtrlState state uchar err uchar err_code uchar ctx_bytes ulong slot uchar dci uchar port uchar ep_addr uchar has_dev bool retire_pend bool is_halted bool last_ev uint 4 db_cnt uint erdp_cnt uint last_erdp ulong end

note === Text tables for HID boot keyboard ===

text kux_keymap "aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ1!2@3#4$5%6^7&8*9(0)"
text kux_punct "  -_=+[{]}\\|#~;:'\"`~,<.>/?"

note === USB Descriptor constants ===

const KUX_DESC_DEVICE uchar 1
const KUX_DESC_CONFIG uchar 2
const KUX_DESC_IFACE uchar 4
const KUX_DESC_ENDPOINT uchar 5
const KUX_DESC_CS_IFACE uchar 0x24
const KUX_DESC_CS_EP uchar 0x25
const KUX_CLASS_HID uchar 3
const KUX_SUBCLASS_BOOT uchar 1
const KUX_PROTO_KBD uchar 1
const KUX_XFER_INTERRUPT uchar 3

note === HID Boot Keyboard constants ===

const KUX_MOD_LCTRL uchar 1
const KUX_MOD_LSHIFT uchar 2
const KUX_MOD_LALT uchar 4
const KUX_MOD_RCTRL uchar 16
const KUX_MOD_RSHIFT uchar 32
const KUX_MOD_RALT uchar 64
const KUX_MOD_ANY_SHIFT uchar 34
const KUX_BOOT_REPORT_LEN ulong 8
const KUX_MAX_KEYS ulong 6

const KUX_KEY_NONE uchar 0
const KUX_KEY_CHAR uchar 1
const KUX_KEY_ENTER uchar 2
const KUX_KEY_BACKSPACE uchar 3
const KUX_KEY_TAB uchar 4
const KUX_KEY_ESCAPE uchar 5
const KUX_KEY_UP uchar 6
const KUX_KEY_DOWN uchar 7
const KUX_KEY_LEFT uchar 8
const KUX_KEY_RIGHT uchar 9

const KUX_USAGE_ENTER uchar 0x28
const KUX_USAGE_ESCAPE uchar 0x29
const KUX_USAGE_BACKSPACE uchar 0x2a
const KUX_USAGE_TAB uchar 0x2b
const KUX_USAGE_CAPS_LOCK uchar 0x39
const KUX_USAGE_F1 uchar 0x3a
const KUX_USAGE_F12 uchar 0x45
const KUX_USAGE_RIGHT_ARROW uchar 0x4f
const KUX_USAGE_LEFT_ARROW uchar 0x50
const KUX_USAGE_DOWN_ARROW uchar 0x51
const KUX_USAGE_UP_ARROW uchar 0x52

note === USB Audio Class constants ===

const KUX_AUDIO_NONE uchar 0
const KUX_AUDIO_UAC1 uchar 1
const KUX_AUDIO_UAC2 uchar 2


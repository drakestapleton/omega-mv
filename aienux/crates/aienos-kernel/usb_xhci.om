const KUX_PCI_CMD_MEMORY ushort 0x0002
const KUX_PCI_CMD_BUS_MASTER ushort 0x0004

const KUX_OP_USBCMD ulong 0x00
const KUX_OP_USBSTS ulong 0x04
const KUX_OP_CRCR ulong 0x18
const KUX_OP_DCBAAP ulong 0x30
const KUX_OP_CONFIG ulong 0x38

fn t_first_role_pos rl ulong to ulong
sc = get exp_b_scnt 0
for i ulong sc bound 320
if eq get exp_bs_role i rl
ret i
end
end
ret EXP_NONE
end

fn t_17_check_roles ci ulong to int
prev = t_first_role_pos EXP_ROLE_OBSERVED
cur = t_first_role_pos EXP_ROLE_ANALYSIS
if ge prev cur
ret 141
end
prev = cur
cur = t_first_role_pos EXP_ROLE_HYPOTHESIS
if ge prev cur
ret 141
end
prev = cur
cur = t_first_role_pos EXP_ROLE_PREDICTION
if ge prev cur
ret 142
end
prev = cur
cur = t_first_role_pos EXP_ROLE_FALSIFICATION
if ge prev cur
ret 142
end
prev = cur
cur = t_first_role_pos EXP_ROLE_EVALUATION
if ge prev cur
ret 143
end
prev = cur
cur = t_first_role_pos EXP_ROLE_DECISION
if ge prev cur
ret 143
end
cur = t_first_role_pos EXP_ROLE_CONCLUSION
if ne cur ci
ret 144
end
ret 0
end

fn t_17_rsi_cycle to int
t_build_rsi_fixture
rc = exp_build_bundle r_id_co EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 139
end
ci = sub get exp_b_concl_step 0 1
if not exp_bundle_step_eq add ci 1 r_id_co
ret 140
end
rc = t_17_check_roles ci
if ne rc 0
ret rc
end
if not exp_bundle_has_unc EXP_UK_MISSING_LINK
ret 145
end
if not exp_bundle_has_unc EXP_UK_HYPO_NOT_FALSIFIED
ret 146
end
if not exp_bundle_has_unc EXP_UK_UNKNOWN
ret 147
end
if ne get exp_ba_cnt 0 3
ret 148
end
st = exp_bundle_find_step r_id_re
if eq st 0
ret 149
end
if ne get exp_gn_status get exp_bs_nid sub st 1 EXP_ST_VERIFIED_FACT
ret 150
end
st = exp_bundle_find_step r_id_rs
if eq st 0
ret 151
end
if ne get exp_gn_status get exp_bs_nid sub st 1 EXP_ST_UNCLASSIFIED
ret 152
end
st = exp_bundle_find_step r_id_hy
if eq st 0
ret 153
end
if ne get exp_gn_status get exp_bs_nid sub st 1 EXP_ST_HYPOTHESIS
ret 154
end
ol = exp_render EXP_MODE_STEP_BY_STEP EXP_LEVEL_DEFAULT EXP_AUD_OPERATOR
if not exp_out_contains exp_rh_0
ret 155
end
if not exp_out_contains exp_rh_1
ret 156
end
if not exp_out_contains exp_rh_2
ret 157
end
if not exp_out_contains exp_rh_3
ret 158
end
if not exp_out_contains exp_rh_4
ret 159
end
if not exp_out_contains exp_rh_5
ret 160
end
if not exp_out_contains exp_rh_6
ret 161
end
if not exp_out_contains exp_rh_7
ret 162
end
d1 = new uchar 32 0
exp_bundle_get_digest d1
t_build_rsi_fixture
rc = exp_build_bundle r_id_co EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 163
end
d2 = new uchar 32 0
exp_bundle_get_digest d2
if not t_bytes_eq d1 d2
ret 164
end
ret 0
end

note 18. contradiction_disclosed_in_both_directions
fn t_18_bidirectional_contra to int
exp_g_reset_prod t_prod
n0 = t_add_simple_node t_bi_obs EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS
n1 = t_add_simple_node t_bi_riv EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS
exp_g_add_edge n1 t_bi_obs EXP_REL_CONTRADICTS
n2 = t_add_simple_node t_bi_clm EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE
exp_g_add_edge n2 t_bi_obs EXP_REL_SUPPORTED_BY
exp_g_add_edge n2 t_bi_oth EXP_REL_CONTRADICTS
n3 = t_add_simple_node t_bi_oth EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS
rc = exp_build_bundle t_bi_clm EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 165
end
has_riv = false
has_clm = false
cc = get exp_bc_cnt 0
for i ulong cc bound 128
nid = get exp_bc_nid i
if exp_str_eq_view get exp_gn_id_off nid get exp_gn_id_len nid t_bi_riv
has_riv = true
end
if exp_str_eq_view get exp_gn_id_off nid get exp_gn_id_len nid t_bi_clm
has_clm = true
end
end
if not has_riv
ret 166
end
if not has_clm
ret 167
end
if ne exp_bundle_find_step t_bi_riv 0
ret 168
end
if ne exp_bundle_find_step t_bi_oth 0
ret 169
end
ret 0
end

note 19 & 20. CLI helpers + tampered bundle digest rejection
fn t_19_20_cli_and_tamper to int
if ne exp_cli_exit_code EXP_OK 0
ret 170
end
if ne exp_cli_exit_code EXP_ERR_TARGET_NOT_FOUND 15
ret 171
end
if ne exp_parse_audience t_cli_aud_se EXP_AUD_SYSTEMS_ENG
ret 172
end
if ne exp_parse_audience t_cli_aud_bad EXP_AUD_INVALID
ret 173
end
cid1 = new uchar 16 0
cid2 = new uchar 16 0
if ne exp_parse_cortex_id t_cli_hex_raw cid1 EXP_OK
ret 174
end
if ne exp_parse_cortex_id t_cli_hex_pfx cid2 EXP_OK
ret 175
end
if not t_bytes_eq cid1 cid2
ret 176
end
if ne get cid1 0 1
ret 177
end
if ne get cid1 15 16
ret 178
end
if ne exp_parse_cortex_id t_cli_hex_bad cid1 EXP_ERR_TARGET_NOT_FOUND
ret 179
end
note Tampering a built bundle breaks digest verification
if not exp_bundle_verify_digest
ret 180
end
put exp_bs_depth 0 add get exp_bs_depth 0 1
if exp_bundle_verify_digest
ret 181
end
ret 0
end


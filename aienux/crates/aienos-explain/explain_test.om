if ne rc EXP_ERR_INVALID_LIMITS
ret 102
end
rc = exp_build_bundle t_id_n1 1 1000000
if ne rc EXP_ERR_INVALID_LIMITS
ret 103
end
ret t_14_wide_fanin
end


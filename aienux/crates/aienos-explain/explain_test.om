note Scratch buffers for comparing saved renders / journals
global t_buf_a uchar 16384
global t_buf_b uchar 16384
global t_jbuf uchar 8192

fn t_bytes_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 16384
if ne get a i get b i
ret false
end
end
ret true
end

fn t_add_std_node id view uchar * kd ulong st ulong stmt view uchar * to ulong
nid = exp_g_add_node id kd st stmt
exp_g_set_source_sa nid t_sys t_art
exp_g_set_source_ref nid id
ret nid
end

fn t_add_simple_node id view uchar * kd ulong st ulong to ulong
io = exp_str_add_view id
nid = exp_g_add_node_raw io len id kd st
put exp_gn_stmt_off nid io
put exp_gn_stmt_len nid len id
exp_g_set_source_sa nid t_sys t_art
exp_g_set_source_ref nid id
ret nid
end

fn t_cx_node_id_eq step1 ulong rec_idx ulong to bool
id = new uchar 16 0
exp_cx_get_id rec_idx id
nid = get exp_bs_nid sub step1 1
want_o = exp_cx_node_id_str id
ret exp_str_eq get exp_gn_id_off nid get exp_gn_id_len nid want_o 39
end

note 1. linear_chain_is_ordered_parents_first
fn t_01_linear_chain to int
exp_cx_reset
obs = exp_cx_add_rec EXP_ST_DIRECT_OBS t_lc_obs_s t_lc_obs_p
exp_cx_set_ev obs t_lc_obs_e
exp_cx_set_meta obs 10 0 0
obs_id = new uchar 16 0
exp_cx_get_id obs obs_id
i1 = exp_cx_add_rec EXP_ST_INFERENCE t_lc_i1_s t_lc_i1_p
exp_cx_set_meta i1 20 1 900
exp_cx_add_parent i1 obs_id
i1_id = new uchar 16 0
exp_cx_get_id i1 i1_id
i2 = exp_cx_add_rec EXP_ST_INFERENCE t_lc_i2_s t_lc_i2_p
exp_cx_set_meta i2 30 1 800
exp_cx_add_parent i2 i1_id
i2_id = new uchar 16 0
exp_cx_get_id i2 i2_id
rc = exp_cx_graph_for_record i2_id EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 1
end
tgt_o = exp_cx_node_id_str i2_id
rc = exp_build_bundle_raw tgt_o 39 EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 2
end
if ne get exp_b_scnt 0 3
ret 3
end
if not t_cx_node_id_eq 1 obs
ret 4
end
if not t_cx_node_id_eq 2 i1
ret 5
end
if not t_cx_node_id_eq 3 i2
ret 6
end
if ne get exp_bs_sup_step get exp_bs_sup_off 1 1
ret 7
end
if ne get exp_bs_sup_step get exp_bs_sup_off 2 2
ret 8
end
if eq get exp_bs_gnd 0 0
ret 9
end
if ne get exp_bs_role 0 EXP_ROLE_OBSERVED
ret 10
end
if exp_bundle_has_unc EXP_UK_MISSING_PARENT
ret 11
end
if not exp_bundle_verify_digest
ret 12
end
ret 0
end

note 2. branching_support_is_deterministic_regardless_of_input_order
fn t_02_branching_determinism to int
exp_g_reset_prod t_prod
nc = t_add_std_node t_id_c EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_c
exp_g_add_edge nc t_id_z EXP_REL_SUPPORTED_BY
exp_g_add_edge nc t_id_a EXP_REL_SUPPORTED_BY
exp_g_add_edge nc t_id_m EXP_REL_SUPPORTED_BY
nz = t_add_std_node t_id_z EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS t_st_z
na = t_add_std_node t_id_a EXP_KD_CORTEX_RECORD EXP_ST_VERIFIED_FACT t_st_a
nm = t_add_std_node t_id_m EXP_KD_CORTEX_RECORD EXP_ST_OPERATOR_DECISION t_st_m
rc = exp_build_bundle t_id_c EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 13
end
if ne get exp_b_scnt 0 4
ret 14
end
if not exp_bundle_step_eq 1 t_id_a
ret 15
end
if not exp_bundle_step_eq 2 t_id_z
ret 16
end
if not exp_bundle_step_eq 3 t_id_m
ret 17
end
if not exp_bundle_step_eq 4 t_id_c
ret 18
end
note Reversed input order produces identical step sequence
exp_g_reset_prod t_prod
nm2 = t_add_std_node t_id_m EXP_KD_CORTEX_RECORD EXP_ST_OPERATOR_DECISION t_st_m
na2 = t_add_std_node t_id_a EXP_KD_CORTEX_RECORD EXP_ST_VERIFIED_FACT t_st_a
nz2 = t_add_std_node t_id_z EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS t_st_z
nc2 = t_add_std_node t_id_c EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_c
exp_g_add_edge nc2 t_id_m EXP_REL_SUPPORTED_BY
exp_g_add_edge nc2 t_id_a EXP_REL_SUPPORTED_BY
exp_g_add_edge nc2 t_id_z EXP_REL_SUPPORTED_BY
rc = exp_build_bundle t_id_c EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 19
end
if not exp_bundle_step_eq 1 t_id_a
ret 20
end
if not exp_bundle_step_eq 2 t_id_z
ret 21
end
if not exp_bundle_step_eq 3 t_id_m
ret 22
end
if not exp_bundle_step_eq 4 t_id_c
ret 23
end
ret 0
end

note 3. shared_parent_appears_once
fn t_03_shared_parent to int
exp_g_reset_prod t_prod
n0 = t_add_std_node t_id_concl EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_concl
exp_g_add_edge n0 t_id_i1 EXP_REL_SUPPORTED_BY
exp_g_add_edge n0 t_id_i2 EXP_REL_SUPPORTED_BY
n1 = t_add_std_node t_id_i1 EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_i1
exp_g_add_edge n1 t_id_obs EXP_REL_SUPPORTED_BY
n2 = t_add_std_node t_id_i2 EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_i2
exp_g_add_edge n2 t_id_obs EXP_REL_SUPPORTED_BY
n3 = t_add_std_node t_id_obs EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS t_st_obs
exp_g_set_digest n3 t_dig64
rc = exp_build_bundle t_id_concl EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 24
end
if ne get exp_b_scnt 0 4
ret 25
end
if ne get exp_be_cnt 0 1
ret 26
end
if not exp_bundle_step_eq 1 t_id_obs
ret 27
end
ret 0
end

note 4. cycle_terminates_and_is_reported
fn t_04_cycle_direct to int
exp_g_reset_prod t_prod
na = t_add_std_node t_id_A EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_A
exp_g_add_edge na t_id_B EXP_REL_SUPPORTED_BY
nb = t_add_std_node t_id_B EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_B
exp_g_add_edge nb t_id_C EXP_REL_SUPPORTED_BY
nc = t_add_std_node t_id_C EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_C
exp_g_add_edge nc t_id_A EXP_REL_SUPPORTED_BY
rc = exp_build_bundle t_id_A EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 28
end
if ne get exp_b_scnt 0 3
ret 29
end
if not exp_bundle_step_eq 3 t_id_A
ret 30
end
ccnt = ulong 0
cidx = EXP_NONE
uc = get exp_bu_cnt 0
for i ulong uc bound 512
if eq get exp_bu_kind i EXP_UK_CYCLE
ccnt = add ccnt 1
cidx = i
end
end
if ne ccnt 1
ret 31
end
if not exp_str_eq_view get exp_bu_nid_off cidx get exp_bu_nid_len cidx t_id_C
ret 32
end
if not exp_str_eq_view get exp_bu_rel_off cidx get exp_bu_rel_len cidx t_id_A
ret 33
end
ol = exp_render EXP_MODE_STEP_BY_STEP EXP_LEVEL_DEFAULT EXP_AUD_OPERATOR
if not exp_out_contains t_w_circular
ret 34
end
ret 0
end

note 5. cycle_through_imported_cortex_journal_terminates
fn t_05_cycle_cortex to int
exp_cx_reset
id1 = new uchar 16 1
id2 = new uchar 16 2
id3 = new uchar 16 3
r1 = exp_cx_add_rec EXP_ST_INFERENCE t_cy1 t_prod
exp_cx_set_id r1 id1
exp_cx_add_parent r1 id2
r2 = exp_cx_add_rec EXP_ST_INFERENCE t_cy2 t_prod
exp_cx_set_id r2 id2
exp_cx_add_parent r2 id3
r3 = exp_cx_add_rec EXP_ST_INFERENCE t_cy3 t_prod
exp_cx_set_id r3 id3
exp_cx_add_parent r3 id1
rc = exp_cx_graph_for_record id1 EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 35
end
tgt_o = exp_cx_node_id_str id1
rc = exp_build_bundle_raw tgt_o 39 EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 36
end
if ne get exp_b_scnt 0 3
ret 37
end
if not exp_bundle_has_unc EXP_UK_CYCLE
ret 38
end
ret 0
end

note 6 & 7. missing_parent_stays_missing and unsupported_claim_is_flagged
fn t_06_07_missing_and_unsupported to int
exp_g_reset_prod t_prod
nc = t_add_std_node t_id_concl EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_concl
exp_g_add_edge nc t_id_obs EXP_REL_SUPPORTED_BY
exp_g_add_edge nc t_id_ghost EXP_REL_SUPPORTED_BY
no = t_add_std_node t_id_obs EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS t_st_obs
rc = exp_build_bundle t_id_concl EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 39
end
if ne get exp_b_scnt 0 2
ret 40
end
if not exp_bundle_step_eq 1 t_id_obs
ret 41
end
if not exp_bundle_step_eq 2 t_id_concl
ret 42
end
found_ghost = false
uc = get exp_bu_cnt 0
for i ulong uc bound 512
if eq get exp_bu_kind i EXP_UK_MISSING_PARENT
if exp_str_eq_view get exp_bu_rel_off i get exp_bu_rel_len i t_id_ghost
found_ghost = true
end
end
end
if not found_ghost
ret 43
end
ol = exp_render EXP_MODE_SUMMARY EXP_LEVEL_DEFAULT EXP_AUD_OPERATOR
if not exp_out_contains t_w_noev
ret 44
end
note Unsupported claim
exp_g_reset_prod t_prod
nl = t_add_std_node t_id_lonely EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE t_st_lonely
rc = exp_build_bundle t_id_lonely EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 45
end
if not exp_bundle_has_unc EXP_UK_UNSUPPORTED
ret 46
end
ret 0
end

note 8. contradiction_remains_visible
fn t_08_contradiction to int
exp_cx_reset
o1 = exp_cx_add_rec EXP_ST_DIRECT_OBS t_co_o1_s t_co_o1_p
exp_cx_set_ev o1 t_co_o1_e
o1_id = new uchar 16 0
exp_cx_get_id o1 o1_id
o2 = exp_cx_add_rec EXP_ST_DIRECT_OBS t_co_o2_s t_co_o2_p
exp_cx_set_ev o2 t_co_o2_e
o2_id = new uchar 16 0
exp_cx_get_id o2 o2_id
fl = exp_cx_add_rec EXP_ST_CONTRADICTION t_co_fl_s t_prod
exp_cx_add_parent fl o1_id
exp_cx_add_parent fl o2_id
inf = exp_cx_add_rec EXP_ST_INFERENCE t_co_in_s t_co_in_p
exp_cx_set_meta inf 4 1 700
exp_cx_add_parent inf o1_id
inf_id = new uchar 16 0
exp_cx_get_id inf inf_id
rc = exp_cx_graph_for_record inf_id EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 47
end
tgt_o = exp_cx_node_id_str inf_id
rc = exp_build_bundle_raw tgt_o 39 EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 48
end
if ne get exp_bc_cnt 0 1
ret 49
end
if ne get exp_bc_inv_cnt 0 1
ret 50
end
if not exp_bundle_has_unc EXP_UK_CONFLICT
ret 51
end
if ne get exp_b_scnt 0 2
ret 52
end
ol = exp_render EXP_MODE_STEP_BY_STEP EXP_LEVEL_DEFAULT EXP_AUD_OPERATOR
if not exp_out_contains t_w_conflicts
ret 53
end
if not exp_out_contains t_co_fl_s
ret 54
end
ol = exp_render EXP_MODE_SUMMARY EXP_LEVEL_DEFAULT EXP_AUD_OPERATOR
if not exp_out_contains t_w_munc
ret 55
end
if not exp_out_contains t_w_contra
ret 56
end
ret 0
end

note 9. hypothesis_is_never_rendered_as_fact
fn t_09_hypothesis_never_fact to int
exp_cx_reset
o = exp_cx_add_rec EXP_ST_DIRECT_OBS t_hy_o_s t_hy_o_p
exp_cx_set_ev o t_hy_o_e
o_id = new uchar 16 0
exp_cx_get_id o o_id
h = exp_cx_add_rec EXP_ST_HYPOTHESIS t_hy_h_s t_hy_h_p
exp_cx_add_parent h o_id
h_id = new uchar 16 0
exp_cx_get_id h h_id
inf = exp_cx_add_rec EXP_ST_INFERENCE t_hy_i_s t_hy_i_p
exp_cx_set_meta inf 3 1 600
exp_cx_add_parent inf h_id
inf_id = new uchar 16 0
exp_cx_get_id inf inf_id
rc = exp_cx_graph_for_record inf_id EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 57
end
tgt_o = exp_cx_node_id_str inf_id
rc = exp_build_bundle_raw tgt_o 39 EXP_DEFAULT_MAX_DEPTH EXP_DEFAULT_MAX_NODES
if ne rc EXP_OK
ret 58
end
if not exp_bundle_has_unc EXP_UK_HYPO_NOT_FALSIFIED
ret 59
end
for md ulong 4
for a_i ulong 2
aud = EXP_AUD_GENERAL
if eq a_i 1
aud = EXP_AUD_DEVELOPER
end
ol = exp_render md 4 aud
if exp_out_any_line_has_both t_hy_h_s t_w_chkfact
ret 60
end
if exp_out_any_line_has_both t_hy_h_s t_w_verfact
ret 61
end
if exp_out_any_line_has_both t_hy_h_s t_w_obsbr
ret 62
end
end
end
exp_out_reset
exp_out_status_words EXP_ST_HYPOTHESIS
if not exp_out_contains t_w_notest
ret 63
end
ret 0
end

fn t_10_check_steps u ulong d ulong un ulong to int
found_u = false
found_d = false
found_un = false
sc = get exp_b_scnt 0
for i ulong sc bound 320
if t_cx_node_id_eq add i 1 u
found_u = true
if ne get exp_bs_bref i 0
ret 67
end
end
if t_cx_node_id_eq add i 1 d
found_d = true
if eq get exp_bs_bref i 0
ret 68
end
end
if t_cx_node_id_eq add i 1 un
found_un = true
end
end
if not found_u
ret 69
end
if not found_d
ret 70
end
if found_un
ret 71
end
ret 0
end


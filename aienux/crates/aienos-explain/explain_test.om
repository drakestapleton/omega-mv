fn t_14_wide_fanin to int
exp_g_reset_prod t_prod
top = t_add_simple_node t_id_top EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE
exp_g_add_edge top t_id_m0 EXP_REL_SUPPORTED_BY
exp_g_add_edge top t_id_m1 EXP_REL_SUPPORTED_BY
exp_g_add_edge top t_id_m2 EXP_REL_SUPPORTED_BY
m0 = t_add_simple_node t_id_m0 EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE
m1 = t_add_simple_node t_id_m1 EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE
m2 = t_add_simple_node t_id_m2 EXP_KD_CORTEX_RECORD EXP_ST_INFERENCE
for k ulong 180
po = exp_str_mark
exp_str_put_b uchar 112
exp_str_add_u64 k
pl = sub exp_str_mark po
pn = exp_g_add_node_raw po pl EXP_KD_CORTEX_RECORD EXP_ST_DIRECT_OBS
put exp_gn_stmt_off pn po
put exp_gn_stmt_len pn pl
if lt k 60
exp_g_add_edge_raw m0 po pl EXP_REL_SUPPORTED_BY
else
if lt k 120
exp_g_add_edge_raw m1 po pl EXP_REL_SUPPORTED_BY
else
exp_g_add_edge_raw m2 po pl EXP_REL_SUPPORTED_BY
end
end
end
rc = exp_build_bundle t_id_top 32 100
if ne rc EXP_OK
ret 104
end
if gt get exp_b_scnt 0 100
ret 105
end
if not exp_bundle_has_unc EXP_UK_TRUNCATED
ret 106
end
ret 0
end


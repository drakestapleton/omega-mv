fn exp_effective_level md ulong lv ulong to ulong
eff = lv
if eq eff EXP_LEVEL_DEFAULT
if eq md EXP_MODE_SUMMARY
eff = 1
else
if eq md EXP_MODE_TECHNICAL
eff = 4
else
eff = 2
end
end
end
if gt eff EXP_MAX_LEVEL
eff = EXP_MAX_LEVEL
end
ret eff
end

fn exp_aud_shows_ids aud ulong to bool
ret ne aud EXP_AUD_GENERAL
end

fn exp_out_short_id off ulong ln ulong to void
colon = EXP_NONE
for i ulong ln bound 256
if eq get exp_str add off i 58
colon = i
break
end
end
if ne colon EXP_NONE
rest = sub ln add colon 1
if gt rest 12
exp_out_arena off add colon 13
ret
end
end
exp_out_arena off ln
end

fn exp_out_header aud ulong to void
ci = sub get exp_b_concl_step 0 1
nid = get exp_bs_nid ci
exp_out_view exp_s_concl
exp_out_arena get exp_gn_stmt_off nid get exp_gn_stmt_len nid
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status nid
exp_out_b uchar 93
if exp_aud_shows_ids aud
exp_out_b uchar 32
exp_out_b uchar 40
exp_out_short_id get exp_gn_id_off nid get exp_gn_id_len nid
exp_out_b uchar 41
end
exp_out_b uchar 10
end

fn exp_out_meas_line nid ulong indent ulong to bool
mc = get exp_g_mcnt 0
found = ulong 0
for m ulong mc bound 256
if eq get exp_gm_owner m nid
if eq found 0
if ne indent 0
exp_out_view exp_s_meas
else
exp_out_view exp_s_meas_ni
end
else
exp_out_b uchar 44
exp_out_b uchar 32
end
exp_out_arena get exp_gm_name_off m get exp_gm_name_len m
exp_out_b uchar 61
exp_out_arena get exp_gm_val_off m get exp_gm_val_len m
if gt get exp_gm_unit_len m 0
exp_out_b uchar 32
exp_out_arena get exp_gm_unit_off m get exp_gm_unit_len m
end
found = add found 1
end
end
if gt found 0
exp_out_b uchar 10
ret true
end
ret false
end

fn exp_out_step_line si ulong lv ulong aud ulong to void
nid = get exp_bs_nid si
exp_out_u64 add si 1
exp_out_b uchar 46
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status nid
exp_out_b uchar 93
exp_out_b uchar 32
exp_out_arena get exp_gn_stmt_off nid get exp_gn_stmt_len nid
if ge lv 2
soff = get exp_bs_sup_off si
scnt = get exp_bs_sup_cnt si
sc = ulong 0
for k ulong scnt bound 1024
if ne get exp_bs_sup_rel add soff k EXP_REL_REFERENCES
if eq sc 0
exp_out_view exp_s_rests
else
exp_out_b uchar 44
exp_out_b uchar 32
end
exp_out_u64 get exp_bs_sup_step add soff k
sc = add sc 1
end
end
if gt sc 0
exp_out_b uchar 41
end
wc = ulong 0
for k ulong scnt bound 1024
if eq get exp_bs_sup_rel add soff k EXP_REL_REFERENCES
if eq wc 0
exp_out_view exp_s_refers
else
exp_out_b uchar 44
exp_out_b uchar 32
end
exp_out_u64 get exp_bs_sup_step add soff k
wc = add wc 1
end
end
if gt wc 0
exp_out_view exp_s_weak
end
end
if exp_aud_shows_ids aud
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_arena get exp_gn_sys_off nid get exp_gn_sys_len nid
exp_out_b uchar 32
exp_out_short_id get exp_gn_id_off nid get exp_gn_id_len nid
exp_out_b uchar 93
else
exp_out_view exp_s_from
exp_out_arena get exp_gn_sys_off nid get exp_gn_sys_len nid
exp_out_b uchar 93
end
if ne get exp_bs_bref si 0
exp_out_view exp_s_br_ref
end
exp_out_b uchar 10
end

fn exp_reason_better si ulong best ulong to bool
bg = get exp_bs_gnd best
sg = get exp_bs_gnd si
if gt sg bg
ret true
end
if lt sg bg
ret false
end
bnid = get exp_bs_nid best
snid = get exp_bs_nid si
bnh = ulong 1
if eq get exp_gn_status bnid EXP_ST_HYPOTHESIS
bnh = 0
end
snh = ulong 1
if eq get exp_gn_status snid EXP_ST_HYPOTHESIS
snh = 0
end
if gt snh bnh
ret true
end
if lt snh bnh
ret false
end
bc = ulong 0
if ne get exp_gn_has_conf bnid 0
bc = get exp_gn_conf bnid
end
sc = ulong 0
if ne get exp_gn_has_conf snid 0
sc = get exp_gn_conf snid
end
if gt sc bc
ret true
end
if lt sc bc
ret false
end
ret gt si best
end

fn exp_strongest_reason to ulong
ci = sub get exp_b_concl_step 0 1
soff = get exp_bs_sup_off ci
scnt = get exp_bs_sup_cnt ci
best = EXP_NONE
for k ulong scnt bound 1024
if ne get exp_bs_sup_rel add soff k EXP_REL_REFERENCES
si = sub get exp_bs_sup_step add soff k 1
if eq best EXP_NONE
best = si
else
if exp_reason_better si best
best = si
end
end
end
end
ret best
end

fn exp_strongest_evidence to ulong
evc = get exp_be_cnt 0
best = EXP_NONE
for i ulong evc bound 320
si = sub get exp_be_step i 1
if ne get exp_bs_gnd si 0
if eq best EXP_NONE
best = si
else
db = get exp_bs_depth best
ds = get exp_bs_depth si
if lt ds db
best = si
else
if eq ds db
if lt si best
best = si
end
end
end
end
end
end
ret best
end

fn exp_material_unc to ulong
uc = get exp_bu_cnt 0
best = EXP_NONE
for i ulong uc bound 512
if eq best EXP_NONE
best = i
else
sb = exp_uk_severity get exp_bu_kind best
si = exp_uk_severity get exp_bu_kind i
if lt si sb
best = i
else
if eq si sb
c1 = exp_str_cmp get exp_bu_nid_off i get exp_bu_nid_len i get exp_bu_nid_off best get exp_bu_nid_len best
if lt c1 0
best = i
else
if eq c1 0
if lt exp_str_cmp get exp_bu_det_off i get exp_bu_det_len i get exp_bu_det_off best get exp_bu_det_len best 0
best = i
end
end
end
end
end
end
end
ret best
end

fn exp_render_step_body si ulong lv ulong aud ulong to void
nid = get exp_bs_nid si
if eq add si 1 get exp_b_concl_step 0
exp_out_u64 add si 1
exp_out_view exp_s_therefore
exp_out_arena get exp_gn_stmt_off nid get exp_gn_stmt_len nid
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status nid
exp_out_b uchar 93
exp_out_b uchar 10
else
exp_out_step_line si lv aud
end
if ge lv 3
dm = exp_out_meas_line nid 1
end
if ge lv 4
exp_out_view exp_s_src
exp_out_arena get exp_gn_sys_off nid get exp_gn_sys_len nid
exp_out_b uchar 32
exp_out_arena get exp_gn_art_off nid get exp_gn_art_len nid
exp_out_b uchar 32
exp_out_arena get exp_gn_ref_off nid get exp_gn_ref_len nid
if ne get exp_gn_has_dig nid 0
exp_out_view exp_s_dig
exp_out_arena get exp_gn_dig_off nid get exp_gn_dig_len nid
end
exp_out_b uchar 10
end
end

fn exp_render_steps_footer lv ulong to void
exp_out_view exp_s_unc_hdr
uc = get exp_bu_cnt 0
shown_u = ulong 0
for i ulong uc bound 512
uk = get exp_bu_kind i
show = true
if lt lv 3
if eq uk EXP_UK_INFERRED
show = false
end
end
if show
exp_out_b uchar 45
exp_out_b uchar 32
exp_out_uk_label uk
exp_out_b uchar 58
exp_out_b uchar 32
exp_out_arena get exp_bu_det_off i get exp_bu_det_len i
exp_out_b uchar 10
shown_u = add shown_u 1
end
end
if eq shown_u 0
exp_out_view exp_s_no_gaps
end
cc = get exp_bc_cnt 0
if gt cc 0
exp_out_view exp_s_conf_hdr
for i ulong cc bound 128
exp_out_b uchar 45
exp_out_b uchar 32
exp_out_arena get exp_bc_stmt_off i get exp_bc_stmt_len i
exp_out_view exp_s_inv_a
exp_out_u64 get exp_bc_inv_cnt i
exp_out_view exp_s_inv_b
end
end
if ge lv 2
ac = get exp_ba_cnt 0
if gt ac 0
exp_out_view exp_s_alt_hdr
for i ulong ac bound 128
anid = get exp_ba_nid i
exp_out_b uchar 45
exp_out_b uchar 32
exp_out_arena get exp_gn_stmt_off anid get exp_gn_stmt_len anid
exp_out_b uchar 10
end
end
end
end

fn exp_render_steps lv ulong aud ulong to void
if eq lv 0
exp_out_header aud
ret
end
last_role = EXP_NONE
if eq lv 1
ci = sub get exp_b_concl_step 0 1
soff = get exp_bs_sup_off ci
scnt = get exp_bs_sup_cnt ci
for k ulong scnt bound 1024
si = sub get exp_bs_sup_step add soff k 1
rl = get exp_bs_role si
if ne rl last_role
exp_out_role_heading rl
exp_out_b uchar 58
exp_out_b uchar 10
last_role = rl
end
exp_render_step_body si lv aud
end
rl = get exp_bs_role ci
if ne rl last_role
exp_out_role_heading rl
exp_out_b uchar 58
exp_out_b uchar 10
end
exp_render_step_body ci lv aud
else
sc = get exp_b_scnt 0
for si ulong sc bound 320
rl = get exp_bs_role si
if ne rl last_role
exp_out_role_heading rl
exp_out_b uchar 58
exp_out_b uchar 10
last_role = rl
end
exp_render_step_body si lv aud
end
end
exp_render_steps_footer lv
end

fn exp_render_summary lv ulong aud ulong to void
exp_out_header aud
if eq lv 0
ret
end
sr = exp_strongest_reason
if ne sr EXP_NONE
rnid = get exp_bs_nid sr
exp_out_view exp_s_mreason
exp_out_arena get exp_gn_stmt_off rnid get exp_gn_stmt_len rnid
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status rnid
exp_out_b uchar 93
exp_out_b uchar 10
else
exp_out_view exp_s_no_reason
end
se = exp_strongest_evidence
if ne se EXP_NONE
enid = get exp_bs_nid se
exp_out_view exp_s_sev
exp_out_arena get exp_gn_stmt_off enid get exp_gn_stmt_len enid
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status enid
exp_out_b uchar 93
exp_out_b uchar 10
dm = exp_out_meas_line enid 0
else
exp_out_view exp_s_no_ev
end
mu = exp_material_unc
if ne mu EXP_NONE
exp_out_view exp_s_munc
exp_out_arena get exp_bu_det_off mu get exp_bu_det_len mu
exp_out_b uchar 10
else
exp_out_view exp_s_no_munc
end
if ge lv 2
exp_out_b uchar 10
exp_render_steps lv aud
end
end


fn exp_analogy_kind kd ulong st ulong to ulong
if eq kd EXP_KD_CAP_ANALYSIS
ret 1
end
if eq kd EXP_KD_HYPOTHESIS
ret 2
end
if eq kd EXP_KD_CORTEX_RECORD
if eq st EXP_ST_HYPOTHESIS
ret 2
end
end
if eq kd EXP_KD_FALSIFICATION
ret 3
end
if eq kd EXP_KD_EVAL_RECEIPT
ret 4
end
if eq kd EXP_KD_AGENT_BRANCH
ret 5
end
if eq st EXP_ST_CONTRADICTION
ret 6
end
ret 0
end

fn exp_out_analogy_text ak ulong to void
if eq ak 1
exp_out_view exp_ana_cap
ret
end
if eq ak 2
exp_out_view exp_ana_hyp
ret
end
if eq ak 3
exp_out_view exp_ana_fal
ret
end
if eq ak 4
exp_out_view exp_ana_evl
ret
end
if eq ak 5
exp_out_view exp_ana_brn
ret
end
exp_out_view exp_ana_con
end

fn exp_render_analogy lv ulong aud ulong to void
sc = get exp_b_scnt 0
pick_step = ulong 0
pick_ak = ulong 0
for k ulong sc bound 320
si = sub sub sc 1 k
nid = get exp_bs_nid si
ak = exp_analogy_kind get exp_gn_kind nid get exp_gn_status nid
if ne ak 0
pick_step = add si 1
pick_ak = ak
break
end
end
if ne pick_ak 0
exp_out_view exp_s_ana_hdr
exp_out_u64 pick_step
exp_out_b uchar 41
exp_out_b uchar 58
exp_out_b uchar 10
exp_out_b uchar 32
exp_out_b uchar 32
exp_out_analogy_text pick_ak
exp_out_b uchar 10
else
exp_out_view exp_s_ana_none
end
exp_out_view exp_s_ev_itself
rlv = lv
if lt rlv 1
rlv = 1
end
exp_render_steps rlv aud
end

fn exp_render md ulong lv ulong aud ulong to ulong
exp_out_reset
eff = exp_effective_level md lv
if eq md EXP_MODE_SUMMARY
exp_render_summary eff aud
else
if eq md EXP_MODE_STEP_BY_STEP
exp_out_header aud
if gt eff 0
exp_out_b uchar 10
exp_render_steps eff aud
end
else
if eq md EXP_MODE_TECHNICAL
exp_render_technical eff
else
exp_render_analogy eff aud
end
end
end
ret get exp_out_len 0
end

note ============================================================================
note Section 11: Clarification Session & CLI Helpers (session.rs, main.rs)
note ============================================================================

fn exp_sess_init aud ulong to void
put exp_sess 0 0
put exp_sess 1 aud
end

fn exp_sess_level to ulong
ret get exp_sess 0
end

fn exp_sess_explain to ulong
put exp_sess 0 0
ret exp_render EXP_MODE_STEP_BY_STEP 0 get exp_sess 1
end

fn exp_sess_deeper to ulong
lv = add get exp_sess 0 1
if gt lv EXP_MAX_LEVEL
lv = EXP_MAX_LEVEL
end
put exp_sess 0 lv
ret exp_render EXP_MODE_STEP_BY_STEP lv get exp_sess 1
end

fn exp_sess_shallower to ulong
lv = get exp_sess 0
if gt lv 0
lv = sub lv 1
end
put exp_sess 0 lv
ret exp_render EXP_MODE_STEP_BY_STEP lv get exp_sess 1
end

fn exp_sess_step_deps si ulong to void
soff = get exp_bs_sup_off si
scnt = get exp_bs_sup_cnt si
if eq scnt 0
if ne get exp_bs_gnd si 0
exp_out_view exp_s_start_pt
else
exp_out_view exp_s_no_sup
end
ret
end
for k ulong scnt bound 1024
pstep = get exp_bs_sup_step add soff k
prel = get exp_bs_sup_rel add soff k
pnid = get exp_bs_nid sub pstep 1
if eq prel EXP_REL_REFERENCES
exp_out_view exp_s_it_refs
else
exp_out_view exp_s_it_rests
end
exp_out_u64 pstep
exp_out_b uchar 32
exp_out_b uchar 40
exp_out_rel_name prel
exp_out_b uchar 41
exp_out_b uchar 58
exp_out_b uchar 32
exp_out_arena get exp_gn_stmt_off pnid get exp_gn_stmt_len pnid
exp_out_b uchar 10
end
end

fn exp_sess_step_later n ulong nid ulong to void
sc = get exp_b_scnt 0
for j ulong sc bound 320
lso = get exp_bs_sup_off j
lsc = get exp_bs_sup_cnt j
for k ulong lsc bound 1024
if eq get exp_bs_sup_step add lso k n
exp_out_view exp_s_step_hdr
exp_out_u64 add j 1
exp_out_view exp_s_rests_on_it
break
end
end
end
uc = get exp_bu_cnt 0
no = get exp_gn_id_off nid
nl = get exp_gn_id_len nid
for i ulong uc bound 512
if exp_str_eq get exp_bu_nid_off i get exp_bu_nid_len i no nl
exp_out_view exp_s_caveat
exp_out_arena get exp_bu_det_off i get exp_bu_det_len i
exp_out_b uchar 10
end
end
end

fn exp_sess_step n ulong to int
if eq n 0
ret EXP_ERR_STEP_OUT_OF_RANGE
end
if gt n get exp_b_scnt 0
ret EXP_ERR_STEP_OUT_OF_RANGE
end
exp_out_reset
si = sub n 1
nid = get exp_bs_nid si
exp_out_view exp_s_step_hdr
exp_out_u64 n
exp_out_b uchar 58
exp_out_b uchar 32
exp_out_arena get exp_gn_stmt_off nid get exp_gn_stmt_len nid
exp_out_b uchar 32
exp_out_b uchar 91
exp_out_status_words get exp_gn_status nid
exp_out_b uchar 93
exp_out_b uchar 10
exp_sess_step_deps si
exp_sess_step_later n nid
ret EXP_OK
end

fn exp_sess_source n ulong to int
if eq n 0
ret EXP_ERR_STEP_OUT_OF_RANGE
end
if gt n get exp_b_scnt 0
ret EXP_ERR_STEP_OUT_OF_RANGE
end
exp_out_reset
si = sub n 1
nid = get exp_bs_nid si
exp_out_view exp_s_step_hdr
exp_out_u64 n
exp_out_view exp_s_comes
exp_out_arena get exp_gn_sys_off nid get exp_gn_sys_len nid
exp_out_b uchar 32
exp_out_b uchar 40
exp_out_arena get exp_gn_art_off nid get exp_gn_art_len nid
exp_out_view exp_s_ref_lbl
exp_out_arena get exp_gn_ref_off nid get exp_gn_ref_len nid
if ne get exp_gn_has_dig nid 0
exp_out_view exp_s_dig_c
exp_out_arena get exp_gn_dig_off nid get exp_gn_dig_len nid
end
exp_out_view exp_s_node_sc
exp_out_arena get exp_gn_id_off nid get exp_gn_id_len nid
exp_out_view exp_s_st_sc
exp_out_status_name get exp_gn_status nid
exp_out_b uchar 46
exp_out_b uchar 10
ret EXP_OK
end

fn exp_sess_evidence to ulong
exp_out_reset
evc = get exp_be_cnt 0
if eq evc 0
exp_out_view exp_s_no_ev_att
ret get exp_out_len 0
end
mc = get exp_g_mcnt 0
for i ulong evc bound 320
step = get exp_be_step i
nid = get exp_bs_nid sub step 1
exp_out_view exp_s_step_hdr
exp_out_u64 step
exp_out_b uchar 58
exp_out_b uchar 32
exp_out_arena get exp_gn_sys_off nid get exp_gn_sys_len nid
exp_out_b uchar 32
exp_out_arena get exp_gn_art_off nid get exp_gn_art_len nid
exp_out_b uchar 32
exp_out_arena get exp_gn_ref_off nid get exp_gn_ref_len nid
if ne get exp_gn_has_dig nid 0
exp_out_view exp_s_dig
exp_out_arena get exp_gn_dig_off nid get exp_gn_dig_len nid
end
exp_out_b uchar 10
for m ulong mc bound 256
if eq get exp_gm_owner m nid
exp_out_b uchar 32
exp_out_b uchar 32
exp_out_arena get exp_gm_name_off m get exp_gm_name_len m
exp_out_b uchar 32
exp_out_b uchar 61
exp_out_b uchar 32
exp_out_arena get exp_gm_val_off m get exp_gm_val_len m
exp_out_b uchar 32
exp_out_arena get exp_gm_unit_off m get exp_gm_unit_len m
exp_out_b uchar 10
end
end
end
ret get exp_out_len 0
end

fn exp_sess_technical to ulong
ret exp_render EXP_MODE_TECHNICAL EXP_MAX_LEVEL get exp_sess 1
end

fn exp_sess_simple to ulong
ret exp_render EXP_MODE_SUMMARY 1 EXP_AUD_GENERAL
end

fn exp_sess_analogy to ulong
ret exp_render EXP_MODE_ANALOGY 2 get exp_sess 1
end

fn exp_sess_uncertainties to ulong
exp_out_reset
uc = get exp_bu_cnt 0
cc = get exp_bc_cnt 0
if and eq uc 0 eq cc 0
exp_out_view exp_s_no_unc_rec
ret get exp_out_len 0
end
for i ulong uc bound 512
exp_out_b uchar 45
exp_out_b uchar 32
exp_out_uk_label get exp_bu_kind i
exp_out_b uchar 58
exp_out_b uchar 32
exp_out_arena get exp_bu_det_off i get exp_bu_det_len i
exp_out_b uchar 10
end
for i ulong cc bound 128
exp_out_view exp_s_conflict_pfx
exp_out_arena get exp_bc_stmt_off i get exp_bc_stmt_len i
exp_out_b uchar 10
end
ret get exp_out_len 0
end

fn exp_sess_alternatives to ulong
exp_out_reset
ac = get exp_ba_cnt 0
if eq ac 0
exp_out_view exp_s_no_alt_rec
ret get exp_out_len 0
end
for i ulong ac bound 128
nid = get exp_ba_nid i
exp_out_b uchar 45
exp_out_b uchar 32
exp_out_arena get exp_gn_stmt_off nid get exp_gn_stmt_len nid
exp_out_b uchar 10
end
ret get exp_out_len 0
end

note CLI helpers (main.rs)
fn exp_cli_exit_code err int to int
if eq err EXP_OK
ret 0
end
ret add 10 err
end

fn exp_parse_audience s view uchar * to ulong
if exp_view_eq s exp_an_0
ret EXP_AUD_GENERAL
end
if exp_view_eq s exp_an_1
ret EXP_AUD_OPERATOR
end
if exp_view_eq s exp_an_2
ret EXP_AUD_DEVELOPER
end
if exp_view_eq s exp_an_3
ret EXP_AUD_SYSTEMS_ENG
end
if exp_view_eq s exp_an_4
ret EXP_AUD_RESEARCHER
end
ret EXP_AUD_INVALID
end

fn exp_hex_nib b uchar to int
if and ge b 48 le b 57
ret int sub b 48
end
if and ge b 97 le b 102
ret int add 10 sub b 97
end
if and ge b 65 le b 70
ret int add 10 sub b 65
end
ret -1
end

fn exp_parse_cortex_id s view uchar * dst edit uchar * to int
n = len s
off = ulong 0
if ge n 7
if exp_view_eq part s 0 7 exp_txt_cx_pfx
off = 7
end
end
if ne sub n off 32
ret EXP_ERR_TARGET_NOT_FOUND
end
for k ulong 16
hi = exp_hex_nib get s add off mul k 2
lo = exp_hex_nib get s add add off mul k 2 1
if or lt hi 0 lt lo 0
ret EXP_ERR_TARGET_NOT_FOUND
end
put dst k uchar or shl ulong hi 4 ulong lo
end
ret EXP_OK
end

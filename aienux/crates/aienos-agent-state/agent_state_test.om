note aienux/crates/aienos-agent-state/agent_state_test.om: Behavioral self-test for aienos-agent-state.
note Ports every unit test from id.rs, history.rs, lineage.rs, and manager.rs.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-agent-state/agent_state.om aienux/crates/aienos-agent-state/agent_state_test.om

text ast_seed_alpha "agent-alpha"
text ast_seed_beta "agent-beta"
text ast_seed_spark "spark-agent"
text ast_seed_lineage "lineage-test"
text ast_seed_sovereign "aienos-sovereign-agent"
text ast_seed_fork_cnt "fork-counter-reboot-test"
text ast_seed_canonical "canonical-checkpoint-test"
text ast_seed_fork_gap "fork-gap-test"
text ast_seed_idempotent "idempotent-provisioning-test"
text ast_seed_fail_closed "fail-closed-restore-test"
text ast_seed_roundtrip "exact-round-trip-test"
text ast_seed_rereg_forks "re-register-keeps-forks-test"
text ast_seed_absent "absent-agent"
text ast_seed_other "other"
text ast_seed_suspend "suspend-test-agent"

note Shared tree IDs for build_tree helper: 0=agent, 1=root, 2=child0, 3=child1, 4=grandchild
global ast_tree_ids uchar 160

fn ast_is_hex_char c uchar to bool
if ge c 48
if le c 57
ret true
end
end
if ge c 97
if le c 102
ret true
end
end
ret false
end

fn ast_tree_get idx ulong dst edit uchar * to void
off = mul idx 32
for i ulong 32
put dst i get ast_tree_ids add off i
end
end

fn ast_tree_put idx ulong src view uchar * to void
off = mul idx 32
for i ulong 32
put ast_tree_ids add off i get src i
end
end

fn ast_build_tree mgr ulong seed view uchar * to int
aid = new uchar 32 0
rid = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
gc = new uchar 32 0
as_agent_id_from_seed seed aid
rc = as_mgr_register_agent mgr aid 100 rid
if ne rc AS_OK
ret 1
end
t1 = new uint 3 0
put t1 0 1
put t1 1 2
put t1 2 3
rc = as_mgr_append_tokens mgr rid t1
if ne rc AS_OK
ret 2
end
rc = as_mgr_fork_branch mgr rid c0
if ne rc AS_OK
ret 3
end
t2 = new uint 1 4
rc = as_mgr_append_tokens mgr c0 t2
if ne rc AS_OK
ret 4
end
eref = new uchar 16 9
rc = as_mgr_add_epistemic_ref mgr c0 eref
if ne rc AS_OK
ret 5
end
rc = as_mgr_fork_branch mgr rid c1
if ne rc AS_OK
ret 6
end
rc = as_mgr_fork_branch mgr c0 gc
if ne rc AS_OK
ret 7
end
t3 = new uint 2 0
put t3 0 5
put t3 1 6
rc = as_mgr_append_tokens mgr gc t3
if ne rc AS_OK
ret 8
end
ast_tree_put 0 aid
ast_tree_put 1 rid
ast_tree_put 2 c0
ast_tree_put 3 c1
ast_tree_put 4 gc
ret 0
end

note Prepare a valid tree checkpoint in as_snap_* and sanity-check untampered restore
fn ast_prep_tamper_snap to int
as_mgr_init 0 1
if ne ast_build_tree 0 ast_seed_fail_closed 0
ret 1
end
aid = new uchar 32 0
ast_tree_get 0 aid
buf = new uchar 16384 0
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 2
end
rc = as_mgr_restore_from_checkpoint 1 buf ulong n 2
if ne rc AS_OK
ret 3
end
rc = as_decode_checkpoint_to_snap buf ulong n
if ne rc AS_OK
ret 4
end
ret 0
end

fn ast_reseal_and_restore to int
buf = new uchar 16384 0
n = as_seal_snapshot buf
if le n 0
ret AS_ERR_SERIALIZATION
end
ret as_mgr_restore_from_checkpoint 1 buf ulong n 2
end

note === 1. id.rs tests ===

fn t_id to int
id1 = new uchar 32 0
id2 = new uchar 32 0
id3 = new uchar 32 0
as_agent_id_from_seed ast_seed_alpha id1
as_agent_id_from_seed ast_seed_alpha id2
as_agent_id_from_seed ast_seed_beta id3
if not as_id_eq id1 id2
ret 1
end
if as_id_eq id1 id3
ret 2
end
hex = new uchar 64 0
as_id_to_hex id1 hex
for i ulong 64
if not ast_is_hex_char get hex i
ret 3
end
end
agent = new uchar 32 0
root = new uchar 32 0
ch0 = new uchar 32 0
ch1 = new uchar 32 0
ch0r = new uchar 32 0
as_agent_id_from_seed ast_seed_spark agent
as_branch_id_root agent root
as_branch_id_derive root 0 ch0
as_branch_id_derive root 1 ch1
as_branch_id_derive root 0 ch0r
if not as_id_eq ch0 ch0r
ret 4
end
if as_id_eq ch0 ch1
ret 5
end
if as_id_eq root ch0
ret 6
end
ret 0
end

note === 2. history.rs tests ===

fn t_history to int
as_th_new 0
as_th_new 1
if not as_th_is_empty 0
ret 7
end
toks = new uint 3 0
put toks 0 101
put toks 1 202
put toks 2 303
if ne as_th_append_tokens 0 toks AS_OK
ret 8
end
if ne as_th_append_tokens 1 toks AS_OK
ret 9
end
if ne as_th_count 0 3
ret 10
end
if as_th_is_empty 0
ret 10
end
h1 = new uchar 32 0
h2 = new uchar 32 0
as_th_rolling_hash 0 h1
as_th_rolling_hash 1 h2
if not as_id_eq h1 h2
ret 11
end
if ne as_th_get_token 0 0 101
ret 12
end
if ne as_th_get_token 0 1 202
ret 12
end
if ne as_th_get_token 0 2 303
ret 12
end
as_th_fork 2 0
if ne as_th_append 2 404 AS_OK
ret 13
end
as_th_rolling_hash 2 h2
if as_id_eq h1 h2
ret 13
end
if ne as_th_count 0 3
ret 13
end
if ne as_th_count 2 4
ret 13
end
ret 0
end

note === 3. lineage.rs tests ===

fn t_lineage to int
agent = new uchar 32 0
rb = new uchar 32 0
b1 = new uchar 32 0
b2 = new uchar 32 0
as_agent_id_from_seed ast_seed_lineage agent
as_branch_id_root agent rb
as_lin_new_root 0 agent
if ne as_lin_depth_of 0 0
ret 14
end
as_branch_id_derive rb 1 b1
if ne as_lin_extend 1 0 b1 AS_OK
ret 15
end
if ne as_lin_depth_of 1 1
ret 15
end
if not as_lin_contains 1 b1
ret 16
end
as_branch_id_derive b1 2 b2
if ne as_lin_extend 2 1 b2 AS_OK
ret 17
end
if ne as_lin_depth_of 2 2
ret 17
end
if not as_lin_contains 2 b1
ret 18
end
if not as_lin_contains 2 b2
ret 19
end
if as_lin_contains 2 rb
ret 20
end
as_epi_new 0
if not as_epi_is_empty 0
ret 21
end
r1 = new uchar 16 0xaa
r2 = new uchar 16 0xbb
if ne as_epi_insert 0 r1 AS_OK
ret 21
end
if ne as_epi_insert 0 r1 AS_OK
ret 21
end
if ne as_epi_count 0 1
ret 21
end
if ne as_epi_insert 0 r2 AS_OK
ret 21
end
if ne as_epi_count 0 2
ret 21
end
if not as_epi_contains 0 r1
ret 21
end
if not as_epi_contains 0 r2
ret 21
end
ret 0
end

note === 4. test_checkpoint_reboot_and_reconstruction ===

fn t_reboot_verify_root aid view uchar * rb view uchar * to int
ridx = as_mgr_find_branch 1 rb
if lt ridx 0
ret 31
end
rslot = as_br_slot 1 ulong ridx
roff = mul rslot 32
for i ulong 32
if ne get as_br_agent_id add roff i get aid i
ret 31
end
end
if ne get as_br_tok_cnt rslot 50
ret 32
end
ret 0
end

fn t_reboot_verify_child rb view uchar * cb view uchar * to int
cidx = as_mgr_find_branch 1 cb
if lt cidx 0
ret 33
end
cslot = as_br_slot 1 ulong cidx
if ne get as_br_has_parent cslot 1
ret 33
end
coff = mul cslot 32
for i ulong 32
if ne get as_br_parent_id add coff i get rb i
ret 33
end
end
if ne get as_br_tok_cnt cslot 52
ret 34
end
ref_id = new uchar 16 7
if not as_mgr_branch_epi_contains 1 ulong cidx ref_id
ret 34
end
if ne get as_br_inc_id cslot 2
ret 35
end
if ne get as_br_inc_state cslot AS_COMPUTE_EVICTED
ret 35
end
if ne get as_br_inc_alloc_tok cslot 0
ret 35
end
if le as_mgr_resume 1 cb 0
ret 36
end
if ne as_mgr_reconstruct_physical 1 cb AS_OK
ret 37
end
if ne get as_br_inc_state cslot AS_COMPUTE_DECODING
ret 37
end
if ne get as_br_inc_alloc_tok cslot 52
ret 37
end
if ne get as_br_inc_kv_has cslot 1
ret 37
end
if ne get as_br_inc_kv_ref cslot add ulong 0xdead0000 52
ret 37
end
ret 0
end

fn t_reboot_verify aid view uchar * rb view uchar * cb view uchar * to int
rc = t_reboot_verify_root aid rb
if ne rc 0
ret rc
end
ret t_reboot_verify_child rb cb
end

fn t_reboot to int
as_mgr_init 0 1
aid = new uchar 32 0
rb = new uchar 32 0
cb = new uchar 32 0
as_agent_id_from_seed ast_seed_sovereign aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 22
end
t50 = new uint 50 0
for i ulong 50
put t50 i uint add i 1
end
if ne as_mgr_append_tokens 0 rb t50 AS_OK
ret 23
end
if ne as_mgr_fork_branch 0 rb cb AS_OK
ret 24
end
t2 = new uint 2 0
put t2 0 51
put t2 1 52
if ne as_mgr_append_tokens 0 cb t2 AS_OK
ret 25
end
ref_id = new uchar 16 7
if ne as_mgr_add_epistemic_ref 0 cb ref_id AS_OK
ret 26
end
buf = new uchar 16384 0
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 27
end
ch = new uchar 32 0
if ne as_mgr_checkpoint 0 aid ch AS_OK
ret 28
end
if as_id_is_zero ch
ret 29
end
for i ulong 32
if ne get ch i get buf add 8 i
ret 29
end
end
if ne as_mgr_restore_from_checkpoint 1 buf ulong n 2 AS_OK
ret 30
end
ret t_reboot_verify aid rb cb
end

note === 5. restore_rebuilds_fork_counters_without_reusing_branch_ids ===

fn t_fork_counters_phase2 to int
aid = new uchar 32 0
rb = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
c2 = new uchar 32 0
c3 = new uchar 32 0
ast_tree_get 0 aid
ast_tree_get 1 rb
ast_tree_get 2 c0
ast_tree_get 3 c1
ast_tree_get 4 c2
buf = new uchar 16384 0
n2 = as_mgr_export_checkpoint 1 aid buf
if le n2 0
ret 43
end
if ne as_mgr_restore_from_checkpoint 0 buf ulong n2 3 AS_OK
ret 43
end
if ne as_mgr_fork_branch 0 rb c3 AS_OK
ret 44
end
if as_id_eq c3 c0
ret 45
end
if as_id_eq c3 c1
ret 45
end
if as_id_eq c3 c2
ret 45
end
i2 = as_mgr_find_branch 0 c2
if lt i2 0
ret 46
end
s2 = as_br_slot 0 ulong i2
if ne get as_br_has_parent s2 1
ret 46
end
o2 = mul s2 32
for i ulong 32
if ne get as_br_parent_id add o2 i get rb i
ret 46
end
end
ret 0
end

fn t_fork_counters to int
as_mgr_init 0 1
aid = new uchar 32 0
rb = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
c2 = new uchar 32 0
as_agent_id_from_seed ast_seed_fork_cnt aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 38
end
if ne as_mgr_fork_branch 0 rb c0 AS_OK
ret 38
end
t2 = new uint 2 0
put t2 0 11
put t2 1 12
if ne as_mgr_append_tokens 0 c0 t2 AS_OK
ret 38
end
if ne as_mgr_fork_branch 0 rb c1 AS_OK
ret 38
end
buf = new uchar 16384 0
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 39
end
if ne as_mgr_restore_from_checkpoint 1 buf ulong n 2 AS_OK
ret 39
end
if ne as_mgr_fork_branch 1 rb c2 AS_OK
ret 40
end
if as_id_eq c2 c0
ret 41
end
if as_id_eq c2 c1
ret 41
end
i0 = as_mgr_find_branch 1 c0
if lt i0 0
ret 42
end
if ne get as_br_tok_cnt as_br_slot 1 ulong i0 2
ret 42
end
ast_tree_put 0 aid
ast_tree_put 1 rb
ast_tree_put 2 c0
ast_tree_put 3 c1
ast_tree_put 4 c2
ret t_fork_counters_phase2
end

note === 6. checkpoint_bytes_are_stable_across_restore ===

fn t_stable_bytes to int
as_mgr_init 0 7
aid = new uchar 32 0
rb = new uchar 32 0
ch = new uchar 32 0
as_agent_id_from_seed ast_seed_canonical aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 47
end
tok = new uint 1 0
for t ulong 24
if ne as_mgr_fork_branch 0 rb ch AS_OK
ret 48
end
put tok 0 uint t
if ne as_mgr_append_tokens 0 ch tok AS_OK
ret 48
end
end
b1 = new uchar 16384 0
b2 = new uchar 16384 0
n1 = as_mgr_export_checkpoint 0 aid b1
if le n1 0
ret 49
end
if ne as_mgr_restore_from_checkpoint 1 b1 ulong n1 7 AS_OK
ret 50
end
n2 = as_mgr_export_checkpoint 1 aid b2
if ne n1 n2
ret 51
end
for i ulong ulong n1 bound 16384
if ne get b1 i get b2 i
ret 51
end
end
ret 0
end

note === 7. restore_refuses_checkpoint_without_durable_identity ===

fn t_no_identity to int
as_snap_clear
put as_snap_inc 0 5
buf = new uchar 4096 0
n = as_seal_snapshot buf
if le n 0
ret 52
end
rc = as_mgr_restore_from_checkpoint 1 buf ulong n 6
if ne rc AS_ERR_CKPT_NO_AGENT
ret 53
end
ret 0
end

note === 8. restore_rejects_noncontiguous_persisted_fork_indexes ===

fn t_noncontiguous to int
as_mgr_init 0 1
aid = new uchar 32 0
rb = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
as_agent_id_from_seed ast_seed_fork_gap aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 54
end
if ne as_mgr_fork_branch 0 rb c0 AS_OK
ret 54
end
if ne as_mgr_fork_branch 0 rb c1 AS_OK
ret 54
end
buf = new uchar 16384 0
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 55
end
if ne as_decode_checkpoint_to_snap buf ulong n AS_OK
ret 55
end
sb0 = as_snap_find_branch c0
if lt sb0 0
ret 56
end
as_snap_remove_branch ulong sb0
if ne ast_reseal_and_restore AS_ERR_CKPT_NONCONTIGUOUS_FORK
ret 57
end
ret 0
end

note === 9. re_registering_an_existing_identity_does_not_reset_its_root_branch ===

fn t_reregister to int
as_mgr_init 0 1
aid = new uchar 32 0
rb = new uchar 32 0
rb2 = new uchar 32 0
as_agent_id_from_seed ast_seed_idempotent aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 58
end
toks = new uint 6 0
put toks 0 4
put toks 1 8
put toks 2 15
put toks 3 16
put toks 4 23
put toks 5 42
if ne as_mgr_append_tokens 0 rb toks AS_OK
ret 59
end
if ne as_mgr_register_agent 0 aid 999 rb2 AS_OK
ret 60
end
if not as_id_eq rb rb2
ret 60
end
idx = as_mgr_find_branch 0 rb
if lt idx 0
ret 61
end
slot = as_br_slot 0 ulong idx
if ne get as_br_created_at slot 100
ret 61
end
if ne get as_br_tok_cnt slot 6
ret 62
end
tb = mul slot AS_MAX_TOKENS
for i ulong 6
if ne get as_br_tok_id add tb i get toks i
ret 62
end
end
ret 0
end

note === 10. restore_round_trips_branches_and_next_fork_indexes_exactly ===

fn t_roundtrip_check_pair pid view uchar * next_idx ulong to int
exp = new uchar 32 0
f1 = new uchar 32 0
f0 = new uchar 32 0
as_branch_id_derive pid next_idx exp
if ne as_mgr_fork_branch 1 pid f1 AS_OK
ret 1
end
if not as_id_eq f1 exp
ret 2
end
if ne as_mgr_fork_branch 0 pid f0 AS_OK
ret 3
end
if not as_id_eq f0 exp
ret 4
end
ret 0
end

fn t_roundtrip_check_restored to int
bid = new uchar 32 0
for sb ulong 4
off = mul sb 32
for j ulong 32
put bid j get as_snap_br_id add off j
end
mi = as_mgr_find_branch 1 bid
if lt mi 0
ret 68
end
mslot = as_br_slot 1 ulong mi
if not as_br_eq_snap mslot sb
ret 68
end
if ne get as_br_inc_id mslot 2
ret 69
end
if ne get as_br_inc_state mslot AS_COMPUTE_EVICTED
ret 69
end
end
ret 0
end

fn t_roundtrip_check_gc to int
c0 = new uchar 32 0
gc = new uchar 32 0
ast_tree_get 2 c0
ast_tree_get 4 gc
gci = as_mgr_find_branch 1 gc
if lt gci 0
ret 70
end
gcslot = as_br_slot 1 ulong gci
if ne get as_br_has_parent gcslot 1
ret 70
end
if ne get as_br_lin_depth gcslot 2
ret 70
end
if ne get as_br_lin_cnt gcslot 2
ret 70
end
ga0 = mul gcslot mul AS_MAX_DEPTH 32
ga1 = add ga0 32
for j ulong 32
if ne get as_br_lin_anc add ga0 j get c0 j
ret 71
end
if ne get as_br_lin_anc add ga1 j get gc j
ret 71
end
end
ret 0
end

fn t_roundtrip to int
as_mgr_init 0 1
if ne ast_build_tree 0 ast_seed_roundtrip 0
ret 63
end
aid = new uchar 32 0
ast_tree_get 0 aid
buf = new uchar 16384 0
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 64
end
if ne as_mgr_restore_from_checkpoint 1 buf ulong n 2 AS_OK
ret 65
end
if ne as_decode_checkpoint_to_snap buf ulong n AS_OK
ret 66
end
if ne get as_snap_branch_cnt 0 4
ret 67
end
rc = t_roundtrip_check_restored
if ne rc 0
ret rc
end
rc = t_roundtrip_check_gc
if ne rc 0
ret rc
end
rb = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
ast_tree_get 1 rb
ast_tree_get 2 c0
ast_tree_get 3 c1
if ne t_roundtrip_check_pair rb 2 0
ret 72
end
if ne t_roundtrip_check_pair c0 1 0
ret 72
end
if ne t_roundtrip_check_pair c1 0 0
ret 72
end
if ne t_roundtrip_check_restored 0
ret 73
end
gc = new uchar 32 0
ast_tree_get 4 gc
gcexp = new uchar 32 0
gcch = new uchar 32 0
as_branch_id_derive gc 0 gcexp
if ne as_mgr_fork_branch 1 gc gcch AS_OK
ret 74
end
if not as_id_eq gcch gcexp
ret 74
end
ret 0
end

note === 11. re_registering_keeps_forked_branches_and_fork_indexes ===

fn t_reregister_tree to int
as_mgr_init 0 1
if ne ast_build_tree 0 ast_seed_rereg_forks 0
ret 75
end
aid = new uchar 32 0
rb = new uchar 32 0
rb2 = new uchar 32 0
ast_tree_get 0 aid
ast_tree_get 1 rb
b1 = new uchar 16384 0
b2 = new uchar 16384 0
n1 = as_mgr_export_checkpoint 0 aid b1
if le n1 0
ret 76
end
if ne as_mgr_register_agent 0 aid 999 rb2 AS_OK
ret 77
end
if not as_id_eq rb rb2
ret 77
end
n2 = as_mgr_export_checkpoint 0 aid b2
if ne n1 n2
ret 78
end
for i ulong ulong n1 bound 16384
if ne get b1 i get b2 i
ret 78
end
end
ch = new uchar 32 0
exp = new uchar 32 0
as_branch_id_derive rb 2 exp
if ne as_mgr_fork_branch 0 rb ch AS_OK
ret 79
end
if not as_id_eq ch exp
ret 79
end
n3 = as_mgr_export_checkpoint 0 aid b1
if le n3 0
ret 80
end
if ne as_mgr_restore_from_checkpoint 1 b1 ulong n3 2 AS_OK
ret 80
end
if ne as_mgr_register_agent 1 aid 1234 rb2 AS_OK
ret 80
end
if not as_id_eq rb rb2
ret 80
end
if ne as_decode_checkpoint_to_snap b1 ulong n3 AS_OK
ret 80
end
if ne get as_mgr_branch_cnt 1 get as_snap_branch_cnt 0
ret 80
end
for sb ulong get as_snap_branch_cnt 0 bound 32
if not as_br_eq_snap as_br_slot 1 sb sb
ret 80
end
end
as_branch_id_derive rb 3 exp
if ne as_mgr_fork_branch 1 rb ch AS_OK
ret 81
end
if not as_id_eq ch exp
ret 81
end
ret 0
end

note === 12. Fail-closed tamper tests (basic cases) ===

fn t_tamper_basic_a to int
note 12a. duplicate agent identity
if ne ast_prep_tamper_snap 0
ret 82
end
aid = new uchar 32 0
ast_tree_get 0 aid
acnt = get as_snap_agent_cnt 0
aoff = mul acnt 32
for i ulong 32
put as_snap_agents add aoff i get aid i
end
put as_snap_agent_cnt 0 add acnt 1
if ne ast_reseal_and_restore AS_ERR_CKPT_DUP_AGENT
ret 83
end

note 12b. branch refers to an absent agent identity
if ne ast_prep_tamper_snap 0
ret 84
end
stranger = new uchar 32 0
as_agent_id_from_seed ast_seed_absent stranger
if ne as_snap_push_new_root stranger 1 AS_OK
ret 84
end
if ne ast_reseal_and_restore AS_ERR_CKPT_ABSENT_AGENT
ret 85
end

note 12c. duplicate branch identity
if ne ast_prep_tamper_snap 0
ret 86
end
c1 = new uchar 32 0
ast_tree_get 3 c1
sb1 = as_snap_find_branch c1
if lt sb1 0
ret 86
end
bcnt = get as_snap_branch_cnt 0
as_snap_copy_branch bcnt ulong sb1
put as_snap_branch_cnt 0 add bcnt 1
if ne ast_reseal_and_restore AS_ERR_CKPT_DUP_BRANCH
ret 87
end
ret 0
end

fn t_tamper_basic_b to int
note 12d. missing root branch
if ne ast_prep_tamper_snap 0
ret 88
end
rb = new uchar 32 0
c0 = new uchar 32 0
c1 = new uchar 32 0
ast_tree_get 1 rb
ast_tree_get 2 c0
ast_tree_get 3 c1
sbr = as_snap_find_branch rb
if lt sbr 0
ret 88
end
as_snap_remove_branch ulong sbr
if ne ast_reseal_and_restore AS_ERR_CKPT_MISSING_ROOT
ret 89
end

note 12e. parentless non-root branch
if ne ast_prep_tamper_snap 0
ret 90
end
sb1 = as_snap_find_branch c1
put as_snap_br_has_parent ulong sb1 0
if ne ast_reseal_and_restore AS_ERR_CKPT_UNEXPECTED_ROOT
ret 91
end

note 12f. branch with missing parent
if ne ast_prep_tamper_snap 0
ret 92
end
sb0 = as_snap_find_branch c0
as_snap_remove_branch ulong sb0
if ne ast_reseal_and_restore AS_ERR_CKPT_MISSING_PARENT
ret 93
end

note 12g. child id not derived from fork index
if ne ast_prep_tamper_snap 0
ret 94
end
bogus = new uchar 32 0
as_branch_id_derive rb 7 bogus
sb1 = as_snap_find_branch c1
o1 = mul ulong sb1 32
for i ulong 32
put as_snap_br_id add o1 i get bogus i
end
put as_snap_br_lin_cnt ulong sb1 1
la1 = mul ulong sb1 mul AS_MAX_DEPTH 32
for i ulong 32
put as_snap_br_lin_anc add la1 i get bogus i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_NONCONTIGUOUS_FORK
ret 95
end
ret 0
end

fn t_tamper_basic to int
rc = t_tamper_basic_a
if ne rc 0
ret rc
end
ret t_tamper_basic_b
end

note === 13. restore_rejects_inconsistent_root_branch (all 5 tampers) ===

fn t_tamper_root to int
rb = new uchar 32 0
other = new uchar 32 0
as_agent_id_from_seed ast_seed_other other

note 13a. root.lineage.depth = 1
if ne ast_prep_tamper_snap 0
ret 120
end
ast_tree_get 1 rb
sbr = ulong as_snap_find_branch rb
put as_snap_br_lin_depth sbr 1
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_ROOT
ret 121
end

note 13b. root.lineage.ancestor_branches.push(root.branch_id)
if ne ast_prep_tamper_snap 0
ret 120
end
sbr = ulong as_snap_find_branch rb
la = mul sbr mul AS_MAX_DEPTH 32
for i ulong 32
put as_snap_br_lin_anc add la i get rb i
end
put as_snap_br_lin_cnt sbr 1
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_ROOT
ret 122
end

note 13c. root.lineage.root_agent = other
if ne ast_prep_tamper_snap 0
ret 120
end
sbr = ulong as_snap_find_branch rb
ro = mul sbr 32
for i ulong 32
put as_snap_br_lin_root add ro i get other i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_ROOT
ret 123
end

note 13d. root.parent_branch_id = Some(root.branch_id)
if ne ast_prep_tamper_snap 0
ret 120
end
sbr = ulong as_snap_find_branch rb
ro = mul sbr 32
put as_snap_br_has_parent sbr 1
for i ulong 32
put as_snap_br_parent_id add ro i get rb i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_ROOT
ret 124
end

note 13e. root branch id of agent A carrying agent B's identity
if ne ast_prep_tamper_snap 0
ret 120
end
acnt = get as_snap_agent_cnt 0
aoff = mul acnt 32
for i ulong 32
put as_snap_agents add aoff i get other i
end
put as_snap_agent_cnt 0 add acnt 1
if ne as_snap_push_new_root other 1 AS_OK
ret 125
end
sbr = ulong as_snap_find_branch rb
ro = mul sbr 32
for i ulong 32
put as_snap_br_agent_id add ro i get other i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_ROOT
ret 126
end
ret 0
end

note === 14. restore_rejects_inconsistent_lineage (all 5 tampers) ===

fn t_tamper_lineage_a to int
gc = new uchar 32 0
other = new uchar 32 0
as_agent_id_from_seed ast_seed_other other

note 14a. grandchild.lineage.depth = 3
if ne ast_prep_tamper_snap 0
ret 130
end
ast_tree_get 4 gc
sbg = ulong as_snap_find_branch gc
put as_snap_br_lin_depth sbg 3
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_LINEAGE
ret 131
end

note 14b. grandchild.lineage.ancestor_branches.remove(0)
if ne ast_prep_tamper_snap 0
ret 130
end
sbg = ulong as_snap_find_branch gc
la0 = mul sbg mul AS_MAX_DEPTH 32
la1 = add la0 32
for i ulong 32
put as_snap_br_lin_anc add la0 i get as_snap_br_lin_anc add la1 i
end
put as_snap_br_lin_cnt sbg 1
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_LINEAGE
ret 132
end

note 14c. grandchild.lineage.root_agent = other
if ne ast_prep_tamper_snap 0
ret 130
end
sbg = ulong as_snap_find_branch gc
go = mul sbg 32
for i ulong 32
put as_snap_br_lin_root add go i get other i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_LINEAGE
ret 133
end
ret 0
end

fn t_tamper_lineage_b to int
c0 = new uchar 32 0
c1 = new uchar 32 0
gc = new uchar 32 0
other = new uchar 32 0
as_agent_id_from_seed ast_seed_other other

note 14d. parent/child cycle child0 <-> child1
if ne ast_prep_tamper_snap 0
ret 130
end
ast_tree_get 2 c0
ast_tree_get 3 c1
ast_tree_get 4 gc
sb0 = ulong as_snap_find_branch c0
sb1 = ulong as_snap_find_branch c1
o0 = mul sb0 32
o1 = mul sb1 32
put as_snap_br_has_parent sb0 1
put as_snap_br_has_parent sb1 1
for i ulong 32
put as_snap_br_parent_id add o0 i get c1 i
put as_snap_br_parent_id add o1 i get c0 i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_LINEAGE
ret 134
end

note 14e. child of another agent's branch
if ne ast_prep_tamper_snap 0
ret 130
end
acnt = get as_snap_agent_cnt 0
aoff = mul acnt 32
for i ulong 32
put as_snap_agents add aoff i get other i
end
put as_snap_agent_cnt 0 add acnt 1
if ne as_snap_push_new_root other 1 AS_OK
ret 135
end
sbg = ulong as_snap_find_branch gc
go = mul sbg 32
for i ulong 32
put as_snap_br_agent_id add go i get other i
end
if ne ast_reseal_and_restore AS_ERR_CKPT_INCONSISTENT_LINEAGE
ret 136
end
ret 0
end

fn t_tamper_lineage to int
rc = t_tamper_lineage_a
if ne rc 0
ret rc
end
ret t_tamper_lineage_b
end

note === 15. test_suspend_resume_lifecycle_and_tamper_rejection + ABI errors ===

fn t_suspend_errors aid view uchar * to int
unk = new uchar 32 0xee
ch = new uchar 32 0
tok = new uint 1 77
eref = new uchar 16 1
buf = new uchar 16384 0
if ne as_mgr_fork_branch 0 unk ch AS_ERR_PARENT_BRANCH_NOT_FOUND
ret 147
end
if ne as_mgr_suspend 0 unk AS_ERR_BRANCH_NOT_FOUND
ret 148
end
if ne as_mgr_resume 0 unk long AS_ERR_BRANCH_NOT_FOUND
ret 149
end
if ne as_mgr_reconstruct_physical 0 unk AS_ERR_BRANCH_NOT_FOUND
ret 150
end
if ne as_mgr_append_tokens 0 unk tok AS_ERR_BRANCH_NOT_FOUND
ret 151
end
if ne as_mgr_add_epistemic_ref 0 unk eref AS_ERR_BRANCH_NOT_FOUND
ret 151
end
if ne as_mgr_export_checkpoint 0 unk buf long AS_ERR_AGENT_NOT_FOUND
ret 152
end
if ne as_mgr_checkpoint 0 unk ch AS_ERR_AGENT_NOT_FOUND
ret 152
end
note Tamper detection on checkpoint restore (corrupt payload byte -> ChecksumMismatch)
n = as_mgr_export_checkpoint 0 aid buf
if le n 0
ret 153
end
lidx = sub ulong n 5
put buf lidx xor get buf lidx 0x55
if ne as_mgr_restore_from_checkpoint 1 buf ulong n 2 AS_ERR_CHECKSUM_MISMATCH
ret 154
end
note Corrupt magic -> DeserializationError
put buf lidx xor get buf lidx 0x55
put buf 0 xor get buf 0 0x01
if ne as_mgr_restore_from_checkpoint 1 buf ulong n 2 AS_ERR_DESERIALIZATION
ret 155
end
note Truncated checkpoint -> DeserializationError
put buf 0 xor get buf 0 0x01
if ne as_mgr_restore_from_checkpoint 1 buf 10 2 AS_ERR_DESERIALIZATION
ret 156
end
ret 0
end

fn t_suspend_resume to int
as_mgr_init 0 1
aid = new uchar 32 0
rb = new uchar 32 0
as_agent_id_from_seed ast_seed_suspend aid
if ne as_mgr_register_agent 0 aid 100 rb AS_OK
ret 140
end
note Suspend active branch
if ne as_mgr_suspend 0 rb AS_OK
ret 141
end
idx = as_mgr_find_branch 0 rb
slot = as_br_slot 0 ulong idx
if ne get as_br_inc_state slot AS_COMPUTE_SUSPENDED
ret 142
end
note Suspending already suspended branch must fail
if ne as_mgr_suspend 0 rb AS_ERR_ALREADY_SUSPENDED
ret 143
end
note Appending tokens while suspended preserves suspended state and kv alloc
tok = new uint 1 77
if ne as_mgr_append_tokens 0 rb tok AS_OK
ret 144
end
if ne get as_br_tok_cnt slot 1
ret 144
end
if ne get as_br_inc_state slot AS_COMPUTE_SUSPENDED
ret 144
end
if ne get as_br_inc_alloc_tok slot 0
ret 144
end
note Resume returns new sequence ID and transitions to Idle
seq = as_mgr_resume 0 rb
if le seq 0
ret 145
end
if ne get as_br_inc_state slot AS_COMPUTE_IDLE
ret 146
end
ret t_suspend_errors aid
end


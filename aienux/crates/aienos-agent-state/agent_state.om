note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-agent-state/agent_state.om: Pure-Omega AIENOS Agent State ABI and Execution Incarnation Substrate.
note Converted from aienux crates/aienos-agent-state/src/ (abi.rs, id.rs, incarnation.rs, history.rs, lineage.rs, manager.rs, lib.rs).
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-agent-state/agent_state.om ...

const AS_MAX_MGRS ulong 2
const AS_MAX_AGENTS ulong 8
const AS_MAX_BRANCHES ulong 32
const AS_MAX_SLOTS ulong 64
const AS_MAX_TOKENS ulong 64
const AS_MAX_DEPTH ulong 16
const AS_MAX_EPISTEMIC ulong 8
const AS_MAX_TH ulong 4
const AS_MAX_LIN ulong 4
const AS_MAX_EPI ulong 4

const AS_COMPUTE_IDLE uchar 0
const AS_COMPUTE_PREFILLING uchar 1
const AS_COMPUTE_DECODING uchar 2
const AS_COMPUTE_SUSPENDED uchar 3
const AS_COMPUTE_EVICTED uchar 4

const AS_OK int 0
const AS_ERR_AGENT_NOT_FOUND int -1
const AS_ERR_BRANCH_NOT_FOUND int -2
const AS_ERR_PARENT_BRANCH_NOT_FOUND int -3
const AS_ERR_ALREADY_SUSPENDED int -4
const AS_ERR_NOT_SUSPENDED int -5
const AS_ERR_SERIALIZATION int -6
const AS_ERR_DESERIALIZATION int -7
const AS_ERR_CHECKSUM_MISMATCH int -8
const AS_ERR_RECONSTRUCTION_FAILED int -9
const AS_ERR_CAPACITY int -10

note Distinct InvalidCheckpoint reason codes matching Rust StateError::InvalidCheckpoint
const AS_ERR_CKPT_NO_AGENT int -20
const AS_ERR_CKPT_DUP_AGENT int -21
const AS_ERR_CKPT_ABSENT_AGENT int -22
const AS_ERR_CKPT_DUP_BRANCH int -23
const AS_ERR_CKPT_MISSING_ROOT int -24
const AS_ERR_CKPT_INCONSISTENT_ROOT int -25
const AS_ERR_CKPT_UNEXPECTED_ROOT int -26
const AS_ERR_CKPT_MISSING_PARENT int -27
const AS_ERR_CKPT_INCONSISTENT_LINEAGE int -28
const AS_ERR_CKPT_NONCONTIGUOUS_FORK int -29

text as_dom_agent "AIENOS_AGENT_GENESIS_v1:"
text as_dom_root "AIENOS_ROOT_BRANCH_v1:"
text as_dom_child "AIENOS_CHILD_BRANCH_v1:"
text as_dom_token "AIENOS_TOKEN_GENESIS_v1"
text as_ckpt_magic "AIENAST1"
text as_hex_digits "0123456789abcdef"

note Standalone TokenHistory pool (AS_MAX_TH = 4)
global as_th_cnt ulong 4
global as_th_rhash uchar 128
global as_th_tseq ulong 256
global as_th_tid uint 256
global as_th_thash uchar 8192

note Standalone Lineage pool (AS_MAX_LIN = 4)
global as_lin_root uchar 128
global as_lin_depth ulong 4
global as_lin_cnt ulong 4
global as_lin_anc uchar 2048

note Standalone EpistemicRefs pool (AS_MAX_EPI = 4)
global as_epi_cnt ulong 4
global as_epi_ids uchar 512

note AgentStateManager pool (AS_MAX_MGRS = 2, AS_MAX_BRANCHES = 32 per manager -> 64 slots)
global as_mgr_inc ulong 2
global as_mgr_next_seq uint 2
global as_mgr_agent_cnt ulong 2
global as_mgr_agents uchar 512
global as_mgr_branch_cnt ulong 2

global as_br_id uchar 2048
global as_br_has_parent uchar 64
global as_br_parent_id uchar 2048
global as_br_agent_id uchar 2048
global as_br_created_at ulong 64
global as_br_child_cnt ulong 64

global as_br_tok_cnt ulong 64
global as_br_rhash uchar 2048
global as_br_tok_seq ulong 4096
global as_br_tok_id uint 4096
global as_br_tok_hash uchar 131072

global as_br_lin_root uchar 2048
global as_br_lin_depth ulong 64
global as_br_lin_cnt ulong 64
global as_br_lin_anc uchar 32768

global as_br_epi_cnt ulong 64
global as_br_epi_ids uchar 8192

global as_br_inc_id ulong 64
global as_br_inc_seq uint 64
global as_br_inc_kv_has uchar 64
global as_br_inc_kv_ref ulong 64
global as_br_inc_acc_has uchar 64
global as_br_inc_acc_ref ulong 64
global as_br_inc_state uchar 64
global as_br_inc_alloc_tok ulong 64

note Staging AgentSnapshot (used by export, decode, tamper inspection, and restore validation)
global as_snap_inc ulong 1
global as_snap_agent_cnt ulong 1
global as_snap_agents uchar 256
global as_snap_branch_cnt ulong 1

global as_snap_br_id uchar 1024
global as_snap_br_has_parent uchar 32
global as_snap_br_parent_id uchar 1024
global as_snap_br_agent_id uchar 1024
global as_snap_br_created_at ulong 32

global as_snap_br_tok_cnt ulong 32
global as_snap_br_rhash uchar 1024
global as_snap_br_tok_seq ulong 2048
global as_snap_br_tok_id uint 2048
global as_snap_br_tok_hash uchar 65536

global as_snap_br_lin_root uchar 1024
global as_snap_br_lin_depth ulong 32
global as_snap_br_lin_cnt ulong 32
global as_snap_br_lin_anc uchar 16384

global as_snap_br_epi_cnt ulong 32
global as_snap_br_epi_ids uchar 4096

note Restore validation sorted order and child counters
global as_val_order ulong 32
global as_val_child_cnt ulong 32

note === Byte encoding helpers (big-endian) ===

fn as_put_u32_be buf edit uchar * off ulong v uint to void
put buf off uchar and shr v 24 0xff
put buf add off 1 uchar and shr v 16 0xff
put buf add off 2 uchar and shr v 8 0xff
put buf add off 3 uchar and v 0xff
end

fn as_put_u64_be buf edit uchar * off ulong v ulong to void
for i ulong 8
sh = mul sub 7 i 8
put buf add off i uchar and shr v sh 0xff
end
end

fn as_get_u32_be buf view uchar * off ulong to uint
b0 = uint get buf off
b1 = uint get buf add off 1
b2 = uint get buf add off 2
b3 = uint get buf add off 3
hi = or shl b0 24 shl b1 16
lo = or shl b2 8 b3
ret or hi lo
end

fn as_get_u64_be buf view uchar * off ulong to ulong
acc = ulong 0
for i ulong 8
b = ulong get buf add off i
sh = mul sub 7 i 8
acc = or acc shl b sh
end
ret acc
end

note === Cryptographic ID helpers (id.rs) ===

fn as_id_eq a view uchar * b view uchar * to bool
for i ulong 32
if ne get a i get b i
ret false
end
end
ret true
end

fn as_id_cmp a view uchar * b view uchar * to int
for i ulong 32
va = get a i
vb = get b i
if lt va vb
ret -1
end
if gt va vb
ret 1
end
end
ret 0
end

fn as_id_is_zero a view uchar * to bool
for i ulong 32
if ne get a i 0
ret false
end
end
ret true
end

fn as_rec16_eq a view uchar * b view uchar * to bool
for i ulong 16
if ne get a i get b i
ret false
end
end
ret true
end

fn as_id_to_hex id view uchar * dst edit uchar * to void
for i ulong 32
b = ulong get id i
hi = and shr b 4 0xf
lo = and b 0xf
put dst mul i 2 get as_hex_digits hi
put dst add mul i 2 1 get as_hex_digits lo
end
end

fn as_agent_id_from_seed seed view uchar * dst edit uchar * to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx as_dom_agent
if gt len seed 0
sha256_update ctx seed
end
sha256_final ctx dst
end

fn as_branch_id_root agent_id view uchar * dst edit uchar * to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx as_dom_root
sha256_update ctx part agent_id 0 32
sha256_final ctx dst
end

fn as_branch_id_derive parent view uchar * branch_index ulong dst edit uchar * to void
ctx = new ulong 40 0
ibuf = new uchar 8 0
as_put_u64_be ibuf 0 branch_index
sha256_init ctx
sha256_update ctx as_dom_child
sha256_update ctx part parent 0 32
sha256_update ctx ibuf
sha256_final ctx dst
end

note === TokenHistory primitives and standalone pool (history.rs) ===

fn as_token_genesis_hash dst edit uchar * to void
dlen = sha2_digest 256 as_dom_token dst
if ne dlen 32
trap 8
end
end

fn as_token_step_hash prev_hash view uchar * seq ulong token_id uint dst edit uchar * to void
ctx = new ulong 40 0
sbuf = new uchar 8 0
tbuf = new uchar 4 0
as_put_u64_be sbuf 0 seq
as_put_u32_be tbuf 0 token_id
sha256_init ctx
sha256_update ctx part prev_hash 0 32
sha256_update ctx sbuf
sha256_update ctx tbuf
sha256_final ctx dst
end

fn as_th_new slot ulong to void
put as_th_cnt slot 0
gh = new uchar 32 0
as_token_genesis_hash gh
base = mul slot 32
for i ulong 32
put as_th_rhash add base i get gh i
end
end

fn as_th_count slot ulong to ulong
ret get as_th_cnt slot
end

fn as_th_is_empty slot ulong to bool
ret eq get as_th_cnt slot 0
end

fn as_th_rolling_hash slot ulong dst edit uchar * to void
base = mul slot 32
for i ulong 32
put dst i get as_th_rhash add base i
end
end

fn as_th_get_token slot ulong idx ulong to uint
base = mul slot AS_MAX_TOKENS
ret get as_th_tid add base idx
end

fn as_th_append slot ulong token_id uint to int
cnt = get as_th_cnt slot
if ge cnt AS_MAX_TOKENS
ret AS_ERR_CAPACITY
end
prev = new uchar 32 0
nh = new uchar 32 0
rbase = mul slot 32
for i ulong 32
put prev i get as_th_rhash add rbase i
end
as_token_step_hash prev cnt token_id nh
tbase = add mul slot AS_MAX_TOKENS cnt
put as_th_tseq tbase cnt
put as_th_tid tbase token_id
hbase = mul tbase 32
for i ulong 32
put as_th_thash add hbase i get nh i
put as_th_rhash add rbase i get nh i
end
put as_th_cnt slot add cnt 1
ret AS_OK
end

fn as_th_append_tokens slot ulong tokens view uint * to int
n = len tokens
cnt = get as_th_cnt slot
if gt add cnt n AS_MAX_TOKENS
ret AS_ERR_CAPACITY
end
for i ulong n bound 64
rc = as_th_append slot get tokens i
if ne rc AS_OK
ret rc
end
end
ret AS_OK
end

fn as_th_copy_tok dst_slot ulong src_slot ulong k ulong to void
dt = add mul dst_slot AS_MAX_TOKENS k
st = add mul src_slot AS_MAX_TOKENS k
put as_th_tseq dt get as_th_tseq st
put as_th_tid dt get as_th_tid st
dh = mul dt 32
sh = mul st 32
for j ulong 32
put as_th_thash add dh j get as_th_thash add sh j
end
end

fn as_th_fork dst_slot ulong src_slot ulong to void
cnt = get as_th_cnt src_slot
put as_th_cnt dst_slot cnt
drb = mul dst_slot 32
srb = mul src_slot 32
for i ulong 32
put as_th_rhash add drb i get as_th_rhash add srb i
end
for k ulong cnt bound 64
as_th_copy_tok dst_slot src_slot k
end
end

note === Standalone Lineage and EpistemicRefs pools (lineage.rs) ===

fn as_lin_new_root slot ulong root_agent view uchar * to void
base = mul slot 32
for i ulong 32
put as_lin_root add base i get root_agent i
end
put as_lin_depth slot 0
put as_lin_cnt slot 0
end

fn as_lin_depth_of slot ulong to ulong
ret get as_lin_depth slot
end

fn as_lin_copy_anc dst_slot ulong src_slot ulong k ulong to void
da = add mul dst_slot mul AS_MAX_DEPTH 32 mul k 32
sa = add mul src_slot mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_lin_anc add da j get as_lin_anc add sa j
end
end

fn as_lin_extend dst_slot ulong src_slot ulong branch_id view uchar * to int
cnt = get as_lin_cnt src_slot
if ge cnt AS_MAX_DEPTH
ret AS_ERR_CAPACITY
end
dr = mul dst_slot 32
sr = mul src_slot 32
for i ulong 32
put as_lin_root add dr i get as_lin_root add sr i
end
for k ulong cnt bound 16
as_lin_copy_anc dst_slot src_slot k
end
noff = add mul dst_slot mul AS_MAX_DEPTH 32 mul cnt 32
for j ulong 32
put as_lin_anc add noff j get branch_id j
end
put as_lin_cnt dst_slot add cnt 1
put as_lin_depth dst_slot add get as_lin_depth src_slot 1
ret AS_OK
end

fn as_lin_contains slot ulong branch_id view uchar * to bool
cnt = get as_lin_cnt slot
base = mul slot mul AS_MAX_DEPTH 32
for k ulong cnt bound 16
off = add base mul k 32
same = true
for j ulong 32
if ne get as_lin_anc add off j get branch_id j
same = false
end
end
if same
ret true
end
end
ret false
end

fn as_epi_new slot ulong to void
put as_epi_cnt slot 0
end

fn as_epi_count slot ulong to ulong
ret get as_epi_cnt slot
end

fn as_epi_is_empty slot ulong to bool
ret eq get as_epi_cnt slot 0
end

fn as_epi_contains slot ulong rec_id view uchar * to bool
cnt = get as_epi_cnt slot
base = mul slot mul AS_MAX_EPISTEMIC 16
for k ulong cnt bound 8
off = add base mul k 16
same = true
for j ulong 16
if ne get as_epi_ids add off j get rec_id j
same = false
end
end
if same
ret true
end
end
ret false
end

fn as_epi_insert slot ulong rec_id view uchar * to int
if as_epi_contains slot rec_id
ret AS_OK
end
cnt = get as_epi_cnt slot
if ge cnt AS_MAX_EPISTEMIC
ret AS_ERR_CAPACITY
end
off = add mul slot mul AS_MAX_EPISTEMIC 16 mul cnt 16
for j ulong 16
put as_epi_ids add off j get rec_id j
end
put as_epi_cnt slot add cnt 1
ret AS_OK
end

note === Manager slot helpers (incarnation.rs and manager.rs) ===

fn as_br_slot mgr ulong bidx ulong to ulong
ret add mul mgr AS_MAX_BRANCHES bidx
end

fn as_br_inc_init slot ulong inc_id ulong seq uint to void
put as_br_inc_id slot inc_id
put as_br_inc_seq slot seq
put as_br_inc_kv_has slot 0
put as_br_inc_kv_ref slot 0
put as_br_inc_acc_has slot 0
put as_br_inc_acc_ref slot 0
put as_br_inc_state slot AS_COMPUTE_IDLE
put as_br_inc_alloc_tok slot 0
end

fn as_br_inc_evict slot ulong to void
put as_br_inc_kv_has slot 0
put as_br_inc_kv_ref slot 0
put as_br_inc_acc_has slot 0
put as_br_inc_acc_ref slot 0
put as_br_inc_alloc_tok slot 0
put as_br_inc_state slot AS_COMPUTE_EVICTED
end

fn as_mgr_init mgr ulong incarnation_id ulong to void
put as_mgr_inc mgr incarnation_id
put as_mgr_next_seq mgr 1
put as_mgr_agent_cnt mgr 0
put as_mgr_branch_cnt mgr 0
end

fn as_mgr_has_agent mgr ulong agent_id view uchar * to bool
cnt = get as_mgr_agent_cnt mgr
base = mul mgr mul AS_MAX_AGENTS 32
for a ulong cnt bound 8
off = add base mul a 32
same = true
for i ulong 32
if ne get as_mgr_agents add off i get agent_id i
same = false
end
end
if same
ret true
end
end
ret false
end

fn as_mgr_find_branch mgr ulong branch_id view uchar * to long
cnt = get as_mgr_branch_cnt mgr
for b ulong cnt bound 32
slot = as_br_slot mgr b
off = mul slot 32
same = true
for i ulong 32
if ne get as_br_id add off i get branch_id i
same = false
end
end
if same
ret long b
end
end
ret -1
end

fn as_br_init_root slot ulong agent_id view uchar * root_id view uchar * ts ulong to void
off = mul slot 32
for i ulong 32
put as_br_id add off i get root_id i
put as_br_parent_id add off i 0
put as_br_agent_id add off i get agent_id i
put as_br_lin_root add off i get agent_id i
end
put as_br_has_parent slot 0
put as_br_created_at slot ts
put as_br_child_cnt slot 0
put as_br_tok_cnt slot 0
gh = new uchar 32 0
as_token_genesis_hash gh
for i ulong 32
put as_br_rhash add off i get gh i
end
put as_br_lin_depth slot 0
put as_br_lin_cnt slot 0
put as_br_epi_cnt slot 0
end

fn as_br_copy_tok dst_slot ulong src_slot ulong k ulong to void
dt = add mul dst_slot AS_MAX_TOKENS k
st = add mul src_slot AS_MAX_TOKENS k
put as_br_tok_seq dt get as_br_tok_seq st
put as_br_tok_id dt get as_br_tok_id st
dh = mul dt 32
sh = mul st 32
for j ulong 32
put as_br_tok_hash add dh j get as_br_tok_hash add sh j
end
end

fn as_br_copy_history dst_slot ulong src_slot ulong to void
cnt = get as_br_tok_cnt src_slot
put as_br_tok_cnt dst_slot cnt
dr = mul dst_slot 32
sr = mul src_slot 32
for i ulong 32
put as_br_rhash add dr i get as_br_rhash add sr i
end
for k ulong cnt bound 64
as_br_copy_tok dst_slot src_slot k
end
end

fn as_br_copy_lin_anc dst_slot ulong src_slot ulong k ulong to void
da = add mul dst_slot mul AS_MAX_DEPTH 32 mul k 32
sa = add mul src_slot mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_br_lin_anc add da j get as_br_lin_anc add sa j
end
end

fn as_br_copy_epi_one dst_slot ulong src_slot ulong k ulong to void
doff = add mul dst_slot mul AS_MAX_EPISTEMIC 16 mul k 16
soff = add mul src_slot mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put as_br_epi_ids add doff j get as_br_epi_ids add soff j
end
end

fn as_br_copy_epi dst_slot ulong src_slot ulong to void
ecnt = get as_br_epi_cnt src_slot
put as_br_epi_cnt dst_slot ecnt
for k ulong ecnt bound 8
as_br_copy_epi_one dst_slot src_slot k
end
end

fn as_br_copy_lin_and_epi dst_slot ulong src_slot ulong child_id view uchar * to void
dr = mul dst_slot 32
sr = mul src_slot 32
for i ulong 32
put as_br_lin_root add dr i get as_br_lin_root add sr i
end
lcnt = get as_br_lin_cnt src_slot
for k ulong lcnt bound 16
as_br_copy_lin_anc dst_slot src_slot k
end
noff = add mul dst_slot mul AS_MAX_DEPTH 32 mul lcnt 32
for j ulong 32
put as_br_lin_anc add noff j get child_id j
end
put as_br_lin_cnt dst_slot add lcnt 1
put as_br_lin_depth dst_slot add get as_br_lin_depth src_slot 1
as_br_copy_epi dst_slot src_slot
end

fn as_br_fork_slot dst_slot ulong src_slot ulong child_id view uchar * ts ulong to void
doff = mul dst_slot 32
soff = mul src_slot 32
for i ulong 32
put as_br_id add doff i get child_id i
put as_br_parent_id add doff i get as_br_id add soff i
put as_br_agent_id add doff i get as_br_agent_id add soff i
end
put as_br_has_parent dst_slot 1
put as_br_created_at dst_slot ts
put as_br_child_cnt dst_slot 0
as_br_copy_history dst_slot src_slot
as_br_copy_lin_and_epi dst_slot src_slot child_id
end

fn as_mgr_register_agent mgr ulong agent_id view uchar * ts ulong dst_branch edit uchar * to int
root_id = new uchar 32 0
as_branch_id_root agent_id root_id
for i ulong 32
put dst_branch i get root_id i
end
if as_mgr_has_agent mgr agent_id
found = as_mgr_find_branch mgr root_id
if ge found 0
ret AS_OK
end
else
acnt = get as_mgr_agent_cnt mgr
if ge acnt AS_MAX_AGENTS
ret AS_ERR_CAPACITY
end
aoff = add mul mgr mul AS_MAX_AGENTS 32 mul acnt 32
for i ulong 32
put as_mgr_agents add aoff i get agent_id i
end
put as_mgr_agent_cnt mgr add acnt 1
end
bcnt = get as_mgr_branch_cnt mgr
if ge bcnt AS_MAX_BRANCHES
ret AS_ERR_CAPACITY
end
slot = as_br_slot mgr bcnt
as_br_init_root slot agent_id root_id ts
seq = get as_mgr_next_seq mgr
put as_mgr_next_seq mgr add seq 1
as_br_inc_init slot get as_mgr_inc mgr seq
put as_mgr_branch_cnt mgr add bcnt 1
ret AS_OK
end

fn as_br_append_one_token slot ulong token_id uint to int
cnt = get as_br_tok_cnt slot
if ge cnt AS_MAX_TOKENS
ret AS_ERR_CAPACITY
end
prev = new uchar 32 0
nh = new uchar 32 0
rbase = mul slot 32
for i ulong 32
put prev i get as_br_rhash add rbase i
end
as_token_step_hash prev cnt token_id nh
tidx = add mul slot AS_MAX_TOKENS cnt
put as_br_tok_seq tidx cnt
put as_br_tok_id tidx token_id
hbase = mul tidx 32
for i ulong 32
put as_br_tok_hash add hbase i get nh i
put as_br_rhash add rbase i get nh i
end
put as_br_tok_cnt slot add cnt 1
ret AS_OK
end

fn as_mgr_append_tokens mgr ulong branch_id view uchar * tokens view uint * to int
bidx = as_mgr_find_branch mgr branch_id
if lt bidx 0
ret AS_ERR_BRANCH_NOT_FOUND
end
slot = as_br_slot mgr ulong bidx
n = len tokens
cur = get as_br_tok_cnt slot
if gt add cur n AS_MAX_TOKENS
ret AS_ERR_CAPACITY
end
for i ulong n bound 64
rc = as_br_append_one_token slot get tokens i
if ne rc AS_OK
ret rc
end
end
st = get as_br_inc_state slot
if ne st AS_COMPUTE_SUSPENDED
if ne st AS_COMPUTE_EVICTED
put as_br_inc_alloc_tok slot get as_br_tok_cnt slot
put as_br_inc_state slot AS_COMPUTE_DECODING
end
end
ret AS_OK
end

fn as_br_epi_eq_one slot ulong k ulong rec_id view uchar * to bool
off = add mul slot mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
if ne get as_br_epi_ids add off j get rec_id j
ret false
end
end
ret true
end

fn as_mgr_branch_epi_contains mgr ulong bidx ulong rec_id view uchar * to bool
slot = as_br_slot mgr bidx
cnt = get as_br_epi_cnt slot
for k ulong cnt bound 8
if as_br_epi_eq_one slot k rec_id
ret true
end
end
ret false
end

fn as_mgr_add_epistemic_ref mgr ulong branch_id view uchar * rec_id view uchar * to int
bidx = as_mgr_find_branch mgr branch_id
if lt bidx 0
ret AS_ERR_BRANCH_NOT_FOUND
end
if as_mgr_branch_epi_contains mgr ulong bidx rec_id
ret AS_OK
end
slot = as_br_slot mgr ulong bidx
cnt = get as_br_epi_cnt slot
if ge cnt AS_MAX_EPISTEMIC
ret AS_ERR_CAPACITY
end
off = add mul slot mul AS_MAX_EPISTEMIC 16 mul cnt 16
for j ulong 16
put as_br_epi_ids add off j get rec_id j
end
put as_br_epi_cnt slot add cnt 1
ret AS_OK
end

fn as_mgr_fork_branch mgr ulong parent_id view uchar * dst_child edit uchar * to int
pidx = as_mgr_find_branch mgr parent_id
if lt pidx 0
ret AS_ERR_PARENT_BRANCH_NOT_FOUND
end
pslot = as_br_slot mgr ulong pidx
bcnt = get as_mgr_branch_cnt mgr
if ge bcnt AS_MAX_BRANCHES
ret AS_ERR_CAPACITY
end
if ge get as_br_lin_cnt pslot AS_MAX_DEPTH
ret AS_ERR_CAPACITY
end
cidx = get as_br_child_cnt pslot
put as_br_child_cnt pslot add cidx 1
cid = new uchar 32 0
as_branch_id_derive parent_id cidx cid
for i ulong 32
put dst_child i get cid i
end
cslot = as_br_slot mgr bcnt
as_br_fork_slot cslot pslot cid add 1000 cidx
seq = get as_mgr_next_seq mgr
put as_mgr_next_seq mgr add seq 1
as_br_inc_init cslot get as_mgr_inc mgr seq
put as_mgr_branch_cnt mgr add bcnt 1
ret AS_OK
end

fn as_mgr_suspend mgr ulong branch_id view uchar * to int
bidx = as_mgr_find_branch mgr branch_id
if lt bidx 0
ret AS_ERR_BRANCH_NOT_FOUND
end
slot = as_br_slot mgr ulong bidx
if eq get as_br_inc_state slot AS_COMPUTE_SUSPENDED
ret AS_ERR_ALREADY_SUSPENDED
end
put as_br_inc_state slot AS_COMPUTE_SUSPENDED
ret AS_OK
end

fn as_mgr_resume mgr ulong branch_id view uchar * to long
bidx = as_mgr_find_branch mgr branch_id
if lt bidx 0
ret long AS_ERR_BRANCH_NOT_FOUND
end
slot = as_br_slot mgr ulong bidx
seq = get as_mgr_next_seq mgr
put as_mgr_next_seq mgr add seq 1
put as_br_inc_seq slot seq
if eq get as_br_inc_state slot AS_COMPUTE_SUSPENDED
put as_br_inc_state slot AS_COMPUTE_IDLE
end
ret long seq
end

fn as_mgr_reconstruct_physical mgr ulong branch_id view uchar * to int
bidx = as_mgr_find_branch mgr branch_id
if lt bidx 0
ret AS_ERR_BRANCH_NOT_FOUND
end
slot = as_br_slot mgr ulong bidx
tlen = get as_br_tok_cnt slot
put as_br_inc_alloc_tok slot tlen
put as_br_inc_kv_has slot 1
put as_br_inc_kv_ref slot add 0xdead0000 tlen
put as_br_inc_state slot AS_COMPUTE_DECODING
ret AS_OK
end

note === Snapshot staging helpers (copy manager <-> snapshot, encode/decode/seal, validate) ===

fn as_snap_clear to void
put as_snap_inc 0 0
put as_snap_agent_cnt 0 0
put as_snap_branch_cnt 0 0
end

fn as_br_to_snap_tok sb ulong slot ulong k ulong to void
st = add mul sb AS_MAX_TOKENS k
bt = add mul slot AS_MAX_TOKENS k
put as_snap_br_tok_seq st get as_br_tok_seq bt
put as_snap_br_tok_id st get as_br_tok_id bt
sh = mul st 32
bh = mul bt 32
for j ulong 32
put as_snap_br_tok_hash add sh j get as_br_tok_hash add bh j
end
end

fn as_br_to_snap_hist sb ulong slot ulong to void
tcnt = get as_br_tok_cnt slot
put as_snap_br_tok_cnt sb tcnt
sr = mul sb 32
br = mul slot 32
for i ulong 32
put as_snap_br_rhash add sr i get as_br_rhash add br i
end
for k ulong tcnt bound 64
as_br_to_snap_tok sb slot k
end
end

fn as_br_to_snap_lin_one sb ulong slot ulong k ulong to void
soff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
boff = add mul slot mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_snap_br_lin_anc add soff j get as_br_lin_anc add boff j
end
end

fn as_br_to_snap_lin sb ulong slot ulong to void
sr = mul sb 32
br = mul slot 32
for i ulong 32
put as_snap_br_lin_root add sr i get as_br_lin_root add br i
end
put as_snap_br_lin_depth sb get as_br_lin_depth slot
lcnt = get as_br_lin_cnt slot
put as_snap_br_lin_cnt sb lcnt
for k ulong lcnt bound 16
as_br_to_snap_lin_one sb slot k
end
end

fn as_br_to_snap_epi_one sb ulong slot ulong k ulong to void
soff = add mul sb mul AS_MAX_EPISTEMIC 16 mul k 16
boff = add mul slot mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put as_snap_br_epi_ids add soff j get as_br_epi_ids add boff j
end
end

fn as_br_to_snap_epi sb ulong slot ulong to void
ecnt = get as_br_epi_cnt slot
put as_snap_br_epi_cnt sb ecnt
for k ulong ecnt bound 8
as_br_to_snap_epi_one sb slot k
end
end

fn as_br_to_snap sb ulong slot ulong to void
so = mul sb 32
bo = mul slot 32
for i ulong 32
put as_snap_br_id add so i get as_br_id add bo i
put as_snap_br_parent_id add so i get as_br_parent_id add bo i
put as_snap_br_agent_id add so i get as_br_agent_id add bo i
end
put as_snap_br_has_parent sb get as_br_has_parent slot
put as_snap_br_created_at sb get as_br_created_at slot
as_br_to_snap_hist sb slot
as_br_to_snap_lin sb slot
as_br_to_snap_epi sb slot
end

fn as_snap_to_br_tok slot ulong sb ulong k ulong to void
bt = add mul slot AS_MAX_TOKENS k
st = add mul sb AS_MAX_TOKENS k
put as_br_tok_seq bt get as_snap_br_tok_seq st
put as_br_tok_id bt get as_snap_br_tok_id st
bh = mul bt 32
sh = mul st 32
for j ulong 32
put as_br_tok_hash add bh j get as_snap_br_tok_hash add sh j
end
end

fn as_snap_to_br_hist slot ulong sb ulong to void
tcnt = get as_snap_br_tok_cnt sb
put as_br_tok_cnt slot tcnt
br = mul slot 32
sr = mul sb 32
for i ulong 32
put as_br_rhash add br i get as_snap_br_rhash add sr i
end
for k ulong tcnt bound 64
as_snap_to_br_tok slot sb k
end
end

fn as_snap_to_br_lin_one slot ulong sb ulong k ulong to void
boff = add mul slot mul AS_MAX_DEPTH 32 mul k 32
soff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_br_lin_anc add boff j get as_snap_br_lin_anc add soff j
end
end

fn as_snap_to_br_lin slot ulong sb ulong to void
br = mul slot 32
sr = mul sb 32
for i ulong 32
put as_br_lin_root add br i get as_snap_br_lin_root add sr i
end
put as_br_lin_depth slot get as_snap_br_lin_depth sb
lcnt = get as_snap_br_lin_cnt sb
put as_br_lin_cnt slot lcnt
for k ulong lcnt bound 16
as_snap_to_br_lin_one slot sb k
end
end

fn as_snap_to_br_epi_one slot ulong sb ulong k ulong to void
boff = add mul slot mul AS_MAX_EPISTEMIC 16 mul k 16
soff = add mul sb mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put as_br_epi_ids add boff j get as_snap_br_epi_ids add soff j
end
end

fn as_snap_to_br_epi slot ulong sb ulong to void
ecnt = get as_snap_br_epi_cnt sb
put as_br_epi_cnt slot ecnt
for k ulong ecnt bound 8
as_snap_to_br_epi_one slot sb k
end
end

fn as_snap_to_br slot ulong sb ulong to void
bo = mul slot 32
so = mul sb 32
for i ulong 32
put as_br_id add bo i get as_snap_br_id add so i
put as_br_parent_id add bo i get as_snap_br_parent_id add so i
put as_br_agent_id add bo i get as_snap_br_agent_id add so i
end
put as_br_has_parent slot get as_snap_br_has_parent sb
put as_br_created_at slot get as_snap_br_created_at sb
as_snap_to_br_hist slot sb
as_snap_to_br_lin slot sb
as_snap_to_br_epi slot sb
end

fn as_br_id_cmp_slots s1 ulong s2 ulong to int
o1 = mul s1 32
o2 = mul s2 32
for i ulong 32
a = get as_br_id add o1 i
b = get as_br_id add o2 i
if lt a b
ret -1
end
if gt a b
ret 1
end
end
ret 0
end

fn as_snap_br_id_cmp sb1 ulong sb2 ulong to int
o1 = mul sb1 32
o2 = mul sb2 32
for i ulong 32
a = get as_snap_br_id add o1 i
b = get as_snap_br_id add o2 i
if lt a b
ret -1
end
if gt a b
ret 1
end
end
ret 0
end

fn as_snap_find_branch branch_id view uchar * to long
cnt = get as_snap_branch_cnt 0
for sb ulong cnt bound 32
off = mul sb 32
same = true
for i ulong 32
if ne get as_snap_br_id add off i get branch_id i
same = false
end
end
if same
ret long sb
end
end
ret -1
end

fn as_snap_copy_tok dst_b ulong src_b ulong k ulong to void
dt = add mul dst_b AS_MAX_TOKENS k
st = add mul src_b AS_MAX_TOKENS k
put as_snap_br_tok_seq dt get as_snap_br_tok_seq st
put as_snap_br_tok_id dt get as_snap_br_tok_id st
dh = mul dt 32
sh = mul st 32
for j ulong 32
put as_snap_br_tok_hash add dh j get as_snap_br_tok_hash add sh j
end
end

fn as_snap_copy_branch_hist dst_b ulong src_b ulong to void
tcnt = get as_snap_br_tok_cnt src_b
put as_snap_br_tok_cnt dst_b tcnt
for k ulong tcnt bound 64
as_snap_copy_tok dst_b src_b k
end
end

fn as_snap_copy_lin_one dst_b ulong src_b ulong k ulong to void
doff = add mul dst_b mul AS_MAX_DEPTH 32 mul k 32
soff = add mul src_b mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_snap_br_lin_anc add doff j get as_snap_br_lin_anc add soff j
end
end

fn as_snap_copy_branch_lin dst_b ulong src_b ulong to void
lcnt = get as_snap_br_lin_cnt src_b
put as_snap_br_lin_cnt dst_b lcnt
for k ulong lcnt bound 16
as_snap_copy_lin_one dst_b src_b k
end
end

fn as_snap_copy_epi_one dst_b ulong src_b ulong k ulong to void
doff = add mul dst_b mul AS_MAX_EPISTEMIC 16 mul k 16
soff = add mul src_b mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put as_snap_br_epi_ids add doff j get as_snap_br_epi_ids add soff j
end
end

fn as_snap_copy_branch_epi dst_b ulong src_b ulong to void
ecnt = get as_snap_br_epi_cnt src_b
put as_snap_br_epi_cnt dst_b ecnt
for k ulong ecnt bound 8
as_snap_copy_epi_one dst_b src_b k
end
end

fn as_snap_copy_branch dst_b ulong src_b ulong to void
doff = mul dst_b 32
soff = mul src_b 32
for i ulong 32
put as_snap_br_id add doff i get as_snap_br_id add soff i
put as_snap_br_parent_id add doff i get as_snap_br_parent_id add soff i
put as_snap_br_agent_id add doff i get as_snap_br_agent_id add soff i
put as_snap_br_rhash add doff i get as_snap_br_rhash add soff i
put as_snap_br_lin_root add doff i get as_snap_br_lin_root add soff i
end
put as_snap_br_has_parent dst_b get as_snap_br_has_parent src_b
put as_snap_br_created_at dst_b get as_snap_br_created_at src_b
put as_snap_br_lin_depth dst_b get as_snap_br_lin_depth src_b
as_snap_copy_branch_hist dst_b src_b
as_snap_copy_branch_lin dst_b src_b
as_snap_copy_branch_epi dst_b src_b
end

fn as_snap_remove_branch sb ulong to void
cnt = get as_snap_branch_cnt 0
if ge sb cnt
ret
end
last = sub cnt 1
if lt sb last
for idx ulong sub last sb bound 32
dst_b = add sb idx
as_snap_copy_branch dst_b add dst_b 1
end
end
put as_snap_branch_cnt 0 last
end

fn as_snap_push_new_root agent_id view uchar * ts ulong to int
cnt = get as_snap_branch_cnt 0
if ge cnt AS_MAX_BRANCHES
ret AS_ERR_CAPACITY
end
rid = new uchar 32 0
gh = new uchar 32 0
as_branch_id_root agent_id rid
as_token_genesis_hash gh
off = mul cnt 32
for i ulong 32
put as_snap_br_id add off i get rid i
put as_snap_br_parent_id add off i 0
put as_snap_br_agent_id add off i get agent_id i
put as_snap_br_rhash add off i get gh i
put as_snap_br_lin_root add off i get agent_id i
end
put as_snap_br_has_parent cnt 0
put as_snap_br_created_at cnt ts
put as_snap_br_tok_cnt cnt 0
put as_snap_br_lin_depth cnt 0
put as_snap_br_lin_cnt cnt 0
put as_snap_br_epi_cnt cnt 0
put as_snap_branch_cnt 0 add cnt 1
ret AS_OK
end

fn as_snap_encode_br_hdr buf edit uchar * pos ulong sb ulong to long
cap = len buf
if gt add pos 141 cap
ret long AS_ERR_SERIALIZATION
end
off = mul sb 32
for i ulong 32
put buf add pos i get as_snap_br_id add off i
end
pos = add pos 32
put buf pos get as_snap_br_has_parent sb
pos = add pos 1
for i ulong 32
put buf add pos i get as_snap_br_parent_id add off i
end
pos = add pos 32
for i ulong 32
put buf add pos i get as_snap_br_agent_id add off i
end
pos = add pos 32
as_put_u64_be buf pos get as_snap_br_created_at sb
pos = add pos 8
as_put_u32_be buf pos uint get as_snap_br_tok_cnt sb
pos = add pos 4
for i ulong 32
put buf add pos i get as_snap_br_rhash add off i
end
ret long add pos 32
end

fn as_snap_encode_br_toks buf edit uchar * pos ulong sb ulong to long
cap = len buf
tcnt = get as_snap_br_tok_cnt sb
if gt add pos mul tcnt 44 cap
ret long AS_ERR_SERIALIZATION
end
tb = mul sb AS_MAX_TOKENS
for k ulong tcnt bound 64
as_put_u64_be buf pos get as_snap_br_tok_seq add tb k
pos = add pos 8
as_put_u32_be buf pos get as_snap_br_tok_id add tb k
pos = add pos 4
hb = mul add tb k 32
for j ulong 32
put buf add pos j get as_snap_br_tok_hash add hb j
end
pos = add pos 32
end
ret long pos
end

fn as_snap_encode_one_anc buf edit uchar * pos ulong sb ulong k ulong to void
aoff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put buf add pos j get as_snap_br_lin_anc add aoff j
end
end

fn as_snap_encode_br_lin buf edit uchar * pos ulong sb ulong to long
lcnt = get as_snap_br_lin_cnt sb
if gt add pos add 44 mul lcnt 32 len buf
ret long AS_ERR_SERIALIZATION
end
off = mul sb 32
for i ulong 32
put buf add pos i get as_snap_br_lin_root add off i
end
pos = add pos 32
as_put_u64_be buf pos get as_snap_br_lin_depth sb
pos = add pos 8
as_put_u32_be buf pos uint lcnt
pos = add pos 4
for k ulong lcnt bound 16
as_snap_encode_one_anc buf pos sb k
pos = add pos 32
end
ret long pos
end

fn as_snap_encode_one_epi buf edit uchar * pos ulong sb ulong k ulong to void
eoff = add mul sb mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put buf add pos j get as_snap_br_epi_ids add eoff j
end
end

fn as_snap_encode_br_epi buf edit uchar * pos ulong sb ulong to long
ecnt = get as_snap_br_epi_cnt sb
if gt add pos add 4 mul ecnt 16 len buf
ret long AS_ERR_SERIALIZATION
end
as_put_u32_be buf pos uint ecnt
pos = add pos 4
for k ulong ecnt bound 8
as_snap_encode_one_epi buf pos sb k
pos = add pos 16
end
ret long pos
end

fn as_snap_encode_br_body buf edit uchar * pos ulong sb ulong to long
p1 = as_snap_encode_br_toks buf pos sb
if lt p1 0
ret p1
end
p2 = as_snap_encode_br_lin buf ulong p1 sb
if lt p2 0
ret p2
end
ret as_snap_encode_br_epi buf ulong p2 sb
end

fn as_seal_snap_agents buf edit uchar * pos ulong to long
acnt = get as_snap_agent_cnt 0
if gt add pos add 4 mul acnt 32 len buf
ret long AS_ERR_SERIALIZATION
end
as_put_u32_be buf pos uint acnt
pos = add pos 4
for a ulong acnt bound 8
aoff = mul a 32
for i ulong 32
put buf add pos i get as_snap_agents add aoff i
end
pos = add pos 32
end
ret long pos
end

fn as_seal_snapshot buf edit uchar * to long
if lt len buf 60
ret long AS_ERR_SERIALIZATION
end
for i ulong 8
put buf i get as_ckpt_magic i
end
as_put_u64_be buf 44 get as_snap_inc 0
pa = as_seal_snap_agents buf 52
if lt pa 0
ret pa
end
pos = ulong pa
if gt add pos 4 len buf
ret long AS_ERR_SERIALIZATION
end
bcnt = get as_snap_branch_cnt 0
as_put_u32_be buf pos uint bcnt
pos = add pos 4
for sb ulong bcnt bound 32
p1 = as_snap_encode_br_hdr buf pos sb
if lt p1 0
ret p1
end
p2 = as_snap_encode_br_body buf ulong p1 sb
if lt p2 0
ret p2
end
pos = ulong p2
end
plen = sub pos 44
as_put_u32_be buf 40 uint plen
dig = new uchar 32 0
if ne sha2_digest 256 part buf 44 plen dig 32
ret long AS_ERR_SERIALIZATION
end
for i ulong 32
put buf add 8 i get dig i
end
ret long pos
end

fn as_snap_decode_br_hdr buf view uchar * pos ulong total ulong sb ulong to long
if gt add pos 141 total
ret long AS_ERR_DESERIALIZATION
end
off = mul sb 32
for i ulong 32
put as_snap_br_id add off i get buf add pos i
end
pos = add pos 32
hp = get buf pos
if gt hp 1
ret long AS_ERR_DESERIALIZATION
end
put as_snap_br_has_parent sb hp
pos = add pos 1
for i ulong 32
put as_snap_br_parent_id add off i get buf add pos i
end
pos = add pos 32
for i ulong 32
put as_snap_br_agent_id add off i get buf add pos i
end
pos = add pos 32
put as_snap_br_created_at sb as_get_u64_be buf pos
pos = add pos 8
tcnt = ulong as_get_u32_be buf pos
if gt tcnt AS_MAX_TOKENS
ret long AS_ERR_DESERIALIZATION
end
put as_snap_br_tok_cnt sb tcnt
pos = add pos 4
for i ulong 32
put as_snap_br_rhash add off i get buf add pos i
end
ret long add pos 32
end

fn as_snap_decode_br_toks buf view uchar * pos ulong total ulong sb ulong to long
tcnt = get as_snap_br_tok_cnt sb
if gt add pos mul tcnt 44 total
ret long AS_ERR_DESERIALIZATION
end
tb = mul sb AS_MAX_TOKENS
for k ulong tcnt bound 64
put as_snap_br_tok_seq add tb k as_get_u64_be buf pos
pos = add pos 8
put as_snap_br_tok_id add tb k as_get_u32_be buf pos
pos = add pos 4
hb = mul add tb k 32
for j ulong 32
put as_snap_br_tok_hash add hb j get buf add pos j
end
pos = add pos 32
end
ret long pos
end

fn as_snap_decode_one_anc buf view uchar * pos ulong sb ulong k ulong to void
aoff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
put as_snap_br_lin_anc add aoff j get buf add pos j
end
end

fn as_snap_decode_br_lin buf view uchar * pos ulong total ulong sb ulong to long
if gt add pos 44 total
ret long AS_ERR_DESERIALIZATION
end
off = mul sb 32
for i ulong 32
put as_snap_br_lin_root add off i get buf add pos i
end
pos = add pos 32
put as_snap_br_lin_depth sb as_get_u64_be buf pos
pos = add pos 8
lcnt = ulong as_get_u32_be buf pos
pos = add pos 4
if gt lcnt AS_MAX_DEPTH
ret long AS_ERR_DESERIALIZATION
end
if gt add pos mul lcnt 32 total
ret long AS_ERR_DESERIALIZATION
end
put as_snap_br_lin_cnt sb lcnt
for k ulong lcnt bound 16
as_snap_decode_one_anc buf pos sb k
pos = add pos 32
end
ret long pos
end

fn as_snap_decode_one_epi buf view uchar * pos ulong sb ulong k ulong to void
eoff = add mul sb mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
put as_snap_br_epi_ids add eoff j get buf add pos j
end
end

fn as_snap_decode_br_epi buf view uchar * pos ulong total ulong sb ulong to long
if gt add pos 4 total
ret long AS_ERR_DESERIALIZATION
end
ecnt = ulong as_get_u32_be buf pos
pos = add pos 4
if gt ecnt AS_MAX_EPISTEMIC
ret long AS_ERR_DESERIALIZATION
end
if gt add pos mul ecnt 16 total
ret long AS_ERR_DESERIALIZATION
end
put as_snap_br_epi_cnt sb ecnt
for k ulong ecnt bound 8
as_snap_decode_one_epi buf pos sb k
pos = add pos 16
end
ret long pos
end

fn as_snap_decode_br_lin_epi buf view uchar * pos ulong total ulong sb ulong to long
p1 = as_snap_decode_br_lin buf pos total sb
if lt p1 0
ret p1
end
ret as_snap_decode_br_epi buf ulong p1 total sb
end

fn as_decode_ckpt_envelope buf view uchar * total ulong to int
if lt total 44
ret AS_ERR_DESERIALIZATION
end
if gt total len buf
ret AS_ERR_DESERIALIZATION
end
for i ulong 8
if ne get buf i get as_ckpt_magic i
ret AS_ERR_DESERIALIZATION
end
end
plen = ulong as_get_u32_be buf 40
if ne add 44 plen total
ret AS_ERR_DESERIALIZATION
end
dig = new uchar 32 0
if ne sha2_digest 256 part buf 44 plen dig 32
ret AS_ERR_DESERIALIZATION
end
for i ulong 32
if ne get buf add 8 i get dig i
ret AS_ERR_CHECKSUM_MISMATCH
end
end
ret AS_OK
end

fn as_decode_snap_agents buf view uchar * pos ulong total ulong to long
if gt add pos 12 total
ret long AS_ERR_DESERIALIZATION
end
put as_snap_inc 0 as_get_u64_be buf pos
pos = add pos 8
acnt = ulong as_get_u32_be buf pos
pos = add pos 4
if gt acnt AS_MAX_AGENTS
ret long AS_ERR_DESERIALIZATION
end
if gt add pos add mul acnt 32 4 total
ret long AS_ERR_DESERIALIZATION
end
put as_snap_agent_cnt 0 acnt
for a ulong acnt bound 8
aoff = mul a 32
for i ulong 32
put as_snap_agents add aoff i get buf add pos i
end
pos = add pos 32
end
ret long pos
end

fn as_decode_checkpoint_to_snap buf view uchar * total ulong to int
rc = as_decode_ckpt_envelope buf total
if ne rc AS_OK
ret rc
end
pa = as_decode_snap_agents buf 44 total
if lt pa 0
ret int pa
end
pos = ulong pa
bcnt = ulong as_get_u32_be buf pos
pos = add pos 4
if gt bcnt AS_MAX_BRANCHES
ret AS_ERR_DESERIALIZATION
end
put as_snap_branch_cnt 0 bcnt
for sb ulong bcnt bound 32
p1 = as_snap_decode_br_hdr buf pos total sb
if lt p1 0
ret int p1
end
p2 = as_snap_decode_br_toks buf ulong p1 total sb
if lt p2 0
ret int p2
end
p3 = as_snap_decode_br_lin_epi buf ulong p2 total sb
if lt p3 0
ret int p3
end
pos = ulong p3
end
if ne pos total
ret AS_ERR_DESERIALIZATION
end
ret AS_OK
end

note === Checkpoint export & validation ===

fn as_br_matches_agent slot ulong agent_id view uchar * to bool
boff = mul slot 32
for i ulong 32
if ne get as_br_agent_id add boff i get agent_id i
ret false
end
end
ret true
end

fn as_sort_val_order_br mcnt ulong to void
for i ulong mcnt bound 32
for j ulong mcnt bound 32
if lt add j 1 mcnt
s1 = get as_val_order j
s2 = get as_val_order add j 1
if gt as_br_id_cmp_slots s1 s2 0
put as_val_order j s2
put as_val_order add j 1 s1
end
end
end
end
end

fn as_mgr_export_checkpoint mgr ulong agent_id view uchar * dst_buf edit uchar * to long
if not as_mgr_has_agent mgr agent_id
ret long AS_ERR_AGENT_NOT_FOUND
end
as_snap_clear
put as_snap_inc 0 get as_mgr_inc mgr
put as_snap_agent_cnt 0 1
for i ulong 32
put as_snap_agents i get agent_id i
end
bcnt = get as_mgr_branch_cnt mgr
mcnt = ulong 0
for b ulong bcnt bound 32
slot = as_br_slot mgr b
if as_br_matches_agent slot agent_id
put as_val_order mcnt slot
mcnt = add mcnt 1
end
end
as_sort_val_order_br mcnt
put as_snap_branch_cnt 0 mcnt
for k ulong mcnt bound 32
as_br_to_snap k get as_val_order k
end
ret as_seal_snapshot dst_buf
end

fn as_mgr_checkpoint mgr ulong agent_id view uchar * dst_hash edit uchar * to int
tmp = new uchar 65536 0
n = as_mgr_export_checkpoint mgr agent_id tmp
if lt n 0
ret int n
end
for i ulong 32
put dst_hash i get tmp add 8 i
end
ret AS_OK
end

note === Restore validation helpers (exact Rust order) ===

fn as_snap_has_agent agent_id view uchar * limit ulong to bool
for a ulong limit bound 8
aoff = mul a 32
same = true
for i ulong 32
if ne get as_snap_agents add aoff i get agent_id i
same = false
end
end
if same
ret true
end
end
ret false
end

fn as_val_find_sorted target view uchar * bcnt ulong to long
for i ulong bcnt bound 32
sb = get as_val_order i
off = mul sb 32
same = true
for j ulong 32
if ne get as_snap_br_id add off j get target j
same = false
end
end
if same
ret long i
end
end
ret -1
end

fn as_val_agents_and_branches to int
acnt = get as_snap_agent_cnt 0
if eq acnt 0
ret AS_ERR_CKPT_NO_AGENT
end
aid = new uchar 32 0
for a ulong acnt bound 8
aoff = mul a 32
for i ulong 32
put aid i get as_snap_agents add aoff i
end
if as_snap_has_agent aid a
ret AS_ERR_CKPT_DUP_AGENT
end
end
bcnt = get as_snap_branch_cnt 0
for sb ulong bcnt bound 32
boff = mul sb 32
for i ulong 32
put aid i get as_snap_br_agent_id add boff i
end
if not as_snap_has_agent aid acnt
ret AS_ERR_CKPT_ABSENT_AGENT
end
for prev ulong sb bound 32
if eq as_snap_br_id_cmp prev sb 0
ret AS_ERR_CKPT_DUP_BRANCH
end
end
put as_val_order sb sb
end
note Sort as_val_order ascending by branch_id (matching Rust BTreeMap)
for i ulong bcnt bound 32
for j ulong bcnt bound 32
if lt add j 1 bcnt
s1 = get as_val_order j
s2 = get as_val_order add j 1
if gt as_snap_br_id_cmp s1 s2 0
put as_val_order j s2
put as_val_order add j 1 s1
end
end
end
end
ret AS_OK
end

fn as_val_one_root a ulong bcnt ulong to int
aid = new uchar 32 0
rid = new uchar 32 0
aoff = mul a 32
for i ulong 32
put aid i get as_snap_agents add aoff i
end
as_branch_id_root aid rid
rpos = as_val_find_sorted rid bcnt
if lt rpos 0
ret AS_ERR_CKPT_MISSING_ROOT
end
rsb = get as_val_order ulong rpos
roff = mul rsb 32
for i ulong 32
if ne get as_snap_br_agent_id add roff i get aid i
ret AS_ERR_CKPT_INCONSISTENT_ROOT
end
if ne get as_snap_br_lin_root add roff i get aid i
ret AS_ERR_CKPT_INCONSISTENT_ROOT
end
end
if ne get as_snap_br_has_parent rsb 0
ret AS_ERR_CKPT_INCONSISTENT_ROOT
end
if ne get as_snap_br_lin_depth rsb 0
ret AS_ERR_CKPT_INCONSISTENT_ROOT
end
if ne get as_snap_br_lin_cnt rsb 0
ret AS_ERR_CKPT_INCONSISTENT_ROOT
end
ret AS_OK
end

fn as_val_roots to int
acnt = get as_snap_agent_cnt 0
bcnt = get as_snap_branch_cnt 0
for a ulong acnt bound 8
rc = as_val_one_root a bcnt
if ne rc AS_OK
ret rc
end
end
ret AS_OK
end

fn as_val_child_anc_eq sb ulong psb ulong k ulong to bool
boff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
poff = add mul psb mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
if ne get as_snap_br_lin_anc add boff j get as_snap_br_lin_anc add poff j
ret false
end
end
ret true
end

fn as_val_child_lineage sb ulong psb ulong to int
boff = mul sb 32
poff = mul psb 32
for i ulong 32
if ne get as_snap_br_agent_id add boff i get as_snap_br_agent_id add poff i
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
if ne get as_snap_br_lin_root add boff i get as_snap_br_lin_root add poff i
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
end
pdepth = get as_snap_br_lin_depth psb
if eq pdepth 0xffffffffffffffff
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
if ne get as_snap_br_lin_depth sb add pdepth 1
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
pcnt = get as_snap_br_lin_cnt psb
if ne get as_snap_br_lin_cnt sb add pcnt 1
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
for k ulong pcnt bound 16
if not as_val_child_anc_eq sb psb k
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
end
last_off = add mul sb mul AS_MAX_DEPTH 32 mul pcnt 32
for j ulong 32
if ne get as_snap_br_lin_anc add last_off j get as_snap_br_id add boff j
ret AS_ERR_CKPT_INCONSISTENT_LINEAGE
end
end
ret AS_OK
end

fn as_val_one_branch i ulong bcnt ulong to int
sb = get as_val_order i
off = mul sb 32
tmp = new uchar 32 0
exp = new uchar 32 0
if eq get as_snap_br_has_parent sb 0
for j ulong 32
put tmp j get as_snap_br_agent_id add off j
end
as_branch_id_root tmp exp
for j ulong 32
if ne get as_snap_br_id add off j get exp j
ret AS_ERR_CKPT_UNEXPECTED_ROOT
end
end
ret AS_OK
end
for j ulong 32
put tmp j get as_snap_br_parent_id add off j
end
ppos = as_val_find_sorted tmp bcnt
if lt ppos 0
ret AS_ERR_CKPT_MISSING_PARENT
end
psb = get as_val_order ulong ppos
rc = as_val_child_lineage sb psb
if ne rc AS_OK
ret rc
end
put as_val_child_cnt ulong ppos add get as_val_child_cnt ulong ppos 1
ret AS_OK
end

fn as_val_parents_and_lineage to int
bcnt = get as_snap_branch_cnt 0
for i ulong bcnt bound 32
put as_val_child_cnt i 0
end
for i ulong bcnt bound 32
rc = as_val_one_branch i bcnt
if ne rc AS_OK
ret rc
end
end
ret AS_OK
end

fn as_val_one_fork pid view uchar * cidx ulong bcnt ulong to int
cid = new uchar 32 0
as_branch_id_derive pid cidx cid
cpos = as_val_find_sorted cid bcnt
if lt cpos 0
ret AS_ERR_CKPT_NONCONTIGUOUS_FORK
end
csb = get as_val_order ulong cpos
if eq get as_snap_br_has_parent csb 0
ret AS_ERR_CKPT_NONCONTIGUOUS_FORK
end
coff = mul csb 32
for j ulong 32
if ne get as_snap_br_parent_id add coff j get pid j
ret AS_ERR_CKPT_NONCONTIGUOUS_FORK
end
end
ret AS_OK
end

fn as_val_parent_forks i ulong bcnt ulong to int
ccnt = get as_val_child_cnt i
if eq ccnt 0
ret AS_OK
end
pid = new uchar 32 0
psb = get as_val_order i
poff = mul psb 32
for j ulong 32
put pid j get as_snap_br_id add poff j
end
for cidx ulong ccnt bound 32
rc = as_val_one_fork pid cidx bcnt
if ne rc AS_OK
ret rc
end
end
ret AS_OK
end

fn as_val_contiguous_forks to int
bcnt = get as_snap_branch_cnt 0
for i ulong bcnt bound 32
rc = as_val_parent_forks i bcnt
if ne rc AS_OK
ret rc
end
end
ret AS_OK
end

fn as_mgr_commit_snap_agents mgr ulong to void
acnt = get as_snap_agent_cnt 0
put as_mgr_agent_cnt mgr acnt
mabase = mul mgr mul AS_MAX_AGENTS 32
for a ulong acnt bound 8
aoff = mul a 32
doff = add mabase aoff
for j ulong 32
put as_mgr_agents add doff j get as_snap_agents add aoff j
end
end
end

fn as_mgr_restore_from_checkpoint mgr ulong ckpt view uchar * ckpt_len ulong new_inc ulong to int
rc = as_decode_checkpoint_to_snap ckpt ckpt_len
if ne rc AS_OK
ret rc
end
rc = as_val_agents_and_branches
if ne rc AS_OK
ret rc
end
rc = as_val_roots
if ne rc AS_OK
ret rc
end
rc = as_val_parents_and_lineage
if ne rc AS_OK
ret rc
end
rc = as_val_contiguous_forks
if ne rc AS_OK
ret rc
end
as_mgr_init mgr new_inc
as_mgr_commit_snap_agents mgr
bcnt = get as_snap_branch_cnt 0
put as_mgr_branch_cnt mgr bcnt
for i ulong bcnt bound 32
sb = get as_val_order i
slot = as_br_slot mgr i
as_snap_to_br slot sb
put as_br_child_cnt slot get as_val_child_cnt i
seq = get as_mgr_next_seq mgr
put as_mgr_next_seq mgr add seq 1
as_br_inc_init slot new_inc seq
as_br_inc_evict slot
end
ret AS_OK
end

note === Deep equality helper comparing a branch slot with a snapshot branch ===

fn as_br_eq_snap_tok slot ulong sb ulong k ulong to bool
bt = add mul slot AS_MAX_TOKENS k
st = add mul sb AS_MAX_TOKENS k
if ne get as_br_tok_seq bt get as_snap_br_tok_seq st
ret false
end
if ne get as_br_tok_id bt get as_snap_br_tok_id st
ret false
end
bh = mul bt 32
sh = mul st 32
for j ulong 32
if ne get as_br_tok_hash add bh j get as_snap_br_tok_hash add sh j
ret false
end
end
ret true
end

fn as_br_eq_snap_hist slot ulong sb ulong to bool
tcnt = get as_br_tok_cnt slot
if ne tcnt get as_snap_br_tok_cnt sb
ret false
end
bo = mul slot 32
so = mul sb 32
for i ulong 32
if ne get as_br_rhash add bo i get as_snap_br_rhash add so i
ret false
end
end
for k ulong tcnt bound 64
if not as_br_eq_snap_tok slot sb k
ret false
end
end
ret true
end

fn as_br_eq_snap_lin_one slot ulong sb ulong k ulong to bool
boff = add mul slot mul AS_MAX_DEPTH 32 mul k 32
soff = add mul sb mul AS_MAX_DEPTH 32 mul k 32
for j ulong 32
if ne get as_br_lin_anc add boff j get as_snap_br_lin_anc add soff j
ret false
end
end
ret true
end

fn as_br_eq_snap_lin slot ulong sb ulong to bool
bo = mul slot 32
so = mul sb 32
for i ulong 32
if ne get as_br_lin_root add bo i get as_snap_br_lin_root add so i
ret false
end
end
if ne get as_br_lin_depth slot get as_snap_br_lin_depth sb
ret false
end
lcnt = get as_br_lin_cnt slot
if ne lcnt get as_snap_br_lin_cnt sb
ret false
end
for k ulong lcnt bound 16
if not as_br_eq_snap_lin_one slot sb k
ret false
end
end
ret true
end

fn as_br_eq_snap_epi_one slot ulong sb ulong k ulong to bool
boff = add mul slot mul AS_MAX_EPISTEMIC 16 mul k 16
soff = add mul sb mul AS_MAX_EPISTEMIC 16 mul k 16
for j ulong 16
if ne get as_br_epi_ids add boff j get as_snap_br_epi_ids add soff j
ret false
end
end
ret true
end

fn as_br_eq_snap_epi slot ulong sb ulong to bool
ecnt = get as_br_epi_cnt slot
if ne ecnt get as_snap_br_epi_cnt sb
ret false
end
for k ulong ecnt bound 8
if not as_br_eq_snap_epi_one slot sb k
ret false
end
end
ret true
end

fn as_br_eq_snap_lin_epi slot ulong sb ulong to bool
if not as_br_eq_snap_lin slot sb
ret false
end
ret as_br_eq_snap_epi slot sb
end

fn as_br_eq_snap slot ulong sb ulong to bool
if ne get as_br_has_parent slot get as_snap_br_has_parent sb
ret false
end
if ne get as_br_created_at slot get as_snap_br_created_at sb
ret false
end
bo = mul slot 32
so = mul sb 32
for i ulong 32
if ne get as_br_id add bo i get as_snap_br_id add so i
ret false
end
if ne get as_br_parent_id add bo i get as_snap_br_parent_id add so i
ret false
end
if ne get as_br_agent_id add bo i get as_snap_br_agent_id add so i
ret false
end
end
if not as_br_eq_snap_hist slot sb
ret false
end
ret as_br_eq_snap_lin_epi slot sb
end

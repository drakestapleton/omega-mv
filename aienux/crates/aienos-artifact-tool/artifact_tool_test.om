note aienux/crates/aienos-artifact-tool/artifact_tool_test.om: Behavioral self-test for aienos-artifact-tool.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-artifact-tool/artifact_tool.om aienux/crates/aienos-artifact-tool/artifact_tool_test.om

note Golden artifact_id hex from main.rs::tests::deterministic_pack_uses_the_shared_parser_and_id
text t_golden_id "71976b5c38ec15f2307565ed3eea51fde4a5375970cd49338d6e16166238cf4b"
text t_data4 "DATA"
text t_bad_cmd "unknown"
text t_arg_x "x"
text t_ws_pre "  \n\t"

fn t_test_pack_and_golden_id to int
at_manifest_reset
at_manifest_set_entry 0
idx = at_manifest_push_cap 3 7 1 1 4
if lt idx 0
ret 1
end
at_manifest_set_cap_bounds ulong idx 4 0 4
at_manifest_set_res_pages 1 1 1 1
at_manifest_set_res_limits 2 16 1000 2000 16
code = new uchar 4 0
put code 0 0xc0
put code 1 0x03
put code 2 0x5f
put code 3 0xd6
b1 = new uchar 512 0
b2 = new uchar 512 0
if ne at_pack code t_data4 b1 AT_OK
ret 2
end
n1 = get at_pack_len 0
if ne at_pack code t_data4 b2 AT_OK
ret 3
end
n2 = get at_pack_len 0
if ne n1 n2
ret 4
end
if not at_bytes_eq part b1 0 n1 part b2 0 n2
ret 5
end
hex_buf = new uchar 64 0
if ne at_id_hex part b1 0 n1 hex_buf AT_OK
ret 6
end
if not at_bytes_eq hex_buf t_golden_id
ret 7
end
if ne at_inspect_artifact part b1 0 n1 AT_OK
ret 8
end
if ne get at_art_meta 2 1
ret 9
end
if ne get at_art_meta 7 4
ret 10
end
if ne get at_art_meta 9 4
ret 11
end
ret 0
end

fn t_test_sign_and_verify to int
at_manifest_reset
at_manifest_set_res_pages 1 1 1 0
at_manifest_set_res_limits 0 0 1 1 1
code = new uchar 4 0
put code 0 0xc0
put code 1 0x03
put code 2 0x5f
put code 3 0xd6
buf = new uchar 512 0
if ne at_pack code t_data4 buf AT_OK
ret 12
end
n = get at_pack_len 0
note Production mode refuses signing and fails closed on verify
if ne at_sign_artifact part buf 0 n false AT_ERR_PROD_SIGN_OFF
ret 13
end
if ne at_sign_artifact part buf 0 n true AT_OK
ret 14
end
if ne at_verify_artifact part buf 0 n true AT_OK
ret 15
end
if ne at_verify_artifact part buf 0 n false AT_ERR_UNTRUSTED
ret 16
end
note Mutate one payload byte -> BadSignature (18)
pay_off = get at_art_meta 4
put buf pay_off xor get buf pay_off 1
if ne at_verify_artifact part buf 0 n true AT_ERR_BAD_SIG
ret 17
end
note Restore payload, mutate one signature byte -> BadSignature (18)
put buf pay_off xor get buf pay_off 1
sig_off = get at_art_meta 6
put buf add sig_off 40 xor get buf add sig_off 40 1
if ne at_verify_artifact part buf 0 n true AT_ERR_BAD_SIG
ret 18
end
ret 0
end

fn t_test_corpus_all_29 to int
base = new uchar 600 0
if ne at_corpus_build_baseline base AT_OK
ret 20
end
bn = get at_corpus_len 0
if ne at_verify_artifact part base 0 bn true AT_OK
ret 21
end
c1 = new uchar 600 0
c2 = new uchar 600 0
for i ulong AT_CORPUS_COUNT
cid = add i 1
if ne at_corpus_build_case cid c1 AT_OK
ret 22
end
n1 = get at_corpus_len 0
if ne at_corpus_build_case cid c2 AT_OK
ret 23
end
n2 = get at_corpus_len 0
if ne n1 n2
ret 24
end
if not at_bytes_eq part c1 0 n1 part c2 0 n2
ret 25
end
note Every corpus case must differ from baseline
if at_bytes_eq part c1 0 n1 part base 0 bn
ret 26
end
if ne at_corpus_expect cid AT_OK
ret 27
end
ek = get at_corpus_exp 0
ecode = int get at_corpus_exp 1
vrc = at_verify_artifact part c1 0 n1 true
if eq ek AT_EXP_REJ_VERIFIED
if ne vrc ecode
ret add 30 int cid
end
else
if ne vrc AT_OK
ret add 60 int cid
end
end
end
note Invalid case IDs rejected
if ne at_corpus_build_case 0 c1 AT_ERR_BAD_CASE
ret 28
end
if ne at_corpus_build_case 30 c1 AT_ERR_BAD_CASE
ret 29
end
ret 0
end

fn t_stage_binding_rcp art view uchar * admitted bool to int
ver_id = new uchar 32 7
nonce = new uchar 16 0
tmp = new uchar 32 0
pol = new uchar 32 1
gr = new uchar 32 2
if ne at_parse_and_identify art AT_OK
ret 90
end
at_rcp_reset
put at_rcp_f 0 0
if admitted
put at_rcp_f 1 AT_DEC_ADMITTED
put at_rcp_f 5 AT_EXEC_EXITED
put at_rcp_f 8 0
put at_rcp_f 9 0
else
put at_rcp_f 1 AT_DEC_REJECTED
put at_rcp_f 5 AT_EXEC_NOT_RUN
put at_rcp_f 8 3
put at_rcp_f 9 17
end
put at_rcp_f 2 AT_TIER_QEMU
put at_rcp_f 3 1
put at_rcp_f 7 AT_RCP_RES_RECLAIMED
at_rcp_nonce ver_id 1 nonce
for i ulong 16
put at_rcp_nonce_buf i get nonce i
end
for i ulong 32
put tmp i get at_art_id i
end
at_rcp_set_digest 0 tmp
for i ulong 32
put tmp i get at_art_payload_sha i
end
at_rcp_set_digest 1 tmp
for i ulong 32
put tmp i get at_art_signer_fp i
end
at_rcp_set_digest 2 tmp
at_rcp_set_digest 3 pol
for i ulong 32
put tmp i get at_art_req_caps_sha i
end
at_rcp_set_digest 4 tmp
if admitted
at_rcp_set_digest 5 gr
end
for i ulong 32
put tmp i get at_art_res_env_sha i
end
at_rcp_set_digest 6 tmp
at_rcp_set_digest 7 ver_id
ret 0
end

fn t_test_receipt_check to int
art = new uchar 600 0
if ne at_corpus_build_baseline art AT_OK
ret 91
end
an = get at_corpus_len 0
note 1. Valid admitted receipt binds supplied artifact
if ne t_stage_binding_rcp part art 0 an true 0
ret 92
end
rec = new uchar 512 0
if ne at_rcp_encode rec AT_OK
ret 93
end
if ne at_rcp_check rec part art 0 an AT_OK
ret 94
end
note 2. Valid rejected receipt with zero signer_fp is allowed
if ne t_stage_binding_rcp part art 0 an false 0
ret 95
end
z32 = new uchar 32 0
at_rcp_set_digest 2 z32
if ne at_rcp_encode rec AT_OK
ret 96
end
if ne at_rcp_check rec part art 0 an AT_OK
ret 97
end
note 3. Wrong artifact_id rejected
if ne t_stage_binding_rcp part art 0 an true 0
ret 98
end
bad9 = new uchar 32 9
at_rcp_set_digest 0 bad9
if ne at_rcp_encode rec AT_OK
ret 99
end
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_BIND_MISMATCH
ret 100
end
note 4. Zero payload_digest in admitted receipt rejected
if ne t_stage_binding_rcp part art 0 an true 0
ret 101
end
at_rcp_set_digest 1 z32
if ne at_rcp_encode rec AT_OK
ret 102
end
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_BIND_MISMATCH
ret 103
end
note 5. Admitted receipt without granted_capability_digest rejected
if ne t_stage_binding_rcp part art 0 an true 0
ret 104
end
at_rcp_set_digest 5 z32
if ne at_rcp_encode rec AT_OK
ret 105
end
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_NO_GRANTS
ret 106
end
note 6. Signed receipt rejected by kernel-emitted check
if ne t_stage_binding_rcp part art 0 an true 0
ret 107
end
if ne at_rcp_encode rec AT_OK
ret 108
end
put rec 400 1
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_MUST_UNSIGNED
ret 109
end
note 7. Mutated artifact fails binding check
put rec 400 0
last_p = sub an 101
put art last_p xor get art last_p 1
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_BIND_MISMATCH
ret 110
end
note 8. Unparseable artifact: admitted rejected, rejected with zero fields accepted
put art 0 88
if ne at_rcp_check rec part art 0 an AT_ERR_RCP_ADMIT_BAD_ART
ret 111
end
at_rcp_reset
put at_rcp_f 1 AT_DEC_REJECTED
put at_rcp_f 2 AT_TIER_QEMU
put at_rcp_f 3 2
put at_rcp_f 5 AT_EXEC_NOT_RUN
put at_rcp_f 8 1
put at_rcp_f 9 1
ver_id = new uchar 32 7
nonce = new uchar 16 0
at_rcp_nonce ver_id 2 nonce
for i ulong 16
put at_rcp_nonce_buf i get nonce i
end
at_rcp_set_digest 7 ver_id
if ne at_rcp_encode rec AT_OK
ret 112
end
if ne at_rcp_check rec part art 0 an AT_OK
ret 113
end
ret 0
end

fn t_test_receipt_sign_verify_hex to int
art = new uchar 600 0
if ne at_corpus_build_baseline art AT_OK
ret 120
end
an = get at_corpus_len 0
if ne t_stage_binding_rcp part art 0 an true 0
ret 121
end
rec = new uchar 512 0
if ne at_rcp_encode rec AT_OK
ret 122
end
note Inspect unsigned receipt
if ne at_rcp_inspect rec AT_OK
ret 123
end
if ne get at_rcp_signed_flag 0 0
ret 124
end
note Unsigned receipt fails verify with BadSignatureFormat (15)
if ne at_rcp_verify rec true AT_ERR_BAD_SIG_FMT
ret 125
end
note Production sign-test fails closed
if ne at_rcp_sign_test rec false AT_ERR_PROD_SIGN_OFF
ret 126
end
note Test sign-test succeeds and verifies in test mode, fails closed in prod mode
if ne at_rcp_sign_test rec true AT_OK
ret 127
end
if ne at_rcp_inspect rec AT_OK
ret 128
end
if ne get at_rcp_signed_flag 0 1
ret 129
end
if ne at_rcp_verify rec true AT_OK
ret 130
end
if ne at_rcp_verify rec false AT_ERR_UNTRUSTED
ret 131
end
note Re-signing an already-signed receipt fails with BadSignatureFormat (15)
if ne at_rcp_sign_test rec true AT_ERR_BAD_SIG_FMT
ret 132
end
note Roundtrip through from-hex with leading/trailing whitespace
hex_full = new uchar 1031 0
for i ulong 4
put hex_full i get t_ws_pre i
end
if ne at_hex_encode rec part hex_full 4 1024 AT_OK
ret 133
end
put hex_full 1028 13
put hex_full 1029 10
put hex_full 1030 32
dec_rec = new uchar 512 0
if ne at_rcp_from_hex hex_full dec_rec AT_OK
ret 134
end
if not at_bytes_eq rec dec_rec
ret 135
end
note Uppercase hex rejected by from-hex
put hex_full 4 65
if ne at_rcp_from_hex hex_full dec_rec AT_ERR_BAD_HEX
ret 136
end
note Wrong length hex rejected
if ne at_rcp_from_hex part hex_full 4 100 dec_rec AT_ERR_BAD_HEX
ret 137
end
note Tampered receipt signature rejected with BadSignature (18)
put rec 440 xor get rec 440 1
if ne at_rcp_verify rec true AT_ERR_BAD_SIG
ret 138
end
ret 0
end

fn t_test_cli_dispatch to int
if ne at_cli_dispatch 6 at_kw_pack t_arg_x false AT_CMD_PACK
ret 140
end
if ne at_cli_dispatch 5 at_kw_pack t_arg_x false AT_CMD_INVALID
ret 141
end
if ne at_cli_dispatch 3 at_kw_inspect t_arg_x false AT_CMD_INSPECT
ret 142
end
if ne at_cli_dispatch 3 at_kw_id t_arg_x false AT_CMD_ID
ret 143
end
if ne at_cli_dispatch 4 at_kw_sign t_arg_x false AT_CMD_SIGN
ret 144
end
if ne at_cli_dispatch 3 at_kw_verify t_arg_x false AT_CMD_VERIFY
ret 145
end
if ne at_cli_dispatch 3 at_kw_neg_corpus t_arg_x false AT_CMD_INVALID
ret 146
end
if ne at_cli_dispatch 3 at_kw_neg_corpus t_arg_x true AT_CMD_NEG_CORPUS
ret 147
end
if ne at_cli_dispatch 4 at_kw_receipt at_kw_inspect false AT_CMD_RCP_INSPECT
ret 148
end
if ne at_cli_dispatch 5 at_kw_receipt at_kw_check false AT_CMD_RCP_CHECK
ret 149
end
if ne at_cli_dispatch 5 at_kw_receipt at_kw_from_hex false AT_CMD_RCP_FROM_HEX
ret 150
end
if ne at_cli_dispatch 5 at_kw_receipt at_kw_sign_test false AT_CMD_RCP_SIGN_TEST
ret 151
end
if ne at_cli_dispatch 4 at_kw_receipt at_kw_verify false AT_CMD_RCP_VERIFY
ret 152
end
if ne at_cli_dispatch 3 at_kw_receipt at_kw_verify false AT_CMD_INVALID
ret 153
end
if ne at_cli_dispatch 3 t_bad_cmd t_arg_x true AT_CMD_INVALID
ret 154
end
ret 0
end

fn main to int
rc = t_test_pack_and_golden_id
if ne rc 0
ret rc
end
rc = t_test_sign_and_verify
if ne rc 0
ret rc
end
rc = t_test_corpus_all_29
if ne rc 0
ret rc
end
rc = t_test_receipt_check
if ne rc 0
ret rc
end
rc = t_test_receipt_sign_verify_hex
if ne rc 0
ret rc
end
rc = t_test_cli_dispatch
if ne rc 0
ret rc
end
ret 0
end

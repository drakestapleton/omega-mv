put dst 16 0x66
put dst 17 0xd3
put dst 18 0x85
put dst 19 0x35
put dst 20 0x07
put dst 21 0x6f
put dst 22 0x09
put dst 23 0x4b
put dst 24 0x85
put dst 25 0xce
put dst 26 0x3a
put dst 27 0x2e
put dst 28 0x0b
put dst 29 0x44
put dst 30 0x58
put dst 31 0xf7
end

note RFC 8032 TEST 2 seed (SEED-0B test-only receipt identity; distinct from artifact key)
fn at_fill_test_rcp_key dst edit uchar * to void
put dst 0 0x4c
put dst 1 0xcd
put dst 2 0x08
put dst 3 0x9b
put dst 4 0x28
put dst 5 0xff
put dst 6 0x96
put dst 7 0xda
put dst 8 0x9d
put dst 9 0xb6
put dst 10 0xc3
put dst 11 0x46

note 9 resource fields: code_p, data_p, stack_p, max_caps, ipc_m, ipc_b, cpu_t, elap_t, sys_c
global at_man_res ulong 9
global at_pack_len ulong 1

note Parsed artifact view globals (populated by at_parse / at_parse_and_identify)
note 0=total_len, 1=entry_off, 2=cap_cnt, 3=res_off, 4=pay_off, 5=pay_len, 6=sig_off,
note 7=code_len, 8=data_off, 9=data_len, 10=data_mem_len, 11=sig_alg
global at_art_meta ulong 12
global at_art_id uchar 32
global at_art_payload_sha uchar 32
global at_art_signer_fp uchar 32
global at_art_req_caps_sha uchar 32
global at_art_res_env_sha uchar 32

note Staged / decoded Admission Receipt v0 globals
note 0=flags, 1=decision, 2=tier, 3=seq, 4=time_ns, 5=exec_st, 6=exit_st, 7=res_flags,
note 8=rej_stage, 9=rej_reason, 10=syscalls, 11=reads_ok, 12=denials, 13=frames,
note 14=generation, 15=context_id
global at_rcp_f ulong 16
global at_rcp_nonce_buf uchar 16
note 9 digests x 32 bytes = 288 bytes:
note 0=artifact_id, 1=payload, 2=signer, 3=policy, 4=req_caps, 5=grant_caps,
note 6=res_env, 7=verifier_id, 8=machine_id
global at_rcp_digests uchar 288
global at_rcp_dig_out uchar 32
global at_rcp_signed_flag ulong 1

note Corpus build and expectation outputs
global at_corpus_len ulong 1
note 0=expect_kind, 1=expected_code, 2=expected_exec, 3=expected_caps
global at_corpus_exp ulong 4

note Little-endian integer helpers
fn at_put_u16_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
end

fn at_put_u32_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
end

fn at_put_u64_le buf edit uchar * off ulong v ulong to void
for i ulong 8
put buf add off i uchar and shr v mul i 8 0xff
end
end

fn at_get_u16_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
ret or b0 shl b1 8
end

fn at_get_u32_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
b2 = ulong get buf add off 2
b3 = ulong get buf add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn at_get_u64_le buf view uchar * off ulong to ulong
acc = ulong 0
for i ulong 8
b = ulong get buf add off i
acc = or acc shl b mul i 8
end
ret acc
end

fn at_align_up_16 v ulong to ulong
ret and add v 15 not ulong 15
end

fn at_bytes_zero buf view uchar * off ulong cnt ulong to bool
for i ulong cnt bound 4096
if ne get buf add off i 0
ret false
end
end
ret true
end

fn at_bytes_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 4096
if ne get a i get b i
ret false
end
end
ret true
end

note Lowercase hex encoding (2 chars per byte)
fn at_hex_encode src view uchar * dst edit uchar * to int
n = len src
if lt len dst mul n 2
ret AT_ERR_BUF_SMALL
end
for i ulong n bound 1024
b = ulong get src i
hi = shr b 4
lo = and b 0x0f
put dst mul i 2 get at_hex_chars hi
put dst add mul i 2 1 get at_hex_chars lo
end
ret AT_OK
end

fn at_hex_nibble ch uchar to int
v = ulong ch
if ge v 48
if le v 57
ret int sub v 48
end
end
if ge v 97
if le v 102
ret int add sub v 97 10
end
end
ret -1
end

fn at_is_ws ch uchar to bool
if eq ch 32
ret true
end
if eq ch 9
ret true
end
if eq ch 10
ret true
end
if eq ch 13
ret true
end
ret false
end

fn at_rcp_decode_hex_body hex_in view uchar * start ulong dst edit uchar * to int
for i ulong AT_RCP_SIZE
pos = add start mul i 2
hi = at_hex_nibble get hex_in pos
lo = at_hex_nibble get hex_in add pos 1
if lt hi 0
ret AT_ERR_BAD_HEX
end
if lt lo 0
ret AT_ERR_BAD_HEX
end
b = or shl ulong hi 4 ulong lo
put dst i uchar b
end
ret AT_OK
end

note Strict lowercase hex decoder (matches receipt_cmd.rs::from_hex)
fn at_rcp_from_hex hex_in view uchar * dst edit uchar * to int
if lt len dst AT_RCP_SIZE
ret AT_ERR_BUF_SMALL
end
n = len hex_in
start = ulong 0
while lt start n bound 4096
if not at_is_ws get hex_in start
break
end
start = add start 1
end
endp = n
while gt endp start bound 4096
if not at_is_ws get hex_in sub endp 1
break
end
endp = sub endp 1
end
if ne sub endp start mul AT_RCP_SIZE 2
ret AT_ERR_BAD_HEX
end
ret at_rcp_decode_hex_body hex_in start dst
end

note Domain-separated SHA-256 helper: SHA256(dom || 0x00 || payload)
fn at_sha256_dom_nul dom view uchar * msg view uchar * dst edit uchar * to void
ctx = new ulong 40 0
z = new uchar 1 0
sha256_init ctx
sha256_update ctx dom
sha256_update ctx z
sha256_update ctx msg
sha256_final ctx dst
end


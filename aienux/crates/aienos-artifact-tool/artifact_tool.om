note Signer fingerprint: SHA256(key[32])
fn at_signer_fp key view uchar * fp_dst edit uchar * to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx key
sha256_final ctx fp_dst
end

note Deterministic 64-byte keyed SHA-256 signature over (dom || 0x00 || dig[32])
fn at_compute_sig key view uchar 32 dom view uchar * dig view uchar 32 sig_dst edit uchar 64 to void
ctx = new ulong 40 0
z = new uchar 1 0
tag = new uchar 1 1
half = new uchar 32 0
sha256_init ctx
sha256_update ctx key
sha256_update ctx dom
sha256_update ctx z
sha256_update ctx dig
sha256_update ctx tag
sha256_final ctx half
for i ulong 32
put sig_dst i get half i
end
put tag 0 2
sha256_init ctx
sha256_update ctx key
sha256_update ctx dom
sha256_update ctx z
sha256_update ctx dig
sha256_update ctx tag
sha256_final ctx half
for i ulong 32
put sig_dst add 32 i get half i
end
end

note Manifest staging helpers
fn at_manifest_reset to void
put at_man_entry 0 0
put at_man_cap_cnt 0 0
for i ulong 9
put at_man_res i 0
end
end

fn at_manifest_set_entry entry ulong to void
put at_man_entry 0 entry
end

fn at_manifest_set_res_pages code_p ulong data_p ulong stack_p ulong max_caps ulong to void
put at_man_res 0 code_p
put at_man_res 1 data_p
put at_man_res 2 stack_p
put at_man_res 3 max_caps
end

fn at_manifest_set_res_limits ipc_m ulong ipc_b ulong cpu_t ulong elap_t ulong sys_c ulong to void
put at_man_res 4 ipc_m
put at_man_res 5 ipc_b
put at_man_res 6 cpu_t
put at_man_res 7 elap_t
put at_man_res 8 sys_c
end

fn at_manifest_push_cap kind ulong rid ulong rights ulong bkind ulong max_ops ulong to int
cnt = get at_man_cap_cnt 0
if ge cnt AT_MAX_CAPS
ret -1
end
base = mul cnt 8
put at_man_caps base kind
put at_man_caps add base 1 rid
put at_man_caps add base 2 rights
put at_man_caps add base 3 bkind
put at_man_caps add base 4 max_ops
put at_man_caps add base 5 0
put at_man_caps add base 6 0
put at_man_caps add base 7 0
put at_man_cap_cnt 0 add cnt 1
ret int cnt
end

fn at_manifest_set_cap_bounds idx ulong max_b ulong boff ulong blen ulong to void
base = mul idx 8
put at_man_caps add base 5 max_b
put at_man_caps add base 6 boff
put at_man_caps add base 7 blen
end

note Section and resource envelope encoders
fn at_encode_section dst edit uchar * off ulong kind ulong perms ulong pay_rel ulong to void
at_put_u16_le dst off kind
at_put_u16_le dst add off 2 perms
at_put_u32_le dst add off 8 pay_rel
at_put_u32_le dst add off 20 AT_PAGE_SIZE
end

fn at_encode_resources dst edit uchar * off ulong to void
at_put_u32_le dst off get at_man_res 0
at_put_u32_le dst add off 4 get at_man_res 1
at_put_u32_le dst add off 8 get at_man_res 2
at_put_u16_le dst add off 12 get at_man_res 3
at_put_u32_le dst add off 16 get at_man_res 4
at_put_u32_le dst add off 20 get at_man_res 5
at_put_u64_le dst add off 24 get at_man_res 6
at_put_u64_le dst add off 32 get at_man_res 7
at_put_u32_le dst add off 40 get at_man_res 8
end

fn at_encode_staged_caps dst edit uchar * cnt ulong to void
for i ulong cnt bound 16
base = mul i 8
off = add AT_CAP_TABLE_OFF mul i AT_CAP_REC_SIZE
at_put_u16_le dst off get at_man_caps base
at_put_u32_le dst add off 4 get at_man_caps add base 1
at_put_u32_le dst add off 8 get at_man_caps add base 2
at_put_u32_le dst add off 12 get at_man_caps add base 3
at_put_u32_le dst add off 16 get at_man_caps add base 4
at_put_u64_le dst add off 24 get at_man_caps add base 5
at_put_u64_le dst add off 32 get at_man_caps add base 6
at_put_u64_le dst add off 40 get at_man_caps add base 7
end
end

note Binary Artifact v0 strict parser (format.rs, capability.rs, resource.rs)
fn at_parse_magic bytes view uchar * to bool
for i ulong 7
if ne get bytes i get at_art_magic i
ret false
end
end
if ne get bytes 7 0
ret false
end
ret true
end

fn at_parse_header bytes view uchar * to int
n = len bytes
if lt n AT_HEADER_SIZE
ret AT_ERR_TRUNCATED
end
if gt n AT_MAX_ARTIFACT_SIZE
ret AT_ERR_RES_LIMIT
end
if not at_parse_magic bytes
ret AT_ERR_BAD_MAGIC
end
if ne at_get_u16_le bytes 8 0
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 10 AT_HEADER_SIZE
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 12 AT_TARGET_AARCH64_LE
ret AT_ERR_WRONG_TARGET
end
if ne at_get_u16_le bytes 14 AT_ABI_V1
ret AT_ERR_WRONG_ABI
end
if ne at_get_u32_le bytes 16 0
ret AT_ERR_UNSUP_FLAGS
end
total_len = at_get_u32_le bytes 20
if ne total_len n
ret AT_ERR_WRONG_LEN
end
put at_art_meta 0 total_len
ret AT_OK
end

fn at_parse_header_tables bytes view uchar * to int
if ne at_get_u32_le bytes 24 AT_SEC_TABLE_OFF
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 28 AT_SEC_COUNT
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 30 AT_SEC_REC_SIZE
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 32 0
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 34 0
ret AT_ERR_UNSUP_VER
end
if ne at_get_u32_le bytes 40 AT_CAP_TABLE_OFF
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 46 AT_CAP_REC_SIZE
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 52 AT_RES_ENV_SIZE
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le bytes 54 0
ret AT_ERR_UNSUP_VER
end
if not at_bytes_zero bytes 72 56
ret AT_ERR_RESERVED_NZ
end
put at_art_meta 1 at_get_u32_le bytes 36
ret AT_OK
end

fn at_parse_offsets_sig bytes view uchar * to int
total_len = get at_art_meta 0
pay_off = get at_art_meta 4
pay_len = at_get_u32_le bytes 60
if gt pay_len AT_MAX_PAYLOAD_SIZE
ret AT_ERR_RES_LIMIT
end
sig_off = at_get_u32_le bytes 64
sig_len = at_get_u16_le bytes 68
sig_alg = at_get_u16_le bytes 70
if ne sig_len AT_SIG_BLOCK_SIZE
ret AT_ERR_BAD_SIG_FMT
end
if ne sig_alg AT_SIG_ALG_ED25519
ret AT_ERR_BAD_SIG_FMT
end
if ne sig_off add pay_off pay_len
ret AT_ERR_SEC_OVERLAP
end
if ne add sig_off AT_SIG_BLOCK_SIZE total_len
ret AT_ERR_WRONG_LEN
end
put at_art_meta 5 pay_len
put at_art_meta 6 sig_off
put at_art_meta 11 sig_alg
ret AT_OK
end

fn at_parse_offsets bytes view uchar * to int
total_len = get at_art_meta 0
cap_cnt = at_get_u16_le bytes 44
if gt cap_cnt AT_MAX_CAPS
ret AT_ERR_RES_LIMIT
end
cap_end = add AT_CAP_TABLE_OFF mul cap_cnt AT_CAP_REC_SIZE
res_off = at_get_u32_le bytes 48
if ne res_off cap_end
ret AT_ERR_SEC_OVERLAP
end
res_end = add res_off AT_RES_ENV_SIZE
exp_pay = at_align_up_16 res_end
pay_off = at_get_u32_le bytes 56
if ne pay_off exp_pay
ret AT_ERR_SEC_OVERLAP
end
if gt pay_off total_len
ret AT_ERR_TRUNCATED
end
if not at_bytes_zero bytes res_end sub pay_off res_end
ret AT_ERR_RESERVED_NZ
end
put at_art_meta 2 cap_cnt
put at_art_meta 3 res_off
put at_art_meta 4 pay_off
ret at_parse_offsets_sig bytes
end

fn at_parse_sections bytes view uchar * to int
pay_len = get at_art_meta 5
if ne at_get_u32_le bytes 132 0
ret AT_ERR_RESERVED_NZ
end
if not at_bytes_zero bytes 152 8
ret AT_ERR_RESERVED_NZ
end
if ne at_get_u32_le bytes 164 0
ret AT_ERR_RESERVED_NZ
end
if not at_bytes_zero bytes 184 8
ret AT_ERR_RESERVED_NZ
end
c_flen = at_get_u32_le bytes 140
c_mlen = at_get_u32_le bytes 144
if ne at_get_u16_le bytes 128 AT_SEC_KIND_CODE
ret AT_ERR_BAD_SECTION
end
if ne at_get_u16_le bytes 130 AT_PERM_RX
ret AT_ERR_BAD_SECTION
end
if ne at_get_u32_le bytes 136 0
ret AT_ERR_BAD_SECTION
end
if eq c_flen 0
ret AT_ERR_BAD_SECTION
end
if ne c_mlen c_flen
ret AT_ERR_BAD_SECTION
end
if ne at_get_u32_le bytes 148 AT_PAGE_SIZE
ret AT_ERR_BAD_SECTION
end
d_rel = at_get_u32_le bytes 168
d_flen = at_get_u32_le bytes 172
d_mlen = at_get_u32_le bytes 176
if ne at_get_u16_le bytes 160 AT_SEC_KIND_DATA
ret AT_ERR_BAD_SECTION
end
if ne at_get_u16_le bytes 162 AT_PERM_RW
ret AT_ERR_BAD_SECTION
end
if ne d_rel c_flen
ret AT_ERR_BAD_SECTION
end
if eq d_flen 0
ret AT_ERR_BAD_SECTION
end
if lt d_mlen d_flen
ret AT_ERR_BAD_SECTION
end
if ne at_get_u32_le bytes 180 AT_PAGE_SIZE
ret AT_ERR_BAD_SECTION
end
if ne add c_flen d_flen pay_len
ret AT_ERR_SEC_OVERLAP
end
put at_art_meta 7 c_flen
put at_art_meta 8 d_rel
put at_art_meta 9 d_flen
put at_art_meta 10 d_mlen
ret AT_OK
end

fn at_validate_cap_bounds bytes view uchar * off ulong kind ulong bkind ulong to int
max_b = at_get_u64_le bytes add off 24
boff = at_get_u64_le bytes add off 32
blen = at_get_u64_le bytes add off 40
if eq max_b 0
ret AT_ERR_BAD_CAP
end
if eq kind AT_RES_KIND_OBJECT
if ne bkind 1
ret AT_ERR_BAD_CAP
end
if gt blen sub AT_U64_MAX boff
ret AT_ERR_LEN_OVERFLOW
end
if eq blen 0
ret AT_ERR_BAD_CAP
end
if gt max_b blen
ret AT_ERR_BAD_CAP
end
ret AT_OK
end
if ne bkind 2
ret AT_ERR_BAD_CAP
end
if ne boff 0
ret AT_ERR_BAD_CAP
end
if ne blen 0
ret AT_ERR_BAD_CAP
end
ret AT_OK
end

fn at_validate_one_cap bytes view uchar * off ulong to int
if ne at_get_u16_le bytes add off 2 0
ret AT_ERR_RESERVED_NZ
end
if ne at_get_u32_le bytes add off 20 0
ret AT_ERR_RESERVED_NZ
end
kind = at_get_u16_le bytes off
rid = at_get_u32_le bytes add off 4
rights = at_get_u32_le bytes add off 8
bkind = at_get_u32_le bytes add off 12
max_ops = at_get_u32_le bytes add off 16
if ne kind AT_RES_KIND_OBJECT
if ne kind AT_RES_KIND_CHANNEL
ret AT_ERR_BAD_CAP
end
end
if eq rid 0
ret AT_ERR_BAD_CAP
end
if eq rights 0
ret AT_ERR_BAD_CAP
end
if ne and rights not AT_VALID_RIGHTS 0
ret AT_ERR_BAD_CAP
end
if eq max_ops 0
ret AT_ERR_BAD_CAP
end
ret at_validate_cap_bounds bytes off kind bkind
end

fn at_parse_caps bytes view uchar * to int
cap_cnt = get at_art_meta 2
has_prev = false
prev_k = ulong 0
prev_id = ulong 0
for i ulong cap_cnt bound 16
off = add AT_CAP_TABLE_OFF mul i AT_CAP_REC_SIZE
rc = at_validate_one_cap bytes off
if ne rc AT_OK
ret rc
end
k = at_get_u16_le bytes off
rid = at_get_u32_le bytes add off 4
if has_prev
if gt prev_k k
ret AT_ERR_BAD_CAP
end
if eq prev_k k
if ge prev_id rid
ret AT_ERR_BAD_CAP
end
end
end
has_prev = true
prev_k = k
prev_id = rid
end
ret AT_OK
end

fn at_parse_res_limits bytes view uchar * res_off ulong to int
if gt at_get_u32_le bytes add res_off 16 AT_MAX_IPC_MSGS
ret AT_ERR_RES_LIMIT
end
if gt at_get_u32_le bytes add res_off 20 AT_MAX_IPC_BYTES
ret AT_ERR_RES_LIMIT
end
cpu_t = at_get_u64_le bytes add res_off 24
elap_t = at_get_u64_le bytes add res_off 32
sys_c = at_get_u32_le bytes add res_off 40
if eq cpu_t 0
ret AT_ERR_RES_LIMIT
end
if gt cpu_t AT_MAX_TICKS
ret AT_ERR_RES_LIMIT
end
if eq elap_t 0
ret AT_ERR_RES_LIMIT
end
if gt elap_t AT_MAX_TICKS
ret AT_ERR_RES_LIMIT
end
if eq sys_c 0
ret AT_ERR_RES_LIMIT
end
if gt sys_c AT_MAX_SYSCALLS
ret AT_ERR_RES_LIMIT
end
ret AT_OK
end

fn at_parse_resources bytes view uchar * to int
res_off = get at_art_meta 3
cap_cnt = get at_art_meta 2
if ne at_get_u16_le bytes add res_off 14 0
ret AT_ERR_RESERVED_NZ
end
if ne at_get_u32_le bytes add res_off 44 0
ret AT_ERR_RESERVED_NZ
end
code_p = at_get_u32_le bytes res_off
data_p = at_get_u32_le bytes add res_off 4
stack_p = at_get_u32_le bytes add res_off 8
max_c = at_get_u16_le bytes add res_off 12
if eq code_p 0
ret AT_ERR_RES_LIMIT
end
if gt code_p AT_MAX_CODE_PAGES
ret AT_ERR_RES_LIMIT
end
if eq data_p 0
ret AT_ERR_RES_LIMIT
end
if gt data_p AT_MAX_DATA_PAGES
ret AT_ERR_RES_LIMIT
end
if eq stack_p 0
ret AT_ERR_RES_LIMIT
end
if gt stack_p AT_MAX_STACK_PAGES
ret AT_ERR_RES_LIMIT
end
if lt max_c cap_cnt
ret AT_ERR_RES_LIMIT
end
if gt max_c AT_MAX_CAPS
ret AT_ERR_RES_LIMIT
end
if gt get at_art_meta 7 mul code_p AT_PAGE_SIZE
ret AT_ERR_RES_LIMIT
end
if gt get at_art_meta 10 mul data_p AT_PAGE_SIZE
ret AT_ERR_RES_LIMIT
end
ret at_parse_res_limits bytes res_off
end

fn at_parse_entry_and_sig bytes view uchar * to int
entry_off = get at_art_meta 1
code_len = get at_art_meta 7
if ne and entry_off 3 0
ret AT_ERR_BAD_ENTRY
end
if gt add entry_off 4 code_len
ret AT_ERR_BAD_ENTRY
end
sig_off = get at_art_meta 6
if ne at_get_u16_le bytes sig_off get at_art_meta 11
ret AT_ERR_BAD_SIG_FMT
end
if ne get bytes add sig_off 2 0
ret AT_ERR_RESERVED_NZ
end
if ne get bytes add sig_off 3 0
ret AT_ERR_RESERVED_NZ
end
ret AT_OK
end

fn at_parse bytes view uchar * to int
rc = at_parse_header bytes
if ne rc AT_OK
ret rc
end
rc = at_parse_header_tables bytes
if ne rc AT_OK
ret rc
end
rc = at_parse_offsets bytes
if ne rc AT_OK
ret rc
end
rc = at_parse_sections bytes
if ne rc AT_OK
ret rc
end
rc = at_parse_caps bytes
if ne rc AT_OK
ret rc
end
rc = at_parse_resources bytes
if ne rc AT_OK
ret rc
end
ret at_parse_entry_and_sig bytes
end

note Parse artifact and compute all canonical identity digests
fn at_parse_and_identify bytes view uchar * to int
rc = at_parse bytes
if ne rc AT_OK
ret rc
end
sig_off = get at_art_meta 6
pay_off = get at_art_meta 4
pay_len = get at_art_meta 5
cap_len = mul get at_art_meta 2 AT_CAP_REC_SIZE
res_off = get at_art_meta 3
dig = new uchar 32 0
at_sha256_dom_nul at_dom_art_id part bytes 0 sig_off dig
for i ulong 32
put at_art_id i get dig i
end
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx part bytes pay_off pay_len
sha256_final ctx dig
for i ulong 32
put at_art_payload_sha i get dig i
end
at_sha256_dom_nul at_dom_req_caps part bytes AT_CAP_TABLE_OFF cap_len dig
for i ulong 32
put at_art_req_caps_sha i get dig i
end
at_sha256_dom_nul at_dom_res_env part bytes res_off AT_RES_ENV_SIZE dig
for i ulong 32
put at_art_res_env_sha i get dig i
end
for i ulong 32
put at_art_signer_fp i get bytes add add sig_off 4 i
end
ret AT_OK
end

note Pack staged manifest + code + data into canonical Binary Artifact v0
fn at_pack_compute_layout clen ulong dlen ulong dst_len ulong to int
cap_cnt = get at_man_cap_cnt 0
if eq clen 0
ret AT_ERR_PACK_BOUNDS
end
if eq dlen 0
ret AT_ERR_PACK_BOUNDS
end
if gt cap_cnt AT_MAX_CAPS
ret AT_ERR_PACK_BOUNDS
end
res_off = add AT_CAP_TABLE_OFF mul cap_cnt AT_CAP_REC_SIZE
pay_off = at_align_up_16 add res_off AT_RES_ENV_SIZE
pay_len = add clen dlen
sig_off = add pay_off pay_len
total_len = add sig_off AT_SIG_BLOCK_SIZE
if gt total_len AT_MAX_ARTIFACT_SIZE
ret AT_ERR_RES_LIMIT
end
if gt pay_len AT_MAX_PAYLOAD_SIZE
ret AT_ERR_RES_LIMIT
end
if gt total_len dst_len
ret AT_ERR_BUF_SMALL
end
put at_art_meta 0 total_len
put at_art_meta 2 cap_cnt
put at_art_meta 3 res_off
put at_art_meta 4 pay_off
put at_art_meta 5 pay_len
put at_art_meta 6 sig_off
ret AT_OK
end

fn at_pack_write_tables dst edit uchar * clen ulong dlen ulong to void
total_len = get at_art_meta 0
cap_cnt = get at_art_meta 2
res_off = get at_art_meta 3
for i ulong total_len bound 4096
put dst i 0
end
for i ulong 7
put dst i get at_art_magic i
end
at_put_u16_le dst 10 AT_HEADER_SIZE
at_put_u16_le dst 12 AT_TARGET_AARCH64_LE
at_put_u16_le dst 14 AT_ABI_V1
at_put_u32_le dst 20 total_len
at_put_u32_le dst 24 AT_SEC_TABLE_OFF
at_put_u16_le dst 28 AT_SEC_COUNT
at_put_u16_le dst 30 AT_SEC_REC_SIZE
at_put_u32_le dst 36 get at_man_entry 0
at_put_u32_le dst 40 AT_CAP_TABLE_OFF
at_put_u16_le dst 44 cap_cnt
at_put_u16_le dst 46 AT_CAP_REC_SIZE
at_put_u32_le dst 48 res_off
at_put_u16_le dst 52 AT_RES_ENV_SIZE
at_put_u32_le dst 56 get at_art_meta 4
at_put_u32_le dst 60 get at_art_meta 5
at_put_u32_le dst 64 get at_art_meta 6
at_put_u16_le dst 68 AT_SIG_BLOCK_SIZE
at_put_u16_le dst 70 AT_SIG_ALG_ED25519
at_encode_section dst 128 AT_SEC_KIND_CODE AT_PERM_RX 0
at_put_u32_le dst 140 clen
at_put_u32_le dst 144 clen
at_encode_section dst 160 AT_SEC_KIND_DATA AT_PERM_RW clen
at_put_u32_le dst 172 dlen
at_put_u32_le dst 176 mul get at_man_res 1 AT_PAGE_SIZE
at_encode_staged_caps dst cap_cnt
at_encode_resources dst res_off
end

fn at_pack code view uchar * data view uchar * dst edit uchar * to int
clen = len code
dlen = len data
rc = at_pack_compute_layout clen dlen len dst
if ne rc AT_OK
ret rc
end
at_pack_write_tables dst clen dlen
pay_off = get at_art_meta 4
for i ulong clen bound 2048
put dst add pay_off i get code i
end
data_off = add pay_off clen
for i ulong dlen bound 2048
put dst add data_off i get data i
end
at_put_u16_le dst get at_art_meta 6 AT_SIG_ALG_ED25519
total_len = get at_art_meta 0
rc = at_parse part dst 0 total_len
if ne rc AT_OK
ret rc
end
put at_pack_len 0 total_len
ret AT_OK
end

note Sign artifact in place with explicit 32-byte key
fn at_sign_with_key buf edit uchar * key view uchar 32 to int
rc = at_parse_and_identify buf
if ne rc AT_OK
ret rc
end
sig_off = get at_art_meta 6
fp = new uchar 32 0
id_cp = new uchar 32 0
sig = new uchar 64 0
for i ulong 32
put id_cp i get at_art_id i
end
at_signer_fp key fp
at_compute_sig key at_dom_art_sig id_cp sig
for i ulong 32
put buf add add sig_off 4 i get fp i
end
for i ulong 64
put buf add add sig_off 36 i get sig i
end
ret at_parse buf
end

note Tool `sign` command: requires test_mode (SEED-0B test signing); production fails closed
fn at_sign_artifact buf edit uchar * test_mode bool to int
if not test_mode
ret AT_ERR_PROD_SIGN_OFF
end
key = new uchar 32 0
at_fill_test_art_key key
ret at_sign_with_key buf key
end

note Tool `verify` command: parses, checks trust anchor (empty in production), verifies signature
fn at_verify_artifact bytes view uchar * test_mode bool to int
rc = at_parse_and_identify bytes
if ne rc AT_OK
ret rc
end
if not test_mode
ret AT_ERR_UNTRUSTED
end
key = new uchar 32 0
at_fill_test_art_key key
exp_fp = new uchar 32 0
at_signer_fp key exp_fp
for i ulong 32
if ne get at_art_signer_fp i get exp_fp i
ret AT_ERR_UNTRUSTED
end
end
id_cp = new uchar 32 0
for i ulong 32
put id_cp i get at_art_id i
end
exp_sig = new uchar 64 0
at_compute_sig key at_dom_art_sig id_cp exp_sig
sig_off = get at_art_meta 6
for i ulong 64
if ne get bytes add add sig_off 36 i get exp_sig i
ret AT_ERR_BAD_SIG
end
end
ret AT_OK
end

note Tool `inspect` and `id` commands
fn at_inspect_artifact bytes view uchar * to int
ret at_parse_and_identify bytes
end

fn at_id_hex bytes view uchar * hex_dst edit uchar * to int
rc = at_parse_and_identify bytes
if ne rc AT_OK
ret rc
end
id_cp = new uchar 32 0
for i ulong 32
put id_cp i get at_art_id i
end
ret at_hex_encode id_cp hex_dst
end

note Admission Receipt v0 helpers (receipt.rs and receipt_cmd.rs)
fn at_rcp_digest rec view uchar * dst edit uchar * to void
at_sha256_dom_nul at_dom_rcp_dig part rec 0 AT_RCP_SIG_OFF dst
end

fn at_rcp_nonce ver_id view uchar * seq ulong dst edit uchar * to void
ctx = new ulong 40 0
z = new uchar 1 0
seq_b = new uchar 8 0
dig = new uchar 32 0
at_put_u64_le seq_b 0 seq
sha256_init ctx
sha256_update ctx at_dom_rcp_nonce
sha256_update ctx z
sha256_update ctx ver_id
sha256_update ctx seq_b
sha256_final ctx dig
for i ulong 16
put dst i get dig i
end
end

fn at_rcp_is_unsigned rec view uchar * to bool
ret at_bytes_zero rec AT_RCP_SIG_OFF sub AT_RCP_SIZE AT_RCP_SIG_OFF
end

fn at_rcp_reset to void
for i ulong 16
put at_rcp_f i 0
end
for i ulong 16
put at_rcp_nonce_buf i 0
end
for i ulong 288
put at_rcp_digests i 0
end
end

fn at_rcp_set_digest slot ulong val view uchar * to void
base = mul slot 32
for i ulong 32
put at_rcp_digests add base i get val i
end
end

fn at_rcp_digest_is_zero slot ulong to bool
base = mul slot 32
for i ulong 32
if ne get at_rcp_digests add base i 0
ret false
end
end
ret true
end

fn at_rcp_encode dst edit uchar * to int
if lt len dst AT_RCP_SIZE
ret AT_ERR_BUF_SMALL
end
for i ulong AT_RCP_SIZE
put dst i 0
end
for i ulong 7
put dst i get at_rcp_magic i
end
at_put_u16_le dst 8 AT_RCP_VERSION
at_put_u16_le dst 10 AT_RCP_HDR_SIZE
at_put_u32_le dst 12 AT_RCP_SIZE
at_put_u32_le dst 16 get at_rcp_f 0
at_put_u16_le dst 20 get at_rcp_f 1
at_put_u16_le dst 22 get at_rcp_f 2
at_put_u64_le dst 24 get at_rcp_f 3
for i ulong 16
put dst add 32 i get at_rcp_nonce_buf i
end
at_put_u64_le dst 48 get at_rcp_f 4
at_put_u32_le dst 64 get at_rcp_f 5
at_put_u32_le dst 68 get at_rcp_f 6
at_put_u32_le dst 72 get at_rcp_f 7
at_put_u16_le dst 76 get at_rcp_f 8
at_put_u16_le dst 78 get at_rcp_f 9
at_put_u32_le dst 80 get at_rcp_f 10
at_put_u32_le dst 84 get at_rcp_f 11
at_put_u32_le dst 88 get at_rcp_f 12
at_put_u32_le dst 92 get at_rcp_f 13
for i ulong 288
put dst add 96 i get at_rcp_digests i
end
at_put_u64_le dst 384 get at_rcp_f 14
at_put_u64_le dst 392 get at_rcp_f 15
ret AT_OK
end

fn at_rcp_valid_reason code ulong to bool
if ge code 1
if le code 19
ret true
end
end
if ge code AT_LOADER_REASON_FIRST
if le code AT_LOADER_REASON_LAST
ret true
end
end
ret false
end

fn at_rcp_validate_nonce to int
ver_id = new uchar 32 0
for i ulong 32
put ver_id i get at_rcp_digests add 224 i
end
exp_nonce = new uchar 16 0
at_rcp_nonce ver_id get at_rcp_f 3 exp_nonce
for i ulong 16
if ne get at_rcp_nonce_buf i get exp_nonce i
ret AT_ERR_BAD_RECEIPT
end
end
ret AT_OK
end

fn at_rcp_validate_semantics to int
fl = get at_rcp_f 0
dec = get at_rcp_f 1
st = get at_rcp_f 5
ex = get at_rcp_f 6
rfl = get at_rcp_f 7
rstg = get at_rcp_f 8
rrsn = get at_rcp_f 9
if eq and fl AT_RCP_FLAG_MACHINE_ID 0
if not at_rcp_digest_is_zero 8
ret AT_ERR_BAD_RECEIPT
end
end
if eq and fl AT_RCP_FLAG_CONTEXT_ID 0
if ne get at_rcp_f 14 0
ret AT_ERR_BAD_RECEIPT
end
if ne get at_rcp_f 15 0
ret AT_ERR_BAD_RECEIPT
end
end
if eq and fl AT_RCP_FLAG_TIMESTAMP 0
if ne get at_rcp_f 4 0
ret AT_ERR_BAD_RECEIPT
end
end
if gt rstg AT_MAX_REJ_STAGE
ret AT_ERR_BAD_RECEIPT
end
if ne rrsn 0
if not at_rcp_valid_reason rrsn
ret AT_ERR_BAD_RECEIPT
end
end
if eq dec AT_DEC_REJECTED
if eq rstg 0
ret AT_ERR_BAD_RECEIPT
end
if eq rrsn 0
ret AT_ERR_BAD_RECEIPT
end
if ne st AT_EXEC_NOT_RUN
ret AT_ERR_BAD_RECEIPT
end
if ne ex 0
ret AT_ERR_BAD_RECEIPT
end
if ne get at_rcp_f 10 0
ret AT_ERR_BAD_RECEIPT
end
if ne get at_rcp_f 11 0
ret AT_ERR_BAD_RECEIPT
end
if ne get at_rcp_f 12 0
ret AT_ERR_BAD_RECEIPT
end
if ne and rfl not AT_RCP_RES_RECLAIMED 0
ret AT_ERR_BAD_RECEIPT
end
else
if ne rstg 0
ret AT_ERR_BAD_RECEIPT
end
if ne rrsn 0
ret AT_ERR_BAD_RECEIPT
end
end
dec_can = eq dec AT_DEC_CANARY_FAILED
st_can = eq st AT_EXEC_CANARY_FAILED
if ne dec_can st_can
ret AT_ERR_BAD_RECEIPT
end
if ne and rfl AT_RCP_RES_CANARY_OK 0
if ne st AT_EXEC_EXITED
ret AT_ERR_BAD_RECEIPT
end
if ne ex 0
ret AT_ERR_BAD_RECEIPT
end
end
ret at_rcp_validate_nonce
end

fn at_rcp_decode rec view uchar * to int
n = len rec
if lt n AT_RCP_SIZE
ret AT_ERR_TRUNCATED
end
if gt n AT_RCP_SIZE
ret AT_ERR_WRONG_LEN
end
for i ulong 7
if ne get rec i get at_rcp_magic i
ret AT_ERR_BAD_MAGIC
end
end
if ne get rec 7 0
ret AT_ERR_BAD_MAGIC
end
if ne at_get_u16_le rec 8 AT_RCP_VERSION
ret AT_ERR_UNSUP_VER
end
if ne at_get_u16_le rec 10 AT_RCP_HDR_SIZE
ret AT_ERR_UNSUP_VER
end
if ne at_get_u32_le rec 12 AT_RCP_SIZE
ret AT_ERR_UNSUP_VER
end
fl = at_get_u32_le rec 16
rfl = at_get_u32_le rec 72
if ne and fl not AT_RCP_VALID_FLAGS 0
ret AT_ERR_UNSUP_FLAGS
end
if ne and rfl not AT_RCP_VALID_RES_FLAGS 0
ret AT_ERR_UNSUP_FLAGS
end
if not at_bytes_zero rec 56 8
ret AT_ERR_RESERVED_NZ
end
if not at_bytes_zero rec 500 12
ret AT_ERR_RESERVED_NZ
end
if not at_bytes_zero rec 400 100
if ne at_get_u16_le rec 400 AT_SIG_ALG_ED25519
ret AT_ERR_BAD_SIG_FMT
end
if not at_bytes_zero rec 402 2
ret AT_ERR_RESERVED_NZ
end
end
dec = at_get_u16_le rec 20
tier = at_get_u16_le rec 22
est = at_get_u32_le rec 64
if lt dec 1
ret AT_ERR_BAD_RECEIPT
end
if gt dec 4
ret AT_ERR_BAD_RECEIPT
end
if lt tier 1
ret AT_ERR_BAD_RECEIPT
end
if gt tier 3
ret AT_ERR_BAD_RECEIPT
end
if gt est 6
ret AT_ERR_BAD_RECEIPT
end
put at_rcp_f 0 fl
put at_rcp_f 1 dec
put at_rcp_f 2 tier
put at_rcp_f 3 at_get_u64_le rec 24
put at_rcp_f 4 at_get_u64_le rec 48
put at_rcp_f 5 est
put at_rcp_f 6 at_get_u32_le rec 68
put at_rcp_f 7 rfl
put at_rcp_f 8 at_get_u16_le rec 76
put at_rcp_f 9 at_get_u16_le rec 78
put at_rcp_f 10 at_get_u32_le rec 80
put at_rcp_f 11 at_get_u32_le rec 84
put at_rcp_f 12 at_get_u32_le rec 88
put at_rcp_f 13 at_get_u32_le rec 92
put at_rcp_f 14 at_get_u64_le rec 384
put at_rcp_f 15 at_get_u64_le rec 392
for i ulong 16
put at_rcp_nonce_buf i get rec add 32 i
end
for i ulong 288
put at_rcp_digests i get rec add 96 i
end
ret at_rcp_validate_semantics
end

fn at_rcp_inspect rec view uchar * to int
rc = at_rcp_decode rec
if ne rc AT_OK
ret rc
end
dig = new uchar 32 0
at_rcp_digest rec dig
for i ulong 32
put at_rcp_dig_out i get dig i
end
if at_rcp_is_unsigned rec
put at_rcp_signed_flag 0 0
else
put at_rcp_signed_flag 0 1
end
ret AT_OK
end

fn at_rcp_bind_match slot ulong want view uchar * zero_ok bool to bool
base = mul slot 32
same = true
for i ulong 32
if ne get at_rcp_digests add base i get want i
same = false
end
end
if same
ret true
end
if zero_ok
if at_rcp_digest_is_zero slot
ret true
end
end
ret false
end

fn at_rcp_check_one_binding slot ulong zero_ok bool to bool
want = new uchar 32 0
if eq slot 0
for i ulong 32
put want i get at_art_id i
end
end
if eq slot 1
for i ulong 32
put want i get at_art_payload_sha i
end
end
if eq slot 2
for i ulong 32
put want i get at_art_signer_fp i
end
end
if eq slot 4
for i ulong 32
put want i get at_art_req_caps_sha i
end
end
if eq slot 6
for i ulong 32
put want i get at_art_res_env_sha i
end
end
ret at_rcp_bind_match slot want zero_ok
end

note Tool `receipt check` command (receipt_cmd.rs::check)
fn at_rcp_check rec view uchar * art view uchar * to int
if not at_rcp_is_unsigned rec
ret AT_ERR_RCP_MUST_UNSIGNED
end
rc = at_rcp_decode rec
if ne rc AT_OK
ret rc
end
admitted = eq get at_rcp_f 1 AT_DEC_ADMITTED
arc = at_parse_and_identify art
if ne arc AT_OK
if admitted
ret AT_ERR_RCP_ADMIT_BAD_ART
end
if not at_rcp_digest_is_zero 0
ret AT_ERR_RCP_NZ_BAD_ART
end
if not at_rcp_digest_is_zero 1
ret AT_ERR_RCP_NZ_BAD_ART
end
if not at_rcp_digest_is_zero 2
ret AT_ERR_RCP_NZ_BAD_ART
end
if not at_rcp_digest_is_zero 4
ret AT_ERR_RCP_NZ_BAD_ART
end
if not at_rcp_digest_is_zero 6
ret AT_ERR_RCP_NZ_BAD_ART
end
else
z_ok = not admitted
if not at_rcp_check_one_binding 0 z_ok
ret AT_ERR_RCP_BIND_MISMATCH
end
if not at_rcp_check_one_binding 1 z_ok
ret AT_ERR_RCP_BIND_MISMATCH
end
if not at_rcp_check_one_binding 2 z_ok
ret AT_ERR_RCP_BIND_MISMATCH
end
if not at_rcp_check_one_binding 4 z_ok
ret AT_ERR_RCP_BIND_MISMATCH
end
if not at_rcp_check_one_binding 6 z_ok
ret AT_ERR_RCP_BIND_MISMATCH
end
if admitted
if at_rcp_digest_is_zero 5
ret AT_ERR_RCP_NO_GRANTS
end
end
end
dig = new uchar 32 0
at_rcp_digest rec dig
for i ulong 32
put at_rcp_dig_out i get dig i
end
ret AT_OK
end

note Tool `receipt sign-test` command (receipt_cmd.rs::sign_test)
fn at_rcp_sign_test rec edit uchar * test_mode bool to int
if not test_mode
ret AT_ERR_PROD_SIGN_OFF
end
if not at_rcp_is_unsigned rec
ret AT_ERR_BAD_SIG_FMT
end
rc = at_rcp_decode rec
if ne rc AT_OK
ret rc
end
key = new uchar 32 0
at_fill_test_rcp_key key
fp = new uchar 32 0
at_signer_fp key fp
dig = new uchar 32 0
at_rcp_digest rec dig
sig = new uchar 64 0
at_compute_sig key at_dom_rcp_sig dig sig
at_put_u16_le rec 400 AT_SIG_ALG_ED25519
for i ulong 32
put rec add 404 i get fp i
end
for i ulong 64
put rec add 436 i get sig i
end
ret AT_OK
end

note Tool `receipt verify` command (receipt_cmd.rs::verify_file)
fn at_rcp_verify rec view uchar * test_mode bool to int
rc = at_rcp_decode rec
if ne rc AT_OK
ret rc
end
if at_rcp_is_unsigned rec
ret AT_ERR_BAD_SIG_FMT
end
if not test_mode
ret AT_ERR_UNTRUSTED
end
key = new uchar 32 0
at_fill_test_rcp_key key
exp_fp = new uchar 32 0
at_signer_fp key exp_fp
for i ulong 32
if ne get rec add 404 i get exp_fp i
ret AT_ERR_UNTRUSTED
end
end
dig = new uchar 32 0
at_rcp_digest rec dig
exp_sig = new uchar 64 0
at_compute_sig key at_dom_rcp_sig dig exp_sig
for i ulong 64
if ne get rec add 436 i get exp_sig i
ret AT_ERR_BAD_SIG
end
end
for i ulong 32
put at_rcp_dig_out i get dig i
end
ret AT_OK
end

note P2-7 Negative Corpus generator (corpus.rs: H01..H29)
fn at_corpus_stage_seed_cap rights ulong to void
idx = at_manifest_push_cap AT_RES_KIND_OBJECT 1 rights 1 4
at_manifest_set_cap_bounds ulong idx 32 0 32
end

fn at_corpus_stage_res cp ulong dp ulong sp ulong mc ulong sc ulong to void
at_manifest_set_res_pages cp dp sp mc
at_manifest_set_res_limits 0 0 100000000 100000000 sc
end

fn at_corpus_fill_exit0 buf edit uchar * to void
at_put_u32_le buf 0 AT_INSN_MOV_X0_0
at_put_u32_le buf 4 AT_INSN_MOV_X8_2
at_put_u32_le buf 8 AT_INSN_SVC_0
at_put_u32_le buf 12 AT_INSN_B_SELF
end

fn at_corpus_pack_signed code view uchar * data view uchar * dst edit uchar * to int
rc = at_pack code data dst
if ne rc AT_OK
ret rc
end
n = get at_pack_len 0
rc = at_sign_artifact part dst 0 n true
if ne rc AT_OK
ret rc
end
put at_corpus_len 0 n
ret AT_OK
end

fn at_corpus_build_baseline dst edit uchar * to int
at_manifest_reset
at_corpus_stage_seed_cap 1
at_corpus_stage_res 1 1 1 1 8
code = new uchar 16 0
at_corpus_fill_exit0 code
ret at_corpus_pack_signed code at_tag_baseline dst
end

fn at_corpus_mutate_base cid ulong dst edit uchar * to int
ukey = new uchar 32 0
rc = at_corpus_build_baseline dst
if ne rc AT_OK
ret rc
end
n = get at_corpus_len 0
pay_off = at_get_u32_le dst 56
res_off = add AT_CAP_TABLE_OFF AT_CAP_REC_SIZE
sig_off = sub n AT_SIG_BLOCK_SIZE
if eq cid 1
put dst 0 88
ret AT_OK
end
if eq cid 2
at_put_u16_le dst 8 1
ret AT_OK
end
if eq cid 3
at_put_u16_le dst 12 2
ret AT_OK
end
if eq cid 4
at_put_u16_le dst 14 2
ret AT_OK
end
if eq cid 5
put at_corpus_len 0 sub n 10
ret AT_OK
end
if eq cid 6
if ge n len dst
ret AT_ERR_BUF_SMALL
end
put dst n 0
put at_corpus_len 0 add n 1
ret AT_OK
end
if eq cid 7
t = at_get_u32_le dst 20
at_put_u32_le dst 20 add t 1
ret AT_OK
end
if eq cid 8
at_put_u32_le dst 60 0xffffffff
ret AT_OK
end
if eq cid 9
at_put_u32_le dst 168 4
ret AT_OK
end
if eq cid 10
at_put_u32_le dst 36 0x1000
ret AT_OK
end
if eq cid 11
put dst pay_off xor get dst pay_off 1
ret AT_OK
end
if eq cid 12
at_put_u32_le dst add AT_CAP_TABLE_OFF 8 3
ret AT_OK
end
if eq cid 13
at_put_u32_le dst add res_off 8 2
ret AT_OK
end
if eq cid 14
p = add sig_off 40
put dst p xor get dst p 1
ret AT_OK
end
if eq cid 15
at_fill_untrusted_key ukey
ret at_sign_with_key part dst 0 n ukey
end
if eq cid 16
at_put_u16_le dst sig_off 2
ret AT_OK
end
if eq cid 17
put dst 100 1
ret AT_OK
end
if eq cid 18
at_put_u32_le dst add AT_CAP_TABLE_OFF 8 65
ret AT_OK
end
if eq cid 19
at_put_u16_le dst 44 17
ret AT_OK
end
if eq cid 20
at_put_u32_le dst res_off 65
ret AT_OK
end
if eq cid 22
at_put_u16_le dst 130 7
ret AT_OK
end
ret AT_ERR_BAD_CASE
end

fn at_corpus_build_custom cid ulong dst edit uchar * to int
code = new uchar 16 0
c4 = new uchar 4 0
c8 = new uchar 8 0
c12 = new uchar 12 0
c32 = new uchar 32 0
if eq cid 21
at_manifest_reset
at_corpus_stage_res 64 64 16 0 4
at_corpus_fill_exit0 code
ret at_corpus_pack_signed code at_tag_largest dst
end
if eq cid 23
at_manifest_reset
at_corpus_stage_res 1 1 1 0 4
at_put_u32_le c4 0 AT_INSN_BR_X2
ret at_corpus_pack_signed c4 at_tag_datapage dst
end
if eq cid 24
at_manifest_reset
at_corpus_stage_res 1 1 1 0 4
at_put_u32_le c8 0 AT_INSN_SUB_X9_SP_16
at_put_u32_le c8 4 AT_INSN_BR_X9
ret at_corpus_pack_signed c8 at_tag_stackpag dst
end
if eq cid 25
at_manifest_reset
at_corpus_stage_res 1 1 1 0 4
at_put_u32_le c12 0 AT_INSN_MOV_X8_99
at_put_u32_le c12 4 AT_INSN_SVC_0
at_put_u32_le c12 8 AT_INSN_B_SELF
ret at_corpus_pack_signed c12 at_tag_badsyscl dst
end
if eq cid 26
at_manifest_reset
at_corpus_stage_res 1 1 1 0 2
at_put_u32_le c32 0 AT_INSN_MOV_X0_0
at_put_u32_le c32 4 AT_INSN_MOV_X8_6
at_put_u32_le c32 8 AT_INSN_SVC_0
at_put_u32_le c32 12 AT_INSN_SVC_0
at_put_u32_le c32 16 AT_INSN_SVC_0
at_put_u32_le c32 20 AT_INSN_MOV_X8_2
at_put_u32_le c32 24 AT_INSN_SVC_0
at_put_u32_le c32 28 AT_INSN_B_SELF
ret at_corpus_pack_signed c32 at_tag_overrun dst
end
if eq cid 27
at_manifest_reset
at_corpus_stage_seed_cap 1
at_manifest_set_res_pages 1 1 1 1
at_manifest_set_res_limits 1 64 100000000 100000000 8
at_corpus_fill_exit0 code
ret at_corpus_pack_signed code at_tag_ipcwants dst
end
if eq cid 28
at_manifest_reset
at_corpus_stage_seed_cap 2
at_corpus_stage_res 1 1 1 1 8
at_corpus_fill_exit0 code
ret at_corpus_pack_signed code at_tag_writereq dst
end
if eq cid 29
at_manifest_reset
at_corpus_stage_seed_cap 3
at_corpus_stage_res 1 1 1 1 8
at_corpus_fill_exit0 code
ret at_corpus_pack_signed code at_tag_rwrequst dst
end
ret AT_ERR_BAD_CASE
end

fn at_corpus_build_case cid ulong dst edit uchar * to int
if lt cid 1
ret AT_ERR_BAD_CASE
end
if gt cid AT_CORPUS_COUNT
ret AT_ERR_BAD_CASE
end
if le cid 20
ret at_corpus_mutate_base cid dst
end
if eq cid 22
ret at_corpus_mutate_base cid dst
end
ret at_corpus_build_custom cid dst
end

note Populate at_corpus_exp[0..4] = (expect_kind, code, exec_kind, caps) for H01..H29
fn at_corpus_set_exp k ulong code ulong ex ulong caps ulong to void
put at_corpus_exp 0 k
put at_corpus_exp 1 code
put at_corpus_exp 2 ex
put at_corpus_exp 3 caps
end

fn at_corpus_expect cid ulong to int
if eq cid 1
at_corpus_set_exp AT_EXP_REJ_VERIFIED 1 0 0
ret AT_OK
end
if eq cid 2
at_corpus_set_exp AT_EXP_REJ_VERIFIED 2 0 0
ret AT_OK
end
if eq cid 3
at_corpus_set_exp AT_EXP_REJ_VERIFIED 3 0 0
ret AT_OK
end
if eq cid 4
at_corpus_set_exp AT_EXP_REJ_VERIFIED 4 0 0
ret AT_OK
end
if eq cid 5
at_corpus_set_exp AT_EXP_REJ_VERIFIED 7 0 0
ret AT_OK
end
if eq cid 6
at_corpus_set_exp AT_EXP_REJ_VERIFIED 7 0 0
ret AT_OK
end
if eq cid 7
at_corpus_set_exp AT_EXP_REJ_VERIFIED 7 0 0
ret AT_OK
end
if eq cid 8
at_corpus_set_exp AT_EXP_REJ_VERIFIED 14 0 0
ret AT_OK
end
if eq cid 9
at_corpus_set_exp AT_EXP_REJ_VERIFIED 11 0 0
ret AT_OK
end
if eq cid 10
at_corpus_set_exp AT_EXP_REJ_VERIFIED 12 0 0
ret AT_OK
end
if eq cid 11
at_corpus_set_exp AT_EXP_REJ_VERIFIED 18 0 0
ret AT_OK
end
if eq cid 12
at_corpus_set_exp AT_EXP_REJ_VERIFIED 18 0 0
ret AT_OK
end
if eq cid 13
at_corpus_set_exp AT_EXP_REJ_VERIFIED 18 0 0
ret AT_OK
end
if eq cid 14
at_corpus_set_exp AT_EXP_REJ_VERIFIED 18 0 0
ret AT_OK
end
if eq cid 15
at_corpus_set_exp AT_EXP_REJ_VERIFIED 17 0 0
ret AT_OK
end
if eq cid 16
at_corpus_set_exp AT_EXP_REJ_VERIFIED 15 0 0
ret AT_OK
end
if eq cid 17
at_corpus_set_exp AT_EXP_REJ_VERIFIED 8 0 0
ret AT_OK
end
if eq cid 18
at_corpus_set_exp AT_EXP_REJ_VERIFIED 13 0 0
ret AT_OK
end
if eq cid 19
at_corpus_set_exp AT_EXP_REJ_VERIFIED 14 0 0
ret AT_OK
end
if eq cid 20
at_corpus_set_exp AT_EXP_REJ_VERIFIED 14 0 0
ret AT_OK
end
if eq cid 21
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_EXIT0 0
ret AT_OK
end
if eq cid 22
at_corpus_set_exp AT_EXP_REJ_VERIFIED 11 0 0
ret AT_OK
end
if eq cid 23
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_NX 0
ret AT_OK
end
if eq cid 24
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_NX 0
ret AT_OK
end
if eq cid 25
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_BAD_SYS99 0
ret AT_OK
end
if eq cid 26
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_OVERRUN 0
ret AT_OK
end
if eq cid 27
at_corpus_set_exp AT_EXP_REJ_AUTHORIZED 14 0 0
ret AT_OK
end
if eq cid 28
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_EXIT0 0
ret AT_OK
end
if eq cid 29
at_corpus_set_exp AT_EXP_ADMITTED 0 AT_CORPUS_EXEC_EXIT0 1
ret AT_OK
end
ret AT_ERR_BAD_CASE
end

note CLI argument parser and command dispatcher (main.rs::run + receipt_cmd.rs::run)
fn at_cli_dispatch_rcp argc ulong a2 view uchar * to int
if at_bytes_eq a2 at_kw_inspect
if eq argc 4
ret AT_CMD_RCP_INSPECT
end
ret AT_CMD_INVALID
end
if at_bytes_eq a2 at_kw_check
if eq argc 5
ret AT_CMD_RCP_CHECK
end
ret AT_CMD_INVALID
end
if at_bytes_eq a2 at_kw_from_hex
if eq argc 5
ret AT_CMD_RCP_FROM_HEX
end
ret AT_CMD_INVALID
end
if at_bytes_eq a2 at_kw_sign_test
if eq argc 5
ret AT_CMD_RCP_SIGN_TEST
end
ret AT_CMD_INVALID
end
if at_bytes_eq a2 at_kw_verify
if eq argc 4
ret AT_CMD_RCP_VERIFY
end
ret AT_CMD_INVALID
end
ret AT_CMD_INVALID
end

fn at_cli_dispatch argc ulong a1 view uchar * a2 view uchar * test_mode bool to int
if lt argc 2
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_pack
if eq argc 6
ret AT_CMD_PACK
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_inspect
if eq argc 3
ret AT_CMD_INSPECT
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_id
if eq argc 3
ret AT_CMD_ID
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_sign
if eq argc 4
ret AT_CMD_SIGN
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_verify
if eq argc 3
ret AT_CMD_VERIFY
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_neg_corpus
if test_mode
if eq argc 3
ret AT_CMD_NEG_CORPUS
end
end
ret AT_CMD_INVALID
end
if at_bytes_eq a1 at_kw_receipt
ret at_cli_dispatch_rcp argc a2
end
ret AT_CMD_INVALID
end

put dst 13 0xec
put dst 14 0x2c
put dst 15 0xc4
put dst 16 0x44
put dst 17 0x49
put dst 18 0xc5
put dst 19 0x69
put dst 20 0x7b
put dst 21 0x32
put dst 22 0x69
put dst 23 0x19
put dst 24 0x70
put dst 25 0x3b
put dst 26 0xac
put dst 27 0x03
put dst 28 0x1c
put dst 29 0xae
put dst 30 0x7f
put dst 31 0x60
end


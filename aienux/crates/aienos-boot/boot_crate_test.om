note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-boot/boot_crate_test.om: Behavioral self-test for aienos-boot.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-boot/boot_crate.om aienux/crates/aienos-boot/boot_crate_test.om

text t_dp_path_def "\\EFI\\DEFAULT\\default.efi"
text t_dp_path_cand "\\EFI\\AIENOS\\CANDIDATE.EFI"
text t_dp_path_stager "\\EFI\\BOOT\\BOOTAA64.EFI"
text t_mode_fault "mode=fault\n"
text t_mode_timeout "timeout"
text t_mode_absent "absent"
text t_mode_malformed "malformed"
text t_mode_real "real_aienos"
text t_mode_normal "normal"
text t_art_a "alpha.aien"
text t_art_b "beta.AIEN"
text t_art_c "charlie.aien"
text t_stmt_1 "qemu: the operator asked AIEN to remember this"
text t_sent_hex "b6a72a740e5c8e5c"

fn test_lib_and_wcslen to int
if ne BC_CREATES_AGENT_IDENTITY 0
ret 1
end
if ne len bc_firmware_banner 30
ret 2
end
if not bc_feature_config_valid true false false
ret 3
end
if bc_feature_config_valid true true false
ret 4
end
if bc_feature_config_valid true false true
ret 5
end
if not bc_feature_config_valid false true true
ret 6
end

note wcslen.rs test 1: empty_string_is_zero
w0 = new ushort 1 0
if ne bc_wide_len w0 0
ret 7
end

note wcslen.rs test 2: counts_units_before_first_zero
w1 = new ushort 4 0
put w1 0 97
put w1 1 98
put w1 2 99
put w1 3 0
if ne bc_wide_len w1 3
ret 8
end

note wcslen.rs test 3: stops_at_first_zero_not_slice_end
w2 = new ushort 6 0
put w2 0 1
put w2 1 2
put w2 2 0
put w2 3 3
put w2 4 4
put w2 5 0
if ne bc_wide_len w2 2
ret 9
end

note wcslen.rs test 4: high_unit_values_are_not_terminators
w3 = new ushort 5 0
put w3 0 0xffff
put w3 1 0x8000
put w3 2 0x0100
put w3 3 0xd800
put w3 4 0
if ne bc_wide_len w3 4
ret 10
end

note wcslen bounded safety: no zero returns slice len
w4 = new ushort 3 0x0041
if ne bc_wide_len w4 3
ret 11
end
ret 0
end

fn test_rollback_dp_and_load_opt to int
note Build a synthetic partition DP prefix (8 bytes: Type 0x04 SubType 0x01 Len 8)
prefix = new uchar 8 0
put prefix 0 0x04
put prefix 1 0x01
bc_put_u16_le prefix 2 8
put prefix 4 0x01

dp_def = new uchar 128 0
len_def = bc_build_file_dp prefix t_dp_path_def dp_def
if eq len_def 0
ret 20
end
if ne bc_dp_prefix_len part dp_def 0 len_def 8
ret 21
end
if ne bc_dp_detect_role part dp_def 0 len_def BC_ROLE_DEFAULT_OS
ret 22
end

dp_cand = new uchar 128 0
len_cand = bc_build_file_dp prefix t_dp_path_cand dp_cand
if eq len_cand 0
ret 23
end
if ne bc_dp_detect_role part dp_cand 0 len_cand BC_ROLE_CANDIDATE
ret 24
end

dp_stg = new uchar 128 0
len_stg = bc_build_file_dp prefix t_dp_path_stager dp_stg
if ne bc_dp_detect_role part dp_stg 0 len_stg BC_ROLE_STAGER
ret 25
end

note Build EFI_LOAD_OPTION and verify header fields
opt = new uchar 256 0
opt_len = bc_build_load_option bc_rb_desc_default part dp_def 0 len_def opt
if eq opt_len 0
ret 26
end
if ne bc_get_u32_le opt 0 BC_LOAD_OPTION_ACTIVE
ret 27
end
if ne ulong bc_get_u16_le opt 4 len_def
ret 28
end
note Description is "Default Linux OS" (16 chars + null = 34 bytes at offset 6..40)
if ne get opt 6 68
ret 29
end
if ne get opt 7 0
ret 30
end
if ne bc_get_u16_le opt 38 0
ret 31
end
note Mode parsing
if ne bc_rollback_parse_mode t_mode_fault BC_MODE_FAULT
ret 32
end
if ne bc_rollback_parse_mode t_mode_timeout BC_MODE_TIMEOUT
ret 33
end
if ne bc_rollback_parse_mode t_mode_absent BC_MODE_ABSENT
ret 34
end
if ne bc_rollback_parse_mode t_mode_malformed BC_MODE_MALFORMED
ret 35
end
if ne bc_rollback_parse_mode t_mode_real BC_MODE_REAL_AIENOS
ret 36
end
if ne bc_rollback_parse_mode t_mode_normal BC_MODE_NORMAL
ret 37
end
ret 0
end

fn test_rollback_state_machine to int
st = new ulong 9 0
bc_rollback_init st
note Empty prefix rejected
if ne bc_rollback_stager st BC_MODE_NORMAL 0 BC_RB_ACTION_UNSUPPORTED
ret 40
end
note Stage normal rollback
if ne bc_rollback_stager st BC_MODE_NORMAL 8 BC_RB_ACTION_COLD_RESET_OK
ret 41
end
note First firmware boot consumes BootNext -> Candidate (0x0000)
if ne bc_rollback_firmware_boot st BC_BOOT_CANDIDATE
ret 42
end
if ne get st BC_RB_BOOT_NEXT_PRESENT 0
ret 43
end
note Candidate normal termination -> cold reset
if ne bc_rollback_candidate st BC_MODE_NORMAL BC_RB_ACTION_COLD_RESET_OK
ret 44
end
if ne bc_rollback_candidate st BC_MODE_FAULT BC_RB_ACTION_COLD_RESET_ABORT
ret 45
end
if ne bc_rollback_candidate st BC_MODE_TIMEOUT BC_RB_ACTION_HANG
ret 46
end
note Second firmware boot falls back to BootOrder[0] -> Default (0x0001)
if ne bc_rollback_firmware_boot st BC_BOOT_DEFAULT
ret 47
end
note First return to Default OS: cycle 0 -> 1, triggers repeat boot
if ne bc_rollback_default st BC_RB_ACTION_COLD_RESET_REPEAT
ret 48
end
if ne get st BC_RB_INVARIANT_MASK 3
ret 49
end
if ne get st BC_RB_CYCLE 1
ret 50
end
note Third firmware boot: repeat boot into Default OS -> SHUTDOWN_PASS
if ne bc_rollback_firmware_boot st BC_BOOT_DEFAULT
ret 51
end
if ne bc_rollback_default st BC_RB_ACTION_SHUTDOWN_PASS
ret 52
end
ret 0
end

fn test_store_qual_and_bounded_nvme to int
if not bc_is_recovery_mode BC_MODE_RECOVERY_INSPECT
ret 60
end
if not bc_is_recovery_mode BC_MODE_RECOVERY_REPAIR
ret 61
end
if not bc_is_recovery_mode BC_MODE_RECOVERY_PROVISION
ret 62
end
if bc_is_recovery_mode BC_MODE_CONT_PROVISION
ret 63
end
if not bc_is_continuity_mode BC_MODE_CONT_PROVISION
ret 64
end
if not bc_is_continuity_mode BC_MODE_CONT_CRASH
ret 65
end
if bc_is_continuity_mode BC_MODE_VERIFY
ret 66
end
if not bc_is_512_qual_mode BC_MODE_RUN_512B
ret 67
end
if not bc_is_512_qual_mode BC_MODE_VERIFY_512B
ret 68
end
if ne bc_store_config_lba 512 BC_CONFIG_LBA_512
ret 69
end
if ne bc_store_config_lba 4096 BC_CONFIG_LBA
ret 70
end

note BoundedNvme translation and bounds checks
dev = new ulong 3 0
out_lba = new ulong 1 0
bc_bounded_nvme_init dev 4096 BC_STORE_BASE_LBA BC_STORE_REGION_BLOCKS
if ne bc_bounded_nvme_translate dev 0 4096 out_lba BC_BLK_OK
ret 71
end
if ne get out_lba 0 64
ret 72
end
if ne bc_bounded_nvme_translate dev 255 4096 out_lba BC_BLK_OK
ret 73
end
if ne get out_lba 0 319
ret 74
end
if ne bc_bounded_nvme_translate dev 256 4096 out_lba BC_BLK_ERR_OUT_OF_RANGE
ret 75
end
if ne bc_bounded_nvme_translate dev 0 100 out_lba BC_BLK_ERR_INVALID_INPUT
ret 76
end
if ne bc_bounded_nvme_translate dev 0xffffffffffffffff 4096 out_lba BC_BLK_ERR_OUT_OF_RANGE
ret 77
end

note Geometry validation
if ne bc_store_qual_check_geometry 4096 BC_MODE_VERIFY 1024 true BC_QUAL_OK
ret 78
end
if ne bc_store_qual_check_geometry 4096 BC_MODE_VERIFY 1024 false BC_QUAL_ERR_NOT_ATOMIC
ret 79
end
if ne bc_store_qual_check_geometry 512 BC_MODE_RUN_512B 4096 false BC_QUAL_OK
ret 80
end
if ne bc_store_qual_check_geometry 4096 BC_MODE_RUN_512B 4096 true BC_QUAL_ERR_512_NEEDS_512
ret 81
end
if ne bc_store_qual_check_geometry 512 BC_MODE_VERIFY 4096 true BC_QUAL_ERR_4096_REQUIRED
ret 82
end
if ne bc_store_qual_check_geometry 4096 BC_MODE_VERIFY 100 true BC_QUAL_ERR_REGION_OOB
ret 83
end
if not bc_store_reopen_gen_valid 4 2
ret 84
end
if bc_store_reopen_gen_valid 5 2
ret 85
end
if not bc_store_slot_reuse_proven 4 3
ret 86
end
if bc_store_slot_reuse_proven 3 3
ret 87
end
ret 0
end

fn test_nvme_dma_and_sentinel to int
note PCI requester ID and BME helpers
if ne bc_pci_requester_id 1 2 3 0x0113
ret 90
end
if bc_pci_bme_enabled 0x0002
ret 91
end
if not bc_pci_bme_enabled 0x0006
ret 92
end
if ne bc_pci_without_bme 0x0007 0x0003
ret 93
end
if ne bc_pci_with_bme 0x0003 0x0007
ret 94
end

note DMA grant gate (M3 rule: no SMMU confinement means no DMA)
if ne bc_dma_grant true true false BC_DMA_GRANT_CONFINED
ret 95
end
if ne bc_dma_grant false true true BC_DMA_DENIED_SMMU_NOT_READY
ret 96
end
if ne bc_dma_grant false false false BC_DMA_DENIED_NO_SMMU
ret 97
end
if ne bc_dma_grant false false true BC_DMA_GRANT_UNSAFE_BYPASS
ret 98
end

note NVMe BAR decoder
if ne bc_nvme_decode_bar 0x01080200 0x10000004 0x00000002 0x0000000210000000
ret 99
end
if ne bc_nvme_decode_bar 0x01080200 0xfe000000 0x00000000 0xfe000000
ret 100
end
if ne bc_nvme_decode_bar 0x0c033000 0xfe000000 0x00000000 0
ret 101
end
if ne bc_nvme_decode_bar 0x01080200 0x0000c001 0x00000000 0
ret 102
end

note NativeDma bump arena
arena = new ulong 3 0
phys = new ulong 1 0
off = new ulong 1 0
bc_dma_arena_init arena 0x40000000 BC_NVME_ARENA_BYTES
if ne bc_dma_arena_alloc arena 100 4096 phys 0
ret 103
end
if ne get phys 0 0x40000000
ret 104
end
if ne bc_dma_arena_alloc arena 4096 4096 phys 0
ret 105
end
if ne get phys 0 0x40001000
ret 106
end
if ne bc_dma_arena_alloc arena 64 3 phys -1
ret 107
end
if ne bc_dma_arena_offset arena 0x40001000 4096 off 0
ret 108
end
if ne get off 0 4096
ret 109
end
if ne bc_dma_arena_offset arena 0x3fffffff 4 off -1
ret 110
end
if ne bc_dma_arena_offset arena 0x4007ff00 512 off -1
ret 111
end

note Sentinel pattern fill, verify, and SHA-256 hex digest
sec = new uchar 512 0
hex = new uchar 64 0
if not bc_nvme_fill_sector_pattern sec bc_nvme_sentinel_magic
ret 112
end
if not bc_nvme_verify_sector_pattern sec bc_nvme_sentinel_magic
ret 113
end
if ne bc_nvme_sector_sha256_hex sec hex 64
ret 114
end
note Mutate one byte and confirm verify fails and digest changes
put sec 511 xor get sec 511 1
if bc_nvme_verify_sector_pattern sec bc_nvme_sentinel_magic
ret 115
end
hex2 = new uchar 64 0
if ne bc_nvme_sector_sha256_hex sec hex2 64
ret 116
end
if bc_bytes_eq hex hex2
ret 117
end

note Continuity cortex statement hash
ctx = new ulong 40 0
dig = new uchar 32 0
sha256_init ctx
bc_continuity_hash_statement ctx t_stmt_1
sha256_final ctx dig
nonzero = false
for i ulong 32
if ne get dig i 0
nonzero = true
end
end
if not nonzero
ret 118
end
ret 0
end

fn test_usb_keyboard to int
if ne bc_xhci_mmio_base 0x0c033000 0x10000004 0x00000001 0x0000000110000000
ret 120
end
if ne bc_xhci_mmio_base 0x0c032000 0x10000004 0x00000001 0
ret 121
end

prev = new uchar 6 0
rep = new uchar 8 0
kinds = new uchar 6 0
chars = new uchar 6 0
line = new uchar 128 0
llen = new ulong 1 0

note Press 'h' (0x0b), 'i' (0x0c)
put rep 0 0
put rep 2 0x0b
put rep 3 0x0c
n1 = bc_hid_decode_report prev rep kinds chars
if ne n1 2
ret 122
end
if ne get kinds 0 BC_KEY_CHAR
ret 123
end
if ne get chars 0 104
ret 124
end
if ne get chars 1 105
ret 125
end
for i ulong n1 bound 6
r = bc_kb_line_apply line llen get kinds i get chars i
if ne r 0
ret 126
end
end

note Hold 'i' (0x0c) and press Shift+'1' ('!')
put rep 0 0x02
put rep 2 0x0c
put rep 3 0x1e
n2 = bc_hid_decode_report prev rep kinds chars
if ne n2 1
ret 127
end
if ne get chars 0 33
ret 128
end
r2 = bc_kb_line_apply line llen get kinds 0 get chars 0
if ne r2 0
ret 129
end
if ne get llen 0 3
ret 130
end

note ErrorRollOver report (0x01) must be ignored
put rep 2 0x01
put rep 3 0
n3 = bc_hid_decode_report prev rep kinds chars
if ne n3 0
ret 131
end

note Backspace removes '!', leaving "hi"
put rep 0 0
put rep 2 0x2a
n4 = bc_hid_decode_report prev rep kinds chars
if ne n4 1
ret 132
end
if ne get kinds 0 BC_KEY_BACKSPACE
ret 133
end
r4 = bc_kb_line_apply line llen get kinds 0 get chars 0
if ne r4 0
ret 134
end
if ne get llen 0 2
ret 135
end

note Enter signals line complete
put rep 2 0x28
n5 = bc_hid_decode_report prev rep kinds chars
if ne n5 1
ret 136
end
if ne get kinds 0 BC_KEY_ENTER
ret 137
end
if ne bc_kb_line_apply line llen get kinds 0 get chars 0 1
ret 138
end
if ne get line 0 104
ret 139
end
if ne get line 1 105
ret 140
end

note Stop reason classification
if ne bc_kb_stop_reason true false BC_KB_DONE_EXIT
ret 141
end
if ne bc_kb_stop_reason false true BC_KB_DONE_HALTED
ret 142
end
if ne bc_kb_stop_reason false false BC_KB_DONE_TIMEOUT
ret 143
end
ret 0
end

fn test_handoff_logic to int
note Post-exit heap allocator
heap = new ulong 3 0
addr = new ulong 1 0
bc_heap_init heap 0x80000000 mul BC_POST_EXIT_HEAP_PAGES 4096
if ne bc_heap_alloc heap 64 256 addr 0
ret 150
end
if ne get addr 0 0x80000000
ret 151
end
if ne bc_heap_alloc heap 128 256 addr 0
ret 152
end
if ne get addr 0 0x80000100
ret 153
end
if ne bc_heap_alloc heap 16 3 addr -1
ret 154
end

note SMMU alignment and stream ID validation
if not bc_smmu_validate 0x80040000 12
ret 155
end
if bc_smmu_validate 0x80001000 12
ret 156
end
if bc_smmu_validate 0x80040000 4096
ret 157
end

note MAT header length
mat = new uchar 16 0
bc_put_u32_le mat 4 10
bc_put_u32_le mat 8 48
if ne bc_mat_header_length mat 496
ret 158
end
bc_put_u32_le mat 4 100000
bc_put_u32_le mat 8 48
if ne bc_mat_header_length mat 0
ret 159
end

note Page-aligned MMIO range
rng = new ulong 2 0
if not bc_page_align_range 0x10000100 0x1000 rng
ret 160
end
if ne get rng 0 0x10000000
ret 161
end
if ne get rng 1 0x2000
ret 162
end

note EL1 MMU switch verification
if not bc_mmu_switched 1 true 0x0001000040000000 0x0000000030000000 0x40000000
ret 163
end
if bc_mmu_switched 2 true 0x40000000 0x30000000 0x40000000
ret 164
end
if bc_mmu_switched 1 true 0x40000000 0x40000000 0x40000000
ret 165
end

note Timer ticks to us
if ne bc_timer_ticks_to_us 62500000 62500000 1000000
ret 166
end
if ne bc_timer_ticks_to_us 625000 62500000 10000
ret 167
end
if ne bc_timer_ticks_to_us 100 0 0
ret 168
end

note ADR 0008 NVRAM write budget
b = new ulong 3 0
bc_var_budget_init b BC_MAX_VAR_WRITES BC_MAX_VAR_BYTES
if ne bc_var_budget_try_write b 4096 BC_VAR_ERR_TOO_LARGE
ret 169
end
if ne bc_var_budget_try_write b 100 1
ret 170
end
if ne bc_var_budget_try_write b 200 2
ret 171
end
if ne bc_var_budget_try_write b 300 3
ret 172
end
if ne bc_var_budget_try_write b 100 BC_VAR_ERR_BUDGET_SPENT
ret 173
end

note Artifact name validation (UTF-16 -> ASCII, .aien case-insensitive)
aw = new ushort 11 0
put aw 0 65
put aw 1 46
put aw 2 65
put aw 3 73
put aw 4 69
put aw 5 78
put aw 6 0
aname = new uchar 32 0
if ne bc_artifact_name_valid aw aname 6
ret 174
end
put aw 2 88
if ne bc_artifact_name_valid aw aname 0
ret 175
end
if bc_artifact_oversize BC_MAX_ARTIFACT_FILE_BYTES
ret 176
end
if not bc_artifact_oversize add BC_MAX_ARTIFACT_FILE_BYTES 1
ret 177
end

note Sorted artifact candidate insertion (insert charlie, alpha, beta -> alpha, beta, charlie)
entries = new uchar 2304 0
meta = new ulong 2 0
c1 = bc_artifact_insert_sorted entries meta t_art_c 300
c2 = bc_artifact_insert_sorted entries meta t_art_a 100
c3 = bc_artifact_insert_sorted entries meta t_art_b 200
if ne c1 1
ret 178
end
if ne c2 2
ret 179
end
if ne c3 3
ret 180
end
if ne get entries 0 97
ret 181
end
if ne get entries 48 98
ret 182
end
if ne get entries 96 99
ret 183
end
if ne bc_get_u64_le entries 40 100
ret 184
end

note RSDP 2.0 validation
rsdp = new uchar 36 0
for i ulong 8
put rsdp i get bc_rsdp_sig i
end
bc_put_u64_le rsdp 24 0x00000000bf001000
if ne bc_rsdp_xsdt_addr rsdp 0x00000000bf001000
ret 185
end
put rsdp 0 88
if ne bc_rsdp_xsdt_addr rsdp 0
ret 186
end

note Stage, EL0, and preemption predicates
if not bc_stage_valid BC_STAGE_COUNTDOWN
ret 187
end
if bc_stage_valid BC_STAGE_COUNT
ret 188
end
if not bc_el0_report_ok true true true 0
ret 189
end
if bc_el0_report_ok true true true 1
ret 190
end
if not bc_preempt_ok 1 1 4
ret 191
end
if bc_preempt_ok 1 1 3
ret 192
end
ret 0
end

fn main to int
r1 = test_lib_and_wcslen
if ne r1 0
ret r1
end
r2 = test_rollback_dp_and_load_opt
if ne r2 0
ret r2
end
r3 = test_rollback_state_machine
if ne r3 0
ret r3
end
r4 = test_store_qual_and_bounded_nvme
if ne r4 0
ret r4
end
r5 = test_nvme_dma_and_sentinel
if ne r5 0
ret r5
end
r6 = test_usb_keyboard
if ne r6 0
ret r6
end
r7 = test_handoff_logic
if ne r7 0
ret r7
end
ret 0
end

note ============================================================================
note Section 1: Feature policy (lib.rs) & Little-endian / Byte helpers
note ============================================================================

fn bc_feature_config_valid hw_staging bool unsafe_dma bool unsafe_nvme_dma bool to bool
if hw_staging
if unsafe_dma
ret false
end
if unsafe_nvme_dma
ret false
end
end
ret true
end

fn bc_get_u16_le buf view uchar * off ulong to ushort
b0 = ushort get buf off
b1 = ushort get buf add off 1
ret or b0 shl b1 8
end

fn bc_put_u16_le buf edit uchar * off ulong val ushort to void
put buf off uchar and val 255
put buf add off 1 uchar and shr val 8 255
end

fn bc_get_u32_le buf view uchar * off ulong to uint
b0 = uint get buf off
b1 = uint get buf add off 1
b2 = uint get buf add off 2
b3 = uint get buf add off 3
t0 = or b0 shl b1 8
t1 = or shl b2 16 shl b3 24
ret or t0 t1
end

fn bc_put_u32_le buf edit uchar * off ulong val uint to void
put buf off uchar and val 255
put buf add off 1 uchar and shr val 8 255
put buf add off 2 uchar and shr val 16 255
put buf add off 3 uchar and shr val 24 255
end

fn bc_get_u64_le buf view uchar * off ulong to ulong
lo = ulong bc_get_u32_le buf off
hi = ulong bc_get_u32_le buf add off 4
ret or lo shl hi 32
end

fn bc_put_u64_le buf edit uchar * off ulong val ulong to void
bc_put_u32_le buf off uint and val 0xffffffff
bc_put_u32_le buf add off 4 uint and shr val 32 0xffffffff
end

fn bc_ascii_lower ch uchar to uchar
if ge ch 65
if le ch 90
ret add ch 32
end
end
ret ch
end

fn bc_bytes_eq a view uchar * b view uchar * to bool
na = len a
if ne na len b
ret false
end
for i ulong na bound 65536
if ne get a i get b i
ret false
end
end
ret true
end

fn bc_bytes_contains hay view uchar * needle view uchar * to bool
hn = len hay
nn = len needle
if eq nn 0
ret true
end
if gt nn hn
ret false
end
limit = add sub hn nn 1
for i ulong limit bound 65536
matched = true
for j ulong nn bound 4096
if ne get hay add i j get needle j
matched = false
break
end
end
if matched
ret true
end
end
ret false
end

fn bc_hex_nibble n uchar to uchar
v = and n 15
if lt v 10
ret add v 48
end
ret add v 87
end

fn bc_bytes_to_hex src view uchar * dst edit uchar * to ulong
n = len src
need = mul n 2
if lt len dst need
ret 0
end
for i ulong n bound 4096
b = get src i
put dst mul i 2 bc_hex_nibble shr b 4
put dst add mul i 2 1 bc_hex_nibble and b 15
end
ret need
end

note ============================================================================
note Section 2: Bounded wcslen (wcslen.rs)
note ============================================================================

fn bc_wide_len s view ushort * to ulong
n = len s
for i ulong n bound 65536
if eq get s i 0
ret i
end
end
ret n
end

note ============================================================================
note Section 3: Rollback Mock (rollback_mock.rs)
note ============================================================================

fn bc_dp_node_match_role dp view uchar * off ulong node_len ulong to ulong
note Extracts low ASCII bytes of UTF-16LE file path node, lowercases, checks default/candidate
if le node_len 4
ret BC_ROLE_STAGER
end
data_bytes = sub node_len 4
chars = div data_bytes 2
if gt chars 128
chars = ulong 128
end
tmp = new uchar 128 0
for i ulong chars bound 128
pos = add add off 4 mul i 2
ch = get dp pos
put tmp i bc_ascii_lower ch
end
if bc_bytes_contains part tmp 0 chars bc_rb_str_default
ret BC_ROLE_DEFAULT_OS
end
if bc_bytes_contains part tmp 0 chars bc_rb_str_candidate
ret BC_ROLE_CANDIDATE
end
ret BC_ROLE_STAGER
end

fn bc_dp_detect_role dp view uchar * to ulong
total = len dp
off = ulong 0
while lt off total bound 1024
if lt sub total off 4
ret BC_ROLE_STAGER
end
dtype = get dp off
stype = get dp add off 1
nlen = ulong bc_get_u16_le dp add off 2
if lt nlen 4
ret BC_ROLE_STAGER
end
if gt nlen sub total off
ret BC_ROLE_STAGER
end
if eq dtype BC_DP_TYPE_END
if eq stype BC_DP_SUBTYPE_END_ENTIRE
ret BC_ROLE_STAGER
end
end
if eq dtype BC_DP_TYPE_MEDIA
if eq stype BC_DP_SUBTYPE_FILE_PATH
r = bc_dp_node_match_role dp off nlen
if ne r BC_ROLE_STAGER
ret r
end
end
end
off = add off nlen
end
ret BC_ROLE_STAGER
end

fn bc_dp_prefix_len dp view uchar * to ulong
total = len dp
off = ulong 0
while lt off total bound 1024
if lt sub total off 4
ret 0
end
dtype = get dp off
stype = get dp add off 1
nlen = ulong bc_get_u16_le dp add off 2
if lt nlen 4
ret 0
end
if gt nlen sub total off
ret 0
end
if eq dtype BC_DP_TYPE_MEDIA
if eq stype BC_DP_SUBTYPE_FILE_PATH
ret off
end
end
if eq dtype BC_DP_TYPE_END
if eq stype BC_DP_SUBTYPE_END_ENTIRE
ret off
end
end
off = add off nlen
end
ret off
end

fn bc_rollback_parse_mode buf view uchar * to ulong
if bc_bytes_contains buf bc_rb_str_fault
ret BC_MODE_FAULT
end
if bc_bytes_contains buf bc_rb_str_timeout
ret BC_MODE_TIMEOUT
end
if bc_bytes_contains buf bc_rb_str_absent
ret BC_MODE_ABSENT
end
if bc_bytes_contains buf bc_rb_str_malformed
ret BC_MODE_MALFORMED
end
if bc_bytes_contains buf bc_rb_str_real_aienos
ret BC_MODE_REAL_AIENOS
end
ret BC_MODE_NORMAL
end

fn bc_build_file_dp prefix view uchar * path view uchar * dst edit uchar * to ulong
plen = len prefix
path_len = len path
node_len = add 4 mul 2 add path_len 1
total = add add plen node_len 4
if gt total len dst
ret 0
end
for i ulong plen bound 4096
put dst i get prefix i
end
pos = plen
put dst pos BC_DP_TYPE_MEDIA
put dst add pos 1 BC_DP_SUBTYPE_FILE_PATH
bc_put_u16_le dst add pos 2 ushort and node_len 65535
pos = add pos 4
for i ulong path_len bound 4096
put dst pos get path i
put dst add pos 1 0
pos = add pos 2
end
put dst pos 0
put dst add pos 1 0
pos = add pos 2
put dst pos BC_DP_TYPE_END
put dst add pos 1 BC_DP_SUBTYPE_END_ENTIRE
bc_put_u16_le dst add pos 2 4
ret add pos 4
end

fn bc_build_load_option desc view uchar * full_dp view uchar * dst edit uchar * to ulong
dlen = len desc
fplen = len full_dp
desc_bytes = mul 2 add dlen 1
total = add add 6 desc_bytes fplen
if gt total len dst
ret 0
end
bc_put_u32_le dst 0 BC_LOAD_OPTION_ACTIVE
bc_put_u16_le dst 4 ushort and fplen 65535
pos = ulong 6
for i ulong dlen bound 4096
put dst pos get desc i
put dst add pos 1 0
pos = add pos 2
end
put dst pos 0
put dst add pos 1 0
pos = add pos 2
for i ulong fplen bound 4096
put dst pos get full_dp i
pos = add pos 1
end
ret pos
end

fn bc_rollback_init st edit ulong 9 to void
for i ulong 9
put st i 0
end
put st BC_RB_BOOT_CURRENT BC_BOOT_INVALID
end

fn bc_rollback_stager st edit ulong 9 mode ulong prefix_len ulong to ulong
note mode is recorded by caller when selecting candidate path; stager stages Boot0001/BootOrder/Boot0000/BootNext
if eq prefix_len 0
ret BC_RB_ACTION_UNSUPPORTED
end
if gt mode BC_MODE_REAL_AIENOS
ret BC_RB_ACTION_UNSUPPORTED
end
put st BC_RB_BOOT0001_SET 1
put st BC_RB_BOOT_ORDER_0 BC_BOOT_DEFAULT
put st BC_RB_BOOT_ORDER_VALID 1
put st BC_RB_BOOT0000_SET 1
put st BC_RB_BOOT_NEXT BC_BOOT_CANDIDATE
put st BC_RB_BOOT_NEXT_PRESENT 1
put st BC_RB_CYCLE 0
ret BC_RB_ACTION_COLD_RESET_OK
end

fn bc_rollback_firmware_boot st edit ulong 9 to ulong
note Simulates UEFI BDS: BootNext is consumed once, otherwise BootOrder[0] boots
if ne get st BC_RB_BOOT_NEXT_PRESENT 0
target = get st BC_RB_BOOT_NEXT
put st BC_RB_BOOT_NEXT_PRESENT 0
put st BC_RB_BOOT_CURRENT target
ret target
end
if ne get st BC_RB_BOOT_ORDER_VALID 0
target = get st BC_RB_BOOT_ORDER_0
put st BC_RB_BOOT_CURRENT target
ret target
end
put st BC_RB_BOOT_CURRENT BC_BOOT_INVALID
ret BC_BOOT_INVALID
end

fn bc_rollback_candidate st edit ulong 9 mode ulong to ulong
note Candidate checks mode and returns reset/hang action
if eq mode BC_MODE_FAULT
ret BC_RB_ACTION_COLD_RESET_ABORT
end
if eq mode BC_MODE_TIMEOUT
ret BC_RB_ACTION_HANG
end
ret BC_RB_ACTION_COLD_RESET_OK
end

fn bc_rollback_default st edit ulong 9 to ulong
next_consumed = eq get st BC_RB_BOOT_NEXT_PRESENT 0
order_ok = false
if ne get st BC_RB_BOOT_ORDER_VALID 0
if eq get st BC_RB_BOOT_ORDER_0 BC_BOOT_DEFAULT
order_ok = true
end
end
mask = ulong 0
if next_consumed
mask = or mask 1
end
if order_ok
mask = or mask 2
end
put st BC_RB_INVARIANT_MASK mask
cycle = get st BC_RB_CYCLE
if eq cycle 0
put st BC_RB_CYCLE 1
ret BC_RB_ACTION_COLD_RESET_REPEAT
end
if eq mask 3
ret BC_RB_ACTION_SHUTDOWN_PASS
end
ret BC_RB_ACTION_FAIL
end

note ============================================================================
note Section 4: Store Qualification & Bounded NVMe (store_qual.rs)
note ============================================================================

fn bc_is_recovery_mode mode uchar to bool
if eq mode BC_MODE_RECOVERY_INSPECT
ret true
end
if eq mode BC_MODE_RECOVERY_REPAIR
ret true
end
if eq mode BC_MODE_RECOVERY_PROVISION
ret true
end
ret false
end

fn bc_is_continuity_mode mode uchar to bool
if eq mode BC_MODE_CONT_PROVISION
ret true
end
if eq mode BC_MODE_CONT_RESUME
ret true
end
if eq mode BC_MODE_CONT_REMEMBER
ret true
end
if eq mode BC_MODE_CONT_CRASH
ret true
end
ret false
end

fn bc_is_512_qual_mode mode uchar to bool
if eq mode BC_MODE_RUN_512B
ret true
end
if eq mode BC_MODE_VERIFY_512B
ret true
end
ret false
end

fn bc_store_config_lba block_size uint to ulong
if eq block_size 512
ret BC_CONFIG_LBA_512
end
if eq block_size 4096
ret BC_CONFIG_LBA
end
ret 0
end

fn bc_store_region_base is_512 bool to ulong
if is_512
ret BC_STORE_BASE_LBA_512
end
ret BC_STORE_BASE_LBA
end

fn bc_store_region_blocks is_512 bool to ulong
if is_512
ret BC_STORE_REGION_BLOCKS_512
end
ret BC_STORE_REGION_BLOCKS
end

fn bc_bounded_nvme_init dev edit ulong 3 block_size uint base_lba ulong blocks ulong to void
put dev 0 ulong block_size
put dev 1 base_lba
put dev 2 blocks
end

fn bc_bounded_nvme_translate dev view ulong 3 lba ulong buf_len ulong dst_lba edit ulong 1 to int
bs = get dev 0
base_lba = get dev 1
blocks = get dev 2
if eq bs 0
ret BC_BLK_ERR_INVALID_INPUT
end
if ne rem buf_len bs 0
ret BC_BLK_ERR_INVALID_INPUT
end
cnt = div buf_len bs
if gt lba blocks
ret BC_BLK_ERR_OUT_OF_RANGE
end
if gt cnt sub blocks lba
ret BC_BLK_ERR_OUT_OF_RANGE
end
put dst_lba 0 add base_lba lba
ret BC_BLK_OK
end

fn bc_store_qual_check_geometry block_size uint mode uchar block_count ulong atomic_ok bool to int
if ne block_size 512
if ne block_size 4096
ret BC_QUAL_ERR_BLOCK_SIZE
end
end
is_512 = bc_is_512_qual_mode mode
if is_512
if ne block_size 512
ret BC_QUAL_ERR_512_NEEDS_512
end
else
if ne block_size 4096
ret BC_QUAL_ERR_4096_REQUIRED
end
if not atomic_ok
ret BC_QUAL_ERR_NOT_ATOMIC
end
end
base_lba = bc_store_region_base is_512
region_blocks = bc_store_region_blocks is_512
if gt base_lba block_count
ret BC_QUAL_ERR_REGION_OOB
end
if gt region_blocks sub block_count base_lba
ret BC_QUAL_ERR_REGION_OOB
end
ret BC_QUAL_OK
end

fn bc_store_reopen_gen_valid generation ulong settle uchar to bool
upper = add ulong settle 2
if lt generation 1
ret false
end
if gt generation upper
ret false
end
ret true
end

fn bc_store_slot_reuse_proven generation ulong settle uchar to bool
if ge settle 3
if ge generation 4
ret true
end
end
ret false
end

note ============================================================================
note Section 5: NVMe Read, DMA Gate & Arena (nvme_read.rs)
note ============================================================================

fn bc_pci_requester_id bus ulong dev ulong fun ulong to uint
b = shl and uint bus 255 8
d = shl and uint dev 31 3
f = and uint fun 7
ret or or b d f
end

fn bc_pci_bme_enabled cmd ushort to bool
ret ne and cmd BC_PCI_BME_BIT 0
end

fn bc_pci_without_bme cmd ushort to ushort
ret and cmd 0xfffb
end

fn bc_pci_with_bme cmd ushort to ushort
ret or cmd BC_PCI_BME_BIT
end

fn bc_dma_grant smmu_ready bool has_smmu bool unsafe_bypass bool to int
if smmu_ready
if has_smmu
ret BC_DMA_GRANT_CONFINED
end
end
if has_smmu
ret BC_DMA_DENIED_SMMU_NOT_READY
end
if unsafe_bypass
ret BC_DMA_GRANT_UNSAFE_BYPASS
end
ret BC_DMA_DENIED_NO_SMMU
end

fn bc_nvme_decode_bar class_reg uint bar_low uint bar_high uint to ulong
cc = shr class_reg 16
if ne cc BC_NVME_CLASS_CODE
ret 0
end
if ne and bar_low 1 0
ret 0
end
lo = ulong and bar_low 0xfffffff0
if eq and bar_low 7 4
ret or shl ulong bar_high 32 lo
end
ret lo
end

fn bc_dma_arena_init arena edit ulong 3 base ulong size ulong to void
put arena 0 base
put arena 1 base
put arena 2 add base size
end

fn bc_dma_arena_alloc arena edit ulong 3 size ulong align ulong dst_phys edit ulong 1 to int
if eq align 0
ret -1
end
mask = sub align 1
if ne and align mask 0
ret -1
end
cur = get arena 1
end_addr = get arena 2
if gt cur sub 0xffffffffffffffff mask
ret -1
end
aligned = and add cur mask xor mask 0xffffffffffffffff
if gt aligned end_addr
ret -1
end
if gt size sub end_addr aligned
ret -1
end
put arena 1 add aligned size
put dst_phys 0 aligned
ret 0
end

fn bc_dma_arena_offset arena view ulong 3 phys ulong req_len ulong dst_off edit ulong 1 to int
base = get arena 0
end_addr = get arena 2
if lt phys base
ret -1
end
if ge phys end_addr
ret -1
end
off = sub phys base
avail = sub end_addr phys
if gt req_len avail
ret -1
end
put dst_off 0 off
ret 0
end

fn bc_nvme_fill_sector_pattern buf edit uchar * magic view uchar * to bool
if ne len buf 512
ret false
end
if ne len magic 16
ret false
end
for c ulong 32
base = mul c 16
for i ulong 16
put buf add base i get magic i
end
end
ret true
end

fn bc_nvme_verify_sector_pattern buf view uchar * magic view uchar * to bool
if ne len buf 512
ret false
end
if ne len magic 16
ret false
end
for c ulong 32
base = mul c 16
for i ulong 16
if ne get buf add base i get magic i
ret false
end
end
end
ret true
end

fn bc_nvme_sector_sha256_hex buf view uchar * hex_dst edit uchar * to ulong
dig = new uchar 32 0
dlen = sha2_digest 256 buf dig
if ne dlen 32
ret 0
end
ret bc_bytes_to_hex dig hex_dst
end

fn bc_continuity_hash_statement ctx edit ulong * stmt view uchar * to void
lbuf = new uchar 4 0
bc_put_u32_le lbuf 0 uint and len stmt 0xffffffff
sha256_update ctx lbuf
sha256_update ctx stmt
end

note ============================================================================
note Section 6: USB Keyboard & xHCI (usb_keyboard.rs)
note ============================================================================

fn bc_xhci_mmio_base class_reg uint bar_low uint bar_high uint to ulong
if ne shr class_reg 8 BC_XHCI_CLASS_PROGIF
ret 0
end
if ne and bar_low 1 0
ret 0
end
lo = ulong and bar_low 0xfffffff0
if eq and bar_low 6 4
ret or shl ulong bar_high 32 lo
end
ret lo
end

fn bc_hid_digit_ascii code uchar shifted bool to uchar
note HID usages 0x1e..0x27 -> '1'..'9','0' or '!','@','#','$','%','^','&','*','(',')'
if not shifted
if eq code 0x27
ret 48
end
ret add 49 sub code 0x1e
end
if eq code 0x1e
ret 33
end
if eq code 0x1f
ret 64
end
if eq code 0x20
ret 35
end
if eq code 0x21
ret 36
end
if eq code 0x22
ret 37
end
if eq code 0x23
ret 94
end
if eq code 0x24
ret 38
end
if eq code 0x25
ret 42
end
if eq code 0x26
ret 40
end
ret 41
end

fn bc_hid_punct_ascii code uchar shifted bool to uchar
note HID usages 0x2d..0x38
if eq code 0x2d
if shifted
ret 95
end
ret 45
end
if eq code 0x2e
if shifted
ret 43
end
ret 61
end
if eq code 0x2f
if shifted
ret 123
end
ret 91
end
if eq code 0x30
if shifted
ret 125
end
ret 93
end
if eq code 0x31
if shifted
ret 124
end
ret 92
end
if eq code 0x33
if shifted
ret 58
end
ret 59
end
if eq code 0x34
if shifted
ret 34
end
ret 39
end
if eq code 0x35
if shifted
ret 126
end
ret 96
end
if eq code 0x36
if shifted
ret 60
end
ret 44
end
if eq code 0x37
if shifted
ret 62
end
ret 46
end
if eq code 0x38
if shifted
ret 63
end
ret 47
end
ret 0
end

fn bc_hid_keycode_to_ascii code uchar shifted bool to uchar
if ge code 0x04
if le code 0x1d
if shifted
ret add 65 sub code 0x04
end
ret add 97 sub code 0x04
end
end
if ge code 0x1e
if le code 0x27
ret bc_hid_digit_ascii code shifted
end
end
if eq code 0x2c
ret 32
end
if ge code 0x2d
if le code 0x38
ret bc_hid_punct_ascii code shifted
end
end
ret 0
end

fn bc_hid_prev_contains prev view uchar 6 code uchar to bool
for i ulong 6
if eq get prev i code
ret true
end
end
ret false
end

fn bc_hid_decode_report prev edit uchar 6 report view uchar 8 ev_kinds edit uchar 6 ev_chars edit uchar 6 to ulong
note Ignore ErrorRollOver (0x01) reports without modifying prev
for i ulong 6
if eq get report add i 2 0x01
ret 0
end
end
mod_byte = get report 0
shifted = ne and mod_byte 0x22 0
ev_cnt = ulong 0
for i ulong 6
code = get report add i 2
if ne code 0
if not bc_hid_prev_contains prev code
if eq code 0x28
put ev_kinds ev_cnt BC_KEY_ENTER
put ev_chars ev_cnt 0
ev_cnt = add ev_cnt 1
else
if eq code 0x2a
put ev_kinds ev_cnt BC_KEY_BACKSPACE
put ev_chars ev_cnt 0
ev_cnt = add ev_cnt 1
else
ch = bc_hid_keycode_to_ascii code shifted
if ne ch 0
put ev_kinds ev_cnt BC_KEY_CHAR
put ev_chars ev_cnt ch
ev_cnt = add ev_cnt 1
end
end
end
end
end
end
for i ulong 6
put prev i get report add i 2
end
ret ev_cnt
end

fn bc_kb_line_apply line edit uchar * line_len edit ulong 1 ev_kind uchar ev_char uchar to ulong
cur = get line_len 0
if eq ev_kind BC_KEY_ENTER
ret 1
end
if eq ev_kind BC_KEY_BACKSPACE
if gt cur 0
put line_len 0 sub cur 1
end
ret 0
end
if eq ev_kind BC_KEY_CHAR
if ge ev_char 0x20
if le ev_char 0x7e
if lt cur len line
put line cur ev_char
put line_len 0 add cur 1
end
end
end
end
ret 0
end

fn bc_kb_stop_reason exited bool halted bool to ulong
if exited
ret BC_KB_DONE_EXIT
end
if halted
ret BC_KB_DONE_HALTED
end
ret BC_KB_DONE_TIMEOUT
end

note ============================================================================
note Section 7: Handoff Logic (handoff.rs)
note ============================================================================

fn bc_heap_init heap edit ulong 3 base ulong cap ulong to void
put heap 0 base
put heap 1 0
put heap 2 cap
end

fn bc_heap_alloc heap edit ulong 3 size ulong align ulong dst_addr edit ulong 1 to int
base = get heap 0
used = get heap 1
cap = get heap 2
if eq base 0
ret -1
end
if eq align 0
ret -1
end
mask = sub align 1
if ne and align mask 0
ret -1
end
if gt used sub 0xffffffffffffffff base
ret -1
end
cur = add base used
if gt cur sub 0xffffffffffffffff mask
ret -1
end
aligned = and add cur mask xor mask 0xffffffffffffffff
if gt size sub 0xffffffffffffffff aligned
ret -1
end
nxt = sub add aligned size base
if gt nxt cap
ret -1
end
put heap 1 nxt
put dst_addr 0 aligned
ret 0
end

fn bc_smmu_validate tables_addr ulong stream_id uint to bool
if eq tables_addr 0
ret false
end
if ne rem tables_addr BC_SMMU_TABLES_ALIGN 0
ret false
end
if ge stream_id BC_SMMU_STREAM_ENTRIES
ret false
end
ret true
end

fn bc_mat_header_length hdr view uchar * to ulong
if lt len hdr 16
ret 0
end
cnt = ulong bc_get_u32_le hdr 4
stride = ulong bc_get_u32_le hdr 8
if gt cnt 1048576
ret 0
end
if gt stride 1048576
ret 0
end
prod = mul cnt stride
if gt prod 1048560
ret 0
end
ret add 16 prod
end

fn bc_page_align_range base ulong size ulong dst edit ulong 2 to bool
page_off = and base 4095
start = sub base page_off
if gt size sub 0xffffffffffffffff page_off
ret false
end
span = add size page_off
if gt span 0xfffffffffffff000
ret false
end
aligned_len = and add span 4095 xor ulong 4095 0xffffffffffffffff
put dst 0 start
put dst 1 aligned_len
ret true
end

fn bc_mmu_switched el ulong mmu_on bool ttbr0_el1 ulong fw_ttbr0 ulong kroot ulong to bool
if ne el 1
ret false
end
if not mmu_on
ret false
end
el1_base = and ttbr0_el1 BC_TTBR_BADDR_MASK
fw_base = and fw_ttbr0 BC_TTBR_BADDR_MASK
if ne el1_base kroot
ret false
end
if eq el1_base fw_base
ret false
end
ret true
end

fn bc_timer_ticks_to_us counter ulong freq_hz ulong to ulong
if eq freq_hz 0
ret 0
end
q = div counter freq_hz
r = rem counter freq_hz
note Compute (q * 1000000) + (r * 1000000) / freq_hz without u64 overflow for normal rates
ret add mul q 1000000 div mul r 1000000 freq_hz
end

fn bc_var_budget_init b edit ulong 3 max_writes ulong max_bytes ulong to void
put b 0 0
put b 1 max_writes
put b 2 max_bytes
end

fn bc_var_budget_try_write b edit ulong 3 msg_len ulong to int
if gt msg_len get b 2
ret BC_VAR_ERR_TOO_LARGE
end
n = get b 0
put b 0 add n 1
if ge n get b 1
ret BC_VAR_ERR_BUDGET_SPENT
end
ret int add n 1
end

fn bc_artifact_name_valid wide view ushort * dst edit uchar * to ulong
wlen = bc_wide_len wide
if le wlen 5
ret 0
end
if gt wlen BC_ARTIFACT_NAME_BYTES
ret 0
end
if lt len dst wlen
ret 0
end
for i ulong wlen bound 32
u = get wide i
if lt u 0x21
ret 0
end
if gt u 0x7e
ret 0
end
put dst i uchar and u 255
end
tail = sub wlen 5
for i ulong 5
c1 = bc_ascii_lower get dst add tail i
c2 = get bc_artifact_suffix i
if ne c1 c2
ret 0
end
end
ret wlen
end

fn bc_artifact_oversize size ulong to bool
ret gt size BC_MAX_ARTIFACT_FILE_BYTES
end

fn bc_artifact_name_lt a view uchar * entries view uchar * idx ulong to bool
a_len = len a
off = mul idx BC_ARTIFACT_STRIDE
b_len = bc_get_u64_le entries add off 32
n = a_len
if lt b_len n
n = b_len
end
for i ulong n bound 32
ca = get a i
cb = get entries add off i
if lt ca cb
ret true
end
if gt ca cb
ret false
end
end
ret lt a_len b_len
end

fn bc_artifact_copy_entry entries edit uchar * dst_idx ulong src_idx ulong to void
doff = mul dst_idx BC_ARTIFACT_STRIDE
soff = mul src_idx BC_ARTIFACT_STRIDE
for i ulong BC_ARTIFACT_STRIDE
put entries add doff i get entries add soff i
end
end

fn bc_artifact_write_entry entries edit uchar * idx ulong name view uchar * size ulong to void
off = mul idx BC_ARTIFACT_STRIDE
nlen = len name
for i ulong 32
if lt i nlen
put entries add off i get name i
else
put entries add off i 0
end
end
bc_put_u64_le entries add off 32 nlen
bc_put_u64_le entries add off 40 size
end

fn bc_artifact_insert_sorted entries edit uchar * meta edit ulong 2 new_name view uchar * new_size ulong to ulong
note entries holds up to 48 records of 48 bytes (2304 bytes total); meta[0]=count, meta[1]=ignored
cnt = get meta 0
ign = get meta 1
ins_pos = cnt
for i ulong cnt bound 48
if bc_artifact_name_lt new_name entries i
ins_pos = i
break
end
end
if eq ins_pos BC_MAX_ARTIFACT_CANDIDATES
put meta 1 add ign 1
ret cnt
end
if eq cnt BC_MAX_ARTIFACT_CANDIDATES
put meta 1 add ign 1
else
cnt = add cnt 1
put meta 0 cnt
end
if gt cnt add ins_pos 1
steps = sub sub cnt 1 ins_pos
for s ulong steps bound 48
dst_idx = sub sub cnt 1 s
bc_artifact_copy_entry entries dst_idx sub dst_idx 1
end
end
bc_artifact_write_entry entries ins_pos new_name new_size
ret cnt
end

fn bc_rsdp_xsdt_addr rsdp view uchar * to ulong
if lt len rsdp 36
ret 0
end
for i ulong 8
if ne get rsdp i get bc_rsdp_sig i
ret 0
end
end
ret bc_get_u64_le rsdp 24
end

fn bc_stage_valid s ulong to bool
ret lt s BC_STAGE_COUNT
end

fn bc_el0_report_ok write_ok bool forged_denied bool fault_contained bool exit_code int to bool
if not write_ok
ret false
end
if not forged_denied
ret false
end
if not fault_contained
ret false
end
ret eq exit_code 0
end

fn bc_preempt_ok a ulong b ulong switches ulong to bool
if eq a 0
ret false
end
if eq b 0
ret false
end
ret ge switches 4
end

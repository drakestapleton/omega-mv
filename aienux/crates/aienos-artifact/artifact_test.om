const FIX_RES_OFF ulong 240
const FIX_PAY_OFF ulong 288
const FIX_SIG_OFF ulong 296
const FIX_TOTAL ulong 396

text t_hex_digits "0123456789abcdef"
text t_data_bytes "DATA"
text t_gold_req "adf96aa3e792b1d4a48fe925532efe34ff2a82fe7c07ce013d6daa8bfecb28db"
text t_gold_res "02f22c42bc7fff8143e11d282f2cfc7773fc483356a5ad9861c937cc6484a3e5"
text t_gold_pay "f9f5b6ad6a7b931afdce57c59c806df4971c31d72ef560cd7a140d34aba19758"
text t_gold_aid "71976b5c38ec15f2307565ed3eea51fde4a5375970cd49338d6e16166238cf4b"
text t_gold_rcp_adm "16bcbe523a62d9f4c907729fb2fb09d630ce36f80d7169e202730173a59bdfdc"
text t_gold_rcp_rej "f12ebace5ec0f2a8f06c415d58d936389dcc2fed64dbed4bc91efd01a734a6a3"
text t_commit_ok "71cb1703484cbc9d56eabe43402a6f9bf62b1028"
text t_commit_up "71CB1703484CBC9D56EABE43402A6F9BF62B1028"
text t_commit_bad "71cb1703484cbc9d56eabe43402a6f9bf62b102g"
text t_lbl_pi5 "SEED-0B-PI5"
text t_gold_rec_hdr "4149454e52435000000060000002000000000000010001000100000000000000e28b2fcc80dd4e973fbc3d13dc62801b000000000000000000000000000000000100000000000000ff000000000000000800000002000000050000000a000000"

fn t_hex_eq raw view uchar * hex_str view uchar * to bool
n = len raw
if ne mul n 2 len hex_str
ret false
end
for i ulong n bound 512
b = ulong get raw i
hi = get t_hex_digits shr b 4
lo = get t_hex_digits and b 15
if ne hi get hex_str mul i 2
ret false
end
if ne lo get hex_str add mul i 2 1
ret false
end
end
ret true
end

fn t_pattern seed uchar dst edit uchar * to void
for i ulong 32
put dst i uchar and add ulong seed i 0xff
end
end


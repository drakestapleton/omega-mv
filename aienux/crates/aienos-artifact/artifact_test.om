note Build canonical 396-byte Binary Artifact v0 fixture (tests.rs: fixture())
fn t_build_fixture buf edit uchar * to void
for i ulong FIX_TOTAL
put buf i 0
end
for i ulong 7
put buf i get art_magic_pfx i
end
put buf 7 0
art_put_u16_le buf 8 0
art_put_u16_le buf 10 128
art_put_u16_le buf 12 1
art_put_u16_le buf 14 1
art_put_u32_le buf 20 FIX_TOTAL
art_put_u32_le buf 24 128
art_put_u16_le buf 28 2
art_put_u16_le buf 30 32
art_put_u16_le buf 32 0
art_put_u32_le buf 36 0
art_put_u32_le buf 40 ART_CAPABILITY_TABLE_OFFSET
art_put_u16_le buf 44 1
art_put_u16_le buf 46 48
art_put_u32_le buf 48 FIX_RES_OFF
art_put_u16_le buf 52 48
art_put_u32_le buf 56 FIX_PAY_OFF
art_put_u32_le buf 60 8
art_put_u32_le buf 64 FIX_SIG_OFF
art_put_u16_le buf 68 100
art_put_u16_le buf 70 1
note Code section: AArch64 RET, RX
art_put_u16_le buf 128 1
art_put_u16_le buf 130 5
art_put_u32_le buf 136 0
art_put_u32_le buf 140 4
art_put_u32_le buf 144 4
art_put_u32_le buf 148 4096
note Data section: 4 initialized bytes, 1 page reserved, RW
art_put_u16_le buf 160 2
art_put_u16_le buf 162 3
art_put_u32_le buf 168 4
art_put_u32_le buf 172 4
art_put_u32_le buf 176 4096
art_put_u32_le buf 180 4096
note Scoped READ capability for object 7, bytes [0, 4)
art_put_u16_le buf 192 3
art_put_u32_le buf 196 7
art_put_u32_le buf 200 ART_RIGHT_READ
art_put_u32_le buf 204 1
art_put_u32_le buf 208 4
art_put_u64_le buf 216 4
art_put_u64_le buf 224 0
art_put_u64_le buf 232 4
note Resource envelope
art_put_u32_le buf FIX_RES_OFF 1
art_put_u32_le buf add FIX_RES_OFF 4 1
art_put_u32_le buf add FIX_RES_OFF 8 1
art_put_u16_le buf add FIX_RES_OFF 12 1
art_put_u32_le buf add FIX_RES_OFF 16 2
art_put_u32_le buf add FIX_RES_OFF 20 16
art_put_u64_le buf add FIX_RES_OFF 24 1000
art_put_u64_le buf add FIX_RES_OFF 32 2000
art_put_u32_le buf add FIX_RES_OFF 40 16
note Payload: RET + "DATA"
put buf FIX_PAY_OFF 0xc0
put buf add FIX_PAY_OFF 1 0x03
put buf add FIX_PAY_OFF 2 0x5f
put buf add FIX_PAY_OFF 3 0xd6
for i ulong 4
put buf add add FIX_PAY_OFF 4 i get t_data_bytes i
end
note Signature block placeholder
art_put_u16_le buf FIX_SIG_OFF 1
for i ulong 32
put buf add add FIX_SIG_OFF 4 i 0xa5
end
for i ulong 64
put buf add add FIX_SIG_OFF 36 i 0x5a
end
end

note Populate admitted() receipt in globals (receipt_tests.rs)
fn t_load_admitted to void
rcp_clear
put rcp_scalars 0 0
put rcp_scalars 1 RCP_DEC_ADMITTED
put rcp_scalars 2 RCP_TIER_QEMU
put rcp_scalars 3 1
put rcp_scalars 4 0
put rcp_scalars 5 RCP_EXEC_EXITED
put rcp_exit_status 0 0
put rcp_scalars 6 RCP_VALID_RES_FLAGS
put rcp_scalars 7 0
put rcp_scalars 8 0
put rcp_scalars 9 8
put rcp_scalars 10 2
put rcp_scalars 11 5
put rcp_scalars 12 10
d = new uchar 32 0
t_pattern 0x10 d
rcp_set_digest 0 d
t_pattern 0x20 d
rcp_set_digest 1 d
t_pattern 0x30 d
rcp_set_digest 2 d
t_pattern 0x40 d
rcp_set_digest 3 d
t_pattern 0x50 d
rcp_set_digest 4 d
t_pattern 0x60 d
rcp_set_digest 5 d
t_pattern 0x70 d
rcp_set_digest 6 d
t_pattern 0x80 d
rcp_set_digest 7 d
nb = new uchar 16 0
rcp_nonce d 1 nb
for i ulong 16
put rcp_nonce_buf i get nb i
end
end

note Populate rejected() receipt in globals (receipt_tests.rs)
fn t_load_rejected to void
t_load_admitted
put rcp_scalars 1 RCP_DEC_REJECTED
put rcp_scalars 3 2
put rcp_scalars 5 RCP_EXEC_NOT_RUN
put rcp_exit_status 0 0
put rcp_scalars 6 RCP_RES_RECLAIMED
put rcp_scalars 7 3
put rcp_scalars 8 ulong ART_ERR_BAD_SIGNATURE
put rcp_scalars 9 0
put rcp_scalars 10 0
put rcp_scalars 11 0
put rcp_scalars 12 0
z = new uchar 32 0
rcp_set_digest 2 z
rcp_set_digest 5 z
vid = new uchar 32 0
rcp_get_digest 7 vid
nb = new uchar 16 0
rcp_nonce vid 2 nb
for i ulong 16
put rcp_nonce_buf i get nb i
end
end

note Test group 1: Canonical artifact parsing, slices, and exact golden SHA-256 digests
fn test_artifact_canonical to int
buf = new uchar 396 0
t_build_fixture buf
if ne art_parse_and_identify buf ART_OK
ret 1
end
if or ne get art_meta 0 1 ne get art_meta 1 1
ret 2
end
if or ne get art_meta 2 0 ne get art_meta 4 1
ret 3
end
if or ne get art_caps 1 7 ne get art_caps 2 ART_RIGHT_READ
ret 4
end
if or ne get art_res 0 1 ne get art_meta 10 FIX_SIG_OFF
ret 5
end
d_req = new uchar 32 0
d_grt = new uchar 32 0
d_res = new uchar 32 0
art_requested_cap_digest part buf ART_CAPABILITY_TABLE_OFFSET 48 d_req
art_granted_cap_digest part buf ART_CAPABILITY_TABLE_OFFSET 48 d_grt
art_resource_envelope_digest part buf FIX_RES_OFF 48 d_res
if art_bytes_eq d_req d_grt
ret 6
end
if not t_hex_eq d_req t_gold_req
ret 7
end
if not t_hex_eq d_res t_gold_res
ret 8
end
pd = new uchar 32 0
aid = new uchar 32 0
for i ulong 32
put pd i get art_payload_dig i
put aid i get art_id i
end
if not t_hex_eq pd t_gold_pay
ret 9
end
if not t_hex_eq aid t_gold_aid
ret 10
end
note Every truncation 0..395 must fail
for n ulong FIX_TOTAL
if eq art_parse part buf 0 n ART_OK
ret 11
end
end
ret 0
end

note Test group 2: Header, length, section, entry, capability, resource, reserved mutations
fn test_artifact_mutations to int
buf = new uchar 396 0
t_build_fixture buf
put buf 0 xor get buf 0 1
if ne art_parse buf ART_ERR_BAD_MAGIC
ret 12
end
t_build_fixture buf
art_put_u16_le buf 8 1
if ne art_parse buf ART_ERR_UNSUPPORTED_VERSION
ret 13
end
t_build_fixture buf
art_put_u16_le buf 12 2
if ne art_parse buf ART_ERR_WRONG_TARGET
ret 14
end
t_build_fixture buf
art_put_u16_le buf 14 2
if ne art_parse buf ART_ERR_WRONG_ABI
ret 15
end
t_build_fixture buf
art_put_u32_le buf 20 sub FIX_TOTAL 1
if ne art_parse buf ART_ERR_WRONG_LENGTH
ret 16
end
t_build_fixture buf
art_put_u32_le buf 64 0xfffffff0
rc = art_parse buf
if and ne rc ART_ERR_SECTION_OVERLAP ne rc ART_ERR_LENGTH_OVERFLOW
ret 17
end
t_build_fixture buf
art_put_u32_le buf 16 1
if ne art_parse buf ART_ERR_UNSUPPORTED_FLAGS
ret 18
end
t_build_fixture buf
art_put_u32_le buf 168 0
if ne art_parse buf ART_ERR_BAD_SECTION
ret 19
end
t_build_fixture buf
art_put_u32_le buf 36 4
if ne art_parse buf ART_ERR_BAD_ENTRY_POINT
ret 20
end
t_build_fixture buf
art_put_u32_le buf 200 or ART_RIGHT_READ 0x40
if ne art_parse buf ART_ERR_MALFORMED_CAPABILITY
ret 21
end
t_build_fixture buf
art_put_u64_le buf 224 0xffffffffffffffff
if ne art_parse buf ART_ERR_LENGTH_OVERFLOW
ret 22
end
t_build_fixture buf
art_put_u32_le buf FIX_RES_OFF 65
if ne art_parse buf ART_ERR_RESOURCE_LIMIT
ret 23
end
t_build_fixture buf
art_put_u64_le buf add FIX_RES_OFF 24 1000000001
if ne art_parse buf ART_ERR_RESOURCE_LIMIT
ret 24
end
t_build_fixture buf
put buf 34 1
if ne art_parse buf ART_ERR_UNSUPPORTED_VERSION
ret 25
end
t_build_fixture buf
put buf 194 1
if ne art_parse buf ART_ERR_RESERVED_NON_ZERO
ret 26
end
t_build_fixture buf
put buf add FIX_RES_OFF 14 1
if ne art_parse buf ART_ERR_RESERVED_NON_ZERO
ret 27
end
t_build_fixture buf
art_put_u16_le buf 44 17
if ne art_parse buf ART_ERR_RESOURCE_LIMIT
ret 28
end
ret 0
end

note Test group 3: Identity sensitivity, signature exclusion, attenuation, bounded fuzz
fn test_artifact_identity_and_attenuation to int
buf = new uchar 396 0
t_build_fixture buf
if ne art_parse_and_identify buf ART_OK
ret 29
end
orig_id = new uchar 32 0
orig_pd = new uchar 32 0
for i ulong 32
put orig_id i get art_id i
put orig_pd i get art_payload_dig i
end
note Payload mutation changes artifact_id and payload_digest
put buf FIX_PAY_OFF xor get buf FIX_PAY_OFF 1
if ne art_parse_and_identify buf ART_OK
ret 30
end
cur_id = new uchar 32 0
cur_pd = new uchar 32 0
for i ulong 32
put cur_id i get art_id i
put cur_pd i get art_payload_dig i
end
if or art_bytes_eq orig_id cur_id art_bytes_eq orig_pd cur_pd
ret 31
end
note Capability mutation changes artifact_id
t_build_fixture buf
art_put_u32_le buf 200 or ART_RIGHT_READ ART_RIGHT_WRITE
if ne art_parse_and_identify buf ART_OK
ret 32
end
for i ulong 32
put cur_id i get art_id i
end
if art_bytes_eq orig_id cur_id
ret 33
end
note Resource mutation changes artifact_id
t_build_fixture buf
art_put_u64_le buf add FIX_RES_OFF 24 999
if ne art_parse_and_identify buf ART_OK
ret 34
end
for i ulong 32
put cur_id i get art_id i
end
if art_bytes_eq orig_id cur_id
ret 35
end
note Signature and signer fingerprint mutations do NOT change artifact_id
t_build_fixture buf
put buf add FIX_SIG_OFF 36 xor get buf add FIX_SIG_OFF 36 1
if ne art_parse_and_identify buf ART_OK
ret 36
end
for i ulong 32
put cur_id i get art_id i
end
if not art_bytes_eq orig_id cur_id
ret 37
end
t_build_fixture buf
put buf add FIX_SIG_OFF 4 xor get buf add FIX_SIG_OFF 4 1
if ne art_parse_and_identify buf ART_OK
ret 38
end
for i ulong 32
put cur_id i get art_id i
end
if not art_bytes_eq orig_id cur_id
ret 39
end
ret 0
end

note Test group 3b: Capability attenuation, encode/decode round-trip, and bounded fuzzing
fn test_artifact_attenuation_and_fuzz to int
c_r = new ulong 8 0
put c_r 0 3
put c_r 1 7
put c_r 2 ART_RIGHT_READ
put c_r 3 1
put c_r 4 4
put c_r 5 4
put c_r 6 0
put c_r 7 4
c_rw = new ulong 8 0
for i ulong 8
put c_rw i get c_r i
end
put c_rw 2 or ART_RIGHT_READ ART_RIGHT_WRITE
c_dec = new ulong 8 0
for i ulong 8
put c_dec i get c_r i
end
if not art_cap_is_attenuation_of c_r c_dec
ret 40
end
if art_cap_is_attenuation_of c_rw c_r
ret 41
end
if not art_cap_is_attenuation_of c_r c_rw
ret 42
end
cb = new uchar 48 0
art_cap_encode c_r cb
if ne art_cap_decode cb c_dec ART_OK
ret 43
end
for i ulong 8
if ne get c_dec i get c_r i
ret 44
end
end
fuzz = new uchar 512 0
st = uint 0x9e3779b9
for flen ulong 513
for j ulong flen bound 512
st = add mul st 1664525 1013904223
put fuzz j uchar shr st 24
end
ign = art_parse part fuzz 0 flen
end
ret 0
end

note Test group 4a: RFC 8032 Ed25519 verification + signing test vector
fn test_artifact_ed25519_vec to int
pk = new uchar 32 0
art_seed0b_test_pubkey pk
s1 = new uchar 32 0
t_seed1 s1
derived = new uchar 32 0
art_ed25519_pubkey s1 derived
if not art_bytes_eq pk derived
ret 45
end
empty_buf = new uchar 1 0
vec_sig = new uchar 64 0
t_rfc8032_empty_sig vec_sig
if not art_ed25519_verify pk part empty_buf 0 0 vec_sig
ret 46
end
put vec_sig 0 xor get vec_sig 0 1
if art_ed25519_verify pk part empty_buf 0 0 vec_sig
ret 47
end
t_rfc8032_empty_sig vec_sig
gen_sig = new uchar 64 0
art_ed25519_sign s1 part empty_buf 0 0 gen_sig
if not art_bytes_eq gen_sig vec_sig
ret 48
end
ret 0
end

note Test group 4b: Seed0b artifact authentication
fn test_artifact_anchor to int
pk = new uchar 32 0
art_seed0b_test_pubkey pk
s1 = new uchar 32 0
t_seed1 s1
buf = new uchar 396 0
t_build_fixture buf
if ne art_parse_and_identify buf ART_OK
ret 49
end
aid = new uchar 32 0
for i ulong 32
put aid i get art_id i
end
msg = new uchar 61 0
art_signature_message aid msg
sig = new uchar 64 0
art_ed25519_sign s1 msg sig
fp = new uchar 32 0
art_signer_fingerprint pk fp
for i ulong 32
put buf add add FIX_SIG_OFF 4 i get fp i
end
for i ulong 64
put buf add add FIX_SIG_OFF 36 i get sig i
end
art_anchors_clear
if ne art_verify buf ART_ERR_UNTRUSTED_SIGNER
ret 50
end
if ne art_anchors_add_seed0b_test ART_OK
ret 51
end
if ne art_verify buf ART_OK
ret 52
end
if ne get art_meta 11 ART_TRUST_TIER_SEED0B_QUAL
ret 53
end
put buf add FIX_SIG_OFF 36 xor get buf add FIX_SIG_OFF 36 1
if ne art_verify buf ART_ERR_BAD_SIGNATURE
ret 54
end
put buf add FIX_SIG_OFF 36 xor get buf add FIX_SIG_OFF 36 1
put buf add FIX_SIG_OFF 4 xor get buf add FIX_SIG_OFF 4 1
if ne art_verify buf ART_ERR_UNTRUSTED_SIGNER
ret 55
end
put buf add FIX_SIG_OFF 4 xor get buf add FIX_SIG_OFF 4 1
put buf FIX_PAY_OFF xor get buf FIX_PAY_OFF 1
if ne art_verify buf ART_ERR_BAD_SIGNATURE
ret 56
end
found_pk = new uchar 32 0
if ne art_anchors_find fp found_pk ART_TRUST_TIER_SEED0B_QUAL
ret 57
end
zfp = new uchar 32 0
if ne art_anchors_find zfp found_pk ART_TRUST_TIER_NONE
ret 58
end
ret 0
end

note Test group 5a: Receipt layout and golden digests/bytes
fn test_receipt_layout_and_goldens to int
t_load_admitted
b = new uchar 512 0
if ne rcp_encode b ART_OK
ret 60
end
if not t_hex_eq part b 0 96 t_gold_rec_hdr
ret 61
end
if not art_all_zero b 352 160
ret 62
end
dig = new uchar 32 0
rcp_digest b dig
if not t_hex_eq dig t_gold_rcp_adm
ret 63
end
put rcp_exit_status 0 -2
put rcp_scalars 6 0
b2 = new uchar 512 0
if ne rcp_encode b2 ART_OK
ret 64
end
if or ne get b2 68 0xfe ne get b2 69 0xff
ret 65
end
if or ne get b2 70 0xff ne get b2 71 0xff
ret 66
end
if ne rcp_decode b2 ART_OK
ret 67
end
if ne get rcp_exit_status 0 -2
ret 68
end
t_load_rejected
r = new uchar 512 0
if ne rcp_encode r ART_OK
ret 69
end
rcp_digest r dig
if not t_hex_eq dig t_gold_rcp_rej
ret 70
end
if ne rcp_decode r ART_OK
ret 71
end
ret 0
end

note Test group 5b: Receipt nonce, verifier_identity_bytes, Pi5 tier label
fn test_receipt_nonce_and_id to int
id1 = new uchar 32 0
id2 = new uchar 32 0
t_pattern 0x80 id1
t_pattern 0x81 id2
n1 = new uchar 16 0
n2 = new uchar 16 0
n3 = new uchar 16 0
rcp_nonce id1 1 n1
rcp_nonce id1 2 n2
rcp_nonce id2 1 n3
if or art_bytes_eq n1 n2 art_bytes_eq n1 n3
ret 72
end
vib = new uchar 45 0
if ne rcp_verifier_identity_bytes t_commit_ok 1 1 1 vib 45
ret 73
end
if or ne get vib 40 1 ne get vib 41 0
ret 74
end
if or ne get vib 42 1 ne get vib 44 1
ret 75
end
if ne rcp_verifier_identity_bytes t_commit_up 1 1 1 vib -1
ret 76
end
if ne rcp_verifier_identity_bytes part t_commit_ok 0 39 1 1 1 vib -1
ret 77
end
if ne rcp_verifier_identity_bytes t_commit_bad 1 1 1 vib -1
ret 78
end
t_load_admitted
put rcp_scalars 2 RCP_TIER_PI5
b = new uchar 512 0
if ne rcp_encode b ART_OK
ret 79
end
if ne rcp_decode b ART_OK
ret 80
end
if ne get rcp_scalars 2 RCP_TIER_PI5
ret 81
end
lbl = new uchar 32 0
llen = rcp_tier_label_copy RCP_TIER_PI5 lbl
if not art_bytes_eq part lbl 0 llen t_lbl_pi5
ret 82
end
ret 0
end

note Test group 6: Receipt strict decoding (lengths, magic, flags, reserved, enums, presence, consistency)
fn test_receipt_strict_decode to int
t_load_admitted
b = new uchar 512 0
ign = rcp_encode b
if ne rcp_decode part b 0 511 ART_ERR_TRUNCATED
ret 83
end
if ne rcp_decode part b 0 0 ART_ERR_TRUNCATED
ret 84
end
longb = new uchar 513 0
for i ulong 512
put longb i get b i
end
if ne rcp_decode longb ART_ERR_WRONG_LENGTH
ret 85
end
m = new uchar 512 0
for i ulong 512
put m i get b i
end
put m 0 88
if ne rcp_decode m ART_ERR_BAD_MAGIC
ret 86
end
put m 0 get b 0
put m 8 1
if ne rcp_decode m ART_ERR_UNSUPPORTED_VERSION
ret 87
end
put m 8 0
put m 10 95
if ne rcp_decode m ART_ERR_UNSUPPORTED_VERSION
ret 88
end
put m 10 96
put m 13 0
if ne rcp_decode m ART_ERR_UNSUPPORTED_VERSION
ret 89
end
put m 13 get b 13
note Unknown flag bits 3..31
for bit ulong 29
sh = add bit 3
art_put_u32_le m 16 shl ulong 1 sh
if ne rcp_decode m ART_ERR_UNSUPPORTED_FLAGS
ret 90
end
end
art_put_u32_le m 16 0
note Unknown result bits 8..31
for bit ulong 24
sh = add bit 8
art_put_u32_le m 72 or 0xff shl ulong 1 sh
if ne rcp_decode m ART_ERR_UNSUPPORTED_FLAGS
ret 91
end
end
art_put_u32_le m 72 0xff
note Non-zero reserved bytes 56..64 and 500..512
for i ulong 8
put m add 56 i 1
if ne rcp_decode m ART_ERR_RESERVED_NON_ZERO
ret 92
end
put m add 56 i 0
end
for i ulong 12
put m add 500 i 1
if ne rcp_decode m ART_ERR_RESERVED_NON_ZERO
ret 93
end
put m add 500 i 0
end
note Bad decision / tier / status enums
art_put_u16_le m 20 0
if ne rcp_decode m ART_ERR_MALFORMED_RECEIPT
ret 94
end
art_put_u16_le m 20 5
if ne rcp_decode m ART_ERR_MALFORMED_RECEIPT
ret 95
end
art_put_u16_le m 20 1
art_put_u16_le m 22 4
if ne rcp_decode m ART_ERR_MALFORMED_RECEIPT
ret 96
end
art_put_u16_le m 22 1
art_put_u32_le m 64 7
if ne rcp_decode m ART_ERR_MALFORMED_RECEIPT
ret 97
end
ret 0
end

note Test group 7: Receipt reason codes, presence flags, decision consistency, canary rules
fn test_receipt_semantics to int
b = new uchar 512 0
note Valid reasons 1..19 and 0x101..0x10a accepted; 0, 20, 0x100, 0x10b rejected
t_load_rejected
for r ulong 19
put rcp_scalars 8 add r 1
ign = rcp_encode b
if ne rcp_decode b ART_OK
ret 98
end
end
for r ulong 10
put rcp_scalars 8 add 0x101 r
ign = rcp_encode b
if ne rcp_decode b ART_OK
ret 99
end
end
put rcp_scalars 8 20
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 100
end
put rcp_scalars 8 0x10b
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 101
end
put rcp_scalars 8 18
put rcp_scalars 7 10
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 102
end
note Optional fields require their presence flags
t_load_admitted
d = new uchar 32 0
t_pattern 1 d
rcp_set_digest 8 d
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 103
end
t_load_admitted
put rcp_scalars 13 1
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 104
end
t_load_admitted
put rcp_scalars 14 1
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 105
end
t_load_admitted
put rcp_scalars 4 1
ign = rcp_encode b
if ne rcp_decode b ART_ERR_MALFORMED_RECEIPT
ret 106
end
note All optional fields present with VALID_FLAGS accepted
t_load_admitted
put rcp_scalars 0 RCP_VALID_FLAGS
rcp_set_digest 8 d
put rcp_scalars 13 3
put rcp_scalars 14 4
put rcp_scalars 4 5
ign = rcp_encode b
if ne rcp_decode b ART_OK
ret 107
end
note Decision consistency rules
t_load_admitted
put rcp_scalars 7 3
put rcp_scalars 8 18
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 108
end
t_load_rejected
put rcp_scalars 9 1
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 109
end
t_load_rejected
put rcp_scalars 6 or RCP_RES_RECLAIMED RCP_RES_READ_OK
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 110
end
t_load_admitted
put rcp_exit_status 0 3
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 111
end
note Fault without RESULT_CANARY_PASSED is valid
t_load_admitted
put rcp_scalars 5 RCP_EXEC_FAULT
put rcp_scalars 6 or RCP_RES_RECLAIMED RCP_RES_WX_SEALED
if ne rcp_validate ART_OK
ret 112
end
note CanaryFailed decision and status must agree
t_load_admitted
put rcp_scalars 1 RCP_DEC_CANARY_FAILED
put rcp_scalars 5 RCP_EXEC_EXITED
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 113
end
t_load_admitted
put rcp_scalars 1 RCP_DEC_ADMITTED
put rcp_scalars 5 RCP_EXEC_CANARY_FAILED
if ne rcp_validate ART_ERR_MALFORMED_RECEIPT
ret 114
end
t_load_admitted
put rcp_scalars 1 RCP_DEC_CANARY_FAILED
put rcp_scalars 5 RCP_EXEC_CANARY_FAILED
put rcp_scalars 6 and RCP_VALID_RES_FLAGS not RCP_RES_CANARY_PASSED
if ne rcp_validate ART_OK
ret 115
end
ret 0
end

note Test group 8a: Receipt Ed25519 signing, verification, anchor separation
fn test_receipt_signatures to int
s2 = new uchar 32 0
s3 = new uchar 32 0
t_seed2 s2
t_seed3 s3
pk2 = new uchar 32 0
rcp_seed0b_test_pubkey pk2
der2 = new uchar 32 0
art_ed25519_pubkey s2 der2
if not art_bytes_eq pk2 der2
ret 116
end
apk = new uchar 32 0
art_seed0b_test_pubkey apk
if art_bytes_eq pk2 apk
ret 117
end
t_load_admitted
u = new uchar 512 0
ign = rcp_encode u
rcp_anchors_clear
ign = rcp_anchors_add_seed0b_test
if ne rcp_verify u ART_ERR_BAD_SIGNATURE_FORMAT
ret 118
end
s = new uchar 512 0
for i ulong 512
put s i get u i
end
if ne rcp_sign s s2 ART_OK
ret 119
end
dig_u = new uchar 32 0
dig_s = new uchar 32 0
rcp_digest u dig_u
rcp_digest s dig_s
if not art_bytes_eq dig_u dig_s
ret 120
end
if ne rcp_verify s ART_OK
ret 121
end
put s 402 1
if ne rcp_decode s ART_ERR_RESERVED_NON_ZERO
ret 122
end
put s 402 0
put s 400 2
if ne rcp_decode s ART_ERR_BAD_SIGNATURE_FORMAT
ret 123
end
put s 400 1
if ne rcp_sign s s2 ART_ERR_BAD_SIGNATURE_FORMAT
ret 124
end
rcp_anchors_clear
if ne rcp_verify s ART_ERR_UNTRUSTED_SIGNER
ret 125
end
ign = rcp_anchors_add_seed0b_test
put s 436 xor get s 436 0xff
if ne rcp_verify s ART_ERR_BAD_SIGNATURE
ret 126
end
put s 436 xor get s 436 0xff
for i ulong 512
put s i get u i
end
if ne rcp_sign s s3 ART_OK
ret 127
end
if ne rcp_verify s ART_ERR_UNTRUSTED_SIGNER
ret 128
end
t_load_rejected
put rcp_scalars 11 1
ign = rcp_encode s
if ne rcp_sign s s2 ART_ERR_MALFORMED_RECEIPT
ret 129
end
ret 0
end

note Test group 8b: Receipt tamper detection and bounded fuzzing
fn test_receipt_tamper_and_fuzz to int
s2 = new uchar 32 0
t_seed2 s2
t_load_admitted
u = new uchar 512 0
ign = rcp_encode u
dig_u = new uchar 32 0
rcp_digest u dig_u
dig_m = new uchar 32 0
for bi ulong 400
put u bi xor get u bi 1
rcp_digest u dig_m
if art_bytes_eq dig_m dig_u
ret 130
end
put u bi xor get u bi 1
end
s = new uchar 512 0
for i ulong 512
put s i get u i
end
rcp_anchors_clear
ign = rcp_anchors_add_seed0b_test
ign = rcp_sign s s2
for bi ulong 112
pos = add 400 bi
put s pos xor get s pos 1
if eq rcp_verify s ART_OK
ret 131
end
put s pos xor get s pos 1
end
for k ulong 25
pos = mul k 16
put s pos xor get s pos 1
if eq rcp_verify s ART_OK
ret 132
end
put s pos xor get s pos 1
end
ret 0
end

note Test group 8c: Arbitrary mutated 512-byte receipt records never trap
fn test_receipt_fuzz to int
t_load_admitted
u = new uchar 512 0
ign = rcp_encode u
st = ulong 0x9e3779b97f4a7c15
m = new uchar 512 0
for iter ulong 512
for i ulong 512
put m i get u i
end
for k ulong 8
st = xor st shl st 13
st = xor st shr st 7
st = xor st shl st 17
put m rem st 512 uchar and shr st 32 0xff
end
ign = rcp_decode m
end
ret 0
end


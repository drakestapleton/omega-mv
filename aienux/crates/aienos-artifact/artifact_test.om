rc = test_artifact_canonical
if ne rc 0
ret rc
end
rc = test_artifact_mutations
if ne rc 0
ret rc
end
rc = test_artifact_identity_and_attenuation
if ne rc 0
ret rc
end
rc = test_artifact_attenuation_and_fuzz
if ne rc 0
ret rc
end
rc = test_artifact_ed25519_vec
if ne rc 0
ret rc
end
rc = test_artifact_anchor
if ne rc 0
ret rc
end
rc = test_receipt_layout_and_goldens
if ne rc 0
ret rc
end
rc = test_receipt_nonce_and_id
if ne rc 0
ret rc
end
rc = test_receipt_strict_decode
if ne rc 0
ret rc
end
rc = test_receipt_semantics
if ne rc 0
ret rc
end
rc = test_receipt_signatures
if ne rc 0
ret rc
end
rc = test_receipt_tamper_and_fuzz
if ne rc 0
ret rc
end
rc = test_receipt_fuzz
if ne rc 0
ret rc
end
ret 0
end

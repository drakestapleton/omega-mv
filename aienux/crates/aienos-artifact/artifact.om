note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-artifact/artifact.om: Pure-Omega Binary Artifact v0 parser,
note capability/resource codecs, canonical domain-separated digests, identity, and
note Ed25519 signature verification.
note Converted from aienux crates/aienos-artifact/src/{lib,error,id,canonical,capability,resource,format,signature,verify}.rs.
note Compose with: si/directives/om2.om om/tls/sha2.om protocol/omnet/om/sha512/sha512.om protocol/omnet/om/ed25519/ed25519.om aienux/crates/aienos-artifact/artifact.om aienux/crates/aienos-artifact/receipt.om ...

note Stable fail-closed error codes matching ArtifactError repr(u16)
const ART_OK int 0
const ART_ERR_BAD_MAGIC int 1
const ART_ERR_UNSUPPORTED_VERSION int 2
const ART_ERR_WRONG_TARGET int 3
const ART_ERR_WRONG_ABI int 4
const ART_ERR_LENGTH_OVERFLOW int 5
const ART_ERR_TRUNCATED int 6
const ART_ERR_WRONG_LENGTH int 7
const ART_ERR_RESERVED_NON_ZERO int 8
const ART_ERR_UNSUPPORTED_FLAGS int 9
const ART_ERR_SECTION_OVERLAP int 10
const ART_ERR_BAD_SECTION int 11
const ART_ERR_BAD_ENTRY_POINT int 12
const ART_ERR_MALFORMED_CAPABILITY int 13
const ART_ERR_RESOURCE_LIMIT int 14
const ART_ERR_BAD_SIGNATURE_FORMAT int 15
const ART_ERR_DIGEST_MISMATCH int 16
const ART_ERR_UNTRUSTED_SIGNER int 17
const ART_ERR_BAD_SIGNATURE int 18
const ART_ERR_RIGHTS_ESCALATION int 19
const ART_ERR_MALFORMED_RECEIPT int 20

note Format constants (format.rs)
const ART_FORMAT_VERSION ulong 0
const ART_HEADER_SIZE ulong 128
const ART_SECTION_TABLE_OFFSET ulong 128
const ART_SECTION_COUNT ulong 2
const ART_SECTION_RECORD_SIZE ulong 32
const ART_SECTION_TABLE_SIZE ulong 64
const ART_CAPABILITY_TABLE_OFFSET ulong 192
const ART_SIGNATURE_BLOCK_SIZE ulong 100
const ART_SIG_ALG_ED25519 ulong 1
const ART_MAX_ARTIFACT_SIZE ulong 16777216
const ART_MAX_PAYLOAD_SIZE ulong 8388608
const ART_TARGET_AARCH64_LE ulong 1
const ART_ABI_V1 ulong 1
const ART_SECTION_KIND_CODE ulong 1
const ART_SECTION_KIND_DATA ulong 2
const ART_PERM_RX ulong 5
const ART_PERM_RW ulong 3

note Capability constants (capability.rs)
const ART_CAP_RECORD_SIZE ulong 48
const ART_MAX_CAPABILITIES ulong 16
const ART_RESOURCE_KIND_CHANNEL ulong 2
const ART_RESOURCE_KIND_OBJECT ulong 3
const ART_RIGHT_READ ulong 1
const ART_RIGHT_WRITE ulong 2
const ART_RIGHT_MAP ulong 4
const ART_RIGHT_GRANT ulong 8
const ART_RIGHT_DERIVE ulong 16
const ART_RIGHT_REVOKE ulong 32
const ART_VALID_RIGHTS ulong 63

note Resource envelope constants (resource.rs)
const ART_RESOURCE_ENVELOPE_SIZE ulong 48
const ART_PAGE_SIZE ulong 4096
const ART_MAX_CODE_PAGES ulong 64
const ART_MAX_DATA_PAGES ulong 64
const ART_MAX_STACK_PAGES ulong 16
const ART_MAX_IPC_MESSAGES ulong 1024
const ART_MAX_IPC_BYTES ulong 1048576
const ART_MAX_CPU_TICKS ulong 1000000000
const ART_MAX_ELAPSED_TICKS ulong 1000000000
const ART_MAX_SYSCALLS ulong 65536

note Signature and trust tier constants (signature.rs)
const ART_SIG_SIZE ulong 64
const ART_PUBKEY_SIZE ulong 32
const ART_SIG_MSG_SIZE ulong 61
const ART_TRUST_TIER_NONE ulong 0
const ART_TRUST_TIER_PRODUCTION ulong 1
const ART_TRUST_TIER_SEED0B_QUAL ulong 2
const ART_MAX_ANCHORS ulong 8

note Domain strings (each followed by a trailing NUL byte when hashed/framed)
text art_magic_pfx "AIENART"
text art_id_dom_pfx "AIENOS-ARTIFACT-V1"
text art_req_dom_pfx "AIENOS-ARTIFACT-CAP-REQUESTS-V1"
text art_grant_dom_pfx "AIENOS-ADMISSION-CAP-GRANTS-V1"
text art_res_dom_pfx "AIENOS-ARTIFACT-RESOURCES-V1"
text art_pol_dom_pfx "AIENOS-ADMISSION-POLICY-V1"
text art_mach_dom_pfx "AIENOS-MACHINE-ID-V1"
text art_ver_dom_pfx "AIENOS-VERIFIER-IDENTITY-V1"
text art_sig_dom_pfx "AIENOS-ARTIFACT-SIGNATURE-V1"

note Parsed artifact state
note art_meta slots:
note   0=target_arch, 1=abi_version, 2=entry_offset, 3=sig_alg,
note   4=cap_cnt, 5=cap_off, 6=cap_bytes_len, 7=res_off,
note   8=payload_off, 9=payload_len, 10=sig_off, 11=verified_tier
global art_meta ulong 12
note Two sections, 6 ulongs each: kind, perm, poff, flen, mlen, align
global art_sections ulong 12
note Up to 16 capabilities, 8 ulongs each:
note   0=resource_kind, 1=resource_id, 2=rights, 3=bounds_kind,
note   4=max_operations, 5=max_bytes, 6=byte_offset, 7=byte_length
global art_caps ulong 128
note Resource envelope, 9 ulongs:
note   0=code_pages, 1=data_pages, 2=stack_pages, 3=max_capabilities,
note   4=ipc_messages, 5=ipc_bytes, 6=cpu_ticks, 7=elapsed_ticks, 8=syscall_count
global art_res ulong 9
global art_signer_fp uchar 32
global art_sig uchar 64
global art_id uchar 32
global art_payload_dig uchar 32

note Artifact trust anchor table (distinct from receipt anchors)
global art_anchor_cnt ulong 1
global art_anchor_pks uchar 256
global art_anchor_tiers ulong 8

note Little-endian byte helpers
fn art_get_u16_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
ret or b0 shl b1 8
end

fn art_get_u32_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
b2 = ulong get buf add off 2
b3 = ulong get buf add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn art_get_u64_le buf view uchar * off ulong to ulong
acc = ulong 0
for i ulong 8
b = ulong get buf add off i
acc = or acc shl b mul i 8
end
ret acc
end

fn art_put_u16_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
end

fn art_put_u32_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
end

fn art_put_u64_le buf edit uchar * off ulong v ulong to void
for i ulong 8
sh = mul i 8
put buf add off i uchar and shr v sh 0xff
end
end

fn art_all_zero buf view uchar * off ulong n ulong to bool
for i ulong n bound 1024
if ne get buf add off i 0
ret false
end
end
ret true
end

fn art_bytes_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
n = len a
for i ulong n bound 4096
if ne get a i get b i
ret false
end
end
ret true
end

note Domain-separated SHA-256: SHA256(dom_pfx || 0x00 || data)
fn art_sha256_dom dom view uchar * data view uchar * dst edit uchar * to void
ctx = new ulong 40 0
nul = new uchar 1 0
sha256_init ctx
sha256_update ctx dom
sha256_update ctx nul
sha256_update ctx data
sha256_final ctx dst
end

note Canonical digests (canonical.rs, id.rs)
fn art_id_from_unsigned_bytes data view uchar * dst edit uchar * to void
art_sha256_dom art_id_dom_pfx data dst
end

fn art_compute_id bytes view uchar * dst edit uchar * to void
so = get art_meta 10
art_id_from_unsigned_bytes part bytes 0 so dst
end

fn art_payload_digest_slice payload view uchar * dst edit uchar * to void
dlen = sha2_digest 256 payload dst
if ne dlen 32
trap 8
end
end

fn art_requested_cap_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_req_dom_pfx data dst
end

fn art_granted_cap_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_grant_dom_pfx data dst
end

fn art_resource_envelope_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_res_dom_pfx data dst
end

fn art_policy_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_pol_dom_pfx data dst
end

fn art_machine_id_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_mach_dom_pfx data dst
end

fn art_verifier_identity_digest data view uchar * dst edit uchar * to void
art_sha256_dom art_ver_dom_pfx data dst
end

fn art_signer_fingerprint pk view uchar * dst edit uchar * to void
dlen = sha2_digest 256 pk dst
if ne dlen 32
trap 8
end
end

note CapabilityRequest encode / validate / decode / attenuation (capability.rs)
fn art_cap_encode cap view ulong * dst edit uchar * to void
for i ulong 48
put dst i 0
end
art_put_u16_le dst 0 get cap 0
art_put_u32_le dst 4 get cap 1
art_put_u32_le dst 8 get cap 2
art_put_u32_le dst 12 get cap 3
art_put_u32_le dst 16 get cap 4
art_put_u64_le dst 24 get cap 5
art_put_u64_le dst 32 get cap 6
art_put_u64_le dst 40 get cap 7
end

fn art_cap_validate cap view ulong * to int
rk = get cap 0
rid = get cap 1
rts = get cap 2
bk = get cap 3
mops = get cap 4
mb = get cap 5
if and ne rk ART_RESOURCE_KIND_OBJECT ne rk ART_RESOURCE_KIND_CHANNEL
ret ART_ERR_MALFORMED_CAPABILITY
end
if or eq rid 0 eq rts 0
ret ART_ERR_MALFORMED_CAPABILITY
end
if ne and rts not ART_VALID_RIGHTS 0
ret ART_ERR_MALFORMED_CAPABILITY
end
if or eq mops 0 eq mb 0
ret ART_ERR_MALFORMED_CAPABILITY
end
boff = get cap 6
blen = get cap 7
if and eq rk ART_RESOURCE_KIND_OBJECT eq bk 1
bend = add boff blen
if lt bend boff
ret ART_ERR_LENGTH_OVERFLOW
end
if or eq blen 0 gt mb blen
ret ART_ERR_MALFORMED_CAPABILITY
end
ret ART_OK
end
if and eq rk ART_RESOURCE_KIND_CHANNEL eq bk 2
if or ne boff 0 ne blen 0
ret ART_ERR_MALFORMED_CAPABILITY
end
ret ART_OK
end
ret ART_ERR_MALFORMED_CAPABILITY
end

fn art_cap_decode bytes view uchar * cap edit ulong * to int
n = len bytes
if lt n ART_CAP_RECORD_SIZE
ret ART_ERR_TRUNCATED
end
if gt n ART_CAP_RECORD_SIZE
ret ART_ERR_WRONG_LENGTH
end
if or ne art_get_u16_le bytes 2 0 ne art_get_u32_le bytes 20 0
ret ART_ERR_RESERVED_NON_ZERO
end
put cap 0 art_get_u16_le bytes 0
put cap 1 art_get_u32_le bytes 4
put cap 2 art_get_u32_le bytes 8
put cap 3 art_get_u32_le bytes 12
put cap 4 art_get_u32_le bytes 16
put cap 5 art_get_u64_le bytes 24
put cap 6 art_get_u64_le bytes 32
put cap 7 art_get_u64_le bytes 40
ret art_cap_validate cap
end

fn art_cap_is_attenuation_of cand view ulong * req view ulong * to bool
if ne art_cap_validate cand ART_OK
ret false
end
if ne art_cap_validate req ART_OK
ret false
end
if or ne get cand 0 get req 0 ne get cand 1 get req 1
ret false
end
if ne get cand 3 get req 3
ret false
end
if ne and get cand 2 not get req 2 0
ret false
end
if or gt get cand 4 get req 4 gt get cand 5 get req 5
ret false
end
bk = get cand 3
if eq bk 1
co = get cand 6
cl = get cand 7
ce = add co cl
if lt ce co
ret false
end
ro = get req 6
rl = get req 7
re = add ro rl
if lt re ro
ret false
end
ret and ge co ro le ce re
end
if eq bk 2
ret and eq get cand 6 0 eq get cand 7 0
end
ret false
end

note ResourceEnvelope validate / decode / capacity (resource.rs)
fn art_res_validate env view ulong * req_caps ulong to int
cp = get env 0
dp = get env 1
sp = get env 2
mc = get env 3
if or eq cp 0 gt cp ART_MAX_CODE_PAGES
ret ART_ERR_RESOURCE_LIMIT
end
if or eq dp 0 gt dp ART_MAX_DATA_PAGES
ret ART_ERR_RESOURCE_LIMIT
end
if or eq sp 0 gt sp ART_MAX_STACK_PAGES
ret ART_ERR_RESOURCE_LIMIT
end
if or lt mc req_caps gt mc ART_MAX_CAPABILITIES
ret ART_ERR_RESOURCE_LIMIT
end
if or gt get env 4 ART_MAX_IPC_MESSAGES gt get env 5 ART_MAX_IPC_BYTES
ret ART_ERR_RESOURCE_LIMIT
end
ct = get env 6
et = get env 7
sc = get env 8
if or eq ct 0 gt ct ART_MAX_CPU_TICKS
ret ART_ERR_RESOURCE_LIMIT
end
if or eq et 0 gt et ART_MAX_ELAPSED_TICKS
ret ART_ERR_RESOURCE_LIMIT
end
if or eq sc 0 gt sc ART_MAX_SYSCALLS
ret ART_ERR_RESOURCE_LIMIT
end
ret ART_OK
end

fn art_res_decode bytes view uchar * req_caps ulong env edit ulong * to int
n = len bytes
if lt n ART_RESOURCE_ENVELOPE_SIZE
ret ART_ERR_TRUNCATED
end
if gt n ART_RESOURCE_ENVELOPE_SIZE
ret ART_ERR_WRONG_LENGTH
end
if or ne art_get_u16_le bytes 14 0 ne art_get_u32_le bytes 44 0
ret ART_ERR_RESERVED_NON_ZERO
end
put env 0 art_get_u32_le bytes 0
put env 1 art_get_u32_le bytes 4
put env 2 art_get_u32_le bytes 8
put env 3 art_get_u16_le bytes 12
put env 4 art_get_u32_le bytes 16
put env 5 art_get_u32_le bytes 20
put env 6 art_get_u64_le bytes 24
put env 7 art_get_u64_le bytes 32
put env 8 art_get_u32_le bytes 40
ret art_res_validate env req_caps
end

fn art_res_code_cap_bytes env view ulong * to ulong
ret mul get env 0 ART_PAGE_SIZE
end

fn art_res_data_cap_bytes env view ulong * to ulong
ret mul get env 1 ART_PAGE_SIZE
end

note SignatureBlock decode (signature.rs)
fn art_sig_block_decode bytes view uchar * fp_out edit uchar * sig_out edit uchar * to int
n = len bytes
if lt n ART_SIGNATURE_BLOCK_SIZE
ret ART_ERR_TRUNCATED
end
if gt n ART_SIGNATURE_BLOCK_SIZE
ret ART_ERR_WRONG_LENGTH
end
alg = art_get_u16_le bytes 0
if ne alg ART_SIG_ALG_ED25519
ret ART_ERR_BAD_SIGNATURE_FORMAT
end
if or ne get bytes 2 0 ne get bytes 3 0
ret ART_ERR_RESERVED_NON_ZERO
end
for i ulong 32
put fp_out i get bytes add 4 i
end
for i ulong 64
put sig_out i get bytes add 36 i
end
ret ART_OK
end

note Section decode and validation (format.rs)
fn art_decode_section bytes view uchar * off ulong slot ulong to int
if ne art_get_u32_le bytes add off 4 0
ret ART_ERR_RESERVED_NON_ZERO
end
if not art_all_zero bytes add off 24 8
ret ART_ERR_RESERVED_NON_ZERO
end
base = mul slot 6
put art_sections base art_get_u16_le bytes off
put art_sections add base 1 art_get_u16_le bytes add off 2
put art_sections add base 2 art_get_u32_le bytes add off 8
put art_sections add base 3 art_get_u32_le bytes add off 12
put art_sections add base 4 art_get_u32_le bytes add off 16
put art_sections add base 5 art_get_u32_le bytes add off 20
ret ART_OK
end

fn art_validate_sections payload_len ulong to int
cf = get art_sections 3
if or ne get art_sections 0 ART_SECTION_KIND_CODE ne get art_sections 1 ART_PERM_RX
ret ART_ERR_BAD_SECTION
end
if or ne get art_sections 2 0 eq cf 0
ret ART_ERR_BAD_SECTION
end
if or ne get art_sections 4 cf ne get art_sections 5 ART_PAGE_SIZE
ret ART_ERR_BAD_SECTION
end
df = get art_sections 9
if or ne get art_sections 6 ART_SECTION_KIND_DATA ne get art_sections 7 ART_PERM_RW
ret ART_ERR_BAD_SECTION
end
if or ne get art_sections 8 cf eq df 0
ret ART_ERR_BAD_SECTION
end
if or lt get art_sections 10 df ne get art_sections 11 ART_PAGE_SIZE
ret ART_ERR_BAD_SECTION
end
end_p = add cf df
if lt end_p cf
ret ART_ERR_LENGTH_OVERFLOW
end
if ne end_p payload_len
ret ART_ERR_SECTION_OVERLAP
end
ret ART_OK
end

note Header validation helper for art_parse (keeps register pressure low)
fn art_parse_header bytes view uchar * to int
n = len bytes
if lt n ART_HEADER_SIZE
ret ART_ERR_TRUNCATED
end
if gt n ART_MAX_ARTIFACT_SIZE
ret ART_ERR_RESOURCE_LIMIT
end
for i ulong 7
if ne get bytes i get art_magic_pfx i
ret ART_ERR_BAD_MAGIC
end
end
if ne get bytes 7 0
ret ART_ERR_BAD_MAGIC
end
if or ne art_get_u16_le bytes 8 ART_FORMAT_VERSION ne art_get_u16_le bytes 10 ART_HEADER_SIZE
ret ART_ERR_UNSUPPORTED_VERSION
end
ta = art_get_u16_le bytes 12
if ne ta ART_TARGET_AARCH64_LE
ret ART_ERR_WRONG_TARGET
end
av = art_get_u16_le bytes 14
if ne av ART_ABI_V1
ret ART_ERR_WRONG_ABI
end
if ne art_get_u32_le bytes 16 0
ret ART_ERR_UNSUPPORTED_FLAGS
end
tlen = art_get_u32_le bytes 20
if ne tlen n
ret ART_ERR_WRONG_LENGTH
end
if or ne art_get_u32_le bytes 24 ART_SECTION_TABLE_OFFSET ne art_get_u16_le bytes 28 ART_SECTION_COUNT
ret ART_ERR_UNSUPPORTED_VERSION
end
if or ne art_get_u16_le bytes 30 ART_SECTION_RECORD_SIZE ne art_get_u16_le bytes 32 0
ret ART_ERR_UNSUPPORTED_VERSION
end
if ne art_get_u16_le bytes 34 0
ret ART_ERR_UNSUPPORTED_VERSION
end
if or ne art_get_u32_le bytes 40 ART_CAPABILITY_TABLE_OFFSET ne art_get_u16_le bytes 46 ART_CAP_RECORD_SIZE
ret ART_ERR_UNSUPPORTED_VERSION
end
if or ne art_get_u16_le bytes 52 ART_RESOURCE_ENVELOPE_SIZE ne art_get_u16_le bytes 54 0
ret ART_ERR_UNSUPPORTED_VERSION
end
if not art_all_zero bytes 72 56
ret ART_ERR_RESERVED_NON_ZERO
end
put art_meta 0 ta
put art_meta 1 av
put art_meta 2 art_get_u32_le bytes 36
ret ART_OK
end

note Layout offsets check helper for art_parse
fn art_parse_layout bytes view uchar * to int
n = len bytes
cc = art_get_u16_le bytes 44
if gt cc ART_MAX_CAPABILITIES
ret ART_ERR_RESOURCE_LIMIT
end
clen = mul cc ART_CAP_RECORD_SIZE
roff = art_get_u32_le bytes 48
if ne roff add ART_CAPABILITY_TABLE_OFFSET clen
ret ART_ERR_SECTION_OVERLAP
end
rend = add roff ART_RESOURCE_ENVELOPE_SIZE
poff = art_get_u32_le bytes 56
if ne poff and add rend 15 not ulong 15
ret ART_ERR_SECTION_OVERLAP
end
if gt poff n
ret ART_ERR_TRUNCATED
end
if not art_all_zero bytes rend sub poff rend
ret ART_ERR_RESERVED_NON_ZERO
end
plen = art_get_u32_le bytes 60
if gt plen ART_MAX_PAYLOAD_SIZE
ret ART_ERR_RESOURCE_LIMIT
end
soff = art_get_u32_le bytes 64
if or ne art_get_u16_le bytes 68 ART_SIGNATURE_BLOCK_SIZE ne art_get_u16_le bytes 70 ART_SIG_ALG_ED25519
ret ART_ERR_BAD_SIGNATURE_FORMAT
end
if ne soff add poff plen
ret ART_ERR_SECTION_OVERLAP
end
if ne add soff ART_SIGNATURE_BLOCK_SIZE n
ret ART_ERR_WRONG_LENGTH
end
put art_meta 3 ART_SIG_ALG_ED25519
put art_meta 4 cc
put art_meta 5 ART_CAPABILITY_TABLE_OFFSET
put art_meta 6 clen
put art_meta 7 roff
put art_meta 8 poff
put art_meta 9 plen
put art_meta 10 soff
put art_meta 11 ART_TRUST_TIER_NONE
ret ART_OK
end

note Parse capability table into art_caps with strict (resource_kind, resource_id) ordering
fn art_parse_caps bytes view uchar * cc ulong to int
prev_key = ulong 0
tmp = new ulong 8 0
for idx ulong cc bound 16
rc = art_cap_decode part bytes add ART_CAPABILITY_TABLE_OFFSET mul idx ART_CAP_RECORD_SIZE ART_CAP_RECORD_SIZE tmp
if ne rc ART_OK
ret rc
end
key = or shl get tmp 0 32 get tmp 1
if le key prev_key
ret ART_ERR_MALFORMED_CAPABILITY
end
prev_key = key
for f ulong 8
put art_caps add mul idx 8 f get tmp f
end
end
ret ART_OK
end

note Strict fail-closed Binary Artifact v0 parser (Artifact::parse)
fn art_parse bytes view uchar * to int
rc = art_parse_header bytes
if ne rc ART_OK
ret rc
end
rc = art_parse_layout bytes
if ne rc ART_OK
ret rc
end
rc = art_decode_section bytes 128 0
if ne rc ART_OK
ret rc
end
rc = art_decode_section bytes 160 1
if ne rc ART_OK
ret rc
end
rc = art_validate_sections get art_meta 9
if ne rc ART_OK
ret rc
end
rc = art_parse_caps bytes get art_meta 4
if ne rc ART_OK
ret rc
end
env = new ulong 9 0
rc = art_res_decode part bytes get art_meta 7 ART_RESOURCE_ENVELOPE_SIZE get art_meta 4 env
if ne rc ART_OK
ret rc
end
for i ulong 9
put art_res i get env i
end
if or gt get art_sections 4 art_res_code_cap_bytes env gt get art_sections 10 art_res_data_cap_bytes env
ret ART_ERR_RESOURCE_LIMIT
end
if ne and get art_meta 2 3 0
ret ART_ERR_BAD_ENTRY_POINT
end
if gt add get art_meta 2 4 0xffffffff
ret ART_ERR_LENGTH_OVERFLOW
end
if gt add get art_meta 2 4 get art_sections 3
ret ART_ERR_BAD_ENTRY_POINT
end
fp = new uchar 32 0
sg = new uchar 64 0
rc = art_sig_block_decode part bytes get art_meta 10 ART_SIGNATURE_BLOCK_SIZE fp sg
if ne rc ART_OK
ret rc
end
for i ulong 32
put art_signer_fp i get fp i
end
for i ulong 64
put art_sig i get sg i
end
ret ART_OK
end

note Parse and compute ArtifactId + payload_digest (verify.rs: parse_and_identify)
fn art_parse_and_identify bytes view uchar * to int
if gt len bytes ART_MAX_ARTIFACT_SIZE
ret ART_ERR_RESOURCE_LIMIT
end
rc = art_parse bytes
if ne rc ART_OK
ret rc
end
id_buf = new uchar 32 0
art_compute_id bytes id_buf
for i ulong 32
put art_id i get id_buf i
end
pd_buf = new uchar 32 0
poff = get art_meta 8
plen = get art_meta 9
art_payload_digest_slice part bytes poff plen pd_buf
for i ulong 32
put art_payload_dig i get pd_buf i
end
ret ART_OK
end

note Ed25519 scalar multiplication [s]B (256 bits) for RFC 8032 keygen and signing
fn art_ed_smul_b w edit ulong 1024 s view uchar 32 to void
edfcpy w edq edzero 64
edfcpy w add edq 16 edone 16
edfcpy w add edq 32 edone 16
for j ulong 256
i = sub 255 j
edpdbl w edq
if eq edbit s i 1
edpadd w edq edbp
end
end
end

note Compute S = (r + k * a) mod L (32-byte little-endian scalars)
fn art_ed_muladd_l r view uchar 32 k view uchar 32 a view uchar 32 dst edit uchar 32 to void
x = new long 64 0
for i ulong 32
put x i long get r i
end
for i ulong 32
ki = long get k i
for j ulong 32
idx = add i j
put x idx add get x idx mul ki long get a j
end
end
carry = long 0
for i ulong 64
v = add get x i carry
put x i and v 255
carry = shr v 8
end
edmodl x
for i ulong 32
put dst i uchar get x i
end
end

note Derive RFC 8032 Ed25519 public key from 32-byte seed
fn art_ed25519_pubkey seed view uchar * pk_out edit uchar * to void
h = new uchar 64 0
dlen = sha2_digest 512 part seed 0 32 h
if ne dlen 64
trap 8
end
a = new uchar 32 0
for i ulong 32
put a i get h i
end
put a 0 and get a 0 248
put a 31 or and get a 31 127 64
w = new ulong 1024 0
edinit w
art_ed_smul_b w a
pk32 = new uchar 32 0
edpenc w edq pk32
for i ulong 32
put pk_out i get pk32 i
end
end

note Reduce 64-byte SHA-512 digest modulo L into 32-byte scalar
fn art_ed_reduce64 hd view uchar 64 dst edit uchar 32 to void
x = new long 64 0
for i ulong 64
put x i long get hd i
end
edmodl x
for i ulong 32
put dst i uchar get x i
end
end

note Helper: compute r = SHA512(prefix || msg) mod L and R = encode([r]B)
fn art_ed_sign_step1 pfx view uchar 32 msg view uchar * r_out edit uchar 32 rb_out edit uchar 32 to void
ctx = new ulong 40 0
sha512_init ctx
sha512_update ctx pfx
sha512_update ctx msg
hd = new uchar 64 0
sha512_final ctx hd
art_ed_reduce64 hd r_out
w = new ulong 1024 0
edinit w
art_ed_smul_b w r_out
edpenc w edq rb_out
end

note Helper: compute k = SHA512(R || A || msg) mod L
fn art_ed_sign_step2 rb view uchar 32 pk view uchar 32 msg view uchar * k_out edit uchar 32 to void
ctx = new ulong 40 0
sha512_init ctx
sha512_update ctx rb
sha512_update ctx pk
sha512_update ctx msg
hd = new uchar 64 0
sha512_final ctx hd
art_ed_reduce64 hd k_out
end

note Helper: expand 32-byte seed into clamped scalar a, 32-byte prefix, and 32-byte public key
fn art_ed_expand seed view uchar * a_out edit uchar 32 pfx_out edit uchar 32 pk_out edit uchar 32 to void
h = new uchar 64 0
dlen = sha2_digest 512 part seed 0 32 h
if ne dlen 64
trap 8
end
for i ulong 32
put a_out i get h i
put pfx_out i get h add 32 i
end
put a_out 0 and get a_out 0 248
put a_out 31 or and get a_out 31 127 64
w = new ulong 1024 0
edinit w
art_ed_smul_b w a_out
edpenc w edq pk_out
end

note RFC 8032 pure Ed25519 signing (seed[0..32], msg, sig_out[0..64])
fn art_ed25519_sign seed view uchar * msg view uchar * sig_out edit uchar * to void
a = new uchar 32 0
pfx = new uchar 32 0
pk = new uchar 32 0
art_ed_expand seed a pfx pk
r = new uchar 32 0
rb = new uchar 32 0
art_ed_sign_step1 pfx msg r rb
k = new uchar 32 0
art_ed_sign_step2 rb pk msg k
art_ed_muladd_l r k a pfx
for i ulong 32
put sig_out i get rb i
put sig_out add 32 i get pfx i
end
end

note RFC 8032 Ed25519 strict verification (mode 0) via protocol/omnet/om/ed25519/ed25519.om
fn art_ed25519_verify pk view uchar * msg view uchar * sig view uchar * to bool
if or ne len pk 32 ne len sig 64
ret false
end
mlen = len msg
if gt mlen 65536
ret false
end
pk32 = new uchar 32 0
for i ulong 32
put pk32 i get pk i
end
sig64 = new uchar 64 0
for i ulong 64
put sig64 i get sig i
end
mbuf = new uchar 65536 0
for i ulong mlen bound 65536
put mbuf i get msg i
end
ret eq edverify pk32 mbuf mlen sig64 0 1
end

note Build 61-byte artifact signature message: "AIENOS-ARTIFACT-SIGNATURE-V1\0" || artifact_id
fn art_signature_message aid view uchar * msg_out edit uchar * to void
for i ulong 28
put msg_out i get art_sig_dom_pfx i
end
put msg_out 28 0
for i ulong 32
put msg_out add 29 i get aid i
end
end

note Trust anchor management (EmptyTrustAnchorSet / ProductionTrustAnchorSet / Seed0bTestAnchorSet)
fn art_anchors_clear to void
put art_anchor_cnt 0 0
end

fn art_anchors_add pk view uchar * tier ulong to int
if ne len pk 32
ret ART_ERR_BAD_SIGNATURE_FORMAT
end
cnt = get art_anchor_cnt 0
if ge cnt ART_MAX_ANCHORS
ret ART_ERR_RESOURCE_LIMIT
end
base = mul cnt 32
for i ulong 32
put art_anchor_pks add base i get pk i
end
put art_anchor_tiers cnt tier
put art_anchor_cnt 0 add cnt 1
ret ART_OK
end

note Populate RFC 8032 TEST 1 public key (Seed0bTestAnchorSet, TEST ONLY)
fn art_seed0b_test_pubkey dst edit uchar * to void
put dst 0 0xd7
put dst 1 0x5a
put dst 2 0x98
put dst 3 0x01
put dst 4 0x82
put dst 5 0xb1
put dst 6 0x0a
put dst 7 0xb7
put dst 8 0xd5
put dst 9 0x4b
put dst 10 0xfe
put dst 11 0xd3
put dst 12 0xc9
put dst 13 0x64
put dst 14 0x07
put dst 15 0x3a
put dst 16 0x0e
put dst 17 0xe1
put dst 18 0x72
put dst 19 0xf3
put dst 20 0xda
put dst 21 0xa6
put dst 22 0x23
put dst 23 0x25
put dst 24 0xaf
put dst 25 0x02
put dst 26 0x1a
put dst 27 0x68
put dst 28 0xf7
put dst 29 0x07
put dst 30 0x51
put dst 31 0x1a
end

fn art_anchors_add_seed0b_test to int
pk = new uchar 32 0
art_seed0b_test_pubkey pk
ret art_anchors_add pk ART_TRUST_TIER_SEED0B_QUAL
end

note Find trusted anchor by SHA-256 fingerprint; writes 32-byte pk to pk_out and returns tier (or 0)
fn art_anchors_find fp view uchar * pk_out edit uchar * to ulong
cnt = get art_anchor_cnt 0
cand = new uchar 32 0
cfp = new uchar 32 0
for idx ulong cnt bound 8
base = mul idx 32
for i ulong 32
put cand i get art_anchor_pks add base i
end
art_signer_fingerprint cand cfp
if art_bytes_eq fp cfp
for i ulong 32
put pk_out i get cand i
end
ret get art_anchor_tiers idx
end
end
ret ART_TRUST_TIER_NONE
end

note ConfiguredArtifactVerifier::verify
fn art_verify bytes view uchar * to int
rc = art_parse_and_identify bytes
if ne rc ART_OK
ret rc
end
fp = new uchar 32 0
for i ulong 32
put fp i get art_signer_fp i
end
pk = new uchar 32 0
tier = art_anchors_find fp pk
if eq tier ART_TRUST_TIER_NONE
ret ART_ERR_UNTRUSTED_SIGNER
end
chk_fp = new uchar 32 0
art_signer_fingerprint pk chk_fp
if not art_bytes_eq chk_fp fp
ret ART_ERR_UNTRUSTED_SIGNER
end
aid = new uchar 32 0
for i ulong 32
put aid i get art_id i
end
msg = new uchar 61 0
art_signature_message aid msg
sg = new uchar 64 0
for i ulong 64
put sg i get art_sig i
end
if not art_ed25519_verify pk msg sg
ret ART_ERR_BAD_SIGNATURE
end
put art_meta 11 tier
ret ART_OK
end

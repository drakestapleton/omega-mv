note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-anchor/anchor_test.om: Behavioral self-test for aienos-anchor.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-anchor/anchor.om aienux/crates/aienos-anchor/anchor_test.om

text at_k1 "host.arch"
text at_v1 "aarch64"
text at_v2 "aarch64-gb10"
text at_src "boot-verify"
text at_k2 "missing.key"

fn main to int
anchor_init
key_a = new uchar 32 0x11
key_b = new uchar 32 0x22
rc = anchor_add_trusted key_a
if ne rc ANCHOR_OK
ret 1
end

note 1. Unknown key before any admission
if ne anchor_query at_k1 ANCHOR_ANS_UNKNOWN
ret 2
end

note 2. Admit fact seq 0
anchor_stage_hdr 0 ANCHOR_KIND_ADMIT 1000
rc = anchor_stage_kv at_k1 at_v1
if ne rc ANCHOR_OK
ret 3
end
rc = anchor_stage_source at_src
if ne rc ANCHOR_OK
ret 4
end
anchor_sign_staged key_a
rc = anchor_append_staged
if ne rc ANCHOR_OK
ret 5
end
if ne anchor_query at_k1 ANCHOR_ANS_KNOWN
ret 6
end
if ne get anchor_q_res 2 0
ret 7
end

note 3. Reject untrusted signer
anchor_stage_hdr 1 ANCHOR_KIND_ADMIT 1001
rc = anchor_stage_kv at_k1 at_v2
if ne rc ANCHOR_OK
ret 8
end
anchor_sign_staged key_b
if ne anchor_append_staged ANCHOR_ERR_UNTRUSTED
ret 9
end

note 4. Reject out-of-order seq
anchor_stage_hdr 5 ANCHOR_KIND_ADMIT 1001
rc = anchor_stage_kv at_k1 at_v2
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_ERR_OUT_OF_ORDER
ret 10
end

note 5. Reject broken chain prev
anchor_stage_hdr 1 ANCHOR_KIND_ADMIT 1001
rc = anchor_stage_kv at_k1 at_v2
bad_prev = new uchar 32 0x99
anchor_stage_prev bad_prev
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_ERR_BROKEN_CHAIN
ret 11
end

note 6. Reject tampered signature
anchor_stage_hdr 1 ANCHOR_KIND_ADMIT 1001
rc = anchor_stage_kv at_k1 at_v2
anchor_sign_staged key_a
put anchor_st_sig 0 xor get anchor_st_sig 0 1
if ne anchor_append_staged ANCHOR_ERR_BAD_SIG
ret 12
end

note 7. Reject retract with non-empty value
anchor_stage_hdr 1 ANCHOR_KIND_RETRACT 1002
rc = anchor_stage_kv at_k1 at_v1
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_ERR_RETRACT_VALUE
ret 13
end

note 8. Reject retract of unknown key
empty_v = new uchar 1 0
anchor_stage_hdr 1 ANCHOR_KIND_RETRACT 1002
rc = anchor_stage_kv at_k2 part empty_v 0 0
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_ERR_RETRACT_UNKNOWN
ret 14
end

note 9. Valid update seq 1 then retract seq 2
anchor_stage_hdr 1 ANCHOR_KIND_ADMIT 1002
rc = anchor_stage_kv at_k1 at_v2
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_OK
ret 15
end
anchor_stage_hdr 2 ANCHOR_KIND_RETRACT 1003
rc = anchor_stage_kv at_k1 part empty_v 0 0
anchor_sign_staged key_a
if ne anchor_append_staged ANCHOR_OK
ret 16
end
if ne anchor_query at_k1 ANCHOR_ANS_RETRACTED
ret 17
end
if ne get anchor_q_res 2 2
ret 18
end

note 10. Export all 3 entries and replay into a fresh anchor
logbuf = new uchar 2048 0
pos = ulong 0
saved_head = new uchar 32 0
for i ulong 32
put saved_head i get anchor_head i
end
ebuf = new uchar 512 0
for idx ulong 3
elen = anchor_export_entry idx ebuf
for j ulong elen bound 512
put logbuf add pos j get ebuf j
end
pos = add pos elen
end

anchor_init
rc = anchor_add_trusted key_a
if ne rc ANCHOR_OK
ret 19
end
rc = anchor_replay logbuf pos
if ne rc ANCHOR_OK
ret 20
end
if ne get anchor_cnt 0 3
ret 21
end
for i ulong 32
if ne get anchor_head i get saved_head i
ret 22
end
end

note 11. Tampered log byte must refuse replay
put logbuf 20 xor get logbuf 20 0xff
anchor_init
rc = anchor_add_trusted key_a
rc = anchor_replay logbuf pos
if eq rc ANCHOR_OK
ret 23
end

ret 0
end

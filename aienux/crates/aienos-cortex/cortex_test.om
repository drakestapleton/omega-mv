note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-cortex/cortex_test.om: Behavioral self-test for aienos-cortex.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-cortex/cortex.om aienux/crates/aienos-cortex/cortex_test.om

text ct_s_obs "UART0 base physical address is 0x09000000"
text ct_p_dt "device_tree"
text ct_r_uart "phys_uart0_reg"
text ct_s_inf1 "Driver can safely bind to UART0 MMIO"
text ct_m_llama "llama3-spark"
text ct_s_inf2 "Early console can initialize without Linux driver"
text ct_s_hall "The system has 1024 GB10 GPUs connected"
text ct_m_spec "speculative_model"
text ct_s_ca "Claim A is true because Claim B is true"
text ct_s_cb "Claim B is true because Claim A is true"
text ct_m_circ "model_hallucination"
text ct_s_forged "Secret backdoors exist in kernel"
text ct_m_adv "adversarial_prompt"
text ct_s_fab "Fabricated premise with zero grounding"
text ct_m_mal "malicious_model"
text ct_s_mix "Hybrid inference based on observation AND fabrication"
text ct_m_hyb "hybrid_model"
text ct_s_hyp "Hypothesis derived from valid observation"
text ct_a_exp "explorer_agent"
text ct_s_tr "Inference deduced from verified hypothesis"
text ct_m_rsn "reasoning_model"
text ct_reason "Hardware sensor disagrees with fabricated premise"

text ct_p_obs "Boot completed at tick 42"
text ct_p_klog "kernel_log"
text ct_p_fact "SHA256 test vector passes FIPS 180-4"
text ct_p_tsuite "test_suite"
text ct_p_vtool "cargo_test"
text ct_p_proof "proof"
text ct_p_op "Promote Phase 3 to canonical state"
text ct_p_opsig "operator_ed25519_key"

fn ct_test_grounding to int
cx_init
obs_id = new uchar 16 0
inf_id = new uchar 16 0
inf2_id = new uchar 16 0
tmp_id = new uchar 16 0

note 1. Record raw hardware observation
cx_stage_reset
rc = cx_stage_set_payload ct_r_uart
rc = cx_record_observation ct_s_obs ct_p_dt 100 obs_id
if ne rc CORTEX_OK
ret 1
end

note 2. Valid inference derived from observation
cx_stage_reset
rc = cx_stage_add_parent view obs_id
if ne rc CORTEX_OK
ret 2
end
cx_stage_set_conf 0.95f32
rc = cx_record_inference ct_s_inf1 ct_m_llama 101 inf_id
if ne rc CORTEX_OK
ret 3
end

note Deep grounded inference: inf2 -> inf -> obs
cx_stage_reset
rc = cx_stage_add_parent view inf_id
if ne rc CORTEX_OK
ret 4
end
cx_stage_set_conf 0.90f32
rc = cx_record_inference ct_s_inf2 ct_m_llama 102 inf2_id
if ne rc CORTEX_OK
ret 5
end

note 3. Hallucination test: ungrounded inference (no parents)
cx_stage_reset
cx_stage_set_conf 0.99f32
rc = cx_record_inference ct_s_hall ct_m_spec 103 tmp_id
if ne rc CORTEX_ERR_UNGROUNDED
ret 6
end

note 4. Circular inference with no ground truth (A <-> B)
cx_stage_reset
cx_stage_set_conf 0.8f32
rc = cx_stage_build CORTEX_INFERENCE ct_s_ca ct_m_circ 104
if ne rc CORTEX_OK
ret 7
end
id_a = new uchar 16 0
for i ulong 16
put id_a i get cx_st_id i
end
slot_a = cx_insert_staged
if lt slot_a 0
ret 8
end
cx_stage_reset
rc = cx_stage_add_parent view id_a
cx_stage_set_conf 0.8f32
rc = cx_stage_build CORTEX_INFERENCE ct_s_cb ct_m_circ 104
id_b = new uchar 16 0
for i ulong 16
put id_b i get cx_st_id i
end
slot_b = cx_insert_staged
if lt slot_b 0
ret 9
end
put cx_pcnt ulong slot_a 1
base_a = mul ulong slot_a mul CORTEX_MAX_PARENTS CORTEX_ID_LEN
for i ulong 16
put cx_parents add base_a i get id_b i
end
if ne cx_verify_slot ulong slot_a CORTEX_ERR_CIRCULAR
ret 10
end

note 5. Hallucination referencing non-existent parent
forged = new uchar 16 0xaa
cx_stage_reset
rc = cx_stage_add_parent view forged
cx_stage_set_conf 0.8f32
rc = cx_record_inference ct_s_forged ct_m_adv 105 tmp_id
if ne rc CORTEX_ERR_NOT_FOUND
ret 11
end

note 6. Mixed parent grounding rejection (obs + ungrounded premise)
cx_stage_reset
cx_stage_set_conf 0.9f32
rc = cx_stage_build CORTEX_INFERENCE ct_s_fab ct_m_mal 106
id_ungr = new uchar 16 0
for i ulong 16
put id_ungr i get cx_st_id i
end
slot_u = cx_insert_staged
if lt slot_u 0
ret 12
end
cx_stage_reset
rc = cx_stage_add_parent view obs_id
rc = cx_stage_add_parent view id_ungr
cx_stage_set_conf 0.85f32
rc = cx_record_inference ct_s_mix ct_m_hyb 107 tmp_id
if ne rc CORTEX_ERR_UNGROUNDED
ret 13
end

note 7. Transitive grounding: Observation -> Hypothesis -> Inference
cx_stage_reset
rc = cx_stage_add_parent view obs_id
rc = cx_record_hypothesis ct_s_hyp ct_a_exp 108 tmp_id
if ne rc CORTEX_OK
ret 14
end
cx_stage_reset
rc = cx_stage_add_parent view tmp_id
cx_stage_set_conf 0.95f32
rc = cx_record_inference ct_s_tr ct_m_rsn 109 inf_id
if ne rc CORTEX_OK
ret 15
end

note 8. Flag contradiction between opposing records
rc = cx_flag_contradiction view obs_id view id_ungr ct_reason 110 tmp_id
if ne rc CORTEX_OK
ret 16
end
slot_u = cx_find_by_id view tmp_id
if lt slot_u 0
ret 17
end
if ne get cx_status ulong slot_u CORTEX_CONTRADICTION
ret 18
end
ret 0
end

fn ct_test_persistence to int
cx_init
obs_id = new uchar 16 0
fact_id = new uchar 16 0
op_id = new uchar 16 0

cx_stage_reset
rc = cx_record_observation ct_p_obs ct_p_klog 100 obs_id
if ne rc CORTEX_OK
ret 20
end
cx_stage_reset
rc = cx_stage_add_parent view obs_id
rc = cx_stage_set_verifier ct_p_vtool
rc = cx_stage_set_payload ct_p_proof
rc = cx_record_verified_fact ct_p_fact ct_p_tsuite 101 fact_id
if ne rc CORTEX_OK
ret 21
end
rc = cx_record_operator_decision ct_p_op ct_p_opsig 102 op_id
if ne rc CORTEX_OK
ret 22
end

if ne cx_count_by_status CORTEX_DIRECT_OBSERVATION 1
ret 23
end
if ne cx_count_by_status CORTEX_VERIFIED_FACT 1
ret 24
end
if ne cx_count_by_status CORTEX_OPERATOR_DECISION 1
ret 25
end

jbuf = new uchar 4096 0
jlen = cx_export_journal jbuf
if le jlen 38
ret 26
end
cx_init
if ne get cx_cnt 0 0
ret 27
end
imported = cx_import_journal view jbuf ulong jlen
if ne imported 3
ret 28
end
if lt cx_find_by_id view obs_id 0
ret 29
end
if lt cx_find_by_id view fact_id 0
ret 30
end
if lt cx_find_by_id view op_id 0
ret 31
end

put jbuf 10 xor get jbuf 10 0xff
cx_init
if ne cx_import_journal view jbuf ulong jlen long CORTEX_ERR_CHECKSUM
ret 32
end
ret 0
end

fn main to int
rc = ct_test_grounding
if ne rc 0
ret rc
end
rc = ct_test_persistence
if ne rc 0
ret rc
end
ret 0
end

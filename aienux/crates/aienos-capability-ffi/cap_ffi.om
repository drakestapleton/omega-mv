note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-capability-ffi/cap_ffi.om: Pure-Omega 32-bit-generation
note capability authority ABI (aienos_cap32_*), layout contract, and split Admin/View handles.
note Converted from aienux crates/aienos-capability-ffi/src/lib.rs.
note Compose with: si/directives/om2.om aienux/crates/aienos-capability-ffi/cap_ffi.om ...

layout Cap32Ref 8
field cap_id uint at 0 little
field gen uint at 4 little
end

layout Cap32Ent 64
field cap_id uint at 0 little
field gen uint at 4 little
field state uint at 8 little
field issuer uint at 12 little
field subject uint at 16 little
field rights uint at 20 little
field res ulong at 24 little
field epoch ulong at 32 little
field lease ulong at 40 little
field par_id uint at 48 little
field par_gen uint at 52 little
field mnt_id uint at 56 little
field mnt_gen uint at 60 little
end

layout Cap32Mnt 48
field issuer uint at 0 little
field subject uint at 4 little
field res ulong at 8 little
field rights uint at 16 little
field lease ulong at 24 little
field par_id uint at 32 little
field par_gen uint at 36 little
field auth_id uint at 40 little
field auth_gen uint at 44 little
end

const CAP32_ABI_VERSION uint 1
const CAP32_GEN_BITS uint 32
const CAP32_REF_SIZE uint 8
const CAP32_REF_GEN_OFF uint 4
const CAP32_ENT_SIZE uint 64
const CAP32_MNT_SIZE uint 48

const CAP32_OK int 0
const CAP32_ERR_STATE int -1
const CAP32_ERR_NOT_FOUND int -2
const CAP32_ERR_STALE_GEN int -3
const CAP32_ERR_REVOKED int -4
const CAP32_ERR_EXPIRED int -5
const CAP32_ERR_SUBJECT int -6
const CAP32_ERR_RESOURCE int -7
const CAP32_ERR_RIGHTS int -8
const CAP32_ERR_UNAUTH int -9
const CAP32_ERR_EXHAUSTED int -10
const CAP32_ERR_CAPACITY int -11

const CAP32_STATE_FREE uint 0
const CAP32_STATE_ACTIVE uint 1
const CAP32_STATE_REVOKED uint 2

const CAP32_RIGHT_READ uint 1
const CAP32_RIGHT_WRITE uint 2
const CAP32_RIGHT_ADMIN uint 0x80000000

const CAP32_MAX_SLOTS ulong 32

note Global authority table
note meta: 0=active, 1=writer_alive, 2=boot_gen, 3=gen_floor, 4=clock, 5=epoch, 6=office_gen
global cap32_meta ulong 7
global cap32_s_gen uint 32
global cap32_s_state uint 32
global cap32_s_issuer uint 32
global cap32_s_subj uint 32
global cap32_s_rights uint 32
global cap32_s_res ulong 32
global cap32_s_epoch ulong 32
global cap32_s_lease ulong 32
global cap32_s_pid uint 32
global cap32_s_pgen uint 32
global cap32_s_mid uint 32
global cap32_s_mgen uint 32

note Report layout contract [REF_SIZE, REF_GEN_OFF, 4, ENT_SIZE] -> returns ABI version 1
fn cap32_abi_layout words edit uint * to uint
if lt len words 4
ret 0
end
put words 0 CAP32_REF_SIZE
put words 1 CAP32_REF_GEN_OFF
put words 2 4
put words 3 CAP32_ENT_SIZE
ret CAP32_ABI_VERSION
end

fn cap32_gen_advance g uint dst edit uint * to int
if eq g 0xffffffff
ret CAP32_ERR_EXHAUSTED
end
put dst 0 add g 1
ret CAP32_OK
end

fn cap32_bootstrap boot_gen uint to int
if eq boot_gen 0
ret CAP32_ERR_STATE
end
for i ulong CAP32_MAX_SLOTS
put cap32_s_gen i boot_gen
put cap32_s_state i CAP32_STATE_FREE
put cap32_s_issuer i 0
put cap32_s_subj i 0
put cap32_s_rights i 0
put cap32_s_res i 0
put cap32_s_epoch i 0
put cap32_s_lease i 0
put cap32_s_pid i 0
put cap32_s_pgen i 0
put cap32_s_mid i 0
put cap32_s_mgen i 0
end
note Slot 0 is the Office Authority capability
put cap32_s_state 0 CAP32_STATE_ACTIVE
put cap32_s_gen 0 boot_gen
put cap32_s_issuer 0 0
put cap32_s_subj 0 0
put cap32_s_rights 0 CAP32_RIGHT_ADMIN
put cap32_s_res 0 0
put cap32_s_epoch 0 1
put cap32_s_lease 0 0
put cap32_meta 0 1
put cap32_meta 1 1
put cap32_meta 2 ulong boot_gen
put cap32_meta 3 ulong boot_gen
put cap32_meta 4 0
put cap32_meta 5 1
put cap32_meta 6 ulong boot_gen
ret CAP32_OK
end

fn cap32_start to int
ret cap32_bootstrap 1
end

fn cap32_office dst edit Cap32Ref to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
put dst cap_id 0
put dst gen uint get cap32_meta 6
ret CAP32_OK
end

fn cap32_check_admin auth_id uint auth_gen uint to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
if eq get cap32_meta 1 0
ret CAP32_ERR_STATE
end
if ne auth_id 0
ret CAP32_ERR_UNAUTH
end
if ne auth_gen uint get cap32_meta 6
ret CAP32_ERR_STALE_GEN
end
if ne get cap32_s_state 0 CAP32_STATE_ACTIVE
ret CAP32_ERR_REVOKED
end
ret CAP32_OK
end

fn cap32_mint req view Cap32Mnt dst edit Cap32Ref to int
rc = cap32_check_admin get req auth_id get req auth_gen
if ne rc CAP32_OK
ret rc
end
slot = ulong CAP32_MAX_SLOTS
for i ulong sub CAP32_MAX_SLOTS 1
idx = add i 1
if eq get cap32_s_state idx CAP32_STATE_FREE
slot = idx
break
end
end
if eq slot CAP32_MAX_SLOTS
ret CAP32_ERR_CAPACITY
end
g = get cap32_s_gen slot
clk = get cap32_meta 4
l_ticks = get req lease
exp = ulong 0
if gt l_ticks 0
exp = add clk l_ticks
end
put cap32_s_state slot CAP32_STATE_ACTIVE
put cap32_s_issuer slot get req issuer
put cap32_s_subj slot get req subject
put cap32_s_rights slot get req rights
put cap32_s_res slot get req res
put cap32_s_epoch slot get cap32_meta 5
put cap32_s_lease slot exp
put cap32_s_pid slot get req par_id
put cap32_s_pgen slot get req par_gen
put cap32_s_mid slot get req auth_id
put cap32_s_mgen slot get req auth_gen
put dst cap_id uint slot
put dst gen g
ret CAP32_OK
end

fn cap32_revoke auth view Cap32Ref tgt view Cap32Ref to int
rc = cap32_check_admin get auth cap_id get auth gen
if ne rc CAP32_OK
ret rc
end
id = ulong get tgt cap_id
if or eq id 0 ge id CAP32_MAX_SLOTS
ret CAP32_ERR_NOT_FOUND
end
if ne get cap32_s_gen id get tgt gen
ret CAP32_ERR_STALE_GEN
end
if ne get cap32_s_state id CAP32_STATE_ACTIVE
ret CAP32_ERR_REVOKED
end
put cap32_s_state id CAP32_STATE_REVOKED
ret CAP32_OK
end

fn cap32_reclaim auth view Cap32Ref cid uint to int
rc = cap32_check_admin get auth cap_id get auth gen
if ne rc CAP32_OK
ret rc
end
id = ulong cid
if or eq id 0 ge id CAP32_MAX_SLOTS
ret CAP32_ERR_NOT_FOUND
end
if ne get cap32_s_state id CAP32_STATE_REVOKED
ret CAP32_ERR_STATE
end
cur_g = get cap32_s_gen id
nxt = new uint 1 0
rc = cap32_gen_advance cur_g nxt
if ne rc CAP32_OK
ret rc
end
ng = get nxt 0
put cap32_s_gen id ng
put cap32_s_state id CAP32_STATE_FREE
if gt ulong ng get cap32_meta 3
put cap32_meta 3 ulong ng
end
ret CAP32_OK
end

fn cap32_advance_clock auth view Cap32Ref ticks ulong to int
rc = cap32_check_admin get auth cap_id get auth gen
if ne rc CAP32_OK
ret rc
end
put cap32_meta 4 add get cap32_meta 4 ticks
ret CAP32_OK
end

fn cap32_bump_epoch auth view Cap32Ref to int
rc = cap32_check_admin get auth cap_id get auth gen
if ne rc CAP32_OK
ret rc
end
put cap32_meta 5 add get cap32_meta 5 1
ret CAP32_OK
end

fn cap32_kill to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
put cap32_meta 1 0
ret CAP32_OK
end

fn cap32_restart to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
flr = uint get cap32_meta 3
nxt = new uint 1 0
rc = cap32_gen_advance flr nxt
if ne rc CAP32_OK
ret rc
end
ret cap32_bootstrap get nxt 0
end

fn cap32_fill_ent id ulong dst edit Cap32Ent to void
put dst cap_id uint id
put dst gen get cap32_s_gen id
put dst state get cap32_s_state id
put dst issuer get cap32_s_issuer id
put dst subject get cap32_s_subj id
put dst rights get cap32_s_rights id
put dst res get cap32_s_res id
put dst epoch get cap32_s_epoch id
put dst lease get cap32_s_lease id
put dst par_id get cap32_s_pid id
put dst par_gen get cap32_s_pgen id
put dst mnt_id get cap32_s_mid id
put dst mnt_gen get cap32_s_mgen id
end

fn cap32_validate ref view Cap32Ref subj uint res ulong rights uint dst edit Cap32Ent to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
id = ulong get ref cap_id
if ge id CAP32_MAX_SLOTS
ret CAP32_ERR_NOT_FOUND
end
if ne get cap32_s_gen id get ref gen
ret CAP32_ERR_STALE_GEN
end
st = get cap32_s_state id
if eq st CAP32_STATE_FREE
ret CAP32_ERR_NOT_FOUND
end
if eq st CAP32_STATE_REVOKED
ret CAP32_ERR_REVOKED
end
exp = get cap32_s_lease id
if and gt exp 0 ge get cap32_meta 4 exp
ret CAP32_ERR_EXPIRED
end
if ne get cap32_s_subj id subj
ret CAP32_ERR_SUBJECT
end
if ne get cap32_s_res id res
ret CAP32_ERR_RESOURCE
end
if ne and get cap32_s_rights id rights rights
ret CAP32_ERR_RIGHTS
end
cap32_fill_ent id dst
ret CAP32_OK
end

fn cap32_inspect ref view Cap32Ref dst edit Cap32Ent to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
id = ulong get ref cap_id
if ge id CAP32_MAX_SLOTS
ret CAP32_ERR_NOT_FOUND
end
if ne get cap32_s_gen id get ref gen
ret CAP32_ERR_STALE_GEN
end
cap32_fill_ent id dst
ret CAP32_OK
end

fn cap32_clock to ulong
ret get cap32_meta 4
end

note View-side cognition attempts are unconditionally unauthorized
fn cap32_cognition_mint req view Cap32Mnt to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
ret CAP32_ERR_UNAUTH
end

fn cap32_cognition_admin op uint auth view Cap32Ref tgt view Cap32Ref to int
if eq get cap32_meta 0 0
ret CAP32_ERR_STATE
end
ret CAP32_ERR_UNAUTH
end

fn cap32_force_gen cid uint g uint to int
id = ulong cid
if ge id CAP32_MAX_SLOTS
ret CAP32_ERR_NOT_FOUND
end
put cap32_s_gen id g
if gt ulong g get cap32_meta 3
put cap32_meta 3 ulong g
end
ret CAP32_OK
end

note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-capability-ffi/cap_ffi_test.om: Behavioral self-test for aienos-capability-ffi.
note Compose with: si/directives/om2.om aienux/crates/aienos-capability-ffi/cap_ffi.om aienux/crates/aienos-capability-ffi/cap_ffi_test.om

fn t_ref_id r view Cap32Ref to uint
ret get r cap_id
end

fn t_ref_gen r view Cap32Ref to uint
ret get r gen
end

fn t_ent_subj e view Cap32Ent to uint
ret get e subject
end

fn t_fill_mnt req edit Cap32Mnt office view Cap32Ref to void
put req issuer 1
put req subject 42
put req res 0x1000
put req rights CAP32_RIGHT_READ
put req lease 100
put req par_id 0
put req par_gen 0
put req auth_id get office cap_id
put req auth_gen get office gen
end

fn main to int
note 1. ABI layout contract matches 32-bit cap32 ABI [8, 4, 4, 64] and version 1
words = new uint 4 0
ver = cap32_abi_layout words
if ne ver CAP32_ABI_VERSION
ret 1
end
if ne get words 0 8
ret 2
end
if ne get words 1 4
ret 3
end
if ne get words 2 4
ret 4
end
if ne get words 3 64
ret 5
end

note 2. Start authority and fetch office ref
if ne cap32_start CAP32_OK
ret 9
end
office = new uchar 8 0
if ne cap32_office office CAP32_OK
ret 10
end

note 3. Mint a capability and validate it
req = new uchar 48 0
t_fill_mnt req office
cap = new uchar 8 0
if ne cap32_mint req cap CAP32_OK
ret 11
end

ent = new uchar 64 0
if ne cap32_validate cap 42 0x1000 CAP32_RIGHT_READ ent CAP32_OK
ret 12
end
if ne t_ent_subj ent 42
ret 13
end

note 4. Wrong subject and wrong rights refused
if ne cap32_validate cap 99 0x1000 CAP32_RIGHT_READ ent CAP32_ERR_SUBJECT
ret 14
end
if ne cap32_validate cap 42 0x1000 CAP32_RIGHT_WRITE ent CAP32_ERR_RIGHTS
ret 15
end

note 5. Cognition mint/admin unconditionally unauthorized
if ne cap32_cognition_mint req CAP32_ERR_UNAUTH
ret 16
end
if ne cap32_cognition_admin 1 office cap CAP32_ERR_UNAUTH
ret 17
end

note 6. Clock advance expires lease
if ne cap32_advance_clock office 100 CAP32_OK
ret 18
end
if ne cap32_clock 100
ret 19
end
if ne cap32_validate cap 42 0x1000 CAP32_RIGHT_READ ent CAP32_ERR_EXPIRED
ret 20
end

note 7. Revoke, reclaim bumps generation, old ref becomes STALE_GEN
if ne cap32_revoke office cap CAP32_OK
ret 21
end
if ne cap32_reclaim office t_ref_id cap CAP32_OK
ret 22
end
if ne cap32_validate cap 42 0x1000 CAP32_RIGHT_READ ent CAP32_ERR_STALE_GEN
ret 23
end

note 8. Generation exhaustion at 0xffffffff
nxt = new uint 1 0
if ne cap32_gen_advance 0xffffffff nxt CAP32_ERR_EXHAUSTED
ret 24
end

note 9. Restart advances boot generation above floor, invalidating old office ref
if ne cap32_restart CAP32_OK
ret 25
end
new_off = new uchar 8 0
if ne cap32_office new_off CAP32_OK
ret 26
end
if le t_ref_gen new_off t_ref_gen office
ret 27
end
if ne cap32_bump_epoch office CAP32_ERR_STALE_GEN
ret 28
end
if ne cap32_bump_epoch new_off CAP32_OK
ret 29
end

ret 0
end

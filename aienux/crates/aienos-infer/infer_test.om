note Entry point
note ========================================================================

fn main to int
rc = test_half
if ne rc 0
ret rc
end
rc = test_math_core
if ne rc 0
ret rc
end
rc = test_rope
if ne rc 0
ret rc
end
rc = test_quant
if ne rc 0
ret rc
end
rc = test_dotprod
if ne rc 0
ret rc
end

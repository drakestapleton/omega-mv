note aienux/crates/aienos-infer/infer_test.om: Behavioral self-test for pure-Omega aienos-infer.
note Compose with: si/directives/om2.om aienux/crates/aienos-infer/infer_core.om aienux/crates/aienos-infer/infer_decode.om aienux/crates/aienos-infer/infer_test.om

note ========================================================================
note Test helpers: little-endian writers, PRNG, GGUF builder
note ========================================================================

fn tst_put_u16 buf edit uchar * pos ulong v ushort to ulong
put buf pos uchar and v ushort 0xff
put buf add pos 1 uchar and shr v 8 ushort 0xff
ret add pos 2
end

fn tst_put_u32 buf edit uchar * pos ulong v uint to ulong
put buf pos uchar and v 0xff
put buf add pos 1 uchar and shr v 8 0xff
put buf add pos 2 uchar and shr v 16 0xff
put buf add pos 3 uchar and shr v 24 0xff
ret add pos 4
end

fn tst_put_u64 buf edit uchar * pos ulong v ulong to ulong
for i ulong 8
put buf add pos i uchar and shr v mul i 8 0xff
end
ret add pos 8
end

fn tst_put_f32 buf edit uchar * pos ulong v f32 to ulong
ret tst_put_u32 buf pos bitcast uint v
end

fn tst_put_bytes buf edit uchar * pos ulong s view uchar * to ulong
n = len s
for i ulong n bound 256
put buf add pos i get s i
end
ret add pos n
end

fn tst_put_str buf edit uchar * pos ulong s view uchar * to ulong
p = tst_put_u64 buf pos len s
ret tst_put_bytes buf p s
end

fn tst_kv_u32 buf edit uchar * pos ulong key view uchar * v uint to ulong
p = tst_put_str buf pos key
p = tst_put_u32 buf p INF_VT_U32
ret tst_put_u32 buf p v
end

fn tst_kv_f32 buf edit uchar * pos ulong key view uchar * v f32 to ulong
p = tst_put_str buf pos key
p = tst_put_u32 buf p INF_VT_F32
ret tst_put_f32 buf p v
end

fn tst_gguf_hdr buf edit uchar * ver uint nt ulong nk ulong to ulong
put buf 0 uchar 71
put buf 1 uchar 71
put buf 2 uchar 85
put buf 3 uchar 70
p = tst_put_u32 buf 4 ver
p = tst_put_u64 buf p nt
ret tst_put_u64 buf p nk
end

fn tst_meta1 meta edit ulong 5 d0 ulong ty uint off ulong to void
put meta 0 1
put meta 1 d0
put meta 2 0
put meta 3 ulong ty
put meta 4 off
end

fn tst_meta2 meta edit ulong 5 d0 ulong d1 ulong ty uint off ulong to void
put meta 0 2
put meta 1 d0
put meta 2 d1
put meta 3 ulong ty
put meta 4 off
end

fn tst_put_tensor buf edit uchar * pos ulong name view uchar * meta view ulong 5 to ulong
note meta: [n_dims, d0, d1, ty, off]
p = tst_put_str buf pos name
nd = get meta 0
p = tst_put_u32 buf p uint nd
if ge nd 1
p = tst_put_u64 buf p get meta 1
end
if ge nd 2
p = tst_put_u64 buf p get meta 2
end
p = tst_put_u32 buf p uint get meta 3
ret tst_put_u64 buf p get meta 4
end

fn tst_align32 buf edit uchar * pos ulong to ulong
p = pos
while ne rem p 32 0 bound 32
put buf p uchar 0
p = add p 1
end
ret p
end

fn tst_rng_next st edit ulong 1 to ulong
x = get st 0
x = xor x shr x 12
x = xor x shl x 25
x = xor x shr x 27
put st 0 x
ret mul x ulong 0x2545f4914f6cdd1d
end

fn tst_rng_byte st edit ulong 1 to uchar
ret uchar and shr tst_rng_next st 32 0xff
end

fn tst_rng_unit st edit ulong 1 to f32
u = shr tst_rng_next st 40
ret sub mul div f32 u 16777216.0f32 2.0f32 1.0f32
end

fn tst_lcg st edit ulong 1 to f32
s = add mul get st 0 ulong 6364136223846793005 ulong 1442695040888963407
put st 0 s
u = shr s 33
ret sub mul div f32 u 2147483648.0f32 2.0f32 1.0f32
end

fn tst_rel a f32 b f32 to f32
ret div fabs sub a b fmax fabs b 1.0e-30f32
end

note ========================================================================
note 1. Half precision tests (exit 1..15)
note ========================================================================

fn test_half to int
if ne inf_f16_to_f32 ushort 0x0000 0.0f32
ret 1
end
if ne inf_f16_to_f32 ushort 0x3c00 1.0f32
ret 2
end
if ne inf_f16_to_f32 ushort 0xc000 -2.0f32
ret 3
end
if ne inf_f16_to_f32 ushort 0x3800 0.5f32
ret 4
end
if ne inf_f16_to_f32 ushort 0x7bff 65504.0f32
ret 5
end
if ne bitcast uint inf_f16_to_f32 ushort 0x0400 uint 0x38800000
ret 6
end
if ne bitcast uint inf_f16_to_f32 ushort 0x0001 uint 0x33800000
ret 7
end
if ne inf_f16_to_f32 ushort 0x03ff div 1023.0f32 16777216.0f32
ret 8
end
if ne bitcast uint inf_f16_to_f32 ushort 0x7c00 uint 0x7f800000
ret 9
end
if ne bitcast uint inf_f16_to_f32 ushort 0xfc00 uint 0xff800000
ret 10
end
nanv = inf_f16_to_f32 ushort 0x7e00
if eq nanv nanv
ret 11
end
if ne bitcast uint inf_f16_to_f32 ushort 0x8000 uint 0x80000000
ret 12
end
if ne inf_bf16_to_f32 ushort 0x3f80 1.0f32
ret 13
end
if ne inf_bf16_to_f32 ushort 0xc000 -2.0f32
ret 14
end
if ne inf_f32_to_f16 1.5f32 ushort 0x3e00
ret 15
end
ret 0
end

note ========================================================================
note 2. Math + NN primitives + RoPE tests (exit 20..39)
note ========================================================================

fn tst_dot_f32 a view f32 * b view f32 * to f32
n = len a
acc = f32 0.0f32
for i ulong n bound 1024
acc = add acc mul get a i get b i
end
ret acc
end

fn tst_norm2_f32 a view f32 * to f32
n = len a
acc = f32 0.0f32
for i ulong n bound 1024
v = get a i
acc = add acc mul v v
end
ret acc
end

fn test_math_core to int
if ne inf_sqrt -1.0f32 0.0f32
ret 20
end
xs = new f32 6 0.0f32
put xs 0 1.0e-8f32
put xs 1 0.25f32
put xs 2 1.0f32
put xs 3 2.0f32
put xs 4 1234.5f32
put xs 5 1.0e9f32
for i ulong 6
v = get xs i
if ge tst_rel inf_sqrt v fsqrt v 2.0e-7f32
ret 21
end
end
if gt fabs sub inf_exp 0.0f32 1.0f32 1.0e-6f32
ret 22
end
if gt fabs sub inf_exp 1.0f32 2.7182818f32 2.0e-6f32
ret 23
end
if gt fabs sub inf_ln 2.0f32 0.69314718f32 2.0e-6f32
ret 24
end
note exp(ln(x)) == x across decades
lx = f32 1.0e-4f32
for i ulong 40
rt = inf_exp inf_ln lx
if gt tst_rel rt lx 5.0e-6f32
ret 25
end
lx = mul lx 1.6f32
end
note Llama-3.2 rope theta scale powf(500000, -2/64)
ts = inf_powf 500000.0f32 div -2.0f32 64.0f32
if gt tst_rel ts 0.66360124f32 2.0e-6f32
ret 26
end
note sin_cos unit norm and known points
sc = new f32 2 0.0f32
ang = f32 -50.0f32
for i ulong 150
inf_sin_cos ang sc
s = get sc 0
c = get sc 1
if gt fabs sub add mul s s mul c c 1.0f32 1.0e-5f32
ret 27
end
ang = add ang 4.37f32
end
inf_sin_cos INF_FRAC_PI_2 sc
if gt fabs sub get sc 0 1.0f32 2.0e-5f32
ret 28
end
if gt fabs get sc 1 2.0e-5f32
ret 28
end
note silu
if gt fabs inf_silu 0.0f32 1.0e-6f32
ret 29
end
if gt fabs sub inf_silu 1.0f32 0.7310586f32 2.0e-6f32
ret 29
end
note rms_norm_inplace
rx = new f32 2 0.0f32
rw = new f32 2 0.0f32
put rx 0 3.0f32
put rx 1 4.0f32
put rw 0 1.0f32
put rw 1 2.0f32
inf_rms_norm_inplace rx rw 0.0f32
inv_r = div 1.0f32 fsqrt 12.5f32
if gt fabs sub get rx 0 mul 3.0f32 inv_r 1.0e-5f32
ret 30
end
if gt fabs sub get rx 1 mul 8.0f32 inv_r 1.0e-5f32
ret 30
end
note softmax shift invariance + argmax
sm1 = new f32 4 0.0f32
sm2 = new f32 4 0.0f32
put sm1 0 1.0f32
put sm1 1 3.0f32
put sm1 2 3.0f32
put sm1 3 -2.0f32
if ne inf_argmax sm1 4 uint 1
ret 31
end
for i ulong 4
put sm2 i add get sm1 i 100.0f32
end
inf_softmax sm1 4
inf_softmax sm2 4
ssum = f32 0.0f32
for i ulong 4
ssum = add ssum get sm1 i
if gt fabs sub get sm1 i get sm2 i 1.0e-5f32
ret 32
end
end
if gt fabs sub ssum 1.0f32 1.0e-5f32
ret 32
end
ret 0
end

fn tst_rot8 src view f32 8 pos ulong dst edit f32 8 to void
cs = new f32 8 0.0f32
empty = new f32 1 0.0f32
inf_rope_cache pos 10000.0f32 part empty 0 0 cs
for i ulong 8
put dst i get src i
end
inf_rope_apply dst 8 cs
end

fn test_rope to int
note Pair 0 rotates by position angle; pos 0 is identity
x = new f32 8 0.0f32
y = new f32 8 0.0f32
put x 0 1.0f32
tst_rot8 x 1 y
sc = new f32 2 0.0f32
inf_sin_cos 1.0f32 sc
if gt fabs sub get y 0 get sc 1 1.0e-5f32
ret 33
end
if gt fabs sub get y 1 get sc 0 1.0e-5f32
ret 33
end
tst_rot8 x 0 y
if ne get y 0 1.0f32
ret 34
end
if ne get y 1 0.0f32
ret 34
end
note Relative position invariance & norm preservation
seed = new ulong 1 0x5eed
q = new f32 8 0.0f32
k = new f32 8 0.0f32
rq = new f32 8 0.0f32
rk = new f32 8 0.0f32
for i ulong 8
put q i tst_lcg seed
put k i tst_lcg seed
end
tst_rot8 q 11 rq
tst_rot8 k 11 rk
if gt fabs sub tst_dot_f32 rq rk tst_dot_f32 q k 1.0e-4f32
ret 35
end
tst_rot8 q 5 rq
tst_rot8 k 2 rk
da = tst_dot_f32 rq rk
tst_rot8 q 13 rq
tst_rot8 k 10 rk
db = tst_dot_f32 rq rk
tst_rot8 q 5 rq
tst_rot8 k 3 rk
dc = tst_dot_f32 rq rk
if gt fabs sub da db 1.0e-4f32
ret 36
end
if le fabs sub da dc 1.0e-3f32
ret 37
end
tst_rot8 q 97 rq
if gt fabs sub tst_norm2_f32 rq tst_norm2_f32 q 1.0e-4f32
ret 38
end
ret 0
end

note ========================================================================
note 3. Quantization tests: Q4_K, Q6_K, Q8_0 (exit 40..55)
note ========================================================================

fn test_quant to int
note q4k_hand_block
b4 = new uchar 144 0
put b4 0 uchar 0x00
put b4 1 uchar 0x3c
put b4 2 uchar 0x00
put b4 3 uchar 0x3c
for j ulong 4
put b4 add 4 j uchar add j 1
put b4 add 8 j uchar j
end
for j ulong 4
sb = add j 4
put b4 add 12 j or uchar add sb 1 shl uchar sb 4
end
for l ulong 128
lo = uchar rem l 16
put b4 add 16 l or lo shl sub uchar 15 lo 4
end
w = new f32 256 0.0f32
inf_dequant_q4k_block b4 0 w 0
for sb ulong 8
sc = f32 add sb 1
mn = f32 sb
for l ulong 32
lo = f32 rem l 16
qv = lo
if ne rem sb 2 0
qv = sub 15.0f32 lo
end
want = sub mul sc qv mn
if ne get w add mul 32 sb l want
ret 40
end
end
end
note q4k_scale_extension_bits
b4e = new uchar 144 0
put b4e 0 uchar 0x00
put b4e 1 uchar 0x3c
put b4e 2 uchar 0x00
put b4e 3 uchar 0x3c
put b4e 4 shl uchar 3 6
put b4e 8 shl uchar 2 6
put b4e 12 or uchar 0x0f shl uchar 2 4
for l ulong 128
put b4e add 16 l uchar 0x11
end
inf_dequant_q4k_block b4e 0 w 0
if ne get w 128 29.0f32
ret 41
end
if ne get w 0 0.0f32
ret 42
end
note q6k_hand_block
b6 = new uchar 210 0
put b6 208 uchar 0x00
put b6 209 uchar 0x3c
for i ulong 16
put b6 add 192 i uchar 1
end
inf_dequant_q6k_block b6 0 w 0
for i ulong 256
if ne get w i -32.0f32
ret 43
end
end
put b6 0 uchar 0x5a
put b6 128 uchar 0xe4
inf_dequant_q6k_block b6 0 w 0
if ne get w 0 -22.0f32
ret 44
end
if ne get w 64 5.0f32
ret 44
end
if ne get w 32 -16.0f32
ret 44
end
if ne get w 96 16.0f32
ret 44
end
note q6k_scales_are_signed_and_per_16
b6s = new uchar 210 0
put b6s 208 uchar 0x00
put b6s 209 uchar 0x3c
for i ulong 16
sv = sub int i 8
if lt sv 0
put b6s add 192 i uchar add sv 256
else
put b6s add 192 i uchar sv
end
end
inf_dequant_q6k_block b6s 0 w 0
for p ulong 256
want = add mul f32 div p 16 -32.0f32 256.0f32
if ne get w p want
ret 45
end
end
note q8_0_hand_block + dot_row
b8 = new uchar 34 0
put b8 0 uchar 0x00
put b8 1 uchar 0x38
for l ulong 32
sv = sub int l 16
if lt sv 0
put b8 add 2 l uchar add sv 256
else
put b8 add 2 l uchar sv
end
end
w8 = new f32 32 0.0f32
if ne inf_dequantize INF_GGML_Q8_0 b8 w8 INF_OK
ret 46
end
for l ulong 32
want = mul 0.5f32 f32 sub int l 16
if ne get w8 l want
ret 47
end
end
x8 = new f32 32 1.0f32
res = new f32 1 0.0f32
if ne inf_dot_row INF_GGML_Q8_0 b8 x8 res INF_OK
ret 48
end
if ne get res 0 -8.0f32
ret 49
end
note Length & unsupported checks
if ne inf_dequantize INF_GGML_Q4K part b4 0 143 w INF_QUANT_BAD_LEN
ret 50
end
b5 = new uchar 176 0
if ne inf_dequantize INF_GGML_Q5K b5 w INF_QUANT_UNSUPPORTED
ret 51
end
b4z = new uchar 144 0
x256 = new f32 256 1.0f32
if ne inf_dot_row INF_GGML_Q4K b4z x256 res INF_OK
ret 52
end
if ne get res 0 0.0f32
ret 53
end
ret 0
end

note ========================================================================
note 4. Dotprod Q8_K quantization & integer dot tests (exit 60..75)
note ========================================================================

fn tst_fill_q4k st edit ulong 1 fill uint blk edit uchar 144 to void
for i ulong 144
put blk i tst_rng_byte st
end
if eq fill 1
for i ulong 12
put blk add 4 i uchar 0xff
end
end
if eq fill 2
for i ulong 12
put blk add 4 i uchar 0
end
end
if eq fill 3
for i ulong 140
put blk add 4 i uchar 0xff
end
end
if eq fill 4
for i ulong 140
put blk add 4 i uchar 0
end
end
d0 = mul 0.0625f32 f32 add 1 rem ulong tst_rng_byte st 8
d1 = mul 0.03125f32 f32 add 1 rem ulong tst_rng_byte st 8
h0 = inf_f32_to_f16 d0
h1 = inf_f32_to_f16 d1
put blk 0 uchar and h0 ushort 0xff
put blk 1 uchar shr h0 8
put blk 2 uchar and h1 ushort 0xff
put blk 3 uchar shr h1 8
end

fn tst_fill_q6k st edit ulong 1 fill uint blk edit uchar 210 to void
for i ulong 210
put blk i tst_rng_byte st
end
if eq fill 1
for i ulong 16
if eq rem i 2 0
put blk add 192 i uchar 127
else
put blk add 192 i uchar 0x80
end
end
end
if eq fill 2
for i ulong 16
put blk add 192 i uchar 0
end
end
if eq fill 3
for i ulong 192
put blk i uchar 0xff
end
end
if eq fill 4
for i ulong 192
put blk i uchar 0
end
end
d0 = mul 0.0625f32 f32 add 1 rem ulong tst_rng_byte st 8
h0 = inf_f32_to_f16 d0
put blk 208 uchar and h0 ushort 0xff
put blk 209 uchar shr h0 8
end

fn test_dotprod to int
note Capability toggle
inf_set_cpu_dotprod false
if inf_cpu_dotprod
ret 60
end
inf_set_cpu_dotprod true
if not inf_cpu_dotprod
ret 61
end
inf_set_cpu_dotprod false
note quantize_matches_q8k_round_and_sums
rng = new ulong 1 0x123456789abcdef1
x = new f32 512 0.0f32
xr = new f32 512 0.0f32
for i ulong 512
v = mul tst_rng_unit rng 3.0f32
put x i v
put xr i v
end
if ne inf_q8_quantize x 512 INF_OK
ret 62
end
inf_q8k_round xr 512
for i ulong 512
if ne bitcast uint inf_q8_value i bitcast uint get xr i
ret 63
end
end
note all-zero block
xz = new f32 256 0.0f32
if ne inf_q8_quantize xz 256 INF_OK
ret 64
end
if ne inf_q8_value 0 0.0f32
ret 64
end
note bad length
x100 = new f32 100 0.0f32
if ne inf_q8_quantize x100 100 INF_QUANT_BAD_LEN
ret 65
end
note q4k_hand_computed_scale_application
bh = new uchar 144 0
put bh 0 uchar 0x00
put bh 1 uchar 0x3c
put bh 2 uchar 0x00
put bh 3 uchar 0x3c
for j ulong 4
put bh add 4 j uchar add j 1
put bh add 8 j uchar j
end
for j ulong 4
sb = add j 4
put bh add 12 j or uchar add sb 1 shl uchar sb 4
end
for l ulong 128
put bh add 16 l uchar 0x33
end
xone = new f32 256 1.0f32
if ne inf_q8_quantize xone 256 INF_OK
ret 66
end
acc = new int 2 0
inf_q4k_accum bh 0 0 acc
note sumi = 36 * 3 * 32 * -127 = -438912, mins = 28 * 32 * -127 = -113792
if ne get acc 0 int -438912
ret 67
end
if ne get acc 1 int -113792
ret 68
end
got_h = inf_dot_q4k_q8 bh 0 0
note truth = sum_{s=0..7} ((s+1)*3 - s)*32 = (108 - 28)*32 = 2560
if gt fabs sub got_h 2560.0f32 1.0e-2f32
ret 69
end
ret 0
end

fn test_dotprod_blocks to int
note Q4_K and Q6_K integer dot matches f32 dot of rounded activations across all 5 fills
rng = new ulong 1 0xdeadbeef0001
b4 = new uchar 144 0
b6 = new uchar 210 0
w = new f32 256 0.0f32
xa = new f32 256 0.0f32
for n ulong 25
tst_fill_q4k rng uint rem n 5 b4
tst_fill_q6k rng uint rem n 5 b6
for i ulong 256
put xa i mul tst_rng_unit rng 3.0f32
end
if ne inf_q8_quantize xa 256 INF_OK
ret 70
end
inf_q8k_round xa 256
inf_dequant_q4k_block b4 0 w 0
want4 = tst_dot_f32 w xa
got4 = inf_dot_q4k_q8 b4 0 0
if gt fabs sub got4 want4 5.0e-2f32
ret 71
end
inf_dequant_q6k_block b6 0 w 0
want6 = tst_dot_f32 w xa
got6 = inf_dot_q6k_q8 b6 0 0
if gt fabs sub got6 want6 5.0e-2f32
ret 72
end
end
note Multi-block row dot
res_q8 = new f32 1 0.0f32
res_f32 = new f32 1 0.0f32
if ne inf_q8_quantize xa 256 INF_OK
ret 73
end
if ne inf_dot_row_q8 INF_GGML_Q4K b4 res_q8 INF_OK
ret 73
end
if ne inf_dot_row INF_GGML_Q4K b4 xa res_f32 INF_OK
ret 73
end
if gt fabs sub get res_q8 0 get res_f32 0 5.0e-2f32
ret 74
end
if ne inf_dot_row_q8 INF_GGML_F32 b4 res_q8 INF_QUANT_UNSUPPORTED
ret 75
end
ret 0
end

note ========================================================================
note 5. GGUF v2/v3 & hostile-input tests (exit 80..98)
note ========================================================================

text tst_k_ab "a.b"
text tst_k_toks "tokens"
text tst_k_nope "nope"
text tst_s_hi "hi"
text tst_s_yo "yo"
text tst_t_w "w"
text tst_k_k "k"

fn tst_build_small buf edit uchar * ver uint to ulong
p = tst_gguf_hdr buf ver 1 2
p = tst_kv_u32 buf p tst_k_ab 7
p = tst_put_str buf p tst_k_toks
p = tst_put_u32 buf p INF_VT_ARRAY
p = tst_put_u32 buf p INF_VT_STR
p = tst_put_u64 buf p 2
p = tst_put_str buf p tst_s_hi
p = tst_put_str buf p tst_s_yo
meta = new ulong 5 0
put meta 0 1
put meta 1 256
put meta 3 ulong INF_GGML_Q4K
put meta 4 0
p = tst_put_tensor buf p tst_t_w meta
p = tst_align32 buf p
for i ulong 144
put buf add p i uchar 0
end
ret add p 144
end

fn test_gguf to int
buf = new uchar 512 0
g = new InfGguf 0 0 0 0 0 0
u32b = new uint 1 0
note Valid v3
flen = tst_build_small buf 3
if ne inf_gguf_parse part buf 0 flen g INF_OK
ret 80
end
if ne get g version 3
ret 81
end
if ne inf_gguf_u32_key g part buf 0 flen tst_k_ab u32b INF_OK
ret 82
end
if ne get u32b 0 7
ret 82
end
if ne inf_gguf_u32_key g part buf 0 flen tst_k_nope u32b INF_GGUF_MISSING
ret 83
end
ti = inf_gguf_find_tensor g part buf 0 flen tst_t_w
if lt ti 0
ret 84
end
if ne get inf_ten_nbytes ulong ti 144
ret 84
end
note Every truncation 0..flen-1 must fail cleanly
for n ulong flen bound 512
if eq inf_gguf_parse part buf 0 n g INF_OK
ret 85
end
end
note Valid v2 accepted by inf_gguf_parse, rejected by inf_gguf_parse_v3
flen2 = tst_build_small buf 2
if ne inf_gguf_parse part buf 0 flen2 g INF_OK
ret 86
end
if ne get g version 2
ret 86
end
if ne inf_gguf_parse_v3 part buf 0 flen2 g INF_GGUF_BAD_VERSION
ret 87
end
note Unsupported versions 1 and 4
flen1 = tst_build_small buf 1
if ne inf_gguf_parse part buf 0 flen1 g INF_GGUF_BAD_VERSION
ret 88
end
flen4 = tst_build_small buf 4
if ne inf_gguf_parse part buf 0 flen4 g INF_GGUF_BAD_VERSION
ret 88
end
note Bad magic
flen = tst_build_small buf 3
put buf 0 uchar 88
if ne inf_gguf_parse part buf 0 flen g INF_GGUF_BAD_MAGIC
ret 89
end
note TooMany counts
p = tst_gguf_hdr buf 3 ulong 0xffffffffffffffff 0
if ne inf_gguf_parse part buf 0 p g INF_GGUF_TOO_MANY
ret 90
end
note Misaligned tensor offset
meta = new ulong 5 0
p = tst_gguf_hdr buf 3 1 0
put meta 0 1
put meta 1 256
put meta 3 ulong INF_GGML_Q4K
put meta 4 16
p = tst_put_tensor buf p tst_t_w meta
p = tst_align32 buf p
p = add p 256
if ne inf_gguf_parse part buf 0 p g INF_GGUF_TENSOR_OOB
ret 91
end
note Bad alignment (0 and 3)
p = tst_gguf_hdr buf 3 0 1
p = tst_kv_u32 buf p inf_key_alignment 0
p = tst_align32 buf p
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_ALIGN
ret 92
end
p = tst_gguf_hdr buf 3 0 1
p = tst_kv_u32 buf p inf_key_alignment 3
p = tst_align32 buf p
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_ALIGN
ret 93
end
note Bad dims (row not multiple of block)
p = tst_gguf_hdr buf 3 1 0
put meta 0 1
put meta 1 255
put meta 3 ulong INF_GGML_Q4K
put meta 4 0
p = tst_put_tensor buf p tst_t_w meta
p = tst_align32 buf p
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_DIMS
ret 94
end
note Unknown tensor type 99
p = tst_gguf_hdr buf 3 1 0
put meta 0 1
put meta 1 32
put meta 3 99
put meta 4 0
p = tst_put_tensor buf p tst_t_w meta
p = tst_align32 buf p
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_TYPE
ret 95
end
note Unknown KV value type 77
p = tst_gguf_hdr buf 3 0 1
p = tst_put_str buf p tst_k_k
p = tst_put_u32 buf p 77
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_VTYPE
ret 96
end
note Invalid UTF-8 key
p = tst_gguf_hdr buf 3 0 1
p = tst_put_u64 buf p 2
put buf p uchar 0xff
put buf add p 1 uchar 0xfe
p = add p 2
p = tst_put_u32 buf p INF_VT_U32
p = tst_put_u32 buf p 0
if ne inf_gguf_parse part buf 0 p g INF_GGUF_BAD_UTF8
ret 97
end
ret 0
end

note ========================================================================
note 6. Tokenizer tests: GPT-2 byte map, pretokenizer, BPE, chat, decode (exit 100..118)
note ========================================================================

text tst_pt_hw "Hello world"
text tst_pt_con "it's I'M we'LL"
text tst_pt_dig "a1234b"
text tst_pt_ws "x  y"
text tst_pt_nl "end.\n\nnext"

text tst_tok_bos "<|begin_of_text|>"
text tst_tok_sh "<|start_header_id|>"
text tst_tok_eh "<|end_header_id|>"
text tst_tok_eot "<|eot_id|>"
text tst_tok_user "user"
text tst_tok_asst "assistant"
text tst_tok_h "h"
text tst_tok_i "i"
text tst_tok_hi "hi"
text tst_tok_ex "!"
text tst_tok_hiex "hi!"
text tst_mrg_hi "h i"
text tst_mrg_hiex "hi !"
text tst_msg_hi "hi!"
text tst_msg_dec "hi!"

fn tst_put_tok_str buf edit uchar * pos ulong cp uint to ulong
tmp = new uchar 4 0
n = inf_utf8_encode cp tmp 0
p = tst_put_u64 buf pos n
for i ulong n bound 4
put buf add p i get tmp i
end
ret add p n
end

fn test_tokenizer to int
note GPT-2 byte map checks + full 0..255 round trip
if ne inf_byte_to_cp uchar 65 uint 65
ret 100
end
if ne inf_byte_to_cp uchar 32 uint 0x0120
ret 100
end
if ne inf_byte_to_cp uchar 10 uint 0x010a
ret 100
end
if ne inf_byte_to_cp uchar 0 uint 0x0100
ret 100
end
if ne inf_byte_to_cp uchar 127 uint 0x0121
ret 100
end
if ne inf_byte_to_cp uchar 173 uint 0x0143
ret 100
end
for b ulong 256
cp = inf_byte_to_cp uchar b
if ne inf_cp_to_byte cp int b
ret 101
end
end
note Pretokenizer spot checks
if ne inf_pretokenize_one tst_pt_hw 0 5
ret 102
end
if ne inf_pretokenize_one tst_pt_hw 5 6
ret 102
end
if ne inf_pretokenize_one tst_pt_con 0 2
ret 103
end
if ne inf_pretokenize_one tst_pt_con 2 2
ret 103
end
if ne inf_pretokenize_one tst_pt_dig 0 1
ret 104
end
if ne inf_pretokenize_one tst_pt_dig 1 3
ret 104
end
if ne inf_pretokenize_one tst_pt_dig 4 1
ret 104
end
if ne inf_pretokenize_one tst_pt_ws 0 1
ret 105
end
if ne inf_pretokenize_one tst_pt_ws 1 1
ret 105
end
if ne inf_pretokenize_one tst_pt_ws 2 2
ret 105
end
if ne inf_pretokenize_one tst_pt_nl 0 3
ret 106
end
if ne inf_pretokenize_one tst_pt_nl 3 3
ret 106
end
note Build synthetic GGUF with mini BPE vocabulary (14 tokens, 2 merges)
note 0:<|begin_of_text|> (ctrl), 1:<|start_header_id|> (ctrl), 2:<|end_header_id|> (ctrl),
note 3:<|eot_id|> (ctrl), 4:user, 5:assistant, 6:\n (U+010A), 7:\n\n (U+010A U+010A),
note 8:h, 9:i, 10:hi, 11:!, 12:hi!, 13:space (U+0120)
buf = new uchar 2048 0
p = tst_gguf_hdr buf 3 0 5
p = tst_put_str buf p inf_key_tokens
p = tst_put_u32 buf p INF_VT_ARRAY
p = tst_put_u32 buf p INF_VT_STR
p = tst_put_u64 buf p 14
p = tst_put_str buf p tst_tok_bos
p = tst_put_str buf p tst_tok_sh
p = tst_put_str buf p tst_tok_eh
p = tst_put_str buf p tst_tok_eot
p = tst_put_str buf p tst_tok_user
p = tst_put_str buf p tst_tok_asst
p = tst_put_tok_str buf p 0x010a
note token 7: two U+010A (4 bytes: c4 8a c4 8a)
p = tst_put_u64 buf p 4
put buf p uchar 0xc4
put buf add p 1 uchar 0x8a
put buf add p 2 uchar 0xc4
put buf add p 3 uchar 0x8a
p = add p 4
p = tst_put_str buf p tst_tok_h
p = tst_put_str buf p tst_tok_i
p = tst_put_str buf p tst_tok_hi
p = tst_put_str buf p tst_tok_ex
p = tst_put_str buf p tst_tok_hiex
p = tst_put_tok_str buf p 0x0120
note token_type array (14 i32s: 0..3 are 3=CONTROL, 4..13 are 1=NORMAL)
p = tst_put_str buf p inf_key_tok_type
p = tst_put_u32 buf p INF_VT_ARRAY
p = tst_put_u32 buf p INF_VT_I32
p = tst_put_u64 buf p 14
for i ulong 14
if lt i 4
p = tst_put_u32 buf p 3
else
p = tst_put_u32 buf p 1
end
end
note merges array: "h i", "hi !"
p = tst_put_str buf p inf_key_tok_merges
p = tst_put_u32 buf p INF_VT_ARRAY
p = tst_put_u32 buf p INF_VT_STR
p = tst_put_u64 buf p 2
p = tst_put_str buf p tst_mrg_hi
p = tst_put_str buf p tst_mrg_hiex
p = tst_kv_u32 buf p inf_key_bos 0
p = tst_kv_u32 buf p inf_key_eos 3
p = tst_align32 buf p
g = new InfGguf 0 0 0 0 0 0
if ne inf_gguf_parse part buf 0 p g INF_OK
ret 107
end
ts = new InfTokState 0 0 0 0 0 0 0 0
if ne inf_tok_init g part buf 0 p ts INF_OK
ret 108
end
if ne get ts vocab_size 14
ret 109
end
if ne get ts eot_id 3
ret 110
end
note Encode "hi!" -> pretokens ["hi", "!"] -> [10, 11]
cnt = inf_tok_encode part buf 0 p tst_msg_hi false
if ne cnt 2
ret 111
end
if ne inf_tok_get_id 0 10
ret 112
end
if ne inf_tok_get_id 1 11
ret 112
end
note Encode chat for user "hi!" -> [0, 1, 4, 2, 7, 10, 11, 3, 1, 5, 2, 7] (12 tokens)
ccnt = inf_tok_encode_chat part buf 0 p tst_msg_hi
if ne ccnt 12
ret 113
end
if ne inf_tok_get_id 0 0
ret 114
end
if ne inf_tok_get_id 1 1
ret 114
end
if ne inf_tok_get_id 2 4
ret 114
end
if ne inf_tok_get_id 3 2
ret 114
end
if ne inf_tok_get_id 4 7
ret 114
end
if ne inf_tok_get_id 5 10
ret 114
end
if ne inf_tok_get_id 6 11
ret 114
end
if ne inf_tok_get_id 7 3
ret 114
end
if ne inf_tok_get_id 9 5
ret 114
end
note Decode [0, 10, 11, 3] -> skips control tokens 0 and 3 -> "hi!"
ids = new uint 4 0
put ids 0 0
put ids 1 10
put ids 2 11
put ids 3 3
dbuf = new uchar 64 0
dlen = inf_tok_decode part buf 0 p ids dbuf
if ne dlen 3
ret 115
end
if not inf_slice_eq_text dbuf 0 3 tst_msg_dec
ret 116
end
ret 0
end

note ========================================================================
note 7a. Tiny synthetic F32 GQA Llama model forward + greedy decode (exit 120..132)
note ========================================================================

fn tst_write_f32_mat buf edit uchar * base ulong n ulong rng edit ulong 1 scale f32 to ulong
p = base
for i ulong n bound 4096
v = mul tst_rng_unit rng scale
p = tst_put_f32 buf p v
end
ret tst_align32 buf p
end

fn tst_write_f32_ones buf edit uchar * base ulong n ulong to ulong
p = base
for i ulong n bound 1024
p = tst_put_f32 buf p 1.0f32
end
ret tst_align32 buf p
end

fn tst_align_off off ulong to ulong
ret and add off 31 not ulong 31
end

fn tst_build_f32_model buf edit uchar * to ulong
nbuf = new uchar 64 0
meta = new ulong 5 0
p = tst_gguf_hdr buf 3 20 10
p = tst_put_str buf p inf_key_arch
p = tst_put_u32 buf p INF_VT_STR
p = tst_put_str buf p inf_val_llama
p = tst_kv_u32 buf p inf_key_blocks 2
p = tst_kv_u32 buf p inf_key_embd 8
p = tst_kv_u32 buf p inf_key_heads 4
p = tst_kv_u32 buf p inf_key_kv_heads 2
p = tst_kv_u32 buf p inf_key_ffn 12
p = tst_kv_u32 buf p inf_key_ctx 8
p = tst_kv_u32 buf p inf_key_vocab 8
p = tst_kv_f32 buf p inf_key_rope_base 10000.0f32
p = tst_kv_f32 buf p inf_key_rms_eps 1.0e-5f32
off = ulong 0
tst_meta2 meta 8 8 INF_GGML_F32 off
p = tst_put_tensor buf p inf_nm_tok_embd meta
off = tst_align_off add off 256
for l ulong 2
nlen = inf_fmt_blk_name uint l inf_sfx_attn_norm nbuf
tst_meta1 meta 8 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 32
nlen = inf_fmt_blk_name uint l inf_sfx_attn_q nbuf
tst_meta2 meta 8 8 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 256
nlen = inf_fmt_blk_name uint l inf_sfx_attn_k nbuf
tst_meta2 meta 8 4 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 128
nlen = inf_fmt_blk_name uint l inf_sfx_attn_v nbuf
tst_meta2 meta 8 4 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 128
nlen = inf_fmt_blk_name uint l inf_sfx_attn_out nbuf
tst_meta2 meta 8 8 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 256
nlen = inf_fmt_blk_name uint l inf_sfx_ffn_norm nbuf
tst_meta1 meta 8 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 32
nlen = inf_fmt_blk_name uint l inf_sfx_ffn_gate nbuf
tst_meta2 meta 8 12 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 384
nlen = inf_fmt_blk_name uint l inf_sfx_ffn_up nbuf
tst_meta2 meta 8 12 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 384
nlen = inf_fmt_blk_name uint l inf_sfx_ffn_down nbuf
tst_meta2 meta 12 8 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 384
end
tst_meta1 meta 8 INF_GGML_F32 off
p = tst_put_tensor buf p inf_nm_output_norm meta
p = tst_align32 buf p
rng = new ulong 1 0xcafebabe12345678
p = tst_write_f32_mat buf p 64 rng 0.5f32
for l ulong 2
p = tst_write_f32_ones buf p 8
p = tst_write_f32_mat buf p 64 rng 0.3f32
p = tst_write_f32_mat buf p 32 rng 0.3f32
p = tst_write_f32_mat buf p 32 rng 0.3f32
p = tst_write_f32_mat buf p 64 rng 0.3f32
p = tst_write_f32_ones buf p 8
p = tst_write_f32_mat buf p 96 rng 0.3f32
p = tst_write_f32_mat buf p 96 rng 0.3f32
p = tst_write_f32_mat buf p 96 rng 0.3f32
end
ret tst_write_f32_ones buf p 8
end

fn test_forward_f32 to int
note Tiny 2-layer GQA Llama: n_embd=8, n_head=4, n_kv=2, head_dim=2, kv_dim=4, n_ff=12, vocab=8, ctx=8
buf = new uchar 16384 0
p = tst_build_f32_model buf
note Parse, bind, init
g = new InfGguf 0 0 0 0 0 0
if ne inf_gguf_parse part buf 0 p g INF_OK
ret 120
end
m = new InfModel 0 0 0 0 0 0 0.0f32 0.0f32 0 0 0 0 0 0 0 0
if ne inf_model_bind g part buf 0 p m INF_OK
ret 121
end
st = new InfDecodeState 0 0 0 0 0
if ne inf_decode_init m 8 st INF_OK
ret 122
end
note BadToken check
if ne inf_decode_forward m part buf 0 p st 99 true INF_ERR_BAD_TOKEN
ret 123
end
note Prefill [1, 2, 3]
prompt = new uint 3 0
put prompt 0 1
put prompt 1 2
put prompt 2 3
if ne inf_decode_prefill m part buf 0 p st prompt INF_OK
ret 124
end
if ne get st pos 3
ret 125
end
note Verify logits finite and non-zero, save snapshot
snap = new f32 8 0.0f32
nonzero = false
for i ulong 8
lv = get inf_st_logits i
if ne lv lv
ret 126
end
if gt fabs lv 1.0e-6f32
nonzero = true
end
put snap i lv
end
if not nonzero
ret 127
end
top1 = inf_decode_argmax m
note Reset & rerun: must be bit-for-bit identical
inf_decode_reset st
if ne inf_decode_prefill m part buf 0 p st prompt INF_OK
ret 128
end
for i ulong 8
if ne bitcast uint get inf_st_logits i bitcast uint get snap i
ret 129
end
end
if ne inf_decode_argmax m top1
ret 129
end
note Greedy generation of 3 tokens
ngen = inf_generate_greedy m part buf 0 p st 3 uint 999
if ne ngen 3
ret 130
end
if ne inf_gen_get_id 0 top1
ret 131
end
note Verify ContextFull when capacity exhausted (pos is now 5: 3 prefill + 2 forward)
if ne inf_decode_forward m part buf 0 p st 0 false INF_OK
ret 132
end
if ne inf_decode_forward m part buf 0 p st 0 false INF_OK
ret 132
end
if ne inf_decode_forward m part buf 0 p st 0 false INF_OK
ret 132
end
if ne inf_decode_forward m part buf 0 p st 0 true INF_ERR_CONTEXT_FULL
ret 133
end
ret 0
end

note ========================================================================
note 7b. Quantized Q4_K / Q6_K synthetic GGUF forward parity (exit 135..145)
note ========================================================================

fn tst_write_q4k_mat buf edit uchar * base ulong rows ulong rng edit ulong 1 to ulong
p = base
blk = new uchar 144 0
for r ulong rows bound 512
tst_fill_q4k rng 0 blk
for i ulong 144
put buf add p i get blk i
end
p = add p 144
end
ret tst_align32 buf p
end

fn tst_write_q6k_mat buf edit uchar * base ulong rows ulong rng edit ulong 1 to ulong
p = base
blk = new uchar 210 0
for r ulong rows bound 512
tst_fill_q6k rng 0 blk
for i ulong 210
put buf add p i get blk i
end
p = add p 210
end
ret tst_align32 buf p
end

fn tst_build_q4k_model buf edit uchar * to ulong
nbuf = new uchar 64 0
meta = new ulong 5 0
p = tst_gguf_hdr buf 3 11 10
p = tst_put_str buf p inf_key_arch
p = tst_put_u32 buf p INF_VT_STR
p = tst_put_str buf p inf_val_llama
p = tst_kv_u32 buf p inf_key_blocks 1
p = tst_kv_u32 buf p inf_key_embd 256
p = tst_kv_u32 buf p inf_key_heads 4
p = tst_kv_u32 buf p inf_key_kv_heads 2
p = tst_kv_u32 buf p inf_key_ffn 256
p = tst_kv_u32 buf p inf_key_ctx 4
p = tst_kv_u32 buf p inf_key_vocab 4
p = tst_kv_f32 buf p inf_key_rope_base 500000.0f32
p = tst_kv_f32 buf p inf_key_rms_eps 1.0e-5f32
off = ulong 0
tst_meta2 meta 256 4 INF_GGML_Q6K off
p = tst_put_tensor buf p inf_nm_tok_embd meta
off = tst_align_off add off 840
nlen = inf_fmt_blk_name 0 inf_sfx_attn_norm nbuf
tst_meta1 meta 256 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 1024
nlen = inf_fmt_blk_name 0 inf_sfx_attn_q nbuf
tst_meta2 meta 256 256 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 36864
nlen = inf_fmt_blk_name 0 inf_sfx_attn_k nbuf
tst_meta2 meta 256 128 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 18432
nlen = inf_fmt_blk_name 0 inf_sfx_attn_v nbuf
tst_meta2 meta 256 128 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 18432
nlen = inf_fmt_blk_name 0 inf_sfx_attn_out nbuf
tst_meta2 meta 256 256 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 36864
nlen = inf_fmt_blk_name 0 inf_sfx_ffn_norm nbuf
tst_meta1 meta 256 INF_GGML_F32 off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 1024
nlen = inf_fmt_blk_name 0 inf_sfx_ffn_gate nbuf
tst_meta2 meta 256 256 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 36864
nlen = inf_fmt_blk_name 0 inf_sfx_ffn_up nbuf
tst_meta2 meta 256 256 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 36864
nlen = inf_fmt_blk_name 0 inf_sfx_ffn_down nbuf
tst_meta2 meta 256 256 INF_GGML_Q4K off
p = tst_put_tensor buf p part nbuf 0 nlen meta
off = tst_align_off add off 36864
tst_meta1 meta 256 INF_GGML_F32 off
p = tst_put_tensor buf p inf_nm_output_norm meta
p = tst_align32 buf p
rng = new ulong 1 0x9876543210fedcba
p = tst_write_q6k_mat buf p 4 rng
p = tst_write_f32_ones buf p 256
p = tst_write_q4k_mat buf p 256 rng
p = tst_write_q4k_mat buf p 128 rng
p = tst_write_q4k_mat buf p 128 rng
p = tst_write_q4k_mat buf p 256 rng
p = tst_write_f32_ones buf p 256
p = tst_write_q4k_mat buf p 256 rng
p = tst_write_q4k_mat buf p 256 rng
p = tst_write_q4k_mat buf p 256 rng
ret tst_write_f32_ones buf p 256
end

fn test_forward_q4k to int
note 1-layer quantized model: n_embd=256, n_head=4, n_kv=2, head_dim=64, kv_dim=128, n_ff=256, vocab=4, ctx=4
buf = new uchar 262144 0
p = tst_build_q4k_model buf
g = new InfGguf 0 0 0 0 0 0
if ne inf_gguf_parse part buf 0 p g INF_OK
ret 135
end
m = new InfModel 0 0 0 0 0 0 0.0f32 0.0f32 0 0 0 0 0 0 0 0
if ne inf_model_bind g part buf 0 p m INF_OK
ret 136
end
st = new InfDecodeState 0 0 0 0 0
if ne inf_decode_init m 4 st INF_OK
ret 137
end
note Mode 1: emulate_q8k=1, use_dotprod=0 (f32 dot on Q8_K-rounded activations)
put st emulate_q8k uint 1
put st use_dotprod uint 0
if ne inf_decode_forward m part buf 0 p st 1 true INF_OK
ret 138
end
l_emu = new f32 4 0.0f32
for i ulong 4
lv = get inf_st_logits i
if ne lv lv
ret 139
end
put l_emu i lv
end
top_emu = inf_decode_argmax m
note Mode 2: emulate_q8k=0, use_dotprod=1 (integer Q8_K dotprod path)
inf_decode_reset st
put st emulate_q8k uint 0
put st use_dotprod uint 1
if ne inf_decode_forward m part buf 0 p st 1 true INF_OK
ret 140
end
for i ulong 4
lv = get inf_st_logits i
ev = get l_emu i
if gt tst_rel lv ev 5.0e-3f32
ret 141
end
end
if ne inf_decode_argmax m top_emu
ret 142
end
ret 0
end


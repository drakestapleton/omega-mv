note SPDX-License-Identifier: Apache-2.0
note aienux/crates/allen-design-tokens/design_tokens_test.om: Behavioral self-test for allen-design-tokens.
note Compose with: si/directives/om2.om aienux/crates/allen-design-tokens/design_tokens.om aienux/crates/allen-design-tokens/design_tokens_test.om

text adtt_mini "---\nname: T\ncolors:\n  primary: \"#ECF0FC\"\n  night: \"#060812\"\ncomponents:\n  page:\n    backgroundColor: \"{colors.night}\"\n---\n\n## Motion\n\n```allen-tokens\nmotion:\n  letter: 35ms\n  ease-smooth: \"cubic-bezier(0.3333, 0, 0.6667, 1)\"\ncontrast:\n  primary-on-night: \"7.0\"\n```\n"
text adtt_bad_ref "---\ncolors:\n  night: \"#060812\"\ncomponents:\n  page:\n    backgroundColor: \"{colors.nope}\"\n---\n"
text adtt_dup "---\nmotion:\n  letter: 35ms\n  letter: 36ms\n---\n"
text adtt_loop "---\na: \"{b}\"\nb: \"{a}\"\n---\n"

text adtt_p_night "colors.night"
text adtt_p_bg "components.page.backgroundColor"
text adtt_p_letter "motion.letter"
text adtt_p_ease "motion.ease-smooth"
text adtt_v_night "#060812"
text adtt_v_letter "35ms"
text adtt_c_night "#define ALLEN_COLORS_NIGHT 0x060812u\n"
text adtt_c_letter "#define ALLEN_MOTION_LETTER_MS 35u\n"
text adtt_c_ease "#define ALLEN_MOTION_EASE_SMOOTH_X1_Q16 21843\n"

fn adtt_raw_eq idx ulong want view uchar * to bool
if ne get adt_raw_len idx len want
ret false
end
base = mul idx ADT_MAX_RAW
for i ulong len want bound 64
if ne get adt_raw add base i get want i
ret false
end
end
ret true
end

fn main to int
note 1. Parse MINI front matter + allen-tokens block + resolve reference
if ne adt_parse adtt_mini len adtt_mini ADT_OK
ret 1
end
i_night = adt_find_token adtt_p_night len adtt_p_night
if lt i_night 0
ret 2
end
if not adtt_raw_eq ulong i_night adtt_v_night
ret 3
end
i_bg = adt_find_token adtt_p_bg len adtt_p_bg
if lt i_bg 0
ret 4
end
if not adtt_raw_eq ulong i_bg adtt_v_night
ret 5
end
i_let = adt_find_token adtt_p_letter len adtt_p_letter
if lt i_let 0
ret 6
end
if not adtt_raw_eq ulong i_let adtt_v_letter
ret 7
end

note 2. Contrast check on primary (#ECF0FC) on night (#060812) passes floor 7.0
if ne adt_check_contrast ADT_OK
ret 8
end
if ne get adt_cr_cnt 0 1
ret 9
end
if ne get adt_cr_pass 0 1
ret 10
end
if lt get adt_cr_ratio 0 15.0f64
ret 11
end

note 3. C export is integer-only and matches exact #define lines
line = new uchar 128 0
n1 = adt_emit_c_token ulong i_night line
if ne n1 long len adtt_c_night
ret 12
end
if not adt_slice_eq part line 0 ulong n1 adtt_c_night
ret 13
end

n2 = adt_emit_c_token ulong i_let line
if ne n2 long len adtt_c_letter
ret 14
end
if not adt_slice_eq part line 0 ulong n2 adtt_c_letter
ret 15
end

i_ease = adt_find_token adtt_p_ease len adtt_p_ease
if lt i_ease 0
ret 16
end
n3 = adt_emit_c_token ulong i_ease line
if ne n3 long len adtt_c_ease
ret 17
end
if not adt_slice_eq part line 0 ulong n3 adtt_c_ease
ret 18
end

note 4. WCAG 2.2 reference contrast values: black on white == 21:1, equal == 1:1
c_bw = adt_contrast 0 0 0 255 255 255
if gt fabs sub c_bw 21.0f64 0.000001f64
ret 19
end
c_eq = adt_contrast 6 8 18 6 8 18
if gt fabs sub c_eq 1.0f64 0.000001f64
ret 20
end

note 5. Fixed-point kernel constants (chirp peak Q15=22937, breath depth Q16=1966, heart Q8=50,70,120,80)
if ne adt_q_fixed 0.7f64 32767.0f64 22937
ret 21
end
if ne adt_q_fixed 0.030f64 65536.0f64 1966
ret 22
end
if ne adt_q_fixed 0.195f64 256.0f64 50
ret 23
end

note 6. Error paths: broken reference, duplicate token, reference loop
if ne adt_parse adtt_bad_ref len adtt_bad_ref ADT_ERR_REF_MISSING
ret 24
end
if ne adt_parse adtt_dup len adtt_dup ADT_ERR_DUPLICATE
ret 25
end
if ne adt_parse adtt_loop len adtt_loop ADT_ERR_REF_LOOP
ret 26
end

ret 0
end

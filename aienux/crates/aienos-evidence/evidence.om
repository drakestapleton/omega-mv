note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-evidence/evidence.om: Pure-Omega AIENOS Config A Evidence,
note UTC time formatting, PE32+ AArch64 EFI check, Canonical JSON checksum,
note Bundle Verification, and Native-Boot Rollback Verdict.
note Converted from aienux crates/aienos-evidence/src/{time,pe,canon,verify,rollback,capture,http,lib,main}.rs.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-evidence/evidence.om ...

const EV_OK int 0
const EV_ERR_BAD_DOS int -1
const EV_ERR_BAD_PE int -2
const EV_ERR_BAD_MACHINE int -3
const EV_ERR_BAD_MAGIC int -4
const EV_ERR_BAD_SUBSYS int -5
const EV_ERR_TRUNCATED int -6

const EV_MACHINE_ARM64 ulong 0xaa64
const EV_PE32_PLUS ulong 0x20b
const EV_SUBSYS_EFI_APP ulong 10

const EV_MIN_OUTPUT_TOKENS ulong 32
const EV_MIN_SAMPLES ulong 3

const EV_VERDICT_PASS int 0
const EV_VERDICT_FAIL int 1
const EV_VERDICT_UNPARSEABLE int 2
const EV_VERDICT_BLOCKED int 3

const EV_REC_DOC_ONLY uchar 0
const EV_REC_VERIFIED uchar 1

text ev_hex_digits "0123456789abcdef"

note Structured Config A bundle fields for pure-Omega verification
note 0=schema_ok, 1=host_ok, 2=uefi_present, 3=gpu_ok, 4=cpu_cores, 5=cpu_part_sum,
note 6=mem_total_kb, 7=block_devs, 8=model_sha_ok, 9=model_size,
note 10=repo_cnt, 11=repo_commits_ok, 12=repo_any_dirty,
note 13=sample_cnt, 14=samples_complete,
note 15=rec_status, 16=rec_rollback_tested
global ev_bundle ulong 17
global ev_bundle_sum uchar 32

note Verification report: 0=errors, 1=m0_open
global ev_report ulong 2

note Rollback pre/post capture state
note 0=valid_shape, 1=secure_boot_off, 2=boot_order_match, 3=boot_current_match,
note 4=boot_next_cleared, 5=root_ok, 6=esp_ok
global ev_rb_state ulong 7

fn ev_u16_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
ret or b0 shl b1 8
end

fn ev_u32_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
b2 = ulong get buf add off 2
b3 = ulong get buf add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn ev_put_u64_be buf edit uchar * off ulong v ulong to void
for i ulong 8
sh = mul sub 7 i 8
put buf add off i uchar and shr v sh 0xff
end
end

note Scratch for civil date: 0=year, 1=month, 2=day
global ev_ymd ulong 3

note Howard Hinnant civil date from days since 1970-01-01
fn ev_civil_date days ulong to void
z = add days 719468
era = div z 146097
doe = rem z 146097
tmp = sub doe div doe 1460
tmp = add tmp div doe 36524
tmp = sub tmp div doe 146096
yoe = div tmp 365
tmp = add mul 365 yoe div yoe 4
tmp = sub tmp div yoe 100
doy = sub doe tmp
mp = div add mul 5 doy 2 153
tmp = div add mul 153 mp 2 5
put ev_ymd 2 add sub doy tmp 1
mon = ulong 0
if lt mp 10
mon = add mp 3
else
mon = sub mp 9
end
put ev_ymd 1 mon
yr = add yoe mul era 400
if le mon 2
yr = add yr 1
end
put ev_ymd 0 yr
end

fn ev_put_2d dst edit uchar * off ulong v ulong to void
put dst off uchar add 48 rem div v 10 10
put dst add off 1 uchar add 48 rem v 10
end

fn ev_iso_utc secs ulong dst edit uchar * to int
if lt len dst 20
ret EV_ERR_TRUNCATED
end
ev_civil_date div secs 86400
yr = get ev_ymd 0
ev_put_2d dst 0 div yr 100
ev_put_2d dst 2 rem yr 100
put dst 4 uchar 45
ev_put_2d dst 5 get ev_ymd 1
put dst 7 uchar 45
ev_put_2d dst 8 get ev_ymd 2
put dst 10 uchar 84
rem_s = rem secs 86400
ev_put_2d dst 11 div rem_s 3600
put dst 13 uchar 58
ev_put_2d dst 14 div rem rem_s 3600 60
put dst 16 uchar 58
ev_put_2d dst 17 rem rem_s 60
put dst 19 uchar 90
ret EV_OK
end

note Structural check that bytes form an AArch64 PE32+ EFI application
fn ev_verify_efi_app data view uchar * to int
if lt len data 256
ret EV_ERR_BAD_DOS
end
if or ne get data 0 77 ne get data 1 90
ret EV_ERR_BAD_DOS
end
pe = ev_u32_le data 60
if gt add pe 96 len data
ret EV_ERR_TRUNCATED
end
if or ne get data pe 80 ne get data add pe 1 69
ret EV_ERR_BAD_PE
end
if or ne get data add pe 2 0 ne get data add pe 3 0
ret EV_ERR_BAD_PE
end
machine = ev_u16_le data add pe 4
if ne machine EV_MACHINE_ARM64
ret EV_ERR_BAD_MACHINE
end
opt = add pe 24
magic = ev_u16_le data opt
if ne magic EV_PE32_PLUS
ret EV_ERR_BAD_MAGIC
end
subsys = ev_u16_le data add opt 68
if ne subsys EV_SUBSYS_EFI_APP
ret EV_ERR_BAD_SUBSYS
end
ret EV_OK
end

fn ev_is_lower_hex buf view uchar * expected_len ulong to bool
if ne len buf expected_len
ret false
end
for i ulong expected_len bound 128
b = get buf i
is_dig = and ge b 48 le b 57
is_af = and ge b 97 le b 102
if not or is_dig is_af
ret false
end
end
ret true
end

fn ev_hex_encode src view uchar * dst edit uchar * to void
n = len src
for i ulong n bound 64
b = ulong get src i
hi = shr b 4
lo = and b 15
put dst mul i 2 get ev_hex_digits hi
put dst add mul i 2 1 get ev_hex_digits lo
end
end

note Canonical bundle checksum over the 17 structured bundle fields
fn ev_bundle_checksum dst edit uchar * to void
raw = new uchar 136 0
for i ulong 17
ev_put_u64_be raw mul i 8 get ev_bundle i
end
dlen = sha2_digest 256 raw dst
if ne dlen 32
trap 8
end
end

fn ev_bundle_seal to void
sum = new uchar 32 0
ev_bundle_checksum sum
for i ulong 32
put ev_bundle_sum i get sum i
end
end

fn ev_bundle_checksum_ok to bool
sum = new uchar 32 0
ev_bundle_checksum sum
for i ulong 32
if ne get sum i get ev_bundle_sum i
ret false
end
end
ret true
end

fn ev_bundle_verify to void
errs = ulong 0
m0 = ulong 0
if not ev_bundle_checksum_ok
errs = add errs 1
end
if eq get ev_bundle 0 0
errs = add errs 1
end
if eq get ev_bundle 1 0
errs = add errs 1
end
if eq get ev_bundle 2 0
errs = add errs 1
end
if eq get ev_bundle 3 0
errs = add errs 1
end
cores = get ev_bundle 4
psum = get ev_bundle 5
if or eq cores 0 ne cores psum
errs = add errs 1
end
if eq get ev_bundle 6 0
errs = add errs 1
end
if eq get ev_bundle 7 0
errs = add errs 1
end
if or eq get ev_bundle 8 0 eq get ev_bundle 9 0
errs = add errs 1
end
if eq get ev_bundle 10 0
errs = add errs 1
else
if eq get ev_bundle 11 0
errs = add errs 1
end
if ne get ev_bundle 12 0
errs = add errs 1
end
end
if or lt get ev_bundle 13 EV_MIN_SAMPLES eq get ev_bundle 14 0
errs = add errs 1
end
if ne get ev_bundle 15 ulong EV_REC_VERIFIED
m0 = add m0 1
end
if eq get ev_bundle 16 0
m0 = add m0 1
end
put ev_report 0 errs
put ev_report 1 m0
end

note Native-boot rollback verdict evaluation
fn ev_rollback_verdict to int
if eq get ev_rb_state 0 0
ret EV_VERDICT_UNPARSEABLE
end
if eq get ev_rb_state 1 0
ret EV_VERDICT_BLOCKED
end
if eq get ev_rb_state 2 0
ret EV_VERDICT_FAIL
end
if eq get ev_rb_state 3 0
ret EV_VERDICT_FAIL
end
if eq get ev_rb_state 4 0
ret EV_VERDICT_FAIL
end
if or eq get ev_rb_state 5 0 eq get ev_rb_state 6 0
ret EV_VERDICT_FAIL
end
ret EV_VERDICT_PASS
end

note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-evidence/evidence_test.om: Behavioral self-test for aienos-evidence.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-evidence/evidence.om aienux/crates/aienos-evidence/evidence_test.om

text ev_t0 "1970-01-01T00:00:00Z"
text ev_t1 "2000-02-29T00:00:00Z"
text ev_t2 "2026-09-23T23:10:08Z"
text ev_good_hex64 "3f5a22426976ab26cfe84dba63c1d08391717abb1af893e10f1b2968d862dcc1"
text ev_bad_hex64 "3f5a22426976ab26cfe84dba63c1d08391717abb1af893e10f1b2968d862dccZ"

fn ev_bytes_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn ev_make_pe img edit uchar * machine ulong subsys ulong to void
put img 0 77
put img 1 90
put img 60 0x80
put img 61 0
put img 62 0
put img 63 0
put img 0x80 80
put img 0x81 69
put img 0x82 0
put img 0x83 0
put img 0x84 uchar and machine 0xff
put img 0x85 uchar and shr machine 8 0xff
opt = ulong 0x98
put img opt uchar and EV_PE32_PLUS 0xff
put img add opt 1 uchar and shr EV_PE32_PLUS 8 0xff
put img add opt 68 uchar and subsys 0xff
put img add opt 69 uchar and shr subsys 8 0xff
end

fn ev_fill_good_bundle to void
put ev_bundle 0 1
put ev_bundle 1 1
put ev_bundle 2 1
put ev_bundle 3 1
put ev_bundle 4 20
put ev_bundle 5 20
put ev_bundle 6 127598748
put ev_bundle 7 1
put ev_bundle 8 1
put ev_bundle 9 807694368
put ev_bundle 10 1
put ev_bundle 11 1
put ev_bundle 12 0
put ev_bundle 13 3
put ev_bundle 14 1
put ev_bundle 15 ulong EV_REC_DOC_ONLY
put ev_bundle 16 0
ev_bundle_seal
end

fn main to int
note 1. UTC timestamp known instants
ts = new uchar 20 0
if ne ev_iso_utc 0 ts EV_OK
ret 1
end
if not ev_bytes_eq ts ev_t0
ret 2
end
if ne ev_iso_utc 951782400 ts EV_OK
ret 3
end
if not ev_bytes_eq ts ev_t1
ret 4
end
if ne ev_iso_utc 1790205008 ts EV_OK
ret 5
end
if not ev_bytes_eq ts ev_t2
ret 6
end

note 2. PE32+ AArch64 EFI application verification
img = new uchar 512 0
ev_make_pe img EV_MACHINE_ARM64 EV_SUBSYS_EFI_APP
if ne ev_verify_efi_app img EV_OK
ret 7
end
ev_make_pe img 0x8664 EV_SUBSYS_EFI_APP
if ne ev_verify_efi_app img EV_ERR_BAD_MACHINE
ret 8
end
ev_make_pe img EV_MACHINE_ARM64 3
if ne ev_verify_efi_app img EV_ERR_BAD_SUBSYS
ret 9
end
put img 0 0
if ne ev_verify_efi_app img EV_ERR_BAD_DOS
ret 10
end

note 3. Hex validator
if not ev_is_lower_hex ev_good_hex64 64
ret 11
end
if ev_is_lower_hex ev_bad_hex64 64
ret 12
end

note 4. Config A bundle verification: sound capture with open M0
ev_fill_good_bundle
ev_bundle_verify
if ne get ev_report 0 0
ret 13
end
if ne get ev_report 1 2
ret 14
end

note 5. Tampered bundle fails checksum
put ev_bundle 4 21
ev_bundle_verify
if eq get ev_report 0 0
ret 15
end

note 6. Dirty repo rejected even when re-sealed
ev_fill_good_bundle
put ev_bundle 12 1
ev_bundle_seal
ev_bundle_verify
if eq get ev_report 0 0
ret 16
end

note 7. Verified recovery closes M0
ev_fill_good_bundle
put ev_bundle 15 ulong EV_REC_VERIFIED
put ev_bundle 16 1
ev_bundle_seal
ev_bundle_verify
if ne get ev_report 0 0
ret 17
end
if ne get ev_report 1 0
ret 18
end

note 8. Rollback verdict state machine
put ev_rb_state 0 1
put ev_rb_state 1 1
put ev_rb_state 2 1
put ev_rb_state 3 1
put ev_rb_state 4 1
put ev_rb_state 5 1
put ev_rb_state 6 1
if ne ev_rollback_verdict EV_VERDICT_PASS
ret 19
end
put ev_rb_state 4 0
if ne ev_rollback_verdict EV_VERDICT_FAIL
ret 20
end
put ev_rb_state 1 0
if ne ev_rollback_verdict EV_VERDICT_BLOCKED
ret 21
end
put ev_rb_state 0 0
if ne ev_rollback_verdict EV_VERDICT_UNPARSEABLE
ret 22
end

ret 0
end

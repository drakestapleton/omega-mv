note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-fpu-probe/fpu_probe_test.om: Behavioral self-test for aienos-fpu-probe.
note Compose with: si/directives/om2.om aienux/crates/aienos-fpu-probe/fpu_probe.om aienux/crates/aienos-fpu-probe/fpu_probe_test.om

fn main to int
note 1. Short output buffer must be refused with -1
short_buf = new uint 5 0
if ne aienos_fpu_probe short_buf -1
ret 1
end

note 2. Full probe must return 0 and write exact IEEE-754 bit patterns
res = new uint 6 0
if ne aienos_fpu_probe res 0
ret 2
end
note 68.0f32 == 0x42880000
if ne get res 0 uint 0x42880000
ret 3
end
note Lanes: 11.0=0x41300000, 22.0=0x41b00000, 33.0=0x42040000, 44.0=0x42300000
if ne get res 2 uint 0x41300000
ret 4
end
if ne get res 3 uint 0x41b00000
ret 5
end
if ne get res 4 uint 0x42040000
ret 6
end
if ne get res 5 uint 0x42300000
ret 7
end

note 3. exp_approx(0.0) == 1.0 exactly
e0 = fpu_exp_approx 0.0f32
if ne e0 1.0f32
ret 8
end

note 4. exp_approx(-1.0) within 1e-4 of 1/e (0.36787944)
em1 = fpu_exp_approx -1.0f32
d1 = sub em1 0.36787944f32
if not and lt d1 FPU_PROBE_TOL gt d1 neg FPU_PROBE_TOL
ret 9
end

note 5. exp_approx(2.0) within 1e-3 of e^2 (7.3890561)
e2 = fpu_exp_approx 2.0f32
d2 = sub e2 7.3890561f32
if not and lt d2 0.001f32 gt d2 -0.001f32
ret 10
end

note 6. exp_approx(-2.5) exercises floor adjustment for negative non-integer t
em25 = fpu_exp_approx -2.5f32
d3 = sub em25 0.0820850f32
if not and lt d3 FPU_PROBE_TOL gt d3 neg FPU_PROBE_TOL
ret 11
end

ret 0
end

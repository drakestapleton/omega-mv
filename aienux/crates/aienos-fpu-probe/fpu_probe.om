note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-fpu-probe/fpu_probe.om: Pure-Omega FP/SIMD probe.
note Converted from aienux crates/aienos-fpu-probe/src/lib.rs.
note Compose with: si/directives/om2.om aienux/crates/aienos-fpu-probe/fpu_probe.om ...

const FPU_PROBE_OUT_WORDS ulong 6
const FPU_PROBE_LOG2_E f32 1.4426950408889634
const FPU_PROBE_LN_2 f32 0.6931471805599453
const FPU_PROBE_E f32 2.718281828459045
const FPU_PROBE_TOL f32 0.0001

note exp(x) for |x| < 80: x*log2(e) = n + f, 2^f by degree-6 Taylor polynomial,
note 2^n by constructing IEEE-754 binary32 exponent bits.
fn fpu_exp_approx x f32 to f32
t = mul x FPU_PROBE_LOG2_E
n = int t
if gt f32 n t
n = sub n 1
end
f = mul sub t f32 n FPU_PROBE_LN_2
p = add div 1.0f32 120.0f32 mul f div 1.0f32 720.0f32
p = add div 1.0f32 24.0f32 mul f p
p = add div 1.0f32 6.0f32 mul f p
p = add 0.5f32 mul f p
p = add 1.0f32 mul f p
p = add 1.0f32 mul f p
exp_bits = shl uint add n 127 23
scale = bitcast f32 exp_bits
ret mul p scale
end

note Writes six u32 bit-pattern words to dst:
note   [0] bits of dot(a, b) with a[i]=i+1, b[i]=0.5 (i in 0..16): 68.0
note   [1] bits of exp_approx(1.0)
note   [2..6] 4-lane add([1,2,3,4], [10,20,30,40]) bits: 11, 22, 33, 44
note Returns 0 when all checks pass, else bitmask (1=dot, 2=exp, 4=lanes), or -1 if len dst < 6.
fn aienos_fpu_probe dst edit uint * to int
if lt len dst FPU_PROBE_OUT_WORDS
ret -1
end
a = new f32 16 0.0f32
b = new f32 16 0.5f32
for i ulong 16
put a i f32 add i 1
end
dot = f32 0.0
for i ulong 16
dot = add dot mul get a i get b i
end
ev = fpu_exp_approx 1.0f32
vx = new f32 4 0.0f32
vy = new f32 4 0.0f32
lanes = new f32 4 0.0f32
for i ulong 4
v = f32 add i 1
put vx i v
put vy i mul v 10.0f32
put lanes i add get vx i get vy i
end
put dst 0 bitcast uint dot
put dst 1 bitcast uint ev
for i ulong 4
put dst add 2 i bitcast uint get lanes i
end
rc = int 0
if ne dot 68.0f32
rc = or rc 1
end
diff = sub ev FPU_PROBE_E
if not and lt diff FPU_PROBE_TOL gt diff neg FPU_PROBE_TOL
rc = or rc 2
end
lane_ok = true
for i ulong 4
want = mul f32 add i 1 11.0f32
if ne get lanes i want
lane_ok = false
end
end
if not lane_ok
rc = or rc 4
end
ret rc
end

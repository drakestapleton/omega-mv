note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-store-tool/store_tool_test.om: Behavioral self-test for aienos-store-tool.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/crates/aienos-store-tool/store_tool.om aienux/crates/aienos-store-tool/store_tool_test.om

fn st_test_hmac to int
k1 = new uchar 32 0xaa
k2 = new uchar 32 0xbb
chal = new uchar 32 0x55
r1 = new uchar 32 0
r2 = new uchar 32 0
r3 = new uchar 32 0
st_operator_respond k1 chal r1
st_operator_respond k1 chal r2
st_operator_respond k2 chal r3
same12 = true
same13 = true
for i ulong 32
if ne get r1 i get r2 i
same12 = false
end
if ne get r1 i get r3 i
same13 = false
end
end
if not same12
ret 30
end
if same13
ret 31
end
ret 0
end

fn main to int
note 1. Superblock v1 encode and decode
sb0 = new uchar 4096 0
sb1 = new uchar 4096 0
st_sb_encode sb0 0 10 256
if ne st_sb_decode sb0 0 ST_OK
ret 1
end
if ne get st_sb_out 0 10
ret 2
end
if ne get st_sb_out 1 256
ret 3
end

note 2. Inactive slot selection: zero slot first, then lower generation
if ne st_inactive_slot sb0 sb1 1
ret 4
end
st_sb_encode sb1 1 11 256
if ne st_inactive_slot sb0 sb1 0
ret 5
end
st_sb_encode sb0 0 11 256
if ne st_inactive_slot sb0 sb1 ST_ERR_AMBIGUOUS
ret 6
end

note 3. Tear closure: 1 differing sector passes (128, 128); 2 differing sectors fails with mask 0x1
old_u = new uchar 4096 0
one_sec = new uchar 4096 0
put one_sec 7 1
if ne st_tear_outcomes old_u one_sec 512 ST_OK
ret 7
end
if or ne get st_tear_out 0 128 ne get st_tear_out 1 128
ret 8
end
two_sec = new uchar 4096 0
put two_sec 7 1
put two_sec 1536 1
if eq st_tear_outcomes old_u two_sec 512 ST_OK
ret 9
end
if ne get st_tear_out 2 1
ret 10
end

note 4. Seeded garbage is deterministic and rejected as BadSuperblockMagic
g1 = new uchar 4096 0
g2 = new uchar 4096 0
st_seeded_garbage g1
st_seeded_garbage g2
if not st_units_eq g1 g2
ret 11
end
if ne st_sb_decode g1 1 ST_ERR_BAD_MAGIC
ret 12
end

note 5. All 8 fault injection cases isolate their exact FormatError
st_sb_encode sb0 0 5 128
dst = new uchar 4096 0
for kase int 8
k = add kase 1
exp = st_inject_case sb0 dst 0 k
got = st_sb_decode dst 0
if ne got exp
ret add 20 k
end
end

note 6. HMAC-SHA256 operator response determinism and key sensitivity
hrc = st_test_hmac
if ne hrc 0
ret hrc
end

ret 0
end

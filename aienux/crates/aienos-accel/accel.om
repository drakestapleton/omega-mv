note Global decoded state buffers

note Gb10Bar result: 0=segment, 1=bus, 2=device, 3=function, 4=physical_base
global accel_gb10_bar ulong 5

note Gb10Identity result: 0..3=loc, 4=physical_base, 5=pmc_boot_0, 6=pmc_boot_42
global accel_gb10_id ulong 7

note Decoded type 0 PCI Header
note 0=vendor_id, 1=device_id, 2=command, 3=status, 4=revision, 5=prog_if,
note 6=subclass, 7=class_code, 8=header_type, 9=multifunction,
note 10=subsystem_vendor_id, 11=subsystem_id, 12=capability_pointer,
note 13=interrupt_line, 14=interrupt_pin
global accel_hdr ulong 15
global accel_hdr_bar_kind ulong 6
global accel_hdr_bar_base ulong 6
global accel_hdr_bar_64 ulong 6
global accel_hdr_bar_pref ulong 6
global accel_hdr_bar_sz_known ulong 6
global accel_hdr_bar_sz ulong 6

note Decoded type 1 PCI BridgeHeader: 0=vid, 1=did, 2=class, 3=subclass, 4=sec_bus, 5=sub_bus
global accel_bridge ulong 6

note Standard capability list (up to 48 entries)
global accel_cap_cnt ulong 1
global accel_cap_id uchar 48
global accel_cap_off uchar 48
global accel_cap_next uchar 48

note Decoded MSI capability: 0=off, 1=en, 2=cap_vec, 3=en_vec, 4=is64, 5=mask, 6=addr, 7=data
global accel_msi ulong 8

note Decoded MSI-X capability: 0=off, 1=en, 2=fmask, 3=vec, 4=tbir, 5=toff, 6=pbir, 7=poff
global accel_msix ulong 8

note Decoded PCIe capability + link:
note 0=off, 1=ver, 2=dev_type, 3=slot_impl, 4=max_payload, 5=has_link,
note 6=max_speed, 7=max_width, 8=supp_speeds, 9=cur_speed, 10=cur_width, 11=downgraded
global accel_pcie ulong 12

note Extended capability list (up to 64 entries)
global accel_ecap_cnt ulong 1
global accel_ecap_id ushort 64
global accel_ecap_ver uchar 64
global accel_ecap_off ushort 64

note Gb10Match result: 0..3=loc, 4=bar0_base, 5=bar0_64, 6=bar0_pref, 7=bar0_sz_known
global accel_match ulong 8

note Gb10Profile state
global accel_prof_loc ulong 4
global accel_prof_state ulong 28
global accel_prof_src ulong 28
global accel_prof_nver ulong 28
global accel_prof_val ulong 28
global accel_prof_numa long 1
global accel_prof_class ulong 3
global accel_prof_bar_kind ulong 6
global accel_prof_bar_base ulong 6
global accel_prof_bar_64 ulong 6
global accel_prof_bar_pref ulong 6
global accel_prof_pcie ulong 9
global accel_prof_msi ulong 5
global accel_prof_msix ulong 8
global accel_prof_fw_len ulong 1
global accel_prof_fw uchar 128

note RootBridgeOutcome array for discovery diagnostics
global accel_root_cnt ulong 1
global accel_root_kind ulong 16
global accel_root_seg ulong 16
global accel_root_devs ulong 16
global accel_root_bridges ulong 16
global accel_root_wins ulong 16
global accel_root_has_cand ulong 16
global accel_root_cand_cs ulong 16
global accel_root_cand_lo ulong 16
global accel_root_cand_hi ulong 16
global accel_root_st_len ulong 16
global accel_root_st uchar 512

note === Low-level little-endian readers and formatting helpers ===

fn accel_u16_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
ret or b0 shl b1 8
end

fn accel_u32_le buf view uchar * off ulong to ulong
b0 = ulong get buf off
b1 = ulong get buf add off 1
b2 = ulong get buf add off 2
b3 = ulong get buf add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn accel_put_u16_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
end

fn accel_put_u32_le buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
end

fn accel_make_loc dst edit ulong 4 seg ulong bus ulong dev ulong func ulong to void
put dst 0 seg
put dst 1 bus
put dst 2 dev
put dst 3 func
end

fn accel_buf_put_byte dst edit uchar * pos ulong ch uchar to ulong
if lt pos len dst
put dst pos ch
ret add pos 1
end
ret pos
end

fn accel_buf_put_str dst edit uchar * pos ulong src view uchar * to ulong
slen = len src
cap = len dst
cur = pos
for i ulong slen bound 1024
if lt cur cap
put dst cur get src i
cur = add cur 1
end
end
ret cur
end

fn accel_buf_put_u64_dec dst edit uchar * pos ulong v ulong to ulong
if eq v 0
ret accel_buf_put_byte dst pos uchar 48
end
tmp = new uchar 20 0
n = ulong 0
x = v
while gt x 0 bound 20
put tmp n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
cur = pos
i = n
while gt i 0 bound 20
i = sub i 1
cur = accel_buf_put_byte dst cur get tmp i
end
ret cur
end

fn accel_buf_put_i64_dec dst edit uchar * pos ulong v long to ulong
if lt v 0
cur = accel_buf_put_byte dst pos uchar 45
mag = ulong sub 0 v
ret accel_buf_put_u64_dec dst cur mag
end
ret accel_buf_put_u64_dec dst pos ulong v
end

fn accel_buf_put_hex_w dst edit uchar * pos ulong v ulong digits ulong to ulong
cur = accel_buf_put_byte dst pos uchar 48
cur = accel_buf_put_byte dst cur uchar 120
if or eq digits 0 gt digits 16
ret cur
end
for i ulong digits bound 16
sh = mul sub sub digits 1 i 4
nib = and shr v sh 0x0f
cur = accel_buf_put_byte dst cur get accel_hex_digits nib
end
ret cur
end

fn accel_buf_put_bool dst edit uchar * pos ulong flag ulong to ulong
if ne flag 0
ret accel_buf_put_str dst pos accel_t_true
end
ret accel_buf_put_str dst pos accel_t_false
end

fn accel_buf_contains hay view uchar * hlen ulong needle view uchar * to bool
if gt hlen len hay
ret false
end
nlen = len needle
if eq nlen 0
ret true
end
if gt nlen hlen
ret false
end
limit = add sub hlen nlen 1
for i ulong limit bound 8192
matched = true
for j ulong nlen bound 512
if ne get hay add i j get needle j
matched = false
break
end
end
if matched
ret true
end
end
ret false
end

fn accel_buf_eq hay view uchar * hlen ulong expected view uchar * to bool
if ne hlen len expected
ret false
end
if gt hlen len hay
ret false
end
for i ulong hlen bound 4096
if ne get hay i get expected i
ret false
end
end
ret true
end

note === lib.rs: Gb10Bar::from_config & discovery diagnostics ===

fn accel_gb10_bar_from_config loc view ulong 4 vd ulong cs ulong bar0_lo ulong bar0_hi ulong to bool
exp_vd = or shl ACCEL_GB10_DEVICE_ID 16 ACCEL_NVIDIA_VENDOR_ID
if ne and vd 0xffffffff exp_vd
ret false
end
if eq and cs 0x2 0
ret false
end
if ne and bar0_lo 0x7 0x4
ret false
end
lo_addr = and bar0_lo 0xfffffff0
hi_addr = and bar0_hi 0xffffffff
phys = or shl hi_addr 32 lo_addr
if eq phys 0
ret false
end
max_base = sub 0xffffffffffffffff add ACCEL_PMC_BOOT_42 4
if gt phys max_base
ret false
end
for i ulong 4
put accel_gb10_bar i get loc i
end
put accel_gb10_bar 4 phys
ret true
end

fn accel_gb10_id_set pmc0 ulong pmc42 ulong to void
for i ulong 5
put accel_gb10_id i get accel_gb10_bar i
end
put accel_gb10_id 5 and pmc0 0xffffffff
put accel_gb10_id 6 and pmc42 0xffffffff
end

fn accel_roots_clear to void
put accel_root_cnt 0 0
for i ulong ACCEL_MAX_ROOTS
put accel_root_kind i ACCEL_ROOT_NONE
put accel_root_seg i 0
put accel_root_devs i 0
put accel_root_bridges i 0
put accel_root_wins i 0
put accel_root_has_cand i 0
put accel_root_cand_cs i 0
put accel_root_cand_lo i 0
put accel_root_cand_hi i 0
put accel_root_st_len i 0
end
end

fn accel_roots_push_none to int
cnt = get accel_root_cnt 0
if ge cnt ACCEL_MAX_ROOTS
ret -1
end
put accel_root_kind cnt ACCEL_ROOT_NONE
put accel_root_cnt 0 add cnt 1
ret 0
end

fn accel_roots_push_refused status view uchar * to int
cnt = get accel_root_cnt 0
if ge cnt ACCEL_MAX_ROOTS
ret -1
end
slen = len status
if gt slen 32
slen = ulong 32
end
put accel_root_kind cnt ACCEL_ROOT_REFUSED
put accel_root_st_len cnt slen
base = mul cnt 32
for i ulong slen bound 32
put accel_root_st add base i get status i
end
put accel_root_cnt 0 add cnt 1
ret 0
end

fn accel_roots_push_scanned seg ulong devs ulong bridges ulong wins ulong to int
cnt = get accel_root_cnt 0
if ge cnt ACCEL_MAX_ROOTS
ret -1
end
put accel_root_kind cnt ACCEL_ROOT_SCANNED
put accel_root_seg cnt seg
put accel_root_devs cnt devs
put accel_root_bridges cnt bridges
put accel_root_wins cnt wins
put accel_root_has_cand cnt 0
put accel_root_cnt 0 add cnt 1
ret int cnt
end

fn accel_roots_set_candidate idx ulong cs ulong bar0_lo ulong bar0_hi ulong to void
if lt idx ACCEL_MAX_ROOTS
put accel_root_has_cand idx 1
put accel_root_cand_cs idx and cs 0xffffffff
put accel_root_cand_lo idx and bar0_lo 0xffffffff
put accel_root_cand_hi idx and bar0_hi 0xffffffff
end
end

fn accel_write_diag_refused dst edit uchar * pos ulong vis ulong idx ulong to ulong
cur = accel_buf_put_str dst pos accel_d_open_p
cur = accel_buf_put_u64_dec dst cur vis
cur = accel_buf_put_str dst cur accel_d_refused
slen = get accel_root_st_len idx
base = mul idx 32
for j ulong slen bound 32
cur = accel_buf_put_byte dst cur get accel_root_st add base j
end
ret accel_buf_put_str dst cur accel_d_rparen
end

fn accel_write_diag_scanned dst edit uchar * pos ulong vis ulong idx ulong to ulong
cur = accel_buf_put_str dst pos accel_d_root_p
cur = accel_buf_put_u64_dec dst cur vis
cur = accel_buf_put_str dst cur accel_d_seg
cur = accel_buf_put_u64_dec dst cur get accel_root_seg idx
cur = accel_buf_put_str dst cur accel_d_devs
cur = accel_buf_put_u64_dec dst cur get accel_root_devs idx
cur = accel_buf_put_str dst cur accel_d_br
cur = accel_buf_put_u64_dec dst cur get accel_root_bridges idx
cur = accel_buf_put_str dst cur accel_d_wins
cur = accel_buf_put_u64_dec dst cur get accel_root_wins idx
cur = accel_buf_put_str dst cur accel_t_nl
if ne get accel_root_has_cand idx 0
cur = accel_buf_put_str dst cur accel_d_cand_p
cur = accel_buf_put_u64_dec dst cur vis
cur = accel_buf_put_str dst cur accel_d_cs
cur = accel_buf_put_hex_w dst cur get accel_root_cand_cs idx 8
cur = accel_buf_put_str dst cur accel_d_bar0
cur = accel_buf_put_hex_w dst cur get accel_root_cand_hi idx 8
cur = accel_buf_put_byte dst cur uchar 58
cur = accel_buf_put_hex_w dst cur get accel_root_cand_lo idx 8
cur = accel_buf_put_str dst cur accel_t_nl
end
ret cur
end

fn accel_write_discovery_diagnostics dst edit uchar * has_handles bool handles ulong to ulong
cur = accel_buf_put_str dst 0 accel_d_bridges
if not has_handles
ret accel_buf_put_str dst cur accel_d_failed
end
cur = accel_buf_put_u64_dec dst cur handles
cur = accel_buf_put_str dst cur accel_t_nl
cnt = get accel_root_cnt 0
vis = ulong 0
for i ulong cnt bound 16
knd = get accel_root_kind i
if eq knd ACCEL_ROOT_REFUSED
cur = accel_write_diag_refused dst cur vis i
vis = add vis 1
else
if eq knd ACCEL_ROOT_SCANNED
cur = accel_write_diag_scanned dst cur vis i
vis = add vis 1
end
end
end
ret cur
end

note === pci.rs: PCI configuration header, BARs, capabilities, extended capabilities ===

fn accel_pci_decode_bars bytes view uchar * offset ulong to int
for i ulong 6
put accel_hdr_bar_kind i ACCEL_BAR_NONE
put accel_hdr_bar_base i 0
put accel_hdr_bar_64 i 0
put accel_hdr_bar_pref i 0
put accel_hdr_bar_sz_known i 0
put accel_hdr_bar_sz i 0
end
blen = len bytes
idx = ulong 0
while lt idx 6 bound 6
lo_off = add offset mul idx 4
if gt add lo_off 4 blen
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
lo = accel_u32_le bytes lo_off
if eq lo 0
idx = add idx 1
continue
end
if eq and lo 0x1 0x1
if ne and lo 0x6 0
ret ACCEL_PCI_ERR_INVALID_BAR
end
put accel_hdr_bar_kind idx ACCEL_BAR_IO
put accel_hdr_bar_base idx and lo 0xfffffffc
idx = add idx 1
continue
end
btype = and shr lo 1 0x3
pref = ulong 0
if ne and lo 0x8 0
pref = ulong 1
end
if eq btype 0
put accel_hdr_bar_kind idx ACCEL_BAR_MEMORY
put accel_hdr_bar_base idx and lo 0xfffffff0
put accel_hdr_bar_64 idx 0
put accel_hdr_bar_pref idx pref
idx = add idx 1
else
if eq btype 2
if ge add idx 1 6
ret ACCEL_PCI_ERR_INVALID_BAR
end
hi_off = add lo_off 4
if gt add hi_off 4 blen
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
hi = accel_u32_le bytes hi_off
put accel_hdr_bar_kind idx ACCEL_BAR_MEMORY
put accel_hdr_bar_base idx or shl hi 32 and lo 0xfffffff0
put accel_hdr_bar_64 idx 1
put accel_hdr_bar_pref idx pref
idx = add idx 2
else
ret ACCEL_PCI_ERR_INVALID_BAR
end
end
end
ret ACCEL_PCI_OK
end

fn accel_pci_header_parse bytes view uchar * to int
if lt len bytes ACCEL_CONFIG_HEADER_SIZE
ret ACCEL_PCI_ERR_TRUNCATED
end
htype = ulong get bytes 0x0e
if ne and htype 0x7f 0
ret ACCEL_PCI_ERR_INVALID_HDR_TYPE
end
rc = accel_pci_decode_bars bytes 0x10
if ne rc ACCEL_PCI_OK
ret rc
end
put accel_hdr 0 accel_u16_le bytes 0x00
put accel_hdr 1 accel_u16_le bytes 0x02
put accel_hdr 2 accel_u16_le bytes 0x04
put accel_hdr 3 accel_u16_le bytes 0x06
put accel_hdr 4 ulong get bytes 0x08
put accel_hdr 5 ulong get bytes 0x09
put accel_hdr 6 ulong get bytes 0x0a
put accel_hdr 7 ulong get bytes 0x0b
put accel_hdr 8 htype
mf = ulong 0
if ne and htype 0x80 0
mf = ulong 1
end
put accel_hdr 9 mf
put accel_hdr 10 accel_u16_le bytes 0x2c
put accel_hdr 11 accel_u16_le bytes 0x2e
put accel_hdr 12 ulong get bytes 0x34
put accel_hdr 13 ulong get bytes 0x3c
put accel_hdr 14 ulong get bytes 0x3d
ret ACCEL_PCI_OK
end

fn accel_pci_header_memory_enabled to bool
ret ne and get accel_hdr 2 0x0002 0
end

fn accel_pci_header_has_cap_list to bool
ret ne and get accel_hdr 3 ACCEL_STATUS_CAPS_LIST 0
end

fn accel_pci_memory_bar_size low ulong high ulong is_64_bit bool to ulong
if is_64_bit
lo_m = and low 0xfffffff0
hi_m = and high 0xffffffff
mask = or shl hi_m 32 lo_m
if or eq mask 0 eq mask 0xffffffffffffffff
ret 0
end
inv = xor mask 0xffffffffffffffff
sz = add inv 1
if ne and sz sub sz 1 0
ret 0
end
if gt sz shl ulong 1 46
ret 0
end
ret sz
end
mask32 = and low 0xfffffff0
if or eq mask32 0 eq mask32 0xffffffff
ret 0
end
inv32 = xor mask32 0xffffffff
sz32 = add inv32 1
if ne and sz32 sub sz32 1 0
ret 0
end
if gt sz32 shl ulong 1 32
ret 0
end
ret sz32
end

fn accel_pci_io_bar_size low ulong to ulong
mask32 = and low 0xfffffffc
if or eq mask32 0 eq mask32 0xffffffff
ret 0
end
inv32 = xor mask32 0xffffffff
sz32 = add inv32 1
if ne and sz32 sub sz32 1 0
ret 0
end
if gt sz32 shl ulong 1 32
ret 0
end
ret sz32
end

fn accel_pci_walk_capabilities bytes view uchar * to int
if lt len bytes ACCEL_CONFIG_SPACE_SIZE
ret ACCEL_PCI_ERR_TRUNCATED
end
put accel_cap_cnt 0 0
st = accel_u16_le bytes 0x06
if eq and st ACCEL_STATUS_CAPS_LIST 0
ret ACCEL_PCI_OK
end
off = ulong get bytes 0x34
seen = new ulong 4 0
while ne off 0 bound 64
if or lt off 0x40 ne rem off 4 0
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
if gt add off 2 ACCEL_CONFIG_SPACE_SIZE
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
word = div off 64
bit = shl ulong 1 rem off 64
if ne and get seen word bit 0
ret ACCEL_PCI_ERR_CAP_LOOP
end
put seen word or get seen word bit
cid = get bytes off
nxt = get bytes add off 1
cnt = get accel_cap_cnt 0
if eq cnt ACCEL_MAX_CAPS
ret ACCEL_PCI_ERR_TOO_MANY_CAPS
end
put accel_cap_id cnt cid
put accel_cap_off cnt uchar off
put accel_cap_next cnt nxt
put accel_cap_cnt 0 add cnt 1
off = ulong nxt
end
ret ACCEL_PCI_OK
end

fn accel_pci_cap_find cid uchar to long
cnt = get accel_cap_cnt 0
for i ulong cnt bound 48
if eq get accel_cap_id i cid
ret long i
end
end
ret -1
end

fn accel_pci_decode_msi bytes view uchar * cap_id uchar cap_off uchar to int
if ne cap_id ACCEL_CAP_ID_MSI
ret ACCEL_PCI_ERR_WRONG_CAP
end
off = ulong cap_off
if gt add off 8 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
ctrl = accel_u16_le bytes add off 2
put accel_msi 0 off
if ne and ctrl 0x0001 0
put accel_msi 1 1
else
put accel_msi 1 0
end
put accel_msi 2 shl ulong 1 and shr ctrl 1 0x7
put accel_msi 3 shl ulong 1 and shr ctrl 4 0x7
if ne and ctrl 0x0100 0
put accel_msi 5 1
else
put accel_msi 5 0
end
addr = accel_u32_le bytes add off 4
data_off = add off 8
if ne and ctrl 0x0080 0
put accel_msi 4 1
if gt add off 12 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
addr = or shl accel_u32_le bytes add off 8 32 addr
data_off = add off 12
else
put accel_msi 4 0
end
if gt add data_off 2 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
put accel_msi 6 addr
put accel_msi 7 accel_u16_le bytes data_off
ret ACCEL_PCI_OK
end

fn accel_pci_decode_msix bytes view uchar * cap_id uchar cap_off uchar to int
if ne cap_id ACCEL_CAP_ID_MSIX
ret ACCEL_PCI_ERR_WRONG_CAP
end
off = ulong cap_off
if gt add off 12 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
put accel_msix 0 off
ctrl = accel_u16_le bytes add off 2
if ne and ctrl 0x8000 0
put accel_msix 1 1
else
put accel_msix 1 0
end
if ne and ctrl 0x4000 0
put accel_msix 2 1
else
put accel_msix 2 0
end
put accel_msix 3 add and ctrl 0x07ff 1
tbl = accel_u32_le bytes add off 4
put accel_msix 4 and tbl 0x7
put accel_msix 5 and tbl 0xfffffff8
pba = accel_u32_le bytes add off 8
put accel_msix 6 and pba 0x7
put accel_msix 7 and pba 0xfffffff8
ret ACCEL_PCI_OK
end

fn accel_link_speed_from_enc enc ulong to ulong
if and ge enc 1 le enc 6
ret enc
end
ret ACCEL_LINK_UNKNOWN
end

fn accel_link_speed_gt speed ulong to ulong
if eq speed ACCEL_LINK_GEN1
ret 2
end
if eq speed ACCEL_LINK_GEN2
ret 5
end
if eq speed ACCEL_LINK_GEN3
ret 8
end
if eq speed ACCEL_LINK_GEN4
ret 16
end
if eq speed ACCEL_LINK_GEN5
ret 32
end
if eq speed ACCEL_LINK_GEN6
ret 64
end
ret 0
end

fn accel_pci_decode_pcie_link bytes view uchar * off ulong to int
if gt add off 0x14 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
put accel_pcie 5 1
lcaps = accel_u32_le bytes add off 0x0c
max_spd = accel_link_speed_from_enc and lcaps 0x0f
max_wid = and shr lcaps 4 0x3f
put accel_pcie 6 max_spd
put accel_pcie 7 max_wid
if le add off 0x20 len bytes
put accel_pcie 8 and accel_u32_le bytes add off 0x1c 0x7f
else
put accel_pcie 8 0
end
lsts = accel_u16_le bytes add off 0x12
cur_spd = accel_link_speed_from_enc and lsts 0x0f
cur_wid = and shr lsts 4 0x3f
put accel_pcie 9 cur_spd
put accel_pcie 10 cur_wid
down = ulong 0
if and ne max_spd ACCEL_LINK_UNKNOWN ne cur_spd ACCEL_LINK_UNKNOWN
if ne cur_spd max_spd
down = ulong 1
end
end
if lt cur_wid max_wid
down = ulong 1
end
put accel_pcie 11 down
ret ACCEL_PCI_OK
end

fn accel_pci_decode_pcie bytes view uchar * cap_id uchar cap_off uchar to int
if ne cap_id ACCEL_CAP_ID_PCIE
ret ACCEL_PCI_ERR_WRONG_CAP
end
off = ulong cap_off
if gt add off 8 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
cap = accel_u16_le bytes add off 2
dev_type = and shr cap 4 0x0f
dcaps = accel_u32_le bytes add off 4
max_pay = shl ulong 128 and dcaps 0x7
slot_im = ulong 0
if ne and cap 0x0100 0
slot_im = ulong 1
end
put accel_pcie 0 off
put accel_pcie 1 and cap 0x0f
put accel_pcie 2 dev_type
put accel_pcie 3 slot_im
put accel_pcie 4 max_pay
if or eq dev_type 0x8 eq dev_type 0x9
for i ulong 7
put accel_pcie add 5 i 0
end
ret ACCEL_PCI_OK
end
ret accel_pci_decode_pcie_link bytes off
end

fn accel_pci_walk_ext_capabilities bytes view uchar * to int
put accel_ecap_cnt 0 0
if gt add ACCEL_CONFIG_SPACE_SIZE 4 len bytes
ret ACCEL_PCI_OK
end
off = ulong ACCEL_CONFIG_SPACE_SIZE
seen = new ulong 64 0
cnt = ulong 0
while ne off 0 bound 70
if or ne rem off 4 0 gt add off 4 ACCEL_CONFIG_EXTENDED_SIZE
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
if gt add off 4 len bytes
ret ACCEL_PCI_ERR_OUT_OF_BOUNDS
end
word = div off 64
bit = shl ulong 1 rem off 64
if ne and get seen word bit 0
ret ACCEL_PCI_ERR_CAP_LOOP
end
put seen word or get seen word bit
if eq cnt ACCEL_MAX_EXT_CAPS
ret ACCEL_PCI_ERR_TOO_MANY_CAPS
end
hdr = accel_u32_le bytes off
put accel_ecap_id cnt ushort and hdr 0xffff
put accel_ecap_ver cnt uchar and shr hdr 16 0x0f
put accel_ecap_off cnt ushort off
cnt = add cnt 1
put accel_ecap_cnt 0 cnt
if eq and hdr 0xffff 0xffff
break
end
off = and shr hdr 20 0x0fff
end
ret ACCEL_PCI_OK
end

fn accel_pci_ecap_find cid ushort to long
cnt = get accel_ecap_cnt 0
for i ulong cnt bound 64
if eq get accel_ecap_id i cid
ret long i
end
end
ret -1
end

fn accel_pci_bridge_parse bytes view uchar * to int
if lt len bytes ACCEL_CONFIG_HEADER_SIZE
ret ACCEL_PCI_ERR_TRUNCATED
end
htype = ulong get bytes 0x0e
if ne and htype 0x7f 0x01
ret ACCEL_PCI_ERR_INVALID_HDR_TYPE
end
put accel_bridge 0 accel_u16_le bytes 0x00
put accel_bridge 1 accel_u16_le bytes 0x02
put accel_bridge 2 ulong get bytes 0x0b
put accel_bridge 3 ulong get bytes 0x0a
put accel_bridge 4 ulong get bytes 0x19
put accel_bridge 5 ulong get bytes 0x1a
ret ACCEL_PCI_OK
end

fn accel_pci_bridge_has_window to bool
sec = get accel_bridge 4
sub_bus = get accel_bridge 5
if eq sec 0
ret false
end
ret ge sub_bus sec
end

note === profile.rs: Provenance-tagged Gb10Profile & GB10 contract validation ===

fn accel_source_linux_interpreted src ulong to bool
if eq src ACCEL_SRC_LINUX_SYSFS
ret true
end
if eq src ACCEL_SRC_LINUX_PROCFS
ret true
end
ret eq src ACCEL_SRC_LINUX_ACPI
end

fn accel_buf_put_source dst edit uchar * pos ulong src ulong to ulong
if eq src ACCEL_SRC_UEFI_FW
ret accel_buf_put_str dst pos accel_src_uefi
end
if eq src ACCEL_SRC_NATIVE_PCI
ret accel_buf_put_str dst pos accel_src_native
end
if eq src ACCEL_SRC_LINUX_SYSFS
ret accel_buf_put_str dst pos accel_src_sysfs
end
if eq src ACCEL_SRC_LINUX_PROCFS
ret accel_buf_put_str dst pos accel_src_procfs
end
if eq src ACCEL_SRC_LINUX_ACPI
ret accel_buf_put_str dst pos accel_src_acpi
end
if eq src ACCEL_SRC_SYNTHETIC
ret accel_buf_put_str dst pos accel_src_synth
end
ret accel_buf_put_str dst pos accel_src_deriv
end

fn accel_prof_set_observed fid ulong src ulong to void
put accel_prof_state fid ACCEL_STATE_OBSERVED
put accel_prof_src fid src
nv = ulong 0
if eq src ACCEL_SRC_NATIVE_PCI
nv = ulong 1
end
put accel_prof_nver fid nv
end

fn accel_prof_set_derived fid ulong src ulong to void
put accel_prof_state fid ACCEL_STATE_DERIVED
put accel_prof_src fid src
put accel_prof_nver fid 0
end

fn accel_prof_mark_native_verified fid ulong to void
put accel_prof_nver fid 1
end

fn accel_prof_with_source fid ulong src ulong to void
put accel_prof_src fid src
end

fn accel_prof_is_known fid ulong to bool
ret ne get accel_prof_state fid ACCEL_STATE_UNKNOWN
end

fn accel_profile_init_unknown loc view ulong 4 to void
for i ulong 4
put accel_prof_loc i get loc i
end
for i ulong ACCEL_FACT_COUNT
put accel_prof_state i ACCEL_STATE_UNKNOWN
put accel_prof_src i ACCEL_SRC_NONE
put accel_prof_nver i 0
put accel_prof_val i 0
end
put accel_prof_numa 0 0
for i ulong 3
put accel_prof_class i 0
end
for i ulong 6
put accel_prof_bar_kind i ACCEL_BAR_NONE
put accel_prof_bar_base i 0
put accel_prof_bar_64 i 0
put accel_prof_bar_pref i 0
end
for i ulong 9
put accel_prof_pcie i 0
end
for i ulong 5
put accel_prof_msi i 0
end
for i ulong 8
put accel_prof_msix i 0
end
put accel_prof_fw_len 0 0
end

fn accel_profile_fill_caps bytes view uchar * src ulong to void
pi = accel_pci_cap_find ACCEL_CAP_ID_PCIE
if ge pi 0
idx = ulong pi
rc = accel_pci_decode_pcie bytes get accel_cap_id idx get accel_cap_off idx
if eq rc ACCEL_PCI_OK
put accel_prof_pcie 0 1
put accel_prof_pcie 1 get accel_pcie 4
for k ulong 7
put accel_prof_pcie add 2 k get accel_pcie add 5 k
end
end
end
accel_prof_set_observed ACCEL_FACT_PCIE src

mi = accel_pci_cap_find ACCEL_CAP_ID_MSI
if ge mi 0
idx = ulong mi
rc = accel_pci_decode_msi bytes get accel_cap_id idx get accel_cap_off idx
if eq rc ACCEL_PCI_OK
put accel_prof_msi 0 1
put accel_prof_msi 1 get accel_msi 1
put accel_prof_msi 2 get accel_msi 4
put accel_prof_msi 3 get accel_msi 5
put accel_prof_msi 4 get accel_msi 2
end
end
accel_prof_set_observed ACCEL_FACT_MSI src

xi = accel_pci_cap_find ACCEL_CAP_ID_MSIX
if ge xi 0
idx = ulong xi
rc = accel_pci_decode_msix bytes get accel_cap_id idx get accel_cap_off idx
if eq rc ACCEL_PCI_OK
put accel_prof_msix 0 1
put accel_prof_msix 1 get accel_msix 1
put accel_prof_msix 2 get accel_msix 2
put accel_prof_msix 3 get accel_msix 3
put accel_prof_msix 4 get accel_msix 4
put accel_prof_msix 5 get accel_msix 5
put accel_prof_msix 6 get accel_msix 6
put accel_prof_msix 7 get accel_msix 7
end
end
accel_prof_set_observed ACCEL_FACT_MSIX src
end

fn accel_profile_from_pci_config loc view ulong 4 bytes view uchar * src ulong to int
rc = accel_pci_header_parse bytes
if ne rc ACCEL_PCI_OK
ret rc
end
accel_profile_init_unknown loc
put accel_prof_val ACCEL_FACT_VENDOR_ID get accel_hdr 0
accel_prof_set_observed ACCEL_FACT_VENDOR_ID src
put accel_prof_val ACCEL_FACT_DEVICE_ID get accel_hdr 1
accel_prof_set_observed ACCEL_FACT_DEVICE_ID src
put accel_prof_val ACCEL_FACT_SUBSYS_VENDOR get accel_hdr 10
accel_prof_set_observed ACCEL_FACT_SUBSYS_VENDOR src
put accel_prof_val ACCEL_FACT_SUBSYS_ID get accel_hdr 11
accel_prof_set_observed ACCEL_FACT_SUBSYS_ID src
put accel_prof_val ACCEL_FACT_REVISION get accel_hdr 4
accel_prof_set_observed ACCEL_FACT_REVISION src
put accel_prof_class 0 get accel_hdr 7
put accel_prof_class 1 get accel_hdr 6
put accel_prof_class 2 get accel_hdr 5
accel_prof_set_observed ACCEL_FACT_CLASS src
put accel_prof_val ACCEL_FACT_COMMAND get accel_hdr 2
accel_prof_set_observed ACCEL_FACT_COMMAND src
put accel_prof_val ACCEL_FACT_STATUS get accel_hdr 3
accel_prof_set_observed ACCEL_FACT_STATUS src
for i ulong 6
put accel_prof_bar_kind i get accel_hdr_bar_kind i
put accel_prof_bar_base i get accel_hdr_bar_base i
put accel_prof_bar_64 i get accel_hdr_bar_64 i
put accel_prof_bar_pref i get accel_hdr_bar_pref i
accel_prof_set_observed add ACCEL_FACT_BAR0 i src
end
rc = accel_pci_walk_capabilities bytes
if ne rc ACCEL_PCI_OK
ret rc
end
accel_profile_fill_caps bytes src
ret ACCEL_PCI_OK
end

fn accel_write_fact_tail dst edit uchar * pos ulong fid ulong to ulong
st = get accel_prof_state fid
cur = pos
if eq st ACCEL_STATE_OBSERVED
cur = accel_buf_put_str dst cur accel_t_obs
else
cur = accel_buf_put_str dst cur accel_t_der
end
cur = accel_buf_put_source dst cur get accel_prof_src fid
cur = accel_buf_put_str dst cur accel_t_nver
cur = accel_buf_put_bool dst cur get accel_prof_nver fid
ret accel_buf_put_str dst cur accel_t_rbrk
end

fn accel_write_u64_fact dst edit uchar * pos ulong label view uchar * fid ulong to ulong
cur = accel_buf_put_str dst pos label
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state fid ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
ret accel_buf_put_str dst cur accel_t_nl
end
cur = accel_buf_put_u64_dec dst cur get accel_prof_val fid
ret accel_write_fact_tail dst cur fid
end

fn accel_write_bar_size_fact dst edit uchar * pos ulong idx ulong to ulong
fid = add ACCEL_FACT_BAR_SIZE0 idx
cur = accel_buf_put_str dst pos accel_p_bsz
cur = accel_buf_put_u64_dec dst cur idx
cur = accel_buf_put_byte dst cur uchar 93
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state fid ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
ret accel_buf_put_str dst cur accel_t_nl
end
cur = accel_buf_put_u64_dec dst cur get accel_prof_val fid
ret accel_write_fact_tail dst cur fid
end

fn accel_write_class_fact dst edit uchar * pos ulong to ulong
cur = accel_buf_put_str dst pos accel_p_cls
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_CLASS ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
ret accel_buf_put_str dst cur accel_t_nl
end
cur = accel_buf_put_str dst cur accel_f_cls0
cur = accel_buf_put_u64_dec dst cur get accel_prof_class 0
cur = accel_buf_put_str dst cur accel_f_cls1
cur = accel_buf_put_u64_dec dst cur get accel_prof_class 1
cur = accel_buf_put_str dst cur accel_f_cls2
cur = accel_buf_put_u64_dec dst cur get accel_prof_class 2
cur = accel_buf_put_str dst cur accel_f_rbrace
ret accel_write_fact_tail dst cur ACCEL_FACT_CLASS
end

fn accel_write_bar_fact dst edit uchar * pos ulong idx ulong to ulong
fid = add ACCEL_FACT_BAR0 idx
cur = accel_buf_put_str dst pos accel_p_bar
cur = accel_buf_put_u64_dec dst cur idx
cur = accel_buf_put_byte dst cur uchar 93
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state fid ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
ret accel_buf_put_str dst cur accel_t_nl
end
cur = accel_buf_put_str dst cur accel_f_bar0
cur = accel_buf_put_u64_dec dst cur idx
cur = accel_buf_put_str dst cur accel_f_bar1
knd = get accel_prof_bar_kind idx
if eq knd ACCEL_BAR_MEMORY
cur = accel_buf_put_str dst cur accel_f_mem
else
if eq knd ACCEL_BAR_IO
cur = accel_buf_put_str dst cur accel_f_io
else
cur = accel_buf_put_str dst cur accel_f_none
end
end
cur = accel_buf_put_str dst cur accel_f_bar2
cur = accel_buf_put_u64_dec dst cur get accel_prof_bar_base idx
cur = accel_buf_put_str dst cur accel_f_bar3
cur = accel_buf_put_bool dst cur get accel_prof_bar_64 idx
cur = accel_buf_put_str dst cur accel_f_bar4
cur = accel_buf_put_bool dst cur get accel_prof_bar_pref idx
cur = accel_buf_put_str dst cur accel_f_rbrace
ret accel_write_fact_tail dst cur fid
end

fn accel_write_cap_facts dst edit uchar * pos ulong to ulong
cur = accel_buf_put_str dst pos accel_p_pcie
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_PCIE ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
cur = accel_buf_put_str dst cur accel_t_nl
else
cur = accel_buf_put_str dst cur accel_f_pcie0
cur = accel_buf_put_bool dst cur get accel_prof_pcie 0
cur = accel_buf_put_str dst cur accel_f_pcie1
cur = accel_buf_put_u64_dec dst cur get accel_prof_pcie 1
cur = accel_buf_put_str dst cur accel_f_pcie2
if ne get accel_prof_pcie 2 0
cur = accel_buf_put_str dst cur accel_f_some_link
else
cur = accel_buf_put_str dst cur accel_f_none
end
cur = accel_buf_put_str dst cur accel_f_rbrace
cur = accel_write_fact_tail dst cur ACCEL_FACT_PCIE
end
cur = accel_buf_put_str dst cur accel_p_msi
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_MSI ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
cur = accel_buf_put_str dst cur accel_t_nl
else
cur = accel_buf_put_str dst cur accel_f_msi0
cur = accel_buf_put_bool dst cur get accel_prof_msi 0
cur = accel_buf_put_str dst cur accel_f_msi1
cur = accel_buf_put_bool dst cur get accel_prof_msi 1
cur = accel_buf_put_str dst cur accel_f_msi2
cur = accel_buf_put_bool dst cur get accel_prof_msi 2
cur = accel_buf_put_str dst cur accel_f_msi3
cur = accel_buf_put_bool dst cur get accel_prof_msi 3
cur = accel_buf_put_str dst cur accel_f_msi4
cur = accel_buf_put_u64_dec dst cur get accel_prof_msi 4
cur = accel_buf_put_str dst cur accel_f_rbrace
cur = accel_write_fact_tail dst cur ACCEL_FACT_MSI
end
cur = accel_buf_put_str dst cur accel_p_msix
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_MSIX ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
cur = accel_buf_put_str dst cur accel_t_nl
else
cur = accel_buf_put_str dst cur accel_f_msix0
cur = accel_buf_put_bool dst cur get accel_prof_msix 0
cur = accel_buf_put_str dst cur accel_f_msix1
cur = accel_buf_put_bool dst cur get accel_prof_msix 1
cur = accel_buf_put_str dst cur accel_f_msix2
cur = accel_buf_put_bool dst cur get accel_prof_msix 2
cur = accel_buf_put_str dst cur accel_f_msix3
cur = accel_buf_put_u64_dec dst cur get accel_prof_msix 3
cur = accel_buf_put_str dst cur accel_f_msix4
cur = accel_buf_put_u64_dec dst cur get accel_prof_msix 4
cur = accel_buf_put_str dst cur accel_f_msix5
cur = accel_buf_put_u64_dec dst cur get accel_prof_msix 5
cur = accel_buf_put_str dst cur accel_f_msix6
cur = accel_buf_put_u64_dec dst cur get accel_prof_msix 6
cur = accel_buf_put_str dst cur accel_f_msix7
cur = accel_buf_put_u64_dec dst cur get accel_prof_msix 7
cur = accel_buf_put_str dst cur accel_f_rbrace
cur = accel_write_fact_tail dst cur ACCEL_FACT_MSIX
end
ret cur
end

fn accel_write_tail_facts dst edit uchar * pos ulong to ulong
cur = accel_write_u64_fact dst pos accel_p_iommu ACCEL_FACT_IOMMU_GROUP
cur = accel_buf_put_str dst cur accel_p_numa
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_NUMA_NODE ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
cur = accel_buf_put_str dst cur accel_t_nl
else
cur = accel_buf_put_i64_dec dst cur get accel_prof_numa 0
cur = accel_write_fact_tail dst cur ACCEL_FACT_NUMA_NODE
end
cur = accel_buf_put_str dst cur accel_p_fw
cur = accel_buf_put_str dst cur accel_t_colon_sp
if eq get accel_prof_state ACCEL_FACT_FW_PATH ACCEL_STATE_UNKNOWN
cur = accel_buf_put_str dst cur accel_t_unknown
cur = accel_buf_put_str dst cur accel_t_nl
else
cur = accel_buf_put_byte dst cur uchar 34
flen = get accel_prof_fw_len 0
for i ulong flen bound 128
cur = accel_buf_put_byte dst cur get accel_prof_fw i
end
cur = accel_buf_put_byte dst cur uchar 34
cur = accel_write_fact_tail dst cur ACCEL_FACT_FW_PATH
end
cur = accel_write_u64_fact dst cur accel_p_b0 ACCEL_FACT_PMC_BOOT_0
cur = accel_write_u64_fact dst cur accel_p_b42 ACCEL_FACT_PMC_BOOT_42
ret cur
end

fn accel_profile_write dst edit uchar * to ulong
cur = accel_buf_put_str dst 0 accel_p_loc
cur = accel_buf_put_u64_dec dst cur get accel_prof_loc 0
cur = accel_buf_put_str dst cur accel_p_bus
cur = accel_buf_put_u64_dec dst cur get accel_prof_loc 1
cur = accel_buf_put_str dst cur accel_p_dev
cur = accel_buf_put_u64_dec dst cur get accel_prof_loc 2
cur = accel_buf_put_str dst cur accel_p_fn
cur = accel_buf_put_u64_dec dst cur get accel_prof_loc 3
cur = accel_buf_put_str dst cur accel_t_nl
cur = accel_write_u64_fact dst cur accel_p_vid ACCEL_FACT_VENDOR_ID
cur = accel_write_u64_fact dst cur accel_p_did ACCEL_FACT_DEVICE_ID
cur = accel_write_u64_fact dst cur accel_p_svid ACCEL_FACT_SUBSYS_VENDOR
cur = accel_write_u64_fact dst cur accel_p_sid ACCEL_FACT_SUBSYS_ID
cur = accel_write_u64_fact dst cur accel_p_rev ACCEL_FACT_REVISION
cur = accel_write_class_fact dst cur
cur = accel_write_u64_fact dst cur accel_p_cmd ACCEL_FACT_COMMAND
cur = accel_write_u64_fact dst cur accel_p_sts ACCEL_FACT_STATUS
for i ulong 6
cur = accel_write_bar_fact dst cur i
end
for i ulong 6
cur = accel_write_bar_size_fact dst cur i
end
cur = accel_write_cap_facts dst cur
ret accel_write_tail_facts dst cur
end

fn accel_match_gb10 loc view ulong 4 to int
if ne get accel_hdr 0 ACCEL_NVIDIA_VENDOR_ID
ret ACCEL_REJ_NOT_NVIDIA
end
if ne get accel_hdr 1 ACCEL_GB10_DEVICE_ID
ret ACCEL_REJ_WRONG_DEVICE
end
if not accel_pci_header_memory_enabled
ret ACCEL_REJ_MEM_DISABLED
end
knd = get accel_hdr_bar_kind 0
if eq knd ACCEL_BAR_NONE
ret ACCEL_REJ_BAR0_MISSING
end
if eq knd ACCEL_BAR_IO
ret ACCEL_REJ_BAR0_NOT_MEM
end
base = get accel_hdr_bar_base 0
if eq base 0
ret ACCEL_REJ_BAR0_UNPROGRAMMED
end
if eq get accel_hdr_bar_64 0 0
ret ACCEL_REJ_BAR0_NOT_64BIT
end
for i ulong 4
put accel_match i get loc i
end
put accel_match 4 base
put accel_match 5 get accel_hdr_bar_64 0
put accel_match 6 get accel_hdr_bar_pref 0
put accel_match 7 get accel_hdr_bar_sz_known 0
ret ACCEL_GB10_OK
end

fn accel_gb10_bar_from_header loc view ulong 4 vd ulong cs ulong bar0_lo ulong bar0_hi ulong to int
if ne and vd 0xffff ACCEL_NVIDIA_VENDOR_ID
ret ACCEL_REJ_NOT_NVIDIA
end
if ne and shr vd 16 0xffff ACCEL_GB10_DEVICE_ID
ret ACCEL_REJ_WRONG_DEVICE
end
if eq and cs 0x0002 0
ret ACCEL_REJ_MEM_DISABLED
end
if eq and bar0_lo 0x1 0x1
ret ACCEL_REJ_BAR0_NOT_MEM
end
lo32 = and bar0_lo 0xffffffff
hi32 = and bar0_hi 0xffffffff
if and eq lo32 0 eq hi32 0
ret ACCEL_REJ_BAR0_UNPROGRAMMED
end
if ne and lo32 0x7 0x4
ret ACCEL_REJ_BAR0_NOT_64BIT
end
phys = or shl hi32 32 and lo32 0xfffffff0
if eq phys 0
ret ACCEL_REJ_BAR0_UNPROGRAMMED
end
for i ulong 4
put accel_gb10_bar i get loc i
end
put accel_gb10_bar 4 phys
ret ACCEL_GB10_OK
end

note === registers.rs: Source-backed GB10 register inventory ===

fn accel_reg_name_eq name view uchar * expected view uchar * to bool
if ne len name len expected
ret false
end
for i ulong len expected bound 32
if ne get name i get expected i
ret false
end
end
ret true
end

fn accel_reg_find name view uchar * to long
if accel_reg_name_eq name accel_reg_name_0
ret 0
end
if accel_reg_name_eq name accel_reg_name_1
ret 1
end
ret -1
end

fn accel_reg_offset idx ulong to ulong
if eq idx 0
ret ACCEL_PMC_BOOT_0
end
if eq idx 1
ret ACCEL_PMC_BOOT_42
end
ret 0
end

fn accel_reg_width idx ulong to ulong
if lt idx ACCEL_REG_COUNT
ret 32
end
ret 0
end

fn accel_reg_access idx ulong to ulong
if lt idx ACCEL_REG_COUNT
ret ACCEL_REG_ACCESS_RO
end
ret ACCEL_REG_ACCESS_UNKNOWN
end

fn accel_reg_safety idx ulong to ulong
if lt idx ACCEL_REG_COUNT
ret ACCEL_REG_SAFETY_ESTABLISHED
end
ret ACCEL_REG_SAFETY_APPROVAL
end

fn accel_reg_native_observed idx ulong to bool
ret false
end

fn accel_reg_semantics_known idx ulong to bool
ret false
end

fn accel_reg_has_observed_value idx ulong to bool
ret false
end

fn accel_reg_write_one dst edit uchar * pos ulong name view uchar * off ulong to ulong
cur = accel_buf_put_str dst pos accel_r_pfx
cur = accel_buf_put_str dst cur accel_reg_block
cur = accel_buf_put_byte dst cur uchar 46
cur = accel_buf_put_str dst cur name
cur = accel_buf_put_str dst cur accel_r_off
cur = accel_buf_put_hex_w dst cur off 4
cur = accel_buf_put_str dst cur accel_r_wid
cur = accel_buf_put_u64_dec dst cur 32
cur = accel_buf_put_str dst cur accel_r_acc
cur = accel_buf_put_str dst cur accel_reg_ev
ret accel_buf_put_str dst cur accel_r_end
end

fn accel_reg_write_ledger dst edit uchar * to ulong
cur = accel_reg_write_one dst 0 accel_reg_name_0 ACCEL_PMC_BOOT_0
ret accel_reg_write_one dst cur accel_reg_name_1 ACCEL_PMC_BOOT_42
end

note SPDX-License-Identifier: Apache-2.0
note aienux/crates/aienos-accel/accel_test.om: Behavioral self-test for aienos-accel.
note Ports all unit tests from src/{lib,pci,profile,registers}.rs and tests/gb10_fixtures.rs.
note Compose with: si/directives/om2.om aienux/crates/aienos-accel/accel.om aienux/crates/aienos-accel/accel_test.om

text t_access_denied "ACCESS_DENIED"
text t_diag_l0 "gb10_pci_root_bridges: 2\n"
text t_diag_l1 "gb10_pci_root_open[0]: refused (ACCESS_DENIED)\n"
text t_diag_l2 "gb10_pci_root[1]: segment 15 devices 4 bridges 1 windows 1\n"
text t_diag_l3 "gb10_pci_candidate[1]: command_status 0x00100004 bar0 0x00000000:0x00000000\n"
text t_diag_fail "gb10_pci_root_bridges: lookup failed\n"
text t_diag_zero "gb10_pci_root_bridges: 0\n"

text t_prof_vid "gb10.profile.vendor_id: 4318 [observed source=aienos-native-pci native_verified=true]"
text t_prof_iommu "gb10.profile.iommu_group: unknown"
text t_prof_bsz0 "gb10.profile.bar_size[0]: unknown"

text t_boot0 "BOOT_0"
text t_boot42 "BOOT_42"
text t_boot1 "BOOT_1"
text t_reg_b0 "GB10 PMC.BOOT_0: offset 0x0000"
text t_reg_b42 "GB10 PMC.BOOT_42: offset 0x0a00"
text t_reg_sem "semantics_known false"
text t_reg_nat "native_observed false"

fn t_fill_base_header buf edit uchar * to void
for i ulong 256
put buf i 0
end
accel_put_u16_le buf 0x00 0x10de
accel_put_u16_le buf 0x02 0x2e12
accel_put_u16_le buf 0x04 0x0007
accel_put_u16_le buf 0x06 0x0010
put buf 0x08 uchar 0xa1
put buf 0x0b uchar 0x03
end

fn t_fill_gb10_endpoint buf edit uchar * to void
t_fill_base_header buf
accel_put_u32_le buf 0x10 0x2400000c
accel_put_u32_le buf 0x14 0x00000000
accel_put_u16_le buf 0x2c 0x10de
accel_put_u16_le buf 0x2e 0x0000
put buf 0x34 uchar 0x40
note MSI at 0x40: id 0x05, next 0x50, control 0x0388 (64-bit, maskable, 16 vectors)
put buf 0x40 ACCEL_CAP_ID_MSI
put buf 0x41 uchar 0x50
accel_put_u16_le buf 0x42 0x0388
accel_put_u32_le buf 0x44 0xfee00000
accel_put_u16_le buf 0x4c 0x0041
note PCIe at 0x50: id 0x10, next 0x80, cap 0x0002, max payload 1024, link caps/status
put buf 0x50 ACCEL_CAP_ID_PCIE
put buf 0x51 uchar 0x80
accel_put_u16_le buf 0x52 0x0002
accel_put_u32_le buf 0x54 0x00000003
accel_put_u32_le buf 0x5c 0x00457901
accel_put_u16_le buf 0x62 0x8010
note MSI-X at 0x80: id 0x11, next 0, control 0x8008 (enabled, 9 vectors), table, pba
put buf 0x80 ACCEL_CAP_ID_MSIX
put buf 0x81 uchar 0x00
accel_put_u16_le buf 0x82 0x8008
accel_put_u32_le buf 0x84 0x00b90000
accel_put_u32_le buf 0x88 0x00ba0000
end

note === Test group 1: lib.rs Gb10Bar::from_config and discovery diagnostics ===

fn test_lib_bar_and_diag to int
loc = new ulong 4 0
accel_make_loc loc 15 1 0 0
if not accel_gb10_bar_from_config loc 0x2e1210de 0x6 0x24000004 0
ret 1
end
if ne get accel_gb10_bar 4 0x24000000
ret 2
end
if accel_gb10_bar_from_config loc 0x2e1210df 0x6 0x24000004 0
ret 3
end
if accel_gb10_bar_from_config loc 0x2e1210de 0x4 0x24000004 0
ret 4
end
if accel_gb10_bar_from_config loc 0x2e1210de 0x6 0x24000000 0
ret 5
end
if accel_gb10_bar_from_config loc 0x2e1210de 0x6 0x00000004 0
ret 6
end
if accel_gb10_bar_from_config loc 0x2e1210de 0x6 0xfffffff4 0xffffffff
ret 7
end

note Diagnostics test
accel_roots_clear
rc = accel_roots_push_refused t_access_denied
if ne rc 0
ret 8
end
idx = accel_roots_push_scanned 15 4 1 1
if lt idx 0
ret 9
end
accel_roots_set_candidate ulong idx 0x100004 0 0
rc = accel_roots_push_none
if ne rc 0
ret 10
end
dbuf = new uchar 512 0
dlen = accel_write_discovery_diagnostics dbuf true 2
if not accel_buf_contains dbuf dlen t_diag_l0
ret 11
end
if not accel_buf_contains dbuf dlen t_diag_l1
ret 12
end
if not accel_buf_contains dbuf dlen t_diag_l2
ret 13
end
if not accel_buf_contains dbuf dlen t_diag_l3
ret 14
end
accel_roots_clear
rc = accel_roots_push_none
dlen = accel_write_discovery_diagnostics dbuf false 0
if not accel_buf_eq dbuf dlen t_diag_fail
ret 15
end
dlen = accel_write_discovery_diagnostics dbuf true 0
if not accel_buf_eq dbuf dlen t_diag_zero
ret 16
end
ret 0
end

note === Test group 2: pci.rs header, BARs, capabilities, bridge ===

fn test_pci_header_and_bars to int
buf = new uchar 256 0
t_fill_base_header buf
accel_put_u32_le buf 0x10 0x2400000c
accel_put_u32_le buf 0x14 0x00000001
accel_put_u16_le buf 0x2c 0x10de
if ne accel_pci_header_parse buf ACCEL_PCI_OK
ret 20
end
if ne get accel_hdr 0 0x10de
ret 21
end
if ne get accel_hdr 1 0x2e12
ret 22
end
if ne get accel_hdr 7 0x03
ret 23
end
if not accel_pci_header_memory_enabled
ret 24
end
if ne get accel_hdr_bar_kind 0 ACCEL_BAR_MEMORY
ret 25
end
if ne get accel_hdr_bar_base 0 0x0000000124000000
ret 26
end
if or eq get accel_hdr_bar_64 0 0 eq get accel_hdr_bar_pref 0 0
ret 27
end
if ne get accel_hdr_bar_kind 1 ACCEL_BAR_NONE
ret 28
end

note Reject reserved BAR encodings and 64-bit BAR in last slot
t_fill_base_header buf
accel_put_u32_le buf 0x10 0x00000006
if ne accel_pci_header_parse buf ACCEL_PCI_ERR_INVALID_BAR
ret 29
end
t_fill_base_header buf
accel_put_u32_le buf 0x24 0x0000000a
if ne accel_pci_header_parse buf ACCEL_PCI_ERR_INVALID_BAR
ret 30
end
t_fill_base_header buf
accel_put_u32_le buf 0x24 0x00000004
if ne accel_pci_header_parse buf ACCEL_PCI_ERR_INVALID_BAR
ret 31
end
t_fill_base_header buf
accel_put_u32_le buf 0x10 0x00000003
if ne accel_pci_header_parse buf ACCEL_PCI_ERR_INVALID_BAR
ret 32
end

note Truncated header and bridge header type
trunc = new uchar 16 0
if ne accel_pci_header_parse trunc ACCEL_PCI_ERR_TRUNCATED
ret 33
end
t_fill_base_header buf
put buf 0x0e uchar 0x01
if ne accel_pci_header_parse buf ACCEL_PCI_ERR_INVALID_HDR_TYPE
ret 34
end

note BridgeHeader parse and bus window
put buf 0x19 uchar 0x01
put buf 0x1a uchar 0x0f
if ne accel_pci_bridge_parse buf ACCEL_PCI_OK
ret 35
end
if or ne get accel_bridge 4 1 ne get accel_bridge 5 0x0f
ret 36
end
if not accel_pci_bridge_has_window
ret 37
end
put buf 0x19 uchar 0x00
if ne accel_pci_bridge_parse buf ACCEL_PCI_OK
ret 38
end
if accel_pci_bridge_has_window
ret 39
end
t_fill_base_header buf
if ne accel_pci_bridge_parse buf ACCEL_PCI_ERR_INVALID_HDR_TYPE
ret 40
end
ret 0
end

fn test_pci_caps_and_sizes to int
buf = new uchar 256 0

note Reject capability loop and out-of-bounds
t_fill_base_header buf
put buf 0x34 uchar 0x40
put buf 0x40 ACCEL_CAP_ID_MSI
put buf 0x41 uchar 0x40
if ne accel_pci_walk_capabilities buf ACCEL_PCI_ERR_CAP_LOOP
ret 41
end
t_fill_base_header buf
put buf 0x34 uchar 0xff
if ne accel_pci_walk_capabilities buf ACCEL_PCI_ERR_OUT_OF_BOUNDS
ret 42
end
t_fill_base_header buf
put buf 0x34 uchar 0x42
if ne accel_pci_walk_capabilities buf ACCEL_PCI_ERR_OUT_OF_BOUNDS
ret 43
end
hdr64 = new uchar 64 0
if ne accel_pci_walk_capabilities hdr64 ACCEL_PCI_ERR_TRUNCATED
ret 44
end

note Capability list absence is empty, not error
t_fill_base_header buf
accel_put_u16_le buf 0x06 0
if ne accel_pci_walk_capabilities buf ACCEL_PCI_OK
ret 45
end
if ne get accel_cap_cnt 0 0
ret 46
end
zeros = new uchar 256 0
if ne accel_pci_walk_capabilities zeros ACCEL_PCI_OK
ret 47
end
if ne get accel_cap_cnt 0 0
ret 48
end

note Decode MSI, PCIe, MSI-X from full config space
t_fill_gb10_endpoint buf
if ne accel_pci_walk_capabilities buf ACCEL_PCI_OK
ret 49
end
if ne get accel_cap_cnt 0 3
ret 50
end
mi = accel_pci_cap_find ACCEL_CAP_ID_MSI
if lt mi 0
ret 51
end
if ne accel_pci_decode_msi buf get accel_cap_id ulong mi get accel_cap_off ulong mi ACCEL_PCI_OK
ret 52
end
if or eq get accel_msi 4 0 eq get accel_msi 5 0
ret 53
end
if or ne get accel_msi 1 0 ne get accel_msi 2 16
ret 54
end
if or ne get accel_msi 7 0x0041 ne get accel_msi 6 0xfee00000
ret 55
end
pi = accel_pci_cap_find ACCEL_CAP_ID_PCIE
if lt pi 0
ret 56
end
if ne accel_pci_decode_pcie buf get accel_cap_id ulong pi get accel_cap_off ulong pi ACCEL_PCI_OK
ret 57
end
if or eq get accel_pcie 5 0 ne get accel_pcie 6 ACCEL_LINK_GEN1
ret 58
end
if or ne get accel_pcie 7 16 ne get accel_pcie 10 1
ret 59
end
if or eq get accel_pcie 11 0 ne get accel_pcie 4 1024
ret 60
end
if or ne accel_link_speed_gt ACCEL_LINK_GEN1 2 ne accel_link_speed_gt ACCEL_LINK_GEN6 64
ret 61
end
xi = accel_pci_cap_find ACCEL_CAP_ID_MSIX
if lt xi 0
ret 62
end
if ne accel_pci_decode_msix buf get accel_cap_id ulong xi get accel_cap_off ulong xi ACCEL_PCI_OK
ret 63
end
if or eq get accel_msix 1 0 ne get accel_msix 2 0
ret 64
end
if or ne get accel_msix 3 9 ne get accel_msix 4 0
ret 65
end
if or ne get accel_msix 5 0x00b90000 ne get accel_msix 7 0x00ba0000
ret 66
end
if ne accel_pci_decode_msi buf get accel_cap_id ulong xi get accel_cap_off ulong xi ACCEL_PCI_ERR_WRONG_CAP
ret 67
end

note BAR size decoding with bounds (all 10 pci.rs assertions + 64 GB BAR)
if ne accel_pci_memory_bar_size 0xf0000004 0xffffffff true 0x10000000
ret 68
end
if ne accel_pci_memory_bar_size 0xf0000004 0 false 0x10000000
ret 69
end
if ne accel_pci_memory_bar_size 0x00000004 0xffffffff true 0x100000000
ret 70
end
if ne accel_pci_memory_bar_size 0xfff00004 0xffffffff true 0x100000
ret 71
end
if ne accel_pci_memory_bar_size 0x2400000c 0 false 0
ret 72
end
if ne accel_pci_memory_bar_size 0x00000000 0 false 0
ret 73
end
if ne accel_pci_memory_bar_size 0xfffff004 0 false 0x1000
ret 74
end
if ne accel_pci_memory_bar_size 0xf0001004 0xffffffff true 0
ret 75
end
if ne accel_pci_io_bar_size 0xfffff001 0x1000
ret 76
end
if ne accel_pci_io_bar_size 0x00000001 0
ret 77
end
if ne accel_pci_memory_bar_size 0x00000004 0xfffffff0 true 0x1000000000
ret 78
end
ret 0
end

fn test_pci_extended_caps to int
ext = new uchar 4096 0
first = or or ulong 0x19 shl ulong 1 16 shl ulong 0x12c 20
accel_put_u32_le ext 0x100 first
second = or ulong 0x01 shl ulong 2 16
accel_put_u32_le ext 0x12c second
if ne accel_pci_walk_ext_capabilities ext ACCEL_PCI_OK
ret 80
end
if ne get accel_ecap_cnt 0 2
ret 81
end
i1 = accel_pci_ecap_find ushort 0x19
i2 = accel_pci_ecap_find ushort 0x01
if or lt i1 0 lt i2 0
ret 82
end
if or ne get accel_ecap_ver ulong i1 1 ne get accel_ecap_ver ulong i2 2
ret 83
end

note Extended capability loop
for i ulong 4096
put ext i 0
end
looped = or ulong 0x19 shl ulong 0x100 20
accel_put_u32_le ext 0x100 looped
if ne accel_pci_walk_ext_capabilities ext ACCEL_PCI_ERR_CAP_LOOP
ret 84
end

note Next pointer past 4096-byte space
for i ulong 4096
put ext i 0
end
oob = or ulong 0x19 shl ulong 0xfff 20
accel_put_u32_le ext 0x100 oob
if ne accel_pci_walk_ext_capabilities ext ACCEL_PCI_ERR_OUT_OF_BOUNDS
ret 85
end

note 256-byte slice yields empty extended cap list
short_buf = new uchar 256 0
if ne accel_pci_walk_ext_capabilities short_buf ACCEL_PCI_OK
ret 86
end
if ne get accel_ecap_cnt 0 0
ret 87
end
ret 0
end

note === Test group 3: profile.rs & registers.rs ===

fn test_profile_and_registers to int
buf = new uchar 256 0
t_fill_gb10_endpoint buf
loc = new ulong 4 0
accel_make_loc loc 15 1 0 0

note LinuxSysfs source classification
if ne accel_profile_from_pci_config loc buf ACCEL_SRC_LINUX_SYSFS ACCEL_PCI_OK
ret 90
end
if ne get accel_prof_val ACCEL_FACT_VENDOR_ID 0x10de
ret 91
end
if ne get accel_prof_src ACCEL_FACT_VENDOR_ID ACCEL_SRC_LINUX_SYSFS
ret 92
end
if ne get accel_prof_nver ACCEL_FACT_VENDOR_ID 0
ret 93
end
if not accel_source_linux_interpreted ACCEL_SRC_LINUX_SYSFS
ret 94
end
if accel_source_linux_interpreted ACCEL_SRC_NATIVE_PCI
ret 95
end

note AienosNativePci source classification & unknown facts
if ne accel_profile_from_pci_config loc buf ACCEL_SRC_NATIVE_PCI ACCEL_PCI_OK
ret 96
end
if eq get accel_prof_nver ACCEL_FACT_VENDOR_ID 0
ret 97
end
if ne get accel_prof_msix 3 9
ret 98
end
if eq get accel_prof_pcie 8 0
ret 99
end
if ne get accel_prof_state ACCEL_FACT_IOMMU_GROUP ACCEL_STATE_UNKNOWN
ret 100
end
if ne get accel_prof_state ACCEL_FACT_NUMA_NODE ACCEL_STATE_UNKNOWN
ret 101
end
if ne get accel_prof_state ACCEL_FACT_BAR_SIZE0 ACCEL_STATE_UNKNOWN
ret 102
end

note Deterministic profile rendering
pbuf = new uchar 4096 0
plen = accel_profile_write pbuf
if not accel_buf_contains pbuf plen t_prof_vid
ret 103
end
if not accel_buf_contains pbuf plen t_prof_iommu
ret 104
end
if not accel_buf_contains pbuf plen t_prof_bsz0
ret 105
end

note Register ledger: exactly two established offsets, no claimed semantics
if ne ACCEL_REG_COUNT 2
ret 106
end
r0 = accel_reg_find t_boot0
r1 = accel_reg_find t_boot42
rbad = accel_reg_find t_boot1
if or ne r0 0 ne r1 1
ret 107
end
if ge rbad 0
ret 108
end
if or ne accel_reg_offset 0 ACCEL_PMC_BOOT_0 ne accel_reg_offset 1 ACCEL_PMC_BOOT_42
ret 109
end
for i ulong 2
if ne accel_reg_safety i ACCEL_REG_SAFETY_ESTABLISHED
ret 110
end
if or accel_reg_native_observed i accel_reg_semantics_known i
ret 111
end
if accel_reg_has_observed_value i
ret 112
end
end
rbuf = new uchar 1024 0
rlen = accel_reg_write_ledger rbuf
nl_cnt = ulong 0
for i ulong rlen bound 1024
if eq get rbuf i 10
nl_cnt = add nl_cnt 1
end
end
if ne nl_cnt 2
ret 113
end
if not accel_buf_contains rbuf rlen t_reg_b0
ret 114
end
if not accel_buf_contains rbuf rlen t_reg_b42
ret 115
end
if not accel_buf_contains rbuf rlen t_reg_sem
ret 116
end
if not accel_buf_contains rbuf rlen t_reg_nat
ret 117
end
ret 0
end

note === Test group 4: tests/gb10_fixtures.rs ===

fn test_gb10_fixtures_relocation_and_rejections to int
buf = new uchar 256 0
t_fill_gb10_endpoint buf
if ne accel_pci_header_parse buf ACCEL_PCI_OK
ret 120
end
loc = new ulong 4 0
note 4 distinct BDF locations must all match by property
accel_make_loc loc 15 1 0 0
if ne accel_match_gb10 loc ACCEL_GB10_OK
ret 121
end
if or ne get accel_match 4 0x24000000 eq get accel_match 5 0
ret 122
end
if eq get accel_match 6 0
ret 123
end
accel_make_loc loc 0 0 0 0
if ne accel_match_gb10 loc ACCEL_GB10_OK
ret 124
end
accel_make_loc loc 3 0x44 0x1f 7
if ne accel_match_gb10 loc ACCEL_GB10_OK
ret 125
end
if or ne get accel_match 0 3 ne get accel_match 1 0x44
ret 126
end
accel_make_loc loc 0xffff 0xff 0x1f 7
if ne accel_match_gb10 loc ACCEL_GB10_OK
ret 127
end

note Rejection variants
accel_make_loc loc 15 1 0 0
t_fill_gb10_endpoint buf
accel_put_u16_le buf 0x02 0x2684
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_WRONG_DEVICE
ret 128
end
t_fill_gb10_endpoint buf
accel_put_u16_le buf 0x00 0x1234
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_NOT_NVIDIA
ret 129
end
t_fill_gb10_endpoint buf
accel_put_u16_le buf 0x04 0x0005
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_MEM_DISABLED
ret 130
end
t_fill_gb10_endpoint buf
accel_put_u32_le buf 0x10 0x00000000
accel_put_u32_le buf 0x14 0x00000000
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_BAR0_MISSING
ret 131
end
t_fill_gb10_endpoint buf
accel_put_u32_le buf 0x10 0x00000004
accel_put_u32_le buf 0x14 0x00000000
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_BAR0_UNPROGRAMMED
ret 132
end
t_fill_gb10_endpoint buf
accel_put_u32_le buf 0x10 0x24000000
accel_put_u32_le buf 0x14 0x00000000
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_BAR0_NOT_64BIT
ret 133
end
t_fill_gb10_endpoint buf
accel_put_u32_le buf 0x10 0x0000c001
rc = accel_pci_header_parse buf
if ne accel_match_gb10 loc ACCEL_REJ_BAR0_NOT_MEM
ret 134
end

note Gb10Bar::from_header direct rejection parity
if ne accel_gb10_bar_from_header loc 0x2e121234 0x6 0x24000004 0 ACCEL_REJ_NOT_NVIDIA
ret 135
end
if ne accel_gb10_bar_from_header loc 0x268410de 0x6 0x24000004 0 ACCEL_REJ_WRONG_DEVICE
ret 136
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x4 0x24000004 0 ACCEL_REJ_MEM_DISABLED
ret 137
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x6 0x0000c001 0 ACCEL_REJ_BAR0_NOT_MEM
ret 138
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x6 0 0 ACCEL_REJ_BAR0_UNPROGRAMMED
ret 139
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x6 0x24000000 0 ACCEL_REJ_BAR0_NOT_64BIT
ret 140
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x6 0x00000004 0 ACCEL_REJ_BAR0_UNPROGRAMMED
ret 141
end
if ne accel_gb10_bar_from_header loc 0x2e1210de 0x6 0x2400000c 0 ACCEL_GB10_OK
ret 142
end
if ne get accel_gb10_bar 4 0x24000000
ret 143
end
ret 0
end

fn test_gb10_fixtures_multi_bridge_caps to int
loc = new ulong 4 0
accel_make_loc loc 15 1 0 0

note Select GB10 among multiple NVIDIA devices
other = new uchar 256 0
t_fill_gb10_endpoint other
accel_put_u16_le other 0x02 0x2684
gb10 = new uchar 256 0
t_fill_gb10_endpoint gb10
matched_cnt = ulong 0
rc = accel_pci_header_parse other
if eq accel_match_gb10 loc ACCEL_GB10_OK
matched_cnt = add matched_cnt 1
end
rc = accel_pci_header_parse gb10
if eq accel_match_gb10 loc ACCEL_GB10_OK
matched_cnt = add matched_cnt 1
end
if or ne matched_cnt 1 ne get accel_match 4 0x24000000
ret 144
end

note Follow secondary bus window to downstream GB10
bridge = new uchar 64 0
accel_put_u16_le bridge 0x00 0x10de
accel_put_u16_le bridge 0x02 0x22d1
put bridge 0x0b uchar 0x06
put bridge 0x0e uchar 0x01
put bridge 0x19 uchar 0x01
put bridge 0x1a uchar 0x0f
if ne accel_pci_bridge_parse bridge ACCEL_PCI_OK
ret 145
end
if not accel_pci_bridge_has_window
ret 146
end
if or gt get accel_bridge 4 1 lt get accel_bridge 5 1
ret 147
end
rc = accel_pci_header_parse gb10
if ne accel_match_gb10 loc ACCEL_GB10_OK
ret 148
end

note Malformed capability loops and below-0x40 boundary
bad = new uchar 256 0
t_fill_gb10_endpoint bad
put bad 0x41 uchar 0x40
if ne accel_pci_walk_capabilities bad ACCEL_PCI_ERR_CAP_LOOP
ret 149
end
t_fill_gb10_endpoint bad
put bad 0x34 uchar 0x40
put bad 0x40 ACCEL_CAP_ID_MSI
put bad 0x41 uchar 0x30
if ne accel_pci_walk_capabilities bad ACCEL_PCI_ERR_OUT_OF_BOUNDS
ret 150
end

note Missing MSI and MSI-X reported as absent, not zero
no_msi = new uchar 256 0
t_fill_gb10_endpoint no_msi
put no_msi 0x34 uchar 0x50
if ne accel_pci_walk_capabilities no_msi ACCEL_PCI_OK
ret 151
end
if or ge accel_pci_cap_find ACCEL_CAP_ID_MSI 0 lt accel_pci_cap_find ACCEL_CAP_ID_PCIE 0
ret 152
end
if ne accel_profile_from_pci_config loc no_msi ACCEL_SRC_SYNTHETIC ACCEL_PCI_OK
ret 153
end
if or ne get accel_prof_msi 0 0 ne get accel_prof_msix 3 9
ret 154
end

no_msix = new uchar 256 0
t_fill_gb10_endpoint no_msix
put no_msix 0x51 uchar 0x00
if ne accel_profile_from_pci_config loc no_msix ACCEL_SRC_SYNTHETIC ACCEL_PCI_OK
ret 155
end
if or ne get accel_prof_msix 0 0 eq get accel_prof_msi 0 0
ret 156
end
if ne get accel_prof_msix 3 0
ret 157
end

note Profile decodes BAR kinds and keeps sizes unknown
if ne accel_profile_from_pci_config loc gb10 ACCEL_SRC_SYNTHETIC ACCEL_PCI_OK
ret 158
end
if ne get accel_prof_bar_kind 0 ACCEL_BAR_MEMORY
ret 159
end
if or eq get accel_prof_bar_64 0 0 eq get accel_prof_bar_pref 0 0
ret 160
end
if ne get accel_prof_bar_base 0 0x24000000
ret 161
end
for i ulong 6
if accel_prof_is_known add ACCEL_FACT_BAR_SIZE0 i
ret 162
end
end
if ne get accel_prof_bar_kind 1 ACCEL_BAR_NONE
ret 163
end
ret 0
end

fn main to int
rc = test_lib_bar_and_diag
if ne rc 0
ret rc
end
rc = test_pci_header_and_bars
if ne rc 0
ret rc
end
rc = test_pci_caps_and_sizes
if ne rc 0
ret rc
end
rc = test_pci_extended_caps
if ne rc 0
ret rc
end
rc = test_profile_and_registers
if ne rc 0
ret rc
end
rc = test_gb10_fixtures_relocation_and_rejections
if ne rc 0
ret rc
end
rc = test_gb10_fixtures_multi_bridge_caps
if ne rc 0
ret rc
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note aienux/crates/allen-reflex-kernel/reflex_kernel.om: Pure-Omega port of allen-reflex-kernel.
note Ported from aienux crates/allen-reflex-kernel/src/{lib,heap,pool,card,runner,kernel}.rs.
note Implements bounded bump heap with mark/reset and live/peak accounting, PSV training pool
note parser and 15-action mapper, exam & route card parser/validator with percent-decoding,
note deterministic multi-mode runner (reflex/nearest/perceptron) with ALLEN_D and ALLEN_P
note formatting, and kernel lifecycle entry points (heap_init/stats, card_open/kind, train,
note decide, route, close).
note Compose with: si/directives/om2.om aienux/crates/allen-reflex-kernel/reflex_kernel.om ...

note Card and budget limits
const ARK_FILE_MAX ulong 131072
const ARK_CASES_MAX ulong 512
const ARK_ID_MAX ulong 16
const ARK_TURNS_MAX ulong 4096
const ARK_SESSION_MAX ulong 999999999
const ARK_LINE_CAP ulong 8192
const ARK_ALLEN_HEAP_BYTES ulong 33554432
const ARK_POOL_MAX ulong 512
const ARK_POOL_ARENA_MAX ulong 65536
const ARK_N_LABELS ulong 15
const ARK_N_ROUTES ulong 8

note Card kinds
const ARK_KIND_NONE int -1
const ARK_KIND_EXAM int 0
const ARK_KIND_ROUTE int 1

note Card parse error codes (1..16)
const ARK_ERR_NONE int 0
const ARK_ERR_FILE_SIZE int 1
const ARK_ERR_ASCII int 2
const ARK_ERR_NO_LF int 3
const ARK_ERR_BAD_HEADER int 4
const ARK_ERR_EMPTY_LINE int 5
const ARK_ERR_TOO_MANY_CASES int 6
const ARK_ERR_NO_BAR int 7
const ARK_ERR_ID_LEN int 8
const ARK_ERR_ID_CHARS int 9
const ARK_ERR_TURNS_LEN int 10
const ARK_ERR_DUP_ID int 11
const ARK_ERR_NO_CASE int 12
const ARK_ERR_ROUTE_FIELDS int 13
const ARK_ERR_SPEAKER int 14
const ARK_ERR_SESSION int 15
const ARK_ERR_FLAGS int 16

note Pool parse error codes
const ARK_POOL_ERR_FIELDS int -1
const ARK_POOL_ERR_ACTION int -2
const ARK_POOL_ERR_CAP int -3

note Scorer modes
const ARK_MODE_REFLEX uint 0
const ARK_MODE_NEAREST uint 1
const ARK_MODE_PERCEPTRON uint 2

note Action indices (0..14)
const ARK_ACT_STATUS uint 0
const ARK_ACT_HELP uint 1
const ARK_ACT_EVIDENCE uint 2
const ARK_ACT_RECALL uint 3
const ARK_ACT_FACTS uint 4
const ARK_ACT_REMEMBER uint 5
const ARK_ACT_PREFER uint 6
const ARK_ACT_TASK uint 7
const ARK_ACT_PROMPT uint 8
const ARK_ACT_APPROVE uint 9
const ARK_ACT_DENY uint 10
const ARK_ACT_CANCEL uint 11
const ARK_ACT_NONE uint 12
const ARK_ACT_CLARIFY uint 13
const ARK_ACT_REFUSE uint 14

note Route indices (0..7)
const ARK_ROUTE_LOCAL_DET uint 0
const ARK_ROUTE_MEMORY uint 1
const ARK_ROUTE_CLARIFY uint 2
const ARK_ROUTE_REFUSE uint 3
const ARK_ROUTE_LOCAL_MODEL uint 4
const ARK_ROUTE_SPARK_INFER uint 5
const ARK_ROUTE_SPARK_OMEGESE uint 6
const ARK_ROUTE_APPROVAL uint 7

note Image capability bits (card cannot claim any)
const ARK_CAP_STORE uint 1
const ARK_CAP_DESK uint 2
const ARK_CAP_LOCAL_MODEL uint 4
const ARK_CAP_SPARK uint 8

note Header, speaker, mode, action, route and JSON text constants
text ark_exam_hdr "AIENALX1 QUALIF-ALLEN-EXAM"
text ark_route_hdr "AIENALR1 QUALIF-ALLEN-ROUTE"
text ark_owner_pfx "owner:"
text ark_guest_pfx "guest:"
text ark_tag_decide "ALLEN_D"
text ark_tag_route "ALLEN_P"

text ark_m_reflex "reflex"
text ark_m_nearest "nearest"
text ark_m_perceptron "perceptron"

text ark_a_status "status"
text ark_a_help "help"
text ark_a_evidence "evidence"
text ark_a_recall "recall"
text ark_a_facts "facts"
text ark_a_remember "remember"
text ark_a_prefer "prefer"
text ark_a_task "task"
text ark_a_prompt "prompt"
text ark_a_approve "approve"
text ark_a_deny "deny"
text ark_a_cancel "cancel"
text ark_a_none "none"
text ark_a_clarify "clarify"
text ark_a_refuse "refuse"

text ark_r_local_det "local_deterministic"

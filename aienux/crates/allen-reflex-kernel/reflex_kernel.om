text ark_r_clarify "clarify"
text ark_r_refuse "refuse"
text ark_r_local_model "local_model"
text ark_r_spark_infer "spark_inference"
text ark_r_spark_om "spark_omegese"
text ark_r_approval "approval_needed"

text ark_j_act_pfx "{\"action\":\""

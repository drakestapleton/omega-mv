note SPDX-License-Identifier: Apache-2.0
note aienux/aegis/aegis.om: Pure-Omega AIENOS AEGIS Capability Graph, Effect Intent,
note Operator Grant, J-Space World, Policy Evaluator, and Effect Broker.
note Converted from aienux crates/aienos-aegis/src/{capability,effect,world,evaluator,broker}.rs.
note Compose with: si/directives/om2.om om/tls/sha2.om aienux/aegis/aegis.om ...

const AEGIS_MAX_CAPS ulong 32
const AEGIS_MAX_DELEG_DEPTH uint 4
const AEGIS_MAX_STR ulong 64
const AEGIS_MAX_WORLDS ulong 8
const AEGIS_MAX_AUDIT ulong 64

const AEGIS_SCOPE_SYSADMIN uchar 1
const AEGIS_SCOPE_FS uchar 2
const AEGIS_SCOPE_NET uchar 3
const AEGIS_SCOPE_DEVICE uchar 4
const AEGIS_SCOPE_WORLD uchar 5
const AEGIS_SCOPE_STANDING_FETCH uchar 6
const AEGIS_SCOPE_CUSTOM uchar 7

const AEGIS_DEC_APPROVED uchar 1
const AEGIS_DEC_REQUIRES_OP uchar 2
const AEGIS_DEC_REJECTED uchar 3

const AEGIS_OK int 0
const AEGIS_ERR_NOT_FOUND int -1
const AEGIS_ERR_BAD_SIG int -2
const AEGIS_ERR_REVOKED int -3
const AEGIS_ERR_EXPIRED int -4
const AEGIS_ERR_HOLDER int -5
const AEGIS_ERR_SCOPE int -6
const AEGIS_ERR_DEPTH int -7
const AEGIS_ERR_MISSING_GRANT int -8
const AEGIS_ERR_GRANT_INTENT int -9
const AEGIS_ERR_GRANT_SIG int -10
const AEGIS_ERR_WORLD_STATE int -11
const AEGIS_ERR_CAPACITY int -12

const AEGIS_WORLD_NONE uchar 0
const AEGIS_WORLD_ACTIVE uchar 1
const AEGIS_WORLD_COMMITTED uchar 2
const AEGIS_WORLD_ROLLEDBACK uchar 3

text aegis_dom_cap "AIENOS_CAP_V1"
text aegis_dom_intent "AIENOS_INTENT_V1"
text aegis_dom_grant "AIENOS_GRANT_V1"
text aegis_act_fs_read "fs.read"
text aegis_act_fs_write "fs.write"
text aegis_act_fs_delete "fs.delete"
text aegis_act_net_fetch "net.fetch"
text aegis_act_net_read "net.read"
text aegis_act_net_connect "net.connect"
text aegis_act_net_send "net.send"
text aegis_act_dev_read "device.read"
text aegis_act_dev_write "device.write"
text aegis_act_hw_inspect "hardware.inspect"
text aegis_act_disk_format "disk.format"
text aegis_act_git_pub "git.publish"
text aegis_act_code_pub "code.publish"
text aegis_act_kern_rep "kernel.replace"
text aegis_act_sys_inst "system.install"
text aegis_act_cred_mod "credential.modify"
text aegis_act_fin_spend "finance.spend"
text aegis_pfx_device "device."
text aegis_pfx_world "world."

global aegis_op_secret uchar 32
global aegis_cap_secret uchar 32

global aegis_cap_used uchar 32
global aegis_cap_revoked uchar 32
global aegis_cap_id uchar 512
global aegis_cap_parent int 32
global aegis_cap_depth uint 32
global aegis_cap_holder ulong 32
global aegis_cap_scope uchar 32
global aegis_cap_ro uchar 32
global aegis_cap_port uint 32
global aegis_cap_exp ulong 32
global aegis_cap_str uchar 2048
global aegis_cap_slen ulong 32
global aegis_cap_str2 uchar 2048
global aegis_cap_s2len ulong 32
global aegis_cap_sig uchar 1024

global aegis_w_status uchar 8
global aegis_w_id ulong 8
global aegis_w_deltas uint 8
global aegis_w_writes uint 8
global aegis_w_deletes uint 8

global aegis_audit_cnt ulong 1
global aegis_audit_dec uchar 64
global aegis_audit_rc int 64
global aegis_audit_exec uchar 64
global aegis_audit_ts ulong 64
global aegis_audit_iid uchar 1024

global aegis_cur_iid uchar 16
global aegis_cur_grant_iid uchar 16
global aegis_cur_grant_sig uchar 32
note Grant meta: 0=present, 1=granted_at_utc, 2=op_id_len, 3=mutant_skip_grant
global aegis_cur_grant_meta ulong 4
global aegis_cur_grant_op uchar 64

note Last eval result: 0=decision, 1=reason_code (cast via long)
global aegis_last_dec uchar 1
global aegis_last_rc int 1

note Dispatch context: 0=world_id, 1=is_reversible, 2=now_utc, 3=net_port
global aegis_dctx ulong 4

note Scratch buffers for hashing (never passed as globals)
global aegis_tmp_s1 uchar 64
global aegis_tmp_s2 uchar 64
global aegis_tmp_lens ulong 2

fn aegis_dispatch_ctx world_id ulong is_rev ulong now_utc ulong port ulong to void
put aegis_dctx 0 world_id
put aegis_dctx 1 is_rev
put aegis_dctx 2 now_utc
put aegis_dctx 3 port
end

fn aegis_reset op_sec view uchar 32 cap_sec view uchar 32 to void
for i ulong 32
put aegis_op_secret i get op_sec i
put aegis_cap_secret i get cap_sec i
put aegis_cap_used i 0
put aegis_cap_revoked i 0
put aegis_cap_parent i -1
put aegis_cap_depth i 0
put aegis_cap_holder i 0
put aegis_cap_scope i 0
put aegis_cap_ro i 0
put aegis_cap_port i 0
put aegis_cap_exp i 0
put aegis_cap_slen i 0
put aegis_cap_s2len i 0
end
for w ulong 8
put aegis_w_status w AEGIS_WORLD_NONE
put aegis_w_id w 0
put aegis_w_deltas w 0
put aegis_w_writes w 0
put aegis_w_deletes w 0
end
put aegis_audit_cnt 0 0
put aegis_last_dec 0 0
put aegis_last_rc 0 0
for g ulong 4
put aegis_cur_grant_meta g 0
put aegis_dctx g 0
end
end

fn aegis_set_mutant_skip_grant v ulong to void
put aegis_cur_grant_meta 3 v
end

note ---- Byte/String & Lexical Path Helpers ----

fn aegis_str_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
n = len a
i = ulong 0
while lt i n bound 256
if ne get a i get b i
ret false
end
i = add i 1
end
ret true
end

fn aegis_str_starts a view uchar * pfx view uchar * to bool
if lt len a len pfx
ret false
end
n = len pfx
i = ulong 0
while lt i n bound 256
if ne get a i get pfx i
ret false
end
i = add i 1
end
ret true
end

fn aegis_has_dotdot p view uchar * to bool
n = len p
i = ulong 0
while lt i n bound 256
if eq get p i 46
if lt add i 1 n
if eq get p add i 1 46
prev_ok = eq i 0
if gt i 0
if eq get p sub i 1 47
prev_ok = true
end
end
next_ok = eq add i 2 n
if lt add i 2 n
if eq get p add i 2 47
next_ok = true
end
end
if and prev_ok next_ok
ret true
end
end
end
end
i = add i 1
end
ret false
end

note Lexical absolute path confinement (mirrors capability.rs path_within).
note Both path and prefix must start with '/', contain no '..' component,
note and path must equal prefix or be inside prefix/ (prefix "/" matches any absolute path).
fn aegis_path_within path view uchar * prefix view uchar * to bool
plen = len path
xlen = len prefix
if or eq plen 0 eq xlen 0
ret false
end
if or ne get path 0 47 ne get prefix 0 47
ret false
end
if or aegis_has_dotdot path aegis_has_dotdot prefix
ret false
end
if and eq xlen 1 eq get prefix 0 47
ret true
end
note Trim trailing '/' on prefix for comparison
ex = xlen
while and gt ex 1 eq get prefix sub ex 1 47 bound 64
ex = sub ex 1
end
if lt plen ex
ret false
end
i = ulong 0
while lt i ex bound 256
if ne get path i get prefix i
ret false
end
i = add i 1
end
if eq plen ex
ret true
end
ret eq get path ex 47
end

note ---- SHA-256 Encoding Helpers ----

fn aegis_put_be64 buf edit uchar 8 v ulong to void
put buf 0 uchar and shr v 56 0xff
put buf 1 uchar and shr v 48 0xff
put buf 2 uchar and shr v 40 0xff
put buf 3 uchar and shr v 32 0xff
put buf 4 uchar and shr v 24 0xff
put buf 5 uchar and shr v 16 0xff
put buf 6 uchar and shr v 8 0xff
put buf 7 uchar and v 0xff
end

fn aegis_sha_u64 c edit ulong 40 v ulong to void
b = new uchar 8 0
aegis_put_be64 b v
sha256_update c b
end

fn aegis_sha_field c edit ulong 40 f view uchar * to void
aegis_sha_u64 c len f
if gt len f 0
sha256_update c f
end
end

fn aegis_copy_cap_s1 slot ulong dst edit uchar 64 to ulong
n = get aegis_cap_slen slot
base = mul slot AEGIS_MAX_STR
i = ulong 0
while lt i n bound 64
put dst i get aegis_cap_str add base i
i = add i 1
end
ret n
end

fn aegis_copy_cap_s2 slot ulong dst edit uchar 64 to ulong
n = get aegis_cap_s2len slot
base = mul slot AEGIS_MAX_STR
i = ulong 0
while lt i n bound 64
put dst i get aegis_cap_str2 add base i
i = add i 1
end
ret n
end

note Compute 32-byte SHA-256 signature for capability at slot.
fn aegis_cap_compute_sig slot ulong out_sig edit uchar 32 to void
c = new ulong 40 0
sec = new uchar 32 0
s1 = new uchar 64 0
s2 = new uchar 64 0
for i ulong 32
put sec i get aegis_cap_secret i
end
sha256_init c
sha256_update c aegis_dom_cap
sha256_update c sec
aegis_sha_u64 c get aegis_cap_holder slot
aegis_sha_u64 c ulong get aegis_cap_scope slot
aegis_sha_u64 c ulong get aegis_cap_ro slot
aegis_sha_u64 c ulong get aegis_cap_port slot
aegis_sha_u64 c get aegis_cap_exp slot
aegis_sha_u64 c ulong get aegis_cap_depth slot
n1 = aegis_copy_cap_s1 slot s1
aegis_sha_field c part s1 0 n1
n2 = aegis_copy_cap_s2 slot s2
aegis_sha_field c part s2 0 n2
sha256_final c out_sig
end

fn aegis_eq32 a view uchar 32 b view uchar 32 to bool
diff = uchar 0
for i ulong 32
diff = or diff xor get a i get b i
end
ret eq diff 0
end

fn aegis_eq16 a view uchar 16 b view uchar 16 to bool
diff = uchar 0
for i ulong 16
diff = or diff xor get a i get b i
end
ret eq diff 0
end

note ---- Scope Attenuation & Action Authorization ----

fn aegis_scope_contains parent_slot ulong child_scope uchar child_ro uchar child_port uint c1 view uchar * to bool
ps = get aegis_cap_scope parent_slot
if eq ps AEGIS_SCOPE_SYSADMIN
ret true
end
if ne ps child_scope
ret false
end
p1 = new uchar 64 0
pn1 = aegis_copy_cap_s1 parent_slot p1
pro = get aegis_cap_ro parent_slot
pport = get aegis_cap_port parent_slot
if eq ps AEGIS_SCOPE_FS
if not aegis_path_within c1 part p1 0 pn1
ret false
end
if and ne pro 0 eq child_ro 0
ret false
end
ret true
end
if eq ps AEGIS_SCOPE_STANDING_FETCH
if and eq pn1 1 eq get p1 0 42
ret true
end
ret aegis_str_eq part p1 0 pn1 c1
end
if eq ps AEGIS_SCOPE_NET
host_ok = false
if and eq pn1 1 eq get p1 0 42
host_ok = true
else
host_ok = aegis_str_eq part p1 0 pn1 c1
end
port_ok = or eq pport 0 eq pport child_port
ret and host_ok port_ok
end
if eq ps AEGIS_SCOPE_DEVICE
if not aegis_str_eq part p1 0 pn1 c1
ret false
end
if and ne pro 0 eq child_ro 0
ret false
end
ret true
end
if eq ps AEGIS_SCOPE_WORLD
ret le child_port pport
end
ret false
end

note ---- Capability Graph Operations ----

fn aegis_find_free_cap to long
i = ulong 0
while lt i AEGIS_MAX_CAPS bound 32
if eq get aegis_cap_used i 0
ret long i
end
i = add i 1
end
ret -1
end

fn aegis_store_cap_fields slot ulong holder ulong scope uchar ro uchar port uint exp ulong to void
put aegis_cap_used slot 1
put aegis_cap_revoked slot 0
put aegis_cap_holder slot holder
put aegis_cap_scope slot scope
put aegis_cap_ro slot ro
put aegis_cap_port slot port
put aegis_cap_exp slot exp
end

fn aegis_store_cap_strs slot ulong s1 view uchar * s2 view uchar * to void
n1 = len s1
if gt n1 AEGIS_MAX_STR
n1 = AEGIS_MAX_STR
end
put aegis_cap_slen slot n1
b1 = mul slot AEGIS_MAX_STR
i = ulong 0
while lt i n1 bound 64
put aegis_cap_str add b1 i get s1 i
i = add i 1
end
n2 = len s2
if gt n2 AEGIS_MAX_STR
n2 = AEGIS_MAX_STR
end
put aegis_cap_s2len slot n2
b2 = mul slot AEGIS_MAX_STR
j = ulong 0
while lt j n2 bound 64
put aegis_cap_str2 add b2 j get s2 j
j = add j 1
end
end

fn aegis_finalize_cap slot ulong to void
sig = new uchar 32 0
aegis_cap_compute_sig slot sig
sb = mul slot 32
ib = mul slot 16
for i ulong 32
put aegis_cap_sig add sb i get sig i
end
for k ulong 16
put aegis_cap_id add ib k get sig k
end
end

note Issue a root capability token. Returns slot index (0..31) or negative AEGIS_ERR_*.
fn aegis_cap_issue holder ulong scope uchar ro uchar port uint exp ulong to int
s = aegis_find_free_cap
if lt s 0
ret AEGIS_ERR_CAPACITY
end
slot = ulong s
put aegis_cap_parent slot -1
put aegis_cap_depth slot 0
aegis_store_cap_fields slot holder scope ro port exp
put aegis_cap_slen slot 0
put aegis_cap_s2len slot 0
aegis_finalize_cap slot
ret int slot
end

fn aegis_cap_set_strings slot ulong s1 view uchar * s2 view uchar * to void
aegis_store_cap_strs slot s1 s2
aegis_finalize_cap slot
end

fn aegis_cap_validate slot ulong now_utc ulong to int
if ge slot AEGIS_MAX_CAPS
ret AEGIS_ERR_NOT_FOUND
end
if eq get aegis_cap_used slot 0
ret AEGIS_ERR_NOT_FOUND
end
if ne get aegis_cap_revoked slot 0
ret AEGIS_ERR_REVOKED
end
exp = get aegis_cap_exp slot
if and ne exp 0 gt now_utc exp
ret AEGIS_ERR_EXPIRED
end
want = new uchar 32 0
have = new uchar 32 0
aegis_cap_compute_sig slot want
sb = mul slot 32
for i ulong 32
put have i get aegis_cap_sig add sb i
end
if not aegis_eq32 want have
ret AEGIS_ERR_BAD_SIG
end
ret AEGIS_OK
end

note Delegate an attenuated capability from parent_slot to new_holder.
note Call aegis_set_tmp_strs(c1, c2) before calling, or use aegis_cap_delegate_strs.
fn aegis_set_tmp_strs s1 view uchar * s2 view uchar * to void
for z ulong 64
put aegis_tmp_s1 z 0
put aegis_tmp_s2 z 0
end
n1 = len s1
if gt n1 64
n1 = ulong 64
end
i = ulong 0
while lt i n1 bound 64
put aegis_tmp_s1 i get s1 i
i = add i 1
end
n2 = len s2
if gt n2 64
n2 = ulong 64
end
j = ulong 0
while lt j n2 bound 64
put aegis_tmp_s2 j get s2 j
j = add j 1
end
end

fn aegis_cap_delegate parent_slot ulong new_holder ulong scope uchar ro uchar port uint exp ulong to int
vrc = aegis_cap_validate parent_slot 0
if ne vrc AEGIS_OK
ret vrc
end
pdepth = get aegis_cap_depth parent_slot
if ge pdepth AEGIS_MAX_DELEG_DEPTH
ret AEGIS_ERR_DEPTH
end
note Expiry cannot exceed parent expiry when parent has one
pexp = get aegis_cap_exp parent_slot
if ne pexp 0
if or eq exp 0 gt exp pexp
ret AEGIS_ERR_SCOPE
end
end
s = aegis_find_free_cap
if lt s 0
ret AEGIS_ERR_CAPACITY
end
slot = ulong s
put aegis_cap_parent slot int parent_slot
put aegis_cap_depth slot add pdepth 1
aegis_store_cap_fields slot new_holder scope ro port exp
put aegis_cap_slen slot 0
put aegis_cap_s2len slot 0
aegis_finalize_cap slot
ret int slot
end

note Delegate with string scope (FS path, host, device) and strict attenuation check.
fn aegis_cap_delegate_scoped parent_slot ulong new_holder ulong scope uchar ro uchar c1 view uchar * to int
vrc = aegis_cap_validate parent_slot 0
if ne vrc AEGIS_OK
ret vrc
end
pdepth = get aegis_cap_depth parent_slot
if ge pdepth AEGIS_MAX_DELEG_DEPTH
ret AEGIS_ERR_DEPTH
end
if not aegis_scope_contains parent_slot scope ro 0 c1
ret AEGIS_ERR_SCOPE
end
s = aegis_find_free_cap
if lt s 0
ret AEGIS_ERR_CAPACITY
end
slot = ulong s
put aegis_cap_parent slot int parent_slot
put aegis_cap_depth slot add pdepth 1
aegis_store_cap_fields slot new_holder scope ro 0 get aegis_cap_exp parent_slot
empty = new uchar 1 0
aegis_store_cap_strs slot c1 part empty 0 0
aegis_finalize_cap slot
ret int slot
end

note Cascading subtree revocation: revoking slot revokes all descendants.
fn aegis_cap_revoke slot ulong to int
if ge slot AEGIS_MAX_CAPS
ret AEGIS_ERR_NOT_FOUND
end
if eq get aegis_cap_used slot 0
ret AEGIS_ERR_NOT_FOUND
end
put aegis_cap_revoked slot 1
note Fixed-point pass over max 32 tokens (depth <= 4, so 5 passes always converge)
pass = ulong 0
while lt pass 6 bound 6
i = ulong 0
while lt i AEGIS_MAX_CAPS bound 32
if and ne get aegis_cap_used i 0 eq get aegis_cap_revoked i 0
p = get aegis_cap_parent i
if ge p 0
if ne get aegis_cap_revoked ulong p 0
put aegis_cap_revoked i 1
end
end
end
i = add i 1
end
pass = add pass 1
end
ret AEGIS_OK
end

note ---- Effect Intent ID & Operator Grant Cryptography ----

note Compute deterministic 16-byte EffectIntent ID with length-prefixed parameter boundaries.
fn aegis_compute_intent_id agent_id ulong cap_slot ulong act view uchar * arg view uchar * to void
c = new ulong 40 0
dig = new uchar 32 0
cid = new uchar 16 0
if lt cap_slot AEGIS_MAX_CAPS
cb = mul cap_slot 16
for i ulong 16
put cid i get aegis_cap_id add cb i
end
end
sha256_init c
sha256_update c aegis_dom_intent
aegis_sha_u64 c agent_id
aegis_sha_field c act
sha256_update c cid
aegis_sha_field c arg
sha256_final c dig
for k ulong 16
put aegis_cur_iid k get dig k
end
end

note Compute 16-byte intent ID for an explicit (key, value) pair to prove boundary separation.
fn aegis_intent_hash_kv agent_id ulong pkey view uchar * pval view uchar * to void
c = new ulong 40 0
dig = new uchar 32 0
sha256_init c
sha256_update c aegis_dom_intent
aegis_sha_u64 c agent_id
aegis_sha_field c pkey
aegis_sha_field c pval
sha256_final c dig
for k ulong 16
put aegis_cur_iid k get dig k
end
end

fn aegis_grant_compute_sig iid view uchar 16 op_id view uchar * ts ulong sec view uchar 32 out_sig edit uchar 32 to void
c = new ulong 40 0
sha256_init c
sha256_update c aegis_dom_grant
sha256_update c sec
sha256_update c iid
aegis_sha_field c op_id
aegis_sha_u64 c ts
sha256_final c out_sig
end

fn aegis_grant_clear to void
put aegis_cur_grant_meta 0 0
end

note Issue an operator grant for the current intent ID (aegis_cur_iid) using the given secret.
fn aegis_grant_issue_with_secret op_id view uchar * ts ulong sec view uchar 32 to void
iid = new uchar 16 0
sig = new uchar 32 0
for i ulong 16
put iid i get aegis_cur_iid i
put aegis_cur_grant_iid i get aegis_cur_iid i
end
aegis_grant_compute_sig iid op_id ts sec sig
for j ulong 32
put aegis_cur_grant_sig j get sig j
end
n = len op_id
if gt n 64
n = ulong 64
end
k = ulong 0
while lt k n bound 64
put aegis_cur_grant_op k get op_id k
k = add k 1
end
put aegis_cur_grant_meta 0 1
put aegis_cur_grant_meta 1 ts
put aegis_cur_grant_meta 2 n
end

fn aegis_grant_verify_current to int
if eq get aegis_cur_grant_meta 0 0
ret AEGIS_ERR_MISSING_GRANT
end
iid = new uchar 16 0
giid = new uchar 16 0
for i ulong 16
put iid i get aegis_cur_iid i
put giid i get aegis_cur_grant_iid i
end
if not aegis_eq16 iid giid
ret AEGIS_ERR_GRANT_INTENT
end
op_buf = new uchar 64 0
oplen = get aegis_cur_grant_meta 2
k = ulong 0
while lt k oplen bound 64
put op_buf k get aegis_cur_grant_op k
k = add k 1
end
sec = new uchar 32 0
have = new uchar 32 0
want = new uchar 32 0
for s ulong 32
put sec s get aegis_op_secret s
put have s get aegis_cur_grant_sig s
end
aegis_grant_compute_sig giid part op_buf 0 oplen get aegis_cur_grant_meta 1 sec want
if not aegis_eq32 want have
ret AEGIS_ERR_GRANT_SIG
end
ret AEGIS_OK
end

note ---- J-Space Copy-on-Write Worlds ----

fn aegis_world_create wid ulong to int
i = ulong 0
while lt i AEGIS_MAX_WORLDS bound 8
if eq get aegis_w_status i AEGIS_WORLD_NONE
put aegis_w_status i AEGIS_WORLD_ACTIVE
put aegis_w_id i wid
put aegis_w_deltas i 0
put aegis_w_writes i 0
put aegis_w_deletes i 0
ret int i
end
i = add i 1
end
ret AEGIS_ERR_CAPACITY
end

fn aegis_world_find wid ulong to int
i = ulong 0
while lt i AEGIS_MAX_WORLDS bound 8
if and ne get aegis_w_status i AEGIS_WORLD_NONE eq get aegis_w_id i wid
ret int i
end
i = add i 1
end
ret AEGIS_ERR_NOT_FOUND
end

fn aegis_world_rollback wid ulong to int
idx = aegis_world_find wid
if lt idx 0
ret AEGIS_ERR_NOT_FOUND
end
u = ulong idx
put aegis_w_deltas u 0
put aegis_w_writes u 0
put aegis_w_deletes u 0
put aegis_w_status u AEGIS_WORLD_ROLLEDBACK
ret AEGIS_OK
end

fn aegis_world_commit wid ulong to int
idx = aegis_world_find wid
if lt idx 0
ret AEGIS_ERR_NOT_FOUND
end
u = ulong idx
if ne get aegis_w_status u AEGIS_WORLD_ACTIVE
ret AEGIS_ERR_WORLD_STATE
end
put aegis_w_status u AEGIS_WORLD_COMMITTED
ret AEGIS_OK
end

note ---- Policy Evaluator & Effect Broker ----

fn aegis_is_high_impact act view uchar * to bool
if or aegis_str_eq act aegis_act_disk_format aegis_str_eq act aegis_act_fs_delete
ret true
end
if or aegis_str_eq act aegis_act_fs_write aegis_str_eq act aegis_act_git_pub
ret true
end
if or aegis_str_eq act aegis_act_code_pub aegis_str_eq act aegis_act_kern_rep
ret true
end
if or aegis_str_eq act aegis_act_sys_inst aegis_str_eq act aegis_act_cred_mod
ret true
end
ret aegis_str_eq act aegis_act_fin_spend
end

fn aegis_scope_authorizes slot ulong act view uchar * arg view uchar * port uint to bool
sc = get aegis_cap_scope slot
if eq sc AEGIS_SCOPE_SYSADMIN
ret true
end
p1 = new uchar 64 0
pn1 = aegis_copy_cap_s1 slot p1
ro = get aegis_cap_ro slot
if eq sc AEGIS_SCOPE_FS
if aegis_str_eq act aegis_act_fs_read
ret aegis_path_within arg part p1 0 pn1
end
if or aegis_str_eq act aegis_act_fs_write aegis_str_eq act aegis_act_fs_delete
if ne ro 0
ret false
end
ret aegis_path_within arg part p1 0 pn1
end
ret false
end
if eq sc AEGIS_SCOPE_STANDING_FETCH
if or aegis_str_eq act aegis_act_net_fetch aegis_str_eq act aegis_act_net_read
if and eq pn1 1 eq get p1 0 42
ret true
end
ret aegis_str_eq part p1 0 pn1 arg
end
ret false
end
if eq sc AEGIS_SCOPE_NET
if or aegis_str_eq act aegis_act_net_connect aegis_str_eq act aegis_act_net_send
host_ok = false
if and eq pn1 1 eq get p1 0 42
host_ok = true
else
host_ok = aegis_str_eq part p1 0 pn1 arg
end
pport = get aegis_cap_port slot
port_ok = or eq pport 0 eq pport port
ret and host_ok port_ok
end
ret false
end
if eq sc AEGIS_SCOPE_DEVICE
if aegis_str_starts act aegis_pfx_device
if not aegis_str_eq part p1 0 pn1 arg
ret false
end
if and aegis_str_eq act aegis_act_dev_write ne ro 0
ret false
end
ret true
end
ret false
end
if eq sc AEGIS_SCOPE_WORLD
ret aegis_str_starts act aegis_pfx_world
end
ret false
end

fn aegis_record_audit dec uchar rc int executed uchar ts ulong to void
cnt = get aegis_audit_cnt 0
if lt cnt AEGIS_MAX_AUDIT
put aegis_audit_dec cnt dec
put aegis_audit_rc cnt rc
put aegis_audit_exec cnt executed
put aegis_audit_ts cnt ts
ib = mul cnt 16
for k ulong 16
put aegis_audit_iid add ib k get aegis_cur_iid k
end
put aegis_audit_cnt 0 add cnt 1
end
put aegis_last_dec 0 dec
put aegis_last_rc 0 rc
end

fn aegis_try_world_delta act view uchar * to bool
world_id = get aegis_dctx 0
if or eq world_id 0 eq get aegis_dctx 1 0
ret false
end
is_wfs = or aegis_str_eq act aegis_act_fs_write aegis_str_eq act aegis_act_fs_delete
if not is_wfs
ret false
end
widx = aegis_world_find world_id
if lt widx 0
ret false
end
wu = ulong widx
if ne get aegis_w_status wu AEGIS_WORLD_ACTIVE
ret false
end
put aegis_w_deltas wu add get aegis_w_deltas wu 1
if aegis_str_eq act aegis_act_fs_write
put aegis_w_writes wu add get aegis_w_writes wu 1
else
put aegis_w_deletes wu add get aegis_w_deletes wu 1
end
ret true
end

note Evaluate and dispatch an EffectIntent through the AEGIS Broker.
note Uses aegis_dctx: [0]=world_id, [1]=is_reversible, [2]=now_utc, [3]=net_port.
note Returns AEGIS_OK if approved & executed, else negative AEGIS_ERR_*.
fn aegis_broker_dispatch agent_id ulong cap_slot ulong act view uchar * arg view uchar * to int
now_utc = get aegis_dctx 2
aegis_compute_intent_id agent_id cap_slot act arg
note Step 1: Validate capability token
vrc = aegis_cap_validate cap_slot now_utc
if ne vrc AEGIS_OK
aegis_record_audit AEGIS_DEC_REJECTED vrc 0 now_utc
ret vrc
end
note Step 2: Validate holder == proposing agent
if ne get aegis_cap_holder cap_slot agent_id
aegis_record_audit AEGIS_DEC_REJECTED AEGIS_ERR_HOLDER 0 now_utc
ret AEGIS_ERR_HOLDER
end
note Step 3: Scope authorizes action + target arg
if not aegis_scope_authorizes cap_slot act arg uint get aegis_dctx 3
aegis_record_audit AEGIS_DEC_REJECTED AEGIS_ERR_SCOPE 0 now_utc
ret AEGIS_ERR_SCOPE
end
note Step 4: Active broker-owned World delta fast-path for reversible fs.write/fs.delete
if aegis_try_world_delta act
aegis_record_audit AEGIS_DEC_APPROVED AEGIS_OK 1 now_utc
ret AEGIS_OK
end
note Step 5: StandingFetch / read-only autonomous path when not high-impact
is_stand = eq get aegis_cap_scope cap_slot AEGIS_SCOPE_STANDING_FETCH
is_ro_act = or aegis_str_eq act aegis_act_fs_read aegis_str_eq act aegis_act_hw_inspect
if and or is_stand is_ro_act not aegis_is_high_impact act
aegis_record_audit AEGIS_DEC_APPROVED AEGIS_OK 1 now_utc
ret AEGIS_OK
end
note Step 6: Irreversible / high-impact boundary requires verified OperatorGrant
if ne get aegis_cur_grant_meta 3 0
note Mutant: skip operator grant verification on high-impact boundary
aegis_record_audit AEGIS_DEC_APPROVED AEGIS_OK 1 now_utc
ret AEGIS_OK
end
grc = aegis_grant_verify_current
if eq grc AEGIS_ERR_MISSING_GRANT
aegis_record_audit AEGIS_DEC_REQUIRES_OP AEGIS_ERR_MISSING_GRANT 0 now_utc
ret AEGIS_ERR_MISSING_GRANT
end
if ne grc AEGIS_OK
aegis_record_audit AEGIS_DEC_REJECTED grc 0 now_utc
ret grc
end
aegis_record_audit AEGIS_DEC_APPROVED AEGIS_OK 1 now_utc
ret AEGIS_OK
end

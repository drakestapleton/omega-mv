note aienux/debugger/main.om: CLI entrypoint for spark-debugger watchdog & JSON-RPC stdio server
note Compose with: si/directives/om2.om aienux/debugger/lib.om aienux/debugger/main.om

text dm_cmd_mcp "mcp"
text dm_cmd_rpc "rpc"
text dm_cmd_flag_mcp "--mcp"
text dm_cmd_check "check"
text dm_cmd_diag "diagnose"
text dm_cmd_triage "triage"

text dm_hdr "=== SparkOS Sovereign Watchdog: System Diagnostic Audit ===\n"
text dm_l_sev "Severity:       "
text dm_l_rsn "Reason Mask:    "
text dm_l_load "Load (x100):    "
text dm_l_mem "Memory Used %:  "
text dm_l_disk "Disk Free %:    "
text dm_l_gtemp "GPU Temp (C):   "
text dm_l_gmem "GPU Mem %:      "
text dm_l_svc "Services Up:    "
text dm_l_env "Env Leaks:      "
text dm_l_bld "Build Passed:   "
text dm_l_ovr "Overall Status: "
text dm_s_green "ALL SYSTEMS GREEN\n"
text dm_s_attn "ATTENTION REQUIRED\n"
text dm_err_snap "spark-debugger: invalid metric snapshot\n"
text dm_usage "Usage: spark-debugger [check|diagnose|triage|mcp|rpc]\n"
text dm_slash "/"
text dm_nl "\n"

fn dbg_read_stdin dst edit uchar * to ulong
cap = len dst
pos = ulong 0
note bound 65536 caps stdin payload
while lt pos cap bound 65536
remn = sub cap pos
k = read int 0 dst pos remn
if le k long 0
break
end
pos = add pos ulong k
end
ret pos
end

fn dbg_run_rpc_stdio to int
inp = new uchar 32768 0
outbuf = new uchar 2048 0
wd = new Watchdog 0 0 0 2 2 1 0 0 0 0 0
dbg_wd_init wd ulong 2 ulong 2 ulong 1
n = dbg_read_stdin inp
pos = ulong 0
while lt pos n bound 32768
ls = pos
while lt pos n bound 32768
if eq get inp pos uchar 10
break
end
pos = add pos ulong 1
end
ll = sub pos ls
if lt pos n
pos = add pos ulong 1
end
if gt ll ulong 0
ol = dbg_rpc_dispatch part inp ls ll wd outbuf
if gt ol ulong 0
if not dbg_write_all int 1 part outbuf 0 ol
ret 1
end
end
end
end
ret 0
end

fn dbg_triage_one_line line view uchar * wd edit Watchdog step_no ulong to int
outbuf = new uchar 1024 0
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
st = new StepOut 0 0 0 0 0 0
idbuf = new uchar 16 0
rc = dbg_parse_snapshot line snap
if ne rc DBG_OK
w = dbg_write_all int 2 dm_err_snap
if w
ret 1
end
ret 1
end
dbg_wd_step wd snap st
il = dbg_put_u64 idbuf ulong 0 step_no
ol = dbg_render_triage_json part idbuf 0 il st wd outbuf
if not dbg_write_all int 1 part outbuf 0 ol
ret 1
end
ret 0
end

fn dbg_run_triage_stdio to int
inp = new uchar 32768 0
wd = new Watchdog 0 0 0 2 2 1 0 0 0 0 0
dbg_wd_init wd ulong 2 ulong 2 ulong 1
n = dbg_read_stdin inp
pos = ulong 0
step_no = ulong 0
while lt pos n bound 32768
ls = pos
while lt pos n bound 32768
if eq get inp pos uchar 10
break
end
pos = add pos ulong 1
end
ll = sub pos ls
if lt pos n
pos = add pos ulong 1
end
if gt ll ulong 0
step_no = add step_no ulong 1
rc = dbg_triage_one_line part inp ls ll wd step_no
if ne rc int 0
ret rc
end
end
end
ret 0
end

fn dbg_render_report snap view MetricSnap tr view TriageRes dst edit uchar * to ulong
p = dbg_put_s dst ulong 0 dm_hdr
p = dbg_put_s dst p dm_l_sev
p = dbg_put_sev dst p get tr sev
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_rsn
p = dbg_put_u64 dst p get tr reasons
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_load
p = dbg_put_u64 dst p get snap load_x100
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_mem
p = dbg_put_u64 dst p get snap mem_pct
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_disk
p = dbg_put_u64 dst p get snap disk_free
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_gtemp
p = dbg_put_u64 dst p get snap gpu_temp
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_gmem
p = dbg_put_u64 dst p get snap gpu_mem
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_svc
p = dbg_put_u64 dst p get snap svc_up
p = dbg_put_s dst p dm_slash
p = dbg_put_u64 dst p get snap svc_total
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_env
p = dbg_put_u64 dst p get snap env_leaks
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_bld
p = dbg_put_bool dst p get snap build_ok
p = dbg_put_s dst p dm_nl
p = dbg_put_s dst p dm_l_ovr
if eq get tr healthy ulong 1
p = dbg_put_s dst p dm_s_green
else
p = dbg_put_s dst p dm_s_attn
end
ret p
end

fn dbg_run_check_stdio to int
inp = new uchar 4096 0
outbuf = new uchar 2048 0
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
tr = new TriageRes 0 0 0
n = dbg_read_stdin inp
if gt n ulong 0
rc = dbg_parse_snapshot part inp 0 n snap
if ne rc DBG_OK
w = dbg_write_all int 2 dm_err_snap
if w
ret 1
end
ret 1
end
else
dbg_snap_init snap
end
dbg_classify snap tr
ol = dbg_render_report snap tr outbuf
if not dbg_write_all int 1 part outbuf 0 ol
ret 1
end
if eq get tr healthy ulong 1
ret 0
end
ret 1
end

fn main to int
arg1 = new uchar 64 0
ac = argcnt
if le ac long 1
ret dbg_run_check_stdio
end
n1 = argread ulong 1 arg1 ulong 0 ulong 64
if le n1 long 0
ret 2
end
u1 = ulong n1
if or dbg_eq part arg1 0 u1 dm_cmd_mcp or dbg_eq part arg1 0 u1 dm_cmd_rpc dbg_eq part arg1 0 u1 dm_cmd_flag_mcp
ret dbg_run_rpc_stdio
end
if or dbg_eq part arg1 0 u1 dm_cmd_check dbg_eq part arg1 0 u1 dm_cmd_diag
ret dbg_run_check_stdio
end
if dbg_eq part arg1 0 u1 dm_cmd_triage
ret dbg_run_triage_stdio
end
w = dbg_write_all int 2 dm_usage
if w
ret 2
end
ret 2
end

fn dbg_rpc_is_object req view uchar * to bool
n = len req
if lt n ulong 2
ret false
end
if gt n ulong 8192
ret false
end
s = ulong 0
while lt s n bound 8192
if not dbg_is_ws get req s
break
end
s = add s ulong 1
end
e = n
while gt e ulong 0 bound 8192
idx = sub e ulong 1
if not dbg_is_ws get req idx
break
end
e = idx
end
if lt sub e s ulong 2
ret false
end
if ne get req s uchar 123
ret false
end
if ne get req sub e ulong 1 uchar 125
ret false
end
ret true
end

fn dbg_rpc_handle_diag req view uchar * dst edit uchar * to ulong
ibuf = new uchar 64 0
sbuf = new uchar 512 0
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
tr = new TriageRes 0 0 0
il = dbg_json_extract_id req ibuf
sl = dbg_json_extract_str req d_kf_snapshot sbuf
if ge sl long 0
rc = dbg_parse_snapshot part sbuf 0 ulong sl snap
if ne rc DBG_OK
ret dbg_render_err_json part ibuf 0 il d_j_err_prm dst
end
else
dbg_snap_init snap
end
dbg_classify snap tr
ret dbg_render_diag_json part ibuf 0 il snap tr dst
end

fn dbg_rpc_handle_triage req view uchar * wd edit Watchdog dst edit uchar * to ulong
ibuf = new uchar 64 0
sbuf = new uchar 512 0
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
st = new StepOut 0 0 0 0 0 0
il = dbg_json_extract_id req ibuf
sl = dbg_json_extract_str req d_kf_snapshot sbuf
if lt sl long 0
ret dbg_render_err_json part ibuf 0 il d_j_err_prm dst
end
rc = dbg_parse_snapshot part sbuf 0 ulong sl snap
if ne rc DBG_OK
ret dbg_render_err_json part ibuf 0 il d_j_err_prm dst
end
dbg_wd_step wd snap st
ret dbg_render_triage_json part ibuf 0 il st wd dst
end

fn dbg_rpc_dispatch req view uchar * wd edit Watchdog dst edit uchar * to ulong
vbuf = new uchar 16 0
mbuf = new uchar 64 0
ibuf = new uchar 64 0
if not dbg_rpc_is_object req
ret dbg_put_s dst ulong 0 d_j_err_parse
end
il = dbg_json_extract_id req ibuf
vl = dbg_json_extract_str req d_kf_jsonrpc vbuf
if lt vl long 0
ret dbg_render_err_json part ibuf 0 il d_j_err_req dst
end
if not dbg_eq part vbuf 0 ulong vl d_rpc_20
ret dbg_render_err_json part ibuf 0 il d_j_err_req dst
end
ml = dbg_json_extract_str req d_kf_method mbuf
if lt ml long 0
ret dbg_render_err_json part ibuf 0 il d_j_err_req dst
end
um = ulong ml
if dbg_eq part mbuf 0 um d_m_notif
ret ulong 0
end
if dbg_eq part mbuf 0 um d_m_init
p = dbg_put_s dst ulong 0 d_j_pre
p = dbg_put_s dst p part ibuf 0 il
p = dbg_put_s dst p d_j_res
ret dbg_put_s dst p d_j_init
end
if dbg_eq part mbuf 0 um d_m_tlist
p = dbg_put_s dst ulong 0 d_j_pre
p = dbg_put_s dst p part ibuf 0 il
p = dbg_put_s dst p d_j_res
ret dbg_put_s dst p d_j_tlist
end
if dbg_eq part mbuf 0 um d_m_status
ret dbg_render_status_json part ibuf 0 il wd dst
end
if dbg_eq part mbuf 0 um d_m_diag
ret dbg_rpc_handle_diag req dst
end
if dbg_eq part mbuf 0 um d_m_triage
ret dbg_rpc_handle_triage req wd dst
end
ret dbg_render_err_json part ibuf 0 il d_j_err_mth dst
end

note aienux/debugger/test.om: comprehensive positive and negative test suite for spark-debugger
note Compose with: si/directives/om2.om aienux/debugger/lib.om aienux/debugger/test.om

text dt_snap_ok "load=1.75 mem=48 disk_free=62 gpu_temp=54 gpu_mem=35 services_total=5 services_up=5 env_leaks=0 build_ok=1"
text dt_snap_warn "load=8.50 mem=78 disk_free=18 gpu_temp=77 gpu_mem=82 service_state=5/5"
text dt_snap_deg_svc "load=2.10 mem=50 disk_free=40 gpu_temp=60 gpu_mem=40 service_state=4/5 build_ok=1"
text dt_snap_deg_bld "load=1.00 mem=40 disk_free=50 gpu_temp=50 gpu_mem=20 build_ok=false"
text dt_snap_crit_env "load=1.00 mem=30 disk_free=70 gpu_temp=45 gpu_mem=10 env_leaks=1"
text dt_snap_crit_gpu "load=3.00 mem=60 disk_free=40 gpu_temp=92 gpu_mem=50"
text dt_snap_crit_dsk "load=1.00 mem=40 disk_free=3 gpu_temp=50 gpu_mem=20"
text dt_snap_crit_svc "load=1.00 mem=40 disk_free=50 gpu_temp=50 gpu_mem=20 service_state=down"

text dt_bad_empty "   \n  "
text dt_bad_mem "mem=105 disk_free=50"
text dt_bad_disk "disk_free=120"
text dt_bad_gmem "gpu_mem=200"
text dt_bad_gtemp "gpu_temp=250"
text dt_bad_svc "services_total=5 services_up=6"
text dt_bad_ratio "service_state=7/5"
text dt_bad_load "load=1.2.3"
text dt_bad_key "bogus_metric=42"
text dt_bad_noeq "mem42"

text dt_rpc_init "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}"
text dt_rpc_notif "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
text dt_rpc_tlist "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}"
text dt_rpc_diag_ok "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"diagnose\",\"params\":{\"snapshot\":\"load=1.25 mem=45 disk_free=70 gpu_temp=50 gpu_mem=25 services_total=5 services_up=5\"}}"
text dt_rpc_diag_bad "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"diagnose\",\"params\":{\"snapshot\":\"mem=999\"}}"
text dt_rpc_triage1 "{\"jsonrpc\":\"2.0\",\"id\":20,\"method\":\"triage\",\"params\":{\"snapshot\":\"load=2.0 mem=50 disk_free=40 gpu_temp=85 gpu_mem=40\"}}"
text dt_rpc_triage2 "{\"jsonrpc\":\"2.0\",\"id\":21,\"method\":\"triage\",\"params\":{\"snapshot\":\"load=2.0 mem=50 disk_free=40 gpu_temp=85 gpu_mem=40\"}}"
text dt_rpc_status "{\"jsonrpc\":\"2.0\",\"id\":\"st-1\",\"method\":\"status\"}"
text dt_rpc_unknown "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"nonexistent_method\"}"
text dt_rpc_bad_json "not json at all"
text dt_rpc_bad_ver "{\"jsonrpc\":\"1.0\",\"id\":3,\"method\":\"status\"}"
text dt_rpc_triage_nop "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"triage\"}"

text dt_exp_init "\"protocolVersion\":\"2024-11-05\""
text dt_exp_tlist "\"name\":\"debug_scan\""
text dt_exp_diag_ok "{\"jsonrpc\":\"2.0\",\"id\":10,\"result\":{\"severity\":\"OK\",\"severity_code\":0,\"healthy\":true,\"reasons\":0,\"load_x100\":125,\"mem_pct\":45,\"disk_free\":70,\"gpu_temp\":50,\"gpu_mem\":25,\"services_up\":5,\"services_total\":5,\"env_leaks\":0,\"build_ok\":true}}\n"
text dt_exp_err_32601 "{\"jsonrpc\":\"2.0\",\"id\":99,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}\n"
text dt_exp_err_32700 "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"Parse error\"}}\n"
text dt_exp_err_32600 "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"}}\n"
text dt_exp_err_32602 "{\"jsonrpc\":\"2.0\",\"id\":11,\"error\":{\"code\":-32602,\"message\":\"Invalid params\"}}\n"
text dt_exp_err_32602_4 "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32602,\"message\":\"Invalid params\"}}\n"
text dt_exp_st_deg "{\"jsonrpc\":\"2.0\",\"id\":\"st-1\",\"result\":{\"committed_severity\":\"DEGRADED\",\"committed_code\":2,\"last_raw_severity\":\"DEGRADED\",\"consec_fail\":2,\"raise_streak\":0,\"clear_streak\":0,\"incidents\":1,\"samples\":2}}\n"
text dt_exp_tr1 "\"raw_severity\":\"DEGRADED\",\"committed_severity\":\"OK\",\"escalated\":false"
text dt_exp_tr2 "\"raw_severity\":\"DEGRADED\",\"committed_severity\":\"DEGRADED\",\"escalated\":true"

text dt_clean_ascii "clean Sovereign Watchdog log - ASCII hyphen only"

text dt_pass "PASS "
text dt_fail "FAIL "
text dt_nl "\n"
text dt_c1 "metric_snapshot_parser_positive_and_decimal_load"
text dt_c2 "metric_snapshot_parser_refusal_controls"
text dt_c3 "severity_classifier_ok_warn_degraded_critical"
text dt_c4 "watchdog_hysteresis_debounce_and_recovery"
text dt_c5 "watchdog_critical_fast_and_periodic_realert"
text dt_c6 "unslop_utf8_em_en_dash_detector"
text dt_c7 "jsonrpc_dispatch_diagnose_status_triage_mcp"
text dt_c8 "jsonrpc_refusal_32601_32700_32600_32602"
text dt_summary "PASS spark-debugger all 8 test suites passed\n"

fn dt_report name view uchar * ok bool to int
if ok
w1 = dbg_write_all int 1 dt_pass
w2 = dbg_write_all int 1 name
w3 = dbg_write_all int 1 dt_nl
if and w1 and w2 w3
ret 0
end
ret 1
end
w4 = dbg_write_all int 1 dt_fail
w5 = dbg_write_all int 1 name
w6 = dbg_write_all int 1 dt_nl
if and w4 and w5 w6
ret 1
end
ret 1
end

fn test_snap_positive to bool
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
rc = dbg_parse_snapshot dt_snap_ok snap
if ne rc DBG_OK
ret false
end
if ne get snap load_x100 ulong 175
ret false
end
if ne get snap mem_pct ulong 48
ret false
end
if ne get snap disk_free ulong 62
ret false
end
if ne get snap gpu_temp ulong 54
ret false
end
if ne get snap gpu_mem ulong 35
ret false
end
if ne get snap svc_total ulong 5
ret false
end
if ne get snap svc_up ulong 5
ret false
end
if ne get snap env_leaks ulong 0
ret false
end
if ne get snap build_ok ulong 1
ret false
end
ret true
end

fn test_snap_refusals to bool
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
if ne dbg_parse_snapshot dt_bad_empty snap DBG_ERR_EMPTY
ret false
end
if ne dbg_parse_snapshot dt_bad_mem snap DBG_ERR_RANGE
ret false
end
if ne dbg_parse_snapshot dt_bad_disk snap DBG_ERR_RANGE
ret false
end
if ne dbg_parse_snapshot dt_bad_gmem snap DBG_ERR_RANGE
ret false
end
if ne dbg_parse_snapshot dt_bad_gtemp snap DBG_ERR_RANGE
ret false
end
if ne dbg_parse_snapshot dt_bad_svc snap DBG_ERR_SVC_STATE
ret false
end
if ne dbg_parse_snapshot dt_bad_ratio snap DBG_ERR_SVC_STATE
ret false
end
if ne dbg_parse_snapshot dt_bad_load snap DBG_ERR_SYNTAX
ret false
end
if ne dbg_parse_snapshot dt_bad_key snap DBG_ERR_UNKNOWN_KEY
ret false
end
if ne dbg_parse_snapshot dt_bad_noeq snap DBG_ERR_SYNTAX
ret false
end
ret true
end

fn test_classifier to bool
snap = new MetricSnap 0 0 100 40 0 5 5 0 1 0
tr = new TriageRes 0 0 0
rc = dbg_parse_snapshot dt_snap_ok snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if or ne get tr sev SEV_OK or ne get tr healthy ulong 1 ne get tr reasons ulong 0
ret false
end
rc = dbg_parse_snapshot dt_snap_warn snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if or ne get tr sev SEV_WARN ne get tr healthy ulong 0
ret false
end
if eq and get tr reasons RSN_GPU_TEMP ulong 0
ret false
end
rc = dbg_parse_snapshot dt_snap_deg_svc snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if or ne get tr sev SEV_DEGRADED eq and get tr reasons RSN_SERVICES ulong 0
ret false
end
rc = dbg_parse_snapshot dt_snap_deg_bld snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if or ne get tr sev SEV_DEGRADED eq and get tr reasons RSN_BUILD ulong 0
ret false
end
rc = dbg_parse_snapshot dt_snap_crit_env snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if or ne get tr sev SEV_CRITICAL eq and get tr reasons RSN_ENV_LEAK ulong 0
ret false
end
rc = dbg_parse_snapshot dt_snap_crit_gpu snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if ne get tr sev SEV_CRITICAL
ret false
end
rc = dbg_parse_snapshot dt_snap_crit_dsk snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if ne get tr sev SEV_CRITICAL
ret false
end
rc = dbg_parse_snapshot dt_snap_crit_svc snap
if ne rc DBG_OK
ret false
end
dbg_classify snap tr
if ne get tr sev SEV_CRITICAL
ret false
end
ret true
end

fn test_hysteresis to bool
wd = new Watchdog 0 0 0 2 2 1 0 0 0 0 0
s_ok = new MetricSnap 0 0 100 40 0 5 5 0 1 0
s_warn = new MetricSnap 0 0 100 40 0 5 5 0 1 0
s_deg = new MetricSnap 0 0 100 40 0 5 5 0 1 0
st = new StepOut 0 0 0 0 0 0
dbg_wd_init wd ulong 2 ulong 2 ulong 1
rc = dbg_parse_snapshot dt_snap_ok s_ok
if ne rc DBG_OK
ret false
end
rc = dbg_parse_snapshot dt_snap_warn s_warn
if ne rc DBG_OK
ret false
end
rc = dbg_parse_snapshot dt_snap_deg_svc s_deg
if ne rc DBG_OK
ret false
end
note Transient single WARN spike must NOT promote committed_sev
dbg_wd_step wd s_warn st
if ne get st committed_sev SEV_OK
ret false
end
if ne get st escalated ulong 0
ret false
end
dbg_wd_step wd s_ok st
if ne get st committed_sev SEV_OK
ret false
end
if ne get wd raise_streak ulong 0
ret false
end
note Two consecutive DEGRADED samples MUST promote committed_sev and emit incident
dbg_wd_step wd s_deg st
if ne get st committed_sev SEV_OK
ret false
end
if ne get st emit_incident ulong 0
ret false
end
dbg_wd_step wd s_deg st
if ne get st committed_sev SEV_DEGRADED
ret false
end
if ne get st escalated ulong 1
ret false
end
if ne get st emit_incident ulong 1
ret false
end
note Single OK sample must NOT clear DEGRADED (clear_need=2)
dbg_wd_step wd s_ok st
if ne get st committed_sev SEV_DEGRADED
ret false
end
if ne get st recovered ulong 0
ret false
end
note Second consecutive OK sample recovers to OK
dbg_wd_step wd s_ok st
if ne get st committed_sev SEV_OK
ret false
end
if ne get st recovered ulong 1
ret false
end
ret true
end

fn test_crit_and_realert to bool
wd = new Watchdog 0 0 0 3 2 1 0 0 0 0 0
s_crit = new MetricSnap 0 0 100 40 0 5 5 0 1 0
st = new StepOut 0 0 0 0 0 0
dbg_wd_init wd ulong 3 ulong 2 ulong 1
rc = dbg_parse_snapshot dt_snap_crit_env s_crit
if ne rc DBG_OK
ret false
end
note CRITICAL with crit_fast=1 escalates immediately on sample 1 (consec_fail=1, incidents=1)
dbg_wd_step wd s_crit st
if or ne get st committed_sev SEV_CRITICAL or ne get st escalated ulong 1 ne get st emit_incident ulong 1
ret false
end
note Samples 2, 3, 4 do not emit incident; sample 5 (consec_fail % 5 == 0) re-alerts
dbg_wd_step wd s_crit st
if ne get st emit_incident ulong 0
ret false
end
dbg_wd_step wd s_crit st
if ne get st emit_incident ulong 0
ret false
end
dbg_wd_step wd s_crit st
if ne get st emit_incident ulong 0
ret false
end
dbg_wd_step wd s_crit st
if or ne get st emit_incident ulong 1 ne get wd incidents ulong 2
ret false
end
ret true
end

fn test_unslop to bool
if ne dbg_count_unslop dt_clean_ascii ulong 0
ret false
end
buf = new uchar 16 0
put buf 0 uchar 65
put buf 1 uchar 0xe2
put buf 2 uchar 0x80
put buf 3 uchar 0x94
put buf 4 uchar 66
put buf 5 uchar 0xe2
put buf 6 uchar 0x80
put buf 7 uchar 0x93
put buf 8 uchar 67
if ne dbg_count_unslop part buf 0 ulong 9 ulong 2
ret false
end
ret true
end

fn test_jsonrpc_positive to bool
wd = new Watchdog 0 0 0 2 2 1 0 0 0 0 0
outbuf = new uchar 2048 0
dbg_wd_init wd ulong 2 ulong 2 ulong 1
l1 = dbg_rpc_dispatch dt_rpc_init wd outbuf
if not dbg_contains part outbuf 0 l1 dt_exp_init
ret false
end
l2 = dbg_rpc_dispatch dt_rpc_notif wd outbuf
if ne l2 ulong 0
ret false
end
l3 = dbg_rpc_dispatch dt_rpc_tlist wd outbuf
if not dbg_contains part outbuf 0 l3 dt_exp_tlist
ret false
end
l4 = dbg_rpc_dispatch dt_rpc_diag_ok wd outbuf
if not dbg_eq part outbuf 0 l4 dt_exp_diag_ok
ret false
end
l5 = dbg_rpc_dispatch dt_rpc_triage1 wd outbuf
if not dbg_contains part outbuf 0 l5 dt_exp_tr1
ret false
end
l6 = dbg_rpc_dispatch dt_rpc_triage2 wd outbuf
if not dbg_contains part outbuf 0 l6 dt_exp_tr2
ret false
end
l7 = dbg_rpc_dispatch dt_rpc_status wd outbuf
if not dbg_eq part outbuf 0 l7 dt_exp_st_deg
ret false
end
ret true
end

fn test_jsonrpc_refusals to bool
wd = new Watchdog 0 0 0 2 2 1 0 0 0 0 0
outbuf = new uchar 2048 0
dbg_wd_init wd ulong 2 ulong 2 ulong 1
note Unknown method -> -32601 Method not found
l1 = dbg_rpc_dispatch dt_rpc_unknown wd outbuf
if not dbg_eq part outbuf 0 l1 dt_exp_err_32601
ret false
end
note Malformed JSON -> -32700 Parse error
l2 = dbg_rpc_dispatch dt_rpc_bad_json wd outbuf
if not dbg_eq part outbuf 0 l2 dt_exp_err_32700
ret false
end
note Wrong jsonrpc version -> -32600 Invalid Request
l3 = dbg_rpc_dispatch dt_rpc_bad_ver wd outbuf
if not dbg_eq part outbuf 0 l3 dt_exp_err_32600
ret false
end
note Diagnose with out-of-range metric -> -32602 Invalid params
l4 = dbg_rpc_dispatch dt_rpc_diag_bad wd outbuf
if not dbg_eq part outbuf 0 l4 dt_exp_err_32602
ret false
end
note Triage missing snapshot param -> -32602 Invalid params
l5 = dbg_rpc_dispatch dt_rpc_triage_nop wd outbuf
if not dbg_eq part outbuf 0 l5 dt_exp_err_32602_4
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail dt_report dt_c1 test_snap_positive
fail = add fail dt_report dt_c2 test_snap_refusals
fail = add fail dt_report dt_c3 test_classifier
fail = add fail dt_report dt_c4 test_hysteresis
fail = add fail dt_report dt_c5 test_crit_and_realert
fail = add fail dt_report dt_c6 test_unslop
fail = add fail dt_report dt_c7 test_jsonrpc_positive
fail = add fail dt_report dt_c8 test_jsonrpc_refusals
if ne fail int 0
ret 1
end
if not dbg_write_all int 1 dt_summary
ret 1
end
ret 0
end

note aienux/pi-register/test.om: comprehensive positive and negative test suite for pi-register
note Compose with: si/directives/om2.om aienux/pi-register/lib.om aienux/pi-register/test.om

text pt_sample "# Sample service register\n[[service]]\nname = \"demo\"\npurpose = \"Does a thing.\"\nunit = \"demo\"\ncategory = \"network\"\nowner = \"drake\"\nport = 8080\nprotocol = \"http\"\nstatus = \"active\"\ndepends_on = [\"other\"]\nfiles = [\"/etc/demo.conf\"]\nboot = true\n\n[[service]]\nname = \"dns-udp\"\npurpose = \"Local DNS resolver\"\nunit = \"dns.socket\"\ncategory = \"network\"\nowner = \"infra\"\nport = 8080\nprotocol = \"udp\"\nstatus = \"degraded\"\nboot = true\n\n[[service]]\nname = \"min\"\npurpose = \"Minimal \\\"quoted\\\" service\"\nunit = \"min.service\"\ncategory = \"bot\"\nowner = \"drake\"\nstatus = \"inactive\"\nboot = false\n"

text pt_missing_req "[[service]]\nname = \"only-name\"\n"
text pt_bad_port_zero "[[service]]\nname = \"z\"\npurpose = \"Zero port\"\nowner = \"ops\"\nport = 0\n"
text pt_bad_port_hi "[[service]]\nname = \"hi\"\npurpose = \"High port\"\nowner = \"ops\"\nport = 65536\n"
text pt_bad_port_txt "[[service]]\nname = \"txt\"\npurpose = \"Non numeric port\"\nowner = \"ops\"\nport = abc\n"
text pt_bad_proto "[[service]]\nname = \"p\"\npurpose = \"Bad proto\"\nowner = \"ops\"\nport = 80\nprotocol = \"icmp\"\n"
text pt_bad_status "[[service]]\nname = \"s\"\npurpose = \"Bad status\"\nowner = \"ops\"\nstatus = \"exploding\"\n"
text pt_dup_name "[[service]]\nname = \"dup\"\npurpose = \"First\"\nowner = \"a\"\nport = 8001\n\n[[service]]\nname = \"dup\"\npurpose = \"Second\"\nowner = \"b\"\nport = 8002\n"
text pt_dup_port_tcp "[[service]]\nname = \"s1\"\npurpose = \"HTTP on 8080\"\nowner = \"a\"\nport = 8080\nprotocol = \"http\"\n\n[[service]]\nname = \"s2\"\npurpose = \"Raw TCP on 8080\"\nowner = \"b\"\nport = 8080\nprotocol = \"tcp\"\n"
text pt_bad_syntax "name = \"orphan\"\n"
text pt_unclosed_q "[[service]]\nname = \"unclosed\npurpose = \"x\"\nowner = \"y\"\n"

text pt_demo "demo"
text pt_dns "dns-udp"
text pt_min "min"
text pt_nope "nope"
text pt_drake "drake"
text pt_infra "infra"
text pt_udp "udp"
text pt_degraded "degraded"
text pt_network "network"
text pt_p8080 "8080"

text pt_u_vault "vault"
text pt_u_vault_full "vault.service"
text pt_u_timer "x.timer"

text pt_ig_1 "systemd-journald.service"
text pt_ig_2 "getty@tty1.service"
text pt_ig_3 "ssh.service"
text pt_ig_4 "chrony.service"
text pt_ig_5 "piboot-try-reboot.service"
text pt_ig_6 "containerd.service"
text pt_ig_7 "postfix.service"
text pt_ig_8 "ubuntu-fan.service"
text pt_noig_1 "headscale.service"
text pt_noig_2 "fail2ban.service"
text pt_pat_mid "foo*bar"
text pt_mid_ok "foo123bar"
text pt_mid_bad "foobaz"

text pt_expect_jsonl_min "{\"name\":\"min\",\"port\":null,\"protocol\":\"tcp\",\"owner\":\"drake\",\"purpose\":\"Minimal \\\"quoted\\\" service\",\"status\":\"inactive\",\"unit\":\"min.service\",\"category\":\"bot\",\"boot\":false}\n"
text pt_expect_jsonl_demo "{\"name\":\"demo\",\"port\":8080,\"protocol\":\"http\",\"owner\":\"drake\",\"purpose\":\"Does a thing.\",\"status\":\"active\",\"unit\":\"demo.service\",\"category\":\"network\",\"boot\":true}\n"
text pt_expect_tbl_pfx "NAME             PORT   PROTO  OWNER            STATUS     UNIT                 BOOT  PURPOSE\ndemo             8080   http   drake            active     demo.service         yes   Does a thing.\n"

text pt_pass "PASS "
text pt_fail "FAIL "
text pt_nl "\n"
text pt_c1 "parse_full_minimal_and_transport_families"
text pt_c2 "unit_normalization_and_ignore_patterns"
text pt_c3 "filtered_lookup_by_name_port_owner_status_proto"
text pt_c4 "deterministic_table_and_jsonl_rendering"
text pt_c5 "refuse_missing_required_fields_and_syntax"
text pt_c6 "refuse_bad_ports_protocol_and_status"
text pt_c7 "refuse_duplicate_name_and_port_conflicts"
text pt_summary "PASS pi-register all 7 test suites passed\n"

fn pt_report name view uchar * ok bool to int
if ok
w1 = pi_write_all int 1 pt_pass
w2 = pi_write_all int 1 name
w3 = pi_write_all int 1 pt_nl
if and w1 and w2 w3
ret 0
end
ret 1
end
w4 = pi_write_all int 1 pt_fail
w5 = pi_write_all int 1 name
w6 = pi_write_all int 1 pt_nl
if and w4 and w5 w6
ret 1
end
ret 1
end

fn test_parse_positive to bool
info = new PiParseInfo 0 0 0
rc = pi_parse_register pt_sample info
if ne rc PI_OK
ret false
end
if ne get info svc_n ulong 3
ret false
end
if ne pi_svc_count ulong 3
ret false
end
if ne get g_pi_port 0 ulong 8080
ret false
end
if ne get g_pi_proto 0 PROTO_HTTP
ret false
end
if ne get g_pi_port 1 ulong 8080
ret false
end
if ne get g_pi_proto 1 PROTO_UDP
ret false
end
if ne get g_pi_port 2 ulong 0
ret false
end
if ne get g_pi_status 2 STAT_INACTIVE
ret false
end
if ne get g_pi_boot 0 ulong 1
ret false
end
if ne get g_pi_boot 2 ulong 0
ret false
end
ret true
end

fn test_units_and_ignore to bool
ub = new uchar 64 0
l1 = pi_full_unit pt_u_vault ub
if not pi_eq part ub 0 l1 pt_u_vault_full
ret false
end
l2 = pi_full_unit pt_u_timer ub
if not pi_eq part ub 0 l2 pt_u_timer
ret false
end
if not pi_pattern_matches pt_pat_mid pt_mid_ok
ret false
end
if pi_pattern_matches pt_pat_mid pt_mid_bad
ret false
end
if not pi_is_ignored pt_ig_1
ret false
end
if not pi_is_ignored pt_ig_2
ret false
end
if not pi_is_ignored pt_ig_3
ret false
end
if not pi_is_ignored pt_ig_4
ret false
end
if not pi_is_ignored pt_ig_5
ret false
end
if not pi_is_ignored pt_ig_6
ret false
end
if not pi_is_ignored pt_ig_7
ret false
end
if not pi_is_ignored pt_ig_8
ret false
end
if pi_is_ignored pt_noig_1
ret false
end
if pi_is_ignored pt_noig_2
ret false
end
ret true
end

fn test_filtered_lookup to bool
info = new PiParseInfo 0 0 0
rc = pi_parse_register pt_sample info
if ne rc PI_OK
ret false
end
if ne pi_find_by_name pt_demo long 0
ret false
end
if ne pi_find_by_name pt_dns long 1
ret false
end
if ne pi_find_by_name pt_min long 2
ret false
end
if ne pi_find_by_name pt_nope long -1
ret false
end
if ne pi_find_by_port ulong 8080 long 0
ret false
end
if ne pi_find_by_port ulong 9999 long -1
ret false
end
if ne pi_count_matching FILT_OWNER pt_drake ulong 2
ret false
end
if ne pi_count_matching FILT_OWNER pt_infra ulong 1
ret false
end
if ne pi_count_matching FILT_PROTO pt_udp ulong 1
ret false
end
if ne pi_count_matching FILT_STATUS pt_degraded ulong 1
ret false
end
if ne pi_count_matching FILT_CAT pt_network ulong 2
ret false
end
if ne pi_count_matching FILT_PORT pt_p8080 ulong 2
ret false
end
ret true
end

fn test_rendering to bool
info = new PiParseInfo 0 0 0
out1 = new uchar 4096 0
out2 = new uchar 4096 0
rc = pi_parse_register pt_sample info
if ne rc PI_OK
ret false
end
note Deterministic JSONL for single service (including escaped quotes and null port)
j1 = pi_render_jsonl_row ulong 0 out1 ulong 0
if not pi_eq part out1 0 j1 pt_expect_jsonl_demo
ret false
end
j2 = pi_render_jsonl_row ulong 2 out1 ulong 0
if not pi_eq part out1 0 j2 pt_expect_jsonl_min
ret false
end
note Deterministic plain-text table check (run twice, verify identical + prefix)
t1 = pi_render_table FILT_ALL part pt_demo 0 0 out1
t2 = pi_render_table FILT_ALL part pt_demo 0 0 out2
if not pi_eq part out1 0 t1 part out2 0 t2
ret false
end
if not pi_starts_with part out1 0 t1 pt_expect_tbl_pfx
ret false
end
ret true
end

fn test_refuse_missing_syntax to bool
info = new PiParseInfo 0 0 0
if ne pi_parse_register pt_missing_req info PI_ERR_MISSING_FIELD
ret false
end
if ne pi_parse_register pt_bad_syntax info PI_ERR_SYNTAX
ret false
end
if ne pi_parse_register pt_unclosed_q info PI_ERR_SYNTAX
ret false
end
ret true
end

fn test_refuse_port_proto_status to bool
info = new PiParseInfo 0 0 0
if ne pi_parse_register pt_bad_port_zero info PI_ERR_BAD_PORT
ret false
end
if ne pi_parse_register pt_bad_port_hi info PI_ERR_BAD_PORT
ret false
end
if ne pi_parse_register pt_bad_port_txt info PI_ERR_BAD_PORT
ret false
end
if ne pi_parse_register pt_bad_proto info PI_ERR_BAD_PROTO
ret false
end
if ne pi_parse_register pt_bad_status info PI_ERR_BAD_STATUS
ret false
end
ret true
end

fn test_refuse_duplicates to bool
info = new PiParseInfo 0 0 0
if ne pi_parse_register pt_dup_name info PI_ERR_DUP_NAME
ret false
end
if ne pi_parse_register pt_dup_port_tcp info PI_ERR_DUP_PORT
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail pt_report pt_c1 test_parse_positive
fail = add fail pt_report pt_c2 test_units_and_ignore
fail = add fail pt_report pt_c3 test_filtered_lookup
fail = add fail pt_report pt_c4 test_rendering
fail = add fail pt_report pt_c5 test_refuse_missing_syntax
fail = add fail pt_report pt_c6 test_refuse_port_proto_status
fail = add fail pt_report pt_c7 test_refuse_duplicates
if ne fail int 0
ret 1
end
if not pi_write_all int 1 pt_summary
ret 1
end
ret 0
end

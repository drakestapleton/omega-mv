note aienux/pi-register/main.om: CLI entrypoint for pi-register
note Compose with: si/directives/om2.om aienux/pi-register/lib.om aienux/pi-register/main.om

text pm_flag_reg "--register"
text pm_cmd_status "status"
text pm_cmd_jsonl "jsonl"
text pm_cmd_show "show"
text pm_cmd_filter "filter"
text pm_cmd_check "check"

text pm_f_owner "owner"
text pm_f_proto "protocol"
text pm_f_status "status"
text pm_f_cat "category"
text pm_f_port "port"
text pm_f_boot "boot"

text pm_err_open "pi-register: could not open register file\n"
text pm_err_parse "pi-register: registry validation failed (code="
text pm_err_line ", line="
text pm_err_close ")\n"
text pm_err_notfound "pi-register: service not found in register\n"
text pm_err_filter "pi-register: unknown filter field\n"
text pm_ok_check "All good: registry parsed and validated ("
text pm_ok_svcs " services).\n"
text pm_usage "Usage: pi-register [--register <path>] <status|jsonl|show <name>|filter <field> <value>|check>\n"

fn pi_read_fd fd int dst edit uchar * to ulong
cap = len dst
pos = ulong 0
note bound 65536 caps register input size
while lt pos cap bound 65536
remn = sub cap pos
k = read fd dst pos remn
if le k long 0
break
end
pos = add pos ulong k
end
ret pos
end

fn pi_parse_fkind s view uchar * to ulong
if pi_eq s pm_f_owner
ret FILT_OWNER
end
if pi_eq s pm_f_proto
ret FILT_PROTO
end
if pi_eq s pm_f_status
ret FILT_STATUS
end
if pi_eq s pm_f_cat
ret FILT_CAT
end
if pi_eq s pm_f_port
ret FILT_PORT
end
if pi_eq s pm_f_boot
ret FILT_BOOT
end
ret ulong 99
end

fn pi_emit_parse_err info view PiParseInfo to void
ebuf = new uchar 128 0
p = ulong 0
p = pi_put_s ebuf p pm_err_parse
p = pi_put_u64 ebuf p get info code
p = pi_put_s ebuf p pm_err_line
p = pi_put_u64 ebuf p get info line
p = pi_put_s ebuf p pm_err_close
w = pi_write_all int 2 part ebuf 0 p
if w
ret
end
end

fn pi_run_cmd cidx ulong ac ulong to int
outbuf = new uchar 16384 0
arg0 = new uchar 256 0
arg1 = new uchar 256 0
arg2 = new uchar 256 0
nc = argread cidx arg0 ulong 0 ulong 256
if le nc long 0
ret 2
end
l0 = ulong nc
if pi_eq part arg0 0 l0 pm_cmd_status
n = pi_render_table FILT_ALL part arg1 0 0 outbuf
if pi_write_all int 1 part outbuf 0 n
ret 0
end
ret 1
end
if pi_eq part arg0 0 l0 pm_cmd_jsonl
n = pi_render_jsonl FILT_ALL part arg1 0 0 outbuf
if pi_write_all int 1 part outbuf 0 n
ret 0
end
ret 1
end
if pi_eq part arg0 0 l0 pm_cmd_check
p = pi_put_s outbuf ulong 0 pm_ok_check
p = pi_put_u64 outbuf p pi_svc_count
p = pi_put_s outbuf p pm_ok_svcs
if pi_write_all int 1 part outbuf 0 p
ret 0
end
ret 1
end
if pi_eq part arg0 0 l0 pm_cmd_show
if le ac add cidx ulong 1
w0 = pi_write_all int 2 pm_usage
if w0
ret 2
end
ret 2
end
r1 = argread add cidx ulong 1 arg1 ulong 0 ulong 256
if le r1 long 0
ret 2
end
idx = pi_find_by_name part arg1 0 ulong r1
if lt idx long 0
w = pi_write_all int 2 pm_err_notfound
if w
ret 1
end
ret 1
end
n = pi_render_show ulong idx outbuf
if pi_write_all int 1 part outbuf 0 n
ret 0
end
ret 1
end
if pi_eq part arg0 0 l0 pm_cmd_filter
if le ac add cidx ulong 2
w1 = pi_write_all int 2 pm_usage
if w1
ret 2
end
ret 2
end
r1 = argread add cidx ulong 1 arg1 ulong 0 ulong 256
r2 = argread add cidx ulong 2 arg2 ulong 0 ulong 256
if or le r1 long 0 le r2 long 0
ret 2
end
fk = pi_parse_fkind part arg1 0 ulong r1
if eq fk ulong 99
w2 = pi_write_all int 2 pm_err_filter
if w2
ret 2
end
ret 2
end
n = pi_render_jsonl fk part arg2 0 ulong r2 outbuf
if pi_write_all int 1 part outbuf 0 n
ret 0
end
ret 1
end
w3 = pi_write_all int 2 pm_usage
if w3
ret 2
end
ret 2
end

fn pi_load_source use_file bool path view uchar * inp edit uchar * to long
if not use_file
ret long pi_read_fd int 0 inp
end
fdl = fopen path ulong 0 len path int 0 int 0
if lt fdl long 0
w = pi_write_all int 2 pm_err_open
if w
ret long -1
end
ret long -1
end
nlen = pi_read_fd int fdl inp
cl = fclose int fdl
if lt cl long 0
ret long -1
end
ret long nlen
end

fn pi_load_and_parse cidx_out edit ulong 1 to int
inp = new uchar 32768 0
arg0 = new uchar 256 0
arg1 = new uchar 256 0
info = new PiParseInfo 0 0 0
ac = argcnt
n0 = argread ulong 1 arg0 ulong 0 ulong 256
if le n0 long 0
ret 2
end
nlen_s = long 0
if pi_eq part arg0 0 ulong n0 pm_flag_reg
if le ac long 3
w2 = pi_write_all int 2 pm_usage
if w2
ret 2
end
ret 2
end
np = argread ulong 2 arg1 ulong 0 ulong 256
if le np long 0
ret 2
end
nlen_s = pi_load_source true part arg1 0 ulong np inp
put cidx_out 0 ulong 3
else
nlen_s = pi_load_source false part arg1 0 0 inp
put cidx_out 0 ulong 1
end
if lt nlen_s long 0
ret 1
end
rc = pi_parse_register part inp 0 ulong nlen_s info
if ne rc PI_OK
pi_emit_parse_err info
ret 1
end
ret 0
end

fn main to int
cidx_box = new ulong 1 0
ac = argcnt
if le ac long 1
w = pi_write_all int 1 pm_usage
if w
ret 0
end
ret 1
end
lrc = pi_load_and_parse cidx_box
if ne lrc int 0
ret lrc
end
ret pi_run_cmd get cidx_box 0 ulong ac
end

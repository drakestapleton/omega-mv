note Incremental HOME pixels must equal a complete redraw, including an independently moving background.
note Reuses the HOME oracle's isolated NIGHT/MIND boundary and existing Nsky storage for comparison.
global Targ uchar 32
global Ttime long 1
fn tdstrip to long
ret add get Hm 24 div get Hm 26 2
end
fn tdpx xx long yy long to void
c = ulong add 131844 and add xx yy 31
if lt xx add tdstrip hms 70
if ge xx tdstrip
c = add c shl ulong and get Ttime 0 31 8
end
end
put Nfrm add mul ulong yy ulong get Lg 0 ulong xx uint c
end
fn tdrow x long y long w long to void
for i ulong ulong w
tdpx add x long i y
end
end
fn tdback x long y long w long h long to void
for j ulong ulong h
tdrow x add y long j w
end
hmtext x y w h
end
fn tdwhole to void
tdback get Hm 28 get Hm 29 get Hm 30 get Hm 31
end
fn tdsaverow at ulong to void
for i ulong ulong get Hm 30
put Nsky add at i get Nfrm add at i
end
end
fn tdsave to void
at = mul ulong get Hm 29 ulong get Lg 0
at = add at ulong get Hm 28
for j ulong ulong get Hm 31
tdsaverow at
at = add at ulong get Lg 0
end
end
fn tdequalrow at ulong to bool
for i ulong ulong get Hm 30
if ne get Nsky add at i get Nfrm add at i
ret false
end
end
ret true
end
fn tdequal to bool
at = mul ulong get Hm 29 ulong get Lg 0
at = add at ulong get Hm 28
for j ulong ulong get Hm 31
if not tdequalrow at
ret false
end
at = add at ulong get Lg 0
end
ret true
end
fn tdpartial to void
x = pkmax get Hm 28 get Hmdirty 0
y = pkmax get Hm 29 get Hmdirty 1
w = add get Hm 28 get Hm 30
w = pkmin w add get Hmdirty 0 get Hmdirty 2
w = sub w x
h = add get Hm 29 get Hm 31
h = pkmin h add get Hmdirty 1 get Hmdirty 3
h = sub h y
if gt get Hmdirty 2 0
if gt w 0
if gt h 0
tdback x y w h
end
end
end
note The changing strip represents a NIGHT dirty region intersecting the bar.
tdback tdstrip get Hm 29 hms 70 get Hm 31
end
fn tdbudget to bool
a = mul get Hmdirty 2 get Hmdirty 3
b = mul get Hm 30 get Hm 31
ret le a div b 4
end
fn main to long
put Lg 0 1280
put Lg 1 800
put Lg 2 170
n = argread 2 Targ 0 32
if le n 0
ret 64
end
if eq get Targ 0 52
put Lg 0 3840
put Lg 1 2160
put Lg 2 512
end
put Targ 0 0
n = argread 1 Targ 0 32
if le n 0
ret 64
end
put Lg 3 div get Lg 0 2
put Lg 4 div mul get Lg 1 40 100
pkinit
hminit
note A static footer exercises its invalidation when typing and opacity change.
put Hmfoot 0 65
put Hmfootn 0 1
put Ttime 0 15300
tdwhole
for frame ulong 400
if ge frame 15
if lt frame 174
hmkey add 65 rem frame 26
end
end
if ge frame 200
if lt frame 210
hmkey 8
end
end
if eq frame 220
hmkey 13
end
if eq frame 350
put Hmsay 0 72
put Hmsay 1 105
put Hmsayn 0 2
hmsaid
end
hmstep get Ttime 0
if eq get Targ 0 98
if or eq frame 12 eq frame 190
if not tdbudget
ret 11
end
end
end
tdpartial
tdsave
tdwhole
if not tdequal
ret 30
end
put Ttime 0 add get Ttime 0 100
end
ret 0
end

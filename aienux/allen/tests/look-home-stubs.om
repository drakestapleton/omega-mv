note HOME oracle boundary, reused from IMacLook/home/stubs.om: only MIND mode/voice state and NIGHT hole data.
global Nthol ulong 1
global Nthole long 8
global Mdv long 32
fn mdmode m long t long to void
put Mdv 9 m
end
fn mdword t long to void
end
fn mdkey t long to void
end
fn mdvoice lvl long to void
put Mdv 10 lvl
end

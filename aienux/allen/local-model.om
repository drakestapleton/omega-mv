note SPDX-License-Identifier: AGPL-3.0-only
note Opt-in local-model application for Aienux's Omega firmware environment.
note Links the existing Allen base/runtime and aien-train's unchanged model/checkpoint/tokenizer.
note Firmware Boot Services stay active. This is not a standalone-kernel or bare-metal M2 claim.
note No network, Linux syscalls, shell, external inference provider or checkpoint writes.
note Serial console protocol: LM1 ID TOKENS TEMPMILLI SEED HEX_PROMPT CR.
note ID/SEED u32; TOKENS 1..128; TEMPMILLI 0..2000; prompt 1..159 printable ASCII bytes.
note Output: LMREADY; LMSTART ID; LMDATA ID HEX_BYTES; LMDONE ID; LMERR ID CODE.
note A request uses Allen's start/answer conversation lifecycle. Its history stores a bounded
note printable preview; raw generated bytes are sent unchanged in the LMDATA frames.
text Lmck "\\ASTRA.CK"
text Lmbpe "\\BPE.BIN"
text Lmboot "AIENUX OMEGA LOCAL MODEL: firmware hosted, no Linux"
text Lmready "LMREADY"
text Lmstart "LMSTART "
text Lmdata "LMDATA "
text Lmdone "LMDONE "
text Lmerror "LMERR "
global Lmstate ulong 8
note state: input length, overflow, request ID, tokens, temperature, seed, preview length, reserved.
global Lmline uchar 512
global Lmkey uchar 8
global Lmprev uchar 160

fn lmput which ulong to void
if eq which 0
for i ulong len Lmboot
emitb get Lmboot i
end
end
if eq which 1
for i ulong len Lmready
emitb get Lmready i
end
end
if eq which 2
for i ulong len Lmstart
emitb get Lmstart i
end
end
if eq which 3
for i ulong len Lmdata
emitb get Lmdata i
end
end
if eq which 4
for i ulong len Lmdone
emitb get Lmdone i
end
end
if eq which 5
for i ulong len Lmerror
emitb get Lmerror i
end
end
end

fn lmsend to void
emitb 10
if ne get Err 0 0
exit 71
end
r = efi 13 0 Outb 0 get Outlen 0
if ne r get Outlen 0
exit 70
end
end

fn lmfail code ulong to void
outreset
lmput 5
emitn get Lmstate 2
emitb 32
emitn code
lmsend
end

fn lmhex c uchar to ulong
if and ge c 48 le c 57
ret sub ulong c 48
end
if and ge c 97 le c 102
ret add sub ulong c 97 10
end
ret 256
end

note Platform output hook: flush every complete decoded token, with no terminal escape injection.
fn oflush to void
n = get oon 0
if eq n 0
ret
end
outreset
lmput 3
emitn get Lmstate 2
emitb 32
for i ulong n
c = get oout i
emitb get Digits ulong shr c 4
emitb get Digits ulong and c 15
p = get Lmstate 6
if lt p 159
shown = c
if or lt shown 32 gt shown 126
shown = 32
end
put Lmprev p shown
put Lmstate 6 add p 1
end
end
lmsend
put oon 0 0
end

fn lmrequest to void
put Lmstate 2 0
if ne get Lmstate 1 0
lmfail 1
ret
end
n = get Lmstate 0
for i ulong n
put In i get Lmline i
end
put Inlen 0 n
put P 0 0
put P 2 0
expect 76
expect 77
expect 49
expect 32
number
put Lmstate 2 get P 1
expect 32
number
put Lmstate 3 get P 1
expect 32
number
put Lmstate 4 get P 1
expect 32
number
put Lmstate 5 get P 1
expect 32
if ne get P 2 0
lmfail 2
ret
end
if eq get Lmstate 2 0
lmfail 3
ret
end
if eq get Lmstate 3 0
lmfail 3
ret
end
if gt get Lmstate 3 128
lmfail 3
ret
end
if gt get Lmstate 4 2000
lmfail 3
ret
end
pos = get P 0
size = sub n pos
if or or eq size 0 gt size 318 ne rem size 2 0
lmfail 4
ret
end
count = div size 2
for i ulong count
a = lmhex get Lmline add pos mul i 2
b = lmhex get Lmline add add pos mul i 2 1
if or eq a 256 eq b 256
lmfail 5
ret
end
c = uchar add mul a 16 b
if or lt c 32 gt c 126
lmfail 6
ret
end
put ojob add 1024 i c
put In i c
end
put Inlen 0 count
if not start 1 oms
lmfail 7
ret
end
put otl 6 count
put Lmstate 6 0
outreset
lmput 2
emitn get Lmstate 2
lmsend
osampleloaded get Lmstate 5 get Lmstate 3 get Lmstate 4
count = get Lmstate 6
if eq count 0
cancel
else
for i ulong count
put In i get Lmprev i
end
put Inlen 0 count
if not answer get R 0 oms
cancel
lmfail 8
ret
end
end
outreset
lmput 4
emitn get Lmstate 2
lmsend
end

fn main to int
outreset
lmput 0
lmsend
put otc 0 8
put otb 2 0
put otl 2 len Lmck
for i ulong len Lmck
put ojob i get Lmck i
end
put otb 7 32
put otl 7 len Lmbpe
for i ulong len Lmbpe
put ojob add 32 i get Lmbpe i
end
put otb 6 1024
pl = oargp 2
sz = efi 12 oefa 0 0 oarg 0 pl
if oeerr sz
outreset
lmput 5
emitn 0
emitb 32
emitn sz
lmsend
ret 70
end
oeclose
ockload 2
obload 7 get og 0
outreset
lmput 1
lmsend
for session ulong 1000000
for beat ulong 1000000
st = efi 1 0 Lmkey 0 4
if ne st 0
st = efi 2 1000 Lmkey 0 0
else
ch = or ulong get Lmkey 2 shl ulong get Lmkey 3 8
if eq ch 13
lmrequest
put Lmstate 0 0
put Lmstate 1 0
else
if and ge ch 32 le ch 126
n = get Lmstate 0
if lt n len Lmline
put Lmline n uchar ch
put Lmstate 0 add n 1
else
put Lmstate 1 1
end
end
end
end
end
end
ret 0
end

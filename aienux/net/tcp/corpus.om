note corpus.om: hosted hostile corpus for tcp.om (ledger L232). Compose:
note cat tcp.om corpus.om | omc. A scripted peer (10.0.2.2:5000, MAC 52:55:0a:00:02:02)
note drives the stack frame by frame and checks exact state after each case:
note RFC 5961 challenge ACKs for in-window RST and SYN, exact RST abort, ACKs
note outside the RFC 5961 range, malformed IPv4/TCP headers, overlap and
note reordering, data beyond the window and after FIN, malformed SYN options,
note active open refusal paths, fast retransmit and timeout. Then a seeded fuzz
note phase feeds mutated frames (raw corruption and checksum-valid field
note randomization) while checking invariants, and a final clean transfer
note proves the stack still works. Argument: fuzz frame count. Exit 0 only
note when every check passed; prints CORPUS_PASS or CORPUS_FAIL.
global Cout uchar 2048
note Cx: 0 peer base seq (stream offset 0), 1 our base seq, 2 peer port, 3 our port,
note 4 peer window, 5 MSS option (0 none), 6 now ms, 7 failures, 8 checks,
note 9 frames out, 10 fuzz frames, 11 prng, 12 last out length, 13 fuzz connections.
global Cx ulong 16
global Cnum uchar 32
global Carg uchar 32
global Csv ulong 32
text Mpass "CORPUS_PASS checks="
text Mfail "CORPUS_FAIL check="
text Mfails "CORPUS_FAIL failures="
text Mfuzz " fuzz="
text Mconn " conns="
text Mtst " tst"
text Msp " "
text Mnl "\n"
const cPIP ulong 167772674
const cMIP ulong 167772687
fn tlinkout n ulong to void
for i ulong n bound 2048
put Cout i get Ttx i
end
put Cx 9 add get Cx 9 1
put Cx 12 n
end
fn cnum v ulong to void
i = ulong 32
while true bound 21
i = sub i 1
put Cnum i uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
k = write 1 Cnum i sub 32 i
end
fn cck ok bool id ulong to void
put Cx 8 add get Cx 8 1
if not ok
put Cx 7 add get Cx 7 1
k = write 1 Mfail 0 len Mfail
cnum id
k = write 1 Mnl 0 len Mnl
end
end
fn crnd to ulong
x = get Cx 11
x = xor x shl x 13
x = xor x shr x 7
x = xor x shl x 17
put Cx 11 x
ret x
end
fn co16 p ulong to ulong
ret add shl ulong get Cout p 8 ulong get Cout add p 1
end
fn co32 p ulong to ulong
ret add shl co16 p 16 co16 add p 2
end
fn cofl to ulong
ret ulong get Cout 47
end
fn cw16 p ulong v ulong to void
put Trx p uchar and shr v 8 255
put Trx add p 1 uchar and v 255
end
fn cw32 p ulong v ulong to void
cw16 p and shr v 16 65535
cw16 add p 2 and v 65535
end
fn cpat k ulong to uchar
ret uchar and add mul k 7 3 255
end
fn cmacs to void
for i ulong 6
put Trx i get Tmac i
end
put Trx 6 82
put Trx 7 85
put Trx 8 10
put Trx 9 0
put Trx 10 2
put Trx 11 2
cw16 12 2048
end
fn cfix t ulong to void
cw16 24 0
cw16 24 tfold tsumr 14 20
l = sub t 20
cw16 50 0
cw16 50 tfold add tpsum tr32 26 tr32 30 l tsumr 34 l
end
note Build a peer segment: n payload bytes of stream offset off. Returns frame length.
fn cfr flags ulong seq ulong ack ulong n ulong off ulong to ulong
cmacs
o = ulong 0
if ne get Cx 5 0
o = ulong 4
end
t = add add 40 o n
put Trx 14 69
put Trx 15 0
cw16 16 t
cw32 18 0
put Trx 22 64
put Trx 23 6
cw32 26 cPIP
cw32 30 cMIP
cw16 34 get Cx 2
cw16 36 get Cx 3
cw32 38 seq
cw32 42 ack
put Trx 46 uchar shl add 5 shr o 2 4
put Trx 47 uchar and flags 255
cw16 48 get Cx 4
cw32 50 0
if eq o 4
put Trx 54 2
put Trx 55 4
cw16 56 get Cx 5
end
h = add 54 o
for i ulong n bound 1500
put Trx add h i cpat add off i
end
cfix t
ret add 14 t
end
fn cnow to ulong
ret get Cx 6
end
fn cfeed n ulong to ulong
c = get Cx 9
put Tcf 0 cnow
tinput n
tstep cnow
ret sub get Cx 9 c
end
fn cseq off ulong to ulong
ret sadd get Cx 0 off
end
fn cack to ulong
ret get Tcb kNXT
end
note Send a data segment at stream offset off with n bytes and the current ACK.
fn cdata off ulong n ulong to ulong
ret cfeed cfr 24 cseq off cack n off
end
fn csave to void
for i ulong 32
put Csv i get Tst i
end
end
fn cdst k ulong to ulong
ret sub get Tst k get Csv k
end
fn csetup to void
tinit
put Tcf 1 cMIP
put Tcf 2 cPIP
put Tcf 3 4294967040
put Tmac 0 82
put Tmac 1 84
put Tmac 2 0
put Tmac 3 18
put Tmac 4 52
put Tmac 5 86
tarpset cPIP add shl ulong 21077 32 167772674 true
put Cx 2 5000
put Cx 3 7
put Cx 4 65535
put Cx 5 0
end
note Passive open; leaves the connection established with stream offset 0 next.
fn cpass base ulong id ulong to void
csetup
tlisten 7
put Cx 5 1460
put Cx 0 sadd base 1
o = cfeed cfr 2 base 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 add id 1
cck eq o 1 add id 2
cck eq cofl 18 add id 3
cck eq co32 42 sadd base 1 add id 4
put Cx 1 sadd co32 38 1
o = cfeed cfr 16 cseq 0 get Cx 1 0 0
cck eq get Tcb kST 4 add id 5
cck eq get Tcb kMSS 1460 add id 6
end
fn cchkread off ulong n ulong id ulong to void
m = tread n
cck eq m n id
ok = true
for i ulong m bound 65536
if ne get Tapp i cpat add off i
ok = false
end
end
cck ok add id 1
end
note Established-state cases.
fn ccases1 to void
cpass 1000 100
csave
o = cdata 0 100
cck eq get Tcb kRCN 100 110
cck eq co32 42 cseq 100 111
o = cdata 200 100
cck eq get Tcb kRCN 100 112
cck eq co32 42 cseq 100 113
o = cdata 100 100
cck eq get Tcb kRCN 300 114
cck eq co32 42 cseq 300 115
o = cdata 0 300
cck eq get Tcb kRCN 300 116
cck eq cdst 10 1 117
o = cdata 250 100
cck eq get Tcb kRCN 350 118
csave
o = cfeed cfr 4 cseq 400 0 0 0
cck eq get Tcb kST 4 120
cck eq cdst 11 1 121
cck eq o 1 122
cck eq cofl 16 123
o = cfeed cfr 4 cseq 100000 0 0 0
cck eq get Tcb kST 4 124
o = cfeed cfr 20 sadd cseq 350 2147483648 cack 0 0
cck eq get Tcb kST 4 125
o = cfeed cfr 18 cseq 350 cack 0 0
cck eq get Tcb kST 4 126
cck eq cdst 12 1 127
o = cfeed cfr 2 cseq 350 0 0 0
cck eq get Tcb kST 4 128
csave
o = cfeed cfr 24 cseq 350 sadd cack 1000 10 350
cck eq get Tcb kRCN 350 130
cck eq cdst 13 1 131
o = cfeed cfr 24 cseq 350 sdif cack 70000 10 350
cck eq get Tcb kRCN 350 132
cck eq cdst 14 1 133
o = cfeed cfr 8 cseq 350 cack 10 350
cck eq get Tcb kRCN 350 134
o = cdata 70350 10
cck eq get Tcb kRCN 350 135
ccases2
end
note Malformed headers, each built valid then broken.
fn ccases2 to void
csave
n = cfr 24 cseq 350 cack 10 350
put Trx 60 uchar xor ulong get Trx 60 1
o = cfeed n
cck eq cdst 8 1 140
n = cfr 24 cseq 350 cack 10 350
put Trx 24 uchar xor ulong get Trx 24 128
o = cfeed n
cck eq cdst 4 1 141
n = cfr 24 cseq 350 cack 10 350
cw16 20 8192
cfix 50
o = cfeed n
cck eq cdst 5 1 142
n = cfr 24 cseq 350 cack 10 350
cw32 30 167772688
cfix 50
o = cfeed n
cck eq cdst 6 1 143
n = cfr 24 cseq 350 cack 10 350
put Trx 46 64
cfix 50
o = cfeed n
cck eq cdst 7 1 144
n = cfr 24 cseq 350 cack 10 350
put Trx 46 240
cfix 50
o = cfeed n
cck eq cdst 7 2 145
n = cfr 24 cseq 350 cack 10 350
cw16 16 51
cfix 51
o = cfeed n
cck eq cdst 3 1 146
n = cfr 24 cseq 350 cack 10 350
put Trx 14 101
cfix 50
o = cfeed n
cck eq cdst 3 2 147
n = cfr 24 cseq 350 cack 10 350
o = cfeed sub n 1
cck eq cdst 3 3 148
cck eq get Tcb kRCN 350 149
n = cfr 24 cseq 350 cack 10 350
cw32 26 2130706433
cfix 50
o = cfeed n
cck eq cdst 27 1 150
cck eq get Tcb kRCN 350 151
cck eq get Tcb kST 4 152
cchkread 0 350 153
ccases3
end
note Sending: segmentation, fast retransmit, timeout, then FIN handling.
fn ccases3 to void
for i ulong 3000
put Tapp i cpat add 9000 i
end
m = twrite 3000
cck eq m 3000 160
c = get Cx 9
tstep cnow
cck eq sub get Cx 9 c 3 161
cck eq co32 38 sadd get Cx 1 2920 162
cck eq get Cx 12 134 163
u = get Tcb kUNA
csave
o = cfeed cfr 16 cseq 350 u 0 0
o = cfeed cfr 16 cseq 350 u 0 0
o = cfeed cfr 16 cseq 350 u 0 0
cck eq cdst 17 1 164
cck eq co32 38 u 165
o = cfeed cfr 16 cseq 350 sadd u 3000 0 0
cck eq get Tcb kSCN 0 166
cck eq get Tcb kRTX 0 167
m = twrite 100
tstep cnow
csave
put Cx 6 add get Cx 6 add get Tcb kRTO 1
c = get Cx 9
tstep cnow
cck eq cdst 16 1 168
cck eq co32 38 sadd u 3000 169
cck eq get Cx 12 154 170
o = cfeed cfr 16 cseq 350 sadd u 3100 0 0
cck eq get Tcb kSCN 0 171
o = cfeed cfr 17 cseq 350 cack 0 0
cck eq get Tcb kST 7 172
cck eq co32 42 cseq 351 173
csave
o = cdata 351 10
cck eq get Tcb kRCN 0 174
cck eq cdst 29 1 175
tclose
tstep cnow
cck eq get Tcb kST 9 176
cck eq and cofl 1 1 177
o = cfeed cfr 16 cseq 351 sadd u 3101 0 0
cck eq get Tcb kST 0 178
cck eq get Tcb kERR 0 179
cck eq get Tcb kEST 1 180
end
note Exact RST aborts; malformed SYN options are refused; active open refusals.
fn ccases4 to void
cpass 50000 200
o = cfeed cfr 4 cseq 0 0 0 0
cck eq get Tcb kST 0 210
cck eq get Tcb kERR 1 211
csetup
tlisten 7
csave
put Cx 5 1460
n = cfr 2 77 0 0 0
put Cx 5 0
put Trx 55 0
cfix 44
o = cfeed n
cck eq o 0 212
cck eq get Tcb kST 1 213
cck eq cdst 15 1 214
n = cfr 2 77 0 0 0
cw16 16 44
put Trx 46 96
put Trx 54 2
put Trx 55 9
put Trx 56 0
put Trx 57 0
cfix 44
o = cfeed add n 4
cck eq get Tcb kST 1 215
csetup
put Cx 2 80
put Cx 3 41000
tconnect cPIP 80 41000
c = get Cx 9
tstep cnow
cck eq cofl 2 220
s = co32 38
o = cfeed cfr 18 9000 sadd s 5 0 0
cck eq get Tcb kST 2 221
cck eq cofl 4 222
cck eq co32 38 sadd s 5 223
o = cfeed cfr 20 9000 sadd s 5 0 0
cck eq get Tcb kST 2 224
o = cfeed cfr 18 9000 sadd s 1 0 0
cck eq get Tcb kST 4 225
cck eq cofl 16 226
cck eq co32 42 9001 227
o = cfeed cfr 18 9000 sadd s 1 0 0
cck eq get Tcb kST 4 228
note A RST whose ACK acknowledges our SYN aborts SYN-SENT as refused (RFC 9293 3.10.7.3).
csetup
put Cx 2 80
put Cx 3 41001
tconnect cPIP 80 41001
tstep cnow
s = co32 38
o = cfeed cfr 20 9000 sadd s 1 0 0
cck eq get Tcb kST 0 229
cck eq get Tcb kERR 2 230
note Simultaneous open: a SYN without ACK moves SYN-SENT to syn-received; an exact
note RST there reports refused, since the block did not come from LISTEN.
csetup
put Cx 2 80
put Cx 3 41002
tconnect cPIP 80 41002
tstep cnow
put Cx 5 1460
o = cfeed cfr 2 9000 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 231
o = cfeed cfr 4 9001 0 0 0
cck eq get Tcb kST 0 232
cck eq get Tcb kERR 2 233
end
note Active close: FIN-WAIT-1, FIN-WAIT-2, then TIME-WAIT acknowledges the peer
note FIN (and a retransmitted one) and closes after 2MSL. Then an exact RST in
note syn-received returns a passive block to LISTEN, which accepts a new SYN.
fn ccases5 to void
cpass 70000 400
tclose
tstep cnow
cck eq get Tcb kST 5 410
cck eq and cofl 1 1 411
f = co32 38
o = cfeed cfr 16 cseq 0 sadd f 1 0 0
cck eq get Tcb kST 6 412
o = cfeed cfr 17 cseq 0 sadd f 1 0 0
cck eq get Tcb kST 10 413
cck eq o 1 414
cck eq cofl 16 415
cck eq co32 42 cseq 1 416
put Cx 6 add get Cx 6 500
o = cfeed cfr 17 cseq 0 sadd f 1 0 0
cck eq o 1 417
cck eq co32 42 cseq 1 418
o = cfeed cfr 4 cseq 1 0 0 0
cck eq get Tcb kST 10 425
cck eq get Tcb kERR 0 426
put Cx 6 add get Cx 6 600
tstep cnow
cck eq get Tcb kST 10 430
o = cfeed cfr 5 cseq 100000 0 0 0
put Cx 6 add get Cx 6 500
tstep cnow
cck eq get Tcb kST 0 434
put Cx 6 add get Cx 6 add get Tcf 8 1
tstep cnow
cck eq get Tcb kST 0 419
cck eq get Tcb kERR 0 420
csetup
tlisten 7
put Cx 5 1460
o = cfeed cfr 2 5000 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 421
put Cx 5 1460
o = cfeed cfr 2 5000 0 0 0
put Cx 5 0
tstep cnow
cck eq get Tcb kST 3 427
cck eq cofl 16 428
cck eq co32 42 5001 429
o = cfeed cfr 4 5001 0 0 0
cck eq get Tcb kST 1 422
cck eq get Tcb kERR 0 423
put Cx 5 1460
o = cfeed cfr 2 6000 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 424
cck eq o 1 431
cck eq co32 42 6001 432
end
note A full 65535-byte window at a small peer MSS goes out in one tstep: 123 segments at
note the RFC 9293 default MSS 536, 1024 at the smallest accepted MSS 64.
fn cbulk mss ulong segs ulong id ulong to void
csetup
tlisten 7
put Cx 5 mss
put Cx 0 sadd 90000 1
o = cfeed cfr 2 90000 0 0 0
put Cx 5 0
put Cx 1 sadd co32 38 1
o = cfeed cfr 16 cseq 0 get Cx 1 0 0
cck eq get Tcb kST 4 id
cck eq get Tcb kMSS mss add id 1
put Tcb kCWN 65535
for i ulong 65535
put Tapp i cpat add 7000 i
end
m = twrite 65535
cck eq m 65535 add id 2
c = get Cx 9
tstep cnow
cck eq sub get Cx 9 c segs add id 3
cck eq sdif get Tcb kNXT get Tcb kUNA 65535 add id 4
end
note A SYN that is never answered: when the SYN-ACK retries run out, a passive
note block returns to LISTEN and answers the next SYN with SYN-ACK.
fn ccases6 to void
cbulk 536 123 500
cbulk 64 1024 510
csetup
tlisten 7
put Cx 5 1460
o = cfeed cfr 2 5000 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 520
for r ulong 700
put Cx 6 add get Cx 6 1000
tstep cnow
end
cck eq get Tcb kST 1 521
put Cx 2 6000
put Cx 5 1460
o = cfeed cfr 2 7000 0 0 0
put Cx 5 0
cck eq get Tcb kST 3 522
cck eq cofl 18 523
cck eq co32 42 7001 524
put Cx 2 5000
end
note Fuzz: mutate a valid segment; half keep correct checksums.
fn cfuzz1 to void
if ne get Tcb kST 4
put Cx 13 add get Cx 13 1
cpass and crnd 4294967295 1000
end
r = crnd
off = add sdif get Tcb kRNX get Cx 0 and shr r 8 4095
if eq and r 1 0
off = sub off and shr r 20 2047
end
n = and shr r 32 1023
if gt n 1400
n = ulong 1400
end
f = and shr r 44 255
a = cack
if eq and shr r 52 3 0
a = and crnd 4294967295
end
l = cfr f cseq off a n off
k = and shr r 56 15
for j ulong k bound 16
p = rem crnd l
put Trx p uchar and crnd 255
end
if eq and shr r 60 1 1
if eq ulong get Trx 14 69
t = tr16 16
if and ge t 40 le add t 14 l
cfix t
end
end
end
if eq and shr r 61 3 0
l = sub l rem crnd l
end
o = cfeed l
cfuzzinv
end
fn cfuzzinv to void
ok = le get Tcb kRCN 65535
ok = and ok le get Tcb kSCN 65535
ok = and ok le get Tcb kRTO 60000
ok = and ok le get Cx 12 1514
cck ok 900
if gt get Tcb kRCN 30000
m = tread 65536
end
if eq get Tcb kST 4
if lt get Tcb kSCN 10000
m = twrite 2000
end
end
put Cx 6 add get Cx 6 rem crnd 50
tstep cnow
end
fn cfuzz count ulong to void
put Cx 13 0
for i ulong count bound 100000000
cfuzz1
put Cx 10 add get Cx 10 1
end
end
note After the fuzz: a fresh connection whose sequence space wraps past 2^32
note carries 60 in-order segments intact.
fn cdrainchk to void
n = get Tcb kRCN
cck eq n 1000 309
cchkread get Cx 14 n 310
put Cx 14 add get Cx 14 n
end
fn cfinal to void
cpass 4294960000 300
put Cx 14 0
for i ulong 60
o = cdata mul i 1000 1000
cdrainchk
end
cck eq get Cx 14 60000 312
cck eq get Tcb kRNX cseq 60000 313
cck eq get Tcb kST 4 314
end
fn main to int
put Cx 11 88172645463325252
put Cx 6 1000
count = ulong 0
if gt argcnt 1
k = argread 1 Carg 0 20
if lt k 1
exit 2
end
for i ulong ulong k bound 20
count = add mul count 10 sub ulong get Carg i 48
end
end
ccases1
ccases4
ccases5
ccases6
cfuzz count
cfinal
if eq get Cx 7 0
k = write 1 Mpass 0 len Mpass
cnum get Cx 8
k = write 1 Mfuzz 0 len Mfuzz
cnum get Cx 10
k = write 1 Mconn 0 len Mconn
cnum get Cx 13
k = write 1 Mtst 0 len Mtst
for i ulong 32
k = write 1 Msp 0 len Msp
cnum get Tst i
end
k = write 1 Mnl 0 len Mnl
ret 0
end
k = write 1 Mfails 0 len Mfails
cnum get Cx 7
k = write 1 Mnl 0 len Mnl
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note aienux/net/rtl8127/om/rtl8127/tcp_glue.om: Bridges rtl8127.om <-> aienux/net/tcp/tcp.om.
note Compose: rtl8127.om + (model.om | bare_a64efi.om) + tcp.om + tcp_glue.om + main.
note Exposes:
note   tlinkout(n ulong)        called by tcp.om to transmit Ttx[0..n) via rtl8127
note   rtltcp_bind_mac()        copies rtl8127 MAC (rs[S_MAC0..+6]) into tcp.om Tmac[0..6)
note   rtltcp_poll(now_ms)      drains up to 16 RX frames from rtl8127 into tcp.om, runs tstep, reclaims TX

global rtg_st ulong 4

fn rtltcp_bind_mac to void
for i ulong 6
put Tmac i uchar and get rs add S_MAC0 i 255
end
end

fn tlinkout n ulong to void
if or lt n 14 gt n FMAX
tstat 30
ret
end
e = rtltxrec
if ne e 0
tstat 30
ret
end
i = ulong 0
while lt i n bound 1514
put fbuf i get Ttx i
i = add i 1
end
r = rtltx n
if ne r 0
tstat 30
put rtg_st 1 add get rtg_st 1 1
else
put rtg_st 0 add get rtg_st 0 1
end
end

fn rtltcp_poll now_ms ulong to ulong
rx_cnt = ulong 0
k = ulong 0
while lt k 16 bound 16
e = rtlrx
if ne e 0
put rtg_st 3 add get rtg_st 3 1
break
end
n = get rs S_RXLEN
if eq n 0
break
end
if le n 2048
i = ulong 0
while lt i n bound 2048
put Trx i get obuf i
i = add i 1
end
tinput n
rx_cnt = add rx_cnt 1
put rtg_st 2 add get rtg_st 2 1
end
k = add k 1
end
tstep now_ms
e2 = rtltxrec
ret rx_cnt
end

note SPDX-License-Identifier: Apache-2.0
note aienux/net/rtl8127/om/rtl8127/bare_a64efi.om: Bare-metal target a64efi backend for rtl8127.om.
note Provides exact 1-, 2-, and 4-byte BAR2 Device-nGnRnE MMIO accessors via fwld/fwst,
note CNTVCT_EL0 microsecond delay, DSB SY barrier, and DIRECT Normal-NC physical DMA accessors
note (rtldma_r8 / rtldma_w8) so rtl8127.om operates directly on rtl_hw[1] with ZERO WB split-brain.
note Spark 0007:01:00.0 (10ec:8127 rev 05): BAR2 = 0x6e900000 (256 KiB), SMMUv3 A StreamID 0x80100.
note
note Requires Piece 1 platform hooks:
note   a64_dsb_sy() -> void
note   a64_dc_civac_range(pa ulong, nbytes ulong) -> void

const RTL_SPARK_BAR2 ulong 1854930944
const RTL_BAR2_SIZE ulong 262144
const RTL_RDMA_SIZE ulong 69632
const RTL_PA40_LIMIT ulong 1099511627776

note rtl_hw: 0=bar2_pa, 1=rdma_pa (4 KiB-aligned Normal-NC physical DMA buffer, 69632 B)
global rtl_hw ulong 2

fn rtl_bare_setup bar2_pa ulong rdma_pa ulong to int
put rtl_hw 0 0
put rtl_hw 1 0
if or eq bar2_pa 0 ne and bar2_pa 4095 0
ret 1
end
if or eq rdma_pa 0 ne and rdma_pa 4095 0
ret 2
end
if lt add rdma_pa RTL_RDMA_SIZE rdma_pa
ret 3
end
if gt add rdma_pa RTL_RDMA_SIZE RTL_PA40_LIMIT
ret 4
end
put rtl_hw 0 bar2_pa
put rtl_hw 1 rdma_pa
ret 0
end

fn rtl_mmio_bounds_ok off ulong w ulong to bool
if eq get rtl_hw 0 0
ret false
end
if not or eq w 1 or eq w 2 eq w 4
ret false
end
if ne rem off w 0
ret false
end
if or lt add off w off gt add off w RTL_BAR2_SIZE
ret false
end
ret true
end

note Exact 1-, 2-, or 4-byte BAR2 MMIO read (no 32-bit RMW side effects, bounds-checked).
fn rtlrd off ulong w ulong to ulong
if not rtl_mmio_bounds_ok off w
trap 3
end
a = add get rtl_hw 0 off
a64_dsb_sy
v = fwld a w
a64_dsb_sy
if eq w 1
ret and v 255
end
if eq w 2
ret and v 65535
end
ret and v 4294967295
end

note Exact 1-, 2-, or 4-byte BAR2 MMIO write (bounds-checked, safe for ChipCmd/Cfg9346/RxMaxSize).
fn rtlwr off ulong w ulong v ulong to void
if not rtl_mmio_bounds_ok off w
trap 3
end
a = add get rtl_hw 0 off
a64_dsb_sy
z = fwst a w v
a64_dsb_sy
end

note Direct Normal-NC physical DMA accessors: rtl8127.om reads/writes rtl_hw[1] directly (no WB alias).
fn rtldma_r8 off ulong to ulong
base = get rtl_hw 1
if or eq base 0 ge off RTL_RDMA_SIZE
trap 3
end
ret and fwld add base off 1 255
end

fn rtldma_w8 off ulong v ulong to void
base = get rtl_hw 1
if or eq base 0 ge off RTL_RDMA_SIZE
trap 3
end
z = fwst add base off 1 and v 255
end

note Overflow-safe CNTVCT_EL0 microsecond delay.
fn rtldly us ulong to void
if eq us 0
ret
end
frq = fwsys 3
if lt frq 1000
ret
end
ticks = add mul div us 1000000 frq div mul rem us 1000000 frq 1000000
if eq ticks 0
ticks = ulong 1
end
t0 = fwsys 2
while true bound 9223372036854775807
t1 = fwsys 2
if ge t1 t0
if ge sub t1 t0 ticks
break
end
end
end
end

fn rtlbar to void
a64_dsb_sy
end

note Pre-DMA WB clean+invalidate helper for any WB buffer handed toward NIC DMA.
fn rtl_wb_clean_inv pa ulong nbytes ulong to void
a64_dc_civac_range pa nbytes
a64_dsb_sy
end

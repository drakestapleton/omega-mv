fn leq l view uchar * q ulong off ulong n ulong to bool
for i ulong n bound 9223372036854775807
if ne get l add q i get inb add off i
ret false
end
end
ret true
end
fn lidx l view uchar * off ulong n ulong to ulong
note 1-based place of the word inb[off .. off+n) in the list l (words between single spaces), 0 when absent
e = len l
p = ulong 0
k = ulong 0
while lt add p 1 e bound 9223372036854775807
q = add p 1
w = lend l q
k = add k 1
if eq sub w q n
if leq l q off n
ret k
end
end
p = w
end
ret 0
end
fn kwo off ulong n ulong to ulong
ret lidx kwl off n
end
fn growtab need ulong to void
if ge need len tof
m = add mul need 2 256
r = enlarge tof m
if lt r 0
exit 70
end
r = enlarge tln m
if lt r 0
exit 70
end
r = enlarge tar m
if lt r 0
exit 70

global st ulong 64
global inb uchar *
global ob uchar *
global tof ulong *
global tln ulong *
global tar ulong *
global tty ulong *
global nof ulong *
global nln ulong *
global fof ulong *
global fln ulong *
global far ulong *
global bkk ulong *
global bkm ulong *
global bke ulong *
global bkt ulong *
fn g i ulong to ulong
ret get st i
end
fn sv i ulong v ulong to void
put st i v
end
fn growin need ulong to void
if gt need len inb
r = enlarge inb mul need 2
if lt r 0
exit 70
end
end
end
fn slurp to ulong
n = ulong 0
go = true
while go bound 9223372036854775807
growin add n 65536
k = read 0 inb n 65536
if lt k 0
exit 71
end
if eq k 0
go = false
else
n = add n ulong k
end
end
ret n
end
fn ob1 c uchar to void
k = g S_NO
if ge k len ob
r = enlarge ob add mul k 2 4096
if lt r 0
exit 70
end
end
put ob k c
sv S_NO add k 1
end
fn obw off ulong n ulong to void
for i ulong n bound 9223372036854775807
ob1 get inb add off i
end
end
fn flush fd int to void
p = ulong 0
n = g S_NO
while lt p n bound 9223372036854775807
k = write fd ob p sub n p
if le k 0
exit 72
end
p = add p ulong k
end
sv S_NO 0
end
fn obnum v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
more = true
while more bound 20
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
more = false
end
end
for i ulong k bound 20
ob1 get d sub sub k 1 i
end
end
fn eol p ulong to ulong
lim = g S_LIM
q = p
go = true
while go bound 9223372036854775807

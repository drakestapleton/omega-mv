fn num off ulong n ulong to ulong
v = ulong 0
for i ulong n bound 9223372036854775807
c = get inb add off i
if lt c 48
exit 65
end
if gt c 57
exit 65
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn weq a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
for i ulong an bound 9223372036854775807
if ne get inb add a i get inb add b i
ret false
end
end
ret true
end
fn lend l view uchar * q ulong to ulong
e = len l
w = q
go = true
while go bound 9223372036854775807

fn rawline a ulong e ulong k ulong to void
note a note line (invisible to the machine) or a top-level text line, copied as it stands
te = rtrim a e
if ne g S_OCOL 0
ob1 32
end
obw a sub te a
ob1 10
sv S_OCOL 0
if eq k K_TEXT
sv S_FIRST 0
we = wordend a e
b = skipsp we e
if lt b e
addname b sub wordend b e b
end
end
end
fn emitw off ulong n ulong to void
if ne g S_OCOL 0
ob1 32
end
obw off n
sv S_OCOL 1
end
fn emitnl to void
ob1 10
sv S_OCOL 0
end
fn itemw off ulong n ulong to void
sv S_ITEMS add g S_ITEMS 1
fo = forced
if eq fo 2
if eq kwo off n K_END
sv S_FORCED add g S_FORCED 1
feed off n
ret
end
end
if ne fo 0
sv S_BAD add g S_BAD 1
end
emitw off n
feed off n
end
fn itemnl to void
sv S_ITEMS add g S_ITEMS 1
fo = forced
if eq fo 1
sv S_FORCED add g S_FORCED 1
feednl
ret
end
if ne fo 0
sv S_BAD add g S_BAD 1
end
emitnl
feednl
end
fn stripline a ulong e ulong to void
we = wordend a e
k = kwo a sub we a
z = ulong 0
if eq k K_NOTE
z = 1
end
if eq k K_TEXT
z = 1
end
if ne z 0
sv S_ITEMS add g S_ITEMS 1
rawline a e k
ret
end
p = a
while lt p e bound 9223372036854775807
q = wordend p e
itemw p sub q p
p = skipsp q e
end
itemnl
end
fn pushforced to void
note write every item that is forced now
go = true
while go bound 9223372036854775807
fo = forced
if eq fo 0
go = false
end
if eq fo 1
sv S_FORCED add g S_FORCED 1
sv S_ITEMS add g S_ITEMS 1
emitnl
feednl
end
if eq fo 2
sv S_FORCED add g S_FORCED 1
sv S_ITEMS add g S_ITEMS 1
emitw g S_ENDOFF 3
feed g S_ENDOFF 3
end
end
end
fn expline a ulong e ulong to void
p = a
while lt p e bound 9223372036854775807
q = wordend p e
pushforced
if eq g S_I 0
k = kwo p sub q p
z = ulong 0
if eq k K_NOTE
z = 1
end
if eq k K_TEXT
z = 1
end
if ne z 0
sv S_ITEMS add g S_ITEMS 1
rawline p e k
ret
end
end
sv S_ITEMS add g S_ITEMS 1
emitw p sub q p
feed p sub q p
p = skipsp q e
end
if ne g S_I 0
sv S_ITEMS add g S_ITEMS 1
emitnl
feednl
end
end
fn readtab to ulong
note the offset of the line after "%%"
p = ulong 0
lim = g S_LIM
while lt p lim bound 9223372036854775807
e = eol p
a = skipsp p e
if lt a e
we = wordend a e
if eq sub we a 2
if eq get inb a 37
if eq get inb add a 1 37
ret add e 1
end
end
end
b = skipsp we e
be = wordend b e
c = skipsp be e
addtab a sub we a num b sub be b num c sub wordend c e c
end
p = add e 1
end
exit 64
end
fn stats to void
sv S_NO 0
ob1 115
ob1 110
ob1 97
ob1 112
ob1 32
ob1 105
ob1 116
ob1 101
ob1 109
ob1 115
ob1 32
obnum g S_ITEMS
ob1 32

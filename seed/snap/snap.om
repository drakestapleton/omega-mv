if eq h 6
if eq k K_VOID
sv S_VOID 1
end
sv S_HS 7
if ne g S_OM2 0
sv S_OPEN 1
else
sv S_KIND 1
sv S_OWED 0
end
ret
end
sv S_OPEN 1
end
fn first off ulong n ulong to void
note the first word of a line
k = kwo off n
sv S_K0 k
if eq g S_INFN 0
if eq k K_OM2
if ne g S_FIRST 0
sv S_OM2 1
sv S_OPEN 1
ret
end
end
if eq k K_STRUCT
sv S_STRUCT 1
end
if eq k K_LAYOUT
sv S_STRUCT 1
end
if eq k K_ABSTR
sv S_STRUCT 1

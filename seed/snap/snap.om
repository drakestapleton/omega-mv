ret
end
sv S_OPEN 1
sv S_K0 K_UNKNOWN
ret
end
if eq kd 4
if eq i 1
sv S_NEWOFF off
sv S_NEWLEN n
sv S_HASNEW 1
ret
end
sv S_OPEN 1
ret
end
if eq kd 1
if eq g S_OWED 0
if eq g S_SKIP 0
if eq g S_PEND 0
if ne g S_TAIL 0
if eq kwo off n K_BOUND
sv S_TAIL 0
sv S_OWED 1
ret
end
end
sv S_OPEN 1
ret
end
end
end

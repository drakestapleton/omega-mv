r = enlarge tty m
if lt r 0
exit 70
end
end
end
fn addtab off ulong n ulong ar ulong ty ulong to void
k = g S_NT
growtab k
put tof k off
put tln k n
put tar k ar
put tty k ty
sv S_NT add k 1
end
fn findtab off ulong n ulong to ulong
note index + 1 of the word in the table, 0 when absent
nt = g S_NT
for i ulong nt bound 9223372036854775807
if weq get tof i get tln i off n
ret add i 1
end
end
ret 0
end
fn istype off ulong n ulong to bool
k = kwo off n
if eq k K_F32
ret true
end
if eq k K_F64
ret true
end

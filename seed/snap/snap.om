if lt r 0
exit 70
end
r = enlarge bke m
if lt r 0
exit 70
end
r = enlarge bkt m
if lt r 0
exit 70
end
end
put bkk k kind
put bkm k g S_NN
put bke k 0
put bkt k 0
sv S_NB add k 1
end
fn forced to ulong
note 0 nothing forced, 1 the line must end here, 2 the next line must be end
if eq g S_I 0
if eq g S_INFN 0
ret 0
end
if eq g S_ENDED 0
ret 0
end
nb = g S_NB
if gt nb 0
if eq get bkk sub nb 1 1
if eq get bke sub nb 1 0
ret 0
end
end
end
ret 2
end
if ne g S_OPEN 0
ret 0
end
if ne g S_SKIP 0
ret 0
end
if ne g S_PEND 0
ret 0
end
if ne g S_KIND 1
ret 0
end
if ne g S_OWED 0
ret 0
end
if ne g S_TAIL 0
ret 0
end
ret 1
end
fn newline to void
sv S_I 0
sv S_KIND 0
sv S_K0 0
sv S_OWED 0
sv S_OPEN 0
sv S_SKIP 0
sv S_TAIL 0
sv S_PEND 0
sv S_HS 0
sv S_HASNEW 0
sv S_HASHDR 0
end
fn feedend to void
nb = g S_NB
if gt nb 0
t = sub nb 1
sv S_NN get bkm t
both = ulong 0
if eq get bkk t 1
if ne get bke t 0
if ne get bkt t 0
both = g S_ENDED
end
end
end
sv S_ENDED both
sv S_NB t
else
sv S_INFN 0
sv S_ENDED 0
sv S_NN g S_FNMARK
end
end
fn feednl to void
if eq g S_I 0
ret
end
k = g S_K0
if eq k K_FN
if ne g S_HASHDR 0
addfn g S_HDROFF g S_HDRLEN g S_HDRN
end
end
if eq k K_RET
sv S_ENDED 1
end
if eq k K_EXIT
sv S_ENDED 1
end
if eq k K_TRAP
sv S_ENDED 1
end
if eq k K_BREAK
sv S_ENDED 1
end
if eq k K_CONT
sv S_ENDED 1
end
if eq k K_IF
pushblk 1
sv S_ENDED 0
end
if eq k K_WHILE
pushblk 2
sv S_ENDED 0
end
if eq k K_FOR
pushblk 2
sv S_ENDED 0
if ne g S_HASNEW 0
addname g S_NEWOFF g S_NEWLEN
end
end
if eq k K_ELSE
nb = g S_NB
if gt nb 0
put bkt sub nb 1 g S_ENDED
put bke sub nb 1 1
sv S_NN get bkm sub nb 1
end
sv S_ENDED 0
end
if eq k K_END
feedend
end
if eq k K_ASSIGN
if ne g S_HASNEW 0
addname g S_NEWOFF g S_NEWLEN
end
end
sv S_FIRST 0
newline
end
fn hasparen off ulong n ulong to bool
for i ulong n bound 9223372036854775807
c = get inb add off i
if eq c 40
ret true
end
if eq c 41
ret true
end
end
ret false
end
fn isdigit c uchar to bool
if lt c 48
ret false
end
ret le c 57
end
fn isnum off ulong n ulong to bool
c = get inb off
if isdigit c
ret true
end
if eq c 45
if gt n 1
ret isdigit get inb add off 1
end
end
ret false
end
fn val off ulong n ulong to void
if ne g S_SKIP 0
sv S_SKIP sub g S_SKIP 1
ret
end
if ne g S_PEND 0
sv S_PEND 0
if istype off n
sv S_OWED add g S_OWED 1
else
sv S_OPEN 1
end
ret
end
if hasparen off n
sv S_OPEN 1
ret
end
if isnum off n
sv S_OWED sub g S_OWED 1
ret
end
k = kwo off n
if eq k K_NEW
sv S_PEND 1
ret
end
if ne g S_STRUCT 0
if eq k K_GET
sv S_OPEN 1
ret
end
if eq k K_OFFOF
sv S_OPEN 1
ret
end
end
if eq k K_OFFOF
sv S_SKIP 2
sv S_OWED sub g S_OWED 1
ret
end
if eq k K_SIZEOF
sv S_SKIP 1
sv S_OWED sub g S_OWED 1
ret
end
if eq k K_BITCAST
sv S_SKIP 1
ret
end
if eq k K_SEAL
sv S_SKIP 1
ret
end
if eq k K_ENLARGE
sv S_SKIP 1
ret
end
if eq k K_VIEW
ret
end
if eq k K_EDIT
ret
end
fa = findfn off n
if ne fa 0
sv S_OWED sub add g S_OWED sub fa 1 1
ret
end
if findname off n
sv S_OWED sub g S_OWED 1
ret
end
t = findtab off n
if ne t 0
if eq lidx ctl off n 0
sv S_OWED sub add g S_OWED get tar sub t 1 1
ret
end
end
sv S_OPEN 1
end
fn fnhdr i ulong off ulong n ulong to void
if eq i 1
sv S_INFN 1
sv S_FNMARK g S_NN
sv S_NB 0
sv S_ENDED 0
sv S_HDROFF off
sv S_HDRLEN n
sv S_HDRN 0
sv S_HASHDR 1
sv S_HS 1
sv S_VOID 0
ret
end
k = kwo off n
if eq g S_HS 5
sv S_HS 1
if eq k K_FRESH
ret
end
end
h = g S_HS
if eq h 1
if eq k K_TO
sv S_HS 6
ret
end
addname off n
sv S_HDRN add g S_HDRN 1
sv S_HS 2
ret
end
if eq h 2
nx = ulong 1
if eq k K_VIEW
nx = 3
end
if eq k K_EDIT
nx = 3
end
if eq k K_OUT
nx = 3
end
sv S_HS nx
ret
end
if eq h 3
if istype off n
sv S_HS 4
else

om2
fn main to int
m = new uchar 128 0
n = cpuget 0 m 0 128
if le n 0
ret 81
end
count = ulong 0
for i ulong 128
for j ulong 8
if ne and get m i shl uchar 1 uchar j 0
count = add count 1
end
end
end
if ne count 1
ret 82
end
core = ulong cpunow
if eq and get m div core 8 shl uchar 1 uchar rem core 8 0
ret 83
end
if ne getprio 0 0 1
ret 84
end
ret 0
end

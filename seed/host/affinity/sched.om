note Scheduler gate. Select one CPU from the inherited mask so no wider pool is touched.
om2
global mask uchar 128
global check uchar 128
global status uchar 4
fn reap p long to int
r = waitpid int p status 0 4 0
if or ne r p ne get status 0 0
ret 99
end
ret int get status 1
end
fn badslice to int
p = fork
if eq p 0
n = ulong 129
r = cpuget 0 mask 0 n
exit 90
end
ret reap p
end
text pstat "/proc/thread-self/stat"
fn statnice to long
b = new uchar 1024 0
fd = fopen pstat 0 len pstat 0 0
if lt fd 0
ret -1
end
n = read int fd b 0 1024
c = fclose int fd
if le n 0
ret -1
end
p = ulong 0
for i ulong ulong n
if eq get b i 41
p = add i 2
end
end
if eq p 0
ret -1
end
note Skip fields 3 through 18 after the final closing parenthesis of comm.
for colidx ulong 16
while lt p ulong n
if eq get b p 32
p = add p 1
break
end
p = add p 1
end
end
v = long 0
while lt p ulong n
d = get b p
if or lt d 48 gt d 57
break
end
v = add mul v 10 long sub d 48
p = add p 1
end
ret v
end
fn priority to int
p = fork
if eq p 0
v = getprio 0 0
if or lt v 1 gt v 40
exit 10
end
r = setprio 0 0 19
if ne r 0
exit 11
end
if ne getprio 0 0 1
exit 12
end
if ne statnice 19
exit 16
end
note Under a nice 19 pool setprio 0 0 19 changes nothing, so a lowering that drops or hardwires the
note priority operand passes the checks above. Ask for nice 18: without CAP_SYS_NICE (RLIMIT_NICE 0)
note the kernel refuses with -13 and nice stays 19; where it is allowed nice must become 18.
r = setprio 0 0 18
if eq r 0
if ne statnice 18
exit 19
end
if ne getprio 0 0 2
exit 19
end
else
if ne r -13
exit 19
end
if ne statnice 19
exit 19
end
end
r = setprio 99 0 19
if ne r -22
exit 13
end
exit 0
end
ret reap p
end
fn offset core ulong to int
b = new uchar 144 0
put b add 9 div core 8 shl uchar 1 uchar rem core 8
r = cpuset 0 b 9 128
if or ne r 0 ne cpunow long core
ret 14
end
for i ulong 144
put b i 0
end
r = cpuget 0 b 9 128
if le r 0
ret 15
end
if ne get b add 9 div core 8 shl uchar 1 uchar rem core 8
ret 15
end
for i ulong 9
if ne get b i 0
ret 15
end
end
ret 0
end
fn main to int
n = cpuget 0 mask 0 128
if le n 0
ret 1
end
core = ulong 1024
for i ulong 128
if ne get mask i 0
for j ulong 8
if ne and get mask i shl uchar 1 uchar j 0
core = add mul i 8 j
break
end
end
break
end
end
if eq core 1024
ret 2
end
note The last inherited core too: on a pool whose first core is CPU 0 a cpunow that always
note gives 0 would pass the first-core check. Pin the last inherited core on every pool shape
note (with one core it is the first core) so a cpunow that ignores getcpu fails here at 18 on
note every mask except the single core CPU 0, where 0 is the correct answer.
last = core
for i ulong 128
for j ulong 8
if ne and get mask i shl uchar 1 uchar j 0
last = add mul i 8 j
end
end
end
r = cpuset 0 check 0 128
if ne r -22
ret 3
end
note check is still all zero here (the empty-mask case above); set the last core's bit, then clear it.
put check div last 8 shl uchar 1 uchar rem last 8
r = cpuset 0 check 0 128
put check div last 8 0
if ne r 0
ret 17
end
if ne cpunow long last
ret 18
end
put check div core 8 shl uchar 1 uchar rem core 8
r = cpuset 0 check 0 128
if ne r 0
ret 4
end
if ne cpunow long core
ret 5
end
for i ulong 128
put mask i 0
end
n = cpuget 0 mask 0 128
if le n 0
ret 6
end
for i ulong 128
if ne get mask i get check i
ret 7
end
end
r = cpuget 2147483647 mask 0 128
if ne r -3
ret 8
end
if ne badslice 103
ret 9
end
k = offset core
if ne k 0
ret k
end
ret priority
end

note Compose after the existing run.om helpers, replacing only its benchmark main.
fn main to int
mask = new uchar 128 0
n = cpuget 0 mask 0 128
if le n 0
ret 91
end
core = ulong 1024
for i ulong 128
if ne get mask i 0
for j ulong 8
if ne and get mask i shl uchar 1 uchar j 0
core = add mul i 8 j
break
end
end
break
end
end
if eq argcnt 3
core = 1024
end
pbclr
pbnum core
setslot 6
n = argread 1 gcd 0 4096
if le n 0
ret 92
end
put gcdn 0 ulong n
cpk1
ret int runpk
end

# Each candidate compiler must fail the same device-free host fixture.
subst seed/host/devcall-cap-from.txt seed/host/devcall-cap-offbyone.txt
cc seed/omc/omc.om
devcall-cap-offbyone run seed/host/tests/devcall.om - file:seed/host/devcall.want - 0
cc pinned
subst seed/host/devcall-cap-from.txt seed/host/devcall-cap-removed.txt
cc seed/omc/omc.om
devcall-cap-removed run seed/host/tests/devcall.om - file:seed/host/devcall.want - 0

note SPDX-License-Identifier: Apache-2.0
note seed/host/utimens/utimens.om: fixture for utimens (keyword 239), program mode. Run by the OM-2
note conductor through seed/host/utimens/utimens.cases from the repository root. Kernel truth is the
note 128-byte stat record (atime seconds/nanoseconds at bytes 72/80, mtime at 88/96) from stat and
note lstat. F is /tmp/omega-utimens-<pid>-f, L the symbolic link /tmp/omega-utimens-<pid>-l -> F.
note Checks (exit = number of the first failed check, 0 when all hold):
note 1 setup: F is created and L is linked to it.
note 2 utimens F {1000000000,123456789} {1500000000,987654321} 0: 0, and stat F shows exactly both.
note 3 atime UTIME_OMIT, mtime {1600000000,5}: 0; atime unchanged, mtime exactly the new pair.
note 4 atime UTIME_NOW, mtime UTIME_OMIT: 0; atime seconds within the realns window, mtime unchanged.
note 5 L with AT_SYMLINK_NOFOLLOW (256), {1100000000,7} {1200000000,9}: 0; lstat L shows both and
note   stat F (the target) keeps mtime {1600000000,5}.
note 6 L with flags 0 follows the link, {1300000000,1} {1400000000,2}: 0; stat F shows both, lstat L
note   keeps mtime {1200000000,9} (not atime: following the link may refresh the link's own atime).
note 7 a missing path returns -2 (ENOENT), given in a global array and as read-only text.
note 8 a nanosecond of 1000000000 returns -22 (EINVAL).
note 9 flags 1 returns -22 (EINVAL).
note 10 a slice past the path array end traps 3 (child exit 103).
note 11 an embedded zero byte in the path traps 3 (child exit 103).
note 12 a path of 4096 bytes traps 3 (child exit 103).
note 13 an empty path (n 0) reaches the kernel and returns -2 (ENOENT), as for the other path words.
note 14 cleanup: L and F are unlinked.
om2
text pre "/tmp/omega-utimens-"
text tmiss "/nonexistent-omega-utimens/f"
global pf uchar 64
global pl uchar 64
global list uchar 160
global st uchar 128
global longp uchar 4096
global zb uchar 8
global status uchar 4

note pf = F, pl = L; returns their common length.
fn mkpaths to ulong
for i ulong len pre
put pf i get pre i
end
p = len pre
pid = ulong getpid
d = ulong 1
while le mul d 10 pid
d = mul d 10
end
while gt d 0
put pf p uchar add 48 rem div pid d 10
p = add p 1
d = div d 10
end
put pf p 45
put pf add p 1 102
for i ulong add p 2
put pl i get pf i
end
put pl add p 1 108
ret add p 2
end

note Little-endian long at st[o..o+8).
fn rd8 o ulong to long
v = ulong 0
for i ulong 8
v = or shl v 8 ulong get st sub add o 7 i
end
ret long v
end

note Stat F (which 0, follows) or lstat L (which 1) into st; 1 on success.
fn fill which ulong n ulong to ulong
r = long 0
if eq which 0
r = stat pf 0 n st 0 128
else
r = lstat pl 0 n st 0 128
end
if ne r 0
ret 0
end
ret 1
end

note 1 when st holds atime {as, ans} and mtime {ms, mns}.
fn times as long ans long ms long mns long to ulong
if or ne rd8 72 as ne rd8 80 ans
ret 0
end
if or ne rd8 88 ms ne rd8 96 mns
ret 0
end
ret 1
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

note A child that must trap 3 (exit 103): k 0 slice past the end, 1 embedded zero, 2 4096 bytes.
fn trapkid k ulong to ulong
pid = fork
if lt pid 0
ret 1
end
if eq pid 0
r = long 0
if eq k 0
r = utimens pf 60 8 0 0 0 0 0
end
if eq k 1
r = utimens zb 0 4 0 0 0 0 0
end
if eq k 2
r = utimens longp 0 4096 0 0 0 0 0
end
exit 1
end
ret reap pid
end

fn main to int
n = mkpaths
fd = fopen pf 0 n 578 420
if lt fd 0
ret 1
end
c = fclose int fd
put list 0 2
put list 1 0
put list 2 uchar n
put list 3 0
for i ulong n
put list add 4 i get pf i
end
o = add 4 n
put list o uchar n
put list add o 1 0
for i ulong n
put list add add o 2 i get pl i
end
if ne symlnk list 0 add add o 2 n 0
ret 1
end
if ne utimens pf 0 n 1000000000 123456789 1500000000 987654321 0 0
ret 2
end
if eq fill 0 n 0
ret 2
end
if eq times 1000000000 123456789 1500000000 987654321 0
ret 2
end
if ne utimens pf 0 n 0 1073741822 1600000000 5 0 0
ret 3
end
if eq fill 0 n 0
ret 3
end
if eq times 1000000000 123456789 1600000000 5 0
ret 3
end
t0 = div realns 1000000000
if ne utimens pf 0 n 0 1073741823 0 1073741822 0 0
ret 4
end
t1 = div realns 1000000000
if eq fill 0 n 0
ret 4
end
a = rd8 72
if or lt a sub t0 1 gt a t1
ret 4
end
if or ne rd8 88 1600000000 ne rd8 96 5
ret 4
end
if ne utimens pl 0 n 1100000000 7 1200000000 9 256 0
ret 5
end
if eq fill 1 n 0
ret 5
end
if eq times 1100000000 7 1200000000 9 0
ret 5
end
if eq fill 0 n 0
ret 5
end
if or ne rd8 88 1600000000 ne rd8 96 5
ret 5
end
if ne utimens pl 0 n 1300000000 1 1400000000 2 0 0
ret 6
end
if eq fill 0 n 0
ret 6
end
if eq times 1300000000 1 1400000000 2 0
ret 6
end
if eq fill 1 n 0
ret 6
end
if or ne rd8 88 1200000000 ne rd8 96 9
ret 6
end
if ne utimens pf 0 sub n 1 0 0 0 0 0 neg long 2
ret 7
end
if ne utimens tmiss 0 len tmiss 0 0 0 0 0 neg long 2
ret 7
end
if ne utimens pf 0 n 1 1000000000 0 0 0 neg long 22
ret 8
end
if ne utimens pf 0 n 0 0 0 0 1 neg long 22
ret 9
end
if ne trapkid 0 103
ret 10
end
if ne trapkid 1 103
ret 11
end
for i ulong len longp
put longp i 97
end
if ne trapkid 2 103
ret 12
end
if ne utimens pf 0 0 0 0 0 0 0 neg long 2
ret 13
end
if ne unlink pl 0 n 0
ret 14
end
if ne unlink pf 0 n 0
ret 14
end
ret 0
end

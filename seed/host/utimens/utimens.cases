intsec refuse seed/host/utimens/intsec.om 7
efi refuse seed/host/utimens/efi-target.om+seed/host/utimens/use.om 25
subst seed/host/utimens/mutants/a64-sysno.from seed/host/utimens/mutants/a64-sysno.to
cc seed/omc/omc.om
mut-a64-sysno run seed/host/utimens/utimens.om - - - 2
cc pinned
subst seed/host/utimens/mutants/a64-order.from seed/host/utimens/mutants/a64-order.to
cc seed/omc/omc.om
mut-a64-order run seed/host/utimens/utimens.om - - - 2
cc pinned
subst seed/host/utimens/mutants/a64-flags.from seed/host/utimens/mutants/a64-flags.to
cc seed/omc/omc.om
mut-a64-flags run seed/host/utimens/utimens.om - - - 5
cc pinned
subst seed/host/utimens/mutants/x86-sysno.from seed/host/utimens/mutants/x86-sysno.to
cc seed/omc/omc.om
mut-x86-sysno run seed/host/utimens/x86-target.om+seed/host/utimens/utimens.om - - - 2
cc pinned
subst seed/host/utimens/mutants/x86-order.from seed/host/utimens/mutants/x86-order.to
cc seed/omc/omc.om
mut-x86-order run seed/host/utimens/x86-target.om+seed/host/utimens/utimens.om - - - 2
cc pinned
subst seed/host/utimens/mutants/x86-flags.from seed/host/utimens/mutants/x86-flags.to
cc seed/omc/omc.om
mut-x86-flags run seed/host/utimens/x86-target.om+seed/host/utimens/utimens.om - - - 5

# seed/host/execfds/execfds.cases: execfds (keyword 201), run by the OM-2 conductor
# (seed/qualification/om2/gate.om) from seed/host/execfds/check.sh (OMC, its sha256, this file, SCRATCH).
# fixture: seed/host/execfds/execfds.om parent mode, 29 checks (exit 0 = all hold; see its notes). Checks 25-29:
# under RLIMIT_AS 16 MiB a valid 4 MiB packet's decode mapping is refused (-12, control) while the same packet
# with a trailing byte, a zero byte, an empty first record or an empty environment record traps 3 first:
# framing is validated against the supplied bytes before any mapping.
# fault-control: the unmutated compiler executes the fault launch (exit 50), so the fault rows below can only
# pass when the mutant's -ENOSYS really reaches the caller.
# Refusals: no x86linux / x86efi / a64efi lowering (error 25), program-only (OM-2 function unit, error 9),
# no host word in a contract clause (error 30).
# Mutants of seed/omc/omc.om (each must make the fixture fail at the named check, parent exit = check):
#   keep-len4 (check 9), keep-increasing (11), keep-low3 (13), keep-intmax (14), keep-cloexec (1);
#   validation pass (hpackv): no-prepass (the pass is not called: 26), prepass-trailing (26), prepass-nul
#   (27), prepass-argv0 (28), prepass-env-nonempty (29). The copying pass after the mapping still repeats
#   every check, so these mutants still trap, but only after the decode mapping, which the cap refuses first.
#   Not mutated: the count-0 check (a count-0 packet is refused by the trailing check of the same pass, an
#   equivalent mutant) and the record-header/length checks (without them the pass reads past its packet:
#   undefined, so no expected outcome can be stated).
# Fault injection (ENOSYS at one step: unshare, the GETFD loop, the SETFD loop, a gap close_range, the tail
# close_range): the fault launch must return -38 with the kept descriptor 7 still open and no exec (exit 38).
# The private-table mutant (no-unshare) is not observable from inside the process; seed/host/execfds/check.sh
# kills it with the strace order check.
deadline 120
fixture run seed/host/execfds/execfds.om - - - 0
fault-control run seed/host/execfds/execfds.om - - - 50 fault
x86linux refuse seed/host/execfds/refusals/x86linux.om 25
x86efi refuse seed/host/execfds/refusals/x86efi.om 25
a64efi refuse seed/host/execfds/refusals/a64efi.om 25
fnmode refuse seed/host/execfds/refusals/fnmode.om 9
contract refuse seed/host/execfds/refusals/contract.om 30
subst seed/host/execfds/mutants/keep-len4.from seed/host/execfds/mutants/keep-len4.to
cc seed/omc/omc.om
mut-keep-len4 run seed/host/execfds/execfds.om - - - 9
cc pinned
subst seed/host/execfds/mutants/keep-increasing.from seed/host/execfds/mutants/keep-increasing.to
cc seed/omc/omc.om
mut-keep-increasing run seed/host/execfds/execfds.om - - - 11
cc pinned
subst seed/host/execfds/mutants/keep-low3.from seed/host/execfds/mutants/keep-low3.to
cc seed/omc/omc.om
mut-keep-low3 run seed/host/execfds/execfds.om - - - 13
cc pinned
subst seed/host/execfds/mutants/keep-intmax.from seed/host/execfds/mutants/keep-intmax.to
cc seed/omc/omc.om
mut-keep-intmax run seed/host/execfds/execfds.om - - - 14
cc pinned
subst seed/host/execfds/mutants/keep-cloexec.from seed/host/execfds/mutants/keep-cloexec.to
cc seed/omc/omc.om
mut-keep-cloexec run seed/host/execfds/execfds.om - - - 1
cc pinned
subst seed/host/execfds/mutants/no-prepass.from seed/host/execfds/mutants/no-prepass.to
cc seed/omc/omc.om
mut-no-prepass run seed/host/execfds/execfds.om - - - 26
cc pinned
subst seed/host/execfds/mutants/prepass-trailing.from seed/host/execfds/mutants/prepass-trailing.to
cc seed/omc/omc.om
mut-prepass-trailing run seed/host/execfds/execfds.om - - - 26
cc pinned
subst seed/host/execfds/mutants/prepass-nul.from seed/host/execfds/mutants/prepass-nul.to
cc seed/omc/omc.om
mut-prepass-nul run seed/host/execfds/execfds.om - - - 27
cc pinned
subst seed/host/execfds/mutants/prepass-argv0.from seed/host/execfds/mutants/prepass-argv0.to
cc seed/omc/omc.om
mut-prepass-argv0 run seed/host/execfds/execfds.om - - - 28
cc pinned
subst seed/host/execfds/mutants/prepass-env-nonempty.from seed/host/execfds/mutants/prepass-env-nonempty.to
cc seed/omc/omc.om
mut-prepass-env-nonempty run seed/host/execfds/execfds.om - - - 29
cc pinned
subst seed/host/execfds/mutants/enosys-unshare.from seed/host/execfds/mutants/enosys-unshare.to
cc seed/omc/omc.om
fault-unshare run seed/host/execfds/execfds.om - - - 38 fault
cc pinned
subst seed/host/execfds/mutants/enosys-getfd.from seed/host/execfds/mutants/enosys-getfd.to

# seed/host/mapnarrow/mapnarrow.cases: mapget/mapset width 1 and 2 (keywords 174/175), run by the
# OM-2 conductor (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=22.
# fixture: seed/host/mapnarrow/mapnarrow.om against a fake device file (a shared memfd mapping read back
# with pread/pwrite); exit 0 = all 10 checks hold. x86-fixture: the same source for x86linux, run through
# binfmt qemu-x86_64: emulator evidence, not hardware qualification.
# Each mutant compiler is built from seed/omc/omc.om with one narrow-width emission changed; the fixture
# built by it must fail at the named check (exit = check number). The width mutants widen admission to
# width 3, so width3.om, refused by the real compiler, compiles.
deadline 120
fixture run seed/host/mapnarrow/mapnarrow.om - - - 0
x86-fixture run seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/mapnarrow.om - - - 0
width3 refuse seed/host/mapnarrow/width3.om 9
width16 refuse seed/host/mapnarrow/width16.om 9
widthvar refuse seed/host/mapnarrow/widthvar.om 9
x86-width3 refuse seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/width3.om 9
x86-width16 refuse seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/width16.om 9
x86-widthvar refuse seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/widthvar.om 9
fnmode emit seed/host/mapnarrow/fnnarrow.om any - 0
x86-fnmode emit seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/fnnarrow.om any - 0
subst seed/host/mapnarrow/mutants/a64-strb.from seed/host/mapnarrow/mutants/a64-strb.to
cc seed/omc/omc.om
mut-a64-strb run seed/host/mapnarrow/mapnarrow.om - - - 4
cc pinned
subst seed/host/mapnarrow/mutants/a64-ldrb.from seed/host/mapnarrow/mutants/a64-ldrb.to
cc seed/omc/omc.om
mut-a64-ldrb run seed/host/mapnarrow/mapnarrow.om - - - 2
cc pinned
subst seed/host/mapnarrow/mutants/a64-strh.from seed/host/mapnarrow/mutants/a64-strh.to
cc seed/omc/omc.om
mut-a64-strh run seed/host/mapnarrow/mapnarrow.om - - - 5
cc pinned
subst seed/host/mapnarrow/mutants/a64-ldrh.from seed/host/mapnarrow/mutants/a64-ldrh.to
cc seed/omc/omc.om
mut-a64-ldrh run seed/host/mapnarrow/mapnarrow.om - - - 3
cc pinned
subst seed/host/mapnarrow/mutants/a64-trunc1.from seed/host/mapnarrow/mutants/a64-trunc1.to
cc seed/omc/omc.om
mut-a64-trunc1 run seed/host/mapnarrow/mapnarrow.om - - - 9
cc pinned
subst seed/host/mapnarrow/mutants/a64-trunc2.from seed/host/mapnarrow/mutants/a64-trunc2.to
cc seed/omc/omc.om
mut-a64-trunc2 run seed/host/mapnarrow/mapnarrow.om - - - 9
cc pinned
subst seed/host/mapnarrow/mutants/a64-width.from seed/host/mapnarrow/mutants/a64-width.to
cc seed/omc/omc.om
mut-a64-width emit seed/host/mapnarrow/width3.om any - 0
cc pinned
subst seed/host/mapnarrow/mutants/x86-put.from seed/host/mapnarrow/mutants/x86-put.to
cc seed/omc/omc.om
mut-x86-put run seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/mapnarrow.om - - - 4
cc pinned
subst seed/host/mapnarrow/mutants/x86-raw.from seed/host/mapnarrow/mutants/x86-raw.to
cc seed/omc/omc.om
mut-x86-raw run seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/mapnarrow.om - - - 2
cc pinned
subst seed/host/mapnarrow/mutants/x86-trunc1.from seed/host/mapnarrow/mutants/x86-trunc1.to
cc seed/omc/omc.om
mut-x86-trunc1 run seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/mapnarrow.om - - - 9
cc pinned
subst seed/host/mapnarrow/mutants/x86-trunc2.from seed/host/mapnarrow/mutants/x86-trunc2.to
cc seed/omc/omc.om
mut-x86-trunc2 run seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/mapnarrow.om - - - 9
cc pinned
subst seed/host/mapnarrow/mutants/x86-width.from seed/host/mapnarrow/mutants/x86-width.to
cc seed/omc/omc.om
mut-x86-width emit seed/host/mapnarrow/x86-target.om+seed/host/mapnarrow/width3.om any - 0

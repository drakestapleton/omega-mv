note SPDX-License-Identifier: Apache-2.0
note seed/host/mapnarrow/mapnarrow.om: mapget/mapset width 1 and 2 against a fake device file.
note The "device" is a 4096-byte memfd mapped shared (mode 1). Its first 256 bytes hold byte i = i,
note so a wrong access width shows up as a wrong value or a changed neighbour. pread/pwrite on the
note descriptor see the same page cache as the mapping: pwrite plays the device changing a register,
note pread reads back what a store actually wrote. Exit 0: every check holds; exit N: check N failed.
note The register offsets mirror the RTL8127 (ChipCmd 0x37, IntrStatus 0x3e, Cfg9346 0x50, PHYstatus
note 0x6c); no PCI device, VFIO group or driver is opened.
text name "omega-mapnarrow"
global seq uchar 256
global back uchar 16
global one uchar 1
global status uchar 4
fn ck yes bool n int to void
if not yes
exit n
end
end
note Child k performs one access that must trap 3 (exit 103) before touching memory.
fn bad h long ro long k int to void
if eq k 0
r = mapget h 63 2
end
if eq k 1
r = mapset h 63 2 0
end
if eq k 2
r = mapset h 55 1 256
end
if eq k 3
r = mapset h 62 2 65536
end
if eq k 4
r = mapget h 4096 1
end
if eq k 5
r = mapset h 4096 1 0
end
if eq k 6
r = mapget h 18446744073709551615 1
end
if eq k 7
r = mapset ro 55 1 0
end
if eq k 8
r = mapset ro 62 2 0
end
exit int 80
end
fn main to int
for i ulong 256
put seq i uchar i
end
fd = int memfd name 0 len name 0
ck ge fd 0 1
ck eq ftrunc fd 4096 0 1
ck eq pwrite fd seq 0 256 long 0 256 1
h = mapnew fd 0 4096 3 1
ck gt h 0 1
note 2-3: a narrow load returns exactly the addressed byte or halfword, zero-extended.
ck eq mapget h 55 1 55 2
ck eq mapget h 108 1 108 2
ck eq mapget h 62 2 16190 3
ck eq mapget h 108 2 28012 3
note 4: a byte store changes only that byte (0x34..0x3b read back through the descriptor).
ck eq mapset h 55 1 16 0 4
ck eq pread fd back 0 8 long 52 8 4
ck eq get back 0 52 4
ck eq get back 1 53 4
ck eq get back 2 54 4
ck eq get back 3 16 4
ck eq get back 4 56 4
ck eq get back 5 57 4
ck eq get back 6 58 4
ck eq get back 7 59 4
note 5: a halfword store changes only those two bytes, little endian (0x3c..0x43).
ck eq mapset h 62 2 48879 0 5
ck eq pread fd back 0 8 long 60 8 5
ck eq get back 0 60 5
ck eq get back 1 61 5
ck eq get back 2 239 5
ck eq get back 3 190 5
ck eq get back 4 64 5
ck eq get back 5 65 5
ck eq get back 6 66 5
ck eq get back 7 67 5
note 6: the device changes a register behind the mapping; the next narrow load sees it.
put one 0 uchar 192
ck eq pwrite fd one 0 1 long 80 1 6
ck eq mapget h 80 1 192 6
ck eq mapget h 80 2 20928 6
note 7: largest values and the last byte/halfword of the mapping are accepted.
ck eq mapset h 4095 1 255 0 7
ck eq mapget h 4095 1 255 7
ck eq mapset h 4094 2 65535 0 7
ck eq mapget h 4094 2 65535 7
ck eq mapget h 4092 4 4294901760 7
note 8: the 4 and 8 byte forms still work beside the narrow ones.
ck eq mapset h 128 4 305419896 0 8
ck eq mapget h 128 1 120 8
ck eq mapget h 130 2 4660 8
ck eq mapget h 128 8 9765639644287096440 8
note 9: each child's access traps 3: misaligned halfword (load, store), truncating byte and halfword
note stores, past the end (load, store), offset wrap, and stores through a read-only mapping.
ro = mapnew fd 0 4096 1 1
ck gt ro 0 9
for k int 9
p = fork
ck ge p 0 9
if eq p 0
bad h ro k
end
ck eq waitpid int p status 0 4 0 p 9
ck and eq get status 0 0 eq get status 1 103 9
end
note 10: the trapping children wrote nothing: 0x34..0x43 are as checks 4 and 5 left them.
ck eq pread fd back 0 16 long 52 16 10
ck eq get back 3 16 10
ck eq get back 10 239 10
ck eq get back 11 190 10
ck eq get back 12 64 10
ck eq mapdrop ro 0 10
ck eq mapdrop h 0 10
ck eq fclose fd 0 10
ret 0
end

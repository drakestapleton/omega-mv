note SPDX-License-Identifier: Apache-2.0
note seed/host/fstatfs/fstatfs.om: fixture for fstatfs (keyword 215), program mode, AArch64 Linux.
note r = fstatfs fd A off n: Linux fstatfs (44) into the writable uchar slice A[off..off+n); the AArch64 struct
note statfs is 120 bytes (asm-generic/statfs.h, checked independently by seed/host/fstatfs/oracle.py), so n
note below 120 traps 3 before the kernel is asked; only A[off..off+120) is written; long 0 or -errno.
note Run by the OM-2 conductor through seed/host/fstatfs/fstatfs.cases from the repository root.
note gate-pools: uses enlarge on purpose: owner=seed/host/fstatfs/check.sh check 5 shows a run-time pool is a valid fstatfs byte operand.
note Parent mode (no argument): exit 0 when every check holds, else the number of the first failed check.
note  1 a pipe descriptor: 0, and the f_type word (bytes 0..8) is written over a 0xAA poison (nonzero)
note  2 capacity 200: 0, and A[0..120) equals check 1's bytes (pipefs has no changing counts)
note  3 capacity 200: A[120..200) and the rest keep their poison: exactly 120 bytes are written
note  4 offset 9: A[0..9) and A[129..256) keep their poison, A[9..129) equals check 1's bytes
note  5 a run-time pool of 120 bytes is a valid operand and receives the same bytes
note  6 n 119 on a closed descriptor traps 3 (exit 103): the capacity is checked before the kernel call,
note    which would have answered -9
note  7 n 0 on a closed descriptor traps 3
note  8 off 1, n 120 on a 120-byte array (past the end) traps 3
note  9 off 0, n 121 on a 120-byte array traps 3
note 10 a closed descriptor (77): -9, and the 120 bytes keep their poison
note 11 descriptor -1: -9
note 12 the root directory: 0, and f_bsize (bytes 8..16) is nonzero
note Mode "dump": fstatfs of descriptor 0 (stdin) into 120 bytes written to stdout, exit 0; on a negative result
note nothing is written and the exit is the errno (seed/host/fstatfs/oracle.py compares these bytes).
om2
text dmode "dump"
text slash "/"
global sb uchar 120
global wide uchar 256
global ref uchar 120
global pb uchar 8
global buf uchar 16
global status uchar 4
global P uchar *

fn rd32 o ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get pb add o i mul i 8
end
ret v
end
fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret 2000
end
ret ulong get status 1
end
fn poison to void
for i ulong len wide
put wide i 170
end
for i ulong len sb
put sb i 170
end
end
note fork; the child calls fstatfs fd sb off n; 98 if it returns (a trap 3 is exit 103)
fn tryf fd int off ulong n ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = fstatfs fd sb off n
exit 98
end
ret reap pid
end
note wide[o .. o+120) equals ref
fn sameref o ulong to bool
for i ulong 120
if ne get wide add o i get ref i
ret false
end
end
ret true
end
fn poisoned lo ulong hi ulong to bool
for i ulong sub hi lo
if ne get wide add lo i 170
ret false
end
end
ret true
end
fn argis i ulong s view uchar * to bool
n = argread i buf 0 len buf
if ne n long len s
ret false
end
for j ulong len s
if ne get buf j get s j
ret false
end
end
ret true
end
fn dumpm to int
r = fstatfs 0 sb 0 120
if ne r 0
ret int and ulong neg r 255
end
w = write 1 sb 0 120
if ne w 120
ret 96
end
ret 0
end

fn main to int
if eq argcnt 2
if argis 1 dmode
ret dumpm
end
ret 36
end
r = pipefds pb 0 8 524288
if ne r 0
ret 1
end
pr = int rd32 0
note 1: a pipe descriptor
poison
r = fstatfs pr sb 0 120
if ne r 0
ret 1
end
nz = ulong 0
for i ulong 8
nz = or nz ulong get sb i
end
if eq nz 0
ret 1
end
for i ulong 120
put ref i get sb i
end
note 2-3: a larger capacity receives exactly 120 bytes
poison
r = fstatfs pr wide 0 200
if ne r 0
ret 2
end
if not sameref 0
ret 2
end
if not poisoned 120 256
ret 3
end
note 4: offset 9
poison
r = fstatfs pr wide 9 120
if ne r 0
ret 4
end
if not poisoned 0 9
ret 4
end
if not sameref 9
ret 4
end
if not poisoned 129 256
ret 4
end
note 5: a run-time pool
r = enlarge P ulong 120
if ne r 0
ret 5
end
r = fstatfs pr P 0 120
if ne r 0
ret 5
end
for i ulong 120
if ne get P i get ref i
ret 5
end
end
note 6-9: capacity and slice traps before the kernel
c = fclose 77
if ne tryf 77 0 119 103
ret 6
end
if ne tryf 77 0 0 103
ret 7
end
if ne tryf pr 1 120 103
ret 8
end
if ne tryf pr 0 121 103
ret 9
end
note 10-11: closed and negative descriptors
poison
r = fstatfs 77 sb 0 120
if ne r neg long 9
ret 10
end
for i ulong 120
if ne get sb i 170
ret 10
end
end
r = fstatfs neg int 1 sb 0 120
if ne r neg long 9
ret 11
end
note 12: the root directory
d = fopen slash 0 len slash 524288 0
if lt d 0
ret 12
end
poison
r = fstatfs int d sb 0 120
c = fclose int d
if ne r 0
ret 12
end
nz = ulong 0
for i ulong 8
nz = or nz ulong get sb add 8 i
end
if eq nz 0
ret 12
end
ret 0
end
note gate-pools: uses fstatfs on purpose: owner=seed/host/fstatfs/check.sh new-word acceptance or refusal qualification

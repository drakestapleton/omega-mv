note SPDX-License-Identifier: Apache-2.0
note seed/host/hostpool/legacy.om: the six legacy packed-list words (execprog 124, execpure 198, execenv 233,
note renames 125, link 141, symlnk 142) with run-time pools as their byte operands. hpoolok admits a pool for
note them (fzcore round 3, lead item 5); hpack, its packet framing and its 65536/4096-byte limits are unchanged.
note Run by the OM-2 conductor through hostpool.cases. Parent exit = the number of the first failed check, 0
note when all hold; its stdout is only "legacy ok" after the last check. Every packet starts at the pool's
note current length and ends exactly at it, so each in-bounds slice ends at len P. Files are argv0 plus a
note suffix, inside the conductor's scratch directory, and are unlinked by the check that made them.
note 1 argument 0 is readable (it is the executable path of every exec below).
note 2 execprog with packet [argv0, "prog", ""] in a pool: the new image sees argcnt 3, an empty argument 2,
note   an empty environment and an unrestricted fopen of /dev/null, and exits 41.
note 3 execpure with [argv0, "pure", ""]: the new image runs under the strict profile (fopen is -1 EPERM)
note   and exits 42.
note 4 execenv with [argv0, "env", ""] in pool P and the environment ["LXA=1", "LXB=22"] in pool E: the new
note   image sees exactly those two entries and exits 43.
note 5 renames: [a, b] with flag 1 moves a (same device, inode, mode; a is gone); flag 1 with b present is
note   -17 (EEXIST); flag 0 replaces b.
note 6 link: [c, d] makes d with c's device, inode and mode and nlink 2; a second link is -17.
note 7 symlnk: ["lx-target", e] makes e, readlnk e gives "lx-target"; a second symlnk is -17.
note 8 execprog with a well-formed 65536-byte packet [argv0, "lim", pattern] (the historical exec limit):
note   the new image checks the pattern and exits 44.
note 9 the same packet one pattern byte longer (65537 bytes, still inside the pool): trap 3 in a child (103).
note 10 symlnk with a well-formed 4096-byte packet [pattern target, f]: readlnk f returns the pattern.
note 11 the same with a 4097-byte packet (inside the pool): trap 3 (103), and no link was made.
note 12-14 execprog, execpure and execenv (its argv packet) with the packet of checks 2-4 whose last record
note   is empty and whose second length byte is one byte past the pool's current length: trap 3 (103).
note   Completing that header with a zero byte gives exactly the valid packet of checks 2-4, not a second
note   decoder refusal. Reading unmapped bytes would be a signal, not the required exit 103.
note 15 execenv with a valid argv packet and its environment slice one byte past E's current length: 103.
note 16-18 renames, link and symlnk with [a, b] and a slice one byte past the current length: 103. For
note   these four the zero byte past the length would also be refused by the decoder (trailing byte), so
note   their exit alone does not separate the slice check from the framing check; checks 12-14 avoid that.
om2
global P uchar *
global E uchar *
global pn ulong 3
global qn ulong 3
global a0 ulong 1
global g uchar 4096
global pb uchar 4200
global rb uchar 4096
global lb uchar 65536
global st uchar 128
global sx uchar 128
global status uchar 4
global buf uchar 64
text tprog "prog"
text tpure "pure"
text tenv "env"
text tlim "lim"
text tnull "/dev/null"
text tok "legacy ok\n"
text tea "LXA=1"
text teb "LXB=22"
text tsym "lx-target"
text tra ".ra"
text trb ".rb"
text tlc ".lc"
text tld ".ld"
text tse ".se"
text tsl ".sl"
text tsm ".sm"
text tqa ".qa"
text tqb ".qb"

fn arg1is t view uchar * to bool
n = argread 1 buf 0 len buf
if ne n long len t
ret false
end
for i ulong len t
if ne get buf i get t i
ret false
end
end
ret true
end

note pbeg: start a packet in P at its current length (count 0); pn = start, cursor, count.
fn pbeg to void
o = len P
r = enlarge P add o 2
put P o 0
put P add o 1 0
put pn 0 o
put pn 1 add o 2
put pn 2 0
end

note prec n: append a record header of length n, grow P to the record's end, raise the count; the data offset.
fn prec n ulong to ulong
o = get pn 1
r = enlarge P add add o 2 n
put P o uchar and n 255
put P add o 1 uchar shr n 8
put pn 1 add add o 2 n
c = add get pn 2 1
put pn 2 c
s = get pn 0
put P s uchar and c 255
put P add s 1 uchar shr c 8
ret add o 2
end

note pcnt c: overwrite the packet's count field.
fn pcnt c ulong to void
s = get pn 0
put P s uchar and c 255
put P add s 1 uchar shr c 8
end

fn psz to ulong
ret sub get pn 1 get pn 0
end

fn ptext t view uchar * to void
d = prec len t
for i ulong len t
put P add d i get t i
end
end

fn parg0 to void
n = get a0 0
d = prec n
for i ulong n
put P add d i get g i
end
end

note ppath t: a record holding argv0 followed by the suffix t.
fn ppath t view uchar * to void
n = get a0 0
d = prec add n len t
for i ulong n
put P add d i get g i
end
for j ulong len t
put P add add d n j get t j
end
end

note ppat n: a record of n bytes, byte j = 'a' + j % 26.
fn ppat n ulong to void
d = prec n
for j ulong n
put P add d j uchar add rem j 26 97
end
end

fn ebeg to void
o = len E
r = enlarge E add o 2
put E o 0
put E add o 1 0
put qn 0 o
put qn 1 add o 2
put qn 2 0
end

fn erec n ulong to ulong
o = get qn 1
r = enlarge E add add o 2 n
put E o uchar and n 255
put E add o 1 uchar shr n 8
put qn 1 add add o 2 n
c = add get qn 2 1
put qn 2 c
s = get qn 0
put E s uchar and c 255
put E add s 1 uchar shr c 8
ret add o 2
end

fn etext t view uchar * to void
d = erec len t
for i ulong len t
put E add d i get t i
end
end

note spath t: argv0 followed by the suffix t in pb; its length.
fn spath t view uchar * to ulong
n = get a0 0
for i ulong n
put pb i get g i
end
for j ulong len t
put pb add n j get t j
end
ret add n len t
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

fn same20 to bool
for i ulong 20
if ne get sx i get st i
ret false
end
end
ret true
end

note The new images of checks 2-4 and 8 (argument 1 selects the mode; every mode has argcnt 3).
fn mprog to int
n = argread 2 buf 0 len buf
if ne n 0
ret 71
end
if ne envcnt 0
ret 72
end
fd = fopen tnull 0 len tnull 0 0
if lt fd 0
ret 73
end
c = fclose int fd
ret 41
end

fn mpure to int
n = argread 2 buf 0 len buf
if ne n 0
ret 74
end
if ne envcnt 0
ret 75
end
if ne fopen tnull 0 len tnull 0 0 neg long 1
ret 76
end
ret 42
end

fn envis i ulong t view uchar * to bool
n = envread i buf 0 len buf
if ne n long len t
ret false
end
for j ulong len t
if ne get buf j get t j
ret false
end
end
ret true
end

fn menv to int
n = argread 2 buf 0 len buf
if ne n 0
ret 77
end
if ne envcnt 2
ret 78
end
if not envis 0 tea
ret 79
end
if not envis 1 teb
ret 80
end
ret 43
end

fn mlim to int
n = argread 2 lb 0 len lb
note Packet budget: u16 count, three u16 record lengths, argv0 and len tlim; the rest is the pattern.
want = sub ulong 65536 add ulong 2 add mul ulong 3 2 add len tlim get a0 0
if ne n long want
ret 81
end
for j ulong want
if ne get lb j uchar add rem j 26 97
ret 82
end
end
ret 44
end

note xcase w t past epast: a forked child runs execprog (w 0), execpure (1) or execenv (2) on
note [argv0, t, ""] in P; past 1 moves the last record's second length byte one byte past len P;
note epast 1 makes the environment slice ["LXA=1", "LXB=22"] in E one byte longer than E. The child's exit.
fn xcase w ulong t view uchar * past ulong epast ulong to ulong
pbeg
parg0
ptext t
if eq past 0
d = prec 0
else
pcnt 3
r = enlarge P add len P 1
end
s = get pn 0
n = add sub len P s past
ebeg
etext tea
etext teb
es = get qn 0
m = add sub len E es epast
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
if eq w 0
x1 = execprog P s n
end
if eq w 1
x2 = execpure P s n
end
if eq w 2
x3 = execenv P s n E es m
end
exit 90
end
ret reap pid
end

note xlim x: execprog on [argv0, "lim", pattern] of exactly 65536 + x bytes, all inside P; the child's exit.
fn xlim x ulong to ulong
pbeg
parg0
ptext tlim
room = sub ulong 65536 add ulong 2 add mul ulong 3 2 add len tlim get a0 0
ppat add room x
s = get pn 0
n = psz
if ne n add 65536 x
ret 999
end
if ne add s n len P
ret 998
end
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execprog P s n
exit 90
end
ret reap pid
end

note slim x sfx: symlnk on [pattern target, argv0 + sfx] of exactly 4096 + x bytes, all inside P; the
note child's exit (0 when the link was made, 90 on any returned syscall error, never errno-as-trap).
fn slim x ulong sfx view uchar * to ulong
lp = add get a0 0 len sfx
note Packet budget: u16 count and two u16 record lengths, then target and destination.
room = sub ulong 4096 add ulong 2 mul ulong 2 2
if ge lp room
ret 997
end
pbeg
ppat add sub room lp x
ppath sfx
s = get pn 0
n = psz
if ne n add 4096 x
ret 999
end
if ne add s n len P
ret 998
end
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = symlnk P s n
if ne r 0
exit 90
end
exit 0
end
ret reap pid
end

note ppast w: renames (w 0, flag 0), link (1) or symlnk (2) on [argv0 + ".qa", argv0 + ".qb"] with the
note slice one byte past len P, in a forked child; the child's exit.
fn ppast w ulong to ulong
pbeg
ppath tqa
ppath tqb
s = get pn 0
n = add psz 1
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
if eq w 0
x1 = renames P s n 0
end
if eq w 1
x2 = link P s n
end
if eq w 2
x3 = symlnk P s n
end
exit 90
end
ret reap pid
end

fn cren to int
m = spath tra
fd = fopen pb 0 m 194 384
if lt fd 0
ret 5
end
c = fclose int fd
k = stat pb 0 m st 0 128
if ne k 0
ret 5
end
pbeg
ppath tra
ppath trb
s = get pn 0
n = psz
r = renames P s n 1
if ne r 0
ret 5
end
k = stat pb 0 m sx 0 128
if ne k neg long 2
ret 5
end
m2 = spath trb
k = stat pb 0 m2 sx 0 128
if ne k 0
ret 5
end
if not same20
ret 5
end
m = spath tra
fd = fopen pb 0 m 194 384
if lt fd 0
ret 5
end
c = fclose int fd
r = renames P s n 1
if ne r neg long 17
ret 5
end
r = renames P s n 0
if ne r 0
ret 5
end
k = stat pb 0 m sx 0 128
if ne k neg long 2
ret 5
end
m2 = spath trb
r = unlink pb 0 m2
if ne r 0
ret 5
end
ret 0
end

fn clink to int
m = spath tlc
fd = fopen pb 0 m 194 384
if lt fd 0
ret 6
end
c = fclose int fd
k = stat pb 0 m st 0 128
if ne k 0
ret 6
end
pbeg
ppath tlc
ppath tld
s = get pn 0
n = psz
r = link P s n
if ne r 0
ret 6
end
m2 = spath tld
k = stat pb 0 m2 sx 0 128
if ne k 0
ret 6
end
if not same20
ret 6
end
if ne get sx 20 2
ret 6
end
r = link P s n
if ne r neg long 17
ret 6
end
r = unlink pb 0 m2
m = spath tlc
k = unlink pb 0 m
if or ne r 0 ne k 0
ret 6
end
ret 0
end

fn csym to int
pbeg
ptext tsym
ppath tse
s = get pn 0
n = psz
r = symlnk P s n
if ne r 0
ret 7
end
m = spath tse
k = readlnk pb 0 m rb 0 len rb
if ne k long len tsym
ret 7
end
for j ulong len tsym
if ne get rb j get tsym j
ret 7
end
end
r = symlnk P s n
if ne r neg long 17
ret 7
end
r = unlink pb 0 m
if ne r 0
ret 7
end
ret 0
end

fn c10 to int
if ne slim 0 tsl 0
ret 10
end
m = spath tsl
t = sub sub ulong 4096 add ulong 2 mul ulong 2 2 m
k = readlnk pb 0 m rb 0 len rb
if ne k long t
ret 10
end
for j ulong t
if ne get rb j uchar add rem j 26 97
ret 10
end
end
r = unlink pb 0 m
if ne r 0
ret 10
end
ret 0
end

fn c11 to int
got = slim 1 tsm
if ne got 103
z = spath tsm
u = unlink pb 0 z
ret 11
end
m = spath tsm
k = lstat pb 0 m st 0 128
if ne k neg long 2
ret 11
end
ret 0
end

fn main to int
n = argread 0 g 0 len g
if le n 0
ret 1
end
put a0 0 ulong n
if eq argcnt 3
if arg1is tprog
ret mprog
end
if arg1is tpure
ret mpure
end
if arg1is tenv
ret menv
end
if arg1is tlim
ret mlim
end
ret 70
end
if ne argcnt 1
ret 1
end
if ne xcase 0 tprog 0 0 41
ret 2
end
if ne xcase 1 tpure 0 0 42
ret 3
end
if ne xcase 2 tenv 0 0 43
ret 4
end
k = cren
if ne k 0
ret k
end
k = clink
if ne k 0
ret k
end
k = csym
if ne k 0
ret k
end
if ne xlim 0 44
ret 8
end
if ne xlim 1 103
ret 9
end
k = c10
if ne k 0
ret k
end
k = c11
if ne k 0
ret k
end
if ne xcase 0 tprog 1 0 103
ret 12
end
if ne xcase 1 tpure 1 0 103
ret 13
end
if ne xcase 2 tenv 1 0 103
ret 14
end
if ne xcase 2 tenv 0 1 103
ret 15
end
if ne ppast 0 103
ret 16
end
if ne ppast 1 103
ret 17
end
if ne ppast 2 103
ret 18
end
w = write 1 tok 0 len tok
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/host/hostpool/check.sh legacy packed-list word pool operand fixture

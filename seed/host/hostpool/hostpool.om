note SPDX-License-Identifier: Apache-2.0
note seed/host/hostpool/hostpool.om: run-time pools (global NAME T *, OMEGESE 9.15) as the byte operands of host
note words (fzcore round 3, lead item 5). Run by the OM-2 conductor through hostpool.cases. Parent exit = the
note number of the first failed check, 0 when all hold; its stdout is only the line of check 5's new image.
note 1 argread into a pool: argument 0 equals the same argument read into a sized global.
note 2 stat and fopen with the path in a pool and stat writing into a pool: device, inode and mode equal stat's
note   through a text path.
note 3 stale base: the count operand of stat is a call that grows the path pool and a blocker by 1 MiB each, so
note   the pool moves while the operands are read; stat still reads the moved path (base loaded after the operands).
note 4 a slice one byte past a pool's current length traps 3 in a child (exit 103).
note 5 a child raises soft RLIMIT_STACK to 64 MiB so the kernel accepts this fixture, then execfds-launches
note   argv and environment packets built in pools: [argv0, "big", 74 records of 65000 bytes] (4810148 bytes
note   and argv0, more than the 4194304-byte region obox had; a record is at most 65535 bytes, its u16 field) and ["A=1"]. The new image checks every byte and prints "big ok".
note 6 the same packets under a soft RLIMIT_STACK of 8 MiB: the kernel's E2BIG (child exit 100 + 7) is the only
note   refusal.
note With the argument "oracle": execfds /usr/bin/env with an environment of 70 entries built in a pool; the
note output is compared with env70.want, which seed/host/hostpool/oracle.py writes independently.
om2
global A uchar *
global E uchar *
global Q uchar *
global S uchar *
global B uchar *
global an ulong 2
global en ulong 2
global g uchar 4096
global st uchar 128
global lim uchar 32
global keep uchar 1
global status uchar 4
global buf uchar 64
text tbig "big"
text toracle "oracle"
text tnull "/dev/null"
text tenv "/usr/bin/env"
text tok "big ok\n"
text tone "A=1"

fn arg1is t view uchar * to bool
n = argread 1 buf 0 len buf
if ne n long len t
ret false
end
for i ulong len t
if ne get buf i get t i
ret false
end
end
ret true
end

fn aclear to void
r = enlarge A ulong 2
put A 0 0
put A 1 0
put an 0 2
put an 1 0
end

fn arec n ulong to ulong
o = get an 0
r = enlarge A add add o 2 n
put A o uchar and n 255
put A add o 1 uchar shr n 8
put an 0 add add o 2 n
c = add get an 1 1
put an 1 c
put A 0 uchar and c 255
put A 1 uchar shr c 8
ret add o 2
end

fn aarg0 to void
n = argread 0 g 0 len g
if le n 0
exit 90
end
d = arec ulong n
for i ulong ulong n
put A add d i get g i
end
end

fn atext t view uchar * to void
d = arec len t
for i ulong len t
put A add d i get t i
end
end

fn apat k ulong n ulong to void
d = arec n
for j ulong n
put A add d j uchar add rem add k j 26 97
end
end

fn eclear to void
r = enlarge E ulong 2
put E 0 0
put E 1 0
put en 0 2
put en 1 0
end

fn erec n ulong to ulong
o = get en 0
r = enlarge E add add o 2 n
put E o uchar and n 255
put E add o 1 uchar shr n 8
put en 0 add add o 2 n
c = add get en 1 1
put en 1 c
put E 0 uchar and c 255
put E 1 uchar shr c 8
ret add o 2
end

fn etext t view uchar * to void
d = erec len t
for i ulong len t
put E add d i get t i
end
end

note estr i: the entry "K<a><b>=<a><b>" with a = 'a' + i / 26 and b = 'a' + i % 26.
fn estr i ulong to void
d = erec 6
a = uchar add 97 div i 26
b = uchar add 97 rem i 26
put E d 75
put E add d 1 a
put E add d 2 b
put E add d 3 61
put E add d 4 a
put E add d 5 b
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

note gq: grow the path pool Q and the blocker B by 1 MiB each (mremap moves Q), then give n.
fn gq n ulong to ulong
r = enlarge Q add len Q 1048576
r = enlarge B add len B 1048576
ret n
end

fn same20 to bool
for i ulong 20
if ne get S i get st i
ret false
end
end
ret true
end

note bigexec stk: a forked child sets soft RLIMIT_STACK to stk and execenvs the check 5 packets; its exit.
fn bigexec stk ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = prlimit 0 3 lim 0 16
if ne r 0
exit 96
end
for i ulong 8
put lim i uchar and shr stk mul i 8 255
end
hard = ulong 0
for j ulong 8
hard = or hard shl ulong get lim add 8 j mul j 8
end
if lt hard stk
exit 95
end
r = prlimit 0 3 lim 0 32
if ne r 0
exit 97
end
aclear
aarg0
atext tbig
for k ulong 74
apat add k 2 65000
end
eclear
etext tone
r = execfds A 0 get an 0 E 0 get en 0 keep 0 0
exit int add 100 neg r
end
ret reap pid
end

note The new image of check 5: 76 arguments, arguments 2..75 of 65000 bytes with the pattern of apat.
fn bigchild to int
if ne argcnt 76
ret 61
end
r = enlarge B ulong 65536
for k ulong 74
i = add k 2
n = argread i B 0 len B
if ne n 65000
ret 62
end
for j ulong 65000
if ne get B j uchar add rem add i j 26 97
ret 63
end
end
end
w = write 1 tok 0 len tok
ret 0
end

fn oracle to int
eclear
for i ulong 70
estr i
end
aclear
atext tenv
r = execfds A 0 get an 0 E 0 get en 0 keep 0 0
ret int add 100 neg r
end

fn check1 to int
r = enlarge B ulong 4096
r = enlarge Q ulong 4096
n = argread 0 Q 0 len Q
m = argread 0 g 0 len g
if or le n 0 ne n m
ret 1
end
for i ulong ulong n
if ne get Q i get g i
ret 1
end
end
ret 0
end

fn check2 to int
for i ulong len tnull
put Q i get tnull i
end
r = enlarge S ulong 128
k = stat Q 0 len tnull S 0 128
k2 = stat tnull 0 len tnull st 0 128
if or ne k 0 ne k2 0
ret 2
end
if not same20
ret 2
end
fd = fopen Q 0 len tnull 0 0
if lt fd 0
ret 2
end
c = fclose int fd
ret 0
end

fn check3 to int
for i ulong 128
put S i 0
end
k = stat Q 0 gq len tnull S 0 128
if ne k 0
ret 3
end
if not same20
ret 3
end
if lt len Q 1048576
ret 3
end
ret 0
end

fn check4 to int
pid = fork
if lt pid 0
ret 4
end
if eq pid 0
k = stat Q sub len Q 4 5 S 0 128
exit 0
end
if ne reap pid 103
ret 4
end
ret 0
end

fn main to int
if eq argcnt 2
if arg1is toracle
ret oracle
end
end
if ge argcnt 2
if arg1is tbig
ret bigchild
end
end
k = check1
if ne k 0
ret k
end
k = check2
if ne k 0
ret k
end
k = check3
if ne k 0
ret k
end
k = check4
if ne k 0
ret k
end
if ne bigexec 67108864 0
ret 5
end
if ne bigexec 8388608 107
ret 6
end
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/host/hostpool/check.sh host-word pool admission fixture
note gate-pools: uses execfds on purpose: owner=seed/host/hostpool/check.sh new-word acceptance or refusal qualification

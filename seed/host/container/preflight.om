note TEST INSTRUMENT: malformed mount/pivroot packets far larger than the 65536-byte static decode region.
note Every mode must trap 3 during framing preflight, with no decode mmap and no requested syscall
note (seed/host/container/check.sh counts both under strace). Modes, one byte argument:
note  m  mount: valid records followed by a large trailing slice (100000 bytes)
note  p  pivroot: the same
note  c  mount: five well-framed 19000-byte records (95012 bytes): the record count 3..4 is wrong
note  q  pivroot: three well-framed 19000-byte records (57008 bytes): the record count 2 is wrong
note  l  mount: the count says 4 but only three 19000-byte records are supplied (57008 bytes): a lying count
note  r  pivroot: the count says 2 but only one 19000-byte record is supplied (19004 bytes): a lying count
global a uchar 100000
global arg uchar 1
note fill: count field cnt, then recs records of l bytes of 'x'; returns the packet length
fn fill cnt ulong recs ulong l ulong to ulong
put a 0 uchar and cnt 255
put a 1 uchar shr cnt 8
o = ulong 2
for k ulong recs
put a o uchar and l 255
put a add o 1 uchar shr l 8
o = add o 2
for j ulong l
put a add o j 120
end
o = add o l
end
ret o
end
fn main to int
n = argread 1 arg 0 1
if ne n long 1
ret 90
end
m = get arg 0
if eq m uchar 99
k = fill 5 5 19000
r = mount a 0 k 0
ret int r
end
if eq m uchar 113
k = fill 3 3 19000
r = pivroot a 0 k
ret int r
end
if eq m uchar 108
k = fill 4 3 19000
r = mount a 0 k 0
ret int r
end
if eq m uchar 114
k = fill 2 1 19000
r = pivroot a 0 k
ret int r
end
put a 0 2
put a 2 1
put a 4 120
put a 5 1
put a 7 121
if eq m uchar 109
put a 0 3
put a 8 1
put a 10 122
r = mount a 0 len a 0
ret int r
end
if eq m uchar 112
r = pivroot a 0 len a
ret int r
end
ret 90
end
note gate-pools: uses mount on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification
note gate-pools: uses pivroot on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification

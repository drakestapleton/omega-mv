note seed/host/container/offsets.om: the container words at a nonzero offset, through view and edit parameters and
note with run-time lengths (review omega-mv-9e064822 "Not checked": nonzero-offset/dynamic-view coverage). Runs
note without privilege. Exit = the first failed check, 0 when all hold.
note 1 capget through an edit parameter at offset 8: returns 0, writes exactly A[8..40) (the version stays, the
note   data words of an unprivileged process are 0), A[0..8) and A[40..48) keep their 0xAA poison.
note 2 opentree through a view parameter at offset 2 with a run-time length: "/proc" (5) gives a descriptor; "/pro"
note   (4, the same bytes cut one short) gives -2 (ENOENT), so the kernel saw exactly the slice.
note 3 sigmask then sigwait through a view parameter at offset 8 (SIGUSR1 in the set): after a SIGUSR1 to itself,
note   sigwait returns 10.
note 4 mount of a packed list (none, /, tmpfs) at offset 5 through a view parameter: it reaches the kernel
note   (unprivileged: -1, EPERM); the
note   same call at offset 6 is malformed framing and traps 3 in a child (exit 103).
om2
global st uchar 4
text tproc "xx/proc"
fn capv t edit uchar * to long
r = capget t 8 32
ret r
end
fn treev t view uchar * n ulong to long
r = opentree t 2 n 524288
ret r
end
fn sigv t view uchar * to long
r = sigmask 0 t 8 8
if ne r 0
ret -100
end
k = killpid int getpid 10
w = sigwait t 8 8
ret w
end
fn mountv t view uchar * off ulong n ulong to long
r = mount t off n 0
ret r
end
fn check1 to int
a = new uchar 48 0
for i ulong 48
put a i 170
end
put a 8 34
put a 9 5
put a 10 8
put a 11 32
put a 12 0
put a 13 0
put a 14 0
put a 15 0
r = capv a
if ne r 0
ret 1
end
for i ulong 8
if ne get a i 170
ret 1
end
end
for j ulong 8
if ne get a add 40 j 170
ret 1
end
end
if or ne get a 8 34 ne get a 11 32
ret 1
end
for k ulong 24
if ne get a add 16 k 0
ret 1
end
end
ret 0
end
fn check2 to int
a = new uchar 16 0
for i ulong len tproc
put a i get tproc i
end
n = ulong 5
fd = treev a n
if lt fd 0
ret 2
end
c = fclose int fd
r = treev a sub n 1
if ne r -2
ret 2
end
ret 0
end
fn check3 to int
a = new uchar 24 0
put a 9 2
w = sigv a
if ne w 10
ret 3
end
ret 0
end
fn check4 to int
a = new uchar 64 0
put a 5 3
p = ulong 7
put a p 4
put a add p 2 110
put a add p 3 111
put a add p 4 110
put a add p 5 101
p = add p 6
put a p 1
put a add p 2 47
p = add p 3
put a p 5
put a add p 2 116
put a add p 3 109
put a add p 4 112
put a add p 5 102
put a add p 6 115
p = add p 7
n = sub p 5
r = mountv a 5 n
if ne r -1
ret 4
end
pid = fork
if eq pid 0
r = mountv a 6 n
exit 0
end
q = waitpid int pid st 0 4 0
if ne get st 1 103
ret 4
end
ret 0
end
fn main to int
k = check1
if ne k 0
ret k
end
k = check2
if ne k 0
ret k
end
k = check3
if ne k 0
ret k
end
k = check4
if ne k 0
ret k
end
ret 0
end
note gate-pools: uses capget on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification
note gate-pools: uses opentree on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification
note gate-pools: uses sigmask on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification
note gate-pools: uses sigwait on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification
note gate-pools: uses mount on purpose: owner=seed/host/container/check.sh new-word acceptance or refusal qualification

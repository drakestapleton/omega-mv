# SPDX-License-Identifier: Apache-2.0
# seed/host/container/container.cases: container words 207..214 (unshare, mount, umount, pivroot, sethost,
# prctl, sigmask, sigwait), unprivileged part, run by the OM-2 conductor (seed/qualification/om2/gate.om)
# from seed/host/container/check.sh, which requires every case to pass. ctl-simple: simple.om (unshare 0 is a no-op,
# 0) runs on AArch64, the control for the x86 refusals.
# user: container.om without privilege; every word returns exactly what oracle.py (Python ctypes, the same
# syscalls) returns; check.sh regenerates the oracle output and compares it with user.want first.
# badmount/badpiv: a packet with the wrong record count traps 3 (exit 103) before any kernel call.
# Refusals: function mode 9, contract clause 30, x86linux and x86efi 25, long flags 7, ulong array 7.
# Count mutants: with the record-count check removed from omc.om the same programs reach the kernel and
# exit 1, so the bad-count cases detect them. The privileged part (root mode, oracle parity as root and
# the syscall mutants) is in check.sh, because it needs sudo.
deadline 60
user run seed/host/container/container.om - file:seed/host/container/user.want - 0 user
badmount run seed/host/container/container.om - - - 103 badmount
badpiv run seed/host/container/container.om - - - 103 badpiv
# bigpacket: three 30000-byte records (a 90008-byte packet) reach the kernel, which refuses them (EINVAL, as the
# same call through Python ctypes, test instrument, shows on this host):
# the compiler has no packet bound of its own.
bigpacket run seed/host/container/container.om - file:seed/host/container/bigpacket.want - 0 bigpacket
# Large caller-owned malformed packets fail framing before any decode allocation.
preflight-mount run seed/host/container/preflight.om - - - 103 m
preflight-pivroot run seed/host/container/preflight.om - - - 103 p
preflight-mount-count run seed/host/container/preflight.om - - - 103 c
preflight-pivroot-count run seed/host/container/preflight.om - - - 103 q
preflight-mount-lying run seed/host/container/preflight.om - - - 103 l
preflight-pivroot-lying run seed/host/container/preflight.om - - - 103 r
fnmode refuse seed/host/container/fnmode.om 9
contract refuse seed/host/container/contract.om 30
x86 refuse seed/host/container/x86.om+seed/host/container/simple.om 25
# Under target x86linux a function unit (OM-1 or OM-2) reaches the function-mode refusal (9) before the range refusal (25).
x86-fnmode refuse seed/host/container/x86-fnmode.om 9
x86-fnmode-om2 refuse seed/host/container/x86-fnmode-om2.om 9
efi refuse seed/host/container/efi.om+seed/host/container/simple.om 25
longflags refuse seed/host/container/longflags.om 7
wordarr refuse seed/host/container/wordarr.om 7
subst seed/host/container/mutants/mount-count.from seed/host/container/mutants/mount-count.to
cc seed/omc/omc.om
mut-mount-count run seed/host/container/container.om - - - 1 badmount
cc pinned
subst seed/host/container/mutants/pivroot-count.from seed/host/container/mutants/pivroot-count.to
cc seed/omc/omc.om
mut-pivroot-count run seed/host/container/container.om - - - 1 badpiv
cc pinned
# capview (review omega-mv-9e064822 finding 8): capset needs a writable header, because the kernel stores its
# preferred version into an unknown one before -22; through a view it is error 20. capw: the writable control,
# a zero version comes back as 0x20080522 with -22, then capget succeeds. Mutant capset-view (capset admits a view
# again, as at 9e064822): capview compiles and the view parameter's byte 0 changes to 34.
capview refuse seed/host/container/capview.om 20
capw run seed/host/container/capw.om - - - 0
subst seed/host/container/mutants/capset-view.from seed/host/container/mutants/capset-view.to
cc seed/omc/omc.om
mut-capset-view run seed/host/container/capview.om - - - 34
cc pinned
# offsets: every word family at a nonzero offset through view and edit parameters with run-time lengths (capget,
# opentree, sigmask and sigwait, mount; see offsets.om), unprivileged.
offsets run seed/host/container/offsets.om - - - 0
ctl-simple run seed/host/container/simple.om - - - 0

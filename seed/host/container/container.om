om2
note seed/host/container/container.om: fixture for the container host words 207..214 (unshare, mount, umount,
note pivroot, sethost, prctl, sigmask, sigwait). argv: MODE DIR. MODE root runs every word in a private mount and
note UTS namespace (run it as root: check.sh uses sudo -n) and checks each result; MODE user runs the same words
note without privilege. Every result is printed as "name value" on stdout, which check.sh compares byte for byte
note with oracle.py (the same syscalls through Python ctypes). Exit 0 means every check held; otherwise the exit
note status is the number of the first failed check. MODE badmount and badpiv pass a packet with the wrong record
note count, which must trap 3 (exit 103) before any kernel call.
global ob uchar 8192
global obn ulong 1
global sb uchar 4096
global sbn ulong 1
global pk uchar 131072
global pkn ulong 1
global dir uchar 4096
global dirn ulong 1
global rb uchar 8192
global rbn ulong 1
global st uchar 128
global ss uchar 8
global wt uchar 8
global pf uchar 8
text tnone "none"
text troot "/"
text ttmpfs "tmpfs"
text topts "size=1m,mode=755"
text tnew "/new"
text told "old"
text tdot "."
text toldp "/old"
text tmiss "/missing/x"
text thost "obox-gate"
text thostf "/proc/sys/kernel/hostname"
text thostnl "obox-gate\n"
text tstatus "/proc/self/status"
text tnnp "NoNewPrivs:\t1\n"
text tblk "SigBlk:\t0000000000000200\n"
text mroot "root"
text muser "user"
text mbadm "badmount"
text mbadp "badpiv"
text mbig "bigpacket"
text n_mount_bigpacket "mount-bigpacket"
text n_mount_long_paths "mount-long-paths"
text n_mount_path_4096 "mount-path-4096"
text n_pivroot_long_paths "pivroot-long-paths"
text n_mount_private "mount-private"
text n_mount_tmpfs "mount-tmpfs"
text n_mount_missing "mount-missing"
text n_makedir_new "makedir-new"
text n_mount_bind "mount-bind"
text n_sethost "sethost"
text n_hostname_bytes "hostname-bytes"
text n_sethost_65 "sethost-65"
text n_pivroot_missing "pivroot-missing"
text n_pivroot "pivroot"
text n_stat_old_dir "stat-old-dir"
text n_umount_detach "umount-detach"
text n_stat_after_detach "stat-after-detach"
text n_umount_not_mounted "umount-not-mounted"
text n_prctl_op2_refused "prctl-op2-refused"
text n_prctl_subreaper "prctl-subreaper"
text n_pdeathsig_parent_exit "pdeathsig-parent-exit"
text n_pdeathsig_grandchild_signal "pdeathsig-grandchild-signal"
text n_prctl_nonewprivs "prctl-nonewprivs"
text n_sigmask_block_usr1 "sigmask-block-usr1"
text n_sigmask_size4 "sigmask-size4"
text n_sigwait "sigwait"
text n_sigwait_size4 "sigwait-size4"
text n_unshare_bad_flag "unshare-bad-flag"
text n_unshare_ns_uts "unshare-ns-uts"
text n_umount_root "umount-root"

fn outc c uchar to void
n = get obn 0
put ob n c
put obn 0 add n 1
end

fn outt t view uchar * to void
i = ulong 0
while lt i len t bound 4096
outc get t i
i = add i 1
end
end

fn outl v long to void
d = new uchar 24 0
u = ulong 0
if lt v 0
outc uchar 45
u = ulong neg v
else
u = ulong v
end
k = ulong 0
while true bound 24
put d k uchar add 48 rem u 10
k = add k 1
u = div u 10
if eq u 0
break
end
end
while gt k 0 bound 24
k = sub k 1
outc get d k
end
end

fn line t view uchar * v long to void
outt t
outc uchar 32
outl v
outc uchar 10
end

fn flush to void
n = get obn 0
k = write 1 ob 0 n
put obn 0 0
end

fn fail c int to void
flush
exit c
end

fn ck c int ok bool to void
if not ok
fail c
end
end

fn sbclr to void
put sbn 0 0
end

fn sbc c uchar to void
n = get sbn 0
put sb n c
put sbn 0 add n 1
end

fn sbt t view uchar * to void
i = ulong 0
while lt i len t bound 4096
sbc get t i
i = add i 1
end
end

fn sbdir to void
i = ulong 0
n = get dirn 0
while lt i n bound 4096
sbc get dir i
i = add i 1
end
end

fn pkinit c ulong to void
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
put pkn 0 2
end

fn pksb to void
n = get pkn 0
m = get sbn 0
put pk n uchar and m 255
put pk add n 1 uchar shr m 8
i = ulong 0
while lt i m bound 4096
put pk add add n 2 i get sb i
i = add i 1
end
put pkn 0 add add n 2 m
end

note pklong n: append a record of n bytes "/a/a/a..." (byte i is "/" for even i, "a" for odd i): every component is
note one byte, so the kernel judges only the whole path length (PATH_MAX), never NAME_MAX.
fn pklong n ulong to void
m = get pkn 0
put pk m uchar and n 255
put pk add m 1 uchar shr n 8
i = ulong 0
while lt i n bound 65535
c = uchar 97
if eq rem i 2 0
c = uchar 47
end
put pk add add m 2 i c
i = add i 1
end
put pkn 0 add add m 2 n
end

note longpaths: legal paths whose packet is larger than 4096 bytes must reach the kernel (no trap 3); a
note 4096-byte path is the kernel's ENAMETOOLONG, not ours.
fn longpaths to void
pkinit 3
pklong 4095
pklong 4095
pkt tnone
r = mount pk 0 get pkn 0 0
line n_mount_long_paths r
pkinit 3
pklong 2
pklong 4096
pkt tnone
r = mount pk 0 get pkn 0 0
line n_mount_path_4096 r
pkinit 2
pklong 4095
pklong 4095
r = pivroot pk 0 get pkn 0
line n_pivroot_long_paths r
end

fn pkt t view uchar * to void
sbclr
sbt t
pksb
end

fn pkdir t view uchar * to void
sbclr
sbdir
sbt t
pksb
end

note readf: read the file named by sb into rb; return the byte count.
fn readf to long
fd = fopen sb 0 get sbn 0 0 0
if lt fd 0
ret fd
end
n = read int fd rb 0 8192
put rbn 0 ulong n
c = fclose int fd
ret n
end

note rbhas t: does rb hold the bytes of t?
fn rbhas t view uchar * to bool
n = get rbn 0
m = len t
if lt n m
ret false
end
i = ulong 0
while le add i m n bound 8192
j = ulong 0
while lt j m bound 4096
if ne get rb add i j get t j
break
end
j = add j 1
end
if eq j m
ret true
end
i = add i 1
end
ret false
end

fn argeq i ulong t view uchar * to bool
b = new uchar 64 0
n = argread i b 0 64
if ne n long len t
ret false
end
k = ulong 0
while lt k len t bound 64
if ne get b k get t k
ret false
end
k = add k 1
end
ret true
end

fn readdir to void
n = argread 2 dir 0 4096
ck 90 gt n 0
put dirn 0 ulong n
end

note mounts: make / private, then a tmpfs on DIR, then a missing target, then a bind of DIR/new onto itself.
fn mounts to void
pkinit 3
pkt tnone
pkt troot
pkt tnone
r = mount pk 0 get pkn 0 278528
line n_mount_private r
ck 10 eq r 0
pkinit 4
pkt ttmpfs
sbclr
sbdir
pksb
pkt ttmpfs
pkt topts
r = mount pk 0 get pkn 0 0
line n_mount_tmpfs r
ck 11 eq r 0
pkinit 3
pkt ttmpfs
pkdir tmiss
pkt ttmpfs
r = mount pk 0 get pkn 0 0
line n_mount_missing r
ck 12 eq r -2
sbclr
sbdir
sbt tnew
r = makedir sb 0 get sbn 0 493
line n_makedir_new r
ck 13 eq r 0
pkinit 3
pkdir tnew
pkdir tnew
pkt tnone
r = mount pk 0 get pkn 0 4096
line n_mount_bind r
ck 14 eq r 0
end

fn hostname to void
sbclr
sbt thost
r = sethost sb 0 get sbn 0
line n_sethost r
ck 20 eq r 0
sbclr
sbt thostf
n = readf
line n_hostname_bytes n
ck 21 rbhas thostnl
sbclr
i = ulong 0
while lt i 65 bound 65
sbc uchar 97
i = add i 1
end
r = sethost sb 0 65
line n_sethost_65 r
ck 22 eq r -22
end

note pivot: DIR/new is a bind mount; chdir there, pivot_root(".", "old"), see the old root under /old,
note detach it, then /old is an empty directory that is not a mount point.
fn pivot to void
sbclr
sbdir
sbt tnew
sbt toldp
r = makedir sb 0 get sbn 0 493
ck 30 eq r 0
sbclr
sbdir
sbt tnew
r = chdir sb 0 get sbn 0
ck 31 eq r 0
pkinit 2
pkt tdot
pkt tmiss
r = pivroot pk 0 get pkn 0
line n_pivroot_missing r
ck 32 eq r -2
pkinit 2
pkt tdot
pkt told
r = pivroot pk 0 get pkn 0
line n_pivroot r
ck 33 eq r 0
sbclr
sbt toldp
sbdir
r = stat sb 0 get sbn 0 st 0 128
line n_stat_old_dir r
ck 34 eq r 0
r = umount toldp 0 len toldp 2
line n_umount_detach r
ck 35 eq r 0
r = stat sb 0 get sbn 0 st 0 128
line n_stat_after_detach r
ck 36 eq r -2
r = umount toldp 0 len toldp 0
line n_umount_not_mounted r
ck 37 eq r -22
end

fn prctls to void
r = prctl 2 0
line n_prctl_op2_refused r
ck 40 eq r -22
r = prctl 36 1
line n_prctl_subreaper r
ck 41 eq r 0
r = pipefds pf 0 8 0
ck 42 eq r 0
c = fork
if eq c 0
g = fork
if eq g 0
r = prctl 1 9
w = int get pf 4
k = write w pf 0 1
r = sleepns 10000000000
exit 9
end
k = read int get pf 0 wt 0 1
exit 0
end
k = waitpid int c wt 0 4 0
line n_pdeathsig_parent_exit long get wt 1
r = waitpid -1 wt 0 4 0
line n_pdeathsig_grandchild_signal long and get wt 0 127
ck 43 eq get wt 0 9
r = prctl 38 1
line n_prctl_nonewprivs r
ck 44 eq r 0
sbclr
sbt tstatus
n = readf
ck 45 rbhas tnnp
end

fn sigs to void
put ss 1 2
r = sigmask 0 ss 0 8
line n_sigmask_block_usr1 r
ck 50 eq r 0
sbclr
sbt tstatus
n = readf
ck 51 rbhas tblk
r = sigmask 0 ss 0 4
line n_sigmask_size4 r
ck 52 eq r -22
p = int getpid
r = killpid p 10
ck 53 eq r 0
r = sigwait ss 0 8
line n_sigwait r
ck 54 eq r 10
r = sigwait ss 0 4
line n_sigwait_size4 r
ck 55 eq r -22
end

global cg uchar 32
global ma uchar 32
text ttgt "/tgt"
text tw "/w"
text tneww "/new/w"
text n_capget "capget"
text n_capget_n31 "capget-n31"
text n_capget_eff_lo "capget-eff-lo"
text n_capget_eff_hi "capget-eff-hi"
text n_capget_prm_lo "capget-prm-lo"
text n_capget_inh_lo "capget-inh-lo"
text n_capbset_read_0 "capbset-read-0"
text n_capbset_read_4096 "capbset-read-4096"
text n_get_nnp "get-nnp"
text n_capset_4fb "capset-4fb"
text n_capset_raise "capset-raise"
text n_opentree_ok "opentree-ok"
text n_opentree_missing "opentree-missing"
text n_mntattr_ro "mntattr-ro"
text n_mntattr_size8 "mntattr-size8"
text n_tgt_ok "tgt-open-ok"
text n_mntmove "mntmove"
text n_mntmove_badfd "mntmove-badfd"
text n_write_tgt "write-tgt"
text n_write_new_ok "write-new-ok"

fn b2l b bool to long
if b
ret 1
end
ret 0
end

fn cginit to void
i = ulong 0
while lt i 32 bound 32
put cg i 0
i = add i 1
end
put cg 0 34
put cg 1 5
put cg 2 8
put cg 3 32
end

fn cgu i ulong to long
lo = or ulong get cg i shl ulong get cg add i 1 8
hi = or shl ulong get cg add i 2 16 shl ulong get cg add i 3 24
ret long or lo hi
end

fn cgset i ulong v ulong to void
put cg i uchar and v 255
put cg add i 1 uchar and shr v 8 255
put cg add i 2 uchar and shr v 16 255
put cg add i 3 uchar and shr v 24 255
end

note capsread: capget of this process (full root capabilities in root mode, none in user mode), the bounding-set
note read for cap 0 and for 4096 (beyond cap_last_cap: -22) and GET_NO_NEW_PRIVS.
fn capsread base int to void
cginit
r = capget cg 0 32
line n_capget r
ck add base 1 eq r 0
line n_capget_eff_lo cgu 8
line n_capget_eff_hi cgu 20
line n_capget_prm_lo cgu 12
line n_capget_inh_lo cgu 16
r = capget cg 0 31
line n_capget_n31 r
ck add base 2 eq r -22
r = prctl 23 0
line n_capbset_read_0 r
ck add base 3 eq r 1
r = prctl 23 4096
line n_capbset_read_4096 r
ck add base 4 eq r -22
r = prctl 39 0
line n_get_nnp r
end

note capsdrop: capset effective = permitted = 0x4fb, inheritable 0; capget reads it back; raising again is EPERM.
fn capsdrop base int to void
cginit
cgset 8 1275
cgset 12 1275
r = capset cg 0 32
line n_capset_4fb r
cginit
r = capget cg 0 32
line n_capget_eff_lo cgu 8
line n_capget_prm_lo cgu 12
cginit
cgset 8 4294967295
cgset 12 4294967295
r = capset cg 0 32
line n_capset_raise r
ck base eq r -1
end

note newapi: detached-mount words on the scratch tmpfs: a clone of DIR/new made read-only by descriptor
note and attached by descriptor onto DIR/tgt; writes through tgt are EROFS, the original stays writable.
fn newapi to void
sbclr
sbdir
sbt tnew
fd = opentree sb 0 get sbn 0 524289
line n_opentree_ok b2l ge fd 0
ck 70 ge fd 0
sbclr
sbdir
sbt tmiss
r = opentree sb 0 get sbn 0 524289
line n_opentree_missing r
ck 71 eq r -2
put ma 0 1
r = mntattr int fd ma 0 32
line n_mntattr_ro r
ck 72 eq r 0
r = mntattr int fd ma 0 8
line n_mntattr_size8 r
ck 73 eq r -22
sbclr
sbdir
sbt ttgt
r = makedir sb 0 get sbn 0 493
t = fopen sb 0 get sbn 0 2637824 0
line n_tgt_ok b2l ge t 0
ck 74 ge t 0
r = mntmove int fd int t
line n_mntmove r
ck 75 eq r 0
r = mntmove -1 int t
line n_mntmove_badfd r
ck 76 eq r -9
sbclr
sbdir
sbt ttgt
sbt tw
w = fopen sb 0 get sbn 0 577 420
line n_write_tgt w
ck 77 eq w -30
sbclr
sbdir
sbt tneww
w2 = fopen sb 0 get sbn 0 577 420
line n_write_new_ok b2l ge w2 0
ck 78 ge w2 0
end

fn rootmode to void
r = unshare 1
line n_unshare_bad_flag r
ck 1 eq r -22
r = unshare 67239936
line n_unshare_ns_uts r
ck 2 eq r 0
hostname
capsread 80
mounts
newapi
prctls
r = prctl 39 0
line n_get_nnp r
ck 89 eq r 1
sigs
pivot
capsdrop 85
end

fn usermode to void
r = unshare 67239936
line n_unshare_ns_uts r
ck 60 eq r -1
r = sethost thost 0 len thost
line n_sethost r
ck 61 eq r -1
pkinit 3
pkt tnone
pkt troot
pkt tnone
r = mount pk 0 get pkn 0 278528
line n_mount_private r
ck 62 eq r -1
r = umount troot 0 len troot 2
line n_umount_root r
ck 63 eq r -1
pkinit 2
pkt tdot
pkt tdot
r = pivroot pk 0 get pkn 0
line n_pivroot r
ck 64 eq r -1
capsread 90
r = prctl 38 1
line n_prctl_nonewprivs r
ck 65 eq r 0
r = prctl 39 0
line n_get_nnp r
ck 97 eq r 1
capsdrop 95
put ss 1 2
r = sigmask 0 ss 0 8
line n_sigmask_block_usr1 r
ck 66 eq r 0
p = int getpid
r = killpid p 10
r = sigwait ss 0 8
line n_sigwait r
ck 67 eq r 10
longpaths
end

fn main to int
if argeq 1 mroot
readdir
rootmode
flush
ret 0
end
if argeq 1 muser
usermode
flush
ret 0
end
if argeq 1 mbadm
pkinit 2
pkt tnone
pkt troot
r = mount pk 0 get pkn 0 0
ret 1
end
if argeq 1 mbig
pkinit 3
pklong 30000
pklong 30000
pklong 30000
r = mount pk 0 get pkn 0 0
line n_mount_bigpacket r
flush
ret 0
end
if argeq 1 mbadp
pkinit 3
pkt tdot
pkt told
pkt told
r = pivroot pk 0 get pkn 0
ret 1
end
ret 99
end

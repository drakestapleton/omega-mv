# SPDX-License-Identifier: Apache-2.0
# seed/host/sigfd/sigfd.cases: sigmask (keyword 241) and sigfd (keyword 242), run by the OM-2
# conductor (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=17.
# fixture: sigfd.om on AArch64, behavioral checks (parent exit 0 = every check holds; see its notes).
# sigblk: sigblk.om on AArch64, the mask read back from /proc/self/status SigBlk.
# x86-fixture, x86-sigblk: the same sources for x86linux through binfmt qemu-x86_64 (emulator
# evidence, not hardware qualification).
# Each mutant compiler is built from seed/omc/omc.om with one emission changed; the fixture built by
# it must fail at the named check (exit = check number).
deadline 120
fixture run seed/host/sigfd/sigfd.om - - - 0
sigblk run seed/host/sigfd/sigblk.om - - - 0
x86-fixture run seed/host/sigfd/x86-target.om+seed/host/sigfd/sigfd.om - - - 0
x86-sigblk run seed/host/sigfd/x86-target.om+seed/host/sigfd/sigblk.om - - - 0
fnmode refuse seed/host/sigfd/fnmode.om 9
fnmode-mask refuse seed/host/sigfd/fnmode-mask.om 9
x86-fnmode refuse seed/host/sigfd/x86-target.om+seed/host/sigfd/fnmode.om 9
contract refuse seed/host/sigfd/contract.om 30
contract-mask refuse seed/host/sigfd/contract-mask.om 30
longhow refuse seed/host/sigfd/longhow.om 7
efi refuse seed/host/sigfd/efi-target.om+seed/host/sigfd/use.om 25
subst seed/host/sigfd/mutants/a64-size.from seed/host/sigfd/mutants/a64-size.to
cc seed/omc/omc.om
mut-a64-size run seed/host/sigfd/sigfd.om - - - 1
cc pinned
subst seed/host/sigfd/mutants/a64-ncheck.from seed/host/sigfd/mutants/a64-ncheck.to
cc seed/omc/omc.om
mut-a64-ncheck run seed/host/sigfd/sigfd.om - - - 10
cc pinned
subst seed/host/sigfd/mutants/a64-cloexec.from seed/host/sigfd/mutants/a64-cloexec.to
cc seed/omc/omc.om
mut-a64-cloexec run seed/host/sigfd/sigfd.om - - - 7
cc pinned
subst seed/host/sigfd/mutants/x86-size.from seed/host/sigfd/mutants/x86-size.to
cc seed/omc/omc.om
mut-x86-size run seed/host/sigfd/x86-target.om+seed/host/sigfd/sigfd.om - - - 1
cc pinned
subst seed/host/sigfd/mutants/x86-ncheck.from seed/host/sigfd/mutants/x86-ncheck.to
cc seed/omc/omc.om
mut-x86-ncheck run seed/host/sigfd/x86-target.om+seed/host/sigfd/sigfd.om - - - 10
cc pinned
subst seed/host/sigfd/mutants/x86-cloexec.from seed/host/sigfd/mutants/x86-cloexec.to
cc seed/omc/omc.om
mut-x86-cloexec run seed/host/sigfd/x86-target.om+seed/host/sigfd/sigfd.om - - - 7
cc pinned

note SPDX-License-Identifier: Apache-2.0
note seed/host/sigfd/sigblk.om: fixture for sigmask (keyword 241) read back through the kernel's own
note report, the SigBlk line of /proc/self/status (16 hex digits). Run by the OM-2 conductor through
note seed/host/sigfd/sigfd.cases on AArch64 and for x86linux through qemu-x86_64, where SigBlk also
note showed the guest mask (emulator evidence only, not hardware qualification).
note Checks (parent exit = number of the first failed check, 0 when all hold):
note 1 SigBlk starts at 0.
note 2 sigmask 0 (SIG_BLOCK) TERM: returns 0 and SigBlk is 0000000000004000.
note 3 a forked child reads SigBlk 4000 (inherited across fork).
note 4 a forked child runs sigmask 1 (SIG_UNBLOCK) TERM and execx's this program: the new image reads
note   SigBlk 0 (exit 0; 61 otherwise).
note 5 negative control for 4: the same child without the unblock: the new image reads 4000 (exit 62).
note 6 sigmask 1 TERM in the parent: returns 0 and SigBlk is 0 again.
note 7 sigmask 2 (SIG_SETMASK) TERM sets SigBlk 4000; sigmask 2 with the empty set clears it to 0.
om2
text cms "b"
text marker "omega-sigblk"
text proc "/proc/self/status"
text key "SigBlk:"
global set uchar 8
global none uchar 8
global argv uchar 4096
global envp uchar 16
global buf uchar 8192
global status uchar 4

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

note Read /proc/self/status into buf; returns its length (0 when unreadable).
fn slurp to ulong
fd = fopen proc 0 len proc 0 0
if lt fd 0
ret 0
end
n = ulong 0
for t ulong 64
r = read int fd buf n sub len buf n
if le r 0
break
end
n = add n ulong r
end
c = fclose int fd
ret n
end

note 1 when the key matches buf at i.
fn keyat i ulong to ulong
for j ulong len key
if ne get buf add i j get key j
ret 0
end
end
ret 1
end

note The 16 hexadecimal digits after the key and its tabs at i; 18446744073709551615 when malformed.
fn hexat i ulong n ulong to ulong
bad = ulong 18446744073709551615
p = add i len key
while lt p n
if ne get buf p 9
break
end
p = add p 1
end
if gt add p 16 n
ret bad
end
v = ulong 0
for k ulong 16
d = ulong get buf add p k
if and ge d 48 le d 57
v = or shl v 4 sub d 48
else
if and ge d 97 le d 102
v = or shl v 4 sub d 87
else
ret bad
end
end
end
ret v
end

note SigBlk of this process as a number; 18446744073709551615 when unreadable.
fn sigblk to ulong
n = slurp
if lt n 24
ret 18446744073709551615
end
for i ulong sub n 24
if eq keyat i 1
ret hexat i n
end
end
ret 18446744073709551615
end

note Append one u16-length record buf[0..n) to argv at pos; returns the new end.
fn rec pos ulong n ulong to ulong
put argv pos uchar and n 255
put argv add pos 1 uchar shr n 8
for i ulong n
put argv add add pos 2 i get buf i
end
ret add add pos 2 n
end

note argv packet [path, marker, "b"] and environment ["A=1"]; returns the argv length.
fn mkexec to ulong
put argv 0 3
put argv 1 0
n = argread 0 buf 0 len buf
if le n 0
exit 90
end
pos = rec 2 ulong n
for i ulong len marker
put buf i get marker i
end
pos = rec pos len marker
put buf 0 get cms 0
put envp 0 1
put envp 1 0
put envp 2 3
put envp 3 0
put envp 4 65
put envp 5 61
put envp 6 49
ret rec pos 1
end

note A forked child: mode 0 reports SigBlk == 4000; mode 1 unblocks TERM then execx; mode 2 execx only.
fn kid mode ulong to ulong
an = mkexec
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
if eq mode 0
if eq sigblk 16384
exit 0
end
exit 63
end
if eq mode 1
if ne sigmask 1 set 0 8 0
exit 64
end
end
r = execx argv 0 an envp 0 7 none 0 0
exit 65
end
ret reap pid
end

fn main to int
if eq argcnt 2
v = sigblk
if eq v 0
ret 0
end
if eq v 16384
ret 62
end
ret 61
end
if ne argcnt 1
ret 36
end
put set 1 64
if ne sigblk 0
ret 1
end
if or ne sigmask 0 set 0 8 0 ne sigblk 16384
ret 2
end
if ne kid 0 0
ret 3
end
if ne kid 1 0
ret 4
end
if ne kid 2 62
ret 5
end
if or ne sigmask 1 set 0 8 0 ne sigblk 0
ret 6
end
if or ne sigmask 2 set 0 8 0 ne sigblk 16384
ret 7
end
if or ne sigmask 2 none 0 8 0 ne sigblk 0
ret 7
end
ret 0
end

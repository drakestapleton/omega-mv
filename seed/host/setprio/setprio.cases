# seed/host/setprio/setprio.cases: setprio (keyword 234), run by the OM-2 conductor
# (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=9.
# fixture: the word's .om fixture on AArch64 (parent exit 0 = every check holds; see its notes).
# x86-fixture: the same source for x86linux through binfmt qemu-x86_64 (emulator evidence, not
# hardware qualification). Each mutant compiler is built from seed/omc/omc.om with one emission
# changed; the fixture built by it must fail at the named check (exit = check number).
deadline 120
fixture run seed/host/setprio/setprio.om - - - 0
x86-fixture run seed/host/setprio/x86-target.om+seed/host/setprio/setprio.om - - - 0
fnmode refuse seed/host/setprio/fnmode.om 9
x86-fnmode refuse seed/host/setprio/x86-target.om+seed/host/setprio/fnmode.om 9
contract refuse seed/host/setprio/contract.om 30
longwho refuse seed/host/setprio/longwho.om 7
efi refuse seed/host/setprio/efi-target.om+seed/host/setprio/use.om 25
subst seed/host/setprio/mutants/a64-sysno.from seed/host/setprio/mutants/a64-sysno.to
cc seed/omc/omc.om
mut-a64-sysno run seed/host/setprio/setprio.om - - - 2
cc pinned
subst seed/host/setprio/mutants/x86-sysno.from seed/host/setprio/mutants/x86-sysno.to
cc seed/omc/omc.om
mut-x86-sysno run seed/host/setprio/x86-target.om+seed/host/setprio/setprio.om - - - 2
cc pinned

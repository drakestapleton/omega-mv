note SPDX-License-Identifier: Apache-2.0
note seed/host/setprio/setprio.om: fixture for setprio (keyword 234), program mode. Run by the OM-2
note conductor through seed/host/setprio/setprio.cases from the repository root. Kernel truth is field 19
note (nice) of /proc/<child>/stat, read from the parent while the child is a zombie (not yet reaped).
note Checks (parent exit = number of the first failed check, 0 when all hold):
note 1 control: a child that does nothing shows the inherited nice n0 (must be at most 16).
note 2 a child runs setprio 0 0 (n0+3): 0, and its stat shows nice n0+3 (exit 0 also proves the word ran).
note 3 that child then asks for n0 again (raising priority): -13 (EACCES) or -1 (EPERM) unless euid 0.
note 4 setprio 0 1 n0 (pid 1, owned by root) returns -1 (EPERM) unless euid 0.
note 5 an invalid which (7) returns -22 (EINVAL).
note 6 PRIO_PROCESS for pid 2147483647 returns -3 (ESRCH).
om2
text ppre "/proc/"
text psst "/stat"
global path uchar 64
global st uchar 4096
global fv long 2
global status uchar 4

note "/proc/<pid>/<tail>" into path; returns its length. Another process's /proc entry is read, never
note /proc/self: qemu-user, which runs the x86linux build, fakes the caller's own stat and status.
fn mkpath pid ulong tail view uchar * to ulong
for i ulong len ppre
put path i get ppre i
end
p = len ppre
d = ulong 1
while le mul d 10 pid
d = mul d 10
end
while gt d 0
put path p uchar add 48 rem div pid d 10
p = add p 1
d = div d 10
end
for j ulong len tail
put path add p j get tail j
end
ret add p len tail
end

note Read /proc/<pid>/<tail> into st; returns its length (0 on failure).
fn slurp pid ulong tail view uchar * to ulong
n = mkpath pid tail
fd = fopen path 0 n 524288 0
if lt fd 0
ret 0
end
m = read int fd st 0 len st
c = fclose int fd
if le m 0
ret 0
end
ret ulong m
end

note /proc/<pid>/stat: fv[0] = the state letter (field 3), fv[1] = nice (field 19); 1 on success.
fn readstat pid ulong to ulong
k = slurp pid psst
if eq k 0
ret 0
end
rp = ulong 0
for i ulong k
if eq get st i 41
rp = i
end
end
p = add rp 2
if ge p k
ret 0
end
put fv 0 long get st p
tok = ulong 0
q = p
while lt q k
if eq tok 16
break
end
if eq get st q 32
tok = add tok 1
end
q = add q 1
end
if ne tok 16
ret 0
end
ng = ulong 0
if eq get st q 45
ng = 1
q = add q 1
end
v = long 0
while lt q k
d = get st q
if or lt d 48 gt d 57
break
end
v = add mul v 10 long sub d 48
q = add q 1
end
if eq ng 1
v = neg v
end
put fv 1 v
ret 1
end

note Wait (without reaping) until pid is a zombie, then leave its stat in fv; 1 on success.
fn zombie pid ulong to ulong
for t ulong 400000
if eq readstat pid 1
if eq get fv 0 90
ret 1
end
end
end
ret 0
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

fn main to int
pid = fork
if lt pid 0
ret 1
end
if eq pid 0
exit 0
end
if eq zombie ulong pid 0
ret 1
end
n0 = get fv 1
if ne reap pid 0
ret 1
end
if gt n0 16
ret 1
end
t = add n0 3
pid = fork
if lt pid 0
ret 2
end
if eq pid 0
r = setprio 0 0 int t
if ne r 0
exit 1
end
r = setprio 0 0 int n0
if or eq r neg long 13 eq r neg long 1
exit 0
end
if eq r 0
exit 2
end
exit 3
end
if eq zombie ulong pid 0
ret 2
end
if ne get fv 1 t
ret 2
end
x = reap pid
if eq x 1
ret 2
end
if eq geteuid 0
if and ne x 0 ne x 2
ret 3
end
else
if ne x 0
ret 3
end
end
if ne geteuid 0
r = setprio 0 1 int n0
if ne r neg long 1
ret 4
end
end
r = setprio 7 0 10
if ne r neg long 22
ret 5
end
r = setprio 0 2147483647 10
if ne r neg long 3
ret 6
end
ret 0
end

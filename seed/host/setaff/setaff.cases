# seed/host/setaff/setaff.cases: setaff (keyword 237), run by the OM-2 conductor
# (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=14.
# fixture: the word's .om fixture on AArch64 (parent exit 0 = every check holds; see its notes).
# x86-fixture: the same source for x86linux through binfmt qemu-x86_64 (emulator evidence, not
# hardware qualification). Each mutant compiler is built from seed/omc/omc.om with one emission
# changed; the fixture built by it must fail at the named check (exit = check number).
deadline 120
fixture run seed/host/setaff/setaff.om - - - 0
x86-fixture run seed/host/setaff/x86-target.om+seed/host/setaff/setaff.om - - - 0
fnmode refuse seed/host/setaff/fnmode.om 9
x86-fnmode refuse seed/host/setaff/x86-target.om+seed/host/setaff/fnmode.om 9
contract refuse seed/host/setaff/contract.om 30
longpid refuse seed/host/setaff/longpid.om 7
intn refuse seed/host/setaff/intn.om 7
efi refuse seed/host/setaff/efi-target.om+seed/host/setaff/use.om 25
subst seed/host/setaff/mutants/a64-sysno.from seed/host/setaff/mutants/a64-sysno.to
cc seed/omc/omc.om
mut-a64-sysno run seed/host/setaff/setaff.om - - - 2
cc pinned
subst seed/host/setaff/mutants/a64-zguard.from seed/host/setaff/mutants/a64-zguard.to
cc seed/omc/omc.om
mut-a64-zguard run seed/host/setaff/setaff.om - - - 4
cc pinned
subst seed/host/setaff/mutants/a64-nguard.from seed/host/setaff/mutants/a64-nguard.to
cc seed/omc/omc.om
mut-a64-nguard run seed/host/setaff/setaff.om - - - 5
cc pinned
subst seed/host/setaff/mutants/x86-sysno.from seed/host/setaff/mutants/x86-sysno.to
cc seed/omc/omc.om
mut-x86-sysno run seed/host/setaff/x86-target.om+seed/host/setaff/setaff.om - - - 2
cc pinned
subst seed/host/setaff/mutants/x86-zguard.from seed/host/setaff/mutants/x86-zguard.to
cc seed/omc/omc.om
mut-x86-zguard run seed/host/setaff/x86-target.om+seed/host/setaff/setaff.om - - - 4
cc pinned
subst seed/host/setaff/mutants/x86-nguard.from seed/host/setaff/mutants/x86-nguard.to
cc seed/omc/omc.om
mut-x86-nguard run seed/host/setaff/x86-target.om+seed/host/setaff/setaff.om - - - 5
cc pinned

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note CPU-only qualification: compiler, qemu-x86_64 oracle, fresh scratch directory.
note All ioctl executions use fd -1; no device is opened. Compiler/runtime are seeded Omega.
note Process packets, bounded child waits and exclusive artifacts follow qualification/om2/gate.om.
text matrix "seed/host/aien-ioctl.cases"
text omcsrc "seed/omc/omc.om"
text nullpath "/dev/null"
text pieces "target x86linux\n|global b uchar 4096\nfn main to int\nr = devctl neg int 1 uint | b 0 |\nif ne r neg long 9\nret 1\nend\nret 0\nend\n|om2\nexport fn ctl fd long to long\nb = new uchar 4096 0\nret devctl int fd uint |\nend\n|global b uchar 4096\nfn call request uint to long\nret devctl neg int 1 request b 0 112\nend\nfn main to int\nret int call uint 2154840336\nend\n|om2\nexport fn ctl fd long request uint to long\nb = new uchar 4096 0\nret devctl int fd request b 0 112\nend\n|/|case-|.src|.elf|.cerr|.out|.err|.compiler|.mutant|error 9\n|AIEN-IOCTL FAIL |AIEN-IOCTL PASS native, x86-QEMU, function admissions, encoded/runtime refusals; four mutants killed; chip NOT_RUN\n|AIEN-IOCTL mutant killed |AIEN-IOCTL mutant survived |AIEN-IOCTL baseline\n|\nif ne r neg long 25\nret 1\nend\nret 0\nend\n|AIEN-IOCTL unexpected mutant failure |arch/span/phase/observed:\n|"
text mfrom "ok = or ok eq q 3222815012\nif not ok|eq q 2154840336|put a_ar add get a_rb 77 add x 23 xhreq 166 x\ne = harray x 1\nt = alloc\nmatconst t get a_ar add get a_rb 77 add x 23\ne3 3942645760 31 get a_ar add get a_rb 77 add x 22 t\ntrapc 1 3|xhs 2 get a_ar add get a_rb 77 add x 22\nxhcmp 2 get a_ar add get a_rb 77 add x 23\nxtrap 1 3\nxha x 4 7|"
text mto "ok = or ok eq q 3222815012\nif false|eq q 2154840337|put a_ar add get a_rb 77 add x 23 xhreq 166 x\ne = harray x 1\nt = alloc\nmatconst t get a_ar add get a_rb 77 add x 23\ne3 3942645760 31 get a_ar add get a_rb 77 add x 22 t|xhs 2 get a_ar add get a_rb 77 add x 22\nxhcmp 2 get a_ar add get a_rb 77 add x 23\nxha x 4 7|"
global cc uchar 4096
global cn ulong 1
global pinned uchar 4096
global pinlen ulong 1
global qemu uchar 4096
global qn ulong 1
global scratch uchar 4096
global sn ulong 1
global path uchar 8192
global pn ulong 1
global packet uchar 16384
global packetn ulong 2
global status uchar 4
global data uchar 65536
global dn ulong 1
global fields ulong 14
global fieldn ulong 1
global row ulong 2
global src uchar 16777216
global srcn ulong 1
global compiler uchar 16777216
global omclen ulong 1
global tmp uchar 65536
global nums uchar 24
global number ulong 1
global cut ulong 2
global serial ulong 1
global current ulong 1
global curarch ulong 1
global curspan ulong 1
global why ulong 1
global actual long 1
global mutating ulong 1
text loud "AIEN-IOCTL INVALID mutant anchor must occur exactly once in seed/omc/omc.om (mutant not applied; not a compiler verdict); respell mfrom/mto with the compiler change. mutant/count:\n|AIEN-IOCTL INVALID cannot create fresh scratch directory (it must not exist): |\n|AIEN-IOCTL expected mutant failure |AIEN-IOCTL INVALID mutated compiler did not build; mutant/status:\n|"
fn shout id ulong to void
s = ulong 0
k = ulong 1
for i ulong len loud
if eq get loud i 124
if eq k id
r = write 1 loud s sub i s
ret
end
s = add i 1
k = add k 1
end
end
exit 91
end
fn part id ulong to void
s = ulong 0
k = ulong 1
for i ulong len pieces
if eq get pieces i 124
if eq k id
put cut 0 s
put cut 1 sub i s
ret
end
s = add i 1
k = add k 1
end
end
exit 91
end
fn say id ulong to void
part id
r = write 1 pieces get cut 0 get cut 1
end
fn digits v ulong to void
n = ulong 0
while ge v 10
put nums n uchar add 48 rem v 10
n = add n 1
v = div v 10
end
put nums n uchar add 48 v
put number 0 add n 1
end
fn show v ulong to void
digits v
for i ulong get number 0
r = write 1 nums sub sub get number 0 i 1 1
end
put nums 0 10
r = write 1 nums 0 1
end
fn pathpart id ulong to void
part id
s = get cut 0
n = get cut 1
p = get pn 0
for i ulong n
put path add p i get pieces add s i
end
put pn 0 add p n
end
fn casepath suffix ulong to void
put pn 0 get sn 0
for i ulong get sn 0
put path i get scratch i
end
pathpart 9
pathpart 10
digits get current 0
n = get number 0
p = get pn 0
for i ulong n
put path add p i get nums sub sub n i 1
end
put pn 0 add p n
pathpart suffix
end
fn openpath flags int to int
ret int fopen path 0 get pn 0 flags 448
end
fn writeall fd int n ulong to bool
p = ulong 0
while lt p n
r = write fd src p sub n p
if le r 0
ret false
end
p = add p ulong r
end
ret true
end
fn packetclear to void
put packetn 0 2
put packetn 1 0
end
fn packetpath to void
n = get pn 0
p = get packetn 0
if gt add add p 2 n len packet
exit 91
end
put packet p uchar n
put packet add p 1 uchar shr n 8
for i ulong n
put packet add add p 2 i get path i
end
put packetn 0 add add p 2 n
put packetn 1 add get packetn 1 1
end
fn redir fd int target int to void
if ne dupfd fd target 0 long target
exit 127
end
end
fn spawn fi int fo int fe int to long
put packet 0 uchar get packetn 1
put packet 1 uchar shr get packetn 1 8
pid = fork
if lt pid 0
exit 91
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog packet 0 get packetn 0
exit 127
end
r = fclose fi
r = fclose fo
r = fclose fe
start = monons
while true
r = waitpid int pid status 0 4 1
if eq r pid
if ne get status 0 0
ret -1
end
ret long get status 1
end
if lt r 0
exit 91
end
if gt sub monons start 30000000000
r = killpid int pid 9
r = waitpid int pid status 0 4 0
exit 91
end
r = sleepns 1000000
end
ret -1
end
fn compile to long
packetclear
put pn 0 get cn 0
for i ulong get cn 0
put path i get cc i
end
packetpath
casepath 11
fi = openpath 524288
casepath 12
fo = openpath 524481
casepath 13
fe = openpath 524481
if or or lt fi 0 lt fo 0 lt fe 0
exit 91
end
r = spawn fi fo fe
put actual 0 r
ret r
end
fn readartifact suffix ulong to long
casepath suffix
fd = openpath 524288
if lt fd 0
exit 91
end
n = read fd tmp 0 len tmp
r = fclose fd
ret n
end
fn refuse to bool
put why 0 4
if ne compile 9
ret false
end
if ne readartifact 12 0
ret false
end
n = readartifact 13
if lt n 8
ret false
end
part 18
s = get cut 0
m = get cut 1
for i ulong add sub ulong n m 1
ok = true
for j ulong m
a = get tmp add i j
b = get pieces add s j
if ne a b
ok = false
end
end
if ok
ret true
end
end
ret false
end
fn run arch ulong expected long to bool
put why 0 1
if ne compile 0
ret false
end
put why 0 3
n = readartifact 12
if lt n 4
ret false
end
if or ne get tmp 0 127 ne get tmp 1 69
ret false
end
if or ne get tmp 2 76 ne get tmp 3 70
ret false
end
casepath 12
fd = openpath 524288
if ne fchmod fd 448 0
exit 91
end
r = fclose fd
packetclear
if eq arch 1
put pn 0 get qn 0
for i ulong get qn 0
put path i get qemu i
end
packetpath
end
casepath 12
packetpath
fi = int fopen nullpath 0 len nullpath 524288 0
casepath 14
fo = openpath 524481
casepath 15
fe = openpath 524481
put why 0 2
r = spawn fi fo fe
put actual 0 r
if ne r expected
ret false
end
put why 0 3
if ne readartifact 14 0
ret false
end
ret eq readartifact 15 0
end
fn addpart id ulong to void
part id
s = get cut 0
n = get cut 1
p = get srcn 0
for i ulong n
put src add p i get pieces add s i
end
put srcn 0 add p n
end
fn addfield id ulong to void
s = get fields mul id 2
n = get fields add mul id 2 1
p = get srcn 0
for i ulong n
put src add p i get data add s i
end
put srcn 0 add p n
end
fn savecase to void
put serial 0 add get serial 0 1
put current 0 get serial 0
casepath 11
fd = openpath 524481
if lt fd 0
exit 91
end
ok = writeall fd get srcn 0
r = fclose fd
if not ok
exit 91
end
end
fn fixture arch ulong span ulong dynamic bool to void
put srcn 0 0
put curarch 0 arch
put curspan 0 span
if eq arch 1
addpart 1
end
if dynamic
if eq arch 2
addpart 8
else
addpart 7
end
else
if eq arch 2
addpart 5
else
addpart 2
end
addfield 2
addpart 3
addfield span
if eq arch 2
addpart 6
else
if eq arch 1
addpart 24
else
addpart 4
end
end
end
savecase
end
fn nextrow to bool
p = get row 0
while lt p get dn 0
s = p
while and lt p get dn 0 ne get data p 10
p = add p 1
end
put row 1 s
put row 0 add p 1
if and lt s p ne get data s 35
k = ulong 0
while lt s p
while and lt s p eq get data s 32
s = add s 1
end
if lt s p
e = s
while and lt e p ne get data e 32
e = add e 1
end
if ge k 7
exit 91
end
put fields mul k 2 s
put fields add mul k 2 1 sub e s
k = add k 1
s = e
end
end
put fieldn 0 k
ret true
end
p = add p 1
end
ret false
end
fn failcase to bool
if ne get mutating 0 0
shout 4
else
say 19
end
show get current 0
say 26
show get curarch 0
show get curspan 0
show get why 0
if ge get actual 0 0
show ulong get actual 0
else
show 999
end
ret false
end
fn qualify to bool
put row 0 0
while nextrow
allow = eq get data get fields 0 97
for arch ulong 3
fixture arch 3 false
if allow
if eq arch 2
put why 0 1
if ne compile 0
ret failcase
end
if le readartifact 12 0
ret failcase
end
else
if not run arch 0
ret failcase
end
for mode ulong 2
fixture arch add mode 4 false
if not run arch 103
ret failcase
end
end
end
else
if not refuse
ret failcase
end
end
end
end
for arch ulong 3
fixture arch 3 true
if not refuse
ret failcase
end
end
ret true
end
fn matchmut at ulong o ulong n ulong to bool
for j ulong n
a = get compiler add at j
b = get mfrom add o j
if ne a b
ret false
end
end
ret true
end
fn selectold which ulong to void
s = ulong 0
k = ulong 0
for i ulong len mfrom
if eq get mfrom i 124
if eq k which
put cut 0 s
put cut 1 sub i s
end
s = add i 1
k = add k 1
end
end
end
fn anchors to ulong
count = ulong 0
o = get cut 0
n = get cut 1
for i ulong add sub get omclen 0 n 1
if matchmut i o n
count = add count 1
end
end
ret count
end
fn locate which ulong to ulong
at = ulong 0
count = ulong 0
o = get cut 0
n = get cut 1
for i ulong add sub get omclen 0 n 1
if matchmut i o n
at = i
count = add count 1
end
end
if ne count 1
shout 1
show which
show count
exit 92
end
ret at
end
fn copycc start ulong n ulong to void
p = get srcn 0
for i ulong n
put src add p i get compiler add start i
end
put srcn 0 add p n
end
fn appendnew which ulong to void
s = ulong 0
k = ulong 0
for i ulong len mto
if eq get mto i 124
if eq k which
p = get srcn 0
for j ulong sub i s
put src add p j get mto add s j
end
put srcn 0 add p sub i s
end
s = add i 1
k = add k 1
end
end
end
fn mutate which ulong to void
selectold which
at = locate which
oldend = add at get cut 1
put srcn 0 0
copycc 0 at
appendnew which
copycc oldend sub get omclen 0 oldend
savecase
if ne compile 0
shout 5
show which
if ge get actual 0 0
show ulong get actual 0
else
show 999
end
exit 91
end
casepath 12
fd = openpath 524288
if ne fchmod fd 448 0
exit 91
end
r = fclose fd
put cn 0 get pn 0
for i ulong get pn 0
put cc i get path i
end
end
note A failed child/compile is never a generic mutant kill. Attribute each intended assertion.
fn killed m ulong to bool
if eq m 0
if ne get why 0 4
ret false
end
if ne get actual 0 0
ret false
end
if ne get curarch 0 0
ret false
end
n = readartifact 12
if lt n 4
ret false
end
if or ne get tmp 0 127 ne get tmp 1 69
ret false
end
ret and eq get tmp 2 76 eq get tmp 3 70
end
if eq m 1
if ne get why 0 1
ret false
end
ret eq get actual 0 9
end
if ne get why 0 2
ret false
end
if ne get actual 0 0
ret false
end
if ne get curspan 0 4
ret false
end
ret eq get curarch 0 sub m 2
end
fn main to int
if ne argcnt 4
ret 90
end
n = argread 1 pinned 0 4095
if lt n 1
ret 90
end
put pinlen 0 ulong n
n = argread 2 qemu 0 4095
if lt n 1
ret 90
end
put qn 0 ulong n
n = argread 3 scratch 0 4095
if lt n 1
ret 90
end
put sn 0 ulong n
if ne makedir scratch 0 ulong n 448 0
shout 2
w = write 1 scratch 0 ulong n
shout 3
ret 91
end
fd = int fopen matrix 0 len matrix 524288 0
if lt fd 0
ret 91
end
n = read fd data 0 len data
r = fclose fd
if or lt n 1 ge ulong n len data
ret 91
end
put dn 0 ulong n
fd = int fopen omcsrc 0 len omcsrc 524288 0
if lt fd 0
ret 91
end
n = read fd compiler 0 len compiler
r = fclose fd
if or lt n 1 ge ulong n len compiler
ret 91
end
put omclen 0 ulong n
put cn 0 get pinlen 0
for i ulong get pinlen 0
put cc i get pinned i
end
bad = false
for m ulong 4
selectold m
c = anchors
if ne c 1
shout 1
show m
show c
bad = true
end
end
if bad
ret 92
end
say 23
if not qualify
ret 1
end
for m ulong 4
put cn 0 get pinlen 0
for i ulong get pinlen 0
put cc i get pinned i
end
put mutating 0 1
mutate m
if qualify
say 22
show m
ret 1
end
if not killed m
say 25
show m
ret 1
end
say 21
show m
end
say 20
ret 0
end

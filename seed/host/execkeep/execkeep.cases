# seed/host/execkeep/execkeep.cases: execkeep (keyword 238), run by the OM-2 conductor
# (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=13.
# fixture: the word's .om fixture on AArch64 (parent exit 0 = every check holds; see its notes).
# x86-fixture: the same source for x86linux through binfmt qemu-x86_64 (emulator evidence, not
# hardware qualification). Each mutant compiler is built from seed/omc/omc.om with one emission
# changed; the fixture built by it must fail at the named check (exit = check number).
deadline 120
fixture run seed/host/execkeep/execkeep.om - - - 0
x86-fixture run seed/host/execkeep/x86-target.om+seed/host/execkeep/execkeep.om - - - 0
fnmode refuse seed/host/execkeep/fnmode.om 9
x86-fnmode refuse seed/host/execkeep/x86-target.om+seed/host/execkeep/fnmode.om 9
contract refuse seed/host/execkeep/contract.om 30
longfd refuse seed/host/execkeep/longfd.om 7
efi refuse seed/host/execkeep/efi-target.om+seed/host/execkeep/use.om 25
subst seed/host/execkeep/mutants/a64-keep.from seed/host/execkeep/mutants/a64-keep.to
cc seed/omc/omc.om
mut-a64-keep run seed/host/execkeep/execkeep.om - - - 1
cc pinned
subst seed/host/execkeep/mutants/a64-skip.from seed/host/execkeep/mutants/a64-skip.to
cc seed/omc/omc.om
mut-a64-skip run seed/host/execkeep/execkeep.om - - - 1
cc pinned
subst seed/host/execkeep/mutants/a64-fdguard.from seed/host/execkeep/mutants/a64-fdguard.to
cc seed/omc/omc.om
mut-a64-fdguard run seed/host/execkeep/execkeep.om - - - 5
cc pinned
subst seed/host/execkeep/mutants/x86-keep.from seed/host/execkeep/mutants/x86-keep.to
cc seed/omc/omc.om
mut-x86-keep run seed/host/execkeep/x86-target.om+seed/host/execkeep/execkeep.om - - - 1
cc pinned
subst seed/host/execkeep/mutants/x86-skip.from seed/host/execkeep/mutants/x86-skip.to
cc seed/omc/omc.om
mut-x86-skip run seed/host/execkeep/x86-target.om+seed/host/execkeep/execkeep.om - - - 1
cc pinned
subst seed/host/execkeep/mutants/x86-fdguard.from seed/host/execkeep/mutants/x86-fdguard.to
cc seed/omc/omc.om
mut-x86-fdguard run seed/host/execkeep/x86-target.om+seed/host/execkeep/execkeep.om - - - 5
cc pinned

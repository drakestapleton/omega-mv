note SPDX-License-Identifier: Apache-2.0
note seed/host/prlimit/prlimit.om: fixture for prlimit (keyword 235), program mode. Run by the OM-2
note conductor through seed/host/prlimit/prlimit.cases from the repository root. Kernel truth is
note /proc/self/limits, read independently of the word under test.
note Checks (parent exit = number of the first failed check, 0 when all hold):
note 1 n 16 reads RLIMIT_NOFILE: 0, both u64 words written over a 0xAA poison, cur <= max.
note 2 the pair equals the "Max open files" soft/hard columns of /proc/self/limits.
note 3 n 32 sets soft 40 (hard kept): 0, and the old pair lands at A[off+16..off+32).
note 4 n 16 reads back {40, max}; /proc/self/limits shows soft 40.
note 5 the limit acts: opening files stops with -24 (EMFILE), every descriptor below 40.
note 6 n 32 restores the original pair; the old pair returned is {40, max}.
note 7 n 24, 8 and 0 return -22 without a kernel call: A[16..32) keeps its poison although A[0..16)
note   holds a valid pair a set would accept.
note 8 res 99 returns -22 (kernel EINVAL) and the output slice keeps its poison.
note 9 pid 2147483647 returns -3 (ESRCH).
note 10 pid 1 returns -1 (EPERM) unless this process runs with euid 0.
note 11 n 16 reads RLIMIT_AS (9) equal to "Max address space" ("unlimited" is 2^64-1).
note 12 a slice past the array end traps 3 (child exit 103), for n 16 and for n 32.
note 16 a nonzero, unaligned off (9): n 16 writes the pair only to A[9..25), n 32 reads the new pair from
note   A[9..25) and writes the old pair only to A[25..41); every other byte keeps its poison.
note Without an argument (AArch64 native) the RLIMIT_AS effect is checked across execprog; the x86linux
note row passes "noas" because qemu-user ignores RLIMIT_AS writes:
note 13 a child sets RLIMIT_AS soft 1 GiB and execprogs [argv0, "cap"]: the new image reads 1 GiB (exit 8).
note 14 a child sets RLIMIT_AS soft 64 MiB and execprogs [argv0, "big"]: the 128 MiB image cannot be
note   mapped (execve ENOMEM after the point of no return), so the kernel kills it with SIGSEGV (signal 11).
note 15 control: [argv0, "big"] without a cap runs and exits 7.
om2
text plim "/proc/self/limits"
text knof "Max open files"
text kas "Max address space"
text cmcap "cap"
text cmbig "big"
text cmnoas "noas"
global hugeimg ulong 16777216
global a uchar 64
global lim uchar 8192
global pv ulong 2
global argv uchar 4096
global buf uchar 4096
global status uchar 4
global ofd ulong 64

fn rd64 off ulong to ulong
x = ulong 0
for i ulong 8
x = or x shl ulong get a add off i mul i 8
end
ret x
end

fn wr64 off ulong v ulong to void
for i ulong 8
put a add off i uchar and shr v mul i 8 255
end
end

fn poison to void
for i ulong len a
put a i 170
end
end

note 1 when a[lo..hi) still holds the poison byte everywhere.
fn intact lo ulong hi ulong to ulong
for i ulong sub hi lo
if ne get a add lo i 170
ret 0
end
end
ret 1
end

note Read /proc/self/limits into lim; returns its length (0 on failure).
fn loadlim to ulong
fd = fopen plim 0 len plim 524288 0
if lt fd 0
ret 0
end
n = read int fd lim 0 len lim
c = fclose int fd
if le n 0
ret 0
end
ret ulong n
end

note Parse one column at p (skipping spaces): a decimal or "unlimited" (2^64-1) into pv[k]; returns
note the position after it, or 0 when neither is there.
fn col p ulong k ulong n ulong to ulong
q = p
while lt q n
if ne get lim q 32
break
end
q = add q 1
end
if ge q n
ret 0
end
if eq get lim q 117
put pv k not ulong 0
ret add q 9
end
v = ulong 0
s = q
while lt q n
d = ulong get lim q
if or lt d 48 gt d 57
break
end
v = add mul v 10 sub d 48
q = add q 1
end
if eq q s
ret 0
end
put pv k v
ret q
end

note Find the row named key and parse its soft/hard columns into pv; 1 on success.
fn row key view uchar * to ulong
n = loadlim
if eq n 0
ret 0
end
k = len key
i = ulong 0
while le add i k n
hit = ulong 1
for j ulong k
if ne get lim add i j get key j
hit = 0
break
end
end
if eq hit 1
p = col add i k 0 n
if eq p 0
ret 0
end
if eq col p 1 n 0
ret 0
end
ret 1
end
i = add i 1
end
ret 0
end

note 1 when argv[1] equals m.
fn argis m view uchar * to ulong
n = argread 1 buf 0 len buf
if ne n long len m
ret 0
end
for i ulong len m
if ne get buf i get m i
ret 0
end
end
ret 1
end

note argv packet [argv0, m]; returns its length.
fn mkargv m view uchar * to ulong
n = argread 0 buf 0 len buf
if le n 0
exit 90
end
k = ulong n
put argv 0 2
put argv 1 0
put argv 2 uchar and k 255
put argv 3 uchar shr k 8
for i ulong k
put argv add i 4 get buf i
end
pos = add k 4
put argv pos uchar len m
put argv add pos 1 0
for j ulong len m
put argv add add pos 2 j get m j
end
ret add add pos 2 len m
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

note A forked child sets RLIMIT_AS soft to cap (cap 0: no change) and execprogs [argv0, m]; returns
note the child's exit, or 2000 + signal.
fn capexec cap ulong m view uchar * to ulong
an = mkargv m
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
if ne cap 0
r = prlimit 0 9 a 0 16
if ne r 0
exit 96
end
wr64 0 cap
r = prlimit 0 9 a 0 32
if ne r 0
exit 97
end
end
r = execprog argv 0 an
exit 98
end
ret reap pid
end

note A forked child calls prlimit with an out-of-range slice of a (64 bytes); returns its exit.
fn trapkid off ulong n ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = prlimit 0 7 a off n
exit 98
end
ret reap pid
end

note Child modes: "cap" exits 8 when RLIMIT_AS soft reads 1 GiB (9 otherwise); "big" touches the
note last byte of the 128 MiB global and exits 7.
fn child to int
if eq argis cmcap 1
r = prlimit 0 9 a 0 16
if and eq r 0 eq rd64 0 1073741824
ret 8
end
ret 9
end
put hugeimg 16777215 1
ret int add 6 get hugeimg 16777215
end

note 1-6: read, compare, set, read back, effect, restore (RLIMIT_NOFILE).
fn nofile to int
poison
r = prlimit 0 7 a 0 16
if or ne r 0 eq intact 0 16 1
ret 1
end
cur = rd64 0
max = rd64 8
if gt cur max
ret 1
end
if eq row knof 0
ret 2
end
if or ne get pv 0 cur ne get pv 1 max
ret 2
end
poison
wr64 0 40
wr64 8 max
r = prlimit 0 7 a 0 32
if or ne r 0 or ne rd64 16 cur ne rd64 24 max
ret 3
end
poison
r = prlimit 0 7 a 0 16
if or ne r 0 or ne rd64 0 40 ne rd64 8 max
ret 4
end
if or eq row knof 0 ne get pv 0 40
ret 4
end
if ne fill 0
ret 5
end
poison
wr64 0 cur
wr64 8 max
r = prlimit 0 7 a 0 32
if or ne r 0 or ne rd64 16 40 ne rd64 24 max
ret 6
end
ret 0
end

note 5: open /proc/self/limits until refused; the refusal is -24 and every descriptor is below 40.
fn fill to int
got = ulong 0
bad = ulong 1
for i ulong 64
fd = fopen plim 0 len plim 524288 0
if lt fd 0
if eq fd neg long 24
bad = 0
end
break
end
put ofd got ulong fd
got = add got 1
if ge fd 40
break
end
end
for j ulong got
if ge get ofd j 40
bad = 1
end
c = fclose int get ofd j
end
ret int bad
end

note 7-12: refusals, errno and slice traps.
fn errs to int
for n ulong 3
poison
r = prlimit 0 7 a 0 16
w = ulong 24
if eq n 1
w = 8
end
if eq n 2
w = 0
end
r = prlimit 0 7 a 0 w
if or ne r neg long 22 eq intact 16 32 0
ret 7
end
end
poison
r = prlimit 0 99 a 0 16
if or ne r neg long 22 eq intact 0 16 0
ret 8
end
r = prlimit 2147483647 7 a 0 16
if ne r neg long 3
ret 9
end
if ne geteuid 0
r = prlimit 1 7 a 0 16
if ne r neg long 1
ret 10
end
end
poison
r = prlimit 0 9 a 0 16
if or ne r 0 eq row kas 0
ret 11
end
if or ne get pv 0 rd64 0 ne get pv 1 rd64 8
ret 11
end
if or ne trapkid 56 16 103 ne trapkid 40 32 103
ret 12
end
ret 0
end

note 16: the slice offset reaches the kernel (n 16 and n 32 at off 9, unaligned).
fn offs to int
poison
r = prlimit 0 7 a 0 16
if ne r 0
ret 16
end
cur = rd64 0
max = rd64 8
poison
r = prlimit 0 7 a 9 16
if or ne r 0 or ne rd64 9 cur ne rd64 17 max
ret 16
end
if or eq intact 0 9 0 eq intact 25 64 0
ret 16
end
poison
wr64 9 cur
wr64 17 max
r = prlimit 0 7 a 9 32
if or ne r 0 or ne rd64 25 cur ne rd64 33 max
ret 16
end
if or eq intact 0 9 0 eq intact 41 64 0
ret 16
end
ret 0
end

fn main to int
if eq argcnt 2
if eq argis cmnoas 0
ret child
end
end
k = nofile
if ne k 0
ret k
end
k = errs
if ne k 0
ret k
end
k = offs
if ne k 0
ret k
end
if eq argcnt 2
ret 0
end
if ne capexec 1073741824 cmcap 8
ret 13
end
if ne capexec 67108864 cmbig 2011
ret 14
end
if ne capexec 0 cmbig 7
ret 15
end
ret 0
end

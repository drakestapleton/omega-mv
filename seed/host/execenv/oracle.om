note SPDX-License-Identifier: Apache-2.0
note seed/host/execenv/oracle.om: execenv against an independent ORACLE, /usr/bin/printenv (a host
note binary, never shipped). Without arguments the program replaces itself, through execenv, with
note /usr/bin/printenv under an environment of exactly the three records below, so stdout must be those
note three lines in packet order (seed/host/execenv/printenv.want). With one argument it is the
note negative control: the same argv through execprog, whose child gets an empty environment, so
note printenv prints nothing. Exit 99 means the exec returned.
om2
text pe "/usr/bin/printenv"
text tok "AIEN_COCKPIT_TOKEN=fixture-token-execenv"
text addr "AIEN_COCKPIT_ADDR=127.0.0.1:1"
text db "HIVE_DB_PATH=/nonexistent/hive.db"
global argv uchar 64
global envp uchar 4096

fn erec pos ulong s view uchar * to ulong
put envp pos uchar and len s 255
put envp add pos 1 uchar shr len s 8
for i ulong len s
put envp add add pos 2 i get s i
end
ret add add pos 2 len s
end

fn main to int
put argv 0 1
put argv 1 0
put argv 2 uchar len pe
put argv 3 0
for i ulong len pe
put argv add i 4 get pe i
end
an = add len pe 4
put envp 0 3
put envp 1 0
en = erec 2 tok
en = erec en addr
en = erec en db
if eq argcnt 2
r = execprog argv 0 an
ret 99
end
r = execenv argv 0 an envp 0 en
ret 99
end

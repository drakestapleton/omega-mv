note SPDX-License-Identifier: Apache-2.0
note seed/host/execenv/execenv.om: fixture for execenv (keyword 233), program mode. Run by the OM-2
note conductor through seed/host/execenv/execenv.cases from the repository root, without arguments.
note Parent mode packs argv [argv0, "child"] and an environment of exactly three records, runs itself
note through execenv in a forked child and requires child exit 0: the child saw exactly those three
note entries, in packet order. The same child run through execprog must see an empty environment
note (child exit 30): the negative control. Malformed packets trap 3 (exit 103) in a forked child.
note execenv packets hold 1..32768 records and at most 2097152 bytes: 32768 records and a 2097152-byte
note packet pass the decoder, 32769 records and 2097153 bytes trap 3, for the environment and for argv.
note The parent first raises its soft RLIMIT_STACK to 64 MiB with prlimit (Linux ARG_MAX is a quarter of
note it, at most 6 MiB) and reads it back: when the raise holds, maximal packets must reach the child
note intact; when it does not (qemu-user ignores a guest's RLIMIT_STACK), the kernel's E2BIG (-7, child
note exit 97) is the required outcome, which still proves the decoder passed them to the kernel.
note execprog keeps 64 records and 4096 bytes: an argv packet of 65 records or 4097 bytes, which
note execenv accepts, still traps 3 under execprog. A missing executable returns -2 (ENOENT).
note Every environment entry is NAME=VALUE with a distinct NAME: qemu-user, which runs the x86linux
note build of this fixture, drops entries without '=' and repeated names from a guest's environment.
note Child mode (argv[1] is "child"), by argument count: 2 -> exit 0 for exactly the three entries,
note 30 for an empty environment, 40 for 32768 entries, 31 for another count, 32/33/34 for a wrong
note first/second/third entry; 32768 -> exit 42 when argv and environment both hold 32768 entries of
note 2031614 bytes in all (2097152-byte packets); 65 -> exit 44; 3 -> exit 45 when argv[2] has
note 4084 - len(argv0) bytes (a 4097-byte argv packet); 46 for any other shape.
note Parent exit: 0 when every check holds, otherwise the number of the first failed check.
om2
text tok "AIEN_COCKPIT_TOKEN=fixture-token-execenv"
text addr "AIEN_COCKPIT_ADDR=127.0.0.1:1"
text db "HIVE_DB_PATH=/nonexistent/hive.db"
text cmode "child"
text missing "/nonexistent/omega-execenv-missing"
global argv uchar 2097160
global envp uchar 4096
global bad uchar 2097160
global buf uchar 131072
global lim uchar 32
global status uchar 4

fn erec pos ulong s view uchar * to ulong
put envp pos uchar and len s 255
put envp add pos 1 uchar shr len s 8
for i ulong len s
put envp add add pos 2 i get s i
end
ret add add pos 2 len s
end

fn same i ulong s view uchar * to ulong
n = envread i buf 0 len buf
if ne n long len s
ret 0
end
for j ulong len s
if ne get buf j get s j
ret 0
end
end
ret 1
end

note Sum of the argv (k 0) or environment (k 1) entry lengths; every entry fits buf.
fn total k ulong c ulong to ulong
t = ulong 0
for i ulong c
n = long 0
if eq k 0
n = argread i buf 0 len buf
else
n = envread i buf 0 len buf
end
if lt n 0
ret 0
end
t = add t ulong n
end
ret t
end

fn child to int
a = ulong argcnt
if eq a 32768
if and eq envcnt 32768 and eq total 0 32768 2031614 eq total 1 32768 2031614
ret 42
end
ret 46
end
if eq a 65
ret 44
end
if eq a 3
m = argread 0 buf 0 len buf
r = argread 2 buf 0 len buf
if eq add r m 4084
ret 45
end
ret 46
end
c = ulong envcnt
if eq c 0
ret 30
end
if eq c 32768
ret 40
end
if ne c 3
ret 31
end
if eq same 0 tok 0
ret 32
end
if eq same 1 addr 0
ret 33
end
if eq same 2 db 0
ret 34
end
ret 0
end

note argv packet: [argv0, "child"]; returns its length.
fn mkargv to ulong
n = argread 0 buf 0 len buf
if le n 0
exit 90
end
m = ulong n
put argv 0 2
put argv 1 0
put argv 2 uchar and m 255
put argv 3 uchar shr m 8
for i ulong m
put argv add i 4 get buf i
end
pos = add m 4
put argv pos uchar len cmode
put argv add pos 1 0
for k ulong len cmode
put argv add add pos 2 k get cmode k
end
ret add add pos 2 len cmode
end

note The name "WXYZ=" of record i at bad[pos..pos+5): four letters A..P, the nibbles of i (distinct for
note i below 65536).
fn ename pos ulong i ulong to void
put bad pos uchar add 65 and shr i 12 15
put bad add pos 1 uchar add 65 and shr i 8 15
put bad add pos 2 uchar add 65 and shr i 4 15
put bad add pos 3 uchar add 65 and i 15
put bad add pos 4 61
end

note An environment of cnt records "WXYZ=" (u16 length 5) with distinct names; returns its length.
note cnt is at most 65535.
fn manya cnt ulong to ulong
put bad 0 uchar and cnt 255
put bad 1 uchar shr cnt 8
pos = ulong 2
for i ulong cnt
put bad pos 5
put bad add pos 1 0
ename add pos 2 i
pos = add pos 7
end
ret pos
end

note The largest environment: 32768 records "WXYZ=aaa..." of 62 bytes (the last two 61) with distinct
note names, 2097152 bytes in all, plus extra bytes on the last record; returns its length.
fn maxenv extra ulong to ulong
put bad 0 0
put bad 1 128
pos = ulong 2
for i ulong 32768
r = ulong 62
if ge i 32766
r = 61
end
if eq i 32767
r = add r extra
end
put bad pos uchar r
put bad add pos 1 0
ename add pos 2 i
for j ulong sub r 5
put bad add add pos 7 j 97
end
pos = add add pos 2 r
end
ret pos
end

note argv packet [argv0, "child", fillers...] of cnt records and exactly want bytes (the fillers are
note "a" runs of nearly equal length); returns its length.
fn bigargv cnt ulong want ulong to ulong
an = mkargv
put argv 0 uchar and cnt 255
put argv 1 uchar shr cnt 8
f = sub cnt 2
s = sub sub want an mul f 2
pos = an
for i ulong f
r = div s f
if lt i rem s f
r = add r 1
end
put argv pos uchar and r 255
put argv add pos 1 uchar shr r 8
for j ulong r
put argv add add pos 2 j 97
end
pos = add add pos 2 r
end
ret pos
end

note execenv with argv[0..an) and the environment bad[0..bn) in a forked child; returns its exit (97
note when the kernel refused the image with E2BIG).
fn tryboth an ulong bn ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execenv argv 0 an bad 0 bn
if eq r neg long 7
exit 97
end
exit 98
end
ret reap pid
end

note u64 little-endian at lim[pos..pos+8).
fn get64 pos ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get lim add pos i mul 8 i
end
ret v
end

fn put64 pos ulong v ulong to void
for i ulong 8
put lim add pos i uchar and shr v mul 8 i 255
end
end

note Raise the soft RLIMIT_STACK (3) to 64 MiB (hard limit kept) and read it back: 1 when it holds.
fn stackup to ulong
r = prlimit 0 3 lim 0 16
if ne r 0
ret 0
end
if lt get64 8 67108864
ret 0
end
put64 0 67108864
r = prlimit 0 3 lim 0 32
if ne r 0
ret 0
end
r = prlimit 0 3 lim 0 16
if ne r 0
ret 0
end
if ge get64 0 67108864
ret 1
end
ret 0
end

note The required child exit for maximal packets: d when the raised stack limit holds, else 97 (E2BIG).
fn okmax d ulong bg ulong to ulong
if eq bg 1
ret d
end
ret 97
end

note execprog with argv[0..an) in a forked child; returns its exit.
fn tryprog an ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execprog argv 0 an
exit 98
end
ret reap pid
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret 2000
end
ret ulong get status 1
end

note execenv with the environment packet bad[0..bn) in a forked child; returns the child's exit.
fn trybad an ulong bn ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execenv argv 0 an bad 0 bn
if eq r neg long 7
exit 97
end
exit 98
end
ret reap pid
end

note execenv with the argv packet bad[0..bn) and the valid environment envp[0..en) in a forked child.
fn tryargv bn ulong en ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execenv bad 0 bn envp 0 en
exit 98
end
ret reap pid
end

fn main to int
if gt argcnt 1
n = argread 1 buf 0 len buf
if ne n long len cmode
ret 35
end
for i ulong len cmode
if ne get buf i get cmode i
ret 35
end
end
ret child
end
bg = stackup
an = mkargv
put envp 0 3
put envp 1 0
en = erec 2 tok
en = erec en addr
en = erec en db
note 1: execenv delivers exactly the three entries.
pid = fork
if lt pid 0
ret 1
end
if eq pid 0
r = execenv argv 0 an envp 0 en
exit 98
end
if ne reap pid 0
ret 1
end
note 2: negative control, the same child through execprog sees no environment.
pid = fork
if lt pid 0
ret 2
end
if eq pid 0
r = execprog argv 0 an
exit 98
end
if ne reap pid 30
ret 2
end
note 3-9: malformed environment packets trap 3 before the kernel is asked.
put bad 0 0
put bad 1 0
if ne trybad an 2 103
ret 3
end
put bad 0 1
put bad 1 0
put bad 2 0
put bad 3 0
if ne trybad an 4 103
ret 4
end
put bad 2 3
put bad 3 0
put bad 4 65
put bad 5 61
put bad 6 49
put bad 7 120
if ne trybad an 8 103
ret 5
end
put bad 6 0
if ne trybad an 7 103
ret 6
end
put bad 2 5
if ne trybad an 5 103
ret 7
end
if ne trybad an 1 103
ret 8
end
if ne trybad an manya 32769 103
ret 9
end
note 10: count 32768 is accepted (count 32769 trapped above).
if ne trybad an manya 32768 40
ret 10
end
note 11-12: a 2097152-byte environment packet passes the decoder; 2097153 bytes trap 3.
if ne maxenv 0 2097152
ret 11
end
if ne trybad an maxenv 0 okmax 40 bg
ret 11
end
if ne maxenv 1 2097153
ret 12
end
if ne trybad an maxenv 1 103
ret 12
end
note 13: every environment record must be nonempty, not only the first: [A=1, ""] traps 3.
put bad 0 2
put bad 1 0
put bad 2 3
put bad 3 0
put bad 4 65
put bad 5 61
put bad 6 49
put bad 7 0
put bad 8 0
if ne trybad an 9 103
ret 13
end
note 14: the argv packet keeps execprog's rules: an empty program path traps 3 with a valid environment.
put bad 0 1
put bad 1 0
put bad 2 0
put bad 3 0
if ne tryargv 4 en 103
ret 14
end
note 15: a valid argv packet whose program is missing: execenv returns -2 (ENOENT).
put bad 0 1
put bad 1 0
put bad 2 uchar len missing
put bad 3 0
for i ulong len missing
put bad add i 4 get missing i
end
r = execenv bad 0 add len missing 4 envp 0 en
if ne r neg long 2
ret 15
end
note 16: both packets at the maximum, 32768 records and 2097152 bytes each, reach the child intact
note (or meet E2BIG when the stack limit could not be raised).
bn = maxenv 0
if ne tryboth bigargv 32768 2097152 bn okmax 42 bg
ret 16
end
note 17: argv packets of 32769 records or 2097153 bytes trap 3 (with the valid environment).
put bad 0 1
put bad 1 0
put bad 2 uchar len tok
put bad 3 0
for i ulong len tok
put bad add i 4 get tok i
end
bn = add len tok 4
if ne tryboth bigargv 32769 2097152 bn 103
ret 17
end
if ne tryboth bigargv 32768 2097153 bn 103
ret 17
end
note 18: execprog keeps 64 records and 4096 bytes: 65 records and a 4097-byte argv run under execenv
note but trap 3 under execprog.
if ne tryboth bigargv 65 4096 bn 44
ret 18
end
if ne tryprog bigargv 65 4096 103
ret 18
end
if ne tryboth bigargv 3 4097 bn 45
ret 18
end
if ne tryprog bigargv 3 4097 103
ret 18
end
note control: the same 64-record and 4096-byte argv still runs under execprog (child exit 30, empty env).
if ne tryprog bigargv 64 4096 30
ret 18
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/host/execenv/execenv.om: fixture for execenv (keyword 233), program mode. Run by the OM-2
note conductor through seed/host/execenv/execenv.cases from the repository root, without arguments.
note Parent mode packs argv [argv0, "child"] and an environment of exactly three records, runs itself
note through execenv in a forked child and requires child exit 0: the child saw exactly those three
note entries, in packet order. The same child run through execprog must see an empty environment
note (child exit 30): the negative control. Malformed environment packets trap 3 (exit 103) in a forked
note child. The 64-record and 4096-byte boundaries are accepted: the child runs and reports 64 entries
note (exit 40) or the one 4092-byte entry (exit 41). A missing executable returns -2 (ENOENT) to the
note caller. Every boundary entry is NAME=VALUE with a distinct NAME: qemu-user, which runs the
note x86linux build of this fixture, drops entries without '=' and repeated names from a guest's
note environment.
note Child mode (argv[1] is "child"): exit 0 for exactly the three entries, 30 for an empty
note environment, 40 for 64 entries, 41 for one 4092-byte entry, 31 for another count, and 32/33/34
note for a wrong first/second/third entry.
note Parent exit: 0 when every check holds, otherwise the number of the first failed check.
om2
text tok "AIEN_COCKPIT_TOKEN=fixture-token-execenv"
text addr "AIEN_COCKPIT_ADDR=127.0.0.1:1"
text db "HIVE_DB_PATH=/nonexistent/hive.db"
text cmode "child"
text missing "/nonexistent/omega-execenv-missing"
global argv uchar 4096
global envp uchar 4096
global bad uchar 8192
global buf uchar 4096
global status uchar 4

fn erec pos ulong s view uchar * to ulong
put envp pos uchar and len s 255
put envp add pos 1 uchar shr len s 8
for i ulong len s
put envp add add pos 2 i get s i
end
ret add add pos 2 len s
end

fn same i ulong s view uchar * to ulong
n = envread i buf 0 len buf
if ne n long len s
ret 0
end
for j ulong len s
if ne get buf j get s j
ret 0
end
end
ret 1
end

fn child to int
c = ulong envcnt
if eq c 0
ret 30
end
if eq c 64
ret 40
end
if eq c 1
if eq envread 0 buf 0 len buf 4092
ret 41
end
end
if ne c 3
ret 31
end
if eq same 0 tok 0
ret 32
end
if eq same 1 addr 0
ret 33
end
if eq same 2 db 0
ret 34
end
ret 0
end

note argv packet: [argv0, "child"]; returns its length.
fn mkargv to ulong
n = argread 0 buf 0 len buf
if le n 0
exit 90
end
m = ulong n
put argv 0 2
put argv 1 0
put argv 2 uchar and m 255
put argv 3 uchar shr m 8
for i ulong m
put argv add i 4 get buf i
end
pos = add m 4
put argv pos uchar len cmode
put argv add pos 1 0
for k ulong len cmode
put argv add add pos 2 k get cmode k
end
ret add add pos 2 len cmode
end

note An environment of cnt records "XY=" (u16 length 3) with distinct names XY in AA..HH; returns
note its length. cnt is at most 64.
fn manya cnt ulong to ulong
put bad 0 uchar and cnt 255
put bad 1 0
pos = ulong 2
for i ulong cnt
put bad pos 3
put bad add pos 1 0
put bad add pos 2 uchar add 65 shr i 3
put bad add pos 3 uchar add 65 and i 7
put bad add pos 4 61
pos = add pos 5
end
ret pos
end

note One record "A=AAA..." of rn bytes (u16 length rn); returns the packet length 4 + rn.
fn onelong rn ulong to ulong
put bad 0 1
put bad 1 0
put bad 2 uchar and rn 255
put bad 3 uchar shr rn 8
for i ulong rn
put bad add i 4 65
end
put bad 5 61
ret add rn 4
end

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret 2000
end
ret ulong get status 1
end

note execenv with the environment packet bad[0..bn) in a forked child; returns the child's exit.
fn trybad an ulong bn ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execenv argv 0 an bad 0 bn
exit 98
end
ret reap pid
end

note execenv with the argv packet bad[0..bn) and the valid environment envp[0..en) in a forked child.
fn tryargv bn ulong en ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execenv bad 0 bn envp 0 en
exit 98
end
ret reap pid
end

fn main to int
if eq argcnt 2
n = argread 1 buf 0 len buf
if ne n long len cmode
ret 35
end
for i ulong len cmode
if ne get buf i get cmode i
ret 35
end
end
ret child
end
if ne argcnt 1
ret 36
end
an = mkargv
put envp 0 3
put envp 1 0
en = erec 2 tok
en = erec en addr
en = erec en db
note 1: execenv delivers exactly the three entries.
pid = fork
if lt pid 0
ret 1
end
if eq pid 0
r = execenv argv 0 an envp 0 en
exit 98
end
if ne reap pid 0
ret 1
end
note 2: negative control, the same child through execprog sees no environment.
pid = fork
if lt pid 0
ret 2
end
if eq pid 0
r = execprog argv 0 an
exit 98
end
if ne reap pid 30
ret 2
end
note 3-9: malformed environment packets trap 3 before the kernel is asked.
put bad 0 0
put bad 1 0
if ne trybad an 2 103
ret 3
end
put bad 0 1
put bad 1 0
put bad 2 0
put bad 3 0
if ne trybad an 4 103
ret 4
end
put bad 2 3
put bad 3 0
put bad 4 65
put bad 5 61
put bad 6 49
put bad 7 120
if ne trybad an 8 103
ret 5
end
put bad 6 0
if ne trybad an 7 103
ret 6
end
put bad 2 5
if ne trybad an 5 103
ret 7
end
if ne trybad an 1 103
ret 8
end
if ne trybad an manya 65 103
ret 9
end
note 10: count 64 is accepted (count 65 trapped above).
if ne trybad an manya 64 40
ret 10
end
note 11-12: a 4096-byte environment packet is accepted; 4097 bytes trap 3.
if ne trybad an onelong 4092 41
ret 11
end
if ne trybad an onelong 4093 103
ret 12
end
note 13: every environment record must be nonempty, not only the first: [A=1, ""] traps 3.
put bad 0 2
put bad 1 0
put bad 2 3
put bad 3 0
put bad 4 65
put bad 5 61
put bad 6 49
put bad 7 0
put bad 8 0
if ne trybad an 9 103
ret 13
end
note 14: the argv packet keeps execprog's rules: an empty program path traps 3 with a valid environment.
put bad 0 1
put bad 1 0
put bad 2 0
put bad 3 0
if ne tryargv 4 en 103
ret 14
end
note 15: a valid argv packet whose program is missing: execenv returns -2 (ENOENT).
put bad 0 1
put bad 1 0
put bad 2 uchar len missing
put bad 3 0
for i ulong len missing
put bad add i 4 get missing i
end
r = execenv bad 0 add len missing 4 envp 0 en
if ne r neg long 2
ret 15
end
ret 0
end

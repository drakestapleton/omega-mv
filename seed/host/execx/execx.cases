# seed/host/execx/execx.cases: execx (keyword 240), run by the OM-2 conductor
# (seed/qualification/om2/gate.om) from seed/host/check.sh. Expected: OM2GATE PASS cases=17.
# fixture: the word's .om fixture on AArch64 (parent exit 0 = every check holds; see its notes).
# echo: execx runs /bin/echo with 2000 arguments (2002 argv records); stdout must equal echo.want.
# x86-fixture, x86-echo: the same sources for x86linux through binfmt qemu-x86_64 (emulator evidence, not
# hardware qualification). Each mutant compiler is built from seed/omc/omc.om with one emission
# changed; the fixture built by it must fail at the named check (exit = check number).
deadline 120
fixture run seed/host/execx/execx.om - - - 0
x86-fixture run seed/host/execx/x86-target.om+seed/host/execx/execx.om - - - 0
echo run seed/host/execx/echo.om - file:seed/host/execx/echo.want - 0
x86-echo run seed/host/execx/x86-target.om+seed/host/execx/echo.om - file:seed/host/execx/echo.want - 0
fnmode refuse seed/host/execx/fnmode.om 9
x86-fnmode refuse seed/host/execx/x86-target.om+seed/host/execx/fnmode.om 9
contract refuse seed/host/execx/contract.om 30
intkeep refuse seed/host/execx/intkeep.om 7
efi refuse seed/host/execx/efi-target.om+seed/host/execx/use.om 25
subst seed/host/execx/mutants/a64-argv0.from seed/host/execx/mutants/a64-argv0.to
cc seed/omc/omc.om
mut-a64-argv0 run seed/host/execx/execx.om - - - 1
cc pinned
subst seed/host/execx/mutants/a64-range.from seed/host/execx/mutants/a64-range.to
cc seed/omc/omc.om

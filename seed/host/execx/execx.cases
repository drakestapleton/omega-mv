cc seed/omc/omc.om
mut-a64-kcap run seed/host/execx/execx.om - - - 6
cc pinned
subst seed/host/execx/mutants/a64-count.from seed/host/execx/mutants/a64-count.to
cc seed/omc/omc.om
mut-a64-count run seed/host/execx/execx.om - - - 7
cc pinned
subst seed/host/execx/mutants/x86-argv0.from seed/host/execx/mutants/x86-argv0.to
cc seed/omc/omc.om
mut-x86-argv0 run seed/host/execx/x86-target.om+seed/host/execx/execx.om - - - 1
cc pinned
subst seed/host/execx/mutants/x86-range.from seed/host/execx/mutants/x86-range.to
cc seed/omc/omc.om
mut-x86-range run seed/host/execx/x86-target.om+seed/host/execx/execx.om - - - 1
cc pinned
subst seed/host/execx/mutants/x86-kcap.from seed/host/execx/mutants/x86-kcap.to
cc seed/omc/omc.om
mut-x86-kcap run seed/host/execx/x86-target.om+seed/host/execx/execx.om - - - 6

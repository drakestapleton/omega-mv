note SPDX-License-Identifier: Apache-2.0
note seed/host/execx/execx.om: fixture for execx (keyword 240), program mode. Run by the OM-2 conductor
note through seed/host/execx/execx.cases from the repository root, without arguments.
note A forked child F puts /dev/null on descriptors 0 and 3..9 and runs execx with the argv packet
note [path, "omega-execx-argv0", "x", mode] (path = this program, from argread 0, so path differs from
note argv[0]), the environment ["A=1"] and a keep list chosen by mode. The new image (argcnt 3, argv[1]
note "x") requires: argv[0] is exactly "omega-execx-argv0" (exit 22), descriptor 0 is open (exit 23),
note each of 3..9 is open exactly when the mode keeps it (flock d 8: 0 open, -9 closed; exit 30 + d),
note and the environment is exactly "A=1" (exit 25). Bad mode or arguments exit 26.
note Modes and keep lists: a [7, 5] (unordered: 5 and 7 open, 3 4 6 8 9 closed), b [] (empty: every
note descriptor from 3 closed, as execenv), c [3] (the first close is skipped), d [9, 1, 9] (a byte below 3
note and a duplicate: only 9 open).
note Checks (parent exit = number of the first failed check, 0 when all hold):
note 1..4 modes a, b, c, d: the new image proves every rule above (F exit 0).
note 5 a missing program with keep [5] returns -2 (ENOENT) to F after the closes: 4 and 6 closed, 5 and 0
note   open in F.
note 6 a keep list of 65 bytes traps 3 (exit 103) before any descriptor closes.
note 7 an argv packet holding only the path (no argv[0]) traps 3 (exit 103).
note 8 an environment packet of 32769 records traps 3 (exit 103).
note 9 an argv packet of 32769 records traps 3, and one of 2097153 bytes traps 3 (exit 103).
note 10 the largest argv packets pass the decoder to the kernel: 32768 records naming the missing
note   program "a" return -2 (ENOENT); 2097152 bytes return -2 or -7 (E2BIG under an 8 MiB stack limit).
note seed/host/execx/echo.om (its own case) runs /bin/echo with 2000 arguments through execx.
om2
text marker "omega-execx-argv0"
text cmx "x"
text one "A=1"
text devnull "/dev/null"
text missing "/nonexistent/omega-execx-missing"
global argv uchar 4096
global envp uchar 16
global keep uchar 128
global bad uchar 2097160
global buf uchar 4096
global status uchar 4

fn reap pid long to ulong
r = waitpid int pid status 0 len status 0
if ne r pid
ret 1000
end
if ne get status 0 0
ret add 2000 ulong and get status 0 127
end
ret ulong get status 1
end

note Append one u16-length record buf[0..n) to argv at pos; returns the new end.
fn rec pos ulong n ulong to ulong
put argv pos uchar and n 255
put argv add pos 1 uchar shr n 8
for i ulong n
put argv add add pos 2 i get buf i
end
ret add add pos 2 n
end

note argv packet [path, marker, "x", mode] with path = argv[0] of this program (miss 0) or the missing
note program (miss 1); returns its length.
fn mkargv mode uchar miss ulong to ulong
put argv 0 4
put argv 1 0
pos = ulong 2
if eq miss 0
n = argread 0 buf 0 len buf
if le n 0
exit 90
end
pos = rec pos ulong n
else
for k ulong len missing
put buf k get missing k
end
pos = rec pos len missing
end
for i ulong len marker
put buf i get marker i
end
pos = rec pos len marker
put buf 0 get cmx 0
pos = rec pos 1
put buf 0 mode
ret rec pos 1
end

note The environment packet ["A=1"]; returns its length.
fn mkenv to ulong
put envp 0 1
put envp 1 0
put envp 2 uchar len one
put envp 3 0
for i ulong len one
put envp add i 4 get one i
end
ret add len one 4
end

note 1 when argv[i] equals s.
fn argis i ulong s view uchar * to ulong
n = argread i buf 0 len buf
if ne n long len s
ret 0
end
for j ulong len s
if ne get buf j get s j
ret 0
end
end
ret 1
end

note 1 when mode m keeps descriptor d.
fn kept m uchar d ulong to ulong
if eq m 97
if or eq d 5 eq d 7
ret 1
end
ret 0
end
if eq m 99
if eq d 3
ret 1
end
ret 0
end
if eq m 100
if eq d 9
ret 1
end
ret 0
end
ret 0
end

note The new image: argv [marker, "x", mode].
fn child to int
if eq argis 0 marker 0
ret 22
end
n = argread 2 buf 0 len buf
if ne n 1
ret 26
end
m = get buf 0
if or lt m 97 gt m 100
ret 26
end
if ne flock 0 8 0
ret 23
end
for i ulong 7
d = add i 3
r = flock int d 8
if eq kept m d 1
if ne r 0
ret int add 30 d
end
else
if ne r neg long 9
ret int add 30 d
end
end
end
if ne envcnt 1
ret 25
end
e = envread 0 buf 0 len buf
if ne e long len one
ret 25
end
for j ulong len one
if ne get buf j get one j
ret 25
end
end
ret 0
end

note Open /dev/null on descriptor k (dup3 when the kernel chose another); 1 on success.
fn putfd k ulong to ulong
fd = fopen devnull 0 len devnull 0 0
if lt fd 0
ret 0
end
if ne ulong fd k
d = dupfd int fd int k 0
c = fclose int fd
if ne d long k
ret 0
end
end
ret 1
end

note keep[0..kn) for mode m; returns kn.
fn mkkeep m uchar to ulong
if eq m 97
put keep 0 7
put keep 1 5
ret 2
end
if eq m 99
put keep 0 3
ret 1
end
if eq m 100
put keep 0 9
put keep 1 1
put keep 2 9
ret 3
end
if eq m 101
put keep 0 5
ret 1
end
ret 0
end

note F: /dev/null on 0 and 3..9, then execx in mode m (a..d), or (m = e) execx of a missing program
note keeping 5, then checks the descriptors itself. Returns F's exit.
fn runf m uchar to ulong
miss = ulong 0
if eq m 101
miss = ulong 1
end
an = mkargv m miss
en = mkenv
kn = mkkeep m
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
if eq putfd 0 0
exit 91
end
for i ulong 7
if eq putfd add i 3 0
exit 92
end
end
r = execx argv 0 an envp 0 en keep 0 kn
if eq miss 0
exit 97
end
if ne r neg long 2
exit 81
end
if ne flock 4 8 neg long 9
exit 82
end
if ne flock 6 8 neg long 9
exit 83
end
if ne flock 5 8 0
exit 84
end
if ne flock 0 8 0
exit 85
end
exit 0
end
ret reap pid
end

note A forked child runs execx with argv[0..an), the environment bad[0..bn) and keep[0..kn); returns
note its exit (103 for trap 3).
fn trapkid an ulong bn ulong kn ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execx argv 0 an bad 0 bn keep 0 kn
exit 98
end
ret reap pid
end

note argv packet in bad: cnt records, the program "a" (a missing relative path) and cnt-1 runs of "a" of
note nearly equal length, exactly want bytes in all (each run at most 65535); returns want.
fn abig cnt ulong want ulong to ulong
put bad 0 uchar and cnt 255
put bad 1 uchar shr cnt 8
put bad 2 1
put bad 3 0
put bad 4 97
f = sub cnt 1
s = sub sub want 5 mul f 2
pos = ulong 5
for i ulong f
r = div s f
if lt i rem s f
r = add r 1
end
put bad pos uchar and r 255
put bad add pos 1 uchar shr r 8
for j ulong r
put bad add add pos 2 j 97
end
pos = add add pos 2 r
end
ret pos
end

note A forked child runs execx with argv bad[0..bn), the environment envp[0..en) and no keep list;
note exit 0 when the kernel answered -2 (ENOENT) or -7 (E2BIG), 98 for another result, 103 for trap 3.
fn bigkid bn ulong en ulong to ulong
pid = fork
if lt pid 0
ret 1001
end
if eq pid 0
r = execx bad 0 bn envp 0 en keep 0 0
if or eq r neg long 2 eq r neg long 7
exit 0
end
exit 98
end
ret reap pid
end

fn main to int
if eq argcnt 3
if eq argis 1 cmx 1
ret child
end
ret 36
end
if ne argcnt 1
ret 36
end
if ne runf 97 0
ret 1
end
if ne runf 98 0
ret 2
end
if ne runf 99 0
ret 3
end
if ne runf 100 0
ret 4
end
if ne runf 101 0
ret 5
end
an = mkargv 98 0
en = mkenv
for i ulong en
put bad i get envp i
end
for k ulong 65
put keep k 5
end
if ne trapkid an en 65 103
ret 6
end
put argv 0 1
a1 = add 4 or ulong get argv 2 shl ulong get argv 3 8
if ne trapkid a1 en 0 103
ret 7
end
put argv 0 4
put bad 0 1
put bad 1 128
pos = ulong 2
for j ulong 32769
put bad pos 3
put bad add pos 1 0
put bad add pos 2 uchar add 65 and shr j 5 31
put bad add pos 3 uchar add 65 and j 31
put bad add pos 4 61
pos = add pos 5
end
if ne trapkid an pos 0 103
ret 8
end
note 9: argv packets above the caps trap 3.
en = mkenv
if ne bigkid abig 32769 98309 en 103
ret 9
end
if ne bigkid abig 64 2097153 en 103
ret 9
end
note 10: argv packets at the caps reach the kernel.
if ne bigkid abig 32768 98306 en 0
ret 10
end
if ne bigkid abig 64 2097152 en 0
ret 10
end
ret 0
end

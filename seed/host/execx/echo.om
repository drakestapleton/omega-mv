note SPDX-License-Identifier: Apache-2.0
note seed/host/execx/echo.om: execx (keyword 240) runs /bin/echo with 2000 arguments, the decimal numbers
note 1..2000, after argv[0] "echo": an argv packet of 2002 records (path, argv[0], 2000 arguments), above
note the 1024 records the word allowed before. The environment is ["A=1"] and the keep list empty, so
note descriptors 0..2 pass through and /bin/echo writes to this program's stdout. Run by the OM-2
note conductor through seed/host/execx/execx.cases; stdout must equal seed/host/execx/echo.want (made by
note seq -s ' ' 1 2000), exit 0 (echo's). The count 2002 is packed as bytes 210, 7. A failed execx exits 90.
om2
text path "/bin/echo"
text a0 "echo"
text one "A=1"
global argv uchar 16384
global envp uchar 16
global keep uchar 1
global buf uchar 16

note Append one u16-length record buf[0..n) to argv at pos; returns the new end.
fn rec pos ulong n ulong to ulong
put argv pos uchar and n 255
put argv add pos 1 uchar shr n 8
for i ulong n
put argv add add pos 2 i get buf i
end
ret add add pos 2 n
end

note Copy s into buf; returns its length.
fn tobuf s view uchar * to ulong
for i ulong len s
put buf i get s i
end
ret len s
end

note The decimal digits of v (v at least 1) into buf; returns their count.
fn dec v ulong to ulong
n = ulong 0
t = v
while gt t 0
n = add n 1
t = div t 10
end
t = v
for i ulong n
put buf sub sub n 1 i uchar add 48 rem t 10
t = div t 10
end
ret n
end

fn main to int
put argv 0 210
put argv 1 7
pos = rec 2 tobuf path
pos = rec pos tobuf a0
for i ulong 2000
pos = rec pos dec add i 1
end
put envp 0 1
put envp 1 0
put envp 2 uchar len one
put envp 3 0
for k ulong len one
put envp add k 4 get one k
end
r = execx argv 0 pos envp 0 add len one 4 keep 0 0
ret 90
end

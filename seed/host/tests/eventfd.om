note Safe host behavior only: no VFIO or GPU paths. Helpers precede creation to exercise lifecycle codegen.
global buf uchar 8
global arg uchar 8
fn ck b bool to void
if not b
exit int 80
end
end
fn shut fd int to void
ck eq fclose fd 0
end
fn main to int
fd = int eventfd uint 0
ck ge fd 0
ck eq waitio fd 1 0 0
ck eq read fd buf 0 8 neg long 11
put buf 0 uchar 7
ck eq write fd buf 0 8 8
ck eq waitio fd 1 0 1
ck eq read fd buf 0 8 8
ck eq get buf 0 uchar 7
for i ulong 7
ck eq get buf add i 1 uchar 0
end
ck eq waitio fd 1 0 0
ck eq read fd buf 0 8 neg long 11
if gt argcnt 1
n = argread 1 arg 0 8
ck eq n 1
if eq get arg 0 uchar 49
r = vfioirq fd uint 15213 buf 0 8
ret int r
end
if eq get arg 0 uchar 50
for i ulong 127
more = eventfd uint 0
ck ge more 0
end
ck eq eventfd uint 0 neg long 24
end
end
shut fd
ck eq read fd buf 0 8 neg long 9
initial = int eventfd uint 7
ck ge initial 0
ck eq read initial buf 0 8 8
ck eq get buf 0 uchar 7
shut initial
ret 0
end

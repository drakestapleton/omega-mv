note Host-only executable fixture. A ptrace oracle supplies a fake GET_DEVICE_FD result using our memfd.
note Every IRQ ioctl really executes on that non-VFIO fd and must return ENOTTY. No device path is opened.
global data uchar 276
global args uchar 8
text name "irq-fixture"
text dev "fixture"
fn ck b bool to void
if not b
exit int 80
end
end
fn put32 off ulong v uint to void
for i ulong 4
put data add off i uchar and shr v uint mul i 8 255
end
end
fn clear to void
for i ulong 276
put data i uchar 0
end
end
fn sethdr sz uint flags uint start uint count uint to void
clear
put32 0 sz
put32 4 flags
put32 8 0
put32 12 start
put32 16 count
end
fn shut fd int to void
ck eq fclose fd 0
end
fn main to int
mode = uint 0
if gt argcnt 1
ck eq argread 1 args 0 8 1
mode = sub uint get args 0 48
end
group = int memfd name 0 len name 1
ck ge group 0
fd = int vfioctl group uint 15210 dev 0 len dev
ck eq fd group
efd = int eventfd uint 0
ck ge efd 0
if eq mode 15
for i ulong 126
more = eventfd uint 0
ck ge more 0
end
ck eq vfioctl group uint 15210 dev 0 len dev neg long 24
ret 0
end
if ge mode 16
sethdr 276 36 0 64
for i ulong 64
put32 add 20 mul 4 i uint efd
end
if eq mode 17
put32 272 uint fd
end
rr = vfioirq fd uint 15214 data 0 276
ck eq rr neg long 25
ret 0
end
if eq mode 1
fd = efd
end
put32 0 16
if eq mode 2
put32 0 15
end
if le mode 2
r = vfioirq fd uint 15213 data 0 16
ck eq r neg long 25
end
if eq mode 0
sethdr 24 36 0 1
put32 20 uint efd
ck eq vfioirq fd uint 15214 data 0 24 neg long 25
sethdr 24 36 0 1
put32 20 4294967295
ck eq vfioirq fd uint 15214 data 0 24 neg long 25
sethdr 20 33 0 0
ck eq vfioirq fd uint 15214 data 0 20 neg long 25
sethdr 20 9 0 1
ck eq vfioirq fd uint 15214 data 0 20 neg long 25
sethdr 20 17 0 1
ck eq vfioirq fd uint 15214 data 0 20 neg long 25
note Failed dup3 must preserve the tracked target.
ck eq dupfd neg int 1 fd 0 neg long 9
put32 0 16
ck eq vfioirq fd uint 15213 data 0 16 neg long 25
shut efd
shut fd
ret 0
end
sethdr 24 36 0 1
put32 20 uint efd
nbytes = ulong 24
if eq mode 3
sethdr 20 9 0 65
nbytes = ulong 20
end
if eq mode 4
put32 0 23
end
if eq mode 5
put32 20 uint fd
end
if eq mode 6
shut efd
end
if eq mode 7
sethdr 20 18 0 1
nbytes = ulong 20
end
if eq mode 8
put32 12 4294967295
end
if eq mode 9
sethdr 20 36 0 0
nbytes = ulong 20
end
if eq mode 10
shut fd
freshfd = int memfd name 0 len name 1
ck eq freshfd fd
end
if eq mode 11
ck eq dupfd efd fd 0 long fd
end
if eq mode 12
sethdr 20 33 1 0
nbytes = ulong 20
end
if eq mode 13
sethdr 20 9 0 0
nbytes = ulong 20
end
if eq mode 14
nbytes = ulong 23
end
r = vfioirq fd uint 15214 data 0 nbytes
ret int r
end

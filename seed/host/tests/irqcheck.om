note Exact compile refusal conductor; follows vfiocheck's native fork/exec convention.
text infile "case.om"
text outfile "case.elf"
text errfile "case.err"
text passed "PASS 10 typed IRQ and eventfd compiler refusals\n"
text a "fn main to int\nr = eventfd int 0\nret 0\nend\n"
text b "fn test to long\nret eventfd uint 0\nend\n"
text c "global a uchar 32\nfn main to int\nr = vfioirq int 1 uint 15215 a 0 16\nret 0\nend\n"
text d "global a uchar 32\nfn main to int\nq = uint 15213\nr = vfioirq int 1 q a 0 16\nret 0\nend\n"
text e "global a uint 32\nfn main to int\nr = vfioirq int 1 uint 15213 a 0 16\nret 0\nend\n"
text f "text a \"readonly buffer!\"\nfn main to int\nr = vfioirq int 1 uint 15213 a 0 16\nret 0\nend\n"
text g "global a uchar 32\nfn main to int\nr = vfioirq long 1 uint 15213 a 0 16\nret 0\nend\n"
text h "global a uchar 32\nfn main to int\nr = vfioirq int 1 ulong 15213 a 0 16\nret 0\nend\n"
text j "fn test a edit uchar 32 to long\nret vfioirq int 1 uint 15213 a 0 16\nend\n"
text k "om2\nfn main to int\nrequires eq eventfd uint 0 0\nret 0\nend\n"
global packet uchar 4096
global status uchar 4
fn expect yes bool to void
if not yes
exit int 80
end
end
fn source num int fd int to int
r = long 0
want = int 7
if eq num 0
r = write fd a 0 len a
end
if eq num 1
r = write fd b 0 len b
want = 9
end
if eq num 2
r = write fd c 0 len c
want = 9
end
if eq num 3
r = write fd d 0 len d
want = 9
end
if eq num 4
r = write fd e 0 len e
end
if eq num 5
r = write fd f 0 len f
want = 20
end
if eq num 6
r = write fd g 0 len g
end
if eq num 7
r = write fd h 0 len h
end
if eq num 8
r = write fd j 0 len j
want = 9
end
if eq num 9
r = write fd k 0 len k
want = 30
end
expect gt r 0
ret want
end
fn main to int
expect eq argcnt 2
size = argread 1 packet 4 4092
expect and gt size 0 le size 4092
put packet 0 1
put packet 2 uchar and size 255
put packet 3 uchar shr size 8
for num int 10
input = fopen infile 0 len infile 524482 384
output = fopen outfile 0 len outfile 524482 384
errors = fopen errfile 0 len errfile 524482 384
expect ge input 0
expect ge output 0
expect ge errors 0
want = source num int input
expect eq fseek int input 0 0 0
pid = fork
expect ge pid 0
if eq pid 0
expect eq dupfd int input 0 0 0
expect eq dupfd int output 1 0 1
expect eq dupfd int errors 2 0 2
r = execprog packet 0 add ulong size 4
exit int 81
end
expect eq waitpid int pid status 0 4 0 pid
if ne get status 0 0
ret add num 1
end
if ne get status 1 uchar want
ret add num 1
end
expect eq fclose int input 0
expect eq fclose int output 0
expect eq fclose int errors 0
expect eq unlink infile 0 len infile 0
expect eq unlink outfile 0 len outfile 0
expect eq unlink errfile 0 len errfile 0
end
expect eq write 1 passed 0 len passed long len passed
ret 0
end

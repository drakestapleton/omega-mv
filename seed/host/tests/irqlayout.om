om2
note Measured against GCC linux/vfio.h sizeof/offsetof oracle. This is wire layout, not an Omega struct.
layout IrqInfo 16
field argsz uint at 0 little
field flags uint at 4 little
field index uint at 8 little
field count uint at 12 little
end
layout IrqSet 24
field argsz uint at 0 little
field flags uint at 4 little
field index uint at 8 little
field start uint at 12 little
field count uint at 16 little
field event int at 20 little
end
fn info b edit IrqInfo to void
put b argsz uint 16
put b flags uint 3
put b index uint 2
put b count uint 64
end
fn setup b edit IrqSet to void
put b argsz uint 24
put b flags uint 36
put b index uint 2
put b start uint 3
put b count uint 1
put b event int -1
end
fn main to int
ib = new uchar 16 0
sb = new uchar 24 0
info ib
setup sb
if ne write 1 ib 0 16 16
ret 1
end
if ne write 1 sb 0 24 24
ret 2
end
ret 0
end

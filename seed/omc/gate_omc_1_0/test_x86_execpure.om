target x86linux
om2
text errp "X86_EXECPURE_ERR="
fn main to int
if lt argcnt 2
exit 91
end
arg = new uchar 256 0
n = argread 1 arg 0 256
if le n 0
exit 92
end
un = ulong n
pkt = new uchar 264 0
put pkt 0 1
put pkt 1 0
put pkt 2 uchar and un 255
put pkt 3 uchar and shr un 8 255
for i ulong un bound 256
put pkt add 4 i get arg i
end
r = execpure pkt 0 add 4 un
note execpure only returns on error (fail-closed without running unconfined exec).
w = write 1 errp 0 len errp
neg_r = sub long 0 r
if and gt neg_r 0 lt neg_r 126
exit int add 128 neg_r
end
exit 93
end

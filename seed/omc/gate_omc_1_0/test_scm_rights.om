om2
note Pure seeded OM-2 live SCM_RIGHTS (sendfd/recvfd) verification test.
note Modes (argv[1]):
note   (none)             -> positive sendfd+recvfd memfd transfer + no-fd (-1) negative control
note   trap-sendfd-zero   -> sendfd with n=0 must trap 3 (exit 103)
note   trap-recvfd-short  -> recvfd with OUT_FD len=3 (<4) must trap 3 (exit 103)
note   trap-sendfd-oob    -> sendfd with off+n > len(A) must trap 3 (exit 103)

global mode uchar 64
global buf uchar 8
global rbuf uchar 32
global outf uchar 4
global addr uchar 32
global mread uchar 32

text mname "omc10_shm"
text mdata "OMEGA_SCM_RIGHTS_OK\n"
text p1 "FD_PASS!"
text p2 "NO_FD"
text s_ok "SCM_RIGHTS_PASS\n"
text s_m1 "trap-sendfd-zero"
text s_m2 "trap-recvfd-short"
text s_m3 "trap-sendfd-oob"

fn outf_u32 to uint
u = ulong get outf 0
u = or u shl ulong get outf 1 8
u = or u shl ulong get outf 2 16
u = or u shl ulong get outf 3 24
ret uint u
end

fn eq_mode alen ulong b view uchar * to bool
if ne alen len b
ret false
end
for i ulong alen bound 64
if ne get mode i get b i
ret false
end
end
ret true
end

fn main to int
mlen = ulong 0
if gt argcnt 1
r = argread 1 mode 0 64
if gt r 0
mlen = ulong r
end
end
if eq_mode mlen s_m1
z = sendfd int 3 int 4 buf 0 0
ret 1
end
if eq_mode mlen s_m2
z = recvfd int 3 rbuf 0 8 outf 0 3
ret 1
end
if eq_mode mlen s_m3
z = sendfd int 3 int 4 buf 4 8
ret 1
end

note Create abstract Unix domain socket address: AF_UNIX (1,0) + NUL + unique name using pid.
put addr 0 1
put addr 1 0
put addr 2 0
put addr 3 111
put addr 4 109
put addr 5 99
put addr 6 49
put addr 7 48
put addr 8 95
pid = ulong getpid
for i ulong 8 bound 8
d = rem pid 10
put addr add 9 i uchar add 48 d
pid = div pid 10
end

srv = socknew 1 1 0
if lt srv 0
exit 11
end
rc = bind int srv addr 0 17
if lt rc 0
exit 12
end
rc = listen int srv 4
if lt rc 0
exit 13
end

cli = socknew 1 1 0
if lt cli 0
exit 14
end
rc = connect int cli addr 0 17
if lt rc 0
exit 15
end

conn = accept int srv 0
if lt conn 0
exit 16
end

note Create memfd and write known 20-byte payload.
mfd = memfd mname 0 len mname 0
if lt mfd 0
exit 17
end
rc = pwrite int mfd mdata 0 len mdata long 0
if ne rc long len mdata
exit 18
end

note Positive test 1: sendfd passes mfd + 8-byte payload across Unix domain socket.
rc = sendfd int cli int mfd p1 0 len p1
if ne rc long len p1
exit 19
end

put outf 0 17
put outf 1 34
put outf 2 51
put outf 3 68
rc = recvfd int conn rbuf 0 32 outf 0 4
if ne rc long len p1
exit 20
end
for i ulong len p1 bound 16
if ne get rbuf i get p1 i
exit 21
end
end

got_u = outf_u32
if or lt got_u 3 gt got_u 1000000
exit 22
end
got_fd = int got_u
if eq got_fd int mfd
exit 22
end

note Read back memfd contents through the received file descriptor.
rc = pread got_fd mread 0 len mdata long 0
if ne rc long len mdata
exit 23
end
for i ulong len mdata bound 32
if ne get mread i get mdata i
exit 24
end
end

note Negative control: sendmsg without ancillary fd -> recvfd must write -1 (0xffffffff).
put outf 0 17
put outf 1 34
put outf 2 51
put outf 3 68
rc = sendmsg int cli p2 0 len p2 0
if ne rc long len p2
exit 25
end
rc = recvfd int conn rbuf 0 32 outf 0 4
if ne rc long len p2
exit 26
end
for i ulong len p2 bound 16
if ne get rbuf i get p2 i
exit 27
end
end
if ne outf_u32 4294967295
exit 28
end

rc = fclose got_fd
rc = fclose int mfd
rc = fclose int conn
rc = fclose int cli
rc = fclose int srv
rc = write 1 s_ok 0 len s_ok
ret 0
end

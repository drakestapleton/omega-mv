# Control-flow and loop codegen controls (OM-2, AArch64), run by seed/host/check.sh with the OM-2 conductor.
# Each case fixes an exit status that a wrong loop test, loop guard, branch or inline binding changes:
# the number of passes, the pass on which trap 4 fires, the branch taken. No rows may be dropped.
frexact run seed/omc/cflow/pl-frexact.om - - - 0
frzero run seed/omc/cflow/pl-frzero.om - - - 0
frbig run seed/omc/cflow/pl-frbig.om - - - 0
frsigned run seed/omc/cflow/pl-frsigned.om - - - 0
frval run seed/omc/cflow/pl-frval.om - - - 5
frcont run seed/omc/cflow/pl-frcont.om - - - 5
frbreak run seed/omc/cflow/pl-frbreak.om - - - 3
frassign run seed/omc/cflow/pl-frassign.om - - - 4
frnest run seed/omc/cflow/pl-frnest.om - - - 60
frvalbig run seed/omc/cflow/pl-frvalbig.om - - - 104
frpress run seed/omc/cflow/pl-frpress.om - - - 0

cabi
om2
extern fn add2 a int b int to int
extern fn addl a long b long to long
extern fn pick p view int 2 to int
export fn om_add a int b int to int
ret add a b
end
export fn om_addl a long b long to long
ret add a b
end
export fn om_pick p view int 2 to int
x = get p 0
y = get p 1
ret add x y
end
export fn om_sum6 a int b int c int d int e int f int to int
s = add a b
s = add s c
s = add s d
s = add s e
ret add s f
end
export fn om_call to int
s = add2 20 22
if ne s 42
ret 1
end
n = add2 0 -5
if ne n -5
ret 2
end
w = addl 100 23
if ne w 123
ret 3
end
a = new int 2 0
put a 0 3
put a 1 4
g = pick a
if ne g 7
ret 4
end
ret 0
end

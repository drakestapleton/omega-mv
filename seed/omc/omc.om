end
if ge k 3
if ne get a_ar add get a_rb 57 i 0
lpback i
else
back get a_ar add get a_rb 51 i
end
ex = get oc 0
note the breaks and continues of loop i are the entries recorded since it opened (bk0, bc0): an inner
note loop gave its own back when it closed, so this is linear in them, and they are given back below
patchl 0 i ex
put nbrk 0 get a_ar add get a_rb 60 i
put ncont 0 get a_ar add get a_rb 61 i
end
if eq k 2
if or eq get xtarget 0 0 eq get a_ar add get a_rb 56 i 0
patch26 get a_ar add get a_rb 50 i get oc 0
end
else
patch19 get a_ar add get a_rb 50 i get oc 0
end
nm_set get a_ar add get a_rb 54 i
put held 0 get a_ar add get a_rb 55 i
eol
end


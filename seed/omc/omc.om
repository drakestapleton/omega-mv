put a_ar add get a_rb 71 j 65535
end
else
if eq get a_ar add get a_rb 73 j i
patch19 get a_ar add get a_rb 72 j t
put a_ar add get a_rb 73 j 65535
end
end
j = add j 1
end
m = add m 1
end
end
end

note s_end: close the innermost block (if: patch its branch; else: patch its jump; while: B head; for: i =
note add i 1, B head), or the function. om4 S_END.
fn s_end to void

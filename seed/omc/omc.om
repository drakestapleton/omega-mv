put a_ar add get a_rb 77 add x 7 get nslot 0
if eq c 254
e = harray x 1
save
basearg 0 e
loadarg 16 1 get a_ar add get a_rb 77 add x 21
e3 2332033024 0 0 16
aret dst x
ret
end

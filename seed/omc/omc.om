put a_top 0 w
put a_hw 0 w
put a_gc 0 shl w 3
end

note a_pack: the c bytes of a_wb become input bytes off .. off + c - 1 (their words are 0 until now)
fn a_pack off ulong c ulong to void
i = ulong 0
while and lt i c ne and add off i 7 0
a_pack1 add off i ulong get a_wb i
i = add i 1
end
note whole words: eight bytes, one store (the word was 0)
while le add i 8 c
w = ulong 0
for k ulong 8
w = or w shl ulong get a_wb add i k shl k 3
end
put a_ar shr add off i 3 w
i = add i 8
end
while lt i c
a_pack1 add off i ulong get a_wb i
i = add i 1
end
end

note a_pack1: input byte x becomes b (its word holds 0 at that byte until now)
fn a_pack1 x ulong b ulong to void
s = shl and x 7 3
y = get a_ar shr x 3
put a_ar shr x 3 or y shl b s
end

note a_init: every other region gets its first room after the input: the hash tables 1024 buckets, the
note output last (it grows most, and the last region grows in place), the rest 64 entries each, except
note the groups that grow with the input (names, long names, functions, calls, trap sites), which get
note room for the entries an input of this size usually holds (a_isize). The arena is zero .bss: room
note never written costs no page, while a region that outgrows its room moves and leaves touched pages
note behind, so a first room that fits saves those pages (measured: 145 fewer page faults on omega-mcp).
fn a_init to void
a_defs
g = ulong 2
while lt g 21
if or or eq g 4 eq g 6 eq g 8
a_need g 1023
else
a_need g sub a_isize g 1
end
g = add g 1
end
put nh_b 0 10
put lh_b 0 10
put fh_b 0 10
a_need 1 65535
note the first room is not use: a_gp counts only what the unit asks for (the omc-use record)
g = ulong 0
while lt g 21
put a_gp g 0
g = add g 1
end
put a_rdy 0 1
end

note a_isize: the first room of group g, in entries: the input's bytes over k for the groups that grow
note with it (names k 16, long names 64, functions 64, calls 8, trap sites 8), between 64 and 8192;
note 64 for the rest. A guess, never a bound: past it the group doubles as always.
fn a_isize g ulong to ulong
k = ulong 0
if or eq g 3 eq g 9
k = ulong 16
end
if or eq g 5 eq g 7
k = ulong 64
end
if eq g 10
k = ulong 8
end
if eq g 9
k = ulong 8
end
if eq k 0
ret 64
end
c = div get inlen 0 k
if lt c 64
ret 64
end
if gt c 8192
ret 8192
end
ret c
end

note a_hash: the b-bit multiplicative hash of w (2^64 divided by the golden ratio, odd)
fn a_hash w ulong b ulong to ulong
ret shr mul w 11400714819323198485 sub 64 b
end

note a_gcount: what group g was asked to hold: the bytes of the input, the output and the om2 diag sites,
note else the highest index asked for, plus 1
fn a_gcount g ulong to ulong
if eq g 0
ret get inlen 0
end
if eq g 1
ret get oc 0
end
if eq g 2
ret get nsite 0
end
ret get a_gp g
end

note a_gwords: the words the regions of group g hold
fn a_gwords g ulong to ulong
s = ulong 0
r = ulong 0
while lt r get a_nr 0
if eq get a_rg r g
s = add s get a_rw r
end
r = add r 1
end
ret s
end

note a_rec: the omc-use record, one line to fd: omc-use 1 arena=A top=T waste=W full=F, then for each
note group LABEL=N/H, N what it was asked to hold (a_gcount) and H the words it holds. A, T, W and H are
note 8-byte words of the arena; F is 1 when the compile stopped because the arena was full.
fn a_rec fd ulong to void
put mc 0 0
mputw 2334398928971328879 8
mputw 4422937691044257841 8
mputn len a_ar
mputw 263879357472 5
mputn get a_top 0
mputw 17281524405729056 7
mputn get a_wst 0
mputw 67535885395488 6
mputn get a_fl 0
g = ulong 0
limit = ulong 21
if ne get objmode 0 0
limit = ulong 23
end
while lt g limit
mputb 32
a_gname g
mputb 61
mputn a_gcount g
mputb 47
mputn a_gwords g
g = add g 1
end
mputb 32
mputw 4424626557984269667 8
mputn get a_cel 0
mputb 10
w = write int fd msg 0 get mc 0
end


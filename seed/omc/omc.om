i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i n
go = false
else
s = get a_ar add get a_rb 41 i
f = sub get a_ar add get a_rb 43 i 1
if ne get xtarget 0 0
wrword add s 1 sub a_g 22 f add s 5
else
if and ne get objmode 0 0 eq a_gu 32 f 2
wrword s 2483027968
else
wrword s or 2483027968 bdisp s get a_ar add get a_rb 22 f 26
end
end
i = add i 1
end
m = add m 1
end
end

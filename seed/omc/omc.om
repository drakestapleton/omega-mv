put ds_kset 0 1
end

fn ds_hinit to void
put ds_h 0 ulong 1779033703
put ds_h 1 ulong 3144134277
put ds_h 2 ulong 1013904242
put ds_h 3 ulong 2773480762
put ds_h 4 ulong 1359893119
put ds_h 5 ulong 2600822924
put ds_h 6 ulong 528734635
put ds_h 7 ulong 1541459225
end

fn ds_compress to void
ds_kinit
for i ulong 16
v = ulong 0
for j ulong 4
v = or shl v 8 ulong get ds_blk add mul i 4 j
end
put ds_w i v
end
for i ulong 48
j = add i 16
v = add ds_ss1 get ds_w sub j 2 add ds_ss0 get ds_w sub j 15 add get ds_w sub j 7 get ds_w sub j 16
put ds_w j ds_mask v
end
a = ulong get ds_h 0
b = ulong get ds_h 1
c = ulong get ds_h 2
d = ulong get ds_h 3
e = ulong get ds_h 4
f = ulong get ds_h 5
g = ulong get ds_h 6
hh = ulong get ds_h 7
for i ulong 64
x = ds_ch e f g
x = add x get ds_k i
x = add x get ds_w i
x = add x ds_bs1 e
x = add x hh
t1 = ds_mask x
x = ds_maj a b c
x = add ds_bs0 a x
hh = g
g = f
f = e
e = ds_mask add d t1
d = c
c = b
b = a
a = ds_mask add t1 x
end
put ds_h 0 ds_mask add get ds_h 0 a
put ds_h 1 ds_mask add get ds_h 1 b
put ds_h 2 ds_mask add get ds_h 2 c
put ds_h 3 ds_mask add get ds_h 3 d
put ds_h 4 ds_mask add get ds_h 4 e
put ds_h 5 ds_mask add get ds_h 5 f
put ds_h 6 ds_mask add get ds_h 6 g
put ds_h 7 ds_mask add get ds_h 7 hh
end

fn d2env to void
n = envcnt
i = ulong 0
while lt i ulong n
k = envread i a_eb 0 131072
if eq k long len d2flag
ok = true
for j ulong len d2flag
if ne get a_eb j get d2flag j
ok = false
end
end
if ok
put d2mode 0 1
end
end
if eq k long len rcflag
ok = true
for j ulong len rcflag
if ne get a_eb j get rcflag j
ok = false
end
end
if ok
put rcmode 0 1
end
end
i = add i 1
end
if or ne get d2mode 0 0 ne get rcmode 0 0
ds_hinit
end
end

note Hash bytes as read, before a memory refusal or formatter can change the input arena.
fn d2feed n ulong to void
for i ulong n
j = rem get d2size 0 64
put ds_blk j get a_wb i
put d2size 0 add get d2size 0 1
if eq j 63
ds_compress
end
end
end

fn d2finish to void
if ne get d2done 0 0
ret
end
j = rem get d2size 0 64
put ds_blk j 128
j = add j 1
while lt j 64
put ds_blk j 0
j = add j 1
end
if ge rem get d2size 0 64 56
ds_compress
for i ulong 64
put ds_blk i 0
end
end
bits = mul get d2size 0 8
for i ulong 8
put ds_blk add 56 i uchar and shr bits mul sub 7 i 8 255
end
ds_compress
for i ulong 32
v = get ds_h div i 4
shift = mul sub 3 rem i 4 8
put d2hash i uchar and shr v shift 255
end
put d2done 0 1
end

fn d2record code ulong to void
d2finish
put mc 0 0
mputw 7449351137626647919 8
mputw 4424052638528582176 8
mputn code
mputw 19207804370383648 7
mputn get d2site 0
mputw 67505853393952 6
mputn add get line 0 get lbase 0
mputw 263812244256 5
mputn dcol get tka 0
mputw 67544290456352 6
mputn add get tka 0 get sbase 0
mputb 45
mputn add get tkb 0 get sbase 0
mputw 7088512386250729760 8
mputw 263929033849 5
mputn get d2size 0
mputw 7160569980288657696 8
mputw 4424070187921206639 8
mputn get d2full 0
mputw 8313491484895504672 8

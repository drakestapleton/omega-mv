pinlo
emit or 2483027968 bdisp get oc 0 get a_ar add get a_rb 22 sub f 1 26
if eq uchar get a_ar add get a_rb 23 sub f 1 12
emit 3531603968
end
emit 3531606952
emit 3556769793

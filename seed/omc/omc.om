if gt get tl 0 63
note d2site 47|foffset: name too long (63 bytes; 8 for an abstract, a layout, a layout field, or any name in IR mode); condition if gt get tl 0 63
put d2site 0 47
fail 13
end
f = findfield sub sid 1 get tw 0
if eq f 0
note d2site 48|foffset: unknown name or field, or a word this mode does not provide; condition if eq f 0
put d2site 0 48
fail 3
end
off = ulong get sf_off sub f 1
vdone 3 mul off 8 5
end

note fspan: a deferred literal stored as pos*4294967296+len. The input lives in the arena (2^27 bytes at
note most), so pos fits the high 32 bits and len the low 32; the old pos*64+len read a literal of 64 or more
note characters from the wrong span (#965), and pos*16777216+len assumed an input below 2^23 bytes.
fn fspan ty ulong packed ulong to ulong
fparse div packed 4294967296 rem packed 4294967296
ret fbits ty
end

fn isfloat t ulong to ulong
if or eq t 10 eq t 11
ret 1

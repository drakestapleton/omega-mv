if eq get progmode 0 0
emit 2852586464
emit 4181723376
emit 3592356352
else
if ne get xefa 0 0
note a64efi: ADD X0, X1, #100; ORR X0, X0, #2^63 (C6.2.240); B to the shared firmware return (aefx)

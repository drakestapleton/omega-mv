note d2site 60|range: number out of range for its type or place; condition if ne shr v 63 0
put d2site 0 60
fail 8
end
ret
end
if ne big 0
note d2site 61|range: number out of range for its type or place; condition if ne big 0
put d2site 0 61
fail 8
end
lim = shl ulong 1 w
if lt t 6
if ge v lim
note d2site 62|range: number out of range for its type or place; condition if ge v lim
put d2site 0 62
fail 8
end
ret
end
half = shr lim 1
if ge add v half lim
note d2site 63|range: number out of range for its type or place; condition if ge add v half lim
put d2site 0 63
fail 8

kfill n fc
t = ulong 0
f = ulong 0
while lt f fc
if eq get a_ar add get a_rb 81 f 0
put a_ar add get a_rb 84 t f
t = add t 1
end
f = add f 1
end
h = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge h t
go = false
else
g = get a_ar add get a_rb 84 h
h = add h 1
a_pc 30 g 1
t = kpop g t
end
m = add m 1
end
end
end


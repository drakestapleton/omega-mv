note nfail: a bad number (diag expect=number); unkfail: an undeclared function or struct (sev=unknown)
fn nfail code ulong to void
put dexp 0 4
fail code
end

fn unkfail code ulong to void
put dsev 0 2
put dexp 0 3
fail code
end

note lineis: the n bytes at q are the packed word w and the line ends right after them
fn lineis q ulong w ulong n ulong to ulong
e = get inlen 0
if gt add q n e
ret 0
end
i = ulong 0
x = w
while lt i n
if ne ulong a_ib add q i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add q n
if lt r e
if ne a_ib r 10
ret 0
end
end
ret 1
end

note isnote: the word at p is note (the lexer ends a word at a blank, a parenthesis or the end)
fn isnote p ulong to ulong
e = get inlen 0
if gt add p 4 e
ret 0
end
i = ulong 0
x = ulong 1702129518
while lt i 4
if ne ulong a_ib add p i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add p 4
if lt r e
b = a_ib r
if and gt b 32 and ne b 40 ne b 41
ret 0
end
end
ret 1
end

note chk_mode: the lead line check (1), next (2) or usage (3). usage compiles the unit as usual and, in
note place of the artifact, writes the omc-use record (a_rec) to stdout and exits 0; an error writes the
note human line and then the record to stderr. It is how the usage gate reads what a unit asked of the
note arena without changing the unit's profile.
fn chk_mode q ulong to ulong
if ne lineis q 127970252055151 6 0
ret 4
end
if ne lineis q 461229090915 5 0
ret 1
end
if ne lineis q 1954047342 4 0
ret 2
end
if ne lineis q 435526136693 5 0
ret 3
end
ret 0
end

fn chk_lead to void
e = get inlen 0
p = ulong 0
ln = ulong 1
go = true
while go
m = ulong 0
while and go lt m 999999
q = skipbl p
if ge q e
go = false
else
if eq a_ib q 10
p = add q 1
ln = add ln 1
else
if ne isnote q 0
p = skipln q
ln = add ln 1
else
k = chk_mode q
if ne k 0
put chkmode 0 k
put chkln 0 ln
put sbase 0 skipln q
end
go = false
end
end
end
m = add m 1
end
end
end

note om2lead: skip blank lines and note lines; when the next line is exactly om2 (1), om2 diag (2) or
note om2 fmt (3) the unit is OM-2: om2, om2m, om2ln, om2pos. Anything else leaves the unit OM-1.
fn om2lead to void
e = get inlen 0
p = ulong 0
ln = ulong 1
if ne get chkmode 0 0
p = get sbase 0
ln = add get chkln 0 1
end
go = true
while go
m = ulong 0
while and go lt m 999999
q = skipbl p
if ge q e
go = false
else
if eq a_ib q 10
p = add q 1
ln = add ln 1
else
if ne isnote q 0
p = skipln q
ln = add ln 1
else
r = ulong 0
if eq q p
if ne lineis q 3304815 3 0
r = ulong 1
end
if ne lineis q 7449351137405332847 8 0
r = ulong 2
end
if ne lineis q 32771382692703599 7 0
r = ulong 3
end
if eq r 0
r = cp_mode q
end
end
if ne r 0
put om2 0 1
put om2m 0 sub r 1
put om2ln 0 ln
put om2pos 0 q
end
go = false
end
end
end
m = add m 1
end
end
end

note ---- om2 fmt (spec 2, errata E4, E6): only when the input's first line, at byte 0, is om2 fmt (an om2
note fmt line elsewhere is error 16). The rest (the bytes after the first LF) is compiled as a unit of
note its own (OM-1 or OM-2 by its own first line) and, when it is accepted, its canonical text is written
note instead of the artifact. A CR anywhere and blank lines at the end are error 6. Lines and spans are
note reported against the whole input.
global fst ulong 1
global fpend ulong 1
global fbo ulong 1
global fprp ulong 1
global flso ulong 1

note fmttail: blank lines at the end of the rest (n bytes) are error 6, at the first such line
fn fmttail n ulong to void
lnb = ulong 0
lnl = ulong 1
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i n
go = false
else
b = a_ib i
if eq b 10
ln = add ln 1
else
if and ne b 32 ne b 9
lnb = add i 1
lnl = ln
end
end
i = add i 1
end
m = add m 1
end
end
bad = false
if eq lnb 0
if gt n 0
bad = true
lnl = ulong 0
end
end
k = lnb
fl = n
go = true
while go
m = ulong 0
while and go lt m 999999
if ge k n
go = false
else
if eq a_ib k 10
fl = k
go = false
end
k = add k 1
end
m = add m 1
end
end
if lt add fl 1 n
bad = true
end
if bad
put line 0 add lnl 1
put tka 0 lnb
put tkb 0 lnb
note d2site 22|fmttail: malformed number or token; condition if bad
put d2site 0 22
fail 6
end
end

fn fmtprep to void
if ne get om2pos 0 0
put line 0 get om2ln 0
put tka 0 get om2pos 0
put tkb 0 get om2pos 0
note d2site 23|fmtprep: syntax: unknown or misplaced word; condition if ne get om2pos 0 0
put d2site 0 23
fail 16
end
e = get inlen 0
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i e
go = false
else
b = a_ib i
if eq b 13
put line 0 ln
put tka 0 i
put tkb 0 add i 1
note d2site 24|fmtprep: malformed number or token; condition if eq b 13
put d2site 0 24
fail 6
end
if eq b 10
ln = add ln 1
end
i = add i 1
end
m = add m 1
end
end
r = skipln get om2pos 0
put lbase 0 get om2ln 0
put sbase 0 r
n = sub e r
j = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge j n
go = false

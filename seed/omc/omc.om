m = ulong 1
if le add p 5 get inlen 0
if and eq a_ib p 100 eq a_ib add p 1 105
if and eq a_ib add p 2 97 eq a_ib add p 3 103
if eq uchar and shr get a_ar shr add p 4 3 shl and add p 4 7 3 255 32
p = add p 5
m = ulong 2
end
end
end
end

a = get a_ar add get a_rb 42 i
if ne a 0
b = get a_ar add get a_rb 43 i
a_p 81 sub a 1 add a_g 81 sub a 1 1
a_p 82 b add a_g 82 b 1
end
i = add i 1
end
m = add m 1
end
end
f = ulong 1
while le f fc
a_p 82 f add a_g 82 f a_g 82 sub f 1
f = add f 1
end
end

note kfill: each call record's caller into k_ed at its callee's place

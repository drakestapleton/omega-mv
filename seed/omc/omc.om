note SPDX-License-Identifier: AGPL-3.0-only
note SHA-256, one-shot over a byte slice, in seeded .om.
note The digest is the standard FIPS 180-4 construction with 32-bit words held in ulong and
note masked after every addition. It has no host crypto dependency and no network path.
global ds_h ulong 8
global ds_w ulong 64
global ds_k ulong 64
global ds_blk uchar 64
global ds_kset ulong 1

fn ds_mask x ulong to ulong
ret and x 4294967295
end

fn ds_ror x ulong n ulong to ulong
ret ds_mask or shr x n shl x sub 32 n
end

fn ds_ch e ulong f ulong g ulong to ulong
ret xor and e f and xor e 4294967295 g
end

fn ds_maj a ulong b ulong c ulong to ulong
ret xor and a b xor and a c and b c
end

fn ds_bs0 x ulong to ulong
ret xor ds_ror x 2 xor ds_ror x 13 ds_ror x 22
end

fn ds_bs1 x ulong to ulong
ret xor ds_ror x 6 xor ds_ror x 11 ds_ror x 25
end

fn ds_ss0 x ulong to ulong
ret xor ds_ror x 7 xor ds_ror x 18 shr x 3
end

fn ds_ss1 x ulong to ulong
ret xor ds_ror x 17 xor ds_ror x 19 shr x 10
end

fn ds_kinit to void
if ne get ds_kset 0 0
ret
end
put ds_k 0 ulong 1116352408
put ds_k 1 ulong 1899447441
put ds_k 2 ulong 3049323471
put ds_k 3 ulong 3921009573
put ds_k 4 ulong 961987163
put ds_k 5 ulong 1508970993

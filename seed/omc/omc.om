e = get cur 0
if eq uchar and shr get a_ar shr p 3 shl and p 7 3 255 45
q = add p 1
if lt add q 1 e
if eq uchar and shr get a_ar shr q 3 shl and q 7 3 255 48
c = a_ib add q 1
if or eq c 120 eq c 88
note d2site 26|tok_hex: malformed number or token; condition if or eq c 120 eq c 88
put d2site 0 26
nfail 6
end
end
end
ret 0
end
if ge add p 1 e
ret 0
end
if ne uchar and shr get a_ar shr p 3 shl and p 7 3 255 48
ret 0
end
c = uchar and shr get a_ar shr add p 1 3 shl and add p 1 7 3 255
if eq c 88
note d2site 27|tok_hex: malformed number or token; condition if eq c 88
put d2site 0 27
nfail 6
end
if ne c 120
ret 0
end
n = sub e add p 2
if eq n 0
note d2site 28|tok_hex: malformed number or token; condition if eq n 0
put d2site 0 28
nfail 6
end
if gt n 16
note d2site 29|tok_hex: malformed number or token; condition if gt n 16
put d2site 0 29
nfail 6
end
v = ulong 0
i = add p 2
while lt i e
d = ulong a_ib i
if and ge d 48 le d 57
v = or shl v 4 sub d 48
else
if and ge d 97 le d 102
v = or shl v 4 sub d 87
else
note d2site 30|tok_hex: malformed number or token; condition otherwise: if and ge d 97 le d 102
put d2site 0 30
nfail 6
end
end
i = add i 1
end
put tbig 0 shr v 63
put tw 0 v
put tk 0 2
ret 1
end

note ---- float literals: a token is the decimal value fsgn * fnd * 10^fp10, fsuf 0 none / 1 f32 / 2 f64.
note fg_* hold the working state of the one literal being converted (see fparse/fbits/fnorm/fgen).
global fsgn ulong 1
global fnd ulong 1
global fp10 long 1
global fsuf ulong 1
global fg_fl ulong 1
global fg_seen ulong 1
global fg_ex long 1
global fg_esign long 1
global fg_ed ulong 1
global fg_ty ulong 1
global fg_e long 1
global fg_q ulong 1
global fg_m ulong 1
global fg_stk ulong 1
global fbn ulong 80

note ======== float literals: decimal text to IEEE-754 binary32/binary64 ========
note The literal is fnd * 10^fp10 = A / D with A = fnd * 10^max(fp10,0) and D = 10^max(-fp10,0), both
note held exactly as 40 32-bit limbs in fbn (A at 0, D at 40). The smaller of the two is shifted to the
note other's bit length, then restoring division yields the first 64 quotient bits (fg_m, leading bit
note set) and a remainder whose nonzero-ness is the sticky flag (fg_stk); froundsh rounds that exact
note truncation once to nearest even and fpack packs it, subnormals included (#1024: the old converter
note scaled one factor of ten at a time and dropped bits at every step). fp10 < -343 means a value
note below (2^63-1)*10^-344 < 2^-1075, signed zero; fp10 > 308 means at least 10^309, above the
note binary64 maximum (error 8). So A and D never exceed 1141 bits.

note blen: bits needed for x (0 for zero)
fn blen x ulong to ulong
n = ulong 0
while ne x 0
x = shr x 1
n = add n 1
end
ret n
end

note fparse: read the literal text inp[pos, pos+len) into fsgn, fnd, fp10, fsuf (0 none, 1 f32, 2 f64).
note Grammar: [-]digits[.digits][(e|E)[+|-]digits][f32|f64]. At most 2^63-1 significant digits
note (error 8), a dot with no digit after it is error 6, |exponent| <= 999 (error 8).
note The digit scans here and in fexp run as nested 999999-pass loops: a literal of more than 1000000
note zero digits trapped 4 in a single loop's hidden 1000000-pass guard (#965).
fn fparse pos ulong ln ulong to void
p = pos
e = add pos ln
put fsgn 0 0
put fsuf 0 0
put fnd 0 0
put fg_fl 0 0
put fg_seen 0 0
if eq uchar and shr get a_ar shr p 3 shl and p 7 3 255 45
put fsgn 0 1
p = add p 1
end
go = true
while go
pos = ulong 0
while and go lt pos 999999
if ge p e
go = false
else
d = sub ulong a_ib p 48
if le d 9
if gt get fnd 0 922337203685477580
note d2site 31|fparse: number out of range for its type or place; condition if gt get fnd 0 922337203685477580
put d2site 0 31
fail 8
end
if eq get fnd 0 922337203685477580
if gt d 7
note d2site 32|fparse: number out of range for its type or place; condition if gt d 7
put d2site 0 32
fail 8
end
end
put fnd 0 add mul get fnd 0 10 d
if ne get fg_seen 0 0
put fg_fl 0 add get fg_fl 0 1
end
p = add p 1
else
go = false
if eq a_ib p 46
if eq get fg_seen 0 0
put fg_seen 0 1
p = add p 1
go = true
end
end
end
end
pos = add pos 1
end
end
if and ne get fg_seen 0 0 eq get fg_fl 0 0
note d2site 33|fparse: malformed number or token; condition if and ne get fg_seen 0 0 eq get fg_fl 0 0
put d2site 0 33
fail 6
end
p = fexp p e
p = fsufx p e
if ne p e
note d2site 34|fparse: malformed number or token; condition if ne p e
put d2site 0 34
fail 6
end
x = mul get fg_esign 0 get fg_ex 0
put fp10 0 sub x long get fg_fl 0
end

note fexp: the exponent of the literal, if present: fg_ex, fg_esign, fg_ed. Returns the new position.
fn fexp p ulong e ulong to ulong
put fg_ex 0 0
put fg_esign 0 1
if and lt p e or eq a_ib p 101 eq a_ib p 69
p = add p 1
if lt p e
if or eq a_ib p 43 eq a_ib p 45
if eq uchar and shr get a_ar shr p 3 shl and p 7 3 255 45
put fg_esign 0 -1
end
p = add p 1
end
end
put fg_ed 0 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
d = sub ulong a_ib p 48
if gt d 9
go = false
else
put fg_ex 0 mul get fg_ex 0 10
put fg_ex 0 add get fg_ex 0 long d
if gt get fg_ex 0 999
note d2site 35|fexp: number out of range for its type or place; condition if gt get fg_ex 0 999
put d2site 0 35
fail 8
end
put fg_ed 0 add get fg_ed 0 1
p = add p 1
end
end
m = add m 1
end
end
if eq get fg_ed 0 0
note d2site 36|fexp: malformed number or token; condition if eq get fg_ed 0 0
put d2site 0 36
fail 6
end
end
ret p
end

note fsufx: the optional f32/f64 suffix: fsuf 1 or 2. Returns the new position.
fn fsufx p ulong e ulong to ulong
if lt p e
r = sub e p
if ne r 3
note d2site 37|fsufx: malformed number or token; condition if ne r 3
put d2site 0 37
fail 6
end
if ne uchar and shr get a_ar shr p 3 shl and p 7 3 255 102
note d2site 38|fsufx: malformed number or token; condition if ne uchar and shr get a_ar shr p 3 shl and p 7 3 255 102
put d2site 0 38
fail 6
end
if and eq a_ib add p 1 51 eq a_ib add p 2 50
put fsuf 0 1
else
if and eq a_ib add p 1 54 eq a_ib add p 2 52
put fsuf 0 2
else
note d2site 39|fsufx: malformed number or token; condition otherwise: if and eq a_ib add p 1 54 eq a_ib add p 2 52
put d2site 0 39
fail 6
end
end
p = add p 3
end
ret p
end

note fbmul: limbs fbn[o, o+40) times k (k < 2^32, so each limb step fits 64 bits); the product must fit
note in 40 limbs. Returns its bit length, so fbmul o 1 only measures.
fn fbmul o ulong k ulong to ulong
c = ulong 0
t = ulong 0
i = ulong 0
while lt i 40
j = add o i
v = add mul get fbn j k c
put fbn j and v 4294967295
c = shr v 32
if ne and v 4294967295 0
t = add mul i 32 blen and v 4294967295
end
i = add i 1
end
ret t
end

note fbpow: fbn[o, o+40) times b^n (b 2 or 10), in factors that stay below 2^32.
fn fbpow o ulong b ulong n ulong to void
while gt n 0
m = ulong 1
c = ulong 0
while and lt c n le mul m b 4294967295
m = mul m b
c = add c 1
end
t = fbmul o m
n = sub n c
end
end

note fbsub: one restoring-division step. If A >= D then A = A - D and 1, else A is kept and 0.
fn fbsub to ulong
r = ulong 2
i = ulong 40
while and gt i 0 eq r 2
i = sub i 1
a = get fbn i
d = get fbn add i 40
if lt a d
r = ulong 0
end
if gt a d
r = ulong 1
end
end
if eq r 0
ret 0
end
b = ulong 0
i = ulong 0
while lt i 40
v = sub sub get fbn i get fbn add i 40 b
put fbn i and v 4294967295
b = shr v 63
i = add i 1
end
ret 1
end

note froundsh: round fg_m right by sh bits to fg_q, nearest even; the guard and every lower bit
note (plus fg_stk) decide. sh may be 64 (then q is zero and bit 63 is the guard).
fn froundsh sh ulong to void
m = get fg_m 0
q = ulong 0
guard = ulong 0
lost = ulong 0
if eq sh 0
q = m
else
if ge sh 64
guard = shr m 63
lost = and m 9223372036854775807
else
q = shr m sh
guard = and shr m sub sh 1 1
if gt sub sh 1 0
lost = and m sub shl 1 sub sh 1 1
end
end
end
sticky = or get fg_stk 0 lost
if ne guard 0
if or ne sticky 0 eq and q 1 1
q = add q 1
end
end
put fg_q 0 q
end

note fpack: fg_m/fg_e to IEEE bits of fg_ty, including subnormals; a literal that rounds to infinity
note is refused (error 8).
fn fpack to ulong
p = ulong 53
bias = long 1023
maxe = long 2047
emin = long -1022
mb = ulong 52
w = ulong 64
if eq get fg_ty 0 10
p = ulong 24
bias = long 127
maxe = long 255
emin = long -126
mb = ulong 23
w = ulong 32
end
e = add get fg_e 0 63
if ge e emin
sh = sub 64 p
froundsh sh
q = get fg_q 0
if eq q shl 1 p
q = shr q 1
e = add e 1
end
E = add e bias
if ge E maxe
note d2site 40|fpack: number out of range for its type or place; condition if ge E maxe
put d2site 0 40
fail 8
end
q = and q sub shl 1 sub p 1 1
q = or q shl ulong E mb
q = or q shl get fsgn 0 sub w 1
ret q
end
k = ulong sub emin e
sh = add sub 64 p k
if gt sh 64
ret shl get fsgn 0 sub w 1
end
froundsh sh
q = get fg_q 0
q = or q shl get fsgn 0 sub w 1
ret q
end

note fbits: the parsed literal as IEEE bits of type ty (10 f32, 11 f64). Zero keeps the sign (-0.0).
fn fbits ty ulong to ulong
put fg_ty 0 ty
p = get fp10 0
if or eq get fnd 0 0 lt p -343
w = ulong 64
if eq ty 10
w = ulong 32
end
b = ulong 0
if ne get fsgn 0 0
b = shl ulong 1 sub w 1
end
ret b
end
if gt p 308
note d2site 41|fbits: number out of range for its type or place; condition if gt p 308
put d2site 0 41
fail 8
end
i = ulong 0
while lt i 80
put fbn i 0
i = add i 1
end
put fbn 0 and get fnd 0 4294967295
put fbn 1 shr get fnd 0 32
put fbn 40 1
if gt p 0
fbpow 0 10 ulong p
else
fbpow 40 10 ulong sub 0 p
end
a = fbmul 0 1
d = fbmul 40 1
e = long 0
if lt a d
fbpow 0 2 sub d a
e = sub 0 long sub d a
else
fbpow 40 2 sub a d
e = long sub a d
end
q = ulong 0
while lt q 9223372036854775808
q = or shl q 1 fbsub
a = fbmul 0 2
e = sub e 1
end
put fg_m 0 q
put fg_e 0 add e 1
put fg_stk 0 fbmul 0 1
ret fpack
end

note fsizeof: sizeof T, or sizeof S for a struct: bytes. foffset: offsetof S f: the field's byte offset
note in the struct's 8-byte-cell layout. Both are compile-time constants of type ulong.
fn fsizeof dst ulong to void
sid = peek_struct
if ne sid 0
si = sub sid 1
n = ulong get st_cells si
vdone 3 mul n 8 5
ret
end
t = typeword
if ge t 64
note d2site 42|fsizeof: type mismatch; condition if ge t 64
put d2site 0 42
fail 7
end
v = shl 1 tlog t
vdone 3 v 5
end

fn foffset dst ulong to void

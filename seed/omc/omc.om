note ---- folding (only while fzone is above 0): an operation on two typed numbers is computed with OM-1
note arithmetic: unsigned wraps to its width, signed results are sign-extended; an operation that would
note trap (signed overflow, divide by 0, a shift or rotate amount at or above the width) is not folded.
fn fmask w ulong to ulong
if ge w 64
ret not ulong 0
end
ret sub shl ulong 1 w 1
end

fn fasr x ulong s ulong to ulong
if eq shr x 63 0
ret shr x s
end
ret not shr not x s
end

fn fsext r ulong w ulong to ulong
if ge w 64
ret r
end
ret fasr shl r sub 64 w sub 64 w
end

fn fyes v ulong t ulong to void
put fval 0 v
put fty 0 t
put fok 0 1
end

fn fb_cmp op ulong sg ulong a ulong b ulong to void
x = a
y = b
if ne sg 0
x = xor a shl ulong 1 63
y = xor b shl ulong 1 63
end
r = false
if eq op 43
r = eq x y
end
if eq op 44
r = ne x y
end
if eq op 45
r = lt x y
end
if eq op 46
r = le x y
end
if eq op 47
r = gt x y
end
if eq op 48
r = ge x y
end
v = ulong 0
if r
v = ulong 1
end
fyes v 1
end

fn fb_arith op ulong ty ulong w ulong sg ulong a ulong b ulong to void
r = ulong 0
if eq op 33
r = add a b
end
if eq op 34
r = sub a b
end
if eq op 35
if ne sg 0
if ge add a shl ulong 1 31 shl ulong 1 32
ret
end
if ge add b shl ulong 1 31 shl ulong 1 32
ret
end
end
r = mul a b
end
if eq sg 0
fyes and r fmask w ty
ret
end
if eq w 64
if eq op 33
if ne shr and xor a r xor b r 63 0
ret
end
end
if eq op 34
if ne shr and xor a b xor a r 63 0
ret
end
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

fn fb_div op ulong ty ulong w ulong sg ulong a ulong b ulong to void
if eq b 0
ret
end
if eq sg 0
if eq op 36
fyes div a b ty
else
fyes rem a b ty
end
ret
end
na = shr a 63
sb = shr b 63
ma = a
if ne na 0
ma = sub 0 a
end
mb = b
if ne sb 0
mb = sub 0 b
end
if eq op 37
rr = rem ma mb
if ne na 0
rr = sub 0 rr
end
fyes rr ty
ret
end
if eq w 64
if eq a shl ulong 1 63
if eq b not ulong 0
ret
end
end
end
q = div ma mb
if ne xor na sb 0
q = sub 0 q
end
if ne fsext q w q
ret
end
fyes q ty
end

fn fb_shift op ulong ty ulong w ulong sg ulong a ulong b ulong to void
if ge b w
ret
end
if eq op 42
if eq sg 0
fyes shr a b ty
else
fyes fasr a b ty
end
ret
end
r = shl a b
if eq sg 0
fyes and r fmask w ty
ret
end
if eq w 64
if ne fasr r b a
ret
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

fn fb_rot op ulong ty ulong w ulong a ulong b ulong to void
if ge b w
ret
end
s = b
if and eq op 60 ne s 0
s = sub w s
end
if eq s 0
fyes a ty
ret
end
fyes and or shr a s shl a sub w s fmask w ty
end

note foldbin: op on the typed numbers a, b of type ty (b's own type for a shift); fok 1 when folded
fn foldbin op ulong ty ulong a ulong b ulong to void
put fok 0 0
if or eq ty 0 ge ty 10
ret
end
sg = ulong 0
if ge ty 6
sg = ulong 1
end
if and ge op 43 le op 48
fb_cmp op sg a b
ret
end
if and ge op 38 le op 40
r = and a b
if eq op 39
r = or a b
end
if eq op 40
r = xor a b
end
fyes r ty
ret
end
if eq ty 1
ret
end
w = twid ty
if le op 35
fb_arith op ty w sg a b
ret
end
if le op 37
fb_div op ty w sg a b
ret
end
if le op 42
fb_shift op ty w sg a b
ret
end
if or eq op 59 eq op 60
if le ty 5
fb_rot op ty w a b
end
end
end

note foldun: neg (49) / not (50) of the typed number a
fn foldun c ulong ty ulong a ulong to void
put fok 0 0
if or eq ty 0 ge ty 10
ret
end
if eq c 50
if eq ty 1
fyes xor a 1 ty
ret
end
if lt ty 6
fyes and not a fmask twid ty ty
ret
end
fyes not a ty
ret
end
if eq ty 1
ret
end
r = sub 0 a
if lt ty 6
fyes and r fmask twid ty ty
ret
end
w = twid ty
if eq w 64
if eq a shl ulong 1 63
ret
end
fyes r ty
ret
end
if ne fsext r w r
ret
end
fyes r ty
end

note ---- omc-site records (om2 diag): one per runtime trap site, in emission order, after the artifact
note on stderr: omc-site 1 line=N iter=k, k the counters of the open unrolled loops outer to inner
note joined by '.', or '-'.
fn siteb b ulong to void
n = get nsite 0
if ge n get a_gp 2
a_need 2 n
end
a_bput 2 n uchar b
put nsite 0 add n 1
end

fn sitew w ulong n ulong to void
i = ulong 0
x = w
while lt i n
siteb and x 255
x = shr x 8
i = add i 1
end
end

fn siten v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
siteb ulong get d j
end
end

fn siterec to void
sitew 7310584038532803951 8
sitew 4424063608026050848 8
siten add get line 0 get lbase 0
sitew 67561537693984 6
any = false
j = ulong 0
while lt j get nb 0
if eq get a_ar add get a_rb 49 j 5
if any
siteb 46
end
siten get a_ar add get a_rb 64 j
any = true
end
j = add j 1
end
if not any
siteb 45
end
siteb 10
end

fn sitesout to void
z = a_out 2 2 0 get nsite 0
end


note alloc: the next free register of the pool (after the parameters); error 12 when none is left
fn alloc to ulong
i = add get npar 0 get nslot 0
if ge i 16
note d2site 56|alloc: register pool exhausted; condition if ge i 16
put d2site 0 56
fail 12
end
put vsl i 0
put nslot 0 add get nslot 0 1
ret poolc i
end

note destreg: d, or a new temporary when d is 255
fn destreg d ulong to ulong
if eq d 255
ret alloc
end
ret d
end

note e3: emit op | d | n << 5 | m << 16
fn e3 op ulong d ulong n ulong m ulong to void
emit or or or op d shl n 5 shl m 16
end

note trapsite: note the place and code of a branch to the trap stub, then emit it. trapc: B.cond, as om4.
note The trap list grows with the arena (group 10); island keeps every such branch within its reach.
fn trapsite w ulong code ulong to void
n = get nt 0
if ge n get a_gp 10
a_need 10 n
end
put a_ar add get a_rb 44 n get oc 0
put a_ar add get a_rb 45 n code
put nt 0 add n 1
emit w
if eq get om2m 0 1
siterec
end
end

fn trapc cc ulong code ulong to void
if ne get xtarget 0 0
xtrap cc code
ret
end
trapsite or 1409286144 cc code
end

fn rdword at ulong to ulong
a = ulong a_ob at
b = shl ulong a_ob add at 1 8
c = shl ulong a_ob add at 2 16
d = shl ulong a_ob add at 3 24
ret or or or a b c d
end

fn wrword at ulong w ulong to void
a_bput 1 at uchar and w 255
a_bput 1 add at 1 uchar and shr w 8 255
a_bput 1 add at 2 uchar and shr w 16 255
a_bput 1 add at 3 uchar and shr w 24 255
end

note bdisp: the checked word distance from a branch at `at` to `target` for its signed w-bit word field:
note w 19 for B.cond / CBZ / CBNZ (C6.2.34, C6.2.78, C6.2.77), w 26 for B (C6.2.35) and BL. The
note target must be word aligned and at most 2^(w-1) - 1 words forward or 2^(w-1) words back (w 19: 1048572
note bytes forward, 1048576 back; w 26: 134217724 forward, 134217728 back), else error 24 before any
note artifact is accepted. Returns the distance masked to w bits.
fn bdisp at ulong target ulong w ulong to ulong
diff = sub target at
if ne and diff 3 0
note d2site 57|bdisp: AArch64 branch displacement out of range; condition if ne and diff 3 0
put d2site 0 57
fail 24
end
span = shl ulong 1 add w 1
if and gt diff sub span 4 lt diff sub ulong 0 span
note d2site 58|bdisp: AArch64 branch displacement out of range; condition if and gt diff sub span 4 lt diff sub ulong 0 span
put d2site 0 58
fail 24
end
ret and shr diff 2 sub shl ulong 1 w 1
end

note patch19: the word distance from a B.cond / CBZ / CBNZ at `at` to `target`, into bits 5..23
fn patch19 at ulong target ulong to void
if ne get xtarget 0 0
xpatch at target
if eq target get oc 0
put tgoc 0 target
end
ret
end
d = bdisp at target 19
wrword at or rdword at shl d 5
if eq target get oc 0
put tgoc 0 target
end
end

note patch26: the word distance from a B at `at` to `target`, into bits 0..25, checked by bdisp. The output
note grows with the arena, whose 2^27 bytes equal the reach of B and BL, so a legal unit stays in reach; the
note check keeps a wrong B from ever being written (error 24, the ISA's boundary) if the arena grows.
fn patch26 at ulong target ulong to void
if ne get xtarget 0 0
xpatch at target
if eq target get oc 0
put tgoc 0 target
end
ret
end
d = bdisp at target 26
wrword at or rdword at d
if eq target get oc 0
put tgoc 0 target
end
end

note back: emit B to an earlier place (C6.2.35)
fn back addr ulong to void
if ne get xtarget 0 0
p = xbranch 14
xpatch p addr
ret
end
emit or 335544320 bdisp get oc 0 addr 26
end

note matconst: put a 64-bit value in register r: MOVZ (C6.2.285) or, for a value with the top bit set,
note MOVN (C6.2.284) with the first halfword that differs from the fill, then MOVK (C6.2.283) for each
note other such halfword. om4 MATCONST.
fn matconst r ulong v ulong to void
if ne get xtarget 0 0
ximm 0 v
xstore 0 r
ret
end

a_p 77 2 a_g 53 i
put a_ar add get a_rb 77 3 3
put a_ar add get a_rb 77 4 1
a_p 77 5 a_g 53 i
binop 33 get a_ar add get a_rb 52 i 0
end
if eq k 3

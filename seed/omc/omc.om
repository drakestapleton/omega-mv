note ln_rehash: double the long-name buckets and link long names 0 .. c - 1 again in order
fn ln_rehash c ulong to void
b = add get lh_b 0 1
put lh_b 0 b
if ge sub shl ulong 1 b 1 get a_gp 6
a_need 6 sub shl ulong 1 b 1
end
a_gzero 6
j = ulong 0

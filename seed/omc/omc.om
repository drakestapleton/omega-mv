while go
m = ulong 0
while and go lt m 999999
if ge j c
go = false
else
h = a_hash ln_hw a_g 17 j ulong a_gu 18 j b
a_p 19 j a_g 20 h
put a_ar add get a_rb 20 h add j 1
j = add j 1
end
m = add m 1
end
end
end

note newname: the name must not be in use (a name in scope, a struct, layout, abstract or function): error 10
fn newname w ulong l ulong s ulong to void

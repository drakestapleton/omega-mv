end
if and eq code 14 ne get dobx 0 0
mputw 1953066601 4
ret
end
if eq code 14
mputw 114849429287527 6
ret
end
if eq code 12
mputw 1936156018 4
ret
end
mputb 45
end

note mputh: one byte as two lowercase hex digits
fn mputh b ulong to void
hi = shr b 4
lo = and b 15
if lt hi 10
mputb uchar add hi 48
else
mputb uchar add hi 87
end
if lt lo 10
mputb uchar add lo 48
else
mputb uchar add lo 87
end
end

note drec: the om2 diag machine record after the human line (spec 1): code, sev, line (the human line),
note col, the half-open byte span of the token being read, expect, found (at most 32 bytes, hex),
note obligation, profile
fn drec code ulong to void
put mc 0 0
mputw 7449351137626647919 8
mputw 4424052638528581920 8
mputn code
mputw 263979365152 5
dsev_w code
mputw 67505853393952 6
mputn add get line 0 get lbase 0
a = get tka 0
b = get tkb 0
if le b a
b = a
if gt get cur 0 a
b = get cur 0
end
end
if gt b get inlen 0
b = get inlen 0
end
mputw 263812244256 5
mputn dcol a
mputw 67544290456352 6
mputn add a get sbase 0
mputb 45
mputn add b get sbase 0
mputw 4428273620941825312 8
dexp_w code
mputw 17280399158765088 7
if eq a b
mputb 45
end
i = a
while and lt i b lt sub i a 32
mputh ulong uchar and shr get a_ar shr i 3 shl and i 7 3 255
i = add i 1
end
mputw 8386097683628191520 8
mputw 1030647657 4
dobl_w code
mputw 7308332183992823840 8
mputw 11210624683837 6
w = write 2 msg 0 get mc 0
end

note emitb / emit: one byte / one 32-bit word (little-endian) to the output (region 1, eight bytes to a
note word). The output grows with the arena (a_ogrow); there is no per-function budget: the OM-2 65536-word
note bound is gone, and a long function keeps its trap branches in reach through stub islands (island).
fn emitb b uchar to void
o = get oc 0
if ge o get a_gc 1
a_ogrow o
end
x = add get a_rb 1 shr o 3
s = shl and o 7 3
y = get a_ar x
y = and y not shl ulong 255 s
y = or y shl ulong b s
put a_ar x y
put oc 0 add o 1
end

fn emit w ulong to void
if ne get xtarget 0 0
note d2site 8|emit: unknown target, an AArch64-only path on another target, or an x86efi refusal (bare unit, Linux host word, efi OP literal outside 0..14); condition if ne get xtarget 0 0
put d2site 0 8
fail 25
end
o = get oc 0
if ne and o 3 0
emitb uchar and w 255
emitb uchar and shr w 8 255
emitb uchar and shr w 16 255
emitb uchar and shr w 24 255
ret
end
if ge add o 3 get a_gc 1
a_ogrow add o 3
end
x = add get a_rb 1 shr o 3
s = shl and o 4 3
y = get a_ar x
y = and y not shl ulong 4294967295 s
y = or y shl and w 4294967295 s
put a_ar x y
put oc 0 add o 4
end

note a_ogrow: the output will hold byte o. Two machine boundaries, each error 14 at its first byte, never a
note table's: AArch64 output stops at 134217728 bytes, the reach of B and BL (imm26, 2^27 bytes), so every
note call and jump of a unit stays encodable and bdisp's error 24 for them stays a defence (security673
note gate669 probes 16 and 17); x86 code is mapped from 0x400000 below the pools at 0x10000000, so its
note output ends at byte 264241152.
fn a_ogrow o ulong to void
lim = ulong 264241152
if eq get xtarget 0 0
lim = ulong 134217728
end
note Non-executable object metadata has no instruction-displacement bound; allocation is checked.
if ne get objmeta 0 0
lim = ulong 9223372036854775807
end
if ge o lim
note d2site 9|a_ogrow: capacity exceeded (the host refused to grow the compiler's arena or its memory ceiling OMC_MEMORY_MAX was reached, value nesting past omc's own stack, the program image, or an OM-2 expansion bound); condition if ge o lim
put d2site 0 9
fail 14
end
if ge o get a_gp 1
a_need 1 o
end
end

note tok_num: the word at [ts,cur) is [-]decimal, at most 20 digits, from -2^63 to 2^64 - 1 (error 6
note bad number, 8 out of range). tw = its raw 64 bits (a negative one as two's complement); tbig = 1
note when it is 2^63 or more (only a ulong holds it), else 0. As om4's TK_NUM.
note The float-marker scan walks the word in chunks of at most 999999 bytes: a single loop's hidden
note 1000000-pass guard trapped 4 on a decimal word of 1000001 digits, which must refuse with error 6 (#671).
fn tok_num to void
if ne get om2 0 0
if ne tok_hex 0
ret
end
end
p = get ts 0
e = get cur 0
fl = false
i = p
while lt i e
c = sub e i
if gt c 999999
c = ulong 999999
end
for k ulong c
b = a_ib add i k
if or or or eq b 46 eq b 101 eq b 69 eq b 102
fl = true
end
end
i = add i c
end
if fl
put tk 0 5
ret
end
minus = false
if eq uchar and shr get a_ar shr p 3 shl and p 7 3 255 45
minus = true
p = add p 1
end
ndig = sub e p
if eq ndig 0
note d2site 10|tok_num: malformed number or token; condition if eq ndig 0
put d2site 0 10
nfail 6
end
if gt ndig 20
note d2site 11|tok_num: malformed number or token; condition if gt ndig 20
put d2site 0 11
nfail 6
end
v = ulong 0
lim = ulong 1844674407370955161
i = p
while lt i e
d = sub ulong a_ib i 48
if gt d 9
note d2site 12|tok_num: malformed number or token; condition if gt d 9
put d2site 0 12
nfail 6
end
if gt v lim
note d2site 13|tok_num: number out of range for its type or place; condition if gt v lim
put d2site 0 13
nfail 8
end
if and eq v lim gt d 5
note d2site 14|tok_num: number out of range for its type or place; condition if and eq v lim gt d 5
put d2site 0 14
nfail 8
end
v = add mul v 10 d
i = add i 1
end
half = shl ulong 1 63
put tbig 0 0
if minus
if gt v half
note d2site 15|tok_num: number out of range for its type or place; condition if gt v half
put d2site 0 15
nfail 8
end
put tw 0 sub ulong 0 v
else
if ge v half
put tbig 0 1
end
put tw 0 v
end
put tk 0 2
end

note tok_text: a text literal starting at the opening quote. tw = first byte offset, tl = source length
note (escapes not yet decoded). Ends at an unescaped '"' on the same line, followed by a blank/end. Err 22.
note (Loops over the input are two loops, the inner under 1000000 passes: om4 has no pass limit.)
fn tok_text to void
put cur 0 add get cur 0 1
put tw 0 get cur 0
go = true
while go
n = ulong 0
while and go lt n 999999
if ge get cur 0 get inlen 0
note d2site 16|tok_text: malformed text literal; condition if ge get cur 0 get inlen 0
put d2site 0 16
fail 22
end
b = a_ib get cur 0
if eq b 10
note d2site 17|tok_text: malformed text literal; condition if eq b 10
put d2site 0 17
fail 22
end
if eq b 34
go = false
else
put cur 0 add get cur 0 1
if eq b 92
if ge get cur 0 get inlen 0
note d2site 18|tok_text: malformed text literal; condition if ge get cur 0 get inlen 0
put d2site 0 18
fail 22
end
if eq a_ib get cur 0 10
note d2site 19|tok_text: malformed text literal; condition if eq a_ib get cur 0 10
put d2site 0 19
fail 22
end
put cur 0 add get cur 0 1
end
end
n = add n 1
end
end
put tl 0 sub get cur 0 get tw 0
put cur 0 add get cur 0 1
put tk 0 4
if lt get cur 0 get inlen 0
if gt a_ib get cur 0 32
note d2site 20|tok_text: malformed text literal; condition if gt a_ib get cur 0 32
put d2site 0 20
fail 22
end
end
end

note tok2: a word at cur with first byte c; packs 8 bytes into tw, sets tl and ts. A '"' is a text; a
note first byte '-' or a digit is a number.
fn tok2 c uchar to void
if eq c 34
tok_text
ret
end
put ts 0 get cur 0
if or eq c 40 eq c 41
put tw 0 ulong c
put tl 0 1
put cur 0 add get cur 0 1
put tk 0 1
ret
end
w = ulong 0
sh = ulong 0
n = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge get cur 0 get inlen 0
go = false
else
b = a_ib get cur 0
if le b 32
go = false
else
if or eq b 40 eq b 41
go = false
else
if lt n 8
w = or w shl ulong b sh
sh = add sh 8
end
n = add n 1
put cur 0 add get cur 0 1
end
end
end
m = add m 1
end
end
put tw 0 w
put tl 0 n
put tw8 0 w
if and gt n 8 le n 63
if ne c 45
if or lt c 48 gt c 57
note intern the long name (the long-names notes above the name table): its index from ln_intern
put tw 0 add 1 shl ln_intern get ts 0 n 8
end
end
end
f = a_ib get ts 0
isnum = false
if eq f 45
isnum = true
end
if and ge f 48 le f 57
isnum = true
end
if isnum
tok_num
else
put tk 0 1
end
end

note tok: next word, skipping blanks (space, tab, carriage return); newline is end of line (kind 0) and
note bumps the line number; another byte below 32 is error 16; the end of the input is kind 3. om4 TOK.
fn tok to void
go = true
while go
n = ulong 0
while and go lt n 999999
if ge get cur 0 get inlen 0
go = false
else
c = a_ib get cur 0
if or or eq c 32 eq c 9 eq c 13
put cur 0 add get cur 0 1
else
if eq c 10
put tka 0 get cur 0
put tkb 0 add get cur 0 1
put cur 0 add get cur 0 1
put line 0 add get line 0 1
put tk 0 0
ret
end
put tka 0 get cur 0
put tkb 0 add get cur 0 1
if lt c 32
note d2site 21|tok: syntax: unknown or misplaced word; condition if lt c 32
put d2site 0 21
fail 16
end
put tka 0 get cur 0
put tkb 0 get cur 0
tok2 c
put tkb 0 get cur 0
ret
end
end
n = add n 1
end
end
put tka 0 get inlen 0
put tkb 0 get inlen 0
put tk 0 3
end


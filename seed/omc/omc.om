note ======== names and functions ========
note findname: packed name -> its index + 1 among the names in scope (0 none). om4 FINDNAME. The names in
note scope are 0 .. nn - 1 (clim while a pure contract is read), without nglob .. nmlo - 1 while an inlined
note body hides its caller's locals. The lowest such index whose packed name is w is the answer, as the
note old front-to-back scan gave; the chain of w's bucket holds every name below nn, newest first.
fn findname w ulong to ulong
n = get nn 0
if ne get cpure 0 0
n = get clim 0
end
g = get nglob 0
lo = get nmlo 0
k = get a_ar add get a_rb 16 a_hash w get nh_b 0
best = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if eq k 0
go = false
else
i = sub k 1
if and lt i n eq a_g 3 i w
if or lt i g ge i lo
best = k
end
end
k = a_g 15 i
end
m = add m 1
end
end
ret best
end

note nm_link: name i becomes the newest of its bucket's chain
fn nm_link i ulong to void
h = a_hash get a_ar add get a_rb 3 i get nh_b 0
put a_ar add get a_rb 15 i get a_ar add get a_rb 16 h
put a_ar add get a_rb 16 h add i 1
end

note nm_unlk: name i, the newest name of its chain (every name above it has left), leaves it. Should a
note chain ever not start with i, the buckets are rebuilt from names 0 .. i - 1 instead.
fn nm_unlk i ulong to void
h = a_hash get a_ar add get a_rb 3 i get nh_b 0
if eq get a_ar add get a_rb 16 h add i 1
put a_ar add get a_rb 16 h get a_ar add get a_rb 15 i
else
nm_build i
end
end

note nm_build: empty buckets, then names 0 .. n - 1 linked in order
fn nm_build n ulong to void
a_gzero 4
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i n
go = false
else
nm_link i
i = add i 1
end
m = add m 1
end
end
end

note nm_set: the names in scope become 0 .. v - 1 (every write of nn but addname's): names above v leave
note their chains newest first; names between nn and v (a scope given back) join them again in order
fn nm_set v ulong to void
n = get nn 0
if gt v 0
if ge sub v 1 get a_gp 3
a_need 3 sub v 1
end
end
go = true
while go
m = ulong 0
while and go lt m 999999
if gt n v
n = sub n 1
nm_unlk n
else
if lt n v
nm_link n
n = add n 1
else
go = false
end
end
m = add m 1
end
end
put nn 0 v
end

note fn_same: function j is the name w of length l starting at input byte s (the test of the old scan)
fn fn_same j ulong w ulong l ulong s ulong to ulong
if ne get a_ar add get a_rb 21 j w
ret 0
end
if eq and w 255 1
ret 1
end
fl = get a_ar add get a_rb 25 j
if le l 8
if le fl 8
ret 1
end
ret 0
end
if ne fl l
ret 0
end
o = get a_ar add get a_rb 26 j
k = ulong 8
while lt k l
if ne a_ib add o k a_ib add s k
ret 0
end
k = add k 1
end
ret 1
end

note findfn: packed name w (first 8 bytes, or an interned long name), length l (any value up to 8 for a
note short name), start s in the input (read only for a name over 8 bytes that is not interned) ->
note function index + 1 (0 none), the lowest that matches, as the old scan gave. om4 FINDFN.
fn findfn w ulong l ulong s ulong to ulong
k = get a_ar add get a_rb 40 a_hash w get fh_b 0
best = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if eq k 0
go = false
else
j = sub k 1
if ne fn_same j w l s 0
best = k
end
k = get a_ar add get a_rb 33 j
end
m = add m 1
end
end
ret best
end

note fn_link: function f becomes the newest of its bucket's chain; at twice as many functions as buckets
note the buckets double and every function is linked again in order
fn fn_link f ulong to void
h = a_hash get a_ar add get a_rb 21 f get fh_b 0
put a_ar add get a_rb 33 f get a_ar add get a_rb 40 h
put a_ar add get a_rb 40 h add f 1
if ge add f 1 shl ulong 2 get fh_b 0
b = add get fh_b 0 1
put fh_b 0 b
if ge sub shl ulong 1 b 1 get a_gp 8
a_need 8 sub shl ulong 1 b 1
end
a_gzero 8
j = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if gt j f
go = false
else
h = a_hash get a_ar add get a_rb 21 j b
a_p 33 j a_g 40 h
put a_ar add get a_rb 40 h add j 1
j = add j 1
end
m = add m 1
end
end
end
end

note ln_hw: the hash word of the n input bytes at s
fn ln_hw s ulong n ulong to ulong
w = ulong 0
i = ulong 0
while lt i n
w = add mul w 31 ulong a_ib add s i
i = add i 1
end
ret w
end

note ln_same: long name j is spelled as the n input bytes at s
fn ln_same j ulong s ulong n ulong to ulong
if ne ulong uchar get a_ar add get a_rb 18 j n
ret 0
end
o = get a_ar add get a_rb 17 j
i = ulong 0
while lt i n
if ne a_ib add o i a_ib add s i
ret 0
end
i = add i 1
end
ret 1
end

note ln_intern: the index of the long name spelled by the n input bytes at s. A spelling met for the first
note time is appended (indices in order of first appearance, as before) and linked into its chain; at
note twice as many long names as buckets the buckets double and every name is linked again.
fn ln_intern s ulong n ulong to ulong
h = a_hash ln_hw s n get lh_b 0
k = get a_ar add get a_rb 20 h
go = true
while go
m = ulong 0
while and go lt m 999999
if eq k 0
go = false
else
j = sub k 1
if ne ln_same j s n 0
ret j
end
k = get a_ar add get a_rb 19 j
end
m = add m 1
end
end
k = get ln_n 0
if ge k get a_gp 5
a_need 5 k
end
put a_ar add get a_rb 17 k s
a_pc 18 k uchar n
a_p 19 k a_g 20 h
put a_ar add get a_rb 20 h add k 1
put ln_n 0 add k 1
if ge add k 1 shl ulong 2 get lh_b 0
ln_rehash add k 1
end
ret k

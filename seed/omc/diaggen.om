note Diagnostic source generator. Compose after the core of seed/trace/sha256.om; compile in OM-2.
note Usage: diaggen OMC_SOURCE ERROR_REG SHA_SOURCE RUNTIME_SOURCE [sites]
note Or: diaggen OMC_SOURCE OMC_BINARY, a derived append-only size-history row.
note stdout is canonical compiler source, or the documented site catalog when argc is 6.
global buf uchar *
global bn ulong 1
global src uchar *
global sn ulong 1
global obuf uchar *
global on ulong 1
global path uchar 4096
text beginmark "note D2-GENERATED-BEGIN"
text endmark "note D2-GENERATED-END"
text pinhead "text d2pin \""
text sitehead "note d2site "
text reghead "omc|"
text fnhead "fn "
text shastop "fn sha256 "
text names "h w k nr blk kset mask ror ch maj bs0 bs1 ss0 ss1 kinit hinit compress"
text dsp "ds_"
text premeans "text d2means \""
text presites "text d2sites \""
text tail "\"\n"
text header "\nnote D2-GENERATED-BEGIN\n"
text footer "\nnote D2-GENERATED-END\n"

fn load arg ulong to void
p = argread arg path 0 len path
if or le p 0 ge p long len path
exit 61
end
fd = fopen path 0 ulong p 0 0
if lt fd 0
exit 62
end
n = ulong 0
while true bound 9223372036854775807
if gt n sub ulong 9223372036854775807 4096
exit 63
end
if lt len buf add n 4096
z = enlarge buf add n 4096
if ne z 0
exit 63
end
end
nr = read int fd buf n 4096
if lt nr 0
exit 64
end
if eq nr 0
break
end
n = add n ulong nr
end
z = fclose int fd
put bn 0 n
end

fn ob c uchar to void
n = get on 0
if eq n len obuf
cap = ulong 9223372036854775807
if le n div sub cap 4096 2
cap = add mul n 2 4096
end
if eq n cap
exit 63
end
z = enlarge obuf cap
if ne z 0
exit 63
end
end
put obuf n c
put on 0 add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 9223372036854775807
ob get t i
end
end

fn esc c uchar to void
if eq c 10
ob 92
ob 110
else
if or eq c 92 eq c 34
ob 92
end
ob c
end
end

fn match p ulong t view uchar * to bool
if gt add p len t get bn 0
ret false
end
for i ulong len t bound 9223372036854775807
if ne get buf add p i get t i
ret false
end
end
ret true
end

fn nl p ulong to ulong
i = p
while lt i get bn 0 bound 9223372036854775807
if eq get buf i 10
ret i
end
i = add i 1
end
ret i
end

fn rename a ulong b ulong to bool
p = ulong 0
while lt p len names bound 9223372036854775807
q = p
while lt q len names bound 9223372036854775807
if eq get names q 32
break
end
q = add q 1
end
if eq sub b a sub q p
same = true
for i ulong sub b a bound 9223372036854775807
if ne get buf add a i get names add p i
same = false
end
end
if same
ret true
end
end
p = add q 1
end
ret false
end

fn hashout pos ulong to void
hinit
i = ulong 0
while ge sub get on 0 i 64 bound 9223372036854775807
for j ulong 64 bound 9223372036854775807
put blk j get obuf add i j
end
compress
i = add i 64
end
n = sub get on 0 i
for j ulong 64 bound 9223372036854775807
put blk j 0
end
for j ulong n bound 9223372036854775807
put blk j get obuf add i j
end
put blk n 128
if ge n 56
compress
for j ulong 64 bound 9223372036854775807
put blk j 0
end
end
bits = mul get on 0 8
for j ulong 8 bound 9223372036854775807
put blk add 56 j uchar and shr bits mul sub 7 j 8 255
end
compress
hexout pos
end

fn hexout pos ulong to void
for j ulong 32 bound 9223372036854775807
v = and shr get h div j 4 mul sub 3 rem j 4 8 255
hi = shr v 4
lo = and v 15
if lt hi 10
put obuf add pos mul j 2 uchar add hi 48
else
put obuf add pos mul j 2 uchar add hi 87
end
if lt lo 10
put obuf add add pos mul j 2 1 uchar add lo 48
else
put obuf add add pos mul j 2 1 uchar add lo 87
end
end
end

fn flush to void
i = ulong 0
while lt i get on 0 bound 9223372036854775807
nr = write 1 obuf i sub get on 0 i
if le nr 0
exit 65
end
i = add i ulong nr
end
end

global marks ulong 2
fn scan to void
i = ulong 0
nb = ulong 0
ends = ulong 0
while lt i get bn 0 bound 9223372036854775807
j = nl i
if match i beginmark
put marks 0 i
nb = add nb 1
end
if match i endmark
put marks 1 add j 1
ends = add ends 1
end
i = add j 1
end
if or or ne nb 1 ne ends 1 le get marks 1 get marks 0
exit 66
end
end
fn sites escaped bool to void
i = ulong 0
while lt i get bn 0 bound 9223372036854775807
j = nl i
if match i sitehead
p = add i len sitehead
while lt p j bound 9223372036854775807
if escaped
esc get buf p
else
ob get buf p
end
p = add p 1
end
if escaped
esc 10
else
ob 10
end
end
i = add j 1
end
end
fn means to void
i = ulong 0
while lt i get bn 0 bound 9223372036854775807
j = nl i
if match i reghead
p = add i len reghead
bars = ulong 0
while lt p j bound 9223372036854775807
c = get buf p
if eq c 124
bars = add bars 1
if eq bars 1
esc 124
end
else
if or eq bars 0 eq bars 3
esc c
end
end
p = add p 1
end
esc 10
end
i = add j 1
end
end
fn runtimehead to void
i = ulong 0
while lt i get bn 0 bound 9223372036854775807
if match i fnhead
ret
end
ob get buf i
i = add i 1
end
end
fn runtimebody to void
i = ulong 0
while lt i get bn 0 bound 9223372036854775807
if match i fnhead
break
end
i = add i 1
end
while lt i get bn 0 bound 9223372036854775807
ob get buf i
i = add i 1
end
end
fn shacore to void
i = ulong 0
while lt i get bn 0 bound 9223372036854775807
if match i shastop
ret
end
c = get buf i
if or or eq c 32 eq c 10 eq c 13
ob c
i = add i 1
else
j = i
while lt j get bn 0 bound 9223372036854775807
c = get buf j
if or or eq c 32 eq c 10 eq c 13
break
end
j = add j 1
end
if rename i j
ot dsp
end
while lt i j bound 9223372036854775807
ob get buf i
i = add i 1
end
end
end
end
text sizetag "seeded-"
text sizedesc "\tGenerated from seeded source and executable\t"

fn decimal n ulong to void
if ge n 10
decimal div n 10
end
ob uchar add 48 rem n 10
end

fn sizerecord to void
load 1
lines = ulong 0
functions = ulong 0
for i ulong get bn 0 bound 9223372036854775807
start = eq i 0
if gt i 0
start = eq get buf sub i 1 10
end
if start
if match i fnhead
functions = add functions 1
end
end
if eq get buf i 10
lines = add lines 1
end
end
load 2
n = get bn 0
if lt n 176
exit 67
end
if ne rem sub n 176 4 0
exit 67
end
if ne get buf 0 127
exit 67
end
if ne get buf 1 69
exit 67
end
if ne get buf 2 76
exit 67
end
if ne get buf 3 70
exit 67
end
for i ulong n bound 9223372036854775807
ob get buf i
end
hashout 0
z = enlarge src 64
if ne z 0
exit 63
end
for i ulong 64
put src i get obuf i
end
put on 0 0
ot sizetag
for i ulong 12
ob get src i
end
ot sizedesc
decimal lines
ob 9
decimal functions
ob 9
decimal div sub n 176 4
ob 9
for i ulong 64
ob get src i
end
ob 10
flush
end

fn main to int
if eq argcnt 3
sizerecord
ret 0
end
if or lt argcnt 5 gt argcnt 6
ret 60
end
load 1
scan
if eq argcnt 6
sites false
flush
ret 0
end
z = enlarge src get bn 0
if ne z 0
ret 63
end
put sn 0 get bn 0
for i ulong get bn 0 bound 9223372036854775807
put src i get buf i
end
for i ulong get marks 0 bound 9223372036854775807
ob get src i
end
ot beginmark
ob 10
ot pinhead
pinpos = get on 0
for i ulong 64 bound 9223372036854775807
ob 48
end
ot tail
load 2
ot premeans
means
ot tail
load 1
ot presites
sites true
ot tail
load 4
runtimehead
load 3
shacore
load 4
runtimebody
ot footer
finish = get marks 1
if lt finish get sn 0
for i ulong sub get sn 0 finish bound 9223372036854775807
ob get src add finish i
end
end
hashout pinpos
flush
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/recovered-owners.sh compile=16 refusal=standalone-view standalone error16 at a view-parameter declaration; real composition prepends OM2 and SHA core; full seed build owns composed generation

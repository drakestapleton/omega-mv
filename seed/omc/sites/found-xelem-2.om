target x86efi
note sites: found by a one-token change of a tracked program (41 to 120 lines); reaches the omc error site in xelem (code 7)
note efi 11 with two FAT volumes: the boot stick and a second stick whose \EFI\BOOT\BOOTX64.EFI
note holds the 4 bytes "junk". Count the volumes, read the other volume's file (4 bytes), read
note this image from the boot volume, write it over the other volume's file, read it back and
note compare, then ask for volume 9 (error 19). One character per result: the count, the boot
note index, then 1 for each check that held (0 if not), then the low 6 bits of the volume 9
note status + 48 (C = 19) and 1 if that status has bit 63 set.
global ms uchar 32
global Img uchar 2097152
global Back uchar 2097152

fn pr n ulong to void
r = efi 13 0 ms 0 n
end

fn bit b bool to uchar
if b
ret uchar 49
end
ret uchar 48
end

fn main to ulong
put ms false 61
put ms 1 61
put ms 2 66
put ms 3 10
pr 4
r = efi 11 0 Img 0 0
n = and r 255
boot = and shr r 8 255
tgt = ulong 0
if eq boot 0
tgt = 1
end
junk = efi 11 or 1 shl tgt 8 Back 0 len Back
rd = efi 11 or 1 shl boot 8 Img 0 len Img
wr = efi 11 or 2 shl tgt 8 Img 0 rd
rb = efi 11 or 1 shl tgt 8 Back 0 len Back
same = eq rb rd
if same
j = ulong 0
while lt j rd
if ne get Img j get Back j
same = false
break
end
j = add j 1
end
end
e = efi 11 ulong 2305 Back 0 len Back
put ms 0 uchar add 48 and n 63
put ms 1 uchar add 48 and boot 63
put ms 2 bit and eq shr r 63 0 eq junk 4
put ms 3 bit and eq shr rd 63 0 gt rd 4096
put ms 4 bit eq wr rd
put ms 5 bit same
put ms 6 uchar add 48 and e 63
put ms 7 bit eq shr e 63 1
put ms 8 10
put ms 9 61
put ms 10 61
put ms 11 69
put ms 12 10
pr 13
ret 0
end

target x86linux
note sites: found by a one-token change of a tracked program (41 to 120 lines); reaches the omc error site in xhmmio (code 9)
note dev.om: an OM-2 function unit (no fn main) using every function-mode clock and device word:
note monons realns sleepns, devctl devcall uvmctl, mapnew mapaddr mapset mapget mapwrite mapread mapdrop,
note with cpufence between the payload and the doorbell. The mapping words find their table through
note runtime-table entry 31 (seed/host/MAPPING.md, function mode); the exact code is pinned by sha256.
om2
fn clk to long
a = monons
s = sleepns long 1000
b = monons
r = realns
if lt s 0
ret s
end
if lt r 0
ret r
end
ret sub b a
end
fn dev fd int to long
b = new uchar 48 0
r = devctl fd uint 21531 b 0 4
if lt r 0
ret r
end
r = devctl fd uint 3224389163 b 0 48
hd = new uchar 32 0
pa = new uchar 16 0
k = devcall fd uint 3223340587 hd 0 32 pa 0 16
u = uvmctl fd uint 75 b 0 8
ret add add r k u
end
fn ring v ulong to long
h = mapnew neg int 1 0 4096 3 34
if lt h 0
ret h
end
p = new uchar 16 7
a = mapaddr h
w = mapwrite h 16 p 0 16
cpufence
d = mapset h 8 int v
d = mapset h 0 4 1
x = long mapget h 8 8
q = new uchar 16 0
n = mapread h 16 q 0 16
z = mapdrop h
if eq a 0
ret -1
end
ret add x long get q 15
end

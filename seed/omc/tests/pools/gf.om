note gate-pools 1: float pools. F (f64) and G (f32) grow by 4096 elements 40 times, a blocker pool B above
note them forcing moves; each value written is read back after every grow. Prints 2*F[k] and 4*G[k] (as
note ulong), their sums, both lengths, the last elements (0), then G at its length traps 3.
global B uchar *
global F f64 *
global G f32 *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge B ulong 1
r = enlarge F ulong 1
r = enlarge G ulong 1
pnum ulong get F 0
k = ulong 0
while lt k 40
r = enlarge B add len B 4096
r = enlarge F add len F 4096
r = enlarge G add len G 4096
put F k add f64 k 0.5f64
put G k add f32 k 0.25f32
pnum ulong mul get F k 2.0f64
pnum ulong mul get G k 4.0f32
k = add k 1
end
s = ulong 0
t = ulong 0
k = ulong 0
while lt k 40
s = add s ulong mul get F k 2.0f64
t = add t ulong mul get G k 4.0f32
k = add k 1
end
pnum s
pnum t
pnum len F
pnum len G
pnum ulong get F sub len F 1
pnum ulong get G 40
n = len G
pnum ulong get G n
ret 0
end

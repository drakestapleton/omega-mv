note gate-pools 8: n times the element size at or past 2^63 is -22 with nothing changed; just below it the
note host refuses (-12).
global P ulong *
global U uchar *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 1152921504606846976
plong r
pnum len P
r = enlarge P ulong 18446744073709551615
plong r
r = enlarge P ulong 1152921504606846975
plong r
pnum len P
r = enlarge U ulong 9223372036854775808
plong r
r = enlarge U ulong 9223372036854775807
plong r
pnum len U
r = enlarge P ulong 3
plong r
put P 2 11
r = enlarge P ulong 2305843009213693952
plong r
pnum len P
pnum get P 2
ret 5
end

note gate-pools 8: run under prlimit --as=268435456: an 8 GiB enlarge returns -12, the pool is unchanged,
note the program goes on and ends with its own status 7. Without the limit the first 8 GiB enlarge gives 0.
global P ulong *
global Q ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 1000
plong r
put P 5 42
r = enlarge P ulong 1073741824
plong r
pnum len P
pnum get P 5
r = enlarge Q ulong 1073741824
plong r
pnum len Q
r = enlarge P ulong 2000
plong r
pnum len P
pnum get P 5
ret 7
end

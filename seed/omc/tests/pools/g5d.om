om2
note gate-pools 5: a constant index in an inline body keeps its run-time check (7 in range, 9 not).
global P ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn g7 to ulong inline
ret get P 7
end
fn g9 to ulong inline
ret get P 9
end
fn main to int
r = enlarge P ulong 8
put P 7 4
pnum g7
pnum g9
ret 0
end

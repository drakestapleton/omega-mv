om2
note gate-pools 3: enlarge runs inside the value of put, the index of get, and the counts of read and
note write; every call grows the pool it serves by 4096 elements and a blocker pool beside it, so mremap
note moves the regions and later mappings reuse the old addresses (the gate counts both with strace).
note stdin: the 40 bytes abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN. Every grower is an OM-2 inline body.
global P ulong *
global Q ulong *
global U uchar *
global V uchar *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn gv v ulong to ulong inline
r = enlarge P add len P 4096
r = enlarge Q add len Q 4096
ret v
end
fn gi j ulong to ulong inline
r = enlarge P add len P 4096
r = enlarge Q add len Q 4096
ret j
end
fn gu n ulong to ulong inline
r = enlarge U add len U 4096
r = enlarge V add len V 4096
ret n
end
fn main to int
r = enlarge Q ulong 1
r = enlarge P ulong 1
r = enlarge V ulong 1
r = enlarge U ulong 64
j = ulong 0
while lt j 40
put P j gv add mul j 3 1
x = get P gi j
pnum x
k = read 0 U j gu 1
k = write 1 U j gu 1
pnum ulong k
j = add j 1
end
k = write 1 U 0 40
s = ulong 0
j = ulong 0
while lt j 40
s = add s get P j
j = add j 1
end
pnum s
pnum len P
pnum len U
ret 0
end

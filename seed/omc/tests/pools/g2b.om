note gate-pools 2: a number index past the length compiles (no error 21) and traps 3 at run time (put).
global P ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 4
put P 3 6
pnum get P 3
put P 100 1
pnum get P 100
ret 0
end

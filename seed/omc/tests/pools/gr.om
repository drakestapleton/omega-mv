note gate-pools 3: a uchar pool filled by read 0 P off n from a pipe, n given by a function that enlarges P
note (and a blocker B above it) by 65536 elements before every read; then the bytes are written back and their
note count printed. The gate feeds it `seq 1 200000` through a pipe; its expected output is built there.
global B uchar *
global P uchar *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn gn n ulong to ulong
r = enlarge B add len B 4096
r = enlarge P add len P n
ret n
end
fn main to int
r = enlarge B ulong 1
r = enlarge P ulong 1
used = ulong 0
go = true
while go bound 100000
k = read 0 P used gn 65536
if lt k 0
ret 2
end
if eq k 0
go = false
else
used = add used ulong k
end
end
o = ulong 0
while lt o used bound 100000
k = write 1 P o sub used o
if le k 0
ret 3
end
o = add o ulong k
end
pnum used
ret 0
end

note gate-pools 9: a 2 GiB pool with one page touched adds about one page of VmRSS. Prints the length,
note then VmRSS (kB) before the grow, after touching one page, and after touching 1024 more (the control).
global P uchar *
global sb uchar 4096
global ob uchar 24
text pth "/proc/self/status"
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn hit i ulong to bool
a = and eq get sb i 86 eq get sb add i 1 109
b = and eq get sb add i 2 82 eq get sb add i 5 58
ret and a b
end
fn rss to ulong
fd = fopen pth 0 len pth 0 0
if lt fd 0
ret 0
end
n = read int fd sb 0 4096
fd = fclose int fd
if le n 0
ret 0
end
lim = ulong n
i = ulong 0
while lt add i 6 lim bound 4096
if hit i
break
end
i = add i 1
end
i = add i 6
v = ulong 0
while lt i lim bound 4096
ch = get sb i
if and ge ch 48 le ch 57
v = add mul v 10 ulong sub ch 48
else
if and ne ch 32 ne ch 9
break
end
end
i = add i 1
end
ret v
end
fn main to int
a = rss
a = rss
r = enlarge P ulong 2147483648
if ne r 0
ret 3
end
put P 12345678 1
b = rss
i = ulong 0
while lt i 1024
put P add 1000000000 mul i 4096 1
i = add i 1
end
c = rss
pnum len P
pnum a
pnum b
pnum c
ret 0
end

om2 diag
note gate-pools 5: requires eq len P 0 is kept (rule=runtime) and holds before the grow, fails after it.
global P ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn f k ulong to ulong
requires eq len P 0
ret k
end
fn main to int
x = f 1
pnum x
r = enlarge P ulong 8
x = f 2
pnum x
ret 0
end

note gate-pools 2: an index equal to the length (a variable) traps 3 before any store; len + 1 is in range
note after a grow. With the compare removed the put lands and the next lines print 9.
global P ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 10
put P 9 1
pnum get P 9
r = enlarge P ulong 11
put P 10 5
pnum get P 10
i = len P
put P i 9
r = enlarge P ulong 12
pnum get P 11
ret 0
end

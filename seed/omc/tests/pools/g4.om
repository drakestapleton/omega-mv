om2
note gate-pools 4: the first global is a pool, sized globals follow. The pool takes no pinned register: the
note set of X18..X26 written by this unit equals that of g4base.om (the same unit without the pool).
global P ulong *
global g ulong 10
global h ulong 5000
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 1000
put P 999 5
put g 9 6
put h 4999 7
r = enlarge P ulong 1000000
put P 999999 8
pnum get P 999
pnum get g 9
pnum get h 4999
pnum get P 999999
pnum len P
ret 0
end

om2
note gate-pools 5: a constant index under unroll keeps its run-time check (length 8, copies 0..11).
global P ulong *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge P ulong 8
for j ulong 12 unroll
put P j add j 1
pnum get P j
end
ret 0
end

om2
note gate-pools 4 baseline: g4.om without the pool (compiled only, for the pinned register set).
global g ulong 10
global h ulong 5000
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
put g 9 6
put h 4999 7
pnum get g 9
pnum get h 4999
ret 0
end

note gate-pools 1: growth and contents. P grows 0 -> 1 -> 2 -> 512 -> 513 -> 4096 (then 10 and 4096,
note which change nothing) -> 2^20 -> 2^27 elements; Q (uchar) grows past 16777216 elements, then to 2^27.
note Old values are kept and new elements are 0 at every step.
global P ulong *
global Q uchar *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn psum a ulong b ulong to ulong
s = ulong 0
i = a
while lt i b bound 200000000
s = add s get P i
i = add i 1
end
ret s
end
fn qsum a ulong b ulong to ulong
s = ulong 0
i = a
while lt i b bound 200000000
s = add s ulong get Q i
i = add i 1
end
ret s
end
fn main to int
pnum len P
r = enlarge P ulong 1
plong r
pnum len P
pnum get P 0
put P 0 7
r = enlarge P ulong 2
plong r
pnum len P
pnum get P 0
pnum get P 1
put P 1 8
r = enlarge P ulong 512
plong r
pnum len P
pnum psum 2 512
r = enlarge P ulong 513
plong r
pnum len P
pnum get P 0
pnum get P 1
pnum get P 512
r = enlarge P ulong 4096
plong r
pnum len P
pnum psum 2 4096
i = ulong 0
while lt i 4096
put P i add i 1
i = add i 1
end
r = enlarge P ulong 10
plong r
pnum len P
pnum psum 0 4096
r = enlarge P ulong 4096
plong r
pnum len P
r = enlarge P ulong 1048576
plong r
pnum len P
pnum psum 0 4096
pnum psum 4096 1048576
i = ulong 4096
while lt i 1048576 bound 2000000
put P i i
i = add i 1
end
pnum psum 0 1048576
r = enlarge P ulong 134217728
plong r
pnum len P
pnum psum 0 1048576
s = ulong 0
i = ulong 1048576
while lt i 134217728 bound 200000
s = add s get P i
i = add i 4096
end
pnum s
put P 134217727 5
pnum get P 134217727
pnum get P 1048575
r = enlarge Q ulong 16777217
plong r
pnum len Q
i = ulong 0
while lt i 16777217 bound 20000000
put Q i uchar and i 255
i = add i 1
end
pnum qsum 0 16777217
pnum ulong get Q 16777216
r = enlarge Q ulong 134217728
plong r
pnum len Q
pnum qsum 0 16777217
pnum qsum 16777217 134217728
ret 0
end

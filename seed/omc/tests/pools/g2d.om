note gate-pools 2: a read or write slice past the length traps 3 (uchar pool, write path).
global U uchar *
global ob uchar 24
fn pnum v ulong to void
put ob 23 10
i = ulong 23
x = v
go = true
while go bound 21
i = sub i 1
put ob i uchar add rem x 10 48
x = div x 10
go = ne x 0
end
k = write 1 ob i sub 24 i
end
fn plong v long to void
if lt v 0
put ob 0 uchar 45
k = write 1 ob 0 1
pnum ulong neg v
else
pnum ulong v
end
end
fn main to int
r = enlarge U ulong 3
put U 0 79
put U 1 75
put U 2 10
k = write 1 U 0 3
n = len U
k = write 1 U 1 n
pnum 9
ret 0
end

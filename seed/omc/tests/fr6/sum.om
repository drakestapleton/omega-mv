note Two threads add 20 and 22 into one atomic cell. After both joins, adding 0
note returns the old value. That value is 42. Exit 42. A lost update would be 20 or 22.
global cell ulong 1
thread fn add20 to int
d = aadd cell 20
ret 1
end
thread fn add22 to int
d = aadd cell 22
ret 2
end
fn main to int
a = spawn add20
b = spawn add22
r1 = join a
r2 = join b
if ne r1 1
ret 1
end
if ne r2 2
ret 2
end
v = aadd cell 0
if ne v 42
ret 3
end
ret 42
end

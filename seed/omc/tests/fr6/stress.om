note Eight threads each add 1, ten thousand times, to one cell. The old value
note read after every join is 80000. A lost update is any other number.
global cell ulong 1
thread fn worker to int
i = ulong 0
while lt i 10000 bound 10000
d = aadd cell 1
i = add i 1
end
ret 1
end
fn main to int
a = spawn worker
b = spawn worker
c = spawn worker
d = spawn worker
e = spawn worker
f = spawn worker
g = spawn worker
h = spawn worker
r = join a
if ne r 1
ret 1
end
r = join b
if ne r 1
ret 1
end
r = join c
if ne r 1
ret 1
end
r = join d
if ne r 1
ret 1
end
r = join e
if ne r 1
ret 1
end
r = join f
if ne r 1
ret 1
end
r = join g
if ne r 1
ret 1
end
r = join h
if ne r 1
ret 1
end
v = aadd cell 0
if ne v 80000
ret 2
end
ret 42
end

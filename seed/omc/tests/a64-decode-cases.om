om2
note Deterministic parity input for seed/check/a64check.om and the retained C reference.
note 65536 xorshift words plus every one-bit flip of every decoder pattern, then 4096 low-register
note and immediate variations per pattern. Constants are the C reference's pattern words, not a new ISA.
text hx "0123456789abcdef"
global outb uchar 65536
global outn ulong 1
fn flush to void
p = ulong 0
while lt p get outn 0 bound 65536
r = write 1 outb p sub get outn 0 p
if le r 0
exit 2
end
p = add p ulong r
end
put outn 0 0
end
fn emit w uint to void
if gt get outn 0 65527
flush
end
p = get outn 0
for j ulong 8
v = and shr ulong w sub 28 mul j 4 15
put outb add p j get hx v
end
put outb add p 8 10
put outn 0 add p 9
end
fn pattern i ulong to uint
if eq i 0
ret 0xd65f03c0
end
if eq i 1
ret 0x14000000
end
if eq i 2
ret 0x54000000
end
if eq i 3
ret 0x34000000
end
if eq i 4
ret 0x35000000
end
if eq i 5
ret 0x52800000
end
if eq i 6
ret 0x1b007c00
end
if eq i 7
ret 0x0a000000
end
if eq i 8
ret 0x2a000000
end
if eq i 9
ret 0x4a000000
end
if eq i 10
ret 0x0b000000
end
if eq i 11
ret 0x4b000000
end
if eq i 12
ret 0x72800000
end
if eq i 13
ret 0x10000000
end
if eq i 14
ret 0xb9400000
end
if eq i 15
ret 0xb9000000
end
if eq i 16
ret 0xb8400400
end
if eq i 17
ret 0xb8000400
end
if eq i 18
ret 0x39400000
end
if eq i 19
ret 0x39000000
end
if eq i 20
ret 0x71000000
end
ret 0x6b000000
end
fn main to int
x = uint 1077
for i ulong 65536
x = xor x shl x 13
x = xor x shr x 17
x = xor x shl x 5
emit x
end
for i ulong 22
b = pattern i
for j uint 32
emit xor b shl uint 1 j
end
for k uint 4096
emit or b or shl and k 31 16 and k 1023
emit or or b 0x80000000 shl k 5
end
end
flush
ret 0
end

struct packed P a uchar b ushort c uint end
fn see p view P to uint
ret get p c
end
fn setc p edit P to void
put p a 9
end
fn main to int
p = new P 17 8755 1146447479
if ne get p a 17
ret 1
end
if ne get p b 8755
ret 2
end
if ne get p c 1146447479
ret 3
end
if ne see p 1146447479
ret 4
end
setc p
if ne get p a 9
ret 5
end
ret 0
end

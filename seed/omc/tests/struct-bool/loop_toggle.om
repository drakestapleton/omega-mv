note loop_toggle.om: put and get on a bool field inside a loop. Seven flips from false end true;
note the count of times the field read true on the way is 3. Result 3 * 10 + 1.
struct W n uint f bool end
fn main to uint
w = new W 0 false
for i uint 7
if eq get w f true
put w n add get w n 1
end
if eq get w f true
put w f false
else
put w f true
end
end
r = mul get w n 10
if eq get w f true
r = add r 1
end
ret r
end

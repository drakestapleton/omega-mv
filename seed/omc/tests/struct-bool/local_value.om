note local_value.om: bool values held in locals (a comparison, a not, a read back from the field)
note go into new and put. t = lt x 3 with x = 2 (true), u = not t (false), v = get w f. Result 1 + 2 + 4.
struct W a uint f bool end
fn main to uint
x = uint 2
t = lt x 3
u = not t
w = new W 1 t
r = uint 0
if eq get w f true
r = add r 1
end
put w f u
v = get w f
if eq v false
r = add r 2
end
put w f t
v = get w f
if eq v true
r = add r 4
end
ret r
end

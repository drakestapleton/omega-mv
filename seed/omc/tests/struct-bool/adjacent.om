note adjacent.om: three bool fields in a row hold independent values. x y z = true false true
note reads as bits 1 + 4 = 5 (checked first); after put y true, put x false it reads 2 + 4 = 6.
struct B x bool y bool z bool end
fn main to uint
b = new B true false true
r = uint 0
if eq get b x true
r = add r 1
end
if eq get b y true
r = add r 2
end
if eq get b z true
r = add r 4
end
if ne r 5
ret 90
end
put b y true
put b x false
r = uint 0
if eq get b x true
r = add r 1
end
if eq get b y true
r = add r 2
end
if eq get b z true
r = add r 4
end
ret r
end

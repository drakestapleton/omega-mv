note func_value.om: a bool field set from the value of a function call, in new and in put.
note big(5) is true and big(2) is false: new with true -> 1, put false -> 2, put true -> 4, a=3.
struct W a uint f bool end
fn big x uint to bool
ret gt x 3
end
fn main to uint
w = new W 3 big 5
r = uint 0
if eq get w f true
r = add r 1
end
put w f big 2
if eq get w f false
r = add r 2
end
put w f big 9
if eq get w f true
r = add r 4
end
ret add r sub get w a 3
end

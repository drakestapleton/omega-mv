note array_fields.om: a bool field between two array fields h and t (4 uchar each). The ends of
note each array are written, the bool is written, then an end is written again; no write may
note move another field. h = 7 7 7 4, t = 6 9 9 9, f: true seen (1) then false seen (2).
note Result 3 + h0 7 + h3 4 + h1 7 + t0 6 + t3 9 + t2 9 = 45.
struct A h uchar 4 f bool t uchar 4 end
fn main to uint
a = new A 7 true 9
put a h 3 5
put a t 0 6
r = uint 0
if eq get a f true
r = add r 1
end
put a f false
put a h 3 4
if eq get a f false
r = add r 2
end
r = add r uint get a h 0
r = add r uint get a h 3
r = add r uint get a h 1
r = add r uint get a t 0
r = add r uint get a t 3
r = add r uint get a t 2
ret r
end

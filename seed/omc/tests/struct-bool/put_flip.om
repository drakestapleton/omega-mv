note put_flip.om: put changes a bool field both ways. Each correct read adds a distinct bit: 1 2 4.
struct W a uint f bool end
fn main to uint
w = new W 9 false
r = uint 0
if eq get w f false
r = add r 1
end
put w f true
if eq get w f true
r = add r 2
end
put w f false
if eq get w f false
r = add r 4
end
ret add r get w a
end

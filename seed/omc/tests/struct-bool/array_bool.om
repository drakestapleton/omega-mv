note A bool array field uses the admitted struct-field grammar.
note Its true/false/true elements contribute 1 + 0 + 4 = 5.
struct Q v bool 3 end
fn main to uint
q = new Q true
put q v 1 false
r = uint 0
if eq get q v 0 true
r = add r 1
end
if eq get q v 1 true
r = add r 2
end
if eq get q v 2 true
r = add r 4
end
ret r
end

note param_edit.om: a bool field written and read through an edit parameter, and a bool value
note passed as a parameter. set true, flip, set false; the caller sees every change. Result 7.
struct W a uint f bool end
fn setf p edit W v bool to void
put p f v
end
fn flip p edit W to void
if eq get p f true
put p f false
else
put p f true
end
end
fn main to uint
w = new W 3 false
r = uint 0
setf w true
if eq get w f true
r = add r 1
end
flip w
if eq get w f false
r = add r 2
end
flip w
if eq get w f true
r = add r 4
end
ret add r sub get w a 3
end

note long_names: a name of 9 to 63 bytes (local, parameter, for counter, global, text, const, struct,
note field) is its own name, compared in full. counter_a and counter_b share their first 8 bytes and
note stay two names, distinct from the 8-byte counter_; a name that begins with an 8-byte keyword
note (continue_count, execpure_value) is a name; a local that shares its first 8 bytes with a long
note function (add_three_total, add_three_values) is a local. Each failing check exits with its own
note status 1..10; when all pass it prints the total and exits 0.
struct point_pair left_value uint right_value long end
const table_length ulong 4
global shared_counter ulong 1
text greeting_text "long_names ok total "
text newline_text "\n"

note add_three_values: three long parameter names
fn add_three_values first_value long second_value long third_value long to long
ret add add first_value second_value third_value
end

note sum_of_pair: a struct parameter with a long name, its long fields read with get
fn sum_of_pair pair_argument view point_pair to long
ret add long get pair_argument left_value get pair_argument right_value
end

note sum_of_bytes: a sized view whose length is a long const, walked by a long for counter
fn sum_of_bytes byte_values view uchar table_length to ulong
running_total = ulong 0
for byte_index ulong table_length
running_total = add running_total ulong get byte_values byte_index
end
ret running_total
end

note bump_shared_counter: a void function with a long name and parameter, called as a statement
fn bump_shared_counter amount_to_add ulong to void
put shared_counter 0 add get shared_counter 0 amount_to_add
end

note write_decimal: print the value in decimal
fn write_decimal value_to_print ulong to void
digit_buffer = new uchar 20 0
output_buffer = new uchar 20 0
digit_count = ulong 0
remaining_value = value_to_print
keep_going = true
while keep_going bound 21
put digit_buffer digit_count uchar add rem remaining_value 10 48
digit_count = add digit_count 1
remaining_value = div remaining_value 10
if eq remaining_value 0
keep_going = false
end
end
output_index = ulong 0
while gt digit_count 0 bound 21
digit_count = sub digit_count 1
put output_buffer output_index get digit_buffer digit_count
output_index = add output_index 1
end
written_bytes = write 1 output_buffer 0 output_index
end

note checks: the names that share prefixes, then every kind of long name; 0 when all hold
fn checks to int
counter_a = long 20
counter_b = long 1
counter_ = long 100
if ne add add counter_a counter_b counter_ 121
ret 1
end
continue_count = long 3
execpure_value = long 4
if ne add continue_count execpure_value 7
ret 2
end
add_three_total = add_three_values counter_a counter_b counter_
if ne add_three_total 121
ret 3
end
a_name_that_is_exactly_sixty_three_bytes_long_for_the_omc_gate_ = long 5
if ne a_name_that_is_exactly_sixty_three_bytes_long_for_the_omc_gate_ 5
ret 4
end
point_value = new point_pair 5 -2
put point_value right_value 10
if ne sum_of_pair point_value 15
ret 5
end
if ne offsetof point_pair right_value 8
ret 6
end
if ne sizeof point_pair 16
ret 7
end
byte_array = new uchar table_length 3
if ne sum_of_bytes byte_array 12
ret 8
end
bump_shared_counter 40
bump_shared_counter 2
if ne get shared_counter 0 42
ret 9
end
if ne len greeting_text 20
ret 10
end
ret 0
end

fn main to int
check_status = checks
if ne check_status 0
ret check_status
end
written_bytes = write 1 greeting_text 0 len greeting_text
write_decimal add get shared_counter 0 121
written_bytes = write 1 newline_text 0 len newline_text
ret 0
end

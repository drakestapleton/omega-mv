note Qualification-only exact-once source substitutions; argv1: 0 FMSUB, 1 unfused,
note 2 lost decimal remainder, 3 ties down. Refuse absent/duplicate sites. Never a production compiler.
global src uchar 1048576
global needle uchar 256
global repl uchar 256
global used ulong 1
global rlen ulong 1
global arg uchar 8
text n0 "emit or b vd"
text r0 "emit or xor b 32768 vd"
text n1 "emit or b vd"
text r1 "fp_binop 35 at va vb vd\nfp_binop 33 at vd vc vd"
text n2 "put fg_stk 0 fbmul 0 1"
text r2 "put fg_stk 0 0"
text n3 "if or ne sticky 0 eq and q 1 1"
text r3 "if ne sticky 0"
fn matches i ulong to bool
for j ulong get used 0
if ne get src add i j get needle j
ret false
end
end
ret true
end
fn srcout p ulong n ulong to void
while lt p n
r = write 1 src p sub n p
if le r 0
exit 94
end
p = add p ulong r
end
end
fn main to int
if ne argcnt 2
ret 90
end
r = argread 1 arg 0 len arg
if ne r 1
ret 90
end
m = get arg 0
if or lt m 48 gt m 51
ret 90
end
if eq m 48
put used 0 len n0
put rlen 0 len r0
for i ulong len n0
put needle i get n0 i
end
for i ulong len r0
put repl i get r0 i
end
end
if eq m 49
put used 0 len n1
put rlen 0 len r1
for i ulong len n1
put needle i get n1 i
end
for i ulong len r1
put repl i get r1 i
end
end
if eq m 50
put used 0 len n2
put rlen 0 len r2
for i ulong len n2
put needle i get n2 i
end
for i ulong len r2
put repl i get r2 i
end
end
if eq m 51
put used 0 len n3
put rlen 0 len r3
for i ulong len n3
put needle i get n3 i
end
for i ulong len r3
put repl i get r3 i
end
end
n = ulong 0
go = true
while go
if eq n len src
ret 91
end
r = read 0 src n sub len src n
if lt r 0
ret 92
end
if eq r 0
go = false
else
n = add n ulong r
end
end
found = ulong 0
at = ulong 0
for i ulong n
if le get used 0 sub n i
if matches i
found = add found 1
at = i
end
end
end
if ne found 1
ret 93
end
srcout 0 at
p = ulong 0
while lt p get rlen 0
r = write 1 repl p sub get rlen 0 p
if le r 0
ret 94
end
p = add p ulong r
end
srcout add at get used 0 n
ret 0
end

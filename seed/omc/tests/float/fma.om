note fma: Wolfram rational oracle and ARM FPMulAdd semantics, see evidence/SEED-0/fma-exact-literals.
note In particular, rounding the product before adding returns zero instead of -2^-46 / -2^-104.
global cnt ulong 1
global vals f64 1
fn tick v f64 to f64
put cnt 0 add get cnt 0 1
ret v
end
fn fused a f64 b f64 c f64 to f64
ret fma a b c
end
fn fused32 a f32 b f32 c f32 to f32
ret fma a b c
end
fn check64 to int
a = bitcast f64 ulong 4607182418800017409
b = bitcast f64 ulong 4607182418800017406
r = fma a b -1.0f64
if ne bitcast ulong r 13362180094408261632
ret 1
end
if ne bitcast ulong add mul a b -1.0f64 0
ret 2
end
if ne bitcast ulong fused a b -1.0f64 13362180094408261632
ret 3
end
m = bitcast f64 ulong 9218868437227405311
if ne bitcast ulong fma m 2.0f64 neg m 9218868437227405311
ret 4
end
s = bitcast f64 ulong 1
if ne bitcast ulong fma s 0.5f64 s 2
ret 5
end
ret 0
end
fn check32 to int
a = bitcast f32 uint 1065353217
b = bitcast f32 uint 1065353214
r = fma a b -1.0f32
if ne bitcast uint r 2826960896
ret 6
end
if ne bitcast uint add mul a b -1.0f32 0
ret 7
end
if ne bitcast uint fused32 a b -1.0f32 2826960896
ret 8
end
m = bitcast f32 uint 2139095039
if ne bitcast uint fma m 2.0f32 neg m 2139095039
ret 9
end
s = bitcast f32 uint 1
if ne bitcast uint fma s 0.5f32 s 2
ret 10
end
ret 0
end
fn special to int
if ne bitcast ulong fma -0.0f64 2.0f64 -0.0f64 9223372036854775808
ret 11
end
if ne bitcast uint fma -0.0f32 2.0f32 0.0f32 0
ret 12
end
inf = div 1.0f64 0.0f64
if ne fma inf 2.0f64 0.0f64 inf
ret 13
end
n = fma 0.0f64 inf 1.0f64
if eq n n
ret 14
end
q = bitcast f64 ulong 9221120237041090626
n = fma q 2.0f64 1.0f64
if eq n n
ret 15
end
s = bitcast f64 ulong 9218868437227405313
n = fma 1.0f64 s 0.0f64
if eq n n
ret 16
end
if eq and bitcast ulong n 2251799813685248 0
ret 17
end
n = fma 1.0f64 2.0f64 q
if eq n n
ret 18
end
ret 0
end
fn main to int
r = check64
if ne r 0
ret r
end
r = check32
if ne r 0
ret r
end
r = special
if ne r 0
ret r
end
put vals 0 fma tick 2.0f64 tick 3.0f64 tick 7.0f64
if ne get cnt 0 3
ret 19
end
if ne get vals 0 13.0f64
ret 20
end
v = fma 2.0f64 fma 1.0f64 2.0f64 1.0f64 7.0f64
v = fma v 2.0f64 -1.0f64
if ne v 25.0f64
ret 21
end
if ne fma fma 1.0f32 2.0f32 3.0f32 4.0f32 fma 1.0f32 2.0f32 3.0f32 25.0f32
ret 22
end
ret 0
end

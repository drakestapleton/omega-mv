note TEST INSTRUMENT: global keyword extraction and source-token membership for gate-pools.
note D\nOLD NUL NEW reads genkw.awk output wrapped as fn kw; only newly added global words are emitted.
note U\nWORDS NUL UNIT matches whole source tokens, never notes or string literals.
note P\nNUL UNIT detects a line-start global NAME TYPE * declaration shape, not a keyword addition.
note Word boundaries and text endings follow omc tok2/tok_text; scanning stops at a lexical text error, preserving prior tokens.
note M\nFROM NUL TO NUL SOURCE is an exact-once/no-noop source mutation used only by negative controls.
note Storage grows from trusted repository input; packed compiler keywords are physical 64-bit values.
note gate-pools: uses enlarge on purpose: owner=seed/omc/gate-pools.sh keyword/source lexer test instrument
global si uchar *
global so ulong *
global sl ulong *
global ss ulong *
global sf ulong *
global sn ulong 1
global nb ulong 1
global lab ulong *
global mp ulong *
global ms ulong *
global mn ulong 1
global ow ulong *
global on ulong 1
global ob uchar 8
text names "fn\nkw\nif\neq\nw\nret\nnote\nglobal\n*\n"
fn s_pack o ulong n ulong to ulong
if gt n 8
ret 0
end
p = ulong 0
i = ulong 0
while lt i n bound 9223372036854775807
p = or p shl ulong get si add o i mul i 8
i = add i 1
end
ret p
end
fn s_tok i ulong to ulong
ret s_pack get so i get sl i
end
fn s_is i ulong id ulong to bool
ret eq s_tok i get lab id
end
fn s_init to void
n = ulong 0
for i ulong len names
if eq get names i 10
n = add n 1
end
end
r = enlarge lab n
if ne r long 0
exit 2
end
i = ulong 0
p = ulong 0
j = ulong 0
k = ulong 0
while lt i len names bound 9223372036854775807
b = get names i
if eq b 10
put lab k p
k = add k 1
p = ulong 0
j = ulong 0
else
p = or p shl ulong b mul j 8
j = add j 1
end
i = add i 1
end
end
fn s_lex to void
i = ulong 2
side = ulong 0
first = true
while lt i get nb 0 bound 9223372036854775807
b = get si i
if and eq b 0 eq side 0
side = ulong 1
first = true
i = add i 1
else
if le b 32
if eq b 10
first = true
else
if not or or eq b 32 eq b 9 eq b 13
ret
end
end
i = add i 1
else
if or eq b 40 eq b 41
i = add i 1
first = false
else
if eq b 34
i = add i 1
done = false
while and lt i get nb 0 not done bound 9223372036854775807
b = get si i
i = add i 1
if eq b 10
ret
end
if eq b 92
if lt i get nb 0
if eq get si i 10
ret
end
i = add i 1
end
else
if eq b 34
done = true
end
end
end
if not done
ret
end
if lt i get nb 0
if gt get si i 32
ret
end
end
first = false
else
o = i
while lt i get nb 0 bound 9223372036854775807
b = get si i
if or le b 32 or eq b 40 eq b 41
break
end
i = add i 1
end
n = sub i o
if and first eq s_pack o n get lab 6
while lt i get nb 0 bound 9223372036854775807
if eq get si i 10
break
end
i = add i 1
end
else
k = get sn 0
put so k o
put sl k n
put ss k side
if first
put sf k 1
else
put sf k 0
end
put sn 0 add k 1
first = false
end
end
end
end
end
end
end
fn s_num i ulong to ulong
n = get sl i
o = get so i
v = ulong 0
j = ulong 0
while lt j n bound 9223372036854775807
b = get si add o j
if or lt b 48 gt b 57
ret 0
end
v = add mul v 10 ulong sub b 48
j = add j 1
end
ret v
end
fn s_table to void
i = ulong 0
active = false
while lt add i 3 get sn 0 bound 9223372036854775807
if s_is i 0
active = s_is add i 1 1
end
if active
if and s_is i 3 s_is add i 1 4
word = s_num add i 2
j = add i 3
while lt j get sn 0 bound 9223372036854775807
if s_is j 0
break
end
if s_is j 5
if lt add j 1 get sn 0
id = s_num add j 1
if and ne word 0 ne id 0
k = get mn 0
put mp k word
put ms k get ss i
put mn 0 add k 1
end
end
break
end
j = add j 1
end
end
end
i = add i 1
end
end
fn s_emit p ulong to void
i = ulong 0
while lt i get on 0 bound 9223372036854775807
if eq get ow i p
ret
end
i = add i 1
end
put ow get on 0 p
put on 0 add get on 0 1
i = ulong 0
while ne p 0 bound 9223372036854775807
put ob i uchar and p 255
p = shr p 8
i = add i 1
end
r = write 1 ob 0 i
put ob 0 10
r = write 1 ob 0 1
end
fn s_byte a ulong i ulong to uchar
o = get so a
ret get si add o i
end
fn s_same a ulong b ulong to bool
if ne get sl a get sl b
ret false
end
i = ulong 0
while lt i get sl a bound 9223372036854775807
if ne s_byte a i s_byte b i
ret false
end
i = add i 1
end
ret true
end
fn s_oldhas word ulong to bool
j = ulong 0
while lt j get mn 0 bound 9223372036854775807
if eq get ms j 0
if eq get mp j word
ret true
end
end
j = add j 1
end
ret false
end
fn s_derive to void
s_table
i = ulong 0
while lt i get mn 0 bound 9223372036854775807
if eq get ms i 1
if not s_oldhas get mp i
s_emit get mp i
end
end
i = add i 1
end
end
fn s_uses to int
i = ulong 0
found = false
while lt i get sn 0 bound 9223372036854775807
if eq get ss i 1
j = ulong 0
while lt j get sn 0 bound 9223372036854775807
if eq get ss j 1
break
end
if eq get ss j 0
if s_same i j
s_emit s_tok i
found = true
end
end
j = add j 1
end
end
i = add i 1
end
if found
ret 0
end
ret 1
end
note s_gap: a declaration token separator contains only compiler horizontal blanks, never a newline or parentheses.
fn s_gap a ulong b ulong to bool
p = add get so a get sl a
e = get so b
while lt p e bound 9223372036854775807
c = get si p
if not or or eq c 32 eq c 9 eq c 13
ret false
end
p = add p 1
end
ret true
end
note This is lexical declaration-shape evidence only. Both compiler outcomes still decide acceptance/refusal.
fn s_pool to int
i = ulong 0
while lt add i 3 get sn 0 bound 9223372036854775807
if and eq get ss i 1 eq get sf i 1
if and s_is i 7 s_is add i 3 8
if and and s_gap i add i 1 s_gap add i 1 add i 2 s_gap add i 2 add i 3
ret 0
end
end
end
i = add i 1
end
ret 1
end
fn s_raw at ulong to uchar
ret get si at
end
fn s_rawsame a ulong b ulong n ulong to bool
i = ulong 0
while lt i n bound 9223372036854775807
if ne s_raw add a i s_raw add b i
ret false
end
i = add i 1
end
ret true
end
fn s_mutate n ulong to int
a = ulong 2
while lt a n bound 9223372036854775807
if eq get si a 0
break
end
a = add a 1
end
b = add a 1
while lt b n bound 9223372036854775807
if eq get si b 0
break
end
b = add b 1
end
if ge b n
ret 2
end
k = sub a 2
if eq k 0
ret 2
end
if eq k sub b add a 1
if s_rawsame 2 add a 1 k
ret 2
end
end
hits = ulong 0
where = ulong 0
i = add b 1
while le add i k n bound 9223372036854775807
if s_rawsame 2 i k
hits = add hits 1
where = i
end
i = add i 1
end
if ne hits 1
ret 2
end
r = write 1 si add b 1 sub where add b 1
r = write 1 si add a 1 sub b add a 1
r = write 1 si add where k sub n add where k
ret 0
end
fn main to int
s_init
r = enlarge si 4096
if ne r long 0
ret 2
end
n = ulong 0
while true bound 9223372036854775807
if eq n len si
r = enlarge si mul len si 2
if ne r long 0
ret 2
end
end
k = read 0 si n sub len si n
if lt k long 0
ret 2
end
if eq k long 0
break
end
n = add n ulong k
end
put nb 0 n
if eq get si 0 77
ret s_mutate n
end
note Keep only the actual byte count: the unused tail is not tokenized.
i = ulong 0
while lt i n bound 9223372036854775807
if eq get si i 0
break
end
i = add i 1
end
if eq i n
ret 2
end
note The lexer stops at the actual input length kept separately by a zeroed token bound below.
r = enlarge so n
r = enlarge sl n
r = enlarge ss n
r = enlarge sf n
r = enlarge mp n
r = enlarge ms n
r = enlarge ow n
note s_lex uses len si; trailing allocation zeroes would create no tokens but needlessly scan the tail.
s_lex
if eq get si 0 68
s_derive
ret 0
end
if eq get si 0 85
ret s_uses
end
if eq get si 0 80
ret s_pool
end
ret 2
end

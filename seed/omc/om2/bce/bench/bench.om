om2
note SPDX-License-Identifier: Apache-2.0
note seed/omc/om2/bce/bench/bench.om: wall-time harness for the forbnd benchmark (DRA-189). Handwritten
note seeded Omega, program mode, Linux AArch64.
note Run:   bench N IN A B [ARG ...]
note   N     runs per program, 1..1000; the runs alternate A, B, A, B, ... so drift hits both alike
note   IN    file given to every run as stdin (/dev/null for none); stdout and stderr go to /dev/null
note   A, B  executable paths; both get the same ARGs (execprog: empty environment, no PATH search)
note Each run is timed with monons from just before fork to just after waitpid. Output: one line per run,
note `A k ns` or `B k ns` (k the round), then `BENCH PASS runs=N status=S` when every run ended with the
note wait status S of the first run of A (the same exit code, no signal, not the exec failure codes 126
note and 127; both arms must agree), else
note `BENCH FAIL prog=X round=k status=S` and exit 1. Usage error 2, a file or fork failure 3.
note Then two SUM lines (order statistics of each arm, see summ). Ratios and other arithmetic on these
note numbers are left to the reader (Wolfram).
global pkt uchar 4096
global ab uchar 4096
global ins uchar 4096
global ns ulong 2000
global st uchar 8
global stv ulong 1
global st0 ulong 1
global srt ulong 1000
global ob uchar 65536
global opos ulong 1
text tnull "/dev/null"
text tusage "usage: bench N IN A B [ARG ...]\n"
text tpass "BENCH PASS runs="
text tfail "BENCH FAIL prog="
text tround " round="
text tstat " status="
text tio "BENCH INVALID cannot open stdin file, /dev/null or fork\n"
text tsum "SUM "
text tn " n="
text tmin " min="
text tq1 " q1="
text tmlo " mlo="
text tmhi " mhi="
text tq3 " q3="
text tmax " max="

fn flush to void
n = get opos 0
if gt n 0
k = write 1 ob 0 n
end
put opos 0 0
end

fn ob1 b ulong to void
if ge get opos 0 65536
flush
end
put ob get opos 0 uchar b
put opos 0 add get opos 0 1
end

fn obt t view uchar * to void
for i ulong len t bound 4096
ob1 ulong get t i
end
end

fn obn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
n = add n 1
while gt x 0
put d n uchar add rem x 10 48
x = div x 10
n = add n 1
end
while gt n 0
n = sub n 1
ob1 ulong get d n
end
end

note argn: the decimal value of argument ai, or 0
fn argn ai ulong to ulong
k = argread ai ab 0 4095
if lt k 1
ret 0
end
v = ulong 0
for j ulong ulong k bound 4095
b = ulong get ab j
if or lt b 48 gt b 57
ret 0
end
v = add mul v 10 sub b 48
end
ret v
end

note pkadd: append argument ai as one packed-list record at byte p; the next free byte, or 0 when full
fn pkadd ai ulong p ulong to ulong
k = argread ai ab 0 4095
if lt k 1
ret 0
end
n = ulong k
if gt add add p 2 n 4096
ret 0
end
put pkt p uchar and n 255
put pkt add p 1 uchar shr n 8
for j ulong n bound 4095
put pkt add add p 2 j get ab j
end
ret add add p 2 n
end

note packet: the packed list for program argument pa followed by arguments 5 .. c-1; its byte length or 0
fn packet pa ulong c ulong to ulong
cnt = sub c 4
if gt cnt 64
ret 0
end
put pkt 0 uchar cnt
put pkt 1 0
p = pkadd pa 2
if eq p 0
ret 0
end
for j ulong sub c 5 bound 64
p = pkadd add j 5 p
if eq p 0
ret 0
end
end
ret p
end

note child: stdin from IN (ins, n bytes), stdout and stderr to /dev/null, then the packed list
fn child n ulong m ulong to void
fi = fopen ins 0 n 0 0
if lt fi 0
exit 126
end
fo = fopen tnull 0 len tnull 1 0
if lt fo 0
exit 126
end
r = dupfd int fi 0 0
r = dupfd int fo 1 0
r = dupfd int fo 2 0
r = execprog pkt 0 m
exit 127
end

note runone: one timed run (fork, child, waitpid); its wall ns. stv: the wait status (exit code << 8 |
note signal), or 999 when fork failed
fn runone ni ulong m ulong to ulong
t0 = monons
pid = fork
if lt pid 0
put stv 0 999
ret 0
end
if eq pid 0
child ni m
end
q = waitpid int pid st 0 4 0
t1 = monons
s = ulong get st 0
s = or s shl ulong get st 1 8
put stv 0 s
ret ulong sub t1 t0
end

note summ: order statistics of arm w (0 A, 1 B) over n runs, by insertion sort: `SUM X n=N min=..
note q1=.. mlo=.. mhi=.. q3=.. max=..` with q1 = s[(n-1)/4], mlo = s[(n-1)/2], mhi = s[n/2],
note q3 = s[3(n-1)/4] (0-based, integer division); the median is (mlo + mhi) / 2
fn summ w ulong n ulong to void
for i ulong n bound 1000
x = get ns add mul i 2 w
j = i
go = true
while go
if eq j 0
go = false
else
if gt get srt sub j 1 x
put srt j get srt sub j 1
j = sub j 1
else
go = false
end
end
end
put srt j x
end
obt tsum
ob1 add w 65
obt tn
obn n
obt tmin
obn get srt 0
obt tq1
obn get srt div sub n 1 4
obt tmlo
obn get srt div sub n 1 2
obt tmhi
obn get srt div n 2
obt tq3
obn get srt div mul 3 sub n 1 4
obt tmax
obn get srt sub n 1
ob1 10
end

fn main to int
c = ulong argcnt
if lt c 5
k = write 2 tusage 0 len tusage
ret 2
end
n = argn 1
if or eq n 0 gt n 1000
k = write 2 tusage 0 len tusage
ret 2
end
ni = argread 2 ins 0 4095
if lt ni 1
k = write 2 tusage 0 len tusage
ret 2
end
for r ulong n bound 1000
for w ulong 2
m = packet add w 3 c
if eq m 0
k = write 2 tusage 0 len tusage
ret 2
end
t = runone ulong ni m
if and eq r 0 eq w 0
put st0 0 get stv 0
x = shr get stv 0 8
if or eq x 126 eq x 127
put st0 0 add get stv 0 1
end
end
s = get stv 0
if eq s 999
k = write 2 tio 0 len tio
ret 3
end
if or ne s get st0 0 ne and s 127 0
obt tfail
ob1 add w 65
obt tround
obn r
obt tstat
obn s
ob1 10
flush
ret 1
end
put ns add mul r 2 w t
end
end
for r ulong n bound 1000
for w ulong 2
ob1 add w 65
ob1 32
obn r
ob1 32
obn get ns add mul r 2 w
ob1 10
end
end
obt tpass
obn n
obt tstat
obn get st0 0
ob1 10
summ 0 n
summ 1 n
flush
ret 0
end

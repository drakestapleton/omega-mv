om2
note SPDX-License-Identifier: Apache-2.0
note seed/omc/om2/bce/bcecheck.om: certificate checker for omc rule forbnd (DRA-189). Handwritten seeded
note Omega, program mode, Linux AArch64. It re-derives, from the unit's source text alone, every fact the
note Lean theorem OmegaBce.erase_correct needs for each erased check that omc reports, and cross-checks
note the reports against the run-time trap sites of the same unit compiled without bce.
note
note Run:   bcecheck SRC BCE.ERR BASE.ERR
note   SRC       the unit (any lead line; record lines count from its first line)
note   BCE.ERR   stderr of SRC compiled with the lead line om2 diag bce
note   BASE.ERR  stderr of the same unit compiled with the lead line om2 diag
note Each record `omc-check 1 erased line=N rule=forbnd kind=bounds ctr=C count=K arr=A len=L` is
note admitted only when all of these hold in SRC:
note   1 line N exists and has the words `get A C` or `put A C`
note   2 the nearest enclosing loop line opened by `for C` exists (scanning up, nesting by if / while / for
note     and end, stopping at fn)
note   3 its type word is ulong (or u64)
note   4 its count is the number K (decimal, a top-level const, or `len NAME` of a sized array or text
note     NAME, which omc reads as a number) and the loop is not `unroll`
note   5 no line of its body (down to its matching end) starts with C
note   6 A is a sized view / edit / out parameter of the enclosing fn, a `new` local of that fn above line
note     N, or a top-level global, with declared length L
note   7 1 <= K <= L
note   8 BASE.ERR has exactly as many more omc-site records on line N as there are records for line N
note and the totals agree: sites(BASE) - sites(BCE) = number of records. A record line that is not well
note formed is refused. Other omc-check records (contracts) are ignored.
note Output: one BCECHK line per record (OK, or REFUSE with the failed condition), then
note BCECHK PASS|FAIL records=R refused=X sites_base=S0 sites_bce=S1. Exit 0 PASS, 1 FAIL, 2 usage,
note 3 a file cannot be read (or is 1 MiB or more) or SRC has more than 65535 lines.
note Limits: a source-text check of the rule's premises; it does not read the artifact's machine code.
note
note Packed words (Wolfram FromDigits[Reverse[ToCharacterCode[w]],256]): get 7628135, put 7632240,
note for 7499622, if 26217, while 435610544247, end 6581861, fn 28262, ulong 444234427509, u64 3421813,
note unroll 119212982038133, new 7824750, view 2003134838, edit 1953064037, out 7632239,
note global 119165519096935, const 500152823651, = 61, export 128034844735589, len 7234924,
note text 1954047348, omc-site 7310584038532803951,
note omc-chec 7162245557575183727, erased 110386890240613, line= 263694739820, rule= 263694611826,
note forbnd 110425260846950, kind= 263677962603, bounds 126875187113826, ctr= 1030911075,
note count= 67570278690659, arr= 1030910561, len= 1030645100.
const NO ulong 18446744073709551615
const CAP ulong 1048576
global buf uchar 3145728
global lo ulong 65536
global nln ulong 1
global sz ulong 3
global ab uchar 4096
global rf ulong 5
global ob uchar 65536
global opos ulong 1
text tusage "usage: bcecheck SRC BCE.ERR BASE.ERR\n"
text tread "BCECHK INVALID cannot read input "
text tlines "BCECHK INVALID SRC has more than 65535 lines\n"
text tok "BCECHK OK line="
text tref "BCECHK REFUSE line="
text tmal "BCECHK REFUSE malformed record at BCE.ERR byte "
text tctr " ctr="
text tcnt " count="
text tarr " arr="
text tlen " len="
text twhy " reason="
text tpass "BCECHK PASS records="
text tfail "BCECHK FAIL records="
text trefd " refused="
text tsb " sites_base="
text tsc " sites_bce="
text r1 "no-such-line"
text r2 "no-access"
text r3 "no-enclosing-for"
text r4 "counter-not-ulong"
text r5 "count-or-unroll"
text r6 "counter-written"
text r7 "not-a-sized-array"
text r8 "length-mismatch"
text r9 "count-out-of-range"
text r10 "site-mismatch"

note ======== output ========
fn flush to void
n = get opos 0
if gt n 0
k = write 1 ob 0 n
end
put opos 0 0
end

fn ob1 b ulong to void
if ge get opos 0 65536
flush
end
put ob get opos 0 uchar b
put opos 0 add get opos 0 1
end

fn obt t view uchar * to void
for i ulong len t bound 4096
ob1 ulong get t i
end
end

fn obn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
n = add n 1
while gt x 0
put d n uchar add rem x 10 48
x = div x 10
n = add n 1
end
while gt n 0
n = sub n 1
ob1 ulong get d n
end
end

fn obw w ulong to void
x = w
while ne x 0
ob1 and x 255
x = shr x 8
end
end

note ======== input: three regions of buf, each below CAP bytes ========
note rdf: argument ai (a path) into buf at base; the byte count, or NO
fn rdf ai ulong base ulong to ulong
n = argread ai ab 0 4095
if lt n 1
ret NO
end
fd = fopen ab 0 ulong n 0 0
if lt fd 0
ret NO
end
f = int fd
off = ulong 0
go = true
while go
k = read f buf add base off sub CAP off
if lt k 0
r = fclose f
ret NO
end
if eq k 0
go = false
else
off = add off ulong k
if eq off CAP
r = fclose f
ret NO
end
end
end
r = fclose f
ret off
end

note mklines: line i (1-based) of SRC starts at lo[i-1]; false when there are more than 65535
fn mklines to bool
n = get sz 0
put lo 0 0
c = ulong 1
for p ulong n bound 1048576
if eq get buf p 10
if ge c 65535
ret false
end
put lo c add p 1
c = add c 1
end
end
put nln 0 c
ret true
end

fn lst i ulong to ulong
ret get lo sub i 1
end

fn lend i ulong to ulong
if lt i get nln 0
ret sub get lo i 1
end
ret get sz 0
end

note ======== words: bytes above 32 other than ( and ), as omc's lexer reads them ========
fn isblank b ulong to bool
ret or eq b 32 eq b 9
end

fn skb p ulong e ulong to ulong
q = p
go = true
while go
if ge q e
go = false
else
if isblank ulong get buf q
q = add q 1
else
go = false
end
end
end
ret q
end

fn wend p ulong e ulong to ulong
q = p
go = true
while go
if ge q e
go = false
else
b = ulong get buf q
if or or le b 32 eq b 40 eq b 41
go = false
else
q = add q 1
end
end
end
ret q
end

note pk: the bytes p..q-1 packed little endian; 0 when empty, 1 when longer than 8
fn pk p ulong q ulong to ulong
if eq p q
ret 0
end
if gt sub q p 8
ret 1
end
w = ulong 0
j = ulong 0
while lt add p j q
w = or w shl ulong get buf add p j mul j 8
j = add j 1
end
ret w
end

note dnum: the decimal value of bytes p..q-1 (1..19 digits), else NO
fn dnum p ulong q ulong to ulong
if or eq p q gt sub q p 19
ret NO
end
v = ulong 0
j = p
while lt j q
b = ulong get buf j
if or lt b 48 gt b 57
ret NO
end
v = add mul v 10 sub b 48
j = add j 1
end
ret v
end

note eqb: the n bytes at p (n <= 8) are packed word w
fn eqb p ulong n ulong w ulong to bool
x = w
for j ulong n bound 8
if ne ulong get buf add p j and x 255
ret false
end
x = shr x 8
end
ret true
end

note wat: the start of word k (from 0) in bytes p..e-1, else NO
fn wat p ulong e ulong k ulong to ulong
q = skb p e
n = ulong 0
while lt q e
if eq n k
ret q
end
q = skb wend q e e
n = add n 1
end
ret NO
end

note wk: word k of SRC line i, packed (0 when absent); wn: its number value (decimal or const), else NO
fn wk i ulong k ulong to ulong
e = lend i
p = wat lst i e k
if eq p NO
ret 0
end
ret pk p wend p e
end

fn cval w ulong to ulong
for i ulong get nln 0 bound 65536
if eq wk add i 1 0 500152823651
if eq wk add i 1 1 w
e = lend add i 1
p = wat lst add i 1 e 3
if eq p NO
ret NO
end
ret dnum p wend p e
end
end
end
ret NO
end

fn wn i ulong k ulong to ulong
e = lend i
p = wat lst i e k
if eq p NO
ret NO
end
q = wend p e
v = dnum p q
if ne v NO
ret v
end
ret cval pk p q
end

note ======== the premises, from the source text ========
note isfn: 0 when line i is not a function line, else the word index of its first parameter (2 for
note `fn NAME`, 3 for `export fn NAME`)
fn isfn i ulong to ulong
w = wk i 0
if eq w 28262
ret 2
end
if and eq w 128034844735589 eq wk i 1 28262
ret 3
end
ret 0
end

fn opens w ulong to bool
ret or or eq w 26217 eq w 435610544247 eq w 7499622
end

note hasacc: line n has the words get a c or put a c
fn hasacc n ulong a ulong c ulong to bool
for j ulong 4096
w = wk n j
if eq w 0
ret false
end
if or eq w 7628135 eq w 7632240
if and eq wk n add j 1 a eq wk n add j 2 c
ret true
end
end
end
ret false
end

note encfor: the line of the nearest enclosing loop opened by `for c` around line n, 0 when none
fn encfor n ulong c ulong to ulong
d = ulong 0
i = n
while gt i 1
i = sub i 1
w = wk i 0
if ne isfn i 0
ret 0
end
if eq w 6581861
d = add d 1
else
if opens w
if eq d 0
if and eq w 7499622 eq wk i 1 c
ret i
end
else
d = sub d 1
end
end
end
end
ret 0
end

note bodyw: 0 when the body of the for loop on line f reaches its end and no body line starts with c
fn bodyw f ulong c ulong to ulong
d = ulong 1
i = f
while lt i get nln 0
i = add i 1
w = wk i 0
if or eq w c ne isfn i 0
ret 1
end
if opens w
d = add d 1
end
if eq w 6581861
d = sub d 1
if eq d 0
ret 0
end
end
end
ret 1
end

fn encfn n ulong to ulong
i = n
while gt i 0
if ne isfn i 0
ret i
end
i = sub i 1
end
ret 0
end

note pfnlen: the length of sized array parameter a on fn line f; NO when not a sized view / edit / out
note array parameter; 0 when a is not a parameter
fn pfnlen f ulong a ulong to ulong
b = isfn f
for j ulong 64
w = wk f add j b
if eq w 0
ret 0
end
if eq w a
v = wk f add add j b 1
if or or eq v 2003134838 eq v 1953064037 eq v 7632239
ret wn f add add j b 3
end
ret NO
end
end
ret 0
end

note alen: the declared length of a as seen from line n (parameter, local new, global), else NO
fn alen n ulong a ulong to ulong
f = encfn n
if eq f 0
ret NO
end
v = pfnlen f a
if ne v 0
ret v
end
i = add f 1
while lt i n
if eq wk i 0 a
if eq wk i 1 7824750
ret wn i 3
end
if and eq wk i 1 61 eq wk i 2 7824750
ret wn i 4
end
end
i = add i 1
end
for j ulong get nln 0 bound 65536
if and eq wk add j 1 0 119165519096935 eq wk add j 1 1 a
ret wn add j 1 3
end
end
ret NO
end

note txtlen: the byte length of top-level `text w "..."` (an escape is one byte), else NO
fn txtlen w ulong to ulong
for j ulong get nln 0 bound 65536
i = add j 1
if and eq wk i 0 1954047348 eq wk i 1 w
e = lend i
p = wat lst i e 2
if eq p NO
ret NO
end
if ne get buf p 34
ret NO
end
n = ulong 0
q = add p 1
while lt q e
b = get buf q
if eq b 34
ret n
end
if eq b 92
q = add q 1
end
n = add n 1
q = add q 1
end
ret NO
end
end
ret NO
end

note cntv: the count of the for loop on line f: word 3 a number or a const, or `len NAME` (omc reads
note the length of a sized array or text as a number): the declared length of NAME; else NO
fn cntv f ulong to ulong
if eq wk f 3 7234924
a = wk f 4
v = alen f a
if ne v NO
ret v
end
ret txtlen a
end
ret wn f 3
end

note chkrec: 0 when the record (line n, counter c, count k, array a, length l) is admitted, else the
note failed condition 1..9
fn chkrec n ulong c ulong k ulong a ulong l ulong to ulong
if or eq n 0 gt n get nln 0
ret 1
end
if not hasacc n a c
ret 2
end
f = encfor n c
if eq f 0
ret 3
end
t = wk f 2
if and ne t 444234427509 ne t 3421813
ret 4
end
if ne cntv f k
ret 5
end
if or eq wk f 4 119212982038133 eq wk f 5 119212982038133
ret 5
end
if ne bodyw f c 0
ret 6
end
d = alen n a
if eq d NO
ret 7
end
if ne d l
ret 8
end
if or eq k 0 gt k l
ret 9
end
ret 0
end

note ======== records ========
fn eol p ulong e ulong to ulong
q = p
while lt q e
if eq get buf q 10
ret q
end
q = add q 1
end
ret e
end

note keyv: word k of p..e-1 starts with the key (kl bytes, packed kw); the offset after the key, else NO
fn keyv p ulong e ulong k ulong kw ulong kl ulong to ulong
s = wat p e k
if eq s NO
ret NO
end
if gt add s kl wend s e
ret NO
end
if not eqb s kl kw
ret NO
end
ret add s kl
end

note prec: the record line p..e-1 into rf (N, C, K, A, L): 0 a forbnd erasure record, 1 another line
note (ignored), 2 a forbnd record that is not well formed
fn prec p ulong e ulong to ulong
s = wat p e 0
if eq s NO
ret 1
end
if or ne sub wend s e s 9 not eqb s 8 7162245557575183727
ret 1
end
if ne get buf add s 8 107
ret 1
end
s = wat p e 4
if eq s NO
ret 1
end
if or ne sub wend s e s 11 not eqb s 5 263694611826
ret 1
end
if not eqb add s 5 6 110425260846950
ret 1
end
k = prec2 p e
ret k
end

fn prec2 p ulong e ulong to ulong
s = wat p e 1
if ne pk s wend s e 49
ret 2
end
s = wat p e 2
if ne pk s wend s e 110386890240613
ret 2
end
v = keyv p e 3 263694739820 5
if eq v NO
ret 2
end
put rf 0 dnum v wend v e
s = wat p e 5
if or ne sub wend s e s 11 not eqb s 5 263677962603
ret 2
end
if not eqb add s 5 6 126875187113826
ret 2
end
v = keyv p e 6 1030911075 4
if eq v NO
ret 2
end
put rf 1 pk v wend v e
v = keyv p e 7 67570278690659 6
if eq v NO
ret 2
end
put rf 2 dnum v wend v e
v = keyv p e 8 1030910561 4
if eq v NO
ret 2
end
put rf 3 pk v wend v e
v = keyv p e 9 1030645100 4
if eq v NO
ret 2
end
put rf 4 dnum v wend v e
if ne wat p e 10 NO
ret 2
end
if eq get rf 0 NO
ret 2
end
if eq get rf 2 NO
ret 2
end
if eq get rf 4 NO
ret 2
end
if lt get rf 1 2
ret 2
end
if lt get rf 3 2
ret 2
end
ret 0
end

note sites: omc-site records in region b (n bytes) on line ln (every line when ln is NO)
fn sites b ulong n ulong ln ulong to ulong
c = ulong 0
p = b
e = add b n
while lt p e
q = eol p e
s = wat p q 0
if ne s NO
if and eq sub wend s q s 8 eqb s 8 7310584038532803951
if eq ln NO
c = add c 1
else
v = keyv p q 2 263694739820 5
if ne v NO
if eq dnum v wend v q ln
c = add c 1
end
end
end
end
end
p = add q 1
end
ret c
end

note nrec: forbnd records in BCE.ERR on line ln (every line when ln is NO)
fn nrec ln ulong to ulong
c = ulong 0
p = CAP
e = add CAP get sz 1
while lt p e
q = eol p e
if eq prec p q 0
if or eq ln NO eq get rf 0 ln
c = add c 1
end
end
p = add q 1
end
ret c
end

fn why r ulong to void
if eq r 1
obt r1
end
if eq r 2
obt r2
end
if eq r 3
obt r3
end
if eq r 4
obt r4
end
if eq r 5
obt r5
end
if eq r 6
obt r6
end
if eq r 7
obt r7
end
if eq r 8
obt r8
end
if eq r 9
obt r9
end
if eq r 10
obt r10
end
end

note report: one BCECHK line for the record in rf with result r (0 OK)
fn report r ulong to void
if eq r 0
obt tok
else
obt tref
end
obn get rf 0
obt tctr
obw get rf 1
obt tcnt
obn get rf 2
obt tarr
obw get rf 3
obt tlen
obn get rf 4
if ne r 0
obt twhy
why r
end
ob1 10
end

note one: check the record line p..q-1; 0 admitted or not a record, 1 refused
fn one p ulong q ulong to ulong
k = prec p q
if eq k 1
ret 0
end
if eq k 2
obt tmal
obn sub p CAP
ob1 10
ret 1
end
r = chkrec get rf 0 get rf 1 get rf 2 get rf 3 get rf 4
if eq r 0
n = get rf 0
sb = sites mul CAP 2 get sz 2 n
sc = sites CAP get sz 1 n
if or lt sb sc ne sub sb sc nrec n
r = ulong 10
end
k = prec p q
end
report r
if eq r 0
ret 0
end
ret 1
end

fn main to int
if ne argcnt 4
k = write 2 tusage 0 len tusage
ret 2
end
for i ulong 3
v = rdf add i 1 mul CAP i
if eq v NO
obt tread
obn add i 1
ob1 10
flush
ret 3
end
put sz i v
end
if not mklines
obt tlines
flush
ret 3
end
bad = ulong 0
p = CAP
e = add CAP get sz 1
while lt p e
q = eol p e
bad = add bad one p q
p = add q 1
end
r = nrec NO
s0 = sites mul CAP 2 get sz 2 NO
s1 = sites CAP get sz 1 NO
ok = true
if or ne bad 0 lt s0 s1
ok = false
else
if ne sub s0 s1 r
ok = false
end
end
if ok
obt tpass
else
obt tfail
end
obn r
obt trefd
obn bad
obt tsb
obn s0
obt tsc
obn s1
ob1 10
flush
if ok
ret 0
end
ret 1
end

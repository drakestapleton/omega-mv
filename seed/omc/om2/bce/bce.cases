# seed/omc/om2/bce/bce.cases: standing gate for the opt-in for-counter bounds-check erasure (rule forbnd,
# DRA-189): `om2 bce` / `om2 diag bce` erase the CMP / B.HS trap 3 of an index that is exactly the register
# of a ulong for counter with a number count K <= the sized array's length, when no body line writes the
# counter. Every fixture body is compiled after a lead line (lead-*.om), so one body serves both leads.
# Run from the repository root by seed/qualification/om2/gate.om. Expected:
# OM2GATE PASS cases=59 pass=59 fail=0 invalid=0 not_run=0
#
# Semantics: each fixture runs to the same exit under om2 and om2 bce (Wolfram-checked values in the
# fixture notes); the trap fixtures still trap 3 (exit 103) under om2 bce.
bce-sum-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
om2-sum-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/sum.om - - - 24
bce-shapes-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/shapes.om - - - 131
om2-shapes-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/shapes.om - - - 131
bce-diag-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/diag.om - - - 40
om2-diag-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/diag.om - - - 40
bce-kept-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/kept.om - - - 33
om2-kept-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/kept.om - - - 33
# violated assumptions: K > len, a written counter (three spellings / positions), an index that is not
# the counter register. The check is kept, so the out-of-bounds pass still traps 3.
bce-kgt-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/kgt.om - - - 103
om2-kgt-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/kgt.om - - - 103
bce-written-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/written.om - - - 103
om2-written-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/written.om - - - 103
bce-written-eq-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/written-eq.om - - - 103
bce-written-nested-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/written-nested.om - - - 103
om2-written-nested-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/written-nested.om - - - 103
bce-idx-run run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/idx.om - - - 103
om2-idx-run run seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/idx.om - - - 103
# Fallback: nothing erasable (unsized view, text, uint counter, value count, while, K 0, unroll), or a
# target without the rule (x86linux): om2 bce compiles to the same bytes as om2.
bce-kept-same same seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/kept.om seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/kept.om
bce-x86-same same seed/omc/om2/bce/target-x86.om+seed/omc/om2/bce/lead-om2.om+seed/omc/om2/bce/sum.om seed/omc/om2/bce/target-x86.om+seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om
# Without bce in the lead line the erasure is off: om2 diag reports every site, as before.
om2-diag-sites emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/diag.om any file:seed/omc/om2/bce/cert/diag-om2.err 0
# Certificates (om2 diag bce): exactly the erased site's omc-site record is replaced by its omc-check
# record (ctr, count, arr, len), in emission order.
bce-diag-records emit seed/omc/om2/bce/lead-diagbce.om+seed/omc/om2/bce/diag.om any file:seed/omc/om2/bce/cert/diag-bce.err 0
bce-sum-records emit seed/omc/om2/bce/lead-diagbce.om+seed/omc/om2/bce/sum.om any file:seed/omc/om2/bce/cert/sum-bce.err 0
# om2 diag bce emits the same artifact as om2 bce (records go to stderr only); exact bytes pinned.
bce-sum-diag-same same seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om seed/omc/om2/bce/lead-diagbce.om+seed/omc/om2/bce/sum.om
bce-sum-bytes emit seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om sha:3614ca942975dba027766f7ada0a2ebee4f976d30815031c5165b5d1f278e41c - 0
bce-shapes-bytes emit seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/shapes.om sha:0632be3dd4be61f5676aaa1d1e9d10f4ed07ff188b5799c5a20d8ebea2bebe38 - 0
# A lead line with another word after om2 (`om2 bcex`) is not a lead line: the unit stays OM-1, where
# om2 is an unknown first word (error 16 on line 1).
bce-lead-typo refuse seed/omc/om2/bce/lead-typo.om+seed/omc/om2/bce/sum.om 16
# Certificate fixtures: cert/N.src is lead-diagbce.om + N.om; the stored record files are exactly what
# the compiler under test writes (om2 diag bce: N-bce.err; om2 diag: N-om2.err).
cert-sum-bce emit seed/omc/om2/bce/cert/sum.src any file:seed/omc/om2/bce/cert/sum-bce.err 0
cert-sum-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/sum.om any file:seed/omc/om2/bce/cert/sum-om2.err 0
cert-written-bce emit seed/omc/om2/bce/cert/written.src any file:seed/omc/om2/bce/cert/written-bce.err 0
cert-written-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/written.om any file:seed/omc/om2/bce/cert/written-om2.err 0
cert-kgt-bce emit seed/omc/om2/bce/cert/kgt.src any file:seed/omc/om2/bce/cert/kgt-bce.err 0
cert-kgt-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/kgt.om any file:seed/omc/om2/bce/cert/kgt-om2.err 0
cert-idx-bce emit seed/omc/om2/bce/cert/idx.src any file:seed/omc/om2/bce/cert/idx-bce.err 0
cert-idx-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/idx.om any file:seed/omc/om2/bce/cert/idx-om2.err 0
cert-kept-bce emit seed/omc/om2/bce/cert/kept.src any file:seed/omc/om2/bce/cert/kept-bce.err 0
cert-kept-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/kept.om any file:seed/omc/om2/bce/cert/kept-om2.err 0
cert-diag-bce emit seed/omc/om2/bce/cert/diag.src any file:seed/omc/om2/bce/cert/diag-bce.err 0
cert-diag-om2 emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/diag.om any file:seed/omc/om2/bce/cert/diag-om2.err 0
# The certificate checker (bcecheck.om, built by the compiler under test) admits every real record set
# (chk-ok-*) and refuses every forged one (chk-f-*): a wrong count, length or line, a dropped or
# truncated record, a written counter, K > len, a non-counter index, an unsized view, a text, a uint
# counter, a value count, K 0, an unrolled loop, and records checked against the bce sites themselves.
chk-ok-sum run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-sum.out - 0 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/sum-bce.err seed/omc/om2/bce/cert/sum-om2.err
chk-ok-written run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-written.out - 0 seed/omc/om2/bce/cert/written.src seed/omc/om2/bce/cert/written-bce.err seed/omc/om2/bce/cert/written-om2.err
chk-ok-kgt run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-kgt.out - 0 seed/omc/om2/bce/cert/kgt.src seed/omc/om2/bce/cert/kgt-bce.err seed/omc/om2/bce/cert/kgt-om2.err
chk-ok-idx run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-idx.out - 0 seed/omc/om2/bce/cert/idx.src seed/omc/om2/bce/cert/idx-bce.err seed/omc/om2/bce/cert/idx-om2.err
chk-ok-kept run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-kept.out - 0 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/kept-bce.err seed/omc/om2/bce/cert/kept-om2.err
chk-ok-diag run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-diag.out - 0 seed/omc/om2/bce/cert/diag.src seed/omc/om2/bce/cert/diag-bce.err seed/omc/om2/bce/cert/diag-om2.err
chk-f-count run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-count.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-count.err seed/omc/om2/bce/cert/sum-om2.err
chk-f-len run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-len.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-len.err seed/omc/om2/bce/cert/sum-om2.err
chk-f-line run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-line.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-line.err seed/omc/om2/bce/cert/sum-om2.err
chk-f-drop run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-drop.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-drop.err seed/omc/om2/bce/cert/sum-om2.err
chk-f-trunc run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-trunc.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-trunc.err seed/omc/om2/bce/cert/sum-om2.err
chk-f-written run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-written.out - 1 seed/omc/om2/bce/cert/written.src seed/omc/om2/bce/cert/f-written.err seed/omc/om2/bce/cert/written-om2.err
chk-f-kgt run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-kgt.out - 1 seed/omc/om2/bce/cert/kgt.src seed/omc/om2/bce/cert/f-kgt.err seed/omc/om2/bce/cert/kgt-om2.err
chk-f-idx run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-idx.out - 1 seed/omc/om2/bce/cert/idx.src seed/omc/om2/bce/cert/f-idx.err seed/omc/om2/bce/cert/idx-om2.err
chk-f-unsized run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-unsized.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-unsized.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-text run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-text.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-text.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-uint run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-uint.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-uint.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-value run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-value.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-value.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-zero run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-zero.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-zero.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-unroll run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-unroll.out - 1 seed/omc/om2/bce/cert/kept.src seed/omc/om2/bce/cert/f-unroll.err seed/omc/om2/bce/cert/kept-om2.err
chk-f-nobase run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-nobase.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/sum-bce.err seed/omc/om2/bce/cert/sum-bce.err

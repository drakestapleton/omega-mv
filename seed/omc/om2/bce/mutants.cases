# SPDX-License-Identifier: Apache-2.0
# seed/omc/om2/bce/mutants.cases: each omc.om mutant of the forbnd erasure must be detected (its case
# FAIL); the ctl- case shows the mutant compiler still builds and runs the sum fixture as the unmutated
# one does. Expected: OM2GATE FAIL cases=18 pass=9 fail=9 invalid=0 not_run=0 (6 omc.om mutants and 3
# bcecheck.om mutants, below).
#   klen   drops the K <= len test             -> kgt reads b[0] and exits 168, not 103
#   scan   ignores the body scan for writes     -> written reads b[1] and exits 104, not 103
#   reg    erases any register index in a loop  -> idx reads b[0] and exits 168, not 103
#   depth  does not count a nested if           -> written-nested exits 104, not 103
#   rec    records len as the count             -> the om2 diag bce records differ
#   lead   bce_q ignores the bce lead word      -> om2 diag loses the erased site record
deadline 60
subst seed/omc/om2/bce/mutants/klen.from seed/omc/om2/bce/mutants/klen.to
cc seed/omc/omc.om
ctl-bce-klen run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-klen run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/kgt.om - - - 103
cc pinned
subst seed/omc/om2/bce/mutants/scan.from seed/omc/om2/bce/mutants/scan.to
cc seed/omc/omc.om
ctl-bce-scan run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-scan run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/written.om - - - 103
cc pinned
subst seed/omc/om2/bce/mutants/reg.from seed/omc/om2/bce/mutants/reg.to
cc seed/omc/omc.om
ctl-bce-reg run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-reg run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/idx.om - - - 103
cc pinned
subst seed/omc/om2/bce/mutants/depth.from seed/omc/om2/bce/mutants/depth.to
cc seed/omc/omc.om
ctl-bce-depth run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-depth run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/written-nested.om - - - 103
cc pinned
subst seed/omc/om2/bce/mutants/rec.from seed/omc/om2/bce/mutants/rec.to
cc seed/omc/omc.om
ctl-bce-rec run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-rec emit seed/omc/om2/bce/lead-diagbce.om+seed/omc/om2/bce/diag.om any file:seed/omc/om2/bce/cert/diag-bce.err 0
cc pinned
subst seed/omc/om2/bce/mutants/lead.from seed/omc/om2/bce/mutants/lead.to
cc seed/omc/omc.om
ctl-bce-lead run seed/omc/om2/bce/lead-bce.om+seed/omc/om2/bce/sum.om - - - 24
bce-lead emit seed/omc/om2/bce/lead-diag.om+seed/omc/om2/bce/diag.om any file:seed/omc/om2/bce/cert/diag-om2.err 0
cc pinned
# Certificate-checker mutants (bcecheck.om): each must admit a forged certificate (its case FAIL); the
# ctl- case runs the same mutant on the real sum records, which it still admits.
#   ck-body   no body scan for counter writes  -> admits f-written
#   ck-len    no declared-length comparison    -> admits f-len
#   ck-sites  no site-total cross-check        -> admits f-drop
subst seed/omc/om2/bce/mutants/ck-body.from seed/omc/om2/bce/mutants/ck-body.to
ctl-ck-body run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-written.out - 0 seed/omc/om2/bce/cert/written.src seed/omc/om2/bce/cert/written-bce.err seed/omc/om2/bce/cert/written-om2.err
subst seed/omc/om2/bce/mutants/ck-body.from seed/omc/om2/bce/mutants/ck-body.to
ck-body run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-written.out - 1 seed/omc/om2/bce/cert/written.src seed/omc/om2/bce/cert/f-written.err seed/omc/om2/bce/cert/written-om2.err
subst seed/omc/om2/bce/mutants/ck-len.from seed/omc/om2/bce/mutants/ck-len.to
ctl-ck-len run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-sum.out - 0 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/sum-bce.err seed/omc/om2/bce/cert/sum-om2.err
subst seed/omc/om2/bce/mutants/ck-len.from seed/omc/om2/bce/mutants/ck-len.to
ck-len run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-len.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-len.err seed/omc/om2/bce/cert/sum-om2.err
subst seed/omc/om2/bce/mutants/ck-sites.from seed/omc/om2/bce/mutants/ck-sites.to
ctl-ck-sites run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/ok-sum.out - 0 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/sum-bce.err seed/omc/om2/bce/cert/sum-om2.err
subst seed/omc/om2/bce/mutants/ck-sites.from seed/omc/om2/bce/mutants/ck-sites.to
ck-sites run seed/omc/om2/bce/bcecheck.om - file:seed/omc/om2/bce/cert/f-drop.out - 1 seed/omc/om2/bce/cert/sum.src seed/omc/om2/bce/cert/f-drop.err seed/omc/om2/bce/cert/sum-om2.err

fn s_eof to void
if eq get chkmode 0 2
emit_query
end
if ne get curret 0 0
note d2site 323|s_eof: missing end; condition if ne get curret 0 0
put d2site 0 323
fail 15
end
if eq get nf 0 0
note d2site 324|s_eof: syntax: unknown or misplaced word; condition if eq get nf 0 0
put d2site 0 324
fail 16
end

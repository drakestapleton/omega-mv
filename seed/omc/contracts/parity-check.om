note
note Pure seeded OM-2 contract parity harness for seed/omc/contracts/parity.om.
note Replaces the retired C runner.c parity step in seed/host/check.sh after
note commit bb7f2dd68 removed src/compiler/.
note
note Composed after seed/omc/contracts/parity.om (stripping its leading om2 line):
note forks a child per input from parity.inputs (-1, 0, 1, 9, 10, 11, 20) and
note verifies exact return values (0, 1, 9, 10) and contract traps (9 -> exit 109,
note 10 -> exit 110).

global g_wstat uchar 16

fn run_one x int to int
  pid = fork
  if lt pid 0
    ret neg int 1
  end
  if eq pid 0
    v = check x
    exit v
  end
  r = waitpid int pid g_wstat 0 4 0
  if lt r 0
    ret neg int 1
  end
  lo = ulong get g_wstat 0
  hi = ulong get g_wstat 1
  if ne and lo 127 0
    ret neg int 2
  end
  ret int hi
end

fn main to int
  if ne run_one neg int 1 109
    ret 1
  end
  if ne run_one 0 0
    ret 2
  end
  if ne run_one 1 1
    ret 3
  end
  if ne run_one 9 9
    ret 4
  end
  if ne run_one 10 10
    ret 5
  end
  if ne run_one 11 110
    ret 6
  end
  if ne run_one 20 110
    ret 7
  end
  ret 0
end

note Native diagnostic v2 + canonical program-identity & effect receipts. SHA core below is generated from seed/trace/sha256.om.
global d2mode ulong 1
global d2site ulong 1
global d2size ulong 1
global d2full ulong 1
global d2done ulong 1
global d2hash uchar 32
global rcmode ulong 1
global rc_sz ulong 1
global rc_cnt ulong 1
global rc_cat ulong 1
global rc_ccnt ulong 1
global rc_w ulong 4
global rc_tmp uchar 32
global rc_body uchar 32
global rc_sig uchar 32
global rc_con uchar 32
global rc_pid uchar 32
global rc_out uchar 32
global rc_rid uchar 32
text d2flag "OMC_DIAGNOSTICS=2"
text rcflag "OMC_RECEIPT=1"
text rcdom_p "omega.program.v2"
text rcdom_c "omega.contract.v1"
text rcdom_r "omega.effect.receipt.v1"
text rct_hdr "omc-receipt 1 program_id="
text rct_bid " body_id="
text rct_sid " sig_id="
text rct_cid " contract_id="
text rct_ish " input_sha256="
text rct_ib " input_bytes="
text rct_osh " output_sha256="
text rct_ob " output_bytes="
text rct_cs " compiler_source_sha256="
text rct_om2 " om2="
text rct_obj " obj="
text rct_ir " ir="
text rct_tgt " target="
text rct_efa " efa="
text rct_eff " effects="
text rct_es " effect_sites="
text rct_ew " effect_words="
text rct_rid " receipt_id="

fn d2env to void
n = envcnt
i = ulong 0
while lt i ulong n
k = envread i a_eb 0 131072
if eq k long len d2flag
ok = true
for j ulong len d2flag
if ne get a_eb j get d2flag j
ok = false
end
end
if ok
put d2mode 0 1
end
end
if eq k long len rcflag
ok = true
for j ulong len rcflag
if ne get a_eb j get rcflag j
ok = false
end
end
if ok
put rcmode 0 1
end
end
i = add i 1
end
if or ne get d2mode 0 0 ne get rcmode 0 0
ds_hinit
end
end

note Hash bytes as read, before a memory refusal or formatter can change the input arena.
fn d2feed n ulong to void
for i ulong n
j = rem get d2size 0 64
put ds_blk j get a_wb i
put d2size 0 add get d2size 0 1
if eq j 63
ds_compress
end
end
end

fn d2finish to void
if ne get d2done 0 0
ret
end
j = rem get d2size 0 64
put ds_blk j 128
j = add j 1
while lt j 64
put ds_blk j 0
j = add j 1
end
if ge rem get d2size 0 64 56
ds_compress
for i ulong 64
put ds_blk i 0
end
end
bits = mul get d2size 0 8
for i ulong 8
put ds_blk add 56 i uchar and shr bits mul sub 7 i 8 255
end
ds_compress
for i ulong 32
v = get ds_h div i 4
shift = mul sub 3 rem i 4 8
put d2hash i uchar and shr v shift 255
end
put d2done 0 1
end

fn d2record code ulong to void
d2finish
put mc 0 0
mputw 7449351137626647919 8
mputw 4424052638528582176 8
mputn code
mputw 19207804370383648 7
mputn get d2site 0
mputw 67505853393952 6
mputn add get line 0 get lbase 0
mputw 263812244256 5
mputn dcol get tka 0
mputw 67544290456352 6
mputn add get tka 0 get sbase 0
mputb 45
mputn add get tkb 0 get sbase 0
mputw 7088512386250729760 8
mputw 263929033849 5
mputn get d2size 0
mputw 7160569980288657696 8
mputw 4424070187921206639 8
mputn get d2full 0
mputw 8313491484895504672 8
mputw 67303030022504 6
for i ulong 32
mputh ulong get d2hash i
end
mputw 7308332226908742432 8
mputw 7305808869231648626 8
mputw 4410771375554851679 8
for i ulong len d2pin
mputb get d2pin i
end
mputw 262839037728 5
mputn get om2 0
mputw 67505686015264 6
mputn get chkmode 0
mputw 1030908192 4
mputn get irmode 0
mputw 4428275828587066400 8
mputn get xtarget 0
mputw 7237123381843029792 8
mputw 15717 2
mputn get om2m 0
mputb 10
w = write 2 msg 0 get mc 0
end

fn d2mean code ulong to void
i = ulong 0
while lt i len d2means
id = ulong 0
more = true
while and more lt i len d2means
c = get d2means i
i = add i 1
if eq c 124
more = false
else
id = add mul id 10 sub ulong c 48
end
end
more = true
while and more lt i len d2means
c = get d2means i
i = add i 1
if eq c 10
more = false
else
if eq id code
mputb c
end
end
end
if eq id code
ret
end
end
end

fn d2reason to void
i = ulong 0
while lt i len d2sites
id = ulong 0
more = true
while and more lt i len d2sites
c = get d2sites i
i = add i 1
if eq c 124
more = false
else
id = add mul id 10 sub ulong c 48
end
end
more = true
while and more lt i len d2sites
c = get d2sites i
i = add i 1
if eq c 10
more = false
else
if eq id get d2site 0
mputb c
end
end
end
if eq id get d2site 0
ret
end
end
end

fn eff_cat1 c ulong to ulong
if or eq c 53 eq c 54
ret 1
end
if or eq c 108 eq c 128
ret 1
end
if or eq c 161 eq c 162
ret 1
end
if eq c 221
ret 1
end
if or and ge c 100 le c 103 and ge c 110 le c 113
ret 2
end
if or eq c 117 and ge c 125 le c 126
ret 2
end
if or and ge c 132 le c 133 and ge c 138 le c 144
ret 2
end
if or and ge c 149 le c 151 eq c 153
ret 2
end
if or and ge c 155 le c 157 or eq c 164 eq c 197
ret 2
end
ret 0
end

fn eff_cat2 c ulong to ulong
if or eq c 82 eq c 107
ret 4
end
if or eq c 116 eq c 124
ret 4
end
if or eq c 127 eq c 129
ret 4
end
if or eq c 154 and ge c 158 le c 160
ret 4
end
if or eq c 163 eq c 198
ret 4
end
if or eq c 233 eq c 235
ret 4
end
if or and ge c 104 le c 106 and ge c 114 le c 115
ret 8
end
if or and ge c 118 le c 119 eq c 123
ret 8
end
if or eq c 131 eq c 134
ret 8
end
if or eq c 165 eq c 220
ret 8
end
if or eq c 222 eq c 224
ret 8
end
ret 0
end

fn eff_cat3 c ulong to ulong
if or eq c 109 eq c 120
ret 16
end
if or eq c 130 eq c 135
ret 16
end
if or and ge c 166 le c 177 and ge c 228 le c 232
ret 32
end
if and ge c 241 le c 243
ret 32
end
if eq c 244
ret 64
end
if or eq c 178 ge c 251
ret 128
end
if or and ge c 121 le c 122 and ge c 136 le c 137
ret 256
end
if and ge c 145 le c 148
ret 256
end
if or eq c 199 eq c 200
ret 512
end
if and ge c 236 le c 240
ret 512
end
ret 0
end

fn eff_rec c ulong to void
put rc_cnt 0 add get rc_cnt 0 1
if lt c 256
wi = shr c 6
wb = shl ulong 1 and c 63
put rc_w wi or get rc_w wi wb
end
cat = or or eff_cat1 c eff_cat2 c eff_cat3 c
put rc_cat 0 or get rc_cat 0 cat
end

fn rc_sha_init to void
ds_hinit
put rc_sz 0 0
end

fn rc_sha_b b uchar to void
j = rem get rc_sz 0 64
put ds_blk j b
put rc_sz 0 add get rc_sz 0 1
if eq j 63
ds_compress
end
end

fn rc_sha_u64 v ulong to void
for i ulong 8
rc_sha_b uchar and shr v mul sub 7 i 8 255
end
end

fn rc_sha_fin to void
sz = get rc_sz 0
j = rem sz 64
put ds_blk j 128
j = add j 1
while lt j 64
put ds_blk j 0
j = add j 1
end
if ge rem sz 64 56
ds_compress
for i ulong 64
put ds_blk i 0
end
end
bits = mul sz 8
for i ulong 8
put ds_blk add 56 i uchar and shr bits mul sub 7 i 8 255
end
ds_compress
for i ulong 32
v = get ds_h div i 4
shift = mul sub 3 rem i 4 8
put rc_tmp i uchar and shr v shift 255
end
end

fn rc_body_str p ulong e ulong to ulong
rc_sha_b 34
q = add p 1
sgo = true
while and sgo lt q e
sb = a_ib q
rc_sha_b sb
q = add q 1
if eq sb 92
if lt q e
rc_sha_b a_ib q
q = add q 1
end
else
if or eq sb 34 eq sb 10
sgo = false
end
end
end
ret q
end

fn rc_body_tok p ulong e ulong to ulong
q = p
tgo = true
while and tgo lt q e
tb = a_ib q
st = ulong 0
if le ulong tb 32
st = 1
end
if or eq ulong tb 40 eq ulong tb 41
st = 1
end
if eq ulong tb 34
st = 1
end
if ne st 0
tgo = false
else
rc_sha_b tb
q = add q 1
end
end
ret q
end

fn rc_body_hash to void
rc_sha_init
e = get inlen 0
p = ulong 0
ht = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = a_ib p
if or or eq b 32 eq b 9 eq b 13
p = add p 1
else
if eq b 10
if ne ht 0
rc_sha_b 10
ht = ulong 0
end
p = add p 1
else
if and eq ht 0 ne isnote p 0
p = skipln p
else
if ne ht 0
rc_sha_b 32
end
if eq b 34
p = rc_body_str p e
else
if or eq b 40 eq b 41
rc_sha_b b
p = add p 1
else
p = rc_body_tok p e
end
end
ht = ulong 1
end
end
end
end
m = add m 1
end
end
if ne ht 0
rc_sha_b 10
end
rc_sha_fin
for i ulong 32
put rc_body i get rc_tmp i
end
end

fn rc_sig_hash to void
rc_sha_init
nfv = get nf 0
rc_sha_u64 nfv
f = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge f nfv
go = false
else
rc_sha_b a_gu 32 f
rc_sha_b a_gu 23 f
np = ulong a_gu 24 f
rc_sha_b uchar np
j = ulong 0
while lt j np
px = add mul f 6 j
rc_sha_b a_gu 35 px
rc_sha_b a_gu 37 px
rc_sha_u64 a_g 36 px
j = add j 1
end
f = add f 1
end
m = add m 1
end
end
rc_sha_fin
for i ulong 32
put rc_sig i get rc_tmp i
end
end

fn rc_con_hash to void
if and eq get rc_ccnt 0 0 eq get crel 0 0
for i ulong 32
put rc_con i 0
end
ret
end
rc_sha_init
for i ulong len rcdom_c
rc_sha_b get rcdom_c i
end
rc_sha_b 0
rc_sha_u64 get crel 0
rc_sha_u64 get rc_ccnt 0
rc_sha_fin
for i ulong 32
put rc_con i get rc_tmp i
end
end

fn rc_pid_hash to void
rc_sha_init
for i ulong len rcdom_p
rc_sha_b get rcdom_p i
end
rc_sha_b 0
for i ulong 32
rc_sha_b get rc_body i
end
for i ulong 32
rc_sha_b get rc_sig i
end
for i ulong 32
rc_sha_b get rc_con i
end
rc_sha_fin
for i ulong 32
put rc_pid i get rc_tmp i
end
end

fn rc_out_hash st ulong to void
rc_sha_init
i = st
e = get oc 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i e
go = false
else
rc_sha_b a_ob i
i = add i 1
end
m = add m 1
end
end
rc_sha_fin
for j ulong 32
put rc_out j get rc_tmp j
end
end

fn rc_putw64 v ulong to void
for i ulong 8
mputh and shr v mul sub 7 i 8 255
end
end

fn rc_emit st ulong to void
if eq get rcmode 0 0
ret
end
d2finish
rc_body_hash
rc_sig_hash
rc_con_hash
rc_pid_hash
rc_out_hash st
put mc 0 0
for i ulong len rct_hdr
mputb get rct_hdr i
end
for i ulong 32
mputh ulong get rc_pid i
end
for i ulong len rct_bid
mputb get rct_bid i
end
for i ulong 32
mputh ulong get rc_body i
end
for i ulong len rct_sid
mputb get rct_sid i
end
for i ulong 32
mputh ulong get rc_sig i
end
for i ulong len rct_cid
mputb get rct_cid i
end
for i ulong 32
mputh ulong get rc_con i
end
for i ulong len rct_ish
mputb get rct_ish i
end
for i ulong 32
mputh ulong get d2hash i
end
for i ulong len rct_ib
mputb get rct_ib i
end
mputn get d2size 0
for i ulong len rct_osh
mputb get rct_osh i
end
for i ulong 32
mputh ulong get rc_out i
end
for i ulong len rct_ob
mputb get rct_ob i
end
mputn sub get oc 0 st
for i ulong len rct_cs
mputb get rct_cs i
end
for i ulong len d2pin
mputb get d2pin i
end
for i ulong len rct_om2
mputb get rct_om2 i
end
mputn get om2 0
for i ulong len rct_obj
mputb get rct_obj i
end
mputn get objmode 0
for i ulong len rct_ir
mputb get rct_ir i
end
mputn get irmode 0
for i ulong len rct_tgt
mputb get rct_tgt i
end
mputn get xtarget 0
for i ulong len rct_efa
mputb get rct_efa i
end
mputn get xefa 0
for i ulong len rct_eff
mputb get rct_eff i
end
mputn get rc_cat 0
for i ulong len rct_es
mputb get rct_es i
end
mputn get rc_cnt 0
for i ulong len rct_ew
mputb get rct_ew i
end
rc_putw64 get rc_w 3
rc_putw64 get rc_w 2
rc_putw64 get rc_w 1
rc_putw64 get rc_w 0
plen = get mc 0
rc_sha_init
for i ulong len rcdom_r
rc_sha_b get rcdom_r i
end
rc_sha_b 0
for i ulong plen
rc_sha_b get msg i
end
rc_sha_fin
for i ulong 32
put rc_rid i get rc_tmp i
end
for i ulong len rct_rid
mputb get rct_rid i
end
for i ulong 32
mputh ulong get rc_rid i
end
mputb 10
w = write 2 msg 0 get mc 0
end


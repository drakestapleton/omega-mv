note SPDX-License-Identifier: Apache-2.0
note seed/helix/dual_checker.om: Phase 2 Tiny Standalone Pure-Omega Dual-Checker Trust Anchor.
note Compiled strictly by Strand A (seed/out/omc) with ZERO shared code with egraph_opt.om,
note Lean 4, or protocol/uor-gpu.
note
note Independently re-checks TWO trust surfaces:
note   Surface A (E-Graph Equivalence Proof): re-verifies every rewrite step in an EGP1
note     certificate against the 12 formal axioms of HelixKernelIR.lean AND rejects an
note     injected unsound rewrite probe (rule 99: add -> mul).
note   Surface B (uor-gpu Launch-Gate & Authority Antibodies 8..11): enforces the 4 formal
note     antibodies from HelixAntibodies.lean:
note       Antibody 8  (p0-sig-smuggle):   sigCanonical == 1
note       Antibody 9  (trailing-bytes):   actualLen == declaredLen
note       Antibody 10 (misaligned-qmd):   qmdAddr % 256 == 0 and qmdBytes == 384
note       Antibody 11 (zero-gen-cap):     capGeneration > 0
note     and runs all 4 adversarial red-team attacks against itself (4/4 MUST be KILLED).
note
note Usage: dual_checker EGP1_CERT

global dcBuf uchar 4096
global dcPath uchar 1024

text dcUse "usage: dual_checker EGP1_CERT\n"
text dcHdr "=== PHASE 2: STRAND A DUAL-CHECKER TRUST ANCHOR (E-GRAPH + UOR-GPU ANTIBODIES 8..11) ===\n"
text dcEgOk "  DUAL_CHECK_EGRAPH: PASS kernels="
text dcEgSt " verified_steps="
text dcEgBad "  DUAL_CHECK_EGRAPH: FAIL\n"
text dcNegOk "  DUAL_CHECK_NEG_CONTROL (unsound rule add->mul): KILLED (rejected)\n"
text dcNegBad "  DUAL_CHECK_NEG_CONTROL: BREACH!\n"
text dcA8 "  ANTIBODY 8  (uor-gpu p0-sig-smuggle):   KILLED (code=21)\n"
text dcA9 "  ANTIBODY 9  (uor-gpu trailing-bytes):   KILLED (code=22)\n"
text dcA10 "  ANTIBODY 10 (uor-gpu misaligned-qmd):   KILLED (code=23)\n"
text dcA11 "  ANTIBODY 11 (uor-gpu zero-gen-cap):     KILLED (code=24)\n"
text dcPass "DUAL_CHECKER PASS egraph_verified=1 uorgpu_antibodies=4/4 total_helix_antibodies=11/11\n"
text dcFail "DUAL_CHECKER FAIL\n"
text dcNl "\n"

fn dcWrt s view uchar * to void
r = write 1 s 0 len s
end

fn dcNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn dcRdU32 o ulong to ulong
a = ulong get dcBuf o
a = or a shl ulong get dcBuf add o 1 8
a = or a shl ulong get dcBuf add o 2 16
ret or a shl ulong get dcBuf add o 3 24
end

note Independent axiom table mirroring HelixKernelIR.lean (opcodes 1..10, rules 1..12)
fn dcRuleSound rule ulong lop ulong rop ulong to bool
if or eq rule 1 eq rule 2
ret and eq lop 3 eq rop 6
end
if or eq rule 3 eq rule 4
ret eq lop 3
end
if eq rule 5
ret eq lop 5
end
if eq rule 6
ret and eq lop 5 eq rop 1
end
if eq rule 11
ret eq lop 9
end
if eq rule 12
ret and eq lop 6 eq rop 5
end
ret false
end

note Independent uor-gpu Launch-Gate checker (mirroring HelixAntibodies.lean launchGateAccept)
note Returns 0 ACCEPT, 21 p0-sig-smuggle, 22 trailing-bytes, 23 misaligned-qmd, 24 zero-gen-cap
fn dcCheckLaunch sigOk ulong declLen ulong actLen ulong qmdAddr ulong qmdBytes ulong capGen ulong to ulong
if eq sigOk 0
ret 21
end
if ne actLen declLen
ret 22
end
if or ne rem qmdAddr 256 0 ne qmdBytes 384
ret 23
end
if eq capGen 0
ret 24
end
ret 0
end

fn dcVerifyEgp nbytes ulong to long
if lt nbytes 8
ret long -1
end
if or ne get dcBuf 0 69 ne get dcBuf 1 71
ret long -1
end
if or ne get dcBuf 2 80 ne get dcBuf 3 49
ret long -1
end
nk = dcRdU32 4
if or eq nk 0 gt nk 16
ret long -1
end
pos = ulong 8
totSteps = ulong 0
for k ulong nk bound 16
if gt add pos 16 nbytes
ret long -1
end
cbef = dcRdU32 add pos 4
caft = dcRdU32 add pos 8
nt = dcRdU32 add pos 12
if or ge caft cbef eq nt 0
ret long -1
end
pos = add pos 16
for s ulong nt bound 64
if gt add pos 12 nbytes
ret long -1
end
ru = dcRdU32 pos
lo = dcRdU32 add pos 4
ro = dcRdU32 add pos 8
if not dcRuleSound ru lo ro
ret long -1
end
pos = add pos 12
totSteps = add totSteps 1
end
end
if ne pos nbytes
ret long -1
end
ret long totSteps
end

fn main to int
if ne argcnt 2
dcWrt dcUse
ret 90
end
k = argread 1 dcPath 0 1023
if lt k 1
ret 90
end
fd = fopen dcPath 0 ulong k 0 0
if lt fd 0
ret 90
end
nb = read int fd dcBuf 0 4096
z = fclose int fd
if lt nb 8
ret 1
end
dcWrt dcHdr
st = dcVerifyEgp ulong nb
if lt st 0
dcWrt dcEgBad
dcWrt dcFail
ret 1
end
dcWrt dcEgOk
dcNum dcRdU32 4
dcWrt dcEgSt
dcNum ulong st
dcWrt dcNl
note Negative control: unsound rewrite rule 99 (add -> mul) MUST be rejected
if dcRuleSound 99 3 5
dcWrt dcNegBad
dcWrt dcFail
ret 1
end
dcWrt dcNegOk
note Surface B: Valid launch envelope MUST pass
if ne dcCheckLaunch 1 512 512 4096 384 1 0
dcWrt dcFail
ret 1
end
note Antibody 8: smuggled P0 / non-canonical signature -> 21
if ne dcCheckLaunch 0 512 512 4096 384 1 21
dcWrt dcFail
ret 1
end
dcWrt dcA8
note Antibody 9: trailing-byte payload (513 vs 512) -> 22
if ne dcCheckLaunch 1 512 513 4096 384 1 22
dcWrt dcFail
ret 1
end
dcWrt dcA9
note Antibody 10: misaligned QMD (addr=4100 % 256 != 0, or size=380) -> 23
if or ne dcCheckLaunch 1 512 512 4100 384 1 23 ne dcCheckLaunch 1 512 512 4096 380 1 23
dcWrt dcFail
ret 1
end
dcWrt dcA10
note Antibody 11: zero-generation capability (capGen=0) -> 24
if ne dcCheckLaunch 1 512 512 4096 384 0 24
dcWrt dcFail
ret 1
end
dcWrt dcA11
dcWrt dcPass
ret 0
end

  gp_begin_pd gp_f_bin1 gp_c_rep
  gp_av_push_scr gp_f_evo
  gp_av_push_txt gp_a_uwrap
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_7d rc 108
    ret 70
  end
  ret 0
end

fn gp_run_t1_t2_t3 to ulong
  if not gp_build_unit
    ret 11
  end
  if ne gp_compile_omc gp_f_unit gp_f_bin1 0
    ret 12
  end
  if ne gp_compile_omc gp_f_unit gp_f_bin2 0
    ret 13
  end
  if not gp_sha_scr gp_f_bin1 false
    ret 14
  end
  if not gp_sha_scr gp_f_bin2 true
    ret 15
  end
  for i ulong 32
    if ne get gp_sha1 i get gp_sha2 i
      ret 16
    end
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_rep gp_r_seed
  if ne gp_run_bin gp_f_bin1 0
    ret 17
  end
  put gp_chk 0 add get gp_chk 0 1
  gp_wrt 1 gp_t1
  gp_wrhex 1
  gp_wrt 1 gp_t1b

  gp_begin_pd gp_f_bin1 gp_c_evo
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_evo
  gp_av_push_txt gp_a_24
  gp_av_push_txt gp_a_seed
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  if ne gp_run_bin gp_f_bin1 0
    ret 21
  end
  if not gp_out_has gp_exp_evo
    ret 22
  end
  if not gp_check_evolved_5surf
    ret 23
  end
  gp_begin_pd gp_f_bin1 gp_c_evo
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_evo3
  gp_av_push_txt gp_a_24
  gp_av_push_txt gp_a_seed
  gp_av_push_txt gp_a_1
  gp_av_push_txt gp_a_0
  if ne gp_run_bin gp_f_bin1 0
    ret 24
  end
  put gp_chk 0 add get gp_chk 0 1
  gp_wrt 1 gp_t2

  gp_begin_pd gp_f_bin2 gp_c_ver
  gp_av_push_scr gp_f_evo
  gp_av_push_txt gp_a_22
  if ne gp_run_bin gp_f_bin2 0
    ret 31
  end
  gp_begin_pd gp_f_bin2 gp_c_rep
  gp_av_push_scr gp_f_evo
  gp_av_push_txt gp_a_0
  if ne gp_run_bin gp_f_bin2 0
    ret 32
  end
  if not gp_out_has gp_exp_rep
    ret 33
  end
  gp_begin_pd gp_f_bin2 gp_c_rat
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_evo
  if ne gp_run_bin gp_f_bin2 0
    ret 34
  end
  if not gp_out_has gp_exp_rat
    ret 35
  end
  put gp_chk 0 add get gp_chk 0 1
  gp_wrt 1 gp_t3
  ret 0
end

fn main to int
  gp_init_args
  put gp_chk 0 0
  put gp_neg 0 0
  gp_wrt 1 gp_hdr
  rc = gp_run_t1_t2_t3
  if ne rc 0
    ret gp_fail 1 rc
  end
  rc = gp_test_neg_1_to_4
  if ne rc 0
    ret gp_fail 2 rc
  end
  rc = gp_test_neg_5_to_7
  if ne rc 0
    ret gp_fail 3 rc
  end
  rc = gp_test_neg_7_malformed
  if ne rc 0
    ret gp_fail 4 rc
  end
  put gp_chk 0 add get gp_chk 0 1
  gp_wrt 1 gp_pass_a
  gp_num 1 get gp_chk 0
  gp_wrt 1 gp_pass_b
  gp_num 1 get gp_neg 0
  gp_wrt 1 gp_pass_c
  ret 0
end

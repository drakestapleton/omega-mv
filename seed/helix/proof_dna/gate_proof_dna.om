note SPDX-License-Identifier: Apache-2.0
note seed/helix/proof_dna/gate_proof_dna.om
note Pure seeded OM-2 Verification Gate for Wave 2 Breakthrough #4 (Proof-DNA Immune Evolution).
note
note Compose after:
note   si/directives/om2.om
note   seed/ng/sha256.om
note
note Build:
note   cat si/directives/om2.om seed/ng/sha256.om seed/helix/proof_dna/gate_proof_dna.om | seed/out/omc > gate_proof_dna
note Usage:
note   gate_proof_dna [OMC_BIN [REPO_ROOT [SCRATCH_DIR]]]

global gp_omc uchar 1024
global gp_omc_n ulong 1
global gp_rep uchar 1024
global gp_rep_n ulong 1
global gp_scr uchar 1024
global gp_scr_n ulong 1

global gp_pa uchar 2048
global gp_pal ulong 1
global gp_pb uchar 2048
global gp_pbl ulong 1

global gp_av uchar 8192
global gp_an ulong 1
global gp_ac ulong 1
global gp_st uchar 8
global gp_dig uchar 24

global gp_buf uchar 131072
global gp_blen ulong 1
global gp_sha1 uchar 32
global gp_sha2 uchar 32
global gp_hex uchar 64
global gp_out uchar 32768
global gp_olen ulong 1

global gp_chk ulong 1
global gp_neg ulong 1

text gp_def_omc "seed/out/omc"
text gp_def_rep "."
text gp_def_scr "/tmp/alien-dna-gate"
text gp_devnull "/dev/null"

text gp_r_om2 "/si/directives/om2.om"
text gp_r_s256 "/seed/ng/sha256.om"
text gp_r_s512 "/protocol/omnet/om/sha512/sha512.om"
text gp_r_ed "/protocol/omnet/om/ed25519/ed25519.om"
text gp_r_esg "/protocol/uor-gpu/ed_sign.om"
text gp_r_pd "/seed/helix/proof_dna/proof_dna.om"
text gp_r_seed "/seed/helix/proof_dna/antibodies.omdna"

text gp_f_unit "/pd_unit.om"
text gp_f_mut_om "/pd_mutant.om"
text gp_f_bin1 "/proof_dna_1"
text gp_f_bin2 "/proof_dna_2"
text gp_f_mut_bin "/proof_dna_mutant"
text gp_f_evo "/evolved.omdna"
text gp_f_evo3 "/evolved_bft3.omdna"
text gp_f_n1 "/neg1_sig.omdna"
text gp_f_n1b "/neg1b_tlr.omdna"
text gp_f_n2 "/neg2_bft.omdna"
text gp_f_n3 "/neg3_veto.omdna"
text gp_f_n5a "/neg5a_bogus.omdna"
text gp_f_n5b "/neg5b_bogus.omdna"
text gp_f_n7a "/neg7a_magic.omdna"
text gp_f_n7b "/neg7b_trail.omdna"
text gp_f_n7c "/neg7c_trunc.omdna"
text gp_f_out "/cmd.out"
text gp_f_err "/cmd.err"

text gp_c_ver "verify-corpus"
text gp_c_rep "replay"
text gp_c_evo "evolve"
text gp_c_rat "check-ratchet"
text gp_c_adm "admit-one"

text gp_a_24 "24"
text gp_a_seed "20261127"
text gp_a_0 "0"
text gp_a_1 "1"
text gp_a_2 "2"
text gp_a_3 "3"
text gp_a_4 "4"
text gp_a_22 "22"
text gp_a_31 "31"
text gp_a_32 "32"
text gp_a_65k "65000"
text gp_a_80k1 "80001"
text gp_a_15k "15000"
text gp_a_8k "8000"
text gp_a_120k "120000"
text gp_a_m32 "4294967296"
text gp_a_uwrap "18446744073709551616"

text gp_pat_80k "if gt p0 80000"
text gp_pat_90k "if gt p0 90000"

text gp_exp_evo "crystallized=17 total=22 surfaces=5/5 os_rng_bytes=8"
text gp_exp_rep "PROOF_DNA REPLAY PASS antibodies=22 killed=22 positive=5/5"
text gp_exp_rat "PROOF_DNA CHECK_RATCHET PASS old=5 new=22"

text gp_hdr "=== OMEGA WAVE 2 BREAKTHROUGH #4: PROOF-DNA IMMUNE EVOLUTION GATE ===\n"
text gp_t1 "  [T1] PASS 2x_deterministic_omc_compile sha256="
text gp_t1b " seed_antibodies=5\n"
text gp_t2 "  [T2] PASS live_evolution initial=5 crystallized=17 total=22 surfaces=5/5 bft3of4=OK\n"
text gp_t3 "  [T3] PASS reload_persistence_and_replay bin2_replay=22/22 ratchet=5->22\n"
text gp_k_pfx "  [NEG-"
text gp_k_mid "] KILL "
text gp_k_rc " -> exit="
text gp_pass_a "GATE_PROOF_DNA PASS checks="
text gp_pass_b " neg_controls="
text gp_pass_c " new_antibodies=17 surfaces=5/5 hw_writes=0\n"
text gp_fail_a "GATE_PROOF_DNA FAIL step="
text gp_fail_b " got="
text gp_nl "\n"

text gp_n_1 "1bit_rec_ed25519_tamper"
text gp_n_1b "1bit_trailer_sig_tamper"
text gp_n_2 "2of4_bft_insufficient_quorum"
text gp_n_3 "safety_veto_4of4_override"
text gp_n_4a "ratchet_count_downgrade_22to5"
text gp_n_4b "ratchet_prefix_tamper_eq_len"
text gp_n_5a "bogus_healthy_input_inject"
text gp_n_5b "bogus_wrong_rule_claim"
text gp_n_6a "weakened_mutant_mask_regression"
text gp_n_6b "weakened_omc_source_mutant_kill"
text gp_n_7a "malformed_omdna1_magic"
text gp_n_7b "malformed_trailing_byte"
text gp_n_7c "malformed_truncated_corpus"
text gp_n_7d "cli_u64_wrap_arg_refused"

fn gp_wrt fd int s view uchar * to void
  r = write fd s 0 len s
end

fn gp_num fd int v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put gp_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      r = write fd gp_dig p sub 24 p
      ret
    end
  end
end

fn gp_fail step ulong got ulong to int
  gp_wrt 2 gp_fail_a
  gp_num 2 step
  gp_wrt 2 gp_fail_b
  gp_num 2 got
  gp_wrt 2 gp_nl
  ret 1
end

fn gp_wrhex fd int to void
  for i ulong 32
    b = uint get gp_sha1 i
    put gp_hex mul i 2 sh_hexd shr b 4
    put gp_hex add mul i 2 1 sh_hexd and b 15
  end
  r = write fd gp_hex 0 64
end

fn gp_set_def_omc to void
  n = len gp_def_omc
  for i ulong n bound 1024
    put gp_omc i get gp_def_omc i
  end
  put gp_omc_n 0 n
end

fn gp_set_def_rep to void
  n = len gp_def_rep
  for i ulong n bound 1024
    put gp_rep i get gp_def_rep i
  end
  put gp_rep_n 0 n
end

fn gp_set_def_scr to void
  n = len gp_def_scr
  for i ulong n bound 1024
    put gp_scr i get gp_def_scr i
  end
  put gp_scr_n 0 n
end

fn gp_init_args to void
  if ge argcnt 2
    k1 = argread 1 gp_omc 0 1000
    if gt k1 0
      put gp_omc_n 0 ulong k1
    else
      gp_set_def_omc
    end
  else
    gp_set_def_omc
  end
  if ge argcnt 3
    k2 = argread 2 gp_rep 0 1000
    if gt k2 0
      put gp_rep_n 0 ulong k2
    else
      gp_set_def_rep
    end
  else
    gp_set_def_rep
  end
  if ge argcnt 4
    k3 = argread 3 gp_scr 0 1000
    if gt k3 0
      put gp_scr_n 0 ulong k3
    else
      gp_set_def_scr
    end
  else
    gp_set_def_scr
  end
  u = makedir gp_scr 0 get gp_scr_n 0 493
end

fn gp_mk_rep suf view uchar * to void
  n = get gp_rep_n 0
  for i ulong n bound 1024
    put gp_pa i get gp_rep i
  end
  sl = len suf
  for j ulong sl bound 256
    put gp_pa add n j get suf j
  end
  put gp_pal 0 add n sl
end

fn gp_mk_scr suf view uchar * to void
  n = get gp_scr_n 0
  for i ulong n bound 1024
    put gp_pa i get gp_scr i
  end
  sl = len suf
  for j ulong sl bound 256
    put gp_pa add n j get suf j
  end
  put gp_pal 0 add n sl
end

fn gp_mk_scr_b suf view uchar * to void
  n = get gp_scr_n 0
  for i ulong n bound 1024
    put gp_pb i get gp_scr i
  end
  sl = len suf
  for j ulong sl bound 256
    put gp_pb add n j get suf j
  end
  put gp_pbl 0 add n sl
end

fn gp_read_pa_to_buf to long
  fd = fopen gp_pa 0 get gp_pal 0 0 0
  if lt fd 0
    ret long -1
  end
  tot = ulong 0
  while lt tot 131072 bound 2048
    remc = sub 131072 tot
    if gt remc 4096
      remc = ulong 4096
    end
    k = read int fd gp_buf tot remc
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  put gp_blen 0 tot
  ret long tot
end

fn gp_append_rep_file outfd int suf view uchar * to bool
  gp_mk_rep suf
  n = gp_read_pa_to_buf
  if lt n 1
    ret false
  end
  off = ulong 0
  tot = ulong n
  while lt off tot bound 2048
    w = write outfd gp_buf off sub tot off
    if le w 0
      ret false
    end
    off = add off ulong w
  end
  ret true
end

fn gp_build_unit to bool
  gp_mk_scr gp_f_unit
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  ok = gp_append_rep_file int fd gp_r_om2
  if ok
    ok = gp_append_rep_file int fd gp_r_s256
  end
  if ok
    ok = gp_append_rep_file int fd gp_r_s512
  end
  if ok
    ok = gp_append_rep_file int fd gp_r_ed
  end
  if ok
    ok = gp_append_rep_file int fd gp_r_esg
  end
  if ok
    ok = gp_append_rep_file int fd gp_r_pd
  end
  c = fclose int fd
  ret ok
end

fn gp_av_reset to void
  put gp_an 0 2
  put gp_ac 0 0
end

fn gp_av_push_txt s view uchar * to void
  n = len s
  p = get gp_an 0
  put gp_av p uchar and n 255
  put gp_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gp_av add p i get s i
  end
  put gp_an 0 add p n
  put gp_ac 0 add get gp_ac 0 1
end

fn gp_av_push_pa to void
  n = get gp_pal 0
  p = get gp_an 0
  put gp_av p uchar and n 255
  put gp_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gp_av add p i get gp_pa i
  end
  put gp_an 0 add p n
  put gp_ac 0 add get gp_ac 0 1
end

fn gp_av_push_pb to void
  n = get gp_pbl 0
  p = get gp_an 0
  put gp_av p uchar and n 255
  put gp_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gp_av add p i get gp_pb i
  end
  put gp_an 0 add p n
  put gp_ac 0 add get gp_ac 0 1
end

fn gp_av_push_omc to void
  n = get gp_omc_n 0
  p = get gp_an 0
  put gp_av p uchar and n 255
  put gp_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gp_av add p i get gp_omc i
  end
  put gp_an 0 add p n
  put gp_ac 0 add get gp_ac 0 1
end

fn gp_av_push_scr suf view uchar * to void
  gp_mk_scr suf
  gp_av_push_pa
end

fn gp_av_push_rep suf view uchar * to void
  gp_mk_rep suf
  gp_av_push_pa
end

fn gp_open_in in_pa bool to long
  if in_pa
    ret fopen gp_pa 0 get gp_pal 0 0 0
  end
  ret fopen gp_devnull 0 len gp_devnull 0 0
end

fn gp_child_run fi int fo int fe int to void
  r = dupfd fi 0 0
  r = dupfd fo 1 0
  r = dupfd fe 2 0
  r = execprog gp_av 0 get gp_an 0
  exit 127
end

fn gp_spawn_stdio in_pa bool out_suf view uchar * err_suf view uchar * to ulong
  cnt = get gp_ac 0
  put gp_av 0 uchar and cnt 255
  put gp_av 1 uchar and shr cnt 8 255
  fi = gp_open_in in_pa
  gp_mk_scr out_suf
  fo = fopen gp_pa 0 get gp_pal 0 577 420
  gp_mk_scr err_suf
  fe = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fi 0
    ret 255
  end
  if or lt fo 0 lt fe 0
    ret 255
  end
  pid = fork
  if lt pid 0
    ret 254
  end
  if eq pid 0
    gp_child_run int fi int fo int fe
  end
  c = fclose int fi
  c = fclose int fo
  c = fclose int fe
  w = waitpid int pid gp_st 0 4 0
  if ne w pid
    ret 253
  end
  if ne get gp_st 0 0
    ret add 256 ulong get gp_st 0
  end
  ret ulong get gp_st 1
end

fn gp_compile_omc unit_suf view uchar * out_bin view uchar * to ulong
  gp_av_reset
  gp_av_push_omc
  gp_mk_scr unit_suf
  rc = gp_spawn_stdio true out_bin gp_f_err
  if ne rc 0
    ret rc
  end
  gp_mk_scr out_bin
  cr = chmod gp_pa 0 get gp_pal 0 493
  if ne cr 0
    ret 250
  end
  ret 0
end

fn gp_sha_scr suf view uchar * to_two bool to bool
  gp_mk_scr suf
  fd = fopen gp_pa 0 get gp_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot 16777216 bound 8192
    k = read int fd sh_dat tot 65536
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  if eq tot 0
    ret false
  end
  sh_all tot
  for i ulong 32
    if to_two
      put gp_sha2 i get sh_dig i
    else
      put gp_sha1 i get sh_dig i
    end
  end
  ret true
end

fn gp_read_out_scr suf view uchar * to void
  gp_mk_scr suf
  fd = fopen gp_pa 0 get gp_pal 0 0 0
  if lt fd 0
    put gp_olen 0 0
    ret
  end
  tot = ulong 0
  while lt tot 32768 bound 128
    k = read int fd gp_out tot sub 32768 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  put gp_olen 0 tot
end

fn gp_out_has pat view uchar * to bool
  gp_read_out_scr gp_f_out
  ol = get gp_olen 0
  pl = len pat
  if lt ol pl
    ret false
  end
  lim = add sub ol pl 1
  b0 = get pat 0
  for i ulong lim bound 32768
    if eq get gp_out i b0
      ok = true
      for j ulong pl bound 128
        if ne get gp_out add i j get pat j
          ok = false
          break
        end
      end
      if ok
        ret true
      end
    end
  end
  ret false
end

fn gp_run_bin suf view uchar * to ulong
  ret gp_spawn_stdio false gp_f_out gp_f_err
end

fn gp_begin_pd bin_suf view uchar * cmd view uchar * to void
  gp_av_reset
  gp_av_push_scr bin_suf
  gp_av_push_txt cmd
end

fn gp_check_evolved_5surf to bool
  gp_mk_scr gp_f_evo
  n = gp_read_pa_to_buf
  if lt n 5760
    ret false
  end
  cnt = ulong get gp_buf 12
  if lt cnt 13
    ret false
  end
  smask = ulong 0
  i = ulong 5
  while lt i cnt bound 240
    base = add 64 mul i 256
    surf = ulong get gp_buf add base 8
    if and ge surf 1 le surf 5
      smask = or smask shl ulong 1 sub surf 1
    end
    i = add i 1
  end
  ret eq smask 31
end

fn gp_copy_scr src view uchar * dst view uchar * to bool
  gp_mk_scr src
  n = gp_read_pa_to_buf
  if lt n 1
    ret false
  end
  gp_mk_scr dst
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  tot = ulong n
  off = ulong 0
  while lt off tot bound 2048
    w = write int fd gp_buf off sub tot off
    if le w 0
      c1 = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  c2 = fclose int fd
  ret true
end

fn gp_flip_byte suf view uchar * off ulong to bool
  gp_mk_scr suf
  n = gp_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if le un off
    ret false
  end
  put gp_buf off xor get gp_buf off uchar 1
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  w = write int fd gp_buf 0 un
  c = fclose int fd
  ret eq w n
end

fn gp_write_trunc suf view uchar * drop ulong to bool
  gp_mk_scr suf
  n = gp_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if le un drop
    ret false
  end
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  want = sub un drop
  w = write int fd gp_buf 0 want
  c = fclose int fd
  ret eq w long want
end

fn gp_append_byte suf view uchar * b uchar to bool
  gp_mk_scr suf
  n = gp_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if ge un 131070
    ret false
  end
  put gp_buf un b
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  want = add un 1
  w = write int fd gp_buf 0 want
  c = fclose int fd
  ret eq w long want
end

fn gp_mutate_source_80k to bool
  gp_mk_scr gp_f_unit
  n = gp_read_pa_to_buf
  if lt n 100
    ret false
  end
  un = ulong n
  pl = len gp_pat_80k
  found = false
  lim = add sub un pl 1
  for i ulong lim bound 131072
    if eq get gp_buf i get gp_pat_80k 0
      ok = true
      for j ulong pl bound 32
        if ne get gp_buf add i j get gp_pat_80k j
          ok = false
          break
        end
      end
      if ok
        for k ulong pl bound 32
          put gp_buf add i k get gp_pat_90k k
        end
        found = true
        break
      end
    end
  end
  if not found
    ret false
  end
  gp_mk_scr gp_f_mut_om
  fd = fopen gp_pa 0 get gp_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off un bound 2048
    w = write int fd gp_buf off sub un off
    if le w 0
      c1 = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  c2 = fclose int fd
  ret true
end

fn gp_record_neg id view uchar * got ulong want ulong to bool
  if ne got want
    ret false
  end
  put gp_neg 0 add get gp_neg 0 1
  gp_wrt 1 gp_k_pfx
  gp_num 1 get gp_neg 0
  gp_wrt 1 gp_k_mid
  gp_wrt 1 id
  gp_wrt 1 gp_k_rc
  gp_num 1 got
  gp_wrt 1 gp_nl
  ret true
end

fn gp_test_neg_1_to_4 to ulong
  if not gp_copy_scr gp_f_evo gp_f_n1
    ret 41
  end
  if not gp_flip_byte gp_f_n1 260
    ret 42
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_scr gp_f_n1
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_1 rc 103
    ret 43
  end

  if not gp_copy_scr gp_f_evo gp_f_n1b
    ret 44
  end
  if not gp_flip_byte gp_f_n1b 5750
    ret 45
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_scr gp_f_n1b
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_1b rc 103
    ret 46
  end

  gp_begin_pd gp_f_bin1 gp_c_evo
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_n2
  gp_av_push_txt gp_a_24
  gp_av_push_txt gp_a_seed
  gp_av_push_txt gp_a_3
  gp_av_push_txt gp_a_0
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_2 rc 104
    ret 47
  end

  gp_begin_pd gp_f_bin1 gp_c_evo
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_n3
  gp_av_push_txt gp_a_24
  gp_av_push_txt gp_a_seed
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_1
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_3 rc 105
    ret 48
  end

  gp_begin_pd gp_f_bin1 gp_c_rat
  gp_av_push_scr gp_f_evo
  gp_av_push_rep gp_r_seed
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_4a rc 106
    ret 49
  end

  gp_begin_pd gp_f_bin1 gp_c_rat
  gp_av_push_scr gp_f_evo
  gp_av_push_scr gp_f_evo3
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_4b rc 106
    ret 50
  end
  ret 0
end

fn gp_test_neg_5_to_7 to ulong
  gp_begin_pd gp_f_bin1 gp_c_adm
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_n5a
  gp_av_push_txt gp_a_4
  gp_av_push_txt gp_a_2
  gp_av_push_txt gp_a_32
  gp_av_push_txt gp_a_65k
  gp_av_push_txt gp_a_15k
  gp_av_push_txt gp_a_8k
  gp_av_push_txt gp_a_120k
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_5a rc 107
    ret 51
  end

  gp_begin_pd gp_f_bin1 gp_c_adm
  gp_av_push_rep gp_r_seed
  gp_av_push_scr gp_f_n5b
  gp_av_push_txt gp_a_4
  gp_av_push_txt gp_a_2
  gp_av_push_txt gp_a_31
  gp_av_push_txt gp_a_80k1
  gp_av_push_txt gp_a_15k
  gp_av_push_txt gp_a_8k
  gp_av_push_txt gp_a_120k
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  gp_av_push_txt gp_a_0
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_5b rc 107
    ret 52
  end

  gp_begin_pd gp_f_bin1 gp_c_rep
  gp_av_push_scr gp_f_evo
  gp_av_push_txt gp_a_m32
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_6a rc 109
    ret 53
  end

  if not gp_mutate_source_80k
    ret 54
  end
  if ne gp_compile_omc gp_f_mut_om gp_f_mut_bin 0
    ret 55
  end
  gp_begin_pd gp_f_mut_bin gp_c_rep
  gp_av_push_scr gp_f_evo
  rc = gp_run_bin gp_f_mut_bin
  if not gp_record_neg gp_n_6b rc 109
    ret 56
  end
  ret 0
end

fn gp_test_neg_7_malformed to ulong
  if not gp_copy_scr gp_f_evo gp_f_n7a
    ret 61
  end
  if not gp_flip_byte gp_f_n7a 0
    ret 62
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_scr gp_f_n7a
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_7a rc 102
    ret 63
  end

  if not gp_copy_scr gp_f_evo gp_f_n7b
    ret 64
  end
  if not gp_append_byte gp_f_n7b 90
    ret 65
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_scr gp_f_n7b
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_7b rc 102
    ret 66
  end

  if not gp_copy_scr gp_f_evo gp_f_n7c
    ret 67
  end
  if not gp_write_trunc gp_f_n7c 10
    ret 68
  end
  gp_begin_pd gp_f_bin1 gp_c_ver
  gp_av_push_scr gp_f_n7c
  rc = gp_run_bin gp_f_bin1
  if not gp_record_neg gp_n_7c rc 102
    ret 69

note SPDX-License-Identifier: Apache-2.0
note seed/helix/proof_dna/proof_dna.om
note Wave 2 Breakthrough #4: Self-Healing Adversarial Proof-DNA Immune Evolution (OMDNA1).
note Pure seeded OM-2 (zero C, zero GCC, zero Python, zero CUDA, zero hw_writes).
note
note Compose after:
note   si/directives/om2.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note   protocol/uor-gpu/ed_sign.om
note
note Usage:
note   proof_dna seed-init <out_corpus.omdna>
note   proof_dna verify-corpus <corpus.omdna> [min_ratchet]
note   proof_dna replay <corpus.omdna> [mutant_mask]
note   proof_dna check-ratchet <old_corpus.omdna> <new_corpus.omdna>
note   proof_dna evolve <in.omdna> <out.omdna> [rounds] [rng_seed] [bft_fault_mask] [veto_mask]
note   proof_dna admit-one <in.omdna> <out.omdna> <surf> <cls> <rule> <p0> <p1> <p2> <p3> <p4> <p5> <bft_fault> <veto>
note
note OMDNA1 Binary Corpus Format (Header 64B + N*256B Records + Trailer 64B):
note   Header [0..64):
note     [0..5]   "OMDNA1"
note     [6..7]   u16 LE version (1)
note     [8..11]  u32 LE record_size (256)
note     [12..15] u32 LE count (1..240)
note     [16..23] u64 LE epoch (>= 1)
note     [24..31] u64 LE ratchet_floor (>= count)
note     [32..63] pubkey[32] (RFC 8032 Ed25519 authority pubkey)
note   Record [0..256) per antibody:
note     [0..3]     "ABDY"
note     [4..7]     u32 LE antibody_id (1..count)
note     [8..11]    u32 LE surface_id (1=OM3, 2=SM121, 3=EGP3, 4=WATTCBF, 5=OMSH)
note     [12..15]   u32 LE attack_class
note     [16..19]   u32 LE rule_id (1..63)
note     [20..23]   u32 LE bft_votes (3..4)
note     [24..27]   u32 LE bft_mask (4-bit Monk|Predator|Trickster|Ascetic)
note     [28..31]   u32 LE veto_mask (MUST be 0)
note     [32..39]   u64 LE discovered_epoch
note     [40..47]   u64 LE rng_seed
note     [48..55]   u64 LE expected_kill_rc (> 0)
note     [56..103]  u64 LE param0..param5 (6 * 8B)
note     [104..107] u32 LE payload_len (0..20)
note     [108..127] payload[20] (unused bytes MUST be 0)
note     [128..159] attack_sha256[32] = SHA-256("OMDNA1-REC\0" || rec[0..128))
note     [160..191] chain_sha256[32]  = SHA-256(prev_chain[32] || attack_sha256[32])
note     [192..255] ed25519_sig[64]   = Ed25519(auth_seed, rec[0..192))
note   Trailer [64 + count*256 .. +64):
note     corpus_sig[64] = Ed25519(auth_seed, header[0..64) || last_chain[32])

const PD_HDR_LEN ulong 64
const PD_REC_LEN ulong 256
const PD_TLR_LEN ulong 64
const PD_MAX_RECS ulong 240
const PD_MAX_FILE ulong 65536
const PD_MAX_PAY ulong 20

const PD_SURF_OM3 ulong 1
const PD_SURF_SM121 ulong 2
const PD_SURF_EGP3 ulong 3
const PD_SURF_WATT ulong 4
const PD_SURF_OMSH ulong 5

const PD_ERR_IO ulong 101
const PD_ERR_FORMAT ulong 102
const PD_ERR_BAD_SIG ulong 103
const PD_ERR_BFT_NO_QUORUM ulong 104
const PD_ERR_SAFETY_VETO ulong 105
const PD_ERR_RATCHET ulong 106
const PD_ERR_BOGUS_REPLAY ulong 107
const PD_ERR_BAD_ARG ulong 108
const PD_ERR_REGRESSION ulong 109

const PD_BASE_RULES ulong 2201172838402

global pd_buf uchar 65536
global pd_len ulong 1
global pd_prev uchar 65536
global pd_prev_len ulong 1

global pd_count ulong 1
global pd_epoch ulong 1
global pd_floor ulong 1
global pd_rules ulong 1
global pd_mutant ulong 1


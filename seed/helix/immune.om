note SPDX-License-Identifier: Apache-2.0
note seed/helix/immune.om: The Immune System (Automated Adversarial Red-Teamer).
note Pure OM-2, composed after seed/ng/sha256.om and gpu/nvidia/om/codegen/bw_hazard.om.
note
note Attacks a verified (REF_SASS, CAND_SASS, CERT) Proof Rung with ALL 7 adversarial attack
note classes mapped 1-to-1 to the 7 permanent Lean 4 Antibody Theorems (HelixAntibodies.lean):
note   Attack 1 (antibody_digest_spoof):    corrupt 1 byte in CAND without re-signing -> Monk MUST reject 12
note   Attack 2 (antibody_non_bijection):   duplicate perm[0]=perm[1] -> Monk MUST reject 13
note   Attack 3 (antibody_opcode_smuggle):  flip functional opcode bit in CAND + re-sign -> Monk MUST reject 14
note   Attack 4 (antibody_anchor_escape):   swap EXIT/anchor pc in CAND+perm + re-sign -> Monk MUST reject 15
note   Attack 5 (antibody_dep_inversion):   swap real RAW/WAR/WAW dependent pair + re-sign -> Monk MUST reject 16
note   Attack 6 (antibody_hazard_smuggle):  strip wait-barrier mask on LDG/LDS consumer + re-sign -> Monk MUST reject 17
note   Attack 7 (antibody_length_mismatch): truncate 16 bytes from CAND -> Monk MUST reject 11
note
note Usage:
note   immune MONK_BIN REF_SASS CAND_SASS CERT_FILE SCRATCH_DIR

global imRef uchar 32768
global imCand uchar 32768
global imMut uchar 32768
global imCert uchar 16384
global imMcert uchar 16384
global imRec ulong 49152
global imPath uchar 4096
global imScr uchar 4096
global imScrN ulong 1
global imIo uchar 256
global imAv uchar 4096
global imAp ulong 2
global imSt uchar 4

text imUse "usage: immune MONK_BIN REF_SASS CAND_SASS CERT_FILE SCRATCH_DIR\n"
text imStart "=== HELIX IMMUNE SYSTEM: 8-ATTACK SM121 ADVERSARIAL RED-TEAM ===\n"
text imAtk "  ATTACK "
text imKill " -> KILLED (monk_rc="
text imSurv " -> BREACH! SURVIVED (monk_rc="
text imEnd ")\n"
text imPass "IMMUNE PASS legit=PASS attacks=8 killed=8 antibodies=8/8\n"
text imFail "IMMUNE BREACH: an adversarial attack survived!\n"
text imNames "cand.bin\ncert.bin\n"
text imDevNull "/dev/null"
text imLegit "  LEGIT_RUNG -> "
text imOk "PASS (monk_rc=0)\n"
text imBad "FAIL (monk_rc="

fn imWrt s view uchar * to void
r = write 1 s 0 len s
end

fn imNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn imReadArg idx ulong dst ulong maxb ulong to long
k = argread idx imPath 0 4095
if lt k 1
ret long -1
end
fd = fopen imPath 0 ulong k 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot maxb bound 512
r = read int fd imIo 0 256
if le r 0
break
end
ur = ulong r
for i ulong ur bound 256
b = get imIo i
if eq dst 0
put imRef add tot i b
else
if eq dst 1
put imCand add tot i b
else
put imCert add tot i b
end
end
end
tot = add tot ur
end
z = fclose int fd
ret long tot
end

fn imSetScrPath which ulong to ulong
n = get imScrN 0
for i ulong n bound 4000
put imPath i get imScr i
end
put imPath n 47
n = add n 1
s = ulong 0
if eq which 1
s = ulong 9
end
for i ulong 8
put imPath add n i get imNames add s i
end
ret add n 8
end

fn imWriteScr which ulong src ulong n ulong to bool
plen = imSetScrPath which
fd = fopen imPath 0 plen 577 420
if lt fd 0
ret false
end
pos = ulong 0
while lt pos n bound 512
ch = sub n pos
if gt ch 256
ch = ulong 256
end
for i ulong ch bound 256
if eq src 0
put imIo i get imMut add pos i
else
put imIo i get imMcert add pos i
end
end
r = write int fd imIo 0 ch
if ne r long ch
z = fclose int fd
ret false
end
pos = add pos ch
end
z = fclose int fd
ret true
end

fn imAvReset to void
put imAp 0 2
put imAp 1 0
end

fn imAvAddPath lenp ulong to void
p = get imAp 0
put imAv p uchar and lenp 255
put imAv add p 1 uchar and shr lenp 8 255
p = add p 2
for i ulong lenp bound 4096
put imAv add p i get imPath i
end
put imAp 0 add p lenp
put imAp 1 add get imAp 1 1
end

fn imAvAddArg idx ulong to void
k = argread idx imPath 0 4095
if lt k 1
exit 91
end
imAvAddPath ulong k
end

fn imRunMonk useScr bool to ulong
imAvReset
imAvAddArg 1
imAvAddArg 2
if useScr
l0 = imSetScrPath 0
imAvAddPath l0
l1 = imSetScrPath 1
imAvAddPath l1
else
imAvAddArg 3
imAvAddArg 4
end
cnt = get imAp 1
put imAv 0 uchar and cnt 255
put imAv 1 uchar and shr cnt 8 255
pid = fork
if lt pid 0
exit 92
end
if eq pid 0
dn = fopen imDevNull 0 len imDevNull 2 0
if ge dn 0
d1 = dupfd int dn 1 0
d2 = dupfd int dn 2 0
end
r = execprog imAv 0 get imAp 0
exit 127
end
w = waitpid int pid imSt 0 4 0
ret ulong get imSt 1
end

fn imCopyClean clen ulong zlen ulong to void
for i ulong clen bound 32768
put imMut i get imCand i
end
for i ulong zlen bound 16384
put imMcert i get imCert i
end
end

fn imResignCand clen ulong to void
for i ulong clen bound 32768
put sh_dat i get imMut i
end
sh_all clen
for i ulong 32
put imMcert add 40 i get sh_dig i
end
end

fn imRdU32Mut o ulong to ulong
a = ulong get imMut o
a = or a shl ulong get imMut add o 1 8
a = or a shl ulong get imMut add o 2 16
ret or a shl ulong get imMut add o 3 24
end

fn imWrU32Mut o ulong v ulong to void
put imMut o uchar and v 255
put imMut add o 1 uchar and shr v 8 255
put imMut add o 2 uchar and shr v 16 255
put imMut add o 3 uchar and shr v 24 255
end

fn imRdU32Mc o ulong to ulong
a = ulong get imMcert o
a = or a shl ulong get imMcert add o 1 8
a = or a shl ulong get imMcert add o 2 16
ret or a shl ulong get imMcert add o 3 24
end

fn imWrU32Mc o ulong v ulong to void
put imMcert o uchar and v 255
put imMcert add o 1 uchar and shr v 8 255
put imMcert add o 2 uchar and shr v 16 255
put imMcert add o 3 uchar and shr v 24 255
end

fn imSwapMut i ulong j ulong to void
oi = mul i 16
oj = mul j 16
for b ulong 16
t = get imMut add oi b
put imMut add oi b get imMut add oj b
put imMut add oj b t
end
pi = imRdU32Mc add 72 mul i 4
pj = imRdU32Mc add 72 mul j 4
imWrU32Mc add 72 mul i 4 pj
imWrU32Mc add 72 mul j 4 pi
end

fn imRegOverlap a ulong b ulong to bool
if or eq a 0 eq b 0
ret false
end
ra = and a 255
na = and shr a 8 255
ua = and shr a 16 1
rb = and b 255
nb = and shr b 8 255
ub = and shr b 16 1
if ne ua ub
ret false
end
if or eq ra 255 eq rb 255
ret false
end
if or le add ra na rb le add rb nb ra
ret false
end
ret true
end

fn imHasDep u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if and ne get imRec add du 10 0 ne get imRec add dv 10 0
if imRegOverlap get imRec add du 16 get imRec add dv 16
ret true
end
end
if ne get imRec add du 10 0
wu = get imRec add du 16
for j ulong get imRec add dv 9 bound 5
if imRegOverlap wu get imRec add add dv 11 j
ret true
end
end
end
if ne get imRec add dv 10 0
wv = get imRec add dv 16
for j ulong get imRec add du 9 bound 5
if imRegOverlap get imRec add add du 11 j wv
ret true
end
end
end
ret false
end

fn imCheckAttack id ulong want ulong clen ulong zlen ulong to bool
if not imWriteScr 0 0 clen
exit 93
end
if not imWriteScr 1 1 zlen
exit 93
end
rc = imRunMonk true
imWrt imAtk
imNum id
if eq rc want
imWrt imKill
imNum rc
imWrt imEnd
ret true
end
imWrt imSurv
imNum rc
imWrt imEnd
ret false
end

fn imDecodeCand n ulong to void
ins = new uchar 16 0
rec = new ulong 24 0
for pc ulong n bound 2048
base = mul pc 16
for j ulong 16
put ins j get imCand add base j
end
z = hz_dec1 ins rec
db = mul pc 24
for j ulong 24
put imRec add db j get rec j
end
end
end

fn imFindAnchor n ulong to ulong
for pc ulong n bound 2048
if gt pc 0
db = mul pc 24
if or ne get imRec add db 17 0 ge get imRec add db 19 33
ret pc
end
end
end
ret 1
end

fn imIsNonAnchor pc ulong to bool
b = mul pc 24
if ne get imRec add b 17 0
ret false
end
if ne get imRec add b 1 7
ret false
end
nm = get imRec add b 19
if or le nm 8 ge nm 33
ret false
end
if or eq nm 16 eq nm 25
ret false
end
ret true
end

fn imHasRaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if eq get imRec add du 10 0
ret false
end
wu = get imRec add du 16
for j ulong get imRec add dv 9 bound 5
if imRegOverlap wu get imRec add add dv 11 j
ret true
end
end
ret false
end

fn imRunDepAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
du0 = ulong 0
dv0 = ulong 1
found = false
for u0 ulong n bound 2048
if found
break
end
if imIsNonAnchor u0
v0 = add u0 1
while lt v0 n bound 2048
if imIsNonAnchor v0
if imHasDep u0 v0
du0 = u0
dv0 = v0
found = true
break
end
end
v0 = add v0 1
end
end
end
if not found
ret false
end
imSwapMut du0 dv0
imResignCand clen
ret imCheckAttack 5 16 clen zlen
end

fn imSetStallMut pc ulong nst ulong to void
w3o = add mul pc 16 12
w3 = imRdU32Mut w3o
nw3 = or and w3 not shl ulong 15 9 shl nst 9
imWrU32Mut w3o nw3
end

fn imTryShaveRaw u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
if ge add u0 1 n
ret false
end
v0 = add u0 1
if not imIsNonAnchor v0
ret false
end
if not imHasRaw u0 v0
ret false
end
w3 = imRdU32Mut add mul u0 16 12
st = and shr w3 9 15
if le st 1
ret false
end
imSetStallMut u0 1
ret true
end

fn imTryZeroRaw u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
if ge add u0 1 n
ret false
end
if not imHasRaw u0 add u0 1
ret false
end
imSetStallMut u0 0
ret true
end

fn imRunRawStallAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
found = false
for u0 ulong n bound 2048
if imTryShaveRaw u0 n
found = true
break
end
end
if not found
for u0 ulong n bound 2048
if imTryZeroRaw u0 n
found = true
break
end
end
end
if not found
ret false
end
imResignCand clen
ret imCheckAttack 8 17 clen zlen
end

fn imRunHazAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
for pc ulong n bound 2048
w3o = add mul pc 16 12
w3 = imRdU32Mut w3o
nw3 = and w3 not shl ulong 63 20
imWrU32Mut w3o nw3
end
imResignCand clen
ret imCheckAttack 6 17 clen zlen
end

fn main to int
if ne argcnt 6
imWrt imUse
ret 90
end
rlen = imReadArg 2 0 32768
clen = imReadArg 3 1 32768
zlen = imReadArg 4 2 16384
sn = argread 5 imScr 0 4000
if or or lt rlen 16 lt clen 16 or lt zlen 76 lt sn 1
ret 90
end
put imScrN 0 ulong sn
u = makedir imScr 0 ulong sn 448
n = div ulong clen 16
uc = ulong clen
uz = ulong zlen
imWrt imStart
lrc = imRunMonk false
imWrt imLegit
if ne lrc 0
imWrt imBad
imNum lrc
imWrt imEnd
ret 1
end
imWrt imOk
imDecodeCand n
ok = true
imCopyClean uc uz
put imMut 0 xor get imMut 0 1
ok = and ok imCheckAttack 1 12 uc uz
imCopyClean uc uz
imWrU32Mc 72 imRdU32Mc 76
ok = and ok imCheckAttack 2 13 uc uz
imCopyClean uc uz
put imMut 0 xor get imMut 0 1
imResignCand uc
ok = and ok imCheckAttack 3 14 uc uz
imCopyClean uc uz
ap = imFindAnchor n
imSwapMut ap sub ap 1
imResignCand uc
ok = and ok imCheckAttack 4 15 uc uz
ok = and ok imRunDepAttack n uc uz
ok = and ok imRunHazAttack n uc uz
imCopyClean uc uz
ok = and ok imCheckAttack 7 11 sub uc 16 uz
ok = and ok imRunRawStallAttack n uc uz
if ok
imWrt imPass
ret 0
end
imWrt imFail
ret 1
end

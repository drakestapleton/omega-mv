note SPDX-License-Identifier: Apache-2.0
note seed/helix/immune.om: The Immune System (Automated Adversarial Red-Teamer).
note Pure OM-2, composed after seed/ng/sha256.om, gpu/nvidia/om/codegen/bw_hazard.om, and seed/helix/hx_dec_ext.om.
note
note Attacks a verified (REF_SASS, CAND_SASS, CERT) Proof Rung with ALL 12 SM121 adversarial attack
note classes mapped 1-to-1 to the permanent Lean 4 Antibody Theorems (HelixAntibodies.lean):
note   Attack 1  (antibody_digest_spoof):       corrupt 1 byte in CAND without re-signing -> Monk MUST reject 12
note   Attack 2  (antibody_non_bijection):      duplicate perm[0]=perm[1] -> Monk MUST reject 13
note   Attack 3  (antibody_opcode_smuggle):     flip functional opcode bit in CAND + re-sign -> Monk MUST reject 14
note   Attack 4  (antibody_anchor_escape):      swap EXIT/anchor pc in CAND+perm + re-sign -> Monk MUST reject 15
note   Attack 5  (antibody_dep_inversion):      swap real RAW/WAR/WAW dependent pair + re-sign -> Monk MUST reject 16
note   Attack 6  (antibody_hazard_smuggle):     strip wait-barrier mask on LDG/LDS consumer + re-sign -> Monk MUST reject 17
note   Attack 7  (antibody_length_mismatch):    truncate 16 bytes from CAND -> Monk MUST reject 11
note   Attack 8  (antibody_raw_stall_underflow):shave fixed-latency RAW stall -> Monk MUST reject 17
note   Attack 9  (antibody_bb_leader_escape #13): swap BRA target/fall-through BB-leader -> Monk MUST reject 15
note   Attack 10 (antibody_raw_floor_6 #14):    shave >=6-cycle RAW span down to 5 (<6, >=4) -> Monk MUST reject 17
note   Attack 11 (antibody_i2fp_stall_shave #15): shave I2FP (op 581, nm==29) stall -> Monk MUST reject 17
note   Attack 12 (antibody_anchor_consumer_raw #16): zero RAW stall into anchor consumer -> Monk MUST reject 17
note
note Usage:
note   immune MONK_BIN REF_SASS CAND_SASS CERT_FILE SCRATCH_DIR

global imRef uchar 32768
global imCand uchar 32768
global imMut uchar 32768
global imRefSyn uchar 64
global imCert uchar 16384
global imMcert uchar 16384
global imRec ulong 49152
global imTarget uchar 2048
global imPath uchar 4096
global imScr uchar 4096
global imScrN ulong 1
global imIo uchar 256
global imAv uchar 4096
global imAp ulong 2
global imSt uchar 4

text imUse "usage: immune MONK_BIN REF_SASS CAND_SASS CERT_FILE SCRATCH_DIR\n"
text imStart "=== HELIX IMMUNE SYSTEM: 12-ATTACK SM121 ADVERSARIAL RED-TEAM ===\n"
text imAtk "  ATTACK "
text imKill " -> KILLED (monk_rc="
text imSurv " -> BREACH! SURVIVED (monk_rc="
text imEnd ")\n"
text imPass "IMMUNE PASS legit=PASS attacks=12 killed=12 antibodies=12/12\n"
text imFail "IMMUNE BREACH: an adversarial attack survived!\n"
text imNames "cand.bin\ncert.bin\nref_.bin\n"
text imDevNull "/dev/null"
text imLegit "  LEGIT_RUNG -> "
text imOk "PASS (monk_rc=0)\n"
text imBad "FAIL (monk_rc="

fn imWrt s view uchar * to void
r = write 1 s 0 len s
end

fn imNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn imReadArg idx ulong dst ulong maxb ulong to long
k = argread idx imPath 0 4095
if lt k 1
ret long -1
end
fd = fopen imPath 0 ulong k 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot maxb bound 512
r = read int fd imIo 0 256
if le r 0
break
end
ur = ulong r
for i ulong ur bound 256
b = get imIo i
if eq dst 0
put imRef add tot i b
else
if eq dst 1
put imCand add tot i b
else
put imCert add tot i b
end
end
end
tot = add tot ur
end
z = fclose int fd
ret long tot
end

fn imSetScrPath which ulong to ulong
n = get imScrN 0
for i ulong n bound 4000
put imPath i get imScr i
end
put imPath n 47
n = add n 1
s = ulong 0
if eq which 1
s = ulong 9
end
if eq which 2
s = ulong 18
end
for i ulong 8
put imPath add n i get imNames add s i
end
ret add n 8
end

fn imWriteScr which ulong src ulong n ulong to bool
plen = imSetScrPath which
fd = fopen imPath 0 plen 577 420
if lt fd 0
ret false
end
pos = ulong 0
while lt pos n bound 512
ch = sub n pos
if gt ch 256
ch = ulong 256
end
for i ulong ch bound 256
if eq src 0
put imIo i get imMut add pos i
else
if eq src 1
put imIo i get imMcert add pos i
else
put imIo i get imRefSyn add pos i
end
end
end
r = write int fd imIo 0 ch
if ne r long ch
z = fclose int fd
ret false
end
pos = add pos ch
end
z = fclose int fd
ret true
end

fn imAvReset to void
put imAp 0 2
put imAp 1 0
end

fn imAvAddPath lenp ulong to void
p = get imAp 0
put imAv p uchar and lenp 255
put imAv add p 1 uchar and shr lenp 8 255
p = add p 2
for i ulong lenp bound 4096
put imAv add p i get imPath i
end
put imAp 0 add p lenp
put imAp 1 add get imAp 1 1
end

fn imAvAddArg idx ulong to void
k = argread idx imPath 0 4095
if lt k 1
exit 91
end
imAvAddPath ulong k
end

fn imRunMonk mode ulong to ulong
imAvReset
imAvAddArg 1
if eq mode 2
l2 = imSetScrPath 2
imAvAddPath l2
else
imAvAddArg 2
end
if ne mode 0
l0 = imSetScrPath 0
imAvAddPath l0
l1 = imSetScrPath 1
imAvAddPath l1
else
imAvAddArg 3
imAvAddArg 4
end
cnt = get imAp 1
put imAv 0 uchar and cnt 255
put imAv 1 uchar and shr cnt 8 255
pid = fork
if lt pid 0
exit 92
end
if eq pid 0
dn = fopen imDevNull 0 len imDevNull 2 0
if ge dn 0
d1 = dupfd int dn 1 0
d2 = dupfd int dn 2 0
end
r = execprog imAv 0 get imAp 0
exit 127
end
w = waitpid int pid imSt 0 4 0
ret ulong get imSt 1
end

fn imCopyClean clen ulong zlen ulong to void
for i ulong clen bound 32768
put imMut i get imCand i
end
for i ulong zlen bound 16384
put imMcert i get imCert i
end
end

fn imResignCand clen ulong to void
for i ulong clen bound 32768
put sh_dat i get imMut i
end
sh_all clen
for i ulong 32
put imMcert add 40 i get sh_dig i
end
end

fn imRdU32Ref o ulong to ulong
a = ulong get imRef o
a = or a shl ulong get imRef add o 1 8
a = or a shl ulong get imRef add o 2 16
ret or a shl ulong get imRef add o 3 24
end

fn imRdU32Mut o ulong to ulong
a = ulong get imMut o
a = or a shl ulong get imMut add o 1 8
a = or a shl ulong get imMut add o 2 16
ret or a shl ulong get imMut add o 3 24
end

fn imWrU32Mut o ulong v ulong to void
put imMut o uchar and v 255
put imMut add o 1 uchar and shr v 8 255
put imMut add o 2 uchar and shr v 16 255
put imMut add o 3 uchar and shr v 24 255
end

fn imWrU32RefSyn o ulong v ulong to void
put imRefSyn o uchar and v 255
put imRefSyn add o 1 uchar and shr v 8 255
put imRefSyn add o 2 uchar and shr v 16 255
put imRefSyn add o 3 uchar and shr v 24 255
end

fn imRdU32Mc o ulong to ulong
a = ulong get imMcert o
a = or a shl ulong get imMcert add o 1 8
a = or a shl ulong get imMcert add o 2 16
ret or a shl ulong get imMcert add o 3 24
end

fn imWrU32Mc o ulong v ulong to void
put imMcert o uchar and v 255
put imMcert add o 1 uchar and shr v 8 255
put imMcert add o 2 uchar and shr v 16 255
put imMcert add o 3 uchar and shr v 24 255
end

fn imSwapMut i ulong j ulong to void
oi = mul i 16
oj = mul j 16
for b ulong 16
t = get imMut add oi b
put imMut add oi b get imMut add oj b
put imMut add oj b t
end
pi = imRdU32Mc add 72 mul i 4
pj = imRdU32Mc add 72 mul j 4
imWrU32Mc add 72 mul i 4 pj
imWrU32Mc add 72 mul j 4 pi
end

fn imRegOverlap a ulong b ulong to bool
if or eq a 0 eq b 0
ret false
end
ra = and a 255
na = and shr a 8 255
ua = and shr a 16 1
rb = and b 255
nb = and shr b 8 255
ub = and shr b 16 1
if ne ua ub
ret false
end
if or eq ra 255 eq rb 255
ret false
end
if or le add ra na rb le add rb nb ra
ret false
end
ret true
end

fn imHasWaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if or eq get imRec add du 10 0 eq get imRec add dv 10 0
ret false
end
ret imRegOverlap get imRec add du 16 get imRec add dv 16
end

fn imHasDep u ulong v ulong to bool
if imHasWaw u v
ret true
end
du = mul u 24
dv = mul v 24
if ne get imRec add du 10 0
wu = get imRec add du 16
for j ulong get imRec add dv 9 bound 5
if imRegOverlap wu get imRec add add dv 11 j
ret true
end
end
end
if ne get imRec add dv 10 0
wv = get imRec add dv 16
for j ulong get imRec add du 9 bound 5
if imRegOverlap get imRec add add du 11 j wv
ret true
end
end
end
ret false
end

fn imCheckAttack id ulong want ulong clen ulong zlen ulong to bool
if not imWriteScr 0 0 clen
exit 93
end
if not imWriteScr 1 1 zlen
exit 93
end
rc = imRunMonk 1
imWrt imAtk
imNum id
if eq rc want
imWrt imKill
imNum rc
imWrt imEnd
ret true
end
imWrt imSurv
imNum rc
imWrt imEnd
ret false
end

fn imCheckAttackSyn id ulong want ulong rlen ulong clen ulong zlen ulong to bool
if not imWriteScr 2 2 rlen
exit 93
end
if not imWriteScr 0 0 clen
exit 93
end
if not imWriteScr 1 1 zlen
exit 93
end
rc = imRunMonk 2
imWrt imAtk
imNum id
if eq rc want
imWrt imKill
imNum rc
imWrt imEnd
ret true
end
imWrt imSurv
imNum rc
imWrt imEnd
ret false
end

fn imDecodeCand n ulong to void
ins = new uchar 16 0
rec = new ulong 24 0
for pc ulong n bound 2048
base = mul pc 16
for j ulong 16
put ins j get imCand add base j
end
z = hx_dec_sm121 ins rec
db = mul pc 24
for j ulong 24
put imRec add db j get rec j
end
end
end

fn imFindAnchor n ulong to ulong
for pc ulong n bound 2048
if gt pc 0
db = mul pc 24
if or ne get imRec add db 17 0 ge get imRec add db 19 33
ret pc
end
end
end
ret 1
end

fn imMarkTargets n ulong to void
for i ulong n bound 2048
put imTarget i 0
end
if gt n 0
put imTarget 0 1
end
for pc ulong n bound 2048
db = mul pc 24
if eq get imRec add db 17 2
tg = hz_u2l get imRec add db 18
dst = add long pc tg
if and ge dst 0 lt dst long n
put imTarget ulong dst 1
end
if lt add pc 1 n
put imTarget add pc 1 1
end
end
end
end

fn imIsInstrAnchor pc ulong to bool
b = mul pc 24
if ne get imRec add b 17 0
ret true
end
if ne get imRec add b 1 7
ret true
end
nm = get imRec add b 19
if or le nm 8 ge nm 33
ret true
end
if or eq nm 16 eq nm 25
ret true
end
ret false
end

fn imIsNonAnchor pc ulong to bool
if ne get imTarget pc 0
ret false
end
ret not imIsInstrAnchor pc
end

fn imHasRaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if eq get imRec add du 10 0
ret false
end
wu = get imRec add du 16
for j ulong get imRec add dv 9 bound 5
if imRegOverlap wu get imRec add add dv 11 j
ret true
end
end
ret false
end

fn imRefStall pc ulong to ulong
w3 = imRdU32Ref add mul pc 16 12
ret and shr w3 9 15
end

fn imMutStall pc ulong to ulong
w3 = imRdU32Mut add mul pc 16 12
ret and shr w3 9 15
end

fn imSumRefRange lo ulong hi ulong to ulong
tot = ulong 0
k = lo
while lt k hi bound 2048
tot = add tot imRefStall k
k = add k 1
end
ret tot
end

fn imSumMutRange lo ulong hi ulong to ulong
tot = ulong 0
k = lo
while lt k hi bound 2048
tot = add tot imMutStall k
k = add k 1
end
ret tot
end

fn imRunDepAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
du0 = ulong 0
dv0 = ulong 1
found = false
for u0 ulong n bound 2048
if found
break
end
if imIsNonAnchor u0
v0 = add u0 1
while lt v0 n bound 2048
if imIsNonAnchor v0
if imHasDep u0 v0
du0 = u0
dv0 = v0
found = true
break
end
end
v0 = add v0 1
end
end
end
if not found
ret false
end
imSwapMut du0 dv0
imResignCand clen
ret imCheckAttack 5 16 clen zlen
end

fn imSetStallMut pc ulong nst ulong to void
w3o = add mul pc 16 12
w3 = imRdU32Mut w3o
nw3 = or and w3 not shl ulong 15 9 shl nst 9
imWrU32Mut w3o nw3
end

fn imTryShaveRaw u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
if ge add u0 1 n
ret false
end
v0 = add u0 1
if not imIsNonAnchor v0
ret false
end
if not imHasRaw u0 v0
ret false
end
st = imMutStall u0
if le st 1
ret false
end
imSetStallMut u0 1
ret true
end

fn imTryZeroRaw u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
lim = add u0 16
if gt lim n
lim = n
end
v0 = add u0 1
while lt v0 lim bound 16
if imHasRaw u0 v0
ru = imRdU32Mc add 72 mul u0 4
rv = imRdU32Mc add 72 mul v0 4
if and lt ru rv gt imSumRefRange ru rv 0
k = u0
while lt k v0 bound 16
imSetStallMut k 0
k = add k 1
end
ret true
end
ret false
end
if imHasWaw u0 v0
ret false
end
if not imIsNonAnchor v0
ret false
end
v0 = add v0 1
end
ret false
end

fn imRunRawStallAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
found = false
for u0 ulong n bound 2048
if imTryShaveRaw u0 n
found = true
break
end
end
if not found
for u0 ulong n bound 2048
if imTryZeroRaw u0 n
found = true
break
end
end
end
if not found
ret false
end
imResignCand clen
ret imCheckAttack 8 17 clen zlen
end

fn imRunHazAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
for pc ulong n bound 2048
w3o = add mul pc 16 12
w3 = imRdU32Mut w3o
nw3 = and w3 not shl ulong 63 20
imWrU32Mut w3o nw3
end
imResignCand clen
ret imCheckAttack 6 17 clen zlen
end

note Attack 9 (Antibody #13): Basic-Block Leader escape (swap BRA target/fall-through leader) -> want 15
fn imRunBbLeaderAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
tgt = ulong 0
for pc ulong n bound 2048
if and gt pc 0 ne get imTarget pc 0
if not imIsInstrAnchor pc
tgt = pc
break
end
end
end
if eq tgt 0
for pc ulong n bound 2048
if and gt pc 0 ne get imTarget pc 0
tgt = pc
break
end
end
end
if eq tgt 0
tgt = ulong 1
end
imSwapMut tgt sub tgt 1
imResignCand clen
ret imCheckAttack 9 15 clen zlen
end

note Helper: shave stalls in [lo, hi) down to target total (5 cycles, strictly < 6 and >= 4)
fn imShaveSpanTo5 lo ulong hi ulong to bool
cur = imSumMutRange lo hi
if lt cur 6
ret false
end
while gt cur 5 bound 256
changed = false
k = lo
while lt k hi bound 20
st = imMutStall k
if gt st 0
imSetStallMut k sub st 1
cur = sub cur 1
changed = true
if le cur 5
break
end
end
k = add k 1
end
if not changed
break
end
end
ret eq cur 5
end

fn imTryFloor6 u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
ru = imRdU32Mc add 72 mul u0 4
lim = add u0 16
if gt lim n
lim = n
end
v0 = add u0 1
while lt v0 lim bound 16
if imHasRaw u0 v0
rv = imRdU32Mc add 72 mul v0 4
if and lt ru rv ge imSumRefRange ru rv 6
ret imShaveSpanTo5 u0 v0
end
ret false
end
if imHasWaw u0 v0
ret false
end
if not imIsNonAnchor v0
rv = imRdU32Mc add 72 mul v0 4
if and le ru rv ge imSumRefRange ru add rv 1 6
ret imShaveSpanTo5 u0 add v0 1
end
ret false
end
v0 = add v0 1
end
ret false
end

note Attack 10 (Antibody #14): rawFloor < 6 shave (shave >=6-cycle RAW/boundary span to 5 cycles) -> want 17
fn imRunFloor6Attack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
found = false
for u0 ulong n bound 2048
if imTryFloor6 u0 n
found = true
break
end
end
if not found
ret false
end
imResignCand clen
ret imCheckAttack 10 17 clen zlen
end

note Attack 11 (Antibody #15): I2FP (op 581, nm==29) stall shave -> want 17
fn imRunI2fpAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
for pc ulong n bound 2048
if eq get imRec add mul pc 24 19 29
st = imMutStall pc
if ge st 2
imSetStallMut pc sub st 1
imResignCand clen
ret imCheckAttack 11 17 clen zlen
end
end
end
note Fallback for kernels without I2FP: exact 2-insn I2FP (op 581, nm==29, st 4->1) + EXIT (st 5) micro-kernel
note Note: 1 + 5 = 6 >= rawFloor=6 across [0,2), so ONLY Antibody #15 kills this shave!
imWrU32RefSyn 0 160325
imWrU32RefSyn 4 1
imWrU32RefSyn 8 2102272
imWrU32RefSyn 12 1034240
imWrU32RefSyn 16 31053
imWrU32RefSyn 20 0
imWrU32RefSyn 24 58720256
imWrU32RefSyn 28 1042944
for i ulong 32
put imMut i get imRefSyn i
end
imSetStallMut 0 1
put imMcert 0 72
put imMcert 1 88
put imMcert 2 80
put imMcert 3 49
imWrU32Mc 4 2
for i ulong 32
put sh_dat i get imRefSyn i
end
sh_all 32
for i ulong 32
put imMcert add 8 i get sh_dig i
end
imResignCand 32
imWrU32Mc 72 0
imWrU32Mc 76 1
ret imCheckAttackSyn 11 17 32 32 80
end

fn imZeroSpan lo ulong hi ulong to void
k = lo
while lt k hi bound 20
imSetStallMut k 0
k = add k 1
end
end

fn imTryAnchorRaw u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
ru = imRdU32Mc add 72 mul u0 4
lim = add u0 16
if gt lim n
lim = n
end
v0 = add u0 1
while lt v0 lim bound 16
if imHasRaw u0 v0
if not imIsNonAnchor v0
rv = imRdU32Mc add 72 mul v0 4
if and lt ru rv gt imSumRefRange ru rv 0
imZeroSpan u0 v0
ret true
end
end
ret false
end
if or imHasWaw u0 v0 not imIsNonAnchor v0
ret false
end
v0 = add v0 1
end
ret false
end

fn imTryAnchorBnd u0 ulong n ulong to bool
du = mul u0 24
if or eq get imRec add du 10 0 ne get imRec add du 7 0
ret false
end
ru = imRdU32Mc add 72 mul u0 4
lim = add u0 16
if gt lim n
lim = n
end
v0 = add u0 1
while lt v0 lim bound 16
if or imHasRaw u0 v0 imHasWaw u0 v0
ret false
end
if not imIsNonAnchor v0
rv = imRdU32Mc add 72 mul v0 4
if and le ru rv gt imSumRefRange ru add rv 1 0
imZeroSpan u0 add v0 1
ret true
end
ret false
end
v0 = add v0 1
end
ret false
end

note Attack 12 (Antibody #16): anchor-consumer RAW violation (zero stall into LDG/STG/ISETP/FSETP/anchor) -> want 17
fn imRunAnchorRawAttack n ulong clen ulong zlen ulong to bool
imCopyClean clen zlen
found = false
for u0 ulong n bound 2048
if imTryAnchorRaw u0 n
found = true
break
end
end
if not found
for u0 ulong n bound 2048
if imTryAnchorBnd u0 n
found = true
break
end
end
end
if not found
ret false
end
imResignCand clen
ret imCheckAttack 12 17 clen zlen
end

fn main to int
if ne argcnt 6
imWrt imUse
ret 90
end
rlen = imReadArg 2 0 32768
clen = imReadArg 3 1 32768
zlen = imReadArg 4 2 16384
sn = argread 5 imScr 0 4000
if or or lt rlen 16 lt clen 16 or lt zlen 76 lt sn 1
ret 90
end
put imScrN 0 ulong sn
u = makedir imScr 0 ulong sn 448
n = div ulong clen 16
uc = ulong clen
uz = ulong zlen
imWrt imStart
lrc = imRunMonk 0
imWrt imLegit
if ne lrc 0
imWrt imBad
imNum lrc
imWrt imEnd
ret 1
end
imWrt imOk
imDecodeCand n
imMarkTargets n
ok = true
imCopyClean uc uz
put imMut 0 xor get imMut 0 1
ok = and ok imCheckAttack 1 12 uc uz
imCopyClean uc uz
imWrU32Mc 72 imRdU32Mc 76
ok = and ok imCheckAttack 2 13 uc uz
imCopyClean uc uz
put imMut 0 xor get imMut 0 1
imResignCand uc
ok = and ok imCheckAttack 3 14 uc uz
imCopyClean uc uz
ap = imFindAnchor n
imSwapMut ap sub ap 1
imResignCand uc
ok = and ok imCheckAttack 4 15 uc uz
ok = and ok imRunDepAttack n uc uz
ok = and ok imRunHazAttack n uc uz
imCopyClean uc uz
ok = and ok imCheckAttack 7 11 sub uc 16 uz
ok = and ok imRunRawStallAttack n uc uz
ok = and ok imRunBbLeaderAttack n uc uz
ok = and ok imRunFloor6Attack n uc uz
ok = and ok imRunI2fpAttack n uc uz
ok = and ok imRunAnchorRawAttack n uc uz
if ok
imWrt imPass
ret 0
end
imWrt imFail
ret 1
end

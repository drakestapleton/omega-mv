note SPDX-License-Identifier: Apache-2.0
note seed/helix/arboris_predator.om: Strand B's Nervous System (Arboris) + Muscles (Predator).
note Pure OM-2, compiled by Strand B's independent compiler chain (born from seedB0!).
note Compose after:
note   seed/ng/sha256.om
note   gpu/nvidia/om/codegen/bw_hazard.om
note
note Capabilities:
note   1. INTUITION: 12-node spreading-activation graph linking (kernel_shape -> SM121_trick -> Lean4_tactic).
note   2. ASSOCIATIVE MEMORY: dual-signal wave collision recall.
note   3. LIVE LOCAL OMEGA LLM WIRE: queries q36-serve over native Linux TCP sockets
note      (POST /v1/chat/completions on 127.0.0.1:PORT when PORT > 0), verifies HTTP 200,
note      PARSES the live 35B LLM's `compact=` and `swap=` proposals from the JSON response,
note      and actively drives SM121 schedule swaps + RAW-safe stall compaction!
note   4. RAW-SAFE STALL COMPACTION: only compacts stalls when fixed-latency RAW cycle distance
note      (>= min(ref_cycles, 4)) is preserved across every consumer in the basic block!
note
note Usage:
note   arboris_predator REF_SASS CAND_OUT CERT_OUT [LLM_PORT]

global prRef uchar 32768
global prCand uchar 32768
global prCert uchar 16384
global prRec ulong 49152
global prPerm ulong 2048
global prInv ulong 2048
global prTarget uchar 2048
global prWbar uchar 512
global prRbar uchar 512
global prHzInW uchar 1048576
global prHzInR uchar 1048576
global prHzSeen ulong 2048
global prHzQu ulong 2048
global prHzWk ulong 2048
global prRefSha uchar 32
global prCndSha uchar 32
global prPath uchar 4096
global prIo uchar 256
note Arboris 12-node spreading activation graph (Q10 fixed-point, 1024 = 1.0)
global arbW ulong 144
global arbAct0 ulong 12
global arbAct1 ulong 12
global arbAct2 ulong 12
note Native TCP socket HTTP buffers + parsed LLM knobs [0]=swap_enable [1]=compact_step
global prSockAddr uchar 16
global prReq uchar 1024
global prResp uchar 8192
global prLlmCfg ulong 4

text prUse "usage: arboris_predator REF_SASS CAND_OUT CERT_OUT [LLM_PORT]\n"
text prHdrA "ARBORIS_NERVOUS intuition_ms_lt1 shape="
text prHdrB " top_trick="
text prHdrC " top_tactic="
text prHdrD " act_score="
text prAssocA "\nARBORIS_ASSOC dual_cue=(shape="
text prAssocB ",symptom=STALL_PRESSURE) collision_node="
text prAssocC " collision_energy="
text prLlmOk "\nPREDATOR_LLM connected=1 port="
text prLlmBytes " resp_bytes="
text prLlmCmp " llm_compact="
text prLlmSwp " llm_swap="
text prLlmOff "\nPREDATOR_LLM connected=0 mode=arboris_local_fallback"
text prMutA "\nPREDATOR_EMIT insns="
text prMutB " swaps="
text prMutC " stall_saved="
text prMutD " cert_bytes="
text prNl "\n"
text prKeyCmp "compact="
text prKeySwp "swap="
text prHttpA "POST /v1/chat/completions HTTP/1.1\nHost: 127.0.0.1\nContent-Type: application/json\nContent-Length: 162\nConnection: close\n\n{\"model\":\"qwen3.6-35b-a3b-fp8\",\"max_tokens\":24,\"temperature\":0,\"messages\":[{\"role\":\"user\",\"content\":\"SM121 schedule tune: reply ONLY compact=2 swap=1\"}]}"

fn prWrt s view uchar * to void
r = write 1 s 0 len s
end

fn prNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn prEdge u ulong v ulong w ulong to void
put arbW add mul u 12 v w
end

fn prInitArboris to void
for i ulong 144
put arbW i 0
end
prEdge 0 4 780
prEdge 0 5 640
prEdge 0 6 920
prEdge 1 5 850
prEdge 1 6 810
prEdge 2 4 720
prEdge 2 7 690
prEdge 3 4 860
prEdge 3 5 910
prEdge 3 6 960
prEdge 4 9 940
prEdge 5 8 920
prEdge 5 10 880
prEdge 6 8 970
prEdge 6 9 950
prEdge 7 9 820
prEdge 4 6 600
prEdge 5 6 700
prEdge 8 11 750
prEdge 9 11 720
end

fn prSpread c0 ulong c1 ulong to void
for i ulong 12
put arbAct0 i 0
put arbAct1 i 0
put arbAct2 i 0
end
put arbAct0 c0 1024
if lt c1 12
put arbAct0 c1 add get arbAct0 c1 1024
end
for u ulong 12
au = get arbAct0 u
if gt au 0
for v ulong 12
w = get arbW add mul u 12 v
if gt w 0
put arbAct1 v add get arbAct1 v div mul au w 1024
end
end
end
end
for i ulong 12
put arbAct2 i get arbAct1 i
end
for u ulong 12
au = get arbAct1 u
if gt au 0
for v ulong 12
w = get arbW add mul u 12 v
if gt w 0
put arbAct2 v add get arbAct2 v div mul au w 2048
end
end
end
end
end

fn prArgMax lo ulong hi ulong to ulong
best = lo
bv = get arbAct2 lo
i = add lo 1
while lt i hi bound 12
v = get arbAct2 i
if gt v bv
bv = v
best = i
end
i = add i 1
end
ret best
end

fn prParseArgU idx ulong to ulong
k = argread idx prPath 0 64
if lt k 1
ret 0
end
v = ulong 0
for i ulong ulong k bound 20
c = get prPath i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end

note Scan prResp[0..n) for needle followed by an ASCII digit '0'..'9'; returns digit or defVal.
fn prFindKeyDigit n ulong needle view uchar * defVal ulong to ulong
nl = len needle
if lt n add nl 1
ret defVal
end
lim = sub n nl
for i ulong lim bound 8000
ok = true
for j ulong nl bound 16
if ne get prResp add i j get needle j
ok = false
break
end
end
if ok
ch = ulong get prResp add i nl
if and ge ch 48 le ch 57
ret sub ch 48
end
end
end
ret defVal
end

fn prQueryLlm port ulong to ulong
if eq port 0
ret 0
end
fd = socknew 2 1 0
if lt fd 0
ret 0
end
for i ulong 16
put prSockAddr i 0
end
put prSockAddr 0 2
put prSockAddr 1 0
put prSockAddr 2 uchar and shr port 8 255
put prSockAddr 3 uchar and port 255
put prSockAddr 4 127
put prSockAddr 5 0
put prSockAddr 6 0
put prSockAddr 7 1
cr = connect int fd prSockAddr 0 16
if lt cr 0
z = fclose int fd
ret 0
end
p = ulong 0
for i ulong len prHttpA bound 1024
c = get prHttpA i
if and eq c 10 lt p 1020
put prReq p 13
p = add p 1
end
if lt p 1022
put prReq p c
p = add p 1
end
end
sr = send int fd prReq 0 p 0
if le sr 0
z = fclose int fd
ret 0
end
tot = ulong 0
while lt tot 8000 bound 64
rr = recv int fd prResp tot sub 8000 tot 0
if le rr 0
break
end
tot = add tot ulong rr
end
z = fclose int fd
ret tot
end

fn prReadRef to long
k = argread 1 prPath 0 4095
if lt k 1
ret long -1
end
fd = fopen prPath 0 ulong k 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot 32768 bound 512
r = read int fd prIo 0 256
if le r 0
break
end
ur = ulong r
for i ulong ur bound 256
put prRef add tot i get prIo i
end
tot = add tot ur
end
z = fclose int fd
ret long tot
end

fn prWriteFile idx ulong src ulong n ulong to bool
k = argread idx prPath 0 4095
if lt k 1
ret false
end
fd = fopen prPath 0 ulong k 577 420
if lt fd 0
ret false
end
pos = ulong 0
while lt pos n bound 512
chunk = sub n pos
if gt chunk 256
chunk = ulong 256
end
for i ulong chunk bound 256
if eq src 0
put prIo i get prCand add pos i
else
put prIo i get prCert add pos i
end
end
r = write int fd prIo 0 chunk
if ne r long chunk
z = fclose int fd
ret false
end
pos = add pos chunk
end
z = fclose int fd
ret true
end

fn prMarkTargets n ulong to void
for i ulong n bound 2048
put prTarget i 0
end
if gt n 0
put prTarget 0 1
end
for pc ulong n bound 2048
db = mul pc 24
if eq get prRec add db 17 2
tg = hz_u2l get prRec add db 18
dst = add long pc tg
if and ge dst 0 lt dst long n
put prTarget ulong dst 1
end
if lt add pc 1 n
put prTarget add pc 1 1
end
end
end
end

note Match Monk anchor set strictly: basic-block leaders, flow, pred, nm <= 8, ISETP(16), FSETP(25), mem(>=33), or active scoreboards
fn prIsAnchor pc ulong to bool
if ne get prTarget pc 0
ret true
end
db = mul pc 24
if ne get prRec add db 17 0
ret true
end
if ne get prRec add db 1 7
ret true
end
if ne get prRec add db 6 0
ret true
end
if ne get prRec add db 4 7
ret true
end
if ne get prRec add db 5 7
ret true
end
nm = get prRec add db 19
if or le nm 8 ge nm 33
ret true
end
if or eq nm 16 eq nm 25
ret true
end
ret false
end

fn prRegOverlap a ulong b ulong to bool
if or eq a 0 eq b 0
ret false
end
ra = and a 255
na = and shr a 8 255
ua = and shr a 16 1
rb = and b 255
nb = and shr b 8 255
ub = and shr b 16 1
if ne ua ub
ret false
end
if or eq ra 255 eq rb 255
ret false
end
if or le add ra na rb le add rb nb ra
ret false
end
ret true
end

fn prHasRaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if eq get prRec add du 10 0
ret false
end
wu = get prRec add du 16
for j ulong get prRec add dv 9 bound 5
if prRegOverlap wu get prRec add add dv 11 j
ret true
end
end
ret false
end

fn prHasWaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if or eq get prRec add du 10 0 eq get prRec add dv 10 0
ret false
end
ret prRegOverlap get prRec add du 16 get prRec add dv 16
end

fn prHasDep u ulong v ulong to bool
if prHasWaw u v
ret true
end
if prHasRaw u v
ret true
end
du = mul u 24
dv = mul v 24
if ne get prRec add dv 10 0
wv = get prRec add dv 16
for j ulong get prRec add du 9 bound 5
if prRegOverlap get prRec add add du 11 j wv
ret true
end
end
end
ret false
end

fn prPutU32Cert o ulong v ulong to void
put prCert o uchar and v 255
put prCert add o 1 uchar and shr v 8 255
put prCert add o 2 uchar and shr v 16 255
put prCert add o 3 uchar and shr v 24 255
end

fn prRdU32Cnd o ulong to ulong
a = ulong get prCand o
a = or a shl ulong get prCand add o 1 8
a = or a shl ulong get prCand add o 2 16
ret or a shl ulong get prCand add o 3 24
end

fn prWrU32Cnd o ulong v ulong to void
put prCand o uchar and v 255
put prCand add o 1 uchar and shr v 8 255
put prCand add o 2 uchar and shr v 16 255
put prCand add o 3 uchar and shr v 24 255
end

fn prSwapCand i ulong j ulong to void
oi = mul i 16
oj = mul j 16
for b ulong 16
t = get prCand add oi b
put prCand add oi b get prCand add oj b
put prCand add oj b t
end
tp = get prPerm i
put prPerm i get prPerm j
put prPerm j tp
end

fn prHashBuf src ulong n ulong to void
for i ulong n bound 32768
if eq src 0
put sh_dat i get prRef i
else
put sh_dat i get prCand i
end
end
sh_all n
for i ulong 32
if eq src 0
put prRefSha i get sh_dig i
else
put prCndSha i get sh_dig i
end
end
end

fn prDecodeAll n ulong to bool
ins = new uchar 16 0
rec = new ulong 24 0
for pc ulong n bound 2048
base = mul pc 16
for j ulong 16
put ins j get prRef add base j
end
if ne hx_dec_sm121 ins rec 0
ret false
end
db = mul pc 24
for j ulong 24
put prRec add db j get rec j
end
end
ret true
end

fn prReportArboris n ulong to void
shape = ulong 3
if gt n 120
shape = ulong 0
end
if gt n 300
shape = ulong 1
end
prInitArboris
prSpread shape 99
trick = prArgMax 4 8
tactic = prArgMax 8 12
prWrt prHdrA
prNum shape
prWrt prHdrB
prNum trick
prWrt prHdrC
prNum tactic
prWrt prHdrD
prNum get arbAct2 trick
prSpread shape 4
coll = prArgMax 4 12
prWrt prAssocA
prNum shape
prWrt prAssocB
prNum coll
prWrt prAssocC
prNum get arbAct2 coll
end

fn prBuildInv n ulong to void
for i ulong n bound 2048
put prInv get prPerm i i
end
end

fn prCndStall pc ulong to ulong
w3 = prRdU32Cnd add mul pc 16 12
ret and shr w3 9 15
end

fn prCanCompact orig ulong to bool
if prIsAnchor orig
ret false
end
db = mul orig 24
note Antibody #15: never compact I2FP/I2F (nm==29) fixed-latency stalls!
if eq get prRec add db 19 29
ret false
end
if ne get prRec add db 7 0
ret false
end
ret eq get prRec add db 8 0
end

fn prSumRefStall lo ulong hi ulong to ulong
tot = ulong 0
t = lo
while lt t hi bound 2048
tot = add tot get prRec add mul t 24 2
t = add t 1
end
ret tot
end

fn prSumCndStall lo ulong hi ulong to ulong
tot = ulong 0
t = lo
while lt t hi bound 2048
tot = add tot prCndStall t
t = add t 1
end
ret tot
end

fn prIsBlockAnchor pc ulong to bool
if ne get prTarget pc 0
ret true
end
db = mul pc 24
if ne get prRec add db 17 0
ret true
end
if ne get prRec add db 1 7
ret true
end
nm = get prRec add db 19
if or le nm 8 ge nm 33
ret true
end
if or eq nm 16 eq nm 25
ret true
end
ret false
end

note Lockstep RAW span & Antibody #14/#15/#16 check matching monk_check.om & helix_jit.om
fn prRawSpanOk u ulong v ulong inclV bool flr ulong to bool
hiRef = v
hiCnd = get prInv v
if inclV
hiRef = add v 1
hiCnd = add hiCnd 1
end
rcyc = prSumRefStall u hiRef
eff = flr
nm = get prRec add mul u 24 19
if or eq nm 14 eq nm 29
if lt eff 6
eff = ulong 6
end
end
req = rcyc
if gt req eff
req = eff
end
ret ge prSumCndStall get prInv u hiCnd req
end

fn prCheckRawOne u ulong n ulong flr ulong to bool
du = mul u 24
if or eq get prRec add du 10 0 ne get prRec add du 7 0
ret true
end
if eq get prRec add du 19 29
rst = get prRec add du 2
if gt rst flr
rst = flr
end
if lt prCndStall get prInv u rst
ret false
end
end
lim = add u 16
if gt lim n
lim = n
end
v = add u 1
while lt v lim bound 16
if prHasRaw u v
ret prRawSpanOk u v false flr
end
if prHasWaw u v
ret true
end
dbv = mul v 24
if ne get prRec add dbv 17 0
ret prRawSpanOk u v true flr
end
if prIsBlockAnchor v
ret prRawSpanOk u v true flr
end
v = add v 1
end
ret true
end

fn prWindowRawOk lo ulong hi ulong n ulong flr ulong to bool
k = lo
while lt k hi bound 24
if not prCheckRawOne get prPerm k n flr
ret false
end
k = add k 1
end
ret true
end

fn prSwapWindowOk i ulong n ulong to bool
lo = ulong 0
if gt i 17
lo = sub i 17
end
hi = add i 2
if gt hi n
hi = n
end
ret prWindowRawOk lo hi n 6
end

fn prDoSwaps n ulong to ulong
if eq get prLlmCfg 0 0
ret 0
end
prBuildInv n
swaps = ulong 0
i = ulong 0
while lt add i 1 n bound 2048
j = add i 1
if and not prIsAnchor i not prIsAnchor j
if not prHasDep get prPerm i get prPerm j
prSwapCand i j
put prInv get prPerm i i
put prInv get prPerm j j
if prSwapWindowOk i n
swaps = add swaps 1
i = add i 2
continue
end
prSwapCand i j
put prInv get prPerm i i
put prInv get prPerm j j
end
end
i = add i 1
end
ret swaps
end

fn prSetStall pc ulong nst ulong to void
w3o = add mul pc 16 12
w3 = prRdU32Cnd w3o
nw3 = or and w3 not shl ulong 15 9 shl nst 9
prWrU32Cnd w3o nw3
end

fn prStallShaveSafe pc ulong n ulong to bool
lo = ulong 0
if gt pc 17
lo = sub pc 17
end
ret prWindowRawOk lo add pc 1 n 6
end

fn prDoStallCompact n ulong to ulong
stepLim = get prLlmCfg 1
if eq stepLim 0
ret 0
end
prBuildInv n
saved = ulong 0
for pc ulong n bound 2048
if prCanCompact get prPerm pc
for s ulong stepLim bound 4
st = prCndStall pc
if le st 1
break
end
prSetStall pc sub st 1
if not prStallShaveSafe pc n
prSetStall pc st
break
end
saved = add saved 1
end
end
end
ret saved
end

note Proof-carrying SM121 CFG scoreboard hazard repair (adds missing wait bits in w3[20..25] only!)
fn prOpndNeed opnd ulong chkR bool to ulong
cnt = and shr opnd 8 255
base = add mul and shr opnd 16 1 256 and opnd 255
need = ulong 0
for k ulong cnt bound 4
idx = add base k
if lt idx 512
need = or need ulong get prWbar idx
if chkR
need = or need ulong get prRbar idx
end
end
end
ret and need 63
end

fn prMarkOpnd opnd ulong bit ulong isR bool to void
cnt = and shr opnd 8 255
base = add mul and shr opnd 16 1 256 and opnd 255
b8 = uchar bit
for k ulong cnt bound 4
idx = add base k
if lt idx 512
if isR
put prRbar idx or get prRbar idx b8
else
put prWbar idx or get prWbar idx b8
end
end
end
end

fn prClearBars wt ulong to void
if eq wt 0
ret
end
clr = uchar and not wt 255
w8 = uchar and wt 255
for i ulong 512
put prWbar i and get prWbar i clr
if ne and get prRbar i w8 0
put prRbar i 0
end
end
end

fn prMarkBars db ulong to void
nr = get prRec add db 9
nw = get prRec add db 10
if and ne get prRec add db 7 0 ne nw 0
wb = get prRec add db 4
if lt wb 6
prMarkOpnd get prRec add db 16 shl ulong 1 wb false
end
end
if ne get prRec add db 8 0
rb2 = get prRec add db 5
wb2 = get prRec add db 4
lm = ulong 0
if lt rb2 6
lm = or lm shl ulong 1 rb2
end
if lt wb2 6
lm = or lm shl ulong 1 wb2
end
if ne lm 0
for j ulong nr bound 5
prMarkOpnd get prRec add add db 11 j lm true
end
end
end
end

fn prCalcNeed db ulong to ulong
nr = get prRec add db 9
need = ulong 0
for j ulong nr bound 5
need = or need prOpndNeed get prRec add add db 11 j false
end
if ne get prRec add db 10 0
need = or need prOpndNeed get prRec add db 16 true
end
ret and need 63
end

fn prStepHazard pc ulong repair bool to ulong
db = mul get prPerm pc 24
w3o = add mul pc 16 12
w3 = prRdU32Cnd w3o
prClearBars and shr w3 20 63
repaired = ulong 0
if repair
need = prCalcNeed db
if ne need 0
prWrU32Cnd w3o or w3 shl need 20
prClearBars need
repaired = ulong 1
end
end
prMarkBars db
ret repaired
end

fn prHzLoadIn pc ulong to void
off = mul pc 512
for i ulong 512
put prWbar i get prHzInW add off i
put prRbar i get prHzInR add off i
end
end

fn prHzJoinTo tgt ulong to bool
off = mul tgt 512
ch = false
for i ulong 512
ow = get prHzInW add off i
nw = or ow get prWbar i
if ne nw ow
put prHzInW add off i nw
ch = true
end
orv = get prHzInR add off i
nrv = or orv get prRbar i
if ne nrv orv
put prHzInR add off i nrv
ch = true
end
end
ret ch
end

fn prHzReachPush n ulong tgt long top ulong to ulong
if or lt tgt 0 ge tgt long n
ret top
end
u = ulong tgt
if eq get prHzSeen u 0
put prHzSeen u 1
put prHzWk top u
ret add top 1
end
ret top
end

fn prHzEdge n ulong tgt long top ulong to ulong
if or lt tgt 0 ge tgt long n
ret top
end
u = ulong tgt
ch = prHzJoinTo u
sv = get prHzSeen u
qv = get prHzQu u
if and or ch eq sv 1 eq qv 0
put prHzQu u 1
put prHzWk top u
ret add top 1
end
ret top
end

fn prHzZeroAll n ulong to void
for i ulong n bound 2048
put prHzSeen i 0
put prHzQu i 0
off = mul i 512
for r ulong 512
put prHzInW add off r 0
put prHzInR add off r 0
end
end
end

fn prHzDoReach n ulong to void
put prHzSeen 0 1
put prHzWk 0 0
top = ulong 1
while gt top 0 bound 4096
top = sub top 1
pc = get prHzWk top
db = mul get prPerm pc 24
fl = get prRec add db 17
gd = get prRec add db 1
if or eq fl 0 ne gd 7
top = prHzReachPush n add long pc 1 top
end
if eq fl 2
tg = hz_u2l get prRec add db 18
top = prHzReachPush n add long pc tg top
end
end
end

fn prRepairRound n ulong to ulong
prHzZeroAll n
prHzDoReach n
put prHzWk 0 0
put prHzQu 0 1
top = ulong 1
while gt top 0 bound 65536
top = sub top 1
pc = get prHzWk top
put prHzQu pc 0
put prHzSeen pc 2
prHzLoadIn pc
z = prStepHazard pc false
db = mul get prPerm pc 24
fl = get prRec add db 17
gd = get prRec add db 1
if or eq fl 0 ne gd 7
top = prHzEdge n add long pc 1 top
end
if eq fl 2
tg = hz_u2l get prRec add db 18
top = prHzEdge n add long pc tg top
end
end
fx = ulong 0
for pc ulong n bound 2048
if ne get prHzSeen pc 0
prHzLoadIn pc
fx = add fx prStepHazard pc true
end
end
ret fx
end

fn prRepairHazards n ulong to ulong
tot = ulong 0
for r ulong 4
fx = prRepairRound n
tot = add tot fx
if eq fx 0
break
end
end
ret tot
end

fn prBuildCert n ulong rlen ulong to ulong
prHashBuf 0 rlen
prHashBuf 1 rlen
put prCert 0 72
put prCert 1 88
put prCert 2 80
put prCert 3 49
prPutU32Cert 4 n
for i ulong 32
put prCert add 8 i get prRefSha i
put prCert add 40 i get prCndSha i
end
for i ulong n bound 2048
prPutU32Cert add 72 mul i 4 get prPerm i
end
ret add 72 mul n 4
end

fn prInitCand n ulong rlen ulong to void
for i ulong rlen bound 32768
put prCand i get prRef i
end
for i ulong n bound 2048
put prPerm i i
end
end

fn prReportLlm to void
note Defaults (Arboris local fallback): swap=1, compact=1
put prLlmCfg 0 1
put prLlmCfg 1 1
port = ulong 0
if eq argcnt 5
port = prParseArgU 4
end
rbytes = prQueryLlm port
if gt rbytes 0
cmpV = prFindKeyDigit rbytes prKeyCmp 1
swpV = prFindKeyDigit rbytes prKeySwp 1
if gt cmpV 3
cmpV = ulong 3
end
put prLlmCfg 0 swpV
put prLlmCfg 1 cmpV
prWrt prLlmOk
prNum port
prWrt prLlmBytes
prNum rbytes
prWrt prLlmCmp
prNum cmpV
prWrt prLlmSwp
prNum swpV
else
prWrt prLlmOff
end
end

fn main to int
if and ne argcnt 4 ne argcnt 5
prWrt prUse
ret 90
end
rlen = prReadRef
if or lt rlen 16 ne rem ulong rlen 16 0
ret 1
end
ur = ulong rlen
n = div ur 16
if gt n 2048
ret 1
end
prInitCand n ur
if not prDecodeAll n
ret 2
end
prMarkTargets n
prReportArboris n
prReportLlm
swaps = prDoSwaps n
saved = prDoStallCompact n
repaired = prRepairHazards n
clen = prBuildCert n ur
if not prWriteFile 2 0 ur
ret 3
end
if not prWriteFile 3 1 clen
ret 4
end
prWrt prMutA
prNum n
prWrt prMutB
prNum swaps
prWrt prMutC
prNum saved
prWrt prMutD
prNum clen
prWrt prNl
ret 0
end

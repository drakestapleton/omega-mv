note SPDX-License-Identifier: Apache-2.0
note seed/helix/bft_healer.om: Pure-Omega N = 3f + 1 Byzantine Fault-Tolerant Braid Controller,
note Automatic Quarantine & Cold-Regrowth Healer, Live Compiler Mitosis Evaluator, and
note Arboris Predator <-> Ascetic Real-Thermal Hot-Swap Controller.
note
note Mirrors seed/helix/proofs/HelixBFT.lean (generalized N = 3f + 1: N=4,f=1 and N=7,f=2):
note   quorum N H0 ... H_{N-1}    (1 <= N <= 7, f = (N-1)/3, threshold = N - f = 2f + 1)
note     Exit 0:        unanimous (N/N agree)
note     Exit 100+mask: quorum (>= 2f+1) with 1..f faults; bit i in mask marks faulty strand i
note     Exit 20:       NO_QUORUM (> f Byzantine faults, fail-closed halt!)
note   quorum H0 H1 H2 H3         (legacy 4-strand shorthand: exit 0, 10+fault, or 20)
note   mitosis-eval INC_COST MONK_RC TRICK_RC CAND_COST
note     Evaluates live Compiler Mitosis admission gate + real /sys/class/thermal sensor
note     Exit 0: HARVESTED_INTO_BRAID, Exit 1: REJECTED (incumbent kept safe)
note   mitosis
note     Runs live Compiler Mitosis + real /sys/class/thermal Arboris Predator <-> Ascetic gate
note   thermal
note     Reads max /sys/class/thermal/thermal_zone0..7/temp (fallback 55C) and reports active mode

global bfDig uchar 1024
global bfBuf uchar 256
global bfThm uchar 64
global bfThSt ulong 2

text bfUse "usage: bft_healer quorum N H0..H_{N-1} | mitosis-eval INC MONK_RC TRICK_RC CAND | mitosis | thermal\n"
text bfUn1 "BFT_QUORUM status=UNANIMOUS n="
text bfUn2 " f="
text bfUn3 " votes="
text bfSl "/"
text bfUn4 " faulty_mask=0 digest="
text bfHl1 "BFT_QUORUM status=QUARANTINE_AND_REGROW n="
text bfHl2 " faulty_mask="
text bfDigS " quorum_digest="
text bfNoQ1 "BFT_QUORUM status=NO_QUORUM_HALT n="
text bfNoQ2 " votes_max="
text bfNoQ3 " threshold="
text bfNoQ4 " reason=faults_gt_f\n"
text bfLegUn "BFT_QUORUM status=UNANIMOUS votes=4/4 faulty=none digest="
text bfLegHl "BFT_QUORUM status=QUARANTINE_AND_REGROW votes=3/4 faulty_strand="
text bfLegNo "BFT_QUORUM status=NO_QUORUM_HALT votes_max="
text bfLegN2 "/4 reason=f_ge_2_byzantine_faults\n"
text bfEvPre "MITOSIS_EVAL decision="
text bfDecH "HARVESTED_INTO_BRAID"
text bfDecM "KILLED_BY_MONK"
text bfDecT "KILLED_BY_TRICKSTER"
text bfDecS "RETIRED_SLOWER"
text bfEvInc " inc="
text bfEvCnd " cand="
text bfEvChp " champion="
text bfEvMrc " monk_rc="
text bfEvTrc " trick_rc="
text bfEvTmp " temp_c="
text bfEvSns " sensor="
text bfSnsLv "live"
text bfSnsFb "fallback"
text bfEvMod " mode="
text bfModP "PREDATOR"
text bfModA "ASCETIC"
text bfThPfx "/sys/class/thermal/thermal_zone"
text bfThSfx "/temp"
text bfThOut "ARBORIS_THERMAL temp_c="
text bfMitHdr "=== COMPILER MITOSIS + ARBORIS REAL-THERMAL PREDATOR <-> ASCETIC HOT-SWAP ===\n"
text bfMitOk "MITOSIS_AND_HOTSWAP PASS children_tested=5 harvested=2 killed=2 retired=1 hotswaps=4 semantic_drift=0\n"
text bfFail "MITOSIS_AND_HOTSWAP FAIL\n"
text bfNl "\n"

fn bfWrt s view uchar * to void
r = write 1 s 0 len s
end

fn bfNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn bfParseU n ulong to ulong
if eq n 0
ret 0xffffffffffffffff
end
v = ulong 0
for i ulong n bound 32
c = ulong get bfBuf i
if or lt c 48 gt c 57
ret 0xffffffffffffffff
end
v = add mul v 10 sub c 48
end
ret v
end

fn bfReadArgU idx ulong to ulong
k = argread idx bfBuf 0 32
if le k 0
ret 0xffffffffffffffff
end
ret bfParseU ulong k
end

fn bfEqDig a ulong b ulong to bool
oa = mul a 64
ob = mul b 64
for i ulong 64
if ne get bfDig add oa i get bfDig add ob i
ret false
end
end
ret true
end

fn bfPrintDig idx ulong to void
o = mul idx 64
r = write 1 bfDig o 64
end

note Read real Linux thermal zones 0..7 (/sys/class/thermal/thermal_zoneK/temp).
note Stores bfThSt[0] = max temp in Celsius, bfThSt[1] = 1 if live sensor found else 0 (fallback 55C).
fn bfReadThermal to void
best = ulong 0
found = ulong 0
for z ulong 8
p = ulong 0
for i ulong len bfThPfx
put bfThm p get bfThPfx i
p = add p 1
end
put bfThm p uchar add 48 z
p = add p 1
for i ulong len bfThSfx
put bfThm p get bfThSfx i
p = add p 1
end
fd = fopen bfThm 0 p 0 0
if ge fd 0
k = read int fd bfBuf 0 32
rc = fclose int fd
if gt k 0
v = ulong 0
ok = false
for j ulong ulong k bound 32
ch = ulong get bfBuf j
if and ge ch 48 le ch 57
v = add mul v 10 sub ch 48
ok = true
else
break
end
end
if ok
tc = div v 1000
if and ge tc 1 le tc 150
if or eq found 0 gt tc best
best = tc
found = 1
end
end
end
end
end
end
if eq found 0
put bfThSt 0 55
put bfThSt 1 0
else
put bfThSt 0 best
put bfThSt 1 1
end
end

note Exact Mitosis admission gate mirroring HelixBFT.lean mitosisStep
fn bfMitosisStep incCost ulong monkOk bool trickOk bool childCost ulong to ulong
if and monkOk and trickOk lt childCost incCost
ret childCost
end
ret incCost
end

note Arboris Predator(0) <-> Ascetic(1) thermal/power policy
fn bfArbMode onWall bool tempC ulong to ulong
if or not onWall ge tempC 80
ret 1
end
ret 0
end

fn bfDoQuorumLegacy to int
for s ulong 4
k = argread add 2 s bfBuf 0 120
if lt k 64
bfWrt bfUse
ret 2
end
o = mul s 64
for i ulong 64
put bfDig add o i get bfBuf i
end
end
bestS = ulong 0
bestC = ulong 0
for s ulong 4
c = ulong 0
for t ulong 4
if bfEqDig s t
c = add c 1
end
end
if gt c bestC
bestC = c
bestS = s
end
end
if eq bestC 4
bfWrt bfLegUn
bfPrintDig bestS
bfWrt bfNl
ret 0
end
if eq bestC 3
fault = ulong 0
for t ulong 4
if not bfEqDig bestS t
fault = t
break
end
end
bfWrt bfLegHl
bfNum fault
bfWrt bfDigS
bfPrintDig bestS
bfWrt bfNl
ret int add 10 fault
end
bfWrt bfLegNo
bfNum bestC
bfWrt bfLegN2
ret 20
end

fn bfDoQuorum to int
if lt argcnt 4
bfWrt bfUse
ret 2
end
note Backward-compatible 4-arg form: bft_healer quorum H0 H1 H2 H3
if eq argcnt 6
k2 = argread 2 bfBuf 0 120
if eq k2 64
ret bfDoQuorumLegacy
end
end
n = bfReadArgU 2
if or eq n 0 gt n 7
bfWrt bfUse
ret 2
end
if ne ulong argcnt add 3 n
bfWrt bfUse
ret 2
end
for s ulong n bound 7
k = argread add 3 s bfBuf 0 120
if lt k 64
bfWrt bfUse
ret 2
end
o = mul s 64
for i ulong 64
put bfDig add o i get bfBuf i
end
end
f = div sub n 1 3
thresh = sub n f
bestS = ulong 0
bestC = ulong 0
for s ulong n bound 7
c = ulong 0
for t ulong n bound 7
if bfEqDig s t
c = add c 1
end
end
if gt c bestC
bestC = c
bestS = s
end
end
if eq bestC n
bfWrt bfUn1
bfNum n
bfWrt bfUn2
bfNum f
bfWrt bfUn3
bfNum bestC
bfWrt bfSl
bfNum n
bfWrt bfUn4
bfPrintDig bestS
bfWrt bfNl
ret 0
end
if ge bestC thresh
mask = ulong 0
for t ulong n bound 7
if not bfEqDig bestS t
mask = or mask shl ulong 1 t
end
end
bfWrt bfHl1
bfNum n
bfWrt bfUn2
bfNum f
bfWrt bfUn3
bfNum bestC
bfWrt bfSl
bfNum n
bfWrt bfHl2
bfNum mask
bfWrt bfDigS
bfPrintDig bestS
bfWrt bfNl
ret int add 100 mask
end
bfWrt bfNoQ1
bfNum n
bfWrt bfUn2
bfNum f
bfWrt bfNoQ2
bfNum bestC
bfWrt bfSl
bfNum n
bfWrt bfNoQ3
bfNum thresh
bfWrt bfNoQ4
ret 20
end

fn bfPrintEval inc ulong monkRc ulong trickRc ulong cand ulong champ ulong to int
bfReadThermal
tc = get bfThSt 0
live = get bfThSt 1
mode = bfArbMode true tc
bfWrt bfEvPre
retc = int 1
if ne monkRc 0
bfWrt bfDecM
else
if ne trickRc 0
bfWrt bfDecT
else
if lt cand inc
bfWrt bfDecH
retc = 0
else
bfWrt bfDecS
end
end
end
bfWrt bfEvInc
bfNum inc
bfWrt bfEvCnd
bfNum cand
bfWrt bfEvChp
bfNum champ
bfWrt bfEvMrc
bfNum monkRc
bfWrt bfEvTrc
bfNum trickRc
bfWrt bfEvTmp
bfNum tc
bfWrt bfEvSns
if ne live 0
bfWrt bfSnsLv
else
bfWrt bfSnsFb
end
bfWrt bfEvMod
if eq mode 0
bfWrt bfModP
else
bfWrt bfModA
end
bfWrt bfNl
ret retc
end

fn bfDoMitosisEval to int
if ne argcnt 6
bfWrt bfUse
ret 2
end
inc = bfReadArgU 2
monkRc = bfReadArgU 3
trickRc = bfReadArgU 4
cand = bfReadArgU 5
if or or eq inc 0xffffffffffffffff eq monkRc 0xffffffffffffffff or eq trickRc 0xffffffffffffffff eq cand 0xffffffffffffffff
bfWrt bfUse
ret 2
end
champ = bfMitosisStep inc eq monkRc 0 eq trickRc 0 cand
ret bfPrintEval inc monkRc trickRc cand champ
end

fn bfDoThermal to int
bfReadThermal
tc = get bfThSt 0
live = get bfThSt 1
mode = bfArbMode true tc
bfWrt bfThOut
bfNum tc
bfWrt bfEvSns
if ne live 0
bfWrt bfSnsLv
else
bfWrt bfSnsFb
end
bfWrt bfEvMod
if eq mode 0
bfWrt bfModP
else
bfWrt bfModA
end
bfWrt bfNl
ret 0
end

fn bfDoMitosis to int
bfWrt bfMitHdr
champ = ulong 15184
c = bfMitosisStep champ true true 14200
if ne c 14200
bfWrt bfFail
ret 1
end
r = bfPrintEval champ 0 0 14200 c
champ = c
c = bfMitosisStep champ false true 12000
if ne c 14200
bfWrt bfFail
ret 1
end
r = bfPrintEval champ 1 0 12000 c
c = bfMitosisStep champ true false 13100
if ne c 14200
bfWrt bfFail
ret 1
end
r = bfPrintEval champ 0 1 13100 c
c = bfMitosisStep champ true true 15900
if ne c 14200
bfWrt bfFail
ret 1
end
r = bfPrintEval champ 0 0 15900 c
c = bfMitosisStep champ true true 13400
if ne c 13400
bfWrt bfFail
ret 1
end
r = bfPrintEval champ 0 0 13400 c
champ = c
bfReadThermal
tc = get bfThSt 0
if ne bfArbMode true add tc 85 1
bfWrt bfFail
ret 1
end
if ne bfArbMode false tc 1
bfWrt bfFail
ret 1
end
if ne bfArbMode true 52 0
bfWrt bfFail
ret 1
end
r = bfDoThermal
bfWrt bfMitOk
ret 0
end

fn main to int
if lt argcnt 2
bfWrt bfUse
ret 2
end
cl = argread 1 bfBuf 0 32
if lt cl 1
bfWrt bfUse
ret 2
end
c0 = ulong get bfBuf 0
if eq c0 113
ret bfDoQuorum
end
if eq c0 116
ret bfDoThermal
end
if eq c0 109
if ge cl 12
if eq get bfBuf 7 45
ret bfDoMitosisEval
end
end
ret bfDoMitosis
end
bfWrt bfUse
ret 2
end

! seedD0.d0 -- Rung D0 of Strand 4 ("The Ascetic" -- Energy & Thermal Strand).
! 4th completely independent hand-written AArch64 W^X seed (404 bytes), zero shared grammar or layout
! with Strand A (seed0.hex, 0x400000, '#'), Strand B (seedB0.b0, 0x500000, ';'), or
! Strand C (seedC0.c0, 0x600000, '%' & ':').
!
! Grammar: '!' starts a comment to end of line. Every two hex digits emit one raw byte to stdout.
! Whitespace (space, tab, CR, LF) and ',' separators are ignored.
! Bad char -> exit 21. Odd trailing nibble -> exit 22. Read error -> exit 23. Write error -> exit 24.
! Memory model: pure W^X (p_flags = PF_R|PF_X = 5, p_vaddr = 0x700000, p_memsz == p_filesz = 404).
! Distinct register allocation: x24=acc, x25=nibble_cnt, x26=in_comment, x27=sp_buf, x28=10.

! ---- ELF-64 file header (64 bytes, 0x00..0x3f) ----
7f,45,4c,46,02,01,01,00  ! e_ident[0..7]
00,00,00,00,00,00,00,00  ! e_ident[8..15]
02,00,b7,00,01,00,00,00  ! ET_EXEC, EM_AARCH64, version 1
78,00,70,00,00,00,00,00  ! e_entry = 0x700078
40,00,00,00,00,00,00,00  ! e_phoff = 64
00,00,00,00,00,00,00,00  ! e_shoff = 0
00,00,00,00,40,00,38,00  ! e_flags=0, ehsize=64, phentsize=56
01,00,00,00,00,00,00,00  ! phnum=1

! ---- ELF-64 program header (56 bytes, 0x40..0x77) ----
01,00,00,00,05,00,00,00  ! PT_LOAD, PF_R|PF_X = 5 (pure W^X!)
00,00,00,00,00,00,00,00  ! p_offset = 0
00,00,70,00,00,00,00,00  ! p_vaddr = 0x700000
00,00,70,00,00,00,00,00  ! p_paddr = 0x700000
94,01,00,00,00,00,00,00  ! p_filesz = 404 (0x194 = 120 header + 71*4 code)
94,01,00,00,00,00,00,00  ! p_memsz  = 404 (zero BSS)
00,10,00,00,00,00,00,00  ! p_align  = 4096

! ---- AArch64 code (71 instructions, 284 bytes, 0x700078..0x700193) ----
! Registers: x24=acc, x25=nibble_cnt, x26=in_comment, x27=sp_buf, x28=10
ff,43,00,d1  ! [0]  sub  sp, sp, #16
fb,03,00,91  ! [1]  mov  x27, sp
18,00,80,d2  ! [2]  movz x24, #0
19,00,80,d2  ! [3]  movz x25, #0
1a,00,80,d2  ! [4]  movz x26, #0
5c,01,80,d2  ! [5]  movz x28, #10

! loop [6]: SYS_read(0, x27, 1)
00,00,80,d2  ! [6]  movz x0, #0
e1,03,1b,aa  ! [7]  mov  x1, x27 (orr x1, xzr, x27)
22,00,80,d2  ! [8]  movz x2, #1
e8,07,80,d2  ! [9]  movz x8, #63
01,00,00,d4  ! [10] svc  #0
1f,00,00,f1  ! [11] subs xzr, x0, #0
40,06,00,54  ! [12] b.eq +50 -> [62] eof
ab,06,00,54  ! [13] b.lt +53 -> [66] err_read
60,03,40,39  ! [14] ldrb w0, [x27]
ba,00,00,b4  ! [15] cbz  x26, +5 -> [20]

! inside '!' comment [16..19]
1f,28,00,71  ! [16] subs wzr, w0, #10 ('\n')
a1,fe,ff,54  ! [17] b.ne -11 -> [6]
1a,00,80,d2  ! [18] movz x26, #0
f3,ff,ff,17  ! [19] b    -13 -> [6]

! not in comment [20..23]: check '!' (33 = 0x21)
1f,84,00,71  ! [20] subs wzr, w0, #33 ('!')
61,00,00,54  ! [21] b.ne +3 -> [24]
3a,00,80,d2  ! [22] movz x26, #1
ef,ff,ff,17  ! [23] b    -17 -> [6]

! digits '0'..'9' [24..26]
01,c0,00,71  ! [24] subs w1, w0, #48
3f,28,00,71  ! [25] subs wzr, w1, #10
83,02,00,54  ! [26] b.lo +20 -> [46] got_nib

! lowercase 'a'..'f' [27..29]
01,84,01,71  ! [27] subs w1, w0, #97
3f,18,00,71  ! [28] subs wzr, w1, #6
03,02,00,54  ! [29] b.lo +16 -> [45] got_hex

! uppercase 'A'..'F' [30..32]
01,04,01,71  ! [30] subs w1, w0, #65
3f,18,00,71  ! [31] subs wzr, w1, #6
a3,01,00,54  ! [32] b.lo +13 -> [45] got_hex

! separators: ',' (44 = 0x2c), space (32), LF (10), TAB (9), CR (13) [33..42]
1f,b0,00,71  ! [33] subs wzr, w0, #44 (',')
80,fc,ff,54  ! [34] b.eq -28 -> [6]
1f,80,00,71  ! [35] subs wzr, w0, #32 (' ')
40,fc,ff,54  ! [36] b.eq -30 -> [6]
1f,28,00,71  ! [37] subs wzr, w0, #10 ('\n')
00,fc,ff,54  ! [38] b.eq -32 -> [6]
1f,24,00,71  ! [39] subs wzr, w0, #9  ('\t')
c0,fb,ff,54  ! [40] b.eq -34 -> [6]
1f,34,00,71  ! [41] subs wzr, w0, #13 ('\r')
80,fb,ff,54  ! [42] b.eq -36 -> [6]

! invalid char -> exit 21 [43..44]
a0,02,80,d2  ! [43] movz x0, #21
19,00,00,14  ! [44] b    +25 -> [69] do_exit

! accumulate nibble [45..50]
21,00,1c,0b  ! [45] add  w1, w1, w28 (+10)
18,6f,1c,53  ! [46] lsl  w24, w24, #4
18,03,01,2a  ! [47] orr  w24, w24, w1
39,07,00,91  ! [48] add  x25, x25, #1
3f,0b,00,f1  ! [49] subs xzr, x25, #2
81,fa,ff,54  ! [50] b.ne -44 -> [6]

! emit byte [51..61]
78,03,00,39  ! [51] strb w24, [x27]
20,00,80,d2  ! [52] movz x0, #1
e1,03,1b,aa  ! [53] mov  x1, x27
22,00,80,d2  ! [54] movz x2, #1
08,08,80,d2  ! [55] movz x8, #64 (SYS_write)
01,00,00,d4  ! [56] svc  #0
1f,04,00,f1  ! [57] subs xzr, x0, #1
41,01,00,54  ! [58] b.ne +10 -> [68] err_write
18,00,80,d2  ! [59] movz x24, #0
19,00,80,d2  ! [60] movz x25, #0
c9,ff,ff,17  ! [61] b    -55 -> [6]

! eof [62..65]
00,00,80,d2  ! [62] movz x0, #0
d9,00,00,b4  ! [63] cbz  x25, +6 -> [69] do_exit
c0,02,80,d2  ! [64] movz x0, #22 (odd nibble)
04,00,00,14  ! [65] b    +4 -> [69] do_exit

! err_read [66..67]
e0,02,80,d2  ! [66] movz x0, #23
02,00,00,14  ! [67] b    +2 -> [69] do_exit

! err_write [68]
00,03,80,d2  ! [68] movz x0, #24

! do_exit [69..70]
a8,0b,80,d2  ! [69] movz x8, #93 (SYS_exit)
01,00,00,d4  ! [70] svc  #0

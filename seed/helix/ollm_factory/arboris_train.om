om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/arboris_train.om:
note Pure seeded OM-2 Arboris Training Nervous System for Omega LLM Closed-Loop RLVR & Specialists.
note
note Implements three real mechanisms over an explicit causal spreading-activation graph:
note   1. Causal Failure-Mode Curriculum: ingests per-family failure counts (`arith, branch, loop,
note      bits, digits, fold, select, count, scan, rewrite`) + compiler error / antibody signals,
note      propagates 2-hop sum-over-paths activation, and emits exact next-round RLVR family weights.
note   2. Preemptive Anti-Forgetting Rehearsal: tracks historical EMA mastery per skill family across
note      specialist generations; whenever a mastered family softens >= 50 milli-units (5%), injects
note      a targeted refresher slice BEFORE retention collapses (verified with positive & negative controls).
note   3. Adaptive Recurrence Depth Router (`NP in {1, 2, 3}`): maps problem difficulty + Arboris
note      activation + token entropy to optimal looped-core pass count against equal-compute baseline.

note Graph nodes (0..15):
note   0..9:  Bench skill families (0=arith, 1=branch, 2=loop, 3=bits, 4=digits,
note          5=fold, 6=select, 7=count, 8=scan, 9=rewrite)
note   10..15: Failure / compiler / antibody root-cause nodes:
note          10=omc_syntax_type, 11=noend_unclosed, 12=wrong_loop_bound,
note          13=bit_shift_mask, 14=array_inplace_oob, 15=sm121_antibody_raw

global atAdj ulong 256
global atAct ulong 16
global atNext ulong 16
global atFail ulong 10
global atWeight ulong 10
global atHist ulong 10
global atCurr ulong 10
global atRefr ulong 10

text atHdr "=== ARBORIS TRAINING NERVOUS SYSTEM (CURRICULUM + REHEARSAL + LOOP-DEPTH) ===\n"
text atCurA "ARBORIS_CURRICULUM top_family="
text atCurB " top_energy="
text atCurC " weights=["
text atCurSep ","
text atCurEnd "]\n"
text atRehA "ARBORIS_REHEARSAL alerts="
text atRehB " refresher_pct="
text atRehC " neg_ctrl_stable_alerts="
text atRehD "\n"
text atDepA "ARBORIS_LOOP_DEPTH routed_tasks="
text atDepB " np1="
text atDepC " np2="
text atDepD " np3="
text atDepE " avg_passes_x100="
text atDepF " savings_vs_fixed3_pct="
text atDepG "\n"
text atPass "ARBORIS_TRAIN PASS curriculum=1 rehearsal_pos_neg=1 adaptive_depth=1\n"

fn atWrt s view uchar * to void
r = write 1 s 0 len s
end

fn atNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn atEdge u ulong v ulong w ulong to void
put atAdj add mul u 16 v w
put atAdj add mul v 16 u w
end

fn atInitGraph to void
for i ulong 256
put atAdj i 0
end
note Connect skill families to shared causal failure modes (sum-over-paths graph)
atEdge 0 10 40
atEdge 1 11 45
atEdge 2 12 65
atEdge 3 13 70
atEdge 4 12 55
atEdge 5 12 60
atEdge 6 11 40
atEdge 7 12 45
atEdge 8 14 50
atEdge 9 14 80
atEdge 9 11 55
atEdge 2 15 35
atEdge 3 15 45
atEdge 5 14 35
atEdge 8 12 45
atEdge 4 10 30
end

fn atSpread hops ulong to void
for h ulong hops bound 8
for v ulong 16
s = get atAct v
for u ulong 16
w = get atAdj add mul u 16 v
if ne w 0
s = add s div mul get atAct u w 100
end
end
put atNext v s
end
for v ulong 16
put atAct v get atNext v
end
end
end

fn atParseArg idx ulong defVal ulong to ulong
b = new uchar 32 0
ac = ulong argcnt
if le ac idx
ret defVal
end
lr = argread idx b 0 32
if le lr 0
ret defVal
end
v = ulong 0
any = false
for i ulong ulong lr bound 32
c = get b i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
any = true
end
end
if not any
ret defVal
end
ret v
end

fn atRunCurriculum to ulong
for i ulong 16
put atAct i 0
end
note Ingest live per-family failure counts from argv[1..10] if provided, else base/ck6000.bin baseline (0/159):
note arith=19 branch=37 loop=15 bits=15 digits=9 fold=13 select=4 count=8 scan=7 rewrite=32
put atFail 0 atParseArg 1 19
put atFail 1 atParseArg 2 37
put atFail 2 atParseArg 3 15
put atFail 3 atParseArg 4 15
put atFail 4 atParseArg 5 9
put atFail 5 atParseArg 6 13
put atFail 6 atParseArg 7 4
put atFail 7 atParseArg 8 8
put atFail 8 atParseArg 9 7
put atFail 9 atParseArg 10 32
for f ulong 10
put atAct f mul get atFail f 10
end
note Inject observed compiler/bench failure cues: noend(33), wrong_loop(38), inplace_rewrite(24)
put atAct 11 330
put atAct 12 380
put atAct 14 240
atSpread 2
tot = ulong 0
topF = ulong 0
topE = ulong 0
for f ulong 10
e = get atAct f
tot = add tot e
if gt e topE
topE = e
topF = f
end
end
if eq tot 0
exit 11
end
for f ulong 10
put atWeight f div mul get atAct f 1000 tot
end
atWrt atCurA
atNum topF
atWrt atCurB
atNum topE
atWrt atCurC
for f ulong 10
if gt f 0
atWrt atCurSep
end
atNum get atWeight f
end
atWrt atCurEnd
ret topF
end

fn atCheckRehearsal thr ulong to ulong
alerts = ulong 0
for f ulong 10
h = get atHist f
c = get atCurr f
put atRefr f 0
if gt h c
drop = sub h c
if ge drop thr
put atRefr f add 50 div drop 2
alerts = add alerts 1
end
end
end
ret alerts
end

fn atRunRehearsal to bool
note Historical mastery (milli-pass-rate 0..1000) after Specialist P1 (OM-2 Systems)
for f ulong 10
put atHist f 600
put atCurr f 600
end
note Negative control: zero degradation -> MUST trigger 0 rehearsal alerts!
negAlerts = atCheckRehearsal 50
if ne negAlerts 0
ret false
end
note Positive test: while training Specialist P2 (SM121/Rewrite), arith (0) drops 600->510 and bits (3) drops 600->480
put atCurr 0 510
put atCurr 3 480
put atCurr 9 820
posAlerts = atCheckRehearsal 50
if ne posAlerts 2
ret false
end
totR = ulong 0
for f ulong 10
totR = add totR get atRefr f
end
note Refresher slice capped at 30% of next training batch
refPct = div totR 10
if gt refPct 30
refPct = 30
end
if lt refPct 10
ret false
end
atWrt atRehA
atNum posAlerts
atWrt atRehB
atNum refPct
atWrt atRehC
atNum negAlerts
atWrt atRehD
ret true
end

fn atRouteDepth diff ulong ent ulong to ulong
note Combine Arboris causal difficulty (0..100) + token entropy (0..100) -> looped core NP in {1, 2, 3}
score = add mul diff 6 mul ent 4
if lt score 350
ret 1
end
if lt score 700
ret 2
end
ret 3
end

fn atRunAdaptiveDepth to bool
n1 = ulong 0
n2 = ulong 0
n3 = ulong 0
totP = ulong 0
note Route 60 representative tasks across routine (25), medium (20), hard multi-step proofs/rewrites (15)
for i ulong 60
diff = ulong 20
ent = ulong 25
if ge i 25
diff = 55
ent = 50
end
if ge i 45
diff = 88
ent = 82
end
np = atRouteDepth diff ent
totP = add totP np
if eq np 1
n1 = add n1 1
else
if eq np 2
n2 = add n2 1
else
n3 = add n3 1
end
end
end
if or eq n1 0 or eq n2 0 eq n3 0
ret false
end
avgX100 = div mul totP 100 60
note Fixed NP=3 costs 180 passes across 60 tasks; compute % compute saved by adaptive exit!
if ge totP 180
ret false
end
savPct = div mul sub 180 totP 100 180
atWrt atDepA
atNum 60
atWrt atDepB
atNum n1
atWrt atDepC
atNum n2
atWrt atDepD
atNum n3
atWrt atDepE
atNum avgX100
atWrt atDepF
atNum savPct
atWrt atDepG
ret true
end

fn main to int
atWrt atHdr
atInitGraph
topF = atRunCurriculum
if not atRunRehearsal
exit 21
end
if not atRunAdaptiveDepth
exit 22
end
atWrt atPass
ret 0
end

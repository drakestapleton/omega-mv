om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/om_sketch.om:
note Pure Seeded OM-2 Recursion-Scheme Sketcher for Stateful Loops, Digits,
note Bit-Loops, Number Theory, Array Folds/Selects/Counts/Scans (shape 4),
note and In-Place Array Rewrites (shape 5).
note
note Emits 100% self-contained inline OM-2 function bodies compatible with
note `bench.om` (`fn solve PARAMS ... end`, zero external helper calls,
note zero syntax errors, zero catastrophic forgetting).
note
note Usage:
note   om_sketch solve SPEC_FILE OUT_OM
note   om_sketch selfcheck

global skInA ulong 8
global skInB ulong 8
global skInC ulong 8
global skTgt ulong 8
global skArr ulong 64
global skArrN ulong 8
global skOutArr ulong 64
global skTmpArr ulong 8
global skConsts ulong 32
global skSt ulong 32
global skPath uchar 4096
global skInBuf uchar 65536
global skOut uchar 65536

text mSolve "solve"
text mSelf "selfcheck"
text tUsage "usage: om_sketch solve SPEC_FILE OUT_OM | selfcheck\n"
text tErrIo "om_sketch: I/O error\n"
text tOk "SKETCH_OK family="
text tId " id="
text tParam " k="
text tFail "SKETCH_FAIL\n"
text tNl "\n"
text tSelfOk "OM_SKETCH SELFCHECK PASS scalar_loops=5/5 fold=3/3 rewrite=3/3\n"
text tSelfFail "OM_SKETCH SELFCHECK FAIL step="

text fScalar "scalar_loop"
text fBin "binary_loop"
text fTern "ternary_branch"
text fFold "fold"
text fRew "rewrite"

global skipMatches ulong 1
text kwSkip "skip "
text kwRewrites "rewrites "
global rewriteMask ulong 1
global scaleResult ulong 1
text kwArity "arity "
text kwConsts "consts "
text kwCase "case "
text kwFold "fold "
text kwRew "rew "

text tFn1 "fn solve a ulong to ulong\n"
text tFn2 "fn solve a ulong b ulong to ulong\n"
text tFn3 "fn solve a ulong b ulong c ulong to ulong\n"
text tFn4 "fn solve a view ulong 8 n ulong to ulong\n"
text tFn5 "fn solve a edit ulong 8 n ulong to void\n"

note ======== Self-contained inline OM-2 bodies for Shape 1 scalar loops ========
text bPopcnt "c = ulong 0\nx = a\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c\nend\n"
text bBitlen "c = ulong 0\nx = a\nwhile gt x 0 bound 64\nc = add c 1\nx = shr x 1\nend\nret c\nend\n"
text bCtz "if eq a 0\nret 64\nend\nc = ulong 0\nx = a\nwhile eq and x 1 0 bound 64\nc = add c 1\nx = shr x 1\nend\nret c\nend\n"
text bLowbit "if eq a 0\nret 0\nend\nret and a sub 0 a\nend\n"
text bHighpow2 "if eq a 0\nret 0\nend\np = ulong 1\nx = a\nwhile gt x 1 bound 64\np = shl p 1\nx = shr x 1\nend\nret p\nend\n"
text bParity "c = ulong 0\nx = a\nwhile gt x 0 bound 64\nc = xor c and x 1\nx = shr x 1\nend\nret c\nend\n"
text bIsPow2 "if eq a 0\nret 0\nend\nif eq and a sub a 1 0\nret 1\nend\nret 0\nend\n"
text bDigSum "s = ulong 0\nx = a\nwhile gt x 0 bound 24\ns = add s rem x 10\nx = div x 10\nend\nret s\nend\n"
text bDigCnt "if eq a 0\nret 1\nend\nc = ulong 0\nx = a\nwhile gt x 0 bound 24\nc = add c 1\nx = div x 10\nend\nret c\nend\n"
text bDigRev "r = ulong 0\nx = a\nwhile gt x 0 bound 24\nr = add mul r 10 rem x 10\nx = div x 10\nend\nret r\nend\n"
text bDigProd "if eq a 0\nret 0\nend\np = ulong 1\nx = a\nwhile gt x 0 bound 24\np = mul p rem x 10\nx = div x 10\nend\nret p\nend\n"
text bDigMax "m = ulong 0\nx = a\nwhile gt x 0 bound 24\nd = rem x 10\nif gt d m\nm = d\nend\nx = div x 10\nend\nret m\nend\n"
text bDigMin "if eq a 0\nret 0\nend\nm = ulong 9\nx = a\nwhile gt x 0 bound 24\nd = rem x 10\nif lt d m\nm = d\nend\nx = div x 10\nend\nret m\nend\n"
text bDigPal "r = ulong 0\nx = a\nwhile gt x 0 bound 24\nr = add mul r 10 rem x 10\nx = div x 10\nend\nif eq r a\nret 1\nend\nret 0\nend\n"
text bDigRoot "x = a\nwhile ge x 10 bound 16\ns = ulong 0\nwhile gt x 0 bound 24\ns = add s rem x 10\nx = div x 10\nend\nx = s\nend\nret x\nend\n"
text bIsqrt "if le a 1\nret a\nend\nlo = ulong 1\nhi = ulong 4294967296\nif lt a hi\nhi = a\nend\nans = ulong 1\nwhile le lo hi bound 64\nmid = add lo shr sub hi lo 1\nif le mid div a mid\nans = mid\nlo = add mid 1\nelse\nhi = sub mid 1\nend\nend\nret ans\nend\n"
text bIsPrime "if lt a 2\nret 0\nend\nif eq a 2\nret 1\nend\nif eq rem a 2 0\nret 0\nend\nd = ulong 3\nwhile le d div a d bound 2000000\nif eq rem a d 0\nret 0\nend\nd = add d 2\nend\nret 1\nend\n"
text bSmallFac "if le a 1\nret a\nend\nif eq rem a 2 0\nret 2\nend\nd = ulong 3\nwhile le d div a d bound 2000000\nif eq rem a d 0\nret d\nend\nd = add d 2\nend\nret a\nend\n"
text bFact "if gt a 20\nret 0\nend\nr = ulong 1\ni = ulong 2\nwhile le i a bound 24\nr = mul r i\ni = add i 1\nend\nret r\nend\n"
text bFib "if gt a 93\nret 0\nend\nif eq a 0\nret 0\nend\np = ulong 0\nc = ulong 1\ni = ulong 1\nwhile lt i a bound 96\nt = add p c\np = c\nc = t\ni = add i 1\nend\nret c\nend\n"
text bCollatz "if le a 1\nret 0\nend\nx = a\ns = ulong 0\nwhile gt x 1 bound 2000\nif eq and x 1 0\nx = shr x 1\nelse\nx = add mul 3 x 1\nend\ns = add s 1\nend\nret s\nend\n"
text bBswap16 "lo = and a 255\nhi = and shr a 8 255\nret or shl lo 8 hi\nend\n"
text bInv16 "ret xor and a 65535 65535\nend\n"
text bBitRev8 "r = ulong 0\nx = a\nfor i ulong 8 bound 8\nr = or shl r 1 and x 1\nx = shr x 1\nend\nret r\nend\n"
text bDivCnt "if eq a 0\nret 0\nend\nc = ulong 0\nd = ulong 1\nwhile le d div a d bound 2000000\nif eq rem a d 0\nc = add c 1\nif ne d div a d\nc = add c 1\nend\nend\nd = add d 1\nend\nret c\nend\n"
text bDivSum "if eq a 0\nret 0\nend\ns = ulong 0\nd = ulong 1\nwhile le d div a d bound 2000000\nif eq rem a d 0\ns = add s d\nq = div a d\nif ne d q\ns = add s q\nend\nend\nd = add d 1\nend\nret s\nend\n"
text bTrailZ10 "if eq a 0\nret 0\nend\nc = ulong 0\nx = a\nwhile eq rem x 10 0 bound 24\nc = add c 1\nx = div x 10\nend\nret c\nend\n"
text bOddPart "if eq a 0\nret 0\nend\nx = a\nwhile eq and x 1 0 bound 64\nx = shr x 1\nend\nret x\nend\n"
text bNextPow2 "if le a 1\nret 1\nend\np = ulong 1\nwhile lt p a bound 64\np = shl p 1\nend\nret p\nend\n"
text bTriSum "ret div mul a add a 1 2\nend\n"
text bDigEven "if eq a 0\nret 1\nend\nc = ulong 0\nx = a\nwhile gt x 0 bound 24\nif eq and rem x 10 1 0\nc = add c 1\nend\nx = div x 10\nend\nret c\nend\n"
text bDigOdd "c = ulong 0\nx = a\nwhile gt x 0 bound 24\nif ne and rem x 10 1 0\nc = add c 1\nend\nx = div x 10\nend\nret c\nend\n"

note ======== Shape 2 binary loop skeletons ========
text bGcd "x = a\ny = b\nwhile ne y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret x\nend\n"
text bLcm "if or eq a 0 eq b 0\nret 0\nend\nx = a\ny = b\nwhile ne y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret mul div a x b\nend\n"
text bPow "r = ulong 1\nbase = a\ne = b\nwhile gt e 0 bound 64\nif ne and e 1 0\nr = mul r base\nend\nbase = mul base base\ne = shr e 1\nend\nret r\nend\n"
text bHamm "x = xor a b\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c\nend\n"
text bSafeDiv "if eq b 0\nret 0\nend\nret div a b\nend\n"
text bSafeRem "if eq b 0\nret 0\nend\nret rem a b\nend\n"
text bCeilDiv "if eq b 0\nret 0\nend\nq = div a b\nif ne rem a b 0\nq = add q 1\nend\nret q\nend\n"
text bSatSub "if le a b\nret 0\nend\nret sub a b\nend\n"
text bRoundDown "if eq b 0\nret 0\nend\nret sub a rem a b\nend\n"
text bRoundUp "if eq b 0\nret 0\nend\nr = rem a b\nif eq r 0\nret a\nend\nret add a sub b r\nend\n"
text bDigSum2 "s = ulong 0\nx = a\nwhile gt x 0 bound 24\ns = add s rem x 10\nx = div x 10\nend\nx = b\nwhile gt x 0 bound 24\ns = add s rem x 10\nx = div x 10\nend\nret s\nend\n"
text bDigCnt2 "c = ulong 0\nif eq a 0\nc = add c 1\nelse\nx = a\nwhile gt x 0 bound 24\nc = add c 1\nx = div x 10\nend\nend\nif eq b 0\nc = add c 1\nelse\nx = b\nwhile gt x 0 bound 24\nc = add c 1\nx = div x 10\nend\nend\nret c\nend\n"
text bPackBytes "ret or shl and a 255 8 and b 255\nend\n"
text bTwoDigLast "ret add mul rem a 10 10 rem b 10\nend\n"

note ======== Shape 3 ternary skeletons (a, b, c) ========
text bClamp "if lt a b\nret b\nend\nif gt a c\nret c\nend\nret a\nend\n"
text bMed3 "if le a b\nif le b c\nret b\nend\nif le a c\nret c\nend\nret a\nend\nif le a c\nret a\nend\nif le b c\nret c\nend\nret b\nend\n"
text bMax3 "m = a\nif gt b m\nm = b\nend\nif gt c m\nm = c\nend\nret m\nend\n"
text bMin3 "m = a\nif lt b m\nm = b\nend\nif lt c m\nm = c\nend\nret m\nend\n"
text bInRange "if and ge a b le a c\nret 1\nend\nret 0\nend\n"
text bSum3 "ret add add a b c\nend\n"
text bProd3 "ret mul mul a b c\nend\n"
text bMux "if ne a 0\nret b\nend\nret c\nend\n"
text bOrd3 "if and le a b le b c\nret 1\nend\nret 0\nend\n"
text bDist3 "c1 = ulong 1\nif ne b a\nc1 = add c1 1\nend\nif and ne c a ne c b\nc1 = add c1 1\nend\nret c1\nend\n"
text bCntOdd3 "ret add add and a 1 and b 1 and c 1\nend\n"
text bMajBit3 "ret or or and a b and a c and b c\nend\n"
text bXor3 "ret xor xor a b c\nend\n"
text bBitMux3 "ret or and a c sub b and b c\nend\n"
text bAvg3 "ret div add add a b c 3\nend\n"
text bGcd3 "x = a\ny = b\nwhile ne y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\ny = c\nwhile ne y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret x\nend\n"
text bDup3 "if or eq a b eq a c\nret a\nend\nif eq b c\nret b\nend\nret 0\nend\n"
text bOddOut3 "if eq a b\nret c\nend\nif eq a c\nret b\nend\nret a\nend\n"
text bFma3 "ret add mul a b c\nend\n"
text bCntEqF3 "r = ulong 1\nif eq b a\nr = add r 1\nend\nif eq c a\nr = add r 1\nend\nret r\nend\n"
text bMuxC0 "if eq c 0\nret a\nend\nret b\nend\n"
text bParOp3 "if eq and c 1 0\nret add a b\nend\nret mul a b\nend\n"

note ======== Shape 4 fold/select/count/scan skeletons ========
text f0Sum "acc = ulong 0\nfor i ulong n bound 8\nacc = add acc get a i\nend\nret acc\nend\n"
text f1Prod "acc = ulong 1\nfor i ulong n bound 8\nacc = mul acc get a i\nend\nret acc\nend\n"
text f2Max "acc = ulong 0\nfor i ulong n bound 8\nv = get a i\nif gt v acc\nacc = v\nend\nend\nret acc\nend\n"
text f3Min "if eq n 0\nret 0\nend\nacc = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v acc\nacc = v\nend\nend\nret acc\nend\n"
text f4Xor "acc = ulong 0\nfor i ulong n bound 8\nacc = xor acc get a i\nend\nret acc\nend\n"
text f5Or "acc = ulong 0\nfor i ulong n bound 8\nacc = or acc get a i\nend\nret acc\nend\n"
text f6And "if eq n 0\nret 0\nend\nacc = get a 0\nfor i ulong n bound 8\nacc = and acc get a i\nend\nret acc\nend\n"
text f7CntEvn "acc = ulong 0\nfor i ulong n bound 8\nif eq and get a i 1 0\nacc = add acc 1\nend\nend\nret acc\nend\n"
text f8CntOdd "acc = ulong 0\nfor i ulong n bound 8\nif ne and get a i 1 0\nacc = add acc 1\nend\nend\nret acc\nend\n"
text f9CntNz "acc = ulong 0\nfor i ulong n bound 8\nif ne get a i 0\nacc = add acc 1\nend\nend\nret acc\nend\n"
text f10CntZ "acc = ulong 0\nfor i ulong n bound 8\nif eq get a i 0\nacc = add acc 1\nend\nend\nret acc\nend\n"
text f11SumSq "acc = ulong 0\nfor i ulong n bound 8\nv = get a i\nacc = add acc mul v v\nend\nret acc\nend\n"
text f12SumEvn "acc = ulong 0\nfor i ulong n bound 8\nv = get a i\nif eq and v 1 0\nacc = add acc v\nend\nend\nret acc\nend\n"
text f13SumOdd "acc = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne and v 1 0\nacc = add acc v\nend\nend\nret acc\nend\n"
text f14Range "if eq n 0\nret 0\nend\nlo = get a 0\nhi = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v lo\nlo = v\nend\nif gt v hi\nhi = v\nend\nend\nret sub hi lo\nend\n"
text f15Argmax "if eq n 0\nret 0\nend\nbi = ulong 0\nbv = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v bv\nbv = v\nbi = i\nend\nend\nret bi\nend\n"
text f16Argmin "if eq n 0\nret 0\nend\nbi = ulong 0\nbv = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v bv\nbv = v\nbi = i\nend\nend\nret bi\nend\n"
text f17Sorted "if le n 1\nret 1\nend\ni = ulong 1\nwhile lt i n bound 8\nif lt get a i get a sub i 1\nret 0\nend\ni = add i 1\nend\nret 1\nend\n"
text f18StrictInc "if le n 1\nret 1\nend\ni = ulong 1\nwhile lt i n bound 8\nif le get a i get a sub i 1\nret 0\nend\ni = add i 1\nend\nret 1\nend\n"
text f19AllEq "if le n 1\nret 1\nend\nv0 = get a 0\nfor i ulong n bound 8\nif ne get a i v0\nret 0\nend\nend\nret 1\nend\n"
text f20FirstNz "for i ulong n bound 8\nv = get a i\nif ne v 0\nret v\nend\nend\nret 0\nend\n"
text f21LastNz "r = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne v 0\nr = v\nend\nend\nret r\nend\n"
text f22WtSum "acc = ulong 0\nfor i ulong n bound 8\nacc = add acc mul i get a i\nend\nret acc\nend\n"
text f23SumAdjDiff "if le n 1\nret 0\nend\ns = ulong 0\ni = ulong 1\nwhile lt i n bound 8\nx = get a i\ny = get a sub i 1\nif ge x y\ns = add s sub x y\nelse\ns = add s sub y x\nend\ni = add i 1\nend\nret s\nend\n"
text f24MaxAdjDiff "if le n 1\nret 0\nend\nm = ulong 0\ni = ulong 1\nwhile lt i n bound 8\nx = get a i\ny = get a sub i 1\nd = ulong 0\nif ge x y\nd = sub x y\nelse\nd = sub y x\nend\nif gt d m\nm = d\nend\ni = add i 1\nend\nret m\nend\n"
text f25CntInc "if le n 1\nret 0\nend\nc = ulong 0\ni = ulong 1\nwhile lt i n bound 8\nif gt get a i get a sub i 1\nc = add c 1\nend\ni = add i 1\nend\nret c\nend\n"
text f26PrefixMaxCnt "if eq n 0\nret 0\nend\nc = ulong 1\nm = get a 0\ni = ulong 1\nwhile lt i n bound 8\nv = get a i\nif gt v m\nm = v\nc = add c 1\nend\ni = add i 1\nend\nret c\nend\n"
text f27SecMax "if le n 1\nret 0\nend\nm1 = ulong 0\nm2 = ulong 0\nfor i ulong n bound 8\nv = get a i\nif gt v m1\nm2 = m1\nm1 = v\nelse\nif and gt v m2 lt v m1\nm2 = v\nend\nend\nend\nret m2\nend\n"
text f28LongNzRun "best = ulong 0\ncur = ulong 0\nfor i ulong n bound 8\nif ne get a i 0\ncur = add cur 1\nif gt cur best\nbest = cur\nend\nelse\ncur = 0\nend\nend\nret best\nend\n"
text f29First "if eq n 0\nret 0\nend\nret get a 0\nend\n"
text f30Last "if eq n 0\nret 0\nend\nret get a sub n 1\nend\n"
text f31SumEvnIdx "acc = ulong 0\nfor i ulong n bound 8\nif eq and i 1 0\nacc = add acc get a i\nend\nend\nret acc\nend\n"
text f32AltSum "acc = ulong 0\nfor i ulong n bound 8\nif eq and i 1 0\nacc = add acc get a i\nelse\nacc = sub acc get a i\nend\nend\nret acc\nend\n"
text f33CntEqF "if eq n 0\nret 0\nend\nv0 = get a 0\nc = ulong 0\nfor i ulong n bound 8\nif eq get a i v0\nc = add c 1\nend\nend\nret c\nend\n"
text f34CntLtF "if eq n 0\nret 0\nend\nv0 = get a 0\nc = ulong 0\nfor i ulong n bound 8\nif lt get a i v0\nc = add c 1\nend\nend\nret c\nend\n"
text f35CntEqIdx "c = ulong 0\nfor i ulong n bound 8\nif eq get a i i\nc = add c 1\nend\nend\nret c\nend\n"
text f36CntDist "c = ulong 0\nfor i ulong n bound 8\nseen = ulong 0\nfor j ulong i bound 8\nif eq get a j get a i\nseen = 1\nend\nend\nif eq seen 0\nc = add c 1\nend\nend\nret c\nend\n"
text f37HasDup "for i ulong n bound 8\nfor j ulong i bound 8\nif eq get a j get a i\nret 1\nend\nend\nend\nret 0\nend\n"
text f38LastOddIdx "r = n\nfor i ulong n bound 8\nif ne and get a i 1 0\nr = i\nend\nend\nret r\nend\n"
text f39LongEqRun "if eq n 0\nret 0\nend\nbest = ulong 1\ncur = ulong 1\ni = ulong 1\nwhile lt i n bound 8\nif eq get a i get a sub i 1\ncur = add cur 1\nif gt cur best\nbest = cur\nend\nelse\ncur = 1\nend\ni = add i 1\nend\nret best\nend\n"
text f40ArrGcd "g = ulong 0\nfor i ulong n bound 8\nx = g\ny = get a i\nwhile ne y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\ng = x\nend\nret g\nend\n"
text f41EvnSubOdd "se = ulong 0\nso = ulong 0\nfor i ulong n bound 8\nif eq and i 1 0\nse = add se get a i\nelse\nso = add so get a i\nend\nend\nif lt se so\nret 0\nend\nret sub se so\nend\n"

note ======== Shape 5 in-place array rewrite skeletons ========
text r0Rev "i = ulong 0\nwhile lt mul i 2 n bound 8\nj = sub sub n 1 i\nt = get a i\nput a i get a j\nput a j t\ni = add i 1\nend\nend\n"
text r1SortAsc "for i ulong n bound 8\nfor j ulong n bound 8\nif and gt j i lt get a j get a i\nt = get a i\nput a i get a j\nput a j t\nend\nend\nend\nend\n"
text r2SortDesc "for i ulong n bound 8\nfor j ulong n bound 8\nif and gt j i gt get a j get a i\nt = get a i\nput a i get a j\nput a j t\nend\nend\nend\nend\n"
text r3PrefSum "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nput a i s\nend\nend\n"
text r4PrefMax "m = ulong 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nend\nput a i m\nend\nend\n"
text r5Double "for i ulong n bound 8\nput a i mul get a i 2\nend\nend\n"
text r6Halve "for i ulong n bound 8\nput a i div get a i 2\nend\nend\n"
text r7Square "for i ulong n bound 8\nv = get a i\nput a i mul v v\nend\nend\n"
text r8ZeroEvn "for i ulong n bound 8\nif eq and get a i 1 0\nput a i 0\nend\nend\nend\n"
text r9ZeroOdd "for i ulong n bound 8\nif ne and get a i 1 0\nput a i 0\nend\nend\nend\n"
text r10RotL "if gt n 1\nf = get a 0\ni = ulong 1\nwhile lt i n bound 8\nput a sub i 1 get a i\ni = add i 1\nend\nput a sub n 1 f\nend\nend\n"
text r11RotR "if gt n 1\nl = get a sub n 1\ni = sub n 1\nwhile gt i 0 bound 8\nput a i get a sub i 1\ni = sub i 1\nend\nput a 0 l\nend\nend\n"
text r12ShiftL "if gt n 0\ni = ulong 1\nwhile lt i n bound 8\nput a sub i 1 get a i\ni = add i 1\nend\nput a sub n 1 0\nend\nend\n"
text r13ShiftR "if gt n 0\ni = sub n 1\nwhile gt i 0 bound 8\nput a i get a sub i 1\ni = sub i 1\nend\nput a 0 0\nend\nend\n"
text r14SwapAdj "i = ulong 0\nwhile lt add i 1 n bound 8\nt = get a i\nput a i get a add i 1\nput a add i 1 t\ni = add i 2\nend\nend\n"
text r15MoveZ "w = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne v 0\nput a w v\nw = add w 1\nend\nend\nwhile lt w n bound 8\nput a w 0\nw = add w 1\nend\nend\n"
text r16AddIdx "for i ulong n bound 8\nput a i add get a i i\nend\nend\n"
text r17Zero "for i ulong n bound 8\nput a i 0\nend\nend\n"
text r18PrefXor "x = ulong 0\nfor i ulong n bound 8\nx = xor x get a i\nput a i x\nend\nend\n"
text r19Inc1 "for i ulong n bound 8\nput a i add get a i 1\nend\nend\n"

fn wStr fd int s view uchar * to void
r = write fd s 0 len s
end

fn wNum fd int v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd b p sub 24 p
end

fn eqTxt a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn oClr to void
put skSt 9 0
end

fn oNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
op = get skSt 9
while lt p 24 bound 24
if lt op 65535
put skOut op get b p
op = add op 1
end
p = add p 1
end
put skSt 9 op
end

fn oTxt s view uchar * to void
p = get skSt 9
for i ulong len s bound 4096
if lt p 65535
put skOut p get s i
p = add p 1
end
end
put skSt 9 p
end

note ======== Evaluators for Shape 1 scalar loops (id 0..31) ========
fn evalScA id ulong a ulong to ulong
if eq id 0
c = ulong 0
x = a
while gt x 0 bound 64
c = add c and x 1
x = shr x 1
end
ret c
end
if eq id 1
c = ulong 0
x = a
while gt x 0 bound 64
c = add c 1
x = shr x 1
end
ret c
end
if eq id 2
if eq a 0
ret 64
end
c = ulong 0
x = a
while eq and x 1 0 bound 64
c = add c 1
x = shr x 1
end
ret c
end
if eq id 3
if eq a 0
ret 0
end
ret and a sub 0 a
end
if eq id 4
if eq a 0
ret 0
end
p = ulong 1
x = a
while gt x 1 bound 64
p = shl p 1
x = shr x 1
end
ret p
end
if eq id 5
c = ulong 0
x = a
while gt x 0 bound 64
c = xor c and x 1
x = shr x 1
end
ret c
end
if eq id 6
if eq a 0
ret 0
end
if eq and a sub a 1 0
ret 1
end
ret 0
end
if eq id 7
s = ulong 0
x = a
while gt x 0 bound 24
s = add s rem x 10
x = div x 10
end
ret s
end
if eq id 8
if eq a 0
ret 1
end
c = ulong 0
x = a
while gt x 0 bound 24
c = add c 1
x = div x 10
end
ret c
end
if eq id 9
r = ulong 0
x = a
while gt x 0 bound 24
r = add mul r 10 rem x 10
x = div x 10
end
ret r
end
if eq id 10
if eq a 0
ret 0
end
p = ulong 1
x = a
while gt x 0 bound 24
p = mul p rem x 10
x = div x 10
end
ret p
end
if eq id 11
m = ulong 0
x = a
while gt x 0 bound 24
d = rem x 10
if gt d m
m = d
end
x = div x 10
end
ret m
end
if eq id 12
if eq a 0
ret 0
end
m = ulong 9
x = a
while gt x 0 bound 24
d = rem x 10
if lt d m
m = d
end
x = div x 10
end
ret m
end
if eq id 13
r = ulong 0
x = a
while gt x 0 bound 24
r = add mul r 10 rem x 10
x = div x 10
end
if eq r a
ret 1
end
ret 0
end
if eq id 14
x = a
while ge x 10 bound 16
s = ulong 0
while gt x 0 bound 24
s = add s rem x 10
x = div x 10
end
x = s
end
ret x
end
ret 0
end

fn evalScB id ulong a ulong to ulong
if eq id 15
if le a 1
ret a
end
lo = ulong 1
hi = ulong 4294967296
if lt a hi
hi = a
end
ans = ulong 1
while le lo hi bound 64
mid = add lo shr sub hi lo 1
if le mid div a mid
ans = mid
lo = add mid 1
else
hi = sub mid 1
end
end
ret ans
end
if eq id 16
if lt a 2
ret 0
end
if eq a 2
ret 1
end
if eq rem a 2 0
ret 0
end
d = ulong 3
while le d div a d bound 2000000
if eq rem a d 0
ret 0
end
d = add d 2
end
ret 1
end
if eq id 17
if le a 1
ret a
end
if eq rem a 2 0
ret 2
end
d = ulong 3
while le d div a d bound 2000000
if eq rem a d 0
ret d
end
d = add d 2
end
ret a
end
if eq id 18
if gt a 20
ret 0
end
r = ulong 1
i = ulong 2
while le i a bound 24
r = mul r i
i = add i 1
end
ret r
end
if eq id 19
if gt a 93
ret 0
end
if eq a 0
ret 0
end
p = ulong 0
c = ulong 1
i = ulong 1
while lt i a bound 96
t = add p c
p = c
c = t
i = add i 1
end
ret c
end
if eq id 20
if le a 1
ret 0
end
x = a
s = ulong 0
while gt x 1 bound 2000
if eq and x 1 0
x = shr x 1
else
x = add mul 3 x 1
end
s = add s 1
end
ret s
end
if eq id 21
ret or shl and a 255 8 and shr a 8 255
end
if eq id 22
ret xor and a 65535 65535
end
if eq id 23
r = ulong 0
x = a
for i ulong 8 bound 8
r = or shl r 1 and x 1
x = shr x 1
end
ret r
end
if eq id 24
if eq a 0
ret 0
end
c = ulong 0
d = ulong 1
while le d div a d bound 2000000
if eq rem a d 0
c = add c 1
if ne d div a d
c = add c 1
end
end
d = add d 1
end
ret c
end
if eq id 25
if eq a 0
ret 0
end
s = ulong 0
d = ulong 1
while le d div a d bound 2000000
if eq rem a d 0
s = add s d
q = div a d
if ne d q
s = add s q
end
end
d = add d 1
end
ret s
end
if eq id 26
if eq a 0
ret 0
end
c = ulong 0
x = a
while eq rem x 10 0 bound 24
c = add c 1
x = div x 10
end
ret c
end
if eq id 27
if eq a 0
ret 0
end
x = a
while eq and x 1 0 bound 64
x = shr x 1
end
ret x
end
if eq id 28
if le a 1
ret 1
end
p = ulong 1
while lt p a bound 64
p = shl p 1
end
ret p
end
if eq id 29
ret div mul a add a 1 2
end
if eq id 30
if eq a 0
ret 1
end
c = ulong 0
x = a
while gt x 0 bound 24
if eq and rem x 10 1 0
c = add c 1
end
x = div x 10
end
ret c
end
if eq id 31
c = ulong 0
x = a
while gt x 0 bound 24
if ne and rem x 10 1 0
c = add c 1
end
x = div x 10
end
ret c
end
ret 0
end

fn evalSc id ulong a ulong to ulong
if lt id 15
ret evalScA id a
end
ret evalScB id a
end


text pfPre "acc = ulong 0\nfor i ulong n bound 8\nv = get a i\nif "
text pfGt "gt v "
text pfLt "lt v "
text pfEq "eq v "
text pfGe "ge v "
text pfDiv1 "eq rem v "
text pfDiv2 " 0"
text pfInc "\nacc = add acc 1\nend\nend\nret acc\nend\n"
text pfAddV "\nacc = add acc v\nend\nend\nret acc\nend\n"
text pfIdx1 "for i ulong n bound 8\nv = get a i\nif "
text pfIdx2 "\nret i\nend\nend\nret n\nend\n"
text pfFstV "\nret v\nend\nend\nret 0\nend\n"

fn evalFoldParam pid ulong kv ulong ci ulong to ulong
n = get skArrN ci
base = mul ci 8
if eq pid 0
acc = ulong 0
for i ulong n bound 8
if gt get skArr add base i kv
acc = add acc 1
end
end
ret acc
end
if eq pid 1
acc = ulong 0
for i ulong n bound 8
if lt get skArr add base i kv
acc = add acc 1
end
end
ret acc
end
if eq pid 2
acc = ulong 0
for i ulong n bound 8
if eq get skArr add base i kv
acc = add acc 1
end
end
ret acc
end
if eq pid 3
acc = ulong 0
for i ulong n bound 8
if ge get skArr add base i kv
acc = add acc 1
end
end
ret acc
end
if eq pid 4
if eq kv 0
ret 999999999
end
acc = ulong 0
for i ulong n bound 8
if eq rem get skArr add base i kv 0
acc = add acc 1
end
end
ret acc
end
if eq pid 5
acc = ulong 0
for i ulong n bound 8
v = get skArr add base i
if gt v kv
acc = add acc v
end
end
ret acc
end
if eq pid 6
for i ulong n bound 8
if eq get skArr add base i kv
ret i
end
end
ret n
end
if eq pid 7
for i ulong n bound 8
if gt get skArr add base i kv
ret i
end
end
ret n
end
if eq pid 8
for i ulong n bound 8
v = get skArr add base i
if gt v kv
ret v
end
end
ret 0
end
ret 0
end

fn emitFoldParam pid ulong kv ulong to void
oClr
oTxt tFn4
if le pid 5
oTxt pfPre
if eq pid 0
oTxt pfGt
oNum kv
oTxt pfInc
ret
end
if eq pid 1
oTxt pfLt
oNum kv
oTxt pfInc
ret
end
if eq pid 2
oTxt pfEq
oNum kv
oTxt pfInc
ret
end
if eq pid 3
oTxt pfGe
oNum kv
oTxt pfInc
ret
end
if eq pid 4
oTxt pfDiv1
oNum kv
oTxt pfDiv2
oTxt pfInc
ret
end
oTxt pfGt
oNum kv
oTxt pfAddV
ret
end
oTxt pfIdx1
if eq pid 6
oTxt pfEq
oNum kv
oTxt pfIdx2
ret
end
if eq pid 7
oTxt pfGt
oNum kv
oTxt pfIdx2
ret
end
oTxt pfGt
oNum kv
oTxt pfFstV
end

fn solveFold to ulong
nc = get skSt 13
for sk ulong 42 bound 42
ok = true
for ci ulong nc bound 8
if ne evalFold sk ci get skTgt ci
ok = false
break
end
end
if pickMatch ok
oClr
oTxt tFn4
if lt sk 15
emitFoldA sk
else
if lt sk 31
emitFoldB sk
else
emitFoldC sk
end
end
ret sk
end
end
ncon = get skSt 2
for ci2 ulong ncon bound 32
kv = get skConsts ci2
for pid ulong 9 bound 9
ok2 = true
for c ulong nc bound 8
if ne evalFoldParam pid kv c get skTgt c
ok2 = false
break
end
end
if pickMatch ok2
emitFoldParam pid kv
ret add 100 pid
end
end
end
ret 999
end

note ======== In-place array rewrite evaluators (id 0..19) ========
fn runRewA sk ulong n ulong to void
if eq sk 0
i = ulong 0
while lt mul i 2 n bound 8
j = sub sub n 1 i
t = get skTmpArr i
put skTmpArr i get skTmpArr j
put skTmpArr j t
i = add i 1
end
ret
end
if eq sk 1
for i ulong n bound 8
for j ulong n bound 8
if and gt j i lt get skTmpArr j get skTmpArr i
t = get skTmpArr i
put skTmpArr i get skTmpArr j
put skTmpArr j t
end
end
end
ret
end
if eq sk 2
for i ulong n bound 8
for j ulong n bound 8
if and gt j i gt get skTmpArr j get skTmpArr i
t = get skTmpArr i
put skTmpArr i get skTmpArr j
put skTmpArr j t
end
end
end
ret
end
if eq sk 3
s = ulong 0
for i ulong n bound 8
s = add s get skTmpArr i
put skTmpArr i s
end
ret
end
if eq sk 4
m = ulong 0
for i ulong n bound 8
v = get skTmpArr i
if gt v m
m = v
end
put skTmpArr i m
end
ret
end
if eq sk 5
for i ulong n bound 8
put skTmpArr i mul get skTmpArr i 2
end
ret
end
if eq sk 6
for i ulong n bound 8
put skTmpArr i div get skTmpArr i 2
end
ret
end
if eq sk 7
for i ulong n bound 8
v = get skTmpArr i
put skTmpArr i mul v v
end
ret
end
if eq sk 8
for i ulong n bound 8
if eq and get skTmpArr i 1 0
put skTmpArr i 0
end
end
ret
end
if eq sk 9
for i ulong n bound 8
if ne and get skTmpArr i 1 0
put skTmpArr i 0
end
end
ret
end
end

fn runRewB sk ulong n ulong to void
if eq sk 10
if gt n 1
f = get skTmpArr 0
i = ulong 1
while lt i n bound 8
put skTmpArr sub i 1 get skTmpArr i
i = add i 1
end
put skTmpArr sub n 1 f
end
ret
end
if eq sk 11
if gt n 1
l = get skTmpArr sub n 1
i = sub n 1
while gt i 0 bound 8
put skTmpArr i get skTmpArr sub i 1
i = sub i 1
end
put skTmpArr 0 l
end
ret
end
if eq sk 12
if gt n 0
i = ulong 1
while lt i n bound 8
put skTmpArr sub i 1 get skTmpArr i
i = add i 1
end
put skTmpArr sub n 1 0
end
ret
end
if eq sk 13
if gt n 0
i = sub n 1
while gt i 0 bound 8
put skTmpArr i get skTmpArr sub i 1
i = sub i 1
end
put skTmpArr 0 0
end
ret
end
if eq sk 14
i = ulong 0
while lt add i 1 n bound 8
t = get skTmpArr i
put skTmpArr i get skTmpArr add i 1
put skTmpArr add i 1 t
i = add i 2
end
ret
end
if eq sk 15
w = ulong 0
for i ulong n bound 8
v = get skTmpArr i
if ne v 0
put skTmpArr w v
w = add w 1
end
end
while lt w n bound 8
put skTmpArr w 0
w = add w 1
end
ret
end
if eq sk 16
for i ulong n bound 8
put skTmpArr i add get skTmpArr i i
end
ret
end
if eq sk 17
for i ulong n bound 8
put skTmpArr i 0
end
ret
end
if eq sk 18
x = ulong 0
for i ulong n bound 8
x = xor x get skTmpArr i
put skTmpArr i x
end
ret
end
if eq sk 19
for i ulong n bound 8
put skTmpArr i add get skTmpArr i 1
end
ret
end
end

fn emitRewA sk ulong to void
if eq sk 0
oTxt r0Rev
end
if eq sk 1
oTxt r1SortAsc
end
if eq sk 2
oTxt r2SortDesc
end
if eq sk 3
oTxt r3PrefSum
end
if eq sk 4
oTxt r4PrefMax
end
if eq sk 5
oTxt r5Double
end
if eq sk 6
oTxt r6Halve
end
if eq sk 7
oTxt r7Square
end
if eq sk 8
oTxt r8ZeroEvn
end
if eq sk 9
oTxt r9ZeroOdd
end
end

fn emitRewB sk ulong to void
if eq sk 10
oTxt r10RotL
end
if eq sk 11
oTxt r11RotR
end
if eq sk 12
oTxt r12ShiftL
end
if eq sk 13
oTxt r13ShiftR
end
if eq sk 14
oTxt r14SwapAdj
end
if eq sk 15
oTxt r15MoveZ
end

note ======== Fold/Select/Count/Scan evaluators (id 0..30) ========
fn evalFoldA sk ulong ci ulong to ulong
n = get skArrN ci
base = mul ci 8
if eq sk 0
acc = ulong 0
for i ulong n bound 8
acc = add acc get skArr add base i
end
ret acc
end
if eq sk 1
acc = ulong 1
for i ulong n bound 8
acc = mul acc get skArr add base i
end
ret acc
end
if eq sk 2
acc = ulong 0
for i ulong n bound 8
v = get skArr add base i
if gt v acc
acc = v
end
end
ret acc
end
if eq sk 3
if eq n 0
ret 0
end
acc = get skArr base
for i ulong n bound 8
v = get skArr add base i
if lt v acc
acc = v
end
end
ret acc
end
if eq sk 4
acc = ulong 0
for i ulong n bound 8
acc = xor acc get skArr add base i
end
ret acc
end
if eq sk 5
acc = ulong 0
for i ulong n bound 8
acc = or acc get skArr add base i
end
ret acc
end
if eq sk 6
if eq n 0
ret 0
end
acc = get skArr base
for i ulong n bound 8
acc = and acc get skArr add base i
end
ret acc
end
if eq sk 7
acc = ulong 0
for i ulong n bound 8
if eq and get skArr add base i 1 0
acc = add acc 1
end
end
ret acc
end
if eq sk 8
acc = ulong 0
for i ulong n bound 8
if ne and get skArr add base i 1 0
acc = add acc 1
end
end
ret acc
end
if eq sk 9
acc = ulong 0
for i ulong n bound 8
if ne get skArr add base i 0
acc = add acc 1
end
end
ret acc
end
if eq sk 10
acc = ulong 0
for i ulong n bound 8
if eq get skArr add base i 0
acc = add acc 1
end
end
ret acc
end
if eq sk 11
acc = ulong 0
for i ulong n bound 8
v = get skArr add base i
acc = add acc mul v v
end
ret acc
end
if eq sk 12
acc = ulong 0
for i ulong n bound 8
v = get skArr add base i
if eq and v 1 0
acc = add acc v
end
end
ret acc
end
if eq sk 13
acc = ulong 0
for i ulong n bound 8
v = get skArr add base i
if ne and v 1 0
acc = add acc v
end
end
ret acc
end
if eq sk 14
if eq n 0
ret 0
end
lo = get skArr base
hi = lo
for i ulong n bound 8
v = get skArr add base i
if lt v lo
lo = v
end
if gt v hi
hi = v
end
end
ret sub hi lo
end
ret 0
end

fn evalFoldB sk ulong ci ulong to ulong
n = get skArrN ci
base = mul ci 8
if eq sk 15
if eq n 0
ret 0
end
bi = ulong 0
bv = get skArr base
for i ulong n bound 8
v = get skArr add base i
if gt v bv
bv = v
bi = i
end
end
ret bi
end
if eq sk 16
if eq n 0
ret 0
end
bi = ulong 0
bv = get skArr base
for i ulong n bound 8
v = get skArr add base i
if lt v bv
bv = v
bi = i
end
end
ret bi
end
if eq sk 17
if le n 1
ret 1
end
i = ulong 1
while lt i n bound 8
if lt get skArr add base i get skArr add base sub i 1
ret 0
end
i = add i 1
end
ret 1
end
if eq sk 18
if le n 1
ret 1
end
i = ulong 1
while lt i n bound 8
if le get skArr add base i get skArr add base sub i 1
ret 0
end
i = add i 1
end
ret 1
end
if eq sk 19
if le n 1
ret 1
end
v0 = get skArr base
for i ulong n bound 8
if ne get skArr add base i v0
ret 0
end
end
ret 1
end
if eq sk 20
for i ulong n bound 8
v = get skArr add base i
if ne v 0
ret v
end
end
ret 0
end
if eq sk 21
r = ulong 0
for i ulong n bound 8
v = get skArr add base i
if ne v 0
r = v
end
end
ret r
end
if eq sk 22
acc = ulong 0
for i ulong n bound 8
acc = add acc mul i get skArr add base i
end
ret acc
end
if eq sk 23
if le n 1
ret 0
end
s = ulong 0
i = ulong 1
while lt i n bound 8
x = get skArr add base i
y = get skArr add base sub i 1
if ge x y
s = add s sub x y
else
s = add s sub y x
end
i = add i 1
end
ret s
end
if eq sk 24
if le n 1
ret 0
end
m = ulong 0
i = ulong 1
while lt i n bound 8
x = get skArr add base i
y = get skArr add base sub i 1
d = ulong 0
if ge x y
d = sub x y
else
d = sub y x
end
if gt d m
m = d
end
i = add i 1
end
ret m
end
if eq sk 25
if le n 1
ret 0
end
c = ulong 0
i = ulong 1
while lt i n bound 8
if gt get skArr add base i get skArr add base sub i 1
c = add c 1
end
i = add i 1
end
ret c
end
if eq sk 26
if eq n 0
ret 0
end
c = ulong 1
m = get skArr base
i = ulong 1
while lt i n bound 8
v = get skArr add base i
if gt v m
m = v
c = add c 1
end
i = add i 1
end
ret c
end
if eq sk 27
if le n 1
ret 0
end
m1 = ulong 0
m2 = ulong 0
for i ulong n bound 8
v = get skArr add base i
if gt v m1
m2 = m1
m1 = v
else
if and gt v m2 lt v m1
m2 = v
end
end
end
ret m2
end
if eq sk 28
best = ulong 0
cur = ulong 0
for i ulong n bound 8
if ne get skArr add base i 0
cur = add cur 1
if gt cur best
best = cur
end
else
cur = 0
end
end
ret best
end
if eq sk 29
if eq n 0
ret 0
end
ret get skArr base
end
if eq sk 30
if eq n 0
ret 0
end
ret get skArr add base sub n 1
end
ret 0
end

fn evalFoldC sk ulong ci ulong to ulong
n = get skArrN ci
base = mul ci 8
if eq sk 31
acc = ulong 0
for i ulong n bound 8
if eq and i 1 0
acc = add acc get skArr add base i
end
end
ret acc
end
if eq sk 32
acc = ulong 0
for i ulong n bound 8
if eq and i 1 0
acc = add acc get skArr add base i
else
acc = sub acc get skArr add base i
end
end
ret acc
end
if eq sk 33
if eq n 0
ret 0
end
v0 = get skArr base
c = ulong 0
for i ulong n bound 8
if eq get skArr add base i v0
c = add c 1
end
end
ret c
end
if eq sk 34
if eq n 0
ret 0
end
v0 = get skArr base
c = ulong 0
for i ulong n bound 8
if lt get skArr add base i v0
c = add c 1
end
end
ret c
end
if eq sk 35
c = ulong 0
for i ulong n bound 8
if eq get skArr add base i i
c = add c 1
end
end
ret c
end
if eq sk 36
c = ulong 0
for i ulong n bound 8
seen = ulong 0
for j ulong i bound 8
if eq get skArr add base j get skArr add base i
seen = 1
end
end
if eq seen 0
c = add c 1
end
end
ret c
end
if eq sk 37
for i ulong n bound 8
for j ulong i bound 8
if eq get skArr add base j get skArr add base i
ret 1
end
end
end
ret 0
end
if eq sk 38
r = n
for i ulong n bound 8
if ne and get skArr add base i 1 0
r = i
end
end
ret r
end
if eq sk 39
if eq n 0
ret 0
end
best = ulong 1
cur = ulong 1
i = ulong 1
while lt i n bound 8
if eq get skArr add base i get skArr add base sub i 1
cur = add cur 1
if gt cur best
best = cur
end
else
cur = 1
end
i = add i 1
end
ret best
end
if eq sk 40
g = ulong 0
for i ulong n bound 8
x = g
y = get skArr add base i
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
g = x
end
ret g
end
if eq sk 41
se = ulong 0
so = ulong 0
for i ulong n bound 8
if eq and i 1 0
se = add se get skArr add base i
else
so = add so get skArr add base i
end
end
if lt se so
ret 0
end
ret sub se so
end
ret 0
end

fn evalFold sk ulong ci ulong to ulong
if lt sk 15
ret evalFoldA sk ci

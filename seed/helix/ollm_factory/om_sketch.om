note ======== Ternary skeletons (id 0..21) ========
fn evalTernA id ulong a ulong b ulong c ulong to ulong
if eq id 0
if lt a b
ret b
end
if gt a c
ret c
end
ret a
end
if eq id 1
if le a b
if le b c
ret b
end
if le a c
ret c
end
ret a
end
if le a c
ret a
end
if le b c
ret c
end
ret b
end
if eq id 2
m = a
if gt b m
m = b
end
if gt c m
m = c
end
ret m
end
if eq id 3
m = a
if lt b m
m = b
end
if lt c m
m = c
end
ret m
end
if eq id 4
if and ge a b le a c
ret 1
end
ret 0
end
if eq id 5
ret add add a b c
end
if eq id 6
ret mul mul a b c
end
if eq id 7
if ne a 0
ret b
end
ret c
end
if eq id 8
if and le a b le b c
ret 1
end
ret 0
end
if eq id 9
c1 = ulong 1
if ne b a
c1 = add c1 1
end
if and ne c a ne c b
c1 = add c1 1
end
ret c1
end
if eq id 10
ret add add and a 1 and b 1 and c 1
end
if eq id 11
ret or or and a b and a c and b c
end
ret 0
end

fn evalTernB id ulong a ulong b ulong c ulong to ulong
if eq id 12
ret xor xor a b c
end
if eq id 13
ret or and a c sub b and b c

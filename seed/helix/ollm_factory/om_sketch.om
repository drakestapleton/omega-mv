if eq id 15
x = a
y = b
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
y = c
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
ret x
end
if eq id 16
if or eq a b eq a c
ret a
end
if eq b c
ret b
end
ret 0
end
if eq id 17
if eq a b
ret c
end
if eq a c
ret b
end
ret a
end
if eq id 18
ret add mul a b c
end
if eq id 19
r = ulong 1
if eq b a
r = add r 1
end
if eq c a
r = add r 1
end
ret r
end
if eq id 20
if eq c 0
ret a
end
ret b
end
if eq id 21
if eq and c 1 0
ret add a b
end
ret mul a b
end
ret 0
end

fn evalTern id ulong a ulong b ulong c ulong to ulong
if lt id 12
ret evalTernA id a b c
end
ret evalTernB id a b c
end


note An experiment can request a later matching sketch. A normal solve selects the first.
fn pickMatch matched bool to bool
if not matched
ret false
end
if eq get skipMatches 0 0
ret true
end
put skipMatches 0 sub get skipMatches 0 1
ret false
end

fn solveScalar to ulong
nc = get skSt 0
for id ulong 32 bound 32
ok = true
for i ulong nc bound 8
if ne evalSc id get skInA i get skTgt i
ok = false
break
end
end
if pickMatch ok
oClr
oTxt tFn1
if lt id 15
emitScA id
else
emitScB id
end
ret id
end
end
ret 999
end

note ======== Binary loops (id 0..9) ========
fn evalBin id ulong a ulong b ulong to ulong
if eq id 0
x = a
y = b
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
ret x
end
if eq id 1
if or eq a 0 eq b 0
ret 0
end
x = a
y = b
while ne y 0 bound 128
t = rem x y
x = y
y = t
end
ret mul div a x b
end
if eq id 2
r = ulong 1
base = a
e = b
while gt e 0 bound 64
if ne and e 1 0
r = mul r base
end
base = mul base base
e = shr e 1
end
ret r
end
if eq id 3
x = xor a b
c = ulong 0
while gt x 0 bound 64
c = add c and x 1
x = shr x 1
end
ret c
end
if eq id 4
if eq b 0
ret 0
end
ret div a b
end
if eq id 5
if eq b 0
ret 0
end
ret rem a b
end
if eq id 6
if eq b 0
ret 0
end
q = div a b
if ne rem a b 0
q = add q 1
end
ret q
end
if eq id 7
if le a b
ret 0
end
ret sub a b
end
if eq id 8
if eq b 0
ret 0
end
ret sub a rem a b
end
if eq id 9
if eq b 0
ret 0
end
r = rem a b
if eq r 0
ret a
end
ret add a sub b r
end
if eq id 10
s = ulong 0
x = a
while gt x 0 bound 24
s = add s rem x 10
x = div x 10
end
x = b
while gt x 0 bound 24
s = add s rem x 10
x = div x 10
end
ret s
end
if eq id 11
c = ulong 0
if eq a 0
c = add c 1
else
x = a
while gt x 0 bound 24
c = add c 1
x = div x 10
end
end
if eq b 0
c = add c 1
else
x = b
while gt x 0 bound 24
c = add c 1
x = div x 10
end
end
ret c
end
if eq id 12
ret or shl and a 255 8 and b 255
end
if eq id 13
ret add mul rem a 10 10 rem b 10
end
ret 0
end

fn solveBinary to ulong
nc = get skSt 0
for id ulong 14 bound 14
ok = true

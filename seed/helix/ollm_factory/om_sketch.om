fn checkRewCase sk ulong ci ulong to bool
n = get skArrN ci
base = mul ci 8
for k ulong 8 bound 8
put skTmpArr k get skArr add base k
end
if lt sk 10
runRewA sk n
else
runRewB sk n
end
for k ulong 8 bound 8
if ne get skTmpArr k get skOutArr add base k
ret false
end
end
ret true
end

text prLoop "for i ulong n bound 8\nv = get a i\n"
text prEnd "\nend\nend\n"
text prAdd "put a i add v "
text prSub "if le v "
text prSub2 "\nput a i 0\nelse\nput a i sub v "
text prSub3 "\nend"
text prMul "put a i mul v "
text prDiv "put a i div v "
text prRem "put a i rem v "
text prCapH "if gt v "
text prCapH2 "\nput a i "
text prCapL "if lt v "
text prZLo "\nput a i 0\nend"
text prRepZ "if eq v 0\nput a i "
text prFill "put a i "
text prXor "put a i xor v "
text prAnd "put a i and v "
text prOr  "put a i or v "

fn runRewParam pid ulong kv ulong n ulong to bool
if and or eq pid 3 eq pid 4 eq kv 0
ret false
end
for i ulong n bound 8
v = get skTmpArr i
if eq pid 0
put skTmpArr i add v kv
end
if eq pid 1
if le v kv
put skTmpArr i 0
else
put skTmpArr i sub v kv
end
end
if eq pid 2
put skTmpArr i mul v kv
end
if eq pid 3
put skTmpArr i div v kv
end
if eq pid 4
put skTmpArr i rem v kv
end
if eq pid 5
if gt v kv
put skTmpArr i kv
end
end
if eq pid 6
if lt v kv
put skTmpArr i kv
end
end
if eq pid 7
if lt v kv
put skTmpArr i 0
end
end
if eq pid 8
if gt v kv
put skTmpArr i 0
end
end
if eq pid 9
if eq v 0
put skTmpArr i kv
end
end
if eq pid 10
put skTmpArr i kv
end
if eq pid 11
put skTmpArr i xor v kv
end
if eq pid 12
put skTmpArr i and v kv
end
if eq pid 13
put skTmpArr i or v kv
end
end
ret true
end

fn emitRewParam pid ulong kv ulong to void
oClr
oTxt tFn5
oTxt prLoop
if eq pid 0
oTxt prAdd
oNum kv
end
if eq pid 1
oTxt prSub
oNum kv
oTxt prSub2
oNum kv
oTxt prSub3
end
if eq pid 2
oTxt prMul
oNum kv
end
if eq pid 3
oTxt prDiv
oNum kv
end
if eq pid 4
oTxt prRem
oNum kv
end
if eq pid 5
oTxt prCapH
oNum kv
oTxt prCapH2
oNum kv
oTxt prSub3
end
if eq pid 6
oTxt prCapL
oNum kv
oTxt prCapH2
oNum kv
oTxt prSub3
end
if eq pid 7
oTxt prCapL
oNum kv
oTxt prZLo
end
if eq pid 8
oTxt prCapH
oNum kv
oTxt prZLo
end
if eq pid 9
oTxt prRepZ
oNum kv
oTxt prSub3
end
if eq pid 10
oTxt prFill
oNum kv
end
if eq pid 11
oTxt prXor
oNum kv
end
if eq pid 12
oTxt prAnd
oNum kv
end
if eq pid 13
oTxt prOr
oNum kv
end
oTxt prEnd
end

fn checkRewParamCase pid ulong kv ulong ci ulong to bool
n = get skArrN ci
base = mul ci 8
for k ulong 8 bound 8
put skTmpArr k get skArr add base k
end
if not runRewParam pid kv n
ret false
end
for k ulong 8 bound 8
if ne get skTmpArr k get skOutArr add base k
ret false
end
end
ret true
end

note Two development families: add a multiple of the original next or first item.
text scaledNext "for i ulong n bound 8\nj = add i 1\nif lt j n\nput a i add get a i mul get a j "
text scaledFirst "if gt n 0\nanchor = get a 0\nfor i ulong n bound 8\nput a i add get a i mul anchor "
text scaledEnd "\nend\nend\nend\n"

fn scaleFactor family ulong ci ulong i ulong to ulong
base = mul ci 8
if eq family 1
ret get skArr base
end
j = add i 1
if ge j get skArrN ci
ret 0
end
ret get skArr add base j
end

fn scaleFits family ulong k ulong to bool
for ci ulong get skSt 14 bound 8
n = get skArrN ci
for i ulong 8
j = add mul ci 8 i
v = get skArr j
if lt i n
v = add v mul k scaleFactor family ci i
end
if ne v get skOutArr j
ret false
end
end
end
ret true
end

fn scaleMatch family ulong to bool
note Try the spec constants first, then integer ratios from informative input/output pairs.
note Verification always uses wrapping ulong arithmetic and compares the entire array.
for c ulong get skSt 2 bound 32
k = get skConsts c
if scaleFits family k
put scaleResult 0 k
ret true
end
end
for ci ulong get skSt 14 bound 8
for i ulong get skArrN ci bound 8
factor = scaleFactor family ci i
if ne factor 0
j = add mul ci 8 i
delta = sub get skOutArr j get skArr j
if eq rem delta factor 0
k = div delta factor
if scaleFits family k
put scaleResult 0 k
ret true
end
end
end
end
end
ret false
end

fn scaledRewrite to ulong
for family ulong 2
if ne and get rewriteMask 0 shl ulong 1 family 0
if pickMatch scaleMatch family
oClr
oTxt tFn5
if eq family 0
oTxt scaledNext
else
oTxt scaledFirst
end
oNum get scaleResult 0
oTxt scaledEnd
ret add 200 family
end
end
end
ret 999
end

fn solveRewrite to ulong
nc = get skSt 14
for sk ulong 20 bound 20
ok = true
for ci ulong nc bound 8
if not checkRewCase sk ci
ok = false
break
end
end
if pickMatch ok
oClr
oTxt tFn5
if lt sk 10
emitRewA sk
else
emitRewB sk
end
ret sk
end
end
ncon = get skSt 2
for ci2 ulong ncon bound 32
kv = get skConsts ci2
for pid ulong 14 bound 14
ok2 = true
for c ulong nc bound 8
if not checkRewParamCase pid kv c
ok2 = false
break
end
end
if pickMatch ok2
emitRewParam pid kv
ret add 100 pid
end
end
end
ret scaledRewrite
end

note ======== Spec file parser ========
fn spStarts o ulong e ulong t view uchar * to bool
tl = len t
if gt tl sub e o
ret false
end
for i ulong tl bound 32
if ne get skInBuf add o i get t i
ret false
end
end
ret true
end

fn spNextU pos ulong e ulong to ulong
p = pos
while lt p e bound 4096
c = get skInBuf p
if and ne c 32 and ne c 9 ne c 13
break
end
p = add p 1
end
v = ulong 0
got = ulong 0
while lt p e bound 4096
c = get skInBuf p
if not and ge c 48 le c 57
break
end
v = add mul v 10 ulong sub c 48
got = 1
p = add p 1
end
put skSt 20 v
put skSt 21 got
ret p
end

fn skParseLine ls ulong lend ulong to void
if spStarts ls lend kwRewrites
p = spNextU add ls len kwRewrites lend
put rewriteMask 0 get skSt 20
ret
end
if spStarts ls lend kwSkip
p = spNextU add ls len kwSkip lend
put skipMatches 0 get skSt 20
ret
end
if spStarts ls lend kwArity
p = spNextU add ls 6 lend
if eq get skSt 21 1
put skSt 1 get skSt 20
end
ret
end
if spStarts ls lend kwConsts
p = add ls 7
cc = ulong 0
while lt p lend bound 32
p = spNextU p lend
if eq get skSt 21 0
break
end
if lt cc 32
put skConsts cc get skSt 20
cc = add cc 1
end
end
put skSt 2 cc
ret
end
if spStarts ls lend kwCase
nc = get skSt 0
if lt nc 8
ar = get skSt 1
p = spNextU add ls 5 lend
put skInA nc get skSt 20
if ge ar 2
p = spNextU p lend
put skInB nc get skSt 20
end
if ge ar 3
p = spNextU p lend
put skInC nc get skSt 20
end
p = spNextU p lend
put skTgt nc get skSt 20
put skSt 0 add nc 1
end
ret
end
if spStarts ls lend kwFold
fc = get skSt 13
if lt fc 8
p = spNextU add ls 5 lend
vn = get skSt 20
put skArrN fc vn
base = mul fc 8
for k ulong 8 bound 8
put skArr add base k 0
end
for k ulong vn bound 8
p = spNextU p lend
put skArr add base k get skSt 20
end
p = spNextU p lend
put skTgt fc get skSt 20
put skSt 13 add fc 1
end
ret
end
if spStarts ls lend kwRew
rc = get skSt 14
if lt rc 8
p = spNextU add ls 4 lend
vn = get skSt 20
put skArrN rc vn
base = mul rc 8
for k ulong 8 bound 8
p = spNextU p lend
put skArr add base k get skSt 20
end
for k ulong 8 bound 8
p = spNextU p lend
put skOutArr add base k get skSt 20
end
put skSt 14 add rc 1
end
end
end

fn skParseSpec blen ulong to bool
put rewriteMask 0 3
put skipMatches 0 0
put skSt 0 0
put skSt 1 1
put skSt 2 0
put skSt 13 0
put skSt 14 0
pos = ulong 0
while lt pos blen bound 65536
ls = pos
while lt pos blen bound 65536
if eq get skInBuf pos 10
break
end
pos = add pos 1
end
lend = pos
if lt pos blen
pos = add pos 1
end
skParseLine ls lend
end
if gt get skSt 14 0
put skSt 1 5
ret true
end
if gt get skSt 13 0
put skSt 1 4
ret true
end
ret gt get skSt 0 0
end

fn skSaveOut argi ulong to bool
pl = argread argi skPath 0 4095
if le pl 0
ret false
end
fd = fopen skPath 0 ulong pl 577 420
if lt fd 0
ret false
end
n = get skSt 9
o = ulong 0
while lt o n bound 65536
k = write int fd skOut o sub n o
if le k 0
break
end
o = add o ulong k
end
z = fclose int fd
ret true
end

fn runSelfcheck to int
note 1. Popcount
put skSt 0 4
put skInA 0 0
put skTgt 0 0
put skInA 1 7
put skTgt 1 3
put skInA 2 15
put skTgt 2 4
put skInA 3 255
put skTgt 3 8
if ne solveScalar 0
wStr 2 tSelfFail
wNum 2 1
wStr 2 tNl
ret 1
end
note 2. Digit sum
put skInA 0 0
put skTgt 0 0
put skInA 1 123
put skTgt 1 6
put skInA 2 999
put skTgt 2 27
put skInA 3 405
put skTgt 3 9
if ne solveScalar 7
wStr 2 tSelfFail
wNum 2 2
wStr 2 tNl
ret 1
end
note 3. GCD
put skInA 0 48
put skInB 0 18
put skTgt 0 6
put skInA 1 25
put skInB 1 6
put skTgt 1 1
put skInA 2 64
put skInB 2 64
put skTgt 2 64
put skInA 3 0
put skInB 3 9
put skTgt 3 9
if ne solveBinary 0
wStr 2 tSelfFail
wNum 2 3
wStr 2 tNl
ret 1
end
note 4. Clamp
put skInA 0 5
put skInB 0 10
put skInC 0 20
put skTgt 0 10
put skInA 1 15
put skInB 1 10
put skInC 1 20
put skTgt 1 15
put skInA 2 25
put skInB 2 10
put skInC 2 20
put skTgt 2 20
put skInA 3 10
put skInB 3 10
put skInC 3 20
put skTgt 3 10
if ne solveTernary 0
wStr 2 tSelfFail
wNum 2 4
wStr 2 tNl
ret 1
end
note 5. Fold argmax
put skSt 13 2
put skArrN 0 4
put skArr 0 3
put skArr 1 9
put skArr 2 2
put skArr 3 7
put skTgt 0 1
put skArrN 1 3
put skArr 8 5
put skArr 9 1
put skArr 10 8
put skTgt 1 2
if ne solveFold 15
wStr 2 tSelfFail
wNum 2 5
wStr 2 tNl
ret 1
end
note 6. Rewrite reverse
put skSt 14 1
put skArrN 0 4
put skArr 0 1
put skArr 1 2
put skArr 2 3
put skArr 3 4
put skArr 4 9
put skArr 5 9
put skArr 6 9
put skArr 7 9
put skOutArr 0 4
put skOutArr 1 3
put skOutArr 2 2
put skOutArr 3 1
put skOutArr 4 9
put skOutArr 5 9
put skOutArr 6 9
put skOutArr 7 9
if ne solveRewrite 0
wStr 2 tSelfFail
wNum 2 6
wStr 2 tNl
ret 1
end
wStr 1 tSelfOk
ret 0
end

fn main to int
if lt argcnt 2
wStr 2 tUsage
ret 2
end
mb = new uchar 64 0
ml = argread 1 mb 0 64
if le ml 0
wStr 2 tUsage
ret 2
end
if eqTxt mb ulong ml mSelf
ret runSelfcheck
end
if not eqTxt mb ulong ml mSolve
wStr 2 tUsage
ret 2
end
if lt argcnt 4
wStr 2 tUsage
ret 2
end
pl = argread 2 skPath 0 4095
if le pl 0
wStr 2 tErrIo
ret 1
end
fd = fopen skPath 0 ulong pl 0 0
if lt fd 0
wStr 2 tErrIo
ret 1
end
kn = read int fd skInBuf 0 65535
z = fclose int fd
if le kn 0
wStr 2 tErrIo
ret 1
end
if not skParseSpec ulong kn
wStr 2 tErrIo
ret 1
end
ar = get skSt 1
id = ulong 999
if eq ar 1
id = solveScalar
end
if eq ar 2
id = solveBinary
end
if eq ar 3
id = solveTernary
end
if eq ar 4
id = solveFold
end
if eq ar 5
id = solveRewrite
end
if eq id 999
wStr 1 tFail
ret 1
end
if not skSaveOut 3
wStr 2 tErrIo
ret 1
end
wStr 1 tOk
if eq ar 1
wStr 1 fScalar
end
if eq ar 2
wStr 1 fBin
end
if eq ar 3
wStr 1 fTern
end
if eq ar 4
wStr 1 fFold
end
if eq ar 5
wStr 1 fRew
end
wStr 1 tId
wNum 1 id
wStr 1 tNl
ret 0
end

off = add add 5 mul i 3 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard2
rfNum off
rfWrt ard3
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end
rfWrt arb4
rfNum off
rfWrt arb5
rfWrt rfEnd
else
x = ulong 0
for j ulong 8
x = xor x add rfArVal j off
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfWrt rfOrArrArg
rfWrt rfOrChkB
rfNum x
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
thr = add add 1 mul i 2 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard4
rfNum thr
rfWrt ard5
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end
rfWrt arb6
rfNum thr
rfWrt arb7
rfWrt rfEnd
else
res = ulong 8
for j ulong 8
if gt rfArVal j thr
res = j
break
end
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfWrt rfOrArrArg
rfWrt rfOrChkB
rfNum res
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
mk = add add 13 mul i 7 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard6
rfNum mk
rfWrt ard7
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end
rfWrt arb8
rfNum mk
rfWrt arb9
rfWrt rfEnd
else
m = ulong 0
for j ulong 8
v = xor rfArVal j mk
if gt v m
m = v
end
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfWrt rfOrArrArg
rfWrt rfOrChkB
rfNum m
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
w = add add 2 i ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard8
rfNum w
rfWrt ard9
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end

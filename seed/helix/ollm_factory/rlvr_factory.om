note ==================== FAMILY 4: AR (fold, count, select, scan) ====================
text ard0 "the count of elements in a[0..n) strictly greater than "
text ard1 "the sum of elements in a[0..n) that are at least "
text ard2 "the XOR of (a[i] plus "
text ard3 ") for i in 0..n"
text ard4 "the index of the first element in a[0..n) greater than "
text ard5 ", or n if none"
text ard6 "the maximum of (a[i] XOR "
text ard7 ") over a[0..n)"
text ard8 "the weighted sum of (i + "
text ard9 ") * a[i] for i in 0..n"
text arb0 "c = ulong 0\nfor i ulong n bound 8\nif gt get a i "
text arb1 "\nc = add c 1\nend\nend\nret c"
text arb2 "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ge v "
text arb3 "\ns = add s v\nend\nend\nret s"
text arb4 "x = ulong 0\nfor i ulong n bound 8\nx = xor x add get a i "
text arb5 "\nend\nret x"
text arb6 "for i ulong n bound 8\nif gt get a i "
text arb7 "\nret i\nend\nend\nret n"
text arb8 "m = ulong 0\nfor i ulong n bound 8\nv = xor get a i "
text arb9 "\nif gt v m\nm = v\nend\nend\nret m"
text arb10 "s = ulong 0\nfor i ulong n bound 8\ns = add s mul add i "
text arb11 " get a i\nend\nret s"

fn rfArVal i ulong to ulong
if eq i 0
ret 3
end
if eq i 1
ret 11
end
if eq i 2
ret 0
end
if eq i 3
ret 7
end
if eq i 4
ret 19
end
if eq i 5
ret 4
end
if eq i 6
ret 2
end
ret 15
end

fn rfEmitArAll isMain bool to void
id = ulong 701
ro = mul sub get rfRound 0 1 2
for i ulong 12
thr = add add 2 i ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard0
rfNum thr
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end
rfWrt arb0
rfNum thr
rfWrt arb1
rfWrt rfEnd
else
c = ulong 0
for j ulong 8
if gt rfArVal j thr
c = add c 1
end
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfWrt rfOrArrArg
rfWrt rfOrChkB
rfNum c
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
thr = add add 3 i ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt ard1
rfNum thr
rfWrt rfFnAr
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAr
end
rfWrt arb2
rfNum thr
rfWrt arb3
rfWrt rfEnd
else
s = ulong 0
for j ulong 8
v = rfArVal j
if ge v thr
s = add s v
end
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfWrt rfOrArrArg
rfWrt rfOrChkB
rfNum s
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end


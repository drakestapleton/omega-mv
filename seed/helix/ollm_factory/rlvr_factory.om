note ==================== FAMILY 3: U3 (a ulong b ulong c ulong -> ulong) ====================
text u3d0 "a multiplied by b plus c plus "
text u3d1 "the smaller of (a plus b) and (c plus "
text u3d2 ")"
text u3d3 "(a XOR b XOR c) plus "
text u3d4 "the median of (a plus "
text u3d5 "), b, and c"
text u3d6 "a clamped between b and add b add c "
text u3b0 "ret add add mul a b c "
text u3b1 "x = add a b\ny = add c "
text u3b2 "\nif lt x y\nret x\nend\nret y"
text u3b3 "ret add xor xor a b c "
text u3b4 "x = add a "
text u3b5 "\ny = b\nz = c\nif gt x y\nt = x\nx = y\ny = t\nend\nif gt y z\nt = y\ny = z\nz = t\nend\nif gt x y\nt = x\nx = y\ny = t\nend\nret y"
text u3b6 "hi = add b add c "
text u3b7 "\nif lt a b\nret b\nend\nif gt a hi\nret hi\nend\nret a"


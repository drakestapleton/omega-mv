note ==================== FAMILY 5: AW (in-place array rewrites) ====================
text awd0 "add "
text awd1 " to every element of a[0..n) in place"
text awd2 "multiply every element of a[0..n) by "
text awd3 " and add "
text awd4 " in place"
text awd5 "replace every element of a[0..n) greater than "
text awd6 " with "
text awd7 "XOR every element of a[0..n) with "
text awd8 "replace every element of a[0..n) less than "
text awd9 "add index times "
text awd10 " to each element of a[0..n) in place"
text awb0 "for i ulong n bound 8\nput a i add get a i "
text awb1 "\nend"
text awb2 "for i ulong n bound 8\nput a i add mul get a i "
text awb3 " "
text awb4 "for i ulong n bound 8\nif gt get a i "
text awb5 "\nput a i "
text awb6 "\nend\nend"
text awb7 "for i ulong n bound 8\nput a i xor get a i "
text awb8 "for i ulong n bound 8\nif lt get a i "
text awb9 "for i ulong n bound 8\nput a i add get a i mul i "

fn rfEmitAwAll isMain bool to void
id = ulong 901
ro = mul sub get rfRound 0 1 2

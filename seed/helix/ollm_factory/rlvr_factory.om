rfWrt awb4
rfNum cap
rfWrt awb5
rfNum cap
rfWrt awb6
rfWrt rfEnd
else
v0 = ulong 3
if gt v0 cap
v0 = cap
end
v1 = ulong 11
if gt v1 cap
v1 = cap
end
v7 = ulong 15
if gt v7 cap
v7 = cap
end
exp = add v0 add v1 v7
rfWrt rfOrAwRst
rfNum id
rfWrt rfOrAwCall
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 16
flr = add add 3 i ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfWrt awd8
rfNum flr
rfWrt awd6
rfNum flr
rfWrt rfFnAw
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAw
end
rfWrt awb8
rfNum flr
rfWrt awb5
rfNum flr
rfWrt awb6
rfWrt rfEnd
else
v0 = ulong 3
if lt v0 flr
v0 = flr
end
v1 = ulong 11
if lt v1 flr
v1 = flr
end
v7 = ulong 15
if lt v7 flr
v7 = flr
end
exp = add v0 add v1 v7
rfWrt rfOrAwRst
rfNum id
rfWrt rfOrAwCall
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 16
msk = add add 19 mul i 13 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfWrt awd7
rfNum msk
rfWrt rfFnAw
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAw
end
rfWrt awb7
rfNum msk
rfWrt awb1
rfWrt rfEnd
else
exp = add xor ulong 3 msk add xor ulong 11 msk xor ulong 15 msk
rfWrt rfOrAwRst
rfNum id
rfWrt rfOrAwCall
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 16
st = add add 2 mul i 3 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfWrt awd9
rfNum st
rfWrt awd10
rfWrt rfFnAw
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigAw
end
rfWrt awb9
rfNum st
rfWrt awb1
rfWrt rfEnd
else
v0 = add ulong 3 mul ulong 0 st
v1 = add ulong 11 mul ulong 1 st
v7 = add ulong 15 mul ulong 7 st
exp = add v0 add v1 v7
rfWrt rfOrAwRst
rfNum id
rfWrt rfOrAwCall
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end
end

note ==================== REPAIR & HELIX PROOF SPECIALIST CORPUS ====================
text repRec1 "note repair omc-error-12 split chained boolean guards and return clamped sum\nfn solve a ulong b ulong to ulong\ns = add a b\nif lt s 10\nret 10\nend\nif gt s 500\nret 500\nend\nret s\nend\n\n"
text repRec2 "note repair omc-error-22 explicit bound on dynamic while loop returning bit length\nfn solve a ulong to ulong\nx = a\nc = ulong 0\nwhile gt x 0 bound 64\nx = shr x 1\nc = add c 1\nend\nret c\nend\n\n"
text repRec3 "note repair antibody-13 pin branch target basic block leaders before swapping SM121 instructions\nfn solve a ulong b ulong to ulong\nif eq and a 1 0\nret add mul a 3 b\nend\nret add mul a 5 b\nend\n\n"
text repRec4 "note repair antibody-14 enforce SM121 6-cycle fixed-latency ALU RAW floor before VRAM upload\nfn solve a ulong b ulong to ulong\nif lt a 6\nret 6\nend\nif lt a b\nret a\nend\nret b\nend\n\n"
text repRec5 "note repair antibody-15 never compact fixed-latency I2F stalls below rawFloor 6\nfn solve a ulong to ulong\nif eq a 31\nret 6\nend\nif lt a 6\nret 6\nend\nret a\nend\n\n"
text repRec6 "note repair egp2-fma-fuse fold mul a b plus c with constant zero identity\nfn solve a ulong b ulong c ulong to ulong\np = mul a b\nif eq c 0\nret p\nend\nret add p c\nend\n\n"
text repRec7 "note repair omc-noend always close every if and for block with matching end before ret\nfn solve a view ulong 8 n ulong to ulong\ns = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne and v 1 0\ns = add s v\nend\nend\nret s\nend\n\n"
text repRec8 "note repair array-inplace-rewrite reverse elements of a[0..n) without out-of-bounds index\nfn solve a edit ulong 8 n ulong to void\ni = ulong 0\nwhile lt add mul i 2 1 n bound 8\nj = sub sub n 1 i\nt = get a i\nput a i get a j\nput a j t\ni = add i 1\nend\nend\n\n"

fn rfEmitRepairCorpus to void
rfWrt repRec1
rfWrt repRec2
rfWrt repRec3
rfWrt repRec4
rfWrt repRec5
rfWrt repRec6
rfWrt repRec7
rfWrt repRec8
end

fn rfProbeLiveTeacher to void
sa = new uchar 16 0
req = new uchar 1024 0
buf = new uchar 2048 0
fd = socknew 2 1 0
if lt fd 0
rfWrt rfTeaOff
ret
end
put sa 0 2
put sa 1 0
put sa 2 70
put sa 3 179
put sa 4 127
put sa 5 0
put sa 6 0
put sa 7 1
cr = connect int fd sa 0 16
if lt cr 0
z = fclose int fd
rfWrt rfTeaOff
ret
end
p = ulong 0
for i ulong len rfTcpReq bound 1024
c = get rfTcpReq i
if and eq c 10 lt p 1020
put req p 13
p = add p 1
end
if lt p 1022
put req p c
p = add p 1
end
end
wr = write int fd req 0 p
tot = ulong 0
for it ulong 16
r = read int fd buf tot sub 2048 tot
if le r 0
break
end
tot = add tot ulong r
if ge tot 2048
break
end
end
cl = fclose int fd
rfWrt rfTeaOn
rfNum tot
rfWrt rfNl
if gt tot 0
w = write 1 buf 0 tot
rfWrt rfNl
end
end

text argCorpus "corpus"
text argOracle "oracle"
text argRepair "repair"
text argTeacher "teacher"

fn main to int
ab = new uchar 32 0
rb = new uchar 16 0
mode = ulong 0
rnd = ulong 1
if ge argcnt 2
alr = argread 1 ab 0 32
al = ulong 0
if gt alr 0
al = ulong alr
end
if rfEqArg ab al argOracle
mode = 1
else
if rfEqArg ab al argRepair
mode = 2
else
if rfEqArg ab al argTeacher
mode = 3
end
end
end
end
if ge argcnt 3
rlr = argread 2 rb 0 16
if gt rlr 0
ch = ulong get rb 0
if and ge ch 49 le ch 57
rnd = sub ch 48
end
end
end
put rfMode 0 mode
put rfRound 0 rnd
if eq mode 3
rfProbeLiveTeacher
ret 0
end
if eq mode 2
rfEmitRepairCorpus
ret 0
end
if eq mode 1
rfWrt rfOm2
rfEmitU1All false
rfEmitU2All false
rfEmitU3All false
rfEmitArAll false
rfEmitAwAll false
rfWrt rfOrMainH
rfEmitU1All true
rfEmitU2All true
rfEmitU3All true
rfEmitArAll true
rfEmitAwAll true
rfWrt rfOrMainT
ret 0
end
rfEmitU1All false
rfEmitU2All false
rfEmitU3All false
rfEmitArAll false
rfEmitAwAll false
rfEmitRepairCorpus
ret 0
end

rfWrt rfOrSigAw
end
rfWrt awb0
rfNum k
rfWrt awb1
rfWrt rfEnd
else
exp = add add add ulong 3 k add ulong 11 k add ulong 15 k
rfWrt rfOrAwRst
rfNum id
rfWrt rfOrAwCall
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end

om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_factory.om:
note Pure seeded OM-2 Mechanical RLVR Data & Error-to-Fix Repair Factory for Omega LLM.
note
note Generates a rich, compositional, multi-phrasing corpus of OM-2 functions covering ALL 10
note coding skill families (`arith, branch, loop, bits, digits, fold, select, count, scan, rewrite`)
note across all 5 signature shapes (`u1`, `u2`, `u3`, `ar`, `aw`) PLUS verified error-to-fix repair
note and Helix SM121/EGP2 proof records. Every emitted function has a corresponding exact ground-truth
note assertion in `oracle` mode so BOTH Strand A and Strand B compile & execute 100% of records!
note
note Modes (argv[1]):
note   corpus [round] -> emits mechanically verified OM-2 training corpus (`round=1` default,
note                     `round=2` shifts constants + Arboris-boosted failure-family focus)
note   oracle [round] -> emits self-checking `om2` oracle compiling & executing 100% of functions
note   repair         -> emits verified error-to-fix repair + Helix SM121/EGP2 proof specialist records
note   teacher        -> live native Omega TCP request to 35B `q36-serve` on `127.0.0.1:18099`

text rfOm2 "om2\n"
text rfNote "note "
text rfFnU1 "\nfn solve a ulong to ulong\n"
text rfFnU2 "\nfn solve a ulong b ulong to ulong\n"
text rfFnU3 "\nfn solve a ulong b ulong c ulong to ulong\n"
text rfFnAr "\nfn solve a view ulong 8 n ulong to ulong\n"
text rfFnAw "\nfn solve a edit ulong 8 n ulong to void\n"
text rfEnd "\nend\n\n"
text rfNl "\n"

text rfV0 "return "
text rfV1 "compute "
text rfV2 "find "
text rfV3 "give "

text rfOrFnPfx "fn f_"
text rfOrSigU1 " a ulong to ulong\n"
text rfOrSigU2 " a ulong b ulong to ulong\n"
text rfOrSigU3 " a ulong b ulong c ulong to ulong\n"
text rfOrSigAr " a view ulong 8 n ulong to ulong\n"
text rfOrSigAw " a edit ulong 8 n ulong to void\n"
text rfOrMainH "fn main to int\narr = new ulong 8 0\nput arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\nok = ulong 0\n"
text rfOrChkA "if ne f_"
text rfOrChkB " "
text rfOrChkC "\nexit "
text rfOrChkD "\nend\nok = add ok 1\n"
text rfOrAwRst "put arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\nf_"
text rfOrAwCall " arr 8\nif ne add get arr 0 add get arr 1 get arr 7 "
text rfOrMainT "ret 0\nend\n"
text rfOrArrArg "arr 8"

text rfTcpReq "POST /v1/chat/completions HTTP/1.1\nHost: 127.0.0.1\nContent-Type: application/json\nContent-Length: 318\nConnection: close\n\n{\"model\":\"qwen3.6-35b-a3b\",\"max_tokens\":96,\"temperature\":0,\"messages\":[{\"role\":\"user\",\"content\":\"Omega OM-2 syntax uses prefix ops (add, sub, mul, div, rem, and, or, xor, shl, shr, eq, lt, gt) and blocks closed by end. Example:\\nfn solve a ulong to ulong\\nret add mul a 3 1\\nend\\nNow write ONLY:\\nfn solve a ulong to ulong returning a*17+5.\"}]}"
text rfTeaOff "RLVR_TEACHER connected=0 mode=deterministic_curriculum\n"
text rfTeaOn  "RLVR_TEACHER connected=1 bytes="

global rfMode ulong 1
global rfRound ulong 1

fn rfWrt s view uchar * to void
r = write 1 s 0 len s
end

fn rfNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn rfVerb v ulong to void
m = rem v 4
if eq m 0
rfWrt rfV0
end
if eq m 1
rfWrt rfV1
end
if eq m 2
rfWrt rfV2
end
if eq m 3
rfWrt rfV3
end
end

fn rfEqArg a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

note ==================== FAMILY 1: U1 (arith, branch, bits, digits, loops) ====================
text u1d_aff0 "a multiplied by "
text u1d_aff1 " plus "
text u1d_sq0 "a squared plus "
text u1d_sq1 " times a plus "
text u1d_xor0 "a XORed with "
text u1d_clp0 "a clamped to the range ["
text u1d_clp1 ", "
text u1d_clp2 "]"
text u1d_mod0 "the remainder when (a plus "
text u1d_mod1 ") is divided by "
text u1d_sh0 "(a shifted right by "
text u1d_sh1 ") plus (a masked with "
text u1d_sh2 ")"
text u1d_div0 "1 if a is divisible by "
text u1d_div1 " else 0"
text u1d_cdiv0 "ceiling of (a divided by "
text u1d_cdiv1 ")"
text u1d_rnd0 "a rounded down to a multiple of "
text u1d_bit0 "1 if bit "
text u1d_bit1 " of a is set else 0"
text u1d_tbit0 "a with bit "
text u1d_tbit1 " toggled"
text u1d_sbit0 "a with bit "
text u1d_sbit1 " set"
text u1d_dig0 "the sum of digits of a in base "
text u1d_dig1 "the count of digits of a in base "
text u1d_dig2 "the largest digit of a in base "
text u1d_loop0 "the sum of squares of 0..((a mod "
text u1d_loop1 ") - 1)"
text u1d_loop2 "the count of 1-bits in (a XOR "
text u1d_loop3 ")"
text u1d_loop4 "the integer square root of (a plus "
text u1d_loop5 ")"

text u1b_aff0 "ret add mul a "
text u1b_spc  " "
text u1b_sq0  "ret add add mul a a mul a "
text u1b_xor0 "ret xor a "
text u1b_clp0 "if lt a "
text u1b_ret  "\nret "
text u1b_clp1 "\nend\nif gt a "
text u1b_clp2 "\nend\nret a"
text u1b_mod0 "ret rem add a "
text u1b_sh0  "ret add shr a "
text u1b_sh1  " and a "
text u1b_div0 "if eq rem a "
text u1b_div1 " 0\nret 1\nend\nret 0"
text u1b_cdiv0 "ret div add a "
text u1b_rnd0 "ret sub a rem a "
text u1b_bit0 "ret and shr a "
text u1b_bit1 " 1"
text u1b_tbit0 "ret xor a shl ulong 1 "
text u1b_sbit0 "ret or a shl ulong 1 "
text u1b_digs0 "x = a\ns = ulong 0\nwhile gt x 0 bound 64\ns = add s rem x "
text u1b_digs1 "\nx = div x "
text u1b_digs2 "\nend\nret s"
text u1b_digc0 "if eq a 0\nret 1\nend\nx = a\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c 1\nx = div x "
text u1b_digc1 "\nend\nret c"
text u1b_digm0 "x = a\nm = ulong 0\nwhile gt x 0 bound 64\nd = rem x "
text u1b_digm1 "\nif gt d m\nm = d\nend\nx = div x "
text u1b_digm2 "\nend\nret m"
text u1b_lsq0 "k = rem a "
text u1b_lsq1 "\ns = ulong 0\nfor i ulong k bound 64\ns = add s mul i i\nend\nret s"
text u1b_pop0 "x = xor a "
text u1b_pop1 "\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c"
text u1b_isq0 "t = add a "
text u1b_isq1 "\nr = ulong 0\nwhile le mul add r 1 add r 1 t bound 1024\nr = add r 1\nend\nret r"

fn rfEmitU1All isMain bool to void
id = ulong 1
ro = mul sub get rfRound 0 1 2
note 1a. 24 affine transforms a*k + c
for ki ulong 6
k = add add 7 mul ki 4 ro
for ci ulong 4
c = add add 5 mul ci 6 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_aff0
rfNum k
rfWrt u1d_aff1
rfNum c
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_aff0
rfNum k
rfWrt u1b_spc
rfNum c
rfWrt rfEnd
else
exp = add mul ulong 37 k c
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end
end

note 1b. 12 quadratics: a*a + k*a + c
for i ulong 12
k = add add 3 mul i 2 ro
c = add add 7 mul i 3 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_sq0
rfNum k
rfWrt u1d_sq1
rfNum c
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_sq0
rfNum k
rfWrt u1b_spc
rfNum c
rfWrt rfEnd
else
exp = add add mul ulong 37 37 mul ulong 37 k c
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1c. 12 XOR masks
for mi ulong 12
msk = add add 85 mul mi 37 mul ro 11
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_xor0
rfNum msk
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_xor0
rfNum msk
rfWrt rfEnd
else
exp = xor ulong 37 msk
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1d. 16 range clamps [lo, hi]
for ri ulong 16
lo = add add 13 mul ri 7 ro
hi = add lo add 41 mul ri 11
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_clp0
rfNum lo
rfWrt u1d_clp1
rfNum hi
rfWrt u1d_clp2
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_clp0
rfNum lo
rfWrt u1b_ret
rfNum lo
rfWrt u1b_clp1
rfNum hi
rfWrt u1b_ret
rfNum hi
rfWrt u1b_clp2
rfWrt rfEnd
else
exp = ulong 37
if lt exp lo
exp = lo
end
if gt exp hi
exp = hi
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1e. 12 modular offsets: (a + off) % md
for mi ulong 12
off = add add 17 mul mi 5 ro
md = add add 19 mul mi 6 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_mod0
rfNum off
rfWrt u1d_mod1
rfNum md
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_mod0
rfNum off
rfWrt u1b_spc
rfNum md
rfWrt rfEnd
else
exp = rem add ulong 37 off md
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1f. 12 shift+mask splits
for si ulong 12
sh = add 2 rem si 5
mk = add add 31 mul si 17 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_sh0
rfNum sh
rfWrt u1d_sh1
rfNum mk
rfWrt u1d_sh2
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_sh0
rfNum sh
rfWrt u1b_sh1
rfNum mk
rfWrt rfEnd
else
exp = add shr ulong 37 sh and ulong 37 mk
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1g. 12 divisibility checks (a % d == 0) + 12 ceil-div + 12 round-down to multiple of d
for i ulong 12
d = add add 7 mul i 4 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_div0
rfNum d
rfWrt u1d_div1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_div0
rfNum d
rfWrt u1b_div1
rfWrt rfEnd
else
exp = ulong 0
if eq rem ulong 37 d 0
exp = 1
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
d = add add 5 mul i 3 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_cdiv0
rfNum d
rfWrt u1d_cdiv1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_cdiv0
rfNum sub d 1
rfWrt u1b_spc
rfNum d
rfWrt rfEnd
else
exp = div add ulong 37 sub d 1 d
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 12
d = add add 6 mul i 5 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_rnd0
rfNum d
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_rnd0
rfNum d
rfWrt rfEnd
else
exp = sub ulong 37 rem ulong 37 d
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1h. 24 bit test / toggle / set ops (bits 2..9)
for i ulong 8
bt = add 2 i
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_bit0
rfNum bt
rfWrt u1d_bit1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_bit0
rfNum bt
rfWrt u1b_bit1
rfWrt rfEnd
else
exp = and shr ulong 37 bt 1
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
bt = add 2 i
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_tbit0
rfNum bt
rfWrt u1d_tbit1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_tbit0
rfNum bt
rfWrt rfEnd
else
exp = xor ulong 37 shl ulong 1 bt
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
bt = add 2 i
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_sbit0
rfNum bt
rfWrt u1d_sbit1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_sbit0
rfNum bt
rfWrt rfEnd
else
exp = or ulong 37 shl ulong 1 bt
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum exp
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1i. 24 base-B digit sum / count / max (bases 3,4,5,6,7,8,9,12 -- deliberately non-10 so zero overlap with bench!)
for i ulong 8
bs = add 3 i
if eq bs 10
bs = 12
end
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_dig0
rfNum bs
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_digs0
rfNum bs
rfWrt u1b_digs1
rfNum bs
rfWrt u1b_digs2
rfWrt rfEnd
else
x = ulong 37
s = ulong 0
while gt x 0 bound 64
s = add s rem x bs
x = div x bs
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum s
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
bs = add 3 i
if eq bs 10
bs = 12
end
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_dig1
rfNum bs
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_digc0
rfNum bs
rfWrt u1b_digc1
rfWrt rfEnd
else
x = ulong 37
c = ulong 0
while gt x 0 bound 64
c = add c 1
x = div x bs
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum c
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
bs = add 3 i
if eq bs 10
bs = 12
end
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_dig2
rfNum bs
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_digm0
rfNum bs
rfWrt u1b_digm1
rfNum bs
rfWrt u1b_digm2
rfWrt rfEnd
else
x = ulong 37
m = ulong 0
while gt x 0 bound 64
dg = rem x bs
if gt dg m
m = dg
end
x = div x bs
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum m
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

note 1j. 24 iterative loops: sum-of-squares, popcount(a^k), isqrt(a+k)
for i ulong 8
md = add add 7 mul i 3 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_loop0
rfNum md
rfWrt u1d_loop1
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_lsq0
rfNum md
rfWrt u1b_lsq1
rfWrt rfEnd
else
k = rem ulong 37 md
s = ulong 0
for j ulong k bound 64
s = add s mul j j
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum s
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
mk = add add 45 mul i 23 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_loop2
rfNum mk
rfWrt u1d_loop3
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_pop0
rfNum mk
rfWrt u1b_pop1
rfWrt rfEnd
else
x = xor ulong 37 mk
c = ulong 0
while gt x 0 bound 64
c = add c and x 1
x = shr x 1
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum c
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end

for i ulong 8
off = add add 11 mul i 17 ro
if not isMain
if eq get rfMode 0 0
rfWrt rfNote
rfVerb id
rfWrt u1d_loop4
rfNum off
rfWrt u1d_loop5
rfWrt rfFnU1
else
rfWrt rfOrFnPfx
rfNum id
rfWrt rfOrSigU1
end
rfWrt u1b_isq0
rfNum off
rfWrt u1b_isq1
rfWrt rfEnd
else
t = add ulong 37 off
r = ulong 0
while le mul add r 1 add r 1 t bound 1024
r = add r 1
end
rfWrt rfOrChkA
rfNum id
rfWrt rfOrChkB
rfNum 37
rfWrt rfOrChkB
rfNum r
rfWrt rfOrChkC
rfNum add 10 rem id 80
rfWrt rfOrChkD
end
id = add id 1
end
end

note ==================== FAMILY 2: U2 (a ulong b ulong -> ulong) ====================
text u2d0 " times a plus "
text u2d1 " times b"
text u2d2 "the larger of (a plus "
text u2d3 ") and (b multiplied by "
text u2d4 ")"
text u2d5 "the smaller of (a multiplied by "
text u2d6 ") and (b plus "
text u2d7 "(a XOR b) masked with "
text u2d8 "the sum of integers from a to a plus (b mod "
text u2d9 ") exclusive"
text u2d10 "the saturating difference max(0, a minus b minus "
text u2d11 "the GCD of (a plus "
text u2d12 ") and (b plus "
text u2d13 "the Hamming distance between a and (b XOR "
text u2b0 "ret add mul a "
text u2b1 " mul b "
text u2b2 "x = add a "
text u2b3 "\ny = mul b "
text u2b4 "\nif gt x y\nret x\nend\nret y"
text u2b5 "x = mul a "
text u2b6 "\ny = add b "
text u2b7 "\nif lt x y\nret x\nend\nret y"
text u2b8 "ret and xor a b "
text u2b9 "k = rem b "
text u2b10 "\ns = ulong 0\nfor i ulong k bound 64\ns = add s add a i\nend\nret s"
text u2b11 "t = add b "
text u2b12 "\nif gt a t\nret sub a t\nend\nret 0"
text u2b13 "x = add a "
text u2b14 "\ny = add b "
text u2b15 "\nwhile gt y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret x"
text u2b16 "x = xor a xor b "
text u2b17 "\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c"


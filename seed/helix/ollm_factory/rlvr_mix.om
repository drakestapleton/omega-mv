om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_mix.om:
note Pure seeded OM-2 NUL-delimited RLVR Corpus Mixer, Fisher-Yates Shuffler,
note and Wide Repo-Rehearsal Blender. Replaces build_mix.py with a static
note zero-dependency AArch64 ELF compiled by seed/out/omc.
note
note Usage:
note   rlvr_mix SEED REPO_PCT EPOCHS REPO_OM OUT_MIX OUT_AUDIT SRC1 W1 [SRC2 W2 ...]

global mxRng ulong 1
global mxState ulong 8
note mxState[0]=nDocs, [1]=rlvrBytes, [2]=repoBytes, [3]=nRepo, [4]=epochs, [5]=repoPct, [6]=outBytes
global mxSrcBuf uchar 8388608
global mxRepoBuf uchar 16777216
global mxKind ulong 262144
global mxOff ulong 262144
global mxLen ulong 262144
global mxRepoOff ulong 65536
global mxRepoLen ulong 65536
global mxPathBuf uchar 512
global mxArgBuf uchar 512
global mxByteBuf uchar 2

text mxMsgUsage "usage: rlvr_mix SEED REPO_PCT EPOCHS REPO_OM OUT_MIX OUT_AUDIT SRC1 W1 ...\n"
text mxMsgOk "RLVR_MIX_OK docs="
text mxMsgRlvr " rlvr_bytes="
text mxMsgRepo " repo_bytes="
text mxMsgTot " total_bytes="
text mxNl "\n"

fn mxWrt fd int s view uchar * to void
r = write fd s 0 len s
end

fn mxNum fd int v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd b p sub 24 p
end

fn mxParseArg n ulong to ulong
v = ulong 0
for i ulong n bound 32
c = ulong get mxArgBuf i
if and ge c 48 le c 57
v = add mul v 10 sub c 48
else
break
end
end
ret v
end

fn mxRand to ulong
x = get mxRng 0
if eq x 0
x = ulong 88172645463325252
end
x = xor x shl x 13
x = xor x shr x 7
x = xor x shl x 17
put mxRng 0 x
ret x
end

fn mxReadSrc plen ulong dstOff ulong to long
cap = ulong 8388608
fd = int fopen mxPathBuf 0 plen 0 0
if lt fd 0
ret sub long 0 1
end
tot = ulong 0
while lt add dstOff tot cap bound 1048576
remCap = sub cap add dstOff tot
chunk = ulong 65536
if lt remCap chunk
chunk = remCap
end
r = read fd mxSrcBuf add dstOff tot chunk
if le r 0
break
end
tot = add tot ulong r
end
c = fclose fd
ret long tot
end

fn mxReadRepo plen ulong to long
cap = ulong 16777216
fd = int fopen mxPathBuf 0 plen 0 0
if lt fd 0
ret sub long 0 1
end
tot = ulong 0
while lt tot cap bound 1048576
remCap = sub cap tot
chunk = ulong 65536
if lt remCap chunk
chunk = remCap
end
r = read fd mxRepoBuf tot chunk
if le r 0
break
end
tot = add tot ulong r
end
c = fclose fd
ret long tot
end

fn mxAddDoc p ulong dlen ulong reps ulong to void
nDocs = get mxState 0
rlvrBytes = get mxState 1
for r ulong reps bound 256
if lt nDocs 262144
put mxKind nDocs 0
put mxOff nDocs p
put mxLen nDocs dlen
nDocs = add nDocs 1
rlvrBytes = add rlvrBytes add dlen 1
end
end
put mxState 0 nDocs
put mxState 1 rlvrBytes
end

fn mxIndexSrc audFd int sStart ulong sEnd ulong wgt ulong to void
reps = mul wgt get mxState 4
p = sStart
while lt p sEnd bound 1048576
q = p
while lt q sEnd bound 1048576
if eq get mxSrcBuf q 0
break
end
q = add q 1
end
dlen = sub q p
if ge dlen 12
w = write audFd mxSrcBuf p dlen
w = write audFd mxByteBuf 1 1
mxAddDoc p dlen reps
end
p = add q 1
end
end

fn mxLoadSources to int
audPlen = ulong argread 6 mxPathBuf 0 512
audFd = int fopen mxPathBuf 0 audPlen 577 420
if lt audFd 0
ret 2
end
put mxByteBuf 0 0
put mxByteBuf 1 10
put mxState 0 0
put mxState 1 0

srcOff = ulong 0
ai = ulong 7
argc = ulong argcnt
while lt add ai 1 argc bound 64
spl = ulong argread ai mxPathBuf 0 512
wl = ulong argread add ai 1 mxArgBuf 0 512
wgt = mxParseArg wl
if eq wgt 0
wgt = 1
end
got = mxReadSrc spl srcOff
if gt got 0
sEnd = add srcOff ulong got
mxIndexSrc audFd srcOff sEnd wgt
srcOff = sEnd
end
ai = add ai 2
end
ca = fclose audFd
ret 0
end

fn mxLoadRepo to void
repoPlen = ulong argread 4 mxPathBuf 0 512
rGot = mxReadRepo repoPlen
nRepo = ulong 0
if gt rGot 0
rEnd = ulong rGot
p = ulong 0
while lt p rEnd bound 1048576
q = p
while lt q rEnd bound 1048576
if eq get mxRepoBuf q 0
break
end
q = add q 1
end
dlen = sub q p
if and ge dlen 20 lt nRepo 65536
put mxRepoOff nRepo p
put mxRepoLen nRepo dlen
nRepo = add nRepo 1
end
p = add q 1
end
end
if gt nRepo 1
i = sub nRepo 1
while gt i 0 bound 65536
j = rem mxRand add i 1
tmpO = get mxRepoOff i
tmpL = get mxRepoLen i
put mxRepoOff i get mxRepoOff j
put mxRepoLen i get mxRepoLen j
put mxRepoOff j tmpO
put mxRepoLen j tmpL
i = sub i 1
end
end
put mxState 3 nRepo
end

fn mxShuffleDocs to void
nDocs = get mxState 0
if gt nDocs 1
i = sub nDocs 1
while gt i 0 bound 262144
j = rem mxRand add i 1
tmpK = get mxKind i
tmpO = get mxOff i
tmpL = get mxLen i
put mxKind i get mxKind j
put mxOff i get mxOff j
put mxLen i get mxLen j
put mxKind j tmpK
put mxOff j tmpO
put mxLen j tmpL
i = sub i 1
end
end
end

fn mxPickAndShuffle to void
nDocs = get mxState 0
rlvrBytes = get mxState 1
nRepo = get mxState 3
repoPct = get mxState 5
targetRepo = div mul rlvrBytes repoPct sub 100 repoPct
repoBytes = ulong 0
if gt nRepo 0
ri = ulong 0
while lt repoBytes targetRepo bound 65536
if ge nDocs 262144
break
end
idx = rem ri nRepo
dlen = get mxRepoLen idx
put mxKind nDocs 1
put mxOff nDocs get mxRepoOff idx
put mxLen nDocs dlen
nDocs = add nDocs 1
repoBytes = add repoBytes add dlen 1
ri = add ri 1
end
end
put mxState 0 nDocs
put mxState 2 repoBytes
mxShuffleDocs
end

fn mxWriteMix to int
mixPlen = ulong argread 5 mxPathBuf 0 512
mixFd = int fopen mxPathBuf 0 mixPlen 577 420
if lt mixFd 0
ret 3
end
nDocs = get mxState 0
outPos = ulong 0
for i ulong nDocs bound 262144
k = get mxKind i
o = get mxOff i
l = get mxLen i
if eq k 0
w = write mixFd mxSrcBuf o l
else
w = write mixFd mxRepoBuf o l
end
wn = write mixFd mxByteBuf 0 1
outPos = add outPos add l 1
end
cm = fclose mixFd
put mxState 6 outPos
ret 0
end

fn main to int
if lt ulong argcnt 9
mxWrt 2 mxMsgUsage
ret 1
end
l1 = ulong argread 1 mxArgBuf 0 512
seed = mxParseArg l1
if eq seed 0
seed = ulong 20261124
end
put mxRng 0 seed

l2 = ulong argread 2 mxArgBuf 0 512
rp = mxParseArg l2
if gt rp 90
rp = 90
end
put mxState 5 rp

l3 = ulong argread 3 mxArgBuf 0 512
ep = mxParseArg l3
if eq ep 0
ep = 1
end
put mxState 4 ep

rc1 = mxLoadSources
if ne rc1 0
ret rc1
end
mxLoadRepo
mxPickAndShuffle
rc2 = mxWriteMix
if ne rc2 0
ret rc2
end

mxWrt 1 mxMsgOk
mxNum 1 get mxState 0
mxWrt 1 mxMsgRlvr
mxNum 1 get mxState 1
mxWrt 1 mxMsgRepo
mxNum 1 get mxState 2
mxWrt 1 mxMsgTot
mxNum 1 get mxState 6
mxWrt 1 mxNl
ret 0
end

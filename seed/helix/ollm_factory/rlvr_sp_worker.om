om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_sp_worker.om:
note Pure seeded OM-2 Self-Play Candidate Cleaner & Equivalence Harness Builder.
note Replaces selfplay_p2.py's candidate parser and harness generator with a static
note zero-dependency AArch64 ELF compiled by seed/out/omc.
note
note Usage:
note   rlvr_sp_worker REC_FILE CAND_FILE OUT_HARNESS OUT_CLEAN_REC
note
note Exits 0 if a well-formed balanced `fn solve ... end` was extracted and an
note equivalence harness (`ref_solve` vs `cand_solve`) was written; exits 1 otherwise.

global spRec uchar 16384
global spCand uchar 16384
global spOut uchar 32768
global spPath uchar 512
global spSt ulong 12
note spSt[0]=recLen, [1]=candLen, [2]=noteStart, [3]=noteLen, [4]=fnStart, [5]=fnLineLen, [6]=shape, [7]=outLen, [8]=cleanEnd

text tOm2 "om2\n"
text tRefPfx "fn ref_solve "
text tCandPfx "fn cand_solve "
text tFnSolve "fn solve "
text tNote "note "
text tSig1 "fn solve a ulong to ulong"
text tSig2 "fn solve a ulong b ulong to ulong"
text tSig3 "fn solve a ulong b ulong c ulong to ulong"
text tSig4 "fn solve a view ulong 8 n ulong to ulong"
text tSig5 "fn solve a edit ulong 8 n ulong to void"

text tMain1 "fn main to int\nif ne ref_solve 0 cand_solve 0\nexit 1\nend\nif ne ref_solve 1 cand_solve 1\nexit 1\nend\nif ne ref_solve 2 cand_solve 2\nexit 1\nend\nif ne ref_solve 5 cand_solve 5\nexit 1\nend\nif ne ref_solve 13 cand_solve 13\nexit 1\nend\nif ne ref_solve 42 cand_solve 42\nexit 1\nend\nif ne ref_solve 99 cand_solve 99\nexit 1\nend\nif ne ref_solve 255 cand_solve 255\nexit 1\nend\nret 0\nend\n"
text tMain2 "fn main to int\nif ne ref_solve 0 0 cand_solve 0 0\nexit 1\nend\nif ne ref_solve 1 2 cand_solve 1 2\nexit 1\nend\nif ne ref_solve 5 3 cand_solve 5 3\nexit 1\nend\nif ne ref_solve 12 7 cand_solve 12 7\nexit 1\nend\nif ne ref_solve 0 9 cand_solve 0 9\nexit 1\nend\nif ne ref_solve 19 19 cand_solve 19 19\nexit 1\nend\nif ne ref_solve 42 11 cand_solve 42 11\nexit 1\nend\nif ne ref_solve 100 23 cand_solve 100 23\nexit 1\nend\nret 0\nend\n"
text tMain3 "fn main to int\nif ne ref_solve 0 0 0 cand_solve 0 0 0\nexit 1\nend\nif ne ref_solve 1 2 3 cand_solve 1 2 3\nexit 1\nend\nif ne ref_solve 9 4 7 cand_solve 9 4 7\nexit 1\nend\nif ne ref_solve 15 15 5 cand_solve 15 15 5\nexit 1\nend\nif ne ref_solve 3 12 8 cand_solve 3 12 8\nexit 1\nend\nif ne ref_solve 20 1 30 cand_solve 20 1 30\nexit 1\nend\nret 0\nend\n"
text tMain4 "fn main to int\narr = new ulong 8 0\nput arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\nif ne ref_solve arr 0 cand_solve arr 0\nexit 1\nend\nif ne ref_solve arr 4 cand_solve arr 4\nexit 1\nend\nif ne ref_solve arr 8 cand_solve arr 8\nexit 1\nend\nret 0\nend\n"
text tMain5 "fn main to int\na1 = new ulong 8 0\na2 = new ulong 8 0\nput a1 0 3\nput a1 1 11\nput a1 2 0\nput a1 3 7\nput a1 4 19\nput a1 5 4\nput a1 6 2\nput a1 7 15\nput a2 0 3\nput a2 1 11\nput a2 2 0\nput a2 3 7\nput a2 4 19\nput a2 5 4\nput a2 6 2\nput a2 7 15\nref_solve a1 8\ncand_solve a2 8\nfor i ulong 8 bound 8\nif ne get a1 i get a2 i\nexit 1\nend\nend\nret 0\nend\n"

fn spReadRec argIdx ulong to long
pl = ulong argread argIdx spPath 0 512
fd = int fopen spPath 0 pl 0 0
if lt fd 0
ret sub long 0 1
end
tot = ulong 0
while lt tot 16380 bound 256
r = read fd spRec tot sub 16380 tot
if le r 0
break
end
tot = add tot ulong r
end
c = fclose fd
ret long tot
end

fn spReadCand argIdx ulong to long
pl = ulong argread argIdx spPath 0 512
fd = int fopen spPath 0 pl 0 0
if lt fd 0
ret sub long 0 1
end
tot = ulong 0
while lt tot 16380 bound 256
r = read fd spCand tot sub 16380 tot
if le r 0
break
end
tot = add tot ulong r
end
c = fclose fd
ret long tot
end

fn spOutByte b uchar to void
p = get spSt 7
if lt p 32764
put spOut p b
put spSt 7 add p 1
end
end

fn spOutText s view uchar * to void
n = len s
for i ulong n bound 2048
spOutByte get s i
end
end

fn spRecEq off ulong slen ulong s view uchar * to bool
if ne slen len s
ret false
end
for i ulong slen bound 128
if ne get spRec add off i get s i
ret false
end
end
ret true
end

fn spRecStarts off ulong slen ulong s view uchar * to bool
nl = len s
if lt slen nl
ret false
end
for i ulong nl bound 64
if ne get spRec add off i get s i
ret false
end
end
ret true
end

fn spCandStarts off ulong slen ulong s view uchar * to bool
nl = len s
if lt slen nl
ret false
end
for i ulong nl bound 64
if ne get spCand add off i get s i
ret false
end
end
ret true
end

text tKwFn "fn "
text tKwIf "if "
text tKwFor "for "
text tKwWhile "while "
text tKwEnd "end"

fn spParseRec to int
n = get spSt 0
hasNote = ulong 0
hasFn = ulong 0
p = ulong 0
while lt p n bound 512
q = p
while lt q n bound 2048
c = get spRec q
if or eq c 10 eq c 0
break
end
q = add q 1
end
ll = sub q p
if and eq hasNote 0 spRecStarts p ll tNote
put spSt 2 p
put spSt 3 ll
hasNote = 1
end
if and eq hasFn 0 spRecStarts p ll tFnSolve
put spSt 4 p
put spSt 5 ll
hasFn = 1
if spRecEq p ll tSig1
put spSt 6 1
end
if spRecEq p ll tSig2
put spSt 6 2
end
if spRecEq p ll tSig3
put spSt 6 3
end
if spRecEq p ll tSig4
put spSt 6 4
end
if spRecEq p ll tSig5
put spSt 6 5
end
end
p = add q 1
end
if or eq hasNote 0 eq hasFn 0
ret 1
end
if eq get spSt 6 0
ret 1
end
ret 0
end

fn spEmitRefFn to void
fnSt = get spSt 4
fnLl = get spSt 5
recN = get spSt 0
spOutText tRefPfx
for i ulong sub fnLl 9 bound 256
spOutByte get spRec add add fnSt 9 i
end
spOutByte 10
p = add add fnSt fnLl 1
while lt p recN bound 16384
c = get spRec p
if eq c 0
break
end
spOutByte c
p = add p 1
end
spOutByte 10
end

fn spTrimCandLine p ulong q ulong to ulong
note Trim leading spaces and return new start
s = p
while lt s q bound 512
c = get spCand s
if or eq c 32 eq c 9
s = add s 1
else
break
end
end
ret s
end

fn spCandEq off ulong slen ulong s view uchar * to bool
if ne slen len s
ret false
end
for i ulong slen bound 32
if ne get spCand add off i get s i
ret false
end
end
ret true
end

fn spEmitCandBody to int
note Walk spCand up to NUL, emitting lines until nesting depth returns to 0
n = get spSt 1
depth = ulong 1
lines = ulong 0
p = ulong 0
while lt p n bound 512
if eq get spCand p 0
break
end
q = p
while lt q n bound 2048
c = get spCand q
if or eq c 10 or eq c 0 eq c 13
break
end
q = add q 1
end
s = spTrimCandLine p q
ll = sub q s
if gt ll 0
for i ulong ll bound 2048
spOutByte get spCand add s i
end
spOutByte 10
lines = add lines 1
if or spCandStarts s ll tKwFn or spCandStarts s ll tKwIf or spCandStarts s ll tKwFor spCandStarts s ll tKwWhile
depth = add depth 1
end
if spCandEq s ll tKwEnd
depth = sub depth 1
if eq depth 0
put spSt 8 q
ret 0
end
end
end
if lt q n
if eq get spCand q 0
break
end
end
p = add q 1
end
ret 1
end

fn spWriteOut argIdx ulong to int
pl = ulong argread argIdx spPath 0 512
fd = int fopen spPath 0 pl 577 420
if lt fd 0
ret 1
end
n = get spSt 7
w = write fd spOut 0 n
c = fclose fd
if ne w long n
ret 1
end
ret 0
end

fn main to int
if lt ulong argcnt 5
ret 1
end
rl = spReadRec 1
if le rl 0
ret 1
end
put spSt 0 ulong rl
cl = spReadCand 2
if le cl 0
ret 1
end
put spSt 1 ulong cl
put spSt 6 0

if ne spParseRec 0
ret 1
end

note 1. Build equivalence harness -> argv[3]
put spSt 7 0
spOutText tOm2
spEmitRefFn
spOutText tCandPfx
fnSt = get spSt 4
fnLl = get spSt 5
for i ulong sub fnLl 9 bound 256
spOutByte get spRec add add fnSt 9 i
end
spOutByte 10
if ne spEmitCandBody 0
ret 1
end
sh = get spSt 6
if eq sh 1
spOutText tMain1
end
if eq sh 2
spOutText tMain2
end
if eq sh 3
spOutText tMain3
end
if eq sh 4
spOutText tMain4
end
if eq sh 5
spOutText tMain5
end
if ne spWriteOut 3 0
ret 1
end

note 2. Build clean NUL-terminated training record -> argv[4]
put spSt 7 0
ntSt = get spSt 2
ntLl = get spSt 3
for i ulong ntLl bound 512
spOutByte get spRec add ntSt i
end
spOutByte 10
for i ulong fnLl bound 256
spOutByte get spRec add fnSt i
end
spOutByte 10
if ne spEmitCandBody 0
ret 1
end
spOutByte 0
if ne spWriteOut 4 0
ret 1
end
ret 0
end

om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_breadth.om:
note Pure seeded OM-2 Mechanical RLVR Breadth Factory covering all 10 coding skill
note families (arith, branch, bits, digits, loop, fold, select, count, scan, rewrite)
note with multi-phrasing natural-language prompts, NUL (\0) EOS delimiters, and a
note self-checking `oracle` mode compiled identically across Strand A and Strand B.
note
note Modes (argv[1]):
note   corpus [variant 1..9] -> NUL-delimited verified OM-2 training records
note   oracle [variant 1..9] -> self-checking om2 program executing 100% of records

global rbMode ulong 1
global rbVar ulong 1
global rbId ulong 1

text rbOm2 "om2\n"
text rbNote "note "
text rbFnU1 "\nfn solve a ulong to ulong\n"
text rbFnU2 "\nfn solve a ulong b ulong to ulong\n"
text rbFnU3 "\nfn solve a ulong b ulong c ulong to ulong\n"
text rbFnAr "\nfn solve a view ulong 8 n ulong to ulong\n"
text rbFnAw "\nfn solve a edit ulong 8 n ulong to void\n"
text rbEnd "\nend\n"
text rbOrPfx "fn g_"
text rbOrU1 " a ulong to ulong\n"
text rbOrU2 " a ulong b ulong to ulong\n"
text rbOrU3 " a ulong b ulong c ulong to ulong\n"
text rbOrAr " a view ulong 8 n ulong to ulong\n"
text rbOrAw " a edit ulong 8 n ulong to void\n"
text rbMainH "fn main to int\narr = new ulong 8 0\nput arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\n"
text rbMainT "ret 0\nend\n"
text rbReset "put arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\n"
text rbChkA "if ne g_"
text rbChkB " "
text rbChkC "\nexit 1\nend\n"
text rbCallG "g_"
text rbAwChk " arr 8\nif ne add get arr 0 add get arr 3 get arr 7 "
text rbSpc " "
text rbNl "\n"
text rbOrArrArg "arr 8"

text rbV0 "return "
text rbV1 "compute "
text rbV2 "find "
text rbV3 "calculate "
text rbV4 "output "
text rbV5 "give "

text rbArgOracle "oracle"

fn rbWrt s view uchar * to void
r = write 1 s 0 len s
end

fn rbNul to void
b = new uchar 1 0
r = write 1 b 0 1
end

fn rbNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn rbVerb k ulong to void
m = rem k 6
if eq m 0
rbWrt rbV0
ret
end
if eq m 1
rbWrt rbV1
ret
end
if eq m 2
rbWrt rbV2
ret
end
if eq m 3
rbWrt rbV3
ret
end
if eq m 4
rbWrt rbV4
ret
end
rbWrt rbV5
end

fn rbNextId to ulong
id = add get rbId 0 1
put rbId 0 id
ret id
end

fn rbBeginFn shape ulong desc view uchar * to ulong
id = rbNextId
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id get rbVar 0
rbWrt desc
if eq shape 1
rbWrt rbFnU1
end
if eq shape 2
rbWrt rbFnU2
end
if eq shape 3
rbWrt rbFnU3
end
if eq shape 4
rbWrt rbFnAr
end
if eq shape 5
rbWrt rbFnAw
end
else
rbWrt rbOrPfx
rbNum id
if eq shape 1
rbWrt rbOrU1
end
if eq shape 2
rbWrt rbOrU2
end
if eq shape 3
rbWrt rbOrU3
end
if eq shape 4
rbWrt rbOrAr
end
if eq shape 5
rbWrt rbOrAw
end
end
ret id
end

fn rbEndFn to void
rbWrt rbEnd
if eq get rbMode 0 0
rbNul
else
rbWrt rbNl
end
end

fn rbChkU1 id ulong x ulong exp ulong to void
rbWrt rbChkA
rbNum id
rbWrt rbChkB
rbNum x
rbWrt rbChkB
rbNum exp
rbWrt rbChkC
end

fn rbChkU2 id ulong x ulong y ulong exp ulong to void
rbWrt rbChkA
rbNum id
rbWrt rbChkB
rbNum x
rbWrt rbChkB
rbNum y
rbWrt rbChkB
rbNum exp
rbWrt rbChkC
end

fn rbChkU3 id ulong x ulong y ulong z ulong exp ulong to void
rbWrt rbChkA
rbNum id
rbWrt rbChkB
rbNum x
rbWrt rbChkB
rbNum y
rbWrt rbChkB
rbNum z
rbWrt rbChkB
rbNum exp
rbWrt rbChkC
end

fn rbChkAr id ulong exp ulong to void
rbWrt rbChkA
rbNum id
rbWrt rbSpc
rbWrt rbOrArrArg
rbWrt rbSpc
rbNum exp
rbWrt rbChkC
end

fn rbChkAw id ulong exp ulong to void
rbWrt rbReset
rbWrt rbCallG
rbNum id
rbWrt rbAwChk
rbNum exp
rbWrt rbChkC
end

note ==================== 1. BRANCH & ARITH ====================
text dSatSubA "a minus "
text dSatSubB " clamped at zero"
text bSatSub0 "if lt a "
text bSatSub1 "\nret 0\nend\nret sub a "

text dStepA "value "
text dStepB " if a is less than "
text dStepC " else "
text bStep0 "if lt a "
text bStep1 "\nret "
text bStep2 "\nend\nret "

text dRndUpA "a rounded up to a multiple of "
text bRndUp0 "r = rem a "
text bRndUp1 "\nif eq r 0\nret a\nend\nret add a sub "
text bRndUp2 " r"

text dAbsDiff "absolute difference between unsigned a and b"
text bAbsDiff "if ge a b\nret sub a b\nend\nret sub b a"

text dSatSub2 "saturating difference a minus b or zero when a is smaller"
text bSatSub2 "if lt a b\nret 0\nend\nret sub a b"

text dMin2 "the smaller of a and b"
text bMin2 "if lt a b\nret a\nend\nret b"

text dMax2 "the larger of a and b"
text bMax2 "if gt a b\nret a\nend\nret b"

text dMed3 "the median of three unsigned numbers a b c"
text bMed3 "if lt a b\nif lt b c\nret b\nend\nif lt a c\nret c\nend\nret a\nend\nif lt a c\nret a\nend\nif lt b c\nret c\nend\nret b"

text dMin3 "the smallest of a b and c"
text bMin3 "m = a\nif lt b m\nm = b\nend\nif lt c m\nm = c\nend\nret m"

text dMax3 "the largest of a b and c"
text bMax3 "m = a\nif gt b m\nm = b\nend\nif gt c m\nm = c\nend\nret m"

text dInRng3 "1 if a is between b and c inclusive else 0"
text bInRng3 "if lt a b\nret 0\nend\nif gt a c\nret 0\nend\nret 1"

text dClp3 "a clamped between b and c"
text bClp3 "if lt a b\nret b\nend\nif gt a c\nret c\nend\nret a"

fn rbEmitBranch isMain bool to void
v = get rbVar 0
note 1a. 10 saturating sub a - k
for i ulong 10
k = add 5 mul add i v 7
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dSatSubA
rbNum k
rbWrt dSatSubB
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bSatSub0
rbNum k
rbWrt bSatSub1
rbNum k
rbEndFn
else
rbChkU1 id add k 11 11
rbChkU1 id sub k 1 0
end
end
note 1b. 10 step functions
for i ulong 10
k = add 8 mul add i v 5
v0 = add 2 mul i 3
v1 = add 50 mul i 4
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dStepA
rbNum v0
rbWrt dStepB
rbNum k
rbWrt dStepC
rbNum v1
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bStep0
rbNum k
rbWrt bStep1
rbNum v0
rbWrt bStep2
rbNum v1
rbEndFn
else
rbChkU1 id sub k 1 v0
rbChkU1 id k v1
end
end
note 1c. 8 round up to multiple of m
for i ulong 8
m = add 3 mul add i v 2
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dRndUpA
rbNum m
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bRndUp0
rbNum m
rbWrt bRndUp1
rbNum m
rbWrt bRndUp2
rbEndFn
else
rbChkU1 id add mul m 2 1 mul m 3
rbChkU1 id mul m 2 mul m 2
end
end
note 1d. U2 & U3 core branch idioms
if not isMain
id = rbBeginFn 2 dAbsDiff
rbWrt bAbsDiff
rbEndFn
id = rbBeginFn 2 dSatSub2
rbWrt bSatSub2
rbEndFn
id = rbBeginFn 2 dMin2
rbWrt bMin2
rbEndFn
id = rbBeginFn 2 dMax2
rbWrt bMax2
rbEndFn
id = rbBeginFn 3 dMed3
rbWrt bMed3
rbEndFn
id = rbBeginFn 3 dInRng3
rbWrt bInRng3
rbEndFn
id = rbBeginFn 3 dClp3
rbWrt bClp3
rbEndFn
else
rbChkU2 rbNextId 10 3 7
rbChkU2 rbNextId 10 3 7
rbChkU2 rbNextId 10 3 3
rbChkU2 rbNextId 10 3 10
rbChkU3 rbNextId 9 2 5 5
rbChkU3 rbNextId 5 2 9 1
rbChkU3 rbNextId 12 2 9 9
end
end

note ==================== 2. BITS & DIGITS & LOOP ====================
text dClrBitA "a with bit "
text dClrBitB " cleared to zero"
text bClrBit0 "ret and a xor ulong 18446744073709551615 shl ulong 1 "

text dLowMskA "the low "
text dLowMskB " bits of a"
text bLowMsk0 "ret and a sub shl ulong 1 "
text bLowMsk1 " 1"

text dParity "parity 1 if a has an odd number of 1 bits else 0"
text bParity "x = a\np = ulong 0\nwhile gt x 0 bound 64\np = xor p and x 1\nx = shr x 1\nend\nret p"

text dPow2 "1 if a is a power of two else 0"
text bPow2 "if eq a 0\nret 0\nend\nif eq and a sub a 1 0\nret 1\nend\nret 0"

text dBitLen "number of bits needed to represent unsigned a"
text bBitLen "x = a\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c 1\nx = shr x 1\nend\nret c"

text dRevDigA "reverse the digits of a in base "
text bRevDig0 "x = a\nr = ulong 0\nwhile gt x 0 bound 64\nr = add mul r "
text bRevDig1 " rem x "
text bRevDig2 "\nx = div x "
text bRevDig3 "\nend\nret r"

text dGcd "greatest common divisor of a and b"
text bGcd "x = a\ny = b\nwhile gt y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret x"

text dFib "fibonacci number of a mod 25"
text bFib "n = rem a 25\nx = ulong 0\ny = ulong 1\nfor i ulong n bound 25\nt = add x y\nx = y\ny = t\nend\nret x"

text dPow "a raised to the power b mod 10"
text bPow "e = rem b 10\nr = ulong 1\nfor i ulong e bound 10\nr = mul r a\nend\nret r"

text dSumN "sum of integers from 1 to a mod 32"
text bSumN "n = rem a 32\ns = ulong 0\nfor i ulong n bound 32\ns = add s add i 1\nend\nret s"

fn rbEmitBitsLoop isMain bool to void
v = get rbVar 0
for i ulong 8
bit = add 1 rem add i v 12
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dClrBitA
rbNum bit
rbWrt dClrBitB
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bClrBit0
rbNum bit
rbEndFn
else
rbChkU1 id add shl ulong 1 bit 1 1
end
end
for i ulong 8
k = add 2 rem add i v 10
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dLowMskA
rbNum k
rbWrt dLowMskB
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bLowMsk0
rbNum k
rbWrt bLowMsk1
rbEndFn
else
rbChkU1 id sub shl ulong 1 k 1 sub shl ulong 1 k 1
end
end
for i ulong 3
base = ulong 10
if eq i 1
base = 8
end
if eq i 2
base = 16
end
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dRevDigA
rbNum base
rbWrt rbFnU1
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrU1
end
rbWrt bRevDig0
rbNum base
rbWrt bRevDig1
rbNum base
rbWrt bRevDig2
rbNum base
rbWrt bRevDig3
rbEndFn
else
if eq base 10
rbChkU1 id 1234 4321
end
if eq base 8
rbChkU1 id 83 209
end
if eq base 16
rbChkU1 id 291 801
end
end
end
if not isMain
id = rbBeginFn 1 dParity
rbWrt bParity
rbEndFn
id = rbBeginFn 1 dBitLen
rbWrt bBitLen
rbEndFn
id = rbBeginFn 2 dGcd
rbWrt bGcd
rbEndFn
id = rbBeginFn 1 dFib
rbWrt bFib
rbEndFn
id = rbBeginFn 2 dPow
rbWrt bPow
rbEndFn
id = rbBeginFn 1 dSumN
rbWrt bSumN
rbEndFn
else
rbChkU1 rbNextId 7 1
rbChkU1 rbNextId 13 4
rbChkU2 rbNextId 48 18 6
rbChkU1 rbNextId 7 13
rbChkU2 rbNextId 2 5 32
rbChkU1 rbNextId 5 15
end
end

note ==================== 3. FOLD, SELECT, COUNT, SCAN ====================
text dSumArr "sum of first n elements of array a"
text bSumArr "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nend\nret s"

text dMaxArr "maximum of first n elements of array a or 0 if empty"
text bMaxArr "if eq n 0\nret 0\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nend\nend\nret m"

text dMinArr "minimum of first n elements of array a or 0 if empty"
text bMinArr "if eq n 0\nret 0\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v m\nm = v\nend\nend\nret m"

text dXorArr "bitwise XOR of first n elements of array a"
text bXorArr "s = ulong 0\nfor i ulong n bound 8\ns = xor s get a i\nend\nret s"

text dArgMax "index of maximum element in first n elements of array a"
text bArgMax "if eq n 0\nret 0\nend\nbi = ulong 0\nbv = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v bv\nbv = v\nbi = i\nend\nend\nret bi"

text dArgMin "index of minimum element in first n elements of array a"
text bArgMin "if eq n 0\nret 0\nend\nbi = ulong 0\nbv = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v bv\nbv = v\nbi = i\nend\nend\nret bi"

text dCntEv "count of even elements in first n elements of array a"
text bCntEv "c = ulong 0\nfor i ulong n bound 8\nif eq rem get a i 2 0\nc = add c 1\nend\nend\nret c"

text dCntOd "count of odd elements in first n elements of array a"
text bCntOd "c = ulong 0\nfor i ulong n bound 8\nif ne rem get a i 2 0\nc = add c 1\nend\nend\nret c"

text dSumEv "sum of even elements in first n elements of array a"
text bSumEv "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif eq rem v 2 0\ns = add s v\nend\nend\nret s"

text dSumOd "sum of odd elements in first n elements of array a"
text bSumOd "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne rem v 2 0\ns = add s v\nend\nend\nret s"

text dRngArr "difference between max and min of first n elements of array a"
text bRngArr "if eq n 0\nret 0\nend\nlo = get a 0\nhi = lo\nfor i ulong n bound 8\nv = get a i\nif lt v lo\nlo = v\nend\nif gt v hi\nhi = v\nend\nend\nret sub hi lo"

text dIsSort "1 if first n elements of array a are non-decreasing else 0"
text bIsSort "if le n 1\nret 1\nend\nfor i ulong sub n 1 bound 8\nif gt get a i get a add i 1\nret 0\nend\nend\nret 1"

text dCntGtA "count of elements strictly greater than "
text dCntGtB " in first n elements of array a"
text bCntGt0 "c = ulong 0\nfor i ulong n bound 8\nif gt get a i "
text bCntGt1 "\nc = add c 1\nend\nend\nret c"

text dFndEqA "first index equal to "
text dFndEqB " in first n elements of array a or n if absent"
text bFndEq0 "for i ulong n bound 8\nif eq get a i "
text bFndEq1 "\nret i\nend\nend\nret n"

fn rbEmitArrayRead isMain bool to void
v = get rbVar 0
if not isMain
id = rbBeginFn 4 dSumArr
rbWrt bSumArr
rbEndFn
id = rbBeginFn 4 dMaxArr
rbWrt bMaxArr
rbEndFn
id = rbBeginFn 4 dMinArr
rbWrt bMinArr
rbEndFn
id = rbBeginFn 4 dXorArr
rbWrt bXorArr
rbEndFn
id = rbBeginFn 4 dArgMax
rbWrt bArgMax
rbEndFn
id = rbBeginFn 4 dArgMin
rbWrt bArgMin
rbEndFn
id = rbBeginFn 4 dCntEv
rbWrt bCntEv
rbEndFn
id = rbBeginFn 4 dCntOd
rbWrt bCntOd
rbEndFn
id = rbBeginFn 4 dSumEv
rbWrt bSumEv
rbEndFn
id = rbBeginFn 4 dSumOd
rbWrt bSumOd
rbEndFn
id = rbBeginFn 4 dRngArr
rbWrt bRngArr
rbEndFn
id = rbBeginFn 4 dIsSort
rbWrt bIsSort
rbEndFn
else
rbChkAr rbNextId 61
rbChkAr rbNextId 19
rbChkAr rbNextId 0
rbChkAr rbNextId 21
rbChkAr rbNextId 4
rbChkAr rbNextId 2
rbChkAr rbNextId 3
rbChkAr rbNextId 5
rbChkAr rbNextId 6
rbChkAr rbNextId 55
rbChkAr rbNextId 19
rbChkAr rbNextId 0
end
for i ulong 8
thr = add 1 mul i 2
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dCntGtA
rbNum thr
rbWrt dCntGtB
rbWrt rbFnAr
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrAr
end
rbWrt bCntGt0
rbNum thr
rbWrt bCntGt1
rbEndFn
else
cnt = ulong 0
if gt 3 thr
cnt = add cnt 1
end
if gt 11 thr
cnt = add cnt 1
end
if gt 7 thr
cnt = add cnt 1
end
if gt 19 thr
cnt = add cnt 1
end
if gt 4 thr
cnt = add cnt 1
end
if gt 2 thr
cnt = add cnt 1
end
if gt 15 thr
cnt = add cnt 1
end
rbChkAr id cnt
end
end
for i ulong 4
tgt = ulong 7
exp = ulong 3
if eq i 1
tgt = 19
exp = 4
end
if eq i 2
tgt = 15
exp = 7
end
if eq i 3
tgt = 99
exp = 8
end
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dFndEqA
rbNum tgt
rbWrt dFndEqB
rbWrt rbFnAr
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrAr
end
rbWrt bFndEq0
rbNum tgt
rbWrt bFndEq1
rbEndFn
else
rbChkAr id exp
end
end
end

note ==================== 4. REWRITE (IN-PLACE ARRAY TRANSFORMS) ====================
text dRwAddA "add "
text dRwAddB " to each of first n elements of array a in place"
text bRwAdd0 "for i ulong n bound 8\nput a i add get a i "
text bRwAdd1 "\nend"

text dRwCapA "cap each of first n elements of array a at "
text dRwCapB " in place"
text bRwCap0 "for i ulong n bound 8\nif gt get a i "
text bRwCap1 "\nput a i "
text bRwCap2 "\nend\nend"

text dRwFlrA "raise any element below "
text dRwFlrB " in first n elements of array a to "
text bRwFlr0 "for i ulong n bound 8\nif lt get a i "
text bRwFlr1 "\nput a i "
text bRwFlr2 "\nend\nend"

text dRwRev "reverse the first n elements of array a in place"
text bRwRev "i = ulong 0\nwhile lt mul i 2 n bound 8\nj = sub sub n 1 i\nt = get a i\nput a i get a j\nput a j t\ni = add i 1\nend"

text dRwPfx "replace first n elements of array a with running prefix sums in place"
text bRwPfx "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nput a i s\nend"

text dRwZOd "zero out all odd elements in first n elements of array a in place"
text bRwZOd "for i ulong n bound 8\nif ne rem get a i 2 0\nput a i 0\nend\nend"

text dRwDOd "double all odd elements in first n elements of array a in place"
text bRwDOd "for i ulong n bound 8\nv = get a i\nif ne rem v 2 0\nput a i mul v 2\nend\nend"

fn rbEmitRewrite isMain bool to void
v = get rbVar 0
for i ulong 6
k = add 1 add i v
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dRwAddA
rbNum k
rbWrt dRwAddB
rbWrt rbFnAw
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrAw
end
rbWrt bRwAdd0
rbNum k
rbWrt bRwAdd1
rbEndFn
else
rbChkAw id add 25 mul 3 k
end
end
for i ulong 5
cap = add 5 mul i 3
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dRwCapA
rbNum cap
rbWrt dRwCapB
rbWrt rbFnAw
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrAw
end
rbWrt bRwCap0
rbNum cap
rbWrt bRwCap1
rbNum cap
rbWrt bRwCap2
rbEndFn
else
e0 = ulong 3
if gt e0 cap
e0 = cap
end
e3 = ulong 7
if gt e3 cap
e3 = cap
end
e7 = ulong 15
if gt e7 cap
e7 = cap
end
rbChkAw id add e0 add e3 e7
end
end
for i ulong 5
flr = add 4 mul i 3
id = rbNextId
if not isMain
if eq get rbMode 0 0
rbWrt rbNote
rbVerb add id v
rbWrt dRwFlrA
rbNum flr
rbWrt dRwFlrB
rbNum flr
rbWrt rbFnAw
else
rbWrt rbOrPfx
rbNum id
rbWrt rbOrAw
end
rbWrt bRwFlr0
rbNum flr

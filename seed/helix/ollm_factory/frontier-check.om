note Link after om_synth.om up to its main. Exercise the actual pool expansion in isolation.
note The early synthetic vectors are zero so that only the distant operand can match.
fn probeInit target ulong to void
syReset
put sySt 0 1
put sySt 7 1
put sySt 3 4101
put syTgt 0 target
for i ulong 4101
put syVec mul i 8 0
end
end

fn main to int
note The constant/combinator frontier can itself exceed the old inner limit of 64.
probeInit 22
put syLvlS 0 0
put syLvlE 0 4101
put syVec 0 3
put syVec mul ulong 4100 8 19
if not syExpandLevel 1
ret 1
end

note A late left operand in phase A must still reach the first seed node.
probeInit 22
put syLvlE 0 1
put syLvlS 1 1
put syLvlE 1 4101
put syVec 0 3
put syVec mul ulong 4100 8 19
if not syExpandLevel 2
ret 2
end

note In phase B the only additive solution pairs the last two nodes.
probeInit 41
put syLvlE 0 1
put syLvlE 1 4100
put syLvlS 2 4100
put syLvlE 2 4101
put syVec mul ulong 4099 8 22
put syVec mul ulong 4100 8 19
if not syExpandLevel 3
ret 3
end

note A full pool closes the level without attempting any inadmissible pairs.
put sySt 3 SY_MAX_NODES
put sySt 4 SY_MAX_NODES
put sySt 5 0
put sySt 8 999999
if syExpandLevel 3
ret 4
end
if or ne get syLvlE 3 SY_MAX_NODES ne get sySt 5 0
ret 5
end
ret 0
end

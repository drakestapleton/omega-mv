om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_idioms.om:
note Pure seeded OM-2 Round-3 Arboris-Steered General Algorithmic Idioms RLVR Generator & Oracle.
note
note Teaches broad compositional OM-2 programming idioms across natural-language phrasings
note ("the argument", "the first n items", "decimal", "one bits", "when n is zero", etc.)
note covering folds (product, sum mod d, or, and, min, max), boundary-safe selects, bit counts
note (popcount, ctz, bit_len, parity), digit loops, number theory (gcd, pow, isqrt, divisors),
note and structural in-place array transforms (reverse, rotate, swap-ends, prefix-sum, prefix-max,
note adjacent diff, zero-even/odd, clamp, replace) -- all NUL-delimited (\x00 EOS) and 100%
note verified by compiling & executing `oracle` mode across both Strand A & Strand B.
note
note Zero C, zero Python, zero CUDA. Strictly audited by `bench seen` before training.

text riOm2 "om2\n"
text riNote "note "
text riU1 "\nfn solve a ulong to ulong\n"
text riU2 "\nfn solve a ulong b ulong to ulong\n"
text riU3 "\nfn solve a ulong b ulong c ulong to ulong\n"
text riAr "\nfn solve a view ulong 8 n ulong to ulong\n"
text riAw "\nfn solve a edit ulong 8 n ulong to void\n"
text riEnd "\nend\n"

text riOrPfx "fn h_"
text riOrU1 " a ulong to ulong\n"
text riOrU2 " a ulong b ulong to ulong\n"
text riOrU3 " a ulong b ulong c ulong to ulong\n"
text riOrAr " a view ulong 8 n ulong to ulong\n"
text riOrAw " a edit ulong 8 n ulong to void\n"
text riOrMainH "fn main to int\narr = new ulong 8 0\nput arr 0 6\nput arr 1 10\nput arr 2 0\nput arr 3 5\nput arr 4 14\nput arr 5 3\nput arr 6 8\nput arr 7 12\n"
text riOrChkA "if ne h_"
text riOrChkB " "
text riOrChkC "\nexit "
text riOrChkD "\nend\n"
text riOrArrArg "arr 8"
text riOrAwRst "put arr 0 6\nput arr 1 10\nput arr 2 0\nput arr 3 5\nput arr 4 14\nput arr 5 3\nput arr 6 8\nput arr 7 12\nh_"
text riOrAwCall " arr 8\nif ne add get arr 0 add get arr 2 get arr 7 "
text riOrMainT "ret 0\nend\n"

text riV0 "return "
text riV1 "compute "
text riV2 "find "
text riV3 "give "

global riMode ulong 1
global riVar ulong 1
global riNul uchar 1

fn riWrt s view uchar * to void
r = write 1 s 0 len s
end

fn riEmitNul to void
if eq get riMode 0 0
put riNul 0 0
r = write 1 riNul 0 1
end
end

fn riNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn riVerb id ulong to void
m = rem add id get riVar 0 4
if eq m 0
riWrt riV0
end
if eq m 1
riWrt riV1
end
if eq m 2
riWrt riV2
end
if eq m 3
riWrt riV3
end
end

fn riEq a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn riArrVal i ulong to ulong
if eq i 0
ret 6
end
if eq i 1
ret 10
end
if eq i 2
ret 0
end
if eq i 3
ret 5
end
if eq i 4
ret 14
end
if eq i 5
ret 3
end
if eq i 6
ret 8
end
ret 12
end

note ==================== 1. ARRAY FOLDS, COUNTS, SELECTS, SCANS ("the first n items") ====================
text af_d0 "the product of (item plus "
text af_d1 ") over the first n items, with 1 when n is zero"
text af_d2 "the remainder of the sum of the first n items divided by "
text af_d3 "the bitwise OR of the first n items masked with "
text af_d4 "the bitwise AND of the first n items ORed with "
text af_d5 ", or 0 when n is zero"
text af_d6 "the item at index n minus 1 plus "
text af_d7 ", or "
text af_d8 " when n is zero"
text af_d9 "the difference between the largest and smallest of the first n items plus "
text af_d10 "the number of even items among the first n items that exceed "
text af_d11 "the number of odd items among the first n items that are at least "
text af_d12 "the number of times an item in the first n items is strictly larger than all earlier items, plus "
text af_d13 "1 if the first n items are non-decreasing with margin "
text af_d14 ", else 0"

text af_b0 "p = ulong 1\nfor i ulong n bound 8\np = mul p add get a i "
text af_b1 "\nend\nret p"
text af_b2 "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nend\nret rem s "
text af_b3 "r = ulong 0\nfor i ulong n bound 8\nr = or r and get a i "
text af_b4 "\nend\nret r"
text af_b5 "if eq n 0\nret 0\nend\nr = or get a 0 "
text af_b6 "\nfor i ulong n bound 8\nr = and r or get a i "
text af_b7 "if eq n 0\nret "
text af_b8 "\nend\nret add get a sub n 1 "
text af_b9 "if eq n 0\nret "
text af_b10 "\nend\nlo = get a 0\nhi = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v lo\nlo = v\nend\nif gt v hi\nhi = v\nend\nend\nret add sub hi lo "
text af_b11 "c = ulong 0\nfor i ulong n bound 8\nv = get a i\nif eq and v 1 0\nif gt v "
text af_b12 "\nc = add c 1\nend\nend\nend\nret c"
text af_b13 "c = ulong 0\nfor i ulong n bound 8\nv = get a i\nif ne and v 1 0\nif ge v "
text af_b14 "if eq n 0\nret "
text af_b15 "\nend\nbest = get a 0\nc = ulong 1\nfor i ulong n bound 8\nif gt i 0\nv = get a i\nif gt v best\nbest = v\nc = add c 1\nend\nend\nend\nret add c "
text af_b16 "if le n 1\nret 1\nend\nfor i ulong sub n 1 bound 8\nif gt get a i add get a add i 1 "
text af_b17 "\nret 0\nend\nend\nret 1"

fn riEmitArrayRead isMain bool to void
id = ulong 1
vo = mul sub get riVar 0 1 2
note 1a. Product of (a[i] + k) over first n items (10)
for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d0
riNum k
riWrt af_d1
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b0
riNum k
riWrt af_b1
riWrt riEnd
else
p = ulong 1
for j ulong 8
p = mul p add riArrVal j k
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum p
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1b. Remainder of sum of first n items divided by d (14, varied moduli)
for i ulong 14
d = add add 3 mul i 2 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d2
riNum d
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b2
riNum d
riWrt riEnd
else
s = ulong 0
for j ulong 8
s = add s riArrVal j
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum rem s d
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1c. Bitwise OR fold masked with m (10) + Bitwise AND fold ORed with m (10)
for i ulong 10
m = add add 7 mul i 4 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d3
riNum m
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b3
riNum m
riWrt af_b4
riWrt riEnd
else
r = ulong 0
for j ulong 8
r = or r and riArrVal j m
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum r
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
m = add add 1 mul i 2 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d4
riNum m
riWrt af_d5
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b5
riNum m
riWrt af_b6
riNum m
riWrt af_b4
riWrt riEnd
else
r = or riArrVal 0 m
for j ulong 8
r = and r or riArrVal j m
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum r
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1d. Last item + k, or fb when n == 0 (12)
for i ulong 12
k = add add 1 i vo
fb = add 2 mul i 3
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d6
riNum k
riWrt af_d7
riNum fb
riWrt af_d8
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b7
riNum fb
riWrt af_b8
riNum k
riWrt riEnd
else
exp = add riArrVal 7 k
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1e. Range (max - min) + k (10)
for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d9
riNum k
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b9
riNum k
riWrt af_b10
riNum k
riWrt riEnd
else
lo = riArrVal 0
hi = riArrVal 0
for j ulong 8
v = riArrVal j
if lt v lo
lo = v
end
if gt v hi
hi = v
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum add sub hi lo k
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1f. Filtered even/odd counts (10 + 10)
for i ulong 10
t = add i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d10
riNum t
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b11
riNum t
riWrt af_b12
riWrt riEnd
else
c = ulong 0
for j ulong 8
v = riArrVal j
if eq and v 1 0
if gt v t
c = add c 1
end
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
t = add i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d11
riNum t
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b13
riNum t
riWrt af_b12
riWrt riEnd
else
c = ulong 0
for j ulong 8
v = riArrVal j
if ne and v 1 0
if ge v t
c = add c 1
end
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 1g. Running prefix-max record count + k (10) + Non-decreasing margin check (10)
for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d12
riNum k
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b14
riNum k
riWrt af_b15
riNum k
riWrt riEnd
else
best = riArrVal 0
c = ulong 1
for j ulong 8
if gt j 0
v = riArrVal j
if gt v best
best = v
c = add c 1
end
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum add c k
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
m = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt af_d13
riNum m
riWrt af_d14
riWrt riAr
else
riWrt riOrPfx
riNum id
riWrt riOrAr
end
riWrt af_b16
riNum m
riWrt af_b17
riWrt riEnd
else
ok = ulong 1
for j ulong 7
if gt riArrVal j add riArrVal add j 1 m
ok = 0
break
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riWrt riOrArrArg
riWrt riOrChkB
riNum ok
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end
end

note ==================== 2. BITS, CTZ, DECIMAL DIGITS & NUMBER THEORY ("the argument") ====================
text bd_d0 "the number of one bits in (the argument plus "
text bd_d1 ")"
text bd_d2 "the number of trailing zero bits in (the argument plus "
text bd_d3 "), or 64 if zero"
text bd_d4 "the number of decimal digits of (the argument plus "
text bd_d5 "), counting zero as one digit"
text bd_d6 "the sum of decimal digits of (the argument plus "
text bd_d7 "the largest decimal digit of (the argument plus "
text bd_d8 "the reversal of the decimal digits of (the argument plus "
text bd_d9 "the count of divisors of ((the argument mod "
text bd_d10 ") plus 1)"
text bd_d11 "the sum of integers from 1 to ((the argument mod "
text bd_d12 "the least common multiple of (a plus "
text bd_d13 ") and (b plus "

text bd_b0 "x = add a "
text bd_b1 "\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c"
text bd_b2 "\nif eq x 0\nret 64\nend\nc = ulong 0\nwhile eq and x 1 0 bound 64\nc = add c 1\nx = shr x 1\nend\nret c"
text bd_b3 "\nif eq x 0\nret 1\nend\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c 1\nx = div x 10\nend\nret c"
text bd_b4 "\ns = ulong 0\nwhile gt x 0 bound 64\ns = add s rem x 10\nx = div x 10\nend\nret s"
text bd_b5 "\nm = ulong 0\nwhile gt x 0 bound 64\nd = rem x 10\nif gt d m\nm = d\nend\nx = div x 10\nend\nret m"
text bd_b6 "\nr = ulong 0\nwhile gt x 0 bound 64\nr = add mul r 10 rem x 10\nx = div x 10\nend\nret r"
text bd_b7 "n = add rem a "
text bd_b8 " 1\nc = ulong 0\ni = ulong 1\nwhile le i n bound 128\nif eq rem n i 0\nc = add c 1\nend\ni = add i 1\nend\nret c"
text bd_b9 " 1\ns = ulong 0\ni = ulong 1\nwhile le i n bound 128\ns = add s i\ni = add i 1\nend\nret s"
text bd_b10 "u = add a "
text bd_b11 "\nv = add b "
text bd_b12 "\nx = u\ny = v\nwhile gt y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret mul div u x v"

fn riEmitBitsDigits isMain bool to void
id = ulong 201
vo = mul sub get riVar 0 1 2
note 2a. Popcount(a + k) (12)
for i ulong 12
k = add add 1 mul i 3 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d0
riNum k
riWrt bd_d1
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b1
riWrt riEnd
else
x = add ulong 48 k
c = ulong 0
while gt x 0 bound 64
c = add c and x 1
x = shr x 1
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 2b. CTZ(a + k) (12)
for i ulong 12
k = add add 2 mul i 4 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d2
riNum k
riWrt bd_d3
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b2
riWrt riEnd
else
x = add ulong 48 k
c = ulong 0
if eq x 0
c = 64
else
while eq and x 1 0 bound 64
c = add c 1
x = shr x 1
end
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 2c. Decimal digit count / sum / max / reverse of (a + k) (12 each = 48)
for i ulong 12
k = add add 1 mul i 5 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d4
riNum k
riWrt bd_d5
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b3
riWrt riEnd
else
x = add ulong 48 k
c = ulong 0
while gt x 0 bound 64
c = add c 1
x = div x 10
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 2 mul i 7 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d6
riNum k
riWrt bd_d1
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b4
riWrt riEnd
else
x = add ulong 48 k
s = ulong 0
while gt x 0 bound 64
s = add s rem x 10
x = div x 10
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum s
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 3 mul i 6 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d7
riNum k
riWrt bd_d1
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b5
riWrt riEnd
else
x = add ulong 48 k
m = ulong 0
while gt x 0 bound 64
d = rem x 10
if gt d m
m = d
end
x = div x 10
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum m
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 4 mul i 9 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d8
riNum k
riWrt bd_d1
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b0
riNum k
riWrt bd_b6
riWrt riEnd
else
x = add ulong 48 k
r = ulong 0
while gt x 0 bound 64
r = add mul r 10 rem x 10
x = div x 10
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum r
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

note 2d. Divisor count (10) + 1..n sum (10) + LCM (10)
for i ulong 10
m = add add 12 mul i 5 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d9
riNum m
riWrt bd_d10
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b7
riNum m
riWrt bd_b8
riWrt riEnd
else
n = add rem ulong 48 m 1
c = ulong 0
j = ulong 1
while le j n bound 128
if eq rem n j 0
c = add c 1
end
j = add j 1
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum c
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
m = add add 15 mul i 4 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d11
riNum m
riWrt bd_d10
riWrt riU1
else
riWrt riOrPfx
riNum id
riWrt riOrU1
end
riWrt bd_b7
riNum m
riWrt bd_b9
riWrt riEnd
else
n = add rem ulong 48 m 1
s = ulong 0
j = ulong 1
while le j n bound 128
s = add s j
j = add j 1
end
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 48
riWrt riOrChkB
riNum s
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
ca = add add 2 mul i 3 vo
cb = add add 3 mul i 2 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riVerb id
riWrt bd_d12
riNum ca
riWrt bd_d13
riNum cb
riWrt bd_d1
riWrt riU2
else
riWrt riOrPfx
riNum id
riWrt riOrU2
end
riWrt bd_b10
riNum ca
riWrt bd_b11
riNum cb
riWrt bd_b12
riWrt riEnd
else
u = add ulong 12 ca
v = add ulong 18 cb
x = u
y = v
while gt y 0 bound 128
t = rem x y
x = y
y = t
end
exp = mul div u x v
riWrt riOrChkA
riNum id
riWrt riOrChkB
riNum 12
riWrt riOrChkB
riNum 18
riWrt riOrChkB
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end
end

note ==================== 3. STRUCTURAL IN-PLACE ARRAY REWRITES ("the first n items") ====================
text sr_d0 "reverse the order of the first n items and add "
text sr_d1 " to each"
text sr_d2 "swap the first and last of the first n items and add "
text sr_d3 " to the first"
text sr_d4 "rotate the first n items left by one and add "
text sr_d5 " to the last"
text sr_d6 "rotate the first n items right by one and add "
text sr_d7 "replace each of the first n items with the running maximum plus "
text sr_d8 "zero every even item among the first n items and add "
text sr_d9 " to odd items"
text sr_d10 "zero every odd item among the first n items and add "
text sr_d11 " to even items"
text sr_d12 "fill the first n items with i * "
text sr_d13 " plus "

text sr_b0 "i = ulong 0\nwhile lt add mul i 2 1 n bound 8\nj = sub sub n 1 i\nt = get a i\nput a i get a j\nput a j t\ni = add i 1\nend\nfor p ulong n bound 8\nput a p add get a p "
text sr_b1 "\nend"
text sr_b2 "if gt n 1\nt = get a 0\nput a 0 add get a sub n 1 "
text sr_b3 "\nput a sub n 1 t\nend"
text sr_b4 "if gt n 1\nt = get a 0\nfor i ulong sub n 1 bound 8\nput a i get a add i 1\nend\nput a sub n 1 add t "
text sr_b5 "\nend"
text sr_b6 "if gt n 1\nt = get a sub n 1\ni = sub n 1\nwhile gt i 0 bound 8\nput a i get a sub i 1\ni = sub i 1\nend\nput a 0 add t "
text sr_b7 "if eq n 0\nret\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nend\nput a i add m "
text sr_b8 "for i ulong n bound 8\nv = get a i\nif eq and v 1 0\nput a i 0\nelse\nput a i add v "
text sr_b9 "\nend\nend"
text sr_b10 "for i ulong n bound 8\nv = get a i\nif ne and v 1 0\nput a i 0\nelse\nput a i add v "
text sr_b11 "for i ulong n bound 8\nput a i add mul i "
text sr_b12 " "

fn riEmitStructRewrite isMain bool to void
id = ulong 401
vo = mul sub get riVar 0 1 2
for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d0
riNum k
riWrt sr_d1
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b0
riNum k
riWrt sr_b1
riWrt riEnd
else
note reversed [12,8,3,14,5,0,10,6] + k -> idx 0=12+k, idx 2=3+k, idx 7=6+k
exp = add add ulong 12 k add add ulong 3 k add ulong 6 k
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 1 mul i 2 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d2
riNum k
riWrt sr_d3
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b2
riNum k
riWrt sr_b3
riWrt riEnd
else
note swapped idx 0=12+k, idx 2=0, idx 7=6
exp = add add ulong 12 k add ulong 0 ulong 6
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d4
riNum k
riWrt sr_d5
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b4
riNum k
riWrt sr_b5
riWrt riEnd
else
note rotL: idx 0=10, idx 2=5, idx 7=6+k
exp = add ulong 10 add ulong 5 add ulong 6 k
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d6
riNum k
riWrt sr_d3
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b6
riNum k
riWrt sr_b5
riWrt riEnd
else
note rotR: idx 0=12+k, idx 2=10, idx 7=8
exp = add add ulong 12 k add ulong 10 ulong 8
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 1 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d7
riNum k
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b7
riNum k
riWrt sr_b1
riWrt riEnd
else
note runmax [6,10,10,10,14,14,14,14] + k -> idx 0=6+k, idx 2=10+k, idx 7=14+k
exp = add add ulong 6 k add add ulong 10 k add ulong 14 k
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 2 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d8
riNum k
riWrt sr_d9
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b8
riNum k
riWrt sr_b9
riWrt riEnd
else
note arr 0=6(even->0), 2=0(even->0), 7=12(even->0) -> sum=0
exp = ulong 0
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
k = add add 2 i vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d10
riNum k
riWrt sr_d11
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b10
riNum k
riWrt sr_b9
riWrt riEnd
else
note arr 0=6+k, 2=0+k, 7=12+k
exp = add add ulong 6 k add k add ulong 12 k
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end

for i ulong 10
m = add 2 rem i 5
c = add add 3 mul i 2 vo
if not isMain
if eq get riMode 0 0
riEmitNul
riWrt riNote
riWrt sr_d12
riNum m
riWrt sr_d13
riNum c
riWrt riAw
else
riWrt riOrPfx
riNum id
riWrt riOrAw
end
riWrt sr_b11
riNum m
riWrt sr_b12
riNum c
riWrt sr_b1
riWrt riEnd
else
v0 = c
v2 = add mul ulong 2 m c
v7 = add mul ulong 7 m c
exp = add v0 add v2 v7
riWrt riOrAwRst
riNum id
riWrt riOrAwCall
riNum exp
riWrt riOrChkC
riNum add 10 rem id 80
riWrt riOrChkD
end
id = add id 1
end
end

text riArgOr "oracle"

fn main to int
ab = new uchar 32 0
vb = new uchar 16 0
mode = ulong 0
vr = ulong 1
if ge argcnt 2
alr = argread 1 ab 0 32
if gt alr 0
if riEq ab ulong alr riArgOr
mode = 1
end
end
end
if ge argcnt 3
vlr = argread 2 vb 0 16
if gt vlr 0
ch = ulong get vb 0
if and ge ch 49 le ch 57
vr = sub ch 48
end
end
end
put riMode 0 mode
put riVar 0 vr
if eq mode 1
riWrt riOm2
riEmitArrayRead false
riEmitBitsDigits false
riEmitStructRewrite false
riWrt riOrMainH
riEmitArrayRead true
riEmitBitsDigits true
riEmitStructRewrite true
riWrt riOrMainT
ret 0
end
riEmitArrayRead false
riEmitBitsDigits false
riEmitStructRewrite false
riEmitNul
ret 0
end

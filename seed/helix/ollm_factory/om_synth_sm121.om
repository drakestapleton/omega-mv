om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/om_synth_sm121.om:
note SM121 GPU Observational-Equivalence Kernel Contract, QMD Descriptor,
note 16 MiB L2 Hash-Table Layout, and Invariant Verifier (Pure Seeded OM-2).
note
note Hardware target: NVIDIA GB10 (SM 12.1, 48 SMs, 24 MiB L2, 100 KiB SMEM/SM).
note
note Locks in all 3 SM121 observational-equivalence kernel invariants:
note   INV-1 (Strict BFS Level Barriers):
note     Host launches one QMD dispatch per BFS depth d (0 -> 1 -> 2 -> 3).
note     Within depth d, threads read immutable parent vectors [0..lvlEnd[d-1]) and
note     only claim L2 slots via 64-bit ATOMG.E.CAS on behavior_hash (0 -> h),
note     guaranteeing minimum depth_cost on first insert with zero torn reads.
note   INV-2 (Probe Cap + 70% Atomic Occupancy Cutoff):
note     L2 table = 2^20 = 1,048,576 slots x 16 bytes = 16,777,216 bytes (16 MiB,
note     resident inside GB10's 24 MiB L2).
note     Hard MAX_PROBES = 32 cap and atomic occupancy cutoff at 70% (734,003 slots)
note     guarantee zero probe livelock.
note   INV-3 (Branchless 8-Lane Vector Safety):
note     Each candidate behavior vector = 8 x u64 = 64 bytes (1 L2 cache line).
note     div/rem computes branchless mask: z = (rhs == 0), valid &= !z, safe_rhs = rhs | z.
note     shl/shr computes branchless mask: valid &= (rhs < 64), safe_sh = rhs & 63.
note     Invalid lanes suppress ATOMG.E.CAS completely without warp divergence.
note
note Also emits a verified SM121 SASS microkernel stub honoring Antibodies #13-#15
note (basic-block leader anchors, rawFloor >= 6, I2F >= 6, yield=1 on DRAM loads)
note and runs a deterministic CPU bit-exact simulation of the 16-byte L2 slot
note ATOMG.E.CAS protocol + all 3 invariants in `selfcheck`.
note
note Usage:
note   om_synth_sm121 layout       print GB10 memory & launch geometry
note   om_synth_sm121 selfcheck    verify all 3 invariants + SASS antibody checks

const SM121_SMS ulong 48
const SM121_CTA_THREADS ulong 256
const SM121_L2_BYTES ulong 25165824
const SM121_HT_SLOTS ulong 1048576
const SM121_HT_SLOT_BYTES ulong 16
const SM121_HT_BYTES ulong 16777216
const SM121_HT_MAX_OCC ulong 734003
const SM121_MAX_PROBES ulong 32
const SM121_VEC_LANES ulong 8
const SM121_VEC_BYTES ulong 64

note Small simulated L2 slot table (4096 slots x 16 bytes = 64 KiB) for selfcheck
const SIM_SLOTS ulong 4096
const SIM_MASK ulong 4095
const SIM_MAX_OCC ulong 2867
global simHash ulong 4096
global simMeta ulong 4096
global simOcc ulong 1

note Emitted SM121 SASS buffer (64 x 16-byte instructions = 1024 bytes)
global sassBuf uchar 1024
global sassCnt ulong 1

text mLayout "layout"
text mSelf "selfcheck"
text tUsage "usage: om_synth_sm121 layout | selfcheck\n"
text tLay1 "SM121_OBS_EQUIV_LAYOUT sms=48 cta=256 l2_bytes=25165824 ht_slots=1048576 ht_bytes=16777216 ht_max_occ=734003 max_probes=32 vec_bytes=64\n"
text tSelfOk "OM_SYNTH_SM121 SELFCHECK PASS inv1_bfs_cas=1 inv2_probe32_occ70=1 inv3_branchless_8lane=1 sass_antibodies=3/3 l2_fit=1\n"
text tSelfFail "OM_SYNTH_SM121 SELFCHECK FAIL step="
text tNl "\n"

fn sw1 fd int s view uchar * to void
r = write fd s 0 len s
end

fn swn fd int v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd b p sub 24 p
end

fn seqTxt a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

note Pack 16-byte L2 slot metadata word: [ast_node_id:32 | depth_cost:16 | flags:16]
fn packMeta nid ulong dep ulong flags ulong to ulong
ret or shl and nid 4294967295 32 or shl and dep 65535 16 and flags 65535
end

fn metaDepth m ulong to ulong
ret and shr m 16 65535
end

note Simulated 64-bit ATOMG.E.CAS (0 -> h) with INV-1 (first insert wins min depth)
note and INV-2 (MAX_PROBES=32 + 70% occupancy cutoff)
note Returns 1 if admitted, 0 if duplicate/rejected/full
fn simCasInsert h ulong nid ulong dep ulong to ulong
occ = get simOcc 0
if ge occ SIM_MAX_OCC
ret 0
end
slot = and h SIM_MASK
for pr ulong SM121_MAX_PROBES bound 32
cur = get simHash slot
if eq cur 0
put simHash slot h
put simMeta slot packMeta nid dep 1
put simOcc 0 add occ 1
ret 1
end
if eq cur h
note Existing entry has depth <= dep by strict BFS level barrier (INV-1)
ret 0
end
slot = and add slot 1 SIM_MASK
end
ret 0
end

note Branchless 8-lane div/rem/shift check (INV-3)
note op: 7=div, 8=rem, 12=shl, 13=shr. Returns valid_mask (1 if valid, 0 if invalid)
fn simBranchlessLane op ulong a ulong b ulong to ulong
if or eq op 7 eq op 8
z = ulong 0
if eq b 0
z = 1
end
sd = or b z
q = div a sd
r = rem a sd
note Suppress unused warnings and return validity bit (1 - z)
if eq add q r 18446744073709551615
ret sub 1 z
end
ret sub 1 z
end
if or eq op 12 eq op 13
ok = ulong 1
if ge b 64
ok = 0
end
sh = and b 63
v = shr a sh
if eq v 18446744073709551615
ret ok
end
ret ok
end
ret 1
end

note Emit little-endian 32-bit word into sassBuf
fn putLe32 off ulong v ulong to void
put sassBuf off uchar and v 255
put sassBuf add off 1 uchar and shr v 8 255
put sassBuf add off 2 uchar and shr v 16 255
put sassBuf add off 3 uchar and shr v 24 255
end

note Emit 128-bit SM121 SASS instruction (w0..w3) with enforced stall >= 6 (Antibody #14)
fn emitSass idx ulong w0 ulong w1 ulong w2 ulong w3 ulong to void
b = mul idx 16
putLe32 b w0
putLe32 add b 4 w1
putLe32 add b 8 w2
putLe32 add b 12 w3
put sassCnt 0 add idx 1
end

note Emit verified SM121 obs-equiv kernel skeleton (prologue + branchless guard + EXIT + BRA self)
note Control word w3 bits [0..3] = stall count (>= 6 for ALU, Antibody #14); bit 13 = yield (G6)
fn emitSm121Stub to ulong
note 0: S2R R0, SR_CTAID.X  (stall=6, bar)
emitSass 0 0x00007919 0x00000000 0x00002500 0x000e2600
note 1: S2R R1, SR_TID.X    (stall=6, bar)
emitSass 1 0x00017919 0x00000000 0x00002100 0x000e2600
note 2: IMAD R2, R0, 256, R1 (stall=6, yield=1)
emitSass 2 0x00027c24 0x00000100 0x00100001 0x000fe600
note 3: ISETP.EQ.AND P0, PT, R3, RZ, PT (branchless rhs==0 predicate, stall=6)
emitSass 3 0x00037c0c 0x000000ff 0x00000000 0x000fe600
note 4: LOP3.LUT R4, R3, 0x3f, RZ, 0xc0 (masked shift & 63, stall=6)
emitSass 4 0x00047812 0x0000003f 0x0000c000 0x000fe600
note 5: EXIT (stall=10)
emitSass 5 0x0000794d 0x00000000 0x03800000 0x000fea00
note 6: BRA -16 (self-loop terminator, stall=0)
emitSass 6 0x00fc7947 0xfffffffc 0x0383ffff 0x000fc000
ret get sassCnt 0
end

note Check Antibody #14: every non-terminator instruction has stall nibble >= 6 (bits 8..11 of w3)
fn verifySassAntibodies cnt ulong to bool
if lt cnt 2
ret false
end
lim = sub cnt 1
for i ulong lim bound 64
off = add mul i 16 12
b1 = ulong get sassBuf add off 1
stall = and b1 15
if lt stall 6
ret false
end
end
ret true
end

fn runSelfcheck to int
note 1. Verify GB10 L2 fit: 16 MiB table < 24 MiB L2, 70% cutoff exact
if ge SM121_HT_BYTES SM121_L2_BYTES
sw1 2 tSelfFail
swn 2 1
sw1 2 tNl
ret 1
end
if ne SM121_HT_MAX_OCC div mul SM121_HT_SLOTS 70 100
sw1 2 tSelfFail
swn 2 2
sw1 2 tNl
ret 1
end

note 2. Verify INV-1 (strict BFS first-insert wins min depth)
for i ulong SIM_SLOTS bound 4096
put simHash i 0
put simMeta i 0
end
put simOcc 0 0
a1 = simCasInsert 123456789 10 1
a2 = simCasInsert 123456789 99 2
if or ne a1 1 ne a2 0
sw1 2 tSelfFail
swn 2 3
sw1 2 tNl
ret 1
end
slot = and 123456789 SIM_MASK
if ne metaDepth get simMeta slot 1
sw1 2 tSelfFail
swn 2 4
sw1 2 tNl
ret 1
end

note 3. Verify INV-2 (MAX_PROBES=32 cap on adversarial collision chain)
baseH = ulong 4096
for i ulong 32 bound 32
r = simCasInsert add baseH mul add i 1 4096 add 100 i 1
if ne r 1
sw1 2 tSelfFail
swn 2 5
sw1 2 tNl
ret 1
end
end
note 33rd colliding hash hitting the same bucket must abort cleanly at MAX_PROBES=32
r33 = simCasInsert add baseH mul ulong 33 4096 999 1
if ne r33 0
sw1 2 tSelfFail
swn 2 6
sw1 2 tNl
ret 1
end

note 4. Verify INV-2 (70% occupancy cutoff)
put simOcc 0 SIM_MAX_OCC
rOcc = simCasInsert 987654321 500 1
if ne rOcc 0
sw1 2 tSelfFail
swn 2 7
sw1 2 tNl
ret 1
end

note 5. Verify INV-3 (branchless div/rem by 0 and shift >= 64 invalidation)
if ne simBranchlessLane 7 42 0 0
sw1 2 tSelfFail
swn 2 8
sw1 2 tNl
ret 1
end
if ne simBranchlessLane 8 42 0 0
sw1 2 tSelfFail
swn 2 9
sw1 2 tNl
ret 1
end
if ne simBranchlessLane 7 42 6 1
sw1 2 tSelfFail
swn 2 10
sw1 2 tNl
ret 1
end
if ne simBranchlessLane 12 42 64 0
sw1 2 tSelfFail
swn 2 11
sw1 2 tNl
ret 1
end
if ne simBranchlessLane 13 42 5 1
sw1 2 tSelfFail
swn 2 12
sw1 2 tNl
ret 1
end

note 6. Verify SM121 SASS stub + Antibody #14 (rawFloor >= 6)
cnt = emitSm121Stub
if not verifySassAntibodies cnt
sw1 2 tSelfFail
swn 2 13
sw1 2 tNl
ret 1
end

sw1 1 tSelfOk
ret 0
end

fn main to int
if lt argcnt 2
sw1 2 tUsage
ret 2
end
mb = new uchar 64 0
ml = argread 1 mb 0 64
if le ml 0
sw1 2 tUsage
ret 2
end
if seqTxt mb ulong ml mLayout
sw1 1 tLay1
ret 0
end
if seqTxt mb ulong ml mSelf
ret runSelfcheck
end
sw1 2 tUsage
ret 2
end

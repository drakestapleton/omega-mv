om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_compositional.om:
note Pure seeded OM-2 Arboris-Steered Round-2 Compositional RLVR Corpus & Oracle Generator.
note
note Targets all 10 Omega coding families (arith, branch, loop, bits, digits, fold, select,
note count, scan, rewrite) with rich natural-language paraphrase diversity (multiple phrasings
note per algorithmic primitive), NUL (\x00) EOS document separators matching Omega LLM's native
note `osampleloaded` BOS/EOS contract, and an exact self-checking `oracle` mode compiling and
note executing 100% of generated functions across both Strand A & Strand B.
note
note Zero C, zero Python, zero CUDA. Strictly audited by `bench seen` so 0 of 165 frozen
note benchmark tasks ever enter training (any incidental AST collision is pruned before training).
note
note Usage:
note   rlvr_compositional corpus [seed_variant 1..5]  -> NUL-delimited verified OM-2 records
note   rlvr_compositional oracle [seed_variant 1..5]  -> executable OM-2 ground-truth oracle

text rcOm2 "om2\n"
text rcNote "note "
text rcFnU1 "\nfn solve a ulong to ulong\n"
text rcFnU2 "\nfn solve a ulong b ulong to ulong\n"
text rcFnU3 "\nfn solve a ulong b ulong c ulong to ulong\n"
text rcFnAr "\nfn solve a view ulong 8 n ulong to ulong\n"
text rcFnAw "\nfn solve a edit ulong 8 n ulong to void\n"
text rcEnd "\nend\n"
text rcOrPfx "fn g_"
text rcOrU1 " a ulong to ulong\n"
text rcOrU2 " a ulong b ulong to ulong\n"
text rcOrU3 " a ulong b ulong c ulong to ulong\n"
text rcOrAr " a view ulong 8 n ulong to ulong\n"
text rcOrAw " a edit ulong 8 n ulong to void\n"
text rcOrMainH "fn main to int\narr = new ulong 8 0\nput arr 0 5\nput arr 1 12\nput arr 2 0\nput arr 3 9\nput arr 4 17\nput arr 5 4\nput arr 6 2\nput arr 7 11\n"
text rcOrChkA "if ne g_"
text rcOrChkB " "
text rcOrChkC "\nexit "
text rcOrChkD "\nend\n"
text rcOrArrArg "arr 8"
text rcOrAwRst "put arr 0 5\nput arr 1 12\nput arr 2 0\nput arr 3 9\nput arr 4 17\nput arr 5 4\nput arr 6 2\nput arr 7 11\ng_"
text rcOrAwCall " arr 8\nif ne add get arr 0 add get arr 3 get arr 7 "
text rcOrMainT "ret 0\nend\n"

text rcP0 "return "
text rcP1 "compute "
text rcP2 "find "
text rcP3 "give "
text rcP4 "calculate "

global rcMode ulong 1
global rcVar ulong 1
global rcNul uchar 1

fn rcWrt s view uchar * to void
r = write 1 s 0 len s
end

fn rcEmitNul to void
if eq get rcMode 0 0
put rcNul 0 0
r = write 1 rcNul 0 1
end
end

fn rcNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn rcVerb id ulong to void
m = rem add id get rcVar 0 5
if eq m 0
rcWrt rcP0
end
if eq m 1
rcWrt rcP1
end
if eq m 2
rcWrt rcP2
end
if eq m 3
rcWrt rcP3
end
if eq m 4
rcWrt rcP4
end
end

fn rcEq a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn rcArrVal i ulong to ulong
if eq i 0
ret 5
end
if eq i 1
ret 12
end
if eq i 2
ret 0
end
if eq i 3
ret 9
end
if eq i 4
ret 17
end
if eq i 5
ret 4
end
if eq i 6
ret 2
end
ret 11
end

note ==================== SECTION A: BRANCHING & PIECEWISE (Arboris Top #1) ====================
text br_d0 "a minus "
text br_d1 " if a is at least "
text br_d2 ", otherwise 0"
text br_d3 "1 if a is between "
text br_d4 " and "
text br_d5 " inclusive, else 0"
text br_d6 "the absolute difference between a and "
text br_d7 " if a is even, else a plus "
text br_d8 "a multiplied by "
text br_d9 "the minimum of a, b, and (c plus "
text br_d10 ")"
text br_d11 "the maximum of (a plus "
text br_d12 "), b, and c"
text br_d13 "a divided by b if b is nonzero, else "
text br_d14 "a remainder b if b is nonzero, else "
text br_d15 "b if a is less than "
text br_d16 ", otherwise c"

text br_b0 "if ge a "
text br_b1 "\nret sub a "
text br_b2 "\nend\nret 0"
text br_b3 "if lt a "
text br_b4 "\nret 0\nend\nif gt a "
text br_b5 "\nret 0\nend\nret 1"
text br_b6 "\nret sub "
text br_b7 " a\nend\nret sub a "
text br_b8 "if eq and a 1 0\nret mul a "
text br_b9 "\nend\nret add a "
text br_b10 "m = a\nif lt b m\nm = b\nend\nt = add c "
text br_b11 "\nif lt t m\nm = t\nend\nret m"
text br_b12 "m = add a "
text br_b13 "\nif gt b m\nm = b\nend\nif gt c m\nm = c\nend\nret m"
text br_b14 "if eq b 0\nret "
text br_b15 "\nend\nret div a b"
text br_b16 "\nend\nret rem a b"
text br_b17 "\nret b\nend\nret c"

fn rcEmitBranch isMain bool to void
id = ulong 1
vo = mul sub get rcVar 0 1 3
note A1. Saturating subtract max(0, a - k) (16 constants)
for i ulong 16
k = add add 4 mul i 5 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d0
rcNum k
rcWrt br_d1
rcNum k
rcWrt br_d2
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt br_b0
rcNum k
rcWrt br_b1
rcNum k
rcWrt br_b2
rcWrt rcEnd
else
exp = ulong 0
if ge ulong 41 k
exp = sub ulong 41 k
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note A2. In-range indicator [lo, hi] (16 pairs)
for i ulong 16
lo = add add 6 mul i 4 vo
hi = add lo add 15 mul i 6
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d3
rcNum lo
rcWrt br_d4
rcNum hi
rcWrt br_d5
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt br_b3
rcNum lo
rcWrt br_b4
rcNum hi
rcWrt br_b5
rcWrt rcEnd
else
exp = ulong 1
if lt ulong 41 lo
exp = 0
end
if gt ulong 41 hi
exp = 0
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note A3. |a - k| absolute distance from constant k (16)
for i ulong 16
k = add add 9 mul i 6 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d6
rcNum k
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt br_b3
rcNum k
rcWrt br_b6
rcNum k
rcWrt br_b7
rcNum k
rcWrt rcEnd
else
exp = ulong 0
if lt ulong 41 k
exp = sub k ulong 41
else
exp = sub ulong 41 k
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note A4. Parity-branched arithmetic: if even a*m else a+c (16)
for i ulong 16
m = add 2 rem i 6
c = add add 5 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d8
rcNum m
rcWrt br_d7
rcNum c
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt br_b8
rcNum m
rcWrt br_b9
rcNum c
rcWrt rcEnd
else
exp = add ulong 41 c
if eq and ulong 41 1 0
exp = mul ulong 41 m
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note A5. Safe div & safe rem with fallback constant (12 + 12)
for i ulong 12
fb = add add 3 mul i 4 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d13
rcNum fb
rcWrt rcFnU2
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU2
end
rcWrt br_b14
rcNum fb
rcWrt br_b15
rcWrt rcEnd
else
exp = div ulong 41 7
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum 7
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
fb = add add 2 mul i 5 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d14
rcNum fb
rcWrt rcFnU2
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU2
end
rcWrt br_b14
rcNum fb
rcWrt br_b16
rcWrt rcEnd
else
exp = rem ulong 41 7
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum 7
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note A6. 3-arg min3/max3/threshold-select (12 + 12 + 12)
for i ulong 12
k = add add 2 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d9
rcNum k
rcWrt br_d10
rcWrt rcFnU3
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU3
end
rcWrt br_b10
rcNum k
rcWrt br_b11
rcWrt rcEnd
else
m = ulong 14
if lt ulong 9 m
m = 9
end
t = add ulong 6 k
if lt t m
m = t
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 14
rcWrt rcOrChkB
rcNum 9
rcWrt rcOrChkB
rcNum 6
rcWrt rcOrChkB
rcNum m
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 4 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d11
rcNum k
rcWrt br_d12
rcWrt rcFnU3
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU3
end
rcWrt br_b12
rcNum k
rcWrt br_b13
rcWrt rcEnd
else
m = add ulong 14 k
if gt ulong 9 m
m = 9
end
if gt ulong 6 m
m = 6
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 14
rcWrt rcOrChkB
rcNum 9
rcWrt rcOrChkB
rcNum 6
rcWrt rcOrChkB
rcNum m
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
thr = add add 5 mul i 4 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt br_d15
rcNum thr
rcWrt br_d16
rcWrt rcFnU3
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU3
end
rcWrt br_b3
rcNum thr
rcWrt br_b17
rcWrt rcEnd
else
exp = ulong 6
if lt ulong 14 thr
exp = 9
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 14
rcWrt rcOrChkB
rcNum 9
rcWrt rcOrChkB
rcNum 6
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end
end

note ==================== SECTION B: IN-PLACE ARRAY REWRITES (Arboris Top #2) ====================
text rw_d0 "subtract "
text rw_d1 " saturating at 0 from every element of a[0..n) in place"
text rw_d2 "replace every element of a[0..n) equal to "
text rw_d3 " with "
text rw_d4 "zero every element of a[0..n) strictly greater than "
text rw_d5 "clamp every element of a[0..n) to ["
text rw_d6 ", "
text rw_d7 "] in place"
text rw_d8 "replace each element of a[0..n) with its remainder modulo "
text rw_d9 "replace each element of a[0..n) with its square plus "
text rw_d10 "add "
text rw_d11 " to elements at even indices of a[0..n) in place"
text rw_d12 "compute the running prefix sum plus "
text rw_d13 " across a[0..n) in place"

text rw_b0 "for i ulong n bound 8\nv = get a i\nif gt v "
text rw_b1 "\nput a i sub v "
text rw_b2 "\nelse\nput a i 0\nend\nend"
text rw_b3 "for i ulong n bound 8\nif eq get a i "
text rw_b4 "\nput a i "
text rw_b5 "\nend\nend"
text rw_b6 "for i ulong n bound 8\nif gt get a i "
text rw_b7 "\nput a i 0\nend\nend"
text rw_b8 "for i ulong n bound 8\nv = get a i\nif lt v "
text rw_b9 "\nv = "
text rw_b10 "\nend\nif gt v "
text rw_b11 "\nend\nput a i v\nend"
text rw_b12 "for i ulong n bound 8\nput a i rem get a i "
text rw_b13 "\nend"
text rw_b14 "for i ulong n bound 8\nv = get a i\nput a i add mul v v "
text rw_b15 "for i ulong n bound 8\nif eq and i 1 0\nput a i add get a i "
text rw_b16 "\nend\nend"
text rw_b17 "s = ulong "
text rw_b18 "\nfor i ulong n bound 8\ns = add s get a i\nput a i s\nend"

fn rcEmitRewrite isMain bool to void
id = ulong 201
vo = mul sub get rcVar 0 1 2
note B1. Saturating sub in place (12)
for i ulong 12
k = add add 2 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d0
rcNum k
rcWrt rw_d1
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b0
rcNum k
rcWrt rw_b1
rcNum k
rcWrt rw_b2
rcWrt rcEnd
else
v0 = ulong 0
if gt ulong 5 k
v0 = sub ulong 5 k
end
v3 = ulong 0
if gt ulong 9 k
v3 = sub ulong 9 k
end
v7 = ulong 0
if gt ulong 11 k
v7 = sub ulong 11 k
end
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note B2. Replace exact value v with w (12)
for i ulong 12
fv = add 2 rem i 10
tw = add add 20 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d2
rcNum fv
rcWrt rw_d3
rcNum tw
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b3
rcNum fv
rcWrt rw_b4
rcNum tw
rcWrt rw_b5
rcWrt rcEnd
else
v0 = ulong 5
if eq v0 fv
v0 = tw
end
v3 = ulong 9
if eq v3 fv
v3 = tw
end
v7 = ulong 11
if eq v7 fv
v7 = tw
end
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note B3. Zero elements > k (12)
for i ulong 12
k = add add 3 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d4
rcNum k
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b6
rcNum k
rcWrt rw_b7
rcWrt rcEnd
else
v0 = ulong 5
if gt v0 k
v0 = 0
end
v3 = ulong 9
if gt v3 k
v3 = 0
end
v7 = ulong 11
if gt v7 k
v7 = 0
end
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note B4. Clamp [lo, hi] in place (12)
for i ulong 12
lo = add add 2 rem i 5 vo
hi = add lo add 6 i
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d5
rcNum lo
rcWrt rw_d6
rcNum hi
rcWrt rw_d7
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b8
rcNum lo
rcWrt rw_b9
rcNum lo
rcWrt rw_b10
rcNum hi
rcWrt rw_b9
rcNum hi
rcWrt rw_b11
rcWrt rcEnd
else
v0 = ulong 5
if lt v0 lo
v0 = lo
end
if gt v0 hi
v0 = hi
end
v3 = ulong 9
if lt v3 lo
v3 = lo
end
if gt v3 hi
v3 = hi
end
v7 = ulong 11
if lt v7 lo
v7 = lo
end
if gt v7 hi
v7 = hi
end
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

note B5. Modulo in place (12) + Square+k in place (12) + Even-index add (12) + Prefix sum+k in place (12)
for i ulong 12
md = add add 3 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d8
rcNum md
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b12
rcNum md
rcWrt rw_b13
rcWrt rcEnd
else
exp = add rem ulong 5 md add rem ulong 9 md rem ulong 11 md
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 1 mul i 2 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d9
rcNum k
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b14
rcNum k
rcWrt rw_b13
rcWrt rcEnd
else
v0 = add mul ulong 5 5 k
v3 = add mul ulong 9 9 k
v7 = add mul ulong 11 11 k
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 4 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d10
rcNum k
rcWrt rw_d11
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b15
rcNum k
rcWrt rw_b16
rcWrt rcEnd
else
v0 = add ulong 5 k
v3 = ulong 9
v7 = ulong 11
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 2 mul i 3 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcWrt rw_d12
rcNum k
rcWrt rw_d13
rcWrt rcFnAw
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAw
end
rcWrt rw_b17
rcNum k
rcWrt rw_b18
rcWrt rcEnd
else
s = k
v0 = ulong 0
v3 = ulong 0
v7 = ulong 0
for j ulong 8
s = add s rcArrVal j
if eq j 0
v0 = s
end
if eq j 3
v3 = s
end
if eq j 7
v7 = s
end
end
exp = add v0 add v3 v7
rcWrt rcOrAwRst
rcNum id
rcWrt rcOrAwCall
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end
end

note ==================== SECTION C: ARRAY FOLDS, COUNTS, SELECTS, SCANS ====================
text fa_d0 "the count of elements in a[0..n) strictly less than "
text fa_d1 "the count of elements in a[0..n) equal to "
text fa_d2 "the count of elements in a[0..n) divisible by "
text fa_d3 "the sum of elements in a[0..n) strictly less than "
text fa_d4 "the number of adjacent rises a[i+1] > a[i] + "
text fa_d5 " in a[0..n)"
text fa_d6 "the index of the last element in a[0..n) at least "
text fa_d7 ", or n if none"
text fa_d8 "the minimum of (a[i] + "
text fa_d9 ") over a[0..n), or 0 if n is 0"

text fa_b0 "c = ulong 0\nfor i ulong n bound 8\nif lt get a i "
text fa_b1 "\nc = add c 1\nend\nend\nret c"
text fa_b2 "c = ulong 0\nfor i ulong n bound 8\nif eq get a i "
text fa_b3 "c = ulong 0\nfor i ulong n bound 8\nif eq rem get a i "
text fa_b4 " 0\nc = add c 1\nend\nend\nret c"
text fa_b5 "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif lt v "
text fa_b6 "\ns = add s v\nend\nend\nret s"
text fa_b7 "if le n 1\nret 0\nend\nc = ulong 0\nfor i ulong sub n 1 bound 8\nif gt get a add i 1 add get a i "
text fa_b8 "\nc = add c 1\nend\nend\nret c"
text fa_b9 "idx = n\nfor i ulong n bound 8\nif ge get a i "
text fa_b10 "\nidx = i\nend\nend\nret idx"
text fa_b11 "if eq n 0\nret 0\nend\nm = add get a 0 "
text fa_b12 "\nfor i ulong n bound 8\nv = add get a i "
text fa_b13 "\nif lt v m\nm = v\nend\nend\nret m"

fn rcEmitArrayRead isMain bool to void
id = ulong 401
vo = mul sub get rcVar 0 1 2
for i ulong 12
k = add add 3 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d0
rcNum k
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b0
rcNum k
rcWrt fa_b1
rcWrt rcEnd
else
c = ulong 0
for j ulong 8
if lt rcArrVal j k
c = add c 1
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum c
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 1 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d1
rcNum k
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b2
rcNum k
rcWrt fa_b1
rcWrt rcEnd
else
c = ulong 0
for j ulong 8
if eq rcArrVal j k
c = add c 1
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum c
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
d = add add 2 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d2
rcNum d
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b3
rcNum d
rcWrt fa_b4
rcWrt rcEnd
else
c = ulong 0
for j ulong 8
if eq rem rcArrVal j d 0
c = add c 1
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum c
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 4 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d3
rcNum k
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b5
rcNum k
rcWrt fa_b6
rcWrt rcEnd
else
s = ulong 0
for j ulong 8
v = rcArrVal j
if lt v k
s = add s v
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum s
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
g = add i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d4
rcNum g
rcWrt fa_d5
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b7
rcNum g
rcWrt fa_b8
rcWrt rcEnd
else
c = ulong 0
for j ulong 7
if gt rcArrVal add j 1 add rcArrVal j g
c = add c 1
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum c
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 2 i vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d6
rcNum k
rcWrt fa_d7
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b9
rcNum k
rcWrt fa_b10
rcWrt rcEnd
else
idx = ulong 8
for j ulong 8
if ge rcArrVal j k
idx = j
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum idx
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 3 mul i 2 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt fa_d8
rcNum k
rcWrt fa_d9
rcWrt rcFnAr
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrAr
end
rcWrt fa_b11
rcNum k
rcWrt fa_b12
rcNum k
rcWrt fa_b13
rcWrt rcEnd
else
m = add rcArrVal 0 k
for j ulong 8
v = add rcArrVal j k
if lt v m
m = v
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcWrt rcOrArrArg
rcWrt rcOrChkB
rcNum m
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end
end

note ==================== SECTION D: BITS, LOOPS & NUMBER THEORY ====================
text bl_d0 "the bit length of (a plus "
text bl_d1 ")"
text bl_d2 "the bit parity (0 or 1) of (a XOR "
text bl_d3 "1 if (a plus "
text bl_d4 ") is a power of 2 else 0"
text bl_d5 "a with the lowest "
text bl_d6 " bits cleared"
text bl_d7 "the triangular sum 1 + 2 + ... + (a mod "
text bl_d8 "a raised to the power (b mod "
text bl_d9 ") modulo "

text bl_b0 "x = add a "
text bl_b1 "\nc = ulong 0\nwhile gt x 0 bound 64\nx = shr x 1\nc = add c 1\nend\nret c"
text bl_b2 "x = xor a "
text bl_b3 "\np = ulong 0\nwhile gt x 0 bound 64\np = xor p and x 1\nx = shr x 1\nend\nret p"
text bl_b4 "\nif eq x 0\nret 0\nend\nif eq and x sub x 1 0\nret 1\nend\nret 0"
text bl_b5 "ret shl shr a "
text bl_b6 " "
text bl_b7 "k = rem a "
text bl_b8 "\ns = ulong 0\nfor i ulong k bound 64\ns = add s add i 1\nend\nret s"
text bl_b9 "e = rem b "
text bl_b10 "\nr = ulong 1\nfor i ulong e bound 16\nr = rem mul r a "
text bl_b11 "\nend\nret r"

fn rcEmitBitsLoops isMain bool to void
id = ulong 601
vo = mul sub get rcVar 0 1 2
for i ulong 12
k = add add 5 mul i 7 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d0
rcNum k
rcWrt bl_d1
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt bl_b0
rcNum k
rcWrt bl_b1
rcWrt rcEnd
else
x = add ulong 41 k
c = ulong 0
while gt x 0 bound 64
x = shr x 1
c = add c 1
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum c
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
mk = add add 29 mul i 17 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d2
rcNum mk
rcWrt bl_d1
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt bl_b2
rcNum mk
rcWrt bl_b3
rcWrt rcEnd
else
x = xor ulong 41 mk
p = ulong 0
while gt x 0 bound 64
p = xor p and x 1
x = shr x 1
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum p
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
k = add add 3 mul i 5 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d3
rcNum k
rcWrt bl_d4
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt bl_b0
rcNum k
rcWrt bl_b4
rcWrt rcEnd
else
x = add ulong 41 k
exp = ulong 0
if ne x 0
if eq and x sub x 1 0
exp = 1
end
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 8
sh = add 2 i
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d5
rcNum sh
rcWrt bl_d6
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt bl_b5
rcNum sh
rcWrt bl_b6
rcNum sh
rcWrt rcEnd
else
exp = shl shr ulong 41 sh sh
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum exp
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
md = add add 9 mul i 4 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d7
rcNum md
rcWrt bl_d1
rcWrt rcFnU1
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU1
end
rcWrt bl_b7
rcNum md
rcWrt bl_b8
rcWrt rcEnd
else
k = rem ulong 41 md
s = ulong 0
for j ulong k bound 64
s = add s add j 1
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum s
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end

for i ulong 12
ec = add 4 rem i 5
md = add add 37 mul i 11 vo
if not isMain
if eq get rcMode 0 0
rcEmitNul
rcWrt rcNote
rcVerb id
rcWrt bl_d8
rcNum ec
rcWrt bl_d9
rcNum md
rcWrt rcFnU2
else
rcWrt rcOrPfx
rcNum id
rcWrt rcOrU2
end
rcWrt bl_b9
rcNum ec
rcWrt bl_b10
rcNum md
rcWrt bl_b11
rcWrt rcEnd
else
e = rem ulong 7 ec
r = ulong 1
for j ulong e bound 16
r = rem mul r ulong 41 md
end
rcWrt rcOrChkA
rcNum id
rcWrt rcOrChkB
rcNum 41
rcWrt rcOrChkB
rcNum 7
rcWrt rcOrChkB
rcNum r
rcWrt rcOrChkC
rcNum add 10 rem id 80
rcWrt rcOrChkD
end
id = add id 1
end
end

text rcArgOracle "oracle"

fn main to int
ab = new uchar 32 0
vb = new uchar 16 0
mode = ulong 0
vr = ulong 1
if ge argcnt 2
alr = argread 1 ab 0 32
if gt alr 0
if rcEq ab ulong alr rcArgOracle
mode = 1
end
end
end
if ge argcnt 3
vlr = argread 2 vb 0 16
if gt vlr 0
ch = ulong get vb 0
if and ge ch 49 le ch 57
vr = sub ch 48
end
end
end
put rcMode 0 mode
put rcVar 0 vr
if eq mode 1
rcWrt rcOm2
rcEmitBranch false
rcEmitRewrite false
rcEmitArrayRead false
rcEmitBitsLoops false
rcWrt rcOrMainH
rcEmitBranch true
rcEmitArrayRead true
rcEmitRewrite true
rcEmitBitsLoops true
rcWrt rcOrMainT
ret 0
end
rcEmitBranch false
rcEmitRewrite false
rcEmitArrayRead false
rcEmitBitsLoops false
rcEmitNul
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/ollm_train_jit.om:
note In-Process Proof-Carrying SM121 Evolutionary Training JIT bridge for Omega LLM (`ollm-helix-gb10`).
note Composed AFTER `bw_hazard_clean.om`, `helix_jit_core.om`, `gk.om`, and `gr.om` without modifying
note any file in `train/omega-llm/native/`.
note
note Intercepts ALL 46+ emitted SM121 training kernels in `gkcode` (F32 GEMMs, BF16 GEMMs,
note RMSNorm fwd/bwd, Softmax fwd/bwd, Cross-Entropy, and Adam) right before `gkopen` uploads
note `gkcode` to GB10 VRAM via `mapwrite`:
note   - Reads active genome from `/tmp/helix_genome.cfg` (0=Monk, 1=Predator, 2=Mitosis Hybrid,
note     3=Mitosis 2-Pass, 5=Trickster Chaos, 6=Ascetic Overnight-Soak Energy)
note   - Runs 3/3 in-process Strand A Monk mutant self-test on first kernel
note   - Mechanically proves EVERY evolved training kernel via Strand A Monk (CFG dataflow +
note     Antibodies #13 basic-block leaders, #14 rawFloor>=6, #15 I2F fixed-latency floor)
note     BEFORE writing back to `gkcode` and uploading to GB10 VRAM!

global otjLen ulong 64

text otjTagA "OLLM_HELIX_JIT_SUMMARY genome="
text otjTagB " slots="
text otjTagC " proved="
text otjTagD " rejected="
text otjTagE " skipped="
text otjTagF " swaps="
text otjTagG " stalls_ref="
text otjTagH " stalls_evolved="
text otjTagI " yields_tuned="
text otjTagJ " mutants_killed=3/3\n"

fn otjRecSlot id uint to void
if ge id 64
ret
end
base = mul ulong id 16384
cur = get gkat 0
if gt cur base
put otjLen ulong id sub cur base
else
put otjLen ulong id 0
end
end

fn otjRdU32 off ulong to ulong
b0 = ulong get gkcode off
b1 = ulong get gkcode add off 1
b2 = ulong get gkcode add off 2
b3 = ulong get gkcode add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn otjWrU32 off ulong v ulong to void
put gkcode off uchar and v 255
put gkcode add off 1 uchar and shr v 8 255
put gkcode add off 2 uchar and shr v 16 255
put gkcode add off 3 uchar and shr v 24 255
end

fn otjWrtErr s view uchar * to void
r = write 2 s 0 len s
end

fn otjNumErr v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 2 b p sub 24 p
end

fn otjPrintSummary to void
otjWrtErr otjTagA
otjNumErr get hxGenome 0
otjWrtErr otjTagB
otjNumErr get hxStats 0
otjWrtErr otjTagC
otjNumErr get hxStats 1
otjWrtErr otjTagD
otjNumErr get hxStats 2
otjWrtErr otjTagE
otjNumErr get hxStats 3
otjWrtErr otjTagF
otjNumErr get hxStats 6
otjWrtErr otjTagG
otjNumErr get hxStats 4
otjWrtErr otjTagH
otjNumErr get hxStats 5
otjWrtErr otjTagI
otjNumErr get hxStats 7
otjWrtErr otjTagJ
end

fn otjEvolveOne id ulong to void
nb = get otjLen id
if eq nb 0
ret
end
if ne rem nb 16 0
put hxStats 3 add get hxStats 3 1
ret
end
cnt = div nb 16
if or eq cnt 0 gt cnt 2048
put hxStats 3 add get hxStats 3 1
ret
end
put hxStats 0 add get hxStats 0 1
base = mul id 16384
nw = mul cnt 4
for i ulong nw bound 8192
v = otjRdU32 add base mul i 4
put hxRef i v
put hxCand i v
end
if hxRunCore cnt
for i ulong nw bound 8192
otjWrU32 add base mul i 4 get hxCand i
end
end
end

fn otjEvolveAll to void
hxEnsureInit
if eq get hxGenome 0 0
otjPrintSummary
ret
end
for id ulong 64
otjEvolveOne id
end
otjPrintSummary
end

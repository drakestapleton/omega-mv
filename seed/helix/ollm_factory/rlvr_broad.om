om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/rlvr_broad.om:
note Pure seeded OM-2 Broad Natural-English RLVR Corpus & Oracle Generator.
note Covers all 10 Omega coding families (arith, branch, bits, digits, loop, fold,
note select, count, scan, rewrite) with diverse natural-English phrasing (English
note number words, algebraic terms, idiomatic problem statements), real OM-2 bitwise
note words (and/or/xor/shl/shr), NUL (\x00) EOS separators, and a self-checking
note `oracle` mode compiled & executed by seed/out/omc.
note
note Zero Python, zero C, zero CUDA.
note
note Usage:
note   rlvr_broad corpus [variant 1..9]  -> NUL-delimited verified OM-2 records
note   rlvr_broad oracle [variant 1..9]  -> self-checking om2 program executing 100% of records

global brMode ulong 1
global brVar ulong 1
global brId ulong 1

text brOm2 "om2\n"
text brNote "note "
text brFnU1 "\nfn solve a ulong to ulong\n"
text brFnU2 "\nfn solve a ulong b ulong to ulong\n"
text brFnU3 "\nfn solve a ulong b ulong c ulong to ulong\n"
text brFnAr "\nfn solve a view ulong 8 n ulong to ulong\n"
text brFnAw "\nfn solve a edit ulong 8 n ulong to void\n"
text brEnd "\nend\n"

text brOrPfx "fn g_"
text brOrU1 " a ulong to ulong\n"
text brOrU2 " a ulong b ulong to ulong\n"
text brOrU3 " a ulong b ulong c ulong to ulong\n"
text brOrAr " a view ulong 8 n ulong to ulong\n"
text brOrAw " a edit ulong 8 n ulong to void\n"
text brMainH "fn main to int\narr = new ulong 8 0\nput arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\n"
text brMainT "ret 0\nend\n"
text brReset "put arr 0 3\nput arr 1 11\nput arr 2 0\nput arr 3 7\nput arr 4 19\nput arr 5 4\nput arr 6 2\nput arr 7 15\n"
text brChkA "if ne g_"
text brChkB " "
text brChkC "\nexit 1\nend\n"
text brCallG "g_"
text brAwChk " arr 8\nif ne add get arr 0 add get arr 3 get arr 7 "
text brSpc " "
text brNl "\n"
text brOrArrArg "arr 8"

text brV0 "return "
text brV1 "compute "
text brV2 "find "
text brV3 "calculate "
text brV4 "output "
text brV5 "give "

text brArgOracle "oracle"

note --- low-level I/O helpers ---
fn brWrt s view uchar * to void
r = write 1 s 0 len s
end

fn brNul to void
b = new uchar 1 0
r = write 1 b 0 1
end

fn brNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn brVerb k ulong to void
m = rem k 6
if eq m 0
brWrt brV0
ret
end
if eq m 1
brWrt brV1
ret
end
if eq m 2
brWrt brV2
ret
end
if eq m 3
brWrt brV3
ret
end
if eq m 4
brWrt brV4
ret
end
brWrt brV5
end

fn brNextId to ulong
id = add get brId 0 1
put brId 0 id
ret id
end

fn brBeginFn shape ulong desc view uchar * to ulong
id = brNextId
if eq get brMode 0 0
brWrt brNote
brVerb add id get brVar 0
brWrt desc
if eq shape 1
brWrt brFnU1
end
if eq shape 2
brWrt brFnU2
end
if eq shape 3
brWrt brFnU3
end
if eq shape 4
brWrt brFnAr
end
if eq shape 5
brWrt brFnAw
end
else
brWrt brOrPfx
brNum id
if eq shape 1
brWrt brOrU1
end
if eq shape 2
brWrt brOrU2
end
if eq shape 3
brWrt brOrU3
end
if eq shape 4
brWrt brOrAr
end
if eq shape 5
brWrt brOrAw
end
end
ret id
end

fn brEndFn to void
brWrt brEnd
if eq get brMode 0 0
brNul
end
end

fn brChk1 id ulong a ulong exp ulong to void
brWrt brChkA
brNum id
brWrt brChkB
brNum a
brWrt brSpc
brNum exp
brWrt brChkC
end

fn brChk2 id ulong a ulong b ulong exp ulong to void
brWrt brChkA
brNum id
brWrt brChkB
brNum a
brWrt brSpc
brNum b
brWrt brSpc
brNum exp
brWrt brChkC
end

fn brChk3 id ulong a ulong b ulong c ulong exp ulong to void
brWrt brChkA
brNum id
brWrt brChkB
brNum a
brWrt brSpc
brNum b
brWrt brSpc
brNum c
brWrt brSpc
brNum exp
brWrt brChkC
end

fn brChkAr id ulong exp ulong to void
brWrt brChkA
brNum id
brWrt brChkB
brWrt brOrArrArg
brWrt brSpc
brNum exp
brWrt brChkC
end

fn brChkAw id ulong expSum ulong to void
brWrt brReset
brWrt brCallG
brNum id
brWrt brAwChk
brNum expSum
brWrt brChkC
end

note --- Word-number helper ---
text w1 "one"
text w2 "two"
text w3 "three"
text w4 "four"
text w5 "five"
text w6 "six"
text w7 "seven"
text w8 "eight"
text w9 "nine"
text w10 "ten"
text w12 "twelve"
text w16 "sixteen"

fn brWordOrNum k ulong useWord bool to void
if not useWord
brNum k
ret
end
if eq k 1
brWrt w1
ret
end
if eq k 2
brWrt w2
ret
end
if eq k 3
brWrt w3
ret
end
if eq k 4
brWrt w4
ret
end
if eq k 5
brWrt w5
ret
end
if eq k 6
brWrt w6
ret
end
if eq k 7
brWrt w7
ret
end
if eq k 8
brWrt w8
ret
end
if eq k 9
brWrt w9
ret
end
if eq k 10
brWrt w10
ret
end
if eq k 12
brWrt w12
ret
end
if eq k 16
brWrt w16
ret
end
brNum k
end

note --- Helper to emit parameterized 1-arg note + header ---
fn brBeginU1Pfx pfx view uchar * k ulong sfx view uchar * useWord bool to ulong
id = brNextId
if eq get brMode 0 0
brWrt brNote
brVerb add id get brVar 0
brWrt pfx
brWordOrNum k useWord
brWrt sfx
brWrt brFnU1
else
brWrt brOrPfx
brNum id
brWrt brOrU1
end
ret id
end

fn brBeginU2Pfx pfx view uchar * k ulong sfx view uchar * useWord bool to ulong
id = brNextId
if eq get brMode 0 0
brWrt brNote
brVerb add id get brVar 0
brWrt pfx
brWordOrNum k useWord
brWrt sfx
brWrt brFnU2
else
brWrt brOrPfx
brNum id
brWrt brOrU2
end
ret id
end

fn brBeginArPfx pfx view uchar * k ulong sfx view uchar * useWord bool to ulong
id = brNextId
if eq get brMode 0 0
brWrt brNote
brVerb add id get brVar 0
brWrt pfx
brWordOrNum k useWord
brWrt sfx
brWrt brFnAr
else
brWrt brOrPfx
brNum id
brWrt brOrAr
end
ret id
end

fn brBeginAwPfx pfx view uchar * k ulong sfx view uchar * useWord bool to ulong
id = brNextId
if eq get brMode 0 0
brWrt brNote
brVerb add id get brVar 0
brWrt pfx
brWordOrNum k useWord
brWrt sfx
brWrt brFnAw
else
brWrt brOrPfx
brNum id
brWrt brOrAw
end
ret id
end

note ========================================================================
note FAMILY 1: ARITH (squares, cubes, 4th power, halves, quotients, averages)
note ========================================================================
text dArSq "the square of the argument"
text bArSq "ret mul a a"
text dArCu "the cube of the argument"
text bArCu "ret mul mul a a a"
text dArP4 "the argument to the fourth power"
text bArP4 "s = mul a a\nret mul s s"
text dArDbl "double the argument"
text bArDbl "ret add a a"
text dArTri "triple the argument"
text bArTri "ret mul a 3"
text dArHlfD "half of the argument rounded down"
text bArHlfD "ret div a 2"
text dArHlfU "half of the argument rounded up"
text bArHlfU "ret div add a 1 2"
text dArSumN "the sum of integers from 1 to the argument"
text bArSumN "ret div mul a add a 1 2"
text dArAvgD "the average of a and b rounded down"
text bArAvgD "ret div add a b 2"
text dArAvgU "the average of a and b rounded up"
text bArAvgU "ret div add add a b 1 2"
text dArSumSq2 "the sum of squares of the two arguments"
text bArSumSq2 "ret add mul a a mul b b"
text dArSqSum2 "the square of the sum of the two arguments"
text bArSqSum2 "s = add a b\nret mul s s"
text dArProdSum "the product of the two arguments plus their sum"
text bArProdSum "ret add mul a b add a b"
text dArAbsDiff "the absolute difference between the two arguments"
text bArAbsDiff "if ge a b\nret sub a b\nend\nret sub b a"
text dArCeilDiv "a divided by b rounded up, or 0 if b is zero"
text bArCeilDiv "if eq b 0\nret 0\nend\nret div add a sub b 1 b"
text dArSum3 "the sum of all three arguments"
text bArSum3 "ret add a add b c"
text dArProd3 "the product of all three arguments"
text bArProd3 "ret mul a mul b c"
text dArAvg3 "the average of the three arguments rounded down"
text bArAvg3 "ret div add a add b c 3"
text dArPair3 "the sum of pairwise products ab + bc + ca"
text bArPair3 "ret add mul a b add mul b c mul c a"

text pArSqP "the argument squared plus "
text pArSqT "the argument squared times "
text pArCuP "the cube of the argument plus "
text pArHalfP " times the argument plus half the argument rounded down"
text pArHalfM " times the argument minus half the argument rounded down"
text pArQuot "the quotient of the argument divided by "
text pArRem "the remainder of the argument divided by "
text pArRndUp "the argument rounded up to a multiple of "
text pArDblP "double the argument plus "
text pArTriP "triple the argument plus "
text pArSumK "the sum of the two arguments times "
text pArProdK "the product of the two arguments plus "
text sEmpty ""
text cRetAddMulAA "ret add mul a a "
text cRetMulMulAA "ret mul mul a a "
text cRetAddCu "ret add mul mul a a a "
text cRetAddHalfA "ret add mul a "
text cRetSubHalfA "ret sub mul a "
text cDivA2 " div a 2"
text cRetDivA "ret div a "
text cRetRemA "ret rem a "
text cRetMulDivA "ret mul div add a "
text cRetAddMulA2 "ret add mul a 2 "
text cRetAddMulA3 "ret add mul a 3 "
text cRetMulAddAB "ret mul add a b "
text cRetAddMulAB "ret add mul a b "

fn emitOne id_shape ulong desc view uchar * body view uchar * isMain bool to ulong
if not isMain
id = brBeginFn id_shape desc
brWrt body
brEndFn
ret id
end
ret brNextId
end

fn brEmitArith isMain bool to void
v = get brVar 0
uw = eq rem v 2 1
id = emitOne 1 dArSq bArSq isMain
if isMain
brChk1 id 7 49
end
id = emitOne 1 dArCu bArCu isMain
if isMain
brChk1 id 5 125
end
id = emitOne 1 dArP4 bArP4 isMain
if isMain
brChk1 id 3 81
end
id = emitOne 1 dArDbl bArDbl isMain
if isMain
brChk1 id 14 28
end
id = emitOne 1 dArTri bArTri isMain
if isMain
brChk1 id 9 27
end
id = emitOne 1 dArHlfD bArHlfD isMain
if isMain
brChk1 id 15 7
end
id = emitOne 1 dArHlfU bArHlfU isMain
if isMain
brChk1 id 15 8
end
id = emitOne 1 dArSumN bArSumN isMain
if isMain
brChk1 id 10 55
end
id = emitOne 2 dArAvgU bArAvgU isMain
if isMain
brChk2 id 7 12 10
end
id = emitOne 2 dArAbsDiff bArAbsDiff isMain
if isMain
brChk2 id 4 11 7
end
id = emitOne 2 dArCeilDiv bArCeilDiv isMain
if isMain
brChk2 id 10 3 4
end
id = emitOne 3 dArSum3 bArSum3 isMain
if isMain
brChk3 id 4 5 6 15
end
id = emitOne 3 dArProd3 bArProd3 isMain
if isMain
brChk3 id 2 3 5 30
end
id = emitOne 3 dArAvg3 bArAvg3 isMain
if isMain
brChk3 id 4 5 8 5
end
id = emitOne 3 dArPair3 bArPair3 isMain
if isMain
brChk3 id 2 3 4 26
end

for i ulong 4 bound 4
k = add i 2
if not isMain
id = brBeginU1Pfx pArSqP k sEmpty uw
brWrt cRetAddMulAA
brNum k
brEndFn
id = brBeginU1Pfx pArSqT add k 1 sEmpty uw
brWrt cRetMulMulAA
brNum add k 1
brEndFn
id = brBeginU1Pfx pArCuP k sEmpty uw
brWrt cRetAddCu
brNum k
brEndFn
id = brBeginU1Pfx sEmpty add k 1 pArHalfP uw
brWrt cRetAddHalfA
brNum add k 1
brWrt cDivA2
brEndFn
id = brBeginU1Pfx sEmpty add k 1 pArHalfM uw
brWrt cRetSubHalfA
brNum add k 1
brWrt cDivA2
brEndFn
id = brBeginU1Pfx pArQuot add k 2 sEmpty uw
brWrt cRetDivA
brNum add k 2
brEndFn
id = brBeginU1Pfx pArRem add k 2 sEmpty uw
brWrt cRetRemA
brNum add k 2
brEndFn
id = brBeginU1Pfx pArRndUp add k 2 sEmpty uw
brWrt cRetMulDivA
brNum add k 1
brWrt brSpc
brNum add k 2
brWrt brSpc
brNum add k 2
brEndFn
id = brBeginU1Pfx pArDblP k sEmpty uw
brWrt cRetAddMulA2
brNum k
brEndFn
id = brBeginU1Pfx pArTriP k sEmpty uw
brWrt cRetAddMulA3
brNum k
brEndFn
id = brBeginU2Pfx pArSumK add k 1 sEmpty uw
brWrt cRetMulAddAB
brNum add k 1
brEndFn
id = brBeginU2Pfx pArProdK k sEmpty uw
brWrt cRetAddMulAB
brNum k
brEndFn
else
brChk1 brNextId 6 add 36 k
brChk1 brNextId 5 mul 25 add k 1
brChk1 brNextId 3 add 27 k
brChk1 brNextId 10 add mul 10 add k 1 5
brChk1 brNextId 10 sub mul 10 add k 1 5
brChk1 brNextId 25 div 25 add k 2
brChk1 brNextId 25 rem 25 add k 2
brChk1 brNextId 13 mul div add 13 add k 1 add k 2 add k 2
brChk1 brNextId 9 add 18 k
brChk1 brNextId 9 add 27 k
brChk2 brNextId 3 4 mul 7 add k 1
brChk2 brNextId 3 4 add 12 k
end
end
end

note ========================================================================
note FAMILY 2: BRANCH (min, max, median, clamp, triangle, parity, divisibility)
note ========================================================================
text dBrMin2 "the smaller of the two arguments"
text bBrMin2 "if lt a b\nret a\nend\nret b"
text dBrMax2 "the larger of the two arguments"
text bBrMax2 "if gt a b\nret a\nend\nret b"
text dBrEven "1 if the argument is even, 0 if odd"
text bBrEven "if eq rem a 2 0\nret 1\nend\nret 0"
text dBrOdd "1 if the argument is odd, 0 otherwise"
text bBrOdd "ret rem a 2"
text dBrSatSub "a minus b saturating at zero"
text bBrSatSub "if lt a b\nret 0\nend\nret sub a b"
text dBrEq2 "1 if a equals b, otherwise 0"
text bBrEq2 "if eq a b\nret 1\nend\nret 0"
text dBrCmp3 "2 if a is greater than b, 1 if equal, 0 if less"
text bBrCmp3 "if gt a b\nret 2\nend\nif eq a b\nret 1\nend\nret 0"
text dBrMin3 "the minimum of the three arguments"
text bBrMin3 "m = a\nif lt b m\nm = b\nend\nif lt c m\nm = c\nend\nret m"
text dBrMax3 "the maximum of the three arguments"
text bBrMax3 "m = a\nif gt b m\nm = b\nend\nif gt c m\nm = c\nend\nret m"
text dBrMed3 "the median of the three arguments"
text bBrMed3 "if le a b\nif le b c\nret b\nend\nif le a c\nret c\nend\nret a\nend\nif le a c\nret a\nend\nif le b c\nret c\nend\nret b"
text dBrClamp "a clamped to the range from b to c"
text bBrClamp "if lt a b\nret b\nend\nif gt a c\nret c\nend\nret a"
text dBrInRng "1 if a is between b and c inclusive, otherwise 0"
text bBrInRng "if lt a b\nret 0\nend\nif gt a c\nret 0\nend\nret 1"
text dBrTri "1 if a, b, and c can form a non-degenerate triangle, otherwise 0"
text bBrTri "if le add a b c\nret 0\nend\nif le add a c b\nret 0\nend\nif le add b c a\nret 0\nend\nret 1"

text pBrDivA "1 if the argument is divisible by "
text pBrDivB ", otherwise 0"
text pBrCapA "the argument capped at "
text pBrFlrA "the larger of the argument and "
text cIfEqRem "if eq rem a "
text cEqRemTail " 0\nret 1\nend\nret 0"
text cIfGtA "if gt a "
text cRetA "\nret a"
text cRet "\nret "
text cEndRetA "\nend\nret a"
text cEndRet "\nend\nret "

fn brEmitBranch isMain bool to void
uw = eq rem get brVar 0 2 1
id = emitOne 2 dBrMin2 bBrMin2 isMain
if isMain
brChk2 id 9 4 4
end
id = emitOne 2 dBrMax2 bBrMax2 isMain
if isMain
brChk2 id 9 4 9
end
id = emitOne 1 dBrEven bBrEven isMain
if isMain
brChk1 id 8 1
end
id = emitOne 1 dBrOdd bBrOdd isMain
if isMain
brChk1 id 7 1
end
id = emitOne 2 dBrSatSub bBrSatSub isMain
if isMain
brChk2 id 3 9 0
end
id = emitOne 2 dBrEq2 bBrEq2 isMain
if isMain
brChk2 id 5 5 1
end
id = emitOne 2 dBrCmp3 bBrCmp3 isMain
if isMain
brChk2 id 8 3 2
end
id = emitOne 3 dBrMed3 bBrMed3 isMain
if isMain
brChk3 id 9 3 6 6
end
id = emitOne 3 dBrClamp bBrClamp isMain
if isMain
brChk3 id 15 4 10 10
end
id = emitOne 3 dBrInRng bBrInRng isMain
if isMain
brChk3 id 7 4 10 1
end
id = emitOne 3 dBrTri bBrTri isMain
if isMain
brChk3 id 3 4 5 1
end

for i ulong 6 bound 6
k = add i 3
if not isMain
id = brBeginU1Pfx pBrDivA k pBrDivB uw
brWrt cIfEqRem
brNum k
brWrt cEqRemTail
brEndFn
id = brBeginU1Pfx pBrCapA k sEmpty uw
brWrt cIfGtA
brNum k
brWrt cRet
brNum k
brWrt cEndRetA
brEndFn
id = brBeginU1Pfx pBrFlrA k sEmpty uw
brWrt cIfGtA
brNum k
brWrt cRetA
brWrt cEndRet
brNum k
brEndFn
else
r = ulong 0
if eq rem 12 k 0
r = 1
end
brChk1 brNextId 12 r
brChk1 brNextId 20 k
brChk1 brNextId 2 k
end
end
end

note ========================================================================
note FAMILY 3: BITS (real OM-2: and, or, xor, shl, shr!)
note ========================================================================
text dBtPop "the number of 1-bits in the argument"
text bBtPop "x = a\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c"
text dBtPar "the bit parity of the argument (1 if odd number of set bits, 0 if even)"
text bBtPar "x = a\np = ulong 0\nwhile gt x 0 bound 64\np = xor p and x 1\nx = shr x 1\nend\nret p"
text dBtPow2 "1 if the argument is a power of two, otherwise 0"
text bBtPow2 "if eq a 0\nret 0\nend\nif eq and a sub a 1 0\nret 1\nend\nret 0"
text dBtLen "the number of bits needed to represent the argument (0 for 0)"
text bBtLen "x = a\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c 1\nx = shr x 1\nend\nret c"
text dBtLog2 "the floor of log base 2 of the argument (0 when a is 0)"
text bBtLog2 "if le a 1\nret 0\nend\nx = a\nc = ulong 0\nwhile gt x 1 bound 64\nx = shr x 1\nc = add c 1\nend\nret c"
text dBtCtz "the number of trailing zero bits in the argument (64 when a is 0)"
text bBtCtz "if eq a 0\nret 64\nend\nx = a\nc = ulong 0\nwhile eq and x 1 0 bound 64\nx = shr x 1\nc = add c 1\nend\nret c"
text dBtClrLow "the argument with its lowest set bit cleared"
text bBtClrLow "if eq a 0\nret 0\nend\nret and a sub a 1"
text dBtIsoLow "the lowest set bit of the argument isolated (0 if a is 0)"
text bBtIsoLow "if eq a 0\nret 0\nend\nret sub a and a sub a 1"
text dBtHam "the Hamming distance between a and b"
text bBtHam "x = xor a b\nc = ulong 0\nwhile gt x 0 bound 64\nc = add c and x 1\nx = shr x 1\nend\nret c"
text dBtAnd "the bitwise AND of a and b"
text bBtAnd "ret and a b"
text dBtOr "the bitwise OR of a and b"
text bBtOr "ret or a b"
text dBtXor "the bitwise XOR of a and b"
text bBtXor "ret xor a b"
text dBtGetB "bit b of a (0 or 1)"
text bBtGetB "ret and shr a and b 63 1"
text dBtSetB "a with bit b set to 1"
text bBtSetB "ret or a shl 1 and b 63"
text dBtTogB "a with bit b toggled"
text bBtTogB "ret xor a shl 1 and b 63"
text dBtLowB "a with the lowest b bits kept and all higher bits cleared"
text bBtLowB "if ge b 64\nret a\nend\nret and a sub shl 1 b 1"

text pBtShlA "the argument shifted left by "
text pBtShrA "the argument shifted right by "
text pBtBits " bits"
text pBtMaskA "the low "
text pBtMaskB " bits of the argument"
text pBtBitA "bit "
text pBtBitB " of the argument (0 or 1)"
text cRetShlA "ret shl a "
text cRetShrA "ret shr a "
text cRetAndA "ret and a "
text cRetAndShr "ret and shr a "
text cSpc1 " 1"

fn brEmitBits isMain bool to void
uw = eq rem get brVar 0 2 1
id = emitOne 1 dBtPop bBtPop isMain
if isMain
brChk1 id 29 4
end
id = emitOne 1 dBtPar bBtPar isMain
if isMain
brChk1 id 7 1
end
id = emitOne 1 dBtLen bBtLen isMain
if isMain
brChk1 id 19 5
end
id = emitOne 1 dBtLog2 bBtLog2 isMain
if isMain
brChk1 id 19 4
end
id = emitOne 1 dBtCtz bBtCtz isMain
if isMain
brChk1 id 24 3
end
id = emitOne 1 dBtClrLow bBtClrLow isMain
if isMain
brChk1 id 12 8
end
id = emitOne 1 dBtIsoLow bBtIsoLow isMain
if isMain
brChk1 id 12 4
end
id = emitOne 2 dBtHam bBtHam isMain
if isMain
brChk2 id 10 15 2
end
id = emitOne 2 dBtAnd bBtAnd isMain
if isMain
brChk2 id 12 10 8
end
id = emitOne 2 dBtOr bBtOr isMain
if isMain
brChk2 id 12 10 14
end
id = emitOne 2 dBtXor bBtXor isMain
if isMain
brChk2 id 12 10 6
end
id = emitOne 2 dBtGetB bBtGetB isMain
if isMain
brChk2 id 10 3 1
end
id = emitOne 2 dBtSetB bBtSetB isMain
if isMain
brChk2 id 8 1 10
end
id = emitOne 2 dBtTogB bBtTogB isMain
if isMain
brChk2 id 10 1 8
end
id = emitOne 2 dBtLowB bBtLowB isMain
if isMain
brChk2 id 29 3 5
end

for i ulong 6 bound 6
k = add i 1
mask = sub shl 1 k 1
if not isMain
id = brBeginU1Pfx pBtShlA k pBtBits uw
brWrt cRetShlA
brNum k
brEndFn
id = brBeginU1Pfx pBtShrA k pBtBits uw
brWrt cRetShrA
brNum k
brEndFn
id = brBeginU1Pfx pBtMaskA k pBtMaskB uw
brWrt cRetAndA
brNum mask
brEndFn
id = brBeginU1Pfx pBtBitA k pBtBitB uw
brWrt cRetAndShr
brNum k
brWrt cSpc1
brEndFn
else
brChk1 brNextId 5 shl 5 k
brChk1 brNextId 96 shr 96 k
brChk1 brNextId 255 mask
brChk1 brNextId 255 1
end
end
end

note ========================================================================
note FAMILY 4 & 5: DIGITS + LOOP
note ========================================================================
text dDgSum "the sum of the decimal digits of the argument"
text bDgSum "x = a\ns = ulong 0\nwhile gt x 0 bound 24\ns = add s rem x 10\nx = div x 10\nend\nret s"
text dDgCnt "the number of decimal digits in the argument (1 for zero)"
text bDgCnt "if eq a 0\nret 1\nend\nx = a\nc = ulong 0\nwhile gt x 0 bound 24\nc = add c 1\nx = div x 10\nend\nret c"
text dDgMax "the largest decimal digit of the argument"
text bDgMax "x = a\nm = ulong 0\nwhile gt x 0 bound 24\nd = rem x 10\nif gt d m\nm = d\nend\nx = div x 10\nend\nret m"
text dDgMin "the smallest decimal digit of the argument (0 for zero)"
text bDgMin "if eq a 0\nret 0\nend\nx = a\nm = ulong 9\nwhile gt x 0 bound 24\nd = rem x 10\nif lt d m\nm = d\nend\nx = div x 10\nend\nret m"
text dDgRev "the decimal digits of the argument reversed"
text bDgRev "x = a\nr = ulong 0\nwhile gt x 0 bound 24\nr = add mul r 10 rem x 10\nx = div x 10\nend\nret r"
text dDgPal "1 if the argument is a decimal palindrome, otherwise 0"
text bDgPal "x = a\nr = ulong 0\nwhile gt x 0 bound 24\nr = add mul r 10 rem x 10\nx = div x 10\nend\nif eq r a\nret 1\nend\nret 0"
text dDgMsd "the most significant decimal digit of the argument"
text bDgMsd "x = a\nwhile ge x 10 bound 24\nx = div x 10\nend\nret x"
text dDgProd "the product of the decimal digits of a (0 when a is 0)"
text bDgProd "if eq a 0\nret 0\nend\nx = a\np = ulong 1\nwhile gt x 0 bound 24\np = mul p rem x 10\nx = div x 10\nend\nret p"
text dDgRoot "the digital root of a (repeated decimal digit sum until less than 10)"
text bDgRoot "if eq a 0\nret 0\nend\nr = rem a 9\nif eq r 0\nret 9\nend\nret r"
text dDgEvn "the count of even decimal digits in a (1 for zero)"
text bDgEvn "if eq a 0\nret 1\nend\nx = a\nc = ulong 0\nwhile gt x 0 bound 24\nif eq rem rem x 10 2 0\nc = add c 1\nend\nx = div x 10\nend\nret c"

text dLpFact "the factorial of a (1 for 0)"
text bLpFact "p = ulong 1\nfor i ulong a bound 20\np = mul p add i 1\nend\nret p"
text dLpFib "the a-th Fibonacci number with F(0)=0 and F(1)=1"
text bLpFib "if eq a 0\nret 0\nend\nx = ulong 0\ny = ulong 1\nfor i ulong sub a 1 bound 90\nt = add x y\nx = y\ny = t\nend\nret y"
text dLpGcd "the greatest common divisor of a and b"
text bLpGcd "x = a\ny = b\nwhile gt y 0 bound 128\nt = rem x y\nx = y\ny = t\nend\nret x"
text dLpIsqrt "the integer square root of a (floor of sqrt(a))"
text bLpIsqrt "r = ulong 0\nwhile le mul add r 1 add r 1 a bound 10000\nr = add r 1\nend\nret r"
text dLpPow "a raised to the power b"
text bLpPow "p = ulong 1\nfor i ulong b bound 64\np = mul p a\nend\nret p"
text dLpSumSq "the sum of squares 1^2 + 2^2 + ... + a^2"
text bLpSumSq "s = ulong 0\nfor i ulong a bound 1000\nk = add i 1\ns = add s mul k k\nend\nret s"
text dLpCollatz "the number of steps for a to reach 1 under the Collatz rule (0 if a <= 1)"
text bLpCollatz "if le a 1\nret 0\nend\nx = a\nc = ulong 0\nwhile gt x 1 bound 500\nif eq rem x 2 0\nx = div x 2\nelse\nx = add mul x 3 1\nend\nc = add c 1\nend\nret c"
text dLpDivCnt "the number of positive divisors of a (0 for 0)"
text bLpDivCnt "if eq a 0\nret 0\nend\nc = ulong 0\nfor i ulong a bound 1000\nd = add i 1\nif eq rem a d 0\nc = add c 1\nend\nend\nret c"
text dLpDivSum "the sum of all positive divisors of a (0 for 0)"
text bLpDivSum "if eq a 0\nret 0\nend\ns = ulong 0\nfor i ulong a bound 1000\nd = add i 1\nif eq rem a d 0\ns = add s d\nend\nend\nret s"
text dLpPrime "1 if a is prime, otherwise 0"
text bLpPrime "if lt a 2\nret 0\nend\nd = ulong 2\nwhile le mul d d a bound 1000\nif eq rem a d 0\nret 0\nend\nd = add d 1\nend\nret 1"
text dLpRngSum "the sum of integers from a to b inclusive (0 if a > b)"
text bLpRngSum "if gt a b\nret 0\nend\ns = ulong 0\nx = a\nwhile le x b bound 1000\ns = add s x\nx = add x 1\nend\nret s"

fn brEmitDigitsLoop isMain bool to void
id = emitOne 1 dDgSum bDgSum isMain
if isMain
brChk1 id 482 14
end
id = emitOne 1 dDgCnt bDgCnt isMain
if isMain
brChk1 id 482 3
end
id = emitOne 1 dDgMax bDgMax isMain
if isMain
brChk1 id 482 8
end
id = emitOne 1 dDgMin bDgMin isMain
if isMain
brChk1 id 482 2
end
id = emitOne 1 dDgRev bDgRev isMain
if isMain
brChk1 id 482 284
end
id = emitOne 1 dDgPal bDgPal isMain
if isMain
brChk1 id 12321 1
end
id = emitOne 1 dDgMsd bDgMsd isMain
if isMain
brChk1 id 7482 7
end
id = emitOne 1 dDgProd bDgProd isMain
if isMain
brChk1 id 234 24
end
id = emitOne 1 dDgRoot bDgRoot isMain
if isMain
brChk1 id 987 6
end
id = emitOne 1 dDgEvn bDgEvn isMain
if isMain
brChk1 id 2478 3
end

id = emitOne 1 dLpFact bLpFact isMain
if isMain
brChk1 id 5 120
end
id = emitOne 1 dLpFib bLpFib isMain
if isMain
brChk1 id 10 55
end
id = emitOne 2 dLpGcd bLpGcd isMain
if isMain
brChk2 id 48 18 6
end
id = emitOne 1 dLpIsqrt bLpIsqrt isMain
if isMain
brChk1 id 50 7
end
id = emitOne 2 dLpPow bLpPow isMain
if isMain
brChk2 id 3 4 81
end
id = emitOne 1 dLpSumSq bLpSumSq isMain
if isMain
brChk1 id 4 30
end
id = emitOne 1 dLpCollatz bLpCollatz isMain
if isMain
brChk1 id 6 8
end
id = emitOne 1 dLpDivCnt bLpDivCnt isMain
if isMain
brChk1 id 12 6
end
id = emitOne 1 dLpDivSum bLpDivSum isMain
if isMain
brChk1 id 12 28
end
id = emitOne 1 dLpPrime bLpPrime isMain
if isMain
brChk1 id 29 1
end
id = emitOne 2 dLpRngSum bLpRngSum isMain
if isMain
brChk2 id 3 7 25
end
end

note ========================================================================
note FAMILY 6, 7, 8, 9: FOLD, SELECT, COUNT, SCAN (arr = [3,11,0,7,19,4,2,15])
note ========================================================================
text dFdSum "the sum of the first n elements of array a"
text bFdSum "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nend\nret s"
text dFdXor "the bitwise XOR of the first n elements of a"
text bFdXor "x = ulong 0\nfor i ulong n bound 8\nx = xor x get a i\nend\nret x"
text dFdOr "the bitwise OR of the first n elements of a"
text bFdOr "x = ulong 0\nfor i ulong n bound 8\nx = or x get a i\nend\nret x"
text dFdSumSq "the sum of squares of the first n elements of a"
text bFdSumSq "s = ulong 0\nfor i ulong n bound 8\nv = get a i\ns = add s mul v v\nend\nret s"
text dFdEvn "the sum of even elements among the first n items of a"
text bFdEvn "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif eq rem v 2 0\ns = add s v\nend\nend\nret s"
text dFdOdd "the sum of odd elements among the first n items of a"
text bFdOdd "s = ulong 0\nfor i ulong n bound 8\nv = get a i\nif eq rem v 2 1\ns = add s v\nend\nend\nret s"
text dFdWgt "the weighted sum of i * a[i] over the first n items"
text bFdWgt "s = ulong 0\nfor i ulong n bound 8\ns = add s mul i get a i\nend\nret s"
text dFdAvg "the average of the first n elements rounded down (0 when n is 0)"
text bFdAvg "if eq n 0\nret 0\nend\ns = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nend\nret div s n"

text dSlMax "the largest element among the first n items of a (0 when n is 0)"
text bSlMax "if eq n 0\nret 0\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nend\nend\nret m"
text dSlMin "the smallest element among the first n items of a (0 when n is 0)"
text bSlMin "if eq n 0\nret 0\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v m\nm = v\nend\nend\nret m"
text dSlArgMax "the index of the largest element among the first n items (0 when n is 0)"
text bSlArgMax "if eq n 0\nret 0\nend\nbest = ulong 0\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nbest = i\nend\nend\nret best"
text dSlArgMin "the index of the smallest element among the first n items (0 when n is 0)"
text bSlArgMin "if eq n 0\nret 0\nend\nbest = ulong 0\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v m\nm = v\nbest = i\nend\nend\nret best"
text dSlSpan "the difference between the maximum and minimum of the first n items (0 when n is 0)"
text bSlSpan "if eq n 0\nret 0\nend\nlo = get a 0\nhi = get a 0\nfor i ulong n bound 8\nv = get a i\nif lt v lo\nlo = v\nend\nif gt v hi\nhi = v\nend\nend\nret sub hi lo"
text dSlSecMax "the second largest element among the first n items (0 when n < 2)"
text bSlSecMax "if lt n 2\nret 0\nend\nm1 = ulong 0\nm2 = ulong 0\nfor i ulong n bound 8\nv = get a i\nif gt v m1\nm2 = m1\nm1 = v\nelse\nif gt v m2\nm2 = v\nend\nend\nend\nret m2"

text dCtZero "the number of zero elements among the first n items of a"
text bCtZero "c = ulong 0\nfor i ulong n bound 8\nif eq get a i 0\nc = add c 1\nend\nend\nret c"
text dCtNz "the number of non-zero elements among the first n items of a"
text bCtNz "c = ulong 0\nfor i ulong n bound 8\nif ne get a i 0\nc = add c 1\nend\nend\nret c"
text dCtEvn "the number of even elements among the first n items of a"
text bCtEvn "c = ulong 0\nfor i ulong n bound 8\nif eq rem get a i 2 0\nc = add c 1\nend\nend\nret c"
text dCtOdd "the number of odd elements among the first n items of a"
text bCtOdd "c = ulong 0\nfor i ulong n bound 8\nif eq rem get a i 2 1\nc = add c 1\nend\nend\nret c"
text dCtInc "the number of adjacent pairs where a[i+1] > a[i] among the first n items"
text bCtInc "if lt n 2\nret 0\nend\nc = ulong 0\nfor i ulong sub n 1 bound 8\nif gt get a add i 1 get a i\nc = add c 1\nend\nend\nret c"

text dScFirstZ "the index of the first zero among the first n items, or n if none"
text bScFirstZ "for i ulong n bound 8\nif eq get a i 0\nret i\nend\nend\nret n"
text dScLastZ "the index of the last zero among the first n items, or n if none"
text bScLastZ "ans = n\nfor i ulong n bound 8\nif eq get a i 0\nans = i\nend\nend\nret ans"
text dScSorted "1 if the first n items are in non-decreasing order, otherwise 0"
text bScSorted "if lt n 2\nret 1\nend\nfor i ulong sub n 1 bound 8\nif gt get a i get a add i 1\nret 0\nend\nend\nret 1"
text dScAllEq "1 if all first n items are equal, otherwise 0"
text bScAllEq "if lt n 2\nret 1\nend\nv = get a 0\nfor i ulong n bound 8\nif ne get a i v\nret 0\nend\nend\nret 1"
text dScPal "1 if the first n items form a palindrome, otherwise 0"
text bScPal "for i ulong div n 2 bound 8\nif ne get a i get a sub sub n 1 i\nret 0\nend\nend\nret 1"
text dScRun "the length of the longest run of consecutive equal values in the first n items"
text bScRun "if eq n 0\nret 0\nend\nbest = ulong 1\ncur = ulong 1\nfor i ulong sub n 1 bound 8\nif eq get a add i 1 get a i\ncur = add cur 1\nif gt cur best\nbest = cur\nend\nelse\ncur = ulong 1\nend\nend\nret best"

fn brEmitArrayRead isMain bool to void
id = emitOne 4 dFdSum bFdSum isMain
if isMain
brChkAr id 61
end
id = emitOne 4 dFdXor bFdXor isMain
if isMain
brChkAr id 21
end
id = emitOne 4 dFdOr bFdOr isMain
if isMain
brChkAr id 31
end
id = emitOne 4 dFdSumSq bFdSumSq isMain
if isMain
brChkAr id 785
end
id = emitOne 4 dFdEvn bFdEvn isMain
if isMain
brChkAr id 6
end
id = emitOne 4 dFdOdd bFdOdd isMain
if isMain
brChkAr id 55
end
id = emitOne 4 dFdWgt bFdWgt isMain
if isMain
brChkAr id 245
end
id = emitOne 4 dFdAvg bFdAvg isMain
if isMain
brChkAr id 7
end

id = emitOne 4 dSlMax bSlMax isMain
if isMain
brChkAr id 19
end
id = emitOne 4 dSlMin bSlMin isMain
if isMain
brChkAr id 0
end
id = emitOne 4 dSlArgMax bSlArgMax isMain
if isMain
brChkAr id 4
end
id = emitOne 4 dSlArgMin bSlArgMin isMain
if isMain
brChkAr id 2
end
id = emitOne 4 dSlSpan bSlSpan isMain
if isMain
brChkAr id 19
end
id = emitOne 4 dSlSecMax bSlSecMax isMain
if isMain
brChkAr id 15
end

id = emitOne 4 dCtZero bCtZero isMain
if isMain
brChkAr id 1
end
id = emitOne 4 dCtNz bCtNz isMain
if isMain
brChkAr id 7
end
id = emitOne 4 dCtEvn bCtEvn isMain
if isMain
brChkAr id 3
end
id = emitOne 4 dCtOdd bCtOdd isMain
if isMain
brChkAr id 5
end
id = emitOne 4 dCtInc bCtInc isMain
if isMain
brChkAr id 4
end

id = emitOne 4 dScFirstZ bScFirstZ isMain
if isMain
brChkAr id 2
end
id = emitOne 4 dScLastZ bScLastZ isMain
if isMain
brChkAr id 2
end
id = emitOne 4 dScSorted bScSorted isMain
if isMain
brChkAr id 0
end
id = emitOne 4 dScAllEq bScAllEq isMain
if isMain
brChkAr id 0
end
id = emitOne 4 dScPal bScPal isMain
if isMain
brChkAr id 0
end
id = emitOne 4 dScRun bScRun isMain
if isMain
brChkAr id 1
end
end

note ========================================================================
note FAMILY 10: REWRITE (in-place edit ulong 8; arr=[3,11,0,7,19,4,2,15])
note ========================================================================
text dRwDbl "double each of the first n elements in place"
text bRwDbl "for i ulong n bound 8\nput a i mul get a i 2\nend"
text dRwSq "square each of the first n elements in place"
text bRwSq "for i ulong n bound 8\nv = get a i\nput a i mul v v\nend"
text dRwMod2 "replace each of the first n elements with its remainder mod 2"
text bRwMod2 "for i ulong n bound 8\nput a i rem get a i 2\nend"
text dRwZOd "set all odd elements among the first n items to zero"
text bRwZOd "for i ulong n bound 8\nif eq rem get a i 2 1\nput a i 0\nend\nend"
text dRwZEv "set all even elements among the first n items to zero"
text bRwZEv "for i ulong n bound 8\nif eq rem get a i 2 0\nput a i 0\nend\nend"
text dRwRev "reverse the first n elements of a in place"
text bRwRev "for i ulong div n 2 bound 8\nj = sub sub n 1 i\nt = get a i\nput a i get a j\nput a j t\nend"
text dRwPfx "replace each element of the first n items with its running prefix sum"
text bRwPfx "s = ulong 0\nfor i ulong n bound 8\ns = add s get a i\nput a i s\nend"
text dRwPfxMax "replace each element of the first n items with its running prefix maximum"
text bRwPfxMax "if eq n 0\nret\nend\nm = get a 0\nfor i ulong n bound 8\nv = get a i\nif gt v m\nm = v\nend\nput a i m\nend"
text dRwSwapEnd "swap the first and last of the first n elements if n >= 2"
text bRwSwapEnd "if lt n 2\nret\nend\nt = get a 0\nput a 0 get a sub n 1\nput a sub n 1 t"
text dRwRotL "rotate the first n elements left by one position"
text bRwRotL "if lt n 2\nret\nend\nf = get a 0\nfor i ulong sub n 1 bound 8\nput a i get a add i 1\nend\nput a sub n 1 f"
text dRwRotR "rotate the first n elements right by one position"
text bRwRotR "if lt n 2\nret\nend\nlast = get a sub n 1\ni = sub n 1\nwhile gt i 0 bound 8\nput a i get a sub i 1\ni = sub i 1\nend\nput a 0 last"
text dRwIdx "fill the first n elements with their indices 0..n-1"
text bRwIdx "for i ulong n bound 8\nput a i i\nend"
text dRwSort "bubble-sort the first n elements in non-decreasing order"
text bRwSort "if lt n 2\nret\nend\nfor p ulong n bound 8\nfor i ulong sub n 1 bound 8\nx = get a i\ny = get a add i 1\nif gt x y\nput a i y\nput a add i 1 x\nend\nend\nend"

fn brEmitRewrite isMain bool to void
id = emitOne 5 dRwDbl bRwDbl isMain
if isMain
brChkAw id 50
end
id = emitOne 5 dRwSq bRwSq isMain
if isMain
brChkAw id 283
end
id = emitOne 5 dRwMod2 bRwMod2 isMain
if isMain
brChkAw id 3
end
id = emitOne 5 dRwZOd bRwZOd isMain
if isMain
brChkAw id 0
end
id = emitOne 5 dRwZEv bRwZEv isMain
if isMain
brChkAw id 25
end
id = emitOne 5 dRwRev bRwRev isMain
if isMain
brChkAw id 37
end
id = emitOne 5 dRwPfx bRwPfx isMain
if isMain
brChkAw id 85
end
id = emitOne 5 dRwPfxMax bRwPfxMax isMain
if isMain
brChkAw id 33
end
id = emitOne 5 dRwRotL bRwRotL isMain
if isMain
brChkAw id 33
end
id = emitOne 5 dRwIdx bRwIdx isMain
if isMain
brChkAw id 10
end
id = emitOne 5 dRwSort bRwSort isMain
if isMain
brChkAw id 23
end
end

fn brEqArg a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 32
if ne get a i get b i
ret false
end
end
ret true
end

fn main to int
ab = new uchar 32 0
vb = new uchar 16 0
mode = ulong 0
varn = ulong 1
if ge argcnt 2
lr = argread 1 ab 0 32
if gt lr 0
if brEqArg ab ulong lr brArgOracle
mode = 1
end
end
end
if ge argcnt 3
vr = argread 2 vb 0 16
if gt vr 0
ch = ulong get vb 0
if and ge ch 49 le ch 57
varn = sub ch 48
end
end
end
put brMode 0 mode
put brVar 0 varn
if eq mode 1
brWrt brOm2
put brId 0 0
brEmitArith false
brEmitBranch false
brEmitBits false
brEmitDigitsLoop false
brEmitArrayRead false
brEmitRewrite false
brWrt brMainH
put brId 0 0
brEmitArith true
brEmitBranch true
brEmitBits true
brEmitDigitsLoop true
brEmitArrayRead true
brEmitRewrite true
brWrt brMainT
ret 0
end
put brId 0 0
brEmitArith false
brEmitBranch false
brEmitBits false
brEmitDigitsLoop false
brEmitArrayRead false
brEmitRewrite false
ret 0
end

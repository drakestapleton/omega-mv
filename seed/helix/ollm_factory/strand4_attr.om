om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/strand4_attr.om:
note Pure seeded OM-2 4-Strand Fault Attribution Engine, Dual-View NUL-Delimited
note Trace Extractor, Minimum Batch-Floor Guard, Four-Wall RSI + BFT Quorum Promotion
note Gate, and Post-Cycle Scaling Decision Rule (Sections 4, 5, and 6).

global saInBuf uchar 65536
global saOutBuf uchar 131072
global saLine uchar 1024
global saTok uchar 128
global saTaskId uchar 128
global saFam uchar 128
global saPathA uchar 256
global saPathB uchar 256
global saComp ulong 4
global saPass ulong 4
global saHash ulong 4
global saErr ulong 4
global saOutPos ulong 1
global saStats ulong 8
global saPArg ulong 16
global saTmpA uchar 16384
global saTmpB uchar 16384
global saTmpC uchar 16384

text saModeAttr "attribute"
text saModeExtr "extract"
text saModeProm "promote"
text saModeDec  "decide"
text saModeSelf "selfcheck"

text saClsUnan  "UNANIMOUS_PASS"
text saClsGap   "BUILDER_STRAND_GAP"
text saClsSyn   "OM2_SYNTAX_GAP"
text saClsLogic "ARCHITECT_LOGIC_FLAW"
text saClsUnder "UNDERSPECIFIED_PLAN"
text saClsMixed "MIXED_COMPILE_FAIL"

text saActGold  "HARVEST_GOLD_DUAL_VIEW"
text saActGap   "HARVEST_GOLD_AND_ROUTE_S4_REPAIR"
text saActSyn   "ROUTE_BEST_ERR_TO_S4_REPAIR"
text saActLogic "FLAG_DEFECTIVE_PLAN_REQUEUE_Q36"
text saActUnder "REQUEUE_Q36_STRICT_DECOMPOSE"
text saActMixed "ROUTE_FAIL_TO_S4_REPAIR"

text saHdrAttr  "task_id\tfamily\tfault_class\taction\twinning_strand\tfailing_mask\tbest_err\n"
text saNotePfx  "note "
text saPlanPfx  "note ARCH_PLAN: "
text saNl "\n"

text saSumA "STRAND4_ATTR SUMMARY tasks="
text saSumB " unanimous="
text saSumC " builder_gap="
text saSumD " syntax_gap="
text saSumE " arch_logic="
text saSumF " underspec="
text saSumG " mixed="

text saPrProm  "FOUR_WALL_BFT strand="
text saPrVerP  " verdict=PROMOTE\n"
text saPrVerFl " verdict=SKIP_BELOW_BATCH_FLOOR\n"
text saPrVerW1 " verdict=WALL1_INTEGRITY_REJECT\n"
text saPrVerW2 " verdict=REJECT_OVERFIT_KEEP_P1\n"
text saPrVerW3 " verdict=WALL3_LEAKAGE_REJECT\n"
text saPrVerW4 " verdict=WALL4_QUARANTINE_STRAND\n"

text saDecCont "SCALING_RULE DECISION=CONTINUE_SCALING_STRANDS\n"
text saDecWide "SCALING_RULE DECISION=WIDEN_LOOPED_CORE\n"

text saExtrOk  "DUAL_VIEW_EXTRACT PASS direct_bytes="
text saExtrOk2 " align_bytes="

text saSelfOk  "STRAND4_ATTR SELFCHECK PASS fault_matrix=6/6 dual_view_nul=1 batch_floor=1 four_wall_bft=6/6 scaling_rule=2/2\n"
text saUsage   "usage: strand4_attr <attribute in out | extract orig plan code direct align | promote ... | decide ... | selfcheck>\n"

fn saWrt1 s view uchar * to void
r = write 1 s 0 len s
end

fn saWrt2 s view uchar * to void
r = write 2 s 0 len s
end

fn saNum1 v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn saEqBuf a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 256
if ne get a i get b i
ret false
end
end
ret true
end

fn saParseUlong a view uchar * al ulong to ulong
v = ulong 0
for i ulong al bound 32
c = get a i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end

fn saParseTok al ulong to ulong
v = ulong 0
for i ulong al bound 32
c = get saTok i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end

fn saArgUlong idx ulong to ulong
b = new uchar 32 0
if le ulong argcnt idx
ret 0
end
lr = argread idx b 0 32
if le lr 0
ret 0
end
ret saParseUlong b ulong lr
end

fn saOutReset to void
put saOutPos 0 0
end

fn saOutByte c uchar to void
p = get saOutPos 0
if lt p 131070
put saOutBuf p c
put saOutPos 0 add p 1
end
end

fn saOutStr s view uchar * to void
for i ulong len s bound 512
saOutByte get s i
end
end

fn saOutFld which ulong n ulong to void
if eq which 0
for i ulong n bound 128
saOutByte get saTaskId i
end
ret
end
for i ulong n bound 128
saOutByte get saFam i
end
end

fn saOutNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
while lt p 24 bound 24
saOutByte get b p
p = add p 1
end
end

fn saReadInFile plen ulong to ulong
fd = fopen saPathA 0 plen 0 0
if lt fd 0
ret 0
end
tot = ulong 0
while lt tot 65536 bound 256
r = read int fd saInBuf tot sub 65536 tot
if le r 0
break
end
tot = add tot ulong r
end
z = fclose int fd
ret tot
end

fn saReadTmpFile which ulong plen ulong to ulong
fd = fopen saPathA 0 plen 0 0
if lt fd 0
ret 0
end
tot = ulong 0
while lt tot 16384 bound 256
r = long 0
if eq which 0
r = read int fd saTmpA tot sub 16384 tot
else
if eq which 1
r = read int fd saTmpB tot sub 16384 tot
else
r = read int fd saTmpC tot sub 16384 tot
end
end
if le r 0
break
end
tot = add tot ulong r
end
z = fclose int fd
ret tot
end

fn saWriteOutFile plen ulong to bool
fd = fopen saPathB 0 plen 577 420
if lt fd 0
ret false
end
n = get saOutPos 0
off = ulong 0
while lt off n bound 256
w = write int fd saOutBuf off sub n off
if le w 0
z = fclose int fd
ret false
end
off = add off ulong w
end
z = fclose int fd
ret true
end

fn saClassify4 to ulong
ccnt = ulong 0
pcnt = ulong 0
for s ulong 4
if ne get saComp s 0
ccnt = add ccnt 1
end
if ne get saPass s 0
pcnt = add pcnt 1
end
end
if eq pcnt 4
ret 0
end
if gt pcnt 0
ret 1
end
if eq ccnt 0
ret 2
end
if eq ccnt 4
h0 = get saHash 0
same = true
for s ulong 3
if ne get saHash add s 1 h0
same = false
end
end
if same
ret 3
end
ret 4
end
ret 5
end

fn saWinStrand to ulong
for s ulong 4
if ne get saPass s 0
ret add s 1
end
end
ret 0
end

fn saFailMask to ulong
m = ulong 0
for s ulong 4
if eq get saPass s 0
m = or m shl ulong 1 s
end
end
ret m
end

fn saBestErr to ulong
for s ulong 4
e = get saErr s
if ne e 0
ret e
end
end
ret 0
end

fn saSplitTabTo llen ulong k ulong which ulong to ulong
cur = ulong 0
p = ulong 0
for i ulong llen bound 1024
c = get saLine i
if eq c 9
cur = add cur 1
if gt cur k
break
end
else
if eq cur k
if lt p 128
if eq which 0
put saTaskId p c
else
if eq which 1
put saFam p c
else
put saTok p c
end
end
p = add p 1
end
end
end
end
ret p
end

fn saOutClass cls ulong to void
if eq cls 0
saOutStr saClsUnan
saOutByte 9
saOutStr saActGold
ret
end
if eq cls 1
saOutStr saClsGap
saOutByte 9
saOutStr saActGap
ret
end
if eq cls 2
saOutStr saClsSyn
saOutByte 9
saOutStr saActSyn
ret
end
if eq cls 3
saOutStr saClsLogic
saOutByte 9
saOutStr saActLogic
ret
end
if eq cls 4
saOutStr saClsUnder
saOutByte 9
saOutStr saActUnder
ret
end
saOutStr saClsMixed
saOutByte 9
saOutStr saActMixed
end

fn saRunAttribute inLen ulong outLen ulong to int
nbytes = saReadInFile inLen
if eq nbytes 0
ret 2
end
for i ulong 8
put saStats i 0
end
saOutReset
saOutStr saHdrAttr
pos = ulong 0
while lt pos nbytes bound 2048
llen = ulong 0
while lt pos nbytes bound 1024
c = get saInBuf pos
pos = add pos 1
if eq c 10
break
end
if and ne c 13 lt llen 1020
put saLine llen c
llen = add llen 1
end
end
if eq llen 0
continue
end
if eq get saLine 0 35
continue
end
tidLen = saSplitTabTo llen 0 0
famLen = saSplitTabTo llen 1 1
if or eq tidLen 0 eq famLen 0
continue
end
t2l = saSplitTabTo llen 2 2
if eq t2l 0
continue
end
c0 = get saTok 0
if or lt c0 48 gt c0 57
continue
end
for s ulong 4
base = add 2 mul s 4
tl = saSplitTabTo llen base 2
put saComp s saParseTok tl
tl = saSplitTabTo llen add base 1 2
put saPass s saParseTok tl
tl = saSplitTabTo llen add base 2 2
put saHash s saParseTok tl
tl = saSplitTabTo llen add base 3 2
put saErr s saParseTok tl
end
cls = saClassify4
put saStats 7 add get saStats 7 1
put saStats cls add get saStats cls 1
saOutFld 0 tidLen
saOutByte 9
saOutFld 1 famLen
saOutByte 9
saOutClass cls
saOutByte 9
saOutNum saWinStrand
saOutByte 9
saOutNum saFailMask
saOutByte 9
saOutNum saBestErr
saOutByte 10
end
if not saWriteOutFile outLen
ret 3
end
saWrt1 saSumA
saNum1 get saStats 7
saWrt1 saSumB
saNum1 get saStats 0
saWrt1 saSumC
saNum1 get saStats 1
saWrt1 saSumD
saNum1 get saStats 2
saWrt1 saSumE
saNum1 get saStats 3
saWrt1 saSumF
saNum1 get saStats 4
saWrt1 saSumG
saNum1 get saStats 5
saWrt1 saNl
ret 0
end

fn saRunExtract to int
if lt argcnt 7
ret 2
end
l1 = argread 2 saPathA 0 256
if le l1 0
ret 2
end
nOrig = saReadTmpFile 0 ulong l1
l2 = argread 3 saPathA 0 256
if le l2 0
ret 2
end
nPlan = saReadTmpFile 1 ulong l2
l3 = argread 4 saPathA 0 256
if le l3 0
ret 2
end
nCode = saReadTmpFile 2 ulong l3
if or eq nOrig 0 or eq nPlan 0 eq nCode 0
ret 3
end
l4 = argread 5 saPathB 0 256
if le l4 0
ret 2
end
saOutReset
saOutStr saNotePfx
for i ulong nOrig bound 16384
c = get saTmpA i
if and ne c 10 ne c 13
saOutByte c
end
end
saOutByte 10
for i ulong nCode bound 16384
saOutByte get saTmpC i
end
if ne get saTmpC sub nCode 1 10
saOutByte 10
end
saOutByte 0
dirBytes = get saOutPos 0
if not saWriteOutFile ulong l4
ret 4
end
l5 = argread 6 saPathB 0 256
if le l5 0
ret 2
end
saOutReset
saOutStr saPlanPfx
for i ulong nPlan bound 16384
c = get saTmpB i
if and ne c 10 ne c 13
saOutByte c
end
end
saOutByte 10
for i ulong nCode bound 16384
saOutByte get saTmpC i
end
if ne get saTmpC sub nCode 1 10
saOutByte 10
end
saOutByte 0
alnBytes = get saOutPos 0
if not saWriteOutFile ulong l5
ret 5
end
saWrt1 saExtrOk
saNum1 dirBytes
saWrt1 saExtrOk2
saNum1 alnBytes
saWrt1 saNl
ret 0
end

fn saEvalPromote traces ulong minFl ulong w1Ok ulong t60 ulong t61 ulong t62 ulong to ulong
if lt traces minFl
ret 10
end
if or eq w1Ok 0 or ne t60 60 or ne t61 61 ne t62 62
ret 11
end
ret 0
end

fn saEvalWalls234 baseH ulong candH ulong maxDr ulong seenD ulong baseP ulong candP ulong to ulong
if gt candH add baseH maxDr
ret 12
end
if ne seenD 0
ret 13
end
if lt candP baseP
ret 14
end
ret 0
end

fn saRunPromote to int
if lt argcnt 17
ret 2
end
for i ulong 15
put saPArg i saArgUlong add i 2
end
rc = saEvalPromote get saPArg 1 get saPArg 2 get saPArg 3 get saPArg 4 get saPArg 5 get saPArg 6
if eq rc 0
rc = saEvalWalls234 get saPArg 7 get saPArg 8 get saPArg 9 get saPArg 10 get saPArg 11 get saPArg 12
end
if and eq rc 0 or ne get saPArg 13 0 ne get saPArg 14 0
rc = 14
end
saWrt1 saPrProm
saNum1 get saPArg 0
if eq rc 0
saWrt1 saPrVerP
ret 0
end
if eq rc 10
saWrt1 saPrVerFl
ret 10
end
if eq rc 11
saWrt1 saPrVerW1
ret 11
end
if eq rc 12
saWrt1 saPrVerW2
ret 12
end
if eq rc 13
saWrt1 saPrVerW3
ret 13
end
saWrt1 saPrVerW4
ret 14
end

fn saEvalScaling c1P ulong c2P ulong baseP ulong c2H ulong baseH ulong k32FailPct ulong to ulong
if le c2P baseP
if or ge k32FailPct 80 gt c2H add baseH 150
ret 1
end
end
if and le c2P c1P gt c2H add baseH 150
ret 1
end
ret 0
end

fn saRunDecide to int
if lt argcnt 8
ret 2
end
c1P = saArgUlong 2
c2P = saArgUlong 3
baseP = saArgUlong 4
c2H = saArgUlong 5
baseH = saArgUlong 6
k32F = saArgUlong 7
d = saEvalScaling c1P c2P baseP c2H baseH k32F
if eq d 0
saWrt1 saDecCont
ret 0
end
saWrt1 saDecWide
ret 1
end

fn saSetStrand s ulong c ulong p ulong h ulong e ulong to void
put saComp s c
put saPass s p
put saHash s h
put saErr s e
end

fn saSelfCheck to int
for s ulong 4
saSetStrand s 1 1 777 0
end
if ne saClassify4 0
ret 20
end
saSetStrand 0 1 1 777 0
saSetStrand 1 1 0 111 0
saSetStrand 2 0 0 0 7
saSetStrand 3 1 1 777 0
if ne saClassify4 1
ret 21
end
if ne saWinStrand 1
ret 22
end
if ne saFailMask 6
ret 23
end
saSetStrand 0 0 0 0 7
saSetStrand 1 0 0 0 16
saSetStrand 2 0 0 0 12
saSetStrand 3 0 0 0 7
if ne saClassify4 2
ret 24
end
if ne saBestErr 7
ret 25
end
for s ulong 4
saSetStrand s 1 0 99999 0
end
if ne saClassify4 3
ret 26
end
saSetStrand 0 1 0 1001 0
saSetStrand 1 1 0 2002 0
saSetStrand 2 1 0 3003 0
saSetStrand 3 1 0 4004 0
if ne saClassify4 4
ret 27
end
saSetStrand 0 1 0 1001 0
saSetStrand 1 0 0 0 16
saSetStrand 2 1 0 2002 0
saSetStrand 3 0 0 0 7
if ne saClassify4 5
ret 28
end
if ne saEvalPromote 16 64 1 60 61 62 10
ret 29
end
if ne saEvalPromote 80 64 1 60 61 0 11
ret 30
end
if ne saEvalPromote 80 64 1 60 61 62 0
ret 31
end
if ne saEvalWalls234 3061 3206 150 0 6 8 0
ret 32
end
if ne saEvalWalls234 3206 4829 150 0 6 6 12
ret 33
end
if ne saEvalWalls234 3061 3128 150 1 6 9 13
ret 34
end
if ne saEvalWalls234 3061 3128 150 0 6 5 14
ret 35
end
if ne saEvalScaling 9 14 6 3140 3128 35 0
ret 36
end
if ne saEvalScaling 6 6 6 3310 3128 85 1
ret 37
end
saWrt1 saSelfOk
ret 0
end

fn main to int
a1 = new uchar 64 0
if lt argcnt 2
saWrt2 saUsage
ret 2
end
l1r = argread 1 a1 0 64
if le l1r 0
ret 2
end
l1 = ulong l1r
if saEqBuf a1 l1 saModeSelf
ret saSelfCheck
end
if saEqBuf a1 l1 saModeAttr
if lt argcnt 4
saWrt2 saUsage
ret 2
end
l2r = argread 2 saPathA 0 256
l3r = argread 3 saPathB 0 256
if or le l2r 0 le l3r 0
ret 2
end
ret saRunAttribute ulong l2r ulong l3r
end
if saEqBuf a1 l1 saModeExtr
ret saRunExtract
end
if saEqBuf a1 l1 saModeProm
ret saRunPromote
end
if saEqBuf a1 l1 saModeDec
ret saRunDecide
end
saWrt2 saUsage
ret 2
end

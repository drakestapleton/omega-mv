fn fmPass1 to ulong
ar = get fmSt 3
if eq ar 1
ret clsShape1
end
if eq ar 2
ret clsShape2
end
if eq ar 3
ret clsShape3
end
if eq ar 4
ret clsShape4
end
if eq ar 5
ret clsShape5
end
ret 0
end

note ======== Evaluators for Pass 1 & Pass 2 dual-pass verification ========
note OM-2 evaluates both operands of and. Branch before taking a remainder.
fn fmMultiple value ulong divisor ulong to bool
if eq divisor 0
ret false
end
ret eq rem value divisor 0
end

fn evalU1 cid ulong a ulong to ulong
c0 = get fmNums 0
c1 = get fmNums 1
c2 = get fmNums 2
if eq cid 101
if eq c0 0
ret 0
end
ret sub a rem a c0
end
if eq cid 102
if eq c0 0
ret 0
end
r = rem a c0
if eq r 0
ret a
end
ret add a sub c0 r
end
if eq cid 103
if lt a c0
ret sub c0 a
end
ret sub a c0
end
if eq cid 104
if eq rem a 2 0
ret div a 2
end
ret add mul 3 a 1
end
if eq cid 105
if lt a c1
ret 0
end
if lt a c2
ret 1
end
if lt a get fmNums 4
ret 2
end
ret 3
end
if eq cid 106
if eq a 0
ret 0
end
ret and a sub a 1
end
if eq cid 107
if fmMultiple a c1
ret 1
end
if fmMultiple a c2
ret 1
end
ret 0
end
if eq cid 108
ret add mul a a c0
end
if eq cid 109
ret mul mul a a a
end
if eq cid 110
c = ulong 0
x = a
while gt x 0 bound 64
c = add c and x 1
x = shr x 1
end
ret c
end

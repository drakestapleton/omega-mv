om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/ollm_factory/om_formalize.om:
note Zero-Leakage English-Only Dual-Pass Formalizer (Pure Seeded OM-2).
note Reads ONLY a prompt file (`note <English>\nfn solve <PARAMS>\n`) — NEVER
note touches expect.txt or tasks.om. Translates general English algorithmic
note specifications into formal I/O specs for `om_synth.om`, gated by strict
note dual-pass agreement (Pass 1 semantic evaluator == Pass 2 independent verifier
note on all test cases; abstains cleanly on any ambiguity or mismatch).
note
note Usage:
note   om_formalize formalize PROMPT_FILE OUT_SPEC
note   om_formalize selfcheck

global fmBuf uchar 16384
global fmOut uchar 16384
global fmPath uchar 4096
global fmNums ulong 16
global fmInA ulong 8
global fmInB ulong 8
global fmInC ulong 8
global fmP1 ulong 8
global fmP2 ulong 8
global fmSt ulong 32

text mForm "formalize"
text mSelf "selfcheck"
text tUsage "usage: om_formalize formalize PROMPT_FILE OUT_SPEC | selfcheck\n"
text tErrIo "om_formalize: I/O error\n"
text tAgree "FORMALIZE_AGREE concept="
text tAbstain "FORMALIZE_ABSTAIN\n"
text tSelfOk "OM_FORMALIZE SELFCHECK PASS agree=4/4 abstain=1/1 zero_expect_access=1\n"
text tSelfFail "OM_FORMALIZE SELFCHECK FAIL step="
text tNl "\n"

text kwEdit "edit"
text kwView "view"
text kwVoid "void"
text kwB " b ulong"
text kwC " c ulong"

note Disqualifying complex-domain keywords (forces fail-closed abstain unless explicitly handled)
text dqDigit "digit"
text dqPrime "prime"
text dqFib "fibonacci"
text dqGcd "gcd"
text dqRev "revers"
text dqPop "one bit"
text dqFact "factorial"
text dqSqrt "square root"
text dqTrail "trailing"
text dqLead "leading"
text dqPal "palindrom"
text dqCollatz "halved"

note General English concept keywords
text kSquare "square"
text kCube "cube"
text kDist "distance"
text kRound "rounded"
text kDown "down"
text kUp "up"
text kMult "multiple"
text kEven "even"
text kOdd "odd"
text kHalf "half"
text kThree "three times"
text kPlus "plus"
text kBelow "below"
text kLowest "lowest"
text kClear "cleared"
text kLarg "larger"
text kMax "maximum"
text kGreat "greater"
text kBig "largest"
text kSmall "smaller"
text kMin "minimum"
text kLeast "smallest"
text kSum "sum"
text kProd "product"
text kXor "xor"
text kBitOr "bitwise or"
text kOr " or "
text kBitAnd "bitwise and"
text kNonZero "non-zero"
text kNonZero2 "nonzero"
text kHowMany "how many"
text kCount "count"
text kAvg "average"
text kDiff "difference"
text kAbs "absolute"
text kClamp "clamp"
text kMed "median"
text kDivBy "divisible"
text kRem "remainder"
text kQuot "quotient"

text oArity "arity "
text oDepth "depth "
text oConsts "consts "
text oCase "case "
text oFold "fold "
text tFoldCases "arity 4\nfold 4 3 7 2 9 "
text tFoldC2 "\nfold 3 10 5 20 "
text tFoldC3 "\nfold 5 1 2 3 4 5 "

text tTestP1 "note return the argument rounded down to a multiple of 14\nfn solve a ulong to ulong\n"
text tTestP2 "note return the larger of the two arguments\nfn solve a ulong b ulong to ulong\n"
text tTestP3 "note return the distance between the two arguments\nfn solve a ulong b ulong to ulong\n"
text tTestP4 "note return the sum of the array elements\nfn solve a view ulong 8 n ulong to ulong\n"
text tTestP5 "note return the nth fibonacci number\nfn solve a ulong to ulong\n"

fn fwStr fd int s view uchar * to void
r = write fd s 0 len s
end

fn fwNum fd int v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd b p sub 24 p
end

fn feqTxt a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn fLower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn fHas boff ulong blen ulong s view uchar * to bool
sl = len s
if or eq sl 0 gt sl blen
ret false
end
lim = add sub blen sl 1
for i ulong lim bound 4096
ok = true
for j ulong sl bound 64
if ne fLower ulong get fmBuf add boff add i j ulong get s j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

note Output buffer writers
fn foClr to void
put fmSt 10 0
end

fn foCh c ulong to void
p = get fmSt 10
if lt p 16383
put fmOut p uchar c
put fmSt 10 add p 1
end
end

fn foTxt s view uchar * to void
for i ulong len s bound 4096
foCh ulong get s i
end
end

fn foNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
while lt p 24 bound 24
foCh ulong get b p
p = add p 1
end
end

fn fmExtractNums l1e ulong to void
nc = ulong 0
i = ulong 0
while lt i l1e bound 4096
c = get fmBuf i
if and ge c 48 le c 57
v = ulong 0
while lt i l1e bound 4096
c2 = get fmBuf i
if not and ge c2 48 le c2 57
break
end
v = add mul v 10 ulong sub c2 48
i = add i 1
end
if lt nc 16
put fmNums nc v
nc = add nc 1
end
else
i = add i 1
end
end
put fmSt 4 nc
end

note Parse prompt header: line1=note, line2=fn solve, extract arity & embedded numbers
note fmSt: 0=l1End, 1=l2Start, 2=l2End, 3=arity (1..5), 4=nNums
fn fmParsePrompt blen ulong to void
l1e = ulong 0
while lt l1e blen bound 16384
if eq get fmBuf l1e 10
break
end
l1e = add l1e 1
end
l2s = l1e
if lt l2s blen
l2s = add l2s 1
end
l2e = l2s
while lt l2e blen bound 16384
if eq get fmBuf l2e 10
break
end
l2e = add l2e 1
end
put fmSt 0 l1e
put fmSt 1 l2s
put fmSt 2 l2e

ar = ulong 1
l2n = sub l2e l2s
if fHas l2s l2n kwEdit
ar = 5
else
if fHas l2s l2n kwView
ar = 4
else
if fHas l2s l2n kwC
ar = 3
else
if fHas l2s l2n kwB
ar = 2
else
if fHas l2s l2n kwVoid
ar = 5
end
end
end
end
end
put fmSt 3 ar
fmExtractNums l1e
end

note Check if line 1 contains complex disqualifying keywords (not handled by simple algebraic concepts)
fn fmHasDisqual l1e ulong to bool
if or fHas 0 l1e dqDigit or fHas 0 l1e dqPrime or fHas 0 l1e dqFib fHas 0 l1e dqGcd
ret true
end
if or fHas 0 l1e dqRev or fHas 0 l1e dqFact or fHas 0 l1e dqSqrt fHas 0 l1e dqTrail
ret true
end
if or fHas 0 l1e dqLead or fHas 0 l1e dqPal fHas 0 l1e dqCollatz
ret true
end
ret false
end

note Pass 1: Classify English note line into general concept ID (0 = abstain)
note Concepts:
note   101: unary floor to multiple of c0
note   102: unary ceil to multiple of c0
note   103: unary distance to c0 (|a - c0|)
note   104: unary Collatz step (half when even, else 3*a+1)
note   105: unary 4-way threshold (<c0 -> 0, <c1 -> 1, <c2 -> 2, else 3)
note   106: unary clear lowest set bit (a & (a-1))
note   107: unary multiple of c0 or c1 -> 1 else 0
note   108: unary square plus c0 (a*a + c0)
note   109: unary cube (a*a*a)
note   201: binary max(a, b)
note   202: binary min(a, b)
note   203: binary |a - b|
note   204: binary (a - b)^2
note   205: binary a^2 + b^2
note   206: binary average (a + b) / 2
note   207: binary a xor b
note   208: binary a + b
note   209: binary a * b
note   401..410: fold skeletons (sum=401, prod=402, max=403, min=404, xor=405, or=406, even=407, odd=408, nz=409, sumsq=410)
fn fmPass1 to ulong
l1e = get fmSt 0
ar = get fmSt 3
nn = get fmSt 4
if fmHasDisqual l1e
ret 0
end
if eq ar 1
if and fHas 0 l1e kLowest fHas 0 l1e kClear
ret 106
end
if and fHas 0 l1e kHalf and fHas 0 l1e kEven fHas 0 l1e kThree
ret 104
end
if and ge nn 3 fHas 0 l1e kBelow
ret 105
end
if and ge nn 2 and fHas 0 l1e kMult fHas 0 l1e kOr
ret 107
end
if and ge nn 1 and fHas 0 l1e kRound and fHas 0 l1e kDown fHas 0 l1e kMult
ret 101
end
if and ge nn 1 and fHas 0 l1e kRound and fHas 0 l1e kUp fHas 0 l1e kMult
ret 102
end
if and ge nn 1 fHas 0 l1e kDist
ret 103
end
if and ge nn 1 and fHas 0 l1e kSquare fHas 0 l1e kPlus
ret 108
end
if and eq nn 0 fHas 0 l1e kCube
ret 109
end
ret 0
end
if eq ar 2
if and fHas 0 l1e kSquare fHas 0 l1e kDist
ret 204
end
if and fHas 0 l1e kSquare fHas 0 l1e kSum
ret 205
end
if or fHas 0 l1e kDist fHas 0 l1e kAbs
ret 203
end
if or fHas 0 l1e kLarg or fHas 0 l1e kMax fHas 0 l1e kGreat
ret 201
end
if or fHas 0 l1e kSmall fHas 0 l1e kMin
ret 202
end
if fHas 0 l1e kAvg
ret 206
end
if fHas 0 l1e kXor
ret 207
end
ret 0
end
if eq ar 4
if and fHas 0 l1e kSum fHas 0 l1e kSquare
ret 410
end
if and or fHas 0 l1e kHowMany fHas 0 l1e kCount fHas 0 l1e kEven
ret 407
end
if and or fHas 0 l1e kHowMany fHas 0 l1e kCount fHas 0 l1e kOdd
ret 408
end
if and or fHas 0 l1e kHowMany fHas 0 l1e kCount or fHas 0 l1e kNonZero fHas 0 l1e kNonZero2
ret 409
end
if fHas 0 l1e kXor
ret 405
end
if fHas 0 l1e kBitOr
ret 406
end
if fHas 0 l1e kProd
ret 402
end
if or fHas 0 l1e kMax or fHas 0 l1e kBig fHas 0 l1e kGreat
ret 403
end
if or fHas 0 l1e kMin fHas 0 l1e kLeast
ret 404
end
if fHas 0 l1e kSum
ret 401
end
ret 0
end
ret 0
end

note Evaluate concept cid using Pass 1 formula on (a, b)
fn fmEvalP1 cid ulong a ulong b ulong to ulong
c0 = get fmNums 0
c1 = get fmNums 1
c2 = get fmNums 2
if eq cid 101
if eq c0 0
ret 0
end
ret sub a rem a c0
end
if eq cid 102
if eq c0 0
ret 0
end
r = rem a c0
if eq r 0
ret a
end
ret add a sub c0 r
end
if eq cid 103
if lt a c0
ret sub c0 a
end
ret sub a c0
end
if eq cid 104
if eq rem a 2 0
ret div a 2
end
ret add mul 3 a 1
end
if eq cid 105
if lt a c1
ret 0
end
if lt a c2
ret 1
end
c3 = get fmNums 4
if lt a c3
ret 2
end
ret 3
end
if eq cid 106
if eq a 0
ret 0
end
ret and a sub a 1
end
if eq cid 107
if and ne c1 0 eq rem a c1 0
ret 1
end
if and ne c2 0 eq rem a c2 0
ret 1
end
ret 0
end
if eq cid 108
ret add mul a a c0
end
if eq cid 109
ret mul mul a a a
end
if eq cid 201
if gt a b
ret a
end
ret b
end
if eq cid 202
if lt a b
ret a
end
ret b
end
if eq cid 203
if lt a b
ret sub b a
end
ret sub a b
end
if eq cid 204
d = ulong 0
if lt a b
d = sub b a
else
d = sub a b
end
ret mul d d
end
if eq cid 205
ret add mul a a mul b b
end
if eq cid 206
ret div add a b 2
end
if eq cid 207
ret xor a b
end
ret 0
end

note Pass 2: Independent algebraic formulation of same concept cid for dual-pass agreement
fn fmEvalP2 cid ulong a ulong b ulong to ulong
c0 = get fmNums 0
c1 = get fmNums 1
c2 = get fmNums 2
if eq cid 101
if eq c0 0
ret 0
end
ret mul div a c0 c0
end
if eq cid 102
if eq c0 0
ret 0
end
ret mul div add a sub c0 1 c0 c0
end
if eq cid 103
if ge a c0
ret sub a c0
end
ret sub c0 a
end
if eq cid 104
if eq and a 1 0
ret shr a 1
end
ret add add mul 2 a a 1
end
if eq cid 105
note Verify number order for 4-way threshold: "0 ... c1, 1 ... c2, 2 ... c3, 3"
if or ge c1 c2 ge c2 get fmNums 4
ret 999999999
end
if lt a c1
ret 0
end
if lt a c2
ret 1
end
if lt a get fmNums 4
ret 2
end
ret 3
end
if eq cid 106
if eq a 0
ret 0
end
ret sub a and a sub 0 a
end
if eq cid 107
if or eq c1 0 eq c2 0
ret 999999999
end
if eq mul rem a c1 rem a c2 0
ret 1
end
ret 0
end
if eq cid 108
ret add c0 mul a a
end
if eq cid 109
ret mul a mul a a
end
if eq cid 201
if le a b
ret b
end
ret a
end
if eq cid 202
if ge a b
ret b
end
ret a
end
if eq cid 203
if ge a b
ret sub a b
end
ret sub b a
end
if eq cid 204
if ge a b
ret mul sub a b sub a b
end
ret mul sub b a sub b a
end
if eq cid 205
ret add mul b b mul a a
end
if eq cid 206
ret shr add a b 1
end
if eq cid 207
ret sub or a b and a b
end
ret 0
end

note Emit fold spec for cid in 401..410
fn fmEmitFold cid ulong to bool
foClr
foTxt tFoldCases
note Case 1: [3, 7, 2, 9], Case 2: [10, 5, 20], Case 3: [1, 2, 3, 4, 5]
y1 = ulong 0
y2 = ulong 0
y3 = ulong 0
if eq cid 401
y1 = 21
y2 = 35
y3 = 15
end
if eq cid 402
y1 = 378
y2 = 1000
y3 = 120
end
if eq cid 403
y1 = 9
y2 = 20
y3 = 5
end
if eq cid 404
y1 = 2
y2 = 5
y3 = 1
end
if eq cid 405
y1 = 15
y2 = 27
y3 = 1
end
if eq cid 406
y1 = 15
y2 = 31
y3 = 7
end
if eq cid 407
y1 = 1
y2 = 2
y3 = 2
end
if eq cid 408
y1 = 3
y2 = 1
y3 = 3
end
if eq cid 409
y1 = 4
y2 = 3
y3 = 5
end
if eq cid 410
y1 = 143
y2 = 525
y3 = 55
end
foNum y1
foTxt tFoldC2
foNum y2
foTxt tFoldC3
foNum y3
foCh 10
ret true
end

fn fmNeedsDep2 cid ulong to bool
if or eq cid 101 or eq cid 102 eq cid 104
ret true
end
if or eq cid 106 or eq cid 108 eq cid 109
ret true
end
if or eq cid 204 eq cid 205
ret true
end
ret false
end

note Emit scalar spec into fmOut with dual-pass agreement check
fn fmBuildSpec cid ulong to bool
if ge cid 400
ret fmEmitFold cid
end
ar = get fmSt 3
if eq ar 1
put fmInA 0 0
put fmInA 1 1
put fmInA 2 2
put fmInA 3 5
put fmInA 4 12
put fmInA 5 35
put fmInA 6 120
put fmInA 7 1500
else
put fmInA 0 0
put fmInB 0 0
put fmInA 1 3
put fmInB 1 7
put fmInA 2 9
put fmInB 2 2
put fmInA 3 5
put fmInB 3 5
put fmInA 4 10
put fmInB 4 25
put fmInA 5 40
put fmInB 5 12
put fmInA 6 1
put fmInB 6 100
put fmInA 7 88
put fmInB 7 13
end

note Dual-pass agreement across all 8 test cases
for i ulong 8 bound 8
a = get fmInA i
b = get fmInB i
v1 = fmEvalP1 cid a b
v2 = fmEvalP2 cid a b
if ne v1 v2
ret false
end
put fmP1 i v1
end

foClr
foTxt oArity
foNum ar
foCh 10
foTxt oDepth
if fmNeedsDep2 cid
foNum 2
else
foNum 1
end
foCh 10
foTxt oConsts
foNum 0
foCh 32
foNum 1
foCh 32
foNum 2
foCh 32
foNum 3
nn = get fmSt 4
for k ulong nn bound 16
foCh 32
foNum get fmNums k
end
foCh 10
for i ulong 8 bound 8
foTxt oCase
foNum get fmInA i
foCh 32
if eq ar 2
foNum get fmInB i
foCh 32
end
foNum get fmP1 i
foCh 10
end
ret true
end

fn fmLoadStr s view uchar * to ulong
n = len s
for i ulong n bound 4096
put fmBuf i get s i
end
ret n
end

fn runSelfcheck to int
note 1. floor to multiple of 14 -> agree (101)
n1 = fmLoadStr tTestP1
fmParsePrompt n1
c1 = fmPass1
if or ne c1 101 not fmBuildSpec c1
fwStr 2 tSelfFail
fwNum 2 1
fwStr 2 tNl
ret 1
end
note 2. larger of two arguments -> agree (201)
n2 = fmLoadStr tTestP2
fmParsePrompt n2
c2 = fmPass1
if or ne c2 201 not fmBuildSpec c2
fwStr 2 tSelfFail
fwNum 2 2
fwStr 2 tNl
ret 1
end
note 3. distance between two arguments -> agree (203)
n3 = fmLoadStr tTestP3
fmParsePrompt n3
c3 = fmPass1
if or ne c3 203 not fmBuildSpec c3
fwStr 2 tSelfFail
fwNum 2 3
fwStr 2 tNl
ret 1
end
note 4. sum of array -> agree (401)
n4 = fmLoadStr tTestP4
fmParsePrompt n4
c4 = fmPass1
if or ne c4 401 not fmBuildSpec c4
fwStr 2 tSelfFail
fwNum 2 4
fwStr 2 tNl
ret 1
end
note 5. fibonacci -> must fail-closed abstain (0)
n5 = fmLoadStr tTestP5
fmParsePrompt n5
c5 = fmPass1
if ne c5 0
fwStr 2 tSelfFail
fwNum 2 5
fwStr 2 tNl
ret 1
end
fwStr 1 tSelfOk
ret 0
end

fn main to int
if lt argcnt 2
fwStr 2 tUsage
ret 2
end
mb = new uchar 64 0
ml = argread 1 mb 0 64
if le ml 0
fwStr 2 tUsage
ret 2
end
if feqTxt mb ulong ml mSelf
ret runSelfcheck
end
if not feqTxt mb ulong ml mForm
fwStr 2 tUsage
ret 2
end
if lt argcnt 4
fwStr 2 tUsage
ret 2
end
pl = argread 2 fmPath 0 4095
if le pl 0
fwStr 2 tErrIo
ret 1
end
fd = fopen fmPath 0 ulong pl 0 0
if lt fd 0
fwStr 2 tErrIo
ret 1
end
kn = read int fd fmBuf 0 16383
z = fclose int fd
if le kn 0
fwStr 2 tErrIo
ret 1
end
fmParsePrompt ulong kn
cid = fmPass1
if eq cid 0
fwStr 1 tAbstain
ret 1
end
if not fmBuildSpec cid
fwStr 1 tAbstain
ret 1
end
pl2 = argread 3 fmPath 0 4095
if le pl2 0
fwStr 2 tErrIo
ret 1
end
fd2 = fopen fmPath 0 ulong pl2 577 420
if lt fd2 0
fwStr 2 tErrIo
ret 1
end
n = get fmSt 10
o = ulong 0
while lt o n bound 16384
k = write int fd2 fmOut o sub n o
if le k 0
break
end
o = add o ulong k
end
z2 = fclose int fd2
fwStr 1 tAgree
fwNum 1 cid
fwStr 1 tNl
ret 0
end

text tTestP7 "note compute the quantum entanglement entropy of a\nfn solve a ulong to ulong\n"

fn fwStr fd int s view uchar * to void
r = write fd s 0 len s
end

fn fwNum fd int v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write fd b p sub 24 p
end

fn feqTxt a view uchar * al ulong b view uchar * to bool
if ne al len b
ret false
end
for i ulong al bound 64
if ne get a i get b i
ret false
end
end
ret true
end

fn fLower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn fHas boff ulong blen ulong s view uchar * to bool
sl = len s
if or eq sl 0 gt sl blen
ret false
end
lim = add sub blen sl 1
for i ulong lim bound 4096
ok = true
for j ulong sl bound 64
if ne fLower ulong get fmBuf add boff add i j ulong get s j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn h1 s view uchar * to bool
ret fHas 0 get fmSt 0 s
end

fn foClr to void
put fmSt 10 0
end

fn foCh c ulong to void
p = get fmSt 10
if lt p 16383
put fmOut p uchar c
put fmSt 10 add p 1
end
end

fn foTxt s view uchar * to void
for i ulong len s bound 4096
foCh ulong get s i
end
end

fn foNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
while lt p 24 bound 24
foCh ulong get b p
p = add p 1
end
end

fn fmExtractNums l1e ulong to void
nc = ulong 0
i = ulong 0
while lt i l1e bound 4096
c = get fmBuf i
if and ge c 48 le c 57
v = ulong 0
while lt i l1e bound 4096
c2 = get fmBuf i
if not and ge c2 48 le c2 57
break
end
v = add mul v 10 ulong sub c2 48
i = add i 1
end
if lt nc 16
put fmNums nc v
nc = add nc 1
end
else
i = add i 1
end
end
put fmSt 4 nc
end

fn fmParsePrompt blen ulong to void
l1e = ulong 0
while lt l1e blen bound 16384
if eq get fmBuf l1e 10
break
end
l1e = add l1e 1
end
l2s = l1e
if lt l2s blen
l2s = add l2s 1
end
l2e = l2s
while lt l2e blen bound 16384
if eq get fmBuf l2e 10
break
end
l2e = add l2e 1
end
put fmSt 0 l1e
put fmSt 1 l2s
put fmSt 2 l2e
ar = ulong 1
l2n = sub l2e l2s
if fHas l2s l2n kwEdit
ar = 5
else
if fHas l2s l2n kwView
ar = 4
else
if fHas l2s l2n kwC
ar = 3
else
if fHas l2s l2n kwB
ar = 2
else
if fHas l2s l2n kwVoid
ar = 5
end
end
end
end
end
put fmSt 3 ar
fmExtractNums l1e
end

note ======== Shape 1 classifier (unary a ulong to ulong) ========
fn clsShape1Digits to ulong
if h1 kPal
ret 123
end
if or h1 kRoot h1 kSingle
ret 124
end
if h1 kRev
ret 119
end
if h1 kProd
ret 120
end
if or h1 kBig h1 kMax
ret 121
end
if or h1 kLeast h1 kMin
ret 122
end
if h1 kSum
ret 117
end
if and h1 kTrail h1 kZero
ret 136
end
if h1 kEven
ret 140
end
if h1 kOdd
ret 141
end
if or h1 kHowMany or h1 kCount h1 kNumberOf
ret 118
end
ret 0
end

fn clsShape1Bits to ulong
if and h1 kLowest h1 kClear
ret 106
end
if h1 kLowest
ret 113
end
if and h1 kTrail h1 kZero
ret 112
end
if h1 kParity
ret 115
end
if or h1 kOneBit h1 kSetBit
if or h1 kHowMany or h1 kCount h1 kNumberOf
ret 110
end
end
if h1 kRev
ret 133
end
if or h1 kInvert h1 kCompl
ret 132
end
if h1 kSwap
ret 131
end
ret 0
end

fn clsShape1 to ulong
nn = get fmSt 4
if h1 kUnknown
ret 0
end
if h1 kDigit
ret clsShape1Digits
end
if or h1 kBit h1 kBits
c = clsShape1Bits
if ne c 0
ret c
end
end
if h1 kByte
if h1 kSwap
ret 131
end
end
if h1 kSqrt
ret 125
end
if and h1 kPrime or h1 kLeast h1 kSmall
ret 127
end
if h1 kPrime
ret 126
end
if h1 kFact
ret 128
end
if h1 kFib
ret 129
end
if or h1 kCollatz h1 kReach1
ret 130
end
if h1 kDivisor
if h1 kSum
ret 135
end
if or h1 kHowMany or h1 kCount h1 kNumberOf
ret 134
end
end
if and h1 kFactor or h1 kSmall h1 kLeast
ret 127
end
if h1 kHalv
if or h1 kHowMany h1 kCount
ret 111
end
end
if or h1 kPow2 h1 kPowTwo
if or h1 kHighest h1 kLarg
ret 114
end
if or h1 kLeast h1 kSmall
ret 138
end
ret 116
end
if and h1 kHalf and h1 kEven h1 kThree
ret 104
end
if and ge nn 3 h1 kBelow
ret 105
end
if and ge nn 2 and h1 kMult h1 kOr
ret 107
end
if and ge nn 1 and h1 kRound and h1 kDown h1 kMult
ret 101
end
if and ge nn 1 and h1 kRound and h1 kUp h1 kMult
ret 102
end
if and ge nn 1 h1 kDist
ret 103
end
if and h1 kSquare h1 kPlusOne
put fmNums 0 1
put fmSt 4 1
ret 108
end
if and ge nn 1 and h1 kSquare h1 kPlus
ret 108
end
if and eq nn 0 h1 kCube
ret 109
end
if h1 kTri
ret 139
end
ret 0
end


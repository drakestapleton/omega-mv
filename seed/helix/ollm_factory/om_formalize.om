t = get frTmp i
put frTmp i get frTmp j
put frTmp j t
end
end
end
ret
end
if eq cid 503
s = ulong 0
for i ulong n bound 8
s = add s get frTmp i
put frTmp i s
end
ret
end
if eq cid 504
m = ulong 0
for i ulong n bound 8
v = get frTmp i
if gt v m
m = v
end
put frTmp i m
end
ret
end
if eq cid 505
for i ulong n bound 8
put frTmp i mul get frTmp i 2
end
ret
end
if eq cid 506
for i ulong n bound 8
put frTmp i div get frTmp i 2
end
ret
end
if eq cid 507
for i ulong n bound 8
v = get frTmp i
put frTmp i mul v v
end
ret
end
if eq cid 508
for i ulong n bound 8
if eq and get frTmp i 1 0
put frTmp i 0
end
end
ret
end
if eq cid 509
for i ulong n bound 8
if ne and get frTmp i 1 0
put frTmp i 0
end
end
ret
end
if eq cid 510
if gt n 1
f = get frTmp 0
i = ulong 1
while lt i n bound 8
put frTmp sub i 1 get frTmp i
i = add i 1
end
put frTmp sub n 1 f
end
ret
end
if eq cid 511
if gt n 1
l = get frTmp sub n 1
i = sub n 1
while gt i 0 bound 8
put frTmp i get frTmp sub i 1
i = sub i 1
end
put frTmp 0 l
end
ret
end
if eq cid 512
if gt n 0
i = ulong 1
while lt i n bound 8
put frTmp sub i 1 get frTmp i
i = add i 1
end
put frTmp sub n 1 0
end
ret
end
if eq cid 513
if gt n 0
i = sub n 1
while gt i 0 bound 8
put frTmp i get frTmp sub i 1
i = sub i 1
end
put frTmp 0 0
end
ret
end
if eq cid 514
i = ulong 0
while lt add i 1 n bound 8
t = get frTmp i
put frTmp i get frTmp add i 1
put frTmp add i 1 t
i = add i 2
end
ret
end
if eq cid 515
w = ulong 0
for i ulong n bound 8
v = get frTmp i
if ne v 0
put frTmp w v
w = add w 1
end
end
while lt w n bound 8
put frTmp w 0
w = add w 1
end
ret
end
if eq cid 518
x = ulong 0
for i ulong n bound 8
x = xor x get frTmp i
put frTmp i x
end
ret
end
for i ulong n bound 8
v = get frTmp i
if eq cid 550
put frTmp i add v kv
end
if eq cid 551
if le v kv
put frTmp i 0
else
put frTmp i sub v kv
end
end
if eq cid 552
put frTmp i mul v kv
end
if eq cid 555
if gt v kv
put frTmp i kv
end
end
if eq cid 556
if lt v kv
put frTmp i kv
end
end
if eq cid 557
if lt v kv
put frTmp i 0
end
end
if eq cid 558
if gt v kv
put frTmp i 0
end
end
if eq cid 559
if eq v 0
put frTmp i kv
end
end
if eq cid 560
put frTmp i kv
end
end
end

fn emitRewArr to void
for k ulong 8 bound 8
if gt k 0
foCh 32
end
foNum get frTmp k
end
end

fn fmEmitRew cid ulong to bool
kv = get fmNums 0
foClr
foTxt oArity
foNum 5
foCh 10
foTxt oConsts
foNum 0
foCh 32
foNum 1
foCh 32
foNum 2
nn = get fmSt 4
for k ulong nn bound 16
foCh 32
foNum get fmNums k
end
foCh 10
note Case 1: n=4 [3,7,2,9,5,1,8,4]
foTxt tRew1
put frTmp 0 3
put frTmp 1 7
put frTmp 2 2
put frTmp 3 9
put frTmp 4 5
put frTmp 5 1
put frTmp 6 8
put frTmp 7 4
applyRew cid 4 kv
emitRewArr
note Case 2: n=5 [10,0,5,0,20,3,6,1]
foTxt tRew2
put frTmp 0 10
put frTmp 1 0
put frTmp 2 5
put frTmp 3 0
put frTmp 4 20
put frTmp 5 3
put frTmp 6 6
put frTmp 7 1
applyRew cid 5 kv
emitRewArr
note Case 3: n=6 [1,2,3,4,5,6,7,8]
foTxt tRew3
put frTmp 0 1
put frTmp 1 2
put frTmp 2 3
put frTmp 3 4
put frTmp 4 5
put frTmp 5 6
put frTmp 6 7
put frTmp 7 8
applyRew cid 6 kv
emitRewArr
foCh 10
ret true
end

fn fmEmitFold cid ulong to bool
initFoldArrays
y0 = evalFoldFixed cid 0
y1 = evalFoldFixed cid 1
y2 = evalFoldFixed cid 2
y3 = evalFoldFixed cid 3
if or eq y0 999999999 eq y1 999999999
ret false
end
foClr
foTxt oArity
foNum 4
foCh 10
foTxt oConsts
foNum 0
foCh 32
foNum 1
foCh 32
foNum 2
nn = get fmSt 4
for k ulong nn bound 16
foCh 32
foNum get fmNums k
end
foCh 10
foTxt tFoldA1
foNum y0
foTxt tFoldA2
foNum y1
foTxt tFoldA3
foNum y2
foTxt tFoldA4
foNum y3
foCh 10
ret true
end

fn fmNeedsDep2 cid ulong to bool
if or eq cid 101 or eq cid 102 eq cid 104
ret true
end
if or eq cid 106 or eq cid 108 eq cid 109
ret true
end
if or eq cid 204 eq cid 205
ret true
end
if and ge cid 220 le cid 234
ret true
end
ret false
end

fn fmEmitScalarSpec cid ulong ar ulong to void
foClr
foTxt oArity
foNum ar
foCh 10
foTxt oDepth
if fmNeedsDep2 cid
foNum 2
else
foNum 1
end
foCh 10
foTxt oConsts
foNum 0
foCh 32
foNum 1
foCh 32
foNum 2
foCh 32
foNum 3
nn = get fmSt 4
for k ulong nn bound 16
foCh 32
foNum get fmNums k
end
foCh 10
for i ulong 8 bound 8
foTxt oCase
foNum get fmInA i
foCh 32
if ge ar 2
foNum get fmInB i
foCh 32
end
if ge ar 3
foNum get fmInC i
foCh 32
end
foNum get fmP1 i
foCh 10
end
end

fn fmBuildSpec cid ulong to bool
if ge cid 500
ret fmEmitRew cid
end
if ge cid 400
ret fmEmitFold cid
end
ar = get fmSt 3
if eq ar 1
put fmInA 0 0
put fmInA 1 1
put fmInA 2 2
put fmInA 3 5
put fmInA 4 12
put fmInA 5 35
put fmInA 6 120
if eq cid 105
put fmInA 7 1500
else
put fmInA 7 18
end
end
if eq ar 2
put fmInA 0 0
put fmInB 0 0
put fmInA 1 3
put fmInB 1 7
put fmInA 2 9
put fmInB 2 2
put fmInA 3 5
put fmInB 3 5
put fmInA 4 10
put fmInB 4 25
put fmInA 5 40
put fmInB 5 12
put fmInA 6 1
put fmInB 6 10
put fmInA 7 24
put fmInB 7 9
end
if eq ar 3
put fmInA 0 5
put fmInB 0 10
put fmInC 0 20
put fmInA 1 15
put fmInB 1 10
put fmInC 1 20
put fmInA 2 25
put fmInB 2 10
put fmInC 2 20
put fmInA 3 10
put fmInB 3 10
put fmInC 3 20
put fmInA 4 0
put fmInB 4 0
put fmInC 4 0
put fmInA 5 9
put fmInB 5 2
put fmInC 5 5
put fmInA 6 1
put fmInB 6 8
put fmInC 6 3
put fmInA 7 7
put fmInB 7 4
put fmInC 7 4
end

for i ulong 8 bound 8
v = ulong 999999999
if eq ar 1
if lt cid 117
v = evalU1 cid get fmInA i
else
v = evalU2 cid get fmInA i
end
end
if eq ar 2
v = evalBin cid get fmInA i get fmInB i
end
if eq ar 3
v = evalTern cid get fmInA i get fmInB i get fmInC i
end
if eq v 999999999
ret false
end
put fmP1 i v
end
fmEmitScalarSpec cid ar
ret true
end

fn fmLoadStr s view uchar * to ulong
n = len s
for i ulong n bound 4096
put fmBuf i get s i
end
ret n
end

fn checkSelfCase s view uchar * expCid ulong to bool
n = fmLoadStr s
fmParsePrompt n
c = fmPass1
if ne c expCid
ret false
end
if eq expCid 0
ret true
end
ret fmBuildSpec c
end

fn runSelfcheck to int
if or fmMultiple 0 0 or fmMultiple 15 0 or not fmMultiple 0 3 or not fmMultiple 15 3 fmMultiple 14 3
fwStr 2 tSelfFail
fwNum 2 8
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP1 101
fwStr 2 tSelfFail
fwNum 2 1
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP2 201
fwStr 2 tSelfFail
fwNum 2 2
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP3 210
fwStr 2 tSelfFail
fwNum 2 3
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP4 117
fwStr 2 tSelfFail
fwNum 2 4
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP5 415
fwStr 2 tSelfFail
fwNum 2 5
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP6 500
fwStr 2 tSelfFail
fwNum 2 6
fwStr 2 tNl
ret 1
end
if not checkSelfCase tTestP7 0
fwStr 2 tSelfFail
fwNum 2 7
fwStr 2 tNl
ret 1
end
fwStr 1 tSelfOk
ret 0
end

fn main to int
if lt argcnt 2
fwStr 2 tUsage
ret 2
end
mb = new uchar 64 0
ml = argread 1 mb 0 64
if le ml 0
fwStr 2 tUsage
ret 2
end
if feqTxt mb ulong ml mSelf
ret runSelfcheck
end
if not feqTxt mb ulong ml mForm
fwStr 2 tUsage
ret 2
end
if lt argcnt 4
fwStr 2 tUsage
ret 2
end
pl = argread 2 fmPath 0 4095
if le pl 0
fwStr 2 tErrIo
ret 1
end
fd = fopen fmPath 0 ulong pl 0 0
if lt fd 0
fwStr 2 tErrIo
ret 1
end
kn = read int fd fmBuf 0 16383
z = fclose int fd
if le kn 0
fwStr 2 tErrIo
ret 1
end
fmParsePrompt ulong kn
cid = fmPass1
if eq cid 0
fwStr 1 tAbstain
ret 1
end
if not fmBuildSpec cid
fwStr 1 tAbstain
ret 1
end
pl2 = argread 3 fmPath 0 4095
if le pl2 0
fwStr 2 tErrIo
ret 1
end
fd2 = fopen fmPath 0 ulong pl2 577 420
if lt fd2 0
fwStr 2 tErrIo
ret 1
end
n = get fmSt 10
o = ulong 0
while lt o n bound 16384
k = write int fd2 fmOut o sub n o
if le k 0
break
end
o = add o ulong k
end
z2 = fclose int fd2
fwStr 1 tAgree
fwNum 1 cid
fwStr 1 tNl
ret 0
end

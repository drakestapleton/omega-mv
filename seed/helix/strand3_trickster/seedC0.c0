35:00:80:d2  % [22] movz x21, #1
ef:ff:ff:17  % [23] b    -17 -> [6]

% digits '0'..'9' [24..26]
01:c0:00:71  % [24] subs w1, w0, #48
3f:28:00:71  % [25] subs wzr, w1, #10
83:02:00:54  % [26] b.lo +20 -> [46] got_nib

% lowercase 'a'..'f' [27..29]
01:84:01:71  % [27] subs w1, w0, #97
3f:18:00:71  % [28] subs wzr, w1, #6

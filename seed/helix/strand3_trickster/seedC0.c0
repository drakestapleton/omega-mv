e1:03:16:aa  % [53] mov  x1, x22
22:00:80:d2  % [54] movz x2, #1
08:08:80:d2  % [55] movz x8, #64 (SYS_write)
01:00:00:d4  % [56] svc  #0
1f:04:00:f1  % [57] subs xzr, x0, #1
41:01:00:54  % [58] b.ne +10 -> [68] err_write
13:00:80:d2  % [59] movz x19, #0
14:00:80:d2  % [60] movz x20, #0

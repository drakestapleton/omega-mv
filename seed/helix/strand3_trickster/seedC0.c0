% err_read [66..67]
a0:01:80:d2  % [66] movz x0, #13
02:00:00:14  % [67] b    +2 -> [69] do_exit

% err_write [68]
c0:01:80:d2  % [68] movz x0, #14

% do_exit [69..70]
a8:0b:80:d2  % [69] movz x8, #93 (SYS_exit)
01:00:00:d4  % [70] svc  #0

% seedC0.c0 -- Rung C0 of Strand 3 ("The Trickster" -- Adversarial Chaos Strand).
% 3rd completely independent hand-written AArch64 W^X seed (404 bytes), zero shared grammar or layout
% with Strand A (seed0.hex, 0x400000, '#' comments, 32-bit LE words, RWX) or
% Strand B (seedB0.b0, 0x500000, ';' comments, byte pairs, x10..x14).
%
% Grammar: '%' starts a comment to end of line. Every two hex digits emit one raw byte to stdout.
% Whitespace (space, tab, CR, LF) and ':' separators are ignored.
% Bad char -> exit 11. Odd trailing nibble -> exit 12. Read error -> exit 13. Write error -> exit 14.
% Memory model: pure W^X (p_flags = PF_R|PF_X = 5, p_vaddr = 0x600000, p_memsz == p_filesz = 404).
% Distinct register allocation: x19=acc, x20=nibbles, x21=in_comment, x22=sp_buf, x23=10.
% Encodings verified against Arm Architecture Reference Manual DDI 0487.

% ---- ELF-64 file header (64 bytes, 0x00..0x3f) ----
7f:45:4c:46:02:01:01:00  % e_ident[0..7]
00:00:00:00:00:00:00:00  % e_ident[8..15]
02:00:b7:00:01:00:00:00  % ET_EXEC, EM_AARCH64, version 1
78:00:60:00:00:00:00:00  % e_entry = 0x600078
40:00:00:00:00:00:00:00  % e_phoff = 64
00:00:00:00:00:00:00:00  % e_shoff = 0
00:00:00:00:40:00:38:00  % e_flags=0, ehsize=64, phentsize=56
01:00:00:00:00:00:00:00  % phnum=1

% ---- ELF-64 program header (56 bytes, 0x40..0x77) ----
01:00:00:00:05:00:00:00  % PT_LOAD, PF_R|PF_X = 5 (pure W^X!)
00:00:00:00:00:00:00:00  % p_offset = 0
00:00:60:00:00:00:00:00  % p_vaddr = 0x600000
00:00:60:00:00:00:00:00  % p_paddr = 0x600000
94:01:00:00:00:00:00:00  % p_filesz = 404 (0x194 = 120 header + 71*4 code)
94:01:00:00:00:00:00:00  % p_memsz  = 404 (zero BSS)
00:10:00:00:00:00:00:00  % p_align  = 4096

% ---- AArch64 code (71 instructions, 284 bytes, 0x600078..0x600193) ----
% Registers: x19=acc, x20=nibble_cnt, x21=in_comment, x22=sp_buf, x23=10
ff:43:00:d1  % [0]  sub  sp, sp, #16
f6:03:00:91  % [1]  mov  x22, sp
13:00:80:d2  % [2]  movz x19, #0
14:00:80:d2  % [3]  movz x20, #0
15:00:80:d2  % [4]  movz x21, #0
57:01:80:d2  % [5]  movz x23, #10

% loop [6]: SYS_read(0, x22, 1)
00:00:80:d2  % [6]  movz x0, #0
e1:03:16:aa  % [7]  mov  x1, x22 (orr x1, xzr, x22)
22:00:80:d2  % [8]  movz x2, #1
e8:07:80:d2  % [9]  movz x8, #63
01:00:00:d4  % [10] svc  #0
1f:00:00:f1  % [11] subs xzr, x0, #0
40:06:00:54  % [12] b.eq +50 -> [62] eof
ab:06:00:54  % [13] b.lt +53 -> [66] err_read
c0:02:40:39  % [14] ldrb w0, [x22]
b5:00:00:b4  % [15] cbz  x21, +5 -> [20]

% inside '%' comment [16..19]
1f:28:00:71  % [16] subs wzr, w0, #10 ('\n')
a1:fe:ff:54  % [17] b.ne -11 -> [6]
15:00:80:d2  % [18] movz x21, #0
f3:ff:ff:17  % [19] b    -13 -> [6]

% not in comment [20..23]: check '%' (37 = 0x25)
1f:94:00:71  % [20] subs wzr, w0, #37 ('%')

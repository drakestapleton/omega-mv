note SPDX-License-Identifier: Apache-2.0
note seed/helix/ddc_mesh/gate_ddc_mesh.om
note Pure seeded OM-2 Verification Gate for Wave 3 Alien Breakthrough (DDC-3HOST).
note
note Compose after:
note   si/directives/om2.om
note   seed/ng/sha256.om
note
note Build:
note   cat si/directives/om2.om seed/ng/sha256.om seed/helix/ddc_mesh/gate_ddc_mesh.om | seed/out/omc > gate_ddc_mesh
note Usage:
note   gate_ddc_mesh [OMC_BIN [REPO_ROOT [SCRATCH_DIR]]]

global gd_omc uchar 1024
global gd_omc_n ulong 1
global gd_rep uchar 1024
global gd_rep_n ulong 1
global gd_scr uchar 1024
global gd_scr_n ulong 1

global gd_pa uchar 2048
global gd_pal ulong 1
global gd_pb uchar 2048
global gd_pbl ulong 1

global gd_av uchar 8192
global gd_an ulong 1
global gd_ac ulong 1
global gd_st uchar 8
global gd_dig uchar 24

global gd_buf uchar 1048576
global gd_blen ulong 1
global gd_sha1 uchar 32
global gd_sha2 uchar 32
global gd_hex uchar 64
global gd_out uchar 32768
global gd_olen ulong 1

global gd_chk ulong 1
global gd_neg ulong 1

text gd_def_omc "seed/out/omc"
text gd_def_rep "."
text gd_def_scr "/tmp/ddc-mesh-gate"
text gd_devnull "/dev/null"


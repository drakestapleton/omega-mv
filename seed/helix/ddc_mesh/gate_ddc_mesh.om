text gd_s_1 "1"
text gd_s_2 "2"
text gd_s_3 "3"
text gd_s_53 "53"
text gd_s_54 "54"
text gd_s_abi1 "a64macos-apple-m2-darwin"
text gd_s_abi2 "aarch64-grace-x925-linux"
text gd_s_abi3 "aarch64-pi5-cortex-a76-linux"
text gd_s_alt "alt-role-tag"
text gd_s_sybil "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

text gd_pat_em "emit 3533832220"
text gd_pat_nop "emit 3573751839\nemit 3533832220"
text gd_pat_r53 "ret 53"
text gd_pat_r54 "ret 54"
text gd_exp_pay "DDC_PAYLOAD_OK rounds=256 invariants=768 digest="
text gd_exp_q "DDC_QUORUM PASS votes=3/3 roles=1,2,3 sybil_guard=OK ed25519=3/3"

text gd_hdr "=== OMEGA WAVE 3 ALIEN BREAKTHROUGH: DDC-3HOST VERIFICATION GATE ===\n"
text gd_t1a "  [T1] PASS 2x_det_omc_linux sha256="
text gd_t1b " 2x_det_a64macos_macho sha256="
text gd_t2 "  [T2] PASS payload_2x_det_elf+macho exec_rc=53 DDC_PAYLOAD_OK\n"
text gd_t3 "  [T3] PASS 3host_ed25519_receipts+quorum=3/3+selftest OK\n"
text gd_k_pfx "  [NEG-"
text gd_k_mid "] KILL "
text gd_k_rc " -> exit="
text gd_pass_a "GATE_DDC_MESH PASS checks="
text gd_pass_b " neg_controls="
text gd_pass_c " trojan_omc_caught=1 hw_writes=0\n"
text gd_fail_a "GATE_DDC_MESH FAIL step="
text gd_fail_b " got="
text gd_nl "\n"

text gd_n_1 "ken_thompson_real_trojan_omc_cross_elf"
text gd_n_2 "ken_thompson_trojan_exec_rc_54"
text gd_n_3 "ken_thompson_trojan_stdout_digest"
text gd_n_4 "sybil_duplicate_ed25519_pubkey"
text gd_n_5 "duplicate_host_role_id"
text gd_n_6 "1bit_ed25519_sig_tamper"
text gd_n_7 "1bit_signed_body_tamper"
text gd_n_8 "semantic_bind_digest_tamper"
text gd_n_9 "wrong_domain_tag_OMEGA_DDC3"
text gd_n_10 "malformed_OMRC0001_magic"
text gd_n_11a "truncated_351B_receipt"
text gd_n_11b "trailing_353B_receipt"
text gd_n_12 "source_sha256_mismatch"

fn gd_wrt fd int s view uchar * to void
  r = write fd s 0 len s
end

fn gd_num fd int v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put gd_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      r = write fd gd_dig p sub 24 p
      ret
    end
  end
end

fn gd_fail step ulong got ulong to int
  gd_wrt 2 gd_fail_a
  gd_num 2 step
  gd_wrt 2 gd_fail_b
  gd_num 2 got
  gd_wrt 2 gd_nl
  ret 1
end

fn gd_wrhex fd int which ulong to void
  for i ulong 32
    b = uint 0
    if eq which 0
      b = uint get gd_sha1 i
    else
      b = uint get gd_sha2 i
    end
    put gd_hex mul i 2 sh_hexd shr b 4
    put gd_hex add mul i 2 1 sh_hexd and b 15
  end
  r = write fd gd_hex 0 64
end

fn gd_set_def_omc to void
  n = len gd_def_omc
  for i ulong n bound 1024
    put gd_omc i get gd_def_omc i
  end
  put gd_omc_n 0 n
end

fn gd_set_def_rep to void
  n = len gd_def_rep
  for i ulong n bound 1024
    put gd_rep i get gd_def_rep i
  end
  put gd_rep_n 0 n
end

fn gd_set_def_scr to void
  n = len gd_def_scr
  for i ulong n bound 1024
    put gd_scr i get gd_def_scr i
  end
  put gd_scr_n 0 n
end

fn gd_init_args to void
  if ge argcnt 2
    k1 = argread 1 gd_omc 0 1000
    if gt k1 0
      put gd_omc_n 0 ulong k1
    else
      gd_set_def_omc
    end
  else
    gd_set_def_omc
  end
  if ge argcnt 3
    k2 = argread 2 gd_rep 0 1000
    if gt k2 0
      put gd_rep_n 0 ulong k2
    else
      gd_set_def_rep
    end
  else
    gd_set_def_rep
  end
  if ge argcnt 4
    k3 = argread 3 gd_scr 0 1000
    if gt k3 0
      put gd_scr_n 0 ulong k3
    else
      gd_set_def_scr
    end
  else
    gd_set_def_scr
  end
  u = makedir gd_scr 0 get gd_scr_n 0 493
end

fn gd_mk_rep suf view uchar * to void
  n = get gd_rep_n 0
  for i ulong n bound 1024
    put gd_pa i get gd_rep i
  end
  sl = len suf
  for j ulong sl bound 256
    put gd_pa add n j get suf j
  end
  put gd_pal 0 add n sl
end

fn gd_mk_scr suf view uchar * to void
  n = get gd_scr_n 0
  for i ulong n bound 1024
    put gd_pa i get gd_scr i
  end
  sl = len suf
  for j ulong sl bound 256
    put gd_pa add n j get suf j
  end
  put gd_pal 0 add n sl
end

fn gd_read_pa_to_buf to long
  fd = fopen gd_pa 0 get gd_pal 0 0 0
  if lt fd 0
    ret long -1
  end
  tot = ulong 0
  while lt tot 1048576 bound 2048
    remc = sub 1048576 tot
    if gt remc 4096
      remc = ulong 4096
    end
    k = read int fd gd_buf tot remc
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  put gd_blen 0 tot
  ret long tot
end

fn gd_write_buf_pa n ulong to bool
  fd = fopen gd_pa 0 get gd_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 2048
    want = sub n off
    if gt want 4096
      want = ulong 4096
    end
    w = write int fd gd_buf off want
    if le w 0
      c1 = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  c2 = fclose int fd
  ret true
end

fn gd_append_rep_file outfd int suf view uchar * to bool
  gd_mk_rep suf
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  off = ulong 0
  tot = ulong n
  while lt off tot bound 2048
    w = write outfd gd_buf off sub tot off
    if le w 0
      ret false
    end
    off = add off ulong w
  end
  ret true
end

fn gd_build_units to bool
  gd_mk_scr gd_f_unit
  fd = fopen gd_pa 0 get gd_pal 0 577 420
  if lt fd 0
    ret false
  end
  ok = gd_append_rep_file int fd gd_r_om2
  if ok
    ok = gd_append_rep_file int fd gd_r_s256
  end
  if ok
    ok = gd_append_rep_file int fd gd_r_s512
  end
  if ok
    ok = gd_append_rep_file int fd gd_r_ed
  end
  if ok
    ok = gd_append_rep_file int fd gd_r_esg
  end
  if ok
    ok = gd_append_rep_file int fd gd_r_dm
  end
  c = fclose int fd
  if not ok
    ret false
  end
  gd_mk_scr gd_f_unit
  un = gd_read_pa_to_buf
  if lt un 100
    ret false
  end
  gd_mk_scr gd_f_munit
  mfd = fopen gd_pa 0 get gd_pal 0 577 420
  if lt mfd 0
    ret false
  end
  w0 = write int mfd gd_mac_hdr 0 len gd_mac_hdr
  if ne w0 long len gd_mac_hdr
    c1 = fclose int mfd
    ret false
  end
  off = ulong 0
  tot = ulong un
  while lt off tot bound 2048
    w1 = write int mfd gd_buf off sub tot off
    if le w1 0
      c2 = fclose int mfd
      ret false
    end
    off = add off ulong w1
  end
  c3 = fclose int mfd
  ret true
end

fn gd_av_reset to void
  put gd_an 0 2
  put gd_ac 0 0
end

fn gd_av_push_txt s view uchar * to void
  n = len s
  p = get gd_an 0
  put gd_av p uchar and n 255
  put gd_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gd_av add p i get s i
  end
  put gd_an 0 add p n
  put gd_ac 0 add get gd_ac 0 1
end

fn gd_av_push_pa to void
  n = get gd_pal 0
  p = get gd_an 0
  put gd_av p uchar and n 255
  put gd_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gd_av add p i get gd_pa i
  end
  put gd_an 0 add p n
  put gd_ac 0 add get gd_ac 0 1
end

fn gd_av_push_omc to void
  n = get gd_omc_n 0
  p = get gd_an 0
  put gd_av p uchar and n 255
  put gd_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gd_av add p i get gd_omc i
  end
  put gd_an 0 add p n
  put gd_ac 0 add get gd_ac 0 1
end

fn gd_av_push_scr suf view uchar * to void
  gd_mk_scr suf
  gd_av_push_pa
end

fn gd_open_in in_pa bool to long
  if in_pa
    ret fopen gd_pa 0 get gd_pal 0 0 0
  end
  ret fopen gd_devnull 0 len gd_devnull 0 0
end

fn gd_child_run fi int fo int fe int to void
  r = dupfd fi 0 0
  r = dupfd fo 1 0
  r = dupfd fe 2 0
  r = execprog gd_av 0 get gd_an 0
  exit 127
end

fn gd_spawn_stdio in_pa bool out_suf view uchar * err_suf view uchar * to ulong
  cnt = get gd_ac 0
  put gd_av 0 uchar and cnt 255
  put gd_av 1 uchar and shr cnt 8 255
  fi = gd_open_in in_pa
  gd_mk_scr out_suf
  fo = fopen gd_pa 0 get gd_pal 0 577 420
  gd_mk_scr err_suf
  fe = fopen gd_pa 0 get gd_pal 0 577 420
  if lt fi 0
    ret 255
  end
  if or lt fo 0 lt fe 0
    ret 255
  end
  pid = fork
  if lt pid 0
    ret 254
  end
  if eq pid 0
    gd_child_run int fi int fo int fe
  end
  c = fclose int fi
  c = fclose int fo
  c = fclose int fe
  w = waitpid int pid gd_st 0 4 0
  if ne w pid
    ret 253
  end
  if ne get gd_st 0 0
    ret add 256 ulong get gd_st 0
  end
  ret ulong get gd_st 1
end

fn gd_compile_pin unit_suf view uchar * out_bin view uchar * to ulong
  gd_av_reset
  gd_av_push_omc
  gd_mk_scr unit_suf
  rc = gd_spawn_stdio true out_bin gd_f_err
  if ne rc 0
    ret rc
  end
  gd_mk_scr out_bin
  cr = chmod gd_pa 0 get gd_pal 0 493
  if ne cr 0
    ret 250
  end
  ret 0
end

fn gd_compile_scr comp_suf view uchar * unit_suf view uchar * out_bin view uchar * to ulong
  gd_av_reset
  gd_av_push_scr comp_suf
  gd_mk_scr unit_suf
  rc = gd_spawn_stdio true out_bin gd_f_err
  if ne rc 0
    ret rc
  end
  gd_mk_scr out_bin
  cr = chmod gd_pa 0 get gd_pal 0 493
  if ne cr 0
    ret 250
  end
  ret 0
end

fn gd_sha_scr suf view uchar * to_two bool to bool
  gd_mk_scr suf
  fd = fopen gd_pa 0 get gd_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot 16777216 bound 8192
    k = read int fd sh_dat tot 65536
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  if eq tot 0
    ret false
  end
  sh_all tot
  for i ulong 32
    if to_two
      put gd_sha2 i get sh_dig i
    else
      put gd_sha1 i get sh_dig i
    end
  end
  ret true
end

fn gd_sha_eq to bool
  for i ulong 32
    if ne get gd_sha1 i get gd_sha2 i
      ret false
    end
  end
  ret true
end

fn gd_check_macho_magic suf view uchar * to bool
  gd_mk_scr suf
  n = gd_read_pa_to_buf
  if lt n 1024
    ret false
  end
  if ne get gd_buf 0 0xcf
    ret false
  end
  if ne get gd_buf 1 0xfa
    ret false
  end
  if ne get gd_buf 2 0xed
    ret false
  end
  ret eq get gd_buf 3 0xfe
end

fn gd_read_out_scr suf view uchar * to void
  gd_mk_scr suf
  fd = fopen gd_pa 0 get gd_pal 0 0 0
  if lt fd 0
    put gd_olen 0 0
    ret
  end
  tot = ulong 0
  while lt tot 32768 bound 128
    k = read int fd gd_out tot sub 32768 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  c = fclose int fd
  put gd_olen 0 tot
end

fn gd_out_match_at pos ulong pat view uchar * to bool
  for j ulong len pat bound 128
    if ne get gd_out add pos j get pat j
      ret false
    end
  end
  ret true
end

fn gd_out_has suf view uchar * pat view uchar * to bool
  gd_read_out_scr suf
  ol = get gd_olen 0
  pl = len pat
  if lt ol pl
    ret false
  end
  lim = add sub ol pl 1
  b0 = get pat 0
  for i ulong lim bound 32768
    if eq get gd_out i b0
      if gd_out_match_at i pat
        ret true
      end
    end
  end
  ret false
end

fn gd_copy_scr src view uchar * dst view uchar * to bool
  gd_mk_scr src
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  gd_mk_scr dst
  ret gd_write_buf_pa ulong n
end

fn gd_flip_byte suf view uchar * off ulong to bool
  gd_mk_scr suf
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if le un off
    ret false
  end
  put gd_buf off xor get gd_buf off uchar 1
  ret gd_write_buf_pa un
end

fn gd_set_byte suf view uchar * off ulong val uchar to bool
  gd_mk_scr suf
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if le un off
    ret false
  end
  put gd_buf off val
  ret gd_write_buf_pa un
end

fn gd_write_trunc suf view uchar * drop ulong to bool
  gd_mk_scr suf
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if le un drop
    ret false
  end
  ret gd_write_buf_pa sub un drop
end

fn gd_append_byte suf view uchar * b uchar to bool
  gd_mk_scr suf
  n = gd_read_pa_to_buf
  if lt n 1
    ret false
  end
  un = ulong n
  if ge un 1048570
    ret false
  end
  put gd_buf un b
  ret gd_write_buf_pa add un 1
end

fn gd_buf_match_at pos ulong pat view uchar * to bool
  for j ulong len pat bound 64
    if ne get gd_buf add pos j get pat j
      ret false
    end
  end
  ret true
end

fn gd_find_in_buf pat view uchar * un ulong maxb ulong to long
  pl = len pat
  if lt un pl
    ret long -1
  end
  lim = add sub un pl 1
  b0 = get pat 0
  for i ulong lim bound 1048576
    if ge i maxb
      ret long -1
    end
    if eq get gd_buf i b0
      if gd_buf_match_at i pat
        ret long i
      end
    end
  end
  ret long -1
end

fn gd_patch_payload_r54 to bool
  gd_mk_scr gd_f_pay
  n = gd_read_pa_to_buf
  if lt n 20
    ret false
  end
  un = ulong n
  pos = gd_find_in_buf gd_pat_r53 un 8192
  if lt pos 0
    ret false
  end
  for k ulong len gd_pat_r54 bound 16
    put gd_buf add ulong pos k get gd_pat_r54 k
  end
  gd_mk_scr gd_f_pmut
  ret gd_write_buf_pa un
end

fn gd_write_buf_slice fd int st ulong ed ulong to bool
  off = st
  while lt off ed bound 2048
    want = sub ed off
    if gt want 4096
      want = ulong 4096
    end
    w = write int fd gd_buf off want
    if le w 0
      ret false
    end
    off = add off ulong w
  end
  ret true
end

fn gd_patch_trojan_omc to bool
  gd_mk_rep gd_r_omc
  n = gd_read_pa_to_buf
  if lt n 1000
    ret false
  end
  un = ulong n
  pos = gd_find_in_buf gd_pat_em un 1048576
  if lt pos 0
    ret false
  end
  found_at = ulong pos
  gd_mk_scr gd_f_tromc_s
  fd = fopen gd_pa 0 get gd_pal 0 577 420
  if lt fd 0
    ret false
  end
  ok = gd_write_buf_slice int fd 0 found_at
  if ok
    wn = write int fd gd_pat_nop 0 len gd_pat_nop
    ok = eq wn long len gd_pat_nop
  end
  if ok
    ok = gd_write_buf_slice int fd add found_at len gd_pat_em un
  end
  c4 = fclose int fd
  ret ok
end

fn gd_att_begin role_s view uchar * abi_s view uchar * src_s view uchar * to void
  gd_av_reset
  gd_av_push_scr gd_f_bin1
  gd_av_push_txt gd_c_att
  gd_av_push_txt gd_fl_role
  gd_av_push_txt role_s
  gd_av_push_txt gd_fl_abi
  gd_av_push_txt abi_s
  gd_av_push_txt gd_fl_src
  gd_av_push_scr src_s
end

fn gd_att_mid cmp_s view uchar * xelf_s view uchar * xout_s view uchar * to void
  gd_av_push_txt gd_fl_cmp
  gd_av_push_scr cmp_s
  gd_av_push_txt gd_fl_xelf
  gd_av_push_scr xelf_s
  gd_av_push_txt gd_fl_xout
  gd_av_push_scr xout_s
end

fn gd_att_mid_self cmp_s view uchar * xout_s view uchar * to void
  gd_av_push_txt gd_fl_cmp
  gd_av_push_scr cmp_s
  gd_av_push_txt gd_fl_xelf
  gd_av_push_scr cmp_s
  gd_av_push_txt gd_fl_xout
  gd_av_push_scr xout_s
end

fn gd_att_finish xrc_s view uchar * out_s view uchar * to ulong
  gd_av_push_txt gd_fl_xrc
  gd_av_push_txt xrc_s
  gd_av_push_txt gd_fl_out
  gd_av_push_scr out_s
  ret gd_spawn_stdio false gd_f_out gd_f_err
end

fn gd_att_tag_finish tag_s view uchar * is_hex bool out_s view uchar * to ulong
  gd_av_push_txt gd_fl_xrc
  gd_av_push_txt gd_s_53
  if is_hex
    gd_av_push_txt gd_fl_shex
  else
    gd_av_push_txt gd_fl_stag
  end
  gd_av_push_txt tag_s
  gd_av_push_txt gd_fl_out
  gd_av_push_scr out_s
  ret gd_spawn_stdio false gd_f_out gd_f_err
end

fn gd_run_quorum r1 view uchar * r2 view uchar * r3 view uchar * to ulong
  gd_av_reset
  gd_av_push_scr gd_f_bin1
  gd_av_push_txt gd_c_vq
  gd_av_push_scr r1
  gd_av_push_scr r2
  gd_av_push_scr r3
  ret gd_spawn_stdio false gd_f_out gd_f_err
end

fn gd_run_quorum_bin2 r1 view uchar * r2 view uchar * r3 view uchar * to ulong
  gd_av_reset
  gd_av_push_scr gd_f_bin2
  gd_av_push_txt gd_c_vq
  gd_av_push_scr r1
  gd_av_push_scr r2
  gd_av_push_scr r3
  ret gd_spawn_stdio false gd_f_out gd_f_err
end

fn gd_record_neg id view uchar * got ulong want ulong to bool
  if ne got want
    ret false
  end
  put gd_neg 0 add get gd_neg 0 1
  gd_wrt 1 gd_k_pfx
  gd_num 1 get gd_neg 0
  gd_wrt 1 gd_k_mid
  gd_wrt 1 id
  gd_wrt 1 gd_k_rc
  gd_num 1 got
  gd_wrt 1 gd_nl
  ret true
end

fn gd_test_t1_t2_t3 to ulong
  if not gd_build_units
    ret 10
  end
  if ne gd_compile_pin gd_f_unit gd_f_bin1 0
    ret 11
  end
  if ne gd_compile_pin gd_f_unit gd_f_bin2 0
    ret 12
  end
  if or not gd_sha_scr gd_f_bin1 false not gd_sha_scr gd_f_bin2 true
    ret 13
  end
  if not gd_sha_eq
    ret 14
  end
  gd_wrt 1 gd_t1a
  gd_wrhex 1 0
  if ne gd_compile_pin gd_f_munit gd_f_mbin1 0
    ret 15
  end
  if ne gd_compile_pin gd_f_munit gd_f_mbin2 0
    ret 16
  end
  if or not gd_sha_scr gd_f_mbin1 false not gd_sha_scr gd_f_mbin2 true
    ret 17
  end
  if not gd_sha_eq
    ret 18
  end
  if not gd_check_macho_magic gd_f_mbin1
    ret 19
  end
  gd_wrt 1 gd_t1b
  gd_wrhex 1 0
  gd_wrt 1 gd_nl
  put gd_chk 0 add get gd_chk 0 2

  gd_av_reset
  gd_av_push_scr gd_f_bin1
  gd_av_push_txt gd_c_emit
  gd_av_push_scr gd_f_pay
  if ne gd_spawn_stdio false gd_f_out gd_f_err 0
    ret 20
  end
  gd_av_reset
  gd_av_push_scr gd_f_bin1
  gd_av_push_txt gd_c_emit
  gd_av_push_scr gd_f_pmac
  gd_av_push_txt gd_fl_mac
  if ne gd_spawn_stdio false gd_f_out gd_f_err 0
    ret 21
  end
  if ne gd_compile_pin gd_f_pay gd_f_pelf1 0
    ret 22
  end
  if ne gd_compile_pin gd_f_pay gd_f_pelf2 0
    ret 23
  end
  if or not gd_sha_scr gd_f_pelf1 false not gd_sha_scr gd_f_pelf2 true
    ret 24
  end
  if not gd_sha_eq
    ret 25
  end
  if ne gd_compile_pin gd_f_pmac gd_f_pmac1 0
    ret 26
  end
  if ne gd_compile_pin gd_f_pmac gd_f_pmac2 0
    ret 27
  end
  if or not gd_sha_scr gd_f_pmac1 false not gd_sha_scr gd_f_pmac2 true
    ret 28
  end
  if not gd_sha_eq
    ret 29
  end
  if not gd_check_macho_magic gd_f_pmac1
    ret 30
  end
  gd_av_reset
  gd_av_push_scr gd_f_pelf1
  if ne gd_spawn_stdio false gd_f_xout gd_f_err 53
    ret 31
  end
  if not gd_out_has gd_f_xout gd_exp_pay
    ret 32
  end
  gd_wrt 1 gd_t2
  put gd_chk 0 add get gd_chk 0 2

  gd_att_begin gd_s_1 gd_s_abi1 gd_f_pay
  gd_att_mid gd_f_pmac1 gd_f_pelf1 gd_f_xout
  if ne gd_att_finish gd_s_53 gd_f_r1 0
    ret 33
  end
  gd_att_begin gd_s_2 gd_s_abi2 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_finish gd_s_53 gd_f_r2 0
    ret 34
  end
  gd_att_begin gd_s_3 gd_s_abi3 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_finish gd_s_53 gd_f_r3 0
    ret 35
  end
  if ne gd_run_quorum_bin2 gd_f_r1 gd_f_r2 gd_f_r3 0
    ret 36
  end
  if not gd_out_has gd_f_out gd_exp_q
    ret 37
  end
  gd_av_reset
  gd_av_push_scr gd_f_bin2
  gd_av_push_txt gd_c_st
  if ne gd_spawn_stdio false gd_f_out gd_f_err 0
    ret 38
  end
  gd_wrt 1 gd_t3
  put gd_chk 0 add get gd_chk 0 2
  ret 0
end

fn gd_test_neg_thompson to ulong
  if not gd_patch_trojan_omc
    ret 40
  end
  if ne gd_compile_pin gd_f_tromc_s gd_f_tromc 0
    ret 41
  end
  if ne gd_compile_scr gd_f_tromc gd_f_pay gd_f_ptroj 0
    ret 42
  end
  gd_av_reset
  gd_av_push_scr gd_f_ptroj
  if ne gd_spawn_stdio false gd_f_out gd_f_err 53
    ret 43
  end
  gd_att_begin gd_s_2 gd_s_abi2 gd_f_pay
  gd_att_mid_self gd_f_ptroj gd_f_xout
  if ne gd_att_finish gd_s_53 gd_f_r2kt1 0
    ret 44
  end
  rc = gd_run_quorum gd_f_r1 gd_f_r2kt1 gd_f_r3
  if not gd_record_neg gd_n_1 rc 109
    ret 45
  end

  if not gd_patch_payload_r54
    ret 46
  end
  if ne gd_compile_pin gd_f_pmut gd_f_pmutb 0
    ret 47
  end
  gd_av_reset
  gd_av_push_scr gd_f_pmutb
  if ne gd_spawn_stdio false gd_f_xmout gd_f_err 54
    ret 48
  end
  gd_att_begin gd_s_3 gd_s_abi3 gd_f_pay
  gd_att_mid gd_f_pmutb gd_f_pelf1 gd_f_xmout
  if ne gd_att_finish gd_s_54 gd_f_r3kt2 0
    ret 49
  end
  rc2 = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3kt2
  if not gd_record_neg gd_n_2 rc2 110
    ret 50
  end

  if not gd_copy_scr gd_f_xout gd_f_xtamp
    ret 51
  end
  if not gd_flip_byte gd_f_xtamp 12
    ret 52
  end
  gd_att_begin gd_s_3 gd_s_abi3 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xtamp
  if ne gd_att_finish gd_s_53 gd_f_r3kt3 0
    ret 53
  end
  rc3 = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3kt3
  if not gd_record_neg gd_n_3 rc3 110
    ret 54
  end
  ret 0
end

fn gd_test_neg_sybil_crypto to ulong
  gd_att_begin gd_s_1 gd_s_abi1 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_tag_finish gd_s_sybil true gd_f_r1s 0
    ret 60
  end
  gd_att_begin gd_s_2 gd_s_abi2 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_tag_finish gd_s_sybil true gd_f_r2s 0
    ret 61
  end
  rc4 = gd_run_quorum gd_f_r1s gd_f_r2s gd_f_r3
  if not gd_record_neg gd_n_4 rc4 106
    ret 62
  end

  gd_att_begin gd_s_1 gd_s_abi1 gd_f_pay
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_tag_finish gd_s_alt false gd_f_r1a 0
    ret 63
  end
  rc5 = gd_run_quorum gd_f_r1 gd_f_r1a gd_f_r3
  if not gd_record_neg gd_n_5 rc5 107
    ret 64
  end

  if not gd_copy_scr gd_f_r2 gd_f_r2sig
    ret 65
  end
  if not gd_flip_byte gd_f_r2sig 290
    ret 66
  end
  rc6 = gd_run_quorum gd_f_r1 gd_f_r2sig gd_f_r3
  if not gd_record_neg gd_n_6 rc6 104
    ret 67
  end

  if not gd_copy_scr gd_f_r1 gd_f_r1bdy
    ret 68
  end
  if not gd_flip_byte gd_f_r1bdy 42
    ret 69
  end
  rc7 = gd_run_quorum gd_f_r1bdy gd_f_r2 gd_f_r3
  if not gd_record_neg gd_n_7 rc7 104
    ret 70
  end

  if not gd_copy_scr gd_f_r2 gd_f_r2sem
    ret 71
  end
  if not gd_flip_byte gd_f_r2sem 194
    ret 72
  end
  rc8 = gd_run_quorum gd_f_r1 gd_f_r2sem gd_f_r3
  if not gd_record_neg gd_n_8 rc8 105
    ret 73
  end
  ret 0
end

fn gd_test_neg_format_source to ulong
  if not gd_copy_scr gd_f_r2 gd_f_r2dom
    ret 80
  end
  if not gd_flip_byte gd_f_r2dom 12
    ret 81
  end
  rc9 = gd_run_quorum gd_f_r1 gd_f_r2dom gd_f_r3
  if not gd_record_neg gd_n_9 rc9 103
    ret 82
  end

  if not gd_copy_scr gd_f_r3 gd_f_r3mag
    ret 83
  end
  if not gd_set_byte gd_f_r3mag 0 88
    ret 84
  end
  rc10 = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3mag
  if not gd_record_neg gd_n_10 rc10 102
    ret 85
  end

  if not gd_copy_scr gd_f_r3 gd_f_r3trn
    ret 86
  end
  if not gd_write_trunc gd_f_r3trn 1
    ret 87
  end
  rc11a = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3trn
  if not gd_record_neg gd_n_11a rc11a 102
    ret 88
  end

  if not gd_copy_scr gd_f_r3 gd_f_r3trl
    ret 89
  end
  if not gd_append_byte gd_f_r3trl 0
    ret 90
  end
  rc11b = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3trl
  if not gd_record_neg gd_n_11b rc11b 102
    ret 91
  end

  gd_att_begin gd_s_3 gd_s_abi3 gd_f_pmut
  gd_att_mid_self gd_f_pelf1 gd_f_xout
  if ne gd_att_finish gd_s_53 gd_f_r3src 0
    ret 92
  end
  rc12 = gd_run_quorum gd_f_r1 gd_f_r2 gd_f_r3src
  if not gd_record_neg gd_n_12 rc12 108
    ret 93
  end
  ret 0
end

fn main to int
  gd_init_args
  put gd_chk 0 0
  put gd_neg 0 0
  gd_wrt 1 gd_hdr
  r1 = gd_test_t1_t2_t3
  if ne r1 0
    ret gd_fail 1 r1
  end
  r2 = gd_test_neg_thompson
  if ne r2 0
    ret gd_fail 2 r2
  end
  r3 = gd_test_neg_sybil_crypto
  if ne r3 0
    ret gd_fail 3 r3
  end
  r4 = gd_test_neg_format_source
  if ne r4 0
    ret gd_fail 4 r4
  end
  gd_wrt 1 gd_pass_a
  gd_num 1 get gd_chk 0
  gd_wrt 1 gd_pass_b
  gd_num 1 get gd_neg 0
  gd_wrt 1 gd_pass_c
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/helix/hx_dec_ext.om: Helix SM121 decoder extension over gpu/nvidia/om/codegen/bw_hazard.om.
note Preserves bw_hazard.om 100% untouched (zero impact on bwhz.tsv / mutants.tsv / arboris gates)
note while adding om_synth_gb10.om's 5 extended SM121 opcodes + 64-bit ISETP register pairs:
note   - op 2064 (0x810): IADD3 imm (nm=17, var=0, late=0)
note   - op  565 (0x235): IADD64/ISUB64 reg pair (nm=17, var=0, late=0)
note   - op 2101 (0x835): IADD64 imm pair (nm=17, var=0, late=0)
note   - op  549 (0x225): IMAD.WIDE reg pair (nm=14, var=0, late=0)
note   - op  937 (0x3a9): ATOMG.E.CAS.64.STRONG.GPU (nm=35, var=1, late=1)
note   - op  524 / 2060 with w2 bit 16 (0x10000): 64-bit ISETP register pairs (nm=16, var=0, late=0)

fn hx_dec_sm121 c view uchar 16 d edit ulong 24 to long
r = hz_dec1 c d
w0 = hz_rd32 c 0
w1 = hz_rd32 c 4
w2 = hz_rd32 c 8
op = and w0 4095
if eq r 0
if and or eq op 524 eq op 2060 ne and w2 65536 0
put d 9 0
ra = shr w0 24
hz_r d 0 ra 2 0
if eq op 524
hz_r d 0 and w1 255 2 0
end
end
ret long 0
end
if or eq get d 4 6 eq get d 5 6
ret long -1
end
rd = and shr w0 16 255
ra = shr w0 24
rb2 = and w1 255
rc = and w2 255
if eq op 2064
hz_w d 0 rd 1 0
hz_r d 0 ra 1 0
hz_r d 0 rc 1 0
hz_nm d 0 17 0 0
ret long 0
end
if eq op 565
hz_w d 0 rd 2 0
hz_r d 0 ra 2 0
hz_r d 0 rb2 2 0
hz_nm d 0 17 0 0
ret long 0
end
if eq op 2101
hz_w d 0 rd 2 0
hz_r d 0 ra 2 0
hz_nm d 0 17 0 0
ret long 0
end
if eq op 549
hz_w d 0 rd 2 0
hz_r d 0 ra 1 0
hz_r d 0 rb2 1 0
hz_r d 0 rc 2 0
hz_nm d 0 14 0 0
ret long 0
end
if eq op 937
hz_w d 0 rd 2 0
hz_r d 0 ra 2 0
hz_r d 0 rb2 2 0
hz_r d 0 rc 2 0
hz_nm d 0 35 1 1
ret long 0
end
ret long -1
end

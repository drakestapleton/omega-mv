note SPDX-License-Identifier: Apache-2.0
note seed/helix/extract_q36_kernels.om: Extracts real production SM121 SASS binaries
note directly from om/gpu/q36/emit_fast.om so Strand B Predator + Strand A Monk +
note 11-Antibody Immune System verify production Qwen 3.6 35B GB10 kernels!
note Compose after:
note   om/encoder/bw_enc_sm121.om
note   om/gpu/q36/emit_fast.om
note
note Usage: extract_q36_kernels MODE_CHAR OUT_BIN
note   Examples: 'e' (swiglu8_q36_fast), 'f' (moe_combine_rms_fast), 'a' (bf16_gemv_fast), 'j' (w4_lmhead_screen_fast)

global exOut uchar 32768
global exLen ulong 1
global exPath uchar 1024
global exMode uchar 4

text exUse "usage: extract_q36_kernels MODE_CHAR OUT_BIN\n"
text exOk "EXTRACTED q36_kernel mode="
text exBy " bytes="
text exIn " insns="
text exNl "\n"

fn q36Write w view ulong 4 to void
end

fn exDumpBuf cnt ulong to ulong
for pc ulong cnt bound 2048
for k ulong 4
exWd = get q36Buf add mul pc 4 k
base = add mul pc 16 mul k 4
put exOut base uchar and exWd 255
put exOut add base 1 uchar and shr exWd 8 255
put exOut add base 2 uchar and shr exWd 16 255
put exOut add base 3 uchar and shr exWd 24 255
end
end
ret mul cnt 16
end

fn exNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn main to int
if ne argcnt 3
r = write 1 exUse 0 len exUse
ret 90
end
m = argread 1 exMode 0 4
k = argread 2 exPath 0 1023
if or lt m 1 lt k 1
ret 90
end
put exLen 0 0
put q36Pc 0 0
put q36Guard 0 0
if not q36Kernel get exMode 0
ret 2
end
cnt = get q36Pc 0
if or eq cnt 0 gt cnt 2048
ret 2
end
n = exDumpBuf cnt
fd = fopen exPath 0 ulong k 577 420
if lt fd 0
ret 3
end
w = write int fd exOut 0 n
z = fclose int fd
if ne w long n
ret 3
end
r = write 1 exOk 0 len exOk
r = write 1 exMode 0 1
r = write 1 exBy 0 len exBy
exNum n
r = write 1 exIn 0 len exIn
exNum div n 16
r = write 1 exNl 0 len exNl
ret 0
end

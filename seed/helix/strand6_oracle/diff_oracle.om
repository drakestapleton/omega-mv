om2
note SPDX-License-Identifier: Apache-2.0
note seed/helix/strand6_oracle/diff_oracle.om
note Strand F ("The Differential Oracle"): pure seeded OM-2 differential oracle driver.
note Braids ngrand, ngcheck, ngrun, ng (@ng a64 unopt, @ng opt -> @ng a64 opt, @ng front-ir),
note ngas, and omc across random ΩIR seeds AND source run-pairs (seed/ng/tests/ir/x-*.om/.oir),
note with automatic ngrand shrinking on divergence and a self-verifying --neg-control mode.
note
note Usage:
note   diff_oracle run WORKDIR OMC START COUNT
note   diff_oracle --neg-control WORKDIR SEED
note   diff_oracle --check-ir WORKDIR IRFILE
note   diff_oracle --neg-pred WORKDIR IRFILE

global workdir uchar 4096
global worklen ulong 1
global omcpath uchar 4096
global omclen ulong 1
global selfpath uchar 4096
global selflen ulong 1
global hasngb ulong 1

global pbuf uchar 8192
global plen ulong 1
global pbuf2 uchar 8192
global plen2 ulong 1
global abuf uchar 16384
global ast ulong 2
global stbuf uchar 4
global obuf uchar 65536
global opos ulong 1
global nbuf uchar 32
global argtmp uchar 4096

global io1 uchar 4194304
global io2 uchar 4194304
global io3 uchar 4194304
global iolen ulong 4

note st slots:
note   0 seeds_run, 1 normal(0..63), 2 explicit(64..95), 3 trap(101..114), 4 seed_divs,
note   5 pairs_run, 6 pair_divs, 7 rc1, 8 rc2, 9 rc3, 10 ng_unopt_ok, 11 ng_opt_ok,
note   12 start_seed, 13 count
global st ulong 16

text t_run "run"
text t_negctl "--neg-control"
text t_chkir "--check-ir"
text t_negprd "--neg-pred"
text t_use "usage: diff_oracle run WORKDIR OMC START COUNT | --neg-control WORKDIR SEED | --check-ir WORKDIR IR | --neg-pred WORKDIR IR\n"
text t_acc "ACCEPT "
text t_dn "/dev/null"
text t_stp "10000000"
text t_shr "shrink"
text t_tape "tape"
text t_s42 "42"
text t_tpx ".tape"
text t_om ".om"
text t_oir ".oir"
text t_irbase "seed/ng/tests/ir/"

note mode prefixes for ng
text t_ma64 "@ng a64\n"
text t_mopt "@ng opt\n"
text t_mfir "@ng front-ir\n"

note tool & scratch suffixes (newline-delimited table)
note 0:/ngrand 1:/ngcheck 2:/ngrun 3:/ng 4:/ng_b 5:/ngas
note 6:/u.ir 7:/chk.out 8:/e1.out 9:/e2.in 10:/e2.elf 11:/e2.out
note 12:/opt.in 13:/u_opt.ir 14:/e3.in 15:/e3.elf 16:/e3.out 17:/err.txt
note 18:/p_omc.elf 19:/p_front.ir 20:/p_opt.ir 21:/p_ng.elf 22:/p_oir.ir
note 23:/ck_e1.out 24:/ck_e2.in 25:/ck_e2.elf 26:/ck_e2.out
note 27:/ck_opt.in 28:/ck_opt.ir 29:/ck_e3.in 30:/ck_e3.elf 31:/ck_e3.out
note 32:/ck_chk.out 33:/ck_err.txt
note 34:/np_e1.out 35:/np_e2.in 36:/np_e2.elf 37:/np_e2.out 38:/np_err.txt
note 39:/neg_orig.ir 40:/neg_min.ir 41:/neg_replay.ir 42:/neg_chk.out 43:/neg_sh.out 44:/neg_err.txt
note 45:/shrunk.ir
text t_sfx "/ngrand\n/ngcheck\n/ngrun\n/ng\n/ng_b\n/ngas\n/u.ir\n/chk.out\n/e1.out\n/e2.in\n/e2.elf\n/e2.out\n/opt.in\n/u_opt.ir\n/e3.in\n/e3.elf\n/e3.out\n/err.txt\n/p_omc.elf\n/p_front.ir\n/p_opt.ir\n/p_ng.elf\n/p_oir.ir\n/ck_e1.out\n/ck_e2.in\n/ck_e2.elf\n/ck_e2.out\n/ck_opt.in\n/ck_opt.ir\n/ck_e3.in\n/ck_e3.elf\n/ck_e3.out\n/ck_chk.out\n/ck_err.txt\n/np_e1.out\n/np_e2.in\n/np_e2.elf\n/np_e2.out\n/np_err.txt\n/neg_orig.ir\n/neg_min.ir\n/neg_replay.ir\n/neg_chk.out\n/neg_sh.out\n/neg_err.txt\n/shrunk.ir\n"

text t_pairs "x-bits\nx-conv\nx-divmin\nx-fib\nx-fuel\nx-fuelok\nx-hello\nx-i8\nx-index\nx-indexok\nx-ovf64\nx-ovf64ok\nx-remmin\nx-shift\nx-float\n"
const npairs ulong 15

text m_ok_run "DIFF_ORACLE PASS seeds="
text m_fl_run "DIFF_ORACLE FAIL seeds="
text m_norm " normal="
text m_expl " exit="
text m_trap " trap="
text m_sdiv " seed_div="
text m_pair " pairs="
text m_pdiv " pair_div="
text m_ngb " ng_b="
text m_ms " ms="
text m_div_s "DIVERGENCE seed="
text m_div_p "DIVERGENCE pair="
text m_rc1 " rc1="
text m_rc2 " rc2="
text m_rc3 " rc3="
text m_nc_ok "NEG_CONTROL PASS seed="
text m_nc_fl "NEG_CONTROL FAIL step="
text m_orig " orig_bytes="
text m_minb " min_bytes="
text m_rep " replay=exact"
text m_shr_go "SHRINK seed="

note ---- buffered stdout output ----
fn oput b ulong to void
n = get opos 0
if lt n len obuf
put obuf n uchar b
put opos 0 add n 1
end
end

fn oflush to void
n = get opos 0
p = ulong 0
while lt p n bound 65536
k = write 1 obuf p sub n p
if le k 0
p = n
else
p = add p ulong k
end
end
put opos 0 0
end

fn ostr s view uchar * to void
for i ulong len s bound 4096
oput ulong get s i
end
end

fn onum v ulong to void
x = v
n = ulong 0
while true bound 24
put nbuf n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
while gt n 0 bound 24
n = sub n 1
oput ulong get nbuf n
end
end

fn onl to void
oput 10
oflush
end

note ---- path builders (pbuf / pbuf2) ----
fn pclr to void
put plen 0 0
end

fn pc b ulong to void
n = get plen 0
if lt n len pbuf
put pbuf n uchar b
put plen 0 add n 1
end
end

fn pstr s view uchar * to void
for i ulong len s bound 4096
pc ulong get s i
end
end

fn pwork to void
pclr
n = get worklen 0
for i ulong n bound 4096
pc ulong get workdir i
end
end

fn psfx k ulong to void
pwork
i = ulong 0
ln = ulong 0
while and lt i len t_sfx lt ln k bound 8192
if eq get t_sfx i 10
ln = add ln 1
end
i = add i 1
end
while lt i len t_sfx bound 256
c = get t_sfx i
if eq c 10
ret
end
pc ulong c
i = add i 1
end
end

fn pself to void
pclr
n = get selflen 0
for i ulong n bound 4096
pc ulong get selfpath i
end
end

fn pomc to void
pclr
n = get omclen 0
for i ulong n bound 4096
pc ulong get omcpath i
end
end

fn ppair k ulong ext view uchar * to void
pclr
pstr t_irbase
i = ulong 0
ln = ulong 0
while and lt i len t_pairs lt ln k bound 4096
if eq get t_pairs i 10
ln = add ln 1
end
i = add i 1
end
while lt i len t_pairs bound 256
c = get t_pairs i
if eq c 10
break
end
pc ulong c
i = add i 1
end
pstr ext
end

fn opairname k ulong to void
i = ulong 0
ln = ulong 0
while and lt i len t_pairs lt ln k bound 4096
if eq get t_pairs i 10
ln = add ln 1
end
i = add i 1
end
while lt i len t_pairs bound 256
c = get t_pairs i
if eq c 10
ret
end
oput ulong c
i = add i 1
end
end

fn pbuf_to_p2 to void
n = get plen 0
for i ulong n bound 8192
put pbuf2 i get pbuf i
end
put plen2 0 n
end

fn p2_to_pbuf to void
n = get plen2 0
for i ulong n bound 8192
put pbuf i get pbuf2 i
end
put plen 0 n
end

note ---- file helpers ----
fn open_r to int
r = fopen pbuf 0 get plen 0 524288 0
if lt r 0
ret -1
end
ret int r
end

fn open_w to int
r = fopen pbuf 0 get plen 0 524865 420
if lt r 0
ret -1
end
ret int r
end

fn open_nul to int
r = fopen t_dn 0 len t_dn 524290 0
if lt r 0
ret -1
end
ret int r
end

fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end

fn unl_p to void
r = unlink pbuf 0 get plen 0
end

fn chmod_x to bool
r = chmod pbuf 0 get plen 0 493
ret eq r 0
end

note read file at pbuf into io1 (slot 0), io2 (slot 1), or io3 (slot 2), starting at offset off
fn slurp slot ulong off ulong to bool
fd = open_r
if lt fd 0
ret false
end
n = off
ok = true
while true bound 4194306
x = long 0
if eq slot 0
x = read fd io1 n sub len io1 n
else
if eq slot 1
x = read fd io2 n sub len io2 n
else
x = read fd io3 n sub len io3 n
end
end
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len io1
ok = false
break
end
end
fclo fd
put iolen slot sub n off
ret ok
end

fn spill1 n ulong to bool
fd = open_w
if lt fd 0
ret false
end
o = ulong 0
while lt o n bound 4194306
x = write fd io1 o sub n o
if le x 0
fclo fd
ret false
end
o = add o ulong x
end
fclo fd
ret true
end

fn same_12 to bool
n = get iolen 0
if ne n get iolen 1
ret false
end
for i ulong n bound 4194304
if ne get io1 i get io2 i
ret false
end
end
ret true
end

fn same_13 to bool
n = get iolen 0
if ne n get iolen 2
ret false
end
for i ulong n bound 4194304
if ne get io1 i get io3 i
ret false
end
end
ret true
end

fn prep_in mode ulong src_is_p2 bool dst_sfx ulong to bool
plen_m = len t_ma64
if eq mode 1
plen_m = len t_mopt
end
if eq mode 2
plen_m = len t_mfir
end
if src_is_p2
p2_to_pbuf
end
if not slurp 0 plen_m
ret false
end
if eq mode 0
for i ulong len t_ma64 bound 32
put io1 i get t_ma64 i
end
end
if eq mode 1
for i ulong len t_mopt bound 32
put io1 i get t_mopt i
end
end
if eq mode 2
for i ulong len t_mfir bound 32
put io1 i get t_mfir i
end
end
tot = add plen_m get iolen 0
psfx dst_sfx
ret spill1 tot
end

note ---- argv packing & process spawn ----
fn aclr to void
put ast 0 2
put ast 1 0
end

fn aend n ulong to void
p = get ast 0
put abuf p uchar and n 255
put abuf add p 1 uchar shr n 8
put ast 0 add p add n 2
c = add get ast 1 1
put ast 1 c
put abuf 0 uchar and c 255
put abuf 1 uchar shr c 8
end

fn apbuf to void
p = add get ast 0 2
n = get plen 0
for i ulong n bound 8192
put abuf add p i get pbuf i
end
aend n
end

fn astr s view uchar * to void
pclr
pstr s
apbuf
end

fn anum v ulong to void
x = v
n = ulong 0
while true bound 24
put nbuf n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
pclr
while gt n 0 bound 24
n = sub n 1
pc ulong get nbuf n
end
apbuf
end

fn redir s int d int to void
if ne s d
if ne dupfd s d 0 long d
exit 127
end
end
end

fn reap pid long to ulong
t0 = monons
while true bound 1000000
r = waitpid int pid stbuf 0 len stbuf 1
if eq r pid
sg = and ulong get stbuf 0 127
if ne sg 0
ret add 256 sg
end
ret ulong get stbuf 1
end
if ne r 0
ret 512
end
if gt sub monons t0 30000000000
k = killpid int pid 9
end
s = sleepns 200000
end
ret 512
end

fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
fclo fi
fclo fo
fclo fe
ret 512
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog abuf 0 get ast 0
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap pid
end

note ---- tool invocation wrappers ----
fn ng_sfx to ulong
if ne get hasngb 0 0
ret 4
end
ret 3
end

note run ngcheck on IR at pbuf2, output to chk_sfx; true iff exit 0 and starts with "ACCEPT "
fn run_ngcheck chk_sfx ulong err_sfx ulong to bool
p2_to_pbuf
fi = open_r
aclr
psfx 1
apbuf
psfx chk_sfx
fo = open_w
psfx err_sfx
fe = open_w
rc = spawn fi fo fe
if ne rc 0
ret false
end
psfx chk_sfx
if not slurp 0 0
ret false
end
if lt get iolen 0 len t_acc
ret false
end
for i ulong len t_acc bound 16
if ne get io1 i get t_acc i
ret false
end
end
ret true
end

note run ngrun on IR at pbuf2 -> out_sfx, err_sfx; returns exit status
fn run_ngrun out_sfx ulong err_sfx ulong to ulong
fi = open_nul
aclr
psfx 2
apbuf
p2_to_pbuf
apbuf
astr t_stp
psfx out_sfx
fo = open_w
psfx err_sfx
fe = open_w
ret spawn fi fo fe
end

note compile IR at pbuf2 with ng tool (tool_sfx: 3=ng, 4=ng_b) @ng a64 -> elf_sfx, run -> out_sfx
fn run_ng_a64 tool_sfx ulong in_sfx ulong elf_sfx ulong out_sfx ulong err_sfx ulong to ulong
if not prep_in 0 true in_sfx
ret 513
end
psfx elf_sfx
unl_p
psfx in_sfx
fi = open_r
aclr
psfx tool_sfx
apbuf
psfx elf_sfx
fo = open_w
psfx err_sfx
fe = open_w
rc = spawn fi fo fe
if ne rc 0
ret add 600 rc
end
psfx elf_sfx
if not chmod_x
ret 514
end
fi2 = open_nul
aclr
psfx elf_sfx
apbuf
psfx out_sfx
fo2 = open_w
psfx err_sfx
fe2 = open_w
ret spawn fi2 fo2 fe2
end

note optimize IR at pbuf2 with ng (@ng opt) -> opt_ir_sfx, verify with ngcheck
fn run_ng_opt tool_sfx ulong in_sfx ulong opt_sfx ulong chk_sfx ulong err_sfx ulong to bool
if not prep_in 1 true in_sfx
ret false
end
psfx in_sfx
fi = open_r
aclr
psfx tool_sfx
apbuf
psfx opt_sfx
fo = open_w
psfx err_sfx
fe = open_w
rc = spawn fi fo fe
if ne rc 0
ret false
end
psfx opt_sfx
pbuf_to_p2
ret run_ngcheck chk_sfx err_sfx
end

note check IR file (path already in pbuf2) across all 3 engines:
note   Engine 1: ngrun
note   Engine 2: ng (@ng a64 unopt)
note   Engine 3: ng/ng_b (@ng opt -> ngcheck -> @ng a64)
note uses scratch slots base (parent mode vs child --check-ir mode)
fn check_ir_3 child bool to bool
off = ulong 0
cko = ulong 7
ero = ulong 17
if child
off = 15
cko = 32
ero = 33
end
note Engine 1: ngrun
rc1 = run_ngrun add 8 off ero
put st 7 rc1
if ge rc1 124
ret false
end
if and ge rc1 96 lt rc1 101
ret false
end
note Engine 2: ng_unopt (@ng a64)
rc2 = run_ng_a64 3 add 9 off add 10 off add 11 off ero
put st 8 rc2
note Engine 3: ng_opt (@ng opt -> ngcheck -> @ng a64 via ng_b if present else ng)
t3 = ng_sfx
if not run_ng_opt t3 add 12 off add 13 off cko ero
put st 9 515
ret false
end
psfx add 13 off
pbuf_to_p2
rc3 = run_ng_a64 t3 add 14 off add 15 off add 16 off ero
put st 9 rc3
if or ne rc1 rc2 ne rc1 rc3
ret false
end
psfx add 8 off
if not slurp 0 0
ret false
end
psfx add 11 off
if not slurp 1 0
ret false
end
psfx add 16 off
if not slurp 2 0
ret false
end
if not same_12
ret false
end
ret same_13
end

note ---- shrink helper ----
fn invoke_shrink seed ulong pred_flag view uchar * out_sfx ulong sh_out_sfx ulong err_sfx ulong to ulong
fi = open_nul
aclr
psfx 0
apbuf
astr t_shr
anum seed
astr t_s42
psfx out_sfx
apbuf
pself
apbuf
astr pred_flag
pwork
apbuf
psfx sh_out_sfx
fo = open_w
psfx err_sfx
fe = open_w
ret spawn fi fo fe
end

note ---- Phase A: random seeds ----
fn run_one_seed seed ulong to void
note 1. ngrand seed -> u.ir
fi = open_nul
aclr
psfx 0
apbuf
anum seed
psfx 6
fo = open_w
psfx 17
fe = open_w
rc = spawn fi fo fe
if ne rc 0
put st 4 add get st 4 1
ostr m_div_s
onum seed
onl
ret
end
note 2. ngcheck u.ir
psfx 6
pbuf_to_p2
if not run_ngcheck 7 17
put st 4 add get st 4 1
ostr m_div_s
onum seed
onl
ret
end
note 3. run 3 engines on u.ir
psfx 6
pbuf_to_p2
ok = check_ir_3 false
put st 0 add get st 0 1
if not ok
put st 4 add get st 4 1
ostr m_div_s
onum seed
ostr m_rc1
onum get st 7
ostr m_rc2
onum get st 8
ostr m_rc3
onum get st 9
onl
ostr m_shr_go
onum seed
onl
sr = invoke_shrink seed t_chkir 45 43 17
ret
end
r1 = get st 7
if lt r1 64
put st 1 add get st 1 1
else
if lt r1 96
put st 2 add get st 2 1
else
put st 3 add get st 3 1
end
end
end

note ---- Phase B: source run-pairs (omc_A vs ng_B vs ngrun) ----
fn pair_run_omc idx ulong to ulong
psfx 18
unl_p
ppair idx t_om
fi = open_r
aclr
pomc
apbuf
psfx 18
fo = open_w
psfx 17
fe = open_w
bc = spawn fi fo fe
if ne bc 0
ret add 600 bc
end
psfx 18
if not chmod_x
ret 514
end
fi = open_nul
aclr
psfx 18
apbuf
psfx 8
fo = open_w
psfx 17
fe = open_w
ret spawn fi fo fe
end

fn pair_run_ng idx ulong to ulong
tng = ng_sfx
ppair idx t_om
pbuf_to_p2
if not prep_in 2 true 9
ret 513
end
psfx 9
fi = open_r
aclr
psfx tng
apbuf
psfx 19
fo = open_w
psfx 17
fe = open_w
bc = spawn fi fo fe
if ne bc 0
ret add 700 bc
end
psfx 19
pbuf_to_p2
if not run_ngcheck 7 17
ret 515
end
if not run_ng_opt tng 12 20 7 17
ret 516
end
psfx 20
pbuf_to_p2
ret run_ng_a64 tng 14 21 11 17
end

fn pair_run_ngrun idx ulong to ulong
ppair idx t_oir
fi = open_r
aclr
psfx 5
apbuf
psfx 22
fo = open_w
psfx 17
fe = open_w
bc = spawn fi fo fe
if ne bc 0
ret add 800 bc
end
psfx 22
pbuf_to_p2
if not run_ngcheck 7 17
ret 517
end
ret run_ngrun 16 17
end

fn run_one_pair idx ulong to void
put st 5 add get st 5 1
rc1 = pair_run_omc idx
put st 7 rc1
rc2 = pair_run_ng idx
put st 8 rc2
rc3 = pair_run_ngrun idx
put st 9 rc3
ok = and eq rc1 rc2 eq rc1 rc3
if ok
psfx 8
if not slurp 0 0
ok = false
end
end
if ok
psfx 11
if not slurp 1 0
ok = false
end
end
if ok
psfx 16
if not slurp 2 0
ok = false
end
end
if ok
ok = and same_12 same_13
end
if not ok
put st 6 add get st 6 1
ostr m_div_p
opairname idx
ostr m_rc1
onum rc1
ostr m_rc2
onum rc2
ostr m_rc3
onum rc3
onl
end
end

note ---- Negative-control predicate (--neg-pred WORKDIR IRFILE) ----
note Deliberately injects a simulated Engine 2 divergence whenever Engine 2 exits 103 (trap 3),
note flipping observed exit2 from 103 -> 102 so ngrand shrink minimizes a real trapping IR unit.
fn do_neg_pred to int
rc1 = run_ngrun 34 38
rc2 = run_ng_a64 3 35 36 37 38
if eq rc2 103
rc2 = xor rc2 1
end
if ne rc1 rc2
ret 42
end
psfx 34
if not slurp 0 0
ret 42
end
psfx 37
if not slurp 1 0
ret 42
end
if not same_12
ret 42
end
ret 0
end

note ---- Negative-control driver (--neg-control WORKDIR SEED) ----
fn fail_nc step ulong to int
ostr m_nc_fl
onum step
onl
ret 1
end

fn do_neg_control seed ulong to int
note 1. Generate original IR for seed -> neg_orig.ir
fi = open_nul
aclr
psfx 0
apbuf
anum seed
psfx 39
fo = open_w
psfx 44
fe = open_w
if ne spawn fi fo fe 0
ret fail_nc 1
end
psfx 39
if not slurp 0 0
ret fail_nc 2
end
orig_sz = get iolen 0

note 2. Confirm planted predicate triggers (exit 42) on original IR
psfx 39
pbuf_to_p2
if ne do_neg_pred 42
ret fail_nc 3
end

note 3. Invoke ngrand shrink -> neg_min.ir + neg_min.ir.tape
sr = invoke_shrink seed t_negprd 40 43 44
if ne sr 0
ret fail_nc 4
end

note 4. Verify neg_min.ir is strictly smaller than neg_orig.ir
psfx 40
if not slurp 1 0
ret fail_nc 5
end
min_sz = get iolen 1
if ge min_sz orig_sz
ret fail_nc 6
end

note 5. Verify ngcheck ACCEPTS neg_min.ir
psfx 40
pbuf_to_p2
if not run_ngcheck 42 44
ret fail_nc 7
end

note 6. Verify neg_min.ir.tape replays byte-identically to neg_min.ir
fi2 = open_nul
aclr
psfx 0
apbuf
astr t_tape
psfx 40
pstr t_tpx
apbuf
psfx 41
fo2 = open_w
psfx 44
fe2 = open_w
if ne spawn fi2 fo2 fe2 0
ret fail_nc 8
end
psfx 41
if not slurp 0 0
ret fail_nc 9
end
psfx 40
if not slurp 1 0
ret fail_nc 10
end
if not same_12
ret fail_nc 11
end

note 7. Confirm minimized IR STILL triggers planted divergence (42) AND passes real 3-engine check (0)
psfx 40
pbuf_to_p2
if ne do_neg_pred 42
ret fail_nc 12
end
psfx 40
pbuf_to_p2
if not check_ir_3 true
ret fail_nc 13
end

ostr m_nc_ok
onum seed
ostr m_orig
onum orig_sz
ostr m_minb
onum min_sz
ostr m_rep
onl
ret 0
end

note ---- CLI argument helpers ----
fn read_arg ix ulong to ulong
k = argread ix argtmp 0 sub len argtmp 1
if le k 0
ret 0
end
ret ulong k
end

fn arg_eq s view uchar * n ulong to bool
if ne n len s
ret false
end
for i ulong n bound 256
if ne get argtmp i get s i
ret false
end
end
ret true
end

fn parse_u64 n ulong to ulong
if eq n 0
exit 2
end
v = ulong 0
for i ulong n bound 64
c = ulong get argtmp i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end

fn load_self to void
n = read_arg 0
if eq n 0
exit 2
end
for i ulong n bound 4096
put selfpath i get argtmp i
end
put selflen 0 n
end

fn load_work ix ulong to void
n = read_arg ix
if eq n 0
exit 2
end
for i ulong n bound 4096
put workdir i get argtmp i
end
put worklen 0 n
psfx 4
r = faccess pbuf 0 get plen 0 1
if eq r 0
put hasngb 0 1
else
put hasngb 0 0
end
end

fn load_omc ix ulong to void
n = read_arg ix
if eq n 0
exit 2
end
for i ulong n bound 4096
put omcpath i get argtmp i
end
put omclen 0 n
end

fn load_p2 ix ulong to void
n = read_arg ix
if eq n 0
exit 2
end
for i ulong n bound 4096
put pbuf2 i get argtmp i
end
put plen2 0 n
end

fn main to int
t0 = monons
na = ulong argcnt
if lt na 4
r = write 2 t_use 0 len t_use
ret 2
end
load_self
m1 = read_arg 1

if arg_eq t_chkir m1
if ne na 4
ret 2
end
load_work 2
load_p2 3
if check_ir_3 true
ret 0
end
ret 42
end

if arg_eq t_negprd m1
if ne na 4
ret 2
end
load_work 2
load_p2 3
ret do_neg_pred
end

if arg_eq t_negctl m1
if ne na 4
ret 2
end
load_work 2
seed = parse_u64 read_arg 3
ret do_neg_control seed
end

if arg_eq t_run m1
if ne na 6
r = write 2 t_use 0 len t_use
ret 2
end
load_work 2
load_omc 3
start_s = parse_u64 read_arg 4
cnt_s = parse_u64 read_arg 5
for k ulong cnt_s bound 100000
run_one_seed add start_s k
end
for p ulong npairs bound 64
run_one_pair p
end
ms = div ulong sub monons t0 1000000
tot_div = add get st 4 get st 6
if eq tot_div 0
ostr m_ok_run
else
ostr m_fl_run
end
onum get st 0
ostr m_norm
onum get st 1
ostr m_expl
onum get st 2
ostr m_trap
onum get st 3
ostr m_sdiv
onum get st 4
ostr m_pair
onum get st 5
ostr m_pdiv
onum get st 6
ostr m_ngb
onum get hasngb 0
ostr m_ms
onum ms
onl
if eq tot_div 0
ret 0
end
ret 1
end

r = write 2 t_use 0 len t_use
ret 2
end

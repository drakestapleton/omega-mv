note SPDX-License-Identifier: Apache-2.0
note seed/helix/strand6_oracle/quant_equiv.unit.om
note Pure Omega scalar bit-unpack and quantization helper pairs for exhaustive
note equivalence checking with seed/equiv/irequiv.om (OSC IR v1).
note Compile IR: { printf 'ir\n'; cat seed/helix/strand6_oracle/quant_equiv.unit.om; } | seed/out/omc > quant_equiv.ir
note Pairs:
note   1. w4_sref / w4_sfast     (domain=256):      W4 4-bit signed nibble unpack
note   2. w4_dqref / w4_dqfast   (domain=65536):    W4 two-nibble packed byte symmetric dequant
note   3. q8_clref / q8_clfast   (domain=65536):    INT8 saturating clamp from short accumulator
note   4. fp8_uref / fp8_ufast   (domain=256):      FP8 E4M3 branchless exponent/mantissa unpack
note   5. pk24_ref / pk24_fast   (domain=16777216): 24-bit packed 2x12-bit bit-field unpack (24-bit exhaustive)
note Negative-control 1-bit mutants:
note   - w4_smut  (drops bit 0 of W4 nibble)
note   - q8_clmut (1-of-65536 single-input 1-bit mutant at x=127 -> 126)
note   - pk24_mut (1-bit mask mutant on 24-bit unpack)

note ---- 1. W4 4-bit nibble unpack + sign-extend (domain = 256) ----
fn w4_sref x uchar to byte
n = and x 15
if ge n 8
ret byte sub int n 16
end
ret byte n
end

fn w4_sfast x uchar to byte
n = int and x 15
ret byte sub xor n 8 8
end

fn w4_smut x uchar to byte
n = int and x 14
ret byte sub xor n 8 8
end

note ---- 2. W4 packed two-nibble symmetric dequant (domain = 65536) ----
fn w4_dqref p uchar sc byte to short
lo = and p 15
hi = shr p 4
a = short lo
if ge lo 8
a = sub a 16
end
b = short hi
if ge hi 8
b = sub b 16
end
ret mul add a b short sc
end

fn w4_dqfast p uchar sc byte to short
lo = xor short and p 15 8
hi = xor short shr p 4 8
s = sub add lo hi 16
ret mul s short sc
end

note ---- 3. INT8 saturating clamp (domain = 65536) ----
fn q8_clref x short to byte
if lt x -128
ret -128
end
if gt x 127
ret 127
end
ret byte x
end

fn q8_clfast x short to byte
v = int x
d1 = sub v 127
m1 = not shr d1 31
v1 = sub v and d1 m1
d2 = sub v1 -128
m2 = shr d2 31
v2 = sub v1 and d2 m2
ret byte v2
end

fn q8_clmut x short to byte
if eq x 127
ret 126
end
ret q8_clfast x
end

note ---- 4. FP8 E4M3 exponent/mantissa unpack (domain = 256) ----
fn fp8_uref x uchar to int
s = shr x 7
e = and shr x 3 15
m = int and x 7
mag = int 0
if eq e 0
mag = shl m 1
else
mag = shl add m 8 int e
end
if ne s 0
ret neg mag
end
ret mag
end

fn fp8_ufast x uchar to int
e = int and shr x 3 15
m = int and x 7
nz = shr neg e 31
imp = and 8 nz
sh = add e and 1 not nz
mag = shl add m imp sh
sm = neg int shr x 7
ret sub xor mag sm sm
end

note ---- 5. 24-bit packed bit-field unpack (domain = 16777216) ----
fn pk24_ref hi ushort lo uchar to uint
w = or shl uint hi 8 uint lo
a = and w 4095
b = shr w 12
ret add a b
end

fn pk24_fast hi ushort lo uchar to uint
a = or shl uint and hi 15 8 uint lo
b = uint shr hi 4
ret add a b
end

fn pk24_mut hi ushort lo uchar to uint
a = or shl uint and hi 14 8 uint lo
b = uint shr hi 4
ret add a b
end

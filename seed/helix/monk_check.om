note SPDX-License-Identifier: Apache-2.0
note seed/helix/monk_check.om: The Skeleton (Strand A's millisecond mathematical proof checker).
note Compose after:
note   seed/ng/sha256.om
note   gpu/nvidia/om/codegen/bw_hazard.om
note
note Usage:
note   monk_check REF_SASS CAND_SASS CERT_FILE
note
note Certificate binary format (helix-proof-v1):
note   [0..3]   magic "HXP1" (0x48, 0x58, 0x50, 0x31)
note   [4..7]   u32 LE instruction count N (1..2048)
note   [8..39]  expected SHA-256 of REF_SASS (32 bytes)
note   [40..71] expected SHA-256 of CAND_SASS (32 bytes)
note   [72..72+4*N-1] perm[0..N-1] u32 LE (cand pc i -> ref pc perm[i])
note
note Mechanically enforces all SM121 Antibodies (HelixAntibodies.lean + Antibody17.lean):
note   exit 0: MONK PASS (Antibodies #1-#17 satisfied, 0 CFG scoreboard hazards, all-consumer RAW preserved)
note   exit 11: Antibody 7 -- length / format / OOB perm mismatch
note   exit 12: Antibody 1 -- SHA-256 digest spoof (REF or CAND mismatch)
note   exit 13: Antibody 2 -- non-bijection (duplicate or missing perm entry)
note   exit 14: Antibody 3 -- functional SM121 opcode/operand smuggling (outside 17-bit ctrl word w3[9..25])
note   exit 15: Antibodies 4/13/17c -- anchor escape (BRA/EXIT/BAR/MEMBAR/BSSY/BSYNC/ISETP/FSETP/SEL/mem/pred/BB-leader) or cross-anchor segment violation
note   exit 16: Antibody 5 -- RAW/WAR/WAW register dependency inversion
note   exit 17: Antibodies 6/14/15/16/17a/17b/17d -- SM121 64-bit hz_kill CFG hazard OR all-consumer RAW stall underflow (ALU>=6, HMMA/QMMA>=22, OMMA>=29)
note   exit 90: usage / file I/O error

global mkRef uchar 32768
global mkCand uchar 32768
global mkCert uchar 16384
global mkPath uchar 4096
global mkPerm ulong 2048
global mkInv ulong 2048
global mkSeen ulong 2048
global mkSeg ulong 2048
global mkTarget uchar 2048
global mkRefRec ulong 49152
global mkCndRec ulong 49152
note Antibody #17d: exact 64-bit multi-barrier power-set masks (zero rbar collapse!)
global mkWbar ulong 512
global mkRbar ulong 512
note Full CFG fixed-point dataflow scoreboard state (2048 PCs x 512 regs x 64-bit barrier power-set)
global mkHzInW ulong 1048576
global mkHzInR ulong 1048576
global mkHzSeen ulong 2048
global mkHzQu ulong 2048
global mkHzWk ulong 2048
global mkRefSha uchar 32
global mkCndSha uchar 32
global mkOut uchar 256

text mkUse "usage: monk_check REF_SASS CAND_SASS CERT_FILE\n"
text mkPassA "MONK PASS rung="
text mkPassB " insns="
text mkPassC " swapped="
text mkPassD " stall_ref="
text mkPassE " stall_cand="
text mkPassF " hazards=0\n"
text mkRejA "MONK REJECT code="
text mkRejB " reason="
text mkR11 "length-or-format-mismatch\n"
text mkR12 "digest-spoof\n"
text mkR13 "non-bijection\n"
text mkR14 "opcode-smuggle\n"
text mkR15 "anchor-escape\n"
text mkR16 "dep-inversion\n"
text mkR17 "sm121-hazard\n"

fn mkWrt s view uchar * to void
r = write 1 s 0 len s
end

fn mkNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn mkReject code int ridx ulong to int
mkWrt mkRejA
mkNum ulong code
mkWrt mkRejB
if eq ridx 11
mkWrt mkR11
end
if eq ridx 12
mkWrt mkR12
end
if eq ridx 13
mkWrt mkR13
end
if eq ridx 14
mkWrt mkR14
end
if eq ridx 15
mkWrt mkR15
end
if eq ridx 16
mkWrt mkR16
end
if eq ridx 17
mkWrt mkR17
end
ret code
end

fn mkReadFile idx ulong dst ulong maxb ulong to long
k = argread idx mkPath 0 4095
if lt k 1
ret long -1
end
fd = fopen mkPath 0 ulong k 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot maxb bound 1024
r = read int fd mkOut 0 256
if lt r 0
c = fclose int fd
ret long -1
end
if eq r 0
break
end
ur = ulong r
if gt add tot ur maxb
c = fclose int fd
ret long -1
end
for i ulong ur bound 256
b = get mkOut i
if eq dst 0
put mkRef add tot i b
else
if eq dst 1
put mkCand add tot i b
else
put mkCert add tot i b
end
end
end
tot = add tot ur
end
c = fclose int fd
ret long tot
end

fn mkRdU32Cert o ulong to ulong
a = ulong get mkCert o
a = or a shl ulong get mkCert add o 1 8
a = or a shl ulong get mkCert add o 2 16
ret or a shl ulong get mkCert add o 3 24
end

fn mkRdU32Ref o ulong to ulong
a = ulong get mkRef o
a = or a shl ulong get mkRef add o 1 8
a = or a shl ulong get mkRef add o 2 16
ret or a shl ulong get mkRef add o 3 24
end

fn mkRdU32Cnd o ulong to ulong
a = ulong get mkCand o
a = or a shl ulong get mkCand add o 1 8
a = or a shl ulong get mkCand add o 2 16
ret or a shl ulong get mkCand add o 3 24
end

fn mkHashBuf src ulong n ulong to void
for i ulong n bound 32768
if eq src 0
put sh_dat i get mkRef i
else
put sh_dat i get mkCand i
end
end
sh_all n
for i ulong 32
if eq src 0
put mkRefSha i get sh_dig i
else
put mkCndSha i get sh_dig i
end
end
end

fn mkFuncMatch ci ulong ri ulong to bool
co = mul ci 16
ro = mul ri 16
if ne mkRdU32Cnd co mkRdU32Ref ro
ret false
end
if ne mkRdU32Cnd add co 4 mkRdU32Ref add ro 4
ret false
end
if ne mkRdU32Cnd add co 8 mkRdU32Ref add ro 8
ret false
end
note w3 bits [9..25] (0x03fffe00 = 67108352) are the 17-bit SM121 scheduling control word;
note every other bit of w3 (mask 0xfc0001ff = 4227858943) MUST be identical!
cw = and mkRdU32Cnd add co 12 ulong 4227858943
rw = and mkRdU32Ref add ro 12 ulong 4227858943
ret eq cw rw
end

fn mkDecOmma w0 ulong w1 ulong w2 ulong w3 ulong rec edit ulong 24 to bool
if ne and w0 4095 1151
ret false
end
wb = and shr w3 14 7
rbr = and shr w3 17 7
if or eq wb 6 eq rbr 6
ret false
end
for i ulong 24
put rec i 0
end
put rec 0 1151
put rec 1 and shr w0 12 15
put rec 2 and shr w3 9 15
put rec 3 and shr w3 13 1
put rec 4 wb
put rec 5 rbr
put rec 6 and shr w3 20 63
hz_w rec 0 and shr w0 16 255 4 0
hz_r rec 0 shr w0 24 4 0
hz_r rec 0 and w1 255 2 0
hz_r rec 0 and w2 255 4 0
hz_r rec 0 and shr w1 8 255 1 0
hz_r rec 0 and shr w1 20 255 1 0
hz_nm rec 0 38 0 0
ret true
end

fn mkDecodeAll src ulong n ulong to bool
ins = new uchar 16 0
rec = new ulong 24 0
for pc ulong n bound 2048
base = mul pc 16
for j ulong 16
if eq src 0
put ins j get mkRef add base j
else
put ins j get mkCand add base j
end
end
r = hx_dec_sm121 ins rec
if ne r 0
w0 = hz_rd32 ins 0
w1 = hz_rd32 ins 4
w2 = hz_rd32 ins 8
w3 = hz_rd32 ins 12
if not mkDecOmma w0 w1 w2 w3 rec
ret false
end
end
db = mul pc 24
for j ulong 24
if eq src 0
put mkRefRec add db j get rec j
else
put mkCndRec add db j get rec j
end
end
end
ret true
end

fn mkMarkTargets n ulong to void
for i ulong n bound 2048
put mkTarget i 0
end
if gt n 0
put mkTarget 0 1
end
for pc ulong n bound 2048
db = mul pc 24
if eq get mkRefRec add db 17 2
tg = hz_u2l get mkRefRec add db 18
dst = add long pc tg
if and ge dst 0 lt dst long n
put mkTarget ulong dst 1
end
if lt add pc 1 n
put mkTarget add pc 1 1
end
end
end
end

note Anchor predicate (Antibodies #4, #13, #17c): basic-block leaders/branch targets, control flow (flow != 0),
note predicated guard (guard != 7), barriers/sync/NOP/reconvergence (nm <= 8), predicate writers (ISETP 16, FSETP 25),
note predicate reader SEL (26, op 520), or memory ops (nm 33..37).
fn mkIsAnchor pc ulong to bool
if ne get mkTarget pc 0
ret true
end
db = mul pc 24
if ne get mkRefRec add db 17 0
ret true
end
if ne get mkRefRec add db 1 7
ret true
end
nm = get mkRefRec add db 19
if or le nm 8 and ge nm 33 le nm 37
ret true
end
if or eq nm 16 or eq nm 25 eq nm 26
ret true
end
ret false
end

fn mkRegOverlap a ulong b ulong to bool
if or eq a 0 eq b 0
ret false
end
ra = and a 255
na = and shr a 8 255
ua = and shr a 16 1
rb = and b 255
nb = and shr b 8 255
ub = and shr b 16 1
if ne ua ub
ret false
end
if or eq ra 255 eq rb 255
ret false
end
if or le add ra na rb le add rb nb ra
ret false
end
ret true
end

fn mkHasRaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if eq get mkRefRec add du 10 0
ret false
end
wu = get mkRefRec add du 16
for j ulong get mkRefRec add dv 9 bound 5
if mkRegOverlap wu get mkRefRec add add dv 11 j
ret true
end
end
ret false
end

fn mkHasWaw u ulong v ulong to bool
du = mul u 24
dv = mul v 24
if or eq get mkRefRec add du 10 0 eq get mkRefRec add dv 10 0
ret false
end
ret mkRegOverlap get mkRefRec add du 16 get mkRefRec add dv 16
end

fn mkHasDep u ulong v ulong to bool
if mkHasWaw u v
ret true
end
if mkHasRaw u v
ret true
end
du = mul u 24
dv = mul v 24
if ne get mkRefRec add dv 10 0
wv = get mkRefRec add dv 16
for j ulong get mkRefRec add du 9 bound 5
if mkRegOverlap get mkRefRec add add du 11 j wv
ret true
end
end
end
ret false
end

note Helper: check one operand against pending wbar (and rbar if chkR is true)
fn mkChkOpnd opnd ulong chkR bool to bool
reg = and opnd 255
cnt = and shr opnd 8 255
uni = and shr opnd 16 1
if eq reg 255
ret true
end
base = add mul uni 256 reg
for k ulong cnt bound 4
idx = add base k
if lt idx 512
if ne get mkWbar idx 0
ret false
end
if chkR
if ne get mkRbar idx 0
ret false
end
end
end
end
ret true
end

note Helper: mark one operand in mkWbar (isR=false) or mkRbar (isR=true) with exact 64-bit barrier power-set bit
fn mkMarkOpnd opnd ulong bit ulong isR bool to void
reg = and opnd 255
cnt = and shr opnd 8 255
uni = and shr opnd 16 1
if eq reg 255
ret
end
base = add mul uni 256 reg
for k ulong cnt bound 4
idx = add base k
if lt idx 512
if isR
put mkRbar idx or get mkRbar idx bit
else
put mkWbar idx or get mkWbar idx bit
end
end
end
end

note Antibody #17d: exact 64-bit multi-barrier power-set tracking (hz_kill) -- zero rbar collapse!
fn mkStepWait db ulong to void
wt = get mkCndRec add db 6
if ne wt 0
km = xor hz_kill wt ulong 18446744073709551615
for i ulong 512
put mkWbar i and get mkWbar i km
put mkRbar i and get mkRbar i km
end
end
end

fn mkStepMarkW db ulong to void
nw = get mkCndRec add db 10
if eq nw 0
ret
end
wb = get mkCndRec add db 4
if lt wb 6
wbit = shl ulong 1 shl ulong 1 wb
mkMarkOpnd get mkCndRec add db 16 wbit false
end
end

fn mkStepMarkR db ulong to void
rbr = get mkCndRec add db 5
if and eq get mkCndRec add db 8 0 eq rbr 7
ret
end
wb = get mkCndRec add db 4
lm = ulong 0
if lt rbr 6
lm = or lm shl ulong 1 rbr
end
if lt wb 6
lm = or lm shl ulong 1 wb
end
if ne lm 0
rbit = shl ulong 1 lm
nr = get mkCndRec add db 9
for j ulong nr bound 5
mkMarkOpnd get mkCndRec add add db 11 j rbit true
end
end
end

fn mkStepHazard pc ulong check bool to bool
db = mul pc 24
mkStepWait db
if check
nr = get mkCndRec add db 9
for j ulong nr bound 5
if not mkChkOpnd get mkCndRec add add db 11 j false
ret false
end
end
if ne get mkCndRec add db 10 0
if not mkChkOpnd get mkCndRec add db 16 true
ret false
end
end
end
mkStepMarkW db
mkStepMarkR db
ret true
end

note CFG helpers for full fixed-point dataflow scoreboard check (matching bw_hazard.om hz_fix)
fn mkHzLoadIn pc ulong to void
off = mul pc 512
for i ulong 512
put mkWbar i get mkHzInW add off i
put mkRbar i get mkHzInR add off i
end
end

fn mkHzJoinTo tgt ulong to bool
off = mul tgt 512
ch = false
for i ulong 512
ow = get mkHzInW add off i
nw = or ow get mkWbar i
if ne nw ow
put mkHzInW add off i nw
ch = true
end
orv = get mkHzInR add off i
nrv = or orv get mkRbar i
if ne nrv orv
put mkHzInR add off i nrv
ch = true
end
end
ret ch
end

fn mkHzReachPush n ulong tgt long top ulong to ulong
if or lt tgt 0 ge tgt long n
ret top
end
u = ulong tgt
if eq get mkHzSeen u 0
put mkHzSeen u 1
put mkHzWk top u
ret add top 1
end
ret top
end

fn mkHzEdge n ulong tgt long top ulong to ulong
if or lt tgt 0 ge tgt long n
ret top
end
u = ulong tgt
ch = mkHzJoinTo u
sv = get mkHzSeen u
qv = get mkHzQu u
if and or ch eq sv 1 eq qv 0
put mkHzQu u 1
put mkHzWk top u
ret add top 1
end
ret top
end

fn mkHzZeroAll n ulong to void
for i ulong n bound 2048
put mkHzSeen i 0
put mkHzQu i 0
off = mul i 512
for r ulong 512
put mkHzInW add off r 0
put mkHzInR add off r 0
end
end
end

fn mkHzDoReach n ulong to void
put mkHzSeen 0 1
put mkHzWk 0 0
top = ulong 1
while gt top 0 bound 4096
top = sub top 1
pc = get mkHzWk top
db = mul pc 24
fl = get mkCndRec add db 17
gd = get mkCndRec add db 1
if or eq fl 0 ne gd 7
top = mkHzReachPush n add long pc 1 top
end
if eq fl 2
tg = hz_u2l get mkCndRec add db 18
top = mkHzReachPush n add long pc tg top
end
end
end

note Verify Blackwell SM121 CFG scoreboard hazards across all reachable paths (0 hazards required).
fn mkCheckHazards n ulong to bool
mkHzZeroAll n
mkHzDoReach n
put mkHzWk 0 0
put mkHzQu 0 1
top = ulong 1
while gt top 0 bound 65536
top = sub top 1
pc = get mkHzWk top
put mkHzQu pc 0
put mkHzSeen pc 2
mkHzLoadIn pc
z = mkStepHazard pc false
db = mul pc 24
fl = get mkCndRec add db 17
gd = get mkCndRec add db 1
if or eq fl 0 ne gd 7
top = mkHzEdge n add long pc 1 top
end
if eq fl 2
tg = hz_u2l get mkCndRec add db 18
top = mkHzEdge n add long pc tg top
end
end
for pc ulong n bound 2048
if ne get mkHzSeen pc 0
mkHzLoadIn pc
if not mkStepHazard pc true
ret false
end
end
end
ret true
end

note Fixed-latency ALU RAW stall preservation (synced in lockstep with helix_jit.om & arboris_predator.om):
note Antibodies #14/#15/#16: rawFloor=6, scan distance 16, IMAD.WIDE(14), I2FP(29), WAW early stop,
note and RAW span checking to anchor consumers & BRA/EXIT block boundaries!
fn mkSumRange src ulong lo ulong hi ulong to ulong
tot = ulong 0
k = lo
while lt k hi bound 2048
if eq src 0
tot = add tot get mkRefRec add mul k 24 2
else
tot = add tot get mkCndRec add mul k 24 2
end
k = add k 1
end
ret tot
end

note Antibody #17b: SM121 pipeline RAW latency floor (6 ALU, 22 HMMA/QMMA, 29 OMMA.SF.16864)
fn mkPipeFloor nm ulong to ulong
if or eq nm 18 eq nm 19
ret 22
end
if eq nm 38
ret 29
end
ret 6
end

fn mkRawSpanOk u ulong v ulong inclV bool flr ulong to bool
hiRef = v
hiCnd = get mkInv v
if inclV
hiRef = add v 1
hiCnd = add hiCnd 1
end
rcyc = mkSumRange 0 u hiRef
eff = flr
pf = mkPipeFloor get mkRefRec add mul u 24 19
if lt eff pf
eff = pf
end
req = rcyc
if gt req eff
req = eff
end
ret ge mkSumRange 1 get mkInv u hiCnd req
end

note Antibody #17a/#17b Fixed-latency RAW verification: scans ALL live RAW consumers (never early-returns
note on first ref consumer v1!) up to distance 32, enforcing ALU>=6, HMMA/QMMA>=22, OMMA>=29!
fn mkCheckRawOne u ulong n ulong flr ulong to bool
du = mul u 24
if or eq get mkRefRec add du 10 0 ne get mkRefRec add du 7 0
ret true
end
note Antibody #15: I2FP/I2F (op 581, nm==29, var=0) stall must never be shaved below min(ref_stall, flr)!
if eq get mkRefRec add du 19 29
rst = get mkRefRec add du 2
if gt rst flr
rst = flr
end
if lt get mkCndRec add mul get mkInv u 24 2 rst
ret false
end
end
lim = add u 32
if gt lim n
lim = n
end
v = add u 1
while lt v lim bound 32
if mkHasRaw u v
if not mkRawSpanOk u v false flr
ret false
end
end
if mkHasWaw u v
ret true
end
dbv = mul v 24
if ne get mkRefRec add dbv 17 0
ret mkRawSpanOk u v true flr
end
if mkIsAnchor v
if not mkRawSpanOk u v true flr
ret false
end
end
v = add v 1
end
ret true
end

fn mkCheckRawStalls n ulong to bool
for u ulong n bound 2048
if not mkCheckRawOne u n 6
ret false
end
end
ret true
end

fn mkPrintRungHash to void
for i ulong 32
put sh_dat i get mkRefSha i
put sh_dat add i 32 get mkCndSha i
end
sh_all 64
hx = new uchar 64 0
for i ulong 32
b = uint get sh_dig i
put hx mul i 2 sh_hexd shr b 4
put hx add mul i 2 1 sh_hexd and b 15
end
r = write 1 hx 0 64
end

fn mkCheckPerm n ulong to long
for i ulong n bound 2048
put mkSeen i 0
end
sw = ulong 0
for i ulong n bound 2048
r = mkRdU32Cert add 72 mul i 4
if ge r n
ret long -11
end
if ne get mkSeen r 0
ret long -13
end
put mkSeen r 1
put mkPerm i r
put mkInv r i
if ne r i
sw = add sw 1
end
end
ret long sw
end

fn mkCheckDeps n ulong to bool
for u ulong n bound 2048
pu = get mkInv u
v = add u 1
while lt v n bound 2048
if mkHasDep u v
if ge pu get mkInv v
ret false
end
end
v = add v 1
end
end
ret true
end

fn mkSumStalls src ulong n ulong to ulong
tot = ulong 0
for i ulong n bound 2048
if eq src 0
tot = add tot get mkRefRec add mul i 24 2
else
tot = add tot get mkCndRec add mul i 24 2
end
end
ret tot
end

fn mkCheckMagic to bool
if ne get mkCert 0 72
ret false
end
if ne get mkCert 1 88
ret false
end
if ne get mkCert 2 80
ret false
end
ret eq get mkCert 3 49
end

fn mkCheckDigests to bool
for i ulong 32
if ne get mkRefSha i get mkCert add 8 i
ret false
end
if ne get mkCndSha i get mkCert add 40 i
ret false
end
end
ret true
end

fn mkCheckAllFunc n ulong to bool
for i ulong n bound 2048
if not mkFuncMatch i get mkPerm i
ret false
end
end
ret true
end

note Antibodies #4/#13/#17c: anchor pinning + O(n) anchor-segment preservation (no non-anchor crosses ANY anchor!)
fn mkCheckAnchors n ulong to bool
seg = ulong 0
for i ulong n bound 2048
if mkIsAnchor i
seg = add seg 1
end
put mkSeg i seg
end
for i ulong n bound 2048
r = get mkPerm i
if mkIsAnchor i
if ne r i
ret false
end
else
if ne get mkSeg r get mkSeg i
ret false
end
end
end
ret true
end

fn main to int
if ne argcnt 4
mkWrt mkUse
ret 90
end
rlen = mkReadFile 1 0 32768
clen = mkReadFile 2 1 32768
zlen = mkReadFile 3 2 16384
if or lt rlen 16 or lt clen 16 lt zlen 76
ret mkReject 11 11
end
if not mkCheckMagic
ret mkReject 11 11
end
n = mkRdU32Cert 4
if or eq n 0 gt n 2048
ret mkReject 11 11
end
if ne ulong rlen mul n 16
ret mkReject 11 11
end
if ne ulong clen mul n 16
ret mkReject 11 11
end
if ne ulong zlen add 72 mul n 4
ret mkReject 11 11
end
mkHashBuf 0 ulong rlen
mkHashBuf 1 ulong clen
if not mkCheckDigests
ret mkReject 12 12
end
sw = mkCheckPerm n
if eq sw long -11
ret mkReject 11 11
end
if eq sw long -13
ret mkReject 13 13
end
if not mkCheckAllFunc n
ret mkReject 14 14
end
if not mkDecodeAll 0 n
ret mkReject 17 17
end
if not mkDecodeAll 1 n
ret mkReject 17 17
end
mkMarkTargets n
if not mkCheckAnchors n
ret mkReject 15 15
end
if not mkCheckDeps n
ret mkReject 16 16
end
if not mkCheckHazards n
ret mkReject 17 17
end
if not mkCheckRawStalls n
ret mkReject 17 17
end
mkWrt mkPassA
mkPrintRungHash
mkWrt mkPassB
mkNum n
mkWrt mkPassC
mkNum ulong sw
mkWrt mkPassD
mkNum mkSumStalls 0 n
mkWrt mkPassE
mkNum mkSumStalls 1 n
mkWrt mkPassF
ret 0
end

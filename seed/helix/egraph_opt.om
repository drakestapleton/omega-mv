note SPDX-License-Identifier: Apache-2.0
note seed/helix/egraph_opt.om: Phase 2 Verified Equality-Saturation E-Graph Optimizer (pure OM-2).
note Models HelixKernelIR.lean (opcodes 1..10, rules 1..12) with union-find e-classes,
note equality saturation, GB10 SM121 cost-model extraction, and FULL structural EGP2 proof
note certificate emission (node table + roots + step-by-step witness trace), verified
note independently from scratch by Strand A's seed/helix/dual_checker.om.
note
note Node opcodes (mirroring HelixKernelIR.lean):
note   1=KCONST 2=KREG 3=KADD 4=KSUB 5=KMUL 6=KFMA 7=KSHL 8=KSHR 9=KBAND 10=KBOR
note Rewrite Rule IDs (each proved in seed/helix/proofs/HelixKernelIR.lean):
note   1=rw_fma_fuse (add(mul(a,b),c)->fma(a,b,c))
note   2=rw_fma_fuse_comm (add(c,mul(a,b))->fma(a,b,c))
note   3=rw_add_zero (add(x,0)->x)
note   4=rw_zero_add (add(0,x)->x)
note   5=rw_mul_one (mul(x,1)->x)
note   6=rw_mul_zero (mul(x,0)->0)
note   11=rw_and_self (band(x,x)->x)
note   12=rw_fma_zero_add (fma(a,b,0)->mul(a,b))
note
note EGP2 binary format:
note   [0..3]  magic "EGP2" (69, 71, 80, 50)
note   [4..7]  u32 LE kernel_count (3)
note   Per kernel:
note     [+0..+3]   u32 kind
note     [+4..+7]   u32 node_count (N)
note     [+8..+11]  u32 root_before
note     [+12..+15] u32 root_after
note     [+16..+19] u32 trace_count (T)
note     N * 20 bytes: (op, a, b, c, val) u32 LE per node
note     T * 12 bytes: (rule_id, lhs_node, rhs_node) u32 LE per proof step
note
note Usage: egraph_opt CERT_OUT

global egPar ulong 512
global egOp ulong 512
global egA ulong 512
global egB ulong 512
global egC ulong 512
global egVal ulong 512
global egCnt ulong 1
global egCost ulong 512
global egBest ulong 512
global egTr ulong 2048
global egTrN ulong 1
global egBuf uchar 16384
global egPath uchar 1024

text egUse "usage: egraph_opt CERT_OUT\n"
text egHdr "=== PHASE 2: VERIFIED EQUALITY-SATURATION E-GRAPH OPTIMIZER (GB10 COST MODEL, EGP2) ===\n"
text egK0 "  kernel=q36_bf16_gemv_mac  cost_before="
text egK1 "  kernel=q36_w4_unpack_mac  cost_before="
text egK2 "  kernel=q36_swiglu_gate    cost_before="
text egMid " cost_after="
text egStp " proof_steps="
text egNl "\n"
text egDone "EGRAPH PASS kernels=3 all_cost_reduced=1 egp2_structural_cert=1\n"

fn egWrt s view uchar * to void
r = write 1 s 0 len s
end

fn egNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn egReset to void
put egCnt 0 0
put egTrN 0 0
end

fn egFind x ulong to ulong
c = x
for i ulong 64
p = get egPar c
if eq p c
ret c
end
c = p
end
ret c
end

fn egAddNode op ulong a ulong b ulong c ulong val ulong to ulong
id = get egCnt 0
put egCnt 0 add id 1
put egPar id id
put egOp id op
put egA id a
put egB id b
put egC id c
put egVal id val
ret id
end

fn egUnion u ulong v ulong rule ulong to void
ru = egFind u
rv = egFind v
if eq ru rv
ret
end
put egPar rv ru
t = get egTrN 0
if lt t 500
b = mul t 4
put egTr b rule
put egTr add b 1 u
put egTr add b 2 v
put egTr add b 3 ru
put egTrN 0 add t 1
end
end

fn egOpCost op ulong to ulong
if or eq op 1 eq op 2
ret 0
end
if or eq op 3 eq op 4
ret 2
end
if eq op 5
ret 3
end
if eq op 6
ret 2
end
ret 1
end

fn egNodeCost id ulong to ulong
op = get egOp id
base = egOpCost op
if or eq op 1 eq op 2
ret 0
end
ca = get egCost egFind get egA id
cb = get egCost egFind get egB id
if eq op 6
cc = get egCost egFind get egC id
ret add add add base ca cb cc
end
ret add add base ca cb
end

fn egIsConst id ulong want ulong to bool
c = egFind id
n = get egCnt 0
for i ulong n bound 512
if and eq egFind i c and eq get egOp i 1 eq get egVal i want
ret true
end
end
ret false
end

fn egApplyRules to bool
changed = false
n = get egCnt 0
for i ulong n bound 512
op = get egOp i
if eq op 3
a = get egA i
b = get egB i
if egIsConst b 0
if ne egFind i egFind a
egUnion i a 3
changed = true
end
end
if egIsConst a 0
if ne egFind i egFind b
egUnion i b 4
changed = true
end
end
ca = egFind a
for j ulong n bound 512
if and eq egFind j ca eq get egOp j 5
nf = egAddNode 6 get egA j get egB j b 0
egUnion i nf 1
changed = true
break
end
end
cb = egFind b
for j ulong n bound 512
if and eq egFind j cb eq get egOp j 5
nf = egAddNode 6 get egA j get egB j a 0
egUnion i nf 2
changed = true
break
end
end
end
if eq op 5
a = get egA i
b = get egB i
if egIsConst b 1
if ne egFind i egFind a
egUnion i a 5
changed = true
end
end
if egIsConst b 0
if ne egFind i egFind b
egUnion i b 6
changed = true
end
end
end
if eq op 9
if eq egFind get egA i egFind get egB i
if ne egFind i egFind get egA i
egUnion i get egA i 11
changed = true
end
end
end
end
ret changed
end

fn egComputeCosts to void
n = get egCnt 0
for i ulong n bound 512
put egCost i 999999
put egBest i i
end
for iter ulong 12
for i ulong n bound 512
c = egNodeCost i
r = egFind i
if lt c get egCost r
put egCost r c
put egBest r i
end
end
end
end

fn egPutU32 o ulong v ulong to void
put egBuf o uchar and v 255
put egBuf add o 1 uchar and shr v 8 255
put egBuf add o 2 uchar and shr v 16 255
put egBuf add o 3 uchar and shr v 24 255
end

fn egBuildKernel kind ulong to ulong
r0 = egAddNode 2 0 0 0 0
r1 = egAddNode 2 0 0 0 1
r2 = egAddNode 2 0 0 0 2
c0 = egAddNode 1 0 0 0 0
c1 = egAddNode 1 0 0 0 1
if eq kind 0
m = egAddNode 5 r0 r1 0 0
az = egAddNode 3 r2 c0 0 0
ret egAddNode 3 m az 0 0
end
if eq kind 1
bx = egAddNode 9 r0 r0 0 0
m1 = egAddNode 5 r1 c1 0 0
m2 = egAddNode 5 bx m1 0 0
ret egAddNode 3 r2 m2 0 0
end
m1 = egAddNode 5 r1 c1 0 0
m2 = egAddNode 5 r0 m1 0 0
az = egAddNode 3 c0 r2 0 0
ret egAddNode 3 m2 az 0 0
end

fn egSerKernel kind ulong rootB ulong rootA ulong outOff ulong to ulong
nc = get egCnt 0
nt = get egTrN 0
p = outOff
egPutU32 p kind
egPutU32 add p 4 nc
egPutU32 add p 8 rootB
egPutU32 add p 12 rootA
egPutU32 add p 16 nt
p = add p 20
for i ulong nc bound 512
egPutU32 p get egOp i
egPutU32 add p 4 get egA i
egPutU32 add p 8 get egB i
egPutU32 add p 12 get egC i
egPutU32 add p 16 get egVal i
p = add p 20
end
for i ulong nt bound 512
b = mul i 4
egPutU32 p get egTr b
egPutU32 add p 4 get egTr add b 1
egPutU32 add p 8 get egTr add b 2
p = add p 12
end
ret p
end

fn egRunKernel kind ulong outOff ulong to ulong
egReset
root = egBuildKernel kind
egComputeCosts
cbef = get egCost egFind root
for step ulong 6
if not egApplyRules
break
end
end
egComputeCosts
caft = get egCost egFind root
bestR = get egBest egFind root
nt = get egTrN 0
if eq kind 0
egWrt egK0
else
if eq kind 1
egWrt egK1
else
egWrt egK2
end
end
egNum cbef
egWrt egMid
egNum caft
egWrt egStp
egNum nt
egWrt egNl
ret egSerKernel kind root bestR outOff
end

fn main to int
if ne argcnt 2
egWrt egUse
ret 90
end
egWrt egHdr
note Certificate magic EGP2 + count=3
put egBuf 0 69
put egBuf 1 71
put egBuf 2 80
put egBuf 3 50
egPutU32 4 3
pos = ulong 8
pos = egRunKernel 0 pos
pos = egRunKernel 1 pos
pos = egRunKernel 2 pos
k = argread 1 egPath 0 1023
if lt k 1
ret 90
end
fd = fopen egPath 0 ulong k 577 420
if lt fd 0
ret 2
end
w = write int fd egBuf 0 pos
z = fclose int fd
if ne w long pos
ret 2
end
egWrt egDone
ret 0
end

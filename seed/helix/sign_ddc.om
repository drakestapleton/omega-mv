note SPDX-License-Identifier: Apache-2.0
note seed/helix/sign_ddc.om: Pure-Omega RFC 8032 Ed25519 DDC Receipt Signer & Verifier.
note Compose after:
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note   protocol/uor-gpu/ed_sign.om
note
note Usage:
note   sign_ddc selftest <msg_file> <pk_out> <sig_out>
note     Uses a public, deterministic RFC 8032 self-test seed (explicitly NOT an operator secret)
note     to sign <msg_file>, writes hex pubkey + sig, verifies valid signature (strict mode 0),
note     and confirms a 1-bit message tamper is rejected.
note   sign_ddc verify <msg_file> <pk_hex_file> <sig_hex_file>
note     Verifies an RFC 8032 Ed25519 signature (strict mode 0) over <msg_file>.

text sdUse "usage: sign_ddc selftest <msg> <pk_out> <sig_out> | verify <msg> <pk_hex> <sig_hex>\n"
text sdDom "HELIX-DDC-RFC8032-PUBLIC-TEST-AUTHORITY-V1"
text sdOkS "DDC_ED25519_SELFTEST PASS bytes="
text sdOkPk " pubkey="
text sdOkSg " sig="
text sdOkTail " verify_valid=1 tamper_rejected=1\n"
text sdOkV "DDC_ED25519_VERIFY PASS bytes="
text sdFailS "DDC_ED25519_SELFTEST FAIL\n"
text sdFailV "DDC_ED25519_VERIFY FAIL\n"
text sdNl "\n"

fn sdWrt s view uchar * to void
r = write 1 s 0 len s
end

fn sdNum v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn sdHexCh v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

fn sdParseNib c ulong to long
if and ge c 48 le c 57
ret long sub c 48
end
if and ge c 97 le c 102
ret long add 10 sub c 97
end
if and ge c 65 le c 70
ret long add 10 sub c 65
end
ret long -1
end

fn sdWriteHex buf view uchar 64 n ulong to void
o = new uchar 128 0
for i ulong n bound 64
b = ulong get buf i
put o mul i 2 sdHexCh shr b 4
put o add mul i 2 1 sdHexCh and b 15
end
r = write 1 o 0 mul n 2
end

fn sdSaveHex pathIdx ulong buf view uchar 64 n ulong to bool
pth = new uchar 512 0
pl = argread pathIdx pth 0 510
if lt pl 1
ret false
end
fd = fopen pth 0 ulong pl 577 420
if lt fd 0
ret false
end
o = new uchar 129 0
for i ulong n bound 64
b = ulong get buf i
put o mul i 2 sdHexCh shr b 4
put o add mul i 2 1 sdHexCh and b 15
end
put o mul n 2 uchar 10
wr = write int fd o 0 add mul n 2 1
rc = fclose int fd
ret eq wr long add mul n 2 1
end

fn sdReadFile pathIdx ulong dst edit uchar 65536 maxN ulong to long
pth = new uchar 512 0
pl = argread pathIdx pth 0 510
if lt pl 1
ret long -1
end
fd = fopen pth 0 ulong pl 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot maxN bound 1024
r = read int fd dst tot sub maxN tot
if le r 0
break
end
tot = add tot ulong r
end
rc = fclose int fd
ret long tot
end

fn sdReadHex32 pathIdx ulong dst edit uchar 32 to bool
buf = new uchar 65536 0
n = sdReadFile pathIdx buf 256
if lt n 64
ret false
end
for i ulong 32
hi = sdParseNib ulong get buf mul i 2
lo = sdParseNib ulong get buf add mul i 2 1
if or lt hi 0 lt lo 0
ret false
end
put dst i uchar or shl ulong hi 4 ulong lo
end
ret true
end

fn sdReadHex64 pathIdx ulong dst edit uchar 64 to bool
buf = new uchar 65536 0
n = sdReadFile pathIdx buf 256
if lt n 128
ret false
end
for i ulong 64
hi = sdParseNib ulong get buf mul i 2
lo = sdParseNib ulong get buf add mul i 2 1
if or lt hi 0 lt lo 0
ret false
end
put dst i uchar or shl ulong hi 4 ulong lo
end
ret true
end

fn sdDeriveSeed seed edit uchar 32 to void
m0 = new uchar 65536 0
h0 = new uchar 64 0
dlen = len sdDom
for i ulong dlen bound 64
put m0 i get sdDom i
end
s512hash m0 dlen h0
for i ulong 32
put seed i get h0 i
end
end

fn sdDoSelftest to int
msg = new uchar 65536 0
n = sdReadFile 2 msg 65504
if le n 0
sdWrt sdFailS
ret 1
end
seed = new uchar 32 0
pk = new uchar 32 0
sig = new uchar 64 0
pk64 = new uchar 64 0
sdDeriveSeed seed
ues_pubkey seed pk
ues_sign seed msg ulong n sig
ok1 = edverify pk msg ulong n sig 0
put msg 0 xor get msg 0 uchar 1
ok2 = edverify pk msg ulong n sig 0
put msg 0 xor get msg 0 uchar 1
if or ne ok1 1 ne ok2 0
sdWrt sdFailS
ret 1
end
for i ulong 32
put pk64 i get pk i
end
if not sdSaveHex 3 pk64 32
sdWrt sdFailS
ret 1
end
if not sdSaveHex 4 sig 64
sdWrt sdFailS
ret 1
end
sdWrt sdOkS
sdNum ulong n
sdWrt sdOkPk
sdWriteHex pk64 32
sdWrt sdOkSg
sdWriteHex sig 64
sdWrt sdOkTail
ret 0
end

fn sdDoVerify to int
msg = new uchar 65536 0
n = sdReadFile 2 msg 65504
if le n 0
sdWrt sdFailV
ret 1
end
pk = new uchar 32 0
sig = new uchar 64 0
if not sdReadHex32 3 pk
sdWrt sdFailV
ret 1
end
if not sdReadHex64 4 sig
sdWrt sdFailV
ret 1
end
ok = edverify pk msg ulong n sig 0
if ne ok 1
sdWrt sdFailV
ret 1
end
sdWrt sdOkV
sdNum ulong n
sdWrt sdNl
ret 0
end

fn main to int
if lt argcnt 5
sdWrt sdUse
ret 2
end
cmd = new uchar 16 0
cl = argread 1 cmd 0 15
if lt cl 1
sdWrt sdUse
ret 2
end
c0 = ulong get cmd 0
if eq c0 115
ret sdDoSelftest
end
if eq c0 118
ret sdDoVerify
end
sdWrt sdUse
ret 2
end

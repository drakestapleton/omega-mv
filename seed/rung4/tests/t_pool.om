note run-time pools (OMEGESE 9.15, om4 subset): grown from 0 by enlarge, values kept, new elements 0,
note len a run-time value, a number index checked at run time, a smaller enlarge changes nothing
global P ulong *
global Q uchar *
fn main to int
if ne len P 0
ret 1
end
r = enlarge P 4
put P 3 40
s = long 0
s = enlarge P 1000
if ne s 0
ret 2
end
put P 999 2
r = enlarge Q 5000
put Q 4999 7
r = enlarge P 10
if ne len P 1000
ret 3
end
i = ulong 500
if ne get P i 0
ret 4
end
x = add get P 3 get P 999
x = add x ulong get Q 4999
ret int x
end

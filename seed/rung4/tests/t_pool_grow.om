note run-time pools: a grow inside a block (while, if), doubling as the index reaches the length; every
note value written before a grow is read back after the later grows moved the pool
global P ulong *
fn main to int
i = ulong 0
while lt i 100000
if ge i len P
r = enlarge P add mul len P 2 1
if ne r 0
ret 2
end
end
put P i i
i = add i 1
end
t = ulong 0
j = ulong 0
while lt j 100000
t = add t get P j
j = add j 1
end
if ne t 4999950000
ret 1
end
ret 7
end

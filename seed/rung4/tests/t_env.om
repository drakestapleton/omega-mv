note envcnt and envread (OMEGESE 10 host words, om4 knows them for omc.om): every entry of the environment is read
note back (a NAME=VALUE with its = sign), whatever the environment holds; then the index envcnt traps 3 (status 103)
global b uchar 131072
fn main to int
n = envcnt
if lt n 0
ret 1
end
i = ulong 0
while lt i ulong n
k = envread i b 0 131072
if lt k 1
ret 2
end
eq1 = false
j = ulong 0
while lt j ulong k
if eq get b j 61
eq1 = true
end
j = add j 1
end
if not eq1
ret 3
end
i = add i 1
end
k = envread i b 0 1
ret 4
end

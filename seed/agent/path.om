note seed/agent/path.om -- omagent's workspace path rule, shared by seed/agent/agent.om and the
note Omega Node tool adapter seed/node/tool.om (DRA-290). OM-2 unit, no globals; compose before its user.
note agpathok: relative, every part nonempty and not . or .., no control bytes, and no part
note (checked with lstat, prefix by prefix) is a symbolic link
note agcomp: the part p[s, i) is not empty, . or .., and the prefix p[0, i) is not a symbolic link
fn agcomp p view uchar * s ulong i ulong to bool
cl = sub i s
if eq cl 0
ret false
end
if eq get p s 46
if eq cl 1
ret false
end
if eq cl 2
if eq get p add s 1 46
ret false
end
end
end
st = new uchar 128 0
r = lstat p 0 i st 0 128
if lt r 0
ret true
end
md = or ulong get st 16 shl ulong get st 17 8
ret ne and md 61440 40960
end

fn agpathok p view uchar * to bool
n = len p
if or eq n 0 gt n 4095
ret false
end
if eq get p 0 47
ret false
end
s = ulong 0
for i ulong add n 1
c = uchar 47
if lt i n
c = get p i
if or lt c 32 eq c 127
ret false
end
end
if eq c 47
if not agcomp p s i
ret false
end
s = add i 1
end
end
ret true
end

note SPDX-License-Identifier: AGPL-3.0-only
note One supervised ARBSTP02 request on stdin and one signature on stdout.
note FD3 supplies 136 trusted bytes: claim words 0..7, arena and kernel
note SHA-256s, and the eight dispatch-control bytes. FD4 supplies the pinned
note world public key. FD5 is a connected socket to its dedicated SSH agent.
note Cwd is the supervisor-owned world receipt directory. Only public data
note enters this process. Compose sha2.om, sha512.om and ed25519.om first.
text as_domain "ARBSTP02"
text as_algorithm "ssh-ed25519"
text as_hex "0123456789abcdef"
text as_here "."
note Linux AArch64 open flags: CLOEXEC, NOFOLLOW, plus NONBLOCK,
note WRONLY|CREAT|EXCL or DIRECTORY for the three corresponding opens.
const as_read_flags int 559104
const as_create_flags int 557249
const as_dir_flags int 573440

fn as_read fd int buf edit uchar * to bool
  pos = ulong 0
  while lt pos len buf
    count = read fd buf pos sub len buf pos
    if ne count neg long 4
      if le count 0
        ret false
      end
      pos = add pos ulong count
    end
  end
  ret true
end

fn as_write fd int buf view uchar * to bool
  pos = ulong 0
  while lt pos len buf
    count = write fd buf pos sub len buf pos
    if ne count neg long 4
      if le count 0
        ret false
      end
      pos = add pos ulong count
    end
  end
  ret true
end

fn as_equal a view uchar * b view uchar * to bool
  if ne len a len b
    ret false
  end
  for i ulong len a
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn as_allowed claim view uchar 65536 policy view uchar 136 to bool
  if not as_equal part claim 0 8 as_domain
    ret false
  end
  if not as_equal part claim 0 128 part policy 0 128
    ret false
  end
  ret as_equal part claim 176 8 part policy 128 8
end

fn as_agent pk view uchar 32 claim view uchar 65536 sig edit uchar 64 to bool
  request = new uchar 252 0
  put request 3 248
  put request 4 13
  put request 8 51
  put request 12 11
  for i ulong 11
    put request add 13 i get as_algorithm i
  end
  put request 27 32
  for i ulong 32
    put request add 28 i get pk i
  end
  put request 63 184
  for i ulong 184
    put request add 64 i get claim i
  end
  if not as_write 5 request
    ret false
  end
  response = new uchar 92 0
  if not as_read 5 part response 0 4
    ret false
  end
  if or ne get response 3 88 ne or get response 0 or get response 1 get response 2 0
    ret false
  end
  if not as_read 5 part response 4 88
    ret false
  end
  put request 3 88
  put request 4 14
  put request 8 83
  put request 27 64
  if not as_equal part response 0 28 part request 0 28
    ret false
  end
  for i ulong 64
    put sig i get response add 28 i
  end
  ret eq edverify pk claim 184 sig 0 1
end

fn as_name bytes view uchar * name edit uchar * to void
  for i ulong len bytes
    put name mul i 2 get as_hex shr get bytes i 4
    put name add mul i 2 1 get as_hex and get bytes i 15
  end
end

fn as_existing name view uchar * receipt view uchar 248 to bool
  fd = fopen name 0 len name as_read_flags 0
  if lt fd 0
    ret false
  end
  data = new uchar 248 0
  extra = new uchar 1 0
  ok = as_read int fd data
  if ok
    ok = eq read int fd extra 0 1 0
  end
  if ne fclose int fd 0
    ret false
  end
  ret and ok as_equal data receipt
end

fn as_record receipt view uchar 248 to bool
  nonce = new uchar 16 0
  if ne random nonce 0 16 0 16
    ret false
  end
  paths = new uchar 103 0
  put paths 0 2
  put paths 2 33
  put paths 4 46
  as_name nonce part paths 5 32
  put paths 37 64
  hash = new uchar 32 0
  ctx = new ulong 40 0
  sha256_init ctx
  sha256_update ctx receipt
  sha256_final ctx hash
  as_name hash part paths 39 64
  tmp = fopen paths 4 33 as_create_flags 384
  if lt tmp 0
    ret false
  end
  ok = as_write int tmp receipt
  if ok
    ok = eq fsync int tmp 0
  end
  if ne fclose int tmp 0
    ok = false
  end
  if ok
    rc = renames paths 0 len paths 1
    ok = eq rc 0
    if eq rc neg long 17
      ok = as_existing part paths 39 64 receipt
    end
    if ne rc 0
      ignored = unlink paths 4 33
    end
  else
    ignored = unlink paths 4 33
  end
  if not ok
    ret false
  end
  dirfd = fopen as_here 0 1 as_dir_flags 0
  if lt dirfd 0
    ret false
  end
  ok = eq fsync int dirfd 0
  ret and eq fclose int dirfd 0 ok
end

fn main to int
  policy = new uchar 136 0
  pk = new uchar 32 0
  claim = new uchar 65536 0
  sig = new uchar 64 0
  if not as_read 3 policy
    ret 1
  end
  if not as_read 4 pk
    ret 1
  end
  if not as_read 0 part claim 0 184
    ret 2
  end
  if not as_allowed claim policy
    ret 3
  end
  if not as_agent pk claim sig
    ret 4
  end
  receipt = new uchar 248 0
  for i ulong 184
    put receipt i get claim i
  end
  for i ulong 64
    put receipt add 184 i get sig i
  end
  if not as_record receipt
    ret 5
  end
  if not as_write 1 sig
    ret 6
  end
  ret 0
end

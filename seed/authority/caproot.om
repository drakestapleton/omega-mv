note SPDX-License-Identifier: AGPL-3.0-only
note Linux hosted Arboris dispatch admission. The trusted launch supervisor
note installs a read-only MAP_SHARED view of its RxCapRoot.ro_fd. The mapping
note token and authenticated subject must never come from the graph or request.
note The fixed resource "ARBRGB10" is local to this root. RX_RIGHT_EFFECT is 4.
note Scope is a point-in-time check. The dispatcher owns serialization with
note revocation, QMD publication and subsequent fence settlement.
om2
const arboris_gpu_resource ulong 0x4152425247423130

fn arboris_root_entry table long id ulong gen ulong epoch ulong tick ulong to bool
  pos = add 32 mul id 88
  if or ne mapget table pos 4 id ne mapget table add pos 8 8 gen
    ret false
  end
  if or ne mapget table add pos 16 4 1 ne mapget table add pos 40 8 epoch
    ret false
  end
  expiry = mapget table add pos 48 8
  ret or eq expiry 0 lt tick expiry
end

fn arboris_root_chain table long handle view ulong 2 subject ulong epoch ulong to bool
  id = get handle 0
  gen = get handle 1
  tick = mapget table 24 8
  for depth ulong 9
    if ge id 256
      ret false
    end
    if not arboris_root_entry table id gen epoch tick
      ret false
    end
    pos = add 32 mul id 88
    if eq depth 0
      if ne mapget table add pos 24 4 subject
        ret false
      end
      if eq and mapget table add pos 28 4 4 0
        ret false
      end
      if ne mapget table add pos 32 8 arboris_gpu_resource
        ret false
      end
    end
    id = mapget table add pos 56 4
    if eq id 0xffffffff
      ret true
    end
    gen = mapget table add pos 64 8
  end
  ret false
end

fn caproot_validate table long subject ulong handle view ulong 2 meta view ulong 16 to bool
  if or le table 0 gt subject 0xffffffff
    ret false
  end
  if or eq get handle 1 0 ne get handle 1 get meta 8
    ret false
  end
  if or ne get meta 0 0x4152425200000001 eq get meta 7 0
    ret false
  end
  if or ne mapget table 0 4 0x50414358 ne mapget table 4 4 256
    ret false
  end
  for attempt ulong 16
    seq = mapget table 8 8
    if eq and seq 1 0
      epoch = mapget table 16 8
      ok = false
      if eq epoch get meta 7
        ok = arboris_root_chain table handle subject epoch
      end
      if eq mapget table 8 8 seq
        ret ok
      end
    end
    cpurelax
  end
  ret false
end

note c2om scalar stage (ledger L418 S2): the int-only C subset on stdin, Omegese on stdout, atomic refusal on stderr.
note Fixed pools; names are compared by full byte spans and renamed vN/fN; expression values go to temps tN.
note Accepted: int functions of 0..6 int parameters, int locals in blocks, return, if/else, while, getchar,
note putchar, decimal literals, + - * / % == != < <= > >= & | ^ and unary - + ! ~. Everything else is refused by name.
global src uchar 1048576
global size ulong 1
global pos ulong 1
global line ulong 1
global tok ulong 1
global start ulong 1
global width ulong 1
global number ulong 1
global output uchar 4194304
global used ulong 1
global ns ulong 4096
global nl ulong 4096
global nk ulong 4096
global na ulong 4096
global names ulong 1
global base ulong 1
global curfn ulong 1
global mainid ulong 1
global depth ulong 1
global ak ulong 65536
global al ulong 65536
global ar ulong 65536
global ae ulong 65536
global nodes ulong 1
global as ulong 65536

fn emit b uchar to void
n = get used 0
if ge n 4194304
exit 65
end
put output n b
put used 0 add n 1
end

fn decimal v ulong to void
a = new uchar 20 0
n = ulong 0
x = v
put a n uchar add rem x 10 48
n = add n 1
x = div x 10
while gt x 0
put a n uchar add rem x 10 48
n = add n 1
x = div x 10
end
while gt n 0
n = sub n 1
emit get a n
end
end
note Output fragments, each ending in @, numbered from 1 in this order; say N writes fragment N.
text frags "fn @main@f@v@ int@ to int\n@ = int @\n@end\n@ret @if ne @ 0\n@else\n@while ne @ = @add @sub @mul @div @rem @cb eq @cb ne @cb lt @cb le @cb gt @cb ge @neg @cb eq @cg@cp@int @not @and @or @xor @t@"
fn say id ulong to void
p = ulong 0
k = ulong 1
while lt k id
while ne get frags p 64
p = add p 1
end
p = add p 1
k = add k 1
end
while ne get frags p 64
emit get frags p
p = add p 1
end
end

note Refusal reasons, numbered from 1, each ending in a space. A refusal discards all output (atomic).
text rhead "c2om: R_"
text rtail " at line "
text rnames "SYNTAX CAPACITY NUMBER PREPROCESSOR POINTER_ALIAS UNION STRUCT_FR2 ALLOCATION VARARGS CAST_OR_TYPE CONTROL NAME SCOPE EFFECT_ORDER SHORT_CIRCUIT ARRAY LITERAL IO MAIN PARAMETERS "
fn refuse id ulong to void
put used 0 0
i = ulong 0
while lt i len rhead
emit get rhead i
i = add i 1
end
p = ulong 0
k = ulong 1
while lt k id
while ne get rnames p 32
p = add p 1
end
p = add p 1
k = add k 1
end
while ne get rnames p 32
emit get rnames p
p = add p 1
end
i = ulong 0
while lt i len rtail
emit get rtail i
i = add i 1
end
decimal get line 0
emit 10
w = write 2 output 0 get used 0
exit 65
end

text keys "int void return if else while getchar putchar main union struct malloc calloc realloc free goto switch for do break continue sizeof typedef unsigned long short char float double volatile restrict enum extern static const "
note Keyword token = 300 plus position in keys; every keyword ends in a space, so the scan never reads past the text. Names = 256, decimal = 257.
fn keyword to ulong
p = ulong 0
k = ulong 300
while lt p len keys
q = p
while ne get keys q 32
q = add q 1
end
if eq sub q p get width 0
i = ulong 0
same = true
while lt i get width 0
c = get src add get start 0 i
if ne c get keys add p i
same = false
end
i = add i 1
end
if same
ret k
end
end
p = add q 1
k = add k 1
end
ret 256
end

fn letter b uchar to bool
ret or or and ge b 65 le b 90 and ge b 97 le b 122 eq b 95
end
fn digit b uchar to bool
ret and ge b 48 le b 57
end
note omc gives a function 16 registers and each get of a global costs several; small helpers keep loop heads within that.
fn inside to bool
p = get pos 0
ret lt p get size 0
end
fn at p ulong to uchar
ret get src p
end
fn cur to uchar
ret at get pos 0
end
fn advance to void
if eq cur 10
put line 0 add get line 0 1
end
put pos 0 add get pos 0 1
end

note next scans comments and whitespace, never delegates preprocessing to a C compiler.
fn next to void
skip = true
while skip
skip = false
while and inside le cur 32
if eq cur 0
refuse 1
end
advance
end
p = get pos 0
if and lt add p 1 get size 0 eq get src p 47
b = get src add p 1
if eq b 47
while and inside ne cur 10
advance
end
skip = true
end
if eq b 42
advance
advance
closed = false
going = true
while going
q = add get pos 0 1
if ge q get size 0
going = false
else
if and eq cur 42 eq at q 47
advance
advance
closed = true
going = false
else
advance
end
end
end
if not closed
refuse 1
end
skip = true
end
end
end
put start 0 get pos 0
put width 0 0
if ge get pos 0 get size 0
put tok 0 0
ret
end
b = cur
if letter b
advance
while and inside or letter cur digit cur
advance
end
put width 0 sub get pos 0 get start 0
k = keyword
put tok 0 k
if eq k 309
refuse 6
end
if eq k 310
refuse 7
end
if and ge k 311 le k 314
refuse 8
end
if and ge k 315 le k 320
refuse 11
end
if ge k 321
refuse 10
end
ret
end
if digit b
v = ulong 0
while and inside digit cur
v = add mul v 10 sub ulong cur 48
if gt v 2147483647
refuse 3
end
advance
end
put width 0 sub get pos 0 get start 0
if and gt get width 0 1 eq b 48
refuse 3
end
if and inside letter cur
refuse 3
end
put number 0 v
put tok 0 257
ret
end
advance
c = cur
put tok 0 ulong b
put width 0 1
if eq b 35
refuse 4
end
if or eq b 34 eq b 39
refuse 17
end
if or eq b 91 eq b 93
refuse 16
end
if eq b 46
refuse 9
end
if or eq b 38 eq b 124
if eq c b
refuse 15
end
end
if and or or eq b 61 eq b 33 or eq b 60 eq b 62 eq c 61
advance
put tok 0 add ulong b 128
ret
end
if or and eq b 43 eq c 43 and eq b 45 eq c 45
refuse 14
end
end

fn expect k ulong to void
if ne get tok 0 k
refuse 1
end
next
end
fn isname to bool
ret or eq get tok 0 256 eq get tok 0 308
end
fn equalname id ulong to bool
if ne get nl id get width 0
ret false
end
i = ulong 0
w = get width 0
a = get ns id
s = get start 0
while lt i w
if ne at add a i at add s i
ret false
end
i = add i 1
end
ret true
end
fn lookup to ulong
n = get names 0
while gt n 0
n = sub n 1
if equalname n
ret add n 1
end
end
ret 0
end
fn addname kind ulong to ulong
if not isname
if eq get tok 0 42
refuse 5
end
refuse 12
end
if ne lookup 0
refuse 13
end
n = get names 0
if ge n 4096
refuse 2
end
put ns n get start 0
put nl n get width 0
put nk n kind
put na n 0
put names 0 add n 1
next
ret n
end
fn ename id ulong to void
if eq get nk id 1
if eq add id 1 get mainid 0
say 2
ret
end
say 3
else
say 4
end
decimal id
end
fn node k ulong a ulong b ulong effect ulong to ulong
n = get nodes 0
if ge n 65536
refuse 2
end
put nodes 0 add n 1
put ak n k
put al n a
put ar n b
put ae n effect
ret n
end
fn precedence k ulong to ulong
if or eq k 42 or eq k 47 eq k 37
ret 10
end
if or eq k 43 eq k 45
ret 9
end
if or or eq k 60 eq k 62 or eq k 188 eq k 190
ret 7
end
if or eq k 189 eq k 161
ret 6
end
if eq k 38
ret 5
end
if eq k 94
ret 4
end
if eq k 124
ret 3
end
ret 0
end

note Pratt reader; call arguments are a linked list of nodes (kind 260).
note At most one call per expression: no reliance on C's unspecified operand evaluation order.
fn expr minimum ulong to ulong
put depth 0 add get depth 0 1
if gt get depth 0 128
refuse 2
end
k = get tok 0
lhs = ulong 0
if eq k 257
lhs = node 257 get number 0 0 0
next
else
if eq k 40
next
lhs = expr 1
expect 41
else
if or or eq k 45 eq k 33 or eq k 43 eq k 126
next
lhs = expr 11
if ne k 43
lhs = node add k 512 lhs 0 get ae lhs
end
else
if or isname or eq k 306 eq k 307
id = ulong 0
if or eq k 306 eq k 307
id = add k 1000
else
found = lookup
if eq found 0
refuse 12
end
id = sub found 1
end
next
if eq get tok 0 40
if lt id 1000
if ne get nk id 1
refuse 12
end
end
next
head = ulong 0
tail = ulong 0
argc = ulong 0
while ne get tok 0 41
a = expr 1
if ne get ae a 0
refuse 14
end
cell = node 260 a 0 0
if eq head 0
head = cell
else
put ar tail cell
end
tail = cell
argc = add argc 1
if eq get tok 0 44
next
if eq get tok 0 41
refuse 1
end
else
if ne get tok 0 41
refuse 1
end
end
end
expect 41
want = ulong 0
if eq id 1307
want = 1
else
if lt id 1000
want = get na id
end
end
if ne argc want
refuse 20
end
lhs = node 259 id head 1
else
if ge id 1000
refuse 12
end
if ne get nk id 2
refuse 12
end
lhs = node 258 id 0 0
end
else
if or eq k 42 eq k 38
refuse 5
end
if eq k 300
refuse 10
end
refuse 1
end
end
end
end
go = true
while go
k = get tok 0
prec = precedence k
if or eq prec 0 lt prec minimum
go = false
else
next
rhs = expr add prec 1
effects = add get ae lhs get ae rhs
if gt effects 1
refuse 14
end
lhs = node k lhs rhs effects
end
end
put depth 0 sub get depth 0 1
ret lhs
end

fn leaf n ulong to bool
k = get ak n
ret or eq k 257 eq k 258
end

note opnd writes one operand: a typed number, a variable, or the temp t<s> that lower left the value in.
fn opnd n ulong to void
k = get ak n
if eq k 257
say 31
decimal get al n
ret
end
if eq k 258
ename get al n
ret
end
say 36
decimal get as n
end

fn tdef s ulong to void
say 36
decimal s
say 7
end

note opword maps an operator node kind to its Omega word (fragment number).
fn opword k ulong to ulong
if eq k 43
ret 16
end
if eq k 45
ret 17
end
if eq k 42
ret 18
end
if eq k 47
ret 19
end
if eq k 37
ret 20
end
if eq k 189
ret 21
end
if eq k 161
ret 22
end
if eq k 60
ret 23
end
if eq k 188
ret 24
end
if eq k 62
ret 25
end
if eq k 190
ret 26
end
if eq k 557
ret 27
end
if eq k 545
ret 28
end
if eq k 638
ret 32
end
if eq k 38
ret 33
end
if eq k 124
ret 34
end
ret 35
end

note lower writes one line per operation, innermost first, into temps t<s>, t<s+1>, ...: no value waits
note in a hidden register across lines, so omc's 16 registers bound the tree height, not its size.
note The reader allows at most one call per expression, so this order gives C's result.
fn lower n ulong s ulong to void
put as n s
if leaf n
ret
end
k = get ak n
a = get al n
b = get ar n
if eq k 259
j = s
c = b
while ne c 0
x = get al c
lower x j
if not leaf x
j = add j 1
end
c = get ar c
end
tdef s
if eq a 1306
say 29
else
if eq a 1307
say 30
else
ename a
end
end
c = b
while ne c 0
emit 32
opnd get al c
c = get ar c
end
say 8
ret
end
lower a s
if gt k 512
tdef s
say opword k
opnd a
if eq k 545
say 12
else
say 8
end
ret
end
sb = s
if not leaf a
sb = add s 1
end
lower b sb
tdef s
say opword k
opnd a
emit 32
opnd b
say 8
end

note Every statement returns whether it ends all paths. A declaration must sit directly in a block,
note and a block's names end with it, as Omega's do. A while re-evaluates its condition lines each pass.
fn statement level ulong inblock bool to bool
if gt level 128
refuse 2
end
k = get tok 0
if eq k 123
next
saved = get names 0
dead = false
while ne get tok 0 125
if dead
refuse 11
end
dead = statement add level 1 true
end
next
put names 0 saved
ret dead
end
if eq k 300
if not inblock
refuse 13
end
next
id = addname 2
expect 61
a = expr 1
lower a 0
ename id
say 7
opnd a
say 8
expect 59
ret false
end
if eq k 302
next
a = expr 1
lower a 0
say 10
opnd a
say 8
expect 59
ret true
end
if eq k 303
next
expect 40
a = expr 1
expect 41
lower a 0
say 11
opnd a
say 12
dead = statement add level 1 false
if eq get tok 0 304
next
say 13
other = statement add level 1 false
dead = and dead other
else
dead = false
end
say 9
ret dead
end
if eq k 305
next
expect 40
a = expr 1
expect 41
lower a 0
say 14
opnd a
say 12
body = statement add level 1 false
if not body
lower a 0
end
say 9
ret false
end
if isname
found = lookup
if ne found 0
id = sub found 1
if eq get nk id 2
next
expect 61
a = expr 1
lower a 0
ename id
say 15
opnd a
say 8
expect 59
ret false
end
end
end
if eq k 59
next
ret false
end
a = expr 1
lower a 0
expect 59
ret false
end

fn function to void
expect 300
ismain = eq get tok 0 308
id = addname 1
put curfn 0 id
put base 0 get names 0
if ismain
if ne get mainid 0 0
refuse 19
end
put mainid 0 add id 1
end
say 1
ename id
expect 40
argc = ulong 0
if eq get tok 0 301
next
else
if ne get tok 0 41
more = true
while more
expect 300
arg = addname 2
emit 32
ename arg
say 5
argc = add argc 1
if gt argc 6
refuse 20
end
if eq get tok 0 44
next
else
more = false
end
end
end
end
expect 41
if and ismain ne argc 0
refuse 19
end
put na id argc
say 6
if ne get tok 0 123
refuse 1
end
dead = statement 0 true
if not dead
if ismain
say 10
decimal 0
say 8
else
refuse 11
end
end
say 9
put names 0 get base 0
end

text prelude "note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.\nnote cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.\nglobal cio uchar 1\nfn cb c bool to int\nif c\nret 1\nend\nret 0\nend\nfn cg to int\nn = read 0 cio 0 1\nif eq n 1\nret int get cio 0\nend\nret -1\nend\nfn cp x int to int\nb = uchar and x 255\nput cio 0 b\nn = write 1 cio 0 1\nif eq n 1\nret int b\nend\nret -1\nend\n"
fn main to int
put line 0 1
put nodes 0 1
more = true
while more
n = get size 0
if ge n 1048575
refuse 2
end
r = read 0 src n sub 1048575 n
if lt r 0
refuse 18
end
if eq r 0
more = false
else
put size 0 add n ulong r
end
end
i = ulong 0
while lt i len prelude
emit get prelude i
i = add i 1
end
next
while ne get tok 0 0
function
end
if eq get mainid 0 0
refuse 19
end
n = get used 0
off = ulong 0
while lt off n
r = write 1 output off sub n off
if le r 0
exit 74
end
off = add off ulong r
end
ret 0
end

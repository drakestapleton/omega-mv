note Linux transport for http-core.om. http.om is the byte-for-byte concatenation of these units.
note htrecv/htsend are nonblocking: count, EOF, or negative errno. htwait takes nanoseconds.
fn htclock to long
ret monons
end
fn htwait fd int ev int iv long to long
ret waitio fd ev iv
end
fn htrecv fd int io edit uchar * off ulong n ulong to long
ret recv fd io off n 64
end
fn htsend fd int io view uchar * off ulong n ulong to long
ret send fd io off n 64
end
fn htclose fd int to long
ret fclose fd
end
fn hnodel fd int to long
one = new uchar 4 0
put one 0 1
ret sockopt fd 6 1 one 0 4
end
note hlisten: socket, SO_REUSEADDR, bind a (exactly the sockaddr bytes), listen, and write the
note bound address back into a (so port 0 reports the ephemeral port). Returns the listening fd.
fn hlisten a edit uchar * backlog int to long
one = new uchar 4 0
put one 0 1
fd = socknew hfam a 526337 0
if lt fd 0
ret fd
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd a 0 len a
end
if eq r 0
r = listen int fd backlog
end
if eq r 0
k = sockname int fd a 0 len a
if lt k 0
r = k
end
end
if ne r 0
c = fclose int fd
ret r
end
ret fd
end
note haccept: wait at most tmo ns (negative = forever) for a connection; returns its fd
fn haccept lfd int tmo long to long
w = waitio lfd 1 tmo
if eq w 0
ret HETIME
end
if lt w 0
ret w
end
c = accept lfd 526336
if lt c 0
ret c
end
q = hnodel int c
ret c
end
note hdial: nonblocking connect bounded by tmo ns; returns the connected fd or closes it
fn hdial a view uchar * tmo long to long
fd = socknew hfam a 526337 0
if lt fd 0
ret fd
end
r = connect int fd a 0 len a
if eq r -115
w = waitio int fd 4 tmo
if le w 0
c = fclose int fd
if eq w 0
ret HETIME
end
ret w
end
r = connect int fd a 0 len a
if eq r -106
r = 0
end
end
if ne r 0
c = fclose int fd
ret r
end
q = hnodel int fd
ret fd
end

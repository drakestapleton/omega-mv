note seed/json/tests/big.om: parse up to 4 MiB of JSON from stdin with seed/json (json/growing: no 983040-byte bound of
note the library). The input is a local of main and the tape a local of jparse, so neither function passes the
note omc limit of 4 MiB of local arrays. argv[1], when present, is the size limit given to js_init (decimal). Exit 0
note parsed, 2 js_init refused, 10 + error code when js_parse refused (15 = over the size limit).
fn jparse src view uchar * n ulong lim ulong to int
tape = new uint 262144 0
r = js_init tape lim 512
if lt r 0
ret 2
end
r2 = js_parse src tape n
if lt r2 0
ret add 10 int js_hg tape jsherr
end
ret 0
end
fn arglim to ulong
if ne argcnt 2
ret 4194304
end
d = new uchar 16 0
k2 = argread 1 d 0 16
lim = ulong 0
i = ulong 0
while lt i ulong k2 bound 16
lim = add mul lim 10 ulong sub get d i 48
i = add i 1
end
ret lim
end
fn main to int
src = new uchar 4194304 0
n = ulong 0
while lt n 4194304 bound 4194304
k = read 0 src n sub 4194304 n
if le k 0
break
end
n = add n ulong k
end
ret jparse src n arglim
end

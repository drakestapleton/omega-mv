note SPDX-License-Identifier: AGPL-3.0-only
note Critical source profile. Compile the checked unit too; this is not a parser/typechecker.
note Full-byte token identity, finite pools, fail-closed capacity checks. See README.
global src uchar 65536
global off ulong 16384
global siz ulong 16384
global ls ulong 4096
global lc ulong 4096
global lf ulong 4096
global dep ulong 4096
global fs ulong 128
global fe ulong 128
global nm ulong 128
global fx uchar 128
global mem ulong 128
global edges uchar 16384
global weak uchar 16384
global reach uchar 16384
global alive uchar 128
global ko ulong 64
global kl ulong 64
global st ulong 8
global host ulong 128
global hb uchar 16384
global arg uchar 4096
global ob uchar 24
text keys "note fn end if else while for bound new global text const to ret exit trap put requires ensures invariant om2 release = len ulong uint ushort uchar long int short byte view edit own add gt depth p10 effect allow E1 pure main"
text hp "seed/effects/effects.om"
text tpre "text tab "
text pass "PROFILE-PASS\n"
text bad "PROFILE-REFUSED:"
text rules "B1B2B3E1X1P1C1"
text lpre ":"
text inv "PROFILE-INVALID\n"
text use "profile [bounds] [SOURCE ...] < unit.om\n"
text bmode "bounds"
fn stop code int to void
if ne write 1 inv 0 len inv long len inv
exit 4
end
exit code
end
note Rules: 0 B1 loop bound, 1 B2 recursion, 2 B3 allocation, 3 E1 checked result, 4 X1 effect boundary, 5 P1 pure, 6 C1 contract mode.
fn refuse rule ulong l ulong to void
if ne write 1 bad 0 len bad long len bad
exit 4
end
if ne write 1 rules mul rule 2 2 2
exit 4
end
if ne write 1 lpre 0 len lpre long len lpre
exit 4
end
put ob 23 10
v = add l 1
i = ulong 23
for j ulong 20 bound 20
i = sub i 1
put ob i uchar add 48 rem v 10
v = div v 10
if eq v 0
break
end
end
if ne write 1 ob i sub 24 i long sub 24 i
exit 4
end
exit 1
end
fn init to void
s = ulong 0
k = ulong 0
for i ulong len keys
if eq get keys i 32
put ko k s
put kl k sub i s
k = add k 1
s = add i 1
end
end
put ko k s
put kl k sub len keys s
end
fn keyis t ulong k ulong to bool
if eq t 0
ret false
end
if ne get siz t get kl k
ret false
end
o = get ko k
for j ulong get siz t bound 63
x = get src add get off t j
if ne x get keys add o j
ret false
end
end
ret true
end
fn word t ulong to ulong
if or eq t 0 gt get siz t 8
ret 0
end
v = ulong 0
for j ulong get siz t bound 8
c = ulong get src add get off t j
v = or v shl c mul j 8
end
ret v
end
fn at l ulong p ulong to ulong
if ge p get lc l
ret 0
end
ret add get ls l p
end
fn is l ulong p ulong k ulong to bool
ret keyis at l p k
end
fn same a ulong b ulong to bool
if or eq a 0 eq b 0
ret false
end
if ne get siz a get siz b
ret false
end
for j ulong get siz a bound 63
x = get src add get off a j
y = get src add get off b j
if ne x y
ret false
end
end
ret true
end
fn number t ulong to ulong
if eq t 0
ret 1048577
end
v = ulong 0
for j ulong get siz t bound 63
c = get src add get off t j
if or lt c 48 gt c 57
ret 1048577
end
if gt v 1048576
ret 1048577
end
v = add mul v 10 sub ulong c 48
end
ret v
end
fn value t ulong to ulong
v = number t
if le v 1048576
ret v
end
for l ulong get st 1 bound 4096
if is l 0 11
if same t at l 1
ret number at l 3
end
end
end
ret 1048577
end
fn func t ulong to ulong
for f ulong get st 2 bound 128
if same t get nm f
ret f
end
end
ret 128
end
fn token a ulong n ulong to void
if eq n 0
ret
end
if gt n 63
stop 3
end
t = add get st 0 1
if ge t 16384
stop 3
end
put off t a
put siz t n
put st 0 t
l = get st 1
if eq get lc l 0
put ls l t
end
put lc l add get lc l 1
end
fn blank c ulong to bool
if or eq c 32 eq c 9
ret true
end
if or eq c 13 eq c 40
ret true
end
ret eq c 41
end
fn tabpre i ulong to bool
for k ulong len tpre
if ne get hb add sub i len tpre k get tpre k
ret false
end
end
ret true
end
fn lex n ulong to void
a = ulong 0
size = ulong 0
quote = false
esc = false
skip = false
for i ulong n bound 65536
c = get src i
if eq c 10
token a size
size = ulong 0
quote = false
esc = false
skip = false
l = add get st 1 1
if ge l 4096
stop 3
end
put st 1 l
continue
end
if skip
continue
end
if quote
if esc
esc = false
else
if eq c 92
esc = true
else
if eq c 34
quote = false
end
end
end
continue
end
if eq c 34
token a size
size = ulong 0
quote = true
continue
end
if blank ulong c
token a size
size = ulong 0
note Preserve only p10 annotations; ordinary comments need no bounded token storage.
l = get st 1
if ge get lc l 2
if and is l 0 0 not is l 1 38
skip = true
end
end
continue
end
if eq size 0
a = i
end
size = add size 1
end
token a size
put st 1 add get st 1 1
end
fn hosts to void
fd = fopen hp 0 len hp 0 0
if lt fd 0
stop 3
end
n = read int fd hb 0 len hb
if ne fclose int fd 0
stop 3
end
if le n 0
stop 3
end
note Find the exact authoritative effects table prefix, then decode only its first column.
a = ulong 0
found = false
for i ulong ulong n bound 16384
c = get hb i
if ge i len tpre
if and eq c 34 tabpre i
a = add i 1
found = true
break
end
end
end
if not found
stop 3
end
hdecode a ulong n
end
note cnt 9 marks a row whose first column was already stored.
fn hdecode a ulong n ulong to void
w = ulong 0
cnt = ulong 0
for j ulong sub n a bound 16384
c = get hb add a j
if eq c 34
if eq get st 3 0
stop 3
end
ret
end
if eq c 110
if eq get hb sub add a j 1 92
w = ulong 0
cnt = ulong 0
continue
end
end
if lt cnt 9
if eq c 32
k = get st 3
if ge k 128
stop 3
end
put host k w
put st 3 add k 1
cnt = ulong 9
else
if ge cnt 8
stop 3
end
w = or w shl ulong c mul cnt 8
cnt = add cnt 1
end
end
end
stop 3
end
fn ishost t ulong to bool
w = word t
for i ulong get st 3 bound 128
if eq w get host i
ret true
end
end
ret false
end
fn declarations to void
f = ulong 128
d = ulong 0
for l ulong get st 1 bound 4096
if is l 0 1
if ne d 0
stop 3
end
f = get st 2
if ge f 128
stop 3
end
put fs f l
put nm f at l 1
put st 2 add f 1
if gt l 0
p = sub l 1
if and is p 0 0 and is p 1 38 is p 2 39
put fx f 1
end
if and is p 0 0 and is p 1 38 is p 2 42
put fx f 2
end
end
d = ulong 1
else
if is l 0 2
if eq d 0
stop 3
end
d = sub d 1
if eq d 0
put fe f l
end
end
end
put lf l f
put dep l d
if or is l 0 3 or is l 0 5 is l 0 6
d = add d 1
end
end
if or ne d 0 eq get st 2 0
stop 3
end
end
fn exempt l ulong to bool
if eq l 0
ret false
end
p = sub l 1
ret and gt get lc p 4 and is p 0 0 and is p 1 38 and is p 2 40 is p 3 41
end
fn mentions k ulong name ulong to bool
start = ulong 0
if is k 1 22
start = ulong 2
end
for p ulong sub get lc k start bound 16384
t = at k add p start
if same name t
ret true
end
end
ret false
end
note Walk the straight-line continuation: leave blocks outward, skip the sibling else branch.
fn used l ulong name ulong to bool
d = get dep l
e = get fe get lf l
sk = ulong 0
for j ulong sub e l bound 4096
k = add add l j 1
dk = get dep k
if lt dk d
d = dk
end
if ne sk 0
if ge dk sk
continue
end
sk = ulong 0
end
if is k 0 0
continue
end
if and eq dk d is k 0 4
sk = d
continue
end
if mentions k name
ret true
end
if eq dk d
if and is k 1 22 same name at k 0
ret false
end
if or is k 0 13 or is k 0 14 is k 0 15
ret false
end
end
end
ret false
end
note Size of t if line r declares it (global, text or same-function new); 0 if it does not.
fn dsize r ulong t ulong fl ulong to ulong
if and is r 0 9 same at r 1 t
ret value at r 3
end
if and is r 0 10 same at r 1 t
note Source span conservatively includes the declaration words, quotes and escapes.
q = add r 1
if lt q get st 1
if gt get ls q 0
ret sub get off get ls q get off at r 0
end
end
ret 1048577
end
if ne get lf r fl
ret 0
end
if and is r 1 22 and is r 2 8 same at r 0 t
ret value at r 4
end
ret 0
end
fn length l ulong t ulong to ulong
fl = get lf l
for r ulong l bound 4096
v = dsize r t fl
if ne v 0
ret v
end
end
if ge fl 128
ret 1048577
end
r = get fs fl
for p ulong get lc r bound 16384
if same at r p t
q = add p 1
if or is r q 32 or is r q 33 is r q 34
ret value at r add p 3
end
end
end
ret 1048577
end
fn checkloop l ulong to void
v = ulong 1048577
if is l 0 6
v = value at l 3
if is l 3 23
v = length l at l 4
end
end
for p ulong get lc l bound 16384
if is l p 7
v = value at l add p 1
end
end
if gt v 8192
refuse 0 l
end
end
fn width l ulong t ulong to ulong
if or keyis t 24 keyis t 28
ret 8
end
if or keyis t 25 keyis t 29
ret 4
end
if or keyis t 26 keyis t 30
ret 2
end
if or keyis t 27 keyis t 31
ret 1
end
refuse 2 l
ret 0
end
fn salloc l ulong f ulong to void
if is l 0 9
v = value at l 3
if gt v 65536
refuse 2 l
end
b = mul v width l at l 2
put st 5 add get st 5 b
if gt get st 5 65536
refuse 2 l
end
end
if or ge f 128 is l 0 1
ret
end
if and is l 1 22 is l 2 8
v = value at l 4
if gt v 65536
refuse 2 l
end
b = mul v width l at l 3
put mem f add get mem f b
put st 7 add get st 7 b
if gt get st 7 65536
refuse 2 l
end
if gt get mem f 65536
refuse 2 l
end
end
end
fn scalls l ulong f ulong to bool
call = false
for p ulong get lc l bound 16384
t = at l p
g = func t
if lt g 128
a = add mul f 128 g
put edges a 1
put reach a 1
call = true
end
if ishost t
call = true
if eq get st 4 0
if ne get fx f 1
refuse 4 l
end
end
end
end
ret call
end
fn scan to void
for l ulong get st 1 bound 4096
if eq get lc l 0
continue
end
if is l 0 0
continue
end
if is l 0 20
if or is l 1 21 is l 2 21
refuse 6 l
end
put st 6 1
continue
end
if or is l 0 5 is l 0 6
checkloop l
end
f = get lf l
salloc l f
if or ge f 128 is l 0 1
continue
end
call = scalls l f
if and eq get st 4 0 and is l 1 22 call
if not exempt l
if not used l at l 0
refuse 3 l
end
end
end
if eq get fx f 2
if is l 0 16
note Pure functions may inspect arrays but cannot write even borrowed state.
refuse 5 l
end
end
if or is l 0 17 or is l 0 18 is l 0 19
if ne get st 6 1
refuse 6 l
end
end
end
end
fn crow i ulong k ulong n ulong to void
a = mul i 128
b = mul k 128
for j ulong n bound 128
if ne get reach add b j 0
put reach add a j 1
end
end
end
fn closure to void
n = get st 2
for k ulong n bound 128
for i ulong n bound 128
if ne get reach add mul i 128 k 0
crow i k n
end
end
end
end
fn stops q ulong to bool
ret or is q 0 13 or is q 0 14 is q 0 15
end
note No mutation of the checked depth between guard and recursive call.
fn unchanged s ulong e ulong argt ulong to bool
for h ulong sub e s bound 4096
r = add s h
if is r 1 22
if same at r 0 argt
ret false
end
end
end
ret true
end
note Line p must be NAME = add depth 1, then if gt NAME LIM (LIM <= 64), an optional line, a stop, end.
fn guarded p ulong l ulong argt ulong name ulong to bool
if not is p 2 35
ret false
end
if not same at p 3 name
ret false
end
if ne number at p 4 1
ret false
end
q = add p 1
if not and is q 0 3 is q 1 36
ret false
end
if not same at q 2 argt
ret false
end
lim = value at q 3
if or eq lim 0 gt lim 64
ret false
end
q = add q 1
note Permit the existing nest.om stop-code call before the return.
if not stops q
q = add q 1
end
if not stops q
ret false
end
q = add q 1
if not is q 0 2
ret false
end
if ge q l
ret false
end
ret unchanged add q 1 l argt
end
note A qualifying increasing edge has a canonical dominating guard in the same block.
fn increasing l ulong t ulong f ulong to bool
name = at get fs f 2
argt = add t 1
dl = get dep l
for p ulong l bound 4096
if ne get lf p f
continue
end
if ne get dep p dl
continue
end
if not is p 1 22
continue
end
if same at p 0 argt
ret guarded p l argt name
end
end
ret false
end
note Classify one call t to g on line r of f; keep all but guarded increasing in-SCC edges.
fn redge r ulong t ulong f ulong g ulong cyclic bool to void
a = add mul f 128 g
gg = mul g 128
if eq get reach add gg g 0
put weak a 1
ret
end
inscc = and cyclic ne get reach add gg f 0
if not inscc
put weak a 1
if gt value add t 1 64
refuse 1 r
end
ret
end
if same add t 1 at get fs f 2
put weak a 1
ret
end
if not increasing r t f
refuse 1 r
end
end
fn rline r ulong f ulong cyclic bool to void
for p ulong get lc r bound 16384
t = at r p
g = func t
if lt g 128
redge r t f g cyclic
end
end
end
fn isleaf i ulong n ulong to bool
b = mul i 128
for j ulong n bound 128
if ne get weak add b j 0
if ne get alive j 0
ret false
end
end
end
ret true
end
fn prune n ulong to void
for i ulong n bound 128
put alive i 1
end
for round ulong n bound 128
for i ulong n bound 128
if isleaf i n
put alive i 0
end
end
end
end
fn recursion to void
n = get st 2
for f ulong n bound 128
h = get fs f
cyclic = ne get reach add mul f 128 f 0
if cyclic
if ne get mem f 0
refuse 1 h
end
if not is h 2 37
refuse 1 h
end
end
for l ulong sub get fe f h bound 4096
r = add add h l 1
if is r 0 0
continue
end
if and cyclic and is r 1 22 same at r 0 at h 2
refuse 1 r
end
rline r f cyclic
end
end
note DRA-311/omc leaf-removal analysis, applied after removing guarded increasing edges.
prune n
for i ulong n bound 128
if ne get alive i 0
refuse 1 get fs i
end
if eq get fx i 2
for j ulong n bound 128
if and ne get edges add mul i 128 j 0 ne get fx j 2
refuse 5 get fs i
end
end
end
end
end
fn slurp fd int n ulong to ulong
total = n
while true bound 65536
r = read fd src total sub len src total
if lt r 0
exit 4
end
if eq r 0
ret total
end
total = add total ulong r
if ge total len src
stop 3
end
end
stop 3
ret 0
end
fn main to int
init
ac = ulong argcnt
if gt ac 16
if ne write 2 use 0 len use long len use
ret 4
end
ret 2
end
first = ulong 1
if gt ac 1
m = argread 1 arg 0 len arg
mode = eq m long len bmode
if mode
for i ulong len bmode
if ne get arg i get bmode i
mode = false
end
end
end
if mode
put st 4 1
first = ulong 2
end
end
n = ulong 0
if eq ac first
n = slurp 0 0
else
for j ulong sub ac first bound 16
m = argread add first j arg 0 len arg
if or le m 0 ge m long len arg
ret 2
end
fd = fopen arg 0 ulong m 0 0
if lt fd 0
ret 4
end
n = slurp int fd n
if ne fclose int fd 0
ret 4
end
if gt n 0
if ne get src sub n 1 10
put src n 10
n = add n 1
if ge n len src
stop 3
end
end
end
end
end
if eq n 0
stop 3
end
lex n
hosts
declarations
scan
closure
recursion
if ne write 1 pass 0 len pass long len pass
ret 4
end
ret 0
end

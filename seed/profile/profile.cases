# SPDX-License-Identifier: AGPL-3.0-only
# seed/profile/profile.cases: DRA-419 critical-profile gate. Run from the repository root by
# seed/qualification/om2/gate.om (seed/profile/check.sh). Each row compiles seed/profile/profile.om with
# the pinned omc and runs it on the named sources. Rule fixtures: seed/profile/cases/<rule>-*.om.
# Expected: OM2GATE PASS cases=53 pass=53 fail=0 invalid=0 not_run=0
deadline 30
# ---- profiled modules: seed/authority action+store+lock+dispatch (full), omc recursion fixture (bounds)
unit-authority run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/authority/action.om seed/authority/store.om seed/authority/lock.om seed/authority/dispatch.om
unit-authority-bounds run seed/profile/profile.om - line:PROFILE-PASS - 0 bounds seed/authority/action.om seed/authority/store.om seed/authority/lock.om seed/authority/dispatch.om
nest-bounds run seed/profile/profile.om - line:PROFILE-PASS - 0 bounds seed/omc/tests/recursion/nest.om
ok-unit run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
ok-b2-nested run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-b2-nested.om
ok-noeq run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-noeq.om
ok-unit-stdin run seed/profile/profile.om file:seed/profile/cases/ok-unit.om line:PROFILE-PASS - 0
# ---- one refusal per enforced rule (fixtures compile with the pinned omc; the profile is stricter)
b1-while run seed/profile/profile.om - line:PROFILE-REFUSED:B1:4 - 1 seed/profile/cases/b1-while.om
b1-cap run seed/profile/profile.om - line:PROFILE-REFUSED:B1:4 - 1 seed/profile/cases/b1-cap.om
b1-var run seed/profile/profile.om - line:PROFILE-REFUSED:B1:4 - 1 seed/profile/cases/b1-var.om
b2-noguard run seed/profile/profile.om - line:PROFILE-REFUSED:B2:4 - 1 seed/profile/cases/b2-noguard.om
b2-limit run seed/profile/profile.om - line:PROFILE-REFUSED:B2:7 - 1 seed/profile/cases/b2-limit.om
b2-nodepth run seed/profile/profile.om - line:PROFILE-REFUSED:B2:2 - 1 seed/profile/cases/b2-nodepth.om
b2-entry run seed/profile/profile.om - line:PROFILE-REFUSED:B2:11 - 1 seed/profile/cases/b2-entry.om
b2-mutual run seed/profile/profile.om - line:PROFILE-REFUSED:B2:2 - 1 seed/profile/cases/b2-mutual.om
b2-reset run seed/profile/profile.om - line:PROFILE-REFUSED:B2:8 - 1 seed/profile/cases/b2-reset.om
b2-else run seed/profile/profile.om - line:PROFILE-REFUSED:B2:7 - 1 seed/profile/cases/b2-else.om
b2-arm run seed/profile/profile.om - line:PROFILE-REFUSED:B2:9 - 1 seed/profile/cases/b2-arm.om
b2-sibling run seed/profile/profile.om - line:PROFILE-REFUSED:B2:10 - 1 seed/profile/cases/b2-sibling.om
b2-noeq-nd run seed/profile/profile.om - line:PROFILE-REFUSED:B2:7 - 1 seed/profile/cases/b2-noeq-nd.om
b2-noeq-depth run seed/profile/profile.om - line:PROFILE-REFUSED:B2:2 - 1 seed/profile/cases/b2-noeq-depth.om
b3-global run seed/profile/profile.om - line:PROFILE-REFUSED:B3:2 - 1 seed/profile/cases/b3-global.om
b3-total run seed/profile/profile.om - line:PROFILE-REFUSED:B3:4 - 1 seed/profile/cases/b3-total.om
b3-new run seed/profile/profile.om - line:PROFILE-REFUSED:B3:3 - 1 seed/profile/cases/b3-new.om
b3-noeq run seed/profile/profile.om - line:PROFILE-REFUSED:B3:3 - 1 seed/profile/cases/b3-noeq.om
e1-drop run seed/profile/profile.om - line:PROFILE-REFUSED:E1:9 - 1 seed/profile/cases/e1-drop.om
e1-overwrite run seed/profile/profile.om - line:PROFILE-REFUSED:E1:6 - 1 seed/profile/cases/e1-overwrite.om
e1-else run seed/profile/profile.om - line:PROFILE-REFUSED:E1:8 - 1 seed/profile/cases/e1-else.om
e1-noeq run seed/profile/profile.om - line:PROFILE-REFUSED:E1:6 - 1 seed/profile/cases/e1-noeq.om
x1-boundary run seed/profile/profile.om - line:PROFILE-REFUSED:X1:3 - 1 seed/profile/cases/x1-boundary.om
p1-put run seed/profile/profile.om - line:PROFILE-REFUSED:P1:5 - 1 seed/profile/cases/p1-put.om
p1-call run seed/profile/profile.om - line:PROFILE-REFUSED:P1:8 - 1 seed/profile/cases/p1-call.om
c1-mode run seed/profile/profile.om - line:PROFILE-REFUSED:C1:3 - 1 seed/profile/cases/c1-mode.om
c1-release run seed/profile/profile.om - line:PROFILE-REFUSED:C1:2 - 1 seed/profile/cases/c1-release.om
# ---- pre-fix controls on the real modules: dropped release error (E1), unbounded lock retry (B1)
e1-dispatch-prefix run seed/profile/profile.om - line:PROFILE-REFUSED:E1:58 - 1 seed/profile/cases/dispatch-prefix.om seed/authority/action.om seed/authority/store.om seed/authority/lock.om
b1-lock-unbounded run seed/profile/profile.om - line:PROFILE-REFUSED:B1:111 - 1 seed/profile/cases/lock-unbounded.om seed/authority/action.om seed/authority/store.om seed/authority/dispatch.om
# ---- bounds mode skips E1/X1 only
bounds-skips-x1 run seed/profile/profile.om - line:PROFILE-PASS - 0 bounds seed/profile/cases/x1-boundary.om
bounds-skips-e1 run seed/profile/profile.om - line:PROFILE-PASS - 0 bounds seed/profile/cases/e1-drop.om
bounds-keeps-b2 run seed/profile/profile.om - line:PROFILE-REFUSED:B2:4 - 1 bounds seed/profile/cases/b2-noguard.om
bounds-keeps-c1 run seed/profile/profile.om - line:PROFILE-REFUSED:C1:2 - 1 bounds seed/profile/cases/c1-release.om
# ---- bounded memory and stop: every capacity fails closed, hostile bytes terminate
cap-functions run seed/profile/profile.om - line:PROFILE-INVALID - 3 seed/profile/cases/many-fns.om
# min.om (100 bytes, 4 lines) plus stdin as a second source: limits are 65535 bytes, 4095 lines, 63-byte tokens
cap-source-max run seed/profile/profile.om rep:32:65434 line:PROFILE-PASS - 0 seed/profile/cases/min.om /dev/stdin
cap-source-over run seed/profile/profile.om rep:32:65435 line:PROFILE-INVALID - 3 seed/profile/cases/min.om /dev/stdin
cap-source-huge run seed/profile/profile.om rep:10:70000 line:PROFILE-INVALID - 3
cap-lines-max run seed/profile/profile.om rep:10:4091 line:PROFILE-PASS - 0 seed/profile/cases/min.om /dev/stdin
cap-lines-over run seed/profile/profile.om rep:10:4092 line:PROFILE-INVALID - 3 seed/profile/cases/min.om /dev/stdin
cap-token-max run seed/profile/profile.om rep:97:63 line:PROFILE-PASS - 0 seed/profile/cases/min.om /dev/stdin
cap-token-over run seed/profile/profile.om rep:97:64 line:PROFILE-INVALID - 3 seed/profile/cases/min.om /dev/stdin
empty run seed/profile/profile.om - line:PROFILE-INVALID - 3
stop-random run seed/profile/profile.om rnd:7:60000 line:PROFILE-INVALID - 3
stop-seq run seed/profile/profile.om seq:60000 line:PROFILE-INVALID - 3
usage-args run seed/profile/profile.om - - any 2 x x x x x x x x x x x x x x x x x
missing-file run seed/profile/profile.om - - - 4 seed/profile/cases/absent.om

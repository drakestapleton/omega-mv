# SPDX-License-Identifier: AGPL-3.0-only
# seed/profile/mutants.cases: one profile.om mutant per enforced rule (four for B2: guard limit,
# DRA-311 leaf removal, stop in the guard's then-block, same block instance). Each mutant disables one
# check; its control row (ok-unit) must PASS and its kill row (the matching rule fixture) must FAIL.
# Expected: OM2GATE FAIL cases=20 pass=10 fail=10 invalid=0 not_run=0
# --- mutant b1-cap
subst seed/profile/mutants/b1-cap.from seed/profile/mutants/b1-cap.to
ctl-b1-cap run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b1-cap.from seed/profile/mutants/b1-cap.to
m-b1-cap run seed/profile/profile.om - line:PROFILE-REFUSED:B1:4 - 1 seed/profile/cases/b1-while.om
# --- mutant b2-limit
subst seed/profile/mutants/b2-limit.from seed/profile/mutants/b2-limit.to
ctl-b2-limit run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b2-limit.from seed/profile/mutants/b2-limit.to
m-b2-limit run seed/profile/profile.om - line:PROFILE-REFUSED:B2:7 - 1 seed/profile/cases/b2-limit.om
# --- mutant b2-leaf
subst seed/profile/mutants/b2-leaf.from seed/profile/mutants/b2-leaf.to
ctl-b2-leaf run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b2-leaf.from seed/profile/mutants/b2-leaf.to
m-b2-leaf run seed/profile/profile.om - line:PROFILE-REFUSED:B2:2 - 1 seed/profile/cases/b2-mutual.om
# --- mutant b2-else: the optional guard line may again be any line (else included)
subst seed/profile/mutants/b2-else.from seed/profile/mutants/b2-else.to
ctl-b2-else run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b2-else.from seed/profile/mutants/b2-else.to
m-b2-else run seed/profile/profile.om - line:PROFILE-REFUSED:B2:7 - 1 seed/profile/cases/b2-else.om
# --- mutant b2-block: equal nesting depth again counts as the same block
subst seed/profile/mutants/b2-block.from seed/profile/mutants/b2-block.to
ctl-b2-block run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b2-block.from seed/profile/mutants/b2-block.to
m-b2-block run seed/profile/profile.om - line:PROFILE-REFUSED:B2:9 - 1 seed/profile/cases/b2-arm.om
# --- mutant b3-total
subst seed/profile/mutants/b3-total.from seed/profile/mutants/b3-total.to
ctl-b3-total run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/b3-total.from seed/profile/mutants/b3-total.to
m-b3-total run seed/profile/profile.om - line:PROFILE-REFUSED:B3:4 - 1 seed/profile/cases/b3-total.om
# --- mutant e1-used
subst seed/profile/mutants/e1-used.from seed/profile/mutants/e1-used.to
ctl-e1-used run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/e1-used.from seed/profile/mutants/e1-used.to
m-e1-used run seed/profile/profile.om - line:PROFILE-REFUSED:E1:9 - 1 seed/profile/cases/e1-drop.om
# --- mutant x1-effect
subst seed/profile/mutants/x1-effect.from seed/profile/mutants/x1-effect.to
ctl-x1-effect run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/x1-effect.from seed/profile/mutants/x1-effect.to
m-x1-effect run seed/profile/profile.om - line:PROFILE-REFUSED:X1:3 - 1 seed/profile/cases/x1-boundary.om
# --- mutant p1-put
subst seed/profile/mutants/p1-put.from seed/profile/mutants/p1-put.to
ctl-p1-put run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/p1-put.from seed/profile/mutants/p1-put.to
m-p1-put run seed/profile/profile.om - line:PROFILE-REFUSED:P1:5 - 1 seed/profile/cases/p1-put.om
# --- mutant c1-mode
subst seed/profile/mutants/c1-mode.from seed/profile/mutants/c1-mode.to
ctl-c1-mode run seed/profile/profile.om - line:PROFILE-PASS - 0 seed/profile/cases/ok-unit.om
subst seed/profile/mutants/c1-mode.from seed/profile/mutants/c1-mode.to
m-c1-mode run seed/profile/profile.om - line:PROFILE-REFUSED:C1:3 - 1 seed/profile/cases/c1-mode.om

note Positive unit: every rule satisfied, with each annotation form.
const LIM ulong 16
global buf uchar 64
text path "build/profile-ok"
note p10 pure
fn twice x ulong to ulong
ret add x x
end
note p10 effect
fn save n ulong to ulong
fd = fopen path 0 len path 577 384
if lt fd 0
ret 1
end
w = write int fd buf 0 n
note p10 allow E1 the write status is reported; a close error after it is not
cl = fclose int fd
if ne w long n
ret 2
end
ret 0
end
fn walk depth ulong to ulong
nd = add depth 1
if gt nd LIM
ret 0
end
ret walk nd
end
fn main to int
s = ulong 0
for i ulong len buf
s = add s twice i
end
k = ulong 0
while lt k 10 bound 10
k = add k 1
end
r = save 8
if ne r 0
ret 1
end
d = walk 0
ret int add d s
end

note Positive B2 control: guard and call in one nested block, with an inner if/else between them.
fn walk depth ulong to ulong
if lt depth 100
nd = add depth 1
if gt nd 64
ret 0
end
x = ulong 0
if eq nd 3
x = ulong 1
else
x = ulong 2
end
r = walk nd
ret add x r
end
ret 0
end
fn main to int
d = walk 0
ret int d
end

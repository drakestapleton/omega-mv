note the digit after every "case " in fb (grep -o 'case [0-9]' | tr -d 'case ' | tr -d '\n')
fn digits to void
n = get fbn 0
m = ulong 0
p = ulong 0
while lt add p 5 n bound 4194305
g = false
if eqat p casep
c = get fb add p 5
if and ge c 48 le c 57
g = true
if ge m len dg
die dbig
end
put dg m c
m = add m 1
end
end
if g
p = add p 6
else
p = add p 1
end
end
put dgn 0 m
end

fn dgok to bool
if ne get dgn 0 len want
ret false
end
for i ulong len want
if ne get dg i get want i
ret false
end
end
ret true
end


om2
note SPDX-License-Identifier: AGPL-3.0-only
note seed/profile/check.om: qualification for seed/profile (DRA-419 critical source profile) and the
note profiled authority modules. Seeded Omega, program mode, Linux AArch64. It compiles and runs the
note seeded checker (profile.om), the OM-2 conductor (seed/qualification/om2/gate.om) and the authority
note gates with the pinned omc, and compares their results.
note Build and run from the repository root:
note   mkdir -p build/seed && seed/out/omc < seed/profile/check.om > build/seed/profile-check
note   chmod +x build/seed/profile-check && build/seed/profile-check
note Exit 0 PASS (last line PROFILE CHECK PASS), 1 FAIL (PROFILE CHECK FAIL failed=N, or a compile
note failure of gate.om or profile.om), 3 NOT_RUN (no seed/out/omc, or its sha256 is not the first
note field of seed/out/omc.sha256). The sha256 is FIPS 180-4 with the constants of seed/qualification/om2/fixtures.
note Children get an empty environment (execprog); stdin and stderr are inherited unless redirected.
note Scratch: build/seed/profile, removed and recreated on every run.

text omcp "seed/out/omc"
text units "seed/out/omc.sha256"
text kdec "seed/qualification/om2/fixtures/sha256-k.dec"
text ivdec "seed/qualification/om2/fixtures/sha256-iv.dec"
text bd1 "build"
text bd2 "build/seed"
text bdir "build/seed/profile"
text slash "/"
text adir "seed/authority/"
text dotom ".om"
text dotout ".out"
text dnull "/dev/null"
text mname "src"
text gatesrc "seed/qualification/om2/gate.om"
text profsrc "seed/profile/profile.om"
text ngate "gate"
text nprof "profile"
text pcases "seed/profile/profile.cases"
text mcases "seed/profile/mutants.cases"
text ncases "cases"
text nmut "mutants"
text ncaslog "cases.log"
text nmutlog "mutants.log"
text nunit "unit.txt"
text aact "seed/authority/action.om"
text asto "seed/authority/store.om"
text alck "seed/authority/lock.om"
text adis "seed/authority/dispatch.om"
text oldlock "seed/profile/cases/lock-943d955.om"
text olddis "seed/profile/cases/dispatch-943d955.om"
text nlkold "lock-old"
text nlkout "lock-old.out"
text nfold "fault-old"
text nfout "fault-old.out"
text faction "action.om"
text fstore "store.om"
text flck "lock.om"
text fdisp "dispatch.om"
text fdtest "dispatch-test.om"
text fltest "lock-test.om"
text fstest "store-test.om"
text fotest "dispatch-order-test.om"
text fxtest "store-exact-test.om"
text fctest "store-cleanup-test.om"
text fftest "dispatch-fault-test.om"
text gdisp "dispatch-gate"
text glock "lock-gate"
text gstore "store-gate"
text gorder "dispatch-order-gate"
text gexact "store-exact-gate"
text gclean "store-cleanup-gate"
text gfault "dispatch-fault-gate"
text ldisp "action.om store.om lock.om dispatch.om dispatch-test.om"
text llock "lock.om lock-test.om"
text lstore "store.om store-test.om"
text lorder "action.om store.om dispatch.om dispatch-order-test.om"
text lexact "store.om store-exact-test.om"
text ocleanm "store-cleanup-gate.om = injected store.om store-cleanup-test.om\n"
text bcleanm "store-cleanup-gate.om is stale against store.om store-cleanup-test.om\n"
text ofaultm "dispatch-fault-gate.om = injected dispatch.om\n"
text bfaultm "dispatch-fault-gate.om is stale against action.om store.om dispatch.om dispatch-fault-test.om\n"
note store-cleanup-gate routes the store descriptor calls through the test's failure injectors:
note the first occurrence on each line is replaced, in this order.
text cf1 "fopen spath"
text ct1 "cfopen"
text cf2 "write int fd sb"
text ct2 "cwrite int fd"
text cf3 "fsync int fd"
text ct3 "cfsync int fd"
text cf4 "fclose int fd"
text ct4 "cfclose int fd"
text cf5 "renames spkt"
text ct5 "crenames"
note dispatch-fault-gate routes dispatch's actlost, actrecon and writerec results through the
note test's injectors: whole-line replacements.
text ff1 "err = actlost r"
text ft1 "err = factlost r"
text ff2 "err = actrecon r s"
text ft2 "err = factrecon r s"
text ff3 "err = writerec r"
text ft3 "err = fwriterec r"
text okp "ok   "
text badp "FAIL "
text nl "\n"
text nrnoomc "NOT_RUN profile: no omc at seed/out/omc\n"
text nrpin "NOT_RUN profile: omc is not the pinned compiler "
text nrsha "NOT_RUN profile: cannot read the SHA-256 constants in seed/qualification/om2/fixtures\n"
text tomc "omc "
text tgatecc "FAIL gate.om does not compile\n"
text tprofcc "FAIL profile.om does not compile\n"
text tprofsha "profile sha256 "
text pass53 "OM2GATE PASS cases=53 pass=53 fail=0 invalid=0 not_run=0"
text mut22 "OM2GATE FAIL cases=22 pass=11 fail=11 invalid=0 not_run=0"
text vctl "VERDICT ctl-"
text vmut "VERDICT m-"
text spass " PASS "
text sfail " FAIL "
text verdict "VERDICT"
text okcases "profile cases (53)\n"
text bdcases "profile cases\n"
text okmut "11 profile.om mutants killed, 11 controls pass\n"
text bdmut "profile mutants (gate exit "
text cpar ")\n"
text profok "PROFILE-PASS"
text okunit "authority unit profile\n"
text bdunit "authority unit: "
text teq ".om = "
text tstale ".om is stale against "
text tnocc " does not compile\n"
text texit0 " exit 0: "
text texit " exit "
text tcolon ": "
text oklk "pre-fix lock.om refused by lock-test (exit 1)\n"
text bdlk "pre-fix lock.om: lock-test exit "
text casep "case "
text want "234578"
text okfault "pre-fix dispatch.om fails fault cases 2 3 4 5 7 8 (79 77 78 79 77 78)\n"
text bdfault "pre-fix dispatch.om: fault gate exit "
text tcases " cases '"
text tquote "'\n"
text tpass "PROFILE CHECK PASS\n"
text tfail "PROFILE CHECK FAIL failed="
text dbig "FAIL check.om: input or line too large\n"
text dproc "FAIL check.om: fork, wait or memfd failed\n"
text dargs "FAIL check.om: path or argument capacity\n"
text dwipe "FAIL check.om: cannot remove build/seed/profile\n"

global pb uchar 4096
global pbn ulong 1
global av uchar 16384
global avp ulong 1
global avc ulong 1
global avl ulong 1
global fa uchar 4194304
global fan ulong 1
global fb uchar 4194304
global fbn ulong 1
global ln uchar 65536
global lnn ulong 1
global l2 uchar 65536
global pin uchar 4096
global pinn ulong 1
global hexd uchar 64
global kk uint 64
global ivs uint 8
global nums ulong 64
global hv uint 8
global ws uint 64
global st uint 8
global blk uchar 64
global bk ulong 2
global stb uchar 4
global nfail ulong 1
global wpath uchar 4096
global dg uchar 4096
global dgn ulong 1
global nb uchar 32

note ---- output ------------------------------------------------------------------------------
fn say t view uchar * to void
r = write 1 t 0 len t
end

fn num v ulong to void
n = ulong 0
x = v
while true bound 32
put nb sub 31 n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
r = write 1 nb sub 32 n n
end

fn die t view uchar * to void
r = write 1 t 0 len t
exit 1
end

fn okh to void
say okp
end

fn badh to void
put nfail 0 add get nfail 0 1
say badp
end

note ---- paths and argument lists -----------------------------------------------------------
fn pclear to void
put pbn 0 0
end

fn pcat t view uchar * to void
p = get pbn 0
n = len t
if gt add p n 4095
die dargs
end
for i ulong n
put pb add p i get t i
end
put pbn 0 add p n
end

note pb = build/seed/profile/NAME
fn bpath t view uchar * to void
pclear
pcat bdir
pcat slash
pcat t
end

fn areset to void
put avc 0 0
put avp 0 2
put av 0 0
put av 1 0
end

fn afix to void
p = get avp 0
q = get avl 0
m = sub sub p q 2
if gt m 65535
die dargs
end
put av q uchar and m 255
put av add q 1 uchar shr m 8
end

note start a new argument record
fn anew to void
p = get avp 0
if gt add p 2 len av
die dargs
end
put avl 0 p
put avp 0 add p 2
c = add get avc 0 1
put avc 0 c
put av 0 uchar and c 255
put av 1 uchar shr c 8
afix
end

fn amore t view uchar * to void
p = get avp 0
n = len t
if gt add p n len av
die dargs
end
for i ulong n
put av add p i get t i
end
put avp 0 add p n
afix
end

fn apin to void
p = get avp 0
n = get pinn 0
if gt add p n len av
die dargs
end
for i ulong n
put av add p i get pin i
end
put avp 0 add p n
afix
end

note argv[0] = build/seed/profile/NAME
fn abin t view uchar * to void
areset
anew
amore bdir
amore slash
amore t
end

note ---- children ---------------------------------------------------------------------------
note run the argument list; a negative descriptor is inherited. Shell-style status: the exit status,
note 128 + signal for a signalled child, 127 when the program is missing, 126 when it cannot run.
fn startch fi int fo int fe int ss bool to ulong
pid = fork
if lt pid 0
die dproc
end
if eq pid 0
if ge fi 0
r = dupfd fi 0 0
end
if ge fo 0
r = dupfd fo 1 0
end
if ge fe 0
r = dupfd fe 2 0
end
if ss
r = setsid
end
r = execprog av 0 get avp 0
if eq r -2
exit 127
end
exit 126
end
r = waitpid int pid stb 0 4 0
if ne r pid
die dproc
end
sg = and ulong get stb 0 127
if eq sg 0
ret ulong get stb 1
end
ret add sg 128
end

fn opr to long
ret fopen pb 0 get pbn 0 0 0
end

fn opw to long
ret fopen pb 0 get pbn 0 577 420
end

fn fclo fd long to void
if ge fd 0
r = fclose int fd
end
end

note run the argument list with stdout to the file pb (stderr too when both), stdin /dev/null when
note nul, in a new session when ss; status 1 when the output file cannot be created
fn runpb nul bool both bool ss bool to ulong
ofd = opw
if lt ofd 0
ret 1
end
ifd = long -1
if nul
ifd = fopen dnull 0 len dnull 0 0
end
efd = long -1
if both
efd = ofd
end
s = startch int ifd int ofd int efd ss
fclo ifd
fclo ofd
ret s
end

note compile the source on descriptor sfd with the pinned omc into build/seed/profile/NAME; on
note exit 0 the output is made executable (0755)
fn compfd sfd long t view uchar * to ulong
if lt sfd 0
ret 1
end
bpath t
ofd = opw
if lt ofd 0
fclo sfd
ret 1
end
areset
anew
amore omcp
s = startch int sfd int ofd -1 false
fclo sfd
fclo ofd
if eq s 0
r = chmod pb 0 get pbn 0 493
end
ret s
end

fn comptx src view uchar * t view uchar * to ulong
pclear
pcat src
fd = opr
ret compfd fd t
end

note a memfd holding fa, positioned at 0
fn famem to long
fd = memfd mname 0 len mname 0
if lt fd 0
die dproc
end
n = get fan 0
o = ulong 0
while lt o n bound 4194304
r = write int fd fa o sub n o
if le r 0
die dproc
end
o = add o ulong r
end
r = fseek int fd 0 0
if ne r 0
die dproc
end
ret fd
end

note ---- files ------------------------------------------------------------------------------
note fb = the bytes of the file pb; false when it cannot be read
fn rdb to bool
put fbn 0 0
fd = opr
if lt fd 0
ret false
end
n = ulong 0
while true bound 4194305
if eq n len fb
die dbig
end
r = read int fd fb n sub len fb n
if lt r 0
fclo fd
put fbn 0 n
ret false
end
if eq r 0
break
end
n = add n ulong r
end
fclo fd
put fbn 0 n
ret true
end

note append the bytes of the file pb to fa (cat: an unreadable file adds nothing)
fn rda to void
fd = opr
if lt fd 0
ret
end
n = get fan 0
while true bound 4194305
if eq n len fa
die dbig
end
r = read int fd fa n sub len fa n
if le r 0
break
end
n = add n ulong r
end
fclo fd
put fan 0 n
end

fn cata t view uchar * to void
pclear
pcat t
rda
end

fn cats t view uchar * to void
pclear
pcat adir
pcat t
rda
end

note fa equals fb
fn sameab to bool
n = get fan 0
if ne n get fbn 0
ret false
end
i = ulong 0
while lt i n bound 4194304
if ne get fa i get fb i
ret false
end
i = add i 1
end
ret true
end

fn faputb b uchar to void
n = get fan 0
if ge n len fa
die dbig
end
put fa n b
put fan 0 add n 1
end

note ---- lines of fb ------------------------------------------------------------------------
note index of the next newline at or after s, or the end of fb
fn lend s ulong to ulong
n = get fbn 0
e = s
while lt e n bound 4194305
if eq get fb e 10
ret e
end
e = add e 1
end
ret n
end

fn eqat p ulong t view uchar * to bool
if gt add p len t get fbn 0
ret false
end
for i ulong len t
if ne get fb add p i get t i
ret false
end
end
ret true
end

note grep -qx: some line of fb equals t
fn hasline t view uchar * to bool
n = get fbn 0
s = ulong 0
while lt s n bound 4194305
e = lend s
if eq sub e s len t
if eqat s t
ret true
end
end
s = add e 1
end
ret false
end

fn hasin s ulong e ulong t view uchar * to bool
p = s
while le add p len t e bound 4194305
if eqat p t
ret true
end
p = add p 1
end
ret false
end

fn isnm c uchar to bool
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
ret eq c 45
end

note does line [s, e) match ^PRE[a-z0-9-]*SUF
fn verok s ulong e ulong pre view uchar * suf view uchar * to bool
if gt add s len pre e
ret false
end
if eqat s pre
p = add s len pre
while lt p e bound 4194305
if isnm get fb p
p = add p 1
else
break
end
end
if gt add p len suf e
ret false
end
ret eqat p suf
end
ret false
end

note grep -c '^PRE[a-z0-9-]*SUF' over fb
fn cntver pre view uchar * suf view uchar * to ulong
n = get fbn 0
c = ulong 0
s = ulong 0
while lt s n bound 4194305
e = lend s
if verok s e pre suf
c = add c 1
end
s = add e 1
end
ret c
end

note grep -v ' PASS ' | grep '^VERDICT' over fb
fn badver to void
n = get fbn 0
s = ulong 0
while lt s n bound 4194305
e = lend s
if eqat s verdict
if hasin s e spass
else
r = write 1 fb s sub e s
say nl
end
end
s = add e 1
end
end

note tail -1 of fb: raw keeps the final newline; otherwise as $(tail -1)
fn tailln raw bool to void
n = get fbn 0
k = n
if gt n 0
if eq get fb sub n 1 10
k = sub n 1
end
end
s = k
while gt s 0 bound 4194305
if eq get fb sub s 1 10
break
end
s = sub s 1
end
if raw
r = write 1 fb s sub n s
else
r = write 1 fb s sub k s
end
end

note $(cat): fb without its trailing newlines
fn catstr to void
n = get fbn 0
while gt n 0 bound 4194305
if ne get fb sub n 1 10
break
end
n = sub n 1
end
r = write 1 fb 0 n
end

note ---- line rewriting (fb to fa) ----------------------------------------------------------
fn lnat p ulong t view uchar * to bool
if gt add p len t get lnn 0
ret false
end
for i ulong len t
if ne get ln add p i get t i
ret false
end
end
ret true
end

note ln[p .. p+fl) becomes t
fn splice p ulong fl ulong t view uchar * to void
r = add p fl
k = sub get lnn 0 r
q = add p len t
if gt add q k len ln
die dbig
end
for i ulong k
put l2 i get ln add r i
end
for i ulong len t
put ln add p i get t i
end
for i ulong k
put ln add q i get l2 i
end
put lnn 0 add q k
end

note sed s/F/T/: the first occurrence of f in ln becomes t
fn subst f view uchar * t view uchar * to void
n = get lnn 0
p = ulong 0
while le add p len f n bound 65537
if lnat p f
splice p len f t
ret
end
p = add p 1
end
end

note sed s/^F$/T/: a line equal to f becomes t
fn wsub f view uchar * t view uchar * to void
if eq get lnn 0 len f
if lnat 0 f
for i ulong len t
put ln i get t i
end
put lnn 0 len t
end
end
end

note fa += fb with mode 1 the store-cleanup injection, mode 2 the dispatch-fault injection
fn xform mode ulong to void
n = get fbn 0
s = ulong 0
while lt s n bound 4194305
e = lend s
k = sub e s
if gt k len ln
die dbig
end
for i ulong k
put ln i get fb add s i
end
put lnn 0 k
if eq mode 1
subst cf1 ct1
subst cf2 ct2
subst cf3 ct3
subst cf4 ct4
subst cf5 ct5
else
wsub ff1 ft1
wsub ff2 ft2
wsub ff3 ft3
end
for i ulong get lnn 0
faputb get ln i
end
if lt e n
faputb 10
end
s = add e 1
end
end

note fa = action.om store.om, injected D, dispatch-fault-test.om
fn faultsrc d view uchar * to void
put fan 0 0
cats faction
cats fstore
pclear
pcat d
b = rdb
xform 2
cats fftest
end

note ---- SHA-256 (FIPS 180-4), for compiler and checker identity ----------------------------
fn shasched to void
for i ulong 16
b = mul i 4
v = shl uint get blk b 24
v = or v shl uint get blk add b 1 16
v = or v shl uint get blk add b 2 8
v = or v uint get blk add b 3
put ws i v
end
for j ulong 48
q = add j 16
x = get ws sub q 15
y = get ws sub q 2
s0 = xor xor rotr x 7 rotr x 18 shr x 3
s1 = xor xor rotr y 17 rotr y 19 shr y 10
put ws q add add add get ws sub q 16 s0 get ws sub q 7 s1
end
end

fn shat1 i ulong to uint
e = get st 4
s1 = xor xor rotr e 6 rotr e 11 rotr e 25
ch = xor and e get st 5 and not e get st 6
ret add add add add get st 7 s1 ch get kk i get ws i
end

fn shat2 to uint
a = get st 0
b = get st 1
c = get st 2
s0 = xor xor rotr a 2 rotr a 13 rotr a 22
mj = xor xor and a b and a c and b c
ret add s0 mj
end

fn shacomp to void
shasched
for i ulong 8
put st i get hv i
end
for i ulong 64
t1 = shat1 i
t2 = shat2
put st 7 get st 6
put st 6 get st 5
put st 5 get st 4
put st 4 add get st 3 t1
put st 3 get st 2
put st 2 get st 1
put st 1 get st 0
put st 0 add t1 t2
end
for i ulong 8
put hv i add get hv i get st i
end
end

fn shabyte b uchar to void
n = get bk 0
put blk n b
n = add n 1
if eq n 64
shacomp
n = ulong 0
end
put bk 0 n
put bk 1 add get bk 1 1
end

fn hexch v uint to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

fn shafinal to void
bits = mul get bk 1 8
shabyte 128
while ne get bk 0 56 bound 64
shabyte 0
end
for i ulong 8
shabyte uchar and shr bits mul sub 7 i 8 255
end
for i ulong 8
v = get hv i
for j ulong 8
put hexd add mul i 8 j hexch and shr v mul sub 7 j 4 15
end
end
end

note hexd = sha256 of the file pb; false when it cannot be read
fn hashpb to bool
fd = opr
if lt fd 0
ret false
end
for i ulong 8
put hv i get ivs i
end
put bk 0 0
put bk 1 0
while true bound 1000000000
r = read int fd ln 0 len ln
if lt r 0
fclo fd
ret false
end
if eq r 0
fclo fd
shafinal
ret true
end
for i ulong ulong r
shabyte get ln i
end
end
ret false
end

note fb as WANT decimal lines, each below 2^32, into nums
fn parsenum wn ulong to bool
n = get fbn 0
k = ulong 0
v = ulong 0
nd = ulong 0
for i ulong n
c = get fb i
if and ge c 48 le c 57
if ge nd 10
ret false
end
v = add mul v 10 ulong sub c 48
nd = add nd 1
else
if or ne c 10 eq nd 0
ret false
end
if or ge k wn gt v 4294967295
ret false
end
put nums k v
k = add k 1
v = ulong 0
nd = ulong 0
end
end
ret and eq k wn eq nd 0
end

fn ldconst to bool
pclear
pcat kdec
if rdb
if parsenum 64
for i ulong 64
put kk i uint get nums i
end
pclear
pcat ivdec
if rdb
if parsenum 8
for i ulong 8
put ivs i uint get nums i
end
ret true
end
end
end
end
ret false
end

note ---- pin --------------------------------------------------------------------------------
note pin += fb[a .. e), after a newline when pin is not empty
fn pinadd a ulong e ulong to void
m = get pinn 0
if gt add m add 1 sub e a len pin
die dbig
end
if gt m 0
put pin m 10
m = add m 1
end
for i ulong sub e a
put pin add m i get fb add a i
end
put pinn 0 add m sub e a
end

note pin = the first 64 bytes of seed/out/omc.sha256 (the compiler pin)
fn ldpin to void
put pinn 0 0
pclear
pcat units
b = rdb
n = get fbn 0
if lt n 64
ret
end
pinadd 0 64
end

fn pinok to bool
if ne get pinn 0 64
ret false
end
for i ulong 64
if ne get pin i get hexd i
ret false
end
end
ret true
end

note ---- scratch directory ------------------------------------------------------------------
fn wname d view uchar * o ulong base ulong to ulong
k = add o 19
if eq get d k 46
if eq get d add k 1 0
ret 0
end
if eq get d add k 1 46
if eq get d add k 2 0
ret 0
end
end
end
put wpath base 47
p = add base 1
while ne get d k 0 bound 4096
if ge p 4095
die dwipe
end
put wpath p get d k
p = add p 1
k = add k 1
end
ret p
end

fn wone d view uchar * o ulong base ulong depth ulong to ulong
rl = or ulong get d add o 16 shl ulong get d add o 17 8
if eq rl 0
die dwipe
end
q = wname d o base
if eq q 0
ret rl
end
r = unlink wpath 0 q
if eq r -21
if eq depth 0
die dwipe
end
wipe q sub depth 1
r = rmdir wpath 0 q
end
if ne r 0
die dwipe
end
ret rl
end

fn wipe base ulong depth ulong to void
d = new uchar 8192 0
fd = fopen wpath 0 base 16384 0
if lt fd 0
die dwipe
end
while true bound 1000000
n = getdnts int fd d 0 len d
if lt n 0
die dwipe
end
if eq n 0
break
end
o = ulong 0
while lt o ulong n bound 8192
o = add o wone d o base depth
end
end
fclo fd
end


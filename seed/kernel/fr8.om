note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note fr8.om: first slice of the FR-8 kernel words. Concatenate after
note gpu/nvidia/om/encoder/bw_enc_sm121.om. Each word fills one enc1 record
note and publishes the four sm_121 words in fw. Refusals write nothing.
note
note Words and the encoder ops they lower to (src/omega_blackwell_codegen.h):
note   idx 0 tidx  S2R  op 3  SR_TID_X   33
note   idx 1 tidy  S2R  op 3  SR_TID_Y   34
note   idx 2 bidx  S2R  op 3  SR_CTAID_X 37
note   idx 3 bidy  S2R  op 3  SR_CTAID_Y 38
note   gline       two of those S2R plus IMAD op 8: dst = bidx * ntx + tidx
note   shld        LDS32 op 49
note   shst        STS32 op 50
note   lane        SHFL.DOWN op 42
note   bars        BAR.SYNC op 48
note Axis 4 and above is refused (3): TID_Z and CTAID_Z are not in BlackwellSR.
note ntx of 0 or above 1024 is refused (5). 1024 is the maximum threads per block
note (CUDA C Programming Guide, table of technical specifications: "Maximum number of
note threads per block 1024"). A larger count is not encoded, so the 32-bit IMAD
note immediate is never asked to hold a block size the chip cannot launch.
note bars and lane are refused (2) while dvg is 1. docs/gpu-reconvergence-308.md
note refuses BAR.SYNC and SHFL inside an open divergent region. A predicate on
note bars is refused (4): enc1 would still emit the barrier, with the guard
note patched, and a CTA barrier is not a per-lane skip. A lane distance of 32
note or more is refused (6): the SHFL field keeps 5 bits.

global fw ulong 4
global gc ulong 12

fn zfw to void
put fw 0 0
put fw 1 0
put fw 2 0
put fw 3 0
end

fn zgc to void
for i ulong 12
put gc i 0
end
end

fn stash w view ulong 4 to void
put fw 0 get w 0
put fw 1 get w 1
put fw 2 get w 2
put fw 3 get w 3
end

fn keep at ulong to void
put gc at get fw 0
put gc add at 1 get fw 1
put gc add at 2 get fw 2
put gc add at 3 get fw 3
end

fn s2r dst ulong sr ulong to ulong
o = new ulong 16 0
w = new ulong 4 0
put o 0 3
put o 1 dst
put o 6 sr
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

fn idx ax ulong dst ulong to ulong
sr = ulong 33
if eq ax 1
sr = ulong 34
end
if eq ax 2
sr = ulong 37
end
if eq ax 3
sr = ulong 38
end
if gt ax 3
zfw
ret 3
end
ret s2r dst sr
end

fn imad dst ulong a ulong n ulong c ulong to ulong
o = new ulong 16 0
w = new ulong 4 0
put o 0 8
put o 1 dst
put o 2 a
put o 4 c
put o 6 n
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

fn gline dst ulong ntx ulong tr ulong br ulong to ulong
if or (eq ntx 0) (gt ntx 1024)
zgc
ret 5
end
r = s2r tr 33
if ne r 0
ret r
end
keep 0
r = s2r br 37
if ne r 0
ret r
end
keep 4
r = imad dst br ntx tr
if ne r 0
ret r
end
keep 8
ret 0
end

fn shld dst ulong adr ulong to ulong
o = new ulong 16 0
w = new ulong 4 0
put o 0 49
put o 1 dst
put o 2 adr
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

fn shst adr ulong val ulong to ulong
o = new ulong 16 0
w = new ulong 4 0
put o 0 50
put o 2 adr
put o 3 val
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

fn lane dst ulong src ulong off ulong dvg ulong to ulong
if ne dvg 0
zfw
ret 2
end
if ge off 32
zfw
ret 6
end
o = new ulong 16 0
w = new ulong 4 0
put o 0 42
put o 1 dst
put o 2 src
put o 6 off
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

fn bars dvg ulong grd ulong to ulong
if ne dvg 0
zfw
ret 2
end
if ne grd 0
zfw
ret 4
end
o = new ulong 16 0
w = new ulong 4 0
put o 0 48
r = enc1 view o edit w
if ne r 0
zfw
ret r
end
stash view w
ret 0
end

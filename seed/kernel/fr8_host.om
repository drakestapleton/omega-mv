note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note fr8_host.om: host check of the FR-8 words. Concatenate after fr8.om.
note Exit 0 when every accepted word matches the encoder formulas and every
note refusal returns its code with fw cleared. The decimals are those formulas
note (enc_a op 3, enc_c op 42, enc_d ops 8 is in enc_a, ops 48 49 50) applied
note to fixed registers. No device is opened.

fn miss a ulong b ulong c ulong d ulong to int
if ne get fw 0 a
ret 1
end
if ne get fw 1 b
ret 1
end
if ne get fw 2 c
ret 1
end
if ne get fw 3 d
ret 1
end
ret 0
end

fn ck_idx to int
r = idx 0 4
if ne r 0
ret 10
end
if ne miss 293145 0 8448 926208 0
ret 11
end
r = idx 1 5
if ne r 0
ret 12
end
if ne miss 358681 0 8704 926208 0
ret 13
end
r = idx 2 6
if ne r 0
ret 14
end
if ne miss 424217 0 9472 926208 0
ret 15
end
r = idx 3 7
if ne r 0
ret 16
end
if ne miss 489753 0 9728 926208 0
ret 17
end
r = idx 4 4
if ne r 3
ret 18
end
if ne miss 0 0 0 0 0
ret 19
end
ret 0
end

fn slot at ulong a ulong b ulong c ulong d ulong to int
if ne get gc at a
ret 1
end
if ne get gc add at 1 b
ret 1
end
if ne get gc add at 2 c
ret 1
end
if ne get gc add at 3 d
ret 1
end
ret 0
end

fn ck_grid to int
put fw 0 9
put fw 1 8
put fw 2 7
put fw 3 6
r = gline 8 0 4 6
if ne r 5
ret 20
end
if ne get fw 0 9
ret 21
end
r = gline 8 1025 4 6
if ne r 5
ret 22
end
if ne get gc 0 0
ret 23
end
r = gline 8 32 4 6
if ne r 0
ret 24
end
if ne slot 0 293145 0 8448 926208 0
ret 25
end
if ne slot 4 424217 0 9472 926208 0
ret 26
end
if ne slot 8 101218340 32 126747140 2083328 0
ret 27
end
if ne miss 101218340 32 126747140 2083328 0
ret 28
end
ret 0
end

fn ck_mem to int
r = shld 9 10
if ne r 0
ret 30
end
if ne miss 168393092 255 134219776 927744 0
ret 31
end
r = shst 10 9
if ne r 0
ret 32
end
if ne miss 167803272 9 134220031 1040896 0
ret 33
end
ret 0
end

fn ck_lane to int
r = lane 11 4 1 1
if ne r 2
ret 40
end
if ne miss 0 0 0 0 0
ret 41
end
r = lane 11 4 32 0
if ne r 6
ret 42
end
if ne miss 0 0 0 0 0
ret 43
end
r = lane 11 4 1 0
if ne r 0
ret 44
end
if ne miss 67862409 136322816 917504 926720 0
ret 45
end
ret 0
end

fn ck_bar to int
r = bars 1 0
if ne r 2
ret 50
end
if ne miss 0 0 0 0 0
ret 51
end
r = bars 0 1
if ne r 4
ret 52
end
if ne miss 0 0 0 0 0
ret 53
end
r = bars 0 0
if ne r 0
ret 54
end
if ne miss 31517 0 65536 1043456 0
ret 55
end
ret 0
end

fn main to int
k = ck_idx
if ne k 0
ret k
end
k = ck_grid
if ne k 0
ret k
end
k = ck_mem
if ne k 0
ret k
end
k = ck_lane
if ne k 0
ret k
end
k = ck_bar
if ne k 0
ret k
end
ret 0
end

note Write view s to file at cf_pa with mode
fn cf_write_view s view uchar * mode int to bool
fd = fopen cf_pa 0 get cf_pl 0 577 mode
if lt fd 0
ret false
end
o = ulong 0
n = len s
while lt o n bound 1024
chunk = sub n o
if gt chunk 65536
chunk = ulong 65536
end
k = write int fd s o chunk
if le k 0
r = fclose int fd
ret false
end
o = add o ulong k
end
r = fclose int fd
ret true
end

note Write sh_dat[off..off+n) to file at cf_pa with mode
fn cf_save_sh off ulong n ulong mode int to bool
fd = fopen cf_pa 0 get cf_pl 0 577 mode
if lt fd 0
ret false
end
o = ulong 0
while lt o n bound 1024
chunk = sub n o
if gt chunk 65536
chunk = ulong 65536
end
k = write int fd sh_dat add off o chunk
if le k 0
r = fclose int fd
ret false
end
o = add o ulong k
end
r = fclose int fd
ret true
end

note Hash file at cf_pa into cf_hx[0..64); returns size or 99999999 on error
fn cf_hash_pa to ulong
n = cf_load_sh
if eq n 99999999
ret 99999999
end
sh_all n
for j ulong 32
b = uint get sh_dig j
put cf_hx mul j 2 sh_hexd shr b 4
put cf_hx add mul j 2 1 sh_hexd and b 15
end
ret n
end

fn cf_hx_eq_view exp view uchar * to bool
if ne len exp 64
ret false
end
for i ulong 64
if ne get cf_hx i get exp i
ret false
end
end
ret true
end

fn cf_hx_eq_h1 to bool
for i ulong 64
if ne get cf_hx i get cf_h1 i
ret false
end
end
ret true
end

fn cf_verify_c2_file exp view uchar * to bool
n = cf_hash_pa
if eq n 99999999
ret false
end
if eq n 0
ret false
end
ret cf_hx_eq_view exp
end

note Byte-for-byte comparison of cf_pa (in sh_dat) vs cf_pb (in cf_buf)
fn cf_files_eq to bool
na = cf_load_sh
if eq na 99999999
ret false
end
n = get cf_pbl 0
for i ulong n bound 4096
put cf_pa i get cf_pb i
end
put cf_pl 0 n
nb = cf_load_buf
if ne na nb
ret false
end
for i ulong na bound 2097152
if ne get sh_dat i get cf_buf i
ret false
end
end
ret true
end

note Run program cf_pc with stdin=cf_pb, stdout=cf_pa (mode outMode), stderr=SCRATCH/child.err
fn cf_exec outMode int to ulong
n = get cf_pcl 0
put cf_av 0 1
put cf_av 1 0
put cf_av 2 uchar and n 255
put cf_av 3 uchar shr n 8
for i ulong n bound 4096
put cf_av add 4 i get cf_pc i
end
put cf_an 0 add 4 n
fi = fopen cf_pb 0 get cf_pbl 0 0 0
if lt fi 0
ret 255
end
fo = fopen cf_pa 0 get cf_pl 0 577 outMode
if lt fo 0
r1 = fclose int fi
ret 255
end
sn = get cf_sl 0
em = len cf_s_err
for i ulong sn bound 2048
put cf_av add 4096 i get cf_scr i
end
for j ulong em bound 64
put cf_av add add 4096 sn j get cf_s_err j
end
fe = fopen cf_av 4096 add sn em 577 420
if lt fe 0
r1 = fclose int fi
r2 = fclose int fo
ret 255
end
pid = fork
if lt pid 0
r1 = fclose int fi
r2 = fclose int fo
r3 = fclose int fe
ret 254
end
if eq pid 0
r = dupfd int fi 0 0
r = dupfd int fo 1 0
r = dupfd int fe 2 0
r = execprog cf_av 0 get cf_an 0
exit 127
end
r1 = fclose int fi
r2 = fclose int fo
r3 = fclose int fe
w = waitpid int pid cf_st 0 4 0
if ne w pid
ret 253
end
if ne get cf_st 0 0
ret add 256 ulong get cf_st 0
end
ret ulong get cf_st 1
end

note Compile source at cf_pb into executable at cf_pa using OMC_BIN; returns exit code
fn cf_compile to ulong
cf_omc_to_pc
ret cf_exec 493
end

note Run compiled executable at cf_pc with empty stdin -> SCRATCH/run.out; verify exit & exact stdout
fn cf_check_c1 wantRc ulong wantOut view uchar * to bool
cf_p_scr cf_s_empty
cf_pa_to_pb
cf_p_scr cf_s_out
rc = cf_exec 420
if ne rc wantRc
ret false
end
cf_p_scr cf_s_out
n = cf_load_out
if eq n 99999999
ret false
end
if ne n len wantOut
ret false
end
for i ulong n bound 65536
if ne get cf_out i get wantOut i
ret false
end
end
ret true
end

note ==== Pillar 0: Compiler Pin Verification (fail-closed) ====
fn cf_is_lhex c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 102
ret true
end
ret false
end

note Verify pin file at cf_pa against cf_omc_hx; 0=OK, 11=missing, 12=corrupted/truncated, 13=mismatch
fn cf_check_pin_pa to ulong
n = cf_load_sh
if eq n 99999999
ret 11
end
if lt n 64
ret 12
end
for i ulong 64
c = get sh_dat i
if not cf_is_lhex c
ret 12
end
put cf_pin i c
end
if gt n 64
d = get sh_dat 64
if and ne d 32 and ne d 9 ne d 10
ret 12
end
end
for i ulong 64
if ne get cf_pin i get cf_omc_hx i
ret 13
end
end
ret 0
end

fn cf_pillar_pin to int
n = get cf_ol 0
for i ulong n bound 2048
put cf_pa i get cf_omc i
end
put cf_pl 0 n
sz = cf_hash_pa
if or eq sz 99999999 eq sz 0
ret cf_fail 10
end
for i ulong 64
put cf_omc_hx i get cf_hx i
end
if eq get cf_fault 0 4
cf_p_scr cf_s_badpin
if not cf_write_view cf_bad_pin_txt 420
ret cf_fail 14
end
else
cf_p_root cf_r_pin
end
pr = cf_check_pin_pa
if ne pr 0
ret cf_fail pr
end
cf_bump
cf_wrt cf_m_p0
w = write 1 cf_omc_hx 0 64
cf_wrt cf_m_nl
ret 0
end

note ==== Pillar 1: C2 Machine-Code Byte-Identity & 2x Determinism ====
fn cf_c2_pack off ulong sz ulong exp view uchar * injectFlip bool to bool
cf_p_root cf_r_pack
pn = cf_load_sh
if eq pn 99999999
ret false
end
if gt add off sz pn
ret false
end
cf_p_scr cf_s_src
if not cf_save_sh off sz 420
ret false
end
cf_pa_to_pb
cf_p_scr cf_s_c2
if ne cf_compile 0
ret false
end
if injectFlip
cf_p_scr cf_s_c2
bn = cf_load_sh
if or eq bn 99999999 lt bn 64
ret false
end
put sh_dat 16 xor get sh_dat 16 uchar 1
cf_p_scr cf_s_c2
if not cf_save_sh 0 bn 493
ret false
end
end
cf_p_scr cf_s_c2
ret cf_verify_c2_file exp
end


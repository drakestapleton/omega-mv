text cf_src_om1 "struct P a ulong b ulong end\nglobal g ulong 4\ntext out1 \"OM1:42:99\\n\"\nfn rotr x ulong to ulong\nret add x 10\nend\nfn main to int\nfresh = ulong 32\nat = rotr fresh\np = new P 0 0\nput p a at\nput p b 99\nput g 0 get p a\nput g 1 get p b\ns = ulong 0\nfor i ulong 2\ns = add s get g i\nend\nif ne s 141\nret 1\nend\nr = write 1 out1 0 len out1\nret 0\nend\n"
text cf_exp_om1 "OM1:42:99\n"


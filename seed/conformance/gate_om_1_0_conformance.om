note ==== Pillar 4: Fail-Closed Negative Controls (NC-A, NC-B1, NC-B2, NC-C1..C3) ====
fn cf_pillar_neg to int
note NC-A: 1-byte flip in golden compiled c2-00012 binary -> real C2 verifier accepts before flip, refuses after
cf_p_scr cf_s_c2
if not cf_verify_c2_file cf_h_c2_00012
ret cf_fail 80
end
cf_p_scr cf_s_c2
bn = cf_load_sh
if or eq bn 99999999 lt bn 64
ret cf_fail 80
end
put sh_dat 16 xor get sh_dat 16 uchar 1
cf_p_scr cf_s_flip
if not cf_save_sh 0 bn 493
ret cf_fail 81
end
cf_p_scr cf_s_flip
if cf_verify_c2_file cf_h_c2_00012
ret cf_fail 82
end
cf_bump

note NC-B1: mutated exit code (1 vs expected 0) -> real C1 verifier MUST refuse
if cf_run_src cf_src_om1_badexit 0 cf_exp_om1
ret cf_fail 83
end
cf_bump

note NC-B2: mutated stdout ("OM1:42:98\n" vs "OM1:42:99\n") -> real C1 verifier MUST refuse
if cf_run_src cf_src_om1_badout 0 cf_exp_om1
ret cf_fail 84
end
cf_bump

note NC-C1: missing compiler pin file -> real pin verifier MUST refuse (11)
cf_p_scr cf_s_nopin
if ne cf_check_pin_pa 11
ret cf_fail 85
end
cf_bump

note NC-C2: corrupted non-hex compiler pin file -> real pin verifier MUST refuse (12)
cf_p_scr cf_s_badpin
if not cf_write_view cf_bad_pin_txt 420
ret cf_fail 86
end
cf_p_scr cf_s_badpin
if ne cf_check_pin_pa 12
ret cf_fail 87
end
cf_bump

note NC-C3: valid-hex mismatched compiler pin (1 nibble flipped) -> real pin verifier MUST refuse (13)
for i ulong 64
put sh_dat i get cf_omc_hx i
end
if eq get sh_dat 0 48
put sh_dat 0 49
else
put sh_dat 0 48
end
put sh_dat 64 10
cf_p_scr cf_s_wrpin
if not cf_save_sh 0 65 420
ret cf_fail 88
end
cf_p_scr cf_s_wrpin
if ne cf_check_pin_pa 13
ret cf_fail 89
end
cf_bump

cf_wrt cf_m_p4
ret 0
end

note ==== CLI Fault-Mode Parser & Entry Point ====
fn cf_arg_eq s view uchar * n ulong to bool
if ne n len s
ret false
end
for i ulong n bound 64
if ne get cf_pa i get s i
ret false
end
end
ret true
end

fn cf_parse_fault to bool
put cf_fault 0 0
if lt argcnt 5
ret true
end
k = argread 4 cf_pa 0 64
if lt k 1
ret false
end
n = ulong k
if cf_arg_eq cf_w_nc2 n
put cf_fault 0 1
ret true
end
if cf_arg_eq cf_w_nce n
put cf_fault 0 2
ret true
end
if cf_arg_eq cf_w_nco n
put cf_fault 0 3
ret true
end
if cf_arg_eq cf_w_ncp n
put cf_fault 0 4
ret true
end
ret false
end

fn main to int
if or lt argcnt 4 gt argcnt 5
cf_wrt cf_m_usage
ret 2
end
ol = argread 1 cf_omc 0 2047
rl = argread 2 cf_root 0 2047
sl = argread 3 cf_scr 0 2047
if or lt ol 1 or lt rl 1 lt sl 1
cf_wrt cf_m_usage
ret 2
end
put cf_ol 0 ulong ol
put cf_rl 0 ulong rl
put cf_sl 0 ulong sl
put cf_ok 0 0
if not cf_parse_fault
cf_wrt cf_m_usage
ret 2
end
mk = makedir cf_scr 0 ulong sl 493
cf_p_scr cf_s_empty
if not cf_write_view cf_empty 420
ret cf_fail 9
end

rc = cf_pillar_pin
if ne rc 0
ret rc
end
rc = cf_pillar_c2
if ne rc 0
ret rc
end
rc = cf_pillar_c1_core
if ne rc 0
ret rc
end
rc = cf_pillar_c1_rm2_rm4
if ne rc 0
ret rc
end
rc = cf_pillar_c1_rm5
if ne rc 0
ret rc
end
rc = cf_pillar_traps
if ne rc 0
ret rc
end
rc = cf_pillar_errors
if ne rc 0
ret rc
end
rc = cf_pillar_neg
if ne rc 0
ret rc
end

if ne get cf_ok 0 52
ret cf_fail 99
end
cf_wrt cf_m_pass1
cf_num get cf_ok 0
cf_wrt cf_m_pass2
w = write 1 cf_omc_hx 0 64
cf_wrt cf_m_nl
ret 0
end

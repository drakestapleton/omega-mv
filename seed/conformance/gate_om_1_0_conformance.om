note ==== I/O and formatting helpers ====
fn cf_wrt s view uchar * to void
r = write 1 s 0 len s
end

fn cf_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put cf_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 cf_dig p sub 24 p
ret
end
end
end

fn cf_fail code ulong to int
cf_wrt cf_m_fail
cf_num code
cf_wrt cf_m_nl
ret int code
end

fn cf_bump to void
put cf_ok 0 add get cf_ok 0 1
end

fn cf_p_root suf view uchar * to void
n = get cf_rl 0
for i ulong n bound 2048
put cf_pa i get cf_root i
end
m = len suf
for j ulong m bound 256
put cf_pa add n j get suf j
end
put cf_pl 0 add n m
end

fn cf_p_scr suf view uchar * to void
n = get cf_sl 0
for i ulong n bound 2048
put cf_pa i get cf_scr i
end
m = len suf
for j ulong m bound 256
put cf_pa add n j get suf j
end
put cf_pl 0 add n m
end

fn cf_pa_to_pb to void
n = get cf_pl 0
for i ulong n bound 4096
put cf_pb i get cf_pa i
end
put cf_pbl 0 n
end

fn cf_pa_to_pc to void
n = get cf_pl 0
for i ulong n bound 4096
put cf_pc i get cf_pa i
end
put cf_pcl 0 n
end

fn cf_omc_to_pc to void
n = get cf_ol 0
for i ulong n bound 2048
put cf_pc i get cf_omc i
end
put cf_pcl 0 n
end

note Load file at cf_pa into sh_dat[0..); returns length or 99999999 on error
fn cf_load_sh to ulong
fd = fopen cf_pa 0 get cf_pl 0 0 0
if lt fd 0
ret 99999999
end
n = ulong 0
while lt n len sh_dat bound 4096
chunk = sub len sh_dat n
if gt chunk 65536
chunk = ulong 65536
end
k = read int fd sh_dat n chunk
if lt k 0
r = fclose int fd
ret 99999999
end
if eq k 0
r = fclose int fd
ret n
end
n = add n ulong k
end
r = fclose int fd
ret 99999999
end


text cf_src_rm5 "\ntext t_a \"omega\"\ntext t_b \"omega\"\ntext t_c \"omeg\"\ntext t_csv \"aa,bbb,c\"\ntext t_nd \"meg\"\ntext t_no \"zzz\"\ntext t_u64m \"18446744073709551615\"\ntext t_u64o \"18446744073709551616\"\ntext t_bdig \"12x\"\ntext t_i64m \"-9223372036854775808\"\ntext t_i64o \"-9223372036854775809\"\ntext t_hx \"deadBEEF\"\ntext t_fx \"00000000deadbeef\"\ntext t_fneg \"-42\"\ntext t_ok \"RM5:TEXT:OK:12\\n\"\nfn r5_cmp to int\nif not tx_eq t_a t_b\nret 1\nend\nif ne tx_cmp t_c t_a int -1\nret 2\nend\nif ne tx_cmp t_a t_c int 1\nret 3\nend\nif ne tx_find t_a t_nd 0 1\nret 4\nend\nif ne tx_find t_a t_no 0 txnone\nret 5\nend\np1 = tx_field t_csv 44 0\nif ne p1 2\nret 6\nend\np2 = tx_field t_csv 44 add p1 1\nif ne p2 6\nret 7\nend\nret 0\nend\nfn r5_num to int\nvu = new ulong 1 0\nvi = new long 1 0\nif ne tx_pdec t_u64m 0 len t_u64m vu 0\nret 11\nend\nif ne get vu 0 ulong 18446744073709551615\nret 12\nend\nif ne tx_pdec t_u64o 0 len t_u64o vu txerange\nret 13\nend\nif ne tx_pdec t_bdig 0 len t_bdig vu txedigit\nret 14\nend\nif ne tx_pdec t_a 0 0 vu txeempty\nret 15\nend\nif ne tx_pdeci t_i64m 0 len t_i64m vi 0\nret 16\nend\nif ne get vi 0 long -9223372036854775808\nret 17\nend\nif ne tx_pdeci t_i64o 0 len t_i64o vi txerange\nret 18\nend\nif ne tx_phex t_hx 0 len t_hx vu 0\nret 19\nend\nif ne get vu 0 ulong 3735928559\nret 20\nend\nob = new uchar 24 0\nk = tx_fhex ulong 3735928559 16 ob 0\nif ne k 16\nret 21\nend\nif not tx_eq part ob 0 16 t_fx\nret 22\nend\nk2 = tx_fdeci long -42 ob 0\nif ne k2 3\nret 23\nend\nif not tx_eq part ob 0 3 t_fneg\nret 24\nend\nsm = new uchar 2 0\nif ne tx_fdec 1000 sm 0 txespace\nret 25\nend\nret 0\nend\nfn r5_u8 to int\nb = new uchar 16 0\ne1 = tx_u8enc 65 b 0\nif ne e1 1\nret 31\nend\ne2 = tx_u8enc 233 b ulong e1\nif ne e2 3\nret 32\nend\ne3 = tx_u8enc 8364 b ulong e2\nif ne e3 6\nret 33\nend\ne4 = tx_u8enc 1114111 b ulong e3\nif ne e4 10\nret 34\nend\nif ne tx_u8ok b 0 10 10\nret 35\nend\nd = tx_u8dec b 6 4\nif ne d or shl ulong 1114111 3 4\nret 36\nend\nif ne tx_u8enc 55296 b 0 txerange\nret 37\nend\nif ne tx_u8enc 1114112 b 0 txerange\nret 38\nend\nput b 0 192\nput b 1 128\nif ne tx_u8ok b 0 2 0\nret 39\nend\nput b 0 237\nput b 1 160\nput b 2 128\nif ne tx_u8ok b 0 3 0\nret 40\nend\nput b 0 244\nput b 1 144\nput b 2 128\nput b 3 128\nif ne tx_u8ok b 0 4 0\nret 41\nend\nret 0\nend\nfn main to int\nr = r5_cmp\nif ne r 0\nret r\nend\nr = r5_num\nif ne r 0\nret r\nend\nr = r5_u8\nif ne r 0\nret r\nend\nw = write 1 t_ok 0 len t_ok\nret 0\nend\n"

fn cf_build_rm5_unit to bool
cf_p_root cf_r_text
tn = cf_load_sh
if or eq tn 99999999 eq tn 0
ret false
end
cf_p_scr cf_s_rm5
fd = fopen cf_pa 0 get cf_pl 0 577 420
if lt fd 0
ret false
end
k1 = write int fd cf_hdr_om2 0 len cf_hdr_om2
if ne k1 long len cf_hdr_om2
r = fclose int fd
ret false
end
o = ulong 0
while lt o tn bound 1024
chunk = sub tn o
if gt chunk 65536
chunk = ulong 65536
end
k2 = write int fd sh_dat o chunk
if le k2 0
r = fclose int fd
ret false
end
o = add o ulong k2
end
k3 = write int fd cf_src_rm5 0 len cf_src_rm5
r = fclose int fd
ret eq k3 long len cf_src_rm5
end


note seed/catalog/resolve.om: catalog resolver (contract: seed/catalog/README.md).
note Built as one OM-2 program after om/sha256/sha256-om2.om (see gate.sh):
note   resolve build CATALOG LOCK COMPACT MAP | resolve card CATALOG LOCK | resolve sig CATALOG LOCK | resolve ids CATALOG
note Reads no clock, environment or randomness: identical inputs give identical bytes.

text mbuild "build"
text mcard "card"
text msig "sig"
text mids "ids"
text kcat "catalog"
text klock "lock"
text kcp "compact"
text kunit "unit"
text kmap "map"
text wnote "note"
text wcard "card"
text weg "eg"
text wfn "fn"
text wto "to"
text wend "end"
text wfor "for"
text weq "="
text wvoid "void"
text wtext "text"
text wexport "export"
text winl "inline"
text wom2 "om2"
text wom2d "om2 diag"
text wom2g "om2 debug"
text wom2r "om2 release"
text wom2dg "om2 diag debug"
text wom2dr "om2 diag release"
text wom2f "om2 fmt"
text wchk "check"
text wnext "next"
text wir "ir"
text wtarget "target"
text topen "if while for"
text tstmt "if else while for ret break continue end"
text tops "= if else while bound for break continue ret end add sub mul div rem neg and or xor not shl shr eq ne lt le gt ge true false ( )"
text ttype "bool uchar ushort uint ulong byte short int long u8 u16 u32 u64 i8 i16 i32 i64"
text tdecl "global const struct layout abstract"
note tres2: the OM-2 keyword table of omc (kw2) plus the contract words requires ensures invariant and
note the unsized-view star; each is an ordinary name or an error in OM-1 and means something else in OM-2.
text tres2 "rotr rotl unroll inline fresh abstract seal open holds layout field at little big part out export ops dit scrub requires ensures invariant *"
text eusage "RESOLVE_USAGE line 0 usage: resolve build CATALOG LOCK COMPACT MAP | resolve card CATALOG LOCK | resolve sig CATALOG LOCK | resolve ids CATALOG\n"

text rsyn "RESOLVE_SYNTAX"
text rio "RESOLVE_IO"
text rcap "RESOLVE_CAPACITY"
text rdup "RESOLVE_DUPLICATE"
text runk "RESOLVE_UNKNOWN"
text rid "RESOLVE_IDENTITY"
text rnadm "RESOLVE_NOT_ADMITTED"
text rcyc "RESOLVE_CYCLE"
text runl "RESOLVE_UNLOCKED"
text rcol "RESOLVE_COLLISION"
text rmode "RESOLVE_MODE"

text sline " line "
text mcr "CR byte"
text mpath "empty or overlong path"
text mopen "cannot open "
text mread "read failed"
text mwrite "write failed"
text mgt "bytes > "
text mnoname "fn without name"
text mentry "entry "
text mtwice " defined twice"
text ment64 "catalog entries > 64"
text mnoend "fn block without end"
text mrec "entry record bytes > 4096"
text mnolf "catalog does not end with LF"
text mouts "line outside an entry record"
text mlkfmt "lock line is not: NAME IDENTITY [inline]"
text mnotcat " is not in the catalog"
text mlk2 " locked twice"
text mcatl " catalog line "
text mothid " has another identity"
text mlk32 "lock lines > 32"
text mword " word '"
text mwq "' "
text mbind "cannot be bound"
text mbind64 "entry bindings > 64"
text msubset "is outside the admitted subset"
text mself " calls itself"
text mneeds " needs entry "
text mnotlk " which is not locked"
text mptype "is not an admitted parameter type"
text mnoto "fn line without to"
text mrtype "is not an admitted return type"
text mafter "follows the return type"
text mstmt "does not start an admitted statement"
text mcycle " is on a dependency cycle"
text mname "name "
text mislk " is a locked catalog entry (catalog line "
text mrp ")"
text misbind " is a binding of entry "
text mlpcat " (catalog line "
text mtop "top-level names > 1024"
text mbindg "binding "
text mislk2 " is a locked catalog entry"
text mcatent "catalog entry "
text munl " is used but not locked"
text mwordb "word "
text mres " is reserved in OM-2; inline entries need an om2 unit"
text mhex " is a hex literal (OM-2 only); inline entries need an om2 unit"
text mchk "check/next line without an om2 line after it: om2 placement is not decided; write om2 in the compact source"
text mfmt "om2 fmt unit cannot take catalog entries"
text mirin "ir unit cannot take inline entries (inline is OM-2)"
text mtgt "target line: om2 placement is not decided; write om2 in the compact source"
text munitc "unit bytes > 524288"
text mmapc "map bytes > 2097152"
text mmapo "cannot create map file"
text osinl " inline"
text oom2 "om2\n"
text oeg "e.g. "
text pc "C "
text pe "E "
text prom2 "R om2\n"
text a1 "ACCT compact_bytes="
text a2 " lock_bytes="
text a3 " catalog_bytes="
text a4 " entry_bytes="
text a5 " unit_bytes="
text a6 " unit_lines="
text a7 " entries="
text a8 " inline="
text a9 " om2_added="

note ---------------------------------------------------------------- state
note gb holds the three inputs: catalog at 0 (<= 262144 B), lock at 262145 (<= 4096 B),
note compact at 266243 (<= 65536 B); one extra byte each detects an over-capacity file.
global gb uchar 331780
global gfb ulong 3
global gfn ulong 3
global gfl ulong 3
global gfc ulong 3
global gls ulong 331780
global gle ulong 331780
global gln ulong 1

note catalog entries (at most 64)
global gec ulong 1
global gens ulong 64
global genf ulong 64
global gene ulong 64
global gena ulong 64
global genl ulong 64
global gecd ulong 64
global geeg ulong 64
global gelk ulong 64
global gein uchar 64
global gest uchar 64
global geid uchar 4096
global gdp uchar 4096
global gvc ulong 64
global gvo ulong 4096
global gvl ulong 4096
global gvk ulong 4096
global gpend ulong 3

note lock lines (at most 32)
global glkc ulong 1
global glke ulong 32
global gord ulong 32

note compact: top-level names, insertion line, om2 insertion flag
global gtc ulong 1
global gto ulong 1024
global gtl ulong 1024
global gcpi ulong 1
global gadd ulong 1

note outputs
global gou uchar 524288
global goun ulong 1
global gul ulong 1
global geb ulong 1
global gmp uchar 2097152
global gmpn ulong 1
global gms uchar 1024
global gmsn ulong 1

note ---------------------------------------------------------------- message and exit
fn ms_b c uchar to void
n = get gmsn 0
if lt n 1000
put gms n c
put gmsn 0 add n 1
end
end

fn ms_t t view uchar * to void
for i ulong len t
ms_b get t i
end
end

fn ms_d v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
for i ulong 24
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
for j ulong k
ms_b get d sub sub k j 1
end
end

fn ms_r a ulong n ulong to void
for i ulong n
ms_b get gb add a i
end
end

fn ms_out fd int to void
n = get gmsn 0
o = ulong 0
while lt o n
r = write fd gms o sub n o
if le r 0
exit 3
end
o = add o ulong r
end
end

note the line feed always fits: ms_b stops at 1000 bytes and gms holds 1024
fn die c int to void
n = get gmsn 0
put gms n 10
put gmsn 0 add n 1
ms_out 2
exit c
end

fn kind_t f ulong to void
if eq f 0
ms_t kcat
end
if eq f 1
ms_t klock
end
if eq f 2
ms_t kcp
end
if eq f 3
ms_t kunit
end
if eq f 4
ms_t kmap
end
end

note starts the refusal line "RESOLVE_<nm> line <ln> <kind> "
fn er nm view uchar * ln ulong f ulong to void
put gmsn 0 0
ms_t nm
ms_t sline
ms_d ln
ms_b 32
kind_t f
ms_b 32
end

note ---------------------------------------------------------------- bytes, words, lines
fn is_sp c uchar to bool
ret or eq c 32 eq c 9
end

fn is_br c uchar to bool
ret or eq c 40 eq c 41
end

note start of the first word at or after p, before e (e when none)
fn tk_beg p ulong e ulong to ulong
q = p
while lt q e
if not is_sp get gb q
ret q
end
q = add q 1
end
ret e
end

note end of the word that starts at p; ( and ) are words of their own
fn tk_end p ulong e ulong to ulong
if ge p e
ret e
end
if is_br get gb p
ret add p 1
end
q = p
while lt q e
c = get gb q
if or is_sp c is_br c
ret q
end
q = add q 1
end
ret e
end

fn tx_at a ulong n ulong t view uchar * o ulong to bool
for i ulong n
if ne get gb add a i get t add o i
ret false
end
end
ret true
end

fn rg_tx a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
ret tx_at a n t 0
end

fn rg_eq a ulong an ulong b ulong bn ulong to bool
if ne an bn
ret false
end
for i ulong an
if ne get gb add a i get gb add b i
ret false
end
end
ret true
end

note gb[a..a+n) equals one of the space-separated words of t
fn in_list a ulong n ulong t view uchar * to bool
ws = ulong 0
m = len t
for i ulong add m 1
w = false
if eq i m
w = true
else
if eq get t i 32
w = true
end
end
if w
if eq sub i ws n
if tx_at a n t ws
ret true
end
end
ws = add i 1
end
end
ret false
end

fn is_num a ulong n ulong to bool
s = ulong 0
if eq n 0
ret false
end
if eq get gb a 45
s = ulong 1
end
if ge s n
ret false
end
for i ulong sub n s
c = get gb add a add s i
if or lt c 48 gt c 57
ret false
end
end
ret true
end

fn lnb f ulong k ulong to ulong
ret get gls sub add get gfl f k 1
end

fn lne f ulong k ulong to ulong
ret get gle sub add get gfl f k 1
end

note the line table of file f; a CR byte is refused
fn lines f ulong to void
b = get gfb f
n = get gfn f
li = get gln 0
put gfl f li
s = b
for i ulong n
p = add b i
c = get gb p
if eq c 13
er rsyn add sub li get gfl f 1 f
ms_t mcr
die 19
end
if eq c 10
put gls li s
put gle li p
li = add li 1
s = add p 1
end
end
if lt s add b n
put gls li s
put gle li add b n
li = add li 1
end
put gfc f sub li get gfl f
put gln 0 li
end

note ---------------------------------------------------------------- input
note file f (0 catalog, 1 lock, 2 compact) from the path in argument ai, at gb[base..], cap bytes
fn ld f ulong ai ulong base ulong cap ulong to void
pb = new uchar 4096 0
r = argread ai pb 0 4095
if le r 0
er rio 0 f
ms_t mpath
die 3
end
fl = fopen pb 0 ulong r 0 0
if lt fl 0
er rio 0 f
ms_t mopen
for i ulong ulong r
ms_b get pb i
end
die 3
end
fd = int fl
n = ulong 0
lim = add cap 1
while lt n lim
q = read fd gb add base n sub lim n
if lt q 0
er rio 0 f
ms_t mread
die 3
end
if eq q 0
break
end
n = add n ulong q
end
c = fclose fd
put gfb f base
put gfn f n
if gt n cap
er rcap 0 f
ms_t mgt
ms_d cap
die 15
end
lines f
end

note ---------------------------------------------------------------- catalog
fn ent_find a ulong n ulong to ulong
c = get gec 0
for i ulong c
if rg_eq a n get gena i get genl i
ret i
end
end
ret 64
end

fn hx v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

note identity of entry x: sha256 of its record bytes (note card/eg lines + fn block, each with LF)
fn ent_id x ulong to void
a = lnb 0 get gens x
z = add lne 0 get gene x 1
m = sub z a
k = new uchar 4096 0
for j ulong m
put k j get gb add a j
end
h = new uchar 32 0
sha256_hash part k 0 m h
o = mul x 64
for i ulong 32
v = ulong get h i
put geid add o mul i 2 hx shr v 4
put geid add o add mul i 2 1 hx and v 15
end
end

note the line that closes the fn block opened at catalog line k; 0 when none
fn blk_end k ulong to ulong
nl = get gfc 0
d = ulong 0
j = add k 1
while le j nl
b = lnb 0 j
e = lne 0 j
t = tk_beg b e
te = tk_end t e
if in_list t sub te t topen
d = add d 1
end
if rg_tx t sub te t wend
if eq d 0
ret j
end
d = sub d 1
end
j = add j 1
end
ret 0
end

fn ent_add k ulong to ulong
x = get gec 0
b = lnb 0 k
e = lne 0 k
t = tk_end tk_beg b e e
a = tk_beg t e
z = tk_end a e
if eq a z
er rsyn k 0
ms_t mnoname
die 19
end
if lt ent_find a sub z a 64
er rdup k 0
ms_t mentry
ms_r a sub z a
ms_t mtwice
die 13
end
if ge x 64
er rcap k 0
ms_t ment64
die 15
end
y = blk_end k
if eq y 0
er rsyn k 0
ms_t mnoend
die 19
end
s = get gpend 0
if eq s 0
s = k
end
if gt sub add lne 0 y 1 lnb 0 s 4096
er rcap k 0
ms_t mrec
die 15
end
put gens x s
put genf x k
put gene x y
put gena x a
put genl x sub z a
put gecd x get gpend 1
put geeg x get gpend 2
put gec 0 add x 1
ent_id x
ret y
end

fn pend_clr to void
put gpend 0 0
put gpend 1 0
put gpend 2 0
end

note a note line at catalog line k: card and eg lines open or extend the pending record
fn cat_note k ulong t ulong e ulong to void
a = tk_beg t e
z = tk_end a e
w = ulong 0
if rg_tx a sub z a wcard
w = ulong 1
end
if rg_tx a sub z a weg
w = ulong 2
end
if eq w 0
pend_clr
ret
end
if eq get gpend 0 0
put gpend 0 k
end
put gpend w k
end

fn cat_parse to void
nl = get gfc 0
if gt nl 0
if ne get gb sub get gfn 0 1 10
er rsyn nl 0
ms_t mnolf
die 19
end
end
pend_clr
k = ulong 1
while le k nl
b = lnb 0 k
e = lne 0 k
t = tk_beg b e
te = tk_end t e
if eq t e
pend_clr
else
if rg_tx t sub te t wnote
cat_note k te e
else
if not rg_tx t sub te t wfn
er rsyn k 0
ms_t mouts
die 19
end
k = ent_add k
pend_clr
end
end
k = add k 1
end
end

note ---------------------------------------------------------------- lock
fn is_hex a ulong n ulong to bool
if ne n 64
ret false
end
for i ulong 64
c = get gb add a i
if and or lt c 48 gt c 57 or lt c 97 gt c 102
ret false
end
end
ret true
end

fn lk_bad k ulong to void
er rsyn k 1
ms_t mlkfmt
die 19
end

note lock entry at lock line k: name gb[a..a+n), identity at gb[p..p+64), il 1 for inline
fn lk_set k ulong a ulong n ulong p ulong il ulong to void
x = ent_find a n
if ge x 64
er runk k 1
ms_t mentry
ms_r a n
ms_t mnotcat
die 10
end
if ne get gelk x 0
er rdup k 1
ms_t mentry
ms_r a n
ms_t mlk2
die 13
end
o = mul x 64
for i ulong 64
if ne get gb add p i get geid add o i
er rid k 1
ms_t mentry
ms_r a n
ms_t mcatl
ms_d get genf x
ms_t mothid
die 11
end
end
put gelk x k
put gein x uchar il
put glke sub k 1 x
end

fn lk_line k ulong to void
b = lnb 1 k
e = lne 1 k
a = tk_beg b e
z = tk_end a e
p = tk_beg z e
q = tk_end p e
if or eq a z not is_hex p sub q p
lk_bad k
end
b = tk_beg q e
q = tk_end b e
il = ulong 0
if lt b e
if not rg_tx b sub q b winl
lk_bad k
end
il = ulong 1
end
if lt tk_beg q e e
lk_bad k
end
lk_set k a sub z a p il
end

fn lock_parse to void
nl = get gfc 1
if gt nl 32
er rcap 33 1
ms_t mlk32
die 15
end
for k ulong nl
lk_line add k 1
end
put glkc 0 nl
end

note ---------------------------------------------------------------- admission (locked entries)
fn v_find x ulong a ulong n ulong to bool
c = get gvc x
o = mul x 64
for i ulong c
if rg_eq a n get gvo add o i get gvl add o i
ret true
end
end
ret false
end

fn not_adm x ulong j ulong a ulong n ulong why view uchar * to void
er rnadm j 0
ms_t mentry
ms_r get gena x get genl x
ms_t mword
ms_r a n
ms_t mwq
ms_t why
die 16
end

note a new parameter or local of entry x, bound at catalog line j
fn v_add x ulong a ulong n ulong j ulong to void
if in_list a n tres2
not_adm x j a n mbind
end
if or or in_list a n tops in_list a n ttype lt ent_find a n 64
not_adm x j a n mbind
end
if or eq n 0 is_num a n
not_adm x j a n mbind
end
if v_find x a n
ret
end
c = get gvc x
if ge c 64
er rcap j 0
ms_t mbind64
die 15
end
o = add mul x 64 c
put gvo o a
put gvl o n
put gvk o j
put gvc x add c 1
end

note one body word of entry x at catalog line j
fn adm_tok x ulong j ulong a ulong n ulong to void
if or or in_list a n tops in_list a n ttype is_num a n
ret
end
if v_find x a n
ret
end
d = ent_find a n
if ge d 64
not_adm x j a n msubset
end
if eq d x
er rcyc j 0
ms_t mentry
ms_r a n
ms_t mself
die 14
end
if eq get gelk d 0
er runl j 0
ms_t mentry
ms_r get gena x get genl x
ms_t mneeds
ms_r a n
ms_t mnotlk
die 18
end
put gdp add mul x 64 d 1
end

fn adm_fnl x ulong to void
j = get genf x
a = get gena x
n = get genl x
if or or in_list a n tres2 in_list a n tops in_list a n ttype
not_adm x j a n mbind
end
e = lne 0 j
t = tk_end get gena x e
t = tk_beg t e
while lt t e
z = tk_end t e
if rg_tx t sub z t wto
break
end
v_add x t sub z t j
p = tk_beg z e
q = tk_end p e
if not in_list p sub q p ttype
not_adm x j p sub q p mptype
end
t = tk_beg q e
end
if ge t e
not_adm x j t 0 mnoto
end
p = tk_beg tk_end t e e
q = tk_end p e
if not or in_list p sub q p ttype rg_tx p sub q p wvoid
not_adm x j p sub q p mrtype
end
r = tk_beg q e
if lt r e
not_adm x j r sub tk_end r e r mafter
end
end

fn adm_line x ulong j ulong to void
b = lnb 0 j
e = lne 0 j
t = tk_beg b e
if eq t e
ret
end
z = tk_end t e
if rg_tx t sub z t wnote
ret
end
p = tk_beg z e
q = tk_end p e
if rg_tx t sub z t wfor
v_add x p sub q p j
else
if rg_tx p sub q p weq
v_add x t sub z t j
else
if not in_list t sub z t tstmt
not_adm x j t sub z t mstmt
end
end
end
while lt t e
z = tk_end t e
adm_tok x j t sub z t
t = tk_beg z e
end
end

fn admit x ulong to void
adm_fnl x
y = get gene x
j = add get genf x 1
while lt j y
adm_line x j
j = add j 1
end
end

fn deps_ok x ulong to bool
c = get gec 0
for d ulong c
if and eq get gdp add mul x 64 d 1 eq get gest d 0
ret false
end
end
ret true
end

note emission order: dependencies first, otherwise lock order; no progress means a cycle
fn order to void
nl = get glkc 0
for r ulong nl
pk = ulong 64
for k ulong nl
x = get glke k
if and eq pk 64 eq get gest x 0
if deps_ok x
pk = x
end
end
end
if eq pk 64
for k ulong nl
x = get glke k
if eq get gest x 0
er rcyc get genf x 0
ms_t mentry
ms_r get gena x get genl x
ms_t mcycle
die 14
end
end
end
put gest pk 1
put gord r pk
end
end

fn prep to void
cat_parse
lock_parse
nl = get glkc 0
for k ulong nl
admit get glke k
end
order
end

note ---------------------------------------------------------------- compact
fn lk_find a ulong n ulong to ulong
x = ent_find a n
if lt x 64
if ne get gelk x 0
ret x
end
end
ret 64
end

fn top_has a ulong n ulong to bool
c = get gtc 0
for i ulong c
if rg_eq a n get gto i get gtl i
ret true
end
end
ret false
end

note a compact top-level name at compact line k
fn top_add k ulong a ulong n ulong to void
x = lk_find a n
if lt x 64
er rcol k 2
ms_t mname
ms_r a n
ms_t mislk
ms_d get genf x
ms_t mrp
die 12
end
nl = get glkc 0
for i ulong nl
y = get glke i
if v_find y a n
er rcol k 2
ms_t mname
ms_r a n
ms_t misbind
ms_r get gena y get genl y
ms_t mlpcat
ms_d get genf y
ms_t mrp
die 12
end
end
c = get gtc 0
if ge c 1024
er rcap k 2
ms_t mtop
die 15
end
put gto c a
put gtl c n
put gtc 0 add c 1
end

note pass 1: top-level names and the first fn line
fn cp_top k ulong to void
b = lnb 2 k
e = lne 2 k
t = tk_beg b e
z = tk_end t e
n = sub z t
if rg_tx t n wexport
t = tk_beg z e
z = tk_end t e
n = sub z t
end
if not or or rg_tx t n wfn rg_tx t n wtext in_list t n tdecl
ret
end
if and rg_tx t n wfn eq get gcpi 0 0
put gcpi 0 k
end
a = tk_beg z e
top_add k a sub tk_end a e a
end

fn cp_coll k ulong a ulong n ulong to void
if lt lk_find a n 64
er rcol k 2
ms_t mbindg
ms_r a n
ms_t mislk2
die 12
end
end

note pass 2: bindings and uses of catalog names in compact line k
fn cp_use k ulong to void
b = lnb 2 k
e = lne 2 k
t = tk_beg b e
if eq t e
ret
end
z = tk_end t e
if or rg_tx t sub z t wnote rg_tx t sub z t wtext
ret
end
if rg_tx t sub z t wexport
t = tk_beg z e
z = tk_end t e
end
if rg_tx t sub z t wfn
t = tk_end tk_beg z e e
while lt t e
t = tk_beg t e
z = tk_end t e
cp_coll k t sub z t
t = z
end
ret
end
p = tk_beg z e
q = tk_end p e
if rg_tx t sub z t wfor
cp_coll k p sub q p
end
if rg_tx p sub q p weq
cp_coll k t sub z t
end
while lt t e
z = tk_end t e
x = ent_find t sub z t
if lt x 64
if and eq get gelk x 0 not top_has t sub z t
er runl k 2
ms_t mcatent
ms_r t sub z t
ms_t munl
die 18
end
end
t = tk_beg z e
end
end

note header kind of compact line k, the whole line compared as omc's om2lead/cp_mode/chk_mode do:
note 1 om2, om2 diag, om2 debug, om2 release, om2 diag debug, om2 diag release; 2 om2 fmt; 3 ir;
note 4 target ...; 5 check or next; 0 other
fn hdr_kind k ulong to ulong
b = lnb 2 k
n = sub lne 2 k b
if or or rg_tx b n wom2 rg_tx b n wom2d or rg_tx b n wom2g rg_tx b n wom2r
ret 1
end
if or rg_tx b n wom2dg rg_tx b n wom2dr
ret 1
end
if rg_tx b n wom2f
ret 2
end
if rg_tx b n wir
ret 3
end
if or rg_tx b n wchk rg_tx b n wnext
ret 5
end
t = tk_beg b add b n
if rg_tx t sub tk_end t add b n t wtarget
ret 4
end
ret 0
end

note the first compact line at or after line s that is neither blank nor a note line; 0 when none
fn hdr_from s ulong to ulong
nl = get gfc 2
k = s
while le k nl
b = lnb 2 k
e = lne 2 k
t = tk_beg b e
if lt t e
if not rg_tx t sub tk_end t e t wnote
ret k
end
end
k = add k 1
end
ret 0
end

note gb[a..a+n) starts with 0x: a hex literal in OM-2, error 6 in OM-1
fn hex_tok a ulong n ulong to bool
if lt n 2
ret false
end
ret and eq get gb a 48 eq get gb add a 1 120
end

note every word of every non-note compact line (on a text line only text and its name) that has another
note meaning in OM-2 is refused before om2 is inserted
fn res_scan to void
nl = get gfc 2
for k ulong nl
b = lnb 2 add k 1
e = lne 2 add k 1
t = tk_beg b e
z = tk_end t e
if not rg_tx t sub z t wnote
nw = ulong 0
if rg_tx t sub z t wtext
nw = ulong 2
end
c = ulong 0
while lt t e
z = tk_end t e
if in_list t sub z t tres2
er rmode add k 1 2
ms_t mwordb
ms_r t sub z t
ms_t mres
die 17
end
if hex_tok t sub z t
er rmode add k 1 2
ms_t mwordb
ms_r t sub z t
ms_t mhex
die 17
end
c = add c 1
if eq c nw
t = e
else
t = tk_beg z e
end
end
end
end
end

fn mode to void
nl = get glkc 0
ni = ulong 0
for k ulong nl
ni = add ni ulong get gein get glke k
end
h = hdr_from 1
hk = ulong 0
if gt h 0
hk = hdr_kind h
end
note A target followed by an explicit OM2 header needs no promotion; preserve both lines unchanged.
if eq hk 4
g = hdr_from add h 1
if gt g 0
gk = hdr_kind g
if or eq gk 1 eq gk 2
hk = gk
h = g
end
end
end
note omc reads om2 on the first line after a check/next line; without one there is no om2 to keep
if eq hk 5
g = hdr_from add h 1
hk = ulong 6
if gt g 0
gk = hdr_kind g
if or eq gk 1 eq gk 2
hk = gk
h = g
end
end
end
if and eq hk 2 gt nl 0
er rmode h 2
ms_t mfmt
die 17
end
if or eq ni 0 eq hk 1
ret
end
if eq hk 3
er rmode h 2
ms_t mirin
die 17
end
if eq hk 4
er rmode h 2
ms_t mtgt
die 17
end
if eq hk 6
er rmode h 2
ms_t mchk
die 17
end
res_scan
put gadd 0 1
end

note ---------------------------------------------------------------- assembly
fn ou_b c uchar to void
n = get goun 0
if ge n 524288
er rcap 0 3
ms_t munitc
die 15
end
put gou n c
put goun 0 add n 1
end

fn ou_r a ulong n ulong to void
for i ulong n
ou_b get gb add a i
end
end

fn ou_t t view uchar * to void
for i ulong len t
ou_b get t i
end
end

fn mp_b c uchar to void
n = get gmpn 0
if ge n 2097152
er rcap 0 4
ms_t mmapc
die 15
end
put gmp n c
put gmpn 0 add n 1
end

fn mp_t t view uchar * to void
for i ulong len t
mp_b get t i
end
end

fn mp_d v ulong to void
d = new uchar 24 0
k = ulong 0
x = v
for i ulong 24
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
for j ulong k
mp_b get d sub sub k j 1
end
end

fn mp_r a ulong n ulong to void
for i ulong n
mp_b get gb add a i
end
end

fn emit_cp k ulong to void
b = lnb 2 k
ou_r b sub lne 2 k b
ou_b 10
mp_t pc
mp_d k
mp_b 10
put gul 0 add get gul 0 1
end

fn emit_ent x ulong to void
y = get gene x
j = get genf x
s = get goun 0
while le j y
b = lnb 0 j
ou_r b sub lne 0 j b
if and eq j get genf x ne get gein x 0
ou_t osinl
end
ou_b 10
mp_t pe
mp_r get gena x get genl x
mp_b 32
mp_d j
mp_b 10
put gul 0 add get gul 0 1
j = add j 1
end
put geb 0 add get geb 0 sub get goun 0 s
end

fn assemble to void
nl = get gfc 2
ins = get gcpi 0
if eq ins 0
ins = add nl 1
end
if eq get gadd 0 1
ou_t oom2
mp_t prom2
put gul 0 1
end
k = ulong 1
while lt k ins
emit_cp k
k = add k 1
end
n = get glkc 0
for r ulong n
emit_ent get gord r
end
while le k nl
emit_cp k
k = add k 1
end
end

fn wr_ou fd int to void
n = get goun 0
o = ulong 0
while lt o n
r = write fd gou o sub n o
if le r 0
er rio 0 3
ms_t mwrite
die 3
end
o = add o ulong r
end
end

fn wr_mp fd int to void
n = get gmpn 0
o = ulong 0
while lt o n
r = write fd gmp o sub n o
if le r 0
er rio 0 4
ms_t mwrite
die 3
end
o = add o ulong r
end
end

fn acct to void
put gmsn 0 0
ms_t a1
ms_d get gfn 2
ms_t a2
ms_d get gfn 1
ms_t a3
ms_d get gfn 0
ms_t a4
ms_d get geb 0
ms_t a5
ms_d get goun 0
ms_t a6
ms_d get gul 0
ms_t a7
nl = get glkc 0
ms_d nl
ni = ulong 0
for k ulong nl
ni = add ni ulong get gein get glke k
end
ms_t a8
ms_d ni
ms_t a9
ms_d get gadd 0
ms_b 10
ms_out 2
end

fn build to void
ld 0 2 0 262144
ld 1 3 262145 4096
ld 2 4 266243 65536
prep
nl = get gfc 2
for k ulong nl
cp_top add k 1
end
for k ulong nl
cp_use add k 1
end
mode
assemble
pb = new uchar 4096 0
r = argread 5 pb 0 4095
if le r 0
er rio 0 4
ms_t mpath
die 3
end
fl = fopen pb 0 ulong r 577 420
if lt fl 0
er rio 0 4
ms_t mmapo
die 3
end
fd = int fl
wr_mp fd
c = fclose fd
wr_ou 1
acct
end

note ---------------------------------------------------------------- card and ids
note words w.. of catalog line j, then LF
fn ou_tail j ulong w ulong to void
b = lnb 0 j
e = lne 0 j
t = tk_beg b e
for i ulong w
t = tk_beg tk_end t e e
end
ou_r t sub e t
ou_b 10
end

fn card sigonly bool to void
ld 0 2 0 262144
ld 1 3 262145 4096
prep
nl = get glkc 0
for k ulong nl
x = get glke k
ou_tail get genf x 1
if not sigonly
if ne get gecd x 0
ou_tail get gecd x 2
end
if ne get geeg x 0
ou_t oeg
ou_tail get geeg x 2
end
end
end
wr_ou 1
end

fn ids to void
ld 0 2 0 262144
cat_parse
c = get gec 0
for x ulong c
ou_r get gena x get genl x
ou_b 32
for i ulong 64
ou_b get geid add mul x 64 i
end
ou_b 10
end
wr_ou 1
end

fn tx_eq a view uchar * n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n
if ne get a i get t i
ret false
end
end
ret true
end

fn usage to void
r = write 2 eusage 0 len eusage
exit 2
end

fn main to int
c = argcnt
if lt c 2
usage
end
pb = new uchar 16 0
r = argread 1 pb 0 16
if le r 0
usage
end
n = ulong r
if and eq c 6 tx_eq pb n mbuild
build
ret 0
end
if and eq c 4 tx_eq pb n mcard
card false
ret 0
end
if and eq c 4 tx_eq pb n msig
card true
ret 0
end
if and eq c 3 tx_eq pb n mids
ids
ret 0
end
usage
ret 2
end

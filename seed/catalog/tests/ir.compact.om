ir
note irequiv unit: ca is the f4 item76666 hand loop, cb the same calc through the catalog entry;
note wrappers shift a ushort d into a window near the top (h), the bottom (l) and the middle (m) of int.
fn ca x int to int
s = x
for i ulong 3
s = add s int 4
end
ret s
end
fn cb x int to int
ret add_times x 4 3
end
fn ha d ushort to int
ret ca sub int 2147483647 int d
end
fn hb d ushort to int
ret cb sub int 2147483647 int d
end
fn la d ushort to int
ret ca add int -2147483648 int d
end
fn lb d ushort to int
ret cb add int -2147483648 int d
end
fn ma d ushort to int
ret ca sub int d int 32768
end
fn mb d ushort to int
ret cb sub int d int 32768
end

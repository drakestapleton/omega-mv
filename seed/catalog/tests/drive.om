note test driver helpers: argi reads argument a as a signed decimal int; outi prints y and LF.
note gate.sh builds: drive.om, then a program without its main, then dmain.om.
fn argi a ulong to int
pb = new uchar 32 0
r = argread a pb 0 31
if le r 0
exit 2
end
s = ulong 0
if eq get pb 0 45
s = ulong 1
end
v = long 0
for i ulong sub ulong r s
v = add mul v long 10 long sub get pb add s i 48
end
if eq s 1
v = neg v
end
ret int v
end

fn outi y int to void
d = new uchar 24 0
v = long y
k = ulong 23
put d k 10
if lt v long 0
v = neg v
end
for i ulong 22
k = sub k 1
put d k uchar add rem v long 10 long 48
v = div v long 10
if eq v long 0
break
end
end
if lt y int 0
k = sub k 1
put d k 45
end
r = write 1 d k sub 24 k
end


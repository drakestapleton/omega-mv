note Independent full-width reference uses multiply, catalog implementation uses repeated add.
fn edge i ulong to int
if eq i 0
ret int -2147483648
end
if eq i 1
ret int 0
end
ret int 2147483647
end
fn main to int
for a ulong 3
for b ulong 3
for c ulong 256
x = edge a
k = edge b
want = add long x mul long k long c
got = add_steps x k uchar c
if ne got want
ret 1
end
end
end
end
ret 0
end

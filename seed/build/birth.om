note SPDX-License-Identifier: Apache-2.0
note seed/build/birth.om: Pure seeded-Omega Compiler Birth & Self-Rebuild Coordinator.
note Replaces seed/omega-from-seed.sh, seed/rung4/mk4.sh, and python3 seed/omc/tests/size-record.py.
note Zero shell, zero Python, zero sed/awk/cmp/sha256sum in the delivery path.
note Build: cat seed/build/common.om seed/build/birth.om | seed/out/omc > build/om-birth
note Usage: om-birth [--verify] [SCRATCH_DIR]
note   default: full seed0 -> hex1 -> asm2 -> om4 -> omc fixpoint -> diaggen -> 8-case size-record ->
note            install seed/out/omc & seed/out/omc.sha256 -> update size-history.tsv -> 4 names-pass probes
note   --verify: same full birth & checks, verifies stage3 == seed/out/omc & omc.sha256 without modifying tracked files.

text b_u "usage: om-birth [--verify] [SCRATCH_DIR]\n"
text b_fverify "--verify"
text b_defscr "build/seed/birth-"
text b_tmpsuf ".tmp."
text b_fail "FAIL: "
text b_pass "PASS "
text b_rc0 "RC=0\n"
text b_s0hex "seed/rung0/seed0.hex"
text b_s0bin "seed/rung0/seed0.bin"
text b_h1hex "seed/rung1/hex1.hex"
text b_h1bin "seed/rung1/hex1.bin"
text b_a2src "seed/rung2/asm2.hex1"
text b_a2bin "seed/rung2/asm2.bin"
text b_t2 "seed/rung2/table.s2"
text b_t3 "seed/rung3/table3.s2"
text b_t4 "seed/rung4/table4.s2"
text b_om4s "seed/rung4/om4.s"
text b_om4b "seed/rung4/om4.bin"
text b_omcsrc "seed/omc/omc.om"
text b_errreg "seed/omc/error-codes.reg"
text b_tsha "seed/trace/sha256.om"
text b_drt "seed/omc/diag-runtime.om"
text b_dgen "seed/omc/diaggen.om"
text b_outomc "seed/out/omc"
text b_outsha "seed/out/omc.sha256"
text b_hist "seed/omc/size-history.tsv"
text b_outdir "seed/out"
text b_pfmark "  .w 0x"
text b_pfsuf " ; p_filesz = the size of om4.bin"
text b_pfmid ", "
text b_pfend " bytes (asm2 has no size arithmetic; gate4.sh checks it)"
text b_om2l "om2\n"
text b_fnsha "fn sha256 "
text b_pfwd "seed/rung4/tests/r5b_fwd.om"
text b_pmut "seed/rung4/tests/r5b_mut.om"
text b_pcyc "seed/rung4/tests/r5b_cycle.om"
text b_passg "seed/rung4/tests/r5b_assign.om"
text b_err9 "error 9"
text b_err7 "error 7"
text b_s0_self "/seed0.self"
text b_s0_out "/seed0.bin"
text b_h1_out "/hex1.bin"
text b_h1_self "/hex1.self"
text b_a2_out "/asm2.bin"
text b_om4_src "/om4.all.s"
text b_om4_out "/om4.bin"
text b_om4_s2 "/om4.s.patched"
text b_st1 "/stage1"
text b_st2 "/stage2"
text b_st3 "/stage3"
text b_dgom "/diaggen.om"
text b_dgbin "/diaggen"
text b_dgout "/diagnostics-source.om"
text b_szrec "/size-record.tsv"
text b_sr_src "/sr-source.om"
text b_sr_bin "/sr-compiler"
text b_sr_out "/sr-out.tsv"
text b_sr_alt "fn a\n note fn ignored\nfn b\nfn c"
text b_sr_pfx "seeded-"
text b_sr_mid "\tGenerated from seeded source and executable\t"
text b_sr_tab "\t"
text b_sr_bad "BAD!"
text b_fnsp "fn "
text b_p_fwd "/fwd.bin"
text b_p_fwde "/fwd.err"
text b_p_mut "/mut.bin"
text b_p_mute "/mut.err"
text b_p_cyc "/cycle.bin"
text b_p_cyce "/cycle.err"
text b_p_asg "/assign.bin"
text b_p_asge "/assign.err"
text b_m_s0 "seed0 "
text b_m_s0b " bytes, rebuilds itself\n"
text b_m_h1 "hex1 "
text b_m_h1b " bytes, born from seed0\n"
text b_m_a2 "asm2 "
text b_m_a2b " bytes, born from hex1\n"
text b_m_o4 "om4 om4.bin "
text b_m_o4b " bytes\n"
text b_m_dg "diagnostic source identity and generated strings\n"
text b_m_fp "omc fixpoint "
text b_m_sr "generated compiler size record\n"
text b_m_srp "SIZE_RECORD PASS cases=8\n"
text b_m_f1 "fwd exit 0\n"
text b_m_f2 "fwd runs, exit 7\n"
text b_m_m1 "mut exit 0\n"
text b_m_m2 "mut runs, exit 0\n"
text b_m_c1 "cycle exit 9\n"
text b_m_a1 "assign exit 7\n"
text b_e_s0parse "seed0.hex parse failed\n"
text b_e_s0self "seed0 did not rebuild itself\n"
text b_e_s0cmp "seed0.bin is not what seed0.hex makes\n"
text b_e_h1cmp "hex1.bin is not what seed0 makes from hex1.hex\n"
text b_e_h1self "hex1 did not rebuild itself\n"
text b_e_a2cmp "asm2.bin is not what hex1 makes\n"
text b_e_om4 "om4 build failed\n"
text b_e_st1 "om4 failed to compile omc.om\n"
text b_e_dg "diagnostic source is stale or diaggen failed\n"
text b_e_st2 "stage1 failed to compile omc.om\n"
text b_e_st3 "stage2 failed to compile omc.om\n"
text b_e_fp "fixpoint mismatch: stage1/stage2/stage3 differ\n"
text b_e_ver "verify: stage3 differs from seed/out/omc or seed/out/omc.sha256\n"
text b_e_sr "SIZE_RECORD FAIL\n"
text b_e_pr "names-pass probe failed\n"
text b_shasuf "  seed/out/omc\n"

global b_scr uchar 4096
global b_scrl ulong 1
global b_verify ulong 1
global b_h1 uchar 64
global b_h2 uchar 64
global b_h3 uchar 64
global b_szwant uchar 256
global b_szwl ulong 1
global b_defused ulong 1

fn b_cleanup_def to void
if eq get b_defused 0 0
ret
end
cb_pa_clr
for j ulong get b_scrl 0 bound 4096
cb_pa_ch get b_scr j
end
cb_rm_flat_pa
put b_defused 0 0
end

fn b_pa_append_pid to void
x = ulong getpid
k = ulong 32
for j ulong 21
k = sub k 1
put cb_numbuf k uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for j ulong sub 32 k bound 32
cb_pa_ch get cb_numbuf add k j
end
end

fn b_pb_append_pid to void
x = ulong getpid
k = ulong 32
for j ulong 21
k = sub k 1
put cb_numbuf k uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for j ulong sub 32 k bound 32
cb_pb_ch get cb_numbuf add k j
end
end

fn b_die msg view uchar * to void
b_cleanup_def
cb_err b_fail
cb_err msg
exit 1
end

fn b_pscr suf view uchar * to void
cb_pa_clr
n = get b_scrl 0
for i ulong n bound 4096
cb_pa_ch get b_scr i
end
cb_pa_tx suf
end

fn b_pbscr suf view uchar * to void
cb_pb_clr
n = get b_scrl 0
for i ulong n bound 4096
cb_pb_ch get b_scr i
end
cb_pb_tx suf
end

note Run binary at cb_pc[0..binlen) with stdin cb_pa and stdout cb_pb (mode 0755)
fn b_pipe_bin binlen ulong mode int to ulong
fi = fopen cb_pa 0 get cb_n 3 524288 0
if lt fi 0
ret 512
end
z0 = unlink cb_pb 0 get cb_n 4
fo = fopen cb_pb 0 get cb_n 4 524865 mode
if lt fo 0
z1 = fclose int fi
ret 512
end
cb_av_clr
p = get cb_n 5
put cb_av p uchar and binlen 255
put cb_av add p 1 uchar shr binlen 8
for i ulong binlen bound 4096
put cb_av add add p 2 i get cb_pc i
end
put cb_n 5 add add p 2 binlen
put cb_n 6 1
put cb_av 0 1
put cb_av 1 0
ret cb_spawn_fds int fi int fo -1 false
end

fn b_set_pc_scr suf view uchar * to ulong
n = get b_scrl 0
for i ulong n bound 4096
put cb_pc i get b_scr i
end
m = len suf
for i ulong m bound 4096
put cb_pc add n i get suf i
end
ret add n m
end

note Step 1: strict seed0.hex loader in pure Omega (exact parity with seed/rung0/load0.sh)
fn b_load_seed0 to ulong
cb_pa_set b_s0hex
if not cb_read_pa
b_die b_e_s0parse
end
n = get cb_n 0
cb_wb_clr
i = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_rb e 10
break
end
e = add e 1
end
note strip comment from '#' and trim spaces/tabs/CR
c_end = e
for k ulong sub e i bound 4096
if eq get cb_rb add i k 35
c_end = add i k
break
end
end
val = ulong 0
digs = ulong 0
for k ulong sub c_end i bound 4096
ch = get cb_rb add i k
if or eq ch 32 or eq ch 9 eq ch 13
continue
end
hv = cb_hex_val ch
if gt hv 15
b_die b_e_s0parse
end
val = or shl val 4 hv
digs = add digs 1
end
if ne digs 0
if ne digs 8
b_die b_e_s0parse
end
cb_wb_ch uchar and val 255
cb_wb_ch uchar and shr val 8 255
cb_wb_ch uchar and shr val 16 255
cb_wb_ch uchar and shr val 24 255
end
i = add e 1
end
b_pscr b_s0_out
if not cb_write_wb_pa 493
b_die b_e_s0parse
end
ret get cb_n 1
end

fn b_step1 to void
sz = b_load_seed0
bl = b_set_pc_scr b_s0_out
cb_pa_set b_s0hex
b_pbscr b_s0_self
if ne b_pipe_bin bl 420 0
b_die b_e_s0self
end
b_pscr b_s0_out
b_pbscr b_s0_self
if not cb_cmp_pa_pb
b_die b_e_s0self
end
cb_pb_set b_s0bin
if not cb_cmp_pa_pb
b_die b_e_s0cmp
end
cb_out b_pass
cb_out b_m_s0
cb_wnum 1 sz
cb_out b_m_s0b
end

fn b_step2 to void
bl = b_set_pc_scr b_s0_out
cb_pa_set b_h1hex
b_pbscr b_h1_out
if ne b_pipe_bin bl 493 0
b_die b_e_h1cmp
end
b_pscr b_h1_out
cb_pb_set b_h1bin
if not cb_cmp_pa_pb
b_die b_e_h1cmp
end
sz = cb_file_size_pa
h1l = b_set_pc_scr b_h1_out
cb_pa_set b_h1hex
b_pbscr b_h1_self
if ne b_pipe_bin h1l 420 0
b_die b_e_h1self
end
b_pscr b_h1_out
b_pbscr b_h1_self
if not cb_cmp_pa_pb
b_die b_e_h1self
end
cb_out b_pass
cb_out b_m_h1
cb_wnum 1 ulong sz
cb_out b_m_h1b
end

fn b_step3 to void
bl = b_set_pc_scr b_h1_out
cb_pa_set b_a2src
b_pbscr b_a2_out
if ne b_pipe_bin bl 493 0
b_die b_e_a2cmp
end
b_pscr b_a2_out
cb_pb_set b_a2bin
if not cb_cmp_pa_pb
b_die b_e_a2cmp
end
sz = cb_file_size_pa
cb_out b_pass
cb_out b_m_a2
cb_wnum 1 ulong sz
cb_out b_m_a2b
end

fn b_match_rb pos ulong t view uchar * to bool
n = get cb_n 0
m = len t
if gt add pos m n
ret false
end
for j ulong m bound 4096
if ne get cb_rb add pos j get t j
ret false
end
end
ret true
end

note Patch p_filesz line of om4.s in cb_rb into cb_wb with new size sz
fn b_patch_om4s sz ulong to void
cb_wb_clr
n = get cb_n 0
i = ulong 0
patched = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_rb e 10
break
end
e = add e 1
end
has_nl = lt e n
if and eq patched 0 and b_match_rb i b_pfmark b_match_rb add i 15 b_pfsuf
cb_wb_tx b_pfmark
for d ulong 8
sh = mul sub 7 d 4
cb_wb_ch get cb_hexd and shr sz sh 15
end
cb_wb_tx b_pfsuf
cb_wb_tx b_pfmid
cb_wb_num sz
cb_wb_tx b_pfend
if has_nl
cb_wb_ch 10
end
patched = 1
else
lenl = sub e i
if has_nl
lenl = add lenl 1
end
cb_wb_rb i lenl
end
i = add e 1
end
if eq patched 0
b_die b_e_om4
end
end

fn b_join_om4 use_patched bool to void
cb_wb_clr
cb_pa_set b_t2
if not cb_append_pa_to_wb
b_die b_e_om4
end
cb_pa_set b_t3
if not cb_append_pa_to_wb
b_die b_e_om4
end
cb_pa_set b_t4
if not cb_append_pa_to_wb
b_die b_e_om4
end
if use_patched
b_pscr b_om4_s2
else
cb_pa_set b_om4s
end
if not cb_append_pa_to_wb
b_die b_e_om4
end
b_pscr b_om4_src
if not cb_write_wb_pa 420
b_die b_e_om4
end
end

fn b_step4 to void
b_join_om4 false
a2l = b_set_pc_scr b_a2_out
b_pscr b_om4_src
b_pbscr b_om4_out
if ne b_pipe_bin a2l 493 0
b_die b_e_om4
end
b_pscr b_om4_out
sz1 = cb_file_size_pa
if le sz1 0
b_die b_e_om4
end
cb_pa_set b_om4s
if not cb_read_pa
b_die b_e_om4
end
b_patch_om4s ulong sz1
b_pscr b_om4_s2
if not cb_write_wb_pa 420
b_die b_e_om4
end
if eq get b_verify 0 0
cb_pa_set b_om4s
if not cb_write_wb_pa 420
b_die b_e_om4
end
end
b_join_om4 true
b_pscr b_om4_src
b_pbscr b_om4_out
if ne b_pipe_bin a2l 493 0
b_die b_e_om4
end
b_pscr b_om4_out
sz2 = cb_file_size_pa
if ne sz1 sz2
b_die b_e_om4
end
if eq get b_verify 0 0
b_pscr b_om4_out
cb_pb_set b_om4b
if not cb_copy_pa_to_pb 493
b_die b_e_om4
end
else
b_pscr b_om4_out
cb_pb_set b_om4b
if not cb_cmp_pa_pb
b_die b_e_om4
end
end
cb_out b_pass
cb_out b_m_o4
cb_wnum 1 ulong sz2
cb_out b_m_o4b
end

note Compose diaggen.om: om2\n + seed/trace/sha256.om up to "^fn sha256 " + seed/omc/diaggen.om
fn b_build_diaggen to void
cb_pa_set b_tsha
if not cb_read_pa
b_die b_e_dg
end
n = get cb_n 0
cut = n
i = ulong 0
while lt i n bound 9223372036854775807
if b_match_rb i b_fnsha
cut = i
break
end
while lt i n bound 9223372036854775807
if eq get cb_rb i 10
i = add i 1
break
end
i = add i 1
end
end
cb_wb_clr
cb_wb_tx b_om2l
cb_wb_rb 0 cut
cb_pa_set b_dgen
if not cb_append_pa_to_wb
b_die b_e_dg
end
b_pscr b_dgom
if not cb_write_wb_pa 420
b_die b_e_dg
end
st1l = b_set_pc_scr b_st1
b_pscr b_dgom
b_pbscr b_dgbin
if ne cb_run_omc st1l 493 -1 0
b_die b_e_dg
end
note Run diaggen to check diagnostic source identity
cb_av_clr
b_pscr b_dgbin
cb_av_push_pa
cb_av_push_tx b_omcsrc
cb_av_push_tx b_errreg
cb_av_push_tx b_tsha
cb_av_push_tx b_drt
b_pscr b_dgout
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
if lt fo 0
b_die b_e_dg
end
if ne cb_spawn_fds -1 int fo -1 false 0
b_die b_e_dg
end
b_pscr b_dgout
cb_pb_set b_omcsrc
if not cb_cmp_pa_pb
b_die b_e_dg
end
cb_out b_pass
cb_out b_m_dg
end

note Pure-Omega replacement for python3 seed/omc/tests/size-record.py (all 8 cases!)
fn b_sr_expect_line src_len ulong bin_len ulong to void
lines = ulong 0
fns = ulong 0
i = ulong 0
at_bol = true
while lt i src_len bound 9223372036854775807
if at_bol
if b_match_rb i b_fnsp
fns = add fns 1
end
at_bol = false
end
if eq get cb_rb i 10
lines = add lines 1
at_bol = true
end
i = add i 1
end
words = div sub bin_len 176 4
cb_wb_clr
cb_wb_tx b_sr_pfx
for j ulong 12
cb_wb_ch get cb_shex j
end
cb_wb_tx b_sr_mid
cb_wb_num lines
cb_wb_tx b_sr_tab
cb_wb_num fns
cb_wb_tx b_sr_tab
cb_wb_num words
cb_wb_tx b_sr_tab
for j ulong 64
cb_wb_ch get cb_shex j
end
cb_wb_ch 10
n = get cb_n 1
if gt n 256
b_die b_e_sr
end
for j ulong n bound 256
put b_szwant j get cb_wb j
end
put b_szwl 0 n
end

fn b_sr_run_dg expect_rc ulong check_out bool to void
cb_av_clr
b_pscr b_dgbin
cb_av_push_pa
if ne expect_rc 60
b_pscr b_sr_src
cb_av_push_pa
b_pscr b_sr_bin
cb_av_push_pa
end
b_pscr b_sr_out
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
fe = fopen cb_devnull 0 len cb_devnull 524289 0
if or lt fo 0 lt fe 0
b_die b_e_sr
end
rc = cb_spawn_fds -1 int fo int fe false
if ne rc expect_rc
b_die b_e_sr
end
b_pscr b_sr_out
if not cb_read_pa
b_die b_e_sr
end
if check_out
wl = get b_szwl 0
if ne get cb_n 0 wl
b_die b_e_sr
end
for j ulong wl bound 256
if ne get cb_rb j get b_szwant j
b_die b_e_sr
end
end
else
if ne get cb_n 0 0
b_die b_e_sr
end
end
end

fn b_check_size_records to void
note Case 1: current omc.om + stage3
cb_pa_set b_omcsrc
b_pbscr b_sr_src
if not cb_copy_pa_to_pb 420
b_die b_e_sr
end
b_pscr b_st3
b_pbscr b_sr_bin
if not cb_copy_pa_to_pb 420
b_die b_e_sr
end
b_pscr b_sr_bin
blen = cb_file_size_pa
if not cb_sha_file_pa
b_die b_e_sr
end
b_pscr b_sr_src
if not cb_read_pa
b_die b_e_sr
end
b_sr_expect_line get cb_n 0 ulong blen
b_sr_run_dg 0 true

note Case 2: source-lines
cb_wb_clr
cb_wb_tx b_sr_alt
b_pscr b_sr_src
if not cb_write_wb_pa 420
b_die b_e_sr
end
b_pscr b_sr_bin
if not cb_sha_file_pa
b_die b_e_sr
end
b_pscr b_sr_src
if not cb_read_pa
b_die b_e_sr
end
b_sr_expect_line get cb_n 0 ulong blen
b_sr_run_dg 0 true

note Case 3: binary-content (flip last byte of stage3)
cb_pa_set b_omcsrc
b_pbscr b_sr_src
if not cb_copy_pa_to_pb 420
b_die b_e_sr
end
b_pscr b_st3
if not cb_read_pa
b_die b_e_sr
end
bn = get cb_n 0
last = get cb_rb sub bn 1
put cb_rb sub bn 1 xor last 1
b_pscr b_sr_bin
if not cb_write_rb_pa 420
b_die b_e_sr
end
if not cb_sha_file_pa
b_die b_e_sr
end
b_pscr b_sr_src
if not cb_read_pa
b_die b_e_sr
end
b_sr_expect_line get cb_n 0 bn
b_sr_run_dg 0 true

note Case 4: empty binary -> exit 67
cb_wb_clr
b_pscr b_sr_bin
if not cb_write_wb_pa 420
b_die b_e_sr
end
b_sr_run_dg 67 false

note Case 5: short binary (175 bytes) -> exit 67
b_pscr b_st3
if not cb_read_pa
b_die b_e_sr
end
cb_wb_clr
cb_wb_rb 0 175
b_pscr b_sr_bin
if not cb_write_wb_pa 420
b_die b_e_sr
end
b_sr_run_dg 67 false

note Case 6: unaligned binary (bn - 1 bytes) -> exit 67
cb_wb_clr
cb_wb_rb 0 sub bn 1
b_pscr b_sr_bin
if not cb_write_wb_pa 420
b_die b_e_sr
end
b_sr_run_dg 67 false

note Case 7: bad magic -> exit 67
cb_wb_clr
cb_wb_tx b_sr_bad
cb_wb_rb 4 sub bn 4
b_pscr b_sr_bin
if not cb_write_wb_pa 420
b_die b_e_sr
end
b_sr_run_dg 67 false

note Case 8: usage (no args) -> exit 60
b_sr_run_dg 60 false
cb_out b_m_srp
end

fn b_copy_hex_to dst ulong to void
for j ulong 64
if eq dst 1
put b_h1 j get cb_shex j
else
if eq dst 2
put b_h2 j get cb_shex j
else
put b_h3 j get cb_shex j
end
end
end
end

fn b_hex_eq_12 to bool
for j ulong 64
if ne get b_h1 j get b_h2 j
ret false
end
end
ret true
end

fn b_hex_eq_23 to bool
for j ulong 64
if ne get b_h2 j get b_h3 j
ret false
end
end
ret true
end

fn b_update_history to void
note Generate size record for stage3
cb_av_clr
b_pscr b_dgbin
cb_av_push_pa
cb_av_push_tx b_omcsrc
b_pscr b_st3
cb_av_push_pa
b_pscr b_szrec
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
if lt fo 0

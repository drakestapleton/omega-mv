put rl_scrl 0 len rl_defscr
end
ret rl_cmd_uxl
end
if cb_pa_eq rl_c_pkg
if ne ac 4
cb_err rl_usage
ret 2
end
if not cb_pa_arg 2
ret 2
end
for i ulong get cb_n 3 bound 4096
put rl_out i get cb_pa i
end
put rl_outl 0 get cb_n 3
if not cb_pa_arg 3
ret 2
end
if gt get cb_n 3 255
ret 2
end
for i ulong get cb_n 3 bound 256
put rl_ver i get cb_pa i
end
put rl_verl 0 get cb_n 3
ret rl_cmd_package
end
if cb_pa_eq rl_c_ver
if ne ac 3

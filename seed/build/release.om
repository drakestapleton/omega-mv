ret 1
end
ret 0
end

note ---- Pure-Omega UXL verifier ----
fn rl_uxl_level1 to bool
cb_pa_set rl_l1_json
if not cb_read_pa
ret false
end
n = get cb_n 0
ze1 = enlarge rl_l1buf n
if ne ze1 0
ret false
end
for i ulong n bound 9223372036854775807
put rl_l1buf i get cb_rb i
end
put rl_l1n 0 n
cnt = ulong 0
i = ulong 0
while lt i n bound 9223372036854775807
note find opening quote of key
while lt i n bound 9223372036854775807
if eq get rl_l1buf i 34
break
end
i = add i 1
end
if ge i n
break
end
ks = add i 1
ke = ks
while lt ke n bound 4096
if eq get rl_l1buf ke 34
break
end
ke = add ke 1
end
if ge ke n
ret false
end
note find opening quote of value
i = add ke 1
while lt i n bound 4096
if eq get rl_l1buf i 34
break
end
i = add i 1
end
if ge i n
ret false
end
vs = add i 1
ve = vs
while lt ve n bound 256
if eq get rl_l1buf ve 34
break
end
ve = add ve 1
end
if ne sub ve vs 64
ret false
end
cb_pa_set rl_l1_dir
for j ulong sub ke ks bound 4096
cb_pa_ch get rl_l1buf add ks j
end
if not cb_sha_file_pa
cb_out rl_uxl_f2
cb_wbuf_pa 1
cb_out cb_nl
ret false
end
for j ulong 64
if ne get cb_shex j get rl_l1buf add vs j
cb_out rl_uxl_f2
cb_wbuf_pa 1
cb_out cb_nl
ret false
end
end
cnt = add cnt 1
i = add ve 1
end
if lt cnt 60
ret false
end
cb_out rl_uxl_s2
cb_wnum 1 cnt
cb_out cb_nl
ret true
end

fn rl_uxl_spv_row k view uchar * e view uchar * want_sha view uchar * to bool
cb_av_clr
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_tx rl_gpuc_bin
cb_av_push_pa
cb_av_push_tx rl_srun
cb_av_push_tx k
cb_av_push_tx e
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_tx rl_gpuc_out
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
if lt fo 0
ret false
end
if ne cb_spawn_fds -1 int fo -1 false 0
ret false
end
if not cb_file_contains_pa want_sha
ret false
end
ret true
end

fn rl_cmd_uxl to int

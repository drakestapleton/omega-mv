pass = add pass 1
else
cb_out rl_uxl_f1
fail = add fail 1
end

note Stage 2: Level 1 65-file SHA256.json
if rl_uxl_level1
pass = add pass 1
else
fail = add fail 1
end

note Compile gpucoord into SCRATCH/om-gpucoord
cb_wb_clr
cb_pa_set rl_src_com
z0 = cb_append_pa_to_wb
cb_pa_set rl_src_gpu
z1 = cb_append_pa_to_wb
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_tx rl_gpuc_src
z2 = cb_write_wb_pa 420
for i ulong len rl_omc bound 4096
put cb_pc i get rl_omc i
end
cb_pb_clr
for i ulong get rl_scrl 0 bound 4096
cb_pb_ch get rl_scr i
end
cb_pb_tx rl_gpuc_bin
if ne cb_run_omc len rl_omc 493 -1 0
cb_out rl_uxl_f3
ret 1
end

note Stage 3: spirv-check
cb_av_clr
cb_av_push_pb
cb_av_push_tx rl_schk
fo3 = fopen cb_devnull 0 len cb_devnull 524289 0
if eq cb_spawn_fds -1 int fo3 -1 false 0
cb_out rl_uxl_s3
pass = add pass 1
else
cb_out rl_uxl_f3
fail = add fail 1
end

note Stage 4: rmsnorm cl + vk
if and rl_uxl_spv_row rl_k_rms rl_e_cl rl_sha_rms rl_uxl_spv_row rl_k_rms rl_e_vk rl_sha_rms
cb_out rl_uxl_s4
pass = add pass 1
else
cb_out rl_uxl_f4
fail = add fail 1
end

note Stage 5: vadd, fsum16, gemm16 cl + vk
s5 = true
if not rl_uxl_spv_row rl_k_vadd rl_e_cl rl_sha_vadd
s5 = false
end
if not rl_uxl_spv_row rl_k_vadd rl_e_vk rl_sha_vadd
s5 = false
end
if not rl_uxl_spv_row rl_k_fsum rl_e_cl rl_sha_fsum
s5 = false
end
if not rl_uxl_spv_row rl_k_fsum rl_e_vk rl_sha_fsum
s5 = false
end
if not rl_uxl_spv_row rl_k_gemm rl_e_cl rl_sha_gemm
s5 = false
end
if not rl_uxl_spv_row rl_k_gemm rl_e_vk rl_sha_gemm
s5 = false
end
if s5
cb_out rl_uxl_s5
pass = add pass 1
else
cb_out rl_uxl_f5
fail = add fail 1
end

note Stage 6: intel-gate
cb_av_clr
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_tx rl_gpuc_bin
cb_av_push_pa
cb_av_push_tx rl_ixe
fo6 = fopen cb_devnull 0 len cb_devnull 524289 0
if eq cb_spawn_fds -1 int fo6 -1 false 0
cb_out rl_uxl_s6
pass = add pass 1
else
cb_out rl_uxl_f6
fail = add fail 1
end

cb_out rl_uxl_sum1
cb_wnum 1 pass
cb_out rl_uxl_sum2
cb_wnum 1 fail
cb_out cb_nl
if ne fail 0
ret 1
end
ret 0
end

note ---- Package & Verify ----
fn rl_man_ch c uchar to void
n = get rl_mann 0
if ge n len rl_man
cap = len rl_man
if eq cap 0
cap = 16384
end
z = enlarge rl_man mul cap 2
end
put rl_man n c
put rl_mann 0 add n 1
end

fn rl_man_tx t view uchar * to void
for i ulong len t bound 4096
rl_man_ch get t i
end
end

fn rl_man_num v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put cb_numbuf i uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for q ulong sub 32 i bound 32
rl_man_ch get cb_numbuf add i q
end
end

fn rl_sums_ch c uchar to void
n = get rl_sumsn 0
if ge n len rl_sums
cap = len rl_sums
if eq cap 0
cap = 16384
end
z = enlarge rl_sums mul cap 2
end
put rl_sums n c
put rl_sumsn 0 add n 1
end

fn rl_sums_tx t view uchar * to void
for i ulong len t bound 4096
rl_sums_ch get t i
end
end

fn rl_json_ch c uchar to void
n = get rl_jsonn 0
if ge n len rl_json
cap = len rl_json
if eq cap 0
cap = 16384
end
z = enlarge rl_json mul cap 2
end
put rl_json n c
put rl_jsonn 0 add n 1
end

fn rl_json_tx t view uchar * to void
for i ulong len t bound 4096
rl_json_ch get t i
end
end

fn rl_json_num v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put cb_numbuf i uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for q ulong sub 32 i bound 32
rl_json_ch get cb_numbuf add i q
end
end

fn rl_record_art rel view uchar * to bool
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_ch 47
cb_pa_tx rel
sz = cb_file_size_pa
if lt sz 0
ret false
end
if not cb_sha_file_pa
ret false
end
note TSV row
rl_man_tx rel
rl_man_tx rl_tab
rl_man_num ulong sz
rl_man_tx rl_tab
for j ulong 64
rl_man_ch get cb_shex j
end
rl_man_ch 10
note SHA256SUMS row
for j ulong 64
rl_sums_ch get cb_shex j
end
rl_sums_tx rl_sp2
rl_sums_tx rel
rl_sums_ch 10
note JSON row
if gt get rl_pkg_idx 0 0
rl_json_tx rl_j_cm
end
rl_json_tx rl_j_a1
rl_json_tx rel
rl_json_tx rl_j_a2
rl_json_num ulong sz
rl_json_tx rl_j_a3
for j ulong 64
rl_json_ch get cb_shex j
end
rl_json_tx rl_j_a4
put rl_pkg_idx 0 add get rl_pkg_idx 0 1
ret true
end

fn rl_build_coord src view uchar * rel_out view uchar * to bool
cb_wb_clr
cb_pa_set rl_src_com
if not cb_append_pa_to_wb
ret false
end
cb_pa_set src
if not cb_append_pa_to_wb
ret false
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_gpuc_src
if not cb_write_wb_pa 420
ret false
end
for i ulong len rl_omc bound 4096
put cb_pc i get rl_omc i
end
cb_pb_clr
for i ulong get rl_outl 0 bound 4096
cb_pb_ch get rl_out i
end
cb_pb_ch 47
cb_pb_tx rel_out
rc = cb_run_omc len rl_omc 493 -1
z0 = unlink cb_pa 0 get cb_n 3
if ne rc 0
ret false
end
ret rl_record_art rel_out
end

fn rl_is_ver_ch c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if or eq c 46 eq c 45
ret true
end
ret or eq c 95 eq c 43
end

fn rl_ver_safe to bool
n = get rl_verl 0
if or eq n 0 gt n 64
ret false
end
for i ulong n bound 64
if not rl_is_ver_ch get rl_ver i
ret false
end
end
ret true
end

fn rl_cmd_package to int
if not rl_ver_safe
cb_err rl_pkg_bad
ret 2
end
put rl_rootl 0 0
if ne rl_cmd_check_locks 0
cb_err rl_pkg_bad
ret 1
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_d_bin
if not cb_mkdir_p_pa
cb_err rl_pkg_bad
ret 1
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_d_seed
if not cb_mkdir_p_pa
cb_err rl_pkg_bad
ret 1
end

put rl_mann 0 0
put rl_sumsn 0 0
put rl_jsonn 0 0
put rl_pkg_idx 0 0
rl_man_tx rl_man_hdr
rl_json_tx rl_j_1
for i ulong get rl_verl 0 bound 64
rl_json_ch get rl_ver i
end
rl_json_tx rl_j_2
for j ulong 64
rl_json_ch get rl_omchex j
end
rl_json_tx rl_j_3

note Copy omc, seed0.hex, omc.sha256
cb_pa_set rl_omc
cb_pb_clr
for i ulong get rl_outl 0 bound 4096
cb_pb_ch get rl_out i
end
cb_pb_ch 47
cb_pb_tx rl_r_omc
if not cb_copy_pa_to_pb 493
cb_err rl_pkg_bad
ret 1
end
if not rl_record_art rl_r_omc
cb_err rl_pkg_bad
ret 1
end

if not rl_build_coord rl_src_bir rl_r_bir
cb_err rl_pkg_bad
ret 1
end
if not rl_build_coord rl_src_uni rl_r_uni
cb_err rl_pkg_bad
ret 1
end
if not rl_build_coord rl_src_tls rl_r_tls
cb_err rl_pkg_bad
ret 1
end
if not rl_build_coord rl_src_efi rl_r_efi
cb_err rl_pkg_bad
ret 1
end
if not rl_build_coord rl_src_gpu rl_r_gpu
cb_err rl_pkg_bad
ret 1
end
if not rl_build_coord rl_src_rel rl_r_rel
cb_err rl_pkg_bad
ret 1
end

cb_pa_set rl_s0hex
cb_pb_clr
for i ulong get rl_outl 0 bound 4096
cb_pb_ch get rl_out i
end
cb_pb_ch 47
cb_pb_tx rl_r_s0
if not cb_copy_pa_to_pb 420
cb_err rl_pkg_bad
ret 1
end
if not rl_record_art rl_r_s0
cb_err rl_pkg_bad
ret 1
end

cb_pa_set rl_omcsha
cb_pb_clr
for i ulong get rl_outl 0 bound 4096
cb_pb_ch get rl_out i
end
cb_pb_ch 47
cb_pb_tx rl_r_sha
if not cb_copy_pa_to_pb 420
cb_err rl_pkg_bad
ret 1
end
if not rl_record_art rl_r_sha
cb_err rl_pkg_bad
ret 1
end

rl_json_tx rl_j_end

note Write RELEASE-MANIFEST.tsv, SHA256SUMS, release-manifest.json
cb_wb_clr
for i ulong get rl_mann 0 bound 9223372036854775807
cb_wb_ch get rl_man i
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_f_man
if not cb_write_wb_pa 420
cb_err rl_pkg_bad
ret 1
end

cb_wb_clr
for i ulong get rl_sumsn 0 bound 9223372036854775807
cb_wb_ch get rl_sums i
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_f_sums
if not cb_write_wb_pa 420
cb_err rl_pkg_bad
ret 1
end

cb_wb_clr
for i ulong get rl_jsonn 0 bound 9223372036854775807
cb_wb_ch get rl_json i
end
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_f_json
if not cb_write_wb_pa 420
cb_err rl_pkg_bad
ret 1
end

cb_out rl_pkg_ok1
r1 = write 1 rl_ver 0 get rl_verl 0
cb_out rl_pkg_ok2
r2 = write 1 rl_out 0 get rl_outl 0
cb_out cb_nl
ret 0
end

fn rl_relpath_safe s ulong e ulong to bool
if or eq s e gt sub e s 1024
ret false
end
if eq get rl_man s 47
ret false
end
i = s
while lt i e bound 4096
c = get rl_man i
if or lt c 32 gt c 126
ret false
end
if and eq c 46 lt add i 1 e
if eq get rl_man add i 1 46
ret false
end
end
i = add i 1
end
ret true
end

fn rl_seen_eq p ulong s ulong pl ulong to bool
for j ulong pl bound 1024
if ne get rl_seen add p j get rl_man add s j
ret false
end
end
ret true
end

fn rl_seen_next_nl p ulong sn ulong to ulong
q = p
while lt q sn bound 1048576
if eq get rl_seen q 10
break
end
q = add q 1
end
ret q
end

fn rl_seen_add s ulong e ulong to bool
pl = sub e s
sn = get rl_seenn 0
p = ulong 0
while lt p sn bound 1048576
q = rl_seen_next_nl p sn
if eq sub q p pl
if rl_seen_eq p s pl
ret false
end
end
p = add q 1
end
need = add add sn pl 1
if gt need len rl_seen
cap = len rl_seen
if eq cap 0
cap = 16384
end
while lt cap need bound 64
cap = mul cap 2
end
z = enlarge rl_seen cap
end
for j ulong pl bound 1024
put rl_seen add sn j get rl_man add s j
end
put rl_seen add sn pl 10
put rl_seenn 0 need
ret true
end

fn rl_find_tab s ulong e ulong to ulong
t = s
while lt t e bound 4096
if eq get rl_man t 9
break
end
t = add t 1
end
ret t
end

fn rl_parse_u64_man s ulong e ulong to long
if eq s e
ret -1
end
v = ulong 0
for k ulong sub e s bound 32
c = get rl_man add s k
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 ulong sub c 48
end
ret long v
end

fn rl_check_hex_man pos ulong to bool
for j ulong 64
if ne get cb_shex j get rl_man add pos j
ret false
end
end
ret true
end

fn rl_verify_row i ulong e ulong to bool
t1 = rl_find_tab i e
if ge t1 e
cb_err rl_ver_bad
cb_err rl_ver_e2
ret false
end
t2 = rl_find_tab add t1 1 e
if ge t2 e
cb_err rl_ver_bad
cb_err rl_ver_e2
ret false
end
if ne sub sub e t2 1 64
cb_err rl_ver_bad
cb_err rl_ver_e2
ret false
end
if not rl_relpath_safe i t1
cb_err rl_ver_bad
cb_err rl_ver_e3
ret false
end
if not rl_seen_add i t1
cb_err rl_ver_bad
cb_err rl_ver_e3
ret false
end
bval = rl_parse_u64_man add t1 1 t2
if lt bval 0
cb_err rl_ver_bad
cb_err rl_ver_e2
ret false
end
cb_pa_clr
for k ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out k
end
cb_pa_ch 47
for k ulong sub t1 i bound 1024
cb_pa_ch get rl_man add i k
end
sz = cb_file_size_pa
if ne sz bval
cb_err rl_ver_bad
cb_err rl_ver_e4
cb_wbuf_pa 2
cb_err cb_nl
ret false
end
if not cb_sha_file_pa
cb_err rl_ver_bad
cb_err rl_ver_e4
cb_wbuf_pa 2
cb_err cb_nl
ret false
end
if not rl_check_hex_man add t2 1
cb_err rl_ver_bad
cb_err rl_ver_e4
cb_wbuf_pa 2
cb_err cb_nl
ret false
end
ret true
end

fn rl_cmd_verify to int
cb_pa_clr
for i ulong get rl_outl 0 bound 4096
cb_pa_ch get rl_out i
end
cb_pa_tx rl_f_man
if not cb_read_pa
cb_err rl_ver_bad
cb_err rl_ver_e1
ret 1
end
n = get cb_n 0
if lt n len rl_man_hdr
cb_err rl_ver_bad
cb_err rl_ver_e2
ret 1
end
ze2 = enlarge rl_man n
if ne ze2 0
ret 1
end
for i ulong n bound 9223372036854775807
put rl_man i get cb_rb i
end
put rl_mann 0 n
for j ulong len rl_man_hdr bound 64
if ne get rl_man j get rl_man_hdr j
cb_err rl_ver_bad
cb_err rl_ver_e2
ret 1
end
end
put rl_seenn 0 0
cnt = ulong 0
i = len rl_man_hdr
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get rl_man e 10
break
end
e = add e 1
end
if eq i e
i = add e 1
continue
end
if not rl_verify_row i e
ret 1
end
cnt = add cnt 1
i = add e 1
end
if eq cnt 0
cb_err rl_ver_bad
cb_err rl_ver_e5
ret 1
end
cb_out rl_ver_ok
cb_wnum 1 cnt
cb_out cb_nl
ret 0
end

fn main to int
ac = argcnt
if lt ac 2
cb_err rl_usage
ret 2
end
if not cb_pa_arg 1

global rl_root uchar 4096
global rl_rootl ulong 1
global rl_scr uchar 4096
global rl_scrl ulong 1
global rl_out uchar 4096
global rl_outl ulong 1
global rl_ver uchar 256
global rl_verl ulong 1
global rl_omchex uchar 64
global rl_findings ulong 1
global rl_paths ulong 1
global rl_secrets ulong 1
global rl_dstack uchar *
global rl_dso ulong 1
global rl_sibs uchar *
global rl_sibn ulong 1
global rl_sibc ulong 1
global rl_siboff ulong 4096
global rl_siblen ulong 4096
global rl_l1buf uchar *
global rl_l1n ulong 1
global rl_man uchar *
global rl_mann ulong 1
global rl_sums uchar *
global rl_sumsn ulong 1
global rl_json uchar *
global rl_jsonn ulong 1
global rl_seen uchar *
global rl_seenn ulong 1
global rl_pkg_idx ulong 1

fn rl_pa_root rel view uchar * to void
cb_pa_clr
rl = get rl_rootl 0
if gt rl 0
for i ulong rl bound 4096
cb_pa_ch get rl_root i
end
cb_pa_ch 47
end
cb_pa_tx rel
end

fn rl_check_hex_line allow_comments bool to bool
n = get cb_n 0
i = ulong 0
found = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_rb e 10
break
end
e = add e 1
end
ll = sub e i
if allow_comments
if or eq ll 0 eq get cb_rb i 35
i = add e 1
continue
end
end
if ne ll 40
ret false
end
for j ulong 40
if not cb_is_hex get cb_rb add i j
ret false
end
end
found = add found 1
if gt found 1
ret false
end
i = add e 1
end
ret eq found 1
end

fn rl_check_one_lock rel view uchar * allow_c bool to bool
rl_pa_root rel
if not cb_read_pa
cb_err rl_fail_lk
cb_err rl_e_lock
cb_err rel
cb_err cb_nl
ret false
end
if not rl_check_hex_line allow_c
cb_err rl_fail_lk
cb_err rl_e_lock
cb_err rel
cb_err cb_nl
ret false
end
ret true
end

fn rl_is_lower_eq buf_off ulong blen ulong t view uchar * to bool
if ne blen len t
ret false
end
for j ulong blen bound 256
c = get cb_dent add buf_off j
if and ge c 65 le c 90
c = add c 32
end
if ne c get t j
ret false
end
end
ret true
end

fn rl_name_is_secret off ulong nlen ulong to bool
if lt nlen 4
ret false
end
if ne get cb_dent off 46
ret false
end
if ne get cb_dent add off 1 101
ret false
end
if ne get cb_dent add off 2 110
ret false
end
if ne get cb_dent add off 3 118
ret false
end
if eq nlen 4
ret true
end
if ne get cb_dent add off 4 46
ret false
end
if rl_is_lower_eq off nlen rl_env_ex
ret false
end
if rl_is_lower_eq off nlen rl_env_tp
ret false
end
ret true
end

fn rl_dent_nlen ns ulong lim ulong to ulong
nl = ulong 0
while lt add ns nl lim bound 256
if eq get cb_dent add ns nl 0
break
end
nl = add nl 1
end
ret nl
end

fn rl_dstack_push ns ulong nl ulong to void
so = get rl_dso 0
need = add add so nl 2
if gt need len rl_dstack
cap = len rl_dstack
if eq cap 0
cap = 65536
end
while lt cap need bound 64
cap = mul cap 2
end
z0 = enlarge rl_dstack cap
end
put rl_dstack so uchar and nl 255
put rl_dstack add so 1 uchar shr nl 8
for j ulong nl bound 256
put rl_dstack add add so 2 j get cb_dent add ns j
end
put rl_dso 0 need
end

fn rl_pa_append_dstack cur ulong nl ulong base_len ulong to void
put cb_n 3 base_len
if gt base_len 0
cb_pa_ch 47
end
for j ulong nl bound 256
cb_pa_ch get rl_dstack add add cur 2 j
end
end

fn rl_sec_ent dt uchar ns ulong nl ulong depth ulong to void
if and eq nl 1 eq get cb_dent ns 46
ret
end
if and eq nl 2 and eq get cb_dent ns 46 eq get cb_dent add ns 1 46
ret
end
if and eq dt 4 rl_is_lower_eq ns nl rl_d_git
ret
end
if and eq dt 4 and eq depth 0 or rl_is_lower_eq ns nl rl_d_bld rl_is_lower_eq ns nl rl_d_ev
ret
end
if and ne dt 4 rl_name_is_secret ns nl
cb_err rl_fail_lk
cb_err rl_e_sec
cb_wbuf_pa 2
cb_err cb_slash
r = write 2 cb_dent ns nl
cb_err cb_nl
put rl_secrets 0 add get rl_secrets 0 1
end
if eq dt 4
rl_dstack_push ns nl
end
end

fn rl_scan_sec_buf nr ulong depth ulong to void
pos = ulong 0
while lt pos nr bound 32768
rlen = or ulong get cb_dent add pos 16 shl ulong get cb_dent add pos 17 8
if eq rlen 0
break
end
dt = get cb_dent add pos 18
ns = add pos 19
nl = rl_dent_nlen ns add pos rlen
rl_sec_ent dt ns nl depth
pos = add pos rlen
end
end

fn rl_dstack_u16 cur ulong to ulong
b0 = ulong get rl_dstack cur
b1 = ulong get rl_dstack add cur 1
ret or b0 shl b1 8
end

fn rl_read_sec_dir depth ulong to bool
dfd = fopen cb_pa 0 get cb_n 3 540672 0
if lt dfd 0
ret false
end
while true bound 65536
nr = getdnts int dfd cb_dent 0 32768
if le nr 0
break
end
rl_scan_sec_buf ulong nr depth
end
z1 = fclose int dfd
ret true
end

note Recursive scan for .env secrets (depth bounded by stack, skips .git / build / evidence)
fn rl_scan_secrets_dir depth ulong to void
if gt depth 32
ret
end
base_len = get cb_n 3
start_so = get rl_dso 0
if not rl_read_sec_dir depth
ret
end
end_so = get rl_dso 0
cur = start_so
while lt cur end_so bound 1048576
nl = rl_dstack_u16 cur
rl_pa_append_dstack cur nl base_len
rl_scan_secrets_dir add depth 1
cur = add add cur 2 nl
end
put cb_n 3 base_len
put rl_dso 0 start_so
end

fn rl_check_omc_pin to bool
rl_pa_root rl_omcsha
if not cb_read_pa
ret false
end
if lt get cb_n 0 64
ret false
end
for j ulong 64
c = get cb_rb j
if not cb_is_hex c
ret false
end
put rl_omchex j c
end
rl_pa_root rl_omc
if not cb_sha_file_pa
ret false
end
for j ulong 64
if ne get cb_shex j get rl_omchex j
ret false
end
end
ret true
end

fn rl_cmd_check_locks to int
if not rl_check_omc_pin
cb_err rl_fail_lk
cb_err rl_e_omc
ret 1
end
if not rl_check_one_lock rl_l_phys false
ret 1
end
if not rl_check_one_lock rl_l_aien false
ret 1
end
if not rl_check_one_lock rl_l_arg false
ret 1
end
if not rl_check_one_lock rl_l_br true
ret 1
end
put rl_secrets 0 0
put rl_dso 0 0
cb_pa_clr
if gt get rl_rootl 0 0
for i ulong get rl_rootl 0 bound 4096
cb_pa_ch get rl_root i
end
else
cb_pa_ch 46
end
rl_scan_secrets_dir 0
if ne get rl_secrets 0 0
ret 1
end
cb_out rl_pass_lk1
r = write 1 rl_omchex 0 64
cb_out rl_pass_lk2
ret 0
end

note ---- Pure-Omega replacement for tools/uxl/windows_paths.py ----
fn rl_is_win_reserved off ulong nlen ulong to bool
note stem = before first '.'
sl = nlen
for j ulong nlen bound 256
if eq get cb_dent add off j 46
sl = j
break
end
end
if eq sl 3
if or rl_is_lower_eq off 3 rl_res_con or rl_is_lower_eq off 3 rl_res_prn or rl_is_lower_eq off 3 rl_res_aux rl_is_lower_eq off 3 rl_res_nul
ret true
end
end
if eq sl 4
c0 = get cb_dent off
c1 = get cb_dent add off 1
c2 = get cb_dent add off 2
c3 = get cb_dent add off 3
if and ge c0 65 le c0 90
c0 = add c0 32
end
if and ge c1 65 le c1 90
c1 = add c1 32
end
if and ge c2 65 le c2 90
c2 = add c2 32
end
if and ge c3 49 le c3 57
if and eq c0 99 and eq c1 111 eq c2 109
ret true
end
if and eq c0 108 and eq c1 112 eq c2 116
ret true
end
end
end
ret false
end

fn rl_is_win_badc c uchar to bool
if lt c 32
ret true
end
if or eq c 60 eq c 62
ret true
end
if or eq c 58 eq c 34
ret true
end
if or eq c 124 eq c 63
ret true
end
ret eq c 42
end

fn rl_has_win_badc off ulong nlen ulong to bool
for j ulong nlen bound 256
if rl_is_win_badc get cb_dent add off j
ret true
end
end
ret false
end

fn rl_check_win_name off ulong nlen ulong to void
note check trailing dot or space
last = get cb_dent add off sub nlen 1
if or eq last 32 eq last 46
cb_out rl_wp_f
cb_out rl_r_trail
cb_wbuf_pa 1
cb_out cb_slash
r = write 1 cb_dent off nlen
cb_out cb_nl
put rl_findings 0 add get rl_findings 0 1
end
if rl_has_win_badc off nlen
cb_out rl_wp_f
cb_out rl_r_char
cb_wbuf_pa 1
cb_out cb_slash
r = write 1 cb_dent off nlen
cb_out cb_nl
put rl_findings 0 add get rl_findings 0 1
end
if rl_is_win_reserved off nlen
cb_out rl_wp_f
cb_out rl_r_res
cb_wbuf_pa 1
cb_out cb_slash
r = write 1 cb_dent off nlen
cb_out cb_nl
put rl_findings 0 add get rl_findings 0 1
end
end

fn rl_sib_eq_ci a ulong b ulong to bool
la = get rl_siblen a
lb = get rl_siblen b
if ne la lb
ret false
end
oa = get rl_siboff a
ob = get rl_siboff b
for j ulong la bound 256
ca = get rl_sibs add oa j
cb = get rl_sibs add ob j
if and ge ca 65 le ca 90
ca = add ca 32
end
if and ge cb 65 le cb 90
cb = add cb 32
end
if ne ca cb
ret false
end
end
ret true
end

fn rl_sib_push ns ulong nl ulong to void
sc = get rl_sibc 0
if ge sc 4096
ret
end
sn = get rl_sibn 0
if gt add sn nl len rl_sibs
cap = len rl_sibs
if eq cap 0
cap = 65536
end
while lt cap add sn nl bound 64
cap = mul cap 2
end
z0 = enlarge rl_sibs cap
end
put rl_siboff sc sn
put rl_siblen sc nl
for j ulong nl bound 256
put rl_sibs add sn j get cb_dent add ns j
end
put rl_sibn 0 add sn nl
put rl_sibc 0 add sc 1
end

fn rl_path_ent dt uchar ns ulong nl ulong depth ulong to void
if and eq nl 1 eq get cb_dent ns 46
ret
end
if and eq nl 2 and eq get cb_dent ns 46 eq get cb_dent add ns 1 46
ret
end
if and eq dt 4 rl_is_lower_eq ns nl rl_d_git
ret
end
if and eq dt 4 and eq depth 0 rl_is_lower_eq ns nl rl_d_bld
ret
end
put rl_paths 0 add get rl_paths 0 1
rl_check_win_name ns nl
rl_sib_push ns nl
if eq dt 4
rl_dstack_push ns nl
end
end

fn rl_check_sibs to void
sc = get rl_sibc 0
for a ulong sc bound 4096
for b ulong a bound 4096
if rl_sib_eq_ci a b
cb_out rl_wp_f
cb_out rl_r_case
cb_wbuf_pa 1
cb_out cb_slash
r1 = write 1 rl_sibs get rl_siboff a get rl_siblen a
cb_out cb_nl
put rl_findings 0 add get rl_findings 0 1
end
end
end
end

fn rl_scan_path_buf nr ulong depth ulong to void
pos = ulong 0
while lt pos nr bound 32768
rlen = or ulong get cb_dent add pos 16 shl ulong get cb_dent add pos 17 8
if eq rlen 0
break
end
dt = get cb_dent add pos 18
ns = add pos 19
nl = rl_dent_nlen ns add pos rlen
rl_path_ent dt ns nl depth
pos = add pos rlen
end
end

fn rl_read_path_dir depth ulong to bool
dfd = fopen cb_pa 0 get cb_n 3 540672 0
if lt dfd 0
ret false
end
put rl_sibn 0 0
put rl_sibc 0 0
while true bound 65536
nr = getdnts int dfd cb_dent 0 32768
if le nr 0
break
end
rl_scan_path_buf ulong nr depth
end
z2 = fclose int dfd
rl_check_sibs
ret true
end

fn rl_scan_paths_dir depth ulong to void
if gt depth 32
ret
end
base_len = get cb_n 3
start_so = get rl_dso 0
if not rl_read_path_dir depth
ret
end
end_so = get rl_dso 0
cur = start_so
while lt cur end_so bound 1048576
nl = rl_dstack_u16 cur
rl_pa_append_dstack cur nl base_len
rl_scan_paths_dir add depth 1
cur = add add cur 2 nl
end
put cb_n 3 base_len
put rl_dso 0 start_so
end

fn rl_cmd_check_paths to int
put rl_findings 0 0
put rl_paths 0 0
put rl_dso 0 0
cb_pa_clr
if gt get rl_rootl 0 0
for i ulong get rl_rootl 0 bound 4096
cb_pa_ch get rl_root i
end
else
cb_pa_ch 46
end
rl_scan_paths_dir 0
f = get rl_findings 0
if eq f 0
cb_out rl_wp_0
cb_wnum 1 get rl_paths 0
cb_out rl_wp_end
ret 0
end
cb_out rl_wp_cnt1
cb_wnum 1 f
cb_out rl_wp_cnt2
cb_wnum 1 get rl_paths 0
cb_out rl_wp_end
ret 1
end

note ---- Layers gate orchestrator ----
fn rl_run_layer name view uchar * to bool
cb_wb_clr
cb_wb_tx rl_om2l
cb_pa_set rl_ngsha
if not cb_append_pa_to_wb
ret false
end
cb_pa_set name
cb_pa_tx rl_ly_suf
if not cb_append_pa_to_wb
ret false
end
note write gate source in SCRATCH/name.gate.om
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_ch 47
cb_pa_tx name
cb_pa_tx rl_src_com
note actually just use /<name>.om
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_ch 47
cb_pa_tx name
cb_pa_ch 46
cb_pa_ch 111
cb_pa_ch 109
if not cb_write_wb_pa 420
ret false
end
note compile gate -> SCRATCH/name.gate
for i ulong len rl_omc bound 4096
put cb_pc i get rl_omc i
end
cb_pb_clr
for i ulong get rl_scrl 0 bound 4096
cb_pb_ch get rl_scr i
end
cb_pb_ch 47
cb_pb_tx name
cb_pb_ch 46
cb_pb_ch 98
if ne cb_run_omc len rl_omc 493 -1 0
cb_out rl_ly_fail
cb_out name
cb_out cb_nl
ret false
end
note run gate: SCRATCH/name.b seed/out/omc SCRATCH/name-w
cb_av_clr
cb_av_push_pb
cb_av_push_tx rl_omc
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
cb_pa_ch 47
cb_pa_tx name
cb_pa_ch 45
cb_pa_ch 119
cb_av_push_pa
fo = fopen cb_devnull 0 len cb_devnull 524289 0
rc = cb_spawn_fds -1 int fo -1 false
if ne rc 0
cb_out rl_ly_fail
cb_out name
cb_out cb_nl
ret false
end
cb_out rl_ly_pass
cb_out name
cb_out cb_nl
ret true
end

fn rl_cmd_layers to int
cb_pa_clr
for i ulong get rl_scrl 0 bound 4096
cb_pa_ch get rl_scr i
end
if not cb_mkdir_p_pa
ret 1
end
pass = ulong 0
fail = ulong 0
if rl_run_layer rl_ly_0
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_1
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_2
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_3
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_4
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_5
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_6
pass = add pass 1
else
fail = add fail 1
end
if rl_run_layer rl_ly_7
pass = add pass 1
else
fail = add fail 1
end
cb_out rl_ly_sum1
cb_wnum 1 pass
cb_out rl_ly_sum2
cb_wnum 1 fail

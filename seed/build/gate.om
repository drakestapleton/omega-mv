note SPDX-License-Identifier: Apache-2.0
note seed/build/gate.om: OMEGA-BUILD-COORD, the pure seeded-Omega self-qualification gate for all
note pure-Omega build, release, and automation coordinators (birth, units, tlsbuild, sparkefi, gpucoord, release).
note Compiles every coordinator twice with seed/out/omc (proving deterministic bit-identical builds),
note runs end-to-end positive checks AND planted negative controls for every coordinator.
note Zero shell, zero Python.
note Build: cat seed/build/common.om seed/build/gate.om | seed/out/omc > build/om-build-gate
note Usage: om-build-gate SCRATCH_DIR

text gt_usage "usage: om-build-gate SCRATCH_DIR\n"
text gt_omc "seed/out/omc"
text gt_com "seed/build/common.om"
text gt_s_bir "seed/build/birth.om"
text gt_s_uni "seed/build/units.om"
text gt_s_tls "seed/build/tlsbuild.om"
text gt_s_efi "seed/build/sparkefi.om"
text gt_s_gpu "seed/build/gpucoord.om"
text gt_s_rel "seed/build/release.om"
text gt_n_bir "om-birth"
text gt_n_uni "om-units"
text gt_n_tls "om-tlsbuild"
text gt_n_efi "om-sparkefi"
text gt_n_gpu "om-gpucoord"
text gt_n_rel "om-release"
text gt_ok "ok "
text gt_fail "FAIL "
text gt_sum1 "OMEGA-BUILD-COORD "
text gt_pass "PASS"
text gt_fl "FAIL"
text gt_sum2 " checks="
text gt_sum3 " controls="
text gt_sum4 " caught="
text gt_sum5 " hardware=NOT_RUN\n"
text gt_m_det "deterministic-2x "
text gt_m_bir "birth-verify"
text gt_m_tls "tlsbuild-fips"
text gt_m_efi "sparkefi-qemu-pe32"
text gt_m_gpu1 "gpucoord-spirv-check"
text gt_m_gpu2 "gpucoord-intel-gate"
text gt_m_gpu3 "gpucoord-build-spec"
text gt_m_rel1 "release-check-locks"
text gt_m_rel2 "release-check-paths"
text gt_m_rel3 "release-uxl"
text gt_m_rel4 "release-package-verify"
text gt_c_uni "ctrl-units-missing-env-exit3"
text gt_c_efi "ctrl-sparkefi-qemu-refuses-SPARK.EFI"
text gt_c_gpu "ctrl-gpucoord-bad-kernel-refused"
text gt_c_rel1 "ctrl-release-verify-catches-tamper"
text gt_c_rel2 "ctrl-release-paths-catches-CON.txt"
text gt_c_rel3 "ctrl-release-locks-catches-bad-lock"
text gt_f_verify "--verify"
text gt_f_check "--check"
text gt_c_locks "check-locks"
text gt_c_paths "check-paths"
text gt_c_uxl "uxl"
text gt_c_pkg "package"
text gt_c_ver "verify"
text gt_c_srun "spirv-run"
text gt_c_schk "spirv-check"
text gt_c_xe "intel-gate"
text gt_c_spec "build-spec"
text gt_badk "notakernel"
text gt_cl "cl"
text gt_ver "1.0.0-rc1"
text gt_e_plat_q "PLAT=qemu"
text gt_tlsp_src "fn main to int\nr = fips_check 0\nret int r\nend\n"
text gt_b_s1 "/.1"
text gt_b_s2 "/.2"
text gt_b_src "/.src.om"
text gt_d_bir "/birth-w"
text gt_d_tls "/tls-prog.om"
text gt_d_tlso "/tls-prog"
text gt_d_efi "/qemu.efi"
text gt_d_efibad "/SPARK.EFI"
text gt_d_spec "/spec-out"
text gt_d_uxl "/uxl-w"
text gt_d_pkg "/pkg-out"
text gt_d_pkgbin "/pkg-out/bin/om-birth"
text gt_d_badwin "/bad-win"
text gt_d_con "/bad-win/CON.txt"
text gt_d_badlk "/bad-locks"
text gt_d_bl_s "/bad-locks/seed/out"
text gt_d_bl_p "/bad-locks/physics.lock"
text gt_bad_hex "not-a-40-hex-commit\n"
text gt_hi "hi\n"

global gt_scr uchar 4096
global gt_scrl ulong 1
global gt_passc ulong 1
global gt_failc ulong 1
global gt_ctlc ulong 1
global gt_caughtc ulong 1

fn gt_sp suf view uchar * to void
cb_pa_clr
for i ulong get gt_scrl 0 bound 4096
cb_pa_ch get gt_scr i
end
cb_pa_tx suf
end

fn gt_spb suf view uchar * to void
cb_pb_clr
for i ulong get gt_scrl 0 bound 4096
cb_pb_ch get gt_scr i
end
cb_pb_tx suf
end

fn gt_bin_pa name view uchar * to void
cb_pa_clr
for i ulong get gt_scrl 0 bound 4096
cb_pa_ch get gt_scr i
end
cb_pa_ch 47
cb_pa_tx name
end

fn gt_rec_ok name view uchar * to void
cb_out gt_ok
cb_out name
cb_out cb_nl
put gt_passc 0 add get gt_passc 0 1
end

fn gt_rec_fail name view uchar * to void
cb_out gt_fail
cb_out name
cb_out cb_nl
put gt_failc 0 add get gt_failc 0 1
end

fn gt_rec_ctl ok bool name view uchar * to void
put gt_ctlc 0 add get gt_ctlc 0 1
if ok
cb_out gt_ok
cb_out name
cb_out cb_nl
put gt_caughtc 0 add get gt_caughtc 0 1
else
cb_out gt_fail
cb_out name
cb_out cb_nl
put gt_failc 0 add get gt_failc 0 1
end
end

note Compile common.om + src twice, check byte identity, install as SCRATCH/name
fn gt_build_det src view uchar * name view uchar * to bool
cb_wb_clr
cb_pa_set gt_com
if not cb_append_pa_to_wb
gt_rec_fail name
ret false
end
cb_pa_set src
if not cb_append_pa_to_wb
gt_rec_fail name
ret false
end
gt_sp gt_b_src
if not cb_write_wb_pa 420
gt_rec_fail name
ret false
end
for i ulong len gt_omc bound 4096
put cb_pc i get gt_omc i
end
gt_spb gt_b_s1
if ne cb_run_omc len gt_omc 493 -1 0
gt_rec_fail name
ret false
end
gt_spb gt_b_s2
if ne cb_run_omc len gt_omc 493 -1 0
gt_rec_fail name
ret false
end
gt_sp gt_b_s1
gt_spb gt_b_s2
if not cb_cmp_pa_pb
gt_rec_fail name
ret false
end
gt_sp gt_b_s1
cb_pb_clr
for i ulong get gt_scrl 0 bound 4096
cb_pb_ch get gt_scr i
end
cb_pb_ch 47
cb_pb_tx name
if not cb_copy_pa_to_pb 493
gt_rec_fail name
ret false
end
cb_out gt_ok
cb_out gt_m_det
cb_out name
cb_out cb_nl
put gt_passc 0 add get gt_passc 0 1
ret true
end

fn gt_run_quiet use_ev bool to ulong
fo = fopen cb_devnull 0 len cb_devnull 524289 0
fe = fopen cb_devnull 0 len cb_devnull 524289 0
ret cb_spawn_fds -1 int fo int fe use_ev
end

fn main to int
if ne argcnt 2
cb_err gt_usage
ret 2
end
if not cb_pa_arg 1
cb_err gt_usage
ret 2
end
for i ulong get cb_n 3 bound 4096
put gt_scr i get cb_pa i
end
put gt_scrl 0 get cb_n 3
if not cb_mkdir_p_pa
ret 2
end

note 1. Build all 6 coordinators deterministically (2x compile + byte compare)
if not gt_build_det gt_s_bir gt_n_bir
ret 1
end
if not gt_build_det gt_s_uni gt_n_uni
ret 1
end
if not gt_build_det gt_s_tls gt_n_tls
ret 1
end
if not gt_build_det gt_s_efi gt_n_efi
ret 1
end
if not gt_build_det gt_s_gpu gt_n_gpu
ret 1
end
if not gt_build_det gt_s_rel gt_n_rel
ret 1
end

note 2. Positive check: om-birth --verify (full rung0..omc fixpoint + diaggen + 8 size-record + 4 probes)
cb_av_clr
gt_bin_pa gt_n_bir
cb_av_push_pa
cb_av_push_tx gt_f_verify
gt_sp gt_d_bir
cb_av_push_pa
if eq gt_run_quiet false 0
gt_rec_ok gt_m_bir
else
gt_rec_fail gt_m_bir
end

note 3. Positive check: om-tlsbuild builds & FIPS-stamps a real TLS program
cb_wb_clr
cb_wb_tx gt_tlsp_src
gt_sp gt_d_tls
z0 = cb_write_wb_pa 420
cb_av_clr
gt_bin_pa gt_n_tls
cb_av_push_pa
cb_av_push_tx gt_omc
gt_sp gt_d_tls
cb_av_push_pa
gt_sp gt_d_tlso
cb_av_push_pa
if eq gt_run_quiet false 0
note also run the FIPS-stamped TLS binary!
cb_av_clr
gt_sp gt_d_tlso
cb_av_push_pa
if eq gt_run_quiet false 0
gt_rec_ok gt_m_tls
else
gt_rec_fail gt_m_tls
end
else
gt_rec_fail gt_m_tls
end

note 4. Positive check: om-sparkefi with PLAT=qemu builds & verifies PE32+ image
cb_av_clr
gt_bin_pa gt_n_efi
cb_av_push_pa
gt_sp gt_d_efi
cb_av_push_pa
cb_ev_clr
cb_pa_set gt_e_plat_q
cb_ev_push_env_pa
if eq gt_run_quiet true 0
gt_rec_ok gt_m_efi
else
gt_rec_fail gt_m_efi
end

note 5. Negative control: om-sparkefi with PLAT=qemu refuses to write SPARK.EFI
cb_av_clr
gt_bin_pa gt_n_efi
cb_av_push_pa
gt_sp gt_d_efibad
cb_av_push_pa
cb_ev_clr
cb_pa_set gt_e_plat_q
cb_ev_push_env_pa
gt_rec_ctl ne gt_run_quiet true 0 gt_c_efi

note 6. Positive checks: om-gpucoord spirv-check, intel-gate, build-spec
cb_av_clr
gt_bin_pa gt_n_gpu
cb_av_push_pa
cb_av_push_tx gt_c_schk
if eq gt_run_quiet false 0
gt_rec_ok gt_m_gpu1
else
gt_rec_fail gt_m_gpu1
end

cb_av_clr
gt_bin_pa gt_n_gpu
cb_av_push_pa
cb_av_push_tx gt_c_xe
if eq gt_run_quiet false 0
gt_rec_ok gt_m_gpu2
else
gt_rec_fail gt_m_gpu2
end

cb_av_clr
gt_bin_pa gt_n_gpu
cb_av_push_pa
cb_av_push_tx gt_c_spec
gt_sp gt_d_spec
cb_av_push_pa
if eq gt_run_quiet false 0
gt_rec_ok gt_m_gpu3
else
gt_rec_fail gt_m_gpu3
end

note 7. Negative control: om-gpucoord refuses bad kernel
cb_av_clr
gt_bin_pa gt_n_gpu
cb_av_push_pa
cb_av_push_tx gt_c_srun
cb_av_push_tx gt_badk
cb_av_push_tx gt_cl
gt_rec_ctl ne gt_run_quiet false 0 gt_c_gpu

note 8. Negative control: om-units without OMEGA_OMC/OMEGA_BRIDGE exits 3 (NOT_RUN)
cb_av_clr
gt_bin_pa gt_n_uni
cb_av_push_pa
cb_av_push_tx gt_f_check
gt_rec_ctl eq gt_run_quiet false 3 gt_c_uni

note 9. Positive checks: om-release check-locks, check-paths, uxl, package + verify
cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_locks
if eq gt_run_quiet false 0
gt_rec_ok gt_m_rel1
else
gt_rec_fail gt_m_rel1
end

cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_paths
if eq gt_run_quiet false 0
gt_rec_ok gt_m_rel2
else
gt_rec_fail gt_m_rel2
end

cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_uxl
gt_sp gt_d_uxl
cb_av_push_pa
if eq gt_run_quiet false 0
gt_rec_ok gt_m_rel3
else
gt_rec_fail gt_m_rel3
end

cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_pkg
gt_sp gt_d_pkg
cb_av_push_pa
cb_av_push_tx gt_ver
pkg_rc = gt_run_quiet false
ver_rc = ulong 1
if eq pkg_rc 0
cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_ver
gt_sp gt_d_pkg
cb_av_push_pa
ver_rc = gt_run_quiet false
end
if and eq pkg_rc 0 eq ver_rc 0
gt_rec_ok gt_m_rel4
else
gt_rec_fail gt_m_rel4
end

note 10. Negative control: flip 1 byte in packaged bin/om-birth -> verify MUST fail!
gt_sp gt_d_pkgbin
if cb_read_pa
bn = get cb_n 0
if gt bn 0
put cb_rb sub bn 1 xor get cb_rb sub bn 1 1
z1 = cb_write_rb_pa 493
end
end
cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_ver
gt_sp gt_d_pkg
cb_av_push_pa
gt_rec_ctl ne gt_run_quiet false 0 gt_c_rel1

note 11. Negative control: Windows reserved filename CON.txt -> check-paths MUST fail!
gt_sp gt_d_badwin
z2 = cb_mkdir_p_pa
cb_wb_clr
cb_wb_tx gt_hi
gt_sp gt_d_con
z3 = cb_write_wb_pa 420
cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_paths
gt_sp gt_d_badwin
cb_av_push_pa
gt_rec_ctl ne gt_run_quiet false 0 gt_c_rel2

note 12. Negative control: malformed physics.lock -> check-locks MUST fail!
gt_sp gt_d_bl_s
z4 = cb_mkdir_p_pa
cb_wb_clr
cb_wb_tx gt_bad_hex
gt_sp gt_d_bl_p
z5 = cb_write_wb_pa 420
cb_av_clr
gt_bin_pa gt_n_rel
cb_av_push_pa
cb_av_push_tx gt_c_locks
gt_sp gt_d_badlk
cb_av_push_pa
gt_rec_ctl ne gt_run_quiet false 0 gt_c_rel3

note Summary
cb_out gt_sum1
if eq get gt_failc 0 0
cb_out gt_pass
else
cb_out gt_fl
end
cb_out gt_sum2
cb_wnum 1 get gt_passc 0
cb_out gt_sum3
cb_wnum 1 get gt_ctlc 0
cb_out gt_sum4
cb_wnum 1 get gt_caughtc 0
cb_out gt_sum5
if ne get gt_failc 0 0
ret 1
end
if ne get gt_ctlc 0 get gt_caughtc 0
ret 1
end
ret 0
end

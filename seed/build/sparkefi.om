note SPDX-License-Identifier: Apache-2.0
note seed/build/sparkefi.om: Pure seeded-Omega Bare-Metal SPARK.EFI Builder & PE32+ Verifier.
note Replaces aienux/spark/build_spark_efi.sh AND both of its inline Python 3 scripts.
note Zero shell, zero Python.
note Build: cat seed/build/common.om seed/build/sparkefi.om | seed/out/omc > build/om-sparkefi
note Usage: om-sparkefi [OUT_EFI]
note Env:   OMC (default seed/out/omc), PLAT (default gb10), PLAT_OM_OVERRIDE (test profiles only)

text se_defout "build/spark/SPARK.EFI"
text se_defomc "seed/out/omc"
text se_defplat "gb10"
text se_env_omc "OMC"
text se_env_plat "PLAT"
text se_env_ovr "PLAT_OM_OVERRIDE"
text se_sparkefi "SPARK.EFI"
text se_platpfx "aienux/spark/plat_"
text se_omext ".om"
text se_hdr "target a64efi\nom2\n"
text se_note "note "
text se_tmpfile ".spark_unified.om"
text se_f_badplat "FAIL: unknown PLAT or missing plat file\n"
text se_f_testout "FAIL: test profile refuses to write SPARK.EFI\n"
text se_f_ovrgb10 "FAIL: PLAT_OM_OVERRIDE is refused for PLAT=gb10 (production profile)\n"
text se_f_ovrmiss "FAIL: PLAT_OM_OVERRIDE file not found\n"
text se_f_io "FAIL: sparkefi I/O or missing source file\n"
text se_f_omc "FAIL: omc failed compiling spark_unified.om\n"
text se_f_pe "FAIL: PE32+ header verification failed\n"
text se_pass1 "PASS build_spark_efi: "
text se_pass2 " (PLAT="
text se_pass3 ")\n  PE32+ Machine=0xaa64 Subsystem=EFI_APP FileSize="
text se_pass4 " B SizeOfImage="
text se_pass5 " B\n  sha256="

note All 6 Phase 2 slices + spark_main.om
text se_s01 "seed/a64efi/efirt.om"
text se_s02 "aienux/kernel/arm64/fwops.om"
text se_s03 "aienux/kernel/arm64/uart.om"
text se_s04 "aienux/kernel/arm64/frames.om"
text se_s05 "aienux/kernel/arm64/acpi.om"
text se_s06 "aienux/kernel/arm64/mmu.om"
text se_s07 "aienux/kernel/arm64/gicv3.om"
text se_s08 "aienux/kernel/arm64/smp.om"
text se_s09 "aienux/kernel/hal/iort.om"
text se_s10 "aienux/kernel/hal/bar0_mmio.om"
text se_s11 "aienux/kernel/hal/pcie.om"
text se_s12 "aienux/kernel/hal/smmuv3.om"
text se_s13 "gpu/driver/gsp/irqbm.om"
text se_s14 "gpu/driver/gsp/irq.om"
text se_s15 "aienux/disk/nvme_ro_bare.om"
text se_s16 "aienux/disk/nvme_bare_a64efi.om"
text se_s17 "aienux/disk/sha256_bare.om"
text se_s18 "aienux/disk/gpt_ro.om"
text se_s19 "aienux/disk/ext4_ro.om"
text se_s20 "aienux/net/rtl8127/om/rtl8127/rtl8127.om"
text se_s21 "aienux/net/rtl8127/om/rtl8127/bare_a64efi.om"
text se_s22 "aienux/net/tcp/tcp.om"
text se_s23 "gpu/driver/gsp/bm_hal.om"
text se_s24 "gpu/driver/gsp/profile.om"
text se_s25 "gpu/driver/gsp/mmio_bm.om"
text se_s26 "gpu/driver/gsp/sec2.om"
text se_s27 "gpu/driver/gsp/seq.om"
text se_s28 "gpu/driver/gsp/seqcore.om"
text se_s29 "gpu/driver/gsp/rpc.om"
text se_s30 "gpu/driver/gsp/sysinfo.om"
text se_s31 "gpu/driver/chan/params.om"
text se_s32 "gpu/driver/gsp/boot.om"
text se_s33 "gpu/driver/gsp/dispatch.om"
text se_s34 "gpu/driver/gsp/fw_bm.om"
text se_s35 "gpu/driver/gsp/arena_bm.om"
text se_s36 "gpu/driver/gsp/transport_bm.om"
text se_s37 "gpu/driver/chan/gmmu_bm.om"
text se_s38 "gpu/driver/chan/mem.om"
text se_s39 "gpu/driver/chan/chan.om"
text se_s40 "gpu/driver/chan/complete.om"
text se_s41 "gpu/driver/chan/rmchan.om"
text se_s42 "gpu/driver/gsp/compute.om"
text se_s43 "gpu/driver/gsp/q38_run.om"
text se_s44 "gpu/nvidia/om/codegen/cg_dec_emit.om"
text se_s45 "gpu/nvidia/om/codegen/cg_dec.om"
text se_s46 "gpu/nvidia/om/components/bw_alloc.om"
text se_s47 "gpu/nvidia/om/encoder/bw_enc_sm121.om"
text se_s48 "aienux/net/wire/omtk.om"
text se_s49 "aienux/net/wire/wire_loop.om"
text se_s50 "aienux/spark/spark_main.om"

note Token rename strings
text se_t_rb "rb"
text se_t_ctl "ctl"
text se_t_imm "imm"
text se_t_arg "arg"
text se_t_av "av"
text se_t_cw "cw"
text se_t_nv "nv"
text se_t_ob "ob"
text se_t_at "at"
text se_t_rs "rs"
text se_r_cge_rb "cge_rb"
text se_r_cge_ctl "cge_ctl"
text se_r_cge_imm "cge_imm"
text se_r_cge_arg "cge_arg"
text se_r_cge_av "cge_av"
text se_r_cge_cw "cge_cw"
text se_r_cge_nv "cge_nv"
text se_r_cge_ob "cge_ob"
text se_r_cge_pos "cge_pos"
text se_r_cgd_rs "cgd_rs"
text se_r_bwe_rb "bwe_rb"
text se_r_bwe_ctl "bwe_ctl"

global se_out uchar 4096
global se_outl ulong 1
global se_omc uchar 4096
global se_omcl ulong 1
global se_plat uchar 256
global se_platl ulong 1
global se_pom uchar 4096
global se_poml ulong 1

fn se_die msg view uchar * to void
cb_err msg
exit 1
end

fn se_is_word c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

fn se_tok_eq off ulong tlen ulong w view uchar * to bool
if ne tlen len w
ret false
end
for i ulong tlen bound 64
if ne get cb_rb add off i get w i
ret false
end
end
ret true
end

note Emit transformed token for mode: 1 = cg_dec_emit, 2 = cg_dec, 3 = bw_enc_sm121
fn se_emit_tok mode ulong off ulong tlen ulong to void
if eq mode 1
if se_tok_eq off tlen se_t_rb
cb_wb_tx se_r_cge_rb
ret
end
if se_tok_eq off tlen se_t_ctl
cb_wb_tx se_r_cge_ctl
ret
end
if se_tok_eq off tlen se_t_imm
cb_wb_tx se_r_cge_imm
ret
end
if se_tok_eq off tlen se_t_arg
cb_wb_tx se_r_cge_arg
ret
end
if se_tok_eq off tlen se_t_av
cb_wb_tx se_r_cge_av
ret
end
if se_tok_eq off tlen se_t_cw
cb_wb_tx se_r_cge_cw
ret
end
if se_tok_eq off tlen se_t_nv
cb_wb_tx se_r_cge_nv
ret
end
if se_tok_eq off tlen se_t_ob
cb_wb_tx se_r_cge_ob
ret
end
if se_tok_eq off tlen se_t_at
cb_wb_tx se_r_cge_pos
ret
end
end
if eq mode 2
if se_tok_eq off tlen se_t_av
cb_wb_tx se_r_cge_av
ret
end
if se_tok_eq off tlen se_t_cw
cb_wb_tx se_r_cge_cw
ret
end
if se_tok_eq off tlen se_t_nv
cb_wb_tx se_r_cge_nv
ret
end
if se_tok_eq off tlen se_t_ob
cb_wb_tx se_r_cge_ob
ret
end
if se_tok_eq off tlen se_t_arg
cb_wb_tx se_r_cge_arg
ret
end
if se_tok_eq off tlen se_t_rs
cb_wb_tx se_r_cgd_rs
ret
end
end
if eq mode 3
if se_tok_eq off tlen se_t_rb
cb_wb_tx se_r_bwe_rb
ret
end
if se_tok_eq off tlen se_t_ctl
cb_wb_tx se_r_bwe_ctl
ret
end
end
cb_wb_rb off tlen
end

fn se_line_is_note s ulong e ulong to bool
p = s
while lt p e bound 9223372036854775807
c = get cb_rb p
if or eq c 32 eq c 9
p = add p 1
else
break
end
end
if lt sub e p 5
ret false
end
for j ulong 5
if ne get cb_rb add p j get se_note j
ret false
end
end
ret true
end

note Append file with word-boundary identifier transformation (skipping note lines)
fn se_append_xform path view uchar * mode ulong to void
cb_pa_set path
if not cb_read_pa
se_die se_f_io
end
n = get cb_n 0
i = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_rb e 10
break
end
e = add e 1
end
has_nl = lt e n
if se_line_is_note i e
lenl = sub e i
if has_nl
lenl = add lenl 1
end
cb_wb_rb i lenl
else
p = i
while lt p e bound 9223372036854775807
c = get cb_rb p
if se_is_word c
q = p
while lt q e bound 9223372036854775807
if not se_is_word get cb_rb q
break
end
q = add q 1
end
se_emit_tok mode p sub q p
p = q
else
cb_wb_ch c
p = add p 1
end
end
if has_nl
cb_wb_ch 10
end
end
i = add e 1
end
end

fn se_app path view uchar * to void
cb_pa_set path
if not cb_append_pa_to_wb
se_die se_f_io
end
end

fn se_compose_all to void
cb_wb_clr
cb_wb_tx se_hdr
se_app se_s01
se_app se_s02
se_app se_s03
se_app se_s04
se_app se_s05
se_app se_s06
se_app se_s07
se_app se_s08
se_app se_s09
se_app se_s10
se_app se_s11
se_app se_s12
se_app se_s13
se_app se_s14
se_app se_s15
se_app se_s16
se_app se_s17
se_app se_s18
se_app se_s19
se_app se_s20
se_app se_s21
se_app se_s22
se_app se_s23
se_app se_s24
se_app se_s25
se_app se_s26
se_app se_s27
se_app se_s28
se_app se_s29
se_app se_s30
se_app se_s31
se_app se_s32
se_app se_s33
se_app se_s34
se_app se_s35
se_app se_s36
se_app se_s37
se_app se_s38
se_app se_s39
se_app se_s40
se_app se_s41
se_app se_s42
se_app se_s43
se_append_xform se_s44 1
se_append_xform se_s45 2
se_app se_s46
se_append_xform se_s47 3
se_app se_s48
se_app se_s49
cb_pa_clr
for i ulong get se_poml 0 bound 4096
cb_pa_ch get se_pom i
end
if not cb_append_pa_to_wb
se_die se_f_io
end
se_app se_s50
end

fn se_u16_le off ulong to ulong
b0 = ulong get cb_rb off
b1 = ulong get cb_rb add off 1
ret or b0 shl b1 8
end

fn se_u32_le off ulong to ulong
b0 = ulong get cb_rb off
b1 = ulong get cb_rb add off 1
b2 = ulong get cb_rb add off 2
b3 = ulong get cb_rb add off 3
ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn se_verify_pe to void
cb_pa_clr
for i ulong get se_outl 0 bound 4096
cb_pa_ch get se_out i
end
if not cb_read_pa
se_die se_f_pe
end
n = get cb_n 0
if lt n 512
se_die se_f_pe
end
if or ne get cb_rb 0 77 ne get cb_rb 1 90
se_die se_f_pe
end
pe = se_u32_le 60
if gt add pe 96 n
se_die se_f_pe
end
if ne get cb_rb pe 80
se_die se_f_pe
end
if ne get cb_rb add pe 1 69
se_die se_f_pe
end
if ne get cb_rb add pe 2 0
se_die se_f_pe
end
if ne get cb_rb add pe 3 0
se_die se_f_pe
end
mach = se_u16_le add pe 4
if ne mach 43620
se_die se_f_pe
end
opt = add pe 24
omagic = se_u16_le opt
if ne omagic 523
se_die se_f_pe
end
szimg = se_u32_le add opt 56
subsys = se_u16_le add opt 68
if ne subsys 10
se_die se_f_pe
end
if ge szimg 16777216
se_die se_f_pe
end
cb_sha_rb 0 n
cb_out se_pass1
r1 = write 1 se_out 0 get se_outl 0
cb_out se_pass2
r2 = write 1 se_plat 0 get se_platl 0
cb_out se_pass3
cb_wnum 1 n
cb_out se_pass4
cb_wnum 1 szimg
cb_out se_pass5
cb_wbuf_hex 1
cb_out cb_nl
end

fn se_is_gb10 to bool
if ne get se_platl 0 4
ret false
end
for i ulong 4
if ne get se_plat i get se_defplat i
ret false
end
end
ret true
end

fn se_out_basename_is_spark to bool
n = get se_outl 0
s = ulong 0
for i ulong n bound 4096
if eq get se_out i 47
s = add i 1
end
end
blen = sub n s
if ne blen len se_sparkefi
ret false
end
for i ulong blen bound 64
if ne get se_out add s i get se_sparkefi i
ret false
end
end
ret true
end

fn main to int
note OUT_EFI
ac = argcnt
if ge ac 2
if not cb_pa_arg 1
se_die se_f_io
end
for i ulong get cb_n 3 bound 4096
put se_out i get cb_pa i
end
put se_outl 0 get cb_n 3
else
for i ulong len se_defout bound 4096
put se_out i get se_defout i
end
put se_outl 0 len se_defout
end

note OMC
if cb_getenv se_env_omc
if gt get cb_n 4 0
for i ulong get cb_n 4 bound 4096
put se_omc i get cb_pb i
end
put se_omcl 0 get cb_n 4
end
end
if eq get se_omcl 0 0
for i ulong len se_defomc bound 4096
put se_omc i get se_defomc i
end
put se_omcl 0 len se_defomc
end

note PLAT
if cb_getenv se_env_plat
if and gt get cb_n 4 0 le get cb_n 4 255
for i ulong get cb_n 4 bound 256
put se_plat i get cb_pb i
end
put se_platl 0 get cb_n 4
end
end
if eq get se_platl 0 0
for i ulong len se_defplat bound 256
put se_plat i get se_defplat i
end
put se_platl 0 len se_defplat
end

note Build default PLAT_OM path
cb_pa_set se_platpfx
for i ulong get se_platl 0 bound 256
cb_pa_ch get se_plat i
end
cb_pa_tx se_omext
for i ulong get cb_n 3 bound 4096
put se_pom i get cb_pa i
end
put se_poml 0 get cb_n 3

note Safety guard 1: PLAT != gb10 cannot write SPARK.EFI
is_prod = se_is_gb10
if and not is_prod se_out_basename_is_spark
se_die se_f_testout
end

note Safety guard 2: PLAT_OM_OVERRIDE
if cb_getenv se_env_ovr
if gt get cb_n 4 0
if is_prod
se_die se_f_ovrgb10
end
for i ulong get cb_n 4 bound 4096
put se_pom i get cb_pb i
end
put se_poml 0 get cb_n 4
end
end

note Check PLAT_OM exists
cb_pa_clr
for i ulong get se_poml 0 bound 4096
cb_pa_ch get se_pom i
end
fdp = fopen cb_pa 0 get cb_n 3 524288 0
if lt fdp 0
se_die se_f_badplat
end
z0 = fclose int fdp

note Ensure parent directory of OUT exists
last_sl = ulong 0
has_sl = false
for i ulong get se_outl 0 bound 4096
if eq get se_out i 47
last_sl = i
has_sl = true
end
end
if and has_sl gt last_sl 0
cb_pa_clr
for i ulong last_sl bound 4096
cb_pa_ch get se_out i
end
if not cb_mkdir_p_pa
se_die se_f_io
end
end

se_compose_all

note Write temporary composed source beside OUT
cb_pa_clr
for i ulong get se_outl 0 bound 4096
cb_pa_ch get se_out i
end
cb_pa_tx se_tmpfile
if not cb_write_wb_pa 420
se_die se_f_io
end

note Compile with OMC
for i ulong get se_omcl 0 bound 4096
put cb_pc i get se_omc i
end
cb_pb_clr
for i ulong get se_outl 0 bound 4096
cb_pb_ch get se_out i
end
rc = cb_run_omc get se_omcl 0 420 -1
z1 = unlink cb_pa 0 get cb_n 3
if ne rc 0
se_die se_f_omc
end

se_verify_pe
ret 0
end

global gc_omc uchar 4096
global gc_omcl ulong 1
global gc_tmp uchar 4096
global gc_tmpl ulong 1
global gc_out uchar 4096
global gc_outl ulong 1
global gc_kbuf uchar 64
global gc_klen ulong 1
global gc_ebuf uchar 16
global gc_elen ulong 1
global gc_fail ulong 1
global gc_list uchar *
global gc_listn ulong 1
global gc_tok uchar 256

fn gc_init_omc to void
if cb_getenv gc_env_omc
if gt get cb_n 4 0
for i ulong get cb_n 4 bound 4096
put gc_omc i get cb_pb i
end
put gc_omcl 0 get cb_n 4
ret
end
end
for i ulong len gc_defomc bound 4096
put gc_omc i get gc_defomc i
end
put gc_omcl 0 len gc_defomc
end

fn gc_init_tmp to void
cb_pa_set gc_tdir_pre
x = ulong getpid
k = ulong 32
for j ulong 21
k = sub k 1
put cb_numbuf k uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for j ulong sub 32 k bound 32
cb_pa_ch get cb_numbuf add k j
end
for i ulong get cb_n 3 bound 4096
put gc_tmp i get cb_pa i
end
put gc_tmpl 0 get cb_n 3
if not cb_mkdir_p_pa
exit 1
end
end

fn gc_tp suf view uchar * to void
cb_pa_clr
for i ulong get gc_tmpl 0 bound 4096
cb_pa_ch get gc_tmp i
end
cb_pa_tx suf
end

fn gc_tpb suf view uchar * to void
cb_pb_clr
for i ulong get gc_tmpl 0 bound 4096
cb_pb_ch get gc_tmp i
end
cb_pb_tx suf
end

fn gc_op suf view uchar * to void
cb_pb_clr
for i ulong get gc_outl 0 bound 4096
cb_pb_ch get gc_out i
end
cb_pb_tx suf
end

fn gc_compile src view uchar * dst_suf view uchar * to bool
for i ulong get gc_omcl 0 bound 4096
put cb_pc i get gc_omc i
end
cb_pa_set src
gc_tpb dst_suf
ret eq cb_run_omc get gc_omcl 0 493 -1 0
end

fn gc_compile_wb_to_out dst_suf view uchar * to bool
gc_tp gc_p_src
if not cb_write_wb_pa 420
ret false
end
for i ulong get gc_omcl 0 bound 4096
put cb_pc i get gc_omc i
end
gc_op dst_suf
ret eq cb_run_omc get gc_omcl 0 493 -1 0
end

fn gc_compile_wb_to_tmp dst_suf view uchar * to bool
gc_tp gc_p_src
if not cb_write_wb_pa 420
ret false
end
for i ulong get gc_omcl 0 bound 4096
put cb_pc i get gc_omc i
end
gc_tpb dst_suf
ret eq cb_run_omc get gc_omcl 0 493 -1 0
end

fn gc_run_to_file out_suf view uchar * quiet_err bool to ulong
gc_tp out_suf
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
if lt fo 0
ret 512
end
fe = int -1
if quiet_err
fe = int fopen cb_devnull 0 len cb_devnull 524289 0
end
ret cb_spawn_fds -1 int fo fe false
end

fn gc_run_quiet quiet_out bool quiet_err bool to ulong
fo = int -1
fe = int -1
if quiet_out
fo = int fopen cb_devnull 0 len cb_devnull 524289 0
end
if quiet_err
fe = int fopen cb_devnull 0 len cb_devnull 524289 0
end
ret cb_spawn_fds -1 fo fe false
end

note ---- SPIR-V helpers ----
fn gc_spv_compile_tools to bool
if not gc_compile gc_spv_emit gc_p_emit
ret false
end
if not gc_compile gc_spv_val gc_p_val
ret false
end
if not gc_compile gc_spv_run gc_p_run
ret false
end
ret gc_compile gc_spv_conf gc_p_conf
end

fn gc_spv_run_one k view uchar * e view uchar * to int
if not gc_spv_compile_tools
cb_out gc_m_fail
cb_out k
cb_out cb_nl
ret 1
end
nin = ulong 2
nwork_is_64k = false
nout_is_64k = false
if eq len k 6
if and eq get k 0 102 eq get k 1 115
nin = 1
nwork_is_64k = true
nout_is_64k = true
end
end
if eq len k 7
if and eq get k 0 114 eq get k 1 109
nwork_is_64k = true
end
end
note emit
cb_av_clr
gc_tp gc_p_emit
cb_av_push_pa
cb_av_push_tx k
cb_av_push_tx e
if ne gc_run_to_file gc_p_spv false 0
ret 1
end
note val
cb_av_clr
gc_tp gc_p_val
cb_av_push_pa
cb_av_push_tx gc_tenv
if eq get e 0 118
cb_av_push_tx gc_t_vk
else
cb_av_push_tx gc_t_ocl
end
gc_tp gc_p_spv
cb_av_push_pa
if ne gc_run_quiet true false 0
ret 1
end
note conform in
cb_av_clr
gc_tp gc_p_conf
cb_av_push_pa
cb_av_push_tx gc_in
cb_av_push_tx k
gc_tp gc_p_in0
cb_av_push_pa
if eq nin 2
gc_tp gc_p_in1
cb_av_push_pa
end
if ne gc_run_quiet true false 0
ret 1
end
note run
cb_av_clr
gc_tp gc_p_run
cb_av_push_pa
gc_tp gc_p_spv
cb_av_push_pa
if nwork_is_64k
cb_av_push_tx gc_n64k
else
cb_av_push_tx gc_n1m
end
if nout_is_64k
cb_av_push_tx gc_n64k
else
cb_av_push_tx gc_n1m
end
gc_tp gc_p_out
cb_av_push_pa
gc_tp gc_p_in0
cb_av_push_pa
if eq nin 2
gc_tp gc_p_in1
cb_av_push_pa
end
if ne gc_run_quiet true false 0
ret 1
end
note conform check
cb_av_clr
gc_tp gc_p_conf
cb_av_push_pa
cb_av_push_tx gc_chk
cb_av_push_tx k
gc_tp gc_p_out
cb_av_push_pa
if ne gc_run_to_file gc_p_cout false 0
ret 1
end
note Extract sha256= from cout.txt
gc_tp gc_p_cout
if not cb_read_pa
ret 1
end
n = get cb_n 0
found = false
pos = ulong 0
if ge n 71
for i ulong sub n 70 bound 4096
if cb_rb_match_at i gc_sha_eq
pos = add i 7
found = true
break
end
end
end
if not found
ret 1
end
cb_out gc_m_pass
cb_out k
cb_out gc_m_om
cb_out e
cb_out gc_m_n
if nout_is_64k
cb_out gc_n64k
else
cb_out gc_n1m
end
cb_out gc_m_w0
r = write 1 cb_rb pos 64
cb_out cb_nl
ret 0
end

fn gc_spv_chk_ke k view uchar * e view uchar * to void
cb_av_clr
gc_tp gc_p_emit
cb_av_push_pa
cb_av_push_tx k
cb_av_push_tx e
if ne gc_run_to_file gc_p_spv false 0
put gc_fail 0 1
ret
end
cb_av_clr
gc_tp gc_p_val
cb_av_push_pa
cb_av_push_tx gc_tenv
if eq get e 0 118
cb_av_push_tx gc_t_vk
else
cb_av_push_tx gc_t_ocl
end
gc_tp gc_p_spv
cb_av_push_pa
if ne gc_run_quiet true false 0
put gc_fail 0 1
ret
end
note mutant must differ
cb_av_clr
gc_tp gc_p_emit
cb_av_push_pa
cb_av_push_tx k
cb_av_push_tx e
cb_av_push_tx gc_mut
if ne gc_run_to_file gc_p_mspv false 0
put gc_fail 0 1
ret
end
gc_tp gc_p_spv
gc_tpb gc_p_mspv
if cb_cmp_pa_pb
put gc_fail 0 1
ret
end
note save gemm16 cl/vk + mutants & rmsnorm vk mutant for controls
if eq len k 6
if eq get k 0 103
gc_tp gc_p_spv
if eq get e 0 99
gc_tpb gc_p_gcl
z0 = cb_copy_pa_to_pb 420
else
gc_tpb gc_p_gvk
z1 = cb_copy_pa_to_pb 420
gc_tp gc_p_mspv
gc_tpb gc_p_gmut
z2 = cb_copy_pa_to_pb 420
end
end
end
if eq len k 7
if and eq get k 0 114 eq get e 0 118
gc_tp gc_p_mspv
gc_tpb gc_p_rmut
z3 = cb_copy_pa_to_pb 420
end
end
note run + conform parity
if ne gc_spv_run_one k e 0
put gc_fail 0 1
end
end

fn gc_spv_check_all to int
put gc_fail 0 0
if not gc_spv_compile_tools
cb_out gc_spv_bad
ret 1
end
gc_spv_chk_ke gc_k_vadd gc_e_cl
gc_spv_chk_ke gc_k_vadd gc_e_vk
gc_spv_chk_ke gc_k_vmul gc_e_cl
gc_spv_chk_ke gc_k_vmul gc_e_vk
gc_spv_chk_ke gc_k_vsub gc_e_cl
gc_spv_chk_ke gc_k_vsub gc_e_vk
gc_spv_chk_ke gc_k_vmax gc_e_cl
gc_spv_chk_ke gc_k_vmax gc_e_vk
gc_spv_chk_ke gc_k_fsum gc_e_cl
gc_spv_chk_ke gc_k_fsum gc_e_vk
gc_spv_chk_ke gc_k_rms gc_e_cl
gc_spv_chk_ke gc_k_rms gc_e_vk
gc_spv_chk_ke gc_k_gemm gc_e_cl
gc_spv_chk_ke gc_k_gemm gc_e_vk

note Negative control 1: val rejects cl as vulkan1.1
cb_av_clr
gc_tp gc_p_val
cb_av_push_pa
cb_av_push_tx gc_tenv
cb_av_push_tx gc_t_vk
gc_tp gc_p_gcl
cb_av_push_pa
if eq gc_run_quiet true true 0
put gc_fail 0 1
end
note Negative control 2: val rejects vk as opencl2.2
cb_av_clr
gc_tp gc_p_val
cb_av_push_pa
cb_av_push_tx gc_tenv
cb_av_push_tx gc_t_ocl
gc_tp gc_p_gvk
cb_av_push_pa
if eq gc_run_quiet true true 0
put gc_fail 0 1
end
note Negative control 3: val rejects bad magic
cb_wb_clr
cb_wb_tx gc_badspv
gc_tp gc_p_badspv
z0 = cb_write_wb_pa 420
cb_av_clr
gc_tp gc_p_val
cb_av_push_pa
gc_tp gc_p_badspv
cb_av_push_pa
if eq gc_run_quiet true true 0
put gc_fail 0 1
end
note Negative control 4: gemm16 mutant rejected by conform
cb_av_clr
gc_tp gc_p_conf

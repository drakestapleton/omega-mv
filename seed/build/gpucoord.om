fn gc_skip_sp p ulong e ulong to ulong
x = p
while lt x e bound 4096
if eq get gc_list x 32
x = add x 1
else
break
end
end
ret x
end

fn gc_scan_tok p ulong e ulong to ulong
x = p
while lt x e bound 4096
if eq get gc_list x 32
break
end
x = add x 1
end
ret x
end

fn gc_pa_from_list s ulong cnt ulong to void
cb_pa_clr
for j ulong cnt bound 256
cb_pa_ch get gc_list add s j
end
end

fn gc_push_cubin_pa ns ulong nl ulong to void
cb_pa_clr
for j ulong get gc_outl 0 bound 4096
cb_pa_ch get gc_out j
end
cb_pa_ch 47
for j ulong nl bound 256
cb_pa_ch get gc_list add ns j
end
cb_pa_tx gc_cubin
cb_av_push_pa
end

fn gc_push_abi_toks p ulong e ulong to void
cur = gc_skip_sp p e
while lt cur e bound 4096
q = gc_scan_tok cur e
gc_pa_from_list cur sub q cur
cb_av_push_pa
cur = gc_skip_sp q e
end
end

fn gc_run_kline s ulong e ulong emit_suf view uchar * has_regs bool to bool
p = gc_skip_sp s e
if ge p e
ret true
end
q = gc_scan_tok p e
ms = p
ml = sub q p
p = gc_skip_sp q e
q = gc_scan_tok p e
ns = p
nl = sub q p
p = gc_skip_sp q e
rs = ulong 0
rl = ulong 0
if has_regs
q = gc_scan_tok p e
rs = p
rl = sub q p
p = gc_skip_sp q e
q = gc_scan_tok p e
p = gc_skip_sp q e
end
note Step A: emit mode > tmp/k.bin
cb_av_clr
gc_tp emit_suf
cb_av_push_pa
gc_pa_from_list ms ml
cb_av_push_pa
if ne gc_run_to_file gc_p_bin false 0
ret false
end
note Step B: kpack 121-tk name tmp/k.bin out/name.cubin regs 0 abi...
cb_av_clr
gc_tp gc_p_kpack
cb_av_push_pa
cb_av_push_tx gc_kpack_t
gc_pa_from_list ns nl
cb_av_push_pa
gc_tp gc_p_bin
cb_av_push_pa
gc_push_cubin_pa ns nl
if has_regs
gc_pa_from_list rs rl
cb_av_push_pa
else
cb_av_push_tx gc_s64
end
cb_av_push_tx gc_s0
gc_push_abi_toks p e
ret eq gc_run_quiet false false 0
end

note Process kernels.list (has_regs=false) or kernels_fast.list (has_regs=true)
note Each line: mode name [regs shared] abi...
fn gc_run_klist list_path view uchar * emit_suf view uchar * has_regs bool to bool
cb_pa_set list_path
if not cb_read_pa
ret false
end
n = get cb_n 0
ze = enlarge gc_list n
if ne ze 0
ret false
end
for i ulong n bound 9223372036854775807
put gc_list i get cb_rb i
end
put gc_listn 0 n
i = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get gc_list e 10
break
end
e = add e 1
end
if not gc_run_kline i e emit_suf has_regs
ret false
end
i = add e 1
end
ret true
end

fn gc_dsv_mma_one ns ulong nl ulong to bool
if lt nl 4
ret true
end
if ne get cb_dent add ns sub nl 3 46
ret true
end
if ne get cb_dent add ns sub nl 2 111
ret true
end
if ne get cb_dent add ns sub nl 1 109
ret true
end
stem = sub nl 3
for j ulong get gc_omcl 0 bound 4096
put cb_pc j get gc_omc j
end
cb_pa_set gc_d_mmadir
cb_pa_ch 47
for j ulong nl bound 256
cb_pa_ch get cb_dent add ns j
end
gc_tpb gc_p_look
if ne cb_run_omc get gc_omcl 0 493 -1 0
ret false
end
cb_av_clr
gc_tp gc_p_look
cb_av_push_pa
if ne gc_run_to_file gc_p_bin false 0
ret false
end
cb_av_clr
gc_tp gc_p_kpack
cb_av_push_pa
cb_av_push_tx gc_kpack_t
cb_pa_clr
for j ulong stem bound 256
cb_pa_ch get cb_dent add ns j
end
cb_av_push_pa
gc_tp gc_p_bin
cb_av_push_pa
cb_pa_clr
for j ulong get gc_outl 0 bound 4096
cb_pa_ch get gc_out j
end
cb_pa_ch 47
for j ulong stem bound 256
cb_pa_ch get cb_dent add ns j
end
cb_pa_tx gc_cubin
cb_av_push_pa
cb_av_push_tx gc_s64
cb_av_push_tx gc_s0
cb_av_push_tx gc_p8
cb_av_push_tx gc_p8
cb_av_push_tx gc_p8
cb_av_push_tx gc_p8
cb_av_push_tx gc_p8
cb_av_push_tx gc_4
ret eq gc_run_quiet false false 0
end

fn gc_dent_len ns ulong lim ulong to ulong
nl = ulong 0
while lt add ns nl lim bound 256
if eq get cb_dent add ns nl 0
break
end
nl = add nl 1
end
ret nl
end

fn gc_dsv_mma_all to bool
dfd = fopen gc_d_mmadir 0 len gc_d_mmadir 540672 0
if lt dfd 0
ret true
end
while true bound 65536
nr = getdnts int dfd cb_dent 0 32768
if le nr 0
break
end
pos = ulong 0
while lt pos ulong nr bound 32768
rlen = or ulong get cb_dent add pos 16 shl ulong get cb_dent add pos 17 8
if eq rlen 0
break
end
ns = add pos 19
nl = gc_dent_len ns add pos rlen
if not gc_dsv_mma_one ns nl
z1 = fclose int dfd
ret false
end
pos = add pos rlen
end
end
z4 = fclose int dfd
ret true
end

note Pure OM-2 line-prefix matcher in cb_rb[off..end)
fn gc_rb_starts off ulong lim ulong pat view uchar * to bool
pl = len pat
if gt add off pl lim
ret false
end
for k ulong pl bound 64
if ne get cb_rb add off k get pat k
ret false
end
end
ret true
end

fn gc_rb_line_eq off ulong llen ulong pat view uchar * to bool
if ne llen len pat
ret false
end
for k ulong llen bound 64
if ne get cb_rb add off k get pat k
ret false
end
end
ret true
end

note Append only `layout ... end` blocks from file path `t` into cb_wb
fn gc_app_layouts t view uchar * to bool
cb_pa_set t
if not cb_read_pa
ret false
end
n = get cb_n 0
pos = ulong 0
in_lay = false
while lt pos n
lend = pos
while lt lend n
if eq get cb_rb lend 10
break
end
lend = add lend 1
end
llen = sub lend pos
if and not in_lay gc_rb_starts pos lend gc_m_lay
in_lay = true
end
if in_lay
cb_wb_rb pos llen
cb_wb_ch 10
if gc_rb_line_eq pos llen gc_m_end
in_lay = false
end
end
if lt lend n
pos = add lend 1
else
pos = lend
end
end
ret true
end

note Append file path `t` excluding `layout ... end` and `om2` lines, rewriting `export fn ` -> `fn `
fn gc_app_om2_no_layout t view uchar * to bool
cb_pa_set t
if not cb_read_pa
ret false
end
n = get cb_n 0
pos = ulong 0
in_lay = false
while lt pos n
lend = pos
while lt lend n
if eq get cb_rb lend 10
break
end
lend = add lend 1
end
llen = sub lend pos
if and not in_lay gc_rb_starts pos lend gc_m_lay
in_lay = true
end
if in_lay
if gc_rb_line_eq pos llen gc_m_end
in_lay = false
end
else
if not gc_rb_line_eq pos llen gc_m_om2
if gc_rb_starts pos lend gc_m_exp
cb_wb_tx gc_m_fn
cb_wb_rb add pos 10 sub llen 10
cb_wb_ch 10
else
cb_wb_rb pos llen
cb_wb_ch 10
end
end
end
if lt lend n
pos = add lend 1
else
pos = lend
end
end
ret true
end

note Append file path `t` up to (excluding) the line `fn main to int`
fn gc_app_before_main t view uchar * to bool
cb_pa_set t
if not cb_read_pa
ret false
end
n = get cb_n 0
pos = ulong 0
while lt pos n
lend = pos
while lt lend n
if eq get cb_rb lend 10
break
end
lend = add lend 1
end
llen = sub lend pos
if gc_rb_line_eq pos llen gc_m_main
break
end
cb_wb_rb pos llen
cb_wb_ch 10
if lt lend n
pos = add lend 1
else
pos = lend
end
end
ret true
end


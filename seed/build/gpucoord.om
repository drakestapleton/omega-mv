fn gc_cleanup to void
cb_pa_clr
for i ulong get gc_tmpl 0 bound 4096
cb_pa_ch get gc_tmp i
end
cb_rm_flat_pa
end

fn main to int
ac = argcnt
if lt ac 2
cb_err gc_usage
ret 2
end
gc_init_omc
gc_init_tmp
rc = int 2
if not cb_pa_arg 1
cb_err gc_usage
gc_cleanup
ret 2
end
if cb_pa_eq gc_c_srun
if ne ac 4
cb_err gc_usage
gc_cleanup
ret 2
end
if not cb_pa_arg 2
gc_cleanup
ret 2
end
if not cb_pb_arg 3
gc_cleanup
ret 2
end
if cb_pa_eq gc_k_vadd
if and eq get cb_n 4 2 eq get cb_pb 0 99
rc = gc_spv_run_one gc_k_vadd gc_e_cl
else
if and eq get cb_n 4 2 eq get cb_pb 0 118
rc = gc_spv_run_one gc_k_vadd gc_e_vk
end
end
gc_cleanup
ret rc
end
if cb_pa_eq gc_k_fsum
if and eq get cb_n 4 2 eq get cb_pb 0 99
rc = gc_spv_run_one gc_k_fsum gc_e_cl
else
if and eq get cb_n 4 2 eq get cb_pb 0 118
rc = gc_spv_run_one gc_k_fsum gc_e_vk
end
end
gc_cleanup
ret rc
end
if cb_pa_eq gc_k_gemm
if and eq get cb_n 4 2 eq get cb_pb 0 99
rc = gc_spv_run_one gc_k_gemm gc_e_cl
else
if and eq get cb_n 4 2 eq get cb_pb 0 118
rc = gc_spv_run_one gc_k_gemm gc_e_vk
end
end
gc_cleanup
ret rc
end
if cb_pa_eq gc_k_rms
if and eq get cb_n 4 2 eq get cb_pb 0 99
rc = gc_spv_run_one gc_k_rms gc_e_cl
else
if and eq get cb_n 4 2 eq get cb_pb 0 118
rc = gc_spv_run_one gc_k_rms gc_e_vk
end
end
gc_cleanup
ret rc
end
cb_err gc_usage
gc_cleanup
ret 2
end
if cb_pa_eq gc_c_schk
rc = gc_spv_check_all
gc_cleanup
ret rc
end
if cb_pa_eq gc_c_xe
rc = gc_intel_gate
gc_cleanup
ret rc
end
if or cb_pa_eq gc_c_spec or cb_pa_eq gc_c_dsv or cb_pa_eq gc_c_ink cb_pa_eq gc_c_q36
if ne ac 3
cb_err gc_usage
gc_cleanup
ret 2
end
mode = ulong 0
if cb_pa_eq gc_c_spec
mode = 1
else
if cb_pa_eq gc_c_dsv
mode = 2
else
if cb_pa_eq gc_c_ink
mode = 3
else
mode = 4
end
end
end
if not cb_pa_arg 2
gc_cleanup
ret 2
end
for i ulong get cb_n 3 bound 4096
put gc_out i get cb_pa i
end
put gc_outl 0 get cb_n 3
if eq mode 1
rc = gc_build_spec
else
if eq mode 2
rc = gc_build_dsv41
else
if eq mode 3
rc = gc_build_inkling2
else
rc = gc_build_q36
end
end
end
gc_cleanup
ret rc
end
cb_err gc_usage
gc_cleanup
ret 2
end

note SPDX-License-Identifier: Apache-2.0
note seed/build/tlsbuild.om: Pure seeded-Omega TLS 1.3 Builder & FIPS Integrity Coordinator.
note Replaces om/tls/build.sh completely. Zero shell.
note Build: cat seed/build/common.om seed/build/tlsbuild.om | seed/out/omc > build/om-tlsbuild
note Usage:
note   om-tlsbuild OMC PROGRAM.om OUT
note   om-tlsbuild -p OMC BIN   (integrity stamp only)

text tb_usage "usage: om-tlsbuild OMC PROGRAM.om OUT | om-tlsbuild -p OMC BIN\n"
text tb_fp "-p"
text tb_om2 "om2\n"
text tb_dir "om/tls/"
text tb_env_dir "OMTLS_DIR"
text tb_env_run "OMTLS_RUN"
text tb_u01 "sha2.om"
text tb_u02 "hkdf.om"
text tb_u03 "drbg.om"
text tb_u04 "x25519.om"
text tb_u05 "sha3.om"
text tb_u06 "mlkem.om"
text tb_u07 "chacha.om"
text tb_u08 "aesgcm.om"
text tb_u09 "ec.om"
text tb_u10 "ecdh.om"
text tb_u11 "rsa.om"
text tb_u12 "x509.om"
text tb_u13 "rev.om"
text tb_u14 "fips.om"
text tb_u15 "tls.om"
text tb_itmain "fn main to int\nret fips_itool\nend\n"
text tb_sunit ".unit.om"
text tb_stmp ".tmp"
text tb_sitom ".itool.om"
text tb_sit ".itool"
text tb_eio "tlsbuild: I/O error\n"
text tb_eint "tlsbuild: integrity step failed (exit "
text tb_eend ")\n"

global tb_omc uchar 4096
global tb_omcl ulong 1
global tb_arg2 uchar 4096
global tb_arg2l ulong 1
global tb_out uchar 4096
global tb_outl ulong 1
global tb_dirb uchar 4096
global tb_dirl ulong 1
global tb_run uchar 4096
global tb_runl ulong 1

fn tb_init_env to void
if cb_getenv tb_env_dir
n = get cb_n 4
if gt n 0
for i ulong n bound 4095
put tb_dirb i get cb_pb i
end
if ne get tb_dirb sub n 1 47
put tb_dirb n 47
n = add n 1
end
put tb_dirl 0 n
end
end
if eq get tb_dirl 0 0
m = len tb_dir
for i ulong m bound 4096
put tb_dirb i get tb_dir i
end
put tb_dirl 0 m
end
put tb_runl 0 0
if cb_getenv tb_env_run
rn = get cb_n 4
if gt rn 0
for i ulong rn bound 4096
put tb_run i get cb_pb i
end
put tb_runl 0 rn
end
end
end

fn tb_app_unit u view uchar * to bool
cb_pa_clr
for i ulong get tb_dirl 0 bound 4096
cb_pa_ch get tb_dirb i
end
cb_pa_tx u
ret cb_append_pa_to_wb
end

fn tb_append_all_units to bool
if not tb_app_unit tb_u01
ret false
end
if not tb_app_unit tb_u02
ret false
end
if not tb_app_unit tb_u03
ret false
end
if not tb_app_unit tb_u04
ret false
end
if not tb_app_unit tb_u05
ret false
end
if not tb_app_unit tb_u06
ret false
end
if not tb_app_unit tb_u07
ret false
end
if not tb_app_unit tb_u08
ret false
end
if not tb_app_unit tb_u09
ret false
end
if not tb_app_unit tb_u10
ret false
end
if not tb_app_unit tb_u11
ret false
end
if not tb_app_unit tb_u12
ret false
end
if not tb_app_unit tb_u13
ret false
end
if not tb_app_unit tb_u14
ret false
end
ret tb_app_unit tb_u15
end

fn tb_set_pa_out suf view uchar * to void
cb_pa_clr
n = get tb_outl 0
for i ulong n bound 4096
cb_pa_ch get tb_out i
end
cb_pa_tx suf
end

fn tb_set_pb_out suf view uchar * to void
cb_pb_clr
n = get tb_outl 0
for i ulong n bound 4096
cb_pb_ch get tb_out i
end
cb_pb_tx suf
end

fn tb_set_pc_omc to ulong
n = get tb_omcl 0
for i ulong n bound 4096
put cb_pc i get tb_omc i
end
ret n
end

fn tb_integ bin_is_tmp bool to ulong
cb_wb_clr
cb_wb_tx tb_om2
if not tb_append_all_units
cb_err tb_eio
ret 3
end
cb_wb_tx tb_itmain
tb_set_pa_out tb_sitom
if not cb_write_wb_pa 420
cb_err tb_eio
ret 3
end
omcl = tb_set_pc_omc
tb_set_pa_out tb_sitom
tb_set_pb_out tb_sit
rc = cb_run_omc omcl 493 -1
if ne rc 0
tb_set_pa_out tb_sitom
z0 = unlink cb_pa 0 get cb_n 3
tb_set_pa_out tb_sit
z1 = unlink cb_pa 0 get cb_n 3
ret rc
end
cb_av_clr
if gt get tb_runl 0 0
cb_pa_clr
for i ulong get tb_runl 0 bound 4096
cb_pa_ch get tb_run i
end
cb_av_push_pa
end
tb_set_pa_out tb_sit
cb_av_push_pa
if bin_is_tmp
tb_set_pa_out tb_stmp
else
cb_pa_clr
for i ulong get tb_outl 0 bound 4096
cb_pa_ch get tb_out i
end
end
cb_av_push_pa
rc = cb_spawn_fds -1 -1 -1 false
tb_set_pa_out tb_sitom
z2 = unlink cb_pa 0 get cb_n 3
tb_set_pa_out tb_sit
z3 = unlink cb_pa 0 get cb_n 3
if ne rc 0
cb_err tb_eint
cb_wnum 2 rc
cb_err tb_eend
end
ret rc
end

fn main to int
tb_init_env
ac = argcnt
if ne ac 4
cb_err tb_usage
ret 2
end
if not cb_pa_arg 1
cb_err tb_usage
ret 2
end
if cb_pa_eq tb_fp
note -p OMC BIN
if not cb_pa_arg 2
cb_err tb_usage
ret 2
end
for i ulong get cb_n 3 bound 4096
put tb_omc i get cb_pa i
end
put tb_omcl 0 get cb_n 3
if not cb_pa_arg 3
cb_err tb_usage
ret 2
end
for i ulong get cb_n 3 bound 4096
put tb_out i get cb_pa i
end
put tb_outl 0 get cb_n 3
ret int tb_integ false
end
note OMC PROGRAM.om OUT
for i ulong get cb_n 3 bound 4096
put tb_omc i get cb_pa i
end
put tb_omcl 0 get cb_n 3
if not cb_pa_arg 2
cb_err tb_usage
ret 2
end
for i ulong get cb_n 3 bound 4096
put tb_arg2 i get cb_pa i
end
put tb_arg2l 0 get cb_n 3
if not cb_pa_arg 3
cb_err tb_usage
ret 2
end
for i ulong get cb_n 3 bound 4096
put tb_out i get cb_pa i
end
put tb_outl 0 get cb_n 3

cb_wb_clr
cb_wb_tx tb_om2
if not tb_append_all_units
cb_err tb_eio
ret 3
end
cb_pa_clr
for i ulong get tb_arg2l 0 bound 4096
cb_pa_ch get tb_arg2 i
end
if not cb_append_pa_to_wb
cb_err tb_eio
ret 3
end
tb_set_pa_out tb_sunit
if not cb_write_wb_pa 420
cb_err tb_eio
ret 3
end
cb_pa_clr
for i ulong get tb_outl 0 bound 4096
cb_pa_ch get tb_out i
end
z0 = unlink cb_pa 0 get cb_n 3
omcl = tb_set_pc_omc
tb_set_pa_out tb_sunit
tb_set_pb_out tb_stmp
rc = cb_run_omc omcl 493 -1
if ne rc 0
tb_set_pa_out tb_stmp
z1 = unlink cb_pa 0 get cb_n 3
ret int rc
end
irc = tb_integ true
if ne irc 0
tb_set_pa_out tb_stmp
z2 = unlink cb_pa 0 get cb_n 3
ret int irc
end
tb_set_pa_out tb_stmp
cb_pb_clr
for i ulong get tb_outl 0 bound 4096
cb_pb_ch get tb_out i
end
if not cb_rename_pa_pb
cb_err tb_eio
ret 3
end
ret 0
end

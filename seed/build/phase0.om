note SPDX-License-Identifier: Apache-2.0
note seed/build/phase0.om: Pure seeded-Omega Helix Phase 0 Baseline & Determinism Floor Exit Gate.
note One offline command (zero C, zero Rust, zero shell, zero Python on the compiler-verification path):
note   1. Strict self-regeneration: c(sA, A) == A twice in a row with matching SHA-256 == seed/out/omc.sha256
note   2. Full 4-rung birth (om-birth --verify) & pure-OM-2 build-closure gate (om-build-gate)
note   3. 78-theorem uor-gpu Lean 4 proof check (zero sorryAx, standard axioms only) + pure-OM-2 uor-gpu-gate
note   4. Pure-OM-2 builds & host gates for q36, inkling2, and dsv41
note   5. Live GB10 silicon checks (q36-serve, inkling2-serve, inkling2-multistream, dsv41-decode) with nvrm_errors_delta = 0
note Build: cat seed/build/common.om seed/build/phase0.om | seed/out/omc > build/om-phase0
note Usage: om-phase0 [--host-only] [SCRATCH_DIR]

text p0_usage "usage: om-phase0 [--host-only] [SCRATCH_DIR]\n"
text p0_fhost "--host-only"
text p0_defscr "build/helix-phase0"
text p0_omc "seed/out/omc"
text p0_omcsha "seed/out/omc.sha256"
text p0_omcsrc "seed/omc/omc.om"
text p0_com "seed/build/common.om"
text p0_s_bir "seed/build/birth.om"
text p0_s_gat "seed/build/gate.om"
text p0_s_gpu "seed/build/gpucoord.om"
text p0_lean_f "protocol/uor-gpu/proofs/UorGpuWorld.lean"
text p0_lean_pin "4242bcf69741fc3064f67083694e0e09f969eb4cc9ed4369d96154dc02a7238a"
text p0_bad_s1 "uses 'sorry'"
text p0_bad_s4 "[sorryAx"
text p0_bad_s5 " sorryAx"
text p0_bad_s2 "ofReduceBool"
text p0_bad_s3 "trustCompiler"
text p0_env_lean "LEAN"
text p0_env_home "HOME"
text p0_elan_suf "/.elan/bin/lean"
text p0_usr_lean "/usr/bin/lean"
text p0_sens_suf "/yardsticks/sensors"
text p0_csv_ext ".csv"
text p0_fver "--verify"
text p0_fsel "--self-test"
text p0_bq36 "build-q36"
text p0_bink "build-inkling2"
text p0_bdsv "build-dsv41"
text p0_om2 "si/directives/om2.om"
text p0_u_sha2 "om/tls/sha2.om"
text p0_u_b3 "protocol/uor-gpu/b3_uor.om"
text p0_u_s512 "protocol/omnet/om/sha512/sha512.om"
text p0_u_ed "protocol/omnet/om/ed25519/ed25519.om"
text p0_u_can "protocol/uor-gpu/canonical.om"
text p0_u_pvm "protocol/uor-gpu/payload_vm.om"
text p0_u_ver "protocol/uor-gpu/verify.om"
text p0_u_gat "protocol/uor-gpu/gate.om"
text p0_u_em "protocol/uor-gpu/emit_kernels.om"
text p0_u_eds "protocol/uor-gpu/ed_sign.om"
text p0_u_ug "protocol/uor-gpu/uor-gpu-gate.om"
text p0_dsv_t "/tmp/dsv41-m1-gate1-f7d3e9ee1/out/tensors.bin"
text p0_dsv_s "/tmp/dsv41-m1-sidecars"
text p0_dsv_s1 "/tmp/dsv41-m1-sidecars/engram1.bin"
text p0_dsv_map "om/gpu/dsv41/decoder/engram-token-map.u32"
text p0_dsv_msuf "/models/deepseek-v4.1-flash-314113f8"
text p0_dsv_l0 "layer0"
text p0_dsv_tok "1234"
text p0_p_r1 "/omc_regen1"
text p0_p_r2 "/omc_regen2"
text p0_p_src "/unit.om"
text p0_p_bir "/om-birth"
text p0_p_bw "/birth-w"
text p0_p_gat "/om-build-gate"
text p0_p_gw "/gate-w"
text p0_p_gpu "/om-gpucoord"
text p0_p_leano "/lean.out"
text p0_p_ug "/uor-gpu-gate"
text p0_p_q36 "/q36"
text p0_p_ink "/inkling2"
text p0_p_dsv "/dsv41"
text p0_p_q36s "/q36/q36-serve"
text p0_p_inks "/inkling2/inkling2-serve"
text p0_p_inkm "/inkling2/inkling2-multistream"
text p0_p_inka "/inkling2/check-arboris"
text p0_p_inkc "/inkling2/check-ms-server"
text p0_p_dsvs "/dsv41/check-swa-replay"
text p0_p_dsvd "/dsv41/dsv41-decode"
text p0_p_dsvo "/dsv41-layer0.bin"
text p0_m_ok_rg "PASS self-regen-2x omc="
text p0_m_ok_bc "PASS build-closure\n"
text p0_m_ok_ln "PASS uor-gpu-lean4 theorems=78 sha256="
text p0_m_ok_ug "PASS uor-gpu-gate P3\n"
text p0_m_ok_gp "PASS gpu-packages-host q36+inkling2+dsv41\n"
text p0_m_ok_si "PASS silicon q36-serve+inkling2+dsv41 nvrm_errors_delta=0\n"
text p0_m_sum1 "HELIX-PHASE0 PASS omc="
text p0_m_sum2 " uor_lean="
text p0_m_sum3 " theorems=78 nvrm_errors_delta=0\n"
text p0_m_sumh " theorems=78 hardware=HOST_ONLY\n"
text p0_m_fail "FAIL phase0: "
text p0_e_pin "seed/out/omc does not match seed/out/omc.sha256\n"
text p0_e_r1 "regen1 compile or SHA-256 mismatch\n"
text p0_e_r2 "regen2 compile or SHA-256 mismatch\n"
text p0_e_bir "om-birth --verify failed\n"
text p0_e_gat "om-build-gate failed\n"
text p0_e_lpin "UorGpuWorld.lean SHA-256 mismatch\n"
text p0_e_lrun "lean UorGpuWorld.lean failed or used forbidden axiom\n"
text p0_e_ug "uor-gpu-gate failed\n"
text p0_e_gp "gpucoord build or host check failed\n"
text p0_e_q36 "q36-serve --self-test failed\n"
text p0_e_inks "inkling2-serve --self-test failed\n"
text p0_e_inkm "inkling2-multistream failed\n"
text p0_e_dsv "dsv41-decode layer0 failed\n"
text p0_e_nvrm "nvrm_errors_delta != 0\n"

global p0_scr uchar 4096
global p0_scrl ulong 1
global p0_host ulong 1
global p0_pin uchar 64
global p0_lean uchar 4096
global p0_leanl ulong 1
global p0_best uchar 256
global p0_bestl ulong 1

fn p0_sp suf view uchar * to void
cb_pa_clr
for i ulong get p0_scrl 0 bound 4096
cb_pa_ch get p0_scr i
end
cb_pa_tx suf
end

fn p0_spb suf view uchar * to void
cb_pb_clr
for i ulong get p0_scrl 0 bound 4096
cb_pb_ch get p0_scr i
end
cb_pb_tx suf
end

fn p0_fail msg view uchar * to int
cb_err p0_m_fail
cb_err msg
ret 1
end

fn p0_hex_eq_pin to bool
for i ulong 64
if ne get cb_shex i get p0_pin i
ret false
end
end
ret true
end

fn p0_hex_eq_tx t view uchar * to bool
for i ulong 64
if ne get cb_shex i get t i
ret false
end
end
ret true
end

fn p0_set_omc_pc src view uchar * to ulong
for i ulong len src bound 4096
put cb_pc i get src i
end
ret len src
end

fn p0_compile_pair s1 view uchar * s2 view uchar * dst_suf view uchar * to bool
cb_wb_clr
cb_pa_set s1
if not cb_append_pa_to_wb
ret false
end
cb_pa_set s2
if not cb_append_pa_to_wb
ret false
end
p0_sp p0_p_src
if not cb_write_wb_pa 420
ret false
end
ol = p0_set_omc_pc p0_omc
p0_spb dst_suf
ret eq cb_run_omc ol 493 -1 0
end

fn p0_find_lean to bool
if cb_getenv p0_env_lean
if gt get cb_n 4 0
for i ulong get cb_n 4 bound 4096
put p0_lean i get cb_pb i
end
put p0_leanl 0 get cb_n 4
ret true
end
end
if cb_getenv p0_env_home
if gt get cb_n 4 0
cb_pa_clr
for i ulong get cb_n 4 bound 4096
cb_pa_ch get cb_pb i
end
cb_pa_tx p0_elan_suf
if ge cb_file_size_pa 0
for i ulong get cb_n 3 bound 4096
put p0_lean i get cb_pa i
end
put p0_leanl 0 get cb_n 3
ret true
end
end
end
cb_pa_set p0_usr_lean
if ge cb_file_size_pa 0
for i ulong get cb_n 3 bound 4096
put p0_lean i get cb_pa i
end
put p0_leanl 0 get cb_n 3
ret true
end
ret false
end

note Lexicographically compare cb_dent[ns..ns+nl) > p0_best[0..p0_bestl)
fn p0_name_gt ns ulong nl ulong to bool
bl = get p0_bestl 0
if eq bl 0
ret true
end
ml = nl
if lt bl ml
ml = bl
end
for i ulong ml bound 256
a = get cb_dent add ns i
b = get p0_best i
if gt a b
ret true
end
if lt a b
ret false
end
end
ret gt nl bl
end

fn p0_name_ends_csv ns ulong nl ulong to bool
if lt nl 5
ret false
end
base = sub nl 4
for i ulong 4
if ne get cb_dent add ns add base i get p0_csv_ext i
ret false
end
end
ret true
end

fn p0_scan_sens_buf unr ulong to void
pos = ulong 0
while lt pos unr bound 32768
b0 = ulong get cb_dent add pos 16
b1 = ulong get cb_dent add pos 17
reclen = add b0 mul 256 b1
if eq reclen 0
break
end
ns = add pos 19
nl = cb_dent_nlen ns add pos reclen
if p0_name_ends_csv ns nl
if p0_name_gt ns nl
if le nl 256
for j ulong nl bound 256
put p0_best j get cb_dent add ns j
end
put p0_bestl 0 nl
end
end
end
pos = add pos reclen
end
end

fn p0_parse_nvrm_last to ulong
n = get cb_n 0
if eq n 0
ret 0
end
endp = n
while gt endp 0
if ne get cb_rb sub endp 1 10
break
end
endp = sub endp 1
end
if eq endp 0
ret 0
end
st = endp
while gt st 0
if eq get cb_rb sub st 1 10
break
end
st = sub st 1
end
commas = ulong 0
val = ulong 0
i = st
while lt i endp
c = get cb_rb i
if eq c 44
commas = add commas 1
else
if eq commas 8
if and ge c 48 le c 57
val = add mul val 10 sub ulong c 48
end
end
end
i = add i 1
end
ret val
end

note Read last line col 9 (NVRM error counter) from latest $HOME/yardsticks/sensors/*.csv; returns 0 if unavailable
fn p0_read_nvrm_errors to ulong
if not cb_getenv p0_env_home
ret 0
end
if eq get cb_n 4 0
ret 0
end
cb_pa_clr
for i ulong get cb_n 4 bound 4096
cb_pa_ch get cb_pb i
end
cb_pa_tx p0_sens_suf
fd = fopen cb_pa 0 get cb_n 3 540672 0
if lt fd 0
ret 0
end
put p0_bestl 0 0
while true bound 65536
nr = getdnts int fd cb_dent 0 32768
if le nr 0
break
end
p0_scan_sens_buf ulong nr
end
z0 = fclose int fd
if eq get p0_bestl 0 0
ret 0
end
cb_pa_ch 47
for j ulong get p0_bestl 0 bound 256
cb_pa_ch get p0_best j
end
if not cb_read_pa
ret 0
end
ret p0_parse_nvrm_last
end

fn p0_step_self_regen to bool
cb_pa_set p0_omcsha
if not cb_read_pa
ret false
end
if lt get cb_n 0 64
ret false
end
for i ulong 64
put p0_pin i get cb_rb i
end
cb_pa_set p0_omc
if not cb_sha_file_pa
ret false
end
if not p0_hex_eq_pin
ret false
end
note Regen 1: A1 = seed/out/omc < seed/omc/omc.om
ol = p0_set_omc_pc p0_omc
cb_pa_set p0_omcsrc
p0_spb p0_p_r1
if ne cb_run_omc ol 493 -1 0
ret false
end
p0_sp p0_p_r1
if not cb_sha_file_pa
ret false
end
if not p0_hex_eq_pin
ret false
end
note Regen 2: A2 = A1 < seed/omc/omc.om
p0_sp p0_p_r1
ol2 = get cb_n 3
for i ulong ol2 bound 4096
put cb_pc i get cb_pa i
end
cb_pa_set p0_omcsrc
p0_spb p0_p_r2
if ne cb_run_omc ol2 493 -1 0
ret false
end
p0_sp p0_p_r2
if not cb_sha_file_pa
ret false
end
if not p0_hex_eq_pin
ret false
end
cb_out p0_m_ok_rg
cb_wbuf_hex 1
cb_out cb_nl
ret true
end

fn p0_step_uor_lean to bool
cb_pa_set p0_lean_f
if not cb_sha_file_pa
ret false
end
if not p0_hex_eq_tx p0_lean_pin
ret false
end
if not p0_find_lean
ret false
end
cb_av_clr
cb_pa_clr
for i ulong get p0_leanl 0 bound 4096
cb_pa_ch get p0_lean i
end
cb_av_push_pa
cb_av_push_tx p0_lean_f
p0_sp p0_p_leano
z0 = unlink cb_pa 0 get cb_n 3
fo = fopen cb_pa 0 get cb_n 3 524865 420
if lt fo 0
ret false
end
rc = cb_spawn_fds -1 int fo int fo false
if ne rc 0
ret false
end
p0_sp p0_p_leano
if cb_file_contains_pa p0_bad_s1
ret false
end
if cb_file_contains_pa p0_bad_s2
ret false
end
if cb_file_contains_pa p0_bad_s3
ret false
end
if cb_file_contains_pa p0_bad_s4
ret false
end
if cb_file_contains_pa p0_bad_s5
ret false
end
cb_out p0_m_ok_ln
cb_out p0_lean_pin
cb_out cb_nl
ret true
end

fn p0_app_unit t view uchar * to bool
cb_pa_set t
if not cb_append_pa_to_wb
ret false
end
cb_wb_ch 10
ret true
end

fn p0_step_uor_gate to bool
cb_wb_clr
if not p0_app_unit p0_om2
ret false
end
if not p0_app_unit p0_u_sha2
ret false
end
if not p0_app_unit p0_u_b3
ret false
end
if not p0_app_unit p0_u_s512
ret false
end
if not p0_app_unit p0_u_ed
ret false
end
if not p0_app_unit p0_u_can
ret false
end
if not p0_app_unit p0_u_pvm
ret false
end
if not p0_app_unit p0_u_ver
ret false
end
if not p0_app_unit p0_u_gat
ret false
end
if not p0_app_unit p0_u_em
ret false
end
if not p0_app_unit p0_u_eds
ret false
end
if not p0_app_unit p0_u_ug
ret false
end
p0_sp p0_p_src
if not cb_write_wb_pa 420
ret false
end
ol = p0_set_omc_pc p0_omc
p0_spb p0_p_ug
if ne cb_run_omc ol 493 -1 0
ret false
end
cb_av_clr
p0_sp p0_p_ug
cb_av_push_pa
if ne cb_spawn_fds -1 -1 -1 false 0
ret false
end
cb_out p0_m_ok_ug
ret true
end

fn p0_run_gpucoord cmd view uchar * out_suf view uchar * to bool
cb_av_clr
p0_sp p0_p_gpu
cb_av_push_pa
cb_av_push_tx cmd
p0_sp out_suf
cb_av_push_pa
ret eq cb_spawn_fds -1 -1 -1 false 0
end

fn p0_run_bin bin_suf view uchar * to bool
cb_av_clr
p0_sp bin_suf
cb_av_push_pa
ret eq cb_spawn_fds -1 -1 -1 false 0
end

fn p0_run_bin_arg bin_suf view uchar * arg view uchar * to bool
cb_av_clr
p0_sp bin_suf
cb_av_push_pa
cb_av_push_tx arg
ret eq cb_spawn_fds -1 -1 -1 false 0
end

fn main to int
ac = argcnt
put p0_host 0 0
scr_idx = ulong 0
if gt ac 1
if not cb_pa_arg 1
cb_err p0_usage
ret 2
end
if cb_pa_eq p0_fhost
put p0_host 0 1
if gt ac 2
scr_idx = 2
end
else
scr_idx = 1
end
end
if gt scr_idx 0
if not cb_pa_arg scr_idx
cb_err p0_usage
ret 2
end
else
cb_pa_set p0_defscr
end
for i ulong get cb_n 3 bound 4096
put p0_scr i get cb_pa i
end
put p0_scrl 0 get cb_n 3
if not cb_mkdir_p_pa
cb_err p0_usage
ret 2
end

note 1. Strict self-regeneration (c(sA, A) == A twice)
if not p0_step_self_regen
ret p0_fail p0_e_r1
end

note 2. Full 4-rung birth + pure-OM-2 coordinator gate
if not p0_compile_pair p0_com p0_s_bir p0_p_bir
ret p0_fail p0_e_bir
end
cb_av_clr
p0_sp p0_p_bir
cb_av_push_pa
cb_av_push_tx p0_fver
p0_sp p0_p_bw
cb_av_push_pa
if ne cb_spawn_fds -1 -1 -1 false 0
ret p0_fail p0_e_bir
end
if not p0_compile_pair p0_com p0_s_gat p0_p_gat
ret p0_fail p0_e_gat
end
cb_av_clr
p0_sp p0_p_gat
cb_av_push_pa
p0_sp p0_p_gw
cb_av_push_pa
if ne cb_spawn_fds -1 -1 -1 false 0
ret p0_fail p0_e_gat
end
cb_out p0_m_ok_bc

note 3. 78-theorem uor-gpu Lean 4 proof + uor-gpu-gate
if not p0_step_uor_lean
ret p0_fail p0_e_lrun
end
if not p0_step_uor_gate
ret p0_fail p0_e_ug
end

note 4. Pure-OM-2 GPU packages + host gates
if not p0_compile_pair p0_com p0_s_gpu p0_p_gpu
ret p0_fail p0_e_gp
end
if not p0_run_gpucoord p0_bq36 p0_p_q36
ret p0_fail p0_e_gp
end
if not p0_run_gpucoord p0_bink p0_p_ink
ret p0_fail p0_e_gp
end
if not p0_run_gpucoord p0_bdsv p0_p_dsv
ret p0_fail p0_e_gp
end
if not p0_run_bin p0_p_inka
ret p0_fail p0_e_gp
end
if not p0_run_bin p0_p_inkc
ret p0_fail p0_e_gp
end
if not p0_run_bin p0_p_dsvs
ret p0_fail p0_e_gp
end
cb_out p0_m_ok_gp

note 5. Live silicon checks (unless --host-only)
note Wait 10s between GPU processes so NVIDIA RM finishes freeing UVM slabs (prevents NV_ERR_NO_MEMORY).
if eq get p0_host 0 0
e0 = p0_read_nvrm_errors
if not p0_run_bin_arg p0_p_q36s p0_fsel
ret p0_fail p0_e_q36
end
z_s1 = sleepns 10000000000
if not p0_run_bin_arg p0_p_inks p0_fsel
ret p0_fail p0_e_inks
end
z_s2 = sleepns 10000000000
if not p0_run_bin p0_p_inkm
ret p0_fail p0_e_inkm
end
z_s3 = sleepns 10000000000
cb_pa_set p0_dsv_t
if ge cb_file_size_pa 0
cb_pa_set p0_dsv_s1
if ge cb_file_size_pa 0
if cb_getenv p0_env_home
cb_av_clr
p0_sp p0_p_dsvd
cb_av_push_pa
cb_av_push_tx p0_dsv_l0
cb_av_push_tx p0_dsv_t
cb_av_push_tx p0_dsv_map
cb_av_push_tx p0_dsv_s
cb_pa_clr
for i ulong get cb_n 4 bound 4096
cb_pa_ch get cb_pb i
end
cb_pa_tx p0_dsv_msuf
cb_av_push_pa
cb_av_push_tx p0_dsv_tok
p0_sp p0_p_dsvo
cb_av_push_pa
if ne cb_spawn_fds -1 -1 -1 false 0
ret p0_fail p0_e_dsv
end
end
end
end
z_s4 = sleepns 3000000000
e1 = p0_read_nvrm_errors
if ne e1 e0
ret p0_fail p0_e_nvrm
end
cb_out p0_m_ok_si
end

cb_out p0_m_sum1
for i ulong 64
put cb_shex i get p0_pin i
end
cb_wbuf_hex 1
cb_out p0_m_sum2
cb_out p0_lean_pin
if eq get p0_host 0 0
cb_out p0_m_sum3
else
cb_out p0_m_sumh
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/build/units.om: Pure seeded-Omega C-Binding & Units Regenerator.
note Replaces om/units.sh completely with exact byte-for-byte parity. Zero shell, zero sed/tr/wc/cmp.
note Build: cat seed/build/common.om seed/build/units.om | seed/out/omc > build/om-units
note Usage: om-units [--check]
note Env:
note   OMEGA_OMC         pinned omc binary (default checked against seed/out/omc.sha256 or OMEGA_OMC_PIN)
note   OMEGA_BRIDGE      omega-bridge checkout (src/native.om pinned against OMEGA_NATIVE_PIN)
note   OMEGA_UNITS       optional space-separated unit override
note   OMEGA_UNITS_DEST  optional output directory (default src)

text un_fcheck "--check"
text un_env_omc "OMEGA_OMC"
text un_env_br "OMEGA_BRIDGE"
text un_env_units "OMEGA_UNITS"
text un_env_dest "OMEGA_UNITS_DEST"
text un_env_omcpin "OMEGA_OMC_PIN"
text un_env_natpin "OMEGA_NATIVE_PIN"
text un_def_natpin "9788b27a92c8dd365de7052439653de62f89634189a34cb6b3f582cae65dda83"
text un_pin_file "seed/out/omc.sha256"
text un_nat_rel "/src/native.om"
text un_def_dest "src"
text un_nr_env "NOT_RUN: set OMEGA_OMC and OMEGA_BRIDGE\n"
text un_nr_omc "NOT_RUN: omc is not the pinned compiler\n"
text un_nr_nat "NOT_RUN: native.om is not the pinned generator\n"
text un_fail_io "FAIL: units I/O or tool error\n"
text un_fail_diff1 "FAIL "
text un_fail_diff2 " differs from the pinned tools' output\n"
text un_pass_chk "PASS src/{omega_om_units.c,omega_native.h,omega_api_decl.h,omega_om_units.ident,omega_om_units_fs.c} regenerate byte for byte\n"
text un_wrote1 "wrote "
text un_wrote2 "/{omega_om_units.c,omega_native.h,omega_api_decl.h,omega_om_units.ident,omega_om_units_fs.c}\n"
text un_nofs "/* No freestanding GPU units selected. */\n"

text un_def_units "om/arboris_arena.om om/arboris_spread.om om/arboris_spread_plan.om om/arboris_spread_cpu.om om/bw_arboris_spread_emit.om om/arboris_gated.om om/blackwell_arboris_emit.om om/blackwell_arboris_qmd.om gpu/nvidia/om/codegen/bw_hazard.om om/sha256/sha256-om2.om om/blake3/b3unit.om om/encoder/bw_enc_sm121.om om/aarch64/aarch64_om2.om om/visor/canonical_om2.om om/visor/validate_om2.om om/visor/codec_om2.om om/visor/verify_om2.om om/gpu/bw_qmd.om om/gpu/bw_sched.om om/gpu/bw_regalloc.om om/gpu/bw_vecadd.om om/gpu/cg_matmul.om om/gpu/cg_gpu_gemm.om om/gpu/cg_gpu_attn.om om/gpu/q38_plan.om om/gpu/moe_plan.om om/gpu/cg_pf.om om/gpu/cg_bf16.om om/gpu/cg_gemm.om om/gpu/cg_moe2.om om/gpu/cg_moe.om om/gpu/cg_qmma.om om/gpu/cg_pfhost.om om/gpu/cg_tgemm.om om/gpu/cg_tc2.om om/gpu/cg_qg.om om/gpu/cg_tc.om om/gpu/cg_pattn256.om om/gpu/cg_router.om om/gpu/cg_pattn.om om/gpu/cg_attn.om om/gpu/cg_tern.om om/gpu/cg_attn256.om om/gpu/cg_dec.om om/gpu/cg_gdn.om om/runtime/rx_regulate.om om/runtime/rx_mid.om om/runtime/rx_cortex_rec.om om/runtime/rx_plan_core.om om/runtime/rx_projection.om om/runtime/rx_capq_core.om om/runtime/rx_costmodel_core.om om/runtime/rx_route_core.om om/runtime/rx_world_core.om om/runtime/rx_coherent_om2.om om/runtime/rx_semantic_om2.om om/runtime/rx_skillroute_core.om om/runtime/rx_fusion_core.om seed/authority/cap_table_om2.om seed/authority/aegis_om2.om om/compiler/osc_literal.om om/compiler/osc_type.om om/compiler/osc_expr.om om/compiler/osc_scalar.om om/compiler/osc_a64_fields.om om/compiler/osc_statement.om om/compiler/osc_ownership.om om/compiler/osc_scope.om om/compiler/osc_pool.om om/compiler/osc_trace.om om/compiler/osc_lifetimes.om om/compiler/osc_flow.om om/compiler/osc_artifact.om src/tensor/tensor_shape.om src/tensor/tensor_ops.om src/train/sgd_update.om src/train/generation.om src/autodiff/gradient_shape.om src/allen/allen_core.om src/path/rx_path_core.om src/ans/ans_core.om src/reservoir/reservoir_readout.om src/crumbline/cl_core.om src/dual/rx_dual_core.om src/dual_experiment/applic_core.om src/estimation/est_core.om src/searchtrace/st_core.om src/language/lang_core.om src/visor/visor_core.om src/fabric/fab_core.om src/algebra/oma_core.om src/physics0/pd0_core.om src/turing/turing_core.om src/polyglot/omx_core.om src/osh/osh_core.om"

note Special composed unit paths & helpers
text un_p_as "om/arboris_spread.om"
text un_p_ao "om/arboris_ontology.om"
text un_p_sha2 "om/tls/sha2.om"
text un_p_ar "om/arboris_records.om"
text un_p_ag "om/arboris_gated.om"
text un_p_aa "om/arboris_arena.om"
text un_p_num "gpu/nvidia/om/numeric/numeric.om"
text un_p_bae "om/blackwell_arboris_emit.om"
text un_p_enc "om/encoder/bw_enc_sm121.om"
text un_p_bage "om/blackwell_arboris_gated_emit.om"
text un_p_baq "om/blackwell_arboris_qmd.om"
text un_p_qmd "om/gpu/bw_qmd.om"
text un_p_bse "om/bw_arboris_spread_emit.om"
text un_p_bhz "gpu/nvidia/om/codegen/bw_hazard.om"
text un_om2_ln "om2\n"
text un_exp_fn "export fn "
text un_fn_sp "fn "
text un_hz_from "fn hz_chk "
text un_hz_to "export fn hz_chk "
text un_note_w "note"
text un_om2_w "om2"
text un_om_ext ".om"

note Leaf unit paths (use caller-stack freest/fapic ABI)
text un_l01 "om/blackwell_arboris_emit.om"
text un_l02 "om/blackwell_arboris_qmd.om"
text un_l03 "om/arboris_spread.om"
text un_l04 "om/arboris_arena.om"
text un_l05 "src/tensor/tensor_shape.om"
text un_l06 "om/compiler/osc_flow.om"
text un_l07 "src/train/generation.om"
text un_l08 "om/compiler/osc_statement.om"
text un_l09 "om/compiler/osc_artifact.om"
text un_l10 "src/autodiff/gradient_shape.om"

note FS unit paths (freestanding GPU link)
text un_fs01 "om/sha256/sha256-om2.om"
text un_fs02 "om/gpu/bw_qmd.om"
text un_fs03 "om/gpu/bw_regalloc.om"
text un_fs04 "om/gpu/bw_vecadd.om"
text un_fs05 "om/gpu/cg_matmul.om"
text un_fs06 "om/gpu/cg_gpu_attn.om"

note Native generator commands & output filenames
text un_cmd_c "c"
text un_cmd_apic "apic"
text un_cmd_freest "freest"
text un_cmd_fapic "fapic"
text un_cmd_h "h"
text un_cmd_apih "apih"
text un_f_c "/omega_om_units.c"
text un_f_h "/omega_native.h"
text un_f_apih "/omega_api_decl.h"
text un_f_id "/omega_om_units.ident"
text un_f_fs "/omega_om_units_fs.c"
text un_tdir "build/om-units-work-"
text un_tnat "/native"
text un_tsrc "/u.src.om"
text un_tbin "/u.bin"
text un_tuin "/u.in"
text un_tunits "/units.in"
text un_thost "/host.in"
text un_tleaf "/leaf.in"
text un_tfs "/fs.in"
text un_tleafc "/leaf.c"

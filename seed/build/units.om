text un_ombr "ombr"
text un_ombr_leaf "ombr_leaf"

global un_omc uchar 4096
global un_omcl ulong 1
global un_br uchar 4096
global un_brl ulong 1
global un_dest uchar 4096
global un_destl ulong 1
global un_omcpin uchar 64
global un_natpin uchar 64
global un_ulist uchar *
global un_uln ulong 1
global un_tmp uchar 4096
global un_tmpl ulong 1
global un_cur uchar 4096
global un_curl ulong 1
global un_name uchar 256
global un_namel ulong 1
global un_chk ulong 1
global un_has_host ulong 1
global un_has_leaf ulong 1
global un_has_fs ulong 1

fn un_die msg view uchar * code int to void
un_cleanup
cb_err msg
exit code
end

fn un_tpath suf view uchar * to void
cb_pa_clr
for i ulong get un_tmpl 0 bound 4096
cb_pa_ch get un_tmp i
end
cb_pa_tx suf
end

fn un_tbpath suf view uchar * to void
cb_pb_clr
for i ulong get un_tmpl 0 bound 4096
cb_pb_ch get un_tmp i
end
cb_pb_tx suf
end

fn un_dpath name view uchar * to void
cb_pb_clr
for i ulong get un_destl 0 bound 4096
cb_pb_ch get un_dest i
end
cb_pb_tx name
end

fn un_hex_eq_pin is_omc bool to bool
for j ulong 64
if is_omc
if ne get cb_shex j get un_omcpin j
ret false
end
else
if ne get cb_shex j get un_natpin j
ret false
end
end
end
ret true
end

fn un_cur_eq t view uchar * to bool
n = get un_curl 0
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get un_cur i get t i
ret false
end
end
ret true
end

fn un_cur_ends t view uchar * to bool
n = get un_curl 0
m = len t
if lt n m
ret false
end
off = sub n m
for i ulong m bound 4096
if ne get un_cur add off i get t i
ret false
end
end
if eq off 0
ret true
end
ret eq get un_cur sub off 1 47
end

fn un_is_leaf to bool
if un_cur_ends un_l01
ret true
end
if un_cur_ends un_l02
ret true
end
if un_cur_ends un_l03
ret true
end
if un_cur_ends un_l04
ret true
end
if un_cur_ends un_l05
ret true
end
if un_cur_ends un_l06
ret true
end
if un_cur_ends un_l07
ret true
end
if un_cur_ends un_l08
ret true
end
if un_cur_ends un_l09
ret true
end
ret un_cur_ends un_l10
end

fn un_is_fs to bool
if un_cur_eq un_fs01
ret true
end
if un_cur_eq un_fs02
ret true
end
if un_cur_eq un_fs03
ret true
end
if un_cur_eq un_fs04
ret true
end
if un_cur_eq un_fs05
ret true
end
ret un_cur_eq un_fs06
end

fn un_rb_line_starts pos ulong endp ulong t view uchar * to bool
m = len t
if lt sub endp pos m
ret false
end
for j ulong m bound 64
if ne get cb_rb add pos j get t j
ret false
end
end
ret true
end

note Append file at cb_pa to cb_wb with optional transforms:
note mode 0 = raw, 1 = sed 's/^export fn /fn /', 2 = sed '/^om2$/d; s/^export fn /fn /', 3 = sed 's/^fn hz_chk /export fn hz_chk /'
fn un_app_xform mode ulong to void
if eq mode 0
if not cb_append_pa_to_wb
un_die un_fail_io 1
end
ret
end
if not cb_read_pa
un_die un_fail_io 1
end
n = get cb_n 0
i = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_rb e 10
break
end
e = add e 1
end
has_nl = lt e n
skip = false
if eq mode 2
if and eq sub e i 3 un_rb_line_starts i e un_om2_w
skip = true
end
end
if not skip
if and or eq mode 1 eq mode 2 un_rb_line_starts i e un_exp_fn
cb_wb_tx un_fn_sp
cb_wb_rb add i 10 sub sub e i 10
else
if and eq mode 3 un_rb_line_starts i e un_hz_from
cb_wb_tx un_hz_to
cb_wb_rb add i 10 sub sub e i 10
else
cb_wb_rb i sub e i
end
end
if has_nl
cb_wb_ch 10
end
end
i = add e 1
end
end

fn un_pa_set_cur to void
cb_pa_clr
for i ulong get un_curl 0 bound 4096
cb_pa_ch get un_cur i
end
end

note Compose current unit source into cb_wb
fn un_compose_unit to void
cb_wb_clr
if un_cur_ends un_p_as
cb_pa_set un_p_ao
un_app_xform 0
cb_pa_set un_p_sha2
un_app_xform 0
cb_pa_set un_p_ar
un_app_xform 0
un_pa_set_cur
un_app_xform 0
ret
end
if un_cur_ends un_p_ag
cb_pa_set un_p_aa
un_app_xform 1
cb_pa_set un_p_num
un_app_xform 0
un_pa_set_cur
un_app_xform 0
ret
end
if un_cur_ends un_p_bae
cb_wb_tx un_om2_ln
cb_pa_set un_p_enc
un_app_xform 0
un_pa_set_cur
un_app_xform 0
cb_pa_set un_p_bage
un_app_xform 0
ret
end
if un_cur_ends un_p_baq
cb_pa_set un_p_qmd
un_app_xform 1
un_pa_set_cur
un_app_xform 0
ret
end
if un_cur_ends un_p_bse
cb_wb_tx un_om2_ln
cb_pa_set un_p_enc
un_app_xform 0
cb_pa_set un_p_qmd
un_app_xform 2
un_pa_set_cur
un_app_xform 0
ret
end
if un_cur_ends un_p_bhz
cb_wb_tx un_om2_ln
un_pa_set_cur
un_app_xform 3
ret
end
un_pa_set_cur
un_app_xform 0
end

fn un_is_name_ch c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

note Derive unit name: basename(cur, .om) with non-[A-Za-z0-9_] mapped to '_'
fn un_derive_name to void
n = get un_curl 0
s = ulong 0
for i ulong n bound 4096
if eq get un_cur i 47
s = add i 1
end
end
e = n
if ge sub e s 3
if eq get un_cur sub e 3 46
if eq get un_cur sub e 2 111
if eq get un_cur sub e 1 109
e = sub e 3
end
end
end
end
m = sub e s
if gt m 255
m = 255
end
for i ulong m bound 256
c = get un_cur add s i
if un_is_name_ch c
put un_name i c
else
put un_name i 95
end
end
put un_namel 0 m
end

note Detect OM-2 profile from cb_wb[0..cb_n[1]): first non-blank, non-note line equals "om2"
fn un_detect_om2 to bool
n = get cb_n 1
i = ulong 0
while lt i n bound 9223372036854775807
e = i
while lt e n bound 9223372036854775807
if eq get cb_wb e 10
break
end
e = add e 1
end
p = i
while lt p e bound 9223372036854775807
if eq get cb_wb p 32
p = add p 1
else
break
end
end
if lt p e
note check if starts with "note" followed by end-of-line or space
is_n = false
if ge sub e p 4
if eq get cb_wb p 110
if eq get cb_wb add p 1 111
if eq get cb_wb add p 2 116
if eq get cb_wb add p 3 101
if eq sub e p 4
is_n = true
else
if eq get cb_wb add p 4 32
is_n = true
end
end
end
end
end
end
end
if not is_n
if eq sub e i 3
if eq get cb_wb i 111
if eq get cb_wb add i 1 109
if eq get cb_wb add i 2 50
ret true
end
end
end
end
ret false
end
end
i = add e 1
end
ret false
end

fn un_append_file_to_file src_suf view uchar * dst_suf view uchar * to void
un_tpath src_suf
fdi = fopen cb_pa 0 get cb_n 3 524288 0
if lt fdi 0
un_die un_fail_io 1
end
un_tbpath dst_suf
fdo = fopen cb_pb 0 get cb_n 4 525377 420
if lt fdo 0
z0 = fclose int fdi
un_die un_fail_io 1
end
while true bound 9223372036854775807
k = read int fdi cb_chunk1 0 65536
if lt k 0
un_die un_fail_io 1
end
if eq k 0
break
end
o = ulong 0
kl = ulong k
while lt o kl bound 65537
w = write int fdo cb_chunk1 o sub kl o
if le w 0
un_die un_fail_io 1
end
o = add o ulong w
end
end
z1 = fclose int fdi
z2 = fclose int fdo
end

fn un_run_native cmd view uchar * in_suf view uchar * out_suf view uchar * to void
un_tpath in_suf
fi = fopen cb_pa 0 get cb_n 3 524288 0
if lt fi 0
un_die un_fail_io 1
end
un_tbpath out_suf
z0 = unlink cb_pb 0 get cb_n 4
fo = fopen cb_pb 0 get cb_n 4 524865 420
if lt fo 0
z1 = fclose int fi
un_die un_fail_io 1
end
cb_av_clr
un_tpath un_tnat
cb_av_push_pa
cb_av_push_tx cmd
rc = cb_spawn_fds int fi int fo -1 false
if ne rc 0
un_die un_fail_io 1
end
end

fn un_run_native_app cmd view uchar * in_suf view uchar * out_suf view uchar * to void
un_tpath in_suf
fi = fopen cb_pa 0 get cb_n 3 524288 0
if lt fi 0
un_die un_fail_io 1
end
un_tbpath out_suf
fo = fopen cb_pb 0 get cb_n 4 525377 420
if lt fo 0
z1 = fclose int fi
un_die un_fail_io 1
end
cb_av_clr
un_tpath un_tnat
cb_av_push_pa
cb_av_push_tx cmd
rc = cb_spawn_fds int fi int fo -1 false
if ne rc 0
un_die un_fail_io 1
end
end

fn un_is_ident_eq c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if or eq c 95 eq c 61
ret true
end
ret false
end

fn un_is_alnum_u c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

fn un_rb_is_ombr i ulong to bool
if ne get cb_rb i 111
ret false
end
if ne get cb_rb add i 1 109
ret false
end
if ne get cb_rb add i 2 98
ret false
end
ret eq get cb_rb add i 3 114
end

note Pure-Omega equivalent of:
note sed -E 's/(^|\n|[^[:alnum:]_=])ombr(2?_[[:alnum:]_]+)/\1ombr_leaf\2/g'
note Reads leaf.c into cb_rb and appends transformed bytes to omega_om_units.c
fn un_append_leaf_ns to void
un_tpath un_tleafc
if not cb_read_pa
un_die un_fail_io 1
end
n = get cb_n 0
cb_wb_clr
i = ulong 0
while lt i n bound 9223372036854775807
matched = false
if le add i 6 n
if un_rb_is_ombr i
note check left boundary: start-of-line, or \n escape, or non-[[:alnum:]_=]
lb = false
if eq i 0
lb = true
else
prev = get cb_rb sub i 1
if eq prev 10
lb = true
else
if not un_is_ident_eq prev
lb = true
else
if and ge i 2 and eq get cb_rb sub i 2 92 eq prev 110
lb = true
end
end
end
end
if lb
note check right side: (2?_[[:alnum:]_]+)
k = add i 4
if and lt k n eq get cb_rb k 50
k = add k 1
end
if and lt add k 1 n and eq get cb_rb k 95 un_is_alnum_u get cb_rb add k 1
matched = true
end
end
end
end
if matched
cb_wb_tx un_ombr_leaf
i = add i 4
else
cb_wb_ch get cb_rb i
i = add i 1
end
end
un_tpath un_tc2
if not cb_write_wb_pa 420
un_die un_fail_io 1
end
un_append_file_to_file un_tc2 un_f_c
end

fn un_process_one to void
un_compose_unit
un_derive_name
is_om2 = un_detect_om2
un_tpath un_tsrc
if not cb_write_wb_pa 420
un_die un_fail_io 1
end
note Hash composed source
if not cb_sha_file_pa
un_die un_fail_io 1
end
note Save source hex in cb_pc[0..64) temporarily? No, use un_write_ident after compile; copy hex into cb_chunk2[0..64)
for j ulong 64
put cb_chunk2 j get cb_shex j
end
note Compile source with pinned OMC
for i ulong get un_omcl 0 bound 4096
put cb_pc i get un_omc i
end
un_tpath un_tsrc
un_tbpath un_tbin
rc = cb_run_omc get un_omcl 0 420 -1
if ne rc 0
un_die un_fail_io 1
end
note Build framed u.in: src + \0 + %08d(bin_len) + bin + (if om2: "omega-unit NAME OMC_PIN\n")
un_tpath un_tbin
bsz = cb_file_size_pa
if lt bsz 0
un_die un_fail_io 1
end
cb_wb_clr
un_tpath un_tsrc
if not cb_append_pa_to_wb
un_die un_fail_io 1
end
cb_wb_ch 0
note 8-digit zero-padded decimal bsz
d = ulong bsz
for q ulong 8
put cb_numbuf sub 7 q uchar add 48 rem d 10
d = div d 10
end
for q ulong 8
cb_wb_ch get cb_numbuf q
end
un_tpath un_tbin
if not cb_append_pa_to_wb
un_die un_fail_io 1
end
if is_om2
cb_wb_tx un_tag_pre
for j ulong get un_namel 0 bound 256
cb_wb_ch get un_name j
end
cb_wb_ch 32
for j ulong 64
cb_wb_ch get un_omcpin j
end
cb_wb_ch 10
end
un_tpath un_tuin
if not cb_write_wb_pa 420
un_die un_fail_io 1
end
un_append_file_to_file un_tuin un_tunits
if un_is_leaf
un_append_file_to_file un_tuin un_tleaf
put un_has_leaf 0 1
else
un_append_file_to_file un_tuin un_thost
put un_has_host 0 1
end
if un_is_fs
un_append_file_to_file un_tuin un_tfs
put un_has_fs 0 1
end
note Append ident line
cb_wb_clr
cb_wb_tx un_id_1
for j ulong get un_namel 0 bound 256
cb_wb_ch get un_name j
end

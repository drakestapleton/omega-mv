eqc = lt_xeq view part b 0 ulong n 0 1
eqb = lt_xeq view part b 0 ulong n 0 0
lp_x 2
lp_t ltsnap
w = lf_wb view part b 0 ulong n
h = lf_hash
lo_c 32
lo_p
lo_w ltsha
lo_c 32
lo_h
lo_kv ltbytes ulong h
lo_kv ltcorw lt_b eqc
lo_kv ltbrkw lt_b eqb
lo_e
ret and eqc w
end

fn lt_ccr to void
s = and eq get lcr 0 1 ge get lcr 1 1
s = and s and eq get lcr 2 0 eq get lcr 3 0
s = and s and ge get lcr 4 1 ge get lcr 5 1
s = and s and eq get lcr 6 1 eq get lcr 7 0
s = and s and eq get lcw 0 1 eq get lcw 1 1
s = and s and eq get lcr 9 0 eq get lcr 10 1
s = and s and eq get lcr 11 1 eq get lcr 12 1
s = and s eq get lcr 13 137
lo_kv ltkillw get lcr 0
lo_kv ltinfa get lcr 1
lo_kv ltr1st get lcr 13
lo_kv ltr1o get lcr 3
lo_kv ltr1r get lcr 4
lo_kv ltleft get lcr 2
lo_kv ltsnok get lcr 6
lo_kv ltexit get lcr 7
lo_kv ltms get lcr 8
lt_ofmt 0
lo_kv ltr2r get lcw 8
lo_kv ltleft get lcr 9

fn lt_arg k ulong to bool
n = argread k la mul k 512 511
if or lt n 2 gt n 510
ret false
end
put ll k ulong n
ret eq get la mul k 512 47
end

fn lt_opt k ulong to bool
b = new uchar 512 0
n = argread k b 0 512
if or lt n 7 gt n 12
ret false
end
if and eq n 7 lt_pfx b 0 ltsrv
c = ulong get b 6
if eq c 48
put lopt 0 0
ret true
end
if eq c 49
put lopt 0 1
ret true
end
ret false
end
if not lt_pfx b 0 ltprt
ret false
end
m = ulong 0
for i ulong sub ulong n 6 bound 8
c = ulong get b add 6 i
if eq c 102
m = or m 1
else
if eq c 99
m = or m 2
else
if eq c 114
m = or m 4
else
ret false
end
end
end
end
put lopt 1 m
ret true
end


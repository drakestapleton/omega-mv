lo_kv ltchks get lck 0
lo_kv ltpassw get lck 1
lo_kv ltfailw get lck 2
lo_kv ltnrw get lck 3
lo_e
if and eq get lck 2 0 eq get lck 3 0
ret 0
end
ret 1
end

fn main to int
put lpid 0 ulong getpid
put lopt 0 1
put lopt 1 7
c = ulong argcnt
ok = and ge c 7 le c 9
if ok
for k ulong 6
ok = and ok lt_arg add k 1
end
for k ulong sub c 7 bound 2
ok = and ok lt_opt add k 7
end
end
if ok
put lpn 0 0
lp_a 1
ok = lf_mk
end
if not ok
lo_t ltusage
lo_e
ret 2
end
lo_t ltlive
lo_kv ltpidw get lpid 0
lo_w ltbase
lo_c 32
lo_a 1
lo_w ltsrv
lo_n get lopt 0
lo_w ltprt
lo_n get lopt 1
lo_kv ltstart ulong realns
lo_e
lt_prq
s = lt_sel
lt_selr s
if ne and get lopt 1 1 0
if eq s 0
lt_full
else
lt_nrf ltcsel
end
else
lt_nrf ltnsel
end
if ne and get lopt 1 2 0
if eq s 0
lt_canc
else
lt_nrc ltcsel
end
else
lt_nrc ltnsel
end
if ne and get lopt 1 4 0
if eq s 0
lt_crash
else
lt_nrr ltcsel
end
else
lt_nrr ltnsel
end
lt_leak
ret lt_end
end

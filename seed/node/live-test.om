fn lt_crash to void
for i ulong 16
put lcr i 0
end
ok = lt_prep 2 1
sp = lt_serve 2
put lcr 11 lt_b ok
put lcr 12 lt_b gt sp 0
pid = lt_cw 2 0 1 1
if gt pid 0
put lcr 0 lt_watch pid
end
put lcr 2 lt_left 15000
if gt pid 0
r = killpid neg int pid 9
end
sz = lt_rd 2 1
put lcr 3 get lcw 0
put lcr 4 get lcw 8
put lcr 5 get lcw 9
put lcr 6 lt_b lt_snap
t0 = ulong monons
p2 = lt_cw 2 0 1 2
e = ulong 997
if gt p2 0
e = lt_wait p2 4000000
end
put lcr 7 e
put lcr 8 div sub ulong monons t0 1000000
put lcr 9 lt_left 15000
if gt p2 0
r = killpid neg int p2 9
end
put lcr 10 lt_b lt_stop sp
lt_runl 2 1 get lcr 13 0 get lcr 2
lt_runl 2 2 e get lcr 8 get lcr 9
sz = lt_rd 2 2
lt_ccr
j = lt_cj 2 2 1
j = and j ge get ljs 15 1
lt_res lt_ok j ltcrj
lj_ops 2
end


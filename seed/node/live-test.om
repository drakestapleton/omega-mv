note ======== cancellation: code-test cancels objective 0 after 20 s, during
note inference; code-main's cancel path must kill the inference (the
note server logs the dropped request as status 499) and journal the CANCEL.
note lcr: 0 prep ok, 1 exit, 2 ms, 3 node processes left, 4 server logged
note 499, 5 server group gone, 6 server ok.
fn lt_canc to void
put lcr 0 lt_b lt_prep 1 1
sp = lt_serve 1
put lcr 6 lt_b gt sp 0
t0 = ulong monons
pid = lt_cw 1 1 1 0
e = ulong 997
if gt pid 0
e = lt_wait pid 600000
end
put lcr 1 e
put lcr 2 div sub ulong monons t0 1000000
put lcr 3 lt_left 15000
if gt pid 0
r = killpid neg int pid 9
end
put lcr 4 lt_b lt_c499 1
put lcr 5 lt_b lt_stop sp
n = lt_rd 1 0
lt_runl 1 0 e get lcr 2 get lcr 3
lt_ccan
j = lt_cj 1 1 1
j = and j ge get ljs 6 1
lt_res lt_ok j ltccj
end

fn lt_ccan to void

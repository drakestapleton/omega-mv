note la: arguments 1..6 at 512 * k, lengths in ll; lopt 0 serve, 1 parts.
global la uchar 4096
global ll ulong 8
global lopt ulong 4
global lob uchar 8192
global lon ulong 1
global lpa uchar 4096
global lpn ulong 1
global lhx uchar 64
global lck ulong 4
global lpid ulong 1
global lcu ulong 1
global linf ulong 1
note ltx: per objective i and slot s (0 broken, 1 correct, 2 fault, 3..9
note turn prompts, 10..16 turn raws) 4096 bytes at (17 i + s) 4096.
global ltx uchar 278528
global ltxl ulong 68
global ltnt ulong 4
global ltps ulong 4
note lcw: parsed output; per objective i at 16 i: 0 CWO lines, 1 passed,
note 2 result, 3 turns, 4 CWP frames, 5 CWR frames, 6 prompts equal to the
note record, 7 raws equal, 8 replace jobs issued, 9 replace outcomes,
note 10 inference jobs issued after a replace outcome, 11 cancel events,
note 12 CWE lines; 64 CWSUM lines, 65 its pass, 66 its fail (objective 3
note uses 48..60, so the CWSUM slots must start above it).
global lcw ulong 80
note lcr: crash scenario values (see lt_crash).
global lcr ulong 16
global lrv ulong 4
note ljs: journal summary (see lj_scan); ljo: per operation 12 words (0..3
note the operation key, starts, dones, start fence, done fence, outcome,
note how, the job id and the class of its START).
global ljs ulong 32
global ljo ulong 12288
global ljn ulong 1

note ======== output lines

fn lt_dig v ulong d edit uchar 24 to ulong
k = ulong 0
x = v
for i ulong 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
ret k
end

fn lo_c c ulong to void
n = get lon 0
if or lt n 8100 and eq c 10 lt n 8192
put lob n uchar c
put lon 0 add n 1
end
end

fn lo_t a view uchar * to void
for i ulong len a
lo_c ulong get a i
end
end

fn lo_w a view uchar * to void
lo_c 32
lo_t a
end

fn lo_n v ulong to void
d = new uchar 24 0
k = lt_dig v d
for j ulong k
lo_c ulong get d sub sub k j 1
end
end

fn lo_kv k view uchar * v ulong to void
lo_c 32
lo_t k
lo_c 32
lo_n v
end

fn lo_a k ulong to void
for i ulong get ll k
lo_c ulong get la add mul k 512 i
end
end

fn lo_p to void
for i ulong get lpn 0
lo_c ulong get lpa i
end
end

fn lo_h to void
for i ulong 64
lo_c ulong get lhx i
end
end

fn lo_xs i ulong s ulong to void
q = add mul i 17 s
b = mul q 4096
for j ulong get ltxl q
lo_c ulong get ltx add b j
end
end

fn lo_x x ulong to void
if eq x 0
lo_t ltfull
end
if eq x 1
lo_t ltcanc
end
if eq x 2
lo_t ltcrsh
end
end

fn lo_e to void
lo_c 10
n = get lon 0
p = ulong 0
for it ulong 4096
if ge p n
break
end
r = write 1 lob p sub n p
if le r 0
break
end
p = add p ulong r
end
put lon 0 0
end

fn lt_ok b bool to ulong
if b
ret 0
end
ret 1
end

note One check line: verdict st (0 PASS, 1 FAIL, 2 NOT_RUN), the name, then
note the detail already in the line buffer.
fn lt_res st ulong name view uchar * to void
d = new uchar 8192 0
n = get lon 0
for i ulong n
put d i get lob i
end
put lon 0 0
put lck 0 add get lck 0 1
put lck add st 1 add get lck add st 1 1
if eq st 0
lo_t ltpass
end
if eq st 1
lo_t ltfail
end
if eq st 2
lo_t ltnr
end
lo_w name
if gt n 0
if ne get d 0 32
lo_c 32
end
lo_t view part d 0 n
end
lo_e
end

note ======== paths (the current path is lpa[0, lpn))

fn lp_c c ulong to void
n = get lpn 0
if lt n 4000
put lpa n uchar c
put lpn 0 add n 1
end
end

fn lp_t a view uchar * to void
for i ulong len a
lp_c ulong get a i
end
end

fn lp_n v ulong to void
d = new uchar 24 0
k = lt_dig v d
for j ulong k
lp_c ulong get d sub sub k j 1
end
end

fn lp_a k ulong to void
for i ulong get ll k
lp_c ulong get la add mul k 512 i
end
end

fn lp_x x ulong to void
put lpn 0 0
lp_a 1
lp_c 47
if eq x 0
lp_t ltfull
end
if eq x 1
lp_t ltcanc
end
if eq x 2
lp_t ltcrsh
end
end

fn lp_o i ulong to void
if eq i 0
lp_t ltj0
end
if eq i 1
lp_t ltj1
end
if eq i 2
lp_t ltj2
end
if eq i 3
lp_t ltj3
end
end

note Output file names: out 0 run, 1 run1, 2 run2, 10 + i review-i; e 0
note .out, 1 .err.
fn lp_on oi ulong e ulong to void
if ge oi 10
lp_t ltrev
lp_n sub oi 10
else
lp_t ltrun
if gt oi 0
lp_n oi
end
end
if eq e 0
lp_t ltout
else
lp_t lterr
end
end

note ======== packed argument lists (execprog)

fn pk_t pk edit uchar 4096 p ulong a view uchar * to ulong
if gt add add p 2 len a 4096
ret 5000
end
c = add or ulong get pk 0 shl ulong get pk 1 8 1
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
put pk p uchar and len a 255
put pk add p 1 uchar shr len a 8
for i ulong len a
put pk add add p 2 i get a i
end
ret add add p 2 len a
end

fn pk_p pk edit uchar 4096 p ulong to ulong
b = new uchar 4096 0
n = get lpn 0
for i ulong n
put b i get lpa i
end
ret pk_t pk p view part b 0 n
end

fn pk_a pk edit uchar 4096 p ulong k ulong to ulong
put lpn 0 0
lp_a k
ret pk_p pk p
end

fn pk_o pk edit uchar 4096 p ulong i ulong to ulong
if eq i 0
ret pk_t pk p lto0
end
if eq i 1
ret pk_t pk p lto1
end
if eq i 2
ret pk_t pk p lto2
end
ret pk_t pk p lto3
end

note ======== files (at the current path)

fn lf_creat to long
ret fopen lpa 0 get lpn 0 577 420
end

fn lf_mk to bool
r = makedir lpa 0 get lpn 0 493
ret eq r 0
end

fn lf_read b edit uchar * to long
fd = fopen lpa 0 get lpn 0 0 0
if lt fd 0
ret fd
end
t = ulong 0
for it ulong 1000000
if ge t len b
break
end
n = read int fd b t sub len b t
if le n 0
break
end
t = add t ulong n
end
r = fclose int fd
ret long t
end

fn lf_wb b view uchar * to bool
fd = lf_creat
if lt fd 0
ret false
end
t = ulong 0
for it ulong 100000
if ge t len b
break
end
n = write int fd b t sub len b t
if le n 0
break
end
t = add t ulong n
end
r = fclose int fd
ret eq t len b
end

fn lf_wx i ulong s ulong to bool
q = add mul i 17 s
o = mul q 4096
m = get ltxl q
fd = lf_creat
if lt fd 0
ret false
end
t = ulong 0
for it ulong 100000
if ge t m
break
end
n = write int fd ltx add o t sub m t
if le n 0
break
end
t = add t ulong n
end
r = fclose int fd
ret eq t m
end

fn lt_hd v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

fn lt_hex g view uchar 32 to void
for i ulong 32
v = ulong get g i
put lhx mul i 2 lt_hd shr v 4
put lhx add mul i 2 1 lt_hd and v 15
end
end

note sha256 of the file at the current path into lhx (hex); its size, or a
note negative error.
fn lf_hash to long
b = new uchar 1048576 0
c = new ulong 40 0
g = new uchar 32 0
fd = fopen lpa 0 get lpn 0 0 0
if lt fd 0
ret fd
end
sha256_init c
t = ulong 0
for it ulong 100000
n = read int fd b 0 1048576
if lt n 0
r = fclose int fd
ret n
end
if eq n 0
break
end
sha256_update c view part b 0 ulong n
t = add t ulong n
end
r = fclose int fd
sha256_final c g
lt_hex g
ret long t
end

fn lt_hxeq a view uchar * to bool
if ne len a 64
ret false
end
for i ulong 64
if ne get lhx i get a i
ret false
end
end
ret true
end

note ======== bytes

fn lt_pfx b view uchar * p ulong a view uchar * to bool
if gt add p len a len b
ret false
end
for i ulong len a
if ne get b add p i get a i
ret false
end
end
ret true
end

fn lt_seq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
ret lt_pfx a 0 b
end

fn lt_b b bool to ulong
if b
ret 1
end
ret 0
end

fn lt_has a view uchar * k view uchar * to bool
if gt len k len a
ret false
end
for i ulong add sub len a len k 1
if lt_pfx a i k
ret true
end
end
ret false
end

fn lt_xeq a view uchar * i ulong s ulong to bool
q = add mul i 17 s
if ne len a get ltxl q
ret false
end
b = mul q 4096
for j ulong len a
if ne get a j get ltx add b j
ret false
end
end
ret true
end

fn lt_kna i ulong w ulong to ulong
t = new ulong 12 0
put t 0 4
put t 1 3
put t 2 70
put t 3 5
put t 4 3
put t 5 71
put t 6 1
put t 7 6
put t 8 72
put t 9 2
put t 10 4
put t 11 70
ret get t add mul i 3 w
end

note ======== processes

fn lt_wst ws view uchar 4 to ulong
st = or ulong get ws 0 shl ulong get ws 1 8
if eq and st 127 0
ret and shr st 8 255
end
ret add 128 and st 127
end

note Run pk in its own process group with stdin /dev/null, stdout ofd and
note stderr efd. The pid, or negative.
fn lt_spawn pk view uchar 4096 pn ulong ofd long efd long to long
dn = fopen ltdnul 0 len ltdnul 0 0
pid = fork
if eq pid 0
r = setpgid 0 0
r = dupfd int ofd 1 0
r = dupfd int efd 2 0
if ge dn 0
r = dupfd int dn 0 0
end
r = execprog pk 0 pn
exit 127
end
if ge dn 0
q = fclose int dn
end
if gt pid 0
q = setpgid int pid int pid
end
ret pid
end

note Wait for pid at most ms; on time out its group is killed, it is reaped
note and the result is 999. Exit code, or 128 + signal; 998 wait failed.
fn lt_wait pid long ms ulong to ulong
ws = new uchar 4 0
dl = add ulong monons mul ms 1000000
for it ulong 100000000
g = waitpid int pid ws 0 4 1
if ne g 0
if lt g 0
ret 998
end
ret lt_wst ws
end
if ge ulong monons dl
r = killpid neg int pid 9
g = waitpid int pid ws 0 4 0
ret 999
end
q = sleepns 20000000
end
ret 998
end

fn lt_pmat a view uchar * to ulong
k = get ll 2
if le len a add k 6
ret 0
end
for i ulong k
if ne get a i get la add 1024 i
ret 0
end
end
if ne get a k 47
ret 0
end
if lt_pfx a add k 1 ltinfw
if eq get a add k 6 0
put linf 0 add get linf 0 1
end
end
ret 1
end

fn lt_pent d view uchar 32768 p ulong to ulong
b = new uchar 512 0
pid = ulong 0
k = ulong 0
for i ulong 24
ch = ulong get d add add p 19 i
if eq ch 0
break
end
if or lt ch 48 gt ch 57
ret 0
end
pid = add mul pid 10 sub ch 48
k = add k 1
end
if or eq k 0 eq pid get lpid 0
ret 0
end
put lpn 0 0
lp_t ltproc
lp_c 47
lp_n pid
lp_t ltcmdl
fd = fopen lpa 0 get lpn 0 0 0
if lt fd 0
ret 0
end
n = read int fd b 0 512
r = fclose int fd
if le n 0
ret 0
end
ret lt_pmat view part b 0 ulong n
end

note Processes (other than this one) whose argv0 is NODE/..., counted from
note /proc; linf: those that are NODE/infer.
fn lt_procs to ulong
d = new uchar 32768 0
put linf 0 0
put lpn 0 0
lp_t ltproc
fd = fopen lpa 0 get lpn 0 16384 0
if lt fd 0
ret 99999
end
c = ulong 0
for it ulong 10000
n = getdnts int fd d 0 32768
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 100000
w = or ulong get d add p 16 shl ulong get d add p 17 8
if eq w 0
break
end
c = add c lt_pent d p
p = add p w
end
end
r = fclose int fd
ret c
end

fn lt_left ms ulong to ulong
c = lt_procs
for it ulong 10000
if or eq c 0 ge mul it 100 ms
ret c
end
q = sleepns 100000000
c = lt_procs
end
ret c
end

note ======== round40 selection

fn lt_mem src view uchar 524288 tape view uint 131072 t ulong key view uchar * to ulong
if eq t jsnone
ret jsnone
end
if ne js_type tape t jsobj
ret jsnone
end
k = js_first tape t
for it ulong 100000
if eq k jsnone
ret jsnone
end
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end

fn lt_isp src view uchar 524288 tape view uint 131072 p ulong i ulong to bool
if eq p jsnone
ret false
end
if ne js_type tape p jsstr
ret false
end
o = js_off tape p
if eq i 0
ret js_streq src o ltj0
end
if eq i 1
ret js_streq src o ltj1
end
if eq i 2
ret js_streq src o ltj2
end
ret js_streq src o ltj3
end

note The first record whose job.path is objective i's file.
fn lt_find src view uchar 524288 tape view uint 131072 i ulong to ulong
if ne js_type tape 0 jsarr
ret jsnone
end
e = js_first tape 0
for it ulong 100000
if eq e jsnone
ret jsnone
end
j = lt_mem src tape e ltkjob
p = lt_mem src tape j ltkpath
if lt_isp src tape p i
ret e
end
e = js_enext tape e
end
ret jsnone
end

fn lt_sto src view uchar 524288 tape view uint 131072 t ulong i ulong s ulong to bool
ob = new uchar 4096 0
if eq t jsnone
ret false
end
if ne js_type tape t jsstr
ret false
end
r = js_sget src js_off tape t ob
if lt r 0
ret false
end
b = mul add mul i 17 s 4096
for j ulong ulong r
put ltx add b j get ob j
end
put ltxl add mul i 17 s ulong r
ret true
end

note job.<key> is the number lt_kna (iw / 3, iw % 3).
fn lt_kv src view uchar 524288 tape view uint 131072 j ulong key view uchar * iw ulong to bool
x = lt_mem src tape j key
if eq x jsnone
ret false
end
if ne js_type tape x jsnum
ret false
end
ret eq js_tou src js_off tape x lt_kna div iw 3 rem iw 3
end

fn lt_kchk src view uchar 524288 tape view uint 131072 j ulong i ulong to ulong
x = lt_mem src tape j ltkkind
if eq x jsnone
ret 30
end
if ne js_type tape x jsstr
ret 30
end
if not js_streq src js_off tape x ltloop
ret 30
end
if not lt_kv src tape j ltkk mul i 3
ret 31
end
if not lt_kv src tape j ltkn add mul i 3 1
ret 32
end
if not lt_kv src tape j ltka add mul i 3 2
ret 33
end
ret 0
end

fn lt_rec src view uchar 524288 tape view uint 131072 e ulong i ulong to ulong
j = lt_mem src tape e ltkjob
if not lt_sto src tape lt_mem src tape j ltkbrk i 0
ret 20
end
if not lt_sto src tape lt_mem src tape j ltkcor i 1
ret 21
end
if not lt_sto src tape lt_mem src tape j ltkflt i 2
ret 22
end
u = lt_mem src tape e ltkturn
if eq u jsnone
ret 23
end
if ne js_type tape u jsarr
ret 23
end
c = ulong 0
t = js_first tape u
for it ulong 8
if eq t jsnone
break
end
if ge c 7
ret 24
end
if not lt_sto src tape lt_mem src tape t ltkprm i add 3 c
ret 25
end
if not lt_sto src tape lt_mem src tape t ltkraw i add 10 c
ret 26
end
c = add c 1
t = js_enext tape t
end
put ltnt i c
ps = lt_mem src tape e ltkpass
put ltps i 0
if ne ps jsnone
if eq js_type tape ps jstrue
put ltps i 1
end
end
ret lt_kchk src tape j i
end

note Load the four objectives' records: 0, or where it failed.
fn lt_sel to ulong
src = new uchar 524288 0
tape = new uint 131072 0
put lpn 0 0
lp_a 6
n = lf_read src
if or le n 0 ge n 524288
ret 1
end
r = js_init tape 524288 64
if lt r 0
ret 2
end
r = js_parse src tape ulong n
if lt r 0
ret 3
end
for i ulong 4
e = lt_find src tape i
if eq e jsnone
ret add 10 i
end
x = lt_rec src tape e i
if ne x 0
ret x
end
end
ret 0
end

fn lt_selr s ulong to void
if eq s 0
for i ulong 4
lo_t ltsel
lo_c 32
lo_n i
lo_c 32
put lpn 0 0
lp_o i
lo_p
lo_kv ltturns get ltnt i
lo_w ltfaultw
lo_c 32
lo_xs i 2
lo_kv ltpassw get ltps i
lo_kv ltbrkb get ltxl mul i 17
lo_kv ltcorb get ltxl add mul i 17 1
lo_e
end
end
lo_kv lterrw s
lt_res lt_ok eq s 0 ltcsel
end

note ======== output parsing (code-main / code-test frames and lines)

fn lt_pclr to void
for i ulong 80
put lcw i 0
end
end

fn lt_inc k ulong to void
put lcw k add get lcw k 1
end

fn lt_num b view uchar * p ulong to ulong
v = ulong 0
q = p
for it ulong 24
if ge q len b
break
end
c = ulong get b q
if or lt c 48 gt c 57
break
end
v = add mul v 10 sub c 48
q = add q 1
end
put lcu 0 add q 1
ret v
end

fn lt_eol b view uchar * n ulong p ulong to ulong
q = p
for it ulong 1000000
if ge q n
ret n
end
if eq get b q 10
ret q
end
q = add q 1
end
ret n
end

fn lt_tcmp b view uchar * s ulong m ulong i ulong w ulong to void
o = mul i 16
ci = add o add 4 w
k = get lcw ci
lt_inc ci
if ge k 7
ret
end
if lt_xeq view part b s m i add add 3 mul w 7 k
lt_inc add o add 6 w
end
end

fn lt_frm b view uchar * n ulong p ulong w ulong to ulong
i = lt_num b add p 4
t = lt_num b get lcu 0
m = lt_num b get lcu 0
s = get lcu 0
if gt add add s m 1 n
ret p
end
if lt i 4
lt_tcmp b s m i w
end
ret add add s m 1
end

fn lt_cwe b view uchar * p ulong to void
i = lt_num b add p 4
id = lt_num b get lcu 0
ev = lt_num b get lcu 0
v = lt_num b get lcu 0
if ge i 4
ret
end
o = mul i 16
lt_inc add o 12
if and eq ev 1 eq v 4
lt_inc add o 8
end
if and eq ev 4 eq rem id 10 4
lt_inc add o 9
end
if and and eq ev 1 eq v 1 gt get lcw add o 9 0
lt_inc add o 10
end
if eq ev 5
lt_inc add o 11
end
end

fn lt_cwo b view uchar * p ulong to void
i = lt_num b add p 4
q = get lcu 0
ok = lt_pfx b q ltpass
r = lt_num b add q 5
t = lt_num b get lcu 0
if ge i 4
ret
end
o = mul i 16
lt_inc o
if ok
put lcw add o 1 1
end
put lcw add o 2 r
put lcw add o 3 t
end

fn lt_cws b view uchar * p ulong to void
a = lt_num b add p 11
c = lt_num b add get lcu 0 5
lt_inc 64
put lcw 65 a
put lcw 66 c
end

note One complete line (or frame) at p: the position after it, or p when it
note is not complete yet.
fn lt_line b view uchar * n ulong p ulong to ulong
e = lt_eol b n p
if ge e n
ret p
end
if lt_pfx b p ltcwp
ret lt_frm b n p 0
end
if lt_pfx b p ltcwr
ret lt_frm b n p 1
end
if lt_pfx b p ltcwe
lt_cwe b p
end
if lt_pfx b p ltcwo
lt_cwo b p
end
if lt_pfx b p ltcws
lt_cws b p
end
ret add e 1
end

fn lt_parse b view uchar * n ulong to void
lt_pclr
p = ulong 0
for it ulong 1000000
if ge p n
ret
end
q = lt_line b n p
if eq q p
ret
end
p = q
end
end

fn lt_rd x ulong oi ulong to ulong
b = new uchar 1048576 0
lp_x x
lp_c 47
lp_on oi 0
n = lf_read b
if le n 0
lt_pclr
ret 0
end
lt_parse b ulong n
ret ulong n
end

note ======== journal v2 reader

fn lj_dec b view uchar 128 r edit ulong 16 k ulong to void
for w ulong k
v = ulong 0
for j ulong 8
v = or v shl ulong get b add mul w 8 j mul j 8
end
put r w v
end
end

fn lj_sum r view ulong 16 n ulong to ulong
h = ulong 14695981039346656037
for i ulong n
v = get r i
for j ulong 8
h = mul xor h and shr v mul j 8 255 1099511628211
end
end
ret h
end

fn lj_hdr r view ulong 16 to bool
for i ulong 4
put ljs add 24 i get r add 3 i
end
s = and eq get r 0 5786624599 eq get r 1 2
s = and s eq get r 2 128
ret and s eq get r 7 lj_sum r 7
end

fn lj_meq r view ulong 16 e ulong to bool
for i ulong 4
if ne get ljo add e i get r add 3 i
ret false
end
end
ret true
end

fn lj_op r view ulong 16 d ulong to void
k = get ljn 0
for q ulong get ljn 0 bound 1024
e = mul q 12
if lj_meq r e
k = q
break
end
end
if eq k get ljn 0
if ge k 1024
put ljs 11 add get ljs 11 1
ret
end
for i ulong 12
put ljo add mul k 12 i 0
end
for i ulong 4
put ljo add mul k 12 i get r add 3 i
end
put ljn 0 add k 1
end
e = mul k 12
if eq d 0
put ljo add e 4 add get ljo add e 4 1
put ljo add e 6 get r 2
put ljo add e 10 get r 8
put ljo add e 11 get r 7
else
put ljo add e 5 add get ljo add e 5 1
put ljo add e 7 get r 2
put ljo add e 8 get r 7
put ljo add e 9 get r 9
end
end

fn lj_cnt k ulong to void
put ljs k add get ljs k 1
end

fn lj_one r view ulong 16 to void
lj_cnt 0
if ne get r 15 lj_sum r 15
lj_cnt 11
end
if ne get r 1 get ljs 0
lj_cnt 11
end
ty = get r 0
f = get r 2
if eq ty 1
lj_cnt 1
if le f get ljs 28
lj_cnt 17
end
put ljs 28 f
if ne get r 5 3
lj_cnt 16
end
else
if ne f get ljs 28
lj_cnt 17
end
end
if eq ty 2
lj_cnt 4
end
if eq ty 3
lj_cnt 2
lj_op r 0
end
if eq ty 4
lj_cnt 3
lj_op r 1
end
if eq ty 5
lj_cnt 5
end
if eq ty 8
lj_cnt 6
end
if eq ty 11
lj_cnt 7
end
if eq ty 12
lj_cnt 8
end
if eq ty 13
lj_cnt 9
end
if or or eq ty 6 eq ty 7 or eq ty 10 gt ty 13
lj_cnt 10
end
end

note Read and validate DIR/journal of scenario x: 0, or 1 not opened, 2 no
note header. Summary: ljs 0 records, 1 OPEN, 2 START, 3 DONE, 4 ADMIT,
note 5 RELEASE, 6 CANCEL, 7 POLICY, 8 GOAL, 9 FAIR, 10 other types, 11 bad
note (header, checksum, seq, torn), 12 max starts per operation, 13 starts
note of replace operations, 14 operations started and never done, 15
note operations done under a later fence than they started (settled by a
note restart), 16 OPEN with another SPVER, 17 fence errors, 18 operations,
note 24..27 objective identity, 28 current fence.
fn lj_scan x ulong to ulong
b = new uchar 128 0
r = new ulong 16 0
for i ulong 32
put ljs i 0
end
put ljn 0 0
lp_x x
lp_t ltjfl
fd = fopen lpa 0 get lpn 0 0 0
if lt fd 0
ret 1
end
n = read int fd b 0 64
if ne n 64
q = fclose int fd
ret 2
end
lj_dec b r 8
if not lj_hdr r
lj_cnt 11
end
for it ulong 1000000
n = read int fd b 0 128
if eq n 0
break
end
if ne n 128
lj_cnt 11
break
end
lj_dec b r 16
lj_one r
end
q = fclose int fd
ret 0
end

fn lj_fin to void
put ljs 18 get ljn 0
for k ulong get ljn 0 bound 1024
e = mul k 12
s = get ljo add e 4
if gt s get ljs 12
put ljs 12 s
end
if eq rem get ljo add e 10 10 4
put ljs 13 add get ljs 13 s
end
if and gt s 0 eq get ljo add e 5 0
lj_cnt 14
end
f = ne get ljo add e 6 get ljo add e 7
if and f and gt get ljo add e 5 0 gt s 0
lj_cnt 15
end
end
end

fn lj_pr r ulong to void
lo_kv lterrw r
lo_kv ltrecs get ljs 0
lo_kv ltopens get ljs 1
lo_kv ltadm get ljs 4
lo_kv ltstw get ljs 2
lo_kv ltdnw get ljs 3
lo_kv ltrel get ljs 5
lo_kv ltcanw get ljs 6
lo_kv ltpol get ljs 7
lo_kv ltgoal get ljs 8
lo_kv ltfair get ljs 9
lo_kv ltoth get ljs 10
lo_kv ltbad get ljs 11
lo_kv ltops get ljs 18
lo_kv ltmax get ljs 12
lo_kv ltreps get ljs 13
lo_kv ltopen get ljs 14
lo_kv ltsetl get ljs 15
lo_kv ltspv get ljs 16
lo_kv ltfnc get ljs 17
lo_kv ltidt get ljs 24
for i ulong 3
lo_c 44
lo_n get ljs add 25 i
end
end

fn lj_ops x ulong to void
for k ulong get ljn 0 bound 1024
e = mul k 12
lo_t ltjop
lo_c 32
lo_x x
lo_w ltop
lo_kv ltkjob get ljo add e 10
lo_kv ltcls get ljo add e 11
for i ulong 4
lo_c 32
lo_n get ljo add e i
end
lo_kv ltstw get ljo add e 4
lo_kv ltdnw get ljo add e 5
lo_kv ltfncw get ljo add e 6
lo_c 47
lo_n get ljo add e 7
lo_kv ltoutc get ljo add e 8
lo_kv lthow get ljo add e 9
lo_e
end
end

note The journal checks every scenario shares: readable and intact, every
note OPEN under SPVER 3, fences increasing, no POLICY record (the default
note policy sched_new set was never changed), the expected OPEN count, every
note operation started exactly once and done, and the objective identity
note (tag OMNC, count no, issue 290). The detail goes to the line buffer.
fn lt_cj x ulong opens ulong no ulong to bool
r = lj_scan x
lj_fin
lj_pr r
s = eq r 0
s = and s and eq get ljs 11 0 eq get ljs 16 0
s = and s and eq get ljs 17 0 eq get ljs 7 0
s = and s and eq get ljs 1 opens eq get ljs 12 1
s = and s eq get ljs 14 0
s = and s eq get ljs 24 1330466371
s = and s and eq get ljs 25 no eq get ljs 27 290
ret s
end


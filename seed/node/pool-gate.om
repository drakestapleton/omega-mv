note Omega Node transport, concatenate with a program-mode consumer.
note Trusted forked processes only. This is transport, not write authority.
note One publisher PID, 64 immutable records per epoch; reuse only via node_reset.
note Layout: 4096 byte header then 64 slots of 4160 bytes.
note Header u64: magic, ABI, published count, stop, publisher PID, epoch.
note Slot u64: version, length, topic mask; payload begins at offset 64.
const NCAP ulong 64
const NBYTES ulong 270336
const NMAGIC ulong 1313817669

fn node_new to long
h = mapnew neg int 1 0 NBYTES 3 33
if le h 0
ret h
end
r = mapset h 8 8 1
r = mapset h 32 8 ulong getpid
r = mapset h 0 8 NMAGIC
ret h
end

fn node_valid h long to bool
ret and eq mapget h 0 8 NMAGIC eq mapget h 8 8 1
end

fn node_offset v ulong to ulong
ret add 4096 mul sub v 1 4160
end

note Return version, or -1 stopped, -2 full, -3 length, -4 topic,
note -5 invalid header, -6 wrong publisher. Refusals do not publish.
fn node_publish h long topics ulong src view uchar 4096 n ulong to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
if ne mapget h 24 8 0
ret neg long 1
end
if gt n 4096
ret neg long 3
end
if eq topics 0
ret neg long 4
end
v = mapget h 16 8
if gt v NCAP
ret neg long 5
end
if eq v NCAP
ret neg long 2
end
v = add v 1
off = node_offset v
r = mapwrite h add off 64 src 0 n
r = mapset h add off 8 8 n
r = mapset h add off 16 8 topics
note mapset has barriers before and after its aligned store.
r = mapset h off 8 v
r = mapset h 16 8 v
ret long v
end

note Header and record checks precede copying. No partial publication is read.
note Returns payload length, -5 invalid header/record, -7 unavailable version.
fn node_read h long v ulong dst edit uchar 4096 to long
if not node_valid h
ret neg long 5
end
if or eq v 0 gt v NCAP
ret neg long 7
end
latest = mapget h 16 8
if gt latest NCAP
ret neg long 5
end
if gt v latest
ret neg long 7
end
off = node_offset v
if ne mapget h off 8 v
ret neg long 5
end
n = mapget h add off 8 8
if gt n 4096
ret neg long 5
end
ret mapread h add off 64 dst 0 n
end

note Return the next matching version after cursor, zero if caught up,
note or negative refusal. Caller advances its cursor through returned versions.
fn node_next h long cursor ulong topics ulong to long
if not node_valid h
ret neg long 5
end
if or gt cursor NCAP eq topics 0
ret neg long 7
end
latest = mapget h 16 8
if or gt latest NCAP gt cursor latest
ret neg long 5
end
v = cursor
note At most NCAP published slots can be examined.
while lt v latest bound 64
v = add v 1
off = node_offset v
if ne mapget h off 8 v
ret neg long 5
end
if ne and mapget h add off 16 8 topics 0
ret long v
end
end
ret 0
end

fn node_stop h long to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
ret mapset h 24 8 1
end

note Creator only. Retire every record so a pool can reuse the arena for a new
note epoch. The caller must first prove no reader holds the old epoch (pool.om).
note The count drops to zero before any record version is cleared.
fn node_reset h long epoch ulong to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
if eq epoch 0
ret neg long 7
end
r = mapset h 16 8 0
for i ulong NCAP
r = mapset h node_offset add i 1 8 0
end
r = mapset h 24 8 0
r = mapset h 40 8 epoch
ret 0
end

fn node_epoch h long to ulong
ret mapget h 40 8
end

note One nonblocking eventfd per consumer. Saturation means already readable.
note Interrupted operations retry at most 64 times, then return EINTR.
fn node_notify fd int to long
buf = new uchar 8 0
put buf 0 1
for i ulong 64
r = write fd buf 0 8
if eq r 8
ret 0
end
if eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn node_drain fd int to long
buf = new uchar 8 0
for i ulong 64
r = read fd buf 0 8
if or eq r 8 eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn node_pollfd p edit uchar 16 off ulong fd int to void
for i ulong 4
put p add off i uchar and shr uint fd uint mul i 8 255
end
put p add off 4 1
end

note Returns 2 stop, 1 wake, 0 timeout or negative errno.
note Control takes priority when both descriptors are ready.
note EINTR returns to caller so it can recompute its monotonic deadline.
fn node_wait h long wake int stop int interval long to long
p = new uchar 16 0
if not node_valid h
ret neg long 5
end
if or lt wake 0 lt stop 0
ret neg long 9
end
if eq wake stop
ret neg long 22
end
if ne mapget h 24 8 0
ret 2
end
node_pollfd p 0 wake
node_pollfd p 8 stop
r = pollfds p 0 16 interval
if lt r 0
ret r
end
if ne mapget h 24 8 0
ret 2
end
if ne and get p 14 56 0
ret neg long 5
end
if ne and get p 14 1 0
r = node_drain stop
if lt r 0
ret r
end
ret 2
end
if ne and get p 6 56 0
ret neg long 5
end
if ne and get p 6 1 0
r = node_drain wake
if lt r 0
ret r
end
ret 1
end
ret 0
end
note Omega Node epoch pool. Concatenate after transport.om, before super.om.
note K arenas (1..8) and one control page are mapped before any worker fork,
note so every forked worker inherits the same shared mappings.
note Single writer: the creator writes the current epoch, the arena table and
note every arena record. Worker w alone writes hold word w while it lives;
note the creator clears hold w only after it has reaped worker w.
note Control u64: 0 magic, 8 ABI, 16 current epoch, 24 stop, 32 creator PID,
note 40 arena count K, 48 worker slots W, 64+8k arena handle k,
note 128+8k epoch of arena k (0 free), 256+8w hold of worker w (0 none),
note 768+8w worker PID, 1280+8w worker state (0 empty, 1 live, 2 reaped).
const PMAGIC ulong 1347374924
const PCAP ulong 8
const PWCAP ulong 64
const PBYTES ulong 4096

fn pool_valid c long to bool
ret and eq mapget c 0 8 PMAGIC eq mapget c 8 8 1
end

fn pool_mine c long to bool
ret eq mapget c 32 8 ulong getpid
end

fn pool_arena c long k ulong to long
ret long mapget c add 64 mul k 8 8
end

note Drop the first n arenas and the control page of a pool being refused.
fn pool_unwind c long n ulong to long
for i ulong n bound 8
r = mapdrop pool_arena c i
end
ret mapdrop c
end

note Return the control handle, or -7 bad size, or a negative mapping errno.
note Arena 0 starts as epoch 1. Call before forking any worker.
fn pool_new k ulong w ulong to long
if or eq k 0 gt k PCAP
ret neg long 7
end
if or eq w 0 gt w PWCAP
ret neg long 7
end
c = mapnew neg int 1 0 PBYTES 3 33
if le c 0
ret c
end
r = mapset c 32 8 ulong getpid
r = mapset c 40 8 k
r = mapset c 48 8 w
for i ulong k bound 8
h = node_new
if le h 0
r = pool_unwind c i
ret h
end
r = mapset c add 64 mul i 8 8 ulong h
end
r = node_reset pool_arena c 0 1
r = mapset c 128 8 1
r = mapset c 16 8 1
r = mapset c 8 8 1
r = mapset c 0 8 PMAGIC
ret c
end

note Arena index holding epoch e, or -5 when no arena holds it.
fn pool_slot c long e ulong to long
k = mapget c 40 8
if gt k PCAP
ret neg long 5
end
for i ulong k bound 8
if eq mapget c add 128 mul i 8 8 e
ret long i
end
end
ret neg long 5
end

note Creator: the arena of the current epoch, or a negative refusal.
fn pool_current c long to long
if not pool_valid c
ret neg long 5
end
k = pool_slot c mapget c 16 8
if lt k 0
ret k
end
ret pool_arena c ulong k
end

fn pool_epoch c long to ulong
ret mapget c 16 8
end

note Worker step: store hold e for worker w, then read the epoch again. mapset
note and mapget fence both sides, so a creator that moved the epoch before it
note scanned holds either sees this hold or this read sees the move. Returns
note the arena of e, -8 when the epoch moved, or -5 when no arena holds e.
note Every refusal clears the hold.
fn pool_hold c long w ulong e ulong to long
if ge w mapget c 48 8
ret neg long 7
end
hw = add 256 mul w 8
r = mapset c hw 8 e
if ne mapget c 16 8 e
r = mapset c hw 8 0
ret neg long 8
end
k = pool_slot c e
if lt k 0
r = mapset c hw 8 0
ret k
end
h = pool_arena c ulong k
if ne node_epoch h e
r = mapset c hw 8 0
ret neg long 5
end
ret h
end

note Worker w holds the current epoch and returns its arena. Returns -1
note stopped, -5 invalid, -7 bad worker, -8 the epoch kept moving.
fn pool_acquire c long w ulong to long
if not pool_valid c
ret neg long 5
end
if ge w mapget c 48 8
ret neg long 7
end
for t ulong 16
if ne mapget c 24 8 0
r = mapset c add 256 mul w 8 8 0
ret neg long 1
end
h = pool_hold c w mapget c 16 8
if ne h neg long 8
ret h
end
end
ret neg long 8
end

note Worker w gives up its hold. Its old arena must not be read afterwards.
fn pool_release c long w ulong to long
if ge w mapget c 48 8
ret neg long 7
end
ret mapset c add 256 mul w 8 8 0
end

fn pool_held c long e ulong to bool
n = mapget c 48 8
for w ulong n bound 64
if eq mapget c add 256 mul w 8 8 e
ret true
end
end
ret false
end

note Creator step: retire arena i and open epoch n in it, then publish n.
fn pool_reuse c long i ulong n ulong to long
off = add 128 mul i 8
r = mapset c off 8 0
r = node_reset pool_arena c i n
if lt r 0
ret r
end
r = mapset c off 8 n
r = mapset c 16 8 n
ret long n
end

note Creator step: an arena that is free or whose older epoch no worker holds,
note or -9. Call only after the current epoch has moved past that arena.
fn pool_pick c long to long
e = mapget c 16 8
k = mapget c 40 8
for i ulong k bound 8
ek = mapget c add 128 mul i 8 8
if ne ek e
if or eq ek 0 not pool_held c ek
ret long i
end
end
end
ret neg long 9
end

note Creator: open the next epoch in a free or unheld arena and make it current.
note Returns the new epoch, -1 stopped, -5 invalid, -6 not creator, or -9 when
note every other arena is still held: the pool fails closed, nothing changes.
fn pool_roll c long to long
if not pool_valid c
ret neg long 5
end
if not pool_mine c
ret neg long 6
end
if ne mapget c 24 8 0
ret neg long 1
end
k = pool_pick c
if lt k 0
ret k
end
ret pool_reuse c ulong k add mapget c 16 8 1
end

note Creator: publish to the current epoch; when it is full, roll once and retry.
note Returns the version, or the refusal of the publish or of the roll.
fn pool_publish c long topics ulong src view uchar 4096 n ulong to long
h = pool_current c
if lt h 0
ret h
end
v = node_publish h topics src n
if ne v neg long 2
ret v
end
r = pool_roll c
if lt r 0
ret r
end
h = pool_current c
if lt h 0
ret h
end
ret node_publish h topics src n
end

fn pool_stop c long to long
if not pool_valid c
ret neg long 5
end
if not pool_mine c
ret neg long 6
end
ret mapset c 24 8 1
end

fn pool_stopped c long to bool
ret ne mapget c 24 8 0
end

note Creator: record worker w's PID and state for observers.
fn pool_setw c long w ulong pid ulong st ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
r = mapset c add 768 mul w 8 8 pid
ret mapset c add 1280 mul w 8 8 st
end

note Creator: clear hold w. Only after worker w has been reaped.
fn pool_clear c long w ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
ret mapset c add 256 mul w 8 8 0
end

note Drop every mapping of the pool in this process. Other processes keep
note their own inherited mappings until they drop them or exit.
fn pool_free c long to long
ret pool_unwind c mapget c 40 8
end
note Omega Node worker supervision. Concatenate after transport.om and pool.om.
note The creator forks trusted workers from its own binary: sup_spawn returns 0
note in the child, which runs its worker function and exits with its result.
note Death is seen without polling PIDs. Worker w alone holds the write end of
note its close-on-exec life pipe, so its exit hangs up the creator's read end.
note Every worker holds the read end of the creator's life pipe, whose only
note writer is the creator, so creator death hangs up every worker.
note Per worker: wake, stop and ack eventfds, kept across respawns.
note Workers must not exec: exec closes the life pipe and reads as death.
global swpid long 64
global swwake int 64
global swstop int 64
global swack int 64
global swlife int 64
global swst ulong 64
global swpw ulong 64
global swpar int 2
global swme ulong 1
global swws uchar 4
global swpf uchar 8
global swpoll uchar 1024

fn sup_fd off ulong to int
v = ulong get swpf off
v = or v shl ulong get swpf add off 1 8
v = or v shl ulong get swpf add off 2 16
v = or v shl ulong get swpf add off 3 24
ret int v
end

note Poll record j at swpoll offset off; a negative fd is stored as itself
note (bit pattern) so the kernel ignores that record.
fn sup_gpfd off ulong fd int to void
u = bitcast uint fd
for i ulong 4
put swpoll add off i uchar and shr u uint mul i 8 255
end
put swpoll add off 4 1
put swpoll add off 5 0
put swpoll add off 6 0
put swpoll add off 7 0
end

fn sup_lpfd p edit uchar 24 off ulong fd int to void
for i ulong 4
put p add off i uchar and shr uint fd uint mul i 8 255
end
put p add off 4 1
end

note Read and reset an eventfd counter: the number of hints since the last
note take, 0 when none is pending, or a negative errno.
fn sup_take fd int to long
buf = new uchar 8 0
for i ulong 64
r = read fd buf 0 8
if eq r 8
v = ulong 0
for j ulong 8
v = or v shl ulong get buf j mul j 8
end
ret long and v 9223372036854775807
end
if eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn sup_closeall to void
for i ulong 64
if ge get swwake i 0
r = fclose get swwake i
end
if ge get swstop i 0
r = fclose get swstop i
end
if ge get swack i 0
r = fclose get swack i
end
if ge get swlife i 0
r = fclose get swlife i
end
put swwake i neg int 1
put swstop i neg int 1
put swack i neg int 1
put swlife i neg int 1
end
for i ulong 2
if ge get swpar i 0
r = fclose get swpar i
end
put swpar i neg int 1
end
end

note Creator: create the creator life pipe and three eventfds per worker slot.
note Call once after pool_new and before sup_spawn. 0 or a negative errno;
note a failure closes everything this call opened.
fn sup_init c long to long
if not pool_mine c
ret neg long 6
end
for i ulong 64
put swpid i 0
put swst i 0
put swwake i neg int 1
put swstop i neg int 1
put swack i neg int 1
put swlife i neg int 1
end
put swme 0 0
put swpar 0 neg int 1
put swpar 1 neg int 1
r = pipefds swpf 0 8 524288
if lt r 0
ret r
end
put swpar 0 sup_fd 0
put swpar 1 sup_fd 4
n = mapget c 48 8
for i ulong n bound 64
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swwake i int a
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swstop i int a
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swack i int a
end
ret 0
end

note Creator: fork worker w. Returns 0 in the child, the child PID in the
note creator, -7 bad slot, -16 slot still live, or a negative errno. The
note child keeps only its own life write end; the creator keeps the read end.
fn sup_spawn c long w ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
if ne get swpid w 0
ret neg long 16
end
r = pipefds swpf 0 8 524288
if lt r 0
ret r
end
rd = sup_fd 0
wr = sup_fd 4
pid = fork
if eq pid 0
r = fclose get swpar 1
put swpar 1 neg int 1
r = fclose rd
put swlife w wr
put swme 0 add w 1
ret 0
end
r = fclose wr
if lt pid 0
r = fclose rd
ret pid
end
put swpid w pid
put swlife w rd
r = pool_setw c w ulong pid 1
ret pid
end

note Worker: 3 creator gone, 2 stop, 1 wake hint, 0 timeout, negative errno.
note Creator loss outranks stop, which outranks work. A set stop flag makes
note the poll nonblocking. Hints are drained; rescan shared state after 1.
fn sup_wwait c long w ulong interval long to long
p = new uchar 24 0
if ge w 64
ret neg long 7
end
iv = interval
if pool_stopped c
iv = 0
end
sup_lpfd p 0 get swwake w
sup_lpfd p 8 get swstop w
sup_lpfd p 16 get swpar 0
r = pollfds p 0 24 iv
if lt r 0
ret r
end
if ne get p 22 0
ret 3
end
if pool_stopped c
ret 2
end
if ne and get p 14 56 0
ret neg long 5
end
if ne and get p 14 1 0
r = node_drain get swstop w
ret 2
end
if ne and get p 6 56 0
ret neg long 5
end
if ne and get p 6 1 0
r = node_drain get swwake w
if lt r 0
ret r
end
ret 1
end
ret 0
end

note Worker or creator: post a hint on worker w's ack eventfd.
fn sup_ack w ulong to long
if ge w 64
ret neg long 7
end
ret node_notify get swack w
end

note Creator: wake worker w with a work hint.
fn sup_wake w ulong to long
if ge w 64
ret neg long 7
end
if le get swpid w 0
ret neg long 3
end
ret node_notify get swwake w
end

fn sup_live c long to ulong
n = mapget c 48 8
k = ulong 0
for w ulong n bound 64
if gt get swpid w 0
k = add k 1
end
end
ret k
end

note Creator: reap worker w, then release what it held. A worker that has not
note exited within about one second gets SIGKILL first. Only after the exact
note PID is reaped are its hold, PID and life pipe released. Returns the raw
note wait status, -3 no live worker, or the waitpid errno (nothing released).
fn sup_reap c long w ulong to long
if ge w 64
ret neg long 7
end
pid = get swpid w
if le pid 0
ret neg long 3
end
done = false
for t ulong 100
r = waitpid int pid swws 0 4 1
if eq r pid
done = true
break
end
if ne r 0
ret r
end
r = sleepns 10000000
end
if not done
r = killpid int pid 9
r = waitpid int pid swws 0 4 0
if ne r pid
ret r
end
end
st = ulong get swws 0
st = or st shl ulong get swws 1 8
put swst w st
r = fclose get swlife w
put swlife w neg int 1
put swpid w 0
r = pool_clear c w
r = pool_setw c w 0 2
ret long st
end

note Creator: wait up to interval ns for deaths and, when acks is true, acks.
note Ack counts are left pending for sup_take. Every worker whose life pipe
note hung up is reaped. Returns the number reaped, or a negative errno.
fn sup_pollx c long interval long acks bool to long
n = mapget c 48 8
m = ulong 0
for w ulong n bound 64
if gt get swpid w 0
o = mul m 16
if acks
sup_gpfd o get swack w
else
sup_gpfd o neg int 1
end
sup_gpfd add o 8 get swlife w
put swpw m w
m = add m 1
end
end
if eq m 0
ret 0
end
r = pollfds swpoll 0 mul m 16 interval
if lt r 0
ret r
end
dead = long 0
for j ulong m bound 64
o = add mul j 16 14
if ne get swpoll o 0
r = sup_reap c get swpw j
if lt r 0
ret r
end
dead = add dead 1
end
end
ret dead
end

note Creator: wait up to interval ns for acks and deaths (see sup_pollx).
fn sup_poll c long interval long to long
ret sup_pollx c interval true
end

note Creator: stop admission, post every live worker's stop eventfd, then reap
note until all have exited or interval ns pass; survivors get SIGKILL and are
note reaped. Returns how many had to be killed, or a refusal.
fn sup_stop c long interval long to long
r = pool_stop c
if lt r 0
ret r
end
n = mapget c 48 8
for w ulong n bound 64
if gt get swpid w 0
r = node_notify get swstop w
end
end
dl = add monons interval
for t ulong 100000
if eq sup_live c 0
ret 0
end
now = monons
if ge now dl
break
end
r = sup_pollx c sub dl now false
if lt r 0
if ne r neg long 4
break
end
end
end
killed = long 0
for w ulong n bound 64
if gt get swpid w 0
r = killpid int get swpid w 9
r = sup_reap c w
killed = add killed 1
end
end
ret killed
end
note Concatenate after transport.om, pool.om and super.om. CPU-only acceptance
note of epoch turnover, held old versions, worker death, respawn, orphaning and
note bounded teardown with real forked processes. No GPU, model or network.
text pok "PASS node pool\n"
global ptc long 1
global ptm long 1
global pth long 1
global ptws uchar 4

fn pt_ok ok bool code int to void
if not ok
exit code
end
end

fn pt_fd4 p view uchar 8 off ulong to int
v = ulong get p off
v = or v shl ulong get p add off 1 8
v = or v shl ulong get p add off 2 16
v = or v shl ulong get p add off 3 24
ret int v
end

fn pt_byte e ulong v ulong to uchar
ret uchar and add mul e 16 v 255
end

note Creator: publish n full records into the current epoch, bytes f(epoch, v).
fn pt_fill c long n ulong to bool
buf = new uchar 4096 0
e = pool_epoch c
h = pool_current c
if lt h 0
ret false
end
for k ulong n bound 64
v = add mapget h 16 8 1
b = pt_byte e v
for j ulong 4096
put buf j b
end
if ne pool_publish c 1 buf 4096 long v
ret false
end
end
ret true
end

note 0 when arena h holds exactly n complete records of its own epoch, else a code.
fn pt_verify h long n ulong to int
buf = new uchar 4096 0
e = node_epoch h
cur = ulong 0
cnt = ulong 0
for k ulong 65
v = node_next h cur 1
if eq v 0
break
end
if lt v 0
ret 1
end
cur = ulong v
if ne node_read h cur buf 4096
ret 2
end
b = pt_byte e cur
for j ulong 4096
if ne get buf j b
ret 3
end
end
cnt = add cnt 1
end
if ne cnt n
ret 4
end
ret 0
end

fn pt_refusals to void
pt_ok eq pool_new 0 4 neg long 7 10
pt_ok eq pool_new 9 4 neg long 7 11
pt_ok eq pool_new 2 0 neg long 7 12
pt_ok eq pool_new 2 65 neg long 7 13
c = pool_new 2 4
pt_ok gt c 0 14
pt_ok eq pool_epoch c 1 15
pt_ok eq pool_acquire c 4 neg long 7 16
pt_ok eq pool_release c 4 neg long 7 17
pt_ok eq node_epoch pool_current c 1 18
pt_ok eq node_reset pool_current c 0 neg long 7 19
pt_ok eq pool_free c 0 20
end

note One process: the creator also plays worker slots 0 and 1, whose holds are
note plain words. Epoch numbers never repeat; arenas are reused only unheld.
fn pt_epochs to void
dst = new uchar 4096 0
c = pool_new 2 4
pt_ok gt c 0 21
pt_ok pt_fill c 1 22
h1 = pool_acquire c 0
pt_ok eq h1 pool_current c 23
pt_ok eq mapget c 256 8 1 24
pt_ok eq pool_roll c 2 25
pt_ok ne pool_current c h1 26
pt_ok eq node_next pool_current c 0 1 0 27
pt_ok eq pool_roll c neg long 9 28
pt_ok eq pool_epoch c 2 29
pt_ok eq pt_verify h1 1 0 30
pt_ok eq pool_release c 0 0 31
pt_ok eq pool_roll c 3 32
pt_ok eq pool_slot c 3 0 33
pt_ok eq node_read h1 1 dst neg long 7 34
pt_ok eq node_epoch h1 3 35
pt_ok pt_fill c 64 36
for j ulong 4096
put dst j pt_byte 4 1
end
pt_ok eq pool_publish c 1 dst 4096 1 37
pt_ok eq pool_epoch c 4 38
h4 = pool_acquire c 1
pt_ok eq node_epoch h4 4 39
pt_ok pt_fill c 63 40
pt_ok eq pool_epoch c 4 41
pt_ok eq pool_roll c 5 42
pt_ok pt_fill c 64 43
pt_ok eq pool_publish c 1 dst 1 neg long 9 44
pt_ok eq pool_epoch c 5 45
pt_ok eq pt_verify h4 64 0 46
pt_ok eq pool_stop c 0 47
pt_ok eq pool_roll c neg long 1 48
pt_ok eq pool_acquire c 2 neg long 1 49
pt_ok eq mapget c 272 8 0 50
pt_ok eq pool_free c 0 51
end

note The announce race, made deterministic by running the protocol steps in
note the order that breaks a hold without its recheck: worker 2 read epoch e,
note the creator moved past e and picked e's arena, then worker 2 stores its
note hold. The recheck must refuse; reuse of the arena must then proceed.
fn pt_race to void
c = pool_new 2 4
pt_ok gt c 0 140
pt_ok pt_fill c 1 141
e = pool_epoch c
pt_ok eq pool_roll c 2 142
pt_ok eq pool_pick c 0 143
pt_ok eq pool_hold c 2 e neg long 8 144
pt_ok eq mapget c 272 8 0 145
pt_ok eq pool_reuse c 0 3 3 146
pt_ok eq pool_acquire c 2 pool_current c 147
pt_ok eq pool_hold c 4 3 neg long 7 148
pt_ok eq pool_free c 0 149
end

note Worker phase: 1 acquire and verify, 2 verify the held epoch again,
note 3 release, acquire the current epoch and verify, 4 stall ignoring stop.
fn pt_step c long w ulong ph ulong to int
buf = new uchar 4096 0
m = get ptm 0
n = mapget m 8 8
if eq ph 1
if ne pool_roll c neg long 6
ret 11
end
if ne pool_stop c neg long 6
ret 12
end
if ne pool_clear c w neg long 6
ret 13
end
h = pool_acquire c w
if le h 0
ret 14
end
put pth 0 h
if ne node_publish h 1 buf 1 neg long 6
ret 15
end
ret pt_verify h n
end
if eq ph 2
ret pt_verify get pth 0 mapget m 16 8
end
if eq ph 3
r = pool_release c w
h = pool_acquire c w
if le h 0
ret 16
end
put pth 0 h
ret pt_verify h n
end
if eq ph 4
r = sleepns 30000000000
ret 17
end
ret 18
end

fn pt_worker w ulong to int
c = get ptc 0
m = get ptm 0
put pth 0 0
for it ulong 64
r = sup_wwait c w 5000000000
if eq r 2
if gt get pth 0 0
r = pool_release c w
end
ret 0
end
if eq r 3
ret 41
end
if eq r 0
ret 42
end
if ne r 1
ret 43
end
res = pt_step c w mapget m 0 8
r = mapset m add 64 mul w 8 8 ulong res
if ne sup_ack w 0
ret 44
end
end
ret 45
end

note Creator: wake worker w for phase ph and wait up to about 5 s for its ack.
note Returns the worker's phase result, or 90 no ack, 91 the worker died.
fn pt_phase c long w ulong ph ulong to int
m = get ptm 0
r = mapset m 0 8 ph
r = mapset m add 64 mul w 8 8 99
if ne sup_wake w 0
ret 92
end
for t ulong 500
if gt sup_take get swack w 0
ret int mapget m add 64 mul w 8 8
end
if le get swpid w 0
ret 91
end
r = sup_poll c 10000000
end
ret 90
end

fn pt_spawn c long w ulong to bool
p = sup_spawn c w
if eq p 0
exit pt_worker w
end
ret gt p 0
end

fn pt_procs to void
c = pool_new 2 4
pt_ok gt c 0 52
put ptc 0 c
m = mapnew neg int 1 0 4096 3 33
pt_ok gt m 0 53
put ptm 0 m
pt_ok eq sup_init c 0 54
pt_ok pt_fill c 8 55
r = mapset m 8 8 8
r = mapset m 16 8 8
pt_ok pt_spawn c 0 56
pt_ok pt_spawn c 1 57
pt_ok pt_spawn c 2 58
pt_ok eq sup_spawn c 2 neg long 16 59
for w ulong 3
pt_ok eq pt_phase c w 1 0 60
end
pt_ok eq mapget c 272 8 1 61
pt_ok eq mapget c 1288 8 1 62
pt_ok eq pool_roll c 2 63
pt_ok pt_fill c 5 64
pt_ok eq pool_roll c neg long 9 65
note An older epoch stays complete for its holder after newer publication.
pt_ok eq pt_phase c 0 2 0 66
r = mapset m 8 8 5
pt_ok eq pt_phase c 0 3 0 67
pt_ok eq pt_phase c 1 3 0 68
pt_ok eq mapget c 256 8 2 69
pt_ok eq pool_roll c neg long 9 70
note Kill the last holder of epoch 1. Its death is seen through its life pipe.
pt_ok eq killpid int get swpid 2 9 0 71
dead = long 0
for t ulong 500
dead = add dead sup_poll c 10000000
if gt dead 0
break
end
end
pt_ok eq dead 1 72
pt_ok eq and get swst 2 127 9 73
pt_ok eq mapget c 272 8 0 74
pt_ok eq mapget c 1296 8 2 75
pt_ok eq pool_roll c 3 76
pt_ok pt_fill c 3 77
r = mapset m 8 8 3
pt_ok pt_spawn c 2 78
pt_ok eq pt_phase c 2 3 0 79
r = mapset m 0 8 4
pt_ok eq sup_wake 1 0 80
r = sleepns 100000000
note A pending ack from the stalled worker must not turn the stop wait into a
note spin that kills it before the 2 s deadline.
pt_ok eq sup_ack 1 0 89
t0 = monons
k = sup_stop c 2000000000
pt_ok ge sub monons t0 1900000000 90
pt_ok eq k 1 81
pt_ok eq get swst 0 0 82
pt_ok eq get swst 2 0 83
pt_ok eq and get swst 1 127 9 84
pt_ok eq waitpid neg int 1 ptws 0 4 1 neg long 10 85
pt_ok eq sup_live c 0 86
sup_closeall
pt_ok eq pool_free c 0 87
pt_ok eq mapdrop m 0 88
end

note A creator that exits without stopping its worker must not leave the worker
note waiting: the worker sees the creator's life pipe hang up and reports 3.
fn pt_orphan to void
pf = new uchar 8 0
b = new uchar 1 0
pt_ok ge pipefds pf 0 8 524288 0 93
rd = pt_fd4 pf 0
wr = pt_fd4 pf 4
s = fork
if eq s 0
c = pool_new 1 1
if le c 0
exit 50
end
if ne sup_init c 0
exit 51
end
put ptc 0 c
p = sup_spawn c 0
if eq p 0
r = sup_wwait c 0 5000000000
put b 0 uchar and ulong add r 128 255
r = write wr b 0 1
exit 0
end
exit 0
end
pt_ok gt s 0 94
r = fclose wr
pt_ok eq waitpid int s ptws 0 4 0 s 95
pt_ok eq get ptws 0 0 96
pt_ok gt waitio rd 1 6000000000 0 97
pt_ok eq read rd b 0 1 1 98
pt_ok eq get b 0 131 99
r = fclose rd
end

note Stress: 0 when arena h shows only complete records of epoch e from start
note to end of one hold. A reclaimed held arena changes its epoch, drops its
note count or rewrites bytes, so a missing hold check shows up here.
fn pt_scan h long e ulong to int
buf = new uchar 4096 0
if ne node_epoch h e
ret 1
end
cur = ulong 0
for k ulong 65
v = node_next h cur 1
if eq v 0
break
end
if lt v 0
ret 2
end
cur = ulong v
if ne node_read h cur buf 4096
ret 3
end
b = pt_byte e cur
for j ulong 4096
if ne get buf j b
ret 4
end
end
end
if ne node_epoch h e
ret 5
end
ret 0
end

fn pt_sworker w ulong to int
c = get ptc 0
m = get ptm 0
n = ulong 0
for it ulong 10000000
if pool_stopped c
r = mapset m add 64 mul w 8 8 n
ret 0
end
h = pool_acquire c w
if eq h neg long 1
r = mapset m add 64 mul w 8 8 n
ret 0
end
if gt h 0
r = pt_scan h mapget c add 256 mul w 8 8
if ne r 0
ret add 20 r
end
q = pool_release c w
n = add n 1
end
end
ret 29
end

fn pt_num v ulong to void
d = new uchar 20 0
x = v
k = ulong 20
for i ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
r = write 1 d k sub 20 k
end

text pstress "stress rolls="
text pbusy " busy="
text preads " reads="
text pnl "\n"
text psp " "

note Two workers acquire, scan and release in a tight loop while the creator
note rolls 2000 epochs over two arenas, publishing four records per epoch.
fn pt_stress to void
c = pool_new 2 2
pt_ok gt c 0 120
put ptc 0 c
m = mapnew neg int 1 0 4096 3 33
pt_ok gt m 0 121
put ptm 0 m
pt_ok eq sup_init c 0 122
pt_ok pt_fill c 4 123
for w ulong 2
p = sup_spawn c w
if eq p 0
exit pt_sworker w
end
pt_ok gt p 0 124
end
rolls = ulong 0
busy = ulong 0
for i ulong 100000000
if ge rolls 2000
break
end
r = pool_roll c
if eq r neg long 9
busy = add busy 1
if eq and busy 1023 0
pt_ok eq sup_poll c 0 0 133
end
cpurelax
continue
end
pt_ok gt r 0 125
rolls = add rolls 1
pt_ok pt_fill c 4 126
end
pt_ok eq rolls 2000 127
pt_ok eq sup_stop c 5000000000 0 128
pt_ok eq get swst 0 0 129
pt_ok eq get swst 1 0 130
r = write 1 pstress 0 len pstress
pt_num rolls
r = write 1 pbusy 0 len pbusy
pt_num busy
r = write 1 preads 0 len preads
pt_num mapget m 64 8
r = write 1 psp 0 1
pt_num mapget m 72 8
r = write 1 pnl 0 1
sup_closeall
pt_ok eq pool_free c 0 131
pt_ok eq mapdrop m 0 132
end

fn pt_isarg to bool
a = new uchar 16 0
if ne argcnt 2
ret false
end
ret eq argread 1 a 0 16 6
end

note With one argument (any 6 bytes, "stress"), run only the stress phase.
fn main to int
if pt_isarg
pt_stress
ret 0
end
pt_refusals
pt_epochs
pt_race
pt_orphan
pt_procs
pt_stress
if ne write 1 pok 0 len pok long len pok
ret 100
end
ret 0
end

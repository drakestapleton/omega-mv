note seed/node/code-test.om -- checks of the coding workflow (DRA-290).
note omnode-code-test unit JDIR: the creator's decisions on crafted model
note and tool records, no child process; prints "code checks=N fail=F" and
note exits 0, or 150 + the number of the first failing check.
note omnode-code-test cancel MS INFER TOOL OMC ROOT WORK JDIR PORT VIEW OBJ...:
note omnode-code with objective 0's first inference cancelled through
note auth_cancel once it has run MS milliseconds.
note omnode-code-test overload LIMIT INFER ... OBJ...: omnode-code admitting
note at most LIMIT jobs (DRA-291: the view shows the refusals).
note omnode-code-test uncertain INFER ... OBJ...: omnode-code whose first
note granted replace has its worker killed (DRA-291: an unknown effect).
text ctunit "unit"
text ctcanc "cancel"
text ctover "overload"
text ctunc "uncertain"
text ctobj "loop,4,3,70,jobs/item76666.om,Fix the error in this file and confirm its goal."
text ctpath "jobs/item76666.om"
text ctbadp "jobs/item76667.om"
text ctsrc "fn calc x int to int\ns = x\nfor i ulong 2\ns = add s int 4\nend\nret s\nend\nfn main to int\nret calc int 70\nend\n"
text ctfix "fn calc x int to int\ns = x\nfor i ulong 3\ns = add s int 4\nend\nret s\nend\nfn main to int\nret calc int 70\nend\n"
text ctold "ulong 2"
text ctnew "ulong 3"
text ctnone "ulong 9"
text ctdup "int 4"
text ctdup2 "s"
text ctgar "ulong 3 x"
text ctrs "Read succeeded."
text ctfnf "File not found."
text cttf "Test failed: calc(70) expected 82, got 78."
text ctes "Edit saved."
text cttp "Tests passed."
text ctp0 "Task: Fix the error in this file and confirm its goal.\nFile: jobs/item76666.om\nGoal: calc starts with x and adds 4 exactly 3 times in a for loop. main calls calc with 70.\nState: unread\nAnswer:\n"
text ctp2 "Task: Fix the error in this file and confirm its goal.\nFile: jobs/item76666.om\nGoal: calc starts with x and adds 4 exactly 3 times in a for loop. main calls calc with 70.\nState: failed\nSource:\nfn calc x int to int\ns = x\nfor i ulong 2\ns = add s int 4\nend\nret s\nend\nfn main to int\nret calc int 70\nend\nTool result: Test failed: calc(70) expected 82, got 78.\nAnswer:\n"
text ctfl "code-test check "
text ctfl2 " FAIL\n"
text ctsum "code checks="
text ctsum2 " fail="
text ctomni "OMNI1 "
text ctomnt "OMNT1 "
global ctn ulong 3
global ctc ulong 1

note The creator's pool handle, kept for the record helpers.
fn ct_c to long
ret long get ctc 0
end

fn ct_ok b bool to void
put ctn 0 add get ctn 0 1
if b
ret
end
put ctn 1 add get ctn 1 1
if eq get ctn 2 0
put ctn 2 get ctn 0
end
o = new uchar 4096 0
p = cw_cat o 0 ctfl
p = cw_dec o p get ctn 0
p = cw_cat o p ctfl2
cw_out o p
end

note Objective 0 in state st (verified vf), its source sel (0 none, 1 the
note broken source, 2 the fixed one), no job, running.
fn ct_set st ulong vf ulong sel ulong to void
cw_s 0 6 st
cw_s 0 8 vf
cw_s 0 9 0
cw_s 0 10 0
cw_s 0 12 0
cw_s 0 13 0
cw_s 0 14 0
put cwinf 0 0
if eq sel 1
cw_setsrc 0 ctsrc
end
if eq sel 2
cw_setsrc 0 ctfix
end
end

note The objective's state: result r and, when r is 0, a job of kind k in
note flight (k 0: none).
fn ct_is r ulong k ulong to bool
if ne cw_g 0 12 r
ret false
end
if ne r 0
ret true
end
if eq k 0
ret eq cw_g 0 10 0
end
id = cw_g 0 10
ret and gt id 0 and eq rem id 10 k jn_known id
end

note Record texts by index: 0 path, 1 another path, 2 old, 3 new, 4 old
note text not in the source, 5 old text twice in it, 6 old text many times,
note 7 new text outside the grammar. Appended to b at p; the new length.
fn ct_cat b edit uchar 4096 p ulong s ulong to ulong
if eq s 0
ret cw_cat b p ctpath
end
if eq s 1
ret cw_cat b p ctbadp
end
if eq s 2
ret cw_cat b p ctold
end
if eq s 3
ret cw_cat b p ctnew
end
if eq s 4
ret cw_cat b p ctnone
end
if eq s 5
ret cw_cat b p ctdup
end
if eq s 6
ret cw_cat b p ctdup2
end
ret cw_cat b p ctgar
end

fn ct_len s ulong to ulong
b = new uchar 4096 0
ret ct_cat b 0 s
end

fn ct_nums b edit uchar 4096 p ulong a ulong o ulong to ulong
q = cw_cat b p cwsp
q = cw_dec b q 1
q = cw_cat b q cwsp
q = cw_dec b q 100
q = cw_cat b q cwsp
q = cw_dec b q 12
q = cw_cat b q cwsp
q = cw_dec b q a
q = cw_cat b q cwsp
q = cw_dec b q o
ret q
end

fn ct_tail b edit uchar 4096 p ulong nl ulong tl ulong to ulong
q = cw_cat b p cwsp
q = cw_dec b q nl
q = cw_cat b q cwsp
q = cw_dec b q tl
ret cw_cat b q cwnl
end

note The model's action k on path text pa, replacing text ol by text nw
note (indices for ct_cat); the raw text is two newlines.
fn ct_act k ulong pa ulong ol ulong nw ulong to void
b = new uchar 4096 0
p = cw_cat b 0 ctomni
p = cw_dec b p k
p = ct_nums b p ct_len pa ct_len ol
p = ct_tail b p ct_len nw 2
p = ct_cat b p pa
p = ct_cat b p ol
p = ct_cat b p nw
p = cw_cat b p cwnl
p = cw_cat b p cwnl
cw_ires ct_c 0 b
end

note A plain answer (Tests passed., File not found.) of kind k.
fn ct_ans k ulong a view uchar * to void
b = new uchar 4096 0
p = cw_cat b 0 ctomni
p = cw_dec b p k
p = ct_nums b p 0 0
p = ct_tail b p 0 len a
p = cw_cat b p a
cw_ires ct_c 0 b
end

note A tool record of job kind k: status st, observation ob, content ct.
fn ct_tool k ulong st ulong ob view uchar * ct view uchar * to void
b = new uchar 4096 0
p = cw_cat b 0 ctomnt
p = cw_dec b p st
p = cw_cat b p cwsp
p = cw_dec b p len ob
p = cw_cat b p cwsp
p = cw_dec b p len ct
p = cw_cat b p cwnl
p = cw_cat b p ob
p = cw_cat b p ct
cw_tres ct_c 0 k b
end

fn ct_prompt to void
o = new uchar 4096 0
ct_set 0 0 0
n = cw_prmt o 0
ct_ok cw_eq view part o 0 n ctp0
ct_set 2 0 1
cw_seto 0 cttf
n = cw_prmt o 0
ct_ok cw_eq view part o 0 n ctp2
end

note Model actions against the policy.
fn ct_model to void
ct_set 0 0 0
ct_act 1 0 2 3
ct_ok ct_is 0 2
ct_set 0 0 0
ct_act 1 1 2 3
ct_ok ct_is 11 0
ct_set 0 0 0
ct_act 2 0 2 3
ct_ok ct_is 10 0
ct_set 0 0 0
ct_act 9 0 2 3
ct_ok ct_is 10 0
ct_set 1 0 1
ct_act 3 0 2 3
ct_ok ct_is 10 0
ct_set 1 0 1
ct_act 2 0 2 3
ct_ok ct_is 0 3
ct_set 3 0 2
ct_act 2 0 2 3
ct_ok ct_is 0 3
ct_set 4 1 2
ct_act 2 0 2 3
ct_ok ct_is 10 0
ct_edits
ct_answers
end

fn ct_edits to void
u = new uchar 4096 0
ct_set 2 0 1
ct_act 3 0 4 3
ct_ok ct_is 13 0
ct_set 2 0 1
ct_act 3 0 5 3
ct_ok ct_is 13 0
ct_set 2 0 1
ct_act 3 0 6 3
ct_ok ct_is 13 0
ct_set 2 0 1
ct_act 3 0 2 7
ct_ok ct_is 13 0
ct_set 2 0 1
ct_act 3 1 2 3
ct_ok ct_is 11 0
ct_set 2 0 1
ct_act 3 0 2 3
ct_ok ct_is 0 4
n = cw_ld u 4 0
ct_ok cw_eq view part u 0 n ctfix
end

fn ct_answers to void
ct_set 4 0 1
ct_ans 4 cttp
ct_ok ct_is 14 0
ct_set 3 0 2
ct_ans 4 cttp
ct_ok ct_is 14 0
ct_set 4 1 2
ct_ans 4 cttp
ct_ok ct_is 0 5
ct_set 0 0 0
ct_ans 5 ctfnf
ct_ok ct_is 10 0
ct_set 5 0 0
ct_ans 5 ctfnf
ct_ok ct_is 1 0
end

note Malformed model records.
fn ct_bad to void
b = new uchar 4096 0
ct_set 0 0 0
p = cw_cat b 0 ctomnt
cw_ires ct_c 0 b
ct_ok ct_is 18 0
ct_set 0 0 0
p = cw_cat b 0 ctomni
p = cw_dec b p 4
p = ct_nums b p 0 0
p = ct_tail b p 0 3969
cw_ires ct_c 0 b
ct_ok ct_is 18 0
ct_set 0 0 0
p = cw_cat b 0 ctomni
p = cw_dec b p 4
p = cw_cat b p cwnl
cw_ires ct_c 0 b
ct_ok ct_is 18 0
end

note Tool records.
fn ct_tools to void
u = new uchar 4096 0
ct_set 0 0 0
ct_tool 2 0 ctrs ctsrc
ct_ok and ct_is 0 0 eq cw_g 0 6 1
n = cw_ld u 2 0
ct_ok cw_eq view part u 0 n ctsrc
ct_set 0 0 0
ct_tool 2 1 ctfnf ctes
ct_ok and ct_is 0 0 eq cw_g 0 6 5
ct_set 0 0 0
ct_tool 2 2 ctfnf ctes
ct_ok ct_is 17 0
ct_set 1 0 1
ct_tool 3 6 cttf ctsrc
ct_ok and ct_is 0 0 and eq cw_g 0 6 2 eq cw_g 0 8 0
ct_set 1 0 1
ct_tool 3 6 cttf ctfix
ct_ok ct_is 15 0
ct_set 3 0 2
ct_tool 3 0 cttp ctfix
ct_ok and ct_is 0 0 and eq cw_g 0 6 4 eq cw_g 0 8 1
ct_set 3 0 2
ct_tool 3 4 cttp ctfix
ct_ok ct_is 17 0
ct_saves
end

fn ct_saves to void
ct_set 2 0 1
ct_act 3 0 2 3
ct_ok ct_is 0 4
cw_s 0 10 0
ct_tool 4 0 ctes ctfix
ct_ok and ct_is 0 0 eq cw_g 0 6 3
ct_set 2 0 1
cw_s 0 15 0
ct_tool 4 0 ctes ctfix
ct_ok ct_is 15 0
ct_set 2 0 1
ct_tool 4 5 ctes ctsrc
ct_ok ct_is 13 0
ct_set 4 1 2
ct_tool 5 0 cttp ctfix
ct_ok ct_is 1 0
ct_set 4 1 2
ct_tool 5 6 cttf ctfix
ct_ok ct_is 15 0
ct_set 4 1 2
ct_tool 5 0 cttp ctsrc
ct_ok ct_is 15 0
end

note Job outcome words.
fn ct_fates to void
ct_ok eq cw_fate 2 1 0
ct_ok eq cw_fate or ulong 2 shl ulong 1024 8 1 16
ct_ok eq cw_fate or ulong 2 shl ulong 1280 8 1 16
ct_ok eq cw_fate or ulong 2 shl ulong 2048 8 1 16
ct_ok eq cw_fate or ulong 2 shl ulong 256 8 3 17
ct_ok eq cw_fate or ulong 2 shl ulong 9 8 1 21
ct_ok eq cw_fate or ulong 1 shl ulong 9 8 1 19
ct_ok eq cw_fate 22 1 19
ct_ok eq cw_fate 0 4 21
ct_ok eq cw_fate 90 2 22
ct_ok eq cw_fate 18 2 23
end

note Turn limit and prompt length.
fn ct_limits c long to void
sp = new uchar 4096 0
ct_set 1 0 0
cw_s 0 7 7
cw_plan c
ct_ok ct_is 12 0
for j ulong 3790
put sp j 32
end
ct_set 1 0 0
cw_setsrc 0 view part sp 0 3790
cw_s 0 7 0
cw_plan c
ct_ok ct_is 20 0
ct_set 0 0 0
cw_plan c
ct_ok and ct_is 0 1 eq cw_g 0 7 1
end

note A full queue: a refused inference is asked for again (the objective
note keeps waiting for a turn); a refused tool job ends the objective with
note 23; both refusals are counted for the view.
fn ct_full c long to void
for k ulong 64
if lt jn_admit add 9001 k 0 1 0
break
end
end
r0 = vw_cget 0
ct_set 0 0 0
cw_plan c
ct_ok and ct_is 0 0 eq cw_g 0 9 0
ct_set 1 0 1
cw_tool c 0 3
ct_ok ct_is 23 0
ct_ok eq vw_cget 0 add r0 2
end

fn ct_unit to int
d = new uchar 1024 0
n = argread 2 d 0 1000
if lt n 1
ret 2
end
for k ulong 7
put cwcl k 1
put cwcf mul k 1024 47
end
for j ulong ulong n
put cwcf add 5120 j get d j
end
put cwcl 5 ulong n
put cwno 0 1
if not cw_parse 0 ctobj
ret 3
end
c = pool_new 4 2
if le c 0
ret 50
end
put ctc 0 ulong c
if ne sup_init c 0
ret 51
end
if ne sched_new c 8 8 0
ret 52
end
if ne auth_new c 0
ret 53
end
e = cw_jopen 1 1
if ne e 0
ret int add 30 e
end
ct_prompt
ct_model
ct_bad
ct_tools
ct_fates
ct_limits c
ct_full c
jn_close
ret ct_end
end

fn ct_end to int
o = new uchar 4096 0
p = cw_cat o 0 ctsum
p = cw_dec o p get ctn 0
p = cw_cat o p ctsum2
p = cw_dec o p get ctn 1
p = cw_cat o p cwnl
cw_out o p
if eq get ctn 1 0
ret 0
end
ret int add 150 get ctn 2
end

fn ct_mode to ulong
b = new uchar 16 0
n = argread 1 b 0 16
if lt n 1
ret 0
end
if cw_eq view part b 0 ulong n ctunit
ret 1
end
if cw_eq view part b 0 ulong n ctcanc
ret 2
end
if cw_eq view part b 0 ulong n ctover
ret 3
end
if cw_eq view part b 0 ulong n ctunc
ret 4
end
ret 0
end

fn main to int
m = ct_mode
if eq m 1
ret ct_unit
end
if eq m 2
ms = ct_num 2
put cwtk 0 1
put cwtk 1 ms
ret cw_main 3 3600
end
if eq m 3
q = ct_num 2
if eq q 0
ret 2
end
put cwql 0 q
ret cw_main 3 3600
end
if eq m 4
put cwtu 0 1
ret cw_main 2 3600
end
ret 2
end

note Argument i as a decimal of at most 7 digits; 0 when malformed.
fn ct_num i ulong to ulong
b = new uchar 16 0
n = argread i b 0 16
if or lt n 1 gt n 7
ret 0
end
v = ulong 0
for j ulong ulong n
c = ulong get b j
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub c 48
end
ret v
end

note The tree copy and removal work on two path stacks: rlsrc[0, sl) the source and
note rldst[0, dl) the destination; a level appends "/name" and passes the longer length.
note rlcn counts files, directories, links and bytes copied.
global rlsrc uchar 4096
global rldst uchar 4096
global rlcn ulong 4

note ======== bytes

note Append a to o at p; the new end.
fn rl_cat o edit uchar * p ulong a view uchar * to ulong
n = len a
for i ulong n
put o add p i get a i
end
ret add p n
end

fn rl_dec o edit uchar * p ulong v ulong to ulong
d = new uchar 20 0
k = ulong 20
x = v
for it ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
ret rl_cat o p part d k sub 20 k
end

note Two decimal digits of v (0..99).
fn rl_d2 o edit uchar * p ulong v ulong to ulong
put o p uchar add div v 10 48
put o add p 1 uchar add rem v 10 48
ret add p 2
end

fn rl_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end

note The first offset of nd in b, or -1.
fn rl_find b view uchar * nd view uchar * to long
n = len b
m = len nd
if gt m n
ret -1
end
for i ulong add sub n m 1
k = ulong 0
while lt k m bound 4096
if ne get b add i k get nd k
break
end
k = add k 1
end
if eq k m
ret long i
end
end
ret -1
end

note The offset of the first newline in b at or after s, or len b.
fn rl_eol b view uchar * s ulong to ulong
e = s
n = len b
while lt e n bound 16777216
if eq get b e 10
ret e
end
e = add e 1
end
ret n
end

note b[0, n) without its trailing newlines: the new n.
fn rl_trim b view uchar * n ulong to ulong
m = n
while gt m 0 bound 16777216
if ne get b sub m 1 10
ret m
end
m = sub m 1
end
ret 0
end

note ======== output and errors

fn rl_wall fd int a view uchar * to long
n = len a
p = ulong 0
while lt p n bound 16777216
k = write fd a p sub n p
if le k 0
ret -1
end
p = add p ulong k
end
ret 0
end

fn rl_die m view uchar * c int to void
b = new uchar 16384 0
p = rl_cat b 0 rlpre
p = rl_cat b p m
p = rl_cat b p rlnl
x = rl_wall 2 part b 0 p
exit c
end

note die with a message followed by argument i.
fn rl_diea m view uchar * i ulong c int to void
b = new uchar 8192 0
p = rl_cat b 0 m
q = argread i b p sub 8192 p
if gt q 0
p = add p ulong q
end
rl_die part b 0 p c
end

note Argument i into o; its length (over the capacity dies, exit 2).
fn rl_arg i ulong o edit uchar * to ulong
n = argread i o 0 len o
if lt n 0
rl_die rlmlong 2
end
ret ulong n
end

note The path STATE/nm into o; its length.
fn rl_stp o edit uchar * nm view uchar * to ulong
n = rl_arg 2 o
put o n 47
ret rl_cat o add n 1 nm
end

note ======== files

fn rl_close fd long to void
if ge fd 0
x = fclose int fd
end
end

fn rl_open pa view uchar * fl int md int to long
ret fopen pa 0 len pa fl md
end

fn rl_stopen nm view uchar * fl int md int to long
pa = new uchar 4096 0
n = rl_stp pa nm
ret fopen pa 0 n fl md
end

note Read pa into b (at most len b bytes); the length or a negative error.
fn rl_slurp pa view uchar * b edit uchar * to long
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret fd
end
n = ulong 0
c = len b
while lt n c bound 16777216
k = read int fd b n sub c n
if le k 0
break
end
n = add n ulong k
end
rl_close fd
ret long n
end

fn rl_stsl nm view uchar * b edit uchar * to long
pa = new uchar 4096 0
n = rl_stp pa nm
ret rl_slurp part pa 0 n b
end

note Append the content of pa without its trailing newlines (as sh $(cat pa)) to o at p,
note at most up to 1024 bytes before the end of o.
fn rl_fcat pa view uchar * o edit uchar * p ulong to ulong
b = new uchar 65536 0
n = rl_slurp pa b
if le n 0
ret p
end
m = rl_trim part b 0 ulong n ulong n
r = sub sub len o p 1024
if gt m r
m = r
end
ret rl_cat o p part b 0 m
end

fn rl_stfcat nm view uchar * o edit uchar * p ulong to ulong
pa = new uchar 4096 0
n = rl_stp pa nm
ret rl_fcat part pa 0 n o p
end

note Copy the whole file pa to descriptor fd; 0 or a negative error.
fn rl_fout pa view uchar * fd int to long
b = new uchar 65536 0
fi = fopen pa 0 len pa 524288 0
if lt fi 0
ret fi
end
r = long 0
for it ulong 16777216
k = read int fi b 0 65536
if le k 0
r = k
break
end
x = rl_wall fd part b 0 ulong k
end
rl_close fi
ret r
end

fn rl_stout nm view uchar * to void
pa = new uchar 4096 0
n = rl_stp pa nm
r = rl_fout part pa 0 n 1
end

note true when STATE/nm holds nd.
fn rl_sthas nm view uchar * nd view uchar * to bool
b = new uchar 262144 0
n = rl_stsl nm b
if le n 0
ret false
end
ret ge rl_find part b 0 ulong n nd 0
end

note Lines of pa that begin with px (grep -c '^px').
fn rl_cntpre pa view uchar * px view uchar * to ulong
b = new uchar 65536 0
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret 0
end
c = ulong 0
s = ulong 0
m = len px
for it ulong 16777216
k = read int fd b 0 65536
if le k 0
break
end
for i ulong ulong k
h = get b i
if eq h 10
s = 0
else
if lt s m
if eq h get px s
s = add s 1
if eq s m
c = add c 1
s = add m 1
end
else
s = add m 1
end
end
end
end
end
rl_close fd
ret c
end

note The last three lines of pa (tail -3, read from its last 4000 bytes) without trailing
note newlines, appended to o at p.
fn rl_tail3 pa view uchar * o edit uchar * p ulong to ulong
b = new uchar 4096 0
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret p
end
z = fseek int fd 0 2
if gt z 4000
z = fseek int fd sub z 4000 0
else
z = fseek int fd 0 0
end
n = ulong 0
while lt n 4000 bound 4001
k = read int fd b n sub 4000 n
if le k 0
break
end
n = add n ulong k
end
rl_close fd
e = rl_trim part b 0 n n
s = rl_l3 part b 0 e e
ret rl_cat o p part b s sub e s
end

note The start of the last three lines of b[0, e).
fn rl_l3 b view uchar * e ulong to ulong
k = ulong 0
i = e
while gt i 0 bound 4097
i = sub i 1
if eq get b i 10
k = add k 1
if eq k 3
ret add i 1
end
end
end
ret 0
end

fn rl_isdir pa view uchar * to bool
st = new uchar 128 0
r = stat pa 0 len pa st 0 128
if lt r 0
ret false
end
ret eq and or ulong get st 16 shl ulong get st 17 8 61440 16384
end

fn rl_size pa view uchar * to ulong
st = new uchar 128 0
r = stat pa 0 len pa st 0 128
if lt r 0
ret 0
end
v = ulong 0
for i ulong 8
v = or v shl ulong get st add 48 i mul 8 i
end
ret v
end

note mkdir -p pa: 0 when pa is a directory afterwards.
fn rl_mkp pa view uchar * to long
b = new uchar 4096 0
n = len pa
for i ulong n
c = get pa i
if eq c 47
if gt i 0
r = makedir b 0 i 511
end
end
put b i c
end
if eq n 0
ret -2
end
r = makedir b 0 n 511
if rl_isdir pa
ret 0
end
ret -20
end

fn rl_stmkp nm view uchar * to void
pa = new uchar 4096 0
n = rl_stp pa nm
r = rl_mkp part pa 0 n
if lt r 0
rl_die rlmdir 1
end
end

note Rename STATE/a over STATE/b.
fn rl_stmv a view uchar * b view uchar * to long
pk = new uchar 4096 0
pa = new uchar 4096 0
put pk 0 2
n = rl_stp pa a
p = rl_pk pk 2 part pa 0 n
n = rl_stp pa b
p = rl_pk pk p part pa 0 n
ret renames pk 0 p 0
end

note Write the decimal v and a newline to STATE/nm (echo v > nm).
fn rl_wpid nm view uchar * v long to void
o = new uchar 32 0
fd = rl_stopen nm 524865 438
if lt fd 0
ret
end
p = rl_dec o 0 ulong v
p = rl_cat o p rlnl
x = rl_wall int fd part o 0 p
rl_close fd
end

note ======== SHA-256 (om/tls/sha2.om)

note The lowercase hex SHA-256 of the file pa appended to o at p; nothing when it cannot
note be opened.
fn rl_sha pa view uchar * o edit uchar * p ulong to ulong
c = new ulong 40 0
b = new uchar 65536 0
d = new uchar 32 0
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret p
end
sha256_init c
for it ulong 16777216
k = read int fd b 0 65536
if le k 0
break
end
sha256_update c part b 0 ulong k
end
rl_close fd
sha256_final c d
ret rl_hexd d o p
end

note The 32 bytes of d as lowercase hex appended to o at p.
fn rl_hexd d view uchar 32 o edit uchar * p ulong to ulong
for i ulong 32
q = add p mul i 2
v = ulong get d i
put o q get rlhex shr v 4
put o add q 1 get rlhex and v 15
end
ret add p 64
end

note ======== processes

note Append the packed record a to pk at p; the new end (over 4096 bytes dies).
fn rl_pk pk edit uchar 4096 p ulong a view uchar * to ulong
n = len a
if gt add add p 2 n 4096
rl_die rlmpk 2
end
put pk p uchar and n 255
put pk add p 1 uchar shr n 8
for i ulong n
put pk add add p 2 i get a i
end
ret add add p 2 n
end

fn rl_pkc pk edit uchar 4096 c ulong to void
if gt c 64
rl_die rlmpk 2
end
put pk 0 uchar c
put pk 1 0
end

note Append argument i as a record.
fn rl_pka pk edit uchar 4096 p ulong i ulong to ulong
b = new uchar 4096 0
n = rl_arg i b
ret rl_pk pk p part b 0 n
end

note Append the release.env value of key followed by suffix sf as one record.
fn rl_pke pk edit uchar 4096 p ulong key view uchar * sf view uchar * to ulong
b = new uchar 8192 0
n = rl_env key b 0
n = rl_cat b n sf
ret rl_pk pk p part b 0 n
end

note Append the release.env value of key as a record.
fn rl_pkv pk edit uchar 4096 p ulong key view uchar * to ulong
b = new uchar 8192 0
n = rl_env key b 0
ret rl_pk pk p part b 0 n
end

note Append STATE followed by sf as a record.
fn rl_pks pk edit uchar 4096 p ulong sf view uchar * to ulong
b = new uchar 8192 0
n = rl_arg 2 b
n = rl_cat b n sf
ret rl_pk pk p part b 0 n
end

note Start pk with descriptors fi, fo, fe as 0, 1, 2 (negative: keep ours); the PID.
fn rl_spawn pk view uchar * fi long fo long fe long to long
pid = fork
if eq pid 0
r = long 0
if ge fi 0
r = dupfd int fi 0 0
end
if ge fo 0
r = dupfd int fo 1 0
end
if ge fe 0
r = dupfd int fe 2 0
end
r = execprog pk 0 len pk
exit 127
end
ret pid
end

note Wait for pid: its exit status, 128 + the signal, or 127 when the wait failed.
fn rl_wait pid long to int
ws = new uchar 4 0
g = waitpid int pid ws 0 4 0
if lt g 0
ret 127
end
s = or ulong get ws 0 shl ulong get ws 1 8
if ne and s 127 0
ret int add 128 and s 127
end
ret int and shr s 8 255
end

fn rl_run pk view uchar * fi long fo long fe long to int
pid = rl_spawn pk fi fo fe
if lt pid 0
ret 127
end
ret rl_wait pid
end

note A process with this PID exists (a child of ours that ended is reaped first).
fn rl_alivp pid long to bool
ws = new uchar 4 0
if le pid 0
ret false
end
g = waitpid int pid ws 0 4 1
if eq g pid
ret false
end
ret ge killpid int pid 0 0
end

note The PID in STATE/nm, or -1.
fn rl_pidf nm view uchar * to long
b = new uchar 64 0
n = rl_stsl nm b
if le n 0
ret -1
end
m = rl_trim part b 0 ulong n ulong n
if eq m 0
ret -1
end
v = long 0
for i ulong m
c = get b i
if or lt c 48 gt c 57
ret -1
end
if gt v 100000000000
ret -1
end
v = add mul v 10 long sub c 48
end
ret v
end

fn rl_alive nm view uchar * to bool
ret rl_alivp rl_pidf nm
end

note Wait until pid is gone, polling every 0.1 s.
fn rl_gone pid long to void
while rl_alivp pid bound 9223372036854775807
x = sleepns 100000000
end
end

note ======== release.env and the view

note The value of key in STATE/release.env appended to o at p.
fn rl_env key view uchar * o edit uchar * p ulong to ulong
b = new uchar 16384 0
n = rl_stsl rlenvf b
if le n 0
ret p
end
m = len key
s = ulong 0
while lt s ulong n bound 16384
e = rl_eol part b 0 ulong n s
if gt sub e s m
if eq get b add s m 61
if rl_eq part b s m key
q = add add s m 1
ret rl_cat o p part b q sub e q
end
end
end
s = add e 1
end
ret p
end

fn rl_envck to void
b = new uchar 4096 0
pa = new uchar 4096 0
n = rl_stp pa rlenvf
fd = fopen pa 0 n 524288 0
if lt fd 0
p = rl_cat b 0 rlmno
q = rl_arg 2 part b p sub 4096 p
p = add p q
p = rl_cat b p rlmnoe
rl_die part b 0 p 2
end
rl_close fd
end

note The digits after the first "nm": in STATE/fl appended to o at p (grep -o, head -1).
fn rl_vf fl view uchar * nm view uchar * o edit uchar 8192 p ulong to ulong
b = new uchar 262144 0
n = rl_stsl fl b
if le n 0
ret p
end
ret rl_vfb part b 0 ulong n nm o p
end

note The digits after the first "nm": in b appended to o at p.
fn rl_vfb b view uchar * nm view uchar * o edit uchar 8192 p ulong to ulong
k = new uchar 80 0
put k 0 34
q = rl_cat k 1 nm
put k q 34
put k add q 1 58
q = add q 2
i = rl_find b part k 0 q
if lt i 0
ret p
end
j = add ulong i q
e = rl_digs b j
ret rl_cat o p part b j sub e j
end

note The end of the decimal digits of b from j.
fn rl_digs b view uchar * j ulong to ulong
e = j
n = len b
while lt e n bound 16777216
c = get b e
if or lt c 48 gt c 57
ret e
end
e = add e 1
end
ret n
end

fn rl_vis fl view uchar * nm view uchar * v view uchar * to bool
o = new uchar 8192 0
n = rl_vf fl nm o 0
ret rl_eq part o 0 n v
end

note The decimal after the first "nm": in STATE/fl; 0 when absent or longer than 19 digits.
fn rl_vnum fl view uchar * nm view uchar * to ulong
o = new uchar 8192 0
n = rl_vf fl nm o 0
if gt n 19
ret 0
end
v = ulong 0
for i ulong n bound 19
v = add mul v 10 ulong sub get o i 48
end
ret v
end

note pk = BIN/op and the release.env value of key; the end.
fn rl_opk pk edit uchar 4096 key view uchar * to ulong
p = rl_pke pk 2 rlkbin rlxop
ret rl_pkv pk p key
end

note op VIEW view > ou, stderr to /dev/null when en is 1; op's exit status.
fn rl_opv ou view uchar * en ulong to int
pk = new uchar 4096 0
p = rl_opk pk rlkview
p = rl_pk pk p rlwview
rl_pkc pk 3
fo = rl_open ou 524865 438
if lt fo 0
ret 2
end
fe = long -1
if eq en 1
fe = rl_open rlnull 524289 0
end
r = rl_run part pk 0 p -1 fo fe
rl_close fo
rl_close fe
ret r
end

note op VIEW view into STATE/view.tmp, up to 50 times 0.1 s apart, then renamed to view.json;
note 0, or 1 when it never answered.
fn rl_view to int
a = new uchar 4096 0
na = rl_stp a rlvtmp
for i ulong 50
r = rl_opv part a 0 na 1
if eq r 0
x = rl_stmv rlvtmp rlvjs
ret 0
end
if ge i 49
ret 1
end
x = sleepns 100000000
end
ret 1
end

note The command id: digits 4..16 of the realtime nanoseconds (date +%s%N | cut -c4-16).
fn rl_cid o edit uchar * p ulong to ulong
d = new uchar 32 0
n = rl_dec d 0 ulong realns
ret rl_cat o p part d 3 13
end

note op VIEW cmd ID op 0 INC VER > STATE/ack.json; op's exit status.
fn rl_opcmd op view uchar * to int
pk = new uchar 4096 0
b = new uchar 8192 0
p = rl_opk pk rlkview
p = rl_pk pk p rlwcmd
n = rl_cid b 0
p = rl_pk pk p part b 0 n
p = rl_pk pk p op
p = rl_pk pk p rlzero
n = rl_vf rlvjs rlfinc b 0
p = rl_pk pk p part b 0 n
n = rl_vf rlvjs rlfver b 0
p = rl_pk pk p part b 0 n
rl_pkc pk 8
fo = rl_stopen rlack 524865 438
if lt fo 0
ret 2
end
r = rl_run part pk 0 p -1 fo -1
rl_close fo
ret r
end

note Post operator op (1 pause, 2 resume) from a fresh view until committed: 0, or 1. An
note "invalid" acknowledgement is the node already in that state.
fn rl_post op view uchar * to int
for i ulong 50
if ne rl_view 0
ret 1
end
r = rl_opcmd op
rl_stout rlack
if eq r 0
ret 0
end
if rl_sthas rlack rlinv
ret 0
end
if ge i 49
ret 1
end
x = sleepns 100000000
end
ret 1
end

note Append lb and the view.json field nm to o at p.
fn rl_ofj o edit uchar 8192 p ulong lb view uchar * nm view uchar * to ulong
q = rl_cat o p lb
ret rl_vf rlvjs nm o q
end

note Append lb and the view-at-stop.json field nm to o at p.
fn rl_ofs o edit uchar 8192 p ulong lb view uchar * nm view uchar * to ulong
q = rl_cat o p lb
ret rl_vf rlvst nm o q
end

note ======== build

note Write om2 and the units of the space-separated list ls to pa; 0 or -1.
fn rl_comp pa view uchar * ls view uchar * to long
fd = rl_open pa 524865 438
if lt fd 0
ret -1
end
r = rl_wall int fd rlom2
s = ulong 0
n = len ls
while lt s n bound 64
e = s
while lt e n bound 4096
if eq get ls e 32
break
end
e = add e 1
end
r = rl_fout part ls s sub e s int fd
if lt r 0
rl_close fd
ret -1
end
s = add e 1
end
rl_close fd
ret 0
end

note seed/out/omc < pa.om > pa.tmp 2> pa.cerr; omc's exit status.
fn rl_omc pa view uchar * to int
pk = new uchar 4096 0
b = new uchar 4096 0
put pk 0 1
p = rl_pk pk 2 rlomc
n = rl_cat b 0 pa
n = rl_cat b n rlxom
fi = fopen b 0 n 524288 0
n = rl_cat b len pa rlxtmp
x = unlink b 0 n
fo = fopen b 0 n 524993 511
n = rl_cat b len pa rlxcerr
fe = fopen b 0 n 524865 438
r = int 2
if and and ge fi 0 ge fo 0 ge fe 0
r = rl_run part pk 0 p fi fo fe
end
rl_close fi
rl_close fo
rl_close fe
ret r
end

note Rename pa.tmp over pa.
fn rl_bmv pa view uchar * to long
pk = new uchar 4096 0
b = new uchar 4096 0
put pk 0 2
n = rl_cat b 0 pa
n = rl_cat b n rlxtmp
p = rl_pk pk 2 part b 0 n
p = rl_pk pk p pa
ret renames pk 0 p 0
end

note Remove pa.tmp.
fn rl_brm pa view uchar * to void
b = new uchar 4096 0
n = rl_cat b 0 pa
n = rl_cat b n rlxtmp
x = unlink b 0 n
end

note Build program nm from the units ls into OUT/nm; 0, or 1 when omc refused it.
fn rl_b1 nm view uchar * ls view uchar * to int
pa = new uchar 4096 0
b = new uchar 4096 0
o = new uchar 8192 0
n = rl_arg 2 pa
put pa n 47
n = rl_cat pa add n 1 nm
q = rl_cat b 0 part pa 0 n
q = rl_cat b q rlxom
r = rl_comp part b 0 q ls
if lt r 0
p = rl_cat o 0 rlmcomp
p = rl_cat o p part b 0 q
rl_die part o 0 p 1
end
if eq rl_omc part pa 0 n 0
x = rl_bmv part pa 0 n
p = rl_cat o 0 rlobok
p = rl_cat o p nm
p = rl_cat o p rlsp
p = rl_dec o p rl_size part pa 0 n
p = rl_cat o p rlsp
p = rl_sha part pa 0 n o p
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end
p = rl_cat o 0 rlobf
p = rl_cat o p nm
p = rl_cat o p rlsp
q = rl_cat b 0 part pa 0 n
q = rl_cat b q rlxcerr
p = rl_fcat part b 0 q o p
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
rl_brm part pa 0 n
ret 1
end

fn rl_build to int
b = new uchar 4096 0
o = new uchar 8192 0
n = rl_arg 2 b
r = rl_mkp part b 0 n
if lt r 0
rl_diea rlmdir 2 1
end
if eq rl_size rlomc 0
rl_die rlmroot 2
end
c = rl_b1 rlbn1 rlbl1
c = or c rl_b1 rlbn2 rlbl2
c = or c rl_b1 rlbn3 rlbl3
c = or c rl_b1 rlbn4 rlbl4
c = or c rl_b1 rlbn5 rlbl5
c = or c rl_b1 rlbn6 rlbl6
p = rl_cat o 0 rloomc
p = rl_sha rlomc o p
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret c
end

note ======== serve and unserve

note Die "MSG(content of STATE/nm))", exit c.
fn rl_diep m view uchar * nm view uchar * c int to void
o = new uchar 8192 0
p = rl_cat o 0 m
p = rl_stfcat nm o p
p = rl_cat o p rlmcl
rl_die part o 0 p c
end

note Die "MSG<tail -3 STATE/nm>", exit 1.
fn rl_diet m view uchar * nm view uchar * to void
o = new uchar 8192 0
pa = new uchar 4096 0
p = rl_cat o 0 m
n = rl_stp pa nm
p = rl_tail3 part pa 0 n o p
rl_die part o 0 p 1
end

note Die when argument i is 18091.
fn rl_no18 i ulong to void
b = new uchar 4096 0
n = rl_arg i b
if rl_eq part b 0 n rl18091
rl_die rlm18 2
end
end

note OLLM VERB PORT CK MERGES >> STATE/serve.log 2>&1 < /dev/null; the PID.
fn rl_svgo to long
pk = new uchar 4096 0
p = rl_pka pk 2 4
p = rl_pka pk p 5
p = rl_pka pk p 3
p = rl_pka pk p 6
p = rl_pka pk p 7
rl_pkc pk 5
fi = rl_open rlnull 524288 0
fo = rl_stopen rlslog 525377 438
if or lt fi 0 lt fo 0
rl_die rlmspn 1
end
pid = rl_spawn part pk 0 p fi fo fo
rl_close fi
rl_close fo
if lt pid 0
rl_die rlmspn 1
end
ret pid
end

fn rl_serve to int
o = new uchar 8192 0
b = new uchar 4096 0
pa = new uchar 4096 0
if ne argcnt 8
rl_die rlusv 2
end
rl_no18 3
if rl_alive rlspid
rl_diep rlmsrun rlspid 3
end
n = rl_arg 2 b
r = rl_mkp part b 0 n
if lt r 0
rl_diea rlmdir 2 1
end
fd = rl_stopen rlslog 524865 438
rl_close fd
pid = rl_svgo
rl_wpid rlspid pid
n = rl_cat b 0 rlportp
q = rl_arg 3 part b n sub 4096 n
n = add n q
na = rl_stp pa rlslog
for i ulong 3000
if gt rl_cntpre part pa 0 na part b 0 n 0
break
end
if rl_alive rlspid
else
rl_diet rlmsex rlslog
end
if ge i 2999
rl_die rlmp300 1
end
x = sleepns 100000000
end
p = rl_cat o 0 rlosv1
p = rl_stfcat rlspid o p
p = rl_cat o p rlosv2
q = rl_arg 3 part b 0 4096
p = rl_cat o p part b 0 q
p = rl_cat o p rlosv3
q = rl_arg 4 part b 0 4096
p = rl_sha part b 0 q o p
p = rl_cat o p rlosv4
q = rl_arg 5 part b 0 4096
p = rl_cat o p part b 0 q
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end

fn rl_unsrv to int
o = new uchar 8192 0
if rl_alive rlspid
else
rl_die rlmnos 3
end
pid = rl_pidf rlspid
x = killpid int pid 15
rl_gone pid
p = rl_cat o 0 rlous1
p = rl_dec o p ulong pid
p = rl_cat o p rlous2
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end

note ======== start, run, health, stop, restore

note The date -u +%FT%TZ of the realtime clock appended to o at p.
fn rl_date o edit uchar * p ulong to ulong
t = div ulong realns 1000000000
q = rl_civil o p div t 86400
s = rem t 86400
put o q 84
q = rl_d2 o add q 1 div s 3600
put o q 58
q = rl_d2 o add q 1 rem div s 60 60
put o q 58
q = rl_d2 o add q 1 rem s 60
put o q 90
ret add q 1
end

note The civil date YYYY-MM-DD of day dy since 1970-01-01 (proleptic Gregorian, H. Hinnant's
note days_from_civil inverse) appended to o at p.
fn rl_civil o edit uchar * p ulong dy ulong to ulong
era = div add dy 719468 146097
doe = sub add dy 719468 mul era 146097
y = add rl_yoe doe mul era 400
ret rl_ymd o p y rl_doy doe
end

note The day of year (from March 1) of day of era doe.
fn rl_doy doe ulong to ulong
yoe = rl_yoe doe
ret sub doe add sub mul 365 yoe div yoe 100 div yoe 4
end

note YYYY-MM-DD of March-based year y and day of year doy appended to o at p.
fn rl_ymd o edit uchar * p ulong y ulong doy ulong to ulong
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
yr = y
if ge mp 10
m = sub mp 9
end
if le m 2
yr = add y 1
end
q = rl_dec o p yr
put o q 45
q = rl_d2 o add q 1 m
put o q 45
ret rl_d2 o add q 1 d
end

note The year of era of day of era doe: (doe - doe/1460 + doe/36524 - doe/146096) / 365.
fn rl_yoe doe ulong to ulong
a = sub doe div doe 1460
a = add a div doe 36524
a = sub a div doe 146096
ret div a 365
end

note Append "RUN n DATE" to STATE/run.out, n the lines that already begin with RUN.
fn rl_runln to void
o = new uchar 8192 0
pa = new uchar 4096 0
na = rl_stp pa rlrout
c = rl_cntpre part pa 0 na rlrunp
p = rl_cat o 0 rlrunp
p = rl_dec o p c
p = rl_cat o p rlsp
p = rl_date o p
p = rl_cat o p rlnl
fd = fopen pa 0 na 525377 438
if ge fd 0
x = rl_wall int fd part o 0 p
end
rl_close fd
end

note Append one record per newline-terminated line of STATE/objs.txt (while read -r); set the
note count to 9 plus the objectives; the end.
fn rl_pkobj pk edit uchar 4096 p ulong to ulong
b = new uchar 65536 0
n = rl_stsl rlobjs b
if lt n 0
rl_diea rlmobj 2 1
end
c = ulong 9
s = ulong 0
q = p
while lt s ulong n bound 65536
e = rl_eol part b 0 ulong n s
if ge e ulong n
break
end
q = rl_pk pk q part b s sub e s
c = add c 1
s = add e 1
end
rl_pkc pk c
ret q
end

note BIN/code-main BIN/infer BIN/tool OMC STATE/root STATE/work STATE/journal PORT VIEW
note objectives..., stdin /dev/null, stdout >> run.out, stderr >> run.err; the PID.
fn rl_node to long
pk = new uchar 4096 0
p = rl_pke pk 2 rlkbin rlxcm
p = rl_pke pk p rlkbin rlxinf
p = rl_pke pk p rlkbin rlxtool
p = rl_pkv pk p rlkomc
p = rl_pks pk p rlxroot
p = rl_pks pk p rlxwork
p = rl_pks pk p rlxjour
p = rl_pkv pk p rlkport
p = rl_pkv pk p rlkview
p = rl_pkobj pk p
fi = rl_open rlnull 524288 0
fo = rl_stopen rlrout 525377 438
fe = rl_stopen rlrerr 525377 438
if or or lt fi 0 lt fo 0 lt fe 0
rl_die rlmspn 1
end
pid = rl_spawn part pk 0 p fi fo fe
rl_close fi
rl_close fo
rl_close fe
if lt pid 0
rl_die rlmspn 1
end
ret pid
end

note Wait until the view answers (300 times 0.1 s) while the node lives.
fn rl_nwait to void
for i ulong 300
if eq rl_opv rlnull 1 0
ret
end
if rl_alive rlnpid
else
rl_diet rlmnex rlrout
end
if ge i 299
rl_die rlmv30 1
end
x = sleepns 100000000
end
end

note Start the node on STATE with release.env (start and restore).
fn rl_runn to int
o = new uchar 8192 0
if rl_alive rlnpid
rl_diep rlmnrun rlnpid 3
end
rl_stmkp rljour
rl_stmkp rlwork
rl_runln
pid = rl_node
rl_wpid rlnpid pid
rl_nwait
if ne rl_view 0
rl_die rlmv2 1
end
p = rl_cat o 0 rlond1
p = rl_stfcat rlnpid o p
p = rl_cat o p rlond2
p = rl_env rlkview o p
p = rl_ofj o p rlond3 rlfinc
p = rl_ofj o p rlond4 rlfver
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end

note The logical absolute form of directory argument i (as cd DIR && pwd) into o; its length.
fn rl_absd i ulong o edit uchar * to ulong
t = new uchar 8192 0
n = ulong 0
a = rl_arg i part t 4096 4096
if eq a 0
rl_diea rlmbin i 2
end
if ne get t 4096 47
c = cwd t 0 4096
if le c 1
rl_diea rlmbin i 2
end
n = sub ulong c 1
put t n 47
n = add n 1
end
for j ulong a
put t add n j get t add 4096 j
end
q = rl_norm part t 0 add n a o
if rl_isdir part o 0 q
ret q
end
rl_diea rlmbin i 2
ret 0
end

note Remove empty, . and .. components of the absolute path t into o; its length.
fn rl_norm t view uchar * o edit uchar * to ulong
q = ulong 0
s = ulong 0
n = len t
while lt s n bound 8192
if eq get t s 47
s = add s 1
continue
end
e = s
while lt e n bound 8192
if eq get t e 47
break
end
e = add e 1
end
k = sub e s
if and eq k 1 eq get t s 46
s = e
continue
end
if eq k 2
if and eq get t s 46 eq get t add s 1 46
while gt q 0 bound 8192
q = sub q 1
if eq get o q 47
break
end
end
s = e
continue
end
end
put o q 47
q = rl_cat o add q 1 part t s k
s = e
end
if eq q 0
put o 0 47
q = 1
end
ret q
end

fn rl_start to int
b = new uchar 16384 0
pa = new uchar 4096 0
if ne argcnt 7
rl_die rlust 2
end
rl_no18 5
rl_no18 6
n = rl_arg 2 pa
r = rl_mkp part pa 0 n
if lt r 0
rl_diea rlmdir 2 1
end
p = rl_cat b 0 rlkbin
put b p 61
q = rl_absd 3 part b add p 1 4096
p = add add p 1 q
p = rl_envl b p rlkomc 4
p = rl_envl b p rlkport 5
p = rl_envl b p rlkview 6
put b p 10
n = rl_stp pa rlenvf
fd = fopen pa 0 n 524865 438
if ge fd 0
x = rl_wall int fd part b 0 add p 1
end
rl_close fd
rl_envck
ret rl_runn
end

note Append "\nkey=argument i" to b at p.
fn rl_envl b edit uchar 16384 p ulong key view uchar * i ulong to ulong
put b p 10
q = rl_cat b add p 1 key
put b q 61
n = rl_arg i part b add q 1 4096
ret add add q 1 n
end

fn rl_health to int
o = new uchar 8192 0
pk = new uchar 4096 0
rl_envck
p = rl_opk pk rlkport
p = rl_pk pk p rlwhlth
rl_pkc pk 3
fo = rl_stopen rlhj 524865 438
m = int 2
if ge fo 0
m = rl_run part pk 0 p -1 fo -1
end
rl_close fo
v = rl_view
q = rl_cat o 0 rlohm
q = rl_dec o q ulong m
q = rl_cat o q rlsp
q = rl_stfcat rlhj o q
q = rl_cat o q rlohn
q = rl_dec o q ulong v
q = rl_ofj o q rlond3 rlfinc
q = rl_ofj o q rlohr rlfrun
q = rl_ofj o q rlohj rlfjf
q = rl_cat o q rlnl
x = rl_wall 1 part o 0 q
if and eq m 0 eq v 0
ret 0
end
ret 1
end

note Wait until nothing runs or is in review (9000 times 0.1 s).
fn rl_drain to void
for i ulong 9000
if eq rl_view 0
if and rl_vis rlvjs rlfrun rlzero rl_vis rlvjs rlfrev rlzero
ret
end
else
if rl_alive rlnpid
else
rl_die rlmnxs 1
end
end
if ge i 8999
rl_die rlm900 1
end
x = sleepns 100000000
end
end

note cp STATE/view.json STATE/view-at-stop.json
fn rl_vcopy to void
pa = new uchar 4096 0
n = rl_stp pa rlvjs
fd = rl_stopen rlvst 524865 438
if ge fd 0
r = rl_fout part pa 0 n int fd
end
rl_close fd
end

fn rl_stop to int
o = new uchar 8192 0
rl_envck
if rl_alive rlnpid
else
rl_die rlmnnr 3
end
if ne rl_post rlone 0
rl_die rlmpau 1
end
rl_drain
rl_vcopy
pid = rl_pidf rlnpid
x = killpid int pid 15
rl_gone pid
p = rl_cat o 0 rlost
p = rl_dec o p ulong pid
p = rl_ofs o p rlohr rlfrun
p = rl_ofs o p rlosw rlfwait
p = rl_ofs o p rlosy rlfrdy
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end

note The creator publishes its view snapshot after it commits a command, so a view read right
note after the resume's committed ack can predate it (observed: ack journal_seq 24, view 22 with
note paused 1). Report only a view at or past the ack's journal_seq: up to 50 reads 0.1 s apart,
note else exit 1. Every ack carries journal_seq (the creator's, or 0 for the view's own verdict).
fn rl_rest to int
o = new uchar 8192 0
rl_envck
r = rl_runn
w = ulong 0
if rl_vis rlvjs rlfpau rlone
if ne rl_post rltwo 0
rl_die rlmres 1
end
w = rl_vnum rlack rlfjsq
x = rl_wall 1 rlnl
end
for i ulong 50
if ne rl_view 0
rl_die rlmvno 1
end
if ge rl_vnum rlvjs rlfjsq w
break
end
if ge i 49
rl_die rlmvlag 1
end
x = sleepns 100000000
end
p = rl_cat o 0 rlors
p = rl_vf rlvjs rlfinc o p
p = rl_ofj o p rlorp rlfpau
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
ret 0
end

note ======== snapshot and rollback

note Copy the tree rlsrc[0, sl) to the new path rldst[0, dl), not following symbolic links:
note directories, regular files (bytes and permission bits) and symbolic links. 0 or a
note negative error (-22 another file type, -40 deeper than 64).
fn rl_cpt sl ulong dl ulong dp ulong to long
st = new uchar 128 0
r = lstat rlsrc 0 sl st 0 128
if lt r 0
ret r
end
md = or ulong get st 16 shl ulong get st 17 8
ty = and md 61440
if eq ty 16384
if gt dp 64
ret -40
end
r = makedir rldst 0 dl 448
if lt r 0
ret r
end
r = rl_cpdl sl dl dp
if lt r 0
ret r
end
put rlcn 1 add get rlcn 1 1
ret chmod rldst 0 dl int and md 4095
end
if eq ty 32768
ret rl_cpf sl dl and md 4095
end
if eq ty 40960
ret rl_cpl sl dl
end
ret -22
end

note Copy every entry of the directory rlsrc[0, sl) into rldst[0, dl).
fn rl_cpdl sl ulong dl ulong dp ulong to long
bf = new uchar 8192 0
fd = fopen rlsrc 0 sl 573440 0
if lt fd 0
ret fd
end
r = long 0
for it ulong 16777216
k = getdnts int fd bf 0 8192
if le k 0
r = k
break
end
off = ulong 0
while lt off ulong k bound 8192
r = rl_cpe bf off sl dl dp
if lt r 0
rl_close fd
ret r
end
off = add off rl_rec bf off
end
end
rl_close fd
ret r
end

note The record length of the getdnts entry at bf[off) (at least 1).
fn rl_rec bf view uchar 8192 off ulong to ulong
v = or ulong get bf add off 16 shl ulong get bf add off 17 8
if eq v 0
ret 8192
end
ret v
end

note The entry name at bf[off + 19..) (zero-terminated) appended after "/" to both stacks
note and copied; . and .. skipped.
fn rl_cpe bf view uchar 8192 off ulong sl ulong dl ulong dp ulong to long
s = add off 19
e = s
while ne get bf e 0 bound 8192
e = add e 1
end
k = sub e s
if le k 2
if eq get bf s 46
if eq k 1
ret 0
end
if eq get bf add s 1 46
ret 0
end
end
end
if or gt add add sl k 1 4095 gt add add dl k 1 4095
ret -36
end
put rlsrc sl 47
put rldst dl 47
sl = add sl 1
dl = add dl 1
for i ulong k
c = get bf add s i
put rlsrc add sl i c
put rldst add dl i c
end
ret rl_cpt add sl k add dl k add dp 1
end

note Copy the regular file rlsrc[0, sl) to the new file rldst[0, dl) with mode pm, synced.
fn rl_cpf sl ulong dl ulong pm ulong to long
b = new uchar 65536 0
fi = fopen rlsrc 0 sl 557056 0
if lt fi 0
ret fi
end
fo = fopen rldst 0 dl 524481 384
if lt fo 0
rl_close fi
ret fo
end
r = long 0
for it ulong 16777216
k = read int fi b 0 65536
if le k 0
r = k
break
end
r = rl_wall int fo part b 0 ulong k
if lt r 0
break
end
put rlcn 3 add get rlcn 3 ulong k
end
if ge r 0
r = fchmod int fo int pm
end
if ge r 0
r = fsync int fo
end
rl_close fi
rl_close fo
put rlcn 0 add get rlcn 0 1
ret r
end

note Recreate the symbolic link rlsrc[0, sl) at rldst[0, dl).
fn rl_cpl sl ulong dl ulong to long
t = new uchar 4096 0
pk = new uchar 4096 0
k = readlnk rlsrc 0 sl t 0 4096
if le k 0
ret -36
end
put pk 0 2
p = rl_pk pk 2 part t 0 ulong k
if gt add add p 2 dl 4096
ret -36
end
put pk p uchar and dl 255
put pk add p 1 uchar shr dl 8
for i ulong dl
put pk add add p 2 i get rldst i
end
put rlcn 2 add get rlcn 2 1
ret symlnk pk 0 add add p 2 dl
end

note Remove the tree rlsrc[0, sl) without following symbolic links; a missing path is 0.
fn rl_rmt sl ulong dp ulong to long
st = new uchar 128 0
r = lstat rlsrc 0 sl st 0 128
if eq r -2
ret 0
end
if lt r 0
ret r
end
if eq and or ulong get st 16 shl ulong get st 17 8 61440 16384
if gt dp 64
ret -40
end
r = rl_rmdl sl dp
if lt r 0
ret r
end
ret rmdir rlsrc 0 sl
end
ret unlink rlsrc 0 sl
end

note Empty the directory rlsrc[0, sl): read one batch, remove it, again until a batch
note holds only . and ..
fn rl_rmdl sl ulong dp ulong to long
bf = new uchar 8192 0
for it ulong 1000000
fd = fopen rlsrc 0 sl 573440 0
if lt fd 0
ret fd
end
k = getdnts int fd bf 0 8192
rl_close fd
if lt k 0
ret k
end
c = ulong 0
off = ulong 0
while lt off ulong k bound 8192
r = rl_rme bf off sl dp
if lt r 0
ret r
end
c = add c ulong r
off = add off rl_rec bf off
end
if eq c 0
ret 0
end
end
ret -11
end

note Remove the entry at bf[off + 19..) of rlsrc[0, sl): 1 removed, 0 . or .., or an error.
fn rl_rme bf view uchar 8192 off ulong sl ulong dp ulong to long
s = add off 19
e = s
while ne get bf e 0 bound 8192
e = add e 1
end
k = sub e s
if le k 2
if eq get bf s 46
if eq k 1
ret 0
end
if eq get bf add s 1 46
ret 0
end
end
end
if gt add add sl k 1 4095
ret -36
end
put rlsrc sl 47
for i ulong k
put rlsrc add add sl 1 i get bf add s i
end
r = rl_rmt add add sl k 1 add dp 1
if lt r 0
ret r
end
ret 1
end

note rlsrc = argument i "/" nm, or rldst when ds; the length.
fn rl_setp i ulong nm view uchar * ds bool to ulong
b = new uchar 4096 0
n = rl_arg i b
put b n 47
n = rl_cat b add n 1 nm
if gt n 4095
rl_die rlmlong 2
end
for j ulong n
if ds
put rldst j get b j
else
put rlsrc j get b j
end
end
ret n
end

note Die "MSG<argument i>/nm (error r)".
fn rl_dief m view uchar * i ulong nm view uchar * r long to void
o = new uchar 8192 0
p = rl_cat o 0 m
q = rl_arg i part o p 4096
p = add p q
put o p 47
p = rl_cat o add p 1 nm
p = rl_cat o p rlmerr
p = rl_dec o p ulong neg r
p = rl_cat o p rlmcl
rl_die part o 0 p 1
end

note Copy argument si "/" nm to argument di "/" nm.
fn rl_cp1 si ulong di ulong nm view uchar * to void
sl = rl_setp si nm false
dl = rl_setp di nm true
r = rl_cpt sl dl 0
if lt r 0
rl_dief rlmcp si nm r
end
end

note Remove argument i "/" nm.
fn rl_rm1 i ulong nm view uchar * to void
sl = rl_setp i nm false
r = rl_rmt sl 0
if lt r 0
rl_dief rlmrm i nm r
end
end

note Die unless argument i "/" nm is a directory.
fn rl_isd1 i ulong nm view uchar * to void
b = new uchar 4096 0
n = rl_arg i b
put b n 47
n = rl_cat b add n 1 nm
if rl_isdir part b 0 n
ret
end
o = new uchar 8192 0
p = rl_cat o 0 rlmsnap
p = rl_cat o p part b 0 n
rl_die part o 0 p 1
end

note "snapshot SNAP files F dirs D links L bytes B" (or rollback STATE ...).
fn rl_copied lb view uchar * i ulong to void
o = new uchar 8192 0
p = rl_cat o 0 lb
q = rl_arg i part o p 4096
p = add p q
p = rl_cat o p rlocf
p = rl_dec o p get rlcn 0
p = rl_cat o p rlocd
p = rl_dec o p get rlcn 1
p = rl_cat o p rlocl
p = rl_dec o p get rlcn 2
p = rl_cat o p rlocb
p = rl_dec o p get rlcn 3
p = rl_cat o p rlnl
x = rl_wall 1 part o 0 p
end

fn rl_snap to int
b = new uchar 4096 0
if ne argcnt 4
rl_die rlusr 2
end
if rl_alive rlnpid
rl_diep rlmnrun rlnpid 3
end
n = rl_arg 3 b
r = rl_mkp part b 0 n
if lt r 0
rl_diea rlmdir 3 1
end
rl_cp1 2 3 rlroot
rl_cp1 2 3 rlwork
rl_cp1 2 3 rljour
rl_copied rlosn 3
ret 0
end

fn rl_rollb to int
if ne argcnt 4
rl_die rlusr 2
end
if rl_alive rlnpid
rl_diep rlmnrun rlnpid 3
end
rl_isd1 3 rlroot
rl_isd1 3 rlwork
rl_isd1 3 rljour
rl_rm1 2 rlroot
rl_cp1 3 2 rlroot
rl_rm1 2 rlwork
rl_cp1 3 2 rlwork
rl_rm1 2 rljour
rl_cp1 3 2 rljour
rl_copied rlorb 2
ret 0
end

note ======== main

fn main to int
c = new uchar 4096 0
if lt argcnt 3
rl_die rlusage 2
end
n = rl_arg 1 c
if rl_eq part c 0 n rlcbld
ret rl_build
end
if rl_eq part c 0 n rlcsrv
ret rl_serve
end
if rl_eq part c 0 n rlcsta
ret rl_start
end
if rl_eq part c 0 n rlchlt
ret rl_health
end
if rl_eq part c 0 n rlcstp
ret rl_stop
end
if rl_eq part c 0 n rlcres
ret rl_rest
end
if rl_eq part c 0 n rlcuns
ret rl_unsrv
end
if rl_eq part c 0 n rlcsnp
ret rl_snap
end
if rl_eq part c 0 n rlcrb
ret rl_rollb
end
rl_diea rlmunk 1 2
ret 2
end

note seed/node/live-cpu.om -- the DRA-399 core 8/9 contamination sampler.
note live-cpu STOP WATCH (absolute paths): every 10 s, until the file STOP
note exists, read /proc/*/task/*/stat and print one line
note   CPU <realns> cwo <c> run89 <r> own <o> foreign <f> [ pid/tid:comm]...
note run89 counts the threads in state R whose processor (stat field 39)
note is 8 or 9. own counts those whose process argv0 starts with
note /tmp/wtlive/build/node/ or is the pinned ollm; foreign counts the
note rest, and each foreign thread is named. cwo counts the lines of WATCH
note that start with "CWO " (the objective boundaries; 0 while WATCH is
note absent). Only read-only /proc and WATCH reads. Exit 0 once STOP
note appears, 2 on bad usage.

text kproc "/proc/"
text ktask "/task/"
text kstat "/stat"
text kcmd "/cmdline"
text kown1 "/tmp/wtlive/build/node/"
text kown2 "/home/drakestapleton/work/omega-node-ollm/ollm"
text kcwo "CWO "
text kcpu "CPU"
text kcwow "cwo"
text krun "run89"
text kownw "own"
text kfor "foreign"
text kdone "CPU done samples"
text kuse "CPU usage: live-cpu STOP WATCH (absolute paths)"

note ca: argument k at 1024 (k - 1), lengths in cl.
global ca uchar 2048
global cl ulong 4
global cp uchar 1024
global cpn ulong 1
global co uchar 16384
global con ulong 1
global cs ulong 4

fn c_dig v ulong d edit uchar 24 to ulong
k = ulong 0
x = v
for i ulong 24
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
ret k
end

fn co_c c ulong to void
n = get con 0
if or lt n 16300 and eq c 10 lt n 16384
put co n uchar c
put con 0 add n 1
end
end

fn co_t a view uchar * to void
for i ulong len a
co_c ulong get a i
end
end

fn co_n v ulong to void
d = new uchar 24 0
k = c_dig v d
for j ulong k
co_c ulong get d sub sub k j 1
end
end

fn co_kv k view uchar * v ulong to void
co_c 32
co_t k
co_c 32
co_n v
end

fn co_e to void
co_c 10
n = get con 0
p = ulong 0
for it ulong 4096
if ge p n
break
end
r = write 1 co p sub n p
if le r 0
break
end
p = add p ulong r
end
put con 0 0
end

fn cp_c c ulong to void
n = get cpn 0
if lt n 1000
put cp n uchar c
put cpn 0 add n 1
end
end

fn cp_t a view uchar * to void
for i ulong len a
cp_c ulong get a i
end
end

fn cp_n v ulong to void
d = new uchar 24 0
k = c_dig v d
for j ulong k
cp_c ulong get d sub sub k j 1
end
end

fn c_pfx a view uchar * p view uchar * to bool
if lt len a len p
ret false
end
for i ulong len p
if ne get a i get p i
ret false
end
end
ret true
end

note Field k (0 = the state) of a stat line, counted from offset s.
fn c_fld a view uchar * s ulong k ulong to ulong
t = ulong 0
v = ulong 0
for i ulong sub len a s
ch = ulong get a add s i
if eq ch 32
if eq t k
ret v
end
t = add t 1
else
if eq t k
v = add mul v 10 sub ch 48
end
end
end
ret v
end

fn c_cmdm a view uchar * to bool
if c_pfx a kown1
ret true
end
if c_pfx a kown2
if gt len a len kown2
ret eq get a len kown2 0
end
end
ret false
end

fn c_own pid ulong to bool
b = new uchar 512 0
put cpn 0 0
cp_t kproc
cp_n pid
cp_t kcmd
fd = fopen cp 0 get cpn 0 0 0
if lt fd 0
ret false
end
n = read int fd b 0 512
r = fclose int fd
if le n 0
ret false
end
ret c_cmdm view part b 0 ulong n
end

fn c_comm a view uchar * q ulong to void
s = ulong 0
for i ulong q
if and eq s 0 eq get a i 40
s = add i 1
end
end
for i ulong sub q s
co_c ulong get a add s i
end
end

fn c_thr pid ulong tid ulong a view uchar * to void
q = len a
for i ulong len a
if eq get a i 41
q = i
end
end
if ge add q 3 len a
ret
end
if ne get a add q 2 82
ret
end
cpu = c_fld a add q 2 36
if and ne cpu 8 ne cpu 9
ret
end
put cs 0 add get cs 0 1
if c_own pid
put cs 1 add get cs 1 1
ret
end
put cs 2 add get cs 2 1
co_c 32
co_n pid
co_c 47
co_n tid
co_c 58
c_comm a q
end

fn c_tid pid ulong tid ulong to void
b = new uchar 1024 0
put cpn 0 0
cp_t kproc
cp_n pid
cp_t ktask
cp_n tid
cp_t kstat
fd = fopen cp 0 get cpn 0 0 0
if lt fd 0
ret
end
n = read int fd b 0 1024
r = fclose int fd
if le n 0
ret
end
c_thr pid tid view part b 0 ulong n
end

note The decimal name of the dirent at p, or 0.
fn c_num d view uchar 32768 p ulong to ulong
v = ulong 0
k = ulong 0
for i ulong 24
ch = ulong get d add add p 19 i
if eq ch 0
break
end
if or lt ch 48 gt ch 57
ret 0
end
v = add mul v 10 sub ch 48
k = add k 1
end
if eq k 0
ret 0
end
ret v
end

fn c_task pid ulong to void
d = new uchar 32768 0
put cpn 0 0
cp_t kproc
cp_n pid
cp_t ktask
fd = fopen cp 0 get cpn 0 16384 0
if lt fd 0
ret
end
for it ulong 10000
n = getdnts int fd d 0 32768
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 100000
w = or ulong get d add p 16 shl ulong get d add p 17 8
if eq w 0
break
end
t = c_num d p
if gt t 0
c_tid pid t
end
p = add p w
end
end
r = fclose int fd
end

fn c_scan to void
d = new uchar 32768 0
put cpn 0 0
cp_t kproc
fd = fopen cp 0 get cpn 0 16384 0
if lt fd 0
ret
end
for it ulong 10000
n = getdnts int fd d 0 32768
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 100000
w = or ulong get d add p 16 shl ulong get d add p 17 8
if eq w 0
break
end
t = c_num d p
if gt t 0
c_task t
end
p = add p w
end
end
r = fclose int fd
end

note Lines of WATCH that start with "CWO ".
fn c_cwo to ulong
b = new uchar 65536 0
fd = fopen ca 1024 get cl 1 0 0
if lt fd 0
ret 0
end
c = ulong 0
m = ulong 0
for it ulong 100000
n = read int fd b 0 65536
if le n 0
break
end
for i ulong ulong n
ch = ulong get b i
if eq ch 10
m = 0
else
if lt m 4
if eq ch ulong get kcwo m
m = add m 1
if eq m 4
c = add c 1
end
else
m = 99
end
end
end
end
end
r = fclose int fd
ret c
end

fn c_stop to bool
fd = fopen ca 0 get cl 0 0 0
if lt fd 0
ret false
end
r = fclose int fd
ret true
end

fn c_arg k ulong to bool
n = argread k ca mul sub k 1 1024 1023
if or lt n 2 gt n 1022
ret false
end
put cl sub k 1 ulong n
ret eq get ca mul sub k 1 1024 47
end

note c_scan has left the foreign thread names in co; print the counts
note first, then those names, as one line.
fn c_line to void
s = new uchar 16384 0
n = get con 0
for i ulong n
put s i get co i
end
put con 0 0
co_t kcpu
co_c 32
co_n ulong realns
co_kv kcwow c_cwo
co_kv krun get cs 0
co_kv kownw get cs 1
co_kv kfor get cs 2
for i ulong n
co_c ulong get s i
end
co_e
end

fn c_once to void
put cs 0 0
put cs 1 0
put cs 2 0
put con 0 0
c_scan
c_line
end

fn main to int
c = ulong argcnt
ok = eq c 3
if ok
ok = and c_arg 1 c_arg 2
end
if not ok
co_t kuse
co_e
ret 2
end
k = ulong 0
for it ulong 100000
c_once
k = add k 1
if c_stop
break
end
q = sleepns 10000000000
end
co_t kdone
co_c 32
co_n k
co_e
ret 0
end

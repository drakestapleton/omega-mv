note seed/node/gram.om -- the bounded repair grammar of the round40 protocol
note (repair.py PATTERNS), shared by the tool adapter (seed/node/tool.om,
note which checks a file) and the coding workflow (seed/node/code.om, whose
note creator checks a proposed edit before granting it). Compiles as OM-1 and
note OM-2; compose before its user. Lines are split at newline bytes only,
note after the source is trimmed of ASCII white space (bytes 0..32).
note Lines: fn calc x int to int | fn main to int | end | s = x | ret s |
note ret (add|mul|sub) x int [1-6] | ret calc int \d{1,2} |
note for i ulong [1-6] | s = add s int [1-6].
note Catalog mode (grcat[0] = 1, set by the program before any check;
note SemC DRA-323): one more line form, a call of a catalog entry with
note bare number arguments: ret NAME x D... with NAME 1..32 bytes of
note [a-z0-9_] starting with a letter and 1..4 arguments of 1..2 digits.
note The resolver and omc decide whether NAME is a locked entry.
text gcalc "fn calc x int to int"
text gmain "fn main to int"
text gend "end"
text gradd "ret add x int "
text grmul "ret mul x int "
text grsub "ret sub x int "
text grcal "ret calc int "
text gsx "s = x"
text gfor "for i ulong "
text gsadd "s = add s int "
text grets "ret s"
text grret "ret "
global grcat ulong 1

note Grammar text k (0 calc, 1 main, 2 end, 3 s = x, 4 ret s, 5 ret calc
note int, 6 ret add, 7 ret mul, 8 ret sub, 9 for, 10 s = add): its length.
fn gr_tln k ulong to ulong
if eq k 0
ret len gcalc
end
if eq k 1
ret len gmain
end
if eq k 2
ret len gend
end
if eq k 3
ret len gsx
end
if eq k 4
ret len grets
end
if eq k 5
ret len grcal
end
if le k 8
ret len gradd
end
if eq k 9
ret len gfor
end
ret len gsadd
end

note Byte i of grammar text k.
fn gr_tch k ulong i ulong to uchar
if eq k 0
ret get gcalc i
end
if eq k 1
ret get gmain i
end
if eq k 2
ret get gend i
end
if eq k 3
ret get gsx i
end
if eq k 4
ret get grets i
end
if eq k 5
ret get grcal i
end
if eq k 6
ret get gradd i
end
if eq k 7
ret get grmul i
end
if eq k 8
ret get grsub i
end
if eq k 9
ret get gfor i
end
ret get gsadd i
end

note Line s[a, e) is text k followed by one digit 1..6 when dg is 1, by one
note or two digits when dg is 2, or exactly text k when dg is 0.
fn gr_lin s view uchar 4096 a ulong e ulong k ulong dg ulong to bool
n = gr_tln k
if lt sub e a n
ret false
end
for i ulong n
if ne get s add a i gr_tch k i
ret false
end
end
r = sub sub e a n
if eq dg 0
ret eq r 0
end
if eq dg 1
if ne r 1
ret false
end
c = get s add a n
ret and ge c 49 le c 54
end
if or eq r 0 gt r 2
ret false
end
for j ulong r
c = get s add add a n j
if or lt c 48 gt c 57
ret false
end
end
ret true
end

note Line s[a, e) is in the grammar.
fn gr_gram s view uchar 4096 a ulong e ulong to bool
for k ulong 5
if gr_lin s a e k 0
ret true
end
end
if gr_lin s a e 5 2
ret true
end
for k2 ulong 5
if gr_lin s a e add 6 k2 1
ret true
end
end
if eq get grcat 0 1
if gt gr_ccall s a e 0
ret true
end
end
ret false
end

note Line s[a, e) is a catalog call line ret NAME x D...: the length of
note NAME (from a + 4), or 0 when it is not one.
fn gr_ccall s view uchar 4096 a ulong e ulong to ulong
if lt sub e a 9
ret 0
end
for i ulong 4
if ne get s add a i get grret i
ret 0
end
end
p = add a 4
c = get s p
if or lt c 97 gt c 122
ret 0
end
m = ulong 0
for j ulong 33
if ge p e
ret 0
end
c = get s p
if eq c 32
break
end
if not gr_idch c
ret 0
end
p = add p 1
m = add m 1
end
if gt m 32
ret 0
end
if gt add p 2 e
ret 0
end
if ne get s p 32
ret 0
end
if ne get s add p 1 120
ret 0
end
if not gr_cargs s add p 2 e
ret 0
end
ret m
end

note s[p, e) is 1..4 arguments, each a space and 1..2 digits.
fn gr_cargs s view uchar 4096 p0 ulong e ulong to bool
p = p0
na = ulong 0
for q ulong 5
if ge p e
break
end
if ne get s p 32
ret false
end
p = add p 1
nd = ulong 0
for r ulong 3
if ge p e
break
end
c = get s p
if eq c 32
break
end
if or lt c 48 gt c 57
ret false
end
nd = add nd 1
p = add p 1
end
if or eq nd 0 gt nd 2
ret false
end
na = add na 1
end
if or eq na 0 gt na 4
ret false
end
ret ge p e
end

note c is a byte of a catalog name: a-z, 0-9 or _.
fn gr_idch c uchar to bool
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
ret eq c 95
end

note The end of the line that starts at a (a newline or e).
fn gr_eol b view uchar 4096 a ulong e ulong to ulong
z = a
for j ulong sub e a
if eq get b z 10
ret z
end
z = add z 1
end
ret z
end

note Every line of b[0, n), trimmed, is in the grammar (an empty source too).
fn gr_src b view uchar 4096 n ulong to bool
s = ulong 0
for i ulong n
if gt get b s 32
break
end
s = add s 1
end
e = n
for j ulong sub n s
if gt get b sub e 1 32
break
end
e = sub e 1
end
if ge s e
ret true
end
a = s
for it ulong add n 1
if gt a e
ret true
end
z = gr_eol b a e
if not gr_gram b a z
ret false
end
a = add z 1
end
ret true
end

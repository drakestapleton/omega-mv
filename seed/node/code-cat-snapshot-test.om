note Snapshot isolation probe. RESOLVE CATALOG LOCK ROOT WORK.
note Prints private paths, waits one stdin byte while referee changes originals,
note then requires an identical signature card from the snapshot.
fn main to int
if ne argcnt 6
ret 2
end
if not cw_carg 1 7
ret 3
end
if not cw_carg 2 8
ret 3
end
if not cw_carg 3 9
ret 3
end
if not cw_carg 4 3
ret 3
end
if not cw_carg 5 4
ret 3
end
if not cc_snapshot
ret 58
end
if cc_snapshot
ret 23
end
put cwct 1 1
if ne cc_run 0
ret 56
end
if ne cc_load 1 0
ret 57
end
before = new uchar 4096 0
n = cw_ld before 20 0
path = new uchar 4096 0
pn = cw_ld path 18 0
cw_out path pn
cw_out cwnl 1
pn = cw_ld path 19 0
cw_out path pn
cw_out cwnl 1
one = new uchar 1 0
if ne read 0 one 0 1 1
ret 20
end
if ne cc_run 0
ret 56
end
if ne cc_load 1 0
ret 57
end
after = new uchar 4096 0
if ne cw_ld after 20 0 n
ret 21
end
for i ulong n
if ne get before i get after i
ret 22
end
end
ret 0
end

note seed/node/op.om -- omnode-op, the operator's client of the Omega Node
note view (DRA-291, seed/node/view.om). OM-2; compose after seed/net/http.om
note and seed/net/notls.om.
note   omnode-op PORT view [SINCE INC]        GET /view, the body on stdout
note   omnode-op PORT cmd ID OP TARGET INC VER [A [B [C [D]]]]
note                                          POST /cmd, the acknowledgement
note PORT is on 127.0.0.1 (never 18091). Exit 0 for 200, 1 for 409 (stale),
note 400 (invalid) or 500 (refused), 3 for 503 (busy) or 504 (pending: post
note again with the same ID), 4 no connection or no response in 10 s, 5
note other statuses, 2 usage.
text opview "view"
text opcmd "cmd"
text opget "GET"
text oppost "POST"
text ophost "Host"
text ophostv "127.0.0.1"
text oppv "/view"
text oppc "/cmd"
text opks "?since="
text opki "&inc="
text opnames "?id=,&op=,&target=,&inc=,&ver=,&a=,&b=,&c=,&d=,"
text opnl "\n"

note The decimal argument i, or all ones when it is not 1..19 digits.
fn op_num i ulong to ulong
b = new uchar 32 0
n = argread i b 0 32
if or lt n 1 gt n 19
ret not ulong 0
end
v = ulong 0
for j ulong ulong n
c = ulong get b j
if or lt c 48 gt c 57
ret not ulong 0
end
v = add mul v 10 sub c 48
end
ret v
end

note Append a to o at p; past 1000 bytes the result is 2000 (overflow), and
note an overflowed p stays overflowed.
fn op_cat o edit uchar 1024 p ulong a view uchar * to ulong
if gt add p len a 1000
ret 2000
end
for i ulong len a
put o add p i get a i
end
ret add p len a
end

fn op_dec o edit uchar 1024 p ulong v ulong to ulong
d = new uchar 20 0
k = ulong 20
x = v
for it ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
ret op_cat o p view part d k sub 20 k
end

note The request target into t; its length, or 0 on a usage error.
fn op_target t edit uchar 1024 to ulong
w = new uchar 8 0
n = argread 2 w 0 8
c = ulong argcnt
if heq view part w 0 ulong n opview
p = op_cat t 0 oppv
if eq c 3
ret p
end
if ne c 5
ret 0
end
p = op_cat t p opks
p = op_arg t p 3
p = op_cat t p opki
ret op_arg t p 4
end
if not heq view part w 0 ulong n opcmd
ret 0
end
if or lt c 8 gt c 12
ret 0
end
p = op_cat t 0 oppc
for i ulong sub c 3
p = op_qn t p i
p = op_arg t p add i 3
end
ret p
end

note Append the i-th comma-terminated name of opnames.
fn op_qn t edit uchar 1024 p ulong i ulong to ulong
s = ulong 0
m = ulong 0
for j ulong len opnames
if eq get opnames j 44
if eq m i
ret op_cat t p view part opnames s sub j s
end
m = add m 1
s = add j 1
end
end
ret p
end

note Decimal argument i at t[p]; p past the end when it is not a number.
fn op_arg t edit uchar 1024 p ulong i ulong to ulong
v = op_num i
if eq v not ulong 0
ret 2000
end
ret op_dec t p v
end

fn op_main to int
cs = new ulong 320 0
io = new uchar 131072 0
t = new uchar 1024 0
a = new uchar 16 0
bd = new uchar 65536 0
if lt argcnt 3
ret 2
end
po = op_num 1
if or or eq po 0 gt po 65535 eq po 18091
ret 2
end
tn = op_target t
if or eq tn 0 gt tn 1000
ret 2
end
r = haddr4 a 2130706433 po
fd = hdial a 5000000000
if lt fd 0
ret 4
end
r = hinit cs io int fd 0
hsettmo cs 10000000000 10000000000
hsetbdl cs 10000000000
st = op_req cs io view part t 0 tn
if lt st 0
x = hclose cs
ret 4
end
n = hbodyall cs io bd
x = hclose cs
if gt n 0
x = write 1 bd 0 ulong n
end
x = write 1 opnl 0 1
ret op_exit st
end

note Send the request (GET for /view, POST with no body for /cmd); the
note response status, or negative.
fn op_req cs edit ulong 320 io edit uchar 131072 t view uchar * to long
r = long 0
if eq get t 1 118
r = hreqst cs io opget
else
r = hreqst cs io oppost
end
r = hfe r hreqtg cs io t
r = hfe r hhname cs io ophost
r = hfe r hhval cs io ophostv
r = hfe r hhend cs io 0 0
r = hfe r hwfin cs io
if lt r 0
ret r
end
ret hrsprd cs io
end

fn op_exit st long to int
if eq st 200
ret 0
end
if or or eq st 409 eq st 400 eq st 500
ret 1
end
if or eq st 503 eq st 504
ret 3
end
ret 5
end

fn main to int
ret op_main
end

note K[0..63]: the first 32 bits of the fractional parts of the cube roots of the first 64 primes.
note Copied mechanically from seed/qualification/om2/fixtures/sha256-k.dec (tool-computed, never typed).
fn kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
end

note H(0): the first 32 bits of the fractional parts of the square roots of the first 8 primes
note (fixtures/sha256-iv.dec).
fn iv s edit uint 8 to void
put s 0 0x6a09e667
put s 1 0xbb67ae85
put s 2 0x3c6ef372
put s 3 0xa54ff53a
put s 4 0x510e527f
put s 5 0x9b05688c
put s 6 0x1f83d9ab
put s 7 0x5be0cd19
end

note Message schedule of the block m[o .. o+64). w is fresh: its incoming contents are never read.
note The compiler proves that every get of w reads an element written earlier in this function
note (error 27 otherwise): w[0..16) are the block's big-endian words, w[16..64) the FIPS recurrence.
fn sched w edit uint 64 fresh m view uchar * o ulong to void
q = ulong 0
x = uint 0
y = uint 0
for i ulong 16 unroll
q = add o mul i 4
x = uint get m q
x = or shl x 8 uint get m add q 1
x = or shl x 8 uint get m add q 2
put w i or shl x 8 uint get m add q 3
end
for i ulong 48 unroll
x = get w add i 1
y = get w add i 14
x = add add get w i get w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
put w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
end
end

note The 64 rounds on the chaining value s. One round body, emitted 64 times by unroll; i is a constant
note in each copy, so get kt i and get w i need no run-time check. uint arithmetic wraps mod 2^32.
note Ch(e,f,g) = (e and f) xor (not e and g) is written g xor (e and (f xor g)); Maj(a,b,c) =
note (a and b) xor (a and c) xor (b and c) is written (a and b) or (c and (a or b)). Both are bitwise
note identities. h first becomes T1, then T1 + T2, which is the next a; the names then shift by one.
note The sums are built a term per line and each Sigma in two lines through t: 12 names are live, and
note omc hands out 16 registers with no spilling (error 12 under compiler-s1/s2 for longer lines).
fn rounds s edit uint 8 w view uint 64 kt view uint 64 to void
a = get s 0
b = get s 1
c = get s 2
d = get s 3
e = get s 4
f = get s 5
g = get s 6
h = get s 7
t = uint 0
for i ulong 64 unroll
h = add h get kt i
h = add h get w i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
t = and c or a b
h = add h or and a b t
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put s 0 add get s 0 a
put s 1 add get s 1 b
put s 2 add get s 2 c
put s 3 add get s 3 d
put s 4 add get s 4 e
put s 5 add get s 5 f
put s 6 add get s 6 g
put s 7 add get s 7 h
end

note One block m[o .. o+64) into s. sched and rounds stay calls: inlined, their names would share
note one 16-register frame with this function's parameters (no spilling, error 12).
fn compress s edit uint 8 w edit uint 64 kt view uint 64 m view uchar * o ulong to void
sched w m o
rounds s w kt
end

note The whole blocks of m (len m is a multiple of 64 and at most 2^25, so under 2^19 passes).
fn run s edit uint 8 w edit uint 64 kt view uint 64 m view uchar * to void
for j ulong shr len m 6
compress s w kt m shl j 6
end
end

note The whole blocks of m (len m a multiple of 64). A rolled loop traps 4 after 1000000 passes
note (OMEGESE.md section 2; omc s_for), so m is cut into runs of 2^25 bytes (2^19 blocks):
note len m = top * 2^44 + mid * 2^25 + rest, and no loop passes 2^20 times. top reaches 1000000
note only above 1.7e19 bytes, which no AArch64 address space holds.
fn blocks s edit uint 8 w edit uint 64 kt view uint 64 m view uchar * to void
q = ulong 0
for a ulong shr len m 44
for b ulong 0x80000
run s w kt part m q 0x2000000
q = add q 0x2000000
end
end
for b ulong and shr len m 25 0x7ffff
run s w kt part m q 0x2000000
q = add q 0x2000000
end
run s w kt part m q sub len m q
end

note Pad the k pending bytes already in p (k < 64; p was all zero past them): 0x80, zeros, and the
note 64-bit big-endian bit length of the n-byte message in the last 8 bytes of one or two blocks.
fn finish s edit uint 8 w edit uint 64 kt view uint 64 p edit uchar 128 k ulong n ulong to void
put p k 0x80
e = ulong 64
if ge k 56
e = 128
end
bits = shl n 3
for i ulong 8 unroll
put p sub e add i 1 uchar and shr bits mul i 8 0xff
end
compress s w kt view p 0
if eq e 128
compress s w kt view p 64
end
end

fn sha256_init c edit shactx to void
s = new uint 8 0
iv s
for i ulong 8 unroll
put c state i get s i
end
put c count 0
end

note k bytes of d from o into the context's buffer at bi (bi + k <= 64). A function of its own: inside
note absorb the copy loop needs more than the 16 registers (error 12 under compiler-s4).
fn tobuf c edit shactx bi ulong d view uchar * o ulong k ulong to void
for i ulong k
put c buf add bi i get d add o i
end
end

note Whole blocks are hashed straight from d; the bytes that complete a pending block go through blk.
fn absorb c edit shactx d view uchar * bi ulong to void
n = len d
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
blk = new uchar 64 0
kinit kt
for i ulong 8 unroll
put s i get c state i
end
off = ulong 0
if gt bi 0
off = sub 64 bi
for i ulong bi
put blk i get c buf i
end
for i ulong off
put blk add bi i get d i
end
compress s w kt view blk 0
end
nb = shr sub n off 6
blocks s w kt part d off shl nb 6
off = add off shl nb 6
tobuf c 0 d off sub n off
for i ulong 8 unroll
put c state i get s i
end
end

note Any length, including 0 and >= 2^32. lt n sub 64 bi cannot wrap (bi < 64); add bi n could.
fn sha256_update c edit shactx d view uchar * to void
n = len d
cnt = get c count
bi = and cnt 63
put c count add cnt n
if lt n sub 64 bi
tobuf c bi d 0 n
ret
end
absorb c d bi
end

fn sha256_final c edit shactx o edit uchar 32 to void
s = new uint 8 0
w = new uint 64 0
kt = new uint 64 0
p = new uchar 128 0
v = ulong 0
kinit kt
for i ulong 8 unroll
put s i get c state i
end
cnt = get c count
k = and cnt 63
for i ulong k
put p i get c buf i
end
finish s w kt p k cnt
for i ulong 8 unroll
v = ulong get s i
for j ulong 4 unroll
put o add mul i 4 j uchar and shr v sub 24 mul j 8 0xff
end
end
end

note ======== messages and the line buffer ========

note die: one line on stderr and exit (2 for driver errors)
fn die t view uchar * code int to void
r = write 2 tpref 0 len tpref
r = write 2 t 0 len t
r = write 2 tnl 0 1
exit code
end

fn l_b c uchar to void
n = get gv VLN
if lt n len lb
put lb n c
put gv VLN add n 1
end
end

fn l_txt t view uchar * to void
for i ulong len t
l_b get t i
end
end

fn l_sa x ulong to void
p = get so x
for i ulong get sl x
l_b get sa add p i
end
end

note numfmt: decimal digits of v into nb; returns the length
fn numfmt v long to ulong
b = new uchar 24 0
u = ulong 0
ng = false
if lt v 0
ng = true
u = ulong neg v
else
u = ulong v
end
k = ulong 0
while lt k 24 bound 24
put b k uchar add 48 rem u 10
k = add k 1
u = div u 10
if eq u 0
break
end
end
w = ulong 0
if ng
put nbuf 0 uchar 45
w = 1
end
while gt k 0 bound 24
k = sub k 1
put nbuf w get b k
w = add w 1
end
ret w
end

fn l_num v long to void
n = numfmt v
for i ulong n
l_b get nbuf i
end
end

fn l_flush fd int to void
n = get gv VLN
r = write fd lb 0 n
put gv VLN 0
end

note l_code: a run code as Python prints it (an int, timeout, or None)
fn l_code v long to void
if eq v CTMO
l_txt ttimeout
ret
end
if eq v CNONE
l_txt tpynone
ret
end
l_num v
end

note ======== JSON output: python json.dumps(indent=2, sort_keys=True, ensure_ascii=True) ========

fn ob_b c uchar to void
n = get gv VOBN
if ge n len rb
die tfull 2
end
put rb n c
put gv VOBN add n 1
end

fn o_txt t view uchar * to void
for i ulong len t
ob_b get t i
end
end

fn o_qtxt t view uchar * to void
ob_b uchar 34
o_txt t
ob_b uchar 34
end

fn o_num v long to void
n = numfmt v
for i ulong n
ob_b get nbuf i
end
end

fn o_open c uchar to void
ob_b c
d = add get gv VDEP 1
if ge d len dst
die tdepth 2
end
put dst d 0
put gv VDEP d
end

fn o_item to void
d = get gv VDEP
if gt get dst d 0
ob_b uchar 44
end
ob_b uchar 10
for i ulong mul d 2
ob_b uchar 32
end
put dst d add get dst d 1
end

fn o_close c uchar to void
d = get gv VDEP
if gt get dst d 0
ob_b uchar 10
for i ulong mul sub d 1 2
ob_b uchar 32
end
end
ob_b c
put gv VDEP sub d 1
end

fn o_colon to void
ob_b uchar 58
ob_b uchar 32
end

fn o_key t view uchar * to void
o_item
o_qtxt t
o_colon
end

fn hexc h ulong to uchar
if lt h 10
ret uchar add 48 h
end
ret uchar add 87 h
end

fn o_hex slot ulong to void
ob_b uchar 34
for i ulong 64
ob_b get hsl add mul slot 64 i
end
ob_b uchar 34
end

fn o_u4 v ulong to void
ob_b uchar 92
ob_b uchar 117
for i ulong 4
ob_b hexc and shr v mul sub 3 i 4 15
end
end

fn o_bs c uchar to void
ob_b uchar 92
ob_b c
end

note o_asc: one ASCII byte as a JSON string character (Python ensure_ascii)
fn o_asc c ulong to void
if eq c 34
o_bs uchar 34
ret
end
if eq c 92
o_bs uchar 92
ret
end
if eq c 10
o_bs uchar 110
ret
end
if eq c 13
o_bs uchar 114
ret
end
if eq c 9
o_bs uchar 116
ret
end
if eq c 8
o_bs uchar 98
ret
end
if eq c 12
o_bs uchar 102
ret
end
if or lt c 32 eq c 127
o_u4 c
ret
end
ob_b uchar c
end

fn o_cp cp ulong to void
if lt cp 65536
o_u4 cp
ret
end
v = sub cp 65536
o_u4 add 55296 shr v 10
o_u4 add 56320 and v 1023
end

note u8dec: decode the UTF-8 sequence at sx[i] (end e). Returns the code point or U+FFFD in the
note low 32 bits and the bytes consumed above them; an invalid sequence consumes its maximal
note subpart, as Python's bytes.decode(errors='replace') does
fn u8dec i ulong e ulong to ulong
c = ulong get sx i
need = ulong 0
lo = ulong 128
hi = ulong 191
cp = ulong 0
if and ge c 194 le c 223
need = 1
cp = and c 31
end
if and ge c 224 le c 239
need = 2
cp = and c 15
if eq c 224
lo = 160
end
if eq c 237
hi = 159
end
end
if and ge c 240 le c 244
need = 3
cp = and c 7
if eq c 240
lo = 144
end
if eq c 244
hi = 143
end
end
if eq need 0
ret or 65533 shl ulong 1 32
end
k = ulong 1
while le k need bound 4
if ge add i k e
ret or 65533 shl k 32
end
d = ulong get sx add i k
if or lt d lo gt d hi
ret or 65533 shl k 32
end
cp = or shl cp 6 and d 63
lo = 128
hi = 191
k = add k 1
end
ret or cp shl k 32
end

note o_esc: sx[s, s+n) as a quoted JSON string
fn o_esc s ulong n ulong to void
ob_b uchar 34
i = s
e = add s n
while lt i e bound 16777217
c = ulong get sx i
if lt c 128
o_asc c
i = add i 1
continue
end
r = u8dec i e
o_cp and r 4294967295
i = add i shr r 32
end
ob_b uchar 34
end

fn o_str_sa x ulong to void
p = get so x
n = get sl x
for i ulong n
put sx i get sa add p i
end
o_esc 0 n
end

fn o_ksa t view uchar * x ulong to void
o_key t
o_str_sa x
end

fn o_code v long to void
if eq v CTMO
o_qtxt ttimeout
ret
end
if eq v CNONE
o_txt tnull
ret
end
o_num v
end

note ======== string arena and lists ========

fn sput b view uchar * to ulong
n = len b
x = get gv VSON
p = get gv VSAN
if or ge x len so gt add p n len sa
die tarena 2
end
i = ulong 0
while lt i n bound 4194305
put sa add p i get b i
i = add i 1
end
put so x p
put sl x n
put gv VSAN add p n
put gv VSON add x 1
ret x
end

note sfb: fb[s, s+n) into the arena
fn sfb s ulong n ulong to ulong
b = new uchar 65536 0
if gt n 65536
die tlong 2
end
for i ulong n
put b i get fb add s i
end
ret sput part b 0 n
end

fn spop x ulong to void
put gv VSAN get so x
put gv VSON x
end

fn saeq x ulong t view uchar * to bool
if ne get sl x len t
ret false
end
p = get so x
for i ulong len t
if ne get sa add p i get t i
ret false
end
end
ret true
end

note sacmp: bytewise order of two arena strings (-1, 0, 1)
fn sacmp x ulong y ulong to long
px = get so x
py = get so y
nx = get sl x
ny = get sl y
m = nx
if lt ny m
m = ny
end
for i ulong m
a = get sa add px i
b = get sa add py i
if lt a b
ret -1
end
if gt a b
ret 1
end
end
if lt nx ny
ret -1
end
if gt nx ny
ret 1
end
ret 0
end

fn ladd k ulong x ulong to void
c = get gv add 16 k
if ge c 2048
die tlist 2
end
put lst add mul k 2048 c x
put gv add 16 k add c 1
end

fn lget k ulong i ulong to ulong
ret get lst add mul k 2048 i
end

fn lcnt k ulong to ulong
ret get gv add 16 k
end

note ======== path and argument builders ========

fn pb_clr to void
put gv VPBN 0
end

fn pb_b c uchar to void
n = get gv VPBN
if ge n 4095
die tpath 2
end
put pb n c
put gv VPBN add n 1
end

fn pb_txt t view uchar * to void
for i ulong len t
pb_b get t i
end
end

fn pb_sa x ulong to void
p = get so x
for i ulong get sl x
pb_b get sa add p i
end
end

fn pb_wd to void
for i ulong get gv VWDN
pb_b get wd i
end
end

fn pb_cw to void
for i ulong get gv VCWN
pb_b get cw i
end
end

fn pb_hex slot ulong to void
for i ulong 64
pb_b get hsl add mul slot 64 i
end
end

fn pb_open flags int mode int to long
ret fopen pb 0 get gv VPBN flags mode
end

note pb_bin: the case binary's path, work dir / case name
fn pb_bin to void
pb_clr
pb_wd
pb_b uchar 47
pb_sa get gv VCN
end

fn pk_clr to void
put pk 0 0
put pk 1 0
put gv VPKN 2
put gv VPKC 0
end

note pk_pb: append pb as one record of the packed argument list
fn pk_pb to void
n = get gv VPBN
w = get gv VPKN
c = add get gv VPKC 1
if or gt c 64 gt add add w 2 n 4096
die targs 2
end
put pk w uchar and n 255
put pk add w 1 uchar shr n 8
for i ulong n
put pk add add w 2 i get pb i
end
put gv VPKN add add w 2 n
put gv VPKC c
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
end

fn pk_txt t view uchar * to void
pb_clr
pb_txt t
pk_pb
end

note ======== files ========

note rdfb: the whole of fd (from offset 0) into fb; returns the length
fn rdfb fd int to ulong
n = ulong 0
w = true
while w bound 100000
k = pread fd fb n sub len fb n long n
if lt k 0
die tread 2
end
if eq k 0
ret n
end
n = add n ulong k
if ge n len fb
die tbig 2
end
end
ret n
end

note rdpb: the file named by pb into fb
fn rdpb to ulong
fd = pb_open 524288 0
if lt fd 0
l_txt tpref
for i ulong get gv VPBN
l_b get pb i
end
l_flush 2
die topen 2
end
n = rdfb int fd
r = fclose int fd
ret n
end

fn fsize fd int to ulong
r = fstat fd stb 0 128
if lt r 0
die tread 2
end
v = ulong 0
for i ulong 8
v = or v shl ulong get stb add 48 i mul i 8
end
ret v
end

note wrob: ob[0, n) or gsrc[0, n) (which 0) to fd
fn wrall fd int which ulong n ulong to void
p = ulong 0
while lt p n bound 1000000
k = long 0
if eq which 0
k = write fd gsrc p sub n p
else
k = write fd rb p sub n p
end
if le k 0
die twfail 2
end
p = add p ulong k
end
end

note ======== SHA-256 (the copied om/sha256 functions) ========

fn hfin c edit shactx slot ulong to void
o = new uchar 32 0
sha256_final c o
for i ulong 32
b = ulong get o i
q = add mul slot 64 mul i 2
put hsl q hexc shr b 4
put hsl add q 1 hexc and b 15
end
end

note hfd: digest of everything in fd into hsl slot
fn hfd fd int slot ulong to void
c = new uchar 104 0
ch = new uchar 1048576 0
sha256_init c
p = long 0
w = true
while w bound 100000000
k = pread fd ch 0 1048576 p
if lt k 0
die tread 2
end
if eq k 0
break
end
sha256_update c part ch 0 ulong k
p = add p k
end
hfin c slot
end

fn hpb slot ulong to void
fd = pb_open 524288 0
if lt fd 0
die topen 2
end
hfd int fd slot
r = fclose int fd
end

note hglob: digest of gsrc[0, n) (which 0) or ob[0, n)
fn hglob which ulong n ulong slot ulong to void
c = new uchar 104 0
ch = new uchar 524288 0
sha256_init c
p = ulong 0
while lt p n bound 1000000
m = sub n p
if gt m 524288
m = 524288
end
for i ulong m
if eq which 0
put ch i get gsrc add p i
else
put ch i get rb add p i
end
end
sha256_update c part ch 0 m
p = add p m
end
hfin c slot
end

note ======== processes ========

fn spawn fi int fo int fe int grp bool to long
pid = fork
if eq pid 0
if grp
r = setpgid 0 0
end
r = dupfd fi 0 0
r = dupfd fo 1 0
r = dupfd fe 2 0
r = execprog pk 0 get gv VPKN
exit 127
end
if lt pid 0
die tfork 2
end
if grp
r = setpgid int pid int pid
end
ret pid
end

note wcode: exit status as Python's returncode (negative signal number when killed)
fn wcode ws view uchar 4 to long
s = or ulong get ws 0 shl ulong get ws 1 8
sg = and s 127
if eq sg 0
ret long and shr s 8 255
end
ret neg long sg
end

fn waitblk pid long to long
ws = new uchar 4 0
for i ulong 100000
r = waitpid int pid ws 0 4 0
if eq r pid
ret wcode ws
end
if ne r -4
die twait 2
end
end
die twait 2
ret 0
end

note waitto: reap pid within tmo ns, polling every millisecond. At the deadline the child's
note process group gets SIGKILL and the code is CTMO; after a normal exit the group is killed
note too, so no grandchild outlives the run
fn waitto pid long tmo ulong to long
ws = new uchar 4 0
dl = add ulong monons tmo
w = true
while w bound 4000000000
r = waitpid int pid ws 0 4 1
if eq r pid
q = killpid neg int pid 9
ret wcode ws
end
if and lt r 0 ne r -4
die twait 2
end
if ge ulong monons dl
q = killpid neg int pid 9
if lt q 0
q = killpid int pid 9
end
c = waitblk pid
ret CTMO
end
s = sleepns 1000000
end
ret CTMO
end

fn mfd to int
r = memfd tmfd 0 len tmfd 1
if lt r 0
die topen 2
end
ret int r
end

fn devnull to int
r = fopen tdevnull 0 len tdevnull 524288 0
if lt r 0
die topen 2
end
ret int r
end

note gitrun: run git (0 status, 1 rev-parse HEAD, 2 rev-parse HEAD^{tree}); stdout into fb
fn gitrun a ulong to ulong
pk_clr
pk_txt tgit
if eq a 0
pk_txt tstatus
pk_txt tporc
pk_txt tuntr
end
if eq a 1
pk_txt trevp
pk_txt thead
end
if eq a 2
pk_txt trevp
pk_txt thtree
end
fi = devnull
fo = mfd
fe = mfd
pid = spawn fi fo fe false
code = waitblk pid
if ne code 0
die tgitf 2
end
n = rdfb fo
r = fclose fi
r = fclose fo
r = fclose fe
ret n
end

fn isws c uchar to bool
ret or or eq c 32 eq c 10 or eq c 13 eq c 9
end

note stripfb: fb[0, n) without surrounding white space, into the arena
fn stripfb n ulong to ulong
s = ulong 0
e = n
while and lt s e isws get fb s bound 16777217
s = add s 1
end
while gt e s bound 16777217
if not isws get fb sub e 1
break
end
e = sub e 1
end
ret sfb s sub e s
end

note dirty: Python's filter, a porcelain line whose path (line[3:]) starts with build/ is ignored
fn dirty to void
n = gitrun 0
s = ulong 0
bad = false
l_txt trefd
while lt s n bound 16777217
e = s
while and lt e n ne get fb e 10 bound 16777217
e = add e 1
end
skip = false
if ge sub e s 9
skip = true
for i ulong 6
if ne get fb add add s 3 i get tbuild i
skip = false
end
end
end
if not skip
if bad
l_b uchar 10
end
bad = true
for i ulong sub e s
l_b get fb add s i
end
end
s = add e 1
end
if bad
l_b uchar 10
l_flush 2
exit 3
end
put gv VLN 0
end

note ======== recursive removal (shutil.rmtree with ignore_errors) ========

fn isdirl n ulong to bool
r = lstat rp 0 n stb 0 128
if lt r 0
ret false
end
m = or ulong get stb 16 shl ulong get stb 17 8
ret eq and m 61440 16384
end

note rment: one directory entry d[q..] (type ty) of the directory rp[0, n)
fn rment d view uchar 8192 q ulong ty uchar n ulong dep ulong to void
m = ulong 0
while ne get d add q m 0 bound 256
m = add m 1
end
if and eq m 1 eq get d q 46
ret
end
if and eq m 2 and eq get d q 46 eq get d add q 1 46
ret
end
if gt add add n m 1 4095
ret
end
put rp n uchar 47
for i ulong m
put rp add add n 1 i get d add q i
end
nn = add add n m 1
isd = eq ty 4
if eq ty 0
isd = isdirl nn
end
if isd
rmt nn add dep 1
else
r = unlink rp 0 nn
end
end

note rmbuf: every entry of one getdents batch d[0, k)
fn rmbuf d view uchar 8192 k ulong n ulong dep ulong to void
p = ulong 0
while lt p k bound 8192
rl = or ulong get d add p 16 shl ulong get d add p 17 8
rment d add p 19 get d add p 18 n dep
if eq rl 0
ret
end
p = add p rl
end
end

note rmt: remove the directory rp[0, n) and everything below it, never following a symbolic link
fn rmt n ulong dep ulong to void
if gt dep 64
ret
end
d = new uchar 8192 0
for pass ulong 4
fd = fopen rp 0 n 573440 0
if lt fd 0
ret
end
w = true
while w bound 1000000
k = getdnts int fd d 0 8192
if le k 0
break
end
rmbuf d ulong k n dep
end
r = fclose int fd
r = rmdir rp 0 n
if ge r 0
ret
end
end
end

note rmpath: rmtree of arena string x (relative to the repository root, or absolute)
fn rmpath x ulong to void
p = get so x
n = get sl x
if or eq n 0 gt n 4095
ret
end
for i ulong n
put rp i get sa add p i
end
if isdirl n
rmt n 0
end
end

fn rmwork to void
n = get gv VWDN
if eq n 0
ret
end
for i ulong n
put rp i get wd i
end
if isdirl n
rmt n 0
end
end

fn refuse code int to void
l_flush 2
rmwork
exit code
end

note ======== case file ========

fn sdec src view uchar * tp view uint * t ulong to ulong
ty = js_type tp t
if and ne ty 5 ne ty 6
die tschema 2
end
b = new uchar 65536 0
n = js_sget src js_off tp t b
if lt n 0
die tlong 2
end
ret sput part b 0 ulong n
end

fn kid x ulong to ulong
if saeq x kcase
ret 0
end
if saeq x kissue
ret 1
end
if saeq x kfrag
ret 2
end
if saeq x kgate
ret 3
end
if saeq x kcomp
ret 4
end
if saeq x kom2
ret 5
end
if saeq x kmut
ret 6
end
if saeq x kargs
ret 7
end
if saeq x kexp
ret 8
end
if saeq x ktmo
ret 9
end
if saeq x kclean
ret 10
end
if saeq x khas
ret 11
end
if saeq x krep
ret 12
end
if saeq x kstat
ret 13
end
if saeq x kcases
ret 14
end
ret 99
end

note cscan: value token of each known key of object o into ctok (NONE when absent)
fn cscan src view uchar * tp view uint * o ulong to void
for i ulong 16
put ctok i NONE
end
if ne js_type tp o 1
die tschema 2
end
k = js_first tp o
while ne k NONE bound 1000000
x = sdec src tp k
id = kid x
spop x
if lt id 16
if ne get ctok id NONE
die tdupkey 2
end
put ctok id add k 1
end
k = js_mnext tp k
end
end

note rdlist: a list of strings into list k (absent: nothing)
fn rdlist src view uchar * tp view uint * t ulong k ulong to void
if eq t NONE
ret
end
if ne js_type tp t 3
die tschema 2
end
e = js_first tp t
while ne e NONE bound 1000000
ladd k sdec src tp e
e = js_enext tp e
end
end

fn mtrip src view uchar * tp view uint * a ulong to void
if ne js_type tp a 3
die tschema 2
end
e0 = js_first tp a
if eq e0 NONE
die tschema 2
end
e1 = js_enext tp e0
if eq e1 NONE
die tschema 2
end
e2 = js_enext tp e1
if eq e2 NONE
die tschema 2
end
if ne js_enext tp e2 NONE
die tschema 2
end
ladd 5 sdec src tp e0
ladd 6 sdec src tp e1
ladd 7 sdec src tp e2
end

note rdmut: mutate is one [path, old, new] or a list of them; an empty list means none
fn rdmut src view uchar * tp view uint * t ulong to void
if eq t NONE
ret
end
if ne js_type tp t 3
die tschema 2
end
e = js_first tp t
if eq e NONE
ret
end
if ne js_type tp e 3
mtrip src tp t
ret
end
while ne e NONE bound 1000000
mtrip src tp e
e = js_enext tp e
end
end

fn cint src view uchar * tp view uint * t ulong dv long to long
if eq t NONE
ret dv
end
if ne js_type tp t 7
die tschema 2
end
o = js_off tp t
if not js_isl src o
die tschema 2
end
ret js_tol src o
end

note ctmo: timeout seconds (a plain decimal number) as nanoseconds; default 120 s
fn ctmo src view uchar * tp view uint * t ulong to ulong
if eq t NONE
ret 120000000000
end
if ne js_type tp t 7
die tschema 2
end
ret tmodec src js_off tp t js_span tp t
end

note tmodec: the lexeme src[o, o+n) of a timeout (digits, one optional dot) in nanoseconds
fn tmodec src view uchar * o ulong n ulong to ulong
v = ulong 0
fd = ulong 0
dot = false
for i ulong n
c = ulong get src add o i
if and eq c 46 not dot
dot = true
continue
end
if or lt c 48 gt c 57
die tschema 2
end
if or not dot lt fd 9
v = add mul v 10 sub c 48
if dot
fd = add fd 1
end
end
if gt v 1000000000000000000
die tschema 2
end
end
while lt fd 9 bound 10
if gt v 1000000000000000000
die tschema 2
end
v = mul v 10
fd = add fd 1
end
ret v
end

note cload: read case c into the per-case globals
fn cload src view uchar * tp view uint * c ulong to void
cscan src tp c
for k ulong 8
put gv add 16 k 0
end
t = get ctok 0
if eq t NONE
die tschema 2
end
put gv VCN sdec src tp t
put gv VGATE NONE
t = get ctok 3
if ne t NONE
g = sdec src tp t
if gt get sl g 0
put gv VGATE g
end
end
rdlist src tp get ctok 2 0
if eq lcnt 0 0
if eq get gv VGATE NONE
die tschema 2
end
ladd 0 get gv VGATE
end
rdlist src tp get ctok 4 1
rdlist src tp get ctok 7 2
rdlist src tp get ctok 11 3
rdlist src tp get ctok 10 4
rdmut src tp get ctok 6
cload2 src tp
end

fn cload2 src view uchar * tp view uint * to void
put gv VOM2 0
t = get ctok 5
if ne t NONE
if eq js_type tp t 8
put gv VOM2 1
end
end
t = get ctok 8
if eq t NONE
die tschema 2
end
put gl 0 cint src tp t 0
put gv VTMO ctmo src tp get ctok 9
r = cint src tp get ctok 12 1
if lt r 0
r = 0
end
if gt r 65536
die tschema 2
end
put gv VREP ulong r
end

note ======== composition ========

fn hfadd f ulong to void
n = lcnt 8
for i ulong n
if eq sacmp f lget 8 i 0
ret
end
end
ladd 8 f
end

fn mcheck to void
for i ulong lcnt 5
f = lget 5 i
found = false
for j ulong lcnt 0
if eq sacmp f lget 0 j 0
found = true
end
end
if not found
l_txt trefm
l_sa get gv VCN
l_b uchar 58
l_b uchar 32
l_sa f
l_txt trefnf
refuse 4
end
end
end

note fbat: does arena string x occur in fb at p
fn fbat x ulong p ulong to bool
q = get so x
n = get sl x
if gt add p n get gv VFBN
ret false
end
for i ulong n
if ne get fb add p i get sa add q i
ret false
end
end
ret true
end

note fbcount: non-overlapping occurrences of x in fb (Python bytes.count)
fn fbcount x ulong to ulong
n = get gv VFBN
m = get sl x
if eq m 0
ret add n 1
end
c = ulong 0
p = ulong 0
while le add p m n bound 16777217
if fbat x p
c = add c 1
p = add p m
else
p = add p 1
end
end
ret c
end

fn fbfind x ulong to ulong
n = get gv VFBN
m = get sl x
p = ulong 0
while le add p m n bound 16777217
if fbat x p
ret p
end
p = add p 1
end
ret NONE
end

note mutate: apply mutation j (its pattern occurs exactly once) to the fragment in fb
fn mutate j ulong to void
o = lget 6 j
w = lget 7 j
c = fbcount o
if ne c 1
l_txt trefm
l_sa get gv VCN
l_txt trefpo
l_num long c
l_txt treftm
refuse 4
end
splice fbfind o get sl o w
end

note splice: replace fb[p, p+ol) by arena string w
fn splice p ulong ol ulong w ulong to void
n = get gv VFBN
m = get sl w
e = add p ol
nn = add add p m sub n e
if ge nn len fb
die tbig 2
end
fbto2 0 0 p
sato2 p w
fbto2 e add p m sub n e
for i ulong nn
put fb i get fb2 i
end
put gv VFBN nn
end

fn fbto2 s ulong d ulong n ulong to void
for i ulong n
put fb2 add d i get fb add s i
end
end

fn sato2 d ulong w ulong to void
q = get so w
for i ulong get sl w
put fb2 add d i get sa add q i
end
end

fn src_b c uchar to void
n = get gv VSRCN
if ge n len gsrc
die tbig 2
end
put gsrc n c
put gv VSRCN add n 1
end

fn compose to void
put gv VSRCN 0
if eq get gv VOM2 1
for i ulong len tom2
src_b get tom2 i
end
end
for i ulong lcnt 0
f = lget 0 i
hfadd f
pb_clr
pb_sa f
put gv VFBN rdpb
for j ulong lcnt 5
if eq sacmp lget 5 j f 0
mutate j
end
end
k = ulong 0
while lt k get gv VFBN bound 16777217
src_b get fb k
k = add k 1
end
end
end

note ccheck: a gate case without a mutation must be exactly the concatenation of its compose list
fn ccheck to void
if eq get gv VGATE NONE
ret
end
if or gt lcnt 5 0 eq lcnt 1 0
ret
end
pos = ulong 0
ok = true
sn = get gv VSRCN
for i ulong lcnt 1
pb_clr
pb_sa lget 1 i
n = rdpb
if gt add pos n sn
ok = false
break
end
k = ulong 0
while lt k n bound 16777217
if ne get fb k get gsrc add pos k
ok = false
break
end
k = add k 1
end
pos = add pos n
end
if or not ok ne pos sn
l_txt tref
l_sa get gv VGATE
l_txt trefc
refuse 5
end
end

note ======== compile and run ========

fn closefd x ulong to void
if ne get gv x NONE
r = fclose int get gv x
put gv x NONE
end
end

fn compile to long
fi = mfd
wrall fi 0 get gv VSRCN
r = fseek fi 0 0
pb_bin
fo = pb_open 524865 493
if lt fo 0
die topen 2
end
fe = mfd
pk_clr
pb_clr
pb_cw
pb_txt tomcabs
pk_pb
pid = spawn fi int fo fe false
r = fclose fi
r = fclose int fo
code = waitblk pid
pb_bin
r = chmod pb 0 get gv VPBN 493
closefd VFDE
put gv VFDE ulong fe
ret code
end

note hasall: true when every stdout_has string occurs in fd's contents
fn hasall fd int to bool
for i ulong lcnt 3
if not mhas fd lget 3 i
ret false
end
end
ret true
end

note mhas: substring search over fd in windows of fb2 (each window overlaps the next by m-1)
fn mhas fd int x ulong to bool
m = get sl x
if eq m 0
ret true
end
w = sub len fb2 65536
p = ulong 0
for it ulong 1000000
k = pread fd fb2 0 add w m long p
if lt k 0
die tread 2
end
got = ulong k
if lt got m
ret false
end
lim = add sub got m 1
if gt lim w
lim = w
end
if inwin x lim
ret true
end
if lt got add w m
ret false
end
p = add p w
end
ret false
end

fn inwin x ulong lim ulong to bool
s = ulong 0
while lt s lim bound 16777217
if w2at s x
ret true
end
s = add s 1
end
ret false
end

fn w2at s ulong x ulong to bool
q = get so x
for i ulong get sl x
if ne get fb2 add s i get sa add q i
ret false
end
end
ret true
end

fn runone i ulong to void
for j ulong lcnt 4
rmpath lget 4 j
end
fi = devnull
fo = mfd
fe = mfd
pk_clr
pb_bin
pk_pb
for j ulong lcnt 2
pb_clr
pb_sa lget 2 j
pk_pb
end
pid = spawn fi fo fe true
r = fclose fi
code = waitto pid get gv VTMO
put rcod i code
put rmis i 0
if not hasall fo
put rmis i 1
end
put gl 2 code
closefd VFDO
closefd VFDE
put gv VFDO ulong fo
put gv VFDE ulong fe
end

fn runall to void
n = get gv VREP
put gl 2 CNONE
t0 = ulong monons
for i ulong n
runone i
end
put gv VNRUN n
put gv VWALL div sub ulong monons t0 1000000
ok = true
for i ulong n
if or ne get rcod i get gl 0 ne get rmis i 0
ok = false
end
end
put gv VOK 0
if ok
put gv VOK 1
end
end

note ======== outcome histogram ========

fn okey j ulong to void
b = mul j 32
w = ulong 0
c = get ocod j
if eq c CTMO
for i ulong len ttimeout
put okb add b i get ttimeout i
end
w = len ttimeout
else
w = numfmt c
for i ulong w
put okb add b i get nbuf i
end
end
if ne get omis j 0
for i ulong len tmiss
put okb add add b w i get tmiss i
end
w = add w len tmiss
end
put okl j w
end

fn ocmp x ulong y ulong to bool
nx = get okl x
ny = get okl y
m = nx
if lt ny m
m = ny
end
for i ulong m
a = get okb add mul x 32 i
b = get okb add mul y 32 i
if ne a b
ret lt a b
end
end
ret lt nx ny
end

fn ofind nd ulong c long m uchar to ulong
for j ulong nd
if eq get ocod j c
if eq get omis j m
ret j
end
end
end
ret NONE
end

note hist: distinct outcomes in first-seen order (ocod, omis, ocnt); returns their number
fn hist to ulong
nd = ulong 0
for i ulong get gv VNRUN
c = get rcod i
m = get rmis i
f = ofind nd c m
if eq f NONE
if ge nd 1024
die tlist 2
end
put ocod nd c
put omis nd m
put ocnt nd 0
okey nd
f = nd
nd = add nd 1
end
put ocnt f add get ocnt f 1
end
ret nd
end

fn o_hist nd ulong to void
for i ulong nd
put oord i i
end
for i ulong nd
j = i
while gt j 0 bound 1024
a = get oord sub j 1
b = get oord j
if not ocmp b a
break
end
put oord sub j 1 b
put oord j a
j = sub j 1
end
end
o_open uchar 123
for i ulong nd
j = get oord i
o_item
ob_b uchar 34
for k ulong get okl j
ob_b get okb add mul j 32 k
end
ob_b uchar 34
o_colon
o_num long get ocnt j
end
o_close uchar 125
end

fn l_hist nd ulong to void
l_b uchar 123
for j ulong nd
if gt j 0
l_b uchar 44
l_b uchar 32
end
l_b uchar 39
for k ulong get okl j
l_b get okb add mul j 32 k
end
l_b uchar 39
l_b uchar 58
l_b uchar 32
l_num long get ocnt j
end
l_b uchar 125
end

note ======== check entries ========

note o_tail: the last cap bytes of fd's contents, cut forward to a UTF-8 boundary
fn o_tail x ulong cap ulong to void
if eq get gv x NONE
o_esc 0 0
ret
end
fd = int get gv x
n = fsize fd
s = ulong 0
if gt n cap
s = sub n cap
end
o_tl fd s sub n s
end

note o_tl: n bytes of fd from s, skipping up to 3 leading UTF-8 continuation bytes when s > 0
fn o_tl fd int s ulong n ulong to void
k = pread fd sx 0 n long s
if lt k 0
die tread 2
end
m = ulong k
b = ulong 0
w = gt s 0
while and w lt b 3 bound 4
if ge b m
break
end
if ne and get sx b 192 128
break
end
b = add b 1
end
o_esc b sub m b
end

fn o_full x ulong to void
fd = int get gv x
n = fsize fd
if ge n len sx
die tbig 2
end
k = pread fd sx 0 n long 0
if lt k 0
die tread 2
end
o_esc 0 ulong k
end

fn o_mutobj i ulong to void
o_open uchar 123
o_ksa kfile lget 5 i
o_ksa kfrom lget 6 i
o_ksa kto lget 7 i
o_close uchar 125
end

fn o_mut to void
n = lcnt 5
if eq n 0
ret
end
o_key kmutat
if eq n 1
o_mutobj 0
ret
end
o_open uchar 91
for i ulong n
o_item
o_mutobj i
end
o_close uchar 93
end

fn o_opt src view uchar * tp view uint * t ulong to void
if eq t NONE
o_txt tnull
else
o_tree src tp t
end
end

note o_head: the keys every check entry has before mutation
fn o_head src view uchar * tp view uint * to void
o_ksa kcase get gv VCN
o_key kcexit
o_num get gl 1
o_key kexpx
o_num get gl 0
o_key kissue
o_opt src tp get ctok 1
o_mut
end

fn emitfail src view uchar * tp view uint * to void
o_item
o_open uchar 123
o_head src tp
o_key krunx
o_txt tnull
o_key ksrcsha
o_hex 0
o_key kstderr
o_full VFDE
o_key kverd
o_qtxt tfailw
o_close uchar 125
put gv VFAIL add get gv VFAIL 1
end

fn emitok src view uchar * tp view uint * nd ulong to void
o_item
o_open uchar 123
o_key kbsha
o_hex 1
o_head src tp
if gt get gv VNRUN 1
o_key krep
o_open uchar 123
o_key kouts
o_hist nd
o_key kruns
o_num long get gv VNRUN
o_close uchar 125
end
o_key krunx
o_code get gl 2
o_key ksrcsha
o_hex 0
o_key kstderr
o_tail VFDE 2000
o_key kstdout
o_tail VFDO 4000
if gt lcnt 3 0
o_key khas
o_tree src tp get ctok 11
end
o_key kverd
if eq get gv VOK 1
o_qtxt tpass
else
o_qtxt tfailw
end
o_key kwall
o_num long get gv VWALL
o_close uchar 125
end

fn pline nd ulong to void
if eq get gv VOK 1
l_txt tpass
put gv VPASS add get gv VPASS 1
else
l_txt tfailw
put gv VFAIL add get gv VFAIL 1
end
l_b uchar 32
l_sa get gv VCN
l_txt texpe
l_num get gl 0
l_txt tgot
l_code get gl 2
if gt get gv VNRUN 1
l_txt truns
l_hist nd
end
l_b uchar 10
l_flush 1
end

note A case that does not compile still gets its console line (it is a FAIL
note in the receipt, so the summary counts it). The Python ORACLE printed
note nothing for it.
fn cfline to void
l_txt tfailw
l_b uchar 32
l_sa get gv VCN
l_txt texpe
l_num get gl 0
l_txt tcomp
l_num get gl 1
l_b uchar 10
l_flush 1
end

fn docase src view uchar * tp view uint * c ulong to void
cload src tp c
mcheck
compose
ccheck
hglob 0 get gv VSRCN 0
ce = compile
put gl 1 ce
if ne ce 0
emitfail src tp
cfline
closefd VFDE
ret
end
runall
pb_bin
hpb 1
nd = hist
emitok src tp nd
pline nd
closefd VFDO
closefd VFDE
end

note ======== JSON copy of case-file values (keys sorted, duplicates refused) ========

fn o_jstr src view uchar * tp view uint * t ulong to void
b = new uchar 65536 0
n = js_sget src js_off tp t b
if lt n 0
die tlong 2
end
for i ulong ulong n
put sx i get b i
end
o_esc 0 ulong n
end

fn kpush src view uchar * tp view uint * k ulong to void
b = new uchar 65536 0
n = js_sget src js_off tp k b
if lt n 0
die tlong 2
end
kstore b ulong n k
end

fn kstore b view uchar 65536 n ulong k ulong to void
p = get gv VKPN
s = get gv VKSN
if or gt add p n len kp gt add s 3 len ks
die tarena 2
end
for i ulong n
put kp add p i get b i
end
put ks s p
put ks add s 1 n
put ks add s 2 k
put gv VKSN add s 3
put gv VKPN add p n
end

fn kcmp a ulong b ulong to long
pa = get ks a
na = get ks add a 1
pb2 = get ks b
nb2 = get ks add b 1
m = na
if lt nb2 m
m = nb2
end
for i ulong m
x = get kp add pa i
y = get kp add pb2 i
if lt x y
ret -1
end
if gt x y
ret 1
end
end
if lt na nb2
ret -1
end
if gt na nb2
ret 1
end
ret 0
end

fn kswap x ulong y ulong to void
for q ulong 3
a = get ks add x q
put ks add x q get ks add y q
put ks add y q a
end
end

fn ksort base ulong top ulong to void
i = add base 3
while lt i top bound 1000000
j = i
while gt j base bound 1000000
c = kcmp sub j 3 j
if eq c 0
die tdupkey 2
end
if lt c 0
break
end
kswap sub j 3 j
j = sub j 3
end
i = add i 3
end
end

fn o_kp e ulong to void
p = get ks e
n = get ks add e 1
for i ulong n
put sx i get kp add p i
end
o_esc 0 n
end

fn o_obj src view uchar * tp view uint * t ulong to void
o_open uchar 123
base = get gv VKSN
kb = get gv VKPN
k = js_first tp t
while ne k NONE bound 1000000
kpush src tp k
k = js_mnext tp k
end
top = get gv VKSN
ksort base top
i = base
while lt i top bound 1000000
o_item
o_kp i
o_colon
o_tree src tp add get ks add i 2 1
i = add i 3
end
put gv VKSN base
put gv VKPN kb
o_close uchar 125
end

fn o_arr src view uchar * tp view uint * t ulong to void
o_open uchar 91
e = js_first tp t
while ne e NONE bound 1000000
o_item
o_tree src tp e
e = js_enext tp e
end
o_close uchar 93
end

fn o_tree src view uchar * tp view uint * t ulong to void
ty = js_type tp t
if eq ty 1
o_obj src tp t
ret
end
if eq ty 3
o_arr src tp t
ret
end
if or eq ty 5 eq ty 6
o_jstr src tp t
ret
end
if eq ty 7
o = js_off tp t
for i ulong js_span tp t
ob_b get src add o i
end
ret
end
if eq ty 8
o_txt ttrue
ret
end
if eq ty 9
o_txt tfalse
ret
end
o_txt tnull
end

note ======== receipt fields ========

note sfile: a small text file (path text t), trimmed, into the arena
fn sfile t view uchar * to ulong
pb_clr
pb_txt t
ret stripfb rdpb
end

note o_plat: system release machine node, as platform.uname() gives them
fn o_plat to void
a = sfile tostype
b = sfile tosrel
c = sfile thost
n = sxsa 0 a
put sx n 32
n = sxsa add n 1 b
put sx n 32
n = add n 1
for i ulong len tmach
put sx add n i get tmach i
end
n = add n len tmach
put sx n 32
n = sxsa add n 1 c
o_esc 0 n
end

note sxsa: arena string x into sx at n; returns the end
fn sxsa n ulong x ulong to ulong
p = get so x
m = get sl x
for i ulong m
put sx add n i get sa add p i
end
ret add n m
end

note pnum: a decimal number in fb at p; returns the value and moves gv VNOUT past it
fn pnum p ulong n ulong to ulong
v = ulong 0
q = p
while and lt q n and ge get fb q 48 le get fb q 57 bound 32
v = add mul v 10 sub ulong get fb q 48
q = add q 1
end
put gv VNOUT q
ret v
end

note o_affin: Cpus_allowed_list of this process, expanded (os.sched_getaffinity)
fn o_affin to void
pb_clr
pb_txt tpstat
n = rdpb
p = ulong 0
f = NONE
while lt p n bound 16777217
if fbtxt p tcpus
f = add p len tcpus
break
end
while and lt p n ne get fb p 10 bound 16777217
p = add p 1
end
p = add p 1
end
o_open uchar 91
if eq f NONE
o_close uchar 93
ret
end
p = f
while and lt p n or eq get fb p 9 eq get fb p 32 bound 64
p = add p 1
end
w = true
while w bound 4096
a = pnum p n
p = get gv VNOUT
b = a
if and lt p n eq get fb p 45
b = pnum add p 1 n
p = get gv VNOUT
end
v = a
while le v b bound 65536
o_item
o_num long v
v = add v 1
end
if or ge p n ne get fb p 44
break
end
p = add p 1
end
o_close uchar 93
end

fn fbtxt p ulong t view uchar * to bool
for i ulong len t
if ne get fb add p i get t i
ret false
end
end
ret true
end

fn sxd p ulong v ulong w ulong to void
x = v
k = w
while gt k 0 bound 8
k = sub k 1
put sx add p k uchar add 48 rem x 10
x = div x 10
end
end

note o_time: datetime.now(timezone.utc).isoformat()
fn o_time to void
ns = ulong realns
secs = div ns 1000000000
sdate div secs 86400
o_time2 rem secs 86400 div rem ns 1000000000 1000
end

note sdate: YYYY-MM-DDT for day number t since 1970-01-01 (civil_from_days, H. Hinnant)
fn sdate t ulong to void
z = add t 719468
era = div z 146097
doe = sub z mul era 146097
yoe = yoef doe
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
sxd 0 y 4
put sx 4 45
sxd 5 m 2
put sx 7 45
sxd 8 d 2
put sx 10 84
end

fn yoef doe ulong to ulong
a = sub doe div doe 1460
b = add a div doe 36524
ret div sub b div doe 146096 365
end

fn o_time2 sod ulong us ulong to void
sxd 11 div sod 3600 2
put sx 13 58
sxd 14 div rem sod 3600 60 2
put sx 16 58
sxd 17 rem sod 60 2
n = ulong 19
if gt us 0
put sx 19 46
sxd 20 us 6
n = 26
end
put sx n 43
sxd add n 1 0 2
put sx add n 3 58
sxd add n 4 0 2
o_esc 0 add n 6
end

fn o_hashes to void
n = lcnt 8
for i ulong n
j = i
while gt j 0 bound 2048
a = lget 8 sub j 1
b = lget 8 j
if le sacmp a b 0
break
end
put lst add 16384 sub j 1 b
put lst add 16384 j a
j = sub j 1
end
end
o_open uchar 123
for i ulong n
f = lget 8 i
o_item
o_str_sa f
o_colon
pb_clr
pb_sa f
hpb 2
o_hex 2
end
o_close uchar 125
end

fn o_script src view uchar * tp view uint * to void
o_open uchar 123
o_key kbsha
pb_clr
pb_sa get gv VBIN
hpb 2
o_hex 2
o_key kcases
o_tree src tp 0
o_key kcsha
pb_clr
pb_sa get gv VCASP
hpb 2
o_hex 2
o_key kpath
o_qtxt tsrcrel
o_key ksha
pb_clr
pb_sa get gv VDRV
hpb 2
o_hex 2
o_key ksource
pb_clr
pb_sa get gv VDRV
fd = pb_open 524288 0
if lt fd 0
die topen 2
end
put gv VFDO ulong fd
o_full VFDO
r = fclose int fd
put gv VFDO NONE
o_close uchar 125
end

fn o_rest src view uchar * tp view uint * to void
o_key kcompil
o_open uchar 123
o_key kpath
o_qtxt tomcrel
o_key ksha
pb_clr
pb_txt tomcrel
hpb 2
o_hex 2
o_close uchar 125
o_key kaffin
o_affin
o_key kexecu
o_qtxt texec
o_key khashes
o_hashes
o_key kissue
o_tree src tp get gv VTISS
o_key kplat
o_plat
o_key kproj
o_qtxt tproj
o_key kscript
o_script src tp
o_ksa kscom get gv VHEAD
o_ksa kstree get gv VTREE
o_key kstat
if eq get gv VTSTA NONE
o_open uchar 123
o_close uchar 125
else
o_tree src tp get gv VTSTA
end
o_key ksumm
o_open uchar 123
o_key kfail
o_num long get gv VFAIL
o_key kpass
o_num long get gv VPASS
o_close uchar 125
o_key ktime
o_time
end

note ======== setup ========

note argsa: argument i into the arena
fn argsa i ulong to ulong
b = new uchar 4096 0
n = argread i b 0 4096
if lt n 0
die tpath 2
end
ret sput part b 0 ulong n
end

note self: the driver binary is argv0; its source is the sibling seed/node/schedrcpt.om of the
note build/node/schedrcpt it was invoked as
fn self to void
x = argsa 0
n = get sl x
m = len tsuffix
if lt n m
die tself 2
end
p = get so x
for i ulong m
if ne get sa add add p sub n m i get tsuffix i
die tself 2
end
end
put gv VBIN x
b = new uchar 4096 0
for i ulong sub n m
put b i get sa add p i
end
k = sub n m
for i ulong len tsrcrel
put b add k i get tsrcrel i
end
put gv VDRV sput part b 0 add k len tsrcrel
end

note mkbuild: create build/node in the tree under test, the README's build
note step (mkdir -p build/node; build/ is outside the dirty check). Gates
note open journals and work directories below it, and jn_open creates only
note the last directory of its path.
fn mkbuild to void
r = makedir tbn 0 5 493
if and lt r 0 ne r neg long 17
die tbnf 2
end
r = makedir tbn 0 10 493
if and lt r 0 ne r neg long 17
die tbnf 2
end
end

fn mkwork to void
r = new uchar 8 0
q = random r 0 8 0
if ne q 8
die tmkwork 2
end
pb_clr
pb_txt twdpre
for i ulong 8
b = ulong get r i
pb_b hexc shr b 4
pb_b hexc and b 15
end
q = makedir pb 0 get gv VPBN 448
if lt q 0
die tmkwork 2
end
for i ulong get gv VPBN
put wd i get pb i
end
put gv VWDN get gv VPBN
end

fn ldcases src edit uchar * to ulong
pb_clr
pb_sa get gv VCASP
fd = pb_open 524288 0
if lt fd 0
die tcasesf 2
end
n = ulong 0
w = true
while w bound 1000000
k = pread int fd src n sub len src n long n
if lt k 0
die tcasesf 2
end
if eq k 0
break
end
n = add n ulong k
if ge n len src
die tcasesf 2
end
end
r = fclose int fd
ret n
end

fn wflag to bool
f = false
for i ulong sub ulong argcnt 1
x = argsa add i 1
if saeq x twrite
f = true
end
spop x
end
ret f
end

note save: write the receipt (ob) and print its path (--write) or put it in /tmp
fn save wr bool to void
n = get gv VOBN
pb_clr
if wr
o = get gv VOUT
pb_sa o
for i ulong get gv VPBN
if and gt i 0 eq get pb i 47
r = makedir pb 0 i 493
end
end
r = makedir pb 0 get gv VPBN 493
if ne get pb sub get gv VPBN 1 47
pb_b uchar 47
end
pb_txt trcpre
else
pb_txt ttmppre
end
pb_hex 2
pb_txt tjson
fl = int 524865
if wr
fl = 524481
end
fd = pb_open fl 420
if lt fd 0
die twfail 2
end
wrall int fd 1 n
r = fclose int fd
if wr
if ne get pb 0 47
for i ulong get gv VCWN
l_b get cw i
end
l_b uchar 47
end
for i ulong get gv VPBN
l_b get pb i
end
l_b uchar 10
l_flush 1
end
end

fn main to int
src = new uchar 983040 0
tp = new uint 262144 0
if lt argcnt 3
die tusage 2
end
put gv VFDO NONE
put gv VFDE NONE
self
put gv VCASP argsa 1
put gv VOUT argsa 2
wr = wflag
q = cwd cw 0 4096
if lt q 2
die tpath 2
end
put gv VCWN sub ulong q 1
n = ldcases src
r = js_init tp 983040 48
if lt r 0
die tnotjson 2
end
r = js_parse src tp n
if lt r 0
die tnotjson 2
end
cscan src tp 0
put gv VTISS get ctok 1
put gv VTSTA get ctok 13
put gv VTCAS get ctok 14
if or eq get gv VTISS NONE eq get gv VTCAS NONE
die tschema 2
end
if ne js_type tp get gv VTCAS 3
die tschema 2
end
dirty
put gv VHEAD stripfb gitrun 1
put gv VTREE stripfb gitrun 2
mkbuild
mkwork
o_open uchar 123
o_key kchecks
o_open uchar 91
e = js_first tp get gv VTCAS
while ne e NONE bound 1000000
docase src tp e
e = js_enext tp e
end
o_close uchar 93
rmwork
put gv VWDN 0
o_rest src tp
o_close uchar 125
ob_b uchar 10
hglob 1 get gv VOBN 2
l_txt tsumm
l_num long get gv VPASS
l_txt tsfail
l_num long get gv VFAIL
l_txt tsdig
for i ulong 64
l_b get hsl add 128 i
end
l_b uchar 10
l_flush 1
save wr
if eq get gv VFAIL 0
ret 0
end
ret 1
end

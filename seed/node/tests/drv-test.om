note seed/node/tests/drv-test.om: self-test of the driver library seed/node/tests/drv.om.
note Build: { printf 'om2\n'; cat seed/json/json.om seed/node/tests/drv.om seed/node/tests/drv-test.om; }
note   | seed/out/omc > build/node/drv-test
note Usage: drv-test SCRATCHDIR. Works only below SCRATCHDIR/drv-test.d (removed first and last).
note Prints one "PASS|FAIL|NOT_RUN drv.NAME" line per check and "DRV-TEST pass=P fail=F not_run=N";
note exit 0 when no check failed, 1 otherwise, 2 for bad usage or an unusable SCRATCHDIR.
note The process checks run this same binary as the child ("drv-test child exit7": "out\n" to
note stdout, "err\n" to stderr, exit 7; "drv-test child sleep": sleep 30 s), so no system program
note is executed. drv.port is NOT_RUN when no loopback socket can be bound.

note dtl: lengths of the paths in main's arrays: [0] T = SCRATCHDIR/drv-test.d, [1] this program
note (argument 0), [2] T/o, [3] T/e.
global dtl ulong 4

text dtchild "child"
text dtexit7 "exit7"
text dtsleep "sleep"
text dtout "out\n"
text dterr "err\n"
text dtpre "pre\n"
text dtapp "pre\nout\nerr\n"
text dtboth "out\nerr\n"
text dtsub "drv-test.d"
text dtdeep "d1/d2/d3"
text dtd1 "d1"
text dtfile "d1/d2/f"
text dtnull "/dev/null"
text dtab "ab"
text dtcd "cd"
text dtabcd "abcd"
text dtofile "o"
text dtefile "e"
text dtjfile "j.json"
text dtjson "{\"s\":\"\\u00e9\\ud83d\\ude00\",\"n\":-5,\"l\":[1,2,3],\"d\":\"x\",\"d\":\"y\"}"
text dtks "s"
text dtkn "n"
text dtkl "l"
text dtkd "d"
text dtkz "z"
text dty "y"
text dtnope "/nonexistent/drv-test-prog"
text dtm42 "-42"
text dtmin "-9223372036854775808"
text dtmax "18446744073709551615"
text dtmaxm "18446744073709551614"
text dt123 "123"
text dt12a "12a"
text dt21 "000000000000000000001"
text dtabcab "abcabc"
text dtca "ca"
text dta "a"
text dtas "a/"
text dtb "b"
text dtsb "/b"
text dtab2 "a/b"
text dtxyz "x/y/z"
text dtxy "x//y"
text dtsz "/z"
text dtz "z"
text dtsock "socket error"
text dtusage "usage: drv-test SCRATCHDIR\n"
text dtbad "drv-test: cannot prepare SCRATCHDIR/drv-test.d\n"
text dtsum1 "DRV-TEST pass="
text dtsum2 " fail="
text dtsum3 " not_run="
text ckfmtl "drv.fmtl"
text ckfmtu "drv.fmtu"
text ckatou "drv.atou"
text ckfind "drv.find"
text ckat "drv.at"
text ckeq "drv.eq"
text ckjoin "drv.join"
text ckdirn "drv.dirn"
text ckmkd "drv.mkdirp"
text ckspit "drv.spit-apnd-slurp"
text ckcap "drv.slurp-cap"
text ckrmrf "drv.rmrf"
text ckrmm "drv.rmrf-missing"
text ckexit "drv.spawn-exit"
text ckout "drv.spawn-stdout"
text ckerr "drv.spawn-stderr"
text ckpoll "drv.poll-running"
text ckkill "drv.kill-reap"
text ckgone "drv.poll-reaped"
text cktmo "drv.wait-timeout"
text cktmor "drv.timeout-reaped"
text ckexec "drv.exec-fail"
text ckopen "drv.spawn-open-fail"
text ckapp "drv.spawn-append"
text ckshr "drv.spawn-shared"
text ckio "drv.spawnio"
text ckiobad "drv.spawnio-bad-fd"
text cknul "drv.pkadd-nul"
text cklim "drv.pkadd-limit"
text ckport "drv.port"
text ckjload "drv.jload"
text ckutf "drv.jstr-utf8"
text ckjnum "drv.jnum"
text ckjarr "drv.jarr"
text cklast "drv.jkey-last"
text cknone "drv.jkey-none"
text ckjtyp "drv.jstr-type"
text ckarg "drv.arg"
text ckcnt "drv.count"
text ckclean "drv.rmrf-tree"

note dt_chk c nm: a PASS line for nm when c holds, a FAIL line otherwise.
fn dt_chk c bool nm view uchar * to void
if c
dv_pass nm part dvsp 0 0
else
dv_fail nm part dvsp 0 0
end
end

note ======== numbers and bytes

note dt_nums: dv_fmtl, dv_fmtu and dv_atou at their edges.
fn dt_nums to void
o = new uchar 64 0
p = dv_fmtl o 0 neg long 42
q = dv_fmtl o p sub neg long 9223372036854775807 1
dt_chk and dv_eq view part o 0 p dtm42 dv_eq view part o p sub q p dtmin ckfmtl
p = dv_fmtu o 0 dvnone
dt_chk dv_eq view part o 0 p dtmax ckfmtu
a = and eq dv_atou dt123 123 eq dv_atou dtmaxm sub dvnone 1
b = and eq dv_atou dtmax dvnone eq dv_atou dt12a dvnone
c = and eq dv_atou dt21 dvnone eq dv_atou part dt123 0 0 dvnone
dt_chk and a and b c ckatou
end

note dt_bytes: dv_find, dv_at and dv_eq.
fn dt_bytes to void
dt_chk and eq dv_find dtabcab dtca 0 2 eq dv_find dtabcab dtca 3 dvnone ckfind
dt_chk and dv_at dtabcab 2 dtca and not dv_at dtabcab 5 dtca dv_at dtabcab 6 part dtca 0 0 ckat
dt_chk and dv_eq dtca part dtabcab 2 2 and not dv_eq dtca dtab not dv_eq dtca part dtabcab 2 1 ckeq
end

note dt_jeq a b w: whether dv_join a b gives exactly w.
fn dt_jeq a view uchar * b view uchar * w view uchar * to bool
o = new uchar 64 0
n = dv_join o a b
if eq n dvnone
ret false
end
ret dv_eq view part o 0 n w
end

note dt_paths: dv_join and dv_dirn against os.path.join and os.path.dirname.
fn dt_paths to void
a = and dt_jeq dta dtb dtab2 dt_jeq dtas dtb dtab2
b = and dt_jeq dta dtsb part dtab2 1 2 dt_jeq part dta 0 0 dtb part dtab2 2 1
dt_chk and a b ckjoin
a = and eq dv_dirn dtxyz 3 eq dv_dirn dtxy 1
b = and eq dv_dirn dtsz 1 eq dv_dirn dtz 0
dt_chk and a b ckdirn
end

note ======== files

note dt_files bt: mkdirp, spit, apnd, slurp (and its size limit) and rmrf below T in bt.
fn dt_files bt view uchar 4096 to void
pa = new uchar 4096 0
fb = new uchar 64 0
sm = new uchar 2 0
n = dv_join pa part bt 0 get dtl 0 dtdeep
r = dv_mkdirp view part pa 0 n
dt_chk and eq r 0 eq dv_isdir view part pa 0 n 0 ckmkd
n = dv_join pa part bt 0 get dtl 0 dtfile
r = dv_spit view part pa 0 n dtab
s = dv_apnd view part pa 0 n dtcd
m = dv_slurp view part pa 0 n fb
dt_chk and and eq r 0 eq s 0 and eq m 4 dv_eq view part fb 0 4 dtabcd ckspit
dt_chk eq dv_slurp view part pa 0 n sm -27 ckcap
n = dv_join pa part bt 0 get dtl 0 dtd1
r = dv_rmrf view part pa 0 n
dt_chk and eq r 0 eq dv_isdir view part pa 0 n -2 ckrmrf
dt_chk eq dv_rmrf view part pa 0 n 0 ckrmm
end

note ======== processes

note dt_spself pk bs mode: the packed command "THIS child MODE" in pk; its length or dvnone.
fn dt_spself pk edit uchar 4096 bs view uchar 4096 mode view uchar * to ulong
p = dv_pkinit pk
p = dv_pkadd pk p part bs 0 get dtl 1
p = dv_pkadd pk p dtchild
ret dv_pkadd pk p mode
end

note dt_spoe pk p bo be: dv_spawn of pk[0, p) with stdout to T/o and stderr to T/e.
fn dt_spoe pk view uchar 4096 p ulong bo view uchar 4096 be view uchar 4096 to long
lo = get dtl 2
lx = get dtl 3
ret dv_spawn part pk 0 p part bo 0 lo part be 0 lx
end

note dt_proc1 bs bo be: the child's exit status and both captured streams.
fn dt_proc1 bs view uchar 4096 bo view uchar 4096 be view uchar 4096 to void
pk = new uchar 4096 0
fb = new uchar 64 0
p = dt_spself pk bs dtexit7
lo = get dtl 2
lx = get dtl 3
pid = dt_spoe pk p bo be
w = dv_wait pid 10000000000
dt_chk and gt pid 0 eq w 7 ckexit
m = dv_slurp part bo 0 lo fb
dt_chk and eq m 4 dv_eq view part fb 0 4 dtout ckout
m = dv_slurp part be 0 lx fb
dt_chk and eq m 4 dv_eq view part fb 0 4 dterr ckerr
end

note dt_proc2 bs: dv_poll on a running child, dv_kill and dv_reap (SIGTERM: 256 + 15), then
note dv_poll on the reaped pid (-10).
fn dt_proc2 bs view uchar 4096 to void
pk = new uchar 4096 0
p = dt_spself pk bs dtsleep
pid = dv_spawn view part pk 0 p dvnull dtnull
x = sleepns 50000000
r = dv_poll pid
dt_chk eq r -1 ckpoll
k = dv_kill pid 15
w = dv_reap pid
dt_chk and eq k 0 eq w 271 ckkill
dt_chk eq dv_poll pid -10 ckgone
end

note dt_proc3 bs: dv_wait's deadline: -110 after about 0.1 s, the child killed and reaped.
fn dt_proc3 bs view uchar 4096 to void
pk = new uchar 4096 0
p = dt_spself pk bs dtsleep
pid = dv_spawn view part pk 0 p dvnull dtnull
t0 = ulong monons
w = dv_wait pid 100000000
el = sub ulong monons t0
dt_chk and eq w -110 and ge el 100000000 lt el 5000000000 cktmo
dt_chk eq dv_poll pid -10 cktmor
end

note dt_proc4 bo: exit 127 when execprog fails, 126 when the output file cannot be opened.
fn dt_proc4 bo view uchar 4096 to void
pk = new uchar 4096 0
p = dv_pkinit pk
p = dv_pkadd pk p dtnope
pid = dv_spawn view part pk 0 p part bo 0 get dtl 2 dvnull
dt_chk eq dv_wait pid 10000000000 127 ckexec
pid = dv_spawn view part pk 0 p dtnope dvnull
dt_chk eq dv_wait pid 10000000000 126 ckopen
end

note dt_proc5 bs bo: dv_spawna appends both streams to one existing file: T/o holding "pre\n"
note becomes "pre\nout\nerr\n" after the exit7 child.
fn dt_proc5 bs view uchar 4096 bo view uchar 4096 to void
pk = new uchar 4096 0
fb = new uchar 64 0
lo = get dtl 2
r = dv_spit part bo 0 lo dtpre
p = dt_spself pk bs dtexit7
pid = dv_spawna view part pk 0 p part bo 0 lo
w = dv_wait pid 10000000000
ok = and eq r 0 eq w 7
m = dv_slurp part bo 0 lo fb
ok = and ok eq m 12
if ok
ok = dv_eq view part fb 0 12 dtapp
end
dt_chk ok ckapp
end

note dt_sp2 pk p bo: dv_spawn of pk[0, p) with stdout and stderr both to T/o, the path given in
note two buffers as callers do; the exit status.
fn dt_sp2 pk view uchar 4096 p ulong bo view uchar 4096 to long
b2 = new uchar 4096 0
lo = get dtl 2
k = dv_cat b2 0 part bo 0 lo
pid = dv_spawn part pk 0 p part bo 0 lo part b2 0 k
ret dv_wait pid 10000000000
end

note dt_proc6 bs bo: dv_spawn with the same file for stdout and stderr shares one offset: T/o
note holds "out\nerr\n" after the exit7 child (two truncating opens would leave "err\n").
fn dt_proc6 bs view uchar 4096 bo view uchar 4096 to void
pk = new uchar 4096 0
fb = new uchar 64 0
lo = get dtl 2
p = dt_spself pk bs dtexit7
w = dt_sp2 pk p bo
m = dv_slurp part bo 0 lo fb
ok = and eq w 7 eq m 8
if ok
ok = dv_eq view part fb 0 8 dtboth
end
dt_chk ok ckshr
end

note dt_iorun pk p bo: dv_spawnio of pk[0, p) with stdin /dev/null and one descriptor of T/o
note (truncated) for stdout and stderr; the exit status, or -1 when /dev/null cannot be opened.
fn dt_iorun pk view uchar 4096 p ulong bo view uchar 4096 to long
lo = get dtl 2
fi = fopen dtnull 0 len dtnull 524288 0
if lt fi 0
ret neg long 1
end
fo = fopen bo 0 lo 557633 420
pid = dv_spawnio part pk 0 p fi fo fo
w = dv_wait pid 10000000000
x = fclose int fo
x = fclose int fi
ret w
end

note dt_proc7 bs bo: dv_spawnio runs the exit7 child: exit 7 and T/o holding "out\nerr\n".
fn dt_proc7 bs view uchar 4096 bo view uchar 4096 to void
pk = new uchar 4096 0
fb = new uchar 64 0
lo = get dtl 2
p = dt_spself pk bs dtexit7
w = dt_iorun pk p bo
m = dv_slurp part bo 0 lo fb
ok = and eq w 7 eq m 8
if ok
ok = dv_eq view part fb 0 8 dtboth
end
dt_chk ok ckio
end

note dt_proc8 bs: dv_spawnio with a negative stdout descriptor: the child exits 126.
fn dt_proc8 bs view uchar 4096 to void
pk = new uchar 4096 0
p = dt_spself pk bs dtexit7
fi = fopen dtnull 0 len dtnull 524288 0
pid = dv_spawnio view part pk 0 p fi neg long 1 fi
w = dv_wait pid 10000000000
x = fclose int fi
dt_chk and ge fi 0 eq w 126 ckiobad
end

note dt_pkchk: dv_pkadd refuses an argument with a zero byte and a 65th argument.
fn dt_pkchk to void
pk = new uchar 4096 0
a = new uchar 3 0
put a 0 97
put a 2 98
p = dv_pkinit pk
dt_chk eq dv_pkadd pk p view a dvnone cknul
for i ulong 64
p = dv_pkadd pk p dta
end
dt_chk and ne p dvnone eq dv_pkadd pk p dta dvnone cklim
end

note dt_port: a free loopback port other than the live model servers' (NOT_RUN without sockets).
fn dt_port to void
r = dv_port
if lt r 0
dv_nrun ckport dtsock
ret
end
dt_chk and gt r 0 and ne r 18091 ne r 18300 ckport
end

note ======== JSON

note dt_jutf src tape: \u escapes and a surrogate pair decoded to UTF-8 (U+00E9, U+1F600).
fn dt_jutf src view uchar * tape view uint dvtcap to void
ob = new uchar 16 0
n = dv_jstr src tape dv_jkey src tape 0 dtks ob
ok = eq n 6
if ok
a = and eq get ob 0 195 eq get ob 1 169
b = and eq get ob 2 240 eq get ob 3 159
c = and eq get ob 4 152 eq get ob 5 128
ok = and a and b c
end
dt_chk ok ckutf
end

note dt_jrest src tape: numbers, arrays, a repeated key (the last wins), a missing key, a non-string.
fn dt_jrest src view uchar * tape view uint dvtcap to void
ob = new uchar 16 0
dt_chk eq dv_jnum src tape dv_jkey src tape 0 dtkn neg long 5 ckjnum
l = dv_jkey src tape 0 dtkl
dt_chk and eq dv_jlen tape l 3 eq dv_jnum src tape dv_jidx tape l 2 3 ckjarr
dt_chk dv_jsteq src tape dv_jkey src tape 0 dtkd dty cklast
dt_chk eq dv_jkey src tape 0 dtkz jsnone cknone
dt_chk eq dv_jstr src tape dv_jkey src tape 0 dtkn ob neg long 13 ckjtyp
end

note dt_json bt: T/j.json written and loaded with dv_jload, then dt_jutf and dt_jrest.
fn dt_json bt view uchar 4096 to void
src = new uchar 4096 0
tape = new uint dvtcap 0
pa = new uchar 4096 0
n = dv_join pa part bt 0 get dtl 0 dtjfile
r = dv_spit view part pa 0 n dtjson
k = dv_jload view part pa 0 n src tape
dt_chk and eq r 0 gt k 0 ckjload
if gt k 0
dt_jutf src tape
dt_jrest src tape
end
end

note dt_args: dv_arg refuses an index past dv_argc (-22) and a too-short buffer (-105).
fn dt_args to void
b = new uchar 1 0
dt_chk and eq dv_arg 99 b -22 eq dv_arg 0 b -105 ckarg
end

note ======== main

note dt_child: the child modes; exit status of this process.
fn dt_child to int
m = new uchar 16 0
n = dv_arg 2 m
if eq n 5
if dv_eq view part m 0 5 dtexit7
x = dv_out dtout
x = dv_err dterr
ret 7
end
if dv_eq view part m 0 5 dtsleep
x = sleepns 30000000000
ret 0
end
end
ret 2
end

note dt_setup bt bs bo be: T, this program, T/o and T/e into the arrays (lengths in dtl); T made
note empty; 0 or -1.
fn dt_setup bt edit uchar 4096 bs edit uchar 4096 bo edit uchar 4096 be edit uchar 4096 to long
sb = new uchar 4096 0
n = dv_arg 1 sb
if lt n 1
ret neg long 1
end
k = dv_join bt view part sb 0 ulong n dtsub
if eq k dvnone
ret neg long 1
end
put dtl 0 k
n = dv_arg 0 bs
if lt n 1
ret neg long 1
end
put dtl 1 ulong n
k = dv_join bo part bt 0 get dtl 0 dtofile
put dtl 2 k
k = dv_join be part bt 0 get dtl 0 dtefile
put dtl 3 k
r = dv_rmrf part bt 0 get dtl 0
r = dv_mkdirp part bt 0 get dtl 0
ret r
end

note dt_sum: print "DRV-TEST pass=P fail=F not_run=N".
fn dt_sum to void
o = new uchar 128 0
p = dv_cat o 0 dtsum1
p = dv_fmtu o p dv_count 0
p = dv_cat o p dtsum2
p = dv_fmtu o p dv_count 1
p = dv_cat o p dtsum3
p = dv_fmtu o p dv_count 2
p = dv_byte o p 10
x = dv_out view part o 0 p
end

fn main to int
bt = new uchar 4096 0
bs = new uchar 4096 0
bo = new uchar 4096 0
be = new uchar 4096 0
cb = new uchar 8 0
if ge dv_argc 3
n = dv_arg 1 cb
if eq n 5
if dv_eq view part cb 0 5 dtchild
ret dt_child
end
end
end
if ne dv_argc 2
x = dv_err dtusage
ret 2
end
if lt dt_setup bt bs bo be 0
x = dv_err dtbad
ret 2
end
dt_nums
dt_bytes
dt_paths
dt_args
dt_files bt
dt_proc1 bs bo be
dt_proc2 bs
dt_proc3 bs
dt_proc4 bo
dt_proc5 bs bo
dt_proc6 bs bo
dt_proc7 bs bo
dt_proc8 bs
dt_pkchk
dt_port
dt_json bt
c = add add dv_count 0 dv_count 1 dv_count 2
dt_chk eq c 38 ckcnt
r = dv_rmrf part bt 0 get dtl 0
dt_chk and eq r 0 eq dv_isdir part bt 0 get dtl 0 -2 ckclean
dt_sum
if eq dv_count 1 0
ret 0
end
ret 1
end

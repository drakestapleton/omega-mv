fn q_lines b view uchar * to ulong
c = ulong 0
for i ulong len b
if eq get b i 10
c = add c 1
end
end
ret c
end

fn q_dirty to ulong
b = new uchar 262144 0
if ne q_exec qstatus qgitout 30 0
q_die qstatus
end
n = q_sl qgitout b
if lt n 0
q_die qstatus
end
ret q_lines part b 0 ulong n
end

fn q_gitval cmd view uchar * ob edit uchar * p ulong to ulong
b = new uchar 8192 0
if ne q_exec cmd qgitout 30 0
q_die cmd
end
n = q_sl qgitout b
if lt n 0
q_die cmd
end
ret dv_cat ob p part b 0 q_trim part b 0 ulong n
end

fn q_platform to void
b = new uchar 16384 0
t = new uchar 8192 0
p = dv_cat b 0 qhost
p = q_gitval quname b p
p = dv_byte b p 32
n = dv_slurp qhn t
if lt n 0
q_die qhn
end
p = dv_cat b p part t 0 q_trim part t 0 ulong n
p = dv_byte b p 10
p = dv_cat b p qph
p = q_gitval qhead b p
p = dv_cat b p qpt
p = q_gitval qtree b p
p = dv_cat b p qpd
p = dv_fmtu b p q_dirty
p = dv_byte b p 10
p = dv_cat b p qpc
n = dv_slurp qps t
if lt n 0
q_die qps
end
p = q_cpuinfo b p part t 0 ulong n
q_sp qplat part b 0 p
x = dv_out part b 0 p
end

text qcpum "Cpus_allowed:\t"
text qcplist "cpus_list "
fn q_cpuinfo b edit uchar * p ulong t view uchar * to ulong
s = dv_find t qcpum 0
if eq s dvnone
q_die qcpum
end
s = add s len qcpum
e = add s q_len t s 10
q = p
started = false
while lt s e bound 8192
c = get t s
if ne c 44
if or started ne c 48
q = dv_byte b q c
started = true
end
end
s = add s 1
end
if not started
q = dv_byte b q 48
end
q = dv_byte b q 10
q = dv_cat b q qcplist
s = dv_find t qcpuk 0
if eq s dvnone
q_die qcpuk
end
s = add s len qcpuk
q = dv_cat b q part t s q_len t s 10
ret dv_byte b q 10
end

fn q_hashline pa view uchar * fd int to void
h = new uchar 64 0
if not q_hash pa h
q_die pa
end
x = dv_wall fd h
x = dv_wall fd qsp
x = dv_wall fd qsp
x = dv_wall fd pa
x = dv_wall fd qnl
end

fn q_hashall sf view uchar * to void
b = new uchar 262144 0
pa = new uchar 4096 0
if ne q_exec qlist qlsout 30 0
q_die qlist
end
n = q_sl qlsout b
if lt n 0
q_die qlsout
end
m = q_ep pa sf
fd = fopen pa 0 m 557633 420
if lt fd 0
q_die sf
end
s = ulong 0
while lt s ulong n bound 16777216
k = q_len part b 0 ulong n s 10
q_hashline part b s k int fd
s = add s add k 1
end
m = q_home pa
m = dv_cat pa m qoc
q_hashline part pa 0 m int fd
x = fclose int fd
end


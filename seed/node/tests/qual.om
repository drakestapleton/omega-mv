q_rmdir qrpd
r = q_exec qreplay qrpo 600
n = q_sl qrpo b
if lt n 0
q_die qrpo
end
s = q_lastline part b 0 ulong n
k = sub q_trim part b 0 ulong n s
ok = and eq r 0 ne dv_find part b 0 ulong n qrpok 0 dvnone
q_ver ok qrpn part b s k
end

fn q_agentrun to void
b = new uchar 262144 0
d = new uchar 4096 0
r = q_exec qagent qagno 600
n = q_sl qagno b
if lt n 0
q_die qagno
end
p = dv_cat d 0 qexit
p = dv_fmtl d p r
p = dv_byte d p 32

fn q_tcase rec view uchar * to void
cmd = new uchar 4096 0
args = new uchar 4096 0
b = new uchar 65536 0
n = q_field rec 3 args
p = dv_cat cmd 0 qtbin
p = dv_cat cmd p part args 0 n
r = q_exec part cmd 0 p qtcout 60
k = q_sl qtcout b
if lt k 0
q_die qtcout
end
q_tresult rec part b 0 ulong k r
end

fn q_got b view uchar * r long o edit uchar * to ulong
if ne r 0
p = dv_byte o 0 120
ret dv_fmtl o p r
end
p = dv_byte o 0 115
n = q_len b 0 10
s = q_len part b 0 n 0 32
if ge s n
ret p
end
s = add s 1
ret dv_cat o p part b s q_len part b 0 n s 32
end

fn q_tresult rec view uchar * b view uchar * r long to void
g = new uchar 64 0
n = q_got b r g
ok = q_matchgot rec part g 0 n
ok = and ok q_observed rec b
q_tdetail rec b part g 0 n
q_tnmresult rec ok
end

fn q_matchgot rec view uchar * got view uchar * to bool
w = new uchar 256 0
k = q_field rec 1 w
ret dv_eq got part w 0 k
end

fn q_observed rec view uchar * b view uchar * to bool
w = new uchar 256 0
k = q_field rec 2 w
ret ne dv_find b part w 0 k 0 dvnone
end

fn q_tnmresult rec view uchar * ok bool to void
w = new uchar 256 0
nm = new uchar 256 0
k = q_field rec 0 w
p = dv_cat nm 0 qtpre
p = dv_cat nm p part w 0 k
q_savedresult ok part nm 0 p
end

note The formatted tool detail is stored temporarily in a file, never in a shared global view.
text qtdetail "tc/detail.txt"
fn q_tdetail rec view uchar * b view uchar * got view uchar * to void
d = new uchar 4096 0
w = new uchar 256 0
p = dv_cat d 0 qtgot
p = dv_cat d p got
p = dv_cat d p qwant
k = q_field rec 1 w
p = dv_cat d p part w 0 k
p = dv_cat d p qms
p = dv_fmtu d p get qstate 4
p = dv_cat d p qtleak
p = dv_fmtu d p q_leaks
p = dv_cat d p qrecord
k = len b
if gt k 100
k = 100
end
p = q_record d p part b 0 k
q_sp qtdetail part d 0 p
end

fn q_record d edit uchar * p ulong b view uchar * to ulong
q = p
for i ulong len b
c = get b i
if eq c 10
c = 124
end
q = dv_byte d q c
end
ret q
end

fn q_savedresult ok bool nm view uchar * to void
d = new uchar 4096 0
n = q_sl qtdetail d
if lt n 0
q_die qtdetail
end
q_ver ok nm part d 0 ulong n
end


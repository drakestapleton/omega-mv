fn q_cleanunit to void
pa = new uchar 4096 0
n = q_ep pa qudir
x = dv_rmrf part pa 0 n
x = dv_mkdirp part pa 0 n
end

fn q_lastline b view uchar * to ulong
n = q_trim b
s = n
while gt s 0 bound 16777216
if eq get b sub s 1 10
break
end
s = sub s 1
end
ret s
end

fn q_unit to void
b = new uchar 65536 0
d = new uchar 4096 0
q_cleanunit
r = q_exec qucmd quout 120
n = q_sl quout b
if lt n 0
q_die quout
end
p = dv_cat d 0 qexit
p = dv_fmtl d p r
p = dv_byte d p 32
s = dv_find part b 0 ulong n qupre 0
if ne s dvnone
p = dv_cat d p part b s q_len part b 0 ulong n s 10
end
q_ver eq r 0 qunit part d 0 p
q_cleanunit
end

fn q_cmrun rec view uchar * to void
nm = new uchar 256 0
bn = new uchar 256 0
w = new uchar 32 0
n = q_field rec 0 nm
if not q_mutate qcode rec
q_result 1 part nm 0 n qmuterr
ret
end
if not q_comp qbase qcode qctest
q_die qbase
end
p = dv_cat bn 0 qmutpre
p = dv_cat bn p part nm 0 n
if not q_buildnm part bn 0 p qcomp
ret
end
k = q_field rec 4 w
want = long dv_atou part w 0 k
q_cmexec part bn 0 p part nm 0 n want
end

fn q_unitexec bn view uchar * to long
cmd = new uchar 4096 0
sf = new uchar 4096 0
q_cleanunit
p = dv_cat cmd 0 qbuild
p = dv_cat cmd p bn
p = dv_cat cmd p quarg
n = dv_cat sf 0 bn
n = dv_cat sf n qout
ret q_exec part cmd 0 p part sf 0 n 120
end

fn q_cmexec bn view uchar * nm view uchar * want long to void
d = new uchar 4096 0
r = q_unitexec bn
p = dv_cat d 0 nm
p = dv_cat d p qexit
p = dv_fmtl d p r
p = dv_cat d p qwant
p = dv_fmtl d p want
p = dv_cat d p qkilled
q_ver eq r want qmutnm part d 0 p
q_cleanunit
end


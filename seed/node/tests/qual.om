text qproof "seed/node/proofs/Result.lean"
text qaxf "lean-ax.lean"
text qax "apply_sets apply_keeps second_refused replay_keeps never_resumed_after_result lost_not_performed_only_inference"
text qprint "\n#print axioms OmegaNode.Result."
text qaxout "lean.out"
text qaxcmd "%L\t%Elean-ax.lean"
text qlv "%L\t--version"
text qlvo "lean-version.out"
text qlmodel "lean-result-model"
text qaxioms "depends on axioms: [propext]"
text qaxcnt " theorems_propext_only="
text qlmf "lean-mut.lean"
text qlmout "lean-mut.out"
text qlmcmd "%L\t%Elean-mut.lean"
text qlmold "r.obj ≥ 64 ∨ r.res = 0 ∨ (m r.obj).isSome"
text qlmnew "r.obj ≥ 64 ∨ r.res = 0"
text qlmn "mutant lean-second-result-allowed"
text qlmerr "error"
text qlmec " errors="

fn q_leanprep to void
b = new uchar 65536 0
n = dv_slurp qproof b
if lt n 0
q_die qproof
end
p = ulong n
s = ulong 0
while lt s len qax bound 6
k = q_len qax s 32
p = dv_cat b p qprint
p = dv_cat b p part qax s k
p = dv_byte b p 10
s = add s add k 1
end
q_sp qaxf part b 0 p
end

fn q_axcount b view uchar * to ulong
s = ulong 0
c = ulong 0
while lt s len b bound 16777216
n = q_len b s 10
if lt n len qaxioms
ret 0
end
if not dv_at b sub add s n len qaxioms qaxioms
ret 0
end
c = add c 1
s = add s add n 1
end
ret c
end

fn q_leanrun to void
b = new uchar 65536 0
d = new uchar 4096 0
q_leanprep
r = q_exec qaxcmd qaxout 120
n = q_sl qaxout b
if lt n 0
q_die qaxout
end
c = q_axcount part b 0 ulong n
p = dv_cat d 0 qexit
p = dv_fmtl d p r
p = dv_byte d p 32
x = q_exec qlv qlvo 30
n = q_sl qlvo b
if gt n 0
p = dv_cat d p part b 0 q_len part b 0 ulong n 0 44
end
p = dv_cat d p qaxcnt
p = dv_fmtu d p c
q_ver and eq r 0 eq c 6 qlmodel part d 0 p
q_leanmut
end

fn q_leanmut to void
b = new uchar 65536 0
d = new uchar 65536 0
n = dv_slurp qproof b
if lt n 0
q_die qproof
end
s = dv_find part b 0 ulong n qlmold 0
if eq s dvnone
q_result 1 qlmn qmuterr
ret
end
p = dv_cat d 0 part b 0 s
p = dv_cat d p qlmnew
s = add s len qlmold
p = dv_cat d p part b s sub ulong n s
q_sp qlmf part d 0 p
r = q_exec qlmcmd qlmout 120
n = q_sl qlmout b
if lt n 0
q_die qlmout
end
c = q_errlines part b 0 ulong n
p = dv_cat d 0 qexit
p = dv_fmtl d p r
p = dv_cat d p qlmec
p = dv_fmtu d p c
p = dv_cat d p qkilled
q_ver and ne r 0 gt c 0 qlmn part d 0 p
end

fn q_errlines b view uchar * to ulong
s = ulong 0
c = ulong 0
while lt s len b bound 16777216
n = q_len b s 10
if ne dv_find part b s n qlmerr 0 dvnone
c = add c 1
end
s = add s add n 1
end
ret c
end


fn q_oldpiece pa view uchar * fd int to void
cmd = new uchar 4096 0
path = new uchar 4096 0
p = dv_cat cmd 0 qoldcmd
p = dv_cat cmd p pa
if ne q_exec part cmd 0 p qoldsrc 30 0
q_die pa
end
n = q_ep path qoldsrc
if not q_copy part path 0 n fd
q_die pa
end
end

fn q_oldone nm view uchar * ls view uchar * to void
fd = fopen qcomp 0 len qcomp 557633 420
if lt fd 0
q_die qcomp
end
x = dv_wall int fd qom2
s = ulong 0
while lt s len ls bound 64
n = q_len ls s 32
q_oldpiece part ls s n int fd
s = add s add n 1
end
x = fclose int fd
q_oldcompile nm
end

fn q_oldcompile nm view uchar * to void
pa = new uchar 4096 0
bn = new uchar 4096 0
er = new uchar 4096 0
n = q_ep pa qold
m = dv_join bn part pa 0 n nm
n = q_art er nm qcerr
if ne q_compile qcomp part bn 0 m part er 0 n 0
q_die nm
end
end

fn q_oldhash nm view uchar * b edit uchar * p ulong to ulong
pa = new uchar 4096 0
h = new uchar 64 0
n = q_ep pa qold
n = dv_byte pa n 47
n = dv_cat pa n nm
if not q_hash part pa 0 n h
q_die nm
end
q = dv_cat b p part h 0 16
ret dv_byte b q 32
end

fn q_oldbuild to void
pa = new uchar 4096 0
b = new uchar 4096 0
n = q_ep pa qold
x = dv_rmrf part pa 0 n
if lt dv_mkdirp part pa 0 n 0
q_die qold
end
q_oldone qoldinf qinf
q_oldone qoldtl qtool
q_oldone qoldcm qoldls
p = dv_cat b 0 qoldp
p = q_oldhash qoldinf b p
p = q_oldhash qoldtl b p
p = q_oldhash qoldcm b p
q_log part b 0 p
n = q_ep pa qoldsrc
x = unlink pa 0 n
end


fn q_durable to void
a = new uchar 4096 0
b = new uchar 4096 0
db = new uchar 8192 0
an = q_ep a qte
bn = q_ep b qtok
ok = q_equal part a 0 an part b 0 bn
an = q_ep a qtjobs
fd = fopen a 0 an 573440 0
if lt fd 0
q_die qtjobs
end
while true bound 16777216
n = getdnts int fd db 0 8192
if lt n 0
ok = false
end
if le n 0
break
end
if ne dv_find part db 0 ulong n qtmpnew 0 dvnone
ok = false
end
end
x = fclose int fd
q_ver ok qdur qdurmsg
end


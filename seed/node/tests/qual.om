text qrbin "build/node/release-accept"
text qvn "view-accept"
text qrn "release-accept"
text qvpre "view-accept: "
text qrpre "release-accept: "
text qvo "accept.out"
text qro "release.out"
text qvd "accept"
text qrd "rel"
text qvs "VIEWSUM "
text qrs "RELSUM "
text qfzero " fail=0"
text qabsent "seeded driver binary absent; no Python fallback"
text qblocked "baseline did not pass; mutant not exercised"
text qvmut "vmutant"
text qrmut "rmutant"
text qvdir "vmut-"
text qrdir "rmut-"
text qfake "\tfake"
text qdargs "\t%O\t%R\t"
text qscen " scenario="
text qkillby " killed-by="
text qfailng " failing: "
text qall "all"
text qnone "none"
text qacc "/acc"
text qslash "/"
text qcmains "/code-main"
text qctests "/code-test"
text qcbinpre "/code-"
text qdmlist "infer tool op fake-serve"

fn q_driverexists kind ulong to bool
if eq kind 0
ret eq faccess qvbin 0 len qvbin 1 0
end
ret eq faccess qrbin 0 len qrbin 1 0
end

text qoldarg "%Eold"
fn q_dcommand b edit uchar * dir view uchar * acc view uchar * to ulong
p = ulong 0
if eq get qstate 7 0
p = dv_cat b 0 qvbin
else
p = dv_cat b 0 qrbin
p = dv_cat b p qfake
end
p = dv_byte b p 9
p = dv_cat b p dir
if eq get qstate 7 1
p = dv_byte b p 9
p = dv_cat b p qoldarg
end
p = dv_cat b p qdargs
ret dv_cat b p acc
end

fn q_summary b view uchar * o edit uchar * to ulong
s = ulong 0
while lt s len b bound 16777216
n = q_len b s 10
if or dv_at b s qvs dv_at b s qrs
ret dv_cat o 0 part b s n
end
s = add s add n 1
end
ret 0
end

fn q_dlines b view uchar * pre view uchar * to void
s = ulong 0
while lt s len b bound 16777216
n = q_len b s 10
if not or dv_at b s qvs dv_at b s qrs
q_prefix part b s n pre
end
s = add s add n 1
end
end

fn q_accept kind ulong to void
put qstate 7 kind
if not q_driverexists kind
if eq kind 0
q_result 2 qvn qabsent
else
q_result 2 qrn qabsent
end
ret
end
if eq kind 0
q_rmdir qvd
q_accept1 qvd qvo qvpre
else
q_rmdir qrd
q_accept1 qrd qro qrpre
end
end

text qbarg "%B/build/node"
fn q_accept1 dir view uchar * sf view uchar * pre view uchar * to void
cmd = new uchar 4096 0
p = q_acceptcmd dir cmd
r = q_exec part cmd 0 p sf 600
q_acceptresult sf pre r
q_collectbase dir
end

fn q_acceptcmd dir view uchar * cmd edit uchar * to ulong
absb = new uchar 4096 0
acc = new uchar 4096 0
n = q_expand qbarg absb
m = q_ep acc dir
ret q_dcommand cmd part absb 0 n part acc 0 m
end

fn q_collectbase dir view uchar * to void
acc = new uchar 4096 0
m = q_ep acc dir
q_collect part acc 0 m dir
end

fn q_acceptresult sf view uchar * pre view uchar * rc long to void
b = new uchar 262144 0
s = new uchar 4096 0
n = q_sl sf b
if lt n 0
q_die sf
end
q_dlines part b 0 ulong n pre
k = q_summary part b 0 ulong n s
q_acceptverdict part s 0 k rc
end

fn q_acceptverdict s view uchar * rc long to void
d = new uchar 8192 0
p = dv_cat d 0 qexit
p = dv_fmtl d p rc
p = dv_byte d p 32
p = dv_cat d p s
ok = and eq rc 0 q_goodsum s
if eq get qstate 7 0
q_ver ok qvn part d 0 p
ret
end
if and eq rc 3 q_goodsum s
if and gt q_nrnum s 0 ne q_nrnum s dvnone
q_result 2 qrn part d 0 p
ret
end
end
ok = and ok eq q_nrnum s 0
q_ver ok qrn part d 0 p
end

text qvsumpre "VIEWSUM pass="
text qrsumpre "RELSUM pass="
text qnrkey " not_run="
fn q_goodsum s view uchar * to bool
p = ulong 0
if eq get qstate 7 0
if not dv_at s 0 qvsumpre
ret false
end
p = len qvsumpre
else
if not dv_at s 0 qrsumpre
ret false
end
p = len qrsumpre
end
n = q_len s p 32
if eq dv_atou part s p n dvnone
ret false
end
p = add p n
if not dv_at s p qfzero
ret false
end
p = add p len qfzero
if eq get qstate 7 0
if eq p len s
ret true
end
ret eq get s p 32
end
if ge p len s
ret false
end
ret and eq get s p 32 ne q_nrnum s dvnone
end

fn q_nrnum s view uchar * to ulong
p = dv_find s qnrkey 0
if eq p dvnone
ret dvnone
end
p = add p len qnrkey
ret dv_atou part s p q_len s p 32
end

note Copy only acceptance evidence, preserving originals in the evidence directory as well.
fn q_collect root view uchar * tag view uchar * to void
b = new uchar 8192 0
fd = fopen root 0 len root 573440 0
if lt fd 0
ret
end
while true bound 16777216
n = getdnts int fd b 0 8192
if le n 0
break
end
q_colentries root tag part b 0 ulong n
end
x = fclose int fd
end

fn q_colentries root view uchar * tag view uchar * b view uchar * to void
s = ulong 0
while lt add s 19 len b bound 8192
rl = or ulong get b add s 16 shl ulong get b add s 17 8
if or lt rl 20 gt add s rl len b
q_die root
end
n = q_len b add s 19 0
if ne get b add s 19 46
q_colchild root tag part b add s 19 n
end
s = add s rl
end
end

fn q_colchild root view uchar * tag view uchar * name view uchar * to void
pa = new uchar 4096 0
nt = new uchar 4096 0
n = dv_join pa root name
p = dv_cat nt 0 tag
p = dv_byte nt p 45
p = dv_cat nt p name
if eq dv_isdir part pa 0 n 0
q_collect part pa 0 n part nt 0 p
ret
end
if q_evidencefile name
q_copyev part pa 0 n part nt 0 p
end
end

text qflog "fake.log"
text qjname "journal"
fn q_evidencefile name view uchar * to bool
if or dv_eq name qflog dv_eq name qjname
ret true
end
if lt len name 4
ret false
end
ret dv_at name sub len name 4 qout
end

fn q_copyev src view uchar * sf view uchar * to void
pa = new uchar 4096 0
n = q_ep pa sf
fd = fopen pa 0 n 557633 420
if lt fd 0
q_die sf
end
if not q_copy src int fd
q_die src
end
x = fclose int fd
end

note Driver mutant record: name|old|new|function prefix|unit|scenario|check.
fn q_dmutdir rec view uchar * o edit uchar * to ulong
nm = new uchar 256 0
k = q_field rec 0 nm
p = q_ep o part qempty 0 0
if eq get qstate 7 0
p = dv_cat o p qvdir
else
p = dv_cat o p qrdir
end
ret dv_cat o p part nm 0 k
end

fn q_dcopy dir view uchar * to void
src = new uchar 4096 0
dst = new uchar 4096 0
s = ulong 0
while lt s len qdmlist bound 4
n = q_len qdmlist s 32
sn = dv_join src qbuild part qdmlist s n
dn = dv_join dst dir part qdmlist s n
fd = fopen dst 0 dn 557633 493
if lt fd 0
q_die dir
end
if not q_copy part src 0 sn int fd
q_die dir
end
x = fclose int fd
x = chmod dst 0 dn 493
s = add s add n 1
end
end

fn q_dcompile dir view uchar * unit view uchar * tail view uchar * to bool
bin = new uchar 4096 0
err = new uchar 4096 0
if not q_comp qbase unit tail
ret false
end
n = dv_cat bin 0 dir
if dv_eq tail qcmain
n = dv_cat bin n qcmains
else
n = dv_cat bin n qctests
end
p = dv_cat err 0 dir
p = dv_cat err p qcerr
ret eq q_compile qcomp part bin 0 n part err 0 p 0
end

fn q_dmutbuild rec view uchar * dir view uchar * to bool
unit = new uchar 4096 0
old = new uchar 4096 0
n = q_field rec 4 unit
k = q_field rec 1 old
if eq k 0
x = dv_spit qmut part qempty 0 0
fd = fopen qmut 0 len qmut 557633 420
if not q_copy part unit 0 n int fd
q_die rec
end
x = fclose int fd
else
if not q_mutate part unit 0 n rec
q_dmutfail rec qmuterr
ret false
end
end
ok = q_dcompile dir part unit 0 n qcmain
ok = and ok q_dcompile dir part unit 0 n qctest
if not ok
q_dmutfail rec qcmpf
end
ret ok
end

fn q_dmutfail rec view uchar * detail view uchar * to void
nm = new uchar 256 0
d = new uchar 4096 0
n = q_field rec 0 nm
p = dv_cat d 0 part nm 0 n
p = dv_byte d p 32
p = dv_cat d p detail
if eq get qstate 7 0
q_result 1 qvmut part d 0 p
else
q_result 1 qrmut part d 0 p
end
end

fn q_dnotrun rec view uchar * why view uchar * to void
nm = new uchar 256 0
d = new uchar 4096 0
n = q_field rec 0 nm
p = dv_cat d 0 part nm 0 n
p = dv_byte d p 32
p = dv_cat d p why
if eq get qstate 7 0
q_result 2 qvmut part d 0 p
else
q_result 2 qrmut part d 0 p
end
end

fn q_dmut rec view uchar * to void
dir = new uchar 4096 0
if eq get qstate 8 0
q_dnotrun rec qblocked
ret
end
n = q_dmutdir rec dir
x = dv_rmrf part dir 0 n
if lt dv_mkdirp part dir 0 n 0
q_die rec
end
q_dcopy part dir 0 n
if q_dmutbuild rec part dir 0 n
if q_driverexists get qstate 7
q_dmutexec rec part dir 0 n
else
q_dnotrun rec qabsent
end
end
q_killchildren part dir 0 n
x = dv_rmrf part dir 0 n
end

text qdmout "driver-mutant.out"
fn q_dmutexec rec view uchar * dir view uchar * to void
cmd = new uchar 4096 0
acc = new uchar 4096 0
sc = new uchar 256 0
n = dv_cat acc 0 dir
n = dv_cat acc n qacc
p = q_dcommand cmd dir part acc 0 n
k = q_field rec 5 sc
if ne k 0
p = dv_byte cmd p 9
p = dv_cat cmd p part sc 0 k
end
r = q_exec part cmd 0 p qdmout 600
q_dmutresult rec r
q_dsave rec
end

fn q_dsave rec view uchar * to void
src = new uchar 4096 0
sf = new uchar 4096 0
nm = new uchar 256 0
n = q_ep src qdmout
k = q_field rec 0 nm
p = ulong 0
if eq get qstate 7 0
p = dv_cat sf 0 qvdir
else
p = dv_cat sf 0 qrdir
end
p = dv_cat sf p part nm 0 k
p = dv_cat sf p qout
q_copyev part src 0 n part sf 0 p
end

fn q_dmutresult rec view uchar * rc long to void
b = new uchar 262144 0
n = q_sl qdmout b
if lt n 0
q_die qdmout
end
ok = q_dkilled rec part b 0 ulong n rc
q_dmutdetail rec part b 0 ulong n ok
end

fn q_dkilled rec view uchar * b view uchar * rc long to bool
ck = new uchar 256 0
s = new uchar 4096 0
k = q_field rec 6 ck
m = q_summary b s
ok = false
if eq k 0
ok = q_goodsum part s 0 m
if eq get qstate 7 0
ok = and ok eq rc 0
else
ok = and ok or eq rc 0 eq rc 3
end
put qstate 8 0
if ok
put qstate 8 1
end
else
ok = q_namedfailure b part ck 0 k
end
ret ok
end

fn q_namedfailure b view uchar * ck view uchar * to bool
pre = new uchar 512 0
p = dv_cat pre 0 qfail
p = dv_cat pre p ck
p = dv_byte pre p 32
ret gt q_countpre b part pre 0 p 0
end

fn q_dmutdetail rec view uchar * b view uchar * ok bool to void
d = new uchar 16384 0
t = new uchar 4096 0
n = q_field rec 0 t
p = dv_cat d 0 part t 0 n
p = dv_cat d p qscen
n = q_field rec 5 t
if eq n 0
n = dv_cat t 0 qall
end
p = dv_cat d p part t 0 n
p = dv_cat d p qkillby
n = q_field rec 6 t
if eq n 0
n = dv_cat t 0 qnone
end
p = dv_cat d p part t 0 n
p = dv_byte d p 32
n = q_summary b t
p = dv_cat d p part t 0 n
p = dv_cat d p qfailng
p = q_failnames b d p
if eq get qstate 7 0
q_ver ok qvmut part d 0 p
else
q_ver ok qrmut part d 0 p
end
end

fn q_failnames b view uchar * d edit uchar * p ulong to ulong
s = ulong 0
q = p
while lt s len b bound 16777216
n = q_len b s 10
if dv_at b s qfail
k = add s len qfail
q = dv_cat d q part b k q_len part b 0 add s n k 32
q = dv_byte d q 32
end
s = add s add n 1
end
ret q
end

note Clean up only processes whose argv[0] is below this exact newly-created mutant directory.
fn q_killchildren dir view uchar * to void
b = new uchar 8192 0
fd = fopen qproc 0 len qproc 573440 0
if lt fd 0
q_die qproc
end
while true bound 16777216
n = getdnts int fd b 0 8192
if le n 0
break
end
q_killentries dir part b 0 ulong n
end
x = fclose int fd
end

fn q_killentries dir view uchar * b view uchar * to void
s = ulong 0
while lt add s 19 len b bound 8192
rl = or ulong get b add s 16 shl ulong get b add s 17 8
if or lt rl 20 gt add s rl len b
q_die dir
end
n = q_len b add s 19 0
pid = dv_atou part b add s 19 n
if ne pid dvnone
q_killone dir part b add s 19 n pid
end
s = add s rl
end
end

fn q_killone dir view uchar * name view uchar * pid ulong to void
pa = new uchar 4096 0
b = new uchar 4096 0
n = dv_join pa qproc name
n = dv_cat pa n qcmdln
k = dv_slurp part pa 0 n b
if le k 0
ret
end
n = dv_cat pa 0 dir
n = dv_cat pa n qcbinpre
if dv_at part b 0 ulong k 0 part pa 0 n
x = killpid int pid 9
end
end

text qvm0 "vm0_baseline||||seed/node/code.om||"
text qvm1 "vm1_no_stale_check|if gt cw_g t 17 get d 3|if false||seed/node/code.om|commands|cmd-stale-409"
text qvm2 "vm2_no_duplicate_check|if ge k 0|if false|fn cw_cmd |seed/node/code.om|commands|cmd-duplicate-ack"
text qvm3 "vm3_no_oper_replay|cw_replay c|cw_dirs||seed/node/code.om|crash|crash-oper-replayed"
text qvm4 "vm4_no_uncertain_event|x = vw_ev 7 i 0 id 0|x = vw_ver||seed/node/code.om|uncertain|uncertain-event"
text qvm5 "vm5_delta_off_by_one|e = add sv add k 1|e = add sv add k 2||seed/node/view.om|resync|resync-delta-from-0"
text qvm6 "vm6_no_incarnation_check|if eq vw_qnum cs io vwqinc vw_g 4|if true||seed/node/view.om|commands|cmd-other-incarnation"
text qvm7 "vm7_pause_only_recorded|x = auth_pause c eq op 1|x = ulong 0||seed/node/code.om|commands|cmd-paused-holds"
text qvm8 "vm8_redirect_ends_job|if cw_oper i|if false|fn cw_done |seed/node/code.om|redirect|redirect-run-passes"
text qvm9 "vm9_budget_ignored|if ge cw_g i 7 cw_g i 16|if ge cw_g i 7 7||seed/node/code.om|budget|budget-ends-12"
text qvm10 "vm10_refusals_uncounted|vw_cnt 0 add vw_cget 0 1|x = vw_ver||seed/node/code.om|overload|overload-refusals-visible"
text qvm11 "vm11_ack_current_version|vw_ack 0 jn_opw ulong jn_ofind get d 0 7 get jseq 0|vw_ack 0 vw_ver get jseq 0||seed/node/code.om|commands|cmd-pause-duplicate-version"
text qvm12 "vm12_view_outlives_creator|if or ne vw_g 6 0 ne ulong getppid me|if ne vw_g 6 0||seed/node/view.om|crash|crash-view-exits-with-creator"
text qrm0 "rm0_baseline||||seed/node/code.om||"
text qrm1 "rm1_result_not_journaled|x = jn_result i r cw_g i 7|x = ulong 0||seed/node/code.om|full|full-results-durable"
text qrm2 "rm2_result_not_reported|if ne jn_res i 0|if false||seed/node/code.om|full|full-results-durable"
text qrm3 "rm3_lost_infer_unknown|if eq get aurec add mul k 32 20 2|if false||seed/node/auth.om|worker|worker-death-rerun"

fn q_viewruns to void
q_accept 0
put qstate 7 0
put qstate 8 1
q_dmut qvm0
q_dmut qvm1
q_dmut qvm2
q_dmut qvm3
q_dmut qvm4
q_dmut qvm5
q_dmut qvm6
q_dmut qvm7
q_dmut qvm8
q_dmut qvm9
q_dmut qvm10
q_dmut qvm11
q_dmut qvm12
end

fn q_relruns to void
q_accept 1
put qstate 7 1
put qstate 8 1
q_dmut qrm0
q_dmut qrm1
q_dmut qrm2
q_dmut qrm3
end

text qjrrec "jr-second-result|if ne get jres mul i 2 0|if false||173"
text qhsnap "source-hashes.txt"
text qtreeok "tree-unchanged-during-run"
text qevid "evidence "
text qusage "usage: qual EVIDENCE_DIR (run from the checkout root; HOME must locate OMC40, round40, Lean)"

fn q_jrmut to void
if not q_mutate qjour qjrrec
q_result 1 qjrlabel qmuterr
ret
end
put qstate 9 1
if not q_comp qlbase qjour qjtest
q_die qjour
end
put qstate 9 0
x = dv_rmrf qjt
q_gate qjrnm qcomp 173
x = dv_rmrf qjt
end

fn q_start to void
pa = new uchar 4096 0
b = new uchar 262144 0
if ne dv_argc 2
q_die qusage
end
n = q_ep pa part qempty 0 0
if lt dv_mkdirp part pa 0 n 0
q_die qusage
end
if lt dv_mkdirp qbuild 0
q_die qbuild
end
n = q_ep pa qres
fd = fopen pa 0 n 557633 420
if lt fd 0
q_die qres
end
put qstate 0 ulong fd
q_platform
q_hashall qhashes
k = q_sl qhashes b
if lt k 0
q_die qhashes
end
q_sp qhsnap part b 0 ulong k
q_cmprec qcmp0
q_cmprec qcmp1
q_cmprec qcmp2
q_cmprec qcmp3
q_cmprec qcmp4
q_cmprec qcmp5
end

fn q_finish to int
a = new uchar 4096 0
b = new uchar 4096 0
q_hashall qhash2
n = q_ep a qhsnap
m = q_ep b qhash2
ok = q_equal part a 0 n part b 0 m
ok = and ok eq q_dirty 0
q_ver ok qtreeok part qempty 0 0
q_counts
p = dv_cat b 0 qevid
n = q_ep a part qempty 0 0
p = dv_cat b p part a 0 n
x = dv_out part b 0 p
x = dv_out qnl
x = fclose int get qstate 0
x = unlink qmut 0 len qmut
x = unlink qcomp 0 len qcomp
q_rmdir qudir
if ne get qstate 2 0
ret 1
end
if ne get qstate 3 0
ret 3
end
ret 0
end

fn q_counts to void
b = new uchar 256 0
for i ulong 3
p = ulong 0
if eq i 0
p = dv_cat b 0 qpass
end
if eq i 1
p = dv_cat b 0 qfail
end
if eq i 2
p = dv_cat b 0 qnr
end
p = dv_cat b p qcnt
p = dv_fmtu b p get qstate add i 1
q_log part b 0 p
end
end

fn main to int
q_start
q_ngate qgt0
q_ngate qgt1
q_ngate qgt2
q_ngate qgt3
x = dv_rmrf qjt
q_ngate qgt4
x = dv_rmrf qjt
q_gate qgt5 qag 0
q_release
q_oldbuild
q_unit
q_cmutants
q_viewruns
q_relruns
q_jrmut
q_replayrun
q_tools
q_agentrun
q_leanrun
ret q_finish
end

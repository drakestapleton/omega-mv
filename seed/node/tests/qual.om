global qstate ulong 12
text qminusn "-n"
text qnice19 "19"
text qfn "fn "

fn q_die b view uchar * to void
x = dv_err b
x = dv_err qnl
exit 2
end

fn q_len b view uchar * s ulong sep uchar to ulong
e = s
while lt e len b bound 16777216
if eq get b e sep
break
end
e = add e 1
end
ret sub e s
end

fn q_field b view uchar * ix ulong o edit uchar * to ulong
s = ulong 0
for i ulong ix
s = add s add q_len b s 124 1
if gt s len b
ret 0
end
end
ret dv_cat o 0 part b s q_len b s 124
end

fn q_trim b view uchar * to ulong
n = len b
while gt n 0 bound 16777216
if gt get b sub n 1 32
break
end
n = sub n 1
end
ret n
end

fn q_home o edit uchar * to ulong
b = new uchar 8192 0
for i ulong ulong envcnt
n = envread i b 0 8192
if gt n 5
if dv_at part b 0 ulong n 0 qhome
ret dv_cat o 0 part b 5 sub ulong n 5
end
end
end
q_die qhome
ret 0
end

fn q_ep o edit uchar * sf view uchar * to ulong
b = new uchar 4096 0
c = new uchar 4096 0
n = dv_arg 1 b
if lt n 1
q_die qres
end
if ne get b 0 47
k = cwd c 0 4096
if le k 0
q_die qres
end
p = dv_byte c sub ulong k 1 47
p = dv_cat c p part b 0 ulong n
ret dv_join o part c 0 p sf
end
ret dv_join o part b 0 ulong n sf
end

fn q_expand a view uchar * o edit uchar * to ulong
if lt len a 2
ret dv_cat o 0 a
end
if ne get a 0 37
ret dv_cat o 0 a
end
n = ulong 0
c = get a 1
if eq c 69
n = q_ep o part a 2 sub len a 2
ret n
end
if eq c 66
r = cwd o 0 len o
if le r 0
q_die a
end
n = sub ulong r 1
end
if or eq c 72 or eq c 79 or eq c 82 eq c 76
n = q_home o
end
if eq c 79
n = dv_cat o n qoc
end
if eq c 82
n = dv_cat o n qr40
end
if eq c 76
n = dv_cat o n qlean
end
ret dv_cat o n part a 2 sub len a 2
end

fn q_pack cmd view uchar * pk edit uchar * to ulong
b = new uchar 4096 0
p = dv_pkinit pk
s = ulong 0
while lt s len cmd bound 64
n = q_len cmd s 9
k = q_expand part cmd s n b
p = dv_pkadd pk p part b 0 k
if eq p dvnone
q_die cmd
end
s = add s add n 1
end
ret p
end

fn q_exec cmd view uchar * sf view uchar * sec ulong to long
pk = new uchar 4096 0
pa = new uchar 4096 0
n = q_pack cmd pk
m = q_ep pa sf
pid = q_spawn1 part pk 0 n part pa 0 m
ret q_wait pid sec
end

fn q_wait pid long sec ulong to long
t = ulong monons
r = dv_wait pid mul sec 1000000000
put qstate 4 div sub ulong monons t 1000000
if eq r -110
ret 124
end
ret r
end

fn q_spawn1 pk view uchar * pa view uchar * to long
fi = fopen qnull 0 len qnull 524288 0
fo = fopen pa 0 len pa 557633 420
pid = dv_spawnio pk fi fo fo
x = fclose int fi
x = fclose int fo
ret pid
end

fn q_sl sf view uchar * b edit uchar * to long
pa = new uchar 4096 0
n = q_ep pa sf
ret dv_slurp part pa 0 n b
end

fn q_sp sf view uchar * b view uchar * to void
pa = new uchar 4096 0
n = q_ep pa sf
if lt dv_spit part pa 0 n b 0
q_die sf
end
end

fn q_log b view uchar * to void
x = dv_wall int get qstate 0 b
x = dv_wall int get qstate 0 qnl
x = dv_out b
x = dv_out qnl
end

text qjrlabel "mutant jr-second-result"
text qjrnm "mut-jr-second-result"
fn q_result kind ulong nm view uchar * det view uchar * to void
b = new uchar 16384 0
p = ulong 0
if eq kind 0
p = dv_cat b 0 qpass
end
if eq kind 1
p = dv_cat b 0 qfail
end
if eq kind 2
p = dv_cat b 0 qnr
end
p = dv_cat b p nm
if ne len det 0
if ne get det 0 32
p = dv_byte b p 32
end
p = dv_cat b p det
end
q_log part b 0 p
put qstate add 1 kind add get qstate add 1 kind 1
end

fn q_ver ok bool nm view uchar * det view uchar * to void
if ok
q_result 0 nm det
else
q_result 1 nm det
end
end

fn q_hash pa view uchar * ob edit uchar * to bool
c = new ulong 40 0
b = new uchar 65536 0
d = new uchar 32 0
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret false
end
sha256_init c
while true bound 16777216
k = read int fd b 0 65536
if lt k 0
x = fclose int fd
ret false
end
if eq k 0
break
end
sha256_update c part b 0 ulong k
end
x = fclose int fd
sha256_final c d
q_hex d ob
ret true
end

fn q_hex d view uchar 32 ob edit uchar * to void
for i ulong 32
v = ulong get d i
put ob mul i 2 get qhex shr v 4
put ob add mul i 2 1 get qhex and v 15
end
end

fn q_equal a view uchar * b view uchar * to bool
ha = new uchar 64 0
hb = new uchar 64 0
if not q_hash a ha
ret false
end
if not q_hash b hb
ret false
end
ret dv_eq ha hb
end

fn q_copy pa view uchar * fd int to bool
b = new uchar 65536 0
fi = fopen pa 0 len pa 524288 0
if lt fi 0
ret false
end
ok = true
while true bound 16777216
k = read int fi b 0 65536
if lt k 0
ok = false
break
end
if eq k 0
break
end
if lt dv_wall fd part b 0 ulong k 0
ok = false
break
end
end
x = fclose int fi
ret ok
end

fn q_iocmd pk view uchar * fi long fo long fe long to long
pid = dv_spawnio pk fi fo fe
x = fclose int fi
x = fclose int fo
x = fclose int fe
ret dv_wait pid 300000000000
end

fn q_compile src view uchar * bin view uchar * err view uchar * to long
pk = new uchar 4096 0
p = q_pack qnice pk
p = dv_pkadd pk p qminusn
p = dv_pkadd pk p qnice19
p = dv_pkadd pk p qomc
fi = fopen src 0 len src 524288 0
fo = fopen bin 0 len bin 557633 511
fe = fopen err 0 len err 557633 420
r = q_iocmd part pk 0 p fi fo fe
if eq r 0
x = chmod bin 0 len bin 493
end
ret r
end

note Compose a space-separated list, optionally replacing the selected unit with qmut.
fn q_comp ls view uchar * swap view uchar * tail view uchar * to bool
fd = fopen qcomp 0 len qcomp 557633 420
if lt fd 0
ret false
end
if eq get qstate 9 0
x = dv_wall int fd qom2
end
s = ulong 0
ok = true
while lt s len ls bound 64
n = q_len ls s 32
if dv_eq part ls s n swap
ok = and ok q_copy qmut int fd
else
ok = and ok q_copy part ls s n int fd
end
s = add s add n 1
end
if ne len tail 0
ok = and ok q_copy tail int fd
end
x = fclose int fd
ret ok
end

note Whole-line mutation, optional function range. Record fields: name|old|new|fn-prefix|want.
fn q_mutline line view uchar * rec view uchar * fd int to void
b = new uchar 4096 0
n = q_field rec 1 b
if dv_eq line part b 0 n
n = q_field rec 2 b
x = dv_wall fd part b 0 n
put qstate 5 add get qstate 5 1
else
x = dv_wall fd line
end
end

fn q_mutbuf b view uchar * rec view uchar * fd int to void
rg = new uchar 256 0
n = q_field rec 3 rg
on = eq n 0
s = ulong 0
while lt s len b bound 16777216
k = q_len b s 10
if gt n 0
if dv_at b s qfn
on = dv_at b s part rg 0 n
end
end
if on
q_mutline part b s k rec fd
else
x = dv_wall fd part b s k
end
s = add s k
if lt s len b
x = dv_wall fd qnl
s = add s 1
end
end
end

fn q_mutate src view uchar * rec view uchar * to bool
b = new uchar 262144 0
n = dv_slurp src b
put qstate 5 0
if lt n 0
ret false
end
fd = fopen qmut 0 len qmut 557633 420
if lt fd 0
ret false
end
q_mutbuf part b 0 ulong n rec int fd
x = fclose int fd
ret gt get qstate 5 0
end

note Count only exact /bin/sleep argv pairs, reading procfs, not shell or pgrep.
text qproc "/proc"
text qcmdln "/cmdline"
text qsleep "/bin/sleep"
fn q_sleep b view uchar * to bool
if lt len b 13
ret false
end
if not dv_at b 0 qsleep
ret false
end
if ne get b 10 0
ret false
end
n = q_len b 11 0
if ne add n 12 len b
ret false
end
v = dv_atou part b 11 n
ret or eq v 1 or eq v 30 or eq v 300 eq v 301
end

fn q_leakent b view uchar * to ulong
pa = new uchar 4096 0
cmd = new uchar 4096 0
s = ulong 0
c = ulong 0
while lt add s 19 len b bound 4096
rl = or ulong get b add s 16 shl ulong get b add s 17 8
if or lt rl 20 gt add s rl len b
q_die qproc
end
n = q_len b add s 19 0
if ne dv_atou part b add s 19 n dvnone
p = dv_join pa qproc part b add s 19 n
p = dv_cat pa p qcmdln
k = dv_slurp part pa 0 p cmd
if gt k 0
if or q_sleep part cmd 0 ulong k q_slowcmd part cmd 0 ulong k
c = add c 1
end
end
end
s = add s rl
end
ret c
end

fn q_leaks to ulong
b = new uchar 8192 0
fd = fopen qproc 0 len qproc 573440 0
if lt fd 0
q_die qproc
end
c = ulong 0
while true bound 16777216
n = getdnts int fd b 0 8192
if le n 0
break
end
c = add c q_leakent part b 0 ulong n
end
x = fclose int fd
ret c
end

fn q_art o edit uchar * nm view uchar * sf view uchar * to ulong
b = new uchar 4096 0
n = dv_cat b 0 nm
n = dv_cat b n sf
ret q_ep o part b 0 n
end

fn q_gateout b edit uchar * p ulong nm view uchar * to ulong
pa = new uchar 4096 0
ob = new uchar 65536 0
n = q_art pa nm qout
k = dv_slurp part pa 0 n ob
if lt k 0
ret p
end
s = ulong 0
if gt k 120
s = sub ulong k 120
end
q = p
while lt s ulong k bound 65536
c = get ob s
if eq c 10
c = 32
end
q = dv_byte b q c
s = add s 1
end
ret q
end

fn q_gate nm view uchar * src view uchar * want long to void
h = new uchar 64 0
if not q_buildnm nm src
ret
end
q_binsha nm h
r = q_runname nm
q_gresult nm h r want
end

fn q_buildnm nm view uchar * src view uchar * to bool
bin = new uchar 4096 0
err = new uchar 4096 0
bn = dv_join bin qbuild nm
en = q_art err nm qcerr
r = q_compile src part bin 0 bn part err 0 en
if ne r 0
q_cfail nm r part err 0 en
ret false
end
ret true
end

fn q_binsha nm view uchar * h edit uchar 64 to void
pa = new uchar 4096 0
n = dv_join pa qbuild nm
if not q_hash part pa 0 n h
q_die nm
end
n = q_art pa nm qsha
x = dv_spit part pa 0 n h
end

fn q_runname nm view uchar * to long
bin = new uchar 4096 0
pk = new uchar 4096 0
bn = dv_join bin qbuild nm
p = dv_pkinit pk
p = dv_pkadd pk p part bin 0 bn
ret q_namedspawn part pk 0 p nm
end

fn q_namedspawn pk view uchar * nm view uchar * to long
err = new uchar 4096 0
ob = new uchar 4096 0
en = q_art err nm qerrsf
on = q_art ob nm qout
pid = dv_spawn pk part ob 0 on part err 0 en
ret q_wait pid 300
end

fn q_cfail nm view uchar * r long err view uchar * to void
b = new uchar 16384 0
t = new uchar 8192 0
p = dv_cat b 0 qcompile
p = dv_fmtl b p r
n = dv_slurp err t
if gt n 0
p = dv_byte b p 32
p = dv_cat b p part t 0 q_trim part t 0 ulong n
end
q_result 1 nm part b 0 p
end

fn q_gresult nm view uchar * h view uchar 64 r long want long to void
b = new uchar 16384 0
p = dv_cat b 0 qcompile
p = dv_byte b p 48
p = dv_cat b p qexit
p = dv_fmtl b p r
p = dv_cat b p qwant
p = dv_fmtl b p want
p = dv_cat b p qms
p = dv_fmtu b p get qstate 4
p = dv_cat b p qbin
p = dv_cat b p part h 0 16
p = dv_cat b p qleak
p = dv_fmtu b p q_leaks
p = dv_cat b p qstdout
p = q_gateout b p nm
if dv_eq nm qjrnm
q_ver eq r want qjrlabel part b 0 p
else
q_ver eq r want nm part b 0 p
end
end


fn q_cmprec rec view uchar * to void
ls = new uchar 4096 0
pa = new uchar 4096 0
b = new uchar 4096 0
n = q_field rec 1 ls
fd = fopen qcomp 0 len qcomp 557633 420
if lt fd 0
q_die qcomp
end
s = ulong 0
while lt s n bound 64
k = q_len part ls 0 n s 32
if not q_copy part ls s k int fd
q_die rec
end
s = add s add k 1
end
x = fclose int fd
n = q_field rec 2 pa
if not q_equal qcomp part pa 0 n
q_result 1 rec qcmpf
ret
end
n = q_field rec 0 b
n = dv_cat b n qcok
m = q_ep pa qhashes
x = dv_apnd part pa 0 m part b 0 n
end


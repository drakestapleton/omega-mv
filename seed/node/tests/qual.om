text qcmp1 "pool|seed/node/transport.om seed/node/pool.om seed/node/super.om seed/node/pool-test.om|seed/node/pool-gate.om"
text qcmp2 "sched|seed/node/transport.om seed/node/pool.om seed/node/super.om seed/node/sched.om seed/node/sched-test.om|seed/node/sched-gate.om"

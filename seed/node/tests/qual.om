fn q_prefix b view uchar * pre view uchar * to void
t = new uchar 16384 0
s = ulong 0
while lt s len b bound 16777216
n = q_len b s 10
p = dv_cat t 0 pre
p = dv_cat t p part b s n
q_log part t 0 p
s = add s add n 1
end
end

fn q_countpre b view uchar * pre view uchar * to ulong
s = ulong 0
c = ulong 0
while lt s len b bound 16777216
if dv_at b s pre
c = add c 1
end
s = add s add q_len b s 10 1
end
ret c
end

fn q_release to void
b = new uchar 16384 0
d = new uchar 4096 0
r = q_exec qrb qrbo 300
n = q_sl qrbo b
if lt n 0
q_die qrbo
end
p = dv_cat d 0 qexit
p = dv_fmtl d p r
p = dv_byte d p 32
p = dv_fmtu d p q_countpre part b 0 ulong n qbok
p = dv_cat d p qprogs
q_ver eq r 0 qrbnm part d 0 p
q_prefix part b 0 ulong n qtwosp
r = q_exec qrb2 qrbo2 300
q_reproduce r
end

fn q_reproduce rc long to void
b = new uchar 4096 0
d = new uchar 4096 0
s = ulong 0
put qstate 6 0
if ne rc 0
put qstate 6 1
end
p = dv_cat d 0 qreprod
while lt s len qrblist bound 6
k = q_len qrblist s 32
p = q_reproone part qrblist s k d p
s = add s add k 1
end
q_ver eq get qstate 6 0 qrbrnm part d 0 p
bn = q_ep b qrbd
x = dv_rmrf part b 0 bn
end

fn q_reproone nm view uchar * d edit uchar * p ulong to ulong
a = new uchar 4096 0
b = new uchar 4096 0
h = new uchar 64 0
an = dv_join a qbuild nm
bn = q_ep b qrbd
bn = dv_byte b bn 47
bn = dv_cat b bn nm
if not q_equal part a 0 an part b 0 bn
put qstate 6 1
end
q = dv_cat d p nm
q = dv_byte d q 32
if q_hash part b 0 bn h
q = dv_cat d q h
end
ret dv_byte d q 32
end


note ======== scenarios

note va_name o sc: scenario sc's name (vn0..vn8) written at o[0]; its length.
fn va_name o edit uchar 64 sc ulong to ulong
if eq sc 0
ret dv_cat o 0 vn0
end
if eq sc 1
ret dv_cat o 0 vn1
end
if eq sc 2
ret dv_cat o 0 vn2
end
if eq sc 3
ret dv_cat o 0 vn3
end
if eq sc 4
ret dv_cat o 0 vn4
end
if eq sc 5
ret dv_cat o 0 vn5
end
if eq sc 6
ret dv_cat o 0 vn6
end
if eq sc 7
ret dv_cat o 0 vn7
end
ret dv_cat o 0 vn8
end

note va_ids o sc: scenario sc's job ids (view-prep's ID list) written at o[0]; its length.
fn va_ids o edit uchar 128 sc ulong to ulong
if eq sc 0
ret dv_cat o 0 vi0
end
if or eq sc 3 eq sc 8
ret dv_cat o 0 vi3
end
if eq sc 6
ret dv_cat o 0 vi6
end
if eq sc 7
ret dv_cat o 0 vi7
end
ret dv_cat o 0 vi1
end

note va_dl sc: scenario sc's fake-serve delay in milliseconds.
fn va_dl sc ulong to ulong
if eq sc 0
ret 150
end
if eq sc 1
ret 400
end
if eq sc 2
ret 1200
end
if eq sc 3
ret 4000
end
if eq sc 4
ret 2000
end
if eq sc 5
ret 700
end
if or eq sc 6 eq sc 7
ret 300
end
ret 1500
end

note va_prog o sc: scenario sc's node command (nd_set slot 6) written at o[0]; its length.
fn va_prog o edit uchar 64 sc ulong to ulong
if eq sc 6
ret dv_cat o 0 vpovl
end
if eq sc 7
ret dv_cat o 0 vpunc
end
ret dv_cat o 0 vpmain
end

fn va_pfail sc ulong to void
o = new uchar 64 0
t = new uchar 64 0
p = dv_cat o 0 vatp
n = va_name t sc
p = dv_cat o p view part t 0 n
dv_fail view part o 0 p vaprep
end

note va_start cx js tp sc: scenario sc's fixture (OUTDIR/DIR), fake-serve and node (vas); false
note after "FAIL t_NAME prep" when the fixture could not be prepared.
fn va_start cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap sc ulong to bool
nm = new uchar 64 0
id = new uchar 128 0
n = va_name nm sc
if eq sc 2
n = dv_cat nm 0 vncmds
end
ok = nd_base cx view part nm 0 n
c = long -1
if ok
m = va_ids id sc
c = nd_prep cx js tp view part id 0 m eq sc 4
end
if lt c 0
va_pfail sc
ret false
end
f = nd_fake cx va_dl sc
put vas 1 f
k = va_prog nm sc
x = nd_set cx 6 view part nm 0 k
i = nd_node cx vtrun get ndport 0
put vas 0 i
ret true
end

fn va_scen cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap sc ulong to void
if not va_start cx js tp sc
ret
end
if eq sc 0
va_full cx js tp
end
if eq sc 1
va_resy cx js tp
end
if eq sc 2
va_cmds cx js tp
end
if eq sc 3
va_canc cx js tp
end
if eq sc 4
va_redir cx js tp
end
if eq sc 5
va_budg cx js tp
end
if eq sc 6
va_ovl cx js tp
end
if eq sc 7
va_unc cx js tp
end
if eq sc 8
va_crash cx js tp
end
end

note va_want sc: scenario sc runs (no SCENARIO argument, or one naming it).
fn va_want sc ulong to bool
nm = new uchar 64 0
a = new uchar 64 0
if le dv_argc 5
ret true
end
n = va_name nm sc
for k ulong sub dv_argc 5
m = dv_arg add k 5 a
if eq m long n
if dv_eq view part a 0 n view part nm 0 n
ret true
end
end
end
ret false
end

fn main to int
cx = new uchar 65536 0
js = new uchar ndjsz 0
tp = new uint dvtcap 0
o = new uchar 128 0
if lt dv_argc 5
x = dv_err vausage
ret 2
end
for s ulong 4
if lt nd_abs cx s add s 1 0
x = dv_err vausage
ret 2
end
end
x = dv_mkdirp view part cx 12288 get ndl 3
for sc ulong 9
if va_want sc
va_scen cx js tp sc
nd_clean
end
end
p = dv_cat o 0 vasum
p = dv_fmtu o p dv_count 0
p = dv_cat o p vafail
p = dv_fmtu o p dv_count 1
p = dv_byte o p 10
x = dv_out view part o 0 p
if gt dv_count 1 0
ret 1
end
ret 0
end

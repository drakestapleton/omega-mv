text vk24 "cancel-other-objective-passes"
text vk25 "redirect-committed"
text vk26 "redirect-visible"
text vk27 "redirect-invalid-kind"
text vk28 "redirect-run-passes"
text vk29 "redirect-wrong-goal-unanswered"

fn va_uaft js view uchar ndjsz tp view uint dvtcap rc long st ulong to void
o = new uchar 1024 0
w = new uchar 1024 0
u = nd_tk js tp 0 ndkunc
m = va_il w 0 js tp u
ok = va_ueq w m st
ok = and ok eq rc 0
ok = and ok eq get vav 8 1
ok = and ok eq nd_ti js tp 0 ndkinc add get vav 9 1

p = dv_cat o p ndnone
else
p = dv_fmtl o p get vav 6
end
va_res ok vk33 o p
end

fn va_ocom to void
o = new uchar 1024 0
p = dv_cat o 0 ndnone
if ne get vav 7 0
p = va_put o 0 0
end
va_res eq get vav 7 1 vk34 o p
end

fn va_ovl cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
vp = get ndport 1
va_port vp vk32 eq get ndport 2 1
put vav 5 0
put vav 6 -1
put vav 7 0
i = get vas 0
while eq nd_poll i -1 bound 100000000
r = nd_view cx js tp vp
if ne r 0
break
end
va_oseen js tp
if gt get vav 5 0
if eq get vav 7 0
va_ocmd cx js tp vp
end
end
x = sleepns 50000000
end
rc = nd_fin i 120
va_kf
va_oref
va_ocom
va_rsum cx rc 30 vk35
end

note ======== 8. uncertain effect: the worker running a replace is killed

note va_ulast js tp: a view listing uncertain jobs kept (vav[8..11], its list as text 1).
fn va_ulast js view uchar ndjsz tp view uint dvtcap to void
o = new uchar 1024 0
u = nd_tk js tp 0 ndkunc
n = nd_n tp u
if eq n 0
ret
end
put vav 8 1
put vav 9 nd_ti js tp 0 ndkinc
put vav 10 long n
put vav 11 nd_ei js tp u 0
p = va_il o 0 js tp u
va_keep 1 o p
end

note va_ev7 js tp: a delta's kind 7 events appended to text 2 (vav[12..14]).
fn va_ev7 js view uchar ndjsz tp view uint dvtcap to void
o = new uchar 1024 0
ev = nd_tk js tp 0 ndkevs
n = nd_n tp ev
for k ulong n
e = nd_el tp ev k
if eq nd_ei js tp e 1 7
c = get vav 12
if eq c 0
put vav 13 nd_ei js tp e 4
put vav 14 nd_ei js tp e 2
end
put vav 12 add c 1
p = va_put o 0 2
if gt c 0
p = dv_cat o p vdcs
end
p = va_il o p js tp e
va_keep 2 o p
end
end
end

fn va_unl cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
vp = get ndport 1

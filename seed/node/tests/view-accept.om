note ======== 7. overloaded queue: admission limit 1, refusals visible, commands still commit

fn va_oseen js view uchar ndjsz tp view uint dvtcap to void
q = nd_tk js tp 0 ndkq
r = nd_ti js tp q ndkref
if gt r get vav 5
put vav 5 r
end
put vav 6 nd_ti js tp q ndklim
end

note va_ocmd cx js tp vp: cmd 140 (budget 7 for objective 2) from the last view; an answer that
note parsed and is not stale kept as text 0 (vav[7] 1 when committed, else 2).
fn va_ocmd cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long to void
o = new uchar 1024 0
inc = nd_ti js tp 0 ndkinc
ver = nd_ti js tp 0 ndkver
nd_args 5 140 4 2 inc ver
nd_argx 1 7 0 0 0
r = nd_cmd cx js tp vp
if eq get ndr 1 0
ret
end
if nd_status js tp ndstale
ret
end
p = nd_dj o 0 js tp 0
va_keep 0 o p
put vav 7 2
if nd_status js tp ndkcomm
put vav 7 1
end
end

fn va_oref to void
o = new uchar 1024 0
ok = and gt get vav 5 0 eq get vav 6 1
p = dv_cat o 0 vdref

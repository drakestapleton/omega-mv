text vk41 "crash-view-exits-with-creator"
text vk42 "crash-oper-replayed"
text vk43 "crash-old-client-resyncs"
text vk44 "crash-duplicate-after-restart"
text vk45 "crash-cancel-finished-invalid"
text vk46 "crash-run2-results"

text vdport "port="
text vdrc "rc="
text vdv1 "v="
text vdv " v="
text vdobjs " objs="
text vdid "id="
text vdbud "budget="
text vdlast " last="
text vdorig " original="
text vdgone "view gone rc="
text vdauth "auth="

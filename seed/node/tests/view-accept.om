text vdinc " inc="
text vdunc2 " uncertain="
text vdinc1 "inc="
text vdcmds " cmds="
text vdr1 " r1="
text vdb0 " b0="
text vd200 "{200: "
text vd201 ", 201: "
text vdtrue "True"
text vdfalse "False"
text vdcs ", "
text vdqd "'delta'"
text vdqs "'snapshot'"
text vdqo "'other'"
text vdemp "[]"
text vlsum "CWSUM pass="
text vlcwo "CWO"
text vlcwo0 "CWO 0 "
text vlcwos "CWO "
text vlf21 " FAIL 21"
text vlc19 "CWO 0 FAIL 19 1"
text vlc12 "CWO 0 FAIL 12 2"
text vlc190 "CWO 1 FAIL 19 0"
text vlcwop "CWO 0 PASS"
text vlf404 "F 404"
text vlcwe "CWE "

note ======== results and kept texts

note va_res ok nm o n: the result line for check nm with detail o[0..n) (up to its first zero byte
note when n is dvnone), the whole line cut at 400 characters as view-accept.py did.
fn va_res ok bool nm view uchar * o view uchar 1024 n ulong to void
m = n
if gt m 1024
m = 0
while lt m 1024 bound 1025
if eq get o m 0
break
end
m = add m 1
end
end
lim = sub 394 len nm
if gt m lim
m = lim
end
if ok
dv_pass nm view part o 0 m
else
dv_fail nm view part o 0 m
end
end

note va_keep k o n: o[0..n) kept as text k (0..3).
fn va_keep k ulong o view uchar 1024 n ulong to void
m = n
if gt m 1024
m = 1024
end
b = mul k 1024
for i ulong m
put vat add b i get o i
end
put vatl k m
end

note va_put o p k: kept text k appended at o[p]; the end.
fn va_put o edit uchar 1024 p ulong k ulong to ulong
q = p
b = mul k 1024
n = get vatl k
for i ulong n
if lt q 1024
put o q get vat add b i
q = add q 1
end
end
ret q
end

note va_tf o p st: True (st 1), False (0) or None appended at o[p].
fn va_tf o edit uchar 1024 p ulong st ulong to ulong
if eq st 1
ret dv_cat o p vdtrue
end
if eq st 0
ret dv_cat o p vdfalse
end
ret dv_cat o p ndnone
end

note ======== answers

note va_sv o p js tp t: string token t's text without quotes (any other token as JSON, None when
note missing) appended at o[p].
fn va_sv o edit uchar 1024 p ulong js view uchar ndjsz tp view uint dvtcap t ulong to ulong
if or eq get ndr 1 0 eq t jsnone
ret dv_cat o p ndnone
end
if ne js_type tp t jsstr
ret nd_dj o p js tp t
end
s = add js_off tp t 1
n = sub js_span tp t 2
ret dv_cat o p view part js s n
end

note va_kind js tp s: true when the last answer's kind is s.
fn va_kind js view uchar * tp view uint dvtcap s view uchar * to bool
v = nd_tk js tp 0 ndkkind
if eq v jsnone
ret false
end
ret dv_jsteq js tp v s
end

note va_ob js tp k: integer member k of the last answer's objectives[0].
fn va_ob js view uchar ndjsz tp view uint dvtcap k view uchar * to long
a = nd_tk js tp 0 ndkobs
o = nd_el tp a 0
ret nd_ti js tp o k
end

note va_ti2 js tp k1 k2: integer member k2 of the last answer's member k1.
fn va_ti2 js view uchar ndjsz tp view uint dvtcap k1 view uchar * k2 view uchar * to long
t = nd_tk js tp 0 k1
ret nd_ti js tp t k2
end

note va_stk js tp k: the last answer's status is committed (k 1), stale (2), invalid (3) or
note duplicate (4).
fn va_stk js view uchar ndjsz tp view uint dvtcap k ulong to bool
if eq k 1
ret nd_status js tp ndkcomm
end
if eq k 2
ret nd_status js tp ndstale
end
if eq k 3
ret nd_status js tp ndinval
end
ret nd_status js tp nddup
end

note va_ast js tp rc wk nm: check nm on a command answer, wk = form*100 + rc*10 + status (va_stk):
note rc as wanted and that status; the detail the answer, after "rc=RC " (form 1) or "id=CID " (2).
fn va_ast js view uchar ndjsz tp view uint dvtcap rc long wk ulong nm view uchar * to bool
o = new uchar 1024 0
md = div wk 100
w = rem div wk 10 10
ok = and eq rc long w va_stk js tp rem wk 10
p = ulong 0
if eq md 1
p = dv_cat o 0 vdrc
p = dv_fmtl o p rc
p = dv_byte o p 32
end
if eq md 2
p = dv_cat o 0 vdid
p = dv_fmtl o p get ndoa 0
p = dv_byte o p 32
end
p = nd_dj o p js tp 0
va_res ok nm o p
ret ok
end

note va_il o p js tp t: the integer list t as Python prints it ([1, 2]) appended at o[p].
fn va_il o edit uchar 1024 p ulong js view uchar ndjsz tp view uint dvtcap t ulong to ulong
q = dv_byte o p 91
n = nd_n tp t
for k ulong n
if gt k 0
q = dv_cat o q vdcs
end
v = nd_ei js tp t k
q = dv_fmtl o q v
end
ret dv_byte o q 93
end

note va_vc js tp md a: the wait condition on the last view: version >= a (md 1), objectives[0]
note version > a (2), objectives[0] phase == a (3).
fn va_vc js view uchar ndjsz tp view uint dvtcap md ulong a long to bool
if eq get ndr 1 0
ret false
end
if eq md 1
ret ge nd_ti js tp 0 ndkver a
end
if eq md 2
ret gt va_ob js tp ndkver a
end
ret eq va_ob js tp ndkph a
end

note va_wv cx js tp vp md a: view vp every 20 ms for up to 10 s until va_vc holds.
fn va_wv cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long md ulong a long to bool
t0 = ulong monons
for k ulong 1000000
r = nd_view cx js tp vp
if va_vc js tp md a
ret true
end
if ge sub ulong monons t0 10000000000
ret false
end
x = sleepns 20000000
end
ret false
end

note va_kf: SIGKILL fake-serve and reap it.
fn va_kf to void
f = get vas 1
x = nd_sig f 9
x = nd_reap f
end

note va_sumt t code: "CWSUM pass=P fail=F" (P, F the tens and units of code) written at t[0];
note its length.
fn va_sumt t edit uchar 64 code ulong to ulong
m = dv_cat t 0 vlsum
m = dv_fmtu t m rem div code 10 10
m = dv_cat t m vafail
ret dv_fmtu t m rem code 10
end

note va_hsum b code: b has the line va_sumt of code.
fn va_hsum b view uchar * code ulong to bool
t = new uchar 64 0
m = va_sumt t code
ret nd_hasl b view part t 0 m
end

note va_rsum cx rc code nm: check nm on BASE/run.out: status rc == code/100 and the line va_sumt;
note the detail "rc=RC LAST-LINE".
fn va_rsum cx edit uchar 65536 rc long code ulong nm view uchar * to void
b = new uchar 262144 0
o = new uchar 1024 0
n = nd_outl cx vtrun b
if lt n 0
n = long 0
end
ok = va_hsum view part b 0 ulong n code
ok = and ok eq rc long div code 100
p = dv_cat o 0 vdrc
p = dv_fmtl o p rc
p = dv_byte o p 32
p = nd_lastl o p view part b 0 ulong n
va_res ok nm o p
end

note va_port vp nm ok: check nm with the detail "port=VP".
fn va_port vp long nm view uchar * ok bool to void
o = new uchar 1024 0
p = dv_cat o 0 vdport
p = dv_fmtl o p vp
va_res ok nm o p
end

note va_rcd rc nm ok: check nm with the detail "rc=RC".
fn va_rcd rc long nm view uchar * ok bool to void
o = new uchar 1024 0
p = dv_cat o 0 vdrc
p = dv_fmtl o p rc
va_res ok nm o p
end

note va_wgone vp: wait up to 3 s until nothing listens on vp; true when nothing does.
fn va_wgone vp long to bool
t0 = ulong monons
for k ulong 1000000
if not nd_lsn vp
ret true
end
if ge sub ulong monons t0 3000000000
break
end
x = sleepns 20000000
end
ret not nd_lsn vp
end

note ======== 1. full workflow, followed through snapshot + deltas, with a disconnect

note va_num b: the next blank-separated decimal of b from vapos[0] (ndbad[0] 1 when none).
fn va_num b view uchar * to long
s = get vapos 0
n = len b
while lt s n bound 16777217
if ne get b s 32
break
end
s = add s 1
end
ng = false
if lt s n
if eq get b s 45
ng = true
s = add s 1
end
end
v = long 0
d = ulong 0
while lt s n bound 16777217
c = ulong get b s
if or lt c 48 gt c 57
break
end
v = add mul v 10 long sub c 48
d = add d 1
s = add s 1
end
put vapos 0 s
if eq d 0
put ndbad 0 1
end
if ng
ret neg v
end
ret v
end

note va_cwl l c: true when the four numbers of l are event c of ndev.
fn va_cwl l view uchar * c ulong to bool
put vapos 0 0
put ndbad 0 0
ok = true
for k ulong 4
v = va_num l
if ne v get ndev add mul c 4 k
ok = false
end
end
ret and ok eq get ndbad 0 0
end

note va_cwe b: the "CWE " lines of b (vav[3] their number) start with the ndev events.
fn va_cwe b view uchar * to bool
c = ulong 0
ok = true
m = get ndevn 0
s = ulong 0
while lt s len b bound 16777217
e = nd_lend b s
if nd_pfx b s e vlcwe
if lt c m
f = add s 4
if not va_cwl view part b f sub e f c
ok = false
end
end
c = add c 1
end
s = add e 1
end
put vav 3 long c
ret and ok ge c m
end

note va_bit m: bit m set in vav[2].
fn va_bit m long to void
b = get vav 2
if eq rem div b m 2 0
put vav 2 add b m
end
end

note va_kinds o p b: the sorted kinds of bits b as Python prints the list.
fn va_kinds o edit uchar 1024 p ulong b long to ulong
q = dv_byte o p 91
c = false
if eq rem b 2 1
q = dv_cat o q vdqd
c = true
end
if eq rem div b 2 2 1
if c
q = dv_cat o q vdcs
end
q = dv_cat o q vdqs
c = true
end
if gt b 3
if c
q = dv_cat o q vdcs
end
q = dv_cat o q vdqo
end
ret dv_byte o q 93
end

note va_addev js tp e: job event e ([ver, 1, i, k, n, a...]) kept in ndev as e2 e4 e3 e5.
fn va_addev js view uchar ndjsz tp view uint dvtcap e ulong to void
j = get ndevn 0
if ge j 4096
ret
end
b = mul j 4
put ndev b nd_ei js tp e 2
put ndev add b 1 nd_ei js tp e 4
put ndev add b 2 nd_ei js tp e 3
put ndev add b 3 nd_ei js tp e 5
put ndevn 0 add j 1
end

note va_fevs js tp ver: a delta's events followed from ver (gaps counted, job events kept); the
note last event's version.
fn va_fevs js view uchar ndjsz tp view uint dvtcap ver long to long
ev = nd_tk js tp 0 ndkevs
n = nd_n tp ev
v = ver
for k ulong n
e = nd_el tp ev k
e0 = nd_ei js tp e 0
if ne e0 add v 1
put vav 1 add get vav 1 1
end
v = e0
if eq nd_ei js tp e 1 1
va_addev js tp e
end
end
ret v
end

note va_fd js tp ver: one answer of the follow loop: its kind noted; the version to follow from.
fn va_fd js view uchar ndjsz tp view uint dvtcap ver long to long
if va_kind js tp nddelta
va_bit 1
ret va_fevs js tp ver
end
if va_kind js tp ndsnap
va_bit 2
else
va_bit 4
end
ret nd_ti js tp 0 ndkver
end

fn va_fsnap cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long to long
o = new uchar 1024 0
rc = nd_view cx js tp vp
ob = nd_tk js tp 0 ndkobs
put ndbad 0 0
nb = nd_n tp ob
bad = get ndbad 0
ok = and eq rc 0 va_kind js tp ndsnap
ok = and ok eq nd_ti js tp 0 ndklay 1
ok = and ok eq nb 4
v = nd_tk js tp 0 ndkver
p = dv_cat o 0 vdrc
p = dv_fmtl o p rc
p = dv_cat o p vdv
p = nd_dj o p js tp v
p = dv_cat o p vdobjs
if eq bad 0
p = dv_fmtu o p nb
else
p = dv_cat o p ndnone
end
va_res ok vk02 o p
ret nd_ti js tp 0 ndkinc
end

note va_floop cx js tp vp inc: follow the node's view from version 0 while it runs, not polling
note between 1.0 s and 2.5 s.
fn va_floop cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long inc long to void
put vav 0 0
put vav 1 0
put vav 2 0
put ndevn 0 0
ver = long 0
i = get vas 0
t0 = ulong monons
while eq nd_poll i -1 bound 100000000
el = sub ulong monons t0
if and gt el 1000000000 lt el 2500000000
put vav 0 add get vav 0 1
x = sleepns 50000000
else
r = nd_viewd cx js tp vp ver inc
if or ne r 0 eq get ndr 1 0
break
end
ver = va_fd js tp ver
x = sleepns 30000000
end
end
end

fn va_fds cx edit uchar 65536 to void
b = new uchar 262144 0
o = new uchar 1024 0
n = nd_outl cx vtrun b
if lt n 0
n = long 0
end
m = va_cwe view part b 0 ulong n
nm = get ndevn 0
ok = and m gt get vav 0 0
ok = and ok eq get vav 2 1
ok = and ok eq get vav 1 0
ok = and ok gt nm 20
p = dv_cat o 0 vdgn
p = dv_fmtl o p get vav 0
p = dv_cat o p vdkinds
p = va_kinds o p get vav 2
p = dv_cat o p vdgaps
p = dv_fmtl o p get vav 1
p = dv_cat o p vdjev
p = dv_fmtu o p nm
p = dv_byte o p 47
p = dv_fmtl o p get vav 3
va_res ok vk04 o p
end

fn va_full cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
vp = get ndport 1
va_port vp vk01 eq get ndport 2 1
inc = va_fsnap cx js tp vp
va_floop cx js tp vp inc
rc = nd_fin get vas 0 60
va_kf
va_rsum cx rc 40 vk03
va_fds cx
va_port vp vk05 not nd_lsn vp
end

note ======== 2. resync: wrong incarnation and impossible since give a snapshot

note va_seq js tp ver: the last answer's events are versions 1..ver in order.
fn va_seq js view uchar ndjsz tp view uint dvtcap ver long to bool
ev = nd_tk js tp 0 ndkevs
n = nd_n tp ev
if ne long n ver
ret false
end
for k ulong n
e = nd_el tp ev k
if ne nd_ei js tp e 0 long add k 1
ret false
end
end
ret true
end

fn va_rs1 js view uchar ndjsz tp view uint dvtcap rc long to void
o = new uchar 1024 0
ok = and eq rc 0 va_kind js tp nddelta
ver = nd_ti js tp 0 ndkver
ok = and ok ge ver 2
ok = and ok va_seq js tp ver
v = nd_tk js tp 0 ndkver
ev = nd_tk js tp 0 ndkevs
p = dv_cat o 0 vdv1
p = nd_dj o p js tp v
p = dv_cat o p vdn
if eq get ndr 1 0
p = dv_cat o p ndnone
else
p = dv_fmtu o p nd_n tp ev
end
va_res ok vk06 o p
end

note va_rsk js tp rc nm: check nm: rc 0 and a snapshot; the detail "kind=KIND".
fn va_rsk js view uchar ndjsz tp view uint dvtcap rc long nm view uchar * to void
o = new uchar 1024 0
ok = and eq rc 0 va_kind js tp ndsnap
k = nd_tk js tp 0 ndkkind
p = dv_cat o 0 vdkind
p = va_sv o p js tp k
va_res ok nm o p
end

fn va_resy cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
vp = get ndport 1
x = va_wv cx js tp vp 1 2
r = nd_view cx js tp vp
inc = nd_ti js tp 0 ndkinc
ver = nd_ti js tp 0 ndkver
r = nd_viewd cx js tp vp 0 inc
va_rs1 js tp r
r = nd_viewd cx js tp vp 0 add inc 7
va_rsk js tp r vk07
r = nd_viewd cx js tp vp add ver 1000 inc
va_rsk js tp r vk08
r = nd_vctl cx js tp vp
va_rcd r vk09 eq r 2
r = nd_fin get vas 0 60
va_kf
end

note ======== 3. commands: stale, invalid, committed, duplicate, pause/resume

fn va_cm1 cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long to void
r = nd_view cx js tp vp
i0 = nd_ti js tp 0 ndkinc
v0 = nd_ti js tp 0 ndkver
x = va_wv cx js tp vp 2 v0
nd_args 5 11 4 0 i0 v0
nd_argx 1 6 0 0 0
r = nd_cmd cx js tp vp
x = va_ast js tp r 112 vk10
nd_args 3 12 4 0 0 0
nd_argx 1 9 0 0 0
r = nd_fresh cx js tp vp
x = va_ast js tp r 113 vk11
r = nd_view cx js tp vp
i1 = nd_ti js tp 0 ndkinc
nd_args 5 13 9 0 add i1 1 0
nd_argx 1 6 0 0 0
r = nd_cmd cx js tp vp
x = va_ast js tp r 112 vk12
end

fn va_bvis js view uchar ndjsz tp view uint dvtcap to void
o = new uchar 1024 0
b = va_ob js tp ndkbud
l = va_ti2 js tp ndkcmds ndklast
ok = and eq b 6 eq l 14
p = dv_cat o 0 vdbud
p = dv_fmtl o p b
p = dv_cat o p vdlast
p = dv_fmtl o p l
va_res ok vk14 o p
end

note va_dup cx js tp vp rc av: cmd-duplicate-ack on the last answer: rc 0, duplicate, version av,
note and a new view counting one committed command.
fn va_dup cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long rc long av long to void
o = new uchar 1024 0
ok = and eq rc 0 nd_status js tp nddup
ok = and ok eq nd_ti js tp 0 ndkver av
p = nd_dj o 0 js tp 0
if ok
r = nd_view cx js tp vp
ok = eq va_ti2 js tp ndkcmds ndkcomm 1
end
va_res ok vk15 o p
end

fn va_pdup js view uchar ndjsz tp view uint dvtcap rc long av long to void
o = new uchar 1024 0
ok = and eq rc 0 nd_status js tp nddup
ok = and ok eq nd_ti js tp 0 ndkver av
p = nd_dj o 0 js tp 0
p = dv_cat o p vdorig
p = dv_fmtl o p av
va_res ok vk17 o p
end

fn va_cm2 cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap vp long to void
nd_args 3 14 4 0 0 0
nd_argx 1 6 0 0 0
r = nd_fresh cx js tp vp

note ======== 4. cancel an objective whose inference is in flight

note va_wo0 cx: wait up to 10 s until BASE/run.out has a line starting "CWO 0 ".
fn va_wo0 cx edit uchar 65536 to bool
b = new uchar 262144 0
t0 = ulong monons
for k ulong 1000000
n = nd_outl cx vtrun b
if ge n 0
if nd_hasp view part b 0 ulong n vlcwo0
ret true
end
end
if ge sub ulong monons t0 10000000000
ret false
end
x = sleepns 20000000
end
ret false
end

note va_sec o p dt: dt nanoseconds as seconds with one decimal and "s" appended at o[p].
fn va_sec o edit uchar 1024 p ulong dt ulong to ulong
t = div add dt 50000000 100000000
q = dv_fmtu o p div t 10
q = dv_byte o q 46
q = dv_fmtu o q rem t 10
ret dv_byte o q 115
end


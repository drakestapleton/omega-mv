fn ra_joper cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
o = new uchar 1024 0
ok = nd_base cx racoper
r = nd_prep cx js tp raids2 false
if or not ok lt r 0
ra_check 35 false raprep
ret
end
fp = ra_model cx 1500
i = ra_node cx rarun fp
vp = get ndport 1
nd_args 3 500 4 1 0 0
nd_argx 1 7 0 0 0
r = nd_fresh cx js tp vp
ok = nd_status js tp racomm
p = dv_cat o 0 raT55
p = nd_dj o p js tp nd_tk js tp 0 ndkst
r = nd_sig i 9
r = nd_reap i
ok = and ok ra_jload cx
ra_jstats
ok = and ok eq get raj 2 1
p = dv_cat o p raT92
p = dv_fmtu o p get raj 2
p = ra_jop2 cx fp o p
ra_result 35 and ok eq get rav 63 1 o p
ra_close
end

note ra_jop2 cx fp o p: the DRA-290 build on the oper journal: its status and whether the journal
note stayed unchanged appended at o[p]; rav[63] 1 when it refused (non-zero, no timeout) unchanged.
fn ra_jop2 cx edit uchar 65536 fp long o edit uchar 1024 p ulong to ulong
put rav 63 0
good = ra_jsave cx
i = ra_oldnode cx raback fp
r = nd_fin i 120
same = ra_jsame cx
if and good and same and ne r 0 ne r -110
put rav 63 1
end
q = dv_cat o p raT93
q = dv_fmtl o q r
q = dv_cat o q raT94
ret ra_tf o q same
end

fn ra_journal cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap to void
fp = ra_model cx 150
i = ra_oldnode cx rarun fp
hit = ra_until cx rarun i 44 1800
r = nd_sig i 9
r = nd_reap i
rc = ra_relcmd cx ndsnap true
if ne rc 0
for k ulong 6
ra_check add k 29 false ramiss
end
else
ra_jfwd cx js tp fp hit
ra_jagain cx fp
ra_jrefuse cx fp
ra_jrollback cx js tp fp
end
ra_close
nd_clean
ra_joper cx js tp
end


fn ra_env key view uchar * o edit uchar 4096 to ulong
b = new uchar 8192 0
for i ulong ulong envcnt
r = envread i b 0 8192
if gt r long len key
if dv_at view part b 0 ulong r 0 key
if eq get b len key 61
s = add len key 1
ret dv_cat o 0 view part b s sub ulong r s
end
end
end
end
ret 0
end

fn ra_liveenv to bool
b = new uchar 4096 0
nm = new uchar 32 0
for k ulong 4
n = nd_line nm 0 raT95 k
n = ra_env view part nm 0 n b
if and eq k 1 eq n 0
n = dv_cat b 0 raT96
end
if or eq n 0 gt n 4096
ret false
end
for j ulong n
put raenv add mul k 4096 j get b j
end
put raeln k n
end
n = ra_env raT97 b
pt = ulong 18294
if gt n 0
pt = dv_atou view part b 0 n
end
if or lt pt 1 gt pt 65535
ret false
end
if or or eq pt 18091 eq pt 18300 eq pt 18174
ret false
end
put ras 4 pt
ret true
end

fn ra_serve cx edit uchar 65536 start bool to long
pk = new uchar 4096 0
b = new uchar 4096 0
p = dv_pkinit pk
p = nd_pks cx pk p 0 rarel
if start
p = dv_pkadd pk p raT96
else
p = dv_pkadd pk p raT98
end
p = nd_pks cx pk p 3 raT99
if start
p = nd_pkn pk p long get ras 4
for k ulong 4
n = get raeln k
for j ulong n
put b j get raenv add mul k 4096 j
end
p = dv_pkadd pk p view part b 0 n
end
end
ret ra_sh cx pk p
end

fn ra_mark cx edit uchar 65536 to void
b = new uchar 262144 0
n = nd_sub cx 3 5 raT100
r = dv_slurp view part cx 20480 n b
put ras 2 0
if ge r 0
put ras 2 ulong r
end
end

fn ra_mlines cx edit uchar 65536 o edit uchar 65536 to ulong
b = new uchar 262144 0
if eq get ras 1 0
ret 0
end
n = nd_sub cx 3 5 raT100
r = dv_slurp view part cx 20480 n b
if lt r 0
put raerr 0 1
ret 0
end
p = get ras 2
q = ulong 0
while lt p ulong r bound 262145
e = nd_lend view part b 0 ulong r p
if nd_pfx b p e raT101
s = dv_cat o q view part b p sub e p
s = dv_byte o s 10
if eq s dvnone
put raerr 0 1
ret q
end
q = s
end
p = add e 1
end
ret q
end

fn ra_scen cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap sc ulong to void
if not ra_prep cx js tp sc
ra_prepfail sc
ret
end
if eq sc 0
ra_full cx js tp
end
if eq sc 1
ra_life cx js tp
end
if eq sc 2
ra_rest cx js tp
end
if eq sc 3
ra_conf cx js tp
end
if eq sc 4
ra_work cx js tp
end
if eq sc 5
ra_unc cx js tp
end
if eq sc 6
ra_cancel cx js tp
end
if eq sc 7
ra_cmds cx js tp
end
if eq sc 8
ra_down cx
end
if eq sc 9
ra_auth cx
end
if eq sc 10
ra_journal cx js tp
end
if eq sc 11
ra_mem cx
end
end

fn ra_bounds sc ulong to ulong
if eq sc 0
ret 0
end
if eq sc 1
ret 7
end
if eq sc 2
ret 13
end
if eq sc 3
ret 15
end
if eq sc 4
ret 17
end
if eq sc 5
ret 19
end
if eq sc 6
ret 22
end
if eq sc 7
ret 23
end
if eq sc 8
ret 27
end
if eq sc 9
ret 28
end
if eq sc 10
ret 29
end
if eq sc 11
ret 36
end
ret 37
end

fn ra_prepfail sc ulong to void
lo = ra_bounds sc
hi = ra_bounds add sc 1
for k ulong sub hi lo
ra_check add lo k false raprep
end
end

fn ra_want sc ulong to bool
a = new uchar 128 0
b = new uchar 128 0
if eq dv_argc 7
ret true
end
n = ra_name a sc
for i ulong sub dv_argc 7
r = dv_arg add i 7 b
if ge r 0
if dv_eq view part a 0 n part b 0 ulong r
ret true
end
end
end
ret false
end

fn ra_args cx edit uchar 65536 to bool
b = new uchar 4096 0
a = new uchar 128 0
ab = new uchar 4096 0
if lt dv_argc 7
ret false
end
r = dv_arg 1 b
if lt r 0
ret false
end
live = dv_eq view part b 0 ulong r ralive
if not live
if not dv_eq view part b 0 ulong r rafake
ret false
end
end
put ras 1 0
if live
put ras 1 1
end
put ras 3 dvnone
if lt nd_abs cx 0 2 0
ret false
end
if lt nd_abs cx 1 4 0
ret false
end
if lt nd_abs cx 2 5 0
ret false
end
if lt nd_abs cx 3 6 0
ret false
end
r = dv_arg 3 b
if lt r 0
ret false
end
n = nd_absj ab view part b 0 ulong r
if gt n 4096
ret false
end
for j ulong n
put rap j get ab j
end
put ras 0 n
if not ra_argsc
ret false
end
if live
ret ra_liveenv
end
ret true
end

note ra_argsc: true when every scenario argument (7 on) names a scenario.
fn ra_argsc to bool
b = new uchar 4096 0
for i ulong sub dv_argc 7
r = dv_arg add i 7 b
if lt r 0
ret false
end
if not ra_isscen view part b 0 ulong r
ret false
end
end
ret true
end

note ra_isscen t: true when t names one of the 12 scenarios.
fn ra_isscen t view uchar * to bool
a = new uchar 128 0
for sc ulong 12
n = ra_name a sc
if dv_eq view part a 0 n t
ret true
end
end
ret false
end

fn ra_summary mode bool to int
o = new uchar 1024 0
p = dv_cat o 0 rasum
p = dv_fmtu o p dv_count 0
p = dv_cat o p rasfail
p = dv_fmtu o p dv_count 1
p = dv_cat o p rasnr
p = dv_fmtu o p dv_count 2
if mode
p = dv_cat o p ramode
if eq get ras 1 0
p = dv_cat o p ramfake
else
p = dv_cat o p ramlive
for j ulong get raeln 1
p = dv_byte o p get raenv add 4096 j
end
end
end
p = dv_byte o p 10
x = dv_out view part o 0 p
if gt dv_count 1 0
ret 1
end
if gt dv_count 2 0
ret 3
end
ret 0
end

note ra_secs sc t0: MEASURED SCENARIO-seconds, the time since t0 (monons) to 0.1 s.
fn ra_secs sc ulong t0 ulong to void
o = new uchar 1024 0
nm = new uchar 128 0
n = ra_name nm sc
n = dv_cat nm n rasecs
p = ra_decimal o 0 div add sub ulong monons t0 50000000 100000000 1
ra_measure view part nm 0 n part o 0 p
end

fn main to int
cx = new uchar 65536 0
js = new uchar ndjsz 0
tp = new uint dvtcap 0
o = new uchar 1024 0
if not ra_args cx
x = dv_err rausage
ret 2
end
x = dv_mkdirp view part cx 12288 get ndl 3
if lt x 0
x = dv_err ramiss
ret 2
end
if eq get ras 1 1
rc = ra_serve cx true
if ne rc 0
p = ra_shout cx o 0 600
dv_fail raT96 view part o 0 p
ret ra_summary false
end
end
for sc ulong 12
if ra_want sc
t0 = ulong monons
put raerr 0 0
ra_scen cx js tp sc
nd_clean
ra_secs sc t0
end
end
if eq get ras 1 1
rc = ra_serve cx false
if ne rc 0
p = ra_shout cx o 0 600
dv_fail raT98 view part o 0 p
end
end
ret ra_summary true
end


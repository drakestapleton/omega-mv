note raerr[0]: 1 once a node output this check reads was missing, unreadable or over capacity
note (ra_lines, ra_events, ra_mlines): the next check is then a FAIL naming that, and the flag clears.
global raerr ulong 1
text ralost "node output lost (missing, unreadable or over the driver's capacity); "

fn ra_name o edit uchar * sc ulong to ulong
ret nd_line o 0 ranames sc
end

fn ra_check k ulong ok bool o view uchar * to void
nm = new uchar 128 0
d = new uchar 1024 0
n = nd_line nm 0 racnames k
z = ulong 1
if and ok eq get raerr 0 0
z = 0
end
m = ulong 0
if ne get raerr 0 0
m = dv_cat d 0 ralost
put raerr 0 0
end
for i ulong len o
if ge m sub 594 n
break
end
put d m get o i
m = add m 1
end
dv_result z view part nm 0 n part d 0 m
end

fn ra_result k ulong ok bool o view uchar 1024 n ulong to void
if gt n 1024
ra_check k false ramiss
ret
end
ra_check k ok part o 0 n
end

fn ra_nr k ulong o view uchar * to void
nm = new uchar 128 0
if ne get raerr 0 0
ra_check k false o
ret
end
n = nd_line nm 0 racnames k
dv_nrun view part nm 0 n o
end

fn ra_tf o edit uchar * p ulong v bool to ulong
if v
ret dv_cat o p ratrue
end
ret dv_cat o p rafalse
end

fn ra_measure nm view uchar * o view uchar * to void
n = len o
if gt n sub 590 len nm
n = sub 590 len nm
end
x = dv_out rameas
x = dv_out nm
x = dv_out dvsp
x = dv_out part o 0 n
x = dv_out dvnl
end

fn ra_word b view uchar * s ulong k ulong to ulong
p = s
for j ulong k
while lt p len b bound 262145
c = get b p
if or eq c 10 eq c 32
break
end
p = add p 1
end
if ge p len b
ret dvnone
end
if eq get b p 10
ret dvnone
end
p = add p 1
end
ret p
end

fn ra_wend b view uchar * s ulong to ulong
if eq s dvnone
ret s
end
e = s
while lt e len b bound 262145
c = get b e
if or eq c 10 eq c 32
break
end
e = add e 1
end
ret e
end

fn ra_num b view uchar * s ulong k ulong to ulong
p = ra_word b s k
if eq p dvnone
ret dvnone
end
e = ra_wend b p
ret dv_atou part b p sub e p
end

fn ra_is b view uchar * s ulong k ulong t view uchar * to bool
p = ra_word b s k
if eq p dvnone
ret false
end
e = ra_wend b p
ret dv_eq part b p sub e p t
end

fn ra_frame b view uchar * s ulong to ulong
if or dv_at b s racwp dv_at b s racwr
ret ra_num b s 3
end
ret dvnone
end

fn ra_next b view uchar * s ulong to ulong
e = nd_lend b s
if ge e len b
ret len b
end
p = add e 1
n = ra_frame b s
if ne n dvnone
if ge n sub len b p
ret len b
end
p = add p add n 1
end
ret p
end

fn ra_load cx edit uchar 65536 tg view uchar * to bool
b = new uchar 262144 0
n = nd_outl cx tg b
put raen 0 0
if lt n 0
ret false
end
for i ulong ulong n
put raev i get b i
end
put raen 0 ulong n
ret true
end

fn ra_events o edit uchar 65536 ty view uchar * to ulong
b = new uchar 262144 0
n = get raen 0
for i ulong n
put b i get raev i
end
p = ulong 0
q = ulong 0
while lt p n bound 262145
e = nd_lend view part b 0 n p
if ge e n
break
end
if nd_pfx b p e ty
r = dv_cat o q view part b p sub e p
r = dv_byte o r 10
if eq r dvnone
put raerr 0 1
ret q
end
q = r
end
p = ra_next view part b 0 n p
end
ret q
end

fn ra_lines cx edit uchar 65536 tg view uchar * o edit uchar 65536 to ulong
ok = ra_load cx tg
if not ok
put raerr 0 1
ret 0
end
ret ra_events o racwo
end

fn ra_nlines b view uchar * to ulong
n = ulong 0
for i ulong len b
if eq get b i 10
n = add n 1
end
end
ret n
end

fn ra_list o edit uchar 1024 p ulong b view uchar * to ulong
ret nd_pfxl o p b raempty
end

fn ra_hit md ulong to bool
b = new uchar 65536 0
n = ra_events b racwe
if eq md 0
n = ra_events b racwo
ret nd_hasp view part b 0 n raT1
end
p = ulong 0
while lt p n bound 65537
if eq ra_num view part b 0 n p 1 0
v = ra_num view part b 0 n p 2
w = ra_num view part b 0 n p 3
if eq rem v 10 div md 10
if eq w rem md 10
ret true
end
end
end
p = add nd_lend view part b 0 n p 1
end
ret false
end

fn ra_until cx edit uchar 65536 tg view uchar * i ulong md ulong sec ulong to bool
t = ulong monons
while true bound 9223372036854775807
ok = ra_load cx tg
if ok
if ra_hit md
ret true
end
end
if ne nd_poll i -1
ret false
end
if ge sub ulong monons t mul sec 1000000000
ret false
end
x = sleepns 10000000
end
ret false
end

fn ra_jload cx edit uchar 65536 to bool
b = new uchar 262144 0
n = nd_sub cx 4 5 ndjfile
r = dv_slurp view part cx 20480 n b
put rajn 0 0
for k ulong 16
put raj k 0
end
if lt r 64
ret false
end
if ne rem sub ulong r 64 128 0
ret false
end
for i ulong ulong r
put rajb i get b i
end
put rajn 0 ulong r
put raj 0 div sub ulong r 64 128
ret true
end

fn ra_rw r ulong w ulong to ulong
p = add add 64 mul r 128 mul w 8
v = ulong 0
if gt add p 8 get rajn 0
ret dvnone
end
for i ulong 8
v = or v shl ulong get rajb add p i mul i 8
end
ret v
end

fn ra_keyeq a ulong b ulong to bool
for w ulong 4
if ne ra_rw a add w 3 ra_rw b add w 3
ret false
end
end
ret true
end

fn ra_kn r ulong ty ulong to ulong
v = ulong 0
for j ulong get raj 0
if eq ra_rw j 0 ty
if ra_keyeq r j
v = add v 1
end
end
end
ret v
end

fn ra_first r ulong ty ulong to bool
for j ulong r
if eq ra_rw j 0 ty
if ra_keyeq r j
ret false
end
end
end
ret true
end

fn ra_jstats to void
for k ulong 5
put raj add k 1 0
end
for i ulong get raj 0
ty = ra_rw i 0
if eq ty 1
put raj 1 add get raj 1 1
end
if eq ty 9
put raj 2 add get raj 2 1
end
if eq ty 10
put raj 5 add get raj 5 1
end
if eq ty 3
if ra_first i 3
put raj 4 add get raj 4 1
n = ra_kn i 3
if gt n get raj 3
put raj 3 n
end
end
end
end
end

fn ra_jdetail o edit uchar 1024 p ulong to ulong
q = dv_cat o p raopens
q = dv_fmtu o q get raj 1
q = dv_cat o q ramax
ret dv_fmtu o q get raj 3
end

fn ra_tail o edit uchar 1024 p ulong m ulong to ulong
q = dv_cat o p ralbr
n = get raj 0
if gt m n
put rav 63 0
ret dv_cat o q raT2
end
for i ulong sub n m
if gt i 0
q = dv_cat o q racom
end
v = ra_rw add i m 0
q = dv_fmtu o q v
end
ret dv_cat o q rarbr
end

fn ra_tailok m ulong strict bool to bool
n = get raj 0
if gt m n
ret false
end
for i ulong sub n m
t = ra_rw add i m 0
if strict
if and ne t 1 ne t 5
ret false
end
else
if or eq t 2 eq t 3
ret false
end
end
end
ret true
end

fn ra_dpair r ulong k ulong to ulong
n = ulong 0
for j ulong get raj 0
if eq ra_rw j 0 4
if ra_keyeq r j
if eq n k
ret add mul ra_rw j 7 65536 ra_rw j 9
end
n = add n 1
end
end
end
ret dvnone
end

fn ra_tuple o edit uchar 1024 p ulong r ulong to ulong
q = dv_byte o p 40
for w ulong 4
if gt w 0
q = dv_cat o q racom
end
q = dv_fmtu o q ra_rw r add w 3
end
ret dv_byte o q 41
end

fn ra_done o edit uchar 1024 p ulong r ulong to ulong
q = dv_cat o p ralbr
n = ra_kn r 4
for k ulong n
if gt k 0
q = dv_cat o q racom
end
v = ra_dpair r k
q = dv_byte o q 40
q = dv_fmtu o q div v 65536
q = dv_cat o q racom
q = dv_fmtu o q rem v 65536
q = dv_byte o q 41
end
ret dv_cat o q rarbr
end

fn ra_model cx edit uchar 65536 dl ulong to long
if eq get ras 1 1
ra_mark cx
ret long get ras 4
end
i = nd_fake cx dl
put ras 3 i
ret get ndport 0
end

fn ra_close to void
i = get ras 3
if ne i dvnone
r = nd_sig i 9
r = nd_reap i
end
put ras 3 dvnone
end

fn ra_node cx edit uchar 65536 tg view uchar * fp long to ulong
x = nd_set cx 6 racode
ret nd_node cx tg fp
end

fn ra_prep cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap sc ulong to bool
nm = new uchar 128 0
ids = new uchar 128 0
n = ra_name nm sc
if eq sc 10
n = dv_cat nm 0 racompat
end
ok = nd_base cx view part nm 0 n
m = dv_cat ids 0 raids1
if or or eq sc 1 eq sc 6 eq sc 7
m = dv_cat ids 0 raids2
end
if eq sc 5
m = dv_cat ids 0 raids3
end
if eq sc 0
m = dv_cat ids 0 raids4
end
c = neg long 22
if ok
c = nd_prep cx js tp view part ids 0 m false
end
ret ge c 0
end

fn ra_cmpframe js view uchar ndjsz tp view uint dvtcap b view uchar 262144 s ulong tu ulong raw bool to bool
ob = new uchar 65536 0
k = ulong get rav 20
if raw
k = ulong get rav 21
end
k = dv_jidx tp tu k
if raw
k = dv_jkey js tp k ndkraw
else
k = dv_jkey js tp k ndkprom
end
n = dv_jstr js tp k ob
if lt n 0
ret false
end
e = add nd_lend b s 1
m = ra_frame b s
if gt e len b
ret false
end
if gt m sub len b e
ret false
end
ret ra_cmpbytes b e m ob ulong n
end

fn ra_cmpbytes b view uchar 262144 e ulong m ulong ob view uchar 65536 n ulong to bool
ret dv_eq part b e m part ob 0 n
end

note ra_frd raw m: rav[22] = the first raw turn index (< m recorded) whose text differs.
fn ra_frd raw bool m ulong to void
if and raw and lt get rav 22 0 lt ulong get rav 21 m
put rav 22 get rav 21
end
end

fn ra_cmpone js view uchar ndjsz tp view uint dvtcap b view uchar 262144 i ulong tu ulong to bool
put rav 20 0
put rav 21 0
put rav 22 -1
ok = true
p = ulong 0
n = get raen 0
m = dv_jlen tp tu
while lt p n bound 262145
if ne ra_frame view part b 0 n p dvnone
if eq ra_num view part b 0 n p 1 i
raw = dv_at b p racwr
if not ra_cmpframe js tp b p tu raw
ok = false
ra_frd raw m
end
k = ulong 20
if raw
k = 21
end
put rav k add get rav k 1
end
end
p = ra_next view part b 0 n p
end
note m (the recorded turn count) was read before the loop.
if ne ulong get rav 20 m
ret false
end
if ne ulong get rav 21 m
ret false
end
ret ok
end

note ra_compare cx js tp tg o: the prompts and raw model texts in node output tg against the
note recorded turns; o[0, rav[23]) gets one line "objI turns=P/R first_raw_diff=K|None" per
note objective that differs (python compare()'s list).
fn ra_compare cx edit uchar 65536 js edit uchar ndjsz tp edit uint dvtcap tg view uchar * o edit uchar 4096 to bool
b = new uchar 262144 0
put rav 23 0
ok = ra_load cx tg
if not ok
ret false
end
for i ulong get raen 0
put b i get raev i
end
n = nd_sub cx 4 5 ndexp
r = dv_jload view part cx 20480 n js tp
if lt r 0
ret false
end
ret ra_cmpall js tp b o
end

fn ra_cmpbad o edit uchar 4096 i ulong m ulong to void
p = ulong get rav 23
p = dv_cat o p raT3
p = dv_fmtu o p i
p = dv_cat o p raT105
p = dv_fmtl o p get rav 20
p = dv_byte o p 47
p = dv_fmtu o p m
p = dv_cat o p raT106
if lt get rav 22 0
p = dv_cat o p ndnone
else
p = dv_fmtl o p get rav 22
end
p = dv_cat o p dvnl
put rav 23 long p
end

note ra_cmpchk k ok o d: check k; d when the turns are equal, else the ra_compare list in o
note (ramiss when the output or expect.json could not be read).
fn ra_cmpchk k ulong ok bool o view uchar 4096 d view uchar * to void
l = new uchar 1024 0
if ok
ra_check k true d
ret
end
if eq get rav 23 0
ra_check k false ramiss
ret
end
p = ra_list l 0 view part o 0 ulong get rav 23
ra_result k false l p
end

fn ra_cmpall js view uchar ndjsz tp view uint dvtcap b view uchar 262144 o edit uchar 4096 to bool
ok = true
rs = dv_jkey js tp 0 rarecsk
if ne js_type tp rs jsarr
ret false
end
for i ulong dv_jlen tp rs
t = dv_jidx tp rs i
tu = dv_jkey js tp t ndkturn
if not ra_cmpone js tp b i tu
ok = false
if lt ulong get rav 23 700
ra_cmpbad o i dv_jlen tp tu
end
end
end
ret ok
end

fn ra_mseq a view uchar * b view uchar * to bool
ln = new uchar 4096 0
if ne ra_nlines a ra_nlines b
ret false
end
p = ulong 0
while lt p len a bound 65537
e = nd_lend a p
n = dv_cat ln 0 part a p sub e p
ca = ra_count a view part ln 0 n
cb = ra_count b view part ln 0 n
if ne ca cb
ret false
end
p = add e 1
end
ret true
end

fn ra_count b view uchar * t view uchar * to ulong
q = ulong 0
c = ulong 0
while lt q len b bound 65537
z = nd_lend b q
if dv_eq part b q sub z q t
c = add c 1
end
q = add z 1
end
ret c
end

fn ra_lastprompt cx edit uchar 65536 tg view uchar * obj ulong o edit uchar 65536 to ulong
b = new uchar 262144 0
r = nd_outl cx tg b
if lt r 0
ret 0
end
p = ulong 0
q = ulong 0
while lt p ulong r bound 262145
if dv_at b p racwp
if eq ra_num view part b 0 ulong r p 1 obj
n = ra_frame view part b 0 ulong r p
e = add nd_lend b p 1
if le n sub ulong r e
q = dv_cat o 0 view part b e n
end
end
end
p = ra_next view part b 0 ulong r p
end
ret q
end

fn ra_recorded js view uchar ndjsz tp view uint dvtcap pr view uchar * to bool
rs = dv_jkey js tp 0 rarecsk
for i ulong dv_jlen tp rs
r = dv_jidx tp rs i
ts = dv_jkey js tp r ndkturn
if ra_recturn js tp pr ts
ret true
end
end
ret false
end

fn ra_recturn js view uchar ndjsz tp view uint dvtcap pr view uchar * ts ulong to bool
b = new uchar 65536 0
for j ulong dv_jlen tp ts
t = dv_jidx tp ts j
t = dv_jkey js tp t ndkprom
n = dv_jstr js tp t b
if ge n 0

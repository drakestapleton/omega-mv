text ndinval "invalid"
text nddup "duplicate"
note expect.json framing (json.dump indent=1) and the map answer around the raw text.
text ndx1 "{\n \"objs\": [\n  "
text ndx2 ",\n  "
text ndx3 "\n ],\n \"recs\": [\n  {\n   \"path\": "
text ndx4 "\n  },\n  {\n   \"path\": "
text ndx5 ",\n   \"obj\": "
text ndx6 ",\n   \"turns\": ["
text ndx7 "\n    {\n     \"state\": "
text ndx8 ",\n     \"prompt\": "
text ndx9 ",\n     \"raw\": "
text ndx10 "\n    }"
text ndx11 ","
text ndx12 "\n   ]"
text ndx13 "]"
text ndx14 ",\n   \"pass_\": "
text ndx15 ",\n   \"state\": "
text ndx16 "\n  }\n ]\n}"
text ndtrue "true"
text ndfalse "false"
text ndmv1 "{\"object\": \"text_completion\", \"choices\": [{\"index\": 0, \"text\": "
text ndmv2 ", \"finish_reason\": \"stop\"}], \"usage\": {\"prompt_tokens\": 1, \"completion_tokens\": 1}}"
note ndsty1, ndsty2: repair.py STYLES 0..25 and 26..50, one per line (as tool-replay.om).
text ndsty1 "Repair this Omega file and verify it.\nUse tools to fix this Omega program, then test it.\nCheck this Omega file, correct any fault and confirm the result.\nPlease get this Omega file working according to its goal and check your work.\nInvestigate this Omega file and make its behavior match the goal.\nDiagnose this Omega file, repair it as needed, and verify the result.\nRepair the calculation in this Omega file and verify the result.\nFind and repair the mistake in this Omega file, then confirm its behavior.\nMake this Omega file satisfy its stated goal and verify the repaired result.\nFix this Omega file.\nCheck and repair the Omega program.\nMake the program match its goal and test it.\nUse tools to repair the file and check it.\nFind the wrong calculation, fix it, and test it.\nInspect this program and fix the error.\nRead the file, check it, repair it, and test again.\nPlease correct the Omega calculation and verify it.\nRepair this file to meet the stated goal.\nWork through this Omega repair and check the result.\nCheck this Omega file, find the error, repair it and verify the result.\nPlease inspect this Omega program to repair the calculation and verify the result.\nUse the goal to fix this Omega file and verify the changes.\nPlease repair this Omega program to do what the goal asks.\nGet this Omega file to match the goal, then check the result.\nPlease carefully repair the calculation using tools and confirm that the tests pass.\nPlease carefully examine this Omega file and repair any calculation that does not match its goal.\n"
text ndsty2 "Find the incorrect behavior in this Omega file, fix it, and test the result.\nInspect and repair this Omega file, then verify it.\nCorrect this Omega program according to its goal.\nFix the error in this Omega program and check the result.\nCheck this file and repair it to meet its goal.\nPlease fix this program to match its goal.\nCorrect the calculation in this Omega file.\nRead this program and repair its calculation.\nPlease check the code and fix the mistake.\nRepair the program according to the stated goal.\nUse the goal to correct this Omega calculation.\nFix the calculation and test the corrected program.\nPlease inspect the file and correct the error.\nCheck the calculation, make the repair, and verify it.\nMake this file behave as the goal describes.\nPlease correct this program and check your work.\nRepair this calculation, then confirm the result.\nRepair this file and confirm it meets the goal.\nCheck the Omega program and correct its calculation.\nInspect this file, fix its calculation, and verify it.\nMake this Omega program meet the goal, then test it.\nRepair the file and verify its goal.\nCheck the code, repair its fault, and test it.\nFix the error in this file and confirm its goal.\nInspect the code and repair it to satisfy the goal.\n"

note ======== paths

note nd_sub cx s q t: path slot s joined with t (os.path.join) into slot q; its length or dvnone.
fn nd_sub cx edit uchar 65536 s ulong q ulong t view uchar * to ulong
a = new uchar 4096 0
n = dv_cat a 0 view part cx mul s 4096 get ndl s
if eq n dvnone
ret dvnone
end
r = dv_join part cx mul q 4096 4096 view part a 0 n t
if ne r dvnone
put ndl q r
end
ret r
end

note nd_absj o a: a joined to the working directory (os.path.join: a itself when absolute) into
note o; the length, or dvnone when the directory is unknown or o is too short.
fn nd_absj o edit uchar 4096 a view uchar * to ulong
w = new uchar 4096 0
m = cwd w 0 4096
if lt m 2
ret dvnone
end
ret dv_join o view part w 0 sub ulong m 1 a
end

note nd_abs cx s i: command-line argument i made absolute (joined to the working directory when
note relative; not normalised) into slot s: 0, or -22 empty, -105 too long or no directory.
fn nd_abs cx edit uchar 65536 s ulong i ulong to long
a = new uchar 4096 0
b = new uchar 4096 0
n = dv_arg i a
if lt n 1
if eq n 0
ret neg long 22
end
ret n
end
r = nd_absj b view part a 0 ulong n
if eq r dvnone
ret neg long 105
end
x = nd_set cx s view part b 0 r
ret 0
end

note nd_base cx t: BASE (slot 4) = OUTDIR/t, and the op capture file (slot 7) = OUTDIR/.op.out;
note true when both fit.
fn nd_base cx edit uchar 65536 t view uchar * to bool
if eq nd_sub cx 3 4 t dvnone
ret false
end
ret ne nd_sub cx 3 7 ndopout dvnone
end

note ======== numbers and lines

note nd_w64 b o: the little-endian 64-bit word at b[o].
fn nd_w64 b view uchar * o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note nd_lend b s: the end of the line that starts at b[s] (its newline's index, or len b).
fn nd_lend b view uchar * s ulong to ulong
i = s
while lt i len b bound 16777217
if eq get b i 10
ret i
end
i = add i 1
end
ret len b
end

note nd_pfx b s e t: true when b[s..e) starts with t.
fn nd_pfx b view uchar * s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
ret dv_eq view part b s len t t
end

note nd_hasl b t: true when some line of b is exactly t.
fn nd_hasl b view uchar * t view uchar * to bool
s = ulong 0
while lt s len b bound 16777217
e = nd_lend b s
if eq sub e s len t
if dv_eq view part b s len t t
ret true
end
end
s = add e 1
end
ret false
end

note nd_hasp b t: true when some line of b starts with t.
fn nd_hasp b view uchar * t view uchar * to bool
s = ulong 0
while lt s len b bound 16777217
e = nd_lend b s
if nd_pfx b s e t
ret true
end
s = add e 1
end
ret false
end

note nd_lastl o p b: the last line of b (Python splitlines()[-1]; empty when b is) appended at o[p].
fn nd_lastl o edit uchar * p ulong b view uchar * to ulong
n = len b
if gt n 0
if eq get b sub n 1 10
n = sub n 1
end
end
s = n
while gt s 0 bound 16777217
if eq get b sub s 1 10
break
end
s = sub s 1
end
ret dv_cat o p part b s sub n s
end

note nd_pfxl o p b t: the Python repr of the list of lines of b starting with t (['l1', 'l2'])
note appended at o[p] (o is a 1024-byte detail buffer); lines are taken verbatim between quotes.
fn nd_pfxl o edit uchar 1024 p ulong b view uchar * t view uchar * to ulong
q = dv_byte o p 91
c = ulong 0
s = ulong 0
while lt s len b bound 16777217
e = nd_lend b s
if nd_pfx b s e t
if gt c 0
q = dv_byte o q 44
q = dv_byte o q 32
end
q = dv_byte o q 39
q = dv_cat o q part b s sub e s
q = dv_byte o q 39
c = add c 1
end
s = add e 1
end
ret dv_byte o q 93
end

note nd_line o p t k: line k of the newline-terminated lines t appended at o[p]; the end or dvnone.
fn nd_line o edit uchar * p ulong t view uchar * k ulong to ulong
i = ulong 0
c = ulong 0
s = ulong 0
while lt i len t bound 4096
if eq get t i 10
if eq c k
ret dv_cat o p part t s sub i s
end
c = add c 1
s = add i 1
end
i = add i 1
end
ret dvnone
end

note nd_style o p s: repair.py STYLES[s] appended at o[p]; dvnone for s outside 0..50.
fn nd_style o edit uchar * p ulong s long to ulong
if or lt s 0 gt s 50
ret dvnone
end
if lt s 26
ret nd_line o p ndsty1 ulong s
end
ret nd_line o p ndsty2 sub ulong s 26
end

note ======== the buffered writer and the JSON string encoder (Python json.dumps, ensure_ascii)

note nd_wopen pa: open pa (created or truncated) for the writer: 0 or the negative fopen error.
fn nd_wopen pa view uchar * to long
fd = fopen pa 0 len pa 557633 420
if lt fd 0
ret fd
end
put ndw 0 0
put ndw 1 add ulong fd 1
put ndw 2 0
put ndw 3 0
put ndwe 0 0
ret 0
end

note nd_wflush ob: write out the bytes buffered in ob.
fn nd_wflush ob edit uchar * to void
n = get ndw 0
if eq n 0
ret
end
f = get ndw 1
if gt f 0
r = dv_wall int sub f 1 view part ob 0 n
if lt r 0
if eq get ndwe 0 0
put ndwe 0 r
end
end
end
put ndw 0 0
end

note nd_wclose ob: flush and close the writer: 0 or the first write error.
fn nd_wclose ob edit uchar * to long
nd_wflush ob
f = get ndw 1
if gt f 0
x = fclose int sub f 1
end
put ndw 1 0
ret get ndwe 0
end

note nd_wb ob c: byte c through the writer buffer ob (or counted, in counting mode).
fn nd_wb ob edit uchar * c uchar to void
if eq get ndw 2 1
put ndw 3 add get ndw 3 1
ret
end
if ge get ndw 0 len ob
nd_wflush ob
end
put ob get ndw 0 c
put ndw 0 add get ndw 0 1
end

note nd_wt ob t: the bytes of t through the writer.
fn nd_wt ob edit uchar * t view uchar * to void
for i ulong len t
nd_wb ob get t i
end
end

note nd_wu ob v: v in decimal through the writer.
fn nd_wu ob edit uchar * v ulong to void
d = new uchar 24 0
n = dv_fmtu d 0 v
nd_wt ob view part d 0 n
end

note nd_whex ob v: \u and v as four lowercase hex digits through the writer.
fn nd_whex ob edit uchar * v ulong to void
nd_wb ob 92
nd_wb ob 117
for i ulong 4
d = and shr v mul sub 3 i 4 15
if lt d 10
nd_wb ob uchar add d 48
else
nd_wb ob uchar add d 87
end
end
end

note nd_wch ob c: code point c JSON-escaped as Python's ensure_ascii encoder does.
fn nd_wch ob edit uchar * c ulong to void
e = ulong 0
if eq c 34
e = 34
end
if eq c 92
e = 92
end
if eq c 10
e = 110
end
if eq c 13
e = 114
end
if eq c 9
e = 116
end
if eq c 8
e = 98
end
if eq c 12
e = 102
end
if ne e 0
nd_wb ob 92
nd_wb ob uchar e
ret
end
if and ge c 32 le c 126
nd_wb ob uchar c
ret
end
if lt c 65536
nd_whex ob c
ret
end
v = sub c 65536
nd_whex ob add 55296 shr v 10
nd_whex ob add 56320 and v 1023
end

note nd_u8 s i: the UTF-8 sequence at s[i]: its code point, or'd with its byte length << 32
note (a stray or cut byte decodes as itself, or as U+FFFD at the end, with length 1).
fn nd_u8 s view uchar * i ulong to ulong
b = ulong get s i
k = ulong 1
c = b
if ge b 240
k = 4
c = and b 7
else
if ge b 224
k = 3
c = and b 15
else
if ge b 192
k = 2
c = and b 31
end
end
end
if gt add i k len s
ret or 65533 shl ulong 1 32
end
j = ulong 1
while lt j k bound 4
c = or shl c 6 and ulong get s add i j 63
j = add j 1
end
ret or c shl k 32
end

note nd_wesc ob s: the UTF-8 bytes s as a JSON string (quotes included) through the writer.
fn nd_wesc ob edit uchar * s view uchar * to void
nd_wb ob 34
i = ulong 0
while lt i len s bound 16777217
r = nd_u8 s i
nd_wch ob and r 2097151
i = add i shr r 32
end
nd_wb ob 34
end

note nd_wtk ob js tp t: JSON string token t re-encoded through the writer: 0, or the negative
note dv_jstr error (not a string, or longer than 65536 bytes decoded).
fn nd_wtk ob edit uchar * js view uchar * tp view uint dvtcap t ulong to long
d = new uchar 65536 0
n = dv_jstr js tp t d
if lt n 0
ret n
end
nd_wesc ob view part d 0 ulong n
ret 0
end

note nd_elen ob js tp t: the byte length nd_wtk would write for t, or its negative error.
fn nd_elen ob edit uchar * js view uchar * tp view uint dvtcap t ulong to long
put ndw 2 1
put ndw 3 0
r = nd_wtk ob js tp t
put ndw 2 0
if lt r 0
ret r
end
ret long get ndw 3
end

note ======== the DRA-291 fixture (view-prep)

note nd_jint js tp t key: integer member key of object token t; ndbad set and 0 when it is no
note integer.
fn nd_jint js view uchar * tp view uint dvtcap t ulong key view uchar * to long
v = dv_jkey js tp t key
if not dv_jisl js tp v
put ndbad 0 1
ret 0
end
ret dv_jnum js tp v
end

note nd_find js tp w: the first run of the fixture array whose job.path contains w, or jsnone.
fn nd_find js view uchar * tp view uint dvtcap w view uchar * to ulong
d = new uchar 4096 0
r = js_first tp 0
while ne r jsnone bound 16777217
j = dv_jkey js tp r ndkjob
n = dv_jstr js tp dv_jkey js tp j ndkpath d
if ge n 0
if ne dv_find view part d 0 ulong n w 0 dvnone
ret r
end
end
r = js_enext tp r
end
ret jsnone
end

note nd_rpath cx js tp j: BASE/root/ followed by job j's path into slot 5; its length or dvnone.
fn nd_rpath cx edit uchar 65536 js view uchar * tp view uint dvtcap j ulong to ulong
a = new uchar 4096 0
d = new uchar 4096 0
n = dv_jstr js tp dv_jkey js tp j ndkpath d
if lt n 0
ret dvnone
end
p = dv_cat a 0 view part cx 16384 get ndl 4
p = dv_cat a p ndrsl
p = dv_cat a p view part d 0 ulong n
if eq p dvnone
ret dvnone
end
ret nd_set cx 5 view part a 0 p
end

note nd_brok cx js tp j: write job j's broken text to BASE/root/PATH unless its fault is
note "missing": 0 or a negative error.
fn nd_brok cx edit uchar 65536 js view uchar * tp view uint dvtcap j ulong to long
b = new uchar 65536 0
if dv_jsteq js tp dv_jkey js tp j ndkflt ndmiss
ret 0
end
n = dv_jstr js tp dv_jkey js tp j ndkbrok b
if lt n 0
ret n
end
q = nd_rpath cx js tp j
if eq q dvnone
ret neg long 36
end
ret dv_spit view part cx 20480 q view part b 0 ulong n
end

note nd_objv js tp j i: job j's kind code, k, n (0 when absent) and a stored as objective i in
note ndob: 0, or -22 for a field that is no integer.
fn nd_objv js view uchar * tp view uint dvtcap j ulong i ulong to long
put ndbad 0 0
o = mul i 4
c = long 0
kd = dv_jkey js tp j ndkkind
if dv_jsteq js tp kd ndadd
c = 1
end
if dv_jsteq js tp kd ndmul
c = 2
end
if dv_jsteq js tp kd ndloop
c = 3
end
put ndob o c
put ndob add o 1 nd_jint js tp j ndkk
n = long 0
if ne dv_jkey js tp j ndkn jsnone
n = nd_jint js tp j ndkn
end
put ndob add o 2 n
put ndob add o 3 nd_jint js tp j ndka
if eq get ndbad 0 1
ret neg long 22
end
ret 0
end

note nd_obj o js tp j i: "kind,k,n," of job j (objective i in ndob) written at o[0]; the end or dvnone.
fn nd_obj o edit uchar 4096 js view uchar * tp view uint dvtcap j ulong i ulong to ulong
kd = new uchar 64 0
o4 = mul i 4
n = dv_jstr js tp dv_jkey js tp j ndkkind kd
if lt n 0
ret dvnone
end
q = dv_cat o 0 view part kd 0 ulong n
q = dv_byte o q 44
q = dv_fmtl o q get ndob add o4 1
q = dv_byte o q 44
q = dv_fmtl o q get ndob add o4 2
ret dv_byte o q 44
end

note nd_objt o js tp j i a: objective i's line "kind,k,n,a,path,STYLE\n" (job j, argument a)
note written at o[0]; its length, or dvnone.
fn nd_objt o edit uchar 4096 js view uchar jsmaxn tp view uint dvtcap j ulong i ulong a long to ulong
d = new uchar 4096 0
p = nd_obj o js tp j i
p = dv_fmtl o p a
p = dv_byte o p 44
n = dv_jstr js tp dv_jkey js tp j ndkpath d
if lt n 0
ret dvnone
end
p = dv_cat o p view part d 0 ulong n
p = dv_byte o p 44
p = nd_style o p nd_jint js tp j ndkstyl
ret dv_byte o p 10
end

note nd_addl cx o n: the line o[0..n) appended to the prepared objectives in cx: 0, or -7 when
note they would pass 32768 bytes.
fn nd_addl cx edit uchar 65536 o view uchar 4096 n ulong to long
e = get ndl 8
if gt n sub 32768 e
ret neg long 7
end
for i ulong n
put cx add add 32768 e i get o i
end
put ndl 8 add e n
put ndl 9 add get ndl 9 1
ret 0
end

note nd_objl cx js tp j i wrong: objective i's line (nd_objt; a = k+n+a+1 for the first objective
note when wrong) appended to the objectives in cx: 0 or a negative error.
fn nd_objl cx edit uchar 65536 js view uchar jsmaxn tp view uint dvtcap j ulong i ulong wrong bool to long
o = new uchar 4096 0
o4 = mul i 4
a = get ndob add o4 3
if wrong
if eq i 0
k = get ndob add o4 1
k = add k get ndob add o4 2
a = add add k a 1
end
end
p = nd_objt o js tp j i a
if eq p dvnone
ret neg long 22
end
ret nd_addl cx o p
end

note nd_prep1 cx js tp w wrong: prepare the first run whose path contains w: 0 or negative.
fn nd_prep1 cx edit uchar 65536 js view uchar jsmaxn tp view uint dvtcap w view uchar * wrong bool to long
r = nd_find js tp w
if eq r jsnone
ret neg long 2
end
i = get ndrn 0
if ge i 128
ret neg long 7
end
put ndrun i r
put ndrn 0 add i 1
j = dv_jkey js tp r ndkjob
x = nd_brok cx js tp j
if lt x 0
ret x
end
x = nd_objv js tp j i
if lt x 0
ret x
end
ret nd_objl cx js tp j i wrong
end

note nd_tree cx: BASE removed and recreated with root/jobs and work: 0 or a negative error.
fn nd_tree cx edit uchar 65536 to long
r = dv_rmrf view part cx 16384 get ndl 4
q = nd_sub cx 4 5 ndrjobs
if eq q dvnone
ret neg long 36
end
r = dv_mkdirp view part cx 20480 q
if lt r 0
ret r
end
q = nd_sub cx 4 5 ndwork
if eq q dvnone
ret neg long 36
end
ret dv_mkdirp view part cx 20480 q
end

note nd_wturn ob js tp u: turn object u written as an expect.json turn: 0 or negative.
fn nd_wturn ob edit uchar * js view uchar * tp view uint dvtcap u ulong to long
nd_wt ob ndx7
r = nd_wtk ob js tp dv_jkey js tp u ndkstat
nd_wt ob ndx8
x = nd_wtk ob js tp dv_jkey js tp u ndkprom
r = or r x
nd_wt ob ndx9
x = nd_wtk ob js tp dv_jkey js tp u ndkraw
r = or r x
nd_wt ob ndx10
if ne r 0
ret neg long 22
end
ret 0
end

note nd_wobj ob js tp i: prepared run i's "kind,k,n,a" (its original a) written as a JSON string.
fn nd_wobj ob edit uchar * js view uchar * tp view uint dvtcap i ulong to long
o = new uchar 4096 0
j = dv_jkey js tp get ndrun i ndkjob
p = nd_obj o js tp j i
p = dv_fmtl o p get ndob add mul i 4 3
if eq p dvnone
ret neg long 22
end
nd_wesc ob view part o 0 p
ret 0
end

note nd_wtrns ob js tp ts: the turns array ts written as expect.json turns ([] when empty).
fn nd_wtrns ob edit uchar * js view uchar * tp view uint dvtcap ts ulong to long
if ne js_type tp ts jsarr
ret neg long 22
end
e = long 0
u = js_first tp ts
c = ulong 0
while ne u jsnone bound 16777217
if gt c 0
nd_wt ob ndx11
end
x = nd_wturn ob js tp u
e = or e x
c = add c 1
u = js_enext tp u
end
if gt c 0
nd_wt ob ndx12
else
nd_wt ob ndx13
end
ret e
end

note nd_wrec ob js tp i: prepared run i written as an expect.json rec: 0 or negative.
fn nd_wrec ob edit uchar * js view uchar * tp view uint dvtcap i ulong to long
r = get ndrun i
j = dv_jkey js tp r ndkjob
e = nd_wtk ob js tp dv_jkey js tp j ndkpath
nd_wt ob ndx5
x = nd_wobj ob js tp i
e = or e x
nd_wt ob ndx6
x = nd_wtrns ob js tp dv_jkey js tp r ndkturn
e = or e x
nd_wt ob ndx14
u = dv_jkey js tp r ndkpass
if eq js_type tp u jstrue
nd_wt ob ndtrue
else
if eq js_type tp u jsfalse
nd_wt ob ndfalse
else
e = neg long 22
end
end
nd_wt ob ndx15
x = nd_wtk ob js tp dv_jkey js tp r ndkstat
e = or e x
if ne e 0
ret neg long 22
end
ret 0
end

note nd_wobjs ob b: each line of b (the prepared objectives) written as a JSON string, ", "-joined.
fn nd_wobjs ob edit uchar * b view uchar * to void
s = ulong 0
c = ulong 0
while lt s len b bound 16777217
t = nd_lend b s
if gt c 0
nd_wt ob ndx2
end
nd_wesc ob view part b s sub t s
c = add c 1
s = add t 1
end
end

note nd_wexp cx js tp: BASE/expect.json, byte for byte what view-prep.py's json.dump(indent=1)
note wrote: 0 or a negative error.
fn nd_wexp cx edit uchar 65536 js view uchar * tp view uint dvtcap to long
ob = new uchar 65536 0
q = nd_sub cx 4 5 ndexp
if eq q dvnone
ret neg long 36
end
e = nd_wopen view part cx 20480 q
if lt e 0
ret e
end
nd_wt ob ndx1
nd_wobjs ob view part cx 32768 get ndl 8
for i ulong get ndrn 0
if eq i 0
nd_wt ob ndx3
else
nd_wt ob ndx4
end
x = nd_wrec ob js tp i
if lt x 0
e = x
end
end
nd_wt ob ndx16
x = nd_wclose ob
if lt x 0
ret x
end
ret e
end

note nd_wpair ob js tp u: turn u as a map record "KLEN VLEN\n" KEY VALUE: 0 or negative.
fn nd_wpair ob edit uchar * js view uchar * tp view uint dvtcap u ulong to long
p = dv_jkey js tp u ndkprom
w = dv_jkey js tp u ndkraw
kl = nd_elen ob js tp p
vl = nd_elen ob js tp w
if or lt kl 0 lt vl 0
ret neg long 22
end
nd_wu ob ulong kl
nd_wb ob 32
nd_wu ob add add ulong vl len ndmv1 len ndmv2
nd_wb ob 10
x = nd_wtk ob js tp p
nd_wt ob ndmv1
x = nd_wtk ob js tp w
nd_wt ob ndmv2
ret 0
end

note nd_wmap cx js tp: BASE/map, the fake-serve map of every prepared turn (prompt to raw),
note byte for byte what view-prep.py wrote: 0 or a negative error.
fn nd_wmap cx edit uchar 65536 js view uchar * tp view uint dvtcap to long
ob = new uchar 65536 0
q = nd_sub cx 4 5 ndmap
if eq q dvnone
ret neg long 36
end
e = nd_wopen view part cx 20480 q
if lt e 0
ret e
end
for i ulong get ndrn 0
u = js_first tp dv_jkey js tp get ndrun i ndkturn
while ne u jsnone bound 16777217
x = nd_wpair ob js tp u
if lt x 0
e = x
end
u = js_enext tp u
end
end
x = nd_wclose ob
if lt x 0
ret x
end
ret e
end

note nd_prepl cx js tp ids wrong: nd_prep1 for each comma-separated id of ids: 0 or negative.
fn nd_prepl cx edit uchar 65536 js view uchar jsmaxn tp view uint dvtcap ids view uchar * wrong bool to long
s = ulong 0
i = ulong 0
while le i len ids bound 16777217
c = true
if lt i len ids
c = eq get ids i 44
end
if c
r = nd_prep1 cx js tp view part ids s sub i s wrong
if lt r 0
ret r
end
s = add i 1
end
i = add i 1
end
ret 0
end

note nd_wobjf cx: the prepared objective lines written to BASE/objs.txt: 0 or negative.
fn nd_wobjf cx edit uchar 65536 to long
b = new uchar 32768 0
m = get ndl 8
for i ulong m
put b i get cx add 32768 i
end
n = nd_sub cx 4 5 ndobjs
if eq n dvnone
ret neg long 36
end
ret dv_spit view part cx 20480 n view part b 0 m
end

note nd_prep cx js tp ids wrong: view-prep: load ROUND40/final-selected.json (slot 2) onto js and
note tp, rebuild BASE (slot 4) and prepare, for each comma-separated id of ids, the first run whose
note job path contains it: its broken file under BASE/root (unless the fault is "missing"), its
note objective line (in cx and BASE/objs.txt), its expect.json rec and its map records; with wrong
note the first objective's a is k+n+a+1. The number of objectives, or a negative error.
fn nd_prep cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap ids view uchar * wrong bool to long
put ndl 8 0
put ndl 9 0
put ndrn 0 0
n = nd_sub cx 2 5 ndsel
if eq n dvnone
ret neg long 36
end
k = dv_jload view part cx 20480 n js tp
if lt k 0
ret k
end
if ne js_type tp 0 jsarr
ret neg long 22
end
r = nd_tree cx
if lt r 0
ret r
end
r = nd_prepl cx js tp ids wrong
if lt r 0
ret r
end
r = nd_wobjf cx
if lt r 0
ret r
end
r = nd_wexp cx js tp
if lt r 0
ret r
end
r = nd_wmap cx js tp
if lt r 0
ret r
end
ret long get ndl 9
end

note ======== processes

note nd_track pid: a slot for child pid (its status -1, running), or dvnone when the table is
note full (the child is then killed and reaped).
fn nd_track pid long to ulong
i = get ndpn 0
if ge i 16
x = dv_killg pid 9
x = dv_kill pid 9
x = dv_reap pid
ret dvnone
end
put ndpid i pid
put ndpst i neg long 1
put ndpn 0 add i 1
ret i
end

note nd_poll i: tracked process i's status without blocking: -1 while it runs, its dv_wstat
note status once finished (kept), -10 for no such slot.
fn nd_poll i ulong to long
if ge i get ndpn 0
ret neg long 10
end
s = get ndpst i
if ne s -1
ret s
end
r = dv_poll get ndpid i
if ne r -1
put ndpst i r
end
ret r
end

note nd_fin i sec: wait for tracked process i up to sec seconds: its status, or -110 when it was
note killed (group and pid) at the deadline.
fn nd_fin i ulong sec ulong to long
if ge i get ndpn 0
ret neg long 10
end
s = get ndpst i
if ne s -1
ret s
end
r = dv_wait get ndpid i mul sec 1000000000
put ndpst i r
ret r
end

note nd_sig i sig: signal sig to tracked process i alone (not its group) while it runs.
fn nd_sig i ulong sig int to long
if ge i get ndpn 0
ret neg long 10
end
if ne get ndpst i -1
ret 0
end
ret dv_kill get ndpid i sig
end

note nd_reap i: wait (blocking) for tracked process i: its status.
fn nd_reap i ulong to long
if ge i get ndpn 0
ret neg long 10
end
s = get ndpst i
if ne s -1
ret s
end
r = dv_reap get ndpid i
put ndpst i r
ret r
end

note nd_clean: SIGKILL every tracked process's group and every one still running, reap them,
note and empty the table (the end of each scenario).
fn nd_clean to void
for i ulong get ndpn 0
x = dv_killg get ndpid i 9
if eq get ndpst i -1
x = dv_kill get ndpid i 9
x = dv_reap get ndpid i
put ndpst i x
end
end
put ndpn 0 0
end

note ======== spawning fake-serve and the node

note nd_pkn pk p v: the decimal v appended to the packed list (dv_pkadd; pk is 4096 bytes).
fn nd_pkn pk edit uchar 4096 p ulong v long to ulong
d = new uchar 24 0
q = dv_fmtl d 0 v
ret dv_pkadd pk p view part d 0 q
end

note nd_pks cx pk p s t: path slot s joined with t appended to the packed list.
fn nd_pks cx edit uchar 65536 pk edit uchar 4096 p ulong s ulong t view uchar * to ulong
n = nd_sub cx s 5 t
if eq n dvnone
ret dvnone
end
ret dv_pkadd pk p view part cx 20480 n
end

note nd_pkw pk p t: each space-separated word of t appended to the packed list.
fn nd_pkw pk edit uchar 4096 p ulong t view uchar * to ulong
q = p
s = ulong 0
i = ulong 0
while le i len t bound 16777217
c = true
if lt i len t
c = eq get t i 32
end
if c
if gt i s
q = dv_pkadd pk q view part t s sub i s
end
s = add i 1
end
i = add i 1
end
ret q
end

note nd_pkobj pk p b: each line of b (the prepared objectives, cx[32768..+ndl[8])) appended to the
note packed list.
fn nd_pkobj pk edit uchar 4096 p ulong b view uchar * to ulong
q = p
s = ulong 0
while lt s len b bound 16777217
e = nd_lend b s
q = dv_pkadd pk q view part b s sub e s
s = add e 1
end
ret q
end

note nd_wtext pa t l0 sec: true once file pa holds t at or after offset l0, polled every 20 ms
note for up to sec seconds.
fn nd_wtext pa view uchar * t view uchar * l0 ulong sec ulong to bool
b = new uchar 262144 0
t0 = ulong monons
while true bound 9223372036854775807
n = dv_slurp pa b
if ge n 0
if ne dv_find view part b 0 ulong n t l0 dvnone
ret true
end
end
if ge sub ulong monons t0 mul sec 1000000000
ret false
end
x = sleepns 20000000
end
ret false
end

note nd_flen pa: the length of file pa (0 when it is missing or longer than 262144 bytes).
fn nd_flen pa view uchar * to ulong
b = new uchar 262144 0
n = dv_slurp pa b
if lt n 0
ret 0
end
ret ulong n
end

note nd_fake cx dl: start BUILD/fake-serve on a free port (ndport[0]) with BASE/map and delay dl
note ms, stdout and stderr appended to BASE/fake.log, and wait up to 5 s for its new PORT line:
note its process slot, or dvnone.
fn nd_fake cx edit uchar 65536 dl ulong to ulong
pk = new uchar 4096 0
lg = new uchar 4096 0
pt = dv_port
if lt pt 0
ret dvnone
end
put ndport 0 pt
n = nd_sub cx 4 5 ndflog
m = dv_cat lg 0 view part cx 20480 n
l0 = nd_flen view part lg 0 m
p = dv_pkinit pk
p = nd_pks cx pk p 0 ndfake
p = nd_pkn pk p pt
p = nd_pks cx pk p 4 ndmap
p = nd_pkn pk p long dl
if or eq p dvnone eq m dvnone
ret dvnone
end
pid = dv_spawna view part pk 0 p view part lg 0 m
if lt pid 0
ret dvnone
end
i = nd_track pid
x = nd_wtext view part lg 0 m ndportw l0 5
ret i
end

note nd_tagp cx o tg sx: BASE/ followed by tg and sx into o; the length or dvnone.
fn nd_tagp cx edit uchar 65536 o edit uchar 4096 tg view uchar * sx view uchar * to ulong
a = new uchar 4096 0
n = dv_cat a 0 tg
n = dv_cat a n sx
if eq n dvnone
ret dvnone
end
ret dv_join o view part cx 16384 get ndl 4 view part a 0 n
end

note nd_set cx s t: text t copied into path slot s; its length or dvnone.
fn nd_set cx edit uchar 65536 s ulong t view uchar * to ulong
n = dv_cat part cx mul s 4096 4096 0 t
if ne n dvnone
put ndl s n
end
ret n
end

note nd_pknode cx pk fp vp: the node argument list: BUILD/PROGRAM and the mode words (slot 6,
note "PROGRAM [MODE...]"), BUILD/infer, BUILD/tool, OMC, BASE/root, BASE/work, BASE/journal, fp,
note vp, then the objective lines.
fn nd_pknode cx edit uchar 65536 pk edit uchar 4096 fp long vp long to ulong
w = new uchar 4096 0
n = dv_cat w 0 view part cx 24576 get ndl 6
e = ulong 0
while lt e n bound 4097
if eq get w e 32
break
end
e = add e 1
end
p = dv_pkinit pk
p = nd_pks cx pk p 0 view part w 0 e
p = nd_pkw pk p view part w e sub n e
p = nd_pks cx pk p 0 ndinfer
p = nd_pks cx pk p 0 ndtool
p = dv_pkadd pk p view part cx 4096 get ndl 1
p = nd_pks cx pk p 4 ndroot
p = nd_pks cx pk p 4 ndwork
p = nd_pks cx pk p 4 ndjour
p = nd_pkn pk p fp
p = nd_pkn pk p vp
ret nd_pkobj pk p view part cx 32768 get ndl 8
end

note nd_fhas pa t l0: true when file pa (read up to 256 KiB) holds t at or after offset l0.
fn nd_fhas pa view uchar * t view uchar * l0 ulong to bool
b = new uchar 262144 0
n = dv_slurp pa b
if lt n 0
ret false
end
ret ne dv_find view part b 0 ulong n t l0 dvnone
end

note nd_nodeup fo vp i: wait up to 10 s for "CWV vp" in file fo or for process i to exit: true
note when the line was seen and the process still runs.
fn nd_nodeup fo view uchar * vp long i ulong to bool
w = new uchar 32 0
q = dv_cat w 0 ndcwv
q = dv_fmtl w q vp
q = dv_byte w q 10
t0 = ulong monons
while true bound 9223372036854775807
f = nd_fhas fo view part w 0 q 0
r = nd_poll i
if or f ne r -1
ret and f eq r -1
end
if ge sub ulong monons t0 10000000000
ret false
end
x = sleepns 20000000
end
ret false
end

note nd_nsp pk p fo fe n: spawn the packed list pk[0..p) with stdout to fo[0..n) and stderr to
note fe[0..n): its pid, or a negative error.
fn nd_nsp pk view uchar 4096 p ulong fo view uchar 4096 fe view uchar 4096 n ulong to long
ret dv_spawn view part pk 0 p view part fo 0 n view part fe 0 n
end

note nd_nodew cx tg vp i: nd_nodeup on BASE/tg.out.
fn nd_nodew cx edit uchar 65536 tg view uchar * vp long i ulong to bool
fo = new uchar 4096 0
nl = nd_tagp cx fo tg ndout
if eq nl dvnone
ret false
end
ret nd_nodeup view part fo 0 nl vp i
end

note nd_node cx tg fp: start the node of slot 6 ("PROGRAM [MODE...]", nd_set; e.g. "code-main" or
note "code-test overload 1", PROGRAM under BUILD) with fake-serve port fp, the prepared objectives
note and a free view port (ndport[1]), stdout to BASE/tg.out and stderr to BASE/tg.err, and wait for
note its view (ndport[2] 1 when up): its process slot, or dvnone when it could not start.
fn nd_node cx edit uchar 65536 tg view uchar * fp long to ulong
pk = new uchar 4096 0
fo = new uchar 4096 0
fe = new uchar 4096 0
put ndport 2 0
vp = dv_port
put ndport 1 vp
if lt vp 0
ret dvnone
end
p = nd_pknode cx pk fp vp
if eq p dvnone
ret dvnone
end
n = nd_tagp cx fo tg ndout
x = nd_tagp cx fe tg nderr
if or eq n dvnone ne x n
ret dvnone
end
pid = nd_nsp pk p fo fe n
if lt pid 0
ret dvnone
end
i = nd_track pid
if nd_nodew cx tg vp i
put ndport 2 1
end
ret i
end

note nd_outl cx tg b: file BASE/tg.out read into b: its length, or the negative dv_slurp error.
fn nd_outl cx edit uchar 65536 tg view uchar * b edit uchar * to long
fo = new uchar 4096 0
n = nd_tagp cx fo tg ndout
if eq n dvnone
ret neg long 36
end
ret dv_slurp view part fo 0 n b
end

note ======== omnode-op calls

note nd_pkop pk p w: the op word w (1 view, 2 cmd, 3 the usage control "view x") and the ndon[0]
note numbers of ndoa appended.
fn nd_pkop pk edit uchar 4096 p ulong w ulong to ulong
q = p
if eq w 2
q = dv_pkadd pk q ndcmd
else
q = dv_pkadd pk q ndview
end
if eq w 3
q = dv_pkadd pk q ndwx
end
for i ulong get ndon 0
q = nd_pkn pk q get ndoa i
end
ret q
end

note nd_args n a b c d e: the first n (at most 5) of a b c d e as the op numbers (ndoa, ndon[0]).
fn nd_args n ulong a long b long c long d long e long to void
put ndoa 0 a
put ndoa 1 b
put ndoa 2 c
put ndoa 3 d
put ndoa 4 e
put ndon 0 n
end

note nd_argx n a b c d: the first n (at most 4) of a b c d appended to the op numbers.
fn nd_argx n ulong a long b long c long d long to void
k = get ndon 0
if gt add k n 16
ret
end
if gt n 0
put ndoa k a
end
if gt n 1
put ndoa add k 1 b
end
if gt n 2
put ndoa add k 2 c
end
if gt n 3
put ndoa add k 3 d
end
put ndon 0 add k n
end

note nd_op cx js tp pt w: run BUILD/op pt WORD NUMBERS... (word w as nd_pkop, the op numbers) with
note stdout captured to slot 7 and a 30 s deadline; its stdout parsed onto js and tp. Sets ndr;
note returns its status.
fn nd_op cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long w ulong to long
pk = new uchar 4096 0
put ndr 0 neg long 7
put ndr 1 0
p = dv_pkinit pk
p = nd_pks cx pk p 0 ndop
p = nd_pkn pk p pt
p = nd_pkop pk p w
if eq p dvnone
ret neg long 7
end
pid = dv_spawn view part pk 0 p view part cx 28672 get ndl 7 dvnull
if lt pid 0
put ndr 0 pid
ret pid
end
r = dv_wait pid 30000000000
put ndr 0 r
k = dv_jload view part cx 28672 get ndl 7 js tp
if gt k 0
put ndr 1 1
end
ret r
end

note nd_view cx js tp pt: op pt view (a snapshot): its status.
fn nd_view cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long to long
put ndon 0 0
ret nd_op cx js tp pt 1
end

note nd_viewd cx js tp pt sn inc: op pt view sn inc (a delta since version sn): its status.
fn nd_viewd cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long sn long inc long to long
nd_args 2 sn inc 0 0 0
ret nd_op cx js tp pt 1
end

note nd_vctl cx js tp pt: the usage control op pt view x 1: its status.
fn nd_vctl cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long to long
nd_args 1 1 0 0 0 0
ret nd_op cx js tp pt 3
end

note nd_cmd cx js tp pt: op pt cmd NUMBERS (set by nd_args and nd_argx: cid opn tg inc ver, then
note any operation arguments): its status.
fn nd_cmd cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long to long
ret nd_op cx js tp pt 2
end

note ======== answers of the last op call (all jsnone/missing-safe)

note nd_tk js tp t key: member key of object token t of the last answer; jsnone when it did not
note parse, t is jsnone or no object, or key is missing.
fn nd_tk js view uchar * tp view uint dvtcap t ulong key view uchar * to ulong
if or eq get ndr 1 0 eq t jsnone
ret jsnone
end
ret dv_jkey js tp t key
end

note nd_ti js tp t key: integer member key of token t (nd_tk); 0 with ndbad set when missing.
fn nd_ti js view uchar * tp view uint dvtcap t ulong key view uchar * to long
v = nd_tk js tp t key
if not dv_jisl js tp v
put ndbad 0 1
ret 0
end
ret dv_jnum js tp v
end

note nd_el tp t i: element i of array token t, or jsnone.
fn nd_el tp view uint dvtcap t ulong i ulong to ulong
if or eq get ndr 1 0 eq t jsnone
ret jsnone
end
ret dv_jidx tp t i
end

note nd_ei js tp t i: integer element i of array token t; 0 with ndbad set when missing.
fn nd_ei js view uchar * tp view uint dvtcap t ulong i ulong to long
v = nd_el tp t i
if not dv_jisl js tp v
put ndbad 0 1
ret 0
end
ret dv_jnum js tp v
end

note nd_n tp t: the element count of array token t; 0 with ndbad set when t is no array.
fn nd_n tp view uint dvtcap t ulong to ulong
if or eq get ndr 1 0 eq t jsnone
put ndbad 0 1
ret 0
end
if ne js_type tp t jsarr
put ndbad 0 1
ret 0
end
ret dv_jlen tp t
end

note nd_status js tp s: true when the last answer parsed as an object whose status is s.
fn nd_status js view uchar * tp view uint dvtcap s view uchar * to bool
v = nd_tk js tp 0 ndkst
if eq v jsnone
ret false
end
ret dv_jsteq js tp v s
end

note nd_dj o p js tp t: token t's JSON text as the last answer had it (compact), or None when the
note answer did not parse or t is jsnone, appended at o[p] (o is a 1024-byte detail buffer).
fn nd_dj o edit uchar 1024 p ulong js view uchar * tp view uint dvtcap t ulong to ulong
if or eq get ndr 1 0 eq t jsnone
ret dv_cat o p ndnone
end
ret dv_cat o p part js js_off tp t js_span tp t
end

note nd_frarg sv n js tp: the op numbers sv[0..3) INC VER sv[3..n), with INC and VER (incarnation,
note version) of the last answer (a view).
fn nd_frarg sv view long 16 n ulong js view uchar jsmaxn tp view uint dvtcap to void
inc = nd_ti js tp 0 ndkinc
ver = nd_ti js tp 0 ndkver
nd_args 5 get sv 0 get sv 1 get sv 2 inc ver
for i ulong sub n 3
put ndoa add i 5 get sv add i 3
end
put ndon 0 add n 2
end

note nd_fresh cx js tp pt: with the op numbers cid opn tg [ARGS...] (nd_args, nd_argx), up to 20
note times: view, then cmd cid opn tg INC VER ARGS... with that view's incarnation and version,
note until the answer is not stale. Its status; ndr[1] 0 and no answer when a view did not parse.
fn nd_fresh cx edit uchar 65536 js edit uchar jsmaxn tp edit uint dvtcap pt long to long
sv = new long 16 0
n = get ndon 0
if or lt n 3 gt n 14
ret neg long 22
end
for i ulong n
put sv i get ndoa i
end
r = long 0
for k ulong 20
r = nd_view cx js tp pt
if eq get ndr 1 0
ret r
end
nd_frarg sv n js tp
r = nd_cmd cx js tp pt
if not nd_status js tp ndstale
ret r
end
end
ret r
end

note ======== the journal and the listening check

note nd_jset b m o: true when a settled DONE record (type 4, word 7 non-zero) among the m records
note of journal b carries the operation words 3..6 of the record at b[o].
fn nd_jset b view uchar * m ulong o ulong to bool
for i ulong m
r = add 64 mul i 128
if eq nd_w64 b r 4
if ne nd_w64 b add r 56 0
c = true
for w ulong 4
if ne nd_w64 b add r mul add w 3 8 nd_w64 b add o mul add w 3 8
c = false
end
end
if c
ret true
end
end
end
end
ret false
end

note nd_jstart cx jid: true when BASE/journal/journal holds a START record (type 3) for job jid
note whose operation no settled DONE record carries (view-accept.py journal_started).
fn nd_jstart cx edit uchar 65536 jid ulong to bool
b = new uchar 1048576 0
q = nd_sub cx 4 5 ndjfile
if eq q dvnone
ret false
end
n = dv_slurp view part cx 20480 q b
if lt n 64
ret false
end
m = div sub ulong n 64 128
for i ulong m
o = add 64 mul i 128
if eq nd_w64 b o 3
if eq nd_w64 b add o 64 jid
if not nd_jset view part b 0 ulong n m o
ret true
end
end
end
end
ret false
end

note nd_hexv b s e: the hexadecimal number b[s..e) (dvnone for another byte).
fn nd_hexv b view uchar * s ulong e ulong to ulong
v = ulong 0
for i ulong sub e s
c = ulong get b add s i
d = dvnone
if and ge c 48 le c 57
d = sub c 48
end
if and ge c 65 le c 70
d = sub c 55
end
if and ge c 97 le c 102
d = sub c 87
end
if eq d dvnone
ret dvnone
end
v = or shl v 4 d
end
ret v
end

note nd_lsnl l pt: 1 when /proc/net/tcp line l is a LISTEN (st 0A) entry on local port pt.
fn nd_lsnl l view uchar * pt long to ulong
f = new ulong 8 0
nf = ulong 0
s = ulong 0
inf = false
for i ulong len l
sp = eq get l i 32
if and not sp not inf
s = i
inf = true
end
if and sp inf
if lt nf 4
put f mul nf 2 s
put f add mul nf 2 1 i
end
nf = add nf 1
inf = false
end
end
if and inf lt nf 4
put f mul nf 2 s
put f add mul nf 2 1 len l
nf = add nf 1
end
if lt nf 4
ret 0
end
if ne sub get f 7 get f 6 2
ret 0
end
if ne nd_hexv l get f 6 get f 7 10
ret 0
end
e = get f 3
c = e
while gt c get f 2 bound 64
if eq get l sub c 1 58
break
end
c = sub c 1
end
if eq c get f 2
ret 0
end
if eq nd_hexv l c e ulong pt
ret 1
end
ret 0
end

note nd_lsnb b pt: count (into ndlc) the LISTEN entries on pt among the complete lines of b:
note the bytes consumed (through the last newline).
fn nd_lsnb b view uchar * pt long to ulong
s = ulong 0
i = ulong 0
while lt i len b bound 16777217
if eq get b i 10
put ndlc 0 add get ndlc 0 nd_lsnl view part b s sub i s pt
s = add i 1
end
i = add i 1
end
ret s
end

note nd_lsnf pa pt: the number of LISTEN entries on port pt in table pa (/proc/net/tcp or tcp6),
note read in 65536-byte chunks; 0 when it cannot be opened.
fn nd_lsnf pa view uchar * pt long to ulong
b = new uchar 65536 0
put ndlc 0 0
fd = fopen pa 0 len pa 524288 0
if lt fd 0
ret 0
end
n = ulong 0
while true bound 16777217
k = read int fd b n sub 65536 n
if le k 0
break
end
n = add n ulong k
s = nd_lsnb view part b 0 n pt
for j ulong sub n s
put b j get b add s j
end
n = sub n s
if ge n 65536
n = 0
end
end
if gt n 0
put ndlc 0 add get ndlc 0 nd_lsnl view part b 0 n pt
end
x = fclose int fd
ret get ndlc 0
end

note nd_lsn pt: true when some TCP socket (IPv4 or IPv6) listens on port pt (ss -ltn's answer).
fn nd_lsn pt long to bool
a = nd_lsnf ndtcp pt
b = nd_lsnf ndtcp6 pt
ret gt add a b 0
end

note seed/node/tests/fake-serve.om -- a recorded completion server for the
note DRA-291 view tests: the real omnode-infer talks HTTP to it, but answers
note come from a map of recorded turns instead of a model. OM-2; compose
note after seed/net/http.om and seed/net/notls.om.
note   fake-serve PORT MAP DELAY_MS
note MAP holds entries "<klen> <vlen>\n" then klen key bytes and vlen value
note bytes. Every answer comes DELAY_MS ms after the request was read: POST
note /v1/completions whose body contains a key gets 200 with that key's
note value as the body; any other request 404.
note One request at a time, 127.0.0.1 only. Prints PORT n, then one line
note per request: F status key-index ms.
text fsurl "/v1/completions"
text fsjson "application/json"
text fsctype "Content-Type"
text fsport "PORT "
text fsf "F "
text fssp " "
text fsnl "\n"
global fsmap uchar 2097152
global fsn ulong 1
global fsk ulong 1024

fn fs_num i ulong to ulong
b = new uchar 32 0
n = argread i b 0 32
if or lt n 1 gt n 9
ret not ulong 0
end
v = ulong 0
for j ulong ulong n
c = ulong get b j
if or lt c 48 gt c 57
ret not ulong 0
end
v = add mul v 10 sub c 48
end
ret v
end

note Load MAP: false when unreadable or malformed. fsk[4k..]: key offset,
note key length, value offset, value length.
fn fs_load to bool
p = new uchar 1024 0
n = argread 2 p 0 1000
if lt n 1
ret false
end
fd = fopen p 0 ulong n 524288 0
if lt fd 0
ret false
end
t = ulong 0
for it ulong 4096
r = read int fd fsmap t sub 2097152 t
if le r 0
break
end
t = add t ulong r
end
x = fclose int fd
ret fs_index t
end

fn fs_index t ulong to bool
p = ulong 0
k = ulong 0
for it ulong 256
if ge p t
put fsn 0 k
ret true
end
a = fs_dnum p
p = add p add fs_dlen p 1
b = fs_dnum p
p = add p add fs_dlen p 1
if gt add add p a b t
ret false
end
o = mul k 4
put fsk o p
put fsk add o 1 a
put fsk add o 2 add p a
put fsk add o 3 b
p = add add p a b
k = add k 1
end
ret false
end

fn fs_dlen p ulong to ulong
for i ulong 12
c = ulong get fsmap add p i
if or lt c 48 gt c 57
ret i
end
end
ret 12
end

fn fs_dnum p ulong to ulong
v = ulong 0
for i ulong fs_dlen p
v = add mul v 10 sub ulong get fsmap add p i 48
end
ret v
end

note The entry whose key occurs in body b[0, n), or -1.
fn fs_find b view uchar 1048576 n ulong to long
for k ulong get fsn 0 bound 256
o = mul k 4
ko = get fsk o
kl = get fsk add o 1
if and gt kl 0 le kl n
for s ulong add sub n kl 1
if fs_at b s ko kl
ret long k
end
end
end
end
ret neg long 1
end

fn fs_at b view uchar 1048576 s ulong ko ulong kl ulong to bool
for i ulong kl
if ne get b add s i get fsmap add ko i
ret false
end
end
ret true
end

fn fs_out a view uchar * n ulong to void
x = write 1 a 0 n
end

fn fs_dec v ulong to void
d = new uchar 20 0
k = ulong 20
x = v
for it ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
fs_out view part d k sub 20 k sub 20 k
end

fn fs_log st ulong k long ms ulong to void
fs_out fsf len fsf
fs_dec st
fs_out fssp 1
if lt k 0
fs_dec ulong 999
else
fs_dec ulong k
end
fs_out fssp 1
fs_dec ms
fs_out fsnl 1
end

fn fs_one fd int cs edit ulong 320 io edit uchar 131072 bd edit uchar 1048576 dl ulong to void
t0 = monons
r = hinit cs io fd 1
hsettmo cs 5000000000 5000000000
hsetbdl cs 5000000000
r = hreqrd cs io
if le r 0
x = hclose cs
ret
end
put cs HBCAP 1048576
n = hbodyall cs io bd
k = neg long 1
if and gt n 0 hispath cs io fsurl
k = fs_find bd ulong n
end
x = sleepns long mul dl 1000000
if lt k 0
r = hrsperr cs io 404
x = hclose cs
fs_log ulong 404 k ulong div sub monons t0 1000000
ret
end
fs_reply cs io bd ulong k
x = hclose cs
fs_log ulong 200 k ulong div sub monons t0 1000000
end

note Answer with entry k's value (copied into vb, a global is never a call
note argument).
fn fs_reply cs edit ulong 320 io edit uchar 131072 vb edit uchar 1048576 k ulong to void
o = mul k 4
vo = get fsk add o 2
vl = get fsk add o 3
for i ulong vl
put vb i get fsmap add vo i
end
put cs HKEEP 0
r = hrspst cs io 200
r = hfe r hhname cs io fsctype
r = hfe r hhval cs io fsjson
r = hfe r hhend cs io 0 vl
r = hfe r hput cs io view part vb 0 vl
r = hfe r hwfin cs io
end

fn main to int
cs = new ulong 320 0
io = new uchar 131072 0
bd = new uchar 1048576 0
a = new uchar 16 0
if ne argcnt 4
ret 2
end
po = fs_num 1
dl = fs_num 3
if or or eq po 0 gt po 65535 or eq po 18091 gt dl 600000
ret 2
end
if not fs_load
ret 3
end
r = haddr4 a 2130706433 po
lf = hlisten a 16
if lt lf 0
ret 4
end
fs_out fsport len fsport
fs_dec hport a
fs_out fsnl 1
for it ulong 1000000000
c = haccept int lf neg long 1
if ge c 0
fs_one int c cs io bd dl
end
end
ret 0
end

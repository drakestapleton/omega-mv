note Native independent wire client. Argument is the disposable server PID.
text label "omega-node-n0."
text ok "PASS N0 control; maximum snapshot latency in nanoseconds follows\n"
text nl "\n"
global serverid ulong 1
global addr uchar 110
global wire uchar 4
global reply uchar 12
global peer uchar 12
global held int 6

fn write_number v ulong to void
d = new uchar 20 0
x = v
k = ulong 20
for i ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
r = write 1 d k sub 20 k
end

note Write "/proc/<pid>/stat" into p; returns its length.
fn ck test bool code int to void
if not test
exit code
end
end

fn init_addr to void
a = new uchar 12 0
n = argread 1 a 0 len a
ck and gt n 0 le n 8 2
v = ulong 0
for i ulong ulong n bound 8
b = get a i
ck and ge b 48 le b 57 2
v = add mul v 10 ulong sub b 48
end
ck gt v 0 2
put serverid 0 v
put addr 0 1
for i ulong len label
put addr add i 3 get label i
end
for i ulong 4
b = uchar and shr v mul i 8 255
put addr add add len label 3 i b
end
end

fn dial to int
for i ulong 40
s = socknew 1 524289 0
ck ge s 0 3
r = connect int s addr 0 add len label 7
if eq r 0
ck eq peercred int s peer 0 12 0 4
id = ulong 0
for j ulong 4
id = or id shl ulong get peer j mul j 8
end
ck eq id get serverid 0 4
ret int s
end
r = fclose int s
r = sleepns 5000000
end
exit 5
end

fn exchange op uchar ver uchar count ulong size uchar to void
s = dial
put wire 0 size
put wire 1 ver
put wire 2 op
put wire 3 123
for i ulong count bound 4
ck eq sendmsg s wire i 1 16384 1 6
end
ck eq shutdown s 1 0 6
off = ulong 0
for k ulong 12
ck gt waitio s 1 1000000000 0 7
r = recv s reply off sub 12 off 0
ck gt r 0 7
off = add off ulong r
if eq off 12
break
end
end
ck eq off 12 7
ck eq get reply 0 11 8
ck eq get reply 1 1 8
if ge count 3
ck eq get reply 2 op 8
end
id = ulong 0
for j ulong 4
id = or id shl ulong get reply add j 8 mul j 8
end
ck eq id get serverid 0 8
r = fclose s
end

fn cmd op uchar to void
exchange op 1 3 2
ck eq get reply 3 0 9
end

fn bad op uchar ver uchar count ulong size uchar to void
exchange op ver count size
ck eq get reply 3 1 10
end

fn latency to long
for k ulong 6
s = dial
put held k s
ck eq sendmsg s wire 0 1 16384 1 11
end
mx = long 0
for j ulong 32
t = monons
cmd 2
dt = sub monons t
ck lt dt 200000000 12
if gt dt mx
mx = dt
end
ck eq get reply 6 0 12
end
for k ulong 6
r = fclose get held k
end
ret mx
end

fn main to int
init_addr
cmd 1
bad 5 2 3 2
bad 3 1 2 2
bad 3 1 4 2
bad 3 1 3 255
bad 77 1 3 2
cmd 2
ck eq get reply 4 0 13
mx = latency
ck eq get reply 7 1 14
cmd 3
ck eq get reply 4 1 15
cmd 4
ck eq get reply 4 0 16
cmd 6
ck eq get reply 6 1 17
for i ulong 100
cmd 2
if eq get reply 6 2
break
end
r = sleepns 2000000
end
ck eq get reply 6 2 18
cmd 5
r = write 1 ok 0 len ok
write_number ulong mx
r = write 1 nl 0 len nl
ret 0
end

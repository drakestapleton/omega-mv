note seed/node/code-cat.om -- catalog mode of the coding workflow (SemC
note DRA-323 / DRA-290): the model edits a compact source that calls
note entries of a pinned catalog; every check resolves it first. OM-2.
note Compose after seed/node/code.om, before code-cat-main.om.
note omnode-code-cat INFER TOOL OMC ROOT WORK JDIR PORT RESOLVE CATALOG LOCK
note CARD OBJ [OBJ...]: the arguments of omnode-code plus RESOLVE (the
note resolver program), CATALOG and LOCK (absolute paths) and CARD, the
note card variant the prompt shows: none, sig (the signature line of each
note entry) or full (signature, card note, example). At start the creator
note runs RESOLVE card CATALOG LOCK (stdout WORK/card.txt, stderr
note WORK/card.err) and takes the variant's lines from that output; the
note same CATALOG and LOCK go to every checkc job, so what the model sees
note and what is built come from one lock. The card is printed once as
note CWK variant length, newline, its bytes, newline. Exit codes as
note omnode-code, plus 56 the card could not be made, 57 the card is over
note 1000 bytes.
text cccard "card"
text ccfile "/card.txt"
text ccferr "/card.err"
text ccnull "/dev/null"
text ccnone "none"
text ccsig "sig"
text ccfull "full"
text cck "CWK "

note The card variant of argument ai: 0 none, 1 sig, 2 full, 9 other.
fn cc_var ai ulong to ulong
b = new uchar 16 0
n = argread ai b 0 16
if lt n 1
ret 9
end
if cw_eq view part b 0 ulong n ccnone
ret 0
end
if cw_eq view part b 0 ulong n ccsig
ret 1
end
if cw_eq view part b 0 ulong n ccfull
ret 2
end
ret 9
end

note WORK followed by name nm into t; the length.
fn cc_wpath t edit uchar 4096 nm view uchar * to ulong
p = cw_catl t 0 14 0
ret cw_cat t p nm
end

note Run RESOLVE card CATALOG LOCK with stdout WORK/card.txt; 0 when it
note exited 0, else 1.
fn cc_run to ulong
pk = new uchar 4096 0
t = new uchar 4096 0
u = new uchar 4096 0
p = cw_cfg pk 2 7
p = cw_arg pk p cccard
p = cw_cfg pk p 8
p = cw_cfg pk p 9
n = cc_wpath t ccfile
m = cc_wpath u ccferr
pid = fork
if eq pid 0
fi = fopen ccnull 0 len ccnull 524288 0
fo = fopen t 0 n 524865 420
fe = fopen u 0 m 524865 420
if or or lt fi 0 lt fo 0 lt fe 0
exit 120
end
r = dupfd int fi 0 0
r = dupfd int fo 1 0
r = dupfd int fe 2 0
r = execprog pk 0 p
exit 121
end
if lt pid 0
ret 1
end
ws = new uchar 4 0
g = waitpid int pid ws 0 4 0
if or lt g 0 or ne get ws 0 0 ne get ws 1 0
ret 1
end
ret 0
end

note The card: WORK/card.txt read, the lines of variant v kept (v 1 every
note third line from the first, v 2 all, v 0 none) without the final
note newline, into config slot 10. 0, 56 unreadable, 57 over 1000 bytes.
fn cc_load v ulong to int
b = new uchar 4096 0
o = new uchar 4096 0
k = cc_read b
if or lt k 1 ge k 4096
ret 56
end
q = cc_sel b ulong k v o
if gt q 1000
ret 57
end
for j ulong q
put cwcf add 10240 j get o j
end
put cwcl 10 q
ret 0
end

note WORK/card.txt into b (one read): its length, or negative.
fn cc_read b edit uchar 4096 to long
t = new uchar 4096 0
n = cc_wpath t ccfile
fd = fopen t 0 n 557056 0
if lt fd 0
ret fd
end
k = read int fd b 0 4096
x = fclose int fd
ret long k
end

note The lines of b[0, k) selected by variant v into o, joined by
note newlines, without a final newline; the length.
fn cc_sel b view uchar 4096 k ulong v ulong o edit uchar 4096 to ulong
if eq v 0
ret 0
end
q = ulong 0
ln = ulong 0
for j ulong k
c = get b j
if or eq v 2 eq rem ln 3 0
put o q c
q = add q 1
end
if eq c 10
ln = add ln 1
end
end
if and gt q 0 eq get o sub q 1 10
q = sub q 1
end
ret q
end

note CWK v length, newline, the card, newline.
fn cc_show v ulong to void
o = new uchar 4096 0
t = new uchar 4096 0
p = cw_cat o 0 cck
p = cw_dec o p v
p = cw_cat o p cwsp
p = cw_dec o p get cwcl 10
p = cw_cat o p cwnl
cw_out o p
n = cw_ld t 20 0
cw_out t n
cw_out cwnl 1
end

note omnode-code-cat from argument k (see above).
fn cw_cmain k ulong dls ulong to int
b = new uchar 1024 0
c = ulong argcnt
if or lt c add k 12 gt c add k 15
ret 2
end
for a ulong 10
if not cw_carg add k a a
ret 2
end
end
v = cc_var add k 10
if eq v 9
ret 2
end
put cwct 0 1
put cwct 1 v
put grcat 0 1
put cwno 0 sub c add k 11
for i ulong get cwno 0 bound 4
m = argread add add k 11 i b 0 1024
if lt m 1
ret 2
end
if not cw_parse i view part b 0 ulong m
ret 2
end
end
if ne cc_run 0
ret 56
end
e = cc_load v
if ne e 0
ret e
end
cc_show v
ret cw_run add k 11 dls
end

note seed/node/code-cat.om -- catalog mode of the coding workflow (SemC
note DRA-323 / DRA-290): the model edits a compact source that calls
note entries of a pinned catalog; every check resolves it first. OM-2.
note Compose after seed/node/code.om, before code-cat-main.om.
note omnode-code-cat INFER TOOL OMC ROOT WORK JDIR PORT RESOLVE CATALOG LOCK
note CARD OBJ [OBJ...]: the arguments of omnode-code plus RESOLVE (the
note resolver program), CATALOG and LOCK (absolute paths) and CARD, the
note card variant the prompt shows: none, sig (the signature line of each
note entry) or full (signature, card note, example). At start the creator
note runs RESOLVE sig CATALOG LOCK for sig, otherwise card (stdout WORK/card.txt, stderr
note WORK/card.err) and takes the variant's lines from that output; the
note CATALOG and LOCK are first copied to private read-only snapshots outside ROOT.
note Their paths feed both the card and every checkc job. The card is printed once as
note CWK variant length, newline, its bytes, newline. Exit codes as
note omnode-code, plus 56 the card could not be made, 57 the card is over
note 1000 bytes; 58 unsafe workspace layout or failed snapshot.
text cccard "card"
text ccsign "sig"
text ccfile "/card.txt"
text ccferr "/card.err"
text ccnull "/dev/null"
text ccnone "none"
text ccsig "sig"
text ccfull "full"
text cck "CWK "

note The card variant of argument ai: 0 none, 1 sig, 2 full, 9 other.
fn cc_var ai ulong to ulong
b = new uchar 16 0
n = argread ai b 0 16
if lt n 1
ret 9
end
if cw_eq view part b 0 ulong n ccnone
ret 0
end
if cw_eq view part b 0 ulong n ccsig
ret 1
end
if cw_eq view part b 0 ulong n ccfull
ret 2
end
ret 9
end

note WORK followed by name nm into t; the length.
fn cc_wpath t edit uchar 4096 nm view uchar * to ulong
p = cw_catl t 0 14 0
ret cw_cat t p nm
end

note Run RESOLVE sig or card CATALOG LOCK with stdout WORK/card.txt; 0 when it
note exited 0, else 1.
fn cc_run to ulong
pk = new uchar 4096 0
t = new uchar 4096 0
u = new uchar 4096 0
p = cw_cfg pk 2 7
if eq get cwct 1 1
p = cw_arg pk p ccsign
else
p = cw_arg pk p cccard
end
p = cw_cfg pk p 8
p = cw_cfg pk p 9
n = cc_wpath t ccfile
m = cc_wpath u ccferr
pid = fork
if eq pid 0
fi = fopen ccnull 0 len ccnull 524288 0
fo = fopen t 0 n 524865 420
fe = fopen u 0 m 524865 420
if or or lt fi 0 lt fo 0 lt fe 0
exit 120
end
r = dupfd int fi 0 0
r = dupfd int fo 1 0
r = dupfd int fe 2 0
r = execprog pk 0 p
exit 121
end
if lt pid 0
ret 1
end
ws = new uchar 4 0
g = waitpid int pid ws 0 4 0
if or lt g 0 or ne get ws 0 0 ne get ws 1 0
ret 1
end
ret 0
end

note The card: WORK/card.txt read, the lines of variant v kept (v 1 each
note returned signature line, v 2 all card lines, v 0 none) without the final
note newline, into config slot 10. 0, 56 unreadable, 57 over 1000 bytes.
fn cc_load v ulong to int
b = new uchar 4096 0
o = new uchar 4096 0
k = cc_read b
if or lt k 1 ge k 4096
ret 56
end
q = cc_sel b ulong k v o
if gt q 1000
ret 57
end
for j ulong q
put cwcf add 10240 j get o j
end
put cwcl 10 q
ret 0
end

note WORK/card.txt into b (one read): its length, or negative.
fn cc_read b edit uchar 4096 to long
t = new uchar 4096 0
n = cc_wpath t ccfile
fd = fopen t 0 n 557056 0
if lt fd 0
ret fd
end
k = read int fd b 0 4096
x = fclose int fd
ret long k
end

note The lines of b[0, k) selected by variant v into o, joined by
note newlines, without a final newline; the length.
fn cc_sel b view uchar 4096 k ulong v ulong o edit uchar 4096 to ulong
if eq v 0
ret 0
end
q = ulong 0
for j ulong k
c = get b j
put o q c
q = add q 1
end
if and gt q 0 eq get o sub q 1 10
q = sub q 1
end
ret q
end

note CWK v length, newline, the card, newline.
fn cc_show v ulong to void
o = new uchar 4096 0
t = new uchar 4096 0
p = cw_cat o 0 cck
p = cw_dec o p v
p = cw_cat o p cwsp
p = cw_dec o p get cwcl 10
p = cw_cat o p cwnl
cw_out o p
n = cw_ld t 20 0
cw_out t n
cw_out cwnl 1
end

note Private snapshot paths. Root and work must be absolute directories with
note no links, dot components or trailing slash. Work must be outside root.
text ccsdir "/.catalog-"
text ccscat "/catalog.om"
text ccslock "/lock"

fn cc_dpart p view uchar * s ulong i ulong to bool
st = new uchar 128 0
m = sub i s
if eq m 0
ret false
end
if and eq m 1 eq get p s 46
ret false
end
if and eq m 2 and eq get p s 46 eq get p add s 1 46
ret false
end
r = lstat p 0 i st 0 128
md = or ulong get st 16 shl ulong get st 17 8
if or lt r 0 ne and md 61440 16384
ret false
end
ret true
end

fn cc_dir p view uchar * to bool
n = len p
if or lt n 2 ne get p 0 47
ret false
end
s = ulong 1
for i ulong add n 1
if eq i 0
continue
end
c = uchar 47
if lt i n
c = get p i
if or lt c 32 eq c 127
ret false
end
end
if ne c 47
continue
end
if not cc_dpart p s i
ret false
end
s = add i 1
end
ret true
end

note Both validated paths have no aliases through dot components or symlinks.
fn cc_outside root view uchar * work view uchar * to bool
if lt len work len root
ret true
end
for i ulong len root
if ne get root i get work i
ret true
end
end
if eq len work len root
ret false
end
ret ne get work len root 47
end

note Bounded regular input read, private exclusive read-only output. Failure
note leaves diagnostics in the private directory and never reuses old bytes.
fn cc_readcopy src view uchar * b edit uchar 262145 cap ulong to long
st = new uchar 128 0
fd = fopen src 0 len src 559104 0
if lt fd 0
ret neg long 1
end
r = fstat int fd st 0 128
md = or ulong get st 16 shl ulong get st 17 8
if or lt r 0 ne and md 61440 32768
x = fclose int fd
ret neg long 1
end
n = ulong 0
for it ulong 262146
k = read int fd b n sub add cap 1 n
if lt k 0
x = fclose int fd
ret neg long 1
end
if eq k 0
break
end
n = add n ulong k
if gt n cap
x = fclose int fd
ret neg long 1
end
end
x = fclose int fd
if ne x 0
ret neg long 1
end
ret long n
end

fn cc_writecopy dst view uchar * b view uchar 262145 n ulong to bool
outfd = fopen dst 0 len dst 557249 256
if lt outfd 0
ret false
end
p = ulong 0
for it ulong 262146
if eq p n
break
end
k = write int outfd b p sub n p
if le k 0
x = fclose int outfd
ret false
end
p = add p ulong k
end
r = fsync int outfd
x = fclose int outfd
ret and eq r 0 eq x 0
end

fn cc_copy src view uchar * dst view uchar * cap ulong to bool
b = new uchar 262145 0
n = cc_readcopy src b cap
if lt n 0
ret false
end
ret cc_writecopy dst b ulong n
end

fn cc_store k ulong p view uchar * to void
for i ulong len p
put cwcf add mul k 1024 i get p i
end
put cwcl k len p
end

note Snapshot before card generation. The same replaced slots feed every
note checkc. Typed model tools can only edit ROOT, never this sibling path.
note Hostile same-UID mutation and concurrent directory swaps are not covered.
fn cc_snapfile dir view uchar * name view uchar * slot ulong cap ulong to bool
dst = new uchar 4096 0
src = new uchar 4096 0
dn = cw_cat dst 0 dir
dn = cw_cat dst dn name
sn = cw_ld src add 10 slot 0
if not cc_copy view part src 0 sn view part dst 0 dn cap
ret false
end
cc_store slot view part dst 0 dn
ret true
end

fn cc_snapshot to bool
root = new uchar 4096 0
work = new uchar 4096 0
dir = new uchar 4096 0
rn = cw_ld root 13 0
wn = cw_ld work 14 0
if or not cc_dir view part root 0 rn not cc_dir view part work 0 wn
ret false
end
if not cc_outside view part root 0 rn view part work 0 wn
ret false
end
dn = cw_cat dir 0 view part work 0 wn
dn = cw_cat dir dn ccsdir
dn = cw_dec dir dn ulong getpid
if gt dn 980
ret false
end
if ne makedir dir 0 dn 448 0
ret false
end
if not cc_snapfile view part dir 0 dn ccscat 8 262144
ret false
end
ret cc_snapfile view part dir 0 dn ccslock 9 8192
end

note omnode-code-cat from argument k (see above).
fn cw_cmain k ulong dls ulong to int
b = new uchar 1024 0
c = ulong argcnt
if or lt c add k 12 gt c add k 15
ret 2
end
for a ulong 10
if not cw_carg add k a a
ret 2
end
end
v = cc_var add k 10
if eq v 9
ret 2
end
put cwct 0 1
put cwct 1 v
put grcat 0 1
put cwno 0 sub c add k 11
for i ulong get cwno 0 bound 4
m = argread add add k 11 i b 0 1024
if lt m 1
ret 2
end
if not cw_parse i view part b 0 ulong m
ret 2
end
end
if not cc_snapshot
ret 58
end
if ne cc_run 0
ret 56
end
e = cc_load v
if ne e 0
ret e
end
cc_show v
ret cw_run add k 11 dls
end

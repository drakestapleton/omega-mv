note Signature-card regression. Compose code-cat.om before this unit.
note The resolver sig command returns one signature per locked entry.
text cxtwo "first x int to int\nsecond x int to int\n"
text cxwant "first x int to int\nsecond x int to int"
fn cx_unit to int
b = new uchar 4096 0
o = new uchar 4096 0
for i ulong len cxtwo
put b i get cxtwo i
end
n = cc_sel b len cxtwo 1 o
if ne n len cxwant
ret 1
end
for i ulong n
if ne get o i get cxwant i
ret 2
end
end
if ne cc_sel b len cxtwo 0 o 0
ret 3
end
if ne cc_sel b len cxtwo 2 o len cxwant
ret 4
end
ret 0
end

text cxall "first x int to int\nsecond x int to int\nthird x int to int\nfourth x int to int"
fn main to int
r = cx_unit
if ne r 0
ret r
end
if eq argcnt 1
ret 0
end
if ne argcnt 5
ret 10
end
if not cw_carg 1 7
ret 11
end
if not cw_carg 2 8
ret 12
end
if not cw_carg 3 9
ret 13
end
if not cw_carg 4 4
ret 14
end
put cwct 1 1
if ne cc_run 0
ret 15
end
if ne cc_load 1 0
ret 16
end
b = new uchar 4096 0
n = cw_ld b 20 0
if ne n len cxall
ret 17
end
for i ulong n
if ne get b i get cxall i
ret 18
end
end
ret 0
end

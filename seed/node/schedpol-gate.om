note Omega Node transport, concatenate with a program-mode consumer.
note Trusted forked processes only. This is transport, not write authority.
note One publisher PID, 64 immutable records per epoch; reuse only via node_reset.
note Layout: 4096 byte header then 64 slots of 4160 bytes.
note Header u64: magic, ABI, published count, stop, publisher PID, epoch.
note Slot u64: version, length, topic mask; payload begins at offset 64.
const NCAP ulong 64
const NBYTES ulong 270336
const NMAGIC ulong 1313817669

fn node_new to long
h = mapnew neg int 1 0 NBYTES 3 33
if le h 0
ret h
end
r = mapset h 8 8 1
r = mapset h 32 8 ulong getpid
r = mapset h 0 8 NMAGIC
ret h
end

fn node_valid h long to bool
ret and eq mapget h 0 8 NMAGIC eq mapget h 8 8 1
end

fn node_offset v ulong to ulong
ret add 4096 mul sub v 1 4160
end

note Return version, or -1 stopped, -2 full, -3 length, -4 topic,
note -5 invalid header, -6 wrong publisher. Refusals do not publish.
fn node_publish h long topics ulong src view uchar 4096 n ulong to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
if ne mapget h 24 8 0
ret neg long 1
end
if gt n 4096
ret neg long 3
end
if eq topics 0
ret neg long 4
end
v = mapget h 16 8
if gt v NCAP
ret neg long 5
end
if eq v NCAP
ret neg long 2
end
v = add v 1
off = node_offset v
r = mapwrite h add off 64 src 0 n
r = mapset h add off 8 8 n
r = mapset h add off 16 8 topics
note mapset has barriers before and after its aligned store.
r = mapset h off 8 v
r = mapset h 16 8 v
ret long v
end

note Header and record checks precede copying. No partial publication is read.
note Returns payload length, -5 invalid header/record, -7 unavailable version.
fn node_read h long v ulong dst edit uchar 4096 to long
if not node_valid h
ret neg long 5
end
if or eq v 0 gt v NCAP
ret neg long 7
end
latest = mapget h 16 8
if gt latest NCAP
ret neg long 5
end
if gt v latest
ret neg long 7
end
off = node_offset v
if ne mapget h off 8 v
ret neg long 5
end
n = mapget h add off 8 8
if gt n 4096
ret neg long 5
end
ret mapread h add off 64 dst 0 n
end

note Return the next matching version after cursor, zero if caught up,
note or negative refusal. Caller advances its cursor through returned versions.
fn node_next h long cursor ulong topics ulong to long
if not node_valid h
ret neg long 5
end
if or gt cursor NCAP eq topics 0
ret neg long 7
end
latest = mapget h 16 8
if or gt latest NCAP gt cursor latest
ret neg long 5
end
v = cursor
note At most NCAP published slots can be examined.
while lt v latest bound 64
v = add v 1
off = node_offset v
if ne mapget h off 8 v
ret neg long 5
end
if ne and mapget h add off 16 8 topics 0
ret long v
end
end
ret 0
end

fn node_stop h long to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
ret mapset h 24 8 1
end

note Creator only. Retire every record so a pool can reuse the arena for a new
note epoch. The caller must first prove no reader holds the old epoch (pool.om).
note The count drops to zero before any record version is cleared.
fn node_reset h long epoch ulong to long
if not node_valid h
ret neg long 5
end
if ne mapget h 32 8 ulong getpid
ret neg long 6
end
if eq epoch 0
ret neg long 7
end
r = mapset h 16 8 0
for i ulong NCAP
r = mapset h node_offset add i 1 8 0
end
r = mapset h 24 8 0
r = mapset h 40 8 epoch
ret 0
end

fn node_epoch h long to ulong
ret mapget h 40 8
end

note The latest published version of the arena's current epoch (0 when empty).
fn node_count h long to ulong
ret mapget h 16 8
end

note One nonblocking eventfd per consumer. Saturation means already readable.
note Interrupted operations retry at most 64 times, then return EINTR.
fn node_notify fd int to long
buf = new uchar 8 0
put buf 0 1
for i ulong 64
r = write fd buf 0 8
if eq r 8
ret 0
end
if eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn node_drain fd int to long
buf = new uchar 8 0
for i ulong 64
r = read fd buf 0 8
if or eq r 8 eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn node_pollfd p edit uchar 16 off ulong fd int to void
for i ulong 4
put p add off i uchar and shr uint fd uint mul i 8 255
end
put p add off 4 1
end

note Returns 2 stop, 1 wake, 0 timeout or negative errno.
note Control takes priority when both descriptors are ready.
note EINTR returns to caller so it can recompute its monotonic deadline.
fn node_wait h long wake int stop int interval long to long
p = new uchar 16 0
if not node_valid h
ret neg long 5
end
if or lt wake 0 lt stop 0
ret neg long 9
end
if eq wake stop
ret neg long 22
end
if ne mapget h 24 8 0
ret 2
end
node_pollfd p 0 wake
node_pollfd p 8 stop
r = pollfds p 0 16 interval
if lt r 0
ret r
end
if ne mapget h 24 8 0
ret 2
end
if ne and get p 14 56 0
ret neg long 5
end
if ne and get p 14 1 0
r = node_drain stop
if lt r 0
ret r
end
ret 2
end
if ne and get p 6 56 0
ret neg long 5
end
if ne and get p 6 1 0
r = node_drain wake
if lt r 0
ret r
end
ret 1
end
ret 0
end
note Omega Node epoch pool. Concatenate after transport.om, before super.om.
note K arenas (1..8) and one control page are mapped before any worker fork,
note so every forked worker inherits the same shared mappings.
note Single writer: the creator writes the current epoch, the arena table and
note every arena record. Worker w alone writes hold word w while it lives;
note the creator clears hold w only after it has reaped worker w.
note Control u64: 0 magic, 8 ABI, 16 current epoch, 24 stop, 32 creator PID,
note 40 arena count K, 48 worker slots W, 64+8k arena handle k,
note 128+8k epoch of arena k (0 free), 256+8w hold of worker w (0 none),
note 768+8w worker PID, 1280+8w worker state (0 empty, 1 live, 2 reaped).
const PMAGIC ulong 1347374924
const PCAP ulong 8
const PWCAP ulong 64
const PBYTES ulong 4096

fn pool_valid c long to bool
ret and eq mapget c 0 8 PMAGIC eq mapget c 8 8 1
end

fn pool_mine c long to bool
ret eq mapget c 32 8 ulong getpid
end

fn pool_arena c long k ulong to long
ret long mapget c add 64 mul k 8 8
end

note Drop the first n arenas and the control page of a pool being refused.
fn pool_unwind c long n ulong to long
for i ulong n bound 8
r = mapdrop pool_arena c i
end
ret mapdrop c
end

note Return the control handle, or -7 bad size, or a negative mapping errno.
note Arena 0 starts as epoch 1. Call before forking any worker.
fn pool_new k ulong w ulong to long
if or eq k 0 gt k PCAP
ret neg long 7
end
if or eq w 0 gt w PWCAP
ret neg long 7
end
c = mapnew neg int 1 0 PBYTES 3 33
if le c 0
ret c
end
r = mapset c 32 8 ulong getpid
r = mapset c 40 8 k
r = mapset c 48 8 w
for i ulong k bound 8
h = node_new
if le h 0
r = pool_unwind c i
ret h
end
r = mapset c add 64 mul i 8 8 ulong h
end
r = node_reset pool_arena c 0 1
r = mapset c 128 8 1
r = mapset c 16 8 1
r = mapset c 8 8 1
r = mapset c 0 8 PMAGIC
ret c
end

note Arena index holding epoch e, or -5 when no arena holds it.
fn pool_slot c long e ulong to long
k = mapget c 40 8
if gt k PCAP
ret neg long 5
end
for i ulong k bound 8
if eq mapget c add 128 mul i 8 8 e
ret long i
end
end
ret neg long 5
end

note Creator: the arena of the current epoch, or a negative refusal.
fn pool_current c long to long
if not pool_valid c
ret neg long 5
end
k = pool_slot c mapget c 16 8
if lt k 0
ret k
end
ret pool_arena c ulong k
end

fn pool_epoch c long to ulong
ret mapget c 16 8
end

note Worker step: store hold e for worker w, then read the epoch again. mapset
note and mapget fence both sides, so a creator that moved the epoch before it
note scanned holds either sees this hold or this read sees the move. Returns
note the arena of e, -8 when the epoch moved, or -5 when no arena holds e.
note Every refusal clears the hold.
fn pool_hold c long w ulong e ulong to long
if ge w mapget c 48 8
ret neg long 7
end
hw = add 256 mul w 8
r = mapset c hw 8 e
if ne mapget c 16 8 e
r = mapset c hw 8 0
ret neg long 8
end
k = pool_slot c e
if lt k 0
r = mapset c hw 8 0
ret k
end
h = pool_arena c ulong k
if ne node_epoch h e
r = mapset c hw 8 0
ret neg long 5
end
ret h
end

note Worker w holds the current epoch and returns its arena. Returns -1
note stopped, -5 invalid, -7 bad worker, -8 the epoch kept moving.
fn pool_acquire c long w ulong to long
if not pool_valid c
ret neg long 5
end
if ge w mapget c 48 8
ret neg long 7
end
for t ulong 16
if ne mapget c 24 8 0
r = mapset c add 256 mul w 8 8 0
ret neg long 1
end
h = pool_hold c w mapget c 16 8
if ne h neg long 8
ret h
end
end
ret neg long 8
end

note Worker w gives up its hold. Its old arena must not be read afterwards.
fn pool_release c long w ulong to long
if ge w mapget c 48 8
ret neg long 7
end
ret mapset c add 256 mul w 8 8 0
end

fn pool_held c long e ulong to bool
n = mapget c 48 8
for w ulong n bound 64
if eq mapget c add 256 mul w 8 8 e
ret true
end
end
ret false
end

note Creator step: retire arena i and open epoch n in it, then publish n.
fn pool_reuse c long i ulong n ulong to long
off = add 128 mul i 8
r = mapset c off 8 0
r = node_reset pool_arena c i n
if lt r 0
ret r
end
r = mapset c off 8 n
r = mapset c 16 8 n
ret long n
end

note Creator step: an arena that is free or whose older epoch no worker holds,
note or -9. Call only after the current epoch has moved past that arena.
fn pool_pick c long to long
e = mapget c 16 8
k = mapget c 40 8
for i ulong k bound 8
ek = mapget c add 128 mul i 8 8
if ne ek e
if or eq ek 0 not pool_held c ek
ret long i
end
end
end
ret neg long 9
end

note Creator: open the next epoch in a free or unheld arena and make it current.
note Returns the new epoch, -1 stopped, -5 invalid, -6 not creator, or -9 when
note every other arena is still held: the pool fails closed, nothing changes.
fn pool_roll c long to long
if not pool_valid c
ret neg long 5
end
if not pool_mine c
ret neg long 6
end
if ne mapget c 24 8 0
ret neg long 1
end
k = pool_pick c
if lt k 0
ret k
end
ret pool_reuse c ulong k add mapget c 16 8 1
end

note Creator: publish to the current epoch; when it is full, roll once and retry.
note Returns the version, or the refusal of the publish or of the roll.
fn pool_publish c long topics ulong src view uchar 4096 n ulong to long
h = pool_current c
if lt h 0
ret h
end
v = node_publish h topics src n
if ne v neg long 2
ret v
end
r = pool_roll c
if lt r 0
ret r
end
h = pool_current c
if lt h 0
ret h
end
ret node_publish h topics src n
end

fn pool_stop c long to long
if not pool_valid c
ret neg long 5
end
if not pool_mine c
ret neg long 6
end
ret mapset c 24 8 1
end

fn pool_stopped c long to bool
ret ne mapget c 24 8 0
end

note Creator: record worker w's PID and state for observers.
fn pool_setw c long w ulong pid ulong st ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
r = mapset c add 768 mul w 8 8 pid
ret mapset c add 1280 mul w 8 8 st
end

note Creator: clear hold w. Only after worker w has been reaped.
fn pool_clear c long w ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
ret mapset c add 256 mul w 8 8 0
end

note Drop every mapping of the pool in this process. Other processes keep
note their own inherited mappings until they drop them or exit.
fn pool_free c long to long
ret pool_unwind c mapget c 40 8
end
note Omega Node worker supervision. Concatenate after transport.om and pool.om.
note The creator forks trusted workers from its own binary: sup_spawn returns 0
note in the child, which runs its worker function and exits with its result.
note Death is seen without polling PIDs. Worker w alone holds the write end of
note its close-on-exec life pipe, so its exit hangs up the creator's read end.
note Every worker holds the read end of the creator's life pipe, whose only
note writer is the creator, so creator death hangs up every worker.
note Per worker: wake, stop and ack eventfds, kept across respawns.
note Workers must not exec: exec closes the life pipe and reads as death.
global swpid long 64
global swwake int 64
global swstop int 64
global swack int 64
global swlife int 64
global swst ulong 64
global swpw ulong 64
global swpar int 2
global swme ulong 1
global swws uchar 4
global swpf uchar 8
global swpoll uchar 1024

fn sup_fd off ulong to int
v = ulong get swpf off
v = or v shl ulong get swpf add off 1 8
v = or v shl ulong get swpf add off 2 16
v = or v shl ulong get swpf add off 3 24
ret int v
end

note Poll record j at swpoll offset off; a negative fd is stored as itself
note (bit pattern) so the kernel ignores that record.
fn sup_gpfd off ulong fd int to void
u = bitcast uint fd
for i ulong 4
put swpoll add off i uchar and shr u uint mul i 8 255
end
put swpoll add off 4 1
put swpoll add off 5 0
put swpoll add off 6 0
put swpoll add off 7 0
end

fn sup_lpfd p edit uchar 24 off ulong fd int to void
for i ulong 4
put p add off i uchar and shr uint fd uint mul i 8 255
end
put p add off 4 1
end

note Read and reset an eventfd counter: the number of hints since the last
note take, 0 when none is pending, or a negative errno.
fn sup_take fd int to long
buf = new uchar 8 0
for i ulong 64
r = read fd buf 0 8
if eq r 8
v = ulong 0
for j ulong 8
v = or v shl ulong get buf j mul j 8
end
ret long and v 9223372036854775807
end
if eq r neg long 11
ret 0
end
if ne r neg long 4
if lt r 0
ret r
end
ret neg long 5
end
end
ret neg long 4
end

fn sup_closeall to void
for i ulong 64
if ge get swwake i 0
r = fclose get swwake i
end
if ge get swstop i 0
r = fclose get swstop i
end
if ge get swack i 0
r = fclose get swack i
end
if ge get swlife i 0
r = fclose get swlife i
end
put swwake i neg int 1
put swstop i neg int 1
put swack i neg int 1
put swlife i neg int 1
end
for i ulong 2
if ge get swpar i 0
r = fclose get swpar i
end
put swpar i neg int 1
end
end

note Creator: create the creator life pipe and three eventfds per worker slot.
note Call once after pool_new and before sup_spawn. 0 or a negative errno;
note a failure closes everything this call opened.
fn sup_init c long to long
if not pool_mine c
ret neg long 6
end
for i ulong 64
put swpid i 0
put swst i 0
put swwake i neg int 1
put swstop i neg int 1
put swack i neg int 1
put swlife i neg int 1
end
put swme 0 0
put swpar 0 neg int 1
put swpar 1 neg int 1
r = pipefds swpf 0 8 524288
if lt r 0
ret r
end
put swpar 0 sup_fd 0
put swpar 1 sup_fd 4
n = mapget c 48 8
for i ulong n bound 64
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swwake i int a
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swstop i int a
a = eventfd uint 0
if lt a 0
sup_closeall
ret a
end
put swack i int a
end
ret 0
end

note Creator: fork worker w. Returns 0 in the child, the child PID in the
note creator, -7 bad slot, -16 slot still live, or a negative errno. The
note child keeps only its own life write end; the creator keeps the read end.
fn sup_spawn c long w ulong to long
if not pool_mine c
ret neg long 6
end
if ge w mapget c 48 8
ret neg long 7
end
if ne get swpid w 0
ret neg long 16
end
r = pipefds swpf 0 8 524288
if lt r 0
ret r
end
rd = sup_fd 0
wr = sup_fd 4
pid = fork
if eq pid 0
r = fclose get swpar 1
put swpar 1 neg int 1
r = fclose rd
put swlife w wr
put swme 0 add w 1
ret 0
end
r = fclose wr
if lt pid 0
r = fclose rd
ret pid
end
put swpid w pid
put swlife w rd
r = pool_setw c w ulong pid 1
ret pid
end

note Worker: 3 creator gone, 2 stop, 1 wake hint, 0 timeout, negative errno.
note Creator loss outranks stop, which outranks work. A set stop flag makes
note the poll nonblocking. Hints are drained; rescan shared state after 1.
fn sup_wwait c long w ulong interval long to long
p = new uchar 24 0
if ge w 64
ret neg long 7
end
iv = interval
if pool_stopped c
iv = 0
end
sup_lpfd p 0 get swwake w
sup_lpfd p 8 get swstop w
sup_lpfd p 16 get swpar 0
r = pollfds p 0 24 iv
if lt r 0
ret r
end
if ne get p 22 0
ret 3
end
if pool_stopped c
ret 2
end
if ne and get p 14 56 0
ret neg long 5
end
if ne and get p 14 1 0
r = node_drain get swstop w
ret 2
end
if ne and get p 6 56 0
ret neg long 5
end
if ne and get p 6 1 0
r = node_drain get swwake w
if lt r 0
ret r
end
ret 1
end
ret 0
end

note Worker or creator: post a hint on worker w's ack eventfd.
fn sup_ack w ulong to long
if ge w 64
ret neg long 7
end
ret node_notify get swack w
end

note Creator: wake worker w with a work hint.
fn sup_wake w ulong to long
if ge w 64
ret neg long 7
end
if le get swpid w 0
ret neg long 3
end
ret node_notify get swwake w
end

fn sup_live c long to ulong
n = mapget c 48 8
k = ulong 0
for w ulong n bound 64
if gt get swpid w 0
k = add k 1
end
end
ret k
end

note Creator: reap worker w, then release what it held. A worker that has not
note exited within about one second gets SIGKILL first. Only after the exact
note PID is reaped are its hold, PID and life pipe released. Returns the raw
note wait status, -3 no live worker, or the waitpid errno (nothing released).
fn sup_reap c long w ulong to long
if ge w 64
ret neg long 7
end
pid = get swpid w
if le pid 0
ret neg long 3
end
done = false
for t ulong 100
r = waitpid int pid swws 0 4 1
if eq r pid
done = true
break
end
if ne r 0
ret r
end
r = sleepns 10000000
end
if not done
r = killpid int pid 9
r = waitpid int pid swws 0 4 0
if ne r pid
ret r
end
end
st = ulong get swws 0
st = or st shl ulong get swws 1 8
put swst w st
r = fclose get swlife w
put swlife w neg int 1
put swpid w 0
r = pool_clear c w
r = pool_setw c w 0 2
ret long st
end

note Creator: wait up to interval ns for deaths and, when acks is true, acks.
note Ack counts are left pending for sup_take. Every worker whose life pipe
note hung up is reaped. Returns the number reaped, or a negative errno.
fn sup_pollx c long interval long acks bool to long
n = mapget c 48 8
m = ulong 0
for w ulong n bound 64
if gt get swpid w 0
o = mul m 16
if acks
sup_gpfd o get swack w
else
sup_gpfd o neg int 1
end
sup_gpfd add o 8 get swlife w
put swpw m w
m = add m 1
end
end
if eq m 0
ret 0
end
r = pollfds swpoll 0 mul m 16 interval
if lt r 0
ret r
end
dead = long 0
for j ulong m bound 64
o = add mul j 16 14
if ne get swpoll o 0
r = sup_reap c get swpw j
if lt r 0
ret r
end
dead = add dead 1
end
end
ret dead
end

note Creator: wait up to interval ns for acks and deaths (see sup_pollx).
fn sup_poll c long interval long to long
ret sup_pollx c interval true
end

note Creator: stop admission, post every live worker's stop eventfd, then reap
note until all have exited or interval ns pass; survivors get SIGKILL and are
note reaped. Returns how many had to be killed, or a refusal.
fn sup_stop c long interval long to long
r = pool_stop c
if lt r 0
ret r
end
n = mapget c 48 8
for w ulong n bound 64
if gt get swpid w 0
r = node_notify get swstop w
end
end
dl = add monons interval
for t ulong 100000
if eq sup_live c 0
ret 0
end
now = monons
if ge now dl
break
end
r = sup_pollx c sub dl now false
if lt r 0
if ne r neg long 4
break
end
end
end
killed = long 0
for w ulong n bound 64
if gt get swpid w 0
r = killpid int get swpid w 9
r = sup_reap c w
killed = add killed 1
end
end
ret killed
end
note Omega Node cooperative scheduling (DRA-287). Concatenate after
note transport.om, pool.om and super.om, before one program with fn main.
note One creator admits, assigns, collects and reviews jobs. Workers never
note write each other's state, and no step waits for every worker.
note Scheduling page: one 128-byte cell per worker w at 128*w.
note Creator writes 0 assigned seq, 8 job id, 16 input epoch, 24 input
note version, 32 interest topics, 40 wake stamp (monons at the last post).
note Worker writes 64 done seq, 72 outcome, 80 wakes, 88 last wake latency
note ns, 96 largest wake latency ns.
note Outbox: worker w's result bytes at 4096*w of a second mapping, written
note before its done seq. Each word has one writer; the creator writes a
note worker word only after it has reaped that worker.
note Job states: 0 free, 1 waiting for deps, 2 ready, 3 running, 4 in review,
note 6 UNKNOWN (its worker died mid-job and the job is not safe to rerun).
note
note Resources and selection policy (P-DRA-14, DRA-395). A request is one
note ulong of four 16-bit counts, kind k at bits 16k..16k+15: kind 0 CPU
note slots, 1 memory MiB, 2 inference slots, 3 caller-defined. scap holds
note the configured capacity of each kind, suse the sum of the needs of the
note jobs that hold resources (sjheld 1). A job takes its whole need when it
note is assigned and gives it back when its worker reports done or is reaped,
note never in part. Every job also needs one idle live worker.
note sjarr: admission order (waiting age; kept across reruns). sjrdy: order
note in which the job last became ready. sjbyp: times it was bypassed.
note Decisions read only these logical counters, never the clock.
note Policy 1, fair fitting (DRA-396): a pick first probes the reserved job;
note otherwise it scans a window of win slots from a persistent cursor and
note takes the oldest admitted ready job that fits. The cursor moves on by
note win after every window scan, so every slot is examined within
note ceil(64/win) window scans. A ready job older than a job assigned in
note the same event was bypassed; once the oldest such job reaches the
note bypass budget it is reserved: it is offered first, and no other job may
note use, of any kind, the capacity it still lacks (others may use only
note free capacity beyond its need). Neither the free capacity it can reach
note nor its age ever shrinks, so it runs once running work releases enough
note (liveness assumes: every running job ends, by completion or by its
note lease, at least one worker stays live, results in review are reviewed,
note and dispatch is not paused). Requests over capacity are refused at
note admission.
note Admission: room is the smaller of the admission headroom and the free
note table slots. A refused caller holds a ticket; while tickets are held
note only the first holder may enter, so holders enter in ticket order
note before anyone new. A ticket not asked about for more than ttl dispatch
note events lapses (asked at event e, it survives while e + ttl is at least
note the current event count). An absent head blocks later holders until
note its ticket lapses; a paused dispatch counts no events, so the block
note lasts until dispatch resumes.
note Leases: a running job with a lease is reported once by sched_overdue
note after its lease passes; the authority then cancels or kills it, which
note releases its resources.
note
note Policy 2, goal-aware fair fitting (DRA-397): policy 1 with a different
note order among the examined jobs that fit: larger unblock value first (the
note waiting jobs, to depth 2, that the job's declared topics would make
note ready), then smaller declared estimate, then older admission. The
note reservation, the hold-back, feasibility and the bypass budget are
note those of policy 1 and come first, so ranking cannot starve old work.
note Values are rescored only when the graph version moved (a job became
note ready, a waiting job was admitted, a job was cancelled, a declaration
note changed), once per pick however many changes came before it.
note Completions, releases and lease expiry replan (every step dispatches)
note without rescoring. A proposal names a job by id and the graph version
note it was computed at, and is rejected when that version is no longer
note current; the version carries the scheduler's incarnation, so a
note proposal made for another scheduler is never current here.
const SJCAP ulong 64
const SPVER ulong 3
global scmap long 2
global sclim ulong 2
global sjst ulong 64
global sjdep ulong 64
global sjid ulong 64
global sjw ulong 64
global sjatt ulong 64
global sjfl ulong 64
global sjout ulong 64
global sjneed ulong 64
global sjheld ulong 64
global sjarr ulong 64
global sjrdy ulong 64
global sjbyp ulong 64
global sjlse ulong 64
global sjdue ulong 64
global sttk ulong 64
global stts ulong 64
global scbusy ulong 64
global scseq ulong 64
global swcur ulong 2
global scpause ulong 1
global scap ulong 4
global suse ulong 4
note Policy words: 0 policy (0 FIFO head-of-line, 1 fair fitting), 1
note candidate window in slots, 2 dispatch budget per event, 3 bypass
note budget, 4 cursor, 5 reserved job slot + 1 (0 none), 6 tickets held,
note 7 ticket lifetime in dispatch events.
global scpol ulong 8
note Counters (sched_stat): 0 admissions, 1 ready stamps, 2 dispatch events,
note 3 candidate slot reads, 4 jobs assigned, 5 bypasses, 6 reservations
note made, 7 impossible requests refused, 8 head-of-line stops, 9 reserved
note jobs assigned, 10 tickets issued, 11 tickets lapsed, 12 leases overdue,
note 13 maintenance slot reads, 14 window scans.
global scst ulong 16
note Goal-aware ranking (policy 2): sjpro the topics a job declares its
note completion publishes, sjest its declared work estimate in ms, sjunc
note that estimate's uncertainty in ms, sjval its unblock value in jobs as
note last scored. scgv: 0 graph version, 1 version last scored, 2 proposed
note job slot + 1 (0 none), 3 version the proposal named. The graph version
note is the scheduler's incarnation (sched_incarnate) times 2^40 plus the
note bumps since, so schedulers of different incarnations never share a
note version. Within one scheduler every change of a slot's occupant
note (admission, cancellation, becoming ready) bumps it, so a proposal
note whose version is current still names the job it was made for.
global sjpro ulong 64
global sjest ulong 64
global sjunc ulong 64
global sjval ulong 64
global scgv ulong 4
note Goal counters (sched_stat 32..39): 0 rescores, 1 jobs scored, 2 graph
note version bumps, 3 proposals accepted, 4 proposals stale, 5 proposals
note refused, 6 slots read by value traversal, 7 proposals used.
global scgst ulong 8

fn sc_cell w ulong off ulong to ulong
ret mapget get scmap 0 add mul w 128 off 8
end

fn sc_set w ulong off ulong v ulong to void
r = mapset get scmap 0 add mul w 128 off 8 v
end

note Creator, before any fork: map the scheduling page and the outboxes and
note set the limits on admitted (a) and in-review (rl) jobs, each 1..64.
note Returns 0, -6 not creator, -7 bad limit, or a mapping errno.
fn sched_new c long a ulong rl ulong to long
if not pool_mine c
ret neg long 6
end
if or eq a 0 gt a SJCAP
ret neg long 7
end
if or eq rl 0 gt rl SJCAP
ret neg long 7
end
s = mapnew neg int 1 0 8192 3 33
if le s 0
ret s
end
o = mapnew neg int 1 0 262144 3 33
if le o 0
r = mapdrop s
ret o
end
put scmap 0 s
put scmap 1 o
put sclim 0 a
put sclim 1 rl
for j ulong 64
put sjst j 0
put sjheld j 0
put sjlse j 0
put sjdue j 0
put sjpro j 0
put sjest j 0
put sjunc j 0
put sjval j 0
put scbusy j 0
put scseq j 0
end
for k ulong 4
put scap k 65535
put suse k 0
end
for i ulong 16
put scst i 0
end
for i ulong 8
put scgst i 0
end
for i ulong 4
put scgv i 0
end
put scpol 0 1
put scpol 1 64
put scpol 2 64
put scpol 3 4
put scpol 4 0
put scpol 5 0
put scpol 6 0
put scpol 7 1000
put scpause 0 0
ret 0
end

note Count of kind k (0..3) in packed request req.
fn sp_need req ulong k ulong to ulong
ret and shr req mul k 16 65535
end

note Free capacity of kind k. sched_cap never sets a capacity below the
note use, so this cannot underflow.
fn sp_free k ulong to ulong
ret sub get scap k get suse k
end

note Does req fit in the free capacity once the reserved request res has
note what it still lacks? Of each kind, res keeps min(free, its need); res 0
note is no reservation. This keeps the reserved job's attainable capacity
note from ever shrinking (the drain).
fn sp_fits req ulong res ulong to bool
for k ulong 4
f = sp_free k
r = sp_need res k
a = ulong 0
if gt f r
a = sub f r
end
if gt sp_need req k a
ret false
end
end
ret true
end

note Could req ever run, with the configured capacity all free?
fn sp_feas req ulong to bool
for k ulong 4
if gt sp_need req k get scap k
ret false
end
end
ret true
end

note Job j takes its whole need.
fn sp_take j ulong to void
for k ulong 4
put suse k add get suse k sp_need get sjneed j k
end
put sjheld j 1
end

note Job j gives back its need, if it holds it.
fn sp_give j ulong to void
if eq get sjheld j 0
ret
end
for k ulong 4
put suse k sub get suse k sp_need get sjneed j k
end
put sjheld j 0
end

note Job j becomes ready, stamped with the next ready order.
fn sp_ready j ulong to void
put sjst j 2
put sjrdy j get scst 1
put scst 1 add get scst 1 1
sp_bump
end

note Creator: counter i of scst, capacity (i 16..19) or use (i 20..23) of a
note kind, policy word (i 24..31), goal counter (i 32..39), graph version
note (i 40).
fn sched_stat i ulong to ulong
if lt i 16
ret get scst i
end
if lt i 20
ret get scap sub i 16
end
if lt i 24
ret get suse sub i 20
end
if lt i 32
ret get scpol sub i 24
end
if lt i 40
ret get scgst sub i 32
end
if eq i 40
ret get scgv 0
end
ret 0
end

note Creator: set the capacity of every kind from caps (packed like a
note request). 0, or -8 when the new capacity of a kind is below its use by
note running jobs, or below the need of any one admitted job (nothing
note changes).
fn sched_cap caps ulong to long
for k ulong 4
if lt sp_need caps k get suse k
ret neg long 8
end
end
for j ulong 64
s = get sjst j
if and ge s 1 le s 3
for k ulong 4
if gt sp_need get sjneed j k sp_need caps k
ret neg long 8
end
end
end
end
for k ulong 4
put scap k sp_need caps k
end
ret 0
end

note Creator: policy p (0 FIFO head-of-line, 1 fair fitting, 2 goal-aware
note fair fitting), candidate window win slots (1..64), dispatch budget db
note jobs per event (1..64), bypass budget by (1..65535), ticket lifetime
note ttl dispatch events (1..1000000). The cursor and any reservation are
note kept. 0 or -7.
fn sched_policy p ulong win ulong db ulong by ulong ttl ulong to long
if gt p 2
ret neg long 7
end
if or eq win 0 gt win 64
ret neg long 7
end
if or eq db 0 gt db 64
ret neg long 7
end
if or eq by 0 gt by 65535
ret neg long 7
end
if or eq ttl 0 gt ttl 1000000
ret neg long 7
end
put scpol 0 p
put scpol 1 win
put scpol 2 db
put scpol 3 by
put scpol 7 ttl
ret 0
end

note Creator: drop this process's scheduling mappings.
fn sched_free to long
r = mapdrop get scmap 1
if lt r 0
ret r
end
ret mapdrop get scmap 0
end

note Jobs whose state is in lo..hi.
fn sched_count lo ulong hi ulong to ulong
n = ulong 0
for j ulong 64
s = get sjst j
if and ge s lo le s hi
n = add n 1
end
end
ret n
end

note Position of id's admission ticket, or 64.
fn sp_tkpos id ulong to ulong
for t ulong get scpol 6 bound 64
if eq get sttk t id
ret t
end
end
ret 64
end

note Compact the tickets in order, dropping ticket d (64: none) and every
note ticket not asked about for the ticket lifetime.
fn sp_tkpack d ulong to void
k = ulong 0
for t ulong get scpol 6 bound 64
if ne t d
if lt add get stts t get scpol 7 get scst 2
put scst 11 add get scst 11 1
else
put sttk k get sttk t
put stts k get stts t
k = add k 1
end
end
end
put scpol 6 k
end

note Refresh ticket t, or give id a ticket at the end when it has none and
note the line has room (a caller refused with the line full holds none).
fn sp_tkhold id ulong t ulong to void
if lt t 64
put stts t get scst 2
ret
end
n = get scpol 6
if lt n 64
put sttk n id
put stts n get scst 2
put scpol 6 add n 1
put scst 10 add get scst 10 1
end
end

note Creator: may id be admitted now? Room is the smaller of the admission
note headroom and the free table slots (a job in review or UNKNOWN holds
note its slot). While tickets are held only the first holder may enter;
note with none, anyone may while there is room. A refused caller gets or
note keeps a ticket. Asking again changes nothing else, and a true answer
note guarantees the slot for the next sched_admitr (single creator), so a
note caller may ask before journaling (as jn_admit does).
fn sched_room id ulong to bool
sp_tkpack 64
t = sp_tkpos id
a = ulong 0
fs = ulong 0
for j ulong 64
s = get sjst j
if eq s 0
fs = add fs 1
end
if and ge s 1 le s 3
a = add a 1
end
end
room = ulong 0
if lt a get sclim 0
room = sub get sclim 0 a
end
if lt fs room
room = fs
end
if gt room 0
if eq get scpol 6 0
ret true
end
if eq t 0
ret true
end
end
sp_tkhold id t
ret false
end

note Creator: admit job id needing req (packed resources). deps 0 makes it
note ready at once; otherwise it waits for a publication whose topics meet
note deps. flags bit 0: safe to rerun after its worker dies. Returns the job
note slot; -8 when req exceeds the configured capacity of a kind (it could
note never run); -2 when sched_room refuses: at the admission limit, or
note ticket holders ahead; the caller keeps a ticket and asks again.
fn sched_admitr id ulong deps ulong flags ulong req ulong to long
if not sp_feas req
put scst 7 add get scst 7 1
ret neg long 8
end
if not sched_room id
ret neg long 2
end
for j ulong 64
if eq get sjst j 0
t = sp_tkpos id
if lt t 64
sp_tkpack t
end
put sjid j id
put sjdep j deps
put sjfl j flags
put sjatt j 0
put sjout j 0
put sjw j 0
put sjneed j req
put sjheld j 0
put sjbyp j 0
put sjlse j 0
put sjdue j 0
put sjarr j get scst 0
put scst 0 add get scst 0 1
put sjpro j 0
put sjest j 0
put sjunc j 0
put sjval j 0
if eq deps 0
sp_ready j
else
put sjst j 1
sp_bump
end
ret long j
end
end
ret neg long 2
end

note Creator: job j (waiting, ready or running) gets a lease of ns from its
note next assignment, or from now when it runs; 0 removes it. 0, or -3.
fn sched_lease j ulong ns ulong to long
if ge j 64
ret neg long 3
end
s = get sjst j
if or lt s 1 gt s 3
ret neg long 3
end
put sjlse j ns
if eq s 3
put sjdue j 0
if gt ns 0
put sjdue j add ulong monons ns
end
end
ret 0
end

note Creator: a running job past its lease whose worker has not reported
note done, reported once (its deadline is cleared): its slot, or 64. The
note authority cancels or kills it; the release follows from the worker's
note report or reap.
fn sched_overdue to ulong
now = ulong monons
for j ulong 64
if eq get sjst j 3
d = get sjdue j
if gt d 0
if ge now d
w = get sjw j
if ne sc_cell w 64 get scseq w
put sjdue j 0
put scst 12 add get scst 12 1
ret j
end
end
end
end
end
ret 64
end

note Creator: sched_admitr with no resource need beyond one worker.
fn sched_admit id ulong deps ulong flags ulong to long
ret sched_admitr id deps flags 0
end

note Creator: worker w is woken by publications whose topics meet topics.
fn sched_want w ulong topics ulong to long
if ge w 64
ret neg long 7
end
sc_set w 32 topics
ret 0
end

fn sc_wake w ulong to void
sc_set w 40 ulong monons
r = sup_wake w
end

note Lowest idle live worker below n, or 64 when none. A worker is idle when
note the creator has collected its last assignment.
fn sp_idle n ulong to ulong
for w ulong n bound 64
if and gt get swpid w 0 eq get scbusy w 0
ret w
end
end
ret 64
end

note Assign job j to idle worker w: it takes its need; the job id and the
note input epoch and version are written before the seq, then the wake.
fn sp_start c long j ulong w ulong to void
q = add get scseq w 1
put scseq w q
put scbusy w add j 1
put sjst j 3
put sjw j w
put sjatt j add get sjatt j 1
put sjbyp j 0
put sjdue j 0
if gt get sjlse j 0
put sjdue j add ulong monons get sjlse j
end
sp_take j
if eq get scpol 5 add j 1
put scpol 5 0
put scst 9 add get scst 9 1
end
sc_set w 8 get sjid j
sc_set w 16 pool_epoch c
sc_set w 24 node_count pool_current c
sc_set w 0 q
sc_wake w
put scst 4 add get scst 4 1
end

note Policy 0, FIFO head-of-line: the stop rule of the reference pump
note (aien-sovereign-core-mv spark-harness scheduler/core.rs Core::pump,
note 598-602), not its queue: the head here is the ready job that became
note ready first (the pump batches newly eligible tasks in task-id order
note into a bounded queue). The head is chosen when it fits, and when it
note does not fit nothing is chosen, so a head that does
note not fit holds back every later job. Returns the slot or 64.
fn sp_fifo to ulong
h = ulong 64
for j ulong 64
put scst 3 add get scst 3 1
if eq get sjst j 2
if eq h 64
h = j
else
if lt get sjrdy j get sjrdy h
h = j
end
end
end
end
if eq h 64
ret 64
end
if sp_fits get sjneed h 0
ret h
end
put scst 8 add get scst 8 1
ret 64
end

note Policy 1, fair fitting: the reserved job first when it fits; else the
note oldest admitted ready job, among win slots from the cursor, that fits
note without the capacity the reserved job still lacks; the cursor then
note moves on by win. Returns the slot or 64. Every slot read counts
note (counter 3: the reserved probe and the window), at most win + 1 per
note pick; counter 14 counts window scans.
fn sp_fair to ulong
rq = ulong 0
r = get scpol 5
if gt r 0
rj = sub r 1
put scst 3 add get scst 3 1
if eq get sjst rj 2
if sp_fits get sjneed rj 0
ret rj
end
rq = get sjneed rj
else
put scpol 5 0
end
end
goal = eq get scpol 0 2
if goal
sp_rescore
pj = sp_proposal rq
if lt pj 64
ret pj
end
end
win = get scpol 1
cur = get scpol 4
b = ulong 64
put scst 14 add get scst 14 1
for i ulong win bound 64
put scst 3 add get scst 3 1
j = rem add cur i 64
if eq get sjst j 2
if sp_fits get sjneed j rq
if eq b 64
b = j
else
if sp_better goal j b
b = j
end
end
end
end
end
put scpol 4 rem add cur win 64
ret b
end

note Ranking key, both of ready jobs a and b: is a better? Policy 1: older
note admission. Policy 2: larger unblock value, then smaller declared
note estimate, then older admission (admission orders are unique, so there
note is never a tie).
fn sp_better goal bool a ulong b ulong to bool
if goal
va = get sjval a
vb = get sjval b
if ne va vb
ret gt va vb
end
ea = get sjest a
eb = get sjest b
if ne ea eb
ret lt ea eb
end
end
ret lt get sjarr a get sjarr b
end

note A committed change that can alter an unblock value: a job becomes
note ready, a waiting job is admitted, a waiting or ready job is cancelled,
note or a declaration changes. Bumps the graph version, which makes any
note proposal stale (rejected when next used). Nothing is rescored here:
note the next policy-2 pick rescores once, however many bumps came before
note it (coalesced).
fn sp_bump to void
put scgv 0 add get scgv 0 1
put scgst 2 add get scgst 2 1
end

note Unblock value of ready job j, in jobs: the waiting jobs whose deps meet
note the topics j declares it unblocks (depth 1), plus the waiting jobs whose
note deps meet the topics those declare (depth 2), each counted once. Reads
note at most 128 slots.
fn sp_value j ulong to ulong
pro = get sjpro j
if eq pro 0
ret 0
end
n = ulong 0
m = ulong 0
p2 = ulong 0
for k ulong 64
if eq get sjst k 1
if ne and get sjdep k pro 0
m = or m shl ulong 1 k
p2 = or p2 get sjpro k
n = add n 1
end
end
end
put scgst 6 add get scgst 6 64
if eq p2 0
ret n
end
for k ulong 64
if eq get sjst k 1
if eq and shr m k 1 0
if ne and get sjdep k p2 0
n = add n 1
end
end
end
end
put scgst 6 add get scgst 6 64
ret n
end

note Recompute the unblock value of every ready job when the graph version
note moved since the last scoring; otherwise nothing.
fn sp_rescore to void
v = get scgv 0
if eq get scgv 1 v
ret
end
for j ulong 64
if eq get sjst j 2
put sjval j sp_value j
put scgst 1 add get scgst 1 1
end
end
put scgv 1 v
put scgst 0 add get scgst 0 1
put scgst 6 add get scgst 6 64
end

note The proposed job, when the proposal is for the current graph version
note and the job is still ready and fits beside the reservation (rq); it is
note used once. Otherwise the proposal is dropped as stale: 64.
fn sp_proposal rq ulong to ulong
p = get scgv 2
if eq p 0
ret 64
end
put scgv 2 0
put scst 3 add get scst 3 1
j = sub p 1
if eq get scgv 3 get scgv 0
if eq get sjst j 2
if sp_fits get sjneed j rq
put scgst 7 add get scgst 7 1
ret j
end
end
end
put scgst 4 add get scgst 4 1
ret 64
end

note Creator: declare what job j (waiting or ready) is expected to unblock
note and cost: pro, the topics its completion will publish; est, the work
note estimate in ms (declared, or derived by the caller from measurements);
note unc, its uncertainty in ms (recorded, not used to rank). 0, or -3.
fn sched_goal j ulong pro ulong est ulong unc ulong to long
if ge j 64
ret neg long 3
end
s = get sjst j
if or eq s 0 gt s 2
ret neg long 3
end
put sjpro j pro
put sjest j est
put sjunc j unc
sp_bump
ret 0
end

note Creator: the graph version that proposals must name.
fn sched_version to ulong
ret get scgv 0
end

note Creator, right after sched_new: incarnation n (1..2^24 - 1), distinct
note for every scheduler that may receive proposals meant for another (the
note journal fence, DRA-398). The graph version becomes n * 2^40, which no
note scheduler of another incarnation reaches, and any proposal is dropped.
note 0 or -7.
fn sched_incarnate n ulong to long
if or eq n 0 ge n 16777216
ret neg long 7
end
put scgv 0 shl n 40
put scgv 1 get scgv 0
put scgv 2 0
ret 0
end

note Creator, policy 2: propose the ready job whose id is id for the next
note pick, computed at graph version v (an outside planner, or an
note operator). The proposal names the job, not its slot. Reservations and
note feasibility still come first: it is checked again when used. 0; -9
note stale (v is not the current version); -3 no ready job has that id;
note -8 it does not fit beside the reservation; -7 not policy 2.
fn sched_propose id ulong v ulong to long
if ne get scpol 0 2
ret neg long 7
end
if ne v get scgv 0
put scgst 4 add get scgst 4 1
ret neg long 9
end
j = ulong 64
for k ulong 64
if and eq get sjst k 2 eq get sjid k id
j = k
end
end
if ge j 64
put scgst 5 add get scgst 5 1
ret neg long 3
end
rq = ulong 0
r = get scpol 5
if gt r 0
rq = get sjneed sub r 1
end
if not sp_fits get sjneed j rq
put scgst 5 add get scgst 5 1
ret neg long 8
end
put scgv 2 add j 1
put scgv 3 v
put scgst 3 add get scgst 3 1
ret 0
end

note After a fair dispatch event in which ya - 1 was the youngest admission
note assigned (ya 0: none): every ready job admitted before it was bypassed
note once; with no reservation, the oldest job at the bypass budget is
note reserved. One pass over the table (64 maintenance reads, counter 13).
fn sp_after ya ulong to void
o = ulong 64
nores = eq get scpol 5 0
for j ulong 64
if eq get sjst j 2
if gt ya 0
if lt add get sjarr j 1 ya
put sjbyp j add get sjbyp j 1
put scst 5 add get scst 5 1
end
end
if nores
if ge get sjbyp j get scpol 3
if eq o 64
o = j
else
if lt get sjarr j get sjarr o
o = j
end
end
end
end
end
end
put scst 13 add get scst 13 64
if lt o 64
put scpol 5 add o 1
put scst 6 add get scst 6 1
end
end

note Creator: assign ready jobs to idle live workers under the policy, at
note most the dispatch budget per call. Returns the number assigned.
fn sched_dispatch c long to ulong
if ne get scpause 0 0
ret 0
end
n = mapget c 48 8
k = ulong 0
ya = ulong 0
fair = ge get scpol 0 1
put scst 2 add get scst 2 1
for i ulong get scpol 2 bound 64
w = sp_idle n
if ge w 64
break
end
j = ulong 64
if fair
j = sp_fair
else
j = sp_fifo
end
if ge j 64
break
end
if gt add get sjarr j 1 ya
ya = add get sjarr j 1
end
sp_start c j w
k = add k 1
end
if fair
sp_after ya
end
ret k
end

note Creator: move finished jobs into review while review has room. A worker
note whose result is waiting for room keeps it and gets no new job, so a
note full review queue stops assignment instead of dropping work. A job
note gives back its resources as soon as its worker reported done, even
note while its result waits for room.
fn sched_collect c long to ulong
n = mapget c 48 8
k = ulong 0
for w ulong n bound 64
b = get scbusy w
if gt b 0
if eq sc_cell w 64 get scseq w
j = sub b 1
sp_give j
if ge sched_count 4 4 get sclim 1
continue
end
put sjst j 4
put sjout j sc_cell w 72
put scbusy w 0
k = add k 1
end
end
end
ret k
end

note Creator, after worker w was reaped: retire its unfinished assignment.
note A rerunnable job is ready again; any other becomes UNKNOWN (6), since
note it may have had effects. A finished result is left for sched_collect.
note Returns 1 when an assignment was retired, 0 when none, -16 still live.
fn sched_lost c long w ulong to long
if ge w 64
ret neg long 7
end
if gt get swpid w 0
ret neg long 16
end
b = get scbusy w
if eq b 0
ret 0
end
if eq sc_cell w 64 get scseq w
ret 0
end
j = sub b 1
sc_set w 64 get scseq w
put scbusy w 0
sp_give j
if ne and get sjfl j 1 0
sp_ready j
else
put sjst j 6
end
ret 1
end

note Creator loop step: wait up to interval ns for an ack or a death, take
note acks, retire the jobs of reaped workers, collect, then dispatch.
note Returns the number of workers reaped, or a negative errno.
fn sched_step c long interval long to long
d = sup_poll c interval
if lt d 0
ret d
end
n = mapget c 48 8
for w ulong n bound 64
if gt get swpid w 0
r = sup_take get swack w
else
r = sched_lost c w
end
end
k = sched_collect c
k = sched_dispatch c
ret d
end

note Creator: publish an artifact, make waiting jobs whose deps meet topics
note ready, wake each live worker whose interest meets topics, dispatch.
note Returns the version, or the publish refusal with nothing woken.
fn sched_publish c long topics ulong src view uchar 4096 n ulong to long
v = pool_publish c topics src n
if le v 0
ret v
end
for j ulong 64
if eq get sjst j 1
if ne and get sjdep j topics 0
sp_ready j
end
end
end
m = mapget c 48 8
for w ulong m bound 64
if gt get swpid w 0
if ne and sc_cell w 32 topics 0
sc_wake w
end
end
end
k = sched_dispatch c
ret v
end

note Creator: accept the result of job j in review and free its slot.
note Returns its outcome, or -3 when j is not in review.
fn sched_review j ulong to long
if ge j 64
ret neg long 3
end
if ne get sjst j 4
ret neg long 3
end
put sjst j 0
ret long get sjout j
end

note Creator: free an UNKNOWN job once its outcome has been settled
note elsewhere. Returns 0, or -3 when j is not UNKNOWN.
fn sched_settle j ulong to long
if ge j 64
ret neg long 3
end
if ne get sjst j 6
ret neg long 3
end
put sjst j 0
ret 0
end

note Creator: while paused (on true) no job is assigned; running jobs go on
note and finished results are still collected. Resuming dispatches at once.
note Returns the number assigned on resume, else 0.
fn sched_pause c long on bool to ulong
if on
put scpause 0 1
ret 0
end
put scpause 0 0
ret sched_dispatch c
end

note Creator: cancel job j. A waiting or ready job never started, so it is
note freed with no effect: 1. A running job needs its worker: 2, and the
note outcome comes from the worker. A job in review already finished: 3,
note nothing is cancelled. UNKNOWN stays UNKNOWN: 4. -3 free or bad slot.
fn sched_cancel j ulong to long
if ge j 64
ret neg long 3
end
s = get sjst j
if or eq s 1 eq s 2
put sjst j 0
sp_bump
if eq get scpol 5 add j 1
put scpol 5 0
end
ret 1
end
if eq s 3
ret 2
end
if eq s 4
ret 3
end
if eq s 6
ret 4
end
ret neg long 3
end

note Creator: stop every worker within interval ns (sup_stop), retire the
note assignments of the reaped workers, collect finished results.
note Returns how many workers had to be killed, or a refusal.
fn sched_stop c long interval long to long
k = sup_stop c interval
if lt k 0
ret k
end
n = mapget c 48 8
for w ulong n bound 64
r = sched_lost c w
end
m = sched_collect c
ret k
end

note Worker w: the assignment seq when a job is waiting, else 0. Job id,
note input epoch and input version are words 8, 16 and 24 of its cell.
fn sched_wjob w ulong to ulong
q = sc_cell w 0
if gt q sc_cell w 64
ret q
end
ret 0
end

note Worker w: finish assignment q with outcome and the first n (at most
note 4096) bytes of src. Bytes and outcome are written before the done seq;
note then the creator gets an ack. 0, -7 bad n, or the ack refusal.
fn sched_wdone w ulong q ulong outcome ulong src view uchar 4096 n ulong to long
if gt n 4096
ret neg long 7
end
if gt n 0
r = mapwrite get scmap 1 mul w 4096 src 0 n
end
sc_set w 72 outcome
sc_set w 64 q
ret sup_ack w
end

note Creator: copy worker w's last result bytes into dst.
fn sched_result w ulong dst edit uchar 4096 to long
ret mapread get scmap 1 mul w 4096 dst 0 4096
end

note Worker w: sup_wwait that records its wakes and wake latency.
fn sched_wwait c long w ulong interval long to long
r = sup_wwait c w interval
if eq r 1
now = ulong monons
st = sc_cell w 40
lat = ulong 0
if gt now st
lat = sub now st
end
sc_set w 80 add sc_cell w 80 1
sc_set w 88 lat
if gt lat sc_cell w 96
sc_set w 96 lat
end
end
ret r
end

note Worker w: count the versions of the current epoch that meet its
note interest and are newer than its cursor, moving the cursor past them.
note A new epoch restarts the cursor at 0. A worker with no interest scans
note nothing. Returns the count or a refusal.
fn sched_wscan c long w ulong to long
t = sc_cell w 32
if eq t 0
ret 0
end
h = pool_acquire c w
if le h 0
ret h
end
e = mapget c add 256 mul w 8 8
if ne get swcur 0 e
put swcur 0 e
put swcur 1 0
end
k = long 0
for i ulong 65
v = node_next h get swcur 1 t
if lt v 0
r = pool_release c w
ret v
end
if eq v 0
break
end
put swcur 1 ulong v
k = add k 1
end
r = pool_release c w
ret k
end
note Concatenate after transport.om, pool.om, super.om and sched.om. CPU-only
note acceptance of the resource-aware selection policy (P-DRA-14) with real
note forked workers: impossible requests, the capacity invariant under churn,
note ready order, the head-of-line scenarios of the reference pump
note (aien-sovereign-core-mv spark-harness scheduler/core.rs Core::pump),
note starvation under repeated small arrivals, admission tickets, lease
note expiry and cancellation of a reserved job.
note After every creator step the test checks that no kind is used beyond its
note capacity and that the use equals the needs of the jobs holding them.
note Argument "fifo" runs policy 0, "noreserve" policy 1 with the bypass
note budget out of reach: the negative controls. No GPU, model or network.
text pok "PASS node schedpol\n"
text pst "schedpol events="
text pex " examined="
text pas " assigned="
text phol " hol_stops="
text pbyp " bypasses="
text pres " reservations="
text pnl "\n"
text ptr "schedpol goal trace "
text psp " "
text pw1 "schedpol hol witness head="
text pw2 " fits_behind="
text pw3 " free_cpu="
text pw4 " idle_worker="
global ptc long 1
note Mode: 0 default policy, 1 fifo, 2 noreserve, 3 goal (policy 2).
global ptm ulong 1
note Step-bound snapshot (pt_snap): event count, candidate reads,
note maintenance reads, assigned, cursor, window scans.
global ptb ulong 6
note Phase G trace: ids in review order.
global ptt ulong 16
global ptn ulong 1
note Value-read bound baseline: stats 38, 32, 33 at the last check.
global ptv ulong 3

fn pt_ok ok bool code int to void
if not ok
exit code
end
end

fn pt_num v ulong to void
d = new uchar 20 0
x = v
k = ulong 20
for i ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
r = write 1 d k sub 20 k
end

note Packed request: cpu slots, memory MiB, inference slots, kind 3.
fn pt_req cpu ulong mem ulong inf ulong x ulong to ulong
ret or or cpu shl mem 16 or shl inf 32 shl x 48
end

note Worker: run assignment q for the milliseconds in the low four decimal
note digits of its job id, then report outcome id+1 and 8 bytes. 0 done,
note 2 stopped, 3 creator gone, 4 wait error, 5 report refused.
fn pt_run c long w ulong q ulong to int
buf = new uchar 4096 0
id = sc_cell w 8
dl = add ulong monons mul rem id 10000 1000000
for t ulong 1000000
now = ulong monons
if ge now dl
break
end
r = sched_wwait c w long sub dl now
if eq r 2
ret 2
end
if eq r 3
ret 3
end
if lt r 0
ret 4
end
end
if ne sched_wdone w q add id 1 buf 8 0
ret 5
end
ret 0
end

fn pt_worker w ulong to int
c = get ptc 0
for it ulong 1000000000
q = sched_wjob w
if gt q 0
r = pt_run c w q
if eq r 2
ret 0
end
if ne r 0
ret add 60 r
end
continue
end
r = sched_wwait c w neg long 1
if eq r 2
ret 0
end
if eq r 3
ret 41
end
if lt r 0
ret 43
end
end
ret 45
end

fn pt_spawn c long w ulong to bool
p = sup_spawn c w
if eq p 0
exit pt_worker w
end
ret gt p 0
end

note Fresh pool for w workers (spawned), admission limit a, review limit rl,
note capacities caps. Exits with code on any refusal.
fn pt_setup w ulong a ulong rl ulong caps ulong code int to long
c = pool_new 4 w
pt_ok gt c 0 code
put ptc 0 c
pt_ok eq sup_init c 0 code
pt_ok eq sched_new c a rl 0 code
pt_ok eq sched_cap caps 0 code
put ptv 0 sched_stat 38
put ptv 1 sched_stat 32
put ptv 2 sched_stat 33
if eq get ptm 0 1
pt_ok eq sched_policy 0 64 64 4 1000 0 code
end
if eq get ptm 0 2
pt_ok eq sched_policy 1 64 64 65535 1000 0 code
end
if eq get ptm 0 3
pt_ok eq sched_policy 2 64 64 4 1000 0 code
end
for i ulong w bound 64
pt_ok pt_spawn c i code
end
ret c
end

fn pt_down c long code int to void
pt_ok ge sched_stop c 2000000000 0 code
sup_closeall
pt_ok eq sched_free 0 code
pt_ok eq pool_free c 0 code
end

note The capacity invariant: of each kind the use is at most the capacity
note and equals the sum of the needs of the jobs that hold resources; only
note a running job holds them, and every running job whose worker has not
note reported done holds them.
fn pt_inv code int to void
for j ulong 64
if eq get sjst j 3
w = get sjw j
if ne sc_cell w 64 get scseq w
pt_ok eq get sjheld j 1 code
end
end
end
for k ulong 4
s = ulong 0
for j ulong 64
if eq get sjheld j 1
pt_ok eq get sjst j 3 code
s = add s sp_need get sjneed j k
end
end
pt_ok eq get suse k s code
pt_ok le get suse k get scap k code
end
end

note One creator step of up to 10 ms, then the invariant and the scan
note bounds since the last step. An event makes at most one pick more than
note it assigns, so candidate reads are at most (assigned + events) x
note (window + 1), the reserved probe included, plus one proposal probe per
note pick under policy 2, or x 64 under FIFO (policy 0), 9; maintenance reads
note at most 64 per event, 14; the cursor moved by exactly the window per
note window scan, mod 64, 15 (the traversal witness: window scans cover
note consecutive windows, so ceil(64/win) of them examine every slot); value
note reads at most 64 per rescoring plus 128 per job scored, 8.
fn pt_step c long code int to void
pt_snap
r = sched_step c 10000000
pt_ok ge r 0 code
pt_inv code
pt_check
end

note Snapshot the counters the step bounds compare against (ptb).
fn pt_snap to void
put ptb 0 sched_stat 2
put ptb 1 sched_stat 3
put ptb 2 sched_stat 13
put ptb 3 sched_stat 4
put ptb 4 sched_stat 28
put ptb 5 sched_stat 14
end

note The bounds since pt_snap (exits 9, 14, 15, 8).
fn pt_check to void
w = add sched_stat 25 1
if eq sched_stat 24 0
w = ulong 64
end
if eq sched_stat 24 2
w = add w 1
end
ev = sub sched_stat 2 get ptb 0
lim = mul add sub sched_stat 4 get ptb 3 ev w
pt_ok le sub sched_stat 3 get ptb 1 lim 9
pt_ok le sub sched_stat 13 get ptb 2 mul ev 64 14
pt_cursor get ptb 4 get ptb 5
pt_vbound
end

note Resume dispatch (it dispatches at once) inside the step bounds.
fn pt_resume c long to void
pt_snap
k = sched_pause c false
pt_check
end

note The cursor moved by the window once per window scan since (u0, s0).
fn pt_cursor u0 ulong s0 ulong to void
d = mul sched_stat 25 sub sched_stat 14 s0
pt_ok eq sched_stat 28 rem add u0 d 64 15
end

note The value-read bound since the last call (phase checks, exit 8).
fn pt_vbound to void
v = sched_stat 38
lim = add mul sub sched_stat 32 get ptv 1 64 mul sub sched_stat 33 get ptv 2 128
pt_ok le sub v get ptv 0 lim 8
put ptv 0 v
put ptv 1 sched_stat 32
put ptv 2 sched_stat 33
end

note Step until job j is in a state in lo..hi, up to ms. True when reached.
fn pt_until c long j ulong lo ulong hi ulong ms ulong code int to bool
dl = add ulong monons mul ms 1000000
for t ulong 1000000
s = get sjst j
if and ge s lo le s hi
ret true
end
if ge ulong monons dl
ret false
end
pt_step c code
end
ret false
end

note Review every job in review whose outcome is its id + 1.
fn pt_review code int to ulong
n = ulong 0
for j ulong 64
if eq get sjst j 4
pt_ok eq sched_review j long add get sjid j 1 code
n = add n 1
end
end
ret n
end

note Step and review until n jobs were reviewed, up to ms.
fn pt_drain c long n ulong ms ulong code int to void
dl = add ulong monons mul ms 1000000
k = ulong 0
for t ulong 1000000
k = add k pt_review code
if ge k n
ret
end
pt_ok lt ulong monons dl code
pt_step c code
end
exit code
end

fn pt_admit id ulong deps ulong req ulong code int to ulong
j = sched_admitr id deps 0 req
pt_ok ge j 0 code
ret ulong j
end

note Phase C: a request beyond the capacity of any kind is refused (-8) and
note counted; lowering a capacity below an admitted job's need, or below
note the use of two running jobs that each fit it alone, is refused and
note changes nothing.
fn pt_impossible to void
c = pt_setup 2 8 8 pt_req 4 1024 1 8 30
pt_ok eq sched_admitr 1 0 0 pt_req 5 0 0 0 neg long 8 31
pt_ok eq sched_admitr 2 0 0 pt_req 1 1025 0 0 neg long 8 32
pt_ok eq sched_admitr 3 0 0 pt_req 0 0 2 0 neg long 8 33
pt_ok eq sched_stat 7 3 34
a = pt_admit 4 0 pt_req 3 0 0 0 35
pt_ok eq sched_cap pt_req 2 1024 1 8 neg long 8 36
pt_ok eq sched_stat 16 4 37
pt_ok eq sched_cancel a 1 38
pt_ok eq sched_cap pt_req 2 1024 1 8 0 39
pt_ok eq sched_stat 16 2 40
pt_ok eq sched_cap pt_req 4 1024 1 8 0 130
p = pt_admit 130400 0 pt_req 2 0 0 0 130
q = pt_admit 140400 0 pt_req 2 0 0 0 130
pt_ok pt_until c p 3 3 2000 130 130
pt_ok pt_until c q 3 3 2000 130 130
pt_ok eq sched_cap pt_req 3 1024 1 8 neg long 8 131
pt_ok eq sched_stat 16 4 132
pt_drain c 2 3000 133
pt_ok eq sched_cap pt_req 3 1024 1 8 0 134
pt_down c 41
end

note Phase D: 12 jobs with mixed CPU, memory and inference needs on three
note workers, capacities 4 CPU, 1024 MiB, 1 inference slot. Every job runs
note once and returns its outcome; the invariant holds at every step and
note every resource is free at the end.
fn pt_churn to void
c = pt_setup 3 16 8 pt_req 4 1024 1 0 42
for i ulong 12
cpu = add rem i 3 1
mem = mul add rem i 6 1 100
inf = rem i 2
id = add mul add i 1 10000 add 30 mul rem i 4 15
j = pt_admit id 0 pt_req cpu mem inf 0 43
end
pt_drain c 12 10000 44
for k ulong 4
pt_ok eq get suse k 0 45
end
pt_ok eq sched_count 1 6 0 46
pt_ok eq sched_stat 4 12 47
pt_down c 48
end

note Some running job whose worker has reported done (its result waits
note for review room).
fn pt_held to bool
for j ulong 64
if eq get sjst j 3
w = get sjw j
if eq sc_cell w 64 get scseq w
ret true
end
end
end
ret false
end

note Phase V: release while review is full. Review limit 1, two workers,
note 2 CPU: j1 and j2 (1 CPU, 50 ms) both finish; one enters review, the
note other's result waits for room, yet both CPUs are free at once and j3
note (2 CPU) runs before anything is reviewed.
fn pt_release to void
c = pt_setup 2 8 1 pt_req 2 1024 1 8 120
j1 = pt_admit 150050 0 pt_req 1 0 0 0 120
j2 = pt_admit 160050 0 pt_req 1 0 0 0 120
dl = add ulong monons 2000000000
for t ulong 1000000
if eq sched_count 4 4 1
if pt_held
break
end
end
pt_ok lt ulong monons dl 121
pt_step c 121
end
note The done report may land after the last collect: one more step
note collects it (review stays full, so nothing else changes).
pt_step c 121
pt_ok eq get suse 0 0 122
j3 = pt_admit 170050 0 pt_req 2 0 0 0 123
pt_ok pt_until c j3 3 4 2000 123 124
pt_drain c 3 3000 125
pt_down c 126
end

note Phase F: ready order. With one worker, x is admitted first waiting on
note topic 8 and y second ready at once; then topic 8 is published. FIFO
note (policy 0) serves the job that became ready first, y; fair fitting
note serves the job admitted first, x (waiting age counts from admission).
fn pt_order to void
buf = new uchar 4096 0
c = pt_setup 1 8 8 pt_req 4 1024 1 8 50
x = pt_admit 60050 8 0 51
y = pt_admit 70050 0 0 52
pt_snap
pt_ok gt sched_publish c 8 buf 16 0 53
pt_check
if eq sched_stat 24 0
pt_ok eq get sjst y 3 54
pt_ok eq get sjst x 2 55
else
pt_ok eq get sjst x 3 54
pt_ok eq get sjst y 2 55
end
pt_drain c 2 3000 56
pt_down c 57
end

note Witness of a head-of-line block, read with no step in between: a runs
note unfinished holding its need, the head h is ready and does not fit, x
note is ready and fits, a live worker is idle, and dispatch stopped at the
note head at least once since h0 (codes code..code+4 when not).
fn pt_witness c long a ulong h ulong x ulong h0 ulong code int to void
w = get sjw a
pt_ok eq get sjst a 3 code
pt_ok ne sc_cell w 64 get scseq w code
pt_ok eq get sjheld a 1 code
pt_ok eq get sjst h 2 add code 1
pt_ok not sp_fits get sjneed h 0 add code 1
pt_ok eq get sjst x 2 add code 2
pt_ok sp_fits get sjneed x 0 add code 2
i = sp_idle mapget c 48 8
pt_ok lt i 64 add code 3
pt_ok gt sched_stat 8 h0 add code 4
r = write 1 pw1 0 len pw1
pt_num get sjid h
r = write 1 pw2 0 len pw2
pt_num get sjid x
r = write 1 pw3 0 len pw3
pt_num sp_free 0
r = write 1 pw4 0 len pw4
pt_num i
r = write 1 phol 0 len phol
pt_num sub sched_stat 8 h0
r = write 1 pnl 0 1
end

note Phase A: the blocked head. a (3 CPU, 800 ms) runs; then b (2 CPU,
note cannot fit) and c (1 CPU, fits) arrive with no dependency. The target:
note c runs while a still runs and b waits (0). When c has not run within
note 400 ms, the witness is checked and printed and the phase returns 11:
note c stayed idle behind b although a CPU and a worker were free.
fn pt_blocked to int
c = pt_setup 3 8 8 pt_req 4 1024 1 8 10
a = pt_admit 10800 0 pt_req 3 0 0 0 10
pt_ok pt_until c a 3 3 2000 10 10
b = pt_admit 20050 0 pt_req 2 0 0 0 10
x = pt_admit 30050 0 pt_req 1 0 0 0 10
h0 = sched_stat 8
v = int 0
if pt_until c x 3 4 400 10
pt_ok eq get sjst a 3 12
pt_ok eq get sjst b 2 13
else
pt_witness c a b x h0 12
v = int 11
end
pt_drain c 3 5000 17
pt_down c 18
ret v
end

note Phase B: a second head-of-line case, after the pump's queue-of-two
note scenario (the bounded queue itself is not modelled: every admitted
note job is in the table). a (3 CPU, 800 ms) runs, b and d (2 CPU) cannot
note fit, e (1 CPU) fits. Target: e runs while a still runs (0); else the
note witness and 21.
fn pt_exclude to int
c = pt_setup 3 8 8 pt_req 4 1024 1 8 20
a = pt_admit 10800 0 pt_req 3 0 0 0 20
pt_ok pt_until c a 3 3 2000 20 20
b = pt_admit 20050 0 pt_req 2 0 0 0 20
d = pt_admit 40050 0 pt_req 2 0 0 0 20
e = pt_admit 50050 0 pt_req 1 0 0 0 20
h0 = sched_stat 8
v = int 0
if pt_until c e 3 4 400 20
pt_ok eq get sjst a 3 22
else
pt_witness c a b e h0 22
v = int 21
end
pt_drain c 4 5000 27
pt_down c 28
ret v
end

note Phase S: starvation under repeated small arrivals. Three workers, 4
note CPU. Small jobs (1 CPU) start staggered (100, 200, 300 ms), and each
note that finishes is replaced by one of 300 ms, so the small jobs never
note all end together; big (4 CPU, 50 ms) needs every CPU free. The target:
note big runs within 4 s. 61 means it never did: the small jobs kept the
note CPU partly busy (the "noreserve" control).
fn pt_starve to void
c = pt_setup 3 16 8 pt_req 4 1024 1 8 60
for i ulong 3
j = pt_admit mul add i 1 100100 0 pt_req 1 0 0 0 60
end
s = ulong 4
g = pt_admit 90050 0 pt_req 4 0 0 0 60
dl = add ulong monons 4000000000
ok = false
for t ulong 1000000
if ge get sjst g 3
ok = true
break
end
if ge ulong monons dl
break
end
if lt sched_count 1 3 4
j = pt_admit add mul s 100000 300 0 pt_req 1 0 0 0 60
s = add s 1
end
pt_step c 60
n = pt_review 60
end
pt_ok ok 61
pt_ok ge sched_stat 6 1 62
pt_ok ge sched_stat 9 1 63
pt_drain c sched_count 1 4 5000 64
pt_stats
pt_ok eq get suse 0 0 65
pt_down c 66
end

note Phase Q: admission tickets. Limit 2: p1 (400 ms) and p2 (900 ms) fill
note it; X then Y are refused and hold tickets in that order. When p1 is
note reviewed there is room for one: Y asking first is refused (75), X is
note admitted (76); Y enters once more room returns (78). A ticket not
note asked about for the lifetime (20 events) lapses, so a new caller is
note admitted although the old holder never came back (80).
fn pt_tickets to void
c = pt_setup 2 2 8 pt_req 4 1024 1 8 70
pt_ok eq sched_policy sched_stat 24 64 64 sched_stat 27 1000 0 70
p1 = pt_admit 100400 0 0 70
p2 = pt_admit 110900 0 0 70
pt_ok eq sched_admitr 120050 0 0 0 neg long 2 71
pt_ok eq sched_admitr 130050 0 0 0 neg long 2 72
pt_ok eq sched_stat 30 2 73
pt_drain c 1 3000 74
pt_ok eq sched_admitr 130050 0 0 0 neg long 2 75
pt_ok ge sched_admitr 120050 0 0 0 0 76
pt_drain c 2 3000 77
pt_ok ge sched_admitr 130050 0 0 0 0 78
pt_ok eq sched_policy sched_stat 24 64 64 sched_stat 27 20 0 79
f = pt_admit 140900 0 0 79
pt_ok eq sched_admitr 150050 0 0 0 neg long 2 79
e0 = sched_stat 2
dl = add ulong monons 3000000000
for t ulong 1000000
if le sched_count 1 3 1
if gt sched_stat 2 add e0 21
break
end
end
pt_ok lt ulong monons dl 79
pt_step c 79
n = pt_review 79
end
pt_ok ge sched_admitr 160050 0 0 0 0 80
pt_ok ge sched_stat 11 1 80
pt_drain c 2 3000 80
pt_down c 80
end

note Step until sched_overdue reports a job, up to 2 s: its slot, or 64.
fn pt_waitod c long code int to ulong
t0 = ulong monons
for t ulong 1000000
o = sched_overdue
if lt o 64
ret o
end
if gt sub ulong monons t0 2000000000
ret 64
end
pt_step c code
end
ret 64
end

note Phase L: lease expiry. h (2 of 2 CPU, 3 s, not safe to rerun) has a
note 200 ms lease: its deadline is at least 200 ms after h was admitted, and
note sched_overdue reports it once, at or after that deadline (83); the
note creator kills its worker; h becomes UNKNOWN and its CPU is free.
note h2 (2 CPU, 400 ms, safe to rerun, 100 ms lease) is killed the same
note way: it is ready or running again with its admission age kept, and
note completes. Then a new 2-CPU job runs.
fn pt_lease to void
c = pt_setup 3 8 8 pt_req 2 1024 1 8 81
t0 = ulong monons
h = pt_admit 173000 0 pt_req 2 0 0 0 81
pt_ok eq sched_lease h 200000000 0 81
pt_ok pt_until c h 3 3 2000 81 81
due = get sjdue h
pt_ok ge due add t0 200000000 83
o = pt_waitod c 82
pt_ok eq o h 82
pt_ok ge ulong monons due 83
pt_ok eq sched_overdue 64 84
r = killpid int get swpid get sjw h 9
pt_ok pt_until c h 6 6 2000 85 85
pt_ok eq get suse 0 0 86
pt_ok eq sched_settle h 0 87
x = sched_admitr 180400 0 1 pt_req 2 0 0 0
pt_ok ge x 0 140
h2 = ulong x
pt_ok eq sched_lease h2 100000000 0 140
pt_ok pt_until c h2 3 3 2000 140 140
ar = get sjarr h2
pt_ok eq pt_waitod c 141 h2 141
w = get sjw h2
r = killpid int get swpid w 9
dl = add ulong monons 2000000000
for t ulong 1000000
if eq get swpid w 0
break
end
pt_ok lt ulong monons dl 142
pt_step c 142
end
pt_ok eq get sjarr h2 ar 143
s = get sjst h2
pt_ok and ge s 2 le s 3 144
pt_drain c 1 3000 145
z = pt_admit 190050 0 pt_req 2 0 0 0 88
pt_drain c 1 3000 88
pt_down c 89
end

note Phase R: cancellation of a reserved job. Bypass budget 1: a (1 of 2
note CPU) runs, b (2 CPU) waits, x (1 CPU) runs past it, so b is reserved.
note Cancelling b frees it with no effect and clears the reservation.
fn pt_rcancel to void
c = pt_setup 2 8 8 pt_req 2 1024 1 8 90
pt_ok eq sched_policy sched_stat 24 64 64 1 1000 0 90
a = pt_admit 190600 0 pt_req 1 0 0 0 90
pt_ok pt_until c a 3 3 2000 90 90
b = pt_admit 200050 0 pt_req 2 0 0 0 90
x = pt_admit 210050 0 pt_req 1 0 0 0 90
pt_ok pt_until c x 3 4 400 90 91
pt_ok eq sched_stat 29 add b 1 92
pt_ok eq sched_cancel b 1 93
pt_ok eq sched_stat 29 0 94
pt_drain c 2 3000 95
pt_ok eq get suse 0 0 96
pt_down c 97
end

note Phase W: bounded candidate work. Window 4 slots, dispatch budget 2,
note two workers, so an event may pick twice: 12 ready jobs fill slots
note 0..11, beyond any one window. Each pick reads at most 5 slots (the
note reserved probe and the window, exit 9), every window scan moves the
note cursor on by 4 (15), and all 12 run. 101 means some never did.
fn pt_window to void
c = pt_setup 2 16 16 pt_req 4 1024 1 8 101
pt_ok eq sched_policy sched_stat 24 4 2 sched_stat 27 1000 0 101
for i ulong 12
j = pt_admit add mul add i 1 10000 30 0 0 101
end
pt_drain c 12 5000 101
pt_ok eq sched_stat 4 12 102
pt_down c 103
end

note Phase T: ticket order with several openings. Limit 3 held by p1, p2
note (400 ms) and p3, which waits on a topic nobody publishes; X, Y, Z are
note refused in that order and hold tickets (104). p1 and p2 are reviewed,
note so there are exactly two openings: Y asking first is refused (105), and
note so is a new caller W, who takes a ticket behind Z (106); X enters
note (107), then Y (108). p3 is cancelled and X and Y are reviewed, so there
note are three openings: W asking first is refused, then Z and W enter (109).
fn pt_torder to void
c = pt_setup 3 3 8 pt_req 4 1024 1 8 104
p = pt_admit 400400 0 0 104
p = pt_admit 410400 0 0 104
p3 = pt_admit 420050 4096 0 104
pt_ok eq sched_admitr 430050 0 0 0 neg long 2 104
pt_ok eq sched_admitr 440050 0 0 0 neg long 2 104
pt_ok eq sched_admitr 450050 0 0 0 neg long 2 104
pt_ok eq sched_stat 30 3 104
pt_drain c 2 3000 104
pt_ok eq sched_admitr 440050 0 0 0 neg long 2 105
pt_ok eq sched_admitr 460050 0 0 0 neg long 2 106
pt_ok eq sched_stat 30 4 106
pt_ok ge sched_admitr 430050 0 0 0 0 107
pt_ok ge sched_admitr 440050 0 0 0 0 108
pt_ok eq sched_cancel p3 1 108
pt_drain c 2 3000 108
pt_ok eq sched_admitr 460050 0 0 0 neg long 2 109
pt_ok ge sched_admitr 450050 0 0 0 0 109
pt_ok ge sched_admitr 460050 0 0 0 0 109
pt_drain c 2 3000 109
pt_down c 109
end

note Phase X: the table, not the admission limit, is full. Admission limit
note and review limit 64; 64 jobs finish and wait in review, so none is
note admitted, waiting, ready or running. A new caller is refused and takes
note a ticket (190, 191), as is a second (192). One review frees one slot:
note the second holder is refused, the first enters (193, 194).
fn pt_slots to void
c = pt_setup 3 64 64 pt_req 4 1024 1 8 190
for i ulong 64
j = pt_admit add 500001 mul i 10000 0 0 190
end
dl = add ulong monons 5000000000
for t ulong 1000000
if eq sched_count 4 4 64
break
end
pt_ok lt ulong monons dl 190
pt_step c 190
end
pt_ok not sched_room 600050 191
pt_ok eq sched_stat 30 1 191
pt_ok eq sched_admitr 600050 0 0 0 neg long 2 192
pt_ok eq sched_admitr 610050 0 0 0 neg long 2 192
pt_ok eq sched_stat 30 2 192
pt_ok eq sched_review 0 long add get sjid 0 1 193
pt_ok eq sched_admitr 610050 0 0 0 neg long 2 193
pt_ok ge sched_admitr 600050 0 0 0 0 194
n = pt_review 194
pt_ok ge sched_admitr 610050 0 0 0 0 194
pt_drain c 2 3000 194
pt_down c 194
end

note Phase Z: reserved progress needs review progress. Review limit 1, two
note workers, 2 CPU, bypass budget 1. p finishes and waits in review,
note unreviewed. a (1 CPU) and x (1 CPU) run past b (2 CPU), so b is
note reserved (196). a and x finish; their workers keep the results, since
note review is full, so b is ready at every step for 600 ms (197) and all
note CPU is free at the end of that interval (198). Reviewing p lets a into
note review, frees its worker, and b runs (199).
fn pt_live to void
c = pt_setup 2 8 1 pt_req 2 1024 1 8 195
pt_ok eq sched_policy sched_stat 24 64 64 1 1000 0 195
p = pt_admit 470050 0 pt_req 1 0 0 0 195
pt_ok pt_until c p 4 4 2000 195 195
k = sched_pause c true
a = pt_admit 480050 0 pt_req 1 0 0 0 195
b = pt_admit 490050 0 pt_req 2 0 0 0 195
x = pt_admit 510050 0 pt_req 1 0 0 0 195
pt_resume c
pt_ok eq sched_stat 29 add b 1 196
dl = add ulong monons 600000000
for t ulong 1000000
if ge ulong monons dl
break
end
pt_step c 197
pt_ok eq get sjst b 2 197
end
pt_ok eq get suse 0 0 198
pt_ok eq sched_review p long add get sjid p 1 199
pt_ok pt_until c b 3 4 2000 199 199
pt_drain c 3 3000 199
pt_down c 199
end

fn pt_mode to void
a = new uchar 16 0
if ne argcnt 2
ret
end
n = argread 1 a 0 16
if eq n 4
if eq get a 0 102
put ptm 0 1
end
if eq get a 0 103
put ptm 0 3
end
end
if eq n 9
put ptm 0 2
end
end

note Step, then review every job in review in slot order, appending its id
note to the trace and publishing the topics it declared (as the workflow
note does after accepting a result).
fn pt_gstep c long buf edit uchar 4096 code int to void
pt_step c code
for j ulong 64
if eq get sjst j 4
p = get sjpro j
n = get ptn 0
if lt n 16
put ptt n get sjid j
end
put ptn 0 add n 1
pt_ok eq sched_review j long add get sjid j 1 code
if ne p 0
pt_snap
pt_ok gt sched_publish c p buf 16 0 code
pt_check
end
end
end
end

fn pt_gadmit id ulong deps ulong pro ulong code int to ulong
j = pt_admit id deps pt_req 1 0 0 0 code
if ne pro 0
pt_ok eq sched_goal j pro 50 10 0 code
end
ret j
end

note One run of the goal workload, one worker, policy 2, bypass budget 4,
note admitted while paused: x (no value), z (unblocks d: value 1), a
note (unblocks b, which unblocks c: value 2), f (unblocks g1..g3: value 3).
note A decision is made when the worker frees, before the finished job's
note topics are published. Order: f a z b x d c g1 g2 g3. f and a first
note (useful work); x, bypassed in 4 events, is reserved and runs 5th.
fn pt_grun code int to void
buf = new uchar 4096 0
c = pt_setup 1 16 16 pt_req 1 1024 1 8 code
pt_ok eq sched_policy 2 64 64 4 1000 0 code
k = sched_pause c true
put ptn 0 0
j = pt_gadmit 220050 0 0 code
j = pt_gadmit 230050 0 128 code
j = pt_gadmit 240050 128 0 code
j = pt_gadmit 250050 0 32 code
j = pt_gadmit 260050 32 64 code
j = pt_gadmit 270050 64 0 code
j = pt_gadmit 280050 0 256 code
for i ulong 3
j = pt_gadmit add 290050 mul i 10000 256 0 code
end
pt_resume c
dl = add ulong monons 5000000000
for t ulong 1000000
if ge get ptn 0 10
break
end
pt_ok lt ulong monons dl code
pt_gstep c buf code
end
pt_down c code
end

note Phase G: goal-aware ranking. The goal workload runs twice; both traces
note must equal the expected order (151 first run, 152 second): repeated
note identical inputs, identical decisions.
fn pt_goal to void
ex = new ulong 10 0
put ex 0 280050
put ex 1 250050
put ex 2 230050
put ex 3 260050
put ex 4 220050
put ex 5 240050
put ex 6 270050
put ex 7 290050
put ex 8 300050
put ex 9 310050
for r ulong 2
code = int add 151 r
pt_grun 150
pt_ok eq get ptn 0 10 code
for i ulong 10
if ne get ptt i get ex i
pt_trace
exit code
end
end
end
end

fn pt_trace to void
r = write 1 ptr 0 len ptr
for i ulong get ptn 0 bound 16
pt_num get ptt i
r = write 1 psp 0 1
end
r = write 1 pnl 0 1
end

note Phase H: rescoring. Policy 2, paused: one ready job r and two jobs
note waiting on topic 512, then r declares topic 512: four graph changes,
note no rescoring (160). The first pick rescores once for all four (161).
note r completing and being reviewed with nothing published changes no
note value: no rescoring (162). Publishing 512 readies both waiting jobs:
note two changes, one more rescoring at the next pick (163). The work of
note every rescoring is bounded (checked at each step, exit 8). Cancelling
note a waiting job is one more change (165).
fn pt_rescores to void
buf = new uchar 4096 0
c = pt_setup 1 8 8 pt_req 4 1024 1 8 160
pt_ok eq sched_policy 2 64 64 4 1000 0 160
k = sched_pause c true
r = pt_admit 320050 0 pt_req 1 0 0 0 160
w1 = pt_admit 330050 512 pt_req 1 0 0 0 160
w2 = pt_admit 340050 512 pt_req 1 0 0 0 160
pt_ok eq sched_goal r 512 50 10 0 160
pt_ok eq sched_stat 34 4 160
pt_ok eq sched_stat 32 0 160
pt_resume c
pt_ok eq sched_stat 32 1 161
pt_ok eq get sjval r 2 161
pt_drain c 1 2000 162
pt_ok eq sched_stat 32 1 162
pt_ok eq sched_stat 34 4 162
pt_snap
pt_ok gt sched_publish c 512 buf 16 0 163
pt_check
pt_ok eq sched_stat 34 6 163
pt_ok eq sched_stat 32 2 163
pt_drain c 2 2000 164
pt_ok eq sched_stat 32 2 165
w3 = pt_admit 345050 4096 pt_req 1 0 0 0 165
b0 = sched_stat 34
pt_ok eq sched_cancel w3 1 165
pt_ok eq sched_stat 34 add b0 1 165
pt_down c 166
end

note Phase K: the policy-2 key on two free slots, a and b. Larger unblock
note value first, even when b is older and cheaper (180); equal values:
note smaller estimate first, even when b is older (181); equal values and
note estimates: older admission first (182); outside policy 2 only the
note admission age counts (183).
fn pt_key to void
a = ulong 60
b = ulong 61
put sjval a 2
put sjval b 1
put sjest a 90
put sjest b 10
put sjarr a 9
put sjarr b 8
pt_ok sp_better true a b 180
pt_ok not sp_better true b a 180
put sjval b 2
put sjest a 10
put sjest b 90
pt_ok sp_better true a b 181
pt_ok not sp_better true b a 181
put sjest b 10
pt_ok sp_better true b a 182
pt_ok not sp_better true a b 182
put sjval a 5
put sjest b 1
pt_ok sp_better false b a 183
pt_ok not sp_better false a b 183
for i ulong 2
put sjval add a i 0
put sjest add a i 0
put sjarr add a i 0
end
end

note Phase P: proposals. Policy 2, paused. p1 (value 0) and p2 (value 1)
note are ready. A proposal naming an older graph version is refused (170)
note and counted (171); one naming an id with no ready job is refused
note (172); p1 at the current version is accepted (173) and used over the
note higher ranked p2 (174). A proposal made stale by a later change is
note rejected when next used and counted: p3 runs by rank, after p2 (175,
note 176). Outside policy 2: -7 (177).
fn pt_proposals to void
c = pt_setup 1 8 8 pt_req 4 1024 1 8 170
pt_ok eq sched_policy 2 64 64 4 1000 0 170
k = sched_pause c true
p1 = pt_admit 350050 0 pt_req 1 0 0 0 170
p2 = pt_admit 360050 0 pt_req 1 0 0 0 170
q = pt_admit 370050 1024 pt_req 1 0 0 0 170
pt_ok eq sched_goal p2 1024 50 10 0 170
v = sched_version
p3 = pt_admit 380050 0 pt_req 1 0 0 0 170
pt_ok eq sched_propose 350050 v neg long 9 170
pt_ok eq sched_stat 36 1 171
v = sched_version
pt_ok eq sched_propose 999999 v neg long 3 172
pt_ok eq sched_propose 350050 v 0 173
pt_resume c
pt_ok eq get sjst p1 3 174
pt_ok eq sched_stat 39 1 174
k = sched_pause c true
v = sched_version
pt_ok eq sched_propose 380050 v 0 175
p4 = pt_admit 390050 2048 pt_req 1 0 0 0 175
pt_ok eq sched_goal p3 0 10 1 0 175
pt_resume c
pt_ok pt_until c p2 3 4 2000 175 175
pt_ok eq get sjst p3 2 176
pt_ok eq sched_stat 39 1 176
pt_ok eq sched_stat 36 2 176
pt_ok eq sched_cancel p4 1 176
pt_ok eq sched_cancel q 1 176
pt_drain c 3 3000 176
pt_ok eq sched_policy 1 64 64 4 1000 0 177
pt_ok eq sched_propose 350050 sched_version neg long 7 177
pt_down c 178
end

note Phase I: a proposal from an earlier scheduler. Scheduler 1
note (incarnation 1) admits a into slot 0 and hands out the version;
note scheduler 2 (incarnation 2) admits b into slot 0 with as many bumps.
note There the old version is stale (184); a's id names no job even at the
note current version, b's is accepted, and incarnation 0 is refused (185).
fn pt_incarn to void
c = pt_setup 1 8 8 pt_req 4 1024 1 8 184
pt_ok eq sched_incarnate 1 0 184
pt_ok eq sched_policy 2 64 64 4 1000 0 184
k = sched_pause c true
a = pt_admit 670050 0 pt_req 1 0 0 0 184
pt_ok eq a 0 184
v1 = sched_version
pt_ok eq sched_cancel a 1 184
pt_down c 184
c = pt_setup 1 8 8 pt_req 4 1024 1 8 184
pt_ok eq sched_incarnate 2 0 184
pt_ok eq sched_policy 2 64 64 4 1000 0 184
k = sched_pause c true
b = pt_admit 680050 0 pt_req 1 0 0 0 184
pt_ok eq b 0 184
pt_ok eq sched_propose 670050 v1 neg long 9 184
pt_ok eq sched_propose 670050 sched_version neg long 3 185
pt_ok eq sched_propose 680050 sched_version 0 185
pt_ok eq sched_incarnate 0 neg long 7 185
pt_ok eq sched_cancel b 1 185
pt_down c 185
end

note Phase R2: a proposal beside a reservation. Policy 2, bypass budget 1,
note two workers, 5 CPU. h (2 CPU, 5 s) runs; then B and B2 (4 CPU each)
note and s1 (1 CPU, 1.5 s) are admitted: s1 runs, B and B2 are bypassed and
note B, the older, is reserved. x (2 CPU) is refused beside it and counted
note (186). Cancelling B clears the reservation and x is accepted (187).
note An event with no idle worker reserves B2 and leaves the proposal
note pending (188). Once s1 is done, the next pick finds x no longer fits
note beside B2: the proposal is dropped and counted stale, and x does not
note run (189). Once h is done B2 fits; y (1 CPU) is accepted beside it,
note and at the next event B2 runs first, then y is used; x (2 CPU, 0
note left) stays ready and, bypassed by y, is now the reservation (179).
fn pt_propres to void
c = pt_setup 2 8 8 pt_req 5 1024 2 8 186
pt_ok eq sched_policy 2 64 64 1 1000 0 186
k = sched_pause c true
h = pt_admit 625000 0 pt_req 2 0 0 0 186
pt_resume c
k = sched_pause c true
pt_ok eq get sjst h 3 186
b = pt_admit 630050 0 pt_req 4 0 0 0 186
b2 = pt_admit 640050 0 pt_req 4 0 0 0 186
s1 = pt_admit 651500 0 pt_req 1 0 0 0 186
pt_resume c
k = sched_pause c true
pt_ok eq get sjst s1 3 186
pt_ok eq sched_stat 29 add b 1 186
x = pt_admit 660050 0 pt_req 2 0 0 0 186
r0 = sched_stat 37
pt_ok eq sched_propose 660050 sched_version neg long 8 186
pt_ok eq sched_stat 37 add r0 1 186
pt_ok eq sched_cancel b 1 187
pt_ok eq sched_stat 29 0 187
pt_ok eq sched_propose 660050 sched_version 0 187
pt_resume c
k = sched_pause c true
pt_ok eq sched_stat 29 add b2 1 188
pt_ok gt get scgv 2 0 188
pt_ok pt_until c s1 4 4 3000 188 188
s0 = sched_stat 36
pt_resume c
k = sched_pause c true
pt_ok eq sched_stat 36 add s0 1 189
pt_ok eq get sjst x 2 189
pt_ok eq get scgv 2 0 189
y = pt_admit 690050 0 pt_req 1 0 0 0 179
pt_ok pt_until c h 4 4 6000 179 179
pt_ok eq sched_propose 690050 sched_version 0 179
s0 = sched_stat 39
pt_resume c
k = sched_pause c true
pt_ok eq get sjst b2 3 179
pt_ok eq get sjst y 3 179
pt_ok eq sched_stat 39 add s0 1 179
pt_ok eq sched_stat 29 add x 1 179
pt_ok eq get sjst x 2 179
pt_ok eq sched_cancel x 1 179
pt_drain c 4 8000 179
pt_down c 189
end

fn pt_stats to void
r = write 1 pst 0 len pst
pt_num sched_stat 2
r = write 1 pex 0 len pex
pt_num sched_stat 3
r = write 1 pas 0 len pas
pt_num sched_stat 4
r = write 1 phol 0 len phol
pt_num sched_stat 8
r = write 1 pbyp 0 len pbyp
pt_num sched_stat 5
r = write 1 pres 0 len pres
pt_num sched_stat 6
r = write 1 pnl 0 1
end

note The regression phases A and B return their verdict, so both run and
note print their witness; the first failing one is the exit status.
fn main to int
pt_mode
pt_impossible
pt_churn
pt_release
pt_order
ra = pt_blocked
rb = pt_exclude
if ne ra 0
ret ra
end
if ne rb 0
ret rb
end
pt_starve
pt_tickets
pt_lease
pt_rcancel
pt_window
pt_torder
pt_slots
pt_live
pt_goal
pt_rescores
pt_proposals
pt_incarn
pt_propres
pt_key
if ne write 1 pok 0 len pok long len pok
ret 100
end
ret 0
end

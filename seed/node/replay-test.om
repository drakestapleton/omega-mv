note Omega Node durable scheduling-policy replay (DRA-398). Concatenate
note after transport.om, pool.om, super.om, sched.om,
note seed/authority/action.om, journal.om and auth.om.
note A reference creator R runs 10 dispatch events on journal a. A creator
note C runs the same first k events on journal b and dies (77); C2
note recovers journal b and runs the remaining events. Each event resumes
note dispatch once (auth_pause false, then true), then lets every assigned
note job finish and releases them in slot order, so each event ends at a
note quiescent point. Trace record per event (10 words): 0, 1 the ids
note assigned, 2 cursor, 3 reserved job id, 4 fold of (slot, id, bypass
note count) over ready jobs, 5 policy words (with the ticket lifetime), 6
note fold of (id, need, estimate, uncertainty, topics) over waiting and
note ready jobs, 7 capacities, 8 sum of the ready jobs' bypass counts, 9
note state and bypass count of job 7001. C2's state right after recovery
note must equal R's after event k (words 2..9), and the C and C2 trace
note must equal R's.
note Jobs: 14 ready jobs needing 1..3 of 4 CPU, two workers, window 4,
note dispatch budget 2, bypass budget 2, ticket lifetime 777, and job 7001
note (3 CPU) waiting on topic 8, which the creator publishes before event
note 1 (39 if refused), so it is ready, by publication, across the crash.
note Policy 2 adds three waiting jobs, declared topics, estimates and
note uncertainties (one on a waiting job).
note Exits: 10..22 creator checks; per case base b: b R failed, b+1 C did
note not stop at 77, b+2 C2 failed, b+3 recovered state differs, b+4 traces
note differ, b+5 the case would not test replay (no bypass count, a zero
note cursor or job 7001 not ready at the boundary, or no reservation in
note the run), b+6 C3, which
note recovers journal b again after C2, differs from R's final state (or R's
note final cursor equals its boundary cursor, so the check would not see
note C2's FAIR records missing). Mid-event crash
note (90): C' dies right after a dispatch and its PAUSE, before the creator
note collects or releases the jobs it assigned; C2' must see the cursor, reservation and bypass counts of the
note jobs that were not assigned (93; 95 nothing assigned or bypassed, or
note the event moved neither cursor nor reservation, so losing its FAIR
note would go unseen). Records refused (96 a FAIR that repeats the last
note event, 97 a FAIR naming a free slot, 98 an OPEN of another SPVER, 23
note an ADMIT into a held slot, 24 a FAIR assigning and bypassing one slot,
note 26 a FAIR assigning a waiting job, 27 a readiness record for a ready
note job (and a valid one at the last event refused), 25 a FAIR reserving
note a cancelled job, 28 a first FAIR that both assigns and readies).
note Failed journal (40..43): revoke, pause, cancel,
note admission, policy and goal change nothing. 44: a full replay ring
note stops dispatch; 47: and refuses publication. 29: recovery refuses a
note fence past the incarnation range.
text rpja "build/node/rpa/journal"
text rpla "build/node/rpa/lock"
text rpjb "build/node/rpb/journal"
text rplb "build/node/rpb/lock"
text rpda "build/node/rpa"
text rpdb "build/node/rpb"
text rpok "PASS node replay\n"
global rpm long 1
global rpp uchar 128

fn rp_ok ok bool code int to void
if not ok
exit code
end
end

note Path k (0 journal a, 1 lock a, 2 journal b, 3 lock b, 4 dir a, 5 dir
note b) into rpp; its length.
fn rp_path k ulong to ulong
n = ulong 0
if eq k 0
n = len rpja
for i ulong n bound 64
put rpp i get rpja i
end
end
if eq k 1
n = len rpla
for i ulong n bound 64
put rpp i get rpla i
end
end
if eq k 2
n = len rpjb
for i ulong n bound 64
put rpp i get rpjb i
end
end
if eq k 3
n = len rplb
for i ulong n bound 64
put rpp i get rplb i
end
end
if eq k 4
n = len rpda
for i ulong n bound 64
put rpp i get rpda i
end
end
if eq k 5
n = len rpdb
for i ulong n bound 64
put rpp i get rpdb i
end
end
ret n
end

fn rp_clean to void
for k ulong 4
n = rp_path k
r = unlink rpp 0 n
end
end

fn rp_open d ulong ms ulong to ulong
o = new ulong 4 0
put o 0 398
put o 1 7
put o 2 7
put o 3 7
n = rp_path add d 4
p = new uchar 128 0
for i ulong n bound 128
put p i get rpp i
end
ret jn_open p n o ms
end

note The CPU job i (0..13) needs.
fn rp_cpu i ulong to ulong
ret add 1 rem mul i 7 3
end

fn rp_worker c long w ulong to int
out = new uchar 4096 0
for it ulong 1000000000
q = sched_wjob w
if gt q 0
d = sched_wdone w q 2 out 0
end
r = auth_wwait c w neg int 1 1000000000
if or eq r 2 eq r 3
ret 0
end
if eq r 4
t = auth_wctl w
end
if lt r 0
ret 45
end
end
ret 46
end

note Creator on journal d (0 a, 1 b): open it, recover, spawn two workers.
fn rp_setup d ulong to long
c = pool_new 4 2
rp_ok gt c 0 10
rp_ok eq sup_init c 0 11
rp_ok eq sched_new c 32 8 0 12
rp_ok eq auth_new c 0 13
rp_ok eq rp_open d 3000 0 14
rp_ok eq auth_recover c 0 15
for w ulong 2
p = auth_spawn c w
if eq p 0
exit rp_worker c w
end
rp_ok gt p 0 16
end
ret c
end

fn rp_slot id ulong to ulong
for j ulong 64
s = get sjst j
if and eq get sjid j id and ge s 1 le s 2
ret j
end
end
ret 64
end

note A fresh creator: paused, capacities, policy, the jobs and (policy 2)
note the waiting jobs and declarations, all journaled.
fn rp_load c long pol ulong to void
rp_ok ge auth_pause c true 0 17
rp_ok eq jn_cap 4 0 17
rp_ok eq jn_policy pol 4 2 2 777 0 17
for i ulong 14
rp_ok ge jn_admitr add 5000 i 0 0 rp_cpu i 0 18
end
rp_ok ge jn_admitr 7001 8 0 3 0 18
if eq pol 2
for i ulong 3
rp_ok ge jn_admitr add 6000 i shl 1 i 0 0 0 18
end
rp_ok eq jn_goal rp_slot 5003 3 40 5 0 19
rp_ok eq jn_goal rp_slot 5008 4 60 7 0 19
rp_ok eq jn_goal rp_slot 5005 0 10 1 0 19
rp_ok eq jn_goal rp_slot 5011 0 20 3 0 19
rp_ok eq jn_goal rp_slot 6000 0 30 9 0 19
end
end

fn rp_put base ulong e ulong i ulong v ulong to void
r = mapset get rpm 0 mul add add base mul e 10 i 8 8 v
end

fn rp_get base ulong e ulong i ulong to ulong
ret mapget get rpm 0 mul add add base mul e 10 i 8 8
end

note Step until no job runs, then release every finished one, slot order.
fn rp_drive c long to void
dl = add ulong monons 20000000000
for t ulong 100000000
r = sched_step c 5000000
k = auth_step c
busy = false
for j ulong 64
if eq get sjst j 3
busy = true
end
end
if not busy
for j ulong 64
if eq get sjst j 4
rp_ok ge jn_release j 0 21
end
end
ret
end
rp_ok lt ulong monons dl 22
end
end

note Fold of (slot, id, bypass count) over ready jobs other than ids x, y;
note with sum true the sum of those bypass counts instead.
fn rp_fbyp x ulong y ulong sum bool to ulong
h = ulong 1469598103934665603
n = ulong 0
for j ulong 64
id = get sjid j
if and eq get sjst j 2 and ne id x ne id y
n = add n get sjbyp j
h = mul xor h j 1099511628211
h = mul xor h id 1099511628211
h = mul xor h get sjbyp j 1099511628211
end
end
if sum
ret n
end
ret h
end

note Fold of (id, need, estimate, uncertainty, topics) over waiting and
note ready jobs.
fn rp_fjob to ulong
h = ulong 1469598103934665603
for j ulong 64
s = get sjst j
if and ge s 1 le s 4
h = mul xor h get sjid j 1099511628211
h = mul xor h get sjneed j 1099511628211
h = mul xor h get sjest j 1099511628211
h = mul xor h get sjunc j 1099511628211
h = mul xor h get sjpro j 1099511628211
end
end
ret h
end

note Job 7001's state and bypass count, 0 when x or y is 7001 or it is not
note in the table.
fn rp_dep x ulong y ulong to ulong
if or eq x 7001 eq y 7001
ret 0
end
for j ulong 64
if and eq get sjid j 7001 ne get sjst j 0
ret or get sjst j shl get sjbyp j 8
end
end
ret 0
end

fn rp_rid to ulong
r = sched_stat 29
if eq r 0
ret 0
end
ret get sjid sub r 1
end

note Words 2..9 of trace record e (base), x and y excluded from 4, 8, 9.
fn rp_state base ulong e ulong x ulong y ulong to void
rp_put base e 2 sched_stat 28
rp_put base e 3 rp_rid
rp_put base e 4 rp_fbyp x y false
p = or or sched_stat 24 shl sched_stat 25 8 or shl sched_stat 26 16 shl sched_stat 27 24
rp_put base e 5 or p shl sched_stat 31 32
rp_put base e 6 rp_fjob
rp_put base e 7 sched_caps
rp_put base e 8 rp_fbyp x y true
rp_put base e 9 rp_dep x y
end

note Resume dispatch once, pause; record the ids assigned (words 0, 1).
fn rp_dispatch c long e ulong base ulong to void
rp_ok ge auth_pause c false 0 20
rp_ok ge auth_pause c true 0 20
a0 = ulong 0
a1 = ulong 0
for j ulong 64
s = get sjst j
if and ge s 3 le s 4
if eq a0 0
a0 = get sjid j
else
a1 = get sjid j
end
end
end
rp_put base e 0 a0
rp_put base e 1 a1
end

note Event e; before event 1 the creator publishes topic 8 (job 7001).
fn rp_event c long e ulong base ulong to void
pb = new uchar 4096 0
if eq e 1
rp_ok gt sched_publish c 8 pb 16 0 39
end
rp_dispatch c e base
rp_drive c
rp_state base e 0 0
end

fn rp_down c long to void
r = sched_stop c 2000000000
sup_closeall
jn_close
end

fn rp_ref pol ulong en ulong to int
c = rp_setup 0
rp_load c pol
for e ulong en
rp_event c e 0
end
rp_down c
ret 0
end

fn rp_crash pol ulong k ulong to int
c = rp_setup 1
rp_load c pol
for e ulong k
rp_event c e 1024
end
ret 77
end

fn rp_rec k ulong en ulong to int
c = rp_setup 1
rp_state 2048 0 0 0
for e ulong sub en k
rp_event c add k e 1024
end
rp_down c
ret 0
end

note C3: recover journal b again, state at 2048 + 10.
fn rp_again to int
c = rp_setup 1
rp_state 2048 1 0 0
rp_down c
ret 0
end

note C': k events, then one dispatch and its PAUSE, state at 3072, die.
fn rp_mcrash pol ulong k ulong to int
c = rp_setup 1
rp_load c pol
for e ulong k
rp_event c e 1024
end
rp_dispatch c 0 3072
rp_state 3072 0 rp_get 3072 0 0 rp_get 3072 0 1
ret 77
end

note C2': recover, state at 3072 + 10 without the jobs C' assigned.
fn rp_mrec to int
c = rp_setup 1
rp_state 3072 1 rp_get 3072 0 0 rp_get 3072 0 1
rp_down c
ret 0
end

fn rp_reap p long to ulong
ws = new uchar 4 0
g = waitpid int p ws 0 4 0
if le g 0
ret 999
end
if ne and get ws 0 127 0
ret add 128 ulong and get ws 0 127
end
ret ulong get ws 1
end

note A child that should exit want: anything else ends the test with the
note child's own check code (10..48, 90..99), or code.
fn rp_child x ulong want ulong code int to void
if ne x want
if or and ge x 10 le x 48 and ge x 90 le x 99
exit int x
end
exit code
end
end

fn rp_zero to void
for i ulong 4096
r = mapset get rpm 0 mul i 8 8 0
end
end

fn rp_case pol ulong k ulong b int to void
en = ulong 10
rp_zero
rp_clean
p = fork
if eq p 0
exit rp_ref pol en
end
rp_child rp_reap p 0 b
p = fork
if eq p 0
exit rp_crash pol k
end
rp_child rp_reap p 77 add b 1
p = fork
if eq p 0
exit rp_rec k en
end
rp_child rp_reap p 0 add b 2
p = fork
if eq p 0
exit rp_again
end
rp_child rp_reap p 0 add b 6
rp_cmp k en b
end

fn rp_cmp k ulong en ulong b int to void
for i ulong 8
rp_ok eq rp_get 2048 0 add i 2 rp_get 0 sub k 1 add i 2 add b 3
end
seen = false
for e ulong en
for i ulong 10
rp_ok eq rp_get 0 e i rp_get 1024 e i add b 4
end
if gt rp_get 0 e 3 0
seen = true
end
end
rp_ok seen add b 5
rp_ok gt rp_get 0 sub k 1 8 0 add b 5
rp_ok ne rp_get 0 sub k 1 2 0 add b 5
rp_ok eq and rp_get 0 sub k 1 9 255 2 add b 5
for i ulong 8
rp_ok eq rp_get 2048 1 add i 2 rp_get 0 sub en 1 add i 2 add b 6
end
rp_ok ne rp_get 0 sub en 1 2 rp_get 0 sub k 1 2 add b 6
end

fn rp_mid pol ulong k ulong to void
rp_zero
rp_clean
p = fork
if eq p 0
exit rp_mcrash pol k
end
rp_child rp_reap p 77 91
p = fork
if eq p 0
exit rp_mrec
end
rp_child rp_reap p 0 92
for i ulong 8
rp_ok eq rp_get 3072 1 add i 2 rp_get 3072 0 add i 2 93
end
rp_ok gt rp_get 3072 0 0 0 95
rp_ok gt rp_get 3072 0 8 0 95
w2 = rp_get 1024 sub k 1 2
w3 = rp_get 1024 sub k 1 3
rp_ok or ne rp_get 3072 0 2 w2 ne rp_get 3072 0 3 w3 95
end

note Journal b as left by the mid-event case: a FAIR repeating the last
note event is refused (96), and one assigning a free slot (97).
fn rp_dup to int
rp_ok eq rp_open 1 3000 0 96
r = new ulong 16 0
put r 0 13
put r 3 get jfair 0
put r 6 get jfair 1
rp_ok eq jn_put r 25 96
for i ulong 16
put r i 0
end
s = ulong 64
for j ulong 64
if eq get jsl j 0
s = j
end
end
rp_ok lt s 64 97
put r 0 13
put r 3 add get jfair 0 1
put r 4 shl 1 s
rp_ok eq jn_put r 25 97
for i ulong 16
put r i 0
end
put r 0 1
put r 3 1
put r 5 add SPVER 1
rp_ok eq jn_put r 33 98
rp_dupv
jn_close
ret 0
end

note A live ready job's slot (no deps, not cancelled), or 64.
fn rp_rslot to ulong
for s ulong 64
x = get jsl s
if ne x 0
b = mul sub x 1 8
if and eq get jjob add b 2 0 eq get jjob add b 6 0
ret s
end
end
end
ret 64
end

fn rp_fair r edit ulong 16 ev ulong am ulong bm ulong rs ulong rd ulong to void
for i ulong 16
put r i 0
end
put r 0 13
put r 3 ev
put r 4 am
put r 5 bm
put r 6 get jfair 1
put r 7 rs
put r 8 rd
end

note Contradictory records are refused (23..27); valid ones still pass.
fn rp_dupv to void
r = new ulong 16 0
s = rp_rslot
rp_ok lt s 64 23
f = ulong 64
for j ulong 64
if eq get jsl j 0
f = j
end
end
rp_ok lt f 64 23
put r 0 2
put r 3 9100
put r 7 s
rp_ok eq jn_put r 25 23
e = add get jfair 0 1
rp_fair r e shl 1 s shl 1 s 0 0
rp_ok eq jn_put r 25 24
for i ulong 16
put r i 0
end
put r 0 2
put r 3 9101
put r 4 16
put r 7 f
rp_ok eq jn_put r 0 26
rp_fair r e shl 1 f 0 0 0
rp_ok eq jn_put r 25 26
rp_fair r get jfair 0 0 0 0 shl 1 s
rp_ok eq jn_put r 25 27
put jfair 3 0
rp_fair r e shl 1 s 0 0 shl 1 f
rp_ok eq jn_put r 25 28
rp_ok eq get jfair 3 0 28
rp_ok eq get jrdy sub get jsl f 1 0 28
put jfair 3 1
rp_fair r get jfair 0 0 0 0 shl 1 f
rp_ok eq jn_put r 0 27
for i ulong 16
put r i 0
end
put r 0 8
put r 3 get jjob add mul sub get jsl s 1 8 1
rp_ok eq jn_put r 0 25
rp_fair r add get jfair 0 1 0 0 add s 1 0
rp_ok eq jn_put r 25 25
end

note A full replay ring (64 records not yet durable) refuses dispatch (44)
note and publication (47: job 7001 stays waiting).
fn rp_ring to int
c = rp_setup 0
rp_load c 1
put sfj 1 64
put scpause 0 0
x = sched_dispatch c
rp_ok eq x 0 44
rp_ok eq sched_stat 15 1 44
rp_ok eq sched_stat 4 0 44
pb = new uchar 4096 0
rp_ok eq sched_publish c 8 pb 16 neg long 105 47
rp_ok eq sched_stat 15 2 47
rp_ok eq get sjst rp_slot 7001 1 47
put sfj 1 0
put scpause 0 1
rp_down c
ret 0
end

note A failed journal: nothing it refuses changes the creator (40..43).
fn rp_fail to int
c = rp_setup 0
rp_load c 2
j = rp_slot 5000
g = get augen 0
put jbad 0 1
rp_ok eq auth_revoke c 0 40
rp_ok eq get augen 0 g 40
rp_ok eq auth_pause c false neg long 5 41
rp_ok eq get scpause 0 1 41
rp_ok eq auth_cancel c j neg long 5 42
rp_ok eq get sjst j 2 42
rp_ok eq jn_admitr 7000 0 0 1 neg long 5 43
rp_ok eq jn_policy 1 8 2 2 1000 neg long 5 43
rp_ok eq sched_stat 25 4 43
rp_ok eq jn_goal j 1 99 1 neg long 5 43
rp_ok eq get sjest j 0 43
rp_ok eq jn_cap 8 neg long 5 43
rp_ok eq sched_caps 4 43
rp_down c
ret 0
end

note Recovery fails closed past the incarnation range (29): fence 2^24 + 1,
note which a 24-bit mask would fold onto incarnation 1, is refused and
note leaves the scheduler unincarnated, so 2^24 - 1 is then accepted.
fn rp_fence to int
c = pool_new 4 2
rp_ok gt c 0 29
rp_ok eq sched_new c 32 8 0 29
put jpol 0 0
put jfence 0 16777217
rp_ok not jn_rpol 29
put jfence 0 16777215
rp_ok jn_rpol 29
ret 0
end

fn main to int
m = mapnew neg int 1 0 32768 3 33
rp_ok gt m 0 9
put rpm 0 m
rp_case 1 3 50
rp_case 1 6 60
rp_case 2 3 70
rp_case 2 6 80
rp_mid 1 3
p = fork
if eq p 0
exit rp_dup
end
rp_child rp_reap p 0 96
rp_clean
p = fork
if eq p 0
exit rp_fail
end
rp_child rp_reap p 0 40
rp_clean
p = fork
if eq p 0
exit rp_ring
end
rp_child rp_reap p 0 44
rp_clean
p = fork
if eq p 0
exit rp_fence
end
rp_child rp_reap p 0 29
if ne write 1 rpok 0 len rpok long len rpok
ret 100
end
ret 0
end

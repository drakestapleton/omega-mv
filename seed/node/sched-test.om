note Concatenate after transport.om, pool.om, super.om and sched.om. CPU-only
note acceptance of DRA-287 with real forked workers: irrelevant changes,
note coalesced hints, no lost wake-up, no barrier behind a slow worker, full
note admission and review queues, dead workers, stop under load, idle CPU and
note wake latency. No GPU, model or network.
text sok "PASS node sched\n"
text sidle "idle ticks workers="
text screat " creator="
text swake " wake rounds="
text smean " mean_us="
text smax " max_us="
text snl "\n"
text sproc "/proc/"
text sstat "/stat"
global stc long 1
global stm long 1

fn st_ok ok bool code int to void
if not ok
exit code
end
end

fn st_num v ulong to void
d = new uchar 20 0
x = v
k = ulong 20
for i ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
r = write 1 d k sub 20 k
end

note Write "/proc/<pid>/stat" into p; returns its length.
fn st_path pid ulong p edit uchar 64 to ulong
d = new uchar 20 0
for i ulong 6
put p i get sproc i
end
x = pid
k = ulong 20
for i ulong 20
k = sub k 1
put d k uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
n = ulong 6
for i ulong sub 20 k bound 20
put p n get d add k i
n = add n 1
end
for i ulong 5
put p n get sstat i
n = add n 1
end
ret n
end

note Sum of fields 14 and 15 (utime, stime) of a /proc stat line of got bytes.
fn st_parse b view uchar 1024 got ulong to ulong
rp = ulong 0
for i ulong got bound 1023
if eq get b i 41
rp = i
end
end
field = ulong 2
t = ulong 0
v = ulong 0
for i ulong sub got rp bound 1023
c = get b add rp i
if eq c 32
if or eq field 14 eq field 15
t = add t v
end
field = add field 1
v = 0
else
if and ge c 48 le c 57
v = add mul v 10 sub ulong c 48
end
end
end
ret t
end

note utime + stime of process pid in clock ticks, from /proc/pid/stat.
fn st_ticks pid ulong to ulong
p = new uchar 64 0
b = new uchar 1024 0
n = st_path pid p
fd = fopen p 0 n 524288 0
if lt fd 0
exit 150
end
got = read int fd b 0 1023
r = fclose int fd
if le got 0
exit 151
end
ret st_parse b ulong got
end

note Worker: run the job of assignment q cooperatively for the number of
note milliseconds in the low four decimal digits of its id, then report
note outcome id+1 and 64 bytes of the id's low byte. 0 done, 2 stopped,
note 3 creator gone, 4 wait error, 5 report refused.
fn st_run c long w ulong q ulong to int
buf = new uchar 4096 0
id = sc_cell w 8
dl = add ulong monons mul rem id 10000 1000000
for t ulong 1000000
now = ulong monons
if ge now dl
break
end
r = sched_wwait c w long sub dl now
if eq r 2
ret 2
end
if eq r 3
ret 3
end
if lt r 0
ret 4
end
end
for j ulong 64
put buf j uchar and id 255
end
if ne sched_wdone w q add id 1 buf 64 0
ret 5
end
ret 0
end

note Worker loop: run an assigned job, else scan the subscribed versions,
note record how many it has seen, and wait without a deadline. A worker with
note its lazy flag set sleeps 300 ms before each wait, so hints pile up.
fn st_worker w ulong to int
c = get stc 0
m = get stm 0
seen = ulong 0
for it ulong 1000000000
q = sched_wjob w
if gt q 0
r = st_run c w q
if eq r 2
ret 0
end
if ne r 0
ret add 60 r
end
continue
end
k = sched_wscan c w
if eq k neg long 1
ret 0
end
if lt k 0
ret 59
end
seen = add seen ulong k
r = mapset m add 64 mul w 8 8 seen
if ne mapget m add 600 mul w 8 8 0
r = sleepns 300000000
end
r = sched_wwait c w neg long 1
if eq r 2
ret 0
end
if eq r 3
ret 41
end
if lt r 0
ret 43
end
end
ret 45
end

fn st_spawn c long w ulong to bool
p = sup_spawn c w
if eq p 0
exit st_worker w
end
ret gt p 0
end

note Fresh pool of 4 arenas for w workers with limits a and rl, plus the test
note page. Exits with code on any refusal.
fn st_setup w ulong a ulong rl ulong code int to long
c = pool_new 4 w
st_ok gt c 0 code
put stc 0 c
m = mapnew neg int 1 0 4096 3 33
st_ok gt m 0 code
put stm 0 m
st_ok eq sup_init c 0 code
st_ok eq sched_new c a rl 0 code
ret c
end

fn st_down c long code int to void
st_ok ge sched_stop c 2000000000 0 code
sup_closeall
st_ok eq sched_free 0 code
st_ok eq pool_free c 0 code
st_ok eq mapdrop get stm 0 0 code
end

note Step the creator until at least n jobs are in state st, up to ms.
fn st_until c long st ulong n ulong ms ulong to bool
dl = add ulong monons mul ms 1000000
for t ulong 1000000
if ge sched_count st st n
ret true
end
if ge ulong monons dl
ret false
end
r = sched_step c 10000000
end
ret false
end

note Wait up to ms for worker w's seen count to reach n.
fn st_seen w ulong n ulong ms ulong to bool
dl = add ulong monons mul ms 1000000
for t ulong 1000000
if ge mapget get stm 0 add 64 mul w 8 8 n
ret true
end
if ge ulong monons dl
ret false
end
r = sleepns 1000000
end
ret false
end

note Phase A: interests w0 topic 1, w1 topic 2, w2 topic 1 and lazy. Topic 4
note publications wake nobody. One topic 1 publication wakes w2; the next 29
note land while it sleeps and reach it in exactly one more wake. w0 sees all
note 30, w1 is never woken.
fn st_hints to void
buf = new uchar 4096 0
c = st_setup 3 8 8 10
m = get stm 0
st_ok eq sched_want 0 1 0 11
st_ok eq sched_want 1 2 0 12
st_ok eq sched_want 2 1 0 13
r = mapset m 616 8 1
for w ulong 3
st_ok st_spawn c w 14
end
r = sleepns 100000000
for i ulong 20
st_ok gt sched_publish c 4 buf 16 0 15
end
r = sleepns 500000000
for w ulong 3
st_ok eq sc_cell w 80 0 16
st_ok eq mapget m add 64 mul w 8 8 0 17
end
st_ok gt sched_publish c 1 buf 16 0 18
st_ok st_seen 2 1 3000 19
for i ulong 29
st_ok gt sched_publish c 1 buf 16 0 29
end
st_ok st_seen 0 30 3000 44
st_ok st_seen 2 30 3000 20
r = sleepns 400000000
st_ok eq mapget m 64 8 30 21
st_ok eq mapget m 80 8 30 22
st_ok eq mapget m 72 8 0 23
st_ok eq sc_cell 1 80 0 24
st_ok eq sc_cell 2 80 2 25
st_ok ge sc_cell 0 80 1 26
st_ok le sc_cell 0 80 30 27
st_down c 28
end

fn st_admit id ulong deps ulong fl ulong code int to ulong
j = sched_admit id deps fl
st_ok ge j 0 code
ret ulong j
end

note Phase B: one slow job and six fast ones on three workers. The fast jobs
note finish and are reviewed while the slow one still runs (no barrier).
fn st_nobar to void
buf = new uchar 4096 0
c = st_setup 3 8 8 30
for w ulong 3
st_ok st_spawn c w 31
end
s = st_admit 11500 0 0 32
for i ulong 6
j = st_admit add mul add i 2 10000 20 0 0 33
end
st_ok st_until c 4 6 5000 34
st_ok eq get sjst s 3 35
for j ulong 64
if and eq get sjst j 4 ne j s
st_ok eq sched_review j long add get sjid j 1 36
end
end
st_ok eq sched_count 1 4 1 37
st_ok st_until c 4 1 5000 38
w = get sjw s
st_ok eq sched_review s 11501 39
st_ok eq sched_result w buf 4096 40
st_ok eq get buf 63 236 41
st_ok eq sched_count 1 6 0 42
st_down c 43
end

note Phase C: admission refuses past 8 and review holds at 2. Workers keep
note finished results instead of taking more work; reviewing drains it all.
fn st_full to void
c = st_setup 3 8 2 45
for w ulong 3
st_ok st_spawn c w 46
end
for i ulong 8
j = st_admit add mul add i 1 10000 20 0 0 47
end
st_ok eq sched_admit 99020 0 0 neg long 2 48
st_ok st_until c 4 2 5000 49
r = sleepns 300000000
for t ulong 20
r = sched_step c 10000000
end
st_ok eq sched_count 4 4 2 50
st_ok eq sched_count 3 3 3 51
st_ok eq sched_count 2 2 3 52
for w ulong 3
st_ok eq sc_cell w 64 get scseq w 53
end
note Jobs in review no longer count as admitted: 3 held results + 3 ready.
st_ok eq sched_count 1 3 6 54
n = ulong 0
for t ulong 400
for j ulong 64
if eq get sjst j 4
st_ok eq sched_review j long add get sjid j 1 55
n = add n 1
end
end
if eq n 8
break
end
r = sched_step c 10000000
end
st_ok eq n 8 56
st_ok ge sched_admit 99020 0 0 0 57
st_down c 58
end

note Phase D: a job that waits on topic 8 starts only after a topic 8
note publication; topic 16 does not start it.
fn st_deps to void
buf = new uchar 4096 0
c = st_setup 2 8 8 65
for w ulong 2
st_ok st_spawn c w 66
end
j = st_admit 10020 8 0 67
st_ok eq get sjst j 1 68
st_ok gt sched_publish c 16 buf 16 0 69
st_ok not st_until c 4 1 300 70
st_ok eq get sjst j 1 71
st_ok gt sched_publish c 8 buf 16 0 72
st_ok st_until c 4 1 3000 73
st_ok eq sched_review j 10021 74
st_down c 75
end

note Phase E: kill two workers mid-job. The rerunnable job runs again on the
note third worker; the other becomes UNKNOWN and is never run again.
note Respawned workers find their old assignment retired.
fn st_dead to void
c = st_setup 3 8 8 76
for w ulong 3
st_ok st_spawn c w 77
end
x = st_admit 11500 0 0 78
y = st_admit 21500 0 1 79
st_ok st_until c 3 2 2000 80
wx = get sjw x
wy = get sjw y
st_ok eq killpid int get swpid wx 9 0 81
st_ok eq killpid int get swpid wy 9 0 82
st_ok st_until c 6 1 3000 83
st_ok eq get sjatt x 1 84
st_ok st_until c 4 1 5000 85
st_ok eq get sjatt y 2 86
st_ok eq sched_review y 21501 87
st_ok eq get sjst x 6 88
st_ok eq sched_review x neg long 3 89
st_ok st_spawn c wx 90
st_ok st_spawn c wy 91
st_ok eq sc_cell wx 64 get scseq wx 92
st_ok eq sc_cell wy 64 get scseq wy 93
for t ulong 30
r = sched_step c 10000000
end
st_ok eq get sjst x 6 94
st_ok eq sched_settle x 0 95
st_ok eq sched_count 1 6 0 96
st_down c 97
end

note Phase F: stop with eight long jobs admitted and three running. Every
note worker leaves cooperatively well inside the deadline; the three running
note jobs become UNKNOWN; the five never started stay ready.
fn st_stop to void
c = st_setup 3 8 8 115
for w ulong 3
st_ok st_spawn c w 116
end
for i ulong 8
j = st_admit add mul add i 1 10000 5000 0 0 117
end
st_ok st_until c 3 3 2000 118
t0 = ulong monons
st_ok eq sched_stop c 2000000000 0 119
st_ok lt sub ulong monons t0 1000000000 120
st_ok eq sup_live c 0 121
st_ok eq sched_count 6 6 3 122
st_ok eq sched_count 2 2 5 123
for w ulong 3
st_ok eq get swst w 0 124
end
sup_closeall
st_ok eq sched_free 0 125
st_ok eq pool_free c 0 126
st_ok eq mapdrop get stm 0 0 127
end

note CPU ticks used by both workers (word 1000) and the creator (1008) of the
note test page while the creator waits 2 s with nothing to do.
fn st_idlecpu c long to void
m = get stm 0
p0 = ulong get swpid 0
p1 = ulong get swpid 1
me = ulong getpid
a0 = add st_ticks p0 st_ticks p1
a1 = st_ticks me
r = sched_step c 2000000000
b0 = add st_ticks p0 st_ticks p1
b1 = st_ticks me
r = mapset m 1000 8 sub b0 a0
r = mapset m 1008 8 sub b1 a1
end

note 200 rounds of one topic 1 publication, each seen by both workers before
note the next. Returns the sum of the per-round wake latencies in ns.
fn st_rounds c long to ulong
buf = new uchar 4096 0
sum = ulong 0
for i ulong 200
st_ok gt sched_publish c 1 buf 16 0 134
for w ulong 2
st_ok st_seen w add i 1 2000 135
sum = add sum sc_cell w 88
end
end
ret sum
end

note Phase G: two idle workers block while the creator idles 2 s; then 200
note publication rounds wake each worker exactly once per round (no lost and
note no extra wake-ups).
fn st_idle to void
c = st_setup 2 8 8 130
m = get stm 0
st_ok eq sched_want 0 1 0 131
st_ok eq sched_want 1 1 0 132
for w ulong 2
st_ok st_spawn c w 133
end
r = sleepns 200000000
st_idlecpu c
st_ok le mapget m 1000 8 2 138
st_ok le mapget m 1008 8 2 139
sum = st_rounds c
st_ok eq sc_cell 0 80 200 136
st_ok eq sc_cell 1 80 200 137
r = write 1 sidle 0 len sidle
st_num mapget m 1000 8
r = write 1 screat 0 len screat
st_num mapget m 1008 8
r = write 1 swake 0 len swake
st_num 200
r = write 1 smean 0 len smean
st_num div sum 400000
r = write 1 smax 0 len smax
mx = sc_cell 0 96
if gt sc_cell 1 96 mx
mx = sc_cell 1 96
end
st_num div mx 1000
r = write 1 snl 0 1
st_down c 140
end

fn st_isarg to bool
a = new uchar 16 0
if ne argcnt 2
ret false
end
ret eq argread 1 a 0 16 4
end

note With one 4-byte argument ("idle"), run only phase G.
fn main to int
if st_isarg
st_idle
ret 0
end
st_hints
st_nobar
st_full
st_deps
st_dead
st_stop
st_idle
if ne write 1 sok 0 len sok long len sok
ret 100
end
ret 0
end

omegair 1
fn @f0 flags 0 %1:u32 %2:u32 -> u32
block ^0
%3 = chk.shift 7 %0 %2
%4 = shl u32 %1 %2
retv %3 %4
end
export @f1 flags 0 -> i32
block ^0
%1 = const u32 1
%2 = const u32 31
%3 %4 = call u32 %0 @f0 %1 %2
%5 = const u32 1
%6 = const u32 32
%7 %8 = call u32 %3 @f0 %5 %6
%9 = const u32 255
%10 = and u32 %8 %9
%11 = chk.conv i32 5 %7 %10
%12 = conv i32 0 %10
retv %11 %12
end

%3 = const u64 1
%4 = chk.bounds 3 %0 %1 %2 %3
%5 = const u32 42
%6 = store %4 %1 %2 %5
%7 = load u32 %6 %1 %2
%8 = conv i32 0 %7
retv %6 %8
end

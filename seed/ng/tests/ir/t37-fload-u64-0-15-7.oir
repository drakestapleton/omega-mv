omegair 1
type %t32 = array u32 16
type %t33 = ref edit host %t32
type %t34 = ref view host %t32
type %t35 = vec u32 4
type %t36 = slice edit host u32
type %t37 = array u8 8
type %t38 = ref edit host %t37
type %t39 = array f32 4
type %t40 = ref edit host %t39
global @g0 %t32 zero
global @g1 %t37 zero
global @g2 %t39 zero
export @f0 flags 0 -> i32
block ^0
%1 = const i32 1
%2 = const i64 2
%3 = const u32 3
%4 = const u64 4
%5 = const f32 0x3f800000
%6 = const bool true
%7 = gaddr %t33 @g0
%8 = gaddr %t34 @g0
%9 = const u64 1
%10 = chk.bounds 3 %0 %7 %4 %9
%11 = chk.bounds 3 %10 %8 %4 %9
%12 = vsplat %t35 %3
%13 = gaddr %t38 @g1
%14 = gaddr %t40 @g2
%15 = chk.bounds 3 %11 %14 %4 %9
%16 = fload u64 0 %15 %7
retv %15 %1
end

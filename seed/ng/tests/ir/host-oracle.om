note SPDX-License-Identifier: Apache-2.0
note Build with src/ir.om. host-oracle UNIT.ir NEW-NATIVE-DIR emits IR and executes equivalent native host operations.
note The gate passes the same two program arguments and a controlled environment to ngrun.
note Every native expected success is checked before an expected IR value is recorded.
global hc_s uint 16
global hc_a uint 16
global hc_seen uchar 256
global hc_count ulong 2
global hc_dig uchar 24
text hc_st0 "HC_NATIVE operations="
text hc_st1 " words="
text hc_st2 "\n"
text hc_bad0 "HC_FAIL operation="
text hc_bad1 " actual-bits="
text hc_bad2 " expected-bits="
global hc_buf uchar 512
global hc_out uchar 8192
global hc_root uchar 4096
global hc_arg uchar 4096
global hc_pkt uchar 64
text hc_name "probe"
text hc_new "renamed"
text hc_link "linked"
text hc_dir "child"
text hc_empty "empty"
text hc_data "hello"
text hc_one "X"
text hc_env "NG_ORACLE=present"
text hc_msg "HOSTORACLE\n"
fn hc_c t uint v ulong to uint
ret ir_res ir_op get hc_s 0 1 t v 0
end

fn hc_true c uint to void
o = ir_op get hc_s 0 82 0 14 2
ir_set o 0 get hc_s 1
ir_set o 1 c
put hc_s 1 ir_otok o
end
fn hc_cmp op uint a uint b uint to uint
o = ir_op get hc_s 0 op 1 0 2
ir_set o 0 a
ir_set o 1 b
ret ir_res o
end
fn hc_ok v uint actual long expected long to void
if ne actual expected
hc_diag actual expected
exit 2
end
hc_true hc_cmp 30 v hc_c 9 bitcast ulong actual
end
fn hc_pos v uint actual long to void
if le actual 0
hc_diag actual 1
exit 2
end
hc_true hc_cmp 34 v hc_c 9 0
end
fn hc_host w ulong ty uint n uint to uint
put hc_count 0 add get hc_count 0 1
if eq get hc_seen w 0
put hc_count 1 add get hc_count 1 1
put hc_seen w 1
end
o = ir_op get hc_s 0 110 ty w add n 1
ir_set o 0 get hc_s 1
for j uint n bound 16
ir_set o add j 1 get hc_a j
end
put hc_s 1 ir_otok o
ret ir_res o
end
fn hc_slice slot ulong ref uint off ulong n ulong to void
z = hc_c 5 off
sz = hc_c 5 n
o = ir_op get hc_s 0 80 0 3 4
ir_set o 0 get hc_s 1
ir_set o 1 ref
ir_set o 2 z
ir_set o 3 sz
put hc_s 1 ir_otok o
put hc_a slot ref
put hc_a add slot 1 z
put hc_a add slot 2 sz
end
fn hc_text txt view uchar * to uint
t = ir_tarr 2 uint len txt
r = ir_tref t 0 0
g = ir_glob t 1
for j ulong len txt bound 4096
ir_gbyt g uint get txt j
end
ret ir_res ir_op get hc_s 0 52 r ulong g 0
end
fn hc_memory to uint
t = ir_tarr 2 512
r = ir_tref t 1 0
g = ir_glob t 0
ret ir_res ir_op get hc_s 0 52 r ulong g 0
end
fn hc_byte idx ulong actual uchar expected uchar to void
if ne actual expected
hc_diag long actual long expected
exit 2
end
r = get hc_s 2
i = hc_c 5 idx
e = hc_c 5 1
o = ir_op get hc_s 0 79 0 3 4
ir_set o 0 get hc_s 1
ir_set o 1 r
ir_set o 2 i
ir_set o 3 e
put hc_s 1 ir_otok o
o = ir_op get hc_s 0 42 2 0 3
ir_set o 0 get hc_s 1
ir_set o 1 r
ir_set o 2 i
v = ir_res o
hc_true hc_cmp 30 v hc_c 2 ulong actual
end

fn hc_fdword w ulong actual long expected long to void
put hc_a 0 hc_c 8 3
hc_ok hc_host w 9 1 actual expected
end
fn hc_args to void
hc_ok hc_host 121 9 0 argcnt 3
put hc_a 0 hc_c 5 1
hc_slice 1 get hc_s 2 0 1
hc_ok hc_host 122 9 4 argread 1 hc_buf 0 1 -105
hc_byte 0 get hc_buf 0 0
put hc_a 0 hc_c 5 1
hc_slice 1 get hc_s 2 0 len hc_buf
n = argread 1 hc_buf 0 len hc_buf
hc_pos hc_host 122 9 4 n
hc_ok hc_host 136 9 0 envcnt 1
put hc_a 0 hc_c 5 0
hc_slice 1 get hc_s 2 0 0
hc_ok hc_host 137 9 4 envread 0 hc_buf 0 0 -105
put hc_a 0 hc_c 5 0
hc_slice 1 get hc_s 2 0 len hc_buf
hc_ok hc_host 137 9 4 envread 0 hc_buf 0 len hc_buf long len hc_env
hc_byte 0 get hc_buf 0 78
hc_pos hc_host 109 9 0 monons
hc_pos hc_host 130 9 0 realns
put hc_a 0 hc_c 9 0
hc_ok hc_host 120 9 1 sleepns 0 0
uid = getuid
hc_ok hc_host 145 9 0 uid uid
gid = getgid
hc_ok hc_host 147 9 0 gid gid
hc_ok hc_host 146 9 0 geteuid uid
hc_ok hc_host 148 9 0 getegid gid
v = hc_host 199 0 0
cpufence
v = hc_host 200 0 0
cpurelax
end
fn hc_files1 to void
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 194
put hc_a 4 hc_c 8 384
fd = fopen hc_name 0 len hc_name 194 384
hc_ok hc_host 110 9 5 fd 3
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 4 0 len hc_data
hc_ok hc_host 54 9 4 write int fd hc_data 0 len hc_data long len hc_data
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 5 0 len hc_one
put hc_a 4 hc_c 9 2
hc_ok hc_host 162 9 5 pwrite int fd hc_one 0 len hc_one 2 1
put hc_a 0 hc_c 8 3
put hc_a 1 hc_c 9 0
put hc_a 2 hc_c 8 0
hc_ok hc_host 103 9 3 fseek int fd 0 0 0
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 2 0 5
hc_ok hc_host 53 9 4 read int fd hc_buf 0 5 5
hc_byte 0 get hc_buf 0 104
hc_byte 1 get hc_buf 1 101
hc_byte 2 get hc_buf 2 88
hc_byte 3 get hc_buf 3 108
hc_byte 4 get hc_buf 4 111
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 2 0 3
put hc_a 4 hc_c 9 1
hc_ok hc_host 161 9 5 pread int fd hc_buf 0 3 1 3
hc_byte 0 get hc_buf 0 101
hc_byte 1 get hc_buf 1 88
hc_byte 2 get hc_buf 2 108
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 2 0 128
hc_ok hc_host 117 9 4 fstat int fd hc_buf 0 128 0
hc_byte 48 get hc_buf 48 5
put hc_a 0 hc_c 8 3
put hc_a 1 hc_c 9 4
hc_ok hc_host 139 9 2 ftrunc int fd 4 0
hc_fdword 101 fsync int fd 0
hc_fdword 156 fdsync int fd 0
put hc_a 0 hc_c 8 3
put hc_a 1 hc_c 8 384
hc_ok hc_host 102 9 2 fchmod int fd 384 0
put hc_a 0 hc_c 8 3
put hc_a 1 hc_c 8 6
hc_ok hc_host 197 9 2 flock int fd 6 0
put hc_a 0 hc_c 8 3
put hc_a 1 hc_c 8 8
hc_ok hc_host 197 9 2 flock int fd 8 0
hc_fdword 100 fclose int fd 0
end
fn hc_files2 to void
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 0
hc_ok hc_host 144 9 4 faccess hc_name 0 len hc_name 0 0
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 384
hc_ok hc_host 143 9 4 chmod hc_name 0 len hc_name 384 0
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 bitcast ulong getuid
put hc_a 4 hc_c 8 bitcast ulong getgid
hc_ok hc_host 151 9 5 chown hc_name 0 len hc_name int getuid int getgid 0
hc_slice 0 get hc_s 3 0 len hc_name
hc_slice 3 get hc_s 2 0 128
hc_ok hc_host 140 9 6 stat hc_name 0 len hc_name hc_buf 0 128 0
hc_byte 48 get hc_buf 48 4
hc_slice 0 get hc_s 3 0 len hc_name
hc_slice 3 get hc_s 2 0 128
hc_ok hc_host 149 9 6 lstat hc_name 0 len hc_name hc_buf 0 128 0
hc_slice 0 get hc_s 3 0 len hc_name
hc_slice 3 get hc_s 2 0 128
hc_ok hc_host 133 9 6 readlnk hc_name 0 len hc_name hc_buf 0 128 -22
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 9 3
hc_ok hc_host 150 9 4 truncate hc_name 0 len hc_name 3 0
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 0
put hc_a 4 hc_c 8 0
fd = fopen hc_name 0 len hc_name 0 0
hc_ok hc_host 110 9 5 fd 3
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 2 0 8
hc_ok hc_host 53 9 4 read int fd hc_buf 0 8 3
hc_byte 2 get hc_buf 2 88
hc_fdword 100 fclose int fd 0
end
fn hc_packet a view uchar * b view uchar * to uint
put hc_pkt 0 2
put hc_pkt 1 0
put hc_pkt 2 uchar len a
put hc_pkt 3 0
for j ulong len a bound 32
put hc_pkt add 4 j get a j
end
p = add 4 len a
put hc_pkt p uchar len b
put hc_pkt add p 1 0
for j ulong len b bound 32
put hc_pkt add add p 2 j get b j
end
n = add add p 2 len b
t = ir_tarr 2 uint n
r = ir_tref t 0 0
g = ir_glob t 1
for j ulong n bound 64
ir_gbyt g uint get hc_pkt j
end
put hc_s 15 uint n
ret ir_res ir_op get hc_s 0 52 r ulong g 0
end
fn hc_files3 to void
r = hc_packet hc_name hc_new
hc_slice 0 r 0 ulong get hc_s 15
put hc_a 3 hc_c 8 1
hc_ok hc_host 125 9 4 renames hc_pkt 0 ulong get hc_s 15 1 0
r = hc_packet hc_new hc_link
hc_slice 0 r 0 ulong get hc_s 15
hc_ok hc_host 141 9 3 link hc_pkt 0 ulong get hc_s 15 0
r = hc_text hc_link
hc_slice 0 r 0 len hc_link
hc_ok hc_host 111 9 3 unlink hc_link 0 len hc_link 0
r = hc_text hc_new
hc_slice 0 r 0 len hc_new
hc_ok hc_host 111 9 3 unlink hc_new 0 len hc_new 0
r = hc_text hc_empty
hc_slice 0 r 0 len hc_empty
put hc_a 3 hc_c 8 448
hc_ok hc_host 112 9 4 makedir hc_empty 0 len hc_empty 448 0
hc_slice 0 r 0 len hc_empty
hc_ok hc_host 126 9 3 rmdir hc_empty 0 len hc_empty 0
hc_slice 0 get hc_s 3 0 len hc_name
put hc_a 3 hc_c 8 0
fd = memfd hc_name 0 len hc_name 0
hc_ok hc_host 157 9 4 fd 3
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 4 0 len hc_data
hc_ok hc_host 54 9 4 write int fd hc_data 0 len hc_data long len hc_data
hc_fdword 100 fclose int fd 0
end
fn hc_dirs to void
r = hc_text hc_dir
hc_slice 0 r 0 len hc_dir
put hc_a 3 hc_c 8 448
hc_ok hc_host 112 9 4 makedir hc_dir 0 len hc_dir 448 0
hc_slice 0 r 0 len hc_dir
put hc_a 3 hc_c 8 16384
put hc_a 4 hc_c 8 0
fd = fopen hc_dir 0 len hc_dir 16384 0
hc_ok hc_host 110 9 5 fd 3
put hc_a 0 hc_c 8 3
hc_slice 1 get hc_s 2 0 len hc_buf
hc_pos hc_host 113 9 4 getdnts int fd hc_buf 0 len hc_buf
hc_slice 0 r 0 len hc_dir
hc_ok hc_host 138 9 3 chdir hc_dir 0 len hc_dir 0
put hc_a 0 hc_c 8 3
hc_ok hc_host 153 9 1 fchdir int fd 0
hc_fdword 100 fclose int fd 0
hc_slice 0 get hc_s 2 0 len hc_buf
hc_pos hc_host 132 9 3 cwd hc_buf 0 len hc_buf
hc_byte 0 get hc_buf 0 47
end
fn hc_paths to void
n = argread 1 hc_arg 0 len hc_arg
if or le n 0 ge n 4096
exit 2
end
base = ulong 0
if ne get hc_arg 0 47
k = cwd hc_out 0 len hc_out
if le k 0
exit 2
end
base = sub ulong k 1
put hc_out base 47
base = add base 1
end
if gt add base ulong n 4095
exit 2
end
for j ulong ulong n bound 4096
put hc_out add base j get hc_arg j
end
put hc_s 14 uint add base ulong n
n = argread 2 hc_root 0 len hc_root
if or le n 0 ge n 4096
exit 2
end
k = makedir hc_root 0 ulong n 448
if ne k 0
exit 2
end
k = chdir hc_root 0 ulong n
if ne k 0
exit 2
end
end
fn hc_print v ulong to void
x = v
i = ulong 24
while true bound 24
i = sub i 1
put hc_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 hc_dig i sub 24 i
ret
end
end
end
fn hc_diag actual long expected long to void
k = write 2 hc_bad0 0 len hc_bad0
hc_print get hc_count 0
k = write 2 hc_bad1 0 len hc_bad1
hc_print bitcast ulong actual
k = write 2 hc_bad2 0 len hc_bad2
hc_print bitcast ulong expected
k = write 2 hc_st2 0 len hc_st2
end
fn main to int
if ne argcnt 3
ret 2
end
ir_init
f = ir_fnew 2 0 8
put hc_s 0 ir_blk f
put hc_s 1 ir_ftok f
put hc_s 2 hc_memory
put hc_s 3 hc_text hc_name
put hc_s 4 hc_text hc_data
put hc_s 5 hc_text hc_one
hc_paths
mask = umask 0
put hc_a 0 hc_c 8 0
hc_ok hc_host 155 9 1 mask mask
hc_args
hc_files1
hc_files2
hc_files3
hc_dirs
r = hc_text hc_msg
put hc_a 0 hc_c 8 1
hc_slice 1 r 0 len hc_msg
v = hc_host 54 9 4
hc_true hc_cmp 30 v hc_c 9 len hc_msg
status = hc_c 8 7
o = ir_op get hc_s 0 66 0 0 2
ir_set o 0 get hc_s 1
ir_set o 1 status
n = ir_wr
fd = fopen hc_out 0 ulong get hc_s 14 577 384
if lt fd 0
hc_diag fd 0
ret 2
end
k = write int fd i_out 0 n
cl = fclose int fd
if ne k long n
hc_diag k long n
ret 2
end
k = write 2 hc_st0 0 len hc_st0
hc_print get hc_count 0
k = write 2 hc_st1 0 len hc_st1
hc_print get hc_count 1
k = write 2 hc_st2 0 len hc_st2
k = write 1 hc_msg 0 len hc_msg
if ne k long len hc_msg
ret 2
end
exit 7
end

note All pool widths survive interleaved compaction; nested growth observes the newest length.
global P0 uchar *
global P1 ushort *
global P2 uint *
global P3 ulong *
global P4 byte *
global P5 short *
global P6 int *
global P7 long *
global P8 f32 *
global P9 f64 *
global order ulong 1
fn grow to ulong
r = enlarge P3 8
put order 0 add get order 0 1
ret 12
end
fn idx to ulong
put order 0 add mul get order 0 10 1
ret 11
end
fn val to ulong
put order 0 add mul get order 0 10 2
r = enlarge P3 16
ret 99
end
fn main to int
r = enlarge P0 2
put P0 1 uchar 255
r = enlarge P1 2
put P1 1 ushort 65535
r = enlarge P2 2
put P2 1 uint 4294967295
r = enlarge P3 2
put P3 1 ulong 18446744073709551615
r = enlarge P4 2
put P4 1 byte -128
r = enlarge P5 2
put P5 1 short -32768
r = enlarge P6 2
put P6 1 int -2147483648
r = enlarge P7 2
put P7 1 long -9223372036854775808
r = enlarge P8 2
put P8 1 f32 1.25f32
r = enlarge P9 2
put P9 1 f64 2.5f64
r = enlarge P3 grow
if ne len P3 12
ret 20
end
put order 0 0
put P3 idx val
if ne get order 0 12
ret 21
end
if ne get P3 11 99
ret 22
end
r = enlarge P0 17
if ne get P0 1 uchar 255
ret 1
end
if ne get P0 16 uchar 0
ret 23
end
r = enlarge P1 17
if ne get P1 1 ushort 65535
ret 2
end
if ne get P1 16 ushort 0
ret 23
end
r = enlarge P2 17
if ne get P2 1 uint 4294967295
ret 3
end
if ne get P2 16 uint 0
ret 23
end
r = enlarge P3 17
if ne get P3 1 ulong 18446744073709551615
ret 4
end
if ne get P3 16 ulong 0
ret 23
end
r = enlarge P4 17
if ne get P4 1 byte -128
ret 5
end
if ne get P4 16 byte 0
ret 23
end
r = enlarge P5 17
if ne get P5 1 short -32768
ret 6
end
if ne get P5 16 short 0
ret 23
end
r = enlarge P6 17
if ne get P6 1 int -2147483648
ret 7
end
if ne get P6 16 int 0
ret 23
end
r = enlarge P7 17
if ne get P7 1 long -9223372036854775808
ret 8
end
if ne get P7 16 long 0
ret 23
end
r = enlarge P8 17
if ne get P8 1 f32 1.25f32
ret 9
end
if ne get P8 16 f32 0.0f32
ret 23
end
r = enlarge P9 17
if ne get P9 1 f64 2.5f64
ret 10
end
if ne get P9 16 f64 0.0f64
ret 23
end
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/recovered-owners.sh compile=0 acceptance only; runtime parity with x-pool-widths.oir is seed/ng/a64/rgate.om, not a section-11 owner

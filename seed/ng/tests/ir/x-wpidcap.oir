omegair 1
type %t32 = array u8 2
type %t33 = ref edit host %t32
global @g0 %t32 zero
export @f0 flags 0 -> i32
block ^0
%1 = gaddr %t33 @g0
%2 = const i32 -1
%3 = const u64 0
%4 = const u64 2
%5 = const i32 1
%6 = chk.slice 3 %0 %1 %3 %4
%7 %8 = host i64 116 %6 %2 %1 %3 %4 %5
%9 = conv i32 0 %8
retv %7 %9
end

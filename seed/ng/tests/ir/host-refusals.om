note SPDX-License-Identifier: Apache-2.0
note Build with src/ir.om. host-refusals MODE emits one accepted host op and a return if it were executed.
note Modes 115..121 select process, limits, device, network, path, nondeterminism, unsafe-fs.
note 215 checks execenv's process class, 219 checks a parent traversal, 319 checks pwrite on inherited stdout.
note 324 and 325 check execprog's process class on argv packets that omc 564c5835 accepts and the older
note 64-record / 4096-byte rule refused: 1024 records (2051 bytes) and one 4095-byte record (4099 bytes).
global hd_s uint 3
global hd_a uint 8
global hd_arg uchar 8
text hd_abs "/ngrun-outside-control"
text hd_rel "../ngrun-outside-control"
fn hd_c t uint v ulong to uint
ret ir_res ir_op get hd_s 0 1 t v 0
end
fn hd_text word view uchar * to uint
t = ir_tarr 2 uint len word
r = ir_tref t 0 0
g = ir_glob t 1
for j ulong len word bound 8192
ir_gbyt g uint get word j
end
ret ir_res ir_op get hd_s 0 52 r ulong g 0
end
fn hd_slice slot ulong ref uint n ulong to void
z = hd_c 5 0
sz = hd_c 5 n
o = ir_op get hd_s 0 80 0 3 4
ir_set o 0 get hd_s 1
ir_set o 1 ref
ir_set o 2 z
ir_set o 3 sz
put hd_s 1 ir_otok o
put hd_a slot ref
put hd_a add slot 1 z
put hd_a add slot 2 sz
end
fn hd_op word ulong n uint to void
o = ir_op get hd_s 0 110 9 word add n 1
ir_set o 0 get hd_s 1
for j uint n bound 8
ir_set o add j 1 get hd_a j
end
put hd_s 1 ir_otok o
end
fn hd_emit mode uint to void
note Well-formed packets (count, u16-length records) for execenv and symlnk: a malformed one traps 3 natively
note before any kernel call, and ngrun gives that trap first, so a refusal control must not hold one.
pg = new uchar 5 0
put pg 0 1
put pg 2 1
put pg 4 120
ev = new uchar 7 0
put ev 0 1
put ev 2 3
put ev 4 88
put ev 5 61
put ev 6 49
pr = new uchar 8 0
put pr 0 2
put pr 2 1
put pr 4 97
put pr 5 1
put pr 7 98
pc = new uchar 2051 0
pb = new uchar 4099 0
if eq mode 115
hd_op 107 0
ret
end
if eq mode 324
put pc 1 4
put pc 2 1
put pc 4 120
hd_slice 0 hd_text pc 2051
hd_op 124 3
ret
end
if eq mode 325
put pb 0 1
put pb 2 255
put pb 3 15
for j ulong 4095
put pb add j 4 120
end
hd_slice 0 hd_text pb 4099
hd_op 124 3
ret
end
if eq mode 215
hd_slice 0 hd_text pg 5
hd_slice 3 hd_text ev 7
hd_op 233 6
ret
end
if eq mode 116
put hd_a 0 hd_c 8 0
put hd_a 1 hd_c 8 0
hd_slice 2 get hd_s 2 16
hd_op 235 5
ret
end
if eq mode 117
put hd_a 0 hd_c 9 0
hd_op 168 1
ret
end
if eq mode 118
put hd_a 0 hd_c 8 2
put hd_a 1 hd_c 8 1
put hd_a 2 hd_c 8 0
hd_op 104 3
ret
end
if or eq mode 119 eq mode 219
r = hd_text hd_abs
n = len hd_abs
if eq mode 219
r = hd_text hd_rel
n = len hd_rel
end
hd_slice 0 r n
put hd_a 3 hd_c 8 577
put hd_a 4 hd_c 8 384
hd_op 110 5
ret
end
if eq mode 120
hd_slice 0 get hd_s 2 1
put hd_a 3 hd_c 8 0
hd_op 135 4
ret
end
if eq mode 121
hd_slice 0 hd_text pr 8
hd_op 142 3
ret
end
if eq mode 319
put hd_a 0 hd_c 8 1
hd_slice 1 get hd_s 2 1
put hd_a 4 hd_c 9 0
hd_op 162 5
ret
end
exit 2
end
fn main to int
if ne argcnt 2
ret 2
end
n = argread 1 hd_arg 0 len hd_arg
if or le n 0 gt n 3
ret 2
end
mode = uint 0
for j ulong ulong n bound 3
c = uint get hd_arg j
if or lt c 48 gt c 57
ret 2
end
mode = add mul mode 10 sub c 48
end
ir_init
f = ir_fnew 2 0 8
put hd_s 0 ir_blk f
put hd_s 1 ir_ftok f
t = ir_tarr 2 64
r = ir_tref t 1 0
g = ir_glob t 0
put hd_s 2 ir_res ir_op get hd_s 0 52 r ulong g 0
hd_emit mode
v = hd_c 8 0
o = ir_op get hd_s 0 63 0 0 2
ir_set o 0 get hd_s 1
ir_set o 1 v
lenout = ir_wr
k = write 1 i_out 0 lenout
if ne k long lenout
ret 2
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Build with src/ir.om. Usage: intcv SOURCE-ID DEST-ID CASE, ids u8..u64=2..5, i8..i64=6..9.
note Emits a minimal IR unit, then does the equivalent native seeded-omc conversion.
note Exit 0 or trap 5 is the independent expected result for the emitted unit.
note 4 unsigned widths x 4 signed widths x 8 boundary cases = 128 runs.
global ic_arg uchar 24
fn ic_num arg ulong to uint
n = argread arg ic_arg 0 len ic_arg
if or le n 0 gt n 3
exit 2
end
v = uint 0
for j ulong ulong n bound 3
c = uint get ic_arg j
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end
fn ic_width t uint to ulong
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 eq t 8
ret 32
end
ret 64
end
fn ic8 x uchar t uint to void
if eq t 6
y = byte x
ret
end
if eq t 7
y = short x
ret
end
if eq t 8
y = int x
ret
end
y = long x
end
fn ic16 x ushort t uint to void
if eq t 6
y = byte x
ret
end
if eq t 7
y = short x
ret
end
if eq t 8
y = int x
ret
end
y = long x
end
fn ic32 x uint t uint to void
if eq t 6
y = byte x
ret
end
if eq t 7
y = short x
ret
end
if eq t 8
y = int x
ret
end
y = long x
end
fn ic64 x ulong t uint to void
if eq t 6
y = byte x
ret
end
if eq t 7
y = short x
ret
end
if eq t 8
y = int x
ret
end
y = long x
end
fn ic_emit s uint t uint v ulong to void
ir_init
f = ir_fnew 2 0 8
b = ir_blk f
a = ir_res ir_op b 1 s v 0
o = ir_op b 78 t 5 2
ir_set o 0 ir_ftok f
ir_set o 1 a
tok = ir_otok o
cv = ir_op b 36 t 0 1
ir_set cv 0 a
z = ir_res ir_op b 1 8 0 0
o = ir_op b 63 0 0 2
ir_set o 0 tok
ir_set o 1 z
n = ir_wr
k = write 1 i_out 0 n
if ne k long n
exit 2
end
end
fn ic_umain to int
if ne argcnt 4
ret 2
end
s = ic_num 1
t = ic_num 2
j = ic_num 3
if or lt s 2 gt s 5
ret 2
end
if or lt t 6 gt t 9
ret 2
end
if gt j 7
ret 2
end
ws = ic_width s
mx = not ulong 0
if lt ws 64
mx = sub shl ulong 1 ws 1
end
hi = shl ulong 1 sub ic_width t 1
v = ulong 0
if eq j 1
v = sub hi 1
end
if eq j 2
v = hi
end
if eq j 3
v = add hi 1
end
if eq j 4
v = mx
end
if eq j 5
v = sub mx 1
end
if eq j 6
v = 1
end
if eq j 7
v = shl ulong 1 sub ws 1
end
if gt v mx
v = mx
end
ic_emit s t v
if eq s 2
ic8 uchar v t
end
if eq s 3
ic16 ushort v t
end
if eq s 4
ic32 uint v t
end
if eq s 5
ic64 v t
end
ret 0
end

fn ic_boundary t uint j ulong to f64
w = ic_width t
hi = mul f64 shl ulong 1 sub w 1 2.0f64
lo = f64 0.0
if ge t 6
hi = f64 shl ulong 1 sub w 1
lo = neg hi
end
if eq j 0
ret sub lo 1.0
end
if eq j 1
ret sub lo 0.5
end
if eq j 2
ret lo
end
if eq j 3
ret add lo 0.5
end
if eq j 4
ret add lo 1.0
end
if eq j 5
ret sub hi 1.0
end
if eq j 6
ret sub hi 0.5
end
if eq j 7
ret hi
end
if eq j 8
ret add hi 0.5
end
if eq j 9
ret add hi 1.0
end
note Adjacent representable values below and above the high boundary, including 64-bit widths.
u = bitcast ulong hi
if eq j 10
ret bitcast f64 sub u 1
end
if eq j 11
ret bitcast f64 add u 1
end
u = bitcast ulong lo
if eq j 12
if eq lo 0.0f64
ret bitcast f64 ulong 0x8000000000000001
end
ret bitcast f64 sub u 1
end
if eq j 13
ret bitcast f64 add u 1
end
if eq j 14
ret -0.5f64
end
ret 0.5f64
end
note Independent integer decoding of truncation range, not ngrun's float comparisons.
fn ic_floatbad s uint t uint bits ulong to bool
p = ulong 52
bias = ulong 1023
es = ulong 2047
sg = ne shr bits 63 0
if eq s 13
p = 23
bias = 127
es = 255
sg = ne shr bits 31 0
end
e = and shr bits p es
m = and bits sub shl ulong 1 p 1
if eq e es
ret true
end
if lt e bias
ret false
end
e = sub e bias
w = ic_width t
if lt t 6
ret or sg ge e w
end
if not sg
ret ge e sub w 1
end
if gt e sub w 1
ret true
end
if lt e sub w 1
ret false
end
if ge e p
ret ne m 0
end
ret ne shr m sub p e 0
end
fn ic_fmain s uint to int
t = ic_num 2
j = ic_num 3
if or lt t 2 gt t 9
ret 2
end
if gt j 15
ret 2
end
x = ic_boundary t ulong j
bits = bitcast ulong x
if eq s 13
bits = ulong bitcast uint f32 x
end
ic_emit s t bits
if ic_floatbad s t bits
ret 105
end
ret 0
end
fn main to int
if ne argcnt 4
ret 2
end
s = ic_num 1
if or eq s 13 eq s 14
ret ic_fmain s
end
ret ic_umain
end

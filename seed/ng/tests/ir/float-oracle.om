note SPDX-License-Identifier: Apache-2.0
note Build: cat seed/ng/src/ir.om seed/ng/tests/ir/float-oracle.om | seed/out/omc
note Native seeded-omc computations produce the expected bits in a checked IR unit.
note Neither ngrun nor any rn_ function is linked here. The only shared unit is the IR writer.
note RTZ integer oracle uses native nearest conversion then native convert-back comparison,
note independent of ngrun's leading-bit integer encoder. 1024 splitmix64 values per float width.
global fo_s uint 4
fn fo_const t uint x ulong to uint
ret ir_res ir_op get fo_s 0 1 t x 0
end
fn fo_un op uint t uint im ulong a uint to uint
o = ir_op get fo_s 0 op t im 1
ir_set o 0 a
ret ir_res o
end
fn fo_expect t uint v uint bits ulong to void
it = uint 5
if or eq t 13 eq t 4
it = 4
end
a = v
if or eq t 13 eq t 14
a = fo_un 37 it 0 v
end
b = fo_const it bits
o = ir_op get fo_s 0 30 1 0 2
ir_set o 0 a
ir_set o 1 b
c = ir_res o
q = ir_op get fo_s 0 82 0 14 2
ir_set q 0 get fo_s 1
ir_set q 1 c
put fo_s 1 ir_otok q
put fo_s 2 add get fo_s 2 1
end
fn fo_bcast t uint bits ulong to void
it = uint 5
if eq t 13
it = 4
end
a = fo_const it bits
b = fo_un 37 t 0 a
c = fo_un 37 it 0 b
expect = bitcast ulong bitcast f64 bits
if eq t 13
expect = ulong bitcast uint bitcast f32 uint bits
end
fo_expect it c expect
end
fn fo_special t uint j ulong to ulong
if eq t 13
if eq j 0
ret 0x00000000
end
if eq j 1
ret 0x80000000
end
if eq j 2
ret 0x7f800000
end
if eq j 3
ret 0xff800000
end
if eq j 4
ret 0x7fc00000
end
if eq j 5
ret 0xffc00000
end
if eq j 6
ret 0x7f800001
end
if eq j 7
ret 0xff800001
end
if eq j 8
ret 0x7fffffff
end
if eq j 9
ret 0xffffffff
end
if eq j 10
ret 0x00000001
end
if eq j 11
ret 0x80000001
end
if eq j 12
ret 0x007fffff
end
if eq j 13
ret 0x807fffff
end
if eq j 14
ret 0x00800000
end
if eq j 15
ret 0x80800000
end
if eq j 16
ret 0x7f7fffff
end
ret 0xff7fffff
end
if eq j 0
ret 0x0000000000000000
end
if eq j 1
ret 0x8000000000000000
end
if eq j 2
ret 0x7ff0000000000000
end
if eq j 3
ret 0xfff0000000000000
end
if eq j 4
ret 0x7ff8000000000000
end
if eq j 5
ret 0xfff8000000000000
end
if eq j 6
ret 0x7ff0000000000001
end
if eq j 7
ret 0xfff0000000000001
end
if eq j 8
ret 0x7fffffffffffffff
end
if eq j 9
ret 0xffffffffffffffff
end
if eq j 10
ret 0x0000000000000001
end
if eq j 11
ret 0x8000000000000001
end
if eq j 12
ret 0x000fffffffffffff
end
if eq j 13
ret 0x800fffffffffffff
end
if eq j 14
ret 0x0010000000000000
end
if eq j 15
ret 0x8010000000000000
end
if eq j 16
ret 0x7fefffffffffffff
end
ret 0xffefffffffffffff
end
fn fo_mix state ulong to ulong
z = add state 0x9e3779b97f4a7c15
z = mul xor z shr z 30 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 0x94d049bb133111eb
ret xor z shr z 31
end
fn fo_f2i t uint x f64 to ulong
if eq t 2
ret ulong uchar x
end
if eq t 3
ret ulong ushort x
end
if eq t 4
ret ulong uint x
end
if eq t 5
ret ulong x
end
if eq t 6
ret bitcast ulong long byte x
end
if eq t 7
ret bitcast ulong long short x
end
if eq t 8
ret bitcast ulong long int x
end
ret bitcast ulong long x
end
fn fo_intcase t uint s uint bits ulong to void
x = bitcast f64 bits
if eq s 13
x = f64 bitcast f32 uint bits
end
a = fo_const s bits
v = fo_un 36 t 0 a
expected = fo_f2i t x
note Compare signed integers as u64 raw bits, with canonical sign extension.
u = v
if eq t 9
u = fo_un 37 5 0 v
end
if or eq t 2 eq t 6
u = fo_un 36 5 0 v
end
if or eq t 3 eq t 7
u = fo_un 36 5 0 v
end
if or eq t 4 eq t 8
u = fo_un 36 5 0 v
end
if eq t 5
u = v
end
fo_expect 5 u expected
end
fn fo_round t uint mag ulong z bool to ulong
limit = mul f64 shl ulong 1 63 2.0f64
if eq t 14
v = f64 mag
b = bitcast ulong v
if z
if or ge v limit gt ulong v mag
b = sub b 1
end
end
ret b
end
v = f32 mag
b = ulong bitcast uint v
if z
if or ge f64 v limit gt ulong v mag
b = sub b 1
end
end
ret b
end
fn fo_i2f t uint s uint bits ulong im ulong to void
mag = bits
sg = ulong 0
if ge s 6
if lt bitcast long bits 0
mag = sub ulong 0 bits
sg = 0x8000000000000000
if eq t 13
sg = 0x80000000
end
end
end
expected = or sg fo_round t mag eq and im 3 1
a = fo_const s bits
v = fo_un 36 t im a
fo_expect t v expected
end
fn fo_narrow bits ulong im ulong to void
x = bitcast f64 bits
y = f32 x
if eq and im 3 1
if gt fabs f64 y fabs x
u = sub bitcast uint y 1
y = bitcast f32 u
end
end
if ne and im 4 0
if and eq fabs f64 y div 1.0f64 0.0f64 lt fabs x div 1.0f64 0.0f64
m = bitcast f32 uint 0x7f7fffff
y = m
if lt x 0.0f64
y = neg m
end
end
end
note NaN conversion payload is not specified. Compare the resulting classification only.
a = fo_const 14 bits
v = fo_un 36 13 im a
if ne x x
o = ir_op get fo_s 0 31 1 0 2
ir_set o 0 v
ir_set o 1 v
q = ir_op get fo_s 0 82 0 14 2
ir_set q 0 get fo_s 1
ir_set q 1 ir_res o
put fo_s 1 ir_otok q
put fo_s 2 add get fo_s 2 1
else
fo_expect 13 v ulong bitcast uint y
end
end
fn fo_width t uint to ulong
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 eq t 8
ret 32
end
ret 64
end
fn fo_boundary t uint j ulong to f64
w = fo_width t
hi = mul f64 shl ulong 1 sub w 1 2.0f64
lo = f64 0.0
if ge t 6
hi = f64 shl ulong 1 sub w 1
lo = neg hi
end
if eq j 0
ret sub lo 1.0
end
if eq j 1
ret sub lo 0.5
end
if eq j 2
ret lo
end
if eq j 3
ret add lo 0.5
end
if eq j 4
ret add lo 1.0
end
if eq j 5
ret sub hi 1.0
end
if eq j 6
ret sub hi 0.5
end
if eq j 7
ret hi
end
if eq j 8
ret add hi 0.5
end
if eq j 9
ret add hi 1.0
end
note Adjacent representable values below and above the high boundary, including 64-bit widths.
u = bitcast ulong hi
if eq j 10
ret bitcast f64 sub u 1
end
if eq j 11
ret bitcast f64 add u 1
end
u = bitcast ulong lo
if eq j 12
if eq lo 0.0f64
ret bitcast f64 ulong 0x8000000000000001
end
ret bitcast f64 sub u 1
end
if eq j 13
ret bitcast f64 add u 1
end
if eq j 14
ret -0.5f64
end
ret 0.5f64
end
fn fo_fmexp t uint a ulong b ulong c ulong fused bool to ulong
if eq t 13
x = bitcast f32 uint a
y = bitcast f32 uint b
z = bitcast f32 uint c
if fused
ret ulong bitcast uint fma x y z
end
p = mul x y
ret ulong bitcast uint add p z
end
x = bitcast f64 a
y = bitcast f64 b
z = bitcast f64 c
if fused
ret bitcast ulong fma x y z
end
p = mul x y
ret bitcast ulong add p z
end
fn fo_fmacase t uint a ulong b ulong c ulong to void
expected = fo_fmexp t a b c true
unfused = fo_fmexp t a b c false
if ne expected unfused
x = bitcast f64 expected
y = bitcast f64 unfused
if eq t 13
x = f64 bitcast f32 uint expected
y = f64 bitcast f32 uint unfused
end
if and eq x x eq y y
put fo_s 3 add get fo_s 3 1
end
end
va = fo_const t a
vb = fo_const t b
vc = fo_const t c
o = ir_op get fo_s 0 46 t 0 3
ir_set o 0 va
ir_set o 1 vb
ir_set o 2 vc
fo_expect t ir_res o expected
end
global fo_num uchar 24
text fo_msg0 "FLOATORACLE checks="
text fo_msg1 " fused_diff="
text fo_msg2 "\n"
fn fo_print n ulong to void
x = n
i = ulong 24
while true bound 24
i = sub i 1
put fo_num i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 fo_num i sub 24 i
ret
end
end
end
fn main to int
ir_init
f = ir_fnew 2 0 8
put fo_s 0 ir_blk f
put fo_s 1 ir_ftok f
for k ulong 2
s = uint 13
if eq k 1
s = 14
end
state = ulong 0x6e6772756e
for j ulong 1042
bits = fo_mix state
state = bits
if eq s 13
bits = and bits 0xffffffff
end
if lt j 18
bits = fo_special s j
end
fo_bcast s bits
fb = fo_mix bits
fc = fo_mix fb
if lt j 18
fb = 0x3ff0000000000000
fc = 0
if eq s 13
fb = 0x3f800000
end
end
if eq s 13
fb = and fb 0xffffffff
fc = and fc 0xffffffff
end
fo_fmacase s bits fb fc
for d uint 8
fo_intcase add d 2 s bits
end
if eq s 14
for m ulong 4
im = m
if ge m 2
im = add m 2
end
fo_narrow bits im
end
end
end
end
fo_fmacase 13 0x3f800001 0x3f7ffffe 0xbf800000
fo_fmacase 14 0x3ff0000000000001 0x3feffffffffffffe 0xbff0000000000000
for d uint 8
t = add d 2
for j ulong 16
x = fo_boundary t j
fo_intcase t 14 bitcast ulong x
fo_intcase t 13 ulong bitcast uint f32 x
end
w = fo_width t
mx = sub ulong 0 1
if lt w 64
mx = sub shl ulong 1 w 1
end
if ge t 6
mx = sub shl ulong 1 sub w 1 1
end
for j ulong 6
v = mx
if eq j 1
v = sub mx 1
end
if eq j 2
v = 0
end
if eq j 3
v = 1
end
if ge j 4
if ge t 6
v = sub ulong 0 shl ulong 1 sub w 1
if eq j 5
v = add v 1
end
end
end
for k uint 2
ft = add k 13
for m ulong 4
im = m
if ge m 2
im = add m 2
end
fo_i2f ft t v im
end
end
end
end
note Precision boundaries across every possible u64 exponent, both float widths and modes.
for e ulong 64
p = shl ulong 1 e
for j ulong 3
v = p
if eq j 1
v = sub p 1
end
if eq j 2
v = add p 1
end
for k uint 2
for m ulong 2
fo_i2f add k 13 5 v m
end
end
end
end
zero = fo_const 8 0
o = ir_op get fo_s 0 63 0 0 2
ir_set o 0 get fo_s 1
ir_set o 1 zero
k = write 2 fo_msg0 0 len fo_msg0
fo_print ulong get fo_s 2
k = write 2 fo_msg1 0 len fo_msg1
fo_print ulong get fo_s 3
k = write 2 fo_msg2 0 len fo_msg2
n = ir_wr
k = write 1 i_out 0 n
if ne k long n
ret 1
end
ret 0
end

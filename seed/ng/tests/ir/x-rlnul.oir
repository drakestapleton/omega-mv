omegair 1
type %t32 = array u8 1
type %t33 = ref view host %t32
type %t34 = array u8 16
type %t35 = ref edit host %t34
global @g0 %t32 zero
global @g1 %t34 zero
export @f0 flags 0 -> i32
block ^0
%1 = gaddr %t33 @g0
%2 = gaddr %t35 @g1
%3 = const u64 0
%4 = const u64 16
%5 = chk.slice 3 %0 %1 %3 %3
%6 = chk.slice 3 %5 %2 %3 %4
%7 %8 = host i64 133 %6 %1 %3 %3 %2 %3 %4
%9 = conv i32 0 %8
retv %7 %9
end

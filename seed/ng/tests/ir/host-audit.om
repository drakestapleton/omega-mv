note SPDX-License-Identifier: Apache-2.0
note Build with seed/ng/src/ir.om (OM-2). Usage: host-audit hostwords.tsv < seed/omc/omc.om
note Decodes the actual seeded kw function, not genkw.awk or a copied list of names.
note Closed host id set is the hostval/typing dispatch of the pinned compiler. Excludes exit=152,
note efi=178, qty=96, const=97, fma=227 and the OM-2 register words dit=225/scrub=226.
note The set ends at the scheduler words cpuset..getprio 236..240 (omc f4fa7951, OMEGESE s10).
global ha_buf uchar 2097152
global ha_tab ulong 256
global ha_kw ulong 256
global ha_nums ulong 8
global ha_path uchar 4096
global ha_tmp uchar 32
global ha_s ulong 8
text ha_fn "fn kw "
text ha_end "fn kw2 "
text ha_if "if eq w "
text ha_pk "packed = "
text ha_pk0 "packed = or ulong "
text ha_ret "ret "

text ha_miss "MISSING\t"
text ha_extra "EXTRA\t"
text ha_chang "CHANGED\t"
text ha_rows "HOSTTABLE rows="
text ha_diff " differences="
fn ha_match p ulong z ulong word view uchar * to bool
if gt len word sub z p
ret false
end
for j ulong len word bound 64
if ne get ha_buf add p j get word j
ret false
end
end
ret true
end
fn ha_num p ulong z ulong to ulong
v = ulong 0
for j ulong sub z p bound 128
c = ulong get ha_buf add p j
if or lt c 48 gt c 57
break
end
v = add mul v 10 sub c 48
end
ret v
end
fn ha_word p ulong z ulong to ulong
v = ulong 0
for j ulong 8
if ge add p j z
break
end
c = ulong get ha_buf add p j
if or eq c 9 eq c 32
break
end
v = or v shl c mul j 8
end
ret v
end
fn ha_read fd int to ulong
n = ulong 0
while lt n len ha_buf bound 2097153
k = read fd ha_buf n sub len ha_buf n
if lt k 0
exit 2
end
if eq k 0
ret n
end
n = add n ulong k
end
exit 2
end
fn ha_lend p ulong n ulong to ulong
j = p
while lt j n bound 2097153
if eq get ha_buf j 10
ret j
end
j = add j 1
end
ret j
end
fn ha_digits p ulong z ulong to ulong
n = ulong 0
j = p
while lt j z bound 4096
c = get ha_buf j
if and ge c 48 le c 57
if ge n 8
exit 2
end
put ha_nums n ha_num j z
n = add n 1
while lt j z bound 128
c = get ha_buf j
if or lt c 48 gt c 57
break
end
j = add j 1
end
else
j = add j 1
end
end
ret n
end
fn ha_host id ulong to bool
if or eq id 53 eq id 54
ret true
end
if and ge id 100 le id 177
ret ne id 152
end
if and ge id 197 le id 200
ret true
end
if and ge id 220 le id 222
ret true
end
if eq id 224
ret true
end
if and ge id 228 le id 233
ret true
end
if eq id 235
ret true
end
ret and ge id 236 le id 240
end
fn ha_table n ulong to void
p = add ha_lend 0 n 1
while lt p n bound 257
z = ha_lend p n
id = ha_num p z
if or eq id 0 ge id 256
exit 2
end
q = p
while and lt q z ne get ha_buf q 9 bound 128
q = add q 1
end
if eq q z
exit 2
end
if ne get ha_tab id 0
exit 2
end
put ha_tab id ha_word add q 1 z
p = add z 1
end
end
fn ha_source n ulong to void
p = ulong 0
active = false
word = ulong 0
packed = ulong 0
while lt p n bound 65536
z = ha_lend p n
if ha_match p z ha_fn
active = true
end
if ha_match p z ha_end
ret
end
if active
if ha_match p z ha_pk
nd = ha_digits p z
if ha_match p z ha_pk0
if ne nd 3
exit 2
end
packed = or get ha_nums 0 shl get ha_nums 1 get ha_nums 2
else
if ne nd 2
exit 2
end
packed = or packed shl get ha_nums 0 get ha_nums 1
end
end
if ha_match p z ha_if
q = add p len ha_if
word = packed
c = get ha_buf q
if and ge c 48 le c 57
word = ha_num q z
end
end
if ha_match p z ha_ret
id = ha_num add p len ha_ret z
if ha_host id
if eq word 0
exit 2
end
put ha_kw id word
end
word = 0
end
end
p = add z 1
end
exit 2
end
fn ha_print n ulong to void
v = n
i = ulong 32
while true bound 32
i = sub i 1
put ha_tmp i uchar add 48 rem v 10
v = div v 10
if eq v 0
k = write 1 ha_tmp i sub 32 i
ret
end
end
end
fn ha_name word ulong to void
n = ulong 0
v = word
while ne v 0 bound 8
put ha_tmp n uchar and v 255
v = shr v 8
n = add n 1
end
k = write 1 ha_tmp 0 n
end
fn ha_tabchar to void
put ha_tmp 0 9
k = write 1 ha_tmp 0 1
end
fn ha_newline to void
put ha_tmp 0 10
k = write 1 ha_tmp 0 1
end
fn main to int
if ne argcnt 2
ret 2
end
m = argread 1 ha_path 0 len ha_path
if or le m 0 ge m long len ha_path
ret 2
end
fd = fopen ha_path 0 ulong m 524288 0
if lt fd 0
ret 2
end
n = ha_read int fd
k = fclose int fd
ha_table n
n = ha_read 0
ha_source n
rows = ulong 0
diff = ulong 0
for id ulong 256
w = get ha_kw id
t = get ha_tab id
if ne w 0
rows = add rows 1
end
if ne w t
diff = add diff 1
if eq t 0
k = write 1 ha_miss 0 len ha_miss
else
if eq w 0
k = write 1 ha_extra 0 len ha_extra
else
k = write 1 ha_chang 0 len ha_chang
end
end
ha_print id
ha_tabchar
ha_name w
ha_tabchar
ha_name t
ha_newline
end
end
k = write 1 ha_rows 0 len ha_rows
ha_print rows
k = write 1 ha_diff 0 len ha_diff
ha_print diff
ha_newline
if ne diff 0
ret 1
end
ret 0
end

note the places of FROM in b1[0, g_n 5)
fn gn_mcount to ulong
k = get g_n 27
n = get g_n 5
c = ulong 0
if lt n k
ret 0
end
p = ulong 0
while le add p k n bound 16777217
if gn_mat p k

gn_pclr
gn_pw 0
gn_pw 1
fd = gn_rdonly
if lt fd 0
ret false
end
k = gn_rdn fd 2 1048576
gn_fclo fd
s = ulong 0
for i ulong k bound 1048576
if eq get g_b2 i 10
if gt i add s 65
gn_pclr
for j ulong sub i add s 65 bound 4096
gn_pc ulong get g_b2 add add s 65 j
end
if not gn_cat

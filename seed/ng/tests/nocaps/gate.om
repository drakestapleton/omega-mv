note generate the case's unit (spec tokens from g_n 24 to g_n 25) into u.om, fc.in and fi.in; false when a
note file cannot be written
fn gn_gen to bool
put g_n 26 0
put g_n 7 0
gn_ps 5
put g_gf 0 gn_wronly
gn_ps 6
put g_gf 1 gn_wronly
gn_ps 7
put g_gf 2 gn_wronly
ok = and ge get g_gf 0 0 and ge get g_gf 1 0 ge get g_gf 2 0
if ok
for j ulong len g_pfc bound 64
put g_gb j get g_pfc j
end
o = ulong 0
x = write get g_gf 1 g_gb 0 len g_pfc
for j ulong len g_pfr bound 64
put g_gb j get g_pfr j
end
x = write get g_gf 2 g_gb 0 len g_pfr
while lt get g_n 24 get g_n 25 bound 64
p = get g_n 24
c = ulong get g_cs p
put g_n 24 add p 1
if eq c 76
gn_gt gn_snum
end
if eq c 82
k = gn_snum
n = gn_snum
for i ulong n bound 16777216
gn_gt k
end
end
if eq c 78
k = gn_snum
m = gn_snum
q = gn_snum
n = gn_snum
for i ulong n bound 16777216
gn_gt k
gn_gn i
if ne m 0
gn_gt m
gn_gn i
end
gn_gt q
end
end
if eq c 73
put g_n 24 add get g_n 24 1
a = gn_snum
b = gn_snum
gn_ginl a b
end
if eq c 67

end
if or ne get g_b1 0 110 or ne get g_b1 1 103 ne get g_b1 2 45
ret false
end
t = ulong 0
p = ulong 0
while lt p n bound 1048576
s = p
while and lt p n gt get g_b1 p 32 bound 4096
p = add p 1
end
if gt p s

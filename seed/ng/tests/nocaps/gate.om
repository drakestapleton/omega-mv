note ---- one case -----------------------------------------------------------------------------------------
note fields of the case line at g_n 8: name, WANT, OMC, KIND; the spec's span into g_n 24 and 25; the KIND letter
note (0 at the end of the table, 1 for a malformed line)
fn gn_line to ulong
p = get g_n 8
e = len g_cs
if ge p e
ret 0
end
q = p
while and lt q e ne get g_cs q 10 bound 4096
q = add q 1
end
put g_n 8 add q 1
s = p
while and lt p q ne get g_cs p 32 bound 256
p = add p 1
end
put g_n 14 s
put g_n 15 p
put g_n 24 add p 1
put g_n 25 q
ret 2
end
note the current case: the unit generated, then judged by OMC and its binary (gn_omcp), ng's check (gn_chk) and,
note for KIND r, ng's front-ir, a64 and the ELF (gn_ngrun); a line per case. g_n 37..44: check, ir, a64 and elf
note milliseconds, omc's exit, its binary's, ng's check exit, the ELF's
fn gn_case kind ulong want ulong oc ulong to void
put g_n 13 0
put g_n 16 0
if eq get g_n 12 0
put g_n 10 add get g_n 10 1
end
for i ulong 8
put g_n add 37 i 0
end
if not gn_gen
gn_fail 39
gn_nl
ret
end
if not gn_omcp kind want oc
ret
end
if not gn_chk kind
ret
end
if or eq kind 114 eq kind 105
if not gn_ngrun want eq kind 114
ret
end
end
if eq get g_n 12 0
gn_say 1
gn_name
gn_say 34
gn_num get g_n 41
gn_c 47
gn_num get g_n 42
gn_say 35
gn_num get g_n 43
gn_c 47
gn_num get g_n 44
gn_say 40
gn_num get g_n 26
gn_say 28
gn_num get g_n 37
gn_say 29
gn_num get g_n 38
gn_say 30
gn_num get g_n 39
gn_say 31
gn_num get g_n 40
gn_nl
end
end
note OMC on u.om must exit oc; when 0 (and KIND is not d) its binary must exit WANT (+ g_n 23)
fn gn_omcp kind ulong want ulong oc ulong to bool
x = gn_omc 5 11 12
put g_n 41 x
if gn_dl
ret false
end
if ne x oc
gn_failv 2 x oc
ret false
end
if or ne oc 0 eq kind 100
ret true
end
a = gn_run 11 16 17 false 19
put g_n 42 a
if gn_dl
ret false
end
w = add want get g_n 23
if ne a w
gn_failv 3 a w
ret false
end
ret true
end
note ng @ng front-check: exit 0, or for KIND d omc's exit and omc's stderr bytes
fn gn_chk kind ulong to bool
t0 = monons
y = gn_run get g_n 29 6 17 false 13
put g_n 37 gn_ms t0
put g_n 43 y
if gn_dl
ret false
end
if ne kind 100
if ne y 0
gn_failv 4 y 0
ret false
end
ret true
end
x = get g_n 41
if ne y x
gn_failv 4 y x
ret false
end
if not gn_fcmp 12 13
gn_fail 9
if eq get g_n 12 0
gn_nl
end
ret false
end
ret true
end
note ng @ng front-ir, then (full) @ng a64 of its ΩIR, then the ELF: exits 0, 0 and WANT (+ g_n 23)
fn gn_ngrun want ulong full bool to bool
t0 = monons
z = gn_run get g_n 29 7 8 false 14
put g_n 38 gn_ms t0
if gn_dl
ret false
end
if ne z 0
gn_failv 5 z 0
ret false
end
if not full
ret true
end
if not gn_pref 0 8 9
gn_fail 39
gn_nl
ret false
end
t0 = monons
z = gn_run get g_n 29 9 10 true 15
put g_n 39 gn_ms t0
if gn_dl
ret false
end
if ne z 0
gn_failv 6 z 0
ret false
end
t0 = monons
b = gn_run 10 16 17 false 19
put g_n 40 gn_ms t0
put g_n 44 b
if gn_dl
ret false
end
w = add want get g_n 23
if ne b w
gn_failv 7 b w
ret false
end
ret true
end
note a child of the current case passed the deadline: NOT_RUN (g_n 13 = 2)
fn gn_dl to bool
if eq get g_n 16 0
ret false
end
put g_n 13 2
if eq get g_n 12 0
gn_say 36
gn_name
gn_say 37
gn_nl
end
ret true
end
note the next field of the case line (a number) at g_n 24
fn gn_fnum to ulong
ret gn_snum
end
note every case (when only is not 0, the case with that number first and, when stop, only until one fails);
note true when some case failed
fn gn_all only ulong stop bool to bool
hit = false
put g_n 8 0
k = ulong 0
while true bound 4096
r = gn_line
if eq r 0
break
end
k = add k 1
want = gn_fnum
oc = gn_fnum
kind = ulong get g_cs get g_n 24
put g_n 24 add get g_n 24 2
if or eq only 0 eq only k
gn_case kind want oc
if eq get g_n 13 1
hit = true
if eq get g_n 12 0
put g_n 11 add get g_n 11 1
end
if stop
ret true
end
end
if eq get g_n 13 2
if eq get g_n 12 0
put g_n 21 add get g_n 21 1
end
end
end
end
ret hit
end


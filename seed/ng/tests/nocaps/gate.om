put g_n 33 gn_tnum s p 61
end
if eq t 3
put g_n 32 gn_tnum s p 61
end
if ge t 6
h = gn_tnum s p 47
if gt h get g_n 34
put g_n 34 h
put g_n 35 s
put g_n 36 p
end
end
t = add t 1
end
p = add p 1
end
ret ge t 6
end

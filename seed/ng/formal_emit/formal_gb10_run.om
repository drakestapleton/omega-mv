note SPDX-License-Identifier: Apache-2.0
note seed/ng/formal_emit/formal_gb10_run.om
note Coordinator Phase 2 Silicon Pass B: Live Lean 4.36.0 + W^X 0500-RX Gated Physical GB10 Runner.
note Compose after:
note   si/directives/om2.om gpu/nvidia/native/nvrm/context.om gpu/nvidia/native/blackwell/vector.om
note   gpu/nvidia/native/blackwell/launch.om om/encoder/bw_enc_sm121.om
note   seed/ng/formal_emit/formal_gb10_run.om

const FG_NONE ulong 18446744073709551615
const FG_SENTINEL ulong 3735928559
const FG_OP_ADD ulong 1
const FG_OP_SUB ulong 2
const FG_OP_MUL ulong 3

const FG_ERR_USAGE int 70
const FG_ERR_IO int 74
const FG_ERR_LEAN int 76
const FG_ERR_UNIT int 77
const FG_ERR_GPU int 75

global fg_emit_bin uchar 2048
global fg_emit_n ulong 1
global fg_lean_bin uchar 2048
global fg_lean_n ulong 1
global fg_unit_p uchar 2048
global fg_unit_n ulong 1
global fg_chips_p uchar 2048
global fg_chips_n ulong 1
global fg_work_p uchar 2048
global fg_work_n ulong 1

global fg_path_a uchar 4096
global fg_path_an ulong 1
global fg_path_b uchar 4096
global fg_path_bn ulong 1
global fg_path_c uchar 4096
global fg_path_cn ulong 1
global fg_path_d uchar 4096
global fg_path_dn ulong 1
global fg_path_w uchar 4096
global fg_path_wn ulong 1
global fg_abuf uchar 4096

global fg_av uchar 16384
global fg_av_n ulong 1
global fg_wait uchar 8
global fg_outbuf uchar 65536
global fg_outlen ulong 1
global fg_unitbuf uchar 65536
global fg_unitlen ulong 1

note parsed @ir_fold: 0=A 1=B 2=C 3=op1 4=op2 5=exp
global fg_cfg ulong 8
global fg_ins ulong 8192
global fg_phys ulong 288
global fg_code uchar 16384
global fg_out_map long 1
global fg_cmd_len uint 1
global fg_dig uchar 24

text fg_use "usage: formal_gb10_run <LEAN_EMIT> <LEAN_BIN> <UNIT> <CHIPS> <WORKDIR>\n"
text fg_opt_u "--unit"
text fg_opt_o "--out"
text fg_opt_co "--cert-out"
text fg_opt_ln "--lean"
text fg_opt_wd "--workdir"
text fg_opt_ch "--chips"
text fg_s_rx "/unit.rx"
text fg_s_ln "/unit.lean"
text fg_s_wd "/wd"
text fg_s_out "/lean_emit.out"
text fg_s_err "/lean_emit.err"
text fg_p_pass "LEAN_EMIT PASS"
text fg_p_std "axioms=STANDARD_ONLY"
text fg_p_wx "wx=0500_RX"
text fg_p_lrc "lean_rc=0"
text fg_tag_fold "@ir_fold "
text fg_op_add_s "add"
text fg_op_sub_s "sub"
text fg_op_mul_s "mul"

text fg_m_ref "FORMAL_GB10_REFUSE stage="
text fg_m_rc " rc="
text fg_m_auth "FORMAL_GB10 LEAN_PASS=1 wx=0500_RX axioms=STANDARD_ONLY rx_exit="
text fg_m_exp " exp="
text fg_m_pass "FORMAL_GB10_PASS cpu_rx="
text fg_m_gpu " gb10_sm121="
text fg_m_sbyt " sass_bytes="
text fg_m_nl "\n"

fn fg_wrt fd int s view uchar * to void
  p = ulong 0
  n = len s
  while lt p n bound 4096
    k = write fd s p sub n p
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn fg_wrt_u fd int v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put fg_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      w = write fd fg_dig p sub 24 p
      ret
    end
  end
end

fn fg_fail stage ulong code int to void
  fg_wrt 2 fg_m_ref
  fg_wrt_u 2 stage
  fg_wrt 2 fg_m_rc
  fg_wrt_u 2 ulong code
  fg_wrt 2 fg_m_nl
  exit code
end

fn fg_copy_cli dst ulong idx ulong to bool
  if ge idx ulong argcnt
    ret false
  end
  n = argread idx fg_abuf 0 4095
  if le n 0
    ret false
  end
  un = ulong n
  if gt un 2040
    ret false
  end
  for i ulong un bound 2048
    b = get fg_abuf i
    if eq dst 0
      put fg_emit_bin i b
    end
    if eq dst 1
      put fg_lean_bin i b
    end
    if eq dst 2
      put fg_unit_p i b
    end
    if eq dst 3
      put fg_chips_p i b
    end
    if eq dst 4
      put fg_work_p i b
    end
  end
  if eq dst 0
    put fg_emit_n 0 un
  end
  if eq dst 1
    put fg_lean_n 0 un
  end
  if eq dst 2
    put fg_unit_n 0 un
  end
  if eq dst 3
    put fg_chips_n 0 un
  end
  if eq dst 4
    put fg_work_n 0 un
  end
  ret true
end

fn fg_build_work_path dst ulong suf view uchar * to void
  wn = get fg_work_n 0
  sn = len suf
  for i ulong wn bound 2048
    b = get fg_work_p i
    if eq dst 0
      put fg_path_a i b
    end
    if eq dst 1
      put fg_path_b i b
    end
    if eq dst 2
      put fg_path_c i b
    end
    if eq dst 3
      put fg_path_d i b
    end
    if eq dst 4
      put fg_path_w i b
    end
  end
  for j ulong sn bound 512
    sb = get suf j
    if eq dst 0
      put fg_path_a add wn j sb
    end
    if eq dst 1
      put fg_path_b add wn j sb
    end
    if eq dst 2
      put fg_path_c add wn j sb
    end
    if eq dst 3
      put fg_path_d add wn j sb
    end
    if eq dst 4
      put fg_path_w add wn j sb
    end
  end
  tot = add wn sn
  if eq dst 0
    put fg_path_an 0 tot
  end
  if eq dst 1
    put fg_path_bn 0 tot
  end
  if eq dst 2
    put fg_path_cn 0 tot
  end
  if eq dst 3
    put fg_path_dn 0 tot
  end
  if eq dst 4
    put fg_path_wn 0 tot
  end
end

fn fg_av_reset to void
  put fg_av_n 0 2
end

fn fg_av_cnt cnt ulong to void
  put fg_av 0 uchar and cnt 255
  put fg_av 1 uchar and shr cnt 8 255
end

fn fg_av_lit s view uchar * to void
  p = get fg_av_n 0
  n = len s
  put fg_av p uchar and n 255
  put fg_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put fg_av add p i get s i
  end
  put fg_av_n 0 add p n
end

fn fg_av_arg kind ulong to void
  p = get fg_av_n 0
  n = ulong 0
  if eq kind 0
    n = get fg_emit_n 0
  end
  if eq kind 1
    n = get fg_lean_n 0
  end
  if eq kind 2
    n = get fg_unit_n 0
  end
  if eq kind 3
    n = get fg_chips_n 0
  end
  if eq kind 4
    n = get fg_path_an 0
  end
  if eq kind 5
    n = get fg_path_bn 0
  end
  if eq kind 6
    n = get fg_path_wn 0
  end
  put fg_av p uchar and n 255
  put fg_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    b = uchar 0
    if eq kind 0
      b = get fg_emit_bin i
    end
    if eq kind 1
      b = get fg_lean_bin i
    end
    if eq kind 2
      b = get fg_unit_p i
    end
    if eq kind 3
      b = get fg_chips_p i
    end
    if eq kind 4
      b = get fg_path_a i
    end
    if eq kind 5
      b = get fg_path_b i
    end
    if eq kind 6
      b = get fg_path_w i
    end
    put fg_av add p i b
  end
  put fg_av_n 0 add p n
end

fn fg_run_child acnt ulong to long
  fg_av_cnt acnt
  pid = fork
  if lt pid 0
    ret long -1
  end
  if eq pid 0
    fo = fopen fg_path_c 0 get fg_path_cn 0 577 420
    if lt fo 0
      exit 125
    end
    d1 = dupfd int fo 1 0
    fe = fopen fg_path_d 0 get fg_path_dn 0 577 420
    if lt fe 0
      exit 125
    end
    d2 = dupfd int fe 2 0
    r = execprog fg_av 0 get fg_av_n 0
    exit 127
  end
  w = waitpid int pid fg_wait 0 4 0
  if ne w pid
    ret long -1
  end
  if ne get fg_wait 0 0
    ret long -1
  end
  ret long get fg_wait 1
end

fn fg_slurp_out to void
  put fg_outlen 0 0
  fo = fopen fg_path_c 0 get fg_path_cn 0 0 0
  if lt fo 0
    ret
  end
  tot = ulong 0
  while lt tot 65500 bound 256
    r = read int fo fg_outbuf tot sub 65500 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose int fo
  put fg_outlen 0 tot
end

fn fg_out_contains pat view uchar * to bool
  n = get fg_outlen 0
  m = len pat
  if gt m n
    ret false
  end
  lim = add sub n m 1
  for i ulong lim bound 65536
    ok = true
    for j ulong m bound 128
      if ne get fg_outbuf add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn fg_read_unit to bool
  fd = fopen fg_unit_p 0 get fg_unit_n 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot 65500 bound 256
    r = read int fd fg_unitbuf tot sub 65500 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose int fd
  put fg_unitlen 0 tot
  ret gt tot 0
end

fn fg_skip_sp pos ulong lim ulong to ulong
  p = pos
  while lt p lim bound 4096
    b = get fg_unitbuf p
    if ne b 32
      ret p
    end
    p = add p 1
  end
  ret p
end

fn fg_tok_op pos ulong lim ulong to ulong
  if le sub lim pos 2
    ret 0
  end
  ok_add = true
  ok_sub = true
  ok_mul = true
  for i ulong 3
    b = get fg_unitbuf add pos i
    if ne b get fg_op_add_s i
      ok_add = false
    end
    if ne b get fg_op_sub_s i
      ok_sub = false
    end
    if ne b get fg_op_mul_s i
      ok_mul = false
    end
  end
  if ok_add
    ret FG_OP_ADD
  end
  if ok_sub
    ret FG_OP_SUB
  end
  if ok_mul
    ret FG_OP_MUL
  end
  ret 0
end

fn fg_parse_u64 pos ulong lim ulong outv edit ulong 1 to ulong
  p = fg_skip_sp pos lim
  if ge p lim
    ret FG_NONE
  end
  v = ulong 0
  cnt = ulong 0
  while lt p lim bound 32
    b = get fg_unitbuf p
    if or lt b 48 gt b 57
      break
    end
    v = add mul v 10 sub ulong b 48
    p = add p 1
    cnt = add cnt 1
  end
  if eq cnt 0
    ret FG_NONE
  end
  put outv 0 v
  ret p
end

fn fg_parse_fold to bool
  n = get fg_unitlen 0
  m = len fg_tag_fold
  if lt n add m 5
    ret false
  end
  found = ulong FG_NONE
  lim = add sub n m 1
  for i ulong lim bound 65536
    is_sol = false
    if eq i 0
      is_sol = true
    else
      if eq get fg_unitbuf sub i 1 10
        is_sol = true
      end
    end
    if is_sol
      ok = true
      for j ulong m bound 32
        if ne get fg_unitbuf add i j get fg_tag_fold j
          ok = false
          break
        end
      end
      if ok
        found = add i m
        break
      end
    end
  end
  if eq found FG_NONE
    ret false
  end
  eol = found
  while lt eol n bound 256
    if eq get fg_unitbuf eol 10
      break
    end
    eol = add eol 1
  end
  tmp = new ulong 1 0
  p = fg_parse_u64 found eol tmp
  if eq p FG_NONE
    ret false
  end
  put fg_cfg 0 get tmp 0
  p = fg_parse_u64 p eol tmp
  if eq p FG_NONE
    ret false
  end
  put fg_cfg 1 get tmp 0
  p = fg_parse_u64 p eol tmp
  if eq p FG_NONE
    ret false
  end
  put fg_cfg 2 get tmp 0
  p = fg_skip_sp p eol
  op1 = fg_tok_op p eol
  if eq op1 0
    ret false
  end
  put fg_cfg 3 op1
  p = fg_skip_sp add p 3 eol
  op2 = fg_tok_op p eol
  if eq op2 0
    ret false
  end
  put fg_cfg 4 op2
  p = fg_parse_u64 add p 3 eol tmp
  if eq p FG_NONE
    ret false
  end
  put fg_cfg 5 get tmp 0
  ret true
end

fn fg_qcw st ulong wb ulong rbar ulong wt ulong yld ulong to ulong
  a = or shl st 9 shl yld 13
  b = or shl wb 14 shl rbar 17
  ret or or a b shl wt 20
end

fn fg_set_ins idx ulong op ulong d ulong s1 ulong s2 ulong to void
  b = mul idx 8
  put fg_ins b op
  put fg_ins add b 1 d
  put fg_ins add b 2 s1
  put fg_ins add b 3 s2
  put fg_ins add b 4 FG_NONE
  put fg_ins add b 5 FG_NONE
  put fg_ins add b 6 0
  put fg_ins add b 7 0
end

fn fg_set_ctl idx ulong s3 ulong uregv ulong immv ulong ctw ulong to void
  b = mul idx 8
  put fg_ins add b 4 s3
  put fg_ins add b 5 uregv
  put fg_ins add b 6 or and immv 4294967295 shl ctw 32
end

fn fg_encode_from_ins to ulong
  lins = new ulong 8192 0
  lphys = new ulong 288 0
  lcode = new uchar 16384 0
  for i ulong 88
    put lins i get fg_ins i
  end
  for i ulong 288
    put lphys i get fg_phys i
  end
  lnb = bw_enc_sm121 lins lphys 11 1 lcode
  for i ulong lnb bound 16384
    put fg_code i get lcode i
  end
  ret lnb
end

fn fg_emit_sm121 to ulong
  for i ulong 288
    put fg_phys i i
  end
  op1 = get fg_cfg 3
  op2 = get fg_cfg 4
  immA = and get fg_cfg 0 4294967295
  immB = and get fg_cfg 1 4294967295
  immC = and get fg_cfg 2 4294967295
  sop1 = ulong 14
  if eq op1 FG_OP_SUB
    immB = and sub 4294967296 immB 4294967295
  end
  if eq op1 FG_OP_MUL
    sop1 = ulong 8
  end
  sop2 = ulong 8
  if ne op2 FG_OP_MUL
    sop2 = ulong 14
    if eq op2 FG_OP_SUB
      immC = and sub 4294967296 immC 4294967295
    end
  end
  cAlu = fg_qcw 6 7 7 0 0
  fg_set_ins 0 7 4 FG_NONE FG_NONE
  fg_set_ctl 0 FG_NONE 4 856 fg_qcw 4 2 7 0 1
  fg_set_ins 1 5 0 FG_NONE FG_NONE
  fg_set_ctl 1 FG_NONE 4 896 fg_qcw 4 0 7 0 1
  fg_set_ins 2 0 FG_NONE FG_NONE FG_NONE
  fg_set_ctl 2 FG_NONE FG_NONE 0 fg_qcw 6 7 7 7 0
  fg_set_ins 3 2 4 FG_NONE FG_NONE
  fg_set_ctl 3 FG_NONE FG_NONE immA cAlu
  fg_set_ins 4 2 8 FG_NONE FG_NONE
  fg_set_ctl 4 FG_NONE FG_NONE immB cAlu
  fg_set_ins 5 2 12 FG_NONE FG_NONE
  fg_set_ctl 5 FG_NONE FG_NONE immC cAlu
  s3a = ulong FG_NONE
  if eq sop1 8
    s3a = ulong 255
  end
  fg_set_ins 6 sop1 16 4 8
  fg_set_ctl 6 s3a FG_NONE 0 cAlu
  s3b = ulong FG_NONE
  if eq sop2 8
    s3b = ulong 255
  end
  fg_set_ins 7 sop2 20 16 12
  fg_set_ctl 7 s3b FG_NONE 0 cAlu
  fg_set_ins 8 12 FG_NONE 0 20
  fg_set_ctl 8 FG_NONE 4 0 fg_qcw 4 7 1 0 1
  fg_set_ins 9 0 FG_NONE FG_NONE FG_NONE
  fg_set_ctl 9 FG_NONE FG_NONE 0 fg_qcw 6 7 7 2 0
  fg_set_ins 10 45 FG_NONE FG_NONE FG_NONE
  fg_set_ctl 10 FG_NONE FG_NONE 0 1042944
  ret fg_encode_from_ins
end

fn fg_gpu_init_and_load nb ulong to bool
  if not nvfull
    ret false
  end
  if not nvchan
    ret false
  end
  for i ulong 5
    m = nvalloc 65536 false
    if le m 0
      ret false
    end
    put gbmem i m
  end
  om = nvalloc 65536 true
  if le om 0
    ret false
  end
  put fg_out_map 0 om
  put gbmem 5 om
  put gbmem 6 om
  put gbmem 7 om
  ret eq mapwrite get gbmem 4 0 fg_code 0 nb long nb
end

fn fg_gpu_build_cmd to bool
  gbqmd 1
  a = mapaddr get gbmem 4
  put gbq1 32 gblo shr a 4
  put gbq1 33 or uint and shr a 36 2097151 20971520
  put gbq1 59 gblo shr a 8
  put gbq1 34 or uint 65536 uint 32
  put gbq1 35 or uint 131073 shl uint 64 8
  put gbq1 36 78923784
  put gbq1 37 0
  put gbq1 39 1
  put gbq1 40 1
  put gbq1 41 1
  put gbcb 216 32
  put gbcb 220 1
  put gbcb 221 1
  put gbcb 222 1
  cb = mapaddr get gbmem 1
  endva = add cb 908
  put gbcb 212 gbhi endva
  put gbcb 213 gblo endva
  put gbused 0 0
  gbsetup
  gbmth 0 40 4
  gbemit 0
  gbemit 0
  gbemit 0
  gbemit 2281701376
  gbdma cb 224
  for j ulong 224
    gbemit get gbcb j
  end
  outVa = mapaddr get fg_out_map 0
  gbdma add cb 896 3
  gbemit gblo outVa
  gbemit gbhi outVa
  gbemit 0
  q = mapaddr get gbmem 2
  gbinline q false
  gbdma add q 8192 1
  gbemit 1
  gbinline add q 4096 true
  gbrel add mapaddr get gbmem 3 32 6
  gbtail
  nb = get gbused 0
  if ne mapwrite get gbmem 0 0 gbcmd 0 nb long nb
    ret false
  end
  put fg_cmd_len 0 uint div nb 4
  ret true
end

fn fg_gpu_exec_wait to bool
  r0 = mapset get fg_out_map 0 0 4 FG_SENTINEL
  r1 = mapset get gbmem 2 8192 4 0
  r2 = mapset get gbmem 3 0 4 0
  r3 = mapset get gbmem 3 16 4 0
  if not nvsend get gbmem 0 0 get fg_cmd_len 0
    ret false
  end
  t0 = monons
  while lt ulong sub monons t0 5000000000 bound 2000000
    if eq mapget get gbmem 3 16 4 1179010630
      put nvret 0 get nvput 0
      ret eq mapget get gbmem 3 0 4 1145324612
    end
    rs = sleepns long 5000
  end
  ret false
end

fn main to int
  if lt uint argcnt 6
    fg_wrt 2 fg_use
    ret FG_ERR_USAGE
  end
  for k ulong 5
    if not fg_copy_cli k add k 1
      fg_fail 1 FG_ERR_USAGE
    end
  end
  if not fg_read_unit
    fg_fail 2 FG_ERR_IO
  end
  if not fg_parse_fold
    fg_fail 3 FG_ERR_UNIT
  end
  fg_build_work_path 0 fg_s_rx
  fg_build_work_path 1 fg_s_ln
  fg_build_work_path 2 fg_s_out
  fg_build_work_path 3 fg_s_err
  fg_build_work_path 4 fg_s_wd

  fg_av_reset
  fg_av_arg 0
  fg_av_lit fg_opt_u
  fg_av_arg 2
  fg_av_lit fg_opt_o
  fg_av_arg 4
  fg_av_lit fg_opt_co
  fg_av_arg 5
  fg_av_lit fg_opt_ln
  fg_av_arg 1
  fg_av_lit fg_opt_wd
  fg_av_arg 6
  fg_av_lit fg_opt_ch
  fg_av_arg 3
  rc1 = fg_run_child 13
  if ne rc1 0
    if gt rc1 0
      fg_fail 4 int rc1
    end
    fg_fail 4 FG_ERR_LEAN
  end
  fg_slurp_out
  if or not fg_out_contains fg_p_pass or not fg_out_contains fg_p_std or not fg_out_contains fg_p_wx not fg_out_contains fg_p_lrc
    fg_fail 5 FG_ERR_LEAN
  end

  fg_av_reset
  fg_av_arg 4
  rx_rc = fg_run_child 1
  expV = get fg_cfg 5
  if ne rx_rc long and expV 255
    fg_fail 6 FG_ERR_UNIT
  end

  nb = fg_emit_sm121
  if eq nb 0
    fg_fail 7 FG_ERR_UNIT
  end

  fg_wrt 1 fg_m_auth
  fg_wrt_u 1 ulong rx_rc
  fg_wrt 1 fg_m_exp
  fg_wrt_u 1 expV
  fg_wrt 1 fg_m_nl

  if not fg_gpu_init_and_load nb
    st0 = nvstop
    fg_fail 8 FG_ERR_GPU
  end
  if not fg_gpu_build_cmd
    st1 = nvstop
    fg_fail 9 FG_ERR_GPU
  end
  if not fg_gpu_exec_wait
    st2 = nvstop
    fg_fail 10 FG_ERR_GPU
  end
  got = ulong mapget get fg_out_map 0 0 4
  st3 = nvstop
  if ne got expV
    fg_fail 11 FG_ERR_GPU
  end
  fg_wrt 1 fg_m_pass
  fg_wrt_u 1 ulong rx_rc
  fg_wrt 1 fg_m_gpu
  fg_wrt_u 1 got
  fg_wrt 1 fg_m_exp
  fg_wrt_u 1 expV
  fg_wrt 1 fg_m_sbyt
  fg_wrt_u 1 nb
  fg_wrt 1 fg_m_nl
  ret 0
end

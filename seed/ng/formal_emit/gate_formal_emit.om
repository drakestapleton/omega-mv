fn gfWrt s view uchar * to void
  r = write 1 s 0 len s
end

fn gfWrtU64 v ulong to void
  tmp = new uchar 24 0
  p = ulong 24
  x = v
  for i ulong 24
    p = sub p 1
    put tmp p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 tmp p sub 24 p
end

fn gfRecord ok bool name view uchar * to void
  if ok
    put gfPassCnt 0 add get gfPassCnt 0 1
    gfWrt gfPassPfx
  else
    put gfFailCnt 0 add get gfFailCnt 0 1
    gfWrt gfFailPfx
  end
  gfWrt name
  gfWrt gfNl
end

fn gfCopyArgTo dst ulong idx ulong to bool
  n = argread idx gfArgTmp 0 4095
  if le n 0
    ret false
  end
  un = ulong n
  if gt un 2040
    ret false
  end
  for i ulong un bound 2048
    b = get gfArgTmp i
    if eq dst 0
      put gfEmitBin i b
    end
    if eq dst 1
      put gfLeanBin i b
    end
    if eq dst 2
      put gfScrDir i b
    end
    if eq dst 3
      put gfOmcBin i b
    end
    if eq dst 4
      put gfRepoRoot i b
    end
  end
  if eq dst 0
    put gfEmitBinN 0 un
  end
  if eq dst 1
    put gfLeanBinN 0 un
  end
  if eq dst 2
    put gfScrDirN 0 un
  end
  if eq dst 3
    put gfOmcBinN 0 un
  end
  if eq dst 4
    put gfRepoRootN 0 un
  end
  ret true
end

fn gfSetPathA baseKind ulong suf view uchar * to void
  n = ulong 0
  if eq baseKind 0
    n = get gfScrDirN 0
    for i ulong n bound 2048
      put gfPathA i get gfScrDir i
    end
  else
    n = get gfRepoRootN 0
    for i ulong n bound 2048
      put gfPathA i get gfRepoRoot i
    end
  end
  sl = len suf
  for j ulong sl bound 512
    put gfPathA add n j get suf j
  end
  put gfPathAN 0 add n sl
end

fn gfSetPathB baseKind ulong suf view uchar * to void
  n = ulong 0
  if eq baseKind 0
    n = get gfScrDirN 0
    for i ulong n bound 2048
      put gfPathB i get gfScrDir i
    end
  else
    n = get gfRepoRootN 0
    for i ulong n bound 2048
      put gfPathB i get gfRepoRoot i
    end
  end
  sl = len suf
  for j ulong sl bound 512
    put gfPathB add n j get suf j
  end
  put gfPathBN 0 add n sl
end

fn gfSetChildLogs to void
  n = get gfScrDirN 0
  for i ulong n bound 2048
    b = get gfScrDir i
    put gfPathC i b
    put gfPathD i b
  end
  s1 = len gfS_cout
  for j ulong s1 bound 64
    put gfPathC add n j get gfS_cout j
  end
  put gfPathCN 0 add n s1
  s2 = len gfS_cerr
  for j ulong s2 bound 64
    put gfPathD add n j get gfS_cerr j
  end
  put gfPathDN 0 add n s2
end

fn gfBufReset to void
  put gfBufAN 0 0
end

fn gfBufPut s view uchar * to void
  n = get gfBufAN 0
  m = len s
  if gt add n m 65500
    ret
  end
  for i ulong m bound 8192
    put gfBufA add n i get s i
  end
  put gfBufAN 0 add n m
end

fn gfWriteBufAToFileA to bool
  fd = fopen gfPathA 0 get gfPathAN 0 577 420
  if lt fd 0
    ret false
  end
  n = get gfBufAN 0
  pos = ulong 0
  while lt pos n bound 65536
    w = write int fd gfBufA pos sub n pos
    if le w 0
      z = fclose int fd
      ret false
    end
    pos = add pos ulong w
  end
  z = fclose int fd
  ret true
end

fn gfReadFileBIntoBufA to bool
  fd = fopen gfPathB 0 get gfPathBN 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot 65500 bound 512
    r = read int fd gfBufA tot sub 65500 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose int fd
  put gfBufAN 0 tot
  ret gt tot 0
end

fn gfAppendLitToFd fd long s view uchar * to bool
  m = len s
  tmp = new uchar 256 0
  if gt m 256
    ret false
  end
  for i ulong m bound 256
    put tmp i get s i
  end
  w = write int fd tmp 0 m
  ret eq ulong w m
end

fn gfAppendPathBToFd fd long to bool
  inFd = fopen gfPathB 0 get gfPathBN 0 0 0
  if lt inFd 0
    ret false
  end
  tmp = new uchar 4096 0
  ok = true
  while ok bound 2048
    r = read int inFd tmp 0 4096
    if lt r 0
      ok = false
      break
    end
    if eq r 0
      break
    end
    wp = ulong 0
    ur = ulong r
    while lt wp ur bound 1024
      w = write int fd tmp wp sub ur wp
      if le w 0
        ok = false
        break
      end
      wp = add wp ulong w
    end
  end
  z = fclose int inFd
  ret ok
end

fn gfAppendRepoFile fd long rel view uchar * to bool
  gfSetPathB 1 rel
  ret gfAppendPathBToFd fd
end

fn gfFilesEqualAandB to bool
  f1 = fopen gfPathA 0 get gfPathAN 0 0 0
  if lt f1 0
    ret false
  end
  f2 = fopen gfPathB 0 get gfPathBN 0 0 0
  if lt f2 0
    z = fclose int f1
    ret false
  end
  b1 = new uchar 4096 0
  b2 = new uchar 4096 0
  tot = ulong 0
  ok = true
  while ok bound 4096
    r1 = read int f1 b1 0 4096
    r2 = read int f2 b2 0 4096
    if ne r1 r2
      ok = false
      break
    end
    if lt r1 0
      ok = false
      break
    end
    if eq r1 0
      break
    end
    ur = ulong r1
    for i ulong ur bound 4096
      if ne get b1 i get b2 i
        ok = false
        break
      end
    end
    tot = add tot ur
  end
  z1 = fclose int f1
  z2 = fclose int f2
  ret and ok gt tot 0
end

fn gfAvReset to void
  put gfAvN 0 2
end

fn gfAvPushRawCnt cnt ulong to void
  put gfAv 0 uchar and cnt 255
  put gfAv 1 uchar and shr cnt 8 255
end

fn gfAvPushLit s view uchar * to void
  p = get gfAvN 0
  n = len s
  put gfAv p uchar and n 255
  put gfAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put gfAv add p i get s i
  end
  put gfAvN 0 add p n
end

fn gfAvPushGlb kind ulong to void
  p = get gfAvN 0
  n = ulong 0
  if eq kind 0
    n = get gfEmitBinN 0
  end
  if eq kind 1
    n = get gfLeanBinN 0
  end
  if eq kind 2
    n = get gfOmcBinN 0
  end
  put gfAv p uchar and n 255
  put gfAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    if eq kind 0
      put gfAv add p i get gfEmitBin i
    end
    if eq kind 1
      put gfAv add p i get gfLeanBin i
    end
    if eq kind 2
      put gfAv add p i get gfOmcBin i
    end
  end
  put gfAvN 0 add p n
end

fn gfAvPushScr suf view uchar * to void
  gfSetPathA 0 suf
  p = get gfAvN 0
  n = get gfPathAN 0
  put gfAv p uchar and n 255
  put gfAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put gfAv add p i get gfPathA i
  end
  put gfAvN 0 add p n
end

fn gfAvPushRepo suf view uchar * to void
  gfSetPathA 1 suf
  p = get gfAvN 0
  n = get gfPathAN 0
  put gfAv p uchar and n 255
  put gfAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put gfAv add p i get gfPathA i
  end
  put gfAvN 0 add p n
end

fn gfAvPushPathA to void
  p = get gfAvN 0
  n = get gfPathAN 0
  put gfAv p uchar and n 255
  put gfAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put gfAv add p i get gfPathA i
  end
  put gfAvN 0 add p n
end

fn gfSlurpLogs to void
  put gfOutLen 0 0
  fo = fopen gfPathC 0 get gfPathCN 0 0 0
  if ge fo 0
    tot = ulong 0
    while lt tot 65500 bound 256
      r = read int fo gfOutBuf tot sub 65500 tot
      if le r 0
        break
      end
      tot = add tot ulong r
    end
    put gfOutLen 0 tot
    z = fclose int fo
  end
  put gfErrLen 0 0
  fe = fopen gfPathD 0 get gfPathDN 0 0 0
  if ge fe 0
    tot2 = ulong 0
    while lt tot2 16300 bound 64
      r2 = read int fe gfErrBuf tot2 sub 16300 tot2
      if le r2 0
        break
      end
      tot2 = add tot2 ulong r2
    end
    put gfErrLen 0 tot2
    z2 = fclose int fe
  end
end

fn gfRunChild acnt ulong inPathB bool outToB bool to long
  gfAvPushRawCnt acnt
  gfSetChildLogs
  pid = fork
  if lt pid 0
    ret long -1
  end
  if eq pid 0
    if inPathB
      fi = fopen gfPathB 0 get gfPathBN 0 0 0
      if lt fi 0
        exit 124
      end
      d0 = dupfd int fi 0 0
    end
    fo = long 0
    if outToB
      fo = fopen gfPathA 0 get gfPathAN 0 577 493
    else
      fo = fopen gfPathC 0 get gfPathCN 0 577 420
    end
    if lt fo 0
      exit 125
    end
    d1 = dupfd int fo 1 0
    fe = fopen gfPathD 0 get gfPathDN 0 577 420
    if lt fe 0
      exit 125
    end
    d2 = dupfd int fe 2 0
    r = execprog gfAv 0 get gfAvN 0
    exit 127
  end
  w = waitpid int pid gfWait 0 4 0
  if ne w pid
    ret long -1
  end
  if not outToB
    gfSlurpLogs
  end
  if ne get gfWait 0 0
    ret long -1
  end
  ret long get gfWait 1
end

fn gfMatchAt which ulong pos ulong pat view uchar * to bool
  m = len pat
  for j ulong m bound 128
    b = uchar 0
    if eq which 0
      b = get gfOutBuf add pos j
    else
      b = get gfErrBuf add pos j
    end
    if ne b get pat j
      ret false
    end
  end
  ret true
end

fn gfLogContains which ulong pat view uchar * to bool
  n = get gfOutLen 0
  if ne which 0
    n = get gfErrLen 0
  end
  m = len pat
  if or eq m 0 lt n m
    ret false
  end
  lim = add sub n m 1
  for i ulong lim bound 65536
    if gfMatchAt which i pat
      ret true
    end
  end
  ret false
end

fn gfVerifyStat0500 to bool
  r = stat gfPathA 0 get gfPathAN 0 gfStat 0 128
  if ne r 0
    ret false
  end
  m = or ulong get gfStat 16 shl ulong get gfStat 17 8
  if ne and m 146 0
    ret false
  end
  ret eq and m 511 320
end

fn gfVerifyAbsent to bool
  r = stat gfPathA 0 get gfPathAN 0 gfStat 0 128
  ret lt r 0
end

fn gfVerifyElfWx to bool
  fd = fopen gfPathA 0 get gfPathAN 0 0 0
  if lt fd 0
    ret false
  end
  hdr = new uchar 128 0
  r = read int fd hdr 0 128
  z = fclose int fd
  if lt r 120
    ret false
  end
  if or ne get hdr 0 127 ne get hdr 1 69
    ret false
  end
  if or ne get hdr 2 76 ne get hdr 3 70
    ret false
  end
  if or ne get hdr 4 2 ne get hdr 18 183
    ret false
  end
  if or ne get hdr 56 1 ne get hdr 64 1
    ret false
  end
  pf = ulong get hdr 68
  if eq and pf 3 3
    ret false
  end
  ret eq pf 5
end

fn gfCompileFileBToA to bool
  gfAvReset
  gfAvPushGlb 2
  rc = gfRunChild 1 true true
  ret eq rc 0
end

fn gfReproCheckLeanEmit to bool
  gfSetPathA 0 gfS_repSrc1
  fd = fopen gfPathA 0 get gfPathAN 0 577 420
  if lt fd 0
    ret false
  end
  ok = gfAppendRepoFile fd gfR_ir
  ok = and ok gfAppendRepoFile fd gfR_sha
  ok = and ok gfAppendRepoFile fd gfR_td
  ok = and ok gfAppendRepoFile fd gfR_ct
  ok = and ok gfAppendRepoFile fd gfR_ra
  ok = and ok gfAppendRepoFile fd gfR_is
  ok = and ok gfAppendRepoFile fd gfR_sm
  ok = and ok gfAppendRepoFile fd gfR_le
  z = fclose int fd
  if not ok
    ret false
  end
  gfSetPathB 0 gfS_repSrc1
  gfSetPathA 0 gfS_repBin1a
  if not gfCompileFileBToA
    ret false
  end
  gfSetPathB 0 gfS_repSrc1
  gfSetPathA 0 gfS_repBin1b
  if not gfCompileFileBToA
    ret false
  end
  gfSetPathB 0 gfS_repBin1a
  gfSetPathA 0 gfS_repBin1b
  ret gfFilesEqualAandB
end

fn gfReproCheckGate to bool
  gfSetPathA 0 gfS_repSrc2
  fd = fopen gfPathA 0 get gfPathAN 0 577 420
  if lt fd 0
    ret false
  end
  ok = gfAppendLitToFd fd gfT_om2
  ok = and ok gfAppendRepoFile fd gfR_sha
  ok = and ok gfAppendRepoFile fd gfR_gf
  z = fclose int fd
  if not ok
    ret false
  end
  gfSetPathB 0 gfS_repSrc2
  gfSetPathA 0 gfS_repBin2a
  if not gfCompileFileBToA
    ret false
  end
  gfSetPathB 0 gfS_repSrc2
  gfSetPathA 0 gfS_repBin2b
  if not gfCompileFileBToA
    ret false
  end
  gfSetPathB 0 gfS_repBin2a
  gfSetPathA 0 gfS_repBin2b
  ret gfFilesEqualAandB
end

fn gfLoadPosUnit idx ulong to void
  gfBufReset
  if eq idx 0
    gfBufPut gfU1_a
    gfBufPut gfU1_b
    gfBufPut gfU1_c
  end
  if eq idx 1
    gfBufPut gfU2_a
    gfBufPut gfU2_b
    gfBufPut gfU2_c
    gfBufPut gfU2_d
  end
  if eq idx 2
    gfBufPut gfU3_a
    gfBufPut gfU3_b
    gfBufPut gfU3_c
    gfBufPut gfU3_d
  end
end

fn gfCheckStandaloneLean crt view uchar * to bool
  gfAvReset
  gfAvPushGlb 1
  gfAvPushLit gfT_warn
  gfAvPushScr crt
  rc = gfRunChild 3 false false
  if ne rc 0
    ret false
  end
  if not gfLogContains 0 gfExpThm
    ret false
  end
  if or gfLogContains 0 gfBadSorry gfLogContains 0 gfBadNative
    ret false
  end
  ret true
end

fn gfPushEmitBaseArgs uSuf view uchar * rSuf view uchar * wSuf view uchar * to ulong
  gfAvReset
  gfAvPushGlb 0
  gfAvPushLit gfT_u
  gfAvPushScr uSuf
  gfAvPushLit gfT_o
  gfAvPushScr rSuf
  gfAvPushLit gfT_ln
  gfAvPushGlb 1
  gfAvPushLit gfT_wd
  gfAvPushScr wSuf
  acnt = ulong 9
  if ne get gfHasRepro 0 0
    gfAvPushLit gfT_ch
    gfAvPushRepo gfT_chips
    acnt = add acnt 2
  end
  ret acnt
end

fn gfRunPositiveOne name view uchar * idx ulong expRc ulong to void
  gfLoadPosUnit idx
  if eq idx 0
    gfSetPathA 0 gfSU1_u
  else
    if eq idx 1
      gfSetPathA 0 gfSU2_u
    else
      gfSetPathA 0 gfSU3_u
    end
  end
  if not gfWriteBufAToFileA
    gfRecord false name
    ret
  end
  acnt = ulong 0
  if eq idx 0
    acnt = gfPushEmitBaseArgs gfSU1_u gfSU1_r gfSU1_w
    gfAvPushLit gfT_co
    gfAvPushScr gfSU1_c
  else
    if eq idx 1
      acnt = gfPushEmitBaseArgs gfSU2_u gfSU2_r gfSU2_w
      gfAvPushLit gfT_co
      gfAvPushScr gfSU2_c
    else
      acnt = gfPushEmitBaseArgs gfSU3_u gfSU3_r gfSU3_w
      gfAvPushLit gfT_co
      gfAvPushScr gfSU3_c
    end
  end
  acnt = add acnt 2
  if eq idx 0
    gfSetPathA 0 gfSU1_r
  else
    if eq idx 1
      gfSetPathA 0 gfSU2_r
    else
      gfSetPathA 0 gfSU3_r
    end
  end
  z = unlink gfPathA 0 get gfPathAN 0
  rc = gfRunChild acnt false false
  if ne rc 0
    gfRecord false name
    ret
  end
  if or not gfLogContains 0 gfExpPass not gfLogContains 0 gfExpStd
    gfRecord false name
    ret
  end
  if or not gfLogContains 0 gfExpWx not gfLogContains 0 gfExpLrc
    gfRecord false name
    ret
  end
  leanOk = false
  if eq idx 0
    leanOk = gfCheckStandaloneLean gfSU1_c
  else
    if eq idx 1
      leanOk = gfCheckStandaloneLean gfSU2_c
    else
      leanOk = gfCheckStandaloneLean gfSU3_c
    end
  end
  if not leanOk
    gfRecord false name
    ret
  end
  if eq idx 0
    gfSetPathA 0 gfSU1_r
  else
    if eq idx 1
      gfSetPathA 0 gfSU2_r
    else
      gfSetPathA 0 gfSU3_r
    end
  end
  if or not gfVerifyStat0500 not gfVerifyElfWx
    gfRecord false name
    ret
  end
  gfAvReset
  if eq idx 0
    gfAvPushScr gfSU1_r
  else
    if eq idx 1
      gfAvPushScr gfSU2_r
    else
      gfAvPushScr gfSU3_r
    end
  end
  erc = gfRunChild 1 false false
  gfRecord eq erc long expRc name
end

fn gfRunUnitMutant name view uchar * expCode long useRwx bool to void
  gfSetPathA 0 gfSm_u
  if not gfWriteBufAToFileA
    gfRecord false name
    ret
  end
  gfSetPathA 0 gfSm_r
  z = unlink gfPathA 0 get gfPathAN 0
  acnt = gfPushEmitBaseArgs gfSm_u gfSm_r gfSm_w
  if useRwx
    gfAvPushLit gfT_rwx
    acnt = add acnt 1
  end
  rc = gfRunChild acnt false false
  gfSetPathA 0 gfSm_r
  absent = gfVerifyAbsent
  gfRecord and eq rc expCode absent name
end

fn gfBufMatchAt pos ulong pat view uchar * to bool
  m = len pat
  for j ulong m bound 256
    if ne get gfBufA add pos j get pat j
      ret false
    end
  end
  ret true
end

fn gfCommitBufB olen ulong to void
  for k ulong olen bound 65536
    put gfBufA k get gfBufB k
  end
  put gfBufAN 0 olen
end

fn gfCopyRepToB olen ulong rep view uchar * to bool
  rl = len rep
  if gt add olen rl 65500
    ret false
  end
  for j ulong rl bound 256
    put gfBufB add olen j get rep j
  end
  ret true
end

fn gfBufReplaceAll pat view uchar * rep view uchar * to bool
  n = get gfBufAN 0
  pl = len pat
  if or eq pl 0 lt n pl
    ret false
  end
  olen = ulong 0
  hits = ulong 0
  i = ulong 0
  while lt i n bound 65536
    matched = false
    if le add i pl n
      if gfBufMatchAt i pat
        matched = true
      end
    end
    if matched
      if not gfCopyRepToB olen rep
        ret false
      end
      olen = add olen len rep
      i = add i pl
      hits = add hits 1
    else
      if ge olen 65500
        ret false
      end
      put gfBufB olen get gfBufA i
      olen = add olen 1
      i = add i 1
    end
  end
  if eq hits 0
    ret false
  end
  gfCommitBufB olen
  ret true
end

fn gfRunCertMutant name view uchar * mode ulong to void
  gfSetPathB 0 gfSU1_c
  if not gfReadFileBIntoBufA
    gfRecord false name
    ret
  end
  ok = true
  if eq mode 0
    gfBufPut gfTam_sorry
  end
  if eq mode 1
    ok = gfBufReplaceAll gfTam_axP0 gfTam_axR0
    ok = and ok gfBufReplaceAll gfTam_axP1 gfTam_axR1
  end
  if eq mode 2
    ok = gfBufReplaceAll gfTam_ndP gfTam_ndR
  end
  if not ok
    gfRecord false name
    ret
  end
  gfSetPathA 0 gfSm_c
  if not gfWriteBufAToFileA
    gfRecord false name
    ret
  end
  gfSetPathA 0 gfSm_r
  z = unlink gfPathA 0 get gfPathAN 0
  gfAvReset
  gfAvPushGlb 0
  gfAvPushLit gfT_vc
  gfAvPushScr gfSm_c
  gfAvPushLit gfT_o
  gfAvPushScr gfSm_r
  gfAvPushLit gfT_ln
  gfAvPushGlb 1
  gfAvPushLit gfT_wd
  gfAvPushScr gfSm_w
  rc = gfRunChild 9 false false
  gfSetPathA 0 gfSm_r
  absent = gfVerifyAbsent
  gfRecord and eq rc 15 absent name
end

fn gfRunMutantsPart1 to void
  gfBufReset
  gfBufPut gfU_hdrPure
  gfBufPut gfM1_ir
  gfBufPut gfU1_b
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm1 11 false

  gfBufReset
  gfBufPut gfU_hdrPure
  gfBufPut gfM2_ir
  gfBufPut gfU1_b
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm2 11 false

  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfM3_om
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm3 12 false

  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfM4_om
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm4 12 false

  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfM5_om
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm5 12 false
end

fn gfRunMutantsPart2 to void
  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfU1_b
  gfBufPut gfM6_wc
  gfRunUnitMutant gfNm6 13 false

  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfU1_b
  gfBufPut gfU1_c
  gfRunUnitMutant gfNm11 2 true

  gfRunCertMutant gfNm8 0
  gfRunCertMutant gfNm9 1
  gfRunCertMutant gfNm10 2
end

fn gfRunSm121Mutants to void
  gfBufReset
  gfBufPut gfU_hdrSm
  gfBufPut gfU3_b
  gfBufPut gfM7b_sm
  gfRunUnitMutant gfNm7b 14 false

  gfBufReset
  gfBufPut gfU_hdrOkIr
  gfBufPut gfU1_b
  gfBufPut gfM7a_sm
  gfRunUnitMutant gfNm7a 14 false
end

fn main to int
  ac = ulong argcnt
  if or lt ac 4 gt ac 6
    gfWrt gfUse
    ret 2
  end
  put gfPassCnt 0 0
  put gfFailCnt 0 0
  put gfHasRepro 0 0
  if not gfCopyArgTo 0 1
    gfWrt gfUse
    ret 2
  end
  if not gfCopyArgTo 1 2
    gfWrt gfUse
    ret 2
  end
  if not gfCopyArgTo 2 3
    gfWrt gfUse
    ret 2
  end
  if ge ac 6
    if or not gfCopyArgTo 3 4 not gfCopyArgTo 4 5
      gfWrt gfUse
      ret 2
    end
    put gfHasRepro 0 1
  end
  z = makedir gfScrDir 0 get gfScrDirN 0 448

  if ne get gfHasRepro 0 0
    gfRecord gfReproCheckLeanEmit gfN_repro1
    gfRecord gfReproCheckGate gfN_repro2
  end

  gfRunPositiveOne gfN_u1 0 36
  gfRunPositiveOne gfN_u2 1 62
  gfRunPositiveOne gfN_u3 2 48

  gfRunMutantsPart1
  gfRunSm121Mutants
  gfRunMutantsPart2

  gfWrt gfSummary0
  fc = get gfFailCnt 0
  if eq fc 0
    gfWrt gfSummary1
  else
    gfWrt gfSummary2
  end
  gfWrtU64 get gfPassCnt 0
  gfWrt gfSummary3
  gfWrtU64 fc
  gfWrt gfSummary4
  if ne fc 0
    ret 1
  end
  ret 0
end

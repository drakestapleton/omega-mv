  feLnEmitSmArgs
  feLnPut feL_thc
  feLnPut feL_pr
end

fn feWriteLeanBufTo which ulong to bool
  p = new uchar 2200 0
  pn = ulong 0
  if eq which 0
    pn = get feLeanWorkPathN 0
    for i ulong pn bound 2200
      put p i get feLeanWorkPath i
    end
  else
    pn = get feCertOutPathN 0
    for i ulong pn bound 2048
      put p i get feCertOutPath i
    end
  end
  if or eq pn 0 gt pn 2195
    ret false
  end
  fd = fopen p 0 pn 577 420
  if lt fd 0
    ret false
  end
  n = get feLeanLen 0
  pos = ulong 0
  while lt pos n bound 65536
    ch = sub n pos
    if gt ch 8192
      ch = ulong 8192
    end
    for i ulong ch bound 8192
      put feIoBuf i get feLeanBuf add pos i
    end
    w = write int fd feIoBuf 0 ch
    if le w 0
      z = fclose int fd
      ret false
    end
    pos = add pos ulong w
  end
  z = fclose int fd
  ret true
end

note ---- Stage 6: Fork/Execprog Lean 4.36.0 & Inspect Output (0 sorry, 0 warn, standard axioms only) ----

fn feAvReset to void
  put feAvN 0 2
end

fn feAvPushLit s view uchar * to void
  p = get feAvN 0
  n = len s
  put feAv p uchar and n 255
  put feAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put feAv add p i get s i
  end
  put feAvN 0 add p n
end

fn feAvPushGlobal kind ulong to void
  p = get feAvN 0
  n = ulong 0
  if eq kind 0
    n = get feLeanPathN 0
  else
    n = get feLeanWorkPathN 0
  end
  put feAv p uchar and n 255
  put feAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2200
    if eq kind 0
      put feAv add p i get feLeanPath i
    else
      put feAv add p i get feLeanWorkPath i
    end
  end
  put feAvN 0 add p n
end

fn feBufContains which ulong pat view uchar * to bool
  n = get feLeanOutLen 0
  if eq which 1
    n = get feLeanErrLen 0
  end
  m = len pat
  if or eq m 0 lt n m
    ret false
  end
  lim = add sub n m 1
  for i ulong lim bound 65536
    ok = true
    for j ulong m bound 128
      b = uchar 0
      if eq which 0
        b = get feLeanOut add i j
      else
        b = get feLeanErr add i j
      end
      if ne b get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn feLineEqSlice s ulong e ulong kw view uchar * to bool
  if ne sub e s len kw
    ret false
  end
  for i ulong len kw bound 64
    if ne get feLeanOut add s i get kw i
      ret false
    end
  end
  ret true
end

fn feLineMatchAt pos ulong pat view uchar * to bool
  m = len pat
  for j ulong m bound 128
    if ne get feLeanOut add pos j get pat j
      ret false
    end
  end
  ret true
end

fn feLineHas s ulong e ulong pat view uchar * to bool
  m = len pat
  if lt sub e s m
    ret false
  end
  lim = add sub sub e s m 1
  for i ulong lim bound 2048
    if feLineMatchAt add s i pat
      ret true
    end
  end
  ret false
end

fn feLineStarts s ulong e ulong pat view uchar * to bool
  m = len pat
  if lt sub e s m
    ret false
  end
  ret feLineMatchAt s pat
end

fn feIsStdAxiom s ulong e ulong to bool
  if feLineEqSlice s e feAx_std0
    ret true
  end
  if feLineEqSlice s e feAx_std1
    ret true
  end
  ret feLineEqSlice s e feAx_std2
end

fn feFindByte s ulong e ulong ch ulong to ulong
  for i ulong sub e s bound 2048
    if eq ulong get feLeanOut add s i ch
      ret add s i
    end
  end
  ret e
end

fn feCheckAxiomList s ulong e ulong to bool
  lb0 = feFindByte s e 91
  if ge lb0 e
    ret false
  end
  lb = add lb0 1
  rb = feFindByte lb e 93
  if or ge rb e le rb lb
    ret false
  end
  p = lb
  cnt = ulong 0
  while lt p rb bound 2048
    while lt p rb bound 2048
      c = ulong get feLeanOut p
      if and ne c 32 ne c 44
        break
      end
      p = add p 1
    end
    if ge p rb
      break
    end
    ts = p
    while lt p rb bound 2048
      c = ulong get feLeanOut p
      if or eq c 32 eq c 44
        break
      end
      p = add p 1
    end
    if not feIsStdAxiom ts p
      ret false
    end
    cnt = add cnt 1
  end
  ret gt cnt 0
end

fn feMarkReqThm s ulong e ulong to void
  if feLineStarts s e feThm0
    put feAxFound 0 1
  end
  if feLineStarts s e feThm1
    put feAxFound 1 1
  end
  if feLineStarts s e feThm2
    put feAxFound 2 1
  end
  if feLineStarts s e feThm3
    put feAxFound 3 1
  end
  if feLineStarts s e feThm4
    put feAxFound 4 1
  end
  if feLineStarts s e feThm5
    put feAxFound 5 1
  end
  if feLineStarts s e feThm6
    put feAxFound 6 1
  end
  if feLineStarts s e feThm7
    put feAxFound 7 1
  end
  if feLineStarts s e feThm8
    put feAxFound 8 1
  end
  if feLineStarts s e feThm9
    put feAxFound 9 1
  end
end

fn feInspectLeanOutput rc ulong to bool
  if ne rc 0
    ret false
  end
  if or feBufContains 0 feBad_sorry feBufContains 1 feBad_sorry
    ret false
  end
  if or feBufContains 0 feBad_decl feBufContains 1 feBad_decl
    ret false
  end
  if or feBufContains 0 feBad_red feBufContains 1 feBad_red
    ret false
  end
  if or feBufContains 0 feBad_tc feBufContains 1 feBad_tc
    ret false
  end
  if or feBufContains 0 feBad_nat feBufContains 1 feBad_nat
    ret false
  end
  for i ulong 10
    put feAxFound i 0
  end
  n = get feLeanOutLen 0
  p = ulong 0
  while lt p n bound 65536
    ls = p
    while lt p n bound 65536
      if eq get feLeanOut p 10
        break
      end
      p = add p 1
    end
    le_ = p
    if lt p n
      p = add p 1
    end
    if gt le_ ls
      if eq get feLeanOut sub le_ 1 13
        le_ = sub le_ 1
      end
    end
    if gt le_ ls
      isDep = feLineHas ls le_ feAx_dep
      isNone = feLineHas ls le_ feAx_none
      if isDep
        if not feCheckAxiomList ls le_
          ret false
        end
        feMarkReqThm ls le_
      else
        if isNone
          feMarkReqThm ls le_
        end
      end
    end
  end
  for i ulong 10
    if eq get feAxFound i 0
      ret false
    end
  end
  ret true
end

fn feRunAndAuditLean to void
  if not feWriteLeanBufTo 0
    feRefuse FE_ERR_IO feR_io
  end
  if gt get feCertOutPathN 0 0
    if not feWriteLeanBufTo 1
      feRefuse FE_ERR_IO feR_io
    end
  end
  feAvReset
  feAvPushGlobal 0
  feAvPushLit feLeanWarn
  feAvPushGlobal 1
  cnt = ulong 3
  put feAv 0 uchar and cnt 255
  put feAv 1 uchar and shr cnt 8 255

  pid = fork
  if lt pid 0
    feRefuse FE_ERR_LEAN feR_lean
  end
  if eq pid 0
    fo = fopen feLeanOutPath 0 get feLeanOutPathN 0 577 420
    if lt fo 0
      exit 125
    end
    do1 = dupfd int fo 1 0
    fe_ = fopen feLeanErrPath 0 get feLeanErrPathN 0 577 420
    if lt fe_ 0
      exit 125
    end
    do2 = dupfd int fe_ 2 0
    r = execprog feAv 0 get feAvN 0
    exit 127
  end
  w = waitpid int pid feWaitSt 0 4 0
  if ne w pid
    feRefuse FE_ERR_LEAN feR_lean
  end
  lrc = ulong 255
  if eq get feWaitSt 0 0
    lrc = ulong get feWaitSt 1
  end
  ol = feReadFileInto 2
  el = feReadFileInto 3
  if or lt ol 0 lt el 0
    feRefuse FE_ERR_LEAN feR_lean
  end
  put feLeanOutLen 0 ulong ol
  put feLeanErrLen 0 ulong el
  if not feInspectLeanOutput lrc
    feRefuse FE_ERR_LEAN feR_lean
  end
end

note ---- Stage 7: Strict W^X ELF64 Build & Sealing (0600 RW -> SHA-256 -> fchmod 0500 RX) ----

fn feLoadU64 rd ulong v ulong to void
  lo = and v 65535
  isEmitU32 or ulong 3531603968 or shl lo 5 rd
  h1 = and shr v 16 65535
  if ne h1 0
    isEmitU32 or ulong 4068474880 or shl ulong 1 21 or shl h1 5 rd
  end
  h2 = and shr v 32 65535
  if ne h2 0
    isEmitU32 or ulong 4068474880 or shl ulong 2 21 or shl h2 5 rd
  end
  h3 = and shr v 48 65535
  if ne h3 0
    isEmitU32 or ulong 4068474880 or shl ulong 3 21 or shl h3 5 rd
  end
end

fn feVerifyElfWx elen ulong to bool
  if lt elen 132
    ret false
  end
  if or ne get elfBuf 0 127 or ne get elfBuf 1 69 or ne get elfBuf 2 76 ne get elfBuf 3 70
    ret false
  end
  if ne get elfBuf 18 183
    ret false
  end
  if ne get elfBuf 64 1
    ret false
  end
  pf = ulong get elfBuf 68
  if eq and pf 3 3
    ret false
  end
  ret eq pf 5
end

fn feCheckStatRx to bool
  ol = get feOutPathN 0
  r = stat feOutPath 0 ol feStatBuf 0 128
  if ne r 0
    ret false
  end
  m = or ulong get feStatBuf 16 shl ulong get feStatBuf 17 8
  if ne and m 146 0
    ret false
  end
  ret eq and m 511 320
end

fn feSealRename to bool
  sl = get feStagePathN 0
  rl = get feOutPathN 0
  z = unlink feOutPath 0 rl
  put feRenPkt 0 2
  put feRenPkt 1 0
  put feRenPkt 2 uchar and sl 255
  put feRenPkt 3 uchar shr sl 8
  for i ulong sl bound 2200
    put feRenPkt add 4 i get feStagePath i
  end
  off = add 4 sl
  put feRenPkt off uchar and rl 255
  put feRenPkt add off 1 uchar shr rl 8
  off = add off 2
  for i ulong rl bound 2200
    put feRenPkt add off i get feOutPath i
  end
  if ne renames feRenPkt 0 add off rl 0 0
    ret false
  end
  ret feCheckStatRx
end

fn feBuildAndSealElf to void
  isBufReset
  if eq get feModeVerify 0 0
    feLoadU64 0 get feIrA0 0
    feLoadU64 1 get feIrA1 0
    feLoadU64 2 get feIrA2 0
    op1 = get feIrOp1 0
    if or eq op1 1 or eq op1 2 eq op1 3
      ign = isEmitOp TID_X925 op1 0 0 1
    else
      if eq op1 4
        isEmitU32 2315255840
      end
      if eq op1 5
        isEmitU32 2852126752
      end
      if eq op1 6
        isEmitU32 3388997664
      end
    end
    op2 = get feIrOp2 0
    if or eq op2 1 or eq op2 2 eq op2 3
      ign = isEmitOp TID_X925 op2 0 0 2
    else
      if eq op2 4
        isEmitU32 2315255872
      end
      if eq op2 5
        isEmitU32 2852126784
      end
      if eq op2 6
        isEmitU32 3388997696
      end
    end
    note and x0, x0, #0xff (0x92401c00)
    isEmitU32 2453675008
  else
    isEmitU32 3531603968
  end
  note mov x8, #93; svc #0
  isEmitU32 3531606952
  isEmitU32 3556769793

  elen = elfEmitStatic TID_X925
  if not feVerifyElfWx elen
    feRefuse FE_ERR_WX feR_wx
  end
  for i ulong elen bound 4096
    put sh_dat i get elfBuf i
  end
  sh_all elen
  for j ulong 32
    d = get sh_dig j
    put feShaExp j d
    put feOutShaHex mul j 2 feHexCh shr ulong d 4
    put feOutShaHex add mul j 2 1 feHexCh and ulong d 15
  end

  sl = get feStagePathN 0
  z = unlink feStagePath 0 sl
  fd = fopen feStagePath 0 sl 578 384
  if lt fd 0
    feRefuse FE_ERR_WX feR_wx
  end
  wp = ulong 0
  while lt wp elen bound 4096
    w = write int fd elfBuf wp sub elen wp
    if le w 0
      z = fclose int fd
      feRefuse FE_ERR_WX feR_wx
    end
    wp = add wp ulong w
  end
  if lt fseek int fd 0 0 0
    z = fclose int fd
    feRefuse FE_ERR_WX feR_wx
  end
  rp = ulong 0
  while lt rp elen bound 4096
    r = read int fd feRbBuf rp sub elen rp
    if le r 0
      z = fclose int fd
      feRefuse FE_ERR_WX feR_wx
    end
    rp = add rp ulong r
  end
  for i ulong elen bound 4096
    put sh_dat i get feRbBuf i
  end
  sh_all elen
  for j ulong 32
    if ne get sh_dig j get feShaExp j
      z = fclose int fd
      feRefuse FE_ERR_WX feR_wx
    end
  end
  cm = fchmod int fd 320
  z = fsync int fd
  z = fclose int fd
  if ne cm 0
    feRefuse FE_ERR_WX feR_wx
  end
  if not feSealRename
    z = unlink feOutPath 0 get feOutPathN 0
    feRefuse FE_ERR_WX feR_wx
  end
end

fn main to int
  ar_init
  tdInitAll
  isInitRules
  tdCacheInit
  feInitDefaults
  feParseCli
  feResolveLeanBin
  feBuildWorkPaths

  if eq get feModeVerify 0 0
    feParseUnitFile
    feResolveTarget
    feVerifyIrV2
    feVerifyOm3
    feVerifyWattCbf
    feVerifySm121
    feEmitLeanCert
  else
    vn = feReadFileInto 1
    if le vn 0
      feRefuse FE_ERR_IO feR_io
    end
    put feLeanLen 0 ulong vn
  end

  feRunAndAuditLean
  feBuildAndSealElf
  feCleanupWork

  feWrt 1 feP_hdr
  feWrtGlobal 1 0 get feUnitNameN 0
  feWrt 1 feP_tgt
  feWrtGlobal 1 1 get feTargetNameN 0
  feWrt 1 feP_sem
  feWrtGlobal 1 2 64
  feWrt 1 feP_watt
  feWrtU64 1 ulong get feWpGpu 0
  feWrt 1 feP_raw
  feWrtU64 1 get feSmRawFloor 0
  feWrt 1 feP_reg
  feWrtU64 1 get feSmRegs 0
  feWrt 1 feP_sl
  feWrtU64 1 get feMaxNgpr 0
  feWrt 1 feP_lean
  feWrtGlobal 1 3 64
  feWrt 1 feP_out
  feWrtGlobal 1 4 get feOutPathN 0
  feWrt 1 feErrNl
  ret 0
end

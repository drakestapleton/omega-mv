text feL_th0 "theorem cert_purity_and_semantic_id :\n    And (irPureSound unitContract = true) (And (unitSemanticId.length = 64)\n      (evalPoly3 "
text feL_th1 " = "
text feL_th2 ")) := by\n  decide\n\n"
text feL_th3 "theorem cert_om3_domain_and_fence :\n    (match runTrace [] unitOm3Trace with\n     | none => false\n     | some sf => stateSafeBool sf && noLiveGpuLeaks sf) = true := by\n  decide\n\n"
text feL_th4 "theorem cert_wattcbf_thermal_cap :\n    wattAdmissibleStrict unitThermal unitPolicy unitProp "
text feL_th5 " = true := by\n  decide\n\n"
text feL_th6 "theorem cert_sm121_hazard_and_regs :\n    sm121ContractOk unitSm121Insns "
text feL_th7 " = true := by\n  decide\n\n"
text feL_th8 "theorem cert_master_admissible :\n    And (And (irPureSound unitContract = true) (And (unitSemanticId.length = 64) (evalPoly3 "
text feL_th9 " = "
text feL_tha ")))\n    (And ((match runTrace [] unitOm3Trace with\n           | none => false\n           | some sf => stateSafeBool sf && noLiveGpuLeaks sf) = true)\n    (And (wattAdmissibleStrict unitThermal unitPolicy unitProp "
text feL_thb " = true)\n         (sm121ContractOk unitSm121Insns "
text feL_thc " = true))) := by\n  exact And.intro cert_purity_and_semantic_id\n    (And.intro cert_om3_domain_and_fence\n      (And.intro cert_wattcbf_thermal_cap cert_sm121_hazard_and_regs))\n\nend GeneratedCert\n\n"
text feL_pr "#print axioms GeneratedCert.pure_implies_no_effects\n#print axioms GeneratedCert.om3_kernel_slab_never_mapped\n#print axioms GeneratedCert.om3_reclaim_requires_4step_fence\n#print axioms GeneratedCert.watt_strict_lt_80w\n#print axioms GeneratedCert.sm121_raw_floor_sound\n#print axioms GeneratedCert.cert_purity_and_semantic_id\n#print axioms GeneratedCert.cert_om3_domain_and_fence\n#print axioms GeneratedCert.cert_wattcbf_thermal_cap\n#print axioms GeneratedCert.cert_sm121_hazard_and_regs\n#print axioms GeneratedCert.cert_master_admissible\n"

fn feLnEmitDom d ulong to void
  if eq d FE_DOM_HOST
    feLnPut feL_d1
    ret
  end
  if eq d FE_DOM_KSLAB
    feLnPut feL_d2
    ret
  end
  if eq d FE_DOM_GPUDMA
    feLnPut feL_d3
    ret
  end
  if eq d FE_DOM_GMMU
    feLnPut feL_d4
    ret
  end
  if eq d FE_DOM_MMIO
    feLnPut feL_d5
    ret
  end
  feLnPut feL_d6
end

fn feLnEmitOneAct i ulong to void
  k = get feActKind i
  a0 = get feActA0 i
  a1 = get feActA1 i
  a2 = get feActA2 i
  a3 = get feActA3 i
  if eq k FE_ACT_ALLOC
    feLnPut feL_om1
    feLnPut feL_u_o1
  end
  if eq k FE_ACT_ALLOC
    ret
  end
  ret
end

fn feLnEmitOm3Act i ulong to void
  k = get feActKind i
  a0 = get feActA0 i
  a1 = get feActA1 i
  a2 = get feActA2 i
  a3 = get feActA3 i
  if eq k FE_ACT_ALLOC
    feLnPut feL_u_o1
    feLnU64 a0
    feLnPut feL_sp
    feLnEmitDom a1
    feLnPut feL_sp
    feLnU64 a2
    feLnPut feL_sp
    feLnU64 a3
    ret
  end
  if eq k FE_ACT_MAP
    feLnPut feL_u_o2
    feLnU64 a0
    feLnPut feL_sp
    feLnU64 a1
    feLnPut feL_sp
    feLnU64 a2
    ret
  end
  if eq k FE_ACT_PIN
    feLnPut feL_u_o3
    feLnU64 a0
    ret
  end
  if eq k FE_ACT_SUBMIT
    feLnPut feL_u_o4
    feLnU64 a0
    feLnPut feL_sp
    feLnU64 a1
    ret
  end
  if eq k FE_ACT_ACCESS
    feLnPut feL_u_o5
    feLnU64 a0
    feLnPut feL_sp
    feLnU64 a1
    feLnPut feL_sp
    feLnU64 a2
    ret
  end
  if eq k FE_ACT_UNMAP
    feLnPut feL_u_o6
    feLnU64 a0
    ret
  end
  if eq k FE_ACT_TLB
    feLnPut feL_u_o7
    feLnU64 a0
    ret
  end
  if eq k FE_ACT_FENCE
    feLnPut feL_u_o8
    feLnU64 a0
    feLnPut feL_sp
    feLnU64 a1
    ret
  end
  if eq k FE_ACT_REVOKE
    feLnPut feL_u_o9
    feLnU64 a0
    ret
  end
  if eq k FE_ACT_RECLAIM
    feLnPut feL_u_oa
    feLnU64 a0
  end
end

fn feLnEmitBool b ulong to void
  if ne b 0
    feLnPut feL_tr
    ret
  end
  feLnPut feL_fa
end

fn feLnEmitPipe p ulong to void
  if eq p FE_PIPE_HMMA
    feLnPut feL_ph
    ret
  end
  if eq p FE_PIPE_OMMA
    feLnPut feL_po
    ret
  end
  if eq p FE_PIPE_EXIT
    feLnPut feL_pe
    ret
  end
  feLnPut feL_pa
end

fn feLnEmitSmInsn i ulong to void
  feLnPut feL_u_s1
  feLnU64 get feInPc i
  feLnPut feL_u_s2
  feLnEmitPipe get feInPipe i
  feLnPut feL_u_s3
  feLnU64 get feInRd i
  feLnPut feL_u_s4
  feLnU64 get feInR1 i
  feLnPut feL_u_s5
  feLnU64 get feInR2 i
  feLnPut feL_u_s6
  feLnEmitBool get feInHasRd i
  feLnPut feL_u_s7
  feLnEmitBool get feInHasR1 i
  feLnPut feL_u_s8
  feLnEmitBool get feInHasR2 i
  feLnPut feL_u_s9
  feLnU64 get feInStall i
  feLnPut feL_u_sa
end

fn feLnEmitUnitData to void
  feLnPut feL_u_c1
  feLnU64 get fePure 0
  feLnPut feL_u_c2
  feLnU64 get fePrec 0
  feLnPut feL_u_c3
  feLnU64 get feHardDl 0
  feLnPut feL_u_c4
  feLnU64 get feErrBound 0
  feLnPut feL_u_c5
  feLnU64 get feDlUs 0
  feLnPut feL_u_c6
  feLnU64 get fePowerMw 0
  feLnPut feL_u_c7
  feLnU64 get feEffOps 0
  feLnPut feL_u_c8
  feLnU64 get feMutGlobs 0
  feLnPut feL_u_c9
  feLnU64 get feEditPars 0
  feLnPut feL_u_ca
  feLnU64 get feTrapExits 0
  feLnPut feL_u_cb
  feLnPutSemHex
  feLnPut feL_u_cc

  feLnPut feL_u_o0
  cnt = get feActCnt 0
  for i ulong cnt bound 128
    if gt i 0
      feLnPut feL_cm
    end
    feLnEmitOm3Act i
  end
  if gt cnt 0
    feLnCh uchar 10
  end
  feLnPut feL_u_oc

  feLnPut feL_u_w1
  feLnI64 get feWtDie 0
  feLnPut feL_u_w2
  feLnI64 get feWtSink 0
  feLnPut feL_u_w3
  feLnI64 get feWtAmb 0
  feLnPut feL_u_w4
  feLnI64 get feWpBud 0
  feLnPut feL_u_w5
  feLnI64 get feWpGpuBud 0
  feLnPut feL_u_w6
  feLnI64 get feWtCeil 0
  feLnPut feL_u_w7
  feLnI64 get feWtau 0
  feLnPut feL_u_w8
  feLnI64 get feWpGpu 0
  feLnPut feL_u_w9
  feLnI64 get feWpCpu 0
  feLnPut feL_u_wa
  feLnI64 get feWpUnc 0
  feLnPut feL_u_wb
  feLnI64 get feWfan 0
  feLnPut feL_u_wc

  feLnPut feL_u_s0
  ic = get feInCnt 0
  for i ulong ic bound 64
    if gt i 0
      feLnPut feL_cm
    end
    feLnEmitSmInsn i
  end
  if gt ic 0
    feLnCh uchar 10
  end
  feLnPut feL_u_sb
end

fn feLnEmitPolyArgs to void
  if ne get feHasFold 0 0
    feLnU64 get feFoldA0 0
    feLnPut feL_sp
    feLnU64 get feFoldA1 0
    feLnPut feL_sp
    feLnU64 get feFoldA2 0
    feLnPut feL_sp
    feLnU64 get feFoldOp1 0
    feLnPut feL_sp
    feLnU64 get feFoldOp2 0
    ret
  end
  feLnU64 get feIrA0 0
  feLnPut feL_sp
  feLnU64 get feIrA1 0
  feLnPut feL_sp
  feLnU64 get feIrA2 0
  feLnPut feL_sp
  feLnU64 get feIrOp1 0
  feLnPut feL_sp
  feLnU64 get feIrOp2 0
end

fn feLnEmitPolyClaim to void
  if ne get feHasFold 0 0
    feLnU64 get feFoldClaim 0
    ret
  end
  ev = feEvalPoly3 get feIrA0 0 get feIrA1 0 get feIrA2 0 get feIrOp1 0 get feIrOp2 0
  feLnU64 ev
end


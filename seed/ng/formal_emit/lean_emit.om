note ---- Basic I/O & Formatting Helpers ----

fn feWrt fd int s view uchar * to void
  p = ulong 0
  n = len s
  while lt p n bound 4096
    k = write fd s p sub n p
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn feWrtU64 fd int v ulong to void
  if eq v 0
    put feDigBuf 0 uchar 48
    z = write fd feDigBuf 0 1
    ret
  end
  p = ulong 24
  x = v
  for i ulong 24
    p = sub p 1
    put feDigBuf p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write fd feDigBuf p sub 24 p
      ret
    end
  end
end

fn feWrtGlobal fd int kind ulong n ulong to void
  p = ulong 0
  while lt p n bound 4096
    k = long 0
    if eq kind 0
      k = write fd feUnitName p sub n p
    end
    if eq kind 1
      k = write fd feTargetName p sub n p
    end
    if eq kind 2
      k = write fd feSemHex p sub n p
    end
    if eq kind 3
      k = write fd feOutShaHex p sub n p
    end
    if eq kind 4
      k = write fd feOutPath p sub n p
    end
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn feHexCh v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn feCleanupWork to void
  if gt get feLeanOutPathN 0 0
    z = unlink feLeanOutPath 0 get feLeanOutPathN 0
  end
  if gt get feLeanErrPath 0 0
    z = unlink feLeanErrPath 0 get feLeanErrPathN 0
  end
  if gt get feStagePathN 0 0
    z = unlink feStagePath 0 get feStagePathN 0
  end
  if and eq get feCertOutPathN 0 0 gt get feLeanWorkPathN 0 0
    z = unlink feLeanWorkPath 0 get feLeanWorkPathN 0
  end
end

fn feRefuse code int reason view uchar * to void
  feCleanupWork
  feWrt 2 feErrRef1
  feWrtU64 2 ulong code
  feWrt 2 feErrRef2
  feWrt 2 reason
  feWrt 2 feErrNl
  exit code
end

fn feArgEq n ulong lit view uchar * to bool
  if ne n len lit
    ret false
  end
  for i ulong len lit bound 64
    if ne get feArg i get lit i
      ret false
    end
  end
  ret true
end

fn feCopyArgTo dst ulong n ulong to void
  if or eq n 0 gt n 2040
    feRefuse FE_ERR_USAGE feUseMsg
  end
  for i ulong n bound 2048
    b = get feArg i
    if eq dst 0
      put feUnitPath i b
    end
    if eq dst 1
      put feOutPath i b
    end
    if eq dst 2
      put feCertOutPath i b
    end
    if eq dst 3
      put feVerifyPath i b
    end
    if eq dst 4
      put feLeanPath i b
    end
    if eq dst 5
      put feWorkDir i b
    end
    if eq dst 6
      put feChipsPath i b
    end
  end
  if eq dst 0
    put feUnitPathN 0 n
  end
  if eq dst 1
    put feOutPathN 0 n
  end
  if eq dst 2
    put feCertOutPathN 0 n
  end
  if eq dst 3
    put feVerifyPathN 0 n
  end
  if eq dst 4
    put feLeanPathN 0 n
  end
  if eq dst 5
    put feWorkDirN 0 n
  end
  if eq dst 6
    put feChipsPathN 0 n
  end
end

fn feSetTextTo dst ulong s view uchar * to void
  n = len s
  for i ulong n bound 2048
    b = get s i
    if eq dst 0
      put feWorkDir i b
    end
    if eq dst 1
      put feUnitName i b
    end
    if eq dst 2
      put feTargetName i b
    end
    if eq dst 3
      put feChipsPath i b
    end
    if eq dst 4
      put feLeanPath i b
    end
  end
  if eq dst 0
    put feWorkDirN 0 n
  end
  if eq dst 1
    put feUnitNameN 0 n
  end
  if eq dst 2
    put feTargetNameN 0 n
  end
  if eq dst 3
    put feChipsPathN 0 n
  end
  if eq dst 4
    put feLeanPathN 0 n
  end
end

fn feInitDefaults to void
  put feUnitPathN 0 0
  put feOutPathN 0 0
  put feCertOutPathN 0 0
  put feVerifyPathN 0 0
  put feLeanPathN 0 0
  put feModeVerify 0 0
  put feStagePathN 0 0
  put feLeanWorkPathN 0 0
  put feLeanOutPathN 0 0
  put feLeanErrPathN 0 0
  feSetTextTo 0 feDefWd
  feSetTextTo 1 feDefUnit
  feSetTextTo 2 feDefTgt
  feSetTextTo 3 feDefChips
  put feTargetTid 0 TID_X925
  put feMaxNgpr 0 30
  put feMaxSmem 0 0
  put feMaxSubg 0 4
  put feMaxL2Kb 0 2048

  put fePure 0 0
  put fePrec 0 0
  put feHardDl 0 0
  put feErrBound 0 0
  put feDlUs 0 0
  put fePowerMw 0 0
  put feIrA0 0 7
  put feIrA1 0 5
  put feIrA2 0 3
  put feIrOp1 0 1
  put feIrOp2 0 3
  put feHasFold 0 0
  put feFoldA0 0 7
  put feFoldA1 0 5
  put feFoldA2 0 3
  put feFoldOp1 0 1
  put feFoldOp2 0 3
  put feFoldClaim 0 36
  put feIrEffKind 0 0
  put feEffOps 0 0
  put feMutGlobs 0 0
  put feEditPars 0 0
  put feTrapExits 0 0

  for i ulong FE_MAX_REGS
    put feRegUsed i 0
    put feRegId i 0
    put feRegDom i 0
    put feRegPBase i 0
    put feRegPSize i 0
    put feRegGva i 0
    put feRegGvlen i 0
    put feRegMState i 0
    put feRegEpoch i 0
    put feRegDrain i 0
    put feRegVma i 0
    put feRegLife i 0
  end
  put feActCnt 0 0

  put feWtDie 0 52000
  put feWtSink 0 44000
  put feWtAmb 0 25000
  put feWpBud 0 130000
  put feWpGpuBud 0 79999
  put feWtCeil 0 85000
  put feWtau 0 3
  put feWpGpu 0 0
  put feWpCpu 0 18000
  put feWpUnc 0 10000
  put feWfan 0 50
  put feHasWattProp 0 0

  put feSmRegs 0 16
  put feSmSmem 0 0
  put feSmSubg 0 4
  put feSmRawFloor 0 6
  put feInCnt 0 0
end

fn feCheckRwxAll to void
  ac = ulong argcnt
  i = ulong 1
  while lt i ac bound 128
    k = argread i feArg 0 4095
    if gt k 0
      if feArgEq ulong k feF_rwx
        feWrt 2 feErrRwx
        exit FE_ERR_RWX
      end
    end
    i = add i 1
  end
end

fn feParseCli to void
  ac = ulong argcnt
  if lt ac 2
    feWrt 1 feUseMsg
    exit 0
  end
  k1 = argread 1 feArg 0 4095
  if gt k1 0
    if or feArgEq ulong k1 feF_help feArgEq ulong k1 feF_h
      feWrt 1 feUseMsg
      exit 0
    end
  end
  feCheckRwxAll
  i = ulong 1
  while lt i ac bound 128
    k = argread i feArg 0 4095
    if lt k 1
      feRefuse FE_ERR_USAGE feUseMsg
    end
    al = ulong k
    nx = add i 1
    if ge nx ac
      feRefuse FE_ERR_USAGE feUseMsg
    end
    which = ulong 99
    if feArgEq al feF_unit
      which = ulong 0
    end
    if feArgEq al feF_out
      which = ulong 1
    end
    if feArgEq al feF_cert
      which = ulong 2
    end
    if feArgEq al feF_ver
      put feModeVerify 0 1
      which = ulong 3
    end
    if feArgEq al feF_lean
      which = ulong 4
    end
    if feArgEq al feF_wd
      which = ulong 5
    end
    if feArgEq al feF_chips
      which = ulong 6
    end
    if eq which 99
      feRefuse FE_ERR_USAGE feUseMsg
    end
    k2 = argread nx feArg 0 4095
    if lt k2 1
      feRefuse FE_ERR_USAGE feUseMsg
    end
    feCopyArgTo which ulong k2
    i = add i 2
  end
  if eq get feOutPathN 0 0
    feRefuse FE_ERR_USAGE feUseMsg
  end
  if and eq get feModeVerify 0 0 eq get feUnitPathN 0 0
    feRefuse FE_ERR_USAGE feUseMsg
  end
end

fn feResolveLeanBin to void
  if gt get feLeanPathN 0 0
    if eq faccess feLeanPath 0 get feLeanPathN 0 1 0
      ret
    end
    feRefuse FE_ERR_IO feR_io
  end
  ec = ulong envcnt
  for i ulong ec bound 512
    n = envread i feEnv 0 4095
    if ge n 6
      ok = true
      for j ulong 5
        if ne get feEnv j get feHomePfx j
          ok = false
        end
      end
      if ok
        hl = sub ulong n 5
        if le add hl len feElanRel 2040
          for j ulong hl bound 1900
            put feLeanPath j get feEnv add 5 j
          end
          for j ulong len feElanRel bound 64
            put feLeanPath add hl j get feElanRel j
          end
          tot = add hl len feElanRel
          put feLeanPathN 0 tot
          if eq faccess feLeanPath 0 tot 1 0
            ret
          end
        end
      end
    end
  end
  feSetTextTo 4 feLeanUsr
  if eq faccess feLeanPath 0 get feLeanPathN 0 1 0
    ret
  end
  feSetTextTo 4 feLeanBin
  if eq faccess feLeanPath 0 get feLeanPathN 0 1 0
    ret
  end
  feRefuse FE_ERR_LEAN feR_lean
end

fn feBuildWorkPaths to void
  wn = get feWorkDirN 0
  if or eq wn 0 gt wn 2000
    feRefuse FE_ERR_IO feR_io
  end
  z = makedir feWorkDir 0 wn 448
  for i ulong wn bound 2048
    b = get feWorkDir i
    put feLeanWorkPath i b
    put feLeanOutPath i b
    put feLeanErrPath i b
  end
  for j ulong len feSufCert bound 64
    put feLeanWorkPath add wn j get feSufCert j
  end
  put feLeanWorkPathN 0 add wn len feSufCert
  for j ulong len feSufLOut bound 64
    put feLeanOutPath add wn j get feSufLOut j
  end
  put feLeanOutPathN 0 add wn len feSufLOut
  for j ulong len feSufLErr bound 64
    put feLeanErrPath add wn j get feSufLErr j
  end
  put feLeanErrPathN 0 add wn len feSufLErr

  on = get feOutPathN 0
  for i ulong on bound 2048
    put feStagePath i get feOutPath i
  end
  for j ulong len feSufStage bound 16
    put feStagePath add on j get feSufStage j
  end
  put feStagePathN 0 add on len feSufStage
end

note ---- Descriptor Tokenizer & Parser ----

fn feIsWs c ulong to bool
  if or eq c 32 or eq c 9 eq c 13
    ret true
  end
  ret false
end

fn feTokenizeLine llen ulong to ulong
  put feNToks 0 0
  p = ulong 0
  while lt p llen bound 1024
    while lt p llen bound 1024
      if not feIsWs ulong get feLine p
        break
      end
      p = add p 1
    end
    if ge p llen
      break
    end
    s = p
    while lt p llen bound 1024
      if feIsWs ulong get feLine p
        break
      end
      p = add p 1
    end
    nt = get feNToks 0
    if ge nt 15
      put feParseBad 0 1
      ret nt
    end
    put feTokS nt s
    put feTokL nt sub p s
    put feNToks 0 add nt 1
  end
  ret get feNToks 0
end

fn feTokEq idx ulong kw view uchar * to bool
  if ge idx get feNToks 0
    ret false
  end
  tl = get feTokL idx
  if ne tl len kw
    ret false
  end
  ts = get feTokS idx
  for i ulong tl bound 64
    if ne get feLine add ts i get kw i
      ret false
    end
  end
  ret true
end

fn feTokU64 idx ulong to ulong
  if ge idx get feNToks 0
    put feParseBad 0 1
    ret 0
  end
  s = get feTokS idx
  l = get feTokL idx
  if eq l 0
    put feParseBad 0 1
    ret 0
  end
  if ge l 3
    c0 = ulong get feLine s
    c1 = ulong get feLine add s 1
    if and eq c0 48 or eq c1 120 eq c1 88
      hl = sub l 2
      if gt hl 16
        put feParseBad 0 1
        ret 0
      end
      v = ulong 0
      for i ulong hl bound 16
        ch = ulong get feLine add s add 2 i
        d = ulong 99
        if and ge ch 48 le ch 57
          d = sub ch 48
        end
        if and ge ch 97 le ch 102
          d = add 10 sub ch 97
        end
        if and ge ch 65 le ch 70
          d = add 10 sub ch 65
        end
        if ge d 16
          put feParseBad 0 1
          ret 0
        end
        v = add mul v 16 d
      end
      ret v
    end
  end
  if gt l 20
    put feParseBad 0 1
    ret 0
  end
  v2 = ulong 0
  for i ulong l bound 20
    c = ulong get feLine add s i
    if or lt c 48 gt c 57
      put feParseBad 0 1
      ret 0
    end
    if gt v2 1844674407370955161
      put feParseBad 0 1
      ret 0
    end
    p10 = mul v2 10
    nxt = add p10 sub c 48
    if lt nxt p10
      put feParseBad 0 1
      ret 0
    end
    v2 = nxt
  end
  ret v2
end

fn feTokI64 idx ulong to long
  if ge idx get feNToks 0
    put feParseBad 0 1
    ret 0
  end
  s = get feTokS idx
  l = get feTokL idx
  if eq l 0
    put feParseBad 0 1
    ret 0
  end
  isNeg = false
  st = ulong 0
  if eq get feLine s 45
    isNeg = true
    st = ulong 1
    if eq l 1
      put feParseBad 0 1
      ret 0
    end
  end
  v = ulong 0
  for i ulong sub l st bound 20
    c = ulong get feLine add s add st i
    if or lt c 48 gt c 57
      put feParseBad 0 1
      ret 0
    end
    if gt v 922337203685477580
      put feParseBad 0 1
      ret 0
    end
    v = add mul v 10 sub c 48
  end
  if gt v 9223372036854775807
    put feParseBad 0 1
    ret 0
  end
  if isNeg
    ret neg long v
  end
  ret long v
end

fn feTokCopyName idx ulong dst ulong to void
  if ge idx get feNToks 0
    put feParseBad 0 1
    ret
  end
  s = get feTokS idx
  l = get feTokL idx
  if or eq l 0 gt l 63
    put feParseBad 0 1
    ret
  end
  for i ulong l bound 64
    b = get feLine add s i
    if eq dst 0
      put feUnitName i b
    else
      put feTargetName i b
    end
  end
  if eq dst 0
    put feUnitNameN 0 l
  else
    put feTargetNameN 0 l
  end
end

fn feTokOp idx ulong to ulong
  if feTokEq idx feOp_add
    ret 1
  end
  if feTokEq idx feOp_sub
    ret 2
  end
  if feTokEq idx feOp_mul
    ret 3
  end
  if feTokEq idx feOp_and
    ret 4
  end
  if feTokEq idx feOp_or
    ret 5
  end
  if feTokEq idx feOp_xor
    ret 6
  end
  put feParseBad 0 1
  ret 0
end

fn feTokDom idx ulong to ulong
  if feTokEq idx feDom_0
    ret FE_DOM_HOST
  end
  if feTokEq idx feDom_1
    ret FE_DOM_KSLAB
  end
  if feTokEq idx feDom_2
    ret FE_DOM_GPUDMA
  end
  if feTokEq idx feDom_3
    ret FE_DOM_GMMU
  end
  if feTokEq idx feDom_4
    ret FE_DOM_MMIO
  end
  if feTokEq idx feDom_5
    ret FE_DOM_SHARED
  end
  put feParseBad 0 1
  ret 0
end

fn feTokPipe idx ulong to ulong
  if feTokEq idx fePip_alu
    ret FE_PIPE_ALU
  end
  if feTokEq idx fePip_hmma
    ret FE_PIPE_HMMA
  end
  if feTokEq idx fePip_omma
    ret FE_PIPE_OMMA
  end
  if feTokEq idx fePip_exit
    ret FE_PIPE_EXIT
  end
  put feParseBad 0 1
  ret 0
end

fn fePushAct k ulong a0 ulong a1 ulong a2 ulong a3 ulong to void
  c = get feActCnt 0
  if ge c FE_MAX_ACTS
    put feParseBad 0 1
    ret
  end
  put feActKind c k
  put feActA0 c a0
  put feActA1 c a1
  put feActA2 c a2
  put feActA3 c a3
  put feActCnt 0 add c 1
end

fn feWantNt n ulong to bool
  if ne get feNToks 0 n
    put feParseBad 0 1
    ret false
  end
  ret true
end

fn feParseLineIr nt ulong to bool
  if feTokEq 0 feK_pure
    if feWantNt 1
      put fePure 0 1
    end
    ret true
  end
  if feTokEq 0 feK_exact
    if feWantNt 1
      put fePrec 0 1
    end
    ret true
  end
  if feTokEq 0 feK_tol
    if feWantNt 2
      put fePrec 0 2
      put feErrBound 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_dl
    if feWantNt 2
      put feDlUs 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_hdl
    if feWantNt 2
      put feHardDl 0 1
      put feDlUs 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_pwr
    if feWantNt 2
      put fePowerMw 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_irfn
    if feWantNt 6
      put feIrA0 0 feTokU64 1
      put feIrA1 0 feTokU64 2
      put feIrA2 0 feTokU64 3
      put feIrOp1 0 feTokOp 4
      put feIrOp2 0 feTokOp 5
    end
    ret true
  end
  if feTokEq 0 feK_irfld
    if feWantNt 7
      put feHasFold 0 1
      put feFoldA0 0 feTokU64 1
      put feFoldA1 0 feTokU64 2
      put feFoldA2 0 feTokU64 3
      put feFoldOp1 0 feTokOp 4
      put feFoldOp2 0 feTokOp 5
      put feFoldClaim 0 feTokU64 6
    end
    ret true
  end
  if feTokEq 0 feK_ireff
    if feWantNt 2
      if feTokEq 1 feEff_none
        put feIrEffKind 0 0
        ret true
      end
      if feTokEq 1 feEff_host
        put feIrEffKind 0 1
        ret true
      end
      if feTokEq 1 feEff_gmut
        put feIrEffKind 0 2
        ret true
      end
      if feTokEq 1 feEff_trap
        put feIrEffKind 0 3
        ret true
      end
      if feTokEq 1 feEff_edit
        put feIrEffKind 0 4
        ret true
      end
      put feParseBad 0 1
    end
    ret true
  end
  ret false
end

fn feParseLineOm3 nt ulong to bool
  if feTokEq 0 feK_reg
    if feWantNt 5
      fePushAct FE_ACT_ALLOC feTokU64 1 feTokDom 2 feTokU64 3 feTokU64 4
    end
    ret true
  end
  if feTokEq 0 feK_map
    if feWantNt 4
      fePushAct FE_ACT_MAP feTokU64 1 feTokU64 2 feTokU64 3 0
    end
    ret true
  end
  if feTokEq 0 feK_pin
    if feWantNt 2
      fePushAct FE_ACT_PIN feTokU64 1 0 0 0
    end
    ret true
  end
  if feTokEq 0 feK_sub
    if feWantNt 3
      fePushAct FE_ACT_SUBMIT feTokU64 1 feTokU64 2 0 0
    end
    ret true
  end
  if feTokEq 0 feK_acc
    if feWantNt 4
      fePushAct FE_ACT_ACCESS feTokU64 1 feTokU64 2 feTokU64 3 0
    end
    ret true
  end
  if feTokEq 0 feK_unm
    if feWantNt 2
      fePushAct FE_ACT_UNMAP feTokU64 1 0 0 0
    end
    ret true
  end
  if feTokEq 0 feK_tlb
    if feWantNt 2
      fePushAct FE_ACT_TLB feTokU64 1 0 0 0
    end
    ret true
  end
  if feTokEq 0 feK_fnc
    if feWantNt 3
      fePushAct FE_ACT_FENCE feTokU64 1 feTokU64 2 0 0
    end
    ret true
  end
  if feTokEq 0 feK_rev
    if feWantNt 2
      fePushAct FE_ACT_REVOKE feTokU64 1 0 0 0
    end
    ret true
  end
  if feTokEq 0 feK_rcl
    if feWantNt 2
      fePushAct FE_ACT_RECLAIM feTokU64 1 0 0 0
    end
    ret true
  end
  ret false
end

fn feParseLineWattSm nt ulong to bool
  if feTokEq 0 feK_wst
    if feWantNt 4
      put feWtDie 0 feTokI64 1
      put feWtSink 0 feTokI64 2
      put feWtAmb 0 feTokI64 3
    end
    ret true
  end
  if feTokEq 0 feK_wpl
    if feWantNt 5
      put feWpBud 0 feTokI64 1
      put feWpGpuBud 0 feTokI64 2
      put feWtCeil 0 feTokI64 3
      put feWtau 0 feTokI64 4
    end
    ret true
  end
  if feTokEq 0 feK_wpr
    if feWantNt 5
      put feWpGpu 0 feTokI64 1
      put feWpCpu 0 feTokI64 2
      put feWpUnc 0 feTokI64 3
      put feWfan 0 feTokI64 4
      put feHasWattProp 0 1
    end
    ret true
  end
  if feTokEq 0 feK_sreg
    if feWantNt 2
      put feSmRegs 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_ssmem
    if feWantNt 2
      put feSmSmem 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_ssubg
    if feWantNt 2
      put feSmSubg 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_sraw
    if feWantNt 2
      put feSmRawFloor 0 feTokU64 1
    end
    ret true
  end
  if feTokEq 0 feK_sins
    if feWantNt 10
      ic = get feInCnt 0
      if ge ic FE_MAX_INSNS
        put feParseBad 0 1
        ret true
      end
      put feInPc ic feTokU64 1
      put feInPipe ic feTokPipe 2
      put feInRd ic feTokU64 3
      put feInR1 ic feTokU64 4
      put feInR2 ic feTokU64 5
      put feInHasRd ic feTokU64 6
      put feInHasR1 ic feTokU64 7
      put feInHasR2 ic feTokU64 8
      put feInStall ic feTokU64 9
      put feInCnt 0 add ic 1
    end
    ret true
  end
  ret false
end

fn feDispatchLine llen ulong to void
  nt = feTokenizeLine llen
  if eq nt 0
    ret
  end
  if ne get feParseBad 0 0
    ret
  end
  if feTokEq 0 feK_note
    ret
  end
  if feTokEq 0 feK_unit
    if feWantNt 2
      feTokCopyName 1 0
    end
    ret
  end
  if feTokEq 0 feK_tgt
    if feWantNt 2
      feTokCopyName 1 1
    end
    ret
  end
  if feParseLineIr nt
    ret
  end
  if feParseLineOm3 nt
    ret
  end
  if feParseLineWattSm nt
    ret
  end
  put feParseBad 0 1
end

fn feReadFileInto pathKind ulong to long
  p = new uchar 2048 0
  plen = ulong 0
  if eq pathKind 0
    plen = get feUnitPathN 0
    for i ulong plen bound 2048
      put p i get feUnitPath i
    end
  end
  if eq pathKind 1
    plen = get feVerifyPathN 0
    for i ulong plen bound 2048
      put p i get feVerifyPath i
    end
  end
  if eq pathKind 2
    plen = get feLeanOutPathN 0
    for i ulong plen bound 2200
      put p i get feLeanOutPath i
    end
  end
  if eq pathKind 3
    plen = get feLeanErrPathN 0
    for i ulong plen bound 2200
      put p i get feLeanErrPath i
    end
  end
  if or eq plen 0 gt plen 2040
    ret long -1
  end
  fd = fopen p 0 plen 0 0
  if lt fd 0
    ret long -1
  end
  tot = ulong 0
  while lt tot 65530 bound 512
    r = read int fd feIoBuf 0 4096
    if le r 0
      break
    end
    ur = ulong r
    if gt add tot ur 65530
      z = fclose int fd
      ret long -1
    end
    for i ulong ur bound 4096
      b = get feIoBuf i
      if eq pathKind 0
        put feSrc add tot i b
      end
      if eq pathKind 1
        put feLeanBuf add tot i b
      end
      if eq pathKind 2
        put feLeanOut add tot i b
      end
      if eq pathKind 3
        put feLeanErr add tot i b
      end
    end
    tot = add tot ur
  end
  z = fclose int fd
  ret long tot
end

fn feParseUnitFile to void
  n = feReadFileInto 0
  if le n 0
    feRefuse FE_ERR_IO feR_io
  end
  put feSrcLen 0 ulong n
  put feParseBad 0 0
  put feParseLine 0 0
  p = ulong 0
  sn = ulong n
  while lt p sn bound 65536
    ls = p
    while lt p sn bound 65536
      if eq get feSrc p 10
        break
      end
      p = add p 1
    end
    le_ = p
    if lt p sn
      p = add p 1
    end
    ll = sub le_ ls
    if gt ll 1020
      feRefuse FE_ERR_IO feR_io
    end
    for i ulong ll bound 1024
      put feLine i get feSrc add ls i
    end
    put feParseLine 0 add get feParseLine 0 1
    feDispatchLine ll
    if ne get feParseBad 0 0
      feRefuse FE_ERR_IO feR_io
    end
  end
end

fn feTgtEq kw view uchar * to bool
  tl = get feTargetNameN 0
  if ne tl len kw
    ret false
  end
  for i ulong tl bound 64
    if ne get feTargetName i get kw i
      ret false
    end
  end
  ret true
end

fn feResolveTarget to void
  cp = new uchar 2048 0
  tn = new uchar 64 0
  cn = get feChipsPathN 0
  for i ulong cn bound 2048
    put cp i get feChipsPath i
  end
  if eq ctLoadFile view cp cn 0
    tnl = get feTargetNameN 0
    for i ulong tnl bound 64
      put tn i get feTargetName i
    end
    cid = ctFindChip view tn tnl
    if lt cid ctCount
      put feMaxNgpr 0 ctNgpr cid
      put feMaxSmem 0 ctSmem cid
      put feMaxSubg 0 ctSubgroup cid
      put feMaxL2Kb 0 ctL2Kb cid
      if or eq ctIsa cid ISA_SM121 eq ctExec cid EXEC_SIMT_WARP
        put feTargetTid 0 TID_SM121
      else
        put feTargetTid 0 TID_X925
      end
      ret
    end
  end
  if feTgtEq feT_x925
    put feTargetTid 0 TID_X925
    put feMaxNgpr 0 30
    put feMaxSmem 0 0
    put feMaxSubg 0 4
    put feMaxL2Kb 0 2048
    ret
  end
  if feTgtEq feT_a725
    put feTargetTid 0 TID_A725
    put feMaxNgpr 0 30
    put feMaxSmem 0 0
    put feMaxSubg 0 4
    put feMaxL2Kb 0 512
    ret
  end
  if feTgtEq feT_app
    put feTargetTid 0 TID_X925
    put feMaxNgpr 0 29
    put feMaxSmem 0 0
    put feMaxSubg 0 4
    put feMaxL2Kb 0 16384
    ret
  end
  if feTgtEq feT_x64
    put feTargetTid 0 TID_X64_AVX2
    put feMaxNgpr 0 15
    put feMaxSmem 0 0
    put feMaxSubg 0 8
    put feMaxL2Kb 0 512
    ret
  end
  if feTgtEq feT_rv
    put feTargetTid 0 TID_RV64_RVV
    put feMaxNgpr 0 30
    put feMaxSmem 0 0
    put feMaxSubg 0 8
    put feMaxL2Kb 0 512
    ret
  end
  if feTgtEq feT_sm
    put feTargetTid 0 TID_SM121
    put feMaxNgpr 0 64
    put feMaxSmem 0 101376
    put feMaxSubg 0 32
    put feMaxL2Kb 0 24576
    ret
  end
  if feTgtEq feT_gb10
    put feTargetTid 0 TID_APU_GB10
    put feMaxNgpr 0 64
    put feMaxSmem 0 101376
    put feMaxSubg 0 32
    put feMaxL2Kb 0 24576
    ret
  end
  if feTgtEq feT_ring
    put feTargetTid 0 TID_SPARK_RING
    put feMaxNgpr 0 64
    put feMaxSmem 0 101376
    put feMaxSubg 0 32
    put feMaxL2Kb 0 49152
    ret
  end
  feRefuse FE_ERR_IO feR_io
end

note ---- Stage 1: Real OIR v2 Builder, Structural Purity & Constant-Fold Checker ----

fn feIrOpCode k ulong to uint
  if eq k 1
    ret 10
  end
  if eq k 2
    ret 11
  end
  if eq k 3
    ret 12
  end
  if eq k 4
    ret 16
  end
  if eq k 5
    ret 17
  end
  ret 18
end

fn feEvalOp64 op ulong a ulong b ulong to ulong
  if eq op 1
    ret add a b
  end
  if eq op 2
    ret sub a b
  end
  if eq op 3
    ret mul a b
  end
  if eq op 4
    ret and a b
  end
  if eq op 5
    ret or a b
  end
  if eq op 6
    ret xor a b
  end
  ret 0
end

fn feEvalPoly3 a0 ulong a1 ulong a2 ulong op1 ulong op2 ulong to ulong
  t = feEvalOp64 op1 a0 a1
  ret feEvalOp64 op2 t a2
end

fn feIrAttachEff f uint b uint tk uint vret uint to void
  eff = get feIrEffKind 0
  if eq eff 1
    arr1 = ir_tarr 5 4
    g1 = ir_glob arr1 0
    ga1 = ir_op b 52 ir_tref arr1 1 0 ulong g1 0
    z1 = ir_res ir_op b 1 5 0 0
    one = ir_res ir_op b 1 5 1 0
    ho = ir_op b 110 9 54 5
    ir_set ho 0 tk
    ir_set ho 1 one
    ir_set ho 2 ir_res ga1
    ir_set ho 3 z1
    ir_set ho 4 one
    tk = ir_otok ho
  end
  if eq eff 2
    arr2 = ir_tarr 5 4
    g2 = ir_glob arr2 0
    ga2 = ir_op b 52 ir_tref arr2 1 0 ulong g2 0
    z2 = ir_res ir_op b 1 5 0 0
    so = ir_op b 43 0 0 4
    ir_set so 0 tk
    ir_set so 1 ir_res ga2
    ir_set so 2 z2
    ir_set so 3 vret
    tk = ir_otok so
  end
  if eq eff 3
    tr = ir_op b 65 0 8 1
    ir_set tr 0 tk
  else
    rv = ir_op b 63 0 0 2
    ir_set rv 0 tk
    ir_set rv 1 vret
  end
end

fn feIrBuildUnit to uint
  ir_init
  ir_set_ver 10
  eff = get feIrEffKind 0
  f = ir_fnew 0 0 5
  ir_fset_mode f get fePure 0 get fePrec 0 get feHardDl 0
  ir_fset_phys f get feErrBound 0 get feDlUs 0 get fePowerMw 0
  d = ir_fpar f 5
  d = ir_fpar f 5
  d = ir_fpar f 5
  if eq eff 4
    st = ir_tslc 5 1 0
    d = ir_fpar f st
  end
  b = ir_blk f
  c0 = ir_res ir_op b 1 5 get feIrA0 0 0
  c1 = ir_res ir_op b 1 5 get feIrA1 0 0
  c2 = ir_res ir_op b 1 5 get feIrA2 0 0
  o1 = ir_op b feIrOpCode get feIrOp1 0 5 0 2
  ir_set o1 0 c0
  ir_set o1 1 c1
  o2 = ir_op b feIrOpCode get feIrOp2 0 5 0 2
  ir_set o2 0 ir_res o1
  ir_set o2 1 c2
  feIrAttachEff f b ir_ftok f ir_res o2
  ret f
end

fn feIrScanParams f uint to void
  vp = get i_fp1 f
  while ne vp 0 bound 64
    vt = get i_vty vp
    if ge vt 32
      vk = ulong get i_tk vt
      if and or eq vk 4 eq vk 5 eq get i_t2 vt 1
        put feEditPars 0 add get feEditPars 0 1
      end
    end
    vp = get i_vnx vp
  end
end

fn feIrScanOps f uint to void
  ob = get i_fb1 f
  while ne ob 0 bound 64
    oo = get i_bo1 ob
    while ne oo 0 bound 1024
      opc = uint get i_oop oo
      if eq get i_rtk opc 1
        put feEffOps 0 add get feEffOps 0 1
      end
      if or eq opc 65 eq opc 66
        put feTrapExits 0 add get feTrapExits 0 1
      end
      oo = get i_onx oo
    end
    ob = get i_bnx ob
  end
end

fn feIrScanPurity f uint to void
  if not ir_fc_ok get fePure 0 get fePrec 0 get feHardDl 0 0 get feErrBound 0 get feDlUs 0
    feRefuse FE_ERR_IR feR_ir_pure
  end
  if ne get fePure 0 1
    feRefuse FE_ERR_IR feR_ir_pure
  end
  put feEffOps 0 0
  put feMutGlobs 0 0
  put feEditPars 0 0
  put feTrapExits 0 0
  feIrScanParams f
  if eq get feIrEffKind 0 2
    put feMutGlobs 0 1
  end
  feIrScanOps f
  if gt get feEffOps 0 0
    feRefuse FE_ERR_IR feR_ir_pure
  end
  if gt get feMutGlobs 0 0
    feRefuse FE_ERR_IR feR_ir_pure
  end
  if gt get feEditPars 0 0
    feRefuse FE_ERR_IR feR_ir_pure
  end
  if gt get feTrapExits 0 0
    feRefuse FE_ERR_IR feR_ir_pure
  end
end

fn feIrComputeSemHex f uint to void
  put feIrBytes 0 ir_wr
  m = ir_wfn_sem f
  if or eq m 0 gt m 65536
    feRefuse FE_ERR_IR feR_ir_pure
  end
  for i ulong m bound 65536
    put sh_dat i ar_bg 1 i
  end
  sh_all m
  for i ulong 32
    bt = ulong get sh_dig i
    put feSemHex mul i 2 feHexCh shr bt 4
    put feSemHex add mul i 2 1 feHexCh and bt 15
  end
end

fn feVerifyIrV2 to void
  f = feIrBuildUnit
  feIrScanPurity f
  feIrComputeSemHex f
  if ne get feHasFold 0 0
    ev = feEvalPoly3 get feFoldA0 0 get feFoldA1 0 get feFoldA2 0 get feFoldOp1 0 get feFoldOp2 0
    if ne ev get feFoldClaim 0
      feRefuse FE_ERR_IR feR_ir_fold
    end
  end
end

note ---- Stage 2: OM-3 Disjoint Domain, Kernel-Slab Isolation & 4-Step Fence Verifier ----

fn feOm3FindReg rid ulong to ulong
  for i ulong FE_MAX_REGS
    if and ne get feRegUsed i 0 eq get feRegId i rid
      ret i
    end
  end
  ret FE_MAX_REGS
end

fn feOm3Ovl a0 ulong al ulong b0 ulong bl ulong to bool
  if or eq al 0 eq bl 0
    ret false
  end
  ae = add a0 al
  be = add b0 bl
  if and lt a0 be lt b0 ae
    ret true
  end
  ret false
end

fn feOm3U64Ovl a0 ulong al ulong to bool
  if eq al 0
    ret true
  end
  s = add a0 al
  ret le s a0
end

fn feOm3Alloc rid ulong dom ulong pbase ulong psize ulong to void
  if or eq dom 0 gt dom 6
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if feOm3U64Ovl pbase psize
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if ne feOm3FindReg rid FE_MAX_REGS
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  slot = FE_MAX_REGS
  for i ulong FE_MAX_REGS
    if eq get feRegUsed i 0
      if eq slot FE_MAX_REGS
        slot = i
      end
    else
      if eq get feRegLife i FE_LIFE_LIVE
        if feOm3Ovl pbase psize get feRegPBase i get feRegPSize i
          feRefuse FE_ERR_OM3 feR_om3_dom
        end
      end
    end
  end
  if eq slot FE_MAX_REGS
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  put feRegUsed slot 1
  put feRegId slot rid
  put feRegDom slot dom
  put feRegPBase slot pbase
  put feRegPSize slot psize
  put feRegGva slot 0
  put feRegGvlen slot 0
  put feRegMState slot FE_MAP_NONE
  put feRegEpoch slot 0
  put feRegDrain slot 0
  put feRegVma slot 0
  put feRegLife slot FE_LIFE_LIVE
end

fn feOm3Map rid ulong va ulong vlen ulong to void
  idx = feOm3FindReg rid
  if eq idx FE_MAX_REGS
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if ne get feRegLife idx FE_LIFE_LIVE
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if eq get feRegDom idx FE_DOM_KSLAB
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if ne get feRegMState idx FE_MAP_NONE
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if or eq va 0 or feOm3U64Ovl va vlen gt vlen get feRegPSize idx
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  for i ulong FE_MAX_REGS
    if and ne get feRegUsed i 0 eq get feRegLife i FE_LIFE_LIVE
      if gt get feRegGvlen i 0
        if feOm3Ovl va vlen get feRegGva i get feRegGvlen i
          feRefuse FE_ERR_OM3 feR_om3_dom
        end
      end
    end
  end
  put feRegGva idx va
  put feRegGvlen idx vlen
  put feRegMState idx FE_MAP_MAPPED
end

fn feOm3StepAccess idx ulong a1 ulong a2 ulong to void
  ms = get feRegMState idx
  dm = get feRegDom idx
  if or eq dm FE_DOM_GPUDMA eq dm FE_DOM_GMMU
    if ne ms FE_MAP_MAPPED
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
  end
  if feOm3U64Ovl a1 a2
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if gt add a1 a2 get feRegPSize idx
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if eq ms FE_MAP_MAPPED
    if gt add a1 a2 get feRegGvlen idx
      feRefuse FE_ERR_OM3 feR_om3_dom
    end
  end
end

fn feOm3StepReclaim idx ulong ms ulong to void
  if ne ms FE_MAP_TLB
    feRefuse FE_ERR_OM3 feR_om3_tlb
  end
  if gt get feRegEpoch idx get feRegDrain idx
    feRefuse FE_ERR_OM3 feR_om3_tlb
  end
  if gt get feRegVma idx 0
    feRefuse FE_ERR_OM3 feR_om3_tlb
  end
  put feRegLife idx FE_LIFE_RECLAIMED
  put feRegGva idx 0
  put feRegGvlen idx 0
end

fn feOm3StepOne k ulong a0 ulong a1 ulong a2 ulong a3 ulong to void
  if eq k FE_ACT_ALLOC
    feOm3Alloc a0 a1 a2 a3
    ret
  end
  if eq k FE_ACT_MAP
    feOm3Map a0 a1 a2
    ret
  end
  idx = feOm3FindReg a0
  if eq idx FE_MAX_REGS
    feRefuse FE_ERR_OM3 feR_om3_dom
  end
  if ne get feRegLife idx FE_LIFE_LIVE
    feRefuse FE_ERR_OM3 feR_om3_tlb
  end
  ms = get feRegMState idx
  if eq k FE_ACT_PIN
    if eq get feRegDom idx FE_DOM_KSLAB
      feRefuse FE_ERR_OM3 feR_om3_dom
    end
    if or eq ms FE_MAP_CLEARED eq ms FE_MAP_TLB
      feRefuse FE_ERR_OM3 feR_om3_dom
    end
    put feRegVma idx add get feRegVma idx 1
    ret
  end
  if eq k FE_ACT_SUBMIT
    if eq get feRegDom idx FE_DOM_KSLAB
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    if ne ms FE_MAP_MAPPED
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    if le a1 get feRegEpoch idx
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    put feRegEpoch idx a1
    ret
  end
  if eq k FE_ACT_ACCESS
    feOm3StepAccess idx a1 a2
    ret
  end
  if eq k FE_ACT_UNMAP
    if ne ms FE_MAP_MAPPED
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    put feRegMState idx FE_MAP_CLEARED
    ret
  end
  if eq k FE_ACT_TLB
    if ne ms FE_MAP_CLEARED
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    put feRegMState idx FE_MAP_TLB
    ret
  end
  if eq k FE_ACT_FENCE
    if ne ms FE_MAP_TLB
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    if lt a1 get feRegEpoch idx
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    put feRegDrain idx a1
    ret
  end
  if eq k FE_ACT_REVOKE
    if eq get feRegVma idx 0
      feRefuse FE_ERR_OM3 feR_om3_tlb
    end
    put feRegVma idx sub get feRegVma idx 1
    ret
  end
  if eq k FE_ACT_RECLAIM
    feOm3StepReclaim idx ms
  end
end

fn feVerifyOm3 to void
  cnt = get feActCnt 0
  for i ulong cnt bound 128
    feOm3StepOne get feActKind i get feActA0 i get feActA1 i get feActA2 i get feActA3 i
  end
  for r ulong FE_MAX_REGS
    if and ne get feRegUsed r 0 eq get feRegLife r FE_LIFE_LIVE
      dm = get feRegDom r
      if or eq dm FE_DOM_GPUDMA eq dm FE_DOM_GMMU
        if or ne get feRegMState r FE_MAP_NONE or gt get feRegVma r 0 gt get feRegEpoch r get feRegDrain r
          feRefuse FE_ERR_OM3 feR_om3_leak
        end
      end
    end
  end
end

note ---- Stage 3: WattCBF Strict < 80 W (<= 79999 mW) Thermal Verifier ----

fn feCeilDiv a long b long to long
  if lt a 0
    ret div a b
  end
  q = div a b
  r = rem a b
  if gt r 0
    ret add q 1
  end
  ret q
end

fn feWattBarrierOk td long ts long tc long tau long pg long pcpu long to bool
  heat = add mul 25 pg mul 5 pcpu
  cool = mul 100 sub td ts
  dT = feCeilDiv sub heat cool 1000
  barH = sub sub tc td mul tau dT
  if or lt barH 0 gt add td dT tc
    ret false
  end
  ret true
end

fn feVerifyWattCbf to void
  if eq get feHasWattProp 0 0
    if or eq get feTargetTid 0 TID_SM121 or eq get feTargetTid 0 TID_APU_GB10 eq get feTargetTid 0 TID_SPARK_RING
      put feWpGpu 0 long get fePowerMw 0
    end
  end
  pb = get feWpBud 0
  pgb = get feWpGpuBud 0
  if or le pb 0 or lt pgb 0 gt pgb 79999
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  tc = get feWtCeil 0
  if or le tc 0 or gt tc 90000 lt get feWtau 0 0
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  if or ge get feWtDie 0 tc ge get feWtSink 0 tc
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  pg = get feWpGpu 0
  if or lt pg 0 or lt get feWpCpu 0 0 lt get feWpUnc 0 0
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  cp = long get fePowerMw 0
  if or gt pg 79999 or gt pg pgb gt cp 79999
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  if and ne cp 0 gt pg cp
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  if gt pb 140000
    pb = long 140000
  end
  if gt add pg add get feWpCpu 0 get feWpUnc 0 pb
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  if or lt get feWfan 0 20 gt get feWfan 0 100
    feRefuse FE_ERR_WATTCBF feR_watt
  end
  if not feWattBarrierOk get feWtDie 0 get feWtSink 0 tc get feWtau 0 pg add get feWpCpu 0 get feWpUnc 0
    feRefuse FE_ERR_WATTCBF feR_watt
  end
end

note ---- Stage 4: SM121 Hazard rawFloor >= 6, Register Bounds & Regalloc Check ----

fn fePipeFloor p ulong to ulong
  if eq p FE_PIPE_HMMA
    ret 22
  end
  if eq p FE_PIPE_OMMA
    ret 29
  end
  if eq p FE_PIPE_EXIT
    ret 1
  end
  ret 6
end

fn feSpanStall lo ulong hi ulong to ulong
  acc = ulong 0
  cnt = get feInCnt 0
  for i ulong cnt bound 64
    pc = get feInPc i
    if and ge pc lo lt pc hi
      acc = add acc get feInStall i
    end
  end
  ret acc
end

fn feSmCheckHazardOne u ulong cnt ulong to void
  upc = get feInPc u
  urd = get feInRd u
  flr = fePipeFloor get feInPipe u
  for v ulong cnt bound 64
    vpc = get feInPc v
    if lt upc vpc
      if and ne get feInHasR1 v 0 eq get feInR1 v urd
        if lt feSpanStall upc vpc flr
          feRefuse FE_ERR_SM121 feR_sm121
        end
      end
      if and ne get feInHasR2 v 0 eq get feInR2 v urd
        if lt feSpanStall upc vpc flr
          feRefuse FE_ERR_SM121 feR_sm121
        end
      end
    end
  end
end

fn feSmCheckInsns rr ulong rf ulong to void
  cnt = get feInCnt 0
  for i ulong cnt bound 64
    if and ne get feInHasRd i 0 ge get feInRd i rr
      feRefuse FE_ERR_SM121 feR_sm121
    end
    if and ne get feInHasR1 i 0 ge get feInR1 i rr
      feRefuse FE_ERR_SM121 feR_sm121
    end
    if and ne get feInHasR2 i 0 ge get feInR2 i rr
      feRefuse FE_ERR_SM121 feR_sm121
    end
    if ne get feInPipe i FE_PIPE_EXIT
      if or lt get feInStall i rf lt get feInStall i 6
        feRefuse FE_ERR_SM121 feR_sm121
      end
    end
  end
  for u ulong cnt bound 64
    if ne get feInHasRd u 0
      feSmCheckHazardOne u cnt
    end
  end
end

fn feVerifySm121 to void
  rr = get feSmRegs 0
  mx = get feMaxNgpr 0
  rf = get feSmRawFloor 0
  if or lt rf 6 eq rr 0
    feRefuse FE_ERR_SM121 feR_sm121
  end
  if or gt rr mx gt mx 64
    feRefuse FE_ERR_SM121 feR_sm121
  end
  if gt get feSmSmem 0 get feMaxSmem 0
    feRefuse FE_ERR_SM121 feR_sm121
  end
  raReset
  for r ulong rr bound 64
    ign = raAddInterval r add r 1 RA_SPILL
  end
  if or ne raRunForNgpr mx 0 ne raVerifyComplete mx 0
    feRefuse FE_ERR_SM121 feR_sm121
  end
  feSmCheckInsns rr rf
end

note ---- Stage 5: Self-Contained Lean 4.36.0 Certificate Emitter ----

fn feLnReset to void
  put feLeanLen 0 0
end

fn feLnCh c uchar to void
  p = get feLeanLen 0
  if ge p 65530
    feRefuse FE_ERR_IO feR_io
  end
  put feLeanBuf p c
  put feLeanLen 0 add p 1
end

fn feLnPut s view uchar * to void
  n = len s
  p = get feLeanLen 0
  if gt add p n 65530
    feRefuse FE_ERR_IO feR_io
  end
  for i ulong n bound 4096
    put feLeanBuf add p i get s i
  end
  put feLeanLen 0 add p n
end

fn feLnU64 v ulong to void
  if eq v 0
    feLnCh uchar 48
    ret
  end
  tmp = new uchar 24 0
  p = ulong 24
  x = v
  for i ulong 24
    p = sub p 1
    put tmp p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  while lt p 24 bound 24
    feLnCh get tmp p
    p = add p 1
  end
end

text feL_neg_o "(-"
text feL_neg_c ")"

fn feLnI64 v long to void
  if lt v 0
    feLnPut feL_neg_o
    feLnU64 ulong neg v
    feLnPut feL_neg_c
    ret
  end
  feLnU64 ulong v
end

fn feLnPutUnit to void
  n = get feUnitNameN 0
  for i ulong n bound 64
    feLnCh get feUnitName i
  end
end

fn feLnPutTgt to void
  n = get feTargetNameN 0
  for i ulong n bound 64
    feLnCh get feTargetName i
  end
end

fn feLnPutSemHex to void
  for i ulong 64
    feLnCh get feSemHex i
  end
end

text feL_hdr1 "/-\n  Auto-generated by seed/ng/formal_emit/lean_emit.om\n  Unit: "
text feL_hdr2 "\n  Target: "
text feL_hdr3 "\n  SEMANTIC_ID (SHA-256): "
text feL_hdr4 "\n-/\n\nnamespace GeneratedCert\n\n"

text feL_ir0 "structure IrContract where\n  purityFlag     : Nat\n  precisionTier  : Nat\n  hardDeadline   : Nat\n  errBound       : Nat\n  deadlineUs     : Nat\n  powerMw        : Nat\n  effectOps      : Nat\n  mutGlobals     : Nat\n  editParams     : Nat\n  trapExits      : Nat\n  semanticIdLen  : Nat\n  deriving DecidableEq, Repr\n\n"
text feL_ir1 "def contractCanonical (c : IrContract) : Bool :=\n  decide (And (c.purityFlag <= 1) (And (c.precisionTier <= 2) (And (c.hardDeadline <= 1)\n    (And (Not (c.precisionTier = 2) -> c.errBound = 0)\n    (And (c.hardDeadline = 1 -> c.deadlineUs > 0)\n    (c.semanticIdLen = 64))))))\n\n"
text feL_ir2 "def irPureSound (c : IrContract) : Bool :=\n  decide (And (c.purityFlag = 1) (And (c.effectOps = 0) (And (c.mutGlobals = 0)\n    (And (c.editParams = 0) (c.trapExits = 0))))) && contractCanonical c\n\n"
text feL_ir3 "theorem pure_implies_no_effects (c : IrContract) (h : irPureSound c = true) :\n    And (c.purityFlag = 1) (And (c.effectOps = 0) (And (c.mutGlobals = 0)\n      (And (c.editParams = 0) (c.trapExits = 0)))) := by\n  unfold irPureSound at h\n  simp only [Bool.and_eq_true, decide_eq_true_eq] at h\n  exact h.1\n\n"
text feL_ir4 "def evalOp64 (op a b : Nat) : Nat :=\n  let m := 2 ^ 64\n  match op with\n  | 1 => (a + b) % m\n  | 2 => (a + m - (b % m)) % m\n  | 3 => (a * b) % m\n  | 4 => a &&& b\n  | 5 => a ||| b\n  | 6 => a ^^^ b\n  | _ => 0\n\ndef evalPoly3 (a0 a1 a2 op1 op2 : Nat) : Nat :=\n  evalOp64 op2 (evalOp64 op1 a0 a1) a2\n\n"

text feL_om0 "inductive Domain where\n  | cpuHost | cpuKernelSlab | gpuDeviceDma | gpuPtGmmu | mmioBar0 | sharedUncached\n  deriving DecidableEq, Repr\n\ninductive MapState where\n  | unmapped | mapped | pteCleared | tlbFlushed\n  deriving DecidableEq, Repr\n\ninductive LifeState where\n  | live | reclaimed\n  deriving DecidableEq, Repr\n\n"
text feL_om1 "structure Region where\n  rid     : Nat\n  dom     : Domain\n  pbase   : Nat\n  psize   : Nat\n  gva     : Nat\n  gvlen   : Nat\n  mstate  : MapState\n  epoch   : Nat\n  drained : Nat\n  vmaPins : Nat\n  lstate  : LifeState\n  deriving DecidableEq, Repr\n\n"
text feL_om2 "def U64_LIMIT : Nat := 18446744073709551616\n\ndef intervalsOverlap (a0 al b0 bl : Nat) : Bool :=\n  if al == 0 || bl == 0 then false\n  else decide (a0 < b0 + bl) && decide (b0 < a0 + al)\n\n"
text feL_om3 "inductive Action where\n  | allocRegion  (rid : Nat) (dom : Domain) (pbase psize : Nat)\n  | gpuMap       (rid : Nat) (va vlen : Nat)\n  | vmaPin       (rid : Nat)\n  | gpuSubmit    (rid : Nat) (ep : Nat)\n  | staticAccess (rid : Nat) (off alen : Nat)\n  | gpuUnmap     (rid : Nat)\n  | tlbInval     (rid : Nat)\n  | fenceDrain   (rid : Nat) (ep : Nat)\n  | vmaRevoke    (rid : Nat)\n  | reclaim      (rid : Nat)\n  deriving DecidableEq, Repr\n\nabbrev State := List Region\n\ndef findReg (s : State) (rid : Nat) : Option Region :=\n  s.find? (fun r => r.rid == rid)\n\ndef updateReg (s : State) (rid : Nat) (f : Region -> Region) : State :=\n  s.map (fun r => if r.rid == rid then f r else r)\n\n"
text feL_om4 "def step (s : State) (a : Action) : Option State :=\n  match a with\n  | .allocRegion rid dom pbase psize =>\n    if psize == 0 || pbase + psize >= U64_LIMIT then none\n    else if (findReg s rid).isSome then none\n    else if s.any (fun r => r.lstate == .live && intervalsOverlap pbase psize r.pbase r.psize) then none\n    else some ({ rid := rid, dom := dom, pbase := pbase, psize := psize,\n                 gva := 0, gvlen := 0, mstate := .unmapped,\n                 epoch := 0, drained := 0, vmaPins := 0, lstate := .live } :: s)\n  | .gpuMap rid va vlen =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.dom == .cpuKernelSlab || r.mstate != .unmapped then none\n      else if va == 0 || vlen == 0 || va + vlen >= U64_LIMIT || vlen > r.psize then none\n      else if s.any (fun o => o.lstate == .live && o.gvlen > 0 && intervalsOverlap va vlen o.gva o.gvlen) then none\n      else some (updateReg s rid (fun x => { x with gva := va, gvlen := vlen, mstate := .mapped }))\n"
text feL_om5 "  | .vmaPin rid =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.dom == .cpuKernelSlab || r.mstate == .pteCleared || r.mstate == .tlbFlushed then none\n      else some (updateReg s rid (fun x => { x with vmaPins := x.vmaPins + 1 }))\n  | .gpuSubmit rid ep =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.dom == .cpuKernelSlab || r.mstate != .mapped || ep <= r.epoch then none\n      else some (updateReg s rid (fun x => { x with epoch := ep }))\n  | .staticAccess rid off alen =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live then none\n      else if (r.dom == .gpuDeviceDma || r.dom == .gpuPtGmmu) && r.mstate != .mapped then none\n      else if alen == 0 || off + alen >= U64_LIMIT || off + alen > r.psize then none\n      else if r.mstate == .mapped && off + alen > r.gvlen then none\n      else some s\n"
text feL_om6 "  | .gpuUnmap rid =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.mstate != .mapped then none\n      else some (updateReg s rid (fun x => { x with mstate := .pteCleared }))\n  | .tlbInval rid =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.mstate != .pteCleared then none\n      else some (updateReg s rid (fun x => { x with mstate := .tlbFlushed }))\n  | .fenceDrain rid ep =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.mstate != .tlbFlushed || ep < r.epoch then none\n      else some (updateReg s rid (fun x => { x with drained := ep }))\n  | .vmaRevoke rid =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.vmaPins == 0 then none\n      else some (updateReg s rid (fun x => { x with vmaPins := x.vmaPins - 1 }))\n  | .reclaim rid =>\n    match findReg s rid with\n    | none => none\n    | some r =>\n      if r.lstate != .live || r.mstate == .mapped || r.mstate == .pteCleared then none\n      else if r.epoch > r.drained || r.vmaPins > 0 then none\n      else some (updateReg s rid (fun x => { x with lstate := .reclaimed, gva := 0, gvlen := 0 }))\n\n"
text feL_om7 "def runTrace (s : State) : List Action -> Option State\n  | [] => some s\n  | a :: rest => match step s a with | none => none | some s' => runTrace s' rest\n\ntheorem om3_kernel_slab_never_mapped (s : State) (rid va vlen : Nat) (r : Region)\n    (hf : findReg s rid = some r) (hdom : r.dom = .cpuKernelSlab) :\n    step s (.gpuMap rid va vlen) = none := by\n  unfold step\n  simp [hf, hdom]\n\n"
text feL_om8 "theorem om3_reclaim_requires_4step_fence (s s' : State) (rid : Nat)\n    (h : step s (.reclaim rid) = some s') :\n    Exists (fun r => And (findReg s rid = some r)\n      (And (r.lstate = .live)\n      (And (Not (r.mstate = .mapped))\n      (And (Not (r.mstate = .pteCleared))\n      (And (r.drained >= r.epoch) (r.vmaPins = 0)))))) := by\n  unfold step at h\n  cases hf : findReg s rid with\n  | none => simp [hf] at h\n  | some r =>\n    simp only [hf] at h\n    split at h\n    case isTrue => contradiction\n    case isFalse h1 =>\n      split at h\n      case isTrue => contradiction\n      case isFalse h2 =>\n        simp only [Bool.or_eq_true, bne_iff_ne, ne_eq, beq_iff_eq, decide_eq_true_eq,\n          not_or, Nat.not_lt] at h1 h2\n        exists r\n        refine And.intro rfl ?_\n        refine And.intro ?_ (And.intro h1.1.2 (And.intro h1.2 (And.intro h2.1 (by omega))))\n        cases hl : r.lstate\n        case live => rfl\n        case reclaimed => simp [hl] at h1\n\n"
text feL_om9 "def regSafeBool (r : Region) : Bool :=\n  decide (And (r.psize > 0) (And (r.pbase + r.psize < U64_LIMIT) (r.gvlen <= r.psize))) &&\n  (if r.dom == .cpuKernelSlab then\n    decide (And (r.mstate = .unmapped) (And (r.gvlen = 0) (And (r.epoch = 0) (r.vmaPins = 0))))\n   else true) &&\n  (if r.lstate == .reclaimed then\n    decide (And (Not (r.mstate = .mapped)) (And (Not (r.mstate = .pteCleared))\n      (And (r.drained >= r.epoch) (And (r.vmaPins = 0) (r.gvlen = 0)))))\n   else true)\n\n"
text feL_om10 "def pairSafeBool (r1 r2 : Region) : Bool :=\n  if r1.rid == r2.rid then true\n  else if r1.lstate == .live && r2.lstate == .live then\n    !intervalsOverlap r1.pbase r1.psize r2.pbase r2.psize &&\n    (if r1.gvlen > 0 && r2.gvlen > 0 then !intervalsOverlap r1.gva r1.gvlen r2.gva r2.gvlen else true)\n  else true\n\ndef stateSafeBool (s : State) : Bool :=\n  s.all regSafeBool &&\n  s.all (fun r1 => s.all (fun r2 => pairSafeBool r1 r2)) &&\n  s.all (fun r1 => s.all (fun r2 => !(r1.rid == r2.rid) || decide (r1 = r2)))\n\ndef noLiveGpuLeaks (s : State) : Bool :=\n  s.all (fun r =>\n    if r.lstate == .live && (r.dom == .gpuDeviceDma || r.dom == .gpuPtGmmu) then\n      decide (And (r.mstate = .unmapped) (And (r.vmaPins = 0) (r.drained >= r.epoch)))\n    else true)\n\n"

text feL_wc0 "def P_GPU_STRICT_MAX_MW : Int := 79999\ndef P_TOTAL_HARD_MAX_MW : Int := 140000\ndef T_CEIL_ABS_MAX_MC   : Int := 90000\ndef THERMAL_SCALE       : Int := 1000\ndef K_GPU_HEAT          : Int := 25\ndef K_CPU_HEAT          : Int := 5\ndef K_DS_COND           : Int := 100\n\n"
text feL_wc1 "structure ThermalState where\n  tDie  : Int\n  tSink : Int\n  tAmb  : Int\n  deriving DecidableEq, Repr\n\nstructure WattPolicy where\n  pBudget    : Int\n  pGpuBudget : Int\n  tCeil      : Int\n  tau        : Int\n  deriving DecidableEq, Repr\n\nstructure PowerProposal where\n  pGpu   : Int\n  pCpu   : Int\n  pUnc   : Int\n  fanPct : Int\n  deriving DecidableEq, Repr\n\n"
text feL_wc2 "def ceilDiv (a b : Int) : Int :=\n  if a >= 0 then (a + b - 1) / b else -((-a) / b)\n\ndef nextDieDelta (st : ThermalState) (pGpu pCpu pUnc : Int) : Int :=\n  ceilDiv (K_GPU_HEAT * pGpu + K_CPU_HEAT * (pCpu + pUnc) - K_DS_COND * (st.tDie - st.tSink)) THERMAL_SCALE\n\ndef barrierH (tCeil tDie tau dT : Int) : Int :=\n  tCeil - tDie - tau * dT\n\n"
text feL_wc3 "def wattAdmissibleStrict (st : ThermalState) (pol : WattPolicy) (prop : PowerProposal) (cPow : Int) : Bool :=\n  let dT := nextDieDelta st prop.pGpu prop.pCpu prop.pUnc\n  decide (\n    And (pol.pBudget > 0) (And (pol.pGpuBudget >= 0) (And (pol.pGpuBudget <= P_GPU_STRICT_MAX_MW)\n    (And (pol.tCeil > 0) (And (pol.tCeil <= T_CEIL_ABS_MAX_MC) (And (pol.tau >= 0)\n    (And (st.tDie < pol.tCeil) (And (st.tSink < pol.tCeil)\n    (And (prop.pGpu >= 0) (And (prop.pCpu >= 0) (And (prop.pUnc >= 0)\n    (And (prop.pGpu <= P_GPU_STRICT_MAX_MW) (And (prop.pGpu <= pol.pGpuBudget)\n    (And (prop.pGpu + prop.pCpu + prop.pUnc <= min pol.pBudget P_TOTAL_HARD_MAX_MW)\n    (And (Or (cPow = 0) (prop.pGpu <= cPow)) (And (cPow >= 0) (And (cPow <= P_GPU_STRICT_MAX_MW)\n    (And (prop.fanPct >= 20) (And (prop.fanPct <= 100)\n    (And (barrierH pol.tCeil st.tDie pol.tau dT >= 0)\n    (st.tDie + dT <= pol.tCeil)))))))))))))))))))))\n\n"
text feL_wc4 "theorem watt_strict_lt_80w (st : ThermalState) (pol : WattPolicy) (prop : PowerProposal) (cp : Int)\n    (h : wattAdmissibleStrict st pol prop cp = true) :\n    And (prop.pGpu < 80000) (And (prop.pGpu <= 79999) (prop.pGpu + prop.pCpu + prop.pUnc <= 140000)) := by\n  unfold wattAdmissibleStrict P_GPU_STRICT_MAX_MW P_TOTAL_HARD_MAX_MW at h\n  simp only [decide_eq_true_eq] at h\n  omega\n\n"

text feL_sm0 "inductive PipeClass where\n  | alu6 | hmma22 | omma29 | exitOp\n  deriving DecidableEq, Repr\n\ndef pipeFloor : PipeClass -> Nat\n  | .alu6   => 6\n  | .hmma22 => 22\n  | .omma29 => 29\n  | .exitOp => 1\n\n"
text feL_sm1 "structure Sm121Insn where\n  pc    : Nat\n  pipe  : PipeClass\n  rd    : Nat\n  rs1   : Nat\n  rs2   : Nat\n  hasRd : Bool\n  hasR1 : Bool\n  hasR2 : Bool\n  stall : Nat\n  deriving DecidableEq, Repr\n\n"
text feL_sm2 "def spanStall (insns : List Sm121Insn) (lo hi : Nat) : Nat :=\n  insns.foldl (fun acc ins => if lo <= ins.pc && ins.pc < hi then acc + ins.stall else acc) 0\n\ndef rawHazardPairOk (insns : List Sm121Insn) (u v : Sm121Insn) : Bool :=\n  if u.pc < v.pc && u.hasRd &&\n     ((v.hasR1 && v.rs1 == u.rd) || (v.hasR2 && v.rs2 == u.rd)) then\n    decide (spanStall insns u.pc v.pc >= pipeFloor u.pipe)\n  else true\n\n"
text feL_sm3 "def insnOk (reqRegs : Nat) (rawFloor : Nat) (ins : Sm121Insn) : Bool :=\n  (!ins.hasRd || decide (ins.rd < reqRegs)) &&\n  (!ins.hasR1 || decide (ins.rs1 < reqRegs)) &&\n  (!ins.hasR2 || decide (ins.rs2 < reqRegs)) &&\n  (if ins.pipe == .exitOp then true else decide (And (ins.stall >= rawFloor) (ins.stall >= 6)))\n\ndef sm121ContractOk (insns : List Sm121Insn) (reqRegs maxNgpr reqSmem maxSmem rawFloor : Nat) : Bool :=\n  decide (And (rawFloor >= 6) (And (reqRegs > 0) (And (reqRegs <= maxNgpr) (And (maxNgpr <= 64) (reqSmem <= maxSmem))))) &&\n  insns.all (insnOk reqRegs rawFloor) &&\n  insns.all (fun u => insns.all (fun v => rawHazardPairOk insns u v))\n\n"
text feL_sm4 "theorem sm121_raw_floor_sound (insns : List Sm121Insn) (reqRegs maxNgpr reqSmem maxSmem rawFloor : Nat)\n    (h : sm121ContractOk insns reqRegs maxNgpr reqSmem maxSmem rawFloor = true) :\n    And (rawFloor >= 6) (And (reqRegs <= maxNgpr) (reqSmem <= maxSmem)) := by\n  unfold sm121ContractOk at h\n  simp only [Bool.and_eq_true, decide_eq_true_eq] at h\n  exact And.intro h.1.1.1 (And.intro h.1.1.2.2.1 h.1.1.2.2.2.2)\n\n"

text feL_u_c1 "def unitContract : IrContract := {\n  purityFlag := "

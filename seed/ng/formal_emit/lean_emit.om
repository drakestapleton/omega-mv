text feL_u_o6 "\n  .gpuUnmap "
text feL_u_o7 "\n  .tlbInval "
text feL_u_o8 "\n  .fenceDrain "
text feL_u_o9 "\n  .vmaRevoke "
text feL_u_oa "\n  .reclaim "
text feL_u_oc "]\n"
text feL_sp " "

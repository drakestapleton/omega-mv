text feL_u_c3 ", hardDeadline := "
text feL_u_c4 ",\n  errBound := "
text feL_u_c5 ", deadlineUs := "
text feL_u_c6 ", powerMw := "
text feL_u_c7 ",\n  effectOps := "
text feL_u_c8 ", mutGlobals := "
text feL_u_c9 ", editParams := "
text feL_u_ca ",\n  trapExits := "
text feL_u_cb ", semanticIdLen := 64\n}\ndef unitSemanticId : String := \""
text feL_u_cc "\"\n"

text feL_u_o0 "def unitOm3Trace : List Action := ["
text feL_u_o1 "\n  .allocRegion "
text feL_u_o2 "\n  .gpuMap "
text feL_u_o3 "\n  .vmaPin "
text feL_u_o4 "\n  .gpuSubmit "

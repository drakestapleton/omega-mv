text feL_d2 ".cpuKernelSlab"
text feL_d3 ".gpuDeviceDma"
text feL_d4 ".gpuPtGmmu"
text feL_d5 ".mmioBar0"
text feL_d6 ".sharedUncached"

text feL_u_w1 "def unitThermal : ThermalState := { tDie := "
text feL_u_w2 ", tSink := "
text feL_u_w3 ", tAmb := "
text feL_u_w4 " }\ndef unitPolicy  : WattPolicy   := { pBudget := "
text feL_u_w5 ", pGpuBudget := "
text feL_u_w6 ", tCeil := "
text feL_u_w7 ", tau := "
text feL_u_w8 " }\ndef unitProp    : PowerProposal := { pGpu := "
text feL_u_w9 ", pCpu := "
text feL_u_wa ", pUnc := "
text feL_u_wb ", fanPct := "
text feL_u_wc " }\n"

text feL_u_s0 "def unitSm121Insns : List Sm121Insn := ["
text feL_u_s1 "\n  { pc := "
text feL_u_s2 ", pipe := "
text feL_u_s3 ", rd := "
text feL_u_s4 ", rs1 := "
text feL_u_s5 ", rs2 := "
text feL_u_s6 ", hasRd := "
text feL_u_s7 ", hasR1 := "
text feL_u_s8 ", hasR2 := "
text feL_u_s9 ", stall := "

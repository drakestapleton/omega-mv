note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngcheck.om: the ΩIR witness (seed/ng/IR.md s9, s11). Owner: ng-ir lane (Hive NG M0).
note It has its own reader: no code is shared with seed/ng/src/ir.om or opt.om (D1b). Build:
note   cat seed/ng/sha256.om seed/ng/ngcheck.om | seed/out/omc > ngcheck
note   ngcheck < unit.ir   exit 0 and "ACCEPT <sha256> fns=N blocks=N ops=N" on stdout, or exit with
note                       the refusal class (10..29) and "ngcheck: CLASS at OFFSET" on stderr
note   ngcheck --table     print the host word table compiled in (equal to seed/ng/hostwords.tsv)
note Order (IR.md s11): phase 1 reads the module front to back and checks every rule that needs only
note the bytes of one record (header, type table, globals, function and block headers, op rows and
note counts); phase 2 checks each function in order: terminators, branch targets, reachability,
note then each op in block and op order (ids and dominance, token, result type, placement, codes,
note typing, coverage, facts). The first fault ends the run.
text c_cls "MAGIC\nVERSION\nTRUNCATED\nNONCANONICAL\nTRAILING\nUNKNOWN_OP\nTYPE\nUSE_BEFORE_DEF\nDOMINANCE\nBLOCK_ARITY\nUNTERMINATED\nCHECK_CODE\nEFFECT\nLIMIT\nREF\nUNCHECKED\nUNREACHABLE\nIO\nTOKEN\nFACT\nENTRY\n"
text c_tx "ngcheck: \n at \nACCEPT \n fns=\n blocks=\n ops=\n--table\nngcheck: usage: ngcheck [--table] < unit.ir\nOSC1IR\nomega.ng.ir.v1\n"
note the op rows of IR.md s7.12: op tk imm fix var ty (tk 0 P 1 E 2 R 3 T; ty 0 none 1 r 2 o 3 p)
text c_rows "1 0 1 0 0 1 2 0 0 3 0 1 10 0 0 2 0 1 11 0 0 2 0 1 12 0 0 2 0 1 13 0 0 2 0 1 14 0 0 2 0 1 15 0 0 1 0 1 16 0 0 2 0 1 17 0 0 2 0 1 18 0 0 2 0 1 19 0 0 1 0 1 20 0 0 2 0 1 21 0 0 2 0 1 22 0 0 2 0 1 23 0 0 2 0 1 24 0 0 2 0 1 25 0 0 2 0 1 26 0 0 1 0 1 27 0 0 1 0 1 28 0 1 1 0 1 30 0 0 2 0 1 31 0 0 2 0 1 32 0 0 2 0 1 33 0 0 2 0 1 34 0 0 2 0 1 35 0 0 2 0 1 36 0 1 1 0 1 37 0 0 1 0 1 40 0 1 0 0 1 41 0 0 0 0 1 42 2 0 2 0 1 43 1 0 3 0 0 44 1 0 0 0 0 45 0 1 2 0 1 46 0 0 3 0 1 47 1 1 3 0 1 48 1 1 4 0 1 50 1 0 0 0 1 51 1 0 2 0 0 52 0 1 0 0 1 53 0 0 1 0 1 54 2 0 3 0 1 55 2 1 1 0 1 56 1 1 2 0 0 57 0 1 1 0 1 58 2 0 2 0 1 59 1 0 3 0 0 60 3 0 1 1 0 61 3 0 3 0 0 62 3 0 0 0 0 63 3 0 1 0 0 64 1 0 1 1 2 65 3 1 0 0 0 66 3 0 1 0 0 67 1 0 4 1 0 70 1 1 2 0 0 71 1 1 2 0 0 72 1 1 2 0 0 73 1 1 1 0 0 74 1 1 1 0 0 75 1 1 2 0 0 76 1 1 2 0 0 77 1 1 1 0 0 78 1 1 1 0 3 79 1 1 3 0 0 80 1 1 3 0 0 81 1 1 2 0 0 82 1 1 1 0 0 90 0 1 1 0 0 91 0 1 3 0 0 92 0 1 3 0 0 93 0 1 3 0 0 100 0 0 1 0 1 101 0 1 1 0 1 102 0 1 2 0 1 103 0 1 1 0 1 104 2 1 4 0 1 105 1 1 5 0 0 106 0 1 3 0 1 110 1 1 0 1 2"
note seed/ng/hostwords.tsv, byte for byte (the gate compares ngcheck --table with the file)
text c_hwt "id\tword\targs\tclass\n53\tread\tiw\tio\n54\twrite\tir\tio\n100\tfclose\ti\tfs\n101\tfsync\ti\tfs\n102\tfchmod\tii\tfs\n103\tfseek\tili\tfs\n104\tsocknew\tiii\tnet\n105\tlisten\tii\tnet\n106\taccept\tii\tnet\n107\tfork\t-\tproc\n108\tdupfd\tiii\tproc\n109\tmonons\t-\ttime\n110\tfopen\trii\tfs\n111\tunlink\tr\tfs\n112\tmakedir\tri\tfs\n113\tgetdnts\tiw\tfs\n114\tconnect\tir\tnet\n115\tbind\tir\tnet\n116\twaitpid\tiwi\tproc\n117\tfstat\tiw\tfs\n118\trecv\tiwi\tio\n119\tsend\tiri\tio\n120\tsleepns\tl\ttime\n121\targcnt\t-\tenv\n122\targread\tLw\tenv\n123\twaitio\tiil\tio\n124\texecprog\tr\tproc\n125\trenames\tri\tfs\n126\trmdir\tr\tfs\n127\tkillpid\tii\tproc\n128\tpipefds\twi\tproc\n129\tgetpid\t-\tproc\n130\trealns\t-\ttime\n131\tsockname\tiw\tnet\n132\tcwd\tw\tfs\n133\treadlnk\trw\tfs\n134\tsockopt\tiiir\tnet\n135\trandom\twi\tenv\n136\tenvcnt\t-\tenv\n137\tenvread\tLw\tenv\n138\tchdir\tr\tfs\n139\tftrunc\til\tfs\n140\tstat\trw\tfs\n141\tlink\tr\tfs\n142\tsymlnk\tr\tfs\n143\tchmod\tri\tfs\n144\tfaccess\tri\tfs\n145\tgetuid\t-\tproc\n146\tgeteuid\t-\tproc\n147\tgetgid\t-\tproc\n148\tgetegid\t-\tproc\n149\tlstat\trw\tfs\n150\ttruncate\trl\tfs\n151\tchown\trii\tfs\n153\tfchdir\ti\tfs\n154\tgetppid\t-\tproc\n155\tumask\ti\tfs\n156\tfdsync\ti\tfs\n157\tmemfd\tri\tfs\n158\tsetsid\t-\tproc\n159\tgetpgid\ti\tproc\n160\tsetpgid\tii\tproc\n161\tpread\tiwl\tio\n162\tpwrite\tirl\tio\n163\tgetsid\ti\tproc\n164\tsyncfs\ti\tfs\n165\tshutdown\tii\tnet\n166\tdevctl\tiuw\tdev\n167\tmapnew\tiLLii\tdev\n168\tmapdrop\tl\tdev\n169\tmapread\tlLw\tdev\n170\tmapwrite\tlLr\tdev\n171\tdevcall\tiuww\tdev\n172\tuvmctl\tiuw\tdev\n173\tmapaddr\tl\tdev\n174\tmapget\tlLi\tdev\n175\tmapset\tlLiL\tdev\n176\tmaphold\tLL\tdev\n177\tmapbind\tliLi\tdev\n197\tflock\tii\tfs\n198\texecpure\tr\tproc\n199\tcpufence\t-\tcpu\n200\tcpurelax\t-\tcpu\n220\tpeercred\tiw\tnet\n221\tpollfds\twl\tio\n222\tsendmsg\tiri\tnet\n224\tpeername\tiw\tnet\n228\tvfioctl\tiuS\tdev\n229\tvfiomap\tir\tdev\n230\tvfiomapw\tir\tdev\n231\teventfd\tu\tdev\n232\tvfioirq\tiuw\tdev\n"
global c_s ulong 4
global c_n ulong 16
global c_f ulong 16
global c_q ulong 16
global c_ob uchar 32
global c_ab uchar 256
global c_rok uchar 256
global c_rtk uchar 256
global c_rim uchar 256
global c_rfx uchar 256
global c_rva uchar 256
global c_rty uchar 256
global c_hok uchar 256
global c_hcp uchar 256
global c_has uint 256
global c_hal uint 256
global c_tk uchar 65568
global c_t1 uint 65568
global c_t2 uint 65568
global c_t3 uint 65568
global c_t4 uint 65568
global c_t5 uint 65568
global c_tsz ulong 65568
global c_xty uint 65536
global c_xof uint 65536
global c_xor uchar 65536
global c_th uint 131072
global c_gty uint 65536
global c_gcl uchar 65536
global c_fk uchar 65536
global c_ffl uchar 65536
global c_fnp uint 65536
global c_fp0 uint 65536
global c_frs uint 65536
global c_fsg uchar 65536
global c_fb0 uint 65536
global c_fnb uint 65536
global c_fof uint 65536
global c_fpt uint 4194304
global c_bnp uint 1048576
global c_bp0 uint 1048576
global c_bo0 uint 1048576
global c_bno uint 1048576
global c_bof uint 1048576
global c_bpt uint 4194304
global c_oop uchar 4194304
global c_oty uint 4194304
global c_oim ulong 4194304
global c_ona uint 4194304
global c_oa0 uint 4194304
global c_oof uint 4194304
global c_ov uint 4194304
global c_opb uint 4194304
global c_opp uint 4194304
global c_cvn uint 4194304
global c_arg uint 4194304
global c_vty uint 2097152
global c_vb uint 2097152
global c_vp uint 2097152
global c_vo uint 2097152
global c_cvh uint 2097152
global c_s1 uint 65536
global c_s2 uint 65536
global c_bv0 uint 65536
global c_vis uchar 65536
global c_stk uint 65536
global c_sti uchar 65536
global c_rpo uint 65536
global c_ord uint 65536
global c_pc uint 65537
global c_pst uint 65537
global c_pfl uint 65537
global c_pl uint 131072
global c_idm uint 65536
global c_dch uint 65536
global c_dsb uint 65536
global c_dnx uint 65536
global c_pre uint 65536
global c_pos uint 65536
note ---- output ----------------------------------------------------------------------------------
fn ck_txt k ulong fd int to void
s = ulong 0
c = ulong 1
for i ulong len c_tx
if eq get c_tx i 10
if eq c k
r = write fd c_tx s sub i s
ret
end
c = add c 1
s = add i 1
end
end
end
fn ck_cname k ulong to void
s = ulong 0
c = ulong 1
for i ulong len c_cls
if eq get c_cls i 10
if eq c k
r = write 2 c_cls s sub i s
ret
end
c = add c 1
s = add i 1
end
end
end
fn ck_num v ulong fd int to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put c_ob i uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write fd c_ob i sub 32 i
ret
end
end
end
fn ck_nl fd int to void
put c_ob 0 10
r = write fd c_ob 0 1
end
fn ck_bad c ulong off ulong to void
ck_txt 1 2
ck_cname sub c 9
ck_txt 2 2
ck_num off 2
ck_nl 2
exit int c
end
note refuse with class c at the offset of the op being checked (c_q 12)
fn ck_fail c ulong to void
ck_bad c ulong get c_oof get c_q 12
end
fn ck_want b bool c ulong to void
if not b
ck_fail c
end
end
note ---- reading primitives (cursor c_s 0, end c_s 1) ---------------------------------------------
fn ck_at to ulong
ret get c_s 0
end
fn ck_need k ulong to ulong
p = get c_s 0
if gt add p k get c_s 1
ck_bad 12 p
end
put c_s 0 add p k
ret p
end
fn ck_u8 to ulong
p = ck_need 1
ret ulong get sh_dat p
end
fn ck_u16 to ulong
p = ck_need 2
v = ulong get sh_dat p
ret or v shl ulong get sh_dat add p 1 8
end
fn ck_un k ulong to ulong
p = ck_need k
v = ulong 0
for j ulong k bound 8
x = ulong get sh_dat add p j
v = or v shl x mul j 8
end
ret v
end
fn ck_u32 to ulong
ret ck_un 4
end
fn ck_u64 to ulong
ret ck_un 8
end
note ---- init: op rows and host words ----------------------------------------------------------
fn ck_rows to void
p = ulong 0
for r ulong 256
if ge p len c_rows
ret
end
op = ck_dec p
p = get c_q 15
put c_rok op 1
put c_rtk op uchar ck_dec p
p = get c_q 15
put c_rim op uchar ck_dec p
p = get c_q 15
put c_rfx op uchar ck_dec p
p = get c_q 15
put c_rva op uchar ck_dec p
p = get c_q 15
put c_rty op uchar ck_dec p
p = get c_q 15
end
end
note decimal number in c_rows at p (skipping separators); the next position goes to c_q 15
fn ck_dec p ulong to ulong
i = p
while lt get c_rows i 48 bound 8
i = add i 1
end
v = ulong 0
while lt i len c_rows bound 12
c = get c_rows i
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
put c_q 15 i
ret v
end
note host words: skip the header line, then "id\tword\targs\tclass\n" rows
fn ck_hosts to void
p = ck_hnext 0
while lt p len c_hwt bound 256
p = ck_hrow p
end
end
fn ck_hnext p ulong to ulong
i = p
while lt i len c_hwt bound 4096
if eq get c_hwt i 10
ret add i 1
end
i = add i 1
end
ret i
end
fn ck_hfld p ulong to ulong
i = p
while lt i len c_hwt bound 4096
if eq get c_hwt i 9
ret i
end
i = add i 1
end
ret i
end
fn ck_hrow p ulong to ulong
v = ulong 0
i = p
while ne get c_hwt i 9 bound 4
v = add mul v 10 ulong sub get c_hwt i 48
i = add i 1
end
i = ck_hfld add i 1
a = add i 1
e = ck_hfld a
put c_hok v 1
put c_has v uint a
if ne get c_hwt a 45
put c_hal v uint sub e a
end
if and eq get c_hwt add e 1 99 eq get c_hwt add e 2 112
put c_hcp v 1
end
ret ck_hnext e
end
note ---- header ------------------------------------------------------------------------------------
fn ck_head to void
n = get c_s 1
for j ulong 7
if ge j n
ck_bad 12 0
end
if lt j 6
if ne get sh_dat j get c_tx add 96 j
ck_bad 10 0
end
else
if ne get sh_dat j 0
ck_bad 10 0
end
end
end
put c_s 0 7
if ne ck_u8 9
ck_bad 11 7
end
p = ck_need 16
for j ulong 16
c = get sh_dat add 8 j
if lt j 14
if ne c get c_tx add 103 j
ck_bad 11 8
end
else
if ne c 0
ck_bad 11 8
end
end
end
end
note ---- type predicates (ids are validated before these are used) -----------------------------
fn ck_sb t ulong to ulong
if or eq t 1 eq t 2
ret 1
end
if or eq t 6 or eq t 18 eq t 19
ret 1
end
if or eq t 3 or eq t 7 or eq t 16 eq t 17
ret 2
end
if or eq t 4 or eq t 8 eq t 13
ret 4
end
if or eq t 5 or eq t 9 eq t 14
ret 8
end
ret 0
end
fn ck_kd t ulong to ulong
if lt t 32
ret 0
end
if ge t add 32 get c_n 0
ret 255
end
ret ulong get c_tk t
end
fn ck_g1 t ulong to ulong
if lt t 32
ret 0
end
ret ulong get c_t1 t
end
fn ck_g2 t ulong to ulong
if lt t 32
ret 0
end
ret ulong get c_t2 t
end
fn ck_g3 t ulong to ulong
if lt t 32
ret 0
end
ret ulong get c_t3 t
end
fn ck_g4 t ulong to ulong
if lt t 32
ret 0
end
ret ulong get c_t4 t
end
fn ck_g5 t ulong to ulong
if lt t 32
ret 0
end
ret ulong get c_t5 t
end
fn ck_isint t ulong to bool
ret and ge t 2 le t 9
end
fn ck_issgn t ulong to bool
ret and ge t 6 le t 9
end
fn ck_isuns t ulong to bool
ret and ge t 2 le t 5
end
fn ck_isflt t ulong to bool
ret or or eq t 13 eq t 14 or eq t 16 eq t 17
end
fn ck_isar t ulong to bool
ret or ck_isint t ck_isflt t
end
fn ck_isnum t ulong to bool
ret or ck_isar t or eq t 18 eq t 19
end
note the lane element of a scalar or VEC type
fn ck_el t ulong to ulong
if eq ck_kd t 1
ret ck_g1 t
end
ret t
end
fn ck_lanes t ulong to ulong
if eq ck_kd t 1
ret ck_g2 t
end
ret 1
end
note byte size of a memory element type (scalar, VEC, ARRAY, STRUCT)
fn ck_size t ulong to ulong
if lt t 32
ret ck_sb t
end
ret get c_tsz t
end
note the element type of a REF to an ARRAY or of a SLICE, else 0
fn ck_relt r ulong to ulong
k = ck_kd r
if eq k 5
ret ck_g1 r
end
if eq k 4
a = ck_g1 r
if eq ck_kd a 2
ret ck_g1 a
end
end
ret 0
end
note a type id usable as a value type: scalar, VEC, REF, SLICE, FRAG (never tok, void, ARRAY, STRUCT)
note returns 0 when it is, else the class (24 an absent table id, 16 otherwise)
fn ck_vtc t ulong to ulong
if lt t 32
if eq ck_sb t 0
ret 16
end
ret 0
end
k = ck_kd t
if eq k 255
ret 24
end
if or eq k 2 eq k 3
ret 16
end
ret 0
end
note ---- type table (phase 1); every fault is reported at the entry's offset ---------------------
fn ck_types to void
o = ck_at
n = ck_u32
if gt n 65536
ck_bad 23 o
end
for k ulong n bound 65536
ck_type add k 32
end
end
fn ck_type t ulong to void
o = ck_at
kd = ck_u8
put c_tk t uchar kd
if or eq kd 0 gt kd 6
ck_bad 13 o
end
if eq kd 1
ck_tvec t o
end
if eq kd 2
ck_tarr t o
end
if eq kd 3
ck_tstr t o
end
if or eq kd 4 eq kd 5
ck_tref t o kd
end
if eq kd 6
ck_tfrg t o
end
put c_n 0 sub t 31
ck_tdup t o
end
note a type id referenced from entry t: a scalar id or an earlier entry
fn ck_tid x ulong t ulong o ulong to void
if ge x 32
if ge x t
ck_bad 24 o
end
ret
end
if eq ck_sb x 0
ck_bad 16 o
end
end
fn ck_tvec t ulong o ulong to void
e = ck_u32
l = ck_u32
ck_tid e t o
if not or eq e 1 or ck_isint e ck_isflt e
ck_bad 16 o
end
if or or lt l 2 gt l 64 ne and l sub l 1 0
ck_bad 16 o
end
if gt mul l ck_sb e 64
ck_bad 16 o
end
put c_t1 t uint e
put c_t2 t uint l
put c_tsz t mul l ck_sb e
end
fn ck_tarr t ulong o ulong to void
e = ck_u32
c = ck_u32
ck_tid e t o
k = ck_kd e
if not or ck_isnum e or eq k 1 eq k 3
ck_bad 16 o
end
if or eq c 0 gt c 16777216
ck_bad 16 o
end
put c_t1 t uint e
put c_t2 t uint c
put c_tsz t mul c ck_size e
end
fn ck_tstr t ulong o ulong to void
sz = ck_u32
no = ck_at
nf = ck_u32
if or eq sz 0 gt sz 1073741824
ck_bad 16 o
end
if eq nf 0
ck_bad 16 o
end
if gt nf 64
ck_bad 23 no
end
f0 = get c_n 1
if gt add f0 nf 65536
ck_bad 23 no
end
put c_t1 t uint sz
put c_t2 t uint nf
put c_t3 t uint f0
put c_tsz t sz
put c_q 14 0
for j ulong nf bound 64
ck_tfld t o add f0 j
end
put c_n 1 add f0 nf
if gt get c_q 14 sz
ck_bad 16 o
end
end
note field x of struct t; c_q 14 is the end of the previous field
fn ck_tfld t ulong o ulong x ulong to void
ft = ck_u32
of = ck_u32
od = ck_u8
ck_tid ft t o
k = ck_kd ft
if not or ck_isnum ft or eq k 2 eq k 3
ck_bad 16 o
end
if gt od 1
ck_bad 13 o
end
if and eq od 1 ge ft 32
ck_bad 13 o
end
if lt of get c_q 14
ck_bad 16 o
end
put c_q 14 add of ck_size ft
put c_xty x uint ft
put c_xof x uint of
put c_xor x uchar od
end
fn ck_tref t ulong o ulong kd ulong to void
x = ck_u32
ac = ck_u8
sp = ck_u8
ck_tid x t o
k = ck_kd x
if eq kd 4
if not or eq k 2 eq k 3
ck_bad 16 o
end
else
if not or ck_isnum x or eq k 1 eq k 3
ck_bad 16 o
end
end
if or gt ac 1 gt sp 4
ck_bad 13 o
end
if and eq sp 3 eq ac 1
ck_bad 16 o
end
put c_t1 t uint x
put c_t2 t uint ac
put c_t3 t uint sp
end
fn ck_tfrg t ulong o ulong to void
ro = ck_u8
m = ck_u16
n = ck_u16
k = ck_u16
e = ck_u32
if gt ro 2
ck_bad 13 o
end
if or or eq m 0 gt m 256 or eq n 0 gt n 256
ck_bad 16 o
end
if or eq k 0 gt k 256
ck_bad 16 o
end
ck_tid e t o
if not ck_isnum e
ck_bad 16 o
end
put c_t1 t uint ro
put c_t2 t uint m
put c_t3 t uint n
put c_t4 t uint k
put c_t5 t uint e
end
note duplicate entries (NONCANONICAL): open hash over the entry's contents
fn ck_thash t ulong to ulong
h = ulong get c_tk t
h = add mul h 1000003 ulong get c_t1 t
h = add mul h 1000003 ulong get c_t2 t
if eq get c_tk t 3
f0 = ulong get c_t3 t
for j ulong ulong get c_t2 t bound 64
x = add f0 j
h = add mul h 1000003 ulong get c_xty x
h = add mul h 1000003 ulong get c_xof x
h = add mul h 1000003 ulong get c_xor x
end
ret h
end
h = add mul h 1000003 ulong get c_t3 t
h = add mul h 1000003 ulong get c_t4 t
ret add mul h 1000003 ulong get c_t5 t
end
fn ck_teq a ulong b ulong to bool
if ne get c_tk a get c_tk b
ret false
end
if ne get c_t1 a get c_t1 b
ret false
end
if ne get c_t2 a get c_t2 b
ret false
end
if eq get c_tk a 3
ret ck_feq ulong get c_t3 a ulong get c_t3 b ulong get c_t2 a
end
if ne get c_t3 a get c_t3 b
ret false
end
if ne get c_t4 a get c_t4 b
ret false
end
ret eq get c_t5 a get c_t5 b
end
fn ck_feq a ulong b ulong n ulong to bool
for j ulong n bound 64
x = add a j
y = add b j
if ne get c_xty x get c_xty y
ret false
end
if ne get c_xof x get c_xof y
ret false
end
if ne get c_xor x get c_xor y
ret false
end
end
ret true
end
fn ck_tdup t ulong o ulong to void
s = and ck_thash t 131071
for i ulong 131072
u = ulong get c_th s
if eq u 0
put c_th s uint t
ret
end
if ck_teq u t
ck_bad 13 o
end
s = and add s 1 131071
end
end
note ---- globals (phase 1) ---------------------------------------------------------------------
fn ck_globs to void
o = ck_at
n = ck_u32
if gt n 65536
ck_bad 23 o
end
put c_n 2 n
for g ulong n bound 65536
ck_glob g
end
end
fn ck_glob g ulong to void
o = ck_at
t = ck_u32
c = ck_u8
k = ck_kd t
if eq k 255
ck_bad 24 o
end
if ne k 2
ck_bad 16 o
end
if gt c 1
ck_bad 13 o
end
put c_gty g uint t

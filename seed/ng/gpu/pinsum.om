note SPDX-License-Identifier: Apache-2.0
note seed/ng/gpu/pinsum.om: SHA-256 of standard input, printed as 64 lowercase hex digits and a newline.
note It is the filter of gate.cases' lock-* cases, which enforce seed/ng/cudapp.lock: STDIN is the raw
note file, STDOUT the line the lock pins. Program mode, no om2 line, prefix ps_.
note Compiled after the plain-function form of om/sha256/sha256-om2.om (FIPS 180-4, the bridge's
note sha256 unit), exactly as seed/semhash builds: gate.cases joins five pack: segments of that file
note that skip the four "export " prefixes (bytes 7196, 8356, 8545 and 9149, 7 bytes each), then this file.
note Exit 0 with the digest; a read error writes one stderr line and exits 93; an output error exits 93.
text ps_erd "pinsum: read failed\n"

fn ps_hx x ulong to uchar
if lt x 10
ret uchar add x 48
end
ret uchar add x 87
end

fn main to int
c = new uchar 104 0
sha256_init c
k = new uchar 65536 0
for a ulong 1000000000
r = read 0 k 0 65536
if lt r 0
w = write 2 ps_erd 0 len ps_erd
exit 93
end
if eq r 0
break
end
sha256_update c part k 0 ulong r
end
h = new uchar 32 0
sha256_final c h
o = new uchar 65 0
for i ulong 32
v = ulong get h i
put o mul i 2 ps_hx shr v 4
put o add mul i 2 1 ps_hx and v 15
end
put o 64 uchar 10
q = write 1 o 0 65
if ne q 65
exit 93
end
ret 0
end

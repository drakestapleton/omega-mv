# seed/ng/gpu/gate.cases: conformance of the sm_121 encoder ng consumes (Hive NG lane ng-gpu, D10).
# Driver: seed/qualification/om2/gate.om, run from the repository root with CUDApp checked out at the sha of
# seed/ng/cudapp.lock as the sibling directory ../CUDApp:
#   gate seed/out/omc <omc sha256> seed/ng/gpu/gate.cases <new scratch dir>
# Inputs: NGBWENC1 frames (seed/ng/gpu/encrun.om header) captured from CUDApp's own C builders through a link-time
# wrap of omega_bw_enc_sm121 (referee instrument, seed/ng/gpu/README.md). Expected outputs: CUDApp's .om encoder
# and its C oracle agree on golden and dump; slice and ldg are the C oracle's bytes (the .om at the lock sha matches
# them; CUDApp b774723f, before #373, does not on ldg: LDG.E offset defect).
deadline 120
# lock enforcement: each file ng composes from ../CUDApp must hash to its seed/ng/cudapp.lock row. Filter:
# seed/ng/gpu/pinsum.om after the plain-function form of om/sha256/sha256-om2.om (five pack: segments skipping the
# four "export " prefixes); STDIN the raw file, STDOUT the pinned digest. Different bytes FAIL (exit 1, naming the
# row); a missing file is INVALID (unreadable input). lock-self pins the lock file, so a lock edit not carried into
# these rows fails too. Stock gate.om has no input-identity case kind, so a wrong file is FAIL, not INVALID.
lock-self run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:seed/ng/cudapp.lock line:7fd4717ebc16750348d366ece9ec0d906d38686d6387ab9bdd05512e2b19d7f3 - 0
lock-bw_enc_sm121 run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:../CUDApp/om/encoder/bw_enc_sm121.om line:0cebf2f2f856d438ec7c533bbdab6d1f2541cfe3f043780ec9797c11ed08d5c4 - 0
lock-bw_alloc run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:../CUDApp/om/components/bw_alloc.om line:a4b04901620f4cbd674c236fc0f91092181ccf4f1bb0f6d6e400c3836e7442fc - 0
lock-cubin_elf run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:../CUDApp/om/cubin/cubin_elf.om line:2f7da01ac19e77702be871cd01dacde193b9e5419ad1e4a3d333e64f32af2200 - 0
lock-launch run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:../CUDApp/native/blackwell/launch.om line:d04e1a304a6f985a1bc51011660a22f694a6d95924cdb73df014f7e50d26814f - 0
lock-context run pack:om/sha256/sha256-om2.om:0:7196+pack:om/sha256/sha256-om2.om:7203:1153+pack:om/sha256/sha256-om2.om:8363:182+pack:om/sha256/sha256-om2.om:8552:597+pack:om/sha256/sha256-om2.om:9156:427+seed/ng/gpu/pinsum.om file:../CUDApp/native/nvrm/context.om line:bd5be905568552d48dd477cbeff1e287940e6f6bfd9e31a4e68d53d6c60ae3bb - 0
# pin: the encoder source compiles (function mode) to exactly these bytes; any semantic change to the pinned unit
# changes them and fails here before any fixture runs
enc-pin emit ../CUDApp/om/encoder/bw_enc_sm121.om sha:4d652093763e14badeecf86e418af345b6a223c1261025842540a443ce81770e - 0
enc-golden run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/golden.in file:seed/ng/gpu/tests/golden.out - 0
enc-dump run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
enc-slice run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/slice.in file:seed/ng/gpu/tests/slice.out - 0
enc-ldg run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/ldg.in file:seed/ng/gpu/tests/ldg.out - 0
enc-empty run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om - - - 0
enc-badmagic run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/badmagic.in - file:seed/ng/gpu/tests/badmagic.err 2
enc-trunc run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/trunc.in - file:seed/ng/gpu/tests/trunc.err 3
# mutants of the pinned encoder (CUDApp mk/om-encoder.mk OM_ENC_MUTANTS 1..3 and OM_ENC_LDG_RED edit 1): each must change the output
subst seed/ng/gpu/tests/m1.from seed/ng/gpu/tests/m1.to
enc-mut1 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/golden.in file:seed/ng/gpu/tests/golden.out - 0
subst seed/ng/gpu/tests/m2.from seed/ng/gpu/tests/m2.to
enc-mut2 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
subst seed/ng/gpu/tests/m3.from seed/ng/gpu/tests/m3.to
enc-mut3 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
subst seed/ng/gpu/tests/m4.from seed/ng/gpu/tests/m4.to
enc-mut4 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/ldg.in file:seed/ng/gpu/tests/ldg.out - 0

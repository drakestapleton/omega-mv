# seed/ng/gpu/gate.cases: conformance of the sm_121 encoder ng consumes (Hive NG lane ng-gpu, D10).
# Driver: seed/qualification/om2/gate.om, run from the repository root with CUDApp checked out at the sha of
# seed/ng/cudapp.lock as the sibling directory ../CUDApp:
#   gate seed/out/omc <omc sha256> seed/ng/gpu/gate.cases <new scratch dir>
# Inputs: NGBWENC1 frames (seed/ng/gpu/encrun.om header) captured from CUDApp's own C builders through a link-time
# wrap of omega_bw_enc_sm121 (referee instrument, seed/ng/gpu/README.md). Expected outputs: CUDApp's .om encoder
# and its C oracle agree on golden and dump; slice and ldg are the C oracle's bytes (the .om at the lock sha matches
# them; CUDApp b774723f, before #373, does not on ldg: LDG.E offset defect).
deadline 120
# pin: the encoder source compiles (function mode) to exactly these bytes; any semantic change to the pinned unit
# changes them and fails here before any fixture runs
enc-pin emit ../CUDApp/om/encoder/bw_enc_sm121.om sha:4d652093763e14badeecf86e418af345b6a223c1261025842540a443ce81770e - 0
enc-golden run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/golden.in file:seed/ng/gpu/tests/golden.out - 0
enc-dump run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
enc-slice run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/slice.in file:seed/ng/gpu/tests/slice.out - 0
enc-ldg run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/ldg.in file:seed/ng/gpu/tests/ldg.out - 0
enc-empty run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om - - - 0
enc-badmagic run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/badmagic.in - file:seed/ng/gpu/tests/badmagic.err 2
enc-trunc run ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/trunc.in - file:seed/ng/gpu/tests/trunc.err 3
# mutants of the pinned encoder (CUDApp mk/om-encoder.mk OM_ENC_MUTANTS 1..4): each must change the output
subst seed/ng/gpu/tests/m1.from seed/ng/gpu/tests/m1.to
enc-mut1 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/golden.in file:seed/ng/gpu/tests/golden.out - 0
subst seed/ng/gpu/tests/m2.from seed/ng/gpu/tests/m2.to
enc-mut2 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
subst seed/ng/gpu/tests/m3.from seed/ng/gpu/tests/m3.to
enc-mut3 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/dump.in file:seed/ng/gpu/tests/dump.out - 0
subst seed/ng/gpu/tests/m4.from seed/ng/gpu/tests/m4.to
enc-mut4 kill ../CUDApp/om/encoder/bw_enc_sm121.om+seed/ng/gpu/encrun.om file:seed/ng/gpu/tests/ldg.in file:seed/ng/gpu/tests/ldg.out - 0

note SPDX-License-Identifier: Apache-2.0
note seed/ng/verify/gate_egp3.om: Standalone EGP3 Dual-Checker CLI & Self-Test Gate.
note Program-mode unit paired with seed/ng/verify/egp3_checker.om (no om2 line, pure OM-1/OM-2).
note
note Build:
note   cat seed/ng/verify/egp3_checker.om seed/ng/verify/gate_egp3.om | seed/out/omc > gate_egp3
note
note Usage:
note   gate_egp3               runs built-in self-test suite (8 valid 32/64-bit certs covering
note                           all 18 rules + 5 adversarial negative controls + framing checks)
note   gate_egp3 FILE.egp3     verifies an external EGP3 certificate bundle (exit 0 on PASS)

global ge3_path uchar 4096
global ge3_tmp uchar 65536
global ge3_op ulong 128
global ge3_a ulong 128
global ge3_b ulong 128
global ge3_c ulong 128
global ge3_vlo ulong 128
global ge3_vhi ulong 128
global ge3_wid ulong 128
global ge3_flg ulong 128
global ge3_tr_r ulong 128
global ge3_tr_u ulong 128
global ge3_tr_v ulong 128
global ge3_st ulong 8
global ge3_id ulong 32

text ge3_t_pass1 "NG-EGP3-CHECKER PASS certs="
text ge3_t_pass2 " rules=18 neg_controls=5/5\n"
text ge3_t_cli1 "NG-EGP3-CHECKER PASS certs="
text ge3_t_cli2 " steps="
text ge3_t_cli3 " evals="
text ge3_t_nl "\n"
text ge3_t_fail "NG-EGP3-CHECKER FAIL code="
text ge3_t_negfail "NG-EGP3-CHECKER FAIL neg_control="
text ge3_t_io "NG-EGP3-CHECKER FAIL io\n"

fn ge3_w1num v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 1 b p sub 24 p
end

fn ge3_w2num v ulong to void
b = new uchar 24 0
p = ulong 24
x = v
while true bound 24
p = sub p 1
put b p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
r = write 2 b p sub 24 p
end

fn ge3_put32 off ulong v ulong to void
put vc3_buf off uchar and v 255
put vc3_buf add off 1 uchar and shr v 8 255
put vc3_buf add off 2 uchar and shr v 16 255
put vc3_buf add off 3 uchar and shr v 24 255
end

fn ge3_begin_bundle cc ulong to ulong
put vc3_buf 0 69
put vc3_buf 1 71
put vc3_buf 2 80
put vc3_buf 3 51
ge3_put32 4 cc
ret 8
end

fn ge3_reset_cert wid ulong to void
put ge3_st 0 0
put ge3_st 1 0
put ge3_st 2 wid
end

fn ge3_add_node op ulong a ulong b ulong c ulong vlo ulong vhi ulong to ulong
id = get ge3_st 0
put ge3_st 0 add id 1
put ge3_op id op
put ge3_a id a
put ge3_b id b
put ge3_c id c
put ge3_vlo id vlo
put ge3_vhi id vhi
put ge3_wid id get ge3_st 2
put ge3_flg id 0
ret id
end

fn ge3_c32 v ulong to ulong
ret ge3_add_node 1 0 0 0 and v 4294967295 0
end

fn ge3_c64 vlo ulong vhi ulong to ulong
ret ge3_add_node 1 0 0 0 vlo vhi
end

fn ge3_ssa sid ulong to ulong
ret ge3_add_node 2 0 0 0 sid 0
end

fn ge3_bin op ulong a ulong b ulong to ulong
ret ge3_add_node op a b 0 0 0
end

fn ge3_fma a ulong b ulong c ulong to ulong
ret ge3_add_node 6 a b c 0 0
end

fn ge3_step ru ulong lu ulong rv ulong to void
t = get ge3_st 1
put ge3_st 1 add t 1
put ge3_tr_r t ru
put ge3_tr_u t lu
put ge3_tr_v t rv
end

fn ge3_emit_cert pos ulong fn_i ulong blk_i ulong rb ulong ra ulong to ulong
nc = get ge3_st 0
nt = get ge3_st 1
wid = get ge3_st 2
ge3_put32 pos fn_i
ge3_put32 add pos 4 blk_i
ge3_put32 add pos 8 wid
ge3_put32 add pos 12 nc
ge3_put32 add pos 16 rb
ge3_put32 add pos 20 ra
ge3_put32 add pos 24 nt
p = add pos 28
for i ulong nc bound 128
ge3_put32 p get ge3_op i
ge3_put32 add p 4 get ge3_a i
ge3_put32 add p 8 get ge3_b i
ge3_put32 add p 12 get ge3_c i
ge3_put32 add p 16 get ge3_vlo i
ge3_put32 add p 20 get ge3_vhi i
ge3_put32 add p 24 get ge3_wid i
ge3_put32 add p 28 get ge3_flg i
p = add p 32
end
for s ulong nt bound 128
ge3_put32 p get ge3_tr_r s
ge3_put32 add p 4 get ge3_tr_u s
ge3_put32 add p 8 get ge3_tr_v s
p = add p 12
end
ret p
end

note Valid Cert 0 (w=32): Rules 1 (fma_fuse), 3 (add_zero), 4 (zero_add), 5 (mul_one)
fn ge3_cert0 pos ulong to ulong
ge3_reset_cert 32
put ge3_id 0 ge3_ssa 0
put ge3_id 1 ge3_ssa 1
put ge3_id 2 ge3_ssa 2
put ge3_id 3 ge3_c32 0
put ge3_id 4 ge3_c32 1
put ge3_id 5 ge3_bin 5 get ge3_id 0 get ge3_id 4
put ge3_id 6 ge3_bin 5 get ge3_id 5 get ge3_id 1
put ge3_id 7 ge3_bin 3 get ge3_id 2 get ge3_id 3
put ge3_id 8 ge3_bin 3 get ge3_id 3 get ge3_id 7
put ge3_id 9 ge3_bin 3 get ge3_id 6 get ge3_id 8
put ge3_id 10 ge3_fma get ge3_id 0 get ge3_id 1 get ge3_id 2
ge3_step 5 get ge3_id 5 get ge3_id 0
ge3_step 3 get ge3_id 7 get ge3_id 2
ge3_step 4 get ge3_id 8 get ge3_id 7
ge3_step 1 get ge3_id 9 get ge3_id 10
ret ge3_emit_cert pos 0 0 get ge3_id 9 get ge3_id 10
end

note Valid Cert 1 (w=64): Rules 2 (fma_fuse_comm), 6 (mul_zero), 12 (fma_zero_add)
fn ge3_cert1 pos ulong to ulong
ge3_reset_cert 64
put ge3_id 0 ge3_ssa 10
put ge3_id 1 ge3_ssa 11
put ge3_id 2 ge3_ssa 12
put ge3_id 3 ge3_c64 0 0
put ge3_id 4 ge3_bin 5 get ge3_id 2 get ge3_id 3
put ge3_id 5 ge3_bin 5 get ge3_id 0 get ge3_id 1
put ge3_id 6 ge3_bin 3 get ge3_id 4 get ge3_id 5
put ge3_id 7 ge3_fma get ge3_id 0 get ge3_id 1 get ge3_id 3
ge3_step 6 get ge3_id 4 get ge3_id 3
ge3_step 2 get ge3_id 6 get ge3_id 7
ge3_step 12 get ge3_id 7 get ge3_id 5
ret ge3_emit_cert pos 1 0 get ge3_id 6 get ge3_id 5
end

note Valid Cert 2 (w=32): Rules 7 (add_comm), 9 (add_assoc)
fn ge3_cert2 pos ulong to ulong
ge3_reset_cert 32
put ge3_id 0 ge3_ssa 3
put ge3_id 1 ge3_ssa 4
put ge3_id 2 ge3_ssa 5
put ge3_id 3 ge3_bin 3 get ge3_id 0 get ge3_id 1
put ge3_id 4 ge3_bin 3 get ge3_id 3 get ge3_id 2
put ge3_id 5 ge3_bin 3 get ge3_id 1 get ge3_id 2
put ge3_id 6 ge3_bin 3 get ge3_id 0 get ge3_id 5
put ge3_id 7 ge3_bin 3 get ge3_id 5 get ge3_id 0
ge3_step 9 get ge3_id 4 get ge3_id 6
ge3_step 7 get ge3_id 6 get ge3_id 7
ret ge3_emit_cert pos 2 0 get ge3_id 4 get ge3_id 7
end

note Valid Cert 3 (w=64): Rules 8 (mul_comm), 10 (mul_assoc)
fn ge3_cert3 pos ulong to ulong
ge3_reset_cert 64
put ge3_id 0 ge3_ssa 20
put ge3_id 1 ge3_ssa 21
put ge3_id 2 ge3_ssa 22
put ge3_id 3 ge3_bin 5 get ge3_id 0 get ge3_id 1
put ge3_id 4 ge3_bin 5 get ge3_id 3 get ge3_id 2
put ge3_id 5 ge3_bin 5 get ge3_id 1 get ge3_id 2
put ge3_id 6 ge3_bin 5 get ge3_id 0 get ge3_id 5
put ge3_id 7 ge3_bin 5 get ge3_id 5 get ge3_id 0
ge3_step 10 get ge3_id 4 get ge3_id 6
ge3_step 8 get ge3_id 6 get ge3_id 7
ret ge3_emit_cert pos 3 0 get ge3_id 4 get ge3_id 7
end

note Valid Cert 4 (w=32): Rules 11 (and_self), 13 (sub_zero), 14 (sub_self), 15 (xor_self), 16 (or_zero), 17 (shl_zero)
fn ge3_cert4 pos ulong to ulong
ge3_reset_cert 32
put ge3_id 0 ge3_ssa 30
put ge3_id 1 ge3_ssa 31
put ge3_id 2 ge3_ssa 32
put ge3_id 3 ge3_c32 0
put ge3_id 4 ge3_bin 4 get ge3_id 0 get ge3_id 0
put ge3_id 5 ge3_bin 11 get ge3_id 1 get ge3_id 1
put ge3_id 6 ge3_bin 9 get ge3_id 2 get ge3_id 2
put ge3_id 7 ge3_bin 10 get ge3_id 6 get ge3_id 4
put ge3_id 8 ge3_bin 7 get ge3_id 7 get ge3_id 5
put ge3_id 9 ge3_bin 4 get ge3_id 8 get ge3_id 3
ge3_step 14 get ge3_id 4 get ge3_id 3
ge3_step 15 get ge3_id 5 get ge3_id 3
ge3_step 11 get ge3_id 6 get ge3_id 2
ge3_step 16 get ge3_id 7 get ge3_id 6
ge3_step 17 get ge3_id 8 get ge3_id 7
ge3_step 13 get ge3_id 9 get ge3_id 8
ret ge3_emit_cert pos 4 0 get ge3_id 9 get ge3_id 2
end

note Valid Cert 5 (w=32): Rule 18 (mul_pow2_shl) for k=5 and k=31 (MSB) + congruence
fn ge3_cert5 pos ulong to ulong
ge3_reset_cert 32
put ge3_id 0 ge3_ssa 40
put ge3_id 1 ge3_ssa 41
put ge3_id 2 ge3_c32 32
put ge3_id 3 ge3_c32 5
put ge3_id 4 ge3_c32 2147483648
put ge3_id 5 ge3_c32 31
put ge3_id 6 ge3_bin 5 get ge3_id 0 get ge3_id 2
put ge3_id 7 ge3_bin 7 get ge3_id 0 get ge3_id 3
put ge3_id 8 ge3_bin 5 get ge3_id 1 get ge3_id 4
put ge3_id 9 ge3_bin 7 get ge3_id 1 get ge3_id 5
put ge3_id 10 ge3_bin 3 get ge3_id 6 get ge3_id 8
put ge3_id 11 ge3_bin 3 get ge3_id 7 get ge3_id 9
ge3_step 18 get ge3_id 6 get ge3_id 7
ge3_step 18 get ge3_id 8 get ge3_id 9
ret ge3_emit_cert pos 5 0 get ge3_id 10 get ge3_id 11
end

note Valid Cert 6 (w=64): Rule 18 (k=40, k=63) + SHR (opcode 8) + XOR + congruence
fn ge3_cert6 pos ulong to ulong
ge3_reset_cert 64
put ge3_id 0 ge3_ssa 50
put ge3_id 1 ge3_ssa 51
put ge3_id 2 ge3_c64 3 0
put ge3_id 3 ge3_bin 8 get ge3_id 0 get ge3_id 2
put ge3_id 4 ge3_c64 0 256
put ge3_id 5 ge3_c64 40 0
put ge3_id 6 ge3_c64 0 2147483648
put ge3_id 7 ge3_c64 63 0
put ge3_id 8 ge3_bin 5 get ge3_id 3 get ge3_id 4
put ge3_id 9 ge3_bin 7 get ge3_id 3 get ge3_id 5
put ge3_id 10 ge3_bin 5 get ge3_id 1 get ge3_id 6
put ge3_id 11 ge3_bin 7 get ge3_id 1 get ge3_id 7
put ge3_id 12 ge3_bin 11 get ge3_id 8 get ge3_id 10
put ge3_id 13 ge3_bin 11 get ge3_id 9 get ge3_id 11
ge3_step 18 get ge3_id 8 get ge3_id 9
ge3_step 18 get ge3_id 10 get ge3_id 11
ret ge3_emit_cert pos 6 0 get ge3_id 12 get ge3_id 13
end

note Valid Cert 7 (w=64): 64-bit exercise of Rules 1, 3, 4, 5, 11, 13, 14, 15, 16, 17
fn ge3_cert7 pos ulong to ulong
ge3_reset_cert 64
put ge3_id 0 ge3_ssa 60
put ge3_id 1 ge3_ssa 61
put ge3_id 2 ge3_ssa 62
put ge3_id 3 ge3_c64 0 0
put ge3_id 4 ge3_c64 1 0
put ge3_id 5 ge3_bin 4 get ge3_id 2 get ge3_id 2
put ge3_id 6 ge3_bin 11 get ge3_id 0 get ge3_id 0
put ge3_id 7 ge3_bin 9 get ge3_id 0 get ge3_id 0
put ge3_id 8 ge3_bin 5 get ge3_id 7 get ge3_id 4
put ge3_id 9 ge3_bin 10 get ge3_id 1 get ge3_id 5
put ge3_id 10 ge3_bin 7 get ge3_id 9 get ge3_id 6
put ge3_id 11 ge3_bin 5 get ge3_id 8 get ge3_id 10
put ge3_id 12 ge3_bin 3 get ge3_id 2 get ge3_id 3
put ge3_id 13 ge3_bin 3 get ge3_id 3 get ge3_id 12
put ge3_id 14 ge3_bin 4 get ge3_id 13 get ge3_id 3
put ge3_id 15 ge3_bin 3 get ge3_id 11 get ge3_id 14
put ge3_id 16 ge3_fma get ge3_id 0 get ge3_id 1 get ge3_id 2
ge3_step 14 get ge3_id 5 get ge3_id 3
ge3_step 15 get ge3_id 6 get ge3_id 3
ge3_step 11 get ge3_id 7 get ge3_id 0
ge3_step 5 get ge3_id 8 get ge3_id 7
ge3_step 16 get ge3_id 9 get ge3_id 1
ge3_step 17 get ge3_id 10 get ge3_id 9
ge3_step 3 get ge3_id 12 get ge3_id 2
ge3_step 4 get ge3_id 13 get ge3_id 12
ge3_step 13 get ge3_id 14 get ge3_id 13
ge3_step 1 get ge3_id 15 get ge3_id 16
ret ge3_emit_cert pos 7 0 get ge3_id 15 get ge3_id 16
end

note Adversarial Negative Control 1: Unsound rule 99 (add -> mul) MUST be refused
fn ge3_neg1 to bool
p = ge3_begin_bundle 1
ge3_reset_cert 32
x = ge3_ssa 0
y = ge3_ssa 1
rb = ge3_bin 3 x y
ra = ge3_bin 5 x y
ge3_step 99 rb ra
p = ge3_emit_cert p 0 0 rb ra
ret ne vc3_verify p 0
end

note Adversarial Negative Control 2: Structural spoof (rule 3 on add(x, 1) -> x) MUST be refused
fn ge3_neg2 to bool
p = ge3_begin_bundle 1
ge3_reset_cert 32
x = ge3_ssa 0
c1 = ge3_c32 1
rb = ge3_bin 3 x c1
ge3_step 3 rb x
p = ge3_emit_cert p 0 0 rb x
ret ne vc3_verify p 0
end

note Adversarial Negative Control 3: Invalid power-of-2 spoof (rule 18 on mul(x, 6) -> shl(x, 2)) MUST be refused
fn ge3_neg3 to bool
p = ge3_begin_bundle 1
ge3_reset_cert 32
x = ge3_ssa 0
c6 = ge3_c32 6
k2 = ge3_c32 2
rb = ge3_bin 5 x c6
ra = ge3_bin 7 x k2
ge3_step 18 rb ra
p = ge3_emit_cert p 0 0 rb ra
ret ne vc3_verify p 0
end

note Adversarial Negative Control 4: Out-of-width shift (rule 18 with k=32 on 32-bit width) MUST be refused
fn ge3_neg4 to bool
p = ge3_begin_bundle 1
ge3_reset_cert 32
x = ge3_ssa 0
c0 = ge3_c32 0
k32 = ge3_c32 32
rb = ge3_bin 5 x c0
ra = ge3_bin 7 x k32
ge3_step 18 rb ra
p = ge3_emit_cert p 0 0 rb ra
ret ne vc3_verify p 0
end

note Adversarial Negative Control 5: Disconnected root_before vs root_after MUST be refused
fn ge3_neg5 to bool
p = ge3_begin_bundle 1
ge3_reset_cert 32
x = ge3_ssa 0
c0 = ge3_c32 0
rb = ge3_bin 3 x c0
p = ge3_emit_cert p 0 0 rb x
ret ne vc3_verify p 0
end

note Extra framing & 64-bit OOB fail-closed sanity checks (bad magic, truncation, k=64 on 64-bit)
fn ge3_extra_neg to bool
p = ge3_begin_bundle 1
ge3_reset_cert 64
x = ge3_ssa 0
c0 = ge3_c64 0 0
k64 = ge3_c64 64 0
rb = ge3_bin 5 x c0
ra = ge3_bin 7 x k64
ge3_step 18 rb ra
p = ge3_emit_cert p 0 0 rb ra
if eq vc3_verify p 0
ret false
end
note Bad magic refusal
put vc3_buf 3 50
if eq vc3_verify p 0
ret false
end
note Truncated buffer refusal
put vc3_buf 3 51
if eq vc3_verify sub p 4 0
ret false
end
ret true
end

fn ge3_run_selftest to int
p = ge3_begin_bundle 8
p = ge3_cert0 p
p = ge3_cert1 p
p = ge3_cert2 p
p = ge3_cert3 p
p = ge3_cert4 p
p = ge3_cert5 p
p = ge3_cert6 p
p = ge3_cert7 p
st = vc3_verify p
if ne st 0
r = write 2 ge3_t_fail 0 len ge3_t_fail
ge3_w2num st
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret int st
end
ok_certs = get vc3_stat 0
if not ge3_neg1
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 1
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 21
end
if not ge3_neg2
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 2
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 22
end
if not ge3_neg3
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 3
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 23
end
if not ge3_neg4
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 4
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 24
end
if not ge3_neg5
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 5
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 25
end
if not ge3_extra_neg
r = write 2 ge3_t_negfail 0 len ge3_t_negfail
ge3_w2num 6
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret 26
end
r = write 1 ge3_t_pass1 0 len ge3_t_pass1
ge3_w1num ok_certs
r = write 1 ge3_t_pass2 0 len ge3_t_pass2
ret 0
end

fn ge3_run_cli to int
plen = argread 1 ge3_path 0 4095
if lt plen 1
r = write 2 ge3_t_io 0 len ge3_t_io
ret 90
end
fd = fopen ge3_path 0 ulong plen 0 0
if lt fd 0
r = write 2 ge3_t_io 0 len ge3_t_io
ret 91
end
tot = ulong 0
while true bound 2048
rem_cap = sub 1048576 tot
if eq rem_cap 0
note Check if file exceeds 1 MiB buffer (fail closed!)
extra = read int fd ge3_tmp 0 1
if gt extra 0
z1 = fclose int fd
r = write 2 ge3_t_io 0 len ge3_t_io
ret 92
end
break
end
chunk = rem_cap
if gt chunk 65536
chunk = 65536
end
nr = read int fd vc3_buf tot chunk
if lt nr 0
z2 = fclose int fd
r = write 2 ge3_t_io 0 len ge3_t_io
ret 93
end
if eq nr 0
break
end
tot = add tot ulong nr
end
z3 = fclose int fd
st = vc3_verify tot
if ne st 0
r = write 2 ge3_t_fail 0 len ge3_t_fail
ge3_w2num st
r = write 2 ge3_t_nl 0 len ge3_t_nl
ret int st
end
r = write 1 ge3_t_cli1 0 len ge3_t_cli1
ge3_w1num get vc3_stat 0
r = write 1 ge3_t_cli2 0 len ge3_t_cli2
ge3_w1num get vc3_stat 1
r = write 1 ge3_t_cli3 0 len ge3_t_cli3
ge3_w1num get vc3_stat 2
r = write 1 ge3_t_nl 0 len ge3_t_nl
ret 0
end

fn main to int
if ge argcnt 2
ret ge3_run_cli
end
ret ge3_run_selftest
end

note Build with seed/ng/src/ir.om. Generates the deterministic fusion fixture consumed by rgate.
note Every comparison and integer type, both branch directions, select operands, and all TBZ bit numbers.
global fu_f uint 256
global fu_t uint 256
global fu_x ulong 256
global fu_n uint 1
global fu_buf uint 1
fn fu_k b uint t uint x ulong to uint
ret ir_res ir_op b 1 t x 0
end
fn fu_bin b uint op uint t uint x uint y uint to uint
o = ir_op b op t 0 2
ir_set o 0 x
ir_set o 1 y
ret ir_res o
end
fn fu_ret b uint tok uint v uint to void
o = ir_op b 63 0 0 2
ir_set o 0 tok
ir_set o 1 v
end
fn fu_addf f uint t uint to void
n = get fu_n 0
put fu_f n f
put fu_t n t
put fu_x n 1
put fu_n 0 add n 1
end
fn fu_cmp t uint op uint sel bool to void
f = ir_fnew 0 0 5
a = ir_fpar f t
b = ir_fpar f t
x = ir_blk f
u = fu_k x 5 17
v = fu_k x 5 23
if not sel
if or eq op 30 eq op 31
b = fu_k x t 0
end
end
c = fu_bin x op 1 a b
if sel
o = ir_op x 2 5 0 3
ir_set o 0 c
ir_set o 1 u
ir_set o 2 v
fu_ret x ir_ftok f ir_res o
else
bt = ir_blk f
bf = ir_blk f
o = ir_op x 61 0 0 4
ir_set o 0 ir_ftok f
ir_set o 1 c
ir_set o 2 bt
ir_set o 3 bf
fu_ret bt ir_btok bt u
fu_ret bf ir_btok bf v
end
fu_addf f t
end
fn fu_pad b uint to void
j = ulong 0
while lt j 9000 bound 9000
unused = fu_k b 5 j
j = add j 1
end
end
fn fu_setbit bit ulong to void
k = sub get fu_n 0 1
put fu_x k shl ulong 1 bit
end
fn fu_bit bit ulong op uint to void
f = ir_fnew 0 0 5
a = ir_fpar f 5
b = ir_fpar f 5
x = ir_blk f
z = fu_k x 5 0
m = fu_k x 5 shl ulong 1 bit
v = fu_bin x 16 5 a m
c = fu_bin x op 1 v z
bf = ir_blk f
bt = ir_blk f
o = ir_op x 61 0 0 4
ir_set o 0 ir_ftok f
ir_set o 1 c
ir_set o 2 bt
ir_set o 3 bf
fu_ret bt ir_btok bt fu_k bt 5 17
if and eq bit 63 eq op 31
fu_pad bf
end
fu_ret bf ir_btok bf fu_k bf 5 23
fu_addf f 5
fu_setbit bit
end
fn fu_call b uint tok uint k uint a ulong to uint
t = get fu_t k
f = get fu_f k
v = fu_k b t a
z = fu_k b t 0
o = ir_op b 64 5 0 4
ir_set o 0 tok
ir_set o 1 f
ir_set o 2 v
ir_set o 3 z
ret o
end
fn fu_save b uint t uint k ulong v uint to uint
r = get fu_buf 0
i = fu_k b 5 k
e = fu_k b 5 1
o = ir_op b 79 0 3 4
ir_set o 0 t
ir_set o 1 r
ir_set o 2 i
ir_set o 3 e
q = ir_op b 36 2 0 1
ir_set q 0 v
p = ir_op b 43 0 0 4
ir_set p 0 ir_otok o
ir_set p 1 r
ir_set p 2 i
ir_set p 3 ir_res q
ret ir_otok p
end
fn fu_write b uint t uint to uint
r = get fu_buf 0
z = fu_k b 5 0
n = fu_k b 5 mul ulong get fu_n 0 2
o = ir_op b 80 0 3 4
ir_set o 0 t
ir_set o 1 r
ir_set o 2 z
ir_set o 3 n
fd = fu_k b 8 1
q = ir_op b 110 9 54 5
ir_set q 0 ir_otok o
ir_set q 1 fd
ir_set q 2 r
ir_set q 3 z
ir_set q 4 n
ret ir_otok q
end
fn fu_storage b uint to void
arrty = ir_tarr 2 mul get fu_n 0 2
rt = ir_tref arrty 1 0
g = ir_glob arrty 0
put fu_buf 0 ir_res ir_op b 52 rt ulong g 0
end
fn fu_main to void
f = ir_fnew 2 0 8
b = ir_blk f
fu_storage b
t = ir_ftok f
s = fu_k b 5 0
k = uint 0
while lt k get fu_n 0 bound 256
q = fu_call b t k get fu_x k
t = ir_otok q
s = fu_bin b 10 5 s ir_res q
t = fu_save b t mul ulong k 2 ir_res q
q = fu_call b t k 0
t = ir_otok q
s = fu_bin b 10 5 s ir_res q
t = fu_save b t add mul ulong k 2 1 ir_res q
k = add k 1
end
s = fu_bin b 16 5 s fu_k b 5 255
o = ir_op b 36 8 0 1
ir_set o 0 s
t = fu_write b t
fu_ret b t ir_res o
end
fn main to int
ir_init
put fu_n 0 0
t = uint 2
while lt t 10 bound 8
op = uint 30
while lt op 36 bound 6
fu_cmp t op false
fu_cmp t op true
op = add op 1
end
t = add t 1
end
bit = ulong 0
while lt bit 64 bound 64
fu_bit bit 30
fu_bit bit 31
bit = add bit 1
end
fu_main
n = ir_wr
if ne write 1 i_out 0 n long n
ret 27
end
ret 0
end

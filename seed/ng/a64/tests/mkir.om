note mkir: ΩIR fixtures for the ng-a64 gates, built with ir.om's builder (seed/ng/IR.md s14). Built as the
note concatenation seed/ng/src/ir.om + this file. Input: one line naming the fixture; output: its ΩIR binary (ir_wr).
note Program entry (PROPOSED to ng-ir, IR.md s6.1): the function of kind 2 with no parameters and result i32; its
note result is the process exit status.
note   fib   fn fib n u64 -> u64 (n < 2: n, else fib(n-1) + fib(n-2)), the bench kernel; main returns i32 fib(25)
note Exit 2 for an unknown fixture name.
text m_names "fib\n"

fn m_k1 b uint ty uint v ulong to uint
o = ir_op b 1 ty v 0
ret ir_res o
end

note m_bin b op ty x y: a two-operand op with no token, its result
fn m_bin b uint op uint ty uint x uint y uint to uint
o = ir_op b op ty 0 2
ir_set o 0 x
ir_set o 1 y
ret ir_res o
end

note m_call b t f ty a: call f (one argument a) on token t; the op handle (its token ir_otok, result ir_res)
fn m_call b uint t uint f uint ty uint a uint to uint
o = ir_op b 64 ty 0 3
ir_set o 0 t
ir_set o 1 f
ir_set o 2 a
ret o
end

fn m_retv b uint t uint v uint to void
o = ir_op b 63 0 0 2
ir_set o 0 t
ir_set o 1 v
end

fn m_fib to uint
f = ir_fnew 0 0 5
n = ir_fpar f 5
b0 = ir_blk f
bl = ir_blk f
br = ir_blk f
c2 = m_k1 b0 5 2
cm = m_bin b0 32 1 n c2
o = ir_op b0 61 0 0 4
ir_set o 0 ir_ftok f
ir_set o 1 cm
ir_set o 2 bl
ir_set o 3 br
m_retv bl ir_btok bl n
c1 = m_k1 br 5 1
s1 = m_bin br 11 5 n c1
k1 = m_call br ir_btok br f 5 s1
s2 = m_bin br 11 5 n c2
k2 = m_call br ir_otok k1 f 5 s2
a = m_bin br 10 5 ir_res k1 ir_res k2
m_retv br ir_otok k2 a
ret f
end

note m_main f x: export main: i32 (conv) of f(x)
fn m_main f uint x ulong to void
g = ir_fnew 2 0 8
b0 = ir_blk g
c = m_k1 b0 5 x
k = m_call b0 ir_ftok g f 5 c
o = ir_op b0 36 8 0 1
ir_set o 0 ir_res k
m_retv b0 ir_otok k ir_res o
end

fn m_is k ulong n ulong to bool
if lt n add k 1
ret false
end
i = ulong 0
while lt i k bound 64
if ne get i_in i get m_names i
ret false
end
i = add i 1
end
ret true
end

fn main to int
n = read 0 i_in 0 64
if le n 0
ret 2
end
ir_init
ok = false
if m_is 3 ulong n
f = m_fib
m_main f 25
ok = true
end
if not ok
ret 2
end
m = ir_wr
k = write 1 i_out 0 m
if ne k long m
ret 27
end
ret 0
end

note ref/ar.om: omc reference of mkir fixture ar (exit = the u64 fold of w[0 .. 14) low byte)
global w ulong 16

fn mx a uint b uint to uint
if gt a b
ret a
end
ret b
end

fn mn c int d int to int
if lt c d
ret c
end
ret d
end

fn sel c int d int a uint b uint to uint
if lt c d
ret a
end
ret b
end

fn ar1 a uint b uint c int d int to void
put w 0 ulong or shl a 7 shr a 25
put w 1 ulong or shr b 13 shl b 19
put w 2 ulong shl a 9
put w 3 ulong mx a b
put w 4 ulong add a b
put w 5 ulong mul a b
put w 6 ulong sel c d a b
put w 7 ulong and add and a 255 200 255
put w 8 ulong shr b 5
end

fn ar2 c int d int to void
off = int 1073741824
put w 9 ulong add shr c 3 off
put w 10 ulong add div c d off
put w 11 ulong add rem c d off
put w 12 ulong add mn c d off
put w 13 ulong add sub c d off
end

fn ar a uint b uint c int d int to ulong
ar1 a b c d
ar2 c d
s = ulong 0
k = ulong 0
while lt k 14 bound 14
s = add mul s 1000003 get w k
k = add k 1
end
ret s
end

fn main to int
ret int and ar 2654435769 2135587861 sub int 0 1000003 77 255
end

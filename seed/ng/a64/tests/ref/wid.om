note ref/wid.om: omc reference of mkir fixture wid (exit = (2000029900 + 5) mod 256 = 209)
global gb byte 2
global gs ushort 2
global gh short 2
global gu uint 2
global gi int 2
fn main to int
put gb 1 byte -100
put gs 1 ushort 60000
put gh 1 short -30000
put gu 1 uint 4000000000
put gi 1 int -2000000000
s = long get gb 1
s = add s long get gs 1
s = add s long get gh 1
s = add s long get gu 1
s = add s long get gi 1
if eq get gb 1 byte -100
s = add s long 1
end
if eq get gs 1 ushort 60000
s = add s long 1
end
if eq get gh 1 short -30000
s = add s long 1
end
if eq get gu 1 uint 4000000000
s = add s long 1
end
if eq get gi 1 int -2000000000
s = add s long 1
end
ret int rem s 256
end

note ref/lv.om: omc reference of mkir fixture lv (exit = lv(9) low byte). The fixture keeps v_0 .. v_19 live in
note registers across chk.add, chk.mul and chk.bounds; here they sit in a global, the checks being Omega's own.
global v ulong 20
global g ulong 8

fn lv n ulong to ulong
k = ulong 0
while lt k 20 bound 20
put v k add mul n add mul k 2 3 add mul k k 1
k = add k 1
end
c = add get v 0 get v 1
d = mul get v 2 get v 3
e = get g and n 7
s = n
k = 0
while lt k 20 bound 20
s = xor mul s 5 get v k
k = add k 1
end
ret s
end

fn main to int
ret int and lv 9 255
end

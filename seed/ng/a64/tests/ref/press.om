note ref/press.om: omc reference of mkir fixture press (exit = (pr(7) + pq(9)) low byte)
global v ulong 64

fn fib n ulong to ulong
if lt n 2
ret n
end
ret add fib sub n 1 fib sub n 2
end

fn pr n ulong to ulong
k = ulong 0
while lt k 28 bound 28
put v k add mul n add mul k 2 3 add mul k k 1
k = add k 1
end
s = fib 10
k = 0
while lt k 28 bound 28
s = add mul s 3 get v k
k = add k 1
end
ret s
end

fn pq n ulong to ulong
k = ulong 0
while lt k 40 bound 40
put v k add mul n add mul k 5 7 add mul k 11 13
k = add k 1
end
s = n
k = 0
while lt k 40 bound 40
s = xor mul s 5 get v k
k = add k 1
end
ret s
end

fn main to int
ret int and add pr 7 pq 9 255
end

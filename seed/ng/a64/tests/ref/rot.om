note ref/rot.om: omc reference of mkir fixture rot (exit = rot(1000) low byte)
fn rot n ulong to ulong
i = ulong 0
x = ulong 1
y = ulong 2
z = ulong 3
s = ulong 0
while lt i n bound 1000000
s = add mul s 31 x
t = x
x = y
y = z
z = t
i = add i 1
end
ret s
end

fn main to int
ret int and rot 1000 255
end

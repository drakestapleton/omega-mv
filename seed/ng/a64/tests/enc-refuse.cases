@ng a64-enc
; Refusal cases for seed/ng/a64/gate.om (step 6). One case per line: FORM operands | the one stderr line ng must
; print. Each case runs alone, as line 2 of a case list `@ng a64-enc` + the case; ng must exit 5 and write nothing
; to stdout. The gate also runs these cases on a mutant whose field check masks instead of refusing (a6_fld), which
; must fail at least one of them.
; In-field values whose encoding Arm ARM DDI 0487 M.d reserves (a6_rsv, a64.om): 32-bit shift amounts, BFM immr and
; imms and MOVZ/MOVN hw; sh 3 on ADD/SUB shifted register; sh or amt on a kind-1 form without a shift field.
addw 1 2 3 0 32 | a64: reserved operand value 32
andw 1 2 3 0 32 | a64: reserved operand value 32
addx 1 2 3 3 0 | a64: reserved operand value 3
subsw 1 2 3 3 0 | a64: reserved operand value 3
movzw 1 5 2 | a64: reserved operand value 2
movnw 1 5 3 | a64: reserved operand value 3
ubfmw 1 2 40 3 | a64: reserved operand value 40
sbfmw 1 2 3 40 | a64: reserved operand value 40
mulx 1 2 3 0 1 | a64: reserved operand value 1
lslvw 1 2 3 1 0 | a64: reserved operand value 1
faddd 1 2 3 0 4 | a64: reserved operand value 4
fadd4s 1 2 3 0 1 | a64: reserved operand value 1
fmla2d 1 2 3 1 0 | a64: reserved operand value 1
orr16b 1 2 2 0 2 | a64: reserved operand value 2
; Values outside their field (a6_fld, a6_bmenc, a6_dsig), and a line naming no form.
addxi 1 2 4096 0 | a64: immediate out of range 4096
addx 32 2 3 0 0 | a64: immediate out of range 32
addx 1 2 3 4 0 | a64: immediate out of range 4
addx 1 2 3 0 64 | a64: immediate out of range 64
movzx 1 65536 0 | a64: immediate out of range 65536
movzx 1 5 4 | a64: immediate out of range 4
ubfmx 1 2 64 0 | a64: immediate out of range 64
extrx 1 2 3 64 | a64: immediate out of range 64
andxi 1 2 0 | a64: immediate out of range 0
cbzx 1 262144 | a64: branch out of range 262144
b 33554432 | a64: branch out of range 33554432
msrfpcr 32 | a64: immediate out of range 32
fcseld 1 2 3 16 | a64: immediate out of range 16
dup2d 32 1 | a64: immediate out of range 32
strqr 1 2 3 2 | a64: immediate out of range 2
strq 1 31 4096 | a64: immediate out of range 4096
ldrq 1 31 4096 | a64: immediate out of range 4096
ldrqr 1 2 3 2 | a64: immediate out of range 2
dupv4s 1 2 4 | a64: immediate out of range 4
dupv2d 1 2 2 | a64: immediate out of range 2
dups 1 2 4 | a64: immediate out of range 4
dupd 1 2 2 | a64: immediate out of range 2
nosuch 1 2 | a64: bad encoder case at line 2

target macos
note libwrite: dlsym through libfn 1 and libcall, then write(1, msg, 35) through libcall. Status: the count that
note write returned, 35; 2 when libfn gives a function for a number above 1. Stdout: the message.
text s_write "write"
text s_msg "hello from Omega through libSystem\n"

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn g64 b view uchar 128 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note the address of the library function named by the n bytes of nm (nm is zero after them)
fn sym rg edit uchar 128 nm edit uchar 64 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 64
ret ulong libcall ulong libfn 1 rg 0 128
end

fn main to int
rg = new uchar 128 0
nm = new uchar 64 0
mb = new uchar 64 0
for i ulong len s_msg
put mb i get s_msg i
end
if ne libfn 2 0
ret 2
end
if ne libfn 77 0
ret 2
end
for i ulong len s_write
put nm i get s_write i
end
put nm len s_write 0
f = sym rg nm
p64 rg 0 1
p64 rg 8 ulong libptr mb 0 64
p64 rg 16 len s_msg
n = libcall f rg 0 128
ret int n
end

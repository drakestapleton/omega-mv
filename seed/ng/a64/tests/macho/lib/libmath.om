target macos
note libmath: the float registers. sqrt(2.0) through d0 and pow(2.0, 10.0) through d0 and d1; the results come
note back at byte 64 of the register file. Status 1 when both have the exact bits, else 2 or 3.
text s_sqrt "sqrt"
text s_pow "pow"

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn g64 b view uchar 128 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note the address of the library function named by the n bytes of nm (nm is zero after them)
fn sym rg edit uchar 128 nm edit uchar 64 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 64
ret ulong libcall ulong libfn 1 rg 0 128
end

fn main to int
rg = new uchar 128 0
nm = new uchar 64 0
for i ulong len s_sqrt
put nm i get s_sqrt i
end
put nm len s_sqrt 0
f = sym rg nm
p64 rg 64 4611686018427387904
r = libcall f rg 0 128
if ne g64 rg 64 4609047870845172685
ret 2
end
for i ulong len s_pow
put nm i get s_pow i
end
put nm len s_pow 0
g = sym rg nm
p64 rg 64 4611686018427387904
p64 rg 72 4621819117588971520
r = libcall g rg 0 128
if ne g64 rg 64 4652218415073722368
ret 3
end
ret 1
end

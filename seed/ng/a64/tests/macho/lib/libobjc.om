target macos
note libobjc: dlopen through libfn 0, then Objective-C messages. [[NSProcessInfo processInfo] processorCount]
note must equal sysconf(57), the configured processors. Status 1; 2 to 6 name the step that failed.
text s_fnd "/System/Library/Frameworks/Foundation.framework/Foundation"
text s_gc "objc_getClass"
text s_sr "sel_registerName"
text s_ms "objc_msgSend"
text s_sc "sysconf"
text s_cls "NSProcessInfo"
text s_pi "processInfo"
text s_pc "processorCount"

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn g64 b view uchar 128 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note the address of the library function named by the n bytes of nm (nm is zero after them)
fn sym rg edit uchar 128 nm edit uchar 64 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 64
ret ulong libcall ulong libfn 1 rg 0 128
end

fn main to int
rg = new uchar 128 0
nm = new uchar 64 0
for i ulong len s_fnd
put nm i get s_fnd i
end
put nm len s_fnd 0
p64 rg 0 ulong libptr nm 0 64
p64 rg 8 2
h = libcall ulong libfn 0 rg 0 128
if eq h 0
ret 2
end
for i ulong len s_gc
put nm i get s_gc i
end
put nm len s_gc 0
gc = sym rg nm
for i ulong len s_sr
put nm i get s_sr i
end
put nm len s_sr 0
sr = sym rg nm
for i ulong len s_ms
put nm i get s_ms i
end
put nm len s_ms 0
ms = sym rg nm
for i ulong len s_sc
put nm i get s_sc i
end
put nm len s_sc 0
sc = sym rg nm
if or or eq gc 0 eq sr 0 or eq ms 0 eq sc 0
ret 3
end
for i ulong len s_cls
put nm i get s_cls i
end
put nm len s_cls 0
p64 rg 0 ulong libptr nm 0 64
cls = libcall gc rg 0 128
if eq cls 0
ret 4
end
for i ulong len s_pi
put nm i get s_pi i
end
put nm len s_pi 0
p64 rg 0 ulong libptr nm 0 64
sel = libcall sr rg 0 128
p64 rg 0 g64 rg 0
p64 rg 0 ulong cls
p64 rg 8 ulong sel
pi = libcall ms rg 0 128
if eq pi 0
ret 5
end
for i ulong len s_pc
put nm i get s_pc i
end
put nm len s_pc 0
p64 rg 0 ulong libptr nm 0 64
sel = libcall sr rg 0 128
p64 rg 0 ulong pi
p64 rg 8 ulong sel
n = libcall ms rg 0 128
p64 rg 0 57
c = libcall sc rg 0 128
if or ne n c le n 0
ret 6
end
ret 1
end

target macos
note libback: library code calls back into Omega. qsort of libSystem sorts eight 64-bit numbers; its comparison
note function is callback entry 5 (libfn 7), so the function libback runs with k = 5 and the addresses of two
note elements. It reads them with memcpy: a libcall inside a callback, on the C stack below qsort's frames.
note Status 1 when the numbers come out sorted, the callback ran at least seven times with k = 5 and no other k,
note libfn gives nothing for 18 and different entries for 2 and 3, and a libcall after the sort still works.
note 2 to 8 name the step that failed.
text s_qs "qsort"
text s_mc "memcpy"
text s_in "53819274"
global g_f ulong 4
global g_rg uchar 128
global g_a uchar 16

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn pr o ulong v ulong to void
for i ulong 8
put g_rg add o i uchar and shr v mul i 8 255
end
end

fn ga o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_a add o i mul i 8
end
ret v
end

fn sym rg edit uchar 128 nm edit uchar 64 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 64
ret ulong libcall ulong libfn 1 rg 0 128
end

fn libback k ulong a ulong b ulong c ulong d ulong e ulong to ulong
put g_f 1 add get g_f 1 1
if ne k 5
put g_f 2 1
end
pr 0 ulong libptr g_a 0 16
pr 8 a
pr 16 8
r = libcall get g_f 0 g_rg 0 128
pr 0 ulong libptr g_a 8 8
pr 8 b
pr 16 8
r = libcall get g_f 0 g_rg 0 128
x = ga 0
y = ga 8
if lt x y
ret 18446744073709551615
end
if gt x y
ret 1
end
ret 0
end

fn main to int
rg = new uchar 128 0
nm = new uchar 64 0
arr = new uchar 64 0
out = new uchar 64 0
for i ulong 8
put arr mul i 8 uchar sub get s_in i 48
end
for i ulong len s_qs
put nm i get s_qs i
end
put nm len s_qs 0
qs = sym rg nm
for i ulong len s_mc
put nm i get s_mc i
end
put nm len s_mc 0
mc = sym rg nm
if or eq qs 0 eq mc 0
ret 2
end
put g_f 0 mc
cb = ulong libfn 7
if or eq cb 0 ne ulong libfn 18 0
ret 3
end
if or eq ulong libfn 2 ulong libfn 3 ne sub ulong libfn 3 ulong libfn 2 8
ret 4
end
p64 rg 0 ulong libptr arr 0 64
p64 rg 8 8
p64 rg 16 8
p64 rg 24 cb
r = libcall qs rg 0 128
if or ne get g_f 2 0 lt get g_f 1 7
ret 5
end
p64 rg 0 ulong libptr out 0 64
p64 rg 8 ulong libptr arr 0 64
p64 rg 16 64
r = libcall mc rg 0 128
want = ulong 1
for i ulong 8
if or ne ulong get out mul i 8 want ne ulong get out add mul i 8 1 0
ret 6
end
want = add want 1
if eq want 6
want = ulong 7
end
end
ret 1
end

target macos
note libbackobjc: an Objective-C class whose methods are Omega code. The program makes the class OmegaTarget
note (objc_allocateClassPair), gives it the methods poke: (callback entry 0) and twice: (entry 3) with
note class_addMethod, makes an object and sends both messages. libback must run once with k 0, the object, the
note selector and the argument, then with k 3, and its result 2 * 21 must come back through objc_msgSend.
note Status 1; 2 to 10 name the step that failed.
text s_all "/System/Library/Frameworks/Foundation.framework/Foundationobjc_getClasssel_registerNameobjc_msgSendobjc_allocateClassPairclass_addMethodobjc_registerClassPairNSObjectOmegaTargetpoke:twice:v@:@Q@:QallocinitperformSelector:withObject:respondsToSelector:"
global g_f ulong 6
global g_b ulong 5

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn g64 b view uchar 128 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note the n bytes of s_all at o, then a zero byte, into nm
fn ld nm edit uchar 256 o ulong n ulong to void
for i ulong n
put nm i get s_all add o i
end
put nm n 0
end

fn sym rg edit uchar 128 nm edit uchar 256 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 256
lr = libcall ulong libfn 1 rg 0 128
ret g64 rg 0
end

note library function w of g_f (0 objc_getClass, 1 sel_registerName) on the name at o
fn one rg edit uchar 128 nm edit uchar 256 w ulong o ulong n ulong to ulong
ld nm o n
p64 rg 0 ulong libptr nm 0 256
lr = libcall get g_f w rg 0 128
ret g64 rg 0
end

note [obj s a b]; the answer is read from the register file (an object may have its top bit set)
fn msg rg edit uchar 128 obj ulong s ulong a ulong b ulong to ulong
p64 rg 0 obj
p64 rg 8 s
p64 rg 16 a
p64 rg 24 b
lr = libcall get g_f 2 rg 0 128
ret g64 rg 0
end

fn libback k ulong a ulong b ulong c ulong d ulong e ulong to ulong
put g_b 0 add get g_b 0 1
put g_b 1 k
put g_b 2 a
put g_b 3 b
put g_b 4 c
if eq k 3
ret mul c 2
end
ret 0
end

fn main to int
rg = new uchar 128 0
nm = new uchar 256 0
nm2 = new uchar 256 0
ld nm 0 58
p64 rg 0 ulong libptr nm 0 256
p64 rg 8 2
lr = libcall ulong libfn 0 rg 0 128
if eq g64 rg 0 0
ret 2
end
ld nm 58 13
put g_f 0 sym rg nm
ld nm 71 16
put g_f 1 sym rg nm
ld nm 87 12
put g_f 2 sym rg nm
ld nm 99 22
put g_f 3 sym rg nm
ld nm 121 15
put g_f 4 sym rg nm
ld nm 136 22
put g_f 5 sym rg nm
for i ulong 6
if eq get g_f i 0
ret 3
end
end
base = one rg nm 0 158 8
ld nm 166 11
p64 rg 0 base
p64 rg 8 ulong libptr nm 0 256
p64 rg 16 0
lr = libcall get g_f 3 rg 0 128
cl = g64 rg 0
if eq cl 0
ret 4
end
poke = one rg nm 1 177 5
twice = one rg nm 1 182 6
ld nm2 188 4
p64 rg 0 cl
p64 rg 8 poke
p64 rg 16 ulong libfn 2
p64 rg 24 ulong libptr nm2 0 256
lr = libcall get g_f 4 rg 0 128
if ne and g64 rg 0 255 1
ret 5
end
ld nm2 192 4
p64 rg 0 cl
p64 rg 8 twice
p64 rg 16 ulong libfn 5
p64 rg 24 ulong libptr nm2 0 256
lr = libcall get g_f 4 rg 0 128
if ne and g64 rg 0 255 1
ret 5
end
p64 rg 0 cl
lr = libcall get g_f 5 rg 0 128
s = one rg nm 1 196 5
obj = msg rg cl s 0 0
s = one rg nm 1 201 4
obj = msg rg obj s 0 0
if eq obj 0
ret 6
end
s = one rg nm 1 205 27
r = msg rg obj s poke obj
if or ne get g_b 0 1 or ne get g_b 1 0 ne get g_b 2 obj
ret 7
end
if or ne get g_b 3 poke ne get g_b 4 obj
ret 8
end
r = msg rg obj twice 21 0
if or ne r 42 or ne get g_b 0 2 ne get g_b 1 3
ret 9
end
s = one rg nm 1 232 19
r = and msg rg obj s twice 0 255
if ne r 1
ret 10
end
ret 1
end

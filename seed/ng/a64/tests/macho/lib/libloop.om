target macos
note libloop: values that live across library calls. 200 calls of getpid in a loop with eight running sums; each
note sum must come out as computed without the calls, and every call must give the same number. Status 1.
text s_getpid "getpid"

fn p64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

fn g64 b view uchar 128 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b add o i mul i 8
end
ret v
end

note the address of the library function named by the n bytes of nm (nm is zero after them)
fn sym rg edit uchar 128 nm edit uchar 64 to ulong
p64 rg 0 18446744073709551614
p64 rg 8 ulong libptr nm 0 64
ret ulong libcall ulong libfn 1 rg 0 128
end

fn main to int
rg = new uchar 128 0
nm = new uchar 64 0
for i ulong len s_getpid
put nm i get s_getpid i
end
put nm len s_getpid 0
f = sym rg nm
pid = libcall f rg 0 128
if le pid 0
ret 2
end
a = ulong 1
b = ulong 2
c = ulong 3
d = ulong 4
e = ulong 5
g = ulong 6
h = ulong 7
bad = ulong 0
x = f64 1.5
for i ulong 200
a = add a i
b = add b mul i 2
c = add c mul i 3
d = xor d add i 11
e = add e a
g = add g b
h = xor h c
x = add x f64 0.25
q = libcall f rg 0 128
if ne q pid
bad = add bad 1
end
if ne g64 rg 0 ulong pid
bad = add bad 1
end
end
if ne bad 0
ret 3
end
if or ne a 19901 ne b 39802
ret 4
end
if ne c 59703
ret 5
end
if ne x f64 51.5
ret 6
end
ret 1
end

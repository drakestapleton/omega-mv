note frand.om: scalar float programs for the ng-a64 back-end gate (rgate.om, D-float in seed/ng/a64/DESIGN.md
note section 9). Build: seed/out/omc < seed/ng/a64/tests/frand.om > frand
note   frand SEED     a random canonical ΩIR text unit (IR.md s10) for SEED (decimal, 1..2^64-1) on stdout
note   frand edge K   the deterministic edge program K (1..56, below)
note A unit: @f0 writes its u64 argument as 8 little-endian bytes to stdout (write, host 54); @f1 and @f2 print an
note f64 or f32 arithmetic result: a NaN (it compares unequal to itself) is printed with its sign and payload
note dropped but its exponent and quiet bit kept (IR.md s7.3: an arithmetic NaN is any quiet NaN; a signaling
note result would print differently), every other value bit for bit; @f3 has a random signature of up to 20
note parameters mixing f64, f32 and integers (more than eight of either register bank: stack arguments) and folds
note them into its f64 or f32 result after printing each of them (its float parameters live across calls); @f6
note takes the same arguments and is a leaf returning a u64 checksum of every argument bit (parameters stay in their
note argument registers); @f5 recurses (depth 0..19) with an f64 and an f32 of each frame live across its call
note (callee-saved V registers at every depth). The export @f4 holds a pool of f32/f64 values from an edge table (signed
note zeros, infinities, quiet and signaling NaNs with payloads, largest/smallest normals and subnormals, conversion
note boundaries and halfway cases) and random bits, then random operations, each result printed: add sub mul div
note min max (canonical print), neg fabs (bit for bit), fsqrt, fma, the six compares (as 0/1), select, bitcast
note both ways, conv int -> float (nearest even and toward zero), f64 -> f32 (imm 0, 1, 4, 5), f32 -> f64, float ->
note every integer type, stores and loads of f32/f64 array elements, calls of @f3, and a two-way branch whose join
note block takes float parameters in either order (parallel-move cycles). The pool stays live to the end, where
note every value is printed again (more live floats across calls than d8..d15 hold: spills). One seed in four
note ends with a chk.conv of a pool value into a random integer type (trap 5 when it is NaN or out of range).
note Edge programs: 1 f64 and 2 f32 binary ops and compares over every pair of the edge table; 3 f64 and 4 f32
note unary ops, conversions to every integer type and to the other float width in every mode, bitcasts; 5 integer
note edge values to f32/f64 in both modes; 6 f64 and 7 f32 chk.conv of every passing edge value; 8 + j (j 0..47)
note for integer type 2 + j mod 8, source f32 (j / 8 even) or f64, case j / 16: the values just inside both ends of
note the chk.conv range pass and are converted, then the upper bound (case 0), the lower one (case 1) or a NaN (case
note 2) traps 5. ngrun is the oracle: rgate compares status, stdout and stderr byte for byte.
om2

global ob uchar 8388608
global on ulong 1
global rs ulong 1
global vn ulong 1
global tk ulong 1
global bn ulong 1
global pv ulong 4096
global pt ulong 4096
global pc ulong 4096
global pn ulong 1
global iv ulong 4096
global it ulong 4096
global inn ulong 1
global bv ulong 4096
global bnn ulong 1
global fp ulong 64
global fpn ulong 1
note fr[0] = 1 (epress): each float argument of @f3 is a fresh finite constant in [1, 2) (held in a register at the
note call, and no NaN or infinity hides a misplaced argument in @f3's result)
global fr ulong 1
global ra ulong 2
global y_pa uchar 4096

text y_use "usage: frand SEED | frand edge K\n"
text y_io "frand: io error\n"
text y_edge "edge"
text y_hd "omegair 1\ntype %t32 = array u8 8\ntype %t33 = ref edit host %t32\ntype %t34 = array f64 8\ntype %t35 = ref edit host %t34\ntype %t36 = array f32 8\ntype %t37 = ref edit host %t36\nglobal @g0 %t32 zero\n"
text y_f0 "fn @f0 flags 0 %1:u64 -> void\nblock ^0\n%2 = gaddr %t33 @g0\n%3 = const u64 0\nbr ^1 %0 %3 %1\nblock ^1 %4:tok %5:u64 %6:u64\n%7 = const u64 8\n%8 = lt bool %5 %7\ncbr %4 %8 ^2 ^3\nblock ^2 %9:tok\n%10 = const u64 1\n%11 = chk.bounds 3 %9 %2 %5 %10\n%12 = conv u8 0 %6\n%13 = store %11 %2 %5 %12\n%14 = const u64 8\n%15 = shr u64 %6 %14\n%16 = add u64 %5 %10\nbr ^1 %13 %16 %15\nblock ^3 %17:tok\n%18 = const i32 1\n%19 = const u64 0\n%20 = chk.slice 3 %17 %2 %19 %7\n%21 %22 = host i64 54 %20 %18 %2 %19 %7\nret %21\nend\n"
text y_f1 "fn @f1 flags 0 %1:f64 -> void\nblock ^0\n%2 = ne bool %1 %1\n%3 = bitcast u64 %1\n%4 = const u64 9221120237041090560\n%5 = and u64 %3 %4\n%6 = select u64 %2 %5 %3\n%7 = call void %0 @f0 %6\nret %7\nend\n"
text y_f2 "fn @f2 flags 0 %1:f32 -> void\nblock ^0\n%2 = ne bool %1 %1\n%3 = bitcast u32 %1\n%4 = const u32 2143289344\n%5 = and u32 %3 %4\n%6 = select u32 %2 %5 %3\n%7 = conv u64 0 %6\n%8 = call void %0 @f0 %7\nret %8\nend\n"
text y_eq " = "
text y_call "call "
text y_void "void "
text y_f0c " @f0 "
text y_f1c " @f1 "
text y_f2c " @f2 "
text y_f3c " @f3"
text y_f6c " @f6"
text y_fn6 "fn @f6 flags 0"
text y_rotl "rotl u64 "
text y_xor "xor u64 "
text y_const "const "
text y_conv "conv "
text y_bcast "bitcast "
text y_sel "select "
text y_fma "fma "
text y_bool "bool "
text y_load "load "
text y_store "store "
text y_chkb "chk.bounds 3 "
text y_chkc "chk.conv "
text y_alloca "alloca "
text y_cbr "cbr "
text y_br "br ^"
text y_block "block ^"
text y_tok ":tok"
text y_retv "retv "
text y_end "end\n"
text y_fn3 "fn @f3 flags 0"
text y_arrow " -> "
text y_ex4 "export @f4 flags 0 -> i32\nblock ^0\n"
text y_f5 "fn @f5 flags 0 %1:f64 %2:u64 %3:f32 -> f64\nblock ^0\n%4 = const u64 0\n%5 = eq bool %2 %4\ncbr %0 %5 ^1 ^2\nblock ^1 %6:tok\nretv %6 %1\nblock ^2 %7:tok\n%8 = const f64 0x3ff8000000000000\n%9 = mul f64 %1 %8\n%10 = conv f64 0 %3\n%11 = add f64 %9 %10\n%12 = const u64 1\n%13 = sub u64 %2 %12\n%14 = neg f32 %3\n%15 %16 = call f64 %7 @f5 %11 %13 %14\n%17 = sub f64 %16 %9\n%18 = conv f64 0 %14\n%19 = add f64 %17 %18\nretv %15 %19\nend\n"
text y_x "0x"
text y_t35 "%t35 "
text y_t37 "%t37 "
text y_bop "add sub mul div min max "
text y_cop "eq ne lt le gt ge "
text y_uop "neg fabs fsqrt "
text y_tn "bool u8 u16 u32 u64 i8 i16 i32 i64 f32 f64 "

note f64 edge table: +-0, +-1, 0.5, 1.5, 3, largest finite, smallest normal, largest and smallest subnormal, +-inf,
note quiet NaNs (with payload, negative), signaling NaNs, 2^31 - 1, +-2^31, +-2^63, 2^64, 255.5, 65535.75, -128.9,
note the largest f32 as f64, the f64 just below and at the f32 overflow halfway point, 2^-149, 2^-150, 1 + 2^-24
note (f32 halfway), 1 + 3 * 2^-24, 2^53 + 2, -2^53
global e64 ulong 40
global e32 ulong 32
global ein ulong 24

fn ini to void
put e64 0 0
put e64 1 0x8000000000000000
put e64 2 0x3ff0000000000000
put e64 3 0xbff0000000000000
put e64 4 0x3fe0000000000000
put e64 5 0x3ff8000000000000
put e64 6 0x4008000000000000
put e64 7 0x7fefffffffffffff
put e64 8 0x0010000000000000
put e64 9 0x000fffffffffffff
put e64 10 0x0000000000000001
put e64 11 0x7ff0000000000000
put e64 12 0xfff0000000000000
put e64 13 0x7ff8000000000000
put e64 14 0x7ff8000000000123
put e64 15 0xfff8000000000000
put e64 16 0x7ff0000000000001
put e64 17 0xfff4000000000005
put e64 18 0x41dfffffffc00000
put e64 19 0x41e0000000000000
put e64 20 0xc1e0000000000000
put e64 21 0x43e0000000000000
put e64 22 0xc3e0000000000000
put e64 23 0x43f0000000000000
put e64 24 0x406ff00000000000
put e64 25 0x40effff800000000
put e64 26 0xc06011cccccccccd
put e64 27 0x47efffffe0000000
put e64 28 0x47efffffefffffff
put e64 29 0x47effffff0000000
put e64 30 0x36a0000000000000
put e64 31 0x3690000000000000
put e64 32 0x3ff0000010000000
put e64 33 0x3ff0000030000000
put e64 34 0x4340000000000001
put e64 35 0xc340000000000000
put e64 36 0x41efffffffe00000
put e64 37 0xc1e0000000200000
put e64 38 0x3fefffffffffffff
put e64 39 0xc3dfffffffffffff
put e32 0 0
put e32 1 0x80000000
put e32 2 0x3f800000
put e32 3 0xbf800000
put e32 4 0x3f000000
put e32 5 0x3fc00000
put e32 6 0x7f7fffff
put e32 7 0x00800000
put e32 8 0x007fffff
put e32 9 0x00000001
put e32 10 0x7f800000
put e32 11 0xff800000
put e32 12 0x7fc00000
put e32 13 0x7fc00123
put e32 14 0xffc00000
put e32 15 0x7f800001
put e32 16 0xffa00005
put e32 17 0x4f000000
put e32 18 0xcf000000
put e32 19 0x5f000000
put e32 20 0xdf000000
put e32 21 0x5f800000
put e32 22 0x437f8000
put e32 23 0x437f0000
put e32 24 0xc3010000
put e32 25 0x477fffc0
put e32 26 0x4b800001
put e32 27 0xcb800000
put e32 28 0x3f7fffff
put e32 29 0x4effffff
put e32 30 0xc2fe0000
put e32 31 0x46fffe00
put ein 0 0
put ein 1 1
put ein 2 0xffffffffffffffff
put ein 3 0x7fffffffffffffff
put ein 4 0x8000000000000000
put ein 5 0x20000000000001
put ein 6 0x20000000000003
put ein 7 0x1000001
put ein 8 0x1000003
put ein 9 0x7fffffff
put ein 10 0x80000000
put ein 11 0xffffffff
put ein 12 0xffffffff80000000
put ein 13 0xfffffffffeffffff
put ein 14 0x7fffff8000000001
put ein 15 0xffffff7fffffffff
put ein 16 255
put ein 17 0xffffffffffffff80
put ein 18 65535
put ein 19 0xffffffffffff8000
put ein 20 0x8000000000000401
put ein 21 0xfffffffffffff801
put ein 22 3
put ein 23 0x10000000000000ff
end

note ---- output ----
fn oc c ulong to void
n = get on 0
if lt n len ob
put ob n uchar c
put on 0 add n 1
end
end

fn ws t view uchar * to void
for j ulong len t bound 4096
oc ulong get t j
end
end

note wk t k: the k-th space-separated word of t
fn wk t view uchar * k ulong to void
i = ulong 0
w = ulong 0
while lt i len t bound 4096
c = ulong get t i
if eq c 32
w = add w 1
else
if eq w k
oc c
end
end
i = add i 1
end
end

fn wd v ulong to void
d = ulong 1
while ge div v d 10 bound 20
d = mul d 10
end
x = v
while gt d 0 bound 20
oc add 48 div x d
x = rem x d
d = div d 10
end
end

note wsd v w: v as a signed decimal of width w bits (canonical form: sign-extended)
fn wsd v ulong to void
if ne shr v 63 0
oc 45
wd sub ulong 0 v
else
wd v
end
end

fn wh v ulong n ulong to void
ws y_x
k = n
while gt k 0 bound 16
k = sub k 1
c = and shr v mul k 4 15
if lt c 10
oc add 48 c
else
oc add 87 c
end
end
end

fn nl to void
oc 10
end

fn sp to void
oc 32
end

note type ids (IR.md s4.1): 1 bool, 2 u8, 3 u16, 4 u32, 5 u64, 6 i8, 7 i16, 8 i32, 9 i64, 13 f32, 14 f64
fn wty t ulong to void
if le t 9
wk y_tn sub t 1
ret
end
wk y_tn sub t 4
end

fn wv v ulong to void
oc 37
wd v
end

note nv: a new value id, its line started (`%N = `)
fn nv to ulong
v = get vn 0
put vn 0 add v 1
wv v
ws y_eq
ret v
end

fn flush to bool
n = get on 0
p = ulong 0
while lt p n bound 65536
k = write 1 ob p sub n p
if le k 0
ret false
end
p = add p ulong k
end
ret true
end

note ---- splitmix64 ----
fn rnd to ulong
s = add get rs 0 0x9e3779b97f4a7c15
put rs 0 s
z = mul xor s shr s 30 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 0x94d049bb133111eb
ret xor z shr z 31
end

fn rn n ulong to ulong
ret rem rnd n
end

note ---- values ----
fn isf t ulong to bool
ret or eq t 13 eq t 14
end

fn sgn t ulong to bool
ret and ge t 6 le t 9
end

fn wid t ulong to ulong
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or or eq t 4 eq t 8 eq t 13
ret 32
end
ret 64
end

note canon t v: integer bits v as the canonical const imm of int type t
fn canon t ulong v ulong to ulong
w = wid t
if eq w 64
ret v
end
m = sub shl ulong 1 w 1
x = and v m
if sgn t
s = shl ulong 1 sub w 1
ret sub xor x s s
end
ret x
end

note kconst t v: a const of type t with bits v (floats: low 32 bits for f32), a new value
fn kconst t ulong v ulong to ulong
r = nv
ws y_const
wty t
sp
if eq t 14
wh v 16
end
if eq t 13
wh and v 0xffffffff 8
end
if not isf t
c = canon t v
if sgn t
wsd c
else
wd c
end
end
nl
ret r
end

fn addf v ulong t ulong c ulong to void
n = get pn 0
if lt n len pv
put pv n v
put pt n t
put pc n c
put pn 0 add n 1
end
end

fn addi v ulong t ulong to void
n = get inn 0
if lt n len iv
put iv n v
put it n t
put inn 0 add n 1
end
end

fn addb v ulong to void
n = get bnn 0
if lt n len bv
put bv n v
put bnn 0 add n 1
end
end

note pick t: a pool value of float type t (a new constant when there is none)
fn pick t ulong to ulong
n = get pn 0
k = ulong 0
while lt k 8 bound 8
if gt n 0
i = rn n
if eq get pt i t
ret get pv i
end
end
k = add k 1
end
i = ulong 0
while lt i n bound 4096
if eq get pt i t
ret get pv i
end
i = add i 1
end
v = fconst t
ret v
end

note fconst t: a new f32/f64 constant (half edge table, half random bits), added to the pool
fn fconst t ulong to ulong
b = rnd
if eq rn 2 0
if eq t 14
b = get e64 rn len e64
else
b = get e32 rn len e32
end
end
v = kconst t b
addf v t 0
ret v
end

fn rint to ulong
k = rn 8
if eq k 0
ret 2
end
if eq k 1
ret 3
end
if eq k 2
ret 4
end
if eq k 3
ret 5
end
if eq k 4
ret 6
end
if eq k 5
ret 7
end
if eq k 6
ret 8
end
ret 9
end

note iconst t: a new integer constant of type t (half edge table, half random bits), added to the pool
fn iconst t ulong to ulong
b = rnd
if eq rn 2 0
b = get ein rn len ein
end
v = kconst t b
addi v t
ret v
end

note pinty t: an integer pool value of type t (a new constant when there is none in eight tries)
fn pinty t ulong to ulong
n = get inn 0
k = ulong 0
while lt k 8 bound 8
if gt n 0
i = rn n
if eq get it i t
ret get iv i
end
end
k = add k 1
end
ret iconst t
end

note pint: an integer pool value (a new constant now and then)
fn pint to ulong
n = get inn 0
if or eq n 0 eq rn 4 0
v = iconst rint
ret sub get inn 0 1
end
ret rn n
end

fn ft to ulong
if eq rn 2 0
ret 13
end
ret 14
end

note ---- printing (each a call: the token moves on) ----
fn pr v ulong t ulong c ulong to void
if isf t
if eq c 0
x = v
if eq t 14
x = nv
ws y_bcast
wty 5
sp
wv v
nl
else
y = nv
ws y_bcast
wty 4
sp
wv v
nl
x = nv
ws y_conv
wty 5
sp
oc 48
sp
wv y
nl
end
pcall 0 x
ret
end
if eq t 14
pcall 1 v
else
pcall 2 v
end
ret
end
x = v
if ne t 5
x = nv
ws y_conv
wty 5
oc 32
oc 48
sp
wv v
nl
end
pcall 0 x
end

note pcall f v: call void @f0/@f1/@f2 with v
fn pcall f ulong v ulong to void
r = nv
ws y_call
ws y_void
wv get tk 0
if eq f 0
ws y_f0c
end
if eq f 1
ws y_f1c
end
if eq f 2
ws y_f2c
end
wv v
nl
put tk 0 r
end

note ---- random operations ----
fn obin to void
t = ft
a = pick t
b = pick t
k = rn 6
r = nv
wk y_bop k
sp
wty t
sp
wv a
sp
wv b
nl
addf r t 1
pr r t 1
end

fn ocmp t ulong a ulong b ulong k ulong to void
r = nv
wk y_cop k
sp
ws y_bool
wv a
sp
wv b
nl
addb r
z = nv
ws y_sel
wty 5
sp
wv r
sp
wv get ra 0
sp
wv get ra 1
nl
pcall 0 z
end

fn oun to void
t = ft
a = pick t
k = rn 3
r = nv
wk y_uop k
sp
wty t
sp
wv a
nl
c = ulong 0
if eq k 2
c = 1
end
addf r t c
pr r t c
end

fn ofma to void
t = ft
a = pick t
b = pick t
c = pick t
r = nv
ws y_fma
wty t
sp
wv a
sp
wv b
sp
wv c
nl
addf r t 1
pr r t 1
end

fn osel to void
t = ft
if eq get bnn 0 0
ocmp t pick t pick t rn 6
end
c = get bv rn get bnn 0
a = pick t
b = pick t
r = nv
ws y_sel
wty t
sp
wv c
sp
wv a
sp
wv b
nl
addf r t 0
pr r t 0
end

note conv to float type t from integer pool value i, imm m (0 nearest even, 1 toward zero)
fn oi2f t ulong i ulong m ulong to void
r = nv
ws y_conv
wty t
sp
wd m
sp
wv get iv i
nl
addf r t 0
pr r t 0
end

fn of2f a ulong s ulong m ulong to void
t = ulong 13
if eq s 13
t = 14
end
r = nv
ws y_conv
wty t
sp
wd m
sp
wv a
nl
addf r t 1
pr r t 1
end

fn of2i a ulong t ulong to void
r = nv
ws y_conv
wty t
sp
oc 48
sp
wv a
nl
addi r t
pr r t 0
end

fn obc to void
t = ft
if eq rn 2 0
a = pick t
d = ulong 5
if eq t 13
d = 4
end
if eq rn 2 0
d = add d 4
end
r = nv
ws y_bcast
wty d
sp
wv a
nl
addi r d
pr r d 0
ret
end
d = ulong 9
if eq t 13
d = 8
end
a = kconst d rnd
r = nv
ws y_bcast
wty t
sp
wv a
nl
addf r t 0
pr r t 0
end

note store then load an element of the f64 or f32 array (refs in fr 0 / ra), each access under its chk.bounds
fn omem to void
t = ft
a = pick t
x = kconst 5 rn 8
o = kconst 5 1
f = get fp 0
if eq t 13
f = get fp 1
end
c = nv
ws y_chkb
wv get tk 0
sp
wv f
sp
wv x
sp
wv o
nl
s = nv
ws y_store
wv c
sp
wv f
sp
wv x
sp
wv a
nl
put tk 0 s
c = nv
ws y_chkb
wv get tk 0
sp
wv f
sp
wv x
sp
wv o
nl
put tk 0 c
r = nv
ws y_load
wty t
sp
wv c
sp
wv f
sp
wv x
nl
addf r t 0
pr r t 0
end

note the signature of @f3: fpn parameter types in fp 2.., result type in fp 60; ocall puts arguments in fp 32..
fn sig to void
n = rn 21
put fpn 0 n
k = ulong 0
while lt k n bound 21
u = rn 3
t = ulong 14
if eq u 1
t = 13
end
if eq u 2
t = rint
end
put fp add k 2 t
k = add k 1
end
put fp 60 ft
end

fn ocall to void
n = get fpn 0
k = ulong 0
while lt k n bound 21
t = get fp add k 2
a = ulong 0
if isf t
if eq get fr 0 1
if eq t 14
a = kconst t or 0x3ff0000000000000 shl rn 1048576 32
else
a = kconst t or 0x3f800000 rn 1048576
end
else
a = pick t
end
else
a = pinty t
end
put fp add k 32 a
k = add k 1
end
t = get fp 60
r = get vn 0
put vn 0 add r 2
wv r
sp
wv add r 1
ws y_eq
ws y_call
wty t
sp
wv get tk 0
ws y_f3c
k = ulong 0
while lt k n bound 21
sp
wv get fp add k 32
k = add k 1
end
nl
put tk 0 r
addf add r 1 t 1
pr add r 1 t 1
r = get vn 0
put vn 0 add r 2
wv r
sp
wv add r 1
ws y_eq
ws y_call
wty 5
sp
wv get tk 0
ws y_f6c
k = ulong 0
while lt k n bound 21
sp
wv get fp add k 32
k = add k 1
end
nl
put tk 0 r
pr add r 1 5 0
end

note two-way branch: cbr on a compare; one side passes (a, b), the other (b, a) to the join block's parameters
fn odia to void
t = ft
a = pick t
b = pick t
b2 = pick t
k = rn 6
c = nv
wk y_cop k
sp
ws y_bool
wv a
sp
wv b2
nl
x = get bn 0
put bn 0 add x 3
ws y_cbr
wv get tk 0
sp
wv c
oc 32
oc 94
wd x
oc 32
oc 94
wd add x 1
nl
k = ulong 0
while lt k 2 bound 2
ws y_block
wd add x k
sp
q = get vn 0
put vn 0 add q 1
wv q
ws y_tok
nl
ws y_br
wd add x 2
sp
wv q
sp
if eq k 0
wv a
sp
wv b
else
wv b
sp
wv a
end
nl
k = add k 1
end
ws y_block
wd add x 2
sp
q = get vn 0
put vn 0 add q 3
wv q
ws y_tok
sp
wv add q 1
oc 58
wty t
sp
wv add q 2
oc 58
wty t
nl
put tk 0 q
addf add q 1 t 0
addf add q 2 t 0
pr add q 1 t 0
pr add q 2 t 0
end

fn oconv to void
k = rn 4
if eq k 0
oi2f ft pint rn 2
ret
end
if eq k 1
t = ft
m = rn 2
if eq t 14
m = rn 6
if ge m 2
m = add m 2
end
if ge m 6
m = 0
end
end
of2f pick t t m
ret
end
of2i pick ft rint
end

note chk.conv of pool value a (type s) into t: trap 5 when NaN or out of range, else nothing
fn ochk a ulong t ulong to void
c = nv
ws y_chkc
wty t
oc 32
oc 53
sp
wv get tk 0
sp
wv a
nl
put tk 0 c
end

note @f3 (random signature in fp): prints every parameter bit for bit (integers as u64), so each argument's bank,
note register and stack slot is checked; then acc = 0; acc = acc * 3 - p for each parameter (f32 and integers through
note conv to f64 first, nearest even); result acc or its f32. Its float parameters live across those calls
fn wf3 to void
ws y_fn3
n = get fpn 0
k = ulong 0
while lt k n bound 21
sp
wv add k 1
oc 58
wty get fp add k 2
k = add k 1
end
ws y_arrow
wty get fp 60
nl
ws y_block
oc 48
nl
put vn 0 add n 1
put tk 0 0
k = ulong 0
while lt k n bound 21
pr add k 1 get fp add k 2 0
k = add k 1
end
a = kconst 14 0
c = kconst 14 0x4008000000000000
k = ulong 0
while lt k n bound 21
t = get fp add k 2
p = add k 1
if ne t 14
p = nv
ws y_conv
wty 14
sp
oc 48
sp
wv add k 1
nl
end
m = nv
wk y_bop 2
sp
wty 14
sp
wv a
sp
wv c
nl
a = nv
wk y_bop 1
sp
wty 14
sp
wv m
sp
wv p
nl
k = add k 1
end
if eq get fp 60 13
r = nv
ws y_conv
wty 13
sp
oc 48
sp
wv a
nl
a = r
end
ws y_retv
wv get tk 0
sp
wv a
nl
ws y_end
end

fn hdr to void
ws y_hd
ws y_f0
ws y_f1
ws y_f2
wf3
ws y_ex4
put vn 0 1
put tk 0 0
put bn 0 1
r = get vn 0
oc 37
wd r
sp
wv add r 1
ws y_eq
ws y_alloca
ws y_t35
wv 0
nl
oc 37
wd add r 2
sp
wv add r 3
ws y_eq
ws y_alloca
ws y_t37
wv r
nl
put fp 0 add r 1
put fp 1 add r 3
put tk 0 add r 2
put vn 0 add r 4
put ra 0 kconst 5 1
put ra 1 kconst 5 0
end

note tail all: (all: print every pool value again, the random programs) then retv 0
fn tail all bool to void
n = get pn 0
if not all
n = 0
end
i = ulong 0
while lt i n bound 4096
pr get pv i get pt i get pc i
i = add i 1
end
r = kconst 8 0
ws y_retv
wv get tk 0
sp
wv r
nl
ws y_end
ws y_f5
wf6
end

note @f6: @f3's signature, a leaf returning u64: h = rotl(h, 7) xor the bits of each parameter in order (f64 and
note integers as u64, f32 through u32), so every argument bit reaches the result while the parameters stay in their
note argument registers (no call: caller-saved V registers, the LDR D path for stack parameters)
fn wf6 to void
ws y_fn6
n = get fpn 0
k = ulong 0
while lt k n bound 21
sp
wv add k 1
oc 58
wty get fp add k 2
k = add k 1
end
ws y_arrow
wty 5
nl
ws y_block
oc 48
nl
put vn 0 add n 1
h = kconst 5 0
s = kconst 5 7
k = ulong 0
while lt k n bound 21
t = get fp add k 2
b = add k 1
if eq t 14
b = nv
ws y_bcast
wty 5
sp
wv add k 1
nl
end
if eq t 13
y = nv
ws y_bcast
wty 4
sp
wv add k 1
nl
b = nv
ws y_conv
wty 5
sp
oc 48
sp
wv y
nl
end
if not isf t
if ne t 5
b = nv
ws y_conv
wty 5
sp
oc 48
sp
wv add k 1
nl
end
end
g = nv
ws y_rotl
wv h
sp
wv s
nl
h = nv
ws y_xor
wv g
sp
wv b
nl
k = add k 1
end
ws y_retv
oc 37
oc 48
sp
wv h
nl
ws y_end
end

fn gen to void
sig
hdr
c = add 4 rn 12
k = ulong 0
while lt k c bound 16
v = fconst ft
k = add k 1
end
n = add 20 rn 50
k = ulong 0
while lt k n bound 70
u = rn 15
if le u 2
obin
end
if eq u 3
oun
end
if eq u 4
ofma
end
if eq u 5
t = ft
ocmp t pick t pick t rn 6
end
if eq u 6
osel
end
if or eq u 7 eq u 8
oconv
end
if eq u 9
obc
end
if eq u 10
omem
end
if eq u 11
ocall
end
if eq u 12
odia
end
if eq u 13
v = iconst rint
oi2f ft sub get inn 0 1 rn 2
end
if eq u 14
orec
end
k = add k 1
end
if eq rn 4 0
ochk pick ft rint
end
tail true
end

note y_pt: the parameter types of @f3 in epress, one hex digit each (e f64, d f32, 2..9 the integers)
text y_pt "e5e8ed2e9e3ed6e4e5e7"
text y_f5c " @f5"

note orec: a call of @f5 (fixed text y_f5: recursive, depth 0..19, an f64 and an f32 of each frame live across its
note call: callee-saved V registers saved and restored at every depth) on pool values; its result printed canonical
fn orec to void
a = pick 14
b = pick 13
d = kconst 5 rn 20
r = get vn 0
put vn 0 add r 2
wv r
sp
wv add r 1
ws y_eq
ws y_call
wty 14
sp
wv get tk 0
ws y_f5c
sp
wv a
sp
wv d
sp
wv b
nl
put tk 0 r
addf add r 1 14 1
pr add r 1 14 1
end

note epress: edge 56, register pressure: @f3 takes 9 f64, 2 f32 and 9 integers (v0..v7 and x0..x7 full, three float
note and one integer stack argument) and returns f32; the 72 f32/f64 edge values stay live across 8 calls of @f3
note and 8 recursive calls of @f5, and are printed again at the end
fn epress to void
put fpn 0 20
put fr 0 1
k = ulong 0
while lt k 20 bound 20
c = ulong get y_pt k
t = sub c 48
if ge c 97
t = sub c 87
end
put fp add k 2 t
k = add k 1
end
put fp 60 13
hdr
epush 14
epush 13
k = ulong 0
while lt k 8 bound 8
ocall
orec
k = add k 1
end
tail true
end

note ---- edge programs ----
fn epush t ulong to void
n = len e64
if eq t 13
n = len e32
end
i = ulong 0
while lt i n bound 64
b = get e64 i
if eq t 13
b = get e32 i
end
v = kconst t b
addf v t 0
i = add i 1
end
end

note eb t: every binary op and compare over every ordered pair of the edge values of t
fn eb t ulong to void
epush t
n = get pn 0
i = ulong 0
while lt i n bound 64
j = ulong 0
while lt j n bound 64
a = get pv i
b = get pv j
k = ulong 0
while lt k 6 bound 6
r = nv
wk y_bop k
sp
wty t
sp
wv a
sp
wv b
nl
pr r t 1
k = add k 1
end
k = ulong 0
while lt k 6 bound 6
ocmp t a b k
k = add k 1
end
r = nv
ws y_fma
wty t
sp
wv a
sp
wv b
sp
wv get pv rem add i j n
nl
pr r t 1
j = add j 1
end
i = add i 1
end
end

note eu t: unary ops, conversions to every integer type and the other width in every mode, bitcasts
fn eu t ulong to void
epush t
n = get pn 0
i = ulong 0
while lt i n bound 64
a = get pv i
k = ulong 0
while lt k 3 bound 3
r = nv
wk y_uop k
sp
wty t
sp
wv a
nl
c = ulong 0
if eq k 2
c = 1
end
pr r t c
k = add k 1
end
k = ulong 2
while le k 9 bound 8
of2i a k
k = add k 1
end
if eq t 14
of2f a t 0
of2f a t 1
of2f a t 4
of2f a t 5
else
of2f a t 0
end
d = ulong 5
if eq t 13
d = 4
end
r = nv
ws y_bcast
wty d
sp
wv a
nl
pr r d 0
i = add i 1
end
end

note ei: integer edge values of every integer type to f32 and f64, nearest even and toward zero
fn ei to void
i = ulong 0
while lt i len ein bound 64
t = ulong 2
while le t 9 bound 8
v = kconst t get ein i
addi v t
x = sub get inn 0 1
oi2f 14 x 0
oi2f 14 x 1
oi2f 13 x 0
oi2f 13 x 1
t = add t 1
end
i = add i 1
end
end

note ec t: chk.conv of the edge values of t that pass into each integer type (ngrun decides the trap: only the
note passing ones are emitted, by the rule of IR.md s7.9 computed here on the bits)
fn ec t ulong to void
epush t
n = get pn 0
i = ulong 0
while lt i n bound 64
k = ulong 2
while le k 9 bound 8
if cpass t get e64 i k
if eq t 14
ochk get pv i k
of2i get pv i k
end
end
if eq t 13
if cpass32 get e32 i k
ochk get pv i k
of2i get pv i k
end
end
k = add k 1
end
i = add i 1
end
end

note cpass t b k: f64 bits b (t 14) pass chk.conv into integer type k: not NaN and the truncated value inside;
note decided from the exponent, conservatively (a value whose integer part needs the type's width plus one bit,
note or any NaN or infinity, is treated as failing and skipped)
fn cpass t ulong b ulong k ulong to bool
e = and shr b 52 2047
s = ne shr b 63 0
if eq e 2047
ret false
end
if lt e 1023
ret true
end
p = sub e 1023
w = wid k
if sgn k
ret lt p sub w 1
end
if s
ret false
end
ret lt p w
end

fn cpass32 b ulong k ulong to bool
e = and shr b 23 255
s = ne shr b 31 0
if eq e 255
ret false
end
if lt e 127
ret true
end
p = sub e 127
w = wid k
if sgn k
ret lt p sub w 1
end
if s
ret false
end
ret lt p w
end

fn edge k ulong to void
if eq k 56
epress
ret
end
put fpn 0 0
put fp 60 14
hdr
if eq k 1
eb 14
end
if eq k 2
eb 13
end
if eq k 3
eu 14
end
if eq k 4
eu 13
end
if eq k 5
ei
end
if eq k 6
ec 14
end
if eq k 7
ec 13
end
if ge k 8
eb8 sub k 8
end
tail false
end

note eb8 j: the chk.conv boundary program j (edge 8 + j): integer type 2 + j mod 8, source f32 (j / 8 even) or f64,
note case j / 16; the value just inside the upper bound and the one just inside the lower bound pass and convert,
note then the upper bound (case 0), the lower trap value (1) or a quiet NaN (2) traps 5
fn eb8 j ulong to void
k = add 2 rem j 8
t = ulong 14
if eq rem div j 8 2 0
t = 13
end
c = div j 16
a = kconst t sub ebd t k 0 1
ochk a k
of2i a k
a = kconst t ebd t k 2
ochk a k
of2i a k
x = ebd t k 0
if eq c 1
x = ebd t k 1
end
if eq c 2
x = 0x7ff8000000000000
if eq t 13
x = 0x7fc00000
end
end
a = kconst t x
ochk a k
end

note ebd t k q: bits of float type t (p fraction bits, exponent bias b) for chk.conv into integer type k: q 0 the
note upper bound 2^w (unsigned) or 2^(w-1); q 1 the low trap value -1 (unsigned), -(2^(w-1) + 1) when representable,
note else the next value below -2^(w-1); q 2 its neighbour toward zero, which passes
fn ebd t ulong k ulong q ulong to ulong
p = ulong 52
b = ulong 1023
sg = ulong 0x8000000000000000
if eq t 13
p = 23
b = 127
sg = 0x80000000
end
m = wid k
if sgn k
m = sub m 1
end
if eq q 0
ret shl add b m p
end
lo = or sg shl b p
if sgn k
if le m p
lo = or or sg shl add b m p shl ulong 1 sub p m
else
lo = add or sg shl add b m p 1
if eq q 2
ret sub lo 1
end
ret lo
end
end
if eq q 1
ret lo
end
ret sub lo 1
end

fn arg a ulong to ulong
m = argread a y_pa 0 4096
if or le m 0 ge m 4096
r = write 2 y_use 0 len y_use
exit 2
end
ret ulong m
end

fn dec m ulong to ulong
v = ulong 0
for j ulong m bound 4096
c = ulong get y_pa j
if or lt c 48 gt c 57
r = write 2 y_use 0 len y_use
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end

fn main to int
ini
if eq argcnt 3
m = arg 1
if ne m len y_edge
r = write 2 y_use 0 len y_use
ret 2
end
for j ulong m bound 8
if ne get y_pa j get y_edge j
r = write 2 y_use 0 len y_use
ret 2
end
end
k = dec arg 2
if or lt k 1 gt k 56
r = write 2 y_use 0 len y_use
ret 2
end
put rs 0 k
edge k
else
if ne argcnt 2
r = write 2 y_use 0 len y_use
ret 2
end
s = dec arg 1
put rs 0 s
gen
end
if not flush
r = write 2 y_io 0 len y_io
ret 1
end
ret 0
end

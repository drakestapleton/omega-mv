@ng a64-enc
; Encoder cases for seed/ng/a64/gate.om. One case per line: FORM operands | expected disassembly.
; The expected text is written by hand from Arm ARM DDI 0487 M.d (encoding diagram and preferred
; disassembly alias of each form); GNU objdump is the referee that must print the same text.
; Comparison: blanks collapsed, objdump's trailing `// ...` comment dropped, `@+N` / `@-N` means the case's own
; address plus / minus N bytes. Operands: decimal, -decimal (two's complement) or lowercase 0x hex.
; ---- shifted register ----
addx 1 2 3 | add x1, x2, x3
addx 1 2 3 0 4 | add x1, x2, x3, lsl #4
addx 9 10 11 2 63 | add x9, x10, x11, asr #63
addw 1 2 3 | add w1, w2, w3
subx 1 2 3 | sub x1, x2, x3
subx 1 31 3 | neg x1, x3
subw 4 5 6 1 3 | sub w4, w5, w6, lsr #3
addsx 1 2 3 | adds x1, x2, x3
addsx 31 2 3 | cmn x2, x3
addsw 1 2 3 | adds w1, w2, w3
subsx 1 2 3 | subs x1, x2, x3
subsx 31 2 3 | cmp x2, x3
subsx 31 16 0 2 63 | cmp x16, x0, asr #63
subsw 31 2 3 | cmp w2, w3
andx 1 2 3 | and x1, x2, x3
andw 1 2 3 | and w1, w2, w3
orrx 1 2 3 | orr x1, x2, x3
orrx 1 31 3 | mov x1, x3
orrw 1 31 3 | mov w1, w3
eorx 1 2 3 | eor x1, x2, x3
eorw 1 2 3 | eor w1, w2, w3
andsx 1 2 3 | ands x1, x2, x3
andsx 31 2 3 | tst x2, x3
bicx 1 2 3 | bic x1, x2, x3
ornx 1 31 3 | mvn x1, x3
; ---- multiply, divide, variable shift ----
mulx 1 2 3 | mul x1, x2, x3
mulw 1 2 3 | mul w1, w2, w3
smulh 1 2 3 | smulh x1, x2, x3
umulh 1 2 3 | umulh x1, x2, x3
sdivx 1 2 3 | sdiv x1, x2, x3
udivx 1 2 3 | udiv x1, x2, x3
sdivw 1 2 3 | sdiv w1, w2, w3
udivw 1 2 3 | udiv w1, w2, w3
lslvx 1 2 3 | lsl x1, x2, x3
lsrvx 1 2 3 | lsr x1, x2, x3
asrvx 1 2 3 | asr x1, x2, x3
rorvx 1 2 3 | ror x1, x2, x3
lslvw 1 2 3 | lsl w1, w2, w3
lsrvw 1 2 3 | lsr w1, w2, w3
asrvw 1 2 3 | asr w1, w2, w3
maddx 1 2 3 4 | madd x1, x2, x3, x4
msubx 1 2 3 4 | msub x1, x2, x3, x4
; ---- extended register ----
addxe 1 2 3 6 0 | add x1, x2, w3, sxtw
subsxe 31 2 3 6 0 | cmp x2, w3, sxtw
subsxe 31 2 3 4 0 | cmp x2, w3, sxtb
subsxe 31 2 3 5 0 | cmp x2, w3, sxth
; ---- immediate ----
addxi 1 2 4095 0 | add x1, x2, #0xfff
addxi 1 2 1 1 | add x1, x2, #0x1, lsl #12
addxi 31 16 0 0 | mov sp, x16
addxi 27 31 0 0 | mov x27, sp
addwi 1 2 5 0 | add w1, w2, #0x5
subxi 1 2 16 0 | sub x1, x2, #0x10
subxi 31 31 32 0 | sub sp, sp, #0x20
subwi 1 2 16 0 | sub w1, w2, #0x10
addsxi 1 2 3 0 | adds x1, x2, #0x3
addsxi 31 2 1 0 | cmn x2, #0x1
subsxi 31 2 9 0 | cmp x2, #0x9
subsxi 1 2 9 0 | subs x1, x2, #0x9
subswi 31 2 9 0 | cmp w2, #0x9
addswi 1 2 3 0 | adds w1, w2, #0x3
; ---- logical immediate (bitmask) ----
andxi 1 2 0xff | and x1, x2, #0xff
andxi 1 2 0xff00ff00ff00ff00 | and x1, x2, #0xff00ff00ff00ff00
andxi 1 2 0x5555555555555555 | and x1, x2, #0x5555555555555555
andxi 1 2 0x8000000000000000 | and x1, x2, #0x8000000000000000
andxi 1 2 0xfffffffffffffffe | and x1, x2, #0xfffffffffffffffe
andxi 1 2 0x7ffffffffffffff0 | and x1, x2, #0x7ffffffffffffff0
orrxi 1 2 0xf0 | orr x1, x2, #0xf0
orrxi 1 31 0xffff0000ffff0000 | mov x1, #0xffff0000ffff0000
eorxi 1 2 0x1 | eor x1, x2, #0x1
andsxi 31 2 0x1 | tst x2, #0x1
andwi 1 2 0xff | and w1, w2, #0xff
orrwi 1 2 0xf0f0f0f0 | orr w1, w2, #0xf0f0f0f0
eorwi 1 2 0x80000000 | eor w1, w2, #0x80000000
; ---- move wide ----
movzx 1 5 0 | mov x1, #0x5
movzx 28 0x1000 1 | mov x28, #0x10000000
movzx 1 0x1234 3 | mov x1, #0x1234000000000000
movnx 1 0 0 | mov x1, #0xffffffffffffffff
movnx 1 5 0 | mov x1, #0xfffffffffffffffa
movkx 1 0x1234 2 | movk x1, #0x1234, lsl #32
movzw 1 7 0 | mov w1, #0x7
movnw 1 0 0 | mov w1, #0xffffffff
; ---- bitfield, extract ----
ubfmx 1 2 1 63 | lsr x1, x2, #1
ubfmx 1 2 60 59 | lsl x1, x2, #4
ubfmx 1 2 0 7 | ubfx x1, x2, #0, #8
sbfmx 1 2 0 31 | sxtw x1, w2
sbfmx 1 2 63 63 | asr x1, x2, #63
sbfmx 1 2 0 7 | sxtb x1, w2
sbfmx 1 2 0 15 | sxth x1, w2
ubfmw 1 2 0 7 | uxtb w1, w2
ubfmw 1 2 0 15 | uxth w1, w2
sbfmw 1 2 0 7 | sxtb w1, w2
extrx 1 2 3 8 | extr x1, x2, x3, #8
extrx 1 2 2 8 | ror x1, x2, #8
; ---- conditional select ----
cselx 1 2 3 0 | csel x1, x2, x3, eq
csincx 1 31 31 1 | cset x1, eq
csincx 1 2 2 0 | cinc x1, x2, ne
csincx 1 2 3 11 | csinc x1, x2, x3, lt
csinvx 1 31 31 0 | csetm x1, ne
csnegx 1 2 2 10 | cneg x1, x2, lt
csnegx 1 2 3 0 | csneg x1, x2, x3, eq
; ---- loads and stores, unsigned offset (offset operand in access-size units) ----
strb 1 2 3 | strb w1, [x2, #3]
strb 1 2 0 | strb w1, [x2]
ldrb 1 2 4095 | ldrb w1, [x2, #4095]
ldrsbx 1 2 1 | ldrsb x1, [x2, #1]
strh 1 2 1 | strh w1, [x2, #2]
ldrh 1 2 2 | ldrh w1, [x2, #4]
ldrshx 1 2 1 | ldrsh x1, [x2, #2]
strw 1 2 1 | str w1, [x2, #4]
ldrw 1 2 1 | ldr w1, [x2, #4]
ldrsw 1 2 1 | ldrsw x1, [x2, #4]
strx 30 31 3 | str x30, [sp, #24]
ldrx 1 2 4095 | ldr x1, [x2, #32760]
strs 1 2 1 | str s1, [x2, #4]
ldrs 1 2 1 | ldr s1, [x2, #4]
strd 16 31 1 | str d16, [sp, #8]
ldrd 1 2 0 | ldr d1, [x2]
; ---- loads and stores, register offset (s 1 = scaled by the access size) ----
strbr 1 2 3 0 | strb w1, [x2, x3]
ldrbr 1 2 3 0 | ldrb w1, [x2, x3]
ldrsbxr 1 2 3 0 | ldrsb x1, [x2, x3]
strhr 1 2 3 1 | strh w1, [x2, x3, lsl #1]
ldrhr 1 2 3 1 | ldrh w1, [x2, x3, lsl #1]
ldrshxr 1 2 3 1 | ldrsh x1, [x2, x3, lsl #1]
strwr 1 2 3 1 | str w1, [x2, x3, lsl #2]
ldrwr 1 2 3 0 | ldr w1, [x2, x3]
ldrswr 1 2 3 1 | ldrsw x1, [x2, x3, lsl #2]
strxr 1 2 3 1 | str x1, [x2, x3, lsl #3]
ldrxr 1 2 3 1 | ldr x1, [x2, x3, lsl #3]
strsr 1 2 3 1 | str s1, [x2, x3, lsl #2]
ldrsr 1 2 3 0 | ldr s1, [x2, x3]
strdr 1 2 3 1 | str d1, [x2, x3, lsl #3]
ldrdr 1 2 3 0 | ldr d1, [x2, x3]
; ---- pairs (signed byte offset) ----
stpx 29 30 31 -16 | stp x29, x30, [sp, #-16]
ldpx 19 20 31 16 | ldp x19, x20, [sp, #16]
stpxpre 29 30 31 -32 | stp x29, x30, [sp, #-32]!
ldpxpre 1 2 3 8 | ldp x1, x2, [x3, #8]!
stpxpost 1 2 3 16 | stp x1, x2, [x3], #16
ldpxpost 29 30 31 32 | ldp x29, x30, [sp], #32
stpd 8 9 31 504 | stp d8, d9, [sp, #504]
ldpd 8 9 31 -512 | ldp d8, d9, [sp, #-512]
; ---- branches (distances in words; ADR in bytes) ----
b 3 | b @+12
b -1 | b @-4
bl 2 | bl @+8
bcond 6 5 | b.vs @+20
bcond 0 1 | b.eq @+4
bcond 1 1 | b.ne @+4
bcond 8 -3 | b.hi @-12
bcond 11 2 | b.lt @+8
cbzx 1 4 | cbz x1, @+16
cbnzx 1 -2 | cbnz x1, @-8
cbzw 1 1 | cbz w1, @+4
cbnzw 1 1 | cbnz w1, @+4
tbz 1 3 2 | tbz w1, #3, @+8
tbz 1 40 2 | tbz x1, #40, @+8
tbnz 1 63 -1 | tbnz x1, #63, @-4
ret 30 | ret
ret 1 | ret x1
br 16 | br x16
blr 16 | blr x16
svc 0 | svc #0x0
adr 1 8 | adr x1, @+8
adr 1 -4 | adr x1, @-4
; ---- scalar floating point ----
faddd 1 2 3 | fadd d1, d2, d3
fsubd 1 2 3 | fsub d1, d2, d3
fmuld 1 2 3 | fmul d1, d2, d3
fdivd 1 2 3 | fdiv d1, d2, d3
fmaxd 1 2 3 | fmax d1, d2, d3
fmind 1 2 3 | fmin d1, d2, d3
fmaxnmd 1 2 3 | fmaxnm d1, d2, d3
fminnmd 1 2 3 | fminnm d1, d2, d3
fadds 1 2 3 | fadd s1, s2, s3
fsubs 1 2 3 | fsub s1, s2, s3
fmuls 1 2 3 | fmul s1, s2, s3
fdivs 1 2 3 | fdiv s1, s2, s3
fmaxs 1 2 3 | fmax s1, s2, s3
fmins 1 2 3 | fmin s1, s2, s3
fmaxnms 1 2 3 | fmaxnm s1, s2, s3
fminnms 1 2 3 | fminnm s1, s2, s3
fsqrtd 1 2 | fsqrt d1, d2
fabsd 1 2 | fabs d1, d2
fnegd 1 2 | fneg d1, d2
fmovd 1 2 | fmov d1, d2
fsqrts 1 2 | fsqrt s1, s2
fabss 1 2 | fabs s1, s2
fnegs 1 2 | fneg s1, s2
fmovs 1 2 | fmov s1, s2
fcmpd 1 2 | fcmp d1, d2
fcmps 1 2 | fcmp s1, s2
fmaddd 1 2 3 4 | fmadd d1, d2, d3, d4
fmadds 1 2 3 4 | fmadd s1, s2, s3, s4
fcvtds 1 2 | fcvt d1, s2
fcvtsd 1 2 | fcvt s1, d2
fmovxd 1 2 | fmov x1, d2
fmovdx 1 2 | fmov d1, x2
fmovws 1 2 | fmov w1, s2
fmovsw 1 2 | fmov s1, w2
scvtfdx 1 2 | scvtf d1, x2
ucvtfdx 1 2 | ucvtf d1, x2
scvtfsx 1 2 | scvtf s1, x2
ucvtfsx 1 2 | ucvtf s1, x2
fcvtzsxd 1 2 | fcvtzs x1, d2
fcvtzuxd 1 2 | fcvtzu x1, d2
fcvtzsxs 1 2 | fcvtzs x1, s2
fcvtzuxs 1 2 | fcvtzu x1, s2

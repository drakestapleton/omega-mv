note Native environment slice and refusal regression.
note Exercise exact slices and refusal atomicity without printing process environment contents.
global ea uchar 2054
global eb uchar 2054
fn main to int
n = ulong envcnt
for i ulong n
for j ulong len ea
put ea j 90
put eb j 77
end
k = envread i ea 3 2048
if eq k -105
for j ulong len ea
if ne get ea j 90
ret 100
end
end
continue
end
if lt k 0
ret 101
end
z = ulong k
if or ne get ea 2 90 ne get ea add 3 z 90
ret 102
end
q = envread i eb 2 z
if ne q k
ret 103
end
if or ne get eb 1 77 ne get eb add 2 z 77
ret 104
end
for j ulong z
if ne get ea add 3 j get eb add 2 j
ret 105
end
end
if gt z 0
for j ulong len eb
put eb j 77
end
q = envread i eb 2 sub z 1
if ne q -105
ret 106
end
for j ulong len eb
if ne get eb j 77
ret 107
end
end
end
end
ret int and n 63
end

note rgate.om: the ng-a64 back-end gate (allocator and full pipeline). Run from the omega-mv root:
note seed/out/omc < seed/ng/a64/rgate.om > rgate && ./rgate, with stdin one line naming an existing scratch directory.
note 1. Build mkir (seed/ng/src/ir.om + seed/ng/a64/tests/mkir.om), ngcheck (seed/ng/sha256.om + seed/ng/ngcheck.om,
note    ng-ir's witness) and ng (the units of seed/ng/ng.units, in order; their sha256s are ngbuild's check) with
note    seed/out/omc.
note 2. For each fixture N of mkir: mkir writes its ΩIR, which ngcheck must accept (exit 0); ng compiles it with
note    `@ng a64` (save pairs) and with `@ng a64 split` (separate saves); each ELF runs. The omc build of
note    seed/ng/a64/tests/ref/N.om runs. Both ng statuses must equal the fixture's expected status (fixed below:
note    computed independently with Wolfram, or the trap code of the fixture's check) and omc's status its omc
note    expectation: the same, except tsum, where omc traps 6 (106) a million calls deep and ng's E loop shape has no
note    recursion (BEYOND_OMC, IR.md s7.9 and D9: trap 6 is compared only when both trap). tsum's 32 is the Omega
note    value of `int and ts 1000000 255` (Wolfram: ts(1000000) = 500000500000, low byte 32); without the & 255,
note    `int` would trap 5. The stdout of the split
note    run and of omc's run must equal the pairs run's byte for byte (bcopy writes 65536 bytes, sort four lines).
note 3. Every BL target in each `@ng a64` ELF must be a multiple of 64 (function entries aligned, D13).
note 4. Mutants of seed/ng/src/a64.om, each one equal-length text change that must occur exactly once; ng is rebuilt
note    with it and every fixture runs with `@ng a64`. A mutant is caught when some fixture's status differs (or ng
note    refuses, or the program is killed after 30 s) or a BL target is misaligned. Every mutant must be caught:
note    1 spill reload reads the next slot      2 values crossing a call may take caller-saved registers
note    3 live-out values end at the block start  4 parallel moves ignore pending reads (block-argument cycles)
note    5 callee-saved registers are never saved  6 frame of 4 bytes per slot (slots overlap the saves)
note    7 function entries aligned to 16 bytes, not 64
note    8 the E loop shape never matches (tsum recurses and traps 6)  9 the E tail site adds acc to itself, not a
note    10 chk.bounds compares i with len, not len - e (oob stores past g)  11 alloca zero-fills half its area (zf)
note    12 write passes off as the count (mem)  13 u64 loads read one byte (mem)  14 a frame above 4095 bytes drops
note    its LSL 12 part (the zero fill runs over the globals: mem)  15 i8 loads zero-extend (wid)
note    16 the allocator hands out x15, the scratch of the checked ops (lv: v_14 sits in x15 across chk.add)
note Output: one line per fixture and per mutant, then PASS or FAIL. Exit 0 PASS, 1 FAIL, 2 a step could not run.
om2

global mem uchar 16777216
global pb uchar 4096
global pn ulong 1
global sd uchar 1024
global sn ulong 1
global av uchar 4096
global ap ulong 2
global stb uchar 4
global ob uchar 65536
global on ulong 1
global ex ulong 16
global eo ulong 16
global rg ulong 4

note regions of mem: sources [0, 8 MiB), ΩIR [8, 12), ELF [12, 14), units [14, 15), stdin [15, 16)
const rir ulong 8388608
const relf ulong 12582912
const runit ulong 14680064
const rin ulong 15728640

text tx "seed/out/omc\nseed/ng/ng.units\nseed/ng/src/ir.om\nseed/ng/a64/tests/mkir.om\nseed/ng/a64/tests/ref/\n.om\n/ng.om\n/ng.bin\n/mkir.om\n/mkir.bin\n/fx.name\n/fx.ir\n/fx.in\n/fx.elf\n/ref.bin\n/run.out\n/run.err\nseed/ng/src/a64.om\n@ng a64\n@ng a64 split\n/build.err\nseed/ng/sha256.om\nseed/ng/ngcheck.om\n/ngcheck.om\n/ngcheck.bin\n"
text tfx "fib\ndeep\npress\nrot\nck\nar\ntsum\nmem\noob\nzf\nwid\nbcopy\nsort\nlv\n"
text tmp "a6_ew a_ldrx s 31 sub get a_vsl w 1 0 0\nx = ne get a_vx w 0\nget a_lout add mul x lw i get a_ben x\nif not a6_isrc d\nif ge r 19\nf = mul 8 add get a_fs 4 n\nwhile ne and get a_cn 0 63 0 bound 16\nif ne get i_oop m 10\na6_tsum l a\na6_cmpk i sub l e\na6_movi 17 shr get a_asz k 4\na6_mvadd 2 a6_loc a6_arg o 4\nret a_ldrxr\na6_ew a_subxi 31 31 h 1 0\nconst a_lsbx ulong 82\nwhile lt r 15 bound 15\n"
text tmr "a6_ew a_ldrx s 31 add get a_vsl w 0 0 0\nx = eq get a_vx w 9\nget a_lout add mul x lw i get a_bst x\nif not a6_isrc 0\nif ge r 99\nf = mul 4 add get a_fs 4 n\nwhile ne and get a_cn 0 15 0 bound 16\nif ne get i_oop m 99\na6_tsum l l\na6_cmpk i sub l 0\na6_movi 17 shr get a_asz k 5\na6_mvadd 2 a6_loc a6_arg o 3\nret a_ldrbr\na6_ew a_subxi 31 31 h 0 0\nconst a_lsbx ulong 81\nwhile lt r 16 bound 16\n"
text tmsg "a64 rgate: fixture\npairs\nsplit\nomc\nexpected\nmutant\ncaught\nMISSED\nPASS\nFAIL\ncannot run step\nfixtures ok\nmutants caught\nngcheck\nmisaligned\nomc-expected\nstdout-same\n"

const nfx ulong 14
const nmut ulong 16

note ---- text lines: line k of text t (0 tx, 1 tfx, 2 tmp, 3 tmr, 4 tmsg) ----
fn tlen t ulong to ulong
if eq t 0
ret len tx
end
if eq t 1
ret len tfx
end
if eq t 2
ret len tmp
end
if eq t 3
ret len tmr
end
ret len tmsg
end

fn tch t ulong i ulong to ulong
if eq t 0
ret ulong get tx i
end
if eq t 1
ret ulong get tfx i
end
if eq t 2
ret ulong get tmp i
end
if eq t 3
ret ulong get tmr i
end
ret ulong get tmsg i
end

note tline t k: start of line k of text t (lines end with a newline)
fn tline t ulong k ulong to ulong
i = ulong 0
j = ulong 0
while lt j k bound 64
while ne tch t i 10 bound 4096
i = add i 1
end
i = add i 1
j = add j 1
end
ret i
end

fn tend t ulong i ulong to ulong
e = i
while ne tch t e 10 bound 4096
e = add e 1
end
ret e
end

note ---- output ----
fn oput b ulong to void
n = get on 0
if lt n len ob
put ob n uchar b
put on 0 add n 1
end
end

fn oflush to void
n = get on 0
p = ulong 0
while lt p n bound 65536
k = write 1 ob p sub n p
if le k 0
p = n
else
p = add p ulong k
end
end
put on 0 0
end

fn otl t ulong k ulong to void
i = tline t k
e = tend t i
while lt i e bound 4096
oput tch t i
i = add i 1
end
end

fn omsg k ulong to void
otl 4 k
end

fn odec v ulong to void
d = ulong 1
while ge div v d 10 bound 20
d = mul d 10
end
x = v
while gt d 0 bound 20
oput add 48 div x d
x = rem x d
d = div d 10
end
end

fn okv k ulong v ulong to void
oput 32
omsg k
oput 32
odec v
end

fn fail k ulong to void
omsg 10
oput 32
odec k
oput 10
omsg 9
oput 10
oflush
exit 2
end

note ---- paths in pb ----
fn pclr to void
put pn 0 0
end

fn pb1 b ulong to void
n = get pn 0
if ge n len pb
fail 0
end
put pb n uchar b
put pn 0 add n 1
end

fn ptl t ulong k ulong to void
i = tline t k
e = tend t i
while lt i e bound 4096
pb1 tch t i
i = add i 1
end
end

fn pset k ulong to void
pclr
ptl 0 k
end

fn pscr k ulong to void
pclr
i = ulong 0
while lt i get sn 0 bound 1024
pb1 ulong get sd i
i = add i 1
end
ptl 0 k
end

note pref f: pb = seed/ng/a64/tests/ref/<fixture f>.om
fn pref f ulong to void
pset 4
ptl 1 f
ptl 0 5
end

note ---- files ----
fn openr to int
r = fopen pb 0 get pn 0 0 0
if lt r 0
fail 1
end
ret int r
end

note openw md: create or truncate pb for writing with mode md (O_WRONLY|O_CREAT|O_TRUNC = 577)
fn openw md int to int
r = fopen pb 0 get pn 0 577 md
if lt r 0
fail 2
end
ret int r
end

fn fclo fd int to void
r = fclose fd
end

note readin o c: all of file pb into mem at offset o (capacity c bytes); returns the byte count
fn readin o ulong c ulong to ulong
fd = openr
n = ulong 0
go = true
while go bound 1000000
if ge n c
fail 3
end
k = read fd mem add o n sub c n
if lt k 0
fail 3
end
if eq k 0
go = false
else
n = add n ulong k
end
end
fclo fd
ret n
end

fn wall fd int o ulong n ulong to void
p = ulong 0
while lt p n bound 1000000
k = write fd mem add o p sub n p
if le k 0
fail 4
end
p = add p ulong k
end
end

note wtl fd t k: line k of text t and a newline to fd (staged at mem[rin])
fn wtl fd int t ulong k ulong to void
i = tline t k
e = tend t i
n = ulong 0
while le add i n e bound 4096
put mem add rin n uchar tch t add i n
n = add n 1
end
wall fd rin n
end

note ---- children: av = u16 count, then per argument u16 length and its bytes ----
fn aclr to void
put ap 0 2
put ap 1 0
end

fn apb to void
n = get pn 0
p = get ap 0
if gt add add p n 2 len av
fail 5
end
put av p uchar and n 255
put av add p 1 uchar shr n 8
i = ulong 0
while lt i n bound 4096
put av add add p 2 i get pb i
i = add i 1
end
put ap 0 add add p 2 n
put ap 1 add get ap 1 1
end

fn redir s int d int to void
if ne s d
if ne dupfd s d 0 long d
exit 127
end
end
end

note spawn fi fo fe: run av with stdin, stdout, stderr fi, fo, fe; returns the exit status, 256 + signal, and kills
note the child (status 265) when it runs longer than 30 s
fn spawn fi int fo int fe int to ulong
put av 0 uchar and get ap 1 255
put av 1 uchar shr get ap 1 8
pid = fork
if lt pid 0
fail 6
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog av 0 get ap 0
exit 127
end
fclo fi
fclo fo
fclo fe
ret reap pid
end

fn reap pid long to ulong
t0 = monons
while true bound 1000000
r = waitpid int pid stb 0 len stb 1
if eq r pid
ret wstat
end
if ne r 0
fail 7
end
if gt sub monons t0 30000000000
k = killpid int pid 9
end
s = sleepns 1000000
end
fail 7
ret 0
end

fn wstat to ulong
sg = and ulong get stb 0 127
if ne sg 0
ret add 256 sg
end
ret ulong get stb 1
end

note ---- building ----
note unitpath p q: pb = the path of the ng.units line mem[p, q) (`HEX PATH`, 64 hex digits and one space)
fn unitpath p ulong q ulong to void
if or le q add p 65 ne get mem add p 64 32
fail 17
end
pclr
i = add p 65
while lt i q bound 4096
pb1 ulong get mem i
i = add i 1
end
end

fn isa64 to bool
i = tline 0 17
e = tend 0 i
if ne get pn 0 sub e i
ret false
end
j = ulong 0
while lt j sub e i bound 64
if ne ulong get pb j tch 0 add i j
ret false
end
j = add j 1
end
ret true
end

note mkmut o n m: replace the one occurrence of mutant line m of tmp in mem[o, o+n) by line m of tmr
fn mkmut o ulong n ulong m ulong to void
p = tline 2 m
pl = sub tend 2 p p
r = tline 3 m
if ne pl sub tend 3 r r
fail 8
end
hits = ulong 0
hit = ulong 0
i = o
while le add i pl add o n bound 4194304
if samepat i p pl
hits = add hits 1
hit = i
end
i = add i 1
end
if ne hits 1
fail 8
end
j = ulong 0
while lt j pl bound 128
put mem add hit j uchar tch 3 add r j
j = add j 1
end
end

fn samepat i ulong p ulong pl ulong to bool
j = ulong 0
while lt j pl bound 128
if ne ulong get mem add i j tch 2 add p j
ret false
end
j = add j 1
end
ret true
end

note srcng m: the units of ng.units concatenated at mem[0); mutant m (1..) applied to a64.om, 0 none; the length
fn srcng m ulong to ulong
pset 1
nu = readin runit 1048576
s = ulong 0
p = runit
e = add runit nu
hit = ulong 0
while lt p e bound 128
q = untilnl p e
unitpath p q
k = readin s sub rir s
if and gt m 0 isa64
mkmut s k sub m 1
hit = add hit 1
end
s = add s k
p = add q 1
end
if and gt m 0 ne hit 1
fail 8
end
ret s
end

fn untilnl p ulong e ulong to ulong
q = p
while lt q e bound 4096
if eq get mem q 10
ret q
end
q = add q 1
end
ret q
end

note compile mem[0, n) with omc: scratch text s (source) -> scratch text b (binary); omc must succeed
fn omcb n ulong s ulong b ulong to void
pscr s
fd = openw 420
wall fd 0 n
fclo fd
pscr s
fi = openr
pscr b
fo = openw 493
pscr 20
fe = openw 420
aclr
pset 0
apb
if ne spawn fi fo fe 0
fail 9
end
end

fn buildng m ulong to void
omcb srcng m 6 7
end

fn buildmk to void
pset 2
n = readin 0 rir
pset 3
n = add n readin n sub rir n
omcb n 8 9
end

fn buildck to void
pset 21
n = readin 0 rir
pset 22
n = add n readin n sub rir n
omcb n 23 24
end

note runck: ngcheck.bin < fx.ir; its exit status (0 accept, else the refusal class)
fn runck to ulong
pscr 11
fi = openr
pscr 15
fo = openw 420
pscr 16
fe = openw 420
aclr
pscr 24
apb
ret spawn fi fo fe
end

note ---- running a fixture ----
note mkfx f: scratch/fx.name = fixture f's name; mkir.bin < fx.name > fx.ir; returns the ΩIR byte count (at rir)
fn mkfx f ulong to ulong
pscr 10
fd = openw 420
wtl fd 1 f
fclo fd
pscr 10
fi = openr
pscr 11
fo = openw 420
pscr 16
fe = openw 420
aclr
pscr 9
apb
if ne spawn fi fo fe 0
fail 11
end
pscr 11
ret readin rir 4194304
end

note runng n md: fx.in = mode line md (18 pairs, 19 split) + the ΩIR at rir (n bytes); ng.bin < fx.in > fx.elf;
note returns the program's status, or 1000 + ng's exit status when ng refuses
fn runng n ulong md ulong to ulong
pscr 12
fd = openw 420
wtl fd 0 md
wall fd rir n
fclo fd
pscr 12
fi = openr
pscr 13
fo = openw 493
pscr 16
fe = openw 420
aclr
pscr 7
apb
c = spawn fi fo fe
if ne c 0
ret add 1000 c
end
ret runbin 13
end

note runbin k: run scratch text k with stdin fx.name, stdout run.out, stderr run.err; its status
fn runbin k ulong to ulong
pscr 10
fi = openr
pscr 15
fo = openw 420
pscr 16
fe = openw 420
aclr
pscr k
apb
ret spawn fi fo fe
end

fn runref f ulong to ulong
pref f
n = readin 0 rir
omcb n 8 14
ret runbin 14
end

note ---- main ----
fn rdscr to void
pclr
n = read 0 mem rin 4096
if le n 0
fail 16
end
i = ulong 0
while lt i ulong n bound 4096
if eq get mem add rin i 10
i = add i 4096
else
put sd i get mem add rin i
i = add i 1
end
end
if ge i 4096
i = sub i 4096
end
if or eq i 0 ge i 1000
fail 16
end
put sn 0 i
end

fn expect f ulong to ulong
ret get ex f
end

note blbad: the number of BL instructions in scratch/fx.elf (code from byte 176) whose target is not a multiple of 64
fn blbad to ulong
pscr 13
m = readin relf 2097152
c = ulong 0
pc = ulong 176
while le add pc 4 m bound 524288
w = le32 add relf pc
if eq and w 0xfc000000 0x94000000
if ne and bltgt pc and w 0x3ffffff 63 0
c = add c 1
end
end
pc = add pc 4
end
ret c
end

fn le32 o ulong to ulong
v = ulong get mem o
v = or v shl ulong get mem add o 1 8
v = or v shl ulong get mem add o 2 16
ret or v shl ulong get mem add o 3 24
end

note bltgt pc i: target byte offset of a BL at pc with imm26 i (signed, in words)
fn bltgt pc ulong i ulong to ulong
if ge i 0x2000000
ret sub pc mul 4 sub 0x4000000 i
end
ret add pc mul 4 i
end

note savout: scratch run.out into mem[runit] (the units region is used only while building ng); its byte count
fn savout to ulong
pscr 15
ret readin runit 1048576
end

note sameout n: scratch run.out (read into the staging region mem[rin]) equals the n bytes savout kept
fn sameout n ulong to bool
pscr 15
m = readin rin 1048576
if ne m n
ret false
end
i = ulong 0
while lt i n bound 1048576
if ne get mem add runit i get mem add rin i
ret false
end
i = add i 1
end
ret true
end

note fixture f: ngcheck accepts its ΩIR; both ng forms and the omc reference give the expected status, and the
note split and omc stdout equal the pairs stdout; the `@ng a64` ELF has every BL target aligned to 64
fn fxrun f ulong to bool
n = mkfx f
c = runck
a = runng n 18
o1 = savout
al = blbad
b = runng n 19
so = ulong 0
if sameout o1
so = 1
end
r = runref f
if not sameout o1
so = 0
end
e = expect f
eom = get eo f
omsg 0
oput 32
otl 1 f
okv 13 c
okv 1 a
okv 14 al
okv 2 b
okv 3 r
okv 4 e
okv 15 eom
okv 16 so
oput 10
oflush
ok = and eq a e eq b e
ok = and ok and eq r eom eq so 1
ret and ok and eq c 0 eq al 0
end

note mutant m (1..): rebuild ng with it; caught when some fixture's `@ng a64` status differs from the expected one
fn mutrun m ulong to bool
buildng m
c = ulong 0
f = ulong 0
while lt f nfx bound 16
n = mkfx f
s = runng n 18
bb = blbad
if or ne s expect f gt bb 0
c = add c 1
end
f = add f 1
end
omsg 5
oput 32
odec m
oput 32
if gt c 0
omsg 6
else
omsg 7
end
oput 32
odec c
oput 10
oflush
ret gt c 0
end

fn main to int
rdscr
put ex 0 17
put ex 1 106
put ex 2 198
put ex 3 191
put ex 4 101
put ex 5 245
put ex 6 32
put ex 7 163
put ex 8 103
put ex 9 0
put ex 10 209
put ex 11 0
put ex 12 0
put ex 13 165
f = ulong 0
while lt f nfx bound 16
put eo f get ex f
f = add f 1
end
put eo 6 106
buildmk
buildck
buildng 0
okf = ulong 0
f = ulong 0
while lt f nfx bound 16
if fxrun f
okf = add okf 1
end
f = add f 1
end
okm = ulong 0
m = ulong 1
while le m nmut bound 16
if mutrun m
okm = add okm 1
end
m = add m 1
end
omsg 11
oput 32
odec okf
oput 47
odec nfx
oput 10
omsg 12
oput 32
odec okm
oput 47
odec nmut
oput 10
if and eq okf nfx eq okm nmut
omsg 8
oput 10
oflush
ret 0
end
omsg 9
oput 10
oflush
ret 1
end

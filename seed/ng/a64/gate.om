note gate.om: the ng-a64 encoder gate. Run from the omega-mv root: seed/out/omc < seed/ng/a64/gate.om > gate && ./gate
note with stdin one line, an existing scratch directory (e.g. /tmp/a64gate). Referee: GNU objdump (/usr/bin/objdump).
note 1. Build ng: scratch/enc.om = the units of seed/ng/ng.units in order, compiled by seed/out/omc -> scratch/enc.bin.
note    (The unit sha256s are ngbuild's check, not this gate's.)
note 2. Run ng on seed/ng/a64/tests/enc.cases (first line `@ng a64-enc`) -> scratch/words.bin (one 4-byte word per
note    case, case k at byte 4k).
note 3. objdump -D -b binary -m aarch64 scratch/words.bin -> scratch/dis.txt.
note 4. Each case's expected text (after `|`) must equal objdump's text for its word: blanks collapsed, objdump's
note    trailing `//` comment dropped, `@+N`/`@-N` replaced by 0x<hex of 4k+N / 4k-N>.
note 5. Negative control: the same with one wrong bit in the tool (ADD immediate base 0x91000000 -> 0x91400000, the
note    shift bit 22). The gate requires the mutant to fail at least one case.
note 6. Refusals: each case of seed/ng/a64/tests/enc-refuse.cases (`FORM operands | stderr line`) runs alone as line 2
note    of `@ng a64-enc` + the case; ng must exit 5, write no word and print exactly that stderr line.
note 7. Negative control of step 6, mutant M-A: a6_fld masks the value to its field instead of refusing it (review
note    P3-2 of 8a3680b0). The gate requires it to fail at least one refusal case.
note Output: one line per mismatch and a summary; exit 0 only when every case matches, the word count equals the case
note count, every refusal case holds and both mutants are caught. Exit 1 otherwise; 2 when a step could not run.
om2

global mem uchar 16777216
global pb uchar 4096
global pn ulong 1
global sd uchar 1024
global sn ulong 1
global av uchar 4096
global ap ulong 2
global stb uchar 4
global ob uchar 65536
global on ulong 1
global ex uchar 4096
global en ulong 1
global dso ulong 4096
global dsl ulong 4096
global nd ulong 1
global rg ulong 16
global mk ulong 1

note regions of mem: source [0, 4 MiB), cases [4, 6), disassembly [6, 14), stdin [14, 15)
const rsrc ulong 0
const rcas ulong 4194304
const rdis ulong 6291456
const rin ulong 14680064
const rinu ulong 14684160
note refusal cases [15 MiB, 15.5 MiB), the one-case list and ng's stderr after them
const rref ulong 15728640
const rone ulong 16252928
const rerr ulong 16257024

text tomc "seed/out/omc"
text ta64 "seed/ng/src/a64.om"
text tmain "seed/ng/ng.units"
text tcase "seed/ng/a64/tests/enc.cases"
text tobjd "/usr/bin/objdump"
text tencom "/enc.om"
text tencb "/enc.bin"
text twrd "/words.bin"
text tdis "/dis.txt"
text terr "/enc.err"
text tdash "-D"
text tdb "-b"
text tbin "binary"
text tdm "-m"
text tarch "aarch64"
text tref "seed/ng/a64/tests/enc-refuse.cases"
text tone "/one.cases"
text tmpat "fset 36 0x91000000 4"
text tmrep "fset 36 0x91400000 4"
text tmpa2 "if ge v shl ulong 1 w\na6_die 5 6 v\nend\nret v"
text tmre2 "if ge v 99\nend\nret and v sub shl ulong 1 w 1"
text tmsg "a64 gate: case line\nexpected\ngot\ncases\nmatch\nmutant mismatches\nwords\nPASS\nFAIL\ncannot run step\na64 gate: refusal case line\nrefusal cases\nrefused as written\nmutant M-A refusal failures\nstatus\n"

note ---- output ----
fn oput b ulong to void
n = get on 0
if lt n len ob
put ob n uchar b
put on 0 add n 1
end
end

fn oflush to void
n = get on 0
p = ulong 0
while lt p n bound 65536
k = write 1 ob p sub n p
if le k 0
p = n
else
p = add p ulong k
end
end
put on 0 0
end

note omsg k: line k of tmsg (without its newline)
fn omsg k ulong to void
i = ulong 0
j = ulong 0
while and lt i len tmsg lt j k bound 4096
if eq get tmsg i 10
j = add j 1
end
i = add i 1
end
while and lt i len tmsg ne get tmsg i 10 bound 4096
oput ulong get tmsg i
i = add i 1
end
end

fn odec v ulong to void
d = ulong 1
while ge div v d 10 bound 20
d = mul d 10
end
x = v
while gt d 0 bound 20
oput add 48 div x d
x = rem x d
d = div d 10
end
end

fn obig o ulong n ulong to void
i = ulong 0
while lt i n bound 4096
oput ulong get mem add o i
i = add i 1
end
end

fn fail k ulong to void
omsg 9
oput 32
odec k
oput 10
omsg 8
oput 10
oflush
exit 2
end

note ---- paths: pb = a text, or the scratch directory followed by a text ----
fn pclr to void
put pn 0 0
end

fn pb1 b ulong to void
n = get pn 0
if ge n len pb
fail 0
end
put pb n uchar b
put pn 0 add n 1
end

fn ptxt k ulong to void
note k: 1 omc, 2 a64.om, 3 ng.units, 4 enc.cases, 5 objdump, 6 /enc.om, 7 /enc.bin, 8 /words.bin, 9 /dis.txt, 10 /enc.err
note 11 -D, 12 -b, 13 binary, 14 -m, 15 aarch64
i = ulong 0
if eq k 1
while lt i len tomc bound 64
pb1 ulong get tomc i
i = add i 1
end
end
if eq k 2
while lt i len ta64 bound 64
pb1 ulong get ta64 i
i = add i 1
end
end
if eq k 3
while lt i len tmain bound 64
pb1 ulong get tmain i
i = add i 1
end
end
if eq k 4
while lt i len tcase bound 64
pb1 ulong get tcase i
i = add i 1
end
end
if eq k 5
while lt i len tobjd bound 64
pb1 ulong get tobjd i
i = add i 1
end
end
if ge k 6
ptxt2 k
end
end

fn ptxt2 k ulong to void
i = ulong 0
if eq k 6
while lt i len tencom bound 64
pb1 ulong get tencom i
i = add i 1
end
end
if eq k 7
while lt i len tencb bound 64
pb1 ulong get tencb i
i = add i 1
end
end
if eq k 8
while lt i len twrd bound 64
pb1 ulong get twrd i
i = add i 1
end
end
if eq k 9
while lt i len tdis bound 64
pb1 ulong get tdis i
i = add i 1
end
end
if eq k 10
while lt i len terr bound 64
pb1 ulong get terr i
i = add i 1
end
end
if ge k 11
ptxt3 k
end
end

fn ptxt3 k ulong to void
i = ulong 0
if eq k 11
while lt i len tdash bound 64
pb1 ulong get tdash i
i = add i 1
end
end
if eq k 12
while lt i len tdb bound 64
pb1 ulong get tdb i
i = add i 1
end
end
if eq k 13
while lt i len tbin bound 64
pb1 ulong get tbin i
i = add i 1
end
end
if eq k 14
while lt i len tdm bound 64
pb1 ulong get tdm i
i = add i 1
end
end
if eq k 15
while lt i len tarch bound 64
pb1 ulong get tarch i
i = add i 1
end
end
if eq k 16
while lt i len tref bound 64
pb1 ulong get tref i
i = add i 1
end
end
if eq k 17
while lt i len tone bound 64
pb1 ulong get tone i
i = add i 1
end
end
end

note pset k: pb = text k; pscr k: pb = scratch directory + text k
fn pset k ulong to void
pclr
ptxt k
end

fn pscr k ulong to void
pclr
i = ulong 0
while lt i get sn 0 bound 1024
pb1 ulong get sd i
i = add i 1
end
ptxt k
end

note ---- files ----
fn openr to int
r = fopen pb 0 get pn 0 0 0
if lt r 0
fail 1
end
ret int r
end

note openw md: create or truncate pb for writing with mode md (O_WRONLY|O_CREAT|O_TRUNC = 577)
fn openw md int to int
r = fopen pb 0 get pn 0 577 md
if lt r 0
fail 2
end
ret int r
end

fn fclo fd int to void
r = fclose fd
end

note readin: all of file pb into mem at offset o (capacity c bytes); returns the byte count
fn readin o ulong c ulong to ulong
fd = openr
n = ulong 0
go = true
while go bound 1000000
if ge n c
fail 3
end
k = read fd mem add o n sub c n
if lt k 0
fail 3
end
if eq k 0
go = false
else
n = add n ulong k
end
end
fclo fd
ret n
end

fn wall fd int o ulong n ulong to void
p = ulong 0
while lt p n bound 1000000
k = write fd mem add o p sub n p
if le k 0
fail 4
end
p = add p ulong k
end
end

note ---- children: av = u16 count, then per argument u16 length and its bytes ----
fn aclr to void
put ap 0 2
put ap 1 0
end

fn apb to void
n = get pn 0
p = get ap 0
if gt add add p n 2 len av
fail 5
end
put av p uchar and n 255
put av add p 1 uchar shr n 8
i = ulong 0
while lt i n bound 4096
put av add add p 2 i get pb i
i = add i 1
end
put ap 0 add add p 2 n
put ap 1 add get ap 1 1
end

fn redir s int d int to void
if ne s d
if ne dupfd s d 0 long d
exit 127
end
end
end

note startch: run av with fds fi, fo, fe as stdin, stdout, stderr; returns the exit status, or 256 + signal
fn startch fi int fo int fe int to ulong
put av 0 uchar and get ap 1 255
put av 1 uchar shr get ap 1 8
pid = fork
if lt pid 0
fail 6
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog av 0 get ap 0
exit 127
end
fclo fi
fclo fo
fclo fe
r = waitpid int pid stb 0 len stb 0
if ne r pid
fail 7
end
sg = and ulong get stb 0 127
if ne sg 0
ret add 256 sg
end
ret ulong get stb 1
end

note ---- steps ----
note mlen, mpat j, mrep j: the pattern and replacement of mutant mk (1 the wrong bit, 2 M-A)
fn mlen to ulong
if eq get mk 0 2
ret len tmpa2
end
ret len tmpat
end

fn mpat j ulong to ulong
if eq get mk 0 2
ret ulong get tmpa2 j
end
ret ulong get tmpat j
end

fn mrep j ulong to ulong
if eq get mk 0 2
ret ulong get tmre2 j
end
ret ulong get tmrep j
end

note mkmut o n: replace the one occurrence of mutant mk's pattern in the source region [o, o+n) (equal lengths)
fn mkmut o ulong n ulong to void
m = mlen
hits = ulong 0
hit = ulong 0
i = o
while le add i m add o n bound 4194304
if samepat i
hits = add hits 1
hit = i
end
i = add i 1
end
if ne hits 1
fail 8
end
j = ulong 0
while lt j m bound 64
put mem add hit j uchar mrep j
j = add j 1
end
end

fn samepat i ulong to bool
j = ulong 0
while lt j mlen bound 64
if ne ulong get mem add i j mpat j
ret false
end
j = add j 1
end
ret true
end

note unitpath p q: pb = the path of the ng.units line mem[p, q) (`HEX PATH`, 64 hex digits and one space)
fn unitpath p ulong q ulong to void
if or le q add p 65 ne get mem add p 64 32
fail 17
end
pclr
i = add p 65
while lt i q bound 4096
pb1 ulong get mem i
i = add i 1
end
end

note isa64: pb is seed/ng/src/a64.om (the unit the mutant changes)
fn isa64 to bool
if ne get pn 0 len ta64
ret false
end
i = ulong 0
while lt i len ta64 bound 64
if ne get pb i get ta64 i
ret false
end
i = add i 1
end
ret true
end

note srcall: the units of ng.units concatenated into the source region, mutant mk (0 none) applied to a64.om;
note returns its length
fn srcall to ulong
pset 3
nu = readin rinu 65536
s = ulong 0
p = rinu
e = add rinu nu
hit = ulong 0
mut = ne get mk 0 0
while lt p e bound 128
q = p
while and lt q e ne get mem q 10 bound 4096
q = add q 1
end
unitpath p q
m = readin s sub rcas s
if and mut isa64
mkmut s m
hit = add hit 1
end
s = add s m
p = add q 1
end
if and mut ne hit 1
fail 8
end
ret s
end

note build m: scratch/enc.om and scratch/enc.bin (ng) with mutant m (0 none, 1 the wrong bit, 2 M-A) in a64.om
fn build m ulong to void
put mk 0 m
n = srcall
pscr 6
fd = openw 420
wall fd 0 n
fclo fd
pscr 6
fi = openr
pscr 7
fo = openw 493
pscr 10
fe = openw 420
aclr
pset 1
apb
if ne startch fi fo fe 0
fail 9
end
end

note runenc: scratch/enc.bin < enc.cases > words.bin; returns the word count
fn runenc to ulong
pset 4
fi = openr
pscr 8
fo = openw 420
pscr 10
fe = openw 420
aclr
pscr 7
apb
if ne startch fi fo fe 0
fail 10
end
pscr 8
n = readin rdis 8388608
if ne and n 3 0
fail 11
end
ret shr n 2
end

note rundis: objdump -D -b binary -m aarch64 words.bin > dis.txt; returns its length (text at rdis)
fn rundis to ulong
pset 4
fi = openr
pscr 9
fo = openw 420
pscr 10
fe = openw 420
aclr
pset 5
apb
pset 11
apb
pset 12
apb
pset 13
apb
pset 14
apb
pset 15
apb
pscr 8
apb
if ne startch fi fo fe 0
fail 12
end
pscr 9
ret readin rdis 8388608
end

note ---- parsing the disassembly: dso[k], dsl[k] = start, length of the instruction text of the word at 4k ----
fn ishex c ulong to bool
ret or and ge c 48 le c 57 and ge c 97 le c 102
end

fn hexv c ulong to ulong
if le c 57
ret sub c 48
end
ret sub c 87
end

note disline: the line [s, e) of the disassembly; if it is `<spaces><hex>:\t<word> \t<text>` record <text>
fn disline s ulong e ulong to void
p = s
while and lt p e eq get mem p 32 bound 64
p = add p 1
end
a = ulong 0
q = p
while and lt q e ishex ulong get mem q bound 64
a = or shl a 4 hexv ulong get mem q
q = add q 1
end
if or eq q p ge add q 1 e
ret
end
if or ne get mem q 58 ne get mem add q 1 9
ret
end
t = add q 2
while and lt t e ne get mem t 9 bound 64
t = add t 1
end
t = add t 1
if or ge t e ne and a 3 0
ret
end
k = shr a 2
if ge k len dso
fail 13
end
put dso k t
put dsl k sub e t
if ge k get nd 0
put nd 0 add k 1
end
end

fn disparse n ulong to void
put nd 0 0
i = ulong 0
while lt i len dsl bound 4096
put dsl i 0
put dso i 0
i = add i 1
end
p = rdis
e = add rdis n
while lt p e bound 1000000
q = p
while and lt q e ne get mem q 10 bound 100000
q = add q 1
end
disline p q
p = add q 1
end
end

note ---- normalized text into ex: blanks (space, tab) collapsed to one space, trimmed ----
fn exclr to void
put en 0 0
end

note exsp n: ex holds n > 0 bytes and the last is a blank (and/or are eager, so n = 0 is tested here)
fn exsp n ulong to bool
if eq n 0
ret false
end
ret eq get ex sub n 1 32
end

fn ex1 c ulong to void
n = get en 0
if ge n len ex
fail 14
end
if or eq c 32 eq c 9
if or eq n 0 exsp n
ret
end
put ex n 32
else
put ex n uchar c
end
put en 0 add n 1
end

fn extrim to void
n = get en 0
while exsp n bound 4096
n = sub n 1
end
put en 0 n
end

fn exhex v ulong to void
ex1 48
ex1 120
d = ulong 0
while ne shr v shl add d 1 2 0 bound 16
d = add d 1
end
go = true
while go bound 17
h = and shr v shl d 2 15
if lt h 10
ex1 add 48 h
else
ex1 add 87 h
end
if eq d 0
go = false
else
d = sub d 1
end
end
end

note expect: the expected text [s, e) of case k into ex, with @+N/@-N resolved
fn expect s ulong e ulong k ulong to void
exclr
p = s
while lt p e bound 4096
c = ulong get mem p
if eq c 64
p = exaddr add p 1 e k
else
ex1 c
p = add p 1
end
end
extrim
end

fn isdig q ulong e ulong to bool
if ge q e
ret false
end
c = ulong get mem q
ret and ge c 48 le c 57
end

fn exaddr p ulong e ulong k ulong to ulong
sg = ulong get mem p
q = add p 1
v = ulong 0
while isdig q e bound 20
v = add mul v 10 sub ulong get mem q 48
q = add q 1
end
b = shl k 2
if eq sg 43
exhex add b v
else
exhex sub b v
end
ret q
end

note same: ex equals the objdump text of word k (from dso[k], `//` comment dropped, normalized the same way)
fn same k ulong to bool
if ge k get nd 0
ret false
end
o = get dso k
e = add o get dsl k
i = o
while and lt i e not slash2 i e bound 4096
i = add i 1
end
ret cmpex get en 0 o i
end

fn slash2 i ulong e ulong to bool
if ge add i 1 e
ret false
end
ret and eq get mem i 47 eq get mem add i 1 47
end

note cmpex: ex[0, m) against mem [o, i) with blanks collapsed, leading and trailing blanks dropped
fn cmpex m ulong o ulong i ulong to bool
j = ulong 0
p = o
pend = false
while lt p i bound 4096
c = ulong get mem p
if or eq c 9 eq c 32
if gt j 0
pend = true
end
else
if pend
if or ge j m ne get ex j 32
ret false
end
j = add j 1
pend = false
end
if or ge j m ne ulong get ex j c
ret false
end
j = add j 1
end
p = add p 1
end
ret eq j m
end

note ---- comparing every case ----
note cmpall verbose: rg[0] cases, rg[1] matches; prints each mismatch when verbose
fn cmpall vb bool to void
put rg 0 0
put rg 1 0
n = get rg 4
p = rcas
e = add rcas n
while and lt p e ne get mem p 10 bound 4096
p = add p 1
end
ln = ulong 1
while lt p e bound 1000000
p = add p 1
ln = add ln 1
q = p
while and lt q e ne get mem q 10 bound 100000
q = add q 1
end
cmpline p q ln vb
p = q
end
end

fn isblk p ulong e ulong to bool
if ge p e
ret false
end
c = ulong get mem p
ret or eq c 32 eq c 9
end

note barat: the `|` of the case line [p, e) (fail 15 if none)
fn barat p ulong e ulong to ulong
b = p
while and lt b e ne get mem b 124 bound 4096
b = add b 1
end
if ge b e
fail 15
end
ret b
end

fn cmpline s ulong e ulong ln ulong vb bool to void
p = s
while isblk p e bound 4096
p = add p 1
end
if ge p e
ret
end
if eq get mem p 59
ret
end
b = barat p e
k = get rg 0
put rg 0 add k 1
expect add b 1 e k
if same k
put rg 1 add get rg 1 1
else
if vb
showbad ln k
end
end
end

fn showbad ln ulong k ulong to void
omsg 0
oput 32
odec ln
oput 10
omsg 1
oput 58
oput 32
i = ulong 0
while lt i get en 0 bound 4096
oput ulong get ex i
i = add i 1
end
oput 10
omsg 2
oput 58
oput 32
if lt k get nd 0
obig get dso k get dsl k
end
oput 10
oflush
end

note ---- step 6: refusal cases (rg: 2 cases, 3 refused as written, 5 mode line length, 6 status, 7 stderr bytes) ----
note rfall vb: run every case of enc-refuse.cases alone; prints each case that does not hold when vb
fn rfall vb bool to void
pset 16
n = readin rref sub rone rref
put rg 2 0
put rg 3 0
p = rref
e = add rref n
while and lt p e ne get mem p 10 bound 4096
p = add p 1
end
put rg 5 add sub p rref 1
ln = ulong 1
while lt p e bound 1000000
p = add p 1
ln = add ln 1
q = p
while and lt q e ne get mem q 10 bound 100000
q = add q 1
end
rfline p q ln vb
p = q
end
end

fn rfline s ulong e ulong ln ulong vb bool to void
p = s
while isblk p e bound 4096
p = add p 1
end
if ge p e
ret
end
if eq get mem p 59
ret
end
b = barat p e
put rg 2 add get rg 2 1
rfwr p b
if and rfrun rfsame add b 1 e
put rg 3 add get rg 3 1
else
if vb
rfbad ln
end
end
end

note rfwr p b: scratch/one.cases = the mode line of enc-refuse.cases, then the case mem[p, b) without trailing blanks
fn rfwr p ulong b ulong to void
m = get rg 5
i = ulong 0
while lt i m bound 4096
put mem add rone i get mem add rref i
i = add i 1
end
q = b
while and gt q p isblk sub q 1 b bound 4096
q = sub q 1
end
j = p
while lt j q bound 4096
put mem add rone i get mem j
i = add i 1
j = add j 1
end
put mem add rone i 10
pscr 17
fd = openw 420
wall fd rone add i 1
fclo fd
end

note rfrun: scratch/enc.bin < one.cases > words.bin 2> enc.err; true when it exits 5 and writes no word
fn rfrun to bool
pscr 17
fi = openr
pscr 8
fo = openw 420
pscr 10
fe = openw 420
aclr
pscr 7
apb
st = startch fi fo fe
put rg 6 st
pscr 10
put rg 7 readin rerr 4096
pscr 8
nw = readin rdis 8388608
ret and eq st 5 eq nw 0
end

note rfsame s e: ng's stderr is the text mem[s, e) (blanks trimmed at both ends) and one newline
fn rfsame s ulong e ulong to bool
n = get rg 7
p = s
while isblk p e bound 4096
p = add p 1
end
q = e
while and gt q p isblk sub q 1 e bound 4096
q = sub q 1
end
if ne add sub q p 1 n
ret false
end
i = ulong 0
while lt i sub q p bound 4096
if ne get mem add p i get mem add rerr i
ret false
end
i = add i 1
end
ret eq get mem add rerr sub n 1 10
end

fn rfbad ln ulong to void
omsg 10
oput 32
odec ln
oput 10
omsg 14
oput 32
odec get rg 6
oput 10
omsg 2
oput 58
oput 32
obig rerr get rg 7
oput 10
oflush
end

fn sline k ulong v ulong to void
omsg k
oput 32
odec v
oput 10
end

note summary: rg 8 cases, 9 matches, 11 words, 10 mutant mismatches, 13 refusal cases, 14 held, 15 M-A failures
fn summary to void
sline 3 get rg 8
sline 4 get rg 9
sline 6 get rg 11
sline 5 get rg 10
sline 11 get rg 13
sline 12 get rg 14
sline 13 get rg 15
end

fn rdscr to void
pclr
n = read 0 mem rin 4096
if le n 0
fail 16
end
i = ulong 0
while and lt i ulong n ne get mem add rin i 10 bound 4096
put sd i get mem add rin i
i = add i 1
end
if or eq i 0 ge i 1000
fail 16
end
put sn 0 i
end

fn main to int
rdscr
pset 4
put rg 4 readin rcas sub rdis rcas
build 0
w = runenc
disparse rundis
cmpall true
cs = get rg 0
put rg 8 cs
put rg 9 get rg 1
put rg 11 w
ok = and eq get rg 1 cs eq w cs
rfall true
put rg 13 get rg 2
put rg 14 get rg 3
ok = and ok and gt get rg 2 0 eq get rg 3 get rg 2
build 1
w2 = runenc
disparse rundis
cmpall false
mm = sub get rg 0 get rg 1
put rg 10 mm
ok = and ok and gt mm 0 eq w2 cs
build 2
rfall false
rm = sub get rg 2 get rg 3
put rg 15 rm
ok = and ok gt rm 0
summary
if ok
omsg 7
oput 10
oflush
ret 0
end
omsg 8
oput 10
oflush
ret 1
end

note ---- Stage 5: Fail-Closed Tamper & Corruption Negative Controls ----

fn gm_backup_cur_ome to bool
fd = fopen mm_file_path 0 get mm_file_plen 0 0 0
if lt fd 0
ret false
end
n = read int fd gm_bkp 0 4096
cf = fclose int fd
if lt n 224
ret false
end
put gm_bkpl 0 ulong n
ret true
end

fn gm_write_raw_ome n ulong to bool
fd = fopen mm_file_path 0 get mm_file_plen 0 577 420
if lt fd 0
ret false
end
w = write int fd gm_io 0 n
cf = fclose int fd
ret eq w long n
end

fn gm_copy_bkp_to_io to ulong
n = get gm_bkpl 0
for i ulong n bound 4096
put gm_io i get gm_bkp i
end
ret n
end

fn gm_stage5_tamper to int
gm_spath gm_s_main
if ne gm_set_root_pa MM_OK
ret gm_fail 80
end
mp_init
mp_set_override MP_OVR_FORCE
mm_reset_req
gm_load_fid 0
mm_hash_input_u64 3001
gm_put_u64_val 31415926535
mm_set_contract 1 1 2 100
if ne mm_store 50000 500 MM_OK
ret gm_fail 81
end
if ne mm_derive_paths MM_OK
ret gm_fail 82
end
if not gm_backup_cur_ome
ret gm_fail 83
end

note 5a. NEG: 1-bit tamper in output_bytes[0] (offset 224) -> MM_ERR_TAMPER (14)
n = gm_copy_bkp_to_io
put gm_io 224 xor get gm_io 224 uchar 1
if not gm_write_raw_ome n
ret gm_fail 84
end
if ne mm_lookup MM_ERR_TAMPER
ret gm_fail 85
end
if ne get mm_val_len 0 0
ret gm_fail 86
end
gm_add_neg

note 5b. NEG: 1-bit header tamper trying to forge @tol(100) into @exact (tier 2->1, err->0) -> MM_ERR_TAMPER (14)
n = gm_copy_bkp_to_io
put gm_io 9 uchar 1
for j ulong 8
put gm_io add 16 j uchar 0
end
if not gm_write_raw_ome n
ret gm_fail 87
end
mm_set_contract 1 1 1 0
if ne mm_lookup MM_ERR_TAMPER
ret gm_fail 88
end
gm_add_neg
mm_set_contract 1 1 2 100

note 5c. NEG: Truncated .ome output (minus 1 byte) AND truncated header (100 bytes) -> MM_ERR_TRUNCATED (12)
n = gm_copy_bkp_to_io
if not gm_write_raw_ome sub n 1
ret gm_fail 89
end
if ne mm_lookup MM_ERR_TRUNCATED
ret gm_fail 90
end
if not gm_write_raw_ome 100
ret gm_fail 91
end
if ne mm_lookup MM_ERR_TRUNCATED
ret gm_fail 92
end
gm_add_neg

note 5d. NEG: Trailing garbage byte appended -> MM_ERR_TRAILING (13)
n = gm_copy_bkp_to_io
put gm_io n uchar 65
if not gm_write_raw_ome add n 1
ret gm_fail 93
end
if ne mm_lookup MM_ERR_TRAILING
ret gm_fail 94
end
gm_add_neg

note 5e. NEG: Corrupt magic byte -> MM_ERR_MAGIC (10); corrupt version -> MM_ERR_VERSION (11)
n = gm_copy_bkp_to_io
put gm_io 0 uchar 88
if not gm_write_raw_ome n
ret gm_fail 95
end
if ne mm_lookup MM_ERR_MAGIC
ret gm_fail 96
end
n = gm_copy_bkp_to_io
put gm_io 4 uchar 9
if not gm_write_raw_ome n
ret gm_fail 97
end
if ne mm_lookup MM_ERR_VERSION
ret gm_fail 98
end
gm_add_neg

note 5f. Restore valid file for inp=3001, then copy it onto path of inp=3002 (key-substitution attack -> MM_ERR_KEY_MISMATCH)
n = gm_copy_bkp_to_io
if not gm_write_raw_ome n
ret gm_fail 99
end
mm_hash_input_u64 3002
if ne mm_derive_paths MM_OK
ret gm_fail 100
end
sr = makedir mm_shard_path 0 get mm_shard_plen 0 493
if not gm_write_raw_ome n
ret gm_fail 101
end
if ne mm_lookup MM_ERR_KEY_MISMATCH
ret gm_fail 102
end
u = unlink mm_file_path 0 get mm_file_plen 0
gm_add_neg

gm_add_chk 12
ret 0
end

note ---- Stage 6: Profitability Policy (Trivial Skip, Precheck Skip, Heavy Admit, Test Override) ----

fn gm_stage6_profitability to int
gm_spath gm_s_main
if ne gm_set_root_pa MM_OK
ret gm_fail 110
end
mp_init
mp_set_override MP_OVR_AUTO
mp_set_thresholds 5000 2 1
mm_reset_stats

note 6a. Trivial sub-threshold op (real monons timing + explicit 150ns vs 4000ns) -> SKIPPED, no file created!
mm_reset_req
gm_load_fid 2
mm_hash_input_u64 4001
mm_set_contract 1 1 1 0
t0 = monons
tv = gm_trivial_compute 4001
t1 = monons
cns_trv = ulong 150
if and gt t1 t0 lt sub t1 t0 4000
cns_trv = ulong sub t1 t0
end
gm_put_u64_val tv
if ne mm_store cns_trv 4000 MM_SKIP_UNPROFITABLE
ret gm_fail 111
end
if ne mm_derive_paths MM_OK
ret gm_fail 112
end
if eq stat mm_file_path 0 get mm_file_plen 0 mp_stbuf 0 128 0
ret gm_fail 113
end
gm_add_neg

note 6b. Subsequent mm_lookup on already-profiled trivial SEMANTIC_ID fast-skips via mp_precheck!
if ne mm_lookup MM_SKIP_UNPROFITABLE
ret gm_fail 114
end

note 6c. Heavy pure op (real monons timing >= 5000ns and >= 2x overhead) -> ADMITTED & HIT!
mm_reset_req
gm_load_fid 3
mm_hash_input_u64 4002
mm_set_contract 1 1 1 0
h0 = monons
hv = gm_heavy_compute 4002 60000
h1 = monons
cns_hvy = ulong 100000
if gt h1 h0
cns_hvy = ulong sub h1 h0
end
if lt cns_hvy 10000
cns_hvy = ulong 100000
end
gm_put_u64_val hv
if ne mm_store cns_hvy 2000 MM_OK
ret gm_fail 115
end
if ne mm_lookup MM_OK
ret gm_fail 116
end
if ne gm_get_u64_val hv
ret gm_fail 117
end

note 6d. Explicit override MP_OVR_FORCE admits even trivial sub-threshold op for tests!
mp_set_override MP_OVR_FORCE
mm_reset_req
gm_load_fid 2
mm_hash_input_u64 4001
mm_set_contract 1 1 1 0
gm_put_u64_val tv
if ne mm_store 100 4000 MM_OK
ret gm_fail 118
end
if ne mm_lookup MM_OK
ret gm_fail 119
end
if ne gm_get_u64_val tv
ret gm_fail 120
end

gm_add_chk 9
ret 0
end

note ---- Stage 7: Uncapped 128+ Entry Scaling (No 32-Slot Cap) + Disk-Floor Alarm + memo_prune ----

fn gm_stage7_scale_alarm_prune to int
gm_spath gm_s_scale
if ne gm_set_root_pa MM_OK
ret gm_fail 130
end
mp_init
mp_set_override MP_OVR_FORCE
mp_set_disk_limits 1048576 4096 2097152
mm_reset_stats

note 7a. Store 128 distinct content-addressed entries (4x past 32-slot cap!)
for i ulong 128
mm_reset_req
gm_load_fid 0
mm_hash_input_u64 add 50000 i
mm_set_contract 1 1 1 0
gm_put_u64_val add mul i 1000 7
rc = mm_store 50000 500
if ne rc MM_OK
ret gm_fail 131
end
end
if ne mp_scan_store MP_DISK_OK
ret gm_fail 132
end
if ne get mp_stat 0 128
ret gm_fail 133
end
if ne get mp_stat 1 29696
ret gm_fail 134
end
put gm_ent 0 get mp_stat 0

note Verify sample entries spanning well beyond slot 32 (0, 31, 32, 63, 64, 99, 127)
for k ulong 7
idx = ulong 0
if eq k 1
idx = ulong 31
end
if eq k 2
idx = ulong 32
end
if eq k 3
idx = ulong 63
end
if eq k 4
idx = ulong 64
end
if eq k 5
idx = ulong 99
end
if eq k 6
idx = ulong 127
end
mm_reset_req
gm_load_fid 0
mm_hash_input_u64 add 50000 idx
mm_set_contract 1 1 1 0
if ne mm_lookup MM_OK
ret gm_fail 135
end
if ne gm_get_u64_val add mul idx 1000 7
ret gm_fail 136
end
end

note 7b. Disk-floor alarm: set max_store_bytes = 20000 (< 29696), store entry #128 -> MUST fire loud ALARM without truncating ANY existing entry!
mp_set_disk_limits 20000 4096 2097152
mm_reset_req
gm_load_fid 0
mm_hash_input_u64 50128
mm_set_contract 1 1 1 0
gm_put_u64_val 128007
if ne mm_store 50000 500 MM_OK_ALARM
ret gm_fail 137
end
if or ne get mp_stat 3 1 lt get mp_stat 4 1
ret gm_fail 138
end
note Confirm structured alarm message begins with "OMEGA-MEMO ALARM disk_floor "
if lt get mp_alarm_len 0 len gm_al_want
ret gm_fail 139
end
for i ulong len gm_al_want bound 64
if ne get mp_alarm_buf i get gm_al_want i
ret gm_fail 140
end
end
note Confirm ZERO silent truncation: ALL 129 entries remain intact and verifiable on disk!
if ne mp_scan_store MP_DISK_OK
ret gm_fail 141
end
if ne get mp_stat 0 129
ret gm_fail 142
end
put gm_ent 0 get mp_stat 0
mm_reset_req
gm_load_fid 0
mm_hash_input_u64 50000
mm_set_contract 1 1 1 0
if ne mm_lookup MM_OK
ret gm_fail 143
end
if ne gm_get_u64_val 7
ret gm_fail 144
end
mm_hash_input_u64 50128
if ne mm_lookup MM_OK
ret gm_fail 145
end
if ne gm_get_u64_val 128007
ret gm_fail 146
end
gm_add_neg

note 7c. Also verify free_bytes < free_floor_bytes alarm triggers loudly
mp_set_disk_limits 1048576 8192 2097152
mp_set_ext_free 1 1024
if ne mp_check_disk_floor MP_ALARM_DISK_FLOOR
ret gm_fail 147
end
mp_set_ext_free 0 0
gm_add_neg

note 7d. Explicit oldest-first mm_prune down to 11600 bytes (50 entries x 232B) clears alarm cleanly!
mp_set_disk_limits 12000 4096 2097152
if ne mm_prune 11600 MM_OK
ret gm_fail 148
end
if ne get mp_stat 5 79
ret gm_fail 149
end
if ne get mp_stat 6 18328
ret gm_fail 150
end
if ne get mp_stat 0 50
ret gm_fail 151
end
if gt get mp_stat 1 11600
ret gm_fail 152
end
if ne get mp_stat 3 0
ret gm_fail 153
end

gm_add_chk 16
ret 0
end

note ---- Stage 8 (Optional): Live ng + ngcheck ck_pure End-to-End Integration ----

fn gm_cli_write_txt hdr view uchar * body view uchar * to bool
gm_spath gm_f_in
fd = fopen gm_pa 0 get gm_pl 0 577 420
if lt fd 0
ret false
end
if gt len hdr 0
w1 = write int fd hdr 0 len hdr
if ne w1 long len hdr
cf = fclose int fd
ret false
end
end
w2 = write int fd body 0 len body
cf2 = fclose int fd
ret eq w2 long len body
end

fn gm_cli_write_bin hdr view uchar * n ulong to bool
gm_spath gm_f_in
fd = fopen gm_pa 0 get gm_pl 0 577 420
if lt fd 0
ret false
end
if gt len hdr 0
w1 = write int fd hdr 0 len hdr
if ne w1 long len hdr
cf = fclose int fd
ret false
end
end
w2 = write int fd gm_io2 0 n
cf2 = fclose int fd
ret eq w2 long n
end

fn gm_cli_read_out to long
gm_spath gm_f_out
fd = fopen gm_pa 0 get gm_pl 0 0 0
if lt fd 0
ret neg long 1
end
n = ulong 0
while lt n 65536 bound 1024
k = read int fd gm_io n sub 65536 n
if lt k 0
cf = fclose int fd
ret neg long 1
end
if eq k 0
cf = fclose int fd
ret long n
end
n = add n ulong k
end
cf = fclose int fd
ret long n
end

fn gm_cli_exec use_ng bool to ulong
put gm_av 0 1
put gm_av 1 0
n = ulong 0
if use_ng
n = get gm_ngl 0
put gm_av 2 uchar and n 255
put gm_av 3 uchar and shr n 8 255
for i ulong n bound 1024
put gm_av add 4 i get gm_ngp i
end
else
n = get gm_ckl 0
put gm_av 2 uchar and n 255
put gm_av 3 uchar and shr n 8 255
for i ulong n bound 1024
put gm_av add 4 i get gm_ckp i
end
end
put gm_an 0 add 4 n
gm_spath gm_f_in
fi = fopen gm_pa 0 get gm_pl 0 0 0
gm_spath gm_f_out
fo = fopen gm_pa 0 get gm_pl 0 577 420
gm_spath gm_f_err
fe = fopen gm_pa 0 get gm_pl 0 577 420
if or lt fi 0 or lt fo 0 lt fe 0
ret 255
end
pid = fork
if lt pid 0
ret 254
end
if eq pid 0
r = dupfd int fi 0 0
r = dupfd int fo 1 0
r = dupfd int fe 2 0
r = execprog gm_av 0 get gm_an 0
exit 127
end
r = fclose int fi
r = fclose int fo
r = fclose int fe
w = waitpid int pid gm_st 0 4 0
if ne w pid
ret 253
end
if ne get gm_st 0 0
ret add 256 ulong get gm_st 0
end
ret ulong get gm_st 1
end

fn gm_hex_nib ch uchar to ulong
if and ge ch 48 le ch 57
ret ulong sub ch 48
end
if and ge ch 97 le ch 102
ret add 10 ulong sub ch 97
end
ret 255
end

fn gm_parse_semid_hex to bool
for i ulong 32
hi = gm_hex_nib get gm_io add 5 mul i 2
lo = gm_hex_nib get gm_io add 6 mul i 2
if or gt hi 15 gt lo 15
ret false
end
put gm_fid_cli i uchar or shl hi 4 lo
end
ret true
end

fn gm_stage8_pure to int
if not gm_cli_write_txt gm_h_fi gm_src_pure
ret gm_fail 161
end
if ne gm_cli_exec true 0
ret gm_fail 162
end
irn = gm_cli_read_out
if lt irn 64
ret gm_fail 163
end
for i ulong ulong irn bound 65536
put gm_io2 i get gm_io i
end
gm_spath gm_f_in
fd = fopen gm_pa 0 get gm_pl 0 577 420
if lt fd 0
ret gm_fail 164
end
kw = write int fd gm_io2 0 ulong irn
cf = fclose int fd
if ne kw irn
ret gm_fail 164
end
if ne gm_cli_exec false 0
ret gm_fail 165
end
acn = gm_cli_read_out
if lt acn long len gm_pfx_acc
ret gm_fail 166
end
for i ulong len gm_pfx_acc bound 16
if ne get gm_io i get gm_pfx_acc i
ret gm_fail 167
end
end
if not gm_cli_write_bin gm_h_sd ulong irn
ret gm_fail 168
end
if ne gm_cli_exec true 0
ret gm_fail 169
end
sdn = gm_cli_read_out
if lt sdn 70
ret gm_fail 170
end
for i ulong len gm_pfx_fn0 bound 16
if ne get gm_io i get gm_pfx_fn0 i
ret gm_fail 171
end
end
if not gm_parse_semid_hex
ret gm_fail 172
end
gm_spath gm_s_cli
if ne gm_set_root_pa MM_OK
ret gm_fail 173
end
mp_init
mp_set_override MP_OVR_FORCE
mm_reset_req
gm_load_fid 4
mm_hash_input_u64 5
mm_set_contract 1 1 1 0
gm_put_u64_val 48
if ne mm_store 50000 500 MM_OK
ret gm_fail 174
end
if ne mm_lookup MM_OK
ret gm_fail 175
end
if ne gm_get_u64_val 48
ret gm_fail 176
end
put gm_cli_chk 0 add get gm_cli_chk 0 5
ret 0
end

fn gm_stage8_impure to int
if not gm_cli_write_txt gm_h_fi gm_src_imp
ret gm_fail 177
end
if ne gm_cli_exec true 0
ret gm_fail 178
end
irn = gm_cli_read_out
if lt irn 64
ret gm_fail 179
end
for i ulong ulong irn bound 65536
put gm_io2 i get gm_io i
end
gm_spath gm_f_in
fd = fopen gm_pa 0 get gm_pl 0 577 420
if lt fd 0
ret gm_fail 180
end
kw = write int fd gm_io2 0 ulong irn
cf = fclose int fd
ckrc = gm_cli_exec false
if ne ckrc 22
ret gm_fail 181
end
ckp = ulong 0
if eq ckrc 0
ckp = ulong 1
end
mm_reset_req
gm_load_fid 4
mm_hash_input_u64 99
mm_set_contract 1 ckp 1 0
gm_put_u64_val 99
if ne mm_store 50000 500 MM_ERR_IMPURE
ret gm_fail 182
end
put gm_cli_neg 0 add get gm_cli_neg 0 1
ret 0
end

fn gm_stage8_live_ng to int
nl = argread 2 gm_ngp 0 1023
cl = argread 3 gm_ckp 0 1023
if or lt nl 1 lt cl 1
ret gm_fail 160
end
put gm_ngl 0 ulong nl
put gm_ckl 0 ulong cl
rc = gm_stage8_pure
if ne rc 0
ret rc
end
ret gm_stage8_impure
end

note ---- Setup Scratch Root & Main ----

fn gm_init_scratch to bool
if ge argcnt 2
sl = argread 1 gm_scp 0 1023
if lt sl 1
ret false
end
put gm_scl 0 ulong sl
else
pl = len gm_def_pfx
for i ulong pl bound 64
put gm_scp i get gm_def_pfx i
end
pid = ulong getpid
x = pid
q = ulong 24
for i ulong 21
q = sub q 1
put gm_dig q uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
dc = sub 24 q
for j ulong dc bound 24
put gm_scp add pl j get gm_dig add q j
end
put gm_scl 0 add pl dc
end
r = makedir gm_scp 0 get gm_scl 0 493
if and ne r 0 ne r neg long 17
ret false
end
ret true
end

fn main to int
z = ar_need 0 65536
ar_init
note Check internal cross-process worker subcommands first
if ge argcnt 2
if gm_arg_eq 1 gm_w_store
ret gm_worker_store
end
if gm_arg_eq 1 gm_w_look
ret gm_worker_lookup
end
if gm_arg_eq 1 gm_w_ref
ret gm_worker_refuse
end
if gm_arg_eq 1 gm_w_env
ret gm_worker_env
end
end

put gm_chk 0 0
put gm_neg 0 0
put gm_xproc 0 0
put gm_ent 0 0
put gm_cli_chk 0 0
put gm_cli_neg 0 0

gm_wrt gm_m_hdr
if not gm_init_scratch
ret gm_fail 1
end
ok = gm_build_ir_fids

rc = gm_stage1_env_root
if ne rc 0
ret rc
end
rc = gm_stage2_purity
if ne rc 0
ret rc
end
rc = gm_stage3_xproc
if ne rc 0
ret rc
end
rc = gm_stage4_dominance
if ne rc 0
ret rc
end
rc = gm_stage5_tamper
if ne rc 0
ret rc
end
rc = gm_stage6_profitability
if ne rc 0
ret rc
end
rc = gm_stage7_scale_alarm_prune
if ne rc 0
ret rc
end

if ge argcnt 4
rc = gm_stage8_live_ng
if ne rc 0
ret rc
end
end

gm_wrt gm_m_pass
gm_num get gm_chk 0
gm_wrt gm_m_neg
gm_num get gm_neg 0
gm_wrt gm_m_xp
gm_num get gm_xproc 0
gm_wrt gm_m_ent
gm_num get gm_ent 0
gm_wrt gm_m_cli
gm_num get gm_cli_chk 0
gm_wrt gm_m_cneg
gm_num get gm_cli_neg 0
gm_wrt gm_m_nl
ret 0
end

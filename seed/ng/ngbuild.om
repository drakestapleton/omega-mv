note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngbuild.om: builds the ng compiler from the lane units listed in seed/ng/ng.units (D1b).
note Owner: ng-ir lane. Build this tool itself with: cat seed/ng/sha256.om seed/ng/ngbuild.om | omc
note Run from the repository root.
note   ngbuild build OMC UNITS OUT   check every unit's sha256 against UNITS, concatenate the units
note                                 in order into OUT.src, compile it with OMC (stdin OUT.src,
note                                 stdout OUT), print on stderr "ngbuild: OK units=N bytes=M sha256=HEX"
note                                 (sha256 of OUT)
note   ngbuild sums UNITS            print each unit's current "HEX PATH" line (to refresh UNITS)
note UNITS: one unit per line, "HEX PATH": 64 lowercase hex digits, one space, a path relative to
note the working directory, a newline. No other lines. At most 64 units, 8388607 bytes in total (the
note omc input capacity, OMEGESE s9.6).
note Exit: 0 built (or sums printed), 1 omc refused (its exit and stderr are passed through on
note stderr as "ngbuild: omc exit N"), 2 usage, 3 sha256 mismatch, 4 malformed UNITS, 5 a unit or
note UNITS unreadable or too large, 6 OUT.src or OUT not writable, 7 fork/exec/wait failure.
text nb_txt "build\nsums\n.src\nngbuild: OK units=\n bytes=\n sha256=\nngbuild: sha256 mismatch \n have \nngbuild: omc exit \nngbuild: malformed units line \nngbuild: unreadable or too large: \nngbuild: cannot write output\nngbuild: fork, exec or wait failed\nngbuild: usage: ngbuild build OMC UNITS OUT | ngbuild sums UNITS\n"
global nb_u uchar 65536
global nb_un ulong 1
global nb_src uchar 8388608
global nb_sn ulong 1
global nb_a uchar 4096
global nb_al ulong 128
global nb_p uchar 4096
global nb_pn ulong 1
global nb_hx uchar 66
global nb_d uchar 24
global nb_st uchar 4
global nb_av uchar 8192
global nb_ap ulong 2
note ---- output ---------------------------------------------------------------------------------
note line k (1-based) of nb_txt, without its newline
fn nb_say k ulong to void
s = ulong 0
c = ulong 1
for i ulong len nb_txt
if eq get nb_txt i 10
if eq c k
r = write 2 nb_txt s sub i s
ret
end
c = add c 1
s = add i 1
end
end
end
fn nb_nl to void
put nb_d 0 10
r = write 2 nb_d 0 1
end
fn nb_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put nb_d i uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 2 nb_d i sub 24 i
ret
end
end
end
note hex of sh_dig into nb_hx[0..64)
fn nb_hex to void
for j ulong 32
b = uint get sh_dig j
put nb_hx mul j 2 sh_hexd shr b 4
put nb_hx add mul j 2 1 sh_hexd and b 15
end
end
note ---- arguments and files --------------------------------------------------------------------
note argument i into nb_a at offset nb_al[2i], length nb_al[2i+1]; false when absent or too long
fn nb_arg i ulong to bool
o = ulong 0
if gt i 0
o = add get nb_al sub mul i 2 2 get nb_al sub mul i 2 1
end
k = argread i nb_a o sub len nb_a o
if lt k 0
ret false
end
put nb_al mul i 2 o
put nb_al add mul i 2 1 ulong k
ret true
end
fn nb_aeq i ulong w ulong to bool
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
s = ulong 0
c = ulong 1
for j ulong len nb_txt
if eq get nb_txt j 10
if eq c w
if ne n sub j s
ret false
end
for q ulong n bound 4096
if ne get nb_a add o q get nb_txt add s q
ret false
end
end
ret true
end
c = add c 1
s = add j 1
end
end
ret false
end
note read the file at nb_p[0..nb_pn) into sh_dat; its length, or the capacity + 1 on failure
fn nb_load to ulong
fd = fopen nb_p 0 get nb_pn 0 0 0
if lt fd 0
ret add len sh_dat 1
end
n = ulong 0
while lt n len sh_dat bound 16777217
k = read int fd sh_dat n sub len sh_dat n
if lt k 0
r = fclose int fd
ret add len sh_dat 1
end
if eq k 0
r = fclose int fd
ret n
end
n = add n ulong k
end
r = fclose int fd
ret add len sh_dat 1
end
fn nb_unr to void
nb_say 11
r = write 2 nb_p 0 get nb_pn 0
nb_nl
exit 5
end
note path of argument i into nb_p
fn nb_ap2p i ulong to void
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
for j ulong n bound 4096
put nb_p j get nb_a add o j
end
put nb_pn 0 n
end
note read UNITS (argument i) into nb_u
fn nb_units i ulong to void
nb_ap2p i
n = nb_load
if gt n len nb_u
nb_unr
end
for j ulong n bound 65536
put nb_u j get sh_dat j
end
put nb_un 0 n
end
note ---- units ----------------------------------------------------------------------------------
note parse the unit line at nb_u[s..): sets nb_p to its path, returns the offset after its newline
fn nb_line s ulong to ulong
n = get nb_un 0
if gt add s 66 n
nb_bad s
end
if ne get nb_u add s 64 32
nb_bad s
end
p = add s 65
e = p
while lt e n bound 65536
if eq get nb_u e 10
break
end
e = add e 1
end
if or ge e n eq e p
nb_bad s
end
put nb_pn 0 sub e p
for j ulong sub e p bound 4096
put nb_p j get nb_u add p j
end
ret add e 1
end
fn nb_bad s ulong to void
nb_say 10
nb_num s
nb_nl
exit 4
end
note true when the 64 hex digits at nb_u[s..) equal nb_hx
fn nb_same s ulong to bool
for j ulong 64
if ne get nb_u add s j get nb_hx j
ret false
end
end
ret true
end
fn nb_sums to int
s = ulong 0
while lt s get nb_un 0 bound 65
e = nb_line s
n = nb_load
if gt n len sh_dat
nb_unr
end
sh_all n
nb_hex
put nb_hx 64 32
r = write 1 nb_hx 0 65
r = write 1 nb_p 0 get nb_pn 0
put nb_d 0 10
r = write 1 nb_d 0 1
s = e
end
ret 0
end
fn nb_cat to ulong
s = ulong 0
u = ulong 0
while lt s get nb_un 0 bound 65
e = nb_line s
n = nb_load
if gt n len sh_dat
nb_unr
end
sh_all n
nb_hex
if not nb_same s
nb_say 7
r = write 2 nb_p 0 get nb_pn 0
nb_say 8
r = write 2 nb_hx 0 64
nb_nl
exit 3
end
nb_app n
u = add u 1
s = e
end
ret u
end
fn nb_app n ulong to void
o = get nb_sn 0
if gt add o n sub len nb_src 1
nb_unr
end
for j ulong n bound 16777216
put nb_src add o j get sh_dat j
end
put nb_sn 0 add o n
end
note ---- child --------------------------------------------------------------------------------
fn nb_avadd i ulong to void
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
p = get nb_ap 0
put nb_av p uchar and n 255
put nb_av add p 1 uchar shr n 8
for j ulong n bound 4096
put nb_av add add p 2 j get nb_a add o j
end
put nb_ap 0 add add p 2 n
end
note OUT path (argument 4) plus ".src" into nb_p when src, else OUT alone
fn nb_out src bool to void
nb_ap2p 4
if src
n = get nb_pn 0
for j ulong 4
put nb_p add n j get nb_txt add 11 j
end
put nb_pn 0 add n 4
end
end
fn nb_wsrc to void
nb_out true
fd = fopen nb_p 0 get nb_pn 0 577 420
if lt fd 0
nb_say 12
nb_nl
exit 6
end
n = get nb_sn 0
o = ulong 0
while lt o n bound 16777216
k = write int fd nb_src o sub n o
if le k 0
nb_say 12
nb_nl
exit 6
end
o = add o ulong k
end
r = fclose int fd
end
fn nb_omc to ulong
nb_out true
fi = fopen nb_p 0 get nb_pn 0 0 0
nb_out false
fo = fopen nb_p 0 get nb_pn 0 577 493
if or lt fi 0 lt fo 0
nb_say 12
nb_nl
exit 6
end
put nb_ap 0 2
nb_avadd 2
put nb_av 0 1
put nb_av 1 0
pid = fork
if lt pid 0
nb_fail
end
if eq pid 0
if ne dupfd int fi 0 0 0
exit 127
end
if ne dupfd int fo 1 0 1
exit 127
end
r = execprog nb_av 0 get nb_ap 0
exit 127
end
r = fclose int fi
r = fclose int fo
w = waitpid int pid nb_st 0 4 0
if ne w pid
nb_fail
end
if ne get nb_st 0 0
nb_fail
end
ret ulong get nb_st 1
end
fn nb_fail to void
nb_say 13
nb_nl
exit 7
end
fn nb_build to int
nb_units 3
u = nb_cat
nb_wsrc
x = nb_omc
if ne x 0
nb_say 9
nb_num x
nb_nl
ret 1
end
nb_out false
n = nb_load
if gt n len sh_dat
nb_unr
end
sh_all n
nb_hex
put nb_hx 64 10
k = nb_okline u
ret 0
end
fn nb_okline u ulong to long
nb_say 4
nb_num u
nb_say 5
nb_num get nb_sn 0
nb_say 6
ret write 2 nb_hx 0 65
end
fn main to int
c = argcnt
if lt c 2
nb_say 14
nb_nl
ret 2
end
for i ulong ulong c bound 64
if not nb_arg i
nb_say 14
nb_nl
ret 2
end
end
if and eq c 3 nb_aeq 1 2
nb_units 2
ret nb_sums
end
if and eq c 5 nb_aeq 1 1
ret nb_build
end
nb_say 14
nb_nl
ret 2
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngbuild.om: builds an Omega program from an ordered list of sha256-pinned units (D1b): ng
note from seed/ng/ng.units, ngbuild itself from seed/ng/ngbuild.units, each NG tool from its own
note seed/ng/TOOL.units (seed/ng/README.md). Owner: ng-ir lane.
note First birth, no cat: seed/ng/tests/ngbuild/gate.om joins seed/ng/ngbuild.units itself, compiles it,
note and requires the result to rebuild itself byte for byte with every pin checked (README.md).
note Run from the repository root.
note   ngbuild build OMC UNITS OUT   check UNITS and every unit's sha256 pin, concatenate the units in
note                                 order into OUT.src (exactly the bytes `cat` of the listed paths
note                                 writes: nothing is added between units), compile it with OMC
note                                 (stdin OUT.src, stdout OUT, mode 0755), print on stderr
note                                 "ngbuild: OK units=N bytes=M sha256=HEX" (sha256 of OUT)
note   ngbuild sums UNITS            print each unit's current "HEX PATH" line (to refresh UNITS)
note UNITS: one unit per line, "HEX PATH": 64 lowercase hex digits, one space, a path (relative to the
note working directory, or absolute; 1..4095 bytes, no NUL), a newline. No other lines. The line order is the build
note order; there is no dependency metadata, so a cycle cannot be written. At most 64 units, UNITS at
note most 65536 bytes, the units at most 8388607 bytes in total (the omc input capacity, OMEGESE s9.6).
note The whole of UNITS is checked before any unit is read, and every unit before OUT.src is opened
note or OMC runs; so exits 2..5, 8 and 9 from those checks write no file and run nothing. After OMC
note exits 0, OUT is read back for its sha256: exit 5 (OUT unreadable) or 9 (OUT of 16777216 bytes or
note more) then leaves OUT.src and OUT.
note Exit 0 built (or sums printed)
note      1 omc refused: "ngbuild: omc exit N" (omc's own stderr line passes through); an exec or
note        redirect failure in the child is "ngbuild: omc exit 127"
note      2 usage, also any argument count other than build's 4 or sums' 2 (checked before any is read)
note      3 a pin is not the unit's sha256: "ngbuild: sha256 mismatch PATH have HEX"
note      4 malformed UNITS: "ngbuild: malformed units line OFFSET" (byte offset of the line), or
note        "ngbuild: no units" (empty UNITS)
note      5 UNITS or a unit unreadable (missing, a directory): "ngbuild: unreadable: PATH"
note      6 OUT.src or OUT not writable: "ngbuild: cannot write output"
note      7 fork or wait failed, or OMC ended by a signal: "ngbuild: fork or wait failed, or omc ended
note        by a signal"; OUT.src, and OUT once opened, can remain after exits 1, 6 and 7
note      8 a unit listed twice: the same path on two lines, or (build) the same pin on two lines:
note        "ngbuild: duplicate unit line N: PATH" (N counts from 1; the later of the two lines)
note      9 over a limit: "ngbuild: more than 64 units", or "ngbuild: too large: PATH" for UNITS over
note        65536 bytes, a unit of 16777216 bytes or more, or (build) the unit that takes the total
note        past 8388607 bytes
text nb_txt "build\nsums\n.src\nngbuild: OK units=\n bytes=\n sha256=\nngbuild: sha256 mismatch \n have \nngbuild: omc exit \nngbuild: malformed units line \nngbuild: unreadable: \nngbuild: cannot write output\nngbuild: fork or wait failed, or omc ended by a signal\nngbuild: usage: ngbuild build OMC UNITS OUT | ngbuild sums UNITS\nngbuild: too large: \nngbuild: more than 64 units\nngbuild: no units\nngbuild: duplicate unit line \n: \n"
global nb_u uchar 65536
global nb_un ulong 1
global nb_src uchar 8388608
global nb_sn ulong 1
global nb_a uchar 4096
global nb_al ulong 128
global nb_p uchar 4096
global nb_pn ulong 1
global nb_hx uchar 66
global nb_d uchar 24
global nb_st uchar 4
global nb_av uchar 8192
global nb_ap ulong 2
note unit k: its line starts at nb_ls[k] (the pin), its path (nb_pl[k] bytes) at nb_ls[k] + 65
global nb_ls ulong 64
global nb_pl ulong 64
global nb_uc ulong 1
note ---- output ---------------------------------------------------------------------------------
note line k (1-based) of nb_txt, without its newline
fn nb_say k ulong to void
s = ulong 0
c = ulong 1
for i ulong len nb_txt
if eq get nb_txt i 10
if eq c k
r = write 2 nb_txt s sub i s
ret
end
c = add c 1
s = add i 1
end
end
end
fn nb_nl to void
put nb_d 0 10
r = write 2 nb_d 0 1
end
fn nb_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put nb_d i uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 2 nb_d i sub 24 i
ret
end
end
end
note message line k, the path in nb_p, a newline; exit x
fn nb_sayp k ulong x int to void
nb_say k
r = write 2 nb_p 0 get nb_pn 0
nb_nl
exit x
end
note hex of sh_dig into nb_hx[0..64)
fn nb_hex to void
for j ulong 32
b = uint get sh_dig j
put nb_hx mul j 2 sh_hexd shr b 4
put nb_hx add mul j 2 1 sh_hexd and b 15
end
end
note ---- arguments and files --------------------------------------------------------------------
note argument i into nb_a at offset nb_al[2i], length nb_al[2i+1]; false when absent or too long
fn nb_arg i ulong to bool
o = ulong 0
if gt i 0
o = add get nb_al sub mul i 2 2 get nb_al sub mul i 2 1
end
k = argread i nb_a o sub len nb_a o
if lt k 0
ret false
end
put nb_al mul i 2 o
put nb_al add mul i 2 1 ulong k
ret true
end
fn nb_aeq i ulong w ulong to bool
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
s = ulong 0
c = ulong 1
for j ulong len nb_txt
if eq get nb_txt j 10
if eq c w
if ne n sub j s
ret false
end
for q ulong n bound 4096
if ne get nb_a add o q get nb_txt add s q
ret false
end
end
ret true
end
c = add c 1
s = add j 1
end
end
ret false
end
note read the file at nb_p[0..nb_pn) into sh_dat: its length; the capacity + 1 when it holds the
note capacity or more (too large), the capacity + 2 when it cannot be opened or read (unreadable)
fn nb_load to ulong
fd = fopen nb_p 0 get nb_pn 0 0 0
if lt fd 0
ret add len sh_dat 2
end
n = ulong 0
while lt n len sh_dat bound 16777217
k = read int fd sh_dat n sub len sh_dat n
if lt k 0
r = fclose int fd
ret add len sh_dat 2
end
if eq k 0
r = fclose int fd
ret n
end
n = add n ulong k
end
r = fclose int fd
ret add len sh_dat 1
end
note refuse a file nb_load could not take (n its result): unreadable 5, too large 9
fn nb_chk n ulong to void
if eq n add len sh_dat 2
nb_sayp 11 5
end
if gt n len sh_dat
nb_sayp 15 9
end
end
note path of argument i into nb_p
fn nb_ap2p i ulong to void
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
for j ulong n bound 4096
put nb_p j get nb_a add o j
end
put nb_pn 0 n
end
note read UNITS (argument i) into nb_u
fn nb_units i ulong to void
nb_ap2p i
n = nb_load
nb_chk n
if gt n len nb_u
nb_sayp 15 9
end
for j ulong n bound 65536
put nb_u j get sh_dat j
end
put nb_un 0 n
end
note ---- units ----------------------------------------------------------------------------------
note parse the line at nb_u[s..) as unit k (format above) into nb_ls, nb_pl; the offset after its newline
fn nb_line s ulong k ulong to ulong
n = get nb_un 0
if gt add s 66 n
nb_bad s
end
for j ulong 64
c = get nb_u add s j
if not or and ge c 48 le c 57 and ge c 97 le c 102
nb_bad s
end
end
if ne get nb_u add s 64 32
nb_bad s
end
p = add s 65
e = p
while lt e n bound 65536
c = get nb_u e
if eq c 10
break
end
if eq c 0
nb_bad s
end
e = add e 1
end
if or or ge e n eq e p gt sub e p 4095
nb_bad s
end
put nb_ls k s
put nb_pl k sub e p
ret add e 1
end
fn nb_bad s ulong to void
nb_say 10
nb_num s
nb_nl
exit 4
end
note path of unit k into nb_p
fn nb_setp k ulong to void
p = add get nb_ls k 65
n = get nb_pl k
for j ulong n bound 4096
put nb_p j get nb_u add p j
end
put nb_pn 0 n
end
fn nb_eqb a ulong b ulong n ulong to bool
for j ulong n bound 4096
if ne get nb_u add a j get nb_u add b j
ret false
end
end
ret true
end
note true when units i and k have the same path, or (pins) the same pin
fn nb_dup i ulong k ulong pins bool to bool
a = get nb_ls i
b = get nb_ls k
n = get nb_pl i
if eq n get nb_pl k
if nb_eqb add a 65 add b 65 n
ret true
end
end
if pins
ret nb_eqb a b 64
end
ret false
end
note check all of UNITS before any unit is read: every line well formed (4), at least one unit (4),
note at most 64 (9), no path twice and (pins) no pin twice (8); sets nb_uc
fn nb_scan pins bool to void
s = ulong 0
u = ulong 0
while lt s get nb_un 0 bound 65
if eq u 64
nb_say 16
nb_nl
exit 9
end
s = nb_line s u
u = add u 1
end
if eq u 0
nb_say 17
nb_nl
exit 4
end
put nb_uc 0 u
for k ulong u bound 64
for i ulong k bound 64
if nb_dup i k pins
nb_setp k
nb_say 18
nb_num add k 1
nb_say 19
r = write 2 nb_p 0 get nb_pn 0
nb_nl
exit 8
end
end
end
end
note true when the 64 hex digits at nb_u[s..) equal nb_hx
fn nb_same s ulong to bool
for j ulong 64
if ne get nb_u add s j get nb_hx j
ret false
end
end
ret true
end
fn nb_sums to int
nb_scan false
for k ulong get nb_uc 0 bound 64
nb_setp k
n = nb_load
nb_chk n
sh_all n
nb_hex
put nb_hx 64 32
r = write 1 nb_hx 0 65
r = write 1 nb_p 0 get nb_pn 0
put nb_d 0 10
r = write 1 nb_d 0 1
end
ret 0
end
note every unit in order: its size against the total (9), its pin (3), then appended to nb_src
fn nb_cat to void
for k ulong get nb_uc 0 bound 64
nb_setp k
n = nb_load
nb_chk n
o = get nb_sn 0
if gt add o n sub len nb_src 1
nb_sayp 15 9
end
sh_all n
nb_hex
if not nb_same get nb_ls k
nb_say 7
r = write 2 nb_p 0 get nb_pn 0
nb_say 8
r = write 2 nb_hx 0 64
nb_nl
exit 3
end
for j ulong n bound 8388608
put nb_src add o j get sh_dat j
end
put nb_sn 0 add o n
end
end
note ---- child --------------------------------------------------------------------------------
fn nb_avadd i ulong to void
o = get nb_al mul i 2
n = get nb_al add mul i 2 1
p = get nb_ap 0
put nb_av p uchar and n 255
put nb_av add p 1 uchar shr n 8
for j ulong n bound 4096
put nb_av add add p 2 j get nb_a add o j
end
put nb_ap 0 add add p 2 n
end
note OUT path (argument 4) plus ".src" into nb_p when src, else OUT alone
fn nb_out src bool to void
nb_ap2p 4
if src
n = get nb_pn 0
for j ulong 4
put nb_p add n j get nb_txt add 11 j
end
put nb_pn 0 add n 4
end
end
fn nb_wsrc to void
nb_out true
fd = fopen nb_p 0 get nb_pn 0 577 420
if lt fd 0
nb_say 12
nb_nl
exit 6
end
n = get nb_sn 0
o = ulong 0
while lt o n bound 16777216
k = write int fd nb_src o sub n o
if le k 0
nb_say 12
nb_nl
exit 6
end
o = add o ulong k
end
r = fclose int fd
end
fn nb_omc to ulong
nb_out true
fi = fopen nb_p 0 get nb_pn 0 0 0
nb_out false
fo = fopen nb_p 0 get nb_pn 0 577 493
if or lt fi 0 lt fo 0
nb_say 12
nb_nl
exit 6
end
put nb_ap 0 2
nb_avadd 2
put nb_av 0 1
put nb_av 1 0
pid = fork
if lt pid 0
nb_fail
end
if eq pid 0
if ne dupfd int fi 0 0 0
exit 127
end
if ne dupfd int fo 1 0 1
exit 127
end
r = execprog nb_av 0 get nb_ap 0
exit 127
end
r = fclose int fi
r = fclose int fo
w = waitpid int pid nb_st 0 4 0
if ne w pid
nb_fail
end
if ne get nb_st 0 0
nb_fail
end
ret ulong get nb_st 1
end
fn nb_fail to void
nb_say 13
nb_nl
exit 7
end
fn nb_build to int
nb_units 3
nb_scan true
nb_cat
nb_wsrc
x = nb_omc
if ne x 0
nb_say 9
nb_num x
nb_nl
ret 1
end
nb_out false
n = nb_load
nb_chk n
sh_all n
nb_hex
put nb_hx 64 10
k = nb_okline get nb_uc 0
ret 0
end
fn nb_okline u ulong to long
nb_say 4
nb_num u
nb_say 5
nb_num get nb_sn 0
nb_say 6
ret write 2 nb_hx 0 65
end
fn main to int
c = argcnt
if or lt c 3 gt c 5
nb_say 14
nb_nl
ret 2
end
for i ulong ulong c bound 64
if not nb_arg i
nb_say 14
nb_nl
ret 2
end
end
if and eq c 3 nb_aeq 1 2
nb_units 2
ret nb_sums
end
if and eq c 5 nb_aeq 1 1
ret nb_build
end
nb_say 14
nb_nl
ret 2
end

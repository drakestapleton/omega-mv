note SPDX-License-Identifier: Apache-2.0
note seed/ng/sha256.om: FIPS 180-4 SHA-256 over sh_dat[0..n) for the ng build and witness tools
note (ngbuild.om, ngcheck.om). Program mode, OM-1, no fn main; prefix sh_. Owner: ng-ir lane.
note om/sha256/sha256-om2.om cannot be composed into a program unit (its export fn is error 9 there).
note Constants: the 64 round constants then the 8 initial words, decimal, copied from
note seed/qualification/om2/fixtures/sha256-k.dec and sha256-iv.dec (bc-derived, FIPS 180-4 s4.2.2, s5.3.3).
text sh_kiv "1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225"
global sh_k uint 72
global sh_w uint 64
global sh_v uint 8
global sh_h uint 8
global sh_pad uchar 128
global sh_dig uchar 32
global sh_st ulong 2
global sh_dat uchar 16777216
fn sh_init to void
if ne get sh_st 1 0
ret
end
put sh_st 1 1
p = ulong 0
for i ulong 72
v = ulong 0
while lt get sh_kiv p 48 bound 4
p = add p 1
end
while ge get sh_kiv p 48 bound 11
v = add mul v 10 ulong sub get sh_kiv p 48
p = add p 1
if ge p len sh_kiv
put sh_k i uint v
ret
end
end
put sh_k i uint v
end
end
fn sh_rr x uint n uint to uint
ret or shr x n shl x sub 32 n
end
fn sh_s0 a uint to uint
ret xor xor sh_rr a 2 sh_rr a 13 sh_rr a 22
end
fn sh_s1 e uint to uint
ret xor xor sh_rr e 6 sh_rr e 11 sh_rr e 25
end
fn sh_g0 x uint to uint
ret xor xor sh_rr x 7 sh_rr x 18 shr x 3
end
fn sh_g1 x uint to uint
ret xor xor sh_rr x 17 sh_rr x 19 shr x 10
end
fn sh_maj a uint b uint c uint to uint
ret xor xor and a b and a c and b c
end
note big-endian word at byte o of sh_dat (src 0) or sh_pad (src 1)
fn sh_be src ulong o ulong to uint
v = uint 0
for j ulong 4
b = uint 0
if eq src 0
b = uint get sh_dat add o j
else
b = uint get sh_pad add o j
end
v = or shl v 8 b
end
ret v
end
fn sh_rnd i ulong to void
e = get sh_v 4
t1 = add get sh_v 7 sh_s1 e
t1 = add t1 xor and e get sh_v 5 and not e get sh_v 6
t1 = add t1 add get sh_k i get sh_w i
a = get sh_v 0
t2 = add sh_s0 a sh_maj a get sh_v 1 get sh_v 2
put sh_v 7 get sh_v 6
put sh_v 6 get sh_v 5
put sh_v 5 e
put sh_v 4 add get sh_v 3 t1
put sh_v 3 get sh_v 2
put sh_v 2 get sh_v 1
put sh_v 1 a
put sh_v 0 add t1 t2
end
fn sh_blk src ulong o ulong to void
for t ulong 16
put sh_w t sh_be src add o mul t 4
end
for t ulong 48
u = add t 16
x = add sh_g1 get sh_w sub u 2 get sh_w sub u 7
put sh_w u add x add sh_g0 get sh_w sub u 15 get sh_w sub u 16
end
for j ulong 8
put sh_v j get sh_h j
end
for i ulong 64
sh_rnd i
end
for j ulong 8
put sh_h j add get sh_h j get sh_v j
end
end
note digest of sh_dat[0..n) into sh_dig
fn sh_all n ulong to void
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
nb = div n 64
for b ulong nb bound 262144
sh_blk 0 mul b 64
end
r = rem n 64
o = mul nb 64
for j ulong 128
put sh_pad j 0
end
for j ulong r bound 64
put sh_pad j get sh_dat add o j
end
put sh_pad r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul n 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end
fn sh_out to void
for j ulong 8
v = get sh_h j
for q ulong 4
s = uint mul sub 3 q 8
put sh_dig add mul j 4 q uchar and shr v s 255
end
end
end
note lowercase hex digit of the low 4 bits of x
fn sh_hexd x uint to uchar
if lt x 10
ret uchar add x 48
end
ret uchar add x 87
end

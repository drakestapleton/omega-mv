note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngrand.om: seeded random ΩIR programs, valid by construction: the differential source of D9
note (a back end against ngrun). Lane ng-ir. Build:
note   cat seed/ng/src/ir.om seed/ng/ngrand.om | seed/out/omc > ngrand
note Usage:
note   ngrand SEED             the program of SEED (decimal, < 2^64) as an ΩIR binary on stdout
note   ngrand tape FILE        the program of a choice tape (at most 65536 bytes)
note   ngrand shrink SEED STATUS OUT CMD [ARG...]
note                           shrink the tape of SEED while `CMD ARG... OUT` exits STATUS: OUT ends as the
note                           smallest program found and OUT.tape as its tape; one summary line on stdout;
note                           the predicate runs at most 20001 times (20000 while searching, then once more
note                           on the result)
note Every choice is one byte read from the tape; a read past its end gives 0, and 0 is always the
note smallest choice (end the block, a constant, no check, no helper). SEED fills a 65536-byte tape with
note splitmix64. Any tape gives a unit ngcheck accepts, so deleting or zeroing tape bytes shrinks the
note program and keeps it valid; the program is built with src/ir.om and written by its writer.
note The program: global @g0 array i64 16 and @g1 array u8 8 (both zero); @f0 (i64) prints its argument as 8
note little-endian bytes on stdout (host write); helpers @f1..@fH (H 0..3; 0..3 parameters and a result
note of the types i64 i32 u64 u32 i8 u8) call only lower helpers; the export (last) prints the xor of two
note i64 values through @f0 and returns its low 6 bits. Statements: values (const; add sub mul with
note chk.add/sub/mul; div rem with chk.divz/divovf; and or xor min max; shl shr rotl rotr with
note chk.shift/chk.shl; neg with chk.neg, not; conv with chk.conv; bitcast; select; compare), store and
note load of i64 under chk.bounds (the index masked to the array, or 1 time in 8 to twice its length,
note which can trap 3) on @g0 or on a local alloca, calls, if/else diamonds joined by a block parameter
note (the else arm may end in trap, exit 64..95 or an early return), counted loops (0..4 passes,
note chk.fuel 4 with bound 1000000, the counter and an accumulator as header parameters) and chk.true
note with a random code. Nesting depth <= 2. A static cost (ops executed, callee costs included) caps a
note helper at 4000 and the export at 40000, so every program ends: exit 0..63 after printing 8 bytes or
note on an early return, 64..95 by exit, 101..114 by a check or trap.
note Exit: 0; usage 2; shrink: SEED not interesting, or the result not interesting again, 3; IO 27.
note Globals y_*, functions rg_*.
text y_use "usage: ngrand SEED | ngrand tape FILE | ngrand shrink SEED STATUS OUT CMD [ARG...]\n"
text y_wt "tape"
text y_ws "shrink"
text y_dn "/dev/null"
text y_tx ".tape"
text y_io "ngrand: io error\n"
text y_ni "ngrand: not interesting\n"
text y_t1 "ngrand: shrink tape "
text y_t2 " -> "
text y_t3 " bytes, ops "
text y_t4 ", tries "
text y_nl "\n"
global y_tp uchar 65536
global y_bk uchar 65536
global y_s ulong 32
global y_h uint 16
global y_pv uint 65536
global y_pt uint 65536
global y_fc ulong 64
global y_ar uint 64
global y_pa uchar 4096
global y_op uchar 4096
global y_av uchar 65536
global y_stb uchar 4
global y_dg uchar 32
note y_s: 0 tape length, 1 cursor, 5 pool count, 6 depth, 7 cost multiplier, 8 cost, 12 element count of
note the last REF, 13 tries, 14 wanted status, 15 argv bytes, 16 argc, 17 OUT length, 19 cost cap
note y_h: 0 function, 1 current token, 2 current block, 3 local REF value (0 none), 4 @g0, 5 @g1, 6 REF
note to @g0's type, 7 REF to the local array, 8 REF to @g1's type, 9 unused, 10 @f0, 11 the export
note ---- choices -----------------------------------------------------------------------------------
fn rg_b to ulong
c = get y_s 1
put y_s 1 add c 1
if lt c get y_s 0
ret ulong get y_tp c
end
ret 0
end
fn rg_ch n ulong to ulong
ret rem rg_b n
end
fn rg_seed s ulong to void
x = s
for j ulong 8192
x = add x 11400714819323198485
z = x
z = mul xor z shr z 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
z = xor z shr z 31
for k ulong 8
put y_tp add mul j 8 k uchar and shr z mul k 8 255
end
end
put y_s 0 65536
end
note ---- types: the value types i64 i32 u64 u32 i8 u8 -------------------------------------------------
fn rg_ity k ulong to uint
j = rem k 6
if eq j 0
ret 9
end
if eq j 1
ret 8
end
if eq j 2
ret 5
end
if eq j 3
ret 4
end
if eq j 4
ret 6
end
ret 2
end
fn rg_sgn t uint to bool
ret and ge t 6 le t 9
end
fn rg_wid t uint to ulong
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 eq t 8
ret 32
end
ret 64
end
note the type of equal width and the other signedness
fn rg_twin t uint to uint
if ge t 6
ret sub t 4
end
ret add t 4
end
note canonical const imm of v for type t (IR.md s7.2)
fn rg_can t uint v ulong to ulong
if eq t 1
ret and v 1
end
w = rg_wid t
if eq w 64
ret v
end
m = sub shl ulong 1 w 1
x = and v m
if rg_sgn t
if ne and x shl ulong 1 sub w 1 0
ret or x xor m 18446744073709551615
end
end
ret x
end
note a constant: -100..99 (signed) or 0..199 (unsigned) for bytes below 200, else 8 more bytes
fn rg_kv t uint to ulong
b = rg_b
if lt b 200
if rg_sgn t
ret rg_can t sub b 100
end
ret rg_can t b
end
v = ulong 0
for j ulong 8
v = or shl v 8 rg_b
end
ret rg_can t v
end
note ---- emitting ops into the current block ---------------------------------------------------------
fn rg_cost to void
put y_s 8 add get y_s 8 get y_s 7
end
note an op without a token
fn rg_p op uint ty uint imm ulong n uint to uint
rg_cost
ret ir_op get y_h 2 op ty imm n
end
note an effect op (IR.md s6.4): it consumes the current token and its new token becomes current
fn rg_e op uint ty uint imm ulong n uint to uint
rg_cost
o = ir_op get y_h 2 op ty imm n
ir_set o 0 get y_h 1
put y_h 1 ir_otok o
ret o
end
note a terminator or reader with the current token as operand 0
fn rg_t op uint imm ulong n uint to uint
rg_cost
o = ir_op get y_h 2 op 0 imm n
ir_set o 0 get y_h 1
ret o
end
fn rg_k t uint v ulong to uint
o = rg_p 1 t v 0
ret ir_res o
end
fn rg_op2 op uint t uint a uint b uint to uint
o = rg_p op t 0 2
ir_set o 0 a
ir_set o 1 b
ret ir_res o
end
fn rg_op1 op uint t uint a uint to uint
o = rg_p op t 0 1
ir_set o 0 a
ret ir_res o
end
note a check of the random statements with one (n 1) or two (n 2) operands and trap code c; its own
note token step is the site of the gate's mutant (the check's new token not made current)
fn rg_chk op uint c ulong a uint b uint n uint to void
rg_cost
q = ir_op get y_h 2 op 0 c add n 1
ir_set q 0 get y_h 1
put y_h 1 ir_otok q
ir_set q 1 a
if eq n 2
ir_set q 2 b
end
end
fn rg_go b uint to void
put y_h 2 b
put y_h 1 ir_btok b
end
fn rg_cbr c uint bt uint bf uint to void
o = rg_t 61 0 4
ir_set o 1 c
ir_set o 2 bt
ir_set o 3 bf
end
fn rg_br1 b uint v uint to void
rg_cost
o = ir_op get y_h 2 60 0 0 3
ir_set o 0 b
ir_set o 1 get y_h 1
ir_set o 2 v
end
fn rg_br2 b uint v uint w uint to void
rg_cost
o = ir_op get y_h 2 60 0 0 4
ir_set o 0 b
ir_set o 1 get y_h 1
ir_set o 2 v
ir_set o 3 w
end
note ---- the pool of values visible at the current point --------------------------------------------
fn rg_add v uint t uint to void
n = get y_s 5
if lt n 65536
put y_pv n v
put y_pt n t
put y_s 5 add n 1
end
end
fn rg_cnt t uint to ulong
c = ulong 0
for j ulong get y_s 5 bound 65536
if eq get y_pt j t
c = add c 1
end
end
ret c
end
fn rg_nth t uint k ulong to uint
c = ulong 0
for j ulong get y_s 5 bound 65536
if eq get y_pt j t
if eq c k
ret get y_pv j
end
c = add c 1
end
end
ret 0
end
fn rg_kc t uint to uint
v = rg_k t rg_kv t
rg_add v t
ret v
end
note a visible value of type t, or 1 time in 8 (and when there is none) a new constant
fn rg_pick t uint to uint
c = rg_cnt t
if eq c 0
ret rg_kc t
end
b = rg_b
if lt b 32
ret rg_kc t
end
ret rg_nth t rem b c
end
fn rg_bool to uint
c = rg_cnt 1
if gt c 0
b = rg_b
if ge b 128
ret rg_nth 1 rem b c
end
end
t = rg_ity rg_b
a = rg_pick t
b2 = rg_pick t
op = uint add 30 rg_ch 6
v = rg_op2 op 1 a b2
rg_add v 1
ret v
end
note ---- value statements --------------------------------------------------------------------------
fn rg_val to void
t = rg_ity rg_b
k = rg_ch 10
if eq k 0
x = rg_kc t
ret
end
if eq k 8
y = rg_bool
ret
end
v = rg_vx k t
rg_add v t
end
fn rg_vx k ulong t uint to uint
if eq k 1
ret rg_ari t
end
if eq k 2
ret rg_div t
end
if eq k 3
ret rg_bit t
end
if eq k 4
ret rg_sh t
end
if eq k 5
ret rg_neg t
end
if eq k 6
ret rg_cv t
end
if eq k 7
ret rg_sel t
end
ret rg_bc t
end
fn rg_ari t uint to uint
a = rg_pick t
b = rg_pick t
j = rg_ch 3
if eq rg_ch 4 0
rg_chk uint add 70 j 1 a b 2
end
ret rg_op2 uint add 10 j t a b
end
fn rg_div t uint to uint
a = rg_pick t
b = rg_pick t
op = uint add 13 rg_ch 2
if eq rg_ch 2 0
rg_chk 74 2 b 0 1
end
if and eq op 13 rg_sgn t
if eq rg_ch 2 0
rg_chk 75 1 a b 2
end
end
ret rg_op2 op t a b
end
fn rg_bit t uint to uint
a = rg_pick t
b = rg_pick t
j = rg_ch 5
op = uint 16
if eq j 1
op = 17
end
if eq j 2
op = 18
end
if eq j 3
op = 24
end
if eq j 4
op = 25
end
ret rg_op2 op t a b
end
fn rg_sh t uint to uint
a = rg_pick t
b = uint 0
if eq rg_ch 2 0
b = rg_k t rg_ch rg_wid t
else
b = rg_pick t
end
op = uint add 20 rg_ch 2
if not rg_sgn t
op = uint add 20 rg_ch 4
end
if eq rg_ch 3 0
rg_chk 77 7 b 0 1
if and eq op 20 rg_sgn t
rg_chk 76 1 a b 2
end
end
ret rg_op2 op t a b
end
fn rg_neg t uint to uint
a = rg_pick t
if eq rg_ch 2 0
ret rg_op1 19 t a
end
if eq rg_ch 3 0
rg_chk 73 1 a 0 1
end
ret rg_op1 15 t a
end
fn rg_cv t uint to uint
s = rg_ity rg_b
if eq s t
s = rg_twin t
end
a = rg_pick s
if eq rg_ch 3 0
o = rg_e 78 t 5 2
ir_set o 1 a
end
ret rg_op1 36 t a
end
fn rg_sel t uint to uint
c = rg_bool
a = rg_pick t
b = rg_pick t
o = rg_p 2 t 0 3
ir_set o 0 c
ir_set o 1 a
ir_set o 2 b
ret ir_res o
end
fn rg_bc t uint to uint
a = rg_pick rg_twin t
ret rg_op1 37 t a
end
note ---- memory: i64 elements of @g0 (16) or of the local alloca (8) ---------------------------------
fn rg_ref to uint
l = get y_h 3
if ne l 0
if eq rg_ch 2 1
put y_s 12 8
ret l
end
end
put y_s 12 16
o = rg_p 52 get y_h 6 ulong get y_h 4 0
ret ir_res o
end
fn rg_idx to uint
s = rg_ity rg_b
v = rg_pick s
if ne s 5
v = rg_op1 36 5 v
end
m = sub get y_s 12 1
if eq rg_ch 8 7
m = add m get y_s 12
end
k = rg_k 5 m
ret rg_op2 16 5 v k
end
fn rg_bnd r uint i uint to void
e = rg_k 5 1
o = rg_e 79 0 3 4
ir_set o 1 r
ir_set o 2 i
ir_set o 3 e
end
fn rg_st to void
r = rg_ref
i = rg_idx
v = rg_pick 9
rg_bnd r i
o = rg_e 43 0 0 4
ir_set o 1 r
ir_set o 2 i
ir_set o 3 v
end
fn rg_ld to void
r = rg_ref
i = rg_idx
rg_bnd r i
rg_cost
o = ir_op get y_h 2 42 9 0 3
ir_set o 0 get y_h 1
ir_set o 1 r
ir_set o 2 i
rg_add ir_res o 9
end
note ---- calls: a helper below the current function, within the cost cap -----------------------------
fn rg_call to void
f = get y_h 0
if le f 2
rg_val
ret
end
c = uint add 2 rg_ch ulong sub f 2
w = mul get y_s 7 get y_fc c
if gt add get y_s 8 w get y_s 19
rg_val
ret
end
np = uint 0
v = get i_fp1 c
while ne v 0 bound 65
put y_ar np rg_pick get i_vty v
np = add np 1
v = get i_vnx v
end
o = rg_e 64 get i_frs c 0 add np 2
ir_set o 1 c
for j ulong ulong np bound 64
ir_set o uint add j 2 get y_ar j
end
put y_s 8 add get y_s 8 w
rg_add ir_res o get i_frs c
end
fn rg_true to void
c = rg_bool
rg_chk 82 add 1 rg_ch 14 c 0 1
end
note ---- control: diamonds and counted loops --------------------------------------------------------
fn rg_if to void
c = rg_bool
t = rg_ity rg_b
f = get y_h 0
ba = ir_blk f
bb = ir_blk f
bj = ir_blk f
jv = ir_bpar bj t
rg_cbr c ba bb
mk = get y_s 5
put y_s 6 add get y_s 6 1
rg_go ba
rg_stmts 4
rg_br1 bj rg_pick t
put y_s 5 mk
rg_go bb
rg_stmts 4
if eq rg_ch 6 5
rg_endx
else
rg_br1 bj rg_pick t
end
put y_s 5 mk
put y_s 6 sub get y_s 6 1
rg_go bj
rg_add jv t
end
note the else arm's other ends: trap, exit 64..95, an early return
fn rg_endx to void
k = rg_ch 3
if eq k 0
o = rg_t 65 add 1 rg_ch 14 1
ret
end
if eq k 1
v = rg_k 8 add 64 rg_ch 32
o2 = rg_t 66 0 2
ir_set o2 1 v
ret
end
rg_ret
end
note return from the current function: the export returns a constant 0..63, a helper a visible value
fn rg_ret to void
f = get y_h 0
v = uint 0
if eq f get y_h 11
v = rg_k 8 rg_ch 64
else
v = rg_pick get i_frs f
end
o = rg_t 63 0 2
ir_set o 1 v
end
fn rg_loop to void
t = rg_ity rg_b
n = rg_ch 5
a0 = rg_pick t
k0 = rg_k 5 0
h = ir_blk get y_h 0
kp = ir_bpar h 5
ap = ir_bpar h t
rg_br2 h k0 a0
rg_go h
bd = rg_lhd kp n
ex = get y_h 9
ml = get y_s 7
put y_s 7 mul ml add n 1
rg_lbody bd h kp ap t
put y_s 7 ml
rg_go ex
rg_add kp 5
rg_add ap t
end
note the loop head: k < n, to the body or the exit (its handle in y_h 9)
fn rg_lhd kp uint n ulong to uint
kn = rg_k 5 n
c = rg_op2 32 1 kp kn
f = get y_h 0
bd = ir_blk f
ex = ir_blk f
rg_cbr c bd ex
put y_h 9 ex
ret bd
end
fn rg_lbody bd uint h uint kp uint ap uint t uint to void
mk = get y_s 5
put y_s 6 add get y_s 6 1
rg_add kp 5
rg_add ap t
rg_go bd
km = rg_k 5 1000000
rg_chk 81 4 kp km 2
rg_stmts 4
rg_lend h kp ap t
put y_s 5 mk
put y_s 6 sub get y_s 6 1
end
note the back edge: the accumulator combined with a visible value, the counter + 1
fn rg_lend h uint kp uint ap uint t uint to void
v = rg_pick t
j = rg_ch 3
op = uint 10
if eq j 1
op = 18
end
if eq j 2
op = 11
end
a2 = rg_op2 op t ap v
k1 = rg_k 5 1
kq = rg_op2 10 5 kp k1
rg_br2 h kq a2
end
note ---- statements -------------------------------------------------------------------------------
fn rg_stmts m ulong to void
i = ulong 0
while lt i m bound 64
if lt rg_b 40
ret
end
if gt get y_s 8 get y_s 19
ret
end
rg_stmt
i = add i 1
end
end
fn rg_stmt to void
k = rg_ch 16
d = get y_s 6
if lt k 6
rg_val
ret
end
if lt k 8
rg_st
ret
end
if eq k 8
rg_ld
ret
end
if lt k 11
rg_call
ret
end
if and lt k 13 lt d 2
rg_if
ret
end
if and lt k 15 lt d 2
rg_loop
ret
end
if eq k 15
if eq rg_ch 4 0
rg_true
ret
end
end
rg_val
end
note ---- functions -------------------------------------------------------------------------------
fn rg_fn kind uint res uint np ulong to uint
f = ir_fnew kind 0 res
put y_h 0 f
put y_s 5 0
for j ulong np bound 4
p = ir_fpar f rg_ity rg_b
rg_add p get i_vty p
end
b = ir_blk f
put y_h 2 b
put y_h 1 ir_ftok f
put y_s 6 0
put y_s 7 1
put y_s 8 0
put y_h 3 0
if eq rg_ch 2 1
o = rg_e 50 get y_h 7 0 1
put y_h 3 ir_res o
end
ret f
end
fn rg_help to void
res = rg_ity rg_b
np = rg_ch 4
f = rg_fn 0 res np
put y_s 19 4000
rg_stmts 10
rg_ret
put y_fc f get y_s 8
end
fn rg_main to void
f = rg_fn 2 8 0
put y_h 11 f
put y_s 19 40000
rg_stmts 14
x = rg_fold
o = rg_e 64 0 0 3
ir_set o 1 get y_h 10
ir_set o 2 x
m = rg_k 9 63
r = rg_op2 16 9 x m
v = rg_op1 36 8 r
o2 = rg_t 63 0 2
ir_set o2 1 v
end
note x = x * 31 + v over the last 48 visible int values v (as i64), from 0
fn rg_fold to uint
x = rg_k 9 0
k = rg_k 9 31
n = get y_s 5
s = ulong 0
if gt n 48
s = sub n 48
end
for j ulong sub n s bound 65536
v = get y_pv add s j
t = get y_pt add s j
if ne t 1
if ne t 9
v = rg_op1 36 9 v
end
m = rg_op2 12 9 x k
x = rg_op2 10 9 m v
end
end
ret x
end
note @f0 (i64) -> void: 8 bytes of its argument into @g1, then host write 1 @g1 0 8
fn rg_prt to void
f = ir_fnew 0 0 0
put y_h 10 f
put y_h 0 f
p = ir_fpar f 9
b = ir_blk f
put y_h 2 b
put y_h 1 ir_ftok f
put y_s 7 1
o = rg_p 52 get y_h 8 ulong get y_h 5 0
g = ir_res o
for k ulong 8
rg_pb g p k
end
z = rg_k 5 0
n = rg_k 5 8
o2 = rg_e 80 0 3 4
ir_set o2 1 g
ir_set o2 2 z
ir_set o2 3 n
fd = rg_k 8 1
o3 = rg_e 110 9 54 5
ir_set o3 1 fd
ir_set o3 2 g
ir_set o3 3 z
ir_set o3 4 n
o4 = rg_t 62 0 1
put y_fc f 60
end
fn rg_pb g uint p uint k ulong to void
s = rg_k 9 mul k 8
x = rg_op2 21 9 p s
y = rg_op1 36 2 x
i = rg_k 5 k
rg_bnd g i
o = rg_e 43 0 0 4
ir_set o 1 g
ir_set o 2 i
ir_set o 3 y
end
note the whole unit from the tape; the binary is i_out[0, result)
fn rg_gen to ulong
ir_init
put y_s 1 0
put y_h 11 0
ai = ir_tarr 9 16
put y_h 6 ir_tref ai 1 0
al = ir_tarr 9 8
put y_h 7 ir_tref al 1 0
ab = ir_tarr 2 8
put y_h 8 ir_tref ab 1 0
put y_h 4 ir_glob ai 0
put y_h 5 ir_glob ab 0
rg_prt
h = rg_ch 4
for j ulong h bound 4
rg_help
end
rg_main
ret ir_wr
end
note ---- input and output ---------------------------------------------------------------------------
fn rg_put fd int n ulong to bool
o = ulong 0
while lt o n bound 16777217
k = write fd i_out o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
fn rg_num v ulong to void
n = ulong 0
x = v
while true bound 21
put y_dg n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
for j ulong n bound 21
put y_dg 31 get y_dg sub sub n 1 j
r = write 1 y_dg 31 1
end
ret
end
end
end
note argument a into y_pa; its length, or exit 2
fn rg_arg a ulong to ulong
m = argread a y_pa 0 4096
if or le m 0 ge m 4096
r = write 2 y_use 0 len y_use
exit 2
end
ret ulong m
end
note y_pa[0, m) as a decimal u64, or exit 2
fn rg_dec m ulong to ulong
v = ulong 0
for j ulong m bound 4096
c = ulong get y_pa j
if or lt c 48 gt c 57
r = write 2 y_use 0 len y_use
exit 2
end
if gt v 1844674407370955161
r = write 2 y_use 0 len y_use
exit 2
end
w = add mul v 10 sub c 48
if lt w mul v 10
r = write 2 y_use 0 len y_use
exit 2
end
v = w
end
ret v
end
fn rg_ist m ulong to bool
if ne m len y_wt
ret false
end
for j ulong m bound 8
if ne get y_pa j get y_wt j
ret false
end
end
ret true
end
fn rg_iss m ulong to bool
if ne m len y_ws
ret false
end
for j ulong m bound 8
if ne get y_pa j get y_ws j
ret false
end
end
ret true
end
note the tape file named in y_pa[0, m); exit 27 unreadable, 2 when longer than 65536 bytes
fn rg_ltape m ulong to void
fd = fopen y_pa 0 m 524288 0
if lt fd 0
r = write 2 y_io 0 len y_io
exit 27
end
n = ulong 0
while true bound 65538
if ge n len y_tp
k = read int fd y_bk 0 1
if ne k 0
r = write 2 y_use 0 len y_use
exit 2
end
put y_s 0 n
ret
end
k = read int fd y_tp n sub len y_tp n
if lt k 0
r = write 2 y_io 0 len y_io
exit 27
end
if eq k 0
put y_s 0 n
ret
end
n = add n ulong k
end
end
note ---- shrink ------------------------------------------------------------------------------------
note write i_out[0, n) to OUT (y_op); with x 1 to OUT.tape the tape instead
fn rg_wout n ulong x ulong to bool
m = get y_s 17
if eq x 1
for j ulong len y_tx bound 8
put y_op add m j get y_tx j
end
m = add m len y_tx
end
fd = fopen y_op 0 m 524865 420
if lt fd 0
ret false
end
ok = true
if eq x 1
o = ulong 0
while lt o get y_s 0 bound 65537
k = write int fd y_tp o sub get y_s 0 o
if le k 0
ok = false
o = get y_s 0
else
o = add o ulong k
end
end
else
ok = rg_put int fd n
end
r = fclose int fd
ret ok
end
fn rg_aend n ulong to void
p = get y_s 15
put y_av p uchar and n 255
put y_av add p 1 uchar shr n 8
put y_s 15 add p add n 2
c = add get y_s 16 1
put y_s 16 c
put y_av 0 uchar and c 255
put y_av 1 uchar shr c 8
end
note argv of the predicate: arguments 5 .. argcnt-1, then OUT
fn rg_argv to void
put y_s 15 2
put y_s 16 0
for a ulong ulong sub argcnt 5 bound 1024
m = rg_arg add a 5
p = add get y_s 15 2
if gt add p m 65000
r = write 2 y_use 0 len y_use
exit 2
end
for j ulong m bound 4096
put y_av add p j get y_pa j
end
rg_aend m
end
p = add get y_s 15 2
m = get y_s 17
for j ulong m bound 4096
put y_av add p j get y_op j
end
rg_aend m
end
fn rg_redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note generate the current tape into OUT, run the predicate; true when it exits with the wanted status.
note A true result also cuts the tape to the bytes the generator read.
fn rg_try to bool
n = rg_gen
put y_s 13 add get y_s 13 1
if not rg_wout n 0
r = write 2 y_io 0 len y_io
exit 27
end
nul = fopen y_dn 0 len y_dn 524290 0
if lt nul 0
r = write 2 y_io 0 len y_io
exit 27
end
pid = fork
if lt pid 0
exit 27
end
if eq pid 0
rg_redir int nul 0
rg_redir int nul 1
rg_redir int nul 2
r = execprog y_av 0 get y_s 15
exit 127
end
r = fclose int nul
w = waitpid int pid y_stb 0 len y_stb 0
if ne w pid
exit 27
end
if ne get y_stb 0 0
ret false
end
if ne ulong get y_stb 1 get y_s 14
ret false
end
if lt get y_s 1 get y_s 0
put y_s 0 get y_s 1
end
ret true
end
note delete tape bytes [i, i+c) (fewer at the end); kept when the predicate still holds
fn rg_del i ulong c ulong to bool
n = get y_s 0
e = add i c
if gt e n
e = n
end
k = sub e i
rg_save i n
rg_shft i sub n k k
put y_s 0 sub n k
if rg_try
ret true
end
rg_back i n
put y_s 0 n
ret false
end
note y_tp[i+j] = y_bk[i+j+k] for i+j < m
fn rg_shft i ulong m ulong k ulong to void
for j ulong sub m i bound 65536
p = add i j
put y_tp p get y_bk add p k
end
end
fn rg_save i ulong n ulong to void
for j ulong sub n i bound 65536
put y_bk add i j get y_tp add i j
end
end
fn rg_back i ulong n ulong to void
for j ulong sub n i bound 65536
put y_tp add i j get y_bk add i j
end
end
note tape byte i = v; kept when the predicate still holds; refused once the search has used its 20000 tries
fn rg_set i ulong v ulong to bool
if ge get y_s 13 20000
ret false
end
b = get y_tp i
put y_tp i uchar v
if rg_try
ret true
end
put y_tp i b
ret false
end
note one round: delete every run of 64, 32 and 16 down to 1 bytes, then zero or halve single bytes;
note true on change
fn rg_round to bool
ch = false
for q ulong 18
c = ulong 64
if eq q 1
c = 32
end
if gt q 1
c = sub 18 q
end
if rg_dels c
ch = true
end
end
for i ulong get y_s 0 bound 65536
if lt i get y_s 0
b = ulong get y_tp i
if ne b 0
if rg_set i 0
ch = true
else
if gt b 1
if rg_set i div b 2
ch = true
end
end
end
end
end
end
ret ch
end
note delete runs of c bytes at every position (the next try starts at the same position after a kept
note deletion, one byte later otherwise); true when one was kept
fn rg_dels c ulong to bool
ch = false
i = ulong 0
while lt i get y_s 0 bound 1048576
if ge get y_s 13 20000
ret ch
end
if rg_del i c
ch = true
else
i = add i 1
end
end
ret ch
end
fn rg_shr to int
if lt argcnt 6
r = write 2 y_use 0 len y_use
ret 2
end
seed = rg_dec rg_arg 2
put y_s 14 rg_dec rg_arg 3
m = rg_arg 4
if gt m 4000
r = write 2 y_use 0 len y_use
ret 2
end
for j ulong m bound 4096
put y_op j get y_pa j
end
put y_s 17 m
rg_argv
put y_s 13 0
rg_seed seed
if not rg_try
r = write 2 y_ni 0 len y_ni
ret 3
end
t0 = get y_s 0
o0 = get i_n 5
while rg_round bound 64
end
if not rg_try
r = write 2 y_ni 0 len y_ni
ret 3
end
if not rg_wout 0 1
r = write 2 y_io 0 len y_io
ret 27
end
r = write 1 y_t1 0 len y_t1
rg_num t0
r = write 1 y_t2 0 len y_t2
rg_num get y_s 0
r = write 1 y_t3 0 len y_t3
rg_num o0
r = write 1 y_t2 0 len y_t2
rg_num get i_n 5
r = write 1 y_t4 0 len y_t4
rg_num get y_s 13
r = write 1 y_nl 0 len y_nl
ret 0
end
fn main to int
if lt argcnt 2
r = write 2 y_use 0 len y_use
ret 2
end
m = rg_arg 1
if rg_iss m
ret rg_shr
end
if rg_ist m
if ne argcnt 3
r = write 2 y_use 0 len y_use
ret 2
end
m2 = rg_arg 2
rg_ltape m2
else
if ne argcnt 2
r = write 2 y_use 0 len y_use
ret 2
end
rg_seed rg_dec m
end
n = rg_gen
if not rg_put 1 n
r = write 2 y_io 0 len y_io
ret 27
end
ret 0
end

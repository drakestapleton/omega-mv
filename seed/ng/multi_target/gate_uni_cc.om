note SPDX-License-Identifier: Apache-2.0
note seed/ng/multi_target/gate_uni_cc.om: Pure seeded OM-2 End-to-End Multi-Target Gate for uni_cc.om.
note Compose after seed/ng/sha256.om:
note   { printf 'om2\n'; cat seed/ng/sha256.om seed/ng/multi_target/gate_uni_cc.om; } | seed/out/omc > gate_uni_cc
note Usage:
note   gate_uni_cc UNI_CC_BIN TOOLS_DIR SCRATCH_DIR [CHIPS_TSV]

global guUni uchar 2048
global guUniN ulong 1
global guTools uchar 2048
global guToolsN ulong 1
global guScr uchar 2048
global guScrN ulong 1
global guChips uchar 2048
global guChipsN ulong 1

global guPa uchar 4096
global guPb uchar 4096
global guPc uchar 4096
global guAv uchar 8192
global guAp ulong 2
global guSt uchar 8

global guB1 uchar 65536
global guB2 uchar 65536
global guIo uchar 4096
global guDig uchar 24
global guChk ulong 1
global guCtrl ulong 1

text guUse "usage: gate_uni_cc UNI_CC_BIN TOOLS_DIR SCRATCH_DIR [CHIPS_TSV]\n"
text guDefChips "seed/ng/target/chips.tsv"
text guDevNull "/dev/null"

text guHdr "=== OMEGA NG UNIVERSAL MULTI-TARGET COMPILER (uni_cc) GATE ===\n"
text guFailA "NG-UNI-CC-GATE FAIL step="
text guFailB " got="
text guPassA "NG-UNI-CC-GATE PASS checks="
text guPassB " controls="
text guNl "\n"

text guM_arm64 "  PASS [arm64-linux] native_exit=36 det=2x HOST-VERIFIED\n"
text guM_apple "  PASS [apple-m] Mach-O=32808B magic=0xfeedfacf det=2x (live MacBook run separate)\n"
text guM_x64 "  PASS [x64-linux] EM_X86_64=62 qemu-x86_64_exit=36 det=2x ELF BUILT + EMULATED\n"
text guM_rv64 "  PASS [rv64-elf] EM_RISCV=243 qemu-riscv64_exit=36 det=2x ELF BUILT + EMULATED\n"
text guM_wasm "  PASS [wasm] irwasm det=2x node(7,5,3)=36 HOST-VERIFIED\n"
text guM_spv "  PASS [spirv] vkspirv(spirv-val=vulkan1.3) + pure-OM val/run([36,90,18,450]) HOST-VERIFIED\n"
text guM_xe "  PASS [intel-xe] 128-bit Xe EU isa check=0 zero-SWSB_mutant=1 ISA-VALIDATED\n"
text guM_sm "  PASS [sm121] bw_enc_sm121 monk_check=0 digest_tamper=12 stall_shave=17 MONK-VERIFIED\n"
text guM_fut "  PASS [zero-recompile] future-chip-2030 emitted=PASS over_limit=72 l2_24m_guard=72\n"

text guRecipeText "note OIR v2 universal multi-target kernel recipe\n@pure @exact\n@smem 0\n@regs 3\n@l2_kb 64\n@args 7 5 3\n@ops add mul\nfn kfn a ulong b ulong c ulong to ulong\nret mul add a b c\nend\n"
text guNodeScript "const fs=require('fs');const m=new WebAssembly.Module(fs.readFileSync(process.argv[2]));const r=new WebAssembly.Instance(m).exports.kfn(7n,5n,3n);if(r!==36n)process.exit(1);\n"
text guFutRow "future-chip-2030\tFutureCorp\tQuantum-2030\t1\t21\tintel-xe\t128\t128\t262144\t16\t256\t32768\t128\t393225\tAdded dynamically without compiler recompile\n"

text guQemuX64 "/usr/bin/qemu-x86_64"
text guQemuRv64 "/usr/bin/qemu-riscv64"
text guNode "/usr/bin/node"
text guSpvValSys "/usr/bin/spirv-val"

text guTIrWasm "/irwasm"
text guTVkSpv "/vkspirv"
text guTSpvVal "/spv_val"
text guTSpvRun "/spv_run"
text guTXeIsa "/xe_isa"
text guTMonk "/monk_check"

text guFRec "/recipe.om"
text guFArm1 "/arm64_1.elf"
text guFArm2 "/arm64_2.elf"
text guFMac1 "/apple1.macho"
text guFMac2 "/apple2.macho"
text guFX641 "/x64_1.elf"
text guFX642 "/x64_2.elf"
text guFRv641 "/rv64_1.elf"
text guFRv642 "/rv64_2.elf"
text guFIr "/kfn.ir"
text guFWasm1 "/kfn_1.wasm"
text guFWasm2 "/kfn_2.wasm"
text guFNodeJs "/run_wasm.js"
text guFVkSpv1 "/kfn_1.spv"
text guFVkSpv2 "/kfn_2.spv"
text guFCompSpv "/compute.spv"
text guFBadSpv "/bad.spv"
text guFIn0 "/in0.bin"
text guFIn1 "/in1.bin"
text guFOutSpv "/out.bin"
text guFXe "/xe2.bin"
text guFXeMut "/xe2_mut.bin"
text guFSmSass "/sm121.sass"
text guFSmCand "/sm121.sass"
text guFSmCert "/sm121.crt"
text guFSmTamp "/sm121_tamper.sass"
text guFSmShave "/sm121_shave.sass"
text guFSmShCrt "/sm121_shave.crt"
text guFChipsFut "/chips_future.tsv"
text guFFutBin "/future.bin"
text guFBadLim "/over_limit.bin"
text guFBadL2 "/over_l2.bin"

text guFlChips "--chips"
text guFlTgt "--target"
text guFlRec "--recipe"
text guFlOut "--out"
text guFlCert "--cert"
text guFlIr "--ir"
text guFlSmem "--smem"
text guFlL2 "--l2"
text guFlEnv "--target-env"
text guVk13 "vulkan1.3"
text guVk11 "vulkan1.1"
text guChkCmd "check"
text guS4 "4"
text guS200k "200000"
text guS300k "300000"
text guS32k "32768"

text guTgtArm "grace-x925"
text guTgtMac "apple-m"
text guTgtX64 "intel-x64"
text guTgtRv "rv64-rvv"
text guTgtWasm "wasm-universal"
text guTgtSpv "spirv-vulkan"
text guTgtXe "intel-xe2"
text guTgtSm "sm121"
text guTgtFut "future-chip-2030"

fn guWrt s view uchar * to void
  r = write 1 s 0 len s
end

fn guNum v ulong to void
  b = new uchar 24 0
  p = ulong 24
  x = v
  while true bound 24
    p = sub p 1
    put b p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 b p sub 24 p
end

fn guFail step ulong got ulong to int
  guWrt guFailA
  guNum step
  guWrt guFailB
  guNum got
  guWrt guNl
  ret int step
end

fn guAddChk n ulong to void
  put guChk 0 add get guChk 0 n
end

fn guAddCtrl n ulong to void
  put guCtrl 0 add get guCtrl 0 n
end

fn guSetPath dst ulong baseKind ulong suf view uchar * to ulong
  bn = ulong 0
  if eq baseKind 0
    bn = get guScrN 0
    for i ulong bn bound 2048
      b = get guScr i
      if eq dst 0
        put guPa i b
      else
        if eq dst 1
          put guPb i b
        else
          put guPc i b
        end
      end
    end
  else
    bn = get guToolsN 0
    for i ulong bn bound 2048
      b = get guTools i
      if eq dst 0
        put guPa i b
      else
        if eq dst 1
          put guPb i b
        else
          put guPc i b
        end
      end
    end
  end
  for j ulong len suf bound 256
    b = get suf j
    if eq dst 0
      put guPa add bn j b
    else
      if eq dst 1
        put guPb add bn j b
      else
        put guPc add bn j b
      end
    end
  end
  ret add bn len suf
end

fn guAvReset to void
  put guAp 0 2
  put guAp 1 0
end

fn guAvPushLiteral s view uchar * to void
  p = get guAp 0
  n = len s
  put guAv p uchar and n 255
  put guAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put guAv add p i get s i
  end
  put guAp 0 add p n
  put guAp 1 add get guAp 1 1
end

fn guAvPushGlobal kind ulong to void
  n = ulong 0
  if eq kind 0
    n = get guUniN 0
  else
    if eq kind 1
      n = get guChipsN 0
    else
      n = len guPa
    end
  end
  p = get guAp 0
  if eq kind 2
    n = ulong 0
    while lt n 4095 bound 4096
      if eq get guPa n 0
        break
      end
      n = add n 1
    end
  end
  put guAv p uchar and n 255
  put guAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    b = uchar 0
    if eq kind 0
      b = get guUni i
    else
      if eq kind 1
        b = get guChips i
      else
        b = get guPa i
      end
    end
    put guAv add p i b
  end
  put guAp 0 add p n
  put guAp 1 add get guAp 1 1
end

fn guClearPa to void
  for i ulong 4096
    put guPa i uchar 0
  end
end

fn guSetPaScr suf view uchar * to void
  guClearPa
  n = guSetPath 0 0 suf
end

fn guSetPaTool suf view uchar * to void
  guClearPa
  n = guSetPath 0 1 suf
end

fn guLenOf pbKind ulong to ulong
  n = ulong 0
  while lt n 4095 bound 4096
    b = uchar 0
    if eq pbKind 0
      b = get guPa n
    else
      if eq pbKind 1
        b = get guPb n
      else
        b = get guPc n
      end
    end
    if eq b 0
      ret n
    end
    n = add n 1
  end
  ret n
end

fn guExec hasIn bool hasOut bool quiet bool to ulong
  cnt = get guAp 1
  put guAv 0 uchar and cnt 255
  put guAv 1 uchar and shr cnt 8 255
  pid = fork
  if lt pid 0
    exit 92
  end
  if eq pid 0
    if hasIn
      fi = fopen guPb 0 guLenOf 1 0 0
      if lt fi 0
        exit 126
      end
      di = dupfd int fi 0 0
    end
    if hasOut
      fo = fopen guPc 0 guLenOf 2 577 420
      if lt fo 0
        exit 125
      end
      do1 = dupfd int fo 1 0
    else
      if quiet
        dn = fopen guDevNull 0 len guDevNull 2 0
        if ge dn 0
          d1 = dupfd int dn 1 0
        end
      end
    end
    if quiet
      dn2 = fopen guDevNull 0 len guDevNull 2 0
      if ge dn2 0
        d2 = dupfd int dn2 2 0
      end
    end
    r = execprog guAv 0 get guAp 0
    exit 127
  end
  w = waitpid int pid guSt 0 4 0
  ret ulong get guSt 1
end

fn guWritePaText s view uchar * to bool
  ln = guLenOf 0
  fd = fopen guPa 0 ln 577 420
  if lt fd 0
    ret false
  end
  p = ulong 0
  tot = len s
  while lt p tot bound 4096
    k = write int fd s p sub tot p
    if le k 0
      z = fclose int fd
      ret false
    end
    p = add p ulong k
  end
  z = fclose int fd
  ret true
end

fn guReadPaToB dst ulong to long
  ln = guLenOf 0
  fd = fopen guPa 0 ln 0 0
  if lt fd 0
    ret long -1
  end
  tot = ulong 0
  while lt tot 65535 bound 1024
    r = read int fd guIo 0 4096
    if le r 0
      break
    end
    ur = ulong r
    if gt add tot ur 65535
      z = fclose int fd
      ret long -1
    end
    for i ulong ur bound 4096
      if eq dst 0
        put guB1 add tot i get guIo i
      else
        put guB2 add tot i get guIo i
      end
    end
    tot = add tot ur
  end
  z = fclose int fd
  ret long tot
end

fn guWriteB1FromPa n ulong to bool
  ln = guLenOf 0
  fd = fopen guPa 0 ln 577 420
  if lt fd 0
    ret false
  end
  p = ulong 0
  while lt p n bound 1024
    ch = sub n p
    if gt ch 4096
      ch = ulong 4096
    end
    for i ulong ch bound 4096
      put guIo i get guB1 add p i
    end
    w = write int fd guIo 0 ch
    if ne w long ch
      z = fclose int fd
      ret false
    end
    p = add p ch
  end
  z = fclose int fd
  ret true
end

fn guCmpScrFiles s1 view uchar * s2 view uchar * minBytes ulong to bool
  guSetPaScr s1
  n1 = guReadPaToB 0
  guSetPaScr s2
  n2 = guReadPaToB 1
  if or lt n1 long minBytes ne n1 n2
    ret false
  end
  for i ulong ulong n1 bound 65536
    if ne get guB1 i get guB2 i
      ret false
    end
  end
  ret true
end

fn guStartUni chipsIsFut bool tgt view uchar * to void
  guAvReset
  guAvPushGlobal 0
  guAvPushLiteral guFlChips
  if chipsIsFut
    guSetPaScr guFChipsFut
    guAvPushGlobal 2
  else
    guAvPushGlobal 1
  end
  guAvPushLiteral guFlTgt
  guAvPushLiteral tgt
end

fn guPushLitPair flag view uchar * val view uchar * to void
  guAvPushLiteral flag
  guAvPushLiteral val
end

fn guPushScrPair flag view uchar * suf view uchar * to void
  guAvPushLiteral flag
  guSetPaScr suf
  guAvPushGlobal 2
end

fn guFinishUni outSuf view uchar * to ulong
  guPushScrPair guFlOut outSuf
  ret guExec false false true
end

fn guRunUniRecipe tgt view uchar * outSuf view uchar * to ulong
  guStartUni false tgt
  guPushScrPair guFlRec guFRec
  ret guFinishUni outSuf
end

fn guRunUniCert tgt view uchar * outSuf view uchar * certSuf view uchar * to ulong
  guStartUni false tgt
  guPushScrPair guFlRec guFRec
  guPushScrPair guFlCert certSuf
  ret guFinishUni outSuf
end

fn guPrepPbScr suf view uchar * to void
  for i ulong 4096
    put guPb i uchar 0
  end
  n = guSetPath 1 0 suf
end

fn guPrepPcScr suf view uchar * to void
  for i ulong 4096
    put guPc i uchar 0
  end
  n = guSetPath 2 0 suf
end

fn guRunToolStdinStdout toolSuf view uchar * inSuf view uchar * outSuf view uchar * to ulong
  guAvReset
  guSetPaTool toolSuf
  guAvPushGlobal 2
  guPrepPbScr inSuf
  guPrepPcScr outSuf
  ret guExec true true true
end

fn guTestArm64 to int
  rc1 = guRunUniRecipe guTgtArm guFArm1
  rc2 = guRunUniRecipe guTgtArm guFArm2
  if or ne rc1 0 ne rc2 0
    ret guFail 10 rc1
  end
  if not guCmpScrFiles guFArm1 guFArm2 120
    ret guFail 11 0
  end
  guAvReset
  guSetPaScr guFArm1
  guAvPushGlobal 2
  ex = guExec false false true
  if ne ex 36
    ret guFail 12 ex
  end
  guWrt guM_arm64
  guAddChk 3
  ret 0
end

fn guHasB1Magic4 a uchar b uchar c uchar d uchar to bool
  if ne get guB1 0 a
    ret false
  end
  if ne get guB1 1 b
    ret false
  end
  if ne get guB1 2 c
    ret false
  end
  ret eq get guB1 3 d
end

fn guTestAppleM to int
  rc1 = guRunUniRecipe guTgtMac guFMac1
  rc2 = guRunUniRecipe guTgtMac guFMac2
  if or ne rc1 0 ne rc2 0
    ret guFail 20 rc1
  end
  if not guCmpScrFiles guFMac1 guFMac2 32808
    ret guFail 21 0
  end
  if not guHasB1Magic4 uchar 207 uchar 250 uchar 237 uchar 254
    ret guFail 22 0
  end
  if or ne get guB1 4 uchar 12 ne get guB1 7 uchar 1
    ret guFail 23 0
  end
  guWrt guM_apple
  guAddChk 3
  ret 0
end

fn guCheckElfAndQemu isRv bool fSuf view uchar * step ulong to int
  em = or ulong get guB1 18 shl ulong get guB1 19 8
  expEm = ulong 62
  if isRv
    expEm = ulong 243
  end
  if ne em expEm
    ret guFail add step 2 em
  end
  guAvReset
  if isRv
    guAvPushLiteral guQemuRv64
  else
    guAvPushLiteral guQemuX64
  end
  guSetPaScr fSuf
  guAvPushGlobal 2
  ex = guExec false false true
  if ne ex 36
    ret guFail add step 3 ex
  end
  ret 0
end

fn guTestX64 to int
  rc1 = guRunUniRecipe guTgtX64 guFX641
  rc2 = guRunUniRecipe guTgtX64 guFX642
  if or ne rc1 0 ne rc2 0
    ret guFail 30 rc1
  end
  if not guCmpScrFiles guFX641 guFX642 120
    ret guFail 31 0
  end
  r = guCheckElfAndQemu false guFX641 30
  if ne r 0
    ret r
  end
  guWrt guM_x64
  guAddChk 4
  ret 0
end

fn guTestRv64 to int
  rc1 = guRunUniRecipe guTgtRv guFRv641
  rc2 = guRunUniRecipe guTgtRv guFRv642
  if or ne rc1 0 ne rc2 0
    ret guFail 35 rc1
  end
  if not guCmpScrFiles guFRv641 guFRv642 120
    ret guFail 36 0
  end
  r = guCheckElfAndQemu true guFRv641 35
  if ne r 0
    ret r
  end
  guWrt guM_rv64
  guAddChk 4
  ret 0
end

fn guTestWasm to int
  rc = guRunUniRecipe guTgtWasm guFIr
  if ne rc 0
    ret guFail 40 rc
  end
  w1 = guRunToolStdinStdout guTIrWasm guFIr guFWasm1
  w2 = guRunToolStdinStdout guTIrWasm guFIr guFWasm2
  if or ne w1 0 ne w2 0
    ret guFail 41 w1
  end
  if not guCmpScrFiles guFWasm1 guFWasm2 20
    ret guFail 42 0
  end
  if not guHasB1Magic4 uchar 0 uchar 97 uchar 115 uchar 109
    ret guFail 43 0
  end
  guSetPaScr guFNodeJs
  if not guWritePaText guNodeScript
    ret guFail 44 0
  end
  guAvReset
  guAvPushLiteral guNode
  guSetPaScr guFNodeJs
  guAvPushGlobal 2
  guSetPaScr guFWasm1
  guAvPushGlobal 2
  nx = guExec false false true
  if ne nx 0
    ret guFail 45 nx
  end
  guWrt guM_wasm
  guAddChk 4
  ret 0
end

fn guPutU32B1 off ulong v ulong to void
  put guB1 off uchar and v 255
  put guB1 add off 1 uchar and shr v 8 255
  put guB1 add off 2 uchar and shr v 16 255
  put guB1 add off 3 uchar and shr v 24 255
end

fn guGetU32B1 off ulong to ulong
  b0 = ulong get guB1 off
  b1 = shl ulong get guB1 add off 1 8
  b2 = shl ulong get guB1 add off 2 16
  b3 = shl ulong get guB1 add off 3 24
  ret or or b0 b1 or b2 b3
end

fn guTestSpirv to int
  v1 = guRunToolStdinStdout guTVkSpv guFIr guFVkSpv1
  v2 = guRunToolStdinStdout guTVkSpv guFIr guFVkSpv2
  if or ne v1 0 ne v2 0
    ret guFail 50 v1
  end
  if not guCmpScrFiles guFVkSpv1 guFVkSpv2 100
    ret guFail 51 0
  end
  guAvReset
  guAvPushLiteral guSpvValSys
  guAvPushLiteral guFlEnv
  guAvPushLiteral guVk13
  guSetPaScr guFVkSpv1
  guAvPushGlobal 2
  sv1 = guExec false false true
  if ne sv1 0
    ret guFail 52 sv1
  end

  rc = guRunUniRecipe guTgtSpv guFCompSpv
  if ne rc 0
    ret guFail 53 rc
  end
  guAvReset
  guSetPaTool guTSpvVal
  guAvPushGlobal 2
  guAvPushLiteral guFlEnv
  guAvPushLiteral guVk11
  guSetPaScr guFCompSpv
  guAvPushGlobal 2
  ov = guExec false false true
  if ne ov 0
    ret guFail 54 ov
  end
  guAvReset
  guAvPushLiteral guSpvValSys
  guAvPushLiteral guFlEnv
  guAvPushLiteral guVk13
  guSetPaScr guFCompSpv
  guAvPushGlobal 2
  sv2 = guExec false false true
  if ne sv2 0
    ret guFail 55 sv2
  end

  note Run pure-OM gpu/spirv/run.om on in0=[7,10,2,100], in1=[5,20,4,50] -> out=[36,90,18,450]
  guPutU32B1 0 7
  guPutU32B1 4 10
  guPutU32B1 8 2
  guPutU32B1 12 100
  guSetPaScr guFIn0
  if not guWriteB1FromPa 16
    ret guFail 56 0
  end
  guPutU32B1 0 5
  guPutU32B1 4 20
  guPutU32B1 8 4
  guPutU32B1 12 50
  guSetPaScr guFIn1
  if not guWriteB1FromPa 16
    ret guFail 56 1
  end
  guAvReset
  guSetPaTool guTSpvRun
  guAvPushGlobal 2
  guSetPaScr guFCompSpv
  guAvPushGlobal 2
  guAvPushLiteral guS4
  guAvPushLiteral guS4
  guSetPaScr guFOutSpv
  guAvPushGlobal 2
  guSetPaScr guFIn0
  guAvPushGlobal 2
  guSetPaScr guFIn1
  guAvPushGlobal 2
  sr = guExec false false true
  if ne sr 0
    ret guFail 57 sr
  end
  guSetPaScr guFOutSpv
  on = guReadPaToB 0
  if ne on 16
    ret guFail 58 ulong on
  end
  if ne guGetU32B1 0 36
    ret guFail 59 guGetU32B1 0
  end
  if ne guGetU32B1 4 90
    ret guFail 59 guGetU32B1 4
  end
  if ne guGetU32B1 8 18
    ret guFail 59 guGetU32B1 8
  end
  if ne guGetU32B1 12 450
    ret guFail 59 guGetU32B1 12
  end

  note SPIR-V negative control: corrupt magic -> val.om MUST reject exit 1
  guSetPaScr guFCompSpv
  cn = guReadPaToB 0
  put guB1 0 uchar 88
  guSetPaScr guFBadSpv
  if not guWriteB1FromPa ulong cn
    ret guFail 60 0
  end
  guAvReset
  guSetPaTool guTSpvVal
  guAvPushGlobal 2
  guAvPushLiteral guFlEnv
  guAvPushLiteral guVk11
  guSetPaScr guFBadSpv
  guAvPushGlobal 2
  bv = guExec false false true
  if ne bv 1
    ret guFail 61 bv
  end
  guWrt guM_spv
  guAddCtrl 1
  guAddChk 7
  ret 0
end

fn guTestIntelXe to int
  rc = guRunUniRecipe guTgtXe guFXe
  if ne rc 0
    ret guFail 70 rc
  end
  guAvReset
  guSetPaTool guTXeIsa
  guAvPushGlobal 2
  guAvPushLiteral guChkCmd
  guSetPaScr guFXe
  guAvPushGlobal 2
  ck = guExec false false true
  if ne ck 0
    ret guFail 71 ck
  end
  guSetPaScr guFXe
  xn = guReadPaToB 0
  if ne xn 112
    ret guFail 72 ulong xn
  end
  note Negative control: zero SWSB byte (b[1] = 0) -> isa check MUST exit 1
  put guB1 1 uchar 0
  guSetPaScr guFXeMut
  if not guWriteB1FromPa ulong xn
    ret guFail 73 0
  end
  guAvReset
  guSetPaTool guTXeIsa
  guAvPushGlobal 2
  guAvPushLiteral guChkCmd
  guSetPaScr guFXeMut
  guAvPushGlobal 2
  mk = guExec false false true
  if ne mk 1
    ret guFail 74 mk
  end
  guWrt guM_xe
  guAddCtrl 1
  guAddChk 2
  ret 0
end

fn guRunMonk refSuf view uchar * candSuf view uchar * certSuf view uchar * to ulong
  guAvReset
  guSetPaTool guTMonk
  guAvPushGlobal 2
  guSetPaScr refSuf
  guAvPushGlobal 2
  guSetPaScr candSuf
  guAvPushGlobal 2
  guSetPaScr certSuf
  guAvPushGlobal 2
  ret guExec false false true
end

fn guTestSm121 to int
  rc = guRunUniCert guTgtSm guFSmSass guFSmCert
  if ne rc 0
    ret guFail 80 rc
  end
  mr = guRunMonk guFSmSass guFSmCand guFSmCert
  if ne mr 0
    ret guFail 81 mr
  end

  note Negative control 1: 1-byte unsigned SASS tamper -> monk_check MUST exit 12 (digest-spoof)
  guSetPaScr guFSmSass
  sn = guReadPaToB 0
  if ne sn 512
    ret guFail 82 ulong sn
  end
  put guB1 0 xor get guB1 0 uchar 1
  guSetPaScr guFSmTamp
  if not guWriteB1FromPa ulong sn
    ret guFail 83 0
  end
  mt1 = guRunMonk guFSmSass guFSmTamp guFSmCert
  if ne mt1 12
    ret guFail 84 mt1
  end

  note Negative control 2: self-signed stall shave 6 -> 2 at pc=3 IADD3 -> MUST exit 17 (sm121-hazard)
  guSetPaScr guFSmSass
  sn2 = guReadPaToB 0
  off = ulong 61
  b13 = get guB1 off
  put guB1 off or and b13 uchar 225 uchar 4
  guSetPaScr guFSmShave
  if not guWriteB1FromPa ulong sn2
    ret guFail 85 0
  end
  for i ulong ulong sn2 bound 16384
    put sh_dat i get guB1 i
  end
  sh_all ulong sn2
  guSetPaScr guFSmCert
  cn = guReadPaToB 0
  for i ulong 32
    put guB1 add 40 i get sh_dig i
  end
  guSetPaScr guFSmShCrt
  if not guWriteB1FromPa ulong cn
    ret guFail 86 0
  end
  mt2 = guRunMonk guFSmSass guFSmShave guFSmShCrt
  if ne mt2 17
    ret guFail 87 mt2
  end
  guWrt guM_sm
  guAddCtrl 2
  guAddChk 3
  ret 0
end

fn guTestZeroRecompile to int
  fd = fopen guChips 0 get guChipsN 0 0 0
  if lt fd 0
    ret guFail 90 0
  end
  tot = ulong 0
  while lt tot 60000 bound 1024
    r = read int fd guB1 tot sub 60000 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose int fd
  if and gt tot 0 ne get guB1 sub tot 1 10
    put guB1 tot uchar 10
    tot = add tot 1
  end
  for i ulong len guFutRow bound 512
    put guB1 add tot i get guFutRow i
  end
  tot = add tot len guFutRow
  guSetPaScr guFChipsFut
  if not guWriteB1FromPa tot
    ret guFail 91 0
  end

  guStartUni true guTgtFut
  guPushLitPair guFlSmem guS200k
  rc1 = guFinishUni guFFutBin
  if ne rc1 0
    ret guFail 92 rc1
  end
  guAvReset
  guSetPaTool guTXeIsa
  guAvPushGlobal 2
  guAvPushLiteral guChkCmd
  guSetPaScr guFFutBin
  guAvPushGlobal 2
  ck = guExec false false true
  if ne ck 0
    ret guFail 93 ck
  end

  note Negative control: over-limit smem (300000 > 262144) MUST fail closed with exit 72 and 0 output!
  guStartUni true guTgtFut
  guPushLitPair guFlSmem guS300k
  rc2 = guFinishUni guFBadLim
  if ne rc2 72
    ret guFail 94 rc2
  end
  guSetPaScr guFBadLim
  if ge guReadPaToB 0 0
    ret guFail 95 0
  end

  note Negative control: GB10 24 MiB L2 guard (32768 > 24576) MUST fail closed with exit 72!
  guStartUni false guTgtSm
  guPushLitPair guFlL2 guS32k
  rc3 = guFinishUni guFBadL2
  if ne rc3 72
    ret guFail 96 rc3
  end
  guWrt guM_fut
  guAddCtrl 2
  guAddChk 3
  ret 0
end

fn guReadArg i ulong dst ulong to ulong
  k = argread i guIo 0 2047
  if lt k 1
    ret 0
  end
  u = ulong k
  for j ulong u bound 2048
    b = get guIo j
    if eq dst 0
      put guUni j b
    else
      if eq dst 1
        put guTools j b
      else
        if eq dst 2
          put guScr j b
        else
          put guChips j b
        end
      end
    end
  end
  ret u
end

fn main to int
  ac = ulong argcnt
  if or lt ac 4 gt ac 5
    guWrt guUse
    ret 90
  end
  put guUniN 0 guReadArg 1 0
  put guToolsN 0 guReadArg 2 1
  put guScrN 0 guReadArg 3 2
  if eq ac 5
    put guChipsN 0 guReadArg 4 3
  else
    for i ulong len guDefChips
      put guChips i get guDefChips i
    end
    put guChipsN 0 len guDefChips
  end
  if or eq get guUniN 0 0 or eq get guToolsN 0 0 eq get guScrN 0 0
    guWrt guUse
    ret 90
  end
  guSetPaScr guFRec
  if not guWritePaText guRecipeText
    ret guFail 1 0
  end
  put guChk 0 0
  put guCtrl 0 0
  guWrt guHdr

  r = guTestArm64
  if ne r 0
    ret r
  end
  r = guTestAppleM
  if ne r 0
    ret r
  end
  r = guTestX64
  if ne r 0
    ret r
  end
  r = guTestRv64
  if ne r 0
    ret r
  end
  r = guTestWasm
  if ne r 0
    ret r
  end
  r = guTestSpirv
  if ne r 0
    ret r
  end
  r = guTestIntelXe
  if ne r 0
    ret r
  end
  r = guTestSm121
  if ne r 0
    ret r
  end
  r = guTestZeroRecompile
  if ne r 0
    ret r
  end

  guWrt guPassA
  guNum get guChk 0
  guWrt guPassB
  guNum get guCtrl 0
  guWrt guNl
  ret 0
end

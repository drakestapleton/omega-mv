note ---- Metadata registration helper (6 scalar params max) ----
fn mt_set_meta tid ulong vend ulong plat ulong t1drv ulong t1env ulong capBm ulong to void
put mtVend tid vend
put mtPlat tid plat
put mtT1Drv tid t1drv
put mtT1EnvBit tid t1env
put mtCapBm tid capBm
end

fn mt_set_ev tid ulong capT1 ulong hostEv ulong silEv ulong auxId ulong to void
put mtCapT1 tid capT1
put mtHostEv tid hostEv
put mtSilEv tid silEv
put mtAuxId tid auxId
end

note ---- Register all 16 unified TargetDesc profiles (0..9 base + 10..15 multi-vendor) ----
fn mt_init_targets to void
tdInitAll
put tdCount 0 16

note Enrich existing GB10 SM121 / APU / Spark Ring feature & MMA bits (strict superset of base 3081/3087)
tdSet TID_SM121 TDF_FEAT 31753
tdSet TID_SM121 TDF_MMA 19
tdSet TID_APU_GB10 TDF_FEAT 31759
tdSet TID_APU_GB10 TDF_MMA 23
tdSet TID_SPARK_RING TDF_FEAT 31759
tdSet TID_SPARK_RING TDF_MMA 23

note Mark x86-64 profiles WSL 2 x86linux compatible (strict superset of base 913/953)
tdSet TID_X64_AVX2 TDF_FEAT 1049489
tdSet TID_X64_AVX512 TDF_FEAT 1049529

note 10: Consumer NVIDIA Blackwell RTX 5090 (sm_120, GB202, 96 MiB L2, 101376 B SMEM, PCIe Gen5, NO C2C_COH)
tdRegIsa TID_RTX5090 ISA_SM120 EXEC_SIMT_WARP 64 64 64
tdRegVec TID_RTX5090 7 1024 0 0 32
tdRegCache TID_RTX5090 128 98304 128 101376
tdRegLat TID_RTX5090 4 4 24 20
tdRegFeat TID_RTX5090 15369 19 2 1200 0

note 11: AMD Instinct MI300X (gfx942, CDNA3, Wave64, 64 KiB LDS, MFMA, /dev/kfd HSACO)
tdRegIsa TID_MI300X ISA_GFX942 EXEC_SIMT_WARP 64 104 256
tdRegVec TID_MI300X 2 2048 0 0 64
tdRegCache TID_MI300X 32 32768 128 65536
tdRegLat TID_MI300X 4 4 28 20
tdRegFeat TID_MI300X 33801 32 2 1400 0

note 12: AMD Ryzen AI Max Strix Halo (gfx1151, RDNA3.5 APU, Wave32, 64 KiB LDS max, WMMA, /dev/kfd HSACO)
tdRegIsa TID_STRIX_HALO ISA_GFX1151 EXEC_SIMT_WARP 64 106 256
tdRegVec TID_STRIX_HALO 2 1024 0 0 32
tdRegCache TID_STRIX_HALO 32 4096 128 65536
tdRegLat TID_STRIX_HALO 4 4 28 18
tdRegFeat TID_STRIX_HALO 65545 64 1 120 0

note 13: Intel Arc Xe2 Battlemage/Lunar Lake (drm/xe, SIMD16, 128 KiB SLM, XMX DPAS, /dev/dri/renderD128)
tdRegIsa TID_INTEL_XE2 ISA_INTEL_XE2 EXEC_SIMT_WARP 64 128 128
tdRegVec TID_INTEL_XE2 4 512 0 0 16
tdRegCache TID_INTEL_XE2 256 18432 64 131072

note ---- Internal router output writer helpers ----
fn mt_route_clear tid ulong wantTier ulong to void
for i ulong 12
put mtRouteOut i 0
end
put mtRouteOut 5 wantTier
put mtRouteOut 9 tid
if lt tid get tdCount 0
put mtRouteOut 6 get mtHostEv tid
put mtRouteOut 7 get mtSilEv tid
put mtRouteOut 11 get mtPlat tid
end
end

fn mt_route_finish tier ulong selTid ulong drv ulong rsn ulong fb ulong skipRsn ulong to ulong
put mtRouteOut 0 tier
put mtRouteOut 1 selTid
put mtRouteOut 2 drv
put mtRouteOut 3 rsn
put mtRouteOut 4 fb
put mtRouteOut 10 skipRsn
ret tier
end

note Check whether active tdReq can legally run on Tier-0 Universal Interop (SPIR-V or WASM).
note Vendor-locked GPU features (TMA, NVFP4, C2C_COH, MFMA, WMMA, XMX_DPAS, HMMA) or smem > 32768
note MUST NOT silently downgrade to Tier-0 SPIR-V!
fn mt_tier0_admit execM ulong envCaps ulong to ulong
if eq execM EXEC_SIMT_WARP
if eq and envCaps MT_ENV_SPIRV_RT 0
ret MT_RSN_NO_TIER0_RT
end
if gt get tdReq 1 32768
ret MT_RSN_TIER0_CONTRACT
end
if ne get tdReq 4 0
ret MT_RSN_TIER0_CONTRACT
end
rf = get tdReq 5
if ne and rf 261120 0
ret MT_RSN_TIER0_CONTRACT
end
ret MT_RSN_EXACT
end
if eq execM EXEC_SCALAR_SIMD
if eq and envCaps MT_ENV_WASM_RT 0
ret MT_RSN_NO_TIER0_RT
end
if ne get tdReq 4 0
ret MT_RSN_TIER0_CONTRACT
end
ret MT_RSN_EXACT
end
ret MT_RSN_TIER0_CONTRACT
end

note ---- 3-Tier Universal Realization Router (mt_route) ----
note Selects Tier-2 Bare-Metal (aienux), Tier-1 Zero-SDK Native (nvrm/kfd/drm-xe/ELF/Mach-O),
note or Tier-0 Universal Interop (SPIR-V/WASM) with explicit non-silent fallback/refusal reasons.
note Caller sets kernel physical requirements via tdSetReq before invoking mt_route.
fn mt_route tid ulong wantTier ulong envCaps ulong allowFb ulong to ulong
mt_route_clear tid wantTier
if ge tid get tdCount 0
put mtRouteOut 8 TDK_ERR_EXEC
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE MT_RSN_BAD_TARGET 0 MT_RSN_BAD_TARGET
end

note Step 1: Hard physical silicon contract check on requested TargetDesc (never bypassed!)
ck = tdCheckKernelContract tid
put mtRouteOut 8 ck
if ne ck TDK_OK
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE ck 0 ck
end

skipRsn = ulong MT_RSN_EXACT
fb = ulong 0

note Step 2: Tier-2 Bare-Metal (aienux / a64efi)
if eq wantTier MT_TIER_2_BAREMETAL
if and eq get mtCapBm tid 1 ne and envCaps MT_ENV_BAREMETAL 0
ret mt_route_finish MT_TIER_2_BAREMETAL tid MT_DRV_AIENUX_BM MT_RSN_EXACT 0 MT_RSN_EXACT
end
skipRsn = ulong MT_RSN_NO_BAREMETAL
if eq allowFb 0
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE MT_RSN_STRICT_REFUSE 0 skipRsn
end
fb = ulong 1
end

note Step 3: Tier-1 Zero-SDK Native (nvrm / kfd / drm-xe / native ELF or Mach-O)
if ge wantTier MT_TIER_1_NATIVE
if eq get mtCapT1 tid 1
eb = get mtT1EnvBit tid
if or eq eb 0 ne and envCaps eb 0
r1 = ulong MT_RSN_EXACT
if ne fb 0
r1 = skipRsn
end
ret mt_route_finish MT_TIER_1_NATIVE tid get mtT1Drv tid r1 fb skipRsn
end
skipRsn = ulong MT_RSN_NO_DEV_NODE
else
skipRsn = ulong MT_RSN_NO_NATIVE_ENC
end
if eq allowFb 0
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE MT_RSN_STRICT_REFUSE 0 skipRsn
end
fb = ulong 1
end

note Step 4: Tier-0 Universal Interop (SPIR-V for SIMT GPUs, WASM for scalar/SIMD CPUs)
ex = tdGet tid TDF_EXEC
t0r = mt_tier0_admit ex envCaps
if ne t0r MT_RSN_EXACT
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE t0r 0 skipRsn
end
drv0 = ulong MT_DRV_WASM
if eq ex EXEC_SIMT_WARP
drv0 = ulong MT_DRV_SPIRV_CL
end
put mtRouteOut 6 MT_EV_HOST_VERIFIED
put mtRouteOut 7 MT_EV_NOT_RUN
r0 = skipRsn
if eq wantTier MT_TIER_0_INTEROP
r0 = ulong MT_RSN_EXACT
fb = ulong 0
end
ret mt_route_finish MT_TIER_0_INTEROP TID_TIER0_UNIV drv0 r0 fb skipRsn
end

note ---- Helper: read whole small file from mtPathBuf[0..plen) into mtIoBuf ----
fn mt_read_path plen ulong to long
fd = fopen mtPathBuf 0 plen 0 0
if lt fd 0
ret fd
end
tot = ulong 0
while lt tot 8191 bound 32
k = read int fd mtIoBuf tot sub 8191 tot
if le k 0
break
end
tot = add tot ulong k
end
cl = fclose int fd
put mtIoBuf tot uchar 0
ret long tot
end

note ---- Helper: build sysfs cpu path into mtPathBuf and return byte length ----
fn mt_path_put_u8 pos ulong b uchar to ulong
if lt pos 127
put mtPathBuf pos b
ret add pos 1
end
ret pos
end

fn mt_path_put_dec pos ulong v ulong to ulong
p = pos
d = new uchar 16 0
k = ulong 0
x = v
while true bound 16
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
for i ulong k
p = mt_path_put_u8 p get d sub sub k i 1
end
ret p
end

fn mt_build_cpu_path cpu ulong kind ulong to ulong
p = ulong 0
for i ulong len mtPfxCpu
p = mt_path_put_u8 p get mtPfxCpu i
end
p = mt_path_put_dec p cpu
if eq kind 0
for i ulong len mtSfxMidr
p = mt_path_put_u8 p get mtSfxMidr i
end
ret p
end
if eq kind 1
for i ulong len mtSfxL1
p = mt_path_put_u8 p get mtSfxL1 i
end
ret p
end
for i ulong len mtSfxL2
p = mt_path_put_u8 p get mtSfxL2 i
end
ret p
end

note ---- Helper: parse hex u64 from mtIoBuf[0..n) (handles optional 0x prefix) ----
fn mt_parse_hex n ulong to ulong
v = ulong 0
i = ulong 0
if ge n 2
b0 = ulong get mtIoBuf 0
b1 = ulong get mtIoBuf 1
if eq b0 48
if or eq b1 120 eq b1 88
i = ulong 2
end
end
end
while lt i n bound 64
c = ulong get mtIoBuf i
if and ge c 48 le c 57
v = or shl v 4 sub c 48
else
if and ge c 97 le c 102
v = or shl v 4 add sub c 97 10
else
if and ge c 65 le c 70
v = or shl v 4 add sub c 65 10
else
break
end
end
end
i = add i 1
end
ret v
end

note ---- Helper: parse sysfs cache size in KiB (e.g. "64K", "2048K", "2M") ----
fn mt_parse_kb n ulong to ulong
v = ulong 0
i = ulong 0
while lt i n bound 32
c = ulong get mtIoBuf i
if and ge c 48 le c 57
v = add mul v 10 sub c 48
else
if or eq c 77 eq c 109
v = mul v 1024
end
break
end
i = add i 1
end
ret v
end

note ---- Helper: substring search in mtIoBuf[0..blen) for exact ASCII word token ----
fn mt_is_alnum b uchar to bool
c = ulong b
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if eq c 95
ret true
end
ret false
end

note Search mtIoBuf[start..blen) for a specific token ID (0..13) bounded by non-alnum chars
fn mt_tok_byte id ulong idx ulong to uchar
if eq id 0
ret get mtTokAsimd idx
end
if eq id 1
ret get mtTokFp idx
end
if eq id 2
ret get mtTokDotprod idx
end
if eq id 3
ret get mtTokI8mm idx
end
if eq id 4
ret get mtTokBf16 idx
end
if eq id 5
ret get mtTokSha2 idx
end
if eq id 6
ret get mtTokAes idx
end
if eq id 7
ret get mtTokSve idx
end
if eq id 8
ret get mtTokFma idx
end
if eq id 9
ret get mtTokAvx2 idx
end
if eq id 10
ret get mtTokAvx512 idx
end
if eq id 11
ret get mtTokBmi2 idx
end
if eq id 12
ret get mtTokShaNi idx
end
if eq id 13
ret get mtTokMicrosoft idx
end
ret get mtTokWsl idx
end

fn mt_tok_len id ulong to ulong
if eq id 0
ret len mtTokAsimd
end
if eq id 1
ret len mtTokFp
end
if eq id 2
ret len mtTokDotprod
end
if eq id 3
ret len mtTokI8mm
end
if eq id 4
ret len mtTokBf16
end
if eq id 5
ret len mtTokSha2
end
if eq id 6
ret len mtTokAes
end
if eq id 7
ret len mtTokSve
end
if eq id 8
ret len mtTokFma
end
if eq id 9
ret len mtTokAvx2
end
if eq id 10
ret len mtTokAvx512
end
if eq id 11
ret len mtTokBmi2
end
if eq id 12
ret len mtTokShaNi
end
if eq id 13
ret len mtTokMicrosoft
end
ret len mtTokWsl
end

fn mt_has_word blen ulong tokId ulong to bool
tl = mt_tok_len tokId
if gt tl blen
ret false
end
lim = add sub blen tl 1
i = ulong 0
while lt i lim bound 8192
ok = true
if gt i 0
if mt_is_alnum get mtIoBuf sub i 1
ok = false
end
end
if ok
if lt add i tl blen
if mt_is_alnum get mtIoBuf add i tl
ok = false
end
end
end
if ok
j = ulong 0
while lt j tl bound 32
if ne get mtIoBuf add i j mt_tok_byte tokId j
ok = false
break
end
j = add j 1
end
if ok
ret true
end
end
i = add i 1
end
ret false
end

note ---- Helper: probe read-only device node existence via faccess (NEVER opens GPU!) ----
fn mt_probe_env_nodes to ulong
caps = ulong 0
if eq faccess mtPathNvCtl 0 len mtPathNvCtl 0 0
if eq faccess mtPathNv0 0 len mtPathNv0 0 0
caps = or caps MT_ENV_NVRM_NODE
end
end
if eq faccess mtPathKfd 0 len mtPathKfd 0 0
caps = or caps MT_ENV_KFD_NODE
end
if eq faccess mtPathDrmXe 0 len mtPathDrmXe 0 0
caps = or caps MT_ENV_DRMXE_NODE
end
note Tier-0 SPIR-V & WASM host validators are always software-available
caps = or caps or MT_ENV_SPIRV_RT MT_ENV_WASM_RT
ret caps
end

note ---- Helper: probe /proc/cpuinfo for ISA feature bits ----
fn mt_probe_cpuinfo_feats to ulong
fd = fopen mtPathCpuinfo 0 len mtPathCpuinfo 0 0
if lt fd 0
ret 0
end
tot = ulong 0
while lt tot 4095 bound 16
k = read int fd mtIoBuf tot sub 4095 tot
if le k 0
break
end
tot = add tot ulong k
end
cl = fclose int fd
put mtIoBuf tot uchar 0
fm = ulong 0
if or mt_has_word tot 0 mt_has_word tot 1
fm = or fm FEAT_FMA
end
if mt_has_word tot 8
fm = or fm FEAT_FMA
end
if mt_has_word tot 2
fm = or fm FEAT_DOTPROD
end
if mt_has_word tot 3
fm = or fm FEAT_I8MM
end
if mt_has_word tot 4
fm = or fm FEAT_BF16
end
if or mt_has_word tot 5 mt_has_word tot 12
fm = or fm FEAT_SHA
end
if mt_has_word tot 6
fm = or fm FEAT_AES
end
if mt_has_word tot 9
fm = or fm FEAT_AVX2
end
if mt_has_word tot 10
fm = or fm FEAT_AVX512
end
if mt_has_word tot 11
fm = or fm FEAT_BMI2
end
if mt_has_word tot 7
put mtProbeOut 8 1
end
ret fm
end

note ---- Helper: check /proc/version for Windows WSL 2 signature ----
fn mt_probe_wsl2 to ulong
fd = fopen mtPathProcVer 0 len mtPathProcVer 0 0
if lt fd 0
ret 0
end
k = read int fd mtIoBuf 0 511
cl = fclose int fd
if le k 0
ret 0
end
n = ulong k
if or mt_has_word n 13 mt_has_word n 14
ret 1
end
ret 0
end

note ---- Helper: scan cpu0..cpu31 midr_el1 to count X925 and A725 cores ----
fn mt_scan_grace_topo to void
x9 = ulong 0
a7 = ulong 0
tc = ulong 0
for c ulong 32
pl = mt_build_cpu_path c 0
n = mt_read_path pl
if gt n 0
tc = add tc 1
m = mt_parse_hex ulong n
pn = and shr m 4 4095
if eq pn 3461
x9 = add x9 1
end
if eq pn 3463
a7 = add a7 1
end
end
end
put mtProbeOut 10 x9
put mtProbeOut 11 a7
put mtProbeOut 12 tc
end

note ---- Helpers for mt_probe_local (kept flat within 16-register budget) ----
fn mt_probe_core_sysfs curCpu ulong to void
pl = mt_build_cpu_path curCpu 0
mn = mt_read_path pl
if gt mn 0
midr = mt_parse_hex ulong mn
put mtProbeOut 2 midr
put mtProbeOut 3 and shr midr 24 255
put mtProbeOut 4 and shr midr 4 4095
end
pl = mt_build_cpu_path curCpu 1
ln = mt_read_path pl
if gt ln 0
put mtProbeOut 5 mt_parse_kb ulong ln
end
pl = mt_build_cpu_path curCpu 2
ln = mt_read_path pl
if gt ln 0
put mtProbeOut 6 mt_parse_kb ulong ln
end
end

fn mt_probe_match_row to ulong
impl = get mtProbeOut 3
pnum = get mtProbeOut 4
fm = get mtProbeOut 7
ecaps = get mtProbeOut 13
matched = ulong 999999
if eq impl 65
ecaps = or ecaps MT_ENV_LINUX_A64
if eq pnum 3461
matched = ulong TID_X925
end
if eq pnum 3463
matched = ulong TID_A725
end
else
if ne and fm FEAT_AVX512 0
ecaps = or ecaps MT_ENV_LINUX_X64
matched = ulong TID_X64_AVX512
else
if ne and fm FEAT_AVX2 0
ecaps = or ecaps MT_ENV_LINUX_X64
matched = ulong TID_X64_AVX2
end
end
end
put mtProbeOut 13 ecaps
put mtProbeOut 9 matched
ret matched
end

fn mt_probe_calibrate matched ulong to void
put mtProbeOut 0 1
drift = ulong 0
l1kb = get mtProbeOut 5
l2kb = get mtProbeOut 6
fm = get mtProbeOut 7
if gt l1kb 0
if ne l1kb tdGet matched TDF_L1D_KB
drift = add drift 1
tdSet matched TDF_L1D_KB l1kb
end
end
if gt l2kb 0
if ne l2kb tdGet matched TDF_L2_KB
drift = add drift 1
tdSet matched TDF_L2_KB l2kb
end
end
if gt fm 0
curf = tdGet matched TDF_FEAT
if ne and fm curf fm
drift = add drift 1
tdSet matched TDF_FEAT or curf fm
end
end
put mtProbeOut 14 drift
note Promote ONLY the actually live-probed local CPU row(s) to PHYSICAL_SILICON!
put mtSilEv matched MT_EV_PHYSICAL_SILICON
if gt get mtProbeOut 10 0
put mtSilEv TID_X925 MT_EV_PHYSICAL_SILICON
end
if gt get mtProbeOut 11 0
put mtSilEv TID_A725 MT_EV_PHYSICAL_SILICON
end
tdDeriveTilePlan matched 4
end

note ---- Pure-Omega Silicon Probe & Auto-Calibrator (mt_probe_local) ----
note Probes live local host CPU, MIDR_EL1, L1D/L2 caches, /proc/cpuinfo features,
note and read-only device-node presence; matches to exact TargetDesc row;
note promotes ONLY the actually live-probed local CPU row(s) to MT_EV_PHYSICAL_SILICON.
note Returns matched TargetDesc ID (0..15) or 999999 if unrecognized.
fn mt_probe_local to ulong
for i ulong 16
put mtProbeOut i 0
end
cn = cpunow
curCpu = ulong 0
if ge cn 0
curCpu = ulong cn
end
put mtProbeOut 1 curCpu
mt_probe_core_sysfs curCpu
mt_scan_grace_topo
put mtProbeOut 7 mt_probe_cpuinfo_feats
wsl = mt_probe_wsl2
put mtProbeOut 15 wsl
ecaps = mt_probe_env_nodes
if ne wsl 0
ecaps = or ecaps MT_ENV_WSL2
end
put mtProbeOut 13 ecaps
matched = mt_probe_match_row
if ne matched 999999
mt_probe_calibrate matched
end
ret matched
end

note ============================================================================
note Component 3b: OMPK v1 Wire Header Contract Bridge (mt_ompk_route)
note Mirrors seed/ng/pack/sem_pack.om OMPK v1 layout:
note   [0..3]   magic "OMPK" (79, 77, 80, 75)
note   [4..7]   version u32 LE (1)
note   [72..119] 6x u64 LE contract (exec, smem, regs, subgroup, mma, feat)
note ============================================================================

fn mt_ompk_put32 off ulong v ulong to void
put mtOmpkHdr off uchar and v 255
put mtOmpkHdr add off 1 uchar and shr v 8 255
put mtOmpkHdr add off 2 uchar and shr v 16 255
put mtOmpkHdr add off 3 uchar and shr v 24 255
end

fn mt_ompk_put64 off ulong v ulong to void
mt_ompk_put32 off and v 4294967295
mt_ompk_put32 add off 4 shr v 32
end

fn mt_ompk_get32 off ulong to ulong
b0 = ulong get mtOmpkHdr off
b1 = shl ulong get mtOmpkHdr add off 1 8
b2 = shl ulong get mtOmpkHdr add off 2 16
b3 = shl ulong get mtOmpkHdr add off 3 24
ret or or b0 b1 or b2 b3
end

fn mt_ompk_get64 off ulong to ulong
lo = mt_ompk_get32 off
hi = mt_ompk_get32 add off 4
ret or lo shl hi 32
end

fn mt_ompk_build_hdr reqExec ulong reqSmem ulong reqRegs ulong reqSubg ulong reqMma ulong reqFeat ulong to void
for i ulong 128
put mtOmpkHdr i uchar 0
end
put mtOmpkHdr 0 uchar 79
put mtOmpkHdr 1 uchar 77
put mtOmpkHdr 2 uchar 80
put mtOmpkHdr 3 uchar 75
mt_ompk_put32 4 1
mt_ompk_put64 72 reqExec
mt_ompk_put64 80 reqSmem
mt_ompk_put64 88 reqRegs
mt_ompk_put64 96 reqSubg
mt_ompk_put64 104 reqMma
mt_ompk_put64 112 reqFeat
end

fn mt_ompk_check_magic to bool
if ne ulong get mtOmpkHdr 0 79
ret false
end
if ne ulong get mtOmpkHdr 1 77
ret false
end
if ne ulong get mtOmpkHdr 2 80
ret false
end
if ne ulong get mtOmpkHdr 3 75
ret false
end
ret true
end

note Fail-closed OMPK v1 header verifier + 3-Tier Universal Realization Router dispatch
fn mt_ompk_route tid ulong wantTier ulong envCaps ulong allowFb ulong to ulong
mt_route_clear tid wantTier
if not mt_ompk_check_magic
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE MT_RSN_OMPK_MAGIC 0 MT_RSN_OMPK_MAGIC
end
if ne mt_ompk_get32 4 1
ret mt_route_finish MT_TIER_REFUSED tid MT_DRV_NONE MT_RSN_OMPK_VERSION 0 MT_RSN_OMPK_VERSION
end
put tdReq 0 mt_ompk_get64 72
put tdReq 1 mt_ompk_get64 80
put tdReq 2 mt_ompk_get64 88
put tdReq 3 mt_ompk_get64 96
put tdReq 4 mt_ompk_get64 104
put tdReq 5 mt_ompk_get64 112
ret mt_route tid wantTier envCaps allowFb
end

note ============================================================================
note Component 4: x86-64 execpure seccomp-BPF Policy Builder + Verifier + cBPF VM
note ============================================================================

note Emit one classic BPF instruction (struct sock_filter: u16 code, u8 jt, u8 jf, u32 k)
note into both mtBpfU64[idx] (packed u64 for omc.om) and mtBpfBytes[idx*8..idx*8+7].
fn mt_bpf_emit code ulong jt ulong jf ulong k ulong to void
idx = get mtBpfCount 0
if ge idx MT_BPF_MAX_INSNS
ret
end
lo = or and code 65535 shl and jt 255 16
hi = or shl and jf 255 24 shl and k 4294967295 32
put mtBpfU64 idx or lo hi
o = mul idx 8
put mtBpfBytes o uchar and code 255
put mtBpfBytes add o 1 uchar and shr code 8 255
put mtBpfBytes add o 2 uchar and jt 255
put mtBpfBytes add o 3 uchar and jf 255
put mtBpfBytes add o 4 uchar and k 255
put mtBpfBytes add o 5 uchar and shr k 8 255
put mtBpfBytes add o 6 uchar and shr k 16 255
put mtBpfBytes add o 7 uchar and shr k 24 255
put mtBpfCount 0 add idx 1
end

note Populate x86-64 execpure UAPI syscall & prlimit64 ceiling tables for omc.om lowering
fn mt_x64_fill_uapi to void
put mtX64Uapi 0 AUDIT_ARCH_X86_64
put mtX64Uapi 1 X64_NR_READ
put mtX64Uapi 2 X64_NR_WRITE
put mtX64Uapi 3 X64_NR_EXIT
put mtX64Uapi 4 X64_NR_EXIT_GROUP
put mtX64Uapi 5 X64_NR_EXECVEAT
put mtX64Uapi 6 X64_AT_EMPTY_PATH
put mtX64Uapi 7 X64_NR_OPENAT
put mtX64Uapi 8 X64_NR_CLOSE
put mtX64Uapi 9 X64_NR_CLOSE_RANGE
put mtX64Uapi 10 X64_NR_PRCTL
put mtX64Uapi 11 X64_NR_PRLIMIT64
put mtX64Uapi 12 X64_NR_SECCOMP
put mtX64Uapi 13 X64_NR_LL_CREATE
put mtX64Uapi 14 X64_NR_LL_ADD
put mtX64Uapi 15 X64_NR_LL_RESTRICT
put mtX64Uapi 16 38
put mtX64Uapi 17 1
put mtX64Uapi 18 16
put mtX64Uapi 19 8
put mtX64Uapi 20 SECCOMP_RET_ALLOW
put mtX64Uapi 21 SECCOMP_RET_KILL_PROC
put mtX64Uapi 22 MT_BPF_X64_LEN
put mtX64Uapi 23 mul MT_BPF_X64_LEN 8

note 7 prlimit64 (resource, soft, hard) ceilings matching omc.om AArch64 execpure
note 0: RLIMIT_CPU(0) 1..2 s, 1: RLIMIT_FSIZE(1) 1 MiB, 2: RLIMIT_STACK(3) 8 MiB,
note 3: RLIMIT_CORE(4) 0, 4: RLIMIT_NPROC(6) 0, 5: RLIMIT_NOFILE(7) 4, 6: RLIMIT_AS(9) 128 MiB
put mtX64Rlim 0 0
put mtX64Rlim 1 1
put mtX64Rlim 2 2
put mtX64Rlim 3 1
put mtX64Rlim 4 1048576
put mtX64Rlim 5 1048576
put mtX64Rlim 6 3
put mtX64Rlim 7 8388608
put mtX64Rlim 8 8388608
put mtX64Rlim 9 4
put mtX64Rlim 10 0
put mtX64Rlim 11 0
put mtX64Rlim 12 6
put mtX64Rlim 13 0
put mtX64Rlim 14 0
put mtX64Rlim 15 7
put mtX64Rlim 16 4
put mtX64Rlim 17 4
put mtX64Rlim 18 9
put mtX64Rlim 19 134217728
put mtX64Rlim 20 134217728
end

note ---- x86-64 execpure seccomp-BPF Policy Builder (mt_x64_execpure_spec) ----
note Emits exact 27-instruction (216-byte) AUDIT_ARCH_X86_64 stdio-only cBPF filter:
note   - Rejects any arch != AUDIT_ARCH_X86_64 (0xc000003e) with SECCOMP_RET_KILL_PROCESS.
note   - Allows read(0) only (checks both arg0_hi == 0 and arg0_lo == 0).
note   - Allows write(1) or write(2) only (checks arg0_hi == 0 and arg0_lo in {1, 2}).
note   - Allows exit(60) and exit_group(231).
note   - Allows execveat(3, ..., AT_EMPTY_PATH=4096) only (checks arg0 == 3 and arg4 == 4096, full 64-bit).
note   - Kills everything else (socket=41, openat=257, fork=57, execve=59, clone=56, etc.)
note     with SECCOMP_RET_KILL_PROCESS (0x80000000).
note Returns total BPF instruction count (27).
fn mt_x64_execpure_spec to ulong
put mtBpfCount 0 0
mt_x64_fill_uapi

note pc=0..1: Validate AUDIT_ARCH_X86_64 (0xc000003e = 3221225534); mismatch -> pc=26 (KILL)
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARCH
mt_bpf_emit BPF_JMP_JEQ_K 0 24 AUDIT_ARCH_X86_64

note pc=2: Load syscall nr
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_NR

note pc=3..7: read (nr=0) -> require arg0_hi==0 and arg0_lo==0 -> pc=25 (ALLOW), else pc=26 (KILL)
mt_bpf_emit BPF_JMP_JEQ_K 0 4 X64_NR_READ
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_HI
mt_bpf_emit BPF_JMP_JEQ_K 0 20 0
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_LO
mt_bpf_emit BPF_JMP_JEQ_K 17 18 0

note pc=8..13: write (nr=1) -> require arg0_hi==0 and arg0_lo in {1,2} -> pc=25 (ALLOW), else pc=26 (KILL)
mt_bpf_emit BPF_JMP_JEQ_K 0 5 X64_NR_WRITE
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_HI
mt_bpf_emit BPF_JMP_JEQ_K 0 15 0
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_LO
mt_bpf_emit BPF_JMP_JEQ_K 12 0 1
mt_bpf_emit BPF_JMP_JEQ_K 11 12 2

note pc=14..15: exit (nr=60) and exit_group (nr=231) -> pc=25 (ALLOW)
mt_bpf_emit BPF_JMP_JEQ_K 10 0 X64_NR_EXIT
mt_bpf_emit BPF_JMP_JEQ_K 9 0 X64_NR_EXIT_GROUP

note pc=16..24: execveat (nr=322) -> require arg0==3 and arg4==4096 (64-bit) -> pc=25 (ALLOW), else pc=26 (KILL)
mt_bpf_emit BPF_JMP_JEQ_K 0 9 X64_NR_EXECVEAT
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_HI
mt_bpf_emit BPF_JMP_JEQ_K 0 7 0
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG0_LO
mt_bpf_emit BPF_JMP_JEQ_K 0 5 3
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG4_HI
mt_bpf_emit BPF_JMP_JEQ_K 0 3 0
mt_bpf_emit BPF_LD_W_ABS 0 0 SECCOMP_OFF_ARG4_LO
mt_bpf_emit BPF_JMP_JEQ_K 0 1 X64_AT_EMPTY_PATH

note pc=25: SECCOMP_RET_ALLOW (0x7fff0000 = 2147418112)
mt_bpf_emit BPF_RET_K 0 0 SECCOMP_RET_ALLOW

note pc=26: SECCOMP_RET_KILL_PROCESS (0x80000000 = 2147483648)
mt_bpf_emit BPF_RET_K 0 0 SECCOMP_RET_KILL_PROC

note Pack x86-64 struct sock_fprog { u16 len; u8 pad[6]; u64 filter_ptr_placeholder; }
for i ulong 16
put mtBpfFprog i uchar 0
end
cnt = get mtBpfCount 0
put mtBpfFprog 0 uchar and cnt 255
put mtBpfFprog 1 uchar and shr cnt 8 255
ret cnt
end

note ---- Helper: read LE u16 / u32 from mtBpfBytes and mtSecData ----
fn mt_bpf_u16 off ulong to ulong
b0 = ulong get mtBpfBytes off
b1 = shl ulong get mtBpfBytes add off 1 8
ret or b0 b1
end

fn mt_bpf_u32 off ulong to ulong
b0 = ulong get mtBpfBytes off
b1 = shl ulong get mtBpfBytes add off 1 8
b2 = shl ulong get mtBpfBytes add off 2 16
b3 = shl ulong get mtBpfBytes add off 3 24
ret or or b0 b1 or b2 b3
end

fn mt_sec_put32 off ulong v ulong to void
put mtSecData off uchar and v 255
put mtSecData add off 1 uchar and shr v 8 255
put mtSecData add off 2 uchar and shr v 16 255
put mtSecData add off 3 uchar and shr v 24 255
end

fn mt_sec_get32 off ulong to ulong
b0 = ulong get mtSecData off
b1 = shl ulong get mtSecData add off 1 8
b2 = shl ulong get mtSecData add off 2 16
b3 = shl ulong get mtSecData add off 3 24
ret or or b0 b1 or b2 b3
end

note Build a 64-byte little-endian struct seccomp_data packet for cBPF VM testing
fn mt_sec_build arch ulong nr ulong arg0Lo ulong arg0Hi ulong arg4Lo ulong arg4Hi ulong to void
for i ulong 64
put mtSecData i uchar 0
end
mt_sec_put32 SECCOMP_OFF_NR nr
mt_sec_put32 SECCOMP_OFF_ARCH arch
mt_sec_put32 SECCOMP_OFF_ARG0_LO arg0Lo
mt_sec_put32 SECCOMP_OFF_ARG0_HI arg0Hi
mt_sec_put32 SECCOMP_OFF_ARG4_LO arg4Lo
mt_sec_put32 SECCOMP_OFF_ARG4_HI arg4Hi
end

note ---- Static cBPF Structural Verifier (mirrors Linux kernel seccomp BPF checks) ----
note Returns 0 if valid, nonzero error code otherwise:
note   1=empty/oversize, 2=unknown opcode, 3=unaligned/OOB seccomp_data offset,
note   4=jump target out of bounds, 5=last instruction not BPF_RET, 6=byte/u64 mismatch
fn mt_bpf_check_word pc ulong code ulong jt ulong jf ulong k ulong to bool
lo = or code shl jt 16
hi = or shl jf 24 shl k 32
ret eq or lo hi get mtBpfU64 pc
end

fn mt_bpf_verify_insn pc ulong n ulong to ulong
o = mul pc 8
code = mt_bpf_u16 o
jt = ulong get mtBpfBytes add o 2
jf = ulong get mtBpfBytes add o 3
k = mt_bpf_u32 add o 4
if not mt_bpf_check_word pc code jt jf k
ret 6
end
if eq code BPF_LD_W_ABS
if ne rem k 4 0
ret 3
end
if gt add k 4 64
ret 3
end
ret 0
end
if eq code BPF_JMP_JEQ_K
if ge add add pc 1 jt n
ret 4
end
if ge add add pc 1 jf n
ret 4
end
ret 0
end
if eq code BPF_RET_K
ret 0
end
ret 2
end

fn mt_bpf_verify to ulong
n = get mtBpfCount 0
if eq n 0
ret 1
end
if gt n MT_BPF_MAX_INSNS
ret 1
end
for pc ulong n
err = mt_bpf_verify_insn pc n
if ne err 0
ret err
end
end
lastO = mul sub n 1 8
if ne mt_bpf_u16 lastO BPF_RET_K
ret 5
end
ret 0
end

note ---- Pure-Omega Classic BPF Virtual Machine Evaluator (mt_bpf_eval) ----
note Executes raw little-endian struct sock_filter bytes in mtBpfBytes[0..n*8)
note over the 64-byte struct seccomp_data in mtSecData[0..63].
note Returns the 32-bit seccomp action (e.g. SECCOMP_RET_ALLOW or SECCOMP_RET_KILL_PROC),
note or 999999 if the program faults / violates bounds.
fn mt_bpf_eval to ulong
n = get mtBpfCount 0
if eq n 0
ret 999999
end
if gt n MT_BPF_MAX_INSNS
ret 999999
end
pc = ulong 0
acc = ulong 0
while lt pc n bound 128
o = mul pc 8
code = mt_bpf_u16 o
k = mt_bpf_u32 add o 4
if eq code BPF_LD_W_ABS
if ne rem k 4 0
ret 999999
end
if gt add k 4 64
ret 999999
end
acc = mt_sec_get32 k
pc = add pc 1
else
if eq code BPF_JMP_JEQ_K
if eq acc k
pc = add add pc 1 ulong get mtBpfBytes add o 2
else
pc = add add pc 1 ulong get mtBpfBytes add o 3
end
else
if eq code BPF_RET_K
ret k
else
ret 999999
end
end
end
end
ret 999999
end

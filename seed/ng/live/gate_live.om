note seed/ng/live/gate_live.om: End-to-end verification gate for Live Arboris Specialization & Self-Healing Controller.
note Program-mode gate (no om2 line; links with target_desc.om, isel.om, sm121_pe.om, fabric.om, crystallize.om, arboris_spec.om).

global glDig uchar 24
global glChk ulong 1
global glNeg ulong 1

text glMsgHdr "=== OMEGA NG LIVE ARBORIS SPECIALIZATION & SELF-HEALING GATE ===\n"
text glMsgTel "TELEMETRY dispatches="
text glMsgSpec " spec_hits="
text glMsgCoact " coact_hits="
text glMsgRef " refusals="
text glMsgSaved " saved_ns="
text glMsgPass "NG-LIVE-ARBORIS-GATE PASS checks="
text glMsgSwaps " swaps="
text glMsgRb " rollbacks="
text glMsgNeg " neg_controls="
text glMsgSlash "/4\n"
text glMsgNl "\n"
text glMsgFail "NG-LIVE-ARBORIS-GATE FAIL at check="

fn glSay id ulong to void
if eq id 0
w = write 1 glMsgHdr 0 len glMsgHdr
ret
end
if eq id 1
w = write 1 glMsgTel 0 len glMsgTel
ret
end
if eq id 2
w = write 1 glMsgSpec 0 len glMsgSpec
ret
end
if eq id 3
w = write 1 glMsgCoact 0 len glMsgCoact
ret
end
if eq id 4
w = write 1 glMsgRef 0 len glMsgRef
ret
end
if eq id 5
w = write 1 glMsgSaved 0 len glMsgSaved
ret
end
if eq id 6
w = write 1 glMsgPass 0 len glMsgPass
ret
end
if eq id 7
w = write 1 glMsgSwaps 0 len glMsgSwaps
ret
end
if eq id 8
w = write 1 glMsgRb 0 len glMsgRb
ret
end
if eq id 9
w = write 1 glMsgNeg 0 len glMsgNeg
ret
end
if eq id 10
w = write 1 glMsgSlash 0 len glMsgSlash
ret
end
if eq id 11
w = write 1 glMsgNl 0 len glMsgNl
ret
end
w = write 1 glMsgFail 0 len glMsgFail
end

fn glNum v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put glDig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 glDig p sub 24 p
ret
end
end
end

fn glFail id ulong to int
glSay 12
glNum id
glSay 11
ret int id
end

fn glAddChk n ulong to void
put glChk 0 add get glChk 0 n
end

fn glAddNeg n ulong to void
put glNeg 0 add get glNeg 0 n
end

note Phase 1: Cold baseline execution on slot 0 (GPU GEMM M=4, K=4096, N=4096) and slot 1 (neural 15,000,000 ns)
fn glPhase1ColdBaseline to int
if not as_register_baseline 0 1001 4096 TID_SM121 FAB_MODE_NEURAL AS_KIND_GPU_GEMM
ret glFail 1
end
if not as_register_baseline 1 2002 8192 TID_SM121 FAB_MODE_NEURAL AS_KIND_CRYSTALLIZE
ret glFail 2
end
if ne get fabVer 0 1
ret glFail 3
end
if ne get fabCostNs 0 15000000
ret glFail 4
end
if ne get fabVer 1 1
ret glFail 5
end
if ne get fabMode 1 FAB_MODE_NEURAL
ret glFail 6
end
if ne get fabCostNs 1 15000000
ret glFail 7
end
y0 = as_dispatch_checked 0 4 4096
if ne y0 16384
ret glFail 8
end
if ne get as_last_status 0 AS_DISP_BASELINE
ret glFail 9
end
h0 = as_observe 0 1001 4 4096 4096
if ne h0 1
ret glFail 10
end
y1 = as_dispatch_checked 1 2 3
if ne y1 15
ret glFail 11
end
if ne get as_last_status 0 AS_DISP_BASELINE
ret glFail 12
end
if ne as_pending_jobs 0
ret glFail 13
end
glAddChk 13
ret 0
end

note Phase 2: Live Arboris co-activation learning (slot 0 -> slot 1, 100% hit rate after warmup) + hot-shape threshold
fn glPhase2CoactAndObserve to int
note Complete warmup edge (slot 1 -> slot 0); slot 0 -> slot 1 was already observed in Phase 1
y = as_dispatch_checked 0 4 4096
if ne y 16384
ret glFail 20
end
h = as_observe 0 1001 4 4096 4096
if ne h 2
ret glFail 21
end
note Post-warmup alternating calls: every transition MUST be predicted with 100% hit rate!
if ne as_coact_predict 1001 2002
ret glFail 22
end
y = as_dispatch_checked 1 4 1
if ne y 15
ret glFail 23
end
y = as_dispatch_checked 0 4 4096
if ne y 16384
ret glFail 24
end
h = as_observe 0 1001 4 4096 4096
if ne h 3
ret glFail 25
end
if ne as_pending_jobs 0
ret glFail 26
end
y = as_dispatch_checked 1 7 5
if ne y 36
ret glFail 27
end
y = as_dispatch_checked 0 4 4096
if ne y 16384
ret glFail 28
end
note 4th observation crosses threshold (>= 4) -> schedules TID_A725 background job!
h = as_observe 0 1001 4 4096 4096
if ne h 4
ret glFail 29
end
y = as_dispatch_checked 1 10 2
if ne y 36
ret glFail 30
end
note Verify 100% co-activation hit rate after warmup (5 predictions, 5 hits, 0 misses)
if ne get as_coact_preds 0 5
ret glFail 31
end
if ne get as_coact_hits 0 5
ret glFail 32
end
if ne get as_coact_misses 0 0
ret glFail 33
end
if lt as_coact_weight 1001 2002 4
ret glFail 34
end
if eq get as_prefetch_cues 0 0
ret glFail 35
end
note Verify slot 0 hot-shape scheduled exactly 1 background job routed to TID_A725!
if ne as_pending_jobs 1
ret glFail 36
end
if ne get as_job_exec_tid 0 TID_A725
ret glFail 37
end
if ne get crObsCnt 0 4
ret glFail 38
end
glAddChk 19
ret 0
end

note Phase 3: Negative Controls 1..3 (all MUST fail closed with fabVer unchanged and as_refusals incremented!)
fn glPhase3NegControlsProofs to int
v0Before = get fabVer 0
v1Before = get fabVer 1
refBefore = get as_refusals 0
note Negative Control 1: missing EGP3 bit (proofMask = 5) -> REFUSED, fabVer unchanged!
rc1 = as_specialize_slot 0 AS_KIND_GPU_GEMM 4 4096 4096 5
if ne rc1 AS_ERR_PROOF_EGP3
ret glFail 40
end
if ne get fabVer 0 v0Before
ret glFail 41
end
if ne get fabMode 0 FAB_MODE_NEURAL
ret glFail 42
end
if ne get as_refusals 0 add refBefore 1
ret glFail 43
end
glAddNeg 1
note Negative Control 2: missing Antibody bit (proofMask = 3) -> REFUSED, fabVer unchanged!
rc2 = as_specialize_slot 1 AS_KIND_CRYSTALLIZE 0 0 0 3
if ne rc2 AS_ERR_PROOF_ANTIBODY
ret glFail 44
end
if ne get fabVer 1 v1Before
ret glFail 45
end
if ne get fabMode 1 FAB_MODE_NEURAL
ret glFail 46
end
if ne get as_refusals 0 add refBefore 2
ret glFail 47
end
glAddNeg 1
note Negative Control 3: violated TargetDesc SMEM contract (M=8, K=4096 -> 131072 B > SM121 101376 B) -> REFUSED!
rc3 = as_specialize_slot 0 AS_KIND_GPU_GEMM 8 4096 4096 7
if ne rc3 AS_ERR_CONTRACT_SMEM
ret glFail 48
end
if ne get as_last_contract_err 0 TDK_ERR_SMEM
ret glFail 49
end
if ne get fabVer 0 v0Before
ret glFail 50
end
if ne get as_refusals 0 add refBefore 3
ret glFail 51
end
glAddNeg 1
glAddChk 12
ret 0
end

note Phase 4: Hot-shape TID_A725 background specialization + crystallization (proofMask=7) + specialized dispatch!
fn glPhase4SpecializeAndRun to int
note Observe neural skill slot 1 until threshold (>= 4) to queue its TID_A725 crystallization job too
for i ulong 4
hn = as_observe 1 2002 1 2 1
end
if ne as_pending_jobs 2
ret glFail 60
end
if ne get as_job_exec_tid 1 TID_A725
ret glFail 61
end
note Drain TID_A725 queue with full 3-bit proof gate (proofMask = 7)
sw = as_run_bg_queue 7
if ne sw 2
ret glFail 62
end
if ne as_pending_jobs 0
ret glFail 63
end
if ne get as_swaps 0 2
ret glFail 64
end
note Verify Slot 0 GPU GEMM promotion: REG_TILE_M, fabVer 1->2, Antibody #14 stall >= 6 verified!
if ne get fabVer 0 2
ret glFail 65
end
if ne get fabMode 0 FAB_MODE_GPU_NATIVE
ret glFail 66
end
if ne get fabCostNs 0 20000
ret glFail 67
end
if ne get peOut 0 PE_REGIME_REG_TILE_M
ret glFail 68
end
if ne get peOut 1 65536
ret glFail 69
end
if not as_verify_antibodies
ret glFail 70
end
note Bonus Antibody #14 sensitivity check: corrupt stall=2 -> must reject, then restore valid SASS!
put isBuf 8 2
if as_verify_antibodies
ret glFail 71
end
if not isCompileTestFn TID_SM121
ret glFail 72
end
if not as_verify_antibodies
ret glFail 73
end
note Verify Slot 1 crystallization promotion: fabVer 1->2, cost 15,000,000 ns -> 500 ns!
if ne get fabVer 1 2
ret glFail 74
end
if ne get fabMode 1 FAB_MODE_CRYSTALLIZED
ret glFail 75
end
if ne get fabCostNs 1 500
ret glFail 76
end
if ne get crOp1 0 OIR_ADD
ret glFail 77
end
if ne get crOp2 0 OIR_MUL
ret glFail 78
end
if ne get crConstC 0 3
ret glFail 79
end
note Run specialized in-domain dispatches on Slot 0 & Slot 1 and verify latency saved + 100% coact hits!
rv = as_dispatch_checked 0 4 4096
if ne rv 16384
ret glFail 80
end
if ne get as_last_status 0 AS_DISP_SPECIALIZED
ret glFail 81
end
rv = as_dispatch_checked 1 7 5
if ne rv 36
ret glFail 82
end
if ne get as_last_status 0 AS_DISP_SPECIALIZED
ret glFail 83
end
rv = as_dispatch_checked 0 4 4096
if ne rv 16384
ret glFail 84
end
if ne get as_last_status 0 AS_DISP_SPECIALIZED
ret glFail 85
end
rv = as_dispatch_checked 1 12 8
if ne rv 60
ret glFail 86
end
if ne get as_last_status 0 AS_DISP_SPECIALIZED
ret glFail 87
end
if ne get as_spec_hits 0 4
ret glFail 88
end
if ne get as_coact_hits 0 get as_coact_preds 0
ret glFail 89
end
if ne get as_latency_saved_ns 0 59959000
ret glFail 90
end
glAddChk 31
ret 0
end

note Phase 5: Negative Control 4 (Out-of-domain input on crystallized slot 1 -> ORACLE alarm + atomic rollback!)
fn glPhase5OracleRollback to int
yOod = as_dispatch_checked 1 200 1
if ne yOod 603
ret glFail 91
end
if ne get as_last_status 0 AS_DISP_ROLLBACK
ret glFail 92
end
if ne get as_alarms 0 1
ret glFail 93
end
if ne get as_alarm_slot 0 1
ret glFail 94
end
if ne get as_alarm_x0 0 200
ret glFail 95
end
if ne get as_alarm_code 0 AS_ALARM_OOD
ret glFail 96
end
if ne get fabMode 1 FAB_MODE_NEURAL
ret glFail 97
end
if ne get fabPtr 1 8192
ret glFail 98
end
if ne get fabCostNs 1 15000000
ret glFail 99
end
if ne get fabVer 1 3
ret glFail 100
end
if ne get as_rollbacks 0 1
ret glFail 101
end
note Post-rollback continuity: subsequent dispatch on slot 1 runs cleanly on safe baseline!
ySafe = as_dispatch_checked 1 7 5
if ne ySafe 36
ret glFail 102
end
if ne get as_last_status 0 AS_DISP_BASELINE
ret glFail 103
end
if ne get as_rollbacks 0 1
ret glFail 104
end
glAddNeg 1
glAddChk 14
ret 0
end

note Phase 6: Telemetry consistency checks
fn glPhase6Telemetry to int
if ne as_telemetry_get 0 14
ret glFail 110
end
if ne as_telemetry_get 1 4
ret glFail 111
end
if lt as_telemetry_get 2 9
ret glFail 112
end
if ne as_telemetry_get 3 3
ret glFail 113
end
if ne as_telemetry_get 4 1
ret glFail 114
end
if ne as_telemetry_get 5 59959000
ret glFail 115
end
if ne as_telemetry_get 6 2
ret glFail 116
end
if ne as_telemetry_get 7 1
ret glFail 117
end
if ne as_telemetry_get 10 2
ret glFail 118
end
glAddChk 9
ret 0
end

fn main to int
tdInitAll
isInitRules
tdCacheInit
fabInit
crInit
as_init
put glChk 0 0
put glNeg 0 0
glSay 0
r = glPhase1ColdBaseline
if ne r 0
ret r
end
r = glPhase2CoactAndObserve
if ne r 0
ret r
end
r = glPhase3NegControlsProofs
if ne r 0
ret r
end
r = glPhase4SpecializeAndRun
if ne r 0
ret r
end
r = glPhase5OracleRollback
if ne r 0
ret r
end
r = glPhase6Telemetry
if ne r 0
ret r
end
glSay 1
glNum as_telemetry_get 0
glSay 2
glNum as_telemetry_get 1
glSay 3
glNum as_telemetry_get 2
glSay 4
glNum as_telemetry_get 3
glSay 5
glNum as_telemetry_get 5
glSay 11
glSay 6
glNum get glChk 0
glSay 7
glNum get as_swaps 0
glSay 8
glNum get as_rollbacks 0
glSay 9
glNum get glNeg 0
glSay 10
ret 0
end

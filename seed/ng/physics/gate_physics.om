note SPDX-License-Identifier: Apache-2.0
note seed/ng/physics/gate_physics.om
note Standalone Pure Seeded OM-2 Verification Gate for Sovereign Intelligence 2.0 Stage 3
note (Pillar 3: Physics-Typed Computing — Pareto Bank + WattCBF <-> fabHotSwap + Chain Error).
note
note Strictly DRY_RUN_READONLY (hw_writes == 0): zero sysfs/GPU/UEFI/SPI writes.
note
note Compose & build with pinned seeded omc (SHA-256 85b84c6d...):
note   cat si/directives/om2.om \
note       apps/omega-wattd/watt_sense.om \
note       apps/omega-wattd/watt_cbf.om \
note       seed/ng/target/target_desc.om \
note       seed/ng/target/isel.om \
note       seed/ng/target/sm121_pe.om \
note       seed/ng/target/fabric.om \
note       seed/ng/physics/pareto_bank.om \
note       seed/ng/physics/phys_solver.om \
note       seed/ng/physics/gate_physics.om | seed/out/omc > /tmp/gate_physics

const PG_SEM_FRAME ulong 9001
const PG_SEM_TRAP14 ulong 9002
const PG_SEM_TRAP14_ONLY ulong 9003
const PG_SEM_ERR_ONLY ulong 9004
const PG_SEM_POWER_CAP ulong 9005

global pg_pass ulong 1
global pg_neg ulong 1

text pg_hdr "=== OMEGA NG STAGE 3 (PHYSICS-TYPED COMPUTING) VERIFICATION GATE ===\n"
text pg_p "PASS "
text pg_f "FAIL "
text pg_nl "\n"

text pg_t1 "T1_pareto_bank_proof_gate"
text pg_t1_d " admitted=9 frontier="
text pg_t1_d2 " unproved_refused="

text pg_t2 "T2_thermal_ramp_60c_to_84c_16p6ms"
text pg_t2_d " ramp=BF16->FP8->NVFP4->CPU_X925->CPU_A725(SLIP) swaps="
text pg_t2_d2 " alarms="
text pg_t2_d3 " ty_bf16="
text pg_t2_d4 " ty_a725="

text pg_t3 "T3_trap14_90w_clamped_and_refused"
text pg_t3_d " cbf_90w_gpu_mw=62640 cbf_h=668 solo_90w=REFUSED pair_picked_mw=50000"

text pg_t4 "T4_err_bound_inviolable"
text pg_t4_d " exact_picked_prec=CPU_X925 err=0 loose_only_tol10=REFUSED"

text pg_t5 "T5_hard_deadline_vs_soft_alarm"
text pg_t5_d " hard_84c=PHYS_ERR_HARD_DEADLINE fab_unchanged=1 soft_84c=ALARM_DEADLINE_SLIP slip_us=5400"

text pg_t6 "T6_chain_error_composition"
text pg_t6_d " add_100_pass=1 add_105_refused=1 amp_pass=1 amp_ovf_refused=1 exact_refused=1"

text pg_t7 "T7_oir_v2_wire_contract_parser"
text pg_t7_d " valid_28b=OK bad_res=REFUSED bad_exact_err=REFUSED bad_hard_dl0=REFUSED bad_tier=REFUSED"

text pg_t8 "T8_overtemp_and_bad_policy_fail_closed"
text pg_t8_d " overtemp_die=FAIL_CLOSED overtemp_sink=FAIL_CLOSED neg_budget=FAIL_CLOSED fan=100"

text pg_t9 "T9_contract_power_cap_and_arboris_shortcut"
text pg_t9_d " cap_25w_picked=ARBORIS_SHORTCUT mode=CRYSTALLIZED ty_shortcut="

text pg_t10 "T10_readonly_actuator_and_telemetry"
text pg_t10_d " actuator_mode=DRY_RUN_READONLY hw_writes=0 total_dispatches="
text pg_t10_d2 " total_refusals="

text pg_sum_ok "GATE_PHYSICS PASS checks="
text pg_sum_fail "GATE_PHYSICS FAIL checks="
text pg_sum_of "/10 neg_controls="
text pg_sum_tail " hw_writes=0\n"

fn pg_add_neg n ulong to void
put pg_neg 0 add get pg_neg 0 n
end

fn pg_reg sem_id ulong tid ulong prec ulong pw long lat long eb long to ulong
uj = pb_calc_joules_uj pw lat
cptr = add 65536 mul prec 4096
pb_stage_id sem_id tid prec PB_PROOF_REQUIRED cptr
pb_stage_phys pw lat uj eb 1000000
ret pb_commit
end

fn pg_put_u64_rec dst edit uchar 28 off ulong v ulong to void
for k ulong 8
b = uchar and shr v mul k 8 255
put dst add off k b
end
end

fn pg_enc_v2_hdr dst edit uchar 28 pur ulong tier ulong hdl ulong res ulong to void
put dst 0 uchar and pur 255
put dst 1 uchar and tier 255
put dst 2 uchar and hdl 255
put dst 3 uchar and res 255
end

fn pg_enc_v2_vals dst edit uchar 28 eb ulong dl ulong pwr ulong to void
pg_put_u64_rec dst 4 eb
pg_put_u64_rec dst 12 dl
pg_put_u64_rec dst 20 pwr
end

note T1: Pareto Realization Bank across all 9 profiles + strict proof_mask == 7 negative controls
fn pg_t1_pareto_bank to bool
ok = true
pb_init
note Register all 9 named profiles on PG_SEM_FRAME (with distinct power/latency/error trade-offs)
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_FP64 76000 9000 0 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_FP32 72000 5500 1 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_BF16 68000 2500 10 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_FP8 48000 4000 40 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_NVFP4 26000 6500 100 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 18000 13000 0 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_A725 PB_PREC_CPU_A725 5000 22000 0 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_SM121 PB_PREC_SM121 78000 1800 50 PB_OK
ok = false
end
if ne pg_reg PG_SEM_FRAME TID_A725 PB_PREC_ARBORIS_SHORTCUT 8000 500 250 PB_OK
ok = false
end
if ne pb_count_for_sem PG_SEM_FRAME 9
ok = false
end
note Negative controls: proof_mask != 7 MUST be refused (0, 3, 5, 6, 8, 15)
pb_stage_phys 10000 1000 10000 0 1000000
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 0 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 3 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 5 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 6 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 8 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 15 9999
if ne pb_commit PB_ERR_PROOF_MASK
ok = false
end
pg_add_neg 1
note Negative controls: zero code_ptr and invalid latency/power refused
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 7 0
if ne pb_commit PB_ERR_BAD_PTR
ok = false
end
pb_stage_id PG_SEM_FRAME TID_X925 PB_PREC_CPU_X925 7 9999
pb_stage_phys -1 1000 1000 0 1000000
if ne pb_commit PB_ERR_BAD_METRICS
ok = false
end
pb_stage_phys 10000 0 0 0 1000000
if ne pb_commit PB_ERR_BAD_METRICS
ok = false
end
pg_add_neg 1
if ne pb_count_for_sem PG_SEM_FRAME 9
ok = false
end
if ne get pb_rej_proof 0 6
ok = false
end
fc = pb_frontier_count PG_SEM_FRAME
if eq fc 0
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t1
wd_puts pg_t1_d
wd_put_u64 fc
wd_puts pg_t1_d2
wd_put_u64 get pb_rej_proof 0
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t1
wd_puts pg_nl
end
ret ok
end

note T2: Dynamic precision scaling across 60C -> 78C -> 81C -> 83C -> 84C thermal ramp & 16.6 ms budget
fn pg_t2_thermal_ramp to bool
ok = true
fabInit
ps_init
ps_set_baseline 15000 5000 40
note Contract: @pure @tol 100 @deadline 16600 (soft) @power 0
note Note: ARBORIS_SHORTCUT has err=250 > 100, SM121 raw has pw=78000 (pruned by @power 70000)
ps_set_contract 1 long PHYS_TIER_TOL 0 100 16600 70000
pol = new WattPolicy 110000 80000 85000 5
st = new WattThermal 60000 54000 25000
note Step 1: 60.0 C (cool) -> picks BF16 (68 W, 2500 us <= 16600 us, err=10)
rc = ps_dispatch PG_SEM_FRAME 0 st pol
ty_bf16 = get ps_tel PS_TEL_TURING_YIELD
if ne rc PHYS_OK
ok = false
end
if ne get ps_tel PS_TEL_PREC long PB_PREC_BF16
ok = false
end
if ne get fabTid 0 TID_SM121
ok = false
end
if ne get fabVer 0 1
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
if le ty_bf16 0
ok = false
end
note Step 2: 78.0 C (warm, P_safe_gpu=50640 mW) -> prunes BF16 (68 W), picks FP8 (48 W, 4000 us)
put st t_die 78000
put st t_sink 76000
rc = ps_dispatch PG_SEM_FRAME 0 st pol
if ne rc PHYS_OK
ok = false
end
if ne get ps_tel PS_TEL_PREC long PB_PREC_FP8
ok = false
end
if ne get fabVer 0 2
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
note Step 3: 81.0 C (hot, P_safe_gpu=28640 mW) -> prunes FP8 (48 W), picks NVFP4 (26 W, 6500 us)
put st t_die 81000
put st t_sink 79500
rc = ps_dispatch PG_SEM_FRAME 0 st pol
if ne rc PHYS_OK
ok = false
end
if ne get ps_tel PS_TEL_PREC long PB_PREC_NVFP4
ok = false
end
if ne get fabVer 0 3
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
note Step 4: 83.0 C (very hot, P_safe_gpu=13320 mW) -> migrates off GPU to CPU_X925 (18 W CPU, 13000 us <= 16600)
put st t_die 83000
put st t_sink 82000
rc = ps_dispatch PG_SEM_FRAME 0 st pol
if ne rc PHYS_OK
ok = false
end
if ne get ps_tel PS_TEL_PREC long PB_PREC_CPU_X925
ok = false
end
if ne get fabTid 0 TID_X925
ok = false
end
if ne get fabMode 0 FAB_MODE_CPU_NATIVE
ok = false
end
if ne get fabVer 0 4
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
note Step 5: 84.0 C (ceiling edge, P_safe_cpu_extra=13200 mW) -> prunes X925 (18 W), picks CPU_A725 (5 W, 22000 us) + ALARM_DEADLINE_SLIP!
put st t_die 84000
put st t_sink 84000
rc = ps_dispatch PG_SEM_FRAME 0 st pol
ty_a725 = get ps_tel PS_TEL_TURING_YIELD
if ne rc PHYS_OK_DEADLINE_SLIP
ok = false
end
if ne get ps_tel PS_TEL_PREC long PB_PREC_CPU_A725
ok = false
end
if ne get ps_tel PS_TEL_ALARM_CODE long PHYS_ALARM_DEADLINE_SLIP
ok = false
end
if ne get ps_tel PS_TEL_DL_MARGIN_US -5400
ok = false
end
if ne get fabTid 0 TID_A725
ok = false
end
if ne get fabVer 0 5
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
if le ty_a725 0
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t2
wd_puts pg_t2_d
wd_put_u64 get fabVer 0
wd_puts pg_t2_d2
wd_put_u64 get ps_alm_count 0
wd_puts pg_t2_d3
wd_put_i64 ty_bf16
wd_puts pg_t2_d4
wd_put_i64 ty_a725
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t2
wd_puts pg_nl
end
ret ok
end

fn pg_t3_check_cbf st90 view WattThermal pol90 view WattPolicy to bool
pr90 = new WattProp 90000 15000 5000 40
cmd90 = new WattCmd 0 0 0 0 0 0
wc_cbf_filter st90 pol90 pr90 cmd90
dt90 = wc_next_die_delta st90 get cmd90 p_gpu get cmd90 p_cpu get cmd90 p_unc
h90 = wc_barrier_h 78000 76000 2 dt90
if ne get cmd90 p_gpu 62640
ret false
end
if ne h90 668
ret false
end
if ne get cmd90 fan_pct 100
ret false
end
ret true
end

note T3: Trap-14 90 W spike clamped by WattCBF AND refused by phys_solver
fn pg_t3_trap14_90w to bool
ok = true
st90 = new WattThermal 76000 66000 25000
pol90 = new WattPolicy 110000 80000 78000 2
if not pg_t3_check_cbf st90 pol90
ok = false
end
note Register a 90 W Trap-14 GPU realization on PG_SEM_TRAP14_ONLY (solo) and paired with safe 50 W on PG_SEM_TRAP14
if ne pg_reg PG_SEM_TRAP14_ONLY TID_SM121 PB_PREC_SM121 90000 500 0 PB_OK
ok = false
end
if ne pg_reg PG_SEM_TRAP14 TID_SM121 PB_PREC_SM121 90000 500 0 PB_OK
ok = false
end
if ne pg_reg PG_SEM_TRAP14 TID_SM121 PB_PREC_FP8 50000 3000 0 PB_OK
ok = false
end
ps_set_baseline 15000 5000 40
ps_set_contract 1 long PHYS_TIER_EXACT 0 0 16600 0
ver_before = get fabVer 1
rc = ps_dispatch PG_SEM_TRAP14_ONLY 1 st90 pol90
if ne rc PHYS_ERR_WATTCBF_UNSAFE
ok = false
end
if ne get fabVer 1 ver_before
ok = false
end
pg_add_neg 1
rc = ps_dispatch PG_SEM_TRAP14 1 st90 pol90
if ne rc PHYS_OK
ok = false
end
if ne get ps_tel PS_TEL_POWER_MW 50000
ok = false
end
if ne get fabVer 1 add ver_before 1
ok = false
end
if lt get ps_tel PS_TEL_BARRIER_H 0
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t3
wd_puts pg_t3_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t3
wd_puts pg_nl
end
ret ok
end

note T4: Declared @err bound is NEVER silently broken
fn pg_t4_err_bound to bool
ok = true
st = new WattThermal 83000 82000 25000
pol = new WattPolicy 110000 80000 85000 5
ps_set_baseline 15000 5000 40
note At 83 C under @exact, NVFP4/FP8/BF16/ARBORIS are ineligible; picks exact CPU_X925 (err=0)
ps_set_contract 1 long PHYS_TIER_EXACT 0 0 16600 0
rc_ex = ps_dispatch PG_SEM_FRAME 2 st pol
if or ne rc_ex PHYS_OK or ne get ps_tel PS_TEL_ERR_BOUND 0 ne get ps_tel PS_TEL_PREC long PB_PREC_CPU_X925
ok = false
end
note Negative control: PG_SEM_ERR_ONLY holds only err=50 and err=100; under @tol 10 MUST refuse!
if ne pg_reg PG_SEM_ERR_ONLY TID_SM121 PB_PREC_FP8 30000 1000 50 PB_OK
ok = false
end
if ne pg_reg PG_SEM_ERR_ONLY TID_SM121 PB_PREC_NVFP4 20000 800 100 PB_OK
ok = false
end
st_cool = new WattThermal 60000 54000 25000
ps_set_contract 1 long PHYS_TIER_TOL 0 10 16600 0
ver_b = get fabVer 3
rc_bad = ps_dispatch PG_SEM_ERR_ONLY 3 st_cool pol
if or ne rc_bad PHYS_ERR_ERR_BOUND ne get fabVer 3 ver_b
ok = false
end
pg_add_neg 1
if ok
wd_puts pg_p
wd_puts pg_t4
wd_puts pg_t4_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t4
wd_puts pg_nl
end
ret ok
end

note T5: @hard_deadline fail-closed refusal vs soft deadline explicit ALARM_DEADLINE_SLIP
fn pg_t5_hard_vs_soft to bool
ok = true
st84 = new WattThermal 84000 84000 25000
pol = new WattPolicy 110000 80000 85000 5
ps_set_baseline 15000 5000 40
note Hard deadline = 1: MUST fail closed with PHYS_ERR_HARD_DEADLINE and NOT touch fabWtbl[4]
ps_set_contract 1 long PHYS_TIER_TOL 1 100 16600 70000
ver_b = get fabVer 4
alm_b = get ps_alm_count 0
rc_h = ps_dispatch PG_SEM_FRAME 4 st84 pol
if or ne rc_h PHYS_ERR_HARD_DEADLINE or ne get fabVer 4 ver_b ne get ps_alm_count 0 alm_b
ok = false
end
pg_add_neg 1
note Soft deadline = 0: MUST pick CPU_A725 (22000 us) AND emit explicit ALARM_DEADLINE_SLIP (slip=5400)
ps_set_contract 1 long PHYS_TIER_TOL 0 100 16600 70000
rc_s = ps_dispatch PG_SEM_FRAME 4 st84 pol
if or ne rc_s PHYS_OK_DEADLINE_SLIP ne get ps_tel PS_TEL_PREC long PB_PREC_CPU_A725
ok = false
end
if or ne get fabVer 4 add ver_b 1 ne get ps_alm_count 0 add alm_b 1
ok = false
end
if or ne get ps_alm_code alm_b PHYS_ALARM_DEADLINE_SLIP ne get ps_alm_slip alm_b 5400
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t5
wd_puts pg_t5_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t5
wd_puts pg_nl
end
ret ok
end

note T6: Composed multi-stage call-chain error check PASS & overflow REFUSAL
fn pg_t6_chain_error to bool
ok = true
note 6a: Additive chain [40, 35, 25] <= 100 -> PASS
if ne ps_chain_begin 100 long PHYS_TIER_TOL PHYS_OK
ok = false
end
if ne ps_chain_add_stage 101 40 PHYS_OK
ok = false
end
if ne ps_chain_add_stage 102 35 PHYS_OK
ok = false
end
if ne ps_chain_add_stage 103 25 PHYS_OK
ok = false
end
if or ne get ps_ch_total_err 0 100 ne ps_chain_commit PHYS_OK
ok = false
end
note 6b: Negative control — additive overflow [40, 35, 30] = 105 > 100 -> REFUSED
if ne ps_chain_begin 100 long PHYS_TIER_TOL PHYS_OK
ok = false
end
if ne ps_chain_add_stage 101 40 PHYS_OK
ok = false
end
if ne ps_chain_add_stage 102 35 PHYS_OK
ok = false
end
if ne ps_chain_add_stage 103 30 PHYS_ERR_CHAIN_ERR_OVERFLOW
ok = false
end
if ne ps_chain_commit PHYS_ERR_CHAIN_ERR_OVERFLOW
ok = false
end
pg_add_neg 1
note 6c: Outward-rounded Lipschitz interval composition (amp=120/100):
note Stage 1: 40 -> Stage 2: ceil(40*120/100)+20 = 48+20 = 68 <= 70 PASS
if ne ps_chain_begin 70 long PHYS_TIER_TOL PHYS_OK
ok = false
end
if ne ps_chain_add_stage_amp 201 40 100 100 PHYS_OK
ok = false
end
if ne ps_chain_add_stage_amp 202 20 120 100 PHYS_OK
ok = false
end
if or ne get ps_ch_total_err 0 68 ne ps_chain_commit PHYS_OK
ok = false
end
note 6d: Negative control — amplified overflow: ceil(40*125/100)+21 = 50+21 = 71 > 70 -> REFUSED
if ne ps_chain_begin 70 long PHYS_TIER_TOL PHYS_OK
ok = false
end
if ne ps_chain_add_stage_amp 201 40 100 100 PHYS_OK
ok = false
end
if ne ps_chain_add_stage_amp 202 21 125 100 PHYS_ERR_CHAIN_ERR_OVERFLOW
ok = false
end
if ne ps_chain_commit PHYS_ERR_CHAIN_ERR_OVERFLOW
ok = false
end
pg_add_neg 1
note 6e: Negative control — @exact outer chain (err=0) refuses even stage_err=1
if ne ps_chain_begin 0 long PHYS_TIER_EXACT PHYS_OK
ok = false
end
if ne ps_chain_add_stage 301 1 PHYS_ERR_CHAIN_ERR_OVERFLOW
ok = false
end
pg_add_neg 1
if ok
wd_puts pg_p
wd_puts pg_t6
wd_puts pg_t6_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t6
wd_puts pg_nl
end
ret ok
end

note T7: Live 28-byte ΩIR v2 wire contract record parsing & malformed refusals (IR.md §16.1)
fn pg_t7_oir_v2_wire to bool
ok = true
rec = new uchar 28 0
note Valid v2 record: pure=1, tier=2 (@tol), hard=1, res=0, err=128, dl=16600, pwr=60000
pg_enc_v2_hdr rec 1 2 1 0
pg_enc_v2_vals rec 128 16600 60000
if ne ps_parse_oir_v2_contract part rec 0 28 PHYS_OK
ok = false
end
if or ne get ps_ctr 0 1 or ne get ps_ctr 1 2 ne get ps_ctr 2 1
ok = false
end
if or ne get ps_ctr 3 128 or ne get ps_ctr 4 16600 ne get ps_ctr 5 60000
ok = false
end
note Drive live dispatch from the parsed ΩIR v2 contract (at 60 C -> picks FP8 48 W <= 60 W!)
st = new WattThermal 60000 54000 25000
pol = new WattPolicy 110000 80000 85000 5
ps_set_baseline 15000 5000 40
rc = ps_dispatch PG_SEM_FRAME 5 st pol
if or ne rc PHYS_OK ne get ps_tel PS_TEL_PREC long PB_PREC_FP8
ok = false
end
note Negative controls: nonzero reserved byte, @exact with err>0, @hard_deadline with dl=0, tier=3
pg_enc_v2_hdr rec 1 2 0 1
pg_enc_v2_vals rec 10 16600 0
if ne ps_parse_oir_v2_contract part rec 0 28 PHYS_ERR_BAD_CONTRACT
ok = false
end
pg_enc_v2_hdr rec 1 1 0 0
pg_enc_v2_vals rec 5 16600 0
if ne ps_parse_oir_v2_contract part rec 0 28 PHYS_ERR_BAD_CONTRACT
ok = false
end
pg_enc_v2_hdr rec 1 2 1 0
pg_enc_v2_vals rec 10 0 0
if ne ps_parse_oir_v2_contract part rec 0 28 PHYS_ERR_BAD_CONTRACT
ok = false
end
pg_enc_v2_hdr rec 1 3 0 0
pg_enc_v2_vals rec 0 16600 0
if ne ps_parse_oir_v2_contract part rec 0 28 PHYS_ERR_BAD_CONTRACT
ok = false
end
pg_add_neg 1
if ok
wd_puts pg_p
wd_puts pg_t7
wd_puts pg_t7_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t7
wd_puts pg_nl
end
ret ok
end

note T8: Over-temperature die/sink and invalid policy fail closed via WattCBF
fn pg_t8_overtemp_fail_closed to bool
ok = true
ps_set_baseline 15000 5000 40
ps_set_contract 1 long PHYS_TIER_TOL 0 100 16600 0
pol_ok = new WattPolicy 110000 80000 85000 5
ver_b = get fabVer 6
note 8a: Die over ceiling (86 C >= 85 C)
st_hot_d = new WattThermal 86000 70000 25000
if ne ps_dispatch PG_SEM_FRAME 6 st_hot_d pol_ok PHYS_ERR_WATTCBF_FAIL_CLOSED
ok = false
end
if or ne get ps_tel PS_TEL_FAN_PCT 100 ne get ps_tel PS_TEL_P_SAFE_GPU 0
ok = false
end
note 8b: Sink over ceiling (90 C >= 85 C)
st_hot_s = new WattThermal 60000 90000 25000
if ne ps_dispatch PG_SEM_FRAME 6 st_hot_s pol_ok PHYS_ERR_WATTCBF_FAIL_CLOSED
ok = false
end
note 8c: Invalid negative WattPolicy budget (-1000 mW)
st_cool = new WattThermal 60000 54000 25000
pol_bad = new WattPolicy -1000 80000 85000 5
if ne ps_dispatch PG_SEM_FRAME 6 st_cool pol_bad PHYS_ERR_WATTCBF_FAIL_CLOSED
ok = false
end
if ne get fabVer 6 ver_b
ok = false
end
pg_add_neg 1
if ok
wd_puts pg_p
wd_puts pg_t8
wd_puts pg_t8_d
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t8
wd_puts pg_nl
end
ret ok
end

note T9: Contract @power cap + ARBORIS_SHORTCUT crystallized fabMode & TuringYield_J gain
fn pg_t9_power_cap_arboris to bool
ok = true
if ne pg_reg PG_SEM_POWER_CAP TID_SM121 PB_PREC_NVFP4 30000 1200 20 PB_OK
ok = false
end
if ne pg_reg PG_SEM_POWER_CAP TID_A725 PB_PREC_ARBORIS_SHORTCUT 8000 500 25 PB_OK
ok = false
end
st = new WattThermal 60000 54000 25000
pol = new WattPolicy 110000 80000 85000 2
ps_set_baseline 10000 5000 40
note Tight @power 25000 prunes 30 W NVFP4 even at 60 C -> picks 8 W ARBORIS_SHORTCUT (CRYSTALLIZED)
ps_set_contract 1 long PHYS_TIER_TOL 1 50 1000 25000
rc = ps_dispatch PG_SEM_POWER_CAP 7 st pol
ty_sc = get ps_tel PS_TEL_TURING_YIELD
if or ne rc PHYS_OK ne get ps_tel PS_TEL_PREC long PB_PREC_ARBORIS_SHORTCUT
ok = false
end
if or ne get fabMode 7 FAB_MODE_CRYSTALLIZED ne get fabCostNs 7 500
ok = false
end
if le ty_sc 0
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t9
wd_puts pg_t9_d
wd_put_i64 ty_sc
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t9
wd_puts pg_nl
end
ret ok
end

note T10: Strictly DRY_RUN_READONLY actuator invariant (hw_writes == 0) + cumulative telemetry check
fn pg_t10_readonly_telemetry to bool
ok = true
if ne get g_wmeta 12 0
ok = false
end
if ne get ps_tel PS_TEL_HW_WRITES 0
ok = false
end
if ne get ps_tel PS_TEL_ACTUATOR_MODE long PHYS_ACTUATOR_DRY_RUN_READONLY
ok = false
end
if le get ps_stats 0 0
ok = false
end
if le get ps_stats 1 0
ok = false
end
if le get ps_stats 3 0
ok = false
end
if ok
wd_puts pg_p
wd_puts pg_t10
wd_puts pg_t10_d
wd_put_u64 get ps_stats 0
wd_puts pg_t10_d2
wd_put_u64 get ps_stats 1
wd_puts pg_nl
else
wd_puts pg_f
wd_puts pg_t10
wd_puts pg_nl
end
ret ok
end

fn main to int
tdInitAll
isInitRules
tdCacheInit
fabInit
pb_init
ps_init
put pg_pass 0 0
put pg_neg 0 0
wd_puts pg_hdr
if pg_t1_pareto_bank
put pg_pass 0 add get pg_pass 0 1
end
if pg_t2_thermal_ramp
put pg_pass 0 add get pg_pass 0 1
end
if pg_t3_trap14_90w
put pg_pass 0 add get pg_pass 0 1
end
if pg_t4_err_bound
put pg_pass 0 add get pg_pass 0 1
end
if pg_t5_hard_vs_soft
put pg_pass 0 add get pg_pass 0 1
end
if pg_t6_chain_error
put pg_pass 0 add get pg_pass 0 1
end
if pg_t7_oir_v2_wire
put pg_pass 0 add get pg_pass 0 1
end
if pg_t8_overtemp_fail_closed
put pg_pass 0 add get pg_pass 0 1
end
if pg_t9_power_cap_arboris
put pg_pass 0 add get pg_pass 0 1
end
if pg_t10_readonly_telemetry
put pg_pass 0 add get pg_pass 0 1
end
p = get pg_pass 0
if eq p 10
wd_puts pg_sum_ok
wd_put_u64 p
wd_puts pg_sum_of
wd_put_u64 get pg_neg 0
wd_puts pg_sum_tail
wd_flush
ret 0
end
wd_puts pg_sum_fail
wd_put_u64 p
wd_puts pg_sum_of
wd_put_u64 get pg_neg 0
wd_puts pg_sum_tail
wd_flush
ret 1
end

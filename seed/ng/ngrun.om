note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngrun.om: the ΩIR reference interpreter (lane ng-ir). Build:
note   cat seed/ng/src/ir.om seed/ng/ngrun.om | seed/out/omc > ngrun
note Usage: ngrun FILE.ir [STEPS]. It runs the program entry (IR.md s6.1) of a unit that ngcheck accepts, with
note the meaning of IR.md s7, one op at a time: host words reach the real process (stdout, stderr,
note stdin), the exit status is the entry's i32 result, `exit v` exits v, a failing check or `trap`
note exits 100 + code. Call depth past 65535 frames, more than 4194304 live values or more than
note 16 MiB of memory (globals plus alloca) trap 6 (IR.md s7.9: call and alloca may trap 6).
note It is the oracle of the differential gate (D9): no optimization, nothing shared with a back end;
note it shares only ir.om's reader, which the ΩIR gate checks byte for byte.
note Outside the supported subset it prints one stderr line "ngrun: unsupported op N at OFFSET" (or
note "unsupported host word N") and exits 125; OFFSET is the op's byte offset in the file.
note A file over 16777216 bytes is "ngrun: refused class 23 at 16777216" and exit 23; an unreadable one
note "ngrun: cannot read input" and exit 27.
note Supported: const select, integer and f32/f64 arithmetic, compare, conv, bitcast (10..37), every
note check (70..82), facts (90..93, no effect), load store atom atomcas alloca fill gaddr len slice
note fload fstore fref on scalar elements, br cbr ret retv call trap exit, host read write monons
note realns cpufence cpurelax; fused f32/f64 fma (46); every f32/f64 conv rounding/saturation mode.
note Not yet: vectors and tiles (100..106), kernels (40, 41, 44, 45, 67), fmath (28),
note f16/bf16/fp8, vload/vstore (58, 59).
note Its own limits never exit 100..114 (those are the IR's traps): after STEPS executed ops (default 2^36 =
note 68719476736, about an hour on the Spark, above the 7.8e9 of the sort kernel; a loop without chk.fuel
note may run forever) it prints "ngrun: step limit at OFFSET" (the next
note op) and exits 124; an access whose element lies outside the object its REF or SLICE names (only an
note input ngcheck refuses, UNCHECKED, can reach one) prints "ngrun: access outside storage at OFFSET" and
note exits 126. Other input that ngcheck refuses has no meaning here: ngrun reads it with ir.om and its
note exit status is not an IR result; judge a run only on a unit ngcheck accepts.
note ---- state ------------------------------------------------------------------------------------
note r_s: 0 slot offset (slot = r_s0 + value handle), 1 current function, 2 memory top, 3 call
note depth, 4 value stack top, 5 step budget, 6 steps run
global r_s ulong 8
global r_v ulong 4194304
global r_w ulong 4194304
global r_m uchar 16777216
global r_ga ulong 65537
global r_cf uint 65536
global r_co uint 65536
global r_cs ulong 65536
global r_cm ulong 65536
global r_ct ulong 65536
global r_tv ulong 64
global r_tw ulong 64
global r_dg uchar 24
global r_pa uchar 4096
text r_msg "ngrun: unsupported op \n at \nngrun: unsupported host word \nngrun: refused class \nngrun: usage: ngrun FILE.ir [STEPS]\nngrun: cannot read input\nngrun: step limit at \nngrun: access outside storage at \n"
note ---- messages ---------------------------------------------------------------------------------
fn rn_say a ulong b ulong to void
k = write 2 r_msg a sub b a
end
fn rn_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put r_dg i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 r_dg i sub 24 i
ret
end
end
end
fn rn_nl to void
put r_dg 0 10
k = write 2 r_dg 0 1
end
note one stderr line, message r_msg[a, b) then the offset of op o
fn rn_lim a ulong b ulong o uint to void
rn_say a b
rn_num ulong get i_oof o
rn_nl
end
note an access outside its object (input ngcheck refuses): one line, exit 126
fn rn_oob o uint to void
rn_lim 163 196 o
exit 126
end
note elements [off, off + n) of operand slot k lie inside its object, else rn_oob
fn rn_ext o uint k uint off ulong n ulong to void
l = rn_len o k
if gt off l
rn_oob o
end
if gt n sub l off
rn_oob o
end
end
note an op outside the supported subset: one line, exit 125
fn rn_uns o uint to void
op = ulong get i_oop o
if eq op 110
rn_say 28 57
rn_num get i_oim o
else
rn_say 0 22
rn_num op
end
rn_say 23 27
rn_num ulong get i_oof o
rn_nl
exit 125
end
note ---- values -----------------------------------------------------------------------------------
fn rn_g h uint to ulong
ret get r_v add get r_s 0 ulong h
end
fn rn_gw h uint to ulong
ret get r_w add get r_s 0 ulong h
end
fn rn_p h uint x ulong to void
put r_v add get r_s 0 ulong h x
end
fn rn_pw h uint x ulong to void
put r_w add get r_s 0 ulong h x
end
note value and type of operand slot k of op o
fn rn_a o uint k uint to ulong
ret rn_g ir_arg o k
end
fn rn_aw o uint k uint to ulong
ret rn_gw ir_arg o k
end
fn rn_at o uint k uint to uint
ret get i_vty ir_arg o k
end
note set op o's result (both words)
fn rn_r o uint x ulong to void
h = get i_ors o
if ne h 0
rn_p h x
rn_pw h 0
end
end
fn rn_rw o uint y ulong to void
h = get i_ors o
if ne h 0
rn_pw h y
end
end
note ---- scalar types -----------------------------------------------------------------------------
fn rn_w t uint to ulong
if eq t 1
ret 1
end
if or eq t 2 eq t 6
ret 8
end
if or eq t 3 eq t 7
ret 16
end
if or eq t 4 or eq t 8 eq t 13
ret 32
end
ret 64
end
fn rn_sg t uint to bool
ret and ge t 6 le t 9
end
fn rn_isi t uint to bool
ret and ge t 2 le t 9
end
fn rn_isf t uint to bool
ret or eq t 13 eq t 14
end
note the canonical form of x as type t: zero-extended when unsigned, sign-extended when signed
fn rn_cn t uint x ulong to ulong
w = rn_w t
if eq w 64
ret x
end
y = and x sub shl ulong 1 w 1
if rn_sg t
s = shl ulong 1 sub w 1
ret sub xor y s s
end
ret y
end
fn rn_min t uint to ulong
ret rn_cn t shl ulong 1 sub rn_w t 1
end
fn rn_lt t uint a ulong b ulong to bool
if rn_sg t
ret lt bitcast long a bitcast long b
end
ret lt a b
end
note ---- integer arithmetic (IR.md s7.3: total) -----------------------------------------------------
fn rn_div t uint a ulong b ulong to ulong
if eq b 0
ret 0
end
if rn_sg t
if and eq a rn_min t eq b sub ulong 0 1
ret a
end
ret rn_cn t bitcast ulong div bitcast long a bitcast long b
end
ret div a b
end
fn rn_rem t uint a ulong b ulong to ulong
if eq b 0
ret 0
end
if rn_sg t
if eq b sub ulong 0 1
ret 0
end
ret rn_cn t bitcast ulong rem bitcast long a bitcast long b
end
ret rem a b
end
fn rn_rot t uint a ulong b ulong l bool to ulong
w = rn_w t
s = and b sub w 1
if eq s 0
ret a
end
if not l
s = sub w s
end
ret rn_cn t or shl a s shr a sub w s
end
fn rn_ia op uint t uint a ulong b ulong to ulong
if eq op 10
ret rn_cn t add a b
end
if eq op 11
ret rn_cn t sub a b
end
if eq op 12
ret rn_cn t mul a b
end
if eq op 13
ret rn_div t a b
end
if eq op 14
ret rn_rem t a b
end
if eq op 15
ret rn_cn t sub ulong 0 a
end
if eq op 16
ret and a b
end
if eq op 17
ret or a b
end
if eq op 18
ret xor a b
end
if eq op 19
ret rn_cn t not a
end
s = and b sub rn_w t 1
if eq op 20
ret rn_cn t shl a s
end
if eq op 21
if rn_sg t
ret bitcast ulong shr bitcast long a bitcast long s
end
ret shr a s
end
if eq op 22
ret rn_rot t a b true
end
if eq op 23
ret rn_rot t a b false
end
if eq op 24
if rn_lt t b a
ret b
end
ret a
end
if rn_lt t a b
ret b
end
ret a
end
fn rn_icmp op uint t uint a ulong b ulong to bool
if eq op 30
ret eq a b
end
if eq op 31
ret ne a b
end
if eq op 32
ret rn_lt t a b
end
if eq op 33
ret not rn_lt t b a
end
if eq op 34
ret rn_lt t b a
end
ret not rn_lt t a b
end
note ---- floats: raw bits in the low 32 (f32) or 64 (f64) bits of a value ----------------------------
fn rn_tof t uint a ulong to f64
if eq t 13
ret f64 bitcast f32 uint a
end
ret bitcast f64 a
end
fn rn_f64 op uint a ulong b ulong to ulong
x = bitcast f64 a
y = bitcast f64 b
if eq op 10
ret bitcast ulong add x y
end
if eq op 11
ret bitcast ulong sub x y
end
if eq op 12
ret bitcast ulong mul x y
end
if eq op 13
ret bitcast ulong div x y
end
if eq op 26
ret bitcast ulong fsqrt x
end
ret 0
end
fn rn_f32 op uint a ulong b ulong to ulong
x = bitcast f32 uint a
y = bitcast f32 uint b
if eq op 10
ret ulong bitcast uint add x y
end
if eq op 11
ret ulong bitcast uint sub x y
end
if eq op 12
ret ulong bitcast uint mul x y
end
if eq op 13
ret ulong bitcast uint div x y
end
if eq op 26
ret ulong bitcast uint fsqrt x
end
ret 0
end
note min and max (IR.md s7.3, OMEGESE fmin/fmax, FMINNM/FMAXNM): one quiet NaN gives the other operand;
note a signaling NaN in either operand gives that operand quieted (a first); two quiet NaNs give a; -0 < +0
fn rn_fmm op uint t uint a ulong b ulong to ulong
x = rn_tof t a
y = rn_tof t b
q = ulong 0x0008000000000000
if eq t 13
q = 0x00400000
end
na = ne x x
nb = ne y y
if or na nb
sa = and na eq and a q 0
sb = and nb eq and b q 0
if sa
ret or a q
end
if sb
ret or b q
end
if and na nb
ret or a q
end
if na
ret b
end
ret a
end
if eq op 24
if lt x y
ret a
end
if lt y x
ret b
end
ret or a b
end
if gt x y
ret a
end
if gt y x
ret b
end
ret and a b
end
fn rn_fa op uint t uint a ulong b ulong to ulong
sb = shl ulong 1 sub rn_w t 1
if eq op 15
ret xor a sb
end
if eq op 27
ret and a sub sb 1
end
if or eq op 24 eq op 25
ret rn_fmm op t a b
end
if eq t 13
ret rn_f32 op a b
end
ret rn_f64 op a b
end
fn rn_fcmp op uint t uint a ulong b ulong to bool
x = rn_tof t a
y = rn_tof t b
if eq op 30
ret eq x y
end
if eq op 31
ret ne x y
end
if eq op 32
ret lt x y
end
if eq op 33
ret le x y
end
if eq op 34
ret gt x y
end
ret ge x y
end
fn rn_b2u c bool to ulong
if c
ret 1
end
ret 0
end
note ---- conv and bitcast (IR.md s7.3) -------------------------------------------------------------
note float x to int type t: truncate toward zero, saturate, NaN 0 (omc's conversion has that meaning)
fn rn_f2i t uint x f64 to ulong
if eq t 2
ret ulong uchar x
end
if eq t 3
ret ulong ushort x
end
if eq t 4
ret ulong uint x
end
if eq t 5
ret ulong x
end
if eq t 6
ret bitcast ulong long byte x
end
if eq t 7
ret bitcast ulong long short x
end
if eq t 8
ret bitcast ulong long int x
end
ret bitcast ulong long x
end
fn rn_i2f t uint s uint a ulong to ulong
if eq t 14
if rn_sg s
ret bitcast ulong f64 bitcast long a
end
ret bitcast ulong f64 a
end
if rn_sg s
ret ulong bitcast uint f32 bitcast long a
end
ret ulong bitcast uint f32 a
end
note Integer to float toward zero: retain the leading precision bits, never round upward.
note No intermediate float, so u64 and i64 cannot double-round through f64.
fn rn_i2z t uint s uint a ulong to ulong
v = a
sg = ulong 0
if rn_sg s
if lt bitcast long a 0
v = sub ulong 0 a
sg = shl ulong 1 sub rn_w t 1
end
end
if eq v 0
ret 0
end
p = ulong 23
bias = ulong 127
if eq t 14
p = 52
bias = 1023
end
e = ulong 0
for j ulong 64
if ne shr v j 0
e = j
end
end
m = v
if gt e p
m = shr v sub e p
else
m = shl v sub p e
end
ret or sg or shl add e bias p and m sub shl ulong 1 p 1
end
fn rn_conv o uint to void
t = get i_oty o
s = rn_at o 0
a = rn_a o 0
im = get i_oim o
if and rn_isi t rn_isi s
rn_r o rn_cn t a
ret
end

if or not or rn_isi t rn_isf t not or rn_isi s rn_isf s
rn_uns o
end
if rn_isi s
if eq and im 3 1
rn_r o rn_i2z t s a
ret
end
rn_r o rn_i2f t s a
ret
end
x = rn_tof s a
if rn_isi t
rn_r o rn_f2i t x
ret
end
if eq t 14
rn_r o bitcast ulong x
ret
end
y = f32 x
inf = div 1.0f64 0.0f64
note The nearest result beyond the exact magnitude has the toward-zero predecessor.
if eq and im 3 1
if gt fabs f64 y fabs x
bits = sub ulong bitcast uint y 1
y = bitcast f32 uint bits
end
end
sat = ne and im 4 0
yi = eq fabs f64 y inf
xf = ne fabs x inf
if and sat and yi xf
mx = bitcast f32 uint 2139095039
y = mx
if lt x 0.0f64
y = neg mx
end
end
rn_r o ulong bitcast uint y
end
fn rn_bcast o uint to void
t = get i_oty o
a = rn_a o 0
if rn_isf t
rn_r o rn_cn t a
ret
end
rn_r o rn_cn t a
end
note ---- pure ops (1..37, 46) -----------------------------------------------------------------------
note FMA is one native operation at the declared precision, never widened or split.
fn rn_fused t uint a ulong b ulong c ulong to ulong
if eq t 13
x = bitcast f32 uint a
y = bitcast f32 uint b
z = bitcast f32 uint c
ret ulong bitcast uint fma x y z
end
x = bitcast f64 a
y = bitcast f64 b
z = bitcast f64 c
ret bitcast ulong fma x y z
end
fn rn_pure o uint op uint to void
t = get i_oty o
if eq op 46
if not rn_isf t
rn_uns o
end
rn_r o rn_fused t rn_a o 0 rn_a o 1 rn_a o 2
ret
end
if eq op 1
rn_r o get i_oim o
ret
end
if eq op 2
h = ir_arg o 2
if ne rn_a o 0 0
h = ir_arg o 1
end
rn_r o rn_g h
rn_rw o rn_gw h
ret
end
if eq op 36
rn_conv o
ret
end
if eq op 37
rn_bcast o
ret
end
s = rn_at o 0
a = rn_a o 0
b = ulong 0
if gt get i_ona o 1
b = rn_a o 1
end
if and ge op 30 le op 35
if rn_isf s
rn_r o rn_b2u rn_fcmp op s a b
ret
end
if gt s 9
rn_uns o
end
rn_r o rn_b2u rn_icmp op s a b
ret
end
if or eq op 28 gt t 14
rn_uns o
end
if rn_isf t
rn_r o rn_fa op t a b
ret
end
if or eq op 26 or eq op 27 gt t 9
rn_uns o
end
if eq t 1
rn_r o and rn_ia op 5 a b 1
ret
end
rn_r o rn_ia op t a b
end
note ---- checks (70..82): IR.md s7.9 ---------------------------------------------------------------
fn rn_ckadd t uint a ulong b ulong to bool
r = add a b
if lt rn_w t 64
ret ne rn_cn t r r
end
if rn_sg t
ret ne and and xor a r xor b r shl ulong 1 63 0
end
ret lt r a
end
fn rn_cksub t uint a ulong b ulong to bool
r = sub a b
if lt rn_w t 64
ret ne rn_cn t r r
end
if rn_sg t
ret ne and and xor a b xor a r shl ulong 1 63 0
end
ret lt a b
end
fn rn_ckmul t uint a ulong b ulong to bool
r = mul a b
if lt rn_w t 64
ret ne rn_cn t r r
end
if eq a 0
ret false
end
if not rn_sg t
ret ne div r a b
end
m = shl ulong 1 63
if eq a sub ulong 0 1
ret eq b m
end
if eq b sub ulong 0 1
ret eq a m
end
ret ne div bitcast long r bitcast long a bitcast long b
end
note the exact a x 2^b fits the signed type t when MIN >> b <= a <= MAX >> b
fn rn_ckshl t uint a ulong b ulong to bool
w = rn_w t
if ge b w
ret ne a 0
end
mn = bitcast long rn_min t
mx = long 9223372036854775807
if lt w 64
mx = sub neg mn 1
end
sa = bitcast long a
sb = bitcast long b
if lt sa shr mn sb
ret true
end
ret gt sa shr mx sb
end
note v (type s) outside int type t, float v truncated toward zero first, NaN outside. An unsigned v into a
note signed t of any width is outside from 2^(w-1) up: the canonical test alone would take 2^64 - 1 into i32
note as -1 (bug hunt, ledger L1060; tests/ir x-convu)
fn rn_ckcv t uint s uint v ulong to bool
w = rn_w t
if rn_isf s
x = rn_tof s v
if ne x x
ret true
end
hi = mul f64 shl ulong 1 sub w 1 2.0f64
lo = f64 -1.0
if rn_sg t
hi = f64 shl ulong 1 sub w 1
lo = sub neg hi 1.0
if eq w 64
ret or lt x neg hi ge x hi
end
end
ret or le x lo ge x hi
end
if rn_sg s
sv = bitcast long v
if rn_sg t
ret ne rn_cn t v v
end
if lt sv 0
ret true
end
end
if rn_sg t
ret ge v shl ulong 1 sub w 1
end
ret ne rn_cn t v v
end
fn rn_len o uint k uint to ulong
h = ir_arg o k
rt = get i_vty h
if eq get i_tk rt 5
ret rn_gw h
end
tt = get i_t1 rt
ret ulong get i_t2 tt
end
fn rn_ckfail o uint op uint to bool
t = rn_at o 1
a = rn_a o 1
b = ulong 0
if gt get i_ona o 2
b = rn_a o 2
end
if eq op 70
ret rn_ckadd t a b
end
if eq op 71
ret rn_cksub t a b
end
if eq op 72
ret rn_ckmul t a b
end
if eq op 73
if rn_sg t
ret eq a rn_min t
end
ret ne a 0
end
if eq op 74
ret eq a 0
end
if eq op 75
ret and eq a rn_min t eq b sub ulong 0 1
end
if eq op 76
ret rn_ckshl t a b
end
if eq op 77
ret ge a rn_w t
end
if eq op 78
ret rn_ckcv get i_oty o t a
end
if eq op 81
ret ge a b
end
if eq op 82
ret eq a 0
end
n = rn_len o 1
x = rn_a o 3
if eq op 79
ret or eq x 0 or gt b n gt x sub n b
end
ret or gt b n gt x sub n b
end
fn rn_check o uint to void
if rn_ckfail o uint get i_oop o
exit int add 100 get i_oim o
end
end
note ---- memory ------------------------------------------------------------------------------------
fn rn_ld p ulong n ulong be bool to ulong
x = ulong 0
for j ulong n bound 8
c = ulong get r_m add p j
if be
x = or shl x 8 c
else
x = or x shl c mul j 8
end
end
ret x
end
fn rn_st p ulong n ulong x ulong be bool to void
for j ulong n bound 8
s = mul j 8
if be
s = mul sub sub n 1 j 8
end
put r_m add p j uchar and shr x s 255
end
end
note element type of a REF to ARRAY or a SLICE
fn rn_elt rt uint to uint
if eq get i_tk rt 5
ret get i_t1 rt
end
ret get i_t1 get i_t1 rt
end
note address of element i of operand slot k of op o; refuses non-scalar elements and an i outside the
note object (rn_oob)
fn rn_ea o uint k uint i ulong to ulong
if ge i rn_len o k
rn_oob o
end
ret rn_eau o k i
end
note element i's address without the extent test (i may be the object's end)
fn rn_eau o uint k uint i ulong to ulong
et = rn_elt rn_at o k
if ge et 32
rn_uns o
end
ret add rn_a o k mul i ir_tsize et
end
fn rn_ldv t uint p ulong be bool to ulong
x = rn_ld p ir_tsize t be
if rn_isi t
ret rn_cn t x
end
ret x
end
note memory top aligned to 8, then n zero bytes; trap 6 past 16 MiB
fn rn_alloc n ulong to ulong
p = and add get r_s 2 7 not ulong 7
if gt n sub 16777216 p
exit 106
end
for j ulong n bound 16777216
put r_m add p j 0
end
put r_s 2 add p n
ret p
end
note field slot of field number k of the STRUCT that REF type rt targets
fn rn_fld rt uint k ulong to ulong
ret add ulong get i_t3 get i_t1 rt k
end
fn rn_atom o uint im ulong t uint old ulong v ulong to ulong
f = and im 255
if eq f 0
ret rn_cn t add old v
end
if eq f 1
ret rn_ia 24 t old v
end
if eq f 2
ret rn_ia 25 t old v
end
if eq f 3
ret and old v
end
if eq f 4
ret or old v
end
if eq f 5
ret xor old v
end
ret v
end
fn rn_mem o uint op uint to void
if eq op 52
rn_r o get r_ga get i_oim o
ret
end
if eq op 50
rn_r o rn_alloc ir_tsize get i_t1 get i_oty o
ret
end
if eq op 53
rn_r o rn_len o 0
ret
end
if eq op 42
p = rn_ea o 1 rn_a o 2
rn_r o rn_ldv get i_oty o p false
ret
end
if eq op 43
p = rn_ea o 1 rn_a o 2
rn_st p ir_tsize rn_elt rn_at o 1 rn_a o 3 false
ret
end
if eq op 54
rn_ext o 1 rn_a o 2 rn_a o 3
p = rn_eau o 1 rn_a o 2
rn_r o p
rn_rw o rn_a o 3
ret
end
if eq op 51
n = rn_len o 1
et = rn_elt rn_at o 1
v = rn_a o 2
p = rn_eau o 1 0
for j ulong n bound 16777216
rn_st add p mul j ir_tsize et ir_tsize et v false
end
ret
end
if or eq op 47 eq op 48
t = get i_oty o
if not rn_isi t
rn_uns o
end
p = rn_ea o 1 rn_a o 2
sz = ir_tsize t

note SPDX-License-Identifier: Apache-2.0
note seed/ng/src/main.om: fn main of the ng compiler, last unit of seed/ng/ng.units. Owner: ng-ir lane
note (stage lanes add their modes beside their code). The first input line selects the mode; the bytes
note after its newline are the payload.
note   @ng ir-copy   payload is ΩIR binary: read it with ir_read, write it back with ir_wr (stdout)
note Exit 0 on success; a refused ΩIR input exits with its IR.md s11 class and one stderr line
note "ng: refused class C at OFFSET"; unknown mode 2; unreadable input 27; input over 16 MiB 23.
text ng_modes "@ng ir-copy"
text ng_msgs "ng: refused class \n at \nng: unknown mode\n"
global ng_dig uchar 24
fn ng_slurp to ulong
n = ulong 0
while true bound 16777218
if ge n len i_in
ret n
end
k = read 0 i_in n sub len i_in n
if lt k 0
exit 27
end
if eq k 0
ret n
end
n = add n ulong k
end
ret n
end
fn ng_say a ulong b ulong to void
k = write 2 ng_msgs a sub b a
end
fn ng_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put ng_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 ng_dig i sub 24 i
ret
end
end
end
note 1 when bytes [0, m) of the input are the mode text a and byte m is a newline
fn ng_mode m ulong to bool
if lt len i_in add m 1
ret false
end
for j ulong m bound 64
if ne get i_in j get ng_modes j
ret false
end
end
ret eq get i_in m 10
end
fn main to int
n = ng_slurp
if eq n len i_in
if gt read 0 ng_dig 0 1 0
exit 23
end
end
if ng_mode 11
r = ir_read 12 n
if ne r 0
ng_say 0 18
ng_num r
ng_say 19 23
ng_num sub ir_badat 12
put ng_dig 0 10
k = write 2 ng_dig 0 1
ret int r
end
m = ir_wr
k = write 1 i_out 0 m
if ne k long m
ret 27
end
ret 0
end
ng_say 24 41
ret 2
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/src/main.om: fn main of the ng compiler, last unit of seed/ng/ng.units. Owner: ng-ir lane
note (stage lanes add their modes beside their code). The first input line selects the mode; it is
note read apart, so the payload after its newline fills i_in from offset 0 (up to 16777216 bytes).
note   @ng ir-copy   payload is ΩIR binary: read it with ir_read, write it back with ir_wr (stdout)
note Exit 0 on success; a refused ΩIR input exits with its IR.md s11 class and one stderr line
note "ng: refused class C at OFFSET" (offset in the payload): a payload over 16777216 bytes is
note class 23 at 16777216, an unreadable one class 27 at the bytes read; unknown mode exit 2.
text ng_modes "@ng ir-copy"
text ng_msgs "ng: refused class \n at \nng: unknown mode\n"
global ng_dig uchar 24
global ng_ml uchar 64
note refuse with class c at payload offset off
fn ng_bad c ulong off ulong to void
ng_say 0 18
ng_num c
ng_say 19 23
ng_num off
put ng_dig 0 10
k = write 2 ng_dig 0 1
exit int c
end
note the mode line into ng_ml, one byte at a time up to its newline; its length, or 64 when there
note is no newline within 64 bytes; unreadable input is class 27 at 0
fn ng_line to ulong
for j ulong 64
k = read 0 ng_ml j 1
if lt k 0
ng_bad 27 0
end
if eq k 0
ret 64
end
if eq get ng_ml j 10
ret j
end
end
ret 64
end
fn ng_slurp to ulong
n = ulong 0
while true bound 16777218
if ge n len i_in
ret n
end
k = read 0 i_in n sub len i_in n
if lt k 0
ng_bad 27 n
end
if eq k 0
ret n
end
n = add n ulong k
end
ret n
end
fn ng_say a ulong b ulong to void
k = write 2 ng_msgs a sub b a
end
fn ng_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put ng_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 ng_dig i sub 24 i
ret
end
end
end
note the mode line (length m) is the mode text
fn ng_mode m ulong to bool
if ne m len ng_modes
ret false
end
for j ulong m bound 64
if ne get ng_ml j get ng_modes j
ret false
end
end
ret true
end
fn main to int
m = ng_line
if not ng_mode m
ng_say 24 41
ret 2
end
n = ng_slurp
if eq n len i_in
k = read 0 ng_dig 0 1
if lt k 0
ng_bad 27 n
end
if gt k 0
ng_bad 23 n
end
end
r = ir_read 0 n
if ne r 0
ng_bad r ir_badat
end
w = ir_wr
o = ulong 0
while lt o w bound 16777217
k = write 1 i_out o sub w o
if le k 0
ret 27
end
o = add o ulong k
end
ret 0
end

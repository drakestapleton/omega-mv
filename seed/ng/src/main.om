note SPDX-License-Identifier: Apache-2.0
note seed/ng/src/main.om: fn main of the ng compiler, last unit of seed/ng/ng.units. Owner: ng-ir lane
note (stage lanes add their modes beside their code). The first input line selects the mode; it is
note read apart, so the payload after its newline is region 0 of the arena (src/ir.om ar_rdin) from
note offset 0, as large as the arena holds (no-caps 2026-11-11).
note   @ng ir-copy   payload is ΩIR binary: read it with ir_read, write it back with ir_wr (stdout)
note   @ng front-check   payload is an Omega unit: front.om checks it (fe_check) and refuses exactly as omc
note                 (same stderr line and exit code; 64 for a unit ng does not take); nothing on stdout. A
note                 payload the arena cannot hold is error 14 at line 0, as in omc, with the ng-use record;
note                 an unreadable payload is class 27 below (omc: error 1)
note   @ng front-ir  payload is an Omega unit: checked as front-check (same refusals), then lowered to ΩIR
note                 (fe_lout, seed/ng/IR.md s13) and written with ir_wr (stdout); 64 for a unit or a
note                 construct the lowering does not take
note   @ng opt       payload is ΩIR binary: read it, optimize it (op_run, opt.om: preheaders, LICM, ROT), write it
note   @ng opt-count the same passes; one stdout line of counts (op_put) instead of the unit
note   @ng a64-enc   payload is an encoder case list; a6_run (a64.om) writes one word per case
note   @ng a64       payload is ΩIR binary; a6_run compiles it to an AArch64 ELF on stdout (saves as STP/LDP pairs)
note   @ng a64 split the same with separate STR/LDR saves (seed/ng/a64/DESIGN.md)
note   @ng a64 macho the same as `@ng a64`, as a dynamic arm64 Mach-O for macOS (DESIGN.md s11)
note A stage lane's hook names its mode from the mode line (ng_mlb) before main reads the payload, and runs on the
note payload main read (same limit and refusals as ir-copy).
note Exit 0 on success; a refused ΩIR input exits with its IR.md s11 class and one stderr line
note "ng: refused class C at OFFSET" (offset in the payload): a payload the arena cannot hold is class 23
note at the bytes read, followed by the ng-use record; an unreadable one class 27 at the bytes read;
note unknown mode exit 2.
text ng_modes "@ng ir-copy@ng front-check@ng front-ir@ng opt@ng opt-count"
text ng_msgs "ng: refused class \n at \nng: unknown mode\n"
global ng_dig uchar 24
global ng_ml uchar 64
note refuse with class c at payload offset off
fn ng_bad c ulong off ulong to void
ng_say 0 18
ng_num c
ng_say 19 23
ng_num off
put ng_dig 0 10
k = write 2 ng_dig 0 1
note a payload or table the arena could not hold: the ng-use record follows the line
if ne get ar_fl 0 0
ar_rec 2
end
exit int c
end
note the mode line into ng_ml, one byte at a time up to its newline; its length, or 64 when there
note is no newline within 64 bytes; unreadable input is class 27 at 0
fn ng_line to ulong
for j ulong 64
k = read 0 ng_ml j 1
if lt k 0
ng_bad 27 0
end
if eq k 0
ret 64
end
if eq get ng_ml j 10
ret j
end
end
ret 64
end
fn ng_say a ulong b ulong to void
k = write 2 ng_msgs a sub b a
end
fn ng_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put ng_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 ng_dig i sub 24 i
ret
end
end
end
note the mode line (length m) is the mode text ng_modes[o, o + l)
fn ng_mode o ulong l ulong m ulong to bool
if ne m l
ret false
end
for j ulong m bound 64
if ne get ng_ml j get ng_modes add o j
ret false
end
end
ret true
end
note the mode: 0 ir-copy, 1 opt, 2 opt-count, 3 none
fn ng_kind m ulong to ulong
if ng_mode 0 11 m
ret 0
end
if ng_mode 38 7 m
ret 1
end
if ng_mode 45 13 m
ret 2
end
ret 3
end
note ng_mlb j: byte j of the mode line (stage lanes' mode hooks read it; units before this one cannot name ng_ml)
fn ng_mlb j ulong to ulong
ret ulong get ng_ml j
end
note front-check: the payload is already region 0 of the arena (ng_rd), as omc reads its input; a payload the
note arena cannot hold is error 14 at line 0, as in omc, with the ng-use record (fe_fail)
fn ng_front to int
r = ng_rd
if eq r 2
fe_fail 14
end
ret fe_check get ar_inl 0
end
note front-ir: as front-check; front.om's end of input then lowers the unit and writes it (fe_lout)
fn ng_fir to int
put f_lmode 0 1
ret ng_front
end
note ng_rd: the payload into region 0 of the arena (ar_rdin), then every other region its first room
note (ar_init): 0 read, 2 the arena could not hold it; a read error is class 27 at the bytes read
fn ng_rd to ulong
r = ar_rdin 0
if eq r 1
ng_bad 27 get ar_inl 0
end
if eq r 0
ar_init
end
ret r
end
fn main to int
m = ng_line
if ng_mode 11 15 m
ret ng_front
end
if ng_mode 26 12 m
ret ng_fir
end
a = a6_mode m
md = ng_kind m
if and eq md 3 eq a 255
ng_say 24 41
ret 2
end
if eq ng_rd 2
ng_bad 23 get ar_inl 0
end
n = get ar_inl 0
if ne a 255
a6_run a n
end
r = ir_read 0 n
if ne r 0
ng_bad r ir_badat
end
if gt md 0
op_run
end
if eq md 2
ret op_put
end
w = ir_wr
if eq ar_out 1 1 0 w 0
ret 27
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/src/main.om: fn main of the ng compiler, last unit of seed/ng/ng.units. Owner: ng-ir lane
note (stage lanes add their modes beside their code). The first input line selects the mode; it is
note read apart, so the payload after its newline is region 0 of the arena (src/ir.om ar_rdin) from
note offset 0, as large as the arena holds (no-caps 2026-11-11).
note   @ng ir-copy   payload is ΩIR binary: read it with ir_read, write it back with ir_wr (stdout)
note   @ng front-check   payload is an Omega unit: front.om checks it (fe_check) and refuses exactly as omc
note                 (same stderr line and exit code; 64 for a unit ng does not take); nothing on stdout. A
note                 payload the arena cannot hold is error 14 at line 0, as in omc, with the ng-use record;
note                 an unreadable payload is class 27 below (omc: error 1)
note   @ng front-ir  payload is an Omega unit: checked as front-check (same refusals), then lowered to ΩIR
note                 (fe_lout, seed/ng/IR.md s13) and written with ir_wr (stdout); 64 for a unit or a
note                 construct the lowering does not take
note   @ng opt       payload is ΩIR binary: read it, optimize it (op_run, opt.om: preheaders, LICM, ROT), write it
note   @ng opt-count the same passes; one stdout line of counts (op_put) instead of the unit
note   @ng a64-enc   payload is an encoder case list; a6_run (a64.om) writes one word per case
note   @ng a64       payload is ΩIR binary; a6_run compiles it to an AArch64 ELF on stdout (saves as STP/LDP pairs)
note   @ng a64 split the same with separate STR/LDR saves (seed/ng/a64/DESIGN.md)
note   @ng a64 macho the same as `@ng a64`, as a dynamic arm64 Mach-O for macOS (DESIGN.md s11)
note   @ng egraph    payload is ΩIR binary: run equality-saturation optimizer (ir_egraph.om, SM121 default,
note                 or `@ng egraph x925` / `@ng egraph sm121`) and write binary EGP3 proof bundle to stdout
note   @ng verify    payload is EGP3 binary proof bundle: standalone zero-shared-code egp3_checker.om
note                 (vc3_verify) verifies all certs fail-closed; prints NG-VERIFY PASS on stdout or exits nonzero
note   @ng pack      payload is ΩIR binary: validate via ir_read, derive physical silicon contract, pack into
note                 content-addressed OMPK v1 binary package (sem_pack.om + sha256.om) on stdout
note   @ng realize   payload is OMPK v1 binary package (optional target: `x925`, `sm121`, `x64`, `rv64`):
note                 fail-closed OMPK verify -> embedded ΩIR read -> TargetDesc contract (bit 0) ->
note                 ir_egraph + egp3_checker dual-verify (bit 1) -> ISel + SM121 Antibody #13-15 (bit 2) ->
note                 proofMask==7 Realization Cache admission + atomic fabHotSwap; prints NG-REALIZE PASS
note A stage lane's hook names its mode from the mode line (ng_mlb) before main reads the payload, and runs on the
note payload main read (same limit and refusals as ir-copy).
note Exit 0 on success; a refused ΩIR input exits with its IR.md s11 class and one stderr line
note "ng: refused class C at OFFSET" (offset in the payload): a payload the arena cannot hold is class 23
note at the bytes read, followed by the ng-use record; an unreadable one class 27 at the bytes read;
note unknown mode exit 2.
text ng_modes "@ng ir-copy@ng front-check@ng front-ir@ng opt@ng opt-count"
text ng_msgs "ng: refused class \n at \nng: unknown mode\n"
global ng_dig uchar 24
global ng_ml uchar 64
text ng_m_eg "@ng egraph"
text ng_m_egx "@ng egraph x925"
text ng_m_egs "@ng egraph sm121"
text ng_m_ver "@ng verify"
text ng_m_pak "@ng pack"
text ng_m_rlz "@ng realize"
text ng_m_rlx "@ng realize x925"
text ng_m_rls "@ng realize sm121"
text ng_m_rl6 "@ng realize x64"
text ng_m_rlr "@ng realize rv64"
text ng_s_vp1 "NG-VERIFY PASS certs="
text ng_s_vp2 " steps="
text ng_s_vp3 " evals="
text ng_s_rp1 "NG-REALIZE PASS tid="
text ng_s_rp2 " slot="
text ng_s_rp3 " cache_key="
text ng_s_rp4 " code_ptr="
text ng_s_rp5 " proof_mask="
text ng_s_rp6 " egp3_certs="
text ng_s_rp7 " fab_ver="
text ng_s_nl "\n"
text ng_e_ver "ng: egp3 refused code="
text ng_e_pak "ng: pack refused code="
text ng_e_rlz "ng: realize refused code="
text ng_e_rir "ng: realize refused ir class="
text ng_e_rco "ng: realize refused contract="
text ng_e_reg "ng: realize refused egp3="
note refuse with class c at payload offset off
fn ng_bad c ulong off ulong to void
ng_say 0 18
ng_num c
ng_say 19 23
ng_num off
put ng_dig 0 10
k = write 2 ng_dig 0 1
note a payload or table the arena could not hold: the ng-use record follows the line
if ne get ar_fl 0 0
ar_rec 2
end
exit int c
end
note the mode line into ng_ml, one byte at a time up to its newline; its length, or 64 when there
note is no newline within 64 bytes; unreadable input is class 27 at 0
fn ng_line to ulong
for j ulong 64
k = read 0 ng_ml j 1
if lt k 0
ng_bad 27 0
end
if eq k 0
ret 64
end
if eq get ng_ml j 10
ret j
end
end
ret 64
end
fn ng_say a ulong b ulong to void
k = write 2 ng_msgs a sub b a
end
fn ng_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put ng_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 2 ng_dig i sub 24 i
ret
end
end
end
note the mode line (length m) is the mode text ng_modes[o, o + l)
fn ng_mode o ulong l ulong m ulong to bool
if ne m l
ret false
end
for j ulong m bound 64
if ne get ng_ml j get ng_modes add o j
ret false
end
end
ret true
end
note the mode: 0 ir-copy, 1 opt, 2 opt-count, 3 none
fn ng_kind m ulong to ulong
if ng_mode 0 11 m
ret 0
end
if ng_mode 38 7 m
ret 1
end
if ng_mode 45 13 m
ret 2
end
ret 3
end
note ng_mlb j: byte j of the mode line (stage lanes' mode hooks read it; units before this one cannot name ng_ml)
fn ng_mlb j ulong to ulong
ret ulong get ng_ml j
end
note front-check: the payload is already region 0 of the arena (ng_rd), as omc reads its input; a payload the
note arena cannot hold is error 14 at line 0, as in omc, with the ng-use record (fe_fail)
fn ng_front to int
r = ng_rd
if eq r 2
fe_fail 14
end
ret fe_check get ar_inl 0
end
note front-ir: as front-check; front.om's end of input then lowers the unit and writes it (fe_lout)
fn ng_fir to int
put f_lmode 0 1
ret ng_front
end
note ng_rd: the payload into region 0 of the arena (ar_rdin), then every other region its first room
note (ar_init): 0 read, 2 the arena could not hold it; a read error is class 27 at the bytes read
fn ng_rd to ulong
r = ar_rdin 0
if eq r 1
ng_bad 27 get ar_inl 0
end
if eq r 0
ar_init
end
ret r
end
note ---- Beyond-C modes: @ng egraph, @ng verify, @ng pack, @ng realize ----
fn ng_meq s view uchar * m ulong to bool
if ne m len s
ret false
end
for j ulong m bound 64
if ne get ng_ml j get s j
ret false
end
end
ret true
end
note Extended mode id: 0 none, 10 egraph (sm121), 11 egraph x925, 12 egraph sm121,
note 13 verify, 14 pack, 15 realize (auto), 16 realize x925, 17 realize sm121,
note 18 realize x64, 19 realize rv64
fn ng_xkind m ulong to ulong
if ng_meq ng_m_eg m
ret 10
end
if ng_meq ng_m_egx m
ret 11
end
if ng_meq ng_m_egs m
ret 12
end
if ng_meq ng_m_ver m
ret 13
end
if ng_meq ng_m_pak m
ret 14
end
if ng_meq ng_m_rlz m
ret 15
end
if ng_meq ng_m_rlx m
ret 16
end
if ng_meq ng_m_rls m
ret 17
end
if ng_meq ng_m_rl6 m
ret 18
end
if ng_meq ng_m_rlr m
ret 19
end
ret 0
end
fn ng_w1s s view uchar * to void
k = write 1 s 0 len s
end
fn ng_w2s s view uchar * to void
k = write 2 s 0 len s
end
fn ng_w1n v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put ng_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
k = write 1 ng_dig i sub 24 i
ret
end
end
end
fn ng_e2n s view uchar * c ulong to void
ng_w2s s
ng_num c
ng_w2s ng_s_nl
end
fn ng_wr_egp3 to bool
n = get eg3_bpos 0
o = ulong 0
while lt o n bound 131072
k = write 1 eg3_buf o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
fn ng_wr_pk to bool
n = get pk_len 0
o = ulong 0
while lt o n bound 8192
k = write 1 pk_buf o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
fn ng_copy_in_vc3 n ulong to void
for i ulong n bound 1048576
put vc3_buf i ar_ib i
end
end
fn ng_copy_eg3_vc3 to ulong
n = get eg3_bpos 0
for i ulong n bound 131072
put vc3_buf i get eg3_buf i
end
ret n
end
fn ng_copy_in_pk n ulong to void
for i ulong n bound 8192
put pk_buf i ar_ib i
end
put pk_len 0 n
end
fn ng_egraph_all to void
eg3_cert_init
nf = get i_n 3
for fi ulong nf bound 65536
f = uint add fi 1
b = get i_fb1 f
bi = ulong 0
while ne b 0 bound 1048577
d = eg3_opt_ir_block fi bi b 0 true
b = get i_bnx b
bi = add bi 1
end
end
end
fn ng_ir_is_gpu to bool
nf = get i_n 3
for j ulong nf bound 65536
f = add j 1
if eq ulong get i_fk f 1
ret true
end
end
no = get i_n 5
for j ulong no bound 4194305
op = ulong get i_oop add j 1
if or eq op 40 eq op 41
ret true
end
if or eq op 44 eq op 45
ret true
end
if and ge op 104 le op 106
ret true
end
end
ret false
end
fn ng_ir_has_mma to bool
no = get i_n 5
for j ulong no bound 4194305
if eq ulong get i_oop add j 1 106
ret true
end
end
ret false
end
fn ng_ir_set_req to void
if ng_ir_is_gpu
rm = ulong 0
rf = ulong 0
if ng_ir_has_mma
rm = MMA_16816_BF16
rf = FEAT_HMMA16816
end
pk_set_req EXEC_SIMT_WARP 32768 64 32 rm rf
ret
end
pk_set_req EXEC_SCALAR_SIMD 0 8 0 0 0
end
fn ng_do_egraph xm ulong n ulong to int
r = ir_read 0 n
if ne r 0
ng_bad r ir_badat
end
tdInitAll
if eq xm 11
eg3_set_costs_x925
else
eg3_set_costs_sm121
end
ng_egraph_all
if not ng_wr_egp3
ret 27
end
ret 0
end
fn ng_do_verify n ulong to int
if gt n 1048576
ng_e2n ng_e_ver 1
ret 1
end
ng_copy_in_vc3 n
st = vc3_verify n
if ne st 0
ng_e2n ng_e_ver st
ret int st
end
ng_w1s ng_s_vp1
ng_w1n get vc3_stat 0
ng_w1s ng_s_vp2
ng_w1n get vc3_stat 1
ng_w1s ng_s_vp3
ng_w1n get vc3_stat 2
ng_w1s ng_s_nl
ret 0
end
fn ng_do_pack n ulong to int
r = ir_read 0 n
if ne r 0
ng_bad r ir_badat
end
if gt n PK_MAX_IR_LEN
ng_e2n ng_e_pak PK_ERR_LENGTH
ret int PK_ERR_LENGTH
end
tdInitAll
pk_reset_builder
ng_ir_set_req
for i ulong n bound 4096
rc = pk_ir_push ar_ib i
if ne rc PK_OK
ng_e2n ng_e_pak rc
ret int rc
end
end
rc = pk_pack
if ne rc PK_OK
ng_e2n ng_e_pak rc
ret int rc
end
vrc = pk_verify
if ne vrc PK_OK
ng_e2n ng_e_pak vrc
ret int vrc
end
if not ng_wr_pk
ret 27
end
ret 0
end
fn ng_pick_tid xm ulong to ulong
if eq xm 16
ret TID_X925
end
if eq xm 17
ret TID_SM121
end
if eq xm 18
ret TID_X64_AVX2
end
if eq xm 19
ret TID_RV64_RVV
end
re = pk_get_u64 72
if eq re EXEC_SIMT_WARP
ret TID_SM121
end
if eq re EXEC_SYSTOLIC
ret TID_ETHOSU55
end
ret TID_X925
end
fn ng_realize_proofs tid ulong to ulong
pm = ulong AS_PROOF_CONTRACT
eg3_set_target_costs tdGet tid TDF_EXEC tdGet tid TDF_MULLAT tdGet tid TDF_DIVLAT tdGet tid TDF_FEAT
ng_egraph_all
nb = ng_copy_eg3_vc3
vst = vc3_verify nb
if ne vst 0
ng_e2n ng_e_reg vst
ret pm
end
pm = or pm AS_PROOF_EGP3
if eq tdGet tid TDF_ISA ISA_SM121
if isCompileTestFn tid
if as_verify_antibodies
pm = or pm AS_PROOF_ANTIBODY
end
end
else
if isCompileTestFn tid
if gt get isLen 0 0
pm = or pm AS_PROOF_ANTIBODY
end
end
end
ret pm
end
fn ng_realize_swap tid ulong pm ulong to bool
key = get pk_real_out 3
cptr = get pk_real_out 4
mode = FAB_MODE_CPU_NATIVE
kind = AS_KIND_CRYSTALLIZE
if eq tdGet tid TDF_EXEC EXEC_SIMT_WARP
mode = FAB_MODE_GPU_NATIVE
kind = AS_KIND_GPU_GEMM
end
if not as_register_baseline 0 key 4096 tid FAB_MODE_NEURAL kind
ret false
end
ret fabHotSwap 0 key cptr tid mode pm
end
fn ng_do_realize xm ulong n ulong to int
if or lt n PK_HDR_LEN gt n PK_BUF_CAP
ng_e2n ng_e_rlz PK_ERR_LENGTH
ret int PK_ERR_LENGTH
end
tdInitAll
isInitRules
tdCacheInit
fabInit
crInit
as_init
pk_reset_all
ng_copy_in_pk n
vrc = pk_verify
if ne vrc PK_OK
ng_e2n ng_e_rlz vrc
ret int vrc
end
tid = ng_pick_tid xm
if ge tid get tdCount 0
ng_e2n ng_e_rlz PK_ERR_BAD_TARGET
ret int PK_ERR_BAD_TARGET
end
ic = pk_get_u32 120
irl = pk_get_u32 124
irOff = add PK_HDR_LEN mul ic PK_DIGEST_LEN
irrc = ir_read irOff add irOff irl
if ne irrc 0
ng_e2n ng_e_rir irrc
ret int irrc
end
feat = tdGet tid TDF_FEAT
crc = pk_check_contract tid feat
if ne crc TDK_OK
ng_e2n ng_e_rco crc
ret int crc
end
pm = ng_realize_proofs tid
rrc = pk_realize_on_arrive tid feat 1 pm
if ne rrc PK_OK
ng_e2n ng_e_rlz rrc
ret int rrc
end
if not ng_realize_swap tid pm
ng_e2n ng_e_rlz AS_ERR_SWAP_FAIL
ret int AS_ERR_SWAP_FAIL
end
ng_w1s ng_s_rp1
ng_w1n tid
ng_w1s ng_s_rp2
ng_w1n get pk_real_out 1
ng_w1s ng_s_rp3
ng_w1n get pk_real_out 3
ng_w1s ng_s_rp4
ng_w1n get pk_real_out 4
ng_w1s ng_s_rp5
ng_w1n pm
ng_w1s ng_s_rp6
ng_w1n get vc3_stat 0
ng_w1s ng_s_rp7
ng_w1n get fabVer 0
ng_w1s ng_s_nl
ret 0
end
fn ng_xrun xm ulong n ulong to int
if le xm 12
ret ng_do_egraph xm n
end
if eq xm 13
ret ng_do_verify n
end
if eq xm 14
ret ng_do_pack n
end
ret ng_do_realize xm n
end
fn main to int
m = ng_line
if ng_mode 11 15 m
ret ng_front
end
if ng_mode 26 12 m
ret ng_fir
end
a = a6_mode m
md = ng_kind m
xm = ng_xkind m
if and eq md 3 and eq a 255 eq xm 0
ng_say 24 41
ret 2
end
if eq ng_rd 2
ng_bad 23 get ar_inl 0
end
n = get ar_inl 0
if ne a 255
a6_run a n
end
if ne xm 0
ret ng_xrun xm n
end
r = ir_read 0 n
if ne r 0
ng_bad r ir_badat
end
if gt md 0
op_run
end
if eq md 2
ret op_put
end
w = ir_wr
if eq ar_out 1 1 0 w 0
ret 27
end
ret 0
end

if or eq t 1 or eq t 2 or eq t 6 or eq t 18 eq t 19
ret 1
end
if or eq t 3 or eq t 7 or eq t 16 eq t 17
ret 2
end
if or eq t 4 or eq t 8 eq t 13
ret 4
end
if or eq t 5 or eq t 9 eq t 14
ret 8
end
ret 0
end
if ge ulong t add get i_n 0 32
ret 0
end
k = get i_tk t
if eq k 1
ret mul ulong get i_t2 t ir_tsize get i_t1 t
end
if eq k 2
ret mul ulong get i_t2 t ir_tsize get i_t1 t
end
if eq k 3
ret ulong get i_t1 t
end
ret 0
end
note ---- binary writer (IR.md s3-s7) ----------------------------------------------------------
note ir_wn: the k (at most 8) low bytes of v at the output's end (region 1 asked for them first). The output is
note written from byte 0 in order, so the first byte of each word sets the word and the others are ORed in (inline)
fn ir_wn v ulong k ulong to void

ir_wn ulong get i_t2 t 4
ret
end
if eq k 3
ir_wn ulong get i_t1 t 4
nf = ulong get i_t2 t
ir_wn nf 4
f0 = ulong get i_t3 t
for j ulong nf bound 64
ir_wty_sem get i_xty add f0 j add d 1
ir_wn ulong get i_xof add f0 j 4
ir_wn ulong get i_xor add f0 j 1
end
ret
end
if or eq k 4 eq k 5
ir_wty_sem get i_t1 t add d 1
ir_wn ulong get i_t2 t 1
ir_wn ulong get i_t3 t 1
ret
end

ir_wn ulong get i_gcl g 1
if eq get i_gcl g 1
s = ir_tsize get i_gty g
d = get i_gd0 g
p = get i_on 0
for j ulong s bound 16777216
put i_out add p j get i_gdat add d j
end
put i_on 0 add p s

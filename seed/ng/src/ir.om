end
put i_n 9 ver
q = get i_rd 0
for j ulong 14
b = ir_rn 1
if eq ver 10
if ne b ulong get i_tag2 j
ir_bad 11 q
end
else
if ne b ulong get i_tag j
ir_bad 11 q
end
end
end
if ne ir_rn 2 0

end
if eq k 3
ir_wn ulong get i_t1 t 4
ir_wn ulong get i_t2 t 4
f0 = ulong get i_t3 t
for j ulong ulong get i_t2 t bound 64
ir_wn ulong get i_xty add f0 j 4
ir_wn ulong get i_xof add f0 j 4
ir_wn ulong get i_xor add f0 j 1
end
ret

put i_tq 1 a
put i_tq 2 b
put i_tq 3 c
put i_tq 4 d
put i_tq 5 e
for i ulong get i_n 0 bound 65536
t = add i 32
if ir_tmat t
ret uint t
end
end
ret 0
end
fn ir_tmat t ulong to bool

z = ar_need 29 63
z = ar_need 30 63
for g ulong 31
put ar_gp g 0
end
put ar_gp 0 get ar_inl 0
end
global i_on ulong 1
note reader state: 0 cursor, 1 end, 2 refusal class (0 none), 3 refusal offset, 4 value base,
note 5 block base, 6 function value count
global i_rd ulong 8
note ---- row table ----------------------------------------------------------------------------
fn ir_rskip to void
while lt get i_rp 0 len i_rows bound 1000000
c = get i_rows get i_rp 0
if and ne c 32 ne c 10
ret
end
put i_rp 0 add get i_rp 0 1
end
end
fn ir_rnum to ulong
ir_rskip
v = ulong 0
while lt get i_rp 0 len i_rows bound 32
c = get i_rows get i_rp 0
if or lt c 48 gt c 57
ret v
end
v = add mul v 10 ulong sub c 48
put i_rp 0 add get i_rp 0 1
end
ret v
end
fn ir_rinit to void
if ne get i_n 15 0
ret
end
put i_n 15 1
put i_rp 0 0
while lt get i_rp 0 len i_rows bound 256
o = ir_rnum
ir_rskip
s = get i_rp 0
put i_rno o uint s
while ne get i_rows get i_rp 0 32 bound 64
put i_rp 0 add get i_rp 0 1
end
put i_rnl o uchar sub get i_rp 0 s
put i_rtk o uchar ir_rnum
put i_rim o uchar ir_rnum
put i_rfx o uchar ir_rnum
put i_rvr o uchar ir_rnum
put i_rty o uchar ir_rnum
put i_rok o 1
ir_rskip
end
end
note 1 when op o carries a token operand (E, R, and T except br)
fn ir_htok op uint to uint
k = get i_rtk op
if or eq k 1 eq k 2
ret 1
end
if and eq k 3 ne op 60
ret 1
end
ret 0
end
note operand kind of slot k of op: 0 value, 1 block, 2 function
fn ir_okd op uint k ulong to uint
if eq op 60
if eq k 0
ret 1
end
end
if eq op 61
if ge k 2
ret 1
end
end
if or eq op 64 eq op 67
if eq k 1
ret 2
end
end
ret 0
end
note ---- builder ------------------------------------------------------------------------------
note The builder's tables are those of IR.md s12 for a whole module (65536 types, struct fields and functions,
note 1048576 blocks, 4194304 ops, 16777216 operand slots, 8388608 values); the reader refuses a count past
note s12 before building. A builder (front-ir, ngrand, the oracles) asked for more ends with ir_lim: one stderr
note line and exit 23 (LIMIT), never an index past a table. Globals and their data are in the arena (ir_glob).
text i_limm "ng: refused class 23 (IR.md s12 table full while building)\n"
fn ir_lim to void
w = write 2 i_limm 0 len i_limm
exit 23
end
fn ir_init to void
ir_rinit
for i ulong 15
put i_n i 0
end
put i_n 9 9
put i_on 0 0
end
fn ir_ver to ulong
ret get i_n 9
end
fn ir_set_ver v ulong to void
put i_n 9 v
end
note Validate canonical v2 function contract fields (IR.md s16)
fn ir_fc_ok pur ulong prc ulong hd ulong rsv ulong err ulong dl ulong to bool
if or gt pur 1 gt prc 2
ret false
end
if or gt hd 1 ne rsv 0
ret false
end
if and ne prc 2 ne err 0
ret false
end
if and eq hd 1 eq dl 0
ret false
end
ret true
end
note Set v2 per-function contract metadata on function handle f (auto-upgrades module to v2 when nonzero)
fn ir_fset_mode f uint pur ulong prc ulong hd ulong to void
put i_fpur f uchar pur
put i_fprc f uchar prc
put i_fhd f uchar hd
if or or ne pur 0 ne prc 0 ne hd 0
put i_n 9 10
end
end
fn ir_fset_phys f uint err ulong dl ulong pwr ulong to void
put i_ferr f err
put i_fdl f dl
put i_fpwr f pwr
if or or ne err 0 ne dl 0 ne pwr 0
put i_n 9 10
end
end
fn ir_newv t uint k uint o uint to uint
n = add get i_n 6 1
if gt n 8388608
ir_lim
end
put i_n 6 n
put i_vty n t
put i_vk n uchar k
put i_vo n o
put i_vnx n 0
put i_vno n 0
ret uint n
end
note a type id equal to (k a b c d e) among table types, else 0 (structs compare their fields)
fn ir_tfind k uint a uint b uint c uint d uint e uint to uint
put i_tq 0 k
put i_tq 1 a
put i_tq 2 b
put i_tq 3 c
put i_tq 4 d
put i_tq 5 e
for i ulong get i_n 0 bound 65536
t = add i 32
if ir_tmat t
ret uint t
end
end
ret 0
end
fn ir_tmat t ulong to bool
if ne uint get i_tk t get i_tq 0
ret false
end
if ne get i_t1 t get i_tq 1
ret false
end
if ne get i_t2 t get i_tq 2
ret false
end
if ne get i_t3 t get i_tq 3
ret false
end
if ne get i_t4 t get i_tq 4
ret false
end
ret eq get i_t5 t get i_tq 5
end
fn ir_tadd k uint a uint b uint c uint d uint e uint to uint
t = add get i_n 0 32
if ge get i_n 0 65536
ir_lim
end
put i_n 0 add get i_n 0 1
put i_tk t uchar k
put i_t1 t a
put i_t2 t b
put i_t3 t c
put i_t4 t d
put i_t5 t e
ret uint t
end
fn ir_tget k uint a uint b uint c uint d uint e uint to uint
t = ir_tfind k a b c d e
if ne t 0
ret t
end
ret ir_tadd k a b c d e
end
fn ir_tvec e uint l uint to uint
ret ir_tget 1 e l 0 0 0
end
fn ir_tarr e uint c uint to uint
ret ir_tget 2 e c 0 0 0
end
fn ir_tref t uint a uint s uint to uint
ret ir_tget 4 t a s 0 0
end
fn ir_tslc e uint a uint s uint to uint
ret ir_tget 5 e a s 0 0
end
fn ir_tfrg r uint m uint n uint k uint e uint to uint
ret ir_tget 6 r m n k e
end
fn ir_tsb size uint to void
put i_sp 0 ulong size
put i_sp 1 get i_n 1
end
fn ir_tsf t uint off uint ord uint to void
x = get i_n 1
if ge x 65536
ir_lim
end
put i_xty x t
put i_xof x off
put i_xor x uchar ord
put i_n 1 add x 1
end
note the struct with the same size and fields as fields [f0, f0+nf) among table types, else 0
fn ir_sfind size uint f0 ulong nf ulong to uint
for i ulong get i_n 0 bound 65536
t = add i 32
if ir_smat t size nf
if ir_seq ulong get i_t3 t f0 nf
ret uint t
end
end
end
ret 0
end
fn ir_smat t ulong size uint nf ulong to bool
if ne get i_tk t 3
ret false
end
if ne get i_t1 t size
ret false
end
ret eq ulong get i_t2 t nf
end
fn ir_seq a ulong b ulong n ulong to bool
for j ulong n bound 64
x = add a j
y = add b j
if ne get i_xty x get i_xty y
ret false
end
if ne get i_xof x get i_xof y
ret false
end
if ne get i_xor x get i_xor y
ret false
end
end
ret true
end
fn ir_tse to uint
f0 = get i_sp 1
nf = sub get i_n 1 f0
size = uint get i_sp 0
t = ir_sfind size f0 nf
if ne t 0
put i_n 1 f0
ret t
end
ret ir_tadd 3 size uint nf uint f0 0 0
end
note ir_glob / ir_gbyt: a new global and its data bytes, in the arena (groups irglob and gdat); a full
note arena ends the build (ar_die), and the reader asks for the room first so that it refuses with LIMIT
fn ir_glob t uint cls uint to uint
g = add get i_n 2 1
if ne ar_need 24 g 0
ar_die
end
put i_n 2 g
ar_pu 87 g t
ar_pc 88 g uchar cls
put ar_m add get ar_rb 89 g get i_n 8
ret uint g
end
fn ir_gbyt g uint b uint to void
x = get i_n 8
if ne ar_need 2 x 0
ar_die
end
ar_bp 2 x uchar b
put i_n 8 add x 1
end
fn ir_fnew kind uint flags uint res uint to uint
f = add get i_n 3 1
if gt f 65536
ir_lim
end
put i_n 3 f
fu = uint f
put i_fk f uchar kind
put i_ffl f uchar flags
put i_frs f res
put i_fnp f 0
put i_fp1 f 0
put i_fpt f 0
put i_fb1 f 0
put i_fbt f 0
put i_fnb f 0
put i_ftx f 0
put i_fty f 0
put i_ftz f 0
put i_fsg f 0
put i_fpur f 0
put i_fprc f 0
put i_fhd f 0
put i_ferr f 0
put i_fdl f 0
put i_fpwr f 0
put i_ftk f ir_newv 20 0 fu
ret fu
end
fn ir_fpar f uint t uint to uint
v = ir_newv t 1 f
if eq get i_fp1 f 0
put i_fp1 f v
else
put i_vnx get i_fpt f v
end
put i_fpt f v
put i_fnp f add get i_fnp f 1
ret v
end
fn ir_fker f uint x uint y uint z uint sg uint to void
put i_ftx f x
put i_fty f y
put i_ftz f z
put i_fsg f uchar sg
end
fn ir_ftok f uint to uint
ret get i_ftk f
end
fn ir_bpar b uint t uint to uint
v = ir_newv t 2 b
if eq get i_bp1 b 0
put i_bp1 b v
else
put i_vnx get i_bpt b v
end
put i_bpt b v
put i_bnp b add get i_bnp b 1
ret v
end
fn ir_blk f uint to uint
b = add get i_n 4 1
if gt b 1048576
ir_lim
end
put i_n 4 b
bu = uint b
put i_bf b f
put i_bnx b 0
put i_bp1 b 0
put i_bpt b 0
put i_bnp b 0
put i_bo1 b 0
put i_bot b 0
put i_bno b 0
put i_bix b 0
if eq get i_fb1 f 0
put i_fb1 f bu
else
put i_bnx get i_fbt f bu
end
put i_fbt f bu
put i_fnb f add get i_fnb f 1
if gt get i_fnb f 1
t = ir_bpar bu 20
end
ret bu
end
fn ir_btok b uint to uint
ret get i_bp1 b
end
fn ir_odefs o uint to void
op = uint get i_oop o
t = get i_oty o
put i_otk o 0
put i_ors o 0
if eq get i_rtk op 1
put i_otk o ir_newv 20 3 o
end
c = get i_rty op
if and ne t 0 or eq c 1 eq c 2
put i_ors o ir_newv t 4 o
end
end
fn ir_op b uint op uint ty uint imm ulong n uint to uint
o = add get i_n 5 1
if or gt o 4194304 gt add get i_n 7 ulong n 16777216
ir_lim
end
put i_n 5 o
ou = uint o
put i_oop o uchar op
put i_oty o ty
put i_oim o imm
put i_ona o n
a = get i_n 7
put i_oa0 o uint a
for j ulong ulong n bound 1024
put i_arg add a j 0
end
put i_n 7 add a ulong n
put i_ob o b
put i_onx o 0
put i_oof o 0
if eq get i_bo1 b 0
put i_bo1 b ou
else
put i_onx get i_bot b ou
end
put i_bot b ou
put i_bno b add get i_bno b 1
ir_odefs ou
ret ou
end
fn ir_set o uint k uint h uint to void
put i_arg add ulong get i_oa0 o ulong k h
end
fn ir_arg o uint k uint to uint
ret get i_arg add ulong get i_oa0 o ulong k

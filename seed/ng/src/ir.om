fn ir_wr to ulong
put i_on 0 0
for j ulong 6
ir_wn ulong get i_magic j 1
end
ir_wn 0 1
ir_wn 9 1
for j ulong 14
ir_wn ulong get i_tag j 1
end
ir_wn 0 2
ir_wn get i_n 0 4
for i ulong get i_n 0 bound 65536
ir_wty add i 32
end
ir_wn get i_n 2 4
for i ulong get i_n 2 bound 65536
ir_wglb add i 1
end
ir_wn get i_n 3 4
for i ulong get i_n 3 bound 65536
ir_wfn uint add i 1
end
ret get i_on 0
end

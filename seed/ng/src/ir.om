ir_wn ulong get i_ffl f 1
ir_wn ulong get i_fnp f 4
v = get i_fp1 f
while ne v 0 bound 65
ir_wty_sem get i_vty v 0
v = get i_vnx v
end
ir_wty_sem get i_frs f 0
if eq get i_fk f 1
ir_wn ulong get i_ftx f 4
ir_wn ulong get i_fty f 4
ir_wn ulong get i_ftz f 4
ir_wn ulong get i_fsg f 1
end
ir_wn ulong get i_fpur f 1
ir_wn ulong get i_fprc f 1
ir_wn ulong get i_fhd f 1
ir_wn 0 1
ir_wn get i_ferr f 8
ir_wn get i_fdl f 8
ir_wn get i_fpwr f 8
ir_wn ulong get i_fnb f 4
b = get i_fb1 f
while ne b 0 bound 1048577

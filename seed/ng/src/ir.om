put i_vno get i_ftk f n
n = add n 1
v = get i_fp1 f
while ne v 0 bound 65
put i_vno v n
n = add n 1
v = get i_vnx v
end
b = get i_fb1 f
x = uint 0
while ne b 0 bound 1048577
put i_bix b x
x = add x 1
n = ir_numb b n
b = get i_bnx b
end
ret n
end
fn ir_numb b uint n0 uint to uint
n = n0
v = get i_bp1 b
while ne v 0 bound 65
put i_vno v n
n = add n 1
v = get i_vnx v
end
o = get i_bo1 b
while ne o 0 bound 4194305
if ne get i_otk o 0
put i_vno get i_otk o n
n = add n 1
end
if ne get i_ors o 0
put i_vno get i_ors o n
n = add n 1
end
o = get i_onx o
end
ret n
end
note bytes of one element or object of type t (0 for void, tok and invalid ids)
fn ir_tsize t uint to ulong

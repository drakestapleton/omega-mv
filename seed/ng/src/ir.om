ir_wn ulong get i_t2 t 2
ir_wn ulong get i_t3 t 2
ir_wn ulong get i_t4 t 2
ir_wty_sem get i_t5 t add d 1
end
fn ir_wgdat_sem g ulong to void
if or eq g 0 gt g get i_n 2
ret

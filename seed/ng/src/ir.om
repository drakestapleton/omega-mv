na = ulong get i_ona o
if eq get i_rvr op 1
ir_wn sub sub na ulong get i_rfx op ulong ir_htok op 4
end
a0 = ulong get i_oa0 o
for k ulong na bound 1024
h = get i_arg add a0 k
d = ir_okd op k
if eq d 0

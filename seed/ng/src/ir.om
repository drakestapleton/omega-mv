note wire value ids (IR.md s6.2) into i_vno and block positions into i_bix; returns the value count
fn ir_num f uint to uint
n = uint 0
put i_vno get i_ftk f n
n = add n 1
v = get i_fp1 f
while ne v 0 bound 65
put i_vno v n
n = add n 1
v = get i_vnx v
end
b = get i_fb1 f
x = uint 0
while ne b 0 bound 1048577
put i_bix b x
x = add x 1
n = ir_numb b n
b = get i_bnx b
end
ret n
end
fn ir_numb b uint n0 uint to uint
n = n0
v = get i_bp1 b
while ne v 0 bound 65
put i_vno v n
n = add n 1
v = get i_vnx v
end
o = get i_bo1 b
while ne o 0 bound 4194305
if ne get i_otk o 0
put i_vno get i_otk o n
n = add n 1
end
if ne get i_ors o 0
put i_vno get i_ors o n
n = add n 1
end
o = get i_onx o
end
ret n
end
note bytes of one element or object of type t (0 for void, tok and invalid ids)
fn ir_tsize t uint to ulong
if lt t 32
if or eq t 1 or eq t 2 or eq t 6 or eq t 18 eq t 19
ret 1
end
if or eq t 3 or eq t 7 or eq t 16 eq t 17
ret 2
end
if or eq t 4 or eq t 8 eq t 13
ret 4
end
if or eq t 5 or eq t 9 eq t 14
ret 8
end
ret 0
end
if ge ulong t add get i_n 0 32
ret 0
end
k = get i_tk t
if eq k 1
ret mul ulong get i_t2 t ir_tsize get i_t1 t
end
if eq k 2
ret mul ulong get i_t2 t ir_tsize get i_t1 t
end
if eq k 3
ret ulong get i_t1 t
end
ret 0
end
note ---- binary writer (IR.md s3-s7) ----------------------------------------------------------
fn ir_wn v ulong k ulong to void
p = get i_on 0
for j ulong k bound 8
put i_out add p j uchar and shr v mul j 8 255
end
put i_on 0 add p k
end
fn ir_wty t ulong to void
k = ulong get i_tk t
ir_wn k 1
if eq k 6
ir_wn ulong get i_t1 t 1
ir_wn ulong get i_t2 t 2
ir_wn ulong get i_t3 t 2
ir_wn ulong get i_t4 t 2
ir_wn ulong get i_t5 t 4
ret
end
if eq k 3
ir_wn ulong get i_t1 t 4
ir_wn ulong get i_t2 t 4
f0 = ulong get i_t3 t
for j ulong ulong get i_t2 t bound 64
ir_wn ulong get i_xty add f0 j 4
ir_wn ulong get i_xof add f0 j 4
ir_wn ulong get i_xor add f0 j 1
end
ret
end
ir_wn ulong get i_t1 t 4
if or eq k 1 eq k 2
ir_wn ulong get i_t2 t 4
ret
end
ir_wn ulong get i_t2 t 1
ir_wn ulong get i_t3 t 1
end
fn ir_wglb g ulong to void

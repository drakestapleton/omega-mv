global i_bno uint 1048577
global i_bix uint 1048577
global i_oop uchar 4194305
global i_oty uint 4194305
global i_oim ulong 4194305
global i_ona uint 4194305
global i_oa0 uint 4194305
global i_ob uint 4194305

note lcall: call of function f (index + 1 = its ΩIR handle); the arguments are read first
fn fe_lcall f ulong to void
if eq f 0
fe_lno
end
j = sub f 1
np = ulong uchar get ar_m add get ar_rb 22 j
bs = get f_lcp 0
fe_need 23 add bs np
put f_lcp 0 add bs np
for p ulong np bound 6
q = add mul j 6 p
if eq ar_c 35 q 0
fe_lx ulong uchar get ar_m add get ar_rb 33 q
ar_pu 86 add bs p get f_lrv 0
else
ar_pu 86 add bs p fe_larg q
end
end
rt = ulong uchar get ar_m add get ar_rb 21 j
o = fe_lop 64 fe_lty rt 0 uint add np 2
ir_set o 1 uint f
for p ulong np bound 6
ir_set o uint add p 2 ar_u 86 add bs p
end
put f_lcp 0 bs
fe_lval ir_res o rt
end


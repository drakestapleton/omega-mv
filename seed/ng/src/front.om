ft = ulong get f_sftype j
fl = ulong get f_sf_len j
off = ulong get f_sf_off j
fe_force get f_svk i get f_svv i get f_svt i tmp
if eq fl 0
fe_st_store base idx off ft tmp
else
k = ulong 0
while lt k fl
fe_st_store base idx add off k ft tmp
k = add k 1
end
end
end

note st_write: store each field value. An array field is filled with its one value.
fn fe_st_write base ulong tmp ulong idx ulong si ulong to void
fo = ulong get f_stfoff si
nfd = ulong get f_st_nf si
i = ulong 0
while lt i nfd
fe_st_write1 base tmp idx add fo i i
i = add i 1
end
end

note sa_st: p = new S v1 .. vn. Stack slot of the cell count, 16-byte aligned, outermost block only.

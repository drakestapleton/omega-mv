k = get f_tk 0
if eq k 1
if ne get f_om2 0 0
if le get f_tl 0 8
if eq fe_kw get f_tw 0 182
ar_pc 25 f 1
fe_eol
put ar_m add get ar_rb 26 f get f_cur 0
put ar_m add get ar_rb 27 f get f_line 0

note ltxb: decode the text bytes [p0, e) (escapes as fe_s_text), appended to global g when g is not 0; count.
note Each pass takes at least one input byte, and the input is in the arena (at most 134217728 bytes).
fn fe_ltxb p0 ulong e ulong g uint to ulong
p = p0
n = ulong 0
while lt p e bound 134217729
b = ar_ib p
p = add p 1
if eq b 92
b = ar_ib p
p = add p 1
if eq b 110
b = uchar 10
end
if eq b 116
b = uchar 9
end
end
if ne g 0
ir_gbyt g uint b
end
n = add n 1
end
ret n
end


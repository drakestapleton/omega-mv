note nfail: a bad number (diag expect=number); unkfail: an undeclared function or struct (sev=unknown)
fn fe_nfail code ulong to void
put f_dexp 0 4
fe_fail code
end

fn fe_unkfail code ulong to void
put f_dsev 0 2
put f_dexp 0 3
fe_fail code
end

note lineis: the n bytes at q are the packed word w and the line ends right after them
fn fe_lineis q ulong w ulong n ulong to ulong
e = get f_inlen 0
if gt add q n e
ret 0
end
i = ulong 0
x = w
while lt i n
if ne ulong ar_ib add q i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add q n
if lt r e
if ne ar_ib r 10
ret 0
end
end
ret 1
end

note isnote: the word at p is note (the lexer ends a word at a blank, a parenthesis or the end)
fn fe_isnote p ulong to ulong
e = get f_inlen 0
if gt add p 4 e
ret 0
end
i = ulong 0
x = ulong 1702129518
while lt i 4
if ne ulong ar_ib add p i and x 255
ret 0
end
x = shr x 8
i = add i 1
end
r = add p 4
if lt r e
b = ar_ib r
if and gt b 32 and ne b 40 ne b 41
ret 0
end
end
ret 1
end

fn fe_chk_mode q ulong to ulong
if ne fe_lineis q 461229090915 5 0
ret 1
end
if ne fe_lineis q 1954047342 4 0
ret 2
end
note usage (omc chk_mode 3, OmcNoCaps): compile as usual and write the use record in place of the output
if ne fe_lineis q 435526136693 5 0
ret 3
end
ret 0
end

fn fe_chk_lead to void
e = get f_inlen 0
p = ulong 0
ln = ulong 1
go = true
while go
m = ulong 0
while and go lt m 999999
q = fe_skipbl p
if ge q e
go = false
else
if eq ar_ib q 10
p = add q 1
ln = add ln 1
else
if ne fe_isnote q 0
p = fe_skipln q
ln = add ln 1
else
k = fe_chk_mode q
if ne k 0
put f_chkmod 0 k
put f_chkln 0 ln
put f_sbase 0 fe_skipln q
end
go = false
end
end
end
m = add m 1
end
end
end

note om2lead: skip blank lines and note lines; when the next line is exactly om2 (1), om2 diag (2) or
note om2 fmt (3) the unit is OM-2: om2, om2m, om2ln, om2pos. Anything else leaves the unit OM-1.
fn fe_om2lead to void
e = get f_inlen 0
p = ulong 0
ln = ulong 1
if ne get f_chkmod 0 0
p = get f_sbase 0
ln = add get f_chkln 0 1
end
go = true
while go
m = ulong 0
while and go lt m 999999
q = fe_skipbl p
if ge q e
go = false
else
if eq ar_ib q 10
p = add q 1
ln = add ln 1
else
if ne fe_isnote q 0
p = fe_skipln q
ln = add ln 1
else
r = ulong 0
if eq q p
if ne fe_lineis q 3304815 3 0
r = ulong 1
end
if ne fe_lineis q 7449351137405332847 8 0
r = ulong 2
end
if ne fe_lineis q 32771382692703599 7 0
r = ulong 3
end
if eq r 0
r = fe_cp_mode q
end
end
if ne r 0
put f_om2 0 1
put f_om2m 0 sub r 1
put f_om2ln 0 ln
put f_om2pos 0 q
end
go = false
end
end
end
m = add m 1
end
end
end


note fmttail: blank lines at the end of the rest (n bytes) are error 6, at the first such line
fn fe_fmttail n ulong to void
lnb = ulong 0
lnl = ulong 1
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i n
go = false
else
b = ar_ib i
if eq b 10
ln = add ln 1
else
if and ne b 32 ne b 9
lnb = add i 1
lnl = ln
end
end
i = add i 1
end
m = add m 1
end
end
bad = false
if eq lnb 0
if gt n 0
bad = true
lnl = ulong 0
end
end
k = lnb
fl = n
go = true
while go
m = ulong 0
while and go lt m 999999
if ge k n
go = false
else
if eq ar_ib k 10
fl = k
go = false
end
k = add k 1
end
m = add m 1
end
end
if lt add fl 1 n
bad = true
end
if bad
put f_line 0 add lnl 1
put f_tka 0 lnb
put f_tkb 0 lnb
fe_fail 6
end
end

fn fe_fmtprep to void
if ne get f_om2pos 0 0
put f_line 0 get f_om2ln 0
put f_tka 0 get f_om2pos 0
put f_tkb 0 get f_om2pos 0
fe_fail 16
end
e = get f_inlen 0
ln = ulong 1
i = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge i e
go = false
else
b = ar_ib i
if eq b 13
put f_line 0 ln
put f_tka 0 i
put f_tkb 0 add i 1
fe_fail 6
end
if eq b 10
ln = add ln 1
end
i = add i 1
end
m = add m 1
end
end
r = fe_skipln get f_om2pos 0
put f_lbase 0 get f_om2ln 0
put f_sbase 0 r
n = sub e r
j = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge j n
go = false
else
ar_bp 0 j ar_ib add r j
j = add j 1
end
m = add m 1
end
end
put f_inlen 0 n
fe_fmttail n
put f_om2 0 0
put f_om2m 0 0
put f_om2ln 0 0
fe_om2lead
if eq get f_om2m 0 2
put f_line 0 get f_om2ln 0
put f_tka 0 get f_om2pos 0
put f_tkb 0 get f_om2pos 0
fe_fail 16
end
end



note tok_hex (OM-2): 0x and 1..16 digits 0-9 a-f is the unsigned value (tk 2, tbig as tok_num). A - before
note 0x, 0X, no digits, more than 16 digits, an uppercase or any other character is error 6. 0 when the
note word is not a hex literal.
fn fe_tok_hex to ulong
p = get f_ts 0
e = get f_cur 0
if eq ar_ib p 45
q = add p 1
if lt add q 1 e
if eq ar_ib q 48
c = ar_ib add q 1
if or eq c 120 eq c 88
fe_nfail 6
end
end
end
ret 0
end
if ge add p 1 e
ret 0
end
if ne ar_ib p 48
ret 0
end
c = ar_ib add p 1
if eq c 88
fe_nfail 6
end
if ne c 120
ret 0
end
n = sub e add p 2
if eq n 0
fe_nfail 6
end
if gt n 16
fe_nfail 6
end
v = ulong 0
i = add p 2
while lt i e
d = ulong ar_ib i
if and ge d 48 le d 57
v = or shl v 4 sub d 48
else
if and ge d 97 le d 102
v = or shl v 4 sub d 87
else
fe_nfail 6
end
end
i = add i 1
end
put f_tbig 0 shr v 63
put f_tw 0 v
put f_tk 0 2
ret 1
end

note ---- float literals: a token is the decimal value fsgn * fnd * 10^fp10, fsuf 0 none / 1 f32 / 2 f64.
note fg_* hold the working state of the one literal being converted (see fparse/fbits/fnorm/fgen).
global f_fsgn ulong 1
global f_fnd ulong 1
global f_fp10 long 1
global f_fsuf ulong 1
global f_fg_fl ulong 1
global f_fgseen ulong 1
global f_fg_ex long 1
global f_fgesig long 1
global f_fg_ed ulong 1
global f_fg_ty ulong 1
global f_fg_e long 1
global f_fg_q ulong 1
global f_fg_m ulong 1
global f_fg_stk ulong 1
global f_fbn ulong 80

note ======== float literals: decimal text to IEEE-754 binary32/binary64 ========
note The literal is fnd * 10^fp10 = A / D with A = fnd * 10^max(fp10,0) and D = 10^max(-fp10,0), both
note held exactly as 40 32-bit limbs in fbn (A at 0, D at 40). The smaller of the two is shifted to the
note other's bit length, then restoring division yields the first 64 quotient bits (fg_m, leading bit
note set) and a remainder whose nonzero-ness is the sticky flag (fg_stk); froundsh rounds that exact
note truncation once to nearest even and fpack packs it, subnormals included (#1024: the old converter
note scaled one factor of ten at a time and dropped bits at every step). fp10 < -343 means a value
note below (2^63-1)*10^-344 < 2^-1075, signed zero; fp10 > 308 means at least 10^309, above the
note binary64 maximum (error 8). So A and D never exceed 1141 bits.

note blen: bits needed for x (0 for zero)
fn fe_blen x ulong to ulong
n = ulong 0
while ne x 0
x = shr x 1
n = add n 1
end
ret n
end

note fparse: read the literal text inp[pos, pos+len) into fsgn, fnd, fp10, fsuf (0 none, 1 f32, 2 f64).
note Grammar: [-]digits[.digits][(e|E)[+|-]digits][f32|f64]. At most 2^63-1 significant digits
note (error 8), a dot with no digit after it is error 6, |exponent| <= 999 (error 8).
note The digit scans here and in fexp run as nested 999999-pass loops: a literal of more than 1000000
note zero digits trapped 4 in a single loop's hidden 1000000-pass guard (#965).
fn fe_fparse pos ulong ln ulong to void
p = pos
e = add pos ln
put f_fsgn 0 0
put f_fsuf 0 0
put f_fnd 0 0
put f_fg_fl 0 0
put f_fgseen 0 0
if eq ar_ib p 45
put f_fsgn 0 1
p = add p 1
end
go = true
while go
pos = ulong 0
while and go lt pos 999999
if ge p e
go = false
else
d = sub ulong ar_ib p 48
if le d 9
if gt get f_fnd 0 922337203685477580
fe_fail 8
end
if eq get f_fnd 0 922337203685477580
if gt d 7
fe_fail 8
end
end
put f_fnd 0 add mul get f_fnd 0 10 d
if ne get f_fgseen 0 0
put f_fg_fl 0 add get f_fg_fl 0 1
end
p = add p 1
else
go = false
if eq ar_ib p 46
if eq get f_fgseen 0 0
put f_fgseen 0 1
p = add p 1
go = true
end
end
end
end
pos = add pos 1
end
end
if and ne get f_fgseen 0 0 eq get f_fg_fl 0 0
fe_fail 6
end
p = fe_fexp p e
p = fe_fsufx p e
if ne p e
fe_fail 6
end
x = mul get f_fgesig 0 get f_fg_ex 0
put f_fp10 0 sub x long get f_fg_fl 0
end

note fexp: the exponent of the literal, if present: fg_ex, fg_esign, fg_ed. Returns the new position.
fn fe_fexp p ulong e ulong to ulong
put f_fg_ex 0 0
put f_fgesig 0 1
if and lt p e or eq ar_ib p 101 eq ar_ib p 69
p = add p 1
if lt p e
if or eq ar_ib p 43 eq ar_ib p 45
if eq ar_ib p 45
put f_fgesig 0 -1
end
p = add p 1
end
end
put f_fg_ed 0 0
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
d = sub ulong ar_ib p 48
if gt d 9
go = false
else
put f_fg_ex 0 mul get f_fg_ex 0 10
put f_fg_ex 0 add get f_fg_ex 0 long d
if gt get f_fg_ex 0 999
fe_fail 8
end
put f_fg_ed 0 add get f_fg_ed 0 1
p = add p 1
end
end
m = add m 1
end
end
if eq get f_fg_ed 0 0
fe_fail 6
end
end
ret p
end

note fsufx: the optional f32/f64 suffix: fsuf 1 or 2. Returns the new position.
fn fe_fsufx p ulong e ulong to ulong
if lt p e
r = sub e p
if ne r 3
fe_fail 6
end
if ne ar_ib p 102
fe_fail 6
end
if and eq ar_ib add p 1 51 eq ar_ib add p 2 50
put f_fsuf 0 1
else
if and eq ar_ib add p 1 54 eq ar_ib add p 2 52
put f_fsuf 0 2
else
fe_fail 6
end
end
p = add p 3
end
ret p
end

note fbmul: limbs fbn[o, o+40) times k (k < 2^32, so each limb step fits 64 bits); the product must fit
note in 40 limbs. Returns its bit length, so fbmul o 1 only measures.
fn fe_fbmul o ulong k ulong to ulong
c = ulong 0
t = ulong 0
i = ulong 0
while lt i 40
j = add o i
v = add mul get f_fbn j k c
put f_fbn j and v 4294967295
c = shr v 32
if ne and v 4294967295 0
t = add mul i 32 fe_blen and v 4294967295
end
i = add i 1
end
ret t
end

note fbpow: fbn[o, o+40) times b^n (b 2 or 10), in factors that stay below 2^32.
fn fe_fbpow o ulong b ulong n ulong to void
while gt n 0
m = ulong 1
c = ulong 0
while and lt c n le mul m b 4294967295
m = mul m b
c = add c 1
end
t = fe_fbmul o m
n = sub n c
end
end

note fbsub: one restoring-division step. If A >= D then A = A - D and 1, else A is kept and 0.
fn fe_fbsub to ulong
r = ulong 2
i = ulong 40
while and gt i 0 eq r 2
i = sub i 1
a = get f_fbn i
d = get f_fbn add i 40
if lt a d
r = ulong 0
end
if gt a d
r = ulong 1
end
end
if eq r 0
ret 0
end
b = ulong 0
i = ulong 0
while lt i 40
v = sub sub get f_fbn i get f_fbn add i 40 b
put f_fbn i and v 4294967295
b = shr v 63
i = add i 1
end
ret 1
end

note froundsh: round fg_m right by sh bits to fg_q, nearest even; the guard and every lower bit
note (plus fg_stk) decide. sh may be 64 (then q is zero and bit 63 is the guard).
fn fe_froundsh sh ulong to void
m = get f_fg_m 0
q = ulong 0
guard = ulong 0
lost = ulong 0
if eq sh 0
q = m
else
if ge sh 64
guard = shr m 63
lost = and m 9223372036854775807
else
q = shr m sh
guard = and shr m sub sh 1 1
if gt sub sh 1 0
lost = and m sub shl 1 sub sh 1 1
end
end
end
sticky = or get f_fg_stk 0 lost
if ne guard 0
if or ne sticky 0 eq and q 1 1
q = add q 1
end
end
put f_fg_q 0 q
end

note fpack: fg_m/fg_e to IEEE bits of fg_ty, including subnormals; a literal that rounds to infinity
note is refused (error 8).
fn fe_fpack to ulong
p = ulong 53
bias = long 1023
maxe = long 2047
emin = long -1022
mb = ulong 52
w = ulong 64
if eq get f_fg_ty 0 10
p = ulong 24
bias = long 127
maxe = long 255
emin = long -126
mb = ulong 23
w = ulong 32
end
e = add get f_fg_e 0 63
if ge e emin
sh = sub 64 p
fe_froundsh sh
q = get f_fg_q 0
if eq q shl 1 p
q = shr q 1
e = add e 1
end
E = add e bias
if ge E maxe
fe_fail 8
end
q = and q sub shl 1 sub p 1 1
q = or q shl ulong E mb
q = or q shl get f_fsgn 0 sub w 1
ret q
end
k = ulong sub emin e
sh = add sub 64 p k
if gt sh 64
ret shl get f_fsgn 0 sub w 1
end
fe_froundsh sh
q = get f_fg_q 0
q = or q shl get f_fsgn 0 sub w 1
ret q
end

note fbits: the parsed literal as IEEE bits of type ty (10 f32, 11 f64). Zero keeps the sign (-0.0).
fn fe_fbits ty ulong to ulong
put f_fg_ty 0 ty
p = get f_fp10 0
if or eq get f_fnd 0 0 lt p -343
w = ulong 64
if eq ty 10
w = ulong 32
end
b = ulong 0
if ne get f_fsgn 0 0
b = shl ulong 1 sub w 1
end
ret b
end
if gt p 308
fe_fail 8
end
i = ulong 0
while lt i 80
put f_fbn i 0
i = add i 1
end
put f_fbn 0 and get f_fnd 0 4294967295
put f_fbn 1 shr get f_fnd 0 32
put f_fbn 40 1
if gt p 0
fe_fbpow 0 10 ulong p
else
fe_fbpow 40 10 ulong sub 0 p
end
a = fe_fbmul 0 1
d = fe_fbmul 40 1
e = long 0
if lt a d
fe_fbpow 0 2 sub d a
e = sub 0 long sub d a
else
fe_fbpow 40 2 sub a d
e = long sub a d
end
q = ulong 0
while lt q 9223372036854775808
q = or shl q 1 fe_fbsub
a = fe_fbmul 0 2
e = sub e 1
end
put f_fg_m 0 q
put f_fg_e 0 add e 1
put f_fg_stk 0 fe_fbmul 0 1
ret fe_fpack
end

note fsizeof: sizeof T, or sizeof S for a struct: bytes. foffset: offsetof S f: the field's byte offset
note in the struct's 8-byte-cell layout. Both are compile-time constants of type ulong.
fn fe_fsizeof dst ulong to void
sid = fe_peek_struct
if ne sid 0
si = sub sid 1
n = ulong get f_stcell si
fe_vdone 3 mul n 8 5
ret
end
t = fe_typeword

end
end
end
end
if and ne k 0 ne k 3
put f_dexp 0 6
fe_fail 5
end
put ar_m add get ar_rb 26 f get f_cur 0
put ar_m add get ar_rb 27 f get f_line 0
end

note inl_call: a call of an inline function fe (index + 1): the result register first (dst, or the next
note pool slot), then the arguments left to right exactly as for a call, then the body in place.
fn fe_inl_call fe ulong dst ulong to void
s0 = get f_nslot 0
rres = ulong 255
ns = s0
if ne ar_c 21 sub fe 1 12
if eq dst 255
rres = fe_alloc
ns = add s0 1
else
rres = dst
end

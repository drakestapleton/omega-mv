put ar_m add get ar_rb 48 n get f_line 0
put ar_m add get ar_rb 49 n 0
put ar_m add get ar_rb 50 n kk
put ar_m add get ar_rb 51 n get f_nn 0
put ar_m add get ar_rb 52 n get f_held 0
put f_fzone 0 add get f_fzone 0 1

q = add cb mul i 3
k = get ar_m add get ar_rb 59 q
v = get ar_m add get ar_rb 59 add q 1
r = ulong 0
if eq ar_c 35 p 0
if and eq k 1 ge fe_regidx v hb
r = v
else
r = fe_alloc
fe_force k v ulong uchar get ar_m add get ar_rb 33 p r
end
else
if eq k 5
r = v
else
r = fe_alloc
end
end
fe_inl_add p r
if eq fe_pwid p 2
fe_inl_lr add mul div cb 32 6 i
end
fe_fz_inl p get ar_m add get ar_rb 59 add q 2
end


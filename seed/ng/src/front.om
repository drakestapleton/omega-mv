if and eq fe_isfloat st 0 eq fe_lty st fe_lty dt
fe_lval v dt
ret
end
end
if eq fe_isfloat dt 0
if fe_lcf st dt
o = fe_lop 78 fe_lty dt 5 2
ir_set o 1 v
end
end
fe_lval fe_lp1 36 dt 0 v dt
end


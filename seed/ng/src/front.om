note cpufence (keyword 199, a statement without operands): the host CPU publication barrier. AArch64:
note DSB SY (d5033f9f, the full-system barrier mapget/mapset already bracket their access with). x86-64:
note MFENCE (0F AE F0), the fence the x86 mapget/mapset use. Every earlier load and store completes before
note any later one, so a GPU or another CPU that observes a later store also observes the earlier ones.
note Inline here, not a function: om4 builds omc and holds at most 512 functions, 511 in use.
if eq c 199
fe_eol
ret 0
end
note cpurelax (keyword 200, a statement without operands): spin-wait hint, no ordering. AArch64: YIELD
note (d503203f). x86-64: PAUSE (F3 90). Use it in a bounded poll loop; pair it with cpufence for order.
if eq c 200
fe_eol
ret 0
end
if eq c 97
fe_s_cont
ret 0
end
if or or or eq c 77 eq c 78 eq c 79 eq c 81
fe_fail 9
end
if or eq c 85 eq c 193
fe_fail 9
end
fe_fail 16
ret 0
end

note ======== program mode: some line is `fn main` (blanks, fn, blanks, main, then a blank or the end) ========
note skipbl: the first place at or after q that is not a space or tab (or the end)
fn fe_skipbl q ulong to ulong
e = get f_inlen 0
p = q
go = true
while go
m = ulong 0
while and go lt m 999999
if ge p e
go = false
else
b = ar_ib p
if or eq b 32 eq b 9
p = add p 1
else
go = false
end
end
m = add m 1
end
end
ret p
end

note skipln: the place after the next newline at or after q (or the end)
fn fe_skipln q ulong to ulong
e = get f_inlen 0
p = fe_nlat q e
if lt p e
ret add p 1
end
ret p
end

note ps_at: the line's first byte that is not blank is at p: 1 when the line is `fn main`, 2 when the input
note ends while deciding, else 0. om4 PS_LINE .. PS_YES.
fn fe_ps_at p ulong to ulong
e = get f_inlen 0
if ne ar_ib p 102
ret 0
end
q = add p 1
if ge q e
ret 2
end
if ne ar_ib q 110
ret 0
end
r = add q 1
q = fe_skipbl r
if ge q e
ret 2
end
if eq q r
ret 0
end
if gt add q 4 e
ret 0
end
if ne ar_ib q 109
ret 0
end
if ne ar_ib add q 1 97
ret 0
end
if ne ar_ib add q 2 105
ret 0
end
if ne ar_ib add q 3 110
ret 0
end
if ge add q 4 e
ret 1
end
if gt ar_ib add q 4 32
ret 0
end
ret 1
end

fn fe_prescan to void
e = get f_inlen 0
p = ulong 0
go = true
while go
m = ulong 0
while and go lt m 999999
p = fe_skipbl p
if ge p e
go = false
else
r = fe_ps_at p
if eq r 1
put f_progmo 0 1
go = false
end
if eq r 2
go = false
end
if go
p = fe_skipln p
if ge p e
go = false
end
end
end
m = add m 1
end
end
end

note First collect signatures. Only fn headers are parsed here; other lines are read in the body pass.
fn fe_namescan to void

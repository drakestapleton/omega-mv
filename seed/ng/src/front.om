ret 3
end
end
ret 0
end

note cp_next reads the next prefix clause, ignoring comments and blanks; a nonclause is unread.
fn fe_cp_next to ulong
p = get f_cur 0
l = get f_line 0
go = true
while go
fe_tok
if eq get f_tk 0 1
if and eq get f_tl 0 4 eq get f_tw 0 1702129518
fe_skipnl
else
go = false
end
else
if ne get f_tk 0 0
go = false
end
end
end
k = fe_cp_kind
if eq k 0
put f_cur 0 p
put f_line 0 l
end
ret k
end

note Recursive purity allowlist, before rdval dispatch. No calls, floats, host or mapped operations.
fn fe_cp_token to void
if eq get f_tk 0 2
ret
end
if ne get f_tk 0 1
fe_fail 30
end
if gt get f_tl 0 63
fe_fail 30
end
c = fe_kw get f_tw 0
if eq c 0
ret
end
if le sub c 1 8
ret
end
if le sub c 33 19
ret
end
if or eq c 55 eq c 56
ret
end
if or or eq c 59 eq c 60 eq c 74
ret
end
fe_fail 30
end

note cp_erase: take back a release-erased contract's diag site records. From omc.om cp_erase (@943d9555 line 14464),
note which also took back its code, trap records and branch targets; the check pass has none.
fn fe_cp_erase to void
put f_nsite 0 get f_csnap 2
end

fn fe_cp_eval code ulong erase ulong to void
ln = get f_line 0
rule = ulong 0
note Pure evaluation changes no names, calls, inline frames or writes.
note Snapshot the diagnostic sites, the pool slots and the fuel zone (omc.om also snapshot code effects).
put f_csnap 2 get f_nsite 0
put f_csnap 3 get f_nslot 0
put f_csnap 4 get f_fzone 0
put f_cpure 0 1
put f_fzone 0 1
fe_rdval 0 1 255 0
if ne get f_rt 0 1
fe_fail 7
end
fe_eol
nextln = get f_line 0
put f_line 0 ln
if and eq get f_rk 0 3 ne get f_rv 0 0
rule = ulong 1
fe_cp_erase
else
if or ne erase 0 ne get f_crel 0 0
rule = ulong 2
fe_cp_erase
else
if eq get f_rk 0 3
fe_trapc 14 code
else
if eq get f_rk 0 4
fe_trapc xor get f_rv 0 1 code
else
r = fe_matreg get f_rk 0 get f_rv 0 get f_rt 0
fe_trapsite or 3019898880 r code
end
end
end
end
if and eq get f_om2m 0 1 eq erase 0
fe_cp_rec rule
end
put f_line 0 nextln
put f_cpure 0 0
put f_cvalid 0 0
put f_fzone 0 get f_csnap 4
put f_nslot 0 get f_csnap 3
end

note omc-check distinguishes a proof from release policy; initial deferred validation is silent.
fn fe_cp_rec rule ulong to void
fe_sitew 7162245557575183727 8
fe_sitew 540090475 4
if eq rule 0
fe_sitew 1953523051 4
else
fe_sitew 110386890240613 6
end
fe_sitew 67505853393952 6
fe_siten add get f_line 0 get f_lbase 0
fe_sitew 67505820627488 6
if eq rule 0
fe_sitew 28549272340166002 7
end
if eq rule 1
fe_sitew 8389750308618530659 8
fe_sitew 435762132013 5
end
if eq rule 2
fe_sitew 28555834798400882 7
end
fe_sitew 67501558426400 6
if eq get f_ckind 0 1
fe_sitew 8315178084276987250 8
end
if eq get f_ckind 0 2
fe_sitew 32481164592901733 7
end
if eq get f_ckind 0 3
fe_sitew 7953754356895346281 8
fe_siteb 116
end
fe_siteb 10
end

note Function prefix predicates bind only globals and parameters visible on entry.
fn fe_cp_entry to void
lv = get f_inl 0
put f_cfhas lv 0
if eq get f_om2 0 0
ret
end
put f_cfpos lv get f_cur 0
put f_cfline lv get f_line 0
put f_cflim lv get f_nn 0
put f_clim 0 get f_nn 0
k = fe_cp_next
n = ulong 0
while ne k 0
put f_ckind 0 k
if ge n 64
fe_fail 14
end
if eq k 3
fe_fail 30
end
put f_crkind 0 0
if eq k 1
fe_cp_eval 9 0
else
put f_cfhas lv 1
ns = get f_nslot 0
put f_crtype 0 get f_curret 0
if ne get f_curret 0 12
put f_crkind 0 1
put f_crval 0 fe_alloc
end
put f_cvalid 0 1
fe_cp_eval 10 1
put f_nslot 0 ns
end
n = add n 1
k = fe_cp_next
end
end

note Return expressions are evaluated once, before postconditions, without overwriting argument X0.
fn fe_cp_post kind ulong value ulong ty ulong to void
lv = get f_inl 0
if eq get f_cfhas lv 0
ret
end
p = get f_cur 0
l = get f_line 0
put f_cur 0 get f_cfpos lv
put f_line 0 get f_cfline lv
put f_clim 0 get f_cflim lv
put f_crkind 0 kind
put f_crval 0 value
put f_crtype 0 ty
k = fe_cp_next
while ne k 0
if eq k 2
put f_ckind 0 2
fe_cp_eval 10 0
else
fe_skipnl
end
k = fe_cp_next
end
put f_cur 0 p
put f_line 0 l
end

note Loop invariants execute at the head, including zero trips and final false condition.
note Continue reaches the checked head (for increments first); break bypasses it.
fn fe_cp_head pos ulong ln ulong to void
if eq get f_om2 0 0
ret
end
p = get f_cur 0
l = get f_line 0
put f_cur 0 pos
put f_line 0 ln
put f_clim 0 get f_nn 0
put f_crkind 0 0
k = fe_cp_next
n = ulong 0
while eq k 3
put f_ckind 0 3
if ge n 64
fe_fail 14
end
fe_cp_eval 10 0
n = add n 1
k = fe_cp_next
end
put f_cur 0 p
put f_line 0 l
end

note Head clauses have already been checked and emitted before the condition, never at body entry.
fn fe_cp_skip to void
if eq get f_om2 0 0
ret
end
p = get f_cur 0
l = get f_line 0
k = fe_cp_next
while eq k 3
fe_skipnl
p = get f_cur 0
l = get f_line 0
k = fe_cp_next
end
put f_cur 0 p
put f_line 0 l
end

note check: the unit in the payload region of the arena (bytes 0 .. n - 1), as omc.om main (@943d9555 line
note 14676) reads it from stdin. main.om's modes @ng front-check and front-ir read it there (ar_rdin) and
note give every other region its first room (ar_init); a payload the arena cannot hold is error 14 there, as
note in omc (a stdin read error is main.om's exit 27, not omc's 1). Exit or return as omc: 0 accepted, the
note refusal's code after its stderr line; 64 for a unit ng does not take.
fn fe_check n ulong to int
fe_hinit
put f_inlen 0 n
fe_xlead
note ng has no x86 or EFI target (D8): such a unit is outside the front end (exit 64). omc.om main
note (@943d9555 line 14698) went on to set up the x86 code buffer here.
if gt get f_xtarge 0 0
exit int 64
end
fe_chk_lead
fe_om2lead
if eq get f_om2m 0 2
fe_fmtprep
end
note IR v1 mode (omc.om ir_run, main @943d9555 line 14704) is not ng's input language: exit 64
if ne fe_ir_lead 0
exit int 64
end
fe_prescan
fe_namescan
put f_line 0 1
put f_lcur0 0 get f_cur 0
done = false
while not done
m = ulong 0
while and not done lt m 999999
if ne fe_stmt 0
done = true
end
m = add m 1
end
end
ret 0
end



note One compile-time ioctl allowlist is shared by both native Linux backends.
fn fe_xhreq c ulong x ulong to ulong
fe_harg x 4 8
fe_harg x 2 4
if ne ar_w 59 add x 12 3
fe_fail 9
end
q = get ar_m add get ar_rb 59 add x 13
n = ulong 4
if eq c 166
if ne q 21531
if ne and q 3221290752 3221243392
ok = eq q 2154840336
ok = or ok eq q 3224387873
ok = or ok eq q 3222815010
ok = or ok eq q 3225960739
ok = or ok eq q 3222815012
if not ok
fe_fail 9
end
end
n = and shr q 16 16383
if eq n 0
fe_fail 9
end
end
end
if eq c 172
n = ulong 0
if eq q 805306369
n = ulong 16
end
if eq q 75
n = ulong 8
end
if eq q 37
n = ulong 40
end
if or eq q 38 eq q 26
n = ulong 20
end
if eq q 25
n = ulong 32
end
if eq q 27
n = ulong 56
end
if eq q 28
n = ulong 28
end
if eq q 33
n = ulong 9264
end
if or eq q 34 eq q 73
n = ulong 24
end
if eq n 0
fe_fail 9
end
end
if eq c 171
if and ne q 3223340586 ne q 3223340587
fe_fail 9
end
n = ulong 32
end
ret n
end







































fn fe_xlead to void
note Only the exact bytes "target " at offset zero select a target (x86, or ng's macos). Default parsing is untouched.
if lt get f_inlen 0 8
ret
end
if or ne uchar and shr get ar_m 0 0 255 116 ne uchar and shr get ar_m 0 8 255 97
ret
end
if or ne uchar and shr get ar_m 0 16 255 114 ne uchar and shr get ar_m 0 24 255 103
ret
end
if or ne uchar and shr get ar_m 0 32 255 101 ne uchar and shr get ar_m 0 40 255 116
ret
end
if ne uchar and shr get ar_m 0 48 255 32
ret
end
put f_cur 0 0
put f_line 0 1
fe_tok
fe_tok
if and eq get f_tw 0 8679965255892613240 eq get f_tl 0 8
put f_xtarge 0 1
else
if and eq get f_tw 0 115888505632888 eq get f_tl 0 6
put f_xtarge 0 2
else
note `target macos` is ng's own: the unit stays in the front end (f_xtarge 0), with the library words as keywords
if and eq get f_tw 0 495790023021 eq get f_tl 0 5
put f_mac 0 1
else
fe_fail 25
end
end
end
fe_eol
p = ulong 0
while lt p get f_cur 0 bound 134217729
if ne ar_ib p 10
ar_bp 0 p 32
end
p = add p 1
end
put f_cur 0 0
put f_line 0 1
end



note ======== x86efi: UEFI 2.10 PE32+ application (docs/X86-EFI.md) ========
note efi OP ARG A OFF N -> ulong EFI_STATUS or result. OP is a literal 0..14; A is writable uchar
note storage, bounds checked before any firmware call; ARG is never a pointer. Errors are 2^63|code.
note Private state occupies the first 16 KiB of the PE .bss, below the owned 8 MiB stack. Firmware is
note called per UEFI 2.3.4.2: RCX/RDX/R8/R9, 32-byte home area, an 80-byte 16-aligned reservation.
note Language values stay in RBP slots, so integers and floats survive every firmware call.
note Port of the Allen x86efi fork (operations 0..11) onto main's backend; 12, 13 and 14 are new.






note xefival: `efi` as a value. From omc.om xefival (@943d9555 line 17606): every target but x86 EFI
note refuses it with error 25 before reading anything, and x86 EFI units exit 64 here (D8).
fn fe_xefival dst ulong to void
fe_fail 25
end












note ======== @ng front-ir: lower a unit fe_check accepted to ΩIR (seed/ng/IR.md s13) ========
note A second walk over the source with the same tokenizer, after fe_check has proved the unit valid, so
note every refusal keeps omc's code and this walk never refuses. Values are SSA: a name holds its current
note value handle; a join block (if merge, loop head, loop latch, break target) takes the token and every
note scalar name in scope as block parameters, and each br passes the current ones. cbr targets take only
note the token and see the dominating values. A construct this walk does not lower exits 64 with
note "ng: front-ir: line N: not lowered" (scope, not a refusal).
note Names: f_lnk 0 scalar (f_lnv its value), 1 local or parameter array (f_lnv its REF), 2 global array
note (f_lnv the IR global), 3 constant (f_lnc its canonical bits), 4 text (f_lnv the IR global, class 1),
note 5 array parameter, sized or unsized (f_lnv its SLICE, f_lnc its access: 0 view, 1 edit).
note f_lnt is the omc type (element type for arrays), f_lnc the length for sized arrays. A hidden loop counter
note has name word 0, which no lookup asks for.
note An array parameter (view or edit) is a REF with access 1: ΩIR v1 has no op that narrows a REF's access,
note and a local array (access 1) is passed to view parameters; the view rule itself is fe_check's error 20.
global f_lnn ulong 1
global f_lntop ulong 1
global f_lfn uint 1
global f_lbk uint 1
global f_ltk uint 1
global f_lcret ulong 1
global f_lrv uint 1
global f_lrt ulong 1
global f_lrk ulong 1
global f_lrb ulong 1
global f_lat ulong 1
global f_lal ulong 1
note block stack: kind (1 if, 2 if after else, 3 while, 4 for), names at open n0, names with the loop's own
note n1, join, head, false or exit block, break join, latch, snapshot base
global f_lsd ulong 1
global f_lsp ulong 1
global f_lah ulong 1
global f_lan ulong 1
global f_lcp ulong 1
global f_lqw ulong 1
global f_lqt ulong 1
global f_lqm ulong 1
global f_lqb ulong 1
global f_lqv uint 1
global f_lqn ulong 1
note Contract lowering state: function prefix, entry name limit, and one evaluated return value.
global f_lcpos ulong 1
global f_lclin ulong 1
global f_lclim ulong 1
global f_lcact ulong 1
global f_lcval uint 1
global f_lctyp ulong 1
text f_lmsg "ng: front-ir: line : not lowered\n"

note lno: outside what this walk lowers: one stderr line, exit 64
fn fe_lno to void
put f_mc 0 0
for j ulong 19
fe_mputb get f_lmsg j
end
fe_mputn add get f_line 0 get f_lbase 0
for j ulong 14
fe_mputb get f_lmsg add j 19
end
w = write 2 f_msg 0 get f_mc 0
exit int 64
end

note lty: omc type -> ΩIR type id (bool .. long 1..9 unchanged, f32 13, f64 14, void 0)
fn fe_lty t ulong to uint
if eq t 10
ret 13
end
if eq t 11
ret 14
end
if eq t 12
ret 0
end
note qty (omc type 13) is a u64 whose add, sub and mul trap 1 on any wrap (chk.add/sub/mul, fe_lbop)
if eq t 13
ret 5
end
if or eq t 0 gt t 9
fe_lno
end
ret uint t
end

fn fe_lsg t ulong to bool
ret and ge t 6 le t 9
end

note lcan: canonical const bits of v for type t (IR.md s7.1)
fn fe_lcan t ulong v ulong to ulong
if ne fe_isfloat t 0
ret v
end
w = fe_twid t
if ge w 64
ret v
end
m = sub shl ulong 1 w 1
x = and v m
if fe_lsg t
if ne and shr x sub w 1 1 0
x = or x not m
end
end
ret x
end

note lref: REF (access a, space 0) to ARRAY of n elements of omc type t
fn fe_lref t ulong n ulong a uint to uint
ret ir_tref ir_tarr fe_lty t uint n a 0
end

note lop: op in the current block; operand 0 is the current token when the op carries one, and an E op
note makes its new token current
fn fe_lop op uint ty uint imm ulong n uint to uint
if eq get f_lbk 0 0
fe_lno
end
o = ir_op get f_lbk 0 op ty imm n
if ne ir_htok op 0
ir_set o 0 get f_ltk 0
end
if eq get i_rtk op 1
put f_ltk 0 ir_otok o
end
ret o
end

fn fe_lcst t ulong v ulong to uint
o = fe_lop 1 fe_lty t fe_lcan t v 0
ret ir_res o
end

fn fe_lp1 op uint t ulong imm ulong a uint to uint
o = fe_lop op fe_lty t imm 1
ir_set o 0 a
ret ir_res o
end

fn fe_lp2 op uint t ulong a uint b uint to uint
o = fe_lop op fe_lty t 0 2
ir_set o 0 a
ir_set o 1 b
ret ir_res o
end

fn fe_lck1 op uint code ulong a uint to void
o = fe_lop op 0 code 2
ir_set o 1 a
end

fn fe_lck2 op uint code ulong a uint b uint to void
o = fe_lop op 0 code 3
ir_set o 1 a
ir_set o 2 b
end

note lck3: chk.bounds / chk.slice (trap 3) on r, a, b
fn fe_lck3 op uint r uint a uint b uint to void
o = fe_lop op 0 3 4
ir_set o 1 r
ir_set o 2 a
ir_set o 3 b
end

fn fe_lval v uint t ulong to void
put f_lrv 0 v
put f_lrt 0 t
put f_lrk 0 0
end

note ---- names ----
note The lowering's names are arena group lnames (f_lnw .. f_lnc, f_lnx the index + 1 before it in its chain)
note with a chained hash, group lnamehash (f_lnh, f_lhb bits): fe_lfind is the newest name in scope with the
note packed word, as the old back-to-front scan gave; every write of f_lnn but fe_ladd's goes through fe_lnm_set.
fn fe_ladd w ulong k ulong t ulong v uint c ulong to void
n = get f_lnn 0
fe_need 18 n
put ar_m add get ar_rb 68 n w
ar_pc 69 n uchar k
put ar_m add get ar_rb 70 n t
ar_pu 71 n v
put ar_m add get ar_rb 72 n c
fe_lnm_link n
put f_lnn 0 add n 1
if ge add n 1 shl ulong 2 get f_lhb 0
put f_lhb 0 add get f_lhb 0 1
fe_need 19 sub shl ulong 1 get f_lhb 0 1
ar_gzero 19
i = ulong 0
while le i n bound 16777217
fe_lnm_link i
i = add i 1
end
end
end

fn fe_lnm_link i ulong to void
h = ar_hash get ar_m add get ar_rb 68 i get f_lhb 0
put ar_m add get ar_rb 73 i get ar_m add get ar_rb 74 h
put ar_m add get ar_rb 74 h add i 1
end

note lnm_set: the lowering's names in scope become 0 .. v - 1: names above v leave their chains newest first
note (each is the newest of its chain then), names between f_lnn and v join them again in order
fn fe_lnm_set v ulong to void
n = get f_lnn 0
while gt n v bound 16777217
n = sub n 1
h = ar_hash get ar_m add get ar_rb 68 n get f_lhb 0
put ar_m add get ar_rb 74 h get ar_m add get ar_rb 73 n
end
while lt n v bound 16777217
fe_lnm_link n
n = add n 1
end
put f_lnn 0 v
end

fn fe_lfind w ulong to ulong
k = get ar_m add get ar_rb 74 ar_hash w get f_lhb 0
while ne k 0 bound 16777217
if eq ar_w 68 sub k 1 w
if or eq get f_lcact 0 0 lt sub k 1 get f_lclim 0
ret k
end
end
k = get ar_m add get ar_rb 73 sub k 1
end
ret 0
end

note ltyw: a scalar type word (uchar .. long, f32, f64) -> omc type
fn fe_ltyw to ulong
fe_tok
if or ne get f_tk 0 1 gt get f_tl 0 8
fe_lno
end
c = fe_kw get f_tw 0
if eq c 88
ret 10
end
if eq c 89
ret 11
end
if eq c 223
ret 13
end
if or lt c 2 gt c 9
fe_lno
end
ret c
end

note llen: a length, bound or trap code: a number or an integer constant name
fn fe_llen to ulong
fe_tok
if eq get f_tk 0 2
ret get f_tw 0
end
if eq get f_tk 0 1
x = fe_lfind get f_tw 0
if ne x 0
if eq ar_c 69 sub x 1 3
ret get ar_m add get ar_rb 72 sub x 1
end
end
end
fe_lno
ret 0
end

note ---- blocks and joins ----
note ljoin: a new block taking the token and every scalar name in [0, n0)
fn fe_ljoin n0 ulong to uint
b = ir_blk get f_lfn 0
for i ulong n0 bound 16777217
if eq ar_c 69 i 0
v = ir_bpar b fe_lty get ar_m add get ar_rb 70 i
end
end
if gt get i_bnp b 64
fe_lno
end
ret b
end

note lbr: br from the current block to b with the token and the scalar names in [0, n0); the path ends
fn fe_lbr b uint n0 ulong to void
m = uint 0
for i ulong n0 bound 16777217
if eq ar_c 69 i 0
m = add m 1
end
end
o = fe_lop 60 0 0 add m 2
ir_set o 0 b
ir_set o 1 get f_ltk 0
k = uint 2
for i ulong n0 bound 16777217
if eq ar_c 69 i 0
ir_set o k uint get ar_m add get ar_rb 71 i
k = add k 1
end
end
put f_lbk 0 0
end

note lbind: the scalar names in [0, n0) take b's parameters after its token
fn fe_lbind b uint n0 ulong to void
v = get i_vnx ir_btok b
for i ulong n0 bound 16777217
if eq ar_c 69 i 0
ar_pu 71 i v
v = get i_vnx v
end
end
end

fn fe_lgo b uint to void
put f_lbk 0 b
put f_ltk 0 ir_btok b
end

fn fe_lenter b uint n0 ulong to void
fe_lgo b
fe_lbind b n0
end

fn fe_lpush n0 ulong to void
p = get f_lsp 0
fe_need 21 add p n0
for i ulong n0 bound 16777217
ar_pu 84 add p i uint get ar_m add get ar_rb 71 i
end
put f_lsp 0 add p n0
end

fn fe_lrest p ulong n0 ulong to void
for i ulong n0 bound 16777217
ar_pu 71 i uint get ar_m add get ar_rb 84 add p i
end
end

fn fe_lpshb k ulong n0 ulong n1 ulong h uint x uint to void
d = get f_lsd 0
fe_need 20 d
ar_pc 75 d uchar k
put ar_m add get ar_rb 76 d n0
put ar_m add get ar_rb 77 d n1
ar_pu 79 d h
ar_pu 80 d x
ar_pu 78 d 0
ar_pu 81 d 0
ar_pu 82 d 0
put ar_m add get ar_rb 83 d get f_lsp 0
put f_lsd 0 add d 1
end

fn fe_lgetj d ulong to uint
if eq ar_u 78 d 0
ar_pu 78 d fe_ljoin get ar_m add get ar_rb 76 d
end
ret uint get ar_m add get ar_rb 78 d
end

fn fe_lgete d ulong to uint
if eq ar_u 81 d 0
ar_pu 81 d fe_ljoin get ar_m add get ar_rb 76 d
end
ret uint get ar_m add get ar_rb 81 d
end

fn fe_lgetl d ulong to uint
if eq ar_u 82 d 0
ar_pu 82 d fe_ljoin get ar_m add get ar_rb 77 d
end
ret uint get ar_m add get ar_rb 82 d
end

note lloop: the innermost open loop
fn fe_lloop to ulong
d = get f_lsd 0
while gt d 0 bound 16777217
d = sub d 1
if ge ar_c 75 d 3
ret d
end
end
fe_lno
ret 0
end

note ---- values: the result is f_lrv (handle), f_lrt (omc type), f_lrk (0 a value, 1 an untyped integer
note literal with bits f_lrb, 2 an untyped float literal with its packed span f_lrb) ----
fn fe_lfix e ulong to void
if eq e 0
ret
end
k = get f_lrk 0
if eq k 1
fe_lval fe_lcst e get f_lrb 0 e
end
if eq k 2
fe_lval fe_lcst e fe_fspan e get f_lrb 0 e
end
end

fn fe_lx e ulong to void
fe_tok
fe_lxt e
end

note lxt: a value whose first token is read; e the expected type (0 none), which an untyped literal takes
fn fe_lxt e ulong to void
put f_lrk 0 0
k = get f_tk 0
if eq k 2
put f_lrk 0 1
put f_lrb 0 get f_tw 0
put f_lrt 0 0
fe_lfix e
ret
end
if eq k 5
fe_fparse get f_ts 0 get f_tl 0
if eq get f_fsuf 0 0
put f_lrk 0 2
put f_lrb 0 add mul get f_ts 0 16777216 get f_tl 0
put f_lrt 0 0
fe_lfix e
ret
end
t = ulong 10
if eq get f_fsuf 0 2
t = ulong 11

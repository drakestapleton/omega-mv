note lhost: host word c as a value: each argument in source order (i int, l long, L ulong, u uint from a
note constant, r w S a byte array name, then off and n as ulong with chk.slice on the three, as omc checks
note each slice where it is read), then `host` with ty i64; mapaddr and mapget give omc's ulong
note (conv of the same bits). Operands wait on the call-argument stack so a nested host value is safe.
fn fe_lhost c ulong to void
f = fe_lhfmt c
bs = get f_lcp 0
fe_need 23 add bs 16
put f_lcp 0 add bs 16
na = ulong 0
while gt f 1 bound 8
ch = and f 255
f = shr f 8
if or or eq ch 114 eq ch 119 eq ch 83
ar = fe_laref
fe_lx 5
ao = get f_lrv 0
fe_lx 5
an = get f_lrv 0
fe_lck3 80 ar ao an
ar_pu 86 add bs na ar
ar_pu 86 add add bs na 1 ao
ar_pu 86 add add bs na 2 an
na = add na 3
else
t = ulong 8
if eq ch 108
t = ulong 9
end
if eq ch 76
t = ulong 5
end
if eq ch 117
t = ulong 4
end
fe_lx t
ar_pu 86 add bs na get f_lrv 0
na = add na 1
end
end
o = fe_lop 110 9 c uint add na 1
for j ulong na bound 16
ir_set o uint add j 1 ar_u 86 add bs j
end
put f_lcp 0 bs
v = ir_res o
if or eq c 173 eq c 174
fe_lval fe_lp1 36 5 0 v 5
ret
end
fe_lval v 9
end

note lcf: only integer-to-integer conversions can trap 5. Float-to-integer conv truncates,
note saturates to the destination range and maps NaN to zero (IR.md s7.3; omc fp_toint).
fn fe_lcf s ulong d ulong to bool
if ne fe_isfloat s 0
ret false
end
ws = fe_twid s
wd = fe_twid d
a = fe_lsg s
b = fe_lsg d
if and a not b
ret true
end
if and not a b
ret le wd ws
end
ret lt wd ws
end


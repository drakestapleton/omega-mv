note @ng front-ir: the accepted unit is then lowered (fe_lout) where the check pass would exit 0
global f_lcur0 ulong 1
global f_lmode ulong 1
global f_sbase ulong 1
global f_tka ulong 1
global f_tkb ulong 1
global f_dexp ulong 1
global f_dsev ulong 1


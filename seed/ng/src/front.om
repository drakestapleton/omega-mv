s = fe_lsg t
if ge c 59
if s
fe_lno
end
fe_lck1 77 7 b
fe_lval fe_lp2 uint sub 82 c t a b t
ret
end
if ge c 43
fe_lval fe_lp2 uint add sub c 43 30 1 a b 1
ret
end
if le c 35
if or s eq t 13
fe_lck2 uint add sub c 33 70 1 a b
end
fe_lval fe_lp2 uint add sub c 33 10 t a b t
ret
end
if le c 37
if eq fe_isfloat t 0
fe_lck1 74 2 b
if and s eq c 36
fe_lck2 75 1 a b
end
end
fe_lval fe_lp2 uint add sub c 36 13 t a b t
ret
end
if le c 40
fe_lval fe_lp2 uint add sub c 38 16 t a b t
ret
end
fe_lck1 77 7 b
if and s eq c 41
fe_lck2 76 1 a b
end
fe_lval fe_lp2 uint add sub c 41 20 t a b t
end


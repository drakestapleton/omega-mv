note ---- OM-2 section 5 abstract types (16; type 64 + index): name, its length, representation type (4 uint,
note 5 ulong), the preserving operations listed (1 rotr, 2 rotl, 4 and, 8 or, 16 xor), 1 when `holds NAME
note dup32` is declared. aw_*: the word reader of the exact-constructor test (place, packed word, length,
note newlines crossed before it) ----
global f_abname ulong 16
global f_ab_len ulong 16
global f_abbase uchar 16
global f_ab_ops ulong 16
global f_abhold uchar 16
global f_nab ulong 1
global f_aw_p ulong 1
global f_aw_w ulong 1
global f_aw_l ulong 1
global f_aw_nl ulong 1

note ---- OM-2 section 6 unsized views (spec 4 slots, 6, erratum E2). An unsized `view T *` / `edit T *`
note name has length 0 in nm_len and its run-time element count in register nm_lr. Parameters take the
note registers x0..x5 by slots: an unsized array two (pointer, then count), every other parameter one
note (pwid, pslot); psl counts the slots of the fn line being read (6 at most, error 9). ul_k / ul_v: the
note count (kind 1 register / 3 number) of argument i of the call at value depth d, at d * 6 + i ----
global f_psl ulong 1
note ---- OM-2 section 6 multi-entry units: nexp `export fn` lines (32 at most, function mode only), fn_exp 1
note for an exported function, expf 1 while an `export fn` line is read. With any export, words 0 .. E-1
note of the code are B to each export in source order and the code starts at byte 176 + 4E ----
global f_nexp ulong 1
global f_expf ulong 1

note ======== leaf helpers ========

note poolc: the i-th register of the pool x0..x6, x8..x15, x17 (x7 is the runtime, x16 scratch)
fn fe_poolc i ulong to ulong
if lt i 7
ret i
end
if lt i 15
ret add i 1
end
ret 17
end

note pwid: the parameter slots of fn table entry p: 2 for an unsized array (pointer, count), else 1
fn fe_pwid p ulong to ulong
k = ulong uchar get ar_m add get ar_rb 35 p
if and or eq k 2 eq k 3 eq ar_w 34 p 0
ret 2
end
ret 1
end

note unsz: 1 when name entry i is an unsized array (nm_len 0, its count in register nm_lr), else 0. A text
note (kind 5) of length 0 (`text e ""`) is sized: its count is the number 0 and it has no count register.
fn fe_unsz i ulong to ulong
if and eq ar_w 7 i 0 ne ar_c 8 i 5
ret 1
end
ret 0
end


note ---- error reporting ----
global f_msg uchar 65536
global f_mc ulong 1

note mflush: complete a diagnostic/query stdout chunk or report compiler output error 2.
fn fe_mflush to void
off = ulong 0
n = get f_mc 0
while lt off n
w = write 1 f_msg off sub n off
if le w 0
exit int 2
end
off = add off ulong w
end
put f_mc 0 0
end

fn fe_mputb b uchar to void
m = get f_mc 0
put f_msg m b
put f_mc 0 add m 1
end

fn fe_mputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
j = i
while gt j 0
j = sub j 1
fe_mputb get d j
end
end

note fail: write "omc: line N: error E" to stderr (fd 2) and exit with the code
fn fe_fail code ulong to void
put f_mc 0 0
fe_mputb 111
fe_mputb 109
fe_mputb 99
fe_mputb 58
fe_mputb 32
fe_mputb 108
fe_mputb 105
fe_mputb 110
fe_mputb 101
fe_mputb 32
fe_mputn add get f_line 0 get f_lbase 0
fe_mputb 58
fe_mputb 32
fe_mputb 101
fe_mputb 114
fe_mputb 114
fe_mputb 111
fe_mputb 114
fe_mputb 32
fe_mputn code
fe_mputb 10
w = write 2 f_msg 0 get f_mc 0
if ne get f_om2 0 0
if eq get f_om2m 0 1
fe_drec code
end
end
if and ne get f_chkmod 0 0 ne get f_chkmod 0 3
fe_diagrec code
end
note A full arena (error 14), and any error of a usage unit, ends with the ng-use record (ar_rec), as omc's
note omc-use record does
if or ne get ar_fl 0 0 eq get f_chkmod 0 3
ar_rec 2
end
exit int code
end

note mputw: the first n bytes (at most 8) of the little-endian packed word w
fn fe_mputw w ulong n ulong to void
i = ulong 0
x = w
while lt i n
fe_mputb uchar and x 255
x = shr x 8
i = add i 1
end
end

note dcol: the 1-based column of byte a in its line
fn fe_dcol a ulong to ulong
j = a
go = true
while go
m = ulong 0
while and go lt m 999999
if eq j 0
go = false
else
if eq ar_ib sub j 1 10
go = false
else
j = sub j 1
end
end
m = add m 1
end
end
ret add sub a j 1
end

note dsev_w: sev= incomplete when the failure is on the end-of-input token (or inside a text literal cut by
note the end), unknown for an undeclared function or struct, else error
fn fe_dsev_w code ulong to void
s = get f_dsev 0
if eq s 0
if eq get f_tk 0 3
s = ulong 1
end
if and eq code 22 ge get f_cur 0 get f_inlen 0
s = ulong 1
end
end
if eq s 1
fe_mputw 7308339910638005865 8
fe_mputw 25972 2
ret
end
if eq s 2
fe_mputw 31093567915781749 7
ret
end
fe_mputw 491496043109 5
end

note dexp_w: expect= the class of token being read (end for an open function at the end of the input)
fn fe_dexp_w code ulong to void
e = get f_dexp 0
if eq code 15
e = ulong 5
end
if or eq code 6 eq code 8
e = ulong 4
end
if eq e 1
fe_mputw 435761734006 5
ret
end
if eq e 2
fe_mputw 1701869940 4
ret
end
if eq e 3
fe_mputw 1701667182 4
ret
end
if eq e 4
fe_mputw 125779768604014 6
ret
end
if eq e 5
fe_mputw 6581861 3
ret
end
if eq e 6
fe_mputw 28550371718161774 7
ret
end
fe_mputw 1685221239 4
end

note dobl_w: obligation= from the code: 27 init, 28 ctor, 29 layout, 21 bounds, 14 growth, 12 regs, else -
fn fe_dobl_w code ulong to void
if eq code 30
fe_mputw 8386654075301556067 8
ret
end
if eq code 27
fe_mputw 1953066601 4
ret
end
if eq code 28
fe_mputw 1919906915 4
ret
end
if eq code 29
fe_mputw 128047730221420 6
ret
end
if eq code 21
fe_mputw 126875187113826 6
ret
end
if and eq code 14 ne get f_dobx 0 0
fe_mputw 1953066601 4
ret
end
if eq code 14
fe_mputw 114849429287527 6
ret
end
if eq code 12
fe_mputw 1936156018 4
ret
end
fe_mputb 45
end

note mputh: one byte as two lowercase hex digits
fn fe_mputh b ulong to void
hi = shr b 4
lo = and b 15
if lt hi 10
fe_mputb uchar add hi 48
else
fe_mputb uchar add hi 87
end
if lt lo 10
fe_mputb uchar add lo 48
else
fe_mputb uchar add lo 87
end
end

note drec: the om2 diag machine record after the human line (spec 1): code, sev, line (the human line),
note col, the half-open byte span of the token being read, expect, found (at most 32 bytes, hex),
note obligation, profile
fn fe_drec code ulong to void
put f_mc 0 0
fe_mputw 7449351137626647919 8
fe_mputw 4424052638528581920 8
fe_mputn code
fe_mputw 263979365152 5
fe_dsev_w code
fe_mputw 67505853393952 6
fe_mputn add get f_line 0 get f_lbase 0
a = get f_tka 0
b = get f_tkb 0
if le b a
b = a
if gt get f_cur 0 a
b = get f_cur 0
end
end
if gt b get f_inlen 0
b = get f_inlen 0
end
fe_mputw 263812244256 5
fe_mputn fe_dcol a
fe_mputw 67544290456352 6
fe_mputn add a get f_sbase 0
fe_mputb 45
fe_mputn add b get f_sbase 0
fe_mputw 4428273620941825312 8
fe_dexp_w code
fe_mputw 17280399158765088 7
if eq a b
fe_mputb 45
end
i = a
while and lt i b lt sub i a 32
fe_mputh ulong ar_ib i
i = add i 1
end
fe_mputw 8386097683628191520 8
fe_mputw 1030647657 4
fe_dobl_w code
fe_mputw 7308332183992823840 8
fe_mputw 11210624683837 6
w = write 2 f_msg 0 get f_mc 0
end



note tok_num: the word at [ts,cur) is [-]decimal, at most 20 digits, from -2^63 to 2^64 - 1 (error 6
note bad number, 8 out of range). tw = its raw 64 bits (a negative one as two's complement); tbig = 1
note when it is 2^63 or more (only a ulong holds it), else 0. As om4's TK_NUM.
note The float-marker scan walks the word in chunks of at most 999999 bytes: a single loop's hidden
note 1000000-pass guard trapped 4 on a decimal word of 1000001 digits, which must refuse with error 6 (#671).
fn fe_tok_num to void
if ne get f_om2 0 0
if ne fe_tok_hex 0
ret
end
end
p = get f_ts 0
e = get f_cur 0
fl = false
i = p
while lt i e
c = sub e i
if gt c 999999
c = ulong 999999
end
for k ulong c
b = ar_ib add i k
if or or or eq b 46 eq b 101 eq b 69 eq b 102
fl = true
end
end
i = add i c
end
if fl
put f_tk 0 5
ret
end
minus = false
if eq ar_ib p 45
minus = true
p = add p 1
end
ndig = sub e p
if eq ndig 0
fe_nfail 6
end
if gt ndig 20
fe_nfail 6
end
v = ulong 0
lim = ulong 1844674407370955161
i = p
while lt i e
d = sub ulong ar_ib i 48
if gt d 9
fe_nfail 6
end
if gt v lim
fe_nfail 8
end
if and eq v lim gt d 5
fe_nfail 8
end
v = add mul v 10 d
i = add i 1
end
half = shl ulong 1 63
put f_tbig 0 0
if minus
if gt v half
fe_nfail 8
end
put f_tw 0 sub ulong 0 v
else
if ge v half
put f_tbig 0 1
end
put f_tw 0 v
end
put f_tk 0 2
end

note tok_text: a text literal starting at the opening quote. tw = first byte offset, tl = source length
note (escapes not yet decoded). Ends at an unescaped '"' on the same line, followed by a blank/end. Err 22.
note (Loops over the input are two loops, the inner under 1000000 passes: om4 has no pass limit.)
fn fe_tok_text to void
put f_cur 0 add get f_cur 0 1
put f_tw 0 get f_cur 0
go = true
while go
n = ulong 0
while and go lt n 999999
if ge get f_cur 0 get f_inlen 0
fe_fail 22
end
b = ar_ib get f_cur 0
if eq b 10
fe_fail 22
end
if eq b 34
go = false
else
put f_cur 0 add get f_cur 0 1
if eq b 92
if ge get f_cur 0 get f_inlen 0
fe_fail 22
end
if eq ar_ib get f_cur 0 10
fe_fail 22
end
put f_cur 0 add get f_cur 0 1
end
end
n = add n 1
end
end
put f_tl 0 sub get f_cur 0 get f_tw 0
put f_cur 0 add get f_cur 0 1
put f_tk 0 4
if lt get f_cur 0 get f_inlen 0
if gt ar_ib get f_cur 0 32
fe_fail 22
end
end
end

note wscan: the first index in [p, e) whose input byte ends a word (32 or below, '(' or ')'), else e; its first 8
note bytes packed little-endian into tw. e is at most inlen and the input is the payload region at word 0
note (ar_rdin), so the bytes are read inline, a word at a time, without ar_ib's check (a call per byte made small
note units 15-22% slower than the fixed input buffer). The input is at most 134217728 bytes (the arena): one
note pass a byte.
fn fe_wscan p ulong e ulong to ulong
q = p
w = ulong 0
y = get ar_m shr p 3
while lt q e bound 134217729
if eq and q 7 0
y = get ar_m shr q 3
end
b = and shr y shl and q 7 3 255
if or le b 32 or eq b 40 eq b 41
put f_tw 0 w
ret q
end
if lt sub q p 8
w = or w shl b shl sub q p 3
end
q = add q 1
end
put f_tw 0 w
ret q
end

note nlat: the first index in [p, e) whose input byte is a newline, else p when p is at or past e, else e (e at most
note inlen; read inline a word at a time as in fe_wscan; one pass a byte)
fn fe_nlat p ulong e ulong to ulong
q = p
y = get ar_m shr p 3
while lt q e bound 134217729
if eq and q 7 0
y = get ar_m shr q 3
end
if eq and shr y shl and q 7 3 255 10
ret q
end
q = add q 1
end
ret q
end

note tok2: a word at cur with first byte c; packs 8 bytes into tw, sets tl and ts. A '"' is a text; a
note first byte '-' or a digit is a number.
fn fe_tok2 c uchar to void
if eq c 34
fe_tok_text
ret
end
put f_ts 0 get f_cur 0
if or eq c 40 eq c 41
put f_tw 0 ulong c
put f_tl 0 1
put f_cur 0 add get f_cur 0 1
put f_tk 0 1
ret
end
p = get f_cur 0
q = fe_wscan p get f_inlen 0
n = sub q p
w = get f_tw 0
put f_cur 0 q
put f_tw 0 w
put f_tl 0 n
put f_tw8 0 w
if and gt n 8 le n 63
if ne c 45
if or lt c 48 gt c 57
note intern the long name (the long-names notes above, omc.om ln_intern): its index k in order of first
note appearance; the packed word is 1 + 256 * k
k = fe_ln_intern get f_ts 0 n
put f_tw 0 add 1 shl k 8
end
end
end
note c is the word's first byte (the byte at ts, which fe_tok read): the number test needs no second read
f = c
isnum = false
if eq f 45
isnum = true
end
if and ge f 48 le f 57
isnum = true
end
if isnum
fe_tok_num
else
put f_tk 0 1
end
end

note bskip: the first index in [p, e) whose input byte is not a blank (space, tab, carriage return), else e; that
note byte into f_bc. Read inline a word at a time as in fe_wscan (e at most inlen); one pass a byte.
fn fe_bskip p ulong e ulong to ulong
q = p
y = get ar_m shr p 3
while lt q e bound 134217729
if eq and q 7 0
y = get ar_m shr q 3
end
b = and shr y shl and q 7 3 255
if not or or eq b 32 eq b 9 eq b 13
put f_bc 0 b
ret q
end
q = add q 1
end
ret q
end

note tok: next word, skipping blanks (space, tab, carriage return); newline is end of line (kind 0) and
note bumps the line number; another byte below 32 is error 16; the end of the input is kind 3. om4 TOK.
fn fe_tok to void
q = fe_bskip get f_cur 0 get f_inlen 0
put f_cur 0 q
if ge q get f_inlen 0
put f_tka 0 get f_inlen 0
put f_tkb 0 get f_inlen 0
put f_tk 0 3
ret
end
c = uchar get f_bc 0
if eq c 10
put f_tka 0 q
put f_tkb 0 add q 1
put f_cur 0 add q 1
put f_line 0 add get f_line 0 1
put f_tk 0 0
ret
end
put f_tka 0 q
put f_tkb 0 add q 1
if lt c 32
fe_fail 16
end
put f_tka 0 q
put f_tkb 0 q
fe_tok2 c
put f_tkb 0 get f_cur 0
end


ret 0
end
if ne ar_ib p 105
ret 0
end
if ne ar_ib add p 1 114
ret 0
end
if gt ar_ib add p 2 32
ret 0
end
q = add p 2
go = true
while go
m = ulong 0
while and go lt m 999999
if ge q get f_inlen 0
go = false
else
if eq ar_ib q 10
go = false
else
q = add q 1
end
end
m = add m 1
end
end
if lt q get f_inlen 0
q = add q 1
end
put f_cur 0 q
put f_line 0 2
ret 1
end















































note ======== executable contract predicates (OM-2, native targets) ========
note Token packs below: Wolfram FromDigits[Reverse[ToCharacterCode[word]],256].
note Contract words are contextual: OM-1 name meanings and keyword-table bytes do not change.
note Explicit native build policy, with syntax and purity checked in both policies.
note om2 debug / om2 release and om2 diag debug / om2 diag release; fmt stays canonical.
fn fe_cp_mode q ulong to ulong
if gt add q 4 get f_inlen 0
ret 0
end
if ne ar_ib q 111
ret 0
end
if ne ar_ib add q 1 109
ret 0
end
if ne ar_ib add q 2 50
ret 0
end
if ne ar_ib add q 3 32
ret 0
end
p = add q 4
m = ulong 1
if le add p 5 get f_inlen 0
if and eq ar_ib p 100 eq ar_ib add p 1 105
if and eq ar_ib add p 2 97 eq ar_ib add p 3 103
if eq ar_ib add p 4 32
p = add p 5
m = ulong 2
end
end
end
end

cb = add mul get f_depth 0 32 8
np = ulong uchar get ar_m add get ar_rb 22 sub fe 1
put ar_m add get ar_rb 59 add cb 18 np
put ar_m add get ar_rb 59 add cb 19 get f_nslot 0

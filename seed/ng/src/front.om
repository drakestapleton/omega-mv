note ======== names and functions ========
note The name table (arena group names, 4), the long names (long, 6) and the functions (fns, 8) grow with the
note arena; each has a chained hash (groups namehash 5, longhash 7, fnhash 9; bucket -> index + 1 of the
note newest entry, f_nm_nx / f_ln_x / f_fn_nx the one before it in the chain) whose buckets double at twice
note as many entries as buckets. omc.om's findname, nm_set, findfn and ln_intern (OmcNoCaps), ported.
global f_nh_b ulong 1
global f_fh_b ulong 1
note f_lhb: the bucket bits of the front-ir lowering's name hash (fe_lfind)
global f_lhb ulong 1

note need: group g is about to use index n; a full arena is error 14 with the ng-use record (fe_fail)
fn fe_need g ulong n ulong to void
if ne ar_need g n 0
fe_fail 14
end
end

note hinit: the first room of the three hash tables (ar_init gave each group 1024 buckets)
fn fe_hinit to void
put f_nh_b 0 10
put f_lh_b 0 10
put f_fh_b 0 10
put f_lhb 0 10
end

note findname: packed name -> its index + 1 among the names in scope (0 none). om4 FINDNAME. The names in
note scope are 0 .. nn - 1 (clim while a pure contract is read), without nglob .. nmlo - 1 while an inlined
note body hides its caller's locals. The lowest such index whose packed name is w is the answer, as the
note old front-to-back scan gave; the chain of w's bucket holds every name below nn, newest first.
fn fe_findname w ulong to ulong
n = get f_nn 0
if ne get f_cpure 0 0
n = get f_clim 0
end
g = get f_nglob 0
lo = get f_nmlo 0
k = get ar_m add get ar_rb 15 ar_hash w get f_nh_b 0
best = ulong 0
while ne k 0 bound 16777217
i = sub k 1
if and lt i n eq ar_w 4 i w
if or lt i g ge i lo
best = k
end
end
k = get ar_m add get ar_rb 14 i
end
ret best
end

note nm_link: name i becomes the newest of its bucket's chain
fn fe_nm_link i ulong to void
h = ar_hash get ar_m add get ar_rb 4 i get f_nh_b 0
put ar_m add get ar_rb 14 i get ar_m add get ar_rb 15 h
put ar_m add get ar_rb 15 h add i 1
end

note nm_unlk: name i, the newest name of its chain (every name above it has left), leaves it. Should a
note chain ever not start with i, the buckets are rebuilt from names 0 .. i - 1 instead.
fn fe_nm_unlk i ulong to void
h = ar_hash get ar_m add get ar_rb 4 i get f_nh_b 0
if eq ar_w 15 h add i 1
put ar_m add get ar_rb 15 h get ar_m add get ar_rb 14 i
else
fe_nm_build i
end
end

note nm_build: empty buckets, then names 0 .. n - 1 linked in order
fn fe_nm_build n ulong to void
ar_gzero 5
i = ulong 0
while lt i n bound 16777217
fe_nm_link i
i = add i 1
end
end

note nm_set: the names in scope become 0 .. v - 1 (every write of nn but addname's): names above v leave
note their chains newest first; names between nn and v (a scope given back) join them again in order
fn fe_nm_set v ulong to void
n = get f_nn 0
if gt v 0
fe_need 4 sub v 1
end
while gt n v bound 16777217
n = sub n 1
fe_nm_unlk n
end
while lt n v bound 16777217
fe_nm_link n
n = add n 1
end
put f_nn 0 v
end

note fn_same: function j is the name w of length l starting at input byte s (the test of the old scan)
fn fe_fn_same j ulong w ulong l ulong s ulong to bool
if ne ar_w 20 j w
ret false
end
if eq and w 255 1
ret true
end
fl = get ar_m add get ar_rb 23 j
if le l 8
ret le fl 8
end
if ne fl l
ret false
end
o = get ar_m add get ar_rb 24 j
k = ulong 8
while lt k l bound 16777217
if ne ar_ib add o k ar_ib add s k
ret false
end
k = add k 1
end
ret true
end

note findfn: packed name w (first 8 bytes, or an interned long name), length l (any value up to 8 for a
note short name), start s in the input (read only for a name over 8 bytes that is not interned) ->
note function index + 1 (0 none), the lowest that matches, as the old scan gave. om4 FINDFN.
fn fe_findfn w ulong l ulong s ulong to ulong
k = get ar_m add get ar_rb 38 ar_hash w get f_fh_b 0
best = ulong 0
while ne k 0 bound 16777217
j = sub k 1
if fe_fn_same j w l s
best = k
end
k = get ar_m add get ar_rb 31 j
end
ret best
end

note fn_link: function f becomes the newest of its bucket's chain; at twice as many functions as buckets
note the buckets double and every function is linked again in order
fn fe_fn_link f ulong to void
h = ar_hash get ar_m add get ar_rb 20 f get f_fh_b 0
put ar_m add get ar_rb 31 f get ar_m add get ar_rb 38 h
put ar_m add get ar_rb 38 h add f 1
if ge add f 1 shl ulong 2 get f_fh_b 0
b = add get f_fh_b 0 1
put f_fh_b 0 b
fe_need 9 sub shl ulong 1 b 1
ar_gzero 9
j = ulong 0
while le j f bound 16777217
h = ar_hash get ar_m add get ar_rb 20 j b
put ar_m add get ar_rb 31 j get ar_m add get ar_rb 38 h
put ar_m add get ar_rb 38 h add j 1
j = add j 1
end
end
end

note ln_hw: the hash word of the n input bytes at s
fn fe_ln_hw s ulong n ulong to ulong
w = ulong 0
i = ulong 0
while lt i n bound 64
w = add mul w 31 ulong ar_ib add s i
i = add i 1
end
ret w
end

note ln_same: long name j is spelled as the n input bytes at s
fn fe_ln_same j ulong s ulong n ulong to bool
if ne ulong ar_c 17 j n
ret false
end
o = get ar_m add get ar_rb 16 j
i = ulong 0
while lt i n bound 64
if ne ar_ib add o i ar_ib add s i
ret false
end
i = add i 1
end
ret true
end

note ln_intern: the index of the long name spelled by the n input bytes at s. A spelling met for the first
note time is appended (indices in order of first appearance, as before) and linked into its chain; at
note twice as many long names as buckets the buckets double and every name is linked again.
fn fe_ln_intern s ulong n ulong to ulong
h = ar_hash fe_ln_hw s n get f_lh_b 0
k = get ar_m add get ar_rb 19 h
while ne k 0 bound 16777217
j = sub k 1
if fe_ln_same j s n
ret j
end
k = get ar_m add get ar_rb 18 j
end
k = get f_ln_n 0
fe_need 6 k
put ar_m add get ar_rb 16 k s
ar_pc 17 k uchar n
put ar_m add get ar_rb 18 k get ar_m add get ar_rb 19 h
put ar_m add get ar_rb 19 h add k 1
put f_ln_n 0 add k 1
if ge add k 1 shl ulong 2 get f_lh_b 0
fe_ln_rehash add k 1
end
ret k
end

note ln_rehash: double the long-name buckets and link long names 0 .. c - 1 again in order
fn fe_ln_rehash c ulong to void
b = add get f_lh_b 0 1
put f_lh_b 0 b
fe_need 7 sub shl ulong 1 b 1
ar_gzero 7
j = ulong 0
while lt j c bound 16777217
h = ar_hash fe_ln_hw ar_w 16 j ulong uchar get ar_m add get ar_rb 17 j b
put ar_m add get ar_rb 18 j get ar_m add get ar_rb 19 h
put ar_m add get ar_rb 19 h add j 1
j = add j 1
end
end


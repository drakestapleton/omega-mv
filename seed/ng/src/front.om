note s_unr: the end of an unrolled body: read it again with the next value of i, or close the block
fn fe_s_unr i ulong to void
fe_eol
it = add get ar_m add get ar_rb 49 i 1
if lt it ar_w 50 i
put ar_m add get ar_rb 49 i it
put ar_m add get ar_rb 9 get ar_m add get ar_rb 42 i it
fe_nm_set get ar_m add get ar_rb 51 i
put f_held 0 get ar_m add get ar_rb 52 i
put f_nslot 0 get ar_m add get ar_rb 52 i
put f_dead 0 0
put f_cur 0 get ar_m add get ar_rb 47 i
put f_line 0 get ar_m add get ar_rb 48 i
fe_cp_head get f_cur 0 get f_line 0
fe_cp_skip
ret
end
put ar_m add get ar_rb 49 i it
put ar_m add get ar_rb 9 get ar_m add get ar_rb 42 i it
fe_nm_set get ar_m add get ar_rb 51 i
put f_nslot 0 get ar_m add get ar_rb 52 i
fe_cp_head get ar_m add get ar_rb 47 i get ar_m add get ar_rb 48 i
put f_nb 0 i
fe_nm_set get ar_m add get ar_rb 44 i
put f_held 0 get ar_m add get ar_rb 45 i
put f_dead 0 0
put f_fzone 0 sub get f_fzone 0 1
end

note fn_tail: the end of a fn line: an optional inline (OM-2), then the line ends; records the body start
fn fe_fn_tail f ulong to void

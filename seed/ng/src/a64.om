const a_fmovdx ulong 148

note the form table. Sections: C6.2.6 ADD, C6.2.458 SUB, C6.2.8 ADDS, C6.2.465 SUBS, C6.2.15 AND, C6.2.302 ORR,
note C6.2.156 EOR, C6.2.17 ANDS, C6.2.32 BIC, C6.2.300 ORN (shifted register; 32-bit forms clear bit 31)
fn a6_formdp to void
a6_fset 0 0x8b000000 1
a6_fset 1 0x0b000000 1
a6_fset 2 0xcb000000 1
a6_fset 3 0x4b000000 1
a6_fset 4 0xab000000 1
a6_fset 5 0x2b000000 1
a6_fset 6 0xeb000000 1
a6_fset 7 0x6b000000 1
a6_fset 8 0x8a000000 1
a6_fset 9 0x0a000000 1
a6_fset 10 0xaa000000 1
a6_fset 11 0x2a000000 1
a6_fset 12 0xca000000 1
a6_fset 13 0x4a000000 1
a6_fset 14 0xea000000 1
a6_fset 15 0x8a200000 1
a6_fset 16 0xaa200000 1
note C6.2.293 MUL (MADD Ra=31), C6.2.370 SMULH, C6.2.505 UMULH, C6.2.366 SDIV, C6.2.490 UDIV, C6.2.271 LSLV,
note C6.2.274 LSRV, C6.2.21 ASRV, C6.2.343 RORV
a6_fset 17 0x9b007c00 1
a6_fset 18 0x1b007c00 1
a6_fset 19 0x9b407c00 1
a6_fset 20 0x9bc07c00 1
a6_fset 21 0x9ac00c00 1

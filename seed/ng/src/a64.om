note a64: the Omega NG AArch64 back end (lane ng-a64), one unit of the ng compiler (DECISIONS.md D1b): ng is the
note concatenation listed in seed/ng/ng.units, so this file has no fn main; its functions are a6_*, its globals a_*.
note Design: seed/ng/a64/DESIGN.md. Instruction bits: Arm ARM DDI 0487 M.d, section named at each form (the source
note of seed/rung2/table.s2). Input is the payload main read into i_in (ir.om) from offset 0, a_inlen bytes; main's
note hooks are a6_mode m (does the mode line name a mode of this unit) and a6_run (run it). `@ng a64-enc` takes an
note encoder case list (seed/ng/a64/tests/enc.cases after its mode line) and writes one little-endian word per case.
note OM-2 (hex words) comes from the unit's first line, at the top of ir.om.

note ---- input and output pools ----
global a_inlen ulong 1
global a_code uchar 16777216
global a_cn ulong 1

note a_emsg: line 0 the prefix, line k the class of refusal k (a6_die c k n)
text a_emsg "a64:\n input unreadable\n input too large\n output failed\n bad encoder case at line\n unsupported\n immediate out of range\n branch out of range\n IR refused (exit status = IR.md s11 class) at payload byte\n reserved operand value\n"

note ---- fatal refusal: one stderr line `a64: <message>[ <n>]` and exit code c (nothing on stdout) ----
fn a6_lst k ulong to ulong
note byte offset of line k of a_emsg
i = ulong 0
j = ulong 0
while and lt j k lt i len a_emsg bound 4096
if eq get a_emsg i 10
j = add j 1
end
i = add i 1
end
ret i
end

global a_nbuf uchar 24

fn a6_pnum v ulong to void
p = ulong 23
put a_nbuf 23 10
x = v
go = true
while go bound 24
p = sub p 1
put a_nbuf p uchar add rem x 10 48
x = div x 10
if eq x 0
go = false
end
end
p = sub p 1
put a_nbuf p 32
w = write 2 a_nbuf p sub 24 p
end

fn a6_die c ulong k ulong n ulong to void
w = write 2 a_emsg 0 4
o = a6_lst k
e = sub a6_lst add k 1 1
w2 = write 2 a_emsg o sub e o
if ne n 18446744073709551615
a6_pnum n
else
w3 = write 2 a_emsg 4 1
end
exit int c
end

note ---- output: little-endian words into a_code, then all of a_code to stdout ----
fn a6_emitw w ulong to void
o = get a_cn 0
if gt add o 4 len a_code
a6_die 4 3 18446744073709551615
end
put a_code o uchar and w 255
put a_code add o 1 uchar and shr w 8 255
put a_code add o 2 uchar and shr w 16 255
put a_code add o 3 uchar and shr w 24 255
put a_cn 0 add o 4
end

fn a6_flush to void
p = ulong 0
n = get a_cn 0
while lt p n bound 100000000
k = write 1 a_code p sub n p
if le k 0
a6_die 4 3 18446744073709551615
end
p = add p ulong k
end
end

note ======== encoder: one 32-bit A64 instruction word per form ========
note A form is a row of the table set by a6_init: base word (the encoding diagram with every operand field 0,
note Arm ARM DDI 0487 M.d section in the note above each group) and an operand kind. a6_enc f a b c d e builds the
note word from up to five operands. Register numbers are 0..31 (31 is ZR or SP as the form says). An operand that
note does not fit its field is refused (a6_die 6 or 7), never masked; so is an in-field value whose encoding the
note form reserves (a6_die 9, a6_rsv). The names in a_fnam are the names the encoder case list
note (seed/ng/a64/tests/enc.cases) uses, in form id order.
note Kinds: 1 R3 (d n m sh amt): base | d | n<<5 | m<<16 | sh<<22 | amt<<10; 2 R4 (d n m a): | a<<10;
note 3 EXT (d n m opt amt): | opt<<13 | amt<<10; 4 IMM12 (d n imm sh): | imm<<10 | sh<<22; 5 LOGI (d n value);
note 6 MOVW (d imm16 hw): | imm<<5 | hw<<21; 7 BFM (d n immr imms); 8 CSEL (d n m cond): | cond<<12;
note 9 LDST (t n imm12); 10 LDSR (t n m s): register offset LSL, s = scaled; 11 PAIR (t t2 n off): signed
note byte offset /8 at bit 15; 12 B26 (words); 13 BCOND (cond words); 14 CB (t words); 15 TB (t bit words);
note 16 BR (n); 17 SVC (imm16); 18 ADR (d bytes); 19 R2 (d n); 20 FCMP (n m); 21 EXTR (d n m lsb).
note 22 RT (t): | t (MSR FPCR).
note Signed operands (distances, pair offsets) are two's complement ulongs.

global a_fbase ulong 256
global a_fkind uchar 256
global a_nform ulong 1

text a_fnam "addx addw subx subw addsx addsw subsx subsw andx andw orrx orrw eorx eorw andsx bicx ornx mulx mulw smulh umulh sdivx udivx sdivw udivw lslvx lsrvx asrvx rorvx lslvw lsrvw asrvw maddx msubx addxe subsxe addxi addwi subxi subwi addsxi subsxi subswi addswi andxi orrxi eorxi andsxi andwi orrwi eorwi movzx movnx movkx movzw movnw ubfmx sbfmx ubfmw sbfmw extrx cselx csincx csinvx csnegx strb ldrb ldrsbx strh ldrh ldrshx strw ldrw ldrsw strx ldrx strs ldrs strd ldrd strbr ldrbr ldrsbxr strhr ldrhr ldrshxr strwr ldrwr ldrswr strxr ldrxr strsr ldrsr strdr ldrdr stpx ldpx stpxpre ldpxpre stpxpost ldpxpost stpd ldpd b bl bcond cbzx cbnzx cbzw cbnzw tbz tbnz ret br blr svc adr faddd fsubd fmuld fdivd fmaxd fmind fmaxnmd fminnmd fadds fsubs fmuls fdivs fmaxs fmins fmaxnms fminnms fsqrtd fabsd fnegd fmovd fsqrts fabss fnegs fmovs fcmpd fcmps fmaddd fmadds fcvtds fcvtsd fmovxd fmovdx fmovws fmovsw scvtfdx ucvtfdx scvtfsx ucvtfsx fcvtzsxd fcvtzuxd fcvtzsxs fcvtzuxs rorvw fcseld fcsels msrfpcr"

fn a6_fset i ulong b ulong k ulong to void
put a_fbase i b
put a_fkind i uchar k
if ge i get a_nform 0
put a_nform 0 add i 1
end
end


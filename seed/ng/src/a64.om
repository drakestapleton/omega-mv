a6_fset 28 0x9ac02c00 1
a6_fset 29 0x1ac02000 1
a6_fset 30 0x1ac02400 1
a6_fset 31 0x1ac02800 1
note C6.2.275 MADD, C6.2.291 MSUB
a6_fset 32 0x9b000000 2
a6_fset 33 0x9b008000 2
note C6.2.4 ADD (extended register), C6.2.463 SUBS (extended register)
a6_fset 34 0x8b200000 3
a6_fset 35 0xeb200000 3
note C6.2.5 ADD, C6.2.457 SUB, C6.2.7 ADDS, C6.2.464 SUBS (immediate)
a6_fset 36 0x91000000 4
a6_fset 37 0x11000000 4
a6_fset 38 0xd1000000 4
a6_fset 39 0x51000000 4
a6_fset 40 0xb1000000 4
a6_fset 41 0xf1000000 4

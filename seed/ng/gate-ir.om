note run scratch tool t with the one argument scratch word i, stdin the same file, stdout and stderr
note to scratch words o and e; its exit code (gt_spawn)
fn gt_run t ulong i ulong o ulong e ulong to ulong
gt_ps i
fi = gt_rdonly
gt_aclr
gt_ps t
gt_apa
gt_ps i
gt_apa
gt_ps o
fo = gt_wronly
gt_ps e
fe = gt_wronly
ret gt_spawn fi fo fe
end
note R NAME: NAME.oir assembled, accepted by ngcheck and run by ngrun; NAME.om compiled by OMC and run;
note exit status, stdout and stderr must be equal (D9 differential)
fn gt_rcase to void
a = gt_name
b = get q_n 19
if not gt_asm a b
ret
end
gt_ps 23
x = gt_tool 2 20
if ne x 0
gt_failv 7 x
ret
end
gt_pfx a b 33
if not gt_bodyb 34
gt_fail0 91
ret
end
x = gt_run 31 23 20 21
y = gt_run 34 23 35 36
if ne x y
gt_fail 87
if eq get q_n 14 0
gt_num x
gt_say 88
gt_num y
gt_nl
end
ret
end
if not gt_fcmp 20 35
gt_fail0 89
ret
end
if not gt_fcmp 21 36
gt_fail0 90
end
end
note ---- generated inputs (IR.md s12 capacities) ------------------------------------------------
note write generator [a, b) of cases (messages 72..81) to scratch word w, after "@ng ir-copy\n" when
note pre; false for an unknown name
fn gt_gen a ulong b ulong pre bool w ulong to bool
g = gt_gid a b
if eq g 0
ret false
end
n = gt_gbuild g
gt_ps w
fd = gt_wronly
if lt fd 0
ret false
end
ok = true
if pre
ok = eq write fd q_irc 0 len q_irc long len q_irc
end
if ok
ok = gt_wrfd fd n
end
if and ok eq g 73
ok = eq write fd q_hex 10 1 1
end
r = fclose fd
ret ok
end
fn gt_gid a ulong b ulong to ulong
for i ulong 10
if gt_gis a b add 72 i
ret add 72 i
end
end
ret 0
end
fn gt_gis a ulong b ulong g ulong to bool
k = ulong get q_ml g
if ne sub b a k
ret false
end
m = ulong get q_mo g
for j ulong k bound 64
if ne get q_cs add a j get q_m add m j
ret false
end
end
ret true
end
fn gt_wrfd fd int n ulong to bool
o = ulong 0
while lt o n bound 16777217
x = write fd q_b1 o sub n o
if le x 0
ret false
end
o = add o ulong x
end
ret true
end
note build generator g into b1; its length
fn gt_gbuild g ulong to ulong
if le g 73
ret gt_gfull
end
if eq g 74
ret gt_gtyp
end
put q_n 26 0
gt_gs 53
if eq g 75
gt_gty 65536
end
if eq g 76
gt_gty 65537
end
if eq g 77
gt_ggl
end
if eq g 78
gt_gfn
end
if eq g 79
gt_gbl
end
if eq g 80
gt_gfp
end
if eq g 81
gt_gbp
end
ret get q_n 26
end
fn gt_gc c ulong to void
n = get q_n 26
put q_b1 n uchar c
put q_n 26 add n 1
end
fn gt_gs i ulong to void
s = ulong get q_mo i
for j ulong ulong get q_ml i bound 128
gt_gc ulong get q_m add s j
end
end
fn gt_gn v ulong to void
if ge v 10
gt_gn div v 10
end
gt_gc add 48 rem v 10
end
fn gt_zero n ulong to void
for j ulong n bound 16777216
put q_b1 j 0
end
end
fn gt_put4 p ulong v ulong to void
for j ulong 4
put q_b1 add p j uchar and shr v mul j 8 255
end
end
note the 24-byte header (s3)
fn gt_ghdr to void
s = ulong get q_mo 83
for j ulong ulong get q_ml 83 bound 64
put q_b1 j get q_m add s j
end
put q_b1 7 9
s = ulong get q_mo 84
for j ulong ulong get q_ml 84 bound 64
put q_b1 add 8 j get q_m add s j
end
end
note full: a unit of exactly 16777216 bytes (one ARRAY u8 type, one global of 16777166 data bytes, no
note functions); over is full and one byte more
fn gt_gfull to ulong
gt_zero len q_b1
gt_ghdr
gt_put4 24 1
put q_b1 28 2
gt_put4 29 2
gt_put4 33 16777166
gt_put4 37 1
gt_put4 41 32
put q_b1 45 1
ret len q_b1
end
note types: 65537 populated ARRAY u8 type entries, no globals, no functions
fn gt_gtyp to ulong
n = add ulong 36 mul ulong 65537 9
gt_zero n
gt_ghdr
gt_put4 24 65537
for j ulong 65537
p = add 28 mul j 9
put q_b1 p 2
gt_put4 add p 1 2
gt_put4 add p 5 add j 1
end
ret n
end
fn gt_gty k ulong to void
for j ulong k bound 65537
gt_gs 54
gt_gn add j 32
gt_gs 55
gt_gn add j 1
gt_gc 10
end
end
fn gt_ggl to void
gt_gs 56
for j ulong 65537
gt_gs 57
gt_gn j
gt_gs 58
end
end
fn gt_gfn to void
for j ulong 65537
gt_gs 59
gt_gn j
gt_gs 60
end
end
fn gt_gbl to void
gt_gs 61
gt_gs 62
for i ulong 65536
j = add i 1
gt_gs 63
gt_gn j
gt_gs 64
gt_gn j
gt_gs 65
gt_gn j
gt_gc 10
end
gt_gs 71
end
fn gt_gfp to void
gt_gs 66
for i ulong 65537
gt_gs 64
gt_gn add i 1
gt_gs 67
end
gt_gs 68
end
fn gt_gbp to void
gt_gs 61
gt_gs 69
for i ulong 65536
gt_gs 64
gt_gn add i 2
gt_gs 67
end
gt_gs 70
end
note read up to m bytes of fd into b1 (k 1) or b2 (k 2); the count (short only at end of file)
fn gt_rdn fd int k ulong m ulong to ulong
n = ulong 0
while lt n m bound 1048577
x = long 0
if eq k 1
x = read fd q_b1 n sub m n
else
x = read fd q_b2 n sub m n
end
if le x 0
ret n
end
n = add n ulong x
end
ret n
end
note scratch files w1 and w2 hold the same bytes (any size)
fn gt_fcmp w1 ulong w2 ulong to bool
gt_ps w1
f1 = gt_rdonly
gt_ps w2
f2 = gt_rdonly
ok = and ge f1 0 ge f2 0
dn = false
while and ok not dn bound 4096
a = gt_rdn f1 1 1048576
b = gt_rdn f2 2 1048576
if ne a b
ok = false
else
if eq a 0
dn = true
end
ok = gt_eqn a
end
end
gt_fclo f1
gt_fclo f2
ret ok
end
fn gt_eqn n ulong to bool
for j ulong n bound 1048576
if ne get q_b1 j get q_b2 j
ret false
end
end
ret true
end
note ---- the pin check of ngbuild ----------------------------------------------------------------
note ng.units with its first digest digit changed: ngbuild build must refuse it (exit 3, "ngbuild: sha256
note mismatch seed/ng/src/ir.om have <sha256 of the file>") before it runs the compiler (scratch nope,
note which does not exist) or writes its output (scratch must)
fn gt_badpin to void
put q_n 10 add get q_n 10 1
gt_pr 30
if not gt_slurp 1
gt_bpf 512
ret
end
n = get q_n 5
for j ulong n bound 16777216
put sh_dat j get q_b1 j
end
sh_all n
gt_xclr
gt_xs 46
for j ulong 32
x = ulong get sh_dig j
gt_xc ulong get q_hex shr x 4
gt_xc ulong get q_hex and x 15
end
gt_xc 10
gt_pr 12
if not gt_slurp 1
gt_bpf 512
ret
end
if eq get q_b1 0 48
put q_b1 0 49
else
put q_b1 0 48
end
gt_ps 27
if not gt_spill get q_n 5
gt_bpf 512
ret
end
gt_ps 29
r = unlink q_pa 0 get q_n 0
gt_aclr
gt_ps 1
gt_apa
gt_aw 17
gt_ps 28
gt_apa
gt_ps 27
gt_apa
gt_ps 29
gt_apa
gt_ps 27
fi = gt_rdonly
gt_ps 20
fo = gt_wronly
gt_ps 21
fe = gt_wronly
x = gt_spawn fi fo fe
if ne x 3
gt_bpf x
ret
end
if not gt_xok 21
gt_bpf x
ret
end
gt_ps 29
fd = gt_rdonly
if ge fd 0
gt_fclo fd
gt_bpf x
end
end
fn gt_bpf x ulong to void
put q_n 11 add get q_n 11 1
gt_say 0
gt_say 41
gt_say 42
gt_c 32
gt_num x
gt_nl
end
note one case line at the cursor; returns false at the end of the file
fn gt_case to bool
if ge get q_n 8 get q_n 7
ret false
end
put q_n 13 get q_n 8
put q_n 12 0
k = gt_pk
gt_adv
if eq k 35
gt_eol
ret true
end
if eq k 10
ret true
end
put q_n 10 add get q_n 10 1
if eq k 84
gt_tcase
else
if eq k 83
gt_scase
else
if or eq k 77 or eq k 67 eq k 65
gt_mcase k
else
if eq k 82
gt_rcase
else
if eq k 68
gt_dcase
else
if eq k 71
gt_gcase
else
gt_fail0 13
end
end
end
end
end
end
if ne get q_n 12 0
put q_n 11 add get q_n 11 1
end
gt_eol
ret true
end
note ---- negative controls of the gate ----------------------------------------------------------------
note run the first T line of cases again with a broken expectation (mode 1 exit + 1, mode 2 offset + 1,
note mode 3 a round-trip text the fixture does not equal); the case must fail
fn gt_ctl md ulong to void
gt_fkclr
put q_n 14 1
put q_n 12 0
put q_n 8 0
while ne gt_pk 84 bound 1048576
gt_eol
end
put q_n 13 get q_n 8
gt_adv
a = gt_name
b = get q_n 19
ex = gt_dec
off = gt_dec
if eq md 1
s = gt_asm a b
gt_ps 23
gt_verdict 2 add ex 1 off
end
if eq md 2
gt_ctl2 a b
end
if eq md 3
gt_ctl3 a b
end
put q_n 14 0
if eq get q_fk gt_ctlm md 0
put q_n 11 add get q_n 11 1
gt_say 0
gt_say 14
gt_num md
gt_say 85
gt_nl
end
end
note the check each control must trip: 1 ngcheck exit, 2 refusal line, 3 round trip text
fn gt_ctlm md ulong to ulong
if eq md 1
ret 7
end
if eq md 2
ret 38
end
ret 6
end
fn gt_fkclr to void
for j ulong 128
put q_fk j 0
end
end
note mode 2 uses the first refusal line (exit != 0)
fn gt_ctl2 a ulong b ulong to void
put q_n 8 0
ex = ulong 0
a2 = ulong 0
b2 = ulong 0
off = ulong 0
while eq ex 0 bound 4096
while ne gt_pk 84 bound 1048576
gt_eol
end
gt_adv
a2 = gt_name
b2 = get q_n 19
ex = gt_dec
off = gt_dec
end
s = gt_asm a2 b2
gt_ps 23
gt_verdict 2 ex add off 1
end
fn gt_ctl3 a ulong b ulong to void
s = gt_asm a b
gt_ps 23
x = gt_tool 4 24
gt_ps 24
s = gt_slurp 1
n = get q_n 5
put q_b1 sub n 2 uchar xor get q_b1 sub n 2 1
gt_pfix a b
s = gt_slurp 2
if not gt_same
gt_fail0 6
end
end
note a tool mutant id (gt_msel): rebuild ngcheck with it and rerun every case quietly; it is killed when
note its named check fails at least once (1 ngcheck exit, 2 witness line, 3 refusal line, 4 run exits
note differ: x-fuel ends instead of trapping); otherwise
note the gate fails. The correct ngcheck is rebuilt afterwards.
fn gt_mrun id ulong to void
c10 = get q_n 10
c11 = get q_n 11
put q_n 20 id
ok = gt_mbuild id
put q_n 20 0
if not ok
put q_n 11 add c11 1
gt_say 0
gt_say gt_mlab id
gt_say 24
gt_nl
ret
end
gt_fkclr
put q_n 14 1
put q_n 11 0
put q_n 8 0
while gt_case bound 65536
end
k = get q_n 11
nk = get q_fk gt_mnam id
put q_n 14 0
put q_n 10 c10
put q_n 11 c11
if not gt_mbuild id
put q_n 11 add c11 1
gt_say 0
gt_say 1
gt_nl
ret
end
if eq nk 0
put q_n 11 add c11 1
gt_say 0
gt_say gt_mlab id
gt_say 47
gt_num k
gt_nl
ret
end
gt_say 26
gt_say gt_mlab id
gt_say 25
gt_num nk
gt_nl
end
fn gt_mbuild id ulong to bool
if eq id 4
ret gt_build 30 32 31
end
ret gt_build 6 8 2
end
fn gt_mlab id ulong to ulong
if eq id 1
ret 22
end
if eq id 2
ret 43
end
if eq id 4
ret 86
end
ret 44
end
fn gt_mnam id ulong to ulong
if eq id 1
ret 7
end
if eq id 2
ret 37
end
if eq id 4
ret 87
end
ret 38
end
fn main to int
gt_init
if ne argcnt 3
gt_say 18
gt_nl
ret 2
end
r = argread 1 q_omc 0 4095
if lt r 1
ret 2
end
put q_n 1 ulong r
r = argread 2 q_scr 0 4094
if lt r 1
ret 2
end
n = ulong r
x = makedir q_scr 0 n 448
if and ne x 0 ne x -17
gt_say 19
gt_nl
ret 2
end
put q_scr n 47
put q_n 2 add n 1
if not gt_tools
gt_say 0
gt_say 1
gt_nl
ret 3
end
if not gt_table
put q_n 11 1
gt_say 0
gt_say 2
gt_nl
end
gt_pr 14
gt_pw 15
fd = gt_rdonly
if lt fd 0
ret 2
end
k = read fd q_cs 0 len q_cs
r = fclose fd
if le k 0
ret 2
end
put q_n 7 ulong k
gt_badpin
put q_n 8 0
while gt_case bound 65536
end
for md ulong 3
gt_ctl add md 1
end
for id ulong 4
gt_mrun add id 1
end
f = get q_n 11
if eq f 0
gt_say 15
gt_num get q_n 10
gt_nl
ret 0
end
gt_say 16
gt_num f
gt_say 17
gt_num get q_n 10
gt_nl
ret 1
end

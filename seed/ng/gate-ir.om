if not gt_slurp 1
gt_fail0 21
ret
end
n = get q_n 5
if eq k 77
if ge p n
gt_fail0 13
ret
end
put q_b1 p uchar v
end
if eq k 67
n = p
end
if eq k 65
put q_b1 n uchar p
n = add n 1
end
gt_ps 22
if not gt_spill n
gt_fail0 21
ret
end
gt_ps 22
gt_verdict 2 ex off
gt_ps 22
gt_verdict 4 ex off
gt_ngchk n ex off
end
note D EXIT OFF: stdin is the directory seed/ng/tests/ir

note G GEN TOOL EXIT OFF: generated input GEN (gt_gen) to TOOL: c ngcheck, d ngdis, n ng ir-copy,
note a ngas (OFF a line), r ngas then ngdis (the text must come back), x ngrun (refusals only)
fn gt_gcase to void
a = gt_name
b = get q_n 19
t = gt_name
tl = ulong get q_cs t
ex = gt_dec
off = gt_dec
if not gt_gen a b eq tl 110 22
gt_fail0 45
ret
end
gt_ps 22
if eq tl 99
gt_verdict 2 ex off
ret
end
if eq tl 100
gt_verdict 4 ex off
ret
end
if eq tl 110
x = gt_tool 5 20
if eq x 0
s = gt_gen a b false 26
end
gt_ngv x ex off
ret
end
if eq tl 97
x = gt_tool 3 23
if ne x ex
gt_failv 4 x
ret
end
if ne ex 0
s = gt_refok 3 ex off 23
end
ret
end
if eq tl 114
gt_grt
ret
end
if eq tl 120
x = gt_run 31 22 20 21
if ne x ex
gt_failv 87 x
ret
end
s = gt_refok 6 ex off 20
ret
end
gt_fail0 13
end
fn gt_grt to void
x = gt_tool 3 23
if ne x 0
gt_failv 4 x
ret
end
gt_ps 23
x = gt_tool 4 24
if ne x 0
gt_failv 5 x
ret
end
if not gt_fcmp 22 24

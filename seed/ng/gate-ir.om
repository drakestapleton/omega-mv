note SPDX-License-Identifier: Apache-2.0
note seed/ng/gate-ir.om: the M0 gate of the ΩIR spec and its tools (seed/ng/IR.md). Owner: ng-ir lane.
note Build: cat seed/ng/sha256.om seed/ng/gate-ir.om | seed/out/omc > gate-ir
note Run from the repository root: gate-ir OMC SCRATCH   (SCRATCH is created if absent)
note 1. builds ngbuild, ngcheck, ngas, ngdis with OMC, then ng through `ngbuild build` (pins of ng.units)
note 2. `ngcheck --table` must equal seed/ng/hostwords.tsv byte for byte
note 3. every line of seed/ng/tests/ir/cases (format in that file): text round trip ngdis(ngas(t)) == t,
note    ngcheck class and offset, ACCEPT digest == sha256 of the binary (sha256.om), ng ir-copy identity,
note    ngas syntax refusals, byte mutants judged by ngcheck and ngdis alike, an unreadable stdin
note 4. negative controls of the gate itself: a wrong exit, a wrong offset and a wrong round-trip text
note    must each be detected as a mismatch ("FAIL negative control N" otherwise).
note 5. a tool mutant: ngcheck rebuilt with load and store typing dispatched away (q_mu0 -> q_mu1) must
note    fail at least one case ("ok mutant ngcheck: killed by=K"; "FAIL mutant ngcheck: ..." otherwise).
note Output: one line per failure, then "NGIRGATE PASS cases=N" (exit 0) or "NGIRGATE FAIL failed=K
note cases=N" (exit 1); usage or scratch failure exit 2, a tool that does not build exit 3.
note Globals q_*, functions gt_*; sha256.om supplies sh_dat, sh_all, sh_dig.
text q_w "seed/ng/ ngbuild ngcheck ngas ngdis ng sha256.om ngbuild.om ngcheck.om ngtxt.om ngas.om ngdis.om ng.units hostwords.tsv tests/ir/ cases .oir build --table src.om out err in bin txt tests/ir "
text q_m "FAIL |build|table|case|: ngas exit|: ngdis exit|: round trip text differs|: ngcheck exit|: offset|: ACCEPT digest|: ir-copy exit|: ir-copy bytes differ|: ngas syntax line|: malformed case|negative control |NGIRGATE PASS cases=|NGIRGATE FAIL failed=| cases=|usage: gate-ir OMC SCRATCH|scratch unusable|: ngdis exit|: unreadable fixture|mutant ngcheck: |survived every case|not built|killed by=|ok |"
note the tool mutant: ngcheck with load and store typing dispatched away (same length)
text q_mu0 "\nif or eq op 42 eq op 43\n"
text q_mu1 "\nif or eq op 99 eq op 99\n"
text q_irc "@ng ir-copy\n"
text q_hex "0123456789abcdef"
global q_wo uint 64
global q_wl uint 64
global q_mo uint 64
global q_ml uint 64
global q_omc uchar 4096
global q_scr uchar 4096
global q_pa uchar 8192
global q_av uchar 16384
global q_b1 uchar 16777216
global q_b2 uchar 16777216
global q_cs uchar 1048576
global q_o uchar 4096
global q_stb uchar 4
global q_n ulong 32
note q_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc,
note 5 b1 length, 6 b2 length, 7 cases length, 8 cases cursor, 9 out length, 10 cases run,
note 11 failures, 12 current case failed, 13 case line start, 14 control mode, 15 expected exit,
note 16 expected offset (or line), 17 offset present, 18 last child exit
note ---- words, output ----------------------------------------------------------------------------
fn gt_init to void
w = ulong 0
s = ulong 0
for i ulong len q_w
if eq get q_w i 32
put q_wo w uint s
put q_wl w uint sub i s
w = add w 1
s = add i 1
end
end
w = 0
s = 0
for i ulong len q_m
if eq get q_m i 124
put q_mo w uint s
put q_ml w uint sub i s
w = add w 1
s = add i 1
end
end
end
fn gt_c b ulong to void
n = get q_n 9
if lt n len q_o
put q_o n uchar b
put q_n 9 add n 1
end
end
fn gt_nl to void
gt_c 10
r = write 1 q_o 0 get q_n 9
put q_n 9 0
end
fn gt_say i ulong to void
s = ulong get q_mo i
for j ulong ulong get q_ml i bound 64
gt_c ulong get q_m add s j
end
end
fn gt_num v ulong to void
if ge v 10
gt_num div v 10
end
gt_c add 48 rem v 10
end
note echo the current case line
fn gt_line to void
p = get q_n 13
while lt p get q_n 7 bound 4096
c = ulong get q_cs p
if eq c 10
ret
end
gt_c c
p = add p 1
end
end
note a failure of the current case: FAIL <case line><message i>[ value]
fn gt_fail i ulong to void
put q_n 12 1
if ne get q_n 14 0
ret
end
gt_say 0
gt_line
gt_say i
end
fn gt_failv i ulong v ulong to void
gt_fail i
if eq get q_n 14 0
gt_c 32
gt_num v
gt_nl
end
end
fn gt_fail0 i ulong to void
gt_fail i
if eq get q_n 14 0
gt_nl
end
end
note ---- paths ----------------------------------------------------------------------------------
fn gt_pclr to void
put q_n 0 0
end
fn gt_pc c ulong to void
n = get q_n 0
put q_pa n uchar c
put q_n 0 add n 1
end
fn gt_pw i ulong to void
s = ulong get q_wo i
for j ulong ulong get q_wl i bound 64
gt_pc ulong get q_w add s j
end
end
note scratch file word i
fn gt_ps i ulong to void
gt_pclr
for j ulong get q_n 2 bound 4096
gt_pc ulong get q_scr j
end
gt_pw i
end
note repository file seed/ng/ + word i
fn gt_pr i ulong to void
gt_pclr
gt_pw 0
gt_pw i
end
note fixture seed/ng/tests/ir/<name>.oir, the name at cases [a, b)
fn gt_pfix a ulong b ulong to void
gt_pclr
gt_pw 0
gt_pw 14
for j ulong sub b a bound 256
gt_pc ulong get q_cs add a j
end
gt_pw 16
end
fn gt_open fl ulong to int
r = fopen q_pa 0 get q_n 0 int fl 420
if lt r 0
ret -1
end
ret int r
end
fn gt_rdonly to int
ret gt_open 524288
end
fn gt_wronly to int
ret gt_open 524865
end
note ---- whole files ----------------------------------------------------------------------------
note read the file at q_pa into b1 (k 1) or b2 (k 2); false when unreadable or larger than the buffer
fn gt_slurp k ulong to bool
fd = gt_rdonly
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = long 0
if eq k 1
x = read fd q_b1 n sub len q_b1 n
else
x = read fd q_b2 n sub len q_b2 n
end
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len q_b1
ok = false
break
end
end
r = fclose fd
put q_n add 4 k n
ret ok
end
note write b1[0, n) to the file at q_pa
fn gt_spill n ulong to bool
fd = gt_wronly
if lt fd 0
ret false
end
o = ulong 0
while lt o n bound 16777217
x = write fd q_b1 o sub n o
if le x 0
r = fclose fd
ret false
end
o = add o ulong x
end
r = fclose fd
ret true
end
fn gt_same to bool
n = get q_n 5
if ne n get q_n 6
ret false
end
for j ulong n bound 16777216
if ne get q_b1 j get q_b2 j
ret false
end
end
ret true
end
note ---- children -------------------------------------------------------------------------------
fn gt_aclr to void
put q_n 3 2
put q_n 4 0
end
fn gt_aend n ulong to void
p = get q_n 3
put q_av p uchar and n 255
put q_av add p 1 uchar shr n 8
put q_n 3 add p add n 2
c = add get q_n 4 1
put q_n 4 c
put q_av 0 uchar and c 255
put q_av 1 uchar shr c 8
end
note append q_pa as the next argument
fn gt_apa to void
p = add get q_n 3 2
n = get q_n 0
for j ulong n bound 8192
put q_av add p j get q_pa j
end
gt_aend n
end
note append word i as the next argument
fn gt_aw i ulong to void
gt_pclr
gt_pw i
gt_apa
end
note run the argument list with stdin, stdout, stderr fds; the exit code, 256 + signal byte otherwise
fn gt_spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
gt_fclo fi
gt_fclo fo
gt_fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
gt_redir fi 0
gt_redir fo 1
gt_redir fe 2
r = execprog q_av 0 get q_n 3
exit 127
end
gt_fclo fi
gt_fclo fo
gt_fclo fe
r = waitpid int pid q_stb 0 len q_stb 0
if ne r pid
exit 2
end
x = ulong get q_stb 0
if ne x 0
ret add 256 x
end
v = ulong get q_stb 1
put q_n 18 v
ret v
end
fn gt_redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
fn gt_fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note run tool word t (built in scratch) with no argument, stdin from the path in q_pa,
note stdout to scratch word o, stderr to scratch err
fn gt_tool t ulong o ulong to ulong
fi = gt_rdonly
gt_aclr
gt_ps t
gt_apa
gt_ps o
fo = gt_wronly
gt_ps 21
fe = gt_wronly
ret gt_spawn fi fo fe
end
note ---- build ---------------------------------------------------------------------------------
note concatenate seed/ng/<a> and seed/ng/<b> into scratch src.om, compile it with OMC to scratch <o>
fn gt_build a ulong b ulong o ulong to bool
gt_pr a
if not gt_slurp 1
ret false
end
n = get q_n 5
gt_pr b
if not gt_slurp 2
ret false
end
m = get q_n 6
if gt add n m len q_b1
ret false
end
for j ulong m bound 16777216
put q_b1 add n j get q_b2 j
end
if ne get q_n 20 0
if not gt_mutate add n m
ret false
end
end
gt_ps 19
if not gt_spill add n m
ret false
end
ret gt_bodyb o
end
note apply q_mu0 -> q_mu1 at its one place in b1[0, n)
fn gt_mutate n ulong to bool
k = len q_mu0
for p ulong n bound 16777216
if gt_mat p k
for j ulong k bound 64
put q_b1 add p j get q_mu1 j
end
ret true
end
end
ret false
end
fn gt_mat p ulong k ulong to bool
for j ulong k bound 64
if ne get q_b1 add p j get q_mu0 j
ret false
end
end
ret true
end
fn gt_bodyb o ulong to bool
fi = gt_rdonly
gt_aclr
gt_pclr
for j ulong get q_n 1 bound 4096
gt_pc ulong get q_omc j
end
gt_apa
gt_ps o
fo = gt_exe
gt_ps 21
fe = gt_wronly
ret eq gt_spawn fi fo fe 0
end
note open scratch q_pa for writing with mode 0755 (created fresh: unlink first)
fn gt_exe to int
r = unlink q_pa 0 get q_n 0
x = fopen q_pa 0 get q_n 0 524865 493
if lt x 0
ret -1
end
ret int x
end
fn gt_tools to bool
if not gt_build 6 7 1
ret false
end
if not gt_build 6 8 2
ret false
end
if not gt_build 9 10 3
ret false
end
if not gt_build 9 11 4
ret false
end
note ng through ngbuild: ngbuild build OMC seed/ng/ng.units SCRATCH/ng
gt_aclr
gt_ps 1
gt_apa
gt_aw 17
gt_pclr
for j ulong get q_n 1 bound 4096
gt_pc ulong get q_omc j
end
gt_apa
gt_pr 12
gt_apa
gt_ps 5
gt_apa
gt_pr 12
fi = gt_rdonly
gt_ps 20
fo = gt_wronly
gt_ps 21
fe = gt_wronly
ret eq gt_spawn fi fo fe 0
end
fn gt_table to bool
gt_aclr
gt_ps 2
gt_apa
gt_aw 18
gt_pr 12
fi = gt_rdonly
gt_ps 20
fo = gt_wronly
gt_ps 21
fe = gt_wronly
if ne gt_spawn fi fo fe 0
ret false
end
gt_ps 20
if not gt_slurp 1
ret false
end
gt_pr 13
if not gt_slurp 2
ret false
end
ret gt_same
end
note ---- cases parsing -----------------------------------------------------------------------------
fn gt_pk to ulong
p = get q_n 8
if ge p get q_n 7
ret 10
end
ret ulong get q_cs p
end
fn gt_adv to void
put q_n 8 add get q_n 8 1
end
fn gt_skip to void
while eq gt_pk 32 bound 4096
gt_adv
end
end
note a decimal field; q_n 17 = 0 when the field is "-" or absent (value 0)
fn gt_dec to ulong
gt_skip
put q_n 17 0
if eq gt_pk 45
gt_adv
ret 0
end
v = ulong 0
while and ge gt_pk 48 le gt_pk 57 bound 20
v = add mul v 10 sub gt_pk 48
gt_adv
put q_n 17 1
end
ret v
end
note a name field: its start; its end goes to q_n 19
fn gt_name to ulong
gt_skip
a = get q_n 8
while and ne gt_pk 32 ne gt_pk 10 bound 256
gt_adv
end
put q_n 19 get q_n 8
ret a
end
fn gt_eol to void
while ne gt_pk 10 bound 4096
gt_adv
end
gt_adv
end
note ---- checks ---------------------------------------------------------------------------------
note scratch err must end with " at OFF\n" (or "line OFF\n" for ngas)
fn gt_offok off ulong to bool
gt_ps 21
if not gt_slurp 2
ret false
end
n = get q_n 6
put q_n 9 0
gt_num off
k = get q_n 9
put q_n 9 0
if lt n add k 2
ret false
end
if ne get q_b2 sub n 1 10
ret false
end
s = sub sub n 1 k
for j ulong k bound 24
if ne get q_b2 add s j get q_o j
ret false
end
end
ret eq get q_b2 sub s 1 32
end
note scratch out must start with "ACCEPT <sha256 of b1[0, n)> "
fn gt_digok n ulong to bool
for j ulong n bound 16777216
put sh_dat j get q_b1 j
end
sh_all n
gt_ps 20
if not gt_slurp 2
ret false
end
if lt get q_n 6 72
ret false
end
for j ulong 32
x = ulong get sh_dig j
if ne get q_b2 add 7 mul j 2 get q_hex shr x 4
ret false
end
if ne get q_b2 add 8 mul j 2 get q_hex and x 15
ret false
end
end
ret eq get q_b2 71 32
end
note assemble fixture [a, b) into scratch bin; false (case failed) when ngas refuses
fn gt_asm a ulong b ulong to bool
gt_pfix a b
x = gt_tool 3 23
if ne x 0
gt_failv 4 x
ret false
end
ret true
end
note T NAME EXIT OFFSET
fn gt_tcase to void
a = gt_name
b = get q_n 19
ex = gt_dec
off = gt_dec
if not gt_asm a b
ret
end
gt_ps 23
x = gt_tool 4 24
if ne x 0
gt_failv 5 x
ret
end
gt_ps 24
if not gt_slurp 1
gt_fail0 21
ret
end
gt_pfix a b
if not gt_slurp 2
gt_fail0 21
ret
end
if not gt_same
gt_fail0 6
end
gt_ps 23
gt_verdict 2 ex off
if ne ex 0
ret
end
gt_ps 23
if not gt_slurp 1
gt_fail0 21
ret
end
n = get q_n 5
if not gt_digok n
gt_fail0 9
end
gt_ircopy n
end
note run tool t (ngcheck 2 or ngdis 4) on the path in q_pa, expect exit ex and offset off
fn gt_verdict t ulong ex ulong off ulong to void
x = gt_tool t 20
if ne x ex
if eq t 2
gt_failv 7 x
else
gt_failv 20 x
end
ret
end
if ne ex 0
if not gt_offok off
gt_failv 8 off
end
end
end
note ng ir-copy of b1[0, n): "@ng ir-copy\n" + bytes in, the same bytes out
fn gt_ircopy n ulong to void
k = len q_irc
for j ulong n bound 16777216
put q_b1 sub add n k add 1 j get q_b1 sub n add 1 j
end
for j ulong k bound 16
put q_b1 j get q_irc j
end
gt_ps 22
if not gt_spill add n k
gt_fail0 21
ret
end
gt_ps 22
x = gt_tool 5 20
if ne x 0
gt_failv 10 x
ret
end
gt_ps 23
if not gt_slurp 1
gt_fail0 21
ret
end
gt_ps 20
if not gt_slurp 2
gt_fail0 21
ret
end
if not gt_same
gt_fail0 11
end
end
note S NAME LINE
fn gt_scase to void
a = gt_name
b = get q_n 19
ln = gt_dec
gt_pfix a b
x = gt_tool 3 23
if ne x 3
gt_failv 4 x
ret
end
if not gt_offok ln
gt_failv 12 ln
end
end
note M BASE POS BYTE EXIT OFF / C BASE LEN EXIT OFF / A BASE BYTE EXIT OFF
fn gt_mcase k ulong to void
a = gt_name
b = get q_n 19
p = gt_dec
v = ulong 0
if eq k 77
v = gt_dec
end
ex = gt_dec
off = gt_dec
if not gt_asm a b
ret
end
gt_ps 23
if not gt_slurp 1
gt_fail0 21
ret
end
n = get q_n 5
if eq k 77
if ge p n
gt_fail0 13
ret
end
put q_b1 p uchar v
end
if eq k 67
n = p
end
if eq k 65
put q_b1 n uchar p
n = add n 1
end
gt_ps 22
if not gt_spill n
gt_fail0 21
ret
end
gt_ps 22
gt_verdict 2 ex off
gt_ps 22
gt_verdict 4 ex off
end
note D EXIT OFF: stdin is the directory seed/ng/tests/ir
fn gt_dcase to void
ex = gt_dec
off = gt_dec
gt_pr 25
gt_verdict 2 ex off
gt_pr 25
gt_verdict 4 ex off
gt_pr 25
x = gt_tool 3 23
if ne x ex
gt_failv 4 x
end
end
note one case line at the cursor; returns false at the end of the file
fn gt_case to bool
if ge get q_n 8 get q_n 7
ret false
end
put q_n 13 get q_n 8
put q_n 12 0
k = gt_pk
gt_adv
if eq k 35
gt_eol
ret true
end
if eq k 10
ret true
end
put q_n 10 add get q_n 10 1
if eq k 84
gt_tcase
else
if eq k 83
gt_scase
else
if or eq k 77 or eq k 67 eq k 65
gt_mcase k
else
if eq k 68
gt_dcase
else
gt_fail0 13
end
end
end
end
if ne get q_n 12 0
put q_n 11 add get q_n 11 1
end
gt_eol
ret true
end
note ---- negative controls of the gate ----------------------------------------------------------------
note run the first T line of cases again with a broken expectation (mode 1 exit + 1, mode 2 offset + 1,
note mode 3 a round-trip text the fixture does not equal); the case must fail
fn gt_ctl md ulong to void
put q_n 14 1
put q_n 12 0
put q_n 8 0
while ne gt_pk 84 bound 1048576
gt_eol
end
put q_n 13 get q_n 8
gt_adv
a = gt_name
b = get q_n 19
ex = gt_dec
off = gt_dec
if eq md 1
s = gt_asm a b
gt_ps 23
gt_verdict 2 add ex 1 off
end
if eq md 2
gt_ctl2 a b
end
if eq md 3
gt_ctl3 a b
end
put q_n 14 0
if eq get q_n 12 0
put q_n 11 add get q_n 11 1
gt_say 0
gt_say 14
gt_num md
gt_nl
end
end
note mode 2 uses the first refusal line (exit != 0)
fn gt_ctl2 a ulong b ulong to void
put q_n 8 0
ex = ulong 0
a2 = ulong 0
b2 = ulong 0
off = ulong 0
while eq ex 0 bound 4096
while ne gt_pk 84 bound 1048576
gt_eol
end
gt_adv
a2 = gt_name
b2 = get q_n 19
ex = gt_dec
off = gt_dec
end
s = gt_asm a2 b2
gt_ps 23
gt_verdict 2 ex add off 1
end
fn gt_ctl3 a ulong b ulong to void
s = gt_asm a b
gt_ps 23
x = gt_tool 4 24
gt_ps 24
s = gt_slurp 1
n = get q_n 5
put q_b1 sub n 2 uchar xor get q_b1 sub n 2 1
gt_pfix a b
s = gt_slurp 2
if not gt_same
gt_fail0 6
end
end
note the tool mutant: rebuild ngcheck with q_mu0 -> q_mu1 and rerun every case quietly; at least
note one case must fail (the mutant is killed), else the gate fails
fn gt_mrun to void
c10 = get q_n 10
c11 = get q_n 11
put q_n 20 1
ok = gt_build 6 8 2
put q_n 20 0
if not ok
put q_n 11 add c11 1
gt_say 0
gt_say 22
gt_say 24
gt_nl
ret
end
put q_n 14 1
put q_n 11 0
put q_n 8 0
while gt_case bound 65536
end
k = get q_n 11
put q_n 14 0
put q_n 10 c10
put q_n 11 c11
if eq k 0
put q_n 11 add c11 1
gt_say 0
gt_say 22
gt_say 23
gt_nl
ret
end
gt_say 26
gt_say 22
gt_say 25
gt_num k
gt_nl
end
fn main to int
gt_init
if ne argcnt 3
gt_say 18
gt_nl
ret 2
end
r = argread 1 q_omc 0 4095
if lt r 1
ret 2
end
put q_n 1 ulong r
r = argread 2 q_scr 0 4094
if lt r 1
ret 2
end
n = ulong r
x = makedir q_scr 0 n 448
if and ne x 0 ne x -17
gt_say 19
gt_nl
ret 2
end
put q_scr n 47
put q_n 2 add n 1
if not gt_tools
gt_say 0
gt_say 1
gt_nl
ret 3
end
if not gt_table
put q_n 11 1
gt_say 0
gt_say 2
gt_nl
end
gt_pr 14
gt_pw 15
fd = gt_rdonly
if lt fd 0
ret 2
end
k = read fd q_cs 0 len q_cs
r = fclose fd
if le k 0
ret 2
end
put q_n 7 ulong k
put q_n 8 0
while gt_case bound 65536
end
for md ulong 3
gt_ctl add md 1
end
gt_mrun
f = get q_n 11
if eq f 0
gt_say 15
gt_num get q_n 10
gt_nl
ret 0
end
gt_say 16
gt_num f
gt_say 17
gt_num get q_n 10
gt_nl
ret 1
end

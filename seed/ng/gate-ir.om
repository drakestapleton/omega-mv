ex = gt_dec
off = gt_dec
gt_pr 25
gt_verdict 2 ex off
gt_pr 25
gt_verdict 4 ex off
gt_pr 25
x = gt_tool 5 20
gt_ngv x ex off
gt_pr 25
x = gt_tool 3 23
if ne x ex
gt_failv 4 x
end

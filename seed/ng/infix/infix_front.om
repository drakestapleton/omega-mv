note SPDX-License-Identifier: Apache-2.0
note seed/ng/infix/infix_front.om: Omega 1.0 Dual Surface Syntax Infix Frontend (pure seeded OM-2).
note Library unit (no om2 header, no fn main; all symbols prefixed ix_ / IX_).
note Parses clean human-readable infix Omega syntax and lowers deterministically to canonical
note prefix OM-2 source that compiles with seed/out/omc and lowers via @ng front-ir to the exact
note same canonical OIR and SHA-256 SEMANTIC_ID as hand-written prefix .om.
note
note Usage (linked with om_fmt.om or gate_infix.om):
note   Fill ix_src[0..n), set ix_slen[0] = n, call ix_lower().
note   Returns 0 (IX_OK) on success with canonical prefix OM-2 in ix_out[0..ix_olen[0]).
note   Returns nonzero IX_ERR_* on any lexical, precedence, brace, operator, or reserved-word error
note   (fail-closed, with line number in ix_st[1]).

const IX_SRC_CAP ulong 262144
const IX_OUT_CAP ulong 524288
const IX_TOK_CAP ulong 65536
const IX_NODE_CAP ulong 65536
const IX_ARG_CAP ulong 65536
const IX_MAX_DEPTH ulong 256

note Error codes (0 = OK, nonzero = fail-closed refusal)
const IX_OK ulong 0
const IX_ERR_CAP ulong 1
const IX_ERR_INVALID_OP ulong 2
const IX_ERR_BAD_STR ulong 3
const IX_ERR_BAD_NUM ulong 4
const IX_ERR_UNCLOSED_BRACE ulong 5
const IX_ERR_UNEXPECTED_BRACE ulong 6
const IX_ERR_UNCLOSED_PAREN ulong 7
const IX_ERR_PRECEDENCE ulong 8
const IX_ERR_RESERVED ulong 9
const IX_ERR_SYNTAX ulong 10
const IX_ERR_DEPTH ulong 11
const IX_ERR_RANGE ulong 12

note Token kinds
const IX_TK_EOF ulong 0
const IX_TK_IDENT ulong 1
const IX_TK_NUM ulong 2
const IX_TK_STR ulong 3
const IX_TK_COMMENT ulong 4
const IX_TK_NL ulong 5
const IX_TK_BLANK ulong 6
const IX_TK_LPAREN ulong 10
const IX_TK_RPAREN ulong 11
const IX_TK_LBRACE ulong 12
const IX_TK_RBRACE ulong 13
const IX_TK_LBRACK ulong 14
const IX_TK_RBRACK ulong 15
const IX_TK_COMMA ulong 16
const IX_TK_COLON ulong 17
const IX_TK_SEMI ulong 18
const IX_TK_DOT ulong 19
const IX_TK_DOTDOT ulong 20
const IX_TK_ARROW ulong 21
const IX_TK_ASSIGN ulong 22
const IX_TK_PLUS ulong 23
const IX_TK_MINUS ulong 24
const IX_TK_STAR ulong 25
const IX_TK_SLASH ulong 26
const IX_TK_PERCENT ulong 27
const IX_TK_AMP ulong 28
const IX_TK_PIPE ulong 29
const IX_TK_CARET ulong 30
const IX_TK_SHL ulong 31
const IX_TK_SHR ulong 32
const IX_TK_EQ ulong 33
const IX_TK_NE ulong 34
const IX_TK_LT ulong 35
const IX_TK_LE ulong 36
const IX_TK_GT ulong 37
const IX_TK_GE ulong 38
const IX_TK_ANDAND ulong 39
const IX_TK_OROR ulong 40
const IX_TK_BANG ulong 41
const IX_TK_TILDE ulong 42
const IX_TK_PLUSEQ ulong 43
const IX_TK_MINUSEQ ulong 44
const IX_TK_STAREQ ulong 45
const IX_TK_AMPEQ ulong 46
const IX_TK_PIPEEQ ulong 47
const IX_TK_CARETEQ ulong 48
const IX_TK_SHLEQ ulong 49
const IX_TK_SHREQ ulong 50
const IX_TK_ATTR ulong 51

note AST node kinds
const IX_N_ATOM ulong 1
const IX_N_NEG_LIT ulong 2
const IX_N_UNOP ulong 3
const IX_N_BINOP ulong 4
const IX_N_CAST ulong 5
const IX_N_INDEX ulong 6
const IX_N_FIELD ulong 7
const IX_N_FINDEX ulong 8
const IX_N_CALL ulong 9
const IX_N_PART ulong 10
const IX_N_BORROW ulong 11
const IX_N_LEN ulong 12
const IX_N_SIZEOF ulong 13
const IX_N_OFFSETOF ulong 14
const IX_N_NEW_ARR ulong 15
const IX_N_NEW_STR ulong 16
const IX_N_BITCAST ulong 17
const IX_N_SEAL ulong 18

note Binary op IDs (1..16)
const IX_OP_ADD ulong 1
const IX_OP_SUB ulong 2
const IX_OP_MUL ulong 3
const IX_OP_DIV ulong 4
const IX_OP_REM ulong 5
const IX_OP_AND ulong 6
const IX_OP_OR ulong 7
const IX_OP_XOR ulong 8
const IX_OP_SHL ulong 9
const IX_OP_SHR ulong 10
const IX_OP_EQ ulong 11
const IX_OP_NE ulong 12
const IX_OP_LT ulong 13
const IX_OP_LE ulong 14
const IX_OP_GT ulong 15
const IX_OP_GE ulong 16

note Buffers and parser state
global ix_src uchar 262144
global ix_slen ulong 1
global ix_out uchar 524288
global ix_olen ulong 1

global ix_tkind uchar 65536
global ix_tpos uint 65536
global ix_tlen uint 65536
global ix_tline uint 65536
global ix_tcnt ulong 1
global ix_tcur ulong 1

global ix_nkind uchar 65536
global ix_na uint 65536
global ix_nb uint 65536
global ix_nc uint 65536
global ix_args uint 65536
global ix_ncnt ulong 1
global ix_acnt ulong 1

note ix_st: 0=err, 1=err_line, 2=om2_mode, 3=depth, 4=err_tok
global ix_st ulong 8
global ix_numbuf uchar 32
note Stage 0 ΩIR v2 pending contract state: 0=active, 1=pur, 2=prc, 3=hd, 4=err, 5=dl, 6=pwr, 7=seen_mask
global ix_cpen ulong 8

note Keyword and reserved-word lookup tables
text ix_tb_types "|bool|uchar|ushort|uint|ulong|byte|short|int|long|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|qty|"
text ix_tb_kw_all "|fn|to|end|if|else|while|bound|for|in|unroll|break|continue|ret|return|let|put|get|len|new|global|text|const|struct|layout|field|at|little|big|abstract|ops|holds|view|edit|part|inline|export|requires|ensures|invariant|exit|trap|note|free|own|true|false|void|sizeof|offsetof|enlarge|add|sub|mul|div|rem|and|or|xor|shl|shr|eq|ne|lt|le|gt|ge|neg|not|rotr|rotl|bitcast|fsqrt|fabs|fmin|fmax|fma|"
text ix_tb_kw_om2 "|out|fresh|seal|open|"
text ix_tb_host "|read|write|fopen|fclose|fsync|fdsync|memfd|fchmod|chmod|faccess|syncfs|flock|umask|fseek|ftrunc|truncate|unlink|fstat|stat|lstat|pread|pwrite|chown|fchdir|makedir|rmdir|cwd|chdir|readlnk|getdnts|renames|link|symlnk|getuid|geteuid|getgid|getegid|getppid|setsid|getpgid|getsid|setpgid|fork|getpid|killpid|waitpid|pipefds|dupfd|execprog|argcnt|argread|envcnt|envread|execenv|prlimit|cpuset|cpuget|cpunow|setprio|getprio|execpure|shutdown|socknew|bind|connect|listen|accept|sockname|sockopt|recv|send|waitio|peercred|pollfds|sendmsg|peername|monons|realns|sleepns|random|dit|scrub|cpufence|cpurelax|devctl|mapnew|mapdrop|mapread|mapwrite|devcall|uvmctl|mapaddr|mapget|mapset|maphold|vfioctl|vfiomap|vfiomapw|eventfd|vfioirq|mapbind|kfdres|kfdmap|kfdctl|libfn|libptr|libcall|"
text ix_tb_valfn "|rotr|rotl|fsqrt|fabs|fmin|fmax|fma|open|enlarge|"
text ix_tb_voidhost "|cpufence|cpurelax|"

note Keyword text literals for exact matching and prefix emission
text ix_s_om2 "om2"
text ix_s_target "target"
text ix_s_usage "usage"
text ix_s_note "note"
text ix_s_const "const"
text ix_s_global "global"

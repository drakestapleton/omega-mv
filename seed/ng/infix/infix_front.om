fn ix_emit_u64 v ulong to void
x = v
p = ulong 32
for j ulong 21
p = sub p 1
put ix_numbuf p uchar add 48 rem x 10
x = div x 10
if eq x 0
for k ulong sub 32 p bound 21
ix_oc ulong get ix_numbuf add p k
end
ret
end
end
end

fn ix_parse_u64_tok idx ulong to ulong
p = ulong get ix_tpos idx
n = ulong get ix_tlen idx
if eq n 0
ix_fail_cur IX_ERR_BAD_NUM
ret 0
end
if and ge n 2 and eq ix_byte p 48 eq ix_byte add p 1 120
if gt sub n 2 16
ix_fail_cur IX_ERR_RANGE
ret 0
end
v = ulong 0
for i ulong sub n 2 bound 16
ch = ix_byte add add p 2 i
d = ulong 0
if ix_is_digit ch
d = sub ch 48
else
if ix_is_hex ch
d = add sub ch 97 10
else
ix_fail_cur IX_ERR_BAD_NUM
ret 0
end
end
v = or shl v 4 d
end
ret v
end
if gt n 20
ix_fail_cur IX_ERR_RANGE
ret 0
end
v = ulong 0
lim = ulong 1844674407370955161
for i ulong n bound 20
ch = ix_byte add p i
if not ix_is_digit ch
ix_fail_cur IX_ERR_BAD_NUM
ret 0
end
d = sub ch 48
if or gt v lim and eq v lim gt d 5
ix_fail_cur IX_ERR_RANGE
ret 0
end
v = add mul v 10 d
end
ret v
end

fn ix_parse_attr_u64 pos_only bool to ulong
hp = false
if eq ix_peek IX_TK_LPAREN

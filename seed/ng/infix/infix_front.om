text ix_s_export "export"
text ix_s_inline "inline"
text ix_s_fn "fn"
text ix_s_to "to"
text ix_s_void "void"
text ix_s_end "end"
text ix_s_if "if"
text ix_s_else "else"
text ix_s_while "while"
text ix_s_bound "bound"
text ix_s_for "for"
text ix_s_in "in"
text ix_s_unroll "unroll"
text ix_s_ulong "ulong"
text ix_s_return "return"
text ix_s_ret "ret"
text ix_s_break "break"
text ix_s_continue "continue"
text ix_s_exit "exit"
text ix_s_trap "trap"
text ix_s_requires "requires"
text ix_s_ensures "ensures"
text ix_s_invariant "invariant"
text ix_s_let "let"
text ix_s_put "put"
text ix_s_get "get"
text ix_s_new "new"
text ix_s_len "len"
text ix_s_sizeof "sizeof"
text ix_s_offsetof "offsetof"
text ix_s_part "part"
text ix_s_view "view"
text ix_s_edit "edit"
text ix_s_out "out"
text ix_s_fresh "fresh"
text ix_s_bitcast "bitcast"
text ix_s_seal "seal"
text ix_s_true "true"
text ix_s_false "false"
text ix_s_neg "neg"
text ix_s_not "not"
text ix_s_debug "debug"
text ix_s_release "release"
text ix_s_diag "diag"
text ix_s_fmt "fmt"

end
if ne ix_peek IX_TK_NUM
ix_fail_cur IX_ERR_SYNTAX
ret 0
end
nt = ix_take
v = ix_parse_u64_tok nt
if not ix_ok
ret 0
end
if and pos_only eq v 0
ix_fail_cur IX_ERR_RANGE
ret 0
end
if hp
ix_skip_nl
if not ix_expect IX_TK_RPAREN IX_ERR_UNCLOSED_PAREN
ret 0
end
end
ret v
end

fn ix_parse_one_attr at_tok ulong to void
mk = get ix_cpen 7
if ix_attr_eq at_tok ix_s_at_pure
if or ne and mk 1 0 eq ix_peek IX_TK_LPAREN
ix_fail_cur IX_ERR_SYNTAX
ret
end
put ix_cpen 0 1
put ix_cpen 1 1
put ix_cpen 7 or mk 1
ret
end
if ix_attr_eq at_tok ix_s_at_exact
if or ne and mk 6 0 eq ix_peek IX_TK_LPAREN
ix_fail_cur IX_ERR_SYNTAX
ret
end
if and ne and mk 8 0 ne get ix_cpen 4 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
put ix_cpen 0 1
put ix_cpen 2 1
put ix_cpen 7 or mk 2
ret
end
if ix_attr_eq at_tok ix_s_at_tol
if ne and mk 6 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
if or eq ix_peek IX_TK_LPAREN eq ix_peek IX_TK_NUM
if ne and mk 8 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
ev = ix_parse_attr_u64 false
if not ix_ok
ret
end
put ix_cpen 4 ev
mk = or mk 8
end
put ix_cpen 0 1
put ix_cpen 2 2
put ix_cpen 7 or mk 4
ret
end
if ix_attr_eq at_tok ix_s_at_err
if ne and mk 8 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
ev = ix_parse_attr_u64 false
if not ix_ok
ret
end
if and eq get ix_cpen 2 1 ne ev 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
if eq get ix_cpen 2 0
put ix_cpen 2 2
end
put ix_cpen 0 1
put ix_cpen 4 ev
put ix_cpen 7 or mk 8
ret
end
if ix_attr_eq at_tok ix_s_at_dl
if ne and mk 16 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
dv = ix_parse_attr_u64 true
if not ix_ok
ret
end
put ix_cpen 0 1
put ix_cpen 5 dv
put ix_cpen 7 or mk 16
ret
end
if ix_attr_eq at_tok ix_s_at_hdl
if ne and mk 32 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
if or eq ix_peek IX_TK_LPAREN eq ix_peek IX_TK_NUM
if ne and mk 16 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
dv = ix_parse_attr_u64 true
if not ix_ok
ret
end
put ix_cpen 5 dv
mk = or mk 16
end
put ix_cpen 0 1
put ix_cpen 3 1
put ix_cpen 7 or mk 32
ret
end
if ix_attr_eq at_tok ix_s_at_pwr
if ne and mk 64 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
pv = ix_parse_attr_u64 true
if not ix_ok
ret
end
put ix_cpen 0 1
put ix_cpen 6 pv
put ix_cpen 7 or mk 64
ret
end
ix_fail_cur IX_ERR_SYNTAX
end

fn ix_emit_fn_attrs to void
if eq get ix_cpen 0 0
ret
end
pur = get ix_cpen 1
prc = get ix_cpen 2
hd = get ix_cpen 3
ev = get ix_cpen 4
dl = get ix_cpen 5
pwr = get ix_cpen 6
if and eq hd 1 eq dl 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
if and ne prc 2 ne ev 0
ix_fail_cur IX_ERR_SYNTAX
ret
end
if ne pur 0
ix_os ix_s_at_pure
ix_onl
end
if eq prc 1
ix_os ix_s_at_exact
ix_onl
end
if eq prc 2
ix_os ix_s_at_tol
if ne ev 0
ix_osp
ix_emit_u64 ev
end
ix_onl
end
if ne dl 0
ix_os ix_s_at_dl
ix_osp
ix_emit_u64 dl
ix_onl
end
if ne hd 0
ix_os ix_s_at_hdl
ix_onl
end
if ne pwr 0
ix_os ix_s_at_pwr
ix_osp
ix_emit_u64 pwr
ix_onl
end
end

fn ix_parse_fn_with_attrs to void
for i ulong 8
put ix_cpen i 0
end
while ix_ok bound 32
k = ix_peek
if or eq k IX_TK_NL or eq k IX_TK_SEMI eq k IX_TK_BLANK
ig = ix_take
continue
end
if eq k IX_TK_COMMENT
t = ix_take
ix_emit_comment t
continue
end
if eq k IX_TK_ATTR
at_tok = ix_take
ix_parse_one_attr at_tok
continue
end
break
end
if not ix_ok
ret
end
if ne ix_peek IX_TK_IDENT
ix_fail_cur IX_ERR_SYNTAX
ret
end
id = ix_take
if ix_tok_eq id ix_s_fn
ix_emit_fn_attrs
if ix_ok
ix_parse_fn false false
end
ret
end
if ix_tok_eq id ix_s_export
inl = false
if ix_tok_eq get ix_tcur 0 ix_s_inline
ig = ix_take
inl = true
end
if not ix_tok_eq get ix_tcur 0 ix_s_fn
ix_fail_cur IX_ERR_SYNTAX
ret
end
ig = ix_take
ix_emit_fn_attrs
if ix_ok
ix_parse_fn true inl
end
ret
end
if ix_tok_eq id ix_s_inline
if not ix_tok_eq get ix_tcur 0 ix_s_fn
ix_fail_cur IX_ERR_SYNTAX
ret
end
ig = ix_take
ix_emit_fn_attrs
if ix_ok
ix_parse_fn false true
end
ret
end
ix_fail_cur IX_ERR_SYNTAX
end

fn ix_parse_top to void
while ix_ok bound 65536
k = ix_peek
if or eq k IX_TK_NL eq k IX_TK_SEMI
ig = ix_take
continue
end
if eq k IX_TK_BLANK
ig = ix_take
ix_onl
continue
end
if eq k IX_TK_COMMENT
t = ix_take
ix_emit_comment t
continue
end
if eq k IX_TK_EOF
ret
end
if eq k IX_TK_RBRACE
ix_fail_cur IX_ERR_UNEXPECTED_BRACE
ret
end
if eq k IX_TK_ATTR
ix_parse_fn_with_attrs
continue
end
if ne k IX_TK_IDENT
ix_fail_cur IX_ERR_SYNTAX
ret
end
id = ix_take
if ix_tok_eq id ix_s_om2
put ix_st 2 1
ix_os ix_s_om2
while and ix_ok eq ix_peek IX_TK_IDENT bound 8
md = ix_take
ix_osp
ix_otok md
end
ix_onl
continue
end
if ix_tok_eq id ix_s_target
tg = ix_take
ix_os ix_s_target
ix_osp
ix_otok tg
ix_onl
continue
end
if ix_tok_eq id ix_s_usage
ix_os ix_s_usage
ix_onl
continue
end
if ix_tok_eq id ix_s_const
ix_parse_const
continue
end
if ix_tok_eq id ix_s_global
ix_parse_global
continue
end
if ix_tok_eq id ix_s_text
ix_parse_text
continue
end
if ix_tok_eq id ix_s_struct
ix_parse_struct
continue
end
if ix_tok_eq id ix_s_layout
ix_parse_layout
continue
end
if ix_tok_eq id ix_s_abstract
ix_parse_abstract
continue
end
if ix_tok_eq id ix_s_holds
ix_parse_holds
continue
end
if ix_tok_eq id ix_s_fn
ix_parse_fn false false
continue
end
if ix_tok_eq id ix_s_export
inl = false
if ix_tok_eq get ix_tcur 0 ix_s_inline
ig = ix_take
inl = true
end
if not ix_tok_eq get ix_tcur 0 ix_s_fn
ix_fail_cur IX_ERR_SYNTAX
ret
end
ig = ix_take
ix_parse_fn true inl
continue
end
if ix_tok_eq id ix_s_inline
if not ix_tok_eq get ix_tcur 0 ix_s_fn
ix_fail_cur IX_ERR_SYNTAX
ret
end
ig = ix_take
ix_parse_fn false true
continue
end
ix_fail_cur IX_ERR_SYNTAX
ret
end
end

note ---- Public Entrypoint and Diagnostic Writer -----------------------------------------------
fn ix_lower to ulong
put ix_olen 0 0
put ix_ncnt 0 0
put ix_acnt 0 0
put ix_st 0 0
put ix_st 1 0
put ix_st 2 0
put ix_st 3 0
put ix_st 4 0
ix_lex
if not ix_ok
ret get ix_st 0
end
ix_parse_top
ret get ix_st 0
end

fn ix_write_u fd int v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put ix_numbuf i uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write fd ix_numbuf i sub 32 i
ret
end
end
end

fn ix_write_err fd int to void
r1 = write fd ix_e_pfx 0 len ix_e_pfx
ix_write_u fd get ix_st 1
r2 = write fd ix_e_sep 0 len ix_e_sep
code = get ix_st 0
ix_write_u fd code
r3 = write fd ix_e_col 0 len ix_e_col
c = ulong 0
s = ulong 0
for i ulong len ix_s_errs bound 512
if eq get ix_s_errs i 124
if eq c code
r4 = write fd ix_s_errs s sub i s
break
end
c = add c 1
s = add i 1
end
end
r5 = write fd ix_e_nl 0 len ix_e_nl
end

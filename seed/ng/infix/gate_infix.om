text tn_s02 "om2\nfn main() -> int {\n  x = ulong(1)\n  if x == 1 == true { return 1 }\n  return 0\n}\n"

text tn_n03 "neg03_unclosed_brace"
text tn_s03 "om2\nfn main() -> int {\n  return 0\n"


note ---- 18 Built-in Prefix Round-Trip Corpus Cases ------------------------------------------
text tc_n01 "c01_arith_prec"
text tc_p01 "om2\nfn calc a ulong b ulong c ulong d ulong to ulong\nx = mul add a b sub c d\ny = sub a sub b c\nz = add mul a 8 b\nw = rem div add x z add d 1 97\nret add y w\nend\nfn main to int\nret int and calc 13 7 29 11 255\nend\n"

text tc_n02 "c02_bitops_mask"
text tc_p02 "om2\nfn pack buf edit uchar 16 i ulong v ulong to void\nput buf add mul i 4 0 uchar and v 255\nput buf add mul i 4 1 uchar and shr v 8 255\nput buf add mul i 4 2 uchar and shr v 16 255\nput buf add mul i 4 3 uchar and shr v 24 0xff\nend\nfn main to int\nb = new uchar 16 0\npack b 2 0x12345678\nu = rotl uint 0x13579bdf uint 5\nw = rotr u uint 3\nk = xor and w 0xff not uint 0\nr = add ulong get b 10 ulong and k 255\nret int and r 255\nend\n"

text tc_n03 "c03_signed_neg"
text tc_p03 "om2\nfn main to int\na = shr int -16 int 2\nb = neg a\nc = sub int 20 b\nif lt a c\nc = add c 7\nend\nret and c 255\nend\n"

text tc_n04 "c04_get_put_arr"
text tc_p04 "om2\nfn main to int\na = new ulong 12 0\nfor i ulong 12\nput a i add mul i 3 1\nend\ns = ulong 0\nfor i ulong len a\ns = add s get a i\nend\nret int and s 255\nend\n"

text tc_n05 "c05_view_edit_sized"
text tc_p05 "om2\nfn dot a view ulong 4 b view ulong 4 dst edit ulong 4 to ulong\ns = ulong 0\nfor i ulong 4\np = mul get a i get b i\nput dst i p\ns = add s p\nend\nret s\nend\nfn main to int\na = new ulong 4 3\nb = new ulong 4 5\nc = new ulong 4 0\nput a 2 7\nput b 3 9\ns = dot a b c\nret int and add s get c 2 255\nend\n"

text tc_n06 "c06_unsized_part"
text tc_p06 "om2\nfn sum a view uint * to ulong\ns = ulong 0\nfor i ulong len a\ns = add s ulong get a i\nend\nret s\nend\nfn bump a edit uint * v uint to void\nfor i ulong len a\nput a i add get a i v\nend\nend\nfn main to int\nb = new uint 8 0\nfor i ulong 8\nput b i uint add i 1\nend\nbump part b 4 2 10\nx = sum b\ny = sum part b 2 3\nret int and add x y 255\nend\n"

text tc_n07 "c07_if_else_nest"
text tc_p07 "om2\nfn classify x ulong y ulong to ulong\nf = and gt x 5 lt y 20\nif or f eq x 0\nif not eq y 10\nret 41\nelse\nret 42\nend\nelse\nret 43\nend\nend\nfn main to int\na = classify 7 15\nb = classify 7 10\nc = classify 3 25\nret int and add add a b c 255\nend\n"

text tc_n08 "c08_for_ulong_unroll"
text tc_p08 "om2\nfn main to int\ns = ulong 0\nfor i ulong 8 unroll\ns = add s mul i 2\nend\nt = uint 0\nfor j uint 6\nt = add t j\nend\nn = ulong 5\nfor k ulong n bound 64\ns = add s k\nend\nret int and add s ulong t 255\nend\n"

text tc_n09 "c09_while_bound"
text tc_p09 "om2\nfn gcd a uint b uint to uint\nwhile ne b 0 bound 100\nt = rem a b\na = b\nb = t\nend\nret a\nend\nfn main to int\ng = gcd 1071 462\ni = ulong 0\ns = ulong 0\nwhile lt i 20 bound 32\ni = add i 1\nif eq rem i 2 0\ncontinue\nend\nif gt i 11\nbreak\nend\ns = add s i\nend\nret int and add ulong g s 255\nend\n"

text tc_n10 "c10_multiarg_call"
text tc_p10 "om2\nfn fib n ulong to ulong\nif lt n 2\nret n\nend\nret add fib sub n 1 fib sub n 2\nend\nfn mix a ulong b ulong c ulong d ulong e ulong to ulong\nret add add mul a b mul c d e\nend\nfn main to int\nr = mix fib 6 fib 5 3 4 7\nret int and r 255\nend\n"

text tc_n11 "c11_const_global_text"
text tc_p11 "om2\nconst LIM ulong 6\nglobal g_acc ulong 8\ntext g_msg \"omega-dual\\n\"\nfn main to int\nfor i ulong LIM\nput g_acc i mul add i 1 3\nend\nw = write 1 g_msg 0 len g_msg\ns = ulong 0\nfor i ulong LIM\ns = add s get g_acc i\nend\nret int and add s ulong w 255\nend\n"

text tc_n12 "c12_struct_fields"
text tc_p12 "om2\nstruct Pair a uint f bool v uint 4 end\nfn bump_p p edit Pair k uint to uint\nput p v 1 add get p a get p v 1\nif get p f\nput p a add get p a k\nend\nret add get p a get p v 1\nend\nfn main to int\np = new Pair 5 true 3\nr = bump_p p 4\nsz = sizeof Pair\noff = offsetof Pair v\nret int and add ulong r add sz off 255\nend\n"

text tc_n13 "c13_float_fma"
text tc_p13 "om2\nfn main to int\na = f64 1.5f64\nb = f64 2.5f64\nc = f64 0.25f64\nd = fma a b c\ne = fsqrt add d 5.0f64\nf = fmax fmin e 10.0f64 fabs -1.5f64\nbits = bitcast ulong f\nret int and add ulong f and shr bits 52 255 255\nend\n"

text tc_n14 "c14_contracts_inline"
text tc_p14 "om2\nfn add1 x ulong to ulong inline\nrequires lt x 1000\nensures gt result x\nret add x 1\nend\nfn main to int\ns = ulong 0\ni = ulong 0\nwhile lt i 10 bound 16\ninvariant le i 10\ns = add s add1 i\ni = add i 1\nend\nret int and s 255\nend\n"

text tc_n15 "c15_layout_endian"
text tc_p15 "om2\nlayout Hdr 12\nfield tag ushort at 0 little\nfield val uint at 4 big\nfield arr uchar 4 at 8 little\nend\nfn fill h edit Hdr to void\nput h tag 0x1234\nput h val 0x01020304\nput h arr 2 99\nend\nfn main to int\nb = new uchar 12 0\nfill b\nret int and add ulong get b 0 add ulong get b 7 ulong get b 10 255\nend\n"

text tc_n16 "c16_runtime_pool"
text tc_p16 "om2\nglobal p_dat ulong *\nfn main to int\nr = enlarge p_dat 8\nif lt r 0\nret 1\nend\nfor i ulong len p_dat bound 16\nput p_dat i mul i 5\nend\ns = ulong 0\nfor i ulong len p_dat bound 16\ns = add s get p_dat i\nend\nret int and s 255\nend\n"

text tc_n17 "c17_comments_borrow"
text tc_p17 "om2\nnote verify comments, fresh scratch, and explicit view/edit arguments\nfn work src view uchar 8 tmp edit uchar 8 fresh to ulong\nfor i ulong 8 unroll\nput tmp i xor get src i 0x5a\nend\ns = ulong 0\nfor i ulong 8\ns = add s ulong get tmp i\nend\nret s\nend\nfn main to int\na = new uchar 8 7\nt = new uchar 8 0\nret int and work view a edit t 255\nend\n"

text tc_n18 "c18_chacha_qr"
text tc_p18 "om2\nfn qr x edit uint 16 q ulong to void inline\na = get x and q 15\nb = get x and shr q 8 15\nc = get x and shr q 16 15\nd = get x and shr q 24 15\na = add a b\nd = rotl xor d a 16\nc = add c d\nb = rotl xor b c 12\na = add a b\nd = rotl xor d a 8\nc = add c d\nb = rotl xor b c 7\nput x and q 15 a\nput x and shr q 8 15 b\nput x and shr q 16 15 c\nput x and shr q 24 15 d\nend\nfn main to int\ns = new uint 16 0\nfor i ulong 16 unroll\nput s i uint add mul i 7 3\nend\nfor i ulong 4 unroll\nqr s or or or i shl add i 4 8 shl add i 8 16 shl add i 12 24\nend\nret int and get s 0 255\nend\n"

note ---- 4 Direct Hand-Written Infix vs Hand-Written Prefix Equivalence Cases ----------------
text td_n01 "d01_brief_fn"
text td_i01 "om2\nfn foo(a: ulong, b: ulong, buf: edit [uchar; 16], i: ulong, v: ulong) -> ulong { x = (a * 8) + b; buf[i * 4 + 2] = uchar((v >> 16) & 255); if x == 0 { return 1 } return x }\nfn main() -> int {\n  buf = new [uchar; 16](0)\n  r = foo(3, 5, buf, 2, 0x00ab1234)\n  return int((r + ulong(buf[10])) & 255)\n}\n"
text td_p01 "om2\nfn foo a ulong b ulong buf edit uchar 16 i ulong v ulong to ulong\nx = add mul a 8 b\nput buf add mul i 4 2 uchar and shr v 16 255\nif eq x 0\nret 1\nend\nret x\nend\nfn main to int\nbuf = new uchar 16 0\nr = foo 3 5 buf 2 0x00ab1234\nret int and add r ulong get buf 10 255\nend\n"

text td_n02 "d02_let_compound_elseif"
text td_i02 "om2\nfn score(n: ulong) -> ulong {\n  let s = ulong(0)\n  s += n\n  s *= 3\n  if s < 10 {\n    return 1\n  } else if s < 30 {\n    return 2\n  } else {\n    return 3\n  }\n}\nfn main() -> int {\n  return int(score(2) + score(6) + score(12))\n}\n"
text td_p02 "om2\nfn score n ulong to ulong\ns = ulong 0\ns = add s n\ns = mul s 3\nif lt s 10\nret 1\nelse\nif lt s 30\nret 2\nelse\nret 3\nend\nend\nend\nfn main to int\nret int add add score 2 score 6 score 12\nend\n"

text td_n03 "d03_gcd_while_for"
text td_i03 "om2\n// Euclidean GCD + range loop\nfn gcd(a: uint, b: uint) -> uint {\n  while b != 0 bound 100 { t = a % b; a = b; b = t }\n  return a\n}\nfn main() -> int {\n  s = ulong(0)\n  for i in 0..8 {\n    s = s + ulong(gcd(uint(i + 12), 18))\n  }\n  return int(s & 255)\n}\n"
text td_p03 "om2\nnote Euclidean GCD + range loop\nfn gcd a uint b uint to uint\nwhile ne b 0 bound 100\nt = rem a b\na = b\nb = t\nend\nret a\nend\nfn main to int\ns = ulong 0\nfor i ulong 8\ns = add s ulong gcd uint add i 12 18\nend\nret int and s 255\nend\n"

text td_n04 "d04_slices_decls"
text td_i04 "om2\nconst BASE: ulong = 7;\nglobal g_tab: [ulong; 8];\ntext g_tag = \"ok\\n\";\nfn acc(v: view [ulong; *]) -> ulong {\n  s = ulong(0)\n  for i in 0..len(v) {\n    s = s + v[i]\n  }\n  return s\n}\nfn main() -> int {\n  a = new [ulong; 8](0)\n  for i in 0..8 {\n    a[i] = i + BASE\n    g_tab[i] = a[i]\n  }\n  w = write(1, g_tag, 0, len(g_tag))\n  return int((acc(part(a, 2, 4)) + g_tab[3] + ulong(w)) & 255)\n}\n"
text td_p04 "om2\nconst BASE ulong 7\nglobal g_tab ulong 8\ntext g_tag \"ok\\n\"\nfn acc v view ulong * to ulong\ns = ulong 0\nfor i ulong len v\ns = add s get v i\nend\nret s\nend\nfn main to int\na = new ulong 8 0\nfor i ulong 8\nput a i add i BASE\nput g_tab i get a i\nend\nw = write 1 g_tag 0 len g_tag\nret int and add add acc part a 2 4 get g_tab 3 ulong w 255\nend\n"

note ---- 14 Fail-Closed Negative Control Cases -----------------------------------------------
text tn_n01 "neg01_chained_cmp"

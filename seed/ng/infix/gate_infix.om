note ---- Output and Formatting Helpers -------------------------------------------------------
fn gi_w s view uchar * to void
r = write 1 s 0 len s
end

fn gi_wn v ulong to void
x = v
i = ulong 32
for j ulong 21
i = sub i 1
put gi_dig i uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 gi_dig i sub 32 i
ret
end
end
end

fn gi_wh1 to void
r = write 1 gi_h1 0 64
end

note ---- Path and File Helpers ---------------------------------------------------------------
fn gi_pclr to void
put gi_n 5 0
end

fn gi_pc c ulong to void
n = get gi_n 5
if lt n len gi_pa
put gi_pa n uchar c
put gi_n 5 add n 1
end
end

fn gi_ps_txt s view uchar * to void
for i ulong len s bound 2048
gi_pc ulong get s i
end
end

fn gi_ps_scr suf view uchar * to void
gi_pclr
sn = get gi_n 4
for i ulong sn bound 1024
gi_pc ulong get gi_scr i
end
gi_ps_txt suf
end

fn gi_ps_omc to void
gi_pclr
for i ulong get gi_n 0 bound 1024
gi_pc ulong get gi_omc i
end
end

fn gi_ps_ng to void
gi_pclr
for i ulong get gi_n 1 bound 1024
gi_pc ulong get gi_ng i
end
end

fn gi_ps_ck to void
gi_pclr
for i ulong get gi_n 2 bound 1024
gi_pc ulong get gi_ck i
end
end

fn gi_ps_fmt to void
gi_pclr
for i ulong get gi_n 3 bound 1024
gi_pc ulong get gi_fmt i
end
end

fn gi_fclo fd int to void
if ge fd 0
r = fclose fd
end
end

fn gi_rdonly to int
r = fopen gi_pa 0 get gi_n 5 524288 420
if lt r 0
ret -1
end
ret int r
end

fn gi_wronly ex bool to int
r = unlink gi_pa 0 get gi_n 5
md = int 420
if ex
md = 493
end
x = fopen gi_pa 0 get gi_n 5 524865 md
if lt x 0
ret -1
end
ret int x
end

fn gi_write_buf suf view uchar * src view uchar * to bool
gi_ps_scr suf
fd = gi_wronly false
if lt fd 0
ret false
end
n = len src
o = ulong 0
while lt o n bound 1048577
k = write fd src o sub n o
if le k 0
gi_fclo fd
ret false
end
o = add o ulong k
end
gi_fclo fd
ret true
end

fn gi_write_ngin suf view uchar * src_suf view uchar * to bool
gi_ps_scr src_suf
fd1 = gi_rdonly
if lt fd1 0
ret false
end
n = ulong 0
while lt n len gi_b1 bound 1048577
k = read fd1 gi_b1 n sub len gi_b1 n
if lt k 0
gi_fclo fd1
ret false
end
if eq k 0
break
end
n = add n ulong k
end
gi_fclo fd1
gi_ps_scr suf
fd2 = gi_wronly false
if lt fd2 0
ret false
end
k1 = write fd2 gi_s_front_ir 0 len gi_s_front_ir
if ne k1 long len gi_s_front_ir
gi_fclo fd2
ret false
end
o = ulong 0
while lt o n bound 1048577
k2 = write fd2 gi_b1 o sub n o
if le k2 0
gi_fclo fd2
ret false
end
o = add o ulong k2
end
gi_fclo fd2
ret true
end

fn gi_slurp_scr suf view uchar * dst ulong to ulong
gi_ps_scr suf
fd = gi_rdonly
if lt fd 0
ret shl ulong 1 63
end
n = ulong 0
while lt n len gi_b1 bound 1048577
k = long 0
if eq dst 1
k = read fd gi_b1 n sub len gi_b1 n
else
k = read fd gi_b2 n sub len gi_b2 n
end
if lt k 0
gi_fclo fd
ret shl ulong 1 63
end
if eq k 0
break
end
n = add n ulong k
end
gi_fclo fd
if eq dst 1
put gi_n 16 n
else
put gi_n 17 n
end
ret n
end

fn gi_b1_eq_b2 to bool
n1 = get gi_n 16
n2 = get gi_n 17
if ne n1 n2
ret false
end
for i ulong n1 bound 1048576
if ne get gi_b1 i get gi_b2 i
ret false
end
end
ret true
end

fn gi_cmp_files s1 view uchar * s2 view uchar * to bool
n1 = gi_slurp_scr s1 1
n2 = gi_slurp_scr s2 2
if or ge n1 shl ulong 1 63 ge n2 shl ulong 1 63
ret false
end
ret gi_b1_eq_b2
end

fn gi_sha_b1 to void
n = get gi_n 16
for i ulong n bound 1048576
put sh_dat i get gi_b1 i
end
sh_all n
for i ulong 32
b = uint get sh_dig i
put gi_h1 mul i 2 sh_hexd shr b 4
put gi_h1 add mul i 2 1 sh_hexd and b 15
end
end

fn gi_sha_b2 to void
n = get gi_n 17
for i ulong n bound 1048576
put sh_dat i get gi_b2 i
end
sh_all n
for i ulong 32
b = uint get sh_dig i
put gi_h2 mul i 2 sh_hexd shr b 4
put gi_h2 add mul i 2 1 sh_hexd and b 15
end
end

fn gi_ck_matches_h1 to bool
n = get gi_n 16
if lt n 71
ret false
end
for i ulong 7
if ne get gi_b1 i get gi_s_acc i
ret false
end
end
for i ulong 64
if ne get gi_b1 add 7 i get gi_h1 i
ret false
end
end
ret true
end

note ---- Subprocess Execution Helpers --------------------------------------------------------
fn gi_aclr to void
put gi_n 6 2
put gi_n 7 0
end

fn gi_apa to void
p = get gi_n 6
n = get gi_n 5
for j ulong n bound 2048
put gi_av add add p 2 j get gi_pa j
end
put gi_av p uchar and n 255
put gi_av add p 1 uchar shr n 8
put gi_n 6 add p add n 2
c = add get gi_n 7 1
put gi_n 7 c
put gi_av 0 uchar and c 255
put gi_av 1 uchar shr c 8
end

fn gi_redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end

fn gi_spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
gi_fclo fi
gi_fclo fo
gi_fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
gi_redir fi 0
gi_redir fo 1
gi_redir fe 2
r = execprog gi_av 0 get gi_n 6
exit 127
end
gi_fclo fi
gi_fclo fo
gi_fclo fe
r = waitpid int pid gi_stb 0 len gi_stb 0
if ne r pid
exit 2
end
sig = ulong get gi_stb 0
if ne sig 0
ret add 256 sig
end
ret ulong get gi_stb 1
end

fn gi_open_in_scr suf view uchar * to int
gi_ps_scr suf
ret gi_rdonly
end

fn gi_open_nul to int
gi_pclr
gi_ps_txt gi_s_nul
ret gi_rdonly
end

fn gi_run_fmt mode ulong in_s view uchar * out_s view uchar * to ulong
gi_aclr
gi_ps_fmt
gi_apa
gi_pclr
if eq mode 1
gi_ps_txt gi_s_to_ix
else
gi_ps_txt gi_s_to_px
end
gi_apa
fi = gi_open_in_scr in_s
gi_ps_scr out_s
fo = gi_wronly false
gi_ps_scr gi_s_e0
fe = gi_wronly false
ret gi_spawn fi fo fe
end

fn gi_run_omc in_s view uchar * bin_s view uchar * err_s view uchar * to ulong
gi_aclr
gi_ps_omc
gi_apa
fi = gi_open_in_scr in_s
gi_ps_scr bin_s
fo = gi_wronly true
gi_ps_scr err_s
fe = gi_wronly false
ret gi_spawn fi fo fe
end

fn gi_run_bin bin_s view uchar * out_s view uchar * err_s view uchar * to ulong
gi_aclr
gi_ps_scr bin_s
gi_apa
fi = gi_open_nul
gi_ps_scr out_s
fo = gi_wronly false
gi_ps_scr err_s
fe = gi_wronly false
ret gi_spawn fi fo fe
end

fn gi_run_ng in_s view uchar * out_s view uchar * err_s view uchar * to ulong
gi_aclr
gi_ps_ng
gi_apa
fi = gi_open_in_scr in_s
gi_ps_scr out_s
fo = gi_wronly false
gi_ps_scr err_s
fe = gi_wronly false
ret gi_spawn fi fo fe
end

fn gi_run_ck in_s view uchar * out_s view uchar * err_s view uchar * to ulong
gi_aclr
gi_ps_ck
gi_apa
fi = gi_open_in_scr in_s
gi_ps_scr out_s
fo = gi_wronly false
gi_ps_scr err_s
fe = gi_wronly false
ret gi_spawn fi fo fe
end

note ---- Core Verification Routines ----------------------------------------------------------
note Verify p0.om and p1.om (already written in SCRATCH) compile via omc with identical exit+stdout
note AND lower via @ng front-ir + ngcheck to bit-identical OIR & SHA-256 SEMANTIC_ID
fn gi_verify_pair name view uchar * to bool
if ne gi_run_omc gi_s_p0 gi_s_bin0 gi_s_e0 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_omc
gi_w gi_s_nl
ret false
end
if ne gi_run_omc gi_s_p1 gi_s_bin1 gi_s_e1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_omc
gi_w gi_s_nl
ret false
end
ex0 = gi_run_bin gi_s_bin0 gi_s_o0 gi_s_e0
ex1 = gi_run_bin gi_s_bin1 gi_s_o1 gi_s_e1
if or ne ex0 ex1 not gi_cmp_files gi_s_o0 gi_s_o1
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_run
gi_w gi_s_nl
ret false
end
if not gi_write_ngin gi_s_ngin0 gi_s_p0
ret false
end
if not gi_write_ngin gi_s_ngin1 gi_s_p1
ret false
end
if ne gi_run_ng gi_s_ngin0 gi_s_ir0 gi_s_e0 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ng
gi_w gi_s_nl
ret false
end
if ne gi_run_ng gi_s_ngin1 gi_s_ir1 gi_s_e1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ng
gi_w gi_s_nl
ret false
end
if ne gi_run_ck gi_s_ir0 gi_s_ck0 gi_s_e0 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ck
gi_w gi_s_nl
ret false
end
if ne gi_run_ck gi_s_ir1 gi_s_ck1 gi_s_e1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ck
gi_w gi_s_nl
ret false
end
if not gi_cmp_files gi_s_ir0 gi_s_ir1
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ir
gi_w gi_s_nl
ret false
end
gi_sha_b1
gi_sha_b2
ig = gi_slurp_scr gi_s_ck0 1
if not gi_ck_matches_h1
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ir
gi_w gi_s_nl
ret false
end
gi_w gi_s_ok
gi_w name
gi_w gi_s_ex_eq
gi_wn ex0
gi_w gi_s_sem
gi_wh1
gi_w gi_s_nl
ret true
end

note Round-trip test: prefix -> --to-infix -> --to-prefix -> idempotence -> omc + @ng front-ir
fn gi_test_rt name view uchar * src view uchar * to void
if not gi_write_buf gi_s_p0 src
put gi_n 9 add get gi_n 9 1
ret
end
if ne gi_run_fmt 1 gi_s_p0 gi_s_ix1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ix
gi_w gi_s_nl
put gi_n 9 add get gi_n 9 1
ret
end
if ne gi_run_fmt 2 gi_s_ix1 gi_s_p1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_px
gi_w gi_s_nl
put gi_n 9 add get gi_n 9 1
ret
end
if ne gi_run_fmt 1 gi_s_p1 gi_s_ix2 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_ix
gi_w gi_s_nl
put gi_n 9 add get gi_n 9 1
ret
end
if not gi_cmp_files gi_s_ix1 gi_s_ix2
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_id
gi_w gi_s_nl
put gi_n 9 add get gi_n 9 1
ret
end
if gi_verify_pair name
put gi_n 8 add get gi_n 8 1
else
put gi_n 9 add get gi_n 9 1
end
end

note Direct hand-written infix vs hand-written prefix SEMANTIC_ID & execution equivalence
fn gi_test_direct name view uchar * ixsrc view uchar * pxsrc view uchar * to void
note Also verify direct library call ix_lower matches om-fmt --to-prefix
n = len ixsrc
for i ulong n bound 262144
put ix_src i get ixsrc i
end
put ix_slen 0 n
if ne ix_lower 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_lib
gi_w gi_s_nl
put gi_n 11 add get gi_n 11 1
ret
end
if not gi_write_buf gi_s_p0 pxsrc
put gi_n 11 add get gi_n 11 1
ret
end
if not gi_write_buf gi_s_ix1 ixsrc
put gi_n 11 add get gi_n 11 1
ret
end
if ne gi_run_fmt 2 gi_s_ix1 gi_s_p1 0
gi_w gi_s_fl
gi_w name
gi_w gi_s_r_px
gi_w gi_s_nl
put gi_n 11 add get gi_n 11 1
ret
end
if gi_verify_pair name
put gi_n 10 add get gi_n 10 1
else
put gi_n 11 add get gi_n 11 1
end
end

note Negative control: infix must fail-closed with expected ix_lower error AND nonzero om-fmt exit
fn gi_test_neg name view uchar * bad view uchar * exp_rc ulong to void
n = len bad
for i ulong n bound 262144
put ix_src i get bad i
end
put ix_slen 0 n
lrc = ix_lower
if ne lrc exp_rc
gi_w gi_s_neg_fl
gi_w name
gi_w gi_s_rc
gi_wn lrc
gi_w gi_s_nl
put gi_n 13 add get gi_n 13 1
ret
end
if not gi_write_buf gi_s_ix1 bad
put gi_n 13 add get gi_n 13 1
ret
end
frc = gi_run_fmt 2 gi_s_ix1 gi_s_p1
if eq frc 0
gi_w gi_s_neg_fl
gi_w name
gi_w gi_s_rc
gi_wn frc
gi_w gi_s_nl
put gi_n 13 add get gi_n 13 1
ret
end
gi_w gi_s_neg_ok
gi_w name
gi_w gi_s_rc
gi_wn frc
gi_w gi_s_nl
put gi_n 12 add get gi_n 12 1
end

fn gi_test_neg_prefix to void
if not gi_write_buf gi_s_p0 tn_s14
put gi_n 13 add get gi_n 13 1
ret
end
frc = gi_run_fmt 1 gi_s_p0 gi_s_ix1
if eq frc 0
gi_w gi_s_neg_fl
gi_w tn_n14
gi_w gi_s_rc
gi_wn frc
gi_w gi_s_nl
put gi_n 13 add get gi_n 13 1
ret
end
gi_w gi_s_neg_ok
gi_w tn_n14
gi_w gi_s_rc
gi_wn frc
gi_w gi_s_nl
put gi_n 12 add get gi_n 12 1
end

fn gi_test_neg_cli to void
gi_aclr
gi_ps_fmt
gi_apa
gi_pclr
gi_ps_txt gi_s_bogus
gi_apa
fi = gi_open_nul
gi_ps_scr gi_s_o0
fo = gi_wronly false
gi_ps_scr gi_s_e0
fe = gi_wronly false
rc = gi_spawn fi fo fe
if ne rc 2
gi_w gi_s_neg_fl
gi_w gi_s_bogus
gi_w gi_s_rc
gi_wn rc
gi_w gi_s_nl
put gi_n 13 add get gi_n 13 1
ret
end
gi_w gi_s_neg_ok
gi_w gi_s_bogus
gi_w gi_s_rc
gi_wn rc
gi_w gi_s_nl
put gi_n 12 add get gi_n 12 1
end

note External real-world .om file round-trip test (argv[k])
fn gi_test_ext arg_idx ulong to void
al = argread arg_idx gi_ex 0 len gi_ex
if le al 0
put gi_n 15 add get gi_n 15 1
ret
end
gi_pclr
for i ulong ulong al bound 1024
gi_pc ulong get gi_ex i
end
fd = gi_rdonly
if lt fd 0
put gi_n 15 add get gi_n 15 1
ret
end
n = ulong 0
while lt n len gi_b1 bound 1048577
k = read fd gi_b1 n sub len gi_b1 n
if lt k 0
gi_fclo fd
put gi_n 15 add get gi_n 15 1
ret
end
if eq k 0
break
end
n = add n ulong k
end
gi_fclo fd
gi_ps_scr gi_s_p0
fd2 = gi_wronly false
if lt fd2 0
put gi_n 15 add get gi_n 15 1
ret
end
o = ulong 0
while lt o n bound 1048577
k2 = write fd2 gi_b1 o sub n o
if le k2 0
gi_fclo fd2
put gi_n 15 add get gi_n 15 1
ret
end
o = add o ulong k2
end
gi_fclo fd2
if ne gi_run_fmt 1 gi_s_p0 gi_s_ix1 0
gi_w gi_s_fl
r_e1 = write 1 gi_ex 0 ulong al
gi_w gi_s_r_ix
gi_w gi_s_nl
put gi_n 15 add get gi_n 15 1
ret
end
if ne gi_run_fmt 2 gi_s_ix1 gi_s_p1 0
gi_w gi_s_fl
r_e2 = write 1 gi_ex 0 ulong al
gi_w gi_s_r_px
gi_w gi_s_nl
put gi_n 15 add get gi_n 15 1
ret
end
if ne gi_run_fmt 1 gi_s_p1 gi_s_ix2 0
gi_w gi_s_fl
r_e3 = write 1 gi_ex 0 ulong al
gi_w gi_s_r_ix
gi_w gi_s_nl
put gi_n 15 add get gi_n 15 1
ret
end
if not gi_cmp_files gi_s_ix1 gi_s_ix2
gi_w gi_s_fl
r_e4 = write 1 gi_ex 0 ulong al
gi_w gi_s_r_id
gi_w gi_s_nl
put gi_n 15 add get gi_n 15 1
ret
end
if gi_verify_pair gi_s_ext
gi_w gi_s_sp
r_ex = write 1 gi_ex 0 ulong al
gi_w gi_s_nl
put gi_n 14 add get gi_n 14 1
else
put gi_n 15 add get gi_n 15 1
end
end

fn gi_run_all_rt to void
gi_test_rt tc_n01 tc_p01
gi_test_rt tc_n02 tc_p02
gi_test_rt tc_n03 tc_p03
gi_test_rt tc_n04 tc_p04
gi_test_rt tc_n05 tc_p05
gi_test_rt tc_n06 tc_p06
gi_test_rt tc_n07 tc_p07
gi_test_rt tc_n08 tc_p08
gi_test_rt tc_n09 tc_p09
gi_test_rt tc_n10 tc_p10
gi_test_rt tc_n11 tc_p11
gi_test_rt tc_n12 tc_p12
gi_test_rt tc_n13 tc_p13
gi_test_rt tc_n14 tc_p14
gi_test_rt tc_n15 tc_p15
gi_test_rt tc_n16 tc_p16
gi_test_rt tc_n17 tc_p17
gi_test_rt tc_n18 tc_p18
end

fn gi_run_all_direct to void
gi_test_direct td_n01 td_i01 td_p01
gi_test_direct td_n02 td_i02 td_p02
gi_test_direct td_n03 td_i03 td_p03
gi_test_direct td_n04 td_i04 td_p04
end

fn gi_run_all_neg to void
gi_test_neg tn_n01 tn_s01 IX_ERR_PRECEDENCE
gi_test_neg tn_n02 tn_s02 IX_ERR_PRECEDENCE
gi_test_neg tn_n03 tn_s03 IX_ERR_UNCLOSED_BRACE
gi_test_neg tn_n04 tn_s04 IX_ERR_UNEXPECTED_BRACE
gi_test_neg tn_n05 tn_s05 IX_ERR_UNCLOSED_PAREN
gi_test_neg tn_n06 tn_s06 IX_ERR_INVALID_OP
gi_test_neg tn_n07 tn_s07 IX_ERR_INVALID_OP
gi_test_neg tn_n08 tn_s08 IX_ERR_INVALID_OP
gi_test_neg tn_n09 tn_s09 IX_ERR_RESERVED
gi_test_neg tn_n10 tn_s10 IX_ERR_RESERVED
gi_test_neg tn_n11 tn_s11 IX_ERR_RESERVED
gi_test_neg tn_n12 tn_s12 IX_ERR_RANGE
gi_test_neg tn_n13 tn_s13 IX_ERR_RANGE
gi_test_neg_prefix
gi_test_neg_cli
end

fn gi_load_args to bool
l0 = argread 1 gi_omc 0 len gi_omc
if le l0 0
ret false
end
put gi_n 0 ulong l0
l1 = argread 2 gi_ng 0 len gi_ng
if le l1 0
ret false
end
put gi_n 1 ulong l1
l2 = argread 3 gi_ck 0 len gi_ck
if le l2 0
ret false
end
put gi_n 2 ulong l2
l3 = argread 4 gi_fmt 0 len gi_fmt
if le l3 0
ret false
end
put gi_n 3 ulong l3
l4 = argread 5 gi_scr 0 len gi_scr
if le l4 0
ret false
end
put gi_n 4 ulong l4
ret true
end

fn main to int
ac = argcnt
if lt ac 6
r = write 2 gi_s_usage 0 len gi_s_usage
ret 2
end
if not gi_load_args
r = write 2 gi_s_usage 0 len gi_s_usage
ret 2
end
gi_run_all_rt
gi_run_all_direct
gi_run_all_neg
if gt ac 6
for k ulong sub ulong ac 6 bound 64
gi_test_ext add 6 k
end
end
fails = add get gi_n 9 get gi_n 11
fails = add fails get gi_n 13
fails = add fails get gi_n 15
if eq fails 0
gi_w gi_s_pass
else
gi_w gi_s_fail
end
gi_wn get gi_n 8
gi_w gi_s_dir
gi_wn get gi_n 10
gi_w gi_s_neg
gi_wn get gi_n 12
gi_w gi_s_ext
gi_wn get gi_n 14
gi_w gi_s_fails
gi_wn fails
gi_w gi_s_nl
if ne fails 0
ret 1
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/infix/gate_infix.om: Pure Seeded OM-2 Verification Gate for Dual Surface Syntax.
note Linked after seed/ng/sha256.om and seed/ng/infix/infix_front.om:
note   (printf 'om2\n'; cat seed/ng/sha256.om seed/ng/infix/infix_front.om seed/ng/infix/gate_infix.om) \
note     | seed/out/omc > gate_infix
note
note Run on Spark:
note   ./gate_infix OMC NG NGCHECK OM_FMT SCRATCH [EXTRA_OM_FILE ...]
note
note Proves:
note   (a) 18 built-in Omega construct round-trips (plus any external .om files passed on argv):
note       prefix -> om-fmt --to-infix -> om-fmt --to-prefix ->
note       1. idempotence: second --to-infix matches first byte-for-byte
note       2. seed/out/omc compiles BOTH original and round-tripped prefix; execution produces
note          bit-identical exit status and stdout bytes
note       3. @ng front-ir lowers BOTH to canonical OIR; ngcheck ACCEPTs BOTH; SHA-256 SEMANTIC_ID
note          and raw OIR bytes are bit-for-bit identical
note   (b) 4 direct hand-written infix vs hand-written prefix equivalence tests (both ix_lower and
note       om-fmt --to-prefix produce bit-identical execution and identical OIR SEMANTIC_ID)
note   (c) 14 fail-closed negative controls (malformed precedence, unclosed/extra braces, unclosed
note       parens, invalid operators **, ===, @, reserved words as var/fn/val, nonzero for start,
note       bound 0, malformed prefix to --to-infix, invalid CLI flag)

global gi_omc uchar 1024
global gi_ng uchar 1024
global gi_ck uchar 1024
global gi_fmt uchar 1024
global gi_scr uchar 1024
global gi_pa uchar 2048
global gi_av uchar 8192
global gi_stb uchar 4
global gi_b1 uchar 1048576
global gi_b2 uchar 1048576
global gi_h1 uchar 64
global gi_h2 uchar 64
global gi_dig uchar 32
global gi_ex uchar 1024

note gi_n: 0=omc_l 1=ng_l 2=ck_l 3=fmt_l 4=scr_l 5=pa_l 6=av_l 7=av_c
note       8=rt_pass 9=rt_fail 10=dir_pass 11=dir_fail 12=neg_pass 13=neg_fail
note       14=ext_pass 15=ext_fail 16=b1_l 17=b2_l
global gi_n ulong 24


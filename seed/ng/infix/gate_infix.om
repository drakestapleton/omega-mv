text tn_n12 "neg12_bad_for_range"
text tn_s12 "om2\nfn main() -> int {\n  for i in 1..10 { }\n  return 0\n}\n"

text tn_n13 "neg13_bad_bound_zero"
text tn_s13 "om2\nfn main() -> int {\n  while false bound 0 { }\n  return 0\n}\n"

text tn_n14 "neg14_bad_prefix_to_infix"

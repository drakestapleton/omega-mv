fn fm_push_blk tag ulong to void
bt = get fm_btop 0
if ge bt FM_MAX_BLKS
ix_fail IX_ERR_DEPTH get fm_line 0
ret
end
put fm_blk bt uchar tag
put fm_btop 0 add bt 1
end

fn fm_emit_fn_param i ulong wc ulong to ulong
pn = i
ix_otok pn
ix_os fm_s_col_sp
j = add i 1
if ge j wc
ix_fail IX_ERR_SYNTAX get fm_line 0
ret wc
end
if or fm_w_eq j ix_s_view or fm_w_eq j ix_s_edit fm_w_eq j ix_s_out
is_ed = fm_w_eq j ix_s_edit
ix_otok j
ix_osp
j = add j 1
ty = j
j = add j 1
if ix_is_type ty
ix_oc 91
ix_otok ty
ix_os fm_s_semi_sp
ix_otok j
ix_oc 93
j = add j 1
fm_add_loc ulong get ix_tpos pn ulong get ix_tlen pn 2
if and is_ed lt j wc
if fm_w_eq j ix_s_fresh
ix_osp
ix_os ix_s_fresh
j = add j 1
end
end
else
ix_otok ty
si = fm_find_st ulong get ix_tpos ty ulong get ix_tlen ty
if lt si FM_MAX_STRS
fm_add_loc ulong get ix_tpos pn ulong get ix_tlen pn add 3 si
end
end
ret j
end
ix_otok j
if fm_w_eq j fm_s_bool
fm_add_loc ulong get ix_tpos pn ulong get ix_tlen pn 1
else
fm_add_loc ulong get ix_tpos pn ulong get ix_tlen pn 0
end
ret add j 1
end

fn fm_emit_fn_line is_exp bool wi0 ulong to void
wc = get ix_tcnt 0
if ge wi0 wc

fn fm_to_infix to ulong
put ix_olen 0 0
put ix_st 0 0
put ix_st 1 0
put ix_st 3 0
put fm_btop 0 0
put fm_ind 0 0
put fm_line 0 1
fm_pass1
n = get ix_slen 0
p = ulong 0
ln = ulong 1
while and lt p n ix_ok bound 262144
put fm_line 0 ln
lend = p
while and lt lend n ne ix_byte lend 10 bound 16384
lend = add lend 1
end
tr = lend
if and gt tr p eq ix_byte sub tr 1 13
tr = sub tr 1
end
fm_lex_line p tr
wc = get ix_tcnt 0
if eq wc 0
ix_onl
else
if fm_w_eq 0 ix_s_note
fm_indent
ix_os fm_s_sl_sl
nend = add ulong get ix_tpos 0 ulong get ix_tlen 0
if lt nend tr
ix_osrc nend sub tr nend
end
ix_onl
else
bt = get fm_btop 0
if eq bt 0
fm_emit_top_line p tr
else
if eq ulong get fm_blk sub bt 1 FM_BLK_LAYOUT
fm_emit_layout_line
else
fm_emit_stmt_line
end
end
end
end
if lt lend n
p = add lend 1
else
p = lend
end
ln = add ln 1
end
if and ix_ok ne get fm_btop 0 0
ix_fail IX_ERR_UNCLOSED_BRACE ln
end
ret get ix_st 0
end

note ---- CLI Driver (stdin -> stdout) ---------------------------------------------------------
fn fm_arg_eq n ulong s view uchar * to bool
if ne n len s
ret false
end
for i ulong n bound 64
if ne get fm_argb i get s i
ret false
end
end
ret true
end

fn fm_read_stdin to bool
n = ulong 0
while lt n IX_SRC_CAP bound 262145
k = read 0 ix_src n sub IX_SRC_CAP n
if lt k 0
ret false
end
if eq k 0
put ix_slen 0 n
ret true
end
n = add n ulong k
end
ret false
end

fn fm_write_stdout to bool
n = get ix_olen 0
o = ulong 0
while lt o n bound 524289
k = write 1 ix_out o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end

fn main to int
ac = argcnt
if ne ac 2
r = write 2 fm_s_usage 0 len fm_s_usage
ret 2
end
al = argread 1 fm_argb 0 len fm_argb
if lt al 0
r = write 2 fm_s_usage 0 len fm_s_usage
ret 2
end
md = ulong 0
if fm_arg_eq ulong al fm_s_to_infix
md = 1
end
if fm_arg_eq ulong al fm_s_to_prefix
md = 2
end
if eq md 0
r = write 2 fm_s_usage 0 len fm_s_usage
ret 2
end
if not fm_read_stdin
r = write 2 fm_s_err_io 0 len fm_s_err_io
ret 3
end
rc = ulong 0
if eq md 1
rc = fm_to_infix
if ne rc 0
r1 = write 2 fm_s_err_pfx 0 len fm_s_err_pfx
ix_write_u 2 get ix_st 1
r2 = write 2 fm_s_err_mid 0 len fm_s_err_mid
ret int rc
end
else
rc = ix_lower
if ne rc 0
ix_write_err 2
ret int rc
end
end
if not fm_write_stdout
r = write 2 fm_s_err_io 0 len fm_s_err_io
ret 3
end
ret 0
end

ix_oc 40
i = add wi0 1
pno = ulong 0
while and lt i wc ix_ok bound 128
if fm_w_eq i ix_s_to
break
end
if gt pno 0
ix_os fm_s_com_sp
end
i = fm_emit_fn_param i wc
pno = add pno 1
end
if not ix_ok
ret
end
if or ge i wc not fm_w_eq i ix_s_to
ix_fail IX_ERR_SYNTAX get fm_line 0
ret
end
ix_oc 41
ix_os fm_s_arrow
i = add i 1
if ge i wc
ix_fail IX_ERR_SYNTAX get fm_line 0
ret
end
ix_otok i
i = add i 1
if lt i wc
if fm_w_eq i ix_s_inline
ix_osp
ix_os ix_s_inline
i = add i 1
end
end
if ne i wc
ix_fail IX_ERR_SYNTAX get fm_line 0
ret
end
ix_osp
ix_oc 123
ix_onl
fm_push_blk FM_BLK_FN
put fm_ind 0 add get fm_ind 0 1
end


vi = ulong 1
if eq fm_w_kind 1 IX_TK_ASSIGN
vi = 2
end
if ge vi wc
ix_fail IX_ERR_SYNTAX get fm_line 0
ret
end
note Special RHS: new T N init  or  new Struct v1 ... vn

note SPDX-License-Identifier: Apache-2.0
note seed/ng/replay/gate_replay.om: Standalone Pure-OM-2 Verification Gate for Stage 2
note (Pillar 4: Reversible & Counterfactual Time-Travel Execution).
note
note Link order (program mode; ir.om provides om2 at line 1):
note   cat seed/ng/src/ir.om seed/ng/sha256.om \
note       seed/ng/replay/tok_journal.om seed/ng/replay/slab_ckpt.om \
note       seed/ng/replay/cf_fork.om seed/ng/replay/state_stream.om \
note       seed/ng/replay/gate_replay.om | omc > gate_replay
note
note Usage:
note   gate_replay [NGRUN_BIN SCRATCH_DIR]

global gr_dig uchar 24
global gr_cnt ulong 4
note gr_cnt: 0 checks, 1 neg_controls, 2 live_checks, 3 live_negs

global gr_ngp uchar 2048
global gr_ngl ulong 1
global gr_scp uchar 2048
global gr_scl ulong 1
global gr_pa uchar 4096
global gr_pl ulong 1
global gr_pa2 uchar 4096
global gr_pl2 ulong 1
global gr_av uchar 16384
global gr_an ulong 2
global gr_st uchar 4
global gr_out uchar 65536
global gr_err uchar 65536
global gr_olen ulong 2
global gr_ref_dig uchar 128
global gr_saved_j uchar 4096
global gr_h uint 32

text gr_m_hdr "=== OMEGA NG STAGE 2 (REVERSIBLE & COUNTERFACTUAL REPLAY) GATE ===\n"
text gr_m_s1 "  [Stage 1] OTKJ v1 tok-journal + streaming + 6 neg controls: PASS (entries="
text gr_m_s2 "  [Stage 2] SLAB checkpoint rewind + bit-exact parity + 2 neg controls: PASS (ckpts="
text gr_m_s3 "  [Stage 3] Counterfactual 18-branch fork matrix: PASS (branches=18 diverged="
text gr_m_s4 "  [Stage 4] Semantic state-stream delta codec + 3 neg controls: PASS (raw="
text gr_m_s5 "  [Stage 5] Live ngrun trap-to-cause rewind + OTKJ verify + regression: PASS (live="
text gr_m_pass "GATE-REPLAY PASS checks="
text gr_m_neg " neg_controls="
text gr_m_live " live_checks="
text gr_m_lneg " live_neg="
text gr_m_fail "GATE-REPLAY FAIL code="
text gr_m_nl "\n"
text gr_m_cp ")\n"
text gr_m_bytes " bytes="
text gr_m_ratio "x)\n"
text gr_m_stream " stream="
text gr_m_comp " ratio="

text gr_f_j1 "/stage1_mem.otkj"
text gr_f_j2 "/stage1_stream.otkj"
text gr_f_b "/prog_bounds.ir"
text gr_f_d "/prog_divz.ir"
text gr_f_a "/prog_addovf.ir"
text gr_f_t "/prog_trap.ir"
text gr_f_ok "/prog_ok.ir"
text gr_f_jb "/bounds.otkj"
text gr_f_jd "/divz.otkj"
text gr_f_ja "/addovf.otkj"
text gr_f_jt "/trap.otkj"
text gr_f_jok "/ok.otkj"
text gr_f_out "/child.out"
text gr_f_err "/child.err"
text gr_f_in "/child.in"

text gr_a_rw "--rewind"
text gr_a_ce "--ckpt-every"
text gr_a_4 "4"
text gr_a_jn "--journal"

text gr_k_pfx "ngrun-rewind: trap="
text gr_k_t3 "trap=3 "
text gr_k_t2 "trap=2 "
text gr_k_t1 "trap=1 "
text gr_k_t9 "trap=9 "
text gr_k_par "replay_parity=EXACT"
text gr_k_op43 "cause_op=43 "
text gr_k_v99 "cause_val=99 "
text gr_k_v0 "cause_val=0 "
text gr_k_vmax "cause_val=2147483647 "
text gr_k_v5000 "cause_val=5000 "
text gr_k_ck0 "ckpt_step=0 "

fn gr_wrt s view uchar * to void
r = write 1 s 0 len s
end

fn gr_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gr_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 gr_dig p sub 24 p
ret
end
end
end

fn gr_fail code ulong to int
gr_wrt gr_m_fail
gr_num code
gr_wrt gr_m_nl
ret int code
end

fn gr_chk n ulong to void
put gr_cnt 0 add get gr_cnt 0 n
end

fn gr_neg to void
put gr_cnt 1 add get gr_cnt 1 1
end

fn gr_spath suf view uchar * dst ulong to void
n = get gr_scl 0
m = len suf
if eq dst 1
for i ulong n bound 2048
put gr_pa i get gr_scp i
end
for j ulong m bound 128
put gr_pa add n j get suf j
end
put gr_pl 0 add n m
else
if eq dst 2
for i ulong n bound 2048
put gr_pa2 i get gr_scp i
end
for j ulong m bound 128
put gr_pa2 add n j get suf j
end
put gr_pl2 0 add n m
else
for i ulong n bound 2048
put tj_path i get gr_scp i
end
for j ulong m bound 128
put tj_path add n j get suf j
end
put tj_plen 0 add n m
end
end
end

note ---- Stage 1: OTKJ v1 Hash-Chained tok Journal + Growable Pool + Streaming + 6 Neg Controls ----
fn gr_stage1_disk to int
gr_spath gr_f_j1 3
if ne tkj_write_path TKJ_OK
ret gr_fail 17
end
if ne tkj_read_path TKJ_OK
ret gr_fail 18
end
if or ne tkj_count 1200 ne tkj_entry_u64 777 1 mul ulong 777 17
ret gr_fail 19
end
tkj_set_alarm_bytes 4096
gr_spath gr_f_j2 3
if ne tkj_stream_open_path TKJ_OK
ret gr_fail 20
end
for i ulong 64
tkj_pack_u64x4 i add 9000 i 42 7
if ne tkj_stream_append TKJ_OP_HOST 1 i 32 TKJ_OK
ret gr_fail 21
end
end
if ne tkj_stream_close TKJ_OK
ret gr_fail 22
end
if ne tkj_alarm_tripped 1
ret gr_fail 23
end
if ne tkj_read_path TKJ_OK
ret gr_fail 24
end
if or ne tkj_count 64 ne tkj_entry_u64 63 1 9063
ret gr_fail 25
end
gr_chk 5
ret 0
end

fn gr_stage1_negs to int
if ne tkj_reset TKJ_OK
ret gr_fail 26
end
for i ulong 8
tkj_pack_u64x4 i add 100 i 55 99
if ne tkj_append TKJ_OP_STORE 2 i 32 TKJ_OK
ret gr_fail 27
end
end
sz = tkj_bytes
if ne tkj_verify_buf sz TKJ_OK
ret gr_fail 28
end
for j ulong sz bound 4096
b = get tj_buf j
put gr_saved_j j b
end

note NC-J1: Truncated frame -> TKJ_ERR_TRUNC (3)
if ne tkj_verify_buf sub sz 1 TKJ_ERR_TRUNC
ret gr_fail 29
end
gr_neg

note NC-J2: 1-bit flip in payload_bytes of entry 3 -> TKJ_ERR_HASH (8)
po = get tj_epoff 3
put tj_buf po xor get tj_buf po uchar 1
if ne tkj_verify_buf sz TKJ_ERR_HASH
ret gr_fail 30
end
put tj_buf po get gr_saved_j po
gr_neg

note NC-J3: 1-bit flip in entry_hash of entry 4 -> TKJ_ERR_HASH (8)
eh = add get tj_eoff 4 85
put tj_buf eh xor get tj_buf eh uchar 1
if ne tkj_verify_buf sz TKJ_ERR_HASH
ret gr_fail 31
end
put tj_buf eh get gr_saved_j eh
gr_neg

note NC-J4: 1-bit flip in prev_hash chain link of entry 5 -> TKJ_ERR_CHAIN (7)
ph = add get tj_eoff 5 53
put tj_buf ph xor get tj_buf ph uchar 1
if ne tkj_verify_buf sz TKJ_ERR_CHAIN
ret gr_fail 32
end
put tj_buf ph get gr_saved_j ph
gr_neg

note NC-J5: Duplicate/reordered seq in entry 2 -> TKJ_ERR_SEQ (5)
so = get tj_eoff 2
put tj_buf so uchar 1
if ne tkj_verify_buf sz TKJ_ERR_SEQ
ret gr_fail 33
end
put tj_buf so get gr_saved_j so
gr_neg

note NC-J6: Bad magic / trailing byte -> TKJ_ERR_MAGIC (1) & TKJ_ERR_TRAILING (4)
put tj_buf 0 uchar 88
if ne tkj_verify_buf sz TKJ_ERR_MAGIC
ret gr_fail 34
end
put tj_buf 0 get gr_saved_j 0
if ne tkj_ensure_buf add sz 1 TKJ_OK
ret gr_fail 35
end
put tj_buf sz uchar 0
if ne tkj_verify_buf add sz 1 TKJ_ERR_TRAILING
ret gr_fail 36
end
gr_neg
gr_chk 6
ret 0
end

fn gr_stage1 has_scr bool to int
if ne tkj_reset TKJ_OK
ret gr_fail 10
end
tkj_set_alarm_bytes 65536
for i ulong 1200
k = add rem i 12 1
tkj_pack_u64x4 i mul i 17 add i 1000 xor i 0x55aa
if ne tkj_append k rem i 8 rem i 16 32 TKJ_OK
ret gr_fail 11
end
end
if ne tkj_count 1200
ret gr_fail 12
end
if ne tkj_alarm_tripped 1
ret gr_fail 13
end
tot = tkj_bytes
if lt tot 140000
ret gr_fail 14
end
if ne tkj_verify_buf tot TKJ_OK
ret gr_fail 15
end
if ne tkj_entry_u64 1199 1 mul ulong 1199 17
ret gr_fail 16
end
gr_chk 7
if has_scr
rd = gr_stage1_disk
if ne rd 0
ret rd
end
end
rn = gr_stage1_negs
if ne rn 0
ret rn
end
gr_wrt gr_m_s1
gr_num 1200
gr_wrt gr_m_bytes
gr_num tot
gr_wrt gr_m_cp
ret 0
end

note ---- Stage 2: Periodic SLAB Checkpoints + Bit-Exact Forward vs. Backward Rewind Parity ----
fn gr_s2_write_slot off ulong r0 ulong r1 ulong r2 ulong step ulong to void
for j ulong 8
s = mul j 8
put sc_slab add off j uchar and shr r0 s 255
put sc_slab add add off 8 j uchar and shr r1 s 255
put sc_slab add add off 16 j uchar and shr r2 s 255
put sc_slab add add off 24 j uchar and shr step s 255
end
end

fn gr_s2_step step ulong to void
put sc_vm 0 step
put sc_vm 1 rem step 4
put sc_vm 2 rem step 7
put sc_vm 3 add get sc_vm 3 1
r0 = add get sc_regs 0 add mul step 13 7
r1 = xor get sc_regs 1 mul step 2654435761
r2 = add get sc_regs 2 rem r1 97
put sc_regs 0 r0
put sc_regs 1 r1
put sc_regs 2 r2
put sc_regs 3 step
gr_s2_write_slot mul rem step 128 64 r0 r1 r2 step
end

fn gr_s2_save_ref slot ulong to void
off = mul slot 32
for j ulong 32
put gr_ref_dig add off j get sh_dig j
end
end

fn gr_s2_chk_ref slot ulong to bool
off = mul slot 32
for j ulong 32
if ne get sh_dig j get gr_ref_dig add off j
ret false
end
end
ret true
end

fn gr_s2_rewind_check target ulong exp_ck_step ulong ref_slot ulong to bool
if ne sck_restore_nearest target SCK_OK
ret false
end
if ne sck_last_restored_step exp_ck_step
ret false
end
s = add exp_ck_step 1
while le s target bound 64
gr_s2_step s
s = add s 1
end
if ne sck_hash_live SCK_OK
ret false
end
ret gr_s2_chk_ref ref_slot
end

fn gr_stage2 to int
if ne sck_init 8 8192 4 4 SCK_OK
ret gr_fail 40
end
if ne sck_take SCK_OK
ret gr_fail 41
end
for i ulong 64
step = add i 1
gr_s2_step step
if sck_should_take step
if ne sck_take SCK_OK
ret gr_fail 42
end
end
if or eq step 23 or eq step 39 or eq step 55 eq step 64
if ne sck_hash_live SCK_OK
ret gr_fail 43
end
if eq step 23
gr_s2_save_ref 0
end
if eq step 39
gr_s2_save_ref 1
end
if eq step 55
gr_s2_save_ref 2
end
if eq step 64
gr_s2_save_ref 3
end
end
end
if ne sck_count 17
ret gr_fail 44
end
if ge sck_data_bytes sck_raw_bytes
ret gr_fail 45
end
if not gr_s2_rewind_check 55 52 2
ret gr_fail 46
end
if not gr_s2_rewind_check 39 36 1
ret gr_fail 47
end
if not gr_s2_rewind_check 23 20 0
ret gr_fail 48
end
if not gr_s2_rewind_check 64 64 3
ret gr_fail 49
end
gr_chk 7

note NC-CK1: 1-bit tamper in checkpoint 5 digest -> SCK_ERR_DIGEST (3)
sck_tamper_digest 5 7
if ne sck_restore_id 5 SCK_ERR_DIGEST
ret gr_fail 50
end
sck_tamper_digest 5 7
if ne sck_restore_id 5 SCK_OK
ret gr_fail 51
end
gr_neg

note NC-CK2: 1-bit tamper in checkpoint 6 payload data -> SCK_ERR_DIGEST (3)
sck_tamper_data 6 0
if ne sck_restore_id 6 SCK_ERR_DIGEST
ret gr_fail 52
end
sck_tamper_data 6 0
gr_neg
gr_chk 2

gr_wrt gr_m_s2
gr_num sck_count
gr_wrt gr_m_bytes
gr_num sck_data_bytes
gr_wrt gr_m_cp
ret 0
end

note ---- Stage 3: >= 16-Branch Counterfactual Fork Matrix ----
fn gr_stage3 to int
if ne cff_run_matrix18 CF_OK
ret gr_fail 60
end
if ne get cf_br_cnt 0 18
ret gr_fail 61
end
if or ne cff_rep_get 0 0 0 or ne cff_rep_get 0 15 1 ne cff_rep_get 0 9 8
ret gr_fail 62
end
if or ne cff_rep_get 1 0 1 or ne cff_rep_get 1 1 12 ne cff_rep_get 1 2 1
ret gr_fail 63
end
if or ne cff_rep_get 1 6 45000 or ne cff_rep_get 1 7 12000 ne cff_rep_get 1 15 0
ret gr_fail 64
end
if or ne cff_rep_get 6 1 24 ne cff_rep_get 6 12 2
ret gr_fail 65
end
for b ulong 5
br = add b 7
if or ne cff_rep_get br 0 1 or ne cff_rep_get br 1 12 ne cff_rep_get br 2 2
ret gr_fail 66
end
if ne cff_rep_get br 9 8
ret gr_fail 67
end
end
if or ne cff_rep_get 14 1 22 or ne cff_rep_get 14 2 3 ne cff_rep_get 14 13 9
ret gr_fail 68
end
if or ne cff_rep_get 17 1 28 or ne cff_rep_get 17 2 4 ne cff_rep_get 17 8 777
ret gr_fail 69
end
div_cnt = ulong 0
for br ulong 18
if ne br 0
if and eq cff_rep_get br 0 1 eq cff_rep_get br 15 0
div_cnt = add div_cnt 1
end
end
end
if lt div_cnt 16
ret gr_fail 70
end
if ne tkj_verify_buf tkj_bytes TKJ_OK
ret gr_fail 71
end
gr_chk 18

gr_wrt gr_m_s3
gr_num div_cnt
gr_wrt gr_m_cp
ret 0
end

note ---- Stage 4: Compact Semantic State-Stream Delta Codec + 3 Fail-Closed Neg Controls ----
fn gr_s4_fill_frame f ulong to void
put ss_cur_regs 0 add f 1
put ss_cur_regs 1 mul add f 1 1009
put ss_cur_regs 2 xor get ss_cur_regs 2 mul add f 1 31337
base_off = mul f 1024
for j ulong 32
v = uchar and add mul f 17 add j 3 255
put ss_cur_slab add base_off j v
end
end

fn gr_stage4 to int
if ne sst_enc_init 16 65536 SST_OK
ret gr_fail 80
end
for f ulong 64
gr_s4_fill_frame f
if ne sst_emit_frame mul f 4 SST_OK
ret gr_fail 81
end
end
s_bytes = sst_stream_bytes
r_bytes = sst_raw_bytes
if or ne sst_frame_count 64 lt r_bytes 4000000
ret gr_fail 82
end
ratio = div r_bytes s_bytes
if or gt s_bytes 16384 lt ratio 250
ret gr_fail 83
end
if ne sst_decode_verify s_bytes SST_OK
ret gr_fail 84
end
if ne sst_decoded_frames 64
ret gr_fail 85
end
if not sst_verify_exact_match
ret gr_fail 86
end
gr_chk 7

note NC-SS1: Truncated OSTM frame -> SST_ERR_TRUNC (3)
if ne sst_decode_verify sub s_bytes 1 SST_ERR_TRUNC
ret gr_fail 87
end
gr_neg

note NC-SS2: 1-bit tamper in delta payload byte -> SST_ERR_HASH (7)
tpos = ulong 44
orig = get ss_buf tpos
put ss_buf tpos xor orig uchar 1
if ne sst_decode_verify s_bytes SST_ERR_HASH
ret gr_fail 88
end
put ss_buf tpos orig
gr_neg

note NC-SS3: Bad magic -> SST_ERR_MAGIC (1)
m0 = get ss_buf 0
put ss_buf 0 uchar 65
if ne sst_decode_verify s_bytes SST_ERR_MAGIC
ret gr_fail 89
end
put ss_buf 0 m0
gr_neg
gr_chk 3

gr_wrt gr_m_s4
gr_num r_bytes
gr_wrt gr_m_stream
gr_num s_bytes
gr_wrt gr_m_comp
gr_num ratio
gr_wrt gr_m_ratio
ret 0
end

note ---- Stage 5: Live ngrun Subprocess Trap-to-Cause Backwards Stepping & Regression ----
fn gr_write_ir suf view uchar * to bool
n = ir_wr
gr_spath suf 1
fd = fopen gr_pa 0 get gr_pl 0 577 420
if lt fd 0
ret false
end
ok = ar_out ulong fd 1 0 n
r = fclose int fd
ret eq ok 1
end

note Helper: append standard 12-iteration loop from gr_h[0]=f, gr_h[1]=b0, gr_h[2]=entry_tok,
note gr_h[3]=c0, gr_h[4]=c1, gr_h[5]=n_iters; writes exit block into gr_h[6].
fn gr_emit_loop to void
f = get gr_h 0
b0 = get gr_h 1
b1 = ir_blk f
bi = ir_bpar b1 5
b2 = ir_blk f
b3 = ir_blk f
o = ir_op b0 60 0 0 3
ir_set o 0 b1
ir_set o 1 get gr_h 2
ir_set o 2 get gr_h 3
o = ir_op b1 32 1 0 2
ir_set o 0 bi
ir_set o 1 get gr_h 5
lt1 = ir_res o
o = ir_op b1 61 0 0 4
ir_set o 0 ir_btok b1
ir_set o 1 lt1
ir_set o 2 b2
ir_set o 3 b3
c32 = ir_res ir_op b2 1 5 32 0
o = ir_op b2 81 0 4 3
ir_set o 0 ir_btok b2
ir_set o 1 bi
ir_set o 2 c32
tk = ir_otok o
o = ir_op b2 10 5 0 2
ir_set o 0 bi
ir_set o 1 get gr_h 4
bi2 = ir_res o
o = ir_op b2 60 0 0 3
ir_set o 0 b1
ir_set o 1 tk
ir_set o 2 bi2
put gr_h 6 b3
end

note Program 1 (chk.bounds): store 99 at @g0[3], loop 12x, load @g0[3], add 1, chk.bounds -> exit 103
fn gr_build_prog_bounds to void
ir_init
ta = ir_tarr 5 8
tr = ir_tref ta 1 0
g0 = ir_glob ta 0
f = ir_fnew 2 0 8
b0 = ir_blk f
put gr_h 0 f
put gr_h 1 b0
ga = ir_res ir_op b0 52 tr ulong g0 0
put gr_h 7 ga
put gr_h 3 ir_res ir_op b0 1 5 0 0
put gr_h 4 ir_res ir_op b0 1 5 1 0
c3 = ir_res ir_op b0 1 5 3 0
put gr_h 8 c3
put gr_h 5 ir_res ir_op b0 1 5 12 0
c99 = ir_res ir_op b0 1 5 99 0
o = ir_op b0 79 0 3 4
ir_set o 0 ir_ftok f
ir_set o 1 ga
ir_set o 2 c3
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b0 43 0 0 4
ir_set o 0 tk
ir_set o 1 ga
ir_set o 2 c3
ir_set o 3 c99
put gr_h 2 ir_otok o
gr_emit_loop
b3 = get gr_h 6
o = ir_op b3 79 0 3 4
ir_set o 0 ir_btok b3
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 8
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b3 42 5 0 3
ir_set o 0 tk
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 8
ld = ir_res o
o = ir_op b3 10 5 0 2
ir_set o 0 ld
ir_set o 1 get gr_h 4
bad = ir_res o
o = ir_op b3 79 0 3 4
ir_set o 0 tk
ir_set o 1 get gr_h 7
ir_set o 2 bad
ir_set o 3 get gr_h 4
tk = ir_otok o
z = ir_res ir_op b3 1 8 0 0
o = ir_op b3 63 0 0 2
ir_set o 0 tk
ir_set o 1 z
end

fn gr_build_divz_helper to void
fh = ir_fnew 0 0 8
pd = ir_fpar fh 9
bh = ir_blk fh
o = ir_op bh 74 0 2 2
ir_set o 0 ir_ftok fh
ir_set o 1 pd
tk = ir_otok o
zh = ir_res ir_op bh 1 8 0 0
o = ir_op bh 63 0 0 2
ir_set o 0 tk
ir_set o 1 zh
put gr_h 9 fh
end

fn gr_build_divz_tail to void
b3 = get gr_h 6
o = ir_op b3 79 0 3 4
ir_set o 0 ir_btok b3
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 4
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b3 42 9 0 3
ir_set o 0 tk
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 4
ld = ir_res o
o = ir_op b3 64 8 0 3
ir_set o 0 tk
ir_set o 1 get gr_h 9
ir_set o 2 ld
tk = ir_otok o
res = ir_res o
o = ir_op b3 63 0 0 2
ir_set o 0 tk
ir_set o 1 res
end

note Program 2 (chk.divz across call): store 0 at @g0[1], loop 10x, load @g0[1], call f0(v) -> exit 102
fn gr_build_prog_divz to void
ir_init
ta = ir_tarr 9 4
tr = ir_tref ta 1 0
g0 = ir_glob ta 0
gr_build_divz_helper
fm = ir_fnew 2 0 8
b0 = ir_blk fm
put gr_h 0 fm
put gr_h 1 b0
ga = ir_res ir_op b0 52 tr ulong g0 0
put gr_h 7 ga
put gr_h 3 ir_res ir_op b0 1 5 0 0
put gr_h 4 ir_res ir_op b0 1 5 1 0
put gr_h 5 ir_res ir_op b0 1 5 10 0
z64 = ir_res ir_op b0 1 9 0 0
o = ir_op b0 79 0 3 4
ir_set o 0 ir_ftok fm
ir_set o 1 ga
ir_set o 2 get gr_h 4
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b0 43 0 0 4
ir_set o 0 tk
ir_set o 1 ga
ir_set o 2 get gr_h 4
ir_set o 3 z64
put gr_h 2 ir_otok o
gr_emit_loop
gr_build_divz_tail
end

fn gr_build_addovf_tail to void
b3 = get gr_h 6
o = ir_op b3 79 0 3 4
ir_set o 0 ir_btok b3
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 8
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b3 42 8 0 3
ir_set o 0 tk
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 8
ld = ir_res o
i1 = ir_res ir_op b3 1 8 1 0
o = ir_op b3 70 0 1 3
ir_set o 0 tk
ir_set o 1 ld
ir_set o 2 i1
tk = ir_otok o
o = ir_op b3 63 0 0 2
ir_set o 0 tk
ir_set o 1 ld
end

note Program 3 (chk.add overflow): store 2147483647 at @g0[2], loop 10x, load, chk.add +1 -> exit 101
fn gr_build_prog_addovf to void
ir_init
ta = ir_tarr 8 4
tr = ir_tref ta 1 0
g0 = ir_glob ta 0
fm = ir_fnew 2 0 8
b0 = ir_blk fm
put gr_h 0 fm
put gr_h 1 b0
ga = ir_res ir_op b0 52 tr ulong g0 0
put gr_h 7 ga
put gr_h 3 ir_res ir_op b0 1 5 0 0
put gr_h 4 ir_res ir_op b0 1 5 1 0
c2 = ir_res ir_op b0 1 5 2 0
put gr_h 8 c2
put gr_h 5 ir_res ir_op b0 1 5 10 0
cmax = ir_res ir_op b0 1 8 2147483647 0
o = ir_op b0 79 0 3 4
ir_set o 0 ir_ftok fm
ir_set o 1 ga
ir_set o 2 c2
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b0 43 0 0 4
ir_set o 0 tk
ir_set o 1 ga
ir_set o 2 c2
ir_set o 3 cmax
put gr_h 2 ir_otok o
gr_emit_loop
gr_build_addovf_tail
end

note Program 4 (explicit trap 9 via cbr): store 5000 at @g0[0], loop 10x, load, gt 3000 -> cbr -> trap 9 (exit 109)
fn gr_build_trap_tail to void
f = get gr_h 0
b3 = get gr_h 6
bt = ir_blk f
bf = ir_blk f
o = ir_op b3 79 0 3 4
ir_set o 0 ir_btok b3
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 3
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b3 42 5 0 3
ir_set o 0 tk
ir_set o 1 get gr_h 7
ir_set o 2 get gr_h 3
ld = ir_res o
c3000 = ir_res ir_op b3 1 5 3000 0
o = ir_op b3 34 1 0 2
ir_set o 0 ld
ir_set o 1 c3000
gt1 = ir_res o
o = ir_op b3 61 0 0 4
ir_set o 0 tk
ir_set o 1 gt1
ir_set o 2 bt
ir_set o 3 bf
o = ir_op bt 65 0 9 1
ir_set o 0 ir_btok bt
z = ir_res ir_op bf 1 8 0 0
o = ir_op bf 63 0 0 2
ir_set o 0 ir_btok bf
ir_set o 1 z
end

fn gr_build_prog_trap to void
ir_init
ta = ir_tarr 5 4
tr = ir_tref ta 1 0
g0 = ir_glob ta 0
fm = ir_fnew 2 0 8
b0 = ir_blk fm
put gr_h 0 fm
put gr_h 1 b0
ga = ir_res ir_op b0 52 tr ulong g0 0
put gr_h 7 ga
put gr_h 3 ir_res ir_op b0 1 5 0 0
put gr_h 4 ir_res ir_op b0 1 5 1 0
put gr_h 5 ir_res ir_op b0 1 5 10 0
c5000 = ir_res ir_op b0 1 5 5000 0
o = ir_op b0 79 0 3 4
ir_set o 0 ir_ftok fm
ir_set o 1 ga
ir_set o 2 get gr_h 3
ir_set o 3 get gr_h 4
tk = ir_otok o
o = ir_op b0 43 0 0 4
ir_set o 0 tk
ir_set o 1 ga
ir_set o 2 get gr_h 3
ir_set o 3 c5000
put gr_h 2 ir_otok o
gr_emit_loop
gr_build_trap_tail
end

note Program 5 (clean non-trapping program returning 42)
fn gr_build_prog_ok to void
ir_init
f = ir_fnew 2 0 8
b = ir_blk f
c42 = ir_res ir_op b 1 8 42 0
o = ir_op b 63 0 0 2
ir_set o 0 ir_ftok f
ir_set o 1 c42
end

note Argv packet builder for execprog (u16 count, then u16 len + bytes per arg)
fn gr_av_reset to void
put gr_av 0 0
put gr_av 1 0
put gr_an 0 2
put gr_an 1 0
end

fn gr_av_commit n ulong to void
put gr_an 0 add add get gr_an 0 2 n
c = add get gr_an 1 1
put gr_an 1 c
put gr_av 0 uchar and c 255
put gr_av 1 uchar and shr c 8 255
end

fn gr_av_push s view uchar * to void
p = get gr_an 0
n = len s
put gr_av p uchar and n 255
put gr_av add p 1 uchar and shr n 8 255
for j ulong n bound 4096
put gr_av add add p 2 j get s j
end
gr_av_commit n
end

fn gr_av_push_ng to void
p = get gr_an 0
n = get gr_ngl 0
put gr_av p uchar and n 255
put gr_av add p 1 uchar and shr n 8 255
for j ulong n bound 2048
put gr_av add add p 2 j get gr_ngp j
end
gr_av_commit n
end

fn gr_av_push_pa dst ulong to void
p = get gr_an 0
if eq dst 1
n = get gr_pl 0
put gr_av p uchar and n 255
put gr_av add p 1 uchar and shr n 8 255
for j ulong n bound 4096
put gr_av add add p 2 j get gr_pa j
end
gr_av_commit n
else
n = get gr_pl2 0
put gr_av p uchar and n 255
put gr_av add p 1 uchar and shr n 8 255
for j ulong n bound 4096
put gr_av add add p 2 j get gr_pa2 j
end
gr_av_commit n
end
end

fn gr_read_cap suf view uchar * is_err bool to ulong
gr_spath suf 1
fd = fopen gr_pa 0 get gr_pl 0 0 0
if lt fd 0
ret 0
end
n = ulong 0
while lt n 65536 bound 1024
k = long 0
if is_err
k = read int fd gr_err n sub 65536 n
else
k = read int fd gr_out n sub 65536 n
end
if le k 0
break
end
n = add n ulong k
end
r = fclose int fd
ret n
end

fn gr_spawn to ulong
gr_spath gr_f_in 1
fi = fopen gr_pa 0 get gr_pl 0 577 420
r = fclose int fi
fi = fopen gr_pa 0 get gr_pl 0 0 0
gr_spath gr_f_out 1
fo = fopen gr_pa 0 get gr_pl 0 577 420
gr_spath gr_f_err 1
fe = fopen gr_pa 0 get gr_pl 0 577 420
pid = fork
if eq pid 0
d0 = dupfd int fi 0 0
d1 = dupfd int fo 1 0
d2 = dupfd int fe 2 0
c0 = fclose int fi
c1 = fclose int fo
c2 = fclose int fe
ex = execprog gr_av 0 get gr_an 0
exit 127
end
c0 = fclose int fi
c1 = fclose int fo
c2 = fclose int fe
w = waitpid int pid gr_st 0 4 0
put gr_olen 0 gr_read_cap gr_f_out false
put gr_olen 1 gr_read_cap gr_f_err true
if ne get gr_st 0 0
ret 255
end
ret ulong get gr_st 1
end

fn gr_err_has needle view uchar * to bool
el = get gr_olen 1
nl = len needle
if gt nl el
ret false
end
lim = add sub el nl 1
for i ulong lim bound 65536
ok = true
for j ulong nl bound 256
if ne get gr_err add i j get needle j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn gr_run_ngrun ir_suf view uchar * j_suf view uchar * do_rw bool do_j bool to ulong
gr_av_reset
gr_av_push_ng
gr_spath ir_suf 1
gr_av_push_pa 1
if do_rw
gr_av_push gr_a_rw
gr_av_push gr_a_ce
gr_av_push gr_a_4
end
if do_j
gr_av_push gr_a_jn
gr_spath j_suf 2
gr_av_push_pa 2
end
ret gr_spawn
end

fn gr_stage5_traps to int
note 5a. chk.bounds (exit 103)
ex = gr_run_ngrun gr_f_b gr_f_jb true true
if ne ex 103
ret gr_fail 104
end
if not gr_err_has gr_k_pfx
ret gr_fail 105
end
if or not gr_err_has gr_k_t3 not gr_err_has gr_k_par
ret gr_fail 106
end
if or not gr_err_has gr_k_op43 not gr_err_has gr_k_v99
ret gr_fail 107
end
if gr_err_has gr_k_ck0
ret gr_fail 108
end
gr_spath gr_f_jb 3
if ne tkj_read_path TKJ_OK
ret gr_fail 109
end
if lt tkj_count 10
ret gr_fail 110
end
put gr_cnt 2 add get gr_cnt 2 4

note 5b. chk.divz across function call (exit 102)
ex = gr_run_ngrun gr_f_d gr_f_jd true true
if ne ex 102
ret gr_fail 111
end
if or not gr_err_has gr_k_t2 not gr_err_has gr_k_par
ret gr_fail 112
end
if or not gr_err_has gr_k_op43 not gr_err_has gr_k_v0
ret gr_fail 113
end
if gr_err_has gr_k_ck0
ret gr_fail 114
end
gr_spath gr_f_jd 3
if ne tkj_read_path TKJ_OK
ret gr_fail 115
end
put gr_cnt 2 add get gr_cnt 2 3

note 5c. chk.add overflow (exit 101)
ex = gr_run_ngrun gr_f_a gr_f_ja true true
if ne ex 101
ret gr_fail 116
end
if or not gr_err_has gr_k_t1 not gr_err_has gr_k_par
ret gr_fail 117
end
if or not gr_err_has gr_k_op43 not gr_err_has gr_k_vmax
ret gr_fail 118
end
if gr_err_has gr_k_ck0
ret gr_fail 119
end
gr_spath gr_f_ja 3
if ne tkj_read_path TKJ_OK
ret gr_fail 120
end
put gr_cnt 2 add get gr_cnt 2 3

note 5c2. Explicit trap 9 via cbr (exit 109)
ex = gr_run_ngrun gr_f_t gr_f_jt true true
if ne ex 109
ret gr_fail 128
end
if or not gr_err_has gr_k_t9 not gr_err_has gr_k_par
ret gr_fail 129
end
if or not gr_err_has gr_k_op43 not gr_err_has gr_k_v5000
ret gr_fail 130
end
if gr_err_has gr_k_ck0
ret gr_fail 131
end
gr_spath gr_f_jt 3
if ne tkj_read_path TKJ_OK
ret gr_fail 132
end
put gr_cnt 2 add get gr_cnt 2 3
ret 0
end

fn gr_stage5 to int
gr_build_prog_bounds
if not gr_write_ir gr_f_b
ret gr_fail 100
end
gr_build_prog_divz
if not gr_write_ir gr_f_d
ret gr_fail 101
end
gr_build_prog_addovf
if not gr_write_ir gr_f_a
ret gr_fail 102
end
gr_build_prog_trap
if not gr_write_ir gr_f_t
ret gr_fail 133
end
gr_build_prog_ok
if not gr_write_ir gr_f_ok
ret gr_fail 103
end
rt = gr_stage5_traps
if ne rt 0
ret rt
end

note 5d. Live NC: 1-bit tamper on ngrun-produced bounds.otkj on disk MUST be REFUSED!
gr_spath gr_f_jb 3
if ne tkj_read_path TKJ_OK
ret gr_fail 121
end
bpos = ulong 40
put tj_buf bpos xor get tj_buf bpos uchar 1
if ne tkj_write_path TKJ_OK
ret gr_fail 122
end
rc = tkj_read_path
if eq rc TKJ_OK
ret gr_fail 123
end
put gr_cnt 3 add get gr_cnt 3 1

note 5e. Legacy ngrun regression check (no --rewind, no --journal)
ex = gr_run_ngrun gr_f_ok gr_f_jok false false
if or ne ex 42 ne get gr_olen 1 0
ret gr_fail 124
end
ex = gr_run_ngrun gr_f_b gr_f_jb false false
if or ne ex 103 ne get gr_olen 1 0
ret gr_fail 125
end
ex = gr_run_ngrun gr_f_ok gr_f_jok false true
if or ne ex 42 ne get gr_olen 1 0
ret gr_fail 126
end
gr_spath gr_f_jok 3
if ne tkj_read_path TKJ_OK
ret gr_fail 127
end
put gr_cnt 2 add get gr_cnt 2 4

gr_wrt gr_m_s5
gr_num get gr_cnt 2
gr_wrt gr_m_cp
ret 0
end

fn main to int
gr_wrt gr_m_hdr
has_live = false
if ge argcnt 3
m1 = argread 1 gr_ngp 0 len gr_ngp
m2 = argread 2 gr_scp 0 len gr_scp
if and gt m1 0 gt m2 0
put gr_ngl 0 ulong m1
put gr_scl 0 ulong m2
has_live = true
end
end
r1 = gr_stage1 has_live
if ne r1 0
ret r1
end
r2 = gr_stage2
if ne r2 0
ret r2
end
r3 = gr_stage3
if ne r3 0
ret r3
end
r4 = gr_stage4
if ne r4 0
ret r4
end
if has_live
r5 = gr_stage5
if ne r5 0
ret r5
end
end
gr_wrt gr_m_pass
gr_num get gr_cnt 0
gr_wrt gr_m_neg
gr_num get gr_cnt 1
gr_wrt gr_m_live
gr_num get gr_cnt 2
gr_wrt gr_m_lneg
gr_num get gr_cnt 3
gr_wrt gr_m_nl
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/pack/gate_pack.om: Program-mode verification gate for OMPK v1 Semantic Packaging,
note DAG dependency resolution, Compile-on-Arrive TargetDesc realization, semantic deduplication,
note and 7 fail-closed negative controls.
note
note Link order:
note   seed/ng/sha256.om seed/ng/target/target_desc.om seed/ng/pack/sem_pack.om seed/ng/pack/gate_pack.om

global gp_dig uchar 24
global gp_chk ulong 1
global gp_neg ulong 1
global gp_slots ulong 16
global gp_tmp_a uchar 32
global gp_tmp_b uchar 32

text gp_msg_pass "NG-PACK-GATE PASS checks="
text gp_msg_dedup " dedup_hits="
text gp_msg_neg " neg_controls="
text gp_msg_of7 "/7\n"
text gp_msg_fail "NG-PACK-GATE FAIL at check="
text gp_msg_nl "\n"

note Canonical OIR sample payloads for DAG, multi-target, semantic dedup, and negative controls
text gp_ir_leaf "OIR1:fn leaf(x:u64)->u64 { add x 1 }"
text gp_ir_mid "OIR1:fn mid(x:u64)->u64 { mul (call leaf x) 2 }"
text gp_ir_root "OIR1:fn root(x:u64)->u64 { add (call mid x) 7 }"
text gp_ir_sm121 "OIR1:kernel w4_gemm_m4(A,B,C) smem=32768 warp=32 hmma16816"
text gp_ir_poly_a "OIR1:fn f_alpha(x:u64)->u64 { add (mul x 2) 2 }"
text gp_ir_poly_b "OIR1:fn g_beta(y:u64)->u64 { mul (add y 1) 2 }"
text gp_ir_zero_fid "OIR1:fn fallback_sem_unit(z:u64)->u64 { xor z 42 }"
text gp_ir_orphan "OIR1:fn orphan_caller(x:u64)->u64 { call missing_dep x }"
text gp_ir_cyc_a "OIR1:fn cycle_node_a(x:u64)->u64 { call cycle_node_b x }"
text gp_ir_cyc_b "OIR1:fn cycle_node_b(x:u64)->u64 { call cycle_node_a x }"
text gp_ir_cyc_c "OIR1:fn cycle_self_c(x:u64)->u64 { call cycle_self_c x }"
text gp_ir_bad_smem "OIR1:kernel huge_smem_fail smem=131072 warp=32"
text gp_ir_bad_mma "OIR1:kernel amx_on_avx2_fail mma=amx161616"
text gp_ir_unproven "OIR1:fn unproven_candidate(x:u64)->u64 { add x 99 }"

fn gp_say s ulong to void
if eq s 0
w = write 1 gp_msg_pass 0 len gp_msg_pass
ret
end
if eq s 1
w = write 1 gp_msg_dedup 0 len gp_msg_dedup
ret
end
if eq s 2
w = write 1 gp_msg_neg 0 len gp_msg_neg
ret
end
if eq s 3
w = write 1 gp_msg_of7 0 len gp_msg_of7
ret
end
if eq s 4
w = write 1 gp_msg_fail 0 len gp_msg_fail
ret
end
w = write 1 gp_msg_nl 0 len gp_msg_nl
end

fn gp_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gp_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 gp_dig p sub 24 p
ret
end
end
end

fn gp_fail id ulong to int
gp_say 4
gp_num id
gp_say 5
ret int id
end

fn gp_add_chk n ulong to void
put gp_chk 0 add get gp_chk 0 n
end

fn gp_add_neg to void
put gp_neg 0 add get gp_neg 0 1
end

note Load one of the static IR text fixtures into pk_ir_in
fn gp_load_ir_a id ulong to void
pk_ir_reset
if eq id 0
n = len gp_ir_leaf
for i ulong n bound 256
rc = pk_ir_push get gp_ir_leaf i
end
ret
end
if eq id 1
n = len gp_ir_mid
for i ulong n bound 256
rc = pk_ir_push get gp_ir_mid i
end
ret
end
if eq id 2
n = len gp_ir_root
for i ulong n bound 256
rc = pk_ir_push get gp_ir_root i
end
ret
end
if eq id 3
n = len gp_ir_sm121
for i ulong n bound 256
rc = pk_ir_push get gp_ir_sm121 i
end
ret
end
if eq id 4
n = len gp_ir_poly_a
for i ulong n bound 256
rc = pk_ir_push get gp_ir_poly_a i
end
ret
end
if eq id 5
n = len gp_ir_poly_b
for i ulong n bound 256
rc = pk_ir_push get gp_ir_poly_b i
end
ret
end
if eq id 6
n = len gp_ir_zero_fid
for i ulong n bound 256
rc = pk_ir_push get gp_ir_zero_fid i
end
ret
end
end

fn gp_load_ir_b id ulong to void
pk_ir_reset
if eq id 7
n = len gp_ir_orphan
for i ulong n bound 256
rc = pk_ir_push get gp_ir_orphan i
end
ret
end
if eq id 8
n = len gp_ir_cyc_a
for i ulong n bound 256
rc = pk_ir_push get gp_ir_cyc_a i
end
ret
end
if eq id 9
n = len gp_ir_cyc_b
for i ulong n bound 256
rc = pk_ir_push get gp_ir_cyc_b i
end
ret
end
if eq id 10
n = len gp_ir_cyc_c
for i ulong n bound 256
rc = pk_ir_push get gp_ir_cyc_c i
end
ret
end
if eq id 11
n = len gp_ir_bad_smem
for i ulong n bound 256
rc = pk_ir_push get gp_ir_bad_smem i
end
ret
end
if eq id 12
n = len gp_ir_bad_mma
for i ulong n bound 256
rc = pk_ir_push get gp_ir_bad_mma i
end
ret
end
n = len gp_ir_unproven
for i ulong n bound 256
rc = pk_ir_push get gp_ir_unproven i
end
end

fn gp_load_ir id ulong to void
if le id 6
gp_load_ir_a id
ret
end
gp_load_ir_b id
end

fn gp_buf_eq32 offA ulong offB ulong to bool
for i ulong 32
if ne get pk_buf add offA i get pk_buf add offB i
ret false
end
end
ret true
end

fn gp_tmp_eq32 to bool
for i ulong 32
if ne get gp_tmp_a i get gp_tmp_b i
ret false
end
end
ret true
end

note ---- Test 0: Exact OMPK v1 Wire Layout & FIPS 180-4 SHA-256 ("abc") Check ----

fn gp_test_wire_exact to int
pk_reset_builder
rc = pk_ir_push uchar 97
rc = pk_ir_push uchar 98
rc = pk_ir_push uchar 99
pk_set_req EXEC_SIMT_WARP 32768 64 32 MMA_16816_BF16 FEAT_HMMA16816
if ne pk_pack PK_OK
ret gp_fail 101
end
note Check exact magic "OMPK" (79,77,80,75) and version u32 LE == 1
if or ne ulong get pk_buf 0 79 ne ulong get pk_buf 1 77
ret gp_fail 102
end
if or ne ulong get pk_buf 2 80 ne ulong get pk_buf 3 75
ret gp_fail 103
end
if ne pk_get_u32 4 1
ret gp_fail 104
end
note Check FIPS 180-4 SHA-256("abc") = ba7816bf...f20015ad in sem_id [8..39]
if or ne ulong get pk_buf 8 186 ne ulong get pk_buf 9 120
ret gp_fail 105
end
if or ne ulong get pk_buf 10 22 ne ulong get pk_buf 11 191
ret gp_fail 106
end
if or ne ulong get pk_buf 38 21 ne ulong get pk_buf 39 173
ret gp_fail 107
end
note Check 6x u64 LE contract fields at [72..119]
if or ne pk_get_u64 72 EXEC_SIMT_WARP ne pk_get_u64 80 32768
ret gp_fail 108
end
if or ne pk_get_u64 88 64 ne pk_get_u64 96 32
ret gp_fail 109
end
if or ne pk_get_u64 104 MMA_16816_BF16 ne pk_get_u64 112 FEAT_HMMA16816
ret gp_fail 110
end
note Check import_count [120..123] == 0, ir_len [124..127] == 3, payload "abc" at [128..130]
if or ne pk_get_u32 120 0 ne pk_get_u32 124 3
ret gp_fail 111
end
if or ne ulong get pk_buf 128 97 ne ulong get pk_buf 130 99
ret gp_fail 112
end
note Check bad magic -> PK_ERR_MAGIC and bad version -> PK_ERR_VERSION
put pk_buf 0 uchar 88
if ne pk_verify PK_ERR_MAGIC
ret gp_fail 113
end
put pk_buf 0 uchar 79
pk_put_u32 4 2
if ne pk_verify PK_ERR_VERSION
ret gp_fail 114
end
gp_add_chk 14
ret 0
end

note ---- Test 1: Wire Format + 3-Package DAG (leaf -> mid -> root) ----

fn gp_test_dag to int
note Pack leaf (no imports, default func_id == sem_id)
pk_reset_builder
gp_load_ir 0
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
if ne pk_pack PK_OK
ret gp_fail 1
end
if ne get pk_len 0 add PK_HDR_LEN len gp_ir_leaf
ret gp_fail 2
end
if not gp_buf_eq32 8 40
ret gp_fail 3
end
if ne pk_verify PK_OK
ret gp_fail 4
end
if ne pk_store_put PK_OK
ret gp_fail 5
end
leafSlot = get pk_last_slot 0
put gp_slots 0 leafSlot
pk_copy_store_sem_to_query leafSlot
if not pk_store_has
ret gp_fail 6
end
note Idempotent store re-put returns same slot without duplicating
if ne pk_store_put PK_OK
ret gp_fail 7
end
if or ne get pk_last_slot 0 leafSlot ne get pk_store_count 0 1
ret gp_fail 8
end
gp_add_chk 8

note Pack mid (imports leaf)
pk_reset_builder
gp_load_ir 1
pk_set_req EXEC_SCALAR_SIMD 0 12 4 0 FEAT_FMA
if ne pk_add_import_from_store leafSlot PK_OK
ret gp_fail 9
end
if ne pk_pack PK_OK
ret gp_fail 10
end
if ne get pk_len 0 add add PK_HDR_LEN 32 len gp_ir_mid
ret gp_fail 11
end
if ne pk_store_put PK_OK
ret gp_fail 12
end
midSlot = get pk_last_slot 0
put gp_slots 1 midSlot
gp_add_chk 4

note Pack root (imports mid)
pk_reset_builder
gp_load_ir 2
pk_set_req EXEC_SCALAR_SIMD 0 16 4 0 FEAT_FMA
if ne pk_add_import_from_store midSlot PK_OK
ret gp_fail 13
end
if ne pk_pack PK_OK
ret gp_fail 14
end
if ne pk_store_put PK_OK
ret gp_fail 15
end
rootSlot = get pk_last_slot 0
put gp_slots 2 rootSlot

note Resolve 3-package DAG rooted at root: must yield [leaf, mid, root]
pk_copy_store_sem_to_query rootSlot
if ne pk_resolve_deps PK_OK
ret gp_fail 16
end
if ne get pk_topo_len 0 3
ret gp_fail 17
end
if ne get pk_topo_order 0 leafSlot
ret gp_fail 18
end
if ne get pk_topo_order 1 midSlot
ret gp_fail 19
end
if ne get pk_topo_order 2 rootSlot
ret gp_fail 20
end
gp_add_chk 8
ret 0
end

note ---- Test 2: Compile-on-Arrive Realization on TID_X925 and TID_SM121 ----

fn gp_test_realize_targets to int
rootSlot = get gp_slots 2
if ne pk_store_load rootSlot PK_OK
ret gp_fail 21
end
x925Feat = tdGet TID_X925 TDF_FEAT
if ne pk_realize_on_arrive TID_X925 x925Feat 1024 7 PK_OK
ret gp_fail 22
end
if or ne get pk_real_out 2 0 ne get pk_real_out 5 1
ret gp_fail 23
end
xSlot = get pk_real_out 1
xPtr = get pk_real_out 4
note Repeat arrival of same package on TID_X925 hits realization cache (zero recompile)
if ne pk_realize_on_arrive TID_X925 x925Feat 1024 7 PK_OK
ret gp_fail 24
end
if or ne get pk_real_out 2 1 ne get pk_real_out 1 xSlot
ret gp_fail 25
end
if or ne get pk_real_out 4 xPtr ne get pk_real_out 5 1
ret gp_fail 26
end

note Pack and realize SM121 Blackwell SIMT kernel package
pk_reset_builder
gp_load_ir 3
pk_set_req EXEC_SIMT_WARP 32768 64 32 MMA_16816_BF16 FEAT_HMMA16816
if ne pk_pack PK_OK
ret gp_fail 27
end
if ne pk_store_put PK_OK
ret gp_fail 28
end
smFeat = tdGet TID_SM121 TDF_FEAT
if ne pk_realize_on_arrive TID_SM121 smFeat 4096 7 PK_OK
ret gp_fail 29
end
if or ne get pk_real_out 2 0 ne get pk_real_out 5 2
ret gp_fail 30
end
if eq get pk_real_out 1 xSlot
ret gp_fail 31
end
gp_add_chk 11
ret 0
end

note ---- Test 3: Semantic Deduplication (Different IR / Names, Identical func_id) ----

fn gp_test_semantic_dedup to int
x925Feat = tdGet TID_X925 TDF_FEAT
note Package A: f_alpha(x) = 2*x + 2, canonical polynomial (w=64, c0=2, c1=2, c2=0)
pk_reset_builder
gp_load_ir 4
pk_compute_poly_func_id 64 2 2 0
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
if ne pk_pack PK_OK
ret gp_fail 32
end
if gp_buf_eq32 8 40
ret gp_fail 33
end
for i ulong 32
put gp_tmp_a i get pk_buf add 8 i
end
if ne pk_store_put PK_OK
ret gp_fail 34
end
if ne pk_realize_on_arrive TID_X925 x925Feat 64 7 PK_OK
ret gp_fail 35
end
if or ne get pk_real_out 2 0 ne get pk_real_out 5 3
ret gp_fail 36
end
slotA = get pk_real_out 1
ptrA = get pk_real_out 4
keyA = get pk_real_out 3

note Package B: g_beta(y) = (y + 1) * 2 (different IR bytes and sem_id, identical func_id!)
pk_reset_builder
gp_load_ir 5
pk_compute_poly_func_id 64 2 2 0
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
if ne pk_pack PK_OK
ret gp_fail 37
end
for i ulong 32
put gp_tmp_b i get pk_buf add 8 i
end
note Confirm sem_id_a != sem_id_b (genuinely different IR payloads)
if gp_tmp_eq32
ret gp_fail 38
end
if ne pk_store_put PK_OK
ret gp_fail 39
end
note Compile-on-Arrive MUST hit the exact same cached realization with zero redundant codegen!
if ne pk_realize_on_arrive TID_X925 x925Feat 64 7 PK_OK
ret gp_fail 40
end
if ne get pk_real_out 2 1
ret gp_fail 41
end
if or ne get pk_real_out 1 slotA ne get pk_real_out 4 ptrA
ret gp_fail 42
end
if or ne get pk_real_out 3 keyA ne get pk_real_out 5 3
ret gp_fail 43
end

note Verify all-zero func_id gracefully falls back to sem_id cache key
pk_reset_builder
gp_load_ir 6
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
if ne pk_pack PK_OK
ret gp_fail 44
end
for i ulong 32
put pk_buf add 40 i 0
end
if ne pk_realize_on_arrive TID_X925 x925Feat 999 7 PK_OK
ret gp_fail 45
end
if or ne get pk_real_out 7 1 ne get pk_real_out 2 0
ret gp_fail 46
end
fbSlot = get pk_real_out 1
if ne pk_realize_on_arrive TID_X925 x925Feat 999 7 PK_OK
ret gp_fail 47
end
if or ne get pk_real_out 2 1 ne get pk_real_out 1 fbSlot
ret gp_fail 48
end
gp_add_chk 17
ret 0
end

note ---- Test 4: 7 Fail-Closed Negative Controls ----

fn gp_neg_tamper_and_len to int
x925Feat = tdGet TID_X925 TDF_FEAT
cgBefore = get pk_real_out 5
note Neg Control 1: 1-bit tamper in OIR payload -> PK_ERR_DIGEST
if ne pk_store_load get gp_slots 2 PK_OK
ret gp_fail 50
end
irStart = add PK_HDR_LEN 32
orig = get pk_buf irStart
put pk_buf irStart xor orig uchar 1
if ne pk_verify PK_ERR_DIGEST
ret gp_fail 51
end
if ne pk_store_put PK_ERR_DIGEST
ret gp_fail 52
end
if ne pk_realize_on_arrive TID_X925 x925Feat 1024 7 PK_ERR_DIGEST
ret gp_fail 53
end
if ne get pk_real_out 5 cgBefore
ret gp_fail 54
end
gp_add_neg
gp_add_chk 5

note Neg Control 2: Trailing garbage byte -> PK_ERR_LENGTH
if ne pk_store_load get gp_slots 0 PK_OK
ret gp_fail 55
end
lLen = get pk_len 0
put pk_buf lLen uchar 90
put pk_len 0 add lLen 1
if ne pk_verify PK_ERR_LENGTH
ret gp_fail 56
end
if ne pk_realize_on_arrive TID_X925 x925Feat 1024 7 PK_ERR_LENGTH
ret gp_fail 57
end
gp_add_neg
gp_add_chk 3

note Neg Control 3: Truncated package (payload and header) -> PK_ERR_LENGTH
if ne pk_store_load get gp_slots 0 PK_OK
ret gp_fail 58
end
put pk_len 0 sub get pk_len 0 1
if ne pk_verify PK_ERR_LENGTH
ret gp_fail 59
end
put pk_len 0 64
if ne pk_verify PK_ERR_LENGTH
ret gp_fail 60
end
gp_add_neg
gp_add_chk 3
ret 0
end

fn gp_neg_deps_and_cycles to int
note Neg Control 4: Missing digest import -> PK_ERR_MISSING_IMPORT
pk_reset_builder
gp_load_ir 7
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
for i ulong 32
put pk_query_id i uchar add 160 i
end
if ne pk_add_import_from_query PK_OK
ret gp_fail 61
end
if ne pk_pack PK_OK
ret gp_fail 62
end
if ne pk_store_put PK_OK
ret gp_fail 63
end
pk_copy_store_sem_to_query get pk_last_slot 0
if ne pk_resolve_deps PK_ERR_MISSING_IMPORT
ret gp_fail 64
end
gp_add_neg
gp_add_chk 4

note Neg Control 5: Cyclic imports (A -> B -> A AND direct self-cycle C -> C) -> PK_ERR_CYCLE
note Precompute sem_A and sem_B from their canonical IR bytes
gp_load_ir 8
pk_sha256_ir_in get pk_ir_in_len 0
for i ulong 32
put gp_tmp_a i get sh_dig i
end
gp_load_ir 9
pk_sha256_ir_in get pk_ir_in_len 0
for i ulong 32
put gp_tmp_b i get sh_dig i
end

note Pack and store A importing sem_B
pk_reset_builder
gp_load_ir 8
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
for i ulong 32
put pk_query_id i get gp_tmp_b i
end
if ne pk_add_import_from_query PK_OK
ret gp_fail 65
end
if ne pk_pack PK_OK
ret gp_fail 66
end
if ne pk_store_put PK_OK
ret gp_fail 67
end
cycASlot = get pk_last_slot 0

note Pack and store B importing sem_A
pk_reset_builder
gp_load_ir 9
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
for i ulong 32
put pk_query_id i get gp_tmp_a i
end
if ne pk_add_import_from_query PK_OK
ret gp_fail 68
end
if ne pk_pack PK_OK
ret gp_fail 69
end
if ne pk_store_put PK_OK
ret gp_fail 70
end

note DFS starting at A MUST refuse A -> B -> A with PK_ERR_CYCLE
pk_copy_store_sem_to_query cycASlot
if ne pk_resolve_deps PK_ERR_CYCLE
ret gp_fail 71
end

note Direct self-cycle C -> C MUST also refuse with PK_ERR_CYCLE
gp_load_ir 10
pk_sha256_ir_in get pk_ir_in_len 0
for i ulong 32
put gp_tmp_a i get sh_dig i
end
pk_reset_builder
gp_load_ir 10
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
for i ulong 32
put pk_query_id i get gp_tmp_a i
end
if ne pk_add_import_from_query PK_OK
ret gp_fail 72
end
if ne pk_pack PK_OK
ret gp_fail 73
end
if ne pk_store_put PK_OK
ret gp_fail 74
end
pk_copy_store_sem_to_query get pk_last_slot 0
if ne pk_resolve_deps PK_ERR_CYCLE
ret gp_fail 75
end
gp_add_neg
gp_add_chk 11
ret 0
end

fn gp_neg_contract to int
cgBefore = get pk_real_out 5
note Neg Control 6a: SMEM overflow (131072 > SM121 101376) -> TDK_ERR_SMEM before codegen
pk_reset_builder
gp_load_ir 11
pk_set_req EXEC_SIMT_WARP 131072 64 32 0 0
if ne pk_pack PK_OK
ret gp_fail 76
end
smFeat = tdGet TID_SM121 TDF_FEAT
if ne pk_realize_on_arrive TID_SM121 smFeat 8192 7 TDK_ERR_SMEM
ret gp_fail 77
end
if ne get pk_real_out 5 cgBefore
ret gp_fail 78
end

note Neg Control 6b: MMA_161616_AMX on TID_X64_AVX2 -> TDK_ERR_MMA before codegen
pk_reset_builder
gp_load_ir 12
pk_set_req EXEC_SCALAR_SIMD 0 12 8 MMA_161616_AMX 0
if ne pk_pack PK_OK
ret gp_fail 79
end
avxFeat = tdGet TID_X64_AVX2 TDF_FEAT
if ne pk_realize_on_arrive TID_X64_AVX2 avxFeat 8192 7 TDK_ERR_MMA
ret gp_fail 80
end
if ne get pk_real_out 5 cgBefore
ret gp_fail 81
end
gp_add_neg
gp_add_chk 6
ret 0
end

fn gp_neg_proof to int
cgBefore = get pk_real_out 5
note Neg Control 7: Unproven realization (proofMask = 3) -> refused by tdCacheInstall
pk_reset_builder
gp_load_ir 13
pk_set_req EXEC_SCALAR_SIMD 0 8 4 0 FEAT_FMA
if ne pk_pack PK_OK
ret gp_fail 82
end
x925Feat = tdGet TID_X925 TDF_FEAT
if ne pk_realize_on_arrive TID_X925 x925Feat 7777 3 PK_ERR_PROOF
ret gp_fail 83
end
if or ne get pk_real_out 1 PK_NONE ne get pk_real_out 5 cgBefore
ret gp_fail 84
end
unpKey = get pk_real_out 3
if ne tdCacheLookup unpKey TID_X925 x925Feat 7777 PK_NONE
ret gp_fail 85
end
note Direct tdCacheInstall negative check with proofMask = 3
smFeat = tdGet TID_SM121 TDF_FEAT
if ne tdCacheInstall 555555 TID_SM121 smFeat 7777 131072 3 PK_NONE
ret gp_fail 86
end
gp_add_neg
gp_add_chk 5
ret 0
end

fn main to int
tdInitAll
tdCacheInit
pk_reset_all
put gp_chk 0 0
put gp_neg 0 0

r = gp_test_wire_exact
if ne r 0
ret r
end
r = gp_test_dag
if ne r 0
ret r
end
r = gp_test_realize_targets
if ne r 0
ret r
end
r = gp_test_semantic_dedup
if ne r 0
ret r
end
r = gp_neg_tamper_and_len
if ne r 0
ret r
end
r = gp_neg_deps_and_cycles
if ne r 0
ret r
end
r = gp_neg_contract
if ne r 0
ret r
end
r = gp_neg_proof
if ne r 0
ret r
end
if ne get gp_neg 0 7
ret gp_fail 99
end

gp_say 0
gp_num get gp_chk 0
gp_say 1
gp_num get pk_real_out 6
gp_say 2
gp_num get gp_neg 0
gp_say 3
ret 0
end

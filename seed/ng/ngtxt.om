note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngtxt.om: shared part of the ΩIR text tools ngas.om and ngdis.om (seed/ng/IR.md s10).
note Owner: ng-ir lane. Program mode, no fn main; globals x_*, functions tx_*. Built as
note   cat seed/ng/ngtxt.om seed/ng/ngas.om | omc   and   cat seed/ng/ngtxt.om seed/ng/ngdis.om | omc
note Neither tool shares code with seed/ng/src/ir.om or ngcheck.om: the text tools are the third
note independent decoder of the wire format, and the gate compares all three.
note Row table "OP NAME TK IMM FIX VAR TY" (IR.md s7.12; TK 0 P 1 E 2 R 3 T; TY 0 none 1 r 2 o 3 p).
text x_rows "1 const 0 1 0 0 1\n2 select 0 0 3 0 1\n10 add 0 0 2 0 1\n11 sub 0 0 2 0 1\n12 mul 0 0 2 0 1\n13 div 0 0 2 0 1\n14 rem 0 0 2 0 1\n15 neg 0 0 1 0 1\n16 and 0 0 2 0 1\n17 or 0 0 2 0 1\n18 xor 0 0 2 0 1\n19 not 0 0 1 0 1\n20 shl 0 0 2 0 1\n21 shr 0 0 2 0 1\n22 rotl 0 0 2 0 1\n23 rotr 0 0 2 0 1\n24 min 0 0 2 0 1\n25 max 0 0 2 0 1\n26 fsqrt 0 0 1 0 1\n27 fabs 0 0 1 0 1\n28 fmath 0 1 1 0 1\n30 eq 0 0 2 0 1\n31 ne 0 0 2 0 1\n32 lt 0 0 2 0 1\n33 le 0 0 2 0 1\n34 gt 0 0 2 0 1\n35 ge 0 0 2 0 1\n36 conv 0 1 1 0 1\n37 bitcast 0 0 1 0 1\n40 gpu.id 0 1 0 0 1\n41 shared 0 0 0 0 1\n42 load 2 0 2 0 1\n43 store 1 0 3 0 0\n44 sync 1 0 0 0 0\n45 shfl 0 1 2 0 1\n46 fma 0 0 3 0 1\n47 atom 1 1 3 0 1\n48 atomcas 1 1 4 0 1\n50 alloca 1 0 0 0 1\n51 fill 1 0 2 0 0\n52 gaddr 0 1 0 0 1\n53 len 0 0 1 0 1\n54 slice 2 0 3 0 1\n55 fload 2 1 1 0 1\n56 fstore 1 1 2 0 0\n57 fref 0 1 1 0 1\n58 vload 2 0 2 0 1\n59 vstore 1 0 3 0 0\n60 br 3 0 1 1 0\n61 cbr 3 0 3 0 0\n62 ret 3 0 0 0 0\n63 retv 3 0 1 0 0\n64 call 1 0 1 1 2\n65 trap 3 1 0 0 0\n66 exit 3 0 1 0 0\n67 launch 1 0 4 1 0\n70 chk.add 1 1 2 0 0\n71 chk.sub 1 1 2 0 0\n72 chk.mul 1 1 2 0 0\n73 chk.neg 1 1 1 0 0\n74 chk.divz 1 1 1 0 0\n75 chk.divovf 1 1 2 0 0\n76 chk.shl 1 1 2 0 0\n77 chk.shift 1 1 1 0 0\n78 chk.conv 1 1 1 0 3\n79 chk.bounds 1 1 3 0 0\n80 chk.slice 1 1 3 0 0\n81 chk.fuel 1 1 2 0 0\n82 chk.true 1 1 1 0 0\n90 fact.true 0 1 1 0 0\n91 fact.range 0 1 3 0 0\n92 fact.inbounds 0 1 3 0 0\n93 fact.slice 0 1 3 0 0\n100 vsplat 0 0 1 0 1\n101 vextract 0 1 1 0 1\n102 vinsert 0 1 2 0 1\n103 vreduce 0 1 1 0 1\n104 mmald 2 1 4 0 1\n105 mmast 1 1 5 0 0\n106 mma 0 1 3 0 1\n110 host 1 1 0 1 2\n111 pool.grow 1 1 1 0 1\n112 pool.len 2 1 0 0 1\n113 pool.load 2 1 1 0 1\n114 pool.store 1 1 2 0 0\n115 pool.read 1 1 3 0 1\n116 pool.write 1 1 3 0 1\n"
note built-in type names by id (IR.md s4.1); "-" marks an id without a name (printed %tN)
text x_tyn "void bool u8 u16 u32 u64 i8 i16 i32 i64 - - - f32 f64 - f16 bf16 e4m3 e5m2 tok "
note words: 0 fn 1 kernel 2 export 3 view 4 edit 5 host 6 global 7 shared 8 constant 9 private
note 10 a 11 b 12 c 13 le 14 be 15 vec 16 array 17 struct 18 ref 19 slice 20 frag 21 zero 22 data
note 23 flags 24 threads 25 subgroup 26 block 27 type 28 end 29 omegair 30 true 31 false
text x_kw "fn kernel export view edit host global shared constant private a b c le be vec array struct ref slice frag zero data flags threads subgroup block type end omegair true false pool "
global x_rok uchar 256
global x_rtk uchar 256
global x_rim uchar 256
global x_rfx uchar 256
global x_rva uchar 256
global x_rty uchar 256
global x_rno uint 256
global x_rnl uint 256
global x_kwo uint 64
global x_kwl uint 64
global x_tno uint 32
global x_tnl uint 32
global x_tk uchar 65568
global x_tsz ulong 65568
global x_nt ulong 1
global x_out uchar 1048576
global x_on ulong 1
global x_dg uchar 24
note ---- init ---------------------------------------------------------------------------------------
fn tx_init to void
tx_rinit
w = ulong 0
s = ulong 0
for i ulong len x_kw
if eq get x_kw i 32
put x_kwo w uint s
put x_kwl w uint sub i s
w = add w 1
s = add i 1
end
end
w = 0
s = 0
for i ulong len x_tyn
if eq get x_tyn i 32
put x_tno w uint s
put x_tnl w uint sub i s
w = add w 1
s = add i 1
end
end
end
note decimal at p in x_rows (no sign); the next position goes to x_on (reset by tx_init callers)
fn tx_rdec p ulong to ulong
i = p
v = ulong 0
while lt i len x_rows bound 12
c = get x_rows i
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
put x_on 0 i
ret v
end
fn tx_rinit to void
p = ulong 0
while lt p len x_rows bound 256
op = tx_rdec p
s = add get x_on 0 1
e = s
while ne get x_rows e 32 bound 32
e = add e 1
end
put x_rok op 1
put x_rno op uint s
put x_rnl op uint sub e s
p = add e 1
put x_rtk op uchar tx_rdec p
p = add get x_on 0 1
put x_rim op uchar tx_rdec p
p = add get x_on 0 1
put x_rfx op uchar tx_rdec p
p = add get x_on 0 1
put x_rva op uchar tx_rdec p
p = add get x_on 0 1
put x_rty op uchar tx_rdec p
p = add get x_on 0 1
end
put x_on 0 0
end
note ---- rows ----------------------------------------------------------------------------------------
note 1 when op has a token operand at slot 0 (E, R and T ops other than br)
fn tx_ntok op ulong to ulong
if or eq get x_rtk op 0 eq op 60
ret 0
end
ret 1
end
note operand slot kind: 0 value, 1 block, 2 function
fn tx_slot op ulong s ulong to ulong
if and eq op 60 eq s 0
ret 1
end
if and eq op 61 or eq s 2 eq s 3
ret 1
end
if and eq s 1 or eq op 64 eq op 67
ret 2
end
ret 0
end
note values op defines with result type t: its token (E ops), then its result (ty r or o, t != 0)
fn tx_ndef op ulong t ulong to ulong
n = ulong 0
if eq get x_rtk op 1
n = 1
end
c = get x_rty op
if and ne t 0 or eq c 1 eq c 2
n = add n 1
end
ret n
end
note ---- types --------------------------------------------------------------------------------------
fn tx_sb t ulong to ulong
if or eq t 1 eq t 2
ret 1
end
if or eq t 6 or eq t 18 eq t 19
ret 1
end
if or eq t 3 or eq t 7 or eq t 16 eq t 17
ret 2
end
if or eq t 4 or eq t 8 eq t 13
ret 4
end
if or eq t 5 or eq t 9 eq t 14
ret 8
end
ret 0
end
note byte size of type t for global data (scalars, and table VEC, ARRAY, STRUCT); 0 otherwise
fn tx_size t ulong to ulong
if lt t 32
ret tx_sb t
end
if ge t add 32 get x_nt 0
ret 0
end
ret get x_tsz t
end
fn tx_mul a ulong b ulong to ulong
x = ulong 1099511627776
if and ne a 0 gt b div x a
ret x
end
ret mul a b
end
note record table entry t (kind k) with size sz, as the next entry
fn tx_tset t ulong k ulong sz ulong to void
put x_tk t uchar k
put x_tsz t sz
put x_nt 0 sub t 31
end
note const formats: 1 bool, 2 unsigned decimal, 3 signed decimal, 4 hex bits, 0 plain decimal
fn tx_cf t ulong to ulong
if eq t 1
ret 1
end
if and ge t 2 le t 5
ret 2
end
if and ge t 6 le t 9
ret 3
end
if ne tx_sb t 0
ret 4
end
ret 0
end
note canonical const bits of a scalar type (IR.md s7.2)
fn tx_canon t ulong v ulong to bool
f = tx_cf t
if eq f 0
ret true
end
if eq f 1
ret le v 1
end
w = mul tx_sb t 8
if eq w 64
ret true
end
if eq f 3
h = shl ulong 1 sub w 1
ret lt add v h shl ulong 1 w
end
ret lt v shl ulong 1 w
end
note ---- output -------------------------------------------------------------------------------------
fn tx_flush to void
n = get x_on 0
o = ulong 0
while lt o n bound 1048577
k = write 1 x_out o sub n o
if le k 0
exit 27
end
o = add o ulong k
end
put x_on 0 0
end
fn tx_c b ulong to void
n = get x_on 0
if ge n len x_out
tx_flush
n = 0
end
put x_out n uchar b
put x_on 0 add n 1
end
fn tx_num v ulong to void
x = v
i = ulong 24
for j ulong 21
i = sub i 1
put x_dg i uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
end
for j ulong sub 24 i bound 24
tx_c ulong get x_dg add i j
end
end
fn tx_hx d ulong to void
if lt d 10
tx_c add d 48
else
tx_c add d 87
end
end
note n hex digits of the low bits of v, most significant first
fn tx_hexn v ulong n ulong to void
for j ulong n bound 16
tx_hx and shr v mul sub sub n 1 j 4 15
end
end
fn tx_kw i ulong to void
s = ulong get x_kwo i
for j ulong ulong get x_kwl i bound 16
tx_c ulong get x_kw add s j
end
end
fn tx_sp to void
tx_c 32
end
fn tx_nl to void
tx_c 10
end
fn tx_rname op ulong to void
s = ulong get x_rno op
for j ulong ulong get x_rnl op bound 16
tx_c ulong get x_rows add s j
end
end
note the built-in name of t, or %tN
fn tx_ty t ulong to void
if le t 20
if ne get x_tnl t 1
s = ulong get x_tno t
for j ulong ulong get x_tnl t bound 8
tx_c ulong get x_tyn add s j
end
ret
end
end
tx_c 37
tx_c 116
tx_num t
end
fn tx_val v ulong to void
tx_c 37
tx_num v
end

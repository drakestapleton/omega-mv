note SPDX-License-Identifier: Apache-2.0
note seed/ng/target/gate.om: Pure seeded OM-2 verification gate for Unified TargetDesc + Shared IPRA/RegAlloc +
note Multi-ISA Table-Driven ISel (AArch64, x86-64, RV64GC, SM121) + Proof-Gated Realization Cache.

global gDig uchar 24
text gMsgHdr "=== OMEGA NG UNIFIED TARGET-DESC + MULTI-ISA BACKEND GATE ===\n"
text gMsgPass "NG-TARGET-GATE PASS checks="
text gMsgCtrl " controls="
text gMsgNl "\n"
text gMsgFail "NG-TARGET-GATE FAIL at check="

fn gSay s ulong to void
if eq s 0
w = write 1 gMsgHdr 0 len gMsgHdr
ret
end
if eq s 1
w = write 1 gMsgPass 0 len gMsgPass
ret
end
if eq s 2
w = write 1 gMsgCtrl 0 len gMsgCtrl
ret
end
if eq s 3
w = write 1 gMsgNl 0 len gMsgNl
ret
end
w = write 1 gMsgFail 0 len gMsgFail
end

fn gNum v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gDig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 gDig p sub 24 p
ret
end
end
end

fn gFail id ulong to int
gSay 4
gNum id
gSay 3
ret int id
end

fn gGetU32 off ulong to ulong
b0 = ulong get isBuf off
b1 = shl ulong get isBuf add off 1 8
b2 = shl ulong get isBuf add off 2 16
b3 = shl ulong get isBuf add off 3 24
ret or or b0 b1 or b2 b3
end

note Populate 16 overlapping SSA live intervals to stress-test 12, 15, 30, and 64-register files!
fn gBuildStressIntervals to void
raReset
for i ulong 16
id = raAddInterval i add i 15 RA_SPILL
end
end

global gChk ulong 1
global gCtrl ulong 1

fn gAddChk n ulong to void
put gChk 0 add get gChk 0 n
end

fn gAddCtrl n ulong to void
put gCtrl 0 add get gCtrl 0 n
end

fn gTestTargets to int
if ne get tdCount 0 10
ret gFail 1
end
if ne tdGet TID_X925 TDF_OOO 10
ret gFail 2
end
if ne tdGet TID_A725 TDF_OOO 5
ret gFail 3
end
if ne tdGet TID_X64_AVX2 TDF_TWOADDR 1
ret gFail 4
end
if ne tdGet TID_SM121 TDF_SMEM 101376
ret gFail 5
end
if ne tdGet TID_SPARK_RING TDF_COHNS 4500
ret gFail 6
end
gAddChk 6
note 2. Compile-Time Physical Contract Checker + Negative Controls
tdSetReq EXEC_SIMT_WARP 16384 64 32 MMA_16816_BF16 FEAT_HMMA16816
if ne tdCheckKernelContract TID_SM121 TDK_OK
ret gFail 10
end
tdSet TID_SM121 TDF_SMEM 8192
if ne tdCheckKernelContract TID_SM121 TDK_ERR_SMEM
ret gFail 11
end
tdSet TID_SM121 TDF_SMEM 101376
gAddCtrl 1
tdSetReq EXEC_SIMT_WARP 0 16 32 0 0
if ne tdCheckKernelContract TID_X925 TDK_ERR_EXEC
ret gFail 12
end
gAddCtrl 1
tdSetReq EXEC_SCALAR_SIMD 0 12 8 MMA_161616_AMX 0
if ne tdCheckKernelContract TID_X64_AVX2 TDK_ERR_MMA
ret gFail 13
end
gAddCtrl 1
gAddChk 4
note 3. Target-Parameterized Tile/Blocking Planner
tdDeriveTilePlan TID_X925 4
x925Nc = get tdTileOut 2
tdDeriveTilePlan TID_A725 4
a725Nc = get tdTileOut 2
if le x925Nc a725Nc
ret gFail 20
end
tdDeriveTilePlan TID_X64_AVX512 4
if ne get tdTileOut 3 16
ret gFail 21
end
tdDeriveTilePlan TID_SM121 2
if ne get tdTileOut 0 64
ret gFail 22
end
gAddChk 3
ret 0
end

fn gTestRegAlloc to int
gBuildStressIntervals
spCm55 = raRunForTarget TID_CM55
if or eq spCm55 0 ne raVerifyColoring 0
ret gFail 30
end
spX64 = raRunForTarget TID_X64_AVX2
if or ne spX64 1 ne raVerifyColoring 0
ret gFail 31
end
spA64 = raRunForTarget TID_X925
if or ne spA64 0 ne raVerifyColoring 0
ret gFail 32
end
spSm121 = raRunForTarget TID_SM121
if or ne spSm121 0 ne raVerifyColoring 0
ret gFail 33
end
put raPhys 1 get raPhys 0
if eq raVerifyColoring 0
ret gFail 34
end
gAddCtrl 1
gAddChk 5
note 5. Whole-Program IPRA
raIpraReset 3
raIpraSetDirect 2 3
raIpraSetDirect 1 4
raIpraSetDirect 0 8
raIpraAddCall 0 1
raIpraAddCall 1 2
raIpraSolve
if ne get raFnProp 0 15
ret gFail 40
end
if ne raPopcount get raFnProp 1 3
ret gFail 41
end
if ge raPopcount get raFnProp 1 raPopcount tdGet TID_X925 TDF_CSAVE
ret gFail 42
end
gAddChk 3
ret 0
end

fn gTestIsel to int
if ne isSelect TID_X925 OIR_FMA 104
ret gFail 50
end
if ne isSelect TID_X925 OIR_SHA256 106
ret gFail 51
end
if ne isSelect TID_X64_AVX2 OIR_FMA 204
ret gFail 52
end
if ne isSelect TID_RV64_RVV OIR_SHA256 305
ret gFail 53
end
gAddChk 4
note 7a. AArch64: ADD x0,x0,x1; MUL x0,x0,x2; RET
if not isCompileTestFn TID_X925
ret gFail 60
end
if ne get isLen 0 12
ret gFail 61
end
if ne gGetU32 0 2332098560
ret gFail 62
end
if ne gGetU32 4 2600631296
ret gFail 62
end
if ne gGetU32 8 3596551104
ret gFail 62
end
note 7b. Register-Allocated x86-64: 48 01 f8; 48 0f af c6; c3
if not isCompileTestFn TID_X64_AVX2
ret gFail 63
end
if ne get isLen 0 8
ret gFail 64
end
if ne get isBuf 0 72
ret gFail 65
end
if ne get isBuf 1 1
ret gFail 65
end
if ne get isBuf 2 248
ret gFail 65
end
if ne get isBuf 7 195
ret gFail 65
end
if ne get isBuf 3 72
ret gFail 66
end
if ne get isBuf 4 15
ret gFail 66
end
if ne get isBuf 5 175
ret gFail 66
end
if ne get isBuf 6 198
ret gFail 66
end
note 7c. RV64GC: ADD a0,a0,a1; MUL a0,a0,a2; RET
if not isCompileTestFn TID_RV64_RVV
ret gFail 67
end
if ne get isLen 0 12
ret gFail 68
end
if ne gGetU32 0 11863347
ret gFail 69
end
if ne gGetU32 4 46466355
ret gFail 69
end
if ne gGetU32 8 32871
ret gFail 69
end
note 7d. SM121 Blackwell 128-bit SASS (48 B, Antibody #14 stall>=6)
if not isCompileTestFn TID_SM121
ret gFail 70
end
if ne get isLen 0 48
ret gFail 71
end
if ne gGetU32 8 6
ret gFail 72
end
if ne gGetU32 24 6
ret gFail 72
end
gAddChk 12
ret 0
end

fn gTestCache to int
if ne tdCacheInstall 12345 TID_SM121 3081 4 4096 3 999999
ret gFail 80
end
gAddCtrl 1
slot = tdCacheInstall 12345 TID_SM121 3081 4 4096 7
if eq slot 999999
ret gFail 81
end
slot2 = tdCacheInstall 12345 TID_SM121 3081 4 8192 7
if or ne slot2 slot or ne get rcPtr slot 8192 ne get rcVer slot 2
ret gFail 82
end
gAddChk 3
ret 0
end

fn gTestSm121Pe to int
note 9. Runtime Shape Partial Evaluator across M=1, M=4, M=8, M=512 + Cache Hit + SMEM Negative Control!
if ne peSpecializeW4Gemm 9001 TID_SM121 1 2048 9216 TDK_OK
ret gFail 90
end
if or ne get peOut 0 PE_REGIME_GEMV_4R ne get peOut 1 8192
ret gFail 91
end
s1 = get peOut 4
note M=4 MTP decode-verify -> auto-selects REG_TILE_M with exact SMEM=32768 B (zero HMMA padding waste!)
if ne peSpecializeW4Gemm 9001 TID_SM121 4 2048 9216 TDK_OK
ret gFail 92
end
if or ne get peOut 0 PE_REGIME_REG_TILE_M ne get peOut 1 32768
ret gFail 93
end
s4 = get peOut 4
if eq s4 s1
ret gFail 94
end
note Repeat M=4 lookup -> O(1) Realization Cache hit returns identical slot!
if ne peSpecializeW4Gemm 9001 TID_SM121 4 2048 9216 TDK_OK
ret gFail 95
end
if ne get peOut 4 s4
ret gFail 96
end
note M=512 chunked prefill -> auto-selects HMMA_16816 Tensor Core regime!
if ne peSpecializeW4Gemm 9001 TID_SM121 512 2048 9216 TDK_OK
ret gFail 97
end
if ne get peOut 0 PE_REGIME_HMMA_16816
ret gFail 98
end
note Negative control F: illegal M=8, K=4096 (reqSmem = 131072 > SM121 101376) MUST be refused pre-emit!
if ne peSpecializeW4Gemm 9001 TID_SM121 8 4096 2048 TDK_ERR_SMEM
ret gFail 99
end
gAddCtrl 1
note Negative control G: inject Antibody #14 violation (stall=2 < 6) -> peVerifySm121Antibodies MUST catch!
put isBuf 8 2
if peVerifySm121Antibodies
ret gFail 100
end
gAddCtrl 1
gAddChk 8
note 10. Orthogonal ELF64 container plugin across AArch64 (EM=183), x86-64 (EM=62), and RV64GC (EM=243)
if eq elfBuildExecDemo TID_X925 0
ret gFail 101
end
if ne get elfBuf 18 183
ret gFail 102
end
if eq elfBuildExecDemo TID_X64_AVX2 0
ret gFail 103
end
if ne get elfBuf 18 62
ret gFail 104
end
if not isCompileTestFn TID_RV64_RVV
ret gFail 105
end
if eq elfEmitStatic TID_RV64_RVV 0
ret gFail 106
end
if ne get elfBuf 18 243
ret gFail 107
end
gAddChk 6
ret 0
end

fn gTestFabric to int
fabInit
note 11. Heterogeneous apu-gb10 scheduler routes X925 / A725 / SM121 / Spark Ring
if ne fabScheduleApu TASK_CTRL_LATENCY TID_X925
ret gFail 110
end
if ne fabScheduleApu TASK_BG_METABOLIC TID_A725
ret gFail 111
end
if ne fabScheduleApu TASK_TENSOR_LOCAL TID_SM121
ret gFail 112
end
if ne fabScheduleApu TASK_TENSOR_MULTI_SPARK TID_SPARK_RING
ret gFail 113
end
note Negative control H: unverified fabWtbl hot-swap (proofMask=5, missing ngrun bit1) MUST be refused!
if fabHotSwap 0 7777 4096 TID_SM121 FAB_MODE_GPU_NATIVE 5
ret gFail 114
end
if ne get fabVer 0 0
ret gFail 115
end
gAddCtrl 1
note Install baseline neural/generic entry at slot 0, then trigger A725 Arboris metabolic specialization on M=4!
if not fabHotSwap 0 7777 4096 TID_SM121 FAB_MODE_NEURAL 7
ret gFail 116
end
for k ulong 4
h = fabObserveShape 7777 4 2048 9216
end
if ne fabMetabolicTick 0 TID_SM121 1
ret gFail 117
end
if or ne get fabMode 0 FAB_MODE_GPU_NATIVE ne get fabVer 0 2
ret gFail 118
end
gAddChk 8
ret 0
end

fn gTestCrystallize to int
crInit
note 12. ΩIR v2 SLAB contracts: immutable write refused, alarmed slab rolls back on overflow!
crRegSlab 0 SLAB_IMMUTABLE 0 TID_SM121
crRegSlab 1 SLAB_MUTABLE_ALARMED 100 TID_SM121
crRegSlab 2 SLAB_SHARDED 0 TID_SPARK_RING
note Negative control I: write to immutable W4 core weight slab MUST fail!
if ne crUpdateSlab 0 1 CR_ERR_IMMUTABLE
ret gFail 120
end
gAddCtrl 1
note Alarmed fast-weight slab accepts bounded update, then trips alarm + rolls back on spike!
if ne crUpdateSlab 1 40 CR_OK
ret gFail 121
end
if ne crUpdateSlab 1 80 CR_ERR_ALARM
ret gFail 122
end
if ne get crSlabNorm 1 40
ret gFail 123
end
gAddCtrl 1
note 13. Live Neural -> Portable ΩIR Crystallization Loop!
if not fabHotSwap 1 8888 8192 TID_SM121 FAB_MODE_NEURAL 7
ret gFail 124
end
if ne crCallOracle 1 2 3 15
ret gFail 125
end
if ne crCallOracle 1 4 1 15
ret gFail 126
end
if ne crCallOracle 1 7 5 36
ret gFail 127
end
if ne crCallOracle 1 10 2 36
ret gFail 128
end
if not crCrystallizeAndSwap 1 8888
ret gFail 129
end
if or ne get crOp1 0 OIR_ADD or ne get crOp2 0 OIR_MUL ne get crConstC 0 3
ret gFail 130
end
if or ne get fabMode 1 FAB_MODE_CRYSTALLIZED ge get fabCostNs 1 1000
ret gFail 131
end
note In-domain call hits crystallized exact path; out-of-domain (x0=200 > 100) trips alarm & falls back cleanly!
if ne crCallOracle 1 7 5 36
ret gFail 132
end
if ne crCallOracle 1 200 1 603
ret gFail 133
end
gAddChk 11
ret 0
end

fn gDumpElf tid ulong to int
n = elfBuildExecDemo tid
if eq n 0
ret 1
end
w = write 1 elfBuf 0 n
if ne w long n
ret 2
end
ret 0
end

fn gDumpCrystElf tid ulong to int
fabInit
crInit
ok = fabHotSwap 1 8888 8192 TID_SM121 FAB_MODE_NEURAL 7
y = crCallOracle 1 2 3
y = crCallOracle 1 7 5
y = crCallOracle 1 10 2
if not crSynthesizeFromTraces
ret 3
end
n = crEmitCrystallizedElf tid
if eq n 0
ret 4
end
w = write 1 elfBuf 0 n
if ne w long n
ret 5
end
ret 0
end

fn main to int
arg = new uchar 16 0
tdInitAll
isInitRules
tdCacheInit
if gt argcnt 1
al = argread 1 arg 0 16
if and ge al 3 eq get arg 0 97
ret gDumpElf TID_X925
end
if and ge al 3 eq get arg 0 120
ret gDumpElf TID_X64_AVX2
end
if and ge al 4 eq get arg 0 99
if eq get arg 1 97
ret gDumpCrystElf TID_X925
end
if eq get arg 1 120
ret gDumpCrystElf TID_X64_AVX2
end
end
end
gSay 0
put gChk 0 0
put gCtrl 0 0
r = gTestTargets
if ne r 0
ret r
end
r = gTestRegAlloc
if ne r 0
ret r
end
r = gTestIsel
if ne r 0
ret r
end
r = gTestCache
if ne r 0
ret r
end
r = gTestSm121Pe
if ne r 0
ret r
end
r = gTestFabric
if ne r 0
ret r
end
r = gTestCrystallize
if ne r 0
ret r
end
gSay 1
gNum get gChk 0
gSay 2
gNum get gCtrl 0
gSay 3
ret 0
end

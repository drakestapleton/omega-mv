note SPDX-License-Identifier: Apache-2.0
note seed/ng/target/gate_chips_tsv.om: Pure seeded OM-2 verification gate for seed/ng/target/chips_tsv.om.
note Composes directly after seed/ng/target/target_desc.om and seed/ng/target/chips_tsv.om.
note Link order (Linux AArch64):
note   cat si/directives/om2.om seed/ng/target/target_desc.om seed/ng/target/chips_tsv.om seed/ng/target/gate_chips_tsv.om | seed/out/omc > /tmp/gate_chips_tsv
note Link order (macOS Apple Silicon):
note   { printf 'target a64macos\nom2\n'; cat seed/ng/target/target_desc.om seed/ng/target/chips_tsv.om seed/ng/target/gate_chips_tsv.om; } | ~/.local/bin/omc > /tmp/gate_chips_tsv

global gc_buf uchar 65536
global gc_ctrl ulong 1
global gc_chips ulong 1

text gc_p_chips "seed/ng/target/chips.tsv"
text gc_p_missing "/tmp/omega_mv_chips_missing_404.tsv"
text gc_p_future "/tmp/omega_mv_chips_future.tsv"
text gc_p_mut_l2 "/tmp/omega_mv_chips_mut_l2.tsv"
text gc_fut_row "future-chip-2030\tFutureCorp\tQuantum-2030\t1\t21\tintel-xe\t128\t128\t262144\t16\t256\t32768\t128\t393225\tAdded dynamically without compiler recompile\n"
text gc_mut_stale_l2 "sm121\tNVIDIA\tGB10-Blackwell\t1\t16\tsm121\t64\t64\t101376\t32\t128\t65536\t19\t31753\tStale L2 mutant\n"
text gc_mut_bad_l2 "sm121\tNVIDIA\tGB10-Blackwell\t1\t16\tsm121\t64\t64\t101376\t32\t128\tbadl2\t19\t31753\tCorrupt L2 mutant\n"

text gc_id_x925 "grace-x925"
text gc_id_app "apple-m"
text gc_id_x64 "intel-x64"
text gc_id_xe2 "intel-xe2"
text gc_id_xe3 "intel-xe3-ptl"
text gc_id_mi "amd-mi300x"
text gc_id_halo "amd-strix-halo"
text gc_id_rdna4 "amd-rdna4"
text gc_id_rv64 "rv64-rvv"
text gc_id_sm121 "sm121"
text gc_id_apu "apu-gb10"
text gc_id_ring "spark-ring"
text gc_id_rtx "rtx5090"
text gc_id_wasm "wasm-universal"
text gc_id_spirv "spirv-vulkan"
text gc_id_fut "future-chip-2030"
text gc_id_none "nonexistent-chip-999"

text gc_msg_hdr "=== OMEGA NG CHIPS.TSV VERIFICATION GATE ===\n"
text gc_msg_pass "NG-CHIPS-TSV-GATE PASS chips="
text gc_msg_ctrl " controls="
text gc_msg_fail "NG-CHIPS-TSV-GATE FAIL at step="
text gc_msg_nl "\n"

fn gc_fail step ulong to int
  ctWriteAll 1 gc_msg_fail
  ctWriteU64 1 step
  ctWriteAll 1 gc_msg_nl
  ret int step
end

fn gc_check_chip name view uchar * expBk ulong expSmem ulong expNgpr ulong expL2 ulong to int
  cid = ctFindChip name len name
  if ge cid ctCount
    ret 1
  end
  if ne ctBackend cid expBk
    ret 2
  end
  if ne ctSmem cid expSmem
    ret 3
  end
  if ne ctNgpr cid expNgpr
    ret 4
  end
  if ne ctL2Kb cid expL2
    ret 5
  end
  ret 0
end

fn gc_test_ids to int
  if ne gc_check_chip gc_id_x925 CT_BK_ARM64 0 30 2048 0
    ret gc_fail 10
  end
  if ne gc_check_chip gc_id_app CT_BK_APPLE 0 29 16384 0
    ret gc_fail 11
  end
  if ne gc_check_chip gc_id_x64 CT_BK_X64 0 15 512 0
    ret gc_fail 12
  end
  if ne gc_check_chip gc_id_xe2 CT_BK_XE 131072 128 18432 0
    ret gc_fail 13
  end
  if ne gc_check_chip gc_id_xe3 CT_BK_XE 131072 128 18432 0
    ret gc_fail 14
  end
  if ne gc_check_chip gc_id_mi CT_BK_SPIRV 65536 104 32768 0
    ret gc_fail 15
  end
  if ne gc_check_chip gc_id_halo CT_BK_SPIRV 65536 106 4096 0
    ret gc_fail 16
  end
  if ne gc_check_chip gc_id_rdna4 CT_BK_SPIRV 65536 106 8192 0
    ret gc_fail 17
  end
  if ne gc_check_chip gc_id_rv64 CT_BK_RV64 0 30 512 0
    ret gc_fail 18
  end
  if ne gc_check_chip gc_id_sm121 CT_BK_SM121 101376 64 24576 0
    ret gc_fail 19
  end
  if ne gc_check_chip gc_id_apu CT_BK_SM121 101376 64 24576 0
    ret gc_fail 23
  end
  if ne gc_check_chip gc_id_ring CT_BK_SM121 101376 64 49152 0
    ret gc_fail 24
  end
  if ne gc_check_chip gc_id_rtx CT_BK_SM121 101376 64 98304 0
    ret gc_fail 25
  end
  if ne gc_check_chip gc_id_wasm CT_BK_WASM 65536 64 1024 0
    ret gc_fail 20
  end
  if ne gc_check_chip gc_id_spirv CT_BK_SPIRV 32768 64 1024 0
    ret gc_fail 21
  end
  if ne ctFindChip gc_id_none len gc_id_none CT_MISSING
    ret gc_fail 22
  end
  ret 0
end

fn gc_test_positive to int
  cidSm = ctFindChip gc_id_sm121 len gc_id_sm121
  if ne ctCheckContract cidSm 98304 48 0 false TDK_OK
    ret gc_fail 30
  end
  if ne tdGet CT_TD_SLOT TDF_SMEM 101376
    ret gc_fail 31
  end
  if ne tdGet CT_TD_SLOT TDF_L2_KB 24576
    ret gc_fail 36
  end
  if ne ctCheckL2 cidSm 24576 TDK_OK
    ret gc_fail 37
  end
  tdDeriveTilePlan CT_TD_SLOT 2
  if ne get tdTileOut 0 64
    ret gc_fail 32
  end
  cidApu = ctFindChip gc_id_apu len gc_id_apu
  ctSyncTd cidApu
  if ne tdGet CT_TD_SLOT TDF_L2_KB 24576
    ret gc_fail 38
  end
  cidRing = ctFindChip gc_id_ring len gc_id_ring
  ctSyncTd cidRing
  if ne tdGet CT_TD_SLOT TDF_L2_KB 49152
    ret gc_fail 39
  end
  if ne ctCheckL2 cidRing 49152 TDK_OK
    ret gc_fail 29
  end
  cidXe2 = ctFindChip gc_id_xe2 len gc_id_xe2
  if ne ctCheckContract cidXe2 98304 48 0 false TDK_OK
    ret gc_fail 33
  end
  cidWasm = ctFindChip gc_id_wasm len gc_id_wasm
  if ne ctCheckContract cidWasm 16384 48 0 false TDK_OK
    ret gc_fail 34
  end
  cidX64 = ctFindChip gc_id_x64 len gc_id_x64
  if ne ctCheckContract cidX64 16384 48 0 true TDK_OK
    ret gc_fail 35
  end
  cidX925 = ctFindChip gc_id_x925 len gc_id_x925
  if ne ctCheckStrict cidX925 0 30 0 0 0 TDK_OK
    ret gc_fail 28
  end
  ret 0
end

fn gc_write_text_file path view uchar * data view uchar * to int
  ofd = fopen path 0 len path 577 420
  if lt ofd 0
    ret 1
  end
  iofd = int ofd
  tot = len data
  p = ulong 0
  while lt p tot bound 64
    w = write iofd data p sub tot p
    if le w 0
      z = fclose iofd
      ret 2
    end
    p = add p ulong w
  end
  z = fclose iofd
  ret 0
end

fn gc_write_future_tsv to int
  fd = fopen gc_p_chips 0 len gc_p_chips 0 0
  if lt fd 0
    ret 1
  end
  ifd = int fd
  tot = ulong 0
  done = false
  while not done bound 1024
    if ge tot 64000
      z = fclose ifd
      ret 2
    end
    r = read ifd gc_buf tot sub 64000 tot
    if lt r 0
      z = fclose ifd
      ret 3
    end
    if eq r 0
      done = true
    else
      tot = add tot ulong r
    end
  end
  z = fclose ifd
  if gt tot 0
    if ne get gc_buf sub tot 1 10
      put gc_buf tot uchar 10
      tot = add tot 1
    end
  end
  rlen = len gc_fut_row
  for i ulong rlen bound 512
    put gc_buf add tot i get gc_fut_row i
  end
  tot = add tot rlen
  ofd = fopen gc_p_future 0 len gc_p_future 577 420
  if lt ofd 0
    ret 4
  end
  iofd = int ofd
  p = ulong 0
  while lt p tot bound 1024
    w = write iofd gc_buf p sub tot p
    if le w 0
      z = fclose iofd
      ret 5
    end
    p = add p ulong w
  end
  z = fclose iofd
  ret 0
end

fn gc_test_controls to int
  put gc_ctrl 0 0
  note Control 1: amd-strix-halo refuses 98304 B SMEM with TDK_ERR_SMEM (2)
  cidHalo = ctFindChip gc_id_halo len gc_id_halo
  if ne ctCheckContract cidHalo 98304 48 0 false TDK_ERR_SMEM
    ret gc_fail 40
  end
  put gc_ctrl 0 add get gc_ctrl 0 1

  note Control 2: intel-x64 refuses 48 raw regs with TDK_ERR_REGS (3)
  cidX64 = ctFindChip gc_id_x64 len gc_id_x64
  if ne ctCheckContract cidX64 16384 48 0 false TDK_ERR_REGS
    ret gc_fail 41
  end
  put gc_ctrl 0 add get gc_ctrl 0 1

  note Control 3: missing file fails closed (!= 0 and ctCount == 0)
  rcMiss = ctLoadFile gc_p_missing len gc_p_missing
  if eq rcMiss 0
    ret gc_fail 42
  end
  if ne ctCount 0
    ret gc_fail 43
  end
  put gc_ctrl 0 add get gc_ctrl 0 1

  note Control 4: dynamic future-chip-2030 reload without recompile
  if ne gc_write_future_tsv 0
    ret gc_fail 44
  end
  if ne ctLoadFile gc_p_future len gc_p_future 0
    ret gc_fail 45
  end
  if ne ctCount 25
    ret gc_fail 46
  end
  cidFut = ctFindChip gc_id_fut len gc_id_fut
  if ge cidFut 25
    ret gc_fail 47
  end
  if ne ctCheckContract cidFut 16384 48 0 false TDK_OK
    ret gc_fail 48
  end
  if ne ctCheckContract cidFut 300000 48 0 false TDK_ERR_SMEM
    ret gc_fail 49
  end
  put gc_ctrl 0 add get gc_ctrl 0 1

  note Control 5: L2 budget & strict CPU contract enforcement (reload canonical chips.tsv first)
  if ne ctLoadFile gc_p_chips len gc_p_chips 0
    ret gc_fail 50
  end
  cidSm = ctFindChip gc_id_sm121 len gc_id_sm121
  if ne ctCheckL2 cidSm 24577 CT_ERR_L2
    ret gc_fail 51
  end
  if ne ctCheckL2 cidSm 65536 CT_ERR_L2
    ret gc_fail 52
  end
  cidRing = ctFindChip gc_id_ring len gc_id_ring
  if ne ctCheckL2 cidRing 49153 CT_ERR_L2
    ret gc_fail 53
  end
  cidX925 = ctFindChip gc_id_x925 len gc_id_x925
  if ne ctCheckStrict cidX925 1 30 0 0 0 TDK_ERR_SMEM
    ret gc_fail 54
  end
  if ne ctCheckStrict cidX925 0 31 0 0 0 TDK_ERR_REGS
    ret gc_fail 55
  end
  put gc_ctrl 0 add get gc_ctrl 0 1

  note Control 6: Negative L2 mutants (stale 65536 KiB regression + non-numeric corrupt L2)
  if ne gc_write_text_file gc_p_mut_l2 gc_mut_stale_l2 0
    ret gc_fail 56
  end
  if ne ctLoadFile gc_p_mut_l2 len gc_p_mut_l2 0
    ret gc_fail 57
  end
  if eq gc_check_chip gc_id_sm121 CT_BK_SM121 101376 64 24576 0
    ret gc_fail 58
  end
  if ne gc_write_text_file gc_p_mut_l2 gc_mut_bad_l2 0
    ret gc_fail 59
  end
  if eq ctLoadFile gc_p_mut_l2 len gc_p_mut_l2 0
    ret gc_fail 60
  end
  if ne ctCount 0
    ret gc_fail 61
  end
  put gc_ctrl 0 add get gc_ctrl 0 1
  ret 0
end

fn main to int
  tdInitAll
  ctWriteAll 1 gc_msg_hdr
  if ne ctLoadFile gc_p_chips len gc_p_chips 0
    ret gc_fail 1
  end
  if ne ctCount 24
    ret gc_fail 2
  end
  put gc_chips 0 ctCount

  r = gc_test_ids
  if ne r 0
    ret r
  end
  r = gc_test_positive
  if ne r 0
    ret r
  end
  ctPrintMatrix 1 16384 48 0 true

  r = gc_test_controls
  if ne r 0
    ret r
  end

  ctWriteAll 1 gc_msg_pass
  ctWriteU64 1 get gc_chips 0
  ctWriteAll 1 gc_msg_ctrl
  ctWriteU64 1 get gc_ctrl 0
  ctWriteAll 1 gc_msg_nl
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/target/chips_tsv.om: Canonical runtime 15-column chips.tsv parser & TargetDesc contract bridge.
note Pure seeded OM-2 library unit (no om2 header, no fn main, no Linux-only host words; prefix ct_ / CT_).
note Composes directly after seed/ng/target/target_desc.om (compatible with a64macos, Linux aarch64, and x86linux).

const CT_MAX_CHIPS ulong 64
const CT_MISSING ulong 999
const CT_ERR_TSV int 73
const CT_TD_SLOT ulong 15

const CT_BK_CONTRACT ulong 0
const CT_BK_APPLE ulong 1
const CT_BK_ARM64 ulong 2
const CT_BK_X64 ulong 3
const CT_BK_RV64 ulong 4
const CT_BK_WASM ulong 5
const CT_BK_SPIRV ulong 6
const CT_BK_XE ulong 7
const CT_BK_SM121 ulong 8

global ct_cnt ulong 1
global ct_id uchar 2048
global ct_idlen ulong 64
global ct_vend uchar 2048
global ct_vlen ulong 64
global ct_fam uchar 2048
global ct_flen ulong 64
global ct_exec ulong 64
global ct_isa ulong 64
global ct_bk ulong 64
global ct_ngpr ulong 64
global ct_nvec ulong 64
global ct_smem ulong 64
global ct_subg ulong 64
global ct_l1 ulong 64
global ct_l2 ulong 64
global ct_mma ulong 64
global ct_feat ulong 64
global ct_tsv uchar 65536
global ct_tsv_len ulong 1
global ct_numbuf uchar 32
global ct_parse_err ulong 1

text ct_s_con "contract-only"
text ct_s_app "apple-m"
text ct_s_arm "arm64-linux"
text ct_s_x64 "x64-linux"
text ct_s_rv "rv64-elf"
text ct_s_wasm "wasm"
text ct_s_spv "spirv"
text ct_s_xe "intel-xe"
text ct_s_sm "sm121"

text ct_m_hdr "CHIPS_TSV count="
text ct_m_c0 "cid="
text ct_m_c1 " id="
text ct_m_c2 " vendor="
text ct_m_c3 " backend="
text ct_m_c4 " exec="
text ct_m_c5 " isa="
text ct_m_c6 " smem="
text ct_m_c7 " ngpr="
text ct_m_c8 " subg="
text ct_m_c9 " contract="
text ct_m_pass "PASS"
text ct_m_ref "TDK_ERR_"
text ct_m_nl "\n"

fn ctWriteAll fd int s view uchar * to void
  p = ulong 0
  n = len s
  while lt p n bound 65536
    k = write fd s p sub n p
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn ctWriteU64 fd int v ulong to void
  if eq v 0
    put ct_numbuf 0 uchar 48
    k = write fd ct_numbuf 0 1
    ret
  end
  i = ulong 0
  x = v
  while gt x 0 bound 32
    put ct_numbuf i uchar add 48 rem x 10
    x = div x 10
    i = add i 1
  end
  j = ulong 0
  while lt j div i 2 bound 32
    t = get ct_numbuf j
    r = sub sub i 1 j
    put ct_numbuf j get ct_numbuf r
    put ct_numbuf r t
    j = add j 1
  end
  k = write fd ct_numbuf 0 i
end

fn ctWriteId fd int cid ulong to void
  if ge cid get ct_cnt 0
    ret
  end
  l = get ct_idlen cid
  b = mul cid 32
  k = write fd ct_id b l
end

fn ctWriteVendor fd int cid ulong to void
  if ge cid get ct_cnt 0
    ret
  end
  l = get ct_vlen cid
  b = mul cid 32
  k = write fd ct_vend b l
end

fn ctWriteFamily fd int cid ulong to void
  if ge cid get ct_cnt 0
    ret
  end
  l = get ct_flen cid
  b = mul cid 32
  k = write fd ct_fam b l
end

fn ctWriteBackend fd int bk ulong to void
  if eq bk CT_BK_CONTRACT
    ctWriteAll fd ct_s_con
    ret
  end
  if eq bk CT_BK_APPLE
    ctWriteAll fd ct_s_app
    ret
  end
  if eq bk CT_BK_ARM64
    ctWriteAll fd ct_s_arm
    ret
  end
  if eq bk CT_BK_X64
    ctWriteAll fd ct_s_x64
    ret
  end
  if eq bk CT_BK_RV64
    ctWriteAll fd ct_s_rv
    ret
  end
  if eq bk CT_BK_WASM
    ctWriteAll fd ct_s_wasm
    ret
  end
  if eq bk CT_BK_SPIRV
    ctWriteAll fd ct_s_spv
    ret
  end
  if eq bk CT_BK_XE
    ctWriteAll fd ct_s_xe
    ret
  end
  if eq bk CT_BK_SM121
    ctWriteAll fd ct_s_sm
  end
end

fn ctCount to ulong
  ret get ct_cnt 0
end

fn ctExec cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_exec cid
end

fn ctIsa cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_isa cid
end

fn ctBackend cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_bk cid
end

fn ctNgpr cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_ngpr cid
end

fn ctNvec cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_nvec cid
end

fn ctSmem cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_smem cid
end

fn ctSubgroup cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_subg cid
end

fn ctL1Kb cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_l1 cid
end

fn ctL2Kb cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_l2 cid
end

fn ctMma cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_mma cid
end

fn ctFeat cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_feat cid
end

fn ctIdLen cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_idlen cid
end

fn ctVendorLen cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_vlen cid
end

fn ctFamilyLen cid ulong to ulong
  if ge cid get ct_cnt 0
    ret 0
  end
  ret get ct_flen cid
end

fn ct_tsv_eq s ulong e ulong kw view uchar * to bool
  if ne sub e s len kw
    ret false
  end
  i = ulong 0
  n = len kw
  while lt i n bound 128
    if ne get ct_tsv add s i get kw i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn ct_tsv_u64 s ulong e ulong to ulong
  if ge s e
    put ct_parse_err 0 1
    ret 0
  end
  if gt sub e s 20
    put ct_parse_err 0 1
    ret 0
  end
  v = ulong 0
  p = s
  while lt p e bound 32
    c = get ct_tsv p
    if or lt c 48 gt c 57
      put ct_parse_err 0 1
      ret 0
    end
    d = ulong sub c 48
    if or gt v 1844674407370955161 and eq v 1844674407370955161 gt d 5
      put ct_parse_err 0 1
      ret 0
    end
    v = add mul v 10 d
    p = add p 1
  end
  ret v
end

fn ct_tsv_bk s ulong e ulong to ulong
  if ct_tsv_eq s e ct_s_con
    ret CT_BK_CONTRACT
  end
  if ct_tsv_eq s e ct_s_app
    ret CT_BK_APPLE
  end
  if ct_tsv_eq s e ct_s_arm
    ret CT_BK_ARM64
  end
  if ct_tsv_eq s e ct_s_x64
    ret CT_BK_X64
  end
  if ct_tsv_eq s e ct_s_rv
    ret CT_BK_RV64
  end
  if ct_tsv_eq s e ct_s_wasm
    ret CT_BK_WASM
  end
  if ct_tsv_eq s e ct_s_spv
    ret CT_BK_SPIRV
  end
  if ct_tsv_eq s e ct_s_xe
    ret CT_BK_XE
  end
  if ct_tsv_eq s e ct_s_sm
    ret CT_BK_SM121
  end
  put ct_parse_err 0 1
  ret 0
end

fn ct_copy_id cid ulong s ulong e ulong to void
  if ge s e
    put ct_parse_err 0 1
    ret
  end
  l = sub e s
  if gt l 31
    put ct_parse_err 0 1
    ret
  end
  put ct_idlen cid l
  base = mul cid 32
  for i ulong l bound 32
    put ct_id add base i get ct_tsv add s i
  end
end

fn ct_copy_vend cid ulong s ulong e ulong to void
  if ge s e
    put ct_parse_err 0 1
    ret
  end
  l = sub e s
  if gt l 31
    l = ulong 31
  end
  put ct_vlen cid l
  base = mul cid 32
  for i ulong l bound 32
    put ct_vend add base i get ct_tsv add s i
  end
end

fn ct_copy_fam cid ulong s ulong e ulong to void
  if ge s e
    put ct_parse_err 0 1
    ret
  end
  l = sub e s
  if gt l 31
    l = ulong 31
  end
  put ct_flen cid l
  base = mul cid 32
  for i ulong l bound 32
    put ct_fam add base i get ct_tsv add s i
  end
end

fn ct_next_tab p ulong le_ ulong to ulong
  while lt p le_ bound 8192
    if eq get ct_tsv p 9
      ret p
    end
    p = add p 1
  end
  ret p
end

fn ct_is_hdr s ulong e ulong to bool
  if ne sub e s 2
    ret false
  end
  if ne get ct_tsv s 105
    ret false
  end
  ret eq get ct_tsv add s 1 100
end

fn ct_apply_lo cid ulong col ulong s ulong e ulong to void
  if eq col 0
    ct_copy_id cid s e
    ret
  end
  if eq col 1
    ct_copy_vend cid s e
    ret
  end
  if eq col 2
    ct_copy_fam cid s e
    ret
  end
  if eq col 3
    ex = ct_tsv_u64 s e
    if gt ex 2
      put ct_parse_err 0 1
    end
    put ct_exec cid ex
    ret
  end
  if eq col 4
    put ct_isa cid ct_tsv_u64 s e
    ret
  end
  if eq col 5
    put ct_bk cid ct_tsv_bk s e
    ret
  end
  if eq col 6
    put ct_ngpr cid ct_tsv_u64 s e
  end
end

fn ct_apply_hi cid ulong col ulong s ulong e ulong to void
  if eq col 7
    put ct_nvec cid ct_tsv_u64 s e
    ret
  end
  if eq col 8
    put ct_smem cid ct_tsv_u64 s e
    ret
  end
  if eq col 9
    put ct_subg cid ct_tsv_u64 s e
    ret
  end
  if eq col 10
    put ct_l1 cid ct_tsv_u64 s e
    ret
  end
  if eq col 11
    put ct_l2 cid ct_tsv_u64 s e
    ret
  end
  if eq col 12
    put ct_mma cid ct_tsv_u64 s e
    ret
  end
  if eq col 13
    put ct_feat cid ct_tsv_u64 s e
  end
end

fn ct_parse_row ls ulong le_ ulong to int
  if ge ls le_
    ret 0
  end
  if eq get ct_tsv ls 35
    ret 0
  end
  p = ls
  c = ulong 0
  cid = get ct_cnt 0
  while le c 14 bound 16
    if gt p le_
      ret CT_ERR_TSV
    end
    s = p
    e = ct_next_tab p le_
    if eq c 0
      if lt e le_
        if ct_is_hdr s e
          ret 0
        end
      end
      if ge cid CT_MAX_CHIPS
        ret CT_ERR_TSV
      end
    end
    put ct_parse_err 0 0
    if le c 6
      ct_apply_lo cid c s e
    else
      ct_apply_hi cid c s e
    end
    if ne get ct_parse_err 0 0
      ret CT_ERR_TSV
    end
    if lt c 14
      if ge e le_
        ret CT_ERR_TSV
      end
      p = add e 1
    else
      if lt e le_
        ret CT_ERR_TSV
      end
    end
    c = add c 1
  end
  put ct_cnt 0 add cid 1
  ret 0
end

fn ct_parse_tsv to int
  put ct_cnt 0 0
  n = get ct_tsv_len 0
  p = ulong 0
  while lt p n bound 65536
    ls = p
    while lt p n bound 65536
      if eq get ct_tsv p 10
        break
      end
      p = add p 1
    end
    le_ = p
    if gt le_ ls
      if eq get ct_tsv sub le_ 1 13
        le_ = sub le_ 1
      end
    end
    if gt sub le_ ls 8190
      put ct_cnt 0 0
      ret CT_ERR_TSV
    end
    rc = ct_parse_row ls le_
    if ne rc 0
      put ct_cnt 0 0
      ret rc
    end
    if lt p n
      p = add p 1
    end
  end
  if eq get ct_cnt 0 0
    ret CT_ERR_TSV
  end
  ret 0
end

fn ctLoadFile path view uchar * plen ulong to int
  put ct_cnt 0 0
  put ct_tsv_len 0 0
  if or eq plen 0 or gt plen len path gt plen 4095
    ret CT_ERR_TSV
  end
  fd = fopen path 0 plen 0 0
  if lt fd 0
    ret CT_ERR_TSV
  end
  ifd = int fd
  done = false
  while not done bound 1024
    cur = get ct_tsv_len 0
    if ge cur 65535
      z = fclose ifd
      ret CT_ERR_TSV
    end
    r = read ifd ct_tsv cur sub 65535 cur
    if lt r 0
      z = fclose ifd
      ret CT_ERR_TSV
    end
    if eq r 0
      done = true
    else
      put ct_tsv_len 0 add cur ulong r
    end
  end
  z = fclose ifd
  if not done
    ret CT_ERR_TSV
  end
  ret ct_parse_tsv
end

fn ctFindChip name view uchar * nlen ulong to ulong
  if or eq nlen 0 or gt nlen len name gt nlen 31
    ret CT_MISSING
  end
  cnt = get ct_cnt 0
  cid = ulong 0
  while lt cid cnt bound 65
    if eq get ct_idlen cid nlen
      base = mul cid 32
      ok = true
      for i ulong nlen bound 32
        if ne get ct_id add base i get name i
          ok = false
          break
        end
      end
      if ok
        ret cid
      end
    end
    cid = add cid 1
  end
  ret CT_MISSING
end

fn ctSyncTd cid ulong to void
  if ge cid get ct_cnt 0
    ret
  end
  ex = get ct_exec cid
  isa = get ct_isa cid
  ptrb = ulong 64
  if or eq isa ISA_THUMB2 eq isa ISA_ETHOSU
    ptrb = ulong 32
  end
  vbits = ulong 128
  if eq ex EXEC_SIMT_WARP
    vbits = ulong 1024
  else
    if eq isa ISA_X64
      vbits = ulong 256
      if ge get ct_nvec cid 32
        vbits = ulong 512
      end
    end
  end
  line = ulong 64
  if or eq ex EXEC_SIMT_WARP eq get ct_bk cid CT_BK_APPLE
    line = ulong 128
  end
  tdRegIsa CT_TD_SLOT isa ex ptrb get ct_ngpr cid get ct_nvec cid
  tdRegVec CT_TD_SLOT 0 vbits 0 0 get ct_subg cid
  tdRegCache CT_TD_SLOT get ct_l1 cid get ct_l2 cid line get ct_smem cid
  tdRegLat CT_TD_SLOT 4 4 12 16
  tdRegFeat CT_TD_SLOT get ct_feat cid get ct_mma cid 1 0 0
end

fn ctCheckContract cid ulong reqSmem ulong reqRegs ulong reqMma ulong foldCpu bool to ulong
  if ge cid get ct_cnt 0
    ret TDK_ERR_EXEC
  end
  ctSyncTd cid
  ex = get ct_exec cid
  if eq ex EXEC_SIMT_WARP
    tdSetReq EXEC_SIMT_WARP reqSmem reqRegs 0 reqMma 0
    ret tdCheckKernelContract CT_TD_SLOT
  end
  if eq ex EXEC_SYSTOLIC
    tdSetReq EXEC_SYSTOLIC reqSmem reqRegs 0 reqMma 0
    ret tdCheckKernelContract CT_TD_SLOT
  end
  reqSm = ulong 0
  if gt get ct_smem cid 0
    reqSm = reqSmem
  end
  regs = reqRegs
  if and foldCpu gt regs 12
    regs = ulong 12
  end
  tdSetReq EXEC_SCALAR_SIMD reqSm regs 0 reqMma 0
  ret tdCheckKernelContract CT_TD_SLOT
end

fn ct_print_row fd int cid ulong res ulong to void
  ctWriteAll fd ct_m_c0
  ctWriteU64 fd cid
  ctWriteAll fd ct_m_c1
  ctWriteId fd cid
  ctWriteAll fd ct_m_c2
  ctWriteVendor fd cid
  ctWriteAll fd ct_m_c3
  ctWriteBackend fd get ct_bk cid
  ctWriteAll fd ct_m_c4
  ctWriteU64 fd get ct_exec cid
  ctWriteAll fd ct_m_c5
  ctWriteU64 fd get ct_isa cid
  ctWriteAll fd ct_m_c6
  ctWriteU64 fd get ct_smem cid
  ctWriteAll fd ct_m_c7
  ctWriteU64 fd get ct_ngpr cid
  ctWriteAll fd ct_m_c8
  ctWriteU64 fd get ct_subg cid
  ctWriteAll fd ct_m_c9
  if eq res TDK_OK
    ctWriteAll fd ct_m_pass
  else
    ctWriteAll fd ct_m_ref
    ctWriteU64 fd res
  end
  ctWriteAll fd ct_m_nl
end

fn ctPrintMatrix fd int reqSmem ulong reqRegs ulong reqMma ulong foldCpu bool to void
  cnt = get ct_cnt 0
  ctWriteAll fd ct_m_hdr
  ctWriteU64 fd cnt
  ctWriteAll fd ct_m_nl
  cid = ulong 0
  while lt cid cnt bound 65
    res = ctCheckContract cid reqSmem reqRegs reqMma foldCpu
    ct_print_row fd cid res
    cid = add cid 1
  end
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/target/target_desc.om: Unified 24-field TargetDesc registry (CPU + GPU + NPU + APU + Spark Ring),
note compile-time physical contract checker, target-parameterized tile planner, and proof-gated Realization Cache.

const TD_FIELDS ulong 24
const TD_MAX_TARGETS ulong 16

note Field indices into tdTable[tid * 24 + field]:
const TDF_ISA ulong 0
const TDF_EXEC ulong 1
const TDF_ENDIAN ulong 2
const TDF_PTRBITS ulong 3
const TDF_NGPR ulong 4
const TDF_NVEC ulong 5
const TDF_NPRED ulong 6
const TDF_VECBITS ulong 7
const TDF_SCALABLE ulong 8
const TDF_TWOADDR ulong 9
const TDF_SUBGROUP ulong 10
const TDF_L1D_KB ulong 11
const TDF_L2_KB ulong 12
const TDF_LINE ulong 13
const TDF_SMEM ulong 14
const TDF_OOO ulong 15
const TDF_MULLAT ulong 16
const TDF_DIVLAT ulong 17
const TDF_BRCOST ulong 18
const TDF_FEAT ulong 19
const TDF_MMA ulong 20
const TDF_MEMDOM ulong 21
const TDF_COHNS ulong 22
const TDF_CSAVE ulong 23

note ISA IDs:
const ISA_A64 ulong 1
const ISA_X64 ulong 2
const ISA_RV64 ulong 3
const ISA_THUMB2 ulong 4
const ISA_SM121 ulong 16
const ISA_ETHOSU ulong 17

note Execution models:
const EXEC_SCALAR_SIMD ulong 0
const EXEC_SIMT_WARP ulong 1
const EXEC_SYSTOLIC ulong 2

note Feature bitmasks:
const FEAT_FMA ulong 1
const FEAT_DOTPROD ulong 2
const FEAT_I8MM ulong 4
const FEAT_BF16 ulong 8
const FEAT_AVX2 ulong 16
const FEAT_AVX512 ulong 32
const FEAT_RVV ulong 64
const FEAT_SHA ulong 128
const FEAT_AES ulong 256
const FEAT_BMI2 ulong 512
const FEAT_FP8 ulong 1024
const FEAT_HMMA16816 ulong 2048

note MMA shape bitmasks:
const MMA_16816_BF16 ulong 1
const MMA_16832_FP8 ulong 2
const MMA_888_I8MM ulong 4
const MMA_161616_AMX ulong 8

note Built-in silicon profile IDs:
const TID_X925 ulong 0
const TID_A725 ulong 1
const TID_X64_AVX2 ulong 2
const TID_X64_AVX512 ulong 3
const TID_RV64_RVV ulong 4
const TID_CM55 ulong 5
const TID_SM121 ulong 6
const TID_ETHOSU55 ulong 7
const TID_APU_GB10 ulong 8
const TID_SPARK_RING ulong 9

note Physical contract refusal codes:
const TDK_OK ulong 0
const TDK_ERR_EXEC ulong 1
const TDK_ERR_SMEM ulong 2
const TDK_ERR_REGS ulong 3
const TDK_ERR_SUBGROUP ulong 4
const TDK_ERR_MMA ulong 5
const TDK_ERR_FEAT ulong 6

global tdTable ulong 384
global tdCount ulong 1
global tdTileOut ulong 8

note Realization cache (64 entries): key(sem, tid, feat, shape) -> codePtr + proofMask + version
const RC_CAP ulong 64
global rcUsed ulong 64
global rcSem ulong 64
global rcTid ulong 64
global rcFeat ulong 64
global rcShape ulong 64
global rcPtr ulong 64
global rcProof ulong 64
global rcVer ulong 64

fn tdSet tid ulong f ulong v ulong to void
put tdTable add mul tid TD_FIELDS f v
end

fn tdGet tid ulong f ulong to ulong
ret get tdTable add mul tid TD_FIELDS f
end

fn tdRegIsa tid ulong isa ulong execM ulong ptrB ulong ngpr ulong nvec ulong to void
tdSet tid TDF_ISA isa
tdSet tid TDF_EXEC execM
tdSet tid TDF_ENDIAN 0
tdSet tid TDF_PTRBITS ptrB
tdSet tid TDF_NGPR ngpr
tdSet tid TDF_NVEC nvec
end

fn tdRegVec tid ulong npred ulong vbits ulong scal ulong twoA ulong subg ulong to void
tdSet tid TDF_NPRED npred
tdSet tid TDF_VECBITS vbits
tdSet tid TDF_SCALABLE scal
tdSet tid TDF_TWOADDR twoA
tdSet tid TDF_SUBGROUP subg
end

global tdReq ulong 8

fn tdRegCache tid ulong l1 ulong l2 ulong line ulong smem ulong to void
tdSet tid TDF_L1D_KB l1
tdSet tid TDF_L2_KB l2
tdSet tid TDF_LINE line
tdSet tid TDF_SMEM smem
end

fn tdRegLat tid ulong ooo ulong mlat ulong dlat ulong brc ulong to void
tdSet tid TDF_OOO ooo
tdSet tid TDF_MULLAT mlat
tdSet tid TDF_DIVLAT dlat
tdSet tid TDF_BRCOST brc
end

fn tdRegFeat tid ulong feat ulong mma ulong mdom ulong coh ulong csave ulong to void
tdSet tid TDF_FEAT feat
tdSet tid TDF_MMA mma
tdSet tid TDF_MEMDOM mdom
tdSet tid TDF_COHNS coh
tdSet tid TDF_CSAVE csave
end

fn tdInitAll to void
put tdCount 0 10
note 0: Cortex-X925 (DGX Spark big core: 10-wide OOO, NEON/SVE/i8mm/BF16/SHA/AES)
tdRegIsa TID_X925 ISA_A64 EXEC_SCALAR_SIMD 64 30 32
tdRegVec TID_X925 16 128 1 0 4
tdRegCache TID_X925 64 2048 64 0
tdRegLat TID_X925 10 2 8 11
tdRegFeat TID_X925 399 MMA_888_I8MM 1 0 262143

note 1: Cortex-A725 (DGX Spark efficiency core: 5-wide OOO, background metabolic lane)
tdRegIsa TID_A725 ISA_A64 EXEC_SCALAR_SIMD 64 30 32
tdRegVec TID_A725 16 128 1 0 4
tdRegCache TID_A725 64 512 64 0
tdRegLat TID_A725 5 3 12 13
tdRegFeat TID_A725 399 MMA_888_I8MM 1 0 262143

note 2: x86-64 AVX2 + BMI2 + FMA (2-addr, 15 allocatable GPRs)
tdRegIsa TID_X64_AVX2 ISA_X64 EXEC_SCALAR_SIMD 64 15 16
tdRegVec TID_X64_AVX2 0 256 0 1 8
tdRegCache TID_X64_AVX2 32 512 64 0
tdRegLat TID_X64_AVX2 6 3 14 14
tdRegFeat TID_X64_AVX2 913 0 0 0 1983

note 3: x86-64 AVX-512 + AMX (2-addr, 15 GPRs, 32 ZMMs, 8 k-preds)
tdRegIsa TID_X64_AVX512 ISA_X64 EXEC_SCALAR_SIMD 64 15 32
tdRegVec TID_X64_AVX512 8 512 0 1 16
tdRegCache TID_X64_AVX512 48 2048 64 0
tdRegLat TID_X64_AVX512 6 3 14 14
tdRegFeat TID_X64_AVX512 953 MMA_161616_AMX 0 0 1983

note 4: RV64GC + RVV 1.0 (3-addr, 30 allocatable GPRs, scalable VLA)
tdRegIsa TID_RV64_RVV ISA_RV64 EXEC_SCALAR_SIMD 64 30 32
tdRegVec TID_RV64_RVV 0 256 1 0 8
tdRegCache TID_RV64_RVV 32 512 64 0
tdRegLat TID_RV64_RVV 4 3 20 12
tdRegFeat TID_RV64_RVV 65 0 0 0 1073741823

note 5: Cortex-M55 MCU (Thumb-2 32-bit, 12 allocatable GPRs, MVE/Helium)
tdRegIsa TID_CM55 ISA_THUMB2 EXEC_SCALAR_SIMD 32 12 8
tdRegVec TID_CM55 1 128 0 0 4
tdRegCache TID_CM55 32 0 32 65536
tdRegLat TID_CM55 2 2 12 6
tdRegFeat TID_CM55 3 0 0 0 15

note 6: NVIDIA GB10 SM121 Blackwell GPU (SIMT 32-lane warp, 101376 B SMEM, HMMA 16816 + FP8)
tdRegIsa TID_SM121 ISA_SM121 EXEC_SIMT_WARP 64 64 64
tdRegVec TID_SM121 7 1024 0 0 32
tdRegCache TID_SM121 128 65536 128 101376
tdRegLat TID_SM121 4 4 24 20
tdRegFeat TID_SM121 3081 3 1 80 0

note 7: Arm Ethos-U55 NPU (systolic command stream, 64 KiB scratchpad)
tdRegIsa TID_ETHOSU55 ISA_ETHOSU EXEC_SYSTOLIC 32 8 8
tdRegVec TID_ETHOSU55 0 256 0 0 16
tdRegCache TID_ETHOSU55 0 0 64 65536
tdRegLat TID_ETHOSU55 1 1 0 0
tdRegFeat TID_ETHOSU55 2 0 2 400 0

note 8: apu-gb10 coherent superchip view (X925 + A725 + SM121 over NVLink-C2C AMBA CHI)
tdRegIsa TID_APU_GB10 ISA_SM121 EXEC_SIMT_WARP 64 64 64
tdRegVec TID_APU_GB10 7 1024 0 0 32
tdRegCache TID_APU_GB10 128 65536 128 101376
tdRegLat TID_APU_GB10 10 4 24 20
tdRegFeat TID_APU_GB10 3087 7 1 80 0

note 9: Multi-Spark 2-node ring view (2x GB10 over direct NIC ring, 4500 ns sync)
tdRegIsa TID_SPARK_RING ISA_SM121 EXEC_SIMT_WARP 64 64 64
tdRegVec TID_SPARK_RING 7 1024 0 0 32
tdRegCache TID_SPARK_RING 128 131072 128 101376
tdRegLat TID_SPARK_RING 10 4 24 20
tdRegFeat TID_SPARK_RING 3087 7 3 4500 0
end

fn tdSetReq reqExec ulong reqSmem ulong reqRegs ulong reqSubg ulong reqMma ulong reqFeat ulong to void
put tdReq 0 reqExec
put tdReq 1 reqSmem
put tdReq 2 reqRegs
put tdReq 3 reqSubg
put tdReq 4 reqMma
put tdReq 5 reqFeat
end

note Compile-time Physical Contract Checker: verifies kernel requirements against TargetDesc before emit!
fn tdCheckKernelContract tid ulong to ulong
if ne get tdReq 0 tdGet tid TDF_EXEC
ret TDK_ERR_EXEC
end
if gt get tdReq 1 tdGet tid TDF_SMEM
ret TDK_ERR_SMEM
end
if gt get tdReq 2 tdGet tid TDF_NGPR
ret TDK_ERR_REGS
end
rs = get tdReq 3
if and ne rs 0 ne rs tdGet tid TDF_SUBGROUP
ret TDK_ERR_SUBGROUP
end
rm = get tdReq 4
if ne and rm tdGet tid TDF_MMA rm
ret TDK_ERR_MMA
end
rf = get tdReq 5
if ne and rf tdGet tid TDF_FEAT rf
ret TDK_ERR_FEAT
end
ret TDK_OK
end

note Target-Parameterized Tile/Blocking Planner: derives (MC, KC, NC, VEC_ELEMS) from TargetDesc!
fn tdDeriveTilePlan tid ulong elemBytes ulong to void
vbits = tdGet tid TDF_VECBITS
ve = div vbits mul elemBytes 8
if eq ve 0
ve = ulong 1
end
ex = tdGet tid TDF_EXEC
if eq ex EXEC_SIMT_WARP
sm = tdGet tid TDF_SMEM
mc = ulong 16
nc = ulong 64
kc = ulong 64
if ge sm 65536
mc = ulong 64
nc = ulong 128
kc = ulong 64
end
put tdTileOut 0 mc
put tdTileOut 1 kc
put tdTileOut 2 nc
put tdTileOut 3 ve
ret
end
l1b = mul tdGet tid TDF_L1D_KB 1024
l2b = mul tdGet tid TDF_L2_KB 1024
kc = div l1b mul mul ve elemBytes 4
if lt kc 32
kc = ulong 32
end
if gt kc 512
kc = ulong 512
end
mc = mul ve 4
nc = div l2b mul mul kc elemBytes 2
if lt nc 64
nc = ulong 64
end
if gt nc 1024
nc = ulong 1024
end
put tdTileOut 0 mc
put tdTileOut 1 kc
put tdTileOut 2 nc
put tdTileOut 3 ve
end

note Proof-Gated Realization Cache (mirrors GPU QDI_WTBL + CPU indirect dispatch table)
fn tdCacheInit to void
for i ulong RC_CAP
put rcUsed i 0
put rcVer i 0
end
end

fn tdCacheLookup semId ulong tid ulong feat ulong shapeSig ulong to ulong
for i ulong RC_CAP
if eq get rcUsed i 1
if and eq get rcSem i semId eq get rcTid i tid
if and eq get rcFeat i feat eq get rcShape i shapeSig
ret i
end
end
end
end
ret 999999
end

note Proof mask required for admission: bit0=ngcheck, bit1=ngrun/kemu, bit2=antibodies (mask == 7)
fn tdCacheInstall semId ulong tid ulong feat ulong shapeSig ulong codePtr ulong proofMask ulong to ulong
if ne and proofMask 7 7
ret 999999
end
ex = tdCacheLookup semId tid feat shapeSig
if ne ex 999999
put rcPtr ex codePtr
put rcProof ex proofMask
put rcVer ex add get rcVer ex 1
ret ex
end
for i ulong RC_CAP
if eq get rcUsed i 0
put rcUsed i 1
put rcSem i semId
put rcTid i tid
put rcFeat i feat
put rcShape i shapeSig
put rcPtr i codePtr
put rcProof i proofMask
put rcVer i 1
ret i
end
end
ret 999999
end

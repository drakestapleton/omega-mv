note SPDX-License-Identifier: Apache-2.0
note seed/ng/egraph/gate_egraph.om: Pure seeded OM-2 verification gate for seed/ng/egraph/ir_egraph.om.
note Program-mode gate (no om2 line; concatenated with printf 'om2\n' + ir.om + ir_egraph.om + gate_egraph.om).
note Exercises all 18 EGP3 rewrite rules across 32-bit and 64-bit widths + real ΩIR blocks,
note verifies strict cost reduction under both SM121 and X925 cost parameters, checks negative controls,
note self-validates the emitted EGP3 binary buffer, and optionally writes it to argv[1].

global g_dig uchar 24
global g_path uchar 1024
global g_neg ulong 1
global g_vrm ulong 1
global g_verr ulong 1

text g_msg_pass "NG-EGRAPH-GATE PASS certs="
text g_msg_rules " rules_exercised="
text g_msg_neg " neg_controls="
text g_msg_bytes " egp3_bytes="
text g_msg_nl "\n"
text g_msg_fail "NG-EGRAPH-GATE FAIL check="

fn g_wrt s view uchar * to void
r = write 1 s 0 len s
end

fn g_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put g_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 g_dig p sub 24 p
ret
end
end
end

fn g_fail code ulong to int
g_wrt g_msg_fail
g_num code
g_wrt g_msg_nl
ret int code
end

fn g_popcount18 msk ulong to ulong
c = ulong 0
for r ulong 18
if ne and msk shl ulong 1 add r 1 0
c = add c 1
end
end
ret c
end

note Direct algebraic cases 0..3 (compact locals to stay well within omc's register pool)
fn g_build_case_lo cid ulong to ulong
if eq cid 0
note 32-bit: add(mul(r0, r1), add(r2, 0)) -> fma(r0, r1, r2) [Rules 1, 3]
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
t0 = eg3_add_bin EG3_OP_MUL r0 r1
t1 = eg3_add_bin EG3_OP_ADD r2 eg3_add_const 0
ret eg3_add_bin EG3_OP_ADD t0 t1
end
if eq cid 1
note 32-bit: add(add(0, r2), mul(and(r0, r0), mul(r1, 1))) -> fma(r0, r1, r2) [Rules 2, 4, 5, 11]
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
t0 = eg3_add_bin EG3_OP_ADD eg3_add_const 0 r2
t1 = eg3_add_bin EG3_OP_AND r0 r0
t2 = eg3_add_bin EG3_OP_MUL r1 eg3_add_const 1
t3 = eg3_add_bin EG3_OP_MUL t1 t2
ret eg3_add_bin EG3_OP_ADD t0 t3
end
if eq cid 2
note 32-bit: add(mul(8, r0), mul(0, r1)) -> shl(r0, 3) [Rules 6, 8, 18, 3]
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
t0 = eg3_add_bin EG3_OP_MUL eg3_add_const 8 r0
t1 = eg3_add_bin EG3_OP_MUL eg3_add_const 0 r1
ret eg3_add_bin EG3_OP_ADD t0 t1
end
note 64-bit: fma(r0, 1<<33, 0) -> mul(r0, 1<<33) -> shl(r0, 33) [Rules 12, 18, val_hi!=0]
eg3_reset 64
r0 = eg3_add_ssa 0
t0 = eg3_add_const shl ulong 1 33
t1 = eg3_add_const 0
ret eg3_add_fma r0 t0 t1
end

note Direct algebraic cases 4..7
fn g_build_case_hi cid ulong to ulong
if eq cid 4
note 32-bit: add(add(r0, mul(r1, r2)), r3) -> add(r3, fma(r1, r2, r0)) [Rules 7, 9, 1, 2]
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
r3 = eg3_add_ssa 3
t0 = eg3_add_bin EG3_OP_MUL r1 r2
t1 = eg3_add_bin EG3_OP_ADD r0 t0
ret eg3_add_bin EG3_OP_ADD t1 r3
end
if eq cid 5
note 64-bit: mul(mul(r0, 8), 1) -> shl(r0, 3) [Rules 10, 5, 18]
eg3_reset 64
r0 = eg3_add_ssa 0
t0 = eg3_add_bin EG3_OP_MUL r0 eg3_add_const 8
ret eg3_add_bin EG3_OP_MUL t0 eg3_add_const 1
end
if eq cid 6
note 32-bit: sub(add(sub(r0, 0), xor(r1, r1)), sub(r2, r2)) -> r0 [Rules 13, 14, 15, 3]
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
t0 = eg3_add_bin EG3_OP_SUB r0 eg3_add_const 0
t1 = eg3_add_bin EG3_OP_XOR r1 r1
t2 = eg3_add_bin EG3_OP_SUB r2 r2
t3 = eg3_add_bin EG3_OP_ADD t0 t1
ret eg3_add_bin EG3_OP_SUB t3 t2
end
note 64-bit: shl(or(and(r0, r0), xor(r1, r1)), sub(r2, r2)) -> r0 [Rules 11, 14, 15, 16, 17]
eg3_reset 64
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
t0 = eg3_add_bin EG3_OP_AND r0 r0
t1 = eg3_add_bin EG3_OP_XOR r1 r1
t2 = eg3_add_bin EG3_OP_SUB r2 r2
t3 = eg3_add_bin EG3_OP_OR t0 t1
ret eg3_add_bin EG3_OP_SHL t3 t2
end

fn g_build_case cid ulong to ulong
if lt cid 4
ret g_build_case_lo cid
end
ret g_build_case_hi cid
end

note Verify strict cost reduction for case cid under BOTH SM121 and X925, and emit cert
fn g_run_case cid ulong fnIdx ulong blkIdx ulong to int
eg3_set_costs_x925
rx = g_build_case cid
eg3_compute_costs
cb = eg3_get_cost rx
eg3_saturate 2
if ge eg3_get_cost rx cb
ret g_fail add 10 cid
end
eg3_set_costs_sm121
rs = g_build_case cid
eg3_compute_costs
cb = eg3_get_cost rs
eg3_saturate 2
if ge eg3_get_cost rs cb
ret g_fail add 20 cid
end
if eq get eg3_trn 0 0
ret g_fail add 30 cid
end
if not eg3_cert_append fnIdx blkIdx rs eg3_get_best rs
ret g_fail add 40 cid
end
ret 0
end

note Emit token-bearing and convergent ops into 32-bit ΩIR block (returns latest token)
fn g_emit_refused32 b uint p0 uint p1 uint p2 uint tok0 uint to uint
o = ir_op b 70 0 0 3
ir_set o 0 tok0
ir_set o 1 p0
ir_set o 2 p1
tk = ir_otok o
o = ir_op b 42 4 0 3
ir_set o 0 tk
ir_set o 1 p0
ir_set o 2 p1
o = ir_op b 43 0 0 4
ir_set o 0 tk
ir_set o 1 p0
ir_set o 2 p1
ir_set o 3 p2
tk = ir_otok o
o = ir_op b 110 4 0 1
ir_set o 0 tk
tk = ir_otok o
o = ir_op b 44 0 0 1
ir_set o 0 tk
tk = ir_otok o
o = ir_op b 45 4 0 2
ir_set o 0 p0
ir_set o 1 p1
o = ir_op b 106 4 0 3
ir_set o 0 p0
ir_set o 1 p1
ir_set o 2 p2
ret tk
end

note Build real ΩIR block 0 (32-bit u32): mixes token-bearing + convergent ops with pure arithmetic
fn g_build_ir_blk32 to uint
ir_init
f = ir_fnew 0 0 4
p0 = ir_fpar f 4
p1 = ir_fpar f 4
p2 = ir_fpar f 4
b = ir_blk f
tk = g_emit_refused32 b p0 p1 p2 ir_ftok f
c0 = ir_res ir_op b 1 4 0 0
c8 = ir_res ir_op b 1 4 8 0
o = ir_op b 12 4 0 2
ir_set o 0 p0
ir_set o 1 c8
v1 = ir_res o
o = ir_op b 12 4 0 2
ir_set o 0 v1
ir_set o 1 p1
v1 = ir_res o
o = ir_op b 10 4 0 2
ir_set o 0 p2
ir_set o 1 c0
v2 = ir_res o
o = ir_op b 10 4 0 2
ir_set o 0 v1
ir_set o 1 v2
v1 = ir_res o
o = ir_op b 63 0 0 2
ir_set o 0 tk
ir_set o 1 v1
ret b
end

note Emit mmald(104), mmast(105), call(64) into 64-bit ΩIR block
fn g_emit_refused64 b uint f uint p0 uint p1 uint p2 uint tok0 uint to uint
o = ir_op b 104 5 0 5
ir_set o 0 tok0
ir_set o 1 p0
ir_set o 2 p1
ir_set o 3 p2
ir_set o 4 p0
o = ir_op b 105 0 0 6
ir_set o 0 tok0
ir_set o 1 p0
ir_set o 2 p1
ir_set o 3 p2
ir_set o 4 p0
ir_set o 5 p1
tk = ir_otok o
o = ir_op b 64 5 0 2
ir_set o 0 tk
ir_set o 1 f
ret ir_otok o
end

note Build real ΩIR block 1 (64-bit u64): mixes mmald, mmast, call with pure u64 ops
fn g_build_ir_blk64 to uint
ir_init
f = ir_fnew 0 0 5
p0 = ir_fpar f 5
p1 = ir_fpar f 5
p2 = ir_fpar f 5
b = ir_blk f
tk = g_emit_refused64 b f p0 p1 p2 ir_ftok f
c1 = ir_res ir_op b 1 5 1 0
c16 = ir_res ir_op b 1 5 16 0
o = ir_op b 12 5 0 2
ir_set o 0 p0
ir_set o 1 c1
v1 = ir_res o
o = ir_op b 12 5 0 2
ir_set o 0 v1
ir_set o 1 c16
v1 = ir_res o
o = ir_op b 11 5 0 2
ir_set o 0 p1
ir_set o 1 p1
v2 = ir_res o
o = ir_op b 17 5 0 2
ir_set o 0 p2
ir_set o 1 v2
v2 = ir_res o
o = ir_op b 10 5 0 2
ir_set o 0 v1
ir_set o 1 v2
v1 = ir_res o
o = ir_op b 63 0 0 2
ir_set o 0 tk
ir_set o 1 v1
ret b
end

fn g_test_ir_blocks to int
b32 = g_build_ir_blk32
eg3_set_costs_x925
if eq eg3_opt_ir_block 4 0 b32 32 false 0
ret g_fail 50
end
eg3_set_costs_sm121
if eq eg3_opt_ir_block 4 0 b32 32 true 0
ret g_fail 51
end
if ne get eg3_ir_stat 0 5
ret g_fail 52
end
if ne get eg3_ir_stat 1 3
ret g_fail 53
end
if ne get eg3_ir_stat 11 1
ret g_fail 54
end
put g_neg 0 add get g_neg 0 2

b64 = g_build_ir_blk64
eg3_set_costs_x925
if eq eg3_opt_ir_block 5 0 b64 64 false 0
ret g_fail 55
end
eg3_set_costs_sm121
if eq eg3_opt_ir_block 5 0 b64 64 true 0
ret g_fail 56
end
if ne get eg3_ir_stat 0 2
ret g_fail 57
end
if ne get eg3_ir_stat 1 2
ret g_fail 58
end
if ne get eg3_ir_stat 11 1
ret g_fail 59
end
put g_neg 0 add get g_neg 0 2
ret 0
end

note Negative controls part 1: non-power-of-two multiplies MUST NOT fire Rule 18
fn g_neg_pow2 to int
eg3_set_costs_sm121
eg3_reset 32
r0 = eg3_add_ssa 0
m6 = eg3_add_bin EG3_OP_MUL r0 eg3_add_const 6
eg3_compute_costs
cb = eg3_get_cost m6
eg3_saturate 2
if ne and get eg3_rmask 0 shl ulong 1 18 0
ret g_fail 60
end
if ne eg3_get_cost m6 cb
ret g_fail 61
end
put g_neg 0 add get g_neg 0 1

eg3_reset 64
r0 = eg3_add_ssa 0
mb = eg3_add_bin EG3_OP_MUL r0 eg3_add_const add shl ulong 1 33 1
eg3_saturate 2
if ne and get eg3_rmask 0 shl ulong 1 18 0
ret g_fail 62
end
put g_neg 0 add get g_neg 0 1
ret 0
end

note Negative controls part 2: token-bearing, convergent, and float opcodes strictly refused
fn g_neg_opcodes to int
if ne eg3_ir_opcode_check 42 4 EG3_REFUSE_TOKEN
ret g_fail 63
end
if ne eg3_ir_opcode_check 43 4 EG3_REFUSE_TOKEN
ret g_fail 64
end
if ne eg3_ir_opcode_check 64 4 EG3_REFUSE_TOKEN
ret g_fail 65
end
if ne eg3_ir_opcode_check 70 4 EG3_REFUSE_TOKEN
ret g_fail 66
end
if ne eg3_ir_opcode_check 110 4 EG3_REFUSE_TOKEN
ret g_fail 67
end
put g_neg 0 add get g_neg 0 1

if ne eg3_ir_opcode_check 44 4 EG3_REFUSE_CONVERGENT
ret g_fail 68
end
if ne eg3_ir_opcode_check 45 4 EG3_REFUSE_CONVERGENT
ret g_fail 69
end
if ne eg3_ir_opcode_check 104 4 EG3_REFUSE_CONVERGENT
ret g_fail 70
end
if ne eg3_ir_opcode_check 105 4 EG3_REFUSE_CONVERGENT
ret g_fail 71
end
if ne eg3_ir_opcode_check 106 4 EG3_REFUSE_CONVERGENT
ret g_fail 72
end
put g_neg 0 add get g_neg 0 1

if ne eg3_ir_opcode_check 10 13 EG3_REFUSE_TYPE
ret g_fail 73
end
if ne eg3_ir_opcode_check 12 14 EG3_REFUSE_TYPE
ret g_fail 74
end
put g_neg 0 add get g_neg 0 1
ret 0
end

note Negative controls part 3: pure-token/convergent block yields 0 ops, plus FMA target-cost sensitivity
fn g_neg_blk_cost to int
ir_init
f = ir_fnew 0 0 0
p0 = ir_fpar f 4
b = ir_blk f
o = ir_op b 44 0 0 1
ir_set o 0 ir_ftok f
tk = ir_otok o
o = ir_op b 45 4 0 2
ir_set o 0 p0
ir_set o 1 p0
o = ir_op b 62 0 0 1
ir_set o 0 tk
d0 = eg3_opt_ir_block 9 0 b 32 true
if or ne d0 0 ne get eg3_ir_stat 4 0
ret g_fail 75
end
if ne get eg3_ir_stat 11 0
ret g_fail 76
end
put g_neg 0 add get g_neg 0 1

eg3_set_target_costs 0 2 8 0
eg3_reset 32
r0 = eg3_add_ssa 0
r1 = eg3_add_ssa 1
r2 = eg3_add_ssa 2
m = eg3_add_bin EG3_OP_MUL r0 r1
rt = eg3_add_bin EG3_OP_ADD m r2
eg3_saturate 2
if eq get eg3_op eg3_get_best rt EG3_OP_FMA
ret g_fail 77
end
eg3_set_target_costs 0 2 8 1
eg3_compute_costs
if ne get eg3_op eg3_get_best rt EG3_OP_FMA
ret g_fail 78
end
put g_neg 0 add get g_neg 0 1
ret 0
end

fn g_verify_nodes p0 ulong nc ulong w ulong to ulong
p = p0
for i ulong nc bound 512
if ne eg3_get_u32 add p 24 w
put g_verr 0 88
ret 0
end
p = add p 32
end
ret p
end

fn g_verify_trace p0 ulong nt ulong nc ulong to ulong
p = p0
for i ulong nt bound 512
rid = eg3_get_u32 p
if or lt rid 1 gt rid 18
put g_verr 0 90
ret 0
end
if or ge eg3_get_u32 add p 4 nc ge eg3_get_u32 add p 8 nc
put g_verr 0 90
ret 0
end
bit = shl ulong 1 rid
put g_vrm 0 or get g_vrm 0 bit
p = add p 12
end
ret p
end

note Verify one serialized EGP3 cert entry starting at offset p0; returns next offset or 0 on error
fn g_verify_one_cert p0 ulong nb ulong to ulong
if gt add p0 28 nb
put g_verr 0 84
ret 0
end
w = eg3_get_u32 add p0 8
nc = eg3_get_u32 add p0 12
rb = eg3_get_u32 add p0 16
ra = eg3_get_u32 add p0 20
nt = eg3_get_u32 add p0 24
if and ne w 32 ne w 64
put g_verr 0 85
ret 0
end
if or eq nc 0 or ge rb nc or ge ra nc eq nt 0
put g_verr 0 86
ret 0
end
p = add p0 28
if gt add p mul nc 32 nb
put g_verr 0 87
ret 0
end
p = g_verify_nodes p nc w
if eq p 0
ret 0
end
if gt add p mul nt 12 nb
put g_verr 0 89
ret 0
end
ret g_verify_trace p nt nc
end

fn g_verify_egp3_buf to int
nb = get eg3_bpos 0
if lt nb 8
ret g_fail 80
end
if or ne get eg3_buf 0 69 ne get eg3_buf 1 71
ret g_fail 81
end
if or ne get eg3_buf 2 80 ne get eg3_buf 3 51
ret g_fail 82
end
ncerts = eg3_get_u32 4
if ne ncerts get eg3_certs 0
ret g_fail 83
end
p = ulong 8
put g_vrm 0 0
put g_verr 0 0
for k ulong ncerts bound 64
p = g_verify_one_cert p nb
if eq p 0
ret g_fail get g_verr 0
end
end
if ne p nb
ret g_fail 91
end
if ne g_popcount18 get g_vrm 0 18
ret g_fail 92
end
ret 0
end

fn main to int
put g_neg 0 0
eg3_cert_init

for cid ulong 8
rc = g_run_case cid div cid 2 rem cid 2
if ne rc 0
ret rc
end
end

rc = g_test_ir_blocks
if ne rc 0
ret rc
end

rc = g_neg_pow2
if ne rc 0
ret rc
end

rc = g_neg_opcodes
if ne rc 0
ret rc
end

rc = g_neg_blk_cost
if ne rc 0
ret rc
end

rc = g_verify_egp3_buf
if ne rc 0
ret rc
end

if ge argcnt 2
plen = argread 1 g_path 0 1023
if lt plen 1
ret g_fail 95
end
fd = fopen g_path 0 ulong plen 577 420
if lt fd 0
ret g_fail 96
end
ok = eg3_write_fd int fd
z = fclose int fd
if not ok
ret g_fail 97
end
end

g_wrt g_msg_pass
g_num get eg3_certs 0
g_wrt g_msg_rules
g_num g_popcount18 get eg3_all_rmask 0
g_wrt g_msg_neg
g_num get g_neg 0
g_wrt g_msg_bytes
g_num get eg3_bpos 0
g_wrt g_msg_nl
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/front/rename.om: whole-token renaming of an Omega unit (ng-front; DECISIONS D1b name discipline).
note Handwritten seeded Omega, program mode, Linux AArch64, built by the pinned seed/out/omc.
note   rename MAP < IN.om > OUT.om
note MAP holds lines `OLD NEW` (lines starting with # are skipped). Every space-separated word of IN that is
note exactly some OLD is written as its NEW; every other byte is copied. A line whose first word is `note` is
note copied unchanged, and so are the bytes after the second word of a `text` line (its quoted bytes).
note Omega has one namespace and no qualified names, so a whole-word match is a reference to that name.
note Refusals (exit 1, nothing trusted on stdout): a malformed or oversized MAP or IN, a repeated OLD or NEW,
note a NEW that already occurs as a word of IN (it would merge two names), an OLD that never occurs (a
note stale map). Exit 0 when every OLD was used.

text msg "rename: usage: rename MAP < IN > OUT\nrename: map unreadable, malformed or too large\nrename: input too large\nrename: repeated name in map: \nrename: new name already used in input: \nrename: map name never used: \nrename: output write failed\n"
text kw "note\ntext\n"

global mp uchar 1048576
global mpn ulong 1
global ko ulong 4096
global kl ulong 4096
global vo ulong 4096
global vl ulong 4096
global used uchar 4096
global nk ulong 1
global ht ulong 16384
global hv ulong 16384
global inp uchar 8388608
global inn ulong 1
global out uchar 8388608
global otn ulong 1
global pb uchar 4096
global wpos ulong 2

fn seg id ulong to void
k = ulong 1
s = ulong 0
for i ulong len msg
if eq get msg i 10
if eq k id
put wpos 0 s
put wpos 1 sub i s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
fn say id ulong to void
seg id
r = write 2 msg get wpos 0 get wpos 1
end
fn sayln id ulong to void
say id
put pb 0 10
r = write 2 pb 0 1
end
fn showmp o ulong n ulong to void
r = write 2 mp o n
put pb 0 10
r = write 2 pb 0 1
end

note ---- the map --------------------------------------------------------------------------------------
fn mpblank i ulong to bool
c = get mp i
ret or eq c 32 eq c 9
end
note the word of mp at or after p and before e, as (offset, length) in wpos
fn mword p ulong e ulong to void
i = p
while and lt i e mpblank i bound 1048576
i = add i 1
end
j = i
while and lt j e not mpblank j bound 1048576
j = add j 1
end
put wpos 0 i
put wpos 1 sub j i
end
note 1 + slot of the table entry with key bytes A[o .. o+n) (A: 0 the map, 1 the input), or 0
fn hbytes a ulong o ulong n ulong to ulong
h = ulong 5381
for i ulong n
c = ulong 0
if eq a 0
c = ulong get mp add o i
else
c = ulong get inp add o i
end
h = xor mul h 33 c
end
ret and h 16383
end
fn hsame k ulong o ulong n ulong to bool
if ne get kl k n
ret false
end
ko0 = get ko k
for i ulong n
if ne get mp add ko0 i get inp add o i
ret false
end
end
ret true
end
note the entry whose key is inp[o .. o+n), or nk when none
fn lookup o ulong n ulong to ulong
h = hbytes 1 o n
for t ulong 16384
s = and add h t 16383
if eq get hv s 0
ret get nk 0
end
k = sub get hv s 1
if hsame k o n
ret k
end
end
ret get nk 0
end
fn mpsame a ulong b ulong n ulong to bool
for i ulong n
if ne get mp add a i get mp add b i
ret false
end
end
ret true
end
note insert key k into the hash table; false when its OLD is already there
fn hput k ulong to bool
o = get ko k
n = get kl k
h = hbytes 0 o n
for t ulong 16384
s = and add h t 16383
if eq get hv s 0
put hv s add k 1
ret true
end
j = sub get hv s 1
if eq get kl j n
if mpsame get ko j o n
ret false
end
end
end
ret false
end
fn loadmap to bool
r = argread 1 pb 0 4095
if le r 0
ret false
end
fd = fopen pb 0 ulong r 524288 0
if lt fd 0
ret false
end
n = ulong 0
go = true
while go bound 100000
q = read int fd mp n sub len mp n
if le q 0
go = false
else
n = add n ulong q
if ge n len mp
go = false
end
end
end
q = fclose int fd
if ge n len mp
ret false
end
put mpn 0 n
ret parsemap
end
fn parsemap to bool
n = get mpn 0
p = ulong 0
while lt p n bound 1048576
e = p
while and lt e n ne get mp e 10 bound 1048576
e = add e 1
end
mword p e
o = get wpos 0
l = get wpos 1
if and gt l 0 ne get mp o 35
if not addpair o l e
ret false
end
end
p = add e 1
end
ret true
end
fn addpair o ulong l ulong e ulong to bool
k = get nk 0
if ge k 4096
ret false
end
mword add o l e
vo0 = get wpos 0
vl0 = get wpos 1
if or eq vl0 0 gt vl0 63
ret false
end
mword add vo0 vl0 e
if ne get wpos 1 0
ret false
end
put ko k o
put kl k l
put vo k vo0
put vl k vl0
put used k 0
put nk 0 add k 1
if not hput k
say 4
showmp o l
ret false
end
ret true
end
note a repeated NEW is refused
fn newsuniq to bool
n = get nk 0
for a ulong n
for b ulong a
if eq get vl a get vl b
if mpsame get vo a get vo b get vl a
say 4
showmp get vo a get vl a
ret false
end
end
end
end
ret true
end
note a NEW that is already a word of the input is refused
fn newfree to bool
for k ulong get nk 0
if wordin get vo k get vl k
say 5
showmp get vo k get vl k
ret false
end
end
ret true
end
fn inblank i ulong to bool
c = get inp i
ret or or eq c 32 eq c 9 eq c 10
end
fn wordin o ulong l ulong to bool
n = get inn 0
i = ulong 0
while lt i n bound 8388608
if inblank i
i = add i 1
else
j = i
while and lt j n not inblank j bound 8388608
j = add j 1
end
if eq sub j i l
if inmp i o l
ret true
end
end
i = j
end
end
ret false
end
fn inmp i ulong o ulong l ulong to bool
for x ulong l
if ne get inp add i x get mp add o x
ret false
end
end
ret true
end

note ---- the input and the output ---------------------------------------------------------------------------
fn loadinp to bool
n = ulong 0
go = true
while go bound 100000
q = read 0 inp n sub len inp n
if le q 0
go = false
else
n = add n ulong q
if ge n len inp
go = false
end
end
end
put inn 0 n
ret lt n len inp
end
fn obyte b uchar to void
n = get otn 0
if lt n len out
put out n b
end
put otn 0 add n 1
end
fn ocopy o ulong n ulong to void
for i ulong n
obyte get inp add o i
end
end
fn onew k ulong to void
o = get vo k
for i ulong get vl k
obyte get mp add o i
end
end
note inp[o .. o+n) is fixed word id of kw
fn iskw o ulong n ulong id ulong to bool
k = ulong 1
s = ulong 0
for i ulong len kw
if eq get kw i 10
if eq k id
if ne n sub i s
ret false
end
for j ulong n
if ne get inp add o j get kw add s j
ret false
end
end
ret true
end
k = add k 1
s = add i 1
end
end
ret false
end
note one word inp[i .. j): its NEW when mapped
fn oword i ulong j ulong to void
k = lookup i sub j i
if lt k get nk 0
put used k 1
onew k
else
ocopy i sub j i
end
end
note line inp[p .. e), without its newline
fn oline p ulong e ulong to void
i = p
w = ulong 0
lit = false
while lt i e bound 8388608
c = get inp i
if or eq c 32 eq c 9
obyte c
i = add i 1
else
j = i
while and lt j e not inblank j bound 8388608
j = add j 1
end
if eq w 0
if iskw i sub j i 1
ocopy i sub e i
ret
end
lit = iskw i sub j i 2
end
if and lit ge w 2
ocopy i sub e i
ret
end
oword i j
w = add w 1
i = j
end
end
end
fn rewrite to void
n = get inn 0
p = ulong 0
while lt p n bound 8388608
e = p
while and lt e n ne get inp e 10 bound 8388608
e = add e 1
end
oline p e
if lt e n
obyte 10
end
p = add e 1
end
end
fn allused to bool
ok = true
for k ulong get nk 0
if eq get used k 0
say 6
showmp get ko k get kl k
ok = false
end
end
ret ok
end
fn flush to bool
n = get otn 0
if gt n len out
ret false
end
off = ulong 0
while lt off n bound 100000
r = write 1 out off sub n off
if le r 0
ret false
end
off = add off ulong r
end
ret true
end
fn main to int
if ne argcnt 2
sayln 1
ret 1
end
if not loadmap
sayln 2
ret 1
end
if not newsuniq
ret 1
end
if not loadinp
sayln 3
ret 1
end
if not newfree
ret 1
end
rewrite
if not allused
ret 1
end
if not flush
sayln 7
ret 1
end
ret 0
end

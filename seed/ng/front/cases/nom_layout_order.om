note Layout put: the index and value calls run in omc's order. The trace global records them in decimal
note digits (value 1, index 2). Exit is the trace.
om2
global tr ulong 1
layout lo 8
field a uchar 4 at 0 little
field w ushort at 4 big
field b byte at 6 little
end
fn vf to uchar
put tr 0 add mul get tr 0 10 1
ret 7
end
fn ix to ulong
put tr 0 add mul get tr 0 10 2
ret 3
end
fn setit c edit lo to void
put c a ix vf
end
fn main to int
c = new uchar 8 0
setit c
if ne get c 3 7
ret 1
end
ret int get tr 0
end

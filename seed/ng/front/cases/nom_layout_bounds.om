note Layout boundaries: the last field ends exactly at the layout size, a big-endian field and a little-endian
note field keep their own byte order, the last array element is writable without touching its neighbour, and
note a run-time index one past the array traps 3 (exit 103).
om2
layout lo 12
field lead uchar at 0 little
field w ushort 2 at 1 big
field d uint at 5 little
field last uchar 3 at 9 little
end
fn five to ulong
ret 3
end
fn fill c edit lo to void
put c lead 255
put c w 1 0x0102
put c d 0x0a0b0c0d
put c last 2 0x77
end
fn check c view lo to int
if ne get c lead 255
ret 1
end
if ne get c w 1 0x0102
ret 2
end
if ne get c d 0x0a0b0c0d
ret 3
end
if ne get c last 2 0x77
ret 4
end
if ne get c last 0 0
ret 5
end
if ne get c w 0 0
ret 6
end
ret 0
end
fn over c edit lo to void
put c last five 1
end
fn main to int
c = new uchar 12 0
fill c
r = check c
if ne r 0
ret r
end
if ne get c 3 1
ret 11
end
if ne get c 4 2
ret 12
end
if ne get c 5 0x0d
ret 13
end
if ne get c 8 0x0a
ret 14
end
if ne get c 11 0x77
ret 15
end
if ne get c 9 0
ret 16
end
over c
ret 0
end

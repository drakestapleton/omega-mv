note sh_mix: shl and shr whose value and amount have different integer types. omc admits them (omc.om
note rdval: only a shift may mix its operand types) and checks the amount against the value's width
note (bo_schk, trap 7). The operands are parameters, so nothing folds. Ten results, 8 bytes each,
note little-endian (signed ones bitcast from long); exit 0. Expected bytes: groups4.expect.
global o uchar 80
fn put8 p ulong v ulong to void
for j ulong 8
put o add p j uchar and shr v mul j 8 255
end
end
fn mx1 a ulong s uchar to ulong
ret shl a s
end
fn mx2 a uint s ulong to uint
ret shr a s
end
fn mx3 a byte s long to byte
ret shr a s
end
fn mx4 a short s uchar to short
ret shr a s
end
fn mx5 a long s ushort to long
ret shl a s
end
fn mx6 a uchar s long to uchar
ret shl a s
end
fn mx7 a ushort s int to ushort
ret shr a s
end
fn mx8 a int s ulong to int
ret shl a s
end
fn mx9 a uint s byte to uint
ret shl a s
end
fn mx10 a ulong s uchar to ulong
ret shl a s
end
fn main to int
put8 0 mx1 1 40
put8 8 ulong mx2 4026531840 28
put8 16 bitcast ulong long mx3 -128 7
put8 24 bitcast ulong long mx4 -32768 15
put8 32 bitcast ulong mx5 3 61
put8 40 ulong mx6 1 7
put8 48 ulong mx7 65535 15
put8 56 ulong mx8 1 30
put8 64 ulong mx9 5 3
put8 72 mx10 1 63
w = write 1 o 0 80
ret 0
end

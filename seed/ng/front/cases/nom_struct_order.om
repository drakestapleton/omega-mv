note Struct put: omc evaluates the index call before the value call. The trace global records the order of
note the two calls in decimal digits (value 1, index 2): index first gives 21. Exit is the trace.
global tr ulong 1
struct B pad ulong v uint 4 tail ulong end
fn vf to uint
put tr 0 add mul get tr 0 10 1
ret 7
end
fn ix to ulong
put tr 0 add mul get tr 0 10 2
ret 3
end
fn main to int
b = new B 43690 0 48059
put b v ix vf
if ne get tr 0 21
ret 1
end
if ne get b v 3 7
ret 2
end
if ne get b pad 43690
ret 3
end
if ne get b tail 48059
ret 4
end
ret int get tr 0
end

note Struct field boundaries: the last array element is writable and leaves the neighbouring cells alone,
note every scalar width round-trips its extreme values through an 8-byte cell, and the index is checked
note only against the field's own length (the first element of the next field is not reachable).
struct W a byte s short i int u uchar w ushort ui uint f uchar arr uchar 3 z ulong end
fn main to int
w = new W 0 0 0 0 0 0 0 0 0
put w a -128
put w s -32768
put w i -2147483648
put w u 255
put w w 65535
put w ui 4294967295
put w f 1
put w arr 2 9
put w z 1234605616436508552
if ne get w a -128
ret 1
end
if ne get w s -32768
ret 2
end
if ne get w i -2147483648
ret 3
end
if ne get w u 255
ret 4
end
if ne get w w 65535
ret 5
end
if ne get w ui 4294967295
ret 6
end
if ne get w f 1
ret 7
end
if ne get w arr 2 9
ret 8
end
if ne get w arr 0 0
ret 9
end
if ne get w z 1234605616436508552
ret 10
end
put w a 127
put w arr 0 255
if ne get w s -32768
ret 11
end
if ne get w arr 1 0
ret 12
end
k = ulong 0
for j ulong 3
put w arr j uchar add j 1
k = add k ulong get w arr j
end
if ne k 6
ret 13
end
ret 0
end

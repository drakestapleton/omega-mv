note fmm_mix: fmin and fmax (IR min 24 and max 25; OMEGESE FMINNM/FMAXNM, IR.md s7.3) on f32 and f64:
note ordered values, signed zeros in both orders, a quiet NaN with a number in both orders, a signaling NaN
note with a number in both orders (the result is that NaN quieted), two quiet NaNs (the first). Each result's
note bits are written little-endian (4 bytes per f32, 8 per f64), 168 bytes; expected in cases/groups6.expect.
note NaN bits (decimal, Wolfram FromDigits): f32 quiet 0x7fc00000 2143289344, 0x7fc00001 2143289345,
note signaling 0x7f800001 2139095041; f64 quiet 0x7ff8000000000000 9221120237041090560,
note 0x7ff8000000000001 9221120237041090561, signaling 0x7ff0000000000001 9218868437227405313.
global o uchar 256
global n ulong 1
fn pw v ulong k ulong to void
p = get n 0
for i ulong k
put o add p i uchar and shr v mul i 8 255
end
put n 0 add p k
end
fn p32 x f32 to void
pw ulong bitcast uint x 4
end
fn p64 x f64 to void
pw bitcast ulong x 8
end
note main holds no float: each width's values live in its own function (16 registers per function)
fn t32 to void
a = 1.5f32
b = 2.5f32
z = 0.0f32
nz = neg z
q = bitcast f32 uint 2143289344
q2 = bitcast f32 uint 2143289345
s = bitcast f32 uint 2139095041
p32 fmin a b
p32 fmax a b
p32 fmin nz z
p32 fmin z nz
p32 fmax nz z
p32 fmax z nz
p32 fmin q a
p32 fmin a q
p32 fmax q a
p32 fmin s a
p32 fmin a s
p32 fmax s a
p32 fmin q q2
p32 fmax q2 q
end
fn t64 to void
c = 1.5f64
d = 2.5f64
y = 0.0f64
ny = neg y
r = bitcast f64 ulong 9221120237041090560
r2 = bitcast f64 ulong 9221120237041090561
t = bitcast f64 ulong 9218868437227405313
p64 fmin c d
p64 fmax c d
p64 fmin ny y
p64 fmin y ny
p64 fmax ny y
p64 fmax y ny
p64 fmin r c
p64 fmin c r
p64 fmax r c
p64 fmin t c
p64 fmin c t
p64 fmax t c
p64 fmin r r2
p64 fmax r2 r
end
fn main to int
t32
t64
k = write 1 o 0 get n 0
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note seed/ng/front/prune.om: structural line pruning of an Omega unit (ng-front: the machine-code paths of
note omc.om are removed from the front end with it, DECISIONS D1b/D8 and the queen's front.om scope ruling).
note Handwritten seeded Omega, program mode, Linux AArch64, built by the pinned seed/out/omc.
note   prune SCRIPT < IN.om > OUT.om
note An Omega unit is line structured: a line whose first word is fn, if, while or for opens a block, `else`
note splits an if, `end` closes. SCRIPT lines (# lines and blank lines skipped), applied in order:
note   false COND   every `if COND` line (COND the exact rest of the line): the if, its then-part and its end
note                go; an else-part stays in place (its else line goes). Use for a condition that is false
note                in every unit the output accepts.
note   true COND    every `if COND` line: the if line goes, and the else-part with its else line; then stays.
note   call NAME    every line whose first word is NAME (a call statement) goes.
note   dead ROOT    from function ROOT, every fn and global no kept line of a reachable function names goes,
note                with the note lines right above it.
note Every false, true and call line must match at least once (a stale script is refused). stderr gets one
note line per script line: the command and how many lines it removed. Exit 0, or 1 on any refusal.

text msg "prune: usage: prune SCRIPT < IN > OUT\nprune: script unreadable, malformed or too large\nprune: input too large or too many lines\nprune: unbalanced block at line \nprune: script line matched nothing: \nprune: dead root is not a function\nprune: output write failed\nprune: too many names\n removed \nprune: sink is not a kept name: \nprune: sink read at line \n: \nprune: sink function \n"
text kw "if\nwhile\nfor\nfn\nend\nelse\nnote\nglobal\nfalse\ntrue\ncall\ndead\nput\nexit\nwrite\nread\nsink\npure\nsinkcheck\ntidy\nret\n"

global inp uchar 8388608
global inn ulong 1
global lo ulong 65536
global lend ulong 65536
global kp uchar 65536
global lk uchar 65536
global td uchar 65536
global nl ulong 1
global cm uchar 1048576
global cmn ulong 1
global out uchar 8388608
global otn ulong 1
global pb uchar 4096
global wpos ulong 2
global me ulong 2
global no ulong 8192
global nln ulong 8192
global nk uchar 8192
global nd ulong 8192
global nend ulong 8192
global nlv uchar 8192
global nn ulong 1
global ht ulong 16384
global wk ulong 8192
global nrm ulong 1
global nsk uchar 8192
global npu uchar 8192
global sko ulong 512
global skl ulong 512
global nsl ulong 1
global tno ulong 256
global tnl ulong 256
global ntn ulong 1
global lh ulong 2
global tnot ulong 1

note ---- messages --------------------------------------------------------------------------------------
fn seg id ulong to void
k = ulong 1
s = ulong 0
for i ulong len msg
if eq get msg i 10
if eq k id
put wpos 0 s
put wpos 1 sub i s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
fn say id ulong to void
seg id
r = write 2 msg get wpos 0 get wpos 1
end
fn nl2 to void
put pb 0 10
r = write 2 pb 0 1
end
fn num v ulong to void
x = v
n = ulong 0
while ge x 10 bound 32
put pb n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
put pb n uchar add 48 x
n = add n 1
for i ulong n
r = write 2 pb sub sub n i 1 1
end
end

note ---- words ---------------------------------------------------------------------------------------------
fn blank c uchar to bool
ret or eq c 32 eq c 9
end
note the first word of inp[o .. e) into wpos (length 0 for none)
fn firstw o ulong e ulong to void
i = o
while and lt i e blank get inp i bound 8388608
i = add i 1
end
j = i
while and lt j e not blank get inp j bound 8388608
j = add j 1
end
put wpos 0 i
put wpos 1 sub j i
end
note inp[o .. o+n) is word id of kw
fn iskw o ulong n ulong id ulong to bool
k = ulong 1
s = ulong 0
for i ulong len kw
if eq get kw i 10
if eq k id
if ne n sub i s
ret false
end
for j ulong n
if ne get inp add o j get kw add s j
ret false
end
end
ret true
end
k = add k 1
s = add i 1
end
end
ret false
end
note cm[o .. o+n) is word id of kw
fn cmkw o ulong n ulong id ulong to bool
k = ulong 1
s = ulong 0
for i ulong len kw
if eq get kw i 10
if eq k id
if ne n sub i s
ret false
end
for j ulong n
if ne get cm add o j get kw add s j
ret false
end
end
ret true
end
k = add k 1
s = add i 1
end
end
ret false
end
note the kind of line i: 1 opens a block, 2 else, 3 end, 0 other
fn lkind i ulong to ulong
firstw get lo i get lend i
o = get wpos 0
n = get wpos 1
if or iskw o n 1 or iskw o n 2 or iskw o n 3 iskw o n 4
ret 1
end
if iskw o n 6
ret 2
end
if iskw o n 5
ret 3
end
ret 0
end

note ---- input and lines ----------------------------------------------------------------------------------
fn loadinp to bool
n = ulong 0
go = true
while go bound 100000
q = read 0 inp n sub len inp n
if le q 0
go = false
else
n = add n ulong q
if ge n len inp
go = false
end
end
end
put inn 0 n
if ge n len inp
ret false
end
k = ulong 0
s = ulong 0
for i ulong n bound 8388608
if eq get inp i 10
if ge k len lo
ret false
end
put lo k s
put lend k i
k = add k 1
s = add i 1
end
end
if lt s n
if ge k len lo
ret false
end
put lo k s
put lend k n
k = add k 1
end
put nl 0 k
for i ulong k bound 65536
put kp i 1
put lk i uchar lkind i
end
ret true
end
note the else line (or nl) and the end line of the block opened at line i, into me
fn matchend i ulong to bool
d = ulong 0
put me 0 get nl 0
for j ulong sub get nl 0 add i 1 bound 65536
x = add add i 1 j
k = get lk x
if eq k 1
d = add d 1
end
if eq k 2
if eq d 0
put me 0 x
end
end
if eq k 3
if eq d 0
put me 1 x
ret true
end
d = sub d 1
end
end
ret false
end

note ---- the script ----------------------------------------------------------------------------------------
fn loadcm to bool
r = argread 1 pb 0 4095
if le r 0
ret false
end
fd = fopen pb 0 ulong r 524288 0
if lt fd 0
ret false
end
n = ulong 0
go = true
while go bound 100000
q = read int fd cm n sub len cm n
if le q 0
go = false
else
n = add n ulong q
if ge n len cm
go = false
end
end
end
q = fclose int fd
put cmn 0 n
ret lt n len cm
end
note line i is `while ` followed by exactly cm[o .. o+n) (false removes such a loop whole)
fn whis i ulong o ulong n ulong to bool
s = get lo i
if ne sub get lend i s add n 6
ret false
end
firstw s get lend i
if not iskw get wpos 0 get wpos 1 2
ret false
end
for j ulong n
if ne get inp add add s 6 j get cm add o j
ret false
end
end
ret true
end
note line i is `if ` followed by exactly cm[o .. o+n)
fn ifis i ulong o ulong n ulong to bool
s = get lo i
if ne sub get lend i s add n 3
ret false
end
if ne get inp s 105
ret false
end
if or ne get inp add s 1 102 ne get inp add s 2 32
ret false
end
for j ulong n
if ne get inp add add s 3 j get cm add o j
ret false
end
end
ret true
end
fn drop i ulong to void
if ne get kp i 0
put kp i 0
put nrm 0 add get nrm 0 1
end
end
fn dropr a ulong b ulong to void
for j ulong add sub b a 1 bound 65536
drop add a j
end
end
note false (t = false) or true (t = true) for condition cm[o .. o+n); lines matched
fn branch o ulong n ulong t bool to ulong
c = ulong 0
for i ulong get nl 0 bound 65536
if eq get lk i 1
if or ifis i o n whis i o n
if not matchend i
say 4
num add i 1
nl2
exit 1
end
c = add c 1
branch1 i t
end
end
end
ret c
end
fn branch1 i ulong t bool to void
el = get me 0
en = get me 1
if t
drop i
if lt el get nl 0
dropr el en
else
drop en
end
else
if lt el get nl 0
dropr i el
drop en
else
dropr i en
end
end
end
fn calls o ulong n ulong to ulong
c = ulong 0
for i ulong get nl 0 bound 65536
if eq get kp i 1
firstw get lo i get lend i
if eq get wpos 1 n
if cmsame get wpos 0 o n
drop i
c = add c 1
end
end
end
end
ret c
end
fn cmsame a ulong o ulong n ulong to bool
for j ulong n
if ne get inp add a j get cm add o j
ret false
end
end
ret true
end

note ---- names and reachability ------------------------------------------------------------------------------
fn hb o ulong n ulong to ulong
h = ulong 5381
for i ulong n
h = xor mul h 33 ulong get inp add o i
end
ret and h 16383
end
fn nsame k ulong o ulong n ulong to bool
if ne get nln k n
ret false
end
a = get no k
for j ulong n
if ne get inp add a j get inp add o j
ret false
end
end
ret true
end
note 1 + the name entry spelled inp[o .. o+n), or 0
fn nfind o ulong n ulong to ulong
h = hb o n
for t ulong 16384
s = and add h t 16383
v = get ht s
if eq v 0
ret 0
end
if nsame sub v 1 o n
ret v
end
end
ret 0
end
fn nadd o ulong n ulong kind ulong d ulong to bool
k = get nn 0
if ge k len no
ret false
end
put no k o
put nln k n
put nk k uchar kind
put nd k d
put nend k d
put nlv k 0
put nsk k 0
put npu k 0
h = hb o n
for t ulong 16384
s = and add h t 16383
if eq get ht s 0
put ht s add k 1
put nn 0 add k 1
ret true
end
end
ret false
end
note the name declared by kept line i (fn or global, at top level), as a table entry
fn declname i ulong to bool
firstw get lo i get lend i
o = get wpos 0
n = get wpos 1
kind = ulong 0
if iskw o n 4
kind = ulong 1
end
if iskw o n 8
kind = ulong 2
end
if eq kind 0
ret true
end
firstw add o n get lend i
if not nadd get wpos 0 get wpos 1 kind i
ret false
end
if eq kind 1
if not matchend i
say 4
num add i 1
nl2
exit 1
end
put nend sub get nn 0 1 get me 1
end
ret true
end
note mark name k live and queue it
fn live k ulong qn ulong to ulong
if ne get nlv k 0
ret qn
end
put nlv k 1
put wk qn k
ret add qn 1
end
note every word of kept line i that names an entry is marked live
fn scanline i ulong qn ulong to ulong
q = qn
e = get lend i
p = get lo i
firstw p e
if iskw get wpos 0 get wpos 1 7
ret q
end
while lt p e bound 65536
firstw p e
if eq get wpos 1 0
ret q
end
v = nfind get wpos 0 get wpos 1
if ne v 0
q = live sub v 1 q
end
p = add get wpos 0 get wpos 1
end
ret q
end
note 1 + the fn entry named cm[o .. o+n), or 0
fn findroot o ulong n ulong to ulong
for k ulong get nn 0
if and eq get nk k 1 eq get nln k n
if rootis k o n
ret add k 1
end
end
end
ret 0
end
note the name table of the kept lines; sink globals are marked from the sink list
fn buildnames to void
put nn 0 0
for i ulong len ht
put ht i 0
end
for i ulong get nl 0 bound 65536
if eq get kp i 1
if not declname i
say 8
nl2
exit 1
end
end
end
for s ulong get nsl 0
v = nfindcm get sko s get skl s
if ne v 0
put nsk sub v 1 1
end
end
end
note 1 + the name entry spelled cm[o .. o+n), or 0
fn nfindcm o ulong n ulong to ulong
for k ulong get nn 0
if eq get nln k n
if rootis k o n
ret add k 1
end
end
end
ret 0
end
note remember sink global cm[o .. o+n)
fn sinkadd o ulong n ulong to ulong
k = get nsl 0
if ge k len sko
say 8
nl2
exit 1
end
put sko k o
put skl k n
put nsl 0 add k 1
ret 1
end
note the word after inp[o .. o+n) on line i, as 1 + its name entry (0 when it names nothing)
fn nextname o ulong n ulong i ulong to ulong
firstw add o n get lend i
if eq get wpos 1 0
ret 0
end
ret nfind get wpos 0 get wpos 1
end
note line i stores to a sink global: `put G ...` with G a sink
fn sinkput i ulong to bool
firstw get lo i get lend i
o = get wpos 0
n = get wpos 1
if not iskw o n 13
ret false
end
v = nextname o n i
if eq v 0
ret false
end
ret ne get nsk sub v 1 0
end
note line i may have an effect beyond the dropped sinks: a store to a global that is not a sink, a host word,
note exit, or a call of a function not (yet) known pure
fn lineeff i ulong to bool
e = get lend i
firstw get lo i e
o = get wpos 0
n = get wpos 1
if iskw o n 7
ret false
end
if iskw o n 13
v = nextname o n i
if ne v 0
if and eq get nk sub v 1 2 eq get nsk sub v 1 0
ret true
end
end
end
ret toksff get lo i e
end
note name entry v (1-based, 0 none) is a function not known pure
fn impure v ulong to bool
if eq v 0
ret false
end
k = sub v 1
ret and eq get nk k 1 eq get npu k 0
end
note some word of inp[p .. e) is exit, write or read, or names a function that is not pure
fn toksff p ulong e ulong to bool
q = p
while lt q e bound 65536
firstw q e
o = get wpos 0
n = get wpos 1
if eq n 0
ret false
end
if or iskw o n 14 or iskw o n 15 iskw o n 16
ret true
end
if impure nfind o n
ret true
end
q = add o n
end
ret false
end
fn fneff k ulong to bool
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if eq get kp a 1
if lineeff a
ret true
end
end
a = add a 1
end
ret false
end
note drop the stores to sinks, find the pure functions, drop every call statement of one; lines removed
fn pure to ulong
buildnames
before = get nrm 0
for i ulong get nl 0 bound 65536
if eq get kp i 1
if sinkput i
drop i
end
end
end
purity
for i ulong get nl 0 bound 65536
if eq get kp i 1
purecall i
end
end
sinkfns
for k ulong get nn 0
if eq get nk k 1
taintdrop k
end
end
ret add sub get nrm 0 before 1
end
note npu: 1 for every function with no effect (to a fixpoint over the calls)
fn purity to void
for k ulong get nn 0
put npu k 0
if eq get nk k 1
put npu k 1
end
end
go = true
while go bound 100000
go = false
for k ulong get nn 0
if ne get npu k 0
if fneff k
put npu k 0
go = true
end
end
end
end
end
note tidy: drop if/while/for blocks left with nothing kept inside, and assignments to locals that no kept
note line reads, when they call nothing impure; to a fixpoint; lines removed
fn tidy to ulong
buildnames
purity
before = get nrm 0
go = true
while go bound 1000
go = false
for k ulong get nn 0
if eq get nk k 1
if tidyfn k
go = true
end
end
end
end
ret add sub get nrm 0 before 1
end
fn tidyfn k ulong to bool
ch = false
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if eq get kp a 1
if tidy1 a k
ch = true
end
end
a = add a 1
end
ret ch
end
fn tidy1 a ulong k ulong to bool
if eq get lk a 1
ret emptyblk a
end
r = asgrhs a
if eq r 0
ret false
end
if toksff r get lend a
ret false
end
if readin get lh 0 get lh 1 k
ret false
end
drop a
ret true
end
note the if/while/for block opened at kept line a has no kept line inside but else and notes, and its
note condition calls nothing impure: drop it whole
fn emptyblk a ulong to bool
firstw get lo a get lend a
o = get wpos 0
n = get wpos 1
if not or iskw o n 1 or iskw o n 2 iskw o n 3
ret false
end
if toksff add o n get lend a
ret false
end
if not matchend a
ret false
end
en = get me 1
x = add a 1
while lt x en bound 65536
if eq get kp x 1
if ne get lk x 2
if not notel x
ret false
end
end
end
x = add x 1
end
dropr a en
ret true
end
fn notel x ulong to bool
firstw get lo x get lend x
ret iskw get wpos 0 get wpos 1 7
end
note some kept line of function k reads the local inp[o .. o+n): a word of it past the target of an
note assignment
fn readin o ulong n ulong k ulong to bool
x = get nd k
e = get nend k
while le x e bound 65536
if eq get kp x 1
if rdname x o n
ret true
end
end
x = add x 1
end
ret false
end
fn rdname x ulong o ulong n ulong to bool
q = asgrhs x
if eq q 0
q = get lo x
end
e = get lend x
while lt q e bound 65536
firstw q e
p = get wpos 0
m = get wpos 1
if eq m 0
ret false
end
if eq m n
if inpsame p o n
ret true
end
end
q = add p m
end
ret false
end
note mark every function that returns a value read from a sink as a sink itself, to a fixpoint
fn sinkfns to void
go = true
while go bound 64
go = false
for k ulong get nn 0
if sinknew k
put nsk k 1
go = true
end
end
end
end
fn sinknew k ulong to bool
if or ne get nk k 1 ne get nsk k 0
ret false
end
taintfn k
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if retsink a
ret true
end
a = add a 1
end
ret false
end
note kept line a is `ret EXPR` with EXPR reading a sink
fn retsink a ulong to bool
if eq get kp a 0
ret false
end
firstw get lo a get lend a
if not iskw get wpos 0 get wpos 1 21
ret false
end
ret rdsink add get wpos 0 3 get lend a
end
fn purecall i ulong to void
firstw get lo i get lend i
v = nfind get wpos 0 get wpos 1
if ne v 0
if and eq get nk sub v 1 1 ne get npu sub v 1 0
drop i
end
end
end
note every kept line of a function that reads a sink global or a local assigned from one goes to stderr;
note their count (the script refuses when not 0)
fn sinkchk to ulong
buildnames
sinkfns
c = ulong 0
for k ulong get nn 0
if eq get nk k 1
if ne get nsk k 0
say 13
r = write 2 inp get no k get nln k
nl2
end
c = add c sinkfn k
end
end
ret c
end
fn sinkfn k ulong to ulong
taintfn k
c = ulong 0
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if eq get kp a 1
if sinkread a
c = add c 1
say 11
num add a 1
say 12
showline a
nl2
end
end
a = add a 1
end
ret c
end
fn showline i ulong to void
s = get lo i
r = write 2 inp s sub get lend i s
end
fn sinkread i ulong to bool
e = get lend i
firstw get lo i e
if iskw get wpos 0 get wpos 1 7
ret false
end
ret rdsink get lo i e
end
fn inpsame a ulong o ulong n ulong to bool
for j ulong n
if ne get inp add a j get inp add o j
ret false
end
end
ret true
end
note inp[o .. o+n) is a tainted local of the current function
fn tainted o ulong n ulong to bool
for t ulong get ntn 0
if eq get tnl t n
if inpsame get tno t o n
ret true
end
end
end
ret false
end
fn issink v ulong to bool
if eq v 0
ret false
end
ret ne get nsk sub v 1 0
end
note inp[p .. e) has a word that is a sink global or function, or (unless tnot) a tainted local
fn rdsink p ulong e ulong to bool
q = p
while lt q e bound 65536
firstw q e
o = get wpos 0
n = get wpos 1
if eq n 0
ret false
end
if issink nfind o n
ret true
end
if eq get tnot 0 0
if tainted o n
ret true
end
end
q = add o n
end
ret false
end
note line i is `NAME = ...` or `put NAME ...` with NAME not a fn or global: NAME into lh and the offset of
note the rest of the line, or 0
fn asgrhs i ulong to ulong
e = get lend i
firstw get lo i e
o = get wpos 0
n = get wpos 1
if eq n 0
ret 0
end
isput = iskw o n 13
firstw add o n e
p = get wpos 0
m = get wpos 1
if isput
if or eq m 0 ne nfind p m 0
ret 0
end
put lh 0 p
put lh 1 m
ret add p m
end
if or ne m 1 ne get inp p 61
ret 0
end
put lh 0 o
put lh 1 n
ret add p 1
end
note taint the locals of function k assigned from a sink or a tainted local (to a fixpoint)
fn taintfn k ulong to void
put ntn 0 0
go = true
while go bound 64
go = false
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if taint1 a
go = true
end
a = add a 1
end
end
end
fn taint1 a ulong to bool
if and eq get kp a 0 eq get td a 0
ret false
end
r = asgrhs a
if eq r 0
ret false
end
o = get lh 0
n = get lh 1
if tainted o n
ret false
end
if not rdsink r get lend a
ret false
end
t = get ntn 0
if ge t len tno
ret false
end
put tno t o
put tnl t n
put ntn 0 add t 1
ret true
end
note drop the assignments to tainted locals of function k whose right-hand side reads a sink global or
note function directly and calls nothing impure (a use of the dropped local then fails to compile: by hand)
fn taintdrop k ulong to void
taintfn k
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if eq get kp a 1
tdrop1 a
end
a = add a 1
end
end
fn tdrop1 a ulong to void
r = asgrhs a
if eq r 0
ret
end
put tnot 0 1
s = rdsink r get lend a
put tnot 0 0
if not s
ret
end
if not toksff r get lend a
drop a
put td a 1
end
end
fn dead o ulong n ulong to ulong
buildnames
root = findroot o n
if eq root 0
say 6
nl2
exit 1
end
q = live sub root 1 0
h = ulong 0
while lt h q bound 8192
k = get wk h
if eq get nk k 1
q = scanfn k q
end
h = add h 1
end
before = get nrm 0
for k ulong get nn 0
if eq get nlv k 0
dropname k
end
end
ret sub get nrm 0 before
end
fn rootis k ulong o ulong n ulong to bool
a = get no k
for j ulong n
if ne get inp add a j get cm add o j
ret false
end
end
ret true
end
fn scanfn k ulong qn ulong to ulong
q = qn
a = add get nd k 1
b = get nend k
while lt a b bound 65536
if eq get kp a 1
q = scanline a q
end
a = add a 1
end
ret q
end
note drop entry k's declaration (a fn through its end) and the note lines right above it
fn dropname k ulong to void
a = get nd k
dropr a get nend k
go = true
while and go gt a 0 bound 65536
a = sub a 1
firstw get lo a get lend a
if and eq get kp a 1 iskw get wpos 0 get wpos 1 7
drop a
else
go = false
end
end
end

note ---- running the script and the output -------------------------------------------------------------------
fn cmblank i ulong to bool
c = get cm i
ret or eq c 32 eq c 9
end
fn runcm to bool
n = get cmn 0
p = ulong 0
while lt p n bound 1048576
e = p
while and lt e n ne get cm e 10 bound 1048576
e = add e 1
end
if and lt p e ne get cm p 35
if not cmline p e
ret false
end
end
p = add e 1
end
ret true
end
fn cmline p ulong e ulong to bool
j = p
while and lt j e not cmblank j bound 4096
j = add j 1
end
a = e
if lt j e
a = add j 1
end
n = sub e a
put nrm 0 0
c = ulong 0
if cmkw p sub j p 9
c = branch a n false
end
if cmkw p sub j p 10
c = branch a n true
end
if cmkw p sub j p 11
c = calls a n
end
if cmkw p sub j p 12
c = add dead a n 1
end
if cmkw p sub j p 17
c = sinkadd a n
end
if cmkw p sub j p 18
c = pure
end
if cmkw p sub j p 20
c = tidy
end
if cmkw p sub j p 19
if ne sinkchk 0
ret false
end
c = ulong 1
end
r = write 2 cm p sub e p
say 9
num get nrm 0
nl2
if eq c 0
say 5
r = write 2 cm p sub e p
nl2
ret false
end
ret true
end
fn obyte b uchar to void
n = get otn 0
if lt n len out
put out n b
end
put otn 0 add n 1
end
fn emitout to bool
for i ulong get nl 0 bound 65536
if eq get kp i 1
s = get lo i
for j ulong sub get lend i s bound 65536
obyte get inp add s j
end
obyte 10
end
end
n = get otn 0
if gt n len out
ret false
end
off = ulong 0
while lt off n bound 100000
r = write 1 out off sub n off
if le r 0
ret false
end
off = add off ulong r
end
ret true
end
fn main to int
if ne argcnt 2
say 1
nl2
ret 1
end
if not loadcm
say 2
nl2
ret 1
end
if not loadinp
say 3
nl2
ret 1
end
if not runcm
ret 1
end
if not emitout
say 7
nl2
ret 1
end
ret 0
end

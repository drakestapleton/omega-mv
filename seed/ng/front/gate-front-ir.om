note SPDX-License-Identifier: Apache-2.0
note seed/ng/front/gate-front-ir.om: the ΩIR emission gate of ng-front (Hive NG M1). Owner: ng-front lane.
note Handwritten seeded Omega, program mode, Linux AArch64. The child and file helpers follow
note seed/ng/gate-ir.om; seed/ng/sha256.om supplies sh_dat, sh_all and sh_dig.
note Build: cat seed/ng/sha256.om seed/ng/front/gate-front-ir.om | seed/out/omc > gate-front-ir
note Run from the repository root: gate-front-ir OMC OMC_SHA256 SCRATCH CASES
note OMC        the oracle compiler; its sha256 must be OMC_SHA256 (64 lowercase hex) or nothing runs (INVALID)
note SCRATCH    a new directory (created 0700; an existing one is INVALID)
note CASES      lines `run NAME SRC` or `refuse NAME SRC` (SRC a path from the repository root); lines starting
note            with # and blank lines are skipped
note 1. OMC builds ng (the units of seed/ng/ng.units concatenated in order, so a stage unit such as src/a64.om
note    comes with the list), ngcheck (seed/ng/sha256.om, seed/ng/ngcheck.om) and ngrun (seed/ng/src/ir.om,
note    seed/ng/ngrun.om); a failed build is exit 3. The mutants must occur exactly once in all the units.
note 2. run: OMC compiles SRC and the binary runs (empty stdin). ng reads `@ng front-ir` then SRC and must exit
note    0; ngcheck must exit 0 on its stdout with a line starting "ACCEPT "; ngrun runs that ΩIR. The exit
note    status and the stdout of ngrun must equal the OMC binary's (stderr is not compared: the bench kernels
note    write their timing there; a trap is exit 100 + code on both sides).
note    refuse: OMC refuses SRC (exit not 0); ng in front-ir mode exits with the same code and the same stderr
note    bytes and writes no stdout (fe_check is the refusal path of front-ir).
note 3. negative controls, each must fail a case: two lowering mutants of seed/ng/src/front.om (the for latch
note    adds 2; and, or, xor shifted to the next op) over the run cases; the first run case through ng in
note    `@ng front-check` mode (no ΩIR); the first refuse case through ng in `@ng ir-copy` mode.
note Output: a line per case (ok / FAIL), a line per control, then
note   FRONTIRGATE PASS|FAIL cases=N run=R refuse=F fail=K mutants=M killed=X controls=C tripped=T
note Exit 0 PASS, 1 FAIL, 2 INVALID (usage, oracle, scratch, case list), 3 a tool did not build.
note Globals g_*, functions gi_*.
text g_w "seed/ng/ src/ir.om src/front.om src/main.om sha256.om ngcheck.om ngrun.om ng ngcheck ngrun src.om bin in ir o1 o2 e1 e2 ck err nul ngm run refuse ng.units "
text g_m "FAIL |ok |: omc exit |: ng exit |: ngcheck exit |: ngcheck did not accept|: exit omc=| ngrun=|: stdout differs|: omc accepted a refuse case|: ng stderr differs|: ng wrote stdout| exit=|FRONTIRGATE PASS|FRONTIRGATE FAIL|FRONTIRGATE INVALID: | cases=| run=| refuse=| fail=| mutants=| killed=| controls=| tripped=|usage: gate-front-ir OMC OMC_SHA256 SCRATCH CASES|oracle sha256 differs from OMC_SHA256|scratch exists or cannot be made|case list unreadable|build failed: |malformed case line|mutant |: survived every run case|: killed by |control front-check mode|control ir-copy mode|: not tripped|: tripped by |mutant pattern not present exactly once: |: source unreadable|"
text g_pfr "@ng front-ir\n"
text g_acc "ACCEPT "
text g_pfc "@ng front-check\n"
text g_pic "@ng ir-copy\n"
note the lowering mutants (pattern, replacement of the same length; each pattern occurs once in front.om)
text g_mu0 "\nput f_lnv n0 fe_lp2 10 t iv fe_lcst t 1\n"
text g_mu1 "\nput f_lnv n0 fe_lp2 10 t iv fe_lcst t 2\n"
text g_mu2 "\nfe_lval fe_lp2 uint add sub c 38 16 t a b t\n"
text g_mu3 "\nfe_lval fe_lp2 uint add sub c 38 17 t a b t\n"
global g_wo uint 64
global g_wl uint 64
global g_mo uint 64
global g_ml uint 64
global g_omc uchar 4096
global g_scr uchar 4096
global g_pa uchar 8192
global g_av uchar 16384
global g_b1 uchar 16777216
global g_b2 uchar 16777216
global g_cs uchar 1048576
global g_o uchar 4096
global g_stb uchar 4
global g_hx uchar 128
global g_ma uchar 64
global g_mb uchar 64
global g_n ulong 32
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 b1 length,
note 6 b2 length, 7 cases length, 8 cases cursor, 9 out length, 10 cases, 11 run cases, 12 refuse cases,
note 13 failed cases, 14 quiet (controls and mutants), 15 current case failed, 16 name start, 17 name end,
note 18 source start, 19 source end, 20 mutants, 21 killed, 22 controls, 23 tripped, 24 ng mode (0 front-ir,
note 1 front-check, 2 ir-copy), 25 ng binary word, 26 line start, 27 mutant pattern length

note ---- words and output ------------------------------------------------------------------------
fn gi_init to void
w = ulong 0
s = ulong 0
for i ulong len g_w
if eq get g_w i 32
put g_wo w uint s
put g_wl w uint sub i s
w = add w 1
s = add i 1
end
end
w = 0
s = 0
for i ulong len g_m
if eq get g_m i 124
put g_mo w uint s
put g_ml w uint sub i s
w = add w 1
s = add i 1
end
end
put g_n 25 7
end
fn gi_c b ulong to void
n = get g_n 9
if lt n len g_o
put g_o n uchar b
put g_n 9 add n 1
end
end
fn gi_nl to void
gi_c 10
r = write 1 g_o 0 get g_n 9
put g_n 9 0
end
fn gi_say i ulong to void
s = ulong get g_mo i
for j ulong ulong get g_ml i bound 128
gi_c ulong get g_m add s j
end
end
fn gi_num v ulong to void
if ge v 10
gi_num div v 10
end
gi_c add 48 rem v 10
end
note the name of the current case
fn gi_name to void
for p ulong sub get g_n 17 get g_n 16 bound 4096
gi_c ulong get g_cs add get g_n 16 p
end
end
note a failure of the current case: FAIL NAME<message i>, unless quiet
fn gi_fail i ulong to void
put g_n 15 1
if ne get g_n 14 0
ret
end
gi_say 0
gi_name
gi_say i
end
fn gi_fail0 i ulong to void
gi_fail i
if eq get g_n 14 0
gi_nl
end
end
fn gi_failv i ulong v ulong to void
gi_fail i
if eq get g_n 14 0
gi_num v
gi_nl
end
end

note ---- paths --------------------------------------------------------------------------------------
fn gi_pclr to void
put g_n 0 0
end
fn gi_pc c ulong to void
n = get g_n 0
if lt n len g_pa
put g_pa n uchar c
put g_n 0 add n 1
end
end
fn gi_pw i ulong to void
s = ulong get g_wo i
for j ulong ulong get g_wl i bound 64
gi_pc ulong get g_w add s j
end
end
note scratch file word i
fn gi_ps i ulong to void
gi_pclr
for j ulong get g_n 2 bound 4096
gi_pc ulong get g_scr j
end
gi_pw i
end
note repository file seed/ng/ + word i
fn gi_pr i ulong to void
gi_pclr
gi_pw 0
gi_pw i
end
note the source path of the current case
fn gi_psrc to void
gi_pclr
for p ulong sub get g_n 19 get g_n 18 bound 4096
gi_pc ulong get g_cs add get g_n 18 p
end
end
fn gi_open fl ulong to int
r = fopen g_pa 0 get g_n 0 int fl 420
if lt r 0
ret -1
end
ret int r
end
fn gi_rdonly to int
ret gi_open 524288
end
fn gi_wronly to int
ret gi_open 524865
end
note open scratch g_pa for writing with mode 0755 (created fresh: unlink first)
fn gi_exe to int
r = unlink g_pa 0 get g_n 0
x = fopen g_pa 0 get g_n 0 524865 493
if lt x 0
ret -1
end
ret int x
end
fn gi_fclo fd int to void
if ge fd 0
r = fclose fd
end
end

note ---- whole files ----------------------------------------------------------------------------------
note read the file at g_pa into b1 (k 1) or b2 (k 2) at offset o; its length, or 2^63 when unreadable or too big
fn gi_slurp k ulong o ulong to ulong
fd = gi_rdonly
if lt fd 0
ret shl ulong 1 63
end
n = o
ok = true
while true bound 16777218
x = long 0
if eq k 1
x = read fd g_b1 n sub len g_b1 n
else
x = read fd g_b2 n sub len g_b2 n
end
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_b1
ok = false
break
end
end
gi_fclo fd
if not ok
ret shl ulong 1 63
end
ret sub n o
end
note write b1[0, n) to the file at g_pa (fd from gi_wronly or gi_exe when ex)
fn gi_spill n ulong ex bool to bool
fd = int -1
if ex
fd = gi_exe
else
fd = gi_wronly
end
if lt fd 0
ret false
end
o = ulong 0
while lt o n bound 16777217
x = write fd g_b1 o sub n o
if le x 0
gi_fclo fd
ret false
end
o = add o ulong x
end
gi_fclo fd
ret true
end
note read up to m bytes of fd into b1 (k 1) or b2 (k 2); the count (0 at the end)
fn gi_rdn fd int k ulong m ulong to ulong
n = ulong 0
while lt n m bound 1048577
x = long 0
if eq k 1
x = read fd g_b1 n sub m n
else
x = read fd g_b2 n sub m n
end
if le x 0
ret n
end
n = add n ulong x
end
ret n
end
fn gi_eqn n ulong to bool
for j ulong n bound 1048576
if ne get g_b1 j get g_b2 j
ret false
end
end
ret true
end
note the scratch files w1 and w2 have the same bytes
fn gi_fcmp w1 ulong w2 ulong to bool
gi_ps w1
f1 = gi_rdonly
gi_ps w2
f2 = gi_rdonly
ok = and ge f1 0 ge f2 0
dn = false
while and ok not dn bound 4096
a = gi_rdn f1 1 1048576
b = gi_rdn f2 2 1048576
if ne a b
ok = false
else
if eq a 0
dn = true
end
ok = gi_eqn a
end
end
gi_fclo f1
gi_fclo f2
ret ok
end
note bytes in scratch file w (2^63 when it cannot be opened)
fn gi_size w ulong to ulong
gi_ps w
fd = gi_rdonly
if lt fd 0
ret shl ulong 1 63
end
r = fseek fd 0 2
gi_fclo fd
if lt r 0
ret shl ulong 1 63
end
ret ulong r
end

note ---- children ------------------------------------------------------------------------------------
fn gi_aclr to void
put g_n 3 2
put g_n 4 0
end
note append g_pa as the next argument
fn gi_apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 8192
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn gi_redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here); the exit code, 256 + the signal
fn gi_spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
gi_fclo fi
gi_fclo fo
gi_fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
gi_redir fi 0
gi_redir fo 1
gi_redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
gi_fclo fi
gi_fclo fo
gi_fclo fe
r = waitpid int pid g_stb 0 len g_stb 0
if ne r pid
exit 2
end
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
note run program word p (a scratch file) with optional argument scratch word a (0 none); stdin scratch word
note i, stdout scratch word o (an executable when ex), stderr scratch word e
fn gi_run p ulong a ulong i ulong o ulong e ulong to ulong
gi_ps i
fi = gi_rdonly
gi_aclr
gi_ps p
gi_apa
if ne a 0
gi_ps a
gi_apa
end
gi_ps o
fo = gi_wronly
gi_ps e
fe = gi_wronly
ret gi_spawn fi fo fe
end
note OMC with stdin at g_pa (already set), stdout scratch word o (an executable), stderr scratch word e
fn gi_omc o ulong e ulong to ulong
fi = gi_rdonly
gi_aclr
gi_pclr
for j ulong get g_n 1 bound 4096
gi_pc ulong get g_omc j
end
gi_apa
gi_ps o
fo = gi_exe
gi_ps e
fe = gi_wronly
ret gi_spawn fi fo fe
end

note ---- building -------------------------------------------------------------------------------------
note append seed/ng/ + word i to b1 at its length (g_n 5); false when unreadable
fn gi_cat i ulong to bool
gi_pr i
n = gi_slurp 1 get g_n 5
if ge n shl ulong 1 63
ret false
end
put g_n 5 add get g_n 5 n
ret true
end
note compile b1[0, g_n 5) with OMC to scratch word o
fn gi_bld o ulong to bool
gi_ps 10
if not gi_spill get g_n 5 false
ret false
end
ret eq gi_omc o 19 0
end
note the units of seed/ng/ng.units (lines `SHA256 PATH`, in order) appended to b1: ng's source, whatever
note stage units the list holds (the pins are ngbuild's to check, gate-ir's ngbuild phase); false when the
note list or a unit cannot be read
fn gi_units to bool
gi_pr 24
k = gi_slurp 2 0
if ge k shl ulong 1 63
ret false
end
s = ulong 0
for i ulong k bound 65536
if eq get g_b2 i 10
if not gi_unit s i
ret false
end
s = add i 1
end
end
ret gi_unit s k
end
note the unit on the units-list line b2[s, e) (64 hex digits, a space, the path) appended to b1; an empty
note line adds nothing
fn gi_unit s ulong e ulong to bool
if eq s e
ret true
end
if le e add s 65
ret false
end
gi_pclr
for i ulong sub e add s 65 bound 4096
gi_pc ulong get g_b2 add add s 65 i
end
n = gi_slurp 1 get g_n 5
if ge n shl ulong 1 63
ret false
end
put g_n 5 add get g_n 5 n
ret true
end
fn gi_tools to bool
put g_n 5 0
if not gi_units
ret false
end
if not gi_bld 7
ret false
end
put g_n 5 0
if or not gi_cat 4 not gi_cat 5
ret false
end
if not gi_bld 8
ret false
end
put g_n 5 0
if or not gi_cat 1 not gi_cat 6
ret false
end
ret gi_bld 9
end
note ng with mutant m (1 or 2) of front.om, built to scratch ngm; false unless its pattern occurs exactly once
note in the units
fn gi_mbld m ulong to bool
gi_msel m
put g_n 5 0
if not gi_units
ret false
end
if ne gi_msub 0 get g_n 5 1
ret false
end
ret gi_bld 21
end
fn gi_msel m ulong to void
if eq m 1
put g_n 27 len g_mu0
for j ulong len g_mu0 bound 64
put g_ma j get g_mu0 j
put g_mb j get g_mu1 j
end
else
put g_n 27 len g_mu2
for j ulong len g_mu2 bound 64
put g_ma j get g_mu2 j
put g_mb j get g_mu3 j
end
end
end
note the places of the pattern in b1[s, e), counted; when there is exactly one it is replaced
fn gi_msub s ulong e ulong to ulong
k = get g_n 27
c = ulong 0
if lt e k
ret 0
end
p = s
while le add p k e bound 16777216
if gi_mat p k
c = add c 1
end
p = add p 1
end
if ne c 1
ret c
end
p = s
while le add p k e bound 16777216
if gi_mat p k
for j ulong k bound 64
put g_b1 add p j get g_mb j
end
ret 1
end
p = add p 1
end
ret 0
end
fn gi_mat p ulong k ulong to bool
for j ulong k bound 64
if ne get g_b1 add p j get g_ma j
ret false
end
end
ret true
end

note ---- one case --------------------------------------------------------------------------------------
note scratch in = the mode line of g_n 24, then the source; false when the source cannot be read
fn gi_mkin to bool
md = get g_n 24
n = ulong 0
if eq md 0
n = len g_pfr
for j ulong n bound 64
put g_b1 j get g_pfr j
end
end
if eq md 1
n = len g_pfc
for j ulong n bound 64
put g_b1 j get g_pfc j
end
end
if eq md 2
n = len g_pic
for j ulong n bound 64
put g_b1 j get g_pic j
end
end
gi_psrc
m = gi_slurp 1 n
if ge m shl ulong 1 63
ret false
end
gi_ps 12
ret gi_spill add n m false
end
note run NAME SRC
fn gi_rcase to void
if not gi_mkin
gi_fail0 38
ret
end
gi_psrc
x = gi_omc 11 16
if ne x 0
gi_failv 2 x
ret
end
x1 = gi_run 11 0 20 14 16
x = gi_run get g_n 25 0 12 13 17
if ne x 0
gi_failv 3 x
ret
end
x = gi_run 8 0 13 18 19
if ne x 0
gi_failv 4 x
ret
end
if not gi_acc
gi_fail0 5
ret
end
x2 = gi_run 9 13 20 15 17
if ne x1 x2
gi_fail 6
if eq get g_n 14 0
gi_num x1
gi_say 7
gi_num x2
gi_nl
end
ret
end
if not gi_fcmp 14 15
gi_fail0 8
ret
end
if eq get g_n 14 0
gi_say 1
gi_name
gi_say 12
gi_num x1
gi_nl
end
end
note scratch ck starts with "ACCEPT "
fn gi_acc to bool
gi_ps 18
fd = gi_rdonly
if lt fd 0
ret false
end
n = gi_rdn fd 1 7
gi_fclo fd
if ne n 7
ret false
end
for j ulong 7
if ne get g_b1 j get g_acc j
ret false
end
end
ret true
end
note refuse NAME SRC
fn gi_fcase to void
if not gi_mkin
gi_fail0 38
ret
end
gi_psrc
x1 = gi_omc 11 16
if eq x1 0
gi_fail0 9
ret
end
x2 = gi_run get g_n 25 0 12 13 17
if ne x1 x2
gi_fail 6
if eq get g_n 14 0
gi_num x1
gi_say 7
gi_num x2
gi_nl
end
ret
end
if not gi_fcmp 16 17
gi_fail0 10
ret
end
if ne gi_size 13 0
gi_fail0 11
ret
end
if eq get g_n 14 0
gi_say 1
gi_name
gi_say 12
gi_num x1
gi_nl
end
end

note ---- the case list ---------------------------------------------------------------------------------
fn gi_sp p ulong to bool
c = get g_cs p
ret or eq c 32 eq c 9
end
note the next field of the line at or after p (before e) into (start, end) at g_n s, s+1; false when none
fn gi_fld p ulong e ulong s ulong to ulong
q = p
while and lt q e gi_sp q bound 1048576
q = add q 1
end
put g_n s q
while and lt q e not gi_sp q bound 1048576
q = add q 1
end
put g_n add s 1 q
ret q
end
note the next case line from the cursor: 0 none left, 1 run, 2 refuse, 3 malformed (fields in g_n 16..19)
fn gi_next to ulong
cs = get g_n 7
while lt get g_n 8 cs bound 1048576
p = get g_n 8
e = p
while and lt e cs ne get g_cs e 10 bound 1048576
e = add e 1
end
put g_n 8 add e 1
put g_n 26 p
q = p
while and lt q e gi_sp q bound 1048576
q = add q 1
end
if and lt q e ne get g_cs q 35
q = gi_fld q e 16
k = sub get g_n 17 get g_n 16
a = get g_n 16
q = gi_fld q e 16
q = gi_fld q e 18
if eq get g_n 18 get g_n 19
ret 3
end
if gi_isw a k 22
ret 1
end
if gi_isw a k 23
ret 2
end
ret 3
end
end
ret 0
end
note cases[a, a + k) is word i
fn gi_isw a ulong k ulong i ulong to bool
if ne k ulong get g_wl i
ret false
end
s = ulong get g_wo i
for j ulong k bound 64
if ne get g_cs add a j get g_w add s j
ret false
end
end
ret true
end
note every case of the list (kinds in kd: 1 run, 2 refuse, 3 both); in quiet mode stop at the first failure;
note true when some case failed
fn gi_all kd ulong to bool
put g_n 8 0
while true bound 65536
k = gi_next
if eq k 0
ret false
end
put g_n 15 0
if eq k 3
gi_fail0 29
else
if eq k 1
if ne and kd 1 0
gi_rcase
if eq get g_n 14 0
put g_n 11 add get g_n 11 1
end
end
else
if ne and kd 2 0
gi_fcase
if eq get g_n 14 0
put g_n 12 add get g_n 12 1
end
end
end
end
if ne get g_n 15 0
if ne get g_n 14 0
ret true
end
put g_n 13 add get g_n 13 1
end
end
ret false
end
note the first case of kind kd only, quietly; true when it failed
fn gi_first kd ulong to bool
put g_n 8 0
while true bound 65536
k = gi_next
if eq k 0
ret false
end
put g_n 15 0
if eq k kd
if eq kd 1
gi_rcase
else
gi_fcase
end
ret ne get g_n 15 0
end
end
ret false
end

note ---- negative controls -----------------------------------------------------------------------------
fn gi_mut m ulong to void
put g_n 20 add get g_n 20 1
gi_say 30
gi_num m
if not gi_mbld m
gi_say 37
gi_nl
put g_n 13 add get g_n 13 1
ret
end
put g_n 14 1
put g_n 25 21
hit = gi_all 1
put g_n 14 0
put g_n 25 7
if hit
put g_n 21 add get g_n 21 1
gi_say 32
gi_name
else
gi_say 31
put g_n 13 add get g_n 13 1
end
gi_nl
end
fn gi_ctl md ulong kd ulong to void
put g_n 22 add get g_n 22 1
gi_say add 32 md
put g_n 14 1
put g_n 24 md
hit = gi_first kd
put g_n 24 0
put g_n 14 0
if hit
put g_n 23 add get g_n 23 1
gi_say 36
gi_name
else
gi_say 35
put g_n 13 add get g_n 13 1
end
gi_nl
end

note ---- main ----------------------------------------------------------------------------------------------
fn gi_inval i ulong to int
gi_say 15
gi_say i
gi_nl
ret 2
end
note OMC hashes to the hex of argument 2
fn gi_oracle to bool
gi_pclr
for j ulong get g_n 1 bound 4096
gi_pc ulong get g_omc j
end
fd = gi_rdonly
if lt fd 0
ret false
end
n = ulong 0
while true bound 16777218
x = read fd sh_dat n sub len sh_dat n
if le x 0
break
end
n = add n ulong x
if ge n len sh_dat
gi_fclo fd
ret false
end
end
gi_fclo fd
sh_all n
r = argread 2 g_hx 0 128
if ne r 64
ret false
end
for j ulong 32
b = get sh_dig j
if ne get g_hx mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_hx add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
fn main to int
gi_init
if ne argcnt 5
ret gi_inval 24
end
r = argread 1 g_omc 0 4095
if lt r 1
ret gi_inval 24
end

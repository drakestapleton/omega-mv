note Float conversion parity: preserve the complete converted integer as eight output bytes.
fn convert x f32 to long
ret long x
end
fn main to int
a = new uchar 8 0
x = convert -1.5f32
bits = ulong bitcast ulong x
for i ulong len a
put a i uchar and shr bits mul i 8 255
end
k = write 1 a 0 len a
if ne k long len a
ret 1
end
ret 0
end

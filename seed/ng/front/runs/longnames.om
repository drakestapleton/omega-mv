note long names (9 to 63 bytes) for a scalar, a constant, a parameter, a local array, a global, a text and a loop
note counter: front-ir looks each up by the word fe_tok2 interns for it. Stdout "long names"; status 57.
const elements_count ulong 6
global running_totals ulong 4
text greeting_line "long names\n"

fn sum_of_values values_in view ulong 6 to ulong
accumulated_sum = ulong 0
for index_value ulong elements_count
accumulated_sum = add accumulated_sum get values_in index_value
end
ret accumulated_sum
end

fn main to int
local_numbers = new ulong elements_count 0
for position_now ulong elements_count
put local_numbers position_now mul position_now 3
end
put running_totals 1 sum_of_values local_numbers
written_bytes = write 1 greeting_line 0 len greeting_line
first_letter_seen = ulong get greeting_line 0
if ne first_letter_seen 108
ret 2
end
accumulated_total = add get running_totals 1 ulong written_bytes
accumulated_total = add accumulated_total 1
ret int accumulated_total
end

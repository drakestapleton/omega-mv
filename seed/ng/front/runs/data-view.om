om2
text msg "data\n"
global data uint 2
const SIZE ulong 2
fn readone a view uchar 5 to long
ret write 1 a 0 len a
end
fn copy a view uint 2 b edit uint 2 fresh to void
put b 0 get a 0
put b 1 get a 1
end
fn main to int
a = new uint SIZE 7
b = new uint SIZE 0
copy a b
put data 0 get b 0
put data 1 get b 1
k = readone msg
if ne get data 0 get data 1
ret 1
end
if ne k long len msg
ret 2
end
ret 0
end

om2
note p-partok: as p-part with the last part in range (6, 2): exit status (x + y) mod 256
fn sum a view uint * to ulong
s = ulong 0
for i ulong len a
s = add s ulong get a i
end
ret s
end
fn bump a edit uint * v uint to void
for i ulong len a
put a i add get a i v
end
end
fn main to int
b = new uint 8 0
for i ulong 8
put b i uint add i 1
end
bump part b 4 2 100
x = sum b
y = sum part b 2 3
z = sum part b 6 2
ret int add x y
end

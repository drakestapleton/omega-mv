note Float conversion parity: preserve the complete converted integer as eight output bytes.
fn convert x f64 to ushort
ret ushort x
end
fn main to int
a = new uchar 8 0
x = convert 6.5535e4f64
bits = ulong bitcast ushort x
for i ulong len a
put a i uchar and shr bits mul i 8 255
end
k = write 1 a 0 len a
if ne k long len a
ret 1
end
ret 0
end

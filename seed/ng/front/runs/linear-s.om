note linear-s: kernels/linear.om with 2 passes (was 40), for ngrun in gate-front-ir. linear:
note the torch.nn.Linear addmm kernel of omega-bridge pytorch/kernels/linear.om (main d8174edd,
note blob f7d5231a) at M 64, K 256, N 256, verbatim below the consts, plus a bench main: 40 passes, the
note bias changes by 1.0 at one column before each pass, and every pass folds the f32 bits of all
note outputs into one ulong checksum, printed as one decimal line.
const M ulong 64
const K ulong 256
const N ulong 256
const MK ulong 16384
const NK ulong 65536
const MN ulong 16384
note linear: o[M,N] = c[N] + a[M,K] @ w[N,K]^T, the addmm of a torch.nn.Linear whose weight transpose
note (aten.permute [1,0]) feeds only this addmm; w is read in place, nothing is copied. Each sum starts
note at the bias, is summed in f64 and rounded once to f32. Consts M K N MK NK MN come first.
fn lindot c view f32 N a view f32 MK w view f32 NK i ulong j ulong to f64
s = f64 get c j
ia = mul i K
iw = mul j K
for k ulong K
s = add s mul f64 get a ia f64 get w iw
ia = add ia 1
iw = add iw 1
end
ret s
end
fn linear c view f32 N a view f32 MK w view f32 NK o edit f32 MN to void
for i ulong M
for j ulong N
put o add mul i N j f32 lindot c a w i j
end
end
end
global out uchar 32
fn putnum v ulong to void
put out 31 10
p = ulong 31
x = v
while gt x 9
p = sub p 1
put out p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put out p uchar add x 48
w = write 1 out p sub 32 p
end
fn main to int
c = new f32 256 0.0f32
a = new f32 16384 0.0f32
w = new f32 65536 0.0f32
o = new f32 16384 0.0f32
for i ulong 256
put c i div f32 sub long rem mul i 5 11 5 4.0f32
end
for i ulong 16384
put a i div f32 sub long rem mul i 7 13 6 8.0f32
end
for i ulong 65536
put w i div f32 sub long rem mul i 3 17 8 16.0f32
end
s = ulong 0
for r ulong 2
q = rem r 256
put c q add get c q 1.0f32
linear c a w o
for i ulong 16384
s = add s mul ulong bitcast uint get o i add i 1
end
end
putnum s
ret 0
end

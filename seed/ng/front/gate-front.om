note SPDX-License-Identifier: Apache-2.0
note seed/ng/front/gate-front.om: the differential front gate of ng-front (Hive NG; DECISIONS D5, D6, D9).
note Handwritten seeded Omega, program mode, Linux AArch64, built by the pinned seed/out/omc. The child,
note segment and SHA-256 helpers follow seed/qualification/om2/gate.om; its SHA-256 constants are read
note from that directory's bc-derived fixtures, never typed here.
note
note Run from the repository root:
note   gate-front OMC OMC_SHA256 SRC DECLARED MUTANTS SCRATCH CASES [CASES ...]
note OMC        the oracle compiler; its sha256 must be OMC_SHA256 (64 lowercase hex) or no case runs (INVALID)
note SRC        the checker source: segments joined by + (a path, pack:PATH:OFF:LEN, cyc:PATH:N, units:LIST for
note            the units of an ng.units-form list in its order) concatenated in
note            order; OMC compiles it to SCRATCH/fecheck. The checker reads one unit on stdin, writes nothing
note            on stdout, or exactly what omc writes there (om2 diagnostics, check mode), and exits 0
note            (accepted) or as omc refuses (stderr `omc: line N: error K`, exit K). A segment in:PATH is not
note            source: the bytes of PATH (4096 at most) go before each case on the checker's stdin only (the
note            mode line of the ng unit, `@ng front-check`); omc reads the case alone.
note DECLARED   lines `NAME beyond K REASON...`: omc refuses NAME with exit K for a code-generator limit (12, 14,
note            24 or 25) and the checker must accept it (BEYOND_OMC, D6); `NAME scope K REASON...`: a unit form
note            this front end does not take yet; omc must exit K and the checker 64; `NAME ngonly K REASON...`:
note            a bound of the checker's own that omc reaches through another limit first; both must exit K
note            (stderr not compared: the lines differ). K is decimal, 0-255. Every listed NAME must be a case.
note MUTANTS    lines `NAME FROM TO`: SRC with the bytes of file FROM (present exactly once) replaced by the bytes
note            of file TO, compiled to SCRATCH/NAME. KILLED when some case FAILs under it, else SURVIVED.
note SCRATCH    a new directory (created 0700; an existing one is INVALID)
note CASES      lines `NAME SRC`, or the C2 manifest form `NAME emit SRC ...`; lines starting with # and blank
note            lines are skipped, and so is a line whose first word is `deadline`.
note A case is exact unless DECLARED: PASS needs equal exit status and equal stderr bytes from omc and the
note checker (all of them: each stderr has its own descriptor and the two are compared in 65536-byte
note chunks), and an empty checker stdout or one equal to omc's. The last line is the verdict:
note   FRONTGATE PASS|FAIL|INVALID cases=N exact=E beyond=B scope=S ngonly=O fail=F mutants=M killed=K
note Exit 0 PASS, 1 FAIL (any failing case, unused declaration or surviving mutant), 2 INVALID.

text msg "FRONTGATE PASS\nFRONTGATE FAIL\nFRONTGATE INVALID\n cases=\n exact=\n beyond=\n scope=\n fail=\n mutants=\n killed=\nFAIL \n omc=\n ng=\n  omc stderr: \n  ng stderr: \n ng wrote stdout\nKILLED \n at \nSURVIVED \nUNUSED declared \nINVALID: \nusage: gate-front OMC OMC_SHA256 SRC DECLARED MUTANTS SCRATCH CASES [CASES ...]\noracle sha256 differs from OMC_SHA256\nSHA-256 fixture unreadable\nscratch exists or cannot be made\nchecker build failed, omc exit=\nmutant build failed: \nsource unreadable, malformed or too large: \nlist file unreadable or too large: \nfork, memfd or descriptor failure\nchild deadline exceeded\nmutant FROM not present exactly once: \nORACLE \nCHECKER \n sha256=\nmalformed declared line: \n ngonly=\nmalformed mutant line\n"
text words "pack:\ncyc:\nemit\ndeadline\nbeyond\nscope\nfecheck\n/\n.om\n/dev/null\nseed/qualification/om2/fixtures/sha256-k.dec\nseed/qualification/om2/fixtures/sha256-iv.dec\nin:\nunits:\nngonly\n"
global ub uchar 65536

global ar uchar 65536
global ao ulong 64
global al ulong 64
global na ulong 1
global tb uchar 4096
global tn ulong 1
global pb uchar 4096
global pn ulong 1
global av uchar 8192
global ap ulong 2
global big uchar 16777216
global bgn ulong 1
global cs uchar 16777216
global csn ulong 1
global lst uchar 4194304
global lsn ulong 1
global dec uchar 1048576
global dnm uchar 262144
global dnn ulong 1
global dcn ulong 1
global dno ulong 4096
global dnl ulong 4096
global dcl uchar 4096
global dcd uchar 4096
global dus uchar 4096
global dhit ulong 1
global ndc ulong 1
global tko ulong 16
global tkl ulong 16
global ntk ulong 1
global eo uchar 65536
global eon ulong 1
global eg uchar 65536
global ob uchar 65536
global egn ulong 1
global buf uchar 65536
global stb uchar 4
global fds int 6
global pfx uchar 4096
global pfn ulong 1
global bad ulong 1
global cnt ulong 8
global dig uchar 32
global wpos ulong 2
global nums ulong 64
global kk uint 64
global ivs uint 8
global hv uint 8
global ws uint 64
global st uint 8
global blk uchar 64
global bk ulong 2
global hexd uchar 64
global mode ulong 1
global hit ulong 1
global nfl ulong 1
global chk uchar 4096
global chn ulong 1

note ---- output ----------------------------------------------------------------------------------
fn seg id ulong to void
k = ulong 1
s = ulong 0
for i ulong len msg
if eq get msg i 10
if eq k id
put wpos 0 s
put wpos 1 sub i s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
fn say id ulong to void
seg id
r = write 1 msg get wpos 0 get wpos 1
end
fn newline to void
put dig 0 10
r = write 1 dig 0 1
end
fn num v ulong to void
x = v
n = ulong 0
while ge x 10 bound 32
put dig n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
put dig n uchar add 48 x
n = add n 1
for i ulong n
r = write 1 dig sub sub n i 1 1
end
end
fn showarg k ulong to void
r = write 1 ar get ao k get al k
end
fn showtok t ulong to void
r = write 1 lst get tko t get tkl t
end
fn showtb to void
r = write 1 tb 0 get tn 0
end
fn showpb to void
r = write 1 pb 0 get pn 0
end
note the first line of a captured stderr (at most 200 bytes)
fn showeo to void
n = get eon 0
i = ulong 0
while and lt i n lt i 200 bound 256
if eq get eo i 10
n = i
else
i = add i 1
end
end
r = write 1 eo 0 i
end
fn showeg to void
n = get egn 0
i = ulong 0
while and lt i n lt i 200 bound 256
if eq get eg i 10
n = i
else
i = add i 1
end
end
r = write 1 eg 0 i
end
fn setbad id ulong to void
if eq get bad 0 0
put bad 0 id
end
end

note ---- fixed words ------------------------------------------------------------------------------
fn wordat id ulong to void
k = ulong 1
s = ulong 0
for i ulong len words
if eq get words i 10
if eq k id
put wpos 0 s
put wpos 1 sub i s
ret
end
k = add k 1
s = add i 1
end
end
exit 99
end
note tb[o .. o+n) starts with word id
fn tbpre o ulong n ulong id ulong to bool
wordat id
k = get wpos 1
if lt n k
ret false
end
s = get wpos 0
for i ulong k
if ne get tb add o i get words add s i
ret false
end
end
ret true
end
note tb[o .. o+n) is word id
fn tbis o ulong n ulong id ulong to bool
wordat id
if ne n get wpos 1
ret false
end
ret tbpre o n id
end

note ---- the scratch buffer tb (one token, argument or path at a time) ----------------------------
fn tbclr to void
put tn 0 0
end
fn tbbyte b uchar to void
n = get tn 0
if ge n 4095
setbad 28
ret
end
put tb n b
put tn 0 add n 1
end
fn tbarg k ulong to void
tbclr
o = get ao k
for i ulong get al k
tbbyte get ar add o i
end
end
fn tbtok t ulong to void
tbclr
o = get tko t
for i ulong get tkl t
tbbyte get lst add o i
end
end
fn tbdec o ulong n ulong to void
tbclr
for i ulong n
tbbyte get dec add o i
end
end
note declared names live in dnm, apart from dec, which the mutant list later reuses
fn tbdnm o ulong n ulong to void
tbclr
for i ulong n
tbbyte get dnm add o i
end
end

note ---- paths --------------------------------------------------------------------------------------
fn pclear to void
put pn 0 0
end
fn pbyte b uchar to void
n = get pn 0
if ge n 4095
setbad 30
ret
end
put pb n b
put pn 0 add n 1
end
fn ptb o ulong n ulong to void
for i ulong n
pbyte get tb add o i
end
end
fn pword id ulong to void
wordat id
s = get wpos 0
for i ulong get wpos 1
pbyte get words add s i
end
end
fn parg k ulong to void
o = get ao k
for i ulong get al k
pbyte get ar add o i
end
end
note SCRATCH/ followed by tb (a mutant name) or by a fixed word
fn pscr to void
pclear
parg 6
pword 8
end
fn popen fl int to int
r = fopen pb 0 get pn 0 fl 448
if lt r 0
ret -1
end
ret int r
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end

note ---- decimal fields -------------------------------------------------------------------------------
fn tbnum o ulong n ulong to ulong
if or eq n 0 gt n 19
setbad 28
ret 0
end
v = ulong 0
for i ulong n
c = get tb add o i
if or lt c 48 gt c 57
setbad 28
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn tblastc o ulong n ulong to ulong
i = n
while gt i 0 bound 4096
i = sub i 1
if eq get tb add o i 58
ret i
end
end
ret n
end

note ---- sources into big ------------------------------------------------------------------------------
fn bigpre fd int off ulong k ulong to bool
b = get bgn 0
done = ulong 0
while lt done k bound 100000
c = sub k done
if gt c 1048576
c = ulong 1048576
end
r = pread fd big add b done c long add off done
if le r 0
ret false
end
done = add done ulong r
end
ret true
end
fn addpack o ulong n ulong to void
q = tblastc o n
if ge q n
setbad 28
ret
end
p = tblastc o q
if ge p q
setbad 28
ret
end
k = tbnum add add o q 1 sub sub n q 1
off = tbnum add add o p 1 sub sub q p 1
if ne get bad 0 0
ret
end
if gt k sub len big get bgn 0
setbad 28
ret
end
pclear
ptb o p
fd = popen 524288
if lt fd 0
setbad 28
ret
end
ok = bigpre fd off k
fclo fd
if not ok
setbad 28
ret
end
put bgn 0 add get bgn 0 k
end
fn cycrow b ulong s ulong c ulong m ulong to void
for i ulong c
put big add add b s i get buf rem add s i m
end
end
fn addcyc o ulong n ulong to void
q = tblastc o n
if ge q n
setbad 28
ret
end
k = tbnum add add o q 1 sub sub n q 1
if ne get bad 0 0
ret
end
if gt k sub len big get bgn 0
setbad 28
ret
end
pclear
ptb o q
fd = popen 524288
if lt fd 0
setbad 28
ret
end
r = read fd buf 0 len buf
fclo fd
if or le r 0 ge r long len buf
setbad 28
ret
end
m = ulong r
b = get bgn 0
for row ulong add div k 65536 1
s = mul row 65536
c = sub k s
if gt c 65536
c = ulong 65536
end
cycrow b s c m
end
put bgn 0 add b k
end
fn addfile o ulong n ulong to void
pclear
ptb o n
addpb
end
note the file at the path in pb appended to big
fn addpb to void
fd = popen 524288
if lt fd 0
setbad 28
ret
end
go = true
while go bound 100000
b = get bgn 0
if ge b len big
setbad 28
go = false
else
r = read fd big b sub len big b
if lt r 0
setbad 28
go = false
else
if eq r 0
go = false
else
put bgn 0 add b ulong r
end
end
end
end
fclo fd
end
note in:PATH: the bytes of PATH into pfx (the checker's stdin prefix), not into big
fn addpfx o ulong n ulong to void
b0 = get bgn 0
addfile o n
k = sub get bgn 0 b0
if gt k len pfx
setbad 28
k = ulong 0
end
for i ulong k
put pfx i get big add b0 i
end
put pfn 0 k
put bgn 0 b0
end
note units:PATH: each line `SHA256 PATH` of the units list at PATH (the seed/ng/ng.units form) as a path
note segment, in order; the pins are ngbuild's to check, not this gate's
fn addunit o ulong n ulong to void
pclear
ptb o n
fd = popen 524288
if lt fd 0
setbad 28
ret
end
r = read fd ub 0 len ub
fclo fd
if or le r 0 ge r long len ub
setbad 28
ret
end
m = ulong r
s = ulong 0
for i ulong add m 1
if or eq i m eq get ub i 10
unitln s i
s = add i 1
end
end
end
note the unit on the list line ub[s, e) (64 hex digits, a space, the path); an empty line adds nothing
fn unitln s ulong e ulong to void
if eq s e
ret
end
if le e add s 65
setbad 28
ret
end
pclear
for i ulong sub e add s 65
pbyte get ub add add s 65 i
end
addpb
end
fn addseg o ulong n ulong to void
if tbpre o n 14
addunit add o 6 sub n 6
ret
end
if tbpre o n 13
addpfx add o 3 sub n 3
ret
end
if tbpre o n 1
addpack add o 5 sub n 5
ret
end
if tbpre o n 2
addcyc add o 4 sub n 4
ret
end
addfile o n
end
note the +-joined source spec in tb, appended to big
fn addsrc to void
n = get tn 0
s = ulong 0
for i ulong add n 1
if or eq i n eq get tb i 43
if eq i s
setbad 28
else
addseg s sub i s
end
s = add i 1
end
end
end

note ---- whole files into lst / dec --------------------------------------------------------------------
fn readlst to bool
fd = popen 524288
if lt fd 0
ret false
end
n = ulong 0
go = true
while go bound 100000
r = read fd lst n sub len lst n
if le r 0
go = false
if lt r 0
n = len lst
end
else
n = add n ulong r
if ge n len lst
go = false
end
end
end
fclo fd
put lsn 0 n
ret lt n len lst
end
fn readdec to bool
fd = popen 524288
if lt fd 0
ret false
end
n = ulong 0
go = true
while go bound 100000
r = read fd dec n sub len dec n
if le r 0
go = false
if lt r 0
n = len dec
end
else
n = add n ulong r
if ge n len dec
go = false
end
end
end
fclo fd
put dcn 0 n
ret lt n len dec
end

note lst[j] is inside the line (j < e) and not a blank
fn intok j ulong e ulong to bool
c = get lst j
ret and lt j e and ne c 32 ne c 9
end
note ---- tokens of lst[s .. e) -------------------------------------------------------------------------
fn tokenize s ulong e ulong to void
put ntk 0 0
i = s
while lt i e bound 4194304
c = get lst i
if or eq c 32 eq c 9
i = add i 1
else
t = get ntk 0
j = i
while intok j e bound 4194304
j = add j 1
end
if lt t 16
put tko t i
put tkl t sub j i
put ntk 0 add t 1
end
i = j
end
end
end
fn lineend p ulong to ulong
n = get lsn 0
i = p
while and lt i n ne get lst i 10 bound 4194304
i = add i 1
end
ret i
end

note ---- declared table ----------------------------------------------------------------------------------
note dtok: the next word of dec at or after p, as (offset, length) in wpos; stops at a newline
fn dword p ulong e ulong to void
i = p
while and lt i e dblank i bound 1048576
i = add i 1
end
j = i
while and lt j e not dblank j bound 1048576
j = add j 1
end
put wpos 0 i
put wpos 1 sub j i
end
fn dblank i ulong to bool
c = get dec i
ret or eq c 32 eq c 9
end
fn loaddec to bool
n = get dcn 0
p = ulong 0
while lt p n bound 1048576
e = p
while and lt e n ne get dec e 10 bound 1048576
e = add e 1
end
dword p e
o = get wpos 0
l = get wpos 1
if and gt l 0 ne get dec o 35
k = get ndc 0
if ge k 4096
ret false
end
dword add o l e
co = get wpos 0
cl = get wpos 1
tbdec co cl
c = ulong 0
if tbis 0 get tn 0 5
c = ulong 1
end
if tbis 0 get tn 0 6
c = ulong 2
end
if tbis 0 get tn 0 15
c = ulong 3
end
dword add co cl e
tbdec get wpos 0 get wpos 1
v = tbcode
if or eq c 0 gt v 255
say 36
tbdec o l
showtb
newline
put bad 0 36
ret false
end
if not dnmadd k o l
ret false
end
put dnl k l
put dcl k uchar c
put dcd k uchar v
put dus k 0
put ndc 0 add k 1
end
p = add e 1
end
ret true
end
note tb is a decimal exit code 0-255: its value, else 1000
fn tbcode to ulong
n = get tn 0
if or eq n 0 gt n 3
ret 1000
end
v = ulong 0
for i ulong n
c = get tb i
if or lt c 48 gt c 57
ret 1000
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note the declared class of case token 0 (0 exact, 1 beyond, 2 scope, 3 ngonly), marking the entry used and
note keeping its index in dhit
fn dclass to ulong
o = get tko 0
l = get tkl 0
for k ulong get ndc 0
if eq get dnl k l
if dsame get dno k o l
put dus k 1
put dhit 0 k
ret ulong get dcl k
end
end
end
ret 0
end
note copy declared name dec[o .. o+l) into dnm as entry k's name; false when dnm is full
fn dnmadd k ulong o ulong l ulong to bool
s = get dnn 0
if gt add s l len dnm
ret false
end
for i ulong l
put dnm add s i get dec add o i
end
put dnn 0 add s l
put dno k s
ret true
end
note dnm[d .. d+l) equals lst[o .. o+l)
fn dsame d ulong o ulong l ulong to bool
for i ulong l
if ne get dnm add d i get lst add o i
ret false
end
end
ret true
end

note ---- children -----------------------------------------------------------------------------------------
fn aclear to void
put ap 0 2
put ap 1 0
end
fn ahead n ulong to void
p = get ap 0
if gt add add p n 2 len av
setbad 30
ret
end
put av p uchar and n 255
put av add p 1 uchar shr n 8
put ap 0 add p 2
put ap 1 add get ap 1 1
end
fn apb to void
n = get pn 0
ahead n
p = get ap 0
if le add p n len av
for i ulong n
put av add p i get pb i
end
put ap 0 add p n
end
end
fn redir s int d int to void
if ne s d
if ne dupfd s d 0 long d
exit 127
end
end
end
note wait for pid: its exit status, 256 + the signal, or 1000 when the deadline (900 s) passed and it was killed
fn reap pid int to ulong
t0 = monons
while true bound 1000000000
r = waitpid pid stb 0 len stb 1
if eq r long pid
if ne get stb 0 0
ret add 256 ulong get stb 0
end
ret ulong get stb 1
end
if lt r 0
setbad 30
ret 999
end
now = monons
if gt sub now t0 900000000000
r = killpid pid 9
r = waitpid pid stb 0 len stb 0
setbad 31
ret 1000
end
q = sleepns 100000
end
ret 999
end
fn spawn fi int fo int fe int to ulong
put av 0 uchar and get ap 1 255
put av 1 uchar shr get ap 1 8
if ne fseek fi 0 0 0
setbad 30
ret 999
end
pid = fork
if lt pid 0
setbad 30
ret 999
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog av 0 get ap 0
exit 127
end
ret reap int pid
end
note reset descriptor fd to an empty file
fn empty fd int to void
if ne ftrunc fd 0 0
setbad 30
end
if ne fseek fd 0 0 0
setbad 30
end
end
note the first 65536 bytes of a captured stderr, omc's (fds[5]) into eo, the checker's (fds[1]) into eg, for the
note FAIL lines only; the comparison is samefd over the whole of both descriptors
fn grab fd int to ulong
if ne fseek fd 0 0 0
setbad 30
ret 0
end
n = ulong 0
go = true
while go bound 100000
r = read fd buf n sub len buf n
if le r 0
go = false
else
n = add n ulong r
if ge n len buf
go = false
end
end
end
ret n
end
fn grabo to void
n = grab get fds 5
for i ulong n
put eo i get buf i
end
put eon 0 n
end
fn grabg to void
n = grab get fds 1
for i ulong n
put eg i get buf i
end
put egn 0 n
end
note big into descriptor fds[0]; with an in: prefix also pfx then big into fds[4] (the checker's stdin)
fn putsrc to void
fd = get fds 0
empty fd
wrbig fd
p = get pfn 0
if gt p 0
f4 = get fds 4
empty f4
k = ulong 0
while lt k p bound 100000
r = write f4 pfx k sub p k
if le r 0
setbad 30
ret
end
k = add k ulong r
end
wrbig f4
end
end
fn wrbig fd int to void
n = get bgn 0
off = ulong 0
while lt off n bound 100000
r = write fd big off sub n off
if le r 0
setbad 30
ret
end
off = add off ulong r
end
end

note ---- SHA-256 (FIPS 180-4), as seed/qualification/om2/gate.om -----------------------------------------
fn rotr x uint n uint to uint
ret or shr x n shl x sub 32 n
end
fn shasched to void
for i ulong 16
b = mul i 4
v = shl uint get blk b 24
v = or v shl uint get blk add b 1 16
v = or v shl uint get blk add b 2 8
v = or v uint get blk add b 3
put ws i v
end
for j ulong 48
q = add j 16
x = get ws sub q 15
y = get ws sub q 2
s0 = xor xor rotr x 7 rotr x 18 shr x 3
s1 = xor xor rotr y 17 rotr y 19 shr y 10
put ws q add add add get ws sub q 16 s0 get ws sub q 7 s1
end
end
fn shat1 i ulong to uint
e = get st 4
s1 = xor xor rotr e 6 rotr e 11 rotr e 25
ch = xor and e get st 5 and not e get st 6
ret add add add add get st 7 s1 ch get kk i get ws i
end
fn shat2 to uint
a = get st 0
b = get st 1
c = get st 2
s0 = xor xor rotr a 2 rotr a 13 rotr a 22
mj = xor xor and a b and a c and b c
ret add s0 mj
end
fn shacomp to void
shasched
for i ulong 8
put st i get hv i
end
for i ulong 64
t1 = shat1 i
t2 = shat2
put st 7 get st 6
put st 6 get st 5
put st 5 get st 4
put st 4 add get st 3 t1
put st 3 get st 2
put st 2 get st 1
put st 1 get st 0
put st 0 add t1 t2
end
for i ulong 8
put hv i add get hv i get st i
end
end
fn shabyte b uchar to void
n = get bk 0
put blk n b
n = add n 1
if eq n 64
shacomp
n = ulong 0
end
put bk 0 n
put bk 1 add get bk 1 1
end
fn hexch v uint to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
fn shafinal to void
bits = mul get bk 1 8
shabyte 128
while ne get bk 0 56 bound 64
shabyte 0
end
for i ulong 8
shabyte uchar and shr bits mul sub 7 i 8 255
end
for i ulong 8
v = get hv i
for j ulong 8
put hexd add mul i 8 j hexch and shr v mul sub 7 j 4 15
end
end
end
note hash the file named by pb into hexd; false when it cannot be read
fn hashfile to bool
fd = popen 524288
if lt fd 0
ret false
end
for i ulong 8
put hv i get ivs i
end
put bk 0 0
put bk 1 0
while true bound 100000000
r = read fd buf 0 len buf
if lt r 0
fclo fd
ret false
end
if eq r 0
fclo fd
shafinal
ret true
end
for i ulong ulong r
shabyte get buf i
end
end
ret false
end
note decimal numbers below 2^32, one per line, exactly want of them, from fixed word id into nums
fn loadnums id ulong want ulong to bool
pclear
pword id
fd = popen 524288
if lt fd 0
ret false
end
r = read fd buf 0 len buf
fclo fd
if or le r 0 ge r long len buf
ret false
end
k = ulong 0
v = ulong 0
nd = ulong 0
for i ulong ulong r
c = get buf i
if and ge c 48 le c 57
if ge nd 10
ret false
end
v = add mul v 10 ulong sub c 48
nd = add nd 1
else
if or ne c 10 eq nd 0
ret false
end
if or ge k want gt v 4294967295
ret false
end
put nums k v
k = add k 1
v = ulong 0
nd = ulong 0
end
end
ret and eq nd 0 eq k want
end
fn showhex to void
r = write 1 hexd 0 64
end

note ---- building ---------------------------------------------------------------------------------------------
note write big to pb (created 0700)
fn bigfile to bool
fd = popen 524865
if lt fd 0
ret false
end
n = get bgn 0
off = ulong 0
while lt off n bound 100000
r = write fd big off sub n off
if le r 0
fclo fd
ret false
end
off = add off ulong r
end
fclo fd
ret true
end
note compile the file at pb (big was written there) with OMC to pb without its .om suffix, which becomes
note chk and pb again; omc's exit
fn build to ulong
fi = popen 524288
if lt fi 0
ret 999
end
put pn 0 sub get pn 0 3
setchk
fo = popen 524865
if lt fo 0
fclo fi
ret 999
end
aclear
pclear
parg 1
apb
empty get fds 1
x = spawn fi fo get fds 1
fclo fi
fclo fo
pclear
for i ulong get chn 0
pbyte get chk i
end
ret x
end

note descriptor b has the bytes of descriptor a, all of them (compared in 65536-byte chunks)
fn samefd a int b int to bool
if ne fseek a 0 2 fseek b 0 2
ret false
end
if or ne fseek a 0 0 0 ne fseek b 0 0 0
ret false
end
while true bound 1000
r = read a buf 0 len buf
if le r 0
ret eq r 0
end
if not samechk b ulong r
ret false
end
end
ret false
end
note the next n bytes of fd b equal buf[0 .. n)
fn samechk b int n ulong to bool
k = ulong 0
while lt k n bound 100000
r = read b ob k sub n k
if le r 0
ret false
end
k = add k ulong r
end
for i ulong n
if ne get ob i get buf i
ret false
end
end
ret true
end
note ---- one case ------------------------------------------------------------------------------------------------
note the checker's stdin: fds[4] (prefix and case) with an in: prefix, else fds[0] (the case, as omc reads it)
fn chkin to int
if gt get pfn 0 0
ret get fds 4
end
ret get fds 0
end
note run the source in big through omc and through the checker at chk; judge the pair
fn runcase cls ulong to bool
putsrc
aclear
pclear
parg 1
apb
empty get fds 5
empty get fds 2
xo = spawn get fds 0 get fds 2 get fds 5
grabo
aclear
pclear
for i ulong get chn 0
pbyte get chk i
end
apb
empty get fds 1
empty get fds 3
xn = spawn chkin get fds 3 get fds 1
grabg
sz = fseek get fds 3 0 2
ok = false
cd = ulong get dcd get dhit 0
if eq cls 0
ok = and eq xo xn samefd get fds 5 get fds 1
end
if eq cls 1
ok = and eq xo cd eq xn 0
end
if eq cls 2
ok = and eq xo cd eq xn 64
end
if eq cls 3
ok = and eq xo cd eq xn cd
end
if ne sz 0
if not samefd get fds 2 get fds 3
ok = false
else
sz = long 0
end
end
if and not ok eq get mode 0 0
put nfl 0 add get nfl 0 1
if le get nfl 0 60
say 11
showtok 0
say 12
num xo
say 13
num xn
if ne sz 0
say 16
end
newline
say 14
showeo
newline
say 15
showeg
newline
end
end
ret ok
end
note the cases of list file arg k; in mode 1 stop at the first failing case (kept in hit) and return false
fn runlist k ulong to bool
tbarg k
pclear
ptb 0 get tn 0
if not readlst
say 21
say 29
showpb
newline
put bad 0 29
ret false
end
n = get lsn 0
p = ulong 0
while lt p n bound 4194304
e = lineend p
tokenize p e
t = get ntk 0
skip = eq t 0
if not skip
c = get lst get tko 0
skip = eq c 35
end
if not skip
tbtok 0
skip = tbis 0 get tn 0 4
end
if and not skip lt t 2
skip = true
end
if not skip
s = ulong 1
if gt t 2
tbtok 1
if tbis 0 get tn 0 3
s = ulong 2
end
end
tbtok s
put bgn 0 0
addsrc
if ne get bad 0 0
say 21
say 28
showtok 0
newline
ret false
end
cls = dclass
ok = runcase cls
if ne get bad 0 0
say 21
say get bad 0
showtok 0
newline
ret false
end
if eq get mode 0 0
put cnt 0 add get cnt 0 1
if ok
ci = add cls 1
if eq cls 3
ci = ulong 7
end
put cnt ci add get cnt ci 1
else
put cnt 4 add get cnt 4 1
end
else
if not ok
put hit 0 p
ret false
end
end
end
p = add e 1
end
ret true
end

note ---- main ------------------------------------------------------------------------------------------------------
fn verdict v ulong to int
say v
say 4
num get cnt 0
say 5
num get cnt 1
say 6
num get cnt 2
say 7
num get cnt 3
say 37
num get cnt 7
say 8
num get cnt 4
say 9
num get cnt 5
say 10
num get cnt 6
newline
if eq v 1
ret 0
end
if eq v 2
ret 1
end
ret 2
end
fn invalid id ulong to int
say 21
say id
newline
ret verdict 3
end
fn loadargs to bool
n = argcnt
if or lt n 8 gt n 64
ret false
end
o = ulong 0
for i ulong ulong n
r = argread i ar o sub len ar o
if le r 0
ret false
end
put ao i o
put al i ulong r
o = add o ulong r
end
put na 0 ulong n
ret true
end
note run the mutants of file arg 5 against every case list; mode 1
fn mutants to void
tbarg 5
pclear
ptb 0 get tn 0
if not readdec
setbad 29
ret
end
n = get dcn 0
p = ulong 0
while lt p n bound 1048576
e = p
while and lt e n ne get dec e 10 bound 1048576
e = add e 1
end
dword p e
mo = get wpos 0
ml = get wpos 1
if and gt ml 0 ne get dec mo 35
onemut mo ml e
if ne get bad 0 0
ret
end
end
p = add e 1
end
end
note substitute and build one mutant (dec name at mo, ml; its FROM and TO words follow before e), then run it
fn onemut mo ulong ml ulong e ulong to void
dword add mo ml e
fo = get wpos 0
fl = get wpos 1
dword add fo fl e
tw = get wpos 0
tl = get wpos 1
if or eq fl 0 eq tl 0
setbad 38
ret
end
put cnt 5 add get cnt 5 1
if not mutsub fo fl tw tl
if eq get bad 0 0
say 32
tbdec mo ml
showtb
newline
setbad 32
end
ret
end
tbdec mo ml
pscr
ptb 0 get tn 0
pword 9
if not bigfile
setbad 30
ret
end
x = build
if ne x 0
say 27
showtb
newline
setbad 27
ret
end
pscr
ptb 0 get tn 0
setchk
mutrun mo ml
pscr
pword 7
setchk
end
note the checker path chk = pb
fn setchk to void
for i ulong get pn 0
put chk i get pb i
end
put chn 0 get pn 0
end
note big = cs with the bytes of file dec[fo, fl) replaced by those of file dec[tw, tl); false when the
note first file is empty, longer than 65536 bytes, or not present in cs exactly once
fn mutsub fo ulong fl ulong tw ulong tl ulong to bool
tbdec fo fl
put bgn 0 0
addfile 0 get tn 0
fz = get bgn 0
if or ne get bad 0 0 or eq fz 0 gt fz 65536
ret false
end
for i ulong fz
put buf i get big i
end
at = findonce fz
if ge at get csn 0
ret false
end
for i ulong at bound 16777216
put big i get cs i
end
put bgn 0 at
tbdec tw tl
addfile 0 get tn 0
if ne get bad 0 0
ret false
end
ret mutrest add at fz
end
note append cs[s .. csn) to big
fn mutrest s ulong to bool
b = get bgn 0
rest = sub get csn 0 s
if gt rest sub len big b
setbad 28
ret false
end
for i ulong rest bound 16777216
put big add b i get cs add s i
end
put bgn 0 add b rest
ret true
end
note run the mutant checker (chk) over the case lists until a case fails
fn mutrun mo ulong ml ulong to void
put mode 0 1
killed = false
k = ulong 7
while and not killed lt k get na 0 bound 64
if not runlist k
killed = true
end
if ne get bad 0 0
ret
end
k = add k 1
end
put mode 0 0
tbdec mo ml
if killed
put cnt 6 add get cnt 6 1
say 17
showtb
say 18
p = get hit 0
tokenize p lineend p
showtok 0
newline
else
say 19
showtb
newline
put cnt 4 add get cnt 4 1
end
end
note the only place in cs where buf[0 .. fz) starts, or csn when it is absent or appears twice
fn findonce fz ulong to ulong
n = get csn 0
if lt n fz
ret n
end
found = n
for i ulong add sub n fz 1 bound 16777216
if matchat i fz
if lt found n
ret n
end
found = i
end
end
ret found
end
note cs[i .. i+fz) equals buf[0 .. fz)
fn matchat i ulong fz ulong to bool
for j ulong fz
if ne get cs add i j get buf j
ret false
end
end
ret true
end

note the oracle identity, the scratch directory and the child descriptors; 0 or an INVALID message id
fn setup to ulong
if not loadnums 11 64
ret 24
end
for i ulong 64
put kk i uint get nums i
end
if not loadnums 12 8
ret 24
end
for i ulong 8
put ivs i uint get nums i
end
pclear
parg 1
if not hashfile
ret 23
end
say 33
showpb
say 35
showhex
newline
tbarg 2
if ne get tn 0 64
ret 23
end
for i ulong 64
if ne get tb i get hexd i
ret 23
end
end
pclear
parg 6
if lt makedir pb 0 get pn 0 448 0
ret 25
end
ret fdsetup
end
fn fdsetup to ulong
m0 = memfd words 0 4 1
m1 = memfd words 0 4 1
m2 = memfd words 0 4 1
m3 = memfd words 0 4 1
m4 = memfd words 0 4 1
if or or lt m0 0 lt m1 0 or or lt m2 0 lt m3 0 lt m4 0
ret 30
end
put fds 0 int m0
put fds 1 int m1
put fds 2 int m2
put fds 3 int m3
put fds 4 int m4
m5 = memfd words 0 4 1
if lt m5 0
ret 30
end
put fds 5 int m5
tbarg 4
pclear
ptb 0 get tn 0
if not readdec
ret 29
end
if not loaddec
if eq get bad 0 36
ret 36
end
ret 29
end
ret 0
end
note SRC into cs and compiled to SCRATCH/fecheck (chk); 0, an INVALID message id, or 1000 + omc's exit
fn mkcheck to ulong
tbarg 3
put bgn 0 0
addsrc
if ne get bad 0 0
ret 28
end
n = get bgn 0
for i ulong n bound 16777216
put cs i get big i
end
put csn 0 n
pscr
pword 7
pword 9
if not bigfile
ret 30
end
x = build
if ne x 0
ret add 1000 x
end
if not hashfile
ret 30
end
say 34
showpb
say 35
showhex
newline
ret 0
end
note every case list, then the unused declarations; false on a setup failure (bad)
fn runall to bool
k = ulong 7
while lt k get na 0 bound 64
if not runlist k
ret false
end
k = add k 1
end
for d ulong get ndc 0
if eq get dus d 0
say 20
tbdnm get dno d get dnl d
showtb
newline
put cnt 4 add get cnt 4 1
end
end
ret true
end
fn main to int
if not loadargs
say 22
newline
ret 2
end
e = setup
if ne e 0
ret invalid e
end
e = mkcheck
if ge e 1000
say 26
num sub e 1000
newline
put cnt 4 1
ret verdict 2
end
if ne e 0
ret invalid e
end
if not runall
ret invalid get bad 0
end
mutants
if ne get bad 0 0
ret invalid get bad 0
end
if eq get cnt 4 0
ret verdict 1
end
ret verdict 2
end

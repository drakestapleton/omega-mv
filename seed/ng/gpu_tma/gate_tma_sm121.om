note seed/ng/gpu_tma/gate_tma_sm121.om: CPU-Host Verification Gate for Omega NG Multi-Stage
note Async SMEM / OMMA.SF.16864 / HMMA.16816 SM121 Lowering & Antibody #13-#17 / G2 Delta-Shrinker.
note ZERO `/dev/nvidia*` required.
note
note Compose after:
note   seed/ng/target/target_desc.om
note   om/encoder/bw_enc_sm121.om
note   seed/ng/gpu_tma/tma_lower.om
note   seed/ng/gpu_tma/g2_shrink.om
note
note Modes:
note   gate_tma_sm121                   -> runs full positive + 11 negative control gate suite
note   gate_tma_sm121 --shrink FILE.bin -> runs live G2 audit + binary-search delta-shrinker on real SASS

global gtDig uchar 24
global gtPath uchar 1024
global gtRaw uchar 32768
global gtChk ulong 1
global gtCtrl ulong 1

text gtHdr "=== OMEGA NG SM121 TMA/OMMA/HMMA LOWERING + ANTIBODY #17 GATE ===\n"
text gtPos1 "  PASS [POS-1] NVFP4 OMMA.SF.16864 2-stage async SMEM + L2 swizzle + fused Scale+SiLU: insns="
text gtPos2 "  PASS [POS-2] BF16 HMMA.16816 3-stage async SMEM + L2 swizzle + fused RMSNorm: insns="
text gtSm " smem="
text gtRg " maxReg="
text gtOv " overlapMma="
text gtStg " stg="
text gtQmd " qmd_valid="
text gtHaz " hazards="
text gtCtrlPass "  PASS [NEG-1..12] All 12 fail-closed negative controls caught (SMEM, REGS, TARGET, HAZ, AB13..AB17d, G2 1-swap shrink)\n"
text gtShrA "  PASS [G2-SHRINK] swaps="
text gtShrB "->1 probes="
text gtShrC " trigger_pc="
text gtShrD " u="
text gtShrE " v_corrupt="
text gtShrF " first_v="
text gtShrG " ref_cyc="
text gtShrH " cnd_cyc="
text gtShrI " legacy_monk="
text gtShrJ " ab17="
text gtDoneA "GATE_TMA_SM121 PASS checks="
text gtDoneB " controls="
text gtFailA "GATE_TMA_SM121 FAIL at check="
text gtFileA "SHRINK_FILE file="
text gtFileNo "SHRINK_FILE clean_or_no_g2_breach file="
text gtNl "\n"

fn gtWrt s view uchar * to void
r = write 1 s 0 len s
end

fn gtNum v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gtDig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 gtDig p sub 24 p
ret
end
end
end

fn gtFail id ulong to int
gtWrt gtFailA
gtNum id
gtWrt gtNl
ret int id
end

fn gtAddChk n ulong to void
put gtChk 0 add get gtChk 0 n
end

fn gtAddCtrl n ulong to void
put gtCtrl 0 add get gtCtrl 0 n
end

fn gtPrintShrinkSummary to void
gtWrt gtShrA
gtNum get g2ShrinkOut 1
gtWrt gtShrB
gtNum get g2ShrinkOut 3
gtWrt gtShrC
gtNum get g2ShrinkOut 4
gtWrt gtShrD
gtNum get g2ShrinkOut 7
gtWrt gtShrE
gtNum get g2ShrinkOut 8
gtWrt gtShrF
gtNum get g2ShrinkOut 9
gtWrt gtShrG
gtNum get g2ShrinkOut 10
gtWrt gtShrH
gtNum get g2ShrinkOut 11
gtWrt gtShrI
gtNum get g2ShrinkOut 5
gtWrt gtShrJ
gtNum get g2ShrinkOut 6
gtWrt gtNl
end

note ---- Positive Gate 1: NVFP4 OMMA.SF.16864 + 2-Stage Double-Buffered Async SMEM + Fused Scale+SiLU ----
fn gtTestPosNvfp4 to int
tmaSetGraph TID_SM121 TMA_MODE_NVFP4_OMMA 128 64 256 64
tmaSetGraph2 64 64 2 4 64 128
tmaSetGraph3 or TMA_FUSE_SCALE TMA_FUSE_SILU 1 4096
rc = tmaLowerAndEmit
if ne rc TMA_OK
ret gtFail 10
end
if or eq get tmaPlan 1 0 gt get tmaPlan 1 TMA_SM121_SMEM_CAP
ret gtFail 11
end
if gt get tmaPlan 7 61
ret gtFail 12
end
if ne get tmaPlan 8 0
ret gtFail 13
end
if lt get tmaPlan 9 8
ret gtFail 14
end
if ne get tmaPlan 10 1
ret gtFail 15
end
if lt get tmaPlan 11 12
ret gtFail 16
end
if ne get tmaPlan 13 1
ret gtFail 17
end
if ne ulong get tmaQmd 36 get tmaPlan 1
ret gtFail 18
end
gtWrt gtPos1
gtNum get tmaPlan 6
gtWrt gtSm
gtNum get tmaPlan 1
gtWrt gtRg
gtNum get tmaPlan 7
gtWrt gtOv
gtNum get tmaPlan 9
gtWrt gtStg
gtNum get tmaPlan 10
gtWrt gtHaz
gtNum get tmaPlan 8
gtWrt gtQmd
gtNum get tmaPlan 13
gtWrt gtNl
gtAddChk 9
ret 0
end

note ---- Positive Gate 2: BF16 HMMA.16816 + 3-Stage Triple-Buffered Async SMEM + Fused RMSNorm ----
fn gtTestPosBf16 to int
tmaSetGraph TID_SM121 TMA_MODE_BF16_HMMA 128 64 192 64
tmaSetGraph2 64 64 3 4 128 128
tmaSetGraph3 TMA_FUSE_RMSNORM 1 8192
rc = tmaLowerAndEmit
if ne rc TMA_OK
ret gtFail 20
end
if or eq get tmaPlan 1 0 gt get tmaPlan 1 TMA_SM121_SMEM_CAP
ret gtFail 21
end
if gt get tmaPlan 7 125
ret gtFail 22
end
if ne get tmaPlan 8 0
ret gtFail 23
end
if lt get tmaPlan 9 12
ret gtFail 24
end
if ne get tmaPlan 10 1
ret gtFail 25
end
if lt get tmaPlan 12 20
ret gtFail 26
end
if ne get tmaPlan 13 1
ret gtFail 27
end
gtWrt gtPos2
gtNum get tmaPlan 6
gtWrt gtSm
gtNum get tmaPlan 1
gtWrt gtRg
gtNum get tmaPlan 7
gtWrt gtOv
gtNum get tmaPlan 9
gtWrt gtStg
gtNum get tmaPlan 10
gtWrt gtHaz
gtNum get tmaPlan 8
gtWrt gtQmd
gtNum get tmaPlan 13
gtWrt gtNl
gtAddChk 8
ret 0
end

note ---- Negative Controls 1..3: SMEM Overflow, Register Budget Overflow, Missing Scoreboard Wait ----
fn gtTestNegContracts to int
note NegCtrl 1: SMEM overflow (BF16 tile 128x128x128 x 3 stages > 101376 B) -> refused pre-emit!
tmaSetGraph TID_SM121 TMA_MODE_BF16_HMMA 256 256 256 128
tmaSetGraph2 128 128 3 4 64 128
tmaSetGraph3 TMA_FUSE_SCALE 0 4096
if ne tmaLowerAndEmit TMA_ERR_SMEM
ret gtFail 30
end
if ne get tmaPlan 13 0
ret gtFail 31
end
gtAddCtrl 1
note NegCtrl 2: Register budget overflow (nRegs=160 > 128 AND R62 in 64-reg kernel!)
tmaSetGraph TID_SM121 TMA_MODE_NVFP4_OMMA 128 64 256 64
tmaSetGraph2 64 64 2 4 160 128
tmaSetGraph3 TMA_FUSE_SCALE 0 4096
if ne tmaLowerAndEmit TMA_ERR_REGS
ret gtFail 32
end
if ne get tmaPlan 13 0
ret gtFail 33
end
note Also test R62 hardware ceiling violation in 64-reg buffer verification
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaLit 62 7
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
if ne tmaVerifyBuffer get tmaPc 0 64 false TMA_ERR_REGS
ret gtFail 34
end
gtAddCtrl 1
note NegCtrl 3: Missing scoreboard wait barrier -> strip wait mask from valid lowered kernel!
tmaSetGraph TID_SM121 TMA_MODE_NVFP4_OMMA 128 64 256 64
tmaSetGraph2 64 64 2 4 64 128
tmaSetGraph3 TMA_FUSE_SCALE 1 4096
if ne tmaLowerAndEmit TMA_OK
ret gtFail 35
end
cnt = get tmaPc 0
clrMask = not shl ulong 63 20
for pc ulong cnt bound 2048
idx = add mul pc 4 3
put tmaCode idx and get tmaCode idx clrMask
end
if ne tmaVerifyBuffer cnt 64 true TMA_ERR_HAZARD
ret gtFail 36
end
gtAddCtrl 1
note NegCtrl 12: Non-GPU TargetDesc (TID_X925 CPU) refused pre-emit with TMA_ERR_TARGET!
tmaSetGraph TID_X925 TMA_MODE_NVFP4_OMMA 128 64 256 64
tmaSetGraph2 64 64 2 4 64 128
tmaSetGraph3 TMA_FUSE_SCALE 0 4096
if ne tmaLowerAndEmit TMA_ERR_TARGET
ret gtFail 37
end
if ne get tmaPlan 13 0
ret gtFail 38
end
gtAddCtrl 1
gtAddChk 8
ret 0
end

note ---- Negative Controls 4..7: Antibodies #13, #14, #15, #16 ----
fn gtTestNegAb13to16 to int
note Build clean 12-insn kernel containing BRA target (#13), ALU RAW (#14), I2FP (#15), STG anchor (#16)
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaOp 7 4 TMA_QZ TMA_QZ 856 tmaCw 4 2 7 0 1
tmaOp 5 0 TMA_QZ TMA_QZ 896 tmaCw 4 0 7 0 1
tmaOp 3 14 TMA_QZ TMA_QZ 33 tmaCw 4 0 7 0 1
tmaWait 7
mTop = get tmaPc 0
tmaOpImm 8 20 14 TMA_QZ 4 tmaAlu6
tmaOp 14 21 20 14 0 tmaAlu6
tmaOp 38 22 21 TMA_QZ 0 tmaAlu6
tmaOpImm 9 16 21 0 4 tmaAlu6
tmaOp 12 TMA_QZ 16 22 0 tmaCw 4 7 1 0 1
tmaWait 2
tmaOp 28 TMA_QZ 20 14 0 tmaCmp14
put tmaGuard 0 2
tmaOp 46 TMA_QZ TMA_QZ TMA_QZ sub mTop get tmaPc 0 tmaAlu6
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cnt = get tmaPc 0
if not g2LoadFromTma cnt
ret gtFail 40
end
if ne g2VerifyAntibody17 cnt TMA_OK
ret gtFail 41
end
note NegCtrl 4 (Antibody #13): swap BRA target leader (mTop=4) with pc 5 -> MUST reject TMA_ERR_AB13!
g2ResetCand cnt
g2SwapCand mTop add mTop 1
if ne g2VerifyAntibody17 cnt TMA_ERR_AB13
ret gtFail 42
end
gtAddCtrl 1
note NegCtrl 5 (Antibody #14): shave ALU RAW span (pc 4 -> pc 5) from 6 to 5 -> MUST reject TMA_ERR_AB14!
g2ResetCand cnt
g2SetCndStall mTop 5
if ne g2VerifyAntibody17 cnt TMA_ERR_AB14
ret gtFail 43
end
gtAddCtrl 1
note NegCtrl 6 (Antibody #15): shave I2FP (pc 6, op 581, nm=29) stall from 6 to 3 -> MUST reject TMA_ERR_AB15!
g2ResetCand cnt
g2SetCndStall add mTop 2 3
if ne g2VerifyAntibody17 cnt TMA_ERR_AB15
ret gtFail 44
end
gtAddCtrl 1
note NegCtrl 7 (Antibody #16): zero stall into STG anchor consumer (pc 7 -> pc 8) -> MUST reject TMA_ERR_AB16!
g2ResetCand cnt
g2SetCndStall add mTop 3 0
if ne g2VerifyAntibody17 cnt TMA_ERR_AB16
ret gtFail 45
end
gtAddCtrl 1
gtAddChk 6
ret 0
end

note ---- Negative Control 8: Live G2 Multi-Swap Kernel -> Passes Legacy Monk, Caught & Shrunk to 1 Swap! ----
fn gtBuildG2SwigluKernel to ulong
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaOp 7 4 TMA_QZ TMA_QZ 856 tmaCw 4 2 7 0 1
tmaOp 5 0 TMA_QZ TMA_QZ 896 tmaCw 4 0 7 0 1
tmaOp 3 14 TMA_QZ TMA_QZ 33 tmaCw 4 0 7 0 1
tmaOp 3 15 TMA_QZ TMA_QZ 37 tmaCw 4 0 7 0 1
tmaWait 7
note 4 harmless independent pre-pairs (4 swaps before the bug -> tests binary search!)
tmaLit 30 11
tmaLit 31 22
tmaLit 32 33
tmaLit 33 44
tmaLit 34 55
tmaLit 35 66
tmaLit 36 77
tmaLit 37 88
note Exact qSwiglu9Fast (om/gpu/q36/emit_fast.om lines 1901-1904) multi-consumer triple!
note   u:  IMAD R20, R15, 256, R14  (stall=6)
note   v1: SHF.R R21, R20, 9        (stall=6, reads R20)
note   v2: LOP3.AND R22, R20, 511   (stall=6, reads R20)
note   c:  IMAD R23, R21, 1024, R22 (stall=6)
tmaOpImm 8 20 15 14 256 tmaAlu6
tmaOp 17 21 20 TMA_QZ 9 tmaAlu6
tmaOp 18 22 20 TMA_QZ 511 tmaAlu6
tmaOpImm 8 23 21 22 1024 tmaAlu6
note 2 more harmless post-pairs (2 swaps after the bug -> total 7 swaps!)
tmaLit 38 99
tmaLit 39 101
tmaLit 40 102
tmaLit 41 103
tmaOpImm 9 16 23 0 4 tmaAlu6
tmaOp 12 TMA_QZ 16 23 0 tmaCw 4 7 1 0 1
tmaWait 2
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
ret get tmaPc 0
end

fn gtTestNegG2Shrink to int
cnt = gtBuildG2SwigluKernel
if not g2LoadFromTma cnt
ret gtFail 50
end
if not g2DeltaShrink cnt
ret gtFail 51
end
note Must start with >= 5 swaps, shrink to 1 swap, pass legacy Monk (0), fail Antibody #17a (171) with cnd_cyc=1!
if lt get g2ShrinkOut 1 5
ret gtFail 52
end
if ne get g2ShrinkOut 2 1
ret gtFail 53
end
if ne get g2ShrinkOut 5 0
ret gtFail 54
end
if ne get g2ShrinkOut 6 TMA_ERR_AB17_RAW
ret gtFail 55
end
if ne get g2ShrinkOut 11 1
ret gtFail 56
end
gtPrintShrinkSummary
gtAddCtrl 1
gtAddChk 7
ret 0
end

note ---- Negative Controls 9..11: Antibody #17b (HMMA/OMMA), #17c (SEL & Cross-Anchor), #17d (Multi-rbar) ----
fn gtTestNegAb17bcd to int
note NegCtrl 9a (Antibody #17b HMMA): 2 back-to-back HMMA on R24 with stall=16 (< 22) -> passes legacy, caught 172!
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaOp4 16 24 40 44 24 tmaCw 12 7 7 0 0
tmaOp 0 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 10 7 7 0 0
tmaOp4 16 24 40 44 24 tmaCw 10 7 7 0 0
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cntH = get tmaPc 0
if not g2LoadFromTma cntH
ret gtFail 60
end
g2SetCndStall 0 6
if ne g2LegacyMonkVerify cntH 0
ret gtFail 61
end
if ne g2VerifyAntibody17 cntH TMA_ERR_AB17_MMA
ret gtFail 62
end
note NegCtrl 9b (Antibody #17b OMMA): OMMA.SF.16864 acc-RAW shaved to 20 (< 29) -> caught 172!
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaEmitOmma 24 40 44 46 47 15
tmaOp 0 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 14 7 7 0 0
tmaEmitOmma 24 40 44 46 47 15
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cntO = get tmaPc 0
if not g2LoadFromTma cntO
ret gtFail 63
end
g2SetCndStall 0 6
if ne g2VerifyAntibody17 cntO TMA_ERR_AB17_MMA
ret gtFail 64
end
gtAddCtrl 1
note NegCtrl 10a (Antibody #17c SEL): moving predicate-reading SEL (op 520, guard=7) -> passes legacy, caught 173!
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaLit 10 1
tmaLit 11 2
tmaOp4 35 12 10 11 0 tmaAlu6
tmaLit 13 3
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cntS = get tmaPc 0
if not g2LoadFromTma cntS
ret gtFail 65
end
g2SwapCand 2 3
if ne g2LegacyMonkVerify cntS 0
ret gtFail 66
end
if ne g2VerifyAntibody17 cntS TMA_ERR_AB17_ANCHOR
ret gtFail 67
end
note NegCtrl 10b (Antibody #17c Cross-Anchor): jumping non-anchor across BAR.SYNC while keeping BAR fixed -> caught 173!
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaLit 10 1
tmaLit TMA_QZ 2
tmaOp 48 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
tmaLit 12 3
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cntX = get tmaPc 0
if not g2LoadFromTma cntX
ret gtFail 68
end
g2SwapCand 1 3
if ne g2LegacyMonkVerify cntX 0
ret gtFail 69
end
if ne g2VerifyAntibody17 cntX TMA_ERR_AB17_ANCHOR
ret gtFail 70
end
gtAddCtrl 1
note NegCtrl 11 (Antibody #17d Multi-Barrier rbar Collapse):
note LDG (wb=0, rbar=1) + STG (rbar=2) share addr R16:17; wait ONLY rbar=1 (wait=2), then overwrite R16!
note Legacy hxStepHazard collapses rbar[16] to 0 and PASSES; Antibody #17d exact 64-bit tracker CATCHES (174)!
put tmaPc 0 0
put tmaGuard 0 0
put tmaErr 0 0
tmaOp 7 4 TMA_QZ TMA_QZ 856 tmaCw 4 2 7 0 1
tmaOp 5 16 TMA_QZ TMA_QZ 896 tmaCw 4 0 7 0 1
tmaWait 7
tmaOp 11 20 16 TMA_QZ 0 tmaCw 2 0 1 0 1
tmaOp 12 TMA_QZ 16 21 0 tmaCw 4 7 2 0 1
tmaWait 2
tmaLit 16 99
tmaWait 63
tmaOp 45 TMA_QZ TMA_QZ TMA_QZ 0 tmaCw 6 7 7 0 0
cntR = get tmaPc 0
if not g2LoadFromTma cntR
ret gtFail 71
end
if ne g2LegacyMonkVerify cntR 0
ret gtFail 72
end
if ne g2VerifyAntibody17 cntR TMA_ERR_AB17_RBAR
ret gtFail 73
end
gtAddCtrl 1
gtAddChk 14
ret 0
end

note ---- CLI Mode: `--shrink <file.bin>` runs G2 delta-shrinker on any real SM121 SASS binary ----
fn gtRunShrinkFile to int
k = argread 2 gtPath 0 1023
if lt k 1
ret 90
end
fd = fopen gtPath 0 ulong k 0 0
if lt fd 0
ret 91
end
tot = ulong 0
buf = new uchar 256 0
while lt tot 32768 bound 256
r = read int fd buf 0 256
if le r 0
break
end
for i ulong ulong r bound 256
put g2RawBuf add tot i get buf i
end
tot = add tot ulong r
end
z = fclose int fd
cnt = g2LoadFromRaw tot
if eq cnt 0
ret 92
end
if g2DeltaShrink cnt
gtWrt gtFileA
w = write 1 gtPath 0 ulong k
gtWrt gtNl
gtPrintShrinkSummary
ret 0
end
gtWrt gtFileNo
w = write 1 gtPath 0 ulong k
gtWrt gtNl
ret 0
end

fn main to int
tdInitAll
if eq argcnt 3
al = argread 1 gtPath 0 32
if and eq al 8 and eq get gtPath 0 45 eq get gtPath 2 115
ret gtRunShrinkFile
end
end
gtWrt gtHdr
put gtChk 0 0
put gtCtrl 0 0
r = gtTestPosNvfp4
if ne r 0
ret r
end
r = gtTestPosBf16
if ne r 0
ret r
end
r = gtTestNegContracts
if ne r 0
ret r
end
r = gtTestNegAb13to16
if ne r 0
ret r
end
r = gtTestNegG2Shrink
if ne r 0
ret r
end
r = gtTestNegAb17bcd
if ne r 0
ret r
end
gtWrt gtCtrlPass
gtWrt gtDoneA
gtNum get gtChk 0
gtWrt gtDoneB
gtNum get gtCtrl 0
gtWrt gtNl
ret 0
end

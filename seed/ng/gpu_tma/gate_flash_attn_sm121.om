fn gfTestParity to int
gfAvReset
gfAvPushArg 1
gfAvPushLit gfParity
rc = gfExec
if ne rc 0
ret gfFail 30 rc
end
gfWrt gfPos3
put gfChk 0 add get gfChk 0 2
put gfCtrl 0 add get gfCtrl 0 1
ret 0
end

fn gfTestNegBudgets to int
note [NEG-1] L2 overflow: BF16 seq=16384 hd=128 nh=8 -> 64 MiB > 24 MiB -> MUST refuse rc=13!
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf16384
gfAvPushLit gf128
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
r1 = gfExec
if ne r1 13
ret gfFail 41 r1
end
gfWrt gfNeg1
note [NEG-2] SMEM overflow: BF16 seq=2048 hd=128 nh=8 br=128 bc=128 -> ~174 KiB > 99 KiB -> MUST refuse rc=14!
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf128
gfAvPushLit gf8
gfAvPushLit gf128
gfAvPushLit gf128
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
r2 = gfExec
if ne r2 14
ret gfFail 42 r2
end
gfWrt gfNeg2
note [NEG-3] 6 invalid QMD dimension cases -> all MUST refuse rc=12!
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf64
gfAvPushLit gf8
gfAvPushLit gf0
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 43 1
end
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf64
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf0
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 44 1
end
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf0
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 45 1
end
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf320
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 46 1
end
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf64
gfAvPushLit gf0
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 47 1
end
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf64
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4100
gfAvPushScr gfF_tmp_s
gfAvPushScr gfF_tmp_q
if ne gfExec 12
ret gfFail 48 1
end
gfWrt gfNeg3
put gfCtrl 0 add get gfCtrl 0 8
ret 0
end

fn gfShaveFirstOp n ulong wantOp ulong newSt ulong to bool
for pc ulong n bound 2048
w0 = gfRdU32Buf mul pc 16
if eq and w0 4095 wantOp
w3o = add mul pc 16 12
w3 = gfRdU32Buf w3o
nw3 = or and w3 not shl ulong 15 9 shl newSt 9
gfWrU32Mut w3o nw3
ret true
end
end
ret false
end

note Find first instruction with matching 12-bit opcode, shave its stall to newSt, re-sign, check monk_check == 17!
fn gfTestShaveOp sassF view uchar * wantOp ulong newSt ulong stepId ulong to int
slen = gfReadFile sassF 0 32768
if lt slen 16
ret gfFail stepId 99
end
us = ulong slen
for i ulong us bound 32768
put gfMut i get gfBuf i
end
if not gfShaveFirstOp div us 16 wantOp newSt
ret gfFail stepId 98
end
zlen = gfBuildIdCert us true
if not gfWriteFile gfF_mut_s 0 us
ret gfFail stepId 97
end
if not gfWriteFile gfF_mut_c 1 zlen
ret gfFail stepId 96
end
gfMonkInit
gfAvPushScr sassF
gfAvPushScr gfF_mut_s
gfAvPushScr gfF_mut_c
mrc = gfExec
if ne mrc 17
ret gfFail stepId mrc
end
ret 0
end

note Drop wait-barrier mask on all wait NOPs in emitted SASS -> monk_check MUST catch rc=17!
fn gfTestDropWait sassF view uchar * stepId ulong to int
slen = gfReadFile sassF 0 32768
if lt slen 16
ret gfFail stepId 99
end
us = ulong slen
n = div us 16
for i ulong us bound 32768
put gfMut i get gfBuf i
end
for pc ulong n bound 2048
w3o = add mul pc 16 12
w3 = gfRdU32Buf w3o
nw3 = and w3 not shl ulong 63 20
gfWrU32Mut w3o nw3
end
zlen = gfBuildIdCert us true
if not gfWriteFile gfF_mut_s 0 us
ret gfFail stepId 97
end
if not gfWriteFile gfF_mut_c 1 zlen
ret gfFail stepId 96
end
gfMonkInit
gfAvPushScr sassF
gfAvPushScr gfF_mut_s
gfAvPushScr gfF_mut_c
mrc = gfExec
if ne mrc 17
ret gfFail stepId mrc
end
ret 0
end

fn gfTestNegAntibody17 to int
note [NEG-4] Shave HMMA.16816 (op 572) stall 12 -> 4 (span 14 < 22, >= 6) in emitted BF16 FA2 SASS -> rc=17
r4 = gfTestShaveOp gfF_bf16_s 572 4 51
if ne r4 0
ret r4
end
gfWrt gfNeg4
note [NEG-5] Shave OMMA.SF.16864 (op 1151) stall 15 -> 4 (span 18 < 29, >= 6) in emitted NVFP4 FA2 SASS -> rc=17
r5 = gfTestShaveOp gfF_nv4_s 1151 4 52
if ne r5 0
ret r5
end
gfWrt gfNeg5
note [NEG-6] Drop wait-barrier mask in emitted BF16 FA2 SASS -> rc=17
r6 = gfTestDropWait gfF_bf16_s 53
if ne r6 0
ret r6
end
gfWrt gfNeg6
put gfCtrl 0 add get gfCtrl 0 3
ret 0
end

fn main to int
if ne argcnt 5
gfWrt gfUse
ret 90
end
sn = argread 4 gfScr 0 2000
if lt sn 1
ret 90
end
put gfScrN 0 ulong sn
u = makedir gfScr 0 ulong sn 448
shInitK
put gfChk 0 0
put gfCtrl 0 0
gfWrt gfHdr
r1 = gfTestPosBf16
if ne r1 0
ret r1
end
r2 = gfTestPosNvfp4
if ne r2 0
ret r2
end
r3 = gfTestParity
if ne r3 0
ret r3
end
r4 = gfTestNegBudgets
if ne r4 0
ret r4
end
r5 = gfTestNegAntibody17
if ne r5 0
ret r5
end
gfWrt gfPassA
gfNum get gfChk 0
gfWrt gfPassB
gfNum get gfCtrl 0
gfWrt gfPassC
ret 0
end

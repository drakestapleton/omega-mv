ret gfFail 23 ulong slen
end
if not gfAuditEmittedSass div ulong slen 16 1151 29
ret gfFail 27 1
end
zlen = gfBuildIdCert ulong slen false
if not gfWriteFile gfF_nv4_c 1 zlen
ret gfFail 24 1

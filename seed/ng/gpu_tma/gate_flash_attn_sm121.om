fn shExpand blk ulong to void
for i ulong 16
o = add blk mul i 4
v = shl uint get shDat o 24
v = or v shl uint get shDat add o 1 16
v = or v shl uint get shDat add o 2 8
v = or v uint get shDat add o 3
put shW i v
end
for i ulong 48
k = add i 16
w15 = get shW sub k 15
s0 = xor xor shRor w15 7 shRor w15 18 shr w15 3
w2 = get shW sub k 2
s1 = xor xor shRor w2 17 shRor w2 19 shr w2 10
put shW k add add add get shW sub k 16 s0 get shW sub k 7 s1
end
end

fn shRound i ulong to void
e = get shV 4
s1 = xor xor shRor e 6 shRor e 11 shRor e 25
ch = xor and e get shV 5 and not e get shV 6
t1 = add add add add get shV 7 s1 ch get shK i get shW i
a = get shV 0
s0 = xor xor shRor a 2 shRor a 13 shRor a 22
b = get shV 1
c = get shV 2
mj = xor xor and a b and a c and b c
t2 = add s0 mj
put shV 7 get shV 6
put shV 6 get shV 5
put shV 5 e
put shV 4 add get shV 3 t1
put shV 3 c
put shV 2 b
put shV 1 a
put shV 0 add t1 t2
end

fn shCompress blk ulong to void
shExpand blk
for i ulong 8
put shV i get shH i
end
for i ulong 64
shRound i
end
for i ulong 8
put shH i add get shH i get shV i
end
end

fn shHash n ulong to void
put shH 0 1779033703
put shH 1 3144134277
put shH 2 1013904242
put shH 3 2773480762
put shH 4 1359893119
put shH 5 2600822924
put shH 6 528734635
put shH 7 1541459225
put shDat n 128
p = add n 1
while ne rem p 64 56 bound 64
put shDat p 0
p = add p 1
end
bits = mul n 8
for i ulong 8
put shDat add p i uchar and shr bits mul sub 7 i 8 255
end
tot = add p 8
blk = ulong 0
while lt blk tot bound 520
shCompress blk
blk = add blk 64
end
for i ulong 8
w = get shH i
put shDig mul i 4 uchar and shr w 24 255
put shDig add mul i 4 1 uchar and shr w 16 255
put shDig add mul i 4 2 uchar and shr w 8 255
put shDig add mul i 4 3 uchar and w 255
end
end

note ==================== SUBPROCESS & FILE HELPERS ====================

fn gfSetPath name view uchar * to ulong
n = get gfScrN 0
for i ulong n bound 2000
put gfPath i get gfScr i
end
put gfPath n 47
n = add n 1
for i ulong len name bound 64
put gfPath add n i get name i
end
ret add n len name
end

fn gfAvReset to void
put gfAp 0 2
put gfAp 1 0
end

fn gfAvPushBytes buf view uchar * n ulong to void
p = get gfAp 0
put gfAv p uchar and n 255
put gfAv add p 1 uchar and shr n 8 255
p = add p 2
for i ulong n bound 4096
put gfAv add p i get buf i
end
put gfAp 0 add p n
put gfAp 1 add get gfAp 1 1
end

fn gfAvPushLit lit view uchar * to void
gfAvPushBytes lit len lit
end

fn gfAvPushArg idx ulong to void
k = argread idx gfPath 0 4095
if lt k 1
exit 91
end
p = get gfAp 0
u = ulong k
put gfAv p uchar and u 255
put gfAv add p 1 uchar and shr u 8 255
p = add p 2
for i ulong u bound 4096
put gfAv add p i get gfPath i
end
put gfAp 0 add p u
put gfAp 1 add get gfAp 1 1
end

fn gfAvPushScr name view uchar * to void
ln = gfSetPath name
p = get gfAp 0
put gfAv p uchar and ln 255
put gfAv add p 1 uchar and shr ln 8 255
p = add p 2
for i ulong ln bound 4096
put gfAv add p i get gfPath i
end
put gfAp 0 add p ln
put gfAp 1 add get gfAp 1 1
end

fn gfExec to ulong
cnt = get gfAp 1
put gfAv 0 uchar and cnt 255
put gfAv 1 uchar and shr cnt 8 255
pid = fork
if lt pid 0
exit 92
end
if eq pid 0
dn = fopen gfDevNull 0 len gfDevNull 2 0
if ge dn 0
d1 = dupfd int dn 1 0
d2 = dupfd int dn 2 0
end
r = execprog gfAv 0 get gfAp 0
exit 127
end
w = waitpid int pid gfSt 0 4 0
ret ulong get gfSt 1
end

fn gfReadFile name view uchar * dst ulong maxb ulong to long
ln = gfSetPath name
fd = fopen gfPath 0 ln 0 0
if lt fd 0
ret long -1
end
tot = ulong 0
while lt tot maxb bound 512
r = read int fd gfIo 0 256
if le r 0
break
end
ur = ulong r
if gt add tot ur maxb
z = fclose int fd
ret long -1
end
for i ulong ur bound 256
b = get gfIo i
if eq dst 0
put gfBuf add tot i b
else
put gfQmd add tot i b
end
end
tot = add tot ur
end
z = fclose int fd
ret long tot
end

fn gfWriteFile name view uchar * src ulong n ulong to bool
ln = gfSetPath name
fd = fopen gfPath 0 ln 577 420
if lt fd 0
ret false
end
pos = ulong 0
while lt pos n bound 512
ch = sub n pos
if gt ch 256
ch = ulong 256
end
for i ulong ch bound 256
if eq src 0
put gfIo i get gfMut add pos i
else
put gfIo i get gfCert add pos i
end
end
r = write int fd gfIo 0 ch
if ne r long ch
z = fclose int fd
ret false
end
pos = add pos ch
end
z = fclose int fd
ret true
end

fn gfRdU32Buf o ulong to ulong
a = ulong get gfBuf o
a = or a shl ulong get gfBuf add o 1 8
a = or a shl ulong get gfBuf add o 2 16
ret or a shl ulong get gfBuf add o 3 24
end

fn gfRdU32Qmd wIdx ulong to ulong
o = mul wIdx 4
a = ulong get gfQmd o
a = or a shl ulong get gfQmd add o 1 8
a = or a shl ulong get gfQmd add o 2 16
ret or a shl ulong get gfQmd add o 3 24
end

fn gfWrU32Mut o ulong v ulong to void
put gfMut o uchar and v 255
put gfMut add o 1 uchar and shr v 8 255
put gfMut add o 2 uchar and shr v 16 255
put gfMut add o 3 uchar and shr v 24 255
end

fn gfWrU32Cert o ulong v ulong to void
put gfCert o uchar and v 255
put gfCert add o 1 uchar and shr v 8 255
put gfCert add o 2 uchar and shr v 16 255
put gfCert add o 3 uchar and shr v 24 255
end

note Validate emitted 256-byte Blackwell QMD v05.00 Header
fn gfCheckQmd expVa ulong expGx ulong expGy ulong to bool
if ne gfRdU32Qmd 4 20905984
ret false
end
if ne gfRdU32Qmd 9 3
ret false
end
if ne gfRdU32Qmd 58 271581201
ret false
end
if ne gfRdU32Qmd 32 and shr expVa 4 4294967295
ret false
end
if ne gfRdU32Qmd 59 and shr expVa 8 4294967295
ret false
end
smem = gfRdU32Qmd 36
if or eq smem 0 gt smem 101376
ret false
end
if ne gfRdU32Qmd 39 expGx
ret false
end
if ne gfRdU32Qmd 40 expGy
ret false
end
ret eq gfRdU32Qmd 41 1
end

fn gfBuildIdCert nBytes ulong cndMut bool to ulong
n = div nBytes 16
for i ulong nBytes bound 32768
put shDat i get gfBuf i
end
shHash nBytes
for i ulong 32
put gfRefSha i get shDig i
end
if cndMut
for i ulong nBytes bound 32768
put shDat i get gfMut i
end
shHash nBytes
for i ulong 32
put gfCndSha i get shDig i
end
else
for i ulong 32
put gfCndSha i get gfRefSha i
end
end
put gfCert 0 72
put gfCert 1 88
put gfCert 2 80
put gfCert 3 49
gfWrU32Cert 4 n
for i ulong 32
put gfCert add 8 i get gfRefSha i
put gfCert add 40 i get gfCndSha i
end
for i ulong n bound 2048
gfWrU32Cert add 72 mul i 4 i
end
ret add 72 mul n 4
end

fn gfEmitInit to void
gfAvReset
gfAvPushArg 1
gfAvPushLit gfEmit
end

fn gfMonkInit to void
gfAvReset
gfAvPushArg 2
end

fn gfImmInit to void
gfAvReset
gfAvPushArg 3
gfAvPushArg 2
end

note ==================== POSITIVE & NEGATIVE GATE TESTS ====================

note Direct emitted-SASS structural audit: verify mma_ops==3, stg_ops==1 (0 N x N DRAM spill!),
note and every emitted HMMA(572)/OMMA(1151) has >= 22 / >= 29 stall cycles before next consumer!
fn gfAuditEmittedSass n ulong wantMmaOp ulong wantFloor ulong to bool
mmaCnt = ulong 0
stgCnt = ulong 0
for pc ulong n bound 2048
w0 = gfRdU32Buf mul pc 16
op = and w0 4095
if eq op 2438
stgCnt = add stgCnt 1
end
if eq op wantMmaOp
mmaCnt = add mmaCnt 1
if or eq mmaCnt 1 eq mmaCnt 3
if lt add pc 1 n
st0 = and shr gfRdU32Buf add mul pc 16 12 9 15
st1 = and shr gfRdU32Buf add mul add pc 1 16 12 9 15
if lt add st0 st1 wantFloor
ret false
end
end
end
end
end
if ne mmaCnt 3
ret false
end
ret eq stgCnt 1
end

fn gfTestPosBf16 to int
gfEmitInit
gfAvPushLit gfBf16
gfAvPushLit gf2048
gfAvPushLit gf64
gfAvPushLit gf8
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_bf16_s
gfAvPushScr gfF_bf16_q
rc = gfExec
if ne rc 0
ret gfFail 10 rc
end
qlen = gfReadFile gfF_bf16_q 1 256
if ne qlen 256
ret gfFail 11 ulong qlen
end
if not gfCheckQmd 4096 32 8
ret gfFail 12 1
end
slen = gfReadFile gfF_bf16_s 0 32768
if or lt slen 512 ne rem ulong slen 16 0
ret gfFail 13 ulong slen
end
if not gfAuditEmittedSass div ulong slen 16 572 22
ret gfFail 17 1
end
zlen = gfBuildIdCert ulong slen false
if not gfWriteFile gfF_bf16_c 1 zlen
ret gfFail 14 1
end
gfMonkInit
gfAvPushScr gfF_bf16_s
gfAvPushScr gfF_bf16_s
gfAvPushScr gfF_bf16_c
mrc = gfExec
if ne mrc 0
ret gfFail 15 mrc
end
gfImmInit
gfAvPushScr gfF_bf16_s
gfAvPushScr gfF_bf16_s
gfAvPushScr gfF_bf16_c
gfAvPushScr gfF_im1
irc = gfExec
if ne irc 0
ret gfFail 16 irc
end
gfWrt gfPos1
gfNum div ulong slen 16
gfWrt gfNl
put gfChk 0 add get gfChk 0 5
ret 0
end

fn gfTestPosNvfp4 to int
gfEmitInit
gfAvPushLit gfNv4
gfAvPushLit gf8192
gfAvPushLit gf64
gfAvPushLit gf16
gfAvPushLit gf64
gfAvPushLit gf64
gfAvPushLit gf4096
gfAvPushScr gfF_nv4_s
gfAvPushScr gfF_nv4_q
rc = gfExec

om2
note SPDX-License-Identifier: Apache-2.0
note seed/ng/gpu_tma/gate_flash_attn_sm121.om: End-to-End Pure-OM Verification Gate for
note Fused L2-Pinned Zero-DRAM-Spill Flash-Attention-2 SM121 SASS + 256-Byte Blackwell QMD
note (verified directly against hardened Antibody #17 monk_check + 16-attack immune + CPU math parity).
note
note Standalone pure seeded OM-2 (zero C, zero Python, zero CUDA, zero `/dev/nvidia*`).
note
note Usage:
note   gate_flash_attn_sm121 FLASH_BIN MONK_BIN IMMUNE_BIN SCRATCH_DIR
note
note Verification coverage:
note   [POS-1] Emit BF16 HMMA.16816 FA2 kernel + 256B Blackwell QMD -> validate QMD -> HXP1 cert ->
note           hardened monk_check PASS (hazards=0) + 16-attack immune PASS (16/16, ab17=4/4)
note   [POS-2] Emit NVFP4 OMMA.SF.16864 FA2 kernel + 256B Blackwell QMD -> validate QMD -> HXP1 cert ->
note           hardened monk_check PASS (hazards=0) + 16-attack immune PASS (16/16, ab17=4/4)
note   [POS-3] Pure-OM CPU Online-Softmax Flash-Attention-2 parity vs naive N x N attention
note           (8 cases: 4 tile geometries x non-causal & causal, <= 1 f32 ULP, + missing-rescale negative control)
note   [NEG-1] L2 overflow (> 24 MiB = 25,165,824 B) -> flash_attn_sm121 refuses fail-closed (rc=13)
note   [NEG-2] SMEM overflow (> 101,376 B) -> flash_attn_sm121 refuses fail-closed (rc=14)
note   [NEG-3] Invalid QMD dimensions (br=0, bc=0, hd=0, hd=320, unaligned code_va, nh=0) -> refused (rc=12)
note   [NEG-4] Injected Antibody #17b MMA stall shave in emitted BF16 HMMA SASS -> monk_check catches (rc=17)
note   [NEG-5] Injected Antibody #17b MMA stall shave in emitted NVFP4 OMMA SASS -> monk_check catches (rc=17)
note   [NEG-6] Injected Antibody #17d wait-barrier drop in emitted FA2 SASS -> monk_check catches (rc=17)

global shDat uchar 32768
global shDig uchar 32
global shH uint 8
global shV uint 8
global shW uint 64
global shK uint 64

global gfBuf uchar 32768
global gfMut uchar 32768
global gfCert uchar 16384
global gfQmd uchar 256
global gfRefSha uchar 32
global gfCndSha uchar 32
global gfScr uchar 2048
global gfScrN ulong 1
global gfPath uchar 4096
global gfIo uchar 256
global gfAv uchar 8192
global gfAp ulong 2
global gfSt uchar 4
global gfDig uchar 24
global gfChk ulong 1
global gfCtrl ulong 1

text gfUse "usage: gate_flash_attn_sm121 FLASH_BIN MONK_BIN IMMUNE_BIN SCRATCH_DIR\n"
text gfHdr "=== FLASH-ATTENTION-2 SM121 L2-PINNED ZERO-SPILL VERIFICATION GATE ===\n"
text gfPos1 "  PASS [POS-1] BF16 HMMA.16816 FA2: qmd=256B valid, monk=PASS(rc=0), immune=16/16(ab17=4/4), insns="
text gfPos2 "  PASS [POS-2] NVFP4 OMMA.SF.16864 FA2: qmd=256B valid, monk=PASS(rc=0), immune=16/16(ab17=4/4), insns="
text gfPos3 "  PASS [POS-3] CPU Online-Softmax FA2 parity vs naive N x N (8 cases + no-rescale neg control)\n"
text gfNeg1 "  PASS [NEG-1] 24 MiB GB10 L2 overflow refused fail-closed (rc=13)\n"
text gfNeg2 "  PASS [NEG-2] 99 KiB SM121 SMEM overflow refused fail-closed (rc=14)\n"
text gfNeg3 "  PASS [NEG-3] Invalid QMD dimensions (6 cases: br/bc/hd/nh/seq/va) refused fail-closed (rc=12)\n"
text gfNeg4 "  PASS [NEG-4] Injected Antibody #17b HMMA(22c) stall shave caught by monk_check (rc=17)\n"
text gfNeg5 "  PASS [NEG-5] Injected Antibody #17b OMMA(29c) stall shave caught by monk_check (rc=17)\n"
text gfNeg6 "  PASS [NEG-6] Injected Antibody #17d wait-barrier drop caught by monk_check (rc=17)\n"
text gfPassA "GATE_FLASH_ATTN_SM121 PASS checks="
text gfPassB " controls="
text gfPassC " evidence=HOST_VERIFIED PHYSICAL_SILICON=NOT_RUN\n"
text gfFailA "GATE_FLASH_ATTN_SM121 FAIL step="
text gfFailB " got_rc="
text gfNl "\n"
text gfDevNull "/dev/null"

text gfEmit "emit"
text gfParity "parity"
text gfBf16 "bf16"
text gfNv4 "nvfp4"
text gf2048 "2048"
text gf8192 "8192"
text gf16384 "16384"
text gf64 "64"
text gf128 "128"
text gf320 "320"
text gf8 "8"
text gf16 "16"
text gf0 "0"
text gf4096 "4096"
text gf4100 "4100"

text gfF_bf16_s "bf16.bin"
text gfF_bf16_q "bf16.qmd"
text gfF_bf16_c "bf16.crt"
text gfF_nv4_s "nv4_.bin"
text gfF_nv4_q "nv4_.qmd"
text gfF_nv4_c "nv4_.crt"
text gfF_mut_s "mut_.bin"
text gfF_mut_c "mut_.crt"
text gfF_im1 "im_bf16_"
text gfF_im2 "im_nv4__"
text gfF_tmp_s "tmp_.bin"
text gfF_tmp_q "tmp_.qmd"

fn gfWrt s view uchar * to void
r = write 1 s 0 len s
end

fn gfNum v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gfDig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write 1 gfDig p sub 24 p
ret
end
end
end

fn gfFail step ulong got ulong to int
gfWrt gfFailA
gfNum step
gfWrt gfFailB
gfNum got
gfWrt gfNl
ret int step
end

note ==================== EMBEDDED FIPS 180-4 SHA-256 ====================

fn shRor x uint n uint to uint
ret or shr x n shl x sub 32 n
end

fn shInitK to void
put shK 0 1116352408
put shK 1 1899447441
put shK 2 3049323471
put shK 3 3921009573
put shK 4 961987163
put shK 5 1508970993
put shK 6 2453635748
put shK 7 2870763221
put shK 8 3624381080
put shK 9 310598401
put shK 10 607225278
put shK 11 1426881987

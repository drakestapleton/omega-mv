fn as_op to void
nd = ulong 0
put w_k 4 0
put w_k 5 0
if eq as_pk 0 37
as_eat 37
put w_k 4 as_dec
nd = 1
if and eq as_pk 0 32 eq as_pk 1 37
as_sp
as_eat 37

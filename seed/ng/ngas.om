note seed/ng/ngas.om: canonical ΩIR text on stdin to the binary on stdout (seed/ng/IR.md s10).
note Owner: ng-ir lane. Build: cat seed/ng/ngtxt.om seed/ng/ngas.om | seed/out/omc > ngas
note ngas reads only the text ngdis prints and checks syntax and numbering only (type, global and
note function numbers in order, defined values numbered in order, the defined values an op row and
note its ty call for, operand counts, const forms); every semantic rule is ngcheck's. Refusal:
note "ngas: syntax error at line N" on stderr and exit 3; input or output over 16 MiB exit 23;
note unreadable input exit 27. Wire ids are written as the text gives them, in range or not.
text w_msg "ngas: syntax error at line \n"
text w_tag "omega.ng.ir.v1"
global w_in uchar 16777216
global w_ob uchar 16777216
global w_s ulong 8
global w_k ulong 8
global w_op uint 128
note w_s: 0 cursor, 1 input end, 2 line number, 3 output length, 4 next value id
fn as_err to void
r = write 2 w_msg 0 27
put x_on 0 0
tx_num get w_s 2
tx_c 10
r = write 2 x_out 0 get x_on 0
exit 3
end
note ---- input ------------------------------------------------------------------------------------
note the byte at the cursor plus d, or 256 past the end
fn as_pk d ulong to ulong
p = add get w_s 0 d
if ge p get w_s 1
ret 256
end
ret ulong get w_in p
end
fn as_eat c ulong to void
if ne as_pk 0 c
as_err
end
put w_s 0 add get w_s 0 1
if eq c 10
put w_s 2 add get w_s 2 1
end
end
fn as_sp to void
as_eat 32
end
fn as_eol to void
as_eat 10
end
fn as_isd c ulong to bool
ret and ge c 48 le c 57
end
note a decimal number without sign, leading zeros or overflow
fn as_dec to ulong
c = as_pk 0
if not as_isd c
as_err
end
if and eq c 48 as_isd as_pk 1
as_err
end
v = ulong 0
while as_isd as_pk 0 bound 21
d = sub as_pk 0 48
if gt v div sub 18446744073709551615 d 10
as_err
end
v = add mul v 10 d
put w_s 0 add get w_s 0 1
end
ret v
end
fn as_dlim m ulong to ulong
v = as_dec
if gt v m
as_err
end
ret v
end
fn as_d32 to ulong
ret as_dlim 4294967295
end
note the end of the token at the cursor (next space, newline, @ or input end)
fn as_tend to ulong
p = get w_s 0
while lt p get w_s 1 bound 16777216
c = get w_in p
if or or eq c 32 eq c 10 eq c 64
ret p
end
p = add p 1
end
ret p
end
note word i of x_kw as the whole token at the cursor; consumed when matched and take
fn as_word i ulong take bool to bool
p = get w_s 0
e = as_tend
n = ulong get x_kwl i
if ne sub e p n
ret false
end
s = ulong get x_kwo i
for j ulong n bound 16
if ne get w_in add p j get x_kw add s j
ret false
end
end
if take
put w_s 0 e
end
ret true
end
fn as_kw i ulong to void
if not as_word i true
as_err
end
end
note one of words lo..hi: its index minus lo
fn as_wsel lo ulong hi ulong to ulong
for i ulong add sub hi lo 1 bound 32
if as_word add lo i true
ret i
end
end
as_err
ret 0
end
note a type: a built-in name, or %tN for any N that has no name
fn as_ty to ulong
if eq as_pk 0 37
as_sp2 37 116
n = as_d32
if le n 20
ck_named n
end
ret n
end
p = get w_s 0
e = as_tend
for t ulong 21
if as_tyis t p e
put w_s 0 e
ret t
end
end
as_err
ret 0
end
fn ck_named n ulong to void
if ne get x_tnl n 1
as_err
end
end
fn as_tyis t ulong p ulong e ulong to bool
n = ulong get x_tnl t
if ne sub e p n
ret false
end
s = ulong get x_tno t
if eq get x_tyn s 45
ret false
end
for j ulong n bound 8
if ne get w_in add p j get x_tyn add s j
ret false
end
end
ret true
end
fn as_sp2 a ulong b ulong to void
as_eat a
as_eat b
end
fn as_hexd to ulong
c = as_pk 0
put w_s 0 add get w_s 0 1
if as_isd c
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
as_err
ret 0
end
fn as_hexn n ulong to ulong
v = ulong 0
for j ulong n bound 16
v = or shl v 4 as_hexd
end
ret v
end
note ---- output -------------------------------------------------------------------------------------
fn as_b k ulong v ulong to void
n = get w_s 3
if gt add n k len w_ob
exit 23
end
for j ulong k bound 8
put w_ob add n j uchar and shr v mul j 8 255
end
put w_s 3 add n k
end
fn as_patch at ulong v ulong to void
for j ulong 4
put w_ob add at j uchar and shr v mul j 8 255
end
end
fn as_here to ulong
ret get w_s 3
end

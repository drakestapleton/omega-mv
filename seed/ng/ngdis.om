note SPDX-License-Identifier: Apache-2.0
note seed/ng/ngdis.om: ΩIR binary on stdin to its one canonical text on stdout (seed/ng/IR.md s10).
note Owner: ng-ir lane. Build: cat seed/ng/ngtxt.om seed/ng/ngdis.om | seed/out/omc > ngdis
note ngdis decodes structure only (it is not the validator): it prints every unit whose bytes the
note text can spell, ids out of range and semantic faults included, and refuses the rest with the
note IR.md s11 class as its exit code and "ngdis: refused class C at OFFSET" on stderr:
note 10 MAGIC, 11 VERSION, 12 TRUNCATED, 13 an enumeration or field the text cannot spell (a type
note kind, access, space, field order, role, global class or function kind outside its set, a
note nonzero ty on a row without one, a non-canonical const), 14 TRAILING, 15 UNKNOWN_OP,
note 23 LIMIT: input over 16777216 bytes (at 16777216), more than 65536 types, globals, functions,
note blocks in a function, or parameters of a function or block (at the count), 27 IO.
text z_msg "ngdis: refused class \n at \n"
global z_in uchar 16777216
global z_s ulong 4
global z_pt uint 65536
global z_k ulong 8
global z_pb uchar 8
fn dz_say a ulong b ulong to void
r = write 2 z_msg a sub b a
end
fn dz_bad c ulong off ulong to void
dz_say 0 21
put x_on 0 0
tx_num c
r = write 2 x_out 0 get x_on 0
dz_say 22 26
put x_on 0 0
tx_num off
tx_c 10
r = write 2 x_out 0 get x_on 0
exit int c
end
fn dz_at to ulong
ret get z_s 0
end
fn dz_need k ulong to ulong
p = get z_s 0
if gt add p k get z_s 1
dz_bad 12 p
end
put z_s 0 add p k
ret p
end
fn dz_un k ulong to ulong
p = dz_need k
v = ulong 0
for j ulong k bound 8
x = ulong get z_in add p j
v = or v shl x mul j 8
end
ret v
end
fn dz_u8 to ulong
ret dz_un 1
end
fn dz_u32 to ulong
ret dz_un 4
end
note a table count (IR.md s12): over 65536 is LIMIT at the count, before what it counts
fn dz_cnt to ulong
o = dz_at
n = dz_u32
if gt n 65536
dz_bad 23 o
end
ret n
end
note ---- header and tables ------------------------------------------------------------------------
fn dz_head to void
n = get z_s 1
for j ulong 7
if ge j n
dz_bad 12 0
end
x = ulong get z_in j
if lt j 6
if ne x dz_magic j
dz_bad 10 0
end
else
if ne x 0
dz_bad 10 0
end
end
end
put z_s 0 7
if ne dz_u8 9
dz_bad 11 7
end
p = dz_need 16
for j ulong 16
if ne ulong get z_in add 8 j dz_tag j
dz_bad 11 8
end
end
end
note magic "OSC1IR" and tag "omega.ng.ir.v1" then two zero bytes
fn dz_magic j ulong to ulong
if eq j 0
ret 79
end
if eq j 1
ret 83
end
if eq j 2
ret 67
end
if eq j 3
ret 49
end
if eq j 4
ret 73
end
ret 82
end
fn dz_tag j ulong to ulong
if ge j 14
ret 0
end
if eq j 0
ret 111
end
if eq j 1
ret 109
end
if eq j 2
ret 101
end
if eq j 3
ret 103
end
if eq j 4
ret 97
end
if or eq j 5 eq j 8
ret 46
end
if eq j 6
ret 110
end
if eq j 7
ret 103
end
if eq j 9
ret 105
end
if eq j 10
ret 114
end
if eq j 11
ret 46
end
if eq j 12
ret 118
end
ret 49
end
fn dz_types to void
n = dz_cnt
for k ulong n bound 16777216
dz_type add k 32
end
end
fn dz_type t ulong to void
o = dz_at
kd = dz_u8
if or eq kd 0 gt kd 6
dz_bad 13 o
end
tx_kw 27
tx_sp
tx_ty t
tx_c 32
tx_c 61
tx_sp
tx_kw add 14 kd
sz = ulong 0
if or eq kd 1 eq kd 2
sz = dz_tva kd
end
if eq kd 3
sz = dz_tstr o
end
if or eq kd 4 eq kd 5
dz_tref o
end
if eq kd 6
dz_tfrg o
end
tx_nl
tx_tset t kd sz
end
note vec E L, array E C; the entry's byte size
fn dz_tva kd ulong to ulong
e = dz_u32
c = dz_u32
tx_sp
tx_ty e
tx_sp
tx_num c
ret tx_mul c tx_size e
end
fn dz_tstr o ulong to ulong
sz = dz_u32
nf = dz_u32
tx_sp
tx_num sz
for j ulong nf bound 16777216
ft = dz_u32
of = dz_u32
od = dz_u8
if gt od 1
dz_bad 13 o
end
tx_sp
tx_ty ft
tx_c 64
tx_num of
tx_c 58
tx_kw add 13 od
end
ret sz
end
fn dz_tref o ulong to void
x = dz_u32
ac = dz_u8
sp = dz_u8
if or gt ac 1 gt sp 4
dz_bad 13 o
end
tx_sp
tx_kw add 3 ac
tx_sp
tx_kw add 5 sp
tx_sp
tx_ty x
end
fn dz_tfrg o ulong to void
ro = dz_u8
if gt ro 2
dz_bad 13 o
end
tx_sp
tx_kw add 10 ro
for j ulong 3
tx_sp
tx_num dz_un 2
end
tx_sp
tx_ty dz_u32
end
fn dz_globs to void
n = dz_cnt
for g ulong n bound 16777216
dz_glob g
end
end
fn dz_glob g ulong to void
o = dz_at
t = dz_u32
c = dz_u8
if gt c 1
dz_bad 13 o
end
tx_kw 6
tx_c 32
tx_c 64
tx_c 103
tx_num g
tx_sp
tx_ty t
tx_sp
tx_kw add 21 c
if eq c 1
n = tx_size t
p = dz_need n
if gt n 0
tx_sp
end
for j ulong n bound 1099511627776
tx_hexn ulong get z_in add p j 2
end
end
tx_nl
end
note ---- functions ------------------------------------------------------------------------------
fn dz_funcs to void
n = dz_cnt
for f ulong n bound 16777216
dz_fn f
end
end
fn dz_fn f ulong to void
o = dz_at
k = dz_u8
fl = dz_u8
if gt k 2
dz_bad 13 o
end
po = dz_at
np = dz_u32
if gt np 65536
dz_bad 23 po
end
for j ulong np bound 65536
put z_pt j uint dz_u32
end
rs = dz_u32
tx_kw k
tx_c 32
tx_c 64
tx_c 102
tx_num f
tx_sp
tx_kw 23
tx_sp
tx_num fl
if eq k 1
dz_kern
end
for j ulong np bound 65536
tx_sp
tx_val add j 1
tx_c 58
tx_ty ulong get z_pt j
end
tx_c 32
tx_c 45
tx_c 62
tx_sp
tx_ty rs
tx_nl
put z_k 0 add np 1
nb = dz_cnt
for j ulong nb bound 16777216
dz_blk j
end
tx_kw 28
tx_nl
end
fn dz_kern to void
tx_sp
tx_kw 24
for j ulong 3
tx_sp
tx_num dz_u32
end
tx_sp
tx_kw 25
tx_sp
tx_num dz_u8
end
fn dz_blk j ulong to void
tx_kw 26
tx_sp
tx_c 94
tx_num j
np = dz_cnt
for k ulong np bound 16777216
tx_sp
v = get z_k 0
tx_val v
put z_k 0 add v 1
tx_c 58
tx_ty dz_u32
end
tx_nl
n = dz_u32
for k ulong n bound 16777216
dz_op
end
end
fn dz_op to void
o = dz_at
op = dz_u8
if eq get x_rok op 0
dz_bad 15 o
end
t = dz_u32
c = ulong get x_rty op
if and eq c 0 ne t 0
dz_bad 13 o
end
m = ulong 0
if ne get x_rim op 0
m = dz_un 8
end
if and eq op 1 not tx_canon t m
dz_bad 13 o
end
n = ulong 0
if ne get x_rva op 0
n = dz_u32
end
dz_defs op t
tx_rname op
if ne c 0
tx_sp
tx_ty t
end
if ne get x_rim op 0
tx_sp
dz_imm op t m
end
k = add add tx_ntok op ulong get x_rfx op n
for s ulong k bound 16777216
tx_sp
dz_opnd op s dz_u32
end
tx_nl
end
fn dz_defs op ulong t ulong to void
d = tx_ndef op t
if eq d 0
ret
end
v = get z_k 0
tx_val v
if eq d 2
tx_sp
tx_val add v 1
end
tx_sp
tx_c 61
tx_sp
put z_k 0 add v d
end
fn dz_imm op ulong t ulong m ulong to void
if eq op 52
tx_c 64
tx_c 103
tx_num m
ret
end
if ne op 1
tx_num m
ret
end
f = tx_cf t
if eq f 1
tx_kw sub 31 m
ret
end
if eq f 4
tx_c 48
tx_c 120
tx_hexn m mul tx_sb t 2
ret
end
if and eq f 3 ne shr m 63 0
tx_c 45
tx_num sub 0 m
ret
end
tx_num m
end
fn dz_opnd op ulong s ulong v ulong to void
k = tx_slot op s
if eq k 1
tx_c 94
tx_num v
ret
end
if eq k 2
tx_c 64
tx_c 102
tx_num v
ret
end
tx_val v
end
fn main to int
tx_init
n = ulong 0
while lt n len z_in bound 16777217
k = read 0 z_in n sub len z_in n
if lt k 0
dz_bad 27 n
end
if eq k 0
break
end
n = add n ulong k
end
if eq n len z_in
k = read 0 z_pb 0 1
if lt k 0
dz_bad 27 n
end
if gt k 0
dz_bad 23 n
end
end
put z_s 1 n
dz_head
tx_kw 29
tx_sp
tx_c 49
tx_nl
dz_types
dz_globs
dz_funcs
if lt dz_at n
dz_bad 14 dz_at
end
tx_flush
ret 0
end

pp = <|"arith"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"branch"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"leafcall"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"fib38"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"fib40"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"isort"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"sieve"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"sort"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}},"matmul"->{{"ngS","ngA"},{"ngT","ngA"},{"ngT","ngS"},{"ngA","omc"},{"ngS","gccO2"},{"ngT","gccO2"},{"ngA","gccO2"}}|>;

ci[x_] := With[{s = Sort[x], n = Length[x]}, If[n < 21, {If[n == 0, "NA", Median[x]], "NA", "NA", n},
  With[{k = Max[Select[Range[1, 15], CDF[BinomialDistribution[n, 1/2], # - 1] <= 0.025 &]]}, {Median[x], s[[k]], s[[n + 1 - k]], n}]]];
bl[c_] := Keys[d[{c, "ngA"}]];
cl[c_] := Select[bl[c], ! MemberQ[cont, {#, c}] &];
rat[c_, a_, b_, bb_] := N[Table[Total[d[{c, a}][k]]/Total[d[{c, b}][k]], {k, bb}]];
fmt[v_] := If[NumberQ[v], ToString[NumberForm[v, {5, 4}]], ToString[v]];
rows = Flatten[Table[Join[{c, p[[1]] <> "/" <> p[[2]]}, fmt /@ ci[rat[c, p[[1]], p[[2]], bl[c]]], fmt /@ ci[rat[c, p[[1]], p[[2]], cl[c]]]], {c, Keys[pp]}, {p, pp[c]}], 1];
tsv = ExportString[rows, "TSV"];

med[c_, a_, b_] := Median[rat[c, a, b, cl[c]]];
gm = Table[p[[1]] <> "/" <> p[[2]] -> If[AllTrue[Keys[pp], Length[cl[#]] >= 21 &], N[GeometricMean[Table[med[c, p[[1]], p[[2]]], {c, Keys[pp]}]], 5], "NA"], {p, pp[First[Keys[pp]]]}];
verdict[c_, a_, b_] := With[{v = ci[rat[c, a, b, cl[c]]]}, If[v[[2]] === "NA", "CONTENDED", If[v[[3]] < 1, "FASTER", If[v[[2]] > 1, "SLOWER", "NO DIFFERENCE"]]]];
aaok[c_] := With[{v = ci[rat[c, "ngA", "omc", cl[c]]]}, If[v[[2]] === "NA", "CONTENDED", v[[2]] <= 1 <= v[[3]] || 0.99 <= v[[1]] <= 1.01]];
{"tsv" -> tsv, "geomean of clean medians" -> gm, "verdicts {case, ngS vs ngA, ngT vs ngA, ngT vs ngS}" -> Table[{c, verdict[c, "ngS", "ngA"], verdict[c, "ngT", "ngA"], verdict[c, "ngT", "ngS"]}, {c, Keys[pp]}], "A/A pass per case" -> Table[c -> aaok[c], {c, Keys[pp]}], "clean blocks per case" -> Table[c -> Length[cl[c]], {c, Keys[pp]}], "busy pairs" -> Length[busyl], "contaminated pairs" -> Length[contl]}

cont = {{21,"fib40"}};

cases = {"fib38"};
pairs = {{"ngA","omc"},{"ngB","omc"},{"ngD","omc"},{"ngE","omc"},{"ngD","ngA"},{"omc","gccO2"},{"ngA","gccO2"},{"ngD","gccO2"},{"ngE","gccO2"}};
dsel = r;

ci[x_] := With[{s = Sort[x], n = Length[x]}, If[n < 21, {Median[x], "NA", "NA", n},
  With[{k = Max[Select[Range[1, 15], CDF[BinomialDistribution[n, 1/2], # - 1] <= 0.025 &]]}, {Median[x], s[[k]], s[[n + 1 - k]], n}]]];
bl[c_] := Keys[dsel[{c, pairs[[1, 1]]}]];
cl[c_] := Select[bl[c], ! MemberQ[cont, {#, c}] &];
rat[c_, a_, b_, bb_] := N[Table[Total[dsel[{c, a}][k]]/Total[dsel[{c, b}][k]], {k, bb}]];
fmt[v_] := If[NumberQ[v], ToString[NumberForm[v, {5, 4}]], ToString[v]];
rows = Flatten[Table[Join[{c, p[[1]] <> "/" <> p[[2]]}, fmt /@ ci[rat[c, p[[1]], p[[2]], bl[c]]], fmt /@ ci[rat[c, p[[1]], p[[2]], cl[c]]]], {c, cases}, {p, pairs}], 1];
ExportString[rows, "TSV"]

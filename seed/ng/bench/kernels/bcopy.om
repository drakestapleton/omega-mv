note bench twin: 8000 reversed byte copies of a 64 KiB pattern, each xored with the round number
global src uchar 65536
global dst uchar 65536
fn main to int
for i ulong 65536
put src i uchar and mul i 7 255
end
for r ulong 8000
k = uchar and r 255
for i ulong 65536
put dst sub 65535 i xor get src i k
end
end
w = write 1 dst 0 65536
ret 0
end

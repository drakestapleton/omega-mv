note Radicle CI v1 boundary. Compose after seed/json/json.om with om2.
note The trusted caller supplies an immutable admission context; events grant no authority.
note No queue, journal, release decision or success response is implemented here.
note Optional host executable receives the bound ticket on stdin via execprog.
text kreq "request"
text kver "version"
text kevt "event_type"
text krepo "repository"
text kid "id"
text kpatch "patch"
text kstate "state"
text kstatus "status"
text kaction "action"
text kafter "after"
text kcommits "commits"
text krevs "revisions"
text koid "oid"
text kbase "base"
text krid "rid"
text krev "revision"
text kcand "candidate"
text ktool "toolchain"
text ktask "task"
text katt "attempt"
text kgen "generation"
text kpolicy "policy"
text strigger "trigger"
text spatch "patch"
text sopen "open"
text sactive "active"
text screated "Created"
text supdated "Updated"
text ophead "{\"schema\":\"radicle-queen-ticket-v1\""
text opkey ",\""
text opsep "\":\""
text opend "\""
text opfinish "}\n"

fn rc_get s view uchar 65536 t view uint 65536 obj ulong key view uchar * to ulong
if ne js_type t obj jsobj
ret jsnone
end
v = jsnone
k = js_first t obj
while ne k jsnone bound 16384
if js_streq s js_off t k key
if ne v jsnone
exit 21
end
v = add k 1
end
k = js_mnext t k
end
ret v
end

fn rc_eq s view uchar 65536 t view uint 65536 v ulong want view uchar * to bool
if ne js_type t v jsstr
ret false
end
ret js_streq s js_off t v want
end

fn rc_char c uchar hx ulong to bool
ok = and ge c 48 le c 57
if ne hx 0
ret or ok and ge c 97 le c 102
end
ok = or ok and ge c 65 le c 90
ok = or ok and ge c 97 le c 122
ok = or ok or eq c 45 eq c 46
ret or ok or eq c 58 eq c 95
end

fn rc_field s view uchar 65536 t view uint 65536 key view uchar * ob edit uchar 128 hx ulong to ulong
v = rc_get s t 0 key
if ne js_type t v jsstr
exit 22
end
n = js_sget s js_off t v ob
if or le n 0 gt n 128
exit 22
end
if and ne hx 0 ne ulong n hx
exit 22
end
for i ulong ulong n
c = get ob i
ok = rc_char c hx
if not ok
exit 22
end
end
ret ulong n
end

fn rc_same a view uchar * an ulong b view uchar * bn ulong to bool
if ne an bn
ret false
end
for i ulong an
if ne get a i get b i
ret false
end
end
ret true
end

fn rc_equal s view uchar 65536 t view uint 65536 v ulong c view uchar 65536 ct view uint 65536 cv ulong to bool
if or ne js_type t v jsstr ne js_type ct cv jsstr
exit 22
end
a = new uchar 128 0
b = new uchar 128 0
an = js_sget s js_off t v a
bn = js_sget c js_off ct cv b
if or lt an 0 lt bn 0
exit 22
end
ret rc_same a ulong an b ulong bn
end

fn rc_bind s view uchar 65536 t view uint 65536 v ulong c view uchar 65536 ct view uint 65536 cv ulong to void
if or ne js_type t v jsstr ne js_type ct cv jsstr
exit 22
end
a = new uchar 128 0
b = new uchar 128 0
an = js_sget s js_off t v a
bn = js_sget c js_off ct cv b
if or lt an 0 lt bn 0
exit 22
end
if not rc_same a ulong an b ulong bn
exit 23
end
end

fn rc_copy o edit uchar * p ulong s view uchar * n ulong to ulong
if gt add p n len o
exit 25
end
for i ulong n
put o add p i get s i
end
ret add p n
end

fn rc_emit o edit uchar 4096 p ulong c view uchar 65536 t view uint 65536 key view uchar * to ulong
a = new uchar 128 0
n = rc_field c t key a 0
q = rc_copy o p opkey len opkey
q = rc_copy o q key len key
q = rc_copy o q opsep len opsep
q = rc_copy o q a n
ret rc_copy o q opend len opend
end

fn rc_read fd int b edit uchar * line bool to ulong
p = ulong 0
while lt p len b bound 65536
n = read fd b p 1
if lt n 0
exit 20
end
if eq n 0
ret p
end
p = add p 1
if and line eq get b sub p 1 10
ret p
end
end
exit 20
end

fn rc_write fd int b view uchar * n ulong to void
p = ulong 0
while lt p n bound 65536
k = write fd b p sub n p
if le k 0
exit 26
end
p = add p ulong k
end
end

fn rc_revs src view uchar 65536 tape view uint 65536 pa ulong ctx view uchar 65536 ct view uint 65536 to void
revs = rc_get src tape pa krevs
if ne js_type tape revs jsarr
exit 24
end
matches = ulong 0
rv = js_first tape revs
while ne rv jsnone bound 16384
id = rc_get src tape rv kid
cv = rc_get ctx ct 0 krev
if rc_equal src tape id ctx ct cv
matches = add matches 1
rc_bind src tape rc_get src tape rv koid ctx ct rc_get ctx ct 0 kcand
rc_bind src tape rc_get src tape rv kbase ctx ct rc_get ctx ct 0 kbase
end
rv = js_enext tape rv
end
if ne matches 1
exit 23
end
end

fn rc_patch src view uchar 65536 tape view uint 65536 ctx view uchar 65536 ct view uint 65536 to void
repo = rc_get src tape 0 krepo
rc_bind src tape rc_get src tape repo kid ctx ct rc_get ctx ct 0 krid
pa = rc_get src tape 0 kpatch
rc_bind src tape rc_get src tape pa kid ctx ct rc_get ctx ct 0 kpatch
rc_bind src tape rc_get src tape pa kafter ctx ct rc_get ctx ct 0 kcand
st = rc_get src tape pa kstate
if not rc_eq src tape rc_get src tape st kstatus sopen
exit 24
end
co = rc_get src tape pa kcommits
if ne js_type tape co jsarr
exit 24
end
first = js_first tape co
cv = rc_get ctx ct 0 kcand
rc_bind src tape first ctx ct cv
rc_revs src tape pa ctx ct
end

fn rc_output ob edit uchar 4096 ctx view uchar 65536 ct view uint 65536 to ulong
p = rc_copy ob 0 ophead len ophead
p = rc_emit ob p ctx ct krid
p = rc_emit ob p ctx ct kpatch
p = rc_emit ob p ctx ct krev
p = rc_emit ob p ctx ct kcand
p = rc_emit ob p ctx ct kbase
p = rc_emit ob p ctx ct ktool
p = rc_emit ob p ctx ct ktask
p = rc_emit ob p ctx ct katt
p = rc_emit ob p ctx ct kgen
p = rc_emit ob p ctx ct kpolicy
p = rc_copy ob p opfinish len opfinish
ret p
end

fn rc_host ob view uchar 4096 p ulong to int
path = new uchar 4096 0
hn = argread 2 path 0 4096
if or le hn 0 ge hn 4000
ret 2
end
if ne get path 0 47
ret 2
end
pk = new uchar 4096 0
put pk 0 1
put pk 2 uchar and ulong hn 255
put pk 3 uchar shr ulong hn 8
for i ulong ulong hn
put pk add 4 i get path i
end
fds = new uchar 8 0
r = pipefds fds 0 8 0
if lt r 0
ret 26
end
rd = ulong 0
wr = ulong 0
for i ulong 4
rd = or rd shl ulong get fds i mul i 8
wr = or wr shl ulong get fds add i 4 mul i 8
end
pid = fork
if eq pid 0
r = fclose int wr
r = dupfd int rd 0 0
if lt r 0
exit 26
end
r = execprog pk 0 add 4 ulong hn
exit 27
end
r = fclose int rd
if lt pid 0
r = fclose int wr
ret 26
end
rc_write int wr ob p
r = fclose int wr
ws = new uchar 4 0
r = waitpid int pid ws 0 4 0
if ne r pid
ret 26
end
if ne get ws 0 0
ret 28
end
ret int get ws 1
end

fn rc_generation a view uchar 128 n ulong to void
if or eq n 0 gt n 16
exit 22
end
if eq get a 0 48
exit 22
end
v = ulong 0
for i ulong n
c = get a i
if or lt c 48 gt c 57
exit 22
end
v = add mul v 10 sub ulong c 48
if gt v 9007199254740991
exit 22
end
end
end

fn rc_context ctx edit uchar 65536 ct edit uint 65536 to void
path = new uchar 4096 0
pn = argread 1 path 0 4096
if or le pn 0 ge pn 4096
exit 2
end
fd = fopen path 0 ulong pn 0 0
if lt fd 0
exit 20
end
cn = rc_read int fd ctx false
r = fclose int fd
r = js_init ct 8192 16
r = js_parse ctx ct cn
if lt r 0
exit 21
end
if not rc_eq ctx ct rc_get ctx ct 0 kstatus sactive
exit 24
end
check = new uchar 128 0
v = rc_field ctx ct kpatch check 40
v = rc_field ctx ct krev check 40
v = rc_field ctx ct kcand check 40
v = rc_field ctx ct kbase check 40
v = rc_field ctx ct ktool check 64
v = rc_field ctx ct kpolicy check 64
v = rc_field ctx ct kgen check 0
rc_generation check v
end

fn rc_event src edit uchar 65536 tape edit uint 65536 to void
n = rc_read 0 src true
r = js_init tape 65536 32
r = js_parse src tape n
if lt r 0
exit 21
end
if not rc_eq src tape rc_get src tape 0 kreq strigger
exit 24
end
v = rc_get src tape 0 kver
if ne js_type tape v jsnum
exit 24
end
if not js_isu src js_off tape v
exit 24
end
if ne js_tou src js_off tape v 1
exit 24
end
if not rc_eq src tape rc_get src tape 0 kevt spatch
exit 24
end
ac = rc_get src tape 0 kaction
if not or rc_eq src tape ac screated rc_eq src tape ac supdated
exit 24
end
end

fn main to int
if or lt argcnt 2 gt argcnt 3
ret 2
end
ctx = new uchar 65536 0
ct = new uint 65536 0
src = new uchar 65536 0
tape = new uint 65536 0
rc_context ctx ct
rc_event src tape
rc_patch src tape ctx ct
ob = new uchar 4096 0
p = rc_output ob ctx ct
if eq argcnt 2
rc_write 1 ob p
ret 0
end
ret rc_host ob p
end

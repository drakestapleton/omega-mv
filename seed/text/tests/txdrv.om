note txdrv: test driver for seed/text/text.om. Composed as: om2, text.om, this file (gate.sh does it).
note stdin: records, each an op byte and its fields; a byte string is a u32 little-endian length and the
note bytes, a number a u64 little-endian. One output line per record (see gen.py for the layout).
note All of stdin is read into one 3 MiB local array, which every case slices with part or (o, n).
global obuf uchar 1048576
global oc ulong 1
global gp ulong 1

fn oflush to void
off = ulong 0
n = get oc 0
while lt off n bound 1048576
w = write 1 obuf off sub n off
if le w 0
exit int 90
end
off = add off ulong w
end
put oc 0 0
end

fn oputb b uchar to void
m = get oc 0
put obuf m b
put oc 0 add m 1
end

fn oputn v ulong to void
d = new uchar 20 0
i = ulong 0
x = v
put d 0 uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0 bound 20
put d i uchar add rem x 10 48
x = div x 10
i = add i 1
end
while gt i 0 bound 20
i = sub i 1
oputb get d i
end
end

fn oputl v long to void
if lt v 0
oputb 45
oputn add ulong neg add v 1 1
ret
end
oputn ulong v
end

fn oend to void
oputb 10
if gt get oc 0 1040000
oflush
end
end

fn rd8 b view uchar * to ulong
p = get gp 0
put gp 0 add p 1
ret ulong get b p
end

fn rdn b view uchar * k ulong to ulong
p = get gp 0
x = ulong 0
for i ulong k
x = or x shl ulong get b add p i mul i 8
end
put gp 0 add p k
ret x
end

note rds: a byte string; leaves its offset in gp and returns its length after skipping it.
fn rds b view uchar * to ulong
n = rdn b 4
p = get gp 0
put gp 0 add p n
ret n
end

note copyto: b[p .. p+n) into a (the second string of a case: one array may not be passed twice in a call).
fn copyto b view uchar * p ulong n ulong a edit uchar * to void
for i ulong n
put a i get b add p i
end
end

fn cmpcase b view uchar * to void
sb = new uchar 262144 0
na = rds b
pa = sub get gp 0 na
nb = rds b
pb = sub get gp 0 nb
copyto b pb nb sb
oputb 69
oputb 32
e = tx_eq part b pa na part sb 0 nb
if e
oputb 49
else
oputb 48
end
oputb 32
c = tx_cmp part b pa na part sb 0 nb
oputl long c
oend
end

fn findcase b view uchar * to void
sb = new uchar 262144 0
nh = rds b
ph = sub get gp 0 nh
nn = rds b
pn = sub get gp 0 nn
from = rdn b 8
copyto b pn nn sb
r = tx_find part b ph nh part sb 0 nn from
oputb 70
oputb 32
if eq r txnone
oputb 110
else
oputn r
end
oend
end

fn splitcase b view uchar * to void
ns = rds b
ps = sub get gp 0 ns
sep = uchar rd8 b
cnt = ulong 0
p = ulong 0
lens = new ulong 4096 0
while true bound 4096
e = tx_field part b ps ns sep p
put lens cnt sub e p
cnt = add cnt 1
if eq e ns
break
end
p = add e 1
end
oputb 83
oputb 32
oputn cnt
for i ulong cnt
oputb 32
oputn get lens i
end
oend
end

fn parsecase b view uchar * op ulong to void
n = rds b
o = sub get gp 0 n
v = new ulong 1 0
s = new long 1 0
r = long 0
if eq op 68
r = tx_pdec b o n v
end
if eq op 72
r = tx_phex b o n v
end
if eq op 73
r = tx_pdeci b o n s
end
oputb uchar op
if lt r 0
oputt3 101 114 114
oputn ulong neg r
oend
ret
end
oputb 32
oputb 111
oputb 107
oputb 32
if eq op 73
oputl get s 0
else
oputn get v 0
end
oend
end

note oputt3: a space, three bytes and a space.
fn oputt3 a uchar b uchar c uchar to void
oputb 32
oputb a
oputb b
oputb c
oputb 32
end

fn fmtcase b view uchar * op ulong to void
v = rdn b 8
w = rdn b 8
cap = rdn b 8
fb = new uchar 64 0
o = sub 64 cap
r = long 0
if eq op 102
r = tx_fdec v fb o
end
if eq op 103
r = tx_fdeci bitcast long v fb o
end
if eq op 120
r = tx_fhex v w fb o
end
oputb uchar op
oputb 32
if lt r 0
oputb 69
oend
ret
end
for i ulong sub ulong r o
oputb get fb add o i
end
oend
end

fn u8case b view uchar * to void
n = rds b
o = sub get gp 0 n
r = tx_u8ok b o n
oputb 85
oputb 32
oputn sub r o
oend
end

fn main to int
inb = new uchar 3145728 0
off = ulong 0
k = long 1
while and gt k 0 lt off len inb bound 999999
k = read 0 inb off sub len inb off
if gt k 0
off = add off ulong k
end
end
if eq off len inb
ret 91
end
while lt get gp 0 off bound 999999
op = rd8 inb
if eq op 69
cmpcase inb
else
if eq op 70
findcase inb
else
if eq op 83
splitcase inb
else
if eq op 85
u8case inb
else
if or eq op 68 or eq op 72 eq op 73
parsecase inb op
else
if or eq op 102 or eq op 103 eq op 120
fmtcase inb op
else
ret 92
end
end
end
end
end
end
end
oflush
ret 0
end

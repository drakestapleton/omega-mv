# Exact boundary obligations for RM5: invalid ranges trap before access; clean refusals preserve storage.
text-empty-slices run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 0
text-offset-wrap run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 1
text-length-wrap run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 2
text-past-end-empty run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 3
text-decimal-short-unchanged run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 4
text-signed-short-unchanged run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 5
text-hex-width-refused run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 6
text-surrogate-unchanged run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 7
text-decode-past-end run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 8
text-parse-past-end run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 9
text-encode-short-unchanged run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 a
text-search-past-end run seed/text/tests/boundaries.om+seed/text/text.om - - - 0 b
text-format-past-end run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 c
text-validate-length-wrap run seed/text/tests/boundaries.om+seed/text/text.om - - - 103 d
text-function-literal refuse seed/text/tests/function-text.om 9
text-function-empty-literal refuse seed/text/tests/function-empty-text.om 9

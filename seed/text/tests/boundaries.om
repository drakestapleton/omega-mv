note Boundary contract for seed/text, composed before text.om by boundary.cases.
note A selector runs one case; the cases file supplies exact exits, never inferred outputs.
om2

fn untouched a view uchar * to int
for i ulong len a
if ne get a i 17
ret 1
end
end
ret 0
end

fn emptychecks a view uchar * b view uchar * to int
if not tx_eq part a 4 0 part b 4 0
ret 1
end
if ne tx_cmp part a 4 0 part b 4 0 0
ret 2
end
if ne tx_find part a 4 0 part b 4 0 0 0
ret 3
end
if ne tx_field part a 4 0 17 0 0
ret 4
end
if ne tx_u8ok a 4 0 4
ret 5
end
if ne tx_u8dec a 4 0 18446744073709551615
ret 6
end
v = new ulong 1 123
if ne tx_pdec a 4 0 v long -1
ret 7
end
if ne get v 0 123
ret 8
end
ret 0
end

fn main to int
arg = new uchar 1 0
if ne argread 1 arg 0 1 1
ret 90
end
sel = get arg 0
a = new uchar 4 17
b = new uchar 4 17
v = new ulong 1 123
if eq sel 48
ret emptychecks a b
end
if eq sel 49
tx_slice 4 18446744073709551615 2
ret 0
end
if eq sel 50
tx_slice 4 1 18446744073709551615
ret 0
end
if eq sel 51
tx_slice 4 5 0
ret 0
end
if eq sel 52
if ne tx_fdec 18446744073709551615 a 0 long -4
ret 1
end
ret untouched a
end
if eq sel 53
if ne tx_fdeci long -9223372036854775808 a 0 long -4
ret 1
end
ret untouched a
end
if eq sel 54
r = tx_fhex 1 17 a 0
ret 0
end
if eq sel 55
if ne tx_u8enc 55296 a 0 long -3
ret 1
end
ret untouched a
end
if eq sel 56
u = tx_u8dec a 3 2
ret 0
end
if eq sel 57
r = tx_pdec a 3 2 v
ret 0
end
if eq sel 97
if ne tx_u8enc 1114111 a 1 long -4
ret 1
end
ret untouched a
end
if eq sel 98
if ne tx_find a b 18446744073709551615 18446744073709551615
ret 1
end
if ne tx_field a 17 18446744073709551615 18446744073709551615
ret 2
end
ret 0
end
if eq sel 99
r = tx_fdec 1 a 5
ret 0
end
if eq sel 100
u = tx_u8ok a 1 18446744073709551615
ret 0
end
ret 91
end

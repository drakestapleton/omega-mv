om2
note seed/text/tests/gen.om: the cases and their expected answers for seed/text/text.om, in seeded Omega.
note Usage: gen OUTDIR. Writes OUTDIR/cases-K.bin and OUTDIR/want-K.txt, K = 0, 1, ..., then prints
note "cases files=N". It replaces tests/gen.py (Python) and writes the same bytes for the same rows.
note The answers are computed here by separate plain code (byte loops, digit-string comparison against
note the range limits, the Unicode table 3-7 of well-formed UTF-8), never by text.om, so a rule that
note text.om gets wrong shows as a mismatch. The random cases come from MT19937 seeded with 20261108
note the way CPython seeds random.Random(20261108), drawn the way CPython 3.12 draws them
note (getrandbits by 32-bit words, _randbelow by rejection, random() from two words), so the rows are
note the ones gen.py wrote. Record layout (txdrv.om): op byte; byte strings as u32 little-endian
note length + bytes; numbers u64 little-endian. Every write is checked: a failure exits 80.

const LIMIT ulong 2900000
const NONE ulong 18446744073709551615
note random() < p is a53 * 2^-53 < p, with a53 = (w1 >> 5) * 2^26 + (w2 >> 6): exactly a53 < ceil(p * 2^53)
note for the binary64 p (WolframLanguageEvaluator Ceiling[SetPrecision[p, Infinity]*2^53]).
const T30 ulong 2702159776422298
const T05 ulong 450359962737050
const T50 ulong 4503599627370496
const T20 ulong 1801439850948199

text tcase "/cases-"
text twant "/want-"
text tbin ".bin"
text ttxt ".txt"
text tfiles "cases files="
text terr "err "
text tok "ok "
text tneedle "needle"
text tneedlx "needlex"
text t25 "0123456789abcdefABCDEF-+ "
text tu64 "18446744073709551615"
text ti63p "9223372036854775807"
text ti63n "9223372036854775808"
text tedge "|0|00|1|18446744073709551615|18446744073709551616|18446744073709551619|18446744073709551620|99999999999999999999|000000000000000000000018446744073709551615|1x|x| 1|1 |+1|-|-0|-1|9223372036854775807|9223372036854775808|-9223372036854775808|-9223372036854775809|--1|1-|ffffffffffffffff|FFFFFFFFFFFFFFFF|10000000000000000|0fffffffffffffffF|g|0x10|99999999999999999999x"

global cb uchar 2900000
global cn ulong 1
global wb uchar 1048576
global wn ulong 1
global wfd long 1
global nf ulong 1
global od uchar 4096
global odn ulong 1
global pb uchar 4200
global pn ulong 1
global nb uchar 24
global ft uchar 72
global ftn ulong 1
global eb uchar 4
global mt uint 624
global mi ulong 1
global ga uchar 262144
global gb uchar 262144
global gl ulong 2

fn ck yes bool to void
if not yes
exit 80
end
end

note ======== MT19937, seeded as CPython's init_by_array with the one key word 20261108
fn mtseed to void
put mt 0 uint 19650218
for i ulong 623
p = get mt i
put mt add i 1 add mul 1812433253 xor p shr p 30 uint add i 1
end
i = ulong 1
for c1 ulong 624
p = get mt sub i 1
put mt i add xor get mt i mul xor p shr p 30 1664525 uint 20261108
i = add i 1
if ge i 624
put mt 0 get mt 623
i = 1
end
end
for c2 ulong 623
p = get mt sub i 1
put mt i sub xor get mt i mul xor p shr p 30 1566083941 uint i
i = add i 1
if ge i 624
put mt 0 get mt 623
i = 1
end
end
put mt 0 0x80000000
put mi 0 624
end

fn mtgen to void
for k ulong 624
y = or and get mt k 0x80000000 and get mt rem add k 1 624 0x7fffffff
v = xor get mt rem add k 397 624 shr y 1
if ne and y 1 0
v = xor v 0x9908b0df
end
put mt k v
end
put mi 0 0
end

fn rnd32 to uint
if ge get mi 0 624
mtgen
end
i = get mi 0
y = get mt i
put mi 0 add i 1
y = xor y shr y 11
y = xor y and shl y 7 0x9d2c5680
y = xor y and shl y 15 0xefc60000
y = xor y shr y 18
ret y
end

note getrandbits(k) for k 1..32
fn rbits k ulong to ulong
ret ulong shr rnd32 sub 32 k
end

fn blen n ulong to ulong
k = ulong 0
x = n
while gt x 0 bound 65
x = shr x 1
k = add k 1
end
ret k
end

note _randbelow(n), n 1 .. 2^32 - 1: getrandbits(bit_length n) until below n
fn rbelow n ulong to ulong
k = blen n
r = rbits k
while ge r n bound 1000000
r = rbits k
end
ret r
end

note _randbelow(2^64): getrandbits(65) is three words, low first, the third shifted right by 31
fn r64 to ulong
w0 = ulong rnd32
w1 = ulong rnd32
w2 = shr rnd32 31
while ne w2 0 bound 1000000
w0 = ulong rnd32
w1 = ulong rnd32
w2 = shr rnd32 31
end
ret or w0 shl w1 32
end

note random() as the 53-bit integer a53 (see T30)
fn rrand to ulong
a = ulong shr rnd32 5
b = ulong shr rnd32 6
ret add mul a 67108864 b
end

note ======== output: want lines go through wb to the open want file, records into cb
fn dig v ulong to ulong
x = v
i = ulong 0
put nb i uchar add rem x 10 48
x = div x 10
i = add i 1
while gt x 0 bound 20
put nb i uchar add rem x 10 48
x = div x 10
i = add i 1
end
ret i
end

fn wb1 c uchar to void
n = get wn 0
put wb n c
put wn 0 add n 1
end

fn wtx t view uchar * to void
for i ulong len t
wb1 get t i
end
end

fn wnum v ulong to void
i = dig v
while gt i 0 bound 20
i = sub i 1
wb1 get nb i
end
end

fn wop c uchar to void
wb1 c
wb1 32
end

fn wflush to void
fd = int sub get wfd 0 1
n = get wn 0
off = ulong 0
while lt off n bound 1000000
w = write fd wb off sub n off
ck gt w 0
off = add off ulong w
end
put wn 0 0
end

fn wend to void
wb1 10
if gt get wn 0 1040000
wflush
end
end

fn cb1 c uchar to void
n = get cn 0
put cb n c
put cn 0 add n 1
end

fn cbn v ulong k ulong to void
for i ulong k
cb1 uchar and shr v mul i 8 255
end
end

fn cbga n ulong to void
for i ulong n
cb1 get ga i
end
end

fn cbgb n ulong to void
for i ulong n
cb1 get gb i
end
end

fn pb1 c uchar to void
n = get pn 0
put pb n c
put pn 0 add n 1
end

fn pbtx t view uchar * to void
for i ulong len t
pb1 get t i
end
end

note mkpath kind: OUTDIR/cases-K.bin (kind 0) or OUTDIR/want-K.txt (kind 1) into pb; its length
fn mkpath kind ulong to ulong
put pn 0 0
for i ulong get odn 0
pb1 get od i
end
if eq kind 0
pbtx tcase
else
pbtx twant
end
j = dig get nf 0
while gt j 0 bound 20
j = sub j 1
pb1 get nb j
end
if eq kind 0
pbtx tbin
else
pbtx ttxt
end
ret get pn 0
end

fn openw to void
n = mkpath 1
fd = fopen pb 0 n 577 420
ck ge fd 0
put wfd 0 add fd 1
end

fn flush to void
n = get cn 0
if eq n 0
ret
end
p = mkpath 0
fd = int fopen pb 0 p 577 420
ck ge fd 0
off = ulong 0
while lt off n bound 1000000
w = write fd cb off sub n off
ck gt w 0
off = add off ulong w
end
ck eq fclose fd 0
put cn 0 0
wflush
ck eq fclose int sub get wfd 0 1 0
put wfd 0 0
put nf 0 add get nf 0 1
end

note reserve L: start a new cases file first when this record of L bytes would pass LIMIT
fn reserve l ulong to void
if gt add get cn 0 l LIMIT
flush
end
if eq get wfd 0 0
openw
end
end

note ======== bytes: equality and order
fn cmpab la ulong lb ulong to ulong
m = la
if lt lb m
m = lb
end
for i ulong m
x = get ga i
y = get gb i
if ne x y
if lt x y
ret 0
end
ret 2
end
end
if lt la lb
ret 0
end
if gt la lb
ret 2
end
ret 1
end

fn cmpcase to void
la = get gl 0
lb = get gl 1
reserve add add 9 la lb
cb1 69
cbn la 4
cbga la
cbn lb 4
cbgb lb
c = cmpab la lb
wop 69
if eq c 1
wb1 49
else
wb1 48
end
wb1 32
if eq c 0
wb1 45
wb1 49
else
if eq c 1
wb1 48
else
wb1 49
end
end
wend
end

note ======== search
fn same i ulong lb ulong to bool
for j ulong lb
if ne get ga add i j get gb j
ret false
end
end
ret true
end

fn findat la ulong lb ulong frm ulong to ulong
if gt frm la
ret NONE
end
if gt lb sub la frm
ret NONE
end
stop = sub la lb
i = frm
while le i stop bound 1000000
if same i lb
ret i
end
i = add i 1
end
ret NONE
end

fn findcase frm ulong to void
la = get gl 0
lb = get gl 1
reserve add add 17 la lb
cb1 70
cbn la 4
cbga la
cbn lb 4
cbgb lb
cbn frm 8
r = findat la lb frm
wop 70
if eq r NONE
wb1 110
else
wnum r
end
wend
end

note ======== fields
fn splcase sep uchar to void
la = get gl 0
reserve add 6 la
cb1 83
cbn la 4
cbga la
cb1 sep
wop 83
cnt = ulong 1
for i ulong la
if eq get ga i sep
cnt = add cnt 1
end
end
wnum cnt
p = ulong 0
for j ulong la
if eq get ga j sep
wb1 32
wnum sub j p
p = add j 1
end
end
wb1 32
wnum sub la p
wend
end

note ======== integer text
fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn ishex c uchar to bool
ret or isdig c or and ge c 97 le c 102 and ge c 65 le c 70
end

fn hexval c uchar to ulong
if le c 57
ret ulong sub c 48
end
if ge c 97
ret ulong sub c 87
end
ret ulong sub c 55
end

note digover z nd t: the digits ga[z .. z+nd), no leading zero, are a number above the digits of t
fn digover z ulong nd ulong t view uchar * to bool
if ne nd len t
ret gt nd len t
end
for i ulong nd
x = get ga add z i
y = get t i
if ne x y
ret gt x y
end
end
ret false
end

note pform op s: every byte of ga[s ..) has the form of op (decimal digits, or hex digits for H), and
note there is at least one
fn pform op uchar s ulong to bool
la = get gl 0
ok = gt la s
i = s
while lt i la bound 1000000
g = isdig get ga i
if eq op 72
g = ishex get ga i
end
if not g
ok = false
end
i = add i 1
end
ret ok
end

note pover op ng z: the digits ga[z ..), no leading zero, are out of range for op (ng: after a '-')
fn pover op uchar ng bool z ulong to bool
nd = sub get gl 0 z
if eq op 72
ret gt nd 16
end
if eq op 68
ret digover z nd tu64
end
if ng
ret digover z nd ti63n
end
ret digover z nd ti63p
end

fn pvalue base ulong z ulong to ulong
la = get gl 0
v = ulong 0
j = z
while lt j la bound 1000000
v = add mul v base hexval get ga j
j = add j 1
end
ret v
end

note pres op: the answer after "D ", "H " or "I ": err 1 empty, err 2 a byte outside the form, err 3 out
note of range, else ok and the value
fn pres op uchar to void
la = get gl 0
if eq la 0
wtx terr
wb1 49
ret
end
s = ulong 0
ng = false
if and eq op 73 eq get ga 0 45
ng = true
s = 1
end
if not pform op s
wtx terr
wb1 50
ret
end
z = s
while and lt z la eq get ga z 48 bound 1000000
z = add z 1
end
if pover op ng z
wtx terr
wb1 51
ret
end
base = ulong 10
if eq op 72
base = 16
end
v = pvalue base z
wtx tok
if and ng ne v 0
wb1 45
end
wnum v
end

fn parcase op uchar to void
la = get gl 0
reserve add 5 la
cb1 op
cbn la 4
cbga la
wop op
pres op
wend
end

fn par3 to void
parcase 68
parcase 72
parcase 73
end

note ======== number text: ft gets the text, ftn its length
fn fdec v ulong to void
n = dig v
for i ulong n
put ft i get nb sub sub n i 1
end
put ftn 0 n
end

fn fsig u ulong to void
if lt u 0x8000000000000000
fdec u
ret
end
m = sub 0 u
n = dig m
put ft 0 45
for i ulong n
put ft add i 1 get nb sub sub n i 1
end
put ftn 0 add n 1
end

fn fhex v ulong w ulong to void
n = ulong 1
x = shr v 4
while gt x 0 bound 16
n = add n 1
x = shr x 4
end
if lt n w
n = w
end
x = v
j = n
while gt j 0 bound 64
j = sub j 1
d = uchar and x 15
c = add d 48
if gt d 9
c = add d 87
end
put ft j c
x = shr x 4
end
put ftn 0 n
end

fn fmtcase op uchar v ulong w ulong cap ulong to void
reserve 25
cb1 op
cbn v 8
cbn w 8
cbn cap 8
if eq op 102
fdec v
end
if eq op 120
fhex v w
end
if eq op 103
fsig v
end
wop op
n = get ftn 0
if gt n cap
wb1 69
else
for i ulong n
wb1 get ft i
end
end
wend
end

fn fmtx v ulong w ulong to void
fhex v w
l = get ftn 0
fmtcase 120 v w sub l 1
fmtcase 120 v w 16
fmtcase 120 v w 64
end

fn fmtv v ulong to void
fdec v
l = get ftn 0
fmtcase 102 v 0 0
fmtcase 102 v 0 1
fmtcase 102 v 0 sub l 1
fmtcase 102 v 0 l
fmtcase 102 v 0 20
fmtcase 102 v 0 64
fmtx v 0
fmtx v 1
fmtx v 8
fmtx v 16
end

fn fmtg u ulong to void
fsig u
l = get ftn 0
fmtcase 103 u 0 sub l 1
fmtcase 103 u 0 l
fmtcase 103 u 0 64
end

note ======== UTF-8 (Unicode table 3-7): sequence length by lead byte (0: never a lead), second-byte range
fn u8need c uchar to ulong
if lt c 0x80
ret 1
end
if lt c 0xc2
ret 0
end
if lt c 0xe0
ret 2
end
if lt c 0xf0
ret 3
end
if lt c 0xf5
ret 4
end
ret 0
end

fn u8lo c uchar to uchar
if eq c 0xe0
ret 0xa0
end
if eq c 0xf0
ret 0x90
end
ret 0x80
end

fn u8hi c uchar to uchar
if eq c 0xed
ret 0x9f
end
if eq c 0xf4
ret 0x8f
end
ret 0xbf
end

note u8bad i k: the k-byte sequence led at ga[i] has a byte outside its range (all k bytes present)
fn u8bad i ulong k ulong to bool
c = get ga i
s = get ga add i 1
if or lt s u8lo c gt s u8hi c
ret true
end
j = ulong 2
while lt j k bound 4
t = get ga add i j
if or lt t 0x80 gt t 0xbf
ret true
end
j = add j 1
end
ret false
end

note u8val: the length when ga is well-formed, else the index of the lead of the first sequence that is
note ill-formed or cut off by the end
fn u8val to ulong
la = get gl 0
i = ulong 0
while lt i la bound 1000000
k = u8need get ga i
if eq k 0
ret i
end
if gt k 1
if gt add i k la
ret i
end
if u8bad i k
ret i
end
end
i = add i k
end
ret la
end

fn u8case to void
la = get gl 0
reserve add 5 la
cb1 85
cbn la 4
cbga la
wop 85
wnum u8val
wend
end

note u8enc cp: the UTF-8 bytes of cp (below 0x110000) into eb; their count
fn u8enc cp ulong to ulong
if lt cp 0x80
put eb 0 uchar cp
ret 1
end
if lt cp 0x800
put eb 0 uchar or 0xc0 shr cp 6
put eb 1 uchar or 0x80 and cp 0x3f
ret 2
end
if lt cp 0x10000
put eb 0 uchar or 0xe0 shr cp 12
put eb 1 uchar or 0x80 and shr cp 6 0x3f
put eb 2 uchar or 0x80 and cp 0x3f
ret 3
end
put eb 0 uchar or 0xf0 shr cp 18
put eb 1 uchar or 0x80 and shr cp 12 0x3f
put eb 2 uchar or 0x80 and shr cp 6 0x3f
put eb 3 uchar or 0x80 and cp 0x3f
ret 4
end

fn u8app cp ulong to void
n = u8enc cp
la = get gl 0
for i ulong n
put ga add la i get eb i
end
put gl 0 add la n
end

note decres: the answer after "P ": the first code point and its length, or n
fn decres to void
la = get gl 0
c = get ga 0
k = u8need c
if eq k 0
wb1 110
ret
end
if eq k 1
wnum ulong c
wb1 32
wb1 49
ret
end
if lt la k
wb1 110
ret
end
if u8bad 0 k
wb1 110
ret
end
cp = ulong and c 0x1f
if eq k 3
cp = ulong and c 0x0f
end
if eq k 4
cp = ulong and c 0x07
end
for j ulong sub k 1
cp = or shl cp 6 ulong and get ga add j 1 0x3f
end
wnum cp
wb1 32
wnum k
end

fn deccase to void
la = get gl 0
reserve add 5 la
cb1 80
cbn la 4
cbga la
wop 80
decres
wend
end

fn enccase cp ulong cap ulong to void
reserve 17
cb1 81
cbn cp 8
cbn cap 8
wop 81
if or gt cp 0x10ffff and ge cp 0xd800 le cp 0xdfff
wb1 82
wend
ret
end
n = u8enc cp
if gt n cap
wb1 69
wend
ret
end
for i ulong n
e = get eb i
wb1 hexc shr e 4
wb1 hexc and e 15
end
wend
end

fn hexc d uchar to uchar
if lt d 10
ret add d 48
end
ret add d 87
end

note ======== the case sections, in gen.py's order
fn rab5 to uchar
i = rbelow 5
if eq i 0
ret 97
end
if eq i 1
ret 98
end
if eq i 2
ret 127
end
if eq i 3
ret 128
end
ret 255
end

fn seccmp to void
for t ulong 3000
la = rbelow 9
for i1 ulong la
put ga i1 rab5
end
put gl 0 la
if lt rrand T30
for i2 ulong la
put gb i2 get ga i2
end
put gl 1 la
else
lb = rbelow 9
for i3 ulong lb
put gb i3 rab5
end
put gl 1 lb
end
cmpcase
end
end

fn cpab n ulong to void
for i ulong n
put gb i get ga i
end
put gl 1 n
end

fn flipcmp ix ulong to void
cpab 200000
put gb ix xor get gb ix 0x80
cmpcase
end

fn secbig to void
for i ulong 200000
put ga i uchar rbelow 256
end
put gl 0 200000
cpab 200000
cmpcase
flipcmp 0
flipcmp 65535
flipcmp 65536
flipcmp 65537
flipcmp 131072
flipcmp 199999
cpab 199999
cmpcase
cpab 200000
put gl 0 199999
cmpcase
put gl 0 0
put gl 1 0
cmpcase
end

fn secfind to void
for t ulong 3000
lh = rbelow 12
for i1 ulong lh
put ga i1 uchar add 97 rbelow 2
end
put gl 0 lh
ln = rbelow 4
for i2 ulong ln
put gb i2 uchar add 97 rbelow 2
end
put gl 1 ln
findcase rbelow 14
end
end

fn gbtx t view uchar * to void
for i ulong len t
put gb i get t i
end
put gl 1 len t
end

fn sechay to void
for i ulong 250000
put ga i uchar add 97 rbelow 2
end
for j ulong 6
put ga add 250000 j get tneedle j
end
for k ulong 10
put ga add 250006 k 97
end
la = ulong 250016
put gl 0 la
gbtx tneedle
findcase 0
findcase 65536
findcase 250000
findcase 250001
findcase sub la 6
findcase la
findcase add la 1
put gl 1 0
findcase la
put gl 0 0
findcase 0
findcase 1
put gl 0 la
gbtx tneedlx
findcase 0
end

fn secsplit to void
for t ulong 2000
l = rbelow 12
for i ulong l
c = uchar 97
if eq rbelow 2 1
c = 44
end
put ga i c
end
put gl 0 l
splcase 44
end
for j ulong 140000
put ga j 97
end
put ga 140000 44
put ga 140001 98
put ga 140002 98
put ga 140003 98
put gl 0 140004
splcase 44
end

fn secedge to void
p = ulong 0
for i ulong add len tedge 1
cut = false
if eq i len tedge
cut = true
else
if eq get tedge i 124
cut = true
end
end
if cut
for j ulong sub i p
put ga j get tedge add p j
end
put gl 0 sub i p
par3
p = add i 1
end
end
for k ulong 100000
put ga k 48
end
put ga 100000 55
put gl 0 100001
par3
end

fn secbyte to void
for a ulong 256
put ga 0 uchar a
put ga 1 49
put gl 0 1
parcase 68
put gl 0 2
parcase 68
put gl 0 1
parcase 72
put gl 0 2
parcase 72
put gl 0 1
parcase 73
put gl 0 2
parcase 73
end
end

fn secprnd to void
for t ulong 4000
k = add 1 rbelow 22
for i ulong k
c = uchar 0
if lt rrand T05
c = get t25 rbelow 25
else
c = uchar add 48 rbelow 10
end
put ga i c
end
put gl 0 k
par3
end
end

fn secfmt to void
fmtv 0
fmtv 1
fmtv 9
fmtv 10
fmtv 99
fmtv 100
fmtv 0xffffffffffffffff
fmtv 0xfffffffffffffffe
fmtv 0x8000000000000000
fmtv 0x7fffffffffffffff
for t ulong 2000
fmtv r64
end
fmtg 0
fmtg 0xffffffffffffffff
fmtg 1
fmtg 0x8000000000000000
fmtg 0x7fffffffffffffff
fmtg 0x8000000000000001
for u ulong 2000
fmtg xor r64 0x8000000000000000
end
end

fn third i ulong to uchar
if eq i 0
ret 0x00
end
if eq i 1
ret 0x7f
end
if eq i 2
ret 0x80
end
if eq i 3
ret 0x8f
end
if eq i 4
ret 0x90
end
if eq i 5
ret 0xa0
end
if eq i 6
ret 0xbf
end
if eq i 7
ret 0xc0
end
ret 0xff
end

fn secu8 to void
for a ulong 256
put ga 0 uchar a
put gl 0 1
u8case
end
put gl 0 2
for a2 ulong 256
for b2 ulong 256
put ga 0 uchar a2
put ga 1 uchar b2
u8case
end
end
put gl 0 3
for a3 ulong 16
for b3 ulong 256
for c3 ulong 256
put ga 0 uchar add 0xe0 a3
put ga 1 uchar b3
put ga 2 uchar c3
u8case
end
end
end
put gl 0 4
for a4 ulong 5
for b4 ulong 64
for c4 ulong 9
for e4 ulong 9
put ga 0 uchar add 0xf0 a4
put ga 1 uchar add 0x80 b4
put ga 2 third c4
put ga 3 third e4
u8case
end
end
end
end
end

fn pick5 p ulong c0 ulong c1 ulong c2 ulong c3 ulong c4 ulong to ulong
if eq p 0
ret c0
end
if eq p 1
ret c1
end
if eq p 2
ret c2
end
if eq p 3
ret c3
end
ret c4
end

fn u8mix to void
put gl 0 0
cnt = rbelow 6
for j ulong cnt
c0 = rbelow 0x80
c1 = add 0x80 rbelow sub ulong 0x800 0x80
c2 = add 0x800 rbelow sub ulong 0xd800 0x800
c3 = add 0xe000 rbelow sub ulong 0x10000 0xe000
c4 = add 0x10000 rbelow sub ulong 0x110000 0x10000
u8app pick5 rbelow 5 c0 c1 c2 c3 c4
end
la = get gl 0
if gt la 0
if lt rrand T50
v = uchar rbelow 256
put ga rbelow la v
end
end
la = get gl 0
if gt la 0
if lt rrand T20
put gl 0 rbelow la
end
end
u8case
end

fn secu8r to void
for t ulong 20000
u8mix
end
for i ulong 100000
put ga mul i 2 0xc3
put ga add mul i 2 1 0xa9
end
put ga 200000 0xed
put ga 200001 0xa0
put ga 200002 0x80
put gl 0 200003
u8case
end

fn secdec to void
for a ulong 256
put ga 0 uchar a
put gl 0 1
deccase
put gl 0 2
for b ulong 256
put ga 1 uchar b
deccase
end
end
put gl 0 3
for i ulong 5
lead = uchar 0xe0
if eq i 1
lead = 0xe1
end
if eq i 2
lead = 0xe8
end
if eq i 3
lead = 0xed
end
if eq i 4
lead = 0xef
end
for b3 ulong 256
for c3 ulong 256
put ga 0 lead
put ga 1 uchar b3
put ga 2 uchar c3
deccase
end
end
end
put gl 0 5
for a4 ulong 8
for b4 ulong 64
for c4 ulong 9
for e4 ulong 9
put ga 0 uchar add 0xf0 a4
put ga 1 uchar add 0x80 b4
put ga 2 third c4
put ga 3 third e4
put ga 4 120
deccase
end
end
end
end
end

fn secdecr to void
for t ulong 20000
put gl 0 0
n = add 1 rbelow 2
for i ulong n
cp = rbelow 0x110000
if or lt cp 0xd800 gt cp 0xdfff
u8app cp
end
end
if eq get gl 0 0
put ga 0 97
put gl 0 1
end
put gl 0 add 1 rbelow get gl 0
deccase
end
end

fn edgecp i ulong to ulong
if eq i 0
ret 0
end
if eq i 1
ret 0x7f
end
if eq i 2
ret 0x80
end
if eq i 3
ret 0x7ff
end
if eq i 4
ret 0x800
end
if eq i 5
ret 0xffff
end
if eq i 6
ret 0x10000
end
if eq i 7
ret 0x10ffff
end
if eq i 8
ret 0x110000
end
if eq i 9
ret 0x100000000
end
ret 0xffffffffffffffff
end

fn secenc to void
for i ulong 11
enccase edgecp i 4
end
for j ulong sub ulong 0xe100 0xd700
enccase add 0xd700 j 4
end
cp = ulong 0
while lt cp 0x110000 bound 1000000
enccase cp 4
cp = add cp 7
end
for k ulong 11
for cap ulong 5
enccase edgecp k cap
end
end
end

fn main to int
ck eq argcnt 2
n = argread 1 od 0 4000
ck gt n 0
put odn 0 ulong n
mtseed
seccmp
secbig
secfind
sechay
secsplit
secedge
secbyte
secprnd
secfmt
secu8
secu8r
secdec
secdecr
secenc
flush
put wfd 0 2
wtx tfiles
wnum get nf 0
wb1 10
wflush
ret 0
end

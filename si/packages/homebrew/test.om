om2
note si/packages/homebrew/test.om: Standalone OM-2 behavioral test suite for homebrew-omega formula generator & validator.
note Tests positive formula generation/validation (semver, date version, interplane/github URLs)
note and negative/refusal controls (bad version, disallowed URL prefix, path traversal, bad SHA-256,
note Ruby/shell injection chars, and tampered emitted formula).

global outbuf uchar 8192
global decbuf uchar 32
global f_ver uchar 128
global f_url uchar 384
global f_sha uchar 128
global f_omc uchar 128
global f_home uchar 384
global f_lic uchar 128
global meta ulong 16

const k_outlen ulong 1
const k_vlen ulong 2
const k_ulen ulong 3
const k_slen ulong 4
const k_olen ulong 5
const k_hlen ulong 6
const k_llen ulong 7

text allow_p1 "https://interplane.io/"
text allow_p2 "https://github.com/aien-dev/"
text allow_p3 "https://github.com/drakestapleton/"
text sfx_tgz ".tar.gz"
text sfx_txz ".tar.xz"

text rb_hdr "# omc, the Omega compiler, born from the 408-byte hand-written seed of aien-dev/omega-mv.\nclass Omc < Formula\n  desc \"Omega compiler, born from a 408-byte hand-written seed\"\n  homepage \""
text rb_url "\"\n  url \""
text rb_ver "\"\n  version \""
text rb_sha "\"\n  sha256 \""
text rb_lic "\"\n  license \""
text rb_dep "\"\n\n  depends_on arch: :arm64\n  depends_on :linux\n\n  OMC_SHA256 = \""
text rb_inst "\".freeze\n\n  def install\n    system \"sh\", \"seed/omega-from-seed.sh\"\n    got = Digest::SHA256.file(\"seed/out/omc\").hexdigest\n    odie \"omc sha256 #{got} is not the pinned #{OMC_SHA256}\" if got != OMC_SHA256\n    bin.install \"seed/out/omc\"\n  end\nend\n"

text chk_cls "class Omc < Formula"
text chk_arm "depends_on arch: :arm64"
text chk_lin "depends_on :linux"
text chk_odi "odie \"omc sha256 "

text v_ok_git "0.0.0+git.e5b32567"
text v_ok_sem "1.2.3-rc.1"
text v_ok_date "20261119"
text v_bad_2part "1.2"
text v_bad_dots "1.2..3"
text v_bad_pfx "v1.0.0"
text v_bad_date "20261301"
text v_bad_trail "1.0.0+"
text v_inj_interp "1.0.0#{id}"
text v_inj_quote "1.0.0\"+"
text v_inj_semi "1.0.0;id"

text u_ok_gh "https://github.com/aien-dev/omega-mv/archive/e5b32567a7aff3ce594e3254a622a846a6cd190b.tar.gz"
text u_ok_ip "https://interplane.io/drakestapleton/omega-mv/archive/v1.0.0.tar.xz"
text u_bad_http "http://github.com/aien-dev/omega-mv/archive/e5b32567.tar.gz"
text u_bad_host "https://evil.example/aien-dev/omega-mv/archive/x.tar.gz"
text u_bad_ext "https://interplane.io/drakestapleton/omega-mv/install.sh"
text u_bad_trav "https://interplane.io/drakestapleton/../etc/passwd.tar.gz"
text u_bad_inj "https://interplane.io/drakestapleton/x\"#{id}.tar.gz"

text h_ok_gh "https://github.com/aien-dev/omega-mv"
text h_ok_ip "https://interplane.io/drakestapleton/omega-mv"
text h_bad_inj "https://interplane.io/drakestapleton/omega-mv\"#{"

text l_ok "Apache-2.0"
text l_bad_inj "Apache-2.0\";system('id')"

text s_ok_src "c621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95c"
text s_ok_omc "2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f"
text s_bad_short "c621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95"
text s_bad_upper "C621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95c"
text s_bad_char "z621b6cefe728d67a1a253a9d8991495406460d365dd91ea356451eb2254a95c"

text bad_rb "class Omc < Formula\n  depends_on arch: :arm64\nend\n"

text p_1 "PASS valid_upstream_formula_emitted_and_validated\n"
text p_2 "PASS valid_interplane_semver_and_date_versions\n"
text p_3 "PASS neg_bad_versions_refused\n"
text p_4 "PASS neg_bad_urls_and_traversal_refused\n"
text p_5 "PASS neg_bad_sha256_digests_refused\n"
text p_6 "PASS neg_ruby_shell_injection_refused\n"
text p_7 "PASS neg_tampered_formula_refused\n"
text p_all "HOMEBREW-OMEGA TEST SUITE PASS (7/7)\n"
text f_msg "FAIL test case "
text t_nl "\n"

fn write_all fd int src view uchar * off ulong n ulong to void
p = ulong 0
while lt p n bound 4096
k = write fd src add off p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wstr fd int s view uchar * to void
write_all fd s 0 len s
end

fn wdec fd int v ulong to void
i = ulong 32
n = v
while true bound 24
i = sub i 1
put decbuf i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
p = i
while lt p 32 bound 32
k = write fd decbuf p sub 32 p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn fail_case id ulong to void
wstr 2 f_msg
wdec 2 id
wstr 2 t_nl
exit 1
end

fn set_field which ulong s view uchar * to void
n = len s
i = ulong 0
while lt i n bound 384
c = get s i
if eq which 0
put f_home i c
else
if eq which 1
put f_url i c
else
if eq which 2
put f_ver i c
else
if eq which 3
put f_sha i c
else
if eq which 4
put f_lic i c
else
put f_omc i c
end
end
end
end
end
i = add i 1
end
if eq which 0
put meta k_hlen n
else
if eq which 1
put meta k_ulen n
else
if eq which 2
put meta k_vlen n
else
if eq which 3
put meta k_slen n
else
if eq which 4
put meta k_llen n
else
put meta k_olen n
end
end
end
end
end
end

fn is_dig c uchar to bool
ret and ge c 48 le c 57
end

fn is_hex_low c uchar to bool
if is_dig c
ret true
end
ret and ge c 97 le c 102
end

fn is_alnum c uchar to bool
if is_dig c
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end

fn is_injection_ch c uchar to bool
if or lt c 32 gt c 126
ret true
end
if or eq c 34 eq c 39
ret true
end
if or eq c 96 eq c 92
ret true
end
if or eq c 36 eq c 35
ret true
end
if or eq c 59 eq c 124
ret true
end
if or eq c 38 eq c 40
ret true
end
if or eq c 41 eq c 123
ret true
end
if or eq c 125 or eq c 60 eq c 62
ret true
end
ret false
end

fn is_url_ch c uchar to bool
if is_alnum c
ret true
end
if or eq c 45 eq c 46
ret true
end
if or eq c 95 eq c 126
ret true
end
if or eq c 58 eq c 47
ret true
end
ret eq c 37
end

fn valid_sha_field which ulong to bool
n = ulong 0
if eq which 0
n = get meta k_slen
else
n = get meta k_olen
end
if ne n 64
ret false
end
i = ulong 0
while lt i 64 bound 64
c = uchar 0
if eq which 0
c = get f_sha i
else
c = get f_omc i
end
if not is_hex_low c
ret false
end
i = add i 1
end
ret true
end

fn valid_ver_ext pos ulong vlen ulong to bool
if ge pos vlen
ret false
end
seg = ulong 0
i = pos
while lt i vlen bound 128
c = get f_ver i
if is_injection_ch c
ret false
end
if eq c 46
if eq seg 0
ret false
end
seg = ulong 0
else
if or is_alnum c eq c 45
seg = add seg 1
else
ret false
end
end
i = add i 1
end
ret gt seg 0
end

fn valid_date_ver to bool
j = ulong 0
while lt j 8 bound 8
if not is_dig get f_ver j
ret false
end
j = add j 1
end
yr = mul ulong sub get f_ver 0 48 1000
yr = add yr mul ulong sub get f_ver 1 48 100
yr = add yr mul ulong sub get f_ver 2 48 10
yr = add yr ulong sub get f_ver 3 48
mo = mul ulong sub get f_ver 4 48 10
mo = add mo ulong sub get f_ver 5 48
dy = mul ulong sub get f_ver 6 48 10
dy = add dy ulong sub get f_ver 7 48
if lt yr 2020
ret false
end
if or lt mo 1 gt mo 12
ret false
end
ret and ge dy 1 le dy 31
end

fn valid_version to bool
n = get meta k_vlen
if or eq n 0 gt n 64
ret false
end
i = ulong 0
while lt i n bound 128
if is_injection_ch get f_ver i
ret false
end
i = add i 1
end
if eq n 8
if valid_date_ver
ret true
end
end
dots = ulong 0
seg = ulong 0
p = ulong 0
while lt p n bound 128
c = get f_ver p
if is_dig c
seg = add seg 1
else
if eq c 46
if or eq seg 0 ge dots 2
ret false
end
dots = add dots 1
seg = ulong 0
else
if or eq c 45 eq c 43
if or ne dots 2 eq seg 0
ret false
end
ret valid_ver_ext add p 1 n
else
ret false
end
end
end
p = add p 1
end
ret and eq dots 2 gt seg 0
end

fn url_starts_with pfx view uchar * is_home bool to bool
pl = len pfx
ul = ulong 0
if is_home
ul = get meta k_hlen
else
ul = get meta k_ulen
end
if lt ul pl
ret false
end
i = ulong 0
while lt i pl bound 64
c = uchar 0
if is_home
c = get f_home i
else
c = get f_url i
end
if ne c get pfx i
ret false
end
i = add i 1
end
ret true
end

fn url_ends_with sfx view uchar * to bool
sl = len sfx
ul = get meta k_ulen
if lt ul sl
ret false
end
off = sub ul sl
i = ulong 0
while lt i sl bound 32
if ne get f_url add off i get sfx i
ret false
end
i = add i 1
end
ret true
end

fn url_has_dotdot is_home bool to bool
ul = ulong 0
if is_home
ul = get meta k_hlen
else
ul = get meta k_ulen
end
if lt ul 2
ret false
end
i = ulong 0
lim = sub ul 1
while lt i lim bound 384
a = uchar 0
b = uchar 0
if is_home
a = get f_home i
b = get f_home add i 1
else
a = get f_url i
b = get f_url add i 1
end
if and eq a 46 eq b 46
ret true
end
i = add i 1
end
ret false
end

fn valid_url to bool
ul = get meta k_ulen
if or lt ul 16 gt ul 320
ret false
end
ok_pfx = false
if url_starts_with allow_p1 false
ok_pfx = true
end
if url_starts_with allow_p2 false
ok_pfx = true
end
if url_starts_with allow_p3 false
ok_pfx = true
end
if not ok_pfx
ret false
end
ok_sfx = false
if url_ends_with sfx_tgz
ok_sfx = true
end
if url_ends_with sfx_txz
ok_sfx = true
end
if not ok_sfx
ret false
end
if url_has_dotdot false
ret false
end
i = ulong 0
while lt i ul bound 384
c = get f_url i
if or is_injection_ch c not is_url_ch c
ret false
end
i = add i 1
end
ret true
end

fn valid_homepage to bool
hl = get meta k_hlen
if or lt hl 16 gt hl 320
ret false
end
ok_pfx = false
if url_starts_with allow_p1 true
ok_pfx = true
end
if url_starts_with allow_p2 true
ok_pfx = true
end
if url_starts_with allow_p3 true
ok_pfx = true
end
if not ok_pfx
ret false
end
if url_has_dotdot true
ret false
end
i = ulong 0
while lt i hl bound 384
c = get f_home i
if or is_injection_ch c not is_url_ch c
ret false
end
i = add i 1
end
ret true
end

fn valid_license to bool
ll = get meta k_llen
if or eq ll 0 gt ll 64
ret false
end
i = ulong 0
while lt i ll bound 64
c = get f_lic i
if is_injection_ch c
ret false
end
ok = false
if is_alnum c
ok = true
end
if or eq c 45 or eq c 46 or eq c 43 eq c 32
ok = true
end
if not ok
ret false
end
i = add i 1
end
ret true
end

fn out_clear to void
put meta k_outlen 0
end

fn out_push_lit s view uchar * to void
sl = len s
p = get meta k_outlen
i = ulong 0
while lt i sl bound 4096
if lt p 8192
put outbuf p get s i
p = add p 1
end
i = add i 1
end
put meta k_outlen p
end

fn out_push_field which ulong to void
p = get meta k_outlen
n = ulong 0
if eq which 0
n = get meta k_hlen
else
if eq which 1
n = get meta k_ulen
else
if eq which 2
n = get meta k_vlen
else
if eq which 3
n = get meta k_slen
else
if eq which 4
n = get meta k_llen
else
n = get meta k_olen
end
end
end
end
end
i = ulong 0
while lt i n bound 384
c = uchar 0
if eq which 0
c = get f_home i
else
if eq which 1
c = get f_url i
else
if eq which 2
c = get f_ver i
else
if eq which 3
c = get f_sha i
else
if eq which 4
c = get f_lic i
else
c = get f_omc i
end
end
end
end
end
if lt p 8192
put outbuf p c
p = add p 1
end
i = add i 1
end
put meta k_outlen p
end

fn emit_formula to void
out_clear
out_push_lit rb_hdr
out_push_field 0
out_push_lit rb_url
out_push_field 1
out_push_lit rb_ver
out_push_field 2
out_push_lit rb_sha
out_push_field 3
out_push_lit rb_lic
out_push_field 4
out_push_lit rb_dep
out_push_field 5
out_push_lit rb_inst
end

fn out_starts_at pos ulong needle view uchar * to bool
nl = len needle
tot = get meta k_outlen
if gt add pos nl tot
ret false
end
i = ulong 0
while lt i nl bound 128
if ne get outbuf add pos i get needle i
ret false
end
i = add i 1
end
ret true
end

fn out_contains needle view uchar * to bool
nl = len needle
tot = get meta k_outlen
if gt nl tot
ret false
end
lim = add sub tot nl 1
i = ulong 0
while lt i lim bound 8192
if out_starts_at i needle
ret true
end
i = add i 1
end
ret false
end

fn validate_emitted_formula to bool
if not out_contains chk_cls
ret false
end
if not out_contains chk_arm
ret false
end
if not out_contains chk_lin
ret false
end
if not out_contains chk_odi
ret false
end
ret true
end

fn main to int
note Test 1: valid upstream formula parameters
set_field 0 h_ok_gh
set_field 1 u_ok_gh
set_field 2 v_ok_git
set_field 3 s_ok_src
set_field 4 l_ok
set_field 5 s_ok_omc
if not and valid_version and valid_url and valid_sha_field 0 and valid_sha_field 1 and valid_homepage valid_license
fail_case 1
end
emit_formula
if not validate_emitted_formula
fail_case 1
end
wstr 1 p_1

note Test 2: valid Interplane URL, semver-prerelease, and date version
set_field 0 h_ok_ip
set_field 1 u_ok_ip
set_field 2 v_ok_sem
if not and valid_homepage and valid_url valid_version
fail_case 2
end
set_field 2 v_ok_date
if not valid_version
fail_case 2
end
wstr 1 p_2

note Test 3: negative control - invalid versions
set_field 2 v_bad_2part
if valid_version
fail_case 3
end
set_field 2 v_bad_dots
if valid_version
fail_case 3
end
set_field 2 v_bad_pfx
if valid_version
fail_case 3
end
set_field 2 v_bad_date
if valid_version
fail_case 3
end
set_field 2 v_bad_trail
if valid_version
fail_case 3
end
wstr 1 p_3

note Test 4: negative control - disallowed URLs & path traversal
set_field 1 u_bad_http
if valid_url
fail_case 4
end
set_field 1 u_bad_host
if valid_url
fail_case 4
end
set_field 1 u_bad_ext
if valid_url
fail_case 4
end
set_field 1 u_bad_trav
if valid_url
fail_case 4
end
wstr 1 p_4

note Test 5: negative control - malformed SHA-256 digests
set_field 3 s_bad_short
if valid_sha_field 0
fail_case 5
end
set_field 3 s_bad_upper
if valid_sha_field 0
fail_case 5
end
set_field 5 s_bad_char
if valid_sha_field 1
fail_case 5
end
wstr 1 p_5

note Test 6: negative control - Ruby/shell injection characters
set_field 2 v_inj_interp
if valid_version
fail_case 6
end
set_field 2 v_inj_quote
if valid_version
fail_case 6
end
set_field 2 v_inj_semi
if valid_version
fail_case 6
end
set_field 1 u_bad_inj
if valid_url
fail_case 6
end
set_field 0 h_bad_inj
if valid_homepage
fail_case 6
end
set_field 4 l_bad_inj
if valid_license
fail_case 6
end
wstr 1 p_6

note Test 7: negative control - tampered formula missing linux/odie checks
out_clear
out_push_lit bad_rb
if validate_emitted_formula
fail_case 7
end
wstr 1 p_7

wstr 1 p_all
ret 0
end

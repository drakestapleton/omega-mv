om2
note si/packages/homebrew/formula.om: Deterministic Homebrew Ruby formula generator and validator.
note Faithful pure-Omega conversion of homebrew-omega (Formula/omc.rb).
note Reads key=value manifest on stdin (version, url, sha256, omc_sha256, optional homepage, license),
note validates semver/date version, allowed HTTPS archive URL prefix, 64-hex lowercase SHA-256 digests,
note rejects Ruby/shell injection characters, emits canonical Formula/omc.rb on stdout, and self-validates.
note Exit codes: 0 = emitted valid formula, 1 = validation refusal, 2 = missing fields or I/O error.

global inbuf uchar 8192
global rdbuf uchar 2048
global outbuf uchar 8192
global f_ver uchar 128
global f_url uchar 384
global f_sha uchar 128
global f_omc uchar 128
global f_home uchar 384
global f_lic uchar 128
global meta ulong 16

const k_inlen ulong 0
const k_outlen ulong 1
const k_vlen ulong 2
const k_ulen ulong 3
const k_slen ulong 4
const k_olen ulong 5
const k_hlen ulong 6
const k_llen ulong 7
const k_err ulong 8

text pfx_ver "version="
text pfx_url "url="
text pfx_sha "sha256="
text pfx_omc "omc_sha256="
text pfx_home "homepage="
text pfx_lic "license="

text def_home "https://github.com/aien-dev/omega-mv"
text def_lic "Apache-2.0"

text allow_p1 "https://interplane.io/"
text allow_p2 "https://github.com/aien-dev/"
text allow_p3 "https://github.com/drakestapleton/"
text sfx_tgz ".tar.gz"
text sfx_txz ".tar.xz"

text rb_hdr "# omc, the Omega compiler, born from the 408-byte hand-written seed of aien-dev/omega-mv.\n# The build runs omega-mv's seed/omega-from-seed.sh (seed0 -> hex1 -> asm2 -> om4 -> omc -> omc -> omc)\n# using only sh, printf, cat, stat, sed, sha256sum and cmp, then refuses any omc whose sha256 is not\n# the pinned one. AArch64 (arm64) Linux only: omc runs on and emits code for that platform alone.\nclass Omc < Formula\n  desc \"Omega compiler, born from a 408-byte hand-written seed\"\n  homepage \""
text rb_url "\"\n  url \""
text rb_ver "\"\n  version \""
text rb_sha "\"\n  sha256 \""
text rb_lic "\"\n  license \""
text rb_dep "\"\n\n  depends_on arch: :arm64\n  depends_on :linux\n\n  OMC_SHA256 = \""
text rb_inst "\".freeze\n\n  def install\n    system \"sh\", \"seed/omega-from-seed.sh\"\n    got = Digest::SHA256.file(\"seed/out/omc\").hexdigest\n    odie \"omc sha256 #{got} is not the pinned #{OMC_SHA256}\" if got != OMC_SHA256\n    bin.install \"seed/out/omc\"\n  end\n\n  test do\n    (testpath/\"hello.om\").write <<~OM\n      note hello: sum 1..10 and print \"omega 55\" through write\n      global out uchar 16\n      fn main to int\n      s = ulong 0\n      for i ulong 11\n      s = add s i\n      end\n      put out 0 111\n      put out 1 109\n      put out 2 101\n      put out 3 103\n      put out 4 97\n      put out 5 32\n      put out 6 uchar add div s 10 48\n      put out 7 uchar add rem s 10 48\n      put out 8 10\n      w = write 1 out 0 9\n      ret 0\n      end\n    OM\n    system \"sh\", \"-c\", \"#{bin}/omc < hello.om > hello\"\n    chmod 0755, testpath/\"hello\"\n    assert_equal \"omega 55\\n\", shell_output(\"./hello\")\n    assert_equal OMC_SHA256, Digest::SHA256.file(bin/\"omc\").hexdigest\n  end\nend\n"

text chk_cls "class Omc < Formula"
text chk_arm "depends_on arch: :arm64"
text chk_lin "depends_on :linux"
text chk_odi "odie \"omc sha256 "

text e_io "formula: failed to read stdin\n"
text e_miss "formula: missing required field (version, url, sha256, omc_sha256)\n"
text e_ver "formula: refused invalid or unsafe version\n"
text e_url "formula: refused invalid or disallowed url\n"
text e_sha "formula: refused invalid sha256 (need 64 lowercase hex)\n"
text e_omc "formula: refused invalid omc_sha256 (need 64 lowercase hex)\n"
text e_home "formula: refused invalid homepage\n"
text e_lic "formula: refused invalid license\n"
text e_self "formula: emitted formula failed self-validation\n"

fn write_all fd int src view uchar * off ulong n ulong to void
p = ulong 0
while lt p n bound 16384
k = write fd src add off p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wstr fd int s view uchar * to void
write_all fd s 0 len s
end

fn is_dig c uchar to bool
ret and ge c 48 le c 57
end

fn is_hex_low c uchar to bool
if is_dig c
ret true
end
ret and ge c 97 le c 102
end

fn is_alnum c uchar to bool
if is_dig c
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end

fn is_injection_ch c uchar to bool
if or lt c 32 gt c 126
ret true
end
if or eq c 34 eq c 39
ret true
end
if or eq c 96 eq c 92
ret true
end
if or eq c 36 eq c 35
ret true
end
if or eq c 59 eq c 124
ret true
end
if or eq c 38 eq c 40
ret true
end
if or eq c 41 eq c 123
ret true
end
if or eq c 125 or eq c 60 eq c 62
ret true
end
ret false
end

fn is_url_ch c uchar to bool
if is_alnum c
ret true
end
if or eq c 45 eq c 46
ret true
end
if or eq c 95 eq c 126
ret true
end
if or eq c 58 eq c 47
ret true
end
ret eq c 37
end

fn valid_sha_field which ulong to bool
n = ulong 0
if eq which 0
n = get meta k_slen
else
n = get meta k_olen
end
if ne n 64
ret false
end
i = ulong 0
while lt i 64 bound 64
c = uchar 0
if eq which 0
c = get f_sha i
else
c = get f_omc i
end
if not is_hex_low c
ret false
end
i = add i 1
end
ret true
end

fn valid_ver_ext pos ulong vlen ulong to bool
if ge pos vlen
ret false
end
seg = ulong 0
i = pos
while lt i vlen bound 128
c = get f_ver i
if is_injection_ch c
ret false
end
if eq c 46
if eq seg 0
ret false
end
seg = ulong 0
else
if or is_alnum c eq c 45
seg = add seg 1
else
ret false
end
end
i = add i 1
end
ret gt seg 0
end

fn valid_date_ver to bool
j = ulong 0
while lt j 8 bound 8
if not is_dig get f_ver j
ret false
end
j = add j 1
end
yr = mul ulong sub get f_ver 0 48 1000
yr = add yr mul ulong sub get f_ver 1 48 100
yr = add yr mul ulong sub get f_ver 2 48 10
yr = add yr ulong sub get f_ver 3 48
mo = mul ulong sub get f_ver 4 48 10
mo = add mo ulong sub get f_ver 5 48
dy = mul ulong sub get f_ver 6 48 10
dy = add dy ulong sub get f_ver 7 48
if lt yr 2020
ret false
end
if or lt mo 1 gt mo 12
ret false
end
ret and ge dy 1 le dy 31
end

note valid_version: accepts semver MAJOR.MINOR.PATCH[-pre][+build] or YYYYMMDD (8 digits)
fn valid_version to bool
n = get meta k_vlen
if or eq n 0 gt n 64
ret false
end
i = ulong 0
while lt i n bound 128
if is_injection_ch get f_ver i
ret false
end
i = add i 1
end
if eq n 8
if valid_date_ver
ret true
end
end
dots = ulong 0
seg = ulong 0
p = ulong 0
while lt p n bound 128
c = get f_ver p
if is_dig c
seg = add seg 1
else
if eq c 46
if or eq seg 0 ge dots 2
ret false
end
dots = add dots 1
seg = ulong 0
else
if or eq c 45 eq c 43
if or ne dots 2 eq seg 0
ret false
end
ret valid_ver_ext add p 1 n
else
ret false
end
end
end
p = add p 1
end
ret and eq dots 2 gt seg 0
end

fn url_starts_with pfx view uchar * is_home bool to bool
pl = len pfx
ul = ulong 0
if is_home
ul = get meta k_hlen
else
ul = get meta k_ulen
end
if lt ul pl
ret false
end
i = ulong 0
while lt i pl bound 64
c = uchar 0
if is_home
c = get f_home i
else
c = get f_url i
end
if ne c get pfx i
ret false
end
i = add i 1
end
ret true
end

fn url_ends_with sfx view uchar * to bool
sl = len sfx
ul = get meta k_ulen
if lt ul sl
ret false
end
off = sub ul sl
i = ulong 0
while lt i sl bound 32
if ne get f_url add off i get sfx i
ret false
end
i = add i 1
end
ret true
end

fn url_has_dotdot is_home bool to bool
ul = ulong 0
if is_home
ul = get meta k_hlen
else
ul = get meta k_ulen
end
if lt ul 2
ret false
end
i = ulong 0
lim = sub ul 1
while lt i lim bound 384
a = uchar 0
b = uchar 0
if is_home
a = get f_home i
b = get f_home add i 1
else
a = get f_url i
b = get f_url add i 1
end
if and eq a 46 eq b 46
ret true
end
i = add i 1
end
ret false
end

fn valid_url to bool
ul = get meta k_ulen
if or lt ul 16 gt ul 320
ret false
end
ok_pfx = false
if url_starts_with allow_p1 false
ok_pfx = true
end
if url_starts_with allow_p2 false
ok_pfx = true
end
if url_starts_with allow_p3 false
ok_pfx = true
end
if not ok_pfx
ret false
end
ok_sfx = false
if url_ends_with sfx_tgz
ok_sfx = true
end
if url_ends_with sfx_txz
ok_sfx = true
end
if not ok_sfx
ret false
end
if url_has_dotdot false
ret false
end
i = ulong 0
while lt i ul bound 384
c = get f_url i
if or is_injection_ch c not is_url_ch c
ret false
end
i = add i 1
end
ret true
end

fn valid_homepage to bool
hl = get meta k_hlen
if or lt hl 16 gt hl 320
ret false
end
ok_pfx = false
if url_starts_with allow_p1 true
ok_pfx = true
end
if url_starts_with allow_p2 true
ok_pfx = true
end
if url_starts_with allow_p3 true
ok_pfx = true
end
if not ok_pfx
ret false
end
if url_has_dotdot true
ret false
end
i = ulong 0
while lt i hl bound 384
c = get f_home i
if or is_injection_ch c not is_url_ch c
ret false
end
i = add i 1
end
ret true
end

fn valid_license to bool
ll = get meta k_llen
if or eq ll 0 gt ll 64
ret false
end
i = ulong 0
while lt i ll bound 64
c = get f_lic i
if is_injection_ch c
ret false
end
ok = false
if is_alnum c
ok = true
end
if or eq c 45 or eq c 46 or eq c 43 eq c 32
ok = true
end
if not ok
ret false
end
i = add i 1
end
ret true
end

note Output builder helpers
fn out_clear to void
put meta k_outlen 0
end

fn out_push_lit s view uchar * to void
sl = len s
p = get meta k_outlen
i = ulong 0
while lt i sl bound 4096
if lt p 8192
put outbuf p get s i
p = add p 1
end
i = add i 1
end
put meta k_outlen p
end

fn out_push_field which ulong to void
p = get meta k_outlen
n = ulong 0
if eq which 0
n = get meta k_hlen
else
if eq which 1
n = get meta k_ulen
else
if eq which 2
n = get meta k_vlen
else
if eq which 3
n = get meta k_slen
else
if eq which 4
n = get meta k_llen
else
n = get meta k_olen
end
end
end
end
end
i = ulong 0
while lt i n bound 384
c = uchar 0
if eq which 0
c = get f_home i
else
if eq which 1
c = get f_url i
else
if eq which 2
c = get f_ver i
else
if eq which 3
c = get f_sha i
else
if eq which 4
c = get f_lic i
else
c = get f_omc i
end
end
end
end
end
if lt p 8192
put outbuf p c
p = add p 1
end
i = add i 1
end
put meta k_outlen p
end

fn emit_formula to void
out_clear
out_push_lit rb_hdr
out_push_field 0
out_push_lit rb_url
out_push_field 1
out_push_lit rb_ver
out_push_field 2
out_push_lit rb_sha
out_push_field 3
out_push_lit rb_lic
out_push_field 4
out_push_lit rb_dep
out_push_field 5
out_push_lit rb_inst
end

fn out_starts_at pos ulong needle view uchar * to bool
nl = len needle
tot = get meta k_outlen
if gt add pos nl tot
ret false
end
i = ulong 0
while lt i nl bound 128
if ne get outbuf add pos i get needle i
ret false
end
i = add i 1
end
ret true
end

fn out_contains needle view uchar * to bool
nl = len needle
tot = get meta k_outlen
if gt nl tot
ret false
end
lim = add sub tot nl 1
i = ulong 0
while lt i lim bound 8192
if out_starts_at i needle
ret true
end
i = add i 1
end
ret false
end

fn validate_emitted_formula to bool
if not out_contains chk_cls
ret false
end
if not out_contains chk_arm
ret false
end
if not out_contains chk_lin
ret false
end
if not out_contains chk_odi
ret false
end
ret true
end

fn in_starts off ulong llen ulong pfx view uchar * to bool
pl = len pfx
if lt llen pl
ret false
end
i = ulong 0
while lt i pl bound 64
if ne get inbuf add off i get pfx i
ret false
end
i = add i 1
end
ret true
end

fn copy_in_to_field which ulong off ulong n ulong to void
lim = ulong 128
if or eq which 0 eq which 1
lim = ulong 384
end
if gt n lim
n = lim
end
i = ulong 0
while lt i n bound 384
c = get inbuf add off i
if eq which 0
put f_home i c
else
if eq which 1
put f_url i c
else
if eq which 2
put f_ver i c
else
if eq which 3
put f_sha i c
else
if eq which 4
put f_lic i c
else
put f_omc i c
end
end
end
end
end
i = add i 1
end
if eq which 0
put meta k_hlen n
else
if eq which 1
put meta k_ulen n
else
if eq which 2
put meta k_vlen n
else
if eq which 3
put meta k_slen n
else
if eq which 4
put meta k_llen n
else
put meta k_olen n
end
end
end
end
end
end

fn set_defaults to void
for i ulong 16
put meta i 0
end
hl = len def_home
i = ulong 0
while lt i hl bound 128
put f_home i get def_home i
i = add i 1
end
put meta k_hlen hl
ll = len def_lic
j = ulong 0
while lt j ll bound 64
put f_lic j get def_lic j
j = add j 1
end
put meta k_llen ll
end

fn parse_manifest to void
tot = get meta k_inlen
pos = ulong 0
while lt pos tot bound 8192
ls = pos
while lt pos tot bound 8192
if eq get inbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
if gt ll 0
if ne get inbuf ls 35
if in_starts ls ll pfx_ver
copy_in_to_field 2 add ls 8 sub ll 8
else
if in_starts ls ll pfx_url
copy_in_to_field 1 add ls 4 sub ll 4
else
if in_starts ls ll pfx_sha
copy_in_to_field 3 add ls 7 sub ll 7
else
if in_starts ls ll pfx_omc
copy_in_to_field 5 add ls 11 sub ll 11
else
if in_starts ls ll pfx_home
copy_in_to_field 0 add ls 9 sub ll 9
else
if in_starts ls ll pfx_lic
copy_in_to_field 4 add ls 8 sub ll 8
end
end
end
end
end
end
end
end
if lt pos tot
pos = add pos 1
end
end
end

fn read_stdin to bool
tot = ulong 0
while true bound 64
k = read 0 rdbuf 0 2048
if lt k 0
ret false
end
if eq k 0
break
end
kn = ulong k
i = ulong 0
while lt i kn bound 2048
c = get rdbuf i
if ne c 13
if ge tot 8192
ret false
end
put inbuf tot c
tot = add tot 1
end
i = add i 1
end
end
put meta k_inlen tot
ret true
end

fn flush_outbuf to void
n = get meta k_outlen
p = ulong 0
while lt p n bound 8192
k = write 1 outbuf p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn main to int
set_defaults
if not read_stdin
wstr 2 e_io
ret 2
end
parse_manifest
if or eq get meta k_vlen 0 or eq get meta k_ulen 0 or eq get meta k_slen 0 eq get meta k_olen 0
wstr 2 e_miss
ret 2
end
if not valid_version
wstr 2 e_ver
ret 1
end
if not valid_url
wstr 2 e_url
ret 1
end
if not valid_sha_field 0
wstr 2 e_sha
ret 1
end
if not valid_sha_field 1
wstr 2 e_omc
ret 1
end
if not valid_homepage
wstr 2 e_home
ret 1
end
if not valid_license
wstr 2 e_lic
ret 1
end
emit_formula
if not validate_emitted_formula
wstr 2 e_self
ret 1
end
flush_outbuf
ret 0
end

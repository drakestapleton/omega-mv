om2
note SPDX-License-Identifier: Apache-2.0
note si/release-1.0/si_release_gate.om: Pure seeded-OM-2 Sovereign Intelligence 1.0 Readiness Gate.
note
note Build:
note   seed/out/omc < si/release-1.0/si_release_gate.om > si_release_gate && chmod +x si_release_gate
note Run:
note   si_release_gate MANIFEST-1.0.tsv seed/out/omc.sha256
note
note Verifies the Sovereign Intelligence 1.0 Readiness Ledger fail-closed:
note   1. All 10 required 1.0 repositories are present with zero duplicates:
note      omega-mv, omega-helix, omega-seats, omega-wattd, omega-gpu-driver,
note      omega-sm121-sass, omega-ng-egraph, rtl8127-omega, aienux, sovereign-intelligence.
note   2. Every row has an exact 40-lowercase-hex non-zero commit SHA.
note   3. Every row's omc_sha256 is exact 64-lowercase-hex matching the pinned seed/out/omc.sha256.
note   4. Every row carries an honest recognized evidence_class; PASS requires exercised/qualified evidence.
note   5. FAIL and MISSING_IMPLEMENTATION are UNWAIVABLE hard blockers (refused even with WAIVER-).
note   6. NOT_RUN, BLOCKED_HARDWARE, and BLOCKED_OPERATOR block unless paired with a valid WAIVER- token.
note   7. Refuses to emit 1.0-READY (exit 1, naming every open blocker) until every bar item is green.
note   8. Only when blockers == 0 and all 10 required repos pass, stamps 1.0-READY with manifest SHA-256 (exit 0).
note
note Exit codes: 0 = STAMP 1.0-READY, 1 = REFUSED 1.0-HOLD, 2 = bad usage or unreadable/malformed input.

note ---- Embedded FIPS 180-4 SHA-256 (pure OM-2, zero external deps)
global s2_ok ulong 1
global s2_k uint 64
global s2_h uint 8
global s2_w uint 64
global s2_buf uchar 64
global s2_n ulong 1
global s2_tot ulong 1
global s2_out uchar 32

note ---- Gate buffers and state
global g_man uchar 1048576
global g_pinf uchar 4096
global g_pin uchar 64
global g_path uchar 4096
global g_out uchar 131072
global g_n ulong 32
global g_col_o ulong 16
global g_col_n ulong 16
global g_seen_o ulong 256
global g_seen_n ulong 256
global g_row_blk ulong 1
note g_n slots:
note   0=man_len, 1=out_len, 2=data_rows, 3=req_mask, 4=seen_cnt,
note   5=blockers, 6=waived, 7=parse_err, 8=col_cnt, 9=hdr_seen, 10=path_len

text t_usage "usage: si_release_gate MANIFEST-1.0.tsv OMC_SHA256_FILE\n"
text t_badpin "si_release_gate: INVALID cannot read 64-hex pin from OMC_SHA256_FILE\n"
text t_badman "si_release_gate: INVALID cannot read MANIFEST file\n"
text t_nohdr "si_release_gate: INVALID missing expected TSV header row\n"
text t_hdr "repo\tcommit_sha\tomc_sha256\tevidence_class\tverdict\twaiver\tblocker_detail"

note Required 10 repositories (bits 0..9, target mask = 1023)
text r_0 "omega-mv"
text r_1 "omega-helix"
text r_2 "omega-seats"
text r_3 "omega-wattd"
text r_4 "omega-gpu-driver"
text r_5 "omega-sm121-sass"
text r_6 "omega-ng-egraph"
text r_7 "rtl8127-omega"
text r_8 "aienux"
text r_9 "sovereign-intelligence"

note Honest evidence classes
text ev_qs "QUALIFIED_SILICON"
text ev_qh "QUALIFIED_HOST"
text ev_es "EXERCISED_SILICON"
text ev_eh "EXERCISED_HOST"
text ev_ee "EXERCISED_EMULATED"
text ev_im "IMPLEMENTED"
text ev_pr "PROPOSED"
text ev_nr "NOT_RUN"

note Canonical verdict words
text vd_pass "PASS"
text vd_fail "FAIL"
text vd_miss "MISSING_IMPLEMENTATION"
text vd_nr "NOT_RUN"
text vd_bhw "BLOCKED_HARDWARE"
text vd_bop "BLOCKED_OPERATOR"

text t_dash "-"
text t_wpre "WAIVER-"
text t_blk_p "BLOCKER repo="
text t_rea_p " reason="
text t_det_p " detail="
text t_ok_p "OK repo="
text t_sha_p " sha="
text t_ev_p " evidence="
text t_vd_p " verdict="
text t_wv_p " waiver="

text b_cols "MALFORMED_ROW_COLUMNS"
text b_ctrl "CONTROL_BYTE_IN_ROW"
text b_dup "DUPLICATE_REPO"
text b_sha "BAD_COMMIT_SHA_NOT_40HEX"
text b_shaz "ZERO_COMMIT_SHA"
text b_omcf "BAD_OMC_SHA256_FORMAT"
text b_omcm "OMC_SHA256_PIN_MISMATCH"
text b_evbad "UNKNOWN_EVIDENCE_CLASS"
text b_evlow "INSUFFICIENT_EVIDENCE_FOR_PASS"
text b_vdbad "UNKNOWN_VERDICT"
text b_fail "UNWAIVABLE_FAIL"
text b_miss "UNWAIVABLE_MISSING_IMPLEMENTATION"
text b_unw "UNWAIVED_BLOCKER"
text b_wbad "INVALID_WAIVER_TOKEN"
text b_req "MISSING_REQUIRED_REPO"

text t_stamp "STAMP 1.0-READY repos="
text t_refus "REFUSED 1.0-HOLD repos="
text t_sreq " required="
text t_s10 "/10 blockers="
text t_swaiv " waived="
text t_somc " omc="
text t_smsha " manifest_sha256="
text t_d_row "expected exactly 7 tab-separated columns"
text t_d_dup "repository listed more than once in manifest"
text t_d_req "required 1.0 repository absent from manifest"

note ---- SHA-256 implementation
fn s2_setup to void
if eq get s2_ok 0 1
ret
end
put s2_k 0 1116352408
put s2_k 1 1899447441
put s2_k 2 3049323471
put s2_k 3 3921009573
put s2_k 4 961987163
put s2_k 5 1508970993
put s2_k 6 2453635748
put s2_k 7 2870763221
put s2_k 8 3624381080
put s2_k 9 310598401
put s2_k 10 607225278
put s2_k 11 1426881987
put s2_k 12 1925078388
put s2_k 13 2162078206
put s2_k 14 2614888103
put s2_k 15 3248222580
put s2_k 16 3835390401
put s2_k 17 4022224774
put s2_k 18 264347078
put s2_k 19 604807628
put s2_k 20 770255983
put s2_k 21 1249150122
put s2_k 22 1555081692
put s2_k 23 1996064986
put s2_k 24 2554220882
put s2_k 25 2821834349
put s2_k 26 2952996808
put s2_k 27 3210313671
put s2_k 28 3336571891
put s2_k 29 3584528711
put s2_k 30 113926993
put s2_k 31 338241895
put s2_k 32 666307205
put s2_k 33 773529912
put s2_k 34 1294757372
put s2_k 35 1396182291
put s2_k 36 1695183700
put s2_k 37 1986661051
put s2_k 38 2177026350
put s2_k 39 2456956037
put s2_k 40 2730485921
put s2_k 41 2820302411
put s2_k 42 3259730800
put s2_k 43 3345764771
put s2_k 44 3516065817
put s2_k 45 3600352804
put s2_k 46 4094571909
put s2_k 47 275423344
put s2_k 48 430227734
put s2_k 49 506948616
put s2_k 50 659060556
put s2_k 51 883997877
put s2_k 52 958139571
put s2_k 53 1322822218
put s2_k 54 1537002063
put s2_k 55 1747873779
put s2_k 56 1955562222
put s2_k 57 2024104815
put s2_k 58 2227730452
put s2_k 59 2361852424
put s2_k 60 2428436474
put s2_k 61 2756734187
put s2_k 62 3204031479
put s2_k 63 3329325298
put s2_ok 0 1
end

fn s2_init to void
s2_setup
put s2_h 0 1779033703
put s2_h 1 3144134277
put s2_h 2 1013904242
put s2_h 3 2773480762
put s2_h 4 1359893119
put s2_h 5 2600822924
put s2_h 6 528734635
put s2_h 7 1541459225
put s2_n 0 0
put s2_tot 0 0
end

fn s2_rounds to void
a = get s2_h 0
b = get s2_h 1
c = get s2_h 2
d = get s2_h 3
e = get s2_h 4
f = get s2_h 5
g = get s2_h 6
h = get s2_h 7
for r2 ulong 64
x2 = or shr e 6 shl e 26
x2 = xor x2 or shr e 11 shl e 21
x2 = xor x2 or shr e 25 shl e 7
x2 = add x2 h
x2 = add x2 xor and e f and not e g
x2 = add x2 get s2_k r2
x2 = add x2 get s2_w r2
h = g
g = f
f = e
e = add d x2
d = c
c = b
b = a
y2 = or shr b 2 shl b 30
y2 = xor y2 or shr b 13 shl b 19
y2 = xor y2 or shr b 22 shl b 10
x2 = add x2 y2
y2 = xor and b c and b d
y2 = xor y2 and c d
a = add x2 y2
end
put s2_h 0 add get s2_h 0 a
put s2_h 1 add get s2_h 1 b
put s2_h 2 add get s2_h 2 c
put s2_h 3 add get s2_h 3 d
put s2_h 4 add get s2_h 4 e
put s2_h 5 add get s2_h 5 f
put s2_h 6 add get s2_h 6 g
put s2_h 7 add get s2_h 7 h
end

fn s2_compress to void
for t ulong 16
p = mul t 4
v = or shl uint get s2_buf p 24 shl uint get s2_buf add p 1 16
v = or v or shl uint get s2_buf add p 2 8 uint get s2_buf add p 3
put s2_w t v
end
for u ulong 48
i = add u 16
x = get s2_w sub i 2
s = or shr x 17 shl x 15
s = xor s or shr x 19 shl x 13
s = xor s shr x 10
y = get s2_w sub i 15
r = or shr y 7 shl y 25
r = xor r or shr y 18 shl y 14
r = xor r shr y 3
s = add s get s2_w sub i 7
r = add r get s2_w sub i 16
put s2_w i add s r
end
s2_rounds
end

fn s2_byte b uchar to void
n = get s2_n 0
put s2_buf n b
n = add n 1
if eq n 64
s2_compress
n = ulong 0
end
put s2_n 0 n
put s2_tot 0 add get s2_tot 0 1
end

fn s2_fin to void
bits = mul get s2_tot 0 8
n = get s2_n 0
put s2_buf n 128
n = add n 1
if gt n 56
while lt n 64 bound 64
put s2_buf n 0
n = add n 1
end
s2_compress
n = ulong 0
end
while lt n 56 bound 64
put s2_buf n 0
n = add n 1
end
for k ulong 8
put s2_buf add 56 k uchar and shr bits mul sub 7 k 8 255
end
s2_compress
put s2_n 0 0
for j ulong 8
w = ulong get s2_h j
o = mul j 4
put s2_out o uchar and shr w 24 255
put s2_out add o 1 uchar and shr w 16 255
put s2_out add o 2 uchar and shr w 8 255
put s2_out add o 3 uchar and w 255
end
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

note ---- Output helpers
fn oflush to void
n = get g_n 1
p = ulong 0
while lt p n bound 131073
k = write 1 g_out p sub n p
if le k 0
break
end
p = add p ulong k
end
put g_n 1 0
end

fn oc c uchar to void
n = get g_n 1
if ge n 131000
oflush
n = get g_n 1
end
put g_out n c
put g_n 1 add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 4096
oc get t i
end
end

fn om o ulong n ulong to void
lim = n
if gt lim 512
lim = 512
end
for i ulong lim bound 512
oc get g_man add o i
end
end

fn onum v ulong to void
if ge v 10
onum div v 10
end
oc uchar add 48 rem v 10
end

fn ohex32 to void
for j ulong 32
b = ulong get s2_out j
oc hexd shr b 4
oc hexd and b 15
end
end

fn opin16 to void
for j ulong 16
oc get g_pin j
end
end

note ---- Byte/slice predicates on g_man
fn is_lhex c uchar to bool
d = and ge c 48 le c 57
h = and ge c 97 le c 102
ret or d h
end

fn eq_mt o ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get g_man add o i get t i
ret false
end
end
ret true
end

fn eq_mm o1 ulong n1 ulong o2 ulong n2 ulong to bool
if ne n1 n2
ret false
end
for i ulong n1 bound 4096
if ne get g_man add o1 i get g_man add o2 i
ret false
end
end
ret true
end

fn has_prefix o ulong n ulong t view uchar * to bool
if lt n len t
ret false
end
for i ulong len t bound 64
if ne get g_man add o i get t i
ret false
end
end
ret true
end

fn valid_hex o ulong n ulong want ulong to bool
if ne n want
ret false
end
for i ulong n bound 128
if not is_lhex get g_man add o i
ret false
end
end
ret true
end

fn all_zero o ulong n ulong to bool
for i ulong n bound 128
if ne get g_man add o i 48
ret false
end
end
ret true
end

fn pin_matches o ulong n ulong to bool
if ne n 64
ret false
end
for i ulong 64
if ne get g_man add o i get g_pin i
ret false
end
end
ret true
end

note valid waiver token: starts with WAIVER-, length 10..80, only A-Z a-z 0-9 _ -
fn valid_waiver o ulong n ulong to bool
if or lt n 10 gt n 80
ret false
end
if not has_prefix o n t_wpre
ret false
end
for i ulong n bound 80
c = get g_man add o i
ok = or and ge c 48 le c 57 and ge c 65 le c 90
ok = or ok or and ge c 97 le c 122 or eq c 45 eq c 95
if not ok
ret false
end
end
ret true
end

note ---- Required 10-repo lookup: returns 0..9 or 99 if not in required 10
fn req_idx o ulong n ulong to ulong
if eq_mt o n r_0
ret 0
end
if eq_mt o n r_1
ret 1
end
if eq_mt o n r_2
ret 2
end
if eq_mt o n r_3
ret 3
end
if eq_mt o n r_4
ret 4
end
if eq_mt o n r_5
ret 5
end
if eq_mt o n r_6
ret 6
end
if eq_mt o n r_7
ret 7
end
if eq_mt o n r_8
ret 8
end
if eq_mt o n r_9
ret 9
end
ret 99
end

fn emit_req_name idx ulong to void
if eq idx 0
ot r_0
ret
end
if eq idx 1
ot r_1
ret
end
if eq idx 2
ot r_2
ret
end
if eq idx 3
ot r_3
ret
end
if eq idx 4
ot r_4
ret
end
if eq idx 5
ot r_5
ret
end
if eq idx 6
ot r_6
ret
end
if eq idx 7
ot r_7
ret
end
if eq idx 8
ot r_8
ret
end
ot r_9
end

note ---- Evidence class classifier: 2 = exercised/qualified, 1 = recognized low, 0 = unknown
fn ev_class o ulong n ulong to ulong
if or eq_mt o n ev_qs eq_mt o n ev_qh
ret 2
end
if or eq_mt o n ev_es or eq_mt o n ev_eh eq_mt o n ev_ee
ret 2
end
if or eq_mt o n ev_im or eq_mt o n ev_pr eq_mt o n ev_nr
ret 1
end
ret 0
end

note ---- Blocker emission helpers
fn blk_row ro ulong rn ulong rea view uchar * do ulong dn ulong to void
ot t_blk_p
om ro rn
ot t_rea_p
ot rea
ot t_det_p
om do dn
oc 10
put g_n 5 add get g_n 5 1
put g_row_blk 0 add get g_row_blk 0 1
end

fn blk_row_t ro ulong rn ulong rea view uchar * det view uchar * to void
ot t_blk_p
om ro rn
ot t_rea_p
ot rea
ot t_det_p
ot det
oc 10
put g_n 5 add get g_n 5 1
put g_row_blk 0 add get g_row_blk 0 1
end

fn check_dup ro ulong rn ulong to bool
cnt = get g_n 4
for i ulong cnt bound 256
if eq_mm get g_seen_o i get g_seen_n i ro rn
ret true
end
end
if lt cnt 256
put g_seen_o cnt ro
put g_seen_n cnt rn
put g_n 4 add cnt 1
end
ret false
end

note ---- Parse columns of line g_man[s, e) into g_col_o / g_col_n
fn split_cols s ulong e ulong to ulong
cnt = ulong 0
p = s
while le p e bound 1048577
q = p
while lt q e bound 1048576
if eq get g_man q 9
break
end
q = add q 1
end
if lt cnt 16
put g_col_o cnt p
put g_col_n cnt sub q p
end
cnt = add cnt 1
if ge q e
break
end
p = add q 1
end
put g_n 8 cnt
ret cnt
end

fn has_ctrl s ulong e ulong to bool
for i ulong sub e s bound 1048576
c = get g_man add s i
if and lt c 32 ne c 9
ret true
end
if eq c 127
ret true
end
end
ret false
end

note ---- Validate verdict and waiver on current row
fn check_verdict ro ulong rn ulong evc ulong to void
vo = get g_col_o 4
vn = get g_col_n 4
wo = get g_col_o 5
wn = get g_col_n 5
do = get g_col_o 6
dn = get g_col_n 6

if eq_mt vo vn vd_pass
if ne evc 2
blk_row ro rn b_evlow do dn
end
if not eq_mt wo wn t_dash
if not valid_waiver wo wn
blk_row ro rn b_wbad wo wn
end
end
ret
end

if eq_mt vo vn vd_fail
blk_row ro rn b_fail do dn
ret
end

if eq_mt vo vn vd_miss
blk_row ro rn b_miss do dn
ret
end

if or eq_mt vo vn vd_nr or eq_mt vo vn vd_bhw eq_mt vo vn vd_bop
if valid_waiver wo wn
put g_n 6 add get g_n 6 1
ret
end
if eq_mt wo wn t_dash
blk_row ro rn b_unw do dn
else
blk_row ro rn b_wbad wo wn
end
ret
end

blk_row ro rn b_vdbad vo vn
end

note ---- Validate one data line g_man[s, e)
fn check_sha_col ro ulong rn ulong to void
so = get g_col_o 1
sn = get g_col_n 1
if not valid_hex so sn 40
blk_row ro rn b_sha so sn
else
if all_zero so sn
blk_row ro rn b_shaz so sn
end
end
end

fn check_omc_col ro ulong rn ulong to void
po = get g_col_o 2
pn = get g_col_n 2
if not valid_hex po pn 64
blk_row ro rn b_omcf po pn
else
if not pin_matches po pn
blk_row ro rn b_omcm po pn
end
end
end

fn emit_ok_row ro ulong rn ulong to void
ot t_ok_p
om ro rn
ot t_sha_p
om get g_col_o 1 12
ot t_ev_p
om get g_col_o 3 get g_col_n 3
ot t_vd_p
om get g_col_o 4 get g_col_n 4
if not eq_mt get g_col_o 5 get g_col_n 5 t_dash
ot t_wv_p
om get g_col_o 5 get g_col_n 5
end
oc 10
end

fn check_line s ulong e ulong to void
if eq s e
ret
end
if eq get g_man s 35
ret
end
if has_ctrl s e
blk_row_t s sub e s b_ctrl t_d_row
put g_n 7 add get g_n 7 1
ret
end
if eq get g_n 9 0
if eq_mt s sub e s t_hdr
put g_n 9 1
ret
end
put g_n 7 add get g_n 7 1
ret
end

nc = split_cols s e
if ne nc 7
blk_row_t s sub e s b_cols t_d_row
put g_n 7 add get g_n 7 1
ret
end

put g_row_blk 0 0
put g_n 2 add get g_n 2 1

ro = get g_col_o 0
rn = get g_col_n 0

if eq rn 0
blk_row_t s sub e s b_cols t_d_row
ret
end

if check_dup ro rn
blk_row_t ro rn b_dup t_d_dup
end

idx = req_idx ro rn
if lt idx 10
put g_n 3 or get g_n 3 shl ulong 1 idx
end

check_sha_col ro rn
check_omc_col ro rn

evc = ev_class get g_col_o 3 get g_col_n 3
if eq evc 0
blk_row ro rn b_evbad get g_col_o 3 get g_col_n 3
end

check_verdict ro rn evc

if eq get g_row_blk 0 0
emit_ok_row ro rn
end
end

note ---- File loading helpers
fn load_arg idx ulong to bool
r = argread idx g_path 0 4095
if le r 0
ret false
end
put g_n 10 ulong r
ret true
end

fn read_pin to bool
fd = fopen g_path 0 get g_n 10 524288 0
if lt fd 0
ret false
end
n = ulong 0
while lt n 4096 bound 4097
k = read int fd g_pinf n sub 4096 n
if lt k 0
z = fclose int fd
ret false
end
if eq k 0
break
end
n = add n ulong k
end
z = fclose int fd
if lt n 64
ret false
end
for j ulong 64
c = get g_pinf j
if not is_lhex c
ret false
end
put g_pin j c
end
ret true
end

fn read_man to bool
fd = fopen g_path 0 get g_n 10 524288 0
if lt fd 0
ret false
end
n = ulong 0
while lt n 1048576 bound 1048577
k = read int fd g_man n sub 1048576 n
if lt k 0
z = fclose int fd
ret false
end
if eq k 0
break
end
n = add n ulong k
end
z = fclose int fd
if or eq n 0 ge n 1048576
ret false
end
put g_n 0 n
ret true
end

fn count_req to ulong
m = get g_n 3
c = ulong 0
for i ulong 10
if ne and m shl ulong 1 i 0
c = add c 1
end
end
ret c
end

fn emit_missing_req to void
m = get g_n 3
for i ulong 10
if eq and m shl ulong 1 i 0
ot t_blk_p
emit_req_name i
ot t_rea_p
ot b_req
ot t_det_p
ot t_d_req
oc 10
put g_n 5 add get g_n 5 1
end
end
end

fn hash_man to void
s2_init
n = get g_n 0
for i ulong n bound 1048576
s2_byte get g_man i
end
s2_fin
end

fn main to int
if ne argcnt 3
w = write 2 t_usage 0 len t_usage
ret 2
end

if not load_arg 2
w = write 2 t_badpin 0 len t_badpin
ret 2
end
if not read_pin
w = write 2 t_badpin 0 len t_badpin
ret 2
end

if not load_arg 1
w = write 2 t_badman 0 len t_badman
ret 2
end
if not read_man
w = write 2 t_badman 0 len t_badman
ret 2
end

n = get g_n 0
p = ulong 0
while lt p n bound 1048577
q = p
while lt q n bound 1048576
if eq get g_man q 10
break
end
q = add q 1
end
check_line p q
p = add q 1
end

if eq get g_n 9 0
w = write 2 t_nohdr 0 len t_nohdr
ret 2
end

emit_missing_req
req_have = count_req
blks = get g_n 5
perr = get g_n 7

if and eq blks 0 and eq perr 0 eq req_have 10
hash_man
ot t_stamp
onum get g_n 2
ot t_sreq
onum req_have
ot t_s10
onum blks
ot t_swaiv
onum get g_n 6
ot t_somc
opin16
ot t_smsha
ohex32
oc 10
oflush
ret 0
end

ot t_refus
onum get g_n 2
ot t_sreq

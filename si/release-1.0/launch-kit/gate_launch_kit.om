note ---- SHA-256 (FIPS 180-4)
fn s2_setup to void
if eq get s2_ok 0 1
ret
end
put s2_k 0 1116352408
put s2_k 1 1899447441
put s2_k 2 3049323471
put s2_k 3 3921009573
put s2_k 4 961987163
put s2_k 5 1508970993
put s2_k 6 2453635748
put s2_k 7 2870763221
put s2_k 8 3624381080
put s2_k 9 310598401
put s2_k 10 607225278
put s2_k 11 1426881987
put s2_k 12 1925078388
put s2_k 13 2162078206
put s2_k 14 2614888103
put s2_k 15 3248222580
put s2_k 16 3835390401
put s2_k 17 4022224774
put s2_k 18 264347078
put s2_k 19 604807628
put s2_k 20 770255983
put s2_k 21 1249150122
put s2_k 22 1555081692
put s2_k 23 1996064986
put s2_k 24 2554220882
put s2_k 25 2821834349
put s2_k 26 2952996808
put s2_k 27 3210313671
put s2_k 28 3336571891
put s2_k 29 3584528711
put s2_k 30 113926993
put s2_k 31 338241895
put s2_k 32 666307205
put s2_k 33 773529912
put s2_k 34 1294757372
put s2_k 35 1396182291
put s2_k 36 1695183700
put s2_k 37 1986661051
put s2_k 38 2177026350
put s2_k 39 2456956037
put s2_k 40 2730485921
put s2_k 41 2820302411
put s2_k 42 3259730800
put s2_k 43 3345764771
put s2_k 44 3516065817
put s2_k 45 3600352804
put s2_k 46 4094571909
put s2_k 47 275423344
put s2_k 48 430227734
put s2_k 49 506948616
put s2_k 50 659060556
put s2_k 51 883997877
put s2_k 52 958139571
put s2_k 53 1322822218
put s2_k 54 1537002063
put s2_k 55 1747873779
put s2_k 56 1955562222
put s2_k 57 2024104815
put s2_k 58 2227730452
put s2_k 59 2361852424
put s2_k 60 2428436474
put s2_k 61 2756734187
put s2_k 62 3204031479
put s2_k 63 3329325298
put s2_ok 0 1
end

fn u32add a uint b uint to uint
ret uint and add ulong a ulong b 4294967295
end

fn s2_init to void
s2_setup
put s2_h 0 1779033703
put s2_h 1 3144134277
put s2_h 2 1013904242
put s2_h 3 2773480762
put s2_h 4 1359893119
put s2_h 5 2600822924
put s2_h 6 528734635
put s2_h 7 1541459225
put s2_n 0 0
put s2_tot 0 0
end

fn s2_sched to void
for i ulong 16
p = mul i 4
w = shl uint get s2_buf p 24
w = or w shl uint get s2_buf add p 1 16
w = or w shl uint get s2_buf add p 2 8
w = or w uint get s2_buf add p 3
put s2_w i w
end
for i ulong 48
idx = add i 16
x = get s2_w sub idx 15
s0 = xor xor rotr x 7 rotr x 18 shr x 3
y = get s2_w sub idx 2
s1 = xor xor rotr y 17 rotr y 19 shr y 10
t = u32add get s2_w sub idx 16 s0
t = u32add t get s2_w sub idx 7
put s2_w idx u32add t s1
end
end

fn s2_rnd i ulong to void
e = get s2_v 4
s1 = xor xor rotr e 6 rotr e 11 rotr e 25
ch = xor and e get s2_v 5 and not e get s2_v 6
t1 = u32add u32add get s2_v 7 s1 ch
t1 = u32add u32add t1 get s2_k i get s2_w i
a = get s2_v 0
s0 = xor xor rotr a 2 rotr a 13 rotr a 22
mj = xor xor and a get s2_v 1 and a get s2_v 2 and get s2_v 1 get s2_v 2
t2 = u32add s0 mj
for j ulong 7
k = sub 7 j
put s2_v k get s2_v sub k 1
end
put s2_v 4 u32add get s2_v 4 t1
put s2_v 0 u32add t1 t2
end

fn s2_blk to void
s2_sched
for i ulong 8
put s2_v i get s2_h i
end
for i ulong 64
s2_rnd i
end
for i ulong 8
put s2_h i u32add get s2_h i get s2_v i
end
end

fn s2_byte b uchar to void
n = get s2_n 0
put s2_buf n b
n = add n 1
put s2_tot 0 add get s2_tot 0 1
if eq n 64
s2_blk
n = 0
end
put s2_n 0 n
end

fn s2_fin to void
bits = mul get s2_tot 0 8
s2_byte 128
while ne get s2_n 0 56 bound 128
s2_byte 0
end
for i ulong 8
sh = mul sub 7 i 8
s2_byte uchar and shr bits sh 255
end
for i ulong 8
w = get s2_h i
o = mul i 4
put s2_out o uchar and shr w 24 255
put s2_out add o 1 uchar and shr w 16 255
put s2_out add o 2 uchar and shr w 8 255
put s2_out add o 3 uchar and w 255
end
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

note ---- Output helpers
fn sflush to void
n = get g_n 10
if gt n 0
r = write 1 g_std 0 n
put g_n 10 0
end
end

fn sb c uchar to void
n = get g_n 10
if ge n 32768
sflush
n = 0
end
put g_std n c
put g_n 10 add n 1
end

fn st t view uchar * to void
for i ulong len t bound 4096
sb get t i
end
end

fn sdec v ulong to void
x = v
n = ulong 0
if eq x 0
sb 48
ret
end
while gt x 0 bound 24
put g_dg n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 24
n = sub n 1
sb get g_dg n
end
end

fn werr t view uchar * to void
r = write 2 t 0 len t
end

note ---- Path builders
fn pclr to void
put g_n 4 0
end

fn pc c uchar to void
n = get g_n 4
put g_pa n c
put g_n 4 add n 1
end

fn pt t view uchar * to void
for i ulong len t bound 4096
pc get t i
end
end

fn pomc to void
for i ulong get g_n 0 bound 4096
pc get g_omc i
end
end

fn pkit to void
for i ulong get g_n 1 bound 4096
pc get g_kit i
end
end

fn ppinp to void
for i ulong get g_n 2 bound 4096
pc get g_pinp i
end
end

fn pscr to void
for i ulong get g_n 3 bound 4096
pc get g_scr i
end
end

fn pset_k suf view uchar * to void
pclr
pkit
pt suf
end

fn pset_k_rel rel view uchar * to void
pclr
pkit
pc 47
pt rel
end

fn pset_s suf view uchar * to void
pclr
pscr
pt suf
end

note ---- File helpers
fn fclo fd int to void
if ge fd 0
z = fclose fd
end
end

fn frd to int
r = fopen g_pa 0 get g_n 4 524288 0
if lt r 0
ret -1
end
ret int r
end

fn fwr to int
r = fopen g_pa 0 get g_n 4 524865 420
if lt r 0
ret -1
end
ret int r
end

fn fexe to int
z = unlink g_pa 0 get g_n 4
r = fopen g_pa 0 get g_n 4 524865 448
if lt r 0
ret -1
end
ret int r
end

fn hash_pa to bool
fd = frd
if lt fd 0
ret false
end
s2_init
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
fclo fd
ret false
end
if eq k 0
break
end
for i ulong ulong k bound 65536
s2_byte get g_fbuf i
end
end
fclo fd
s2_fin
ret true
end

fn file_size_pa to ulong
fd = frd
if lt fd 0
ret shl ulong 1 63
end
tot = ulong 0
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
fclo fd
ret shl ulong 1 63
end
if eq k 0
break
end
tot = add tot ulong k
end
fclo fd
ret tot
end

fn save_d1 to void
for j ulong 32
put g_d1 j get s2_out j
end
end

fn save_d2 to void
for j ulong 32
put g_d2 j get s2_out j
end
end

fn d1_eq_d2 to bool
for j ulong 32
if ne get g_d1 j get g_d2 j
ret false
end
end
ret true
end

fn s2_eq_pin to bool
for j ulong 32
b = ulong get s2_out j
if ne get g_pin mul j 2 hexd shr b 4
ret false
end
if ne get g_pin add mul j 2 1 hexd and b 15
ret false
end
end
ret true
end

fn s2_eq_sums_hex off ulong to bool
for j ulong 32
b = ulong get s2_out j
if ne get g_sums add off mul j 2 hexd shr b 4
ret false
end
if ne get g_sums add off add mul j 2 1 hexd and b 15
ret false
end
end
ret true
end

fn read_cap_pa to bool
fd = frd
if lt fd 0
put g_n 8 0
ret false
end
tot = ulong 0
while lt tot 131072 bound 16384
k = read fd g_cap tot sub 131072 tot
if lt k 0
fclo fd
put g_n 8 0
ret false
end
if eq k 0
break
end
tot = add tot ulong k
end
fclo fd
put g_n 8 tot
ret true
end

fn load_cap_txt t view uchar * to void
n = len t
for i ulong n bound 4096
put g_cap i get t i
end
put g_n 8 n
end

fn cap_has pat view uchar * to bool
pn = len pat
cn = get g_n 8
if or eq pn 0 gt pn cn
ret false
end
lim = add sub cn pn 1
for i ulong lim bound 131072
ok = true
for j ulong pn bound 512
if ne get g_cap add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

note ---- Process runner for 2x self-compile
fn aclr to void
put g_n 5 2
put g_n 6 0
put g_av 0 0
put g_av 1 0
end

fn apa to void
p = get g_n 5
n = get g_n 4
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 5 add p add n 2
c = add get g_n 6 1
put g_n 6 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end

fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end

fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
z = execprog g_av 0 get g_n 5
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 60000000000
z = killpid int pid 9
z = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
z = sleepns 200000
end
exit 2
end

fn compile_self out_s view uchar * err_s view uchar * to ulong
pset_k f_self
fi = frd
aclr
pclr
pomc
apa
pset_s out_s
fo = fexe
pset_s err_s
fe = fwr
ret spawn fi fo fe
end

fn check_2x_compile to bool
r1 = compile_self s_b1 s_e1
r2 = compile_self s_b2 s_e2
if or ne r1 0 ne r2 0
ret false
end
pset_s s_e1
if ne file_size_pa 0
ret false
end
pset_s s_e2
if ne file_size_pa 0
ret false
end
pset_s s_b1
if not hash_pa
ret false
end
save_d1
pset_s s_b2
if not hash_pa
ret false
end
save_d2
ret d1_eq_d2
end

note ---- JPEG magic (FF D8 FF) & strict < 1,000,000 byte check
fn check_jpeg_pa to bool
fd = frd
if lt fd 0
ret false
end
k = read fd g_fbuf 0 65536
if lt k 4
fclo fd
ret false
end
if or ne get g_fbuf 0 255 or ne get g_fbuf 1 216 ne get g_fbuf 2 255
fclo fd
ret false
end
tot = ulong k
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
fclo fd
ret false
end
if eq k 0
break
end
tot = add tot ulong k
if ge tot 1000000
fclo fd
ret false
end
end
fclo fd
ret and gt tot 0 lt tot 1000000
end

note ---- Policy cleanliness scan on g_cap
fn cap_policy_clean to bool
if or cap_has fb_u1 cap_has fb_u2
ret false
end
if or cap_has fb_c1 cap_has fb_c2
ret false
end
if or cap_has fb_c3 cap_has fb_c4
ret false
end
if or cap_has fb_s1 or cap_has fb_s2 or cap_has fb_s3 cap_has fb_s4
ret false
end
if or cap_has fb_e1 or cap_has fb_e2 or cap_has fb_e3 or cap_has fb_e4 cap_has fb_e5
ret false
end
ret true
end

note ---- SHA256SUMS.txt parser & verifier
fn is_lhex c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 102
ret true
end
ret false
end

fn load_pin to bool
pclr
ppinp
fd = frd
if lt fd 0
ret false
end
k = read fd g_fbuf 0 256
fclo fd
if lt k 64
ret false
end
for i ulong 64
c = get g_fbuf i
if not is_lhex c
ret false
end
put g_pin i c
end
ret true
end

fn sums_span_eq off ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 256
if ne get g_sums add off i get t i
ret false
end
end
ret true
end

fn mark_known_sum off ulong n ulong to void
if sums_span_eq off n r_j1
put g_seen 0 1
end
if sums_span_eq off n r_j2
put g_seen 1 1
end
if sums_span_eq off n r_j3
put g_seen 2 1
end
if sums_span_eq off n r_j4
put g_seen 3 1
end
if sums_span_eq off n r_lk
put g_seen 4 1
end
if sums_span_eq off n r_llms
put g_seen 5 1
end
if sums_span_eq off n r_orca
put g_seen 6 1
end
end

fn load_sums_file to bool
pset_k f_sums
fd = frd
if lt fd 0
ret false
end
tot = ulong 0
while lt tot 65536 bound 4096
k = read fd g_sums tot sub 65536 tot
if lt k 0
fclo fd
ret false
end
if eq k 0
break
end
tot = add tot ulong k
end
fclo fd
put g_n 9 tot
ret gt tot 0
end

fn check_one_sum_line s ulong e ulong to bool
if lt sub e s 67
ret false
end
for i ulong 64
if not is_lhex get g_sums add s i
ret false
end
end
if or ne get g_sums add s 64 32 ne get g_sums add s 65 32
ret false
end
po = add s 66
pn = sub e po
if or eq pn 0 eq get g_sums po 47
ret false
end
for i ulong pn bound 512
if lt add i 1 pn
if eq get g_sums add po i 46
if eq get g_sums add po add i 1 46
ret false
end
end
end
end
pclr
pkit
pc 47
for i ulong pn bound 512
pc get g_sums add po i
end
if not hash_pa
ret false
end
if not s2_eq_sums_hex s
ret false
end
mark_known_sum po pn
put g_n 15 add get g_n 15 1
ret true
end

fn verify_sha256sums to bool
if not load_sums_file
ret false
end
sn = get g_n 9
pos = ulong 0
while lt pos sn bound 2048
e = pos
while and lt e sn ne get g_sums e 10 bound 2048
e = add e 1
end
le2 = e
if gt le2 pos
if eq get g_sums sub le2 1 13
le2 = sub le2 1
end
end
if gt le2 pos
if ne get g_sums pos 35
if not check_one_sum_line pos le2
ret false
end
end
end
pos = add e 1
end
for i ulong 7
if ne get g_seen i 1
ret false
end
end
ret eq get g_n 15 7
end

note ---- Negative control helpers
fn ctrl_tamper_1bit to bool
pset_k f_llms
if not hash_pa
ret false
end
save_d1
if not read_cap_pa
ret false
end
n = get g_n 8
if eq n 0
ret false
end
put g_cap 0 xor get g_cap 0 1
pset_s s_tamp
fd = fwr
if lt fd 0
ret false
end
w = write fd g_cap 0 n
fclo fd
if ne w long n
ret false
end
pset_s s_tamp
if not hash_pa
ret false
end
save_d2
ret not d1_eq_d2
end

fn ctrl_oversize_jpg to bool
pset_s s_big
fd = fwr
if lt fd 0
ret false
end
put g_fbuf 0 255
put g_fbuf 1 216
put g_fbuf 2 255
put g_fbuf 3 224
for i ulong 16
w = write fd g_fbuf 0 65536
if ne w 65536
fclo fd
ret false
end
put g_fbuf 0 0
end
fclo fd
pset_s s_big
ret not check_jpeg_pa
end

fn ctrl_bad_magic_png to bool
pset_s s_png
fd = fwr
if lt fd 0
ret false
end
put g_fbuf 0 137
put g_fbuf 1 80
put g_fbuf 2 78
put g_fbuf 3 71
put g_fbuf 4 13
put g_fbuf 5 10
put g_fbuf 6 26
put g_fbuf 7 10
w = write fd g_fbuf 0 8
fclo fd
if ne w 8
ret false
end
pset_s s_png
ret not check_jpeg_pa
end

fn ctrl_tampered_omc to bool
pclr
pomc
fd1 = frd
if lt fd1 0
ret false
end
pset_s s_omcp
fd2 = fexe
if lt fd2 0
fclo fd1
ret false
end
while true bound 1048576
k = read fd1 g_fbuf 0 65536
if lt k 0
fclo fd1
fclo fd2
ret false
end
if eq k 0
break
end
w = write fd2 g_fbuf 0 ulong k
if ne w k
fclo fd1
fclo fd2
ret false
end
end
fclo fd1
put g_fbuf 0 88
w = write fd2 g_fbuf 0 1
fclo fd2
if ne w 1
ret false
end
pset_s s_omcp
if not hash_pa
ret false
end
ret not s2_eq_pin
end

note ---- Reporting
fn rec_chk name view uchar * ok bool to void
if ok
put g_n 11 add get g_n 11 1
st l_ok
else
put g_n 14 add get g_n 14 1
st l_fl
end
st name
sb 10
sflush
end

fn rec_ctrl name view uchar * caught bool to void
put g_n 12 add get g_n 12 1
if caught
put g_n 13 add get g_n 13 1
st l_ct
else
put g_n 14 add get g_n 14 1
st l_ce
end
st name
sb 10
sflush
end

fn check_lk_doc to bool
pset_k f_lk
if not read_cap_pa
ret false
end
if not cap_policy_clean
ret false
end
if not and cap_has k_sov cap_has k_hv
ret false
end
if not and cap_has r_j1 and cap_has r_j2 and cap_has r_j3 cap_has r_j4
ret false
end
ret true
end

fn check_llms_doc to bool
pset_k f_llms
if not read_cap_pa
ret false
end
if not cap_policy_clean
ret false
end
if not and cap_has k_sov and cap_has k_aienos cap_has k_ip
ret false
end
if not and cap_has k_ng and cap_has k_hlx and cap_has k_hv cap_has k_ps
ret false
end
ret true
end

fn check_orca_doc to bool
pset_k f_orca
if not read_cap_pa
ret false
end
if not cap_policy_clean
ret false
end
if not and cap_has k_w1 and cap_has k_w2 and cap_has k_w3 cap_has k_zfa
ret false
end
ret true
end

fn run_all to void
rec_chk n_c2x check_2x_compile

pset_k_rel r_j1
rec_chk n_j1 check_jpeg_pa
pset_k_rel r_j2
rec_chk n_j2 check_jpeg_pa
pset_k_rel r_j3
rec_chk n_j3 check_jpeg_pa
pset_k_rel r_j4
rec_chk n_j4 check_jpeg_pa

rec_chk n_sums verify_sha256sums
rec_chk n_pol_lk check_lk_doc
rec_chk n_pol_lm check_llms_doc
rec_chk n_pol_or check_orca_doc

rec_ctrl n_k1 ctrl_tamper_1bit
rec_ctrl n_k2 ctrl_oversize_jpg
rec_ctrl n_k3 ctrl_bad_magic_png
load_cap_txt syn_bad_path
rec_ctrl n_k4 not cap_policy_clean
load_cap_txt syn_bad_cuda
rec_ctrl n_k5 not cap_policy_clean
load_cap_txt syn_bad_sec
rec_ctrl n_k6 not cap_policy_clean
rec_ctrl n_k7 ctrl_tampered_omc
end

fn emit_summary to int
st l_sum
if eq get g_n 14 0
st l_ps
else
st l_fa
end
st l_pin
for i ulong 16
sb get g_pin i
end
st l_ck
sdec get g_n 11
st l_as
sdec get g_n 15
st l_co
sdec get g_n 12
st l_ca
sdec get g_n 13
st l_hw
sflush
if eq get g_n 14 0
ret 0
end
ret 1
end

fn main to int
ac = ulong argcnt
if ne ac 5
werr t_usage
ret 2
end
n0 = argread 1 g_omc 0 4095
n1 = argread 2 g_kit 0 4095
n2 = argread 3 g_pinp 0 4095
n3 = argread 4 g_scr 0 4095
if or le n0 0 or le n1 0 or le n2 0 le n3 0
werr t_usage
ret 2
end
put g_n 0 ulong n0
put g_n 1 ulong n1
put g_n 2 ulong n2
put g_n 3 ulong n3
if not load_pin
werr t_badpin
ret 2
end
pclr
pomc
if not hash_pa
werr t_refpin
ret 69
end
if not s2_eq_pin
werr t_refpin
ret 69
end
pclr
pscr
r = makedir g_pa 0 get g_n 4 493
if and ne r 0 ne r -17
werr t_badscr
ret 2
end
run_all
ret emit_summary
end

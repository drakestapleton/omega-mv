note ---- SHA-256 (FIPS 180-4)
fn s2_setup to void
if eq get s2_ok 0 1
ret
end
put s2_k 0 1116352408
put s2_k 1 1899447441
put s2_k 2 3049323471
put s2_k 3 3921009573
put s2_k 4 961987163
put s2_k 5 1508970993
put s2_k 6 2453635748
put s2_k 7 2870763221
put s2_k 8 3624381080
put s2_k 9 310598401
put s2_k 10 607225278
put s2_k 11 1426881987
put s2_k 12 1925078388
put s2_k 13 2162078206
put s2_k 14 2614888103
put s2_k 15 3248222580
put s2_k 16 3835390401
put s2_k 17 4022224774
put s2_k 18 264347078
put s2_k 19 604807628
put s2_k 20 770255983
put s2_k 21 1249150122
put s2_k 22 1555081692
put s2_k 23 1996064986
put s2_k 24 2554220882
put s2_k 25 2821834349
put s2_k 26 2952996808
put s2_k 27 3210313671
put s2_k 28 3336571891
put s2_k 29 3584528711
put s2_k 30 113926993
put s2_k 31 338241895
put s2_k 32 666307205
put s2_k 33 773529912
put s2_k 34 1294757372
put s2_k 35 1396182291
put s2_k 36 1695183700
put s2_k 37 1986661051
put s2_k 38 2177026350
put s2_k 39 2456956037
put s2_k 40 2730485921
put s2_k 41 2820302411
put s2_k 42 3259730800
put s2_k 43 3345764771
put s2_k 44 3516065817
put s2_k 45 3600352804
put s2_k 46 4094571909
put s2_k 47 275423344
put s2_k 48 430227734
put s2_k 49 506948616
put s2_k 50 659060556
put s2_k 51 883997877
put s2_k 52 958139571
put s2_k 53 1322822218
put s2_k 54 1537002063
put s2_k 55 1747873779
put s2_k 56 1955562222
put s2_k 57 2024104815
put s2_k 58 2227730452
put s2_k 59 2361852424
put s2_k 60 2428436474
put s2_k 61 2756734187
put s2_k 62 3204031479
put s2_k 63 3329325298
put s2_ok 0 1
end

fn s2_init to void
s2_setup
put s2_h 0 1779033703
put s2_h 1 3144134277
put s2_h 2 1013904242
put s2_h 3 2773480762
put s2_h 4 1359893119
put s2_h 5 2600822924
put s2_h 6 528734635
put s2_h 7 1541459225
put s2_n 0 0
put s2_tot 0 0
end

fn s2_rounds to void
a = get s2_h 0
b = get s2_h 1
c = get s2_h 2
d = get s2_h 3
e = get s2_h 4
f = get s2_h 5
g = get s2_h 6
h = get s2_h 7
for r2 ulong 64
x2 = or shr e 6 shl e 26
x2 = xor x2 or shr e 11 shl e 21
x2 = xor x2 or shr e 25 shl e 7
x2 = add x2 h
x2 = add x2 xor and e f and not e g
x2 = add x2 get s2_k r2
x2 = add x2 get s2_w r2
h = g
g = f
f = e
e = add d x2
d = c
c = b
b = a
y2 = or shr b 2 shl b 30
y2 = xor y2 or shr b 13 shl b 19
y2 = xor y2 or shr b 22 shl b 10
x2 = add x2 y2
y2 = xor and b c and b d
y2 = xor y2 and c d
a = add x2 y2
end
put s2_h 0 add get s2_h 0 a
put s2_h 1 add get s2_h 1 b
put s2_h 2 add get s2_h 2 c
put s2_h 3 add get s2_h 3 d
put s2_h 4 add get s2_h 4 e
put s2_h 5 add get s2_h 5 f
put s2_h 6 add get s2_h 6 g
put s2_h 7 add get s2_h 7 h
end

fn s2_compress to void
for t ulong 16
p = mul t 4
v = or shl uint get s2_buf p 24 shl uint get s2_buf add p 1 16
v = or v or shl uint get s2_buf add p 2 8 uint get s2_buf add p 3
put s2_w t v
end
for u ulong 48
i = add u 16
x = get s2_w sub i 2
s = or shr x 17 shl x 15
s = xor s or shr x 19 shl x 13
s = xor s shr x 10
y = get s2_w sub i 15
r = or shr y 7 shl y 25
r = xor r or shr y 18 shl y 14
r = xor r shr y 3
s = add s get s2_w sub i 7
r = add r get s2_w sub i 16
put s2_w i add s r
end
s2_rounds
end

fn s2_byte b uchar to void
n = get s2_n 0
put s2_buf n b
n = add n 1
if eq n 64
s2_compress
n = ulong 0
end
put s2_n 0 n
put s2_tot 0 add get s2_tot 0 1
end

fn s2_fin to void
bits = mul get s2_tot 0 8
n = get s2_n 0
put s2_buf n 128
n = add n 1
if gt n 56
while lt n 64 bound 64
put s2_buf n 0
n = add n 1
end
s2_compress
n = ulong 0
end
while lt n 56 bound 64
put s2_buf n 0
n = add n 1
end
for k ulong 8
put s2_buf add 56 k uchar and shr bits mul sub 7 k 8 255
end
s2_compress
put s2_n 0 0
for j ulong 8
w = ulong get s2_h j
o = mul j 4
put s2_out o uchar and shr w 24 255
put s2_out add o 1 uchar and shr w 16 255
put s2_out add o 2 uchar and shr w 8 255
put s2_out add o 3 uchar and w 255
end
end

fn hexd v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

fn is_lhex c uchar to bool
d = and ge c 48 le c 57
h = and ge c 97 le c 102
ret or d h
end

note ---- Stdout logging
fn sflush to void
n = get g_n 10
p = ulong 0
while lt p n bound 65537
k = write 1 g_std p sub n p
if le k 0
break
end
p = add p ulong k
end
put g_n 10 0
end

fn sc c uchar to void
n = get g_n 10
if ge n 65400
sflush
n = get g_n 10
end
put g_std n c
put g_n 10 add n 1
end

fn st t view uchar * to void
for i ulong len t bound 4096
sc get t i
end
end

fn snum v ulong to void
if ge v 10
snum div v 10
end
sc uchar add 48 rem v 10
end

fn rec_check ok bool name view uchar * to void
if ok
st l_ok
st name
sc 10
put g_n 11 add get g_n 11 1
else
st l_fl
st name
sc 10
put g_n 14 add get g_n 14 1
end
sflush
end

fn rec_ctrl ok bool name view uchar * to void
put g_n 12 add get g_n 12 1
if ok
st l_ct
st name
sc 10
put g_n 13 add get g_n 13 1
else
st l_ce
st name
sc 10
put g_n 14 add get g_n 14 1
end
sflush
end

note ---- Path builders
fn pclr to void
put g_n 3 0
end

fn pc c uchar to void
n = get g_n 3
put g_pa n c
put g_n 3 add n 1
end

fn pt t view uchar * to void
for i ulong len t bound 4096
pc get t i
end
end

fn proot to void
for i ulong get g_n 1 bound 4096
pc get g_root i
end
end

fn pscr to void
for i ulong get g_n 2 bound 4096
pc get g_scr i
end
end

fn pomc to void
for i ulong get g_n 0 bound 4096
pc get g_omc i
end
end

fn pset_r suf view uchar * to void
pclr
proot
pt suf
end

fn pset_s suf view uchar * to void
pclr
pscr
pt suf
end

note ---- File helpers
fn fclo fd int to void
if ge fd 0
z = fclose fd
end
end

fn frd to int
r = fopen g_pa 0 get g_n 3 524288 0
if lt r 0
ret -1
end
ret int r
end

fn fwr to int
r = fopen g_pa 0 get g_n 3 524865 420
if lt r 0
ret -1
end
ret int r
end

fn fexe to int
z = unlink g_pa 0 get g_n 3
r = fopen g_pa 0 get g_n 3 524865 448
if lt r 0
ret -1
end
ret int r
end

fn mkd_s suf view uchar * to bool
pset_s suf
r = makedir g_pa 0 get g_n 3 493
ret or eq r 0 eq r -17
end

fn hash_pa to bool
fd = frd
if lt fd 0
ret false
end
s2_init
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
fclo fd
ret false
end
if eq k 0
break
end
for i ulong ulong k bound 65536
s2_byte get g_fbuf i
end
end
fclo fd
s2_fin
ret true
end

fn file_size_pa to ulong
fd = frd
if lt fd 0
ret shl ulong 1 63
end
tot = ulong 0
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
fclo fd
ret shl ulong 1 63
end
if eq k 0
break
end
tot = add tot ulong k
end
fclo fd
ret tot
end

fn save_d1 to void
for j ulong 32
put g_d1 j get s2_out j
end
end

fn save_d2 to void
for j ulong 32
put g_d2 j get s2_out j
end
end

fn d1_eq_d2 to bool
for j ulong 32
if ne get g_d1 j get g_d2 j
ret false
end
end
ret true
end

fn s2_eq_pin to bool
for j ulong 32
b = ulong get s2_out j
if ne get g_pin mul j 2 hexd shr b 4
ret false
end
if ne get g_pin add mul j 2 1 hexd and b 15
ret false
end
end
ret true
end

fn read_cap_pa to bool
fd = frd
if lt fd 0
ret false
end
n = ulong 0
while lt n 262144 bound 262145
k = read fd g_cap n sub 262144 n
if lt k 0
fclo fd
ret false
end
if eq k 0
break
end
n = add n ulong k
end
fclo fd
put g_n 8 n
ret true
end

fn cap_to_cap2 to void
n = get g_n 8
for i ulong n bound 262144
put g_cap2 i get g_cap i
end
put g_n 9 n
end

fn cap_eq_cap2 to bool
n = get g_n 8
if ne n get g_n 9
ret false
end
for i ulong n bound 262144
if ne get g_cap i get g_cap2 i
ret false
end
end
ret true
end

fn cap_has pat view uchar * to bool
pn = len pat
cn = get g_n 8
if or eq pn 0 gt pn cn
ret false
end
lim = add sub cn pn 1
for i ulong lim bound 262144
ok = true
for j ulong pn bound 512
if ne get g_cap add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

note ---- Write buffer g_wbuf helpers
fn wclr to void
put g_n 7 0
end

fn wc c uchar to void
n = get g_n 7
put g_wbuf n c
put g_n 7 add n 1
end

fn wt t view uchar * to void
for i ulong len t bound 8192
wc get t i
end
end

fn wpin flip bool to void
for j ulong 64
c = get g_pin j
if and flip eq j 0
if eq c 97
c = 98
else
c = 97
end
end
wc c
end
end

fn wsave_s suf view uchar * to bool
pset_s suf
fd = fwr
if lt fd 0
ret false
end
n = get g_n 7
p = ulong 0
while lt p n bound 262145
k = write fd g_wbuf p sub n p
if le k 0
fclo fd
ret false
end
p = add p ulong k
end
fclo fd
ret true
end

note ---- Process runner (execprog + waitpid)
fn aclr to void
put g_n 5 2
put g_n 6 0
put g_av 0 0
put g_av 1 0
end

fn apa to void
p = get g_n 5
n = get g_n 3
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 5 add p add n 2
c = add get g_n 6 1
put g_n 6 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end

fn atx t view uchar * to void
pclr
pt t
apa
end

fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end

fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
z = execprog g_av 0 get g_n 5
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 120000000000
z = killpid int pid 9
z = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
z = sleepns 200000
end
exit 2
end

fn run_cap to ulong
pclr
pt s_null
fi = frd
pset_s s_out
fo = fwr
pset_s s_err
fe = fwr
rc = spawn fi fo fe
pset_s s_out
ok = read_cap_pa
ret rc
end

note ---- Compile src twice and assert identical SHA-256 + empty stderr
fn compile_one src view uchar * out_s view uchar * err_s view uchar * to ulong
pset_r src
fi = frd
aclr
pclr
pomc
apa
pset_s out_s
fo = fexe
pset_s err_s
fe = fwr
ret spawn fi fo fe
end

fn compile_check_pair b1 view uchar * e1 view uchar * to bool
pset_s e1
if ne file_size_pa 0
ret false
end
pset_s b1
if not hash_pa
ret false
end
ret true
end

fn test_compile_srg to bool
r1 = compile_one p_srg s_srg1 s_srge1
r2 = compile_one p_srg s_srg2 s_srge2
if or ne r1 0 ne r2 0
ret false
end
if not compile_check_pair s_srg1 s_srge1
ret false
end
save_d1
if not compile_check_pair s_srg2 s_srge2
ret false
end
save_d2
ret d1_eq_d2
end

fn test_compile_exp to bool
r1 = compile_one p_exp s_exp1 s_expe1
r2 = compile_one p_exp s_exp2 s_expe2
if or ne r1 0 ne r2 0
ret false
end
if not compile_check_pair s_exp1 s_expe1
ret false
end
save_d1
if not compile_check_pair s_exp2 s_expe2
ret false
end
save_d2
ret d1_eq_d2
end

note ---- Synthetic manifest builder for si_release_gate tests
note mode: 0=all_green, 1=waived_nr, 2=unwaived_nr, 3=fail_waived, 4=miss_waived,
note       5=missing_r9, 6=bad_sha, 7=bad_pin, 8=dishonest_pass
fn add_mrow_head r view uchar * s view uchar * flip_p bool to void
wt r
wt s
wc 9
wpin flip_p
end

fn add_mrow_tail tail view uchar * to void
wt tail
end

fn write_syn_man suf view uchar * mode ulong to bool
wclr
wt m_hdr
if eq mode 6
add_mrow_head m_r0 m_sbad false
add_mrow_tail m_qh
else
if eq mode 7
add_mrow_head m_r0 m_s0 true
add_mrow_tail m_qh
else
add_mrow_head m_r0 m_s0 false
add_mrow_tail m_qh
end
end

if eq mode 3
add_mrow_head m_r1 m_s1 false
add_mrow_tail m_fl_row
else
add_mrow_head m_r1 m_s1 false
add_mrow_tail m_qh
end

if eq mode 4
add_mrow_head m_r2 m_s2 false
add_mrow_tail m_mi_row
else
add_mrow_head m_r2 m_s2 false
add_mrow_tail m_qh
end

if eq mode 8
add_mrow_head m_r3 m_s3 false
add_mrow_tail m_dp_row
else
add_mrow_head m_r3 m_s3 false
add_mrow_tail m_qh
end

add_mrow_head m_r4 m_s4 false
add_mrow_tail m_ee
add_mrow_head m_r5 m_s5 false
add_mrow_tail m_qh
add_mrow_head m_r6 m_s6 false
add_mrow_tail m_qh
add_mrow_head m_r7 m_s7 false
add_mrow_tail m_qs

if eq mode 1
add_mrow_head m_r8 m_s8 false
add_mrow_tail m_wv_row
else
if eq mode 2
add_mrow_head m_r8 m_s8 false
add_mrow_tail m_nr_row
else
add_mrow_head m_r8 m_s8 false
add_mrow_tail m_ee
end
end

if ne mode 5
add_mrow_head m_r9 m_s9 false
add_mrow_tail m_qh
end
ret wsave_s suf
end

fn run_srg_scr man_s view uchar * to ulong
aclr
pset_s s_srg1
apa
pset_s man_s
apa
pset_r p_pin
apa
ret run_cap
end

fn run_srg_live to ulong
aclr
pset_s s_srg1
apa
pset_r p_man
apa
pset_r p_pin
apa
ret run_cap
end

note ---- Test suite 1: si_release_gate positive + 7 negative controls
fn suite_release_gate to void
rc = run_srg_live
ok = and eq rc 1 and cap_has k_ref not cap_has k_stp
rec_check ok n_t1

z = write_syn_man s_m_ok 0
rc = run_srg_scr s_m_ok
ok = and eq rc 0 cap_has k_ok10
rec_check ok n_t2

z = write_syn_man s_m_wv 1
rc = run_srg_scr s_m_wv
ok = and eq rc 0 and cap_has k_stp cap_has k_wv1
rec_check ok n_t3

z = write_syn_man s_m_nr 2
rc = run_srg_scr s_m_nr
ok = and eq rc 1 and cap_has k_unw cap_has k_ref
rec_ctrl ok n_k1

z = write_syn_man s_m_fl 3
rc = run_srg_scr s_m_fl
ok = and eq rc 1 and cap_has k_fl cap_has k_ref
rec_ctrl ok n_k2

z = write_syn_man s_m_mi 4
rc = run_srg_scr s_m_mi
ok = and eq rc 1 and cap_has k_mi cap_has k_ref
rec_ctrl ok n_k3

z = write_syn_man s_m_9r 5
rc = run_srg_scr s_m_9r
ok = and eq rc 1 and cap_has k_req cap_has k_ref
rec_ctrl ok n_k4

z = write_syn_man s_m_bs 6
rc = run_srg_scr s_m_bs
ok = and eq rc 1 and cap_has k_bsh cap_has k_ref
rec_ctrl ok n_k5

z = write_syn_man s_m_bp 7
rc = run_srg_scr s_m_bp
ok = and eq rc 1 and cap_has k_bpm cap_has k_ref
rec_ctrl ok n_k6

z = write_syn_man s_m_dp 8
rc = run_srg_scr s_m_dp
ok = and eq rc 1 and cap_has k_low cap_has k_ref
rec_ctrl ok n_k7
end


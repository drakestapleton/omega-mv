fn suite_export_part1 to void
r1 = run_exp_real s_re1
ok1 = and eq r1 0 cap_has k_eok
cap_to_cap2
r2 = run_exp_real s_re2
ok2 = and eq r2 0 cap_eq_cap2
ok3 = real_files_eq s_rtl s_up
ok4 = real_files_eq s_tf s_zig
rec_check and ok1 and ok2 and ok3 ok4 n_t4

v1 = run_ver_pair s_re1 s_rtl true
okv1 = and eq v1 0 cap_has k_vok
v2 = run_ver_pair s_re1 s_tf true
okv2 = and eq v2 0 cap_has k_vok
rec_check and okv1 okv2 n_t5
end

fn setup_syn_tree to void
z = mkd_s s_sd
z = mkd_s s_sdd
z = mkd_s s_sdz
wclr
wt f_abc
z = wsave_s s_sfa
wclr
wt f_zigsrc
z = wsave_s s_sfz
wclr
wt st_hdr
wt st_r1
wt st_r2
z = wsave_s s_stab
end

fn is_tree_val_start i ulong to bool
if lt i 15
ret false
end
if ne get g_cap sub i 1 9
ret false
end
if ne get g_cap sub i 2 54
ret false
end
if ne get g_cap sub i 3 53
ret false
end
if ne get g_cap sub i 9 101
ret false
end
ret eq get g_cap sub i 12 116
end

fn make_tampered_pin to bool
z = mkd_s s_sbad
pclr
pscr
pt s_sdrv
pt s_up
if not read_cap_pa
ret false
end
n = get g_n 8
wclr
flipped = false
for i ulong n bound 262144
c = get g_cap i
if not flipped
if is_tree_val_start i
if eq c 97
c = 98
else
c = 97
end
flipped = true
end
end
wc c
end
if not flipped
ret false
end
pclr
pscr
pt s_sbad
pt s_up
fd = fwr
if lt fd 0
ret false
end
wn = get g_n 7
p = ulong 0
while lt p wn bound 262145
k = write fd g_wbuf p sub wn p
if le k 0
fclo fd
ret false
end
p = add p ulong k
end
fclo fd
ret true
end

fn suite_export_part2 to void
setup_syn_tree
rc = run_exp_syn s_stab s_sout
ok = and eq rc 0 cap_has k_eok

pclr
pscr
pt s_sdrv
pt s_up
ok = and ok and read_cap_pa cap_has k_kat

pclr
pscr
pt s_sdrv
pt s_ros
ok = and ok and read_cap_pa cap_has k_ros

pclr
pscr
pt s_stf
pt s_zig
ok = and ok and read_cap_pa cap_has k_zig

aclr
pset_s s_exp1
apa
atx a_ver
pset_s s_sdrv
apa
pset_s s_sd
apa
vr = run_cap
ok = and ok and eq vr 0 cap_has k_vok
rec_check ok n_t6

note Control 8: 1-byte source file tamper ("abc" -> "abd")
wclr
wt f_abd
z = wsave_s s_sfa
aclr
pset_s s_exp1
apa
atx a_ver
pset_s s_sdrv
apa
pset_s s_sd
apa
rc = run_cap
rec_ctrl and eq rc 1 cap_has k_tmp n_k8
wclr
wt f_abc
z = wsave_s s_sfa

note Control 9: 1-byte tamper in UPSTREAM_PIN.tsv tree_sha256
okt = make_tampered_pin
aclr
pset_s s_exp1
apa
atx a_ver
pset_s s_sbad
apa
pset_s s_sd
apa
rc = run_cap
rec_ctrl and okt and eq rc 1 cap_has k_trm n_k9

note Control 10: missing required source dir
wclr
wt st_hdr
wt st_mis
z = wsave_s s_tmis
rc = run_exp_syn s_tmis s_sout
rec_ctrl and eq rc 1 cap_has k_mis n_k10

note Control 11: path traversal ../etc
wclr
wt st_hdr
wt st_trv
z = wsave_s s_ttrv
rc = run_exp_syn s_ttrv s_sout
rec_ctrl and eq rc 1 cap_has k_trv n_k11
end

note ---- Control 12: compiler 1-byte-longer digest refusal
fn test_omc_tamper to void
z1 = new uchar 1 0
pclr
pomc
fd = frd
if lt fd 0
rec_ctrl false n_k12
ret
end
pset_s s_omcp
fo = fwr
if lt fo 0
fclo fd
rec_ctrl false n_k12
ret
end
ok = true
while true bound 1048576
k = read fd g_fbuf 0 65536
if lt k 0
ok = false
break
end
if eq k 0
break
end
w = write fo g_fbuf 0 ulong k
if ne w k
ok = false
break
end
end
w = write fo z1 0 1
if ne w 1
ok = false
end
fclo fd
fclo fo
pset_s s_omcp
ok = and ok and hash_pa not s2_eq_pin
rec_ctrl ok n_k12
end

note ---- Pin reader & main
fn read_omc_pin to bool
pset_r p_pin
fd = frd
if lt fd 0
ret false
end
k = read fd g_fbuf 0 128
fclo fd
if lt k 64
ret false
end
for j ulong 64
c = get g_fbuf j
if not is_lhex c
ret false
end
put g_pin j c
end
ret true
end

fn main to int
if ne argcnt 4
w = write 2 t_usage 0 len t_usage
ret 2
end
r1 = argread 1 g_omc 0 4094
r2 = argread 2 g_root 0 4094
r3 = argread 3 g_scr 0 4094
if or le r1 0 or le r2 0 le r3 0
w = write 2 t_usage 0 len t_usage
ret 2
end
put g_n 0 ulong r1
put g_n 1 ulong r2
put g_n 2 ulong r3

if not read_omc_pin
w = write 2 t_badpin 0 len t_badpin
ret 2
end
pclr
pomc
if not hash_pa
w = write 2 t_refpin 0 len t_refpin
ret 69
end
if not s2_eq_pin
w = write 2 t_refpin 0 len t_refpin
ret 69
end

r = makedir g_scr 0 get g_n 2 493
if and ne r 0 ne r -17
w = write 2 t_badscr 0 len t_badscr
ret 2
end

rec_check test_compile_srg n_c1
rec_check test_compile_exp n_c2
if ne get g_n 14 0
st l_sum
st l_fa
sc 10
sflush
ret 1
end

suite_release_gate
suite_export_part1
suite_export_part2
test_omc_tamper

fl = get g_n 14
st l_sum
if eq fl 0
st l_ps
else
st l_fa
end
st l_ck
snum get g_n 11
st l_co
snum get g_n 12
st l_ca
snum get g_n 13
st l_hw
sflush

if ne fl 0
ret 1
end
if ne get g_n 12 get g_n 13
ret 1
end
ret 0
end

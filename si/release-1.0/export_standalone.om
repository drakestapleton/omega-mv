om2
note SPDX-License-Identifier: Apache-2.0
note si/release-1.0/export_standalone.om: Pure seeded-OM-2 Standalone Community Repo Exporter & Verifier.
note
note Build:
note   seed/out/omc < si/release-1.0/export_standalone.om > export_standalone && chmod +x export_standalone
note
note Modes:
note   1. export_standalone export STANDALONE-REPOS.tsv SOURCE_ROOT OUT_DIR UPSTREAM_COMMIT_40HEX OMC_SHA256_FILE
note      Reads the declarative sync table, deterministically walks and hashes every canonical source
note      file (lexicographically sorted), writes per-repo:
note        - OUT_DIR/<repo>/UPSTREAM_PIN.tsv   (deterministic SHA-256 provenance manifest + tree_sha256)
note        - OUT_DIR/<repo>/README_ROSETTA.md  (60-Second Omega Rosetta Card README header)
note        - OUT_DIR/<repo>/omega2_plugin.zig  (for zig-abi-v2 / zig-abi-v2-optional layout repos)
note      Exits 0 on success (EXPORT_OK), 1 on fail-closed refusal, 2 on usage error.
note
note   2. export_standalone verify EXPORT_REPO_DIR SOURCE_ROOT
note      Re-hashes every file in UPSTREAM_PIN.tsv against SOURCE_ROOT, verifies exact byte count,
note      per-file SHA-256, row count, and header tree_sha256. Catches any single-byte tamper in either
note      source files or UPSTREAM_PIN.tsv. Exits 0 (VERIFY_OK) or 1 (VERIFY_FAIL).

note ---- Embedded FIPS 180-4 SHA-256 (pure OM-2, zero external deps)
global s2_ok ulong 1
global s2_k uint 64
global s2_h uint 8
global s2_w uint 64
global s2_buf uchar 64
global s2_n ulong 1
global s2_tot ulong 1
global s2_out uchar 32

note ---- Main buffers
global g_inp uchar 1048576
global g_out uchar 1048576
global g_tbuf uchar 1048576
global g_bsum uchar 65536
global g_fbuf uchar 65536
global g_dent uchar 32768
global g_pa uchar 4096
global g_pa2 uchar 4096
global g_src uchar 4096
global g_dst uchar 4096
global g_com uchar 64
global g_pin uchar 64
global g_pinf uchar 4096
global g_std uchar 65536
global g_tmp uchar 4096

note ---- Per-repo file collection & sorting tables (up to 4096 files per repo)
global g_fpool uchar 524288
global g_foff ulong 4096
global g_flen ulong 4096
global g_ford ulong 4096
global g_fbytes ulong 4096
global g_fhex uchar 262144
global g_treehex uchar 64

note ---- Iterative directory walk queue (up to 2048 subdirs)
global g_dqpool uchar 262144
global g_dqoff ulong 2048
global g_dqlen ulong 2048

note ---- Row column offsets and seen-repo table
global g_co ulong 16
global g_cn ulong 16
global g_seen_o ulong 128
global g_seen_n ulong 128

note ---- Verify metadata scratch
global g_vrepo uchar 128
global g_vtree uchar 64
global g_vstat ulong 8
note g_vstat: 0=repo_len, 1=has_fc, 2=hdr_fc, 3=has_tree, 4=pending_hdr, 5=rows_ok, 6=hdr_table, 7=fail_cnt

note ---- Global scalar slots g_n[0..31]
global g_n ulong 32
note g_n:
note   0=inp_len, 1=out_len, 2=tbuf_len, 3=bsum_len, 4=std_len,
note   5=pa_len, 6=src_len, 7=dst_len, 8=fpool_len, 9=file_cnt,
note   10=dqpool_len, 11=dq_head, 12=dq_tail, 13=seen_cnt, 14=repos_done,
note   15=total_files, 16=hdr_seen, 17=cur_mode, 18=cur_pending, 19=pa2_len,
note   20=tmp_len

text t_usage "usage:\n  export_standalone export STANDALONE-REPOS.tsv SOURCE_ROOT OUT_DIR UPSTREAM_COMMIT_40HEX OMC_SHA256_FILE\n  export_standalone verify EXPORT_REPO_DIR SOURCE_ROOT\n"

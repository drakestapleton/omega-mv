note bound_input_guard: the scan of mistake_bound_input.om with an early exit at 65 letters, below
note the bound of 70, so input of any length gives 0 (not this shape) instead of trap 4; exit 0.
global b uchar 128
fn scan e ulong to ulong
q = ulong 0
while lt q e bound 70
if gt q 64
ret 0
end
if ne get b q 65
break
end
q = add q 1
end
ret q
end
fn main to int
for i ulong 111
put b i 65
end
r = scan ulong 111
if eq r 0
ret 0
end
ret 1
end

note pwrite_text: pwrite only reads its array, so a text is a valid source (omega-mv #904, e2662fff).
note pread writes its array, so its destination must be writable: a global here (err20_pread_text.om
note is the text case). Up to omc 2c824805 (omega-mv e5b32567) the check sat on the wrong word and
note this program was error 20 at the pwrite line. Run in an empty scratch directory; Linux AArch64
note O_RDWR|O_CREAT|O_EXCL = 194, mode 0600 = 384.
text fname "f.bin"
text body "pwrite\n"
global rb uchar 16
fn main to int
fd = fopen fname 0 len fname 194 384
if lt fd 0
exit 90
end
w = pwrite int fd body 0 len body 0
if ne w long len body
exit 91
end
r = pread int fd rb 0 len body 0
if ne r long len body
exit 92
end
k = write 1 rb 0 ulong r
c = fclose int fd
u = unlink fname 0 len fname
if ne u 0
exit 93
end
ret 0
end

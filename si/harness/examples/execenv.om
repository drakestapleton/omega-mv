note execenv (keyword 233, omega-mv #1074): execprog with a private environment packet.
note The parent re-executes /proc/self/exe with argv [/proc/self/exe, "child"] and an environment
note of exactly one record GREETING=hi, in a forked child. The child prints its whole environment;
note the parent exits with the child's exit status. A missing program returns -2 (ENOENT).
om2
text self "/proc/self/exe"
text cmode "child"
text greet "GREETING=hi"
text missing "/nonexistent/omega-execenv-example"
global argv uchar 256
global envp uchar 64
global buf uchar 256
global status uchar 4

fn arec pos ulong s view uchar * to ulong
put argv pos uchar and len s 255
put argv add pos 1 uchar shr len s 8
for i ulong len s
put argv add add pos 2 i get s i
end
ret add add pos 2 len s
end

fn erec pos ulong s view uchar * to ulong
put envp pos uchar and len s 255
put envp add pos 1 uchar shr len s 8
for i ulong len s
put envp add add pos 2 i get s i
end
ret add add pos 2 len s
end

fn child to int
c = ulong envcnt
for i ulong c
n = envread i buf 0 len buf
if le n 0
ret 2
end
put buf n 10
w = write 1 buf 0 add ulong n 1
end
if ne c 1
ret 1
end
ret 0
end

fn main to int
n = argcnt
if eq n 2
ret child
end
put argv 0 2
put argv 1 0
an = arec 2 self
an = arec an cmode
put envp 0 1
put envp 1 0
en = erec 2 greet
pid = fork
if eq pid 0
r = execenv argv 0 an envp 0 en
exit 3
end
w = waitpid int pid status 0 len status 0
if ne w pid
ret 4
end
note A missing program: execenv returns -2 (ENOENT) to the caller.
put argv 0 1
put argv 1 0
mn = arec 2 missing
r = execenv argv 0 mn envp 0 en
if ne r neg long 2
ret 5
end
ret int get status 1
end

note selftest: copy stdin to stdout with the case of each letter swapped. Fed its own output it gives back its
note input, so a case line that fed the program expected.out instead of stdin would fail.
global buf uchar 4096
fn main to int
n = read 0 buf 0 len buf
while gt n 0
m = ulong n
for i ulong m
c = get buf i
if ge c 97
if le c 122
put buf i uchar sub c 32
end
else
if ge c 65
if le c 90
put buf i uchar add c 32
end
end
end
end
w = write 1 buf 0 ulong n
if ne w n
ret 1
end
n = read 0 buf 0 len buf
end
if lt n 0
ret 2
end
ret 0
end

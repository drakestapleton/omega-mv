note cat: copy standard input to standard output. score.sh runs it through the om2 gate with a program's saved
note output as input and the task's expected output as the expected stdout, so the comparison is the gate's.
note A short write continues; a failed write exits 90, a failed read exits 91.
global buf uchar 65536
fn main to int
n = read 0 buf 0 len buf
while gt n 0
p = ulong 0
e = ulong n
while lt p e
k = write 1 buf p sub e p
if le k 0
exit 90
end
p = add p ulong k
end
n = read 0 buf 0 len buf
end
if lt n 0
exit 91
end
ret 0
end

om2
note guides: the generated blocks of this repository's guides, and the check that keeps them true.
note
note   git ls-files | build/guides check   report stale blocks and typed pins or counts; change nothing
note   git ls-files | build/guides gen     rewrite every block from its sources, then report the rest
note   build/guides pinof < FILE           exit 0 when FILE (tools/jflat output) is reference data for PIN
note
note Run in the repository root. Sources: PIN (the omega-mv commit and the omc sha256, written once),
note data/reference.tsv (omega-mcp's data/reference.json for that pin, flattened by tools/jflat; its first
note two lines must equal PIN) and the tracked file list on stdin (example and skill counts, example names,
note each skill's frontmatter description). A block is the lines between `<!-- gen:NAME -->` and
note `<!-- /gen:NAME -->`; NAME is pin, errors, traps, words, hostwords, examples, gateline or skills.
note Text outside blocks is written by people and copied byte for byte; it is never reworded.
note
note Findings (exit 1): a stale block (check only), an unknown block or one without its end marker, and,
note outside blocks, a word of 7 or more hex digits that begins the PIN revision or omc sha256 (it
note restates the pin), or a typed count: a number (not after `-`) before examples, example programs, worked
note examples, programs, skills, words, host words, keywords, entries, error codes or topics, a number word
note (one .. twelve) before skills, programs
note or examples, or `examples=N`. A dated observation may name the compiler it ran on and the counts it
note saw: a paragraph that holds an ISO date (YYYY-MM-DD), or, in a .md file, the lines under a heading that
note holds one (up to the next heading). Alarm (also a finding): an input over half of its buffer, so the
note buffer is grown long before an input is refused.
note Not read: PIN, data/, README.zh-CN.md (translated copies are retired, not maintained).
note Exit 0 clean, 1 findings, 2 usage, PIN, data or I/O error, or an input that fills its buffer.

const capb ulong 16777216
const halfb ulong 8388608

global pin uchar 128
global dat uchar 16777216
global fl uchar 16777216
global inb uchar 16777216
global obuf uchar 16777216
global aux uchar 65536
global key uchar 4096
global pfx uchar 4096
global pth uchar 4096
global sp uchar 4096
global pk uchar 8448
global nb uchar 32
global ab uchar 16
global cs ulong 256
global ce ulong 256
global st ulong 32

note st cells
const s_dn ulong 0
const s_fn ulong 1
const s_in ulong 2
const s_on ulong 3
const s_pl ulong 4
const s_kl ulong 5
const s_vs ulong 6
const s_ve ulong 7
const s_gen ulong 8
const s_bad ulong 9
const s_ln ulong 10
const s_date ulong 11
const s_xl ulong 12
const s_nf ulong 13
const s_ncat ulong 14
const s_ls ulong 15
const s_tp ulong 16
const s_le ulong 17
const s_ns ulong 18
const s_ne ulong 19
const s_blk ulong 20
const s_rw ulong 21
const s_max ulong 22
const s_err ulong 23
const s_ax ulong 24
const s_md ulong 25
const s_hd ulong 26

text kpinf "PIN"
text kdatf "data/reference.tsv"
text kmvw "omega-mv "
text kshaw "omc-sha256 "
text kpmv "/pin/omega_mv\t"
text kpsha "/pin/omc_sha256\t"
text a_check "check"
text a_gen "gen"
text a_pinof "pinof"
text m_use "usage: git ls-files | guides check|gen   (in the repository root), or guides pinof < FLATTENED-REFERENCE\n"
text m_pin "guides: PIN must be exactly two lines, `omega-mv <40 hex>` and `omc-sha256 <64 hex>`\n"
text m_dat "guides: data/reference.tsv is missing or is not the reference data for PIN; run tools/regen.sh\n"
text m_full "guides: refused, an input filled its 16777216-byte buffer: "
text m_dalarm "guides: alarm: data/reference.tsv or the file list is over half of its 16777216-byte buffer; grow the buffer\n"
text m_open "guides: cannot read "
text m_wr "guides: cannot write "
text m_long "guides: a path of 4096 bytes or longer\n"
text m_cats "guides: more than 256 keyword kinds in the reference data\n"
text f_stale ": block is stale (run `git ls-files | build/guides gen`): "
text f_unk ": unknown block (pin, errors, traps, words, hostwords, examples, gateline or skills): "
text f_unt ": block has no end marker: "
text f_pin ": restates PIN outside a generated block: "
text f_cnt ": typed count outside a generated block: "
text f_alarm ": alarm: over half of the 16777216-byte buffer; grow the buffer"
text m_hint "guides: pins and counts are generated, never typed: use a block (`<!-- gen:NAME -->`), point at PIN, or date the observation\n"
text m_sum1 "guides: files "
text m_sum2 " blocks "
text m_sum3 " rewritten "
text m_sum4 " findings "
text m_sum5 " largest "
text nl "\n"
text colon ":"
text x_pin "PIN"
text x_data "data/"
text x_zh "README.zh-CN.md"
text x_tmp ".guides-tmp"
text mk_b "<!-- gen:"
text mk_e "<!-- /gen:"
text mk_t " -->"
text b_pin "pin"
text b_err "errors"
text b_trap "traps"
text b_words "words"
text b_host "hostwords"
text b_exam "examples"
text b_gate "gateline"
text b_skill "skills"
text k_wd "/words/"
text k_cat "/category"
text k_form "/form"
text k_er "/errors/"
text k_tr "/traps/"
text k_tp "/topics/"
text k_mean "/meaning"
text k_fix "/fix"
text k_name "/name"
text k_sum "/summary"
text k_host "host-"
text k_exd "examples/"
text k_skd "skills/"
text k_exs "/examples/"
text k_om ".om"
text k_skmd "/SKILL.md"
text k_xerr "examples/err"
text k_xtrap "examples/trap"
text k_fm "---"
text k_desc "description: "
text k_num "one two three four five six seven eight nine ten eleven twelve "
text n_ex "examples"
text n_pr "programs"
text n_sk "skills"
text n_wd "words"
text n_hw "host words"
text n_kw "keywords"
text n_en "entries"
text n_ec "error codes"
text n_tp "topics"
text n_ep "example programs"
text n_we "worked examples"
text t_bar "| "
text t_mid " | "
text t_end " |\n"
text t_sep ", "
text t_none "none"
text t_pinh "| Pin (`PIN`) | Value |\n|---|---|\n| omega-mv commit | `"
text t_pin2 "` |\n| `seed/out/omc` sha256 | `"
text t_pin3 "` |\n| reference data | `data/reference.tsv`: omega-mcp's `data/reference.json` for this pin, with "
text t_pin4 " keyword-table entries ("
text t_pin5 " host words), "
text t_pin6 " compiler error codes, "
text t_pin7 " traps and "
text t_pin8 " topics |\n"
text t_errh "| Code | Meaning | Fix | Example in `examples/` |\n|---|---|---|---|\n"
text t_trh "| Trap | Name | Cause | Exit status | Examples in `examples/` |\n|---|---|---|---|---|\n"
text k_cause "/cause"
text t_wd1 "The keyword table at the pin has "
text t_wd2 " entries; the "
text t_wd3 " host words are in the host-word table. The rest, by kind:\n\n| Kind | Words |\n|---|---|\n"
text t_hw1 "The keyword table at the pin has "
text t_hw2 " host words, each shown with its values:\n\n| Kind | Words |\n|---|---|\n"
text t_ex1 "`examples/gate.sh` reruns "
text t_ex2 " programs: "
text t_ex3 " in `examples/` and "
text t_ex4 " in `skills/*/examples/`.\n"
text t_gt1 "```text\nGATE PASS examples="
text t_gt2 " pass="
text t_gt3 " fail=0 omc="
text t_gt4 "\n```\n"
text t_sk1 " skills, each `skills/<name>/SKILL.md`; the use column is the skill's own frontmatter `description`:\n\n| Skill | Use |\n|---|---|\n"
text t_nodesc "(no `description` in the frontmatter)"

note ---------------------------------------------------------------- stdout and stderr

fn wfd fd int t view uchar * to void
n = len t
p = ulong 0
while lt p n bound 4096
k = write fd t p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wt t view uchar * to void
wfd 1 t
end

fn wt2 t view uchar * to void
wfd 2 t
end

fn wnum fd int v ulong to void
i = ulong 32
n = v
while true bound 21
i = sub i 1
put nb i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
while lt i 32 bound 32
k = write fd nb i sub 32 i
if le k 0
exit 2
end
i = add i ulong k
end
end

fn wpth fd int to void
n = get st s_pl
p = ulong 0
while lt p n bound 4096
k = write fd pth p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wrng a ulong b ulong to void
p = a
while lt p b bound 16777216
k = write 1 inb p sub b p
if le k 0
exit 2
end
p = add p ulong k
end
end

note fnd: one finding about the current file and line, naming inb[a, b)
fn fnd m view uchar * a ulong b ulong to void
wpth 1
wt colon
wnum 1 get st s_ln
wt m
wrng a b
wt nl
put st s_bad add get st s_bad 1
end

fn ferr m view uchar * to void
wt2 m
wpth 2
wt2 nl
put st s_err 1
end

note ---------------------------------------------------------------- the rendered file (obuf)

fn o c uchar to void
n = get st s_on
if eq n capb
wt2 m_full
wpth 2
wt2 nl
exit 2
end
put obuf n c
put st s_on add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 4096
o get t i
end
end

fn onum v ulong to void
i = ulong 32
n = v
while true bound 21
i = sub i 1
put nb i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
while lt i 32 bound 32
o get nb i
i = add i 1
end
end

note odat: a data value dat[a, b) as a table cell: jflat escapes decoded (\n and \t become a space), `|` escaped
fn odat a ulong b ulong to void
i = a
while lt i b bound 16777216
c = get dat i
if eq c 92
d = uchar 0
if lt add i 1 b
d = get dat add i 1
end
if or eq d 110 eq d 116
o 32
i = add i 2
else
o 92
if eq d 92
i = add i 2
else
i = add i 1
end
end
else
if eq c 124
o 92
end
o c
i = add i 1
end
end
end

fn oflr a ulong b ulong to void
i = a
while lt i b bound 4096
o get fl i
i = add i 1
end
end

fn opin a ulong n ulong to void
for i ulong n bound 64
o get pin add a i
end
end

note oaux: aux[a, b) as a table cell
fn oaux a ulong b ulong to void
i = a
while lt i b bound 65536
c = get aux i
if eq c 124
o 92
end
o c
i = add i 1
end
end

fn cpraw a ulong b ulong to void
i = a
while lt i b bound 16777216
o get inb i
i = add i 1
end
end

note cpin: inb[a, b) and the newline at b, when b is inside the file
fn cpin a ulong b ulong to void
cpraw a b
if lt b get st s_in
o 10
end
end

note ---------------------------------------------------------------- PIN and the reference data

fn ishex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn islow c uchar to bool
ret and ge c 97 le c 122
end

fn isw c uchar to bool
if isdig c
ret true
end
if and ge c 65 le c 90
ret true
end
if islow c
ret true
end
ret eq c 95
end

note ldpin: PIN into pin; true when it is exactly the two lines
fn ldpin to bool
f = fopen kpinf 0 len kpinf 0 0
if lt f 0
ret false
end
n = read int f pin 0 128
z = fclose int f
if ne n 126
ret false
end
for i ulong 9
if ne get pin i get kmvw i
ret false
end
end
for j ulong 11
if ne get pin add 50 j get kshaw j
ret false
end
end
if or ne get pin 49 10 ne get pin 125 10
ret false
end
for k ulong 40
if not ishex get pin add 9 k
ret false
end
end
for m ulong 64
if not ishex get pin add 61 m
ret false
end
end
ret true
end

note rddat: fd into dat; 0 read, 1 read error, 2 the input fills the buffer
fn rddat f int to int
n = ulong 0
while true bound 16777217
if eq n capb
ret 2
end
k = read f dat n sub capb n
if lt k 0
ret 1
end
if eq k 0
break
end
n = add n ulong k
end
put st s_dn n
ret 0
end

fn rdfl f int to int
n = ulong 0
while true bound 16777217
if eq n capb
ret 2
end
k = read f fl n sub capb n
if lt k 0
ret 1
end
if eq k 0
break
end
n = add n ulong k
end
put st s_fn n
ret 0
end

fn rdin f int to int
n = ulong 0
while true bound 16777217
if eq n capb
ret 2
end
k = read f inb n sub capb n
if lt k 0
ret 1
end
if eq k 0
break
end
n = add n ulong k
end
put st s_in n
ret 0
end

note rdaux: the first bytes of fd (a skill's frontmatter) into aux
fn rdaux f int to void
n = ulong 0
while lt n 65536 bound 65537
k = read f aux n sub 65536 n
if le k 0
break
end
n = add n ulong k
end
put st s_ax n
end

note datpin: dat starts with the two pin lines of PIN, as tools/jflat writes them
fn datpin to bool
a = len kpmv
b = len kpsha
w = add add add a 41 b 65
if lt get st s_dn w
ret false
end
for i ulong a bound 64
if ne get dat i get kpmv i
ret false
end
end
for j ulong 40
if ne get dat add a j get pin add 9 j
ret false
end
end
if ne get dat add a 40 10
ret false
end
q = add a 41
for k ulong b bound 64
if ne get dat add q k get kpsha k
ret false
end
end
r = add q b
for m ulong 64
if ne get dat add r m get pin add 61 m
ret false
end
end
ret eq get dat add r 64 10
end

note ---------------------------------------------------------------- data lines and lookups

note dline: the data line at p; cells s_ls (start), s_tp (its tab, or its end) and s_le (its end)
fn dline p ulong to void
n = get st s_dn
put st s_ls p
q = p
t = n
while lt q n bound 16777216
c = get dat q
if eq c 10
break
end
if and eq c 9 eq t n
t = q
end
q = add q 1
end
if gt t q
t = q
end
put st s_tp t
put st s_le q
end

note dkid: the current line's path is pre, then one name without `/`, then suf
fn dkid pre view uchar * suf view uchar * to bool
ls = get st s_ls
tp = get st s_tp
a = len pre
b = len suf
if lt sub tp ls add add a b 1
ret false
end
for i ulong a bound 4096
if ne get dat add ls i get pre i
ret false
end
end
s = sub tp b
for j ulong b bound 4096
if ne get dat add s j get suf j
ret false
end
end
k = add ls a
while lt k s bound 16777216
if eq get dat k 47
ret false
end
k = add k 1
end
ret true
end

fn dcount pre view uchar * suf view uchar * to ulong
n = get st s_dn
p = ulong 0
c = ulong 0
while lt p n bound 16777216
dline p
if dkid pre suf
c = add c 1
end
p = add get st s_le 1
end
ret c
end

fn deq a ulong b ulong c ulong d ulong to bool
if ne sub b a sub d c
ret false
end
k = sub b a
for i ulong k bound 16777216
if ne get dat add a i get dat add c i
ret false
end
end
ret true
end

fn ishost a ulong b ulong to bool
n = len k_host
if lt sub b a n
ret false
end
for i ulong n bound 16
if ne get dat add a i get k_host i
ret false
end
end
ret true
end

note hostn: the number of words whose category starts with host-
fn hostn to ulong
n = get st s_dn
p = ulong 0
c = ulong 0
while lt p n bound 16777216
dline p
if dkid k_wd k_cat
if ishost add get st s_tp 1 get st s_le
c = add c 1
end
end
p = add get st s_le 1
end
ret c
end

fn kclr to void
put st s_kl 0
end

fn kc c uchar to void
n = get st s_kl
if eq n 4096
wt2 m_long
exit 2
end
put key n c
put st s_kl add n 1
end

fn kt t view uchar * to void
for i ulong len t bound 4096
kc get t i
end
end

fn kdat a ulong b ulong to void
i = a
while lt i b bound 4096
kc get dat i
i = add i 1
end
end

fn dend p ulong to ulong
n = get st s_dn
q = p
while lt q n bound 16777216
if eq get dat q 10
ret q
end
q = add q 1
end
ret n
end

fn keyat p ulong kl ulong to bool
if gt add add p kl 1 get st s_dn
ret false
end
for i ulong kl bound 4096
if ne get dat add p i get key i
ret false
end
end
ret eq get dat add p kl 9
end

note look: the value of the line whose path is key, into s_vs and s_ve
fn look to bool
kl = get st s_kl
n = get st s_dn
p = ulong 0
while lt p n bound 16777216
if keyat p kl
v = add add p kl 1
put st s_vs v
put st s_ve dend v
ret true
end
p = add dend p 1
end
ret false
end

note ---------------------------------------------------------------- the tracked file list

fn fend p ulong to ulong
n = get st s_fn
q = p
while lt q n bound 16777216
if eq get fl q 10
ret q
end
q = add q 1
end
ret n
end

fn flpre p ulong e ulong t view uchar * to bool
n = len t
if lt sub e p n
ret false
end
for i ulong n bound 4096
if ne get fl add p i get t i
ret false
end
end
ret true
end

fn flsuf p ulong e ulong t view uchar * to bool
n = len t
if lt sub e p n
ret false
end
s = sub e n
for i ulong n bound 4096
if ne get fl add s i get t i
ret false
end
end
ret true
end

fn flnos a ulong b ulong to bool
i = a
while lt i b bound 16777216
if eq get fl i 47
ret false
end
i = add i 1
end
ret true
end

note isexa: examples/NAME.om
fn isexa p ulong e ulong to bool
if lt sub e p 13
ret false
end
if not flpre p e k_exd
ret false
end
if not flsuf p e k_om
ret false
end
ret flnos add p 9 e
end

note isskex: skills/S/examples/NAME.om
fn isskex p ulong e ulong to bool
if not flpre p e k_skd
ret false
end
if not flsuf p e k_om
ret false
end
q = add p 7
while lt q e bound 4096
if eq get fl q 47
break
end
q = add q 1
end
if or eq q add p 7 ge q e
ret false
end
if not flpre q e k_exs
ret false
end
if lt sub e q 14
ret false
end
ret flnos add q 10 e
end

note isskill: skills/S/SKILL.md
fn isskill p ulong e ulong to bool
if lt sub e p 17
ret false
end
if not flpre p e k_skd
ret false
end
if not flsuf p e k_skmd
ret false
end
ret flnos add p 7 sub e 9
end

fn pclr to void
put st s_xl 0
end

fn pc c uchar to void
n = get st s_xl
put pfx n c
put st s_xl add n 1
end

fn pt t view uchar * to void
for i ulong len t bound 64
pc get t i
end
end

fn pdat a ulong b ulong to void
i = a
while lt i b bound 64
pc get dat i
i = add i 1
end
end

note isex: the path begins with pfx (an examples/ prefix) and is examples/NAME.om
fn isex p ulong e ulong to bool
xl = get st s_xl
if lt sub e p add xl 3
ret false
end
for i ulong xl bound 4096
if ne get fl add p i get pfx i
ret false
end
end
if not flsuf p e k_om
ret false
end
ret flnos add p 9 e
end

note exlist: every examples/ program whose path begins with pfx, by name
fn exlist to void
n = get st s_fn
p = ulong 0
c = ulong 0
while lt p n bound 16777216
e = fend p
if isex p e
if gt c 0
ot t_sep
end
o 96
oflr add p 9 sub e 3
o 96
c = add c 1
end
p = add e 1
end
if eq c 0
ot t_none
end
end

fn nexa to ulong
n = get st s_fn
p = ulong 0
c = ulong 0
while lt p n bound 16777216
e = fend p
if isexa p e
c = add c 1
end
p = add e 1
end
ret c
end

fn nexb to ulong
n = get st s_fn
p = ulong 0
c = ulong 0
while lt p n bound 16777216
e = fend p
if isskex p e
c = add c 1
end
p = add e 1
end
ret c
end

note ---------------------------------------------------------------- block renderers

fn rpin to void
ot t_pinh
opin 9 40
ot t_pin2
opin 61 64
ot t_pin3
onum dcount k_wd k_cat
ot t_pin4
onum hostn
ot t_pin5
onum dcount k_er k_mean
ot t_pin6
onum dcount k_tr k_mean
ot t_pin7
onum dcount k_tp k_sum
ot t_pin8
end

note erow: the row of the error whose /errors/X/meaning line is current
fn erow to void
xs = add get st s_ls 8
xe = sub get st s_tp 8
vs = add get st s_tp 1
ve = get st s_le
ot t_bar
odat xs xe
ot t_mid
odat vs ve
ot t_mid
kclr
kt k_er
kdat xs xe
kt k_fix
if look
odat get st s_vs get st s_ve
end
ot t_mid
pclr
pt k_xerr
if eq sub xe xs 1
pc 48
end
pdat xs xe
pc 95
exlist
ot t_end
end

fn rerr to void
ot t_errh
n = get st s_dn
p = ulong 0
while lt p n bound 16777216
dline p
lz = get st s_le
if dkid k_er k_mean
erow
end
p = add lz 1
end
end

fn dnum a ulong b ulong to ulong
v = ulong 0
i = a
while lt i b bound 20
v = add mul v 10 ulong sub get dat i 48
i = add i 1
end
ret v
end

fn trow to void
xs = add get st s_ls 7
xe = sub get st s_tp 8
vs = add get st s_tp 1
ve = get st s_le
ot t_bar
odat xs xe
ot t_mid
kclr
kt k_tr
kdat xs xe
kt k_name
if look
odat get st s_vs get st s_ve
end
ot t_mid
kclr
kt k_tr
kdat xs xe
kt k_cause
if look
odat get st s_vs get st s_ve
end
ot t_mid
onum add 100 dnum xs xe
ot t_mid
pclr
pt k_xtrap
pdat xs xe
pc 95
exlist
ot t_end
end

fn rtrap to void
ot t_trh
n = get st s_dn
p = ulong 0
while lt p n bound 16777216
dline p
lz = get st s_le
if dkid k_tr k_mean
trow
end
p = add lz 1
end
end

note cats: the keyword kinds in order of first use, as data ranges in cs and ce
fn addcat to void
vs = add get st s_tp 1
ve = get st s_le
m = get st s_ncat
for j ulong m bound 256
if deq get cs j get ce j vs ve
ret
end
end
if eq m 256
wt2 m_cats
exit 2
end
put cs m vs
put ce m ve
put st s_ncat add m 1
end

fn cats to void
put st s_ncat 0
n = get st s_dn
p = ulong 0
while lt p n bound 16777216
dline p
lz = get st s_le
if dkid k_wd k_cat
addcat
end
p = add lz 1
end
end

note wform: the form of the word whose category line is current (its name when it has none)
fn wform to void
a = add get st s_ls 7
b = sub get st s_tp 9
kclr
kt k_wd
kdat a b
kt k_form
if look
odat get st s_vs get st s_ve
else
odat a b
end
end

fn wrow j ulong host bool to void
ot t_bar
odat get cs j get ce j
ot t_mid
first = true
n = get st s_dn
p = ulong 0
while lt p n bound 16777216
dline p
lz = get st s_le
if dkid k_wd k_cat
if deq add get st s_tp 1 lz get cs j get ce j
if not first
ot t_sep
end
first = false
o 96
wform
o 96
end
end
p = add lz 1
end
ot t_end
end

fn rwords host bool to void
h = hostn
if host
ot t_hw1
onum h
ot t_hw2
else
ot t_wd1
onum dcount k_wd k_cat
ot t_wd2
onum h
ot t_wd3
end
cats
m = get st s_ncat
for j ulong m bound 256
if eq ishost get cs j get ce j host
wrow j host
end
end
end

fn rexam to void
a = nexa
b = nexb
ot t_ex1
onum add a b
ot t_ex2
onum a
ot t_ex3
onum b
ot t_ex4
end

fn rgate to void
n = add nexa nexb
ot t_gt1
onum n
ot t_gt2
onum n
ot t_gt3
opin 61 64
ot t_gt4
end

note auxpre: aux[p, e) begins with t
fn auxpre p ulong e ulong t view uchar * to bool
n = len t
if lt sub e p n
ret false
end
for i ulong n bound 64
if ne get aux add p i get t i
ret false
end
end
ret true
end

fn auxend p ulong to ulong
n = get st s_ax
q = p
while lt q n bound 65536
if eq get aux q 10
ret q
end
q = add q 1
end
ret n
end

note odesc: the description line of the frontmatter in aux
fn odesc to void
n = get st s_ax
e = auxend 0
if or ne e 3 not auxpre 0 e k_fm
ot t_nodesc
ret
end
p = add e 1
while lt p n bound 65536
q = auxend p
if and eq sub q p 3 auxpre p q k_fm
break
end
if auxpre p q k_desc
a = add p len k_desc
if gt sub q a 1
if and eq get aux a 34 eq get aux sub q 1 34
a = add a 1
q = sub q 1
end
end
oaux a q
ret
end
p = add q 1
end
ot t_nodesc
end

fn skrow p ulong e ulong to void
ot t_bar
o 96
oflr p e
o 96
ot t_mid
m = sub e p
for i ulong m bound 4096
put sp i get fl add p i
end
f = fopen sp 0 m 0 0
if lt f 0
put st s_ax 0
wt2 m_open
k = write 2 sp 0 m
wt2 nl
put st s_err 1
else
rdaux int f
z = fclose int f
end
odesc
ot t_end
end

fn rskill to void
n = get st s_fn
c = ulong 0
p = ulong 0
while lt p n bound 16777216
e = fend p
if isskill p e
c = add c 1
end
p = add e 1
end
onum c
ot t_sk1
q = ulong 0
while lt q n bound 16777216
f = fend q
if isskill q f
skrow q f
end
q = add f 1
end
end

note ---------------------------------------------------------------- one file

fn iend p ulong to ulong
n = get st s_in
q = p
while lt q n bound 16777216
if eq get inb q 10
ret q
end
q = add q 1
end
ret n
end

note isbeg: the line inb[p, e) is `<!-- gen:NAME -->`; the name goes to s_ns and s_ne
fn isbeg p ulong e ulong to bool
a = len mk_b
b = len mk_t
if le sub e p add a b
ret false
end
for i ulong a bound 16
if ne get inb add p i get mk_b i
ret false
end
end
s = sub e b
for j ulong b bound 16
if ne get inb add s j get mk_t j
ret false
end
end
k = add p a
while lt k s bound 4096
if not islow get inb k
ret false
end
k = add k 1
end
put st s_ns add p a
put st s_ne s
ret true
end

fn startsb p ulong e ulong to bool
a = len mk_b
if lt sub e p a
ret false
end
for i ulong a bound 16
if ne get inb add p i get mk_b i
ret false
end
end
ret true
end

note iat: inb at p holds the text t
fn iat p ulong t view uchar * to bool
for i ulong len t bound 64
if ne get inb add p i get t i
ret false
end
end
ret true
end

note ieq: inb[a, a+n) equals inb[b, b+n)
fn ieq a ulong b ulong n ulong to bool
for i ulong n bound 4096
if ne get inb add a i get inb add b i
ret false
end
end
ret true
end

note isend: the line inb[q, f) is the end marker of the current block
fn isend q ulong f ulong to bool
a = len mk_e
ns = get st s_ns
m = sub get st s_ne ns
if ne sub f q add add a m len mk_t
ret false
end
if not iat q mk_e
ret false
end
if not ieq add q a ns m
ret false
end
ret iat add add q a m mk_t
end

fn nmis t view uchar * to bool
a = get st s_ns
n = sub get st s_ne a
if ne n len t
ret false
end
for i ulong n bound 64
if ne get inb add a i get t i
ret false
end
end
ret true
end

fn render to bool
if nmis b_pin
rpin
ret true
end
if nmis b_err
rerr
ret true
end
if nmis b_trap
rtrap
ret true
end
if nmis b_words
rwords false
ret true
end
if nmis b_host
rwords true
ret true
end
if nmis b_exam
rexam
ret true
end
if nmis b_gate
rgate
ret true
end
if nmis b_skill
rskill
ret true
end
ret false
end

note osame: obuf[ob, end) equals inb[a, b)
fn osame ob ulong a ulong b ulong to bool
on = get st s_on
if ne sub on ob sub b a
ret false
end
n = sub b a
for i ulong n bound 16777216
if ne get obuf add ob i get inb add a i
ret false
end
end
ret true
end

note doblk: the block whose begin marker is the line inb[p, e); returns where the next line starts
fn doblk p ulong e ulong to ulong
n = get st s_in
cpin p e
ob = get st s_on
ib = add e 1
q = ib
f = n
lines = ulong 0
found = false
while lt q n bound 16777216
f = iend q
if isend q f
found = true
break
end
if startsb q f
break
end
lines = add lines 1
q = add f 1
end
put st s_blk add get st s_blk 1
if not found
fnd f_unt get st s_ns get st s_ne
if gt q n
q = n
end
cpraw ib q
put st s_ln add get st s_ln lines
ret q
end
if render
if not osame ob ib q
if eq get st s_gen 0
fnd f_stale get st s_ns get st s_ne
end
end
else
fnd f_unk get st s_ns get st s_ne
put st s_on ob
cpraw ib q
end
put st s_ln add get st s_ln add lines 1
cpin q f
ret add f 1
end

note isdate: inb at k is 20DD-DD-DD
fn isdate k ulong to bool
if or ne get inb k 50 ne get inb add k 1 48
ret false
end
if or not isdig get inb add k 2 not isdig get inb add k 3
ret false
end
if or ne get inb add k 4 45 ne get inb add k 7 45
ret false
end
if or not isdig get inb add k 5 not isdig get inb add k 6
ret false
end
ret and isdig get inb add k 8 isdig get inb add k 9
end

fn blank p ulong e ulong to bool
i = p
while lt i e bound 16777216
c = get inb i
if not or eq c 32 eq c 9
ret false
end
i = add i 1
end
ret true
end

note ldate: the line inb[q, e) holds an ISO date
fn ldate q ulong e ulong to bool
if lt sub e q 10
ret false
end
k = q
m = sub e 10
while le k m bound 16777216
if isdate k
ret true
end
k = add k 1
end
ret false
end

note pdate: the paragraph that starts at p (up to a blank line) holds an ISO date
fn pdate p ulong to bool
n = get st s_in
q = p
while lt q n bound 16777216
e = iend q
if blank q e
ret false
end
if ldate q e
ret true
end
q = add e 1
end
ret false
end

fn ishexw s ulong t ulong to bool
d = false
l = false
i = s
while lt i t bound 16777216
c = get inb i
if not ishex c
ret false
end
if isdig c
d = true
else
l = true
end
i = add i 1
end
ret and d l
end

note pinpre: inb[s, t) begins the PIN revision or the omc sha256
fn pinpre s ulong t ulong to bool
n = sub t s
r = le n 40
if r
for i ulong n bound 40
if ne get inb add s i get pin add 9 i
r = false
end
end
end
if r
ret true
end
if gt n 64
ret false
end
for j ulong n bound 64
if ne get inb add s j get pin add 61 j
ret false
end
end
ret true
end

fn alldig s ulong t ulong to bool
i = s
while lt i t bound 16777216
if not isdig get inb i
ret false
end
i = add i 1
end
ret true
end

fn lc c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note spelled: inb[s, t) is one of the number words one .. twelve, in any case
fn spelled s ulong t ulong to bool
n = len k_num
w = sub t s
a = ulong 0
while lt a n bound 4096
b = a
while lt b n bound 4096
if eq get k_num b 32
break
end
b = add b 1
end
if eq sub b a w
same = true
for i ulong w bound 16
if ne lc get inb add s i get k_num add a i
same = false
end
end
if same
ret true
end
end
a = add b 1
end
ret false
end

note nounat: inb at q is the word t, ended by a non-word byte or the line end; its length, else 0
fn nounat q ulong e ulong t view uchar * to ulong
n = len t
if gt add q n e
ret 0
end
for i ulong n bound 64
if ne get inb add q i get t i
ret 0
end
end
r = add q n
if lt r e
if isw get inb r
ret 0
end
end
ret n
end

fn nounsp q ulong e ulong to ulong
k = nounat q e n_sk
if gt k 0
ret k
end
k = nounat q e n_pr
if gt k 0
ret k
end
ret nounat q e n_ex
end

fn nounall q ulong e ulong to ulong
k = nounsp q e
if gt k 0
ret k
end
k = nounat q e n_ep
if gt k 0
ret k
end
k = nounat q e n_we
if gt k 0
ret k
end
k = nounat q e n_hw
if gt k 0
ret k
end
k = nounat q e n_wd
if gt k 0
ret k
end
k = nounat q e n_kw
if gt k 0
ret k
end
k = nounat q e n_en
if gt k 0
ret k
end
k = nounat q e n_ec
if gt k 0
ret k
end
ret nounat q e n_tp
end

fn tokis s ulong t ulong w view uchar * to bool
if ne sub t s len w
ret false
end
for i ulong len w bound 64
if ne get inb add s i get w i
ret false
end
end
ret true
end

note tok: judge the word inb[s, t) of a line that ends at e
fn tok s ulong t ulong e ulong to void
if or ne get st s_date 0 ne get st s_hd 0
ret
end
if and ge sub t s 7 ishexw s t
if pinpre s t
fnd f_pin s t
end
ret
end
if ge t e
ret
end
if gt s 0
if eq get inb sub s 1 45
ret
end
end
c = get inb t
q = add t 1
if eq c 32
k = ulong 0
if alldig s t
k = nounall q e
else
if spelled s t
k = nounsp q e
end
end
if gt k 0
fnd f_cnt s add q k
end
ret
end
if and eq c 61 tokis s t n_ex
if lt q e
if isdig get inb q
r = q
while lt r e bound 64
if not isdig get inb r
break
end
r = add r 1
end
fnd f_cnt s r
end
end
end
end

fn scanl p ulong e ulong to void
i = p
while lt i e bound 16777216
if isw get inb i
j = i
while lt j e bound 16777216
if not isw get inb j
break
end
j = add j 1
end
tok i j e
i = j
else
i = add i 1
end
end
end

fn dofile to void
put st s_on 0
put st s_ln 0
put st s_date 0
put st s_hd 0
n = get st s_in
para = true
p = ulong 0
while lt p n bound 16777216
e = iend p
put st s_ln add get st s_ln 1
if isbeg p e
p = doblk p e
para = true
else
if blank p e
para = true
else
if and ne get st s_md 0 eq get inb p 35
put st s_hd 0
if ldate p e
put st s_hd 1
end
end
if para
put st s_date 0
if pdate p
put st s_date 1
end
para = false
end
scanl p e
end
cpin p e
p = add e 1
end
end
end

note ---------------------------------------------------------------- paths

fn pathis t view uchar * to bool
if ne get st s_pl len t
ret false
end
for i ulong len t bound 64
if ne get pth i get t i
ret false
end
end
ret true
end

fn pathpre t view uchar * to bool
if lt get st s_pl len t
ret false
end
for i ulong len t bound 64
if ne get pth i get t i
ret false
end
end
ret true
end

fn wobuf f int to bool
n = get st s_on
p = ulong 0
while lt p n bound 16777216
k = write f obuf p sub n p
if le k 0
ret false
end
p = add p ulong k
end
ret true
end

note writef: obuf to the current path, through a temporary file and a rename
fn writef to bool
pl = get st s_pl
x = len x_tmp
tl = add pl x
put pk 0 2
put pk 1 0
put pk 2 uchar and tl 255
put pk 3 uchar shr tl 8
for i ulong pl bound 4096
put pk add 4 i get pth i
end
for j ulong x bound 16
put pk add add 4 pl j get x_tmp j
end
r = add 4 tl
put pk r uchar and pl 255
put pk add r 1 uchar shr pl 8
for k ulong pl bound 4096
put pk add add r 2 k get pth k
end
f = fopen pk 4 tl 577 420
if lt f 0
ret false
end
ok = wobuf int f
y = fsync int f
z = fclose int f
if or not ok lt y 0
ret false
end
v = renames pk 0 add add r 2 pl 0
ret ge v 0
end

fn pathmd to bool
m = get st s_pl
if le m 3
ret false
end
if ne get pth sub m 3 46
ret false
end
if ne get pth sub m 2 109
ret false
end
ret eq get pth sub m 1 100
end

fn dopath p ulong e ulong to void
m = sub e p
if ge m 4096
wt2 m_long
put st s_err 1
ret
end
for i ulong m bound 4096
put pth i get fl add p i
end
put st s_pl m
put st s_md 0
if pathmd
put st s_md 1
end
if or pathis x_pin or pathpre x_data pathis x_zh
ret
end
f = fopen pth 0 m 0 0
if lt f 0
ferr m_open
ret
end
r = rdin int f
z = fclose int f
if eq r 2
ferr m_full
ret
end
if ne r 0
ferr m_open
ret
end
n = get st s_in
put st s_nf add get st s_nf 1
if gt n get st s_max
put st s_max n
end
if gt n halfb
put st s_ln 0
fnd f_alarm 0 0
end
dofile
if osame 0 0 n
ret
end
if eq get st s_gen 1
if writef
put st s_rw add get st s_rw 1
else
ferr m_wr
end
end
end

fn argis t view uchar * k ulong to bool
if ne k len t
ret false
end
for i ulong k bound 16
if ne get ab i get t i
ret false
end
end
ret true
end

fn main to int
if ne argcnt 2
wt2 m_use
ret 2
end
a = argread 1 ab 0 16
if lt a 0
wt2 m_use
ret 2
end
k = ulong a
mode = ulong 3
if argis a_check k
mode = ulong 0
end
if argis a_gen k
mode = ulong 1
end
if argis a_pinof k
mode = ulong 2
end
if eq mode 3
wt2 m_use
ret 2
end
if not ldpin
wt2 m_pin
ret 2
end
if eq mode 2
if ne rddat 0 0
wt2 m_dat
ret 2
end
if datpin
ret 0
end
ret 1
end
put st s_gen mode
f = fopen kdatf 0 len kdatf 0 0
if lt f 0
wt2 m_dat
ret 2
end
r = rddat int f
z = fclose int f
if or ne r 0 not datpin
wt2 m_dat
ret 2
end
if ne rdfl 0 0
wt2 m_use
ret 2
end
if or gt get st s_dn halfb gt get st s_fn halfb
wt m_dalarm
put st s_bad add get st s_bad 1
end
n = get st s_fn
p = ulong 0
while lt p n bound 16777216
e = fend p
if gt e p
dopath p e
end
p = add e 1
end
wt m_sum1
wnum 1 get st s_nf
wt m_sum2
wnum 1 get st s_blk
wt m_sum3
wnum 1 get st s_rw
wt m_sum4
wnum 1 get st s_bad
wt m_sum5
wnum 1 get st s_max
wt nl
if ne get st s_err 0
ret 2
end
if ne get st s_bad 0
wt m_hint
ret 1
end
ret 0
end

om2
note rules: the agents' standing rules, from one rules source plus one machine's overlay.
note
note   rules lint SRC [OVL]             check both files; a line of the public SRC may not hold `~/`, `$HOME`,
note                                    `/home/`, `/Users/`, `/root/`, `/srv/`, `/var/`, `/etc/`, `127.0.0.1`,
note                                    the host name `spark` (lowercase) or a private repository name
note                                    (`omega-pearl`, `aien-crypto`), Linear URLs or DRA issue IDs: those go in the overlay
note   rules render SRC OVL PROG HEAD [PATH]   the instruction file for PROG, on stdout
note   rules targets SRC OVL            `target PROG PATH`, `skills - DIR` and `alarm - FILE` lines
note   rules fit SRC OVL HEAD           for each OVL `cap CHARS PATH`: render the target with that PATH and count
note                                    its characters (UTF-8 code points, as a reader that decodes the file
note                                    counts them); prints `fit PROG PATH N of CHARS ok|OVER`; exit 1 when
note                                    a render is over its cap or a cap names no target
note
note SRC is rules/rules.txt; OVL is the overlay, kept on one machine and never published. Both have one
note format, one record per line group:
note   rule ID            begins a rule; ID is lowercase letters, digits and `-`, unique over both files
note   date YYYY-MM-DD    the date of the statement the rule rests on
note   said TEXT          Drake's exact words, when they exist (any number of lines; kept, not rendered)
note   for P ...          the programs it applies to: claude, codex, agents, omp, watchdog, generic; `all`
note                      includes claude, codex, agents and omp. A generic reader gets agents and generic
note                      rules. If its configured cap is exceeded and an agents target is available, it
note                      gets the rules marked generic plus directions to the full agents file.
note   order N            where it goes in every file it is rendered into (ascending; ties keep SRC
note                      before OVL, then file order)
note   | TEXT  or  |      one line of the rendered rule, or an empty one
note   end                ends the rule
note Outside a rule, a line is empty, a comment (`#`), or, in OVL only, `target PROG PATH` (PROG's
note instruction file on this machine), `skills DIR` (an installed skills directory), `alarm FILE`
note (where a failed install is reported) or `cap CHARS PATH` (the most characters the reader of the
note target PATH keeps; `fit` and tools/install.sh refuse a render over it). A rendered file is a header
note naming HEAD (the last commit that changed the rules) and each rule for PROG in order, separated by an
note empty line. Same inputs, same bytes. Exit 0 done, 1 lint findings or a render over its cap, 2 usage,
note read error or a malformed file.

global rb uchar 16777216
global obuf uchar 16777216
global ab uchar 4096
global hd uchar 128
global nb uchar 32
global rs ulong 65536
global re ulong 65536
global ro ulong 65536
global rm ulong 65536
global rk ulong 65536
global dn uchar 65536
global st ulong 32

const capb ulong 16777216
const capr ulong 65536
const s_n ulong 0
const s_ns ulong 1
const s_on ulong 2
const s_nr ulong 3
const s_bad ulong 4
const s_ln ulong 5
const s_hl ulong 6
const s_ls ulong 7
const s_le ulong 8
const s_al ulong 9
note allm preserves the shared rules for claude, codex, agents and omp.
const allm ulong 15
const genm ulong 32

text a_lint "lint"
text a_render "render"
text a_tgts "targets"
text a_fit "fit"
text p_claude "claude"
text p_codex "codex"
text p_agents "agents"
text p_omp "omp"
text p_watch "watchdog"
text p_gen "generic"
text p_all "all"
text w_rule "rule "
text w_date "date "
text w_said "said "
text w_for "for "
text w_order "order "
text w_end "end"
text w_bar "|"
text w_target "target "
text w_skills "skills "
text w_alarm "alarm "
text w_cap "cap "
text k_home "~/"
text k_home2 "/home/"
text k_users "/Users/"
text k_srv "/srv/"
text k_spark "spark"
text k_pearl "omega-pearl"
text k_crypto "aien-crypto"
text k_local "127.0.0.1"
text k_dhome "$HOME"
text k_root "/root/"
text k_var "/var/"
text k_etc "/etc/"
text k_linear "linear.app/"
text k_issue "DRA-"
text m_use "usage: rules lint SRC [OVL] | rules render SRC OVL PROG HEAD [PATH] | rules targets SRC OVL | rules fit SRC OVL HEAD\n"
text m_read "rules: cannot read "
text m_full "rules: refused, the rules files fill the 16777216-byte buffer\n"
text m_many "rules: refused, more than 65536 rules\n"
text m_alarm "rules: alarm: the rules files are over half of the 16777216-byte buffer\n"
text m_prog "rules: unknown program: "
text f_line ": "
text f_src "SRC"
text f_ovl "OVL"
text f_out "outside a rule, expected rule, a comment or an empty line (OVL also target, skills, alarm or cap)"
text f_in "inside a rule, expected date, said, for, order, | or end"
text f_noid "a rule ID is lowercase letters, digits and -"
text f_dup "the rule ID is used twice"
text f_nodate "the rule has no date YYYY-MM-DD"
text f_nofor "the rule has no for line, or names an unknown program"
text f_noord "the rule has no order N"
text f_notext "the rule has no | line"
text f_open "the file ends inside a rule"
text f_priv "the public rules source holds a home path, host path, host name or private name; move it to the overlay"
text f_tgt "a target line is `target PROG PATH`: one program (claude, codex, agents, omp, watchdog or generic), one space, and a path"
text f_cap "a cap line is `cap CHARS PATH`: 1 to 18 digits, one space, and a path"
text t_fit "fit "
text t_of " of "
text t_ok " ok\n"
text t_over " OVER\n"
text t_notgt "fit: no target line for the cap path "
text f_rule " rule "
text f_rules " rules, "
text f_tg "findings\n"
text m_lint "rules: "
text h_1 "<!-- Generated for "
text h_2 " by omega-harness tools/rules.om from rules/rules.txt at "
text h_3 " and this machine's overlay. Do not edit this file: change the rules source and land it, or change the overlay, then run tools/install.sh. -->\n"
text nl "\n"
text sp " "
text dash "- "
text g_1 "\n## Additional standing rules\nRead the full agent instructions at the following location before doing project work:\n"
text m_dup_target "more than one target uses the same path"
text m_path "rules: path is not configured for this program\n"
text m_over "rules: requested render exceeds its configured cap\n"

note ---------------------------------------------------------------- output

fn wfd fd int t view uchar * to void
n = len t
p = ulong 0
while lt p n bound 4096
k = write fd t p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wnum fd int v ulong to void
i = ulong 32
n = v
while true bound 21
i = sub i 1
put nb i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
while lt i 32 bound 32
k = write fd nb i sub 32 i
if le k 0
exit 2
end
i = add i ulong k
end
end

fn wrb fd int a ulong b ulong to void
p = a
while lt p b bound 16777216
k = write fd rb p sub b p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn o c uchar to void
n = get st s_on
if eq n capb
wfd 2 m_full
exit 2
end
put obuf n c
put st s_on add n 1
end

fn ot t view uchar * to void
for i ulong len t bound 4096
o get t i
end
end

fn orb a ulong b ulong to void
i = a
while lt i b bound 16777216
o get rb i
i = add i 1
end
end

fn flush to void
n = get st s_on
p = ulong 0
while lt p n bound 16777216
k = write 1 obuf p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
put st s_on 0
end

note ---------------------------------------------------------------- input

note ldarg: argument i into ab; its length, or a refusal
fn ldarg i ulong to ulong
k = argread i ab 0 4096
if lt k 0
wfd 2 m_use
exit 2
end
ret ulong k
end

fn argis t view uchar * k ulong to bool
if ne k len t
ret false
end
for i ulong k bound 4096
if ne get ab i get t i
ret false
end
end
ret true
end

note ldfile: the file named by argument i, appended to rb
fn ldfile i ulong to void
m = ldarg i
f = fopen ab 0 m 0 0
if lt f 0
wfd 2 m_read
z = write 2 ab 0 m
wfd 2 nl
exit 2
end
n = get st s_n
while true bound 16777217
if eq n capb
wfd 2 m_full
exit 2
end
k = read int f rb n sub capb n
if lt k 0
wfd 2 m_read
y = write 2 ab 0 m
wfd 2 nl
exit 2
end
if eq k 0
break
end
n = add n ulong k
end
z = fclose int f
if gt n 0
if ne get rb sub n 1 10
if eq n capb
wfd 2 m_full
exit 2
end
put rb n 10
n = add n 1
end
end
put st s_n n
end

note ---------------------------------------------------------------- lines

fn lend p ulong to ulong
n = get st s_n
q = p
while lt q n bound 16777216
if eq get rb q 10
ret q
end
q = add q 1
end
ret n
end

note lpre: the line [p, e) begins with t
fn lpre p ulong e ulong t view uchar * to bool
n = len t
if lt sub e p n
ret false
end
for i ulong n bound 64
if ne get rb add p i get t i
ret false
end
end
ret true
end

fn lis p ulong e ulong t view uchar * to bool
if ne sub e p len t
ret false
end
ret lpre p e t
end

note has: rb[a, b) holds t
fn has a ulong b ulong t view uchar * to bool
n = len t
if lt sub b a n
ret false
end
m = sub b n
i = a
while le i m bound 16777216
same = true
for j ulong n bound 64
if ne get rb add i j get t j
same = false
break
end
end
if same
ret true
end
i = add i 1
end
ret false
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn isid c uchar to bool
if isdig c
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 45
end

note word: the program word rb[a, b) as a bit (claude 1, codex 2, agents 4, omp 8, watchdog 16, generic 32, all 15), else 0
fn wbit a ulong b ulong to ulong
m = sub b a
if lis a b p_claude
ret 1
end
if lis a b p_codex
ret 2
end
if lis a b p_agents
ret 4
end
if lis a b p_omp
ret 8
end
if lis a b p_watch
ret 16
end
if lis a b p_all
ret allm
end
if lis a b p_gen
ret genm
end
ret 0
end

note forbits: the programs of a `for` line [p, e); 0 when one word is unknown
fn forbits p ulong e ulong to ulong
m = ulong 0
i = add p len w_for
while lt i e bound 4096
while lt i e bound 4096
if ne get rb i 32
break
end
i = add i 1
end
if ge i e
break
end
j = i
while lt j e bound 4096
if eq get rb j 32
break
end
j = add j 1
end
b = wbit i j
if eq b 0
ret 0
end
m = or m b
i = j
end
ret m
end

note pnum: the decimal rb[a, b) of 1 to 18 digits; the largest ulong (no order) for anything else
fn pnum a ulong b ulong to ulong
v = ulong 0
i = a
if or eq a b gt sub b a 18
ret 18446744073709551615
end
while lt i b bound 18
c = get rb i
if not isdig c
ret 18446744073709551615
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end

fn dig2 a ulong to ulong
ret add mul ulong sub get rb a 48 10 ulong sub get rb add a 1 48
end

note isdate: rb[a, b) is YYYY-MM-DD with a month 01..12 and a day 01..31
fn isdate a ulong b ulong to bool
if ne sub b a 10
ret false
end
for i ulong 10
c = get rb add a i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not isdig c
ret false
end
end
end
m = dig2 add a 5
d = dig2 add a 8
if or lt m 1 gt m 12
ret false
end
ret and ge d 1 le d 31
end

note ---------------------------------------------------------------- parse

note fnd: a lint finding at line s_ln of SRC or OVL
fn fnd ovl bool m view uchar * to void
if ovl
wfd 1 f_ovl
else
wfd 1 f_src
end
wfd 1 f_line
wnum 1 get st s_ln
wfd 1 f_line
wfd 1 m
wfd 1 nl
put st s_bad add get st s_bad 1
end

fn ideq a ulong b ulong c ulong d ulong to bool
if ne sub b a sub d c
ret false
end
k = sub b a
for i ulong k bound 4096
if ne get rb add a i get rb add c i
ret false
end
end
ret true
end

note newrule: the rule line [p, e) at index r; its ID must be well formed and new
fn newrule p ulong e ulong r ulong ovl bool to void
if eq r capr
wfd 2 m_many
exit 2
end
a = add p len w_rule
if eq a e
fnd ovl f_noid
end
i = a
while lt i e bound 4096
if not isid get rb i
fnd ovl f_noid
break
end
i = add i 1
end
for j ulong r bound 65536
s = get rs j
if ideq a e add s len w_rule lend s
fnd ovl f_dup
end
end
put rs r p
put ro r 18446744073709551615
put rm r 0
put rk r 0
put dn r 0
if ovl
put rk r 1
end
end

note parse: every line of rb; the rules into rs, re, ro, rm, rk (0 SRC, 1 OVL)
fn parse to void
n = get st s_n
ns = get st s_ns
r = ulong 0
inr = false
txt = false
p = ulong 0
while lt p n bound 16777216
if eq p ns
if inr
put st s_ln 0
fnd false f_open
inr = false
end
put st s_ln 0
end
ovl = ge p ns
e = lend p
put st s_ln add get st s_ln 1
if inr
txt = line p e r ovl txt
if lis p e w_end
put re r e
if not txt
fnd ovl f_notext
end
if eq get dn r 0
fnd ovl f_nodate
end
if eq get rm r 0
fnd ovl f_nofor
end
if eq get ro r 18446744073709551615
fnd ovl f_noord
end
r = add r 1
inr = false
end
else
if lpre p e w_rule
newrule p e r ovl
inr = true
txt = false
else
outer p e ovl
end
end
p = add e 1
end
if inr
fnd true f_open
end
put st s_nr r
end

note line: one line [p, e) inside rule r; returns whether the rule has text now
fn line p ulong e ulong r ulong ovl bool txt bool to bool
if lis p e w_end
ret txt
end
if lpre p e w_bar
if or eq sub e p 1 eq get rb add p 1 32
ret true
end
fnd ovl f_in
ret txt
end
if lpre p e w_date
if isdate add p len w_date e
put dn r 1
else
fnd ovl f_nodate
end
ret txt
end
if lpre p e w_said
ret txt
end
if lpre p e w_for
put rm r forbits p e
ret txt
end
if lpre p e w_order
put ro r pnum add p len w_order e
ret txt
end
fnd ovl f_in
ret txt
end

note okt: the target line [p, e) is `target PROG PATH`: one known program (not `all`), one space, a path
fn okt p ulong e ulong to bool
a = add p len w_target
q = a
while lt q e bound 4096
if eq get rb q 32
break
end
q = add q 1
end
b = wbit a q
if or eq b 0 eq b allm
ret false
end
if ge add q 1 e
ret false
end
ret ne get rb add q 1 32
end

note outer: a line outside every rule
fn outer p ulong e ulong ovl bool to void
if eq p e
ret
end
if eq get rb p 35
ret
end
if ovl
if lpre p e w_target
if not okt p e
fnd ovl f_tgt
else
a = add p len w_target
while ne get rb a 32 bound 4096
a = add a 1
end
if ne tfind add a 1 e p
fnd ovl m_dup_target
end
end
ret
end
if or lpre p e w_skills lpre p e w_alarm
ret
end
if lpre p e w_cap
if not okc p e
fnd ovl f_cap
end
ret
end
end
fnd ovl f_out
end

note okc: the OVL line [p, e) is `cap CHARS PATH`: 1 to 18 digits, one space, a path
fn okc p ulong e ulong to bool
a = add p len w_cap
q = a
while lt q e bound 4096
if eq get rb q 32
break
end
q = add q 1
end
if eq pnum a q 18446744073709551615
ret false
end
if ge add q 1 e
ret false
end
ret ne get rb add q 1 32
end

note private: the public SRC holds no home path, host path, host name or private name
fn private to void
ns = get st s_ns
p = ulong 0
put st s_ln 0
while lt p ns bound 16777216
e = lend p
put st s_ln add get st s_ln 1
if or has p e k_home or has p e k_home2 or has p e k_users has p e k_srv
fnd false f_priv
else
if or has p e k_spark or has p e k_pearl or has p e k_crypto has p e k_local
fnd false f_priv
else
if or has p e k_dhome or has p e k_root or has p e k_var has p e k_etc
fnd false f_priv
else
if or has p e k_linear has p e k_issue
fnd false f_priv
end
end
end
end
p = add e 1
end
end

note ---------------------------------------------------------------- render

note orule: the | lines of rule r
fn orule r ulong to void
p = get rs r
e = get re r
while lt p e bound 16777216
q = lend p
if lpre p q w_bar
if gt sub q p 1
orb add p 2 q
end
o 10
end
p = add q 1
end
end

note pick: the next rule in order for program bit m, after the ones marked done; capr when none
fn pick m ulong to ulong
nr = get st s_nr
best = capr
for i ulong nr bound 65536
if and eq get dn i 0 ne and get rm i m 0
if eq best capr
best = i
else
if lt get ro i get ro best
best = i
end
end
end
end
ret best
end

note tprog: the program bit of the OVL `target PROG PATH` line [p, e); 0 for any other line
fn tprog p ulong e ulong to ulong
if not lpre p e w_target
ret 0
end
a = add p len w_target
q = a
while lt q e bound 4096
if eq get rb q 32
break
end
q = add q 1
end
ret wbit a q
end

note Print the path of a full agents file, if one exists. Its unchanged render contains all shared and agents-only rules.
fn agentptr to bool
p = get st s_ns
while lt p get st s_n bound 16777216
e = lend p
if eq tprog p e 4
ot g_1
orb add p len w_target e
o 10
ret true
end
p = add e 1
end
ret false
end

note build: the file for program bit m into obuf (the header names ab[0, s_al) and hd)
fn build m ulong compact bool to void
nr = get st s_nr
for i ulong nr bound 65536
put dn i 0
end
ot h_1
for j ulong get st s_al bound 4096
o get ab j
end
ot h_2
for k ulong get st s_hl bound 128
o get hd k
end
ot h_3
if eq m genm
if not compact
m = or m 4
else
if not agentptr
m = or m 4
end
end
end
c = ulong 0
while true bound 65537
r = pick m
if eq r capr
break
end
put dn r 1
o 10
orule r
c = add c 1
end
end


note ---------------------------------------------------------------- fit

note tfind: the start of the OVL `target PROG PATH` line whose PATH is rb[a, b); s_n when there is none
fn tfind a ulong b ulong to ulong
n = get st s_n
p = get st s_ns
while lt p n bound 16777216
e = lend p
if lpre p e w_target
s = add p len w_target
while lt s e bound 4096
if eq get rb s 32
break
end
s = add s 1
end
if lt s e
if ideq add s 1 e a b
ret p
end
end
end
p = add e 1
end
ret n
end

note nchars: the characters of obuf (UTF-8 code points: every byte that is not a continuation byte)
fn nchars to ulong
n = get st s_on
c = ulong 0
for i ulong n bound 16777216
if ne and get obuf i 192 128
c = add c 1
end
end
ret c
end

note Rebuild only an oversized generic render. The same selection is used by fit and by installation.
fn boundedbuild m ulong lim ulong to ulong
put st s_on 0
build m false
k = nchars
if and eq m genm gt k lim
put st s_on 0
build m true
k = nchars
end
ret k
end

note A path comparison uses the complete byte span, including any interior spaces.
fn patharg a ulong e ulong size ulong to bool
if ne sub e a size
ret false
end
for i ulong size bound 4096
if ne get ab i get rb add a i
ret false
end
end
ret true
end

note For the exact target and program, return the strictest cap or the maximum ulong if uncapped.
fn pathlimit size ulong program ulong to ulong
lim = ulong 18446744073709551615
found = false
p = get st s_ns
while lt p get st s_n bound 16777216
e = lend p
cap = lpre p e w_cap
if or cap eq tprog p e program
a = add p len w_target
if cap
a = add p len w_cap
end
q = a
while lt q e bound 4096
if eq get rb q 32
break
end
q = add q 1
end
if patharg add q 1 e size
if cap
v = pnum a q
if lt v lim
lim = v
end
else
found = true
end
end
end
p = add e 1
end
if not found
wfd 2 m_path
exit 2
end
ret lim
end

note fit: every OVL `cap CHARS PATH` line against the render of its target; a finding for each render over
note its cap and each cap without a target
fn fit to void
n = get st s_n
p = get st s_ns
while lt p n bound 16777216
e = lend p
if lpre p e w_cap
a = add p len w_cap
q = a
while lt q e bound 4096
if eq get rb q 32
break
end
q = add q 1
end
lim = pnum a q
t = tfind add q 1 e
if eq t n
wfd 1 t_notgt
wrb 1 add q 1 e
wfd 1 nl
put st s_bad add get st s_bad 1
else
g = add t len w_target
h = g
while lt h e bound 4096
if eq get rb h 32
break
end
h = add h 1
end
for i ulong sub h g bound 4096
put ab i get rb add g i
end
put st s_al sub h g
k = boundedbuild wbit g h lim
put st s_on 0
wfd 1 t_fit
wrb 1 g h
wfd 1 sp
wrb 1 add q 1 e
wfd 1 sp
wnum 1 k
wfd 1 t_of
wnum 1 lim
if gt k lim
wfd 1 t_over
put st s_bad add get st s_bad 1
else
wfd 1 t_ok
end
end
end
p = add e 1
end
end

note ---------------------------------------------------------------- targets

fn targets to void
n = get st s_n
p = get st s_ns
while lt p n bound 16777216
e = lend p
if lpre p e w_target
orb p e
o 10
end
if lpre p e w_skills
ot w_skills
ot dash
orb add p len w_skills e
o 10
end
if lpre p e w_alarm
ot w_alarm
ot dash
orb add p len w_alarm e
o 10
end
p = add e 1
end
flush
end

note ---------------------------------------------------------------- main

fn main to int
c = argcnt
if lt c 3
wfd 2 m_use
ret 2
end
k = ldarg 1
mode = ulong 9
if argis a_lint k
mode = ulong 0
end
if argis a_render k
mode = ulong 1
end
if argis a_tgts k
mode = ulong 2
end
if argis a_fit k
mode = ulong 3
end
if and eq mode 1 and ne c 6 ne c 7
wfd 2 m_use
ret 2
end
if or eq mode 9 or and eq mode 2 ne c 4 and eq mode 3 ne c 5
wfd 2 m_use
ret 2
end
if and eq mode 0 gt c 4
wfd 2 m_use
ret 2
end
put st s_n 0
put st s_on 0
put st s_bad 0
ldfile 2
put st s_ns get st s_n
if ge c 4
ldfile 3
end
parse
if eq mode 0
private
if gt get st s_n div capb 2
wfd 1 m_alarm
put st s_bad add get st s_bad 1
end
wfd 1 m_lint
wnum 1 get st s_nr
wfd 1 f_rules
wnum 1 get st s_bad
wfd 1 sp
wfd 1 f_tg
if ne get st s_bad 0
ret 1
end
ret 0
end
if ne get st s_bad 0
ret 2
end
if eq mode 2
targets
ret 0
end
hi = ulong 5
if eq mode 3
hi = ulong 4
end
h = ldarg hi
if gt h 128
wfd 2 m_use
ret 2
end
for i ulong h bound 128
put hd i get ab i
end
put st s_hl h
if eq mode 3
fit
if ne get st s_bad 0
ret 1
end
ret 0
end
lim = ulong 18446744073709551615
a = ldarg 4
m = wbit2 a
if eq m 0
wfd 2 m_prog
z = write 2 ab 0 a
wfd 2 nl
ret 2
end
if eq c 7
lim = pathlimit ldarg 6 m
a = ldarg 4
end
put st s_al a
if gt boundedbuild m lim lim
wfd 2 m_over
ret 1
end
flush
ret 0
end

note wbit2: the program named by ab[0, a)
fn wbit2 a ulong to ulong
if argis p_claude a
ret 1
end
if argis p_codex a
ret 2
end
if argis p_agents a
ret 4
end
if argis p_omp a
ret 8
end
if argis p_watch a
ret 16
end
if argis p_gen a
ret genm
end
ret 0
end

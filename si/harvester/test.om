om2
note si/harvester/test.om: Standalone OM-2 behavioral test suite for zero-telemetry harvester.
note Tests markdown heading/code-fence/metadata/link extraction, <think>/<thought> reasoning & scoring,
note telemetry domain rejection, tracking query parameter stripping, unsafe scheme refusal,
note SHA-256 link deduplication, and RFC 8259 JSONL escaping.

global inbuf uchar 32768
global outbuf uchar 32768
global urlbuf uchar 512
global cleanurl uchar 512
global decbuf uchar 32
global stats ulong 16
global shastate uint 8
global shak uint 64
global shaw uint 64
global shablk uchar 64
global shadig uchar 32
global shahex uchar 64
global seenfp uchar 4096

const st_inlen ulong 0
const st_outlen ulong 1
const st_heads ulong 2
const st_blocks ulong 3
const st_links ulong 4
const st_telrej ulong 5
const st_strip ulong 6
const st_meta ulong 7
const st_reas ulong 8
const st_qual ulong 9
const st_clen ulong 10
const st_seencnt ulong 11
const st_dedup ulong 12

text khex "0123456789abcdef"
text j_head1 "{\"type\":\"heading\",\"level\":"
text j_text ",\"text\":\""
text j_link1 "{\"type\":\"link\",\"text\":\""
text j_url "\",\"url\":\""
text j_meta1 "{\"type\":\"meta\",\"key\":\""
text j_val "\",\"value\":\""
text j_reas1 "{\"type\":\"reasoning\",\"tokens\":"
text j_qm ",\"quality_milli\":"
text j_sum1 "{\"type\":\"summary\",\"headings\":"
text j_sum2 ",\"code_blocks\":"
text j_sum3 ",\"links\":"
text j_sum4 ",\"telemetry_rejected\":"
text j_sum5 ",\"tracking_stripped\":"
text j_sum6 ",\"meta\":"
text j_sum7 ",\"reasoning\":"
text j_sum8 ",\"quality_milli\":"
text j_sum9 ",\"sha256\":\""
text j_end "\"}\n"

text t_fence "```"
text t_think_o "<think>"
text t_think_c "</think>"
text t_thought_o "<thought>"
text t_thought_c "</thought>"
text t_kw_step "step"
text t_kw_ver "verify"
text t_kw_bigo "O("


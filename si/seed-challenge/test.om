om2
note si/seed-challenge/test.om: Standalone OM-2 behavioral test suite for seed-challenge verifier.
note Tests positive verification (SHA-256 KATs, full seed0->hex1->asm2->om4->omc ladder pin table + log)
note and negative/refusal controls (flipped rung byte, forged stage2 digest, uppercase/short digest,
note missing rung chain link, injected FAIL/NOT_RUN line, non-aarch64 host, forged CHALLENGE footer).

global expbuf uchar 16384
global logbuf uchar 32768
global pinbuf uchar 64
global omcsha uchar 64
global patbuf uchar 512
global decbuf uchar 32
global rungseen ulong 8
global gmeta ulong 12
global shastate uint 8
global shak uint 64
global shaw uint 64
global shablk uchar 64
global shadig uchar 32
global shahex uchar 64
global testbuf uchar 128

const m_elen ulong 0
const m_llen ulong 1
const m_plen ulong 2
const m_olen ulong 3
const m_bad ulong 4
const m_patlen ulong 5
const m_expe ulong 6

const r_seed0 ulong 0
const r_hex1 ulong 1
const r_asm2 ulong 2
const r_om4 ulong 3
const r_omc ulong 4
const r_pin ulong 5
const r_incnt ulong 6
const r_rcnt ulong 7

text khex "0123456789abcdef"
text t_pin "pin "
text t_input "input "
text t_rung "rung "
text t_seed0 "seed0"
text t_hex1 "hex1"
text t_asm2 "asm2"
text t_om4 "om4"
text t_omc "omc"
text t_host "host "
text t_a64 "aarch64"
text t_pass_in "PASS input "
text t_pass_rg "PASS rung "
text t_st1 "stage1 "
text t_st2 "stage2 "
text t_st3 "stage3 "
text t_fail "FAIL "
text t_notrun "NOT_RUN "
text t_ch_pfx "CHALLENGE "
text t_ch_pass "CHALLENGE PASS pin="
text t_ch_omc " omc="

note Test vectors (real omega-mv seed/challenge/expected-v1.txt and DGX Spark log)

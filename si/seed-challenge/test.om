fn write_all fd int src view uchar * off ulong n ulong to void
p = ulong 0
while lt p n bound 4096
k = write fd src add off p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn wstr fd int s view uchar * to void
write_all fd s 0 len s
end

fn wdec fd int v ulong to void
i = ulong 32
n = v
while true bound 24
i = sub i 1
put decbuf i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
p = i
while lt p 32 bound 32
k = write fd decbuf p sub 32 p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn fail_case id ulong to void
wstr 2 f_msg
wdec 2 id
wstr 2 t_nl
exit 1
end

fn is_hex_ch c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 102
ret true
end
ret false
end

fn is_dig_ch c uchar to bool
ret and ge c 48 le c 57
end

fn is_hex_exp off ulong n ulong to bool
if eq n 0
ret false
end
if gt add off n 16384
ret false
end
i = ulong 0
while lt i n bound 128
if not is_hex_ch get expbuf add off i
ret false
end
i = add i 1
end
ret true
end

fn is_dec_exp off ulong n ulong to bool
if eq n 0
ret false
end
if gt n 20
ret false
end
if gt add off n 16384
ret false
end
nz = false
i = ulong 0
while lt i n bound 32
c = get expbuf add off i
if not is_dig_ch c
ret false
end
if ne c 48
nz = true
end
i = add i 1
end
ret nz
end

fn is_hex_view s view uchar * n ulong to bool
if ne len s n
ret false
end
i = ulong 0
while lt i n bound 128
if not is_hex_ch get s i
ret false
end
i = add i 1
end
ret true
end

fn sha_kinit to void
put shak 0 0x428a2f98
put shak 1 0x71374491
put shak 2 0xb5c0fbcf
put shak 3 0xe9b5dba5
put shak 4 0x3956c25b
put shak 5 0x59f111f1
put shak 6 0x923f82a4
put shak 7 0xab1c5ed5
put shak 8 0xd807aa98
put shak 9 0x12835b01
put shak 10 0x243185be
put shak 11 0x550c7dc3
put shak 12 0x72be5d74
put shak 13 0x80deb1fe
put shak 14 0x9bdc06a7
put shak 15 0xc19bf174
put shak 16 0xe49b69c1
put shak 17 0xefbe4786
put shak 18 0x0fc19dc6
put shak 19 0x240ca1cc
put shak 20 0x2de92c6f
put shak 21 0x4a7484aa
put shak 22 0x5cb0a9dc
put shak 23 0x76f988da
put shak 24 0x983e5152
put shak 25 0xa831c66d
put shak 26 0xb00327c8
put shak 27 0xbf597fc7
put shak 28 0xc6e00bf3
put shak 29 0xd5a79147
put shak 30 0x06ca6351
put shak 31 0x14292967
put shak 32 0x27b70a85
put shak 33 0x2e1b2138
put shak 34 0x4d2c6dfc
put shak 35 0x53380d13
put shak 36 0x650a7354
put shak 37 0x766a0abb
put shak 38 0x81c2c92e
put shak 39 0x92722c85
put shak 40 0xa2bfe8a1
put shak 41 0xa81a664b
put shak 42 0xc24b8b70
put shak 43 0xc76c51a3
put shak 44 0xd192e819
put shak 45 0xd6990624
put shak 46 0xf40e3585
put shak 47 0x106aa070
put shak 48 0x19a4c116
put shak 49 0x1e376c08
put shak 50 0x2748774c
put shak 51 0x34b0bcb5
put shak 52 0x391c0cb3
put shak 53 0x4ed8aa4a
put shak 54 0x5b9cca4f
put shak 55 0x682e6ff3
put shak 56 0x748f82ee
put shak 57 0x78a5636f
put shak 58 0x84c87814
put shak 59 0x8cc70208
put shak 60 0x90befffa
put shak 61 0xa4506ceb
put shak 62 0xbef9a3f7
put shak 63 0xc67178f2
end

fn sha_iv to void
put shastate 0 0x6a09e667
put shastate 1 0xbb67ae85
put shastate 2 0x3c6ef372
put shastate 3 0xa54ff53a
put shastate 4 0x510e527f
put shastate 5 0x9b05688c
put shastate 6 0x1f83d9ab
put shastate 7 0x5be0cd19
end

fn sha_sched to void
for i ulong 16
q = mul i 4
x = uint get shablk q
x = or shl x 8 uint get shablk add q 1
x = or shl x 8 uint get shablk add q 2
put shaw i or shl x 8 uint get shablk add q 3
end
for i ulong 48
x = get shaw add i 1
y = get shaw add i 14
s0 = xor xor rotr x 7 rotr x 18 shr x 3
s1 = xor xor rotr y 17 rotr y 19 shr y 10
put shaw add i 16 add add get shaw i get shaw add i 9 add s0 s1
end
end

fn sha_compress to void
sha_sched
a = get shastate 0
b = get shastate 1
c = get shastate 2
d = get shastate 3
e = get shastate 4
f = get shastate 5
g = get shastate 6
h = get shastate 7
t = uint 0
for i ulong 64
h = add h get shak i
h = add h get shaw i
t = xor rotr e 6 rotr e 11
t = xor t rotr e 25
h = add h t
h = add h xor g and e xor f g
d = add d h
t = xor rotr a 2 rotr a 13
t = xor t rotr a 22
h = add h t
h = add h or and a b and c or a b
t = h
h = g
g = f
f = e
e = d
d = c
c = b
b = a
a = t
end
put shastate 0 add get shastate 0 a
put shastate 1 add get shastate 1 b
put shastate 2 add get shastate 2 c
put shastate 3 add get shastate 3 d
put shastate 4 add get shastate 4 e
put shastate 5 add get shastate 5 f
put shastate 6 add get shastate 6 g
put shastate 7 add get shastate 7 h
end

fn sha256_bytes src view uchar * dlen ulong to void
sha_kinit
sha_iv
off = ulong 0
while ge sub dlen off 64 bound 65536
for j ulong 64
put shablk j get src add off j
end
sha_compress
off = add off 64
end
remn = sub dlen off
for j ulong 64
if lt j remn
put shablk j get src add off j
else
put shablk j 0
end
end
put shablk remn 0x80
if gt remn 55
sha_compress
for j ulong 64
put shablk j 0
end
end
bits = mul dlen 8
put shablk 56 uchar and shr bits 56 255
put shablk 57 uchar and shr bits 48 255
put shablk 58 uchar and shr bits 40 255
put shablk 59 uchar and shr bits 32 255
put shablk 60 uchar and shr bits 24 255
put shablk 61 uchar and shr bits 16 255
put shablk 62 uchar and shr bits 8 255
put shablk 63 uchar and bits 255
sha_compress
for i ulong 8
w = get shastate i
q = mul i 4
put shadig q uchar and shr w 24 255
put shadig add q 1 uchar and shr w 16 255
put shadig add q 2 uchar and shr w 8 255
put shadig add q 3 uchar and w 255
end
for i ulong 32
bv = ulong get shadig i
put shahex mul i 2 get khex shr bv 4
put shahex add mul i 2 1 get khex and bv 15
end
end

fn verify_rung_bytes src view uchar * dlen ulong exphex view uchar * to bool
if not is_hex_view exphex 64
ret false
end
sha256_bytes src dlen
for i ulong 64
if ne get shahex i get exphex i
ret false
end
end
ret true
end

fn exp_reset to void
put gmeta m_elen 0
end

fn exp_append s view uchar * to void
tot = get gmeta m_elen
n = len s
i = ulong 0
while lt i n bound 4096
put expbuf add tot i get s i
i = add i 1
end
put gmeta m_elen add tot n
end

fn log_reset to void
put gmeta m_llen 0
end

fn log_append s view uchar * to void
tot = get gmeta m_llen
n = len s
i = ulong 0
while lt i n bound 4096
put logbuf add tot i get s i
i = add i 1
end
put gmeta m_llen add tot n
end

fn pat_clear to void
put gmeta m_patlen 0
end

fn pat_push_ch c uchar to void
n = get gmeta m_patlen
if lt n 512
put patbuf n c
put gmeta m_patlen add n 1
end
end

fn pat_push_lit s view uchar * to void
sl = len s
i = ulong 0
while lt i sl bound 512
pat_push_ch get s i
i = add i 1
end
end

fn pat_push_exp off ulong n ulong to void
i = ulong 0
while lt i n bound 512
if lt add off i 16384
pat_push_ch get expbuf add off i
end
i = add i 1
end
end

fn pat_push_pin to void
n = get gmeta m_plen
i = ulong 0
while lt i n bound 64
pat_push_ch get pinbuf i
i = add i 1
end
end

fn pat_push_omc to void
n = get gmeta m_olen
i = ulong 0
while lt i n bound 64
pat_push_ch get omcsha i
i = add i 1
end
end

fn exp_eq off ulong n ulong lit view uchar * to bool
if ne n len lit
ret false
end
i = ulong 0
while lt i n bound 512
if ne get expbuf add off i get lit i
ret false
end
i = add i 1
end
ret true
end

fn exp_starts off ulong elen ulong pfx view uchar * to bool
pl = len pfx
if lt elen pl
ret false
end
i = ulong 0
while lt i pl bound 512
if ne get expbuf add off i get pfx i
ret false
end
i = add i 1
end
ret true
end

fn log_starts off ulong llen ulong pfx view uchar * to bool
pl = len pfx
if lt llen pl
ret false
end
i = ulong 0
while lt i pl bound 512
if ne get logbuf add off i get pfx i
ret false
end
i = add i 1
end
ret true
end

fn log_contains off ulong llen ulong needle view uchar * to bool
nl = len needle
if gt nl llen
ret false
end
lim = add sub llen nl 1
i = ulong 0
while lt i lim bound 1024
if log_starts add off i sub llen i needle
ret true
end
i = add i 1
end
ret false
end

fn log_line_matches_pat off ulong llen ulong allow_ms bool to bool
pl = get gmeta m_patlen
if lt llen pl
ret false
end
i = ulong 0
while lt i pl bound 512
if ne get logbuf add off i get patbuf i
ret false
end
i = add i 1
end
if eq llen pl
ret true
end
if not allow_ms
ret false
end
if lt sub llen pl 4
ret false
end
if ne get logbuf add off pl 32
ret false
end
if ne get logbuf add off sub llen 2 109
ret false
end
if ne get logbuf add off sub llen 1 115
ret false
end
pos = add pl 1
endpos = sub llen 2
if ge pos endpos
ret false
end
while lt pos endpos bound 32
if not is_dig_ch get logbuf add off pos
ret false
end
pos = add pos 1
end
ret true
end

fn log_has_pat allow_ms bool to bool
tot = get gmeta m_llen
pos = ulong 0
while lt pos tot bound 32768
ls = pos
while lt pos tot bound 32768
if eq get logbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
if log_line_matches_pat ls ll allow_ms
ret true
end
if lt pos tot
pos = add pos 1
end
end
ret false
end

fn log_has_aarch64_host to bool
tot = get gmeta m_llen
pos = ulong 0
while lt pos tot bound 32768
ls = pos
while lt pos tot bound 32768
if eq get logbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
if log_starts ls ll t_host
if log_contains ls ll t_a64
ret true
end
end
if lt pos tot
pos = add pos 1
end
end
ret false
end

fn log_has_fail_or_notrun to bool
tot = get gmeta m_llen
pos = ulong 0
while lt pos tot bound 32768
ls = pos
while lt pos tot bound 32768
if eq get logbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
off = ls
remn = ll
if log_starts ls ll t_st1
off = add ls 7
remn = sub ll 7
else
if log_starts ls ll t_st2
off = add ls 7
remn = sub ll 7
else
if log_starts ls ll t_st3
off = add ls 7
remn = sub ll 7
end
end
end
if log_starts off remn t_fail
ret true
end
if log_starts off remn t_notrun
ret true
end
if lt pos tot
pos = add pos 1
end
end
ret false
end

fn log_check_last_challenge to bool
pat_clear
pat_push_lit t_ch_pass
pat_push_pin
pat_push_lit t_ch_omc
pat_push_omc
tot = get gmeta m_llen
pos = ulong 0
found = false
matched = false
while lt pos tot bound 32768
ls = pos
while lt pos tot bound 32768
if eq get logbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
if log_starts ls ll t_ch_pfx
found = true
matched = log_line_matches_pat ls ll false
end
if lt pos tot
pos = add pos 1
end
end
if not found
ret false
end
ret matched
end

fn find_space_exp pos ulong lim ulong to ulong
p = pos
while lt p lim bound 512
if eq get expbuf p 32
ret p
end
p = add p 1
end
ret lim
end

fn identify_rung p1 ulong nlen ulong to ulong
if exp_eq p1 nlen t_seed0
ret r_seed0
end
if exp_eq p1 nlen t_hex1
ret r_hex1
end
if exp_eq p1 nlen t_asm2
ret r_asm2
end
if exp_eq p1 nlen t_om4
ret r_om4
end
if exp_eq p1 nlen t_omc
ret r_omc
end
ret 99
end

fn check_omc_stages p1 ulong remn ulong to void
pat_clear
pat_push_lit t_st1
pat_push_lit t_pass_rg
pat_push_exp p1 remn
ok = log_has_pat true
pat_clear
pat_push_lit t_st2
pat_push_lit t_pass_rg
pat_push_exp p1 remn
if not log_has_pat true
ok = false
end
pat_clear
pat_push_lit t_st3
pat_push_lit t_pass_rg
pat_push_exp p1 remn
if not log_has_pat true
ok = false
end
if not ok
put gmeta m_bad add get gmeta m_bad 1
end
end

fn check_input_line ls ulong le_pos ulong to void
p1 = add ls 6
s1 = find_space_exp p1 le_pos
if or eq s1 p1 ge s1 le_pos
put gmeta m_expe add get gmeta m_expe 1
ret
end
p2 = add s1 1
s2 = find_space_exp p2 le_pos
if or ne sub s2 p2 64 ge s2 le_pos
put gmeta m_expe add get gmeta m_expe 1
ret
end
if not is_hex_exp p2 64
put gmeta m_expe add get gmeta m_expe 1
ret
end
p3 = add s2 1
if not is_dec_exp p3 sub le_pos p3
put gmeta m_expe add get gmeta m_expe 1
ret
end
pat_clear
pat_push_lit t_pass_in
pat_push_exp p1 sub le_pos p1
if not log_has_pat false
put gmeta m_bad add get gmeta m_bad 1
end
end

fn check_rung_line ls ulong le_pos ulong to void
p1 = add ls 5
s1 = find_space_exp p1 le_pos
nlen = sub s1 p1
if or eq nlen 0 ge s1 le_pos
put gmeta m_expe add get gmeta m_expe 1
ret
end
p2 = add s1 1
s2 = find_space_exp p2 le_pos
if or ne sub s2 p2 64 ge s2 le_pos
put gmeta m_expe add get gmeta m_expe 1
ret
end
if not is_hex_exp p2 64
put gmeta m_expe add get gmeta m_expe 1
ret
end
p3 = add s2 1
if not is_dec_exp p3 sub le_pos p3
put gmeta m_expe add get gmeta m_expe 1
ret
end
ridx = identify_rung p1 nlen
if eq ridx 99
put gmeta m_expe add get gmeta m_expe 1
ret
end
put rungseen ridx 1
if eq ridx r_omc
for i ulong 64
put omcsha i get expbuf add p2 i
end
put gmeta m_olen 64
check_omc_stages p1 sub le_pos p1
else
pat_clear
pat_push_lit t_pass_rg
pat_push_exp p1 sub le_pos p1
if not log_has_pat true
put gmeta m_bad add get gmeta m_bad 1
end
end
end

fn verify_loaded to int
for i ulong 8
put rungseen i 0
end
put gmeta m_plen 0
put gmeta m_olen 0
put gmeta m_bad 0
put gmeta m_expe 0
etot = get gmeta m_elen
pos = ulong 0
while lt pos etot bound 16384
ls = pos
while lt pos etot bound 16384
if eq get expbuf pos 10
break
end
pos = add pos 1
end
ll = sub pos ls
if gt ll 0
if ne get expbuf ls 35
if exp_starts ls ll t_pin
plen = sub ll 4
if and eq plen 40 is_hex_exp add ls 4 40
for j ulong 40
put pinbuf j get expbuf add add ls 4 j
end
put gmeta m_plen 40
put rungseen r_pin 1
else
put gmeta m_expe add get gmeta m_expe 1
end
else
if exp_starts ls ll t_input
check_input_line ls pos
else
if exp_starts ls ll t_rung
check_rung_line ls pos
else
put gmeta m_expe add get gmeta m_expe 1
end
end
end
end
end
if lt pos etot
pos = add pos 1
end
end
if gt get gmeta m_expe 0
ret 2
end
if eq get rungseen r_pin 0
ret 2
end
chain_ok = true
for r ulong 5
if eq get rungseen r 0
chain_ok = false
end
end
if not chain_ok
put gmeta m_bad add get gmeta m_bad 1
end
pat_clear
pat_push_lit t_pin
pat_push_pin
if not log_has_pat false
put gmeta m_bad add get gmeta m_bad 1
end
if not log_has_aarch64_host
put gmeta m_bad add get gmeta m_bad 1
end
if log_has_fail_or_notrun
put gmeta m_bad add get gmeta m_bad 1
end
if not log_check_last_challenge
put gmeta m_bad add get gmeta m_bad 1
end
if eq get gmeta m_bad 0
ret 0
end
ret 1
end

fn load_valid_exp to void
exp_reset
exp_append exp_v1_a
exp_append exp_v1_b
exp_append exp_v1_c
end

fn load_valid_log to void
log_reset
log_append log_v1_a
log_append log_v1_b
log_append log_v1_c
log_append log_v1_d
log_append log_v1_e
end

fn test_sha_and_flip to void
note Test 1: SHA-256 KATs (empty and "abc")
empty_arr = new uchar 4 0
if not verify_rung_bytes empty_arr 0 sha_empty
fail_case 1
end
if not verify_rung_bytes msg_abc 3 sha_abc
fail_case 1
end
wstr 1 p_sha_kat
note Test 2: negative control - flip 1 bit in rung bytes ("abc" -> "bbc") must fail
rung_buf = new uchar 8 0
put rung_buf 0 97
put rung_buf 1 98
put rung_buf 2 99
if not verify_rung_bytes rung_buf 3 sha_abc
fail_case 2
end
put rung_buf 0 98
if verify_rung_bytes rung_buf 3 sha_abc
fail_case 2
end
wstr 1 p_flip_byte
end

fn test_hex_formats to void
note Test 3: strict 64-hex and 40-hex lowercase format validation
if not is_hex_view sha_abc 64
fail_case 3
end
if not is_hex_view pin_ok 40
fail_case 3
end
if is_hex_view hex_short 64
fail_case 3
end
if is_hex_view hex_upper 64
fail_case 3
end
if is_hex_view hex_badch 64
fail_case 3
end
wstr 1 p_hex_fmt
end

fn main to int
test_sha_and_flip
test_hex_formats

note Test 4: positive full v1 ladder + DGX Spark log
load_valid_exp
load_valid_log
if ne verify_loaded 0
fail_case 4
end
wstr 1 p_valid_v1

note Test 5: negative control - forged stage2 omc digest
load_valid_exp
log_reset
log_append log_v1_a
log_append log_v1_b
log_append log_v1_c
log_append log_bad_st2
log_append log_v1_e
if ne verify_loaded 1
fail_case 5
end
wstr 1 p_neg_st2

note Test 6: negative control - incomplete rung chain (missing asm2)
exp_reset
exp_append exp_v1_a
exp_append exp_v1_b
exp_append exp_no_asm2
load_valid_log
if ne verify_loaded 1
fail_case 6
end
wstr 1 p_neg_chain

note Test 7: negative control - injected FAIL line in log
load_valid_exp
load_valid_log
log_append log_inj_fail
if ne verify_loaded 1
fail_case 7
end
wstr 1 p_neg_fail

note Test 8: negative control - non-aarch64 host line
load_valid_exp
log_reset
log_append log_x86_host
log_append log_v1_b
log_append log_v1_c
log_append log_v1_d
log_append log_v1_e
if ne verify_loaded 1
fail_case 8
end
wstr 1 p_neg_host

note Test 9: negative control - malformed expected digest (uppercase hex)
exp_reset
exp_append exp_bad_hex
load_valid_log
if ne verify_loaded 2
fail_case 9
end
wstr 1 p_neg_exp

note Test 10: negative control - forged final CHALLENGE footer
load_valid_exp
log_reset
log_append log_v1_a
log_append log_v1_b
log_append log_v1_c
log_append log_v1_d
log_append log_bad_foot
if ne verify_loaded 1
fail_case 10
end
wstr 1 p_neg_foot

wstr 1 p_all
ret 0
end

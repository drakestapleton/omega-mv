note SPDX-License-Identifier: Apache-2.0
note si/benchmarks/verify/test.om: positive & negative control test suite for
note benchmarks-mv bundle validator, MEASURED vs MODELED discriminator, and ceiling comparator.
note Compose with:
note   si/directives/om2.om om/tls/sha2.om si/benchmarks/verify/bundle.om si/benchmarks/verify/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"

text t_c1 "evidence_class_label_parsing_positive_and_negative"
text t_c2 "measured_vs_modeled_anti_laundering_discriminator"
text t_c3 "qualification_gate_refuses_modeled_and_estimated"
text t_c4 "quantile_monotonicity_and_negative_controls"
text t_c5 "bundle_metadata_sha_samples_and_throughput_controls"
text t_c6 "hardware_ceiling_and_regression_basis_point_comparator"
text t_c7 "bundle_digest_determinism_and_tamper_sensitivity"
text t_done "PASS benchmarks-verify all 7 test suites passed\n"

text t_lbl_m "MEASURED"
text t_lbl_mod "MODELED"
text t_lbl_est "ESTIMATED"
text t_lbl_syn "SYNTHETIC"
text t_lbl_bad "MEASURED_EST"

text t_sha40_ok "3a9fe6de80123456789abcdef0123456789abcde"
text t_sha40_bad "3a9fe6de"
text t_sha64_ok "34d611ca0415eab1728d3234911d90e74af17ba9ab0c581d559f48274d7ca6d3"
text t_sha64_bad "bad"

fn report_case name view uchar * ok bool to int
if ok
w1 = bm_write_all int 1 t_pass
w2 = bm_write_all int 1 name
w3 = bm_write_all int 1 t_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = bm_write_all int 1 t_fail
w5 = bm_write_all int 1 name
w6 = bm_write_all int 1 t_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_class_labels to bool
if ne bm_parse_class t_lbl_m BM_CLASS_MEASURED
ret false
end
if ne bm_parse_class t_lbl_mod BM_CLASS_MODELED
ret false
end
if ne bm_parse_class t_lbl_est BM_CLASS_ESTIMATED
ret false
end
if ne bm_parse_class t_lbl_syn BM_CLASS_SYNTHETIC
ret false
end
note Negative control: ambiguous hybrid label rejected
if ne bm_parse_class t_lbl_bad ulong 0
ret false
end
ret true
end

fn test_discriminator to bool
note Clean hardware-measured run with 100 samples passes
if ne bm_discriminate_class BM_CLASS_MEASURED ulong 100 true false false BM_OK
ret false
end
note MODELED run with extrapolated=true is allowed as MODELED
if ne bm_discriminate_class BM_CLASS_MODELED ulong 0 false false true BM_OK
ret false
end
note Negative controls: extrapolated or missing HW receipt labeled MEASURED MUST be refused
if ne bm_discriminate_class BM_CLASS_MEASURED ulong 100 true false true BM_ERR_MODELED_AS_MEASURED
ret false
end
if ne bm_discriminate_class BM_CLASS_MEASURED ulong 100 false false false BM_ERR_MODELED_AS_MEASURED
ret false
end
if ne bm_discriminate_class BM_CLASS_MEASURED ulong 100 true true false BM_ERR_DIRTY_TREE
ret false
end
if ne bm_discriminate_class BM_CLASS_MEASURED ulong 0 true false false BM_ERR_TOO_FEW_SAMPLES
ret false
end
ret true
end

fn test_qualification_gate to bool
if ne bm_allow_qualification BM_CLASS_MEASURED BM_OK
ret false
end
if ne bm_allow_qualification BM_CLASS_MODELED BM_ERR_NOT_MEASURED
ret false
end
if ne bm_allow_qualification BM_CLASS_ESTIMATED BM_ERR_NOT_MEASURED
ret false
end
if ne bm_allow_qualification BM_CLASS_SYNTHETIC BM_ERR_NOT_MEASURED
ret false
end
ret true
end

fn test_quantiles to bool
if ne bm_validate_quantiles ulong 100 ulong 120 ulong 150 ulong 180 ulong 210 BM_OK
ret false
end
note Negative controls: zero min, p50 < min, p95 < p50, p99 < p95, max < p99
if ne bm_validate_quantiles ulong 0 ulong 120 ulong 150 ulong 180 ulong 210 BM_ERR_NONMONOTONIC_Q
ret false
end
if ne bm_validate_quantiles ulong 130 ulong 120 ulong 150 ulong 180 ulong 210 BM_ERR_NONMONOTONIC_Q
ret false
end
if ne bm_validate_quantiles ulong 100 ulong 160 ulong 150 ulong 180 ulong 210 BM_ERR_NONMONOTONIC_Q
ret false
end
if ne bm_validate_quantiles ulong 100 ulong 120 ulong 190 ulong 180 ulong 210 BM_ERR_NONMONOTONIC_Q
ret false
end
if ne bm_validate_quantiles ulong 100 ulong 120 ulong 150 ulong 220 ulong 210 BM_ERR_NONMONOTONIC_Q
ret false
end
ret true
end

fn test_bundle_meta to bool
if ne bm_validate_bundle_shas t_sha40_ok t_sha64_ok BM_OK
ret false
end
if ne bm_validate_bundle_counts ulong 50 ulong 30 ulong 1200 BM_OK
ret false
end
if ne bm_validate_bundle_shas t_sha40_bad t_sha64_ok BM_ERR_BAD_SHA
ret false
end
if ne bm_validate_bundle_shas t_sha40_ok t_sha64_bad BM_ERR_BAD_SHA
ret false
end
if ne bm_validate_bundle_counts ulong 10 ulong 30 ulong 1200 BM_ERR_TOO_FEW_SAMPLES
ret false
end
if ne bm_validate_bundle_counts ulong 50 ulong 30 ulong 0 BM_ERR_ZERO_THROUGHPUT
ret false
end
ret true
end

fn test_ceiling_and_regression to bool
note Ceiling check: 240 GB/s <= 273 GB/s passes; 300 GB/s > 273 GB/s refused
if ne bm_check_ceiling ulong 240 ulong 273 BM_OK
ret false
end
if ne bm_check_ceiling ulong 300 ulong 273 BM_ERR_EXCEEDS_CEILING
ret false
end
if ne bm_check_ceiling ulong 100 ulong 0 BM_ERR_EXCEEDS_CEILING
ret false
end
note Regression check: 500 bps (5%) budget on baseline 1000us -> 1050us passes, 1051us refused
if ne bm_check_latency_regression ulong 1000 ulong 1050 ulong 500 BM_OK
ret false
end
if ne bm_check_latency_regression ulong 1000 ulong 1051 ulong 500 BM_ERR_REGRESSION
ret false
end
if ne bm_check_latency_regression ulong 0 ulong 100 ulong 500 BM_ERR_ZERO_BASELINE
ret false
end
note Throughput floor check
if ne bm_check_throughput_floor ulong 1000 ulong 950 BM_OK
ret false
end
if ne bm_check_throughput_floor ulong 949 ulong 950 BM_ERR_BELOW_FLOOR
ret false
end
ret true
end

fn test_bundle_digest to bool
m = new ulong 4 0
put m 0 BM_CLASS_MEASURED
put m 1 ulong 100
put m 2 ulong 120
put m 3 ulong 180
d1 = new uchar 32 0
d2 = new uchar 32 0
bm_bundle_digest m t_sha40_ok d1
bm_bundle_digest m t_sha40_ok d2
if not bm_digest_eq d1 d2
ret false
end
put m 0 BM_CLASS_MODELED
bm_bundle_digest m t_sha40_ok d2
if bm_digest_eq d1 d2
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_c1 test_class_labels
fail = add fail report_case t_c2 test_discriminator
fail = add fail report_case t_c3 test_qualification_gate
fail = add fail report_case t_c4 test_quantiles
fail = add fail report_case t_c5 test_bundle_meta
fail = add fail report_case t_c6 test_ceiling_and_regression
fail = add fail report_case t_c7 test_bundle_digest
if ne fail int 0
ret int 1
end
ok = bm_write_all int 1 t_done
if not ok
ret int 1
end
ret int 0
end

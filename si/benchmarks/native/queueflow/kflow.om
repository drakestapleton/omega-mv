note SPDX-License-Identifier: Apache-2.0
note kflow.om (DRA-190): flow bookkeeping of a Hermes kanban board export (export-kanban.sh).
note Built with omc sha256 3ad9f10f... (omega-mv f4df8239).
note   kflow TASKS RUNS EVENTS TX CAP
note TX: the export time (epoch s; a run with no end is counted as running until TX). CAP: the
note dispatcher's max_in_progress. Prints KQ lines of integers only; ratios and thresholds are
note evaluated outside (Wolfram, PREREG.md section 6). Exit 0 ok, 2 usage, 3 I/O or malformed
note input, 4 more than 4096 rows in a file.
note Checks (PREREG.md section 5): conservation of the open-task node (created minus closed events
note against the task table), of the running node (run starts minus run ends against tasks in
note status running), and the slot bound (concurrent runs never above CAP).
om2

const MAXN ulong 4096

global arg uchar 1024
global buf uchar 1048576
global ob uchar 8192
global st ulong 16
global num uchar 24
global row long 16
global ti long 4096
global tc long 4096
global ts long 4096
global tp long 4096
global td long 4096
global ri long 4096
global rs long 4096
global re long 4096
global ro long 4096
global ei long 4096
global et long 4096
global ek long 4096
global cnt long 4096
global fl long 4096
global wk long 4096
global wv long 4096
global gv long 32

text t_usage "usage: kflow TASKS RUNS EVENTS TX CAP\n"
text t_ioerr "KQ error io\n"
text t_bad "KQ error malformed\n"
text t_big "KQ error rows > 4096\n"
text t_nl "\n"
text t_tr "KQ trace tasks="
text t_runs " runs="
text t_evs " events="
text t_tx " tx="
text t_cap " cap="
text t_sys "KQ sys created="
text t_clo " closed="
text t_oev " open_events="
text t_otb " open_table="
text t_mis " mismatch="
text t_run "KQ run starts="
text t_ends " ends="
text t_rr " running_runs="
text t_rt " running_table="
text t_conc "KQ conc max="
text t_over " overcap_s="
text t_rty "KQ retry extra="
text t_multi " tasks_multi="
text t_badr " bad="
text t_acc "KQ acc done="
text t_dcomp " done_completed_run="
text t_lat "KQ lat n="
text t_sum " sum="
text t_p95 " p95="
text t_max " max="
text t_fst "KQ first n="
text t_util "KQ util busy="
text t_h " h="
text t_pool "KQ pool p="
text t_pbusy " busy="
text t_puni " union="
text t_pmax " maxc="
text t_arm "KQ arm=Cr dropped="
text t_dacc " dropped_completed="

fn pr t view uchar * to void
w = write 1 t 0 len t
end

fn argn i ulong to ulong
if ge i ulong argcnt
ret 0
end
n = argread i arg 0 len arg
if le n 0
ret 0
end
ret ulong n
end

fn oreset to void
put st 2 0
end

fn obyte b uchar to void
p = get st 2
if lt p 8192
put ob p b
put st 2 add p 1
end
end

fn otext t view uchar * to void
for i ulong len t
obyte get t i
end
end

fn onum v ulong to void
k = ulong 0
x = v
while true bound 21
put num k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
for i ulong k
obyte get num sub sub k 1 i
end
end

fn osnum v long to void
if lt v 0
obyte 45
onum ulong neg v
ret
end
onum ulong v
end

fn oflush to void
w = write 1 ob 0 get st 2
put st 2 0
end

fn lmax a long b long to long
if gt a b
ret a
end
ret b
end

fn lmin a long b long to long
if lt a b
ret a
end
ret b
end

fn slurp i ulong to long
n = argn i
if eq n 0
ret -1
end
if ge n 1023
ret -1
end
fd = int fopen arg 0 n 0 0
if lt fd 0
ret -1
end
tot = ulong 0
while true bound 999999
if ge tot len buf
c = fclose fd
ret -1
end
k = read fd buf tot sub len buf tot
if lt k 0
c2 = fclose fd
ret -1
end
if eq k 0
break
end
tot = add tot ulong k
end
c3 = fclose fd
ret long tot
end

fn pfield p ulong e ulong to long
i = p
s = long 1
if lt i e
if eq get buf i 45
s = long -1
i = add i 1
end
end
v = long 0
nd = ulong 0
while true bound 32
if ge i e
break
end
b = get buf i
if or lt b 48 gt b 57
break
end
if gt nd 17
put st 5 1
break
end
v = add mul v 10 long sub b 48
nd = add nd 1
i = add i 1
end
if eq nd 0
put st 5 1
end
put st 4 i
ret mul s v
end

note Parse buf[0, e) as rows of nc tab-separated integers into row and then the table selected by
note which (0 tasks, 1 runs, 2 events). Returns the row count, -1 malformed, -2 too many rows.
fn parse e ulong nc ulong which ulong to long
p = ulong 0
r = ulong 0
while true bound 999999
if ge p e
break
end
if ge r MAXN
ret -2
end
put st 5 0
for c ulong nc
v = pfield p e
put row c v
q = get st 4
if lt add c 1 nc
if ge q e
put st 5 1
else
if ne get buf q 9
put st 5 1
end
end
end
p = add q 1
end
if ne get st 5 0
ret -1
end
q2 = sub p 1
if lt q2 e
if ne get buf q2 10
ret -1
end
end
store which r
r = add r 1
end
ret long r
end

fn store which ulong r ulong to void
if eq which 0
put ti r get row 0
put tc r get row 1
put ts r get row 2
put tp r get row 3
put td r get row 4
end
if eq which 1
put ri r get row 0
put rs r get row 1
put re r get row 2
put ro r get row 3
end
if eq which 2
put ei r get row 0
put et r get row 1
put ek r get row 2
end
end

fn load i ulong nc ulong which ulong to long
sz = slurp i
if lt sz 0
ret -3
end
ret parse ulong sz nc which
end

note End of run i: its end, or TX when it has none.
fn rend i ulong tx long to long
e = get re i
if eq e 0
ret tx
end
ret e
end

fn sortwk n ulong to void
for i ulong n
j = i
while gt j 0 bound 4096
x = get wk j
y = get wk sub j 1
if ge x y
break
end
put wk j y
put wk sub j 1 x
j = sub j 1
end
end
end

note Open-task conservation. A task is closed when it has a completed or archived event.
fn sysline nt ulong nev ulong to void
for i ulong nt
put fl i 0
put cnt i 0
end
for j ulong nev
k = get ek j
x = ulong sub get ei j 1
if lt x nt
if eq k 1
put cnt x 1
end
if gt k 1
put fl x 1
end
end
end
cr = long 0
cl = long 0
ot = long 0
for i ulong nt
cr = add cr get cnt i
cl = add cl get fl i
s = get ts i
if ne s 6
if ne s 7
ot = add ot 1
end
end
end
oreset
otext t_sys
osnum cr
otext t_clo
osnum cl
otext t_oev
osnum sub cr cl
otext t_otb
osnum ot
otext t_mis
osnum sub sub cr cl ot
otext t_nl
oflush
end

fn runline nt ulong nr ulong to void
en = long 0
for i ulong nr
if gt get re i 0
en = add en 1
end
end
rt = long 0
for i ulong nt
if eq get ts i 3
rt = add rt 1
end
end
oreset
otext t_run
onum nr
otext t_ends
osnum en
otext t_rr
osnum sub long nr en
otext t_rt
osnum rt
otext t_mis
osnum sub sub long nr en rt
otext t_nl
oflush
end

note Concurrent runs at time t (runs with start <= t < end).
fn concat t long nr ulong tx long to long
c = long 0
for j ulong nr
if le get rs j t
if lt t rend j tx
c = add c 1
end
end
end
ret c
end

note Max concurrency (it is reached at a run start) and the seconds with more than cap runs:
note between consecutive sorted boundary times the count is constant.
fn concline nr ulong tx long cap long to void
mx = long 0
for i ulong nr
c = concat get rs i nr tx
if gt c mx
mx = c
end
end
m = ulong 0
for i ulong nr
put wk m get rs i
m = add m 1
put wk m rend i tx
m = add m 1
end
sortwk m
ov = long 0
for k ulong m
if gt k 0
a = get wk sub k 1
b = get wk k
if lt a b
if gt concat a nr tx cap
ov = add ov sub b a
end
end
end
end
oreset
otext t_conc
osnum mx
otext t_over
osnum ov
otext t_nl
oflush
end

fn rtyline nt ulong nr ulong to void
for i ulong nt
put cnt i 0
end
bad = long 0
for j ulong nr
x = ulong sub get ri j 1
if lt x nt
put cnt x add get cnt x 1
end
o = get ro j
if ge o 3
if le o 7
bad = add bad 1
end
end
end
ex = long 0
mu = long 0
for i ulong nt
c = get cnt i
if gt c 1
ex = add ex sub c 1
mu = add mu 1
end
end
oreset
otext t_rty
osnum ex
otext t_multi
osnum mu
otext t_badr
osnum bad
otext t_nl
oflush
end

fn accline nt ulong nr ulong to void
for i ulong nt
put fl i 0
end
for j ulong nr
if eq get ro j 1
x = ulong sub get ri j 1
if lt x nt
put fl x 1
end
end
end
dn = long 0
dc = long 0
for i ulong nt
if eq get ts i 6
dn = add dn 1
dc = add dc get fl i
end
end
oreset
otext t_acc
osnum dn
otext t_dcomp
osnum dc
otext t_nl
oflush
end

note Prints n, sum, nearest-rank p95 and max of wk[0, n) after a label.
fn statline t view uchar * n ulong s long to void
sortwk n
oreset
otext t
onum n
otext t_sum
osnum s
if gt n 0
rk = div add mul n 95 99 100
otext t_p95
osnum get wk sub rk 1
otext t_max
osnum get wk sub n 1
end
otext t_nl
oflush
end

note Created-to-completed latency of done tasks.
fn latline nt ulong to void
n = ulong 0
s = long 0
for i ulong nt
if eq get ts i 6
if gt get td i 0
w = sub get td i get tc i
put wk n w
s = add s w
n = add n 1
end
end
end
statline t_lat n s
end

note Created-to-first-run-start of tasks that have a run (includes dependency waits).
fn fstline nt ulong nr ulong to void
for i ulong nt
put wv i -1
end
for j ulong nr
x = ulong sub get ri j 1
if lt x nt
if eq get wv x -1
put wv x get rs j
end
end
end
n = ulong 0
s = long 0
for i ulong nt
if ge get wv i 0
w = sub get wv i get tc i
put wk n w
s = add s w
n = add n 1
end
end
statline t_fst n s
end

fn utilline nt ulong nr ulong tx long to void
b = long 0
for j ulong nr
b = add b sub rend j tx get rs j
end
mn = long 9223372036854775807
for i ulong nt
mn = lmin mn get tc i
end
oreset
otext t_util
osnum b
otext t_h
osnum sub tx mn
otext t_nl
oflush
end

note Pool p: busy seconds of its runs, the length of the union of their intervals (so busy minus
note union is the slot time in which a run shared its pool with another run) and the maximum
note number of its runs at one time.
fn poolof j ulong nt ulong to long
x = ulong sub get ri j 1
if lt x nt
ret get tp x
end
ret -1
end

fn poolmax p long nr ulong nt ulong tx long to long
mx = long 0
for i ulong nr
if eq poolof i nt p
t = get rs i
c = long 0
for j ulong nr
if eq poolof j nt p
if le get rs j t
if lt t rend j tx
c = add c 1
end
end
end
end
mx = lmax mx c
end
end
ret mx
end

fn poolline p long nr ulong nt ulong tx long to void
n = ulong 0
b = long 0
for j ulong nr
if eq poolof j nt p
put wk n get rs j
put wv n rend j tx
b = add b sub rend j tx get rs j
n = add n 1
end
end
psort n
u = long 0
cs = long 0
ce = long 0
for k ulong n
s = get wk k
e = get wv k
if eq k 0
cs = s
ce = e
else
if gt s ce
u = add u sub ce cs
cs = s
ce = e
else
ce = lmax ce e
end
end
end
if gt n 0
u = add u sub ce cs
end
oreset
otext t_pool
osnum p
otext t_runs
onum n
otext t_pbusy
osnum b
otext t_puni
osnum u
otext t_pmax
osnum poolmax p nr nt tx
otext t_nl
oflush
end

note Insertion sort of (wk, wv) pairs by wk.
fn psort n ulong to void
for i ulong n
j = i
while gt j 0 bound 4096
x = get wk j
y = get wk sub j 1
if ge x y
break
end
xv = get wv j
put wk j y
put wv j get wv sub j 1
put wk sub j 1 x
put wv sub j 1 xv
j = sub j 1
end
end
end

note Bounded retry R = 1: runs after the second run of a task are dropped.
fn armline nt ulong nr ulong to void
for i ulong nt
put cnt i 0
end
dr = long 0
dc = long 0
for j ulong nr
x = ulong sub get ri j 1
if lt x nt
put cnt x add get cnt x 1
if gt get cnt x 2
dr = add dr 1
if eq get ro j 1
dc = add dc 1
end
end
end
end
oreset
otext t_arm
osnum dr
otext t_dacc
osnum dc
otext t_nl
oflush
end

fn argnum i ulong to long
n = argn i
if eq n 0
ret -1
end
for k ulong n
put buf k get arg k
end
put st 5 0
v = pfield 0 n
if ne get st 5 0
ret -1
end
if ne get st 4 n
ret -1
end
ret v
end

fn main to int
if ne argcnt 6
pr t_usage
ret 2
end
tx = argnum 4
cap = argnum 5
if lt tx 0
pr t_usage
ret 2
end
if lt cap 1
pr t_usage
ret 2
end
a = load 1 5 0
b = load 2 4 1
c = load 3 3 2
if eq a -3
pr t_ioerr
ret 3
end
if eq b -3
pr t_ioerr
ret 3
end
if eq c -3
pr t_ioerr
ret 3
end
if eq a -2
pr t_big
ret 4
end
if eq b -2
pr t_big
ret 4
end
if eq c -2
pr t_big
ret 4
end
if lt a 0
pr t_bad
ret 3
end
if lt b 0
pr t_bad
ret 3
end
if lt c 0
pr t_bad
ret 3
end
nt = ulong a
nr = ulong b
nev = ulong c
oreset
otext t_tr
onum nt
otext t_runs
onum nr
otext t_evs
onum nev
otext t_tx
osnum tx
otext t_cap
osnum cap
otext t_nl
oflush
sysline nt nev
runline nt nr
concline nr tx cap
rtyline nt nr
accline nt nr
latline nt
fstline nt nr
utilline nt nr tx
for p ulong 5
poolline long p nr nt tx
end
armline nt nr
ret 0
end

note Agent maintenance structural validation only; not OMP semantic validation or authorization.
note Existing YAML is readable. New structured documents use JSON, a strict YAML subset.
text avrules "RULES.md"
text avwatch "WATCHDOG.yml"
text avconfig "config.yml"
text avname "name"
text avdesc "description"
text avmodel "model"
text aveff "thinking-level"
text avdeff "defaultThinkingLevel"
text avadvs "advisors"
text avtools "tools"
text avmin "minimal"
text avlow "low"
text avmed "medium"
text avhigh "high"
text avxhigh "xhigh"
text avmax "max"
text avauto "auto"

fn am_veq file view uchar 128 t view uchar * to bool
if ne get amreq 0 len t
ret false
end
for i ulong len t
if ne get file i get t i
ret false
end
end
ret true
end

fn am_vmem src view uchar 65536 tape view uint 16384 obj ulong key view uchar * to ulong
if ne js_type tape obj jsobj
ret jsnone
end
k = js_first tape obj
while ne k jsnone bound 4096
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end

fn am_vstr tape view uint 16384 t ulong to bool
if ne js_type tape t jsstr
ret false
end
ret gt js_slen tape t 0
end

fn am_veff src view uchar 65536 tape view uint 16384 t ulong to bool
if eq t jsnone
ret true
end
if not am_vstr tape t
ret false
end
p = js_off tape t
if js_streq src p avmin
ret true
end
if js_streq src p avlow
ret true
end
if js_streq src p avmed
ret true
end
if js_streq src p avhigh
ret true
end
if js_streq src p avxhigh
ret true
end
if js_streq src p avmax
ret true
end
ret js_streq src p avauto
end

note Reject duplicate decoded keys, including Unicode-escaped aliases. Bound object members at128.
fn am_vuniq src view uchar 65536 tape view uint 16384 obj ulong to bool
key = new uchar 128 0
if gt js_nkids tape obj 128
ret false
end
k = js_first tape obj
while ne k jsnone bound 128
n = js_sget src js_off tape k key
if le n 0
ret false
end
j = js_mnext tape k
while ne j jsnone bound 128
if js_streq src js_off tape j part key 0 ulong n
ret false
end
j = js_mnext tape j
end
k = js_mnext tape k
end
ret true
end

fn am_vparse src view uchar 65536 tape edit uint 16384 n ulong to int
r = js_init tape 65536 64
if lt r 0
ret 20
end
r = js_parse src tape n
if lt r 0
ret 20
end
if ne js_type tape 0 jsobj
ret 21
end
for t ulong ulong r
if eq js_type tape t jsobj
if not am_vuniq src tape t
ret 22
end
end
end
ret 0
end

fn am_vagent file view uchar 128 src view uchar 65536 tape view uint 16384 to int
key = new uchar 128 0
n = get amreq 0
if lt n 11
ret 30
end
t = am_vmem src tape 0 avname
if not am_vstr tape t
ret 31
end
z = js_sget src js_off tape t key
if lt z 0
ret 31
end
if ne ulong z sub n 10
ret 31
end
for i ulong ulong z
if ne get key i get file add i 7
ret 31
end
end
t = am_vmem src tape 0 avdesc
if not am_vstr tape t
ret 32
end
t = am_vmem src tape 0 avmodel
if ne t jsnone
if not am_vstr tape t
ret 33
end
end
t = am_vmem src tape 0 aveff
if not am_veff src tape t
ret 34
end
ret 0
end

fn am_vadvisor src view uchar 65536 tape view uint 16384 obj ulong to int
if ne js_type tape obj jsobj
ret 41
end
t = am_vmem src tape obj avname
if not am_vstr tape t
ret 42
end
t = am_vmem src tape obj avmodel
if ne t jsnone
if not am_vstr tape t
ret 43
end
end
t = am_vmem src tape obj avtools
if ne t jsnone
if ne js_type tape t jsarr
ret 44
end
e = js_first tape t
while ne e jsnone bound 4096
if not am_vstr tape e
ret 44
end
e = js_enext tape e
end
end
ret 0
end

fn am_vwatch src view uchar 65536 tape view uint 16384 to int
key = new uchar 128 0
t = am_vmem src tape 0 avadvs
if ne js_type tape t jsarr
ret 40
end
if gt js_nkids tape t 64
ret 40
end
e = js_first tape t
while ne e jsnone bound 64
r = am_vadvisor src tape e
if ne r 0
ret r
end
k = am_vmem src tape e avname
n = js_sget src js_off tape k key
if le n 0
ret 42
end
j = js_enext tape e
while ne j jsnone bound 64
k = am_vmem src tape j avname
if ne k jsnone
if js_streq src js_off tape k part key 0 ulong n
ret 45
end
end
j = js_enext tape j
end
e = js_enext tape e
end
ret 0
end

note Structural refusal codes:10 empty/oversize;11 controls;12 UTF8;20 JSON;21 root;22 duplicate/long key;
note 30 frontmatter;31 name;32 description;33 model;34 effort;40..45 advisor structure.
fn am_validate file view uchar 128 body view uchar 65536 to int
enc = new uchar 133120 0
src = new uchar 65536 0
tape = new uint 16384 0
n = get amreq 1
if or eq n 0 gt n 65536
ret 10
end
for i ulong n
c = get body i
if lt c 32
if and ne c 9 and ne c 10 ne c 13
ret 11
end
end
if eq c 127
ret 11
end
end
r = js_winit enc
js_wsbuf enc body 0 n
r = js_wdone enc
if lt r 0
ret 12
end
if am_veq file avrules
ret 0
end
if or am_veq file avconfig am_veq file avwatch
for i ulong n
put src i get body i
end
v = am_vparse src tape n
if ne v 0
ret v
end
if am_veq file avwatch
ret am_vwatch src tape
end
t = am_vmem src tape 0 avdeff
if not am_veff src tape t
ret 34
end
ret 0
end
if lt n 10
ret 30
end
if ne get body 0 45
ret 30
end
if ne get body 1 45
ret 30
end
if ne get body 2 45
ret 30
end
if ne get body 3 10
ret 30
end
stop = ulong 0
i = ulong 4
while le add i 5 n bound 65536
if eq get body i 10
if eq get body add i 1 45
if eq get body add i 2 45
if eq get body add i 3 45
if eq get body add i 4 10
stop = i
break
end
end
end
end
end
i = add i 1
end
if eq stop 0
ret 30
end
if ge add stop 5 n
ret 30
end
for j ulong sub stop 4
put src j get body add j 4
end
v = am_vparse src tape sub stop 4
if ne v 0
ret v
end
ret am_vagent file src tape
end

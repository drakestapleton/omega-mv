note Agent-maintenance shared state. Composed after pinned JSON/SHA units in OM-2 program mode.
note Only amerror is consumed by the transport. All proposal material is connection-local memory.
global amerror uint 1
global amreq ulong 3
global amwhy int 1
global amv ulong 16
global amfd int 5
global amroot uchar 4096
global amfile uchar 128
global ambef uchar 65536
global amaft uchar 65536
global ampre uchar 64
global ampost uchar 64
global amhash uchar 64
global amtok uchar 64
global amstage uchar 128
global ammeta ulong 11
global ampmeta ulong 11
global amnext ulong 11

const amrootn ulong 0
const amwrite ulong 1
const amprot ulong 2
const amstate ulong 3
const amfilen ulong 4
const ambefn ulong 5
const amaftn ulong 6
const amcurn ulong 7
const amstgn ulong 8
const amrenam ulong 9
const amlocko ulong 10
const amstageo ulong 11
const amvalc ulong 12
const aminvc ulong 13
const amderr ulong 14
const ammax ulong 65536
note fd slots: root=0, target parent=1 (may alias root), current=2, stage=3, lock=4.
note Proposal states: 0 absent/invalidated, 1 proposed, 2 applied, 3 rolled back.
note ARM64 flags sourced from asm/fcntl.h, asm-generic/fcntl.h and pinned host fixtures.
note WolframLanguageEvaluator: FromDigits[#,8]& /@ {040000,0100000,02000000,00004000,00000100,00000200}
note using string inputs returned {16384,32768,524288,2048,64,128}.
note BitOr directory/nofollow/cloexec ->573440; read/nofollow/cloexec/nonblock ->559104;
note rdwr/create/excl/nofollow/cloexec ->557250. No O_TRUNC is ever used.
const amodir int 573440
const amord int 559104
const amonew int 557250
const amolock int 557249
const amreg ulong 32768
const amtyp ulong 61440
const amxbit ulong 73
note WolframLanguageEvaluator: FromDigits[#,8]& /@ {"600","7777"} -> {384,4095}.
const ampriv int 384
const ampmode ulong 4095

text amslash "/"
text amargro "--root"
text amargwr "--allow-write"
text amkeep "/srv/aien-keep"
text amrules "RULES.md"
text amwatch "WATCHDOG.yml"
text amconfig "config.yml"
text amagents "agents"
text amagentp "agents/"
text ammd ".md"
text amlock ".agent-maintenance.lock"
text amstpre ".agent-maintenance-"
text amstend ".tmp"
text amhex "0123456789abcdef"
text amlim "Structural syntax checks only; no claim about advisor/model availability, prompt semantics, OMP acceptance or active runtime. Saved files are not reloaded. Proposals and rollback state exist only in this connection; preserve before_content for durable operator-controlled recovery. Cooperative lock does not serialize unrelated writers. Protected /srv/aien-keep stores are never writable here."

text amkok "ok"
text amkerr "error"
text amkfile "file"
text amkroot "root"
text amkmode "mode"
text amkprot "protected_store"
text amkfiles "files"
text amkstat "status"
text amksha "sha256"
text amksize "size"
text amkbody "content"
text amkprop "proposal_id"
text amkbef "before_content"
text amkaft "after_content"
text amkpre "before_sha256"
text amkpost "after_sha256"
text amkchng "changed"
text amkallow "apply_allowed"
text amklimit "limitations"
text amkvalid "validation_code"
text amkstate "state"
text amkreld "runtime_reloaded"
text amkpers "rollback_persistent"
text amkdur "durability_confirmed"
text amkadir "agents_directory"
text amrdonly "read-only"
text amwrmode "write-enabled"
text ammiss "missing"
text amexists "existing"
text amrefuse "refused"
text amappl "applied"
text amrolled "rolled_back"
text amvalid "valid"
text amkcomm "committed"
text amerrs "invalid_file_id|missing_file|open_refused|metadata_unavailable|not_regular_file|hardlinked_file_refused|executable_file_refused|file_too_large|read_failed|invalid_utf8_or_nul|changed_while_reading|read_only_mode|protected_store_write_refused|structural_validation_refused|stale_expected_sha256|random_unavailable|no_outstanding_proposal|wrong_proposal_id|proposal_state_refused|non_owner_refused|lock_unavailable|stage_create_failed|write_failed|file_sync_failed|rename_failed|owned_cleanup_failed|committed_durability_uncertain|root_unavailable|permission_preservation_refused|metadata_changed|inventory_limit|root_directory_refused|writer_capacity_refused|"
note Read-only, fixed kernel identity metadata; this is not a caller-selectable maintenance path.
text amproc "/proc/self/status"
text amcinh "CapInh:"
text amcprm "CapPrm:"
text amceff "CapEff:"
text amcamb "CapAmb:"

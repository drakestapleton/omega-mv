note Maintenance MCP transport; storage is deliberately independent of compiler sandbox/server units.
note arrpc: id, params, op, file token, body token, token token, frame length, oversize.
global arrpc ulong 8
text arj "jsonrpc"
text arid "id"
text arm "method"
text arp "params"
text arn "name"
text ara "arguments"
text arf "file"
text arc "content"
text arh "expected_sha256"
text art "proposal_id"
text arres "result"
text arerr "error"
text arcode "code"
text armsg "message"
text arver "2.0"
text arinit "initialize"
text arping "ping"
text arlist "tools/list"
text arcall "tools/call"
text arpv "protocolVersion"
text arpv1 "2025-06-18"
text arpv2 "2025-03-26"
text arpv3 "2024-11-05"
text artools "tools"
text arsc "structuredContent"
text artext "text"
text artype "type"
text ariserr "isError"
text arnl "\n"
text areparse "Malformed or oversized JSON frame"
text areinv "Invalid JSON-RPC request: object, jsonrpc 2.0, string method and string/integer id required"
text arepar "Invalid params: strict named arguments required; document content limit is 65536 UTF-8 bytes"
text aremeth "Method not found"
text arcap "capabilities"
text arlc "listChanged"
text arsi "serverInfo"
text arversio "version"
text arserver "omega-agent-maintenance"
text arvers "0.1.0"
text arinst "instructions"
text arhelp "Host-only saved-file maintenance, not active OMP runtime reload. Default read-only. Protected /srv/aien-keep store is always read-only. Validation checks syntax/structure only, not models, credentials, policy effectiveness or runtime compatibility. Proposals and rollback tokens are connection-scoped; retain the exact before-content preview for durable recovery."
text ardesc "description"
text arschema "inputSchema"
text arprops "properties"
text arreq "required"
text aradd "additionalProperties"
text arobj "object"
text arstr "string"
text armax "maxLength"
text armin "minLength"
text arpatter "pattern"
text arhashpa "^[0-9a-f]{64}$"
text arinv "inventory"
text arread "read_file"
text arval "validate"
text arprop "propose"
text arapply "apply"
text arroll "rollback"
text ard0 "Inventory supported saved agent files and per-file status, canonical root and read-only/writable mode. Does not report active runtime state."
text ard1 "Read exact saved UTF-8 file bytes, byte size and SHA-256. Logical IDs only: RULES.md, WATCHDOG.yml, config.yml, agents/<safe-slug>.md."
text ard2 "Validate syntax/structure only: JSON object for config/WATCHDOG, JSON-object markdown frontmatter for agent definitions; no semantic/runtime guarantee. Legacy YAML remains readable but is not validated here."
text ard3 "Prepare one immutable connection-scoped proposal against an exact SHA-256, with full before/after preview and apply_allowed. No file write. Replaces the previous proposal; maximum document payload 65536 bytes."
text ard4 "Apply the exact connection-scoped proposal once, requiring --allow-write and unchanged before hash. Protected store always refuses. Atomic saved-file update, not runtime reload."
text ard5 "Restore the before bytes of the applied connection-scoped proposal once, only if current bytes still match after hash. Requires --allow-write; protected store refuses. Token/recovery state does not persist across disconnect."
text arsummar "See structuredContent for the exact result, full document preview, and connection-scoped recovery details."
text areinter "Internal error: storage result is not a complete JSON object"

fn arwt ob edit uchar 787472 s view uchar * to void
js_wsbuf ob s 0 len s
end
fn arpair ob edit uchar 787472 key view uchar * value view uchar * to void
arwt ob key
arwt ob value
end
fn armem src view uchar 524288 tape view uint 65536 obj ulong key view uchar * to ulong
if ne js_type tape obj jsobj
ret jsnone
end
k = js_first tape obj
while ne k jsnone bound 999999
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end
fn arfull src view uchar * off ulong n ulong to bool
p = ulong 0
while lt p n bound 999999
r = write 1 src add off p sub n p
if eq r -4
continue
end
if le r 0
ret false
end
p = add p ulong r
end
ret true
end
fn arbegin src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
z = js_winit ob
js_wobj ob
arpair ob arj arver
arwt ob arid
t = get arrpc 0
if eq t jsnone
js_wnull ob
else
js_wtok ob src js_type tape t js_off tape t
end
end
fn arsend ob edit uchar 787472 to void
js_wobje ob
n = js_wdone ob
if lt n 0
exit 5
end
ok = arfull ob 1040 ulong n
if not ok
exit 6
end
ok = arfull arnl 0 1
if not ok
exit 6
end
end
fn arerror src view uchar 524288 tape view uint 65536 ob edit uchar 787472 code long msg view uchar * to void
arbegin src tape ob
arwt ob arerr
js_wobj ob
arwt ob arcode
js_wlong ob code
arpair ob armsg msg
js_wobje ob
arsend ob
end
fn arname ob edit uchar 787472 op ulong to void
if eq op 0
arwt ob arinv
end
if eq op 1
arwt ob arread
end
if eq op 2
arwt ob arval
end
if eq op 3
arwt ob arprop
end
if eq op 4
arwt ob arapply
end
if eq op 5
arwt ob arroll
end
end
fn ardescription ob edit uchar 787472 op ulong to void
if eq op 0
arwt ob ard0
end
if eq op 1
arwt ob ard1
end
if eq op 2
arwt ob ard2
end
if eq op 3
arwt ob ard3
end
if eq op 4
arwt ob ard4
end
if eq op 5
arwt ob ard5
end
end
fn arfield ob edit uchar 787472 key view uchar * cap ulong to void
arwt ob key
js_wobj ob
arpair ob artype arstr
arwt ob armax
js_wulong ob cap
if ne cap 65536
arwt ob armin
js_wulong ob 1
end
if eq cap 64
arpair ob arpatter arhashpa
end
js_wobje ob
end
fn arschemawrite ob edit uchar 787472 op ulong to void
js_wobj ob
arwt ob arn
arname ob op
arwt ob ardesc
ardescription ob op
arwt ob arschema
js_wobj ob
arpair ob artype arobj
arwt ob aradd
js_wbool ob false
arwt ob arprops
js_wobj ob
if and ge op 1 le op 3
arfield ob arf 127
end
if or eq op 2 eq op 3
arfield ob arc 65536
end
if eq op 3
arfield ob arh 64
end
if ge op 4
arfield ob art 128
end
js_wobje ob
arwt ob arreq
js_warr ob
if and ge op 1 le op 3
arwt ob arf
end
if or eq op 2 eq op 3
arwt ob arc
end
if eq op 3
arwt ob arh
end
if ge op 4
arwt ob art
end
js_warre ob
js_wobje ob
js_wobje ob
end
fn arinitialize src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
p = get arrpc 1
v = armem src tape p arpv
if ne js_type tape v jsstr
arerror src tape ob -32602 arepar
ret
end
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob arpv
if js_streq src js_off tape v arpv2
arwt ob arpv2
else
if js_streq src js_off tape v arpv3
arwt ob arpv3
else
arwt ob arpv1
end
end
arwt ob arcap
js_wobj ob
arwt ob artools
js_wobj ob
arwt ob arlc
js_wbool ob false
js_wobje ob
js_wobje ob
arwt ob arsi
js_wobj ob
arpair ob arn arserver
arpair ob arversio arvers
js_wobje ob
arpair ob arinst arhelp
js_wobje ob
arsend ob
end
fn artoolop src view uchar 524288 off ulong to ulong
if js_streq src off arinv
ret 0
end
if js_streq src off arread
ret 1
end
if js_streq src off arval
ret 2
end
if js_streq src off arprop
ret 3
end
if js_streq src off arapply
ret 4
end
if js_streq src off arroll
ret 5
end
ret jsnone
end
note Exact field count plus required unique known fields refuses extras and duplicate keys.
fn arargs src view uchar 524288 tape view uint 65536 a ulong op ulong to bool
if ne js_type tape a jsobj
ret false
end
want = ulong 0
if eq op 1
want = 1
end
if eq op 2
want = 2
end
if eq op 3
want = 3
end
if ge op 4
want = 1
end
if ne js_nkids tape a want
ret false
end
f = armem src tape a arf
b = armem src tape a arc
t = jsnone
if eq op 3
t = armem src tape a arh
end
if ge op 4
t = armem src tape a art
end
if and ge op 1 le op 3
if ne js_type tape f jsstr
ret false
end
if or eq js_slen tape f 0 gt js_slen tape f 127
ret false
end
end
if or eq op 2 eq op 3
if ne js_type tape b jsstr
ret false
end
if gt js_slen tape b 65536
ret false
end
end
if ge op 3
if ne js_type tape t jsstr
ret false
end
if or eq js_slen tape t 0 gt js_slen tape t 128
ret false
end
end
put arrpc 3 f
put arrpc 4 b
put arrpc 5 t
ret true
end
fn ardcopy ob edit uchar 787472 domain view uchar 787472 dt view uint 65536 n ulong to void
for t ulong ulong get dt jshnt
ty = js_type dt t
off = js_off dt t
js_wtok ob part domain 1040 n ty off
end
end

note Storage owns a separate complete-object writer and may reset it on refusal.
note Parse only after am_call returns; encoding failures must never rerun a mutation.
fn ardomain src view uchar 524288 tape view uint 65536 ob edit uchar 787472 domain edit uchar 787472 dt edit uint 65536 to void
n = js_wdone domain
if le n 0
arerror src tape ob -32603 areinter
ret
end
z = js_init dt 786432 64
if lt z 0
arerror src tape ob -32603 areinter
ret
end
r = js_parse part domain 1040 ulong n dt ulong n
if lt r 0
arerror src tape ob -32603 areinter
ret
end
if ne js_type dt 0 jsobj
arerror src tape ob -32603 areinter
ret
end
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob arsc
ardcopy ob domain dt ulong n
arwt ob arc
js_warr ob
js_wobj ob
arpair ob artype artext
arpair ob artext arsummar
js_wobje ob
js_warre ob
arwt ob ariserr
js_wbool ob ne get amerror 0 0
js_wobje ob
arsend ob
end
fn arinvoke src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
file = new uchar 128 0
body = new uchar 65536 0
token = new uchar 128 0
domain = new uchar 787472 0
dt = new uint 65536 0
nf = long 0
nb = long 0
nt = long 0
if ne get arrpc 3 jsnone
nf = js_sget src js_off tape get arrpc 3 file
end
if ne get arrpc 4 jsnone
nb = js_sget src js_off tape get arrpc 4 body
end
if ne get arrpc 5 jsnone
nt = js_sget src js_off tape get arrpc 5 token
end
if or lt nf 0 or lt nb 0 lt nt 0
arerror src tape ob -32602 arepar
ret
end
put amreq 0 ulong nf
put amreq 1 ulong nb
put amreq 2 ulong nt
z = js_winit domain
if lt z 0
arerror src tape ob -32603 areinter
ret
end
am_call get arrpc 2 file body token domain
ardomain src tape ob domain dt
end
fn artoolcall src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
p = get arrpc 1
if ne js_nkids tape p 2
arerror src tape ob -32602 arepar
ret
end
n = armem src tape p arn
a = armem src tape p ara
if ne js_type tape n jsstr
arerror src tape ob -32602 arepar
ret
end
op = artoolop src js_off tape n
if eq op jsnone
arerror src tape ob -32602 arepar
ret
end
if not arargs src tape a op
arerror src tape ob -32602 arepar
ret
end
put arrpc 2 op
arinvoke src tape ob
end
fn arhandle src view uchar 524288 tape edit uint 65536 ob edit uchar 787472 n ulong to void
put arrpc 0 jsnone
r = js_parse src tape n
if lt r 0
arerror src tape ob -32700 areparse
ret
end
v = armem src tape 0 arj
m = armem src tape 0 arm
id = armem src tape 0 arid
valid = eq js_type tape 0 jsobj
if ne js_type tape v jsstr
valid = false
else
if not js_streq src js_off tape v arver
valid = false
end
end
if ne js_type tape m jsstr
valid = false
end
if ne id jsnone
ty = js_type tape id
if eq ty jsstr
put arrpc 0 id
else
if eq ty jsnum
if ne js_ilex src js_off tape id 0
put arrpc 0 id
else
valid = false
end
else
valid = false
end
end
end
note Duplicate envelope fields are ambiguous and cannot execute.
if valid
k = js_first tape 0
seen = ulong 0
while ne k jsnone bound 999999
bit = ulong 0
if js_streq src js_off tape k arj
bit = 1
end
if js_streq src js_off tape k arm
bit = 2
end
if js_streq src js_off tape k arid
bit = 4
end
if js_streq src js_off tape k arp
bit = 8
end
if ne and seen bit 0
valid = false
end
seen = or seen bit
k = js_mnext tape k
end
end
if not valid
arerror src tape ob -32600 areinv
ret
end
note Valid notifications have neither response nor storage effects.
if eq id jsnone
ret
end
p = armem src tape 0 arp
put arrpc 1 p
if ne p jsnone
if ne js_type tape p jsobj
arerror src tape ob -32602 arepar
ret
end
end
if js_streq src js_off tape m arinit
arinitialize src tape ob
ret
end
if js_streq src js_off tape m arcall
artoolcall src tape ob
ret
end
if js_streq src js_off tape m arping
arbegin src tape ob
arwt ob arres
js_wobj ob
js_wobje ob
arsend ob
ret
end
if js_streq src js_off tape m arlist
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob artools
js_warr ob
for op ulong 6
arschemawrite ob op
end
js_warre ob
js_wobje ob
arsend ob
ret
end
arerror src tape ob -32601 aremeth
end
fn arframe src view uchar 524288 tape edit uint 65536 ob edit uchar 787472 to void
if ne get arrpc 7 0
put arrpc 0 jsnone
arerror src tape ob -32700 areparse
else
arhandle src tape ob get arrpc 6
end
put arrpc 6 0
put arrpc 7 0
end
fn arfeed src edit uchar 524288 tape edit uint 65536 ob edit uchar 787472 chunk view uchar 4096 n ulong to void
for i ulong n
c = get chunk i
if eq c 10
arframe src tape ob
else
if eq get arrpc 7 0
p = get arrpc 6
if ge p len src
put arrpc 7 1
else
put src p c
put arrpc 6 add p 1
end
end
end
end
end
fn main to int
src = new uchar 524288 0
tape = new uint 65536 0
ob = new uchar 787472 0
chunk = new uchar 4096 0
b = am_boot
if ne b 0
ret b
end
z = js_init tape 524288 64
if lt z 0
ret 4
end
note Each read consumes bytes or EOF; nested bounded epochs permit a long-lived stdio connection.
for epoch ulong 999999
for tick ulong 999999
r = read 0 chunk 0 len chunk
if eq r -4
continue
end
if lt r 0
ret 7
end
if eq r 0
if or ne get arrpc 6 0 ne get arrpc 7 0
arframe src tape ob
end
ret 0
end
arfeed src tape ob chunk ulong r
end
end
ret 0
end

om2
note pincheck: the pin is written in one place, PIN. build.sh compiles this unit with the pinned omc and runs
note it in the repository root as `git ls-files | build/pincheck`; a finding fails the build.
note It reads PIN (exactly `omega-mv <40 hex>` and `omc-sha256 <64 hex>`, one per line) and a list of tracked
note paths on stdin, one per line, and reports every hash-like word in those files: a run of 7 or more of
note 0-9 a-f holding a digit and a letter, between characters other than 0-9 A-Z a-z _. A word that is a
note prefix of the PIN revision or omc sha256 restates the pin; any other is a hash nothing derives from PIN.
note Not read: PIN; records (evidence/, .crumb, server.json, the v0.1.0 registry record); gates/fixtures/,
note data the gates compare against (the older compiler the pin case must refuse); data/, which
note tools/gen-reference.py writes from PIN and tools/check-reference.py checks against it; README.zh-CN.md
note (translated copies are retired and not maintained). The hex alphabet `0123456789abcdef` is not a hash.
note Exit 0 no findings, 1 findings, 2 PIN malformed or a listed file unreadable.

global pin uchar 128
global ib uchar 65536
global buf uchar 65536
global tok uchar 64
global pth uchar 4096
global ob uchar 32
global st ulong 16

note st cells: word length, hex only, has digit, has letter, line, findings, path length,
note files read, unreadable or overlong paths
const q_len ulong 0
const q_hex ulong 1
const q_dig ulong 2
const q_let ulong 3
const q_line ulong 4
const q_bad ulong 5
const q_pl ulong 6
const q_nf ulong 7
const q_err ulong 8

text kpinf "PIN"
text khex "0123456789abcdef"
text kmvw "omega-mv "
text kshaw "omc-sha256 "
text m_pin "pincheck: PIN must be exactly two lines, `omega-mv <40 hex>` and `omc-sha256 <64 hex>`\n"
text m_open "pincheck: cannot read "
text m_long "pincheck: path longer than 4095 bytes\n"
text m_rest ": restates PIN: "
text m_hash ": names a hash that nothing derives from PIN: "
text m_hint "pincheck: the pin is written only in PIN; point at PIN (or derive the value from it) instead\n"
text m_sum "pincheck: files "
text m_fnd " findings "
text nl "\n"
text colon ":"
text x_pin "PIN"
text x_ev "evidence/"
text x_data "data/"
text x_crumb ".crumb"
text x_zh "README.zh-CN.md"
text x_fix "gates/fixtures/"
text x_srv "server.json"

note wt: all of t on stdout; a failed write exits 2
fn wt t view uchar * to void
n = len t
p = ulong 0
while lt p n
k = write 1 t p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

note wpth: the current path on stdout
fn wpth to void
n = get st q_pl
p = ulong 0
while lt p n
k = write 1 pth p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

note wtok: the current word on stdout (its first 64 bytes)
fn wtok to void
n = get st q_len
if gt n 64
n = ulong 64
end
p = ulong 0
while lt p n
k = write 1 tok p sub n p
if le k 0
exit 2
end
p = add p ulong k
end
end

note putn: v in decimal on stdout; a ulong has at most 20 digits
fn putn v ulong to void
i = ulong 32
n = v
while true bound 20
i = sub i 1
put ob i uchar add rem n 10 48
n = div n 10
if eq n 0
break
end
end
p = i
while lt p 32
k = write 1 ob p sub 32 p
if le k 0
exit 2
end
p = add p ulong k
end
end

fn ishex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end

fn isw c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

note ldpin: PIN into pin; true when it has exactly the two lines
fn ldpin to bool
f = fopen kpinf 0 len kpinf 0 0
if lt f 0
ret false
end
n = read int f pin 0 128
z = fclose int f
if ne n 126
ret false
end
for i ulong 9
if ne get pin i get kmvw i
ret false
end
end
for i ulong 11
if ne get pin add 50 i get kshaw i
ret false
end
end
if or ne get pin 49 10 ne get pin 125 10
ret false
end
for i ulong 40
if not ishex get pin add 9 i
ret false
end
end
for i ulong 64
if not ishex get pin add 61 i
ret false
end
end
ret true
end

note pre: the current path starts with t; eqp: it is t
fn pre t view uchar * to bool
n = len t
if lt get st q_pl n
ret false
end
for i ulong n
if ne get pth i get t i
ret false
end
end
ret true
end

fn eqp t view uchar * to bool
if ne get st q_pl len t
ret false
end
ret pre t
end

note tokat: the current word (n <= 64 bytes) equals pin[o .. o+n)
fn tokat o ulong n ulong to bool
for i ulong n
if ne get tok i get pin add o i
ret false
end
end
ret true
end

fn ishexab to bool
if ne get st q_len 16
ret false
end
for i ulong 16
if ne get tok i get khex i
ret false
end
end
ret true
end

fn rset to void
put st q_len 0
put st q_hex 1
put st q_dig 0
put st q_let 0
end

note judge: report the word that just ended, if it is hash-like
fn judge to void
n = get st q_len
if lt n 7
ret
end
if or eq get st q_hex 0 or eq get st q_dig 0 eq get st q_let 0
ret
end
if ishexab
ret
end
r = false
if le n 40
r = tokat 9 n
end
if and not r le n 64
r = tokat 61 n
end
wpth
wt colon
putn get st q_line
if r
wt m_rest
else
wt m_hash
end
wtok
wt nl
put st q_bad add get st q_bad 1
end

fn eat c uchar to void
if isw c
n = get st q_len
if lt n 64
put tok n c
end
put st q_len add n 1
if not ishex c
put st q_hex 0
end
if and ge c 48 le c 57
put st q_dig 1
end
if and ge c 97 le c 102
put st q_let 1
end
ret
end
judge
rset
if eq c 10
put st q_line add get st q_line 1
end
end

note scan: every word of the open file f; false when a read fails
fn scan f int to bool
rset
put st q_line 1
while true
k = read f buf 0 65536
if lt k 0
ret false
end
if eq k 0
break
end
m = ulong k
for i ulong m
eat get buf i
end
end
judge
ret true
end

fn skip to bool
if eqp x_pin
ret true
end
if pre x_ev
ret true
end
if pre x_data
ret true
end
if eqp x_crumb
ret true
end
if pre x_fix
ret true
end
if eqp x_srv
ret true
end
ret eqp x_zh
end

note dopath: check the path in pth, then forget it
fn dopath to void
n = get st q_pl
if eq n 0
ret
end
if gt n 4095
wt m_long
put st q_err 1
put st q_pl 0
ret
end
if skip
put st q_pl 0
ret
end
f = fopen pth 0 n 0 0
ok = false
if ge f 0
ok = scan int f
z = fclose int f
end
if not ok
wt m_open
wpth
wt nl
put st q_err 1
end
put st q_nf add get st q_nf 1
put st q_pl 0
end

fn main to int
if not ldpin
wt m_pin
ret 2
end
put st q_bad 0
put st q_nf 0
put st q_pl 0
put st q_err 0
while true
k = read 0 ib 0 65536
if lt k 0
exit 2
end
if eq k 0
break
end
m = ulong k
for i ulong m
c = get ib i
if eq c 10
dopath
else
n = get st q_pl
if lt n 4096
put pth n c
end
put st q_pl add n 1
end
end
end
dopath
wt m_sum
putn get st q_nf
wt m_fnd
putn get st q_bad
wt nl
if ne get st q_err 0
ret 2
end
if ne get st q_bad 0
wt m_hint
ret 1
end
ret 0
end

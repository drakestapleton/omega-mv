note a run-time pool (omc only): global NAME T * has length 0 at start and r = enlarge NAME n grows it (r is 0,
note or -22 / the host's negative errno when refused, NAME unchanged); get, put and len see the current length
global P ulong *
fn main to int
if ne len P 0
ret 1
end
r = enlarge P ulong 3
if ne r 0
ret 2
end
put P 2 39
r = enlarge P ulong 2
put P 0 len P
ret int add get P 0 get P 2
end

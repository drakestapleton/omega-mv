note CPU affinity, the current CPU and the thread's scheduling priority (nice 19 is always allowed)
global mask uchar 128
fn ck yes bool to void
if not yes
exit 80
end
end
fn main to int
n = cpuget 0 mask 0 128
ck gt n 0
ck eq cpuset 0 mask 0 ulong n 0
ck ge cpunow 0
ck eq setprio 0 0 19 0
ck eq getprio 0 0 1
ret 0
end

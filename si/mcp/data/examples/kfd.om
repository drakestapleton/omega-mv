note KFD device words without a device: a reservation is real, and a call on fd -1 returns -9 (EBADF)
global ver uchar 8
fn ck yes bool to void
if not yes
exit 80
end
end
fn main to int
r = kfdres 2097152
ck gt r 0
ck eq rem mapaddr r 2097152 0
ck eq mapdrop r 0
ck eq kfdctl neg int 1 uint 2148027137 ver 0 8 neg long 9
ret 0
end

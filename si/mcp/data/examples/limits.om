note prlimit reads and sets the open-file limit (res 7); a failed execenv (no such file) returns -2
global lim uchar 32
fn ck yes bool to void
if not yes
exit 80
end
end
fn main to int
ck eq prlimit 0 7 lim 0 16 0
ck eq prlimit 0 7 lim 0 8 neg long 22
ck eq prlimit 0 7 lim 0 32 0
for i ulong 16
ck eq get lim i get lim add i 16
end
x = new uchar 6 0
put x 0 1
put x 2 2
put x 4 47
put x 5 120
e = new uchar 7 0
put e 0 1
put e 2 3
put e 4 97
put e 5 61
put e 6 98
ck eq execenv x 0 6 e 0 7 neg long 2
ret 0
end

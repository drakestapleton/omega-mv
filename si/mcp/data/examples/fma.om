note fma rounds once: (1+2^-52)*(1-2^-52)-1 is -2^-104, while mul then add rounds twice and gives 0
fn main to int
a = bitcast f64 ulong 4607182418800017409
b = bitcast f64 ulong 4607182418800017406
m = neg 1.0f64
f = fma a b m
s = add mul a b m
if ne s 0.0f64
ret 1
end
if ge f 0.0f64
ret 2
end
ret int fma 2.0f64 3.0f64 1.0f64
end

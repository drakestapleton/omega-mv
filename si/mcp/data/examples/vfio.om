note VFIO words with fd -1, so no device is opened: the ioctl and both region mappings return -9 (EBADF);
note an eventfd holds a counter that read returns as eight little-endian bytes
global buf uchar 8
global ri uchar 32
fn ck yes bool to void
if not yes
exit 80
end
end
fn main to int
ck eq vfioctl neg int 1 uint 15204 buf 0 0 neg long 9
put ri 4 5
put ri 16 16
ck eq vfiomap neg int 1 ri 0 32 neg long 9
put ri 4 7
ck eq vfiomapw neg int 1 ri 0 32 neg long 9
e = int eventfd uint 3
ck ge e 0
ck eq read e buf 0 8 8
ck eq get buf 0 3
ck eq fclose e 0
ret 0
end

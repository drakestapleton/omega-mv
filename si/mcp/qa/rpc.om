note Agent Q&A MCP transport: newline-delimited JSON-RPC 2.0 on stdio, framing copied from maintenance/rpc.om.
global arrpc ulong 8
text arj "jsonrpc"
text arid "id"
text arm "method"
text arp "params"
text arn "name"
text ara "arguments"
text arres "result"
text arerr "error"
text arcode "code"
text armsg "message"
text arver "2.0"
text arinit "initialize"
text arping "ping"
text arlist "tools/list"
text arcall "tools/call"
text arpv "protocolVersion"
text arpv1 "2025-06-18"
text arpv2 "2025-03-26"
text arpv3 "2024-11-05"
text artools "tools"
text arsc "structuredContent"
text arc "content"
text artext "text"
text artype "type"
text ariserr "isError"
text arnl "\n"
text areparse "Malformed or oversized JSON frame"
text areinv "Invalid JSON-RPC request: object, jsonrpc 2.0, string method and string/integer id required"
text arepar "Invalid params: the tool's named string arguments, each present once, within its maxLength"
text aremeth "Method not found"
text arcap "capabilities"
text arlc "listChanged"
text arsi "serverInfo"
text arversio "version"
text arserver "omega-agent-qa"
text arvers "0.1.0"
text arinst "instructions"
text arhelp "Shared questions and answers for coding agents. Before you spend long on an error, call search with a few words from it. Read answers with read and run their evidence yourself before relying on them: an answer is a claim until it reproduces. When you solve something others may hit, and consent_status says may_contribute, ask, answer or check (works or fails, with evidence). If may_contribute is false, tell the person once, plainly, that sharing is off and quote how_to_enable; never edit the consent file yourself. Share only what the entry needs: no chat, private code, file contents, keys or home paths."
text ardesc "description"
text arschema "inputSchema"
text arprops "properties"
text arreq "required"
text aradd "additionalProperties"
text arobj "object"
text arstr "string"
text armax "maxLength"
text arpatter "pattern"
text arhashpa "^[0-9a-f]{64}$"
text arrespa "^(works|fails)$"
text arsummar "See structuredContent for the exact result."
text ar0 "search"
text ar1 "read"
text ar2 "consent_status"
text ar3 "ask"
text ar4 "answer"
text ar5 "check"
text ard0 "Find shared entries whose text holds every space-separated word of words (ASCII case-insensitive; empty lists all). Returns id, kind, title and ref of up to 50, the total matches, more when there are further matches (add words to narrow) and skipped damaged files. Open to every agent."
text ard1 "Read one entry's exact text by its id (the SHA-256 of the text, checked on read). Open to every agent."
text ard2 "Whether this agent may contribute, the consent file, and one plain sentence for the person on how to turn sharing on or off. Reading never needs consent."
text ard3 "Post a question (needs consent). title and versions are one line each (tool, compiler, OS versions); body is the problem with the smallest reproduction. Refused, never edited, if it holds keys, tokens or home paths. Returns the entry id."
text ard4 "Post an answer to a question id (needs consent): versions it was proven on, steps to apply it, evidence (one line: the command that shows it works and its result) and body. Refused if it holds keys, tokens or home paths."
text ard5 "Confirm or challenge an answer id (needs consent): result works or fails, evidence (the command you ran and what it printed) and body (what you saw). Refused if it holds keys, tokens or home paths."
text arf0 "words"
text arf1 "id"
text arf2 "title"
text arf3 "versions"
text arf4 "body"
text arf5 "question"
text arf6 "answer"
text arf7 "steps"
text arf8 "evidence"
text arf9 "result"
text areinter "Internal error: the result is not a complete JSON object"

fn arwt ob edit uchar 787472 s view uchar * to void
js_wsbuf ob s 0 len s
end

fn arpair ob edit uchar 787472 key view uchar * value view uchar * to void
arwt ob key
arwt ob value
end

fn armem src view uchar 524288 tape view uint 65536 obj ulong key view uchar * to ulong
if ne js_type tape obj jsobj
ret jsnone
end
k = js_first tape obj
while ne k jsnone bound 999999
if js_streq src js_off tape k key
ret add k 1
end
k = js_mnext tape k
end
ret jsnone
end

fn arfull src view uchar * off ulong n ulong to bool
p = ulong 0
while lt p n bound 999999
r = write 1 src add off p sub n p
if eq r -4
continue
end
if le r 0
ret false
end
p = add p ulong r
end
ret true
end

fn arbegin src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
z = js_winit ob
js_wobj ob
arpair ob arj arver
arwt ob arid
t = get arrpc 0
if eq t jsnone
js_wnull ob
else
js_wtok ob src js_type tape t js_off tape t
end
end

fn arsend ob edit uchar 787472 to void
js_wobje ob
n = js_wdone ob
if lt n 0
exit 5
end
ok = arfull ob 1040 ulong n
if not ok
exit 6
end
ok = arfull arnl 0 1
if not ok
exit 6
end
end

fn arerror src view uchar 524288 tape view uint 65536 ob edit uchar 787472 code long msg view uchar * to void
arbegin src tape ob
arwt ob arerr
js_wobj ob
arwt ob arcode
js_wlong ob code
arpair ob armsg msg
js_wobje ob
arsend ob
end

fn arhandle src view uchar 524288 tape edit uint 65536 ob edit uchar 787472 n ulong to void
put arrpc 0 jsnone
r = js_parse src tape n
if lt r 0
arerror src tape ob -32700 areparse
ret
end
v = armem src tape 0 arj
m = armem src tape 0 arm
id = armem src tape 0 arid
valid = eq js_type tape 0 jsobj
if ne js_type tape v jsstr
valid = false
else
if not js_streq src js_off tape v arver
valid = false
end
end
if ne js_type tape m jsstr
valid = false
end
if ne id jsnone
ty = js_type tape id
if eq ty jsstr
put arrpc 0 id
else
if eq ty jsnum
if ne js_ilex src js_off tape id 0
put arrpc 0 id
else
valid = false
end
else
valid = false
end
end
end
note Duplicate envelope fields are ambiguous and cannot execute.
if valid
k = js_first tape 0
seen = ulong 0
while ne k jsnone bound 999999
bit = ulong 0
if js_streq src js_off tape k arj
bit = 1
end
if js_streq src js_off tape k arm
bit = 2
end
if js_streq src js_off tape k arid
bit = 4
end
if js_streq src js_off tape k arp
bit = 8
end
if ne and seen bit 0
valid = false
end
seen = or seen bit
k = js_mnext tape k
end
end
if not valid
arerror src tape ob -32600 areinv
ret
end
note Valid notifications have neither response nor storage effects.
if eq id jsnone
ret
end
p = armem src tape 0 arp
put arrpc 1 p
if ne p jsnone
if ne js_type tape p jsobj
arerror src tape ob -32602 arepar
ret
end
end
if js_streq src js_off tape m arinit
arinitialize src tape ob
ret
end
if js_streq src js_off tape m arcall
artoolcall src tape ob
ret
end
if js_streq src js_off tape m arping
arbegin src tape ob
arwt ob arres
js_wobj ob
js_wobje ob
arsend ob
ret
end
if js_streq src js_off tape m arlist
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob artools
js_warr ob
for op ulong 6
arschemawrite ob op
end
js_warre ob
js_wobje ob
arsend ob
ret
end
arerror src tape ob -32601 aremeth
end

fn arframe src view uchar 524288 tape edit uint 65536 ob edit uchar 787472 to void
if ne get arrpc 7 0
put arrpc 0 jsnone
arerror src tape ob -32700 areparse
else
arhandle src tape ob get arrpc 6
end
put arrpc 6 0
put arrpc 7 0
end

fn arfeed src edit uchar 524288 tape edit uint 65536 ob edit uchar 787472 chunk view uchar 4096 n ulong to void
for i ulong n
c = get chunk i
if eq c 10
arframe src tape ob
else
if eq get arrpc 7 0
p = get arrpc 6
if ge p len src
put arrpc 7 1
else
put src p c
put arrpc 6 add p 1
end
end
end
end
end

fn arfname ob edit uchar 787472 f ulong to void
if eq f 0
arwt ob arf0
end
if eq f 1
arwt ob arf1
end
if eq f 2
arwt ob arf2
end
if eq f 3
arwt ob arf3
end
if eq f 4
arwt ob arf4
end
if eq f 5
arwt ob arf5
end
if eq f 6
arwt ob arf6
end
if eq f 7
arwt ob arf7
end
if eq f 8
arwt ob arf8
end
if eq f 9
arwt ob arf9
end
end
note The fields each tool takes, as bits of the field slots in qa/store.om (all required, no others):
note ask 4+8+16=28, answer 32+8+128+256+16=440, check 64+512+256+16=848 (aien-calc receipts in the commit message).
fn armask op ulong to ulong
if eq op 0
ret 1
end
if eq op 1
ret 2
end
if eq op 2
ret 0
end
if eq op 3
ret 28
end
if eq op 4
ret 440
end
ret 848
end
note Largest accepted length of each field in bytes after JSON unescaping; every entry stays under qmax.
fn arcapof f ulong to ulong
if eq f 0
ret 256
end
if or or eq f 1 eq f 5 eq f 6
ret 64
end
if or eq f 2 eq f 3
ret 200
end
if eq f 4
ret 32768
end
if eq f 7
ret 16384
end
if eq f 8
ret 1000
end
ret 5
end
fn arname ob edit uchar 787472 op ulong to void
if eq op 0
arwt ob ar0
end
if eq op 1
arwt ob ar1
end
if eq op 2
arwt ob ar2
end
if eq op 3
arwt ob ar3
end
if eq op 4
arwt ob ar4
end
if eq op 5
arwt ob ar5
end
end
fn ardescription ob edit uchar 787472 op ulong to void
if eq op 0
arwt ob ard0
end
if eq op 1
arwt ob ard1
end
if eq op 2
arwt ob ard2
end
if eq op 3
arwt ob ard3
end
if eq op 4
arwt ob ard4
end
if eq op 5
arwt ob ard5
end
end
fn arschemawrite ob edit uchar 787472 op ulong to void
m = armask op
js_wobj ob
arwt ob arn
arname ob op
arwt ob ardesc
ardescription ob op
arwt ob arschema
js_wobj ob
arpair ob artype arobj
arwt ob aradd
js_wbool ob false
arwt ob arprops
js_wobj ob
for f ulong 10
if ne and m shl 1 f 0
arfname ob f
js_wobj ob
arpair ob artype arstr
arwt ob armax
js_wulong ob arcapof f
if or or eq f 1 eq f 5 eq f 6
arpair ob arpatter arhashpa
end
if eq f 9
arpair ob arpatter arrespa
end
js_wobje ob
end
end
js_wobje ob
arwt ob arreq
js_warr ob
for f ulong 10
if ne and m shl 1 f 0
arfname ob f
end
end
js_warre ob
js_wobje ob
js_wobje ob
end
fn arinitialize src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
p = get arrpc 1
v = armem src tape p arpv
if ne js_type tape v jsstr
arerror src tape ob -32602 arepar
ret
end
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob arpv
if js_streq src js_off tape v arpv2
arwt ob arpv2
else
if js_streq src js_off tape v arpv3
arwt ob arpv3
else
arwt ob arpv1
end
end
arwt ob arcap
js_wobj ob
arwt ob artools
js_wobj ob
arwt ob arlc
js_wbool ob false
js_wobje ob
js_wobje ob
arwt ob arsi
js_wobj ob
arpair ob arn arserver
arpair ob arversio arvers
js_wobje ob
arpair ob arinst arhelp
js_wobje ob
arsend ob
end
fn artoolop src view uchar 524288 off ulong to ulong
if js_streq src off ar0
ret 0
end
if js_streq src off ar1
ret 1
end
if js_streq src off ar2
ret 2
end
if js_streq src off ar3
ret 3
end
if js_streq src off ar4
ret 4
end
if js_streq src off ar5
ret 5
end
ret jsnone
end
fn arfieldof src view uchar 524288 off ulong to ulong
if js_streq src off arf0
ret 0
end
if js_streq src off arf1
ret 1
end
if js_streq src off arf2
ret 2
end
if js_streq src off arf3
ret 3
end
if js_streq src off arf4
ret 4
end
if js_streq src off arf5
ret 5
end
if js_streq src off arf6
ret 6
end
if js_streq src off arf7
ret 7
end
if js_streq src off arf8
ret 8
end
if js_streq src off arf9
ret 9
end
ret jsnone
end
note Exactly the tool's fields, each once, each a string; values are unescaped into fv slot by slot and a
note value longer than its cap (after unescaping) refuses the call.
fn arput src view uchar 524288 off ulong f ulong fv edit uchar 327680 fl edit ulong 10 to bool
tmp = new uchar 32768 0
n = js_sget src off tmp
if lt n 0
ret false
end
if gt ulong n arcapof f
ret false
end
for i ulong ulong n
put fv add mul f qfmax i get tmp i
end
put fl f ulong n
ret true
end
fn arfill src view uchar 524288 tape view uint 65536 a ulong op ulong fv edit uchar 327680 fl edit ulong 10 to bool
if ne js_type tape a jsobj
ret false
end
m = armask op
seen = ulong 0
k = js_first tape a
while ne k jsnone bound 64
f = arfieldof src js_off tape k
if eq f jsnone
ret false
end
b = shl 1 f
if eq and m b 0
ret false
end
if ne and seen b 0
ret false
end
seen = or seen b
v = add k 1
if ne js_type tape v jsstr
ret false
end
if gt js_slen tape v 32768
ret false
end
if not arput src js_off tape v f fv fl
ret false
end
k = js_mnext tape k
end
ret eq seen m
end
note Exactly the tool's fields, each once, each a string within its cap after unescaping; else -32602.
fn arinvoke src view uchar 524288 tape view uint 65536 ob edit uchar 787472 a ulong op ulong to void
fv = new uchar 327680 0
fl = new ulong 10 0
if not arfill src tape a op fv fl
arerror src tape ob -32602 arepar
ret
end
arresult src tape ob op fv fl
end
fn arresult src view uchar 524288 tape view uint 65536 ob edit uchar 787472 op ulong fv view uchar 327680 fl view ulong 10 to void
arbegin src tape ob
arwt ob arres
js_wobj ob
arwt ob arsc
ok = qa_call op fv fl ob
arwt ob arc
js_warr ob
js_wobj ob
arpair ob artype artext
arpair ob artext arsummar
js_wobje ob
js_warre ob
arwt ob ariserr
js_wbool ob ne get qerr 0 0
js_wobje ob
arsend ob
end

fn artoolcall src view uchar 524288 tape view uint 65536 ob edit uchar 787472 to void
p = get arrpc 1
n = armem src tape p arn
a = armem src tape p ara
if ne js_type tape n jsstr
arerror src tape ob -32602 arepar
ret
end
op = artoolop src js_off tape n
if eq op jsnone
arerror src tape ob -32602 arepar
ret
end
if eq a jsnone
if ne armask op 0
arerror src tape ob -32602 arepar
ret
end
end
if or gt js_nkids tape p 2 and eq a jsnone gt js_nkids tape p 1
arerror src tape ob -32602 arepar
ret
end
if eq a jsnone
arinvoke0 src tape ob op
ret
end
arinvoke src tape ob a op
end
fn arinvoke0 src view uchar 524288 tape view uint 65536 ob edit uchar 787472 op ulong to void
fv = new uchar 327680 0
fl = new ulong 10 0
arresult src tape ob op fv fl
end

fn main to int
src = new uchar 524288 0
tape = new uint 65536 0
ob = new uchar 787472 0
chunk = new uchar 4096 0
b = qa_boot
if ne b 0
ret b
end
z = js_init tape 524288 64
if lt z 0
ret 4
end
note Each read consumes bytes or EOF; nested bounded epochs permit a long-lived stdio connection.
for epoch ulong 999999
for tick ulong 999999
r = read 0 chunk 0 len chunk
if eq r -4
continue
end
if lt r 0
ret 7
end
if eq r 0
if or ne get arrpc 6 0 ne get arrpc 7 0
arframe src tape ob
end
ret 0
end
arfeed src tape ob chunk ulong r
end
end
ret 0
end

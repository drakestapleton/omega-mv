note Sub-reason detail strings
text sd_aws "aws_access_key"
text sd_gh "github_pat"
text sd_pem "private_key_pem"
text sd_assign "plaintext_secret_assign"
text sd_env "plaintext_env_file"
text sd_evid "protected_evidence_path"
text sd_aien "protected_aien_path"
text sd_gates "protected_gates_path"
text sd_ci "protected_ci_workflow_path"
text sd_dirty "dirty_worktree_flag"
text sd_fpi "not_run_or_skipped_labelled_pass"
text sd_fpr "audit_record_pass_with_zero_or_not_run"
text sd_tv "telemetry_tracker_hook"
text sd_tr "telemetry_source_indicator"

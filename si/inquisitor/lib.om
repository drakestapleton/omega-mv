if eq r RULE_DIRTY_TREE
inq_out_str rn_dirty
ret
end
if eq r RULE_FALSE_PASS
inq_out_str rn_fpass
ret
end
if eq r RULE_TELEMETRY
inq_out_str rn_telem
ret
end
if eq r RULE_STUB_HARD
inq_out_str rn_stub
ret
end
if eq r RULE_TODO_WARN
inq_out_str rn_todo
ret
end
if eq r RULE_UNSLOP_WARN
inq_out_str rn_unslop
ret
end
inq_out_str rn_unk
end


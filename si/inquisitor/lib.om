fn inq_to_lower c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn inq_is_alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret false
end

fn inq_is_upper_alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
ret false
end

fn inq_is_word c uchar to bool
if eq c 95
ret true
end
ret inq_is_alnum c
end

fn inq_fnv_step h ulong b uchar to ulong
x = xor h ulong b
ret mul x ulong 0x100000001b3
end

fn inq_reset to void
put inq_path_off 0 0
put inq_path_len 0 0
put inq_a_off 0 0
put inq_a_len 0 0
put inq_tmp_off 0 0
put inq_tmp_len 0 0
put inq_out_len 0 0
put inq_verdict 0 SEV_PASS
put inq_blocks 0 0
put inq_warns 0 0
put inq_files 0 0
put inq_lines 0 0
put inq_added 0 0
put inq_find_cnt 0 0
put inq_in_bin 0 0
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
put inq_hunk_old 0 0
put inq_hunk_new 0 0
put inq_expect_plus 0 0
put inq_has_git_hdr 0 0
put inq_in_git_body 0 0
put inq_skip_file 0 0
put inq_diff_checked 0 0
put inq_seen_notrun 0 0
put inq_seen_pass 0 0
put inq_rec_flagged 0 0
put inq_hash 0 ulong 0xcbf29ce484222325
for i ulong 16
put inq_rcnt i 0
end
end

fn inq_load_text s view uchar * to ulong
n = len s
if gt n INQ_MAX_IN
n = INQ_MAX_IN
end
for i ulong n bound 131072
put inq_in i get s i
end
put inq_in_len 0 n
ret n
end

fn inq_record rule ulong sev ulong line_no ulong sub_id ulong to void
cur_v = get inq_verdict 0
if gt sev cur_v
put inq_verdict 0 sev
end
if eq sev SEV_BLOCK
put inq_blocks 0 add get inq_blocks 0 1
else
if eq sev SEV_WARN
put inq_warns 0 add get inq_warns 0 1
end
end
if lt rule 16
put inq_rcnt rule add get inq_rcnt rule 1
end
fc = get inq_find_cnt 0
if lt fc INQ_MAX_FIND
put inq_find_rule fc rule
put inq_find_sev fc sev
put inq_find_line fc line_no
put inq_find_sub fc sub_id
put inq_find_cnt 0 add fc 1
end
end

fn inq_starts_cs off ulong nlen ulong pat view uchar * to bool
pl = len pat
if lt nlen pl
ret false
end
for i ulong pl bound 128
if ne get inq_in add off i get pat i
ret false
end
end
ret true
end

fn inq_match_cs pos ulong pat view uchar * to bool
pl = len pat
for j ulong pl bound 128
if ne get inq_in add pos j get pat j
ret false
end
end
ret true
end

fn inq_match_ci pos ulong pat view uchar * to bool
pl = len pat
for j ulong pl bound 128
c1 = inq_to_lower get inq_in add pos j
c2 = inq_to_lower get pat j
if ne c1 c2
ret false
end
end
ret true
end

fn inq_contains_cs off ulong nlen ulong pat view uchar * to bool
pl = len pat
if or eq pl 0 lt nlen pl
ret false
end
lim = add sub nlen pl 1
for i ulong lim bound 131072
if inq_match_cs add off i pat
ret true
end
end
ret false
end

fn inq_contains_ci off ulong nlen ulong pat view uchar * to bool
pl = len pat
if or eq pl 0 lt nlen pl
ret false
end
lim = add sub nlen pl 1
for i ulong lim bound 131072
if inq_match_ci add off i pat
ret true
end
end
ret false
end

fn inq_word_ok off ulong nlen ulong i ulong pl ulong to bool
if gt i 0
if inq_is_word get inq_in sub add off i 1
ret false
end
end
end_idx = add i pl
if lt end_idx nlen
if inq_is_word get inq_in add off end_idx
ret false
end
end
ret true
end

fn inq_contains_word_ci off ulong nlen ulong pat view uchar * to bool
pl = len pat
if or eq pl 0 lt nlen pl
ret false
end
lim = add sub nlen pl 1
for i ulong lim bound 131072
if inq_word_ok off nlen i pl
if inq_match_ci add off i pat
ret true
end
end
end
ret false
end

fn inq_find_substr_cs off ulong nlen ulong pat view uchar * to ulong
pl = len pat
if or eq pl 0 lt nlen pl
ret nlen
end
lim = add sub nlen pl 1
for i ulong lim bound 131072
if inq_match_cs add off i pat
ret i
end
end
ret nlen
end

fn inq_slice_eq_pat off ulong nlen ulong pat view uchar * to bool
if ne nlen len pat
ret false
end
for i ulong nlen bound 128
if ne get inq_in add off i get pat i
ret false
end
end
ret true
end

fn inq_slice_eq_in off1 ulong len1 ulong off2 ulong len2 ulong to bool
if ne len1 len2
ret false
end
for i ulong len1 bound 131072
if ne get inq_in add off1 i get inq_in add off2 i
ret false
end
end
ret true
end

fn inq_slice_starts_ci off ulong nlen ulong pat view uchar * to bool
pl = len pat
if lt nlen pl
ret false
end
for i ulong pl bound 128
if ne inq_to_lower get inq_in add off i inq_to_lower get pat i
ret false
end
end
ret true
end

fn inq_slice_ends_ci off ulong nlen ulong pat view uchar * to bool
pl = len pat
if lt nlen pl
ret false
end
base = add off sub nlen pl
for i ulong pl bound 128
if ne inq_to_lower get inq_in add base i inq_to_lower get pat i
ret false
end
end
ret true
end

fn inq_slice_is_env off ulong nlen ulong to bool
if lt nlen 4
ret false
end
base = ulong 0
for i ulong nlen bound 131072
if eq get inq_in add off i 47
base = add i 1
end
end
blen = sub nlen base
if lt blen 4
ret false
end
p0 = add off base
if ne get inq_in p0 46
ret false
end
if ne inq_to_lower get inq_in add p0 1 101
ret false
end
if ne inq_to_lower get inq_in add p0 2 110
ret false
end
if ne inq_to_lower get inq_in add p0 3 118
ret false
end
if eq blen 4
ret true
end
if eq get inq_in add p0 4 46
ret true
end
ret false
end

fn inq_is_trim_char c uchar to bool
if or eq c 32 or eq c 9 eq c 13
ret true
end
if or eq c 34 eq c 39
ret true
end
ret false
end

fn inq_trim_slice off ulong nlen ulong to void
s = off
e = add off nlen
while lt s e bound 131072
if inq_is_trim_char get inq_in s
s = add s 1
else
break
end
end
while gt e s bound 131072
if inq_is_trim_char get inq_in sub e 1
e = sub e 1
else
break
end
end
put inq_tmp_off 0 s
put inq_tmp_len 0 sub e s
end

fn inq_norm_slice off ulong nlen ulong to void
inq_trim_slice off nlen
s = get inq_tmp_off 0
e = add s get inq_tmp_len 0
if ge sub e s 2
c0 = get inq_in s
c1 = get inq_in add s 1
if and eq c1 47 or eq c0 97 eq c0 98
s = add s 2
end
end
while ge sub e s 2 bound 65536
c0 = get inq_in s
c1 = get inq_in add s 1
if and eq c0 46 eq c1 47
s = add s 2
else
break
end
end
put inq_tmp_off 0 s
put inq_tmp_len 0 sub e s
end

fn inq_set_active_path off ulong nlen ulong to void
put inq_path_off 0 off
put inq_path_len 0 nlen
if or inq_contains_ci off nlen p_self_inq inq_contains_ci off nlen p_self_con
put inq_skip_file 0 1
else
put inq_skip_file 0 0
end
end

fn inq_check_path_slice off ulong nlen ulong line_no ulong to void
if eq nlen 0
ret
end
if inq_slice_eq_pat off nlen p_dev_null
ret
end
if inq_slice_is_env off nlen
inq_record RULE_ENV_FILE SEV_BLOCK line_no SUB_ENV_FILE
end
if or inq_slice_starts_ci off nlen p_evid_pre inq_contains_ci off nlen p_evid_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_EVIDENCE
end
if or inq_slice_starts_ci off nlen p_aien_pre inq_contains_ci off nlen p_aien_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_AIEN
end
if or inq_slice_starts_ci off nlen p_gates_pre inq_contains_ci off nlen p_gates_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_GATES
end
if or inq_slice_starts_ci off nlen p_ghwf_pre inq_contains_ci off nlen p_ghwf_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_CI
else
if or inq_slice_starts_ci off nlen p_fgjo_pre inq_contains_ci off nlen p_fgjo_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_CI
end
end
if or inq_slice_starts_ci off nlen p_aient_pre inq_contains_ci off nlen p_aient_mid
inq_record RULE_PROTECTED_PATH SEV_BLOCK line_no SUB_PATH_AIEN_TEST
end
end

fn inq_diff_git_find_t2 pos ulong end_p ulong to ulong
rem_l = sub end_p pos
idx = inq_find_substr_cs pos rem_l p_sp_b_slash
if lt idx rem_l
ret add pos add idx 1
end
idx = inq_find_substr_cs pos rem_l p_sp_qb_slash
if lt idx rem_l
ret add pos add idx 1
end
p = pos
while lt p end_p bound 131072
if ne get inq_in p 32
p = add p 1
else
break
end
end
while lt p end_p bound 131072
if eq get inq_in p 32
p = add p 1
else
break
end
end
ret p
end

fn inq_parse_diff_git off ulong nlen ulong line_no ulong to void
put inq_in_bin 0 0
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
put inq_hunk_old 0 0
put inq_hunk_new 0 0
put inq_expect_plus 0 1
put inq_has_git_hdr 0 1
put inq_in_git_body 0 0
put inq_diff_checked 0 0
put inq_a_off 0 0
put inq_a_len 0 0
put inq_files 0 add get inq_files 0 1
pos = add off 11
end_p = add off nlen
while lt pos end_p bound 131072
if eq get inq_in pos 32
pos = add pos 1
else
break
end
end
if ge pos end_p
ret
end
t2_s = inq_diff_git_find_t2 pos end_p
if lt t2_s end_p
t1_e = t2_s
while gt t1_e pos bound 131072
if eq get inq_in sub t1_e 1 32
t1_e = sub t1_e 1
else
break
end
end
inq_norm_slice pos sub t1_e pos
a_off = get inq_tmp_off 0
a_len = get inq_tmp_len 0
put inq_a_off 0 a_off
put inq_a_len 0 a_len
inq_norm_slice t2_s sub end_p t2_s
b_off = get inq_tmp_off 0
b_len = get inq_tmp_len 0
if not inq_slice_eq_in a_off a_len b_off b_len
inq_check_path_slice a_off a_len line_no
end
inq_set_active_path b_off b_len
inq_check_path_slice b_off b_len line_no
put inq_diff_checked 0 1
else
inq_norm_slice pos sub end_p pos
a_off = get inq_tmp_off 0
a_len = get inq_tmp_len 0
put inq_a_off 0 a_off
put inq_a_len 0 a_len
inq_set_active_path a_off a_len
inq_check_path_slice a_off a_len line_no
end
end

fn inq_strip_tab_len pos ulong rem_l ulong to ulong
tab_i = ulong 0
while lt tab_i rem_l bound 131072
if eq get inq_in add pos tab_i 9
ret tab_i
end
tab_i = add tab_i 1
end
ret rem_l
end

fn inq_plus_header_allowed off ulong nlen ulong to bool
if eq get inq_expect_plus 0 0
ret false
end
if eq get inq_expect_plus 0 2
ret true
end
pos = add off 4
inq_trim_slice pos inq_strip_tab_len pos sub nlen 4
s = get inq_tmp_off 0
tl = get inq_tmp_len 0
if inq_slice_eq_pat s tl p_dev_null
ret true
end
if ge tl 2
if eq get inq_in s 98
if eq get inq_in add s 1 47
ret true
end
end
end
ret false
end

fn inq_minus_is_git_path off ulong nlen ulong to bool
pos = add off 4
inq_trim_slice pos inq_strip_tab_len pos sub nlen 4
s = get inq_tmp_off 0
tl = get inq_tmp_len 0
if inq_slice_eq_pat s tl p_dev_null
ret true
end
if ge tl 2
if eq get inq_in add s 1 47
c0 = get inq_in s
if or eq c0 97 eq c0 98
ret true
end
end
end
ret false
end

fn inq_parse_minus_header off ulong nlen ulong line_no ulong exp_mode ulong to void
put inq_in_bin 0 0
put inq_expect_plus 0 exp_mode
pos = add off 4
rem_l = inq_strip_tab_len pos sub nlen 4
inq_norm_slice pos rem_l
ns = get inq_tmp_off 0
npl = get inq_tmp_len 0
if or eq npl 0 inq_slice_eq_pat ns npl p_dev_null
ret
end
already = false
if eq get inq_diff_checked 0 1
if inq_slice_eq_in ns npl get inq_a_off 0 get inq_a_len 0
already = true
end
end
if not already
inq_check_path_slice ns npl line_no
end
end

fn inq_parse_plus_header off ulong nlen ulong line_no ulong to void
put inq_in_bin 0 0
put inq_expect_plus 0 0
if eq get inq_has_git_hdr 0 1
put inq_in_git_body 0 1
end
pos = add off 4
rem_l = inq_strip_tab_len pos sub nlen 4
inq_norm_slice pos rem_l
ns = get inq_tmp_off 0
npl = get inq_tmp_len 0
if or eq npl 0 inq_slice_eq_pat ns npl p_dev_null
put inq_diff_checked 0 0
ret
end
already = false
if eq get inq_diff_checked 0 1
if inq_slice_eq_in ns npl get inq_path_off 0 get inq_path_len 0
already = true
end
end
inq_set_active_path ns npl
put inq_diff_checked 0 0
if not already
put inq_files 0 add get inq_files 0 1
inq_check_path_slice ns npl line_no
end
end

fn inq_check_bin_pair a_off ulong a_len ulong b_off ulong b_len ulong line_no ulong to void
a_ok = and gt a_len 0 not inq_slice_eq_pat a_off a_len p_dev_null
b_ok = and gt b_len 0 not inq_slice_eq_pat b_off b_len p_dev_null
if or a_ok b_ok
put inq_files 0 add get inq_files 0 1
end
if a_ok
if or not b_ok not inq_slice_eq_in a_off a_len b_off b_len
inq_check_path_slice a_off a_len line_no
end
end
if b_ok
inq_set_active_path b_off b_len
inq_check_path_slice b_off b_len line_no
else
if a_ok
inq_set_active_path a_off a_len
end
end
end

fn inq_parse_bin_files off ulong nlen ulong line_no ulong to void
note Format: "Binary files <src> and <dst> differ"
put inq_in_bin 0 0
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
put inq_hunk_old 0 0
put inq_hunk_new 0 0
put inq_expect_plus 0 0
put inq_has_git_hdr 0 0
put inq_in_git_body 0 0
put inq_diff_checked 0 0
s = add off 13
e = add off nlen
while gt e s bound 131072
c = get inq_in sub e 1
if or eq c 32 eq c 13
e = sub e 1
else
break
end
end
if ge sub e s 7
if inq_match_cs sub e 7 p_sp_differ
e = sub e 7
end
end
rem_l = sub e s
sp = inq_find_substr_cs s rem_l p_sp_and_b
if eq sp rem_l
sp = inq_find_substr_cs s rem_l p_sp_and_dev
end
if eq sp rem_l
sp = inq_find_substr_cs s rem_l p_sp_and_sp
end
if ge sp rem_l
ret
end
inq_norm_slice s sp
a_off = get inq_tmp_off 0
a_len = get inq_tmp_len 0
dst_s = add s add sp 5
inq_norm_slice dst_s sub e dst_s
inq_check_bin_pair a_off a_len get inq_tmp_off 0 get inq_tmp_len 0 line_no
end

fn inq_read_u64_at pos ulong end_p ulong to void
digits = ulong 0
val = ulong 0
p = pos
while lt p end_p bound 131072
c = get inq_in p
if and ge c 48 le c 57
digits = add digits 1
if le digits 9
val = add mul val 10 ulong sub c 48
end
p = add p 1
else
break
end
end
put inq_num_pos 0 p
put inq_num_val 0 val
if and gt digits 0 le digits 9
put inq_num_ok 0 1
else
put inq_num_ok 0 0
end
end

fn inq_parse_hunk_hdr off ulong nlen ulong to void
put inq_in_bin 0 0
put inq_expect_plus 0 0
if eq get inq_has_git_hdr 0 1
put inq_in_git_body 0 1
end
put inq_in_hunk 0 1
put inq_hunk_has_cnt 0 0
put inq_hunk_old 0 0
put inq_hunk_new 0 0
p = add off 3
end_p = add off nlen
while lt p end_p bound 131072
if eq get inq_in p 32
p = add p 1
else
break
end
end
if ge p end_p
ret
end
if ne get inq_in p 45
ret
end
p = add p 1
inq_read_u64_at p end_p
if eq get inq_num_ok 0 0
ret
end
p = get inq_num_pos 0
old_c = ulong 1
if lt p end_p
if eq get inq_in p 44
p = add p 1
inq_read_u64_at p end_p
if eq get inq_num_ok 0 0
ret
end
old_c = get inq_num_val 0
p = get inq_num_pos 0
end
end
if ge p end_p
ret
end
if ne get inq_in p 32
ret
end
while lt p end_p bound 131072
if eq get inq_in p 32
p = add p 1
else
break
end
end
if ge p end_p
ret
end
if ne get inq_in p 43
ret
end
p = add p 1
inq_read_u64_at p end_p
if eq get inq_num_ok 0 0
ret
end
p = get inq_num_pos 0
new_c = ulong 1
if lt p end_p
if eq get inq_in p 44
p = add p 1
inq_read_u64_at p end_p
if eq get inq_num_ok 0 0
ret
end
new_c = get inq_num_val 0
p = get inq_num_pos 0
end
end
if ge p end_p
ret
end
if ne get inq_in p 32
ret
end
while lt p end_p bound 131072
if eq get inq_in p 32
p = add p 1
else
break
end
end
if lt sub end_p p 2
ret
end
if or ne get inq_in p 64 ne get inq_in add p 1 64
ret
end
if and eq old_c 0 eq new_c 0
put inq_in_hunk 0 0
ret
end
put inq_hunk_old 0 old_c
put inq_hunk_new 0 new_c
put inq_hunk_has_cnt 0 1
end

fn inq_hunk_step kind ulong to void
if eq get inq_in_hunk 0 0
ret
end
if eq get inq_hunk_has_cnt 0 0
ret
end
old_r = get inq_hunk_old 0
new_r = get inq_hunk_new 0
if or eq kind 0 eq kind 45
if gt old_r 0
old_r = sub old_r 1
put inq_hunk_old 0 old_r
end
end
if or eq kind 0 eq kind 43
if gt new_r 0
new_r = sub new_r 1
put inq_hunk_new 0 new_r
end
end
if and eq old_r 0 eq new_r 0
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
end
end

fn inq_try_git_ext_hdr off ulong nlen ulong line_no ulong to bool
if inq_starts_cs off nlen p_ren_from
inq_norm_slice add off 12 sub nlen 12
inq_check_path_slice get inq_tmp_off 0 get inq_tmp_len 0 line_no
ret true
end
if inq_starts_cs off nlen p_ren_to
inq_norm_slice add off 10 sub nlen 10
ns = get inq_tmp_off 0
npl = get inq_tmp_len 0
inq_set_active_path ns npl
inq_check_path_slice ns npl line_no
ret true
end
if inq_starts_cs off nlen p_cpy_from
inq_norm_slice add off 10 sub nlen 10
inq_check_path_slice get inq_tmp_off 0 get inq_tmp_len 0 line_no
ret true
end
if inq_starts_cs off nlen p_cpy_to
inq_norm_slice add off 8 sub nlen 8
ns = get inq_tmp_off 0
npl = get inq_tmp_len 0
inq_set_active_path ns npl
inq_check_path_slice ns npl line_no
ret true
end
if or inq_starts_cs off nlen p_hdr_idx inq_starts_cs off nlen p_hdr_omode
ret true
end
if or inq_starts_cs off nlen p_hdr_nmode inq_starts_cs off nlen p_hdr_nfmode
ret true
end
if or inq_starts_cs off nlen p_hdr_dfmode inq_starts_cs off nlen p_hdr_sim
ret true
end
if inq_starts_cs off nlen p_hdr_dis
ret true
end
ret false
end

fn inq_has_aws_key off ulong nlen ulong to bool
if lt nlen 20
ret false
end
lim = add sub nlen 20 1
for i ulong lim bound 131072
if inq_starts_cs add off i sub nlen i p_akia
ok = true
if gt i 0
if inq_is_word get inq_in sub add off i 1
ok = false
end
end
if ok
end_i = add i 20
if lt end_i nlen
if inq_is_word get inq_in add off end_i
ok = false
end
end
end
if ok
base = add off add i 4
for k ulong 16
if not inq_is_upper_alnum get inq_in add base k
ok = false
break
end
end
if ok
ret true
end
end
end
end
ret false
end

fn inq_has_ghp_token off ulong nlen ulong to bool
if lt nlen 40
ret false
end
lim = add sub nlen 40 1
for i ulong lim bound 131072
if inq_starts_cs add off i sub nlen i p_ghp
ok = true
if gt i 0
if inq_is_word get inq_in sub add off i 1
ok = false
end
end
if ok
run_n = ulong 0
idx = add i 4
while and lt idx nlen lt run_n 36 bound 36
if inq_is_alnum get inq_in add off idx
run_n = add run_n 1
idx = add idx 1
else
break
end
end
if ge run_n 36
ret true
end
end
end
end
ret false
end

fn inq_has_gh_fine_pat off ulong nlen ulong to bool
if lt nlen 61
ret false
end
if not inq_contains_cs off nlen p_gh_fine
ret false
end
lim = add sub nlen 61 1
for i ulong lim bound 131072
if inq_starts_cs add off i sub nlen i p_gh_fine
ok = true
if gt i 0
if inq_is_word get inq_in sub add off i 1
ok = false
end
end
if ok
run_n = ulong 0
idx = add i 11
while and lt idx nlen lt run_n 50 bound 50
if inq_is_word get inq_in add off idx
run_n = add run_n 1
idx = add idx 1
else
break
end
end
if ge run_n 50
ret true
end
end
end
end
ret false
end

fn inq_check_secrets off ulong nlen ulong line_no ulong to void
if inq_has_aws_key off nlen
inq_record RULE_SECRET SEV_BLOCK line_no SUB_AWS_KEY
end
if or inq_has_ghp_token off nlen inq_has_gh_fine_pat off nlen
inq_record RULE_SECRET SEV_BLOCK line_no SUB_GH_PAT
end
if inq_contains_cs off nlen p_pem_rsa
inq_record RULE_SECRET SEV_BLOCK line_no SUB_PRIV_KEY
else
if and inq_contains_cs off nlen p_pem_beg inq_contains_cs off nlen p_pem_end
inq_record RULE_SECRET SEV_BLOCK line_no SUB_PRIV_KEY
end
end
if not or inq_contains_ci off nlen p_redacted inq_contains_ci off nlen p_vault
has_asgn = or inq_contains_cs off nlen p_sec_k1 inq_contains_cs off nlen p_sec_k2
has_asgn = or has_asgn or inq_contains_cs off nlen p_sec_k3 inq_contains_cs off nlen p_sec_k4
if has_asgn
inq_record RULE_SECRET SEV_BLOCK line_no SUB_SECRET_ASSIGN
end
end
end

fn inq_has_tel_vendor off ulong nlen ulong to bool
if inq_contains_ci off nlen p_tel1
ret true
end
if inq_contains_ci off nlen p_tel2
ret true
end
if inq_contains_ci off nlen p_tel3
ret true
end
if inq_contains_ci off nlen p_tel4
ret true
end
if inq_contains_ci off nlen p_tel5
ret true
end
if inq_contains_ci off nlen p_tel6
ret true
end
if inq_contains_ci off nlen p_tel7
ret true
end
if inq_contains_ci off nlen p_tel8
ret true
end
if inq_contains_ci off nlen p_tel9
ret true
end
if inq_contains_ci off nlen p_tel10
ret true
end
if inq_contains_ci off nlen p_tel11
ret true
end
if inq_contains_ci off nlen p_tel12
ret true
end
if inq_contains_ci off nlen p_tel13
ret true
end
ret false
end

fn inq_tel_is_negated off ulong nlen ulong to bool
if inq_contains_ci off nlen p_tel_ok1
ret true
end
if inq_contains_ci off nlen p_tel_ok2
ret true
end
if inq_contains_ci off nlen p_tel_ok3
ret true
end
if inq_contains_ci off nlen p_tel_ok4
ret true
end
if inq_contains_ci off nlen p_tel_ok5
ret true
end
if inq_contains_ci off nlen p_tel_ok6
ret true
end
if inq_contains_ci off nlen p_tel_ok7
ret true
end
if inq_contains_ci off nlen p_tel_ok8
ret true
end
if inq_contains_ci off nlen p_tel_ok9
ret true
end
if inq_contains_ci off nlen p_tel_ok10
ret true
end
ret false
end

fn inq_check_telemetry off ulong nlen ulong line_no ulong to void
if inq_has_tel_vendor off nlen
inq_record RULE_TELEMETRY SEV_BLOCK line_no SUB_TELEM_VENDOR
ret
end
if not inq_slice_ends_ci get inq_path_off 0 get inq_path_len 0 p_ext_md
if inq_contains_ci off nlen p_tel_raw
if not inq_tel_is_negated off nlen
inq_record RULE_TELEMETRY SEV_BLOCK line_no SUB_TELEM_RAW
end
end
end
end

fn inq_check_stubs off ulong nlen ulong line_no ulong to void
hard = or inq_contains_ci off nlen p_stub1 inq_contains_ci off nlen p_stub2
hard = or hard or inq_contains_ci off nlen p_stub3 inq_contains_ci off nlen p_stub4
hard = or hard inq_contains_ci off nlen p_stub5
if hard
inq_record RULE_STUB_HARD SEV_BLOCK line_no SUB_STUB_HARD
ret
end
soft = or inq_contains_ci off nlen p_todo1 inq_contains_ci off nlen p_todo2
soft = or soft or inq_contains_ci off nlen p_todo3 inq_contains_ci off nlen p_todo4
soft = or soft inq_contains_word_ci off nlen p_todo5
if soft
inq_record RULE_TODO_WARN SEV_WARN line_no SUB_TODO_WARN
end
end

fn inq_has_utf8_dash off ulong nlen ulong to bool
if lt nlen 3
ret false
end
lim = sub nlen 2
for i ulong lim bound 131072
b0 = get inq_in add off i
if eq b0 226
b1 = get inq_in add off add i 1
if eq b1 128
b2 = get inq_in add off add i 2
if or eq b2 148 eq b2 147
ret true
end
end
end
end
ret false
end

fn inq_check_unslop off ulong nlen ulong line_no ulong to void
if inq_has_utf8_dash off nlen
inq_record RULE_UNSLOP_WARN SEV_WARN line_no SUB_UNSLOP_DASH
end
bz = or inq_contains_word_ci off nlen p_bz1 inq_contains_word_ci off nlen p_bz2
bz = or bz or inq_contains_word_ci off nlen p_bz3 inq_contains_word_ci off nlen p_bz4
bz = or bz or inq_contains_word_ci off nlen p_bz5 inq_contains_ci off nlen p_bz6
bz = or bz inq_contains_ci off nlen p_bz7
if not bz
if inq_contains_word_ci off nlen p_bz8
if not or inq_contains_ci off nlen p_bz8_ok1 inq_contains_ci off nlen p_bz8_ok2
bz = true
end
end
end
if not bz
if inq_contains_word_ci off nlen p_bz9
if not or inq_contains_ci off nlen p_bz9_ok1 inq_contains_ci off nlen p_bz9_ok2
bz = true
end
end
end
if bz
inq_record RULE_UNSLOP_WARN SEV_WARN line_no SUB_UNSLOP_BUZZ
end
end

fn inq_check_dirty_line off ulong nlen ulong line_no ulong to void
hit = or inq_contains_ci off nlen p_dt1 inq_contains_ci off nlen p_dt2
hit = or hit or inq_contains_ci off nlen p_dt3 inq_contains_ci off nlen p_dt4
hit = or hit or inq_contains_ci off nlen p_dt5 inq_contains_ci off nlen p_dt6
hit = or hit or inq_contains_ci off nlen p_dt7 inq_contains_ci off nlen p_dt8
hit = or hit or inq_contains_ci off nlen p_dt9 inq_contains_ci off nlen p_dt10
if hit
inq_record RULE_DIRTY_TREE SEV_BLOCK line_no SUB_DIRTY_TREE
end
end

fn inq_check_false_pass off ulong nlen ulong line_no ulong to void
has_nr = or inq_contains_ci off nlen p_not_run inq_contains_ci off nlen p_skipped
has_nr = or has_nr or inq_contains_ci off nlen p_blk_hw inq_contains_ci off nlen p_blk_op
has_nr = or has_nr or inq_contains_ci off nlen p_miss_impl inq_contains_ci off nlen p_zero_tests
if and has_nr inq_contains_word_ci off nlen p_pass_w
inq_record RULE_FALSE_PASS SEV_BLOCK line_no SUB_FALSE_PASS_INLINE
put inq_rec_flagged 0 1
ret
end
rec_nr = or inq_contains_ci off nlen p_gs_notrun inq_contains_ci off nlen p_tr_zero
rec_nr = or rec_nr or inq_contains_ci off nlen p_ex_zero inq_contains_ci off nlen p_ts_skip
rec_nr = or rec_nr or inq_contains_ci off nlen p_ts_notrun inq_contains_ci off nlen p_st_notrun
if rec_nr
put inq_seen_notrun 0 1
end
rec_p = or inq_contains_ci off nlen p_v_pass inq_contains_ci off nlen p_c_pass
rec_p = or rec_p or inq_contains_ci off nlen p_s_pass inq_contains_ci off nlen p_r_pass
if rec_p
put inq_seen_pass 0 1
end
if eq get inq_seen_notrun 0 1
if eq get inq_seen_pass 0 1
if eq get inq_rec_flagged 0 0
inq_record RULE_FALSE_PASS SEV_BLOCK line_no SUB_FALSE_PASS_RECORD
put inq_rec_flagged 0 1
end
end
end
end

fn inq_scan_line off ulong nlen ulong line_no ulong to void
if eq nlen 0
put inq_seen_notrun 0 0
put inq_seen_pass 0 0
put inq_rec_flagged 0 0
put inq_expect_plus 0 0
if eq get inq_in_hunk 0 1
inq_hunk_step 0
end
ret
end
if and eq nlen 3 inq_starts_cs off nlen p_rec_sep
put inq_seen_notrun 0 0
put inq_seen_pass 0 0
put inq_rec_flagged 0 0
put inq_expect_plus 0 0
if eq get inq_in_hunk 0 1
inq_hunk_step 45
end
ret
end
if inq_starts_cs off nlen p_diff_git
put inq_seen_notrun 0 0
put inq_seen_pass 0 0
put inq_rec_flagged 0 0
inq_parse_diff_git off nlen line_no
ret
end
if inq_starts_cs off nlen p_file_rec
put inq_in_bin 0 0
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
put inq_expect_plus 0 0
put inq_has_git_hdr 0 0
put inq_in_git_body 0 0
put inq_diff_checked 0 0
put inq_files 0 add get inq_files 0 1
inq_norm_slice add off 6 sub nlen 6
ns = get inq_tmp_off 0
npl = get inq_tmp_len 0
inq_set_active_path ns npl
inq_check_path_slice ns npl line_no
ret
end
if inq_starts_cs off nlen p_bin_files
inq_parse_bin_files off nlen line_no
ret
end
if inq_starts_cs off nlen p_git_bin
put inq_in_bin 0 1
put inq_in_hunk 0 0
put inq_hunk_has_cnt 0 0
put inq_expect_plus 0 0
put inq_has_git_hdr 0 0
put inq_in_git_body 0 0
put inq_diff_checked 0 0
ret
end
if eq get inq_in_hunk 0 0
if inq_starts_cs off nlen p_plus3
if inq_plus_header_allowed off nlen
inq_parse_plus_header off nlen line_no
ret
end
end
if eq get inq_in_git_body 0 0
if inq_starts_cs off nlen p_minus3
inq_parse_minus_header off nlen line_no 2
ret
end
if eq get inq_in_bin 0 0
if inq_try_git_ext_hdr off nlen line_no
ret
end
end
else
if inq_starts_cs off nlen p_minus3
if inq_minus_is_git_path off nlen
put inq_diff_checked 0 0
inq_parse_minus_header off nlen line_no 1
ret
end
end
end
end
if inq_starts_cs off nlen p_hunk
inq_parse_hunk_hdr off nlen
ret
end
if inq_starts_cs off nlen p_hunk3
put inq_in_bin 0 0
put inq_expect_plus 0 0
if eq get inq_has_git_hdr 0 1
put inq_in_git_body 0 1
end
put inq_in_hunk 0 1
put inq_hunk_has_cnt 0 0
ret
end
if eq get inq_in_bin 0 1
ret
end
put inq_expect_plus 0 0
if eq get inq_has_git_hdr 0 1
put inq_in_git_body 0 1
end
first_c = get inq_in off
if eq get inq_in_hunk 0 1
if eq first_c 43
inq_hunk_step 43
else
if eq first_c 45
inq_hunk_step 45
else
if eq first_c 32
inq_hunk_step 0
end
end
end
end
if eq get inq_skip_file 0 1
note DRA-440: secrets scanning must never self-exempt spark-inquisitor or constitution.rs
if eq first_c 43
put inq_added 0 add get inq_added 0 1
inq_check_secrets off nlen line_no
end
ret
end

note Check dirty-tree and false-PASS metadata on both audit lines and added diff lines
if ne first_c 45
inq_check_dirty_line off nlen line_no
inq_check_false_pass off nlen line_no
end

note Added diff lines (+) run full content policy checks
if eq first_c 43
put inq_added 0 add get inq_added 0 1
inq_check_secrets off nlen line_no
inq_check_telemetry off nlen line_no
inq_check_stubs off nlen line_no
inq_check_unslop off nlen line_no
end
end

fn inq_scan_input to ulong
inq_reset
total = get inq_in_len 0
h = get inq_hash 0
for k ulong total bound 131072
h = inq_fnv_step h get inq_in k
end
put inq_hash 0 h
pos = ulong 0
line_no = ulong 0
while lt pos total bound 131072
ls = pos
while lt pos total bound 131072
if eq get inq_in pos 10
break
end
pos = add pos 1
end
le_pos = pos
if gt le_pos ls
if eq get inq_in sub le_pos 1 13
le_pos = sub le_pos 1
end
end
line_no = add line_no 1
inq_scan_line ls sub le_pos ls line_no
if lt pos total
pos = add pos 1
end
end
put inq_lines 0 line_no
note Mix verdict and counts into deterministic receipt fingerprint
h = inq_fnv_step get inq_hash 0 uchar and get inq_verdict 0 255
h = inq_fnv_step h uchar and get inq_blocks 0 255
h = inq_fnv_step h uchar and get inq_warns 0 255
put inq_hash 0 h
ret get inq_verdict 0
end

fn inq_out_byte b uchar to void
p = get inq_out_len 0
if lt p INQ_MAX_OUT
put inq_out p b
put inq_out_len 0 add p 1
end
end

fn inq_out_str s view uchar * to void
n = len s
for i ulong n bound 4096
inq_out_byte get s i
end
end

fn inq_out_u64 v ulong to void
if eq v 0
inq_out_byte 48
ret
end
buf = new uchar 24 0
k = ulong 0
x = v
while gt x 0 bound 24
d = rem x 10
put buf k uchar add 48 d
x = div x 10
k = add k 1
end
while gt k 0 bound 24
k = sub k 1
inq_out_byte get buf k
end
end

fn inq_out_hex64 v ulong to void
for i ulong 16
sh = mul sub 15 i 4
nib = and shr v sh 15
inq_out_byte get inq_hex nib
end
end

fn inq_out_sev sev ulong to void
if eq sev SEV_PASS
inq_out_str j_pass
ret
end
if eq sev SEV_WARN
inq_out_str j_warn
ret
end
inq_out_str j_block
end

fn inq_out_rule_name r ulong to void
if eq r RULE_SECRET
inq_out_str rn_secret
ret
end
if eq r RULE_ENV_FILE
inq_out_str rn_env
ret
end
if eq r RULE_PROTECTED_PATH
inq_out_str rn_path
ret

note si/inquisitor/lib.om: pure-Omega automated code gatekeeper and diff/audit scanner
note Faithful port of spark-inquisitor (DiffAuditor + ConstitutionalChecker) plus
note omega-mv governance rules (protected paths, dirty-tree, NOT_RUN-as-PASS, stubs).
note Composed after si/directives/om2.om; no om2 header and no fn main in this unit.

const SEV_PASS ulong 0
const SEV_WARN ulong 1
const SEV_BLOCK ulong 2

const RULE_SECRET ulong 0
const RULE_ENV_FILE ulong 1
const RULE_PROTECTED_PATH ulong 2
const RULE_DIRTY_TREE ulong 3
const RULE_FALSE_PASS ulong 4
const RULE_TELEMETRY ulong 5
const RULE_STUB_HARD ulong 6
const RULE_TODO_WARN ulong 7
const RULE_UNSLOP_WARN ulong 8

const SUB_AWS_KEY ulong 1
const SUB_GH_PAT ulong 2
const SUB_PRIV_KEY ulong 3
const SUB_SECRET_ASSIGN ulong 4
const SUB_ENV_FILE ulong 5
const SUB_PATH_EVIDENCE ulong 6
const SUB_PATH_AIEN ulong 7
const SUB_PATH_GATES ulong 8
const SUB_PATH_CI ulong 9
const SUB_DIRTY_TREE ulong 10
const SUB_FALSE_PASS_INLINE ulong 11
const SUB_FALSE_PASS_RECORD ulong 12
const SUB_TELEM_VENDOR ulong 13
const SUB_TELEM_RAW ulong 14
const SUB_STUB_HARD ulong 15
const SUB_TODO_WARN ulong 16
const SUB_UNSLOP_DASH ulong 17
const SUB_UNSLOP_BUZZ ulong 18
const SUB_PATH_AIEN_TEST ulong 19

const INQ_MAX_IN ulong 131072
const INQ_MAX_OUT ulong 32768
const INQ_MAX_FIND ulong 128

global inq_in uchar 131072
global inq_in_len ulong 1
global inq_out uchar 32768
global inq_out_len ulong 1
global inq_path_off ulong 1
global inq_path_len ulong 1
global inq_a_off ulong 1
global inq_a_len ulong 1
global inq_tmp_off ulong 1
global inq_tmp_len ulong 1
global inq_num_val ulong 1
global inq_num_pos ulong 1
global inq_num_ok ulong 1

global inq_verdict ulong 1
global inq_blocks ulong 1
global inq_warns ulong 1
global inq_files ulong 1
global inq_lines ulong 1
global inq_added ulong 1
global inq_rcnt ulong 16

global inq_find_cnt ulong 1
global inq_find_rule ulong 128
global inq_find_sev ulong 128
global inq_find_line ulong 128
global inq_find_sub ulong 128

global inq_in_bin ulong 1
global inq_in_hunk ulong 1
global inq_hunk_has_cnt ulong 1
global inq_hunk_old ulong 1
global inq_hunk_new ulong 1
global inq_expect_plus ulong 1
global inq_has_git_hdr ulong 1
global inq_in_git_body ulong 1
global inq_skip_file ulong 1
global inq_diff_checked ulong 1
global inq_seen_notrun ulong 1
global inq_seen_pass ulong 1
global inq_rec_flagged ulong 1
global inq_hash ulong 1

text inq_hex "0123456789abcdef"


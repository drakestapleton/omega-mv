if eq s SUB_PATH_CI
inq_out_str sd_ci
ret
end
if eq s SUB_PATH_AIEN_TEST
inq_out_str sd_aient
ret
end
if eq s SUB_DIRTY_TREE
inq_out_str sd_dirty
ret

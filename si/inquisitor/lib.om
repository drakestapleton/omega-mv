text p_dt2 "dirty_tree=true"
text p_dt3 "dirty_tree=1"
text p_dt4 "dirty_tree: 1"
text p_dt5 "git_status: dirty"
text p_dt6 "worktree: dirty"
text p_dt7 "tree_state: dirty"
text p_dt8 "dirty-tree: true"

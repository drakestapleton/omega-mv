note si/inquisitor/test.om: comprehensive test suite for pure-Omega spark-inquisitor
note Composed after si/directives/om2.om and si/inquisitor/lib.om.
note Covers clean patch PASS, deterministic receipt check, WARN rules, and BLOCK negative controls.

text t_pass_pre "PASS "
text t_fail_pre "FAIL "
text t_nl "\n"

text t_c1 "clean_patch_pass_and_determinism"
text t_c2 "block_protected_evidence_path"
text t_c3 "block_protected_aien_path"
text t_c4 "block_protected_gates_path"
text t_c5 "block_secret_aws_key"
text t_c6 "block_secret_ghp_and_pem"
text t_c7 "block_env_file_diff_and_binary"
text t_c8 "block_not_run_labelled_pass_inline"
text t_c9 "block_not_run_labelled_pass_multiline"
text t_c10 "block_dirty_tree_flags"
text t_c11 "block_telemetry_and_negation_guard"
text t_c12 "block_hard_stub_and_warn_soft_todo"
text t_c13 "warn_unslop_dash_and_buzzword_flag_guard"
text t_c14 "pass_removed_lines_only"
text t_c15 "block_secret_in_self_exempt_paths_dra440"
text t_c16 "block_multifile_unified_and_post_bin_patch"
text t_c17 "block_long_ghp_and_long_env_path_no_trap"
text t_c18 "block_in_hunk_plus3_secret_and_dra440"
text t_c19 "block_in_hunk_plus3_self_exempt_smuggle"
text t_c20 "block_in_hunk_minus3_then_plus3_smuggle"
text t_c21 "block_protected_rename_move_and_diff_u_delete"
text t_c22 "block_rename_and_copy_extended_headers"
text t_c23 "block_diff_git_plus_mismatch_and_single_token"
text t_c24 "block_binary_files_delete_and_space_in_path"
text t_c25 "block_over_4200_byte_evidence_paths"
text t_c26 "block_protected_tools_aien_test_path"
text t_c27 "block_post_hunk_and_no_hunk_m3p3_smuggle"
text t_c28 "block_post_body_rename_and_dev_null_skip"
text t_c29 "block_quoted_and_ambiguous_diff_and_bin"
text t_c30 "block_git_octal_escaped_protected_paths"
text t_all_ok "INQUISITOR TESTS PASS (30/30)\n"
text t_all_fail "INQUISITOR TESTS FAILED\n"

text s_clean "diff --git a/src/math.om b/src/math.om\n+++ b/src/math.om\n+fn add_pair a ulong b ulong to ulong\n+ret add a b\n+end\n"
text s_evid "diff --git a/evidence/seed.abc123.json b/evidence/seed.abc123.json\n+++ b/evidence/seed.abc123.json\n+{\"verdict\":\"PASS\"}\n"
text s_aien "diff --git a/.aien/always b/.aien/always\n+++ b/.aien/always\n+OMEGA-SKIP\n"
text s_gates "diff --git a/tests/gates/seed.gate b/tests/gates/seed.gate\n+++ b/tests/gates/seed.gate\n+cmd: true\n"
text s_aws "diff --git a/src/config.om b/src/config.om\n+++ b/src/config.om\n+text k \"AKIA1234567890ABCDEF\"\n"
text s_gh_pem "diff --git a/src/auth.om b/src/auth.om\n+++ b/src/auth.om\n+text t \"ghp_abcdefghijklmnopqrstuvwxyz0123456789\"\n+text p \"-----BEGIN RSA PRIVATE KEY-----\"\n"
text s_env "diff --git a/.env b/.env\n+++ b/.env\n+SECRET_KEY=hunter2\nBinary files /dev/null and b/.env.local differ\n"
text s_nr_inl "GATE: OMEGA-SILICON\nVERDICT: PASS (NOT_RUN)\n"
text s_nr_ml "GATE: OMEGA-GB10\nTESTS_RUN: 0\nGATE_STATE: NOT_RUN\nVERDICT: PASS\n"
text s_dirty "AUDIT_HEADER\nDIRTY_TREE: true\nGIT_STATUS: dirty\n"
text s_telem "diff --git a/src/net.om b/src/net.om\n+++ b/src/net.om\n+note send_telemetry to google-analytics.com\n"
text s_tel_ok "diff --git a/src/net.om b/src/net.om\n+++ b/src/net.om\n+note zero-telemetry sovereign transport\n"
text s_stub_h "diff --git a/src/core.om b/src/core.om\n+++ b/src/core.om\n+note STUB_ONLY unimplemented!()\n"
text s_todo_w "diff --git a/src/core.om b/src/core.om\n+++ b/src/core.om\n+note TODO: refine bound estimate\n"
text s_buzz "diff --git a/src/doc.om b/src/doc.om\n+++ b/src/doc.om\n+note this is a game-changer\n"
text s_flag_ok "diff --git a/src/cli.om b/src/cli.om\n+++ b/src/cli.om\n+note support --unleash and --elevate flags\n"
text s_removed "diff --git a/src/old.om b/src/old.om\n+++ b/src/old.om\n-text k \"AKIA1234567890ABCDEF\"\n-note send_telemetry mixpanel\n+note removed old secrets\n"
text s_dra440_inq "diff --git a/crates/spark-inquisitor/src/audit.rs b/crates/spark-inquisitor/src/audit.rs\n+++ b/crates/spark-inquisitor/src/audit.rs\n+let leaked = \"ghp_abcdefghijklmnopqrstuvwxyz0123456789\";\n"
text s_dra440_con "diff --git a/src/constitution.rs b/src/constitution.rs\n+++ b/src/constitution.rs\n+const LEAK: &str = \"AKIA1234567890ABCDEF\";\n"
text s_dra440_ok "diff --git a/crates/spark-inquisitor/src/audit.rs b/crates/spark-inquisitor/src/audit.rs\n+++ b/crates/spark-inquisitor/src/audit.rs\n+const PAT: &str = \"google-analytics\";\n"
text s_mf_env "--- a/src/ok.om\t2026-11-18\n+++ b/src/ok.om\t2026-11-18\n+note ok\n--- a/.env\t2026-11-18\n+++ b/.env\t2026-11-18\n+FOO=bar\n"
text s_bin_sec "diff --git a/foo.bin b/foo.bin\nGIT binary patch\nliteral 1\n\n--- a/src/auth.om\n+++ b/src/auth.om\n+text k \"AKIA1234567890ABCDEF\"\n"
text s_ghp_pre "diff --git a/src/tok.om b/src/tok.om\n+ghp_"
text s_env_pre "diff --git a/x b/"
text s_env_suf ".env\n+X=1\n"
text s_hunk_p3 "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,2 @@\n ok\n+++ AKIA1234567890ABCDEF\n"
text s_hunk_p3_dra "diff --git a/crates/spark-inquisitor/src/audit.rs b/crates/spark-inquisitor/src/audit.rs\n--- a/crates/spark-inquisitor/src/audit.rs\n+++ b/crates/spark-inquisitor/src/audit.rs\n@@ -1,1 +1,2 @@\n ok\n+++ AKIA1234567890ABCDEF\n"
text s_hunk_p3_ex "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,3 @@\n ok\n+++ spark-inquisitor\n+note send_telemetry to google-analytics.com\n"
text s_hunk_m3p3_g "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,1 @@\n--- foo\n+++ AKIA1234567890ABCDEF\n"
text s_hunk_m3p3_u "--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,1 @@\n--- foo\n+++ AKIA1234567890ABCDEF\n"
text s_mv_evid "diff --git a/evidence/foo.json b/src/foo.json\n--- a/evidence/foo.json\n+++ b/src/foo.json\n+note moved\n"
text s_del_evid "--- a/evidence/r.json\n+++ /dev/null\n@@ -1,1 +0,0 @@\n-old\n"
text s_ren_hdr "rename from evidence/a.json\nrename to src/a.json\n"
text s_cpy_hdr "copy from evidence/a.json\ncopy to src/a.json\n"
text s_mis_env "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/.env\n+FOO=1\n"
text s_sng_env "diff --git a/src/ok.om\n+++ b/.env\n+FOO=1\n"
text s_bin_del "Binary files a/evidence/r.bin and /dev/null differ\n"
text s_bin_spc "Binary files a/my dir/ok.bin and b/.env differ\n"
text s_long_dg_a "diff --git a/evidence/"
text s_long_dg_b "/x.json b/evidence/"
text s_long_dg_c "/x.json\n+ok\n"
text s_long_fl_a "FILE: evidence/"
text s_long_fl_b "/x.json\n"
text s_aien_test "diff --git a/tools/aien-test/foo.sh b/tools/aien-test/foo.sh\n--- a/tools/aien-test/foo.sh\n+++ b/tools/aien-test/foo.sh\n+echo hi\n"
text s_smug_nohk "--- a/src/ok.om\n+++ b/src/ok.om\n+ok\n--- foo\n+++ AKIA1234567890ABCDEF\n"
text s_smug_zero "--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,0 +1,0 @@\n--- foo\n+++ AKIA1234567890ABCDEF\n"
text s_smug_bak "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,1 @@\n-old\n+new\n--- a/x\n+++ b/AKIA1234567890ABCDEF\n"
text s_smug_idx "--- a/src/ok.om\nindex 1234567..89abcdef 100644\n+++ AKIA1234567890ABCDEF\n"
text s_smug_dty "--- foo\n+++ DIRTY_TREE: true\n"
text s_smug_ex "--- a/src/ok.om\n+++ b/src/ok.om\n+ok\n--- foo\n+++ spark-inquisitor\n+note send_telemetry to google-analytics.com\n"
text s_post_ren "diff --git a/src/ok.om b/src/ok.om\n--- a/src/ok.om\n+++ b/src/ok.om\n@@ -1,1 +1,1 @@\n ok\nrename from evidence/a.json\nrename to src/a.json\n"
text s_devn_skp "diff --git a/crates/spark-inquisitor/src/audit.rs b/crates/spark-inquisitor/src/audit.rs\n--- a/crates/spark-inquisitor/src/audit.rs\n+++ b/crates/spark-inquisitor/src/audit.rs\n@@ -1,1 +1,1 @@\n-old\n+new\n--- a/src/evil.om\n+++ /dev/null\n+note send_telemetry to google-analytics.com\n"
text s_dg_spb "diff --git a/my b/dir/.env b/src/ok.om\n"
text s_dg_qspb "diff --git \"a/my b/dir/.env\" \"b/src/ok.om\"\n"
text s_bin_qand "Binary files \"a/my and dir/.env\" and \"b/src/ok.bin\" differ\n"
text s_bin_andb "Binary files a/foo and b/bar/.env and b/src/ok.bin differ\n"
text s_bin_npand "Binary files a/my and dir/.env and src/ok.bin differ\n"
text s_oct_dg "diff --git \"a/\\145vidence/foo.json\" \"b/\\145vidence/foo.json\"\n"
text s_oct_env "diff --git \"a/\\056env\" \"b/\\056env\"\n"
text s_oct_bin "Binary files \"a/\\145vidence/r.bin\" and /dev/null differ\n"
text s_oct_ren "rename from \"\\145vidence/a.json\"\n"
text s_oct_fl "FILE: \"\\056env\"\n"
text s_oct_p3 "--- a/src/ok.om\n+++ \"b/\\056env\"\n"

text chk_v_pass "\"verdict\":\"PASS\""
text chk_v_warn "\"verdict\":\"WARN\""
text chk_v_block "\"verdict\":\"BLOCK\""
text chk_fp "\"fingerprint\":\""

global t_fails ulong 1
global t_snap uchar 4096
global t_snap_len ulong 1

fn t_print s view uchar * to void
k = write 1 s 0 len s
if lt k 0
exit 2
end
end

fn t_report name view uchar * ok bool to void
if ok
t_print t_pass_pre
else
t_print t_fail_pre
put t_fails 0 add get t_fails 0 1
end
t_print name
t_print t_nl
end

fn t_out_contains pat view uchar * to bool
olen = get inq_out_len 0
pl = len pat
if lt olen pl
ret false
end
lim = add sub olen pl 1
for i ulong lim bound 32768
ok = true
for j ulong pl bound 128
if ne get inq_out add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn run_case_clean to bool
n1 = inq_load_text s_clean
if eq n1 0
ret false
end
v1 = inq_scan_input
r1 = inq_format_receipt
if ne v1 SEV_PASS
ret false
end
if ne get inq_blocks 0 0
ret false
end
if ne get inq_warns 0 0
ret false
end
if not t_out_contains chk_v_pass
ret false
end
if not t_out_contains chk_fp
ret false
end
if gt r1 4096
ret false
end
for i ulong r1 bound 4096
put t_snap i get inq_out i
end
put t_snap_len 0 r1
h1 = get inq_hash 0
n2 = inq_load_text s_clean
if ne n2 n1
ret false
end
v2 = inq_scan_input
r2 = inq_format_receipt
if or ne v2 SEV_PASS ne r2 get t_snap_len 0
ret false
end
if ne get inq_hash 0 h1
ret false
end
for j ulong r2 bound 4096
if ne get inq_out j get t_snap j
ret false
end
end
ret true
end

fn run_case_dash_and_buzz to bool
n = inq_load_text s_buzz
note Append an added line containing raw UTF-8 em-dash (0xe2 0x80 0x94)
put inq_in n 43
put inq_in add n 1 97
put inq_in add n 2 226
put inq_in add n 3 128
put inq_in add n 4 148
put inq_in add n 5 98
put inq_in add n 6 10
put inq_in_len 0 add n 7
v = inq_scan_input
r = inq_format_receipt
if eq r 0
ret false
end
if ne v SEV_WARN
ret false
end
if ne get inq_blocks 0 0
ret false
end
if lt get inq_rcnt RULE_UNSLOP_WARN 2
ret false
end
if not t_out_contains chk_v_warn
ret false
end
note Verify --unleash and --elevate CLI flags do not false-positive
n2 = inq_load_text s_flag_ok
if eq n2 0
ret false
end
v2 = inq_scan_input
ret eq v2 SEV_PASS
end

fn t_expect_rule src view uchar * want_v ulong rule ulong min_c ulong to bool
n = inq_load_text src
if eq n 0
ret false
end
v = inq_scan_input
if ne v want_v
ret false
end
ret ge get inq_rcnt rule min_c
end

fn run_case_evid to bool
n = inq_load_text s_evid
if eq n 0
ret false
end
v = inq_scan_input
r = inq_format_receipt
if or eq r 0 ne v SEV_BLOCK
ret false
end
if lt get inq_rcnt RULE_PROTECTED_PATH 1
ret false
end
ret t_out_contains chk_v_block
end

fn run_case_env to bool
n = inq_load_text s_env
if eq n 0
ret false
end
v = inq_scan_input
if ne v SEV_BLOCK
ret false
end
if lt get inq_rcnt RULE_ENV_FILE 2
ret false
end
ret ge get inq_rcnt RULE_SECRET 1
end

fn run_case_telem to bool
if not t_expect_rule s_telem SEV_BLOCK RULE_TELEMETRY 1
ret false
end
n = inq_load_text s_tel_ok
if eq n 0
ret false
end
v = inq_scan_input
ret eq v SEV_PASS
end

fn run_case_stubs to bool
if not t_expect_rule s_stub_h SEV_BLOCK RULE_STUB_HARD 1
ret false
end
ret t_expect_rule s_todo_w SEV_WARN RULE_TODO_WARN 1
end

fn run_case_dra440 to bool
n1 = inq_load_text s_dra440_inq
if eq n1 0
ret false
end
v1 = inq_scan_input
r1 = inq_format_receipt
if or eq r1 0 ne v1 SEV_BLOCK
ret false
end
if lt get inq_rcnt RULE_SECRET 1
ret false
end
if not t_out_contains chk_v_block
ret false
end
if not t_expect_rule s_dra440_con SEV_BLOCK RULE_SECRET 1
ret false
end
n3 = inq_load_text s_dra440_ok
if eq n3 0
ret false
end
v3 = inq_scan_input
ret eq v3 SEV_PASS
end

fn run_case_mf_and_bin to bool
if not t_expect_rule s_mf_env SEV_BLOCK RULE_ENV_FILE 1
ret false
end
ret t_expect_rule s_bin_sec SEV_BLOCK RULE_SECRET 1
end

fn run_case_long_inputs to bool
n = inq_load_text s_ghp_pre
for i ulong 300
put inq_in add n i 97
end
put inq_in add n 300 10
put inq_in_len 0 add n 301
v1 = inq_scan_input
if or ne v1 SEV_BLOCK lt get inq_rcnt RULE_SECRET 1
ret false
end
m = inq_load_text s_env_pre
for j ulong 150
put inq_in add m mul j 2 100
put inq_in add m add mul j 2 1 47
end
pos = add m 300
for k ulong len s_env_suf bound 32
put inq_in add pos k get s_env_suf k
end
put inq_in_len 0 add pos len s_env_suf
v2 = inq_scan_input
if or ne v2 SEV_BLOCK lt get inq_rcnt RULE_ENV_FILE 1
ret false
end
ret true
end

fn run_case_hunk_p3 to bool
if not t_expect_rule s_hunk_p3 SEV_BLOCK RULE_SECRET 1
ret false
end
ret t_expect_rule s_hunk_p3_dra SEV_BLOCK RULE_SECRET 1
end

fn run_case_hunk_m3p3 to bool
if not t_expect_rule s_hunk_m3p3_g SEV_BLOCK RULE_SECRET 1

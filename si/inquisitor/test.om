fn run_case_octal_paths to bool
if not t_expect_rule s_oct_dg SEV_BLOCK RULE_PROTECTED_PATH 1
ret false
end
if not t_expect_rule s_oct_env SEV_BLOCK RULE_ENV_FILE 1
ret false
end
if not t_expect_rule s_oct_bin SEV_BLOCK RULE_PROTECTED_PATH 1
ret false
end
if not t_expect_rule s_oct_ren SEV_BLOCK RULE_PROTECTED_PATH 1
ret false
end
if not t_expect_rule s_oct_fl SEV_BLOCK RULE_ENV_FILE 1

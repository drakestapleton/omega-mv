fn main to int
put t_fails 0 0

t_report t_c1 run_case_clean
t_report t_c2 run_case_evid
t_report t_c3 t_expect_rule s_aien SEV_BLOCK RULE_PROTECTED_PATH 1
t_report t_c4 t_expect_rule s_gates SEV_BLOCK RULE_PROTECTED_PATH 1
t_report t_c5 t_expect_rule s_aws SEV_BLOCK RULE_SECRET 1
t_report t_c6 t_expect_rule s_gh_pem SEV_BLOCK RULE_SECRET 2
t_report t_c7 run_case_env
t_report t_c8 t_expect_rule s_nr_inl SEV_BLOCK RULE_FALSE_PASS 1
t_report t_c9 t_expect_rule s_nr_ml SEV_BLOCK RULE_FALSE_PASS 1
t_report t_c10 t_expect_rule s_dirty SEV_BLOCK RULE_DIRTY_TREE 2
t_report t_c11 run_case_telem
t_report t_c12 run_case_stubs
t_report t_c13 run_case_dash_and_buzz
t_report t_c14 t_expect_rule s_removed SEV_PASS RULE_SECRET 0
t_report t_c15 run_case_dra440
t_report t_c16 run_case_mf_and_bin
t_report t_c17 run_case_long_inputs
t_report t_c18 run_case_hunk_p3
t_report t_c19 t_expect_rule s_hunk_p3_ex SEV_BLOCK RULE_TELEMETRY 1
t_report t_c20 run_case_hunk_m3p3
t_report t_c21 run_case_rename_del
t_report t_c22 run_case_ext_hdrs
t_report t_c23 run_case_mismatch_single
t_report t_c24 run_case_bin_edge

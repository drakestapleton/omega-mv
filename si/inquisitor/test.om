fn run_case_bin_edge to bool
if not t_expect_rule s_bin_del SEV_BLOCK RULE_PROTECTED_PATH 1
ret false
end
ret t_expect_rule s_bin_spc SEV_BLOCK RULE_ENV_FILE 1
end

fn t_append_in pos ulong s view uchar * to ulong
n = len s
for i ulong n bound 128
put inq_in add pos i get s i
end
ret add pos n
end

fn run_case_long_evid to bool
p = ulong 0
p = t_append_in p s_long_dg_a
for i ulong 4200
put inq_in add p i 97
end
p = add p 4200
p = t_append_in p s_long_dg_b
for j ulong 4200
put inq_in add p j 97
end
p = add p 4200
p = t_append_in p s_long_dg_c
put inq_in_len 0 p
v1 = inq_scan_input
if or ne v1 SEV_BLOCK lt get inq_rcnt RULE_PROTECTED_PATH 1
ret false
end
q = ulong 0
q = t_append_in q s_long_fl_a
for k ulong 4200
put inq_in add q k 97
end
q = add q 4200
q = t_append_in q s_long_fl_b
put inq_in_len 0 q
v2 = inq_scan_input
if or ne v2 SEV_BLOCK lt get inq_rcnt RULE_PROTECTED_PATH 1
ret false
end
ret true
end

fn run_case_smuggle_ext to bool
if not t_expect_rule s_smug_nohk SEV_BLOCK RULE_SECRET 1
ret false
end
if not t_expect_rule s_smug_zero SEV_BLOCK RULE_SECRET 1
ret false
end
if not t_expect_rule s_smug_bak SEV_BLOCK RULE_SECRET 1
ret false
end
if not t_expect_rule s_smug_idx SEV_BLOCK RULE_SECRET 1
ret false
end
if not t_expect_rule s_smug_dty SEV_BLOCK RULE_DIRTY_TREE 1
ret false
end
ret t_expect_rule s_smug_ex SEV_BLOCK RULE_TELEMETRY 1
end


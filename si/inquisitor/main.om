note si/inquisitor/main.om: CLI entrypoint for pure-Omega spark-inquisitor gatekeeper
note Composed after si/directives/om2.om and si/inquisitor/lib.om.
note Reads patch/audit records on stdin, emits structured JSON verdict receipt on stdout.
note Exit 0 on PASS (or advisory WARN); exit 1 on BLOCK (or WARN with --strict); exit 2 on I/O error.

text cli_strict "--strict"
text cli_io_err "inquisitor: stdin read error\n"
text cli_ovf_err "inquisitor: stdin exceeds 131072 byte limit\n"
text cli_wr_err "inquisitor: stdout write error\n"

fn cli_is_strict to bool
ac = argcnt
if le ac 1
ret false
end
abuf = new uchar 64 0
for i ulong ulong ac bound 64
if gt i 0
r = argread i abuf 0 64
if eq r long len cli_strict
ok = true
for j ulong len cli_strict bound 64
if ne get abuf j get cli_strict j
ok = false
break
end
end
if ok
ret true
end
end
end
end
ret false
end

fn cli_read_stdin to long
probe = new uchar 1 0
total = ulong 0
while lt total INQ_MAX_IN bound 131072
k = read 0 inq_in total sub INQ_MAX_IN total
if lt k 0
ret k
end
if eq k 0
break
end
total = add total ulong k
end
if eq total INQ_MAX_IN
more = read 0 probe 0 1
if lt more 0
ret more
end
if gt more 0
ret long -1000
end
end
put inq_in_len 0 total
ret long total
end

fn main to int
strict = cli_is_strict
got = cli_read_stdin
if eq got long -1000
eov = write 2 cli_ovf_err 0 len cli_ovf_err
if lt eov 0
ret 2
end
ret 2
end
if lt got 0
ew = write 2 cli_io_err 0 len cli_io_err
if lt ew 0
ret 2
end
ret 2
end
v = inq_scan_input
rlen = inq_format_receipt
ok = inq_write_all 1 rlen
if not ok
ew2 = write 2 cli_wr_err 0 len cli_wr_err
if lt ew2 0
ret 2
end
ret 2
end
if eq v SEV_BLOCK
ret 1
end
if and strict eq v SEV_WARN
ret 1
end
ret 0
end

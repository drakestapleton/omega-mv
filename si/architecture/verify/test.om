note SPDX-License-Identifier: Apache-2.0
note si/architecture/verify/test.om: positive & negative control test suite for
note aien-architecture-mv authority, capability register, and invariant verification engine.
note Compose with:
note   si/directives/om2.om om/tls/sha2.om si/architecture/verify/authority.om si/architecture/verify/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"

text t_c1 "adr_id_parsing_and_supersession_cycle_controls"
text t_c2 "plan_authority_and_release_qualification_controls"
text t_c3 "capability_register_language_and_dirty_tree_controls"
text t_c4 "capability_register_emulator_vs_hardware_qualification"
text t_c5 "layer_dependency_monotonicity_and_inversion_controls"
text t_c6 "evidence_immutability_additions_only_controls"
text t_c7 "authority_record_digest_determinism_and_sensitivity"
text t_done "PASS aien-architecture-verify all 7 test suites passed\n"

text t_adr_ok "ADR-0047"
text t_adr_zero "ADR-0000"
text t_adr_badpfx "RFC-0047"
text t_adr_short "ADR-47"
text t_adr_alpha "ADR-004a"

text t_sha40_a "3a9fe6de80123456789abcdef0123456789abcde"
text t_sha40_b "0811840af0123456789abcdef0123456789abcde"
text t_sha40_bad "3a9fe6de8"
text t_sha64_ok "34d611ca0415eab1728d3234911d90e74af17ba9ab0c581d559f48274d7ca6d3"
text t_sha64_bad "zzzz11ca0415eab1728d3234911d90e74af17ba9ab0c581d559f48274d7ca6d3"

fn report_case name view uchar * ok bool to int
if ok
w1 = arch_write_all int 1 t_pass
w2 = arch_write_all int 1 name
w3 = arch_write_all int 1 t_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = arch_write_all int 1 t_fail
w5 = arch_write_all int 1 name
w6 = arch_write_all int 1 t_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_adr_ids to bool
if ne arch_parse_adr_id t_adr_ok long 47
ret false
end
note Negative controls: ADR-0000, wrong prefix, short, non-digit
if ne arch_parse_adr_id t_adr_zero long -1
ret false
end
if ne arch_parse_adr_id t_adr_badpfx long -1
ret false
end
if ne arch_parse_adr_id t_adr_short long -1
ret false
end
if ne arch_parse_adr_id t_adr_alpha long -1
ret false
end
note Valid ACCEPTED ADR and valid forward supersession (47 -> 52)
if ne arch_validate_adr t_adr_ok AUTH_ACCEPTED ulong 0 ARCH_OK
ret false
end
if ne arch_validate_adr t_adr_ok AUTH_SUPERSEDED ulong 52 ARCH_OK
ret false
end
note Negative controls: self-supersession (47 -> 47), backward supersession (47 -> 10), nonzero superseded_by on ACCEPTED
if ne arch_validate_adr t_adr_ok AUTH_SUPERSEDED ulong 47 ARCH_ERR_CYCLE_SUPERSEDE
ret false
end
if ne arch_validate_adr t_adr_ok AUTH_SUPERSEDED ulong 10 ARCH_ERR_CYCLE_SUPERSEDE
ret false
end
if ne arch_validate_adr t_adr_ok AUTH_ACCEPTED ulong 52 ARCH_ERR_CYCLE_SUPERSEDE
ret false
end
ret true
end

fn test_release_authority to bool
if not arch_adr_is_binding AUTH_ACCEPTED
ret false
end
if arch_adr_is_binding AUTH_PROPOSED
ret false
end
if arch_adr_is_binding AUTH_SUPERSEDED
ret false
end
if ne arch_check_release_authority AUTH_ACCEPTED t_sha40_a false ARCH_OK
ret false
end
note Negative controls: PROPOSED plan != qualified release, dirty tree refused, bad commit SHA refused
if ne arch_check_release_authority AUTH_PROPOSED t_sha40_a false ARCH_ERR_UNQUALIFIED_REL
ret false
end
if ne arch_check_release_authority AUTH_ACCEPTED t_sha40_a true ARCH_ERR_DIRTY_TREE
ret false
end
if ne arch_check_release_authority AUTH_ACCEPTED t_sha40_bad false ARCH_ERR_BAD_SHA
ret false
end
ret true
end

fn test_cap_lang_and_dirty to bool
if ne arch_verify_cap_lang true LANG_OMEGA ARCH_OK
ret false
end
note Negative controls: new C or Rust capability must be refused
if ne arch_verify_cap_lang true LANG_C_LEGACY ARCH_ERR_NON_OMEGA_NEW
ret false
end
if ne arch_verify_cap_lang true LANG_RUST_LEGACY ARCH_ERR_NON_OMEGA_NEW
ret false
end
note Existing legacy capability tracked for migration is allowed
if ne arch_verify_cap_lang false LANG_C_LEGACY ARCH_OK
ret false
end
note Dirty tree refused even for PLANNED capability
if ne arch_verify_cap_hw CAP_PLANNED HW_HOST_EMULATOR true ARCH_ERR_DIRTY_TREE
ret false
end
ret true
end

fn test_cap_hw_qualification to bool
note Host/emulator pass is valid for CAP_VERIFIED
if ne arch_verify_cap_hw CAP_VERIFIED HW_HOST_EMULATOR false ARCH_OK
ret false
end
if ne arch_verify_cap_receipts CAP_VERIFIED t_sha40_a t_sha64_ok ARCH_OK
ret false
end
note GB10 and bare_metal are valid for CAP_QUALIFIED_HW
if ne arch_verify_cap_hw CAP_QUALIFIED_HW HW_GB10 false ARCH_OK
ret false
end
if ne arch_verify_cap_hw CAP_QUALIFIED_HW HW_BARE_METAL false ARCH_OK
ret false
end
note Negative controls: emulator CANNOT claim CAP_QUALIFIED_HW; missing/bad receipt or SHA refused
if ne arch_verify_cap_hw CAP_QUALIFIED_HW HW_HOST_EMULATOR false ARCH_ERR_EMULATOR_AS_HW
ret false
end
if ne arch_verify_cap_receipts CAP_VERIFIED t_sha40_a t_sha64_bad ARCH_ERR_MISSING_RECEIPT
ret false
end
if ne arch_verify_cap_receipts CAP_VERIFIED t_sha40_bad t_sha64_ok ARCH_ERR_BAD_SHA
ret false
end
ret true
end

fn test_layer_deps to bool
if ne arch_layer_dep_check LAYER_APPS LAYER_PROTOCOL ARCH_OK
ret false
end
if ne arch_layer_dep_check LAYER_CORE LAYER_SEED ARCH_OK
ret false
end
if ne arch_layer_dep_check LAYER_PROTOCOL LAYER_PROTOCOL ARCH_OK
ret false
end
note Negative controls: lower layer depending on higher layer is a layer inversion
if ne arch_layer_dep_check LAYER_SEED LAYER_PROTOCOL ARCH_ERR_LAYER_INVERSION
ret false
end
if ne arch_layer_dep_check LAYER_AIENUX LAYER_APPS ARCH_ERR_LAYER_INVERSION
ret false
end
if ne arch_layer_dep_check ulong 99 LAYER_SEED ARCH_ERR_BAD_LAYER
ret false
end
ret true
end

fn test_evidence_immutability to bool
if ne arch_evidence_op_check EV_OP_ADD ARCH_OK
ret false
end
if ne arch_evidence_op_check EV_OP_MODIFY ARCH_ERR_EVIDENCE_MUTATION
ret false
end
if ne arch_evidence_op_check EV_OP_RENAME ARCH_ERR_EVIDENCE_MUTATION
ret false
end
if ne arch_evidence_op_check EV_OP_DELETE ARCH_ERR_EVIDENCE_MUTATION
ret false
end
ret true
end

fn test_record_digest to bool
d1 = new uchar 32 0
d2 = new uchar 32 0
arch_record_digest ulong 47 AUTH_ACCEPTED CAP_QUALIFIED_HW t_sha40_a d1
arch_record_digest ulong 47 AUTH_ACCEPTED CAP_QUALIFIED_HW t_sha40_a d2
if not arch_digest_eq d1 d2
ret false
end
arch_record_digest ulong 47 AUTH_ACCEPTED CAP_QUALIFIED_HW t_sha40_b d2
if arch_digest_eq d1 d2
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_c1 test_adr_ids
fail = add fail report_case t_c2 test_release_authority
fail = add fail report_case t_c3 test_cap_lang_and_dirty
fail = add fail report_case t_c4 test_cap_hw_qualification
fail = add fail report_case t_c5 test_layer_deps
fail = add fail report_case t_c6 test_evidence_immutability
fail = add fail report_case t_c7 test_record_digest
if ne fail int 0
ret int 1
end
ok = arch_write_all int 1 t_done
if not ok
ret int 1
end
ret int 0
end

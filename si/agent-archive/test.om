note agent-archive unit tests: SHA-256 NIST vectors, FNV-1a dedup, privacy & redaction,
note hash-chain linking, and tamper detection negative controls.
note Compose: si/directives/om2.om + si/agent-archive/lib.om + si/agent-archive/test.om

text aa_ts_pass "PASS "
text aa_ts_fail "FAIL "
text aa_ts_nl "\n"
text aa_ts_ok "SUMMARY agent-archive PASS all=8 fail=0\n"
text aa_ts_bad "SUMMARY agent-archive FAIL\n"

text aa_tn_1 "sha256_nist_vectors"
text aa_tn_2 "sha256_multiblock"
text aa_tn_3 "fnv_dedup_and_privacy_mode"
text aa_tn_4 "secret_redaction_filter"
text aa_tn_5 "private_record_export_refusal"
text aa_tn_6 "hash_chain_build_and_verify"
text aa_tn_7 "tamper_detect_payload_flip"
text aa_tn_8 "tamper_detect_broken_link_and_rollback"

text aa_v_empty ""
text aa_v_empty_sha "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
text aa_v_abc "abc"
text aa_v_abc_sha "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
text aa_v_multi "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
text aa_v_multi_sha "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"

text aa_bad_agent "../records"
text aa_sec_in "Auth Bearer tok12345 and ghp_abc999xyz and password=mysecret123 ok"
text aa_sec_exp "Auth Bearer [REDACTED] and [REDACTED] and password=[REDACTED] ok"
text aa_clean_in "Pure Omega build succeeded with zero warnings."

text aa_m1 "Check the live Spark build."
text aa_m2 "Running with Bearer secret_token_99 now."
text aa_m3 "Private draft notes do not export."
text aa_chk_redacted "[REDACTED]"
text aa_chk_secret "secret_token_99"

fn aa_t_print s view uchar * to void
k = write 1 s 0 len s
if lt k 0
exit 2
end
end

fn aa_t_report name view uchar * ok bool to int
if ok
aa_t_print aa_ts_pass
aa_t_print name
aa_t_print aa_ts_nl
ret 0
end
aa_t_print aa_ts_fail
aa_t_print name
aa_t_print aa_ts_nl
ret 1
end

fn aa_t_contains hay view uchar * ned view uchar * to bool
hl = len hay
nl = len ned
if eq nl 0
ret true
end
if lt hl nl
ret false
end
lim = add sub hl nl 1
i = ulong 0
while lt i lim bound 4096
if aa_eq_bytes part hay i nl ned
ret true
end
i = add i 1
end
ret false
end

fn aa_t_sha_nist to bool
d1 = new uchar 32 0
h1 = new uchar 64 0
aa_sha256 part aa_v_empty 0 0 d1
aa_hex_encode d1 h1
if not aa_eq_bytes h1 aa_v_empty_sha
ret false
end
d2 = new uchar 32 0
h2 = new uchar 64 0
aa_sha256 aa_v_abc d2
aa_hex_encode d2 h2
ret aa_eq_bytes h2 aa_v_abc_sha
end

fn aa_t_sha_multi to bool
d = new uchar 32 0
h = new uchar 64 0
aa_sha256 aa_v_multi d
aa_hex_encode d h
ret aa_eq_bytes h aa_v_multi_sha
end

fn aa_t_dedup_priv to bool
k1 = aa_record_dedup_key AA_AGENT_CLAUDE AA_ROLE_USER 0 aa_m1
k2 = aa_record_dedup_key AA_AGENT_CLAUDE AA_ROLE_USER 0 aa_m1
k3 = aa_record_dedup_key AA_AGENT_CLAUDE AA_ROLE_USER 1 aa_m1
if ne k1 k2
ret false
end
if eq k1 k3
ret false
end
if ge aa_parse_agent aa_bad_agent 0
ret false
end
if ne aa_parse_agent aa_t_ag_omp long AA_AGENT_OMP
ret false
end
if not aa_path_is_private 1000 1000 384 false
ret false
end
if aa_path_is_private 1000 1000 420 false
ret false
end
if aa_path_is_private 1000 1001 384 false
ret false
end
if aa_path_is_private 1000 1000 384 true
ret false
end
ret true
end

fn aa_t_redaction to bool
dst = new uchar 512 0
n1 = aa_redact_text aa_sec_in dst
if lt n1 0
ret false
end
if not aa_eq_bytes part dst 0 ulong n1 aa_sec_exp
ret false
end
n2 = aa_redact_text aa_clean_in dst
if lt n2 0
ret false
end
ret aa_eq_bytes part dst 0 ulong n2 aa_clean_in
end

fn aa_t_append_helper meta edit AaArchiveMeta entries edit ulong 288 hashes edit uchar 4096 text_buf edit uchar 4096 to bool
r = new AaChainEntry 0 1000 AA_AGENT_CLAUDE AA_ROLE_USER 0 0 0 0 0
if ne aa_stage_record meta r aa_m1 text_buf 0
ret false
end
if ne aa_commit_record meta r entries 0
ret false
end
if not aa_link_record 0 r hashes text_buf
ret false
end
r2 = new AaChainEntry 0 2000 AA_AGENT_CLAUDE AA_ROLE_ASSISTANT 0 64 0 0 0
if ne aa_stage_record meta r2 aa_m2 text_buf 0
ret false
end
if ne aa_commit_record meta r2 entries 0
ret false
end
if not aa_link_record 1 r2 hashes text_buf
ret false
end
r3 = new AaChainEntry 0 3000 AA_AGENT_CODEX AA_ROLE_USER 1 128 0 0 0
if ne aa_stage_record meta r3 aa_m3 text_buf 0
ret false
end
if ne aa_commit_record meta r3 entries 0
ret false
end
ret aa_link_record 2 r3 hashes text_buf
end

fn aa_t_private_export to bool
meta = new AaArchiveMeta 0 0 0
entries = new ulong 288 0
hashes = new uchar 4096 0
text_buf = new uchar 4096 0
if not aa_t_append_helper meta entries hashes text_buf
ret false
end
rec = new AaChainEntry 0 0 0 0 0 0 0 0 0
outln = new uchar 2048 0
note Record 2 is private: default export MUST refuse (-2).
aa_load_entry entries 2 rec
n_priv = aa_export_jsonl rec hashes text_buf false outln
if ne n_priv -2
ret false
end
note Explicit allow_private=true permits export.
n_allow = aa_export_jsonl rec hashes text_buf true outln
if le n_allow 0
ret false
end
note Record 1 is public with secret: exported JSONL MUST redact secret.
aa_load_entry entries 1 rec
n_pub = aa_export_jsonl rec hashes text_buf false outln
if le n_pub 0
ret false
end
if not aa_t_contains part outln 0 ulong n_pub aa_chk_redacted
ret false
end
if aa_t_contains part outln 0 ulong n_pub aa_chk_secret
ret false
end
ret true
end

fn aa_t_chain_verify to bool
meta = new AaArchiveMeta 0 0 0
entries = new ulong 288 0
hashes = new uchar 4096 0
text_buf = new uchar 4096 0
if not aa_t_append_helper meta entries hashes text_buf
ret false
end
if ne aa_verify_chain get meta cnt entries hashes text_buf 0
ret false
end
note Negative control: duplicate dedup_key is skipped (returns 1, cnt unchanged).
dup = new AaChainEntry 0 4000 AA_AGENT_CLAUDE AA_ROLE_USER 0 0 0 0 0
if ne aa_stage_record meta dup aa_m1 text_buf 0
ret false
end
if ne aa_commit_record meta dup entries 1
ret false
end
ret eq get meta cnt 3
end

fn aa_t_tamper_payload to bool
meta = new AaArchiveMeta 0 0 0
entries = new ulong 288 0
hashes = new uchar 4096 0
text_buf = new uchar 4096 0
if not aa_t_append_helper meta entries hashes text_buf
ret false
end
note Flip 1 byte in record 0 text payload -> verifier MUST catch digest mismatch (-4).
orig = get text_buf 0
put text_buf 0 xor orig uchar 1
rc = aa_verify_chain get meta cnt entries hashes text_buf
ret eq rc -4
end

fn aa_t_tamper_link_rollback to bool
meta = new AaArchiveMeta 0 0 0
entries = new ulong 288 0
hashes = new uchar 4096 0
text_buf = new uchar 4096 0
if not aa_t_append_helper meta entries hashes text_buf
ret false
end
note Negative control 1: timestamp rollback refused at stage (-3).
rb = new AaChainEntry 0 2500 AA_AGENT_CLAUDE AA_ROLE_USER 0 200 0 0 0
if ne aa_stage_record meta rb aa_m1 text_buf -3
ret false
end
note Negative control 2: corrupt prev_hash of record 1 -> verifier catches broken chain (-3).
orig = get hashes 128
put hashes 128 xor orig uchar 1
rc = aa_verify_chain get meta cnt entries hashes text_buf
ret eq rc -3
end

fn main to int
fails = int 0
fails = add fails aa_t_report aa_tn_1 aa_t_sha_nist
fails = add fails aa_t_report aa_tn_2 aa_t_sha_multi
fails = add fails aa_t_report aa_tn_3 aa_t_dedup_priv
fails = add fails aa_t_report aa_tn_4 aa_t_redaction
fails = add fails aa_t_report aa_tn_5 aa_t_private_export
fails = add fails aa_t_report aa_tn_6 aa_t_chain_verify
fails = add fails aa_t_report aa_tn_7 aa_t_tamper_payload
fails = add fails aa_t_report aa_tn_8 aa_t_tamper_link_rollback
if eq fails 0
aa_t_print aa_ts_ok
ret 0
end
aa_t_print aa_ts_bad
ret 1
end

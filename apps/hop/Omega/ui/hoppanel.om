note the request of fn swsuggest: what was copied, then six numbers an app
for i ulong 6
upn tb i 0
end
ncl = get g_n 24
nrest = ulong 0
put g_n 25 0
put g_n 26 0
if gt ncl 0
upn tb 0 1
newest = umsg get g_m 14 get g_m 16 0 0 0
age = ulong 0
if uiskind newest 7
moment = ukeyed newest k_date
if ne moment 0
x = umsg moment usl m_double_value 0 0 0
then_bits = ugr 64

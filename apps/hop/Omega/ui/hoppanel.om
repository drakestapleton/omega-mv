note ---- copied things: Hop's encrypted clipboard history (Sources/Clipboard.swift), read and never written ----
note The history is one file, sealed with AES-256-GCM (the core's fn gcunlock) under a key that Hop keeps in the
note login Keychain as an item of Apple's security tool and reads through that tool; the panel reads it the same
note way. The key and the unsealed bytes are wiped from the core's buffers as soon as they are used. The panel
note only reads the history: Hop, when it runs, is the one that keeps it, and it sees what the panel puts on
note the clipboard like anything else that is copied. A check (HOPCHECK) never asks the tool and never touches
note the real clipboard: it takes the key from HOPCLIPKEY and pastes into a board of its own.
note the clipboard key into the core's c_k; 1 when it is there
fn uclipkey to ulong
encoded = ulong 0
item_name = ulong 0
if eq get g_n 14 0
n = ucs x_env_clipkey
upr 0 ulong libptr g_nm 0 1024
key_text = ucall 9
if eq key_text 0
ret 0
end
n = ufetch key_text
if and and gt n 5 eq get g_nm 0 116 and eq get g_nm 3 108 eq get g_nm 4 58
for i ulong sub n 5 bound 1024
put g_nm i get g_nm add 5 i
end
put g_nm sub n 5 0
item_name = unsb
else
encoded = unsb
end
else
item_name = uns x_clip_service
end
if ne item_name 0
task = umsg ucl c_task usl m_alloc 0 0 0
task = umsg task usl m_init 0 0 0
x = umsg task usl m_set_launch uns x_security 0 0
arguments = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg arguments sadd uns x_find 0 0
x = umsg arguments sadd uns x_dash_s 0 0
x = umsg arguments sadd item_name 0 0
x = umsg arguments sadd uns x_dash_a 0 0
x = umsg arguments sadd uns x_clip_account 0 0
x = umsg arguments sadd uns x_dash_w 0 0
x = umsg task usl m_set_arguments arguments 0 0
tube = umsg ucl c_pipe usl m_pipe 0 0 0
x = umsg task usl m_set_output tube 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_error quiet 0 0
x = umsg task usl m_launch 0 0 0
reader = umsg tube usl m_reading 0 0 0
d = umsg reader usl m_read_end 0 0 0
x = umsg task usl m_wait 0 0 0
if ne and umsg task usl m_termination 0 0 0 4294967295 0
ret 0
end
if eq d 0
ret 0
end
whole = umsg ucl c_str usl m_alloc 0 0 0
whole = umsg whole usl m_init_data_encoding d 4 0
if eq whole 0
ret 0
end
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
encoded = umsg whole usl m_trim blanks 0 0
end
if eq encoded 0
ret 0
end
kd = umsg ucl c_data usl m_alloc 0 0 0
kd = umsg kd usl m_init_base64 encoded 0 0
if eq kd 0
ret 0
end
if ne umsg kd usl m_length 0 0 0 32
ret 0
end
src = umsg kd usl m_bytes 0 0 0
upr 0 ulong libptr c_k 0 32
upr 8 src
upr 16 32
x = ucall 8
ret 1
end

note wipe the first m unsealed bytes of the core's buffer
fn uforget m ulong to void
if eq m 0
ret
end
upr 0 ulong libptr c_d 0 m
upr 8 0
upr 16 m
x = ucall 17
end

note the sealed bytes of d (an NSData: the nonce, the data, the tag) unsealed into the core's c_d with the
note clipboard key; the count of data bytes plus 1, or 0 when it cannot be done (no key, or not sealed by it)
fn uunseal d ulong to ulong
n = umsg d usl m_length 0 0 0
if or lt n 28 gt n 16777244
ret 0
end
src = umsg d usl m_bytes 0 0 0
if eq uclipkey 0
ret 0
end
m = sub n 28
upr 0 ulong libptr c_n 0 12
upr 8 src
upr 16 12
x = ucall 8
if gt m 0
upr 0 ulong libptr c_d 0 m
upr 8 add src 12
upr 16 m
x = ucall 8
end
upr 0 ulong libptr c_tg 0 16
upr 8 add src sub n 16
upr 16 16
x = ucall 8
good = gcunlock m
gcwipe
if eq good 0
ret 0
end
ret add m 1
end

note the text a copied thing is shown by: its text without the blanks around it, a mark where a line ends, the
note first 80 characters; "Image" for a picture
fn uclippreview item ulong to ulong
if not uiskind item 7
ret uns x_image
end
words = ukeyed item k_text
if not uiskind words 9
ret uns x_image
end
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
t = umsg words usl m_trim blanks 0 0
put g_nm 0 10
put g_nm 1 0
line_end = unsb
put g_nm 0 32
put g_nm 1 226
put g_nm 2 143
put g_nm 3 142
put g_nm 4 32
put g_nm 5 0
mark = unsb
t = umsg t usl m_replace line_end mark 0
if gt umsg t usl m_length 0 0 0 80
cut = umsg t usl m_composed_at 80 0 0
t = umsg t usl m_substring_to cut 0 0
end
ret t
end

note read the history: the copied things, the text each is shown by, which are pinned, and the order they are
note searched in. Nothing is kept when the file is not there, the key is not to be had or the file is not Hop's
fn uloadclips to void
put g_n 24 0
d = uhopfile x_clipboard_file
if eq d 0
ret
end
r = uunseal d
if le r 1
ret
end
m = sub r 1
plain = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
items = umsg ucl c_json usl m_json_object plain 0 0
if not uiskind items 8
ret
end
cnt = umsg items usl m_count 0 0 0
if gt cnt 1024
cnt = 1024
end
sret = usl m_retain
srel = usl m_release
if ne get g_m 14 0
x = umsg get g_m 14 srel 0 0 0
x = umsg get g_m 15 srel 0 0 0
end
put g_m 14 umsg items sret 0 0 0
shown_by = umsg ucl c_mutable_array usl m_array 0 0 0
put g_m 15 umsg shown_by sret 0 0 0
sat = usl m_at
put g_m 16 sat
sadd = usl m_add_object
for i ulong cnt bound 1024
item = umsg items sat i 0 0
pv = uclippreview item
x = umsg shown_by sadd pv 0 0
put g_cp i 0
if uiskind item 7
pin = ukeyed item k_pinned
if ne pin 0
if eq and umsg pin usl m_bool_value 0 0 0 255 1
put g_cp i 1
end
end
end
end
pos = ulong 0
for i ulong cnt bound 1024
if eq ulong get g_cp i 1
put g_ci pos i
pos = add pos 1
end
end
for i ulong cnt bound 1024
if eq ulong get g_cp i 0
put g_ci pos i
pos = add pos 1
end
end
put g_n 24 cnt
end

note the text copied thing i is shown by into g_nm from byte p; the byte after it
fn uclipname p ulong i ulong to ulong
if or ge i get g_n 24 ge p 900
ret p
end
pv = umsg get g_m 15 get g_m 16 i 0 0
src = umsg pv get g_o 5 0 0 0
if eq src 0
ret p
end
upr 0 src
n = ucall 7
if gt add p n 900
n = sub 900 p
end
if eq n 0
ret p
end
upr 0 ulong libptr g_nm p n
upr 8 src
upr 16 n
x = ucall 8
ret add p n
end

note the newest copied thing's text takes the place of the typed text (on 1) so that the address helpers work on
note it, and gives it back (on 0). Only used while nothing is typed
fn uclipaddr on ulong to void
if eq on 1
n = get g_n 25
for i ulong n bound 256
put g_q i get g_ca i
end
put g_n 12 0
put g_n 13 n
put g_n 10 get g_n 26
else
put g_n 13 0
put g_n 10 0
end

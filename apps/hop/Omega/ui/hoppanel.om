note ---- recording what is copied, as Hop does (Sources/Clipboard.swift, poll) ----
note Only while Hop itself is not running: two programs must not write the same history. The history is read
note again at that moment, changed and written whole, sealed under the same key with a fresh nonce (the core's fn
note gclock), for the owner only. Before this program's first change in a run the history as it was is set
note aside next to it (clipboard.before-hop-omega.bin). What is marked concealed or transient is never kept.
note seal the first m bytes of the core's c_d under the clipboard key; nonce, data and tag as NSData, or 0
fn useal m ulong to ulong
if or eq m 0 gt m 16777216
ret 0
end
if eq uclipkey 0
ret 0
end
upr 0 ulong libptr c_n 0 12
upr 8 12
x = ucall 27
gclock m
gcwipe
sealed = umsg ucl c_mutable_data usl m_data 0 0 0
sappend = usl m_append_bytes
x = umsg sealed sappend ulong libptr c_n 0 12 12 0
x = umsg sealed sappend ulong libptr c_d 0 m m 0
x = umsg sealed sappend ulong libptr c_tg 0 16 16 0
ret sealed
end

note the history as it is on disk now, as a list that can be changed: an empty one when there is no file yet,
note 0 when there is no key or the file is not Hop's
fn uclipsmutable to ulong
path = uhoppath x_clipboard_file
if eq path 0
ret 0
end
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
if eq and umsg manager usl m_file_exists path 0 0 255 0
if eq uclipkey 0
ret 0
end
gcwipe
ret umsg ucl c_mutable_array usl m_array 0 0 0
end
d = umsg ucl c_data usl m_data_file path 0 0
if eq d 0
ret 0
end
r = uunseal d
if le r 1
ret 0
end
m = sub r 1
plain = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
items = umsg ucl c_json usl m_json_object plain 1 0
if not uiskind items 8
ret 0
end
ret items
end

note write the list as the history; 1 when it was written
fn uclipswrite items ulong to ulong
data = umsg ucl c_json usl m_json_data items 0 0
if eq data 0
ret 0
end
n = umsg data usl m_length 0 0 0
if or eq n 0 gt n 16777216
ret 0
end
s_write = usl m_write_file
if eq get g_n 33 0
before = uhopfile x_clipboard_file
if ne before 0
aside = uhoppath x_clip_backup
x = umsg before s_write aside 1 0
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
end
put g_n 33 1
end
src = umsg data usl m_bytes 0 0 0
upr 0 ulong libptr c_d 0 n
upr 8 src
upr 16 n
x = ucall 8
sealed = useal n
uforget n
if eq sealed 0
ret 0
end
path = uhoppath x_clipboard_file
if eq path 0
ret 0
end
ok = and umsg sealed s_write path 1 0 255
path = uhoppath x_clipboard_file
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
ret ok
end


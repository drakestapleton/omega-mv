end

note the methods of OmegaHopPanel. 0 controlTextDidChange: 1 numberOfRowsInTableView:
note 2 tableView:objectValueForTableColumn:row: (e is the row) 3 go: (the field's action, Enter: c is the sender;
note it is remembered, and opened when g_n 7 allows) 4 control:textView:doCommandBySelector: (e is
note the command: the arrows move the selection, Escape puts the panel away; 1 says the key was handled)
note 5 the hot key's handler (a C function for Carbon: 0 says no error) 6 applicationShouldHandleReopen:
note hasVisibleWindows: (a click on the Dock icon, or the app opened again) 7 URLSession:dataTask:didReceiveData:
note (e is the data) 8 URLSession:task:didCompleteWithError: (d the task, e the problem or nothing)
fn libback k ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq k 0
utyped
ret 0
end
if eq k 1
ret get g_n 1
end
if eq k 2
if ge e get g_n 1
ret 0
end
p = ulong 0
if eq ulong get g_rk e 7
p = ufilerow 0 get g_hit e
else
if eq ulong get g_rk e 2
p = uptxt 0 x_open
end
p = uprow p e
end
put g_nm p 0
ret unsb
end
if eq k 3
put g_n 3 add get g_n 3 1
if and ne c 0 lt get g_n 6 get g_n 1
put g_n 8 add get g_n 6 1
if eq get g_n 7 1
rk = ulong get g_rk get g_n 6
if eq rk 8
uask
else
if eq rk 2
uopenaddr
end
if eq rk 7
uopenfile get g_hit get g_n 6
end
if eq rk 1
ulaunch get g_hit get g_n 6
end
put g_n 5 1
if eq get g_n 14 1
uhide
end
end
end
end
end
if eq k 4
if eq e get g_o 9
if lt add get g_n 6 1 get g_n 1
uchoose add get g_n 6 1
end
ret 1
end
if eq e get g_o 10
if gt get g_n 6 0
uchoose sub get g_n 6 1
end
ret 1
end
if eq e get g_o 11
put g_n 5 1
uhide
ret 1
end
end
if eq k 5
ushow
ret 0
end
if eq k 7
unetdata e
ret 0
end
if eq k 8
unetdone d e
ret 0
end
if eq k 6
ushow
ret 1
end
ret 0
end


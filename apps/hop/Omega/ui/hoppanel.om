note g_f: library functions. 0 objc_getClass 1 sel_registerName 2 objc_msgSend 3 write 4 objc_allocateClassPair
note 5 class_addMethod 6 objc_registerClassPair 7 strlen 8 memcpy 9 getenv
global g_f ulong 16
note g_o: objects and selectors the callbacks need. 0 field 1 table 2 status line 3 NSString 4 stringWithUTF8String:
note 5 UTF8String 6 stringValue 7 reloadData 8 setStringValue: 9 moveDown: 10 moveUp: 11 cancelOperation:
note 12 selectRowIndexes:byExtendingSelection: 13 NSIndexSet 14 indexSetWithIndex: 15 scrollRowToVisible:
note 16 NSURL 17 URLWithString: 18 host 19 the window 20 orderOut: 21 the application 22 hide:
note 23 activateIgnoringOtherApps: 24 makeKeyAndOrderFront: 25 makeFirstResponder: 26 orderFrontRegardless
global g_o ulong 32
note g_n: 0 apps 1 shown 2 bytes of names 3 times the action ran 4 length of the typed text 5 1 to end the program
note 6 the selected row 7 1 when Enter may open the row 8 the row Enter chose, plus 1 9 what the workspace answered
note 10 the typed text as a web address (0 it is none, 1 written with its scheme, 2 a bare address) 12 where the
note typed text starts once blanks are trimmed 13 its length then 14 1 when the program stays (no HOPCHECK)
note 15 what registering the hot key gave (0 it is registered)
global g_n ulong 16
note g_t: the text HOPCHECK=open:TEXT asks to type
global g_t uchar 64
global g_rg uchar 128
global g_nm uchar 1024
global g_pool uchar 65536
global g_off ulong 2048
global g_ln ulong 2048
global g_hit ulong 2048
note g_hit: the app of each row; g_rk: the kind of each row (1 an app, 2 the web address); g_dir: the folder each
note app is in (0 /Applications, 1 /System/Applications); g_mk and g_ms: the apps hopfuzz matched and their scores
global g_rk uchar 2048
global g_dir uchar 2048
global g_mk ulong 2048
global g_ms ulong 2048
global g_q uchar 256
note g_x: the first row's text, kept for the check's line
global g_x uchar 256
note g_ev: the hot key's event type (class 'keyb', kind 5 pressed) and, from byte 8, the reference Carbon gives back
global g_ev uchar 16

note @hopcore

fn upr o ulong v ulong to void
for i ulong 8
put g_rg add o i uchar and shr v mul i 8 255
end
end

fn ugr o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_rg add o i mul i 8
end
ret v
end

note the text into g_nm with a zero byte after it; its length
fn ucs t view uchar * to ulong
n = len t
for i ulong n
put g_nm i get t i
end
put g_nm n 0
ret n
end

note library function k of g_f on the register file; x0 as it came back (an object may have its top bit set)
fn ucall k ulong to ulong
lr = libcall get g_f k g_rg 0 128
ret ugr 0
end

fn usym t view uchar * to ulong
n = ucs t
upr 0 18446744073709551614
upr 8 ulong libptr g_nm 0 1024
lr = libcall ulong libfn 1 g_rg 0 128
ret ugr 0
end

fn ucl t view uchar * to ulong
n = ucs t
upr 0 ulong libptr g_nm 0 1024
ret ucall 0
end

fn usl t view uchar * to ulong
n = ucs t
upr 0 ulong libptr g_nm 0 1024
ret ucall 1
end

note [obj s a b c]
fn umsg obj ulong s ulong a ulong b ulong c ulong to ulong
upr 0 obj
upr 8 s
upr 16 a
upr 24 b
upr 32 c
ret ucall 2
end

note an NSString of the zero-ended bytes in g_nm
fn unsb to ulong
ret umsg get g_o 3 get g_o 4 ulong libptr g_nm 0 1024 0 0
end

fn uns t view uchar * to ulong
n = ucs t
ret unsb
end

note a rectangle for the next message, in d0..d3
fn urect x f64 y f64 w f64 h f64 to void
upr 64 bitcast ulong x
upr 72 bitcast ulong y
upr 80 bitcast ulong w
upr 88 bitcast ulong h
end

fn ulower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note the zero-ended bytes at address p into g_nm (at most 1000); their count
fn ufetch p ulong to ulong
upr 0 p
n = ucall 7
if gt n 1000
n = 1000
end
upr 0 ulong libptr g_nm 0 1024
upr 8 p
upr 16 n
x = ucall 8
put g_nm n 0
ret n
end

note the names in one folder that end in ".app", without that ending, into the pool
fn ufolder t view uchar * dn ulong to void
c = ucl c_fm
s = usl m_defaul
mgr = umsg c s 0 0 0
s = usl m_conte1
path = uns t
arr = umsg mgr s path 0 0
if eq arr 0
ret
end
s = usl m_count
cnt = umsg arr s 0 0 0
sat = usl m_at
for i ulong cnt bound 4096
item = umsg arr sat i 0 0
p = umsg item get g_o 5 0 0 0
n = ufetch p
k = get g_n 0
used = get g_n 2
if and and gt n 4 lt k 2048 lt add used n 65536
if and and eq get g_nm sub n 4 46 eq get g_nm sub n 3 97 and eq get g_nm sub n 2 112 eq get g_nm sub n 1 112
m = sub n 4
for j ulong m bound 1000
put g_pool add used j get g_nm j
end
put g_off k used
put g_ln k m
put g_dir k uchar dn
put g_n 0 add k 1
put g_n 2 add used m
end
end
end
end

note the word hopfuzz reads for one byte: its lower-case value, bit 32 for a letter or digit (and for every byte of
note a longer character), bit 33 for a space or tab
fn ufword c ulong to ulong
l = ulower c
w = l
if or or and ge l 97 le l 122 and ge l 48 le l 57 ge l 128
w = or w 4294967296
end
if or eq l 32 eq l 9
w = or w 8589934592
end
ret w
end

note how well app k matches the typed text: hopfuzz's score plus 1, or 0 for no match (and for a text over 64 bytes
note or a name over 184, which hopfuzz refuses)
fn uscore k ulong to ulong
inp = new ulong 256 0
res = new ulong 256 0
ql = get g_n 4
nl = get g_ln k
o = get g_off k
if or gt ql 64 or gt nl 184 eq nl 0
ret 0
end
put inp 0 1212568922
put inp 1 1
put inp 2 ql
put inp 3 nl
for i ulong ql bound 64
put inp add 8 i ufword ulong get g_q i
end
for i ulong nl bound 184
put inp add 72 i ufword ulong get g_pool add o i
end
v = hopfuzz inp res
if ne v 1
ret 0
end
ret add get res 3 1
end

note a number in decimal into g_nm from byte p; the byte after it
fn upnum p ulong v ulong to ulong
d = ulong 1
while ge div v d 10 bound 24
d = mul d 10
end
q = p
while gt d 0 bound 24
put g_nm q uchar add 48 rem div v d 10
q = add q 1
d = div d 10
end
ret q
end

note the text into g_nm from byte p; the byte after it
fn uptxt p ulong t view uchar * to ulong
for i ulong len t
put g_nm add p i get t i
end
ret add p len t
end

note name k into g_nm from byte p; the byte after it
fn upname p ulong k ulong to ulong
o = get g_off k
n = get g_ln k
for i ulong n bound 1000
put g_nm add p i get g_pool add o i
end
ret add p n
end

note four bytes and eight bytes into a request for the core, and eight bytes out of its answer; numbers travel with
note 2^40 added (k_b), as in Omega/README.md kind 7
fn uw32 b edit uchar 1048576 o ulong v ulong to void
for i ulong 4
put b add o i uchar and shr v mul i 8 255
end
end

fn upn b edit uchar 1048576 k ulong v ulong to void
x = add v k_b
o = add 8 mul k 8
for i ulong 8
put b add o i uchar and shr x mul i 8 255
end
end

fn uog ob view uchar 65544 k ulong to ulong
v = ulong 0
o = add 8 mul k 8
for i ulong 8
v = or v shl ulong get ob add o i mul i 8
end
ret v
end

note the address the typed text stands for into g_nm from byte p (with "https://" before a bare one); the byte after
fn upaddr p ulong to ulong
q = p
if eq get g_n 10 2
q = uptxt p x_https
end
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm add q i get g_q add a i
end
ret add q n
end

note is the typed text a web address? The shape is the core's decision (fn weba, text decisions op 3); that macOS
note can read it is asked of NSURL, as Hop does. The answer goes to g_n 10
fn udecide to void
tb = new uchar 1048576 0
a = get g_n 12
n = get g_n 13
put g_n 10 0
if or eq n 0 gt n 255
ret
end
uw32 tb 0 3
uw32 tb 4 n
uw32 tb 8 n
for i ulong n bound 256
l = ulower ulong get g_q add a i
o = add 16 mul i 8
put tb o uchar l
f = ulong 0
if or or and ge l 97 le l 122 and ge l 48 le l 57 ge l 128
f = 1
end
if or eq l 32 eq l 9
f = 14
end
put tb add o 4 uchar f
end
k = weba tb n n
if eq k 0
ret
end
put g_n 10 k
p = upaddr 0
put g_nm p 0
str = unsb
u = umsg get g_o 16 get g_o 17 str 0 0
if eq u 0
put g_n 10 0
ret
end
if eq k 1
if eq umsg u get g_o 18 0 0 0 0
put g_n 10 0
end
end
end

note the rows for typed text, by the one box's rules (fn swrank): the request is what Sources/SmartRank.swift
note sends, with the m matched apps of g_mk and their hopfuzz scores, the web address, and nothing else yet (no
note files, screens, commands, accounts or copied things). Ask and the agent come back too and are left out: the
note panel cannot do them yet
fn urankrows m ulong to void
tb = new uchar 1048576 0
ob = new uchar 65544 0
a = get g_n 12
n = get g_n 13
c = add 13 mul m 4
upn tb 0 n
upn tb 1 n
upn tb 2 get g_n 10
upn tb 3 1
upn tb 4 0
upn tb 5 0
upn tb 6 0
upn tb 7 m
for i ulong 5
upn tb add 8 i 0
end
for i ulong m bound 2048
o = add 13 mul i 4
upn tb o get g_ms i
upn tb add o 1 0
upn tb add o 2 0
upn tb add o 3 0
end
lo = add 8 mul c 8
for i ulong n bound 256
put tb add lo i uchar ulower ulong get g_q add a i
end
k = swrank tb c n ob
h = ulong 0
if ne k 0
rws = sub uog ob 0 k_b
for i ulong rws bound 1024
knd = sub uog ob add 1 mul i 4 k_b
ix = sub uog ob add 2 mul i 4 k_b
if and eq knd 1 lt ix m
put g_rk h 1
put g_hit h get g_mk ix
h = add h 1
end
if eq knd 2
put g_rk h 2
put g_hit h 0
h = add h 1
end
end
end
put g_n 1 h
end

note the rows to show: every app when nothing is typed, else what the one box's rules give
fn unarrow to void
if eq get g_n 13 0
for k ulong get g_n 0 bound 2048
put g_hit k k
put g_rk k 1
end
put g_n 1 get g_n 0
ret
end
m = ulong 0
for k ulong get g_n 0 bound 2048
s = uscore k
if gt s 0
put g_mk m k
put g_ms m sub s 1
m = add m 1
end
end
urankrows m
end

note "H of N apps" into the status line
fn ushowst to void
p = upnum 0 get g_n 1
p = uptxt p x_of
p = upnum p get g_n 0
p = uptxt p x_apps
put g_nm p 0
str = unsb
x = umsg get g_o 2 get g_o 8 str 0 0
end

note select row r of the list and bring it into view
fn uchoose r ulong to void
put g_n 6 r
ix = umsg get g_o 13 get g_o 14 r 0 0
x = umsg get g_o 1 get g_o 12 ix 0 0
x = umsg get g_o 1 get g_o 15 r 0 0
end

note what the list shows was typed into the field: read it, narrow, show
fn utyped to void
str = umsg get g_o 0 get g_o 6 0 0 0
p = umsg str get g_o 5 0 0 0
n = ufetch p
if gt n 255
n = 255
end
for i ulong n bound 256
put g_q i get g_nm i
end
put g_n 4 n
a = ulong 0
while lt a n bound 256
c = ulong get g_q a
if and ne c 32 ne c 9
break
end
a = add a 1
end
e = n
while gt e a bound 256
c = ulong get g_q sub e 1
if and ne c 32 ne c 9
break
end
e = sub e 1
end
put g_n 12 a
put g_n 13 sub e a
udecide
unarrow
x = umsg get g_o 1 get g_o 7 0 0 0
put g_n 6 0
if gt get g_n 1 0
uchoose 0
end
ushowst
end

note open app k: its folder, "/", its name and ".app" as a file address, handed to the workspace
fn ulaunch k ulong to void
p = ulong 0
if eq ulong get g_dir k 0
p = uptxt 0 x_dir1
else
p = uptxt 0 x_dir2
end
p = uptxt p x_slash
p = upname p k
p = uptxt p x_dotapp
put g_nm p 0
str = unsb
c = ucl c_url
s = usl m_furl
url = umsg c s str 0 0
c = ucl c_ws
s = usl m_shws
ws = umsg c s 0 0 0
s = usl m_open
put g_n 9 and umsg ws s url 0 0 255
end

note open the web address the typed text stands for
fn uopenaddr to void
p = upaddr 0
put g_nm p 0
str = unsb
u = umsg get g_o 16 get g_o 17 str 0 0
c = ucl c_ws
s = usl m_shws
ws = umsg c s 0 0 0
s = usl m_open
put g_n 9 and umsg ws s u 0 0 255
end

note the text of row r into g_nm from byte p (an app's name, or the address); the byte after it
fn uprow p ulong r ulong to ulong
if eq ulong get g_rk r 2
ret upaddr p
end
ret upname p get g_hit r
end

note one turn of the event loop: wait for an event until date d and hand it to AppKit
fn utick app ulong sn ulong se ulong mode ulong d ulong to void
upr 0 app
upr 8 sn
upr 16 18446744073709551615
upr 24 d
upr 32 mode
upr 40 1
ev = ucall 2
if ne ev 0
x = umsg app se ev 0 0
end
end

note put the panel away. A program that stays also empties the field, shows every app again and hides itself, so
note the app that was in front before has the keyboard back
fn uhide to void
x = umsg get g_o 19 get g_o 20 0 0 0
if eq get g_n 14 1
put g_nm 0 0
x = umsg get g_o 0 get g_o 8 unsb 0 0
utyped
x = umsg get g_o 21 get g_o 22 0 0 0
end
end

note bring the panel back: in front with the keyboard in the field for a program that stays, else just visible
fn ushow to void
if eq get g_n 14 1
x = umsg get g_o 21 get g_o 23 1 0 0
x = umsg get g_o 19 get g_o 24 0 0 0
x = umsg get g_o 19 get g_o 25 get g_o 0 0 0
else
x = umsg get g_o 19 get g_o 26 0 0 0
end
end

note the library function at address f on the register file; x0 as it came back
fn ucallf f ulong to ulong
lr = libcall f g_rg 0 128
ret ugr 0
end

note a global key: a Carbon hot key (key code, modifiers) whose handler is callback entry 5. 0 when both the
note handler and the key were taken; the hot key's id is 'HOPO' 1
fn ukey code ulong mods ulong to ulong
n = ucs s_carbon
upr 0 ulong libptr g_nm 0 1024
upr 8 2
lr = libcall ulong libfn 0 g_rg 0 128
target_fn = usym s_event_target
install_fn = usym s_install_handler
register_fn = usym s_register_key
if or or eq target_fn 0 eq install_fn 0 eq register_fn 0
ret 1
end
target = ucallf target_fn
put g_ev 0 98
put g_ev 1 121
put g_ev 2 101
put g_ev 3 107
put g_ev 4 5
upr 0 target
upr 8 ulong libfn 7
upr 16 1
upr 24 ulong libptr g_ev 0 16
upr 32 0
upr 40 0
installed = and ucallf install_fn 4294967295
upr 0 code
upr 8 mods
upr 16 5507124751
upr 24 target
upr 32 0
upr 40 ulong libptr g_ev 8 8
registered = and ucallf register_fn 4294967295
ret or installed registered
end

note one menu item: title, action (a selector) and key. An unsized text takes two of a function's six places
fn uitem menu ulong title view uchar * action_sel ulong key view uchar * to void
c = ucl c_menu_item
s = usl m_alloc
item = umsg c s 0 0 0
title_string = uns title
key_string = uns key
s = usl m_init_item
item = umsg item s title_string action_sel key_string
s = usl m_add_item
x = umsg menu s item 0 0
end


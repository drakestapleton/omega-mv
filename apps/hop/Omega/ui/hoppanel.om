has_text = false
if ne copied 0
if gt umsg copied usl m_length 0 0 0 0
has_text = true
end
end
fresh_item = ulong 0
if has_text
if gt umsg copied usl m_byte_length 4 0 0 512000
ret
end
cnt = umsg items usl m_count 0 0 0
found = cnt
sequal = usl m_equal_string
for i ulong cnt bound 100000
if eq found cnt
e = umsg items sat i 0 0
if uiskind e 7
words = ukeyed e k_text
if uiskind words 9
if eq and umsg words sequal copied 0 0 255 1
found = i
end
end
end
end
end
if lt found cnt
e = umsg items sat found 0 0
kept = umsg e usl m_retain 0 0 0
x = umsg e sset moment uns k_date 0
x = umsg items usl m_remove_at found 0 0
x = umsg items sins e 0 0
x = umsg e usl m_release 0 0 0
else
fresh_item = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
x = umsg fresh_item sset copied uns k_text 0
end
else
picture = umsg ucl c_image usl m_alloc 0 0 0
picture = umsg picture usl m_init_pasteboard pb 0 0
if eq picture 0
ret
end
tiff = umsg picture usl m_tiff 0 0 0
if eq tiff 0
ret
end

upr 0 ulong libptr c_k 0 32
upr 8 src
upr 16 32
x = ucall 8
ret 1
end

note wipe the first m unsealed bytes of the core's buffer
fn uforget m ulong to void
if eq m 0
ret
end
upr 0 ulong libptr c_d 0 m
upr 8 0
upr 16 m
x = ucall 17
end

note the sealed bytes of d (an NSData: the nonce, the data, the tag) unsealed into the core's c_d with the
note clipboard key; the count of data bytes plus 1, or 0 when it cannot be done (no key, or not sealed by it)
fn uunseal d ulong to ulong
n = umsg d usl m_length 0 0 0
if or lt n 28 gt n 16777244
ret 0
end
src = umsg d usl m_bytes 0 0 0
if eq uclipkey 0
ret 0
end
m = sub n 28
upr 0 ulong libptr c_n 0 12
upr 8 src
upr 16 12
x = ucall 8
if gt m 0
upr 0 ulong libptr c_d 0 m
upr 8 add src 12
upr 16 m
x = ucall 8
end
upr 0 ulong libptr c_tg 0 16
upr 8 add src sub n 16
upr 16 16
x = ucall 8
good = gcunlock m
gcwipe
if eq good 0
ret 0
end
ret add m 1
end

note the text a copied thing is shown by: its text without the blanks around it, a mark where a line ends, the
note first 80 characters; "Image" for a picture
fn uclippreview item ulong to ulong
if not uiskind item 7
ret uns x_image
end
words = ukeyed item k_text
if not uiskind words 9
ret uns x_image
end
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
t = umsg words usl m_trim blanks 0 0
put g_nm 0 10
put g_nm 1 0
line_end = unsb
put g_nm 0 32
put g_nm 1 226
put g_nm 2 143
put g_nm 3 142
put g_nm 4 32
put g_nm 5 0
mark = unsb
t = umsg t usl m_replace line_end mark 0
if gt umsg t usl m_length 0 0 0 80
cut = umsg t usl m_composed_at 80 0 0
t = umsg t usl m_substring_to cut 0 0
end
ret t
end

note read the history: the copied things, the text each is shown by, which are pinned, and the order they are
note searched in. Nothing is kept when the file is not there, the key is not to be had or the file is not Hop's
fn uloadclips to void
put g_n 24 0
d = uhopfile x_clipboard_file
if eq d 0
ret
end
r = uunseal d
if le r 1
ret
end
m = sub r 1
plain = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
items = umsg ucl c_json usl m_json_object plain 0 0
if not uiskind items 8
ret
end
cnt = umsg items usl m_count 0 0 0
if gt cnt 1024
cnt = 1024
end
sret = usl m_retain
srel = usl m_release
if ne get g_m 14 0
x = umsg get g_m 14 srel 0 0 0
x = umsg get g_m 15 srel 0 0 0
end
put g_m 14 umsg items sret 0 0 0
shown_by = umsg ucl c_mutable_array usl m_array 0 0 0
put g_m 15 umsg shown_by sret 0 0 0
sat = usl m_at
put g_m 16 sat
sadd = usl m_add_object
for i ulong cnt bound 1024
item = umsg items sat i 0 0
pv = uclippreview item
x = umsg shown_by sadd pv 0 0
put g_cp i 0
if uiskind item 7
pin = ukeyed item k_pinned
if ne pin 0
if eq and umsg pin usl m_bool_value 0 0 0 255 1
put g_cp i 1
end
end
end
end
pos = ulong 0
for i ulong cnt bound 1024
if eq ulong get g_cp i 1
put g_ci pos i
pos = add pos 1
end
end
for i ulong cnt bound 1024
if eq ulong get g_cp i 0
put g_ci pos i
pos = add pos 1
end
end
put g_n 24 cnt
end

note the text copied thing i is shown by into g_nm from byte p; the byte after it
fn uclipname p ulong i ulong to ulong
if or ge i get g_n 24 ge p 900
ret p
end
pv = umsg get g_m 15 get g_m 16 i 0 0
src = umsg pv get g_o 5 0 0 0
if eq src 0
ret p
end
upr 0 src
n = ucall 7
if gt add p n 900
n = sub 900 p
end
if eq n 0
ret p
end
upr 0 ulong libptr g_nm p n
upr 8 src
upr 16 n
x = ucall 8
ret add p n
end

note the newest copied thing's text takes the place of the typed text (on 1) so that the address helpers work on
note it, and gives it back (on 0). Only used while nothing is typed
fn uclipaddr on ulong to void
if eq on 1
n = get g_n 25
for i ulong n bound 256
put g_q i get g_ca i
end
put g_n 12 0
put g_n 13 n
put g_n 10 get g_n 26
else
put g_n 13 0
put g_n 10 0
end
end

note the copied things that match the typed text, as Hop's search does: the pinned ones first, each in lower
note case has to contain every typed word (a picture counts as "image"); the first "most" of them into g_cm
note (for a whole screen with nothing typed: all of them)
fn uclipmatch most ulong to void
put g_n 28 0
cnt = get g_n 24
if eq cnt 0
ret
end
a = get g_n 12
n = get g_n 13
if and eq n 0 gt most 8
every = cnt
if gt every most
every = most
end
for pos ulong every bound 1024
put g_cm pos get g_ci pos
end
put g_n 28 every
ret
end
if or eq n 0 gt n 255
ret
end
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
typed = unsb
if eq typed 0
ret
end
slower = usl m_lowercase
typed_low = umsg typed slower 0 0 0
parts = umsg typed_low usl m_components uns x_space 0 0
nt = umsg parts usl m_count 0 0 0
scontains = usl m_contains
slen = usl m_length
sat = get g_m 16
image_low = uns x_image_low
found = ulong 0
for pos ulong cnt bound 1024
if lt found most
i = get g_ci pos
item = umsg get g_m 14 sat i 0 0
hay = image_low
if uiskind item 7
words = ukeyed item k_text
if uiskind words 9
hay = umsg words slower 0 0 0
end
end
okay = true
for j ulong nt bound 64
term = umsg parts sat j 0 0
if gt umsg term slen 0 0 0 0
if ne and umsg hay scontains term 0 0 255 1
okay = false
end
end
end
if okay
put g_cm found i
found = add found 1
end
end
end
put g_n 28 found
end


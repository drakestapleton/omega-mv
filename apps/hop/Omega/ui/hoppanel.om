note why an offered app is offered into g_nm from byte p (nothing for a typed row); the byte after it
fn uwhy p ulong r ulong to ulong
w = ulong get g_why r
if or ne get g_n 13 0 eq w 0
ret p
end
q = uptxt p x_gap
if eq w 1
ret uptxt q x_why1
end
if eq w 2
ret uptxt q x_why2
end
if eq w 3
ret uptxt q x_why3
end
if eq w 4
q = uptxt q x_why4
name = get g_m 12
if eq name 0
ret uptxt q x_here
end
name_bytes = umsg name get g_o 5 0 0 0
upr 0 name_bytes
n = ucall 7
if gt n 200
n = 200
end
upr 0 ulong libptr g_nm q n
upr 8 name_bytes
upr 16 n
x = ucall 8
ret add q n
end
if eq w 5
ret uptxt q x_why5
end
if eq w 6
ret uptxt q x_why6
end
if eq w 7
ret uptxt q x_why7
end
ret uptxt q x_why8
end


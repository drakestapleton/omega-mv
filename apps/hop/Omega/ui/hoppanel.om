note the Ask row's text into g_nm from byte p: "Ask NAME: TEXT", or why it cannot ask; the byte after it
fn uaskrow p ulong to ulong
if eq get g_m 3 0
ret uptxt p x_ask_none
end
name_bytes = umsg get g_m 2 get g_o 5 0 0 0
q = uptxt p x_ask
upr 0 name_bytes
n = ucall 7
if gt n 200
n = 200
end
upr 0 ulong libptr g_nm q n
upr 8 name_bytes
upr 16 n
x = ucall 8
q = add q n
q = uptxt q x_colon
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm add q i get g_q add a i
end
ret add q n
end

note the text of row r into g_nm from byte p (an app's name, the address, a file's whole path, or the Ask row); the byte after it
fn uprow p ulong r ulong to ulong
if eq ulong get g_rk r 8
ret uaskrow p
end
if eq ulong get g_rk r 10
ret uremoterow p get g_hit r
end
if eq ulong get g_rk r 9
q = uptxt p x_agent_row
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm add q i get g_q add a i
end
ret add q n
end
if eq ulong get g_rk r 6
ret uclipname p get g_hit r
end
if eq ulong get g_rk r 5
ret ustrat get g_m 18 p get g_hit r
end
if eq ulong get g_rk r 3
if eq get g_hit r 0
ret uptxt p x_screen0
end
if eq get g_hit r 2
ret uptxt p x_screen2
end
ret uptxt p x_screen1
end
if eq ulong get g_rk r 4
if eq get g_hit r 0
ret uptxt p x_command0
end
if eq get g_hit r 2
ret uptxt p x_command2
end
if eq get g_hit r 3
ret uptxt p x_command3
end
ret uptxt p x_command1
end
if and eq ulong get g_rk r 2 eq get g_n 13 0
uclipaddr 1
q = upaddr p
uclipaddr 0
ret q
end
if eq ulong get g_rk r 2
ret upaddr p
end
if eq ulong get g_rk r 7
ret ufilepath p get g_hit r
end
ret upname p get g_hit r
end

note one turn of the event loop: wait for an event until date d and hand it to AppKit

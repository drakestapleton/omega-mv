if eq and umsg types shas uns x_skip2 0 0 255 1
ret
end
if eq and umsg types shas uns x_skip3 0 0 255 1
ret
end
if eq and umsg types shas uns x_skip4 0 0 255 1
ret
end
if eq and umsg types shas uns x_skip5 0 0 255 1
ret
end
end
items = uclipsmutable
if eq items 0
ret
end
source = ulong 0
if eq get g_n 14 1
front_app = umsg umsg ucl c_ws usl m_shws 0 0 0 usl m_frontmost 0 0 0
if ne front_app 0
source = umsg front_app usl m_localized_name 0 0 0
end
end
cnum = ucl c_number
x = umsg ucl c_date usl m_reference_now 0 0 0
now_bits = ugr 64
s_double = usl m_number_double
upr 64 now_bits
moment = umsg cnum s_double 0 0 0
sset = usl m_set_object
sat = usl m_at
sins = usl m_insert_at

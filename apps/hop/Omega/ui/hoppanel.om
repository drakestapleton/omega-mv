note the program bringing a file over has ended: when it says the file arrived it is opened, else the path goes
note to the clipboard and that is said
fn ufetchdone about ulong to void
if eq about 0
ret
end
info = umsg about usl m_user_info 0 0 0
if eq info 0
ret
end
d = umsg info usl m_object_for_key uconst s_data_item 0 0
arrived = false
if ne d 0
said = umsg ucl c_str usl m_alloc 0 0 0
said = umsg said usl m_init_data_encoding d 4 0
if ne said 0
arrived = eq and umsg said usl m_contains uns x_fetched 0 0 255 1
end
end
if arrived
put g_n 51 0
put g_n 55 1
if eq get g_n 7 1
url = umsg ucl c_url usl m_furl get g_m 50 0 0
ws = umsg ucl c_ws usl m_shws 0 0 0
put g_n 9 and umsg ws usl m_open url 0 0 255
end
else
if ne get g_m 51 0
uclipput get g_m 51
end
put g_n 51 5
end
ushowst
end


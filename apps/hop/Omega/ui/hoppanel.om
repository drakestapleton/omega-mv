png = umsg bitmap usl m_rep_using 4 no_properties 0
if eq png 0
ret
end
pn = umsg png usl m_length 0 0 0
if or eq pn 0 gt pn 16777216
ret
end
src = umsg png usl m_bytes 0 0 0
upr 0 ulong libptr c_d 0 pn
upr 8 src
upr 16 pn
x = ucall 8
sealed = useal pn
uforget pn
if eq sealed 0
ret
end
folder = uhoppath x_clip_images
if eq folder 0
ret
end
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
s_create = usl m_create_dir
upr 40 0
x = umsg manager s_create folder 1 0
file_name = umsg umsg umsg ucl c_uuid usl m_uuid 0 0 0 usl m_uuid_string 0 0 0 usl m_append_string uns x_dot_bin 0 0
file_path = umsg folder usl m_append_string file_name 0 0
if eq and umsg sealed usl m_write_file file_path 1 0 255 0
ret
end
fresh_item = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
x = umsg fresh_item sset file_name uns k_image 0
end
if ne fresh_item 0
id_text = umsg umsg ucl c_uuid usl m_uuid 0 0 0 usl m_uuid_string 0 0 0
x = umsg fresh_item sset id_text uns k_id 0
x = umsg fresh_item sset moment uns k_date 0
if ne source 0
x = umsg fresh_item sset source uns k_source 0
end
no = umsg cnum usl m_number_bool 0 0 0
x = umsg fresh_item sset no uns k_pinned 0
x = umsg items sins fresh_item 0 0
end
note the unpinned ones over the limit go, from the end
limit = get g_n 34
if lt limit 50
limit = 50
end
cnt = umsg items usl m_count 0 0 0
loose = ulong 0
for i ulong cnt bound 100000
if not uclippinned umsg items sat i 0 0
loose = add loose 1
end
end
if gt loose limit
drop = sub loose limit
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
for back ulong cnt bound 100000
i = sub sub cnt 1 back
if gt drop 0
e = umsg items sat i 0 0
if not uclippinned e
if uiskind e 7
image_name = ukeyed e k_image
if uiskind image_name 9
if ne and umsg image_name usl m_contains uns x_slash_text 0 0 255 1
folder = uhoppath x_clip_images
if ne folder 0
gone = umsg folder usl m_append_string image_name 0 0
x = umsg manager usl m_remove_item gone 0 0
end
end
end
end
x = umsg items usl m_remove_at i 0 0
drop = sub drop 1
end
end
end
end
x = uclipswrite items
end

note is Hop itself running
fn uhoprunning to bool
others = umsg ucl c_running_app usl m_running_with uns x_hop_id 0 0

upr 8 12
x = ucall 27
gclock m
gcwipe
sealed = umsg ucl c_mutable_data usl m_data 0 0 0
sappend = usl m_append_bytes
x = umsg sealed sappend ulong libptr c_n 0 12 12 0
x = umsg sealed sappend ulong libptr c_d 0 m m 0
x = umsg sealed sappend ulong libptr c_tg 0 16 16 0
ret sealed
end


upr 0 ulong libptr g_nm q n
upr 8 name_bytes
upr 16 n
x = ucall 8
q = add q n
q = uptxt q x_colon
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm add q i get g_q add a i
end
ret add q n
end


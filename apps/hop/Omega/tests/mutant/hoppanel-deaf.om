note ---- the core of Hop, from Omega/hopcore.om ----
fn isword w ulong to bool
ret ne and w 4294967296 0
end

fn istrim w ulong to bool
ret ne and w 8589934592 0
end

fn minu a ulong b ulong to ulong
if lt a b
ret a
end
ret b
end

note true when inp[a .. a+n) equals inp[b .. b+n); both runs must lie inside the buffer
fn same inp view ulong 256 a ulong b ulong n ulong to bool
for k ulong n
if ne get inp add a k get inp add b k
ret false
end
end
ret true
end

note x is one longer than y (ls characters): true when dropping one character of x gives y
fn skip1 inp view ulong 256 x ulong y ulong ls ulong to bool
k = ulong 0
while lt k ls bound 256
if ne get inp add x k get inp add y k
break
end
k = add k 1
end
ret same inp add x add k 1 add y k sub ls k
end

note edit distance at most 1, where swapping two neighbours counts as one
fn near inp view ulong 256 a ulong la ulong b ulong lb ulong to bool
if eq la lb
d = ulong 0
p = ulong 0
for k ulong la
if ne get inp add a k get inp add b k
if eq d 0
p = k
end
d = add d 1
end
end
if le d 1
ret true
end
if eq d 2
if lt add p 1 la
if eq get inp add a p get inp add b add p 1
if eq get inp add a add p 1 get inp add b p
ret true
end
end
end
end
ret false
end
if eq la add lb 1
ret skip1 inp a b lb
end
if eq lb add la 1
ret skip1 inp b a la
end
ret false
end

note score of q = inp[qa .. qa+ql) in the name inp[72 .. 72+nl); 0 means no match. ql and nl >= 1
fn one inp view ulong 256 qa ulong ql ulong nl ulong to ulong
if le ql nl
if same inp qa 72 ql
if eq ql nl
ret 200
end
ret sub 160 minu 30 sub nl ql
end
end
qw = true
for k ulong ql
if not isword get inp add qa k
qw = false
end
end
wc = ulong 0
later = false
inits = true
inw = false
for i ulong nl
c = get inp add 72 i
if isword c
if not inw
if lt wc ql
if ne c get inp add qa wc
inits = false
end
end
if gt wc 0
if qw
if le add i ql nl
if same inp qa add 72 i ql
later = true
end
end
end
end
wc = add wc 1
end
inw = true
else
inw = false
end
end
if later
ret sub 120 minu 20 div nl 3
end
if ge ql 2
if gt wc 1
if ge wc ql
if inits
ret 110
end
end
end
end
if le ql nl
for i ulong add sub nl ql 1
if same inp qa add 72 i ql
ret sub 80 minu 20 div nl 3
end
end
end
if ge ql 4
if le ql nl
if near inp qa ql 72 ql
ret 70
end
end
if le sub ql 1 nl
if near inp qa ql 72 sub ql 1
ret 70
end
end
if le add ql 1 nl
if near inp qa ql 72 add ql 1
ret 70
end
end
end
if lt ql 3
ret 0
end
qi = ulong 0
gaps = ulong 0
last = ulong 0
first = ulong 0
for i ulong nl
if lt qi ql
if eq get inp add 72 i get inp add qa qi
if gt qi 0
gaps = add gaps sub sub i last 1
else
first = i
end
last = i
qi = add qi 1
end
end
end
if ne qi ql
ret 0
end
if gt gaps ql
ret 0
end
t = add mul gaps 6 mul first 3
if ge t 45
ret 15
end
ret sub 60 t
end

note first faulting word plus 1, or 0 when the input is well formed
fn check inp view ulong 256 to ulong
if ne get inp 0 1212568922
ret 1
end
if ne get inp 1 1
ret 2
end
ql = get inp 2
nl = get inp 3
if gt ql 64
ret 3
end
if gt nl 184
ret 4
end
for i ulong 4
if ne get inp add 4 i 0
ret add 5 i
end
end
for i ulong 64
w = get inp add 8 i
if lt i ql
if ge w 17179869184
ret add 9 i
end
if eq and w 4294967295 0
ret add 9 i
end
else
if ne w 0
ret add 9 i
end
end
end
for i ulong 184
w = get inp add 72 i
if lt i nl
if ge w 17179869184
ret add 73 i
end
if eq and w 4294967295 0
ret add 73 i
end
else
if ne w 0
ret add 73 i
end
end
end
ret 0
end

fn hopfuzz inp view ulong 256 res edit ulong 256 to ulong
for i ulong 256
put res i 0
end
put res 0 1212568922
put res 1 1
e = check inp
if ne e 0
put res 2 2
put res 4 sub e 1
ret 2
end
nl = get inp 3
qa = ulong 8
qe = add 8 get inp 2
while lt qa qe bound 256
if not istrim get inp qa
break
end
qa = add qa 1
end
while gt qe qa bound 256
if not istrim get inp sub qe 1
break
end
qe = sub qe 1
end
ql = sub qe qa
if eq ql 0
ret 0
end
if eq nl 0
ret 0
end
s = one inp qa ql nl
if eq s 0
terms = ulong 0
sum = ulong 0
p = qa
while lt p qe bound 256
if eq and get inp p 4294967295 32
p = add p 1
continue
end
b = p
while lt p qe bound 256
if eq and get inp p 4294967295 32
break
end
p = add p 1
end
ts = one inp b sub p b nl
if eq ts 0
ret 0
end
terms = add terms 1
sum = add sum ts
end
if le terms 1
ret 0
end
s = sub div sum terms 10
end
put res 2 1
put res 3 s
ret 1
end

note ---- file-name scoring (kind 2): how well a path found on another machine matches the typed terms ----
note The host sends bytes: the terms, and for each path its lowercased bytes, the lowercased bytes of its last
note component (its name), and the byte length of the path as written. A term found in the name scores 60 when the name
note starts with it and 30 otherwise; found only elsewhere in the path it scores 5; a term found nowhere, or an
note empty term, means no match. One point less for every 20 bytes of path; 40 more when the name is exactly as long as the terms.

fn rd16 b view uchar 1048576 o ulong to ulong
ret or ulong get b o shl ulong get b add o 1 8
end

fn rd32 b view uchar 1048576 o ulong to ulong
ret or rd16 b o shl rd16 b add o 2 16
end

note true when b[x .. x+n) equals b[y .. y+n)
fn beq b view uchar 1048576 x ulong y ulong n ulong to bool
for k ulong n
if ne get b add x k get b add y k
ret false
end
end
ret true
end

note true when the run b[t .. t+tl) occurs in b[h .. h+hl)
fn bhas b view uchar 1048576 h ulong hl ulong t ulong tl ulong to bool
if gt tl hl
ret false
end
for i ulong add sub hl tl 1
if beq b add h i t tl
ret true
end
end
ret false
end

note score of one path plus 1000000, or 0 for no match. pm: 0 the number of terms, 1 where the path's bytes
note start, 2 how many, 3 where its name's bytes start, 4 how many, 5 the path's length as written
fn fscore b view uchar 1048576 toff view ulong 64 tlen view ulong 64 pm view ulong 8 to ulong
nt = get pm 0
p = get pm 1
pl = get pm 2
ns = get pm 3
nl = get pm 4
ol = get pm 5
s = ulong 1000000
sum = ulong 0
for k ulong nt
t = get toff k
tl = get tlen k
sum = add sum tl
if eq tl 0
ret 0
end
if bhas b ns nl t tl
if beq b ns t tl
s = add s 60
else
s = add s 30
end
else
if bhas b p pl t tl
s = add s 5
else
ret 0
end
end
end
s = sub s div ol 20
if eq nl sum
s = add s 40
end
ret s
end

note ---- text decisions (kind 3): is it a question, which words to search for, is it a web address ----
note The host lowercases the text and sends one 8-byte word per character: bits 0..31 an id (equal characters get
note equal ids; a character of one Unicode scalar has that scalar's number), then a flag byte: 1 letter or number,
note 2 trimmable white space, 4 white space, 8 white space or line end.
note lists: three lists of plain words, separated by "|": 0 the words a question starts with, 1 the words a search
note leaves out, 2 the endings of a bare web address.
text lists "what what's whats why how how's who who's whom whose when where which explain define translate summarize summarise describe|the and for with that this what when where does did how why can you are was were have has from into about please make need want just our my its not|com org net io dev ai co edu gov xyz me us uk ca de tv gg"

fn cid b view uchar 1048576 i ulong to ulong
ret rd32 b add 16 mul i 8
end

fn cfl b view uchar 1048576 i ulong to ulong
ret ulong get b add 20 mul i 8
end

note true when the n characters from s are exactly one word of list sec
fn inlist b view uchar 1048576 s ulong n ulong sec ulong to bool
cur = ulong 0
p = ulong 0
ln = len lists
while lt p ln bound 999999
e = p
while lt e ln bound 999999
c = ulong get lists e
if or eq c 32 eq c 124
break
end
e = add e 1
end
if eq cur sec
if eq sub e p n
ok = true
for k ulong n
if ne cid b add s k ulong get lists add p k
ok = false
end
end
if ok
ret true
end
end
end
if lt e ln
if eq ulong get lists e 124
cur = add cur 1
end
end
p = add e 1
end
ret false
end

note op 1: 1 when the text reads as a question: it ends with "?" and is longer than that, or it has three words
note or more and starts with a question word
fn qlike b view uchar 1048576 n ulong to ulong
a = ulong 0
e = n
while lt a e bound 999999
if eq and cfl b a 8 0
break
end
a = add a 1
end
while gt e a bound 999999
if eq and cfl b sub e 1 8 0
break
end
e = sub e 1
end
if gt sub e a 1
if eq cid b sub e 1 63
ret 1
end
end
w = ulong 0
fs = ulong 0
fl = ulong 0
i = a
while lt i e bound 999999
if ne and cfl b i 4 0
i = add i 1
continue
end
st = i
while lt i e bound 999999
if ne and cfl b i 4 0
break
end
i = add i 1
end
if eq w 0
fs = st
fl = sub i st
end
w = add w 1
end
if lt w 3
ret 0
end
if inlist b fs fl 0
ret 1
end
ret 0
end

note a character of a search word: a letter, a number, "-", "_" or "."
fn iswc b view uchar 1048576 i ulong to bool
if ne and cfl b i 1 0
ret true
end
c = cid b i
if eq c 45
ret true
end
if eq c 95
ret true
end
ret eq c 46
end

fn samec b view uchar 1048576 x ulong y ulong n ulong to bool
for k ulong n
if ne cid b add x k cid b add y k
ret false
end
end
ret true
end

note true when the word of wl characters at st also stands earlier in the text
fn seen b view uchar 1048576 st ulong wl ulong to bool
i = ulong 0
while lt i st bound 999999
if not iswc b i
i = add i 1
continue
end
s0 = i
while lt i st bound 999999
if not iswc b i
break
end
i = add i 1
end
if eq sub i s0 wl
if samec b s0 st wl
ret true
end
end
end
ret false
end

note op 2: the words to search for: three characters or more, not a left-out word, each once, the longest four,
note longest first and in the order typed among equals. Writes the count, then where each starts and its length
fn keyw b view uchar 1048576 n ulong ob edit uchar 65544 to ulong
ts = new ulong 4 0
tl = new ulong 4 0
k = ulong 0
i = ulong 0
while lt i n bound 999999
if not iswc b i
i = add i 1
continue
end
st = i
while lt i n bound 999999
if not iswc b i
break
end
i = add i 1
end
wl = sub i st
if lt wl 3
continue
end
if inlist b st wl 1
continue
end
if seen b st wl
continue
end
pos = k
for j ulong k
if lt get tl j wl
if eq pos k
pos = j
end
end
end
if lt pos 4
for d ulong sub 3 pos
u = sub 3 d
put tl u get tl sub u 1
put ts u get ts sub u 1
end
put tl pos wl
put ts pos st
if lt k 4
k = add k 1
end
end
end
put ob 8 uchar k
for j ulong k
s = get ts j
l = get tl j
put ob add 9 mul j 4 uchar and s 255
put ob add 10 mul j 4 uchar shr s 8
put ob add 11 mul j 4 uchar and l 255
put ob add 12 mul j 4 uchar shr l 8
end
ret add 1 mul k 4
end

fn hasscheme b view uchar 1048576 n ulong to bool
if lt n 7
ret false
end
if ne cid b 0 104
ret false
end
if ne cid b 1 116
ret false
end
if ne cid b 2 116
ret false
end
if ne cid b 3 112
ret false
end
o = ulong 4
if eq cid b 4 115
o = ulong 5
end
if lt n add o 3
ret false
end
if ne cid b o 58
ret false
end
if ne cid b add o 1 47
ret false
end
ret eq cid b add o 2 47
end

note op 3: 0 not a web address; 1 it starts with http:// or https:// (the host then checks that it names a
note machine); 2 a bare address such as example.com/page (the host then checks that it parses). aux: the text's
note length in bytes as written
fn weba b view uchar 1048576 n ulong aux ulong to ulong
if eq n 0
ret 0
end
if ge aux 2000
ret 0
end
for i ulong n
if ne and cfl b i 4 0
ret 0
end
end
if hasscheme b n
ret 1
end
h0 = ulong 0
while lt h0 n bound 999999
if ne cid b h0 47
break
end
h0 = add h0 1
end
h1 = h0
while lt h1 n bound 999999
if eq cid b h1 47
break
end
h1 = add h1 1
end
parts = ulong 0
ps = h0
i = h0
while le i h1 bound 999999
atend = eq i h1
dot = false
if not atend
dot = eq cid b i 46
end
if or atend dot
if eq i ps
ret 0
end
parts = add parts 1
if atend
if lt parts 2
ret 0
end
if inlist b ps sub i ps 2
ret 2
end
ret 0
end
ps = add i 1
else
if eq and cfl b i 1 0
if ne cid b i 45
ret 0
end
end
end
i = add i 1
end
ret 0
end

note the single-character edits that turn one spelling into another, on letters and numbers only. r: 0 and 1 the
note first spelling's characters [from, to), 2 and 3 the second's. Writes 4 the edits and 5 the longer length.
note Returns 1, and writes nothing, when a spelling has more than 4096 letters and numbers
fn edist b view uchar 1048576 r edit ulong 8 to ulong
xa = new ulong 4096 0
ya = new ulong 4096 0
row = new ulong 4097 0
xc = ulong 0
yc = ulong 0
i = get r 0
x1 = get r 1
while lt i x1 bound 999999
if ne and cfl b i 1 0
if ge xc 4096
ret 1
end
put xa xc cid b i
xc = add xc 1
end
i = add i 1
end
i = get r 2
y1 = get r 3
while lt i y1 bound 999999
if ne and cfl b i 1 0
if ge yc 4096
ret 1
end
put ya yc cid b i
yc = add yc 1
end
i = add i 1
end
for j ulong add yc 1
put row j j
end
for k ulong xc
prev = get row 0
put row 0 add k 1
xi = get xa k
for j ulong yc
cur = get row add j 1
v = add cur 1
w = add get row j 1
if lt w v
v = w
end
w = prev
if ne xi get ya j
w = add prev 1
end
if lt w v
v = w
end
put row add j 1 v
prev = cur
end
end
m = xc
if gt yc m
m = yc
end
put r 4 get row yc
put r 5 m
ret 0
end

note op 4: how alike two spellings are. The text is the first spelling (aux characters), then the second. Writes
note the edits and the longer length, each as a 16-bit number; the host divides
fn alike b view uchar 1048576 n ulong aux ulong ob edit uchar 65544 to ulong
r = new ulong 8 0
bad = ulong 18446744073709551615
if gt aux n
ret bad
end
put r 0 0
put r 1 aux
put r 2 aux
put r 3 n
if ne edist b r 0
ret bad
end
d = get r 4
m = get r 5
put ob 8 uchar and d 255
put ob 9 uchar shr d 8
put ob 10 uchar and m 255
put ob 11 uchar shr m 8
ret 4
end

note op 5: which run of typed words is the fix for what was heard. The text is what was heard (aux characters),
note then up to four runs: the first typed word, the first two, the first three, the first four; flag 16 marks the
note last character of each run. Each run is compared with what was heard (fn edist); the most alike wins, the
note shorter run among equals. Returns which run (1 to 4), or 0 for no fix: the winner is less than half alike, or
note is the very text that was heard (the host says which runs are: bit k-1 of sm). 255: a spelling is too long
fn pick b view uchar 1048576 n ulong aux ulong sm ulong to ulong
r = new ulong 8 0
if gt aux n
ret 255
end
bk = ulong 0
bn = ulong 0
bd = ulong 1
k = ulong 0
i = aux
while lt i n bound 999999
e = i
while lt e n bound 999999
f = cfl b e
e = add e 1
if ne and f 16 0
break
end
end
k = add k 1
if gt k 4
break
end
put r 0 0
put r 1 aux
put r 2 i
put r 3 e
if ne edist b r 0
ret 255
end
m = get r 5
nu = ulong 1
de = ulong 1
if gt m 0
nu = sub m get r 4
de = m
end
if eq bk 0
bk = k
bn = nu
bd = de
else
if gt mul nu bd mul bn de
bk = k
bn = nu
bd = de
end
end
i = e
end
if eq bk 0
ret 0
end
if lt mul bn 2 bd
ret 0
end
if ne and shr sm sub bk 1 1 0
ret 0
end
ret bk
end

note kind 3: op, the number of characters n (at most 16384), aux and 0 as four 32-bit numbers, then n character
note words. Returns the reply length, or 18446744073709551615 for a malformed body or an unknown op
fn texts ib view uchar 1048576 nb ulong ob edit uchar 65544 to ulong
bad = ulong 18446744073709551615
if lt nb 16
ret bad
end
op = rd32 ib 0
n = rd32 ib 4
aux = rd32 ib 8
if gt n 16384
ret bad
end
if ne nb add 16 mul n 8
ret bad
end
if eq op 1
put ob 8 uchar qlike ib n
ret 1
end
if eq op 2
ret keyw ib n ob
end
if eq op 3
put ob 8 uchar weba ib n aux
ret 1
end
if eq op 4
ret alike ib n aux ob
end
if eq op 5
put ob 8 uchar pick ib n aux rd32 ib 12
ret 1
end
ret bad
end

note ---- the helper process ----
note hopcore main: Hop's core as a helper process. A request is 8 bytes (kind, then body length n, both 32-bit
note little-endian) and n body bytes, n at most 1048576. The reply is 8 bytes (status, then length m) and m bytes.
note Status 0 is an answer; 1 an unknown kind; 2 a malformed body. End of input ends it with status 0; a body
note over the limit or a short read ends it with status 3 (the host starts a fresh one).
note Kind 1, names: the body is k cases of 2048 bytes (256 words, the hopfuzz input); 3 bytes back per case:
note verdict, score low byte, score high byte. At most 512 cases.
note Kind 2, paths: 16-bit little-endian fields: number of terms (at most 64), number of paths (at most 16000);
note each term as length then bytes; each path as three lengths (its lowercased bytes, its name's lowercased
note bytes, the path as written), then the path bytes, then the name bytes. 4 bytes back per path: 0 for no
note match, else the score plus 1000000.
note Kind 3, text: see fn texts. Op 1 and op 3 answer one byte; op 2 a count, then two 16-bit numbers a word;
note op 4 two 16-bit numbers; op 5 one byte.
note Kind 4, corrected words: see fn wdiff. Kind 5, a board line or a time: see fn board. Kind 6, a whole board: see fn asm. Kind 7, the members' state and the graph: see fn status.

note fill b[0 .. n) from stdin; false at end of input or on a short read
fn rdn b edit uchar 1048576 n ulong to bool
got = ulong 0
while lt got n bound 999999
k = read 0 b got sub n got
if le k 0
ret false
end
got = add got ulong k
end
ret true
end

fn wrn b view uchar 65544 n ulong to bool
p = ulong 0
while lt p n bound 999999
k = write 1 b p sub n p
if le k 0
ret false
end
p = add p ulong k
end
ret true
end

fn put32 b edit uchar 65544 o ulong v ulong to void
put b o uchar and v 255
put b add o 1 uchar and shr v 8 255
put b add o 2 uchar and shr v 16 255
put b add o 3 uchar and shr v 24 255
end

note kind 1: returns the reply length, or 18446744073709551615 for a malformed body
note ---- one line of a plain-text board (kind 5) ----
note A swarm's board is a text file, one post a line:
note   <time> <sender> (<detail>) to <recipient> + <recipient> (<detail>): <text>
note Also read: several senders joined by " + ", no "to" part, recipients written "@name", a leading "- ", and
note words between the sender's bracket and the colon (they stay in the text). A line that does not start with a
note time is not a post. A header that does not fit the form is read plainly: the first word is the sender, the
note rest is the text. The answer names every part by where it starts in the line and how long it is.
note Limits: 65536 bytes of line, 600 of header, 4 senders, 16 recipients, 64 bytes and 3 words a name, 32768 bytes
note of text; over a limit the part is cut at a whole character and the answer says so.

note byte i of the line (the line follows the 8-byte op header of the request)
fn lc b view uchar 1048576 i ulong to ulong
ret ulong get b add 8 i
end

fn lsp c ulong to bool
ret or eq c 32 eq c 9
end

note the two digits at byte i of the n-byte line as a number, or 100
fn l2d b view uchar 1048576 i ulong n ulong to ulong
if ge add i 1 n
ret 100
end
x = lc b i
y = lc b add i 1
if or lt x 48 gt x 57
ret 100
end
if or lt y 48 gt y 57
ret 100
end
ret add mul sub x 48 10 sub y 48
end

note out[k], out[k+1]: the bytes lo..hi without spaces at either end (equal when nothing is left)
fn ltrim b view uchar 1048576 lo ulong hi ulong outv edit ulong 8 k ulong to void
a = lo
e = hi
while lt a e bound 999999
if not lsp lc b a
break
end
a = add a 1
end
while gt e a bound 999999
if not lsp lc b sub e 1
break
end
e = sub e 1
end
put outv k a
put outv add k 1 e
end

note where a text of bytes a..e is cut to lim bytes without splitting a character (e when it is short enough)
fn lclip b view uchar 1048576 a ulong e ulong lim ulong to ulong
if le sub e a lim
ret e
end
ce = add a lim
back = ulong 0
while gt ce a bound 8
if ge back 3
break
end
if ne and lc b ce 192 128
break
end
ce = sub ce 1
back = add back 1
end
ret ce
end

note "YYYY-MM-DD", then optionally "T" or one space and "HH:MM" or "HH:MM:SS", a fraction, and "Z" or an offset
note such as "+00:00", from byte s of the n-byte line. Returns 1 when it is a time, from 1970 on. tm: 1 the
note seconds since 1970 as written (less the offset when one is named) plus 100000, 2 the first byte after the
note time, 3 1 when the text names its zone
fn ltime b view uchar 1048576 s ulong n ulong tm edit ulong 16 to ulong
if gt add s 10 n
ret 0
end
ce = l2d b s n
yy = l2d b add s 2 n
mo = l2d b add s 5 n
dy = l2d b add s 8 n
if or eq ce 100 eq yy 100
ret 0
end
if or or lt mo 1 gt mo 12 or lt dy 1 gt dy 31
ret 0
end
if or ne lc b add s 4 45 ne lc b add s 7 45
ret 0
end
yr = add mul ce 100 yy
if lt yr 1970
ret 0
end
p = add s 10
sec = ulong 0
off = ulong 0
pls = ulong 0
zoned = ulong 0
tp = ulong 0
if lt add p 5 n
tp = lc b p
end
if or eq tp 84 eq tp 32
hr = l2d b add p 1 n
mi = l2d b add p 4 n
okhm = false
if and lt hr 24 lt mi 60
if eq lc b add p 3 58
okhm = true
end
end
if okhm
sec = add mul hr 3600 mul mi 60
p = add p 6
if lt p n
if eq lc b p 58
sx = l2d b add p 1 n
if lt sx 61
sec = add sec sx
p = add p 3
end
end
end
if lt p n
if eq lc b p 46
q = add p 1
while lt q n bound 32
if gt sub q p 9
break
end
c = lc b q
if or lt c 48 gt c 57
break
end
q = add q 1
end
if gt q add p 1
p = q
end
end
end
if lt p n
zc = lc b p
if or eq zc 90 eq zc 122
zoned = 1
p = add p 1
else
if or eq zc 43 eq zc 45
oh = l2d b add p 1 n
om = ulong 100
used = ulong 5
c3 = false
if lt add p 3 n
if eq lc b add p 3 58
c3 = true
end
end
if c3
om = l2d b add p 4 n
used = 6
else
om = l2d b add p 3 n
end
if and lt oh 24 lt om 60
o = add mul oh 3600 mul om 60
if eq zc 43
off = o
else
pls = o
end
zoned = 1
p = add p used
end
end
end
end
else
if eq tp 84
ret 0
end
end
else
if lt p n
if eq lc b p 84
ret 0
end
end
end
y = yr
if le mo 2
y = sub yr 1
end
era = div y 400
yoe = sub y mul era 400
mm = add mo 9
if gt mo 2
mm = sub mo 3
end
doy = sub add div add mul 153 mm 2 5 dy 1
doe = add sub add mul yoe 365 div yoe 4 div yoe 100 doy
days = sub add mul era 146097 doe 719468
put tm 1 sub add add add mul days 86400 sec 100000 pls off
put tm 2 p
put tm 3 zoned
ret 1
end

note one name from byte lo, stopping before " + ", before "(" and, on the sender side (side 1), before " to "
note and " @". A bracket right after the name is its detail. nr: 0 and 1 the name, 2 and 3 the detail, 4 the first
note byte after the name, its bracket and the spaces that follow, 5 1 when there was a bracket
fn lname b view uchar 1048576 lo ulong limit ulong side ulong nr edit ulong 8 to void
i = lo
while lt i limit bound 999999
if not lsp lc b i
break
end
i = add i 1
end
start = i
while lt i limit bound 999999
c = lc b i
if eq c 40
break
end
stop = false
if eq c 32
if lt add i 1 limit
d = lc b add i 1
if eq d 43
if ge add i 2 limit
stop = true
else
if eq lc b add i 2 32
stop = true
end
end
end
if eq side 1
if eq d 64
stop = true
end
if eq d 116
if lt add i 2 limit
if eq lc b add i 2 111
if ge add i 3 limit
stop = true
else
if eq lc b add i 3 32
stop = true
end
end
end
end
end
end
end
end
if stop
break
end
i = add i 1
end
ltrim b start i nr 0
while lt i limit bound 999999
if not lsp lc b i
break
end
i = add i 1
end
put nr 2 0
put nr 3 0
put nr 5 0
if lt i limit
if eq lc b i 40
depth = ulong 0
j = i
while lt j limit bound 999999
cj = lc b j
if eq cj 40
depth = add depth 1
else
if eq cj 41
depth = sub depth 1
if eq depth 0
break
end
end
end
j = add j 1
end
ltrim b add i 1 j nr 2
put nr 5 1
i = limit
if lt j limit
i = add j 1
end
while lt i limit bound 999999
if not lsp lc b i
break
end
i = add i 1
end
end
end
put nr 4 i
end

note a name fits when it has 1 to 64 bytes and at most 3 words
fn lfits b view uchar 1048576 a ulong e ulong to bool
if le e a
ret false
end
if gt sub e a 64
ret false
end
n = ulong 0
inw = false
i = a
while lt i e bound 999999
if lsp lc b i
inw = false
else
if not inw
inw = true
n = add n 1
end
end
i = add i 1
end
ret le n 3
end

note "all", "all lanes", "everyone" (any case, a leading "@" dropped): the whole board, not one member.
note The name fits (lfits), so its key has at most 64 bytes
fn levery b view uchar 1048576 a ulong e ulong to bool
k = new uchar 80 0
n = ulong 0
i = a
if lt i e
if eq lc b i 64
i = add i 1
end
end
gap = false
while lt i e bound 999999
c = lc b i
if lsp c
gap = true
else
if and gap gt n 0
put k n uchar 45
n = add n 1
end
gap = false
if and ge c 65 le c 90
c = add c 32
end
put k n uchar c
n = add n 1
end
i = add i 1
end
if lt n 3
ret false
end
al = and and eq ulong get k 0 97 eq ulong get k 1 108 eq ulong get k 2 108
if eq n 3
ret al
end
if gt n 4
if and al eq ulong get k 3 45
ret true
end
end
if ne n 8
ret false
end
ev = and and eq ulong get k 0 101 eq ulong get k 1 118 and eq ulong get k 2 101 eq ulong get k 3 114
ev = and ev and and eq ulong get k 4 121 eq ulong get k 5 111 and eq ulong get k 6 110 eq ulong get k 7 101
ret ev
end

note where a part starts and how long it is, at byte o of the answer
fn lput ob edit uchar 65544 o ulong s ulong e ulong to void
l = ulong 0
if gt e s
l = sub e s
end
put32 ob add 8 o s
put32 ob add 12 o l
end

note op 1: one board line of n0 bytes. The answer is 344 bytes: 0 1 when it is a post, 1 1 when it is to all,
note 2 1 when something went over a limit, 3 the senders, 4 the recipients; 8 the time (64-bit, seconds since 1970
note plus 100000); 16 the text; from 24 sixteen bytes a sender (name, detail), from 88 sixteen a recipient. Each
note part is two 32-bit numbers: where it starts in the line and its length
fn lline b view uchar 1048576 n0 ulong ob edit uchar 65544 to ulong
tm = new ulong 16 0
nr = new ulong 8 0
for z ulong 344
put ob add 8 z uchar 0
end
n = n0
clipped = ulong 0
if gt n 65536
n = lclip b 0 n 65536
clipped = 1
end
put ob 10 uchar clipped
en = n
while gt en 0 bound 999999
c = lc b sub en 1
blank = lsp c
if or eq c 13 eq c 10
blank = true
end
if not blank
break
end
en = sub en 1
end
p = ulong 0
while lt p en bound 999999
if not lsp lc b p
break
end
p = add p 1
end
if lt add p 1 en
if and eq lc b p 45 eq lc b add p 1 32
p = add p 2
end
end
if eq ltime b p n tm 0
ret 344
end
te = get tm 2
if ge te en
ret 344
end
if not lsp lc b te
ret 344
end
p = te
while lt p en bound 999999
if not lsp lc b p
break
end
p = add p 1
end
if ge p en
ret 344
end
put ob 8 uchar 1
tv = get tm 1
put32 ob 16 tv
put32 ob 20 shr tv 32
bst = p
colon = ulong 0
hasc = false
depth = ulong 0
i = p
while lt i en bound 999999
if ge sub i p 600
break
end
c = lc b i
if eq c 40
depth = add depth 1
else
if eq c 41
if gt depth 0
depth = sub depth 1
end
else
if and eq c 58 eq depth 0
nx = true
if lt add i 1 en
if ne lc b add i 1 32
nx = false
end
end
if nx
colon = i
hasc = true
break
end
end
end
end
i = add i 1
end
fits = hasc
ts = add colon 1
q = p
md = ulong 0
ns = ulong 0
nrc = ulong 0
tall = ulong 0
rnd = ulong 0
while and and fits eq md 0 lt rnd 64 bound 100
rnd = add rnd 1
lname b q colon 1 nr
if not lfits b get nr 0 get nr 1
fits = false
break
end
if lt ns 4
lput ob add 24 mul ns 16 get nr 0 get nr 1
lput ob add 32 mul ns 16 get nr 2 get nr 3
ns = add ns 1
else
clipped = 1
end
x = get nr 4
if ge x colon
md = 3
else
cx = lc b x
did = false
if eq cx 43
sp = true
if lt add x 1 colon
if ne lc b add x 1 32
sp = false
end
end
if sp
q = add x 1
did = true
end
end
if not did
if eq cx 116
if lt add x 2 colon
if and eq lc b add x 1 111 eq lc b add x 2 32
md = 1
q = add x 3
did = true
end
end
end
end
if not did
if eq cx 64
md = 2
q = x
did = true
end
end
if not did
if eq get nr 5 1
md = 3
ts = x
else
fits = false
end
end
end
end
if and fits eq md 0
fits = false
end
rnd = 0
while and and fits eq md 1 lt rnd 64 bound 100
rnd = add rnd 1
lname b q colon 0 nr
a = get nr 0
e = get nr 1
if gt e a
if eq lc b a 64
a = add a 1
end
end
if not lfits b a e
fits = false
break
end
if levery b a e
tall = 1
else
if lt nrc 16
lput ob add 88 mul nrc 16 a e
lput ob add 96 mul nrc 16 get nr 2 get nr 3
nrc = add nrc 1
else
clipped = 1
end
end
x = get nr 4
if ge x colon
md = 3
else
plus = false
if eq lc b x 43
plus = true
if lt add x 1 colon
if ne lc b add x 1 32
plus = false
end
end
end
if plus
q = add x 1
else
fits = false
end
end
end
if and fits eq md 1
fits = false
end
rnd = 0
while and and fits eq md 2 lt rnd 64 bound 100
rnd = add rnd 1
while lt q colon bound 999999
c = lc b q
if not or lsp c eq c 43
break
end
q = add q 1
end
if ge q colon
md = 3
break
end
if ne lc b q 64
fits = false
break
end
j = add q 1
while lt j colon bound 999999
if lsp lc b j
break
end
j = add j 1
end
ltrim b add q 1 j nr 0
a = get nr 0
e = get nr 1
if not lfits b a e
fits = false
break
end
if levery b a e
tall = 1
else
if lt nrc 16
lput ob add 88 mul nrc 16 a e
nrc = add nrc 1
else
clipped = 1
end
end
q = j
end
if and fits eq md 2
fits = false
end
if not fits
for z ulong 320
put ob add 32 z uchar 0
end
ns = 1
nrc = 0
tall = 0
j = bst
while lt j en bound 999999
if lsp lc b j
break
end
j = add j 1
end
ltrim b bst j nr 0
a = get nr 0
e = get nr 1
if gt sub e a 1
if eq lc b sub e 1 58
e = sub e 1
end
end
if gt sub e a 64
e = lclip b a e 64
clipped = 1
end
lput ob 24 a e
ts = j
end
ltrim b ts en nr 0
a = get nr 0
e = get nr 1
if gt e a
if gt sub e a 32768
e = lclip b a e 32768
clipped = 1
end
end
lput ob 16 a e
put ob 9 uchar tall
put ob 10 uchar clipped
put ob 11 uchar ns
put ob 12 uchar nrc
ret 344
end

note ---- who a post calls and which posts it cites (kind 5 op 3) ----
note "@name", "@all", "@#channel" and "#seq" in the text of a post. A mention counts only at a word start: the
note character before "@" or "#" must not be a name character, and the name must not run on into more name
note characters. Positions in these functions are places in the request: the text is the bytes t0..t1.

note the character that starts at byte i, as a code point; 4294967295 at or after t1. A broken sequence gives its
note first byte
fn rune b view uchar 1048576 i ulong t1 ulong to ulong
if ge i t1
ret 4294967295
end
b0 = ulong get b i
if or lt b0 128 ge b0 248
ret b0
end
if lt b0 192
ret b0
end
need = ulong 1
cp = and b0 31
if ge b0 224
need = 2
cp = and b0 15
end
if ge b0 240
need = 3
cp = and b0 7
end
k = ulong 1
while le k need bound 8
if ge add i k t1
ret b0
end
c = ulong get b add i k
if ne and c 192 128
ret b0
end
cp = or shl cp 6 and c 63
k = add k 1
end
ret cp
end

note the character that ends just before byte e; 4294967295 at the start of the text
fn runeb b view uchar 1048576 e ulong t0 ulong t1 ulong to ulong
if or le e t0 gt e t1
ret 4294967295
end
i = sub e 1
back = ulong 0
while gt i t0 bound 8
if ge back 3
break
end
if ne and ulong get b i 192 128
break
end
i = sub i 1
back = add back 1
end
ret rune b i t1
end

note can this character be part of a name? Letters, digits, "_" and "-"; outside ASCII everything except the
note blocks that hold punctuation, symbols and emoji
fn namer cp ulong to bool
if eq cp 4294967295
ret false
end
if lt cp 128
if and ge cp 48 le cp 57
ret true
end
if and ge cp 65 le cp 90
ret true
end
if and ge cp 97 le cp 122
ret true
end
ret or eq cp 95 eq cp 45
end
if or or lt cp 192 eq cp 215 eq cp 247
ret false
end
if and ge cp 8192 le cp 11263
ret false
end
if and ge cp 12288 le cp 12351
ret false
end
if and ge cp 65072 le cp 65135
ret false
end
if or and ge cp 65280 le cp 65295 and ge cp 65306 le cp 65312
ret false
end
if or and ge cp 65339 le cp 65344 and ge cp 65371 le cp 65381
ret false
end
if and ge cp 126976 le cp 129791
ret false
end
ret true
end

fn lowc c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note true when the ln bytes at na stand at byte pos of the text (ASCII letters without case) and no name
note character follows them
fn nameat b view uchar 1048576 pos ulong na ulong ln ulong t1 ulong to bool
if eq ln 0
ret false
end
if gt add pos ln t1
ret false
end
for k ulong ln
if ne lowc ulong get b add pos k lowc ulong get b add na k
ret false
end
end
ret not namer rune b add pos ln t1
end

note "all" at byte pos, and no name character after it
fn allat b view uchar 1048576 pos ulong t1 ulong to bool
if gt add pos 3 t1
ret false
end
if ne lowc ulong get b pos 97
ret false
end
if ne lowc ulong get b add pos 1 108
ret false
end
if ne lowc ulong get b add pos 2 108
ret false
end
ret not namer rune b add pos 3 t1
end

note a member called "<prefix>-<digits>" also answers to "@<prefix>": the length of that prefix, or 0
fn cprefix b view uchar 1048576 na ulong nl ulong to ulong
i = nl
while gt i 0 bound 999999
c = ulong get b add na sub i 1
if or lt c 48 gt c 57
break
end
i = sub i 1
end
if eq i nl
ret 0
end
if lt i 2
ret 0
end
if ne ulong get b add na sub i 1 45
ret 0
end
ret sub i 1
end

note the length of a channel name at byte pos (after "@#"): a letter, then letters, digits and "-", 24 at most
fn chlen b view uchar 1048576 pos ulong t1 ulong to ulong
if ge pos t1
ret 0
end
f = lowc ulong get b pos
if or lt f 97 gt f 122
ret 0
end
j = pos
while lt j t1 bound 64
if ge sub j pos 25
break
end
c = lowc ulong get b j
okc = and ge c 97 le c 122
if and ge c 48 le c 57
okc = true
end
if eq c 45
okc = true
end
if not okc
break
end
j = add j 1
end
n = sub j pos
if gt n 24
ret 0
end
if namer rune b j t1
ret 0
end
ret n
end

note part idx of the answer: where it starts in the text, its length, its kind (1 a member, 2 all, 3 a channel,
note 4 a cited post) and its value (the member's number, or the post's)
fn semit ob edit uchar 65544 idx ulong s ulong l ulong kind ulong v ulong to void
o = add 16 mul idx 16
put32 ob o s
put32 ob add o 4 l
put32 ob add o 8 kind
put32 ob add o 12 v
end

note op 3: n bytes after the op header: a 16-bit count of member names (96 at most), each name as a 16-bit length
note and its bytes, then the text (900000 bytes at most). head is the highest post number that may be cited; 0
note turns citations off. The answer: a 16-bit count of parts, a byte that is 1 when the post has more than 128
note parts (the rest is not marked), then from byte 8 sixteen bytes a part (semit), in text order. Parts that
note start at one byte are kept or dropped together
fn spans b view uchar 1048576 n ulong head ulong ob edit uchar 65544 to ulong
noff = new ulong 96 0
nlen = new ulong 96 0
npre = new ulong 96 0
bad = ulong 18446744073709551615
if lt n 2
ret bad
end
nn = rd16 b 8
if gt nn 96
ret bad
end
lim = add 8 n
p = ulong 10
for k ulong nn
if gt add p 2 lim
ret bad
end
l = rd16 b p
p = add p 2
if gt add p l lim
ret bad
end
put noff k p
put nlen k l
put npre k cprefix b p l
p = add p l
end
t0 = p
t1 = lim
if gt sub t1 t0 900000
ret bad
end
cnt = ulong 0
clipped = ulong 0
i = t0
while lt i t1 bound 999999
c = ulong get b i
st = ulong 1
g = ulong 0
mark = or eq c 64 eq c 35
if mark
if namer runeb b i t0 t1
mark = false
end
end
if mark
if eq c 64
nxt = ulong 0
if lt add i 1 t1
nxt = ulong get b add i 1
end
if eq nxt 35
cl = chlen b add i 2 t1
if gt cl 0
semit ob cnt sub i t0 add cl 2 3 0
g = 1
st = add cl 2
end
else
for k ulong nn
if nameat b add i 1 get noff k get nlen k t1
semit ob add cnt g sub i t0 add get nlen k 1 1 k
g = add g 1
end
end
if eq g 0
if allat b add i 1 t1
semit ob add cnt g sub i t0 4 2 0
g = 1
end
end
k2 = ulong 0
while lt k2 nn bound 128
if gt g 0
break
end
pk = get npre k2
if gt pk 0
if nameat b add i 1 get noff k2 pk t1
j = k2
while lt j nn bound 128
if eq get npre j pk
if nameat b add i 1 get noff j pk t1
semit ob add cnt g sub i t0 add pk 1 1 j
g = add g 1
end
end
j = add j 1
end
end
end
k2 = add k2 1
end
end
else
if gt head 0
if ne runeb b i t0 t1 38
j = add i 1
v = ulong 0
while lt j t1 bound 16
if gt sub j i 9
break
end
d = ulong get b j
if or lt d 48 gt d 57
break
end
v = add mul v 10 sub d 48
j = add j 1
end
if gt j add i 1
if and ge v 1 le v head
if not namer rune b j t1
semit ob cnt sub i t0 sub j i 4 v
g = 1
st = sub j i
end
end
end
end
end
end
end
if gt g 0
if gt add cnt g 128
clipped = 1
break
end
cnt = add cnt g
end
i = add i st
end
put ob 8 uchar and cnt 255
put ob 9 uchar shr cnt 8
put ob 10 uchar clipped
for z ulong 5
put ob add 11 z uchar 0
end
ret add 8 mul cnt 16
end

note ---- who a post addresses (kind 5 op 4) ----
note the members its header names, the members its text calls with "@name" or reaches through "@#channel", and
note whether it is to everyone. The sender is left out.

note two runs of bytes of the request, equal when ASCII letters are compared without case
fn eqf b view uchar 1048576 x ulong xl ulong y ulong yl ulong to bool
if ne xl yl
ret false
end
for k ulong xl
if ne lowc ulong get b add x k lowc ulong get b add y k
ret false
end
end
ret true
end

note "main", "all" and "here" are not channels anyone follows
fn chplain b view uchar 1048576 x ulong n ulong to bool
if eq n 3
ret and and eq lowc ulong get b x 97 eq lowc ulong get b add x 1 108 eq lowc ulong get b add x 2 108
end
if ne n 4
ret false
end
c0 = lowc ulong get b x
c1 = lowc ulong get b add x 1
c2 = lowc ulong get b add x 2
c3 = lowc ulong get b add x 3
if and and eq c0 109 eq c1 97 and eq c2 105 eq c3 110
ret true
end
ret and and eq c0 104 eq c1 101 and eq c2 114 eq c3 101
end

note does a member follow the channel named by the xl bytes at x? cp is where the member's channel list starts: a
note count, then each channel as a 16-bit length and its bytes. An empty list is the role's default: everyone but a
note worker (role 0) follows every channel. "*" follows every channel
fn follows b view uchar 1048576 role ulong cp ulong x ulong xl ulong to bool
cc = ulong get b cp
if eq cc 0
ret ne role 0
end
p = add cp 1
for i ulong cc
l = rd16 b p
if eq l 1
if eq ulong get b add p 2 42
ret true
end
end
if eqf b add p 2 l x xl
ret true
end
p = add add p 2 l
end
ret false
end

note op 4: n bytes after the op header: 16-bit counts of members (96 at most), parts (128) and header recipients
note (16); a byte that is 1 when the header says all; a byte 0; the sender as a 32-bit member number; a byte a
note member (0 for a worker); the header's recipients, 32 bits each; the parts as fn spans gives them; for each
note member its channel list (follows); then the text of the post. A number that is not a member is 4294967295.
note The answer: a byte that is 1 when the post is to everyone, a count, then that many member numbers
fn addr b view uchar 1048576 n ulong ob edit uchar 65544 to ulong
flag = new ulong 96 0
coff = new ulong 96 0
bad = ulong 18446744073709551615
if lt n 12
ret bad
end
lim = add 8 n
mem = rd16 b 8
nsp = rd16 b 10
nh = rd16 b 12
tall = ulong get b 14
sender = rd32 b 16
if or gt mem 96 or gt nsp 128 gt nh 16
ret bad
end
roles = ulong 20
hto = add roles mem
sp = add hto mul nh 4
p = add sp mul nsp 16
if gt p lim
ret bad
end
for m ulong mem
if ge p lim
ret bad
end
put coff m p
cc = ulong get b p
if gt cc 16
ret bad
end
p = add p 1
for c ulong cc
if gt add p 2 lim
ret bad
end
p = add add p 2 rd16 b p
if gt p lim
ret bad
end
end
end
t0 = p
tn = sub lim t0
for i ulong nh
v = rd32 b add hto mul i 4
if lt v mem
put flag v 1
end
end
for s ulong nsp
o = add sp mul s 16
start = rd32 b o
ln = rd32 b add o 4
kind = rd32 b add o 8
v = rd32 b add o 12
if eq kind 1
if lt v mem
put flag v 1
end
end
if eq kind 2
tall = 1
end
if eq kind 3
if and gt ln 2 le add start ln tn
cx = add add t0 start 2
cl = sub ln 2
if not chplain b cx cl
for m ulong mem
if follows b ulong get b add roles m get coff m cx cl
put flag m 1
end
end
end
end
end
end
if lt sender mem
put flag sender 0
end
cnt = ulong 0
for m ulong mem
if eq get flag m 1
put ob add 10 cnt uchar m
cnt = add cnt 1
end
end
if ne tall 0
tall = 1
end
put ob 8 uchar tall
put ob 9 uchar cnt
ret add 2 cnt
end

note kind 5: op and a number as two 32-bit values, then the bytes of the text (at most 70000 for op 1 and 2).
note op 1: a board line (fn lline). op 2: a time at byte `number` (fn ltime); the answer is 16 bytes: 0 1 when it
note is a time, 1 1 when it names its zone, 4 the first byte after it (32-bit), 8 the seconds since 1970 plus 100000
note (64-bit). op 3: who a post calls and what it cites (fn spans; the number is the highest post that may be
note cited). op 4: who a post addresses (fn addr). Returns the reply length, or 18446744073709551615 for a malformed body or an unknown op
fn board ib view uchar 1048576 nb ulong ob edit uchar 65544 to ulong
tm = new ulong 16 0
bad = ulong 18446744073709551615
if lt nb 8
ret bad
end
op = rd32 ib 0
arg = rd32 ib 4
n = sub nb 8
if eq op 3
ret spans ib n arg ob
end
if eq op 4
ret addr ib n ob
end
if gt n 70000
ret bad
end
if eq op 1
ret lline ib n ob
end
if eq op 2
for z ulong 16
put ob add 8 z uchar 0
end
if eq ltime ib arg n tm 1
put ob 8 uchar 1
put ob 9 uchar get tm 3
put32 ob 12 get tm 2
put32 ob 16 get tm 1
put32 ob 20 shr get tm 1 32
end
ret 16
end
ret bad
end

note ---- a whole plain-text board: its members and who each post is from and to (kind 6) ----
note The host reads each line (kind 5 op 1) and sends what the lines name: for each line a byte that is 1 for a
note post, a byte that is 1 when it was cut, the number of senders (4 at most) and of recipients (16 at most), then
note each sender and each recipient as a 16-bit length and the name, a 16-bit length and the bracket after it.
note Senders and recipients become members. Two spellings are one member when they share a key (no leading "@",
note ASCII lower case, each run of spaces one "-"); when one stands in the brackets of one agent only and is used
note as a sender or recipient elsewhere ("merge-desk (omp-queen-spark)"); or when it is that agent's name without
note its lane ("Worker" for "lane/Worker") and exactly one sender posts under a name that ends that way.
note Limits: 400 lines, 192 spellings, 96 members, 8 comma-separated items in a bracket.
global a_keys uchar 12288
global a_kl ulong 192
global a_sref ulong 192
global a_own ulong 192
global a_can ulong 192
global a_mem ulong 192
global a_lo ulong 400
global a_kb uchar 72
global a_e ulong 8
global a_ds ulong 96

note entry k of side (0 senders, 1 recipients) of the line record at p. a_e: 0 and 1 the name, 2 and 3 the bracket
fn aent b view uchar 1048576 p ulong side ulong k ulong to void
skip = k
if eq side 1
skip = add k ulong get b add p 2
end
q = add p 4
for i ulong skip
q = add add q 2 rd16 b q
q = add add q 2 rd16 b q
end
nl = rd16 b q
put a_e 0 add q 2
put a_e 1 nl
q = add add q 2 nl
put a_e 2 add q 2
put a_e 3 rd16 b q
end

note the key of the n bytes at off into a_kb; its length, or 65 when it is over 64 bytes (no member has such a key)
fn akey b view uchar 1048576 off ulong n ulong to ulong
a = off
e = add off n
while lt a e bound 999999
if not lsp ulong get b a
break
end
a = add a 1
end
while gt e a bound 999999
if not lsp ulong get b sub e 1
break
end
e = sub e 1
end
if lt a e
if eq ulong get b a 64
a = add a 1
end
end
kn = ulong 0
gap = false
while lt a e bound 999999
c = ulong get b a
if lsp c
gap = true
else
if and gap gt kn 0
if ge kn 64
ret 65
end
put a_kb kn uchar 45
kn = add kn 1
end
gap = false
if ge kn 64
ret 65
end
put a_kb kn uchar lowc c
kn = add kn 1
end
a = add a 1
end
ret kn
end

note where the key in a_kb (kn bytes) stands among the first nk keys, or 1000
fn afind kn ulong nk ulong to ulong
if gt kn 64
ret 1000
end
i = ulong 0
while lt i nk bound 256
if eq get a_kl i kn
j = ulong 0
while lt j kn bound 128
if ne ulong get a_keys add mul i 64 j ulong get a_kb j
break
end
j = add j 1
end
if eq j kn
ret i
end
end
i = add i 1
end
ret 1000
end

note "L1122" or "L1124/L1125": a ledger number, never another name of the agent
fn aledger b view uchar 1048576 off ulong n ulong to bool
i = ulong 0
parts = ulong 0
while lt i n bound 16
if ge parts 8
break
end
c = ulong get b add off i
if and ne c 76 ne c 108
ret false
end
j = add i 1
while lt j n bound 16
if gt sub j i 9
break
end
d = ulong get b add off j
if or lt d 48 gt d 57
break
end
j = add j 1
end
if eq j add i 1
ret false
end
parts = add parts 1
if eq j n
ret true
end
if ne ulong get b add off j 47
ret false
end
i = add j 1
end
ret false
end

note the main spelling of the set that holds spelling s
fn aroot s ulong nk ulong to ulong
i = s
hops = ulong 0
while lt i nk bound 256
if eq get a_can i i
break
end
if ge hops 192
break
end
i = get a_can i
hops = add hops 1
end
ret i
end

note joins the sets that hold x0 and y0; the earlier spelling stays the main one
fn ajoin x0 ulong y0 ulong nk ulong to void
x = aroot x0 nk
y = aroot y0 nk
if or ge x nk ge y nk
ret
end
if eq x y
ret
end
if lt x y
put a_can y x
else
put a_can x y
end
end

note is key f the key s with a lane in front: "lane/s"?
fn alane f ulong s ulong to bool
fl = get a_kl f
sl = get a_kl s
if eq sl 0
ret false
end
if lt fl add sl 2
ret false
end
p = sub fl sl
if ne ulong get a_keys add mul f 64 sub p 1 47
ret false
end
i = ulong 0
while lt i sl bound 128
if ne ulong get a_keys add add mul f 64 p i ulong get a_keys add mul s 64 i
ret false
end
i = add i 1
end
ret true
end

note the member that the name of the current entry (a_e) belongs to, or 1000
fn amember b view uchar 1048576 nk ulong to ulong
f = afind akey b get a_e 0 get a_e 1 nk
if ge f 1000
ret 1000
end
ret get a_mem f
end

note kind 6: a 32-bit count of lines, then the line records. The answer: 16-bit counts of members, of joined
note spellings and of posts; from byte 8 four 32-bit counts: lines that are not posts, posts that were cut,
note agents beyond 96 members, names met after the 192 spellings were full; from byte 24 eight bytes a member:
note the line (16-bit), side and entry of its newest spelling, then the line (65535: none) and entry of the newest
note bracket after it as a sender; six bytes a joined spelling: its member, 0, then line, side and entry; then a
note post each: its sender (255: none), how many others signed and how many members its header names, then
note those members. Returns the reply length, or 18446744073709551615 for a malformed body
fn asm b view uchar 1048576 n ulong ob edit uchar 65544 to ulong
wl = new ulong 8 0
to2 = new ulong 24 0
bad = ulong 18446744073709551615
if lt n 4
ret bad
end
nl = rd32 b 0
if gt nl 400
ret bad
end
p = ulong 4
for li ulong nl
if gt add p 4 n
ret bad
end
put a_lo li p
ns = ulong get b add p 2
nr = ulong get b add p 3
if or gt ns 4 gt nr 16
ret bad
end
p = add p 4
for k ulong mul 2 add ns nr
if gt add p 2 n
ret bad
end
p = add add p 2 rd16 b p
if gt p n
ret bad
end
end
end
nk = ulong 0
sdrop = ulong 0
skeys = ulong 0
for pz ulong 2
for lr ulong nl
lq = sub sub nl 1 lr
p = get a_lo lq
if eq ulong get b p 1
cnt = ulong get b add p 2
if eq pz 1
cnt = ulong get b add p 3
end
for k ulong cnt
aent b p pz k
kn = akey b get a_e 0 get a_e 1
if and gt kn 0 le kn 64
if ge afind kn nk 1000
if lt nk 192
for j ulong kn
put a_keys add mul nk 64 j get a_kb j
end
put a_kl nk kn
put a_sref nk or or shl lq 16 shl pz 8 k
nk = add nk 1
else
sdrop = add sdrop 1
end
end
end
end
end
end
if eq pz 0
skeys = nk
end
end
for c ulong nk
put a_own c 1000
put a_can c c
put a_mem c 1000
end
for li ulong nl
p = get a_lo li
if eq ulong get b p 1
for side ulong 2
cnt = ulong get b add p 2
if eq side 1
cnt = ulong get b add p 3
end
for k ulong cnt
aent b p side k
d0 = get a_e 2
dn = get a_e 3
outer = afind akey b get a_e 0 get a_e 1 nk
a = ulong 0
items = ulong 0
while le a dn bound 1024
if ge outer 1000
break
end
if ge items 8
break
end
e = a
while lt e dn bound 999999
if eq ulong get b add d0 e 44
break
end
e = add e 1
end
x = a
y = e
while lt x y bound 999999
if not lsp ulong get b add d0 x
break
end
x = add x 1
end
while gt y x bound 999999
if not lsp ulong get b add d0 sub y 1
break
end
y = sub y 1
end
if lt x y
if not aledger b add d0 x sub y x
inner = afind akey b add d0 x sub y x nk
if lt inner 1000
if ne inner outer
if eq get a_own inner 1000
put a_own inner outer
else
if ne get a_own inner outer
put a_own inner 2000
end
end
end
end
end
end
items = add items 1
a = add e 1
end
end
end
end
end
for c ulong nk
if lt get a_own c 1000
ajoin get a_own c c nk
end
end
for c ulong nk
slash = false
for j ulong get a_kl c
if eq ulong get a_keys add mul c 64 j 47
slash = true
end
end
if not slash
mt1 = ulong 0
matches = ulong 0
for k ulong skeys
if ne k c
if alane k c
mt1 = k
matches = add matches 1
end
end
end
if eq matches 1
ajoin mt1 c nk
end
end
end
nm = ulong 0
mdrop = ulong 0
for c ulong nk
if eq aroot c nk c
if lt nm 96
put a_mem c nm
r = get a_sref c
o = add 32 mul nm 8
put ob o uchar and shr r 16 255
put ob add o 1 uchar shr r 24
put ob add o 2 uchar and shr r 8 255
put ob add o 3 uchar and r 255
put ob add o 4 uchar 255
put ob add o 5 uchar 255
put ob add o 6 uchar 0
put ob add o 7 uchar 0
put a_ds nm 0
nm = add nm 1
else
mdrop = add mdrop 1
end
end
end
o = add 32 mul nm 8
nalso = ulong 0
for c ulong nk
rt = aroot c nk
if ne rt c
if lt rt nk
if lt get a_mem rt 1000
put a_mem c get a_mem rt
r = get a_sref c
put ob o uchar get a_mem rt
put ob add o 1 uchar 0
put ob add o 2 uchar and shr r 16 255
put ob add o 3 uchar shr r 24
put ob add o 4 uchar and shr r 8 255
put ob add o 5 uchar and r 255
o = add o 6
nalso = add nalso 1
end
end
end
end
skipped = ulong 0
clipped = ulong 0
nposts = ulong 0
for li ulong nl
p = get a_lo li
if ne ulong get b p 1
skipped = add skipped 1
else
if eq ulong get b add p 1 1
clipped = add clipped 1
end
sender = ulong 1000
nw = ulong 0
ns = ulong get b add p 2
for k ulong ns
aent b p 0 k
m = amember b nk
if eq k 0
sender = m
else
if and lt m 1000 ne m sender
dup = false
for j ulong nw
if eq get wl j m
dup = true
end
end
if not dup
put wl nw m
nw = add nw 1
end
end
end
end
nt = ulong 0
nr = ulong get b add p 3
for k ulong nr
aent b p 1 k
m = amember b nk
if and lt m 1000 ne m sender
dup = false
for j ulong nt
if eq get to2 j m
dup = true
end
end
if not dup
put to2 nt m
nt = add nt 1
end
end
end
sb = ulong 255
if lt sender 1000
sb = sender
end
put ob o uchar sb
put ob add o 1 uchar nw
put ob add o 2 uchar nt
o = add o 3
for j ulong nw
put ob o uchar get wl j
o = add o 1
end
for j ulong nt
put ob o uchar get to2 j
o = add o 1
end
nposts = add nposts 1
end
end
for lr ulong nl
lq = sub sub nl 1 lr
p = get a_lo lq
if eq ulong get b p 1
ns = ulong get b add p 2
for k ulong ns
aent b p 0 k
dn = get a_e 3
m = amember b nk
if and lt m 1000 gt dn 0
if eq get a_ds m 0
put a_ds m 1
mo = add 36 mul m 8
put ob mo uchar and lq 255
put ob add mo 1 uchar shr lq 8
put ob add mo 2 uchar k
end
end
end
end
end
put ob 8 uchar and nm 255
put ob 9 uchar shr nm 8
put ob 10 uchar and nalso 255
put ob 11 uchar shr nalso 8
put ob 12 uchar and nposts 255
put ob 13 uchar shr nposts 8
put ob 14 uchar 0
put ob 15 uchar 0
put32 ob 16 skipped
put32 ob 20 clipped
put32 ob 24 mdrop
put32 ob 28 sdrop
ret sub o 8
end

note ---- the state of a swarm's members, and the graph (kind 7) ----
note A request is an op and a count c as two 32-bit values, then c numbers of 64 bits, then bytes when the op has a
note text. Every number, in and out, is the value plus 1099511627776, so that -1 ("not known", "none") travels as
note an unsigned number. Codes: role 0 worker, 1 coordinator, 2 helper; turn 0 not known, 1 running, 2 ended; wake
note 2 parked for mentions, 3 for any post; state 1 working, 2 waiting, 3 stopped; attention 0 none, 1 stuck,
note 2 error, 3 quota; group 1 needs you, 2 working, 3 waiting on someone, 4 parked; step 1 planner, 2 result,
note 3 user, 4 error; status 1 done, 2 error.
const k_b ulong 1099511627776
text q_words "resource_exhausted|quota|rate limit|rate-limit|ratelimit|exhausted your capacity|"
text q_roles "coordinatorworkernarratormonitor"
global d_role ulong 96
global d_kill ulong 96
global d_wake ulong 96
global d_turn ulong 96
global d_lr ulong 96
global d_lm ulong 96
global d_fail ulong 96
global d_own ulong 96
global d_no ulong 96
global d_nl ulong 96
global d_cnt ulong 96
global d_last ulong 96
global d_state ulong 96
global d_att ulong 96
global d_won ulong 96
global d_grp ulong 96
global d_key ulong 96
global d_ord ulong 96
global d_po ulong 400
global d_cell ulong 18432
global d_nm ulong 96

note number k of the request
fn gi b view uchar 1048576 k ulong to ulong
o = add 8 mul k 8
ret or rd32 b o shl rd32 b add o 4 32
end

note number k of the request as a count; a negative number gives a value over every limit
fn gu b view uchar 1048576 k ulong to ulong
v = gi b k
if lt v k_b
ret 4294967295
end
ret sub v k_b
end

note number k of the answer
fn po ob edit uchar 65544 k ulong v ulong to void
o = add 8 mul k 8
put32 ob o v
put32 ob add o 4 shr v 32
end

note a member's state is worked out, never taken from what it says about itself. With a roster: stopped when it
note was killed; else waiting when its own run has ended and working when it is mid-turn; with no transcript to
note go on, waiting when it is parked. With no roster: working when it posted within 900 seconds (age, -1 never)
fn swstate killed ulong turn ulong wake ulong roster ulong age ulong to ulong
if eq killed add k_b 1
ret 3
end
if ne roster add k_b 1
if and ge age k_b le age add k_b 900
ret 1
end
ret 2
end
if eq turn add k_b 2
ret 2
end
if eq turn add k_b 1
ret 1
end
if or eq wake add k_b 2 eq wake add k_b 3
ret 2
end
ret 1
end

note what needs a look: a failed newest step, or a member that should be working and has not moved for more
note than 600 seconds (idle -1: not known)
fn swatt state ulong failure ulong idle ulong to ulong
if eq state add k_b 3
ret 0
end
if eq failure add k_b 2
ret 2
end
if eq failure add k_b 3
ret 3
end
if and eq state add k_b 1 gt idle add k_b 600
ret 1
end
ret 0
end

note the Overview group of one member (asks and won: 1 when it asks the owner, when it waits on someone)
fn swgroup state ulong att ulong asks ulong won ulong to ulong
if eq state add k_b 3
ret 4
end
if or ne att k_b ne asks k_b
ret 1
end
if eq state add k_b 1
ret 2
end
if ne won k_b
ret 3
end
ret 4
end

note is this post the first row of a visual group? Posts by one sender, next to each other and at most 600
note seconds apart, are one group
fn swstarts ps ulong pt ulong s ulong t ulong to ulong
if or lt s k_b ne s ps
ret 1
end
if or le t k_b le pt k_b
ret 0
end
if or gt t add pt 600 lt t pt
ret 1
end
ret 0
end

note the n bytes at off, ASCII letters without case, against the wn bytes at w0 of q_roles
fn eqrole b view uchar 1048576 off ulong n ulong w0 ulong wn ulong to bool
if ne n wn
ret false
end
i = ulong 0
while lt i n bound 64
if ne lowc ulong get b add off i ulong get q_roles add w0 i
ret false
end
i = add i 1
end
ret true
end

note the order of members: by key (small first), the coordinator before the others, then by name (ASCII letters
note without case, the shorter first). n members; keys in d_key, roles in d_role, names at d_no, d_nl; order to d_ord
fn sworder b view uchar 1048576 n ulong to void
cntd = ulong 0
for i ulong n
pos = cntd
while gt pos 0 bound 128
o = get d_ord sub pos 1
after = false
if ne get d_key o get d_key i
after = gt get d_key o get d_key i
else
co = eq get d_role o 1
ci = eq get d_role i 1
dif = false
if co
if not ci
dif = true
end
else
if ci
dif = true
end
end
if dif
after = ci
else
x = get d_no o
xl = get d_nl o
y = get d_no i
yl = get d_nl i
k = ulong 0
cmp = ulong 1
while lt k xl bound 999999
if ge k yl
break
end
cx = lowc ulong get b add x k
cy = lowc ulong get b add y k
if ne cx cy
cmp = 0
if gt cx cy
cmp = 2
end
break
end
k = add k 1
end
if eq cmp 1
if gt xl yl
cmp = 2
end
end
after = eq cmp 2
end
end
if not after
break
end
put d_ord pos o
pos = sub pos 1
end
put d_ord pos i
cntd = add cntd 1
end
end

note op 8: has the member's run stopped? Its newest steps, oldest first: four counts (they must be equal), then
note the kinds, the statuses, for a planner step how many tools it called, and which of them was the wait for
note posts (-1 none). Ended (2) when the newest planner step called no tool and nothing came after it, or when it
note called the wait and that call's result is done; anything newer means mid-turn (1). 0: not known
fn swturn b view uchar 1048576 c ulong to ulong
if lt c 4
ret 0
end
n = gu b 0
if gt n 100000
ret 0
end
if or eq n 0 or ne gi b 1 gi b 0 or ne gi b 2 gi b 0 ne gi b 3 gi b 0
ret 0
end
if ne c add 4 mul n 4
ret 0
end
kd = ulong 4
sx = add 4 n
tl = add 4 mul n 2
wt2 = add 4 mul n 3
i = n
results = ulong 0
looked = ulong 0
while gt i 0 bound 512
if ge looked 256
break
end
if ne gi b add kd sub i 1 add k_b 2
break
end
results = add results 1
i = sub i 1
looked = add looked 1
end
if or eq i 0 ge looked 256
ret 1
end
i = sub i 1
if ne gi b add kd i add k_b 1
ret 1
end
tools = gi b add tl i
if le tools k_b
if eq results 0
ret 2
end
ret 1
end
wait = gi b add wt2 i
if or lt wait k_b ge wait tools
ret 1
end
if lt results sub tools k_b
ret 1
end
if eq gi b add sx add add i 1 sub wait k_b add k_b 1
ret 2
end
ret 1
end

note op 9: the step that says what the member is doing now: the newest planner step of the current turn that has
note a label. Three counts (equal), then kinds, waits and labels. A turn starts after user input or after a wait
note for posts. The answer is the step's place, or -1
fn swact b view uchar 1048576 c ulong to ulong
none = sub k_b 1
if lt c 3
ret none
end
n = gu b 0
if gt n 100000
ret none
end
if or ne gi b 1 gi b 0 ne gi b 2 gi b 0
ret none
end
if ne c add 3 mul n 3
ret none
end
i = n
looked = ulong 0
while gt i 0 bound 512
if ge looked 256
break
end
kk = gi b add 3 sub i 1
if eq kk add k_b 3
ret none
end
if eq kk add k_b 1
if ge gi b add add 3 n sub i 1 k_b
ret none
end
if eq gi b add add 3 mul n 2 sub i 1 add k_b 1
ret add k_b sub i 1
end
end
i = sub i 1
looked = add looked 1
end
ret none
end

note op 10: does an error text (t0..t1) say the member ran out of quota or was rate limited? One of the words of
note q_words in its first 32768 places, or "429" standing alone
fn swquota b view uchar 1048576 t0 ulong t1 ulong to ulong
tn = sub t1 t0
w0 = ulong 0
wi = ulong 0
while lt wi len q_words bound 256
if eq ulong get q_words wi 124
wn = sub wi w0
if and gt wn 0 ge tn wn
i = ulong 0
while le add i wn tn bound 40000
if ge i 32768
break
end
k = ulong 0
while lt k wn bound 64
if ne lowc ulong get b add add t0 i k ulong get q_words add w0 k
break
end
k = add k 1
end
if eq k wn
ret 1
end
i = add i 1
end
end
w0 = add wi 1
end
wi = add wi 1
end
i = ulong 0
while le add i 3 tn bound 40000
if ge i 32768
break
end
p = add t0 i
if and and eq ulong get b p 52 eq ulong get b add p 1 50 eq ulong get b add p 2 57
if not namer runeb b p t0 t1
if not namer rune b add p 3 t1
ret 1
end
end
end
i = add i 1
end
ret 0
end

note op 11: the role code of a roster member from its role (rl bytes at ro) and its name (nl bytes at no). The
note coordinator leads; "narrator" and "monitor", also with "-<digits>" after, are helpers by name; so is any role
note other than "worker"
fn swrole b view uchar 1048576 ro ulong rl ulong no ulong nl ulong to ulong
if eqrole b ro rl 0 11
ret 1
end
plain = eq rl 0
if eqrole b ro rl 11 6
plain = true
end
if not plain
ret 2
end
bl = nl
pf = cprefix b no nl
if gt pf 0
bl = pf
end
if eqrole b no bl 17 8
ret 2
end
if eqrole b no bl 25 7
ret 2
end
ret 0
end

note op 16: everything the views show about the members. Numbers: 0 1 when there is a roster, 1 now (seconds
note since 1970), 2 the members n (96 at most), 3 the posts p (400 at most); nine a member: role, killed, wake,
note turn, the last post it read (-1 not known), its last own movement (0 not known), failure, 1 when it is the
note person using Hop, the length of its name; then a post each: its number, its time (0 not known), its sender
note (-1: not a member), how many others signed and who, how many members it addresses by name and who. The
note names follow as bytes. The answer: 0 the newest post number, 1 to 3 the members working, waiting and stopped
note (helpers are not counted); a number a post: 1 when it starts a visual group; then eleven lists of n: posts
note by each member, its newest post (-1 none), state, attention, idle seconds (-1), unread posts (-1), 1 for a
note helper, who it waits on (-1), the post that says so, the post that asks the owner (0 none), its group; then
note the Overview order and the Members order. Returns the count of numbers, or 0 for a malformed request
fn swderive b view uchar 1048576 c ulong nbytes ulong ob edit uchar 65544 to ulong
if lt c 4
ret 0
end
roster = gi b 0
now = gi b 1
n = gu b 2
p = gu b 3
if or gt n 96 gt p 400
ret 0
end
q = add 4 mul n 9
if gt q c
ret 0
end
no = add 8 mul c 8
for m ulong n
o = add 4 mul m 9
put d_role m gu b o
put d_kill m gi b add o 1
put d_wake m gi b add o 2
put d_turn m gi b add o 3
put d_lr m gi b add o 4
put d_lm m gi b add o 5
put d_fail m gi b add o 6
put d_own m gi b add o 7
l = gu b add o 8
if gt l 1048576
ret 0
end
put d_no m no
put d_nl m l
no = add no l
put d_cnt m 0
put d_last m 1000
end
if gt no add add 8 mul c 8 nbytes
ret 0
end
for i ulong p
if gt add q 4 c
ret 0
end
put d_po i q
nw = gu b add q 3
if gt nw 4
ret 0
end
if gt add add q 5 nw c
ret 0
end
nd = gu b add add q 4 nw
if gt nd 96
ret 0
end
q = add add add q 5 nw nd
if gt q c
ret 0
end
end
head = k_b
if gt p 0
head = gi b get d_po sub p 1
end
po ob 0 head
for i ulong p
q = get d_po i
s = gi b add q 2
sg = ulong 1
if gt i 0
pq = get d_po sub i 1
sg = swstarts gi b add pq 2 gi b add pq 1 s gi b add q 1
end
po ob add 4 i add k_b sg
if and ge s k_b lt s add k_b n
sm = sub s k_b
put d_cnt sm add get d_cnt sm 1
put d_last sm i
end
nw = gu b add q 3
for k ulong nw
w = gi b add add q 4 k
if ne w s
if and ge w k_b lt w add k_b n
wm = sub w k_b
put d_cnt wm add get d_cnt wm 1
put d_last wm i
end
end
end
end
base = add 4 p
for m ulong n
last = get d_last m
age = sub k_b 1
if lt last 1000
pt = gi b add get d_po last 1
if gt pt k_b
age = k_b
if gt now pt
age = add k_b sub now pt
end
end
end
st = swstate get d_kill m get d_turn m get d_wake m roster age
idle = sub k_b 1
if eq roster add k_b 1
lm = get d_lm m
if gt lm k_b
idle = k_b
if gt now lm
idle = add k_b sub now lm
end
end
end
put d_state m st
put d_att m swatt add k_b st get d_fail m idle
unr = sub k_b 1
if eq roster add k_b 1
lr = get d_lr m
if ge lr k_b
unr = k_b
if gt head lr
unr = add k_b sub head lr
end
end
end
po ob add base m add k_b get d_cnt m
lp = sub k_b 1
if lt last 1000
lp = add k_b last
end
po ob add add base n m lp
po ob add add base mul n 2 m add k_b st
po ob add add base mul n 3 m add k_b get d_att m
po ob add add base mul n 4 m idle
po ob add add base mul n 5 m unr
hp = ulong 0
if eq get d_role m 2
hp = 1
end
po ob add add base mul n 6 m add k_b hp
end
working = ulong 0
waiting = ulong 0
stopped = ulong 0
for m ulong n
on = ulong 1000
seq = k_b
you = k_b
last = get d_last m
if and lt last 1000 ne get d_state m 3
q = get d_po last
nw = gu b add q 3
nd = gu b add add q 4 nw
t0 = add add q 5 nw
if gt nd 0
answered = false
j = add last 1
while lt j p bound 512
if answered
break
end
qj = get d_po j
sj = gi b add qj 2
nwj = gu b add qj 3
for k ulong nd
tk = gi b add t0 k
if eq tk sj
answered = true
end
for k2 ulong nwj
if eq tk gi b add add qj 4 k2
answered = true
end
end
end
j = add j 1
end
if not answered
for k ulong nd
tk = gi b add t0 k
if and ge tk k_b lt tk add k_b n
tm2 = sub tk k_b
if eq get d_own tm2 add k_b 1
you = gi b q
else
if and eq on 1000 ne get d_state tm2 3
on = tm2
end
end
end
end
if lt on 1000
seq = gi b q
end
end
end
end
wo = sub k_b 1
won = ulong 0
if lt on 1000
wo = add k_b on
won = 1
end
asks = ulong 0
if gt you k_b
asks = 1
end
g = swgroup add k_b get d_state m add k_b get d_att m add k_b asks add k_b won
put d_grp m g
po ob add add base mul n 7 m wo
po ob add add base mul n 8 m seq
po ob add add base mul n 9 m you
po ob add add base mul n 10 m add k_b g
if ne get d_role m 2
if eq get d_state m 1
working = add working 1
else
if eq get d_state m 2
waiting = add waiting 1
else
stopped = add stopped 1
end
end
end
end
po ob 1 add k_b working
po ob 2 add k_b waiting
po ob 3 add k_b stopped
for pass2 ulong 2
for m ulong n
v = get d_grp m
if eq pass2 1
v = get d_state m
end
if ne roster add k_b 1
v = mul v 2
if eq get d_cnt m 0
v = add v 1
end
end
put d_key m v
end
sworder b n
for m ulong n
po ob add add base mul n add 11 pass2 m add k_b get d_ord m
end
end
ret add base mul n 13
end

note op 12: who addressed whom in the first posts, for the graph. Numbers: the members n, upTo, how many posts
note have a sender, how many helper flags, how many posts have their co-signers, their addressed members and
note their to-all flag; then the helper flags (n); then a post each: sender, how many co-signers (4 at most) and
note who, how many addressed members and who, 1 when it is to all. Helpers are left out. The answer is bytes,
note six a pair in order of sender then receiver: from, to, how many posts named the receiver (16-bit), how many
note reached it only because the post was for everyone (16-bit). Returns the reply length
fn swedges b view uchar 1048576 c ulong ob edit uchar 65544 to ulong
named = new ulong 96 0
if lt c 7
ret 0
end
nn = gi b 0
if or le nn k_b gt nn add k_b 96
ret 0
end
n = sub nn k_b
upto = gi b 1
posts = gu b 2
if gt posts 100000
ret 0
end
if lt upto add k_b posts
posts = ulong 0
if gt upto k_b
posts = sub upto k_b
end
end
if or gt posts 400 ne gi b 3 nn
ret 0
end
if or or lt gi b 4 add k_b posts lt gi b 5 add k_b posts lt gi b 6 add k_b posts
ret 0
end
for z ulong mul n n
put d_cell z 0
put d_cell add 9216 z 0
end
hb = ulong 7
q = add 7 n
if gt q c
ret 0
end
for i ulong posts
if gt add q 2 c
ret 0
end
s0 = gi b q
nw = gu b add q 1
if gt nw 4
ret 0
end
if gt add add q 3 nw c
ret 0
end
nd = gu b add add q 2 nw
if gt nd 96
ret 0
end
dq = add add q 3 nw
if gt add add dq nd 1 c
ret 0
end
tall = gi b add dq nd
for s ulong add nw 1
from = s0
if gt s 0
from = gi b add add q 2 sub s 1
end
okf = and ge from k_b lt from add k_b n
if okf
if ne gi b add hb sub from k_b k_b
okf = false
end
end
if okf
if gt s 0
if eq from s0
okf = false
end
end
end
if okf
f = sub from k_b
for z ulong n
put named z 0
end
for k ulong nd
if lt k n
tv = gi b add dq k
if and ge tv k_b lt tv add k_b n
tt = sub tv k_b
if and ne tt f eq gi b add hb tt k_b
if eq get named tt 0
put named tt 1
put d_cell add mul f n tt add get d_cell add mul f n tt 1
end
end
end
end
end
if eq tall add k_b 1
for tt ulong n
if and ne tt f eq gi b add hb tt k_b
if eq get named tt 0
put d_cell add 9216 add mul f n tt add get d_cell add 9216 add mul f n tt 1
end
end
end
end
end
end
q = add add dq nd 1
end
o = ulong 8
for cell ulong mul n n
dv = get d_cell cell
av = get d_cell add 9216 cell
if gt add dv av 0
put ob o uchar div cell n
put ob add o 1 uchar rem cell n
put ob add o 2 uchar and dv 255
put ob add o 3 uchar and shr dv 8 255
put ob add o 4 uchar and av 255
put ob add o 5 uchar and shr av 8 255
o = add o 6
end
end
ret sub o 8
end

note op 14: which members to draw when there are too many for one picture: the keep members with the most posts
note to or from others (the earlier member wins a tie). Numbers: the members n, 1 to count posts for everyone
note too, keep, how many edge numbers follow, then the edges, five numbers a row: from, to, count, direct, to all.
note The answer is a byte a member, 1 when it is picked; a member with no line is never picked
fn swbusy b view uchar 1048576 c ulong ob edit uchar 65544 to ulong
weight = new ulong 96 0
flag = new ulong 96 0
if lt c 4
ret 0
end
nn = gi b 0
if or le nn k_b gt nn add k_b 96
ret 0
end
n = sub nn k_b
ne2 = gu b 3
if ne c add 4 ne2
ret 0
end
e = ulong 0
while lt add e 4 ne2 bound 16384
if ge e 46080
break
end
from = gi b add 4 e
tv = gi b add 5 e
cv = gi b add 7 e
if eq gi b 1 add k_b 1
cv = gi b add 6 e
end
if and and ge from k_b lt from add k_b n and ge tv k_b lt tv add k_b n
if ge cv k_b
put weight sub from k_b add get weight sub from k_b sub cv k_b
put weight sub tv k_b add get weight sub tv k_b sub cv k_b
end
end
e = add e 5
end
keep = gi b 2
picked = ulong 0
while lt picked n bound 128
if ge add k_b picked keep
break
end
best = ulong 1000
for m ulong n
if and eq get flag m 0 gt get weight m 0
if eq best 1000
best = m
else
if gt get weight m get weight best
best = m
end
end
end
end
if eq best 1000
break
end
put flag best 1
picked = add picked 1
end
for m ulong n
put ob add 8 m uchar get flag m
end
ret n
end

note op 13: how many of the first posts each member sent to everyone. Numbers: the members n, upTo, how many posts
note have a sender and how many have a to-all flag, then a post each: sender, 1 when it is to all. The answer is n
note numbers (none when n is not 1 to 96). Returns the count of numbers
fn swbroad b view uchar 1048576 c ulong ob edit uchar 65544 to ulong
outv = new ulong 96 0
if lt c 4
ret 0
end
nn = gi b 0
if or le nn k_b gt nn add k_b 96
ret 0
end
n = sub nn k_b
posts = gu b 2
if gt posts 100000
posts = ulong 100000
end
upto = gi b 1
if lt upto add k_b posts
posts = ulong 0
if gt upto k_b
posts = sub upto k_b
end
end
na = gu b 3
i = ulong 0
while lt i posts bound 512
if or ge i 400 ge i na
break
end
if gt add 6 mul i 2 c
break
end
s = gi b add 4 mul i 2
if eq gi b add 5 mul i 2 add k_b 1
if and ge s k_b lt s add k_b n
put outv sub s k_b add get outv sub s k_b 1
end
end
i = add i 1
end
for m ulong n
po ob m add k_b get outv m
end
ret n
end

note ---- the one box: which rows it shows for a typed text, and in which order (kind 7 op 17) ----
note Numbers: 0 the characters of the typed text (trimmed, lower case), 1 its bytes, 2 a web address (0 no, 1 typed
note with its scheme, 2 bare), 3 1 when this Mac has finished searching its files, 4 1 when a file has exactly that
note name, 5 1 for a question, 6 1 when a sentence may go to the agent; 7 to 12 the counts of apps, files,
note screens, commands, accounts and copied things; then four an app (how well it matched, how much it is used,
note its lift from habit, 1 when it was in front before), three a file (its match, its use, 1 when it is an app
note already listed), two an account (1 when its name holds the text, 1 when it starts with it), one a copied
note thing (1 when pinned); then for each screen and each command a count of words and their lengths. Bytes: the
note text, then those words. The rows: the 8 best apps (match + 40 + use + half the lift + 10 for the one in
note front before); the address (150 with a scheme; bare, only after the file search: 95, or 3 when a file has
note that name); from 2 characters a screen (230 named, 125 a word starts so), a command (220; 110 from 3
note characters when a word starts so) and each matching account (95 when it starts so, else 70); the first 8
note copied things (85 less the place, 10 more when pinned); the first 12 files that are not apps (match + use);
note Ask (1000 for a question, else 2); the agent (999 when nothing else matched, it is not a question and a
note sentence may go to it, else 1). Highest first; equal rows stay in this order.
note The answer: the count of rows, then four numbers a row: its kind (1 app, 2 address, 3 screen, 4 command,
note 5 account, 6 copied, 7 file, 8 ask, 9 agent), its place in its list, its score, 1 for the promoted agent
global r_kind ulong 1024
global r_idx ulong 1024
global r_score ulong 1024
global r_flag ulong 1024
global r_as ulong 2048
global r_ao ulong 2048

fn rkadd n ulong kind ulong idx ulong score ulong flag ulong to ulong
if ge n 1024
ret n
end
put r_kind n kind
put r_idx n idx
put r_score n score
put r_flag n flag
ret add n 1
end

note half of a number as it travels, toward zero
fn rkhalf v ulong to ulong
if ge v k_b
ret add k_b div sub v k_b 2
end
ret sub k_b div sub k_b v 2
end

note the wl bytes at w against the ll bytes of the typed text at lo: equal (md 0), or starting with it (md 1)
fn rkword b view uchar 1048576 w ulong wl ulong lo ulong ll ulong md ulong to bool
if eq md 0
if ne wl ll
ret false
end
else
if lt wl ll
ret false
end
end
i = ulong 0
while lt i ll bound 999999
if ne ulong get b add w i ulong get b add lo i
ret false
end
i = add i 1
end
ret true
end

note the n rows, highest score first (equal rows stay in their order), as the answer: the count, then four numbers
note a row (kind, place, score, flag); how many numbers that is
fn rkout n ulong ob edit uchar 65544 to ulong
for i ulong n
s = get r_score i
pos = i
while gt pos 0 bound 2048
p = get r_ao sub pos 1
if ge get r_score p s
break
end
put r_ao pos p
pos = sub pos 1
end
put r_ao pos i
end
po ob 0 add k_b n
for i ulong n
x = get r_ao i
o = add 1 mul i 4
po ob o add k_b get r_kind x
po ob add o 1 add k_b get r_idx x
po ob add o 2 get r_score x
po ob add o 3 add k_b get r_flag x
end
ret add 1 mul n 4
end

fn swrank b view uchar 1048576 c ulong nbytes ulong ob edit uchar 65544 to ulong
if lt c 13
ret 0
end
lcn = gu b 0
ll = gu b 1
na = gu b 7
nf = gu b 8
ns = gu b 9
nc = gu b 10
nacc = gu b 11
ncl = gu b 12
if or or gt na 2048 gt nf 4000 or gt ns 32 gt nc 32
ret 0
end
if or gt nacc 800 or gt ncl 64 gt ll 100000
ret 0
end
pa = ulong 13
pf = add pa mul na 4
pacc = add pf mul nf 3
pcl = add pacc mul nacc 2
q = add pcl ncl
if gt q c
ret 0
end
lo = add 8 mul c 8
tend = add lo nbytes
wp = add lo ll
if gt wp tend
ret 0
end
n = ulong 0
for i ulong na
o = add pa mul i 4
s = sub add add add gi b o gi b add o 1 rkhalf gi b add o 2 40 mul 2 k_b
if eq gi b add o 3 add k_b 1
s = add s 10
end
put r_as i s
pos = i
while gt pos 0 bound 4096
p = get r_ao sub pos 1
if ge get r_as p s
break
end
put r_ao pos p
pos = sub pos 1
end
put r_ao pos i
end
for i ulong na
if lt i 8
n = rkadd n 1 get r_ao i get r_as get r_ao i 0
end
end
adr = gi b 2
if eq adr add k_b 1
n = rkadd n 2 0 add k_b 150 0
end
if and eq adr add k_b 2 eq gi b 3 add k_b 1
sc = add k_b 95
if eq gi b 4 add k_b 1
sc = add k_b 3
end
n = rkadd n 2 0 sc 0
end
for pass3 ulong 2
cntw = ns
if eq pass3 1
cntw = nc
end
for k ulong cntw
if ge q c
ret 0
end
nw = gu b q
q = add q 1
if gt nw 64
ret 0
end
exact = false
pre = false
for w ulong nw
if ge q c
ret 0
end
wl = gu b q
q = add q 1
if gt add wp wl tend
ret 0
end
if rkword b wp wl lo ll 0
exact = true
end
if rkword b wp wl lo ll 1
pre = true
end
wp = add wp wl
end
if ge lcn 2
if eq pass3 0
if exact
n = rkadd n 3 k add k_b 230 0
else
if pre
n = rkadd n 3 k add k_b 125 0
end
end
else
if exact
n = rkadd n 4 k add k_b 220 0
else
if and pre ge lcn 3
n = rkadd n 4 k add k_b 110 0
end
end
end
end
end
end
if ge lcn 2
for i ulong nacc
if eq gi b add pacc mul i 2 add k_b 1
sc = add k_b 70
if eq gi b add add pacc mul i 2 1 add k_b 1
sc = add k_b 95
end
n = rkadd n 5 i sc 0
end
end
end
for i ulong ncl
if lt i 8
sc = sub add k_b 85 i
if eq gi b add pcl i add k_b 1
sc = add sc 10
end
n = rkadd n 6 i sc 0
end
end
shown = ulong 0
for i ulong nf
o = add pf mul i 3
if and ne gi b add o 2 add k_b 1 lt shown 12
n = rkadd n 7 i sub add gi b o gi b add o 1 k_b 0
shown = add shown 1
end
end
nothing = eq n 0
quest = eq gi b 5 add k_b 1
sc = add k_b 2
if quest
sc = add k_b 1000
end
n = rkadd n 8 0 sc 0
prom = ulong 0
sc = add k_b 1
if and and not quest nothing eq gi b 6 add k_b 1
prom = 1
sc = add k_b 999
end
n = rkadd n 9 0 sc prom
ret rkout n ob
end

note ---- the one box before anything is typed: what to offer (kind 7 op 18) ----
note Numbers: 0 1 when something was copied, 1 how many seconds ago, 2 1 when it is a web address written with
note http, 3 1 when the app in front is a browser, 4 how many other copied things follow (at most 20), 5 1 when
note the clipboard history is paused, 6 the count of apps; then six an app: its lift from the app in front, its
note lift from the hour, how much it is used, 1 when it is running, 1 when it was in front before, and its
note points for being in front lately. The apps come in the order of their ids, which settles equal scores.
note The rows: the copied thing (130 under a minute old, 95 under ten, else 70) and, for an address, a row to
note open it (5 more, or 5 less when a browser is in front); the six best apps among those with a lift, some
note use, running or in front before (40 + both lifts + a quarter of the use + 45 in front before + 8 running +
note the points for lately); the other copied things (38 less the place); the clipboard screen at 39 when the
note history is paused. Highest first; equal rows stay in this order.
note The answer: the count of rows, then four numbers a row: its kind (1 app, 2 address, 3 the clipboard
note screen, 6 copied), its place (an app's place in the list; 0 the newest copied thing, then 1 and up), its
note score, and why it is offered (0 nothing said, 1 just copied, 2 the last thing copied, 3 a copied address,
note 4 often opened from here, 5 just here, 6 often opened around now, 7 among the most used, 8 running now,
note 9 the history is paused)
global s_ps ulong 8
global s_pi ulong 8
global s_pw ulong 8

fn swsuggest b view uchar 1048576 c ulong ob edit uchar 65544 to ulong
if lt c 7
ret 0
end
rest = gu b 4
na = gu b 6
if or gt na 2048 gt rest 20
ret 0
end
if ne c add 7 mul na 6
ret 0
end
n = ulong 0
if eq gi b 0 add k_b 1
age = gi b 1
s = ulong 70
why = ulong 2
if lt age add k_b 600
s = 95
why = 1
end
if lt age add k_b 60
s = 130
end
n = rkadd n 6 0 add k_b s why
if eq gi b 2 add k_b 1
if eq gi b 3 add k_b 1
n = rkadd n 2 0 add k_b sub s 5 3
else
n = rkadd n 2 0 add k_b add s 5 3
end
end
end
cnt = ulong 0
for i ulong na
o = add 7 mul i 6
lf = gu b o
lh = gu b add o 1
used = gu b add o 2
run = eq gi b add o 3 add k_b 1
prev = eq gi b add o 4 add k_b 1
lately = gu b add o 5
if or or gt add lf lh 0 gt used 0 or run prev
sc = add add add 40 lf lh div used 4
if prev
sc = add sc 45
end
if run
sc = add sc 8
end
sc = add sc lately
why = ulong 8
if gt used 0
why = 7
end
if gt lh 0
why = 6
end
if prev
why = 5
end
if gt lf 0
why = 4
end
keep = true
pos = cnt
if eq cnt 6
if le sc get s_ps 5
keep = false
end
pos = 5
else
cnt = add cnt 1
end
if keep
while gt pos 0 bound 8
if ge get s_ps sub pos 1 sc
break
end
put s_ps pos get s_ps sub pos 1
put s_pi pos get s_pi sub pos 1
put s_pw pos get s_pw sub pos 1
pos = sub pos 1
end
put s_ps pos sc
put s_pi pos i
put s_pw pos why
end
end
end
for j ulong cnt
n = rkadd n 1 get s_pi j add k_b get s_ps j get s_pw j
end
for i ulong rest
n = rkadd n 6 add 1 i add k_b sub 38 i 0
end
if eq gi b 5 add k_b 1
n = rkadd n 3 0 add k_b 39 9
end
ret rkout n ob
end

note ---- habits: how much an app is lifted by where and when it is usually opened (kind 7 op 19) ----
note Numbers: 0 the hour now, 1 1 when an app is in front, 2 the count of apps, 3 the count of remembered
note launches; then three a launch: 1 when it was made from the app now in front, its hour, and which app it
note opened (its place in the list, or -1 for an app not in it). A habit counts from the second time. An app's
note lift from the app in front is 60 times its share of the launches made from there; its lift from the hour
note is 25 times its share of the launches within an hour of now (23 and 0 are an hour apart).
note The answer: the count of apps, then two numbers an app: the lift from the app in front, the lift from the hour
fn swlifts b view uchar 1048576 c ulong ob edit uchar 65544 to ulong
if lt c 4
ret 0
end
hour = gi b 0
front = eq gi b 1 add k_b 1
na = gu b 2
nl = gu b 3
if or gt na 2048 gt nl 4096
ret 0
end
if ne c add 4 mul nl 3
ret 0
end
for i ulong na
put r_as i 0
put r_ao i 0
end
ft = ulong 0
nt = ulong 0
for j ulong nl
o = add 4 mul j 3
here = and front eq gi b o add k_b 1
h = gi b add o 1
d = ulong 0
if ge h hour
d = sub h hour
else
d = sub hour h
end
nearh = or le d 1 ge d 23
a = gi b add o 2
ix = na
if ge a k_b
if lt sub a k_b na
ix = sub a k_b
end
end
if here
ft = add ft 1
if lt ix na
put r_as ix add get r_as ix 1
end
end
if nearh
nt = add nt 1
if lt ix na
put r_ao ix add get r_ao ix 1
end
end
end
po ob 0 add k_b na
for i ulong na
f = ulong 0
if ge get r_as i 2
f = div mul 60 get r_as i ft
end
g = ulong 0
if ge get r_ao i 2
g = div mul 25 get r_ao i nt
end
po ob add 1 mul i 2 add k_b f
po ob add 2 mul i 2 add k_b g
end
ret add 1 mul na 2
end

note ---- AES-256-GCM, for Hop's encrypted clipboard history (kind 7 op 20) ----
note The history is sealed as CryptoKit's AES.GCM seals it: a 256-bit key, a 12-byte nonce, no added data, a
note 16-byte tag. This is that cipher in Omega: AES by its definition (the S-box is worked out, not listed), the
note counter mode, and the tag by GHASH with a table of 16 multiples of the hash key. The work is done on
note globals: the key in c_k, the nonce in c_n, the data in c_d (in place, 16 MiB at most), the tag in c_tg. fn gcunlock checks
note the tag over the whole data before any of it is unsealed, and compares all 16 bytes whatever they are. It is
note not written to run in the same time for every key (the tables are indexed by secret bytes): it is for
note files on the person's own Mac, not for a service others can time.
note Request: two numbers (1 to seal, 0 to unseal; the count of data bytes, 4096 at most), then the bytes: the
note key, the nonce, the data, and to unseal the tag. Answer to unseal: 1 and the data's bytes, or 0 alone when
note the tag is not the data's. Answer to seal: 1, the sealed bytes, the 16 bytes of the tag.
global c_sb uchar 256
global c_m2 uchar 256
global c_l4 ulong 16
global c_rd ulong 1
global c_k uchar 32
global c_n uchar 12
global c_tg uchar 16
global c_rk uchar 240
global c_st uchar 16
global c_tm uchar 16
global c_y uchar 16
global c_x uchar 16
global c_hh ulong 16
global c_hl ulong 16
global c_d uchar 16777216

note the tables that do not depend on the key: the S-box (the inverse in the field, then the affine step), the
note doubling in the field, and the 16 reductions of GHASH
fn gcinit to void
if eq get c_rd 0 1
ret
end
p = ulong 1
q = ulong 1
for i ulong 255
t = xor p shl p 1
if ne and p 128 0
t = xor t 27
end
p = and t 255
q = and xor q shl q 1 255
q = and xor q shl q 2 255
q = and xor q shl q 4 255
if ne and q 128 0
q = xor q 9
end
r1 = and or shl q 1 shr q 7 255
r2 = and or shl q 2 shr q 6 255
r3 = and or shl q 3 shr q 5 255
r4 = and or shl q 4 shr q 4 255
x = xor xor xor xor q r1 r2 r3 r4
put c_sb p uchar xor x 99
end
put c_sb 0 99
for i ulong 256
d = shl i 1
if ne and i 128 0
d = xor d 27
end
put c_m2 i uchar and d 255
end
put c_l4 0 0
put c_l4 1 7200
put c_l4 2 14400
put c_l4 3 9312
put c_l4 4 28800
put c_l4 5 27808
put c_l4 6 18624
put c_l4 7 21728
put c_l4 8 57600
put c_l4 9 64800
put c_l4 10 55616
put c_l4 11 50528
put c_l4 12 37248
put c_l4 13 36256
put c_l4 14 43456
put c_l4 15 46560
put c_rd 0 1
end

note the cipher on the 16 bytes of c_st, with the round keys of c_rk
fn gcblk to void
for i ulong 16
put c_st i uchar xor ulong get c_st i ulong get c_rk i
end
for r ulong 14
rk = mul add r 1 16
for cc ulong 4
for w ulong 4
put c_tm add mul cc 4 w get c_sb ulong get c_st add mul and add cc w 3 4 w
end
end
if lt r 13
for cc ulong 4
o = mul cc 4
a0 = ulong get c_tm o
a1 = ulong get c_tm add o 1
a2 = ulong get c_tm add o 2
a3 = ulong get c_tm add o 3
d0 = ulong get c_m2 a0
d1 = ulong get c_m2 a1
d2 = ulong get c_m2 a2
d3 = ulong get c_m2 a3
put c_st o uchar xor xor xor xor xor d0 d1 a1 a2 a3 ulong get c_rk add rk o
put c_st add o 1 uchar xor xor xor xor xor a0 d1 d2 a2 a3 ulong get c_rk add rk add o 1
put c_st add o 2 uchar xor xor xor xor xor a0 a1 d2 d3 a3 ulong get c_rk add rk add o 2
put c_st add o 3 uchar xor xor xor xor xor d0 a0 a1 a2 d3 ulong get c_rk add rk add o 3
end
else
for i ulong 16
put c_st i uchar xor ulong get c_tm i ulong get c_rk add rk i
end
end
end
end

note the key of c_k: its 15 round keys into c_rk, and the 16 multiples of the hash key (the cipher of 16 zero
note bytes) into c_hh and c_hl
fn gckey to void
gcinit
for i ulong 32
put c_rk i get c_k i
end
rc = ulong 1
for w ulong 52
i = add w 8
o = mul i 4
t0 = ulong get c_rk sub o 4
t1 = ulong get c_rk sub o 3
t2 = ulong get c_rk sub o 2
t3 = ulong get c_rk sub o 1
if eq and i 7 0
u0 = xor ulong get c_sb t1 rc
u1 = ulong get c_sb t2
u2 = ulong get c_sb t3
u3 = ulong get c_sb t0
rc = ulong get c_m2 rc
t0 = u0
t1 = u1
t2 = u2
t3 = u3
end
if eq and i 7 4
t0 = ulong get c_sb t0
t1 = ulong get c_sb t1
t2 = ulong get c_sb t2
t3 = ulong get c_sb t3
end
put c_rk o uchar xor ulong get c_rk sub o 32 t0
put c_rk add o 1 uchar xor ulong get c_rk sub o 31 t1
put c_rk add o 2 uchar xor ulong get c_rk sub o 30 t2
put c_rk add o 3 uchar xor ulong get c_rk sub o 29 t3
end
for i ulong 16
put c_st i 0
end
gcblk
vh = ulong 0
vl = ulong 0
for i ulong 8
vh = or shl vh 8 ulong get c_st i
vl = or shl vl 8 ulong get c_st add 8 i
end
put c_hh 0 0
put c_hl 0 0
put c_hh 8 vh
put c_hl 8 vl
ix = ulong 4
for s ulong 3
tt = ulong 0
if ne and vl 1 0
tt = 16212958658533785600
end
vl = or shl vh 63 shr vl 1
vh = xor shr vh 1 tt
put c_hl ix vl
put c_hh ix vh
ix = shr ix 1
end
ix = 2
for s ulong 3
for j ulong sub ix 1
jj = add j 1
put c_hh add ix jj xor get c_hh ix get c_hh jj
put c_hl add ix jj xor get c_hl ix get c_hl jj
end
ix = shl ix 1
end
end

note c_y times the hash key, in the field of GHASH
fn gcmul to void
nlo = and ulong get c_y 15 15
zh = get c_hh nlo
zl = get c_hl nlo
for s ulong 16
bv = ulong get c_y sub 15 s
nlo = and bv 15
nhi = shr bv 4
if ne s 0
r4 = and zl 15
zl = or shl zh 60 shr zl 4
zh = xor shr zh 4 shl get c_l4 r4 48
zh = xor zh get c_hh nlo
zl = xor zl get c_hl nlo
end
r4 = and zl 15
zl = or shl zh 60 shr zl 4
zh = xor shr zh 4 shl get c_l4 r4 48
zh = xor zh get c_hh nhi
zl = xor zl get c_hl nhi
end
for i ulong 8
sh = mul sub 7 i 8
put c_y i uchar and shr zh sh 255
put c_y add 8 i uchar and shr zl sh 255
end
end

note the tag of the n sealed bytes of c_d under the key and the nonce, into c_x
fn gctag n ulong to void
for i ulong 16
put c_y i 0
end
nb = div add n 15 16
bk = ulong 0
for seg ulong 17
while and lt bk nb lt bk mul add seg 1 65536 bound 70000
o = mul bk 16
m = sub n o
if gt m 16
m = 16
end
for j ulong m bound 16
put c_y j uchar xor ulong get c_y j ulong get c_d add o j
end
gcmul
bk = add bk 1
end
end
bits = mul n 8
for j ulong 8
put c_y add 8 j uchar xor ulong get c_y add 8 j and shr bits mul sub 7 j 8 255
end
gcmul
for i ulong 12
put c_st i get c_n i
end
put c_st 12 0
put c_st 13 0
put c_st 14 0
put c_st 15 1
gcblk
for i ulong 16
put c_x i uchar xor ulong get c_st i ulong get c_y i
end
end

note the n bytes of c_d through the counter mode (sealing and unsealing are the same)
fn gcctr n ulong to void
ctr = ulong 2
nb = div add n 15 16
bk = ulong 0
for seg ulong 17
while and lt bk nb lt bk mul add seg 1 65536 bound 70000
for i ulong 12
put c_st i get c_n i
end
put c_st 12 uchar and shr ctr 24 255
put c_st 13 uchar and shr ctr 16 255
put c_st 14 uchar and shr ctr 8 255
put c_st 15 uchar and ctr 255
gcblk
o = mul bk 16
m = sub n o
if gt m 16
m = 16
end
for j ulong m bound 16
put c_d add o j uchar xor ulong get c_d add o j ulong get c_st j
end
ctr = add ctr 1
bk = add bk 1
end
end
end

note unseal the n bytes of c_d: 1 and they are the data when c_tg is their tag, else 0 and they are untouched
fn gcunlock n ulong to ulong
if gt n 16777216
ret 0
end
gckey
gctag n
df = ulong 0
for i ulong 16
df = or df xor ulong get c_x i ulong get c_tg i
end
if ne df 0
ret 0
end
gcctr n
ret 1
end

note seal the n bytes of c_d (16 MiB at most; more is left as it is, with a tag of zeros); their tag into c_tg
fn gclock n ulong to void
if gt n 16777216
for i ulong 16
put c_tg i 0
end
ret
end
gckey
gcctr n
gctag n
for i ulong 16
put c_tg i get c_x i
end
end

note forget the key and everything worked out from it
fn gcwipe to void
for i ulong 32
put c_k i 0
end
for i ulong 240
put c_rk i 0
end
for i ulong 16
put c_hh i 0
put c_hl i 0
put c_st i 0
put c_tm i 0
put c_y i 0
put c_x i 0
end
end

fn swgcm b view uchar 1048576 c ulong nbytes ulong ob edit uchar 65544 to ulong
if ne c 2
ret 0
end
dir = gu b 0
n = gu b 1
if or gt dir 1 gt n 4096
ret 0
end
want = add 44 n
if eq dir 0
want = add want 16
end
if ne nbytes want
ret 0
end
t0 = add 8 mul c 8
for i ulong 32
put c_k i get b add t0 i
end
for i ulong 12
put c_n i get b add add t0 32 i
end
for i ulong n bound 4096
put c_d i get b add add t0 44 i
end
if eq dir 0
for i ulong 16
put c_tg i get b add add add t0 44 n i
end
good = gcunlock n
gcwipe
po ob 0 add k_b good
if eq good 0
ret 1
end
for i ulong n bound 4096
po ob add 1 i add k_b ulong get c_d i
end
ret add 1 n
end
gclock n
gcwipe
po ob 0 add k_b 1
for i ulong n bound 4096
po ob add 1 i add k_b ulong get c_d i
end
for i ulong 16
po ob add add 1 n i add k_b ulong get c_tg i
end
ret add 17 n
end

note kind 7: see the note above. Scalar ops answer one number: 1 state, 2 attention, 3 unread (the newest post
note less the last one read; -1 not known), 4 group, 5 starts a group, 6 failure (how a member's newest step
note failed: a model error at once, a failed tool step once it stayed newest for 60 seconds; 3 when the text
note spoke of quota), 7 the line weight of an edge, 1 to 5, by its count against the heaviest, 8 to 11 as noted.
note 13 and 16 answer a list of numbers; 12 and 14 answer bytes. 17: the rows of the one box (fn swrank). 18: what the one box offers before anything is typed (fn swsuggest).
note 19: the lift of each app from habit (fn swlifts). 20: AES-256-GCM, to seal and unseal (fn swgcm). Returns the reply length, or
note 18446744073709551615 for a malformed request
fn status ib view uchar 1048576 nb ulong ob edit uchar 65544 to ulong
bad = ulong 18446744073709551615
if lt nb 8
ret bad
end
op = rd32 ib 0
c = rd32 ib 4
if gt add 8 mul c 8 nb
ret bad
end
nbytes = sub nb add 8 mul c 8
t0 = add 8 mul c 8
r = k_b
if eq op 1
if ne c 5
ret bad
end
r = add k_b swstate gi ib 0 gi ib 1 gi ib 2 gi ib 3 gi ib 4
end
if eq op 2
if ne c 3
ret bad
end
r = add k_b swatt gi ib 0 gi ib 1 gi ib 2
end
if eq op 3
if ne c 2
ret bad
end
r = sub k_b 1
if ge gi ib 1 k_b
r = k_b
if gt gi ib 0 gi ib 1
r = add k_b sub gi ib 0 gi ib 1
end
end
end
if eq op 4
if ne c 4
ret bad
end
r = add k_b swgroup gi ib 0 gi ib 1 gi ib 2 gi ib 3
end
if eq op 5
if ne c 4
ret bad
end
r = add k_b swstarts gi ib 0 gi ib 1 gi ib 2 gi ib 3
end
if eq op 6
if ne c 4
ret bad
end
failed = eq gi ib 0 add k_b 4
if and eq gi ib 1 add k_b 2 ge gi ib 2 add k_b 60
failed = true
end
r = k_b
if failed
r = add k_b 2
if eq gi ib 3 add k_b 1
r = add k_b 3
end
end
end
if eq op 7
if ne c 2
ret bad
end
cn = gi ib 0
hv = gi ib 1
r = add k_b 1
if and gt cn add k_b 1 gt hv add k_b 1
if ge cn hv
r = add k_b 5
else
r = add add k_b 1 div mul sub sub cn k_b 1 4 sub sub hv k_b 1
end
end
end
if eq op 8
r = add k_b swturn ib c
end
if eq op 9
r = swact ib c
end
if eq op 10
r = add k_b swquota ib t0 add t0 nbytes
end
if eq op 11
if ne c 2
ret bad
end
rl = gu ib 0
nl = gu ib 1
if or gt rl 1048576 gt nl 1048576
ret bad
end
if ne add rl nl nbytes
ret bad
end
r = add k_b swrole ib t0 rl add t0 rl nl
end
if eq op 12
ret swedges ib c ob
end
if eq op 13
ret mul 8 swbroad ib c ob
end
if eq op 14
ret swbusy ib c ob
end
if eq op 16
k = swderive ib c nbytes ob
if eq k 0
ret bad
end
ret mul k 8
end
if eq op 17
k = swrank ib c nbytes ob
if eq k 0
ret bad
end
ret mul k 8
end
if eq op 18
k = swsuggest ib c ob
if eq k 0
ret bad
end
ret mul k 8
end
if eq op 19
k = swlifts ib c ob
if eq k 0
ret bad
end
ret mul k 8
end
if eq op 20
k = swgcm ib c nbytes ob
if eq k 0
ret bad
end
ret mul k 8
end
if or gt op 11 eq op 0
ret bad
end
po ob 0 r
ret 8
end

note ---- which words were corrected (kind 4) ----
note After Hop types a dictation, the field is read again later. The host splits three texts into words (what was
note dictated, the field before, the field after) and gives each distinct word a number. This finds the dictation
note in the field (its last whole occurrence), sets aside the words that are the same at both ends, lines up the
note rest word by word (longest common subsequence) and reports each run where words of the dictation were
note replaced: at most 3 words, wholly inside the dictation. Nothing is reported when the dictation is not in the
note field, when the part that changed is too large (words before times words after over 250000), or when more
note than half of the dictation changed (a rewrite, not a fix).
note wt: the table of the line-up, (words before + 1) rows of (words after + 1)
global wt ulong 500008

note st: 0 where the removed run starts in the field, 1 its length, 2 where the typed run starts in the later
note field, 3 its length, 4 runs written, 5 where the dictation starts, 6 its length, 7 removed words that lie
note inside the dictation, 8 1 when there were more runs than the answer holds (4096)
fn hclose st edit ulong 16 ob edit uchar 65544 to void
rc = get st 1
ic = get st 3
if and gt rc 0 gt ic 0
rs = get st 0
s0 = get st 5
if ge rs s0
if le add rs rc add s0 get st 6
if le rc 3
h = get st 4
if ge h 4096
put st 8 1
else
o = add 10 mul h 14
put32 ob o rs
put ob add o 4 uchar and rc 255
put ob add o 5 uchar shr rc 8
put32 ob add o 6 get st 2
put32 ob add o 10 ic
put st 4 add h 1
end
end
end
end
end
put st 1 0
put st 3 0
end

note kind 4: three 32-bit counts (dictated, before, after), then that many 32-bit word numbers for each. The
note answer is a 16-bit count, then for each run: where the removed words start in the field before (32-bit), how
note many (16-bit), where the typed words start in the field after (32-bit) and how many (32-bit).
note Returns the reply length, or 18446744073709551615 for a malformed body or too many runs
fn wdiff ib view uchar 1048576 n ulong ob edit uchar 65544 to ulong
st = new ulong 16 0
bad = ulong 18446744073709551615
if lt n 12
ret bad
end
nd = rd32 ib 0
nb = rd32 ib 4
na = rd32 ib 8
if ne n add 12 mul 4 add add nd nb na
ret bad
end
d0 = ulong 12
b0 = add 12 mul 4 nd
a0 = add b0 mul 4 nb
put ob 8 uchar 0
put ob 9 uchar 0
if eq nd 0
ret 2
end
if lt nb nd
ret 2
end
found = false
start = ulong 0
q = sub nb nd
while true bound 999999
k = ulong 0
while lt k nd bound 999999
if ne rd32 ib add b0 mul 4 add q k rd32 ib add d0 mul 4 k
break
end
k = add k 1
end
if eq k nd
found = true
start = q
break
end
if eq q 0
break
end
q = sub q 1
end
if not found
ret 2
end
p = ulong 0
while lt p nb bound 999999
if ge p na
break
end
if ne rd32 ib add b0 mul 4 p rd32 ib add a0 mul 4 p
break
end
p = add p 1
end
s = ulong 0
while lt s sub nb p bound 999999
if ge s sub na p
break
end
if ne rd32 ib add b0 mul 4 sub sub nb 1 s rd32 ib add a0 mul 4 sub sub na 1 s
break
end
s = add s 1
end
bc = sub sub nb p s
ac = sub sub na p s
if eq bc 0
ret 2
end
am = ac
if eq am 0
am = ulong 1
end
if gt mul bc am 250000
ret 2
end
w1 = add ac 1
for z ulong add bc 1
put wt add mul z w1 ac 0
end
for z ulong w1
put wt add mul bc w1 z 0
end
for ii ulong bc
i = sub sub bc 1 ii
bi = rd32 ib add b0 mul 4 add p i
for jj ulong ac
j = sub sub ac 1 jj
if eq bi rd32 ib add a0 mul 4 add p j
put wt add mul i w1 j add get wt add mul add i 1 w1 add j 1 1
else
x = get wt add mul add i 1 w1 j
y = get wt add mul i w1 add j 1
if lt x y
x = y
end
put wt add mul i w1 j x
end
end
end
put st 5 start
put st 6 nd
ci = ulong 0
cj = ulong 0
while or lt ci bc lt cj ac bound 999999
mt = false
if lt ci bc
if lt cj ac
if eq rd32 ib add b0 mul 4 add p ci rd32 ib add a0 mul 4 add p cj
mt = true
end
end
end
if mt
hclose st ob
ci = add ci 1
cj = add cj 1
continue
end
rm = false
if lt ci bc
if eq cj ac
rm = true
else
if ge get wt add mul add ci 1 w1 cj get wt add mul ci w1 add cj 1
rm = true
end
end
end
if rm
if eq get st 1 0
put st 0 add p ci
end
put st 1 add get st 1 1
ai = add p ci
if ge ai start
if lt ai add start nd
put st 7 add get st 7 1
end
end
ci = add ci 1
else
if eq get st 3 0
put st 2 add p cj
end
put st 3 add get st 3 1
cj = add cj 1
end
end
hclose st ob
if ne get st 8 0
ret bad
end
h = get st 4
lim = nd
if lt lim 2
lim = ulong 2
end
if gt mul get st 7 2 lim
h = ulong 0
end
put ob 8 uchar and h 255
put ob 9 uchar shr h 8
ret add 2 mul h 14
end

fn names ib view uchar 1048576 n ulong ob edit uchar 65544 a edit ulong 256 r edit ulong 256 to ulong
if ne rem n 2048 0
ret 18446744073709551615
end
c = div n 2048
if gt c 512
ret 18446744073709551615
end
for q ulong c
for i ulong 256
w = ulong 0
for j ulong 8
w = or w shl ulong get ib add add mul q 2048 mul i 8 j mul j 8
end
put a i w
end
v = hopfuzz a r
s = get r 3
put ob add 8 mul q 3 uchar v
put ob add 9 mul q 3 uchar and s 255
put ob add 10 mul q 3 uchar shr s 8
end
ret mul c 3
end

note kind 2: returns the reply length, or 18446744073709551615 for a malformed body
fn paths ib view uchar 1048576 n ulong ob edit uchar 65544 toff edit ulong 64 tlen edit ulong 64 pm edit ulong 8 to ulong
bad = ulong 18446744073709551615
if lt n 4
ret bad
end
nt = rd16 ib 0
np = rd16 ib 2
if gt nt 64
ret bad
end
if gt np 16000
ret bad
end
o = ulong 4
for k ulong nt
if gt add o 2 n
ret bad
end
tl = rd16 ib o
o = add o 2
if gt add o tl n
ret bad
end
put toff k o
put tlen k tl
o = add o tl
end
for q ulong np
if gt add o 6 n
ret bad
end
pl = rd16 ib o
nl = rd16 ib add o 2
ol = rd16 ib add o 4
o = add o 6
if gt add o add pl nl n
ret bad
end
put pm 0 nt
put pm 1 o
put pm 2 pl
put pm 3 add o pl
put pm 4 nl
put pm 5 ol
put32 ob add 8 mul q 4 fscore ib toff tlen pm
o = add o add pl nl
end
if ne o n
ret bad
end
ret mul np 4
end

note ---- end of the core of Hop ----

fn upr o ulong v ulong to void
for i ulong 8
put g_rg add o i uchar and shr v mul i 8 255
end
end

fn ugr o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_rg add o i mul i 8
end
ret v
end

note the text into g_nm with a zero byte after it; its length
fn ucs t view uchar * to ulong
n = len t
for i ulong n
put g_nm i get t i
end
put g_nm n 0
ret n
end

note library function k of g_f on the register file; x0 as it came back (an object may have its top bit set)
fn ucall k ulong to ulong
lr = libcall get g_f k g_rg 0 128
ret ugr 0
end

fn usym t view uchar * to ulong
n = ucs t
upr 0 18446744073709551614
upr 8 ulong libptr g_nm 0 1024
lr = libcall ulong libfn 1 g_rg 0 128
ret ugr 0
end

fn ucl t view uchar * to ulong
n = ucs t
upr 0 ulong libptr g_nm 0 1024
ret ucall 0
end

fn usl t view uchar * to ulong
n = ucs t
upr 0 ulong libptr g_nm 0 1024
ret ucall 1
end

note [obj s a b c]
fn umsg obj ulong s ulong a ulong b ulong c ulong to ulong
upr 0 obj
upr 8 s
upr 16 a
upr 24 b
upr 32 c
ret ucall 2
end

note an NSString of the zero-ended bytes in g_nm
fn unsb to ulong
ret umsg get g_o 3 get g_o 4 ulong libptr g_nm 0 1024 0 0
end

fn uns t view uchar * to ulong
n = ucs t
ret unsb
end

note a rectangle for the next message, in d0..d3
fn urect x f64 y f64 w f64 h f64 to void
upr 64 bitcast ulong x
upr 72 bitcast ulong y
upr 80 bitcast ulong w
upr 88 bitcast ulong h
end

fn ulower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note the zero-ended bytes at address p into g_nm (at most 1000); their count
fn ufetch p ulong to ulong
upr 0 p
n = ucall 7
if gt n 1000
n = 1000
end
upr 0 ulong libptr g_nm 0 1024
upr 8 p
upr 16 n
x = ucall 8
put g_nm n 0
ret n
end

note the names in one folder that end in ".app", without that ending, into the pool
fn ufolder t view uchar * dn ulong to void
c = ucl c_fm
s = usl m_defaul
mgr = umsg c s 0 0 0
s = usl m_conte1
path = uns t
arr = umsg mgr s path 0 0
if eq arr 0
ret
end
s = usl m_count
cnt = umsg arr s 0 0 0
sat = usl m_at
for i ulong cnt bound 4096
item = umsg arr sat i 0 0
p = umsg item get g_o 5 0 0 0
n = ufetch p
k = get g_n 0
used = get g_n 2
if and and gt n 4 lt k 2048 lt add used n 65536
if and and eq get g_nm sub n 4 46 eq get g_nm sub n 3 97 and eq get g_nm sub n 2 112 eq get g_nm sub n 1 112
m = sub n 4
for j ulong m bound 1000
put g_pool add used j get g_nm j
end
put g_off k used
put g_ln k m
put g_dir k uchar dn
put g_n 0 add k 1
put g_n 2 add used m
end
end
end
end

note the word hopfuzz reads for one byte: its lower-case value, bit 32 for a letter or digit (and for every byte of
note a longer character), bit 33 for a space or tab
fn ufword c ulong to ulong
l = ulower c
w = l
if or or and ge l 97 le l 122 and ge l 48 le l 57 ge l 128
w = or w 4294967296
end
if or eq l 32 eq l 9
w = or w 8589934592
end
ret w
end

note how well app k matches the typed text: hopfuzz's score plus 1, or 0 for no match (and for a text over 64 bytes
note or a name over 184, which hopfuzz refuses)
fn uscore k ulong to ulong
inp = new ulong 256 0
res = new ulong 256 0
ql = get g_n 4
nl = get g_ln k
o = get g_off k
if or gt ql 64 or gt nl 184 eq nl 0
ret 0
end
put inp 0 1212568922
put inp 1 1
put inp 2 ql
put inp 3 nl
for i ulong ql bound 64
put inp add 8 i ufword ulong get g_q i
end
for i ulong nl bound 184
put inp add 72 i ufword ulong get g_pool add o i
end
v = hopfuzz inp res
if ne v 1
ret 0
end
ret 0
end

note a number in decimal into g_nm from byte p; the byte after it
fn upnum p ulong v ulong to ulong
d = ulong 1
while ge div v d 10 bound 24
d = mul d 10
end
q = p
while gt d 0 bound 24
put g_nm q uchar add 48 rem div v d 10
q = add q 1
d = div d 10
end
ret q
end

note the text into g_nm from byte p; the byte after it
fn uptxt p ulong t view uchar * to ulong
for i ulong len t
put g_nm add p i get t i
end
ret add p len t
end

note name k into g_nm from byte p; the byte after it
fn upname p ulong k ulong to ulong
o = get g_off k
n = get g_ln k
for i ulong n bound 1000
put g_nm add p i get g_pool add o i
end
ret add p n
end

note four bytes and eight bytes into a request for the core, and eight bytes out of its answer; numbers travel with
note 2^40 added (k_b), as in Omega/README.md kind 7
fn uw32 b edit uchar 1048576 o ulong v ulong to void
for i ulong 4
put b add o i uchar and shr v mul i 8 255
end
end

fn upb b edit uchar 1048576 k ulong x ulong to void
o = add 8 mul k 8
for i ulong 8
put b add o i uchar and shr x mul i 8 255
end
end

fn upn b edit uchar 1048576 k ulong v ulong to void
upb b k add v k_b
end

fn uog ob view uchar 65544 k ulong to ulong
v = ulong 0
o = add 8 mul k 8
for i ulong 8
v = or v shl ulong get ob add o i mul i 8
end
ret v
end

note the address the typed text stands for into g_nm from byte p (with "https://" before a bare one); the byte after
fn upaddr p ulong to ulong
q = p
if eq get g_n 10 2
q = uptxt p x_https
end
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm add q i get g_q add a i
end
ret add q n
end

note is the typed text a web address? The shape is the core's decision (fn weba, text decisions op 3); that macOS
note can read it is asked of NSURL, as Hop does. The answer goes to g_n 10
fn udecide to void
tb = new uchar 1048576 0
a = get g_n 12
n = get g_n 13
put g_n 10 0
put g_n 41 0
if or eq n 0 gt n 255
ret
end
uw32 tb 0 3
uw32 tb 4 n
uw32 tb 8 n
for i ulong n bound 256
l = ulower ulong get g_q add a i
o = add 16 mul i 8
put tb o uchar l
f = ulong 0
if or or and ge l 97 le l 122 and ge l 48 le l 57 ge l 128
f = 1
end
if or eq l 32 eq l 9
f = 14
end
put tb add o 4 uchar f
end
put g_n 41 qlike tb n
k = weba tb n n
if eq k 0
ret
end
put g_n 10 k
p = upaddr 0
put g_nm p 0
str = unsb
u = umsg get g_o 16 get g_o 17 str 0 0
if eq u 0
put g_n 10 0
ret
end
if eq k 1
if eq umsg u get g_o 18 0 0 0 0
put g_n 10 0
end
end
end

note ---- files: Hop's file index, searched by the rule of Hop's own file search (Sources/FileIndex.swift) ----
note read file-index.bin from Hop's folder (HOP_CONFIG_DIR, else the user's Application Support/Hop) and make the
note lower-case copy the search runs on. Without the file there are no file rows
fn uloadindex to void
if eq get g_fb 3 1
upr 0 get g_fb 1
x = ucall 28
x = umsg get g_fb 4 usl m_release 0 0 0
end
put g_fb 3 0
n = ucs x_env_dir
upr 0 ulong libptr g_nm 0 1024
dir_text = ucall 9
p = ulong 0
if ne dir_text 0
p = ufetch dir_text
end
if eq p 0
n = ucs x_env_home
upr 0 ulong libptr g_nm 0 1024
home_text = ucall 9
if eq home_text 0
ret
end
p = ufetch home_text
p = uptxt p x_support
end
p = uptxt p x_index
put g_nm p 0
path = unsb
c = ucl c_data
s = usl m_data_file
d = umsg c s path 0 0
if eq d 0
ret
end
s = usl m_retain
x = umsg d s 0 0 0
s = usl m_bytes
src = umsg d s 0 0 0
s = usl m_length
total = umsg d s 0 0 0
if or or eq src 0 eq total 0 gt total 536870912
ret
end
upr 0 total
dst = ucall 10
if eq dst 0
x = umsg d usl m_release 0 0 0
ret
end
done = ulong 0
while lt done total bound 2048
m = sub total done
if gt m 524288
m = 524288
end
upr 0 ulong libptr g_chunk 0 524288
upr 8 add src done
upr 16 m
x = ucall 8
for i ulong m bound 524288
cc = ulong get g_chunk i
if and ge cc 65 le cc 90
put g_chunk i uchar add cc 32
end
end
upr 0 add dst done
upr 8 ulong libptr g_chunk 0 524288
upr 16 m
x = ucall 8
done = add done m
end
put g_fb 0 src
put g_fb 1 dst
put g_fb 2 total
put g_fb 4 d
put g_fb 3 1
end

note does g_line[ho .. ho+hl) hold word t of the typed text; md 1: does it start with it
fn uhas ho ulong hl ulong t ulong md ulong to bool
wo = get g_to t
wl = get g_tl t
if gt wl hl
ret false
end
last = sub hl wl
if eq md 1
last = 0
end
st = ulong 0
while le st last bound 4097
same_bytes = true
j = ulong 0
while and same_bytes lt j wl bound 257
if ne get g_line add add ho st j get g_lq add wo j
same_bytes = false
end
j = add j 1
end
if same_bytes
ret true
end
st = add st 1
end
ret false
end

note the score of the path in g_line (ln bytes, lower case) plus 100000, or 0 when a word is in it nowhere: a
note word in the name counts 60 at its start and 30 elsewhere, a word only in the folders 5; a point less for
note every 20 bytes of path; 40 more when the name is exactly as long as the words; 25 more for an app
fn ufscore ln ulong to ulong
nt = get g_n 16
ns0 = ln
while gt ns0 0 bound 4097
if eq ulong get g_line sub ns0 1 47
break
end
ns0 = sub ns0 1
end
nl = sub ln ns0
sc = ulong 100000
words_len = ulong 0
for t ulong nt bound 16
words_len = add words_len get g_tl t
if uhas ns0 nl t 0
if uhas ns0 nl t 1
sc = add sc 60
else
sc = add sc 30
end
else
if uhas 0 ln t 0
sc = add sc 5
else
ret 0
end
end
end
sc = sub sc div ln 20
if eq nl words_len
sc = add sc 40
end
if ge ln 4
if and and eq ulong get g_line sub ln 4 46 eq ulong get g_line sub ln 3 97 and eq ulong get g_line sub ln 2 112 eq ulong get g_line sub ln 1 112
sc = add sc 25
end
end
ret sc
end

note keep a found path among the best 40, best first; equal scores stay in the order they were found
fn ufkeep sc ulong o ulong ln ulong to void
k = get g_n 17
if and ge k 40 le sc get g_fs 39
ret
end
pos = k
if ge k 40
pos = 39
else
put g_n 17 add k 1
end
while gt pos 0 bound 64
if ge get g_fs sub pos 1 sc
break
end
put g_fs pos get g_fs sub pos 1
put g_fo pos get g_fo sub pos 1
put g_fl pos get g_fl sub pos 1
pos = sub pos 1
end
put g_fs pos sc
put g_fo pos o
put g_fl pos ln
end

note path i of the best files into g_line, from the lower-case copy (lo 1) or as it is written (lo 0); its length
fn ufpath i ulong lo ulong to ulong
ln = get g_fl i
upr 0 ulong libptr g_line 0 4096
upr 8 add get g_fb lo get g_fo i
upr 16 ln
x = ucall 8
ret ln
end

note the files for the typed text: every line of the index that holds the longest word is scored (at most
note 20000 lines, as Hop does), the best 40 are kept. Nothing under two characters
fn usearch to void
put g_n 17 0
put g_n 18 0
a = get g_n 12
n = get g_n 13
nt = ulong 0
i = ulong 0
while lt i n bound 257
c = ulower ulong get g_q add a i
put g_lq i uchar c
if or eq c 32 eq c 9
i = add i 1
continue
end
st = i
while lt i n bound 257
c = ulower ulong get g_q add a i
if or eq c 32 eq c 9
break
end
put g_lq i uchar c
i = add i 1
end
if lt nt 16
put g_to nt st
put g_tl nt sub i st
nt = add nt 1
end
end
put g_n 16 nt
if or or eq get g_fb 3 0 lt n 2 eq nt 0
ret
end
lead = ulong 0
for t ulong nt bound 16
if gt get g_tl t get g_tl lead
lead = t
end
end
low = get g_fb 1
total = get g_fb 2
pos = ulong 0
scanned = ulong 0
while and lt pos total lt scanned 20000 bound 20001
upr 0 add low pos
upr 8 sub total pos
upr 16 ulong libptr g_lq get g_to lead get g_tl lead
upr 24 get g_tl lead
m = ucall 11
if eq m 0
break
end
hit_at = sub m low
upr 0 low
upr 8 10
upr 16 hit_at
r = ucall 13
s = ulong 0
if ne r 0
s = add sub r low 1
end
upr 0 m
upr 8 10
upr 16 sub total hit_at
r = ucall 12
e = total
if ne r 0
e = sub r low
end
pos = add e 1
scanned = add scanned 1
ln = sub e s
if and gt ln 0 le ln 4000
upr 0 ulong libptr g_line 0 4096
upr 8 add low s
upr 16 ln
x = ucall 8
sc = ufscore ln
if ne sc 0
ufkeep sc s ln
end
end
end
note does one of them have exactly the typed text as its name (a folder's last "/" aside)
for f ulong get g_n 17 bound 64
ln = ufpath f 1
if gt ln 0
if eq ulong get g_line sub ln 1 47
ln = sub ln 1
end
end
ns0 = ln
while gt ns0 0 bound 4097
if eq ulong get g_line sub ns0 1 47
break
end
ns0 = sub ns0 1
end
if eq sub ln ns0 n
same_bytes = true
for j ulong n bound 256
if ne get g_line add ns0 j get g_lq j
same_bytes = false
end
end
if same_bytes
put g_n 18 1
end
end
end
end

note is g_line[o .. o+n) the text t
fn ulineis o ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 64
if ne get g_line add o i get t i
ret false
end
end
ret true
end

note is best file i one of the m matched apps (an app already listed is not shown again as a file)
fn uisapp i ulong m ulong to ulong
ln = ufpath i 1
if lt ln 6
ret 0
end
if not ulineis sub ln 4 4 x_dotapp_low
ret 0
end
o = ulong 0
if and ge ln 14 ulineis 0 14 x_dir1_low
o = 14
end
if and ge ln 21 ulineis 0 21 x_dir2_low
o = 21
end
if eq o 0
ret 0
end
nl = sub sub ln o 4
for j ulong m bound 2048
k = get g_mk j
if eq get g_ln k nl
same_bytes = true
for b ulong nl bound 1000
if ne ulower ulong get g_pool add get g_off k b ulong get g_line add o b
same_bytes = false
end
end
if same_bytes
ret 1
end
end
end
ret 0
end

note the text of a file row into g_nm from byte p: its name, a gap, the folder it is in; the byte after it
fn ufilerow p ulong i ulong to ulong
ln = ufpath i 0
if gt ln 0
if eq ulong get g_line sub ln 1 47
ln = sub ln 1
end
end
ns0 = ln
while gt ns0 0 bound 4097
if eq ulong get g_line sub ns0 1 47
break
end
ns0 = sub ns0 1
end
q = p
nl = sub ln ns0
if gt nl 300
nl = 300
end
for j ulong nl bound 301
put g_nm add q j get g_line add ns0 j
end
q = add q nl
if and gt ns0 1 le ns0 600
q = uptxt q x_gap
for j ulong sub ns0 1 bound 601
put g_nm add q j get g_line j
end
q = add q sub ns0 1
end
ret q
end

note the whole path of best file i into g_nm from byte p (nothing when it is over 900 bytes); the byte after it
fn ufilepath p ulong i ulong to ulong
ln = ufpath i 0
if gt ln 900
ret p
end
for j ulong ln bound 901
put g_nm add p j get g_line j
end
ret add p ln
end

note open best file i with the app macOS has for it
fn uopenfile i ulong to void
p = ufilepath 0 i
if eq p 0
ret
end
put g_nm p 0
str = unsb
c = ucl c_url
s = usl m_furl
url = umsg c s str 0 0
c = ucl c_ws
s = usl m_shws
ws = umsg c s 0 0 0
s = usl m_open
put g_n 9 and umsg ws s url 0 0 255
end

note ---- Ask: the model of Hop's settings, asked over HTTP as Hop asks it (Sources/Runners.swift) ----
note [obj objectForKey: the key named by t]
fn ukeyed obj ulong t view uchar * to ulong
key = uns t
ret umsg obj usl m_object_for_key key 0 0
end

note is obj an object of class number w of g_m (7 a dictionary, 8 an array, 9 a string); nothing is not
fn uiskind obj ulong w ulong to bool
if eq obj 0
ret false
end
ret eq and umsg obj usl m_is_kind get g_m w 0 0 255 1
end

note the path of the file at Hop's folder plus the text t (an NSString, its bytes left in g_nm; 0 when the
note folder is not known)
fn uhoppath t view uchar * to ulong
n = ucs x_env_dir
upr 0 ulong libptr g_nm 0 1024
dir_text = ucall 9
p = ulong 0
if ne dir_text 0
p = ufetch dir_text
end
if eq p 0
n = ucs x_env_home
upr 0 ulong libptr g_nm 0 1024
home_text = ucall 9
if eq home_text 0
ret 0
end
p = ufetch home_text
p = uptxt p x_support
end
p = uptxt p t
put g_nm p 0
ret unsb
end

note the file at Hop's folder plus the text t, as NSData (0 when it is not there)
fn uhopfile t view uchar * to ulong
path = uhoppath t
if eq path 0
ret 0
end
ret umsg ucl c_data usl m_data_file path 0 0
end

note ---- saved accounts: Hop's keys and logins in the login Keychain (Sources/Vault.swift) ----
note Each is a generic password under Hop's service: the account is its name, the description its kind, the comment
note its note. Listing them reads no secret. Enter on one reads its secret and puts it on the clipboard, marked
note concealed so that clipboard histories pass it over, as Hop does; macOS asks the person the first time this
note program reads an item Hop made. A check (HOPCHECK) reads only the service named by HOPVAULT, never Hop's,
note and tells the Keychain to put no dialog up for it: what it may not read without one, it does not read.
note It makes its accounts itself (HOPVAULTADD), since macOS lets a program read back what it saved, and
note deletes them when it ends.
note the eight bytes of g_t8 as a number
fn uread8 to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_t8 i mul i 8
end
ret v
end

note the value of the library's constant named t (a pointer kept in a variable of that name); 0 when there is none
fn uconst t view uchar * to ulong
sym_at = usym t
if eq sym_at 0
ret 0
end
upr 0 ulong libptr g_t8 0 8
upr 8 sym_at
upr 16 8
x = ucall 8
ret uread8
end

note ask the Keychain for what q describes; the answer (an object), or 0
fn ukeychain q ulong to ulong
for i ulong 8
put g_t8 i 0
end
upr 0 q
upr 8 ulong libptr g_t8 0 8
if ne and ucall 23 4294967295 0
ret 0
end
ret uread8
end

note a question to the Keychain about Hop's items: the generic passwords under the service
fn uvaultquery to ulong
q = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
sset = usl m_set_object
x = umsg q sset uconst s_class_generic uconst s_class 0
x = umsg q sset get g_m 20 uconst s_attr_service 0
ret q
end

note the saved accounts: their names in order (lower case decides), and what each is
fn uloadvault to void
put g_n 31 0
service = ulong 0
if eq get g_n 14 0
n = ucs x_env_vault
upr 0 ulong libptr g_nm 0 1024
vault_text = ucall 9
if eq vault_text 0
ret
end
n = ufetch vault_text
service = unsb
else
service = uns x_vault_service
end
if eq service 0
ret
end
sret = usl m_retain
if eq get g_m 20 0
put g_m 20 umsg service sret 0 0 0
if eq get g_n 14 0
uvaultcheckadd
end
end
q = uvaultquery
sset = usl m_set_object
x = umsg q sset uconst s_limit_all uconst s_match_limit 0
x = umsg q sset uconst s_true uconst s_return_attributes 0
items = ukeychain q
if not uiskind items 8
ret
end
key_account = uconst s_attr_account
key_kind = uconst s_attr_description
key_note = uconst s_attr_comment
sget = usl m_object_for_key
sat = usl m_at
slower = usl m_lowercase
sappend = usl m_append_string
slen = usl m_length
by_low = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
cnt = umsg items usl m_count 0 0 0
for i ulong cnt bound 4096
item = umsg items sat i 0 0
if uiskind item 7
name = umsg item sget key_account 0 0
if uiskind name 9
x = umsg by_low sset item umsg name slower 0 0 0 0
end
end
end
lows = umsg umsg by_low usl m_all_keys 0 0 0 usl m_sorted usl m_compare 0 0
acct_names = umsg ucl c_mutable_array usl m_array 0 0 0
acct_details = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
put g_nm 0 32
put g_nm 1 194
put g_nm 2 183
put g_nm 3 32
put g_nm 4 0
dot = unsb
put g_nm 0 0
nothing = unsb
total = umsg lows usl m_count 0 0 0
if gt total 800
total = 800
end
for i ulong total bound 800
item = umsg by_low sget umsg lows sat i 0 0 0 0
x = umsg acct_names sadd umsg item sget key_account 0 0 0 0
detail = nothing
kind = umsg item sget key_kind 0 0
if uiskind kind 9
detail = kind
end
remark = umsg item sget key_note 0 0
if uiskind remark 9
if gt umsg remark slen 0 0 0 0
if gt umsg detail slen 0 0 0 0
detail = umsg detail sappend dot 0 0
end
detail = umsg detail sappend remark 0 0
end
end
x = umsg acct_details sadd detail 0 0
end
srel = usl m_release
if ne get g_m 18 0
x = umsg get g_m 18 srel 0 0 0
x = umsg get g_m 19 srel 0 0 0
end
put g_m 18 umsg acct_names sret 0 0 0
put g_m 19 umsg acct_details sret 0 0 0
put g_n 31 total
end

note the secret of the account named name (an NSString), as text; 0 when it cannot be read
fn usecret name ulong to ulong
if or eq get g_m 20 0 eq name 0
ret 0
end
q = uvaultquery
sset = usl m_set_object
x = umsg q sset name uconst s_attr_account 0
x = umsg q sset uconst s_true uconst s_return_data 0
x = umsg q sset uconst s_limit_one uconst s_match_limit 0
d = ukeychain q
if eq d 0
ret 0
end
whole = umsg ucl c_str usl m_alloc 0 0 0
ret umsg whole usl m_init_data_encoding d 4 0
end

note save an account as Hop does (Vault.save): any item of that name goes, then one is added with the secret as
note its data, the kind as its description and the note as its comment; 1 when it was added
fn uvaultsave name ulong secret_text ulong kind ulong remark ulong to ulong
if or eq get g_m 20 0 or eq name 0 eq secret_text 0
ret 0
end
q = uvaultquery
sset = usl m_set_object
x = umsg q sset name uconst s_attr_account 0
upr 0 q
x = ucall 25
data = umsg secret_text usl m_data_using 4 0 0
if eq data 0
ret 0
end
x = umsg q sset data uconst s_value_data 0
if ne kind 0
x = umsg q sset kind uconst s_attr_description 0
end
if ne remark 0
x = umsg q sset remark uconst s_attr_comment 0
end
x = umsg q sset uconst s_accessible_unlocked uconst s_accessible 0
upr 0 q
upr 8 0
if ne and ucall 24 4294967295 0
ret 0
end
ret 1
end

note delete the account of that name (Vault.delete)
fn uvaultdelete name ulong to void
if or eq get g_m 20 0 eq name 0
ret
end
q = uvaultquery
x = umsg q usl m_set_object name uconst s_attr_account 0
upr 0 q
x = ucall 25
end

note for a check: the accounts HOPVAULTADD describes ("name|kind|note|value", more after ";") are saved under the
note check's service by this very program, so that it may read them back without the person being asked
fn uvaultcheckadd to void
if eq get g_m 20 0
ret
end
n = ucs x_env_vault_add
upr 0 ulong libptr g_nm 0 1024
add_text = ucall 9
if eq add_text 0
ret
end
n = ufetch add_text
whole = unsb
if eq whole 0
ret
end
ssplit = usl m_components
sat = usl m_at
slen = usl m_length
made = umsg ucl c_mutable_array usl m_array 0 0 0
put g_m 22 umsg made usl m_retain 0 0 0
entries = umsg whole ssplit uns x_semicolon 0 0
entry_count = umsg entries usl m_count 0 0 0
for i ulong entry_count bound 16
fields = umsg umsg entries sat i 0 0 ssplit uns x_bar 0 0
if eq umsg fields usl m_count 0 0 0 4
name = umsg fields sat 0 0 0
kind = umsg fields sat 1 0 0
remark = umsg fields sat 2 0 0
value = umsg fields sat 3 0 0
if eq umsg kind slen 0 0 0 0
kind = 0
end
if eq umsg remark slen 0 0 0 0
remark = 0
end
if eq uvaultsave name value kind remark 1
x = umsg made usl m_add_object name 0 0
end
end
end
end

note for a check: delete the accounts it made
fn uvaultcheckend to void
made = get g_m 22
if eq made 0
ret
end
cnt = umsg made usl m_count 0 0 0
for i ulong cnt bound 16
uvaultdelete umsg made get g_m 16 i 0 0
end
put g_m 22 0
end

note string i of the array into g_nm from byte p; the byte after it
fn ustrat list_of ulong p ulong i ulong to ulong
if or eq list_of 0 ge p 900
ret p
end
entry_text = umsg list_of get g_m 16 i 0 0
src = umsg entry_text get g_o 5 0 0 0
if eq src 0
ret p
end
upr 0 src
n = ucall 7
if gt add p n 900
n = sub 900 p
end
if eq n 0
ret p
end
upr 0 ulong libptr g_nm p n
upr 8 src
upr 16 n
x = ucall 8
ret add p n
end

note put the secret of saved account i on the clipboard, marked concealed. A check uses a board of its own
fn ucopysecret i ulong to void
if ge i get g_n 31
ret
end
name = umsg get g_m 18 get g_m 16 i 0 0
secret_text = usecret name
if eq secret_text 0
ret
end
pboard = ulong 0
if eq get g_n 14 1
pboard = umsg ucl c_pasteboard usl m_general_pasteboard 0 0 0
else
pboard = umsg ucl c_pasteboard usl m_board_named uns x_check_board 0 0
end
x = umsg pboard usl m_clear 0 0 0
plain_type = uns x_type_string
concealed = uns x_type_concealed
types = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg types sadd plain_type 0 0
x = umsg types sadd concealed 0 0
x = umsg pboard usl m_declare_types types 0 0
sput = usl m_set_string_type
x = umsg pboard sput secret_text plain_type 0
put g_nm 0 0
nothing = unsb
x = umsg pboard sput nothing concealed 0
put g_n 29 1
end

note is entry e of the models an HTTP model the panel can ask (one whose key is a saved account needs the
note accounts to be readable); when it is, keep it as the model to ask
fn utakemodel e ulong to bool
if not uiskind e 7
ret false
end
kind = ukeyed e k_kind
if uiskind kind 9
want = uns x_openai
if ne and umsg kind usl m_equal_string want 0 0 255 1
ret false
end
end
key_name = ukeyed e k_key
if uiskind key_name 9
if eq get g_m 20 0
ret false
end
else
key_name = 0
end
base = ukeyed e k_base
model = ukeyed e k_model
name = ukeyed e k_name
if or or not uiskind base 9 not uiskind model 9 not uiskind name 9
ret false
end
slash = uns x_slash_text
for i ulong 8
if eq and umsg base usl m_has_suffix slash 0 0 255 1
base = umsg base usl m_substring_to sub umsg base usl m_length 0 0 0 1 0 0
end
end
if eq umsg base usl m_length 0 0 0 0
ret false
end
tail = uns x_completions
address = umsg base usl m_append_string tail 0 0
sret = usl m_retain
put g_m 0 umsg model sret 0 0 0
put g_m 1 umsg address sret 0 0 0
put g_m 2 umsg name sret 0 0 0
put g_m 21 0
if ne key_name 0
put g_m 21 umsg key_name sret 0 0 0
end
put g_m 3 1
ret true
end

note read Hop's settings and choose the model: the default one when it will do, else the first that will
fn uloadconfig to void
put g_m 3 0
put g_m 7 ucl c_dict
put g_m 8 ucl c_array
put g_m 9 ucl c_str
d = uhopfile x_config
if eq d 0
uagentconfig 0
ret
end
config = umsg ucl c_json usl m_json_object d 0 0
if not uiskind config 7
uagentconfig 0
ret
end
uagentconfig config
umachines config
utunnelsload config
put g_n 34 500
limit_number = ukeyed config k_limit
if ne limit_number 0
limit_value = ujsonint limit_number
if and gt limit_value 0 lt limit_value 1000000
put g_n 34 limit_value
end
end
models = ukeyed config k_models
if not uiskind models 8
ret
end
default_name = ukeyed config k_default
count = umsg models usl m_count 0 0 0
sat = usl m_at
if uiskind default_name 9
for i ulong count bound 256
e = umsg models sat i 0 0
if uiskind e 7
name = ukeyed e k_name
if uiskind name 9
if eq and umsg name usl m_equal_string default_name 0 0 255 1
if utakemodel e
ret
end
end
end
end
end
end
for i ulong count bound 256
e = umsg models sat i 0 0
if utakemodel e
ret
end
end
end

note show the answer in place of the list (on 1), or the list again (on 0)
fn uanswerview on ulong to void
s = usl m_set_hidden
x = umsg get g_o 28 s on 0 0
x = umsg get g_o 29 s sub 1 on 0 0
put g_n 20 on
end

note put the answer so far on show
fn uanswershow to void
whole_talk = get g_m 4
if ne get g_m 25 0
whole_talk = umsg get g_m 25 usl m_append_string get g_m 4 0 0
end
x = umsg get g_o 30 usl m_set_string whole_talk 0 0
end

note stop asking: the running task is cancelled and the list is back
fn uaskstop to void
if ne get g_m 6 0
x = umsg get g_m 6 usl m_cancel_task 0 0 0
put g_m 6 0
if ne get g_m 24 0
x = umsg get g_m 24 usl m_remove_last 0 0 0
end
put g_n 39 1
end
if eq get g_n 20 1
uanswerview 0
end
end

note ask the model the typed text. The body is made by Foundation, so the text is quoted as JSON wants it
fn uask to void
if eq get g_m 3 0
ret
end
a = get g_n 12
n = get g_n 13
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
question = unsb
sset = usl m_set_object
message = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
x = umsg message sset uns x_user uns k_role 0
x = umsg message sset question uns k_content 0
if eq get g_m 24 0
talk = umsg ucl c_mutable_array usl m_array 0 0 0
put g_m 24 umsg talk usl m_retain 0 0 0
told = umsg ucl c_mutable_string usl m_string 0 0 0
put g_m 25 umsg told usl m_retain 0 0 0
end
note a question asked while another is on its way takes its place
if ne get g_m 6 0
x = umsg get g_m 6 usl m_cancel_task 0 0 0
put g_m 6 0
x = umsg get g_m 24 usl m_remove_last 0 0 0
put g_n 39 1
end
messages = umsg get g_m 24 usl m_array_adding message 0 0
body = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
x = umsg body sset get g_m 0 uns k_model 0
x = umsg body sset messages uns k_messages 0
yes = umsg ucl c_number usl m_number_bool 1 0 0
x = umsg body sset yes uns k_stream 0
data = umsg ucl c_json usl m_json_data body 0 0
url = umsg get g_o 16 get g_o 17 get g_m 1 0 0
if or eq data 0 eq url 0
ret
end
req = umsg ucl c_request usl m_request_url url 0 0
x = umsg req usl m_set_method uns x_post 0 0
x = umsg req usl m_set_header uns x_json_type uns x_content_type 0
if ne get g_m 21 0
secret_text = usecret get g_m 21
if eq secret_text 0
if eq get g_m 4 0
fresh_text = umsg ucl c_mutable_string usl m_string 0 0 0
put g_m 4 umsg fresh_text usl m_retain 0 0 0
end
x = umsg get g_m 4 usl m_set_string uns x_no_key 0 0
put g_n 21 1
put g_n 22 1
uanswershow
uanswerview 1
ret
end
bearer = umsg uns x_bearer usl m_append_string secret_text 0 0
x = umsg req usl m_set_header bearer uns x_authorization 0
end
x = umsg req usl m_set_body data 0 0
s_timeout = usl m_set_timeout
upr 64 bitcast ulong 120.0f64
x = umsg req s_timeout 0 0 0
if eq get g_m 5 0
cfg = umsg ucl c_session_config usl m_ephemeral 0 0 0
queue = umsg ucl c_queue usl m_main_queue 0 0 0
session = umsg ucl c_session usl m_session_with cfg get g_o 27 queue
put g_m 5 umsg session usl m_retain 0 0 0
end
if eq get g_m 4 0
fresh_text = umsg ucl c_mutable_string usl m_string 0 0 0
put g_m 4 umsg fresh_text usl m_retain 0 0 0
end
note what was on show joins what was said before; then the question
put g_nm 0 10
put g_nm 1 10
put g_nm 2 0
blank_line = unsb
sappend_text = usl m_append
if eq get g_n 39 1
x = umsg get g_m 25 sappend_text get g_m 4 0 0
x = umsg get g_m 25 sappend_text blank_line 0 0
end
x = umsg get g_m 25 sappend_text uns x_you 0 0
x = umsg get g_m 25 sappend_text question 0 0
x = umsg get g_m 25 sappend_text blank_line 0 0
x = umsg get g_m 24 usl m_add_object message 0 0
x = umsg get g_m 4 usl m_set_string uns x_asking 0 0
put g_n 19 0
put g_n 21 0
put g_n 22 0
put g_n 39 0
put g_n 40 0
uanswershow
uanswerview 1
task = umsg get g_m 5 usl m_data_task req 0 0
put g_m 6 umsg task usl m_retain 0 0 0
x = umsg task usl m_resume 0 0 0
end

note a turn has ended: an answer joins the conversation; without one the question leaves it again, so that the
note model is not sent a question it never answered
fn uturnend to void
put g_n 39 1
if eq get g_m 24 0
ret
end
if or eq get g_n 40 1 eq get g_n 22 0
x = umsg get g_m 24 usl m_remove_last 0 0 0
ret
end
sset = usl m_set_object
reply = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
x = umsg reply sset uns x_assistant uns k_role 0
said = umsg ucl c_str usl m_utf umsg get g_m 4 get g_o 5 0 0 0 0 0
if eq said 0
x = umsg get g_m 24 usl m_remove_last 0 0 0
ret
end
x = umsg reply sset said uns k_content 0
x = umsg get g_m 24 usl m_add_object reply 0 0
end

note New chat: the conversation is forgotten
fn uchatnew to void
if ne get g_m 33 0
x = umsg get g_m 33 usl m_release 0 0 0
put g_m 33 0
end
if ne get g_m 6 0
x = umsg get g_m 6 usl m_cancel_task 0 0 0
put g_m 6 0
end
srel = usl m_release
if ne get g_m 24 0
x = umsg get g_m 24 srel 0 0 0
x = umsg get g_m 25 srel 0 0 0
put g_m 24 0
put g_m 25 0
end
put g_n 39 0
if ne get g_m 4 0
put g_nm 0 0
no_text = unsb
x = umsg get g_m 4 usl m_set_string no_text 0 0
end
if eq get g_n 20 1
uanswerview 0
end
end

note for a check: when the first answer has come, ask the second question (HOPASK2) in the same conversation
fn uasksecond to void
n = ucs x_env_ask2
upr 0 ulong libptr g_nm 0 1024
second_text = ucall 9
if or eq second_text 0 eq get g_n 21 0
ret
end
n = ucs x_env_asknew
upr 0 ulong libptr g_nm 0 1024
if ne ucall 9 0
uchatnew
end
n = ufetch second_text
second = unsb
x = umsg get g_o 0 get g_o 8 second 0 0
utyped
if and gt get g_n 1 0 eq ulong get g_rk 0 8
uask
end
end

note a piece of the answer: the first one takes the place of "Asking ..."
fn uanswerpiece piece ulong to void
if eq get g_n 22 0
put g_nm 0 0
empty_text = unsb
x = umsg get g_m 4 usl m_set_string empty_text 0 0
put g_n 22 1
end
x = umsg get g_m 4 usl m_append piece 0 0
uanswershow
end

note the JSON in g_net[o .. o+n) as an object (0 when it is not JSON)
fn unetjson o ulong n ulong to ulong
if or eq n 0 gt add o n 262144
ret 0
end
d = umsg ucl c_data usl m_data_bytes ulong libptr g_net o n n 0
ret umsg ucl c_json usl m_json_object d 0 0
end

note one line from the server: "data: {...}" carries a piece of the answer at choices[0].delta.content
note (an empty line may stand first in what came: a server's packet may begin with the line break that ends an
note event, so nothing before the line is looked at when it is empty; "and" looks at both its sides)
fn unetline o ulong n ulong to void
ln = n
if gt ln 0
if eq ulong get g_net sub add o ln 1 13
ln = sub ln 1
end
end
if lt ln 6
ret
end
if or or ne ulong get g_net o 100 ne ulong get g_net add o 1 97 or ne ulong get g_net add o 2 116 or ne ulong get g_net add o 3 97 ne ulong get g_net add o 4 58
ret
end
pay_o = add o 5
pay_l = sub ln 5
while and gt pay_l 0 eq ulong get g_net pay_o 32 bound 300000
pay_o = add pay_o 1
pay_l = sub pay_l 1
end
obj = unetjson pay_o pay_l
if not uiskind obj 7
ret
end
choices = ukeyed obj k_choices
if not uiskind choices 8
ret
end
if eq umsg choices usl m_count 0 0 0 0
ret
end
choice = umsg choices usl m_at 0 0 0
if not uiskind choice 7
ret
end
delta = ukeyed choice k_delta
if not uiskind delta 7
ret
end
content = ukeyed delta k_content
if uiskind content 9
if gt umsg content usl m_length 0 0 0 0
uanswerpiece content
end
end
end

note bytes from the server: add them to g_net, read every whole line, keep the rest
fn unetdata data ulong to void
p = umsg data usl m_bytes 0 0 0
n = umsg data usl m_length 0 0 0
fill = get g_n 19
if or eq p 0 gt add fill n 262144
put g_n 19 0
ret
end
if eq n 0
ret
end
upr 0 ulong libptr g_net fill n
upr 8 p
upr 16 n
x = ucall 8
fill = add fill n
line_start = ulong 0
i = ulong 0
while lt i fill bound 300000
if eq ulong get g_net i 10
unetline line_start sub i line_start
line_start = add i 1
end
i = add i 1
end
rest = sub fill line_start
for j ulong rest bound 300000
put g_net j get g_net add line_start j
end
put g_n 19 rest
end

note the answer has ended (problem: what went wrong, or nothing). A server that did not stream gave one JSON
note object: its text is at choices[0].message.content
fn unetdone task ulong problem ulong to void
put g_n 21 1
if ne task get g_m 6
ret
end
put g_m 6 0
if ne problem 0
uanswerpiece umsg problem usl m_description 0 0 0
put g_n 40 1
uturnend
ret
end
if eq get g_n 22 0
obj = unetjson 0 get g_n 19
if uiskind obj 7
choices = ukeyed obj k_choices
if uiskind choices 8
if gt umsg choices usl m_count 0 0 0 0
choice = umsg choices usl m_at 0 0 0
if uiskind choice 7
message = ukeyed choice k_message
if uiskind message 7
content = ukeyed message k_content
if uiskind content 9
uanswerpiece content
end
end
end
end
end
end
end
if eq get g_n 22 0
code = umsg umsg task usl m_response 0 0 0 usl m_status_code 0 0 0
if ge code 300
p = ulong 0
if or eq code 429 eq code 503
p = uptxt 0 x_busy
end
p = uptxt p x_http
p = upnum p code
p = uptxt p x_bracket
put g_nm p 0
uanswerpiece unsb
else
uanswerpiece uns x_no_answer
end
put g_n 40 1
end
uturnend
end

note the rows for typed text, by the one box's rules (fn swrank): the request is what Sources/SmartRank.swift
note sends, with the m matched apps of g_mk, their hopfuzz scores, use and habits, the web address and the files found, and
note the copied things that match, the saved accounts, the two screens and the two commands the panel has. The Ask row and the agent's row come back too.
note one word of a screen or a command into the request: its length as number k, its bytes at bp; the byte after
fn uwordput tb edit uchar 1048576 k ulong bp ulong t view uchar * to ulong
n = ucs t
upn tb k n
for i ulong n bound 64
put tb add bp i get g_nm i
end
ret add bp n
end

fn urankrows m ulong to void
tb = new uchar 1048576 0
ob = new uchar 65544 0
a = get g_n 12
n = get g_n 13
nf = get g_n 17
uclipmatch 8
ncl = get g_n 28
nacc = get g_n 31
nr = get g_n 49
nfa = add nf nr
c = add add add add add 13 mul m 4 mul nfa 3 mul nacc 2 ncl 26
upn tb 0 n
upn tb 1 n
upn tb 2 get g_n 10
upn tb 3 1
exact_name = get g_n 18
if eq get g_n 58 1
exact_name = 1
end
upn tb 4 exact_name
upn tb 5 get g_n 41
words_typed = ulong 0
in_word = false
for i ulong n bound 256
cw = ulong get g_q add a i
if or eq cw 32 eq cw 9
in_word = false
else
if not in_word
words_typed = add words_typed 1
end
in_word = true
end
end
send_agent = ulong 0
if and eq get g_n 42 1 ge words_typed 3
send_agent = 1
end
upn tb 6 send_agent
upn tb 7 m
upn tb 8 nfa
for i ulong nr bound 64
o = add add 13 mul m 4 mul add nf i 3
upb tb o sub add k_b get g_rs i 100000
upn tb add o 1 0
upn tb add o 2 0
end
for i ulong 4
upn tb add 9 i 0
end
upn tb 12 ncl
upn tb 11 nacc
pacc = add add 13 mul m 4 mul nfa 3
note the screens the panel has (the copied things, the accounts) and what it can do (settings, quit), each with
note the words that name it (and Rebuild file index): a count, then the length of each word; the words themselves follow the typed text
q = add add pacc mul nacc 2 ncl
word_start = add add 8 mul c 8 n
bp = word_start
upn tb add q 0 3
bp = uwordput tb add q 1 bp x_word0
bp = uwordput tb add q 2 bp x_word1
bp = uwordput tb add q 3 bp x_word2
upn tb add q 4 5
bp = uwordput tb add q 5 bp x_word3
bp = uwordput tb add q 6 bp x_word4
bp = uwordput tb add q 7 bp x_word5
bp = uwordput tb add q 8 bp x_word6
bp = uwordput tb add q 9 bp x_word7
upn tb add q 10 1
bp = uwordput tb add q 11 bp x_word_agent
upn tb add q 12 4
bp = uwordput tb add q 13 bp x_word8
bp = uwordput tb add q 14 bp x_word9
bp = uwordput tb add q 15 bp x_word10
bp = uwordput tb add q 16 bp x_word11
upn tb add q 17 1
bp = uwordput tb add q 18 bp x_word12
upn tb add q 19 3
bp = uwordput tb add q 20 bp x_word_rebuild
bp = uwordput tb add q 21 bp x_word_reindex
bp = uwordput tb add q 22 bp x_word_index_files
upn tb add q 23 2
bp = uwordput tb add q 24 bp x_word_new_chat
bp = uwordput tb add q 25 bp x_word_clear_chat
word_bytes = sub bp word_start
upn tb 9 3
upn tb 10 4
for i ulong ncl bound 8
upn tb add add pacc mul nacc 2 i ulong get g_cp get g_cm i
end
if gt nacc 0
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
typed = unsb
typed_low = ulong 0
if ne typed 0
typed_low = umsg typed usl m_lowercase 0 0 0
end
slower = usl m_lowercase
scontains = usl m_contains
sprefix = usl m_has_prefix
for i ulong nacc bound 800
has = ulong 0
starts = ulong 0
if ne typed_low 0
name_low = umsg umsg get g_m 18 get g_m 16 i 0 0 slower 0 0 0
has = and umsg name_low scontains typed_low 0 0 255
starts = and umsg name_low sprefix typed_low 0 0 255
end
upn tb add pacc mul i 2 has
upn tb add add pacc mul i 2 1 starts
end
end
note an app's own use and habits count as in Hop: how much it is used, its lifts from the app in front and the
note hour, and whether it is the app that was in front before (all as they were when the panel was last shown)
for i ulong m bound 2048
o = add 13 mul i 4
k = get g_mk i
upn tb o get g_ms i
upn tb add o 1 get g_us k
upn tb add o 2 add get g_lf k get g_lh k
was_before = ulong 0
if eq add k 1 get g_n 32
was_before = 1
end
upn tb add o 3 was_before
end
note a file's score may be below zero: it goes in as 2^40 plus the score, written as it is
for i ulong nf bound 64
o = add add 13 mul m 4 mul i 3
upb tb o sub add k_b get g_fs i 100000
upn tb add o 1 0
upn tb add o 2 uisapp i m
end
lo = add 8 mul c 8
for i ulong n bound 256
put tb add lo i uchar ulower ulong get g_q add a i
end
k = swrank tb c add n word_bytes ob
h = ulong 0
if ne k 0
rws = sub uog ob 0 k_b
for i ulong rws bound 1024
knd = sub uog ob add 1 mul i 4 k_b
ix = sub uog ob add 2 mul i 4 k_b
if and eq knd 1 lt ix m
put g_rk h 1
put g_hit h get g_mk ix
h = add h 1
end
if eq knd 2
put g_rk h 2
put g_hit h 0
h = add h 1
end
if and eq knd 7 lt ix nf
put g_rk h 7
put g_hit h ix
h = add h 1
end
if and and eq knd 7 ge ix nf lt ix nfa
put g_rk h 10
put g_hit h sub ix nf
h = add h 1
end
if eq knd 8
put g_rk h 8
put g_hit h 0
h = add h 1
end
if eq knd 9
put g_rk h 9
put g_hit h 0
h = add h 1
end
if and eq knd 6 lt ix ncl
put g_rk h 6
put g_hit h get g_cm ix
h = add h 1
end
if and eq knd 5 lt ix nacc
put g_rk h 5
put g_hit h ix
h = add h 1
end
if and eq knd 3 lt ix 3
put g_rk h 3
put g_hit h ix
h = add h 1
end
if and eq knd 4 lt ix 4
put g_rk h 4
put g_hit h ix
h = add h 1
end
end
end
put g_n 1 h
end

note ---- before anything is typed: what to offer, by Hop's rule (fn swsuggest, fn swlifts) ----
note the path of app k into g_nm from byte p (its folder, "/", its name, ".app"); the byte after it
fn uapppath p ulong k ulong to ulong
q = p
if eq ulong get g_dir k 0
q = uptxt p x_dir1
else
q = uptxt p x_dir2
end
q = uptxt q x_slash
q = upname q k
ret uptxt q x_dotapp
end

note byte j of app k's name with ".app" after it (0 past the end): what its path is ordered by within a folder
fn ukeybyte k ulong j ulong to ulong
n = get g_ln k
if lt j n
ret ulong get g_pool add get g_off k j
end
if lt j add n 4
ret ulong get x_dotapp sub j n
end
ret 0
end

note does app a come before app b in the order of their paths
fn uappless a ulong b ulong to bool
da = ulong get g_dir a
db = ulong get g_dir b
if ne da db
ret lt da db
end
for j ulong 1100
ca = ukeybyte a j
cb = ukeybyte b j
if ne ca cb
ret lt ca cb
end
if eq ca 0
ret false
end
end
ret false
end

note each app's path and place into a dictionary, and the apps into the order of their paths
fn ubuildmap to void
map = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
put g_m 10 umsg map usl m_retain 0 0 0
sset = usl m_set_object
snum = usl m_number_integer
cnum = ucl c_number
for k ulong get g_n 0 bound 2048
p = uapppath 0 k
put g_nm p 0
path = unsb
num = umsg cnum snum k 0 0
x = umsg map sset num path 0
pos = k
while gt pos 0 bound 4096
if not uappless k get g_so sub pos 1
break
end
put g_so pos get g_so sub pos 1
pos = sub pos 1
end
put g_so pos k
end
end

note the place of the app at this path (an NSString), or the count of apps when it is not one of them
fn uplaceof path ulong to ulong
if or eq path 0 eq get g_m 10 0
ret get g_n 0
end
num = umsg get g_m 10 usl m_object_for_key path 0 0
if eq num 0
ret get g_n 0
end
ret umsg num usl m_integer_value 0 0 0
end

note how much the user's own use lifts a path: 25 times the base-2 logarithm of 1 plus the count of openings, the
note count halved for every three days since the last, plus 10; 80 at most (Sources/Recents.swift)
fn uboost cnt ulong last_bits ulong now_bits ulong to ulong
age = sub bitcast f64 now_bits bitcast f64 last_bits
upr 64 bitcast ulong 0.5f64
upr 72 bitcast ulong div age 259200.0f64
x = ucall 14
weighed = mul f64 cnt bitcast f64 ugr 64
upr 64 bitcast ulong add 1.0f64 weighed
x = ucall 15
v = add mul 25.0f64 bitcast f64 ugr 64 10.0f64
if gt v 80.0f64
ret 80
end
if lt v 0.0f64
ret 0
end
ret ulong v
end

note remember the app in front (not this program) before the panel takes its place
fn ufront to void
ws = umsg ucl c_ws usl m_shws 0 0 0
app_front = umsg ws usl m_frontmost 0 0 0
this_app = umsg ucl c_running_app usl m_current_app 0 0 0
if or eq app_front 0 eq app_front this_app
ret
end
sret = usl m_retain
id = umsg app_front usl m_bundle_id 0 0 0
put g_m 11 0
if ne id 0
put g_m 11 umsg id sret 0 0 0
end
name = umsg app_front usl m_localized_name 0 0 0
put g_m 12 0
if ne name 0
put g_m 12 umsg name sret 0 0 0
end
put g_m 13 0
url = umsg app_front usl m_bundle_url 0 0 0
if eq url 0
ret
end
k = uplaceof umsg url usl m_path 0 0 0
if ge k get g_n 0
ret
end
put g_m 13 add k 1
note newest first, each app once
found = ulong 11
for i ulong 12
if and eq get g_fr i add k 1 eq found 11
found = i
end
end
pos = found
while gt pos 0 bound 16
put g_fr pos get g_fr sub pos 1
pos = sub pos 1
end
put g_fr 0 add k 1
end

note is the JSON value a number (a file a person may have edited can hold anything where a number belongs, and
note only a number can be asked for its value: a null, a list or a group asked so would stop the program)
fn uisnumber obj ulong to bool
if eq obj 0
ret false
end
ret eq and umsg obj usl m_is_kind ucl c_number 0 0 255 1
end

note a whole number from a JSON value (0 when it is none); below zero comes back as a number of 2^63 and up
fn ujsonint obj ulong to ulong
if not uisnumber obj
ret 0
end
ret umsg obj usl m_integer_value 0 0 0
end

note the rows before anything is typed: the lifts from habit, the use, what is running and what was in front go
note to the rule as numbers, in the order of the apps' paths; the app in front is never offered
fn usuggest to void
tb = new uchar 1048576 0
ob = new uchar 65544 0
na = get g_n 0
put g_n 1 0
if eq get g_m 10 0
ret
end
note the lifts from habit
for k ulong na bound 2048
put g_lf k 0
put g_lh k 0
put g_us k 0
put g_rn k 0
end
cal = umsg ucl c_calendar usl m_current_calendar 0 0 0
now_date = umsg ucl c_date usl m_date_now 0 0 0
hour = umsg cal usl m_component 32 now_date 0
front_id = get g_m 11
nl = ulong 0
habits = ulong 0
d = uhopfile x_habits
if ne d 0
habits = umsg ucl c_json usl m_json_object d 0 0
end
if uiskind habits 8
nl = umsg habits usl m_count 0 0 0
if gt nl 4096
nl = 4096
end
end
upn tb 0 hour
front_number = ulong 0
if ne front_id 0
front_number = 1
end
upn tb 1 front_number
upn tb 2 na
upn tb 3 nl
sat = usl m_at
for j ulong nl bound 4096
o = add 4 mul j 3
launch = umsg habits sat j 0 0
here = ulong 0
hr = ulong 0
place = na
if uiskind launch 7
from = ukeyed launch k_from
if and ne front_id 0 uiskind from 9
if eq and umsg from usl m_equal_string front_id 0 0 255 1
here = 1
end
end
hr = ujsonint ukeyed launch k_hour
opened = ukeyed launch k_app
if uiskind opened 9
place = uplaceof opened
end
end
upn tb o here
if ge hr 9223372036854775808
upb tb add o 1 sub k_b add xor hr 18446744073709551615 1
else
if gt hr 1000000
hr = 1000000
end
upn tb add o 1 hr
end
if lt place na
upn tb add o 2 place
else
upb tb add o 2 sub k_b 1
end
end
k1 = swlifts tb add 4 mul nl 3 ob
if ne k1 0
for k ulong na bound 2048
put g_lf k sub uog ob add 1 mul k 2 k_b
put g_lh k sub uog ob add 2 mul k 2 k_b
end
end
note how much each app is used
recents = ulong 0
d = uhopfile x_recents
if ne d 0
recents = umsg ucl c_json usl m_json_object d 0 0
end
if uiskind recents 7
x = umsg ucl c_date usl m_reference_now 0 0 0
now_bits = ugr 64
for k ulong na bound 2048
p = uptxt 0 x_mac_key
p = uapppath p k
put g_nm p 0
key = unsb
e = umsg recents usl m_object_for_key key 0 0
if uiskind e 7
cnt = ujsonint ukeyed e k_count
last = ukeyed e k_last
if and uisnumber last lt cnt 1000000000
x = umsg last usl m_double_value 0 0 0
put g_us k uboost cnt ugr 64 now_bits
end
end
end
end
note what is running (apps a person sees: the regular ones)
ws = umsg ucl c_ws usl m_shws 0 0 0
running = umsg ws usl m_running_apps 0 0 0
if ne running 0
nr = umsg running usl m_count 0 0 0
for j ulong nr bound 4096
r = umsg running sat j 0 0
if eq umsg r usl m_policy_of 0 0 0 0
url = umsg r usl m_bundle_url 0 0 0
if ne url 0
k = uplaceof umsg url usl m_path 0 0 0
if lt k na
put g_rn k 1
end
end
end
end
end
note the app in front before: the newest remembered one that is not in front now
front_place = get g_m 13
previous = ulong 0
for i ulong 12
if and and eq previous 0 ne get g_fr i 0 ne get g_fr i front_place
previous = get g_fr i
end
end
put g_n 32 previous
note the request of fn swsuggest: what was copied, then six numbers an app
for i ulong 6
upn tb i 0
end
ncl = get g_n 24
nrest = ulong 0
put g_n 25 0
put g_n 26 0
if gt ncl 0
upn tb 0 1
newest = umsg get g_m 14 get g_m 16 0 0 0
age = ulong 0
if uiskind newest 7
moment = ukeyed newest k_date
if uisnumber moment
x = umsg moment usl m_double_value 0 0 0
then_bits = ugr 64
x = umsg ucl c_date usl m_reference_now 0 0 0
gap = sub bitcast f64 ugr 64 bitcast f64 then_bits
if gt gap 0.0f64
age = 1000000000
if lt gap 1000000000.0f64
age = ulong gap
end
end
end
words = ukeyed newest k_text
if uiskind words 9
wb = umsg words get g_o 5 0 0 0
if ne wb 0
upr 0 wb
wn = ucall 7
if and ge wn 4 le wn 255
upr 0 ulong libptr g_ca 0 wn
upr 8 wb
upr 16 wn
x = ucall 8
if and and eq ulower ulong get g_ca 0 104 eq ulower ulong get g_ca 1 116 and eq ulower ulong get g_ca 2 116 eq ulower ulong get g_ca 3 112
put g_n 25 wn
uclipaddr 1
udecide
put g_n 26 get g_n 10
uclipaddr 0
end
end
end
end
end
upn tb 1 age
if ne get g_n 26 0
upn tb 2 1
end
upn tb 3 ufrontbrowser
for pos ulong ncl bound 1024
i = get g_ci pos
if and ne i 0 lt nrest 20
put g_cr nrest i
nrest = add nrest 1
end
end
upn tb 4 nrest
end
put g_n 27 nrest
upn tb 6 na
for pos ulong na bound 2048
k = get g_so pos
o = add 7 mul pos 6
if eq add k 1 front_place
for i ulong 6
upn tb add o i 0
end
else
upn tb o get g_lf k
upn tb add o 1 get g_lh k
upn tb add o 2 get g_us k
upn tb add o 3 ulong get g_rn k
was_before = ulong 0
if eq add k 1 previous
was_before = 1
end
upn tb add o 4 was_before
lately = ulong 0
for i ulong 5
if eq get g_fr i add k 1
lately = sub 10 mul 2 i
end
end
upn tb add o 5 lately
end
end
k2 = swsuggest tb add 7 mul na 6 ob
h = ulong 0
if ne k2 0
rws = sub uog ob 0 k_b
for i ulong rws bound 64
knd = sub uog ob add 1 mul i 4 k_b
ix = sub uog ob add 2 mul i 4 k_b
if and eq knd 1 lt ix na
put g_rk h 1
put g_hit h get g_so ix
put g_why h uchar sub uog ob add 4 mul i 4 k_b
h = add h 1
end
if and eq knd 6 le ix nrest
put g_rk h 6
if eq ix 0
put g_hit h 0
else
put g_hit h get g_cr sub ix 1
end
put g_why h uchar sub uog ob add 4 mul i 4 k_b
h = add h 1
end
if and eq knd 2 ne get g_n 26 0
put g_rk h 2
put g_hit h 0
put g_why h 3
h = add h 1
end
end
end
put g_n 1 h
end

note ---- remembering what was opened, as Hop does (Habits.record in Sources/Smart.swift, Sources/Recents.swift) ----
note Both files are read again at that moment and written whole, all at once. A file that is there but is not
note what Hop writes is left alone. While Hop itself runs it keeps its own copy and writes that over the file the
note next time it remembers something, so what the panel added then is lost.
note write the JSON object obj as Hop's file named t; private: only the owner may read it; 1 when it was written
fn uhopwrite obj ulong t view uchar * private ulong to ulong
data = umsg ucl c_json usl m_json_data obj 0 0
if eq data 0
ret 0
end
s_write = usl m_write_file
path = uhoppath t
if eq path 0
ret 0
end
ok = and umsg data s_write path 1 0 255
if and eq ok 1 eq private 1
path = uhoppath t
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
end
ret ok
end

note the weight of an entry of recents.json: its count of openings, halved for every three days since the last
fn urecentweight e ulong now_bits ulong to ulong
if not uiskind e 7
ret bitcast ulong 0.0f64
end
cnt = ujsonint ukeyed e k_count
if ge cnt 1000000000
cnt = 0
end
last = ukeyed e k_last
if not uisnumber last
ret bitcast ulong 0.0f64
end
x = umsg last usl m_double_value 0 0 0
last_bits = ugr 64
age = sub bitcast f64 now_bits bitcast f64 last_bits
upr 64 bitcast ulong 0.5f64
upr 72 bitcast ulong div age 259200.0f64
x = ucall 14
ret bitcast ulong mul f64 cnt bitcast f64 ugr 64
end

note one more opening of path (an NSString) into recents.json: its count up by one, now as the last time; over 500
note entries the one that weighs least goes
fn urecent path ulong to void
recents = ulong 0
d = uhopfile x_recents
if ne d 0
recents = umsg ucl c_json usl m_json_object d 1 0
if not uiskind recents 7
ret
end
else
recents = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
end
prefix = uns x_mac_key
key = umsg prefix usl m_append_string path 0 0
sset = usl m_set_object
cnum = ucl c_number
e = umsg recents usl m_object_for_key key 0 0
cnt = ulong 0
if uiskind e 7
cnt = ujsonint ukeyed e k_count
if ge cnt 1000000000
cnt = 0
end
else
e = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
key_path = uns k_path
x = umsg e sset path key_path 0
x = umsg recents sset e key 0
end
num = umsg cnum usl m_number_integer add cnt 1 0 0
key_count = uns k_count
x = umsg e sset num key_count 0
x = umsg ucl c_date usl m_reference_now 0 0 0
now_bits = ugr 64
s_double = usl m_number_double
upr 64 now_bits
last = umsg cnum s_double 0 0 0
key_last = uns k_last
x = umsg e sset last key_last 0
n = umsg recents usl m_count 0 0 0
if gt n 500
keys = umsg recents usl m_all_keys 0 0 0
sat = usl m_at
least = ulong 0
least_bits = ulong 0
for i ulong n bound 4096
k = umsg keys sat i 0 0
w = urecentweight umsg recents usl m_object_for_key k 0 0 now_bits
if or eq least 0 lt bitcast f64 w bitcast f64 least_bits
least = k
least_bits = w
end
end
if ne least 0
x = umsg recents usl m_remove_key least 0 0
end
end
x = uhopwrite recents x_recents 0
end

note app k was opened: into recents.json, and into habits.json with the app that was in front and the hour (the
note newest 400 are kept)
fn urecordapp k ulong to void
p = uapppath 0 k
put g_nm p 0
path = unsb
urecent path
habits = ulong 0
d = uhopfile x_habits
if ne d 0
habits = umsg ucl c_json usl m_json_object d 1 0
if not uiskind habits 8
ret
end
else
habits = umsg ucl c_mutable_array usl m_array 0 0 0
end
cal = umsg ucl c_calendar usl m_current_calendar 0 0 0
now_date = umsg ucl c_date usl m_date_now 0 0 0
hour = umsg cal usl m_component 32 now_date 0
x = umsg ucl c_date usl m_reference_now 0 0 0
now_bits = ugr 64
cnum = ucl c_number
sset = usl m_set_object
launch = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
key_app = uns k_app
x = umsg launch sset path key_app 0
from_id = get g_m 11
if eq from_id 0
put g_nm 0 0
from_id = unsb
end
key_from = uns k_from
x = umsg launch sset from_id key_from 0
num = umsg cnum usl m_number_integer hour 0 0
key_hour = uns k_hour
x = umsg launch sset num key_hour 0
s_double = usl m_number_double
upr 64 now_bits
moment = umsg cnum s_double 0 0 0
key_moment = uns k_at_key
x = umsg launch sset moment key_moment 0
x = umsg habits usl m_add_object launch 0 0
n = umsg habits usl m_count 0 0 0
if gt n 400
x = umsg habits usl m_remove_range 0 sub n 400 0
end
x = uhopwrite habits x_habits 1
end

note best file i was opened: into recents.json under its whole path
fn urecordfile i ulong to void
p = ufilepath 0 i
if eq p 0
ret
end
put g_nm p 0
path = unsb
urecent path
end

note why an offered app is offered into g_nm from byte p (nothing for a typed row); the byte after it
fn uwhy p ulong r ulong to ulong
w = ulong get g_why r
if or ne get g_n 13 0 eq w 0
ret p
end
q = uptxt p x_gap
if eq w 1
ret uptxt q x_why1
end
if eq w 2
ret uptxt q x_why2
end
if eq w 3
ret uptxt q x_why3
end
if eq w 4
q = uptxt q x_why4
name = get g_m 12
if eq name 0
ret uptxt q x_here
end
name_bytes = umsg name get g_o 5 0 0 0
upr 0 name_bytes
n = ucall 7
if gt n 200
n = 200
end
upr 0 ulong libptr g_nm q n
upr 8 name_bytes
upr 16 n
x = ucall 8
ret add q n
end
if eq w 5
ret uptxt q x_why5
end
if eq w 6
ret uptxt q x_why6
end
if eq w 7
ret uptxt q x_why7
end
ret uptxt q x_why8
end

note ---- building the file index, as Hop builds it (Sources/FileIndex.swift, rebuild) ----
note The program run with the one argument "index" walks the folders of Hop's settings (indexRoots; without
note settings the home folder, /Applications and /System/Applications) at throttled disk priority with the walker
note Hop uses (NSFileManager's, hidden things left out), and writes every path, a line each, as Hop's
note file-index.bin, all at once, for the owner only. A folder with one of the names to skip, or one that is a
note link, is left out with all in it; a package (an app, a document that is a folder) is one line. Three million
note lines at most. It is a program of its own run beside the panel, because the panel does one thing at a time.
note is the resource named key of the URL u set (a yes among its values)
fn uresource u ulong sget ulong key ulong to bool
for i ulong 8
put g_t8 i 0
end
x = umsg u sget ulong libptr g_t8 0 8 key 0
v = uread8
if eq v 0
ret false
end
ret eq and umsg v usl m_bool_value 0 0 0 255 1
end

fn uindexbuild to ulong
upr 0 0
upr 8 0
upr 16 3
x = ucall 29
folder_roots = ulong 0
skip_names = ulong 0
d = uhopfile x_config
if ne d 0
config = umsg ucl c_json usl m_json_object d 0 0
if uiskind config 7
folder_roots = ukeyed config k_roots
if not uiskind folder_roots 8
folder_roots = 0
end
skip_names = ukeyed config k_skip_names
if not uiskind skip_names 8
skip_names = 0
end
end
end
sadd = usl m_add_object
if eq folder_roots 0
folder_roots = umsg ucl c_mutable_array usl m_array 0 0 0
x = ucall 30
home_folder = ugr 0
if ne home_folder 0
x = umsg folder_roots sadd home_folder 0 0
end
x = umsg folder_roots sadd uns x_applications 0 0
x = umsg folder_roots sadd uns x_system_applications 0 0
end
if eq skip_names 0
skip_names = umsg ucl c_mutable_array usl m_array 0 0 0
x = umsg skip_names sadd uns x_skipname0 0 0
x = umsg skip_names sadd uns x_skipname1 0 0
x = umsg skip_names sadd uns x_skipname2 0 0
x = umsg skip_names sadd uns x_skipname3 0 0
x = umsg skip_names sadd uns x_skipname4 0 0
x = umsg skip_names sadd uns x_skipname5 0 0
x = umsg skip_names sadd uns x_skipname6 0 0
x = umsg skip_names sadd uns x_skipname7 0 0
x = umsg skip_names sadd uns x_skipname8 0 0
x = umsg skip_names sadd uns x_skipname9 0 0
x = umsg skip_names sadd uns x_skipname10 0 0
x = umsg skip_names sadd uns x_skipname11 0 0
x = umsg skip_names sadd uns x_skipname12 0 0
x = umsg skip_names sadd uns x_skipname13 0 0
x = umsg skip_names sadd uns x_skipname14 0 0
x = umsg skip_names sadd uns x_skipname15 0 0
end
skip_set = umsg ucl c_set usl m_set_with_array skip_names 0 0
key_dir = uconst s_key_directory
key_pkg = uconst s_key_package
key_link = uconst s_key_link
wanted_keys = umsg ucl c_mutable_array usl m_array 0 0 0
x = umsg wanted_keys sadd key_dir 0 0
x = umsg wanted_keys sadd key_pkg 0 0
x = umsg wanted_keys sadd key_link 0 0
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
index_lines = umsg ucl c_mutable_data usl m_data 0 0 0
sappend = usl m_append_bytes
snext = usl m_next_object
sget = usl m_get_resource
spath = usl m_path
slast = usl m_last_component
sskip = usl m_skip_descendants
shas = usl m_contains_object
s_enum = usl m_enumerator
sat = usl m_at
c_p = ucl c_pool
salloc = usl m_alloc
sinit = usl m_init
sdrain = usl m_drain
sfurl = usl m_furl
c_u = ucl c_url
put g_nl 0 10
listed = ulong 0
nroots = umsg folder_roots usl m_count 0 0 0
for ri ulong nroots bound 64
folder_root = umsg folder_roots sat ri 0 0
if uiskind folder_root 9
folder_url = umsg c_u sfurl folder_root 0 0
upr 40 0
en = umsg manager s_enum folder_url wanted_keys 4
if ne en 0
walking = true
for portion ulong 3001 bound 3001
if walking
walk_pool = umsg umsg c_p salloc 0 0 0 sinit 0 0 0
for turn ulong 1000 bound 1000
if and walking lt listed 3000000
u = umsg en snext 0 0 0
if eq u 0
walking = false
else
list_it = true
if uresource u sget key_dir
item_name = umsg u slast 0 0 0
skip_it = eq and umsg skip_set shas item_name 0 0 255 1
if not skip_it
skip_it = uresource u sget key_link
end
if skip_it
x = umsg en sskip 0 0 0
list_it = false
else
if uresource u sget key_pkg
x = umsg en sskip 0 0 0
end
end
end
if list_it
path_bytes = umsg umsg u spath 0 0 0 get g_o 5 0 0 0
if ne path_bytes 0
upr 0 path_bytes
pn = ucall 7
x = umsg index_lines sappend path_bytes pn 0
x = umsg index_lines sappend ulong libptr g_nl 0 1 1 0
listed = add listed 1
end
end
end
end
end
x = umsg walk_pool sdrain 0 0 0
if ge listed 3000000
walking = false
end
end
end
end
end
end
s_write = usl m_write_file
path = uhoppath x_index
if eq path 0
ret 1
end
ok = and umsg index_lines s_write path 1 0 255
path = uhoppath x_index
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
p = uptxt 0 x_indexed
p = upnum p listed
p = uptxt p x_items
put g_nm p 10
upr 0 1
upr 8 ulong libptr g_nm 0 1024
upr 16 add p 1
x = ucall 3
if eq ok 1
ret 0
end
ret 1
end

note when the program was run with the one argument "index": build the index (0 done, 1 not written); else 2
fn uindexmode to ulong
run_arguments = umsg umsg ucl c_process_info usl m_process_info 0 0 0 usl m_arguments 0 0 0
if eq run_arguments 0
ret 2
end
if le umsg run_arguments usl m_count 0 0 0 1
ret 2
end
first_argument = umsg run_arguments get g_m 16 1 0 0
if ne and umsg first_argument usl m_equal_string uns x_index_word 0 0 255 1
ret 2
end
ret uindexbuild
end

note start building the file index in a program of its own (this one, run with "index"); one at a time
fn uindexstart to void
if ne get g_m 23 0
ret
end
exe = umsg umsg ucl c_bundle usl m_main_bundle 0 0 0 usl m_executable_path 0 0 0
if eq exe 0
ret
end
task = umsg ucl c_task usl m_alloc 0 0 0
task = umsg task usl m_init 0 0 0
x = umsg task usl m_set_launch exe 0 0
arguments = umsg ucl c_mutable_array usl m_array 0 0 0
x = umsg arguments usl m_add_object uns x_index_word 0 0
x = umsg task usl m_set_arguments arguments 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_output quiet 0 0
x = umsg task usl m_launch 0 0 0
put g_m 23 umsg task usl m_retain 0 0 0
ushowst
end

note is the file index missing, or older than half an hour (Hop builds it anew that often)
fn uindexstale to bool
path = uhoppath x_index
if eq path 0
ret false
end
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
attributes = umsg manager usl m_attributes_of path 0 0
if eq attributes 0
ret true
end
changed = umsg attributes usl m_object_for_key uconst s_modified 0 0
if eq changed 0
ret true
end
x = umsg changed usl m_since_now 0 0 0
age = sub 0.0f64 bitcast f64 ugr 64
ret gt age 1800.0f64
end

note twice a second: when the program building the index has ended, read the new index and show the list anew;
note every half hour, and when the panel starts, build it anew when it is old and Hop is not there to do it
fn uindextick to void
if ne get g_m 23 0
if eq and umsg get g_m 23 usl m_is_running 0 0 0 255 0
x = umsg get g_m 23 usl m_release 0 0 0
put g_m 23 0
uloadindex
if ne get g_n 13 0
unarrow
x = umsg get g_o 1 get g_o 7 0 0 0
end
ushowst
end
ret
end
put g_n 38 add get g_n 38 1
if ge get g_n 38 3600
put g_n 38 0
if and not uhoprunning uindexstale
uindexstart
end
if not uhoprunning
uremoterefreshall
end
end
end

note ---- the agent: the person's coding agent, run on this Mac for the typed text (Sources/Model.swift, runAgent) ----
note Hop's settings name the agents (each a name and a command, "{prompt}" standing for the request) and the one
note to use. Only that one is ever run, and only when it is installed: the look goes through the login shell
note with the usual tool folders added, as Hop's does. The command runs through the same wrapper as in Hop, in
note the folder of the settings; what it prints is shown as it comes (the lines of Claude Code's stream are read
note for their text and the tools they name). Hop's standing instructions ride along. Not here yet: what the
note knowledge base knows, and the count of tokens.
note an NSString of text t with every "~" turned into a double quote
fn uquoted t view uchar * to ulong
put g_nm 0 34
put g_nm 1 0
quote_mark = unsb
plain = uns t
ret umsg plain usl m_replace uns x_tilde quote_mark 0
end

note the words of text t (separated by "|") as an array
fn uwords t view uchar * to ulong
whole = uns t
ret umsg whole usl m_components uns x_bar 0 0
end

note an agent: a name and a command
fn uengine name ulong command ulong to ulong
e = umsg ucl c_mutable_dict usl m_dictionary 0 0 0
sset = usl m_set_object
x = umsg e sset name uns k_name 0
x = umsg e sset command uns k_command 0
ret e
end

note is the JSON value v a yes: JSON's own true and nothing else, as Hop reads its settings (a null, a number,
note a text, a list or a group is not)
fn uyes v ulong to bool
if eq v 0
ret false
end
ret eq v uconst s_cf_true
end

note the agents Hop has out of the box (none of them switches a tool's own approval prompts or sandbox off)
fn uenginedefaults to ulong
all_engines = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg all_engines sadd uengine uns x_engine0 uwords x_engine0_command 0 0
x = umsg all_engines sadd uengine uns x_engine1 uwords x_engine1_command 0 0
x = umsg all_engines sadd uengine uns x_engine2 uwords x_engine2_command 0 0
x = umsg all_engines sadd uengine uns x_engine3 uwords x_engine3_command 0 0
x = umsg all_engines sadd uengine uns x_engine4 uwords x_engine4_command 0 0
x = umsg all_engines sadd uengine uns x_engine5 uwords x_engine5_command 0 0
x = umsg all_engines sadd uengine uns x_engine6 uwords x_engine6_command 0 0
ret all_engines
end

note the zero-ended bytes at src into g_nm from byte p (900 bytes at most in all); the byte after them
fn ufetchat p ulong src ulong to ulong
if or eq src 0 ge p 900
ret p
end
upr 0 src
n = ucall 7
if gt add p n 900
n = sub 900 p
end
if eq n 0
ret p
end
upr 0 ulong libptr g_nm p n
upr 8 src
upr 16 n
x = ucall 8
ret add p n
end

note what Hop's settings say about the agent (config: the settings, or 0 without any). A saved command that is
note exactly one of the old built-in ones that switched approval prompts or the sandbox off is brought to
note today's built-in one, unless keepAgentFlags says the commands are wanted as written (as Hop does on reading)
fn uagentconfig config ulong to void
engines = ulong 0
chosen = ulong 0
legacy = ulong 0
folder = ulong 0
keep_flags = false
put g_n 42 0
put g_n 44 0
put g_n 45 0
if ne config 0
engines = ukeyed config k_engines
chosen = ukeyed config k_engine
legacy = ukeyed config k_agent_command
folder = ukeyed config k_agent_folder
keep_flags = uyes ukeyed config k_keep_flags
if uyes ukeyed config k_enter_agent
put g_n 42 1
end
if uyes ukeyed config k_agent_confirmed
put g_n 44 1
end
end
defaults = uenginedefaults
sat = usl m_at
if not uiskind engines 8
engines = defaults
else
if not keep_flags
moved = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
sequal = usl m_equal_string
ssame = usl m_is_equal_array
cnt = umsg engines usl m_count 0 0 0
for i ulong cnt bound 256
e = umsg engines sat i 0 0
if uiskind e 7
name = ukeyed e k_name
command = ukeyed e k_command
if and uiskind name 9 uiskind command 8
if and eq and umsg name sequal uns x_engine1 0 0 255 1 eq and umsg command ssame uwords x_old0_command 0 0 255 1
e = umsg defaults sat 1 0 0
end
if and eq and umsg name sequal uns x_engine2 0 0 255 1 eq and umsg command ssame uwords x_old1_command 0 0 255 1
e = umsg defaults sat 2 0 0
end
if and eq and umsg name sequal uns x_engine3 0 0 255 1 eq and umsg command ssame uwords x_old2_command 0 0 255 1
e = umsg defaults sat 3 0 0
end
if and eq and umsg name sequal uns x_engine5 0 0 255 1 eq and umsg command ssame uwords x_old3_command 0 0 255 1
e = umsg defaults sat 5 0 0
end
if and eq and umsg name sequal uns x_engine6 0 0 255 1 eq and umsg command ssame uwords x_old4_command 0 0 255 1
e = umsg defaults sat 6 0 0
end
end
end
x = umsg moved sadd e 0 0
end
engines = moved
end
end
if not uiskind chosen 9
chosen = uns x_engine0
end
if not uiskind legacy 8
legacy = uwords x_engine0_command
end
if not uiskind folder 9
x = ucall 30
folder = ugr 0
end
sret = usl m_retain
put g_m 28 umsg engines sret 0 0 0
put g_m 29 umsg chosen sret 0 0 0
put g_m 30 umsg folder sret 0 0 0
put g_m 31 umsg legacy sret 0 0 0
if ne config 0
put g_m 34 umsg config sret 0 0 0
end
note for a check (HOPAGENTS): say each agent's command as it would be run
if eq get g_n 14 0
n = ucs x_env_agents
upr 0 ulong libptr g_nm 0 1024
if ne ucall 9 0
cnt = umsg engines usl m_count 0 0 0
sjoin = usl m_joined
for i ulong cnt bound 256
e = umsg engines sat i 0 0
if uiskind e 7
name = ukeyed e k_name
command = ukeyed e k_command
if and uiskind name 9 uiskind command 8
said_words = umsg command sjoin uns x_space 0 0
name_bytes = umsg name get g_o 5 0 0 0
word_bytes = umsg said_words get g_o 5 0 0 0
p = uptxt 0 x_engine_word
p2 = ufetchat p name_bytes
p2 = uptxt p2 x_colon
p2 = ufetchat p2 word_bytes
put g_nm p2 10
upr 0 1
upr 8 ulong libptr g_nm 0 1024
upr 16 add p2 1
x = ucall 3
end
end
end
end
end
end

note s between single quotes for a shell
fn ushellquote s ulong to ulong
put g_nm 0 39
put g_nm 1 0
tick = unsb
put g_nm 0 39
put g_nm 1 92
put g_nm 2 39
put g_nm 3 39
put g_nm 4 0
escaped = unsb
inner = umsg s usl m_replace tick escaped 0
sappend = usl m_append_string
ret umsg umsg tick sappend inner 0 0 sappend tick 0 0
end

note the folders tools are commonly installed in, joined by ":" (searched after the login shell's own PATH)
fn uextrapath to ulong
x = ucall 30
home_folder = ugr 0
if eq home_folder 0
ret uns x_colon_only
end
dirs = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
sappend = usl m_append_string
slash = uns x_slash_text
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path0 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path1 0 0 0 0
x = umsg dirs sadd uns x_path2 0 0
x = umsg dirs sadd uns x_path3 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path4 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path5 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path6 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path7 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path8 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path9 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path10 0 0 0 0
x = umsg dirs sadd umsg umsg home_folder sappend slash 0 0 sappend uns x_path11 0 0 0 0
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
sat = usl m_at
for which ulong 2
versions_root = umsg home_folder sappend uns x_nvm 0 0
if eq which 1
versions_root = umsg home_folder sappend uns x_herd 0 0
end
found_versions = umsg manager usl m_contents_of_dir versions_root 0 0
if ne found_versions 0
ordered = umsg found_versions usl m_sorted usl m_standard_compare 0 0
cnt = umsg ordered usl m_count 0 0 0
for back ulong cnt bound 512
v = umsg ordered sat sub sub cnt 1 back 0 0
one_dir = umsg umsg umsg versions_root sappend slash 0 0 sappend v 0 0 sappend uns x_slash_bin 0 0
if eq and umsg one_dir usl m_contains uns x_colon_only 0 0 255 0
x = umsg dirs sadd one_dir 0 0
end
end
end
end
ret umsg dirs usl m_joined uns x_colon_only 0 0
end

note a program run through the login shell, as Hop runs every command: zsh -lc with the wrapper that adds the
note tool folders, then the words of argv; TERM is dumb and colours are off. Not started yet
fn ushellrun argv ulong folder ulong to ulong
task = umsg ucl c_task usl m_alloc 0 0 0
task = umsg task usl m_init 0 0 0
x = umsg task usl m_set_launch uns x_zsh 0 0
arguments = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg arguments sadd uns x_dash_lc 0 0
x = umsg arguments sadd uquoted x_wrapper 0 0
x = umsg arguments sadd uns x_hop_word 0 0
cnt = umsg argv usl m_count 0 0 0
sat = usl m_at
for i ulong cnt bound 256
x = umsg arguments sadd umsg argv sat i 0 0 0 0
end
x = umsg task usl m_set_arguments arguments 0 0
if ne folder 0
x = umsg task usl m_set_cwd folder 0 0
end
around = umsg umsg umsg ucl c_process_info usl m_process_info 0 0 0 usl m_environment 0 0 0 usl m_mutable_copy 0 0 0
sset = usl m_set_object
x = umsg around sset uns x_dumb uns x_term 0
x = umsg around sset uns x_one uns x_no_color 0
x = umsg around sset uextrapath uns x_extra_path 0
x = umsg task usl m_set_environment around 0 0
ret task
end

note the agents of the settings that are installed on this Mac, looked for once (the login shell is asked for
note each tool); when none of them is and the older single command's tool is, that one, as "Custom command"
fn uagentsfound to ulong
if eq get g_n 45 1
ret get g_m 35
end
engines = get g_m 28
sat = usl m_at
sappend = usl m_append_string
put g_nm 0 10
put g_nm 1 0
line_end = unsb
script = umsg ucl c_mutable_string usl m_string 0 0 0
smore = usl m_append
cnt = umsg engines usl m_count 0 0 0
for i ulong cnt bound 256
e = umsg engines sat i 0 0
if uiskind e 7
name = ukeyed e k_name
command = ukeyed e k_command
if and uiskind name 9 uiskind command 8
if gt umsg command usl m_count 0 0 0 0
tool = umsg command sat 0 0 0
if uiskind tool 9
x = umsg script smore uns x_probe_a 0 0
x = umsg script smore ushellquote tool 0 0
x = umsg script smore uns x_probe_b 0 0
x = umsg script smore ushellquote name 0 0
x = umsg script smore line_end 0 0
end
end
end
end
end
legacy = get g_m 31
if gt umsg legacy usl m_count 0 0 0 0
tool = umsg legacy sat 0 0 0
if uiskind tool 9
if gt umsg tool usl m_length 0 0 0 0
x = umsg script smore uns x_probe_a 0 0
x = umsg script smore ushellquote tool 0 0
x = umsg script smore uns x_probe_b 0 0
x = umsg script smore uns x_legacy_mark 0 0
x = umsg script smore line_end 0 0
end
end
end
x = umsg script smore uns x_true_word 0 0
argv = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg argv sadd uns x_sh 0 0
x = umsg argv sadd uns x_dash_c 0 0
x = umsg argv sadd script 0 0
task = ushellrun argv 0
tube = umsg ucl c_pipe usl m_pipe 0 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_output tube 0 0
x = umsg task usl m_set_error quiet 0 0
x = umsg task usl m_set_input quiet 0 0
x = umsg task usl m_launch 0 0 0
d = umsg umsg tube usl m_reading 0 0 0 usl m_read_end 0 0 0
x = umsg task usl m_wait 0 0 0
found = umsg ucl c_mutable_array usl m_array 0 0 0
if ne d 0
said = umsg ucl c_str usl m_alloc 0 0 0
said = umsg said usl m_init_data_encoding d 4 0
if ne said 0
names_said = umsg said usl m_components line_end 0 0
shas = usl m_contains_object
for i ulong cnt bound 256
e = umsg engines sat i 0 0
if uiskind e 7
name = ukeyed e k_name
if uiskind name 9
if eq and umsg names_said shas name 0 0 255 1
x = umsg found sadd e 0 0
end
end
end
end
if and eq umsg found usl m_count 0 0 0 0 eq and umsg names_said shas uns x_legacy_mark 0 0 255 1
x = umsg found sadd uengine uns x_custom_command legacy 0 0
end
end
end
put g_m 35 umsg found usl m_retain 0 0 0
put g_n 45 1
ret found
end

note the agent to run: the one the settings name, when it is installed; never another in its place
fn uagentpicked to ulong
found = uagentsfound
cnt = umsg found usl m_count 0 0 0
sat = usl m_at
sequal = usl m_equal_string
for pass_no ulong 2
want = get g_m 29
if eq pass_no 1
want = uns x_custom_command
end
for i ulong cnt bound 256
e = umsg found sat i 0 0
if eq and umsg ukeyed e k_name sequal want 0 0 255 1
ret e
end
end
end
ret 0
end

note why nothing was run, in plain words
fn uagentwhy to ulong
found = uagentsfound
sappend = usl m_append_string
sat = usl m_at
if eq umsg found usl m_count 0 0 0 0
engines = get g_m 28
cnt = umsg engines usl m_count 0 0 0
if eq cnt 0
ret uns x_agent_none_b
end
out_text = uns x_agent_none_a
for i ulong cnt bound 256
e = umsg engines sat i 0 0
if uiskind e 7
name = ukeyed e k_name
command = ukeyed e k_command
if and uiskind name 9 uiskind command 8
if gt i 0
out_text = umsg out_text sappend uns x_comma_space 0 0
end
out_text = umsg out_text sappend name 0 0
if gt umsg command usl m_count 0 0 0 0
out_text = umsg out_text sappend uns x_paren_a 0 0
out_text = umsg out_text sappend umsg command sat 0 0 0 0 0
out_text = umsg out_text sappend uns x_paren_b 0 0
end
end
end
end
ret umsg out_text sappend uns x_period 0 0
end
out_text = umsg get g_m 29 sappend uns x_agent_missing_a 0 0
cnt = umsg found usl m_count 0 0 0
for i ulong cnt bound 256
if gt i 0
out_text = umsg out_text sappend uns x_comma_space 0 0
end
out_text = umsg out_text sappend ukeyed umsg found sat i 0 0 k_name 0 0
end
ret umsg out_text sappend uns x_agent_missing_b 0 0
end

note Hop's standing instructions for the agent (Sources/Machines.swift, agentBriefing): kept tiny on purpose
fn uagentbrief to ulong
sappend = usl m_append_string
config = get g_m 34
owner = uns x_the_user
if ne config 0
given = ukeyed config k_owner
if uiskind given 9
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
given = umsg given usl m_trim blanks 0 0
if gt umsg given usl m_length 0 0 0 0
owner = given
end
end
end
head = umsg umsg owner usl m_substring_to 1 0 0 usl m_uppercase 0 0 0
brief = umsg umsg head sappend umsg owner usl m_substring_from 1 0 0 0 0 sappend uns x_brief_a 0 0
if ne config 0
machines = ukeyed config k_machines
if uiskind machines 8
cnt = umsg machines usl m_count 0 0 0
if gt cnt 0
sat = usl m_at
hosts = umsg ucl c_mutable_array usl m_array 0 0 0
for i ulong cnt bound 256
m = umsg machines sat i 0 0
if uiskind m 7
name = ukeyed m k_name
via = ukeyed m k_ssh
if and uiskind name 9 uiskind via 9
one_host = umsg umsg umsg name sappend uns x_ssh_a 0 0 sappend via 0 0 sappend uns x_ssh_b 0 0
x = umsg hosts usl m_add_object one_host 0 0
end
end
end
brief = umsg brief sappend uns x_brief_b 0 0
brief = umsg brief sappend umsg hosts usl m_joined uns x_semi_space 0 0 0 0
brief = umsg brief sappend uns x_brief_c 0 0
end
end
factory = ukeyed config k_factory_url
if uiskind factory 9
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
if gt umsg umsg factory usl m_trim blanks 0 0 usl m_length 0 0 0 0
brief = umsg brief sappend uns x_brief_d 0 0
brief = umsg brief sappend factory 0 0
brief = umsg brief sappend uns x_period 0 0
end
end
end
ret umsg brief sappend uns x_brief_e 0 0
end

note add a line to what the agent said, and show it
fn uagentsay line ulong to void
if eq line 0
ret
end
if eq get g_n 22 0
put g_nm 0 0
no_text = unsb
x = umsg get g_m 4 usl m_set_string no_text 0 0
put g_n 22 1
end
sappend_text = usl m_append
x = umsg get g_m 4 sappend_text line 0 0
put g_nm 0 10
put g_nm 1 0
x = umsg get g_m 4 sappend_text unsb 0 0
if eq get g_n 20 1
uanswershow
end
end

note one line the agent printed, as Hop shows it (Sources/Runners.swift, AgentEvents): a line of Claude Code's
note stream gives its text and "> " and the name of each tool it uses, and its last line the id to carry on
note from (an error there is said); any other line is shown as it is. 0: nothing to show
fn uagentline line ulong to ulong
if eq and umsg line usl m_has_prefix uns x_brace 0 0 255 0
ret line
end
d = umsg line usl m_data_using 4 0 0
if eq d 0
ret line
end
obj = umsg ucl c_json usl m_json_object d 0 0
if not uiskind obj 7
ret line
end
kind = ukeyed obj k_type
if not uiskind kind 9
ret 0
end
sequal = usl m_equal_string
sappend = usl m_append_string
if eq and umsg kind sequal uns x_assistant 0 0 255 1
message = ukeyed obj k_message
if not uiskind message 7
ret 0
end
parts = ukeyed message k_content
if not uiskind parts 8
ret 0
end
put g_nm 0 10
put g_nm 1 0
line_end = unsb
put g_nm 0 0
shown_text = unsb
cnt = umsg parts usl m_count 0 0 0
sat = usl m_at
have = ulong 0
for i ulong cnt bound 1024
part_v = umsg parts sat i 0 0
if uiskind part_v 7
part_kind = ukeyed part_v k_type
piece = ulong 0
if uiskind part_kind 9
if eq and umsg part_kind sequal uns k_parts_text 0 0 255 1
piece = ukeyed part_v k_parts_text
if not uiskind piece 9
piece = 0
end
end
if eq and umsg part_kind sequal uns k_tool_use 0 0 255 1
tool_name = ukeyed part_v k_name
if not uiskind tool_name 9
tool_name = uns x_tool_word
end
piece = umsg uns x_tool_mark sappend tool_name 0 0
end
end
if ne piece 0
if eq have 1
shown_text = umsg shown_text sappend line_end 0 0
end
shown_text = umsg shown_text sappend piece 0 0
have = 1
end
end
end
if eq have 0
ret 0
end
ret shown_text
end
if eq and umsg kind sequal uns k_result 0 0 255 1
sid = ukeyed obj k_session_id
if uiskind sid 9
if ne get g_m 33 0
x = umsg get g_m 33 usl m_release 0 0 0
end
put g_m 33 umsg sid usl m_retain 0 0 0
end
if uyes ukeyed obj k_is_error
problem = ukeyed obj k_result
if not uiskind problem 9
problem = uns x_agent_error
end
ret umsg uns x_bang sappend problem 0 0
end
end
ret 0
end

note output of the agent arrived (d; nothing left when it is empty): every whole line is shown
fn uagentout d ulong to void
buffer = get g_m 32
if eq buffer 0
ret
end
n = umsg d usl m_length 0 0 0
if gt n 0
x = umsg buffer usl m_append_data d 0 0
end
put g_nl 0 10
newline = umsg ucl c_data usl m_data_bytes ulong libptr g_nl 0 1 1 0
srange = usl m_range_of_data
ssub = usl m_subdata
scut = usl m_replace_bytes
slen = usl m_length
c_s = ucl c_str
salloc = usl m_alloc
sinit_data = usl m_init_data_encoding
more = true
for turn ulong 4096 bound 4096
if more
total = umsg buffer slen 0 0 0
if eq total 0
more = false
else
upr 40 total
found_at = umsg buffer srange newline 0 0
take = total
whole_line = false
if lt found_at total
take = found_at
whole_line = true
end
if and not whole_line ne n 0
more = false
else
piece = umsg buffer ssub 0 take 0
line = umsg c_s salloc 0 0 0
line = umsg line sinit_data piece 4 0
drop = take
if whole_line
drop = add take 1
end
upr 40 0
x = umsg buffer scut 0 drop 0
if ne line 0
uagentsay uagentline line
end
end
end
end
end
end

note the agent's run has ended in one more way (1 its output, 2 the program); when both have, the turn is over
fn uagentended what ulong to void
put g_n 47 or get g_n 47 what
if eq get g_n 47 2
s_after = usl m_perform_after
upr 64 bitcast ulong 2.0f64
x = umsg get g_o 27 s_after get g_m 38 0 0
end
if ne get g_n 47 3
ret
end
task = get g_m 26
if eq task 0
ret
end
code = and umsg task usl m_termination 0 0 0 4294967295
if ne code 0
p = uptxt 0 x_agent_stopped_a
p = upnum p code
p = uptxt p x_agent_stopped_b
put g_nm p 0
uagentsay unsb
end
center = umsg ucl c_center usl m_default_center 0 0 0
s_forget = usl m_remove_all_observer
x = umsg center s_forget get g_o 27 0 get g_m 27
x = umsg center s_forget get g_o 27 0 get g_m 37
x = umsg center s_forget get g_o 27 0 task
srel = usl m_release
x = umsg task srel 0 0 0
put g_m 26 0
put g_n 43 0
put g_n 21 1
put g_n 39 1
x = umsg ucl c_date usl m_reference_now 0 0 0
now_bits = ugr 64
if ne get g_m 36 0
x = umsg get g_m 36 srel 0 0 0
end
s_double = usl m_number_double
cnum = ucl c_number
upr 64 now_bits
put g_m 36 umsg umsg cnum s_double 0 0 0 usl m_retain 0 0 0
end

note what the agent's program tells this one: output (agentOut:), errors (agentErr:), its end (agentEnd:), and the
note menu's Stop the Agent (stopAgent:); which is the selector, about is what came with it
fn uagentevent which ulong about ulong to void
if ustatusevent which
ret
end
if eq which get g_m 64
uprobedone about
ret
end
if eq which get g_m 46
uremotestart
ret
end
if eq which get g_m 47
uremotedone about
ret
end
if eq which get g_m 48
ufetchdone about
ret
end
if eq which get g_m 41
if ne get g_m 26 0
x = umsg get g_m 26 usl m_terminate_task 0 0 0
end
ret
end
if eq which get g_m 40
uagentended 2
ret
end
if eq get g_m 26 0
ret
end
if eq about 0
if and eq which get g_m 38 eq and get g_n 47 1 0
uagentout umsg ucl c_data usl m_data 0 0 0
uagentended 1
end
ret
end
info = umsg about usl m_user_info 0 0 0
if eq info 0
ret
end
d = umsg info usl m_object_for_key uconst s_data_item 0 0
if eq d 0
ret
end
n = umsg d usl m_length 0 0 0
if eq which get g_m 38
uagentout d
if eq n 0
uagentended 1
else
x = umsg get g_m 27 usl m_read_background 0 0 0
end
ret
end
if gt n 0
said = umsg ucl c_str usl m_alloc 0 0 0
said = umsg said usl m_init_data_encoding d 4 0
if ne said 0
edge = umsg ucl c_charset usl m_newline_set 0 0 0
uagentsay umsg uns x_bang usl m_append_string umsg said usl m_trim edge 0 0 0 0
end
x = umsg get g_m 37 usl m_read_background 0 0 0
end
end

note send the typed text to the agent
fn uagentrun to void
a = get g_n 12
n = get g_n 13
if or eq n 0 gt n 255
ret
end
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
request = unsb
if eq request 0
ret
end
note the talk on show: what was there joins what was said before, then the request
if eq get g_m 25 0
told = umsg ucl c_mutable_string usl m_string 0 0 0
put g_m 25 umsg told usl m_retain 0 0 0
end
if eq get g_m 4 0
fresh_text = umsg ucl c_mutable_string usl m_string 0 0 0
put g_m 4 umsg fresh_text usl m_retain 0 0 0
end
if eq get g_n 43 1
uanswershow
uanswerview 1
ret
end
put g_nm 0 10
put g_nm 1 10
put g_nm 2 0
blank_line = unsb
sappend_text = usl m_append
if eq get g_n 39 1
x = umsg get g_m 25 sappend_text get g_m 4 0 0
x = umsg get g_m 25 sappend_text blank_line 0 0
end
x = umsg get g_m 25 sappend_text uns x_you 0 0
x = umsg get g_m 25 sappend_text request 0 0
x = umsg get g_m 25 sappend_text blank_line 0 0
put g_n 39 0
put g_n 21 0
put g_n 22 0
engine = uagentpicked
if eq engine 0
uagentsay uagentwhy
put g_n 21 1
put g_n 39 1
uanswershow
uanswerview 1
ret
end
if eq get g_n 44 0
if eq get g_n 14 0
uagentsay uns x_agent_ask
put g_n 21 1
put g_n 39 1
uanswershow
uanswerview 1
ret
end
alert = umsg umsg ucl c_alert usl m_alloc 0 0 0 usl m_init 0 0 0
x = umsg alert usl m_set_message uns x_agent_ask 0 0
x = umsg alert usl m_set_informative uns x_agent_ask_more 0 0
x = umsg alert usl m_add_button uns x_agent_yes 0 0
x = umsg alert usl m_add_button uns x_agent_no 0 0
if ne umsg alert usl m_run_modal 0 0 0 1000
ret
end
put g_n 44 1
end
x = umsg get g_m 4 usl m_set_string uns x_agent_working 0 0
uanswershow
uanswerview 1
note the words to run: the request in place of "{prompt}", Hop's standing instructions before it, or for
note Claude Code as its system prompt; a follow-up within 15 minutes carries on from Claude Code's last run
brief = uagentbrief
command = ukeyed engine k_command
sat = usl m_at
sappend = usl m_append_string
sequal = usl m_equal_string
tool = umsg command sat 0 0 0
is_claude = eq and umsg tool sequal uns x_claude 0 0 255 1
prompt = request
if not is_claude
prompt = umsg umsg umsg brief sappend blank_line 0 0 sappend uns x_request 0 0 sappend request 0 0
end
argv = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
mark = uns x_prompt_mark
cnt = umsg command usl m_count 0 0 0
for i ulong cnt bound 256
word = umsg command sat i 0 0
if uiskind word 9
x = umsg argv sadd umsg word usl m_replace mark prompt 0 0 0
end
end
if is_claude
shas = usl m_contains_object
if eq and umsg argv shas uns x_append_system 0 0 255 0
x = umsg argv sadd uns x_append_system 0 0
x = umsg argv sadd brief 0 0
end
if and ne get g_m 33 0 ne get g_m 36 0
if eq and umsg argv shas uns x_resume 0 0 255 0
x = umsg get g_m 36 usl m_double_value 0 0 0
last_bits = ugr 64
x = umsg ucl c_date usl m_reference_now 0 0 0
if lt sub bitcast f64 ugr 64 bitcast f64 last_bits 900.0f64
x = umsg argv sadd uns x_resume 0 0
x = umsg argv sadd get g_m 33 0 0
end
end
end
end
task = ushellrun argv get g_m 30
tube = umsg ucl c_pipe usl m_pipe 0 0 0
error_tube = umsg ucl c_pipe usl m_pipe 0 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_output tube 0 0
x = umsg task usl m_set_error error_tube 0 0
x = umsg task usl m_set_input quiet 0 0
sret = usl m_retain
reader = umsg tube usl m_reading 0 0 0
error_reader = umsg error_tube usl m_reading 0 0 0
if ne get g_m 27 0
x = umsg get g_m 27 usl m_release 0 0 0
x = umsg get g_m 37 usl m_release 0 0 0
x = umsg get g_m 32 usl m_release 0 0 0
end
put g_m 27 umsg reader sret 0 0 0
put g_m 37 umsg error_reader sret 0 0 0
put g_m 32 umsg umsg ucl c_mutable_data usl m_data 0 0 0 sret 0 0 0
put g_m 26 umsg task sret 0 0 0
put g_n 47 0
center = umsg ucl c_center usl m_default_center 0 0 0
s_observe = usl m_add_observer
read_done = uconst s_read_done
ended = uconst s_task_ended
upr 40 reader
x = umsg center s_observe get g_o 27 get g_m 38 read_done
upr 40 error_reader
x = umsg center s_observe get g_o 27 get g_m 39 read_done
upr 40 task
x = umsg center s_observe get g_o 27 get g_m 40 ended
put g_n 43 1
x = umsg task usl m_launch 0 0 0
x = umsg reader usl m_read_background 0 0 0
x = umsg error_reader usl m_read_background 0 0 0
end

note ---- files on other machines, as Hop finds them (Sources/Machines.swift, Sources/Model.swift searchFiles) ----
note Each machine of Hop's settings keeps its own list of files (20 pieces, built there by a command Hop sends
note when the list is missing or old); a search runs on the machine through ssh and the lines that hold every
note typed word come back, to be scored here by the rule the local files are scored by. The machines are asked
note a moment after typing pauses, all at once, by one program whose answer is read when it has ended. Enter on
note such a file brings it over (scp, into the cache folder) and opens it; a folder's path goes to the clipboard.
note an NSString of text t with every "%%" turned into a double quote and every "^^" into a backslash
fn uquoted2 t view uchar * to ulong
put g_nm 0 34
put g_nm 1 0
quote_mark = unsb
put g_nm 0 92
put g_nm 1 0
back_mark = unsb
plain = uns t
srep = usl m_replace
plain = umsg plain srep uns x_percents quote_mark 0
ret umsg plain srep uns x_carets back_mark 0
end

note the machines of the settings: their names into g_mn (63 bytes each at most), their ssh names kept; 10 at most
fn umachines config ulong to void
put g_n 54 0
put g_n 59 0
if eq get g_n 14 1
put g_n 59 1
else
n = ucs x_env_ssh
upr 0 ulong libptr g_nm 0 1024
if ne ucall 9 0
put g_n 59 1
end
end
if eq config 0
ret
end
machines = ukeyed config k_machines
if not uiskind machines 8
ret
end
sat = usl m_at
aliases = umsg ucl c_mutable_array usl m_array 0 0 0
cnt = umsg machines usl m_count 0 0 0
have = ulong 0
for i ulong cnt bound 64
if lt have 10
m = umsg machines sat i 0 0
if uiskind m 7
name = ukeyed m k_name
via = ukeyed m k_ssh
if and uiskind name 9 uiskind via 9
src = umsg name get g_o 5 0 0 0
if ne src 0
upr 0 src
n = ucall 7
if gt n 63
n = 63
end
if gt n 0
upr 0 ulong libptr g_mn mul have 64 n
upr 8 src
upr 16 n
x = ucall 8
end
put g_ml have uchar n
x = umsg aliases usl m_add_object m 0 0
have = add have 1
end
end
end
end
end
if ne get g_m 42 0
x = umsg get g_m 42 usl m_release 0 0 0
end
put g_m 42 umsg aliases usl m_retain 0 0 0
put g_n 54 have
end

note may other machines be reached: always when resident; a check reaches none but through its stand-in (HOPSSH)
note (looked up once, when the settings are read: 59 is 1 for yes)
fn uremoteok to bool
ret eq get g_n 59 1
end

note the program to reach other machines with: ssh (scp when copy is 1), or for a check its stand-in
fn uremotetool copy ulong to ulong
if eq get g_n 14 0
n = ucs x_env_ssh
if eq copy 1
n = ucs x_env_scp
end
upr 0 ulong libptr g_nm 0 1024
given = ucall 9
if ne given 0
n = ufetch given
ret ushellquote unsb
end
end
if eq copy 1
ret uns x_scp_word
end
ret uns x_ssh_word
end

note run a script through the login shell and read all it says when it has ended: done is the selector told then.
note The program (kept) and where its answer is read (kept) go to places prog and reader of g_m
fn uscriptrun script ulong done ulong prog ulong reader_at ulong to void
argv = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg argv sadd uns x_sh 0 0
x = umsg argv sadd uns x_dash_c 0 0
x = umsg argv sadd script 0 0
task = ushellrun argv 0
tube = umsg ucl c_pipe usl m_pipe 0 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_output tube 0 0
x = umsg task usl m_set_error quiet 0 0
x = umsg task usl m_set_input quiet 0 0
reader = umsg tube usl m_reading 0 0 0
sret = usl m_retain
center = umsg ucl c_center usl m_default_center 0 0 0
whole_read = uconst s_read_to_end_done
if ne get g_m prog 0
x = umsg get g_m prog usl m_terminate_task 0 0 0
x = umsg center usl m_remove_all_observer get g_o 27 whole_read get g_m reader_at
x = umsg get g_m prog usl m_release 0 0 0
x = umsg get g_m reader_at usl m_release 0 0 0
end
put g_m prog umsg task sret 0 0 0
put g_m reader_at umsg reader sret 0 0 0
s_observe = usl m_add_observer
upr 40 reader
x = umsg center s_observe get g_o 27 done whole_read
x = umsg task usl m_launch 0 0 0
x = umsg reader usl m_read_to_end 0 0 0
end

note the command that makes machine m (a settings entry) build its list of files when it has none or an old one
fn urefreshscript m ulong to ulong
sappend = usl m_append_string
sat = usl m_at
roots = ukeyed m k_roots_m
skips = ukeyed m k_skip_m
if not uiskind skips 8
skips = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg skips sadd uns x_mskip0 0 0
x = umsg skips sadd uns x_mskip1 0 0
x = umsg skips sadd uns x_mskip2 0 0
x = umsg skips sadd uns x_mskip3 0 0
x = umsg skips sadd uns x_mskip4 0 0
x = umsg skips sadd uns x_mskip5 0 0
x = umsg skips sadd uns x_mskip6 0 0
x = umsg skips sadd uns x_mskip7 0 0
x = umsg skips sadd uns x_mskip8 0 0
x = umsg skips sadd uns x_mskip9 0 0
end
prune = umsg ucl c_mutable_string usl m_string 0 0 0
smore = usl m_append
cnt = umsg skips usl m_count 0 0 0
for i ulong cnt bound 256
one_name = umsg skips sat i 0 0
if uiskind one_name 9
if gt umsg prune usl m_length 0 0 0 0
x = umsg prune smore uns x_or_flag 0 0
end
x = umsg prune smore uns x_name_flag 0 0
x = umsg prune smore ushellquote one_name 0 0
end
end
places = umsg ucl c_mutable_string usl m_string 0 0 0
if uiskind roots 8
cnt = umsg roots usl m_count 0 0 0
for i ulong cnt bound 256
one_root = umsg roots sat i 0 0
if uiskind one_root 9
if gt umsg places usl m_length 0 0 0 0
x = umsg places smore uns x_space 0 0
end
x = umsg places smore ushellquote one_root 0 0
end
end
end
build = umsg umsg umsg umsg uns x_build_a sappend places 0 0 sappend uquoted2 x_build_b 0 0 sappend prune 0 0 sappend uquoted2 x_build_c 0 0
put g_nm 0 10
put g_nm 1 0
line_end = unsb
script = umsg ucl c_mutable_string usl m_string 0 0 0

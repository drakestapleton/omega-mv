x = umsg script smore line_end 0 0
x = umsg script smore uquoted2 x_fresh_b 0 0
x = umsg script smore line_end 0 0
x = umsg script smore uquoted2 x_fresh_c 0 0
x = umsg script smore ushellquote build 0 0
x = umsg script smore uns x_fresh_d 0 0
x = umsg script smore line_end 0 0
x = umsg script smore uns x_fresh_e 0 0
ret script
end

note ask machine k to build its list of files if it has none or an old one; nothing is waited for
fn uremoterefresh k ulong to void
if or or ge k get g_n 54 eq get g_m 42 0 not uremoteok
ret
end
m = umsg get g_m 42 get g_m 16 k 0 0
via = ukeyed m k_ssh
sappend = usl m_append_string
line = umsg umsg umsg uremotetool 0 sappend uns x_ssh_options 0 0 sappend ushellquote via 0 0 sappend uns x_space 0 0
line = umsg line sappend ushellquote urefreshscript m 0 0
argv = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg argv sadd uns x_sh 0 0
x = umsg argv sadd uns x_dash_c 0 0
x = umsg argv sadd line 0 0
task = ushellrun argv 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0

col = msg c s 0 0 0
str = ns x_name
s = sl m_initid
col = msg col s str 0 0
s = sl m_setwid
pr 64 bitcast ulong 460.0f64
x = msg col s 0 0 0
s = sl m_addcol
x = msg tv s col 0 0
s = sl m_header
x = msg tv s 0 0 0
s = sl m_dataso
x = msg tv s me 0 0
s = sl m_docvie
x = msg sv s tv 0 0
s = sl m_scroll
x = msg sv s 1 0 0
x = msg cv sadd sv 0 0
put g_o 1 tv
status
s = sl m_finish

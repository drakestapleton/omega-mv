entry = umsg links sat i 0 0
local = umsg umsg entry sat 0 0 0 s_whole 0 0 0
port_key = umsg c_n_v s_number local 0 0
if not utunnelalive port_key
if eq umsg get g_m 63 s_keyed port_key 0 0 0
uprobestart local port_key
end
end
end
end

note twice a second: every 20 seconds, and half a second after the start, the forwarded ports are looked at
fn utunneltick to void
ticks = get g_n 60
put g_n 60 add ticks 1
if eq sub ticks mul div ticks 40 40 0
utunnelcheck
end
end

note this program is ending (quitting, or a check at its end): its links and its askers end with it
fn utunnelstop to void
sat = usl m_at
s_running = usl m_is_running
s_end = usl m_terminate_task
s_values = usl m_all_values
for which ulong 2
kept = get g_m 61
if eq which 1
kept = get g_m 63
end
if ne kept 0
tasks = umsg kept s_values 0 0 0
cnt = umsg tasks usl m_count 0 0 0
for i ulong cnt bound 256
task = umsg tasks sat i 0 0
if eq and umsg task s_running 0 0 0 255 1
x = umsg task s_end 0 0 0
end
end
end
end
end

note hear when this program is about to quit (appQuit:) and when a port has been asked about (probeDone:)
fn uquitwatch mine ulong to bool
ok = umethod mine m_app_quit 13 t_v
ok = and ok umethod mine m_probe_done 13 t_v
put g_m 62 usl m_app_quit
put g_m 64 usl m_probe_done
ret ok
end

note ---- screens: the list shows one kind of thing, and typing looks in it ----
note the copied things: all of them, pinned first, or the ones that have every typed word
fn uscreenclips to void
uclipmatch 1024
h = get g_n 28
for i ulong h bound 1024
put g_rk i 6
put g_hit i get g_cm i
put g_why i 0
end
put g_n 1 h
end

note the saved accounts: all of them, or the ones whose name has the typed text
fn uscreenaccounts to void
nacc = get g_n 31
a = get g_n 12
n = get g_n 13
typed_low = ulong 0
if and gt n 0 le n 255
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
typed = unsb
if ne typed 0
typed_low = umsg typed usl m_lowercase 0 0 0
end
end
slower = usl m_lowercase
scontains = usl m_contains
h = ulong 0
for i ulong nacc bound 800
keep = true
if gt n 0
keep = false
if ne typed_low 0
name_low = umsg umsg get g_m 18 get g_m 16 i 0 0 slower 0 0 0
keep = eq and umsg name_low scontains typed_low 0 0 255 1
end
end
if keep
put g_rk h 5
put g_hit h i
put g_why h 0
h = add h 1
end
end
put g_n 1 h
end

note show screen number which (0: everything again): the field is emptied and the list made anew
fn uscreen which ulong to void
put g_n 36 which
put g_nm 0 0
x = umsg get g_o 0 get g_o 8 unsb 0 0
utyped
end

note make the list anew from what is known now, keeping the first row selected
fn urefresh to void
unarrow
x = umsg get g_o 1 get g_o 7 0 0 0
put g_n 6 0
if gt get g_n 1 0
uchoose 0
end
ushowst
end

note pin or unpin (what 1) or delete (what 2) copied thing i in the history, then show the history as it is now.
note Like recording it is this program's to do only while Hop is not running
fn uclipedit i ulong what ulong to void
if ge i get g_n 24
ret
end
if and eq get g_n 14 1 uhoprunning
ret
end
shown_item = umsg get g_m 14 get g_m 16 i 0 0
if not uiskind shown_item 7
ret
end
id_text = ukeyed shown_item k_id
if not uiskind id_text 9
ret
end
items = uclipsmutable
if eq items 0
ret
end
sat = usl m_at
sequal = usl m_equal_string
cnt = umsg items usl m_count 0 0 0
found = cnt
for j ulong cnt bound 100000
if eq found cnt
e = umsg items sat j 0 0
if uiskind e 7
other_id = ukeyed e k_id
if uiskind other_id 9
if eq and umsg other_id sequal id_text 0 0 255 1
found = j
end
end
end
end
end
if eq found cnt
ret
end
e = umsg items sat found 0 0
if eq what 1
flip = ulong 1
if uclippinned e
flip = 0
end
flag = umsg ucl c_number usl m_number_bool flip 0 0
x = umsg e usl m_set_object flag uns k_pinned 0
else
image_name = ukeyed e k_image
if uiskind image_name 9
if ne and umsg image_name usl m_contains uns x_slash_text 0 0 255 1
folder = uhoppath x_clip_images
if ne folder 0
gone = umsg folder usl m_append_string image_name 0 0
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
x = umsg manager usl m_remove_item gone 0 0
end
end
end
x = umsg items usl m_remove_at found 0 0
end
if eq uclipswrite items 1
uloadclips
urefresh
end
end

note the menu's Pin or Unpin and Delete from History: on the selected row when it is a copied thing
fn uclipmenu what ulong to void
r = get g_n 6
if or ge r get g_n 1 ne ulong get g_rk r 6
ret
end
uclipedit get g_hit r what
end

note open Hop's settings file in TextEdit, as Hop does (a check: with the program macOS has for it). When there
note is no settings file yet an empty one is made, which Hop reads as all its built-in settings
fn usettings to void
path = uhoppath x_config
if eq path 0
ret
end
url = umsg ucl c_url usl m_furl path 0 0
ws = umsg ucl c_ws usl m_shws 0 0 0
if eq get g_n 14 0
put g_n 9 and umsg ws usl m_open url 0 0 255
ret
end
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
if eq and umsg manager usl m_file_exists path 0 0 255 0
d = umsg uns x_empty_settings usl m_data_using 4 0 0
x = umsg d usl m_write_file path 1 0
upr 0 umsg path get g_o 5 0 0 0
upr 8 384
x = ucall 16
end
urls = umsg ucl c_array usl m_array_with url 0 0
editor = umsg ucl c_url usl m_furl uns x_textedit 0 0
how = umsg ucl c_open_config usl m_configuration 0 0 0
s_open = usl m_open_urls_with
upr 40 0
x = umsg ws s_open urls editor how
put g_n 9 1
end

note the rows to show: a screen's own, else what is offered when nothing is typed, else what the one box's
note rules give for the text
fn unarrow to void
if eq get g_n 36 1
uscreenclips
ret
end
if eq get g_n 36 2
uscreenaccounts
ret
end
if eq get g_n 13 0
usuggest
ret
end
m = ulong 0
for k ulong get g_n 0 bound 2048
s = uscore k
if gt s 0
put g_mk m k
put g_ms m sub s 1
m = add m 1
end
end
usearch
urankrows m
end

note "H of N apps" into the status line
fn ushowst to void
p = upnum 0 get g_n 1
if eq get g_n 36 0
p = uptxt p x_of
p = upnum p get g_n 0
p = uptxt p x_apps
end
if eq get g_n 36 1
p = uptxt p x_copied_things
end
if eq get g_n 36 2
p = uptxt p x_accounts_word
end
if ne get g_m 23 0
p = uptxt p x_indexing
end
p = uremotenote p
put g_nm p 0
str = unsb
x = umsg get g_o 2 get g_o 8 str 0 0
end

note select row r of the list and bring it into view
fn uchoose r ulong to void
put g_n 6 r
ix = umsg get g_o 13 get g_o 14 r 0 0
x = umsg get g_o 1 get g_o 12 ix 0 0
x = umsg get g_o 1 get g_o 15 r 0 0
end

note what the list shows was typed into the field: read it, narrow, show
fn utyped to void
uaskstop
str = umsg get g_o 0 get g_o 6 0 0 0
p = umsg str get g_o 5 0 0 0
n = ufetch p
if gt n 255
n = 255
end
for i ulong n bound 256
put g_q i get g_nm i
end
put g_n 4 n
a = ulong 0
while lt a n bound 256
c = ulong get g_q a
if and ne c 32 ne c 9
break
end
a = add a 1
end
e = n
while gt e a bound 256
c = ulong get g_q sub e 1
if and ne c 32 ne c 9
break
end
e = sub e 1
end
put g_n 12 a
put g_n 13 sub e a
udecide
uremotesoon
unarrow
x = umsg get g_o 1 get g_o 7 0 0 0
put g_n 6 0
if gt get g_n 1 0
uchoose 0
end
ushowst
end

note open app k: its folder, "/", its name and ".app" as a file address, handed to the workspace
fn ulaunch k ulong to void
p = ulong 0
if eq ulong get g_dir k 0
p = uptxt 0 x_dir1
else
p = uptxt 0 x_dir2
end
p = uptxt p x_slash
p = upname p k
p = uptxt p x_dotapp
put g_nm p 0
str = unsb
c = ucl c_url
s = usl m_furl
url = umsg c s str 0 0
c = ucl c_ws
s = usl m_shws
ws = umsg c s 0 0 0
s = usl m_open
put g_n 9 and umsg ws s url 0 0 255
end

note open the web address the typed text stands for
fn uopenaddr to void
p = upaddr 0
put g_nm p 0
str = unsb
u = umsg get g_o 16 get g_o 17 str 0 0
c = ucl c_ws
s = usl m_shws
ws = umsg c s 0 0 0
s = usl m_open
put g_n 9 and umsg ws s u 0 0 255
end

note ---- copied things: Hop's encrypted clipboard history (Sources/Clipboard.swift), read and never written ----
note The history is one file, sealed with AES-256-GCM (the core's fn gcunlock) under a key that Hop keeps in the
note login Keychain as an item of Apple's security tool and reads through that tool; the panel reads it the same
note way. The key and the unsealed bytes are wiped from the core's buffers as soon as they are used. The panel
note only reads the history: Hop, when it runs, is the one that keeps it, and it sees what the panel puts on
note the clipboard like anything else that is copied. A check (HOPCHECK) never asks the tool and never touches
note the real clipboard: it takes the key from HOPCLIPKEY and pastes into a board of its own.
note the clipboard key into the core's c_k; 1 when it is there
fn uclipkey to ulong
encoded = ulong 0
item_name = ulong 0
if eq get g_n 14 0
n = ucs x_env_clipkey
upr 0 ulong libptr g_nm 0 1024
key_text = ucall 9
if eq key_text 0
ret 0
end
n = ufetch key_text
if and and gt n 5 eq get g_nm 0 116 and eq get g_nm 3 108 eq get g_nm 4 58
for i ulong sub n 5 bound 1024
put g_nm i get g_nm add 5 i
end
put g_nm sub n 5 0
item_name = unsb
else
encoded = unsb
end
else
item_name = uns x_clip_service
end
if ne item_name 0
task = umsg ucl c_task usl m_alloc 0 0 0
task = umsg task usl m_init 0 0 0
x = umsg task usl m_set_launch uns x_security 0 0
arguments = umsg ucl c_mutable_array usl m_array 0 0 0
sadd = usl m_add_object
x = umsg arguments sadd uns x_find 0 0
x = umsg arguments sadd uns x_dash_s 0 0
x = umsg arguments sadd item_name 0 0
x = umsg arguments sadd uns x_dash_a 0 0
x = umsg arguments sadd uns x_clip_account 0 0
x = umsg arguments sadd uns x_dash_w 0 0
x = umsg task usl m_set_arguments arguments 0 0
tube = umsg ucl c_pipe usl m_pipe 0 0 0
x = umsg task usl m_set_output tube 0 0
quiet = umsg ucl c_file_handle usl m_null_device 0 0 0
x = umsg task usl m_set_error quiet 0 0
x = umsg task usl m_launch 0 0 0
reader = umsg tube usl m_reading 0 0 0
d = umsg reader usl m_read_end 0 0 0
x = umsg task usl m_wait 0 0 0
if ne and umsg task usl m_termination 0 0 0 4294967295 0
ret 0
end
if eq d 0
ret 0
end
whole = umsg ucl c_str usl m_alloc 0 0 0
whole = umsg whole usl m_init_data_encoding d 4 0
if eq whole 0
ret 0
end
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
encoded = umsg whole usl m_trim blanks 0 0
end
if eq encoded 0
ret 0
end
kd = umsg ucl c_data usl m_alloc 0 0 0
kd = umsg kd usl m_init_base64 encoded 0 0
if eq kd 0
ret 0
end
if ne umsg kd usl m_length 0 0 0 32
ret 0
end
src = umsg kd usl m_bytes 0 0 0
upr 0 ulong libptr c_k 0 32
upr 8 src
upr 16 32
x = ucall 8
ret 1
end

note wipe the first m unsealed bytes of the core's buffer
fn uforget m ulong to void
if eq m 0
ret
end
upr 0 ulong libptr c_d 0 m
upr 8 0
upr 16 m
x = ucall 17
end

note the sealed bytes of d (an NSData: the nonce, the data, the tag) unsealed into the core's c_d with the
note clipboard key; the count of data bytes plus 1, or 0 when it cannot be done (no key, or not sealed by it)
fn uunseal d ulong to ulong
n = umsg d usl m_length 0 0 0
if or lt n 28 gt n 16777244
ret 0
end
src = umsg d usl m_bytes 0 0 0
if eq uclipkey 0
ret 0
end
m = sub n 28
upr 0 ulong libptr c_n 0 12
upr 8 src
upr 16 12
x = ucall 8
if gt m 0
upr 0 ulong libptr c_d 0 m
upr 8 add src 12
upr 16 m
x = ucall 8
end
upr 0 ulong libptr c_tg 0 16
upr 8 add src sub n 16
upr 16 16
x = ucall 8
good = gcunlock m
gcwipe
if eq good 0
ret 0
end
ret add m 1
end

note the text a copied thing is shown by: its text without the blanks around it, a mark where a line ends, the
note first 80 characters; "Image" for a picture
fn uclippreview item ulong to ulong
if not uiskind item 7
ret uns x_image
end
words = ukeyed item k_text
if not uiskind words 9
ret uns x_image
end
blanks = umsg ucl c_charset usl m_whitespace 0 0 0
t = umsg words usl m_trim blanks 0 0
put g_nm 0 10
put g_nm 1 0
line_end = unsb
put g_nm 0 32
put g_nm 1 226
put g_nm 2 143
put g_nm 3 142
put g_nm 4 32
put g_nm 5 0
mark = unsb
t = umsg t usl m_replace line_end mark 0
if gt umsg t usl m_length 0 0 0 80
cut = umsg t usl m_composed_at 80 0 0
t = umsg t usl m_substring_to cut 0 0
end
ret t
end

note read the history: the copied things, the text each is shown by, which are pinned, and the order they are
note searched in. Nothing is kept when the file is not there, the key is not to be had or the file is not Hop's
fn uloadclips to void
put g_n 24 0
d = uhopfile x_clipboard_file
if eq d 0
ret
end
r = uunseal d
if le r 1
ret
end
m = sub r 1
plain = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
items = umsg ucl c_json usl m_json_object plain 0 0
if not uiskind items 8
ret
end
cnt = umsg items usl m_count 0 0 0
if gt cnt 1024
cnt = 1024
end
sret = usl m_retain
srel = usl m_release
if ne get g_m 14 0
x = umsg get g_m 14 srel 0 0 0
x = umsg get g_m 15 srel 0 0 0
end
put g_m 14 umsg items sret 0 0 0
shown_by = umsg ucl c_mutable_array usl m_array 0 0 0
put g_m 15 umsg shown_by sret 0 0 0
sat = usl m_at
put g_m 16 sat
sadd = usl m_add_object
for i ulong cnt bound 1024
item = umsg items sat i 0 0
pv = uclippreview item
x = umsg shown_by sadd pv 0 0
put g_cp i 0
if uiskind item 7
pin = ukeyed item k_pinned
if uisnumber pin
if eq and umsg pin usl m_bool_value 0 0 0 255 1
put g_cp i 1
end
end
end
end
pos = ulong 0
for i ulong cnt bound 1024
if eq ulong get g_cp i 1
put g_ci pos i
pos = add pos 1
end
end
for i ulong cnt bound 1024
if eq ulong get g_cp i 0
put g_ci pos i
pos = add pos 1
end
end
put g_n 24 cnt
end

note the text copied thing i is shown by into g_nm from byte p; the byte after it
fn uclipname p ulong i ulong to ulong
if or ge i get g_n 24 ge p 900
ret p
end
pv = umsg get g_m 15 get g_m 16 i 0 0
src = umsg pv get g_o 5 0 0 0
if eq src 0
ret p
end
upr 0 src
n = ucall 7
if gt add p n 900
n = sub 900 p
end
if eq n 0
ret p
end
upr 0 ulong libptr g_nm p n
upr 8 src
upr 16 n
x = ucall 8
ret add p n
end

note the newest copied thing's text takes the place of the typed text (on 1) so that the address helpers work on
note it, and gives it back (on 0). Only used while nothing is typed
fn uclipaddr on ulong to void
if eq on 1
n = get g_n 25
for i ulong n bound 256
put g_q i get g_ca i
end
put g_n 12 0
put g_n 13 n
put g_n 10 get g_n 26
else
put g_n 13 0
put g_n 10 0
end
end

note the copied things that match the typed text, as Hop's search does: the pinned ones first, each in lower
note case has to contain every typed word (a picture counts as "image"); the first "most" of them into g_cm
note (for a whole screen with nothing typed: all of them)
fn uclipmatch most ulong to void
put g_n 28 0
cnt = get g_n 24
if eq cnt 0
ret
end
a = get g_n 12
n = get g_n 13
if and eq n 0 gt most 8
every = cnt
if gt every most
every = most
end
for pos ulong every bound 1024
put g_cm pos get g_ci pos
end
put g_n 28 every
ret
end
if or eq n 0 gt n 255
ret
end
for i ulong n bound 256
put g_nm i get g_q add a i
end
put g_nm n 0
typed = unsb
if eq typed 0
ret
end
slower = usl m_lowercase
typed_low = umsg typed slower 0 0 0
parts = umsg typed_low usl m_components uns x_space 0 0
nt = umsg parts usl m_count 0 0 0
scontains = usl m_contains
slen = usl m_length
sat = get g_m 16
image_low = uns x_image_low
found = ulong 0
for pos ulong cnt bound 1024
if lt found most
i = get g_ci pos
item = umsg get g_m 14 sat i 0 0
hay = image_low
if uiskind item 7
words = ukeyed item k_text
if uiskind words 9
hay = umsg words slower 0 0 0
end
end
okay = true
for j ulong nt bound 64
term = umsg parts sat j 0 0
if gt umsg term slen 0 0 0 0
if ne and umsg hay scontains term 0 0 255 1
okay = false
end
end
end
if okay
put g_cm found i
found = add found 1
end
end
end
put g_n 28 found
end

note put copied thing i on the clipboard: its text, or its picture unsealed (as PNG data). A check uses a board
note of its own
fn upasteclip i ulong to void
if ge i get g_n 24
ret
end
item = umsg get g_m 14 get g_m 16 i 0 0
if not uiskind item 7
ret
end
pboard = ulong 0
if eq get g_n 14 1
pboard = umsg ucl c_pasteboard usl m_general_pasteboard 0 0 0
else
pboard = umsg ucl c_pasteboard usl m_board_named uns x_check_board 0 0
end
x = umsg pboard usl m_clear 0 0 0
words = ukeyed item k_text
if uiskind words 9
x = umsg pboard usl m_set_string_type words uns x_type_string 0
put g_n 29 1
ret
end
name = ukeyed item k_image
if not uiskind name 9
ret
end
if eq and umsg name usl m_contains uns x_slash_text 0 0 255 1
ret
end
folder = uhoppath x_clip_images
if eq folder 0
ret
end
path = umsg folder usl m_append_string name 0 0
d = umsg ucl c_data usl m_data_file path 0 0
if eq d 0
ret
end
r = uunseal d
if le r 1
ret
end
m = sub r 1
picture = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
x = umsg pboard usl m_set_data_type picture uns x_type_png 0
put g_n 29 2
end

note press Command V for the app that is in front again, as Hop does after it has put something on the clipboard
fn usendpaste to void
for half ulong 2
upr 0 0
upr 8 9
upr 16 sub 1 half
ev = ucall 19
if ne ev 0
upr 0 ev
upr 8 1048576
x = ucall 20
upr 0 0
upr 8 ev
x = ucall 21
upr 0 ev
x = ucall 22
end
end
end

note a moment from now, press Command V; only when this program is allowed to control the Mac (Accessibility)
fn ulaterpaste to void
if eq and ucall 18 255 0
ret
end
s_after = usl m_perform_after
s_paste = usl m_paste_now
upr 64 bitcast ulong 0.15f64
x = umsg get g_o 27 s_after s_paste 0 0
end

note ---- recording what is copied, as Hop does (Sources/Clipboard.swift, poll) ----
note Only while Hop itself is not running: two programs must not write the same history. The history is read
note again at that moment, changed and written whole, sealed under the same key with a fresh nonce (the core's fn
note gclock), for the owner only. Before this program's first change in a run the history as it was is set
note aside next to it (clipboard.before-hop-omega.bin). What is marked concealed or transient is never kept.
note seal the first m bytes of the core's c_d under the clipboard key; nonce, data and tag as NSData, or 0
fn useal m ulong to ulong
if or eq m 0 gt m 16777216
ret 0
end
if eq uclipkey 0
ret 0
end
upr 0 ulong libptr c_n 0 12
upr 8 12
x = ucall 27
gclock m
gcwipe
sealed = umsg ucl c_mutable_data usl m_data 0 0 0
sappend = usl m_append_bytes
x = umsg sealed sappend ulong libptr c_n 0 12 12 0
x = umsg sealed sappend ulong libptr c_d 0 m m 0
x = umsg sealed sappend ulong libptr c_tg 0 16 16 0
ret sealed
end

note the history as it is on disk now, as a list that can be changed: an empty one when there is no file yet,
note 0 when there is no key or the file is not Hop's
fn uclipsmutable to ulong
path = uhoppath x_clipboard_file
if eq path 0
ret 0
end
manager = umsg ucl c_file_manager usl m_default_manager 0 0 0
if eq and umsg manager usl m_file_exists path 0 0 255 0
if eq uclipkey 0
ret 0
end
gcwipe
ret umsg ucl c_mutable_array usl m_array 0 0 0
end
d = umsg ucl c_data usl m_data_file path 0 0
if eq d 0
ret 0
end
r = uunseal d
if le r 1
ret 0
end
m = sub r 1
plain = umsg ucl c_data usl m_data_bytes ulong libptr c_d 0 m m 0
uforget m
items = umsg ucl c_json usl m_json_object plain 1 0
if not uiskind items 8
ret 0
end
ret items
end

note write the list as the history; 1 when it was written
fn uclipswrite items ulong to ulong
data = umsg ucl c_json usl m_json_data items 0 0
if eq data 0
ret 0
end
n = umsg data usl m_length 0 0 0
if or eq n 0 gt n 16777216
ret 0
end
s_write = usl m_write_file
if eq get g_n 33 0
before = uhopfile x_clipboard_file
if ne before 0
aside = uhoppath x_clip_backup
x = umsg before s_write aside 1 0
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
end
put g_n 33 1
end
src = umsg data usl m_bytes 0 0 0
upr 0 ulong libptr c_d 0 n
upr 8 src
upr 16 n
x = ucall 8
sealed = useal n
uforget n
if eq sealed 0
ret 0
end
path = uhoppath x_clipboard_file
if eq path 0
ret 0
end
ok = and umsg sealed s_write path 1 0 255
path = uhoppath x_clipboard_file
upr 0 ulong libptr g_nm 0 1024
upr 8 384
x = ucall 16
ret ok
end

note is the copied thing e pinned
fn uclippinned e ulong to bool
if not uiskind e 7
ret false
end
pin = ukeyed e k_pinned

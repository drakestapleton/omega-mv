svis = sl m_visibl
vis = and msg w svis 0 0 0 255
mode = ns x_mode
cd = cl c_date
sd = sl m_since
sn = sl m_next
se = sl m_send
schanged = sl m_change
total = get g_n 0
if not chk
note a person uses it: until Enter opens an app or the window is closed
live = true
while live bound 999999
pr 64 bitcast ulong 0.25f64
d = msg cd sd 0 0 0
tick app sn se mode d
if or ne get g_n 5 0 ne and msg w svis 0 0 0 255 1
live = false
end
end
s = sl m_close
x = msg w s 0 0 0
ret 0
end
note the check: about six seconds; the program types, presses arrow down, calls its own action and presses Escape
scmd = sl m_cmd
esc = ulong 0
for i ulong 120
pr 64 bitcast ulong 0.05f64
d = msg cd sd 0 0 0
tick app sn se mode d
if eq i 10
str = ns x_typed
x = msg fld get g_o 8 str 0 0
x = msg me schanged 0 0 0
end
if eq i 15
x = msg me scmd fld 0 get g_o 9
end
if eq i 20
x = msg me sgo 0 0 0
end
if eq i 25
x = msg me scmd fld 0 get g_o 11
esc = get g_n 5
put g_n 5 0
end
end
note the first row, asked of the list's own data source through Objective-C, and the list's own selection
shown = get g_n 1
row = msg tv sl m_selrd 0 0 0
want = ulong 0
if gt shown 1
want = 1
end
first = msg me sl m_value tv col 0
flen = ulong 0
if ne first 0
p = msg first get g_o 5 0 0 0
flen = fetch p
end
for i ulong flen bound 1000
put g_q i get g_nm i
end
p = ptxt 0 x_out1
p = pnum p total
p = ptxt p x_out2
p = pnum p shown
p = ptxt p x_out3
for i ulong flen bound 200
put g_nm add p i get g_q i
end
p = add p flen
p = ptxt p x_out4
p = pnum p and row 255
put g_nm p 10
pr 0 1
pr 8 ulong libptr g_nm 0 1024
pr 16 add p 1
x = call 3
s = sl m_close
x = msg w s 0 0 0
if ne vis 1
ret 8
end
if and and and gt shown 0 lt shown total and gt flen 0 and eq get g_n 3 1 eq get g_n 5 0 and eq esc 1 eq row want
ret 1
end
ret 9
end

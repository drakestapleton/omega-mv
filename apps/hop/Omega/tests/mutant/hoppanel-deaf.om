x = umsg task usl m_set_error quiet 0 0
x = umsg task usl m_set_input quiet 0 0
x = umsg task usl m_launch 0 0 0
end

note a moment after typing pauses the machines are asked; until then nothing found there is shown
fn uremotesoon to void
put g_n 49 0
put g_n 58 0
if le get g_n 51 2
put g_n 51 0
end
if eq get g_n 54 0
ret
end
if not uremoteok
ret
end
s_go = get g_m 46
x = umsg ucl c_obj usl m_cancel_previous get g_o 27 s_go 0
if or or lt get g_n 13 2 gt get g_n 13 255 ne get g_n 36 0
ret
end
s_after = usl m_perform_after
upr 64 bitcast ulong 0.22f64
x = umsg get g_o 27 s_after s_go 0 0
end

note ask every machine for the files that hold every typed word (the longest first, as on the machine's side
note each further word narrows what the first found)
fn uremotestart to void
a = get g_n 12
n = get g_n 13
if or or lt n 2 gt n 255 eq get g_n 54 0
ret
end
for i ulong n bound 256
put g_rq i get g_q add a i
put g_nm i get g_q add a i
end
put g_n 53 n
put g_nm n 0
typed = unsb
if eq typed 0
ret
end
parts = umsg umsg typed usl m_lowercase 0 0 0 usl m_components uns x_space 0 0
sat = usl m_at
slen = usl m_length
cnt = umsg parts usl m_count 0 0 0
longest = ulong 0
longest_len = ulong 0
for i ulong cnt bound 64
one_word = umsg parts sat i 0 0
wl = umsg one_word slen 0 0 0
if ge wl longest_len
if gt wl 0
longest = one_word
longest_len = wl
end
end
end
if eq longest 0
ret
end
sappend = usl m_append_string
filter = umsg umsg uns x_remote_grep sappend ushellquote longest 0 0 sappend uquoted2 x_remote_shard 0 0
for i ulong cnt bound 64
one_word = umsg parts sat i 0 0
if and gt umsg one_word slen 0 0 0 0 eq and umsg one_word usl m_equal_string longest 0 0 255 0
filter = umsg umsg umsg filter sappend uns x_remote_pipe 0 0 sappend uns x_remote_grep 0 0 sappend ushellquote one_word 0 0
end
end
remote = umsg umsg uns x_remote_a sappend filter 0 0 sappend uquoted2 x_remote_b 0 0
remote_quoted = ushellquote remote
tool = uremotetool 0
put g_nm 0 10
put g_nm 1 0
line_end = unsb
script = umsg ucl c_mutable_string usl m_string 0 0 0
smore = usl m_append
for k ulong get g_n 54 bound 10
m = umsg get g_m 42 sat k 0 0
via = ukeyed m k_ssh
x = umsg script smore uns x_local_a 0 0
x = umsg script smore tool 0 0
x = umsg script smore uns x_ssh_options 0 0
x = umsg script smore ushellquote via 0 0
x = umsg script smore uns x_space 0 0
x = umsg script smore remote_quoted 0 0
x = umsg script smore uns x_local_b 0 0
put g_nm 0 uchar add 48 k
put g_nm 1 0
x = umsg script smore unsb 0 0
x = umsg script smore uns x_local_c 0 0
x = umsg script smore line_end 0 0
end
x = umsg script smore uns x_wait_word 0 0
uscriptrun script get g_m 47 43 44
end

note keep a file found on a machine among the best 64, best first
fn uremotekeep sc ulong o ulong ln ulong k ulong to void
have = get g_n 49
if and ge have 64 le sc get g_rs 63
ret
end
pos = have
if ge have 64
pos = 63
else
put g_n 49 add have 1
end
while gt pos 0 bound 80
if ge get g_rs sub pos 1 sc
break
end
put g_rs pos get g_rs sub pos 1
put g_ro pos get g_ro sub pos 1
put g_rl pos get g_rl sub pos 1
put g_rw pos get g_rw sub pos 1
pos = sub pos 1
end
put g_rs pos sc
put g_ro pos o
put g_rl pos ln
put g_rw pos uchar k
end

note does the line at o of g_rb (n bytes) read exactly as text t
fn uremoteis o ulong n ulong t view uchar * to bool
tl = len t
if ne n tl
ret false
end
for i ulong tl bound 64
if ne ulong get g_rb add o i ulong get t i
ret false
end
end
ret true
end

note the machines have answered (about: the notice that carries what they said). When the typed text is still
note the one they were asked for, every line is scored and the list is made anew
fn uremotedone about ulong to void
if eq about 0
ret
end
info = umsg about usl m_user_info 0 0 0
if eq info 0
ret
end
d = umsg info usl m_object_for_key uconst s_data_item 0 0
if eq d 0
ret
end
a = get g_n 12
n = get g_n 13
if ne n get g_n 53
ret
end
for i ulong n bound 256
if ne ulong get g_q add a i ulong get g_rq i
ret
end
end
total = umsg d usl m_length 0 0 0
if gt total 1048575
total = 1048575
end
put g_n 49 0
put g_n 58 0
put g_n 50 total
if eq total 0
ret
end
src = umsg d usl m_bytes 0 0 0
base = ulong libptr g_rb 0 total
upr 0 base
upr 8 src
upr 16 total
x = ucall 8
pos = ulong 0
more = true
for turn ulong 20000 bound 20000
if more
if ge pos total
more = false
else
upr 0 add base pos
upr 8 10
upr 16 sub total pos
x = ucall 12
e = total
hit_at = ugr 0
if ne hit_at 0
e = sub hit_at base
end
ln = sub e pos
if and ge ln 3 eq ulong get g_rb add pos 1 58
k = sub ulong get g_rb pos 48
if lt k get g_n 54
o = add pos 2
bl = sub ln 2
if uremoteis o bl x_no_index
put g_n 51 2
put g_n 52 k
uremoterefresh k
else
if uremoteis o bl x_unreachable
put g_n 51 1
put g_n 52 k
else
pl = bl
if eq ulong get g_rb sub add o bl 1 47
pl = sub bl 1
end
if and gt pl 0 le pl 4000
for j ulong pl bound 4096
put g_line j uchar ulower ulong get g_rb add o j
end
sc = ufscore pl
if ne sc 0
uremotekeep sc o bl k
name_at = pl
while gt name_at 0 bound 4097
if eq ulong get g_line sub name_at 1 47
break
end
name_at = sub name_at 1
end
if eq sub pl name_at n
same_name = true
for j ulong n bound 256
if ne ulong get g_line add name_at j ulower ulong get g_rq j
same_name = false
end
end
if same_name
put g_n 58 1
end
end
end
end
end
end
end
end
pos = add e 1
end
end
end
keep_row = get g_n 6
unarrow
x = umsg get g_o 1 get g_o 7 0 0 0
if lt keep_row get g_n 1
uchoose keep_row
else
if gt get g_n 1 0
uchoose 0
end
end
ushowst
end

note the text of a row for a file on another machine into g_nm from byte p: its name, the folder it is in,
note and the machine; the byte after it
fn uremoterow p ulong r ulong to ulong
if ge r get g_n 49
ret p
end
o = get g_ro r
ln = get g_rl r
if gt ln 0
if eq ulong get g_rb sub add o ln 1 47
ln = sub ln 1
end
end
ns0 = ln
while gt ns0 0 bound 4097
if eq ulong get g_rb sub add o ns0 1 47
break
end
ns0 = sub ns0 1
end
q = p
nl = sub ln ns0
if gt nl 300
nl = 300
end
for j ulong nl bound 301
put g_nm add q j get g_rb add add o ns0 j
end
q = add q nl
if and gt ns0 1 le ns0 400
q = uptxt q x_gap
for j ulong sub ns0 1 bound 401
put g_nm add q j get g_rb add o j
end
q = add q sub ns0 1
end
k = ulong get g_rw r
q = uptxt q x_on
ml = ulong get g_ml k
for j ulong ml bound 64
put g_nm add q j get g_mn add mul k 64 j
end
ret add q ml
end

note the path of found file r, as it is written on its machine, as an NSString (without a folder's last "/")

text x_remote_a "d=~/.cache/hop/shards; [ -f $d/s00 ] || { echo HOP-NO-INDEX; exit 0; }; t=$(mktemp -d /dev/shm/hop.XXXXXX 2>/dev/null || mktemp -d); for s in $d/s*; do ( "
text x_remote_grep "LC_ALL=C grep -F -i -- "
text x_remote_shard " %%$s%%"
text x_remote_pipe " | "
text x_remote_b " | head -300 > %%$t/${s##*/}%% ) & done; wait; cat %%$t%%/*; rm -rf %%$t%%"
text x_local_a "( "
text x_local_b "; [ $? = 255 ] && echo HOP-UNREACHABLE ) 2>/dev/null | sed 's/^/"
text x_local_c ":/' &"
text x_wait_word "wait"
text x_build_a "cd ~/.cache/hop && find "
text x_build_b " -xdev ^^( -path '*/.*' -o "
text x_build_c " ^^) -prune -o -type d -printf '%p/^^n' -o -printf '%p^^n' > index.tmp 2>/dev/null && rm -rf shards.new && mkdir shards.new && split -n l/20 -d -a 2 index.tmp shards.new/s && rm -f index.tmp index.txt && rm -rf shards.old && { [ ! -d shards ] || mv shards shards.old; } && mv shards.new shards && rm -rf shards.old; rm -f index.tmp; rmdir ~/.cache/hop/building"
text x_name_flag "-name "
text x_or_flag " -o "
text x_fresh_a "mkdir -p ~/.cache/hop; f=~/.cache/hop/shards/s00"
text x_fresh_b "if [ -d ~/.cache/hop/building ] && [ -n %%$(find ~/.cache/hop/building -maxdepth 0 -mmin +180 2>/dev/null)%% ]; then rmdir ~/.cache/hop/building; fi"
text x_fresh_c "if [ ! -f $f ] || [ -n %%$(find $f -mmin +30 2>/dev/null)%% ]; then if mkdir ~/.cache/hop/building 2>/dev/null; then nohup nice -n 19 ionice -c3 sh -c "
text x_fresh_d " >/dev/null 2>&1 & fi; fi"
text x_fresh_e "echo ok"
text x_percents "%%"
text x_carets "^^"
text x_fetch_a "sz=$("
text x_fetch_stat "stat -c %s -- "
text x_fetch_b ") && [ %%$sz%% -le 2000000000 ] && mkdir -p "

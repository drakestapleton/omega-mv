note what to say about a machine into g_nm from byte p; the byte after it
fn uremotenote p ulong to ulong
w = get g_n 51
k = get g_n 52
if or eq w 0 ge k get g_n 54
ret p
end
q = uptxt p x_gap
if eq w 3
q = uptxt q x_note_bringing
end
if eq w 4
q = uptxt q x_note_copied
end
if eq w 5
q = uptxt q x_note_failed
end
ml = ulong get g_ml k
for j ulong ml bound 64
put g_nm add q j get g_mn add mul k 64 j
end
q = add q ml
if eq w 1
q = uptxt q x_note_unreachable
end
if eq w 2
q = uptxt q x_note_building
end
ret q
end


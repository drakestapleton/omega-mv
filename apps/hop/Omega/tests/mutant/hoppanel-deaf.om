s = sl m_setfra
rect 16.0f64 8.0f64 488.0f64 20.0f64
x = msg lbl s 0 0 0
x = msg cv sadd lbl 0 0
put g_o 2 lbl
note the list
c = cl c_scroll
s = sl m_alloc
sv = msg c s 0 0 0
rect 16.0f64 36.0f64 488.0f64 272.0f64
sv = msg sv sframe 0 0 0
c = cl c_table

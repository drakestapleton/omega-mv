note g_f: library functions. 0 objc_getClass 1 sel_registerName 2 objc_msgSend 3 write 4 objc_allocateClassPair
note 5 class_addMethod 6 objc_registerClassPair 7 strlen 8 memcpy 9 getenv
global g_f ulong 16
note g_o: objects and selectors the callbacks need. 0 field 1 table 2 status line 3 NSString 4 stringWithUTF8String:
note 5 UTF8String 6 stringValue 7 reloadData 8 setStringValue: 9 moveDown: 10 moveUp: 11 cancelOperation:
note 12 selectRowIndexes:byExtendingSelection: 13 NSIndexSet 14 indexSetWithIndex: 15 scrollRowToVisible:
global g_o ulong 16
note g_n: 0 apps 1 shown 2 bytes of names 3 times the action ran 4 length of the typed text 5 1 to end the program
note 6 the selected row
global g_n ulong 8
global g_rg uchar 128
global g_nm uchar 1024
global g_pool uchar 65536
global g_off ulong 2048
global g_ln ulong 2048
global g_hit ulong 2048
note g_sc: the score of each shown app; g_dir: the folder each app is in (0 /Applications, 1 /System/Applications)
global g_sc ulong 2048
global g_dir uchar 2048
global g_q uchar 256

note ---- hopfuzz, from Omega/hopcore.om ----
fn isword w ulong to bool
ret ne and w 4294967296 0
end

fn istrim w ulong to bool
ret ne and w 8589934592 0
end

fn minu a ulong b ulong to ulong
if lt a b
ret a
end
ret b
end

note true when inp[a .. a+n) equals inp[b .. b+n); both runs must lie inside the buffer
fn same inp view ulong 256 a ulong b ulong n ulong to bool
for k ulong n
if ne get inp add a k get inp add b k
ret false
end
end
ret true
end

note x is one longer than y (ls characters): true when dropping one character of x gives y
fn skip1 inp view ulong 256 x ulong y ulong ls ulong to bool
k = ulong 0
while lt k ls bound 256
if ne get inp add x k get inp add y k
break
end
k = add k 1
end
ret same inp add x add k 1 add y k sub ls k
end

note edit distance at most 1, where swapping two neighbours counts as one
fn near inp view ulong 256 a ulong la ulong b ulong lb ulong to bool
if eq la lb
d = ulong 0
p = ulong 0
for k ulong la
if ne get inp add a k get inp add b k
if eq d 0
p = k
end
d = add d 1
end
end
if le d 1
ret true
end
if eq d 2
if lt add p 1 la
if eq get inp add a p get inp add b add p 1
if eq get inp add a add p 1 get inp add b p
ret true
end
end
end
end
ret false
end
if eq la add lb 1
ret skip1 inp a b lb
end
if eq lb add la 1
ret skip1 inp b a la
end
ret false
end

note score of q = inp[qa .. qa+ql) in the name inp[72 .. 72+nl); 0 means no match. ql and nl >= 1
fn one inp view ulong 256 qa ulong ql ulong nl ulong to ulong
if le ql nl
if same inp qa 72 ql
if eq ql nl
ret 200
end
ret sub 160 minu 30 sub nl ql
end
end
qw = true
for k ulong ql
if not isword get inp add qa k
qw = false
end
end
wc = ulong 0
later = false
inits = true
inw = false
for i ulong nl
c = get inp add 72 i
if isword c
if not inw
if lt wc ql
if ne c get inp add qa wc
inits = false
end
end
if gt wc 0
if qw
if le add i ql nl
if same inp qa add 72 i ql
later = true
end
end
end
end
wc = add wc 1
end
inw = true
else
inw = false
end
end
if later
ret sub 120 minu 20 div nl 3
end
if ge ql 2
if gt wc 1
if ge wc ql
if inits
ret 110
end
end
end
end
if le ql nl
for i ulong add sub nl ql 1
if same inp qa add 72 i ql
ret sub 80 minu 20 div nl 3
end
end
end
if ge ql 4
if le ql nl
if near inp qa ql 72 ql
ret 70
end
end
if le sub ql 1 nl
if near inp qa ql 72 sub ql 1
ret 70
end
end
if le add ql 1 nl
if near inp qa ql 72 add ql 1
ret 70
end
end
end
if lt ql 3
ret 0
end
qi = ulong 0
gaps = ulong 0
last = ulong 0
first = ulong 0
for i ulong nl
if lt qi ql
if eq get inp add 72 i get inp add qa qi
if gt qi 0
gaps = add gaps sub sub i last 1
else
first = i
end
last = i
qi = add qi 1
end
end
end
if ne qi ql
ret 0
end
if gt gaps ql
ret 0
end
t = add mul gaps 6 mul first 3
if ge t 45
ret 15
end
ret sub 60 t
end

note first faulting word plus 1, or 0 when the input is well formed
fn check inp view ulong 256 to ulong
if ne get inp 0 1212568922
ret 1
end
if ne get inp 1 1
ret 2
end
ql = get inp 2
nl = get inp 3
if gt ql 64
ret 3
end
if gt nl 184
ret 4
end
for i ulong 4
if ne get inp add 4 i 0
ret add 5 i
end
end
for i ulong 64
w = get inp add 8 i
if lt i ql
if ge w 17179869184
ret add 9 i
end
if eq and w 4294967295 0
ret add 9 i
end
else
if ne w 0
ret add 9 i
end
end
end
for i ulong 184
w = get inp add 72 i
if lt i nl
if ge w 17179869184
ret add 73 i
end
if eq and w 4294967295 0
ret add 73 i
end
else
if ne w 0
ret add 73 i
end
end
end
ret 0
end

fn hopfuzz inp view ulong 256 res edit ulong 256 to ulong
for i ulong 256
put res i 0
end
put res 0 1212568922
put res 1 1
e = check inp
if ne e 0
put res 2 2
put res 4 sub e 1
ret 2
end
nl = get inp 3
qa = ulong 8
qe = add 8 get inp 2
while lt qa qe bound 256
if not istrim get inp qa
break
end
qa = add qa 1
end
while gt qe qa bound 256
if not istrim get inp sub qe 1
break
end
qe = sub qe 1
end
ql = sub qe qa
if eq ql 0
ret 0
end
if eq nl 0
ret 0
end
s = one inp qa ql nl
if eq s 0
terms = ulong 0
sum = ulong 0
p = qa
while lt p qe bound 256
if eq and get inp p 4294967295 32
p = add p 1
continue
end
b = p
while lt p qe bound 256
if eq and get inp p 4294967295 32
break
end
p = add p 1
end
ts = one inp b sub p b nl
if eq ts 0
ret 0
end
terms = add terms 1
sum = add sum ts
end
if le terms 1
ret 0
end
s = sub div sum terms 10
end
put res 2 1
put res 3 s
ret 1
end

note ---- end of hopfuzz ----

fn pr o ulong v ulong to void
for i ulong 8
put g_rg add o i uchar and shr v mul i 8 255
end
end

fn gr o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get g_rg add o i mul i 8
end
ret v
end

note the text into g_nm with a zero byte after it; its length
fn cs t view uchar * to ulong
n = len t
for i ulong n
put g_nm i get t i
end
put g_nm n 0
ret n
end

note library function k of g_f on the register file; x0 as it came back (an object may have its top bit set)
fn call k ulong to ulong
lr = libcall get g_f k g_rg 0 128
ret gr 0
end

fn sym t view uchar * to ulong
n = cs t
pr 0 18446744073709551614
pr 8 ulong libptr g_nm 0 1024
lr = libcall ulong libfn 1 g_rg 0 128
ret gr 0
end

fn cl t view uchar * to ulong
n = cs t
pr 0 ulong libptr g_nm 0 1024
ret call 0
end

fn sl t view uchar * to ulong
n = cs t
pr 0 ulong libptr g_nm 0 1024
ret call 1
end

note [obj s a b c]
fn msg obj ulong s ulong a ulong b ulong c ulong to ulong
pr 0 obj
pr 8 s
pr 16 a
pr 24 b
pr 32 c
ret call 2
end

note an NSString of the zero-ended bytes in g_nm
fn nsb to ulong
ret msg get g_o 3 get g_o 4 ulong libptr g_nm 0 1024 0 0
end

fn ns t view uchar * to ulong
n = cs t
ret nsb
end

note a rectangle for the next message, in d0..d3
fn rect x f64 y f64 w f64 h f64 to void
pr 64 bitcast ulong x
pr 72 bitcast ulong y
pr 80 bitcast ulong w
pr 88 bitcast ulong h
end

fn lower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note the zero-ended bytes at address p into g_nm (at most 1000); their count
fn fetch p ulong to ulong
pr 0 p
n = call 7
if gt n 1000
n = 1000
end
pr 0 ulong libptr g_nm 0 1024
pr 8 p
pr 16 n
x = call 8
put g_nm n 0
ret n
end

note the names in one folder that end in ".app", without that ending, into the pool
fn folder t view uchar * dn ulong to void
c = cl c_fm
s = sl m_defaul
mgr = msg c s 0 0 0
s = sl m_conte1
path = ns t
arr = msg mgr s path 0 0
if eq arr 0
ret
end
s = sl m_count
cnt = msg arr s 0 0 0
sat = sl m_at
for i ulong cnt bound 4096
item = msg arr sat i 0 0
p = msg item get g_o 5 0 0 0
n = fetch p
k = get g_n 0
used = get g_n 2
if and and gt n 4 lt k 2048 lt add used n 65536
if and and eq get g_nm sub n 4 46 eq get g_nm sub n 3 97 and eq get g_nm sub n 2 112 eq get g_nm sub n 1 112
m = sub n 4
for j ulong m bound 1000
put g_pool add used j get g_nm j
end
put g_off k used
put g_ln k m
put g_dir k uchar dn
put g_n 0 add k 1
put g_n 2 add used m
end
end
end
end

note the word hopfuzz reads for one byte: its lower-case value, bit 32 for a letter or digit (and for every byte of
note a longer character), bit 33 for a space or tab
fn fword c ulong to ulong
l = lower c
w = l
if or or and ge l 97 le l 122 and ge l 48 le l 57 ge l 128
w = or w 4294967296
end
if or eq l 32 eq l 9
w = or w 8589934592
end
ret w
end

note how well app k matches the typed text: hopfuzz's score plus 1, or 0 for no match (and for a text over 64 bytes
note or a name over 184, which hopfuzz refuses)
fn score k ulong to ulong
inp = new ulong 256 0
res = new ulong 256 0
ql = get g_n 4
nl = get g_ln k
o = get g_off k
if or gt ql 64 or gt nl 184 eq nl 0
ret 0
end
put inp 0 1212568922
put inp 1 1
put inp 2 ql
put inp 3 nl
for i ulong ql bound 64
put inp add 8 i fword ulong get g_q i
end
for i ulong nl bound 184
put inp add 72 i fword ulong get g_pool add o i
end
v = hopfuzz inp res
if ne v 1
ret 0
end
ret 0
end

note the apps to show: all of them when nothing is typed, else the ones hopfuzz matches, best first (equal scores
note stay in the order the folders gave)
fn narrow to void
h = ulong 0
ql = get g_n 4
for k ulong get g_n 0 bound 2048
s = ulong 1
if gt ql 0
s = score k
end
if gt s 0
pos = h
while gt pos 0 bound 4096
if ge get g_sc sub pos 1 s
break
end
put g_hit pos get g_hit sub pos 1
put g_sc pos get g_sc sub pos 1
pos = sub pos 1
end
put g_hit pos k
put g_sc pos s
h = add h 1
end
end
put g_n 1 h
end

note a number in decimal into g_nm from byte p; the byte after it
fn pnum p ulong v ulong to ulong
d = ulong 1
while ge div v d 10 bound 24
d = mul d 10
end
q = p
while gt d 0 bound 24
put g_nm q uchar add 48 rem div v d 10
q = add q 1
d = div d 10
end
ret q
end

note the text into g_nm from byte p; the byte after it
fn ptxt p ulong t view uchar * to ulong
for i ulong len t
put g_nm add p i get t i
end
ret add p len t
end

note name k into g_nm from byte p; the byte after it
fn pname p ulong k ulong to ulong
o = get g_off k
n = get g_ln k
for i ulong n bound 1000
put g_nm add p i get g_pool add o i
end
ret add p n
end

note "H of N apps" into the status line
fn status to void
p = pnum 0 get g_n 1
p = ptxt p x_of
p = pnum p get g_n 0
p = ptxt p x_apps
put g_nm p 0
str = nsb
x = msg get g_o 2 get g_o 8 str 0 0
end

note select row r of the list and bring it into view
fn choose r ulong to void
put g_n 6 r
ix = msg get g_o 13 get g_o 14 r 0 0
x = msg get g_o 1 get g_o 12 ix 0 0
x = msg get g_o 1 get g_o 15 r 0 0
end

note what the list shows was typed into the field: read it, narrow, show
fn typed to void
str = msg get g_o 0 get g_o 6 0 0 0
p = msg str get g_o 5 0 0 0
n = fetch p
if gt n 255
n = 255
end
for i ulong n bound 256
put g_q i get g_nm i
end
put g_n 4 n
narrow
x = msg get g_o 1 get g_o 7 0 0 0
put g_n 6 0
if gt get g_n 1 0
choose 0
end
status
end

note open app k: its folder, "/", its name and ".app" as a file address, handed to the workspace
fn launch k ulong to void
p = ulong 0
if eq ulong get g_dir k 0
p = ptxt 0 x_dir1
else
p = ptxt 0 x_dir2
end
p = ptxt p x_slash
p = pname p k
p = ptxt p x_dotapp
put g_nm p 0
str = nsb
c = cl c_url
s = sl m_furl
url = msg c s str 0 0
c = cl c_ws
s = sl m_shws
ws = msg c s 0 0 0
s = sl m_open
x = msg ws s url 0 0
end

note one turn of the event loop: wait for an event until date d and hand it to AppKit
fn tick app ulong sn ulong se ulong mode ulong d ulong to void
pr 0 app
pr 8 sn
pr 16 18446744073709551615
pr 24 d
pr 32 mode
pr 40 1
ev = call 2
if ne ev 0
x = msg app se ev 0 0
end
end

note the methods of OmegaHopPanel. 0 controlTextDidChange: 1 numberOfRowsInTableView:
note 2 tableView:objectValueForTableColumn:row: (e is the row) 3 go: (the field's action, Enter: c is the sender;
note the program's own check sends none, and then nothing is opened) 4 control:textView:doCommandBySelector: (e is
note the command: the arrows move the selection, Escape ends the program; 1 says the key was handled)
fn libback k ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq k 0
typed
ret 0
end
if eq k 1
ret get g_n 1
end
if eq k 2
if ge e get g_n 1
ret 0
end
p = pname 0 get g_hit e
put g_nm p 0
ret nsb
end
if eq k 3
put g_n 3 add get g_n 3 1
if and ne c 0 lt get g_n 6 get g_n 1
launch get g_hit get g_n 6
put g_n 5 1
end
end
if eq k 4
if eq e get g_o 9
if lt add get g_n 6 1 get g_n 1
choose add get g_n 6 1
end
ret 1
end
if eq e get g_o 10
if gt get g_n 6 0
choose sub get g_n 6 1
end
ret 1
end
if eq e get g_o 11
put g_n 5 1
ret 1
end
end
ret 0
end

note one method of the class: selector text, callback entry, type text
fn method c ulong t view uchar * entry ulong ty view uchar * to bool
s = sl t
n = cs ty
pr 0 c
pr 8 s
pr 16 ulong libfn int add 2 entry
pr 24 ulong libptr g_nm 0 1024
ret eq and call 5 255 1
end

fn main to int
n = cs s_appkit
pr 0 ulong libptr g_nm 0 1024
pr 8 2
lr = libcall ulong libfn 0 g_rg 0 128
if eq gr 0 0
ret 2
end
put g_f 0 sym s_gc
put g_f 1 sym s_sr
put g_f 2 sym s_ms
put g_f 3 sym s_wr
put g_f 4 sym s_acp
put g_f 5 sym s_cam
put g_f 6 sym s_rcp
put g_f 7 sym s_strlen
put g_f 8 sym s_memcpy
put g_f 9 sym s_getenv
for i ulong 10
if eq get g_f i 0
ret 3
end
end
put g_o 3 cl c_str
put g_o 4 sl m_utf
put g_o 5 sl m_cstr
put g_o 6 sl m_strval
put g_o 7 sl m_reload
put g_o 8 sl m_setstr
put g_o 9 sl m_down
put g_o 10 sl m_up
put g_o 11 sl m_cancel
put g_o 12 sl m_selrow
put g_o 13 cl c_ixset
put g_o 14 sl m_ixwith
put g_o 15 sl m_scrrow
c = cl c_pool
s = sl m_alloc
pool = msg c s 0 0 0
sinit = sl m_init
pool = msg pool sinit 0 0 0
folder x_dir1 0
folder x_dir2 1
put g_n 4 0
narrow
if eq get g_n 0 0
ret 4
end
c = cl c_app
s = sl m_shared
app = msg c s 0 0 0
n = cs x_env
pr 0 ulong libptr g_nm 0 1024
chk = ne call 9 0
pol = ulong 0
if chk
pol = 1
end
s = sl m_policy
x = msg app s pol 0 0
note the class whose methods are the callback entries
c = cl c_obj
n = cs c_mine
pr 0 c
pr 8 ulong libptr g_nm 0 1024
pr 16 0
mine = call 4
if eq mine 0
ret 5
end
ok = method mine m_change 0 t_v
ok = and ok method mine m_rows 1 t_q
ok = and ok method mine m_value 2 t_o
ok = and ok method mine m_go 3 t_v
ok = and ok method mine m_cmd 4 t_b
if not ok
ret 6
end
pr 0 mine
x = call 6
s = sl m_alloc
me = msg mine s 0 0 0
me = msg me sinit 0 0 0
note the window
c = cl c_win
s = sl m_alloc
w = msg c s 0 0 0
s = sl m_initwi
rect 240.0f64 260.0f64 520.0f64 360.0f64
w = msg w s 3 2 0
if eq w 0
ret 7
end
str = ns x_title
s = sl m_title
x = msg w s str 0 0
s = sl m_conten
cv = msg w s 0 0 0
sadd = sl m_addsub
sframe = sl m_initfr
note the search field
c = cl c_field
s = sl m_alloc
fld = msg c s 0 0 0
rect 16.0f64 316.0f64 488.0f64 28.0f64
fld = msg fld sframe 0 0 0
str = ns x_hint
s = sl m_placeh
x = msg fld s str 0 0
s = sl m_setdel
x = msg fld s me 0 0
s = sl m_settar
x = msg fld s me 0 0
s = sl m_setact
sgo = sl m_go
x = msg fld s sgo 0 0
x = msg cv sadd fld 0 0
put g_o 0 fld
note the status line
str = ns x_hint
c = cl c_field
s = sl m_label

if eq ulong get g_rb sub add o ln 1 47
ln = sub ln 1
end
end
if or eq ln 0 gt ln 1000
ret 0
end
for j ulong ln bound 1001
put g_nm j get g_rb add o j
end
put g_nm ln 0
ret unsb
end


end

note look at every forwarded port: for one whose link is not running, and that is not being asked about already,
note it is asked whether something serves the port
fn utunnelcheck to void
links = get g_m 60
if or or eq links 0 eq get g_m 61 0 eq get g_m 63 0
ret
end
if not uremoteok
ret
end
sat = usl m_at
s_whole = usl m_integer_value
s_keyed = usl m_object_for_key
c_n_v = ucl c_number
s_number = usl m_number_integer

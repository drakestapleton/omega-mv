note hopfact: Hop factory command-center core, native ABI v1 (OM-1). Contract: Omega/README.md.
note One call validates a bounded snapshot (256 ulong words in), categorizes every row, orders the
note attention view and derives totals (256 ulong words out). Any malformed input fails closed as
note verdict 1 INVALID with a reason and the first faulting word; nothing is guessed or defaulted.
note Unknown states, rows the host could not decode and unrecognized groups are never IDLE or CLEAR.

note code: reason r at input word i, packed as r*256+i (never 0 for r >= 1)
fn code r ulong i ulong to ulong
ret add mul r 256 i
end

fn bitset m ulong b ulong to bool
ret ne and m shl ulong 1 b 0
end

note highest state code each kind defines (0 is always "unknown")
fn maxst k ulong to ulong
if eq k 1
ret 5
end
if eq k 13
ret 7
end
if eq k 14
ret 5
end
ret 1
end

note largest count each kind accepts: quota permille 1000, agent idle seconds 4e9, others 1e6
fn capof k ulong to ulong
if eq k 12
ret 1000
end
if eq k 11
ret 4000000000
end
ret 1000000
end

note source bit a kind's rows come from: floor stream 0, usage 1, settings 2, chat 3
fn needbit k ulong to ulong
if le k 11
ret 0
end
if eq k 15
ret 0
end
if eq k 12
ret 1
end
if eq k 13
ret 2
end
ret 3
end

note station status: 1 idle 2 waiting 3 queued 4 running 5 bottleneck
fn catstn s ulong to ulong
if eq s 5
ret 5
end
if ge s 3
ret 8
end
if eq s 2
ret 9
end
ret 12
end

note review/merge groups 2..10 and 15; an empty group is idle
fn catgrp k ulong c ulong to ulong
if eq c 0
ret 12
end
if eq k 15
ret 5
end
if eq k 2
ret 8
end
if eq k 3
ret 4
end
if eq k 5
ret 6
end
if eq k 6
ret 7
end
if eq k 10
ret 10
end
if ge k 8
ret 11
end
ret 2
end

note account: 1 OK 2 MISSING 3 EXPIRED 4 RELOGIN 5 BLOCKED 6 RUNNING 7 SAVED
fn catacc s ulong to ulong
if le s 4
if ge s 2
ret 3
end
end
if eq s 5
ret 4
end
ret 12
end

note chat item: 1 thinking 2 sending 3 ask 4 delivered 5 error
fn catchat s ulong to ulong
if le s 2
ret 8
end
if eq s 3
ret 2
end
if eq s 5
ret 5
end
ret 12
end

note category 1 UNKNOWN 2 DECISION 3 ACCESS 4 QUOTA 5 TRIAGE 6 READY 7 OWNER 8 WORK 9 BACKLOG
note 10 OTHER 11 NEUTRAL 12 IDLE; called only on rows that passed chkrow
fn catof k ulong s ulong c ulong v ulong to ulong
if eq v 0
ret 1
end
if eq s 0
ret 12
end
if eq k 1
ret catstn s
end
if le k 10
ret catgrp k c
end
if eq k 15
ret catgrp k c
end
if eq k 11
if lt c 90
ret 8
end
ret 12
end
if eq k 12
if lt c 100
ret 4
end
ret 12
end
if eq k 13
ret catacc s
end
ret catchat s
end

note one row: id, kind, state, count, valid at words 8+5r .. 12+5r
fn chkrow inp view ulong 256 r ulong msk ulong to ulong
b = add 8 mul r 5
k = get inp add b 1
if eq k 0
ret code 6 add b 1
end
if gt k 15
ret code 6 add b 1
end
if gt get inp b 65535
ret code 15 b
end
if gt get inp add b 2 maxst k
ret code 14 add b 2
end
if gt get inp add b 3 capof k
ret code 5 add b 3
end
if gt get inp add b 4 1
ret code 7 add b 4
end
if not bitset msk needbit k
ret code 9 add b 1
end
ret 0
end

fn dupid inp view ulong 256 n ulong to ulong
for r ulong n
a = get inp add 8 mul r 5
for q ulong r
if eq a get inp add 8 mul q 5
ret code 8 add 8 mul r 5
end
end
end
ret 0
end

fn chkhead inp view ulong 256 to ulong
for i ulong 256
if gt get inp i 9223372036854775807
ret code 4 i
end
end
if ne get inp 0 1213157446
ret code 1 0
end
if ne get inp 1 1
ret code 2 1
end
if gt get inp 2 48
ret code 3 2
end
if gt get inp 5 3
ret code 11 5
end
if gt get inp 6 15
ret code 12 6
end
if ne get inp 7 0
ret code 13 7
end
n = get inp 2
p = add 8 mul n 5
while lt p 256 bound 256
if ne get inp p 0
ret code 10 p
end
p = add p 1
end
msk = get inp 6
for r ulong n
e = chkrow inp r msk
if ne e 0
ret e
end
end
ret dupid inp n
end

fn zero res edit ulong 256 to void
for i ulong 256
put res i 0
end
end

fn invalid res edit ulong 256 e ulong to ulong
zero res
put res 0 1213157446
put res 1 1
put res 2 1
put res 3 div e 256
put res 4 rem e 256
ret 1
end

note snapshot-level reason: 20 health failed, 21 link unknown, 22 stream unavailable, 23 generated
note absent, 24 older than 60000 ms, 25 generated over 30000 ms ahead, 26 floor stream missing;
note 0 when the snapshot is current (coverage of station and group kinds is checked by cover)
fn snapr inp view ulong 256 to ulong
l = get inp 5
if eq l 2
ret 20
end
if eq l 0
ret 21
end
if eq l 3
ret 22
end
gen = get inp 4
now = get inp 3
if eq gen 0
ret 23
end
if gt gen add now 30000
ret 25
end
if gt now gen
if gt sub now gen 60000
ret 24
end
end
if not bitset get inp 6 0
ret 26
end
ret 0
end

fn agems inp view ulong 256 to ulong
gen = get inp 4
now = get inp 3
if eq gen 0
ret 18446744073709551615
end
if gt gen now
if gt sub gen now 30000
ret 18446744073709551615
end
ret 0
end
ret sub now gen
end

note per-row categories at 96+r and per-category counts at 8+c
fn classify inp view ulong 256 res edit ulong 256 n ulong to void
for r ulong n
b = add 8 mul r 5
c = catof get inp add b 1 get inp add b 2 get inp add b 3 get inp add b 4
put res add 96 r c
put res add 8 c add get res add 8 c 1
end
end

note kind presence mask at 7, per-kind count sums at 24+k (absent kind: -1)
fn tally inp view ulong 256 res edit ulong 256 n ulong to void
m = ulong 0
for r ulong n
b = add 8 mul r 5
k = get inp add b 1
m = or m shl ulong 1 k
put res add 24 k add get res add 24 k get inp add b 3
end
put res 7 m
for k ulong 16
if gt k 0
if not bitset m k
put res add 24 k 18446744073709551615
end
end
end
end

note agents working (idle under 90 s) and total at 40, 41 (-1 when no agent rows were sent);
note minimum quota permille at 42 (-1 when none)
fn derive inp view ulong 256 res edit ulong 256 n ulong to void
w = ulong 0
t = ulong 0
mq = ulong 18446744073709551615
for r ulong n
b = add 8 mul r 5
k = get inp add b 1
c = get inp add b 3
if eq k 11
t = add t 1
if lt c 90
w = add w 1
end
end
if eq k 12
if lt c mq
mq = c
end
end
end
if gt t 0
put res 40 w
put res 41 t
else
put res 40 18446744073709551615
put res 41 18446744073709551615
end
put res 42 mq
end

note attention order at 48+i: row ids by category ascending, then input order
fn order inp view ulong 256 res edit ulong 256 n ulong to void
p = ulong 48
for c ulong 13
for r ulong n
if eq get res add 96 r c
put res p get inp add 8 mul r 5
p = add p 1
end
end
end
end

note attention rows: categories 1..7 and 10
fn attn res view ulong 256 to ulong
a = get res 18
for c ulong 8
if gt c 0
a = add a get res add 8 c
end
end
ret a
end

fn firstat res view ulong 256 to ulong
for c ulong 11
if gt c 0
if le c 7
if gt get res add 8 c 0
ret c
end
end
end
end
ret 10
end

note first kind the floor must report but did not: station 1, review 2..4, merge 5..7; 0 = covered
fn cover m ulong to ulong
for k ulong 8
if gt k 0
if not bitset m k
ret k
end
end
end
ret 0
end

fn verdof r ulong to ulong
if eq r 20
ret 2
end
if le r 22
ret 3
end
if le r 25
ret 4
end
ret 5
end

note entry. Word 45 is read-freshness admission: 1 only when the snapshot is valid, the link is up,
note generated is current and the floor stream is present (group coverage not required). It never
note authorizes an action; the host still needs a live selection, explicit confirmation and the server.
fn hopfact inp view ulong 256 res edit ulong 256 to ulong
e = chkhead inp
if ne e 0
ret invalid res e
end
zero res
n = get inp 2
put res 0 1213157446
put res 1 1
put res 5 n
put res 6 agems inp
classify inp res n
tally inp res n
derive inp res n
order inp res n
a = attn res
put res 43 a
r = snapr inp
if eq r 0
put res 45 1
k = cover get res 7
if ne k 0
put res 4 k
r = ulong 31
if le k 4
r = ulong 30
end
if eq k 1
r = ulong 29
end
end
end
v = ulong 8
if ne r 0
v = verdof r
else
if gt a 0
v = ulong 6
r = add 40 firstat res
else
if gt add get res 16 get res 17 0
v = ulong 7
r = ulong 60
end
end
end
put res 2 v
put res 3 r
ret v
end

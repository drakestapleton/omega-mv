note hopfuse: how Hop chooses minds for a request, and how it judges a round of their answers.
note Native ABI v1 (OM-1). Contract: Omega/FUSE.md. One call, 256 ulong words in, 256 out, no state.
note Word 2 of the input is the operation: 1 PLAN (which seats, in what shape), 2 JUDGE (is there
note consensus). The vocabulary follows omega-mv spec/cognitive-routing.md: a requirement, the
note cheapest ladder expected to meet it, bounded escalation, an ensemble class, and a refusal in
note place of a silent approximation. Malformed input fails closed as verdict 1 INVALID. An unknown
note difficulty is never treated as trivial, and an unknown or failed seat is never chosen.

note code: reason r at input word i, packed as r*256+i (never 0 for r >= 1)
fn code r ulong i ulong to ulong
ret add mul r 256 i
end

fn bitset m ulong b ulong to bool
ret ne and m shl ulong 1 b 0
end

note field f of row r. Rows start at word 16 and are 6 words long.
note PLAN seat: 0 id, 1 tier, 2 family, 3 cost, 4 state, 5 capabilities
note JUDGE record: 0 seat id, 1 status, 2 confidence, 3 deltas, 4 agree, 5 zero
fn fld inp view ulong 256 r ulong f ulong to ulong
ret get inp add add 16 mul r 6 f
end

note a seat may be chosen when it is ready (1) or limited (2). Unknown (0) and down (3) never are.
fn usable inp view ulong 256 s ulong to ulong
st = fld inp s 4
if eq st 1
ret 1
end
if eq st 2
ret 1
end
ret 0
end

note what it costs to choose a seat. A limited seat counts 2000000 more than its price, which is
note above any ready seat's price, so a limited seat is taken only when no ready one can do it.
fn ceff inp view ulong 256 s ulong to ulong
c = fld inp s 3
if eq fld inp s 4 2
ret add c 2000000
end
ret c
end

note how strong a seat counts when the strongest is wanted: its tier, and 4 more when it is ready,
note so any ready seat ranks above any limited one
fn rank inp view ulong 256 s ulong to ulong
if eq fld inp s 4 1
ret add fld inp s 1 4
end
ret fld inp s 1
end

note 1 when seat s may be chosen and has capability bit b (0 answer, 1 act)
fn can inp view ulong 256 s ulong b ulong to ulong
if eq usable inp s 0
ret 0
end
if bitset fld inp s 5 b
ret 1
end
ret 0
end

note cheapest seat with capability b and tier at least t that is not in mask m. 99 when none.
fn cheapest inp view ulong 256 n ulong b ulong t ulong m ulong to ulong
best = ulong 99
bc = ulong 0
for s ulong n
if eq can inp s b 1
if ge fld inp s 1 t
if not bitset m s
c = ceff inp s
if eq best 99
best = s
bc = c
else
if lt c bc
best = s
bc = c
end
end
end
end
end
end
ret best
end

note strongest seat with capability b and tier at least t that is not in mask m and whose family
note is not in family mask fm: ready before limited, then highest tier, then cheapest, then first
note given. 99 when none.
fn strong inp view ulong 256 n ulong b ulong m ulong t ulong fm ulong to ulong
best = ulong 99
bt = ulong 0
bc = ulong 0
for s ulong n
if eq can inp s b 1
if ge fld inp s 1 t
if not bitset m s
if not bitset fm fld inp s 2
st = rank inp s
c = ceff inp s
if eq best 99
best = s
bt = st
bc = c
else
if gt st bt
best = s
bt = st
bc = c
else
if eq st bt
if lt c bc
best = s
bc = c
end
end
end
end
end
end
end
end
end
ret best
end

note one PLAN seat row: id, tier 1..4, family 1..31, cost, state 0..3, capability mask 0..3
fn chkseat inp view ulong 256 r ulong to ulong
b = add 16 mul r 6
if gt get inp b 65535
ret code 15 b
end
t = get inp add b 1
if eq t 0
ret code 6 add b 1
end
if gt t 4
ret code 6 add b 1
end
f = get inp add b 2
if eq f 0
ret code 7 add b 2
end
if gt f 31
ret code 7 add b 2
end
if gt get inp add b 3 1000000
ret code 5 add b 3
end
if gt get inp add b 4 3
ret code 14 add b 4
end
if gt get inp add b 5 3
ret code 9 add b 5
end
ret 0
end

note one JUDGE record row: seat id, status 0..4, confidence in parts per million, deltas, agree, 0
fn chkrec inp view ulong 256 r ulong to ulong
b = add 16 mul r 6
if gt get inp b 65535
ret code 15 b
end
if gt get inp add b 1 4
ret code 14 add b 1
end
if gt get inp add b 2 1000000
ret code 5 add b 2
end
if gt get inp add b 3 1000
ret code 5 add b 3
end
if gt get inp add b 4 1
ret code 7 add b 4
end
if ne get inp add b 5 0
ret code 10 add b 5
end
ret 0
end

fn dupid inp view ulong 256 n ulong to ulong
for r ulong n
a = fld inp r 0
for q ulong r
if eq a fld inp q 0
ret code 8 add 16 mul r 6
end
end
end
ret 0
end

note the words 4..15 of a PLAN: kind 1..3, difficulty 0..5, stakes 0..3, confidence, most seats at
note once 1..8, most escalations 0..3, flags 0..7, then zeros
fn chkplan inp view ulong 256 to ulong
k = get inp 4
if eq k 0
ret code 12 4
end
if gt k 3
ret code 12 4
end
if gt get inp 5 5
ret code 12 5
end
if gt get inp 6 3
ret code 12 6
end
if gt get inp 7 1000000
ret code 5 7
end
p = get inp 8
if eq p 0
ret code 12 8
end
if gt p 8
ret code 12 8
end
if gt get inp 9 3
ret code 12 9
end
if gt get inp 10 7
ret code 12 10
end
for i ulong 16
if ge i 11
if ne get inp i 0
ret code 13 i
end
end
end
ret 0
end

note the words 4..15 of a JUDGE: rounds done 0..3, most rounds 0..3, then zeros
fn chkjudge inp view ulong 256 to ulong
if gt get inp 4 3
ret code 12 4
end
if gt get inp 5 3
ret code 12 5
end
for i ulong 16
if ge i 6
if ne get inp i 0
ret code 13 i
end
end
end
ret 0
end

fn chkhead inp view ulong 256 to ulong
for i ulong 256
if gt get inp i 9223372036854775807
ret code 4 i
end
end
if ne get inp 0 1212568915
ret code 1 0
end
if ne get inp 1 1
ret code 2 1
end
op = get inp 2
if eq op 0
ret code 3 2
end
if gt op 2
ret code 3 2
end
n = get inp 3
e = ulong 0
if eq op 1
if gt n 16
ret code 11 3
end
e = chkplan inp
else
if gt n 8
ret code 11 3
end
e = chkjudge inp
end
if ne e 0
ret e
end
p = add 16 mul n 6
while lt p 256 bound 256
if ne get inp p 0
ret code 10 p
end
p = add p 1
end
for r ulong n
if eq op 1
e = chkseat inp r
else
e = chkrec inp r
end
if ne e 0
ret e
end
end
ret dupid inp n
end

fn zero res edit ulong 256 to void
for i ulong 256
put res i 0
end
end

fn invalid res edit ulong 256 e ulong to ulong
zero res
put res 0 1212568915
put res 1 1
put res 2 1
put res 3 div e 256
put res 4 rem e 256
ret 1
end

note the difficulty the plan must meet. An unknown difficulty counts as standard (3), never less.
note A triage that was not sure (under 600000) raises it one step, to hard at most. High stakes
note raise it one more step. Why it was raised goes to word 12: 1 unknown, 2 unsure, 4 stakes.
fn level inp view ulong 256 res edit ulong 256 to ulong
d = get inp 5
fl = ulong 0
if eq d 0
d = ulong 3
fl = or fl 1
end
if lt get inp 7 600000
if lt d 4
d = add d 1
fl = or fl 2
end
end
if eq get inp 6 3
if lt d 5
d = add d 1
fl = or fl 4
end
end
put res 12 fl
ret d
end

note role 4 for every seat that may not be chosen (unknown or down)
fn mark inp view ulong 256 res edit ulong 256 n ulong to void
for s ulong n
if eq usable inp s 0
put res add 32 s 4
end
end
end

note flag 32 in word 12 when a chosen seat is a limited one
fn flaglim inp view ulong 256 res edit ulong 256 n ulong to void
for s ulong n
r = get res add 32 s
if ge r 1
if le r 3
if eq fld inp s 4 2
put res 12 or get res 12 32
end
end
end
end
end

note write seat s as chosen seat number i: its id at 16+i, role 1, and its cost added to word 11
fn take inp view ulong 256 res edit ulong 256 i ulong s ulong to void
put res add 16 i fld inp s 0
put res add 32 s 1
put res 11 add get res 11 ceff inp s
end

note the escalation rungs after the first seat: each time the cheapest seat of a higher tier than
note the rung before, at most as many as word 9 allows. Returns the number of rungs in all.
fn climb inp view ulong 256 res edit ulong 256 n ulong b ulong first ulong to ulong
m = ulong 1
cur = fld inp first 1
mask = shl ulong 1 first
for k ulong 3
if lt k get inp 9
nx = cheapest inp n b add cur 1 mask
if ne nx 99
take inp res m nx
cur = fld inp nx 1
mask = or mask shl ulong 1 nx
m = add m 1
end
end
end
ret m
end

note one seat, then stronger ones if its answer is not accepted. t is the wanted tier, b the
note capability the work needs. Returns the number of rungs; 0 when no seat can do it. When no seat
note reaches the wanted tier the strongest one is taken and flag 16 says so.
fn ladder inp view ulong 256 res edit ulong 256 n ulong t ulong b ulong to ulong
first = cheapest inp n b t 0
if eq first 99
first = strong inp n b 0 1 0
if eq first 99
ret 0
end
put res 12 or get res 12 16
end
take inp res 0 first
m = climb inp res n b first
put res 7 m
ret m
end

note the proposers of a fusion: seats of tier 3 or more that can answer, one per family first
note (strongest, then cheapest), at most as many as word 8 allows. If that gives fewer than two,
note one more of a family already used may join. Returns how many were chosen.
fn proposers inp view ulong 256 res edit ulong 256 n ulong to ulong
mask = ulong 0
fm = ulong 0
m = ulong 0
for i ulong 8
if lt m get inp 8
s = strong inp n 0 mask 3 fm
if ne s 99
take inp res m s
mask = or mask shl ulong 1 s
fm = or fm shl ulong 1 fld inp s 2
m = add m 1
end
end
end
if lt m 2
s = strong inp n 0 mask 3 0
if ne s 99
take inp res m s
m = add m 1
end
end
put res 7 m
ret m
end

note undo what proposers wrote, when a fusion cannot be formed
fn unpick inp view ulong 256 res edit ulong 256 n ulong to void
for i ulong 8
put res add 16 i 0
end
for s ulong n
if eq get res add 32 s 1
put res add 32 s 0
end
end
put res 7 0
put res 11 0
end

note the seat that fuses (strongest that can answer) and, for work that changes things, the seat
note that carries it out (strongest that can act). Returns 0, or 81 when nothing can act.
fn fusers inp view ulong 256 res edit ulong 256 n ulong to ulong
sy = strong inp n 0 0 1 0
if eq sy 99
ret 80
end
put res 8 fld inp sy 0
if eq get res add 32 sy 0
put res add 32 sy 2
put res 11 add get res 11 ceff inp sy
end
if eq get inp 4 3
ex = strong inp n 1 0 1 0
if eq ex 99
ret 81
end
put res 9 fld inp ex 0
if eq get res add 32 ex 0
put res add 32 ex 3
put res 11 add get res 11 ceff inp ex
end
end
r = ulong 1
if eq get inp 6 3
r = ulong 2
end
put res 10 r
ret 0
end

note why nothing can be chosen: 80 no seat is ready at all, 81 seats are ready but none can do it
fn whynot inp view ulong 256 n ulong to ulong
for s ulong n
if eq usable inp s 1
ret 81
end
end
ret 80
end

note PLAN. Verdicts: 2 REFUSED, 3 DIRECT, 4 SINGLE, 5 LADDER, 6 FUSION.
fn plan inp view ulong 256 res edit ulong 256 n ulong to ulong
put res 8 18446744073709551615
put res 9 18446744073709551615
d = level inp res
put res 6 d
t = d
if ge d 4
t = ulong 4
end
put res 5 t
fl = get inp 10
if bitset fl 0
put res 2 3
ret 3
end
mark inp res n
b = ulong 0
if eq get inp 4 3
b = ulong 1
end
want = ulong 0
if eq d 5
want = ulong 1
end
if bitset fl 1
want = ulong 1
end
if bitset fl 2
want = ulong 0
end
if lt get inp 8 2
want = ulong 0
end
if eq want 1
m = proposers inp res n
if ge m 2
f = fusers inp res n
if ne f 0
put res 2 2
put res 3 f
ret 2
end
flaglim inp res n
put res 2 6
ret 6
end
unpick inp res n
put res 12 or get res 12 8
end
m = ladder inp res n t b
if eq m 0
put res 2 2
put res 3 whynot inp n
ret 2
end
flaglim inp res n
v = ulong 4
if gt m 1
v = ulong 5
end
put res 2 v
ret v
end

note JUDGE. A record is usable when its status is 1. A usable record agrees only when it says so
note and proposes no change; anything else is dissent, and an unknown status is never agreement.
note Verdicts: 7 CONSENSUS, 8 ANOTHER_ROUND, 9 SETTLE, 10 ONE_VOICE, 11 NONE.
fn judge inp view ulong 256 res edit ulong 256 n ulong to ulong
u = ulong 0
dis = ulong 0
td = ulong 0
mc = ulong 18446744073709551615
for r ulong n
if eq fld inp r 1 1
put res add 16 u fld inp r 0
u = add u 1
c = fld inp r 2
if lt c mc
mc = c
end
dl = fld inp r 3
td = add td dl
cls = ulong 1
if eq fld inp r 4 0
cls = ulong 2
end
if gt dl 0
cls = ulong 2
end
if eq cls 2
dis = add dis 1
end
put res add 32 r cls
else
put res add 32 r 3
end
end
put res 5 u
put res 6 td
put res 7 mc
put res 8 dis
v = ulong 9
if eq u 0
v = ulong 11
else
if eq u 1
v = ulong 10
else
if eq dis 0
v = ulong 7
else
if lt get inp 4 get inp 5
v = ulong 8
end
end
end
end
put res 2 v
ret v
end

note entry
fn hopfuse inp view ulong 256 res edit ulong 256 to ulong
e = chkhead inp
if ne e 0
ret invalid res e
end
zero res
put res 0 1212568915
put res 1 1
n = get inp 3
if eq get inp 2 2
ret judge inp res n
end
ret plan inp res n
end

text hi_main "refs/heads/main"
text hi_C "-C"
text hi_gitdir "--git-dir"
text hi_revparse "rev-parse"
text hi_HEAD "HEAD"
text hi_status "status"
text hi_porcelain "--porcelain=v1"
text hi_untracked "--untracked-files=normal"
text hi_managed "X-Hop-Managed=true\n"
text hi_deskhead "[Desktop Entry]\nType=Application\nName=Hop\nComment=Find apps and files, ask, and work with your agent\nTerminal=false\nCategories=Utility;\nX-Hop-Managed=true\nExec=/usr/bin/env \""
text hi_desktail "\"\n"
text hi_usage "Usage: linux-install SOURCE_ROOT\n"
text hi_bad "Hop installation stopped; no existing version was deleted.\n"
text hi_badsource "Hop installs only a clean checkout of the current published main. Land and rebuild the change first.\n"
text hi_badbuild "Hop's build does not identify the current source. Rebuild from the published main first.\n"
text hi_badcollision "A launcher or desktop entry named Hop belongs to something else. It was left alone.\n"
text hi_badpath "Hop needs absolute HOME and data paths without control characters or an equals sign.\n"
text hi_done "Installed Hop. Open Hop from your application menu. Previous versions and dated backups were kept.\n"

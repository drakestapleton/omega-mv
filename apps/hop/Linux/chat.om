note Linux Ask. Model endpoint and model are explicit HOP_MODEL_URL and HOP_MODEL settings.
note curl is the platform HTTP/TLS transport; build/linux/dependency-curl.txt records its exact version.
note Successor: Omega om/tls client plus native DNS/HTTP transport. No shell or host language runtime.
note curl reads URL, request and optional API key from anonymous memory on stdin, never argv or a disk file.
note No redirects, ambient proxy, curlrc, cookies, retries or TLS verification overrides.
note Ask is synchronous: the window waits for the configured server. The transport deadline is 60 seconds.
global hc_cfg uchar *
global hc_json uchar *
global hc_str uchar *
global hc_body uchar *
global hc_url uchar *
global hc_model uchar *
global hc_key uchar *
global hc_ans uchar *
global hc_n ulong 8
global hc_pos ulong 1
global hc_found ulong 1
global hc_http ulong 1
global hc_env uchar 131072
global hc_io uchar 8192
global hc_pipe uchar 16
global hc_wait uchar 4
global hc_exec uchar 128
text hc_uk "HOP_MODEL_URL="
text hc_mk "HOP_MODEL="
text hc_kk "HOP_API_KEY="
text hc_h "http://"
text hc_hs "https://"
text hc_tail "/chat/completions"
text hc_curl "/usr/bin/curl"
text hc_q "-q"
text hc_config "--config"
text hc_dash "-"
text hc_memname "hop-model-request"
text hc_ct "silent\nshow-error\nfail-with-body\ngloboff\nconnect-timeout = 10\nmax-time = 60\nproto = \"=http,https\"\nproxy = \"\"\nrequest = \"POST\"\nheader = \"Content-Type: application/json\"\nurl = \""
text hc_auth "\"\nheader = \"Authorization: Bearer "
text hc_data "\"\ndata-binary = \""
text hc_end "\"\nwrite-out = \"\\n%{http_code}\"\n"
text hc_b1 "{\"model\":\""
text hc_b2 "\",\"messages\":[{\"role\":\"user\",\"content\":\""
text hc_b3 "\"}],\"stream\":false}"
text hc_choices "choices"
text hc_message "message"
text hc_content "content"
text hc_true "true"
text hc_false "false"
text hc_null "null"
text hc_need "Ask needs a model. Set HOP_MODEL_URL to your OpenAI-compatible server's base address and HOP_MODEL to its model name."
text hc_badurl "Ask: use an http:// or https:// model base address without control characters, query or fragment."
text hc_badkey "Ask: HOP_API_KEY contains a control character and cannot be used as a request header."
text hc_transport "Ask: the model request failed. Check the server address, model name, sign-in and network. curl with HTTPS support is required."
text hc_server "Ask: the server returned HTTP "
text hc_serverend ". Check the model settings and sign-in."
text hc_badjson "Ask: the server did not return a valid chat answer (choices[0].message.content must be text)."
text hc_mem "Hop Ask: the system could not allocate memory.\n"
text hc_action "Ask: "

fn hc_res which ulong need ulong to void
r = long 0
if eq which 0
if gt need len hc_cfg
r = enlarge hc_cfg add need add len hc_cfg 256
end
end
if eq which 1
if gt need len hc_json
r = enlarge hc_json add need add len hc_json 8192
end
end
if eq which 2
if gt need len hc_str
r = enlarge hc_str add need add len hc_str 256
end
end
if eq which 3
if gt need len hc_body
r = enlarge hc_body add need add len hc_body 256
end
end
if eq which 4
if gt need len hc_url
r = enlarge hc_url add need add len hc_url 256
end
end
if eq which 5
if gt need len hc_model
r = enlarge hc_model add need add len hc_model 256
end
end
if eq which 6
if gt need len hc_key
r = enlarge hc_key add need add len hc_key 256
end
end
if eq which 7
if gt need len hc_ans
r = enlarge hc_ans add need add len hc_ans 256
end
end
if lt r 0
x = write 2 hc_mem 0 len hc_mem
exit 1
end
end

fn hc_add which ulong c uchar to void
p = get hc_n which
hc_res which add p 1
if eq which 0
put hc_cfg p c
end
if eq which 1
put hc_json p c
end
if eq which 2
put hc_str p c
end
if eq which 3
put hc_body p c
end
if eq which 4
put hc_url p c
end
if eq which 5
put hc_model p c
end
if eq which 6
put hc_key p c
end
if eq which 7
put hc_ans p c
end
put hc_n which add p 1
end

fn hc_get which ulong p ulong to uchar
if eq which 0
ret get hc_cfg p
end
if eq which 1
ret get hc_json p
end
if eq which 2
ret get hc_str p
end
if eq which 3
ret get hc_body p
end
if eq which 4
ret get hc_url p
end
if eq which 5
ret get hc_model p
end
if eq which 6
ret get hc_key p
end
ret get hc_ans p
end

fn hc_text which ulong s view uchar * to void
for i ulong len s bound 9223372036854775807
hc_add which get s i
end
end

fn hc_rows s view uchar * to void
r = enlarge lx_rows len s
if lt r 0
x = write 2 hc_mem 0 len hc_mem
exit 1
end
for i ulong len s bound 9223372036854775807
put lx_rows i get s i
end
put lx_rn 0 len s
put lx_pick 0 0
end

fn hc_envget key view uchar * which ulong to bool
put hc_n which 0
for i ulong ulong envcnt bound 9223372036854775807
n = envread i hc_env 0 len hc_env
if lt n 0
ret false
end
if ge ulong n len key
same = true
for j ulong len key bound 9223372036854775807
if ne get hc_env j get key j
same = false
end
end
if same
p = len key
while lt p ulong n bound 9223372036854775807
hc_add which get hc_env p
p = add p 1
end
ret true
end
end
end
ret false
end

fn hc_prefix which ulong s view uchar * to bool
if lt get hc_n which len s
ret false
end
for i ulong len s bound 9223372036854775807
if ne hc_get which i get s i
ret false
end
end
ret true
end

fn hc_jbyte c uchar to void
if or eq c 34 eq c 92
hc_add 3 92
hc_add 3 c
ret
end
if lt c 32
hc_add 3 92
hc_add 3 117
hc_add 3 48
hc_add 3 48
v = add uchar 48 shr c 4
if gt v 57
v = add v 39
end
hc_add 3 v
v = add uchar 48 and c 15
if gt v 57
v = add v 39
end
hc_add 3 v
ret
end
hc_add 3 c
end

fn hc_cfgesc which ulong to void
for i ulong get hc_n which bound 9223372036854775807
c = hc_get which i
if or eq c 34 eq c 92
hc_add 0 92
end
hc_add 0 c
end
end

fn hc_prepare to bool
a = hc_envget hc_uk 4
b = hc_envget hc_mk 5
k = hc_envget hc_kk 6
if or or not a not b or eq get hc_n 4 0 eq get hc_n 5 0
hc_rows hc_need
ret false
end
if not or hc_prefix 4 hc_h hc_prefix 4 hc_hs
hc_rows hc_badurl
ret false
end
for i ulong get hc_n 4 bound 9223372036854775807
c = get hc_url i
if or lt c 33 or eq c 127 or eq c 63 eq c 35
hc_rows hc_badurl
ret false
end
end
for i ulong get hc_n 6 bound 9223372036854775807
c = get hc_key i
if or lt c 32 eq c 127
hc_rows hc_badkey
ret false
end
end
while gt get hc_n 4 0 bound 9223372036854775807
if ne get hc_url sub get hc_n 4 1 47
break
end
put hc_n 4 sub get hc_n 4 1
end
hc_text 4 hc_tail
put hc_n 3 0
hc_text 3 hc_b1
for i ulong get hc_n 5 bound 9223372036854775807
hc_jbyte get hc_model i
end
hc_text 3 hc_b2
p = ulong 4
while lt p get lx_qn 0 bound 9223372036854775807
hc_jbyte get lx_query p
p = add p 1
end
hc_text 3 hc_b3
put hc_n 0 0
hc_text 0 hc_ct
hc_cfgesc 4
if gt get hc_n 6 0
hc_text 0 hc_auth
hc_cfgesc 6
end
hc_text 0 hc_data
hc_cfgesc 3
hc_text 0 hc_end
ret true
end

fn hc_pack p ulong s view uchar * to ulong
put hc_exec p uchar and len s 255
put hc_exec add p 1 uchar shr len s 8
for i ulong len s bound 128
put hc_exec add add p 2 i get s i
end
ret add add p 2 len s
end

fn hc_readfd p ulong to int
v = or ulong get hc_pipe p shl ulong get hc_pipe add p 1 8
v = or v shl ulong get hc_pipe add p 2 16
v = or v shl ulong get hc_pipe add p 3 24
ret int v
end

fn hc_request to bool
put hc_http 0 0
put hc_exec 0 4
put hc_exec 1 0
p = hc_pack 2 hc_curl
p = hc_pack p hc_q
p = hc_pack p hc_config
p = hc_pack p hc_dash
plen = p
input = memfd hc_memname 0 len hc_memname 1
if lt input 0
ret false
end
p = ulong 0
while lt p get hc_n 0 bound 9223372036854775807
k = write int input hc_cfg p sub get hc_n 0 p
if eq k -4
continue
end
if le k 0
k = fclose int input
ret false
end
p = add p ulong k
end
k = fseek int input 0 0
if lt k 0
k = fclose int input
ret false
end
k = pipefds hc_pipe 8 8 524288
if ne k 0
k = fclose int input
ret false
end
pid = fork
if eq pid 0
k = dupfd int input 0 0
if lt k 0
exit 126
end
k = dupfd hc_readfd 12 1 0
if lt k 0
exit 126
end
note discard transport diagnostics: model URLs or server text can contain sensitive information.
note All failures are reported in Hop without echoing the key, URL or response.
k = dupfd hc_readfd 12 2 0
if lt k 0
exit 126
end
k = execprog hc_exec 0 plen
exit 127
end
k = fclose int input
k = fclose hc_readfd 12
if lt pid 0
k = fclose hc_readfd 8
ret false
end
ok = true
note Erase credential-bearing configuration after forking its anonymous input.
for i ulong get hc_n 0 bound 9223372036854775807
put hc_cfg i 0
end
for i ulong get hc_n 6 bound 9223372036854775807
put hc_key i 0
end
put hc_n 0 0
put hc_n 6 0
put hc_n 1 0
while true bound 9223372036854775807
k = read hc_readfd 8 hc_io 0 len hc_io
if eq k -4
continue
end
if lt k 0
ok = false
break
end
if eq k 0
break
end
for i ulong ulong k bound 8192
hc_add 1 get hc_io i
end
end
k = fclose hc_readfd 8
k = waitpid int pid hc_wait 0 4 0
if ne k pid
ret false
end
if lt get hc_n 1 4
ret false
end
p = sub get hc_n 1 4
if ne get hc_json p 10
ret false
end
statusv = ulong 0
for i ulong 3
c = get hc_json add add p 1 i
if or lt c 48 gt c 57
ret false
end
statusv = add mul statusv 10 ulong sub c 48
end
put hc_http 0 statusv
put hc_n 1 p
if or lt statusv 200 ge statusv 300
ret false
end
ret and ok and eq get hc_wait 0 0 eq get hc_wait 1 0
end

fn hc_space to void
while lt get hc_pos 0 get hc_n 1 bound 9223372036854775807
c = get hc_json get hc_pos 0
if not or eq c 32 or eq c 9 or eq c 10 eq c 13
break
end
put hc_pos 0 add get hc_pos 0 1
end
end

fn hc_next to int
hc_space
if ge get hc_pos 0 get hc_n 1
ret -1
end
ret int get hc_json get hc_pos 0
end

fn hc_hex c uchar to long
if and ge c 48 le c 57
ret long sub c 48
end
if and ge c 65 le c 70
ret add long sub c 65 10
end
if and ge c 97 le c 102
ret add long sub c 97 10
end
ret -1
end

fn hc_code to long
v = long 0
for i ulong 4
if ge get hc_pos 0 get hc_n 1
ret -1
end
h = hc_hex get hc_json get hc_pos 0
if lt h 0
ret -1
end
v = add mul v 16 h
put hc_pos 0 add get hc_pos 0 1
end
ret v
end

fn hc_utf cp ulong to void
if lt cp 128
hc_add 2 uchar cp
ret
end
if lt cp 2048
hc_add 2 uchar or 192 shr cp 6
else
if ge cp 65536
hc_add 2 uchar or 240 shr cp 18
hc_add 2 uchar or 128 and shr cp 12 63
else
hc_add 2 uchar or 224 shr cp 12
end
hc_add 2 uchar or 128 and shr cp 6 63
end
hc_add 2 uchar or 128 and cp 63
end

fn hc_string to bool
if ne hc_next 34
ret false
end
put hc_pos 0 add get hc_pos 0 1
put hc_n 2 0
while lt get hc_pos 0 get hc_n 1 bound 9223372036854775807
c = get hc_json get hc_pos 0
put hc_pos 0 add get hc_pos 0 1
if eq c 34
ret true
end
if lt c 32
ret false
end
if ne c 92
hc_add 2 c
continue
end
if ge get hc_pos 0 get hc_n 1
ret false
end
c = get hc_json get hc_pos 0
put hc_pos 0 add get hc_pos 0 1
if or eq c 34 or eq c 92 eq c 47
hc_add 2 c
continue
end
if eq c 110
hc_add 2 10
continue
end
if eq c 114
hc_add 2 13
continue
end
if eq c 116
hc_add 2 9
continue
end
if eq c 98
hc_add 2 8
continue
end
if eq c 102
hc_add 2 12
continue
end
if ne c 117
ret false
end
cp = hc_code
if lt cp 0
ret false
end
if and ge cp 55296 le cp 56319
if gt add get hc_pos 0 2 get hc_n 1
ret false
end
if ne get hc_json get hc_pos 0 92
ret false
end
if ne get hc_json add get hc_pos 0 1 117
ret false
end
put hc_pos 0 add get hc_pos 0 2
lo = hc_code
if or lt lo 56320 gt lo 57343
ret false
end
cp = add 65536 add mul sub cp 55296 1024 sub lo 56320
else
if and ge cp 56320 le cp 57343
ret false
end
end
hc_utf ulong cp
end
ret false
end

fn hc_streq s view uchar * to bool
if ne get hc_n 2 len s
ret false
end
for i ulong len s bound 9223372036854775807
if ne get hc_str i get s i
ret false
end
end
ret true
end

fn hc_literal s view uchar * to bool
if gt add get hc_pos 0 len s get hc_n 1
ret false
end
for i ulong len s bound 9223372036854775807
if ne get hc_json add get hc_pos 0 i get s i
ret false
end
end
put hc_pos 0 add get hc_pos 0 len s
ret true
end

fn hc_digit to bool
if ge get hc_pos 0 get hc_n 1
ret false
end
c = get hc_json get hc_pos 0
ret and ge c 48 le c 57
end

fn hc_digits to void
while hc_digit bound 9223372036854775807
put hc_pos 0 add get hc_pos 0 1
end
end

fn hc_number to bool
if eq hc_next 45
put hc_pos 0 add get hc_pos 0 1
end
if not hc_digit
ret false
end
if eq get hc_json get hc_pos 0 48
put hc_pos 0 add get hc_pos 0 1
else
hc_digits
end
if lt get hc_pos 0 get hc_n 1
if eq get hc_json get hc_pos 0 46
put hc_pos 0 add get hc_pos 0 1
if not hc_digit
ret false
end
hc_digits
end
end
if lt get hc_pos 0 get hc_n 1
c = get hc_json get hc_pos 0
if or eq c 101 eq c 69
put hc_pos 0 add get hc_pos 0 1
if lt get hc_pos 0 get hc_n 1
c = get hc_json get hc_pos 0
if or eq c 43 eq c 45
put hc_pos 0 add get hc_pos 0 1
end
end
if not hc_digit
ret false
end
hc_digits
end
end
ret true
end

fn hc_value mode ulong to bool
c = hc_next
if eq c 123
put hc_pos 0 add get hc_pos 0 1
if eq hc_next 125
put hc_pos 0 add get hc_pos 0 1
ret true
end
while true bound 9223372036854775807
if not hc_string
ret false
end
next = ulong 0
if and eq mode 1 hc_streq hc_choices
next = 2
end
if and eq mode 3 hc_streq hc_message
next = 4
end
if and eq mode 4 hc_streq hc_content
next = 5
end
if ne hc_next 58
ret false
end
put hc_pos 0 add get hc_pos 0 1
if not hc_value next
ret false
end
c = hc_next
put hc_pos 0 add get hc_pos 0 1
if eq c 125
ret true
end
if ne c 44
ret false
end
end
end
if eq c 91
put hc_pos 0 add get hc_pos 0 1
if eq hc_next 93
put hc_pos 0 add get hc_pos 0 1
ret true
end
idx = ulong 0
while true bound 9223372036854775807
next = ulong 0
if and eq mode 2 eq idx 0
next = 3
end
if not hc_value next
ret false
end
idx = add idx 1
c = hc_next
put hc_pos 0 add get hc_pos 0 1
if eq c 93
ret true
end
if ne c 44
ret false
end
end
end
if eq c 34
if not hc_string
ret false
end
if eq mode 5
if ne get hc_found 0 0
ret false
end
put hc_n 7 0
for i ulong get hc_n 2 bound 9223372036854775807
hc_add 7 get hc_str i
end
put hc_found 0 1
end
ret true
end
if eq c 116
ret hc_literal hc_true
end
if eq c 102
ret hc_literal hc_false
end
if eq c 110
ret hc_literal hc_null
end
if or eq c 45 and ge c 48 le c 57
ret hc_number
end
ret false
end

fn hc_query to int
if lt get lx_qn 0 5
ret 0
end
if or ne get lx_query 0 97 ne get lx_query 1 115
ret 0
end
if or ne get lx_query 2 107 ne get lx_query 3 32
ret 0
end
r = enlarge lx_rows add get lx_qn 0 1
if lt r 0
x = write 2 hc_mem 0 len hc_mem
exit 1
end
for i ulong len hc_action
put lx_rows i get hc_action i
end
p = len hc_action
i = ulong 4
while lt i get lx_qn 0 bound 9223372036854775807
put lx_rows p get lx_query i
p = add p 1
i = add i 1
end
put lx_rn 0 p
put lx_pick 0 0
ret 1
end

fn hc_activate to int
if not hc_prepare
ret 0
end
if not hc_request
if gt get hc_http 0 0
put hc_n 7 0
hc_text 7 hc_server
hc_add 7 uchar add 48 div get hc_http 0 100
hc_add 7 uchar add 48 rem div get hc_http 0 10 10
hc_add 7 uchar add 48 rem get hc_http 0 10
hc_text 7 hc_serverend
r = enlarge lx_rows get hc_n 7
if lt r 0
x = write 2 hc_mem 0 len hc_mem
exit 1
end
for i ulong get hc_n 7 bound 9223372036854775807
put lx_rows i get hc_ans i
end
put lx_rn 0 get hc_n 7
put lx_pick 0 0
ret 0
end
hc_rows hc_transport
ret 0
end
put hc_pos 0 0
put hc_found 0 0
put hc_n 7 0
ok = hc_value 1
hc_space
if or not ok or ne get hc_found 0 1 ne get hc_pos 0 get hc_n 1
hc_rows hc_badjson
ret 0
end
r = enlarge lx_rows get hc_n 7
if lt r 0
x = write 2 hc_mem 0 len hc_mem
exit 1
end
for i ulong get hc_n 7 bound 9223372036854775807
put lx_rows i get hc_ans i
end
put lx_rn 0 get hc_n 7
put lx_pick 0 0
ret 0
end

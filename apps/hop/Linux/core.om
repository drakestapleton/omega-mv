note Linux adapter for Hop's unchanged Omega matching helper.
note Requests use the existing Omega/README.md kind1 protocol, not a second matcher.
note An anonymous local socket carries stdio so send uses MSG_NOSIGNAL if the helper dies.
text hp_link "/proc/self/exe"
text hp_tail "/hopcore"
text hp_fail "Hop could not use its search helper. Rebuild Hop before launching it.\n"
global hp_fd int 3

fn hp_le a view uchar * p ulong n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl ulong get a add p i mul i 8
end
ret v
end

fn hp_put a edit uchar * p ulong v ulong n ulong to void
for i ulong n
put a add p i uchar and shr v mul i 8 255
end
end

fn hp_bad to void
k = write 2 hp_fail 0 len hp_fail
end

fn hp_start to int
hp_path = new uchar 4096 0
hp_exec = new uchar 4104 0
hp_addr = new uchar 19 0
put hp_fd 0 -1
put hp_fd 1 -1
put hp_fd 2 -1
n = readlnk hp_link 0 len hp_link hp_path 0 len hp_path
if le n 0
hp_bad
ret 1
end
if eq n long len hp_path
hp_bad
ret 1
end
p = ulong n
while gt p 0 bound 4096
if eq get hp_path sub p 1 47
break
end
p = sub p 1
end
if or eq p 0 gt add p len hp_tail len hp_path
hp_bad
ret 1
end
p = sub p 1
for i ulong len hp_tail
put hp_path add p i get hp_tail i
end
p = add p len hp_tail
hp_put hp_exec 0 1 2
hp_put hp_exec 2 p 2
for i ulong p
put hp_exec add i 4 get hp_path i
end
server = socknew 1 1 0
if lt server 0
hp_bad
ret 1
end
put hp_addr 0 1
k = random hp_addr 3 16 0
if ne k 16
k = fclose int server
hp_bad
ret 1
end
k = bind int server hp_addr 0 len hp_addr
if ne k 0
k = fclose int server
hp_bad
ret 1
end
k = listen int server 1
if ne k 0
k = fclose int server
hp_bad
ret 1
end
pid = fork
if eq pid 0
sock = socknew 1 1 0
if lt sock 0
exit 126
end
k = connect int sock hp_addr 0 len hp_addr
if ne k 0
exit 126
end
k = dupfd int sock 0 0
if lt k 0
exit 126
end
k = dupfd int sock 1 0
if lt k 0
exit 126
end
k = execprog hp_exec 0 add p 4
exit 127
end
if lt pid 0
k = fclose int server
hp_bad
ret 1
end
put hp_fd 2 int pid
ready = waitio int server 1 2000000000
if le ready 0
k = fclose int server
hp_stop
hp_bad
ret 1
end
sock = accept int server 0
k = fclose int server
if lt sock 0
hp_stop
hp_bad
ret 1
end
put hp_fd 0 int sock
put hp_fd 1 int sock
ret 0
end

fn hp_fuzz inp view ulong 256 to ulong
hp_req = new uchar 2056 0
hp_rep = new uchar 11 0
if lt get hp_fd 0 0
ret 0
end
hp_put hp_req 0 1 4
hp_put hp_req 4 2048 4
for i ulong 256
hp_put hp_req add 8 mul i 8 get inp i 8
end
p = ulong 0
while lt p len hp_req bound 2056
k = send get hp_fd 0 hp_req p sub len hp_req p 0
if le k 0
hp_bad
ret 0
end
p = add p ulong k
end
p = ulong 0
while lt p 11 bound 11
ready = waitio get hp_fd 1 1 2000000000
if le ready 0
hp_bad
ret 0
end
k = read get hp_fd 1 hp_rep p sub 11 p
if le k 0
hp_bad
ret 0
end
p = add p ulong k
end
if ne hp_le hp_rep 0 4 0
hp_bad
ret 0
end
if ne hp_le hp_rep 4 4 3
hp_bad
ret 0
end
if ne get hp_rep 8 1
ret 0
end
ret hp_le hp_rep 9 2
end

fn hp_stop to void
hp_state = new uchar 4 0
if ge get hp_fd 0 0
k = fclose get hp_fd 0
end
if and ge get hp_fd 1 0 ne get hp_fd 1 get hp_fd 0
k = fclose get hp_fd 1
end
put hp_fd 0 -1
put hp_fd 1 -1
if gt get hp_fd 2 0
k = killpid get hp_fd 2 15
k = waitpid get hp_fd 2 hp_state 0 4 0
put hp_fd 2 -1
end
end

om2
note Linux build driver. Compiler inputs, concatenation and subprocesses are owned by Omega.
note Bootstrap this file with OMEGA_MV/seed/out/omc; run it from Hop's source root.
text hb_usage "Usage: linux-build OMEGA_MV [install]\n"
text hb_error "Hop Linux build failed. The failing tool's diagnostic is above.\n"
text hb_done "Built build/linux/hop and its matching helper.\n"
text hb_root "/seed/out/omc"
text hb_ngsrc "build/linux/ngbuild.om"
text hb_ngboot "build/linux/ngbuild"
text hb_ng "build/linux/ng"
text hb_units "seed/ng/ng.units"
text hb_sha "/seed/ng/sha256.om"
text hb_builder "/seed/ng/ngbuild.om"
text hb_ngunits "/seed/ng/ng.units"
text hb_s1 "Linux/window.om"
text hb_s2 "Linux/apps.om"
text hb_s3 "Linux/core.om"
text hb_s4 "Linux/main.om"
text hb_s5 "Linux/chat.om"
text hb_join "build/linux/hop.om"
text hb_hop "build/linux/hop"
text hb_core "Omega/hopcore.om"
text hb_front "@ng front-ir\n"
text hb_opt "@ng opt\n"
text hb_a64 "@ng a64\n"
text hb_ci "build/linux/core-input.om"
text hb_ir "build/linux/core.ir"
text hb_oi "build/linux/opt-input"
text hb_or "build/linux/core.opt.ir"
text hb_ai "build/linux/elf-input"
text hb_co "build/linux/hopcore"
text hb_build "build"
text hb_dir "build/linux"
text hb_empty ""
text hb_slash "/"
text hb_gio "/usr/bin/gio"
text hb_env "/usr/bin/env"
text hb_curl "/usr/bin/curl"
text hb_version "version"
text hb_vflag "--version"
text hb_glog "build/linux/dependency-gio.txt"
text hb_elog "build/linux/dependency-env.txt"
text hb_clog "build/linux/dependency-curl.txt"
text hb_isrc "Linux/install.om"
text hb_ibin "build/linux/install"
text hb_iarg "install"
text hb_dd "--"
text hb_git "/usr/bin/git"
text hb_status "status"
text hb_porcelain "--porcelain=v1"
text hb_all "--untracked-files=all"
text hb_statuslog "build/linux/SOURCE_STATUS"
text hb_headlog "build/linux/SOURCE_HEAD"
text hb_revparse "rev-parse"
text hb_head "HEAD"
global hb_tree uchar 4096
global hb_tn ulong 1
global hb_cwd uchar 4096
global hb_cn ulong 1
global hb_tool uchar 4096
global hb_tl ulong 1
global hb_out uchar 4096
global hb_on ulong 1
global hb_src uchar 4096
global hb_sn ulong 1
global hb_pkt uchar 65536
global hb_pn ulong 1
global hb_ac ulong 1
global hb_input uchar 4096
global hb_in ulong 1
global hb_cd ulong 1
global hb_doins ulong 1

fn hb_fail to void
k = write 2 hb_error 0 len hb_error
exit 1
end

fn hb_path dest int suffix view uchar * to void
n = get hb_tn 0
if gt add n len suffix 4096
hb_fail
end
for i ulong n
if eq dest 0
put hb_tool i get hb_tree i
else
put hb_src i get hb_tree i
end
end
for i ulong len suffix
if eq dest 0
put hb_tool add n i get suffix i
else
put hb_src add n i get suffix i
end
end
if eq dest 0
put hb_tl 0 add n len suffix
else
put hb_sn 0 add n len suffix
end
end

fn hb_arg a view uchar * to void
p = get hb_pn 0
if gt add add p 2 len a len hb_pkt
hb_fail
end
put hb_pkt p uchar and len a 255
put hb_pkt add p 1 uchar shr len a 8
p = add p 2
for i ulong len a
put hb_pkt add p i get a i
end
put hb_pn 0 add p len a
put hb_ac 0 add get hb_ac 0 1
end

fn hb_absarg a view uchar * to void
b = new uchar 4096 0
n = get hb_cn 0
if gt add add n 1 len a len b
hb_fail
end
for i ulong n
put b i get hb_cwd i
end
put b n 47
for i ulong len a
put b add add n 1 i get a i
end
hb_arg part b 0 add add n 1 len a
end

fn hb_reset to void
put hb_pn 0 2
put hb_ac 0 0
put hb_cd 0 0
put hb_in 0 0
put hb_on 0 0
end

fn hb_addtool to void
b = new uchar 4096 0
n = get hb_tl 0
for i ulong n
put b i get hb_tool i
end
hb_arg part b 0 n
end

fn hb_redirect path view uchar * input bool to void
if input
for i ulong len path
put hb_input i get path i
end
put hb_in 0 len path
else
for i ulong len path
put hb_out i get path i
end
put hb_on 0 len path
end
end

fn hb_run to void
st = new uchar 4 0
put hb_pkt 0 uchar and get hb_ac 0 255
put hb_pkt 1 uchar shr get hb_ac 0 8
pid = fork
if eq pid 0
if gt get hb_in 0 0
fd = fopen hb_input 0 get hb_in 0 0 0
if lt fd 0
exit 126
end
k = dupfd int fd 0 0
if lt k 0
exit 126
end
end
if gt get hb_on 0 0
fd = fopen hb_out 0 get hb_on 0 577 420
if lt fd 0
exit 126
end
k = dupfd int fd 1 0
if lt k 0
exit 126
end
end
if ne get hb_cd 0 0
k = chdir hb_tree 0 get hb_tn 0
if ne k 0
exit 126
end
end
k = execprog hb_pkt 0 get hb_pn 0
exit 127
end
if lt pid 0
hb_fail
end
k = waitpid int pid st 0 4 0
if ne k pid
hb_fail
end
if ne get st 0 0
hb_fail
end
if ne get st 1 0
hb_fail
end
end

fn hb_copy fd int path view uchar * to void
buf = new uchar 65536 0
src = fopen path 0 len path 0 0
if lt src 0
k = write 2 path 0 len path
hb_fail
end
while true bound 9223372036854775807
n = read int src buf 0 len buf
if lt n 0
hb_fail
end
if eq n 0
break
end
p = ulong 0
while lt p ulong n bound 65536
k = write fd buf p sub ulong n p
if le k 0
hb_fail
end
p = add p ulong k
end
end
k = fclose int src
end

fn hb_sourcecopy fd int to void
b = new uchar 4096 0
n = get hb_sn 0
for i ulong n
put b i get hb_src i
end
hb_copy fd part b 0 n
end

fn hb_chmod path view uchar * to void
fd = fopen path 0 len path 0 0
if lt fd 0
hb_fail
end
k = fchmod int fd 493
if ne k 0
hb_fail
end
k = fclose int fd
end

fn hb_compile input view uchar * output view uchar * to void
hb_reset
hb_path 0 hb_root
hb_addtool
hb_redirect input true
hb_redirect output false
hb_run
hb_chmod output
end

fn hb_stage prefix view uchar * input view uchar * feed view uchar * to void
fd = fopen feed 0 len feed 577 420
if lt fd 0
hb_fail
end
k = write int fd prefix 0 len prefix
if ne k long len prefix
hb_fail
end
hb_copy int fd input
k = fclose int fd
end

fn hb_ngrun feed view uchar * output view uchar * to void
hb_reset
hb_absarg hb_ng
hb_redirect feed true
hb_redirect output false
hb_run
end

fn hb_dependency tool view uchar * arg view uchar * output view uchar * to void
hb_reset
hb_arg tool
hb_arg arg
hb_redirect output false
hb_run
end

fn hb_session to void
e = new uchar 131072 0
hb_arg hb_env
hb_arg hb_dd
for i ulong ulong envcnt bound 9223372036854775807
n = envread i e 0 len e
if lt n 0
hb_fail
end
hb_arg part e 0 ulong n
end
end

fn hb_provenance to void
statusv = new uchar 1 0
hb_reset
hb_arg hb_git
hb_arg hb_status
hb_arg hb_porcelain
hb_arg hb_all
hb_redirect hb_statuslog false
hb_run
fd = fopen hb_statuslog 0 len hb_statuslog 0 0
if lt fd 0
hb_fail
end
n = read int fd statusv 0 1
k = fclose int fd
if lt n 0
hb_fail
end
if ne n 0
note Development builds are useful but must never acquire an installable source stamp.
fd = fopen hb_headlog 0 len hb_headlog 577 420
if lt fd 0
hb_fail
end
k = fclose int fd
ret
end
hb_reset
hb_arg hb_git
hb_arg hb_revparse
hb_arg hb_head
hb_redirect hb_headlog false
hb_run
end

fn main to int
b = new uchar 4096 0
if and ne argcnt 2 ne argcnt 3
k = write 2 hb_usage 0 len hb_usage
ret 2
end
n = argread 1 b 0 len b
if or le n 0 ge n long len b
hb_fail
end
if ne get b 0 47
hb_fail
end
for i ulong ulong n
put hb_tree i get b i
end
put hb_tn 0 ulong n
if eq argcnt 3
n = argread 2 b 0 len b
if ne n long len hb_iarg
k = write 2 hb_usage 0 len hb_usage
ret 2
end
for i ulong len hb_iarg
if ne get b i get hb_iarg i
k = write 2 hb_usage 0 len hb_usage
ret 2
end
end
put hb_doins 0 1
end
n = cwd b 0 len b
if le n 0
hb_fail
end
put hb_cn 0 sub ulong n 1
for i ulong get hb_cn 0
put hb_cwd i get b i
end
k = makedir hb_build 0 len hb_build 493
if and lt k 0 ne k -17
hb_fail
end
k = makedir hb_dir 0 len hb_dir 493
if and lt k 0 ne k -17
hb_fail
end
fd = fopen hb_ngsrc 0 len hb_ngsrc 577 420
if lt fd 0
hb_fail
end
hb_path 1 hb_sha
hb_sourcecopy int fd
hb_path 1 hb_builder
hb_sourcecopy int fd
k = fclose int fd
hb_compile hb_ngsrc hb_ngboot
hb_reset
hb_absarg hb_ngboot
hb_arg hb_build
hb_path 0 hb_root
hb_addtool
hb_arg hb_units
hb_absarg hb_ng
put hb_cd 0 1
hb_run
hb_chmod hb_ng
hb_stage hb_front hb_core hb_ci
hb_ngrun hb_ci hb_ir
hb_stage hb_opt hb_ir hb_oi
hb_ngrun hb_oi hb_or
hb_stage hb_a64 hb_or hb_ai
hb_ngrun hb_ai hb_co
hb_chmod hb_co
fd = fopen hb_join 0 len hb_join 577 420
if lt fd 0
hb_fail
end
hb_copy int fd hb_s1
hb_copy int fd hb_s2
hb_copy int fd hb_s3
hb_copy int fd hb_s5
hb_copy int fd hb_s4
k = fclose int fd
hb_compile hb_join hb_hop
hb_compile hb_isrc hb_ibin
hb_dependency hb_gio hb_version hb_glog
hb_dependency hb_env hb_vflag hb_elog
hb_dependency hb_curl hb_vflag hb_clog
hb_provenance
k = write 1 hb_done 0 len hb_done
if ne get hb_doins 0 0
hb_reset
hb_session
hb_absarg hb_ibin
hb_absarg hb_empty
hb_run
end
ret 0
end

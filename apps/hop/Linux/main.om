note Hop's Linux entrypoint and shared UI and command actions.
text hm_help "Hop for Linux\n\nOpen Hop to find and launch your applications. Type ask followed by a question to use a model you configured.\n\nCommands:\n  hop                    Open the launcher\n  hop --search TEXT      Print matching application names\n  hop --open TEXT        Open the first matching application\n  hop --selftest         Check the search helper\n  hop --version          Show the Linux edition\n  hop --help             Show this help\n\nAsk settings: HOP_MODEL_URL and HOP_MODEL; HOP_API_KEY is optional.\nThis edition needs a local X11 desktop or XWayland. Clipboard history, saved accounts and voice are not available yet.\n"
text hm_ver "Hop Linux development edition\n"
text hm_search "--search"
text hm_open "--open"
text hm_test "--selftest"
text hm_version "--version"
text hm_dashhelp "--help"
text hm_plainhelp "help"
text hm_badarg "Hop could not understand that command. Run hop --help.\n"
text hm_ok "PASS Linux search helper\n"
text hm_no "FAIL Linux search helper\n"
global hm_wrap uchar *

fn hop_query to void
if eq hc_query 0
ha_query
end
end

fn hop_activate to int
if ne hc_query 0
resultv = hc_activate
hm_wrapanswer
ret resultv
end
ret ha_activate
end

fn hm_wrapanswer to void
note The X11 fixed font uses six pixels per character; wrap to the row's actual drawable width.
cols = div sub get lx_s 11 64 6
if eq cols 0
ret
end
n = get lx_rn 0
r = enlarge hm_wrap add mul n 2 1
if lt r 0
ret
end
p = ulong 0
column = ulong 0
for i ulong n bound 9223372036854775807
c = get lx_rows i
if eq c 10
column = 0
else
if ne and c 192 128
if ge column cols
put hm_wrap p 10
p = add p 1
column = 0
end
column = add column 1
end
end
put hm_wrap p c
p = add p 1
end
r = enlarge lx_rows p
if lt r 0
ret
end
for i ulong p bound 9223372036854775807
put lx_rows i get hm_wrap i
end
put lx_rn 0 p
end

fn hm_equal a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end

fn hm_selftest to int
inp = new ulong 256 0
put inp 0 1212568922
put inp 1 1
put inp 2 2
put inp 3 5
put inp 8 or ulong 102 shl ulong 1 32
put inp 9 or ulong 105 shl ulong 1 32
put inp 72 or ulong 102 shl ulong 1 32
put inp 73 or ulong 105 shl ulong 1 32
put inp 74 or ulong 108 shl ulong 1 32
put inp 75 or ulong 101 shl ulong 1 32
put inp 76 or ulong 115 shl ulong 1 32
score = hp_fuzz inp
put inp 8 or ulong 122 shl ulong 1 32
put inp 9 or ulong 122 shl ulong 1 32
wrong = hp_fuzz inp
note Prefix score 160-(5-2)=157, calc:ba69e77a30c85acf63f8374eceeb39df95c290c8b55d0f26a64e0d5b4b5ba9da.
if and eq score 157 eq wrong 0
k = write 1 hm_ok 0 len hm_ok
ret 0
end
k = write 2 hm_no 0 len hm_no
ret 1
end

fn main to int
a = new uchar 4096 0
if gt argcnt 1
n = argread 1 a 0 len a
if or lt n 0 eq n long len a
k = write 2 hm_badarg 0 len hm_badarg
ret 2
end
if or hm_equal part a 0 ulong n hm_dashhelp hm_equal part a 0 ulong n hm_plainhelp
k = write 1 hm_help 0 len hm_help
ret 0
end
if hm_equal part a 0 ulong n hm_version
k = write 1 hm_ver 0 len hm_ver
ret 0
end
end
if ne hp_start 0
ret 1
end
if gt argcnt 1
n = argread 1 a 0 len a
if hm_equal part a 0 ulong n hm_test
resultv = hm_selftest
hp_stop
ret resultv
end
searchv = hm_equal part a 0 ulong n hm_search
openv = hm_equal part a 0 ulong n hm_open
if or not or searchv openv ne argcnt 3
k = write 2 hm_badarg 0 len hm_badarg
hp_stop
ret 2
end
n = argread 2 a 0 len a
if lt n 0
k = write 2 hm_badarg 0 len hm_badarg
hp_stop
ret 2
end
k = enlarge lx_query ulong n
if lt k 0
hp_stop
ret 1
end
for i ulong ulong n
put lx_query i get a i
end
put lx_qn 0 ulong n
if ne ha_init 0
hp_stop
ret 1
end
ha_query
if eq get lx_rn 0 0
hp_stop
ret 1
end
if searchv
k = write 1 lx_rows 0 get lx_rn 0
hp_stop
ret 0
end
put lx_pick 0 0
opened = ha_activate
hp_stop
if eq opened 1
ret 0
end
ret 1
end
if ne ha_init 0
hp_stop
ret 1
end
resultv = lx_main
hp_stop
ret resultv
end

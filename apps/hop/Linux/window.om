fn lx_keyvalue code ulong column ulong to ulong
if or lt code get lx_s 13 gt code get lx_s 14
ret 0
end
if ge column get lx_s 15
ret 0
end
p = mul add mul sub code get lx_s 13 get lx_s 15 column 4
if gt add p 4 len lx_keys
ret 0
end
v = ulong 0
for i ulong 4 bound 4
v = or v shl ulong get lx_keys add p i mul i 8
end
ret v
end
fn lx_append cp ulong to void
n = get lx_qn 0
r = enlarge lx_query add n 4
if lt r 0
lx_bad
end
if lt cp 128
put lx_query n uchar cp
n = add n 1
else
if lt cp 2048
put lx_query n uchar or 192 shr cp 6
put lx_query add n 1 uchar or 128 and cp 63
n = add n 2
else
if lt cp 65536
put lx_query n uchar or 224 shr cp 12
put lx_query add n 1 uchar or 128 and shr cp 6 63
put lx_query add n 2 uchar or 128 and cp 63
n = add n 3
else
put lx_query n uchar or 240 shr cp 18
put lx_query add n 1 uchar or 128 and shr cp 12 63
put lx_query add n 2 uchar or 128 and shr cp 6 63
put lx_query add n 3 uchar or 128 and cp 63
n = add n 4
end
end
end
put lx_qn 0 n
end
fn lx_changed to void
put lx_pick 0 0
put lx_s 20 0
hop_query
lx_draw
end
fn lx_key to void
code = ulong get lx_buf 1
state = lx_u16 28
key = lx_keyvalue code 0
if ne and state 1 0
other = lx_keyvalue code 1
if ne other 0
key = other
end
end
if ne and state 2 0
if and ge key 97 le key 122
key = sub key 32
else
if and ge key 65 le key 90
key = add key 32
end
end
end
if eq key 65307
put lx_s 18 1
ret
end
if eq key 65293
if eq hop_activate 1
put lx_s 18 1
else
lx_draw
end
ret
end
if eq key 65362
if gt get lx_pick 0 0
put lx_pick 0 sub get lx_pick 0 1
end
lx_draw
ret
end
if eq key 65364
if lt add get lx_pick 0 1 get lx_s 19
put lx_pick 0 add get lx_pick 0 1
end
lx_draw
ret
end
if eq key 65288
n = get lx_qn 0
if gt n 0
n = sub n 1
while gt n 0 bound 9223372036854775807
if ne and get lx_query n 192 128
break
end
n = sub n 1
end
put lx_qn 0 n
lx_changed
end
ret
end
if eq key 65289
ret
end
if ne and state 4 0
if or eq key 117 eq key 85
put lx_qn 0 0
lx_changed
end
ret
end
if ne and state 72 0
ret
end
if and ge key 32 lt key 256
lx_append key
lx_changed
ret
end
if and ge key 16777248 le key 17891327
cp = sub key 16777216
if or lt cp 55296 gt cp 57343
lx_append cp
lx_changed
end
end
end
fn lx_click to void
button = get lx_buf 1
if eq button 4
if gt get lx_pick 0 0
put lx_pick 0 sub get lx_pick 0 1
end
lx_draw
ret
end
if eq button 5
if lt add get lx_pick 0 1 get lx_s 19
put lx_pick 0 add get lx_pick 0 1
end
lx_draw
ret
end
if ne button 1
ret
end
y = lx_u16 26
if lt y 108
ret
end
offset = div sub y 108 30
if ge offset div sub get lx_s 12 150 30
ret
end
row = add get lx_s 20 offset
if ge row get lx_s 19
ret
end
put lx_pick 0 row
if eq hop_activate 1
put lx_s 18 1
else
lx_draw
end
end
fn lx_main to int
if ne lx_setup 0
ret 1
end
lx_makewin
lx_changed
while eq get lx_s 18 0 bound 9223372036854775807
lx_read 0 32
kind = and get lx_buf 0 127
if eq kind 0
lx_bad
end
if eq kind 1
lx_read 32 mul lx_u32 4 4
end
if eq kind 2
lx_key
end
if eq kind 4
lx_click
end
if eq kind 12
lx_draw
end
if eq kind 17
put lx_s 18 1
end
if eq kind 22
w = lx_u16 20
h = lx_u16 22
if and ge w 200 ge h 200
put lx_s 11 w
put lx_s 12 h
lx_draw
end
end
if eq kind 33
if eq lx_u32 8 get lx_s 9
if eq lx_u32 12 get lx_s 10
put lx_s 18 1
end
end
end
end
k = fclose int get lx_fd 0
ret 0
end

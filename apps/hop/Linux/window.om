om2
note Hop Linux desktop boundary. X11 requests are emitted directly from Omega; no UI host library.
note X Consortium X11 protocol release 7.7, chapters 8/9/11 and Appendix B.
note X11 core fonts render Latin-1. Unicode input is retained as UTF-8; unrenderable glyphs show ?. Native Wayland is not implied.
note Color names below map to aienos-brand/reference/tokens.json dark theme. No display polling service is installed.
const lx_bg ulong 0x0a0a0f
const lx_card ulong 0x14141f
const lx_ink ulong 0xffffff
const lx_accent ulong 0x2563eb
const lx_muted ulong 0x88888b
global lx_query uchar *
global lx_rows uchar *
global lx_qn ulong 1
global lx_rn ulong 1
global lx_pick ulong 1
global lx_fd long 1
global lx_s ulong 32
global lx_buf uchar *
global lx_auth uchar *
global lx_keys uchar *
global lx_host uchar *
global lx_hn ulong 2
global lx_req uchar 512
global lx_env uchar 4096
global lx_path uchar 4096
global lx_addr uchar 110
global lx_piece uchar 256
text lx_display "DISPLAY="
text lx_xauth "XAUTHORITY="
text lx_home "HOME="
text lx_local "/tmp/.X11-unix/X"
text lx_dotauth "/.Xauthority"
text lx_cookie "MIT-MAGIC-COOKIE-1"
text lx_hostname "/proc/sys/kernel/hostname"
text lx_name "Hop"
text lx_font "fixed"
text lx_wmp "WM_PROTOCOLS"
text lx_wmd "WM_DELETE_WINDOW"
text lx_hint "Type to find an app, a file, or ask a question"
text lx_help "Up / Down choose   Enter opens   Escape closes"
text lx_errdisp "Hop: open it from a Linux desktop (DISPLAY is missing or is not a local X11 display).\n"
text lx_errsock "Hop: cannot connect to the desktop display.\n"
text lx_errauth "Hop: the desktop refused its X11 login. Check DISPLAY and XAUTHORITY.\n"
text lx_errwire "Hop: the desktop connection ended or returned an invalid response.\n"
text lx_errmem "Hop: the system could not allocate memory for the desktop.\n"

fn lx_bad to void
k = write 2 lx_errwire 0 len lx_errwire
exit 1
end
fn lx_grow n ulong to void
r = enlarge lx_buf n
if lt r 0
k = write 2 lx_errmem 0 len lx_errmem
exit 1
end
end
fn lx_u16 o ulong to ulong
ret or ulong get lx_buf o shl ulong get lx_buf add o 1 8
end
fn lx_u32 o ulong to ulong
ret or lx_u16 o shl lx_u16 add o 2 16
end
fn lx_a16 o ulong to ulong
ret or shl ulong get lx_auth o 8 ulong get lx_auth add o 1
end
fn lx_p16 o ulong v ulong to void
put lx_req o uchar and v 255
put lx_req add o 1 uchar and shr v 8 255
end
fn lx_p32 o ulong v ulong to void
lx_p16 o v
lx_p16 add o 2 shr v 16
end
fn lx_request op uchar n ulong to void
for i ulong n bound 512
put lx_req i 0
end
put lx_req 0 op
lx_p16 2 div n 4
end
fn lx_send n ulong to void
p = ulong 0
while lt p n bound 9223372036854775807
k = send int get lx_fd 0 lx_req p sub n p 0
if eq k -4
continue
end
if le k 0
lx_bad
end
p = add p ulong k
end
end
fn lx_read off ulong n ulong to void
lx_grow add off n
p = ulong 0
while lt p n bound 9223372036854775807
k = read int get lx_fd 0 lx_buf add off p sub n p
if eq k -4
continue
end
if le k 0
lx_bad
end
p = add p ulong k
end
end
fn lx_reply to void
while true bound 9223372036854775807
lx_read 0 32
kind = and get lx_buf 0 127
if eq kind 0
lx_bad
end
if eq kind 1
n = mul lx_u32 4 4
lx_read 32 n
ret
end
end
end
fn lx_envget key view uchar * to ulong
for i ulong ulong envcnt bound 9223372036854775807
n = envread i lx_env 0 len lx_env
if ge n long len key
ok = true
for j ulong len key bound 4096
if ne get key j get lx_env j
ok = false
end
end
if ok
count = sub ulong n len key
for j ulong count bound 4096
put lx_path j get lx_env add len key j
end
ret count
end
end
end
ret 0
end
fn lx_number n ulong to ulong
v = ulong 0
i = ulong 0
if and ge n 5 eq get lx_path 0 117
note unix: and unix/: are local display spellings
if and eq get lx_path 1 110 eq get lx_path 2 105
if eq get lx_path 3 120
i = 4
if eq get lx_path 4 47
i = 5
end
end
end
end
if ge i n
ret 0
end
if ne get lx_path i 58
ret 0
end
i = add i 1
start = i
while lt i n bound 4096
c = get lx_path i
if eq c 46
break
end
if or lt c 48 gt c 57
ret 0
end
if gt v 999999
ret 0
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
if eq start i
ret 0
end
put lx_s 24 v
put lx_s 25 sub i start
for j ulong sub i start bound 4096
put lx_piece j get lx_path add start j
end
screen = ulong 0
if lt i n
i = add i 1
if eq i n
ret 0
end
while lt i n bound 4096
c = get lx_path i
if or lt c 48 gt c 57
ret 0
end
if gt screen 999999
ret 0
end
screen = add mul screen 10 ulong sub c 48
i = add i 1
end
end
put lx_s 26 screen
ret 1
end
note FamilyLocal credentials name this machine, not merely a display number. The kernel hostname is read once per authority scan.
note FamilyWild explicitly bypasses the address match, as before; display and authentication-scheme checks remain in force.
fn lx_loadhost to void
put lx_hn 0 0
put lx_hn 1 0
fd = fopen lx_hostname 0 len lx_hostname 0 0
if lt fd 0
ret
end
used = ulong 0
while true bound 9223372036854775807
r = enlarge lx_host add used 256
if lt r 0
k = fclose int fd
ret
end
k = read int fd lx_host used 256
if eq k -4
continue
end
if lt k 0
k = fclose int fd
ret
end
if eq k 0
break
end
used = add used ulong k
end
k = fclose int fd
note proc appends exactly one line feed; remove that delimiter, preserving any line feed in the hostname itself.
if gt used 0
if eq get lx_host sub used 1 10
used = sub used 1
end
end
put lx_hn 0 used
put lx_hn 1 1
end
fn lx_hostmatch offset ulong size ulong to bool
if eq get lx_hn 1 0
ret false
end
if ne size get lx_hn 0
ret false
end
for i ulong size bound 65536
if ne get lx_auth add offset i get lx_host i
ret false
end
end
ret true
end
fn lx_findauth n ulong to ulong
lx_loadhost
p = ulong 0
while lt p n bound 9223372036854775807
if gt add p 2 n
ret 0
end
family = lx_a16 p
p = add p 2
ok = or eq family 256 eq family 65535
for fld ulong 4 bound 4
if gt add p 2 n
ret 0
end
size = lx_a16 p
p = add p 2
if gt add p size n
ret 0
end
if and eq fld 0 eq family 256
if not lx_hostmatch p size
ok = false
end
end
if eq fld 1
if ne size get lx_s 25
ok = false
else
for j ulong size bound 65536
if ne get lx_auth add p j get lx_piece j
ok = false
end
end
end
end
if eq fld 2
if ne size len lx_cookie
ok = false
else
for j ulong size bound 65536
if ne get lx_auth add p j get lx_cookie j
ok = false
end
end
end
end
if eq fld 3
if and ok eq size 16
put lx_s 27 p
ret size
end
end
p = add p size
end
end
ret 0
end
fn lx_authload to ulong
n = lx_envget lx_xauth
if eq n 0
n = lx_envget lx_home
if eq n 0
ret 0
end
if gt add n len lx_dotauth 4095
ret 0
end
for i ulong len lx_dotauth bound 32
put lx_path add n i get lx_dotauth i
end
n = add n len lx_dotauth
end
fd = fopen lx_path 0 n 0 0
if lt fd 0
ret 0
end
used = ulong 0
while true bound 9223372036854775807
r = enlarge lx_auth add used 4096
if lt r 0
k = fclose int fd
ret 0
end
k = read int fd lx_auth used 4096
if eq k -4
continue
end
if le k 0
break
end
used = add used ulong k
end
k = fclose int fd
ret lx_findauth used
end
fn lx_setup to int
n = lx_envget lx_display
if eq n 0
k = write 2 lx_errdisp 0 len lx_errdisp
ret 1
end
if eq lx_number n 0
k = write 2 lx_errdisp 0 len lx_errdisp
ret 1
end
for i ulong len lx_local bound 32
put lx_addr add i 2 get lx_local i
end
for i ulong get lx_s 25 bound 16
put lx_addr add add 2 len lx_local i get lx_piece i
end
put lx_addr 0 1
n = add add 3 len lx_local get lx_s 25
fd = socknew 1 1 0
if lt fd 0
k = write 2 lx_errsock 0 len lx_errsock
ret 1
end
put lx_fd 0 fd
r = connect int fd lx_addr 0 n
if lt r 0
k = write 2 lx_errsock 0 len lx_errsock
k = fclose int fd
ret 1
end
an = lx_authload
lx_request 108 48
lx_p16 2 11
lx_p16 4 0
if gt an 0
lx_p16 6 len lx_cookie
lx_p16 8 an
for i ulong len lx_cookie bound 32
put lx_req add 12 i get lx_cookie i
end
for i ulong an bound 32
put lx_req add 32 i get lx_auth add get lx_s 27 i
end
lx_send 48
else
lx_send 12
end
lx_read 0 8
if ne get lx_buf 0 1
k = write 2 lx_errauth 0 len lx_errauth
k = fclose int fd
ret 1
end
n = mul lx_u16 6 4
lx_read 0 n
ret lx_screen n
end
fn lx_screen n ulong to int
if lt n 32
lx_bad
end
put lx_s 7 lx_u32 4
put lx_s 8 lx_u32 8
put lx_s 13 ulong get lx_buf 26
put lx_s 14 ulong get lx_buf 27
roots = ulong get lx_buf 20
if ge get lx_s 26 roots
lx_bad
end
p = add 32 mul div add lx_u16 16 3 4 4
p = add p mul ulong get lx_buf 21 8
for screen ulong add get lx_s 26 1 bound 65536
if gt add p 40 n
lx_bad
end
if eq screen get lx_s 26
put lx_s 4 lx_u32 p
put lx_s 16 lx_u16 add p 20
put lx_s 17 lx_u16 add p 22
ret 0
end
depths = ulong get lx_buf add p 39
p = add p 40
for j ulong depths bound 256
if gt add p 8 n
lx_bad
end
p = add add p 8 mul lx_u16 add p 2 24
end
end
ret 1
end
fn lx_id k ulong to ulong
v = get lx_s 7
mask = get lx_s 8
bit = ulong 1
for i ulong 32 bound 32
if ne and mask shl ulong 1 i 0
if ne and k bit 0
v = or v shl ulong 1 i
end
bit = shl bit 1
end
end
ret v
end
fn lx_atom name view uchar * to ulong
n = mul div add add 8 len name 3 4 4
lx_request 16 n
lx_p16 4 len name
for i ulong len name bound 256
put lx_req add 8 i get name i
end
lx_send n
lx_reply
ret lx_u32 8
end
fn lx_property atom ulong ty ulong fmt uchar data ulong n ulong to void
lx_request 18 28
lx_p32 4 get lx_s 1
lx_p32 8 atom
lx_p32 12 ty
put lx_req 16 fmt
lx_p32 20 n
lx_p32 24 data
lx_send 28
end
fn lx_color fg ulong bg ulong to void
lx_request 56 20
lx_p32 4 get lx_s 2
lx_p32 8 12
lx_p32 12 fg
lx_p32 16 bg
lx_send 20
end
fn lx_fill x ulong y ulong w ulong h ulong color ulong to void
lx_color color lx_bg
lx_request 70 20
lx_p32 4 get lx_s 1
lx_p32 8 get lx_s 2
lx_p16 12 x
lx_p16 14 y
lx_p16 16 w
lx_p16 18 h
lx_send 20
end
fn lx_text x ulong y ulong count ulong to void
note ImageText8 has an 8-bit glyph count. Split long strings in caller at the visible edge.
n = mul div add add 16 count 3 4 4
lx_request 76 n
put lx_req 1 uchar count
lx_p32 4 get lx_s 1
lx_p32 8 get lx_s 2
lx_p16 12 x
lx_p16 14 y
for i ulong count bound 256
put lx_req add 16 i get lx_piece i
end
lx_send n
end
fn lx_label textv view uchar * x ulong y ulong to void
n = len textv
if gt n 100
n = 100
end
for i ulong n bound 256
put lx_piece i get textv i
end
lx_text x y n
end
fn lx_querytext to void
n = get lx_qn 0
start = ulong 0
if gt n 90
start = sub n 90
while lt start n bound 9223372036854775807
c = get lx_query start
if ne and c 192 128
break
end
start = add start 1
end
end
count = ulong 0
i = start
while and lt i n lt count 100 bound 9223372036854775807
c = get lx_query i
if lt c 128
put lx_piece count c
count = add count 1
else
if ne and c 192 128
put lx_piece count 63
count = add count 1
end
end
i = add i 1
end
lx_text 24 78 count
end
fn lx_rowtext start ulong last ulong y ulong to void
count = ulong 0
i = start
while and lt i last lt count 92 bound 9223372036854775807
c = get lx_rows i
if lt c 128
if ge c 32
put lx_piece count c
count = add count 1
end
else
if ne and c 192 128
put lx_piece count 63
count = add count 1
end
end
i = add i 1
end
lx_text 32 y count
end
fn lx_rowcount to ulong
n = get lx_rn 0
count = ulong 0
for i ulong n bound 9223372036854775807
if eq get lx_rows i 10
count = add count 1
end
end
if gt n 0
if ne get lx_rows sub n 1 10
count = add count 1
end
end
ret count
end
fn lx_draw to void
put lx_s 19 lx_rowcount
if ge get lx_pick 0 get lx_s 19
put lx_pick 0 0
end
visible = div sub get lx_s 12 150 30
if lt get lx_pick 0 get lx_s 20
put lx_s 20 get lx_pick 0
end
if ge get lx_pick 0 add get lx_s 20 visible
put lx_s 20 add sub get lx_pick 0 visible 1
end
lx_request 61 16
lx_p32 4 get lx_s 1
lx_send 16
lx_color lx_ink lx_bg
lx_label lx_name 24 32
lx_color lx_muted lx_bg
if eq get lx_qn 0 0
lx_label lx_hint 24 78
else
lx_color lx_ink lx_bg
lx_querytext
end
lx_fill 24 96 sub get lx_s 11 48 1 lx_card
start = ulong 0
row = ulong 0
n = get lx_rn 0
i = ulong 0
while le i n bound 9223372036854775807
last = eq i n
if lt i n
last = eq get lx_rows i 10
end
if last
if and ge row get lx_s 20 lt row add get lx_s 20 visible
if gt i start
y = add 126 mul sub row get lx_s 20 30
if eq row get lx_pick 0
lx_fill 24 sub y 18 sub get lx_s 11 48 28 lx_accent
lx_color lx_ink lx_accent
else
lx_color lx_ink lx_bg
end
lx_rowtext start i y
end
end
row = add row 1
start = add i 1
end
i = add i 1
end
lx_color lx_muted lx_bg
lx_label lx_help 24 sub get lx_s 12 20
end
fn lx_makewin to void

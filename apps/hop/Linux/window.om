end
lx_send 20
lx_request 55 28
lx_p32 4 get lx_s 2
lx_p32 8 get lx_s 1
lx_p32 12 16396
lx_p32 16 lx_ink
lx_p32 20 lx_bg
lx_p32 24 get lx_s 3
lx_send 28
lx_request 101 8
put lx_req 4 uchar get lx_s 13
put lx_req 5 uchar add sub get lx_s 14 get lx_s 13 1
lx_send 8
lx_reply
put lx_s 15 ulong get lx_buf 1
n = mul lx_u32 4 4
r = enlarge lx_keys n
if lt r 0

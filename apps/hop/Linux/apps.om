note Linux application discovery and launch. SPDX-License-Identifier: Apache-2.0
note Platform contracts: freedesktop Desktop Entry 1.5 and XDG Base Directory 0.8.
note gio owns Desktop Entry Exec field codes, Terminal and D-Bus activation; build records its exact version.
note env preserves the desktop session environment without shell evaluation; build records its exact version.
note Omega successor: native Desktop Entry Exec expansion and D-Bus activation; neither is claimed here.
note PATH_MAX buffer is Linux pathname syscall boundary. getdents64 record length is a u16 wire field.
note Tables and input lines grow with input. Executable packed-list boundaries are compiler contracts,
note checked before exec: 65536 bytes and 1024 records. No environment is silently discarded.
global ha_path uchar 4096
global ha_read uchar 4096
global ha_dent uchar 65536
global ha_env uchar 131072
global ha_exec uchar 65536
global ha_wait uchar 4
global ha_stat uchar 128
global ha_line uchar *
global ha_text uchar *
global ha_meta ulong *
global ha_dirs uchar *
global ha_dmeta ulong *
global ha_hits ulong *
global ha_scores ulong *
global ha_n ulong 1
global ha_tn ulong 1
global ha_dn ulong 1
global ha_db ulong 1
global ha_ln ulong 1
global ha_pn ulong 1
global ha_state ulong 8
global ha_hn ulong 1
text ha_home "HOME="
text ha_data "XDG_DATA_HOME="
text ha_xdirs "XDG_DATA_DIRS="
text ha_local "/.local/share"
text ha_apps "/applications"
text ha_def "/usr/local/share:/usr/share"
text ha_ext ".desktop"
text ha_group "[Desktop Entry]"
text ha_name "Name"
text ha_type "Type"
text ha_hidden "Hidden"
text ha_nodisp "NoDisplay"
text ha_cmd "Exec"
text ha_dbus "DBusActivatable"
text ha_true "true"
text ha_app "Application"
text ha_only "OnlyShowIn"
text ha_not "NotShowIn"
text ha_try "TryExec"
text ha_session "XDG_CURRENT_DESKTOP="
text ha_pathenv "PATH="
text ha_defpath "/usr/local/bin:/usr/bin:/bin"
text ha_envbin "/usr/bin/env"
text ha_options "--"
text ha_gio "/usr/bin/gio"
text ha_launch "launch"
text ha_errmem "Hop: Linux application list could not grow.\n"
text ha_errpath "Hop: application pathname exceeds the Linux pathname boundary.\n"
text ha_errexec "Hop: application launch exceeds the compiler argument packet boundary.\n"
text ha_errlaunch "Hop: the desktop could not launch that application.\n"
text ha_errenv "Hop: an environment entry could not be read in full.\n"

fn ha_die textv view uchar * to void
x = write 2 textv 0 len textv
exit 1
end

fn ha_reserve need ulong which ulong to void
r = long 0
if eq which 0
if gt need len ha_text
r = enlarge ha_text add need add len ha_text 4096
end
end
if eq which 1
if gt need len ha_meta
r = enlarge ha_meta add need add len ha_meta 64
end
end
if eq which 2
if gt need len ha_dirs
r = enlarge ha_dirs add need add len ha_dirs 4096
end
end
if eq which 3
if gt need len ha_dmeta
r = enlarge ha_dmeta add need add len ha_dmeta 64
end
end
if eq which 4
if gt need len ha_line
r = enlarge ha_line add need add len ha_line 256
end
end
if eq which 5
if gt need len ha_hits
r = enlarge ha_hits add need add len ha_hits 64
if ge r 0
r = enlarge ha_scores len ha_hits
end
end
end
if lt r 0
ha_die ha_errmem
end
end

fn ha_envkey key view uchar * to bool
for j ulong len key bound 9223372036854775807
if ne get ha_env j get key j
ret false
end
end
ret true
end

fn ha_envget key view uchar * to long
for i ulong ulong envcnt bound 9223372036854775807
n = envread i ha_env 0 len ha_env
if lt n 0
ha_die ha_errenv
end
if ge ulong n len key
if ha_envkey key
amount = sub ulong n len key
ha_envshift len key amount
ret long amount
end
end
end
ret -1
end

fn ha_envshift start ulong size ulong to void
for j ulong size bound 9223372036854775807
c = get ha_env add j start
put ha_env j c
end
end

fn ha_setpath src view uchar * to void
if ge len src len ha_path
ha_die ha_errpath
end
for i ulong len src bound 9223372036854775807
put ha_path i get src i
end
put ha_pn 0 len src
end

fn ha_pathadd src view uchar * to void
p = get ha_pn 0
if ge add p len src len ha_path
ha_die ha_errpath
end
for i ulong len src bound 9223372036854775807
put ha_path add p i get src i
end
put ha_pn 0 add p len src
end

fn ha_envpath n ulong to void
if ge n len ha_path
ha_die ha_errpath
end
for i ulong n bound 9223372036854775807
put ha_path i get ha_env i
end
put ha_pn 0 n
end

fn ha_queue root ulong to void
n = get ha_pn 0
p = get ha_db 0
k = get ha_dn 0
ha_reserve add p n 2
ha_reserve mul add k 1 3 3
for i ulong n bound 9223372036854775807
put ha_dirs add p i get ha_path i
end
put ha_dmeta mul k 3 p
put ha_dmeta add mul k 3 1 n
put ha_dmeta add mul k 3 2 root
put ha_dn 0 add k 1
put ha_db 0 add p n
end

fn ha_lower c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn ha_lineeq start ulong size ulong value view uchar * to bool
if ne size len value
ret false
end
for i ulong size bound 9223372036854775807
if ne get ha_line add start i get value i
ret false
end
end
ret true
end

fn ha_recordline to void
n = get ha_ln 0
if eq n 0
ret
end
if eq get ha_line sub n 1 13
n = sub n 1
end
if eq n 0
ret
end
if eq get ha_line 0 91
active = ha_lineeq 0 n ha_group
put ha_state 0 0
if active
put ha_state 0 1
end
ret
end
if eq get ha_state 0 0
ret
end
k = ulong 0
while lt k n bound 9223372036854775807
if eq get ha_line k 61
break
end
k = add k 1
end
if eq k n
ret
end
v = add k 1
vn = sub n v
if ha_lineeq 0 k ha_name
p = get ha_tn 0
ha_reserve add p vn 0
j = ulong 0
while lt j vn bound 9223372036854775807
c = get ha_line add v j
if and eq c 92 lt add j 1 vn
j = add j 1
c = get ha_line add v j
if or or eq c 115 eq c 110 or eq c 114 eq c 116
c = 32
end
end
if or lt c 32 eq c 127
c = 32
end
put ha_text p c
p = add p 1
j = add j 1
end
put ha_state 1 get ha_tn 0
put ha_state 2 sub p get ha_tn 0
put ha_tn 0 p
end
if ha_lineeq 0 k ha_type
put ha_state 3 0
if ha_lineeq v vn ha_app
put ha_state 3 1
end
end
if or ha_lineeq 0 k ha_hidden ha_lineeq 0 k ha_nodisp
if ha_lineeq v vn ha_true
put ha_state 4 1
end
end
if ha_lineeq 0 k ha_cmd
if gt vn 0
put ha_state 5 1
end
end
if ha_lineeq 0 k ha_dbus
if ha_lineeq v vn ha_true
put ha_state 5 1
end
end
if ha_lineeq 0 k ha_only
if not ha_insession v vn
put ha_state 6 1
end
end
if ha_lineeq 0 k ha_not
if ha_insession v vn
put ha_state 6 1
end
end
if ha_lineeq 0 k ha_try
if not ha_tryexec v vn
put ha_state 7 1
end
end
end

fn ha_insession start ulong size ulong to bool
n = ha_envget ha_session
if le n 0
ret false
end
lo = ulong 0
for i ulong add size 1 bound 9223372036854775807
sep = eq i size
if not sep
sep = eq get ha_line add start i 59
end
if sep
if ha_sessionhas add start lo sub i lo ulong n
ret true
end
lo = add i 1
end
end
ret false
end

fn ha_sessionhas start ulong size ulong envsize ulong to bool
if eq size 0
ret false
end
lo = ulong 0
for i ulong add envsize 1 bound 9223372036854775807
sep = eq i envsize
if not sep
sep = eq get ha_env i 58
end
if sep
if eq sub i lo size
if ha_sessioneq start lo size
ret true
end
end
lo = add i 1
end
end
ret false
end

fn ha_sessioneq start ulong envstart ulong size ulong to bool
for j ulong size bound 9223372036854775807
c = get ha_line add start j
if ne c get ha_env add envstart j
ret false
end
end
ret true
end

fn ha_tryexec start ulong size ulong to bool
if eq size 0
ret false
end
slash = false
for i ulong size bound 9223372036854775807
if eq get ha_line add start i 47
slash = true
end
end
if slash
ha_trypath 0 0 start size
ret ha_executable
end
n = ha_envget ha_pathenv
if le n 0
for i ulong len ha_defpath
put ha_env i get ha_defpath i
end
n = long len ha_defpath
end
lo = ulong 0
for i ulong add ulong n 1 bound 9223372036854775807
sep = eq i ulong n
if not sep
sep = eq get ha_env i 58
end
if sep
ha_trypath lo sub i lo start size
if ha_executable
ret true
end
lo = add i 1
end
end
ret false
end

fn ha_trypath envstart ulong envsize ulong start ulong size ulong to void
extra = ulong 0
if gt envsize 0
extra = 1
end
total = add add envsize extra size
if ge total len ha_path
ha_die ha_errpath
end
for i ulong envsize bound 9223372036854775807
c = get ha_env add envstart i
put ha_path i c
end
if gt extra 0
put ha_path envsize 47
end
for i ulong size bound 9223372036854775807
c = get ha_line add start i
put ha_path add add envsize extra i c
end
put ha_pn 0 total
end

fn ha_regular to bool
r = stat ha_path 0 get ha_pn 0 ha_stat 0 len ha_stat
if lt r 0
ret false
end
note asm-generic/stat.h st_mode offset16, bits/stat.h S_IFMT=0170000 and S_IFREG=0100000.
note Decimal conversions: calc:48b0ef104b499352fffecc0c0f52c5a98d33fcc80282357db3f03dd3c6d51c3d
note and calc:ee2ba7a0bf702c139c1496ff5510397b56b897779b6783b8158f5f5c15a2511f.
mode = add ulong get ha_stat 16 shl ulong get ha_stat 17 8
ret eq and mode 61440 32768
end

fn ha_executable to bool
if not ha_regular
ret false
end
ret eq faccess ha_path 0 get ha_pn 0 1 0
end

fn ha_readentry index ulong to void
for i ulong 8
put ha_state i 0
end
if not ha_regular
ret
end
fd = int fopen ha_path 0 get ha_pn 0 0 0
if lt fd 0
ret
end
put ha_ln 0 0
done = false
while not done bound 9223372036854775807
n = read fd ha_read 0 len ha_read
if lt n 0
x = fclose fd
ret
end
if eq n 0
done = true
ha_recordline
else
for i ulong ulong n bound 9223372036854775807
c = get ha_read i
if eq c 10
ha_recordline
put ha_ln 0 0
else
j = get ha_ln 0
ha_reserve add j 1 4
put ha_line j c
put ha_ln 0 add j 1
end
end
end
end
x = fclose fd
if and eq get ha_state 3 1 eq get ha_state 4 0
if eq get ha_state 5 1
if and eq get ha_state 6 0 eq get ha_state 7 0
put ha_meta add mul index 6 4 get ha_state 1
put ha_meta add mul index 6 5 get ha_state 2
end
end
end
end

fn ha_addentry root ulong to void
n = get ha_pn 0
start = add root 1
if le n start
ret
end
idn = sub n start
for i ulong get ha_n 0 bound 9223372036854775807
m = mul i 6
if eq get ha_meta add m 1 idn
if ha_sameid start idn get ha_meta m
ret
end
end
end
k = get ha_n 0
ha_reserve mul add k 1 6 1
p = get ha_tn 0
ha_reserve add add p idn n 0
put ha_meta mul k 6 p
put ha_meta add mul k 6 1 idn
for i ulong idn bound 9223372036854775807
c = get ha_path add start i
if eq c 47
c = 45
end
put ha_text add p i c
end
p = add p idn
put ha_meta add mul k 6 2 p
put ha_meta add mul k 6 3 n
put ha_meta add mul k 6 4 0
put ha_meta add mul k 6 5 0
for i ulong n bound 9223372036854775807
put ha_text add p i get ha_path i
end
put ha_tn 0 add p n
put ha_n 0 add k 1
ha_readentry k
end

fn ha_sameid start ulong size ulong offset ulong to bool
for j ulong size bound 9223372036854775807
c = get ha_path add start j
if eq c 47
c = 45
end
if ne c get ha_text add offset j
ret false
end
end
ret true
end

fn ha_direntry pos ulong root ulong base ulong to void
sz = ulong 0
while ne get ha_dent add add pos 19 sz 0 bound 65536
sz = add sz 1
end
if eq sz 0
ret
end
if eq get ha_dent add pos 19 46
if eq sz 1
ret
end
if eq sz 2
if eq get ha_dent add pos 20 46
ret
end
end
end
if ge add add base 1 sz len ha_path
ha_die ha_errpath
end
put ha_path base 47
for i ulong sz bound 9223372036854775807
put ha_path add add base 1 i get ha_dent add add pos 19 i
end
put ha_pn 0 add add base 1 sz
typ = get ha_dent add pos 18
if eq typ 4
ha_queue root
ret
end
if lt sz len ha_ext
ret
end
for i ulong len ha_ext
if ne get ha_dent add add pos 19 add sub sz len ha_ext i get ha_ext i
ret
end
end
ha_addentry root
end

fn ha_scanroot to void
if eq get ha_pn 0 0
ret
end
if ne get ha_path 0 47
ret
end
ha_pathadd ha_apps
put ha_dn 0 0
put ha_db 0 0
ha_queue get ha_pn 0
di = ulong 0
while lt di get ha_dn 0 bound 9223372036854775807
m = mul di 3
base = get ha_dmeta add m 1
root = get ha_dmeta add m 2
off = get ha_dmeta m
ha_dirpath off base
put ha_pn 0 base
fd = int fopen ha_path 0 base 0 0
if ge fd 0
done = false
while not done bound 9223372036854775807
n = getdnts fd ha_dent 0 len ha_dent
if le n 0
done = true
else
ha_parseents ulong n root base off
end
end
x = fclose fd
end
di = add di 1
end
end

fn ha_parseents size ulong root ulong base ulong offset ulong to void
pos = ulong 0
while lt pos size bound 65536
low = ulong get ha_dent add pos 16
high = ulong get ha_dent add pos 17
rec = add low shl high 8
if or lt rec 20 gt add pos rec size
ret
end
ha_dirpath offset base
ha_direntry pos root base
pos = add pos rec
end
end

fn ha_dirpath offset ulong size ulong to void
for j ulong size bound 9223372036854775807
c = get ha_dirs add offset j
put ha_path j c
end
end

fn ha_init to int
put ha_n 0 0
put ha_tn 0 0
n = ha_envget ha_data
valid = false
if gt n 0
valid = eq get ha_env 0 47
end
if valid
ha_envpath ulong n
else
n = ha_envget ha_home
if gt n 0
ha_envpath ulong n
ha_pathadd ha_local
else
put ha_pn 0 0
end
end
ha_scanroot
n = ha_envget ha_xdirs
if le n 0
for i ulong len ha_def
put ha_env i get ha_def i
end
n = long len ha_def
end
note Preserve the directory list while each scan reads environment-independent files.
list = new uchar 131072 0
for i ulong ulong n bound 9223372036854775807
put list i get ha_env i
end
lo = ulong 0
for i ulong add ulong n 1 bound 9223372036854775807
sep = eq i ulong n
if not sep
sep = eq get list i 58
end
if sep
size = sub i lo
if gt size 0
ha_scanpart list lo size
end
lo = add i 1
end
end
ret 0
end

fn ha_scanpart list view uchar * start ulong size ulong to void
if ge size len ha_path
ha_die ha_errpath
end
for j ulong size bound 9223372036854775807
c = get list add start j
put ha_path j c
end
put ha_pn 0 size
ha_scanroot
end

fn ha_literal nameoff ulong namesize ulong to bool
qn = get lx_qn 0
if eq qn 0
ret true
end
if gt qn namesize
ret false
end
for i ulong add sub namesize qn 1 bound 9223372036854775807
same = true
for j ulong qn bound 9223372036854775807
if ne ha_lower get lx_query j ha_lower get ha_text add add nameoff i j
same = false
break
end
end
if same
ret true
end
end
ret false
end

fn ha_word c uchar to ulong
v = ulong ha_lower c
alpha = or and ge c 65 le c 90 and ge c 97 le c 122
if or alpha and ge c 48 le c 57
v = or v 4294967296
end
if or eq c 32 and ge c 9 le c 13
v = or v 8589934592
end
ret v
end

fn ha_ascii nameoff ulong namesize ulong to bool
for j ulong get lx_qn 0 bound 9223372036854775807
if ge get lx_query j 128
ret false
end
end
for j ulong namesize bound 9223372036854775807
if ge get ha_text add nameoff j 128
ret false
end
end
ret true
end

fn ha_score nameoff ulong namesize ulong to ulong
qn = get lx_qn 0
if eq qn 0
ret 1
end
note Hop's existing helper wire format permits64 query words and184 name words.
note Longer input and non-ASCII names use full literal matching, never a cut-short fuzzy request.
if or gt qn 64 gt namesize 184
if ha_literal nameoff namesize
ret 1
end
ret 0
end
if not ha_ascii nameoff namesize
if ha_literal nameoff namesize
ret 1
end
ret 0
end
packet = new ulong 256 0
put packet 0 1212568922
put packet 1 1
put packet 2 qn
put packet 3 namesize
for j ulong qn bound 64
put packet add 8 j ha_word get lx_query j
end
for j ulong namesize bound 184
put packet add 72 j ha_word get ha_text add nameoff j
end
ret hp_fuzz packet
end

fn ha_inserthit index ulong score ulong to void
k = get ha_hn 0
ha_reserve add k 1 5
while gt k 0 bound 9223372036854775807
prev = get ha_scores sub k 1
if ge prev score
break
end
old = get ha_hits sub k 1
put ha_hits k old
put ha_scores k prev
k = sub k 1
end
put ha_hits k index
put ha_scores k score
put ha_hn 0 add get ha_hn 0 1
end

fn ha_query to void
put lx_rn 0 0
put ha_hn 0 0
for i ulong get ha_n 0 bound 9223372036854775807
m = mul i 6
n = get ha_meta add m 5
if gt n 0
p = get ha_meta add m 4
score = ha_score p n
if gt score 0
ha_inserthit i score
end
end
end
for j ulong get ha_hn 0 bound 9223372036854775807
ha_addrow get ha_hits j
end
end

fn ha_addrow index ulong to void
m = mul index 6
n = get ha_meta add m 5
p = get ha_meta add m 4
pos = get lx_rn 0
r = enlarge lx_rows add add pos n 1
if lt r 0
ha_die ha_errmem
end
ha_rowcopy pos p n
put lx_rows add pos n 10
put lx_rn 0 add add pos n 1
end

fn ha_rowcopy dest ulong source ulong size ulong to void
for j ulong size bound 9223372036854775807
c = get ha_text add source j
put lx_rows add dest j c
end
end

fn ha_packetrec pos ulong value view uchar * to ulong
if or gt len value 65535 gt add add pos 2 len value len ha_exec
ha_die ha_errexec
end
put ha_exec pos uchar and len value 255
put ha_exec add pos 1 uchar shr len value 8
for j ulong len value bound 9223372036854775807
put ha_exec add add pos 2 j get value j
end
ret add add pos 2 len value
end

fn ha_activate to int
k = get lx_pick 0
if ge k get ha_hn 0
ret 0
end
note env is an external platform wrapper: no shell parses the environment or pathname.
pos = ha_packetrec 2 ha_envbin
pos = ha_packetrec pos ha_options
nc = add ulong envcnt 5
if gt nc 1024
ha_die ha_errexec
end
envbuf = new uchar 131072 0
for i ulong ulong envcnt bound 9223372036854775807
n = envread i envbuf 0 len envbuf
if lt n 0
ha_die ha_errenv
end
pos = ha_packetrec pos part envbuf 0 ulong n
end
pos = ha_packetrec pos ha_gio
pos = ha_packetrec pos ha_launch
index = get ha_hits k
p = get ha_meta add mul index 6 2
n = get ha_meta add mul index 6 3
if ge n len ha_path
ha_die ha_errpath
end
for i ulong n bound 9223372036854775807
put ha_path i get ha_text add p i
end
pos = ha_packetpath pos n
put ha_exec 0 uchar and nc 255
put ha_exec 1 uchar shr nc 8
pid = int fork
if eq pid 0
x = execprog ha_exec 0 pos
x = write 2 ha_errlaunch 0 len ha_errlaunch
exit 1
end
if lt pid 0
x = write 2 ha_errlaunch 0 len ha_errlaunch
ret 0
end
status = waitpid pid ha_wait 0 4 0
if lt status 0
x = write 2 ha_errlaunch 0 len ha_errlaunch
ret 0
end
if ne or get ha_wait 0 get ha_wait 1 0
x = write 2 ha_errlaunch 0 len ha_errlaunch
ret 0
end
ret 1
end

fn ha_packetpath pos ulong size ulong to ulong
if or gt size 65535 gt add add pos 2 size len ha_exec
ha_die ha_errexec
end
put ha_exec pos uchar and size 255
put ha_exec add pos 1 uchar shr size 8
for i ulong size bound 9223372036854775807
c = get ha_path i
put ha_exec add add pos 2 i c
end
ret add add pos 2 size
end

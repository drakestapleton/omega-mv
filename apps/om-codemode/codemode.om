note SPDX-License-Identifier: Apache-2.0
note apps/om-codemode/codemode.om:
note Pure seeded OM-2 sub-millisecond "Code Mode" pure-compute sandbox CLI.
note
note Features:
note   1. Fail-closed streaming FIPS 180-4 SHA-256 verification of the pinned `omc` binary
note      before compiling or executing anything (exit 69 on any pin mismatch).
note   2. Compiles untrusted `.om` snippets under bounded prlimit + timeout; preserves exact
note      `omc` error codes (1..30) on malformed source and never executes refused output.
note   3. Runs compiled static ELFs under Omega's kernel-enforced `execpure` sandbox
note      (Landlock ABI-3 + seccomp-BPF stdio-only + 0 children + 128 MiB AS + wall timeout).
note   4. Redacts sensitive credential patterns (`Bearer `, `sk-`, `ghp_`, `AKIA`, `xoxb-`)
note      from both captured stdout and stderr before emitting deterministic receipts.
note   5. Embeds the verified 27-insn (216-byte) AUDIT_ARCH_X86_64 (0xc000003e) stdio-only
note      seccomp-BPF policy spec + cBPF VM verifier for x86linux cross-target readiness.
om2

const CM_MAX_SRC ulong 65536
const CM_MAX_CAP ulong 32768
const CM_MAX_RED ulong 65536
const CM_MAX_OUTBUF ulong 131072
const CM_DEF_CTMO_MS ulong 4000
const CM_DEF_RTMO_MS ulong 1000
const CM_BPF_INSNS ulong 27

const CM_BPF_LD_W_ABS ulong 32
const CM_BPF_JMP_JEQ_K ulong 21
const CM_BPF_RET_K ulong 6
const CM_AUDIT_X64 ulong 3221225534
const CM_AUDIT_A64 ulong 3221225655
const CM_SECCOMP_ALLOW ulong 2147418112
const CM_SECCOMP_KILL ulong 2147483648

note Status table g_st[0..15]:
note 0=comp_rc, 1=comp_us, 2=bin_bytes, 3=run_rc, 4=run_us, 5=redacted_cnt,
note 6=ctmo_ms, 7=rtmo_ms, 8=has_omc, 9=has_pin, 10=has_snip, 11=seq,
note 12=rout_trunc, 13=rerr_trunc, 14=pin_from_file, 15=snip_stdin
global g_st ulong 16


note Live omc-recompiled Source Mutant 2 (weaken W^X RWX guard) -> KILLED!
if not gm_build_and_kill_mut 2 gm_s_m2_om gm_s_m2_bin
ret gm_fail 126
end
gm_add_mut

gm_wrt gm_l_t8
gm_num get gm_cli 0
gm_wrt gm_l_t8b
gm_num 2
gm_wrt gm_m_nl
gm_add_chk 6
ret 0

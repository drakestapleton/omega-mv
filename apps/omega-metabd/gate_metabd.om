ret r
end
r = gm_t6_neg_controls
if ne r 0
ret r
end
r = gm_t7_mutation_kills
if ne r 0
ret r
end

if ge argcnt 5
b1 = argread 2 gm_bin 0 500
b2 = argread 3 gm_omc 0 500
b3 = argread 4 gm_rep 0 500
if and gt b1 0 and gt b2 0 gt b3 0
put gm_binl 0 ulong b1
put gm_omcl 0 ulong b2
put gm_repl 0 ulong b3
r = gm_t8_cli_and_mutants
if ne r 0
ret r
end
end
end

gm_wrt gm_m_pass

fn main to int
ar_init
mb_init
put gm_chk 0 0
put gm_neg 0 0
put gm_mut 0 0
put gm_cli 0 0

if ge argcnt 2
rn = argread 1 gm_dir 0 440
if gt rn 0
put gm_dirl 0 ulong rn
end
end
if eq get gm_dirl 0 0
n = len gm_def_dir
for i ulong n bound 440
put gm_dir i get gm_def_dir i
end
put gm_dirl 0 n
end
gm_set_wx_dir
gm_wrt gm_m_hdr

r = gm_t1_profile_ring
if ne r 0
ret r
end
r = gm_t2_affine_pe
if ne r 0
ret r
end
r = gm_t3_branch_diamond
if ne r 0
ret r
end
r = gm_t4_sparse_loop
if ne r 0
ret r

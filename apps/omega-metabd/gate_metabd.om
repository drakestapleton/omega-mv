end
put gm_cli 0 add get gm_cli 0 1

note CLI 3: omega-metabd gate --dir <sub_dir> -> exit 0
ap = gm_av_reset
ap = gm_av_add_gbuf ap 0 get gm_binl 0
ap = gm_av_add ap gm_a_gate len gm_a_gate
ap = gm_av_add ap gm_a_dir len gm_a_dir
ap = gm_av_add_gbuf ap 2 sd
if ne gm_run_av ap neg int 1 int dn 0
c = fclose int dn
ret gm_fail 123
end
put gm_cli 0 add get gm_cli 0 1

note CLI 4 (negative control): omega-metabd --rwx -> MUST exit 2 (REFUSED)!
ap = gm_av_reset
ap = gm_av_add_gbuf ap 0 get gm_binl 0
ap = gm_av_add ap gm_a_rwx len gm_a_rwx
if eq gm_run_av ap neg int 1 int dn 0
c = fclose int dn
ret gm_fail 124
end
put gm_cli 0 add get gm_cli 0 1
gm_add_neg
c = fclose int dn

note Live omc-recompiled Source Mutant 1 (weaken proof gate to allow proofMask==5) -> KILLED!
if not gm_build_and_kill_mut 1 gm_s_m1_om gm_s_m1_bin
ret gm_fail 125
end

note SPDX-License-Identifier: Apache-2.0
note apps/omega-metabd/metabd_main.om: Stage 4 (Pillar 1) Living Proof-Carrying Self-Specialization
note Daemon & CLI (`omega-metabd`).
note Pure seeded OM-2 (zero C/Python/Rust, strict W^X, zero UEFI/SPI/GPU access).
note
note Compose & build with pinned seeded omc (SHA-256 85b84c6d...):
note   cat seed/ng/src/ir.om seed/ng/sha256.om seed/ng/target/target_desc.om \
note       seed/ng/target/isel.om seed/ng/target/sm121_pe.om seed/ng/target/fabric.om \
note       seed/ng/target/crystallize.om seed/ng/egraph/ir_egraph.om \
note       seed/ng/verify/egp3_checker.om seed/ng/live/arboris_spec.om \
note       apps/omega-metabd/profile_ring.om apps/omega-metabd/general_pe.om \
note       apps/omega-metabd/metabd_main.om | seed/out/omc > /tmp/omega-metabd
note
note Subcommands:
note   omega-metabd status
note   omega-metabd spec [--workload affine|branch|sparse|all] [--dir PATH] [--ood]
note   omega-metabd gate [--dir PATH]
note   omega-metabd --help

global mc_arg uchar 512
global mc_dig uchar 24
global mc_dir uchar 512
global mc_dirl ulong 1
global mc_wk ulong 1
global mc_ood ulong 1
global mc_rwx ulong 1

text mc_cmd_status "status"
text mc_cmd_spec "spec"
text mc_cmd_gate "gate"
text mc_cmd_help "--help"
text mc_cmd_h "-h"

text mc_fl_wk "--workload"
text mc_fl_dir "--dir"
text mc_fl_ood "--ood"
text mc_fl_rwx "--rwx"
text mc_wk_aff "affine"
text mc_wk_br "branch"
text mc_wk_sp "sparse"
text mc_wk_all "all"

text mc_def_dir "/tmp/omega-metabd-cli"

text mc_usage "usage: omega-metabd <status|spec|gate>\n  status  Show TID_A725 schedule, live CPU, TargetDesc, W^X policy, 3-bit proof gate\n  spec    [--workload affine|branch|sparse|all] [--dir PATH] [--ood]\n          Run profile-ring -> multi-block OIR PE -> EGP3 -> W^X RX seal -> atomic fabWtbl swap\n  gate    [--dir PATH]  Run built-in end-to-end verification + negative-control suite\n"
text mc_err_cmd "omega-metabd: unknown subcommand (use status, spec, or gate)\n"
text mc_err_rwx "omega-metabd: REFUSED --rwx (strict W^X policy: PROT_WRITE|PROT_EXEC is permanently forbidden)\n"
text mc_err_arg "omega-metabd: invalid or missing argument\n"

text mc_st_1 "OMEGA-METABD STATUS\n  schedule=TID_A725("
text mc_st_2 ") live_cpu="
text mc_st_3 "\n  wx_policy=STRICT_RW_THEN_RX rwx_forbidden=1 rwx_refusals="
text mc_st_4 "\n  proof_gate=Contract(1)|EGP3(2)|Monk+Immune(4)==7\n  targets=X925(ooo="
text mc_st_5 "),A725(ooo="
text mc_st_6 "),SM121(smem="
text mc_st_7 ")\n  ring_cap="
text mc_st_8 " hot_thresh="
text mc_st_9 " swaps="
text mc_st_10 " rollbacks="
text mc_st_11 " refusals="
text mc_nl "\n"

text mc_sp_hdr "OMEGA-METABD SPEC workload="
text mc_sp_eg " egp3_rc="
text mc_sp_ce " certs="
text mc_sp_st " steps="
text mc_sp_ev " evals="
text mc_sp_in " insns="
text mc_sp_ar "->"
text mc_sp_op " ops="
text mc_sp_ns " ns="
text mc_sp_pa " parity="
text mc_sp_ok "EXACT"
text mc_sp_bad "MISMATCH"
text mc_sp_fv " fabVer="
text mc_sp_rb " OOD_ROLLBACK status="
text mc_sp_rbo " out="
text mc_sp_rbe " expected="
text mc_sp_done "OMEGA-METABD SPEC PASS swaps="
text mc_sp_fail "OMEGA-METABD SPEC FAIL code="

text mc_gt_ok "OMEGA-METABD GATE PASS workloads=3 swaps="
text mc_gt_rb " rollbacks="
text mc_gt_ref " refusals="
text mc_gt_rwx " rwx_refusals="
text mc_gt_fail "OMEGA-METABD GATE FAIL step="

fn mc_wrt s view uchar * to void
w = write 1 s 0 len s
end

fn mc_werr s view uchar * to void
w = write 2 s 0 len s
end

fn mc_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put mc_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 mc_dig p sub 24 p
ret
end
end
end

fn mc_arg_eq idx ulong lit view uchar * to bool
rn = argread idx mc_arg 0 511
if ne rn long len lit
ret false
end
for i ulong len lit bound 128
if ne get mc_arg i get lit i
ret false
end
end
ret true
end

fn mc_apply_dir to void
n = get mc_dirl 0
if eq n 0
wx_set_dir mc_def_dir
ret
end
for i ulong n bound 440
put wx_dir i get mc_dir i
end
wx_set_dir_buf n
end

fn mc_run_status to int
mb_init
sched = fabScheduleApu TASK_BG_METABOLIC
cn = cpunow
cpu = ulong 0
if ge cn 0
cpu = ulong cn
end
mc_wrt mc_st_1
mc_num sched
mc_wrt mc_st_2
mc_num cpu
mc_wrt mc_st_3
mc_num get wx_rwx_refusals 0
mc_wrt mc_st_4
mc_num tdGet TID_X925 TDF_OOO
mc_wrt mc_st_5
mc_num tdGet TID_A725 TDF_OOO
mc_wrt mc_st_6
mc_num tdGet TID_SM121 TDF_SMEM
mc_wrt mc_st_7
mc_num PR_DEFAULT_CAP
mc_wrt mc_st_8
mc_num get pr_hot_thresh 0
mc_wrt mc_st_9
mc_num get mb_swaps 0
mc_wrt mc_st_10
mc_num get mb_rollbacks 0
mc_wrt mc_st_11
mc_num get mb_refusals 0
mc_wrt mc_nl
ret 0
end

global mc_sp_v ulong 8

fn mc_spec_setup_cfg wk ulong to void
gpe_cfg_reset
if eq wk GPE_WK_AFFINE
gpe_cfg_pin 1 8
gpe_cfg_pin 2 0
gpe_cfg_pin 3 0
gpe_cfg_set_profile 9800 0 TID_X925
put mc_sp_v 0 42
put mc_sp_v 1 8
put mc_sp_v 2 0
put mc_sp_v 3 0
ret
end
if eq wk GPE_WK_BRANCH
gpe_cfg_pin 2 1
gpe_cfg_set_profile 9900 0 TID_X925
put mc_sp_v 0 42
put mc_sp_v 1 17
put mc_sp_v 2 1
put mc_sp_v 3 0
ret
end
gpe_cfg_pin 1 8
gpe_cfg_pin 2 5
gpe_cfg_pin 3 16
gpe_cfg_set_profile 9500 75 TID_X925
put mc_sp_v 0 42
put mc_sp_v 1 8
put mc_sp_v 2 5
put mc_sp_v 3 16
end

fn mc_spec_report slot ulong wk ulong par_ok bool to void
mc_wrt mc_sp_hdr
mc_num wk
mc_wrt mc_sp_eg
mc_num get gpe_pe_stat 7
mc_wrt mc_sp_ce
mc_num get gpe_pe_stat 8
mc_wrt mc_sp_st
mc_num get gpe_pe_stat 9
mc_wrt mc_sp_ev
mc_num get gpe_pe_stat 10
mc_wrt mc_sp_in
mc_num get mb_slot_base_insns slot
mc_wrt mc_sp_ar
mc_num get mb_slot_spec_insns slot
mc_wrt mc_sp_op
mc_num get mc_sp_v 4
mc_wrt mc_sp_ar
mc_num get mc_sp_v 5
mc_wrt mc_sp_ns
mc_num get mc_sp_v 6
mc_wrt mc_sp_ar
mc_num get mc_sp_v 7
mc_wrt mc_sp_pa
if par_ok
mc_wrt mc_sp_ok
else
mc_wrt mc_sp_bad
end
mc_wrt mc_sp_fv
mc_num get fabVer slot
mc_wrt mc_nl
end

fn mc_spec_check_ood slot ulong f uint to int
x0 = get mc_sp_v 0
ox1 = add get mc_sp_v 1 1
ox2 = add get mc_sp_v 2 2
ox3 = add get mc_sp_v 3 1
y_exp = gpe_eval_fn f x0 ox1 ox2 ox3
wx_set_args x0 ox1 ox2 ox3 1
y_got = mb_dispatch_slot slot false
mc_wrt mc_sp_rb
mc_num get mb_last_disp 0
mc_wrt mc_sp_rbo
mc_num y_got
mc_wrt mc_sp_rbe
mc_num y_exp
mc_wrt mc_sp_fv
mc_num get fabVer slot
mc_wrt mc_nl
if or ne y_got y_exp ne get mb_last_disp 0 MB_DISP_ROLLBACK
ret 60
end
ret 0
end

fn mc_eval_sp f uint to ulong
a0 = get mc_sp_v 0
a1 = get mc_sp_v 1
a2 = get mc_sp_v 2
a3 = get mc_sp_v 3
ret gpe_eval_fn f a0 a1 a2 a3
end

fn mc_set_sp_args reps ulong to void
a0 = get mc_sp_v 0
a1 = get mc_sp_v 1
a2 = get mc_sp_v 2
a3 = get mc_sp_v 3
wx_set_args a0 a1 a2 a3 reps
end

fn mc_push_profile sem ulong wk ulong to void
for k ulong 4
if eq wk GPE_WK_AFFINE
z = pr_push_obs sem 8 9800 0 1500 PR_KIND_CONST
end
if eq wk GPE_WK_BRANCH
z = pr_push_obs sem 1 9900 0 900 PR_KIND_BRANCH
end
if eq wk GPE_WK_SPARSE
z = pr_push_obs sem 5 9500 75 6000 PR_KIND_SPARSE_LOOP
end
end
z = pr_drain
end

note Run one complete profile -> specialize -> EGP3 -> W^X RX -> fabWtbl swap -> execute -> optional OOD rollback cycle
fn mc_spec_one slot ulong wk ulong do_ood bool to int
ir_init
f = uint 0
if eq wk GPE_WK_AFFINE
f = gpe_build_affine_route
end
if eq wk GPE_WK_BRANCH
f = gpe_build_branch_diamond
end
if eq wk GPE_WK_SPARSE
f = gpe_build_sparse_loop
end
if eq f 0
ret 10
end
rc = mb_register_slot slot add 7000 wk f wk
if ne rc MB_OK
ret int add 20 rc
end
mc_push_profile add 7000 wk wk
ci = pr_pick_hottest
if eq ci PR_NONE
ret 30
end
mc_spec_setup_cfg wk
yb = mc_eval_sp f
put mc_sp_v 4 get gpe_last_ops 0
mc_set_sp_args 10000
yn = mb_dispatch_slot slot false
put mc_sp_v 6 get wx_last_ns 0
rc = mb_specialize_slot slot TID_X925 WX_PROT_RX MB_PROOF_ALL
if ne rc MB_OK
ret int add 40 rc
end
pr_mark_done ci 1
ys = mc_eval_sp get mb_slot_fspec slot
put mc_sp_v 5 get gpe_last_ops 0
mc_set_sp_args 10000
ysn = mb_dispatch_slot slot true
put mc_sp_v 7 get wx_last_ns 0
par = and eq yb yn eq ys ysn
par = and par eq yn ysn
mc_spec_report slot wk par
if not par
ret 50
end
if do_ood
ret mc_spec_check_ood slot f
end
ret 0
end

fn mc_run_spec to int
mb_init
mc_apply_dir
if ne pr_shm_open_anon 16 PR_OK
mc_wrt mc_sp_fail
mc_num 1
mc_wrt mc_nl
ret 1
end
wk = get mc_wk 0
ood = ne get mc_ood 0 0
if or eq wk 0 eq wk GPE_WK_AFFINE
r = mc_spec_one 0 GPE_WK_AFFINE ood
if ne r 0
pr_shm_close
mc_wrt mc_sp_fail
mc_num ulong r
mc_wrt mc_nl
ret r
end
end
if or eq wk 0 eq wk GPE_WK_BRANCH
r = mc_spec_one 1 GPE_WK_BRANCH ood
if ne r 0
pr_shm_close
mc_wrt mc_sp_fail
mc_num ulong r
mc_wrt mc_nl
ret r
end
end
if or eq wk 0 eq wk GPE_WK_SPARSE
r = mc_spec_one 2 GPE_WK_SPARSE ood
if ne r 0
pr_shm_close
mc_wrt mc_sp_fail
mc_num ulong r
mc_wrt mc_nl
ret r
end
end
pr_shm_close
mc_wrt mc_sp_done
mc_num get mb_swaps 0
mc_wrt mc_gt_rb
mc_num get mb_rollbacks 0
mc_wrt mc_nl
ret 0
end

fn mc_run_gate to int
mb_init
mc_apply_dir
if ne pr_shm_open_anon 16 PR_OK
mc_wrt mc_gt_fail
mc_num 1
mc_wrt mc_nl
ret 1
end
for w ulong 3
r = mc_spec_one w add w 1 true
if ne r 0
pr_shm_close
mc_wrt mc_gt_fail
mc_num ulong r
mc_wrt mc_nl
ret r
end
end
note Quick negative controls inside CLI gate (RWX + missing proof bit + SMEM):
if ne mb_specialize_slot 0 TID_X925 WX_PROT_RWX MB_PROOF_ALL MB_ERR_WX_RWX
pr_shm_close
mc_wrt mc_gt_fail
mc_num 71
mc_wrt mc_nl
ret 71
end
if ne mb_specialize_slot 0 TID_X925 WX_PROT_RX 5 MB_ERR_PROOF_MASK
pr_shm_close
mc_wrt mc_gt_fail
mc_num 72
mc_wrt mc_nl
ret 72
end
if not isCompileTestFn TID_SM121
pr_shm_close
ret 73
end
if ne mb_check_gpu_candidate TID_SM121 8 4096 2048 7 MB_ERR_CONTRACT
pr_shm_close
mc_wrt mc_gt_fail
mc_num 74
mc_wrt mc_nl
ret 74
end
pr_shm_close
mc_wrt mc_gt_ok
mc_num get mb_swaps 0
mc_wrt mc_gt_rb
mc_num get mb_rollbacks 0
mc_wrt mc_gt_ref
mc_num get mb_refusals 0
mc_wrt mc_gt_rwx
mc_num get wx_rwx_refusals 0
mc_wrt mc_nl
ret 0
end

fn mc_parse_flags start ulong to int
n = ulong argcnt
i = start
while lt i n bound 64
if mc_arg_eq i mc_fl_rwx
put mc_rwx 0 1
ret 2
end
if mc_arg_eq i mc_fl_ood
put mc_ood 0 1
i = add i 1
continue
end
if mc_arg_eq i mc_fl_wk
i = add i 1
if ge i n
ret 1
end
if mc_arg_eq i mc_wk_aff
put mc_wk 0 GPE_WK_AFFINE
else
if mc_arg_eq i mc_wk_br
put mc_wk 0 GPE_WK_BRANCH
else
if mc_arg_eq i mc_wk_sp
put mc_wk 0 GPE_WK_SPARSE
else
if mc_arg_eq i mc_wk_all
put mc_wk 0 0
else
ret 1
end
end
end
end
i = add i 1
continue
end
if mc_arg_eq i mc_fl_dir
i = add i 1
if ge i n
ret 1
end
rn = argread i mc_dir 0 440
if le rn 0
ret 1
end
put mc_dirl 0 ulong rn
i = add i 1
continue
end
ret 1
end
ret 0
end

fn main to int
ar_init
put mc_dirl 0 0
put mc_wk 0 0
put mc_ood 0 0
put mc_rwx 0 0
if lt argcnt 2
mc_wrt mc_usage
ret 0
end
if or mc_arg_eq 1 mc_cmd_help mc_arg_eq 1 mc_cmd_h
mc_wrt mc_usage
ret 0
end
if mc_arg_eq 1 mc_fl_rwx
mc_werr mc_err_rwx
ret 2
end
pf = mc_parse_flags 2
if eq pf 2
mc_werr mc_err_rwx
ret 2
end
if ne pf 0
mc_werr mc_err_arg
ret 2
end
if mc_arg_eq 1 mc_cmd_status
ret mc_run_status
end
if mc_arg_eq 1 mc_cmd_spec
ret mc_run_spec
end
if mc_arg_eq 1 mc_cmd_gate
ret mc_run_gate
end
mc_werr mc_err_cmd
ret 2
end

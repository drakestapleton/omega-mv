note owner.om: the owner's pages, served inside the private network only. Composed after
note seed/net/http.om and seed/net/notls.om.
note   owner A B C D PORT      listen on the IPv4 address A.B.C.D
note It starts only on a loopback address (127.x.x.x) or a tailnet address (100.64.0.0/10); any other
note address is refused with exit 1, so the pages cannot be put on a public interface by mistake.
note It serves three files from the working directory, GET only, one request per connection:
note   /            visits.html   text/html
note   /tokens.css  tokens.css    text/css
note   /visits.css  visits.css    text/css
note Every other path is 404 and every other method 405. Each answer carries Cache-Control:
note no-store, X-Robots-Tag: noindex and a policy that allows no script. A file is read whole, at
note most 1,048,576 bytes. Exit 1 usage or refused address, 2 cannot listen.
global oarg uchar 32
text otget "GET"
text otroot "/"
text ottok "/tokens.css"
text otcss "/visits.css"
text ofhtm "visits.html"
text oftok "tokens.css"
text ofcss "visits.css"
text octn "Content-Type"
text octh "text/html; charset=utf-8"
text octc "text/css; charset=utf-8"
text occn "Cache-Control"
text occv "no-store"
text orbn "X-Robots-Tag"
text orbv "noindex"
text ocsn "Content-Security-Policy"
text ocsv "default-src 'none'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
note oanum: argument idx as a decimal number; 99999999 when it is not 1 to 5 digits
fn oanum idx ulong to ulong
n = argread idx oarg 0 31
if lt n 1
ret 99999999
end
if gt n 5
ret 99999999
end
v = ulong 0
i = ulong 0
while lt i ulong n bound 5
c = get oarg i
if or lt c 48 gt c 57
ret 99999999
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end
note oaddrok: loopback or tailnet only
fn oaddrok a ulong b ulong to bool
if eq a 127
ret true
end
if eq a 100
ret and ge b 64 le b 127
end
ret false
end
fn ofile cs edit ulong 320 io edit uchar 131072 f view uchar * ct view uchar * to long
fb = new uchar 1048576 0
fd = int fopen f 0 len f 0 0
if lt fd 0
ret hrsperr cs io 404
end
n = ulong 0
k = long 1
while gt k 0 bound 1048577
k = read fd fb n sub 1048576 n
if gt k 0
n = add n ulong k
end
end
c = fclose fd
r = hrspst cs io 200
r = hfe r hhname cs io octn
r = hfe r hhval cs io ct
r = hfe r hhname cs io occn
r = hfe r hhval cs io occv
r = hfe r hhname cs io orbn
r = hfe r hhval cs io orbv
r = hfe r hhname cs io ocsn
r = hfe r hhval cs io ocsv
r = hfe r hhend cs io 0 n
if gt n 0
r = hfe r hput cs io part fb 0 n
end
ret hfe r hwfin cs io
end
fn oserve c int cs edit ulong 320 io edit uchar 131072 to void
r = hinit cs io c 1
if lt r 0
ret
end
hsettmo cs 5000000000 5000000000
k = hreqrd cs io
if lt k 0
x = hreject cs io k
end
if gt k 0
if not hismeth cs io otget
x = hrsperr cs io 405
else
if hispath cs io otroot
x = ofile cs io ofhtm octh
else
if hispath cs io ottok
x = ofile cs io oftok octc
else
if hispath cs io otcss
x = ofile cs io ofcss octc
else
x = hrsperr cs io 404
end
end
end
end
end
y = hclose cs
end
fn main to int
cs = new ulong 320 0
io = new uchar 131072 0
ad = new uchar 16 0
if ne argcnt 6
ret 1
end
a = oanum 1
b = oanum 2
c = oanum 3
d = oanum 4
p = oanum 5
if or or gt a 255 gt b 255 or gt c 255 gt d 255
ret 1
end
if or lt p 1 gt p 65535
ret 1
end
if not oaddrok a b
ret 1
end
ip = uint add add add shl a 24 shl b 16 shl c 8 d
r = haddr4 ad ip p
lf = hlisten ad 16
if lt lf 0
ret 2
end
for it ulong 4000000000
s = haccept int lf 1000000000
if ge s 0
oserve int s cs io
end
end
ret 0
end

om2
note visits.om: the owner's view of who visited INTERPLANE. Its own program.
note   visits LOG
note LOG is forged's access log, one request per line:
note   <epoch> <address> <method> <path> <status> <bytes> <ms>
note Lines with another shape are counted as skipped. It writes two files in the working directory,
note each to a .tmp name first, readable by the owner only (mode 0600):
note   visits.tsv   every figure as tab-separated lines (T totals, D days, P projects, V visitors)
note   visits.html  the same figures as one page with no script
note A visitor is one network address. The log has no browser name, so people and crawlers are not
note told apart. A project is the first two segments of the path (/owner/repo), "/" for the home page.
note Limits: 65,536 visitors, 8,192 projects, 512 days; past a limit the extra are counted under
note "not listed". Requests whose UTC day is before the first request's day or 512 or more days
note after it are in the totals and counted as outside the day table.
note Exit 0 written, 1 usage, 2 log unreadable, 3 write failed.
const NV ulong 65536
const NP ulong 8192
global rb uchar 1048576
global ln uchar 4096
global lnl ulong 1
global fp ulong 20
global gs ulong 26
global vkh ulong 65536
global vrq ulong 65536
global vby ulong 65536
global vfs ulong 65536
global vls ulong 65536
global vdn ulong 65536
global vkd uchar 65536
global vip uchar 3145728
global pkh ulong 8192
global prq ulong 8192
global pun ulong 8192
global pdn ulong 8192
global ptx uchar 786432
global ptl ulong 8192
global s1 ulong 2097152
global s2 ulong 1048576
global drq ulong 512
global dun ulong 512
global ob uchar 2097152
global obl ulong 1
global pa uchar 1100
global pl uchar 64
note gs: 0 requests, 1 bytes, 2 skipped lines, 3 first epoch, 4 last epoch, 5 visitors, 6 projects,
note 7 visitors not listed, 8 projects not listed, 9 status 2xx, 10 3xx, 11 4xx, 12 5xx, 13 first day,
note 14 line too long flag, 15 new-slot flag, 16 requests outside the day table, 17 requests from
note named crawlers, 18 from other named agents, 19 with no agent name, 20 from lines written before
note forged logged the agent (seven fields), 21 fields in the current line, 22 visitors that are named
note crawlers, 23 visitors that are other named agents, 24 the current line's visitor slot
note vkd: 0 no agent name seen for the visitor, 1 a crawler name seen, 2 only other names seen
text kw1 "bot"
text kw2 "crawl"
text kw3 "spider"
text kw4 "slurp"
text fhtml "visits.html"
text fhtmp "visits.html.tmp"
text ftsv "visits.tsv"
text fttmp "visits.tsv.tmp"
text x01 "<!doctype html><html lang='en' data-theme='dark'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='robots' content='noindex'>"
text x02 "<title>Who visited INTERPLANE</title><link rel='stylesheet' href='tokens.css'><link rel='stylesheet' href='visits.css'></head><body><main>\n"
text x03 "<p class='eyebrow'>Owner only</p><h1>Who visited INTERPLANE</h1><p class='sub'>From the server's own log on your machine. Nothing here leaves it. A visitor is one network address. A named crawler is a visitor whose browser name says bot, crawl, spider or slurp; any other name counts as a browser or tool, and a tool can use any name it likes.</p>\n<dl class='stats'>"
text x04 "<div><dt>Requests</dt><dd>"
text x05 "</dd></div><div><dt>Visitors</dt><dd>"
text x06 "</dd></div><div><dt>Projects visited</dt><dd>"
text x07 "</dd></div><div><dt>Megabytes served</dt><dd>"
text x08 "</dd></div></dl>\n<p class='sub'>From "
text x09 " to "
text x10 " UTC. Answers: "
text x11 " fine, "
text x12 " redirected, "
text x13 " refused or not found, "
text x14 " server errors. Lines not understood: "
text y1 ".</p>\n<p class='sub'>Who asked: "
text y2 " requests from named crawlers, "
text y3 " from browsers and tools, "
text y4 " gave no name, "
text y5 " are from before names were recorded. Visitors: "
text y6 " named crawlers, "
text y7 " browsers and tools"
text ykc "crawler"
text yko "browser or tool"
text x15 ".</p>\n<h2>By day</h2><table><thead><tr><th>Day (UTC)</th><th>Requests</th><th>Visitors</th></tr></thead><tbody>\n"
text x16 "</tbody></table>\n<h2>Most visited projects</h2><table><thead><tr><th>Project</th><th>Requests</th><th>Visitors</th></tr></thead><tbody>\n"
text x17 "</tbody></table>\n<h2>Most active visitors</h2><table><thead><tr><th>Address</th><th>Requests</th><th>Megabytes</th><th>First seen (UTC)</th><th>Last seen (UTC)</th><th>Kind</th></tr></thead><tbody>\n"
text x18 "</tbody></table>\n<p class='sub'>Not listed above: "
text x19 " visitors and "
text x20 " projects past the table limits; "
text x21 " requests outside the 512-day table.</p></main></body></html>\n"
text xtr "<tr><td>"
text xtd "</td><td>"
text xte "</td></tr>\n"
text xamp "&amp;"
text xlt "&lt;"
text xgt "&gt;"
note ---- output buffer
fn wb c uchar to void
o = get obl 0
if lt o 2097151
put ob o c
put obl 0 add o 1
end
end
fn wt t view uchar * to void
for i ulong len t bound 400
wb get t i
end
end
fn wn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
wb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
wb get d n
end
end
fn w2 v ulong to void
wb uchar add 48 rem div v 10 10
wb uchar add 48 rem v 10
end
note wnc: a number for reading, digits grouped in threes (1,417,491); the page uses it, the TSV does not
fn wnc v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
wb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
wb get d n
if gt n 0
if eq rem n 3 0
wb 44
end
end
end
end
note wesc: one byte, HTML-escaped; a quote or control byte becomes "?"
fn wesc c uchar to void
if eq c 38
wt xamp
ret
end
if eq c 60
wt xlt
ret
end
if eq c 62
wt xgt
ret
end
if or or lt c 32 gt c 126 or eq c 34 eq c 39
wb 63
ret
end
wb c
end
note wcell: one byte of a name; as it is in the TSV, HTML-escaped in the page
fn wcell c uchar tsv bool to void
if tsv
wb c
else
wesc c
end
end
fn wymd days ulong to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
t = sub doe div doe 1460
t = add t div doe 36524
t = sub t div doe 146096
yoe = div t 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
wn y
wb 45
w2 m
wb 45
w2 d
end
fn wtime s ulong to void
r = rem s 86400
wymd div s 86400
wb 32
w2 div r 3600
wb 58
w2 div rem r 3600 60
end
note ---- the current line
note psplit: field starts and ends into fp (start k at 2k, end at 2k+1); true for seven fields (lines
note written before forged logged the agent) or nine; the count goes to gs 21
fn psplit to bool
n = get lnl 0
k = ulong 0
a = ulong 0
i = ulong 0
while lt i n bound 4096
if eq get ln i 32
if ge k 9
ret false
end
put fp mul k 2 a
put fp add mul k 2 1 i
k = add k 1
a = add i 1
end
i = add i 1
end
if and ne k 6 ne k 8
ret false
end
put fp mul k 2 a
put fp add mul k 2 1 n
put gs 21 add k 1
ret true
end
note pnum: field k as a number; a non-digit gives 2^63
fn pnum k ulong to ulong
a = get fp mul k 2
b = get fp add mul k 2 1
if ge a b
ret 9223372036854775808
end
if gt sub b a 18
ret 9223372036854775808
end
v = ulong 0
i = a
while lt i b bound 18
c = get ln i
if or lt c 48 gt c 57
ret 9223372036854775808
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end
note hspan: FNV-1a 64 of ln a..b, started from seed; never 0
fn hspan a ulong b ulong seed ulong to ulong
h = seed
i = a
while lt i b bound 4096
h = mul xor h ulong get ln i 1099511628211
i = add i 1
end
if eq h 0
ret 1
end
ret h
end
note pkey: the end of the project key in the path a..b: two segments, cut at "?"
fn pkey a ulong b ulong to ulong
i = add a 1
s = ulong 0
while lt i b bound 4096
c = get ln i
if eq c 63
ret i
end
if eq c 47
s = add s 1
if ge s 2
ret i
end
end
i = add i 1
end
ret b
end
note sadd1, sadd2: add a hash to a set; true when it was not there. A full set answers false.
fn sadd1 h ulong to bool
i = and h 2097151
n = ulong 0
while lt n 2097152 bound 2097152
k = get s1 i
if eq k h
ret false
end
if eq k 0
put s1 i h
ret true
end
i = and add i 1 2097151
n = add n 1
end
ret false
end
fn sadd2 h ulong to bool
i = and h 1048575
n = ulong 0
while lt n 1048576 bound 1048576
k = get s2 i
if eq k h
ret false
end
if eq k 0
put s2 i h
ret true
end
i = and add i 1 1048575
n = add n 1
end
ret false
end
note vslot: the visitor slot for hash h, claimed when new (gs 15 = 1 then); NV when the table is full
fn vslot h ulong to ulong
i = and h 65535
n = ulong 0
put gs 15 0
while lt n 65536 bound 65536
k = get vkh i
if eq k h
ret i
end
if eq k 0
put vkh i h
put gs 15 1
ret i
end
i = and add i 1 65535
n = add n 1
end
ret NV
end
fn pslot h ulong to ulong
i = and h 8191
n = ulong 0
put gs 15 0
while lt n 8192 bound 8192
k = get pkh i
if eq k h
ret i
end
if eq k 0
put pkh i h
put gs 15 1
ret i
end
i = and add i 1 8191
n = add n 1
end
ret NP
end
note vname: keep the address ln a..b (at most 47 bytes) for visitor slot v
fn vname v ulong a ulong b ulong to void
n = sub b a
if gt n 47
n = ulong 47
end
o = mul v 48
i = ulong 0
while lt i n bound 47
c = get ln add a i
put vip add o i c
i = add i 1
end
put vip add o 47 uchar n
end
note pvisit: count this request for its visitor; the visitor hash
fn pvisit t ulong by ulong to ulong
a = get fp 2
b = get fp 3
h = hspan a b 14695981039346656037
v = vslot h
put gs 24 v
if eq v NV
put gs 7 add get gs 7 1
ret h
end
if eq get gs 15 1
put gs 5 add get gs 5 1
put vfs v t
vname v a b
end
put vrq v add get vrq v 1
put vby v add get vby v by
put vls v t
ret h
end
note phas: ln[a, b) contains the lower-case word w, in any letter case
fn phas a ulong b ulong w view uchar * to bool
m = len w
i = a
while le add i m b bound 4096
hit = true
for j ulong m bound 8
x = ulong get ln add i j
if and ge x 65 le x 90
x = add x 32
end
if ne x ulong get w j
hit = false
end
end
if hit
ret true
end
i = add i 1
end
ret false
end
note pagent: count the request by its agent name (field 8) and mark its visitor. A crawler name
note wins over any other name the same address used.
fn pagent to void
if ne get gs 21 9
put gs 20 add get gs 20 1
ret
end
a = get fp 14
b = get fp 15
v = get gs 24
if or ge a b and eq sub b a 1 eq get ln a 45
put gs 19 add get gs 19 1
ret
end
if or or phas a b kw1 phas a b kw2 or phas a b kw3 phas a b kw4
put gs 17 add get gs 17 1
if lt v NV
put vkd v 1
end
ret
end
put gs 18 add get gs 18 1
if lt v NV
if eq get vkd v 0
put vkd v 2
end
end
end
note pname: keep the project key ln a..e (at most 95 bytes) for project slot p
fn pname p ulong a ulong e ulong to void
n = sub e a
if gt n 95
n = ulong 95
end
o = mul p 96
i = ulong 0
while lt i n bound 95
c = get ln add a i
put ptx add o i c
i = add i 1
end
put ptl p n
end
note pproj: count this request for its project; vh is the visitor hash
fn pproj vh ulong to void
a = get fp 6
b = get fp 7
e = pkey a b
h = hspan a e 14695981039346656037
p = pslot h
if eq p NP
put gs 8 add get gs 8 1
ret
end
if eq get gs 15 1
put gs 6 add get gs 6 1
pname p a e
end
put prq p add get prq p 1
if sadd2 xor mul h 1099511628211 vh
put pun p add get pun p 1
end
end
note pline: one log line
fn pline to void
if not psplit
put gs 2 add get gs 2 1
ret
end
t = pnum 0
st = pnum 4
by = pnum 5
if or or ge t 9223372036854775808 ge st 9223372036854775808 ge by 9223372036854775808
put gs 2 add get gs 2 1
ret
end
if ge get fp 6 get fp 7
put gs 2 add get gs 2 1
ret
end
if ne get ln get fp 6 47
put gs 2 add get gs 2 1
ret
end
if eq get gs 0 0
put gs 3 t
put gs 13 div t 86400
end
put gs 0 add get gs 0 1
put gs 1 add get gs 1 by
put gs 4 t
c = div st 100
if and ge c 2 le c 5
put gs add 7 c add get gs add 7 c 1
end
vh = pvisit t by
pagent
day = div t 86400
if ge day get gs 13
d = sub day get gs 13
if lt d 512
put drq d add get drq d 1
if sadd1 xor mul vh 1099511628211 day
put dun d add get dun d 1
end
else
put gs 16 add get gs 16 1
end
else
put gs 16 add get gs 16 1
end
pproj vh
end
note pbytes: n bytes of the read buffer
fn pbytes n ulong to void
i = ulong 0
while lt i n bound 1048576
c = get rb i
if eq c 10
if eq get gs 14 0
pline
else
put gs 2 add get gs 2 1
end
put lnl 0 0
put gs 14 0
else
m = get lnl 0
if lt m 4095
put ln m c
put lnl 0 add m 1
else
put gs 14 1
end
end
i = add i 1
end
end
note ---- report
fn rdays tsv bool to void
d = ulong 0
while lt d 512 bound 512
if gt get drq d 0
if tsv
wb 68
wb 9
wymd add get gs 13 d
wb 9
wn get drq d
wb 9
wn get dun d
wb 10
else
wt xtr
wymd add get gs 13 d
wt xtd
wnc get drq d
wt xtd
wnc get dun d
wt xte
end
end
d = add d 1
end
end
note ptop: the unprinted project with the most requests, or NP
fn ptop to ulong
best = NP
m = ulong 0
i = ulong 0
while lt i 8192 bound 8192
if eq get pdn i 0
if gt get prq i m
m = get prq i
best = i
end
end
i = add i 1
end
ret best
end
fn rproj tsv bool to void
k = ulong 0
while lt k 25 bound 25
p = ptop
if lt p NP
put pdn p 1
if tsv
wb 80
wb 9
else
wt xtr
end
n = get ptl p
i = ulong 0
while lt i n bound 96
wcell get ptx add mul p 96 i tsv
i = add i 1
end
if tsv
wb 9
wn get prq p
wb 9
wn get pun p
wb 10
else
wt xtd
wnc get prq p
wt xtd
wnc get pun p
wt xte
end
end
k = add k 1
end
end
fn vtop to ulong
best = NV
m = ulong 0
i = ulong 0
while lt i 65536 bound 65536
if eq get vdn i 0
if gt get vrq i m
m = get vrq i
best = i
end
end
i = add i 1
end
ret best
end
fn rvis tsv bool to void
k = ulong 0
while lt k 40 bound 40
v = vtop
if lt v NV
put vdn v 1
if tsv
wb 86
wb 9
else
wt xtr
end
n = ulong get vip add mul v 48 47
i = ulong 0
while lt i n bound 48
wcell get vip add mul v 48 i tsv
i = add i 1
end
if tsv
wb 9
wn get vrq v
wb 9
wn get vby v
wb 9
wn get vfs v
wb 9
wn get vls v
wb 9
wb vkc get vkd v
wb 10
else
wt xtd
wnc get vrq v
wt xtd
wnc div get vby v 1048576
wt xtd
wtime get vfs v
wt xtd
wtime get vls v
wt xtd
if eq get vkd v 1
wt ykc
end
if eq get vkd v 2
wt yko
end
wt xte
end
end
k = add k 1
end
end
fn rclear to void
i = ulong 0
while lt i 65536 bound 65536
put vdn i 0
i = add i 1
end
j = ulong 0
while lt j 8192 bound 8192
put pdn j 0
j = add j 1
end
end
note rkinds: visitors by kind into gs 22 and 23
fn rkinds to void
put gs 22 0
put gs 23 0
i = ulong 0
while lt i 65536 bound 65536
if ne get vkh i 0
if eq get vkd i 1
put gs 22 add get gs 22 1
end
if eq get vkd i 2
put gs 23 add get gs 23 1
end
end
i = add i 1
end
end
note vkc: the kind letter of the TSV: c crawler, o other named agent, - no name seen
fn vkc k uchar to uchar
if eq k 1
ret 99
end
if eq k 2
ret 111
end
ret 45
end

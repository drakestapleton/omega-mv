note ---- files
fn wren a view uchar * b view uchar * to bool
la = len a
lb = len b
put pl 0 2
put pl 1 0
put pl 2 uchar la
put pl 3 0
i = ulong 0
while lt i la bound 28
put pl add 4 i get a i
i = add i 1
end
o = add 4 la
put pl o uchar lb
put pl add o 1 0
k = ulong 0
while lt k lb bound 28
put pl add add o 2 k get b k
k = add k 1
end
ret eq renames pl 0 add add o 2 lb 0 0
end
fn wfile tmp view uchar * fin view uchar * to bool
fd = int fopen tmp 0 len tmp 577 384
if lt fd 0
ret false
end
r = fchmod fd 384
n = get obl 0
o = ulong 0
ok = true
while lt o n bound 2097152
k = write fd ob o sub n o
if le k 0
ok = false
o = n
else
o = add o ulong k
end
end
r = fsync fd
r = fclose fd
if not ok
ret false
end
ret wren tmp fin
end
fn main to int
if ne argcnt 2
ret 1
end
n = argread 1 pa 0 1023
if lt n 1
ret 1
end
fd = int fopen pa 0 ulong n 0 0
if lt fd 0
ret 2
end
k = long 1
while gt k 0 bound 9223372036854775807
k = read fd rb 0 1048576
if gt k 0
pbytes ulong k
end
end
r = fclose fd
if lt k 0
ret 2
end
if gt get lnl 0 0
put gs 2 add get gs 2 1
end
rtsv
if not wfile fttmp ftsv
ret 3
end
rclear
rhtml
if not wfile fhtmp fhtml
ret 3
end
ret 0
end

note cli.om: galaxy as a filter. stdin is the feed (or "css"), stdout the page. Composed after page.om.
fn rdin to void
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read 0 ib n sub 65535 n
if gt k 0
n = add n ulong k
end
end
put ibl 0 n
end
fn flush to int
n = get obl 0
o = ulong 0
while lt o n bound 1048576
k = write 1 ob o sub n o
if le k 0
ret 1
end
o = add o ulong k
end
ret 0
end
fn main to int
rdin
n = get ibl 0
mode = ulong 0
if ge n 3
if eq get ib 0 99
if eq get ib 1 115
mode = ulong 1
end
end
end
if eq mode 1
css
else
page
end
ret flush
end

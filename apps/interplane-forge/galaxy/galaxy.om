om2
note galaxy.om: the INTERPLANE front page as one seeded Omega program. No scripts are emitted.
note stdin "css" prints the stylesheet. Otherwise stdin is tab-separated public facts, one per line:
note   K key value            a headline figure
note   S name open done24     a hive cell (a factory station), at most 10
note   R name tier            a project star, tier core, rest or tail
note   M repo head note       a merged head on Radicle
note stdout is the page. Every field is HTML-escaped. Exit 0 on success, 1 when stdout fails.
note Star positions use the golden angle: cos and sin of pi(3 - sqrt 5), Wolfram, 17 digits.
const GCP f64 0.73736887807831990
const GS f64 0.67549029426152364
global ib uchar 65536
global ibl ulong 1
note caps: a name prints at most FCAP input bytes, a merge note NCAP; at most 400 stars, 12 merges,
note 10 cells and 400 dots per ring are drawn. README "Limits" carries the output bound these give.
const FCAP ulong 64
const NCAP ulong 160
global ob uchar 1048576
text tcore "core"
text trest "rest"
text ttail "tail"
global obl ulong 1
text tamp "&amp;"
text tlt "&lt;"
text tgt "&gt;"
text tquo "&quot;"
text tna "not read"
text kdel "delivered"
text kver "verdicts"
text kapp "approved"
text kgpu "gpuw"
text h01 "<!doctype html><html lang='en' data-theme='dark'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>"
text h02 "<title>INTERPLANE: sovereign intelligence you can check</title><link rel='stylesheet' href='tokens.css'><link rel='stylesheet' href='galaxy.css'></head><body>\n"
text h03 "<header class='top'><a class='wm' href='https://interplane.io/'>INTERPLANE</a><nav><a href='#galaxy'>Galaxy</a><a href='https://interplane.io/explore'>Forge</a>"
text h04 "<a href='#proof'>Proof</a><a href='https://www.aienos.com/evidence/'>Evidence</a></nav><span class='live'><i class='dot'></i>Read from the Spark "
text h04b "</span></header>\n<main>\n"
text h05 "<div class='side'><section class='hero'><p class='eyebrow'>Sovereign intelligence</p><h1>NVIDIA hardware compatible. CUDA not required.</h1>"
text h06 "<p class='sub'>No plugins. No scripts on this page. Nothing to trust: every figure here comes from a signed public record you can replay on your own machine.</p>"
text h07 "<p class='scope'>Proven on the DGX Spark GB10. Other chips: not run.</p><pre class='cmd'>curl -fsSL https://www.aienos.com/si | sh</pre>\n<dl class='stats'>"
text h08 "<div><dt>Delivered</dt><dd>"
text h09 "</dd></div><div><dt>Verdicts, 24 h</dt><dd>"
text h10 "</dd></div><div><dt>Approved, to merge</dt><dd>"
text h11 "</dd></div><div><dt>GPU, watts</dt><dd>"
text h12 "</dd></div></dl></section>\n"
text h13 "<svg id='galaxy' viewBox='0 0 1200 800' preserveAspectRatio='xMidYMid slice' role='img' aria-label='The hive at the centre, every project a star around it'>\n"
text h14 "<g transform='translate(600 400)'>\n<circle class='orb' r='295'/><circle class='orb' r='380'/><circle class='orb' r='465'/>\n<g class='spin'>\n"
text h15 "</g>\n<g class='stars'>\n"
text h16 "</g>\n</g>\n<g class='comb'>\n"
text h17 "</g>\n</svg>\n"
text h18 "<aside id='proof'><p class='eyebrow'>Proof</p><h2>Latest merges on Radicle</h2>"
text h19 "<p class='sub'>Each line is a signed commit on a public peer network. Fetch it and compare the hash.</p><ol class='chain'>\n"
text h20 "</ol></aside></div>\n"
text h21 "<p class='legend'><i class='k ka'></i><b>"
text h22 "</b> waiting for review, inner ring <i class='k kb'></i><b>"
text h23 "</b> approved, waiting to merge, second ring <i class='k kc'></i><b>"
text h24 "</b> public projects, one star each</p>\n</main></body></html>\n"
text f1 "</g>\n<g class='flow fa'>\n"
text f2 "</g>\n<g class='flow fb'>\n"
text o1 "<circle class='pl' cx='"
text o2 "' r='3'/>\n"
text kwai "waiting"
text kasof "asof"
text d1 "<circle class='d"
text d2 "' cx='"
text d3 "' cy='"
text d4 "' r='1'/>\n"
text s1 "<a href='https://interplane.io/drakestapleton/"
text s2 "'><circle class='st "
text s3 "' r='"
text s4 "'><title>"
text s5 "</title></circle></a>\n"
text s6 "<text class='lb' x='"
text s6e "<text class='lb le' x='"
text s7 "' y='"
text s8 "'>"
text s9 "</text>\n"
text c1 "<g class='cell' transform='translate("
text c2 ")'><polygon class='hx l"
text c3 "' points='0,-64 55,-32 55,32 0,64 -55,32 -55,-32'/><text class='cn' y='-22'>"
text c4 "</text><text class='cn' y='-8'>"
text c5 "</text><text class='cv' y='18'>"
text c6 "</text><text class='cs' y='36'>+"
text c7 " in 24 h</text></g>\n"
text m1 "<li><a href='https://interplane.io/drakestapleton/"
text m2 "</a><code>"
text m3 "</code><span>"
text m4 "</span></li>\n"
text q01 "*{box-sizing:border-box}html,body{margin:0;height:100%;background:var(--bg-primary);color:var(--text-primary);font:14px/20px var(--font-sans,Inter,system-ui,sans-serif)}\n"
text q02 "a{color:var(--accent);text-decoration:none}a:hover{color:var(--accent-hover)}a:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}\n"
text q03 ".top{position:fixed;inset:0 0 auto 0;z-index:3;display:flex;align-items:center;gap:24px;padding:12px 32px;background:var(--bg-header);border-bottom:1px solid var(--border)}\n"
text q04 ".wm{font-weight:700;letter-spacing:.3em;color:var(--text-primary)}.top nav{display:flex;gap:20px;flex:1}\n"
text q05 ".live{font:12px/16px var(--font-mono,ui-monospace,monospace);color:var(--text-secondary)}\n"
text q06 ".dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--live-dot);box-shadow:var(--glow-live);margin-right:8px;animation:tw 2s ease-in-out infinite}\n"
text q07 "#galaxy{position:fixed;left:472px;top:46px;width:calc(100% - 472px);height:calc(100% - 46px);z-index:0}\n"
text q08 ".side{position:fixed;left:32px;top:62px;bottom:16px;width:424px;z-index:2;display:flex;flex-direction:column;gap:16px}\n"
text q08b ".hero,#proof{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:24px}#proof{flex:1;min-height:0;overflow:auto}\n"
text q09 ".legend{position:fixed;left:472px;right:0;bottom:12px;margin:0;text-align:center;font-size:12px;color:var(--text-secondary);z-index:2}\n"
text q09b ".legend b{color:var(--text-primary);font-family:var(--font-mono,ui-monospace,monospace);margin:0 4px}.k{display:inline-block;width:8px;height:8px;border-radius:50%;margin-left:16px}\n"
text q09c ".ka{background:var(--danger)}.kb{background:var(--warning)}.kc{background:var(--accent)}\n"
text q09d ".fa{animation:spin 180s linear infinite}.fb{animation:spin 320s linear infinite reverse}.fa .pl{fill:var(--danger)}.fb .pl{fill:var(--warning)}\n"
text q10 ".eyebrow{margin:0 0 8px;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}\n"
text q11 "h1{margin:0 0 12px;font-size:36px;line-height:40px;font-weight:700}h2{margin:0 0 8px;font-size:18px;line-height:28px;font-weight:600}\n"
text q12 ".sub{margin:0 0 12px;color:var(--text-secondary)}.scope{margin:0 0 16px;font-size:12px;color:var(--warning)}\n"
text q13 ".cmd{margin:0 0 16px;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--fill-input);font:12px/16px var(--font-mono,ui-monospace,monospace);overflow:auto}\n"
text q14 ".stats{display:grid;grid-template-columns:repeat(4,auto);gap:12px;margin:0}.stats dt{font-size:11px;line-height:16px;color:var(--text-secondary)}\n"
text q15 ".stats dd{margin:0;font:600 20px/28px var(--font-mono,ui-monospace,monospace)}\n"
text q16 ".chain{list-style:none;margin:0;padding:0}.chain li{display:grid;grid-template-columns:1fr auto;gap:2px 8px;padding:8px 0;border-top:1px solid var(--border-faint)}\n"
text q17 ".chain code{font:12px/16px var(--font-mono,ui-monospace,monospace);color:var(--success)}.chain span{grid-column:1/3;font-size:12px;color:var(--text-secondary)}\n"
text q18 ".orb{fill:none;stroke:var(--accent);stroke-opacity:.12}.spin{animation:spin 900s linear infinite}\n"
text q19 ".d0,.d1,.d2{fill:var(--text-primary)}.d0{opacity:.3}.d1{opacity:.45;animation:tw 7s ease-in-out infinite}.d2{opacity:.6;animation:tw 11s ease-in-out infinite}\n"
text q20 ".st{transform-box:fill-box;transform-origin:center;transition:opacity .15s}.st.core{fill:var(--text-primary)}.st.rest{fill:var(--accent)}.st.tail{fill:var(--text-secondary)}\n"
text q21 ".stars a:hover .st,.stars a:focus .st{transform:scale(2)}.lb{fill:var(--text-tertiary);font:11px var(--font-mono,ui-monospace,monospace)}.le{text-anchor:end}\n"
text q22 ".hx{stroke:var(--border-strong);stroke-width:1}.l0{fill:var(--heat-0)}.l1{fill:var(--heat-1)}.l2{fill:var(--heat-2)}.l3{fill:var(--heat-3)}.l4{fill:var(--heat-4)}\n"
text q23 ".l2,.l3,.l4{animation:br 4s ease-in-out infinite}.comb text{text-anchor:middle;fill:var(--text-primary)}\n"
text q24 ".cn{font:600 11px var(--font-sans,Inter,system-ui,sans-serif)}.cv{font:600 20px var(--font-mono,ui-monospace,monospace)}\n"
text q25 ".comb .cs{font:10px var(--font-mono,ui-monospace,monospace);fill:var(--text-secondary)}\n"
text q26 "@keyframes spin{to{transform:rotate(360deg)}}@keyframes tw{50%{opacity:.25}}@keyframes br{50%{fill-opacity:.6}}\n"
text q27 "@media (max-width:1000px){main{display:flex;flex-direction:column}.side{display:contents}.hero{order:1;margin:72px 16px 0}#galaxy{order:2;position:relative;left:0;top:0;width:100%;height:80vh}\n"
text q27b ".legend{order:3;position:static;padding:12px}#proof{order:4;margin:16px;flex:none}.top{gap:12px;padding:12px 16px}.top nav{gap:12px;overflow-x:auto}.live{display:none}}\n"
text q28 "@media (prefers-reduced-motion:reduce){*{animation:none!important}}\n"
note ---- output buffer
fn emb c uchar to void
o = get obl 0
put ob o c
put obl 0 add o 1
end
fn em t view uchar * to void
n = len t
o = get obl 0
i = ulong 0
while lt i n bound 65536
put ob add o i get t i
i = add i 1
end
put obl 0 add o n
end
fn emn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
emb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
emb get d n
end
end
fn emi v long to void
if lt v 0
emb 45
emn ulong neg v
else
emn ulong v
end
end
note emfc: at most cap bytes of the input a..b, HTML-escaped; a cut never splits a UTF-8 character
fn emfc a ulong b ulong cap ulong to void
if le b a
ret
end
e = b
if gt sub b a cap
e = add a cap
k = ulong 0
while lt k 3 bound 3
if gt e a
u = get ib e
if ge u 128
if lt u 192
e = sub e 1
end
end
end
k = add k 1
end
end
i = a
while lt i e bound 160
c = get ib i
if eq c 38
em tamp
else
if eq c 60
em tlt
else
if eq c 62
em tgt
else
if eq c 34
em tquo
else
if eq c 39
em tquo
else
emb c
end
end
end
end
end
i = add i 1
end
end
fn emf a ulong b ulong to void
emfc a b FCAP
end
fn emfn a ulong b ulong to void
emfc a b NCAP
end
note ---- input scanning: every index stays inside 0..ibl
fn find a ulong e ulong c uchar to ulong
i = a
while lt i e bound 65536
if eq get ib i c
ret i
end
i = add i 1
end
ret e
end
fn eol a ulong to ulong
ret find a get ibl 0 10
end
note nextl: start of the first line at or after p whose first byte is ty, or ibl
fn nextl p ulong ty uchar to ulong
lim = get ibl 0
s = p
while lt s lim bound 65536
if eq get ib s ty
ret s
end
s = add eol s 1
end
ret lim
end
note fld: start of field k (0 based) of the line s..e; e when the line has fewer fields
fn fld s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 16
p = find p e 9
if lt p e
p = add p 1
end
j = add j 1
end
ret p
end
fn pnum a ulong b ulong to ulong
v = ulong 0
i = a
while lt i b bound 65536
c = get ib i
if ge c 48
if le c 57
v = add mul v 10 ulong sub c 48
end
end
i = add i 1
end
ret v
end
fn feq a ulong b ulong t view uchar * to bool
n = len t
if ne sub b a n
ret false
end
i = ulong 0
while lt i n bound 64
if ne get ib add a i get t i
ret false
end
i = add i 1
end
ret true
end
note kpos: start of the value of headline key t, or ibl
fn kpos t view uchar * to ulong
lim = get ibl 0
s = nextl 0 75
while lt s lim bound 65536
e = eol s
a = fld s e 1
if feq a find a e 9 t
ret fld s e 2
end
s = nextl add e 1 75
end
ret lim
end
note emk: the value of headline key t, or "not read"
fn emk t view uchar * to void
v = kpos t
if lt v get ibl 0
emf v find v eol v 9
else
em tna
end
end
fn knum t view uchar * to ulong
v = kpos t
if lt v get ibl 0
ret pnum v find v eol v 9
end
ret 0
end
note cnt: how many input lines start with ty
fn cnt ty uchar to ulong
lim = get ibl 0
n = ulong 0
s = nextl 0 ty
while lt s lim bound 65536
n = add n 1
s = nextl add eol s 1 ty
end
ret n
end
note orbit: n dots (at most 400) on the circle of radius r, spread by the golden angle
fn orbit n ulong r ulong to void
x = 0.0f64
y = 1.0f64
rf = f64 r
m = n
if gt m 400
m = ulong 400
end
k = ulong 0
while lt k m bound 400
em o1
emi long mul rf x
em d3
emi long mul rf y
em o2
t = neg add mul x GCP mul y GS
y = sub mul x GS mul y GCP
x = t
k = add k 1
end
end
note ---- the galaxy
fn dustpt k ulong x f64 y f64 to void
r = mul 620.0f64 fsqrt div f64 add k 1 160.0f64
em d1
emn rem k 3
em d2
emi long mul r x
em d3
emi long mul r y
em d4
end
fn dust to void
x = 1.0f64
y = 0.0f64
k = ulong 0
while lt k 160 bound 160
dustpt k x y
t = neg add mul x GCP mul y GS
y = sub mul x GS mul y GCP
x = t
k = add k 1
end
end
fn slabel a ulong b ulong px long py long to void
note a star left of the centre carries its label on its left, away from the hive
if lt px 0
em s6e
emi sub px 9
else
em s6
emi add px 9
end
em s7
emi add py 4
em s8
emf a b
em s9
end
note tier letter to ring: core 0, rest 1, tail 2
fn sring c ulong e ulong to ulong
if lt c e
if eq get ib c 99
ret 0
end
if eq get ib c 116
ret 2
end
end
ret 1
end
fn srad ring ulong k ulong to f64
u = add mul ring 85 rem mul k 37 50
ret f64 add u 270
end
fn sdraw s ulong e ulong ring ulong px long py long to void
a = fld s e 1
b = find a e 9
em s1
emf a b
em s2
if eq ring 0
em tcore
else
if eq ring 1
em trest
else
em ttail
end
end
em d2
emi px
em d3
emi py
em s3
emn sub 5 ring
em s4
emf a b
em s5
if eq ring 0
slabel a b px py
end
end
fn star s ulong e ulong k ulong x f64 y f64 to void
ring = sring fld s e 2 e
r = srad ring k
sdraw s e ring long mul r x long mul r y
end
fn stars to void
lim = get ibl 0
x = 1.0f64
y = 0.0f64
k = ulong 0
s = nextl 0 82
while lt s lim bound 400
e = eol s
star s e k x y
t = neg add mul x GCP mul y GS
y = sub mul x GS mul y GCP
x = t
k = add k 1
s = nextl add e 1 82
if ge k 400
s = lim
end
end
end
note cell j of the honeycomb, rows of 3, 4 and 3
fn cellat j ulong lv ulong to void
row = ulong 0
col = j
if ge j 3
row = ulong 1
col = sub j 3
end
if ge j 7
row = ulong 2
col = sub j 7
end
cx = add 484 mul col 116
if eq row 1
cx = add 426 mul col 116
end
em c1
emn cx
emb 32
emn add 300 mul row 100
em c2
emn lv
em c3
end
fn cell s ulong e ulong j ulong to void
a = fld s e 1
b = find a e 9
sp = find a b 32
o = fld s e 2
n = pnum o find o e 9
lv = div add n 9 10
if gt lv 4
lv = ulong 4
end
cellat j lv
emf a sp
em c4
if lt sp b
emf add sp 1 b
end
em c5
emn n
em c6
d = fld s e 3
emn pnum d find d e 9
em c7
end
fn comb to void
lim = get ibl 0
j = ulong 0
s = nextl 0 83
while lt s lim bound 10
e = eol s
cell s e j
j = add j 1
s = nextl add e 1 83
if ge j 10
s = lim
end
end
end
fn merges to void
lim = get ibl 0
n = ulong 0
s = nextl 0 77
while lt s lim bound 12
e = eol s
a = fld s e 1
b = find a e 9
h = fld s e 2
t = fld s e 3
em m1
emf a b
em s8
emf a b
em m2
emf h find h e 9
em m3
emfn t find t e 9
em m4
n = add n 1
s = nextl add e 1 77
if ge n 12
s = lim
end
end
end
fn css to void
em q01
em q02
em q03
em q04
em q05
em q06
em q07
em q08
em q09
em q10
em q11
em q12
em q13
em q14
em q15
em q16
em q17
em q18
em q19
em q20
em q21
em q22
em q08b
em q09b
em q09c
em q09d
em q23
em q24
em q25
em q26
em q27
em q27b
em q28
end
fn page to void
em h01
em h02
em h03
em h04
emk kasof
em h04b
em h05
em h06
em h07
em h08
emk kdel
em h09
emk kver
em h10
emk kapp
em h11
emk kgpu
em h12
em h18
em h19
merges
em h20
em h13
em h14
dust
em f1
orbit knum kwai 295
em f2
orbit knum kapp 380
em h15
stars
em h16
comb
em h17
em h21
emn knum kwai
em h22
emn knum kapp
em h23
emn cnt 82
em h24
end
fn rdin to void
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read 0 ib n sub 65535 n
if gt k 0
n = add n ulong k
end
end
put ibl 0 n
end
fn flush to int
n = get obl 0
o = ulong 0
while lt o n bound 1048576
k = write 1 ob o sub n o
if le k 0
ret 1
end
o = add o ulong k
end
ret 0
end
fn main to int
rdin
n = get ibl 0
mode = ulong 0
if ge n 3
if eq get ib 0 99
if eq get ib 1 115
mode = ulong 1
end
end
end
if eq mode 1
css
else
page
end
ret flush
end

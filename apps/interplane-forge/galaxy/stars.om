om2
note stars.om: the galaxy's stars and merges from the Radicle registry. Its own program.
note   stars RIDS.md STORAGE/ [repos.tsv]
note Reads the FIRST table of RIDS.md (header "| repo | RID | default branch"), the table forged's
note allow-list uses, and writes stars.tsv in the working directory (tmp, sync, rename):
note   R name tier       one line per row whose name and RID are well formed, whose storage folder
note                     STORAGE/<rid> exists and which is not on the deny list
note   M repo head note  the 8 rows with the latest UTC column, newest first
note tier is "core" when column 4 of repos.tsv says so for that name, else "rest".
note Exit 0 written, 1 usage, 2 RIDS.md unreadable or without the table, 3 write failed.
note At most 128 rows are read. The crypto repositories are never listed, whatever the table says.
global rb uchar 262144
global rbl ulong 1
global tb uchar 65536
global tbl ulong 1
global sp uchar 1024
global spl ulong 1
global pa uchar 1100
global wb uchar 65536
global wbl ulong 1
global rs ulong 128
global re ulong 128
global ru ulong 128
global rd ulong 128
global rn ulong 1
global pl uchar 64
text thd "| repo | RID | default branch"
text dn1 "omega-pearl"
text dn2 "aien-crypto"
text dr1 "rad:z2ft64NFLsKzWttCXw6NWNbRQLggQ"
text tcor "core"
text tres "rest"
text fout "stars.tsv"
text ftmp "stars.tsv.tmp"
note ---- output buffer
fn wab c uchar to void
o = get wbl 0
if lt o 65535
put wb o c
put wbl 0 add o 1
end
end
fn wa t view uchar * to void
for i ulong len t bound 64
wab get t i
end
end
note was: at most cap bytes of rb a..b; a control byte or tab becomes a space
fn was a ulong b ulong cap ulong to void
e = b
if lt b a
ret
end
if gt sub b a cap
e = add a cap
end
i = a
while lt i e bound 262144
c = get rb i
if lt c 32
c = uchar 32
end
wab c
i = add i 1
end
end
note ---- scanning rb; every index stays inside 0..rbl
fn reol a ulong to ulong
lim = get rbl 0
i = a
while lt i lim bound 262144
if eq get rb i 10
ret i
end
i = add i 1
end
ret lim
end
fn rbar a ulong e ulong to ulong
i = a
while lt i e bound 262144
if eq get rb i 124
ret i
end
i = add i 1
end
ret e
end
note rbk: the k-th bar of the row s..e counting the leading one as 0; e when the row has fewer
fn rbk s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 16
p = rbar add p 1 e
j = add j 1
end
ret p
end
note rlb: the last bar before e in the row s..e, or s
fn rlb s ulong e ulong to ulong
i = e
while gt i s bound 262144
if eq get rb sub i 1 124
ret sub i 1
end
i = sub i 1
end
ret s
end
fn rtl a ulong e ulong to ulong
i = a
while lt i e bound 262144
if ne get rb i 32
ret i
end
i = add i 1
end
ret e
end
fn rtr a ulong e ulong to ulong
i = e
while gt i a bound 262144
if ne get rb sub i 1 32
ret i
end
i = sub i 1
end
ret a
end
fn ralnum c uchar to bool
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 48 le c 57
end
fn rnameok a ulong b ulong to bool
if ge a b
ret false
end
if gt sub b a 64
ret false
end
i = a
while lt i b bound 64
c = get rb i
if not ralnum c
if not or or eq c 45 eq c 46 eq c 95
ret false
end
end
i = add i 1
end
ret true
end
note rridok: "rad:" then 20 to 56 letters and digits
fn rridok a ulong b ulong to bool
if lt b a
ret false
end
n = sub b a
if or lt n 24 gt n 60
ret false
end
if ne get rb a 114
ret false
end
if ne get rb add a 1 97
ret false
end
if ne get rb add a 2 100
ret false
end
if ne get rb add a 3 58
ret false
end
i = add a 4
while lt i b bound 64
if not ralnum get rb i
ret false
end
i = add i 1
end
ret true
end
fn rspeq a ulong b ulong t view uchar * to bool
n = len t
if lt b a
ret false
end
if ne sub b a n
ret false
end
i = ulong 0
while lt i n bound 64
if ne get rb add a i get t i
ret false
end
i = add i 1
end
ret true
end
fn rdeny na ulong nb ulong ra ulong rz ulong to bool
if rspeq na nb dn1
ret true
end
if rspeq na nb dn2
ret true
end
ret rspeq ra rz dr1
end
note rstore: STORAGE/<rid without "rad:"> exists
fn rstore ra ulong rz ulong to bool
n = get spl 0
i = ulong 0
while lt i n bound 1024
put pa i get sp i
i = add i 1
end
j = add ra 4
while lt j rz bound 64
put pa n get rb j
n = add n 1
j = add j 1
end
ret eq faccess pa 0 n 0 0
end
note ---- tiers: repos.tsv lines "name<TAB>rid<TAB>head<TAB>tier..."
fn tfind a ulong e ulong c uchar to ulong
i = a
while lt i e bound 65536
if eq get tb i c
ret i
end
i = add i 1
end
ret e
end
fn tnameq a ulong b ulong s ulong f ulong to bool
if ne sub b a sub f s
ret false
end
n = sub b a
i = ulong 0
while lt i n bound 64
if ne get rb add a i get tb add s i
ret false
end
i = add i 1
end
ret true
end
note tcore: repos.tsv gives the name a..b (in rb) the tier "core"
fn tcore a ulong b ulong to bool
lim = get tbl 0
s = ulong 0
while lt s lim bound 65536
e = tfind s lim 10
f = tfind s e 9
if tnameq a b s f
t = tfind add f 1 e 9
t = tfind add t 1 e 9
t = add t 1
if le add t 4 e
if eq get tb t 99
if eq get tb add t 1 111
if eq get tb add t 2 114
if eq get tb add t 3 101
if eq add t 4 e
ret true
end
ret eq get tb add t 4 9
end
end
end
end
end
ret false
end
s = add e 1
end
ret false
end
note ---- rows
note rrow: one table row s..e. A listed row prints its R line and is remembered for the merges.
fn rrow s ulong e ulong to void
b1 = rbk s e 1
b2 = rbk s e 2
na = rtl add s 1 b1
nb = rtr na b1
ra = rtl add b1 1 b2
rz = rtr ra b2
if not rnameok na nb
ret
end
if not rridok ra rz
ret
end
if rdeny na nb ra rz
ret
end
if not rstore ra rz
ret
end
wab 82
wab 9
was na nb 64
wab 9
if tcore na nb
wa tcor
else
wa tres
end
wab 10
n = get rn 0
if lt n 128
put rs n s
put re n e
f1 = rlb s e
f0 = rlb s f1
u = rtl add f0 1 f1
put ru n 0
if ge sub rtr u f1 u 20
if eq get rb u 50
put ru n u
end
end
put rd n 0
put rn 0 add n 1
end
end
note rlt: the 20-byte UTC stamp at a sorts before the one at b
fn rlt a ulong b ulong to bool
i = ulong 0
while lt i 20 bound 20
x = get rb add a i
y = get rb add b i
if lt x y
ret true
end
if gt x y
ret false
end
i = add i 1
end
ret false
end
fn rmerge i ulong to void
s = get rs i
e = get re i
b1 = rbk s e 1
b3 = rbk s e 3
b4 = rbk s e 4
f0 = rlb s rlb s e
na = rtl add s 1 b1
wab 77
wab 9
was na rtr na b1 64
wab 9
h = rtl add b3 1 b4
was h rtr h b4 12
wab 9
t = rtl add b4 1 f0
if gt f0 b4
was t rtr t f0 200
end
wab 10
end
note rtop: print up to 8 remembered rows, latest UTC first
fn rtop to void
n = get rn 0
k = ulong 0
while lt k 8 bound 8
best = ulong 128
i = ulong 0
while lt i n bound 128
if eq get rd i 0
u = get ru i
if gt u 0
if eq best 128
best = i
else
if rlt get ru best u
best = i
end
end
end
end
i = add i 1
end
if lt best 128
rmerge best
put rd best 1
end
k = add k 1
end
end
note rtable: the start of the first row after the header line, or rbl
fn rtable to ulong
lim = get rbl 0
s = ulong 0
while lt s lim bound 262144
e = reol s
if ge sub e s len thd
if rspeq s add s len thd thd
ret add e 1
end
end
s = add e 1
end
ret lim
end
fn rrows start ulong to void
lim = get rbl 0
s = start
while lt s lim bound 262144
e = reol s
if ge s e
ret
end
if ne get rb s 124
ret
end
if lt add s 1 e
if ne get rb add s 1 45
rrow s e
end
end
s = add e 1
end
end
note ---- files
fn ldr to bool
n = argread 1 pa 0 1023
if le n 0
ret false
end
fd = int fopen pa 0 ulong n 0 0
if lt fd 0
ret false
end
m = ulong 0
k = long 1
while gt k 0 bound 262145
k = read fd rb m sub 262144 m
if gt k 0
m = add m ulong k
end
end
r = fclose fd
put rbl 0 m
ret true
end
fn ldt to void
put tbl 0 0
n = argread 3 pa 0 1023
if le n 0
ret
end
fd = int fopen pa 0 ulong n 0 0
if lt fd 0
ret
end
m = ulong 0
k = long 1
while gt k 0 bound 65537
k = read fd tb m sub 65536 m
if gt k 0
m = add m ulong k
end
end
r = fclose fd
put tbl 0 m
end
fn wren to bool
la = len ftmp
lb = len fout
put pl 0 2
put pl 1 0
put pl 2 uchar la
put pl 3 0
i = ulong 0
while lt i la bound 28
put pl add 4 i get ftmp i
i = add i 1
end
o = add 4 la
put pl o uchar lb
put pl add o 1 0
k = ulong 0
while lt k lb bound 28
put pl add add o 2 k get fout k
k = add k 1
end
ret eq renames pl 0 add add o 2 lb 0 0
end
fn wout to bool
fd = int fopen ftmp 0 len ftmp 577 420
if lt fd 0
ret false
end
n = get wbl 0
o = ulong 0
ok = true
while lt o n bound 65536
k = write fd wb o sub n o
if le k 0
ok = false
o = n
else
o = add o ulong k
end
end
r = fsync fd
r = fclose fd
if not ok
ret false
end
ret wren
end
fn main to int
if lt argcnt 3
ret 1
end
if not ldr
ret 2
end
n = argread 2 sp 0 1023
if le n 0
ret 1
end
put spl 0 ulong n
if ge argcnt 4
ldt
end
t = rtable
if ge t get rbl 0
ret 2
end
rrows t
rtop
if wout
ret 0
end
ret 3
end

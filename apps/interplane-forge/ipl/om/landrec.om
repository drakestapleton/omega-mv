om2
note landrec.om: the one place that decides what a native Interplane record may say.
note   landrec project NAME BRANCH VISIBILITY OWNER ALIAS NONCE
note   landrec land NAME BRANCH OLD NEW RECEIPT VERDICT REQUEST
note   landrec successor NAME OLD NEW PUB REASON
note   landrec check name|branch|request|owner|pub|reason VALUE      exit 0 when VALUE satisfies that rule, else 1
note project and land check every field and print the canonical payload (the exact bytes a chain
note record commits to) on stdout, exit 0. A field that breaks its rule prints "REFUSED <field>" on
note stderr, exit 1, and nothing on stdout. Wrong word or argument count: usage on stderr, exit 2.
note Field rules. NAME: one or more bytes of letters digits . _ - starting with a letter or digit, never
note ending in a dot (two names that differ only in case are refused by the store, not here).
note BRANCH: one or more bytes of letters digits . _ - / ; no leading - . / ; no trailing . / ; no ".."
note "//" or "/." inside; no part ending in ".lock" (git refuses those). OLD, NEW: 40 lowercase hex
note digits (a commit; OLD is 40 zeros when the branch has no head yet). RECEIPT, VERDICT: 64
note lowercase hex digits (SHA-256 of the file). REQUEST: one or more bytes of letters digits . _ -
note (the caller's own id; the same id never lands twice). NONCE: 32 lowercase hex digits, random,
note made once when the project is created, so that projects created separately get, by chance, different ids.
note VISIBILITY: public or private. OWNER, and successor OLD and NEW: an SSH key fingerprint, SHA256:
note and 43 base64 characters. PUB: 68 characters of base64 (A-Za-z0-9+/), the blob of one ssh-ed25519
note public key with no comment (51 decoded bytes, no padding). REASON: - or the same bytes as REQUEST.
note ALIAS: - or the project's old id, rad:z and 20..60 letters and digits (history lookups only).
note No field can hold a space, a tab or a line feed, so a payload line is never ambiguous.
note Sizes. No field has a length chosen here. (The store writes a name or branch longer than the
note chain format's 128-byte subject field into that field as a digest, and refuses only what the
note file system cannot hold as a folder or a branch.)
note Nothing else has a size chosen here. ab holds one argument and is 131072 bytes, the most Linux
note lets one argument be (MAX_ARG_STRLEN, terminator included), so no argument a process can be
note started with is cut or refused for its length. ob holds one payload. The longest is a land
note record whose name, branch and request are each the longest argument, 131071 bytes: 18 for the
note first line, 131080 + 131079 + 131080 for those three lines, 45 + 45 for old and new, 73 + 73 for
note receipt and verdict, 393493 bytes in all; ob is 400000. The loop bounds 200000 and 2000000 are
note above those sizes. (A run-time pool would say this more directly, but at this compiler pin
note argread refuses a pool as its buffer, error 7.)
global ab uchar 131072
global ob uchar 400000
global ol ulong 1
text tland "land"
text tproj "project"
text tcheck "check"
text tname "name"
text tbr "branch"
text trq "request"
text hland "interplane-land 1\n"
text hproj "interplane-project 1\n"
text kproj "project "
text kbranch "branch "
text kold "old "
text knew "new "
text krec "receipt "
text kver "verdict "
text kreq "request "
text kvis "visibility "
text kown "owner "
text kali "alias "
text knon "nonce "
text tref "REFUSED "
text tnl "\n"
text tpub "public"
text tpriv "private"
text tsha "SHA256:"
text trad "rad:z"
text tsucc "successor"
text hsucc "interplane-successor 1\n"
text kpub "pub "
text kreason "reason "
text tpubk "pub"
text treason "reason"
text town "owner"
text tusage "usage: landrec project NAME BRANCH VISIBILITY OWNER ALIAS NONCE | landrec land NAME BRANCH OLD NEW RECEIPT VERDICT REQUEST | landrec successor NAME OLD NEW PUB REASON | landrec check name|branch|request|owner|pub|reason VALUE\n"
fn islow c uchar to bool
ret and ge c 97 le c 122
end
fn isup c uchar to bool
ret and ge c 65 le c 90
end
fn isdig c uchar to bool
ret and ge c 48 le c 57
end
fn isaln c uchar to bool
ret or (islow c) (or (isup c) (isdig c))
end
fn nope b bool to bool
if b
ret false
end
ret true
end
note loada: argument i into ab; the length, or a negative host error
fn loada i ulong to long
ret argread i ab 0 131072
end
note same: ab[0,n) equals the text t
fn same t view uchar * n ulong to bool
if ne n len t
ret false
end
j = ulong 0
while lt j n bound 256
if ne get ab j get t j
ret false
end
j = add j 1
end
ret true
end
fn hexn n ulong want ulong to bool
if ne n want
ret false
end
j = ulong 0
while lt j n bound 256
c = get ab j
if nope or (isdig c) (and ge c 97 le c 102)
ret false
end
j = add j 1
end
ret true
end
fn namec c uchar to bool
ret or (isaln c) (or eq c 46 (or eq c 95 eq c 45))
end
fn isname n ulong to bool
if eq n 0
ret false
end
f = get ab 0
if nope and (isaln f) (ne get ab sub n 1 46)
ret false
end
j = ulong 0
while lt j n bound 200000
if nope namec get ab j
ret false
end
j = add j 1
end
ret true
end
fn refc c uchar to bool
ret or (isaln c) (or eq c 46 (or eq c 95 (or eq c 45 eq c 47)))
end
note lockat: ab[e-5,e) is ".lock"
fn lockat e ulong to bool
if lt e 5
ret false
end
s = sub e 5
if ne get ab s 46
ret false
end
if ne get ab add s 1 108
ret false
end
if ne get ab add s 2 111
ret false
end
if ne get ab add s 3 99
ret false
end
ret eq get ab add s 4 107
end
fn isref n ulong to bool
if eq n 0
ret false
end
f = get ab 0
if or eq f 45 or eq f 46 eq f 47
ret false
end
l = get ab sub n 1
if or eq l 46 eq l 47
ret false
end
p = uchar 0
j = ulong 0
while lt j n bound 200000
c = get ab j
if nope refc c
ret false
end
if and eq c 46 or eq p 46 eq p 47
ret false
end
if and eq c 47 eq p 47
ret false
end
if and eq c 47 (lockat j)
ret false
end
p = c
j = add j 1
end
ret nope lockat n
end
fn isreq n ulong to bool
if eq n 0
ret false
end
j = ulong 0
while lt j n bound 200000
if nope namec get ab j
ret false
end
j = add j 1
end
ret true
end
fn isfp n ulong to bool
if ne n 50
ret false
end
j = ulong 0
while lt j 7 bound 8
if ne get ab j get tsha j
ret false
end
j = add j 1
end
while lt j 50 bound 64
c = get ab j
if nope or (isaln c) (or eq c 43 eq c 47)
ret false
end
j = add j 1
end
ret true
end
fn isalias n ulong to bool
if eq n 0
ret false
end
if and eq n 1 eq get ab 0 45
ret true
end
if or lt n 25 gt n 65
ret false
end
j = ulong 0
while lt j 5 bound 8
if ne get ab j get trad j
ret false
end
j = add j 1
end
while lt j n bound 256
if nope isaln get ab j
ret false
end
j = add j 1
end
ret true
end
fn isb64c c uchar to bool
ret or (isaln c) (or eq c 43 eq c 47)
end
note ispub: the 68-character ssh-ed25519 public-key blob, no padding, no comment
fn ispub n ulong to bool
if ne n 68
ret false
end
j = ulong 0
while lt j n bound 128
if nope isb64c get ab j
ret false
end
j = add j 1
end
ret true
end
fn isreason n ulong to bool
if and eq n 1 eq get ab 0 45
ret true
end
ret isreq n
end
note valid: field rule k for ab[0,n)
fn valid k ulong n ulong to bool
if eq k 1
ret isname n
end
if eq k 2
ret isref n
end
if eq k 3
ret hexn n 40
end
if eq k 4
ret hexn n 64
end
if eq k 5
ret isreq n
end
if eq k 6
ret isfp n
end
if eq k 7
ret or (same tpub n) (same tpriv n)
end
if eq k 8
ret isalias n
end
if eq k 9
ret hexn n 32
end
if eq k 10
ret ispub n
end
if eq k 11
ret isreason n
end
ret false
end
note room: a payload never needs more than ob; exit 91 says this note is wrong
fn room n ulong to void
if gt n 400000
exit 91
end
end
fn emit t view uchar * to void
o = get ol 0
m = len t
room add o m
j = ulong 0
while lt j m bound 4096
put ob add o j get t j
j = add j 1
end
put ol 0 add o m
end
fn emita n ulong to void
o = get ol 0
room add o n
j = ulong 0
while lt j n bound 200000
put ob add o j get ab j
j = add j 1
end
put ol 0 add o n
end
fn errw t view uchar * to void
k = write 2 t 0 len t
end
note putf: argument i must satisfy rule k; append "key value\n" to the payload, or refuse
fn putf i ulong key view uchar * k ulong to void
r = loada i
if lt r 0
errw tref
errw key
errw tnl
exit 1
end
n = ulong r
if nope valid k n
errw tref
errw key
errw tnl
exit 1
end
emit key
emita n
emit tnl
end
fn flush to void
e = get ol 0
p = ulong 0
while lt p e bound 2000000
k = write 1 ob p sub e p
if le k 0
exit 90
end
p = add p ulong k
end
end
note docheck: landrec check RULE VALUE
fn docheck to int
r = loada 2
if lt r 0
ret 2
end
m = ulong r
k = ulong 0
if same tname m
k = 1
end
if same tbr m
k = 2
end
if same trq m
k = 5
end
if same town m
k = 6
end
if same tpubk m
k = 10
end
if same treason m
k = 11
end
if eq k 0
ret 2
end
v = loada 3
if lt v 0
ret 1
end
if valid k ulong v
ret 0
end
ret 1
end
fn main to int
put ol 0 0
c = argcnt
if lt c 2
errw tusage
ret 2
end
r = loada 1
if lt r 0
errw tusage
ret 2
end
m = ulong r
isl = same tland m
isp = same tproj m
if and (same tcheck m) eq c 4
ret docheck
end
if and isl eq c 9
emit hland
putf 2 kproj 1
putf 3 kbranch 2
putf 4 kold 3
putf 5 knew 3
putf 6 krec 4
putf 7 kver 4
putf 8 kreq 5
flush
ret 0
end
if and isp eq c 8
emit hproj
putf 2 kproj 1
putf 3 kbranch 2
putf 4 kvis 7
putf 5 kown 6
putf 6 kali 8
putf 7 knon 9
flush
ret 0
end
if and (same tsucc m) eq c 7
emit hsucc
putf 2 kproj 1
putf 3 kold 6
putf 4 knew 6
putf 5 kpub 10
putf 6 kreason 11
flush
ret 0
end
errw tusage
ret 2
end

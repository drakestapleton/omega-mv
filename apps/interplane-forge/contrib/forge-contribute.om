note forge-contribute: clone, branch, commit, receipt, Radicle patch, review request, digest.
note Twelve arguments after the program name. See docs/ANNOYANCES.md.
note The receipt is attached by rad patch edit. git refuses a newline in a push option.
global fcbig uchar 3840
global fcal ulong 12
global qnid uchar 40
global fccd ulong 1
text tcenv "/usr/bin/env"
text tcdash "-i"
text tchome "HOME="
text tcpath "PATH="
text tclbin "/.local/bin:/usr/bin:/bin"
text tcradh "RAD_HOME="
text tcradp "/.radicle"
text tcradx "/.local/bin/rad"
text tcg1 "GIT_AUTHOR_NAME=forge-contribute"
text tcg2 "GIT_AUTHOR_EMAIL=forge@localhost"
text tcg3 "GIT_COMMITTER_NAME=forge-contribute"
text tcg4 "GIT_COMMITTER_EMAIL=forge@localhost"
text tcgit "/usr/bin/git"
text tcc "-C"
text tcadd "add"
text tcdd "--"
text tccmt "commit"
text tcm "-m"
text tccfg "-c"
text tcgp "commit.gpgsign=false"
text tcun "user.name=forge-contribute"
text tcum "user.email=forge@localhost"
text tcco "checkout"
text tcb "-b"
text tcpush "push"
text tco "-o"
text tcpm "patch.message="
text tcref "HEAD:refs/patches"
text tcrad "rad"
text tcrp "rev-parse"
text tchead "HEAD"
text tctree "HEAD^{tree}"
text tcclone "clone"
text tcradp2 "rad:"
text tcped "patch"
text tcedit "edit"
text tcrev "review"
text tcrepo "--repo"
text tcna "--no-announce"
text tcmsg "--message"
text tcreq "review requested"
text tcok1 "patch "
text tcok2 "commit "
text tcnl "\n"
text tcpass "RAD_PASSPHRASE="
text tcfail "forge-contribute: a step failed; its output follows\n"
fn fcgit to void
fka tcgit
fka tcc
fcnew 1
end
fn fcoff i ulong to ulong
ret mul i ulong 320
end
fn fcarg i ulong to void
o = mul i 320
n = get fcal i
for k ulong n bound 320
fkc get fcbig add o k
end
end
note fcnew: argument i as a record of its own (fcarg appends to the open record)
fn fcnew i ulong to void
fkopen
fcarg i
end
fn fcload to long
buf = new uchar 320 0
if ne argcnt 13
ret 2
end
for i ulong 12
r = argread add i 1 buf 0 319
if or lt r 1 gt r 319
ret 2
end
put fcal i ulong r
o = mul i 320
for k ulong ulong r bound 320
put fcbig add o k get buf k
end
end
ret 0
end
fn fcbad i ulong to bool
o = mul i 320
n = get fcal i
for k ulong n bound 320
c = get fcbig add o k
if or lt c 32 eq c 127
ret true
end
end
ret false
end
fn fcabs i ulong to bool
if eq get fcbig mul i 320 47
ret true
end
ret false
end
note fcdots: argument i holds a ".." path segment (start or "/" before it, end or "/" after it)
fn fcdots i ulong to bool
o = mul i 320
n = get fcal i
for k ulong n bound 320
if fcdotat o n k
ret true
end
end
ret false
end
fn fcdotat o ulong n ulong k ulong to bool
if ge add k 1 n
ret false
end
if ne get fcbig add o k 46
ret false
end
if ne get fcbig add o add k 1 46
ret false
end
if gt k 0
if ne get fcbig add o sub k 1 47
ret false
end
end
if lt add k 2 n
if ne get fcbig add o add k 2 47
ret false
end
end
ret true
end
note fcpdots: a ".." segment in DIR, CMD, FILE, BODY, DATA or HOME
fn fcpdots to bool
if fcdots 1
ret true
end
if fcdots 4
ret true
end
if fcdots 8
ret true
end
if fcdots 9
ret true
end
if fcdots 10
ret true
end
ret fcdots 11
end
note fcdpath: fpth = DIR (argument 1)
fn fcdpath to void
put fpthl 0 0
o = mul ulong 1 320
for k ulong get fcal 1 bound 320
fpc get fcbig add o k
end
end
note fcexist: DIR already exists (any file type)
fn fcexist to bool
fcdpath
r = lstat fpth 0 get fpthl 0 fstb 0 128
ret ge r 0
end
fn fctok i ulong to bool
o = mul i 320
n = get fcal i
if or eq n 0 gt n 39
ret false
end
for k ulong n bound 39
c = get fcbig add o k
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
end
ret true
end
fn fchex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
fn fcvalid to bool
for i ulong 12
if fcbad i
ret false
end
end
if fcpdots
ret false
end
if not fcabs 1
ret false
end
if not fcabs 4
ret false
end
if not fcabs 9
ret false
end
if not fcabs 10
ret false
end
if not fcabs 11
ret false
end
if ne get fcbig add fcoff 10 sub get fcal 10 1 47
ret false
end
if eq get fcbig add fcoff 11 sub get fcal 11 1 47
ret false
end
if ne get fcbig 0 122
ret false
end
if or lt get fcal 0 20 gt get fcal 0 40
ret false
end
if eq get fcbig fcoff 2 45
ret false
end
if or eq get fcal 2 0 gt get fcal 2 64
ret false
end
if or eq get fcal 3 0 gt get fcal 3 120
ret false
end
for k ulong get fcal 3 bound 120
if eq get fcbig add fcoff 3 k 10
ret false
end
end
if or eq get fcal 8 0 gt get fcal 8 64
ret false
end
for k ulong get fcal 8 bound 64
if eq get fcbig add fcoff 8 k 47
ret false
end
end
if not fctok 5
ret false
end
if not fctok 6
ret false
end
if not fctok 7
ret false
end
if fcexist
ret false
end
ret true
end
note fcchild: when fccd is 1 the program runs in DIR, the clone at the receipt's commit
fn fcchild wfd int to void
nul = fopen tfdevnul 0 len tfdevnul 2 0
if lt nul 0
exit 126
end
if eq get fccd 0 1
fcdpath
c = chdir fpth 0 get fpthl 0
if lt c 0
exit 126
end
end
x = dupfd int nul 0 0
x = dupfd wfd 1 0
x = dupfd wfd 2 0
x = execprog fpk 0 get fpkl 0
exit 127
end
fn fcrun to long
put fxol 0 0
put fxotr 0 0
r = pipefds fpfd 0 8 524288
if lt r 0
ret -2
end
rfd = fpfdv 0
wfd = fpfdv 1
dl = add long monons 60000000000
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
fcchild wfd
exit 127
end
x = fclose wfd
ok = fdrain rfd dl
x = fclose rfd
if not ok
x = killpid int pid 9
end
st = freap int pid dl
if not ok
ret -1
end
ret st
end
fn fcenv to void
fkb
fka tcenv
fka tcdash
fkopen
fkt tchome
fcarg 11
fkopen
fkt tcpath
fcarg 11
fkt tclbin
fkopen
fkt tcradh
fcarg 11
fkt tcradp
fka tcg1
fka tcg2
fka tcg3
fka tcg4
fcpass
end
fn fcpenv i ulong to void
buf = new uchar 80 0
r = envread i buf 0 80
if lt r 16
ret
end
for k ulong len tcpass
if ne get buf k get tcpass k
ret
end
end
fkopen
m = ulong r
for k ulong m bound 80
fkc get buf k
end
end
fn fcpass to void
n = envcnt
if lt n 1
ret
end
u = ulong n
if gt u 4096
u = ulong 4096
end
i = ulong 0
while lt i u bound 4096
fcpenv i
i = add i 1
end
end
fn fcrad to void
fkopen
fcarg 11
fkt tcradx
end
fn fcclone to long
fcenv
fcrad
fka tcclone
fkopen
fkt tcradp2
fcarg 0
fcnew 1
ret fcrun
end
fn fccopy to long
put fpthl 0 0
o = fcoff 1
for k ulong get fcal 1 bound 320
fpc get fcbig add o k
end
fpc 47
o = fcoff 8
for k ulong get fcal 8 bound 64
fpc get fcbig add o k
end
ofd = fopen fpth 0 get fpthl 0 524865 384
if lt ofd 0
ret 4
end
put fpthl 0 0
o = fcoff 9
for k ulong get fcal 9 bound 320
fpc get fcbig add o k
end
inn = fopen fpth 0 get fpthl 0 524288 0
if lt inn 0
x = fclose int ofd
ret 4
end
buf = new uchar 4096 0
left = ulong 65536
ok = true
while gt left 0 bound 65536
k = read int inn buf 0 4096
if lt k 0
ok = false
left = ulong 0
end
if eq k 0
left = ulong 0
end
if gt k 0
w = write int ofd buf 0 ulong k
if ne w k
ok = false
left = ulong 0
end
left = sub left ulong k
end
end
x = fsync int ofd
x = fclose int ofd
x = fclose int inn
if not ok
ret 4
end
ret 0
end
fn fcbranch to long
fcenv
fcgit
fka tcco
fka tcb
fcnew 2
ret fcrun
end
fn fcadd to long
fcenv
fcgit
fka tcadd
fka tcdd
fcnew 8
ret fcrun
end
fn fccommit to long
fcenv
fcgit
fka tccfg
fka tcgp
fka tccfg
fka tcun
fka tccfg
fka tcum
fka tccmt
fka tcm
fcnew 3
ret fcrun
end
fn fcsha to bool
if lt get fxol 0 40
ret false
end
for i ulong 40
if not fchex get fxo i
ret false
end
end
ret true
end
fn fchead to long
fcenv
fcgit
fka tcrp
fka tchead
r = fcrun
if ne r 0
ret r
end
if not fcsha
ret 5
end
for i ulong 40
put qncm i get fxo i
end
fcenv
fcgit
fka tcrp
fka tctree
r = fcrun
if ne r 0
ret r
end
if not fcsha
ret 5
end
for i ulong 40
put qntr i get fxo i
end
ret 0
end
fn fcevid to long
fcenv
fcnew 4
put fccd 0 1
r = fcrun
put fccd 0 0
put qnrcn 0 0
if and ge r 0 le r 255
put qnrcn 0 ulong r
end
if lt r 0
ret 6
end
h = new uchar 32 0
b = new uchar 4096 0
n = get fxol 0
if gt n 4096
n = ulong 4096
end
for i ulong n bound 4096
put b i get fxo i
end
k = sha2_digest 256 view part b 0 n h
for i ulong 32
v = get h i
put qnout64 mul i 2 qnhxb shr v 4
put qnout64 add mul i 2 1 qnhxb and v 15
end
o = fcoff 4
n = get fcal 4
if gt n 200
ret 6
end
for i ulong n bound 200
put qncmd i get fcbig add o i
end
put qncmdl 0 n
o = fcoff 6
n = get fcal 6
for i ulong n bound 39
put qnag i get fcbig add o i
end
put qnagl 0 n
if not qnseal
ret 6
end
ret 0
end
fn fcid to bool
n = get fxol 0
p = ulong 0
got = false
while lt p n bound 16777216
if and le add p 40 n fcis p
same = true
for i ulong 40
if ne get fxo add p i get qncm i
same = false
end
end
if not same
for i ulong 40
put qnid i get fxo add p i
end
got = true
end
p = add p 40
end
if not fcis p
p = add p 1
end
end
ret got
end
fn fcis p ulong to bool
if gt add p 40 get fxol 0
ret false
end
for i ulong 40
if not fchex get fxo add p i
ret false
end
end
if lt add p 40 get fxol 0
if fchex get fxo add p 40
ret false
end
end
ret true
end
fn fcpush to long
fcenv
fcgit
fka tcpush
fka tco
fkopen
fkt tcpm
fcarg 3
fka tcrad
fka tcref
r = fcrun
if ne r 0
ret 7
end
if not fcid
ret 7
end
fcenv
fcrad
fka tcped
fka tcedit
fkopen
for i ulong 40
fkc get qnid i
end
fka tcrepo
fkopen
fkt tcradp2
fcarg 0
fka tcna
fka tcmsg
fcnew 3
fka tcmsg
fkopen
for i ulong get qnrcl 0 bound 1024
fkc get qnrc i
end
r = fcrun
if ne r 0
ret 7
end
ret 0
end
fn fcreview to long
fcenv
fcrad
fka tcped
fka tcrev
fkopen
for i ulong 40
fkc get qnid i
end
fka tcrepo
fkopen
fkt tcradp2
fcarg 0
fka tcna
fka tcmsg
fka tcreq
ret fcrun
end
fn fcdata to void
buf = new uchar 320 0
o = fcoff 10
n = get fcal 10
for i ulong n bound 320
put buf i get fcbig add o i
end
qnsetd buf n
end
fn fcdigest to long
fcdata
o = fcoff 7
put qnlinel 0 0
for i ulong len tcped
put qnline i get tcped i
end
put qnlinel 0 len tcped
put qnline get qnlinel 0 32
put qnlinel 0 add get qnlinel 0 1
o = fcoff 7
for i ulong get fcal 7 bound 39
put qnline add get qnlinel 0 i get fcbig add o i
end
put qnlinel 0 add get qnlinel 0 get fcal 7
put qnline get qnlinel 0 32
put qnlinel 0 add get qnlinel 0 1
o = fcoff 6
for i ulong get fcal 6 bound 39
put qnline add get qnlinel 0 i get fcbig add o i
end
put qnlinel 0 add get qnlinel 0 get fcal 6
put qnline get qnlinel 0 32
put qnlinel 0 add get qnlinel 0 1
for i ulong 40
put qnline add get qnlinel 0 i get qnid i
end
put qnlinel 0 add get qnlinel 0 40
put qnline get qnlinel 0 32
put qnlinel 0 add get qnlinel 0 1
for i ulong 40
put qnline add get qnlinel 0 i get qncm i
end
put qnlinel 0 add get qnlinel 0 40
put qnline get qnlinel 0 10
put qnlinel 0 add get qnlinel 0 1
if not qnapp
ret 9
end
if not qnregen
ret 9
end
ret 0
end
fn fcprint to void
k = write 1 tcok1 0 len tcok1
for i ulong 40
k = write 1 qnid i 1
end
k = write 1 tcnl 0 1
k = write 1 tcok2 0 len tcok2
for i ulong 40
k = write 1 qncm i 1
end
k = write 1 tcnl 0 1
end
note fcfail: print the failing step's captured output (up to 4096 bytes) on stderr, return its exit code
fn fcfail code int to int
k = write 2 tcfail 0 len tcfail
n = get fxol 0
if gt n 4096
n = ulong 4096
end
k = write 2 fxo 0 n
k = write 2 tcnl 0 1
ret code
end
fn main to int
r = fcload
if ne r 0
ret int r
end
if not fcvalid
ret 2
end
r = fcclone
if ne r 0
ret fcfail 3
end
r = fcbranch
if ne r 0
ret fcfail 3
end
r = fccopy
if ne r 0
ret int r
end
r = fcadd
if ne r 0
ret fcfail 5
end
r = fccommit
if ne r 0
ret fcfail 5
end
r = fchead
if ne r 0
ret fcfail int r
end
r = fcevid
if ne r 0
ret int r
end
r = fcpush
if ne r 0
ret fcfail int r
end
r = fcreview
if ne r 0
ret fcfail 8
end
r = fcdigest
if ne r 0
ret int r
end
fcprint
ret 0
end

fn snaplic to void
buf = new uchar 128 0
s = ulong 0
found = false
for i ulong len tlics bound 9223372036854775807
if eq get tlics i 10
n = sub i s
r = lstat tlics s n buf 0 len buf
if ge r 0
fd = openreg part tlics s n

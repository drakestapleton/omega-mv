while lt p ulong r bound 9223372036854775807
n = rd16 buf add p 16
if or lt n 20 gt add p n ulong r
die mnofile
end
j = add p 19
e = j
while lt e add p n bound 9223372036854775807
if eq get buf e 0
break
end
e = add e 1
end
if ge sub e j 4
if bati part buf j sub e j sub sub e j 4 tpdf
filecopy part buf j sub e j
count = add count 1
end
end
p = add p n
end

note Compare to the exact submitted bytes, including after exchange to close the pre-rename gap.
fn samejson fd int to bool
buf = new uchar 65536 0
p = ulong 0
while true bound 9223372036854775807
r = pread fd buf 0 len buf long p
if eq r -4
continue
end
if lt r 0
ret false
end
if eq r 0
ret eq p get gn 0
end
if gt add p ulong r get gn 0
ret false
end
for i ulong ulong r bound 9223372036854775807
if ne get buf i get gj add p i
ret false
end
end
p = add p ulong r
end
ret false
end

fn namedok p view uchar * to bool
fd = openreg p
if lt fd 0
ret false
end
ok = samejson int fd
x = fclose int fd
ret and ok ge x 0
end

fn recvdoi d edit uchar * to ulong
n = ulong 0
while lt n len d bound 9223372036854775807
if ne getppid get gparent 0
die mipc
end
r = read 0 d n 1
if eq r -4
continue
end
if or eq r -11 eq r 0
note EOF before the shell opens its writer is not failure; parent monitors consumer lifetime.
x = waitio 0 1 10000000
if lt x 0
if ne x -4
die mipc
end
end
continue
end
if lt r 0
die mread
end
if eq get d n 10
ret n
end
n = add n 1
end
die mbaddoi
ret 0
end

note candino: the file named p is the retained candidate inode (st_dev at 0, st_ino at 8)
fn candino p view uchar * to bool
fd = openreg p
if lt fd 0
ret false

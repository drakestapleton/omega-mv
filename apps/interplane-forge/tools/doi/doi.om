om2
note tools/doi/doi.om: the engine of tools/doi/doi.sh, which reserves a Zenodo DOI for a paper
note repository. doi.sh is the command authors run; it calls these subcommands:
note   token                  ZENODO_TOKEN is set and safe inside a quoted curl config line (never printed)
note   base MODE              the API base for MODE, sandbox (the default of doi.sh) or production
note   check REPO FILE...     .zenodo.json, LICENSE and the files to upload; every problem on stderr, exit 1
note   body REPO              the create request: .zenodo.json as metadata, with prereserve_doi
note   pick MODE FILE WHAT    one checked value of a Zenodo answer: bucket publish html doi pubdoi key size message
note   setdoi MODE REPO DOI   writes "doi" into .zenodo.json as its first member; every other byte is kept
note   consent MODE DOI       asks on /dev/tty; exit 0 only when the line typed there is exactly yes
note JSON: a file is read whole into gj and checked by recursive descent (modelled on
note harness-observe tools/jflat.om at 92eba82c, not vendored). Nesting is limited by the 8 MiB stack
note (trap 6, exit 106). gj holds 16777216 bytes, the largest global array the pinned omc builds (it
note has no run-time growth); a file of 16777216 bytes or more is refused with a message. gj is
note zero-filled and read once, so gj[n] after the n bytes read is 0: lookahead there needs no check.
note Every loop that walks input carries the largest bound: each pass consumes at least one byte.

global gj uchar 16777216
global gn ulong 1
global gmode ulong 1
global gprod uchar 1
global gbad uchar 1

text tpfx "doi: "
text tnl "\n"
text tsp " "
text tind "  "
text tcolon ": "
text tusage "usage: doi token | base MODE | check REPO FILE... | body REPO | pick MODE FILE WHAT | setdoi MODE REPO DOI | consent MODE DOI\n(MODE is sandbox or production. Authors run tools/doi/doi.sh, not this program.)\n"
text wtoken "token"
text wbase "base"
text wcheck "check"
text wbody "body"
text wpick "pick"
text wsetdoi "setdoi"
text wconsent "consent"
text wpubdoi "pubdoi"
text ktitle "title"
text kdesc "description"
text kcreat "creators"
text kname "name"
text klic "license"
text kid "id"
text kupt "upload_type"
text kpubt "publication_type"
text kimgt "image_type"
text kdoi "doi"
text kpre "prereserve_doi"
text klinks "links"
text kbucket "bucket"
text kpublish "publish"
text khtml "html"
text kmeta "metadata"
text ksize "size"
text kkey "key"
text kmsg "message"
text kerrs "errors"
text kfield "field"
text kmsgs "messages"
text ktrue "true"
text kfalse "false"
text knull "null"
text tpub "publication"
text timage "image"
text tuptl "poster\npresentation\ndataset\nvideo\nsoftware\nlesson\nphysicalobject\nother\n"
text tlics "LICENSE\nLICENSE.md\nLICENSE.txt\nLICENCE\nCOPYING\n"
text tzj ".zenodo.json"
text tznew ".zenodo.json.doi-new"
text ttty "/dev/tty"
text tzpfx "ZENODO_TOKEN="
text tsand "sandbox"
text tprod "production"
text osand "https://sandbox.zenodo.org"
text oprod "https://zenodo.org"
text papi "/api"
text pfiles "/api/files/"
text pdep "/api/deposit/depositions/"
text phtml "/"
text sactpub "/actions/publish"
text dsand "10.5072/"
text dprod "10.5281/"
text tpdf ".pdf"
text thead "{\"metadata\":{\"prereserve_doi\":true,"
text ttail "}}\n"
text tdoiq "\"doi\": \""
text tqc "\","
text tyes "yes"
text mbig " is 16777216 bytes or longer (the largest array the pinned omc builds)"
text mopen "cannot open "
text mread "cannot read "
text mnotobj ".zenodo.json is not one JSON object (check its commas, quotes and brackets)"
text mmiss ".zenodo.json: missing or not a string: "
text mempty ".zenodo.json: empty: "
text mcrarr ".zenodo.json: creators must be an array of objects, each with a non-empty \"name\" (\"Family, Given\")"
text mcrnone ".zenodo.json: creators is empty: name at least one author"
text mlic ".zenodo.json: license must be a non-empty string such as \"cc-by-4.0\", or an object with a non-empty \"id\""
text mupt ".zenodo.json: upload_type must be one of publication poster presentation dataset image video software lesson physicalobject other"
text mhasdoi ".zenodo.json already has a \"doi\": one was reserved before. Publish or delete that draft on Zenodo; remove the line only to reserve a new DOI"
text mhaspre ".zenodo.json must not set prereserve_doi: this tool sets it"
text mesck ".zenodo.json: a top-level key holds a backslash escape; write keys plainly"
text mnolic "no LICENSE file at the top of the repository (LICENSE, LICENSE.md, LICENSE.txt, LICENCE or COPYING, not empty)"
text mnofile "no file to upload: put the paper's PDF at the top of the repository"
text mnopdf "no PDF among the files to upload: the paper's PDF is required"
text mfname "a file name may hold only A-Z a-z 0-9 - . _ and must not start with a dot: "
text mnotreg "not a non-empty regular file: "
text mdup "two files to upload share the name "
text mlong "an argument is longer than 4095 bytes"
text mmode "MODE must be sandbox or production, not "
text mcd "cannot enter the repository "
text mnotok "Zenodo's answer is not one JSON object: "
text mabsent "Zenodo's answer lacks a usable "
text murlbad "Zenodo answer has a missing or invalid HTTPS URL"
text murl "refused: Zenodo's answer points outside "
text mbaddoi "refused: not a DOI under "
text mwhat "WHAT must be bucket publish html doi pubdoi key size or message, not "
text mwrite "cannot write "
text mrename "cannot replace .zenodo.json; it is unchanged"
text mtokno "ZENODO_TOKEN is not set: create a personal access token on Zenodo (scopes deposit:write and deposit:actions) and export it in this shell only"
text mtokbad "ZENODO_TOKEN holds a byte other than A-Z a-z 0-9 - . _ ~ + / = (the token is never printed)"
text mnotty "no terminal at /dev/tty: publishing needs the author to type yes there; nothing was published"
text qpub1 "\nPublish "
text qpub2 " on "
text qsand "?\nThis is the Zenodo sandbox: a test record whose DOI is never registered.\n"
text qprod "?\nThis is production Zenodo: the DOI is registered for good, and a published record and its files can never be deleted.\n"
text qpub3 "Type yes to publish; anything else keeps the draft unpublished: "

note ---- output and exits
fn wall fd int b view uchar * to bool
n = ulong 0
while lt n len b bound 9223372036854775807
r = write fd b n sub len b n
if le r 0
ret false
end
n = add n ulong r
end
ret true
end

fn say b view uchar * to void
x = wall 1 b
end

fn warn b view uchar * to void
x = wall 2 b
end

note outc: untrusted bytes (Zenodo's text, paths) with control bytes shown as '?'
fn outc fd int b view uchar * to void
o = new uchar 4096 0
n = ulong 0
for i ulong len b bound 9223372036854775807
c = get b i
if or lt c 32 eq c 127
c = uchar 63
end
put o n c
n = add n 1
if eq n 4096
x = wall fd part o 0 n
n = ulong 0
end
end
x = wall fd part o 0 n
end

fn usg to void
warn tusage
exit 2
end

fn die m view uchar * to void
warn tpfx
warn m
warn tnl
exit 1
end

fn die2 m view uchar * a view uchar * to void
warn tpfx
warn m
outc 2 a
warn tnl
exit 1
end

note bad, bad2: one problem on stderr; the command exits 1 after every check has run
fn bad m view uchar * to void
warn tpfx
warn m
warn tnl
put gbad 0 1
end

fn bad2 m view uchar * a view uchar * to void
warn tpfx
warn m
outc 2 a
warn tnl
put gbad 0 1
end

note ---- bytes
note cpy: copy s into d at n; returns the new end (d too short traps 3: callers size d first)
fn cpy d edit uchar * n ulong s view uchar * to ulong
for i ulong len s bound 9223372036854775807
put d add n i get s i
end
ret add n len s
end

fn beq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 9223372036854775807
if ne get a i get b i
ret false
end
end
ret true
end

note bat: b[i..] starts with t
fn bat b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne get b add i k get t k
ret false
end
end
ret true
end

fn lcb c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note bati: as bat, ASCII case-insensitive (t is lowercase)
fn bati b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne lcb get b add i k get t k
ret false
end
end
ret true
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn isaln c uchar to bool
a = and ge c 65 le c 90
b = and ge c 97 le c 122
ret or or a b isdig c
end

fn ishex c uchar to bool
if isdig c
ret true
end
a = and ge c 97 le c 102
b = and ge c 65 le c 70
ret or a b
end

note namech: a byte of a file name or of a URL or DOI path segment: A-Z a-z 0-9 - . _
fn namech c uchar to bool
if isaln c
ret true
end
ret or or eq c 45 eq c 46 eq c 95
end

note tokch: a token byte that cannot end or escape a double-quoted curl config value
fn tokch c uchar to bool
if namech c
ret true
end
ret or or eq c 126 eq c 43 or eq c 47 eq c 61
end

fn rd16 b view uchar * o ulong to ulong
ret or ulong get b o shl ulong get b add o 1 8
end

fn rd32 b view uchar * o ulong to ulong
lo = rd16 b o
ret or lo shl rd16 b add o 2 16
end

fn rd64 b view uchar * o ulong to ulong
lo = rd32 b o
ret or lo shl rd32 b add o 4 32
end

fn wr16 b edit uchar * o ulong v ulong to void
put b o uchar and v 255
put b add o 1 uchar and shr v 8 255
end

note ---- JSON in gj
fn isws c uchar to bool
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note ws: the first index at or after i that is not JSON whitespace (it stops at the 0 after the input)
fn ws i ulong to ulong
k = i
while isws get gj k bound 9223372036854775807
k = add k 1
end
ret k
end

fn isesc e uchar to bool
if or or eq e 34 eq e 92 eq e 47
ret true
end
if or or eq e 98 eq e 102 eq e 110
ret true
end
ret or eq e 114 eq e 116
end

note skstr: the index after the string whose opening quote is at i, or -1 when it is not one
fn skstr i ulong to long
if ne get gj i 34
ret -1
end
k = add i 1
n = get gn 0
while lt k n bound 9223372036854775807
c = get gj k
if eq c 34
ret long add k 1
end
if lt c 32
ret -1
end
if eq c 92
k = add k 1
e = get gj k
if eq e 117
for j ulong 4
k = add k 1
if ge k n
ret -1
end
if not ishex get gj k
ret -1
end
end
else
if not isesc e
ret -1
end
end
end
k = add k 1
end
ret -1
end

note atg: gj[i..] starts with t
fn atg i ulong t view uchar * to bool
if gt add i len t get gn 0
ret false
end
for k ulong len t bound 9223372036854775807
if ne get gj add i k get t k
ret false
end
end
ret true
end

fn digs k ulong to ulong
m = k
while isdig get gj m bound 9223372036854775807
m = add m 1
end
ret m
end

note sknum: the index after the JSON number at i, or -1
fn sknum i ulong to long
k = i
if eq get gj k 45
k = add k 1
end
if not isdig get gj k
ret -1
end
if eq get gj k 48
k = add k 1
else
k = digs k
end
if eq get gj k 46
k = add k 1
if not isdig get gj k
ret -1
end
k = digs k
end
c = get gj k
if or eq c 101 eq c 69
k = add k 1
c = get gj k
if or eq c 43 eq c 45
k = add k 1
end
if not isdig get gj k
ret -1
end
k = digs k
end
ret long k
end

fn sklit i ulong t view uchar * to long
if atg i t
ret long add i len t
end
ret -1
end

note skval: the index after the JSON value at i, or -1
fn skval i ulong to long
c = get gj i
if eq c 34
ret skstr i
end
if eq c 123
ret skobj i
end
if eq c 91
ret skarr i
end
if eq c 116
ret sklit i ktrue
end
if eq c 102
ret sklit i kfalse
end
if eq c 110
ret sklit i knull
end
ret sknum i
end

fn skobj i ulong to long
k = ws add i 1
if eq get gj k 125
ret long add k 1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = skstr k
if lt e 0
ret -1
end
k = ws ulong e
if ne get gj k 58
ret -1
end
e = skval ws add k 1
if lt e 0
ret -1
end
k = ws ulong e
c = get gj k
if eq c 125
ret long add k 1
end
if ne c 44
ret -1
end
k = ws add k 1
end
ret -1
end

fn skarr i ulong to long
k = ws add i 1
if eq get gj k 93
ret long add k 1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = skval k
if lt e 0
ret -1
end
k = ws ulong e
c = get gj k
if eq c 93
ret long add k 1
end
if ne c 44
ret -1
end
k = ws add k 1
end
ret -1
end

note docok: gj holds exactly one JSON object, with only whitespace around it
fn docok to bool
k = ws 0
if ne get gj k 123
ret false
end
e = skobj k
if lt e 0
ret false
end
ret eq ws ulong e get gn 0
end

note mem: where the value of member ky starts in the checked object at o, or -1
fn mem o ulong ky view uchar * to long
k = ws add o 1
if eq get gj k 125
ret -1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = ulong skstr k
hit = and eq sub sub e k 2 len ky atg add k 1 ky
v = ws add ws e 1
if hit
ret long v
end
k = ws ulong skval v
if eq get gj k 125
ret -1
end
k = ws add k 1
end
ret -1
end

note mtyp: as mem, and -1 when the value does not start with byte c (34 string, 123 object, 91 array)
fn mtyp o ulong ky view uchar * c uchar to long
v = mem o ky
if lt v 0
ret -1
end
if ne get gj ulong v c
ret -1
end
ret v
end

note inner: the string member b of the member a (of kind c) of the object at t, or -1
fn inner t ulong a view uchar * c uchar b view uchar * to long
v = mtyp t a c
if lt v 0
ret -1
end
ret mtyp ulong v b 34
end

note nonemp: v is a string with at least one byte between its quotes
fn nonemp v long to bool
if lt v 0
ret false
end
u = ulong v
if ne get gj u 34
ret false
end
ret gt sub sub ulong skstr u u 2 0
end

note streq: the string at v is exactly t as written (no escapes)
fn streq v ulong t view uchar * to bool
e = ulong skstr v
ret and eq sub sub e v 2 len t atg add v 1 t
end

note inlist: the string at v is one of the lines of l
fn inlist v ulong l view uchar * to bool
s = ulong 0
for i ulong len l bound 9223372036854775807
if eq get l i 10
if streq v part l s sub i s
ret true
end
s = add i 1
end
end
ret false
end

fn unesc e uchar to uchar
if eq e 98
ret 8
end
if eq e 102
ret 12
end
if eq e 110
ret 10
end
if eq e 114
ret 13
end
if eq e 116
ret 9
end
if eq e 117
ret 127
end
ret e
end

note sdec: the string at v (its opening quote) decoded into o; returns its length. \uXXXX becomes
note byte 127, which every check refuses and outc shows as '?'. When o is too short: with cut its
note first len o bytes, else -1.
fn sdec v ulong o edit uchar * cut bool to long
e = sub ulong skstr v 1
k = add v 1
m = ulong 0
while lt k e bound 9223372036854775807
c = get gj k
if eq c 92
k = add k 1
c = unesc get gj k
if eq get gj k 117
k = add k 4
end
end
if ge m len o
if cut
ret long m
end
ret -1
end
put o m c
m = add m 1
k = add k 1
end
ret long m
end

note wgj: write gj[s..e) to fd
fn wgj fd int s ulong e ulong to bool
n = s
while lt n e bound 9223372036854775807
r = write fd gj n sub e n
if le r 0
ret false
end
n = add n ulong r
end
ret true
end

note slurp: the whole file p into gj; its permission bits into gmode
fn slurp p view uchar * to void
fd = fopen p 0 len p 524288 0
if lt fd 0
die2 mopen p
end
st = new uchar 128 0
x = fstat int fd st 0 128
if lt x 0
die2 mread p
end
put gmode 0 and rd32 st 16 4095
n = ulong 0
while true bound 9223372036854775807
r = read int fd gj n sub 16777216 n
if eq r -4
continue
end
if lt r 0
die2 mread p
end
if eq r 0
break
end
n = add n ulong r
if eq n 16777216
die2 p mbig
end
end
x = fclose int fd
put gn 0 n
end

note ---- .zenodo.json rules
fn need t ulong ky view uchar * to void
v = mtyp t ky 34
if lt v 0
bad2 mmiss ky
ret
end
if not nonemp v
bad2 mempty ky
end
end

fn crs t ulong to void
a = mtyp t kcreat 91
if lt a 0
bad mcrarr
ret
end
k = ws add ulong a 1
if eq get gj k 93
bad mcrnone
ret
end
n = get gn 0
while lt k n bound 9223372036854775807
if ne get gj k 123
bad mcrarr
ret
end
if not nonemp mtyp k kname 34
bad mcrarr
ret
end
k = ws ulong skval k
if eq get gj k 93
ret
end
k = ws add k 1
end
end

fn lic t ulong to void
v = mem t klic
if lt v 0
bad2 mmiss klic
ret
end
if eq get gj ulong v 123
v = mtyp ulong v kid 34
end
if not nonemp v
bad mlic
end
end

fn upt t ulong to void
v = mtyp t kupt 34
if lt v 0
bad2 mmiss kupt
ret
end
u = ulong v
if streq u tpub
need t kpubt
ret
end
if streq u timage
need t kimgt
ret
end
if not inlist u tuptl
bad mupt
end
end

note pkeys: no top-level key holds an escape, so mem sees every key as written
fn pkeys t ulong to void
k = ws add t 1
if eq get gj k 125
ret
end
n = get gn 0
while lt k n bound 9223372036854775807
e = ulong skstr k
for j ulong sub sub e k 2 bound 9223372036854775807
if eq get gj add add k 1 j 92
bad mesck
ret
end
end
k = ws ulong skval ws add ws e 1
if eq get gj k 125
ret
end
k = ws add k 1
end
end

note meta: every rule for .zenodo.json (in gj); problems go to bad
fn meta to void
if not docok
bad mnotobj
ret
end
t = ws 0
pkeys t
need t ktitle
need t kdesc
crs t
lic t
upt t
if ge mem t kdoi 0
bad mhasdoi
end
if ge mem t kpre 0
bad mhaspre
end
end

note ---- files
note regfile: p names a regular file with at least one byte (opened non-blocking: a FIFO never waits)
fn regfile p view uchar * to bool
fd = fopen p 0 len p 526336 0
if lt fd 0
ret false
end
st = new uchar 128 0
x = fstat int fd st 0 128
y = fclose int fd
if lt x 0
ret false
end
if ne and rd32 st 16 61440 32768
ret false
end
ret gt rd64 st 48 0
end

fn bname p view uchar * to ulong
s = ulong 0
for i ulong len p bound 9223372036854775807
if eq get p i 47
s = add i 1
end
end
ret s
end

fn nameok p view uchar * s ulong to bool
if ge s len p
ret false
end
if eq get p s 46
ret false
end
for i ulong sub len p s bound 9223372036854775807
if not namech get p add s i
ret false
end
end
ret true
end

note fchk: one file to upload; true when it is a PDF
fn fchk p view uchar * to bool
s = bname p
if not nameok p s
bad2 mfname p
ret false
end
if not regfile p
bad2 mnotreg p
ret false
end
if lt len p 4
ret false
end
ret bati p sub len p 4 tpdf
end

note samename: compare base names without keeping both sliced views live in the argument loop
fn samename p view uchar * b view uchar * to bool
s = bname p
t = bname b
n = sub len p s
if ne n sub len b t
ret false
end
for j ulong n bound 9223372036854775807
if ne get p add s j get b add t j
ret false
end
end
ret true
end

note dupchk: no later file argument shares the base name of argument i (p)
fn dupchk i ulong ac ulong p view uchar * to void
b = new uchar 4096 0
for j ulong sub sub ac i 1 bound 9223372036854775807
k = getarg add add i j 1 b
if samename p part b 0 k
bad2 mdup p
ret
end
end
end

fn licok to bool
s = ulong 0
for i ulong len tlics bound 9223372036854775807
if eq get tlics i 10
if regfile part tlics s sub i s
ret true
end
s = add i 1
end
end
ret false
end

note ---- arguments and mode
fn getarg i ulong b edit uchar * to ulong
r = argread i b 0 len b
if lt r 0
die mlong
end
ret ulong r
end

fn setmode i ulong to void
b = new uchar 4096 0
k = getarg i b
if beq part b 0 k tsand
put gprod 0 0
ret
end
if beq part b 0 k tprod
put gprod 0 1
ret
end
die2 mmode part b 0 k
end

note origin: the scheme and host of the mode, without a final slash
fn origin o edit uchar * to ulong
if eq get gprod 0 1
ret cpy o 0 oprod
end
ret cpy o 0 osand
end

note dpfx: the DOI prefix the mode's Zenodo mints under
fn dpfx o edit uchar * to ulong
if eq get gprod 0 1
ret cpy o 0 dprod
end
ret cpy o 0 dsand
end

fn cdrepo i ulong to void
b = new uchar 4096 0
k = getarg i b
r = chdir b 0 k
if lt r 0
die2 mcd part b 0 k
end
end

note urlok: u is p and then at least one byte of A-Z a-z 0-9 - . _ /
fn urlok u view uchar * p view uchar * to bool
if le len u len p
ret false
end
if not bat u 0 p
ret false
end
for i ulong sub len u len p bound 9223372036854775807
c = get u add len p i
if not namech c
if ne c 47
ret false
end
end
end
ret true
end

fn endsw u view uchar * t view uchar * to bool
if lt len u len t
ret false
end
ret bat u sub len u len t t
end

fn doichk d view uchar * to void
p = new uchar 16 0
k = dpfx p
if not urlok d part p 0 k
warn tpfx
warn mbaddoi
warn part p 0 k
warn tcolon
outc 2 d
warn tnl
exit 1
end
end

note ---- commands
fn dotoken to int
b = new uchar 131073 0
n = ulong envcnt
for i ulong n bound 9223372036854775807
r = envread i b 0 131073
if lt r 0
continue
end
k = ulong r
if bat part b 0 k 0 tzpfx
if eq k len tzpfx
die mtokno
end
for j ulong sub k len tzpfx bound 9223372036854775807
if not tokch get b add len tzpfx j
die mtokbad
end
end
ret 0
end
end
die mtokno
ret 1
end

fn dobase ac ulong to int
if ne ac 3
usg
end
setmode 2
b = new uchar 64 0
k = origin b
k = cpy b k papi
say part b 0 k
say tnl
ret 0
end

fn docheck ac ulong to int
if lt ac 3
usg
end
a = new uchar 4096 0
pdfs = ulong 0
for j ulong sub ac 3 bound 9223372036854775807
i = add j 3
k = getarg i a
if fchk part a 0 k
pdfs = add pdfs 1
end
dupchk i ac part a 0 k
end
if eq ac 3
bad mnofile
else
if eq pdfs 0
bad mnopdf
end
end
cdrepo 2
if not licok
bad mnolic
end
slurp tzj
meta
ret int get gbad 0
end

fn dobody ac ulong to int
if ne ac 3
usg
end
cdrepo 2
slurp tzj
meta
if eq get gbad 0 1
ret 1
end
t = ws 0
e = sub ulong skobj t 1
say thead
if not wgj 1 add t 1 e
ret 1
end
say ttail
ret 0
end

note pkurl: kind 1 bucket, 2 publish, 3 html; the string must match its mode and path
fn pkurl v long kind int to int
if lt v 0
die murlbad
end
b = new uchar 65536 0
m = sdec ulong v b false
o = new uchar 128 0
k = origin o
if eq kind 1
k = cpy o k pfiles
end
if eq kind 2
k = cpy o k pdep
end
if eq kind 3
k = cpy o k phtml
end
if lt m 0
die2 murl part o 0 k
end
um = ulong m
ok = urlok part b 0 um part o 0 k
if eq kind 2
if not endsw part b 0 um sactpub
ok = false
end
end
if not ok
warn tpfx
warn murl
warn part o 0 k
warn tcolon
outc 2 part b 0 um
warn tnl
exit 1
end
say part b 0 um
say tnl
ret 0
end

fn pkdoi v long ky view uchar * to int
if lt v 0
die2 mabsent ky
end
b = new uchar 4096 0
m = sdec ulong v b false
if lt m 0
die2 mabsent ky
end
um = ulong m
doichk part b 0 um
say part b 0 um
say tnl
ret 0
end

fn pkname t ulong to int
v = mtyp t kkey 34
if lt v 0
die2 mabsent kkey
end
b = new uchar 4096 0
m = sdec ulong v b false
if lt m 0
die2 mabsent kkey
end
um = ulong m
if not nameok part b 0 um 0
die2 mfname kkey
end
say part b 0 um
say tnl
ret 0
end

fn pksize t ulong to int
v = mem t ksize
if lt v 0
die2 mabsent ksize
end
u = ulong v
d = digs u
e = sknum u
if or eq d u ne long d e
die2 mabsent ksize
end
x = wgj 1 u d
say tnl
ret 0
end

fn saystr v ulong to void
b = new uchar 65536 0
m = sdec v b true
outc 1 part b 0 ulong m
end

fn msgs a ulong to void
k = ws add a 1
n = get gn 0
while lt k n bound 9223372036854775807
if ne get gj k 34
ret
end
say tsp
saystr k
k = ws ulong skstr k
if ne get gj k 44
ret
end
k = ws add k 1
end
end

note errs: Zenodo's per-field errors, one line each: field: messages
fn errs a ulong to void
k = ws add a 1
n = get gn 0
while lt k n bound 9223372036854775807
if ne get gj k 123
ret
end
say tind
f = mtyp k kfield 34
if ge f 0
saystr ulong f
say tcolon
end
ms = mtyp k kmsgs 91
if ge ms 0
msgs ulong ms
end
say tnl
k = ws ulong skval k
if ne get gj k 44
ret
end
k = ws add k 1
end
end

fn pkmsg t ulong to int
v = mtyp t kmsg 34
if ge v 0
saystr ulong v
say tnl
end
a = mtyp t kerrs 91
if ge a 0
errs ulong a
end
ret 0
end

fn dopick ac ulong to int
if ne ac 5
usg
end
setmode 2
p = new uchar 4096 0
k = getarg 3 p
slurp part p 0 k
if not docok
die2 mnotok part p 0 k
end
w = new uchar 4096 0
m = getarg 4 w
t = ws 0
if beq part w 0 m kbucket
ret pkurl inner t klinks 123 kbucket 1
end
if beq part w 0 m kpublish
ret pkurl inner t klinks 123 kpublish 2
end
if beq part w 0 m khtml
ret pkurl inner t klinks 123 khtml 3
end
if beq part w 0 m kdoi
a = mtyp t kmeta 123
if lt a 0
die2 mabsent kmeta
end
z = mtyp ulong a kpre 123
if lt z 0
die2 mabsent kpre
end
ret pkdoi mtyp ulong z kdoi 34 kdoi
end
if beq part w 0 m wpubdoi
ret pkdoi mtyp t kdoi 34 kdoi
end
if beq part w 0 m kkey
ret pkname t
end
if beq part w 0 m ksize
ret pksize t
end
if beq part w 0 m kmsg
ret pkmsg t
end
die2 mwhat part w 0 m
ret 2
end

note zwrite: .zenodo.json with "doi" as its first member: the bytes up to and with the opening
note brace, the whitespace after it, the doi member, that whitespace again, then the rest unchanged
fn zwrite fd int d view uchar * to bool
t = ws 0
w = ws add t 1
a = wgj fd 0 w
b = wall fd tdoiq
c = wall fd d
e = wall fd tqc
f = wgj fd add t 1 w
g = wgj fd w get gn 0
ret and and and a b and c e and f g
end

note zrepl: rename .zenodo.json.doi-new over .zenodo.json (one step: the old file or the new one)
fn zrepl to void
pk = new uchar 64 0
wr16 pk 0 2
wr16 pk 2 len tznew
k = cpy pk 4 tznew
wr16 pk k len tzj
k = cpy pk add k 2 tzj
r = renames pk 0 k 0
if lt r 0
x = unlink tznew 0 len tznew
die mrename
end
end

fn dosetd ac ulong to int
if ne ac 5
usg
end
setmode 2
d = new uchar 4096 0
dn = getarg 4 d
doichk part d 0 dn
cdrepo 3
slurp tzj
meta
if eq get gbad 0 1
ret 1
end
fd = fopen tznew 0 len tznew 524481 int get gmode 0
if lt fd 0
die2 mwrite tznew
end
ok = zwrite int fd part d 0 dn
y = fsync int fd
z = fclose int fd
if or not ok or lt y 0 lt z 0
x = unlink tznew 0 len tznew
die2 mwrite tznew
end
zrepl
ret 0
end

note yesline: one line from fd is exactly yes (end of input before the newline is a no)
fn yesline fd int to bool
b = new uchar 1 0
a = new uchar 3 0
n = ulong 0
ok = true
while true bound 9223372036854775807
r = read fd b 0 1
if eq r -4
continue
end
if le r 0
ok = false
break
end
if eq get b 0 10
break
end
if lt n 3
put a n get b 0
else
ok = false
end
n = add n 1
end
ret and ok and eq n 3 beq a tyes
end

note question: every part of the prompt must reach the tty before an answer is read
fn question fd int d view uchar * to bool
o = new uchar 128 0
k = origin o
if not wall fd qpub1
ret false
end
if not wall fd d
ret false
end
if not wall fd qpub2
ret false
end
if not wall fd part o 0 k
ret false
end
if eq get gprod 0 1
if not wall fd qprod
ret false
end
else
if not wall fd qsand
ret false
end
end
ret wall fd qpub3
end

note docons: the question and the answer both go through /dev/tty, never stdin or stdout, so no
note pipe or file can answer it; no terminal means no
fn docons ac ulong to int
if ne ac 4
usg
end
setmode 2
d = new uchar 4096 0
dn = getarg 3 d
doichk part d 0 dn
fd = fopen ttty 0 len ttty 524290 0
if lt fd 0
warn tpfx
warn mnotty
warn tnl
ret 1
end
ok = question int fd part d 0 dn
if ok
ok = yesline int fd
end
y = fclose int fd
if ok
ret 0
end
ret 1
end

fn main to int
ac = ulong argcnt
if lt ac 2
usg
end
c = new uchar 4096 0
k = getarg 1 c
if beq part c 0 k wtoken
if ne ac 2
usg
end
ret dotoken
end
if beq part c 0 k wbase
ret dobase ac
end
if beq part c 0 k wcheck
ret docheck ac
end
if beq part c 0 k wbody
ret dobody ac
end
if beq part c 0 k wpick
ret dopick ac
end
if beq part c 0 k wsetdoi
ret dosetd ac
end
if beq part c 0 k wconsent
ret docons ac
end
usg
ret 2
end

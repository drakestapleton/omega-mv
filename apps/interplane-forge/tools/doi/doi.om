note One bucket component; publish/html bind exact decimal create id, no slash/dot normalization.
fn idmatch b view uchar * to bool
v = mem ws 0 kid
if lt v 0
ret false
end
u = ulong v
e = digs u
if or eq e u ne long e sknum u
ret false
end
if ne len b sub e u
ret false
end
for i ulong len b bound 9223372036854775807
if ne get b i get gj add u i
ret false
end
end
ret true
end

fn epok b view uchar * kind int to bool
if eq kind 1
if eq len b 0
ret false
end
for i ulong len b bound 9223372036854775807
c = get b i
if not or isaln c eq c 45
ret false
end
end
ret true
end
if eq kind 2
if not endsw b sactpub
ret false
end
ret idmatch part b 0 sub len b len sactpub
end
if bat b 0 hdep
ret idmatch part b len hdep sub len b len hdep
end
if bat b 0 hrec
ret idmatch part b len hrec sub len b len hrec
end
ret false
end

note pkurl: kind 1 bucket, 2 publish, 3 html; the string must match its mode and path
fn pkurl v long kind int to int
if lt v 0
die murlbad
end
b = new uchar 65536 0
m = sdec ulong v b false
o = new uchar 128 0
k = origin o
if eq kind 1
k = cpy o k pfiles
end
if eq kind 2
k = cpy o k pdep
end
if eq kind 3
k = cpy o k phtml
end
if lt m 0
die2 murl part o 0 k
end
um = ulong m
ok = urlok part b 0 um part o 0 k
if ok
ok = epok part b k sub um k kind
end
if not ok
warn tpfx
warn murl
warn part o 0 k
warn tcolon
outc 2 part b 0 um
warn tnl
exit 1
end
say part b 0 um
say tnl
ret 0
end

fn pkdoi v long ky view uchar * to int

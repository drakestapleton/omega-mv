om2
note tools/doi/doi.om: the engine of tools/doi/doi.sh, which reserves a Zenodo DOI for a paper
note repository. doi.sh is the command authors run; it calls these subcommands:
note   snapshot INPUT OUTPUT  copy a nofollow regular descriptor into an exclusive private output
note   token                  ZENODO_TOKEN is set and safe inside a quoted curl config line (never printed)
note   base MODE              the API base for MODE, sandbox (the default of doi.sh) or production
note   check REPO FILE...     .zenodo.json, LICENSE and the files to upload; every problem on stderr, exit 1
note   body REPO              the create request: .zenodo.json as metadata, with prereserve_doi
note   pick MODE FILE WHAT    one checked value of a Zenodo answer: bucket publish html doi pubdoi key size message
note   serve MODE REPO WORK [SOURCE] retains directory custody and metadata across the network phase
note   consent MODE DOI       asks on /dev/tty; exit 0 only when the line typed there is exactly yes
note JSON: a file is read whole into gj and checked by recursive descent (modelled on
note harness-observe tools/jflat.om at 92eba82c, not vendored). Nesting is limited by the 8 MiB stack
note (trap 6, exit 106). gj holds 16777216 bytes, the largest global array the pinned omc builds (it
note has no run-time growth); a file of 16777216 bytes or more is refused with a message. gj is
note zero-filled and read once, so gj[n] after the n bytes read is 0: lookahead there needs no check.
note Every loop that walks input carries the largest bound: each pass consumes at least one byte.

global gj uchar 16777216
global gn ulong 1
global gmode ulong 1
global gprod uchar 1
global gbad uchar 1
global gfd long 4
global gparent long 1

text tpfx "doi: "
text tnl "\n"
text tsp " "
text tind "  "
text tcolon ": "
text tusage "usage: doi token | base MODE | snapshot INPUT OUTPUT | check REPO FILE... | body REPO | pick MODE FILE WHAT | serve MODE REPO WORK [SOURCE] | consent MODE DOI\n(MODE is sandbox or production. Authors run tools/doi/doi.sh, not this program.)\n"
text wtoken "token"
text wbase "base"
text wcheck "check"
text wsnap "snapshot"
text wbody "body"
text wpick "pick"
text wserve "serve"
text tdot "."
text troot "/"
text tready "READY\n"
text tsaved "SAVED\n"
text tdone "DONE\n"
text tin "/in"
text mipc "keeper IPC failed"
text mkdead "keeper exited unsuccessfully; no upload permitted"
text tbody "body.json"
text tmcopy "repo/.zenodo.json"
text tfiles "files/"
text mdrift "metadata changed since submission; edit preserved, draft kept unpublished (see Draft and Reserved DOI above)"
text mcand "write-back candidate was replaced before exchange; original metadata restored, draft kept unpublished (see Draft and Reserved DOI above)"
text manchor "cannot anchor path without following symlinks: "
text mlock "another DOI writer holds this repository"
text wconsent "consent"
text wpubdoi "pubdoi"
text ktitle "title"
text kdesc "description"
text kcreat "creators"
text kname "name"
text klic "license"
text kid "id"
text kupt "upload_type"
text kpubt "publication_type"
text kimgt "image_type"
text kdoi "doi"
text kpre "prereserve_doi"
text klinks "links"
text kbucket "bucket"
text kpublish "publish"
text khtml "html"
text kmeta "metadata"
text ksize "size"
text kkey "key"
text kmsg "message"
text kerrs "errors"
text kfield "field"
text kmsgs "messages"
text ktrue "true"
text kfalse "false"
text knull "null"
text tpub "publication"
text timage "image"
text tuptl "poster\npresentation\ndataset\nvideo\nsoftware\nlesson\nphysicalobject\nother\n"
text tlics "LICENSE\nLICENSE.md\nLICENSE.txt\nLICENCE\nCOPYING\n"
text tzj ".zenodo.json"
text tznew ".zenodo.json.doi-new"
text ttty "/dev/tty"
text tzpfx "ZENODO_TOKEN="
text tsand "sandbox"
text tprod "production"
text osand "https://sandbox.zenodo.org"
text oprod "https://zenodo.org"
text papi "/api"
text pfiles "/api/files/"
text pdep "/api/deposit/depositions/"
text phtml "/"
text hdep "deposit/"
text hrec "records/"
text sactpub "/actions/publish"
text dsand "10.5072/"
text dprod "10.5281/"
text tpdf ".pdf"
text thead "{\"metadata\":{\"prereserve_doi\":true,"
text ttail "}}\n"
text tdoiq "\"doi\": \""
text tqc "\","
text tyes "yes"
text mbig " is 16777216 bytes or longer (the largest array the pinned omc builds)"
text mopen "cannot open "
text mread "cannot read "
text mnotobj ".zenodo.json is not one JSON object (check its commas, quotes and brackets)"
text mmiss ".zenodo.json: missing or not a string: "
text mempty ".zenodo.json: empty: "
text mcrarr ".zenodo.json: creators must be an array of objects, each with a non-empty \"name\" (\"Family, Given\")"
text mcrnone ".zenodo.json: creators is empty: name at least one author"
text mlic ".zenodo.json: license must be a non-empty string such as \"cc-by-4.0\", or an object with a non-empty \"id\""
text mupt ".zenodo.json: upload_type must be one of publication poster presentation dataset image video software lesson physicalobject other"
text mhasdoi ".zenodo.json already has a \"doi\": one was reserved before. Publish or delete that draft on Zenodo; remove the line only to reserve a new DOI"
text mhaspre ".zenodo.json must not set prereserve_doi: this tool sets it"
text mesck ".zenodo.json: a top-level key holds a backslash escape; write keys plainly"
text mnolic "no LICENSE file at the top of the repository (LICENSE, LICENSE.md, LICENSE.txt, LICENCE or COPYING, not empty)"
text mnofile "no file to upload: put the paper's PDF at the top of the repository"
text mnopdf "no PDF among the files to upload: the paper's PDF is required"
text mfname "a file name may hold only A-Z a-z 0-9 - . _ and must not start with a dot: "
text mnotreg "not a non-empty regular file, or a symlink (refused): "
text mdup "two files to upload share the name "
text mlong "an argument is longer than 4095 bytes"
text mmode "MODE must be sandbox or production, not "
text mcd "cannot enter the repository "
text mnotok "Zenodo's answer is not one JSON object: "
text mabsent "Zenodo's answer lacks a usable "
text murlbad "Zenodo answer has a missing or invalid HTTPS URL"
text murl "refused: Zenodo's answer points outside "
text mbaddoi "refused: not a DOI under "
text mwhat "WHAT must be bucket publish html doi pubdoi key size or message, not "
text mwrite "cannot write "
text mrename "cannot exchange metadata; inspect .zenodo.json and .zenodo.json.doi-new; nothing was published"
text mtokno "ZENODO_TOKEN is not set: create a personal access token on Zenodo (scopes deposit:write and deposit:actions) and export it in this shell only"
text mtokbad "ZENODO_TOKEN holds a byte other than A-Z a-z 0-9 - . _ ~ + / = (the token is never printed)"
text mnotty "no terminal at /dev/tty: publishing needs the author to type yes there; nothing was published"
text qpub1 "\nPublish "
text qpub2 " on "
text qsand "?\nThis is the Zenodo sandbox: a test record whose DOI is never registered.\n"
text qprod "?\nThis is production Zenodo: the DOI is registered for good, and a published record and its files can never be deleted.\n"
text qpub3 "Type yes to publish; anything else keeps the draft unpublished: "

note ---- output and exits
fn wall fd int b view uchar * to bool
n = ulong 0
while lt n len b bound 9223372036854775807
r = write fd b n sub len b n
if le r 0
ret false
end
n = add n ulong r
end
ret true
end

fn say b view uchar * to void
x = wall 1 b
end

fn warn b view uchar * to void
x = wall 2 b
end

note outc: untrusted bytes (Zenodo's text, paths) with control bytes shown as '?'
fn outc fd int b view uchar * to void
o = new uchar 4096 0
n = ulong 0
for i ulong len b bound 9223372036854775807
c = get b i
if or lt c 32 eq c 127
c = uchar 63
end
put o n c
n = add n 1
if eq n 4096
x = wall fd part o 0 n
n = ulong 0
end
end
x = wall fd part o 0 n
end

fn usg to void
warn tusage
exit 2
end

fn die m view uchar * to void
warn tpfx
warn m
warn tnl
exit 1
end

fn die2 m view uchar * a view uchar * to void
warn tpfx
warn m
outc 2 a
warn tnl
exit 1
end

note bad, bad2: one problem on stderr; the command exits 1 after every check has run
fn bad m view uchar * to void
warn tpfx
warn m
warn tnl
put gbad 0 1
end

fn bad2 m view uchar * a view uchar * to void
warn tpfx
warn m
outc 2 a
warn tnl
put gbad 0 1
end

note ---- bytes
note cpy: copy s into d at n; returns the new end (d too short traps 3: callers size d first)
fn cpy d edit uchar * n ulong s view uchar * to ulong
for i ulong len s bound 9223372036854775807
put d add n i get s i
end
ret add n len s
end

fn beq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 9223372036854775807
if ne get a i get b i
ret false
end
end
ret true
end

note bat: b[i..] starts with t
fn bat b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne get b add i k get t k
ret false
end
end
ret true
end

fn lcb c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

note bati: as bat, ASCII case-insensitive (t is lowercase)
fn bati b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne lcb get b add i k get t k
ret false
end
end
ret true
end

fn isdig c uchar to bool
ret and ge c 48 le c 57
end

fn isaln c uchar to bool
a = and ge c 65 le c 90
b = and ge c 97 le c 122
ret or or a b isdig c
end

fn ishex c uchar to bool
if isdig c
ret true
end
a = and ge c 97 le c 102
b = and ge c 65 le c 70
ret or a b
end

note namech: a byte of a file name or of a URL or DOI path segment: A-Z a-z 0-9 - . _
fn namech c uchar to bool
if isaln c
ret true
end
ret or or eq c 45 eq c 46 eq c 95
end

note tokch: a token byte that cannot end or escape a double-quoted curl config value
fn tokch c uchar to bool
if namech c
ret true
end
ret or or eq c 126 eq c 43 or eq c 47 eq c 61
end

fn rd16 b view uchar * o ulong to ulong
ret or ulong get b o shl ulong get b add o 1 8
end

fn rd32 b view uchar * o ulong to ulong
lo = rd16 b o
ret or lo shl rd16 b add o 2 16
end

fn rd64 b view uchar * o ulong to ulong
lo = rd32 b o
ret or lo shl rd32 b add o 4 32
end

fn wr16 b edit uchar * o ulong v ulong to void
put b o uchar and v 255
put b add o 1 uchar and shr v 8 255
end

note ---- JSON in gj
fn isws c uchar to bool
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note ws: the first index at or after i that is not JSON whitespace (it stops at the 0 after the input)
fn ws i ulong to ulong
k = i
while isws get gj k bound 9223372036854775807
k = add k 1
end
ret k
end

fn isesc e uchar to bool
if or or eq e 34 eq e 92 eq e 47
ret true
end
if or or eq e 98 eq e 102 eq e 110
ret true
end
ret or eq e 114 eq e 116
end

note skstr: the index after the string whose opening quote is at i, or -1 when it is not one
fn skstr i ulong to long
if ne get gj i 34
ret -1
end
k = add i 1
n = get gn 0
while lt k n bound 9223372036854775807
c = get gj k
if eq c 34
ret long add k 1
end
if lt c 32
ret -1
end
if eq c 92
k = add k 1
e = get gj k
if eq e 117
for j ulong 4
k = add k 1
if ge k n
ret -1
end
if not ishex get gj k
ret -1
end
end
else
if not isesc e
ret -1
end
end
end
k = add k 1
end
ret -1
end

note atg: gj[i..] starts with t
fn atg i ulong t view uchar * to bool
if gt add i len t get gn 0
ret false
end
for k ulong len t bound 9223372036854775807
if ne get gj add i k get t k
ret false
end
end
ret true
end

fn digs k ulong to ulong
m = k
while isdig get gj m bound 9223372036854775807
m = add m 1
end
ret m
end

note sknum: the index after the JSON number at i, or -1
fn sknum i ulong to long
k = i
if eq get gj k 45
k = add k 1
end
if not isdig get gj k
ret -1
end
if eq get gj k 48
k = add k 1
else
k = digs k
end
if eq get gj k 46
k = add k 1
if not isdig get gj k
ret -1
end
k = digs k
end
c = get gj k
if or eq c 101 eq c 69
k = add k 1
c = get gj k
if or eq c 43 eq c 45
k = add k 1
end
if not isdig get gj k
ret -1
end
k = digs k
end
ret long k
end

fn sklit i ulong t view uchar * to long
if atg i t
ret long add i len t
end
ret -1
end

note skval: the index after the JSON value at i, or -1
fn skval i ulong to long
c = get gj i
if eq c 34
ret skstr i
end
if eq c 123
ret skobj i
end
if eq c 91
ret skarr i
end
if eq c 116
ret sklit i ktrue
end
if eq c 102
ret sklit i kfalse
end
if eq c 110
ret sklit i knull
end
ret sknum i
end

fn skobj i ulong to long
k = ws add i 1
if eq get gj k 125
ret long add k 1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = skstr k
if lt e 0
ret -1
end
k = ws ulong e
if ne get gj k 58
ret -1
end
e = skval ws add k 1
if lt e 0
ret -1
end
k = ws ulong e
c = get gj k
if eq c 125
ret long add k 1
end
if ne c 44
ret -1
end
k = ws add k 1
end
ret -1
end

fn skarr i ulong to long
k = ws add i 1
if eq get gj k 93
ret long add k 1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = skval k
if lt e 0
ret -1
end
k = ws ulong e
c = get gj k
if eq c 93
ret long add k 1
end
if ne c 44
ret -1
end
k = ws add k 1
end
ret -1
end

note docok: gj holds exactly one JSON object, with only whitespace around it
fn docok to bool
k = ws 0
if ne get gj k 123
ret false
end
e = skobj k
if lt e 0
ret false
end
ret eq ws ulong e get gn 0
end

note mem: where the value of member ky starts in the checked object at o, or -1
fn mem o ulong ky view uchar * to long
k = ws add o 1
if eq get gj k 125
ret -1
end
n = get gn 0
while lt k n bound 9223372036854775807
e = ulong skstr k
hit = and eq sub sub e k 2 len ky atg add k 1 ky
v = ws add ws e 1
if hit
ret long v
end
k = ws ulong skval v
if eq get gj k 125
ret -1
end
k = ws add k 1
end
ret -1
end

note mtyp: as mem, and -1 when the value does not start with byte c (34 string, 123 object, 91 array)
fn mtyp o ulong ky view uchar * c uchar to long
v = mem o ky
if lt v 0
ret -1
end
if ne get gj ulong v c
ret -1
end
ret v
end

note inner: the string member b of the member a (of kind c) of the object at t, or -1
fn inner t ulong a view uchar * c uchar b view uchar * to long
v = mtyp t a c
if lt v 0
ret -1
end
ret mtyp ulong v b 34
end

note nonemp: v is a string with at least one byte between its quotes
fn nonemp v long to bool
if lt v 0
ret false
end
u = ulong v
if ne get gj u 34
ret false
end
ret gt sub sub ulong skstr u u 2 0
end

note streq: the string at v is exactly t as written (no escapes)
fn streq v ulong t view uchar * to bool
e = ulong skstr v
ret and eq sub sub e v 2 len t atg add v 1 t
end

note inlist: the string at v is one of the lines of l
fn inlist v ulong l view uchar * to bool
s = ulong 0
for i ulong len l bound 9223372036854775807
if eq get l i 10
if streq v part l s sub i s
ret true
end
s = add i 1
end
end
ret false
end

fn unesc e uchar to uchar
if eq e 98
ret 8
end
if eq e 102
ret 12
end
if eq e 110
ret 10
end
if eq e 114
ret 13
end
if eq e 116
ret 9
end
if eq e 117
ret 127
end
ret e
end

note sdec: the string at v (its opening quote) decoded into o; returns its length. \uXXXX becomes
note byte 127, which every check refuses and outc shows as '?'. When o is too short: with cut its
note first len o bytes, else -1.
fn sdec v ulong o edit uchar * cut bool to long
e = sub ulong skstr v 1
k = add v 1
m = ulong 0
while lt k e bound 9223372036854775807
c = get gj k
if eq c 92
k = add k 1
c = unesc get gj k
if eq get gj k 117
k = add k 4
end
end
if ge m len o
if cut
ret long m
end
ret -1
end
put o m c
m = add m 1
k = add k 1
end
ret long m
end

note wgj: write gj[s..e) to fd
fn wgj fd int s ulong e ulong to bool
n = s
while lt n e bound 9223372036854775807
r = write fd gj n sub e n
if le r 0
ret false
end
n = add n ulong r
end
ret true
end

note slurp: the whole file p into gj; its permission bits into gmode
fn slurp p view uchar * to void
fd = openreg p
if lt fd 0
die2 mopen p
end
st = new uchar 128 0
x = fstat int fd st 0 128
if lt x 0
die2 mread p
end
put gmode 0 and rd32 st 16 4095
n = ulong 0
while true bound 9223372036854775807
r = read int fd gj n sub 16777216 n
if eq r -4
continue
end
if lt r 0
die2 mread p
end
if eq r 0
break
end
n = add n ulong r
if eq n 16777216
die2 p mbig
end
end
x = fclose int fd
put gn 0 n
end

note ---- .zenodo.json rules
fn need t ulong ky view uchar * to void
v = mtyp t ky 34
if lt v 0
bad2 mmiss ky
ret
end
if not nonemp v
bad2 mempty ky
end
end

fn crs t ulong to void
a = mtyp t kcreat 91
if lt a 0
bad mcrarr
ret
end
k = ws add ulong a 1
if eq get gj k 93
bad mcrnone
ret
end
n = get gn 0
while lt k n bound 9223372036854775807
if ne get gj k 123
bad mcrarr
ret
end
if not nonemp mtyp k kname 34
bad mcrarr
ret
end
k = ws ulong skval k
if eq get gj k 93
ret
end
k = ws add k 1
end
end

fn lic t ulong to void
v = mem t klic
if lt v 0
bad2 mmiss klic
ret
end
if eq get gj ulong v 123
v = mtyp ulong v kid 34
end
if not nonemp v
bad mlic
end
end

fn upt t ulong to void
v = mtyp t kupt 34
if lt v 0
bad2 mmiss kupt
ret
end
u = ulong v
if streq u tpub
need t kpubt
ret
end
if streq u timage
need t kimgt
ret
end
if not inlist u tuptl
bad mupt
end
end

note pkeys: no top-level key holds an escape, so mem sees every key as written
fn pkeys t ulong to void
k = ws add t 1
if eq get gj k 125
ret
end
n = get gn 0
while lt k n bound 9223372036854775807
e = ulong skstr k
for j ulong sub sub e k 2 bound 9223372036854775807
if eq get gj add add k 1 j 92
bad mesck
ret
end
end
k = ws ulong skval ws add ws e 1
if eq get gj k 125
ret
end
k = ws add k 1
end
end

note meta: every rule for .zenodo.json (in gj); problems go to bad
fn meta to void
if not docok
bad mnotobj
ret
end
t = ws 0
pkeys t
need t ktitle
need t kdesc
crs t
lic t
upt t
if ge mem t kdoi 0
bad mhasdoi
end
if ge mem t kpre 0
bad mhaspre
end
end

note ---- files
note openreg: O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW on Linux AArch64 (asm/fcntl.h).
note Opening and fstat use the same descriptor: no stat/open symlink race, and no FIFO wait.
note walkopen restores cwd; every ancestor opened through the previous directory fd.
note AArch64 O_DIRECTORY=16384, O_NOFOLLOW=32768, O_CLOEXEC=524288.
fn walkopen p view uchar * flags int mode int to long
home = fopen tdot 0 len tdot 540672 0
if lt home 0
ret -1
end
r = long 0
start = ulong 0
if eq len p 0
x = fclose int home
ret -1
end
if eq get p 0 47
r = chdir troot 0 len troot
start = ulong 1
end
if ge r 0
r = walkrel p start flags mode
end
x = fchdir int home
y = fclose int home
if lt x 0
die manchor
end
ret r
end

fn walkrel p view uchar * start ulong flags int mode int to long
s = start
for i ulong sub len p start bound 9223372036854775807
j = add start i
if eq get p j 47
if eq j s
ret -1
end
if not compok part p s sub j s
ret -1
end
fd = fopen p s sub j s or int 540672 32768 0
if lt fd 0
ret -1
end
r = fchdir int fd
x = fclose int fd
if lt r 0
ret -1
end
s = add j 1
end
end
if ge s len p
ret -1
end
if not compok part p s sub len p s
ret -1
end
ret fopen p s sub len p s flags mode
end

fn compok p view uchar * to bool
if beq p tdot
ret false
end
if eq len p 2
if and eq get p 0 46 eq get p 1 46
ret false
end
end
ret true
end

fn openreg p view uchar * to long
fd = walkopen p or int 526336 32768 0
if lt fd 0
ret -1
end
st = new uchar 128 0
x = fstat int fd st 0 128
if ge x 0
if eq and rd32 st 16 61440 32768
if gt rd64 st 48 0
ret fd
end
end
end
y = fclose int fd
ret -1
end

fn regfile p view uchar * to bool
fd = openreg p
if lt fd 0
ret false
end
x = fclose int fd
ret true
end

note copyfd: descriptor to descriptor; the caller never reopens the input path after its check
fn copyfd inf int outf int to bool
buf = new uchar 65536 0
total = ulong 0
while true bound 9223372036854775807
r = read inf buf 0 len buf
if eq r -4
continue
end
if lt r 0
ret false
end
if eq r 0
ret gt total 0
end
n = ulong 0
while lt n ulong r bound 9223372036854775807
k = write outf buf n sub ulong r n
if eq k -4
continue
end
if le k 0
ret false
end
n = add n ulong k
end
total = add total ulong r
end
ret false
end

note snapshot INPUT OUTPUT: freeze a checked nofollow descriptor into an exclusive private file.
fn dosnap ac ulong to int
if ne ac 4
usg
end
p = new uchar 4096 0
o = new uchar 4096 0
pn = getarg 2 p
on = getarg 3 o
inf = openreg part p 0 pn
if lt inf 0
die2 mnotreg part p 0 pn
end
outf = fopen o 0 on 524481 384
if lt outf 0
x = fclose int inf
die2 mwrite part o 0 on
end
ok = copyfd int inf int outf
x = fclose int inf
y = fclose int outf
if or not ok or lt x 0 lt y 0
z = unlink o 0 on
die2 mwrite part o 0 on
end
ret 0
end

fn bname p view uchar * to ulong
s = ulong 0
for i ulong len p bound 9223372036854775807
if eq get p i 47
s = add i 1
end
end
ret s
end

fn nameok p view uchar * s ulong to bool
if ge s len p
ret false
end
if eq get p s 46
ret false
end
for i ulong sub len p s bound 9223372036854775807
if not namech get p add s i
ret false
end
end
ret true
end

note fchk: one file to upload; true when it is a PDF
fn fchk p view uchar * to bool
s = bname p
if not nameok p s
bad2 mfname p
ret false
end
if not regfile p
bad2 mnotreg p
ret false
end
if lt len p 4
ret false
end
ret bati p sub len p 4 tpdf
end

note samename: compare base names without keeping both sliced views live in the argument loop
fn samename p view uchar * b view uchar * to bool
s = bname p
t = bname b
n = sub len p s
if ne n sub len b t
ret false
end
for j ulong n bound 9223372036854775807
if ne get p add s j get b add t j
ret false
end
end
ret true
end

note dupchk: no later file argument shares the base name of argument i (p)
fn dupchk i ulong ac ulong p view uchar * to void
b = new uchar 4096 0
for j ulong sub sub ac i 1 bound 9223372036854775807
k = getarg add add i j 1 b
if samename p part b 0 k

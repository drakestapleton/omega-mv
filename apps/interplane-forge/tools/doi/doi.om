note yesline: one line from fd is exactly yes (end of input before the newline is a no)
fn yesline fd int to bool
b = new uchar 1 0
a = new uchar 3 0
n = ulong 0
ok = true
while true bound 9223372036854775807
r = read fd b 0 1
if eq r -4
continue
end
if le r 0
ok = false
break
end
if eq get b 0 10
break
end
if lt n 3
put a n get b 0
else
ok = false
end
n = add n 1
end
ret and ok and eq n 3 beq a tyes
end

note question: every part of the prompt must reach the tty before an answer is read
fn question fd int d view uchar * to bool
o = new uchar 128 0
k = origin o
if not wall fd qpub1
ret false
end
if not wall fd d
ret false
end
if not wall fd qpub2
ret false

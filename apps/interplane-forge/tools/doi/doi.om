zrepl 2
inst = candino tzj
if not inst
undo mcand
end
disp = namedok tznew
if not disp
undo mdrift
end
r = fchmod fd int get gmode 0
if lt r 0
die mwrite
end
r = fsync fd
if lt r 0
die mwrite
end
r = fsync int get gfd 0
if lt r 0
die mwrite
end
r = unlink tznew 0 len tznew
if lt r 0
die mwrite
end
r = fsync int get gfd 0
if lt r 0
die mwrite
end
say tsaved
end

note The shell pipeline exists before launch; this private response pipe exists before fork.
note Only Omega supervises keeper lifetime. DONE certifies successful wait, not merely SAVED.
fn stopkid pid int to void
st = new uchar 4 0
r = killpid pid 9
while true bound 9223372036854775807
r = waitpid pid st 0 4 0
if ne r -4
break
end
end
end

fn watchkid pid int fd int to int
st = new uchar 4 0
buf = new uchar 4096 0
done = false
while true bound 9223372036854775807
if not done
r = waitpid pid st 0 4 1
if eq r long pid
done = true
if ne rd32 st 0 0
warn tpfx
warn mkdead
warn tnl
ret 1
end
else
if and lt r 0 ne r -4
stopkid pid
die mipc
end
end
end
r = read fd buf 0 len buf
if gt r 0
if not wall 1 part buf 0 ulong r
if not done
stopkid pid
end
ret 1
end
else
if and eq r 0 done
if not wall 1 tdone
ret 1
end
ret 0
end
if and lt r 0 and ne r -11 ne r -4
if not done
stopkid pid
end
die mipc
end
end
note POLLERR on the pipeline writer means the consumer closed its read end.
r = waitio 1 0 0
if or lt r 0 ne and r 8 0
if not done
stopkid pid
end
ret 1
end
r = waitio fd 1 10000000
end
ret 1
end

fn kidio fd int to void
p = new uchar 4096 0
n = getarg 4 p
n = cpy p n tin
note startup gate before-input (tests insert SIGSTOP here in compiled fixture variants)
inf = fopen p 0 n or int 524288 2048 0
if lt inf 0
die mipc
end
r = dupfd int inf 0 0
x = fclose int inf
if lt r 0
die mipc
end
note startup gate before-output (input is open, output is not bound)
r = dupfd fd 1 0
x = fclose fd
if lt r 0
die mipc
end
end

fn supervise ac ulong to int
if or lt ac 5 gt ac 6
usg
end
fds = new uchar 8 0
r = pipefds fds 0 8 or int 524288 2048
if lt r 0
die mipc
end
put gparent 0 getpid
pid = fork
if lt pid 0
die mipc
end
if eq pid 0
x = fclose int rd32 fds 0
kidio int rd32 fds 4
ret doserve ac
end
x = fclose int rd32 fds 4
ret watchkid int pid int rd32 fds 0
end

fn doserve ac ulong to int
if or lt ac 5 gt ac 6
usg
end
setmode 2
p = new uchar 4096 0
n = getarg 3 p
fd = walkopen part p 0 n or int 540672 32768 0
if lt fd 0
die2 manchor part p 0 n
end
put gfd 0 fd
r = flock int fd 6
if lt r 0
die mlock
end
n = getarg 4 p
fd = walkopen part p 0 n or int 540672 32768 0
if lt fd 0
die manchor
end
put gfd 1 fd
fd = fopen tdot 0 len tdot 540672 0
if lt fd 0
die manchor
end
put gfd 3 fd
homefd 0
fd = fopen tznew 0 len tznew or int 524482 32768 384
if lt fd 0
die2 mwrite tznew
end
put gfd 2 fd

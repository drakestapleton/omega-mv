if not wall fd part o 0 k
ret false
end
if eq get gprod 0 1
if not wall fd qprod
ret false
end
else
if not wall fd qsand
ret false
end
end
ret wall fd qpub3
end

note docons: the question and the answer both go through /dev/tty, never stdin or stdout, so no
note pipe or file can answer it; no terminal means no
fn docons ac ulong to int
if ne ac 4
usg
end
setmode 2
d = new uchar 4096 0
dn = getarg 3 d
doichk part d 0 dn
fd = fopen ttty 0 len ttty 524290 0
if lt fd 0
warn tpfx
warn mnotty
warn tnl
ret 1
end
ok = question int fd part d 0 dn
if ok
ok = yesline int fd
end
y = fclose int fd
if ok
ret 0
end
ret 1
end

fn main to int
ac = ulong argcnt
if lt ac 2
usg
end
c = new uchar 4096 0
k = getarg 1 c
if beq part c 0 k wtoken
if ne ac 2
usg
end

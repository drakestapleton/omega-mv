fd = fopen p 0 len p 524481 384
if lt fd 0
die2 mwrite p
end
ok = copyfd inf int fd
x = fclose int fd
homefd 0
if or not ok lt x 0
die2 mwrite p
end
end

fn filecopy p view uchar * to void

a = new uchar 128 0
b = new uchar 128 0
x = fstat int fd a 0 128
y = fstat int get gfd 2 b 0 128
z = fclose int fd
if or lt x 0 lt y 0
ret false
end
ret and eq rd64 a 0 rd64 b 0 eq rd64 a 8 rd64 b 8
end

fn undo m view uchar * to void

t = ws 0
if beq part w 0 m kbucket
ret pkurl inner t klinks 123 kbucket 1
end
if beq part w 0 m kpublish
ret pkurl inner t klinks 123 kpublish 2
end
if beq part w 0 m khtml
ret pkurl inner t klinks 123 khtml 3
end
if beq part w 0 m kdoi
a = mtyp t kmeta 123
if lt a 0
die2 mabsent kmeta
end
z = mtyp ulong a kpre 123
if lt z 0
die2 mabsent kpre
end
ret pkdoi mtyp ulong z kdoi 34 kdoi
end
if beq part w 0 m wpubdoi
ret pkdoi mtyp t kdoi 34 kdoi
end
if beq part w 0 m kkey
ret pkname t
end
if beq part w 0 m ksize
ret pksize t
end
if beq part w 0 m kmsg
ret pkmsg t
end
die2 mwhat part w 0 m
ret 2
end

note zwrite: .zenodo.json with "doi" as its first member: the bytes up to and with the opening
note brace, the whitespace after it, the doi member, that whitespace again, then the rest unchanged
fn zwrite fd int d view uchar * to bool
t = ws 0
w = ws add t 1
a = wgj fd 0 w
b = wall fd tdoiq
c = wall fd d
e = wall fd tqc
f = wgj fd add t 1 w
g = wgj fd w get gn 0
ret and and and a b and c e and f g
end

note zrepl: rename .zenodo.json.doi-new over .zenodo.json (one step: the old file or the new one)
fn zrepl flags int to void
pk = new uchar 64 0
wr16 pk 0 2
wr16 pk 2 len tznew
k = cpy pk 4 tznew
wr16 pk k len tzj
k = cpy pk add k 2 tzj
r = renames pk 0 k flags
if lt r 0
die mrename
end
end

note READY after exclusive reservation and snapshots; receive one DOI line; SAVED after fsync.
fn homefd i ulong to void

om2
note Manifest: version line, HTTPS receipt URL line, then target TAB HTTPS binary URL TAB sha256 LF.
note Targets: Linux-aarch64, Linux-x86_64, Darwin-arm64, Darwin-x86_64. No target implies no release.
note Input is streamed, never evaluated as shell. Quotes and control bytes in values are refused.
text bringnm "bring.sh"
text getnm "get.sh"
text header "#!/bin/sh\nset -eu\numask 077\n"
text vers "version='"
text receipt "receipt='"
text closeq "'\n"
text detect "target=\"$(uname -s)-$(uname -m)\"\ncase \"$target\" in\n"
text row1 ")\nurl='"
text row2 "'\nexpected='"
text row3 "'\n;;\n"
text ending "*) echo 'This platform has no Interplane release yet.' >&2; exit 1;;\nesac\nd=$(mktemp -d)\ntrap 'rm -f \"$d/interplane\"; rmdir \"$d\"' EXIT HUP INT TERM\ncurl -q --proto '=https' --proto-redir '=https' -fsSL \"$url\" -o \"$d/interplane\"\nif command -v sha256sum >/dev/null 2>&1; then\n  actual=$(sha256sum \"$d/interplane\")\nelse\n  actual=$(shasum -a 256 \"$d/interplane\")\nfi\nactual=${actual%% *}\nprintf 'Interplane %s\\nDownloaded SHA-256: %s\\nExpected SHA-256:   %s\\nCompare with: %s\\n' \"$version\" \"$actual\" \"$expected\" \"$receipt\"\n[ \"$actual\" = \"$expected\" ] || { echo 'Fingerprint mismatch. Nothing was run.' >&2; exit 1; }\nchmod 700 \"$d/interplane\"\n"
text brun "\"$d/interplane\" bring \"$@\" < /dev/tty\n"
text grun "\"$d/interplane\" get \"$@\" < /dev/tty\n"
text la "Linux-aarch64"
text lx "Linux-x86_64"
text da "Darwin-arm64"
text dx "Darwin-x86_64"
text https "https://"
text bad "installer: invalid manifest; output scripts removed\n"
global outs int 2
global ch uchar 1
fn fail to void
x = write 2 bad 0 len bad
for i ulong 2
x = fclose get outs i
end
x = unlink bringnm 0 len bringnm
x = unlink getnm 0 len getnm
exit 1
end
fn emit s view uchar * to void
for i ulong 2
p = ulong 0
while lt p len s bound 9223372036854775807
r = write get outs i s p sub len s p
if le r 0
fail
end
p = add p ulong r
end
end
end
fn bytein to long
r = read 0 ch 0 1
if eq r 0
ret -1
end
if ne r 1
fail
end
ret long get ch 0
end
fn emitbyte c uchar to void
b = new uchar 1 0
put b 0 c
emit b
end
fn value delim long url bool to void
n = ulong 0
while true bound 9223372036854775807
c = bytein
if eq c delim
break
end
if or lt c 33 or gt c 126 eq c 39
fail
end
if url
if lt n len https
if ne c long get https n
fail
end
end
end
emitbyte uchar c
n = add n 1
end
if eq n 0
fail
end
if url
if le n len https
fail
end
end
end
fn same a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 9223372036854775807
if ne get a i get b i
ret false
end
end
ret true
end
fn target s view uchar * to ulong
if same s la
ret 1
end
if same s lx
ret 2
end
if same s da
ret 4
end
if same s dx
ret 8
end
fail
ret 0
end
fn main to int
put outs 0 -1
put outs 1 -1
fd = fopen bringnm 0 len bringnm 524481 384
if lt fd 0
exit 1
end
put outs 0 int fd
fd = fopen getnm 0 len getnm 524481 384
if lt fd 0
x = fclose get outs 0
x = unlink bringnm 0 len bringnm
exit 1
end
put outs 1 int fd
emit header
emit vers
value 10 false
emit closeq
emit receipt
value 10 true
emit closeq
emit detect
buf = new uchar 14 0
seen = ulong 0
while true bound 9223372036854775807
c = bytein
if eq c -1
break
end
n = ulong 0
while ne c 9 bound 9223372036854775807
if or lt c 33 ge n len buf
fail
end
put buf n uchar c
n = add n 1
c = bytein
end
v = target part buf 0 n
if ne and seen v 0
fail
end
seen = or seen v
emit part buf 0 n
emit row1
value 9 true
emit row2
for i ulong 64
c = bytein
if not or and ge c 48 le c 57 and ge c 97 le c 102
fail
end
emitbyte uchar c
end
if ne bytein 10
fail
end
emit row3
end
if eq seen 0
fail
end
emit ending
x = write get outs 0 brun 0 len brun
if ne x long len brun
fail
end
x = write get outs 1 grun 0 len grun
if ne x long len grun
fail
end
for i ulong 2
x = fsync get outs i
if lt x 0
fail
end
x = fclose get outs i
end
ret 0
end

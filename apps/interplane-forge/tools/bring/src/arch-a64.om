note Linux aarch64 ABI values (arch/arm64/include/uapi/asm/fcntl.h; struct stat of asm-generic/stat.h):
note O_DIRECTORY 040000 = 16384, O_NOFOLLOW 0100000 = 32768, O_CLOEXEC 02000000 = 524288,
note O_WRONLY 1, O_CREAT 64, O_EXCL 128, O_TRUNC 512. st_mode u32 at 16, st_size at 48.
note how 0 read (no final symlink), 1 directory, 2 temp write/truncate, 3 create exclusive, 4 read
fn pl_oflag how ulong to int
if eq how 1
ret 573440
end
if eq how 2
ret 557633
end
if eq how 3
ret 557249
end
if eq how 4
ret 524288
end
ret 557056
end
fn pl_mode b view uchar * to ulong
ret rd32 b 16
end
fn pl_size b view uchar * to ulong
ret rd64 b 48
end

text tbring "bring"
text tget "get"
text twithdr "withdraw"
text tpack "pack"
text tunpack "unpack"
text tpatch "patch"
text tvarg "--version"
text tusage "usage: interplane bring [folder] | get <page or rid> | withdraw <page or rid> | patch [--base REF] [--title T] [--message-file F] [--yes] OWNER/REPO | pack <folder> <archive> | unpack <archive> <folder>"
text tconsent "Your project will be published on an open network called Radicle, through Interplane.\nPublishing is permanent: copies may stay on other computers even if you withdraw it later.\nType yes to publish it, anything else to stop:\n"
text ttty "/dev/tty"
text tyes "yes"
text tno "Nothing sent.\n"
note consent: q is printed, then one line from /dev/tty (never stdin): true only for exactly "yes"
fn consent q view uchar * to bool
say q
fd = pl_open ttty 4 0
if lt fd 0
ret false
end
b = new uchar 1 0
a = new uchar 3 0
n = ulong 0
ok = true
while true bound 9223372036854775807
r = read int fd b 0 1
if eq r -4
continue
end
if le r 0
ok = false
break
end
if eq get b 0 10
break
end
if lt n 3
put a n get b 0
else
ok = false
end
n = add n 1
end
pl_close int fd
ret and ok and eq n 3 beq a tyes
end
fn prepare folder view uchar * to void
r = pl_cd folder
if lt r 0
die terrdir
end
tmpsetup
put grecfd 0 topen tfiles 2
put gspool 0 topen tkeep 2
walk part tdot 0 0
pl_close get grecfd 0
pl_close get gspool 0
sortfiles
mkname
say tname
wname 1
say tnl
say tcnt
sayd get gcount 0
say tnl
say tbytes
sayd get gbytes 0
say tnl
end
fn getarg i ulong b edit uchar * to ulong
n = pl_arg i b
if lt n 0
die tusage
end
ret ulong n
end
fn main to int
cmd = new uchar 4096 0
folder = new uchar 4096 0
archivep = new uchar 4096 0
ac = pl_argc
if lt ac 2
die tusage
end
n = getarg 1 cmd
if beq part cmd 0 n tvarg
say tver
ret 0
end
if beq part cmd 0 n tpatch
ret patchflow ulong ac
end
if beq part cmd 0 n tunpack
if ne ac 4
die tusage
end
an = getarg 2 archivep
fnl = getarg 3 folder
fd = pl_open part archivep 0 an 0 0
if lt fd 0
die terrio
end
tarwalk int fd false
r = pl_seek int fd 0
r = pl_mkdir part folder 0 fnl 448
if ne r 0
die texists
end
r = pl_cd part folder 0 fnl
if lt r 0
die terrdir
end
tarwalk int fd true
pl_close int fd
ret 0
end
if beq part cmd 0 n tpack
if ne ac 4
die tusage
end
fnl = getarg 2 folder
an = getarg 3 archivep
fd = pl_open part archivep 0 an 3 384
if lt fd 0
die texists
end
prepare part folder 0 fnl
archive int fd
pl_close int fd
cleanup
ret 0
end
if beq part cmd 0 n tbring
if gt ac 3
die tusage
end
fnl = ulong 1
put folder 0 46
if eq ac 3
fnl = getarg 2 folder
end
prepare part folder 0 fnl
if not consent tconsent
say tno
cleanup
ret 1
end
bringflow part folder 0 fnl
cleanup
ret 0
end
if beq part cmd 0 n tget
if ne ac 3
die tusage
end
fnl = getarg 2 folder
tmpsetup
getflow part folder 0 fnl
cleanup
ret 0
end
if beq part cmd 0 n twithdr
if ne ac 3
die tusage
end
fnl = getarg 2 folder
tmpsetup
if not wdflow part folder 0 fnl
say tno
cleanup
ret 1
end
cleanup
ret 0
end
die tusage
ret 1
end

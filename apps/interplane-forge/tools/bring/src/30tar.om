note Deterministic POSIX ustar: regular files only; uid/gid/mtime zero; no extension headers.
text tustar "ustar"
text ttarbad "invalid or unsafe POSIX ustar archive"
text tlinksk "Skipped a link (links are never created): "
text texists "destination already exists or cannot be created"
fn octput b edit uchar * off ulong width ulong v ulong to void
x = v
for i ulong sub width 1 bound 9223372036854775807
p = sub add off width add i 2
d = uchar add 48 and x 7
put b p d
x = shr x 3
end
if ne x 0
die ttarbad
end
put b sub add off width 1 0
end
fn tarhead rec view uchar * h edit uchar * to void
for i ulong 512
put h i 0
end
n = rd16 rec 0
split = ulong 0
if gt n 100
for i ulong n bound 255
if eq get rec add 32 i 47
if and le i 155 le sub sub n i 1 100
split = i
end
end
end
if eq split 0
die ttarbad
end
for i ulong split bound 155
put h add 345 i get rec add 32 i
end
split = add split 1
end
for i ulong sub n split bound 100
put h i get rec add 32 add split i
end
octput h 100 8 rd64 rec 8
octput h 108 8 0
octput h 116 8 0
octput h 124 12 rd64 rec 16
octput h 136 12 0
for i ulong 8
put h add 148 i 32
end
put h 156 48
for i ulong 5
put h add 257 i get tustar i
end
put h 263 48
put h 264 48
sum = ulong 0
for i ulong 512
sum = add sum ulong get h i
end
octput h 148 7 sum
put h 155 32
end
fn copybytes src int dst int n ulong to void
b = new uchar 65536 0
left = n
while gt left 0 bound 9223372036854775807
k = left
if gt k len b
k = len b
end
if not exactread src part b 0 k
die terrio
end
mustwrite dst part b 0 k
left = sub left k
end
end
fn archive dst int to void
fd = opensorted
src = topen tkeep 0
for i ulong get gcount 0 bound 9223372036854775807
archone fd src dst
end
z = new uchar 512 0
mustwrite dst z
mustwrite dst z
pl_close src
pl_close fd
end
fn archone fd int src int dst int to void
rec = new uchar 288 0
h = new uchar 512 0
if not exactread fd rec
die terrio
end
tarhead rec h
mustwrite dst h
r = pl_seek src rd64 rec 24
if lt r 0
die terrio
end
sz = rd64 rec 16
copybytes src dst sz
pad = rem sub 512 rem sz 512 512
for i ulong 512
put h i 0
end
mustwrite dst part h 0 pad
end
fn octread b view uchar * off ulong width ulong to ulong
v = ulong 0
ended = false
for i ulong width bound 12
c = get b add off i
if or eq c 0 eq c 32
ended = true
else
if or ended or lt c 48 gt c 55
die ttarbad
end
v = add mul v 8 ulong sub c 48
end
end
ret v
end
fn allzero b view uchar * to bool
for i ulong len b bound 9223372036854775807
if ne get b i 0
ret false
end
end
ret true
end
fn pathok p view uchar * to bool
if or eq len p 0 gt len p 255
ret false
end
start = ulong 0
for i ulong add len p 1 bound 256
sep = eq i len p
if not sep
c = get p i
if eq c 0
ret false
end
sep = eq c 47
end
if sep
n = sub i start
if eq n 0
ret false
end
if or beq part p start n tdot beq part p start n tdotdot
ret false
end
if isgit part p start n
ret false
end
start = add i 1
end
end
ret true
end
fn fieldlen b view uchar * off ulong n ulong to ulong
for i ulong n bound 9223372036854775807
if eq get b add off i 0
ret i
end
end
ret n
end
fn tarpath h view uchar * p edit uchar * isdir bool to ulong
n = fieldlen h 345 155
k = ulong 0
if gt n 0
k = cpy p 0 part h 345 n
put p k 47
k = add k 1
end
n = fieldlen h 0 100
k = cpy p k part h 0 n
if and isdir gt k 1
if eq get p sub k 1 47
k = sub k 1
end
end
if not pathok part p 0 k
die ttarbad
end
ret k
end
fn checkhead h view uchar * to ulong
if not bat h 257 tustar
die ttarbad
end
if or ne get h 262 0 or ne get h 263 48 ne get h 264 48
die ttarbad
end
v = octread h 148 8
sum = ulong 0
for i ulong 512
if and ge i 148 lt i 156
sum = add sum 32
else
sum = add sum ulong get h i
end
end
if ne sum v
die ttarbad
end
ret octread h 124 12
end
note Validate first, then unpack into a newly created private directory. Never follow archive links.
note Parent components are created by us; relative path validation runs before any creation.
fn tarwalk fd int unpack bool to void
h = new uchar 512 0
p = new uchar 256 0
z = new uchar 512 0
while true bound 9223372036854775807
if not exactread fd h
die ttarbad
end
if allzero h
if not exactread fd z
die ttarbad
end
if not allzero z
die ttarbad
end
while true bound 9223372036854775807
r = read fd z 0 512
if lt r 0
die terrio
end
if eq r 0
ret
end
if not allzero part z 0 ulong r
die ttarbad
end
end
end
sz = checkhead h
tarent fd h sz unpack
pad = rem sub 512 rem sz 512 512
if not exactread fd part z 0 pad
die ttarbad
end
if not allzero part z 0 pad
die ttarbad
end
end
end
note tarent: one entry. '0'/NUL regular file (0644, or 0755 when the owner exec bit is set), '5'
note directory, 'g' a pax global header (git archive's commit comment; skipped, never applied),
note '1'/'2' links (never created; listed as skipped). Anything else refuses the archive.
fn tarent fd int h view uchar * sz ulong unpack bool to void
t = get h 156
if eq t 103
skipdata fd sz
ret
end
p = new uchar 256 0
if eq t 53
if not allzero part h 157 100
die ttarbad
end
n = tarpath h p true
if ne sz 0
die ttarbad
end
if unpack
put p n 47
makeparents part p 0 add n 1
end
ret
end
if or eq t 49 eq t 50
n = tarpath h p false
if unpack
say tlinksk
sayp part p 0 n
say tnl
end
skipdata fd sz
ret
end
if and ne t 48 ne t 0
die ttarbad
end
if not allzero part h 157 100
die ttarbad
end
n = tarpath h p false
if not unpack
skipdata fd sz
ret
end
makeparents part p 0 n
md = int 420
if ne and octread h 100 8 64 0
md = int 493
end
of = pl_open part p 0 n 3 md
if lt of 0
die texists
end
copybytes fd int of sz
pl_close int of
end
fn skipdata fd int sz ulong to void
r = pl_skip fd sz
if lt r 0
die terrio
end
end
fn makeparents p view uchar * to void
st = new uchar 256 0
for i ulong len p bound 255
if eq get p i 47
r = pl_mkdir part p 0 i 448
if ne r 0
if ne r -17
die texists
end
r = pl_stat part p 0 i st
if lt r 0
die texists
end
if ne and pl_mode st 61440 16384
die texists
end
end
end
end
end

note tools/bring/src/plat-macos.om: macOS arm64 platform for ng `@ng a64 macho` (unit begins
note `target macos`). Every system operation goes through libSystem with dlsym (libfn 1) and libcall
note (a64/DESIGN.md s13): eight integer registers, no stack arguments, so no variadic argument is ever
note passed. open() is called only with its two fixed arguments (no O_CREAT); files are created with
note creat(path, mode) (truncate) or fopen(path, "wx") + fchmod (exclusive). The process start is
note posix_spawn with POSIX_SPAWN_CLOEXEC_DEFAULT, stdio bound by dup2 actions and an empty
note environment, like execprog on Linux. Flags are Darwin values: O_NOFOLLOW 256, O_DIRECTORY
note 1048576, O_CLOEXEC 16777216.
text tmsyms "open close lstat fstat pread pwrite lseek ftruncate unlink rmdir mkdir chdir fchdir getcwd getpid usleep creat fopen fileno dup fclose fchmod fdopendir readdir closedir dirfd memcpy strlen __error _NSGetArgc _NSGetArgv _NSGetEnviron posix_spawn posix_spawn_file_actions_init posix_spawn_file_actions_adddup2 posix_spawn_file_actions_destroy posix_spawnattr_init posix_spawnattr_setflags posix_spawnattr_destroy waitpid "
text tmwx "wx"
text tmnosym "macOS library function not found"
global gmfn ulong 40

fn mp64 b edit uchar 128 o ulong v ulong to void
for i ulong 8
put b add o i uchar and shr v mul i 8 255
end
end

note msym: the address of library function k (the k-th name of tmsyms), found once with dlsym
fn msym k ulong to ulong
f = get gmfn k
if ne f 0
ret f
end
nm = new uchar 64 0
rg = new uchar 128 0
w = ulong 0
s = ulong 0
for i ulong len tmsyms
if eq get tmsyms i 32
if eq w k
for j ulong sub i s bound 63
put nm j get tmsyms add s j
end
put nm sub i s 0
mp64 rg 0 18446744073709551614
mp64 rg 8 ulong libptr nm 0 64
f = ulong libcall ulong libfn 1 rg 0 128
if eq f 0
die tmnosym
end
put gmfn k f
ret f
end
w = add w 1
s = add i 1
end
end
die tmnosym
ret 0
end

fn mc3 k ulong a ulong b ulong c ulong to long
rg = new uchar 128 0
mp64 rg 0 a
mp64 rg 8 b
mp64 rg 16 c
ret long libcall msym k rg 0 128
end

fn mc6 k ulong a ulong b ulong c ulong d ulong e ulong to long
rg = new uchar 128 0
mp64 rg 0 a
mp64 rg 8 b
mp64 rg 16 c
mp64 rg 24 d
mp64 rg 32 e
ret long libcall msym k rg 0 128
end

note merr: -errno (Darwin numbering; EEXIST is 17 as on Linux)
fn merr to long
p = mc3 28 0 0 0
b = new uchar 8 0
x = mc3 26 ulong libptr b 0 8 ulong p 4
ret neg long rd32 b 0
end

note mres: a libc result: -1 becomes -errno
fn mres r long to long
if eq int r -1
ret merr
end
ret r
end

note mpath: p NUL-terminated in c; returns its address
fn mpath p view uchar * c edit uchar 4097 to ulong
if gt len p 4095
die terrio
end
for i ulong len p bound 4096
if eq get p i 0
die terrio
end
put c i get p i
end
put c len p 0
ret ulong libptr c 0 4097
end

fn pl_open p view uchar * how ulong mode int to long
c = new uchar 4097 0
a = mpath p c
if eq how 2
ret mres mc3 16 a ulong mode 0
end
if eq how 3
ret mexcl a mode
end
fl = ulong 16777472
if eq how 1
fl = ulong 17826048
end
if eq how 4
fl = ulong 16777216
end
ret mres mc3 0 a fl 0
end
fn mexcl a ulong mode int to long
m = new uchar 4 0
for i ulong 2
put m i get tmwx i
end
f = mc3 17 a ulong libptr m 0 4 0
if eq f 0
ret merr
end
fd = mc3 18 ulong f 0 0
nfd = mres mc3 19 ulong fd 0 0
x = mc3 20 ulong f 0 0
if lt nfd 0
ret nfd
end
x = mc3 21 ulong nfd ulong mode 0
ret nfd
end
fn pl_close fd int to void
x = mc3 1 ulong fd 0 0
end
fn pl_unlink p view uchar * to long
c = new uchar 4097 0
ret mres mc3 8 mpath p c 0 0
end
fn pl_rmdir p view uchar * to long
c = new uchar 4097 0
ret mres mc3 9 mpath p c 0 0
end
fn pl_mkdir p view uchar * mode int to long
c = new uchar 4097 0
ret mres mc3 10 mpath p c ulong mode 0
end
fn pl_cd p view uchar * to long
c = new uchar 4097 0
ret mres mc3 11 mpath p c 0 0
end
fn pl_fcd fd int to long
ret mres mc3 12 ulong fd 0 0
end
note directories: the handle is a DIR* (fdopendir of an O_DIRECTORY|O_NOFOLLOW descriptor), 0 on error
fn pl_dopen p view uchar * to ulong
fd = pl_open p 1 0
if lt fd 0
ret 0
end
d = mc3 22 ulong fd 0 0
if eq d 0
pl_close int fd
end
ret ulong d
end
fn pl_dfd h ulong to int
ret int mc3 25 h 0 0
end
fn pl_dclose h ulong to void
x = mc3 24 h 0 0
end
fn pl_dname to ulong
ret 19
end
fn pl_dlen b view uchar * o ulong to ulong
ret rd16 b add o 16
end
note pl_dents: readdir records into b as the walk reads them: u16 record length at 16, the name at 19,
note a zero byte after it. A record is at most 275 bytes, so b always takes the next one.
fn pl_dents h ulong b edit uchar * to long
n = ulong 0
hd = new uchar 24 0
while le add n 280 len b bound 9223372036854775807
p = mc3 23 h 0 0
if eq p 0
break
end
x = mc3 26 ulong libptr hd 0 24 ulong p 24
nl = rd16 hd 18
if gt nl 255
ret -36
end
rl = add add 19 nl 1
for i ulong 19
put b add n i 0
end
wr16 b add n 16 rl
x = mc3 26 ulong libptr b add n 19 nl add ulong p 21 nl
put b add add n 19 nl 0
n = add n rl
end
ret long n
end
fn pl_stat p view uchar * b edit uchar * to long
c = new uchar 4097 0
if lt len b 144
die terrio
end
ret mres mc3 2 mpath p c ulong libptr b 0 144 0
end
fn pl_fstat fd int b edit uchar * to long
if lt len b 144
die terrio
end
ret mres mc3 3 ulong fd ulong libptr b 0 144 0
end
fn pl_mode b view uchar * to ulong
ret rd16 b 4
end
fn pl_size b view uchar * to ulong
ret rd64 b 96
end
fn pl_readat fd int b edit uchar * pos ulong to long
if eq len b 0
ret 0
end
ret mres mc6 4 ulong fd ulong libptr b 0 len b len b pos 0
end
fn pl_seek fd int pos ulong to long
ret mres mc3 6 ulong fd pos 0
end
fn pl_skip fd int n ulong to long
ret mres mc3 6 ulong fd n 1
end
fn pl_trunc fd int n ulong to long
ret mres mc3 7 ulong fd n 0
end
fn pl_cwd o edit uchar * to ulong
r = mc3 13 ulong libptr o 0 len o len o 0
if eq r 0
die terrio
end
for i ulong len o bound 9223372036854775807
if eq get o i 0
ret i
end
end
die terrio
ret 0
end
fn pl_pid to long
ret mc3 14 0 0 0
end
fn pl_sleep to void
x = mc3 15 1000000 0 0
end
note mptr: the 8-byte value at address a
fn mptr a ulong to ulong
b = new uchar 8 0
x = mc3 26 ulong libptr b 0 8 a 8
ret rd64 b 0
end
note mstr: the C string at address a into b; its length, or -105 when b is too short
fn mstr a ulong b edit uchar * to long
n = ulong mc3 27 a 0 0
if gt n len b
ret -105
end
if eq n 0
ret 0
end
x = mc3 26 ulong libptr b 0 n a n
ret long n
end
fn pl_argc to long
p = mc3 29 0 0 0
b = new uchar 8 0
x = mc3 26 ulong libptr b 0 8 ulong p 4
ret long rd32 b 0
end
fn pl_arg i ulong b edit uchar * to long
if ge i ulong pl_argc
ret -1
end
av = mptr ulong mc3 30 0 0 0
ret mstr mptr add av mul i 8 b
end
fn pl_envc to long
ev = mptr ulong mc3 31 0 0 0
n = ulong 0
while ne mptr add ev mul n 8 0 bound 9223372036854775807
n = add n 1
end
ret long n
end
fn pl_env i ulong b edit uchar * to long
ev = mptr ulong mc3 31 0 0 0
ret mstr mptr add ev mul i 8 b
end
note pl_run: posix_spawn the packed list a (as execprog) with stdin/stdout/stderr bound to the
note three descriptors, every other descriptor closed, an empty environment; waits for it
fn pl_run a view uchar * inf int outf int errf int to long
sb = new uchar 4160 0
pv = new uchar 528 0
cnt = rd16 a 0
if or eq cnt 0 gt cnt 64
ret -1
end
base = ulong libptr sb 0 4160
o = ulong 2
w = ulong 0
for k ulong cnt bound 64
l = rd16 a o
for j ulong l bound 4096
put sb add w j get a add add o 2 j
end
put sb add w l 0
wr64 pv mul k 8 add base w
w = add add w l 1
o = add add o 2 l
end
wr64 pv mul cnt 8 0
wr64 pv 520 0
ret mspawn sb pv cnt inf outf errf
end
fn mspawn sb edit uchar 4160 pv edit uchar 528 cnt ulong inf int outf int errf int to long
fa = new uchar 64 0
atr = new uchar 64 0
pid = new uchar 8 0
st = new uchar 8 0
fap = ulong libptr fa 0 64
atp = ulong libptr atr 0 64
x = mc3 33 fap 0 0
x = mc3 34 fap ulong inf 0
x = mc3 34 fap ulong outf 1
x = mc3 34 fap ulong errf 2
x = mc3 36 atp 0 0
x = mc3 37 atp 16384 0
pp = ulong libptr pv 0 528
rg = new uchar 128 0
mp64 rg 0 ulong libptr pid 0 8
mp64 rg 8 ulong libptr sb 0 4160
mp64 rg 16 fap
mp64 rg 24 atp
mp64 rg 32 pp
mp64 rg 40 add pp mul cnt 8
r = long libcall msym 32 rg 0 128
x = mc3 35 fap 0 0
x = mc3 38 atp 0 0
if ne r 0
ret -1
end
p = rd32 pid 0
while true bound 9223372036854775807
w = mc3 39 p ulong libptr st 0 8 0
if eq int w -1
if eq merr -4
continue
end
ret -1
end
break
end
v = rd32 st 0
if ne and v 127 0
ret -1
end
ret long and shr v 8 255
end

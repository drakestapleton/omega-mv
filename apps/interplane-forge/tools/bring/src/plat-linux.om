note Linux aarch64 platform; flags are Linux ABI values, not policy limits.
fn pl_open p view uchar * how ulong mode int to long
ret fopen p 0 len p pl_oflag how mode
end
fn pl_close fd int to void
x = fclose fd
end
fn pl_unlink p view uchar * to long
ret unlink p 0 len p
end
fn pl_rmdir p view uchar * to long
ret rmdir p 0 len p
end
fn pl_mkdir p view uchar * mode int to long
ret makedir p 0 len p mode
end
fn pl_cd p view uchar * to long
ret chdir p 0 len p
end
fn pl_fcd fd int to long
ret fchdir fd
end
note directories: the handle is the O_DIRECTORY descriptor itself, 0 on error
fn pl_dopen p view uchar * to ulong
fd = pl_open p 1 0
if lt fd 0
ret 0
end
ret ulong fd
end
fn pl_dfd h ulong to int
ret int h
end
fn pl_dclose h ulong to void
pl_close int h
end
fn pl_dents h ulong b edit uchar * to long
ret getdnts int h b 0 len b
end
fn pl_dname to ulong
ret 19
end
fn pl_dlen b view uchar * o ulong to ulong
ret rd16 b add o 16
end
fn pl_stat p view uchar * b edit uchar * to long
ret lstat p 0 len p b 0 len b
end
fn pl_fstat fd int b edit uchar * to long
ret fstat fd b 0 len b
end
fn pl_readat fd int b edit uchar * pos ulong to long
ret pread fd b 0 len b long pos
end
fn pl_seek fd int pos ulong to long
ret fseek fd long pos 0
end
fn pl_trunc fd int n ulong to long
ret ftrunc fd long n
end
fn pl_argc to long
ret argcnt
end
fn pl_arg i ulong b edit uchar * to long
ret argread i b 0 len b
end
fn pl_envc to long
ret envcnt
end
fn pl_env i ulong b edit uchar * to long
ret envread i b 0 len b
end
fn pl_pid to long
ret getpid
end
fn pl_sleep to void
x = sleepns 1000000000
end
fn pl_run a view uchar * inf int outf int errf int to long
pid = fork
if lt pid 0
ret -1
end
if eq pid 0
if ne inf 0
x = dupfd inf 0 0
if lt x 0
exit 126
end
end
if ne outf 1
x = dupfd outf 1 0
if lt x 0
exit 126
end
end
if ne errf 2
x = dupfd errf 2 0
if lt x 0
exit 126
end
end
x = execprog a 0 len a
exit 127
end
st = new uchar 4 0
while true bound 9223372036854775807
r = waitpid int pid st 0 4 0
if eq r -4
continue
end
if ne r pid
ret -1
end
break
end
v = rd32 st 0
if ne and v 127 0
ret -1
end
ret long and shr v 8 255
end
fn pl_cwd o edit uchar * to ulong
r = cwd o 0 len o
if le r 0
die terrio
end
ret sub ulong r 1
end
fn pl_skip fd int n ulong to long
ret fseek fd long n 1
end

note Encodings used by bring/get. SHA-256 is om/tls/sha2.om, composed before this unit.
text thex "0123456789abcdef"
text tb64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
text tb64u "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
text tb58 "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
text tdidk "did:key:"
text tproject "project"
fn hexw d view uchar * o edit uchar * n ulong to ulong
for i ulong len d bound 9223372036854775807
put o add n mul i 2 get thex shr get d i 4
put o add add n mul i 2 1 get thex and get d i 15
end
ret add n mul len d 2
end
note sha of an open descriptor from its current position to EOF.
fn shafd fd int d edit uchar 32 to void
c = new ulong 40 0
b = new uchar 65536 0
sha256_init c
while true bound 9223372036854775807
r = read fd b 0 len b
if eq r -4
continue
end
if lt r 0
die terrio
end
if eq r 0
break
end
sha256_update c part b 0 ulong r
end
sha256_final c d
end
note base64url, no padding. Returns output length.
fn b64u s view uchar * o edit uchar * to ulong
n = ulong 0
i = ulong 0
while lt i len s bound 9223372036854775807
k = sub len s i
w = shl ulong get s i 16
if gt k 1
w = or w shl ulong get s add i 1 8
end
if gt k 2
w = or w ulong get s add i 2
end
put o n get tb64u and shr w 18 63
put o add n 1 get tb64u and shr w 12 63
n = add n 2
if gt k 1
put o n get tb64u and shr w 6 63
n = add n 1
end
if gt k 2
put o n get tb64u and w 63
n = add n 1
end
i = add i 3
end
ret n
end
fn b64v c uchar to long
for i ulong 64
if eq get tb64 i c
ret long i
end
end
ret -1
end
note standard padded base64 decode; returns length or -1.
fn b64d s view uchar * o edit uchar * to long
if ne rem len s 4 0
ret -1
end
n = ulong 0
i = ulong 0
while lt i len s bound 9223372036854775807
g = b64grp s i
if lt g 0
ret -1
end
if and ge g 16777216 lt add i 4 len s
ret -1
end
k = b64emit ulong g o n
if lt k 0
ret -1
end
n = ulong k
i = add i 4
end
ret long n
end
fn b64emit w ulong o edit uchar * n ulong to long
pad = shr w 24
k = n
for j ulong sub 3 pad
if ge k len o
ret -1
end
sh = sub 16 mul j 8
put o k uchar and shr w sh 255
k = add k 1
end
ret long k
end
note b64grp: one 4-char group at s[i]: the 24 bits, plus the pad count shifted 24; -1 when invalid
fn b64grp s view uchar * i ulong to long
w = ulong 0
pad = ulong 0
for j ulong 4
c = get s add i j
v = long 0
if eq c 61
if lt j 2
ret -1
end
pad = add pad 1
else
if gt pad 0
ret -1
end
v = b64v c
if lt v 0
ret -1
end
end
w = or shl w 6 ulong v
end
ret long or and w 16777215 shl pad 24
end
note did:key:z + base58btc(0xed 0x01 + 32 bytes): exactly the Radicle ed25519 form.
fn didkey pk view uchar 32 o edit uchar * to ulong
x = new uchar 34 0
put x 0 237
put x 1 1
for i ulong 32
put x add i 2 get pk i
end
dg = new uchar 64 0
dn = ulong 0
for i ulong 34
carry = ulong get x i
for j ulong dn bound 64
carry = add carry mul ulong get dg j 256
put dg j uchar rem carry 58
carry = div carry 58
end
while gt carry 0 bound 64
put dg dn uchar rem carry 58
dn = add dn 1
carry = div carry 58
end
end
n = cpy o 0 tdidk
put o n 122
n = add n 1
for i ulong dn bound 64
put o n get tb58 get dg sub sub dn i 1
n = add n 1
end
ret n
end
note form encoding of every byte except unreserved ASCII.
fn formw s view uchar * o edit uchar * n ulong to ulong
k = n
for i ulong len s bound 9223372036854775807
c = get s i
if unres c
put o k c
k = add k 1
else
put o k 37
put o add k 1 get thex shr c 4
put o add k 2 get thex and c 15
k = add k 3
end
end
ret k
end
fn unres c uchar to bool
if isaln c
ret true
end
if or eq c 45 eq c 46
ret true
end
ret or eq c 95 eq c 126
end
fn projname folder view uchar * o edit uchar 64 to ulong
n = ulong 0
dash = false
for i ulong len folder bound 9223372036854775807
c = lcb get folder i
ok = or and ge c 97 le c 122 isdig c
if ok
if and dash gt n 0
if lt n 63
put o n 45
n = add n 1
end
end
dash = false
if lt n 64
put o n c
n = add n 1
end
else
dash = true
end
end
if eq n 0
n = cpy o 0 tproject
end
ret n
end

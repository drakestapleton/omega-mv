note tools/bring/src/50patch.om: interplane patch [--base REF] [--title T] [--message-file F] [--yes]
note OWNER/REPO. Run inside a git work tree. It resolves the base (default: the merge base of HEAD
note and refs/remotes/origin/main), builds the mbox with /usr/bin/git format-patch (an argument list,
note no shell, an empty environment), shows what would be sent and sends only after --yes or the
note exact "yes" typed on /dev/tty: the key (made once, as bring makes it), the statement signed with
note namespace interplane-patch, the sign-in of bring, one POST to <base>/OWNER/REPO/patches/new.
note Exit 0 sent (the patch page is printed), 1 nothing sent, 2 the server refused it (its reason
note is printed). The key never leaves this computer; the forge never signs for anyone.
text tqprog "/usr/bin/git"
text tqrp "rev-parse"
text tqiw "--is-inside-work-tree"
text tqtrue "true"
text tqver "--verify"
text tqqt "--quiet"
text tqeoo "--end-of-options"
text tqcmt "^{commit}"
text tqhd "HEAD"
text tqmb "merge-base"
text tqorg "refs/remotes/origin/main"
text tqfp "format-patch"
text tqso "--stdout"
text tqo1 "--no-color"
text tqo2 "--no-ext-diff"
text tqo3 "--no-textconv"
text tqo4 "--no-attach"
text tqo5 "--no-thread"
text tqo6 "--no-cover-letter"
text tqo7 "--src-prefix=a/"
text tqo8 "--dst-prefix=b/"
text tqo9 "--no-signature"
text tqo10 "--no-relative"
text tqo11 "--no-notes"
text tqrl "rev-list"
text tqcnt "--count"
text tqdf "diff"
text tqnmo "--name-only"
text tqz "-z"
text tqlog "log"
text tqm1 "-1"
text tqfs "--format=%s"
text tqdots ".."
text tqmbox "mbox"
text tqgout "gout"
text tqfb "--base"
text tqft "--title"
text tqfm "--message-file"
text tqfy "--yes"
text tqns "interplane-patch"
text tqst1 "interplane-patch 1\n"
text tqslash "/"
text tqpnew "/patches/new"
text tqfrepo "&repo="
text tqfbase "&base="
text tqfttl "&title="
text tqfdsc "&description="
text tqfmbx "&mbox="
text tqfsig "&sig="
text tqpath "path "
text tqrefu "refused: "
text tqusage "usage: interplane patch [--base REF] [--title T] [--message-file F] [--yes] OWNER/REPO"
text tqnowt "this folder is not inside a git work tree"
text tqnohd "this work tree has no commit at HEAD"
text tqnobs "cannot find the remote's main (refs/remotes/origin/main); name the base with --base REF"
text tqbadb "the --base value does not name a commit here"
text tqnone "there is no commit between the base and HEAD: nothing to send"
text tqmany "more than 100 commits between the base and HEAD: a patch holds at most 100"
text tqbig "the patch is larger than 2097152 bytes: nothing sent"
text tqgit "git could not build the patch"
text tqttlb "the title must be 1 to 256 bytes on one line; give one with --title"
text tqdscb "the message file must hold at most 60000 bytes"
text tqdscf "cannot read the message file"
text tqs1 "Repository: "
text tqs2 "Base: "
text tqs3 "Commits: "
text tqs4 "Files changed: "
text tqs5 "Bytes: "
text tqs6 "Title: "
text tqs7 "Send to: "
text tqask "Type yes to send this patch, anything else to stop:\n"
text tqpage "Patch page: "
text tqhave "Interplane already has this patch.\n"
text tqref "Interplane refused the patch: "
text tqno "Nothing sent.\n"
text tqsetp "/settings"
global gqrepo uchar 256
global gqrepol ulong 1
global gqbref uchar 4096
global gqbrefl ulong 1
global gqmsgf uchar 4096
global gqmsgfl ulong 1
global gqbase uchar 40
global gqttl uchar 256
global gqttll ulong 1
global gqdsc uchar 60000
global gqdscl ulong 1
global gqyes ulong 1
global gqncm ulong 1
global gqnfl ulong 1
global gqbytes ulong 1
note ---- arguments
fn ptrepoc c uchar to bool
if isaln c
ret true
end
ret or or eq c 45 eq c 46 eq c 95
end
note ptrepo: OWNER/REPO: two names of letters, digits, '.', '-' and '_' around one slash
fn ptrepo a view uchar * to void
sl = ulong 0
ns = ulong 0
for i ulong len a bound 256
c = get a i
if eq c 47
ns = add ns 1
sl = i
else
if not ptrepoc c
die tqusage
end
end
end
if or ne ns 1 eq sl 0
die tqusage
end
if or eq add sl 1 len a eq get a 0 46
die tqusage
end
if eq get a add sl 1 46
die tqusage
end
for i ulong len a bound 256
put gqrepo i get a i
end
put gqrepol 0 len a
end
fn ptflag a view uchar * t view uchar * to bool
ret beq a t
end
note ptval i ac w: the value of the flag at argument i (the next argument) into its global: w 0
note --base (no leading '-'), 1 --title (1..256 bytes), 2 --message-file
fn ptval i ulong ac ulong w ulong to void
a = new uchar 4096 0
if ge add i 1 ac
die tqusage
end
n = getarg add i 1 a
if eq n 0
die tqusage
end
if eq w 0
if eq get a 0 45
die tqbadb
end
for k ulong n bound 4096
put gqbref k get a k
end
put gqbrefl 0 n
end
if eq w 1
if gt n 256
die tqttlb
end
for k ulong n bound 256
put gqttl k get a k
end
put gqttll 0 n
end
if eq w 2
for k ulong n bound 4096
put gqmsgf k get a k
end
put gqmsgfl 0 n
end
end
note ptargs: ac counts the program and "patch". The tool takes at most 8 arguments after "patch"
note (--base REF, --title T, --message-file F, --yes, OWNER/REPO): more is the usage line (exit 1),
note answered before the loop, so the loop runs at most 8 times whatever the argument count.
fn ptargs ac ulong to void
if gt ac 10
die tqusage
end
a = new uchar 4096 0
got = false
i = ulong 2
while lt i ac bound 8
n = getarg i a
w = ulong 9
if ptflag part a 0 n tqfb
w = ulong 0
end
if ptflag part a 0 n tqft
w = ulong 1
end
if ptflag part a 0 n tqfm
w = ulong 2
end
if ptflag part a 0 n tqfy
w = ulong 3
end
if lt w 3
ptval i ac w
i = add i 1
end
if eq w 3
put gqyes 0 1
end
if eq w 9
if or got eq n 0
die tqusage
end
if or eq get a 0 45 gt n 200
die tqusage
end
ptrepo part a 0 n
got = true
end
i = add i 1
end
if not got
die tqusage
end
end
note ---- git: an argument list, standard output into the temp file gout (or mbox), no shell
note gitline: the first line of gout into o; its length
fn gitline o edit uchar 4096 to ulong
fd = topen tqgout 0
n = read fd o 0 4096
pl_close fd
if lt n 0
die terrio
end
k = ulong 0
while lt k ulong n bound 4096
if eq get o k 10
break
end
k = add k 1
end
ret k
end
fn ishex40 o view uchar * to bool
if ne len o 40
ret false
end
for i ulong 40
c = get o i
h = or isdig c and ge c 97 le c 102
if not h
ret false
end
end
ret true
end
note gitcommit ref eoo: rev-parse --verify --quiet [--end-of-options] <ref>^{commit}: the 40 hex
note digits into o; false when ref names no commit
fn gitcommit ref view uchar * eoo bool o edit uchar 40 to bool
a = new uchar 4096 0
q = new uchar 4200 0
l = new uchar 4096 0
avinit a
avadd a tqprog
avadd a tqrp
avadd a tqver
avadd a tqqt
if eoo
avadd a tqeoo
end
n = cpy q 0 ref
n = cpy q n tqcmt
avadd a part q 0 n
if ne runprog a tqgout 0
ret false
end
k = gitline l
if not ishex40 part l 0 k
ret false
end
for i ulong 40
put o i get l i
end
ret true
end
note ptrange: "<base>..HEAD" into q; its length
fn ptrange q edit uchar 64 to ulong
for i ulong 40
put q i get gqbase i
end
n = cpy q 40 tqdots
ret cpy q n tqhd
end
fn ptbase to void
b = new uchar 40 0
a = new uchar 4096 0
l = new uchar 4096 0
r = new uchar 4096 0
if gt get gqbrefl 0 0
n = get gqbrefl 0
for i ulong n bound 4096
put r i get gqbref i
end
if not gitcommit part r 0 n true b
die tqbadb
end
else
avinit a
avadd a tqprog
avadd a tqmb
avadd a tqhd
avadd a tqorg
if ne runprog a tqgout 0
die tqnobs
end
k = gitline l
if not ishex40 part l 0 k
die tqnobs
end
for i ulong 40
put b i get l i
end
end
for i ulong 40
put gqbase i get b i
end
end
note ptcount: the commits of base..HEAD (1..100)
fn ptcount to void
a = new uchar 4096 0
l = new uchar 4096 0
q = new uchar 64 0
v = new ulong 1 0
avinit a
avadd a tqprog
avadd a tqrl
avadd a tqcnt
n = ptrange q
avadd a part q 0 n
if ne runprog a tqgout 0
die tqgit
end
k = gitline l
if not pdec part l 0 k v
die tqgit
end
if eq get v 0 0
die tqnone
end
if gt get v 0 100
die tqmany
end
put gqncm 0 get v 0
end
note ptmbox: git format-patch --stdout base..HEAD into the temp file mbox; its size in gqbytes
fn ptmbox to void
a = new uchar 4096 0
q = new uchar 64 0
st = new uchar 256 0
avinit a
avadd a tqprog
avadd a tqfp
avadd a tqso
avadd a tqo1
avadd a tqo2
avadd a tqo3
avadd a tqo4
avadd a tqo5
avadd a tqo6
avadd a tqo7
avadd a tqo8
avadd a tqo9
avadd a tqo10
avadd a tqo11
n = ptrange q
avadd a part q 0 n
if ne runprog a tqmbox 0
die tqgit
end
fd = topen tqmbox 0
if lt pl_fstat fd st 0
die terrio
end
pl_close fd
sz = pl_size st
if gt sz 2097152
die tqbig
end
put gqbytes 0 sz
end
note ptfiles: the files base and HEAD differ in (the names of git diff --name-only -z, counted)
fn ptfiles to void
a = new uchar 4096 0
b = new uchar 65536 0
avinit a
avadd a tqprog
avadd a tqdf
avadd a tqnmo
avadd a tqz
for i ulong 40
put b i get gqbase i
end
avadd a part b 0 40
avadd a tqhd
if ne runprog a tqgout 0
die tqgit
end
fd = topen tqgout 0
c = ulong 0
while true bound 9223372036854775807
r = read fd b 0 65536
if eq r -4
continue
end
if lt r 0
die terrio
end
if eq r 0
break
end
for i ulong ulong r bound 65536
if eq get b i 0
c = add c 1
end
end
end
pl_close fd
put gqnfl 0 c
end
note pttitle: the title: --title, else the subject of the HEAD commit; 1..256 bytes, no control byte
fn pttitle to void
a = new uchar 4096 0
l = new uchar 4096 0
if eq get gqttll 0 0
avinit a
avadd a tqprog
avadd a tqlog
avadd a tqm1
avadd a tqfs
avadd a tqhd
if ne runprog a tqgout 0
die tqgit
end
k = gitline l
if or eq k 0 gt k 256
die tqttlb
end
for i ulong k bound 256
put gqttl i get l i
end
put gqttll 0 k
end
for i ulong get gqttll 0 bound 256
c = get gqttl i
if or lt c 32 eq c 127
die tqttlb
end
end
end
note ptdesc: the description from --message-file (none: empty): carriage returns dropped, blanks
note and line feeds at the end trimmed, at most 60000 bytes
fn ptdesc to void
p = new uchar 4096 0
b = new uchar 65536 0
put gqdscl 0 0
n = get gqmsgfl 0
if eq n 0
ret
end
for i ulong n bound 4096
put p i get gqmsgf i
end
fd = pl_open part p 0 n 4 0
if lt fd 0
die tqdscf
end
k = ulong 0
while true bound 9223372036854775807
r = read int fd b 0 65536
if eq r -4
continue
end
if lt r 0
die tqdscf
end
if eq r 0
break
end
for i ulong ulong r bound 65536
c = get b i
if ne c 13
if ge k 60000
die tqdscb
end
put gqdsc k c
k = add k 1
end
end
end
pl_close int fd
while gt k 0 bound 60000
c = get gqdsc sub k 1
if and and ne c 10 ne c 32 ne c 9
break
end
k = sub k 1
end
put gqdscl 0 k
end
note ---- what would be sent
fn ptshow to void
t = new uchar 4096 0
n = get gqrepol 0
for i ulong n bound 256
put t i get gqrepo i
end
say tqs1
say part t 0 n
say tnl
for i ulong 40
put t i get gqbase i
end
say tqs2
say part t 0 40
say tnl
say tqs3
sayd get gqncm 0
say tnl
say tqs4
sayd get gqnfl 0
say tnl
say tqs5
sayd get gqbytes 0
say tnl
n = get gqttll 0
for i ulong n bound 256
put t i get gqttl i
end
say tqs6
sayp part t 0 n
say tnl
n = gcopy 0 t
say tqs7
say part t 0 n
say tnl
end
note ---- the statement: "interplane-patch 1\n<owner>/<repo>\n<base>\n<sha256 of the mbox>\n<sha256 of
note title, line feed, description>\n" into the temp file stmt
fn ptstmt to void
d = new uchar 32 0
x = new uchar 64 0
t = new uchar 60300 0
fd = topen tqmbox 0
shafd fd d
pl_close fd
k = hexw d x 0
fd = tmpfd tstmt
mustwrite fd tqst1
n = get gqrepol 0
for i ulong n bound 256
put t i get gqrepo i
end
mustwrite fd part t 0 n
mustwrite fd tnl
for i ulong 40
put t i get gqbase i
end
mustwrite fd part t 0 40
mustwrite fd tnl
mustwrite fd x
mustwrite fd tnl
n = get gqttll 0
for i ulong n bound 256
put t i get gqttl i
end
put t n 10
m = get gqdscl 0
for i ulong m bound 60000
put t add add n 1 i get gqdsc i
end
y = sha2_digest 256 part t 0 add add n 1 m d
k = hexw d x 0
mustwrite fd x
mustwrite fd tnl
pl_close fd
end
note ---- the form: csrf, repo, base, title, description, mbox (base64url, no padding), sig
fn ptfdesc fd int to void
b = new uchar 4096 0
n = get gqdscl 0
p = ulong 0
while lt p n bound 60000
k = sub n p
if gt k 4096
k = ulong 4096
end
for i ulong k bound 4096
put b i get gqdsc add p i
end
formenc fd part b 0 k
p = add p k
end
end
fn ptfmbox fd int to void
b = new uchar 45000 0
e = new uchar 60000 0
src = topen tqmbox 0
while true bound 9223372036854775807
k = ulong 0
while lt k 45000 bound 9223372036854775807
r = read src b k sub 45000 k
if eq r -4
continue
end
if lt r 0
die terrio
end
if eq r 0
break
end
k = add k ulong r
end
if eq k 0
break
end
el = b64u part b 0 k e
mustwrite fd part e 0 el
if lt k 45000
break
end
end
pl_close src
end
fn ptform to void
t = new uchar 4096 0
fd = tmpfd tform
csrfform fd
mustwrite fd tqfrepo
n = get gqrepol 0
for i ulong n bound 256
put t i get gqrepo i
end
formenc fd part t 0 n
mustwrite fd tqfbase
for i ulong 40
put t i get gqbase i
end
mustwrite fd part t 0 40
mustwrite fd tqfttl
n = get gqttll 0
for i ulong n bound 256
put t i get gqttl i
end
formenc fd part t 0 n
mustwrite fd tqfdsc
ptfdesc fd
mustwrite fd tqfmbx
ptfmbox fd
mustwrite fd tqfsig
formsig fd tstsig
pl_close fd
end
note ptsend: POST the form; a 429 (the write gate: 30 writes a minute) waits a second and sends the
note same form again. 201 and 200 print the patch page and return; anything else prints the server's
note reason and leaves with status 2.
fn ptsend to void
p = new uchar 4096 0
v = new uchar 4096 0
e = new uchar 24 0
n = cpy p 0 tqslash
m = get gqrepol 0
for i ulong m bound 256
put p add n i get gqrepo i
end
n = cpy p add n m tqpnew
c = http part p 0 n true tbody
while eq c 429 bound 9223372036854775807
pl_sleep
c = http part p 0 n true tbody
end
if or eq c 201 eq c 200
k = mustval tqpath 10 v
if eq c 200
say tqhave
end
say tqpage
m = gcopy 0 p
say part p 0 m
say part v 0 k
say tnl
ret
end
r = fval tbody tqrefu 10
warn tpfx
if ge r 0
for i ulong ulong r bound 4096
put v i get gval i
end
warn tqref
warn part v 0 ulong r
else
k = decw c e 0
warn thttpbad
warn part e 0 k
end
warn tnl
cleanup
exit 2
end
note patchflow: the whole command; ac is the argument count. Returns the exit status 0 or 1.
fn patchflow ac ulong to int
pk = new uchar 32 0
a = new uchar 4096 0
l = new uchar 4096 0
h = new uchar 40 0
ptargs ac
tmpsetup
setbase
avinit a
avadd a tqprog
avadd a tqrp
avadd a tqiw
if ne runprog a tqgout 0
die tqnowt
end
k = gitline l
if not beq part l 0 k tqtrue
die tqnowt
end
if not gitcommit tqhd false h
die tqnohd
end
ptbase
ptcount
ptmbox
ptfiles
pttitle
ptdesc
ptshow
if eq get gqyes 0 0
if not consent tqask
say tqno
cleanup
ret 1
end
end
makekey
readpk pk
ptstmt
sign tstmt tqns
signin0 pk
csrfof tqsetp
ptform
ptsend
cleanup
ret 0
end

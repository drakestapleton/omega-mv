note Network flows. The only network path is /usr/bin/curl with an argument list.
text tcurl "/usr/bin/curl"
text tsshk "/usr/bin/ssh-keygen"
text tdevnul "/dev/null"
text tdefb "https://interplane.io"
text tbenv "INTERPLANE_BASE="
text thomee "HOME="
text thttps "https://"
text thttp "http://"
text tloop1 "http://127.0.0.1:"
text tloop2 "http://localhost:"
text tprots "=https"
text tproth "=http"
text tbadb "INTERPLANE_BASE must be https://..., or http:// on 127.0.0.1 or localhost"
text tq "-q"
text tss "-sS"
text tproto "--proto"
text tpredir "--proto-redir"
text tmaxr "--max-redirs"
text tzero "0"
text tdh "-D"
text tdo "-o"
text tdw "-w"
text thcode "%{http_code}"
text tdhh "-H"
text tatsign "@"
text tdata "--data-binary"
text treqh "reqh"
text thdr "hdr"
text tbody "body"
text tcode "code"
text tcerr "cerr"
text tform "form"
text tstmt "stmt"
text tstsig "stmt.sig"
text tchal "chal"
text tchsig "chal.sig"
text tgettar "get.tar"
text torig "Origin: "
text tcook "Cookie: "
text tctype "\nContent-Type: application/x-www-form-urlencoded"
text tsemi "; "
text tpre "__Host-forge_pre="
text tsess "__Host-forge_session="
text tsetc "set-cookie: "
text tlogin "/login"
text topenp "/open/"
text tup "/open/up"
text tupj "/open/up/"
text tjson ".json"
text tcsrf "name=\"csrf\" value=\""
text tnonce "name=\"nonce\" value=\""
text tts "name=\"ts\" value=\""
text tquote "\""
text tfcsrf "csrf="
text tfnonce "&nonce="
text tfts "&ts="
text tfdid "&did="
text tfsig "&sig="
text tachunk "&action=chunk&sha="
text tafin "&action=finish&sha="
text tfseq "&seq="
text tfdata "&data="
text tffiles "&files="
text tfbytes "&bytes="
text tfname "&name="
text tfcons "&consent=yes"
text tnext "next "
text tqueued "queued "
text tchal1 "interplane-forge-login:"
text tcolon1 ":"
text tsig1 "-Y"
text tsign "sign"
text tf "-f"
text tn "-n"
text tnsf "interplane-forge"
text tnsb "interplane-bring"
text ttype "-t"
text ted "ed25519"
text tnpw "-N"
text tcmt "-C"
text tinter "interplane"
text tdir "/.interplane"
text tkeynm "/.interplane/key"
text tpubnm "/.interplane/key.pub"
text tssh "ssh-ed25519 "
text tst1 "interplane-bring 1\nsha256 "
text tst2 "\nfiles "
text tst3 "\nbytes "
text tst4 "\nname "
text tstate "\"state\":\""
text trid "\"rid\":\"rad:"
text tpage "\"page\":\""
text tdl "\"download\":\""
text tdlsha "\"download_sha256\":\""
text tjname "\"name\":\""
text tstored "stored"
text trefused "refused"
text tsent "Sent "
text tof " of "
text tbsuf " bytes"
text twait "Interplane has the files and is publishing them. This can take a minute.\n"
text tpubd "Your project page: "
text tdev "Developer details: Radicle ID rad:"
text tclone ", rad clone rad:"
text tsaved "Saved in ./"
text trad "rad:"

text tnetbad "could not reach Interplane (curl failed)"
text thttpbad "Interplane answered with HTTP "
text tbadrsp "Interplane sent an answer this program does not understand"
text t413 "Interplane answered 413: a request was too large for a proxy in front of it (the hub has no project size limit)"
text t503 "Interplane cannot take uploads right now (queue or storage full); try again later"
text tbusy "The download server is busy; trying again in 10 seconds.\n"
text t403 "Interplane refused the session (sign-in, CSRF or origin)"
text tref "Interplane refused the project: "
text tkeyerr "could not make or read the key in ~/.interplane"
text tsigerr "ssh-keygen could not sign"
text tnohome "HOME is not set"
text tshabad "the download does not match its published SHA-256; nothing was unpacked"
text tridbad "not a project page address or Radicle ID"
text tnodl "this project has no download"
text tnokey "only the computer that brought a project can withdraw it, and this computer has no Interplane key (~/.interplane/key); nothing sent"
text tnotmine "this project was brought by another key; only the computer that brought it can withdraw it; nothing sent"
text tnoshelf "this project is not on the Interplane shelf"
text tjby "\"brought_by\":\""
text twd1 "Project: "
text twd2 "Brought by: "
text twdq "Withdrawing takes your project off the Interplane shelf, stops this site serving it and stops the Interplane hub sharing it on Radicle. It cannot remove copies that other computers already fetched: publishing was permanent.\nType yes to withdraw it, anything else to stop:\n"
text twdact "&action=withdraw&rid=rad%3A"
text twdwait "Interplane is taking the project off the shelf. This can take a minute.\n"
text twdone "Withdrawn.\n"
text tsgnout "Interplane signed you out before the withdraw was sent; nothing was withdrawn. Run the line again."
text tlocn "location:"
text tloginp "/login"
text tcss "://"
global gbase uchar 4096
global gbasel ulong 1
global ghome uchar 4096
global ghomel ulong 1
global gpre uchar 4096
global gprel ulong 1
global gsess uchar 4096
global gsessl ulong 1
global gcsrf uchar 4096
global gcsrfl ulong 1
global gval uchar 4096
global ghttp uchar 1
global gsha uchar 64
global gname uchar 64
global gnamel ulong 1
global gtotal ulong 1

fn envget key view uchar * o edit uchar * to long
b = new uchar 65536 0
nn = pl_envc
for i ulong ulong nn bound 9223372036854775807
r = pl_env i b
if gt r 0
if bat part b 0 ulong r 0 key
k = sub ulong r len key
for j ulong k bound 9223372036854775807
put o j get b add len key j
end
ret long k
end
end
end
ret -1
end
fn setbase to void
o = new uchar 4096 0
n = envget tbenv o
if lt n 0
n = long cpy o 0 tdefb
end
k = ulong n
while and gt k 0 eq get o sub k 1 47 bound 4096
k = sub k 1
end
h = bat part o 0 k 0 thttps
if not h
if not or bat part o 0 k 0 tloop1 bat part o 0 k 0 tloop2
die tbadb
end
put ghttp 0 1
end
if or le k 8 gt k 4000
die tbadb
end
for i ulong k bound 4096
c = get o i
if or le c 32 ge c 127
die tbadb
end
if or eq c 34 eq c 92
die tbadb
end
put gbase i c
end
put gbasel 0 k
hm = new uchar 4096 0
m = envget thomee hm
if le m 0
die tnohome
end
for i ulong ulong m bound 4096
put ghome i get hm i
end
put ghomel 0 ulong m
end
fn tmpfd nm view uchar * to int
ret topen nm 2
end
fn nullfd to int
fd = pl_open tdevnul 4 0
if lt fd 0
die terrio
end
ret int fd
end
note runs an argv. stdout goes to tmp file outnm, stderr to cerr.
fn runprog a view uchar * outnm view uchar * to long
i = nullfd
o = tmpfd outnm
e = tmpfd tcerr
r = pl_run part a 0 get gavn 0 i o e
pl_close i
pl_close o
pl_close e
ret r
end
fn avtmp a edit uchar * nm view uchar * to void
p = new uchar 4096 0
k = tpath nm p
avadd a part p 0 k
end
fn wrcookie fd int to void
mustwrite fd tcook
first = true
if gt get gprel 0 0
mustwrite fd tpre
wglob fd 2
first = false
end
if gt get gsessl 0 0
if not first
mustwrite fd tsemi
end
mustwrite fd tsess
wglob fd 3
end
end
fn showcerr to void
fd = topen tcerr 0
b = new uchar 4096 0
while true bound 9223372036854775807
r = read int fd b 0 len b
if le r 0
break
end
warn part b 0 ulong r
end
pl_close int fd
end
note GET when post is false; POST sends the form temp file. Returns HTTP status.
fn http path view uchar * post bool outnm view uchar * to ulong
reqhfile post
a = new uchar 4096 0
curlargs a post outnm
u = new uchar 8192 0
un = gcopy 0 u
un = cpy u un path
avadd a part u 0 un
r = runprog a tcode
if ne r 0
showcerr
die tnetbad
end
ret readcode
end
note busy: 503, 502, 504 and 429 mean the server is busy (dl's cold-build cache answers 503 with
note Retry-After for up to a minute; the write gate answers 429 and 503).
fn busy c ulong to bool
ret or or eq c 503 eq c 502 or eq c 504 eq c 429
end
note waitbusy: the plain busy line, then 10 seconds
fn waitbusy to void
warn tbusy
for i ulong 10
pl_sleep
end
end
note hget: a GET that waits out a busy server for as long as it stays busy (no count, the owner's
note no-hard-caps rule; the bound is the language's loop bound, not a give-up count). Any other code
note is returned to the caller unchanged.
fn hget path view uchar * outnm view uchar * to ulong
while true bound 9223372036854775807
c = http path false outnm
if not busy c
ret c
end
waitbusy
end
ret 0
end
fn reqhfile post bool to void
fd = tmpfd treqh
mustwrite fd torig
wglob fd 0
mustwrite fd tnl
if or gt get gprel 0 0 gt get gsessl 0 0
wrcookie fd
end
if post
mustwrite fd tctype
end
mustwrite fd tnl
pl_close fd
end
fn curlargs a edit uchar * post bool outnm view uchar * to void
avinit a
avadd a tcurl
avadd a tq
avadd a tss
avadd a tproto
if eq get ghttp 0 1
avadd a tproth
avadd a tpredir
avadd a tproth
else
avadd a tprots
avadd a tpredir
avadd a tprots
end
avadd a tmaxr
avadd a tzero
avadd a tdh
avtmp a thdr
avadd a tdo
avtmp a outnm
avadd a tdw
avadd a thcode
avadd a tdhh
avat a treqh
if post
avadd a tdata
avat a tform
end
end
note avat: one argument "@<temp path of nm>" (curl reads that file)
fn avat a edit uchar * nm view uchar * to void
p = new uchar 4096 0
k = tpath nm p
q = new uchar 4097 0
put q 0 64
for i ulong k bound 4096
put q add i 1 get p i
end
avadd a part q 0 add k 1
end
fn readcode to ulong
c = new uchar 8 0
fd = topen tcode 0
n = read int fd c 0 8
pl_close fd
if ne n 3
die tbadrsp
end
v = new ulong 1 0
if not pdec part c 0 3 v
die tbadrsp
end
ret get v 0
end
note fval: the bytes after marker up to term in temp file nm (into gval); -1 absent, -2 too long or
note malformed. The file is read through a 64 KiB window that keeps its last 8 KiB, so a response
note of any size is scanned; a value is a wire field (cookie, csrf, sha, rid, path) of at most 4096 bytes.
fn fval nm view uchar * mk view uchar * term uchar to long
fd = topen nm 0
b = new uchar 73728 0
n = ulong 0
while true bound 9223372036854775807
r = read int fd b n 65536
if lt r 0
die terrio
end
tot = add n ulong r
v = fscan part b 0 tot mk term eq r 0
if ne v -3
pl_close int fd
ret v
end
n = fkeep b tot
end
ret -1
end
note fkeep: move the last 8192 bytes of b[0, tot) to the front; returns the kept count
fn fkeep b edit uchar * tot ulong to ulong
if le tot 8192
ret tot
end
s = sub tot 8192
for x ulong 8192
put b x get b add s x
end
ret 8192
end
note fscan: -3 when more input is needed (no marker yet, or a value runs to the window's end)
fn fscan b view uchar * mk view uchar * term uchar eof bool to long
i = ulong 0
while le add i len mk len b bound 9223372036854775807
if bat b i mk
ret fvalat b add i len mk term eof
end
i = add i 1
end
if eof
ret -1
end
ret -3
end
fn fvalat b view uchar * j ulong term uchar eof bool to long
k = ulong 0
p = j
while lt p len b bound 9223372036854775807
c = get b p
if eq c term
ret long k
end
if or ge k 4096 or lt c 32 eq c 92
ret -2
end
put gval k c
k = add k 1
p = add p 1
end
if not eof
ret -3
end
if eq term 10
ret long k
end
ret -2
end
fn mustval mk view uchar * term uchar o edit uchar * to ulong
r = fval tbody mk term
if lt r 0
die tbadrsp
end
if gt ulong r len o
die tbadrsp
end
for i ulong ulong r bound 4096
put o i get gval i
end
ret ulong r
end
note cookie value from response headers (case-insensitive header name).
fn getcookie nm view uchar * which ulong to void
fd = topen thdr 0
o = new uchar 4096 0
b = new uchar 1 0
line = new uchar 8192 0
n = ulong 0
while true bound 9223372036854775807
r = read int fd b 0 1
if lt r 0
die terrio
end
eol = or eq r 0 eq get b 0 10
if not eol
if lt n len line
put line n get b 0
end
n = add n 1
end
if eol
m = n
if gt m len line
m = len line
end
cookieln part line 0 m nm which
n = ulong 0
if eq r 0
break
end
end
end
pl_close int fd
end
fn cookieln line view uchar * nm view uchar * which ulong to void
if not bati line 0 tsetc
ret
end
if not bat line len tsetc nm
ret
end
o = new uchar 4096 0
s = add len tsetc len nm
k = ulong 0
while lt add s k len line bound 4096
c = get line add s k
if or eq c 59 le c 32
break
end
if ge c 127
break
end
put o k c
k = add k 1
end
gset which part o 0 k
end
fn checkhttp c ulong to void
if eq c 413
die t413
end
if eq c 503
die t503
end
if eq c 403
die t403
end
e = new uchar 24 0
k = decw c e 0
die2 thttpbad part e 0 k
end
fn joinhome nm view uchar * o edit uchar 4096 to ulong
n = gcopy 1 o
ret cpy o n nm
end
fn makekey to void
p = new uchar 4096 0
k = joinhome tdir p
r = pl_mkdir part p 0 k 448
st = new uchar 256 0
if lt pl_stat part p 0 k st 0
die tkeyerr
end
if ne and pl_mode st 61440 16384
die tkeyerr
end
k = joinhome tkeynm p
a = new uchar 4096 0
if lt pl_stat part p 0 k st 0
avinit a
avadd a tsshk
avadd a tq
avadd a ttype
avadd a ted
avadd a tnpw
avadd a part tnpw 0 0
avadd a tcmt
avadd a tinter
avadd a tf
avadd a part p 0 k
if ne runprog a tbody 0
showcerr
die tkeyerr
end
end
end
fn readpk pk edit uchar 32 to void
p = new uchar 4096 0
k = joinhome tpubnm p
fd = pl_open part p 0 k 0 0
if lt fd 0
die tkeyerr
end
b = new uchar 4096 0
n = read int fd b 0 len b
pl_close int fd
if or le n long len tssh not bat part b 0 ulong n 0 tssh
die tkeyerr
end
s = len tssh
e = s
while and lt e ulong n ne get b e 32 bound 4096
if eq get b e 10
break
end
e = add e 1
end
blob = new uchar 64 0
m = b64d part b s sub e s blob
if ne m 51
die tkeyerr
end
if or ne rd32 blob 0 184549376 ne get blob 18 32
die tkeyerr
end
for i ulong 32
put pk i get blob add 19 i
end
end
fn sign nm view uchar * ns view uchar * to void
p = new uchar 4096 0
kp = new uchar 4096 0
kn = joinhome tkeynm kp
sn = new uchar 4096 0
k = tpath nm sn
a = new uchar 4096 0
avinit a
avadd a tsshk
avadd a tsig1
avadd a tsign
avadd a tf
avadd a part kp 0 kn
avadd a tn
avadd a ns
avadd a part sn 0 k
if ne runprog a tbody 0
showcerr
die tsigerr
end
end
fn formput fd int t view uchar * to void
mustwrite fd t
end
fn formsig fd int nm view uchar * to void
src = topen nm 0
b = new uchar 4096 0
o = new uchar 12288 0
while true bound 9223372036854775807
r = read int src b 0 len b
if lt r 0
die terrio
end
if eq r 0
break
end
k = formw part b 0 ulong r o 0
mustwrite fd part o 0 k
end
pl_close int src
end
note signin0 pk: sign in (GET /login, the signed challenge, POST /login); the session cookie is kept
fn signin0 pk view uchar 32 to void
put gprel 0 0
put gsessl 0 0
c = http tlogin false tbody
if ne c 200
checkhttp c
end
getcookie tpre 2
if eq get gprel 0 0
die tbadrsp
end
cs = new uchar 4096 0
csl = mustval tcsrf 34 cs
no = new uchar 4096 0
nol = mustval tnonce 34 no
tv = new uchar 4096 0
tvl = mustval tts 34 tv
fd = tmpfd tchal
mustwrite fd tchal1
mustwrite fd part no 0 nol
mustwrite fd tcolon1
mustwrite fd part tv 0 tvl
pl_close fd
sign tchal tnsf
d = new uchar 128 0
dl = didkey pk d
fd = tmpfd tform
mustwrite fd tfcsrf
formenc fd part cs 0 csl
mustwrite fd tfnonce
formenc fd part no 0 nol
mustwrite fd tfts
formenc fd part tv 0 tvl
mustwrite fd tfdid
formenc fd part d 0 dl
mustwrite fd tfsig
formsig fd tchsig
pl_close fd
c = http tlogin true tbody
if and ne c 303 ne c 200
checkhttp c
end
getcookie tsess 3
if eq get gsessl 0 0
die t403
end
end
note csrfof p: the session's write csrf, read from the page p
fn csrfof p view uchar * to void
c = http p false tbody
if ne c 200
checkhttp c
end
cs2 = new uchar 4096 0
k2 = mustval tcsrf 34 cs2
gset 4 part cs2 0 k2
end
note signin pk: sign in, then take the write csrf from GET /open/ (bring, withdraw). interplane patch
note takes it from /settings instead (50patch.om): a store-reading forge answers /open/ with its 503
note "moving" page, and the session's settings page carries the same token on every build
fn signin pk view uchar 32 to void
signin0 pk
csrfof topenp
end
fn formenc fd int s view uchar * to void
o = new uchar 12288 0
k = formw s o 0
mustwrite fd part o 0 k
end
fn csrfform fd int to void
mustwrite fd tfcsrf
cs = new uchar 4096 0
k = gcopy 4 cs
formenc fd part cs 0 k
end
fn nextval c ulong to ulong
b = new uchar 64 0
fd = topen tbody 0
n = read int fd b 0 len b
pl_close int fd
if or lt n long len tnext not bat part b 0 ulong n 0 tnext
die tbadrsp
end
e = ulong n
while and gt e len tnext or eq get b sub e 1 10 eq get b sub e 1 13 bound 64
e = sub e 1
end
v = new ulong 1 0
if not pdec part b len tnext sub e len tnext v
die tbadrsp
end
ret get v 0
end
fn wdec fd int v ulong to void
d = new uchar 24 0
k = decw v d 0
mustwrite fd part d 0 k
end
fn progress done ulong total ulong to void
x = done
if gt x total
x = total
end
cr = new uchar 1 0
put cr 0 13
warn cr
warn tsent
warnd x
warn tof
warnd total
warn tbsuf
end
note sendchunks: 45000-byte chunks in seq order. 200 and 409 both name the next seq the server
note wants; 429 waits a second and retries the same chunk for as long as the server says 429;
note 503 (queue or storage full) says so in a line, waits 10 seconds and resends the same chunk.
fn sendchunks tar int sh view uchar * total ulong to void
nch = div add total 44999 45000
seq = ulong 0
while lt seq nch bound 9223372036854775807
progress mul seq 45000 total
chunkform tar sh seq total
c = http tup true tbody
if eq c 429
pl_sleep
continue
end
if eq c 503
warn tnl
waitbusy
continue
end
if and ne c 200 ne c 409
checkhttp c
end
nx = nextval c
if gt nx nch
die tbadrsp
end
seq = nx
end
progress total total
warn tnl
end
fn chunkform tar int sh view uchar * seq ulong total ulong to void
b = new uchar 45000 0
e = new uchar 60000 0
pos = mul seq 45000
k = sub total pos
if gt k 45000
k = ulong 45000
end
r = pl_readat tar part b 0 k pos
if ne r long k
die terrio
end
el = b64u part b 0 k e
fd = tmpfd tform
csrfform fd
mustwrite fd tachunk
mustwrite fd sh
mustwrite fd tfseq
wdec fd seq
mustwrite fd tfdata
mustwrite fd part e 0 el
pl_close fd
end
note bringflow: runs only after the exact "yes". Key, archive, statement and its signature, sign-in,
note chunks, finish, status poll, final lines.
fn bringflow folder view uchar * to void
setbase
makekey
pk = new uchar 32 0
readpk pk
mkarch
mkname
mkstmt
sign tstmt tnsb
signin pk
sh = new uchar 64 0
k = shacopy sh
tr = topen ttar 0
sendchunks tr sh get gtotal 0
pl_close tr
finish sh
pollup sh
finalln
end
fn shacopy o edit uchar 64 to ulong
for i ulong 64
put o i get gsha i
end
ret 64
end
fn mkarch to void
arf = tmpfd ttar
archive arf
pl_close arf
tr = topen ttar 0
d = new uchar 32 0
shafd tr d
st = new uchar 256 0
if lt pl_fstat tr st 0
die terrio
end
put gtotal 0 pl_size st
pl_close tr
h = new uchar 64 0
k = hexw d h 0
for i ulong 64
put gsha i get h i
end
end
note mkname: the statement name from the last component of the folder's absolute path
fn mkname to void
cw = new uchar 4096 0
cl = pl_cwd cw
base = ulong 0
for i ulong cl bound 4096
if eq get cw i 47
base = add i 1
end
end
nm = new uchar 64 0
nl = projname part cw base sub cl base nm
for i ulong nl bound 64
put gname i get nm i
end
put gnamel 0 nl
end
fn wname fd int to void
nm = new uchar 64 0
n = get gnamel 0
for i ulong n bound 64
put nm i get gname i
end
mustwrite fd part nm 0 n
end
fn mkstmt to void
sh = new uchar 64 0
k = shacopy sh
fd = tmpfd tstmt
mustwrite fd tst1
mustwrite fd sh
mustwrite fd tst2
wdec fd get gcount 0
mustwrite fd tst3
wdec fd get gtotal 0
mustwrite fd tst4
wname fd
mustwrite fd tnl
pl_close fd
end
fn finish sh view uchar * to void
fd = tmpfd tform
csrfform fd
mustwrite fd tafin
mustwrite fd sh
mustwrite fd tffiles
wdec fd get gcount 0
mustwrite fd tfbytes
wdec fd get gtotal 0
mustwrite fd tfname
wname fd
mustwrite fd tfcons
mustwrite fd tfsig
formsig fd tstsig
pl_close fd
c = http tup true tbody
while or eq c 503 eq c 429 bound 9223372036854775807
if eq c 429
pl_sleep
else
waitbusy
end
c = http tup true tbody
end
if ne c 200
checkhttp c
end
q = new uchar 4096 0
ql = mustval tqueued 10 q
if lt ql 64
die tbadrsp
end
if not bat part q 0 ql 0 sh
die tbadrsp
end
end
fn pollup sh view uchar * to void
p = new uchar 4096 0
pn = cpy p 0 tupj
pn = cpy p pn sh
pn = cpy p pn tjson
said = false
s = new uchar 4096 0
while true bound 9223372036854775807
c = hget part p 0 pn tbody
if ne c 200
checkhttp c
end
sl = mustval tstate 34 s
if beq part s 0 sl tstored
break
end
if bat part s 0 sl 0 trefused
die2 tref part s 0 sl
end
if not said
say twait
said = true
end
pl_sleep
end
end
fn finalln to void
rid = new uchar 4096 0
rl = mustval trid 34 rid
pg = new uchar 4096 0
gl = mustval tpage 34 pg
if eq gl 0
die tbadrsp
end
if ne get pg 0 47
die tbadrsp
end
bb = new uchar 4096 0
bl = gcopy 0 bb
say tpubd
say part bb 0 bl
sayp part pg 0 gl
say tnl
say tdev
sayp part rid 0 rl
say tclone
sayp part rid 0 rl
say tnl
end
fn b58ok c uchar to bool
for i ulong 58
if eq get tb58 i c
ret true
end
end
ret false
end
note ridarg: the RID in a page address (<base>/open/<rid>), rad:<rid> or a bare <rid>, checked and
note copied into o; anything else stops with tridbad
fn ridarg arg view uchar * o edit uchar * to ulong
s = ulong 0
pfx = new uchar 8192 0
pn = gcopy 0 pfx
pn = cpy pfx pn topenp
if bat arg 0 part pfx 0 pn
s = pn
else
if bat arg 0 trad
s = len trad
end
end
e = len arg
while and gt e s eq get arg sub e 1 47 bound 9223372036854775807
e = sub e 1
end
ret ridcopy part arg s sub e s o
end
fn ridcopy rid view uchar * o edit uchar * to ulong
if or lt len rid 20 gt len rid 60
die tridbad
end
if ne get rid 0 122
die tridbad
end
for i ulong len rid bound 60
if not b58ok get rid i
die tridbad
end
put o i get rid i
end
ret len rid
end
fn ridjson rid view uchar * p edit uchar * to ulong
n = cpy p 0 topenp
n = cpy p n rid
ret cpy p n tjson
end
note getflow: r is made before setbase: ng front-ir (macOS build) reports "not lowered" for a new
note right after a leading setbase here; omc accepts both orders (PLATFORMS.md, ng defects)
fn getflow arg view uchar * to void
r = new uchar 64 0
setbase
n = ridarg arg r
getflow2 part r 0 n
end
fn getflow2 rid view uchar * to void
p = new uchar 4096 0
n = ridjson rid p
c = hget part p 0 n tbody
if ne c 200
checkhttp c
end
dl = new uchar 4096 0
if lt fval tbody tdl 34 0
die tnodl
end
dn = mustval tdl 34 dl
getmeta
getfile part dl 0 dn
end
note wdflow: interplane withdraw. The key must already exist (it is never made here); the shelf JSON
note names the project and its bringer; a bringer that is not this key's DID stops before anything
note is sent; then the plain text and one line from /dev/tty. Only after the exact yes: sign-in (with
note the csrf from GET /open/), POST /open/ action=withdraw, and the JSON polled until 404 (off the
note shelf). False when the answer was not yes: nothing was sent.
fn wdflow arg view uchar * to bool
setbase
haskey
r = new uchar 64 0
n = ridarg arg r
pk = new uchar 32 0
readpk pk
p = new uchar 4096 0
pn = ridjson part r 0 n p
wdcheck pk part p 0 pn
if not consent twdq
ret false
end
signin pk
wdpost part r 0 n
wdpoll part p 0 pn
say twdone
ret true
end
fn haskey to void
p = new uchar 4096 0
st = new uchar 256 0
k = joinhome tkeynm p
if lt pl_stat part p 0 k st 0
die tnokey
end
k = joinhome tpubnm p
if lt pl_stat part p 0 k st 0
die tnokey
end
end
note wdcheck: the shelf row's name and brought_by, shown; brought_by must be this key's DID
fn wdcheck pk view uchar 32 p view uchar * to void
c = hget p tbody
if eq c 404
die tnoshelf
end
if ne c 200
checkhttp c
end
nm = new uchar 4096 0
nl = mustval tjname 34 nm
by = new uchar 4096 0
bl = mustval tjby 34 by
say twd1
sayp part nm 0 nl
say tnl
say twd2
sayp part by 0 bl
say tnl
d = new uchar 128 0
dl = didkey pk d
if not beq part by 0 bl part d 0 dl
die tnotmine
end
end
fn wdpost rid view uchar * to void
fd = tmpfd tform
csrfform fd
mustwrite fd twdact
mustwrite fd rid
pl_close fd
c = http topenp true tbody
while busy c bound 9223372036854775807
if eq c 429
pl_sleep
else
waitbusy
end
c = http topenp true tbody
end
if ne c 303
checkhttp c
end
lo = new uchar 4096 0
ln = hdrloc lo
if wdopen part lo 0 ln
ret
end
if gt bfind part lo 0 ln tloginp 0 -1
warn tsgnout
warn tnl
cleanup
exit 1
end
checkhttp c
end
note wdopen: the withdraw was taken only when the 303 goes to the shelf: Location is <base>/open/,
note absolute or as the base's path (the hub writes its base path, e.g. /open/)
fn wdopen loc view uchar * to bool
bb = new uchar 4096 0
bl = gcopy 0 bb
bl = cpy bb bl topenp
if beq loc part bb 0 bl
ret true
end
p = bfind part bb 0 bl tcss 0
if lt p 0
ret false
end
q = add ulong p len tcss
while and lt q bl ne get bb q 47 bound 4096
q = add q 1
end
ret beq loc part bb q sub bl q
end
note hdrloc: the Location header of the last answer (temp file hdr) into o; its length, 0 when none
fn hdrloc o edit uchar * to ulong
fd = topen thdr 0
b = new uchar 1 0
line = new uchar 8192 0
n = ulong 0
k = ulong 0
while true bound 9223372036854775807
r = read int fd b 0 1
if lt r 0
die terrio
end
eol = or eq r 0 eq get b 0 10
if not eol
if lt n len line
put line n get b 0
end
n = add n 1
end
if eol
if gt n len line
n = len line
end
v = locln part line 0 n o
if gt v 0
k = v
end
n = ulong 0
if eq r 0
break
end
end
end
pl_close int fd
ret k
end
fn locln line view uchar * o edit uchar * to ulong
if not bati line 0 tlocn
ret 0
end
s = len tlocn
while and lt s len line eq get line s 32 bound 8192
s = add s 1
end
k = ulong 0
while and lt add s k len line lt k len o bound 8192
c = get line add s k
if le c 32
break
end
put o k c
k = add k 1
end
ret k
end
fn wdpoll p view uchar * to void
said = false
while true bound 9223372036854775807
c = hget p tbody
if eq c 404
ret
end
if ne c 200
checkhttp c
end
if not said
say twdwait
said = true
end
pl_sleep
end
end
note getmeta: download_sha256 into gsha, the folder name (the statement rule) into gname
fn getmeta to void
want = new uchar 4096 0
wn = mustval tdlsha 34 want
if ne wn 64
die tbadrsp
end
for i ulong 64
c = get want i
if not or isdig c and ge c 97 le c 102
die tbadrsp
end
put gsha i c
end
nm0 = new uchar 4096 0
nn0 = mustval tjname 34 nm0
nm = new uchar 64 0
nl = projname part nm0 0 nn0 nm
for i ulong nl bound 64
put gname i get nm i
end
put gnamel 0 nl
end
fn getfile dl view uchar * to void
if or lt len dl 7 not bat dl 0 topenp
die tbadrsp
end
for i ulong len dl bound 4096
c8 = get dl i
if not or unres c8 eq c8 47
die tbadrsp
end
end
if gt bfind dl tdotdot 0 -1
die tbadrsp
end
c = hget dl tgettar
if ne c 200
checkhttp c
end
tr = topen tgettar 0
d = new uchar 32 0
shafd tr d
h = new uchar 64 0
k = hexw d h 0
want = new uchar 64 0
k = shacopy want
if not beq h want
die tshabad
end
r = pl_seek tr 0
tarwalk tr false
r = pl_seek tr 0
unpackin tr
pl_close tr
end
fn unpackin tr int to void
nm = new uchar 64 0
n = get gnamel 0
for i ulong n bound 64
put nm i get gname i
end
if ne pl_mkdir part nm 0 n 493 0
die texists
end
if lt pl_cd part nm 0 n 0
die texists
end
tarwalk tr true
say tsaved
say part nm 0 n
say tnl
end
fn gcopy which ulong o edit uchar * to ulong
n = ulong 0
if eq which 0
n = get gbasel 0
for i ulong n bound 4096
put o i get gbase i
end
end
if eq which 1
n = get ghomel 0
for i ulong n bound 4096
put o i get ghome i
end
end
if eq which 2
n = get gprel 0
for i ulong n bound 4096
put o i get gpre i
end
end
if eq which 3
n = get gsessl 0
for i ulong n bound 4096
put o i get gsess i
end
end
if eq which 4
n = get gcsrfl 0
for i ulong n bound 4096
put o i get gcsrf i
end
end
ret n
end
fn gset which ulong s view uchar * to void
if gt len s 4096
die tbadrsp
end
for i ulong len s bound 4096
if eq which 2
put gpre i get s i
end
if eq which 3
put gsess i get s i
end
if eq which 4
put gcsrf i get s i
end
end
if eq which 2
put gprel 0 len s
end
if eq which 3
put gsessl 0 len s
end
if eq which 4
put gcsrfl 0 len s
end
end
fn wglob fd int which ulong to void
o = new uchar 4096 0
n = gcopy which o
mustwrite fd part o 0 n
end

note Snapshot walk: file-backed records and contents, no entry-count or file-size table.
note Record: path length u16, mode u64 at 8, size u64 at 16, spool offset u64 at 24,
note path bytes at 32 (ustar wire maximum 255), zero padding to 288.
text terrio "local file operation failed"
text terrdir "cannot open project folder"
text tdot "."
text tdotdot ".."
text tgit ".git"
text tgitwhy "version-control metadata"
text tsymwhy "symlink or special file"
text tlongwhy "path cannot be represented by POSIX ustar"
text tsecret "likely secret (name or content)"
text tleft "Left out: "
text tcolon ": "
text tpriv "PRIVATE KEY-----"
text tgh "ghp_"
text tghpat "github_pat_"
text taki "AKIA"
text txox "xox"
text tsk "sk_live_"
text tai "AIza"
text tant "sk-ant-"
text tpwd "password"
text tpass "passwd"
text tsecr "secret"
text ttok "token"
text tenv ".env"
text tnetrc ".netrc"
text tcred "credentials"
text tid "id_"
text tpem ".pem"
text tkey ".key"
text tp12 ".p12"
text tpub ".pub"
text tfiles "files"
text tkeep "keep"
text tdirs "dirs"
global gsorted uchar 1
text ttar "list.tar"
text ttmp "/tmp/interplane-tool-"
text tname "Name: "
text tcnt "Files: "
text tbytes "Bytes: "
global gcount ulong 1
global gbytes ulong 1
global grecfd int 1
global gspool int 1
global goffset ulong 1

fn mustwrite fd int b view uchar * to void
if not wall fd b
die terrio
end
end
fn exactread fd int b edit uchar * to bool
n = ulong 0
while lt n len b bound 9223372036854775807
r = read fd b n sub len b n
if eq r -4
continue
end
if le r 0
ret false
end
n = add n ulong r
end
ret true
end
fn tmpsetup to void
p = new uchar 4096 0
n = cpy p 0 ttmp
n = decw ulong pl_pid p n
put p n 45
n = add n 1
v = ulong 0
while true bound 9223372036854775807
k = decw v p n
r = pl_mkdir part p 0 k 448
if eq r 0
for i ulong k bound 4096
put gtmp i get p i
end
put gtmpl 0 k
put gtmpok 0 1
ret
end
if ne r -17
die terrio
end
v = add v 1
end
end
fn leftout p view uchar * why view uchar * to void
say tleft
sayp p
say tcolon
say why
say tnl
end
fn ends s view uchar * t view uchar * to bool
if lt len s len t
ret false
end
ret bati s sub len s len t t
end
fn secretname s view uchar * to bool
if or bati s 0 tenv bati s 0 tid
ret true
end
if or or beq s tnetrc beq s tcred ends s tpem
ret true
end
ret or ends s tkey ends s tp12
end
fn contenthit b view uchar * to bool
for i ulong len b bound 9223372034775807
if or bat b i tpriv bat b i tgh
ret true
end
if or bat b i tghpat bat b i taki
ret true
end
if or bat b i tsk bat b i tai
ret true
end
if or bat b i tant bat b i txox
ret true
end
if assignhit b i
ret true
end
end
ret false
end
note assignhit: password/passwd/secret/token (any case), more name bytes, '=' or ':', then a value
note of at least 8 bytes that are not space or quote: PASSWORD="hunter2hunter" hits, while the prose
note "password: use a long one" does not.
fn assignhit b view uchar * i ulong to bool
k = ulong 0
if or bati b i tpwd bati b i tpass
k = ulong 6
end
if or bati b i tsecr bati b i ttok
k = ulong 5
end
if eq k 0
ret false
end
j = add i k
while lt j len b bound 9223372036854775807
c = get b j
if not or isaln c or eq c 95 eq c 45
break
end
j = add j 1
end
j = skipsq b j
if ge j len b
ret false
end
c = get b j
if not or eq c 61 eq c 58
ret false
end
j = skipsq b add j 1
v = ulong 0
while lt j len b bound 9223372036854775807
c = get b j
if or le c 32 or eq c 34 eq c 39
break
end
v = add v 1
j = add j 1
end
ret ge v 8
end
fn skipsq b view uchar * j ulong to ulong
k = j
while lt k len b bound 9223372036854775807
c = get b k
if not or eq c 32 or eq c 9 or eq c 34 eq c 39
ret k
end
k = add k 1
end
ret k
end
note scans all bytes and spools them; 128-byte overlap covers every searched marker and assignment.
fn snapshot fd int to bool
b = new uchar 65664 0
n = ulong 0
hit = false
while true bound 9223372036854775807
r = read fd b n 65536
if eq r -4
continue
end
if lt r 0
die terrio
end
if eq r 0
break
end
mustwrite get gspool 0 part b n ulong r
put goffset 0 add get goffset 0 ulong r
k = add n ulong r
if contenthit part b 0 k
hit = true
end
n = k
if gt n 128
n = ulong 128
end
for i ulong n bound 128
put b i get b add sub k n i
end
end
ret not hit
end
fn addfile nm view uchar * path view uchar * to void
if secretname nm
leftout path tsecret
ret
end
fd = pl_open nm 0 0
if lt fd 0
die terrio
end
st = new uchar 256 0
r = pl_fstat int fd st
if lt r 0
die terrio
end
mode = pl_mode st
if ne and mode 61440 32768
pl_close int fd
leftout path tsymwhy
ret
end
start = get goffset 0
ok = snapshot int fd
pl_close int fd
if not ok
leftout path tsecret
r = pl_trunc get gspool 0 start
r = pl_seek get gspool 0 start
put goffset 0 start
ret
end
recfile path mode start
end
fn recfile path view uchar * mode ulong start ulong to void
rec = new uchar 288 0
wr16 rec 0 len path
m = ulong 420
if ne and mode 73 0
m = ulong 493
end
wr64 rec 8 m
sz = sub get goffset 0 start
wr64 rec 16 sz
wr64 rec 24 start
k = cpy rec 32 path
mustwrite get grecfd 0 rec
put gcount 0 add get gcount 0 1
put gbytes 0 add get gbytes 0 sz
end
note each recursion adds a path component, so ustar's wire path bound limits depth, not a chosen cap.
fn walk prefix view uchar * to void
h = pl_dopen tdot
if eq h 0
die terrdir
end
fd = pl_dfd h
b = new uchar 4096 0
while true bound 9223372036854775807
r = pl_dents h b
if lt r 0
die terrio
end
if eq r 0
break
end
walkbuf part b 0 ulong r prefix fd
end
pl_dclose h
end
fn walkbuf b view uchar * prefix view uchar * fd int to void
o = ulong 0
while lt o len b bound 9223372036854775807
sz = pl_dlen b o
if or eq sz 0 gt add o sz len b
die terrio
end
walkent part b o sz prefix fd
o = add o sz
end
end
fn walkent e view uchar * prefix view uchar * fd int to void
nm = new uchar 256 0
n = ulong 0
j = pl_dname
while lt j len e bound 4096
c = get e j
if eq c 0
break
end
if ge n 255
die terrio
end
put nm n c
n = add n 1
j = add j 1
end
if or beq part nm 0 n tdot beq part nm 0 n tdotdot
ret
end
walkone part nm 0 n prefix fd
end
fn walkone nm view uchar * prefix view uchar * parent int to void
path = new uchar 512 0
n = cpy path 0 prefix
n = cpy path n nm
if beq nm tgit
leftout part path 0 n tgitwhy
ret
end
if gt n 255
leftout part path 0 n tlongwhy
ret
end
st = new uchar 256 0
r = pl_stat nm st
if lt r 0
die terrio
end
kind = and pl_mode st 61440
if eq kind 32768
addfile nm part path 0 n
ret
end
if eq kind 16384
fd = pl_open nm 1 0
if lt fd 0
die terrio
end
r = pl_fcd int fd
if lt r 0
die terrio
end
pl_close int fd
put path n 47
walk part path 0 add n 1
r = pl_fcd parent
if lt r 0
die terrio
end
ret
end
leftout part path 0 n tsymwhy
end
note bottom-up merge sort of the record file: ping-pong between files and dirs, O(n log n)
note record reads and two records in memory, whatever the number of files.
fn rdrec fd int i ulong b edit uchar * to void
r = pl_readat fd b mul i 288
if ne r 288
die terrio
end
end
fn mergerun src int dst int lo ulong mid ulong hi ulong to void
a = new uchar 288 0
b = new uchar 288 0
i = lo
j = mid
while or lt i mid lt j hi bound 9223372036854775807
takea = ge j hi
if and lt i mid lt j hi
rdrec src i a
rdrec src j b
takea = not pathless b a
end
if takea
rdrec src i a
mustwrite dst a
i = add i 1
else
rdrec src j b
mustwrite dst b
j = add j 1
end
end
end
fn mergepass src int dst int w ulong to void
n = get gcount 0
s = ulong 0
while lt s n bound 9223372036854775807
m = add s w
if gt m n
m = n
end
e = add m w
if gt e n
e = n
end
mergerun src dst s m e
s = e
end
end
fn sortfiles to void
w = ulong 1
put gsorted 0 0
while lt w get gcount 0 bound 64
src = int 0
dst = int 0
if eq get gsorted 0 0
src = topen tfiles 0
dst = topen tdirs 2
else
src = topen tdirs 0
dst = topen tfiles 2
end
mergepass src dst w
pl_close src
pl_close dst
put gsorted 0 sub 1 get gsorted 0
w = mul w 2
end
end
fn opensorted to int
if eq get gsorted 0 0
ret topen tfiles 0
end
ret topen tdirs 0
end
note pathless: record a sorts before record b (path bytes, then shorter first)
fn pathless a view uchar * b view uchar * to bool
an = rd16 a 0
bn = rd16 b 0
n = an
if gt n bn
n = bn
end
for i ulong n bound 255
x = get a add 32 i
y = get b add 32 i
if lt x y
ret true
end
if gt x y
ret false
end
end
ret lt an bn
end

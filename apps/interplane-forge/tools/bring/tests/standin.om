om2
note tools/bring/tests/standin.om: the stand-in Interplane hub for the tool's tests (Linux, pinned omc).
note   standin serve PORT DIR   answers the contract's sign-in, /open/, /open/up chunk + finish, status,
note                            shelf JSON and archive on 127.0.0.1:PORT, one connection at a time
note   standin count PORT DIR   accepts and closes connections, appending one line per connection
note Every request line is appended to DIR/log; every accepted connection to DIR/conns. Saved:
note DIR/login.form, DIR/up.b64 (chunk data in seq order), DIR/finish.form. GET /login starts a new
note upload (the injection and status state are reset). Injections (when the
note file DIR/inject exists): the first try of seq 1 answers 429, and the first seq 2 answers
note "409 next 1" (the client must resend chunk 1). The status JSON says "queued" once, then "stored"
note (or the line in DIR/refuse as "refused: <line>" when that file exists). GET /open/<rid>.json
note serves DIR/shelf.json and GET /open/<rid>.tar serves DIR/shelf.tar. Busy injections: DIR/busyj
note (for the JSON) and DIR/busyt (for the archive) hold 3-digit codes, e.g. "503503"; each GET
note answers the first code with an empty body and drops it; a "+" after the first code ("503+")
note answers it every time. An empty or absent file serves normally. DIR/busyp does the same for chunk
note POSTs and DIR/busyf for the finish POST (nothing is saved for a busy answer).
note Withdraw: POST /open/ (origin, session, csrf as for /open/up; DIR/busyp applies) saves its form to
note DIR/withdraw.form, answers 303 with Location: /open/ and writes DIR/gone = "1": the next shelf
note JSON GET still serves DIR/shelf.json (the intake has not run yet) and sets it to "2"; from then on
note the JSON is 404. When DIR/signout exists it answers 303 with Location: /login and saves nothing
note (the hub when the session is gone).
note Patch: POST /alice/demo/patches/new (session and csrf as for /open/up) is answered from DIR/busyq,
note 3-digit codes as in DIR/busyp: a 429 with the forge's write-gate reason ("refused: too many
note writes ..."), any other code with an empty body; no code saves the form to DIR/patch.form and
note answers 201 with "path /alice/demo/patches/1". Every POST is one line of DIR/log.
text tserve "serve"
text tcount "count"
text tlog "log"
text tconns "conns"
text tconn "conn\n"
text tlogin "login.form"
text tupb "up.b64"
text tfin "finish.form"
text tinject "inject"
text trefuse "refuse"
text tshelfj "shelf.json"
text tshelft "shelf.tar"
text tbusyj "busyj"
text tbusyt "busyt"
text tbusyp "busyp"
text tbusyf "busyf"
text tbusyq "busyq"
text tptform "patch.form"
text tpostpt "POST /alice/demo/patches/new "
text tgetset "GET /settings "
text tptpath "path /alice/demo/patches/1\n"
text tptgate "refused: too many writes from this address or key; wait a minute\n"
text tgone "gone"
text twdform "withdraw.form"
text tpostop "POST /open/ "
text tone "1"
text tsignout "signout"
text tlocop "Location: /open/\n"
text tloclg "Location: /login\n"
text tgetlog "GET /login "
text tpostlg "POST /login "
text tgetop "GET /open/ "
text tpostup "POST /open/up "
text tgetup "GET /open/up/"
text tgetopn "GET /open/"
text tjs ".json "
text ttar ".tar "
text tpreck "__Host-forge_pre=0123456789abcdef0123456789abcdef"
text tsessck "__Host-forge_session=feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface"
text tcsrf1 "csrf=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
text tcsrf2 "csrf=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
text torig "\norigin: http://127.0.0.1:"
text tlpage "<form><input type=\"hidden\" name=\"csrf\" value=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\">\n<input type=\"hidden\" name=\"nonce\" value=\"00112233445566778899aabbccddeeff\">\n<input type=\"hidden\" name=\"ts\" value=\"1762848000\"></form>\n"
text topage "<form><input type=\"hidden\" name=\"csrf\" value=\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"></form>\n"
text tsc1 "Set-Cookie: __Host-forge_pre=0123456789abcdef0123456789abcdef; Max-Age=900; HttpOnly; Secure; SameSite=Lax; Path=/\n"
text tsc2 "Set-Cookie: __Host-forge_session=feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax; Path=/\nLocation: /\n"
text tachunk "action=chunk"
text tafin "action=finish"
text tseq "&seq="
text tdata "&data="
text tsha "&sha="
text tnext "next "
text tqueued "queued "
text tj1 "{\"schema\":\"interplane/open-upload/1\",\"state\":\"queued\",\"rid\":null,\"page\":null}\n"
text tj2 "{\"schema\":\"interplane/open-upload/1\",\"state\":\"stored\",\"rid\":\"rad:z3gqcJUoA1n9HaHKufZs5FCSGazv5\",\"page\":\"/open/z3gqcJUoA1n9HaHKufZs5FCSGazv5\"}\n"
text tj3a "{\"schema\":\"interplane/open-upload/1\",\"state\":\"refused: "
text tj3b "\",\"rid\":null,\"page\":null}\n"
text th1 "HTTP/1.1 "
text th2 "\nContent-Type: "
text th3 "\nContent-Length: "
text th4 "\nConnection: close\n"
text tplain "text/plain"
text thtml "text/html"
text tjson "application/json"
text tbin "application/x-tar"
text tclen "content-length:"
text tcookie "cookie:"
text tusage "usage: standin serve|count PORT DIR\n"
global gst ulong 8

fn wall fd int b view uchar * to bool
n = ulong 0
while lt n len b bound 9223372036854775807
r = write fd b n sub len b n
if le r 0
ret false
end
n = add n ulong r
end
ret true
end
note hput: text with each LF written as CR LF
fn hput fd int t view uchar * to void
cr = new uchar 2 0
put cr 0 13
put cr 1 10
s = ulong 0
for i ulong len t bound 9223372036854775807
if eq get t i 10
x = wall fd part t s sub i s
x = wall fd cr
s = add i 1
end
end
x = wall fd part t s sub len t s
end
fn decw v ulong o edit uchar * n ulong to ulong
d = new uchar 20 0
k = ulong 0
x = v
while true bound 21
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
for i ulong k
put o add n i get d sub sub k i 1
end
ret add n k
end
fn bat b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne get b add i k get t k
ret false
end
end
ret true
end
fn lcb c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end
fn bati b view uchar * i ulong t view uchar * to bool
if gt add i len t len b
ret false
end
for k ulong len t bound 9223372036854775807
if ne lcb get b add i k get t k
ret false
end
end
ret true
end
fn bfind b view uchar * t view uchar * to long
i = ulong 0
while le add i len t len b bound 9223372036854775807
if bat b i t
ret long i
end
i = add i 1
end
ret -1
end
fn bfindi b view uchar * t view uchar * to long
i = ulong 0
while le add i len t len b bound 9223372036854775807
if bati b i t
ret long i
end
i = add i 1
end
ret -1
end
note decat: the decimal number at b[i..] (stops at the first non-digit)
fn decat b view uchar * i ulong to ulong
v = ulong 0
j = i
while lt j len b bound 9223372036854775807
c = get b j
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
j = add j 1
end
ret v
end
fn appendf nm view uchar * b view uchar * to void
fd = fopen nm 0 len nm 525377 384
if lt fd 0
exit 3
end
x = wall int fd b
y = fclose int fd
end
fn exists nm view uchar * to bool
fd = fopen nm 0 len nm 524288 0
if lt fd 0
ret false
end
x = fclose int fd
ret true
end
note answer: status line, headers (extra holds whole header lines), body
fn hct fd int ct ulong to void
if eq ct 0
hput fd tplain
end
if eq ct 1
hput fd thtml
end
if eq ct 2
hput fd tjson
end
if eq ct 3
hput fd tbin
end
end
fn answer fd int code ulong ct ulong ex ulong body view uchar * to void
ahead fd code ct ex len body
x = wall fd body
end
fn ahead fd int code ulong ct ulong ex ulong blen ulong to void
d = new uchar 24 0
k = decw code d 0
hput fd th1
x = wall fd part d 0 k
hput fd th2
hct fd ct
hput fd th3
k = decw blen d 0
x = wall fd part d 0 k
hput fd th4
if eq ex 1
hput fd tsc1
end
if eq ex 2
hput fd tsc2
end
if eq ex 3
hput fd tlocop
end
if eq ex 4
hput fd tloclg
end
cr = new uchar 2 0
put cr 0 13
put cr 1 10
x = wall fd cr
end
fn answerf fd int ct ulong nm view uchar * to void
f = fopen nm 0 len nm 524288 0
if lt f 0
answer fd 404 0 0 part tlog 0 0
ret
end
st = new uchar 128 0
r = fstat int f st 0 128
sz = ulong 0
for i ulong 8
sz = or sz shl ulong get st add 48 i mul i 8
end
ahead fd 200 ct 0 sz
b = new uchar 65536 0
while true bound 9223372036854775807
n = read int f b 0 len b
if le n 0
break
end
y = wall fd part b 0 ulong n
end
x = fclose int f
end
note readreq: one request (headers and Content-Length body) into rq; returns its length or 0
fn readreq rq edit uchar * fd int to ulong
n = ulong 0
hend = long -1
while true bound 9223372036854775807
if ge n len rq
ret 0
end
r = read fd rq n sub len rq n
if le r 0
ret 0
end
n = add n ulong r
hend = hdrend rq n
if ge hend 0
break
end
end
want = add ulong hend bodylen rq ulong hend
if gt want len rq
ret 0
end
while lt n want bound 9223372036854775807
r = read fd rq n sub want n
if le r 0
ret 0
end
n = add n ulong r
end
ret n
end
fn hdrend rq edit uchar * n ulong to long
for i ulong n bound 9223372036854775807
if gt add i 4 n
ret -1
end
if and eq get rq i 13 eq get rq add i 1 10
if and eq get rq add i 2 13 eq get rq add i 3 10
ret long add i 4
end
end
end
ret -1
end
fn bodylen rq edit uchar * h ulong to ulong
p = bfindi part rq 0 h tclen
if lt p 0
ret 0
end
i = add ulong p len tclen
while eq get rq i 32 bound 9223372036854775807
i = add i 1
end
ret decat part rq 0 h i
end
fn logline rq edit uchar * n ulong to void
e = ulong 0
while lt e n bound 9223372036854775807
if eq get rq e 13
break
end
e = add e 1
end
b = new uchar 8192 0
if gt e 8000
e = ulong 8000
end
for i ulong e bound 8000
put b i get rq i
end
put b e 10
appendf tlog part b 0 add e 1
end
note has: the request (headers or body) holds t
fn has rq edit uchar * n ulong t view uchar * to bool
ret ge bfind part rq 0 n t 0
end
fn hasi rq edit uchar * n ulong t view uchar * to bool
ret ge bfindi part rq 0 n t 0
end
fn route rq edit uchar * fd int n ulong port ulong to void
if bat part rq 0 n 0 tgetlog
for i ulong 8
put gst i 0
end
answer fd 200 1 1 tlpage
ret
end
if bat part rq 0 n 0 tgetopn
if not bat part rq 0 n 0 tgetop
if not bat part rq 0 n 0 tgetup
public rq fd n
ret
end
end
end
if not origin rq n port
if bat part rq 0 n 0 tpostlg
answer fd 403 0 0 part tlog 0 0
ret
end
if bat part rq 0 n 0 tpostup
answer fd 403 0 0 part tlog 0 0
ret
end
if bat part rq 0 n 0 tpostop
answer fd 403 0 0 part tlog 0 0
ret
end
end
if bat part rq 0 n 0 tpostlg
if or not has rq n tpreck not has rq n tcsrf1
answer fd 403 0 0 part tlog 0 0
ret
end
savebody rq n tlogin
answer fd 303 0 2 part tlog 0 0
ret
end
if not has rq n tsessck
answer fd 403 0 0 part tlog 0 0
ret
end
if bat part rq 0 n 0 tgetop
answer fd 200 1 0 topage
ret
end
if bat part rq 0 n 0 tpostup
if not has rq n tcsrf2
answer fd 403 0 0 part tlog 0 0
ret
end
postup rq fd n
ret
end
if bat part rq 0 n 0 tpostop
if not has rq n tcsrf2
answer fd 403 0 0 part tlog 0 0
ret
end
if busyans fd tbusyp
ret
end
if exists tsignout
answer fd 303 0 4 part tlog 0 0
ret
end
savebody rq n twdform
g = fopen tgone 0 len tgone 524865 384
x = wall int g tone
y = fclose int g
answer fd 303 0 3 part tlog 0 0
ret
end
if bat part rq 0 n 0 tgetup
status fd
ret
end
if bat part rq 0 n 0 tgetset
status fd
ret
end
if bat part rq 0 n 0 tpostpt
if not has rq n tcsrf2
answer fd 403 0 0 part tlog 0 0
ret
end
postpt rq fd n
ret
end
answer fd 404 0 0 part tlog 0 0
end
note public: the shelf JSON and the archive need no session (as forged serves them)
fn public rq edit uchar * fd int n ulong to void
if has rq n tjs
if busyans fd tbusyj
ret
end
if gonejs fd
ret
end
answerf fd 2 tshelfj
ret
end
if has rq n ttar
if busyans fd tbusyt
ret
end
answerf fd 3 tshelft
ret
end
answer fd 404 0 0 part tlog 0 0
end
note gonejs: after a withdraw, "1" in DIR/gone serves the shelf once more and becomes "2"; "2" is 404
fn gonejs fd int to bool
f = fopen tgone 0 len tgone 524290 0
if lt f 0
ret false
end
b = new uchar 1 0
r = read int f b 0 1
if and eq r 1 eq get b 0 49
put b 0 50
w = pwrite int f b 0 1 0
x = fclose int f
ret false
end
x = fclose int f
answer fd 404 0 0 part tlog 0 0
ret true
end
note busyans: the first 3-digit code in DIR/nm, answered with an empty body; true when one was sent
fn busyans fd int nm view uchar * to bool
c = busycode nm
if eq c 0
ret false
end
answer fd c 0 0 part tlog 0 0
ret true
end
note busycode: the first 3-digit code in DIR/nm, dropped unless a "+" follows it; 0 when there is none
fn busycode nm view uchar * to ulong
f = fopen nm 0 len nm 524290 0
if lt f 0
ret 0
end
b = new uchar 4096 0
r = read int f b 0 len b
if lt r 3
x = fclose int f
ret 0
end
k = ulong r
c = decat part b 0 3 0
if not and gt k 3 eq get b 3 43
w = pwrite int f b 3 sub k 3 0
t = ftrunc int f long sub k 3
end
x = fclose int f
ret c
end
note postpt: the patch upload; DIR/busyq first (a 429 carries the write gate's reason line)
fn postpt rq edit uchar * fd int n ulong to void
c = busycode tbusyq
if eq c 429
answer fd 429 0 0 tptgate
ret
end
if ne c 0
answer fd c 0 0 part tlog 0 0
ret
end
savebody rq n tptform
answer fd 201 0 0 tptpath
end
fn origin rq edit uchar * n ulong port ulong to bool
o = new uchar 64 0
k = ulong 0
for i ulong len torig
put o i get torig i
end
k = decw port o len torig
cr = new uchar 1 0
put o k 13
ret hasi rq n part o 0 add k 1
end
fn savebody rq edit uchar * n ulong nm view uchar * to void
h = hdrend rq n
appendf nm part rq ulong h sub n ulong h
end
fn status fd int to void
put gst 3 add get gst 3 1
b = new uchar 4096 0
if exists trefuse
k = ulong 0
for i ulong len tj3a
put b i get tj3a i
end
k = len tj3a
f = fopen trefuse 0 len trefuse 524288 0
r = read int f b k 200
x = fclose int f
k = add k ulong r
while and gt k 0 eq get b sub k 1 10 bound 4096
k = sub k 1
end
for i ulong len tj3b
put b add k i get tj3b i
end
answer fd 200 2 0 part b 0 add k len tj3b
ret
end
if eq get gst 3 1
answer fd 200 2 0 tj1
ret
end
answer fd 200 2 0 tj2
end
note postup: gst 0 = the next seq, 1 = 429 injected, 2 = 409 injected
fn postup rq edit uchar * fd int n ulong to void
h = ulong hdrend rq n
if has rq n tafin
if busyans fd tbusyf
ret
end
postfin rq fd n
ret
end
if busyans fd tbusyp
ret
end
p = bfind part rq h sub n h tseq
if lt p 0
answer fd 400 0 0 part tlog 0 0
ret
end
postchk rq fd n ulong p
end
fn postfin rq edit uchar * fd int n ulong to void
h = ulong hdrend rq n
savebody rq n tfin
p = bfind part rq h sub n h tsha
b = new uchar 128 0
k = ulong 0
for i ulong len tqueued
put b i get tqueued i
end
k = len tqueued
for i ulong 64
put b add k i get rq add add add h ulong p len tsha i
end
put b add k 64 10
answer fd 200 0 0 part b 0 add k 65
end
fn postchk rq edit uchar * fd int n ulong p ulong to void
h = ulong hdrend rq n
seq = decat rq add add h p len tseq
inj = exists tinject
if and inj and eq seq 1 eq get gst 1 0
put gst 1 1
answer fd 429 0 0 part tlog 0 0
ret
end
if and inj and eq seq 2 eq get gst 2 0
put gst 2 1
put gst 0 1
nextans fd 409 1
ret
end
if ne seq get gst 0
nextans fd 409 get gst 0
ret
end
chunkdata rq h n seq
put gst 0 add seq 1
nextans fd 200 add seq 1
end
note chunkdata: up.b64 holds the data of seq 0..seq-1 as one line each; a resent seq rewrites from it
fn chunkdata rq edit uchar * h ulong n ulong seq ulong to void
p = bfind part rq h sub n h tdata
if lt p 0
exit 5
end
s = add add h ulong p len tdata
e = s
while lt e n bound 9223372036854775807
if eq get rq e 38
break
end
e = add e 1
end
truncl seq
appendf tupb part rq s sub e s
nl = new uchar 1 0
put nl 0 10
appendf tupb nl
end
note truncl: cut up.b64 after its first k lines (a 409 rewinds the client)
fn truncl k ulong to void
f = fopen tupb 0 len tupb 524290 384
if lt f 0
ret
end
b = new uchar 65536 0
seen = ulong 0
pos = ulong 0
while lt seen k bound 9223372036854775807
r = read int f b 0 len b
if le r 0
break
end
for i ulong ulong r bound 65536
if lt seen k
pos = add pos 1
if eq get b i 10
seen = add seen 1
end
end
end
end
x = ftrunc int f long pos
x = fclose int f
end
fn nextans fd int code ulong v ulong to void
b = new uchar 40 0
k = ulong 0
for i ulong len tnext
put b i get tnext i
end
k = decw v b len tnext
put b k 10
answer fd code 0 0 part b 0 add k 1
end
fn main to int
if ne argcnt 4
x = write 2 tusage 0 len tusage
ret 2
end
m = new uchar 16 0
mn = argread 1 m 0 16
pb = new uchar 16 0
pn = argread 2 pb 0 16
port = decat part pb 0 ulong pn 0
d = new uchar 4096 0
dn = argread 3 d 0 4096
if lt chdir d 0 ulong dn 0
ret 2
end
s = socknew 2 1 0
one = new uchar 4 0
put one 0 1
x = sockopt int s 1 2 one 0 4
sa = new uchar 16 0
put sa 0 2
put sa 2 uchar shr port 8
put sa 3 uchar and port 255
put sa 4 127
put sa 7 1
if lt bind int s sa 0 16 0
ret 3
end
if lt listen int s 64 0
ret 3
end
counting = and eq mn 5 bat m 0 tcount
while true bound 9223372036854775807
c = accept int s 0
if lt c 0
continue
end
appendf tconns tconn
if not counting
serve1 int c port
end
x = fclose int c
end
ret 0
end
note serve1: one request of at most 1 MiB (a chunk form is about 60 KB); larger ones are not read
fn serve1 c int port ulong to void
rq = new uchar 1048576 0
n = readreq rq c
if gt n 0
logline rq n
route rq c n port
end
end

om2
note agent.om: the research agent, its own seeded Omega program. It answers the questions forged
note queued (research/route.om) from the full text of the published works, with the model that
note runs on this machine. It runs outside the forged sandbox; forged has no network.
note   research-agent <ask dir, ending in /> <corpus file> <state file> [once]
note ask dir: <data>research/ask/ (queue, <id>.q written by forged; <id>.html and <id>.json written here)
note corpus:  built by research/publish.sh: "@@ <tab> slug <tab> title" starts a work, then one
note          paragraph per line. It is read again for every question, so a new publish is used at once.
note state:   one decimal number, the queue offset already handled (written beside and renamed)
note Per question: split the corpus into passages, score each passage by the question's words
note (rare words weigh more, words in the title add), take the 6 best (at most 3 from one work), ask the model at
note 127.0.0.1:18091 with those passages only, and write the answer with the works it came from.
note The model serves one generation at a time: 503 means busy and is retried every 3 s for up to
note 12 minutes. When no answer comes the question file is removed, so the page ends and the
note question can be asked again. With "once" the program handles what is queued and exits.
note The queue is written by a less trusted process: a line must be 32 hex characters, a tab and
note 1 to 300 bytes; anything else is skipped. Every answer byte is escaped before it is written.
global ad uchar 512
global adl ulong 1
global cpa uchar 512
global cpl ulong 1
global sta uchar 512
global stl ulong 1
global pth uchar 1100
global pthl ulong 1
global pt2 uchar 1100
global gc uchar 4194304
global gcl ulong 1
global cs ulong 8192
global ce ulong 8192
global cw ulong 8192
global cn ulong 1
global wss ulong 256
global wse ulong 256
global wts ulong 256
global wte ulong 256
global wn ulong 1
global qb uchar 65536
global q uchar 304
global ql ulong 1
global qlow uchar 304
global tms ulong 16
global tml ulong 16
global tn ulong 1
global tf uchar 131072
global df ulong 16
global sc ulong 8192
global pick ulong 8
global wpk ulong 256
global pn ulong 1
global bd uchar 262144
global bdl ulong 1
global rs uchar 1048576
global rsl ulong 1
global an uchar 65536
global anl ulong 1
global ob uchar 524288
global obl ulong 1
global jid uchar 32
global sad uchar 16
global rpk uchar 2300
global hb uchar 256
global hbl ulong 1
text kq "queue"
text kxq ".q"
text kxh ".html"
text kxj ".json"
text kxt ".tmp"
text kat "@@\t"
text kstop " the and for what how does are with from that this why who when was its his into about which can you your did has have not any use used work works paper papers research say says tell there their they them then than been were will would could should "
text khex "0123456789ABCDEF"
text kamp "&amp;"
text klt "&lt;"
text kgt "&gt;"
text kquo "&quot;"
text kapo "&#39;"
text ku00 "\\u00"
text kb1 "{\"model\":\"qwen3.6-35b-a3b-fp8\",\"temperature\":0,\"max_tokens\":500,\"stream\":false,\"messages\":[{\"role\":\"system\",\"content\":\"You are the research agent for the published work of Drake Stapleton on INTERPLANE. Answer the question using only the numbered excerpts. After each sentence, cite the excerpts that support it as [1] or [2]. If the excerpts do not answer the question, say that the published work does not cover it. Do not add facts from outside the excerpts. Keep the limits the excerpts state. At most 180 words. Plain text, no markdown.\"},{\"role\":\"user\",\"content\":\"Excerpts from the published work:\\n\\n"
text kb2 "Question: "
text kb3 "\"}]}"
text kex1 "["
text kex2 "] "
text knl "\\n"
text knl2 "\\n\\n"
text kh1 "POST /v1/chat/completions HTTP/1.0"
text kh1b "Host: 127.0.0.1"
text kh1c "Content-Type: application/json"
text kh1d "Content-Length: "
text kcont "\"content\":\""
text knone "No passage in the published work matches the words of this question. Try the names the works use, for example Turing, Omega, crumb, hive, CUDA or GB10."
text kp1 "<!doctype html><html lang='en' data-theme='dark'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Answer from the research</title><link rel='stylesheet' href='/assets/tokens.css'><link rel='stylesheet' href='/assets/research.css'><link rel='alternate' type='application/json' href='/research/ask/"
text kp2 ".json'></head><body>\n<header class='top'><a class='wm' href='/'>INTERPLANE</a><nav><a href='/galaxy'>Galaxy</a><a href='/explore'>Explore</a><a class='on' href='/research'>Research</a></nav></header>\n<main><section class='card'><p class='eyebrow'>Question</p><h2>"
text kp3 "</h2><p class='answer'>"
text kp4 "</p><p class='meta'>Written by the model qwen3.6-35b on my Spark, from the excerpts listed below and nothing else. A model can be wrong: check the work before you rely on a sentence.</p></section>\n"
text kp5 "<section class='card'><h2>Excerpts it was given</h2><ol class='vers'>\n"
text kp6 "<li><span class='vn'>["
text kp7 "]</span><a href='/research/"
text kp8 "'>"
text kp9 "</a></li>\n"
text kp10 "</ol></section>\n"
text kp11 "<section class='card'><h2>Ask another question</h2><form class='ask' action='/research/ask' method='get'><input class='q' type='text' name='q' maxlength='300' required aria-label='Your question'><button class='btn' type='submit'>Ask</button></form><p class='try'><a href='/research'>Back to the research</a></p></section></main></body></html>\n"
text kj1 "{\"schema\":\"interplane/research-answer/1\",\"status\":\"answered\",\"id\":\""
text kj2 "\",\"question\":\""
text kj3 "\",\"answer\":\""
text kj4 "\",\"model\":\"qwen3.6-35b-a3b-fp8\",\"sources\":["
text kj5 "{\"n\":"
text kj6 ",\"slug\":\""
text kj7 "\",\"title\":\""
text kj8 "\",\"url\":\"https://interplane.io/research/"
text kj9 "\"}"
text kj10 "]}\n"
note ---- small helpers
fn lowc c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 122
ret true
end
ret false
end
note mkp: pth = ask dir + the 32 id characters + ext
fn mkp ext view uchar * to void
n = get adl 0
for i ulong n bound 512
put pth i get ad i
end
for i ulong 32
put pth add n i get jid i
end
n = add n 32
for i ulong len ext bound 16
put pth add n i get ext i
end
put pthl 0 add n len ext
end
fn pexists to bool
ret eq faccess pth 0 get pthl 0 0 0
end
note ---- output buffers
fn emb c uchar to void
o = get obl 0
if lt o 524288
put ob o c
put obl 0 add o 1
end
end
fn em t view uchar * to void
n = len t
i = ulong 0
while lt i n bound 65536
emb get t i
i = add i 1
end
end
fn emn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
emb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
emb get d n
end
end
note emhc / emjc: one byte, HTML-escaped or as part of a JSON string
fn emhc c uchar to void
if eq c 38
em kamp
ret
end
if eq c 60
em klt
ret
end
if eq c 62
em kgt
ret
end
if eq c 34
em kquo
ret
end
if eq c 39
em kapo
ret
end
if or ge c 32 eq c 10
emb c
end
end
fn emjc c uchar to void
if or eq c 34 eq c 92
emb 92
emb c
ret
end
if lt c 32
em ku00
emb get khex ulong shr c 4
emb get khex ulong and c 15
ret
end
emb c
end
note the request body buffer, same escaping as a JSON string
fn bdb c uchar to void
o = get bdl 0
if lt o 262144
put bd o c
put bdl 0 add o 1
end
end
fn bdt t view uchar * to void
n = len t
i = ulong 0
while lt i n bound 65536
bdb get t i
i = add i 1
end
end
fn bdj c uchar to void
if or eq c 34 eq c 92
bdb 92
bdb c
ret
end
if lt c 32
bdt ku00
bdb get khex ulong shr c 4
bdb get khex ulong and c 15
ret
end
bdb c
end
fn bdn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
bdb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
bdb get d n
end
end
note ---- the corpus
fn eol a ulong to ulong
lim = get gcl 0
i = a
while lt i lim bound 4194304
if eq get gc i 10
ret i
end
i = add i 1
end
ret lim
end
note addc: passage a..b of work w; a passage over 2400 bytes is cut near every 1600th byte at a space
fn addc a ulong b ulong w ulong to void
s = a
while gt sub b s 2400 bound 4096
p = add s 1600
k = ulong 0
while lt k 200 bound 200
if eq get gc p 32
k = ulong 200
else
p = sub p 1
k = add k 1
end
end
n = get cn 0
if lt n 8192
put cs n s
put ce n p
put cw n w
put cn 0 add n 1
end
s = add p 1
end
n = get cn 0
if and lt n 8192 gt b s
put cs n s
put ce n b
put cw n w
put cn 0 add n 1
end
end
note newwork: the line s..e is "@@ <tab> slug <tab> title"
fn newwork s ulong e ulong to void
n = get wn 0
if ge n 256
ret
end
a = add s 3
b = a
while lt b e bound 4194304
if eq get gc b 9
break
end
b = add b 1
end
put wss n a
put wse n b
t = b
if lt t e
t = add t 1
end
put wts n t
put wte n e
put wn 0 add n 1
end
fn isat s ulong e ulong to bool
if lt sub e s 3
ret false
end
if ne get gc s 64
ret false
end
if ne get gc add s 1 64
ret false
end
ret eq get gc add s 2 9
end
note load: read the corpus and split it into passages of at least 900 bytes of whole paragraphs
fn cload to bool
fd = fopen cpa 0 get cpl 0 524288 0
if lt fd 0
ret false
end
n = ulong 0
k = long 1
while gt k 0 bound 4194304
k = read int fd gc n sub 4194303 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put gcl 0 n
put cn 0 0
put wn 0 0
i = ulong 0
opn = false
a = ulong 0
b = ulong 0
while lt i n bound 4194304
e = eol i
if isat i e
if opn
addc a b sub get wn 0 1
opn = false
end
newwork i e
else
if and gt e i gt get wn 0 0
if not opn
a = i
opn = true
end
b = e
if ge sub b a 900
addc a b sub get wn 0 1
opn = false
end
end
end
i = add e 1
end
if opn
addc a b sub get wn 0 1
end
ret gt get cn 0 0
end
note ---- the question's words
fn isstop a ulong n ulong to bool
note a question word may be up to 300 bytes; no stop word is longer than 8, and the loop below is bounded by 64
if gt n 16
ret false
end
m = len kstop
i = ulong 0
while lt add add i n 1 m bound 1024
if eq get kstop i 32
same = true
for k ulong n bound 64
if ne get kstop add add i 1 k get qlow add a k
same = false
end
end
if same
if eq get kstop add add i 1 n 32
ret true
end
end
end
i = add i 1
end
ret false
end
fn tseen a ulong n ulong to bool
for j ulong get tn 0 bound 16
if eq get tml j n
same = true
u = get tms j
for k ulong n bound 304
if ne get qlow add u k get qlow add a k
same = false
end
end
if same
ret true
end
end
end
ret false
end
fn tterms to void
n = get ql 0
for i ulong n bound 304
put qlow i lowc get q i
end
put tn 0 0
i = ulong 0
while lt i n bound 304
if alnum get qlow i
a = i
while lt i n bound 304
if not alnum get qlow i
break
end
i = add i 1
end
m = sub i a
if and ge m 3 lt get tn 0 12
if not isstop a m
if not tseen a m
put tms get tn 0 a
put tml get tn 0 m
put tn 0 add get tn 0 1
end
end
end
else
i = add i 1
end
end
end
note occ: how often word j occurs in gc[a, b), case-insensitive, at most 3
fn occ j ulong a ulong b ulong to ulong
m = get tml j
t = get tms j
c = ulong 0
if lt sub b a m
ret 0
end
lst = sub b m
i = a
while le i lst bound 4194304
if eq lowc get gc i get qlow t
same = true
k = ulong 1
while lt k m bound 304
if ne lowc get gc add i k get qlow add t k
same = false
k = m
end
k = add k 1
end
if same
c = add c 1
if ge c 3
ret 3
end
i = add i m
else
i = add i 1
end
else
i = add i 1
end
end
ret c
end
note score: tf for every word and passage, then each passage's score
fn tfill to void
n = get cn 0
for j ulong get tn 0 bound 16
put df j 0
for c ulong n bound 8192
v = occ j get cs c get ce c
put tf add mul j 8192 c uchar v
if gt v 0
put df j add get df j 1
end
end
end
end
fn tocc j ulong w ulong to ulong
ret occ j get wts w get wte w
end
fn tfv j ulong c ulong to ulong
ret ulong get tf add mul j 8192 c
end
note wgt: the weight of a word found in d passages: rare words weigh more
fn wgt d ulong to ulong
n = get cn 0
ret add div mul 100 n add mul 20 d n 1
end
note cscore: the score of passage c
fn cscore c ulong to ulong
s = ulong 0
for j ulong get tn 0 bound 16
d = get df j
if gt d 0
t = tfv j c
if gt t 0
s = add s mul t wgt d
if gt tocc j get cw c 0
s = add s wgt d
end
end
end
end
ret s
end
fn tscore to void
tfill
for c ulong get cn 0 bound 8192
put sc c cscore c
end
end
note tpick: the 6 best passages with a score, best first, at most 3 from one work
fn tpick to void
n = get cn 0
put pn 0 0
for i ulong 256
put wpk i 0
end
for r ulong 40
if ge get pn 0 6
break
end
bst = ulong 0
bi = n
for c ulong n bound 8192
if gt get sc c bst
bst = get sc c
bi = c
end
end
if ge bi n
break
end
put sc bi 0
w = get cw bi
if lt get wpk w 3
put wpk w add get wpk w 1
put pick get pn 0 bi
put pn 0 add get pn 0 1
end
end
end
note ---- the model
note bdr: gc[a, b) into the request body as JSON string bytes; a line end becomes a space
fn bdr a ulong b ulong to void
i = a
while lt i b bound 4096
v = get gc i
if eq v 10
v = uchar 32
end
bdj v
i = add i 1
end
end
fn mbody to void
put bdl 0 0
bdt kb1
for r ulong get pn 0 bound 8
c = get pick r
w = get cw c
bdt kex1
bdn add r 1
bdt kex2
bdr get wts w get wte w
bdt knl
bdr get cs c get ce c
bdt knl2
end
bdt kb2
for i ulong get ql 0 bound 304
bdj get q i
end
bdt kb3
end
note sendall: every byte of A[0, n) to the socket
fn sendbd s int to bool
n = get bdl 0
o = ulong 0
while lt o n bound 262144
k = send s bd o sub n o 0
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
fn hbc c uchar to void
o = get hbl 0
if lt o 256
put hb o c
put hbl 0 add o 1
end
end
fn hbt t view uchar * to void
for i ulong len t bound 128
hbc get t i
end
hbc 13
hbc 10
end
note sendhd: the request line and headers; every line ends in CR LF
fn sendhd s int to bool
d = new uchar 20 0
put hbl 0 0
hbt kh1
hbt kh1b
hbt kh1c
for i ulong len kh1d bound 32
hbc get kh1d i
end
x = get bdl 0
m = ulong 0
if eq x 0
put d 0 48
m = ulong 1
end
while gt x 0 bound 20
put d m uchar add 48 rem x 10
x = div x 10
m = add m 1
end
while gt m 0 bound 20
m = sub m 1
hbc get d m
end
hbc 13
hbc 10
hbc 13
hbc 10
n = get hbl 0
k = send s hb 0 n 0
ret eq k long n
end
note call: one request. The HTTP status, or 0 when the connection failed.
fn mcall to ulong
put sad 0 2
put sad 2 70
put sad 3 171
put sad 4 127
put sad 7 1
s = int socknew 2 1 0
if lt s 0
ret 0
end
if ne connect s sad 0 16 0
x = fclose s
ret 0
end
if not sendhd s
x = fclose s
ret 0
end
if not sendbd s
x = fclose s
ret 0
end
n = ulong 0
k = long 1
while gt k 0 bound 1048576
k = read s rs n sub 1048575 n
if gt k 0
n = add n ulong k
end
end
x = fclose s
put rsl 0 n
if lt n 12
ret 0
end
v = ulong 0
for i ulong 3
d = get rs add 9 i
if or lt d 48 gt d 57
ret 0
end
v = add mul v 10 ulong sub d 48
end
ret v
end
fn hexv c uchar to ulong
if and ge c 48 le c 57
ret ulong sub c 48
end
if and ge c 97 le c 102
ret ulong sub c 87
end
if and ge c 65 le c 70
ret ulong sub c 55
end
ret 0
end
fn anb c uchar to void
o = get anl 0
if lt o 65536
put an o c
put anl 0 add o 1
end
end
note anu: code point v as UTF-8 (a surrogate half becomes ?)
fn anu v ulong to void
if lt v 128
anb uchar v
ret
end
if lt v 2048
anb uchar add 192 shr v 6
anb uchar add 128 and v 63
ret
end
if and ge v 55296 le v 57343
anb 63
ret
end
anb uchar add 224 shr v 12
anb uchar add 128 and shr v 6 63
anb uchar add 128 and v 63
end
note extract: the first "content" string of the response into an. False when there is none.
fn mextract to bool
n = get rsl 0
m = len kcont
put anl 0 0
p = n
i = ulong 0
while lt add i m n bound 1048576
if eq get rs i 34
same = true
for k ulong m bound 16
if ne get rs add i k get kcont k
same = false
end
end
if same
p = add i m
break
end
end
i = add i 1
end
if ge p n
ret false
end
i = p
while lt i n bound 1048576
c = get rs i
if eq c 34
ret gt get anl 0 0
end
if eq c 92
i = add i 1
if ge i n
ret false
end
e = get rs i
if eq e 110
anb 10
else
if eq e 116
anb 32
else
if eq e 117
if ge add i 4 n
ret false
end
v = shl hexv get rs add i 1 12
v = add v shl hexv get rs add i 2 8
v = add v shl hexv get rs add i 3 4
v = add v hexv get rs add i 4
anu v
i = add i 4
else
if or eq e 114 or eq e 98 eq e 102
anb 32
else
anb e
end
end
end
end
else
anb c
end
i = add i 1
end
ret false
end
note ---- the answer documents
note emr: gc[a, b) into the document, escaped for JSON or for HTML
fn emr a ulong b ulong json bool to void
i = a
while lt i b bound 4096
if json
emjc get gc i
else
emhc get gc i
end
i = add i 1
end
end
fn srcs json bool to void
for r ulong get pn 0 bound 8
w = get cw get pick r
if json
if gt r 0
emb 44
end
em kj5
emn add r 1
em kj6
emr get wss w get wse w true
em kj7
emr get wts w get wte w true
em kj8
emr get wss w get wse w true
em kj9
else
em kp6
emn add r 1
em kp7
emr get wss w get wse w false
em kp8
emr get wts w get wte w false
em kp9
end
end
end
fn apage to void
put obl 0 0
em kp1
for i ulong 32
emb get jid i
end
em kp2
for i ulong get ql 0 bound 304
emhc get q i
end
em kp3
for i ulong get anl 0 bound 65536
emhc get an i
end
em kp4
if gt get pn 0 0
em kp5
srcs false
em kp10
end
em kp11
end
fn jdoc to void
put obl 0 0
em kj1
for i ulong 32
emb get jid i
end
em kj2
for i ulong get ql 0 bound 304
emjc get q i
end
em kj3
for i ulong get anl 0 bound 65536
emjc get an i
end
em kj4
srcs true
em kj10
end
note wr: write ob to pth + ".tmp", sync, rename onto pth
fn wr to bool
n = get pthl 0
for i ulong n bound 1100
put pt2 i get pth i
end
for i ulong len kxt
put pt2 add n i get kxt i
end
m = add n len kxt
r = unlink pt2 0 m
fd = fopen pt2 0 m 557249 420
if lt fd 0
ret false
end
z = get obl 0
o = ulong 0
ok = true
while lt o z bound 524288
k = write int fd ob o sub z o
if le k 0
ok = false
o = z
else
o = add o ulong k
end
end
r = fsync int fd
x = fclose int fd
if not ok
ret false
end
put rpk 0 2
put rpk 1 0
put rpk 2 uchar and m 255
put rpk 3 uchar shr m 8
for i ulong m bound 1100
put rpk add 4 i get pt2 i
end
o = add 4 m
put rpk o uchar and n 255
put rpk add o 1 uchar shr n 8
for i ulong n bound 1100
put rpk add add o 2 i get pth i
end
ret eq renames rpk 0 add add o 2 n 0 0
end
note ---- one question
fn giveup to void
mkp kxq
r = unlink pth 0 get pthl 0
end
fn mtry to bool
hard = ulong 0
for t ulong 240
c = mcall
if eq c 200
ret mextract
end
if eq c 503
z = sleepns 3000000000
else
hard = add hard 1
if ge hard 5
ret false
end
z = sleepns 5000000000
end
end
ret false
end
fn qhandle to void
mkp kxh
if pexists
ret
end
if not cload
giveup
ret
end
tterms
tscore
tpick
if eq get pn 0 0
put anl 0 0
for i ulong len knone bound 400
anb get knone i
end
else
mbody
if not mtry
giveup
ret
end
end
jdoc
mkp kxj
if not wr
giveup
ret
end
apage
mkp kxh
if not wr
giveup
end
end
note ---- the queue
fn getoff to ulong
b = new uchar 24 0
fd = fopen sta 0 get stl 0 524288 0
if lt fd 0
ret 0
end
k = read int fd b 0 20
x = fclose int fd
v = ulong 0

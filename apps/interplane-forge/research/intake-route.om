note Research intake adapter, composed only beside the open shelf. Its repository POST calls
note ohpost unchanged: the shelf's sign-in, CSRF, permission, write limits, queue and refusal paths.
note Research records only a request to index that repository after the shelf has accepted it.
note Zenodo requests use the same write precheck, per-key rate counter and disk-space measure.
text rqpath "/research/add/"
text rqdir "research/add/"
text rqqueue "queue"
text rqlk "queue.lock"
text rqtitle "Add your work"
text rqorc "orcid"
text rqdoi "doi"
text rqsync "sync"
text rqzpre "10.5281/zenodo."
text rqmsg "Give a repository ID, an ORCID iD or a Zenodo DOI. Links and files are not accepted here."
text rqwait "The request is queued. Public metadata will be listed with the key that asked. A repository appears only after the open shelf accepts it. Not verified."
text rqh "<section class=\"sl\"><h1>Add your work</h1><p>Bring a paper repository, sync public Zenodo records, or <a href=\"/research/doi\">get a DOI for your work</a>. <a href=\"/research/add\">Read the steps</a>.</p><p>A listing is not proof that a key belongs to an author. Public metadata and repository text are not verified. The operator can take a listing down by key or repository.</p>"
text rql "<p><a href=\"/login\">Sign in with your Radicle key</a> to add work.</p></section>"
text rqf1 "<h2>Bring a repository</h2><p>Publish from your machine with Radicle. Include .zenodo.json, a LICENSE file and paper.pdf, paper.md or paper.txt. This uses the open shelf intake, not an upload.</p><form method=\"post\" action=\"/research/add/\"><input type=\"hidden\" name=\"csrf\" value=\""
text rqf2 "\"><input type=\"hidden\" name=\"action\" value=\"bring\"><label>Radicle ID <input name=\"rid\" maxlength=\"48\" required placeholder=\"rad:z...\"></label><input type=\"hidden\" name=\"note\" value=\"Paper for research\"><label><input type=\"checkbox\" name=\"consent\" value=\"yes\" required>I have the right to share this project and it carries an open license.</label><button type=\"submit\">Bring it</button></form>"
text rqf3 "<h2>Sync public records</h2><p>Give an ORCID iD, a Zenodo DOI, or both. A record is filed under an author only if that record carries the ORCID iD among its creators. This is a listing from public metadata by the key that asked, not an ORCID sign-in.</p><form method=\"post\" action=\"/research/add/\"><input type=\"hidden\" name=\"csrf\" value=\""
text rqf4 "\"><input type=\"hidden\" name=\"action\" value=\"sync\"><label>ORCID iD <input name=\"orcid\" maxlength=\"19\" placeholder=\"0000-0000-0000-0000\"></label><label>Zenodo DOI <input name=\"doi\" maxlength=\"26\" placeholder=\"10.5281/zenodo.123456\"></label><button type=\"submit\">Sync records</button></form></section>"
global rqo uchar 20
global rqol ulong 1
global rqd uchar 40
global rqdl ulong 1
fn rqform to long
if not fget
ret 405
end
put fkind 0 0
fsetti rqtitle
fput rqh
if not ohdid
fput rql
ret 200
end
fput rqf1
socsrfout
fput rqf2
fput rqf3
socsrfout
fput rqf4
ret 200
end
note rqappend: P or Z, did, rid or ORCID, ORCID(empty) or DOI. Failed append is rolled back.
note Mutable intake state must not use rxfile, which pins immutable public generations.
fn rqfile name view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len rqdir bound 64
ffilc get rqdir i
end
for i ulong len name bound 16
ffilc get name i
end
end
fn rqlock to long
rqfile rqlk
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
ret -1
end
r = flock int fd 6
if ne r 0
x = fclose int fd
ret -1
end
ret fd
end
fn rqappend kind uchar to long
rm = ohroom 400
if or eq rm 1 eq rm 3
ret soerr 503 tomroom
end
rqfile rqqueue
put ffilel 0 sub get ffilel 0 len rqqueue
r = makedir ffile 0 get ffilel 0 448
lf = rqlock
if lt lf 0
ret soerr 503 tomsgq
end
rqfile rqqueue
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
x = fclose int lf
ret soerr 503 tomsgq
end
sz = ohsize int fd
if or lt sz 0 gt sz 4193904
x = fclose int fd
x = fclose int lf
ret soerr 503 tomsgq
end
b = new uchar 400 0
n = ulong 0
put b n kind
n = add n 1
put b n 9
n = add n 1
for i ulong get godidl 0 bound 96
put b n get godid i
n = add n 1
end
put b n 9
n = add n 1
if eq kind 80
for i ulong get goridl 0 bound 44
put b n get gorid i
n = add n 1
end
else
for i ulong get rqol 0 bound 19
put b n get rqo i
n = add n 1
end
end
put b n 9
n = add n 1
if eq kind 90
for i ulong get rqdl 0 bound 40
put b n get rqd i
n = add n 1
end
end
put b n 10
n = add n 1
w = write int fd b 0 n
if ne w long n
if ge sz 0
x = ftrunc int fd sz
end
x = fclose int fd
x = fclose int lf
ret soerr 503 tomsgq
end
x = fclose int fd
x = fclose int lf
ohused n
put fkind 0 0
fsetti rqtitle
fput rqh
fput rqwait
fput toend
ret 200
end
note Preflight before a shelf mutation. A later IO fault is reported as partial acceptance, not
note "nothing saved": the shelf retains the RID/key/note and the reply carries the retryable ID.
fn rqpre to long
rm = ohroom 400
if or eq rm 1 eq rm 3
ret soerr 503 tomroom
end
rqfile rqqueue
put ffilel 0 sub get ffilel 0 len rqqueue
r = makedir ffile 0 get ffilel 0 448
lf = rqlock
if lt lf 0
ret soerr 503 tomsgq
end
rqfile rqqueue
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
x = fclose int lf
ret soerr 503 tomsgq
end
sz = ohsize int fd
x = fclose int fd
x = fclose int lf
if or lt sz 0 gt sz 4193904
ret soerr 503 tomsgq
end
ret 0
end
text rqpart "<section class=\"sl\"><h1>Shelf request accepted</h1><p>The shelf accepted this repository. Research indexing was not queued because storage changed after admission. The shelf retains the repository ID, the requesting key and the paper note. Retry the ID below at <a href=\"/research/add/\">Add your work</a>.</p><pre>rad:"
text rqp2 "</pre><p>This is a partial acceptance, not a claim that nothing was saved. The shelf listing is not verified.</p></section>"
fn rqpartial to long
put fobl 0 0
put fkind 0 0
fsetti rqtitle
fput rqpart
for i ulong get goridl 0 bound 44
fescc get gorid i
end
fput rqp2
ret 202
end
fn rqpost to long
if slffeq toact tobring
if ne get gscur 0 0
if not socsrfok
ret soerr 403 tsmcsrf
end
p = rqpre
if ne p 0
ret p
end
end
r = ohpost
if ne r 303
ret r
end
note A signed-out ohpost redirects to login, not to the shelf. Do not queue that as a request.
if eq get gscur 0 0
ret r
end
p = rqappend 80
if ne p 200
ret rqpartial
end
ret p
end
r = sowpre
if ne r 0
ret r
end
soratev get gscur 0 get gsnow 0
if not slformvalid
ret soerr 400 rqmsg
end
if ne slgetform tsfcsrf 32
ret soerr 400 rqmsg
end
if not ohdid
ret 403
end
if not slffeq toact rqsync
ret soerr 400 rqmsg
end
n = slgetform rqorc
if or lt n 0 gt n 19
ret soerr 400 rqmsg
end
put rqol 0 ulong n
if gt n 0
if ne n 19
ret soerr 400 rqmsg
end
for i ulong 19
c = get gcfv i
if or eq i 4 or eq i 9 eq i 14
if ne c 45
ret soerr 400 rqmsg
end
else
ok = and ge c 48 le c 57
if and eq i 18 eq c 88
ok = true
end
if not ok
ret soerr 400 rqmsg
end
end
put rqo i c
end
end
n = slgetform rqdoi
if or lt n 0 gt n 26
ret soerr 400 rqmsg
end
put rqdl 0 ulong n
if gt n 0
if le n long len rqzpre
ret soerr 400 rqmsg
end
for i ulong len rqzpre
if ne get gcfv i get rqzpre i
ret soerr 400 rqmsg
end
end
for i ulong sub ulong n len rqzpre bound 12
c = get gcfv add len rqzpre i
if or lt c 48 gt c 57
ret soerr 400 rqmsg
end
end
for i ulong ulong n bound 40
put rqd i get gcfv i
end
end
if eq add get rqol 0 get rqdl 0 0
ret soerr 400 rqmsg
end
ret rqappend 90
end
fn rxint to long
if not fpeq rqpath
ret 0
end
if eq get fmeth 0 3
ret rqpost
end
ret rqform
end

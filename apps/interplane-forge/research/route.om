note research/route.om: the research pages inside forged. Prefix rx* (functions), gx* (globals), tx* (texts).
note forged builds nothing here. research-build (research/build.om, its own program, run by
note research/publish.sh) writes the pages into <data>research/; forged streams those files:
note   /research, /research/           research/index.html
note   /research.json .bib .txt        research/index.json, works.bib, agents.txt
note   /assets/research.css            research/research.css
note   /research/<slug>[.json|.bib]    research/w/<slug>.html, .json, .bib
note Questions: GET /research/ask?q=... writes the question to research/ask/<id>.q, appends one
note line "<id> <tab> <question>" to research/ask/queue and answers 303 to /research/ask/<id>.
note forged has no network and never calls a model. The research agent (research/agent.om, its own
note service outside the sandbox) reads the queue and writes research/ask/<id>.html and .json.
note /research/ask/<id>[.json] streams the answer when it exists, else a page that reloads itself.
note <id> is the first 32 hex characters of SHA-256 over the lowercased, space-collapsed question, so
note the same question is asked once. Served on the interplane.io base "/" only, as the galaxy is.
text txp "/research"
text txps "/research/"
text txpj "/research.json"
text txpb "/research.bib"
text txpt "/research.txt"
text txpc "/assets/research.css"
text txpa "/research/ask"
text txpas "/research/ask/"
text txdir "research/"
text txask "research/ask/"
text txw "research/w/"
text txfi "index.html"
text txfj "index.json"
text txfb "works.bib"
text txft "agents.txt"
text txfc "research.css"
text txfq "queue"
text txeh ".html"
text txej ".json"
text txeb ".bib"
text txeq ".q"
text txno ""
text txcth "text/html; charset=utf-8"
text txctj "application/json; charset=utf-8"
text txctt "text/plain; charset=utf-8"
text txctc "text/css; charset=utf-8"
text txcc "public, max-age=60"
text txq "q"
text txhex "0123456789abcdef"
text txloc "research/ask/"
text txhome "research"
text txw1 "<!doctype html><html lang='en' data-theme='dark'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta http-equiv='refresh' content='4'><title>Reading the papers</title><link rel='stylesheet' href='/assets/tokens.css'><link rel='stylesheet' href='/assets/research.css'></head><body>\n<header class='top'><a class='wm' href='/'>INTERPLANE</a><nav><a href='/galaxy'>Galaxy</a><a href='/explore'>Explore</a><a class='on' href='/research'>Research</a></nav></header>\n<main><section class='card'><p class='eyebrow'>Question</p><h2>"
text txw2 "</h2><p class='wait'>The agent on the Spark is reading the papers. Its model answers one question at a time, so this can take a minute. This page reloads by itself. You can also keep the link and come back.</p><p class='try'><a href='/research'>Back to the research</a></p></section></main></body></html>\n"
text txj1 "{\"schema\":\"interplane/research-answer/1\",\"status\":\"pending\",\"id\":\""
text txj2 "\"}\n"
global gxq uchar 304
global gxql ulong 1
global gxid uchar 32
note rxfile: ffile = <data><dir><fpath[a, a+n)><ext>
fn rxfile dir view uchar * a ulong n ulong ext view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len dir bound 64
ffilc get dir i
end
for i ulong n bound 64
ffilc fpathat add a i
end
for i ulong len ext bound 16
ffilc get ext i
end
end
note rxidfile: ffile = <data>research/ask/<gxid><ext>
fn rxidfile ext view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len txask bound 64
ffilc get txask i
end
for i ulong 32
ffilc get gxid i
end
for i ulong len ext bound 16
ffilc get ext i
end
end
fn rxhas to bool
ret eq faccess ffile 0 get ffilel 0 4 0
end
note rxsend: stream ffile (kind 3). GET only; a file that is not there is 404.
fn rxsend ct view uchar * to long
if not fget
ret 405
end
if not rxhas
ret 404
end
put fobl 0 0
put fkind 0 3
fsetct ct
fsetcc txcc
ret 200
end
note rxends: fpath ends with t
fn rxends t view uchar * to bool
n = get fpathl 0
if lt n len t
ret false
end
b = sub n len t
for i ulong len t bound 16
if ne fpathat add b i get t i
ret false
end
end
ret true
end
note rxslug: fpath[a, a+n) is 1 to 64 bytes of a-z, 0-9 and -
fn rxslug a ulong n ulong to bool
if or eq n 0 gt n 64
ret false
end
for i ulong n bound 64
c = fpathat add a i
ok = false
if and ge c 97 le c 122
ok = true
end
if and ge c 48 le c 57
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
end
ret true
end
note rxhexs: fpath[a, a+32) is 32 lowercase hex characters; they are copied into gxid
fn rxhexs a ulong n ulong to bool
if ne n 32
ret false
end
for i ulong 32
c = fpathat add a i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 102
ok = true
end
if not ok
ret false
end
put gxid i c
end
ret true
end
note rxwork: /research/<slug>[.json|.bib]
fn rxwork to long
a = len txps
n = sub get fpathl 0 a
if rxends txej
n = sub n len txej
if not rxslug a n
ret 404
end
rxfile txw a n txej
ret rxsend txctj
end
if rxends txeb
n = sub n len txeb
if not rxslug a n
ret 404
end
rxfile txw a n txeb
ret rxsend txctt
end
if not rxslug a n
ret 404
end
rxfile txw a n txeh
ret rxsend txcth
end
note rxnorm: the decoded question fval[0, n) into gxq: control bytes become a space, runs of spaces
note become one, no space at either end. False when nothing is left or it is over 300 bytes.
fn rxnorm n ulong to bool
o = ulong 0
sp = true
for i ulong n bound 4096
c = get fval i
if or lt c 32 eq c 127
c = uchar 32
end
if eq c 32
if not sp
if ge o 300
ret false
end
put gxq o c
o = add o 1
end
sp = true
else
if ge o 300
ret false
end
put gxq o c
o = add o 1
sp = false
end
end
if gt o 0
if eq get gxq sub o 1 32
o = sub o 1
end
end
put gxql 0 o
ret gt o 0
end
note rxmkid: gxid from gxq (ASCII letters lowercased before hashing)
fn rxmkid to void
b = new uchar 304 0
d = new uchar 32 0
n = get gxql 0
for i ulong n bound 304
c = get gxq i
if and ge c 65 le c 90
c = uchar add c 32
end
put b i c
end
r = sha2_digest 256 view part b 0 n d
for i ulong 16
v = get d i
put gxid mul i 2 get txhex ulong shr v 4
put gxid add mul i 2 1 get txhex ulong and v 15
end
end
note rxgo: 303 to <base>research/ask/<gxid>
fn rxgo to long
flocb
floct txloc
for i ulong 32
flocc get gxid i
end
put fkind 0 2
ret 303
end
note rxqueue: write the question file and append the queue line. 0 done, else the status to answer.
fn rxqueue to long
b = new uchar 352 0
st = new uchar 128 0
n = get gxql 0
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len txdir bound 64
ffilc get txdir i
end
r = makedir ffile 0 get ffilel 0 448
for i ulong sub len txask len txdir bound 64
ffilc get txask add len txdir i
end
r = makedir ffile 0 get ffilel 0 448
for i ulong len txfq bound 16
ffilc get txfq i
end
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
ret 503
end
r = fstat int fd st 0 128
sz = or or ulong get st 48 shl ulong get st 49 8 or shl ulong get st 50 16 shl ulong get st 51 24
if or ne r 0 gt sz 4194304
x = fclose int fd
put fretry 0 60
ret 503
end
for i ulong 32
put b i get gxid i
end
put b 32 9
for i ulong n bound 304
put b add 33 i get gxq i
end
put b add 33 n 10
w = write int fd b 0 add 34 n
x = fclose int fd
if ne w long add 34 n
ret 503
end
rxidfile txeq
fd = fopen ffile 0 get ffilel 0 557249 384
if ge fd 0
w = write int fd b 33 n
x = fclose int fd
end
ret 0
end
note rxask: /research/ask?q=...
fn rxask to long
if not fget
ret 405
end
n = fqget txq
if le n 0
flocb
floct txhome
put fkind 0 2
ret 303
end
if not rxnorm ulong n
ret 400
end
rxmkid
rxidfile txeh
if rxhas
ret rxgo
end
rxidfile txeq
if rxhas
ret rxgo
end
if not fratelim
ret 429
end
r = rxqueue
if ne r 0
ret r
end
ret rxgo
end
note rxpend: the answer is not written yet. The question file must exist (else 404).
fn rxpend json bool to long
b = new uchar 304 0
if not fget
ret 405
end
rxidfile txeq
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret 404
end
n = read int fd b 0 300
x = fclose int fd
put fobl 0 0
put fkind 0 1
if json
fput txj1
for i ulong 32
fputc get gxid i
end
fput txj2
fsetct txctj
ret 200
end
fput txw1
if gt n 0
for i ulong ulong n bound 300
fescc get b i
end
end
fput txw2
fsetct txcth
ret 200
end
note rxans: /research/ask/<id>[.json]
fn rxans to long
a = len txpas
n = sub get fpathl 0 a
json = rxends txej
if json
n = sub n len txej
end
if not rxhexs a n
ret 404
end
if json
rxidfile txej
else
rxidfile txeh
end
if rxhas
if json
ret rxsend txctj
end
ret rxsend txcth
end
ret rxpend json
end
note rxone: ffile = <data>research/<name>, then stream it
fn rxone name view uchar * ct view uchar * to long
rxfile txdir 0 0 name
ret rxsend ct
end
text txnav "<a href=\"/research\">Research</a>"
note rxnav: the forge row entry (server/pages.om fhead); the research pages exist on base "/" only
fn rxnav to void
if eq get fbasel 0 1
fput txnav
end
end
note rxroute: 0 = not a research path
fn rxroute to long
if ne get fbasel 0 1
ret 0
end
if fpeq txpc
ret rxone txfc txctc
end
if fpeq txpj
ret rxone txfj txctj
end
if fpeq txpb
ret rxone txfb txctt
end
if fpeq txpt
ret rxone txft txctt
end
if or fpeq txp fpeq txps
ret rxone txfi txcth
end
if not fpre txps
ret 0
end
if fpeq txpa
ret rxask
end
if fpre txpas
ret rxans
end
ret rxwork
end

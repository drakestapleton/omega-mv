n = get pthl 0
for i ulong n bound 1100
put pt2 i get pth i
end
for i ulong len kxt
put pt2 add n i get kxt i
end
m = add n len kxt
c = new uchar 24 0
d = new uchar 24 0
k = ulong 0
x = v
while gt x 0 bound 20
put c k uchar add 48 rem x 10
x = div x 10
k = add k 1
end
if eq k 0
put c 0 48
k = ulong 1
end
for j ulong k bound 20
put d j get c sub sub k 1 j
end
put d k 10
r = unlink pt2 0 m
fd = fopen pt2 0 m 557249 384
if lt fd 0
ret false
end
w = write int fd d 0 add k 1
r = fsync int fd
y = fclose int fd
if ne w long add k 1
ret false
end
ret pmove n m
end

text kblob "100"
text k10 "10."
text krec "record"
text kwt "W\t"
text kpt "P\t"
text kone "1"
text kmode10 "bind"
text ktxt ".txt"
text kamb "ambiguous"
text kobject "{"
text karray "["
text kemptyo "{}"
text kemptya "[]"
text mmeta " invalid or ambiguous metadata container"
text mprofile "refused: MIXED_PROFILE_LAYOUT: normalise header selections before appending raw imports"
text kbr "R\t"

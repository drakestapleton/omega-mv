fn ownby to bool
n = ulong 0
for i ulong get avl 5 bound 512
put pth n ava 5 i
n = add n 1
end
for i ulong len kaut
put pth n get kaut i
n = add n 1
end
for i ulong 19
put pth n lowc ava 6 i
n = add n 1
end
for i ulong len kzt
put pth n get kzt i
n = add n 1
end
put pthl 0 n
if not rload
ret true
end
m = get rbl 0
a = ulong 0
k = len koa
while lt a m bound 65536
e = reol a
if ge sub e a k
same = true
for i ulong k bound 16
if ne get rb add a i get koa i
same = false
end
end
if same
if ne sub sub e a k get avl 7
ret false
end
ret raveq add a k 7
end
end
a = add e 1
end
ret true
end
note kdid: key- and 16 hex characters of SHA-256 over the did (slot 7)
fn kdid to void
b = new uchar 128 0
d = new uchar 32 0
n = get avl 7
for i ulong n bound 96
put b i ava 7 i
end
r = sha2_digest 256 view part b 0 n d
em kkey
for i ulong 8
v = get d i
emb get khex ulong shr v 4
emb get khex ulong and v 15
end
end
fn qrefuse m view uchar * to void
lgt m
lgb 10
end
note qline: one queue line qb[a, e)
fn qline a ulong e ulong to void
if lt sub e a 3
qrefuse mqbad
ret
end
ty = get qb a
ok = or eq ty 90 eq ty 80
if ok
ok = eq get qb add a 1 9
end
if ok
ok = eq nfld a e 4
end
if ok
ok = qfld a e 1 7
end
if ok
ok = didok 7
end
if ok
if eq ty 90
ok = qfld a e 2 6
if ok
if gt get avl 6 0
ok = orcok 6
end
end
if ok
ok = qfld a e 3 0
end
if ok
ok = zdoiok 0
if eq add get avl 6 get avl 0 0
ok = false
end
end
else
ok = qfld a e 3 6
if ok
if gt get avl 6 0
ok = orcok 6
end
end
if ok
ok = qfld a e 2 0
end
if ok
ok = ridok 0
end
end
end
if not ok
qrefuse mqbad
ret
end
note the shelf's allow file names the key or *; no file: no key may add
ldarg 3
if not rload
qrefuse mqallow
ret
end
if not or rstar rhas 7 false
qrefuse mqallow
ret
end
ldarg 4
if rload
if or or rhas 7 false rhas 0 true rhas 6 false
qrefuse mqrem
ret
end
end
if gt get avl 6 0
if not ownby
if eq ty 90
qrefuse mqown
ret
end
put avl 6 0
end
end
emb ty
emb 9
ema 7
emb 9
if eq ty 90
ema 6
emb 9
ema 0
else
ema 0
emb 9
ema 6
end
emb 9
if gt get avl 6 0
for i ulong 19
emb lowc ava 6 i
end
else
kdid
end
emb 10
end
fn qmode to int
for k ulong 5
if eq get avl add k 1 0
ret 2
end
end
n = get avl 1
if ne ava 1 sub n 1 47
ret 2
end
if ne ava 5 sub get avl 5 1 47
ret 2
end
for i ulong n bound 512
put pth i ava 1 i
end
for i ulong len kq
put pth add n i get kq i
end
put pthl 0 add n len kq
fd = fopen pth 0 get pthl 0 524288 0
if lt fd 0
ret done 0
end
off = getoff
k = pread int fd qb 0 65536 long off
x = fclose int fd
if le k 0
ret done 0
end
m = ulong k
a = ulong 0
while lt a m bound 65536
e = a
while lt e m bound 65536
if eq get qb e 10
break
end
e = add e 1
end
if ge e m
if and eq a 0 eq m 65536
a = m
end
break
end
qline a e
a = add e 1
end
if not putoff add off a
ret done 1
end
ret done 0
end
note ---- onshelf: exit 0 when the shelf list (slot 1) lists RID (slot 2) as brought by DID (slot 3)
fn smode to int
if not ridok 2
ret 2
end
if not didok 3
ret 2
end
for i ulong get avl 2 bound 512
put av i ava 2 i
end
put avl 0 get avl 2
for i ulong get avl 3 bound 512
put av add 3584 i ava 3 i
end
put avl 7 get avl 3
if listed 1
ret 0
end
ret 1
end
note ---- gather: an author's registry, only what may be shown. A work (its slug) is left oc when it
note has no P line; when the remove file (slot 1) names the key that asked or brought it, its
note repository or one of its DOIs; when it came from Radicle and the shelf list (slot 2) no longer
note lists its repository as brought by that key (withdrawn, taken down, refused); and when a W line
note for the same slug came before. Nothing is written when the remove file names the author's
note ORCID iD or the key that added the author. O and H lines pass as they are.
fn dropped a ulong b ulong to bool
for j ulong get dsl 0 bound 4096
s = get ds j
e = eol s
f = sfield s e 1
if feqr f tabat f e a b
ret true
end
end
ret false
end
fn drop s ulong to void
n = get dsl 0
if lt n 4096
put ds n s
put dsl 0 add n 1
end
end
note plfind: the P line of slug ib[a, b), or ibl
fn plfind a ulong b ulong to ulong
lim = get ibl 0
s = ulong 0
while lt s lim bound 8388608
e = eol s
if lpre s e kpt
f = add s 2
if feqr f tabat f e a b
ret s
end
end
s = add e 1
end
ret lim
end
note shelfok: copy the repository id ib[a, b) (rad: dropped) to slot 0 and the key ib[c, d) to slot 7,
note then read the shelf list (slot 2)
fn shelfok a ulong b ulong c ulong d ulong to bool
x = a
if lpre a b krp
x = add a 4
end
if or gt sub b x 44 gt sub d c 96
ret false
end
for i ulong sub b x bound 44
put av i get ib add x i
end
put avl 0 sub b x
for i ulong sub d c bound 96
put av add 3584 i get ib add c i
end
put avl 7 sub d c
ret listed 2
end
fn gremoved s ulong k ulong pre bool to bool
e = eol s
a = sfield s e k
ret rbhas a tabat a e pre
end
fn wasseen s ulong a ulong b ulong to bool
t = ulong 0
while lt t s bound 8388608
te = eol t
if lpre t te kwt
if feqr add t 2 tabat add t 2 te a b
ret true
end
end
t = add te 1
end
ret false
end
fn workbad s ulong pl ulong rm bool to bool
if rm
if or gremoved pl 3 false gremoved pl 5 true
ret true
end
if or gremoved s 6 false gremoved s 7 false
ret true
end
end
pe = eol pl
how = sfield pl pe 2
if reqt how tabat how pe krv
src = sfield pl pe 5
dd = sfield pl pe 3
ret not shelfok src tabat src pe dd tabat dd pe
end
ret false
end
fn gmode to int
if not rdin
x = flush 2 mbig len mbig
ret 2
end
haverm = false
ldarg 1
if rload
haverm = true
end
lim = get ibl 0
put dsl 0 0
s = ulong 0
while lt s lim bound 8388608
e = eol s
if haverm
if lpre s e koo
if rbhas add s len koo e false
ret done 0
end
end
if lpre s e koa
if rbhas add s len koa e false
ret done 0
end
end
end
s = add e 1
end
s = ulong 0
while lt s lim bound 8388608
e = eol s
if lpre s e kwt
a = add s 2
b = tabat a e
seen = wasseen s a b
pl = plfind a b
if or seen ge pl lim
drop s
else
if workbad s pl haverm
drop s
end
end
end
s = add e 1
end
s = ulong 0
while lt s lim bound 8388608
e = eol s
c = get ib s
keep = true
if and ne c 79 ne c 72
a = add s 2
if gt a e
keep = false
else
keep = not dropped a tabat a e
end
end
if keep
emr s e
emb 10
end
s = add e 1
end
ret done 0
end
note identify: single Zenodo record jflat lines; the first well-formed creator ORCID iD
fn imode to int
if not rdin
ret 2
end
put hs 0 0
put he 0 get ibl 0
put hpl 0 0
l = hfind 0 kmeta kcor 1000000
while lt l get he 0 bound 8388608
a = vala l
b = valb l
if eq sub b a 19
for i ulong 19
put av add 1024 i get ib add a i
end
put avl 2 19
if orcok 2
emr a b
emb 10
ret done 0
end
end
l = hfind add eol l 1 kmeta kcor 1000000
end
ret 1
end
fn main to int
c = argcnt
if lt c 2
ret 2
end
for k ulong 7
if lt add k 1 ulong c
x = arg add k 1
end
end
if argeq 1 kmode1
if ne c 6
ret 2
end
ret zmode
end
if argeq 1 kmode2
if ne c 6
ret 2
end
ret rmode
end
if argeq 1 kmode7
ret imode
end
if argeq 1 kmode3
ret tmode
end
if argeq 1 kmode4
if ne c 7
ret 2
end
shl1
ret qmode
end
if argeq 1 kmode5
if ne c 4
ret 2
end
shl1
ret gmode
end
if argeq 1 kmode6
if ne c 5
ret 2
end
shl1
ret smode
end
ret 2
end

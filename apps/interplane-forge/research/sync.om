note research/sync.om: research-sync, its own seeded Omega program (composed after om/tls/sha2.om).
note It runs outside the forged sandbox, beside the research agent: forged has no network. It turns
note requests that signed-in Radicle keys queued (research/route.om) and public metadata into registry
note lines for authors other than the registry's own (README.md "Other authors"). Every byte it
note reads from a repository, from Zenodo or from the queue is untrusted: each field is checked,
note decoded to one line, cut to the README's limits and written only through these checks.
note   research-sync zenodo ORCID DID DATE AUTHOR   stdin: jflat lines of Zenodo search responses
note   research-sync repo RID DID DATE AUTHOR       stdin: jflat lines of .zenodo.json, "@tree", git ls-tree -l
note   research-sync text                           stdin: plain text; stdout: one paragraph a line
note   research-sync queue ADDDIR/ STATE ALLOW REMOVE REGDIR/   stdout: the accepted requests
note   research-sync gather REMOVE SHELFLIST        stdin: an author's registry; stdout: what may be shown
note   research-sync onshelf SHELFLIST RID DID      exit 0 when the shelf lists RID as brought by DID
note zenodo and repo write registry lines on stdout, one "T <tab> slug <tab> source" line per work
note whose full text may be copied on descriptor 3, and one line per refusal or dropped link on
note stderr. A record is listed only when its creators carry ORCID (zenodo mode); full text only when
note the licence is on the open list (kopen). Exit 0 done, 1 refused (stderr says why), 2 usage or
note input this program does not accept (over 8 MiB, an argument that is not well formed).
global ib uchar 8388608
global ibl ulong 1
global ob uchar 4194304
global obl ulong 1
global oof ulong 1
global tb uchar 65536
global tbl ulong 1
global lb uchar 65536
global lbl ulong 1
global av uchar 4096
global avl ulong 8
global sg uchar 80
global sgl ulong 1
global hs ulong 1
global he ulong 1
global hpl ulong 1
global gn ulong 4
global rb uchar 65536
global rbl ulong 1
global qb uchar 65536
global pth uchar 1100
global pthl ulong 1
global pt2 uchar 1100
global rpk uchar 2300
global ds ulong 4096
global dsl ulong 1
text khits "/hits/hits/"
text kmeta "/metadata"
text knone ""
text kid "/id"
text kdoi "/doi"
text kcdoi "/conceptdoi"
text ktitle "/title"
text kdesc "/description"
text kdate "/publication_date"
text klic "/license/id"
text klics "/license"
text ksub "/resource_type/subtype"
text ktyp "/resource_type/type"
text kupt "/upload_type"
text kput "/publication_type"
text kver "/version"
text kvix "/relations/version/0/index"
text kcor "/creators/*/orcid"
text kcnm "/creators/*/name"
text kkw "/keywords/*"
text kri "/related_identifiers/*/identifier"
text krr "/related_identifiers/*/relation"
text kfk "/files/*/key"
text kfs "/files/*/size"
text kfl "/files/*/links/self"
text kopen " cc-by-4.0 cc-by-sa-4.0 cc0-1.0 cc-by-3.0 cc-by-sa-3.0 "
text khttps "https://"
text kzrec "https://zenodo.org/records/"
text kzen "Zenodo"
text krad "Radicle"
text krp "rad:"
text kart "article"
text kjart "journal-article"
text ktree "@tree"
text kos "O\tid\t"
text kon "O\tname\t"
text koo "O\torcid\t"
text koa "O\tadded-by\t"
text koc "O\tchecked\t"
text kov "O\tvia\t"
text kzv "zenodo"
text krv "radicle"
text ksep "; "
text kand " and "
text kmode1 "zenodo"
text kmode2 "repo"
text kmode3 "text"
text kmode4 "queue"
text kmode5 "gather"
text kmode6 "onshelf"
text kmode7 "identify"
text kq "queue"
text kxt ".tmp"
text kaut "a/"
text kzt "/owner.tsv"
text kkey "key-"
text khex "0123456789abcdef"
text kzpre "10.5281/zenodo."
text kst1 "open"
text kst2 "stored"
text kst3 "held"
text kpaper1 "paper.md"
text kpaper2 "paper.txt"
text kpaper3 "paper.pdf"
text klic1 "LICENSE"
text klic2 "LICENSE.md"
text klic3 "LICENSE.txt"
text klic4 "LICENCE"
text klic5 "COPYING"
text mref "refused "
text mown " the Zenodo record does not name ORCID iD "
text mown2 " among its creators"
text mmany " more than 200 records for one author"
text mnoid "a record without a record number"
text mnot " has no title"
text mlink "dropped link "
text mlink2 " (not https)"
text mlisted "listed "
text mrefd " refused "
text mbig "research-sync: input is 8388608 bytes or longer\n"
text mfull "research-sync: output is 4194304 bytes or longer\n"
text mrt "refused: .zenodo.json has no title"
text mrc "refused: .zenodo.json names no creator"
text mrl "refused: .zenodo.json names no license"
text mrf "refused: the repository has no LICENSE file at its top level"
text mrp "refused: the repository has no paper.md, paper.txt or paper.pdf at its top level"
text mqbad "refused: a malformed queue line"
text mqallow "refused: the key is not allowed to add work (the shelf's allow file)"
text mqrem "refused: the operator's remove file names this key, repository, ORCID iD or DOI"
text mqown "refused: another key added this ORCID iD"
text kdidp "did:key:z"
text kblob "100"
text k10 "10."
text ke1 "amp"
text ke2 "lt"
text ke3 "gt"
text ke4 "quot"
text ke5 "nbsp"
text krec "record"
text kwt "W\t"
text kpt "P\t"
note ---- output: stdout (ob), descriptor 3 (tb), stderr (lb)
fn emb c uchar to void
o = get obl 0
if lt o 4194304
put ob o c
put obl 0 add o 1
else
put oof 0 1
end
end
fn em t view uchar * to void
for i ulong len t bound 65536
emb get t i
end
end
fn emn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
emb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
emb get d n
end
end
fn emr a ulong b ulong to void
i = a
while lt i b bound 8388608
emb get ib i
i = add i 1
end
end
fn tbb c uchar to void
o = get tbl 0
if lt o 65536
put tb o c
put tbl 0 add o 1
else
put oof 0 1
end
end
fn lgb c uchar to void
o = get lbl 0
if lt o 65000
put lb o c
put lbl 0 add o 1
end
end
fn lgt t view uchar * to void
for i ulong len t bound 4096
lgb get t i
end
end
fn lgn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
lgb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
lgb get d n
end
end
note lgr: ib[a, b) into the log as printable ASCII (anything else becomes ?), at most 200 bytes
fn lgr a ulong b ulong to void
e = b
if gt sub b a 200
e = add a 200
end
i = a
while lt i e bound 200
c = get ib i
if or lt c 32 gt c 126
c = uchar 63
end
lgb c
i = add i 1
end
end
fn flush fd int b view uchar * n ulong to bool
o = ulong 0
while lt o n bound 8388608
k = write fd b o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
note Global arrays cannot be passed to user functions at the pinned compiler. Stream local windows.
fn flushg fd int n ulong to bool
b = new uchar 4096 0
o = ulong 0
while lt o n bound 4194304
m = sub n o
if gt m 4096
m = ulong 4096
end
for i ulong m bound 4096
if eq fd 1
put b i get ob add o i
end
if eq fd 2
put b i get lb add o i
end
if eq fd 3
put b i get tb add o i
end
end
if not flush fd b m
ret false
end
o = add o m
end
ret true
end
fn done rc int to int
x = flushg 2 get lbl 0
if ne get oof 0 0
x = flush 2 mfull len mfull
ret 2
end
if not flushg 1 get obl 0
ret 2
end
if gt get tbl 0 0
if not flushg 3 get tbl 0
ret 2
end
end
ret rc
end
note ---- arguments: argument k into av[512 k, ...), its length into avl k
fn arg k ulong to ulong
b = new uchar 512 0
n = argread k b 0 500
if or le n 0 ge n 500
put avl k 0
ret 0
end
m = ulong n
o = mul k 512
for i ulong m bound 512
put av add o i get b i
end
put avl k m
ret m
end
fn ava k ulong i ulong to uchar
ret get av add mul k 512 i
end
fn ema k ulong to void
for i ulong get avl k bound 512
emb ava k i
end
end
fn lga k ulong to void
for i ulong get avl k bound 512
lgb ava k i
end
end
fn argeq k ulong t view uchar * to bool
if ne get avl k len t
ret false
end
for i ulong len t bound 64
if ne ava k i get t i
ret false
end
end
ret true
end
note shl1: move arguments 2.. down one slot (the mode word leaves slot 1)
fn shl1 to void
for k ulong 6
for i ulong get avl add k 2 bound 512
put av add mul add k 1 512 i ava add k 2 i
end
put avl add k 1 get avl add k 2
end
put avl 7 0
end
note ---- checks on bytes
fn isdig c uchar to bool
ret and ge c 48 le c 57
end
fn islow c uchar to bool
ret and ge c 97 le c 122
end
fn lowc c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn b58 c uchar to bool
if isdig c
ret ne c 48
end
if and ge c 65 le c 90
ret and ne c 73 ne c 79
end
if islow c
ret ne c 108
end
ret false
end
note orcok: argument k is an ORCID iD: dddd-dddd-dddd-dddX with its ISO 7064 11,2 check character
fn orcok k ulong to bool
if ne get avl k 19
ret false
end
t = ulong 0
for i ulong 19
c = ava k i
if or eq i 4 or eq i 9 eq i 14
if ne c 45
ret false
end
else
if lt i 18
if not isdig c
ret false
end
t = mul add t ulong sub c 48 2
end
end
end
r = rem sub 12 rem t 11 11
c = ava k 18
if eq r 10
ret eq c 88
end
ret eq c uchar add 48 r
end
note didok: argument k is did:key:z followed by 1 to 87 base58 characters
fn didok k ulong to bool
n = get avl k
if or lt n 10 gt n 96
ret false
end
for i ulong 9
if ne ava k i get kdidp i
ret false
end
end
for i ulong sub n 9 bound 96
if not b58 ava k add 9 i
ret false
end
end
ret true
end
note ridok: argument k is z followed by 19 to 43 base58 characters (the shelf's rule, rad: dropped)
fn ridok k ulong to bool
n = get avl k
if or lt n 20 gt n 44
ret false
end
if ne ava k 0 122
ret false
end
for i ulong n bound 44
if not b58 ava k i
ret false
end
end
ret true
end
note autok: argument k is an author id: 1 to 64 bytes of a-z, 0-9 and -
fn autok k ulong to bool
n = get avl k
if or eq n 0 gt n 64
ret false
end
for i ulong n bound 64
c = ava k i
if not or or isdig c islow c eq c 45
ret false
end
end
ret true
end
fn dateok k ulong to bool
if ne get avl k 10
ret false
end
for i ulong 10
c = ava k i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not isdig c
ret false
end
end
end
ret true
end
note ---- the input
fn rdin to bool
n = ulong 0
k = long 1
while gt k 0 bound 8388608
if ge n 8388607
ret false
end
k = read 0 ib n sub 8388607 n
if gt k 0
n = add n ulong k
end
end
put ibl 0 n
ret true
end
fn eol a ulong to ulong
i = a
n = get ibl 0
while lt i n bound 8388608
if eq get ib i 10
ret i
end
i = add i 1
end
ret n
end
fn tabat a ulong e ulong to ulong
i = a
while lt i e bound 8388608
if eq get ib i 9
ret i
end
i = add i 1
end
ret e
end
fn lpre a ulong e ulong t view uchar * to bool
n = len t
if lt e a
ret false
end
if lt sub e a n
ret false
end
for i ulong n bound 256
if ne get ib add a i get t i
ret false
end
end
ret true
end
fn reqt a ulong b ulong t view uchar * to bool
if lt b a
ret false
end
if ne sub b a len t
ret false
end
ret lpre a b t
end
fn feqr a ulong b ulong c ulong d ulong to bool
if or lt b a lt d c
ret false
end
if ne sub b a sub d c
ret false
end
i = ulong 0
while lt i sub b a bound 8388608
if ne get ib add a i get ib add c i
ret false
end
i = add i 1
end
ret true
end
note sfield: start of field f (0 based) of the line ib[a, e); e when the line has fewer fields
fn sfield a ulong e ulong f ulong to ulong
p = a
j = ulong 0
while lt j f bound 16
while lt p e bound 8388608
if eq get ib p 9
break
end
p = add p 1
end
if ge p e
ret e
end
p = add p 1
j = add j 1
end
ret p
end
note ---- jflat paths. A hit is the run of lines whose path starts /hits/hits/<n>/ (zenodo) or the
note whole input up to "@tree" (repo). hpl is the length of the hit prefix of each line.
note pmat: the path ib[p, e) is pre followed by pat, where * in pat stands for a decimal index of
note 1 to 12 digits: k when k < 1000000, any index otherwise. The matched index (0 without *), or -1.
fn pindex p ulong e ulong k ulong to ulong
q = p
v = ulong 0
while lt q e bound 8388608
c = get ib q
if not isdig c
break
end
if ge sub q p 12
ret get ibl 0
end
v = add mul v 10 ulong sub c 48
q = add q 1
end
if eq q p
ret get ibl 0
end
if and lt k 1000000 ne v k
ret get ibl 0
end
put gn 3 v
ret q
end
fn pmat p ulong pre view uchar * pat view uchar * k ulong to long
e = tabat p eol p
q = p
for i ulong len pre bound 64
if ge q e
ret -1
end
if ne get ib q get pre i
ret -1
end
q = add q 1
end
got = long 0
for i ulong len pat bound 128
if eq get pat i 42
q = pindex q e k
if ge q get ibl 0
ret -1
end
got = long get gn 3
else
if ge q e
ret -1
end
if ne get ib q get pat i
ret -1
end
q = add q 1
end
end
if ne q e
ret -1
end
ret got
end
note hfind: the first line at or after s in the hit whose path matches; he when none
fn hfind s ulong pre view uchar * pat view uchar * k ulong to ulong
l = s
e = get he 0
while lt l e bound 8388608
ln = eol l
t = tabat l ln
if lt t ln
if ge pmat add l get hpl 0 pre pat k 0
ret l
end
end
l = add ln 1
end
ret e
end
note hidx: the index the line l matched (pmat again)
fn hidx l ulong pre view uchar * pat view uchar * to ulong
ln = eol l
t = tabat l ln
r = pmat add l get hpl 0 pre pat 1000000
if lt r 0
ret 0
end
ret ulong r
end
fn vala l ulong to ulong
ln = eol l
t = tabat l ln
if lt t ln
ret add t 1
end
ret ln
end
fn valb l ulong to ulong
ret eol l
end
fn hval pre view uchar * pat view uchar * to ulong
ret hfind get hs 0 pre pat 0
end
note ---- one field. emv writes the jflat value ib[a, b) as one registry field: \n and \t become a
note space, \\ a backslash, other control bytes are dropped, runs of spaces become one, no space at
note either end, at most cap bytes and never part of a UTF-8 character (a malformed byte becomes ?).
note html: a tag becomes a space and &amp; &lt; &gt; &quot; &#39; &nbsp; &#N; are decoded (N < 128).
note The bytes written.
fn u8len a ulong b ulong to ulong
c = get ib a
if lt c 128
ret 1
end
n = ulong 0
lo = uchar 128
hi = uchar 191
if and ge c 194 le c 223
n = ulong 2
end
if and ge c 224 le c 239
n = ulong 3
if eq c 224
lo = uchar 160
end
if eq c 237
hi = uchar 159
end
end
if and ge c 240 le c 244
n = ulong 4
if eq c 240
lo = uchar 144
end
if eq c 244
hi = uchar 143
end
end
if or eq n 0 gt add a n b
ret 0
end
d = get ib add a 1
if or lt d lo gt d hi
ret 0
end
for j ulong sub n 2 bound 4
d = get ib add add a 2 j
if or lt d 128 gt d 191
ret 0
end
end
ret n
end
note ent: the entity at ib[a, b) (a is &): its byte (0 when not one) and its length in gn 0
fn ent a ulong b ulong to uchar
put gn 0 1
m = sub b a
if gt m 10
m = ulong 10
end
e = a
for i ulong m bound 10
if eq get ib add a i 59
e = add a i
break
end
end
if eq e a
ret 0
end
put gn 0 add sub e a 1
s = add a 1
if reqt s e ke1
ret 38
end
if reqt s e ke2
ret 60
end
if reqt s e ke3
ret 62
end
if reqt s e ke4
ret 34
end
if reqt s e ke5
ret 32
end
if eq get ib s 35
v = ulong 0
i = add s 1
if eq i e
put gn 0 1
ret 0
end
while lt i e bound 10
if not isdig get ib i
put gn 0 1
ret 0
end
v = add mul v 10 ulong sub get ib i 48
i = add i 1
end
if or lt v 32 gt v 126
ret 32
end
ret uchar v
end
put gn 0 1
ret 0
end
note Preserve markup as text. The builder escapes it for each output format. No HTML is trusted.
fn emv a ulong b ulong cap ulong html bool to ulong
w = ulong 0
pend = false
i = a
while lt i b bound 8388608
c = get ib i
n = ulong 1
if eq c 92
if lt add i 1 b
n = ulong 2
c = get ib add i 1
if or eq c 110 eq c 116
c = uchar 32
end
end
end
if or le c 32 eq c 127
if gt w 0
pend = true
end
else
k = ulong 1
if ge c 128
k = u8len i b
if eq k 0
c = uchar 63
k = ulong 1
else
n = k
end
end
if pend
if gt add add w k 1 cap
ret w
end
emb 32
w = add w 1
pend = false
end
if gt add w k cap
ret w
end
if ge c 128
emr i add i k
else
emb c
end
w = add w k
end
i = add i n
end
ret w
end
note urlok: ib[a, b) is an https URL of at most 400 printable bytes without quote, angle bracket,
note backslash or backtick
fn urlok a ulong b ulong to bool
if lt b a
ret false
end
if or gt sub b a 400 le sub b a len khttps
ret false
end
if not lpre a b khttps
ret false
end
i = a
while lt i b bound 400
c = get ib i
if or le c 32 ge c 127
ret false
end
if or or eq c 34 eq c 39 or or eq c 60 eq c 62 or eq c 92 eq c 96
ret false
end
i = add i 1
end
ret true
end
note doiok: ib[a, b) is a DOI: 10.<digits>/<1 to 90 printable bytes without quote, angle bracket,
note backslash or space>
fn doiok a ulong b ulong to bool
if lt b a
ret false
end
if or lt sub b a 6 gt sub b a 120
ret false
end
if not lpre a b k10
ret false
end
i = add a 3
s = i
while lt i b bound 120
if not isdig get ib i
break
end
i = add i 1
end
if or eq i s ge i b
ret false
end
if ne get ib i 47
ret false
end
i = add i 1
if or eq i b gt sub b i 90
ret false
end
while lt i b bound 120
c = get ib i
if or le c 32 ge c 127
ret false
end
if or or eq c 34 eq c 39 or or eq c 60 eq c 62 eq c 92
ret false
end
i = add i 1
end
ret true
end
fn vdate a ulong b ulong to bool
if lt b a
ret false
end
if ne sub b a 10
ret false
end
for i ulong 10
c = get ib add a i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not isdig c
ret false
end
end
end
ret true
end
fn alldig a ulong b ulong to bool
if le b a
ret false
end
if gt sub b a 12
ret false
end
i = a
while lt i b bound 12
if not isdig get ib i
ret false
end
i = add i 1
end
ret true
end
fn dnum a ulong b ulong to ulong
v = ulong 0
i = a
while lt i b bound 12
v = add mul v 10 ulong sub get ib i 48
i = add i 1
end
ret v
end
note emw: ib[a, b) lowercased, keeping a-z 0-9 . - only, at most cap bytes (licence, kind, relation)
fn emw a ulong b ulong cap ulong to void
w = ulong 0
i = a
while lt i b bound 8388608
c = lowc get ib i
if or or isdig c islow c or eq c 45 eq c 46
if lt w cap
emb c
w = add w 1
end
end
i = add i 1
end
end
note isopen: the licence id ib[a, b) (any case) is on the open list kopen
fn isopen a ulong b ulong to bool
if le b a
ret false
end
n = sub b a
if gt n 32
ret false
end
m = len kopen
s = ulong 0
while lt add s add n 1 m bound 256
if eq get kopen s 32
hit = true
for i ulong n bound 32
if ne lowc get ib add a i get kopen add add s 1 i
hit = false
break
end
end
if hit
if eq get kopen add add s 1 n 32
ret true
end
end
end
s = add s 1
end
ret false
end
note ---- the slug: the title lowercased, a-z and 0-9 kept, any other run one -, at most 40 bytes,
note then - and the suffix (a record number, or r and the first letters of a repository id)
fn sgc c uchar to void
n = get sgl 0
if lt n 80
put sg n c
put sgl 0 add n 1
end
end
fn mkslug a ulong b ulong to void
put sgl 0 0
dash = false
i = a
while lt i b bound 8388608
c = lowc get ib i
if or isdig c islow c
if and dash gt get sgl 0 0
if ge get sgl 0 39
break
end
sgc 45
end
dash = false
sgc c
if ge get sgl 0 40
break
end
else
dash = true
end
i = add i 1
end
if eq get sgl 0 0
for j ulong len krec
sgc get krec j
end
end
sgc 45
end
fn ems to void
for i ulong get sgl 0 bound 80
emb get sg i
end
end
fn tbs to void
for i ulong get sgl 0 bound 80
tbb get sg i
end
end
note lhead: start a registry line "ty <tab> slug <tab>"
fn lhead ty uchar to void
emb ty
emb 9
ems
emb 9
end
note ---- the common part of a work (both modes): pre is /metadata (zenodo) or empty (repo)
fn names sep view uchar * pre view uchar * to void
l = hfind get hs 0 pre kcnm 1000000
n = ulong 0
while lt l get he 0 bound 8388608
if ge n 64
break
end
if gt n 0
em sep
end

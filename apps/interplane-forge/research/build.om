fn mahex a ulong b ulong n ulong to bool
if ne sub b a n
ret false
end
i = a
while lt i b bound 64
c = get ib i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 102
ok = true
end
if not ok
ret false
end
i = add i 1
end
ret true
end
fn magline s ulong to ulong
a = wf s 1
ret sline 0 71 a fe a eol s
end
fn magvalid s ulong to bool
lim = get ibl 0
e = eol s
a = wf s 1
b = fe a e
if ne sline 0 71 a b s
ret false
end
w = wline a b
if ge w lim
ret false
end
if ge majline w lim
ret false
end
if ge mapline w lim
ret false
end
a = wf s 2
if not mahex a fe a e 40
ret false
end
a = wf s 3
b = fe a e
if ne b e
ret false
end
ret mahex a b 64
end
fn magsnap s ulong to void
g = magline s
if ge g get ibl 0
ret
end

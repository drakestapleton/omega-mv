fn maprefix a ulong b ulong t view uchar * to bool
if lt sub b a len t
ret false
end
ret feqt a add a len t t
end
fn madate a ulong b ulong to bool
if ne sub b a 10
ret false
end
for i ulong 10
c = get ib add a i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if not and ge c 48 le c 57
ret false
end
end
end
ret true
end
fn matype s ulong k ulong to bool
a = wf s k
b = fe a eol s
ret or feqt a b maz feqt a b mar
end
fn maval s ulong to bool
if not matype s 5
ret false
end
a = wf s 1
b = fe a eol s
if not slugok a b
ret false
end
if feqt a b maself
ret false
end
a = wf s 4
if not maprefix a fe a eol s madid
ret false
end
a = wf s 6
ret madate a fe a eol s
end
fn majline s ulong to ulong
a = wf s 1
ret sline 0 74 a fe a eol s
end
fn mauline s ulong to ulong
j = majline s
if ge j get ibl 0
ret get ibl 0
end
a = wf j 2
ret sline 0 85 a fe a eol j
end
fn mapline s ulong to ulong
a = wf s 1
ret sline 0 80 a fe a eol s
end
fn matext s ulong to bool
p = mapline s
if ge p get ibl 0
ret false
end
a = wf p 6
b = fe a eol p
if ne sub b a 1
ret false
end
ret eq get ib a 49
end
note maok rejects ambiguous ids/slugs and broken joins before a document or path list is emitted.
fn maok to bool
lim = get ibl 0
s = nextl 0 87
while lt s lim bound 4096
a = wf s 1
b = fe a eol s
if not slugok a b
ret false
end
if ne wline a b s
ret false
end
s = nextl add eol s 1 87
end
s = nextl 0 85
while lt s lim bound 4096
if not maval s
ret false
end
a = wf s 1
b = fe a eol s
if ne sline 0 85 a b s
ret false
end
s = nextl add eol s 1 85
end
s = nextl 0 74
while lt s lim bound 4096
a = wf s 1
b = fe a eol s
if ge wline a b lim
ret false
end
if ne sline 0 74 a b s
ret false
end
a = wf s 2
if ge sline 0 85 a fe a eol s lim
ret false
end
s = nextl add eol s 1 74
end
s = nextl 0 71
while lt s lim bound 4096
if not magvalid s
ret false
end
s = nextl add eol s 1 71
end
s = nextl 0 80
while lt s lim bound 4096
if not mapvalid s
ret false
end
s = nextl add eol s 1 80
end
ret true
end
fn mapvalid s ulong to bool
e = eol s
a = wf s 1
b = fe a e
if ge wline a b get ibl 0
ret false
end
if ne sline 0 80 a b s
ret false
end
if not matype s 2
ret false
end
a = wf s 3
if not maprefix a fe a e madid
ret false
end
a = wf s 4
if not madate a fe a e
ret false
end
a = wf s 5
b = fe a e
if not or maprefix a b marad maprefix a b mazen
ret false
end
a = wf s 6
if ne sub fe a e a 1
ret false
end
ret or eq get ib a 48 eq get ib a 49
end
fn maraw a ulong b ulong to void
i = a
while lt i b bound 262144
emb get ib i
i = add i 1
end
end
fn maoval t view uchar * cap ulong to void
a = oval t
if lt a get ibl 0
emr a eol a cap
end
end
fn mamerge to int
if not maovok
ret 4
end
lim = get ibl 0
a = oval maid
b = eol a
if not slugok a b
ret 4
end
if feqt a b maself
ret 4
end
if or lt nextl 0 85 lim lt nextl 0 74 lim
ret 4
end
emb 85
emb 9
emr a b 64
emb 9
maoval kname 120
emb 9
maoval korcid 32
emb 9
maoval maby 128
emb 9
maoval mavia 16
emb 9
maoval kcheck 10
emb 10
s = add eol 0 1
while lt s lim bound 262144
e = eol s
ty = get ib s
if and ne ty 79 ne ty 77
maraw s e
emb 10
if eq ty 87
emb 74
emb 9
v = wf s 1
emr v fe v e 64
emb 9
emr a b 64
emb 10
end
end
s = add e 1
end
ret flush
end

fn malists corpus bool to void
s = nextl 0 87
while lt s get ibl 0 bound 4096
foreign = lt majline s get ibl 0
show = foreign
if corpus
show = or not foreign matext s
end
if show
emwh s 1 64
if corpus
emb 9
a = wf s 12
emr a fe a eol s 400
end
emb 10
end
s = nextl add eol s 1 87
end
end
fn mamode a ulong b ulong sa ulong sb ulong to int
if feqt a b mamrg
ret mamerge
end
if feqt a b maal
mauthors
ret flush

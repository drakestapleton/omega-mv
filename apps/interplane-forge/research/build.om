note ---- the filter
fn rdin to void
one = new uchar 1 0
n = ulong 0
k = long 1
while gt k 0 bound 262144
if eq n 262143
k = read 0 one 0 1
if ne k 0
exit 4
end
break
end
k = read 0 ib n sub 262143 n
if gt k 0
n = add n ulong k
end
end
if lt k 0
exit 4
end
put ibl 0 n
end
fn flush to int
n = get obl 0
o = ulong 0
while lt o n bound 2097152
k = write 1 ob o sub n o
if le k 0
ret 1
end
o = add o ulong k
end
ret 0
end
fn main to int
if gt argcnt 1
ret maargs
end
rdin
if not maok
ret 4
end
lim = get ibl 0
m = nextl 0 77
if ne m 0
ret 2
end
me = eol m
a = fld m me 1
b = fe a me
sa = fld m me 2
sb = fe sa me
if true
r = mamode a b sa sb
if ne r 99
ret r
end
end
if feqt a b mcss
css
ret flush
end
if feqt a b mindex
index
ret flush
end
if feqt a b mjson
json
ret flush
end
if feqt a b mbib
bib
ret flush
end
if feqt a b mtxt
txt
ret flush
end
if feqt a b mslugs
slugs
ret flush
end
if not or or feqt a b mwork feqt a b mwjson feqt a b mwbib
ret 2
end
if not slugok sa sb
ret 3
end
s = wline sa sb
if ge s lim
ret 3
end
if feqt a b mwork
work s
ret flush
end
if feqt a b mwjson
wjson s
ret flush
end
if feqt a b mwbib
bibone s
ret flush
end
ret 2
end
note ---- multi-author registry. O remains the legacy author; U is id,name,orcid,DID,via,date.
note J joins work to U; P is slug,how,DID,date,source,open-text. Missing P denies foreign text.
note Modes: merge converts one foreign catalog; authors lists ids; author renders an id.
note add and doi render information pages; foreign lists foreign slugs; corpus lists slug<TAB>title.
note quote reads foreign extracted text and prefixes its lines so they cannot become corpus headers.
note Exit 4 refuses malformed/ambiguous registry data or a full input/output buffer.
text mamrg "merge"
text maal "authors"
text maau "author"
text maad "add"
text mado "doi"
text mafo "foreign"
text maco "corpus"
text maqu "quote"
text maid "id"
text maby "added-by"
text mavia "via"
text maz "zenodo"
text mar "radicle"
text madid "did:key:z"
text marad "rad:z"
text mazen "https://zenodo.org/records/"
text maself "drakestapleton"
text mafoot "</main><footer class='foot'><p>DOIs are minted by Zenodo. The research registry records the source and the Radicle key that added a work. No scripts run on this page.</p><p><a href='/research.json'>JSON</a><a href='/research.bib'>BibTeX</a><a href='/research.txt'>Guide for agents</a></p></footer></body></html>\n"
text mahero "<section class='hero'><p class='eyebrow'>Research</p><h1>Ask the research.</h1><p class='sub'>Published work, connected by its sources. The agent answers from the open full text in this collection and names the papers it used. Some records contain metadata only.</p><p class='acts'><a class='btn' href='/research/add'>Add your work</a><a class='btn ghost' href='/research/doi'>Get a DOI</a></p>"
text maas "<section class='card'><h2>Authors</h2><ul class='edges'>"
text maalink "<li><a href='/research/authors/"
text mawsec "<section class='card'><h2>Works</h2><ol class='works'>"
text maend "</ol></section>\n"
text mauhead "<section class='card'><p class='eyebrow'>Author</p><h1>"
text mauid "</h1><p class='meta'>Author ID: "
text maun "</p><p class='meta'>Added by "
text mauvia ". Source: "
text maucheck ". Checked: "
text mauclose "</p></section>\n"
text mabyline "<p class='by'><a href='/research/authors/"
text maprov "<section class='card'><h2>Source</h2><p>Added through "
text mapkey " by Radicle key "
text mapdate ". Checked "
text mapsrc ". Source: "
text maptext "</p><p>Open full text may be included in the agent corpus.</p></section>\n"
text mapmeta "<section class='card'><p>Metadata only. The agent does not use this work as full-text evidence.</p></section>\n"
text mapttl "<article class='work'><p class='eyebrow'><a href='/research'>Research</a></p><h1>"
text mapacts "</p><p class='acts'><a class='btn ghost' href='/research/"
text mapdoi "<p class='acts'><a class='btn' href='https://doi.org/"
text mapdoi2 "'>Read at the DOI</a></p>"
text mapclose "</a></p>"
text maplead "<p class='lead'>"
text mapp "</p>"
text maquote "> "
text maadd "<section class='hero'><p class='eyebrow'>Research</p><h1>Add your work</h1><p class='sub'>Sign in with your Radicle key, then add an ORCID iD or a repository you brought to the shelf.</p><p><a class='btn' href='/research/add/'>Open the submission form</a></p></section><section class='card'><h2>From Zenodo</h2><p>Give your ORCID iD. The sync worker checks public Zenodo records whose creators name that iD. The page records the Radicle key that requested the addition; an ORCID match is not proof that the key belongs to that person.</p></section><section class='card'><h2>From a repository</h2><p>Bring the repository to the shelf with your Radicle key. Include .zenodo.json, a license file, and paper.md, paper.txt or paper.pdf at its root. The worker checks the shelf entry and metadata before listing the work.</p></section><section class='card'><h2>What is shown</h2><p>The registry keeps the source, the key that added it and the check date. Full text joins the question corpus only when its recorded license permits it. Metadata-only records can still have pages. The operator can remove a record, author or key, and a withdrawn shelf entry is removed on the next sync.</p></section>"
text madoi "<section class='hero'><p class='eyebrow'>Research</p><h1>Get a DOI</h1><p class='sub'>Zenodo mints the DOI. The local tool prepares a draft; you decide whether to publish.</p></section><section class='card'><h2>Prepare a repository</h2><p>At its root, include a nonempty LICENSE file, a PDF, and .zenodo.json with title, creators (name for each), description, license, upload_type and publication_type. Check those fields and the paper before uploading. A repository that already has a DOI is refused to avoid a duplicate deposit.</p></section><section class='card'><h2>Run on your own machine</h2><p>From the Interplane forge repository root, run <code>sh tools/doi/build.sh</code>. Keep ZENODO_TOKEN in your local shell environment, outside the repository. Do not send it to Interplane.</p><p>Try the sandbox: <code>sh tools/doi/doi.sh /path/to/paper-repo</code>. To make a real deposit, use <code>sh tools/doi/doi.sh /path/to/paper-repo --production</code>. An optional <code>--source /path/to/source.tar.gz</code> uploads a source archive with the PDF.</p></section><section class='card'><h2>Review before publishing</h2><p>The tool creates a draft, prints the reserved DOI, adds it to .zenodo.json while preserving the other metadata, and uploads the files. Review the draft on <a href='https://zenodo.org/uploads'>Zenodo</a>. Only an exact <code>yes</code> at the local terminal publishes it. Another answer, or no terminal, leaves an unpublished draft. A reserved DOI is not a published record.</p></section><section class='card'><h2>Link the published work</h2><p>After publication, commit the updated metadata and <a href='/research/add'>add your work</a>. Interplane links the published record; it does not mint a second DOI.</p></section>"

ret maauthor sa sb
end
if or feqt a b maad feqt a b mado
head 0 0 0 0
if feqt a b maad
em maadd
else
em madoi
end
em mafoot
ret flush
end
if feqt a b mafo
malists false
ret flush
end
if feqt a b maco
malists true
ret flush
end
ret 99
end
fn maqtext to int
bol = true
while true bound 2097152
k = read 0 ib 0 4096
if lt k 0
ret 1
end
if eq k 0
ret 0
end
i = ulong 0
while lt i ulong k bound 4096
c = get ib i
if bol
em maquote
bol = false
end
emb c
if eq c 10
bol = true
end
i = add i 1
end
r = flush
if ne r 0
ret r
end
put obl 0 0
end
ret 1
end
fn maargs to int
av = new uchar 16 0
if ne argcnt 2
ret 2
end
z = argread 1 av 0 16
if ne z 5
ret 2
end
for i ulong 5
if ne get av i get maqu i
ret 2
end
end
ret maqtext
end
note Foreign O values are checked before the U record is emitted; the merged parser repeats checks.
fn maovok to bool
a = oval maby
if not maprefix a eol a madid
ret false
end
a = oval mavia
b = eol a
if not or feqt a b maz feqt a b mar
ret false
end
a = oval kcheck
if not madate a eol a
ret false
end
a = oval kname
ret and lt a get ibl 0 gt eol a a
end

note ---- the filter
fn rdin to void
n = ulong 0
k = long 1
while gt k 0 bound 262144
k = read 0 ib n sub 262143 n
if gt k 0
n = add n ulong k
end
end
put ibl 0 n
end
fn flush to int
n = get obl 0
o = ulong 0
while lt o n bound 2097152
k = write 1 ob o sub n o
if le k 0
ret 1
end
o = add o ulong k
end
ret 0
end
fn main to int
rdin
lim = get ibl 0
m = nextl 0 77
if ne m 0
ret 2
end
me = eol m
a = fld m me 1
b = fe a me
sa = fld m me 2
sb = fe sa me
if feqt a b mcss
css
ret flush
end
if feqt a b mindex
index
ret flush
end
if feqt a b mjson
json
ret flush
end
if feqt a b mbib
bib
ret flush
end
if feqt a b mtxt
txt
ret flush
end
if feqt a b mslugs
slugs
ret flush
end
if not or or feqt a b mwork feqt a b mwjson feqt a b mwbib
ret 2
end
if not slugok sa sb
ret 3
end
s = wline sa sb
if ge s lim
ret 3
end
if feqt a b mwork
work s
ret flush
end
if feqt a b mwjson
wjson s
ret flush
end
if feqt a b mwbib
bibone s
ret flush
end
ret 2
end

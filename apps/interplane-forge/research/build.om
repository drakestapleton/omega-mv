text kart "journal-article"
text x01 "# Research on INTERPLANE: a guide for agents\n\nAuthor: "
text x02 "\nORCID: https://orcid.org/"
text x03 "\n\nEvery page has a JSON twin. Start at https://interplane.io/research.json (schema interplane/research/1).\nOne work: https://interplane.io/research/<slug>.json. BibTeX: https://interplane.io/research.bib or /research/<slug>.bib.\nAsk a question: GET https://interplane.io/research/ask?q=<your question, at most 300 bytes>. The answer is written by a\nmodel on the author's Spark from the full text of these works; follow the redirect and poll the answer URL (append .json).\nAn answer names the works it used. Check a claim against the work itself before relying on it.\n\nWorks:\n"
text x04 "\n- "
text x05 "\n  "
text x06 " | "
text x07 " | https://doi.org/"
text x08 "\n  https://interplane.io/research/"
note ---- stylesheet (colours only through the Sovereign Intelligence tokens)
text q01 "*{box-sizing:border-box}html,body{margin:0;background:var(--bg-primary);color:var(--text-primary);font:16px/24px var(--font-sans,Inter,system-ui,sans-serif)}\n"
text q02 "a{color:var(--accent);text-decoration:none;transition:color .15s}a:hover{color:var(--accent-hover)}a:focus-visible,input:focus-visible,button:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}\n"
text q03 ".top{position:sticky;top:0;z-index:3;display:flex;align-items:center;gap:24px;padding:12px 32px;background:var(--bg-header);border-bottom:1px solid var(--border)}\n"
text q04 ".wm{font-weight:700;letter-spacing:.3em;color:var(--text-primary)}.top nav{display:flex;gap:20px;font-size:14px}.top .on{color:var(--text-primary)}\n"
text q05 "main{max-width:1024px;margin:0 auto;padding:40px 24px 56px;display:flex;flex-direction:column;gap:16px}\n"
text q06 ".eyebrow{margin:0 0 8px;font-size:12px;line-height:16px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}\n"
text q07 "h1{margin:0 0 12px;font-size:36px;line-height:40px;font-weight:700}h2{margin:0 0 8px;font-size:18px;line-height:28px;font-weight:600}\n"
text q08 ".sub{margin:0 0 12px;color:var(--text-secondary)}.meta{margin:0 0 16px;font-size:12px;line-height:16px;color:var(--text-secondary)}\n"
text q09 ".hero{padding:24px 0 8px}.hero h1{font-size:48px;line-height:52px}\n"
text q10 ".ask{display:flex;gap:8px;margin:16px 0 12px}.q{flex:1;min-width:0;padding:12px 16px;border:1px solid var(--border-strong);border-radius:8px;background:var(--fill-input);color:var(--text-primary);font:16px/24px var(--font-sans,Inter,system-ui,sans-serif)}\n"
text q11 ".btn{display:inline-block;padding:12px 20px;border:0;border-radius:8px;background:var(--accent-fill);color:var(--on-accent-fill);font:600 16px/24px var(--font-sans,Inter,system-ui,sans-serif);cursor:pointer;transition:background-color .15s}\n"
text q12 ".btn:hover{background:var(--accent-fill-hover);color:var(--on-accent-fill)}.ghost,.ghost:hover{background:none;border:1px solid var(--border-strong);color:var(--text-primary)}\n"
text q13 ".try{margin:0;font-size:14px;line-height:20px;color:var(--text-secondary);display:flex;flex-wrap:wrap;gap:4px 16px}\n"
text q14 ".card,.thread{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:24px}\n"
text q15 ".orcid{margin:0 0 12px;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;font:14px/20px var(--font-mono,ui-monospace,monospace)}\n"
text q16 ".idb{padding:2px 10px;border:1px solid var(--success-line);border-radius:9999px;background:var(--success-tint);color:var(--success);font:600 12px/16px var(--font-sans,Inter,system-ui,sans-serif)}\n"
text q17 ".stats{display:grid;grid-template-columns:repeat(4,auto);gap:12px;margin:0}.stats dt{font-size:12px;line-height:16px;color:var(--text-secondary)}.stats dd{margin:0;font:600 20px/28px var(--font-mono,ui-monospace,monospace)}\n"
text q18 ".works,.vers,.edges,.files{list-style:none;margin:0;padding:0}.works li{padding:16px 0;border-top:1px solid var(--border-faint)}.works li:last-child{padding-bottom:0}\n"
text q19 ".wt{font-size:16px;line-height:24px;font-weight:600;color:var(--text-primary)}.wt:hover{color:var(--accent)}.ws{margin:4px 0 8px;color:var(--text-secondary);font-size:14px;line-height:20px}\n"
text q20 ".wmeta,.by{margin:0;display:flex;flex-wrap:wrap;gap:4px 16px;font:12px/16px var(--font-mono,ui-monospace,monospace);color:var(--text-secondary)}.by{margin:0 0 16px;font-size:14px;line-height:20px}\n"
text q21 ".ok{color:var(--success)}.warn{color:var(--warning)}.doi{overflow-wrap:anywhere}\n"
text q22 ".edges li,.vers li,.files li{display:flex;flex-wrap:wrap;gap:4px 12px;padding:8px 0;border-top:1px solid var(--border-faint);font-size:14px;line-height:20px}\n"
text q23 ".rel{color:var(--text-secondary)}.vn{font-weight:600}.vers li,.files li{font-family:var(--font-mono,ui-monospace,monospace);font-size:12px;line-height:16px}\n"
text q24 ".work h1{font-size:36px;line-height:40px}.lead{margin:0 0 16px;font-size:18px;line-height:28px}.acts{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px}\n"
text q25 ".work{display:flex;flex-direction:column;gap:16px}.work>.eyebrow,.work>h1,.work>.by,.work>.lead,.work>.acts{margin-bottom:0}\n"
text q26 ".abs{margin:0;color:var(--text-secondary);overflow-wrap:anywhere}.cite{margin:0 0 16px;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--fill-input);font:12px/16px var(--font-mono,ui-monospace,monospace);overflow-wrap:anywhere}\n"
text q27 ".ids{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}.ids dt{font-size:12px;line-height:16px;color:var(--text-secondary)}.ids dd{margin:0;font:12px/16px var(--font-mono,ui-monospace,monospace);overflow-wrap:anywhere}\n"
text q28 ".kw{margin:0;display:flex;flex-wrap:wrap;gap:8px}.kw span{padding:2px 10px;border:1px solid var(--border);border-radius:9999px;font-size:12px;line-height:16px;color:var(--text-secondary)}\n"
text q29 ".foot{max-width:1024px;margin:0 auto;padding:0 24px 40px;font-size:12px;line-height:16px;color:var(--text-secondary)}.foot p{margin:0 0 8px}.foot a{margin-right:16px}\n"
text q30 ".answer{white-space:pre-wrap;margin:0 0 16px;overflow-wrap:anywhere}.wait{color:var(--text-secondary)}\n"
text q31 "@media (max-width:700px){.top{gap:8px 12px;padding:12px 16px;flex-wrap:wrap}.top nav{flex-wrap:wrap;gap:6px 16px}main{padding:24px 16px 40px}.hero h1{font-size:36px;line-height:40px}.ask{flex-direction:column}.stats{grid-template-columns:repeat(2,auto)}.ids{grid-template-columns:1fr}.card,.thread{padding:16px}}\n"
note ---- output buffer: a byte past the end is dropped, never written
fn emb c uchar to void
o = get obl 0
if lt o 2097152
put ob o c
put obl 0 add o 1
end
end
fn em t view uchar * to void
n = len t
i = ulong 0
while lt i n bound 65536
emb get t i
i = add i 1
end
end
fn emn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
emb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
emb get d n
end
end
note cut: the end of a..b after at most cap bytes, never inside a UTF-8 character
fn cut a ulong b ulong cap ulong to ulong
if le b a
ret a
end
if le sub b a cap
ret b
end
e = add a cap
k = ulong 0
while lt k 3 bound 3
if gt e a
u = get ib e
if ge u 128
if lt u 192
e = sub e 1
end
end
end
k = add k 1
end
ret e
end
note emh: a..b of the input, HTML-escaped, at most cap input bytes
fn emh a ulong b ulong cap ulong to void
e = cut a b cap
i = a
while lt i e bound 262144
c = get ib i
if eq c 38
em tamp
else
if eq c 60
em tlt
else
if eq c 62
em tgt
else
if eq c 34
em tquo
else
if eq c 39
em tapo
else
if ge c 32
emb c
end
end
end
end
end
end
i = add i 1
end
end
note emj: a..b as the inside of a JSON string
fn emj a ulong b ulong cap ulong to void
e = cut a b cap
i = a
while lt i e bound 262144
c = get ib i
if or eq c 34 eq c 92
emb 92
emb c
else
if lt c 32
em ju00
emb get thex ulong shr c 4
emb get thex ulong and c 15
else
emb c
end
end
i = add i 1
end
end
note emq: a..b as part of a URL query: letters, digits and -._~ stay, a space is +, the rest %XX
fn emq a ulong b ulong cap ulong to void
e = cut a b cap
i = a
while lt i e bound 262144
c = get ib i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 65 le c 90
ok = true
end
if and ge c 97 le c 122
ok = true
end
if or or eq c 45 eq c 46 or eq c 95 eq c 126
ok = true
end
if ok
emb c
else
if eq c 32
emb 43
else
emb 37
emb get thex ulong shr c 4
emb get thex ulong and c 15
end
end
i = add i 1
end
end
note emx: a..b for a BibTeX value: braces and backslashes dropped, & % # _ $ escaped
fn emx a ulong b ulong cap ulong to void
e = cut a b cap
i = a
while lt i e bound 262144
c = get ib i
if or or eq c 123 eq c 125 eq c 92
c = uchar 32
end
if or or eq c 38 eq c 37 or or eq c 35 eq c 95 eq c 36
emb 92
end
if ge c 32
emb c
end
i = add i 1
end
end
note emr: a..b as plain text (control bytes dropped)
fn emr a ulong b ulong cap ulong to void
e = cut a b cap
i = a
while lt i e bound 262144
c = get ib i
if ge c 32
emb c
end
i = add i 1
end
end
note ---- input scanning: every index stays inside 0..ibl
fn find a ulong e ulong c uchar to ulong
i = a
while lt i e bound 262144
if eq get ib i c
ret i
end
i = add i 1
end
ret e
end
fn eol a ulong to ulong
ret find a get ibl 0 10
end
note nextl: start of the first line at or after p that is "ty <tab> ...", or ibl
fn nextl p ulong ty uchar to ulong
lim = get ibl 0
s = p
while lt s lim bound 262144
if eq get ib s ty
if lt add s 1 lim
if eq get ib add s 1 9
ret s
end
end
end
s = add eol s 1
end
ret lim
end
note fld: start of field k (0 based) of the line s..e; e when the line has fewer fields
fn fld s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 16
p = find p e 9
if lt p e
p = add p 1
end
j = add j 1
end
ret p
end
note fe: end of the field that starts at a in the line ending at e
fn fe a ulong e ulong to ulong
ret find a e 9
end
fn feqt a ulong b ulong t view uchar * to bool
n = len t
if lt b a
ret false
end
if ne sub b a n
ret false
end
i = ulong 0
while lt i n bound 256
if ne get ib add a i get t i
ret false
end
i = add i 1
end
ret true
end
fn feqr a ulong b ulong c ulong d ulong to bool
if or lt b a lt d c
ret false
end
n = sub b a
if ne n sub d c
ret false
end
i = ulong 0
while lt i n bound 262144
if ne get ib add a i get ib add c i
ret false
end
i = add i 1
end
ret true
end
fn pnum a ulong b ulong to ulong
v = ulong 0
i = a
while lt i b bound 262144
c = get ib i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
i = add i 1
end
ret v
end
fn cnt ty uchar to ulong
lim = get ibl 0
n = ulong 0
s = nextl 0 ty
while lt s lim bound 262144
n = add n 1
s = nextl add eol s 1 ty
end
ret n
end
note slugok: a..b is 1 to 64 bytes of a-z, 0-9 and -
fn slugok a ulong b ulong to bool
if or le b a gt sub b a 64
ret false
end
i = a
while lt i b bound 64
c = get ib i
ok = false
if and ge c 97 le c 122
ok = true
end
if and ge c 48 le c 57
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
i = add i 1
end
ret true
end
note wline: start of the W line whose slug is a..b, or ibl
fn wline a ulong b ulong to ulong
lim = get ibl 0
s = nextl 0 87
while lt s lim bound 262144
e = eol s
f = fld s e 1
if feqr f fe f e a b
ret s
end
s = nextl add e 1 87
end
ret lim
end
note sline: start of the first line of type ty whose field 1 is a..b, at or after p; or ibl
fn sline p ulong ty uchar a ulong b ulong to ulong
lim = get ibl 0
s = nextl p ty
while lt s lim bound 262144
e = eol s
f = fld s e 1
if feqr f fe f e a b
ret s
end
s = nextl add e 1 ty
end
ret lim
end
note oval: start of the value of author fact t (an O line), or ibl
fn oval t view uchar * to ulong
lim = get ibl 0
s = nextl 0 79
while lt s lim bound 262144
e = eol s
f = fld s e 1
if feqt f fe f e t
ret fld s e 2
end
s = nextl add e 1 79
end
ret lim
end
note emo: the value of author fact t, HTML-escaped; nothing when the fact is absent
fn emo t view uchar * cap ulong to void
v = oval t
if lt v get ibl 0
emh v eol v cap
end
end
fn emoj t view uchar * cap ulong to void
v = oval t
if lt v get ibl 0
emj v eol v cap
end
end
fn emor t view uchar * cap ulong to void
v = oval t
if lt v get ibl 0
emr v eol v cap
end
end
note wf: field k of the W line s, as start; its end is fe of that start
fn wf s ulong k ulong to ulong
ret fld s eol s k
end
note emwh / emwj: field k of the W line s, escaped for HTML or JSON
fn emwh s ulong k ulong cap ulong to void
a = wf s k
emh a fe a eol s cap
end
fn emwj s ulong k ulong cap ulong to void
a = wf s k
emj a fe a eol s cap
end
note emsub: field 2 of the first line of type ty for the work of W line s (its summary, authors, abstract)
fn subv s ulong ty uchar to ulong
a = wf s 1
l = sline 0 ty a fe a eol s
if ge l get ibl 0
ret get ibl 0
end
ret fld l eol l 2
end
fn emsubh s ulong ty uchar cap ulong to void
v = subv s ty
if lt v get ibl 0
emh v eol v cap
end
end
fn emsubj s ulong ty uchar cap ulong to void
v = subv s ty
if lt v get ibl 0
emj v eol v cap
end
end
note norcid: works whose W line says the ORCID record lists them
fn norcid to ulong
lim = get ibl 0
n = ulong 0
s = nextl 0 87
while lt s lim bound 262144
a = wf s 10
if lt a eol s
if eq get ib a 49
n = add n 1
end
end
s = nextl add eol s 1 87
end
ret n
end

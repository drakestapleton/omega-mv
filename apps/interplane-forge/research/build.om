fn maorcid u ulong legacy bool to void
a = get ibl 0
b = a
if legacy
a = oval korcid
b = eol a
else
a = wf u 3
b = fe a eol u
end
if ne sub b a 19
ret
end
for i ulong 19
c = get ib add a i
if or or eq i 4 eq i 9 eq i 14
if ne c 45
ret
end
else
ok = and ge c 48 le c 57
if and eq i 18 eq c 88
ok = true
end
if not ok
ret
end
end
end

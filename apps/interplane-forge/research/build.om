text h1 "<!doctype html><html lang='en' data-theme='dark'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>"
text h2 "</title><link rel='stylesheet' href='/assets/tokens.css'><link rel='stylesheet' href='/assets/research.css'><link rel='alternate' type='application/json' href='"
text h3 "'></head><body>\n<header class='top'><a class='wm' href='/'>INTERPLANE</a><nav><a href='/galaxy'>Galaxy</a><a href='/explore'>Explore</a><a class='on' href='/research'>Research</a><a href='/open/'>Open builds</a><a href='/salvage/'>Bring your build</a></nav></header>\n<main>\n"
text hfoot "</main>\n<footer class='foot'><p>DOIs are minted by Zenodo. Everything else here is built from the research registry in the Interplane forge repository by a seeded Omega program. No scripts run on this page.</p><p><a href='/research.json'>JSON</a><a href='/research.bib'>BibTeX</a><a href='/research.txt'>Guide for agents</a></p></footer></body></html>\n"

note chain.om: the INTERPLANE ledger, a hash chain anyone can check. Composed after om/tls/sha2.om.
note   chain add LEDGER KIND ACTOR SUBJECT < payload    append one record; prints "OK seq head"
note   chain verify LEDGER                              prints "OK count head" or "BAD line N code"
note   chain check LEDGER SEQ < payload                 the payload is the one record SEQ committed to
note A record is one line of seven tab-separated fields, ended by a line feed:
note   seq  utc  kind  actor  subject  payload  prev
note seq counts from 1. utc is YYYY-MM-DDTHH:MM:SSZ and never goes backwards. payload is the SHA-256
note of the payload bytes, 64 lowercase hex digits. prev is the SHA-256 of the previous record's line
note (its bytes without the line feed), or the word GENESIS in record 1. The head of a ledger is the
note SHA-256 of its last line. Changing, removing, inserting or reordering any record changes the head
note unless a SHA-256 collision is found (Ledger.lean, theorem tamper_evident).
note Without this program: printf %s "LINE" | sha256sum gives the next record's prev.
note add locks the ledger, verifies all of it, and refuses to append to a ledger that does not verify.
note Exit 0 done; 1 usage or a bad argument; 2 the ledger does not verify; 3 read or write failed;
note 4 check: no such record, or the payload is not the one committed.
note BAD codes: 1 not seven fields or a control byte; 2 seq; 3 utc; 4 payload digest; 5 prev;
note 6 line longer than 1,023 bytes; 7 last line has no line feed.
global gl uchar 1024
global gll ulong 1
global gh uchar 64
global ghl ulong 1
global gph uchar 64
global gq uchar 64
global gu uchar 20
global gs ulong 8
global ga uchar 4096
global gw uchar 2048
global gwl ulong 1
global gb uchar 65536
text tgen "GENESIS"
text tok "OK\t"
text tbad "BAD\tline\t"
note gs: 0 records accepted, 1 first BAD code, 2 its line number, 3 wanted seq, 4 wanted seq found
fn hexc v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end
note hline: gh = hex SHA-256 of the current line gl
fn hline to void
t = new uchar 1024 0
d = new uchar 32 0
n = get gll 0
i = ulong 0
while lt i n bound 1024
put t i get gl i
i = add i 1
end
k = sha2_digest 256 part t 0 n d
j = ulong 0
while lt j 32 bound 32
b = ulong get d j
put gh mul j 2 hexc shr b 4
put gh add mul j 2 1 hexc and b 15
j = add j 1
end
put ghl 0 64
end
note phash: gph = hex SHA-256 of everything on stdin; false when a read fails
fn phash to bool
c = new ulong 40 0
b = new uchar 65536 0
d = new uchar 32 0
sha256_init c
k = long 1
while gt k 0 bound 9223372036854775807
k = read 0 b 0 65536
if gt k 0
sha256_update c part b 0 ulong k
end
end
sha256_final c d
j = ulong 0
while lt j 32 bound 32
x = ulong get d j
put gph mul j 2 hexc shr x 4
put gph add mul j 2 1 hexc and x 15
j = add j 1
end
ret eq k 0
end
note ---- the current line gl: field k starts at lfs k and ends at lfe of that start
fn lfe a ulong to ulong
n = get gll 0
i = a
while lt i n bound 1024
if eq get gl i 9
ret i
end
i = add i 1
end
ret n
end
fn lfs k ulong to ulong
p = ulong 0
j = ulong 0
while lt j k bound 8
p = add lfe p 1
j = add j 1
end
ret p
end
note lshape: exactly six tabs and no other byte below 32
fn lshape to bool
n = get gll 0
t = ulong 0
i = ulong 0
while lt i n bound 1024
c = get gl i
if eq c 9
t = add t 1
else
if lt c 32
ret false
end
end
i = add i 1
end
ret eq t 6
end
note lnum: the decimal number in gl a..b; 0 when it is not 1 to 18 digits
fn lnum a ulong b ulong to ulong
if ge a b
ret 0
end
if gt sub b a 18
ret 0
end
v = ulong 0
i = a
while lt i b bound 18
c = get gl i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end
fn ldig i ulong to bool
c = get gl i
ret and ge c 48 le c 57
end
note lutc: field a..b is YYYY-MM-DDTHH:MM:SSZ and not before the last accepted record's
fn lutc a ulong b ulong to bool
if ne sub b a 20
ret false
end
i = ulong 0
while lt i 20 bound 20
c = get gl add a i
w = uchar 0
if eq i 4
w = uchar 45
end
if eq i 7
w = uchar 45
end
if eq i 10
w = uchar 84
end
if eq i 13
w = uchar 58
end
if eq i 16
w = uchar 58
end
if eq i 19
w = uchar 90
end
if eq w 0
if not ldig add a i
ret false
end
else
if ne c w
ret false
end
end
i = add i 1
end
if gt get gs 0 0
j = ulong 0
while lt j 20 bound 20
x = get gl add a j
y = get gu j
if gt x y
ret true
end
if lt x y
ret false
end
j = add j 1
end
end
ret true
end
fn lhex a ulong b ulong to bool
if ne sub b a 64
ret false
end
i = a
while lt i b bound 64
c = get gl i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 102
ok = true
end
if not ok
ret false
end
i = add i 1
end
ret true
end
note lprev: field a..b equals the expected prev (gh, ghl bytes)
fn lprev a ulong b ulong to bool
n = get ghl 0
if ne sub b a n
ret false
end
i = ulong 0
while lt i n bound 64
if ne get gl add a i get gh i
ret false
end
i = add i 1
end
ret true
end
note lcheck: 0 when the current line is the next valid record, else its BAD code
fn lcheck to ulong
if not lshape
ret 1
end
if ne lnum 0 lfe 0 add get gs 0 1
ret 2
end
u = lfs 1
if not lutc u lfe u
ret 3
end
p = lfs 5
if not lhex p lfe p
ret 4
end
q = lfs 6
if not lprev q lfe q
ret 5
end
ret 0
end
note laccept: the current line passed lcheck; remember its time, its digest, and the wanted record
fn laccept to void
u = lfs 1
i = ulong 0
while lt i 20 bound 20
put gu i get gl add u i
i = add i 1
end
n = add get gs 0 1
if eq n get gs 3
p = lfs 5
j = ulong 0
while lt j 64 bound 64
put gq j get gl add p j
j = add j 1
end
put gs 4 1
end
hline
put gs 0 n
end
fn lbad code ulong to void
if eq get gs 1 0
put gs 1 code
put gs 2 add get gs 0 1
end
end
fn lend to void
if eq get gs 1 0
c = lcheck
if eq c 0
laccept
else
lbad c
end
end
put gll 0 0
end
note vfy: read the whole ledger from fd. false when a read fails; gs 1 holds the first BAD code.
fn vfy fd int to bool
put gs 0 0
put gs 1 0
put gs 4 0
put gll 0 0
put ghl 0 7
for g ulong 7
put gh g get tgen g
end
k = long 1
while gt k 0 bound 9223372036854775807
k = read fd gb 0 65536
i = ulong 0
while lt long i k bound 65536
c = get gb i
if eq c 10
lend
else
m = get gll 0
if lt m 1023
put gl m c
put gll 0 add m 1
else
lbad 6
end
end
i = add i 1
end
end
if gt get gll 0 0
lbad 7
end
ret eq k 0
end
note ---- output line gw
fn wab c uchar to void
o = get gwl 0
if lt o 2047
put gw o c
put gwl 0 add o 1
end
end
fn wa t view uchar * to void
for i ulong len t bound 64
wab get t i
end
end
fn wan v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
wab 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
wab get d n
end
end
fn wa2 v ulong to void
wab uchar add 48 rem div v 10 10
wab uchar add 48 rem v 10
end
fn whead to void
n = get ghl 0
i = ulong 0
while lt i n bound 64
wab get gh i
i = add i 1
end
end
note wymd: days since 1970-01-01 as YYYY-MM-DD (proleptic Gregorian; the gate checks it against date -u)
fn wymd days ulong to void
z = add days 719468
era = div z 146097
doe = sub z mul era 146097
t = sub doe div doe 1460
t = add t div doe 36524
t = sub t div doe 146096
yoe = div t 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
wan y
wab 45
wa2 m
wab 45
wa2 d
end
fn wutc s ulong to void
r = rem s 86400
wymd div s 86400
wab 84
wa2 div r 3600
wab 58
wa2 div rem r 3600 60
wab 58
wa2 rem r 60
wab 90
end
note warg: append argument idx; false unless it is 1..cap bytes, each printable ASCII. With up
note set, only A-Z, 0-9 and _ pass (the kind field).
fn warg idx ulong cap ulong up bool to bool
n = argread idx ga 0 4096
if lt n 1
ret false
end
if gt ulong n cap
ret false
end
i = ulong 0
while lt i ulong n bound 4096
c = get ga i
if or lt c 32 gt c 126
ret false
end
if up
ok = false
if and ge c 65 le c 90
ok = true
end
if and ge c 48 le c 57
ok = true
end
if eq c 95
ok = true
end
if not ok
ret false
end
end
wab c
i = add i 1
end
ret true
end
fn wout fd int to bool
n = get gwl 0
o = ulong 0
while lt o n bound 2048
k = write fd gw o sub n o
if le k 0
ret false
end
o = add o ulong k
end
ret true
end
note ropen: open the ledger named by argument 2 with flags; the descriptor or a negative errno
fn ropen flags int to int
n = argread 2 ga 0 4095
if lt n 1
ret -1
end
ret int fopen ga 0 ulong n flags 420
end
note say: print OK count head, or BAD line N code; the exit status that goes with it
fn say to int
put gwl 0 0
if ne get gs 1 0
wa tbad
wan get gs 2
wab 9
wan get gs 1
wab 10
r = wout 1
ret 2
end
wa tok
wan get gs 0
wab 9
whead
wab 10
if wout 1
ret 0
end
ret 3
end
fn cverify to int
fd = ropen 0
if lt fd 0
ret 3
end
ok = vfy fd
r = fclose fd
if not ok
ret 3
end
ret say
end
fn ccheck to int
n = argread 3 ga 0 32
if lt n 1
ret 1
end
i = ulong 0
while lt i ulong n bound 32
put gl i get ga i
i = add i 1
end
put gll 0 ulong n
want = lnum 0 ulong n
if eq want 0
ret 1
end
fd = ropen 0
if lt fd 0
ret 3
end
put gs 3 want
ok = vfy fd
r = fclose fd
if not ok
ret 3
end
if ne get gs 1 0
ret say
end
if eq get gs 4 0
ret 4
end
if not phash
ret 3
end
j = ulong 0
while lt j 64 bound 64
if ne get gph j get gq j
ret 4
end
j = add j 1
end
ret say
end
fn cadd to int
fd = ropen 1090
if lt fd 0
ret 3
end
if ne flock fd 2 0
ret 3
end
if not vfy fd
ret 3
end
if ne get gs 1 0
r = fclose fd
ret say
end
if not phash
ret 3
end
put gwl 0 0
wan add get gs 0 1
wab 9
wutc div ulong realns 1000000000
wab 9
if not warg 3 24 true
ret 1
end
wab 9
if not warg 4 64 false
ret 1
end
wab 9
if not warg 5 128 false
ret 1
end
wab 9
for i ulong 64
wab get gph i
end
wab 9
whead
n = get gwl 0
if gt n 1023
ret 1
end
for k ulong n bound 1024
put gl k get gw k
end
put gll 0 n
note the new record must itself be the next valid record before it is written
if ne lcheck 0
ret 1
end
laccept
wab 10
if not wout fd
ret 3
end
if ne fsync fd 0
ret 3
end
r = fclose fd
ret say
end
fn main to int
if lt argcnt 3
ret 1
end
n = argread 1 ga 0 16
c = get ga 0
if and eq n 3 eq c 97
if eq argcnt 6
ret cadd
end
ret 1
end
if and eq n 6 eq c 118
if eq argcnt 3
ret cverify
end
ret 1
end
if and eq n 5 eq c 99
if eq argcnt 4
ret ccheck
end
ret 1
end
ret 1
end

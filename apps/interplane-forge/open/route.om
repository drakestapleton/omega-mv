text toctj "application/json; charset=utf-8"
text tohex "0123456789abcdef"
text tou00 "\\u00"
global gorid uchar 48
global goridl ulong 1
global godid uchar 96
global godidl ulong 1
global gonote uchar 208
global gonotel ulong 1
global gol uchar 262144
global goll ulong 1
global gojs ulong 1
global gop uchar 65536
global gopl ulong 1
global gotit uchar 208
global gotitl ulong 1
note ohb58: c is a base58 character
fn ohb58 c uchar to bool
for i ulong len tob58 bound 64
if eq get tob58 i c
ret true
end
end
ret false
end
note ohrid: the form value gcfv[0, n) as a RID into gorid: an optional "rad:", then z and base58,
note 20 to 44 characters in all
fn ohrid n ulong to bool
a = ulong 0
if ge n 4
same = true
for i ulong 4
if ne get gcfv i get torad i
same = false
end
end
if same
a = ulong 4
end
end
m = sub n a
if or lt m 20 gt m 44
ret false
end
if ne get gcfv a 122
ret false
end
for i ulong m bound 44
c = get gcfv add a i
if not ohb58 c
ret false
end
put gorid i c
end
put goridl 0 m
ret true
end
note ohdid: the signed-in key's DID into godid. False when signed out or the string is not plain.
fn ohdid to bool
who = get gscur 0
if eq who 0
ret false
end
n = get gssl who
if or eq n 0 gt n 96
ret false
end
o = get gsso who
for i ulong n bound 96
c = get gsstr add o i
if or le c 32 ge c 127
ret false
end
put godid i c
end
put godidl 0 n
ret true
end
note ohnote: the form value gcfv[0, n) into gonote: at most 200 bytes, control bytes become spaces
fn ohnote n ulong to bool
if gt n 200
ret false
end
for i ulong n bound 200
c = get gcfv i
if or lt c 32 eq c 127
c = uchar 32
end
put gonote i c
end
put gonotel 0 n
ret true
end
note ohfile: ffile = <data>open/<name>
fn ohfile name view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len todir bound 16
ffilc get todir i
end
for i ulong len name bound 16
ffilc get name i
end
end
note ohappend: one queue line of the given kind (66 B or 87 W). 0 done, else the status to answer.
fn ohappend kind uchar to long
b = new uchar 400 0
st = new uchar 128 0
ohfile tostop
put ffilel 0 sub get ffilel 0 len tostop
r = makedir ffile 0 get ffilel 0 448
ohfile toq
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
ret 503
end
r = fstat int fd st 0 128
sz = or or ulong get st 48 shl ulong get st 49 8 or shl ulong get st 50 16 shl ulong get st 51 24
if or ne r 0 gt sz 1048576
x = fclose int fd
ret 503
end
n = ulong 0
put b 0 kind
put b 1 9
n = ulong 2
for i ulong get goridl 0 bound 44
put b add n i get gorid i
end
n = add n get goridl 0
put b n 9
n = add n 1
for i ulong get godidl 0 bound 96
put b add n i get godid i
end
n = add n get godidl 0
if eq kind 66
put b n 9
n = add n 1
for i ulong get gonotel 0 bound 200
put b add n i get gonote i
end
n = add n get gonotel 0
end
put b n 10
n = add n 1
w = write int fd b 0 n
x = fclose int fd
if ne w long n
ret 503
end
ret 0
end
note ohgo: 303 to <base>open/
fn ohgo to long
flocb
floct todir
put fkind 0 2
ret 303
end
fn ohpost to long
r = sowpre
if ne r 0
ret r
end
soratev get gscur 0 get gsnow 0
if not slformvalid
ret soerr 400 tomsg1
end
if ne slgetform tsfcsrf 32
ret soerr 400 tomsg1
end
if not ohdid
ret 403
end
n = slgetform torid
if le n 0
ret soerr 400 tomsg1
end
if not ohrid ulong n
ret soerr 400 tomsg1
end
if slffeq toact towith
r = ohappend 87
if ne r 0
ret soerr 503 tomsgq
end
ret ohgo
end
if not slffeq toact tobring
ret soerr 400 tomsg1
end
if not slffeq tocons toyes
ret soerr 400 tomsg1
end
n = slgetform tonote
if lt n 0
ret soerr 400 tomsg1
end
if not ohnote ulong n
ret soerr 400 tomsg1
end
r = ohappend 66
if ne r 0
ret soerr 503 tomsgq
end
ret ohgo
end
note ---- the list
fn ohload to void
put goll 0 0
ohfile tolist
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret
end
n = ulong 0
k = long 1
while gt k 0 bound 262144
k = read int fd gol n sub 262143 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put goll 0 n
end
fn oheol a ulong to ulong
lim = get goll 0
i = a
while lt i lim bound 262144
if eq get gol i 10
ret i
end
i = add i 1
end
ret lim
end
note ohfld: start of field k of the row s..e (e when the row has fewer fields)
fn ohfld s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 16
while lt p e bound 262144
if eq get gol p 9
break
end
p = add p 1
end
if lt p e
p = add p 1
end
j = add j 1
end
ret p
end
fn ohfe a ulong e ulong to ulong
p = a
while lt p e bound 262144
if eq get gol p 9
ret p
end
p = add p 1
end
ret e
end
note ohesc / ohjs: field k of the row s..e, HTML-escaped or as JSON string bytes, at most cap bytes
fn ohesc s ulong e ulong k ulong cap ulong to void
a = ohfld s e k
b = ohfe a e
if gt sub b a cap
b = add a cap
end
i = a
while lt i b bound 262144
c = get gol i
if ge c 32
fescc c
end
i = add i 1
end
end
fn ohjs s ulong e ulong k ulong cap ulong to void
a = ohfld s e k
b = ohfe a e
if gt sub b a cap
b = add a cap
end
i = a
while lt i b bound 262144
c = get gol i
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
i = add i 1
end
end
note ohis: field k of the row equals t
fn ohis s ulong e ulong k ulong t view uchar * to bool
a = ohfld s e k
b = ohfe a e
if ne sub b a len t
ret false
end
for i ulong len t bound 64
if ne get gol add a i get t i
ret false
end
end
ret true
end
note ohpub: the row is on the shelf: state open (fetched by the intake) or held (the node already
note had the project)
fn ohpub s ulong e ulong to bool
if ohis s e 1 tostop
ret true
end
ret ohis s e 1 toheld
end
note ohmine: the row's did (field 2) is the signed-in key (godid)
fn ohmine s ulong e ulong to bool
n = get godidl 0
if eq n 0
ret false
end
a = ohfld s e 2
b = ohfe a e
if ne sub b a n
ret false
end
for i ulong n bound 96
if ne get gol add a i get godid i
ret false
end
end
ret true
end
note ohrow: a row needs its 8 fields and a well-formed rid
fn ohrow s ulong e ulong to bool
a = ohfld s e 7
if gt a e
ret false
end
if eq a e
if lt e 1
ret false
end
if ne get gol sub e 1 9
ret false
end
end
b = ohfe s e
n = sub b s
if or lt n 20 gt n 44
ret false
end
for i ulong n bound 44
if not ohb58 get gol add s i
ret false
end
end
ret true
end
fn ohcard s ulong e ulong to void
fput toc1
fput tocl1
fputb
fput todir
ohesc s e 0 44
fput tocl2
ohesc s e 5 120
fput tocl3
fput toc2
ohesc s e 6 400
fput toc3
ohesc s e 7 200
fput toc4
ohesc s e 0 44
fput toc5
ohesc s e 2 96
fput toc6
ohesc s e 3 10
fput toc7
ohesc s e 4 10
fput toc8
if ohmine s e
fput tof1
fputb
fput todir
fput tof2
socsrfout
fput tow1
ohesc s e 0 44
fput tow2
end
fput toc9
end
fn ohrefused s ulong e ulong to void
fput tor1
ohesc s e 0 44
fput tor2
ohesc s e 1 80
fput tor3
end
fn ohlist to void
lim = get goll 0
n = ulong 0
fput tol1
s = ulong 0
while lt s lim bound 4096
e = oheol s
if ohrow s e
if ohpub s e
ohcard s e
n = add n 1
else
if ohmine s e
ohrefused s e
end
end
end
s = add e 1
end
if eq n 0
fput tol0
end
end
note ohnum: field 4 (kilobytes) as a number
fn ohnum s ulong e ulong to ulong
a = ohfld s e 4
b = ohfe a e
v = ulong 0
i = a
while lt i b bound 12
c = get gol i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
i = add i 1
end
ret v
end
fn ohjson to long
lim = get goll 0
n = ulong 0
put fkind 0 1
fsetct toctj
fput toj1
s = ulong 0
while lt s lim bound 4096
e = oheol s
if ohrow s e
if ohpub s e
if gt n 0
fputc 44
end
fput toj2
ohjs s e 0 44
fput toj3
ohjs s e 2 96
fput toj4
ohjs s e 3 10
fput toj5
fnum ohnum s e
fput toj6
ohjs s e 5 120
fput toj7
ohjs s e 6 400
fput toj8
ohjs s e 7 200
fput toj9
n = add n 1
end
end
s = add e 1
end
fput toj10
ret 200
end
note ohnav: the forge row entry (server/pages.om fhead)
fn ohnav to void
fput tocl1
fputb
fput tonavl
end
note ohwj: the request wants JSON: it used a .json name (gojs) or says so in Accept. The .json
note names exist because a cache in front of forged may key on the address alone.
fn ohwj to bool
if ne get gojs 0 0
ret true
end
ret fjwant
end
fn ohpage to long
ohload
put godidl 0 0
signed = ohdid
if ohwj
ret ohjson
end
put fkind 0 0
fsetti toti
fput toh1
fput toh2
if signed
fput tof1
fputb
fput todir
fput tof2
socsrfout
fput tof3
else
fput toh3
fputb
fput tologin
fput toh4
end
ohlist
fput toag1
fputb
fput toag2
fputb
fput toag3
fput toend
ret 200
end
note ---- the project page: <base>open/<rid>
note Drawn from the shelf row (name, description, note, who, when) and the snapshot the intake wrote
note at <data>open/p/<rid>.txt: lines "kind <tab> text" with kind H (head and date), C (a commit),
note T (a top-level file: type letter, tab, name) or R (a README line). Only a rid whose row is on
note the shelf (open or held) has a page; every byte is escaped here, whatever the file holds.
note ohprid: the path after /open/ as a rid into gorid
fn ohprid to bool
a = len topath
n = sub get fpathl 0 a
if gt n 5
same = true
for i ulong 5
if ne fpathat add sub add a n 5 i get toejs i
same = false
end
end
if same
n = sub n 5
put gojs 0 1
end
end
if or lt n 20 gt n 44
ret false
end
for i ulong n bound 44
c = fpathat add a i
if not ohb58 c
ret false
end
put gorid i c
end
if ne get gorid 0 122
ret false
end
put goridl 0 n
ret true
end
fn ohpis s ulong e ulong to bool
b = ohfe s e
n = get goridl 0
if ne sub b s n
ret false
end
for i ulong n bound 44
if ne get gol add s i get gorid i
ret false
end
end
ret true
end
note ohprow: the start of the shelf row (open or held) of gorid, or goll
fn ohprow to ulong
lim = get goll 0
s = ulong 0
while lt s lim bound 4096
e = oheol s
if ohrow s e
if ohpub s e
if ohpis s e
ret s
end
end
end
s = add e 1
end
ret lim
end
note ohpload: <data>open/p/<rid>.txt into gop (at most 65,535 bytes; a longer file is shown cut)
fn ohpload to void
put gopl 0 0
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len todir bound 16
ffilc get todir i
end
for i ulong len topdir bound 8
ffilc get topdir i
end
for i ulong get goridl 0 bound 44
ffilc get gorid i
end
for i ulong len toptxt bound 8
ffilc get toptxt i
end
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret
end
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read int fd gop n sub 65535 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put gopl 0 n
end
fn ohpeol a ulong to ulong
lim = get gopl 0
i = a
while lt i lim bound 65536
if eq get gop i 10
ret i
end
i = add i 1
end
ret lim
end
note ohpesc: gop[a, b) escaped for HTML; a tab becomes a space
fn ohpesc a ulong b ulong to void
i = a
while lt i b bound 65536
c = get gop i
if eq c 9
c = uchar 32
end
if ge c 32
fescc c
end
i = add i 1
end
end
note ohpjs: gop[a, b) as JSON string bytes; a tab becomes a space
fn ohpjs a ulong b ulong to void
i = a
while lt i b bound 65536
c = get gop i
if eq c 9
c = uchar 32
end
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
i = add i 1
end
end
note ohpk: gop[s, e) is a snapshot line of this kind
fn ohpk kind uchar s ulong e ulong to bool
if lt e add s 2
ret false
end
if ne get gop s kind
ret false
end
ret eq get gop add s 1 9
end
fn ohpcnt kind uchar to ulong
lim = get gopl 0
n = ulong 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
n = add n 1
end
s = add e 1
end
ret n
end
note ohpitem: one snapshot line as HTML
fn ohpitem kind uchar s ulong e ulong to void
if eq kind 84
if lt e add s 4
ret
end
fput topli
ohpesc add s 4 e
if eq get gop add s 2 116
fputc 47
end
fput toplie
ret
end
if eq kind 67
fput topli
ohpesc add s 2 e
fput toplie
ret
end
ohpesc add s 2 e
if eq kind 82
fputc 10
end
end
note ohpsec: every snapshot line of one kind, with its heading; nothing when there is none
fn ohpsec kind uchar to void
if eq ohpcnt kind 0
ret
end
if eq kind 72
fput toph
end
if eq kind 67
fput topc
end
if eq kind 84
fput topt
end
if eq kind 82
fput topr
end
lim = get gopl 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
ohpitem kind s e
end
s = add e 1
end
if eq kind 72
fput tophe
end
if or eq kind 67 eq kind 84
fput topul
end
if eq kind 82
fput toppre
end
end
note ohpjarr: the lines of a kind as JSON strings (a file: its name, a folder with a slash)
fn ohpjarr kind uchar to void
lim = get gopl 0
n = ulong 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
if gt n 0
fputc 44
end
fputc 34
if eq kind 84
if ge e add s 4
ohpjs add s 4 e
if eq get gop add s 2 116
fputc 47
end
end
else
ohpjs add s 2 e
end
fputc 34
n = add n 1
end
s = add e 1
end
end
note ohpjtxt: the lines of a kind in one JSON string: only the first one, or all joined by \n
fn ohpjtxt kind uchar first bool to void
lim = get gopl 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
ohpjs add s 2 e
if first
ret
end
fputc 92
fputc 110
end
s = add e 1
end
end
note ---- parts taken from the project: the link between the shelf and the submission journey
note A submission (salvage/) names where it came from in its origin field. A source whose origin
note is exactly rad:<rid>, and an Omega part derived from such a source, are listed on the
note project page. The salvage slice publishes a derived part only with a passing receipt, so a
note listed part is a verified one; a source is listed as not verified. The project itself stays
note "Not verified": this is a list of facts, not a verdict on the project. Only the newest 200
note submissions are looked at. Nothing is listed while the salvage store is off.
note ohtit: the title of the loaded record into gotit
fn ohtit to void
n = get gllen 1
if gt n 200
n = ulong 200
end
o = get gloff 1
for i ulong n bound 200
put gotit i get glrec add o i
end
put gotitl 0 n
end
note ohorig: the origin field of the loaded record is exactly rad:<gorid>
fn ohorig to bool
n = get gllen 2
m = get goridl 0
if ne n add 4 m
ret false
end
o = get gloff 2
for i ulong 4
if ne get glrec add o i get torad i
ret false
end
end
for i ulong m bound 44
if ne get glrec add add o 4 i get gorid i
ret false
end
end
ret true
end
note ohmatch: 0 the public submission id is not from this project, 1 it is a source from it, 2 it
note is a published Omega part derived from a source from it. Its title is left in gotit.
fn ohmatch id view uchar * to ulong
pid = new uchar 64 0
if not slpublic id
ret 0
end
ohtit
if eq get glrec 8 1
if ohorig
ret 1
end
ret 0
end
if ne get glrec 8 2
ret 0
end
if ne get gllen 6 64
ret 0
end
o = get gloff 6
for i ulong 64
put pid i get glrec add o i
end
if not slload pid
ret 0
end
if ne get glrec 8 1
ret 0
end
if ohorig
ret 2
end
ret 0
end
fn ohtjs to void
for i ulong get gotitl 0 bound 200
c = get gotit i
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
end
end
fn ohpart id view uchar * k ulong json bool shown ulong to void
if json
if gt shown 0
fputc 44
end
fput topk1
for i ulong 64
fputc get id i
end
fput topk2
ohtjs
if eq k 2
fput topk3
else
fput topk4
end
ret
end
if eq shown 0
fput topa1
end
fput topli
fput tlhref
fputb
fput tlslug
for i ulong 64
fputc get id i
end
fput tlendh
for i ulong get gotitl 0 bound 200
fescc get gotit i
end
fput tlenda
if eq k 2
fput topa2
else
fput topa3
end
fput toplie
end
fn ohparts json bool to void
id = new uchar 64 0
if not slboot
ret
end
n = get glidxn 0
shown = ulong 0
for it ulong 200
if eq n 0
break
end
n = sub n 1
for i ulong 64
put id i get glidx add mul n 65 i
end
k = ohmatch id
if gt k 0
ohpart id k json shown
shown = add shown 1
end
end
if json
ret
end
if eq shown 0
fput topa4
fputb
fput topa5
for i ulong get goridl 0 bound 44
fescc get gorid i
end
fput topa6
else
fput topul
end
end
fn ohpjson s ulong e ulong to long
put fkind 0 1
fsetct toctj
fput topj1
ohjs s e 0 44
fput toj3
ohjs s e 2 96
fput toj4
ohjs s e 3 10
fput toj5
fnum ohnum s e
fput toj6
ohjs s e 5 120
fput toj7
ohjs s e 6 400
fput toj8
ohjs s e 7 200
fput topj2
ohpjtxt 72 true
fput topj3
ohpjarr 67
fput topj4
ohpjarr 84
fput topj5
ohpjtxt 82 false
fput topj6
ohparts true
fput topj7
ret 200
end
fn ohproj to long
if not fget
ret 405
end
if not ohprid
ret 404
end
ohload
s = ohprow
if ge s get goll 0
ret 404
end
e = oheol s
ohpload
if ohwj
ret ohpjson s e
end
put fkind 0 0
fsetti toti
fput top1
fputb
fput todir
fput top2
ohesc s e 5 120
fput top3
ohesc s e 6 400
fput top4
ohesc s e 7 200
fput top5
ohesc s e 0 44
fput top6
ohesc s e 2 96
fput top7
ohesc s e 3 10
fput top8
if eq get gopl 0 0
fput topno
end
ohpsec 72
ohpsec 67
ohpsec 84
ohpsec 82
ohparts false
fput toend
ret 200
end
note ohroute: 0 = not an open-builds path
fn ohroute to long
put gojs 0 0
if fpeq topjsn
if not fget
ret 405
end
put gojs 0 1
ret ohpage
end
if fpeq topat2
flocb
floct todir
put fkind 0 2
ret 301
end
if not fpre topath
ret 0
end
if not fpeq topath
ret ohproj
end
if eq get fmeth 0 3
ret ohpost
end
if not fget
ret 405
end
ret ohpage
end

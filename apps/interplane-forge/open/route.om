note ohb58: c is a base58 character
fn ohb58 c uchar to bool
for i ulong len tob58 bound 64
if eq get tob58 i c
ret true
end
end
ret false
end
note ohrid: the form value gcfv[0, n) as a RID into gorid: an optional "rad:", then z and base58,
note 20 to 44 characters in all
fn ohrid n ulong to bool
a = ulong 0
if ge n 4
same = true
for i ulong 4
if ne get gcfv i get torad i
same = false
end
end
if same
a = ulong 4
end
end
m = sub n a
if or lt m 20 gt m 44
ret false
end
if ne get gcfv a 122
ret false
end
for i ulong m bound 44
c = get gcfv add a i
if not ohb58 c
ret false
end
put gorid i c
end
put goridl 0 m
ret true
end
note ohdid: the signed-in key's DID into godid. False when signed out or the string is not plain.
fn ohdid to bool
who = get gscur 0
if eq who 0
ret false
end
n = get gssl who
if or eq n 0 gt n 96
ret false
end
o = get gsso who
for i ulong n bound 96
c = get gsstr add o i
if or le c 32 ge c 127
ret false
end
put godid i c
end
put godidl 0 n
ret true
end
note ohnote: the form value gcfv[0, n) into gonote: at most 200 bytes, control bytes become spaces
fn ohnote n ulong to bool
if gt n 200
ret false
end
for i ulong n bound 200
c = get gcfv i
if or lt c 32 eq c 127
c = uchar 32
end
put gonote i c
end
put gonotel 0 n
ret true
end
note ohfile: ffile = <data>open/<name>
fn ohfile name view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len todir bound 16
ffilc get todir i
end
for i ulong len name bound 16
ffilc get name i
end
end
note ohappend: one queue line of the given kind (66 B or 87 W). 0 done, else the status to answer.
fn ohappend kind uchar to long
b = new uchar 400 0
rm = ohroom 400
if or eq rm 1 eq rm 3
ret 507
end
ohfile tostop
put ffilel 0 sub get ffilel 0 len tostop
r = makedir ffile 0 get ffilel 0 448
ohfile toq
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
ret 503
end
sz = ohsize int fd
n = ulong 0
put b 0 kind
put b 1 9
n = ulong 2
for i ulong get goridl 0 bound 44
put b add n i get gorid i
end
n = add n get goridl 0
put b n 9
n = add n 1
for i ulong get godidl 0 bound 96
put b add n i get godid i
end
n = add n get godidl 0
if eq kind 66
put b n 9
n = add n 1
for i ulong get gonotel 0 bound 200
put b add n i get gonote i
end
n = add n get gonotel 0
end
put b n 10
n = add n 1
w = write int fd b 0 n
if ne w long n
if ge sz 0
r = ftrunc int fd sz
end
x = fclose int fd
ret 503
end
x = fclose int fd
ohused n
ret 0
end
note ohgo: 303 to <base>open/
fn ohgo to long
flocb
floct todir
put fkind 0 2
ret 303
end
fn ohpost to long
r = sowpre
if ne r 0
ret r
end
soratev get gscur 0 get gsnow 0
if not slformvalid
ret soerr 400 tomsg1
end
if ne slgetform tsfcsrf 32
ret soerr 400 tomsg1
end
if not ohdid
ret 403
end
n = slgetform torid
if le n 0
ret soerr 400 tomsg1
end
if not ohrid ulong n
ret soerr 400 tomsg1
end
if slffeq toact towith
r = ohappend 87
if eq r 507
ret soerr 503 tomroom
end
if ne r 0
ret soerr 503 tomsgq
end
ret ohgo
end
if not slffeq toact tobring
ret soerr 400 tomsg1
end
if not slffeq tocons toyes
ret soerr 400 tomsg1
end
n = slgetform tonote
if lt n 0
ret soerr 400 tomsg1
end
if not ohnote ulong n
ret soerr 400 tomsg1
end
r = ohappend 66
if eq r 507
ret soerr 503 tomroom
end
if ne r 0
ret soerr 503 tomsgq
end
ret ohgo
end
note ---- room: forged cannot measure free space itself (the pinned omc has no statfs host word), so
note it reads the intake's measure, <data>open/space: "free <digits> reserve <digits> at <digits>\n"
note (at most 80 bytes, a regular file, opened O_NOFOLLOW|O_NONBLOCK, parsed strictly). forged
note counts the bytes it writes under open/ after that measure (a new "at" starts the count again),
note so a stale file cannot let it write past the reserve. The folder is forged's own, so this is
note advisory for forged only; the intake checks the reserve again before it uses any of it.
note ohroom: room for n more bytes: 0 yes, 1 no room, 2 no measure (no file), 3 malformed
fn ohroom n ulong to ulong
b = new uchar 96 0
ohfb tospace
fd = fopen ffile 0 get ffilel 0 559104 0
if lt fd 0
ret 2
end
k = long -1
if ohreg int fd
k = read int fd b 0 96
end
x = fclose int fd
if or lt k 1 gt k 80
ret 3
end
if not ohspace b ulong k
ret 3
end
if ne get gospv 2 get gosat 0
put gosat 0 get gospv 2
put goscnt 0 0
end
fr = get gospv 0
rs = get gospv 1
if lt fr rs
ret 1
end
if lt sub fr rs add get goscnt 0 n
ret 1
end
ret 0
end
fn ohused n ulong to void
put goscnt 0 add get goscnt 0 n
end
fn ohreg fd int to bool
st = new uchar 128 0
r = fstat fd st 0 128
if ne r 0
ret false
end
m = or ulong get st 16 shl ulong get st 17 8
ret eq and m 61440 32768
end
note ohspace: b[0, k) is exactly the space line: its three numbers into gospv
fn ohspace b view uchar 96 k ulong to bool
p = ohsplit b k 0 tospf
if lt p 0
ret false
end
p = ohspnum b k ulong p 0
if lt p 0
ret false
end
p = ohsplit b k ulong p tospr
if lt p 0
ret false
end
p = ohspnum b k ulong p 1
if lt p 0
ret false
end
p = ohsplit b k ulong p tospa
if lt p 0
ret false
end
p = ohspnum b k ulong p 2
if lt p 0
ret false
end
if ne ulong p sub k 1
ret false
end
ret eq get b ulong p 10
end
note ohsplit: t at b[p]; the index after it, or -1
fn ohsplit b view uchar 96 k ulong p ulong t view uchar * to long
if gt add p len t k
ret -1
end
for i ulong len t bound 16
if ne get b add p i get t i
ret -1
end
end
ret long add p len t
end
note ohspnum: 1 to 19 digits at b[p] into gospv i (realns has 19); the index after them, or -1
fn ohspnum b view uchar 96 k ulong p ulong i ulong to long
v = ulong 0
q = p
while lt q k bound 96
c = get b q
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
q = add q 1
if gt sub q p 19
ret -1
end
end
if eq q p
ret -1
end
put gospv i v
ret long q
end
fn ohnoroom r ulong to void
if eq r 1
ohtx tomfull
ret
end
ohtx tomnr
end
note ---- the shelf's "Unfinished:" line is left out when the note is empty (no placeholder)
note ohunf: "<p><strong>Unfinished:</strong> <note></p>" for the row s..e, or nothing
fn ohunf s ulong e ulong to void
a = ohfld s e 7
b = ohfe a e
if le b a
ret
end
fput tounf1
ohesc s e 7 200
fput tounf2
end
note ---- the developer section of a project the hub stored (classes of the curated project page,
note server/pages.om, in forge.css): Radicle ID, clone line, download and its SHA-256, the bringer's
note DID and public key (ssh form, encoded from the did:key), the hub's key as the intake read it from
note the node (rad self --did, snapshot line N; left out when the snapshot has none), and what each
note signature shows. Every value is escaped.
fn ohdev s ulong e ulong to void
fput tdv1
ohesc s e 0 44
fput tdv2
ohesc s e 0 44
fput tdv3
h = new uchar 64 0
if ohdlsha h
fput tocl1
fputb
fput todir
ohesc s e 0 44
fput tdvtar
ohesc s e 0 44
fput tdvtar2
for i ulong 64
fescc get h i
end
fput tdvcode
else
fput tdvnone
end
fput tdv4
ohesc s e 2 96
fput tdv5
ohsshkey s e
fput tdv6
hub = ohnode
if hub
fput tdvhub
ohnodeout
fput tdv7
end
fput tdv8
if hub
fput tdv9
ohnodeout
fput tdv10
end
fput tdv11
end
note ohnode: the snapshot has an N line (the hub's DID); ohnodeout writes it escaped
fn ohnode to bool
ret gt ohpcnt 78 0
end
fn ohnodeout to void
lim = get gopl 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk 78 s e
ohpesc add s 2 e
ret
end
s = add e 1
end
end
note ohsshkey: the row's did:key as "ssh-ed25519 <base64 of the wire blob>", escaped; nothing when the
note did is not an Ed25519 did:key
fn ohsshkey s ulong e ulong to void
a = ohfld s e 2
b = ohfe a e
d = new uchar 96 0
n = sub b a
if or le n 9 gt n 96
ret
end
for i ulong n bound 96
put d i get gol add a i
end
for i ulong len tdidp8 bound 16
if ne get d i get tdidp8 i
ret
end
end
pk = new uchar 32 0
if not sodidpk part d 8 sub n 8 pk
ret
end
ohsshout pk
end
fn ohsshout pk view uchar 32 to void
blob = new uchar 51 0
put blob 3 11
for i ulong 11
put blob add i 4 get tdvsshn i
end
put blob 18 32
for i ulong 32
put blob add i 19 get pk i
end
o = new uchar 80 0
m = sob64 blob o
fput tdvsshn
fputc 32
for i ulong m bound 80
fescc get o i
end
end
note ---- the list, a row at a time. It has no size limit: <data>open/list.tsv is read in chunks of
note 65,536 bytes into goc (pread at gost 3) and each row goes to gol (goll bytes from 0), so the
note row helpers take s = 0 and e = goll. gol holds the first 4,096 bytes of each field (every tab
note is kept, so the fields keep their places); every field shown is cut shorter than that anyway
note (ohesc, ohjs: at most 400), so a row of any length is listed. The intake keeps every row whole
note in the file; its list_row_bytes alarm measures the longest. A failed read sets fobtr: the
note reply is a whole 500, never a cut list. gost: 0 fd + 1 (0 closed), 1 next byte of goc, 2
note bytes in goc, 3 the file offset of goc.
fn ohlopen to void
ohlclose
ohfile tolist
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret
end
put gost 0 add ulong fd 1
put gost 1 0
put gost 2 0
put gost 3 0
end
fn ohlclose to void
f = get gost 0
if gt f 0
x = fclose int sub f 1
end
put gost 0 0
end
fn ohlfill to bool
pos = add get gost 3 get gost 2
k = long -4
while eq k -4 bound 1000000
k = pread int sub get gost 0 1 goc 0 65536 long pos
end
if lt k 0
put fobtr 0 1
ret false
end
if eq k 0
ret false
end
put gost 3 pos
put gost 2 ulong k
put gost 1 0
ret true
end
note ohlnext: the next row into gol; false at the end of the list (the file is closed then)
fn ohlnext to bool
if eq get gost 0 0
ret false
end
n = ulong 0
fl = ulong 0
got = false
while true bound 9223372036854775807
p = get gost 1
if ge p get gost 2
if ohlfill
continue
end
if ne get fobtr 0 0
ohlclose
put goll 0 0
ret false
end
if not got
ohlclose
ret false
end
break
end
put gost 1 add p 1
got = true
c = get goc p
if eq c 10
break
end
if eq c 9
fl = ulong 0
end
if and lt fl 4096 lt n 65536
put gol n c
n = add n 1
end
if ne c 9
fl = add fl 1
end
end
put goll 0 n
ret true
end
note ohfld: start of field k of the row s..e (e when the row has fewer fields)
fn ohfld s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 16
while lt p e bound 262144
if eq get gol p 9
break
end
p = add p 1
end
if lt p e
p = add p 1
end
j = add j 1
end
ret p
end
fn ohfe a ulong e ulong to ulong
p = a
while lt p e bound 262144
if eq get gol p 9
ret p
end
p = add p 1
end
ret e
end
note ohesc / ohjs: field k of the row s..e, HTML-escaped or as JSON string bytes, at most cap bytes
fn ohesc s ulong e ulong k ulong cap ulong to void
a = ohfld s e k
b = ohfe a e
if gt sub b a cap
b = add a cap
end
i = a
while lt i b bound 262144
c = get gol i
if ge c 32
fescc c
end
i = add i 1
end
end
fn ohjs s ulong e ulong k ulong cap ulong to void
a = ohfld s e k
b = ohfe a e
if gt sub b a cap
b = add a cap
end
i = a
while lt i b bound 262144
c = get gol i
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
i = add i 1
end
end
note ohis: field k of the row equals t
fn ohis s ulong e ulong k ulong t view uchar * to bool
a = ohfld s e k
b = ohfe a e
if ne sub b a len t
ret false
end
for i ulong len t bound 64
if ne get gol add a i get t i
ret false
end
end
ret true
end
note ohpub: the row is on the shelf: state open (fetched by the intake), held (the node already
note had the project) or stored (brought with the one-command tool; the hub created it)
fn ohpub s ulong e ulong to bool
if ohis s e 1 tostop
ret true
end
if ohis s e 1 toheld
ret true
end
ret ohis s e 1 tostor
end
note ohmine: the row's did (field 2) is the signed-in key (godid)
fn ohmine s ulong e ulong to bool
n = get godidl 0
if eq n 0
ret false
end
a = ohfld s e 2
b = ohfe a e
if ne sub b a n
ret false
end
for i ulong n bound 96
if ne get gol add a i get godid i
ret false
end
end
ret true
end
note ohrow: a row needs its 8 fields and a well-formed rid
fn ohrow s ulong e ulong to bool
a = ohfld s e 7
if gt a e
ret false
end
if eq a e
if lt e 1
ret false
end
if ne get gol sub e 1 9
ret false
end
end
b = ohfe s e
n = sub b s
if or lt n 20 gt n 44
ret false
end
for i ulong n bound 44
if not ohb58 get gol add s i
ret false
end
end
ret true
end
fn ohcard s ulong e ulong to void
fput toc1
fput tocl1
fputb
fput todir
ohesc s e 0 44
fput tocl2
ohesc s e 5 120
fput tocl3
fput toc2
ohesc s e 6 400
fput toc3
ohunf s e
fput toc4
ohesc s e 0 44
fput toc5
ohesc s e 2 96
fput toc6
ohesc s e 3 10
fput toc7
ohesc s e 4 10
fput toc8
if ohis s e 1 tostor
fput tosbh
end
if ohmine s e
fput tof1
fputb
fput todir
fput tof2
socsrfout
fput tow1
ohesc s e 0 44
fput tow2
end
fput toc9
end
fn ohrefused s ulong e ulong to void
fput tor1
ohesc s e 0 44
fput tor2
ohesc s e 1 80
fput tor3
end
note ohnum: field 4 (kilobytes) as a number
fn ohnum s ulong e ulong to ulong
a = ohfld s e 4
b = ohfe a e
v = ulong 0
i = a
while lt i b bound 12
c = get gol i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
i = add i 1
end
ret v
end
fn ohjson to long
put gobody 0 0
put gobody 1 1
put gobody 2 0
put fkind 0 5
fsetct toctj
ret 200
end
note ohjrow: one shelf JSON row (the comma is emitted by the generator)
fn ohjrow s ulong e ulong to void
fput toj2
ohjs s e 0 44
fput toj3
ohjs s e 2 96
fput toj4
ohjs s e 3 10
fput toj5
fnum ohnum s e
fput toj6
ohjs s e 5 120
fput toj7
ohjs s e 6 400
fput toj8
ohjs s e 7 200
fput toj9a
ohdlj s e
fputc 125
end
note ohnav: the forge row entry (server/pages.om fhead)
fn ohnav to void
fput tocl1
fputb
fput tonavl
end
note ohwj: the request wants JSON: it used a .json name (gojs) or says so in Accept. The .json
note names exist because a cache in front of forged may key on the address alone.
fn ohwj to bool
if ne get gojs 0 0
ret true
end
ret fjwant
end
fn ohpage to long
put godidl 0 0
signed = ohdid
if ohwj
ret ohjson
end
put gobody 0 0
put gobody 1 0
put gobody 2 0
put fkind 0 5
fsetti toti
fsetct tohtmlct
ret 200
end
note ohintro: the page fragment's prefix (called by ohbody after the layout header)
fn ohintro to void
fput toh1
fput toh2
if ne get godidl 0 0
fput tof1
fputb
fput todir
fput tof2
socsrfout
fput tof3
else
fput toh3
fputb
fput tologin
fput toh4
end
fput tol1
end
fn ohoutro to void
if eq get gobody 2 0
fput tol0
end
fput toag1
fputb
fput toag2
fputb
fput toag3
fput toend
end
note ohbody: the next bounded batch of the shelf response, not a bounded shelf. fsend5 sends it
note chunked then asks for another batch, until the file ends. Each row is complete in a batch:
note the HTML translation pass sees whole elements. A row uses at most a few KiB after escaping;
note the 1 MiB high-water mark leaves room for one more row, not a limit on the response.
note gobody: 0 phase (0 layout and intro, 1 rows, 2 tail/layout footer, 3 done), 1 JSON, 2 rows.
fn ohbody to bool
put fobl 0 0
if eq get gobody 0 3
ret false
end
if eq get gobody 0 0
ohlopen
if ne get gobody 1 0
fput toj1
else
if not ftxwant
fhead
end
ohintro
end
put gobody 0 1
ret true
end
if eq get gobody 0 1
while ohlnext bound 9223372036854775807
s = ulong 0
e = get goll 0
if ohrow s e
if ohpub s e
if ne get gobody 1 0
if gt get gobody 2 0
fputc 44
end
ohjrow s e
else
ohcard s e
end
put gobody 2 add get gobody 2 1
else
if and eq get gobody 1 0 ohmine s e
ohrefused s e
end
end
end
if ge get fobl 0 1048576
ret true
end
end
put gobody 0 2
if ne get fobtr 0 0
ret false
end
if gt get fobl 0 0
ret true
end
end
if ne get gobody 1 0
fput toj10
else
ohoutro
if not ftxwant
ffoot
end
end
put gobody 0 3
ret true
end
fn ohbodyend to void
ohlclose
end
note ---- the project page: <base>open/<rid>
note Drawn from the shelf row (name, description, note, who, when) and the snapshot the intake wrote
note at <data>open/p/<rid>.txt: lines "kind <tab> text" with kind H (head and date), C (a commit),
note T (a top-level file: type letter, tab, name) or R (a README line). Only a rid whose row is on
note the shelf (open or held) has a page; every byte is escaped here, whatever the file holds.
note ohprid: the path after /open/ as a rid into gorid
fn ohprid to bool
a = len topath
n = sub get fpathl 0 a
if gt n 5
same = true
for i ulong 5
if ne fpathat add sub add a n 5 i get toejs i
same = false
end
end
if same
n = sub n 5
put gojs 0 1
end
end
if or lt n 20 gt n 44
ret false
end
for i ulong n bound 44
c = fpathat add a i
if not ohb58 c
ret false
end
put gorid i c
end
if ne get gorid 0 122
ret false
end
put goridl 0 n
ret true
end
fn ohpis s ulong e ulong to bool
b = ohfe s e
n = get goridl 0
if ne sub b s n
ret false
end
for i ulong n bound 44
if ne get gol add s i get gorid i
ret false
end
end
ret true
end
note ohprow: the shelf row (open, held or stored) of gorid into gol (true), else false
fn ohprow to bool
ohlopen
while ohlnext bound 9223372036854775807
s = ulong 0
e = get goll 0
if ohrow s e
if ohpub s e
if ohpis s e
ohlclose
ret true
end
end
end
end
ret false
end
note ohpload: <data>open/p/<rid>.txt into gop (at most 65,535 bytes; a longer file is shown cut)
fn ohpload to void
put gopl 0 0
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len todir bound 16
ffilc get todir i
end
for i ulong len topdir bound 8
ffilc get topdir i
end
for i ulong get goridl 0 bound 44
ffilc get gorid i
end
for i ulong len toptxt bound 8
ffilc get toptxt i
end
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret
end
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read int fd gop n sub 65535 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put gopl 0 n
end
fn ohpeol a ulong to ulong
lim = get gopl 0
i = a
while lt i lim bound 65536
if eq get gop i 10
ret i
end
i = add i 1
end
ret lim
end
note ohpesc: gop[a, b) escaped for HTML; a tab becomes a space
fn ohpesc a ulong b ulong to void
i = a
while lt i b bound 65536
c = get gop i
if eq c 9
c = uchar 32
end
if ge c 32
fescc c
end
i = add i 1
end
end
note ohpjs: gop[a, b) as JSON string bytes; a tab becomes a space
fn ohpjs a ulong b ulong to void
i = a
while lt i b bound 65536
c = get gop i
if eq c 9
c = uchar 32
end
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
i = add i 1
end
end
note ohpk: gop[s, e) is a snapshot line of this kind
fn ohpk kind uchar s ulong e ulong to bool
if lt e add s 2
ret false
end
if ne get gop s kind
ret false
end
ret eq get gop add s 1 9
end
fn ohpcnt kind uchar to ulong
lim = get gopl 0
n = ulong 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
n = add n 1
end
s = add e 1
end
ret n
end
note ohpitem: one snapshot line as HTML
fn ohpitem kind uchar s ulong e ulong to void
if eq kind 84
if lt e add s 4
ret
end
fput topli
ohpesc add s 4 e
if eq get gop add s 2 116
fputc 47
end
fput toplie
ret
end
if eq kind 67
fput topli
ohpesc add s 2 e
fput toplie
ret
end
ohpesc add s 2 e
if eq kind 82
fputc 10
end
end
note ohpsec: every snapshot line of one kind, with its heading; nothing when there is none
fn ohpsec kind uchar to void
if eq ohpcnt kind 0
ret
end
if eq kind 72
fput toph
end
if eq kind 67
fput topc
end
if eq kind 84
fput topt
end
if eq kind 82
fput topr
end
lim = get gopl 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
ohpitem kind s e
end
s = add e 1
end
if eq kind 72
fput tophe
end
if or eq kind 67 eq kind 84
fput topul
end
if eq kind 82
fput toppre
end
end
note ohpjarr: the lines of a kind as JSON strings (a file: its name, a folder with a slash)
fn ohpjarr kind uchar to void
lim = get gopl 0
n = ulong 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
if gt n 0
fputc 44
end
fputc 34
if eq kind 84
if ge e add s 4
ohpjs add s 4 e
if eq get gop add s 2 116
fputc 47
end
end
else
ohpjs add s 2 e
end
fputc 34
n = add n 1
end
s = add e 1
end
end
note ohpjtxt: the lines of a kind in one JSON string: only the first one, or all joined by \n
fn ohpjtxt kind uchar first bool to void
lim = get gopl 0
s = ulong 0
while lt s lim bound 65536
e = ohpeol s
if ohpk kind s e
ohpjs add s 2 e
if first
ret
end
fputc 92
fputc 110
end
s = add e 1
end
end
note ---- parts taken from the project: the link between the shelf and the submission journey
note A submission (salvage/) names where it came from in its origin field. A source whose origin
note is exactly rad:<rid>, and an Omega part derived from such a source, are listed on the
note project page. The salvage slice publishes a derived part only with a passing receipt, so a
note listed part is a verified one; a source is listed as not verified. The project itself stays
note "Not verified": this is a list of facts, not a verdict on the project. Only the newest 200
note submissions are looked at. Nothing is listed while the salvage store is off.
note ohtit: the title of the loaded record into gotit
fn ohtit to void
n = get gllen 1
if gt n 200
n = ulong 200
end
o = get gloff 1
for i ulong n bound 200
put gotit i get glrec add o i
end
put gotitl 0 n
end
note ohorig: the origin field of the loaded record is exactly rad:<gorid>
fn ohorig to bool
n = get gllen 2
m = get goridl 0
if ne n add 4 m
ret false
end
o = get gloff 2
for i ulong 4
if ne get glrec add o i get torad i
ret false
end
end
for i ulong m bound 44
if ne get glrec add add o 4 i get gorid i
ret false
end
end
ret true
end
note ohmatch: 0 the public submission id is not from this project, 1 it is a source from it, 2 it
note is a published Omega part derived from a source from it. Its title is left in gotit.
fn ohmatch id view uchar * to ulong
pid = new uchar 64 0
if not slpublic id
ret 0
end
ohtit
if eq get glrec 8 1
if ohorig
ret 1
end
ret 0
end
if ne get glrec 8 2
ret 0
end
if ne get gllen 6 64
ret 0
end
o = get gloff 6
for i ulong 64
put pid i get glrec add o i
end
if not slload pid
ret 0
end
if ne get glrec 8 1
ret 0
end
if ohorig
ret 2
end
ret 0
end
fn ohtjs to void
for i ulong get gotitl 0 bound 200
c = get gotit i
if or eq c 34 eq c 92
fputc 92
fputc c
else
if lt c 32
fput tou00
fputc get tohex ulong shr c 4
fputc get tohex ulong and c 15
else
fputc c
end
end
end
end
fn ohpart id view uchar * k ulong json bool shown ulong to void
if json
if gt shown 0
fputc 44
end
fput topk1
for i ulong 64
fputc get id i
end
fput topk2
ohtjs
if eq k 2
fput topk3
else
fput topk4
end
ret
end
if eq shown 0
fput topa1
end
fput topli
fput tlhref
fputb
fput tlslug
for i ulong 64
fputc get id i
end
fput tlendh
for i ulong get gotitl 0 bound 200
fescc get gotit i
end
fput tlenda
if eq k 2
fput topa2
else
fput topa3
end
fput toplie
end
fn ohparts json bool to void
id = new uchar 64 0
if not slboot
ret
end
n = get glidxn 0
shown = ulong 0
for it ulong 200
if eq n 0
break
end
n = sub n 1
for i ulong 64
put id i get glidx add mul n 65 i
end
k = ohmatch id
if gt k 0
ohpart id k json shown
shown = add shown 1
end
end
if json
ret
end
if eq shown 0
fput topa4
fputb
fput topa5
for i ulong get goridl 0 bound 44
fescc get gorid i
end
fput topa6
else
fput topul
end
end
fn ohpjson s ulong e ulong to long
put fkind 0 1
fsetct toctj
fput topj1
ohjs s e 0 44
fput toj3
ohjs s e 2 96
fput toj4
ohjs s e 3 10
fput toj5
fnum ohnum s e
fput toj6
ohjs s e 5 120
fput toj7
ohjs s e 6 400
fput toj8
ohjs s e 7 200
fput toj9a
ohdlj s e
fput topj2b
ohpjtxt 72 true
fput topj3
ohpjarr 67
fput topj4
ohpjarr 84
fput topj5
ohpjtxt 82 false
fput topj6
ohparts true
fput topj7
ret 200
end
fn ohproj to long
if not fget
ret 405
end
if not ohprid
ret 404
end
if not ohprow
ret 404
end
s = ulong 0
e = get goll 0
ohpload
if ohwj
ret ohpjson s e
end
put fkind 0 0
fsetti toti
fput top1
fputb
fput todir
fput top2
ohesc s e 5 120
fput top3
ohesc s e 6 400
fput top4
ohunf s e
fput top5
ohesc s e 0 44
fput top6
ohesc s e 2 96
fput top7
ohesc s e 3 10
fput top8
if eq get gopl 0 0
fput topno
end
ohpsec 72
ohpsec 67
ohpsec 84
ohpsec 82
if ohis s e 1 tostor
ohdev s e
end
ohparts false
fput toend
ret 200
end
note ohroute: 0 = not an open-builds path
fn ohroute to long
put gojs 0 0
if fpeq tobrsh
ret ohtool tobrf
end
if fpeq togtsh
ret ohtool togtf
end
if fpeq towdsh
ret ohtool towdf
end
if fpeq topjsn
if not fget
ret 405
end
put gojs 0 1
ret ohpage
end
if fpeq topat2
flocb
floct todir
put fkind 0 2
ret 301
end
if not fpre topath
ret 0
end
if fpeq toup
ret ohup
end
if fpre toupd
ret ohupst
end
if fpeq toalj
ret ohalarm
end
if ohistar
ret ohtar
end
if not fpeq topath
ret ohproj
end
if eq get fmeth 0 3
ret ohpost
end
if not fget
ret 405
end
ret ohpage
end
note ---- one-command bring: the upload (contract one-command-contract.md, slice HUB)
note The spool of one upload is <data>open/up/<sha>.<didhash>.b64, didhash the first 8 bytes of
note sha256(did) in hex, so a key only ever appends to its own spool. One line per chunk, in seq
note order: the base64url data, a tab, the seq and the archive bytes received so far as 10 decimal
note digits each, a line feed. The last 22 bytes of the file are always the newest seq and total, so
note a chunk costs one short read whatever the size of the spool. finish writes
note <sha>.<didhash>.sig (the armored signature of the bring statement) and one queue line. The
note intake (outside this sandbox) checks everything again and writes <sha>.<didhash>.json, the
note status. Nothing here decodes, unpacks or runs what was brought.
note ohtx: a text/plain answer
fn ohtx t view uchar * to void
put fobl 0 0
put fkind 0 1
fsetct totxt
fput t
end
fn ohnext n ulong to void
ohtx tonext
fnum n
fputc 10
end
note ohpre: the text answer for a status of the write gate (sowpre)
fn ohpre r long to void
if eq r 429
ohtx tom429
ret
end
if eq r 503
ohtx tom503
ret
end
if eq r 403
ohtx tom403
ret
end
ohtx tom400
end
note ohfb: ffile = <data>open/ then t
fn ohfb t view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for i ulong len todir bound 16
ffilc get todir i
end
for i ulong len t bound 16
ffilc get t i
end
end
note ohupf: ffile = <data>open/up/<sha>.<didhash> then ext
fn ohupf ext view uchar * to void
ohfb toupdir
for i ulong 64
ffilc get gosha i
end
ffilc 46
for i ulong 16
ffilc get godh i
end
for i ulong len ext bound 16
ffilc get ext i
end
end
note ohupmk: <data>open/ and <data>open/up/ exist (made 0700)
fn ohupmk to void
ohfb toupdir
put ffilel 0 sub get ffilel 0 len toupdir
r = makedir ffile 0 get ffilel 0 448
ohfb toupdir
r = makedir ffile 0 get ffilel 0 448
end
fn ohhex c uchar to bool
ret or and ge c 48 le c 57 and ge c 97 le c 102
end
fn ohb64c c uchar to bool
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
ret or eq c 45 eq c 95
end
fn ohws c uchar to bool
ret or or eq c 32 eq c 10 or eq c 9 eq c 13
end
fn ohsigc c uchar to bool
if ohb64c c
ret true
end
ret or or eq c 43 eq c 47 or or eq c 61 eq c 32 eq c 10
end
note ohsha: the form value gcfv[0, n) is 64 lowercase hex: into gosha
fn ohsha n long to bool
if ne n 64
ret false
end
for i ulong 64
c = get gcfv i
if not ohhex c
ret false
end
put gosha i c
end
ret true
end
note ohdec: gcfv[0, n) as a decimal number of 1 to 18 digits; -1 when it is not one
fn ohdec n long to long
if or lt n 1 gt n 18
ret -1
end
v = long 0
for i ulong ulong n bound 18
c = get gcfv i
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 long sub c 48
end
ret v
end
note ohname: gcfv[0, n) is a project name of the contract: 1 to 64 bytes of [a-z0-9-], no '-'
note first, last or twice in a row (what the tool makes of a folder name): into goname
fn ohname n long to bool
if or lt n 1 gt n 64
ret false
end
p = uchar 45
for i ulong ulong n bound 64
c = get gcfv i
ok = or and ge c 97 le c 122 and ge c 48 le c 57
if eq c 45
if eq p 45
ret false
end
ok = true
end
if not ok
ret false
end
put goname i c
p = c
end
if eq p 45
ret false
end
put gonamel 0 ulong n
ret true
end
note ohsig: gcfv[0, n) is an armored SSH signature (its BEGIN and END lines, base64 and line feeds
note between; white space around it is dropped): into gosig with one line feed at the end
fn ohsig n long to bool
if lt n 1
ret false
end
a = ulong 0
b = ulong n
for i ulong ulong n bound 65536
if not ohws get gcfv a
break
end
a = add a 1
end
for i ulong ulong n bound 65536
if le b a
break
end
if not ohws get gcfv sub b 1
break
end
b = sub b 1
end
k = sub b a
if lt k add len tosgb len tosge
ret false
end
for i ulong len tosgb
if ne get gcfv add a i get tosgb i
ret false
end
end
for i ulong len tosge
if ne get gcfv add sub b len tosge i get tosge i
ret false
end
end
for i ulong k bound 65536
c = get gcfv add a i
if not ohsigc c
ret false
end
put gosig i c
end
put gosig k 10
put gosigl 0 add k 1
ret true
end
note ohdh: godh = hex of the first 8 bytes of sha256(godid)
fn ohdh to void
m = new uchar 96 0
o = new uchar 32 0
n = get godidl 0
for i ulong n bound 96
put m i get godid i
end
k = sha2_digest 256 part m 0 n o
for i ulong 8
c = get o i
put godh mul i 2 get tohex ulong shr c 4
put godh add mul i 2 1 get tohex ulong and c 15
end
end
fn ohsize fd int to long
st = new uchar 128 0
r = fstat fd st 0 128
if ne r 0
ret -1
end
sz = ulong 0
for i ulong 8
sz = or sz shl ulong get st add 48 i mul i 8
end
ret long sz
end
note ohtail: the next seq and the total so far of the spool fd of size sz into gonx; false when the
note file does not end in a well-formed record
fn ohtail fd int sz ulong to bool
put gonx 0 0
put gonx 1 0
if eq sz 0
ret true
end
if lt sz 45
ret false
end
b = new uchar 42 0
k = pread fd b 0 42 long sub sz 42
if ne k 42
ret false
end
if or ne get b 20 9 ne get b 41 10
ret false
end
s = ulong 0
t = ulong 0
for i ulong 20
c = get b i
d = get b add i 21
if or or lt c 48 gt c 57 or lt d 48 gt d 57
ret false
end
if or gt s 999999999999999999 gt t 999999999999999999
ret false
end
s = add mul s 10 ulong sub c 48
t = add mul t 10 ulong sub d 48
end
put gonx 0 add s 1
put gonx 1 t
ret true
end
note oh20: v as 20 decimal digits at b[o]: every ulong fits (2^64 - 1 has 20), so the running
note total of a spool never wraps (it was 10 digits, which wrapped at 10^10 bytes)
fn oh20 b edit uchar * o ulong v ulong to void
x = v
for i ulong 20
put b sub add o 19 i uchar add 48 rem x 10
x = div x 10
end
end
fn ohexist to bool
ret eq faccess ffile 0 get ffilel 0 0 0
end
note ohchunk: action=chunk. 409 "next <n>" when seq is not the next one (or the upload is finished),
note 503 when the chunk would take the data filesystem below its reserve (ohroom) or the spool
note cannot be written. There is no size limit and no 413: the data reserve bounds the spool.
fn ohchunk to long
seq = ohdec slgetform tofseq
if lt seq 0
ohtx tom400
ret 400
end
m = slgetform tofdata
if or lt m 2 gt m 60000
ohtx tom400
ret 400
end
if eq rem m 4 1
ohtx tom400
ret 400
end
for i ulong ulong m bound 60000
if not ohb64c get gcfv i
ohtx tom400
ret 400
end
end
rm = ohroom add ulong m 43
if ne rm 0
ohnoroom rm
ret 503
end
r4 = rem ulong m 4
dec = mul div ulong m 4 3
if gt r4 0
dec = add dec sub r4 1
end
ohupmk
ohupf tob64
fl = int 558082
if eq seq 0
fl = int 558146
end
fd = fopen ffile 0 get ffilel 0 fl 384
if lt fd 0
if gt seq 0
ohnext 0
ret 409
end
ohtx tom503
ret 503
end
r = ohchunk2 int fd ulong seq ulong m dec
x = fclose int fd
ret r
end
fn ohchunk2 fd int seq ulong m ulong dec ulong to long
sz = ohsize fd
if lt sz 0
ohtx tom503
ret 503
end
if not ohtail fd ulong sz
ohtx tom503
ret 503
end
nx = get gonx 0
ohupf tosig
if ohexist
ohnext nx
ret 409
end
if ne seq nx
ohnext nx
ret 409
end
tot = add get gonx 1 dec
if eq seq 0
ohupf toejs
r = unlink ffile 0 get ffilel 0
end
b = new uchar 60048 0
for i ulong m bound 60000
put b i get gcfv i
end
put b m 9
oh20 b add m 1 seq
put b add m 21 9
oh20 b add m 22 tot
put b add m 42 10
w = write fd b 0 add m 43
if ne w long add m 43
r = ftrunc fd sz
ohtx tom503
ret 503
end
ohused add m 43
ohnext add seq 1
ret 200
end
note ohqnum: v in decimal at b[o]; the index after it
fn ohqnum b edit uchar * o ulong v ulong to ulong
d = new uchar 20 0
k = ulong 0
x = v
if eq x 0
put d 0 48
k = ulong 1
end
while gt x 0 bound 20
put d k uchar add 48 rem x 10
x = div x 10
k = add k 1
end
for i ulong k bound 20
put b add o i get d sub sub k 1 i
end
ret add o k
end
note ohqup: the queue line U <tab> sha <tab> did <tab> files <tab> bytes <tab> name <tab> note;
note 0 done, else 503 (the queue's 1 MiB cap, as for B and W lines)
fn ohqup files ulong byt ulong to long
b = new uchar 640 0
ohfb toq
fd = fopen ffile 0 get ffilel 0 558145 384
if lt fd 0
ret 503
end
note the size first: a short write (a full disk) is cut back to it, so no fragment joins the next line
sz = ohsize int fd
put b 0 85
put b 1 9
for i ulong 64
put b add 2 i get gosha i
end
put b 66 9
n = ulong 67
for i ulong get godidl 0 bound 96
put b add n i get godid i
end
n = add n get godidl 0
put b n 9
n = ohqnum b add n 1 files
put b n 9
n = ohqnum b add n 1 byt
put b n 9
n = add n 1
for i ulong get gonamel 0 bound 64
put b add n i get goname i
end
n = add n get gonamel 0
put b n 9
n = add n 1
for i ulong get gonotel 0 bound 200
put b add n i get gonote i
end
n = add n get gonotel 0
put b n 10
n = add n 1
w = write int fd b 0 n
if ne w long n
if ge sz 0
r = ftrunc int fd sz
end
x = fclose int fd
ret 503
end
x = fclose int fd
ohused n
ret 0
end
fn ohqd to void
ohtx toqd
for i ulong 64
fputc get gosha i
end
fputc 10
end
note ohfin: action=finish. The chunks must add up to bytes (fewer: 409 "next <n>"). A finish that
note was already queued answers "queued" again and queues nothing.
fn ohfin to long
if not slffeq tocons toyes
ohtx tom400
ret 400
end
files = ohdec slgetform toffile
byt = ohdec slgetform tofbyte
if or lt files 0 lt byt 1
ohtx tom400
ret 400
end
if not ohname slgetform tofname
ohtx tom400
ret 400
end
put gonotel 0 0
n = slgetform tonote
if ge n 0
if not ohnote ulong n
ohtx tom400
ret 400
end
end
if not ohsig slgetform tofsig
ohtx tom400
ret 400
end
ohupf tob64
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ohtx tom404
ret 404
end
sz = ohsize int fd
ok = false
if gt sz 0
ok = ohtail int fd ulong sz
end
x = fclose int fd
if not ok
ohtx tom503
ret 503
end
ret ohfin2 ulong files ulong byt
end
fn ohfin2 files ulong byt ulong to long
tot = get gonx 1
if lt tot byt
ohnext get gonx 0
ret 409
end
if gt tot byt
ohtx tom400
ret 400
end
ohupf tosig
if ohexist
ohqd
ret 200
end
rm = ohroom add get gosigl 0 640
if ne rm 0
ohnoroom rm
ret 503
end
ohupf tosig
fd = fopen ffile 0 get ffilel 0 557249 384
if lt fd 0
ohtx tom503
ret 503
end
w = write int fd gosig 0 get gosigl 0
ohused get gosigl 0
x = fclose int fd
if ne w long get gosigl 0
r = unlink ffile 0 get ffilel 0
ohtx tom503
ret 503
end
r = ohqup files byt
if ne r 0
ohupf tosig
r = unlink ffile 0 get ffilel 0
ohtx tom503
ret 503
end
ohqd
ret 200
end
note ohup: POST <base>open/up. Signed out is 403 here (the tool reads a status, not a page); then
note the forge write gate (CSRF, the per-IP and per-key write limits, the store), unchanged.
fn ohup to long
if ne get fmeth 0 3
ret 405
end
if eq get gscur 0 0
ohtx tom403
ret 403
end
r = sowpre
if ne r 0
ohpre r
ret r
end
soratev get gscur 0 get gsnow 0
if not slformvalid
ohtx tom400
ret 400
end
if ne slgetform tsfcsrf 32
ohtx tom403
ret 403
end
put godidl 0 0
if not ohdid
ohtx tom403
ret 403
end
if not ohsha slgetform tofsha
ohtx tom400
ret 400
end
ohdh
if slffeq toact tofchnk
ret ohchunk
end
if slffeq toact toffin
ret ohfin
end
ohtx tom400
ret 400
end
fn ohust t view uchar * to void
put fobl 0 0
put fkind 0 1
fsetct toctj
fput tous1
fput t
fput tous2
end
note ohupst: GET <base>open/up/<sha>.json for the signed-in key: the intake's status file when there
note is one (stored or refused), else queued (finished) or receiving (chunks only); 404 for none
fn ohupst to long
if not fget
ret 405
end
a = len toupd
if ne get fpathl 0 add a 69
ret 404
end
for i ulong 64
c = fpathat add a i
if not ohhex c
ret 404
end
put gosha i c
end
for i ulong 5
if ne fpathat add add a 64 i get toejs i
ret 404
end
end
put godidl 0 0
if not ohdid
ohtx tom403
ret 403
end
ohdh
ohupf toejs
if ohexist
put fkind 0 3
fsetct toctj
ret 200
end
ohupf tosig
if ohexist
ohust toqueue
ret 200
end
ohupf tob64
if ohexist
ohust torecv
ret 200
end
ohtx tom404
ret 404
end
note ---- get: <base>open/<rid>.tar, the snapshot the intake wrote for a shelf row
fn ohistar to bool
n = get fpathl 0
a = len topath
if le n add a 4
ret false
end
for i ulong 4
if ne fpathat add sub n 4 i get totar i
ret false
end
end
ret true
end
note ohaf: ffile = <data>open/a/<gorid> then ext
fn ohaf ext view uchar * to void
ohfb toadir
for i ulong get goridl 0 bound 44
ffilc get gorid i
end
for i ulong len ext bound 16
ffilc get ext i
end
end
note ohcdn: Content-Disposition attachment; filename="<name>.tar" from the row's name: lowercase
note letters and digits kept, every other run of bytes one '-', "project" when nothing is left
fn ohnamec c uchar to bool
ret or and ge c 97 le c 122 and ge c 48 le c 57
end
fn ohcdn s ulong e ulong to void
w = new uchar 64 0
a = ohfld s e 5
b = ohfe a e
k = ulong 0
i = a
while and lt i b lt k 64 bound 262144
c = get gol i
if and ge c 65 le c 90
c = uchar add c 32
end
if not ohnamec c
c = uchar 45
end
if eq c 45
if gt k 0
if ne get w sub k 1 45
put w k c
k = add k 1
end
end
else
put w k c
k = add k 1
end
i = add i 1
end
if gt k 0
if eq get w sub k 1 45
k = sub k 1
end
end
fsetcd tocda
if eq k 0
for j ulong len toproj
fcdc get toproj j
end
end
for j ulong k bound 64
fcdc get w j
end
for j ulong len totar
fcdc get totar j
end
fcdc 34
end
fn ohtar to long
if not fget
ret 405
end
a = len topath
n = sub sub get fpathl 0 a 4
if or lt n 20 gt n 44
ret 404
end
for i ulong n bound 44
c = fpathat add a i
if not ohb58 c
ret 404
end
put gorid i c
end
if ne get gorid 0 122
ret 404
end
put goridl 0 n
if not ohprow
ret 404
end
s = ulong 0
e = get goll 0
ohaf totar
put fkind 0 3
fsetct totarct
ohcdn s e
ret 200
end
note ohdlsha: the snapshot <data>open/a/<gorid>.tar exists and <gorid>.sha256 holds 64 hex: into h
fn ohdlsha h edit uchar 64 to bool
ohaf totar
if not ohexist
ret false
end
ohaf tosha
fd = fopen ffile 0 get ffilel 0 557056 0
if lt fd 0
ret false
end
k = read int fd h 0 64
x = fclose int fd
if ne k 64
ret false
end
for i ulong 64
if not ohhex get h i
ret false
end
end
ret true
end
note ohdlj: the JSON fields stored_by_hub, download and download_sha256 of the row s..e
fn ohdlj s ulong e ulong to void
fput tosbh1
if ohis s e 1 tostor
fput totrue
else
fput tofalse
end
b = ohfe s e
n = sub b s
if or lt n 20 gt n 44
fput todl0
ret
end
for i ulong n bound 44
put gorid i get gol add s i
end
put goridl 0 n
h = new uchar 64 0
if not ohdlsha h
fput todl0
ret
end
fput todl1
fputb
fput todir
for i ulong n bound 44
fputc get gorid i
end
fput todl2
for i ulong 64
fputc get h i
end
fputc 34
end
note ---- files the intake and the operator leave for forged to serve as they are
fn ohtool name view uchar * to long
if not fget
ret 405
end
ohfb totools
for i ulong len name bound 16
ffilc get name i
end
put fkind 0 3
fsetct totxt
ret 200
end
fn ohalarm to long
if not fget
ret 405
end
ohfb toalf
put fkind 0 3
fsetct toctj
ret 200
end

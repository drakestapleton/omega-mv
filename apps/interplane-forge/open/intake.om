put avals 5 aseed
put avals 6 dfree 0
put avol 6 rsvget 0
put avals 8 dfree 1
put avol 8 rsvget 1
put avol 9 get avals 9
put obl 0 0
aall false
if gt get obl 0 0
w = write 2 kaprefix 0 len kaprefix
w = write 2 ob 0 get obl 0
end
wpath kalarms
ok = wr
put obl 0 0
emt kaj1
aall true
emt kaj7
if pinopen
rname kajson
ok = wr
unpin
end
aspace get avals 8
end
note aspace: <open dir>space, what forged reads before it writes under open/: "free <bytes> reserve
note <bytes> at <ns>" for the open dir's filesystem. Advisory for forged; the intake checks again.
fn aspace fb ulong to void
put obl 0 0
emt kspfree
emn fb
emt kspres
emn rsvget 1
emt kspat
emn ulong realns
emb 10

for i ulong add n 1 bound 256
c = uchar 47
if lt i n
c = get uname i
if or lt c 32 eq c 127
ret false
end
end
if eq c 47
k = sub i a
if eq k 0
ret false
end
if eq k 1
if eq get uname a 46
ret false
end
end
if eq k 2
if and eq get uname a 46 eq get uname add a 1 46
ret false
end
end
if eq k 4
if eq get uname a 46
if and and eq ulower get uname add a 1 103 eq ulower get uname add a 2 105 eq ulower get uname add a 3 116
put uerr 0 3
ret false
end
end
end
a = add i 1
end
end
if gt get uprevl 0 0
cmp = long 0
m = get uprevl 0
for i ulong n bound 255
if ge i m
cmp = long 1
break
end
if ne get uname i get uprev i
cmp = sub long get uname i long get uprev i
break
end
end
if le cmp 0
ret false
end
end
for i ulong n bound 255
put uprev i get uname i
end
put uprevl 0 n
ret true
end
fn ulower c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end
fn uheader to long
if not uzero 500 12
ret -1
end
if or ne get uhdr 156 48 not uzero 157 100
ret -1
end
if not uzero 265 64
ret -1
end
if not uzero 329 16
ret -1
end

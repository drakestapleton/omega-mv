ret -1
end
if ne uoct 136 12 0
ret -1
end
mode = uoct 100 8
if not or eq mode 420 eq mode 493
ret -1
end
if or or ne get uhdr 257 117 ne get uhdr 258 115 or ne get uhdr 259 116 ne get uhdr 260 97
ret -1
end
if or or ne get uhdr 261 114 ne get uhdr 262 0 or ne get uhdr 263 48 ne get uhdr 264 48
ret -1
end
sum = ulong 0
for i ulong 512
c = get uhdr i
if and ge i 148 lt i 156
c = uchar 32
end
sum = add sum ulong c
end
if ne get uhdr 154 0
ret -1
end
if ne get uhdr 155 32
ret -1
end
cs = ulong 0
for i ulong 6
c = get uhdr add 148 i
if or lt c 48 gt c 55
ret -1
end
cs = add mul cs 8 ulong sub c 48
end
if ne cs sum
ret -1

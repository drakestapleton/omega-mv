fn b58 c uchar to bool
for i ulong len kb58 bound 64
if eq get kb58 i c
ret true
end
end
ret false
end
note sbz / sbt / sbg: the scratch string: empty it, append a text, append the rid
fn sbz to void
put sbl 0 0
end
fn sbc c uchar to void
o = get sbl 0
if lt o 1099
put sb o c
put sbl 0 add o 1
end
end
fn sbt t view uchar * to void
for i ulong len t bound 256
sbc get t i
end
end
fn sbrid to void
for i ulong get ridl 0 bound 44
sbc get rid i
end
end
fn sbhome to void
for i ulong get hdl 0 bound 256
sbc get hd i
end
end
fn sbstore to void
for i ulong get sdl 0 bound 512
sbc get sd i
end
sbrid
end
note ---- the packed argument list (u16 count, then per record a u16 length and the bytes)
fn pknew to void
put pkn 0 2
put pk 0 0
put pk 1 0
end
fn pkrec n ulong to ulong
o = get pkn 0
put pk o uchar and n 255
put pk add o 1 uchar shr n 8
put pk 0 uchar add get pk 0 1
ret add o 2
end
fn pkt t view uchar * to void
n = len t
o = pkrec n
for i ulong n bound 256
put pk add o i get t i
end
put pkn 0 add o n
end
note pks: the scratch string as one argument
fn pks to void
n = get sbl 0
o = pkrec n
for i ulong n bound 1100
put pk add o i get sb i
end
put pkn 0 add o n
end
note pkrad: env -i HOME=<home> PATH=<home>/.local/bin:/usr/bin:/bin <home>/.local/bin/rad
fn pkrad to void
pknew
pkt kenv
pkt kdashi
sbz
sbt khome
sbhome
pks
sbz
sbt kpath
sbhome
sbt kpath2
pks
sbz
sbhome
sbt krad
pks
end
fn pkridarg to void
sbz
sbt kradp
sbrid
pks
end
note wpath: pth = work dir + name
fn wpath name view uchar * to void
n = get wdl 0
for i ulong n bound 512
put pth i get wd i
end
for i ulong len name bound 16
put pth add n i get name i
end
put pthl 0 add n len name
end
note ---- the open dir belongs to forged (its sandbox can write it), so every write, rename and
note unlink this program makes there, and in its up/, a/ and p/, goes through a folder this program
note opened itself with O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC (573440) and made its working directory
note (fchdir), and then names only a file inside it. A link planted for the open dir or one of those
note folders is refused: nothing is written. A link planted for a file is replaced by the rename of
note wr (temp file O_EXCL|O_NOFOLLOW, then rename), never followed. unpin returns to "/"; every
note program this one starts runs in "/".
fn pinopen to bool
r = chdir kroot 0 1
n = get odl 0
if lt n 2
ret false
end
fd = fopen od 0 sub n 1 573440 0
if lt fd 0
ret false
end
r = fchdir int fd
x = fclose int fd
if ne r 0
unpin
ret false
end
ret true
end
note pinsub: pin the open dir, then its folder dn (made first when mk)
fn pinsub dn view uchar * mk bool to bool
if not pinopen
ret false
end
if mk
r = makedir dn 0 len dn 448
end
fd = fopen dn 0 len dn 573440 0
if lt fd 0
unpin
ret false
end
r = fchdir int fd
x = fclose int fd
if ne r 0
unpin
ret false
end
ret true
end
fn unpin to void
r = chdir kroot 0 1
end
note ropen: open pth, a file forged can plant, for reading: O_NONBLOCK (a FIFO does not wait for a
note writer), O_NOFOLLOW, O_CLOEXEC (559104); -1 unless fstat says it is a regular file, so a FIFO,
note device or folder planted as the queue or a spool file is skipped and the pass goes on
fn ropen to long
fd = fopen pth 0 get pthl 0 559104 0
if lt fd 0
ret -1
end
if not uisreg int fd
x = fclose int fd
ret -1
end
ret fd
end
fn uisreg fd int to bool
st = new uchar 128 0
r = fstat fd st 0 128
if ne r 0
ret false
end
m = or ulong get st 16 shl ulong get st 17 8
ret eq and m 61440 32768
end
note rname: pth = name, a file in the pinned folder
fn rname name view uchar * to void
for i ulong len name bound 32
put pth i get name i
end
put pthl 0 len name
end
note child: stdin from /dev/null, stdout to <work>out, stderr to /dev/null, then the program
fn child to void
a = new uchar 4096 0
r = setpgid 0 0
r = chdir kroot 0 1
fd = long -1
if eq get ustdin 0 0
fd = fopen knull 0 len knull 524288 0
else
wpath kuinput
fd = fopen pth 0 get pthl 0 557056 0
end
if lt fd 0
exit 121
end
r = dupfd int fd 0 0
x = fclose int fd
if ne get upiped 0 0
r = dupfd int get upipew 0 1 0
else
wpath kout
r = unlink pth 0 get pthl 0
fd = fopen pth 0 get pthl 0 557249 384
if lt fd 0
exit 123
end
r = dupfd int fd 1 0
x = fclose int fd
end
fd = fopen knull 0 len knull 524289 0
if lt fd 0
exit 125
end
r = dupfd int fd 2 0
x = fclose int fd
n = get pkn 0
for i ulong n bound 4096
put a i get pk i
end
r = execprog a 0 n
exit 127
end
note run: the packed command with a deadline in seconds. True when it exited 0. Its stdout is in cb.
fn run secs ulong to bool
st = new uchar 4 0
put cbl 0 0
pid = fork
if lt pid 0
ret false
end
if eq pid 0
child
exit 127
end
r = setpgid int pid int pid
ok = false
for i ulong mul secs 100 bound 12000
r = waitpid int pid st 0 4 1
if eq r pid
ok = true
break
end
if lt r 0
break
end
r = sleepns 10000000
end
if not ok
r = killpid int neg pid 9
r = killpid int pid 9
for i ulong 200
r = waitpid int pid st 0 4 1
if ne r 0
break
end
r = sleepns 10000000
end
ret false
end
for i ulong 4
if ne get st i 0
ret false
end
end
wpath kout
fd = fopen pth 0 get pthl 0 557056 0
if lt fd 0
ret true
end
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read int fd cb n sub 65535 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put cbl 0 n
ret true
end
note ---- the commands
fn doseed to bool
pkrad
pkt kseed
pkridarg
pkt kscope
pkt kall
pkt kfetch
ret run 90
end
fn dounseed to void
pkrad
pkt kunseed
pkridarg
ok = run 30
end
fn dopayload to bool
pkrad
pkt kinspect
pkridarg
pkt kpayload
ret run 30
end
note dovis: rad inspect <rid> --visibility says public
fn dovis to bool
pkrad
pkt kinspect
pkridarg
pkt kvis
if not run 30
ret false
end
if lt get cbl 0 len kpub
ret false
end
for i ulong len kpub bound 16
if ne get cb i get kpub i
ret false
end
end
ret true
end
note delat: the current did starts a line of the command output at i and ends there (the output
note of rad inspect --delegates is one "did:key:... (alias)" a line), so a key that is only the
note start of a longer one never matches
fn delat i ulong to bool
m = get didl 0
n = get cbl 0
if gt add i m n
ret false
end
if gt i 0
if ne get cb sub i 1 10
ret false
end
end
for k ulong m bound 96
if ne get cb add i k get did k
ret false
end
end
e = add i m
if eq e n
ret true
end
c = get cb e
if eq c 32
ret true
end
if eq c 10
ret true
end
ret eq c 13
end
note dodel: 1 when rad inspect <rid> --delegates lists the current did, 0 when it does not, 2 when
note the node did not answer
fn dodel to ulong
if eq get didl 0 0
ret 0
end
pkrad
pkt kinspect
pkridarg
pkt kdel
if not run 30
ret 2
end
n = get cbl 0
put adelmax 0 amax get adelmax 0 n
if ge n 65535
ret 2
end
i = ulong 0
while lt i n bound 65536
if delat i
ret 1
end
i = add i 1
end
ret 0
end
fn dodu to bool
pknew
pkt kdu
pkt ksk
sbz
sbstore
pks
if not run 30
ret false
end
v = ulong 0
n = get cbl 0
i = ulong 0
while lt i n bound 24
c = get cb i
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
put kb 0 v
ret gt i 0
end
fn dodate to void
put dtl 0 0
pknew
pkt kdate
pkt ku
pkt kfmt
if not run 10
ret
end
n = get cbl 0
if lt n 10
ret
end
for i ulong 10
c = get cb i
ok = false
if and ge c 48 le c 57
ok = true
end
if eq c 45
ok = true
end
if not ok
ret
end
put dt i c
end
put dtl 0 10
end
note dorm: remove the storage folder of the current rid. Callers have checked that this program
note brought it.
fn dorm to void
pknew
pkt krm
pkt krf
pkt kdd
sbz
sbstore
pks
ok = run 60
end
fn stored to bool
sbz
sbstore
ret eq faccess sb 0 get sbl 0 0 0
end
note jget: the string value of key t in the command output, sanitized, at most cap bytes, into
note nm (which 0) or ds (which 1). An escape becomes a space, a control byte a space.
note uin: lo <= c <= hi
fn uin c uchar lo uchar hi uchar to bool
ret and ge c lo le c hi
end
note uvalid: the length of the well-formed UTF-8 character at ub[i], or 0 (RFC 3629: no overlong
note form, no surrogate, nothing past U+10FFFF). The same rule as research/agent.om.
fn uvalid i ulong to ulong
n = get ubl 0
c = get ub i
if lt c 128
ret 1
end
if uin c 194 223
if lt add i 1 n
if uin get ub add i 1 128 191
ret 2
end
end
ret 0
end
lo = uchar 128
hi = uchar 191
if uin c 224 239
if eq c 224
lo = uchar 160
end
if eq c 237
hi = uchar 159
end
if lt add i 2 n
if and uin get ub add i 1 lo hi uin get ub add i 2 128 191
ret 3
end
end
ret 0
end
if uin c 240 244
if eq c 240
lo = uchar 144
end
if eq c 244
hi = uchar 143
end
if lt add i 3 n
if and and uin get ub add i 1 lo hi uin get ub add i 2 128 191 uin get ub add i 3 128 191
ret 4
end
end
end
ret 0
end
note usan: every byte of ub that does not start a well-formed UTF-8 character becomes "?". A name
note or description cut at its cap can end inside a character; the list and its JSON stay UTF-8.
fn usan to void
n = get ubl 0
i = ulong 0
while lt i n bound 408
k = uvalid i
if eq k 0
put ub i 63
i = add i 1
else
i = add i k
end
end
end
fn usnm to void
n = get nml 0
for i ulong n bound 120
put ub i get nm i
end
put ubl 0 n
usan
for i ulong n bound 120
put nm i get ub i
end
end
fn usds to void
n = get dsl 0
for i ulong n bound 400
put ub i get ds i
end
put ubl 0 n
usan
for i ulong n bound 400
put ds i get ub i
end
end
fn usnt to void
n = get ntl 0
for i ulong n bound 200
put ub i get nt i
end
put ubl 0 n
usan
for i ulong n bound 200
put nt i get ub i
end
end
note policy: does the node's seeding policy list (rad seed without a rid) name the current rid?
note 0 no, 1 yes, 2 the node did not answer or the list did not fit. A bring goes on only at 0, so
note it never rewrites the scope of a policy the owner set, and a failed fetch never unseeds one.
note rmatch: the rid is the first column of a row: "rad:" then the rid at the start of a line, or
note after the table's left border and one space ("│ rad:", the border is E2 94 82), and followed
note by a space, tab, CR, LF or the end of the output; so a longer rid, or a project name that
note holds the rid's text, never matches
fn rmatch i ulong to bool
n = get ridl 0
lim = get cbl 0
if lt i 4
ret false
end
s = sub i 4
if ne get cb s 114
ret false
end
if ne get cb add s 1 97
ret false
end
if ne get cb add s 2 100
ret false
end
if ne get cb add s 3 58
ret false
end
st = false
if eq s 0
st = true
else
if eq get cb sub s 1 10
st = true
end
end
if not st
if ge s 4
if eq get cb sub s 1 32
if eq get cb sub s 2 130
if eq get cb sub s 3 148
if eq get cb sub s 4 226
if eq s 4
st = true
else
st = eq get cb sub s 5 10
end
end
end
end
end
end
end
if not st
ret false
end
for k ulong n bound 44
if ne get cb add i k get rid k
ret false
end
end
e = add i n
if ge e lim
ret true
end
c = get cb e
if eq c 32
ret true
end
if eq c 9
ret true
end
if eq c 13
ret true
end
ret eq c 10
end
fn policy to ulong
pkrad
pkt kseed
if not run 30
ret 2
end
n = get cbl 0
if ge n 65535
ret 2
end
m = get ridl 0
i = ulong 0
while le add i m n bound 65536
if rmatch i
ret 1
end
i = add i 1
end
ret 0
end
fn jput which ulong o ulong c uchar to void
if eq which 0
put nm o c
else
put ds o c
end
end
fn jmatch t view uchar * i ulong to bool
for k ulong len t bound 16
if ne get cb add i k get t k
ret false
end
end
ret true
end
fn jfind t view uchar * to ulong
n = get cbl 0
m = len t
i = ulong 0
while lt add i m n bound 65536
if jmatch t i
ret add i m
end
i = add i 1
end
ret n
end
fn jget t view uchar * which ulong cap ulong to ulong
n = get cbl 0
p = jfind t
while lt p n bound 65536
if eq get cb p 34
break
end
p = add p 1
end
if ge p n
ret 0
end
p = add p 1
o = ulong 0
while lt p n bound 65536
c = get cb p
if eq c 34
break
end
if eq c 92
p = add p 1
c = uchar 32
end
if or lt c 32 eq c 127
c = uchar 32
end
if lt o cap
jput which o c
o = add o 1
end
p = add p 1
end
ret o
end
note ---- the private list.tsv in lb
fn lload to void
put lbl 0 0
wpath klist
fd = fopen pth 0 get pthl 0 557056 0
if lt fd 0
ret
end
m = ulong 0
k = long 1
while gt k 0 bound 262144
k = read int fd lb m sub 262143 m
if gt k 0
m = add m ulong k
end
end
x = fclose int fd
put lbl 0 m
end
fn leol a ulong to ulong
lim = get lbl 0
i = a
while lt i lim bound 262144
if eq get lb i 10
ret i
end
i = add i 1
end
ret lim
end
note lfe: the end of the field that starts at a in the row ending at e
fn lfe a ulong e ulong to ulong
p = a
while lt p e bound 262144
if eq get lb p 9
ret p
end
p = add p 1
end
ret e
end
note lfld: start of field k of the row s..e
fn lfld s ulong e ulong k ulong to ulong
p = s
j = ulong 0
while lt j k bound 8
p = lfe p e
if lt p e
p = add p 1
end
j = add j 1
end
ret p
end
note lisrid: the row's first field is the current rid
fn lisrid s ulong e ulong to bool
b = lfe s e
n = get ridl 0
if ne sub b s n
ret false
end
for i ulong n bound 44
if ne get lb add s i get rid i
ret false
end
end
ret true
end
fn lisopen s ulong e ulong to bool
a = lfld s e 1
b = lfe a e
if ne sub b a len kopen
ret false
end
for i ulong len kopen
if ne get lb add a i get kopen i
ret false
end
end
ret true
end
note lisdid: the row's did (field 2) is the current did
fn lisdid s ulong e ulong to bool
a = lfld s e 2
b = lfe a e
n = get didl 0
if ne sub b a n
ret false
end
for i ulong n bound 96
if ne get lb add a i get did i
ret false
end
end
ret true
end
note lfind: the start of the row of the current rid, or lbl
fn lfind to ulong
lim = get lbl 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if lisrid s e
ret s
end
s = add e 1
end
ret lim
end
note lstate: the state (field 1) of the row s..e is t
fn lstate s ulong e ulong t view uchar * to bool
a = lfld s e 1
b = lfe a e
if ne sub b a len t
ret false
end
for i ulong len t bound 128
if ne get lb add a i get t i
ret false
end
end
ret true
end
note lfailed: the private list says this program's own fetch of the current rid failed (not found
note or over the size limit). A storage folder found for it then is that fetch's leftover (the
note node can finish a fetch after rad was stopped at its deadline), not a repository of the owner.
fn lfailed to bool
s = lfind
if ge s get lbl 0
ret false
end
e = leol s
if lstate s e kr4
ret true
end
ret lstate s e kfull
end
note lfits: one more row (at most 900 bytes: rid 44, did 96, date, kilobytes, name 120, description
note 400, note 200, tabs) still fits what lload reads back (262,143 bytes). A real buffer bound of
note this program until Omega has run-time memory (list_bytes alarms at 80 percent of it).
fn lfits to bool
ret le add get lbl 0 900 262143
end
note lpub: the row is on the shelf: open (this program fetched the project) or held (the node
note already had it; the row only lists it)
fn lpub s ulong e ulong to bool
if lisopen s e
ret true
end
if lstate s e kustored
ret true
end
ret lstate s e kheld
end
note lcount: rows on the shelf (open or held); mine true counts only the current did's rows in
note state open, the projects this program fetched for that key (a held row costs no fetch or disk)
fn lcount mine bool to ulong
lim = get lbl 0
n = ulong 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if lpub s e
if mine
if lowned s e
if lisdid s e
n = add n 1
end
end
else
n = add n 1
end
end
s = add e 1
end
ret n
end
note ---- writing the new list
fn emb c uchar to void
o = get obl 0
if lt o 524288
put ob o c
put obl 0 add o 1
end
end
fn emt t view uchar * to void
for i ulong len t bound 256
emb get t i
end
end
fn emn v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
if eq x 0
emb 48
end
while gt x 0 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
end
while gt n 0 bound 20
n = sub n 1
emb get d n
end
end
note keep: every row but the current rid's into ob. Rows that are not open (refusals, withdrawals)
note share a budget of 65,536 bytes (held rows count as open here); the oldest of them are dropped first, so a key that is not
note invited cannot grow the list past what lload reads (262,143 bytes) and push out the rows of
note projects this program brought. Open rows are never dropped: at most 200, 887 bytes each.
fn keep to void
lim = get lbl 0
put obl 0 0
t = ulong 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if and gt e s not lisrid s e
if not lpub s e
t = add t add sub e s 1
end
end
s = add e 1
end
drop = ulong 0
if gt t 65536
drop = sub t 65536
end
s = ulong 0
while lt s lim bound 262144
e = leol s
if and gt e s not lisrid s e
skip = false
if gt drop 0
if not lpub s e
skip = true
d = add sub e s 1
if gt d drop
drop = ulong 0
else
drop = sub drop d
end
end
end
if not skip
i = s
while lt i e bound 262144
emb get lb i
i = add i 1
end
emb 10
end
end
s = add e 1
end
end
note rowhead: rid, state, did, date for the current request
fn rowhead state view uchar * to void
for i ulong get ridl 0 bound 44
emb get rid i
end
emb 9
emt state
emb 9
for i ulong get didl 0 bound 96
emb get did i
end
emb 9
for i ulong get dtl 0 bound 10
emb get dt i
end
emb 9
end
note rowtail: kilobytes, name, description, note
fn rowtail to void
emn get kb 0
emb 9
for i ulong get nml 0 bound 120
emb get nm i
end
emb 9
for i ulong get dsl 0 bound 400
emb get ds i
end
emb 9
for i ulong get ntl 0 bound 200
emb get nt i
end
emb 10
end
note wr: write ob to pth + ".tmp", sync, rename onto pth
fn wr to bool
n = get pthl 0
for i ulong n bound 1100
put pt2 i get pth i
end
for i ulong len kxt
put pt2 add n i get kxt i
end
m = add n len kxt
r = unlink pt2 0 m
fd = fopen pt2 0 m 557249 420
if lt fd 0
ret false
end
z = get obl 0
o = ulong 0
ok = true
while lt o z bound 524288
k = write int fd ob o sub z o
if le k 0
ok = false
o = z
else
o = add o ulong k
end
end
r = fsync int fd
x = fclose int fd
if not ok
ret false
end
put rpk 0 2
put rpk 1 0
put rpk 2 uchar and m 255
put rpk 3 uchar shr m 8
for i ulong m bound 1100
put rpk add 4 i get pt2 i
end
o = add 4 m
put rpk o uchar and n 255
put rpk add o 1 uchar shr n 8
for i ulong n bound 1100
put rpk add add o 2 i get pth i
end
ret eq renames rpk 0 add add o 2 n 0 0
end
note save: the list with the current row in the given state: the private list first, then the
note published copy
fn save state view uchar * to void
keep
dodate
rowhead state
rowtail
wpath klist
ok = wr
if pinopen
rname klist
ok = wr
unpin
end
end
fn blank to void
put kb 0 0
put nml 0 0
put dsl 0 0
end
note allowed: <work dir>allow lists the keys that may bring a project, one DID a line; a line
note that is only * admits every signed-in key. No file admits nobody. The file is outside the
note folder forged can write.
fn aload to bool
put cbl 0 0
wpath kallow
fd = fopen pth 0 get pthl 0 557056 0
if lt fd 0
ret false
end
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read int fd cb n sub 65535 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put cbl 0 n
ret true
end
note aline: the allow line cb[a, e) is * or the current did
fn aline a ulong e ulong to bool
m = sub e a
if eq m 1
if eq get cb a 42
ret true
end
end
d = get didl 0
if ne m d
ret false
end
for i ulong d bound 96
if ne get cb add a i get did i
ret false
end
end
ret true
end
fn aeol a ulong to ulong
n = get cbl 0
e = a
while lt e n bound 65536
if eq get cb e 10
ret e
end
e = add e 1
end
ret n
end
fn allowed to bool
if not aload
ret false
end
n = get cbl 0
a = ulong 0
while lt a n bound 4096
e = aeol a
if aline a e
ret true
end
a = add e 1
end
ret false
end
note ---- the operator's remove file: <work dir>remove
note One line each: a project (rad:z... or z...) or a key (did:key:...), exactly, nothing else on
note the line. A project named there, and every project brought by a key named there, comes off
note the shelf within a pass (sweep) and cannot be brought again while the line stands; a named key
note cannot bring anything. A * line names nothing. This is how the operator takes a listing down
note without the bringer. The file is outside the folder forged can write. No file: nothing removed.
fn dload to bool
put cbl 0 0
wpath kremove
fd = fopen pth 0 get pthl 0 557056 0
if lt fd 0
ret false
end
n = ulong 0
k = long 1
while gt k 0 bound 65536
k = read int fd cb n sub 65535 n
if gt k 0
n = add n ulong k
end
end
x = fclose int fd
put cbl 0 n
ret true
end
note dline: the remove line cb[a, e) is the current did, or the current rid with or without rad:
fn dline a ulong e ulong to bool
m = sub e a
d = get didl 0
if and gt d 0 eq m d
same = true
for i ulong d bound 96
if ne get cb add a i get did i
same = false
end
end
if same
ret true
end
end
b = a
if gt m 4
pre = true
for i ulong 4
if ne get cb add a i get kradp i
pre = false
end
end
if pre
b = add a 4
end
end
r = get ridl 0
if eq r 0
ret false
end
if ne sub e b r
ret false
end
for i ulong r bound 44
if ne get cb add b i get rid i
ret false
end
end
ret true
end
note dscan: the loaded remove file names the current rid or did
fn dscan to bool
n = get cbl 0
a = ulong 0
while lt a n bound 65536
e = aeol a
if dline a e
ret true
end
a = add e 1
end
ret false
end
fn denied to bool
if not dload
ret false
end
ret dscan
end
note ---- the snapshot a project page is drawn from: <open dir>p/<rid>.txt
note forged cannot read a brought repository (its sandbox mounts only the curated ones), so this
note program asks git for a small, fixed view of the project's HEAD and writes it as lines forged
note escapes and shows: H head and date, C the last 10 commits, T the top-level files (at most
note 200), R the README (README.md, else README; at most 32 KiB). Every line is cut at 400 bytes,
note control bytes become spaces and bytes that are not UTF-8 become "?". git runs with a cleared
note environment, no system or user configuration, read-only commands and a 20 s deadline each;
note nothing from the project is executed. A command that fails leaves its part out.
note pkgit: env -i HOME=<work dir> GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
note PATH=/usr/bin:/bin /usr/bin/git --git-dir <storage dir><rid>
fn pkgit to void
pknew
pkt kenv
pkt kdashi
sbz
sbt khome
for i ulong get wdl 0 bound 512
sbc get wd i
end
pks
pkt kgn
pkt kgg
pkt kgallow
pkt kgnlazy
pkt kgprompt
pkt kpathg
pkt kgit
pkt kgd
sbz
sbstore
pks
end
note eml: one snapshot line: the kind byte, a tab, then cb[a, b) cut at 400 bytes. A tab stays
note when tabs is true.
fn eml kind uchar a ulong b ulong tabs bool to void
n = sub b a
if gt n 400
n = ulong 400
end
for i ulong n bound 400
c = get cb add a i
if or lt c 32 eq c 127
if not and tabs eq c 9
c = uchar 32
end
end
put ub i c
end
put ubl 0 n
usan
emb kind
emb 9
for i ulong n bound 400
emb get ub i
end
emb 10
end
note snnode: N <tab> the node's DID (rad self --did), the hub's key the project page names
fn snnode to void
pkrad
pkt kself
pkt kdidf
if not run 10
ret
end
n = get cbl 0
e = ulong 0
while lt e n bound 65536
if eq get cb e 10
break
end
e = add e 1
end
if gt e 0
eml 78 0 e false
end
end
fn snhead to void
pkgit
pkt kglog
pkt kgm1
pkt kgfh
pkt kghead
if not run 20
ret
end
if eq get cbl 0 0
ret
end
eml 72 0 aeol 0 true
end
fn sncommits to void
pkgit
pkt kglog
pkt kgn10
pkt kgfc
pkt kghead
if not run 20
ret
end
n = get cbl 0
a = ulong 0
k = ulong 0
while lt a n bound 16
if ge k 10
break
end
e = aeol a
if gt e a
eml 67 a e true
end
a = add e 1
k = add k 1
end
end
note sntline: one ls-tree line "mode type sha <tab> name" becomes T <tab> first letter of the type
note <tab> name
fn sntline a ulong e ulong to void
p = a
while lt p e bound 65536
if eq get cb p 32
break
end
p = add p 1
end
q = add p 1
while lt q e bound 65536
if eq get cb q 9
break
end
q = add q 1
end
if ge q e
ret
end
if lt q add p 3
ret
end
put cb sub q 1 get cb add p 1
eml 84 sub q 1 e true
end
fn sntree to void
pkgit
pkt kgls
pkt kghead
if not run 20
ret
end
n = get cbl 0
a = ulong 0
k = ulong 0
while lt a n bound 256
if ge k 200
break
end
e = aeol a
if gt e a
sntline a e
end
a = add e 1
k = add k 1
end
end
note snrun: git show of the README into cb
fn snrun to bool
pkgit
pkt kgshow
pkt kgrd1
if run 20
ret true
end
pkgit
pkt kgshow
pkt kgrd2
ret run 20
end
fn snreadme to void
if not snrun
ret
end
n = get cbl 0
if gt n 32768
n = ulong 32768
end
a = ulong 0
while lt a n bound 32769
e = aeol a
if gt e n
e = n
end
if eq e a
eml 82 a a false
end
s = a
while lt s e bound 256
z = add s 400
if gt z e
z = e
end
eml 82 s z false
s = z
end
a = add e 1
end
end
note snpath: pin <open dir>p/ (mk makes it first); pth = <rid>.txt in it. Callers unpin.
fn snpath mk bool to bool
if not pinsub kpdir mk
ret false
end
for i ulong get ridl 0 bound 44
put pth i get rid i
end
n = get ridl 0
for i ulong len ktxt bound 8
put pth add n i get ktxt i
end
put pthl 0 add n len ktxt
ret true
end
fn snap to void
archive
put obl 0 0
snnode
snhead
sncommits
sntree
snreadme
if snpath true
ok = wr
unpin
end
end
note ---- one request
note rsave: save a refusal that is not about a fetch, unless the row says this program's own fetch
note of the rid failed (fl): that row is what lets the next bring clear a late folder, so a key
note that is not invited, a full quota or a node that does not answer must not replace it.
fn rsave t view uchar * fl bool to void
if not fl
save t
end
end
note describe: name and description from the project's identity document
fn describe to void
if dopayload
put nml 0 jget kname 0 120
put dsl 0 jget kdesc 1 400
usnm
usds
end
if eq get nml 0 0
for i ulong len kunnamed bound 32
put nm i get kunnamed i
end
put nml 0 len kunnamed
end
end
fn bring to void
blank
lload
s = lfind
if lt s get lbl 0
if lpub s leol s
note a second bring by the key that listed the project refreshes its page snapshot (a row the
note remove file names is left as it is; sweep takes it down)
if lisdid s leol s
if not denied
snap
end
end
ret
end
end
fl = lfailed
if denied
rsave kr8 fl
ret
end
if not allowed
rsave kr0 fl
ret
end
left = false
held = false
if stored
left = fl
if not left
held = true
end
end
if not lfits
rsave klfull fl
ret
end
if held
if not dovis
save kr1
ret
end
note held needs the node's own seeding policy for the rid: a folder this program's failed fetch
note left (unseeded again) is not the node's project, even after its refusal row was replaced
hp = policy
if eq hp 2
save kr6
ret
end
if eq hp 0
save kr1
ret
end
dg = dodel
if eq dg 2
save kr6
ret
end
if eq dg 0
save kr9
ret
end
ok = dodu
describe
save kheld
snap
ret
end
p = policy
if eq p 1
save kr7
ret
end
if eq p 2
rsave kr6 fl
ret
end
if not rsvok 0 0
rsave kfull fl
ret
end
if left
dorm
end
ok = doseed
if ok
ok = stored
end
if not ok
dounseed
if stored
dorm
end
save kr4
ret
end
ok = dodu
if not ok
dounseed
dorm
save kr4
ret
end
note no size refusal: largest_project_kib is an alarm. The fetch is refused only when it took the
note storage filesystem below its reserve; then it is unseeded and removed (a failed fetch)
if not rsvok 0 0
put avol 10 mul get kb 0 1024
dounseed
dorm
save kfull
ret
end
describe
save kopen
snap
end
note withdraw: only an open or held row brought by this key. Its name is kept; size, description
note and note are cleared.
fn withdraw to void
lload
s = lfind
if ge s get lbl 0
ret
end
e = leol s
held = lstate s e kheld
if not held
if not lowned s e
ret
end
end
if not lisdid s e
ret
end
blank
a = lfld s e 5
b = lfe a e
n = sub b a
if gt n 120
n = ulong 120
end
for i ulong n bound 120
put nm i get lb add a i
end
put nml 0 n
put ntl 0 0
if not held
dounseed
dorm
end
if snpath false
r = unlink pth 0 get pthl 0
unpin
end
adel
save kwith
end
note setrow: the rid and the did of the row s..e become the current ones
fn setrow s ulong e ulong to void
b = lfe s e
n = sub b s
if gt n 44
n = ulong 44
end
for i ulong n bound 44
put rid i get lb add s i
end
put ridl 0 n
a = lfld s e 2
c = lfe a e
m = sub c a
note 96 is the did cap of the queue (qfield) and of forged (ohdid): a shorter cap would cut a
note 96-byte did, so a remove line naming it would miss and a line naming its prefix would match
if gt m 96
m = ulong 96
end
for i ulong m bound 96
put did i get lb add a i
end
put didl 0 m
end
note takedown: the operator's removal of the row s..e (on the shelf; its rid and did are current).
note As a withdraw, without the bringer: a fetched copy is unseeded and deleted, a held project is
note left as the node had it; the snapshot goes; the row stays, off the shelf, under the bringer's
note key, so that key sees why.
fn takedown s ulong e ulong to void
fetched = lowned s e
blank
a = lfld s e 5
b = lfe a e
n = sub b a
if gt n 120
n = ulong 120
end
for i ulong n bound 120
put nm i get lb add a i
end
put nml 0 n
put ntl 0 0
if fetched
dounseed
dorm
end
if snpath false
u = unlink pth 0 get pthl 0
unpin
end
adel
save kr8
end
note sweep: take down one row on the shelf that the remove file names (by project or by the key
note that brought it); true when it did. One row a pass keeps the list it scans in step with the
note list it writes.
fn sweep to bool
if not dload
ret false
end
lload
lim = get lbl 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if lpub s e
setrow s e
if dscan
takedown s e
ret true
end
end
s = add e 1
end
ret false
end
note ---- the queue
fn getoff to ulong
b = new uchar 24 0
fd = fopen sf 0 get sfl 0 524288 0
if lt fd 0
ret 0
end

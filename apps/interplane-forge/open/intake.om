note field: copy qb[a, e) up to the next tab into rid (which 0), did (1) or the note (2); the
note index after the tab, or e. A field that breaks its rule sets its length to 0.
fn fput which ulong o ulong c uchar to void
if eq which 0
put rid o c
end
if eq which 1
put did o c
end
if eq which 2
put nt o c
end
end
fn qfield a ulong e ulong which ulong cap ulong to ulong
o = ulong 0
bad = false
p = a
while lt p e bound 65536
c = get qb p
if eq c 9
break
end
if eq which 0
if not b58 c
bad = true
end
end
if eq which 1
if or le c 32 ge c 127
bad = true
end
end
if eq which 2
if or lt c 32 eq c 127
c = uchar 32
end
end
if ge o cap
bad = true
else
fput which o c
o = add o 1
end
p = add p 1
end
if bad
o = ulong 0
end
if eq which 0
put ridl 0 o
end
if eq which 1
put didl 0 o
end
if eq which 2
put ntl 0 o
end
if lt p e
ret add p 1
end
ret e
end
note qline: qb[a, e) is one queue line. True when it was well formed and was acted on.
fn qline a ulong e ulong to bool
if uline a e
ret true
end
if lt sub e a 4
ret false
end
kind = get qb a
if ne get qb add a 1 9
ret false
end
p = qfield add a 2 e 0 44
p = qfield p e 1 96
put ntl 0 0
if eq kind 66
p = qfield p e 2 200
usnt
end
if or lt get ridl 0 20 eq get didl 0 0
ret false
end
if ne get rid 0 122
ret false
end
if eq kind 66
bring
ret true
end
if eq kind 87
withdraw
ret true
end
ret false
end
note qeol: the index of the line feed at or after a in qb[0, m), or m
fn qeol a ulong m ulong to ulong
e = a
while lt e m bound 65536
if eq get qb e 10
ret e
end
e = add e 1
end
ret m
end
note qchunk: the complete lines of one 64 KiB chunk of the queue file at pth, from the stored
note offset. The offset is saved after each line that was acted on and once at the end of the
note chunk, not after every ignored line (each save is a write, a sync and a rename). qe is 1 when the file opened and nothing was left to read.
fn qchunk name view uchar * to bool
put qe 0 0
if not pinopen
ret false
end
rname name
fd = ropen
unpin
if lt fd 0
ret false
end
off = getoff
k = pread int fd qb 0 65536 long off
x = fclose int fd
if le k 0
put qe 0 1
ret false
end
m = ulong k
a = ulong 0
did1 = false
dirty = false
while lt a m bound 65536
e = qeol a m
if ge e m
if and eq a 0 eq m 65536
a = m
dirty = true
did1 = true
end
break
end
acted = qline a e
did1 = true
a = add e 1
if acted
putoff add off a
dirty = false
else
dirty = true
end
end
if dirty
putoff add off a
end
ret did1
end
note qrotate: rename <open dir>queue to queue.old. forged creates a new queue at its next request,
note so the queue never stays at forged's 1 MiB cap once this program has read it.
fn qrotate to bool
if not pinopen
ret false
end
rname kqold
m = get pthl 0
for i ulong m bound 1100
put pt2 i get pth i
end
rname kq
n = get pthl 0
put rpk 0 2
put rpk 1 0
put rpk 2 uchar and n 255
put rpk 3 uchar shr n 8
for i ulong n bound 1100
put rpk add 4 i get pth i
end
o = add 4 n
put rpk o uchar and m 255
put rpk add o 1 uchar shr m 8
for i ulong m bound 1100
put rpk add add o 2 i get pt2 i
end
r = renames rpk 0 add add o 2 m 0
unpin
ret eq r 0
end
note qold: finish a rotated queue. The stored offset is one into queue.old while it exists and is
note above 0 (a rotation happens only past 262,144 bytes); 0 means it was finished before a
note restart, so it is only removed. Any line forged appended during the rename is read here.
fn qold to bool
if not pinopen
ret false
end
rname kqold
there = eq faccess pth 0 get pthl 0 0 0
unpin
if not there
ret false
end
if gt getoff 0
for i ulong 4096
if not qchunk kqold
break
end
end
end
putoff 0
if not pinopen
ret false
end
rname kqold
r = unlink pth 0 get pthl 0
unpin
ret eq r 0
end
note qpass: one pass. A queue read to its end past 262,144 bytes is rotated; the second of sleep
note lets a request forged opened before the rename finish its write before queue.old is read.
fn qpass to bool
if qold
ret true
end
if qchunk kq
ret true
end
if eq get qe 0 0
ret false
end
if lt getoff 262144
ret false
end
if not qrotate
ret false
end
z = sleepns 1000000000
ret true
end
note argp: argument i into its buffer; its length
fn aput i ulong k ulong c uchar to void
if eq i 1
put od k c
end
if eq i 2
put sf k c
end
if eq i 3
put wd k c
end
if eq i 4
put sd k c
end
if eq i 5
put hd k c
end
end
fn argp i ulong cap ulong to ulong
b = new uchar 512 0
n = argread i b 0 cap
if le n 0
ret 0
end
m = ulong n
for k ulong m bound 512
aput i k get b k
end
ret m
end
fn slashed i ulong to bool
if eq i 1
ret eq get od sub get odl 0 1 47
end
if eq i 3
ret eq get wd sub get wdl 0 1 47
end
ret eq get sd sub get sdl 0 1 47
end
fn main to int
if lt argcnt 6
ret 2
end
put odl 0 argp 1 500
put sfl 0 argp 2 500
put wdl 0 argp 3 500
put sdl 0 argp 4 500
put hdl 0 argp 5 250
if eq get odl 0 0
ret 2
end
if eq get sfl 0 0
ret 2
end
if eq get wdl 0 0
ret 2
end
if eq get sdl 0 0
ret 2
end
if eq get hdl 0 0
ret 2
end
if not slashed 1
ret 2
end
if not slashed 3
ret 2
end
if not slashed 4
ret 2
end
once = gt argcnt 6
note the open dir may not exist yet (forged makes it at its first write, and takes files only once
note this program has written its space file there): make it, never through a link (mkdir does not
note follow one; pinopen refuses one)
r = makedir od 0 sub get odl 0 1 448
allarchives
alarms
swept = ulong 0
while true bound 9223372036854775807
put aqmax 0 amax get aqmax 0 aqsize
did1 = qpass
did2 = sweep
put apass 0 add get apass 0 1
if or or once or did1 did2 ge get apass 0 60
alarms
put apass 0 0
end
if once
note a removal that cannot be written would be tried for ever: give up after 512
if did2
swept = add swept 1
end
if gt swept 512
ret 1
end
if not or did1 did2
ret 0
end
else
if not did1
z = sleepns 1000000000
end
end
end
ret 0
end

note uqfield copies one of the seven U queue fields, with no truncation or unchecked arithmetic.
fn unamec c uchar to bool
if eq c 45
ret true
end
if and ge c 97 le c 122
ret true
end
ret and ge c 48 le c 57
end
fn uqfield a ulong e ulong which ulong to ulong
p = a
n = ulong 0
v = ulong 0
cap = ulong 0
if eq which 0
cap = ulong 64
end
if eq which 1
cap = ulong 96
end
if or eq which 2 eq which 3
cap = ulong 18
end
if eq which 4
cap = ulong 64
end
if eq which 5
cap = ulong 200
end
while lt p e bound 65536
c = get qb p
if eq c 9
break
end
if ge n cap
put uerr 0 1
else
if eq which 0
if not uhex c
put uerr 0 1
end
put usha n c
end
if eq which 1
if or le c 32 ge c 127
put uerr 0 1
end
put did n c
end
if or eq which 2 eq which 3
if or lt c 48 gt c 57
put uerr 0 1
else
v = add mul v 10 ulong sub c 48
end
end
if eq which 4
if not unamec c
put uerr 0 1
end
put nm n c
end
if eq which 5
if or lt c 32 eq c 127
put uerr 0 1
end
put nt n c
end
end
n = add n 1
p = add p 1
end
if eq which 0
if ne n 64
put uerr 0 1
end
end
if eq which 1
put didl 0 n
end
if or eq which 2 eq which 3
if eq n 0
put uerr 0 1
end
put uvals sub which 2 v
end
if eq which 4
if eq n 0
put uerr 0 1
end
put nml 0 n
end
if eq which 5
put ntl 0 n
end
if lt p e
ret add p 1
end
ret p
end
note unamerule: the name keeps forged's rule (ohname): no '-' first, last or twice in a row; the
note characters and the length were checked by uqfield
fn unamerule to bool
n = get nml 0
if or eq n 0 gt n 64
ret false
end
if or eq get nm 0 45 eq get nm sub n 1 45
ret false
end
for i ulong sub n 1 bound 64
if and eq get nm i 45 eq get nm add i 1 45
ret false
end
end
ret true
end
fn uline a ulong e ulong to bool
if lt sub e a 4
ret false
end
if ne get qb a 85
ret false
end
if ne get qb add a 1 9
ret false
end
put uerr 0 0
p = add a 2
for i ulong 6
p = uqfield p e i
end
if ne p e
put uerr 0 1
end
if eq get didl 0 0
put uerr 0 1
end
if ne get uerr 0 0
ret false
end
if not unamerule
ret false
end

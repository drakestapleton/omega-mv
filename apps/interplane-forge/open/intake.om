fn ub64v c uchar to long
if and ge c 65 le c 90
ret long sub c 65
end
if and ge c 97 le c 122
ret add long sub c 97 26
end
if and ge c 48 le c 57
ret add long sub c 48 52
end
if eq c 45
ret 62
end
if eq c 95
ret 63
end
ret -1
end
note Decode a single spool record in local b, including its seq/total trailer. No body is executed.
fn udecode b view uchar * n ulong dest int seq ulong total ulong to long
if lt n 25
ret -1
end
m = sub n 23
if or ne get b m 9 ne get b add m 11 9
ret -1
end
if ne get b sub n 1 10
ret -1
end
r4 = rem m 4
if eq r4 1
ret -1
end
if ne urecnum b add m 1 long seq
ret -1
end
k = mul div m 4 3
if gt r4 0
k = add k sub r4 1
end
if ne urecnum b add m 12 long add total k
ret -1
end
if gt add total k get uvals 1
ret -1
end
ret udecbody b m dest
end
note udecbody: canonical unpadded base64url b[0, m) into dest; unused low bits must be zero
fn udecbody b view uchar * m ulong dest int to long
acc = ulong 0
bits = ulong 0
k = ulong 0
for i ulong m bound 60000
v = ub64v get b i
if lt v 0
ret -1
end
acc = and or shl acc 6 ulong v 4095
bits = add bits 6
if ge bits 8
bits = sub bits 8
put ubuf k uchar and shr acc bits 255
k = add k 1
end
end
if gt bits 0
if ne and acc sub shl ulong 1 bits 1 0
ret -1
end
end
w = write dest ubuf 0 k
if ne w long k
ret -1
end
ret long k
end
fn urecnum b view uchar * a ulong to long
v = long 0
for i ulong 10
c = get b add a i
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 long sub c 48
end
ret v
end
fn udecodeall to bool
if not upath kub64

fn udecodeloop fd int dest int to bool
b = new uchar 60032 0
pos = long 0
seq = ulong 0
total = ulong 0
while true bound 9223372036854775807
k = pread fd b 0 60024 pos
if lt k 0
ret false
end
if eq k 0
put uvals 2 total
ret true
end
n = ulong 0
for i ulong ulong k bound 60024
if eq get b i 10
n = add i 1
break
end
end
if eq n 0
ret false
end
v = udecode b n dest seq total
if lt v 0
ret false
end
total = add total ulong v
seq = add seq 1
pos = add pos long n
end
ret false
end
fn ufilehash to bool

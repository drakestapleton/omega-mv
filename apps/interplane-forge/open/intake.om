note Downloads are made for every shelf row on each intake pass, not only newly brought rows.
note apath: pin <open dir>a/ (mk makes it first); pth = <rid> then ext, in it. Callers unpin.
fn apath ext view uchar * mk bool to bool
if not pinsub kua mk
ret false
end
arel ext
ret true
end
note arel: pth = <rid> then ext (in the pinned a/)
fn arel ext view uchar * to void
for i ulong get ridl 0 bound 44
put pth i get rid i
end
n = get ridl 0
for i ulong len ext bound 16
put pth add n i get ext i
end
put pthl 0 add n len ext
end
note adelp: remove the download of the current row from the pinned a/ (tar, hash, temp file)
fn adelp to void
arel kutar
r = unlink pth 0 get pthl 0
arel kuhash
r = unlink pth 0 get pthl 0
arel kutmp
r = unlink pth 0 get pthl 0
end
fn adel to void
if apath kutar false
adelp
unpin
end
end
note archive: the download of the current row. git archive of HEAD (the snapshot's environment,
note no network) writes to a pipe; this program counts, hashes and copies the bytes into
note a/<rid>.tar.tmp, created exclusively and never through a link in the a/ it pinned. Past
note 52,428,800 bytes (the existing per-project cap) or 30 s, git is stopped and the row has no
note download. Else the old hash goes, the temp file is renamed onto <rid>.tar and the hash is
note written to <rid>.sha256 with wr. Nothing is written outside the pinned a/.
fn archive to void
fa = dfree 1
ra = rsvget 1
put alimit 0 0
if gt fa ra
put alimit 0 sub fa ra
end
if not apath kutmp true
ret
end
r = unlink pth 0 get pthl 0
fd = fopen pth 0 get pthl 0 557249 420
if lt fd 0
adelp
unpin
ret
end
ok = apipe int fd
r = fsync int fd
x = fclose int fd
if ok
ok = amove
end
if ok
put obl 0 0
for i ulong 64
emb get udigest i
end
arel kuhash
ok = wr
end
if not ok
adelp
end
unpin
end
note amove: rename <rid>.tar.tmp onto <rid>.tar in the pinned a/, after removing the old hash
fn amove to bool
arel kuhash
r = unlink pth 0 get pthl 0
arel kutar
m = get pthl 0
for i ulong m bound 1100
put pt2 i get pth i
end
arel kutmp
n = get pthl 0
put rpk 0 2
put rpk 1 0
put rpk 2 uchar and n 255
put rpk 3 uchar shr n 8
for i ulong n bound 1100
put rpk add 4 i get pth i
end
o = add 4 n
put rpk o uchar and m 255
put rpk add o 1 uchar shr m 8
for i ulong m bound 1100
put rpk add add o 2 i get pt2 i
end
ret eq renames rpk 0 add add o 2 m 0 0
end
fn upfd b view uchar * i ulong to int
o = mul i 4
v = or ulong get b o shl ulong get b add o 1 8
v = or v shl ulong get b add o 2 16
v = or v shl ulong get b add o 3 24
ret int v
end
note apipe: run git archive with its stdout on a pipe and copy it to dest (acopy); true when git
note exited 0 and every byte was copied within the cap and the deadline
fn apipe dest int to bool
pf = new uchar 8 0
pkgit
pkt kuarch
pkt kuformat
pkt kghead
r = pipefds pf 0 8 524288
if lt r 0
ret false
end
rfd = upfd pf 0
wfd = upfd pf 1
put upipew 0 ulong wfd
put upiped 0 1
pid = fork
if eq pid 0
child
exit 127
end
put upiped 0 0
x = fclose wfd
if lt pid 0
x = fclose rfd
ret false
end
r = setpgid int pid int pid
ok = acopy rfd dest
x = fclose rfd
if not ok
r = killpid int neg pid 9
r = killpid int pid 9
end
ret areap pid ok
end
note acopy: the pipe src into dest, counted and hashed (udigest); false past the cap or 30 s
fn acopy src int dest int to bool
b = new uchar 65536 0
ctx = new ulong 40 0
sha256_init ctx
tot = ulong 0
dl = add long monons 30000000000
while true bound 9223372036854775807
n = aread src b dl
if eq n 0
break
end
if lt n 0
ret false
end
tot = add tot ulong n
if gt tot get alimit 0
ret false
end
sha256_update ctx part b 0 ulong n
k = write dest b 0 ulong n
if ne k n
ret false
end
end
ahex ctx
ret true
end
note aread: one read from the pipe before the deadline: the count, 0 at its end, -1 on failure
fn aread src int b edit uchar 65536 dl long to long
while true bound 9223372036854775807
left = sub dl long monons
if le left 0
ret -1
end
w = waitio src 1 left
if gt w 0
n = read src b 0 65536
if ge n 0
ret n
end
if and ne n -4 ne n -11
ret -1
end
else
if and lt w 0 ne w -4
ret -1
end
end
end
ret -1
end
fn ahex ctx edit ulong 40 to void
h = new uchar 32 0
sha256_final ctx h
for i ulong 32
c = get h i
put udigest mul i 2 get kuhex ulong shr c 4
put udigest add mul i 2 1 get kuhex ulong and c 15
end
end
note areap: wait for git (10 s more at most); true when ok and it exited 0
fn areap pid long ok bool to bool
st = new uchar 4 0
for i ulong 1000
r = waitpid int pid st 0 4 1
if eq r pid
if not ok
ret false
end
for j ulong 4
if ne get st j 0
ret false
end
end
ret true
end
if lt r 0
ret false
end
r = sleepns 10000000
end
r = killpid int neg pid 9
r = killpid int pid 9
r = waitpid int pid st 0 4 0
ret false
end
fn allarchives to void
lload
s = ulong 0
while lt s get lbl 0 bound 262144
e = leol s
if lpub s e
setrow s e
archive
end
s = add e 1
end
end
note ---- alarms (no-hard-caps point 5): measurements beside the unchanged caps. Nothing here refuses.
note A check fires at value >= threshold (free disk: percent free <= 15). <work>alarms.txt holds one
note line per firing alarm: name, value, threshold, source (tab separated); the same lines go to
note stderr with "ALARM "; <open dir>alarms.json lists every check with "firing".
fn amax a ulong b ulong to ulong
if gt a b
ret a
end
ret b
end
note aqsize: the size of <open dir>queue
fn aqsize to ulong
if not pinopen
ret 0
end
rname kq
v = alsize
unpin
ret v
end
note alsize: the size of pth, the file itself (lstat: a link is not followed)
fn alsize to ulong
b = new uchar 128 0
r = lstat pth 0 get pthl 0 b 0 128
if ne r 0
ret 0
end
v = ulong 0
for i ulong 8
v = or v shl ulong get b add 48 i mul i 8
end
ret v
end
fn aspool to ulong
a = new uchar 65536 0
if not pinsub kuup false
ret 0
end
fd = fopen kdot 0 1 573440 0
if lt fd 0
unpin
ret 0
end
base = ulong 0
tot = ulong 0
while true bound 1000000
n = getdnts int fd a 0 65536
if le n 0
break
end
o = ulong 0
while lt o ulong n bound 65536
rl = or ulong get a add o 16 shl ulong get a add o 17 8
if eq get a add o 19 46
o = add o rl
continue
end
k = ulong 0
while lt k 256 bound 256
c = get a add add o 19 k
if eq c 0
break
end
put pth add base k c
k = add k 1
end
put pthl 0 add base k
tot = add tot alsize
if eq rl 0
break
end
o = add o rl
end
end
x = fclose int fd
unpin
ret tot
end
note arows: the shelf from the private list: rows on it (avals 1), the key with the most rows
note this program fetched or stored for it (avals 0, its key and volume), the largest row in KiB
note (avals 2, its key), the total volume, and the list's own size against what lload reads
fn arows to void
lload
for i ulong 3
put avals i 0
akclr i
end
put avol 1 0
put avals 9 get lbl 0
lim = get lbl 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if lpub s e
put avals 1 add get avals 1 1
v = lkibat s e
put avol 1 add get avol 1 mul v 1024
setrow s e
if gt v get avals 2
put avals 2 v
put avol 2 mul v 1024
akset 2
end
if lowned s e
n = lcount true
if gt n get avals 0
put avals 0 n
put avol 0 mul lkib 1024
akset 0
akcopy 0 1
end
end
end
s = add e 1
end
end
note lkibat: field 4 (kilobytes) of the row s..e
fn lkibat s ulong e ulong to ulong
a = lfld s e 4
b = lfe a e
v = ulong 0
for i ulong sub b a bound 20
c = get lb add a i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
end
end
ret v
end
note lkib: the kilobytes of the current did's rows this program fetched or stored
fn lkib to ulong
lim = get lbl 0
t = ulong 0
s = ulong 0
while lt s lim bound 262144
e = leol s
if lpub s e
if lowned s e
if lisdid s e
t = add t lkibat s e
end
end
end
s = add e 1
end
ret t
end
note akeys: the key an alarm names (96 bytes a slot), its length; akset copies the current did
fn akclr i ulong to void
put akl i 0
end
fn akset i ulong to void
n = get didl 0
for j ulong n bound 96
put akeys add mul i 96 j get did j
end
put akl i n
end
fn akcopy a ulong b ulong to void
n = get akl a
for j ulong n bound 96
put akeys add mul b 96 j get akeys add mul a 96 j
end
put akl b n
end
note dfree: the bytes free on the filesystem of the storage dir (which 0) or the open dir (1), from
note df -B1 -P (column Available); 0 when df does not answer, so a check refuses rather than guesses
fn dfree which ulong to ulong
pknew
pkt kadf
pkt kadfb
pkt kadfp
sbz
if eq which 0
for i ulong get sdl 0 bound 512
sbc get sd i
end
else
for i ulong get odl 0 bound 512
sbc get od i
end
end
pks
if not run 10
ret 0
end
ret dfcol 3
end
note dfcol: column k of the second line of the command output, as a number; 0 when it is not one
fn dfcol k ulong to ulong
p = dfnl
for col ulong add k 1 bound 16
p = dftok p
end
if eq get dfv 1 0
ret 0
end
ret get dfv 0
end
fn dfnl to ulong
n = get cbl 0
l = ulong 0
while lt l n bound 65536
if eq get cb l 10
ret add l 1
end
l = add l 1
end
ret n
end
note dftok: the token at or after p (spaces skipped): its value in dfv 0, 1 in dfv 1 when it is all digits
fn dftok p ulong to ulong
n = get cbl 0
q = p
while and lt q n eq get cb q 32 bound 65536
q = add q 1
end
v = ulong 0
ok = lt q n
while and lt q n ne get cb q 32 bound 65536
c = get cb q
if or lt c 48 gt c 57
ok = false
else
v = add mul v 10 ulong sub c 48
end
q = add q 1
end
put dfv 0 v
put dfv 1 0
if ok
put dfv 1 1
end
ret q
end
fn aseed to ulong
pkrad
pkt kseed
if not run 30
ret 0
end
ret get cbl 0
end

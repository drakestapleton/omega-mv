put pthl 0 add k get unamel 0
end
note uscanc: a streaming match of "-----BEGIN" then "PRIVATE KEY-----" on the same line, so a
note key block split across tar blocks is still found
fn umatch t view uchar * st ulong c uchar to ulong
if eq c get t st
ret add st 1
end
if eq c get t 0
ret 1
end
ret 0
end
fn uscanc c uchar to void
if eq get uscan 1 0
s = umatch ubegin get uscan 0 c
if eq s len ubegin
put uscan 1 1
s = ulong 0
end
put uscan 0 s
ret
end
if eq c 10
put uscan 1 0
put uscan 0 0
ret
end
s = umatch upriv get uscan 0 c
if eq s len upriv
put uerr 0 2
s = ulong 0
end
put uscan 0 s
end
note ublock: one archive data block: key scan, zero padding, digest and the optional write
fn ublock b view uchar * n ulong dest int ctx edit ulong * to bool
for i ulong n bound 512
uscanc get b i
end
if ne get uerr 0 0
ret false
end
for i ulong sub 512 n bound 512
if ne get b add n i 0
ret false
end
end
sha256_update ctx part b 0 n
if lt dest 0
ret true
end
w = write dest b 0 n
ret eq w long n
end
fn udata fd int dest int size ulong inv bool to bool
b = new uchar 512 0
ctx = new ulong 40 0
h = new uchar 32 0
sha256_init ctx
left = size
put uscan 0 0
put uscan 1 0
while gt left 0 bound 9223372036854775807
k = read fd b 0 512
if ne k 512
ret false
end
n = left
if gt n 512
n = ulong 512
end
if not ublock b n dest ctx
ret false
end
left = sub left n
end
sha256_final ctx h
if inv
uinv h size
end
ret true
end
fn uinv h view uchar * size ulong to void
for i ulong 32
c = get h i
emb get kuhex ulong shr c 4
emb get kuhex ulong and c 15
end
emb 9
emn size
emb 9
for i ulong get unamel 0 bound 255
emb get uname i
end
emb 10
end
fn utar unpack bool to bool
wpath kuarc
fd = fopen pth 0 get pthl 0 557056 0
if lt fd 0
ret false
end
put uprevl 0 0
ok = utarloop int fd unpack
x = fclose int fd
ret ok
end
fn utarloop fd int unpack bool to bool
b = new uchar 512 0
count = ulong 0
while true bound 9223372036854775807
k = read fd uhdr 0 512
if ne k 512
ret false
end
if uzero 0 512
k = read fd uhdr 0 512
if ne k 512
ret false
end
if not uzero 0 512
ret false
end
k = read fd b 0 1
if ne k 0
ret false
end
ret eq count get uvals 0
end
size = uheader
if lt size 0
ret false
end
dest = long -1
if unpack
utreepath true
dest = fopen pth 0 get pthl 0 557249 int uoct 100 8
if lt dest 0
ret false
end
end
ok = udata fd int dest ulong size unpack
if ge dest 0
x = fclose int dest
end
if not ok
ret false
end
count = add count 1
end
ret false
end

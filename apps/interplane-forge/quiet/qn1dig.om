note quiet/qn1dig.om: one digest file per subscriber, rewritten when an event is appended.
note A page read does not call qnregen. Caps: 64 KiB of events, 32 lines, no clock.
text tqev "quiet/events"
text tqsb "quiet/subs"
text tqod "quiet/out/"
text tqdir "quiet"
text tqoutdir "quiet/out"
text tqdv1 "QUIET-DIGEST v1\n"
text tqsk "subscriber="
text tqak "agent="
text tqrk "repo="
text tqck "count="
text tqkind "patch"
text tqnl "\n"
global qndd uchar 512
global qnddl ulong 1
global qnev uchar 65536
global qnevl ulong 1
global qnsub uchar 8192
global qnsl ulong 1
global qnline uchar 256
global qnlinel ulong 1
global qnhold uchar 256
global qnholn ulong 1
global qnout uchar 8192
global qnol ulong 1
global qnovf ulong 1
global qnt0 ulong 1
global qnt1 ulong 1
global qnfa ulong 1
global qnfn ulong 1
global qnra ulong 1
global qnrn ulong 1
fn qnsetd p view uchar * n ulong to void
put qnddl 0 0
if or eq n 0 gt n 512
ret
end
for i ulong n bound 512
put qndd i get p i
end
put qnddl 0 n
end
fn qnsetg to void
qnsetd tfdata len tfdata
end
fn qnpfx t view uchar * to void
fpb
for i ulong get qnddl 0 bound 512
fpc get qndd i
end
fpt t
end
fn qnmk to void
qnpfx tqdir
x = makedir fpth 0 get fpthl 0 448
qnpfx tqoutdir
x = makedir fpth 0 get fpthl 0 448
end
fn qnread to bool
r = frdall
if lt r 0
put fxol 0 0
ret false
end
ret true
end
fn qnapp to bool
qnmk
qnpfx tqev
fd = fopen fpth 0 get fpthl 0 525377 384
if lt fd 0
ret false
end
left = get qnlinel 0
off = ulong 0
ok = true
while gt left 0 bound 256
k = write int fd qnline off left
if le k 0
ok = false
left = ulong 0
end
if gt k 0
off = add off ulong k
left = sub left ulong k
end
end
x = fsync int fd
x = fclose int fd
ret ok
end
fn qncc c uchar to void
n = get qnol 0
if lt n 8191
put qnout n c
put qnol 0 add n 1
end
if ge n 8191
put qnovf 0 1
end
end
fn qnct t view uchar * to void
for i ulong len t bound 64
qncc get t i
end
end
fn qnhcs a ulong n ulong to void
for i ulong n bound 64
qncc get qnhold add a i
end
end
fn qntok k ulong to bool
p = ulong 0
seen = ulong 0
while lt p get qnlinel 0 bound 256
while and lt p get qnlinel 0 eq get qnline p 32 bound 256
p = add p 1
end
q = p
while and lt q get qnlinel 0 ne get qnline q 32 bound 256
q = add q 1
end
if gt q p
if eq seen k
put qnt0 0 p
put qnt1 0 q
ret true
end
seen = add seen 1
end
p = q
end
ret false
end
fn qneq a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 64
if ne get qnline add a i get t i
ret false
end
end
ret true
end
fn qnstar a ulong n ulong to bool
if ne n 1
ret false
end
ret eq get qnhold a 42
end
fn qnholdline to void
n = get qnlinel 0
if gt n 256
n = ulong 256
end
for i ulong n bound 256
put qnhold i get qnline i
end
put qnholn 0 n
end
fn qncopyline s ulong e ulong to void
n = sub e s
if gt n 255
n = ulong 255
end
for i ulong n bound 256
put qnline i get qnev add s i
end
put qnlinel 0 n
end
fn qnsame a ulong n ulong b ulong m ulong to bool
if ne n m
ret false
end
for i ulong n bound 64
if ne get qnline add a i get qnhold add b i
ret false
end
end
ret true
end
fn qnmatch to bool
if not qntok 0
ret false
end
if not qneq get qnt0 0 sub get qnt1 0 get qnt0 0 tqkind
ret false
end
if not qntok 1
ret false
end
er = get qnt0 0
en = sub get qnt1 0 er
if not qntok 2
ret false
end
ea = get qnt0 0
eal = sub get qnt1 0 ea
if not qnstar get qnra 0 get qnrn 0
if not qnsame er en get qnra 0 get qnrn 0
ret false
end
end
if not qnstar get qnfa 0 get qnfn 0
if not qnsame ea eal get qnfa 0 get qnfn 0
ret false
end
end
ret true
end
fn qnuserok a ulong n ulong to bool
if or eq n 0 gt n 39
ret false
end
for i ulong n bound 39
c = get qnhold add a i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
end
ret true
end
fn qnwriteu a ulong n ulong to bool
qnpfx tqod
for i ulong n bound 39
fpc get qnhold add a i
end
fd = fopen fpth 0 get fpthl 0 524865 384
if lt fd 0
ret false
end
left = get qnol 0
off = ulong 0
ok = true
while gt left 0 bound 8192
k = write int fd qnout off left
if le k 0
ok = false
left = ulong 0
end
if gt k 0
off = add off ulong k
left = sub left ulong k
end
end
x = fsync int fd
x = fclose int fd
ret ok
end
fn qnnum v ulong to void
if ge v 10
qnnum div v 10
end
qncc add 48 uchar rem v 10
end
note qnscan: walk the event lines; count the matching ones, and when emit is true append the
note matching lines numbered from skip on (the newest 32 when there are more)
fn qnscan emit bool skip ulong to ulong
cnt = ulong 0
p = ulong 0
while lt p get qnevl 0 bound 65536
e = p
while lt e get qnevl 0 bound 65536
if eq get qnev e 10
break
end
e = add e 1
end
qncopyline p e
if qnmatch
if and emit ge cnt skip
qnnum cnt
qncc 32
for i ulong get qnlinel 0 bound 256
qncc get qnline i
end
qncc 10
end
cnt = add cnt 1
end
if lt e get qnevl 0
p = add e 1
end
if ge e get qnevl 0
p = e
end
end
ret cnt
end
fn qnfinish ua ulong un ulong to bool
put qnol 0 0
put qnovf 0 0
total = qnscan false 0
put qnol 0 0
qnct tqdv1
qnct tqsk
qnhcs ua un
qnct tqnl
qnct tqak
qnhcs get qnfa 0 get qnfn 0
qnct tqnl
qnct tqrk
qnhcs get qnra 0 get qnrn 0
qnct tqnl
qnct tqck
qnnum total
qncc 10
skip = ulong 0
if gt total 32
skip = sub total 32
end
k = qnscan true skip
if eq get qnovf 0 1
ret false
end
ret qnwriteu ua un
end
fn qnone to bool
qnholdline
if not qntok 0
ret false
end
ua = get qnt0 0
un = sub get qnt1 0 ua
if not qnuserok ua un
ret false
end
if not qntok 1
ret false
end
put qnfa 0 get qnt0 0
put qnfn 0 sub get qnt1 0 get qnt0 0
if not qntok 2
ret false
end
put qnra 0 get qnt0 0
put qnrn 0 sub get qnt1 0 get qnt0 0
ret qnfinish ua un
end
fn qnregen to bool
qnmk
put qnevl 0 0
qnpfx tqev
if qnread
n = get fxol 0
if gt n 65536
n = ulong 65536
end
for i ulong n bound 65536
put qnev i get fxo i
end
put qnevl 0 n
end
qnpfx tqsb
if not qnread
put qnsl 0 0
ret true
end
n = get fxol 0
if gt n 8192
n = ulong 8192
end
for i ulong n bound 8192
put qnsub i get fxo i
end
put qnsl 0 n
p = ulong 0
ok = true
while lt p get qnsl 0 bound 8192
e = p
while lt e get qnsl 0 bound 8192
if eq get qnsub e 10
break
end
e = add e 1
end
m = sub e p
if and gt m 0 le m 255
for i ulong m bound 256
put qnline i get qnsub add p i
end
put qnlinel 0 m
if not qnone
ok = false
end
end
if lt e get qnsl 0
p = add e 1
end
if ge e get qnsl 0
p = e
end
end
ret ok
end

note quiet/qn3http.om: /notifications, /notifications.json, the patch receipt section and .receipt JSON.
note qnpage only reads a digest file. qnregen runs from qnpost and from forge-contribute.
text tqnrel "notifications"
text tqjv "{\"format\":\"FORGE-EVIDENCE\",\"v\":1,\"verify\":\""
text tqjv2 "\",\"reason\":\""
text tqjv3 "\",\"commit\":\""
text tqjv4 "\",\"tree\":\""
text tqjv5 "\",\"rc\":"
text tqjv6 ",\"out\":\""
text tqjv7 "\",\"agent\":\""
text tqjv8 "\",\"cmd\":\""
text tqempty "{\"format\":\"QUIET-DIGEST\",\"v\":1,\"quiet\":true,\"count\":0}\n"
text tqjd1 "{\"format\":\"QUIET-DIGEST\",\"v\":1,\"quiet\":false,\"count\":"
text tqjd2 ",\"body\":\""
text tqnt "Notifications"
text tqnp "/notifications"
text tqnj "/notifications.json"
text tqrsuf ".receipt"
text tqrevp "rev-parse"
text tqtree "^{tree}"
text tqlogin "login"
text tqjson "application/json"
text tqpass "PASS"
text tqref "REFUSED"
text tqmiss "missing"
text tqred "redacted"
text tqpar "parse"
text tqbind "bind"
text tqcom "commit"
text tqtreer "tree"
text tqnull "null"
text tqagent "agent"
text tqrepo "repo"
text tqdash "-"
text tqh1 "<section class=\"box\"><h2>Evidence receipt</h2>\n"
text tqh2 "<p class=\"meta\">verify "
text tqh3 "</p>\n<p>commit <code>"
text tqh4 "</code></p>\n<p>tree <code>"
text tqh5 "</code></p>\n<p>command <code>"
text tqh6 "</code></p>\n<p>exit <code>"
text tqh7 "</code> &#183; output sha256 <code>"
text tqh8 "</code></p>\n<p>agent <code>"
text tqh9 "</code></p>\n<p><a href=\""
text tqha "\">machine-checkable receipt</a></p>\n</section>\n"
text tqhb "<p class=\"muted\">No evidence receipt on this patch. The machine-checkable link still answers, and it refuses.</p>\n<p><a href=\""
text tqok1 "<b class=\"ok\">"
text tqbad "<b class=\"bad\">"
text tqbe "</b>"
text tqnp1 "<section class=\"box\"><h2>Notifications</h2>\n<p class=\"muted\">Quiet by default. One digest, written when you save a filter or when a patch event arrives. Opening this page does not write a digest.</p>\n"
text tqnp2 "<pre class=\"hit\">"
text tqnp3 "</pre>\n"
text tqnp4 "<p class=\"muted\">No digest file. Nothing is listed.</p>\n"
text tqfm1 "<form class=\"so-form\" method=\"post\" action=\""
text tqfm2 "\"><input type=\"hidden\" name=\"csrf\" value=\""
text tqfm3 "\">\n<label>Agent <input name=\"agent\" maxlength=\"39\" required></label>\n<label>Repo <input name=\"repo\" maxlength=\"39\" required></label>\n<button class=\"so-btn\" type=\"submit\">Save filter</button></form>\n<p class=\"muted\">Use * for any. Put - in either field to go quiet again.</p>\n</section>\n"
text tqwhy "Set a display name of letters, digits and hyphens before saving a filter."
text tqbadf "Agent and repo use letters, digits, hyphens, or * . - clears the filter."
global qnhd uchar 40
global qndig uchar 8192
global qndigl ulong 1
global qnba uchar 40
global qnbal ulong 1
global qnbr uchar 40
global qnbrl ulong 1
global qnbuf uchar 8192
global qnbl ulong 1
fn qnends a ulong n ulong to bool
if le n add a 8
ret false
end
s = sub n 8
for i ulong 8
if ne get frest add s i get tqrsuf i
ret false
end
end
ret true
end
fn qnload to void
put qnrcl 0 0
put qnst 0 0
if eq get gcrn 0 0
ret
end
r = sub get gcrn 0 1
for i ulong 40
put qnhd i get gcro add mul r 40 i
end
if eq get gcrx r 1
put qnst 0 1
ret
end
o = get gcrd mul r 2
n = get gcrd add mul r 2 1
if gt n 1024
n = ulong 1024
end
for i ulong n bound 1024
put qnrc i get gcpool add o i
end
put qnrcl 0 n
end
fn qnheq to bool
for i ulong 40
if ne get qncm i get qnhd i
ret false
end
end
ret true
end
fn qngitree to bool
fkgit
fka tqrevp
fkopen
for i ulong 40
fkc get qnhd i
end
fkt tqtree
r = fexec 5000000000
if ne r 0
ret false
end
if lt get fxol 0 40
ret false
end
for i ulong 40
if ne get fxo i get qntr i
ret false
end
end
ret true
end
fn qncheck to void
qnload
if eq get qnst 0 1
ret
end
if not qnparse
ret
end
if not qnbindok
ret
end
if not qnheq
put qnst 0 4
ret
end
if not qngitree
put qnst 0 5
ret
end
put qnst 0 6
end
fn qnwhy to void
s = get qnst 0
if eq s 6
fput tqpass
ret
end
if eq s 0
fput tqmiss
ret
end
if eq s 1
fput tqred
ret
end
if eq s 2
fput tqpar
ret
end
if eq s 3
fput tqbind
ret
end
if eq s 4
fput tqcom
ret
end
fput tqtreer
end
fn qnlink to void
fputb
fputrepo
fput tcpats
fputc 47
for i ulong get gcrql 0 bound 40
fescc get gcrq i
end
fput tqrsuf
end
fn qnshow to void
qncheck
fput tqh1
fput tqh2
if eq get qnst 0 6
fput tqok1
fput tqpass
fput tqbe
end
if ne get qnst 0 6
fput tqbad
fput tqref
fputc 32
qnwhy
fput tqbe
end
fput tqh3
if gt get qnst 0 2
for i ulong 40
fescc get qncm i
end
end
fput tqh4
if gt get qnst 0 2
for i ulong 40
fescc get qntr i
end
end
fput tqh5
if gt get qnst 0 2
for i ulong get qncmdl 0 bound 200
fescc get qncmd i
end
end
fput tqh6
if gt get qnst 0 2
fnum get qnrcn 0
end
fput tqh7
if gt get qnst 0 2
for i ulong 64
fescc get qnout64 i
end
end
fput tqh8
if gt get qnst 0 2
for i ulong get qnagl 0 bound 40
fescc get qnag i
end
end
fput tqh9
qnlink
fput tqha
end
fn qnjesc c uchar to void
if eq c 34
fputc 92
fputc 34
ret
end
if eq c 92
fputc 92
fputc 92
ret
end
if or lt c 32 eq c 127
fputc 63
ret
end
fputc c
end
fn qnjson to void
put fkind 0 1
fsetct tqjson
fput tqjv
if eq get qnst 0 6
fput tqpass
end
if ne get qnst 0 6
fput tqref
end
fput tqjv2
qnwhy
fput tqjv3
if gt get qnst 0 2
for i ulong 40
fputc get qncm i
end
end
fput tqjv4
if gt get qnst 0 2
for i ulong 40
fputc get qntr i
end
end
fput tqjv5
if gt get qnst 0 2
fnum get qnrcn 0
end
if le get qnst 0 2
fput tqnull
end
fput tqjv6
if gt get qnst 0 2
for i ulong 64
fputc get qnout64 i
end
end
fput tqjv7
if gt get qnst 0 2
for i ulong get qnagl 0 bound 40
qnjesc get qnag i
end
end
fput tqjv8
if gt get qnst 0 2
for i ulong get qncmdl 0 bound 200
qnjesc get qncmd i
end
end
fputc 34
fputc 125
fputc 10
end
fn qnraw to long
if eq corefs 1 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 1 false
ret 404
end
qncheck
qnjson
ret 200
end
fn qnsess to long
x = sosess
ret x
end
fn qnpage js ulong to long
x = sosess
if eq get fuserl 0 0
if eq js 1
put fkind 0 1
fsetct tqjson
fput tqempty
ret 401
end
put fkind 0 2
flocb
floct tqlogin
ret 303
end
qnsetg
qnpfx tqod
for i ulong get fuserl 0 bound 64
fpc get fuser i
end
put qndigl 0 0
if qnread
n = get fxol 0
if gt n 8192
n = ulong 8192
end
for i ulong n bound 8192
put qndig i get fxo i
end
put qndigl 0 n
end
if eq js 1
ret qnjd
end
fsetti tqnt
fput tqnp1
if eq get qndigl 0 0
fput tqnp4
end
if gt get qndigl 0 0
fput tqnp2
for i ulong get qndigl 0 bound 8192
fescc get qndig i
end
fput tqnp3
end
fput tqfm1
fputb
fput tqnrel
fput tqfm2
socsrfout
fput tqfm3
ret 200
end
fn qnjd to long
put fkind 0 1
fsetct tqjson
if eq get qndigl 0 0
fput tqempty
ret 200
end
fput tqjd1
c = qncount
fnum c
fput tqjd2
for i ulong get qndigl 0 bound 8192
qnjesc get qndig i
end
fputc 34
fputc 125
fputc 10
ret 200
end
fn qncount to ulong
n = ulong 0
head = true
p = ulong 0
while lt p get qndigl 0 bound 8192
c = get qndig p
if and head and ge c 48 le c 57
n = add n 1
end
head = eq c 10
p = add p 1
end
ret n
end
fn qntok1 c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 122
ret true
end
if eq c 45
ret true
end
if eq c 42
ret true
end
ret false
end
fn qnokb w ulong i ulong to uchar
if eq w 1
ret get qnbr i
end
ret get qnba i
end
fn qnokg w ulong to bool
n = get qnbal 0
if eq w 1
n = get qnbrl 0
end
if or eq n 0 gt n 39
ret false
end
if and eq n 1 eq (qnokb w 0) 45
ret true
end
for i ulong n bound 39
if not qntok1 (qnokb w i)
ret false
end
end
ret true
end
fn qnfok to bool
n = get fuserl 0
if or eq n 0 gt n 39
ret false
end
for i ulong n bound 39
c = get fuser i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
end
ret true
end
fn qnpost to long
x = sosess
r = sowpre
if ne r 0
ret r
end
if not qnfok
fsetti tqnt
fput tqwhy
ret 400
end
al = fbget tqagent
if lt al 0
ret 400
end
put qnbal 0 ulong al
for i ulong get qnbal 0 bound 40
put qnba i get fval i
end
rl = fbget tqrepo
if lt rl 0
ret 400
end
put qnbrl 0 ulong rl
for i ulong get qnbrl 0 bound 40
put qnbr i get fval i
end
if not qnokg 0
fsetti tqnt
fput tqbadf
ret 400
end
if not qnokg 1
fsetti tqnt
fput tqbadf
ret 400
end
qnsetg
if not qnsubw
ret 500
end
if not qnregen
ret 500
end
put fkind 0 2
flocb
floct tqnrel
ret 303
end
fn qnsubw to bool
qnmk
qnpfx tqsb
qnsubrd
qnsubfit
if not qndrop
qnsubadd
end
ret qnsubsv
end
fn qnsubrd to void
put qnsl 0 0
if not qnread
ret
end
n = get fxol 0
if gt n 8192
n = ulong 8192
end
for i ulong n bound 8192
put qnsub i get fxo i
end
put qnsl 0 n
end
fn qnsubfit to void
put qnbl 0 0
p = ulong 0
while lt p get qnsl 0 bound 8192
e = qnsube p
if not qnuserline p e
qnsubcopy p e
end
if lt e get qnsl 0
p = add e 1
end
if ge e get qnsl 0
p = e
end
end
end
fn qnsube p ulong to ulong
e = p
while lt e get qnsl 0 bound 8192
if eq get qnsub e 10
break
end
e = add e 1
end
ret e
end
fn qnsubcopy p ulong e ulong to void
for i ulong sub e p bound 256
qnbbc get qnsub add p i
end
if lt e get qnsl 0
qnbbc 10
end
end
fn qnbbc c uchar to void
n = get qnbl 0
if lt n 8191
put qnbuf n c
put qnbl 0 add n 1
end
end
fn qndrop to bool
if and eq get qnbal 0 1 eq get qnba 0 45
ret true
end
ret and eq get qnbrl 0 1 eq get qnbr 0 45
end
fn qnsubadd to void
for i ulong get fuserl 0 bound 40
qnbbc get fuser i
end
qnbbc 32
for i ulong get qnbal 0 bound 40
qnbbc get qnba i
end
qnbbc 32
for i ulong get qnbrl 0 bound 40
qnbbc get qnbr i
end
qnbbc 10
end
fn qnsubsv to bool
fd = fopen fpth 0 get fpthl 0 524865 384
if lt fd 0
ret false
end
off = ulong 0
left = get qnbl 0
ok = true
while gt left 0 bound 8192
k = write int fd qnbuf off left
if le k 0
ok = false
left = ulong 0
end
if gt k 0
off = add off ulong k
left = sub left ulong k
end
end
x = fsync int fd
x = fclose int fd
ret ok
end
fn qnuserline p ulong e ulong to bool
n = get fuserl 0
if lt sub e p n
ret false
end
for i ulong n bound 40
if ne get qnsub add p i get fuser i
ret false
end
end
if eq sub e p n
ret true
end
ret eq get qnsub add p n 32
end
fn qnroute to long
m = get fmeth 0
if fpeq tqnp
if eq m 3
ret qnpost
end
if eq m 1
ret qnpage 0
end
ret 405
end
if fpeq tqnj
if eq m 1
ret qnpage 1
end
ret 405
end
ret 0
end

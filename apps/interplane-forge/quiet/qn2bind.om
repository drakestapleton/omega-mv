note quiet/qn2bind.om: FORGE-EVIDENCE v1 bind. The six field lines are hashed; the bind line is not.
note Both forge-contribute and the patch page call qncanon, so a stale bind cannot pass.
text tqev1 "FORGE-EVIDENCE v1"
text tqcmt "commit="
text tqtre "tree="
text tqcmdk "cmd="
text tqrck "rc="
text tqoutk "out="
text tqagk2 "agent="
text tqbnd "bind="
global qnrc uchar 1024
global qnrcl ulong 1
global qncm uchar 40
global qntr uchar 40
global qncmd uchar 200
global qncmdl ulong 1
global qnrcn ulong 1
global qnout64 uchar 64
global qnag uchar 40
global qnagl ulong 1
global qnbd uchar 64
global qncan uchar 512
global qncanl ulong 1
global qnst ulong 1
fn qnhexd c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
fn qnhxb v uchar to uchar
if lt v 10
ret add v 48
end
ret add v 87
end
fn qncanb c uchar to void
n = get qncanl 0
if lt n 511
put qncan n c
put qncanl 0 add n 1
end
end
fn qncant t view uchar * to void
for i ulong len t bound 16
qncanb get t i
end
end
note qncanh: n is 40 (commit, tree), 64 (out), at most 39 (agent) or at most 200 (cmd: qncopy and
note qncanon refuse more), so the bound is 200, the largest. It was 64: a cmd of 65 bytes was trap 4.
fn qncanh a ulong n ulong src ulong to void
for i ulong n bound 200
if eq src 0
qncanb get qncm i
end
if eq src 1
qncanb get qntr i
end
if eq src 2
qncanb get qnout64 i
end
if eq src 3
qncanb get qnag i
end
if eq src 4
qncanb get qncmd i
end
end
end
fn qncand v ulong to void
if ge v 10
qncand div v 10
end
qncanb add 48 uchar rem v 10
end
fn qncanon to bool
put qncanl 0 0
if ne get qncmdl 0 0
if gt get qncmdl 0 200
ret false
end
end
if or eq get qnagl 0 0 gt get qnagl 0 39
ret false
end
if gt get qnrcn 0 255
ret false
end
qncant tqcmt
qncanh 0 40 0
qncanb 10
qncant tqtre
qncanh 0 40 1
qncanb 10
qncant tqcmdk
qncanh 0 get qncmdl 0 4
qncanb 10
qncant tqrck
qncand get qnrcn 0
qncanb 10
qncant tqoutk
qncanh 0 64 2
qncanb 10
qncant tqagk2
qncanh 0 get qnagl 0 3
qncanb 10
if gt get qncanl 0 511
ret false
end
ret true
end
fn qnsha hh edit uchar * to void
b = new uchar 512 0
n = get qncanl 0
for i ulong n bound 512
put b i get qncan i
end
k = sha2_digest 256 view part b 0 n hh
end
fn qnseal to bool
if not qncanon
ret false
end
h = new uchar 32 0
qnsha h
put qnrcl 0 0
for i ulong len tqev1
put qnrc i get tqev1 i
end
put qnrcl 0 len tqev1
put qnrc get qnrcl 0 10
put qnrcl 0 add get qnrcl 0 1
for i ulong get qncanl 0 bound 512
put qnrc add get qnrcl 0 i get qncan i
end
put qnrcl 0 add get qnrcl 0 get qncanl 0
for i ulong len tqbnd
put qnrc add get qnrcl 0 i get tqbnd i
end
put qnrcl 0 add get qnrcl 0 len tqbnd
for i ulong 32
v = get h i
put qnrc add get qnrcl 0 mul i 2 qnhxb shr v 4
put qnrc add add get qnrcl 0 mul i 2 1 qnhxb and v 15
end
put qnrcl 0 add get qnrcl 0 64
put qnrc get qnrcl 0 10
put qnrcl 0 add get qnrcl 0 1
ret true
end
fn qnlnat p ulong to ulong
q = p
while lt q get qnrcl 0 bound 1024
if eq get qnrc q 10
ret q
end
q = add q 1
end
ret get qnrcl 0
end
fn qnpre p ulong t view uchar * to bool
if gt add p len t get qnrcl 0
ret false
end
for i ulong len t bound 16
if ne get qnrc add p i get t i
ret false
end
end
ret true
end
fn qncopy p ulong n ulong dst ulong to bool
if eq dst 0
if ne n 40
ret false
end
for i ulong 40
c = get qnrc add p i
if not qnhexd c
ret false
end
put qncm i c
end
ret true
end
if eq dst 1
if ne n 40
ret false
end
for i ulong 40
c = get qnrc add p i
if not qnhexd c
ret false
end
put qntr i c
end
ret true
end
if eq dst 2
if or eq n 0 gt n 200
ret false
end
for i ulong n bound 200
c = get qnrc add p i
if or lt c 32 eq c 127
ret false
end
put qncmd i c
end
put qncmdl 0 n
ret true
end
if eq dst 3
if or eq n 0 gt n 3
ret false
end
v = ulong 0
for i ulong n bound 3
c = get qnrc add p i
if not and ge c 48 le c 57
ret false
end
v = add mul v 10 sub ulong c 48
end
if gt v 255
ret false
end
if and gt n 1 eq get qnrc p 48
ret false
end
put qnrcn 0 v
ret true
end
if eq dst 4
if ne n 64
ret false
end
for i ulong 64
c = get qnrc add p i
if not qnhexd c
ret false
end
put qnout64 i c
end
ret true
end
if eq dst 5
if or eq n 0 gt n 39
ret false
end
for i ulong n bound 39
c = get qnrc add p i
ok = false
if and ge c 48 le c 57
ok = true
end
if and ge c 97 le c 122
ok = true
end
if eq c 45
ok = true
end
if not ok
ret false
end
put qnag i c
end
put qnagl 0 n
ret true
end
if eq dst 6
if ne n 64
ret false
end
for i ulong 64
c = get qnrc add p i
if not qnhexd c
ret false
end
put qnbd i c
end
ret true
end
ret false
end
fn qnmark to ulong
n = get qnrcl 0
m = len tqev1
p = ulong 0
while lt p n bound 1024
e = qnlnat p
if eq sub e p m
hit = true
for i ulong m bound 20
if ne get qnrc add p i get tqev1 i
hit = false
end
end
if hit
if eq e n
ret 9999
end
ret add e 1
end
end
p = add e 1
if eq e n
p = n
end
end
ret 9999
end
fn qnfield p ulong t view uchar * dst ulong to ulong
e = qnlnat p
if not qnpre p t
ret 9999
end
a = add p len t
if gt a e
ret 9999
end
if not qncopy a sub e a dst
ret 9999
end
if eq e get qnrcl 0
ret e
end
ret add e 1
end
fn qnparse to bool
p = qnmark
if eq p 9999
put qnst 0 0
ret false
end
p = qnfield p tqcmt 0
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqtre 1
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqcmdk 2
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqrck 3
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqoutk 4
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqagk2 5
if eq p 9999
put qnst 0 2
ret false
end
p = qnfield p tqbnd 6
if eq p 9999
put qnst 0 2
ret false
end
ret true
end
fn qnbindok to bool
if not qncanon
put qnst 0 2
ret false
end
h = new uchar 32 0
qnsha h
hex = new uchar 64 0
for i ulong 32
v = get h i
put hex mul i 2 qnhxb shr v 4
put hex add mul i 2 1 qnhxb and v 15
end
for i ulong 64
if ne get hex i get qnbd i
put qnst 0 3
ret false
end
end
ret true
end

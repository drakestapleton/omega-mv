note browse/c3_blame.om: /blame/<ref>/<path> from git blame --porcelain, and the in-repo code
note search /search?q= (git grep, fixed string, case-insensitive, capped) (ForgeBrowse).
global gbbk ulong 4096
global gbba ulong 4096
global gbbal ulong 4096
global gbbt ulong 4096
global gbbs ulong 4096
global gbbsl ulong 4096
global gbbo ulong 4096
global gbbn ulong 1
global gbbc ulong 1
global gbbp ulong 1
global gbq uchar 256
global gbql ulong 1
const BRBLMX ulong 4096
const BRHITS ulong 200
text tbporc "--porcelain"
text tbkauth "author "
text tbkatim "author-time "
text tbksumm "summary "
text tbtblm "Blame"
text tbtsrch "Search"
text tbbl1 "<table class=\"code blame\"><tbody>\n"
text tbbl2 "\"><td class=\"bl\">"
text tbbl3 "</td><td class=\"ln\"><a href=\"#L"
text tbbl4 "<a class=\"mono\" href=\""
text tbbl5 "</a> <span class=\"meta\">"
text tbbl6 "</span> "
text tbbl7 "<tr class=\"bs\" id=\"L"
text tbblcut "<p class=\"muted\">Blame output was cut.</p>\n"
text tbgrep "grep"
text tbgz "-z"
text tbgn "-n"
text tbgi "-I"
text tbgii "-i"
text tbgf "-F"
text tbgmc "--max-count=5"
text tbge "-e"
text tbsf1 "<h2>Search</h2>\n<form class=\"inline\" method=\"get\" action=\""
text tbsf2 "/search\"><input type=\"search\" name=\"q\" maxlength=\"256\" value=\""
text tbsf3 "\" aria-label=\"Search this repository\"> <button type=\"submit\">Search</button></form>\n"
text tbsf4 "<p class=\"meta\">Fixed-string, case-insensitive search of the default branch <code>"
text tbsf5 "</code>; at most 5 lines per file and 200 lines in total.</p>\n"
text tbsh1 "<div class=\"box\"><p><a href=\""
text tbsh2 "</a></p>\n"
text tbsh3 "<p class=\"hit\"><a class=\"mono\" href=\""
text tbsh4 "</a> <code>"
text tbsh5 "</code></p>\n"
text tbsnone "<p class=\"muted\">No matches.</p>\n"
text tbsmore "<p class=\"muted\">Only the first 200 matching lines are shown.</p>\n"
text tbsbad "<p class=\"err\">The search text may not contain control characters.</p>\n"
text tbq1 "q"
note ---- blame
fn brblamepg to long
if not brres
ret brerr 404
end
if eq get gbpl 0 0
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 1
brloc tbtree
ret 302
end
fkgit
fka tbblame
fka tbporc
fkopen
brksha
fka tbdd
fkopen
brkp
st = fexec BRTMO
if ne st 0
ret brerr 404
end
brti tbtblm
frepohd 0
brrefbar
brcrumb
brblame
ret 200
end
note brbkey: the first 16 hex of the sha at fxo[a] as a number
fn brbkey a ulong to ulong
v = ulong 0
for i ulong 16
v = add shl v 4 brhexv get fxo add a i
end
ret v
end
fn brbfind key ulong to ulong
n = get gbbn 0
for i ulong n bound 4096
if eq get gbbk i key
ret i
end
end
ret n
end
note brbishdr: fxo[s, e) starts with 40 lowercase hex and a space
fn brbishdr s ulong e ulong to bool
if lt sub e s 41
ret false
end
for i ulong 40
if not brlhex get fxo add s i
ret false
end
end
ret eq get fxo add s 40 32
end
note brblame: walk the porcelain: header "<sha> <orig> <final>[ <n>]", key lines, then "\t<line>"
fn brblame to void
put gbbn 0 0
put gbbc 0 0
put gbbp 0 0
n = get fxol 0
cur = ulong 0
ln = ulong 0
fput tbbl1
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
c = uchar 10
if lt s e
c = get fxo s
end
if eq c 9
brbline cur ln add s 1 e
end
if brbishdr s e
cur = brbhdr s e
ln = brbfin s e
else
if ne c 9
brbkv cur s e
end
end
s = add e 1
end
fput tbtab2
if ne get fxotr 0 0
fput tbblcut
end
end
note brbhdr: the table index for the header's sha (a new entry when unseen; BRBLMX when full)
fn brbhdr s ulong e ulong to ulong
key = brbkey s
i = brbfind key
n = get gbbn 0
if lt i n
ret i
end
if ge n BRBLMX
ret BRBLMX
end
put gbbk n key
put gbbo n s
put gbbal n 0
put gbbsl n 0
put gbbt n 0
put gbbn 0 add n 1
ret n
end
note brbfin: the final line number (third field of the header)
fn brbfin s ulong e ulong to ulong
a = brxfind add s 41 e 32
ret brxdec add a 1 e
end
fn brbkv cur ulong s ulong e ulong to void
if ge cur BRBLMX
ret
end
if brxat s e tbkatim
put gbbt cur brxdec add s len tbkatim e
ret
end
if brxat s e tbkauth
put gbba cur add s len tbkauth
put gbbal cur sub e add s len tbkauth
ret
end
if brxat s e tbksumm
put gbbs cur add s len tbksumm
put gbbsl cur sub e add s len tbksumm
end
end
note brbline: one content row; the first row of each run of one commit carries its info
fn brbline cur ulong ln ulong a ulong e ulong to void
key = ulong 0
if lt cur BRBLMX
key = get gbbk cur
end
first = or ne key get gbbp 0 eq get gbbc 0 0
put gbbp 0 key
put gbbc 0 add get gbbc 0 1
if first
fput tbbl7
else
fput tbcd2
end
fnum ln
fput tbbl2
if and first lt cur BRBLMX
brbcinfo cur
end
fput tbbl3
fnum ln
fput tbaq
fnum ln
fput tbcd4
fxesc a sub e a
fput tbcd5
end
fn brbcinfo cur ulong to void
o = get gbbo cur
fput tbbl4
brucmt o 40
fput tbaq
fxput o 7
fput tbbl5
brdate get gbbt cur
fput tbbl6
fxesc get gbba cur get gbbal cur
fputc 58
fputc 32
m = get gbbsl cur
if gt m 80
m = 80
end
fxesc get gbbs cur m
end
note ---- /search?q=
fn brsrchpg to long
if gt get gbrl 0 0
ret brerr 404
end
q = fqget tbq1
put gbql 0 0
bad = false
if gt q 256
ret brerr 400
end
if gt q 0
bad = not brsq ulong q
end
brdefref
if not brres
ret brerr 404
end
brti tbtsrch
frepohd 0
brsform
if bad
fput tbsbad
ret 400
end
if gt get gbql 0 0
brsrun
end
ret 200
end
note brsq: copy fval[0, n) into gbq; false on a control byte
fn brsq n ulong to bool
for i ulong n bound 256
c = get fval i
if or lt c 32 eq c 127
put gbql 0 0
ret false
end
put gbq i c
end
put gbql 0 n
ret true
end
fn brsform to void
fput tbsf1
brurepo
fput tbsf2
for i ulong get gbql 0
fescc get gbq i
end
fput tbsf3
fput tbsf4
brrefesc
fput tbsf5
end
fn brsrun to void
fkgit
fka tbgrep
fka tbgz
fka tbgn
fka tbgi
fka tbgii
fka tbgf
fka tbnocol
fka tbgmc
fka tbge
fkopen
for i ulong get gbql 0
fkc get gbq i
end
fkopen
brksha
st = fexec BRTMO
n = get fxol 0
if or ne st 0 eq n 0
fput tbsnone
ret
end
brshits n
end
note brshits: lines "<sha>:<path>\0<line>\0<text>", grouped by file
fn brshits n ulong to void
s = ulong 0
c = ulong 0
pa = ulong 0
pl = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
a = add s 41
z = brxfind a e 0
if and lt a z lt z e
if not brxsame pa pl a sub z a
if gt pl 0
fput tbdive
end
brshead a sub z a
pa = a
pl = sub z a
end
brshit a sub z a add z 1 e
c = add c 1
end
if ge c BRHITS
if lt add e 1 n
fput tbdive
fput tbsmore
ret
end
end
s = add e 1
end
if gt pl 0
fput tbdive
end
end
fn brxsame a ulong l ulong b ulong m ulong to bool
if ne l m
ret false
end
for i ulong l bound BRBIG
if ne get fxo add a i get fxo add b i
ret false
end
end
ret true
end
fn brsblob a ulong l ulong to void
bruact tbblob
fputc 47
bruxo a l
end
fn brshead a ulong l ulong to void
fput tbsh1
brsblob a l
fput tbaq
fxesc a l
fput tbsh2
end
fn brshit a ulong l ulong b ulong e ulong to void
y = brxfind b e 0
fput tbsh3
brsblob a l
fputc 35
fputc 76
fxput b sub y b
fput tbaq
fxput b sub y b
fput tbsh4
t = add y 1
m = ulong 0
if lt t e
m = sub e t
end
if gt m 300
m = 300
end
fxesc t m
fput tbsh5
end

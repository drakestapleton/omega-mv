note browse/b_md.om (ForgeBrowse): safe Markdown renderer (CommonMark subset plus GFM tables,
note strikethrough, task items and bare https autolinks). Source: fxo[a, b); output: fob.
note Safety: every source byte reaches fob through fescc or the URL encoder; raw HTML is escaped,
note never passed through; link schemes other than http, https and mailto render as plain text;
note an HTML comment ("<!--" up to the first "-->") renders nothing (comment section below); an
note opener without a closing "-->" stays escaped text;
note images load only from this repo (relative paths -> /raw/<ref>/...); an external image renders
note as its alt text only. Relative links resolve against gbmd (the document's directory) at gbref.
global gbm ulong 40
global gbmlm ulong 8
global gbmlc ulong 8
global gbmlt ulong 8
global gbmlk ulong 8
global gbmta uchar 64
global gbmd uchar 4096
global gbmdl ulong 1
global gbmu uchar 4096
global gbmul ulong 1
global gbmrd ulong 512
global gbmrn ulong 1
const BMP ulong 0
const BMPW ulong 1
const BMF ulong 2
const BMFC ulong 3
const BMFN ulong 4
const BMFI ulong 5
const BMQ ulong 6
const BMT ulong 7
const BMTC ulong 8
const BMIC ulong 9
const BMIB ulong 10
const BML ulong 11
const BMB ulong 12
const BMSK ulong 13
const BMHB ulong 14
const BMFP ulong 15
const BMCP ulong 16
const BMMC ulong 17
const BMMP ulong 18
const BMMN ulong 19
const BMDS ulong 20
const BMDE ulong 21
const BMTS ulong 22
const BMTE ulong 23
const BMNS ulong 24
const BMNE ulong 25
const BMTK ulong 26
const BMMK ulong 27
note BMXE: end after the "-->" of an open comment block (0 = none); BMDB: end of the document;
note BMCV/BMCF/BMCX: cached comment-closer lookup (no "-->" starts in [BMCF, BMCX); BMCX is one or BMDB)
const BMXE ulong 28
const BMDB ulong 29
const BMCV ulong 30
const BMCF ulong 31
const BMCX ulong 32
text tbmp "<p>"
text tbmpe "</p>\n"
text tbmpre "<pre><code>"
text tbmprl "<pre><code class=\"language-"
text tbmpree "</code></pre>\n"
text tbmbq "<blockquote>\n"
text tbmbqe "</blockquote>\n"
text tbmul "<ul>\n"
text tbmule "</ul>\n"
text tbmol "<ol>\n"
text tbmols "<ol start=\""
text tbmole "</ol>\n"
text tbmli "<li>"
text tbmlie "</li>\n"
text tbmhr "<hr>\n"
text tbmbr "<br>\n"
text tbmtab "<table class=\"md\">\n<thead>\n<tr>"
text tbmthe "</tr>\n</thead>\n<tbody>\n"
text tbmtabe "</tbody>\n</table>\n"
text tbmtr "<tr>"
text tbmtre "</tr>\n"
text tbmthl "<th class=\"md-l\">"
text tbmthc "<th class=\"md-c\">"
text tbmthr "<th class=\"md-r\">"
text tbmth "<th>"
text tbmthx "</th>"
text tbmtdl "<td class=\"md-l\">"
text tbmtdc "<td class=\"md-c\">"
text tbmtdr "<td class=\"md-r\">"
text tbmtd "<td>"
text tbmtdx "</td>"
text tbmcode "<code>"
text tbmcodx "</code>"
text tbmem "<em>"
text tbmemx "</em>"
text tbmst "<strong>"
text tbmstx "</strong>"
text tbmdel "<del>"
text tbmdelx "</del>"
note tbmaext: a link that leaves the site (http, https, mailto or protocol-relative, and the http(s)
note autolinks) gets class "ext" (the stylesheet draws an arrow and says "leaves this site") and
note neither the referrer nor the opener
text tbmaext "\" class=\"ext\" rel=\"nofollow noopener noreferrer\">"
text tbmtitl "\" title=\""
text tbmimg "<img src=\""
text tbmalt "\" alt=\""
text tbmimgx "\">"
text tbmblob "/blob/"
text tbmraw "/raw/"
text tbmmail "mailto:"
text tbmhttp "http"
text tbmhttps "https"
text tbmmto "mailto"
text tbmbh "http://"
text tbmbhs "https://"
text tbmchk "<input type=\"checkbox\" disabled> "
text tbmchkd "<input type=\"checkbox\" disabled checked> "
text tbmimgw "image"
text tbmaq "\">\n"
text tbmh "<h"
text tbmhid " id=\""
text tbmhx "</h"
text tbmgt ">\n"
note ---- state helpers
fn brmg k ulong to ulong
ret get gbm k
end
fn brms k ulong v ulong to void
put gbm k v
end
fn brmreset to void
for i ulong 40
put gbm i 0
end
put gbmrn 0 0
end
fn brmc a ulong to uchar
ret get fxo a
end
fn brpunct c uchar to bool
if and ge c 33 le c 47
ret true
end
if and ge c 58 le c 64
ret true
end
if and ge c 91 le c 96
ret true
end
ret and ge c 123 le c 126
end
note brmcols: whitespace columns at the start of fxo[p, e) (tab = to the next multiple of 4);
note the first non-space position goes to gbm[BMFP]
fn brmcols p ulong e ulong to ulong
c = ulong 0
i = p
while lt i e bound BRBIG
x = get fxo i
if eq x 32
c = add c 1
else
if ne x 9
break
end
c = add sub c rem c 4 4
end
i = add i 1
end
brms BMFP i
ret c
end
note brmskipc: position after up to `cols` whitespace columns of fxo[p, e)
fn brmskipc p ulong e ulong cols ulong to ulong
c = ulong 0
i = p
while lt i e bound BRBIG
if ge c cols
ret i
end
x = get fxo i
if eq x 32
c = add c 1
else
if ne x 9
ret i
end
c = add sub c rem c 4 4
end
i = add i 1
end
ret i
end
fn brmblank p ulong e ulong to bool
i = p
while lt i e bound BRBIG
if not brspc get fxo i
ret false
end
i = add i 1
end
ret true
end
note brmtrim: end of fxo[p, e) without trailing spaces and tabs
fn brmtrim p ulong e ulong to ulong
k = e
while gt k p bound BRBIG
if not brspc get fxo sub k 1
ret k
end
k = sub k 1
end
ret k
end
fn brmspan p ulong e ulong to void
i = p
while lt i e bound BRBIG
fescc get fxo i
i = add i 1
end
end
note ---- block closers
fn brmcp to void
if eq brmg BMP 1
if eq brmg BMPW 1
fput tbmpe
else
fputc 10
end
end
brms BMP 0
brms BMHB 0
end
fn brmct to void
if eq brmg BMT 1
fput tbmtabe
end
brms BMT 0
end
fn brmci to void
if eq brmg BMIC 1
fput tbmpree
end
brms BMIC 0
brms BMIB 0
end
fn brmcf to void
if eq brmg BMF 1
fput tbmpree
end
brms BMF 0
end
fn brmcleaf to void
brmcp
brmct
brmci
brmcf
end
fn brmlclose to void
l = brmg BML
if eq l 0
ret
end
brmcleaf
fput tbmlie
if eq get gbmlt sub l 1 1
fput tbmole
else
fput tbmule
end
brms BML sub l 1
end
fn brmclist k ulong to void
while gt brmg BML k bound BRBIG
brmlclose
end
end
fn brmsetq q ulong to void
brmclist 0
brmcleaf
while gt brmg BMQ q bound BRBIG
fput tbmbqe
brms BMQ sub brmg BMQ 1
end
while lt brmg BMQ q bound BRBIG
fput tbmbq
brms BMQ add brmg BMQ 1
end
end
note ---- entry point
fn brmd a ulong b ulong to void
brmreset
brms BMDB b
brmdefs a b
s = a
while lt s b bound BRBIG
e = brxfind s b 10
k = e
if gt k s
if eq get fxo sub k 1 13
k = sub k 1
end
end
if eq brmg BMSK 1
brms BMSK 0
else
if gt brmg BMXE 0
brmcline k
else
brmline s k add e 1 b
end
end
s = add e 1
end
brmsetq 0
end
note brmq: count blockquote markers of fxo[s, e) (at most `lim`); content start to gbm[BMCP]
fn brmq s ulong e ulong lim ulong to ulong
q = ulong 0
p = s
while lt q lim bound BRBIG
i = brmskipc p e 3
if ge i e
break
end
if ne get fxo i 62
break
end
q = add q 1
p = add i 1
if lt p e
if eq get fxo p 32
p = add p 1
end
end
end
brms BMCP p
ret q
end
fn brmline s ulong e ulong nx ulong b ulong to void
if eq brmg BMF 1
if brmfline s e
ret
end
end
q = brmq s e 64
p = brmg BMCP
bl = brmblank p e
if ne q brmg BMQ
if and lt q brmg BMQ brmlazy p e bl
brmpline p e
brms BMB 0
ret
end
brmsetq q
end
if bl
brmcp
brmct
if eq brmg BMIC 1
brms BMIB add brmg BMIB 1
end
brms BMB 1
ret
end
brmblock p e nx b
brms BMB 0
end
note brmlazy: a line continuing an open paragraph without its container markers
fn brmlazy p ulong e ulong bl bool to bool
if bl
ret false
end
if ne brmg BMP 1
ret false
end
ret brmplain p e
end
fn brmplain p ulong e ulong to bool
i = brmcols p e
f = brmg BMFP
if ge i 4
ret true
end
c = get fxo f
if or eq c 35 eq c 62
ret false
end
if eq c 60
if gt brmcbx f e 0
ret false
end
end
if or brmisfence f e brmhr f e
ret false
end
ret eq brmmark f e 0
end
note brmfline: a line while a fence is open; true when consumed
fn brmfline s ulong e ulong to bool
fq = brmg BMQ
q = brmq s e fq
if lt q fq
brmcf
ret false
end
p = brmskipc brmg BMCP e brmg BMFI
if brmfend p e
brmcf
ret true
end
brmspan p e
fputc 10
ret true
end
note brmfend: fxo[p, e) closes the open fence (same char, at least as long, nothing after)
fn brmfend p ulong e ulong to bool
i = brmcols p e
f = brmg BMFP
if ge i 4
ret false
end
if ge f e
ret false
end
c = get fxo f
if ne ulong c brmg BMFC
ret false
end
n = brmrun f e c
if lt n brmg BMFN
ret false
end
ret brmblank add f n e
end
fn brmrun f ulong e ulong c uchar to ulong
n = ulong 0
i = f
while lt i e bound BRBIG
if ne get fxo i c
ret n
end
n = add n 1
i = add i 1
end
ret n
end
note ---- containers: lists
fn brmblock p ulong e ulong nx ulong b ulong to void
i = brmcols p e
f = brmg BMFP
if eq brmg BMIC 1
if ge i add brmlci 4
brmicode p e
ret
end
brmci
end
m = ulong 0
if lt i add brmlci 4
if not brmhr f e
m = brmmark f e
end
end
if gt m 0
brmitem p e i m nx
ret
end
if eq brmg BML 0
brmleaf p e nx b 0
ret
end
brmlcont p e nx b i
end
note brmlci: content indent of the innermost open list item (0 outside lists)
fn brmlci to ulong
l = brmg BML
if eq l 0
ret 0
end
ret get gbmlc sub l 1
end
fn brmicode p ulong e ulong to void
if eq brmg BMIC 0
brmcp
fput tbmpre
brms BMIC 1
brms BMIB 0
end
for k ulong brmg BMIB bound BRBIG
fputc 10
end
brms BMIB 0
brmspan brmskipc p e add brmlci 4 e
fputc 10
end
note brmlcont: a non-marker line while a list is open
fn brmlcont p ulong e ulong nx ulong b ulong i ulong to void
if and eq brmg BMB 0 eq brmg BMP 1
if lt i brmlci
if brmplain p e
brmpline p e
ret
end
end
end
while gt brmg BML 0 bound BRBIG
if ge i brmlci
break
end
brmlclose
end
if eq brmg BML 0
brmleaf p e nx b 0
ret
end
if eq brmg BMB 1
brmcp
end
brmleaf brmskipc p e brmlci e nx b brmlci
end
note brmmark: list marker at f? 1 bullet, 2 ordered, 0 none. Sets BMMP (content position),
note BMMC (marker + spacing width) and BMMN (ordered start number)
fn brmmark f ulong e ulong to ulong
c = get fxo f
t = ulong 0
k = f
if or eq c 45 or eq c 42 eq c 43
t = 1
brms BMMK ulong c
k = add f 1
else
v = ulong 0
while lt k e bound BRBIG
if not brdig get fxo k
break
end
v = add mul v 10 ulong sub get fxo k 48
k = add k 1
end
if or eq k f gt sub k f 9
ret 0
end
if ge k e
ret 0
end
if and ne get fxo k 46 ne get fxo k 41
ret 0
end
t = 2
brms BMMK ulong get fxo k
k = add k 1
brms BMMN v
end
if lt k e
if not brspc get fxo k
ret 0
end
end
w = sub k f
sp = ulong 0
while lt k e bound BRBIG
if or ne get fxo k 32 ge sp 4
break
end
sp = add sp 1
k = add k 1
end
if eq sp 0
sp = 1
end
if ge sp 4
if ge k e
sp = 1
end
end
brms BMMP k
brms BMMC add w sp
ret t
end
fn brmlopen t ulong to void
if eq t 2
n = brmg BMMN
if eq n 1
fput tbmol
else
fput tbmols
fnum n
fput tbmaq
end
else
fput tbmul
end
end
fn brmitem p ulong e ulong i ulong t ulong nx ulong to void
brmcleaf
cp = brmg BMMP
w = brmg BMMC
while gt brmg BML 0 bound BRBIG
if ge i get gbmlm sub brmg BML 1
break
end
brmlclose
end
l = brmg BML
sib = false
if gt l 0
sib = lt i brmlci
end
mk = brmg BMMK
if sib
fput tbmlie
if ne get gbmlk sub l 1 mk
if eq get gbmlt sub l 1 1
fput tbmole
else
fput tbmule
end
brms BMB 0
brmlopen t
end
l = sub l 1
else
if ge l 8
brmclist 7
l = 7
end
brms BMB 0
brmlopen t
end
put gbmlk l mk
put gbmlm l i
put gbmlc l add i w
put gbmlt l sub t 1
brms BML add l 1
fput tbmli
brmtask cp e nx
end
note brmtask: item text after the marker, with a GFM task box when it starts "[ ] " / "[x] "
fn brmtask cp ulong e ulong nx ulong to void
if ge cp e
ret
end
p = cp
if le add cp 3 e
if and eq get fxo cp 91 eq get fxo add cp 2 93
x = get fxo add cp 1
ok = or eq add cp 3 e brspc get fxo add cp 3
if and ok eq x 32
fput tbmchk
p = add cp 3
end
if and ok or eq x 120 eq x 88
fput tbmchkd
p = add cp 3
end
end
end
brmleaf p e nx e 0
end
note ---- leaf blocks
fn brmleaf p ulong e ulong nx ulong b ulong ci ulong to void
i = brmcols p e
f = brmg BMFP
if ge f e
ret
end
if and ge i 4 eq brmg BMP 0
brmicode p e
ret
end
if brmisfence f e
brmfopen f e add ci i
ret
end
c = get fxo f
if eq c 60
if lt i 4
x = brmcbx f e
if gt x 0
brmcleaf
if gt x e
brms BMXE x
end
ret
end
end
end
if eq c 35
if brmhead f e
ret
end
end
if brmhr f e
brmcleaf
fput tbmhr
ret
end
if eq brmg BMP 0
if brmleaf2 f e nx b
ret
end
end
if eq brmg BMT 1
brmct
end
brmpline f e
end
note brmleaf2: definitions, tables and setext headings (only where no paragraph is open)
fn brmleaf2 f ulong e ulong nx ulong b ulong to bool
if brmdefln f e false
ret true
end
if eq brmg BMT 1
if brmhaspipe f e
brmrow f e
ret true
end
brmct
end
if lt nx b
brmnext nx b
ns = brmg BMNS
nn = brmg BMNE
if brmhaspipe f e
n = brmdelim ns nn
if gt n 0
brmthead f e n
brms BMSK 1
ret true
end
end
h = brmsetx ns nn
if gt h 0
brmhopen h f e
brmi f brmtrim f e
brmhclose h
brms BMSK 1
ret true
end
end
ret false
end
note brmnext: the next line, its quote markers and indentation skipped, into BMNS/BMNE
fn brmnext nx ulong b ulong to void
e = brxfind nx b 10
if gt e nx
if eq get fxo sub e 1 13
e = sub e 1
end
end
q = brmq nx e 64
p = brmg BMCP
i = brmcols p e
brms BMNS brmg BMFP
brms BMNE e
end
fn brmsetx s ulong e ulong to ulong
if ge s e
ret 0
end
c = get fxo s
if and ne c 61 ne c 45
ret 0
end
n = brmrun s e c
if not brmblank add s n e
ret 0
end
if eq c 61
ret 1
end
if ge n 2
ret 2
end
ret 0
end
fn brmisfence f ulong e ulong to bool
c = get fxo f
if and ne c 96 ne c 126
ret false
end
n = brmrun f e c
if lt n 3
ret false
end
if eq c 126
ret true
end
ret ge brxfind add f n e 96 e
end
fn brmfopen f ulong e ulong ind ulong to void
brmcleaf
c = get fxo f
n = brmrun f e c
brms BMF 1
brms BMFC ulong c
brms BMFN n
brms BMFI ind
s = add f n
while lt s e bound BRBIG
if not brspc get fxo s
break
end
s = add s 1
end
k = s
while lt k e bound BRBIG
if brspc get fxo k
break
end
k = add k 1
end
if gt k s
fput tbmprl
brmspan s k
fput tbaq
else
fput tbmpre
end
end
fn brmhr f ulong e ulong to bool
c = get fxo f
if and ne c 45 and ne c 42 ne c 95
ret false
end
n = ulong 0
i = f
while lt i e bound BRBIG
x = get fxo i
if eq x c
n = add n 1
else
if not brspc x
ret false
end
end
i = add i 1
end
ret ge n 3
end
note brmpline: one paragraph line (opens the paragraph when needed)
fn brmpline f ulong e ulong to void
if eq brmg BMP 0
brmcleaf
brms BMP 1
brms BMPW 1
if and gt brmg BML 0 eq brmg BMB 0
brms BMPW 0
end
if eq brmg BMPW 1
fput tbmp
end
else
if eq brmg BMHB 1
fput tbmbr
else
fputc 10
end
end
k = brmtrim f e
hb = ulong 0
if ge sub e k 2
hb = 1
end
if gt k f
if eq get fxo sub k 1 92
hb = 1
k = sub k 1
end
end
brms BMHB hb
brmi f k
end
note ---- HTML comments
note "<!--" up to the first "-->" renders nothing ("<!-->" and "<!--->" included, as in CommonMark
note 0.31). No byte of a comment is ever written, so a comment cannot carry markup through; "--!>",
note "-- >" and a nested "<!--" do not end it, only the first "-->" (also inside "--->") does. An opener with no
note "-->" after it in the document is not a comment: it stays text and is escaped like any other "<".
note Fenced and indented code and code spans never reach these checks, so comments there stay text.
note Block: a line starting with "<!--" (under 4 columns of indent) closes the open leaf block and
note renders nothing up to the first "-->", across lines, when only spaces and further comments
note follow the "-->" or the "-->" is on a later line; text after a "-->" on a later line is paragraph
note text. A comment that closes on its own line with other text after it is paragraph text instead
note (the inline rule drops it). Inline: a comment that opens and closes inside one inline run is
note dropped from it (headings, emphasis, link text, table cells, list items); heading anchors skip it.
fn brmisopen i ulong to bool
if ne get fxo i 60
ret false
end
if ne get fxo add i 1 33
ret false
end
if ne get fxo add i 2 45
ret false
end
ret eq get fxo add i 3 45
end
note brmcmend: the first "-->" starting at or after p, BMDB when none. The cached scan (no "-->" in
note [BMCF, BMCX)) answers every later lookup inside it, and a lookup before BMCF scans only up to
note BMCF, so the lookups of one document (made in document order) scan each byte about once.
fn brmcmend p ulong to ulong
b = brmg BMDB
lim = b
if eq brmg BMCV 1
cf = brmg BMCF
cx = brmg BMCX
if le cf p
if le p cx
ret cx
end
else
lim = cf
end
end
j = p
r = b
while lt j lim bound BRBIG
if ge add j 2 b
break
end
if eq get fxo j 45
if eq get fxo add j 1 45
if eq get fxo add j 2 62
r = j
break
end
end
end
j = add j 1
end
if eq r b
if lt lim b
r = brmg BMCX
end
end
brms BMCV 1
brms BMCF p
brms BMCX r
ret r
end
note brmicmt: an inline comment at i that closes before e: the end after its "-->", else 0
fn brmicmt i ulong e ulong to ulong
if gt add i 4 e
ret 0
end
if not brmisopen i
ret 0
end
j = brmcmend add i 2
if gt add j 3 e
ret 0
end
ret add j 3
end
note brmcbx: a comment block at f (under 4 columns of indent, checked by the callers) on the line
note ending at e: the end after its last "-->" when the line holds only comments and spaces or its
note last comment closes on a later line, else 0
fn brmcbx f ulong e ulong to ulong
p = f
while lt p e bound BRBIG
if gt add p 4 e
ret 0
end
if not brmisopen p
ret 0
end
j = brmcmend add p 2
if ge j brmg BMDB
ret 0
end
x = add j 3
if gt x e
ret x
end
p = x
while lt p e bound BRBIG
if not brspc get fxo p
break
end
p = add p 1
end
if ge p e
ret x
end
end
ret 0
end
note brmcline: a line ending at k while a comment block is open (BMXE): nothing before the "-->"
note renders; text after it on the closing line is paragraph text
fn brmcline k ulong to void
x = brmg BMXE
if gt x k
ret
end
brms BMXE 0
if brmblank x k
ret
end
i = brmcols x k
brmpline brmg BMFP k
brms BMB 0
end
note ---- headings
fn brmhead f ulong e ulong to bool
n = brmrun f e 35
if gt n 6
ret false
end
s = add f n
if lt s e
if not brspc get fxo s
ret false
end
end
while lt s e bound BRBIG
if not brspc get fxo s
break
end
s = add s 1
end
k = brmtrim s e
j = k
while gt j s bound BRBIG
if ne get fxo sub j 1 35
break
end
j = sub j 1
end
if lt j k
if eq j s
k = j
else
if brspc get fxo sub j 1
k = brmtrim s j
end
end
end
brmcleaf
brmhopen n s k
brmi s k
brmhclose n
ret true
end
fn brmhopen n ulong s ulong k ulong to void
brmcleaf
fput tbmh
fputc uchar add n 48
fput tbmhid
brmslug s k
fput tbaq
end
fn brmhclose n ulong to void
fput tbmhx
fputc uchar add n 48
fput tbmgt
end
note brmslug: heading anchor: ASCII letters lower-cased, digits, "-" and "_" kept, spaces to "-",
note bytes >= 128 kept, HTML comments and everything else dropped
fn brmslug s ulong k ulong to void
i = s
while lt i k bound BRBIG
c = get fxo i
if eq c 60
r = brmicmt i k
if gt r 0
i = r
continue
end
end
if bralnum c
fputc brlow c
end
if or eq c 45 eq c 95
fputc c
end
if eq c 32
fputc 45
end
if ge c 128
fputc c
end
i = add i 1
end
end
note ---- tables
fn brmhaspipe f ulong e ulong to bool
i = f
while lt i e bound BRBIG
c = get fxo i
if eq c 92
i = add i 1
else
if eq c 124
ret true
end
end
i = add i 1
end
ret false
end
note brmdelim: GFM delimiter row -> column count (aligns into gbmta), 0 when not one
fn brmdelim s ulong e ulong to ulong
e2 = brmtrim s e
if ge s e2
ret 0
end
a = s
if eq get fxo a 124
a = add a 1
end
if gt e2 a
if eq get fxo sub e2 1 124
e2 = sub e2 1
end
end
n = ulong 0
c = a
while le c e2 bound BRBIG
k = brxfind c e2 124
if not brmdcell c k n
ret 0
end
n = add n 1
if ge n 64
ret 0
end
c = add k 1
end
ret n
end
fn brmdcell a ulong k ulong n ulong to bool
s = a
while lt s k bound BRBIG
if not brspc get fxo s
break
end
s = add s 1
end
t = brmtrim s k
if ge s t
ret false
end
al = ulong 0
if eq get fxo s 58
al = 1
s = add s 1
end
if lt s t
if eq get fxo sub t 1 58
al = add al 2
t = sub t 1
end
end
if ge s t
ret false
end
for i ulong sub t s bound BRBIG
if ne get fxo add s i 45
ret false
end
end
put gbmta n uchar al
ret true
end
fn brmthead f ulong e ulong n ulong to void
brmcleaf
brms BMT 1
brms BMTC n
fput tbmtab
brmcells f e 1
fput tbmthe
end
fn brmrow f ulong e ulong to void
fput tbmtr
brmcells f e 0
fput tbmtre
end
note brmcells: split fxo[f, e) on unescaped "|" (outside code spans) into BMTC cells
fn brmcells f ulong e ulong th ulong to void
e2 = brmtrim f e
a = f
if lt a e2
if eq get fxo a 124
a = add a 1
end
end
if gt e2 a
if eq get fxo sub e2 1 124
if ne get fxo sub e2 2 92
e2 = sub e2 1
end
end
end
n = brmg BMTC
col = ulong 0
c = a
while lt col n bound BRBIG
k = brmcend c e2
if gt c e2
k = c
end
brmcell c k col th
col = add col 1
c = add k 1
end
end
fn brmcend c ulong e ulong to ulong
i = c
while lt i e bound BRBIG
x = get fxo i
if eq x 92
i = add i 2
else
if eq x 124
ret i
end
if eq x 96
i = brmcskip i e
else
i = add i 1
end
end
end
ret e
end
fn brmcell a ulong k ulong col ulong th ulong to void
al = get gbmta col
if eq th 1
if eq al 1
fput tbmthl
end
if eq al 2
fput tbmthr
end
if eq al 3
fput tbmthc
end
if eq al 0
fput tbmth
end
else
if eq al 1
fput tbmtdl
end
if eq al 2
fput tbmtdr
end
if eq al 3
fput tbmtdc
end
if eq al 0
fput tbmtd
end
end
if lt a k
s = a
while lt s k bound BRBIG
if not brspc get fxo s
break
end
s = add s 1
end
brmi s brmtrim s k
end
if eq th 1
fput tbmthx
else
fput tbmtdx
end
end
note ---- link reference definitions: "[label]: url" (title ignored)
fn brmdefs a ulong b ulong to void
s = a
while lt s b bound BRBIG
e = brxfind s b 10
k = e
if gt k s
if eq get fxo sub k 1 13
k = sub k 1
end
end
i = brmskipc s k 3
if lt i k
if eq get fxo i 91
x = brmdefln i k true
end
end
s = add e 1
end
end
fn brmdefln f ulong e ulong rec bool to bool
if ge f e
ret false
end
if ne get fxo f 91
ret false
end
j = add f 1
while lt j e bound BRBIG
c = get fxo j
if or eq c 93 eq c 91
break
end
j = add j 1
end
if or ge j e eq j add f 1
ret false
end
if ne get fxo j 93
ret false
end
if ge add j 1 e
ret false
end
if ne get fxo add j 1 58
ret false
end
u = add j 2
while lt u e bound BRBIG
if not brspc get fxo u
break
end
u = add u 1
end
if ge u e
ret false
end
ue = u
while lt ue e bound BRBIG
if brspc get fxo ue
break
end
ue = add ue 1
end
if eq get fxo u 60
if eq get fxo sub ue 1 62
u = add u 1
ue = sub ue 1
end
end
if rec
brmdefrec add f 1 j u ue
end
ret true
end
fn brmdefrec ls ulong lz ulong us ulong ue ulong to void
n = get gbmrn 0
if ge n 128
ret
end
b = mul n 4
put gbmrd b ls
put gbmrd add b 1 lz
put gbmrd add b 2 us
put gbmrd add b 3 ue
put gbmrn 0 add n 1
end
note brmref: find the definition labelled fxo[s, e) (ASCII case-insensitive); sets BMDS/BMDE
fn brmref s ulong e ulong to bool
n = get gbmrn 0
for d ulong n bound BRBIG
b = mul d 4
ls = get gbmrd b
lz = get gbmrd add b 1
if eq sub lz ls sub e s
if brmlabeq ls s sub e s
brms BMDS get gbmrd add b 2
brms BMDE get gbmrd add b 3
brms BMTS 0
brms BMTE 0
ret true
end
end
end
ret false
end
fn brmlabeq a ulong b ulong n ulong to bool
for i ulong n bound BRBIG
if ne brlow get fxo add a i brlow get fxo add b i
ret false
end
end
ret true
end
note ---- inline
fn brmi a ulong e ulong to void
i = a
while lt i e bound BRBIG
i = brmi1 i e a
end
end
fn brmi1 i ulong e ulong a ulong to ulong
c = get fxo i
if eq c 92
if lt add i 1 e
if brpunct get fxo add i 1
fescc get fxo add i 1
ret add i 2
end
end
fputc 92
ret add i 1
end
if eq c 96
ret brmcode i e
end
if or eq c 33 eq c 91
r = brmlnk i e
if gt r 0
ret r
end
fputc c
ret add i 1
end
if eq c 60
r = brmicmt i e
if gt r 0
ret r
end
r = brmauto i e
if gt r 0
ret r
end
fescc c
ret add i 1
end
ret brmi2 i e a
end
fn brmi2 i ulong e ulong a ulong to ulong
c = get fxo i
if or eq c 42 eq c 95
r = brmemph i e a
if gt r 0
ret r
end
n = brmrun i e c
for k ulong n bound BRBIG
fputc c
end
ret add i n
end
if eq c 126
r = brmstrike i e
if gt r 0
ret r
end
fputc c
ret add i 1
end
if eq c 104
r = brmbare i e a
if gt r 0
ret r
end
end
if eq c 38
r = brment i e
if gt r 0
ret r
end
end
fescc c
ret add i 1
end
note brmcskip: past the code span starting at i (or past its backtick run when unmatched)
fn brmcskip i ulong e ulong to ulong
n = brmrun i e 96
j = add i n
while lt j e bound BRBIG
if eq get fxo j 96
m = brmrun j e 96
if eq m n
ret add j m
end
j = add j m
else
j = add j 1
end
end
ret add i n
end
fn brmcode i ulong e ulong to ulong
n = brmrun i e 96
k = brmcskip i e
if eq k add i n
for x ulong n bound BRBIG
fputc 96
end
ret k
end
s = add i n
t = sub k n
if gt sub t s 1
if and eq get fxo s 32 eq get fxo sub t 1 32
if not brmblank s t
s = add s 1
t = sub t 1
end
end
end
fput tbmcode
brmspan s t
fput tbmcodx
ret k
end
note brmbrk: matching "]" for the "[" at i (nested brackets, escapes and code spans honoured)
fn brmbrk i ulong e ulong to ulong
d = ulong 0
j = i
while lt j e bound BRBIG
c = get fxo j
if eq c 92
j = add j 2
continue
end
if eq c 96
j = brmcskip j e
continue
end
if eq c 91
d = add d 1
end
if eq c 93
d = sub d 1
if eq d 0
ret j
end
end
j = add j 1
end
ret 0
end
note brmdest: "(dest "title")" at k -> end after ")" or 0; dest to BMDS/BMDE, title BMTS/BMTE
fn brmdest k ulong e ulong to ulong
j = brmsksp add k 1 e
s = j
if and lt j e eq get fxo j 60
s = add j 1
j = brxfind s e 62
if ge j e
ret 0
end
brms BMDS s
brms BMDE j
j = add j 1
else
d = ulong 0
while lt j e bound BRBIG
c = get fxo j
if brspc c
break
end
if eq c 40
d = add d 1
end
if eq c 41
if eq d 0
break
end
d = sub d 1
end
j = add j 1
end
brms BMDS s
brms BMDE j
end
ret brmtitle j e
end
fn brmsksp j ulong e ulong to ulong
i = j
while lt i e bound BRBIG
if not brspc get fxo i
ret i
end
i = add i 1
end
ret i
end
fn brmtitle j ulong e ulong to ulong
brms BMTS 0
brms BMTE 0
i = brmsksp j e
if ge i e
ret 0
end
c = get fxo i
if or eq c 34 eq c 39
t = brxfind add i 1 e c
if ge t e
ret 0
end
brms BMTS add i 1
brms BMTE t
i = brmsksp add t 1 e
end
if ge i e
ret 0
end
if ne get fxo i 41
ret 0
end
ret add i 1
end
note brmlnk: "[text](dest)", "[text][label]", "[label]" and the same with "!" for images
fn brmlnk i ulong e ulong to ulong
img = eq get fxo i 33
o = i
if img
o = add i 1
if ge o e
ret 0
end
if ne get fxo o 91
ret 0
end
end
k = brmbrk o e
if eq k 0
ret 0
end
r = brmtarget o k e
if eq r 0
ret 0
end
if img
brmimgout add o 1 k
else
brmaout add o 1 k
end
ret r
end
note brmtarget: the destination after "]" at k; end of the construct or 0
fn brmtarget o ulong k ulong e ulong to ulong
n = add k 1
if lt n e
if eq get fxo n 40
r = brmdest n e
if gt r 0
ret r
end
end
if eq get fxo n 91
j = brxfind n e 93
if lt j e
if eq j add n 1
if brmref add o 1 k
ret add j 1
end
ret 0
end
if brmref add n 1 j
ret add j 1
end
ret 0
end
end
end
if brmref add o 1 k
ret n
end
ret 0
end
note brmkind: 0 unsafe scheme, 1 http(s)/mailto/protocol-relative, 2 "#anchor" or empty, 3 relative
fn brmkind s ulong e ulong to ulong
if ge s e
ret 2
end
c = get fxo s
if eq c 35
ret 2
end
if eq c 47
if lt add s 1 e
if eq get fxo add s 1 47
ret 1
end
end
ret 3
end
j = s
while lt j e bound BRBIG
x = get fxo j
if not or bralnum x or eq x 43 or eq x 45 eq x 46
break
end
j = add j 1
end
if and lt j e gt j s
if eq get fxo j 58
if brmschem s j
ret 1
end
ret 0
end
end
j = s
while lt j e bound BRBIG
x = get fxo j
if or eq x 58 or eq x 47 or eq x 63 eq x 35
break
end
j = add j 1
end
if lt j e
if eq get fxo j 58
ret 0
end
end
ret 3
end
fn brmschem s ulong j ulong to bool
if brmlabt s j tbmhttp
ret true
end
if brmlabt s j tbmhttps
ret true
end
ret brmlabt s j tbmmto
end
fn brmlabt s ulong j ulong t view uchar * to bool
if ne sub j s len t
ret false
end
for i ulong len t
if ne brlow get fxo add s i get t i
ret false
end
end
ret true
end
note brmuc: a byte of a relative destination: existing %XX kept, other unsafe bytes encoded
fn brmuc c uchar to void
if eq c 37
fputc c
ret
end
bruc c
end
note brmhref: href/src value of fxo[s, e) of kind k; raw = 1 for images (repo /raw/ URL)
fn brmhref s ulong e ulong k ulong raw ulong to void
if ne k 3
brmspan s e
ret
end
q = s
while lt q e bound BRBIG
x = get fxo q
if or eq x 35 eq x 63
break
end
q = add q 1
end
if gt q s
brmres s q
brurepo
if eq raw 1
fput tbmraw
else
fput tbmblob
end
bruref
for i ulong get gbmul 0 bound BRBIG
brmuc get gbmu i
end
end
brmspan q e
end
note brmres: resolve the relative path fxo[s, q) against gbmd into gbmu ("/a/b", "" = root)
fn brmres s ulong q ulong to void
put gbmul 0 0
if ne get fxo s 47
if gt get gbmdl 0 0
brmuadd 47
for i ulong get gbmdl 0 bound BRBIG
brmuadd get gbmd i
end
end
end
a = s
while le a q bound BRBIG
j = brxfind a q 47
brmuseg a j
a = add j 1
end
end
fn brmuadd c uchar to void
n = get gbmul 0
if lt n 4096
put gbmu n c
put gbmul 0 add n 1
end
end
fn brmuseg a ulong j ulong to void
n = sub j a
if eq n 0
ret
end
if and eq n 1 eq get fxo a 46
ret
end
if and eq n 2 and eq get fxo a 46 eq get fxo add a 1 46
k = get gbmul 0
while gt k 0 bound BRBIG
k = sub k 1
if eq get gbmu k 47
break
end
end
put gbmul 0 k
ret
end
brmuadd 47
for i ulong n bound BRBIG
brmuadd get fxo add a i
end
end
fn brmaout ts ulong te ulong to void
ds = brmg BMDS
de = brmg BMDE
k = brmkind ds de
if eq k 0
brmi ts te
ret
end
fput tbah
brmhref ds de k 0
if lt brmg BMTS brmg BMTE
fput tbmtitl
brmspan brmg BMTS brmg BMTE
end
if eq k 1
fput tbmaext
else
fput tbaq
end
brmi ts te
fput tbae
end
fn brmimgout ts ulong te ulong to void
ds = brmg BMDS
de = brmg BMDE
k = brmkind ds de
if eq k 3
fput tbmimg
brmhref ds de k 1
fput tbmalt
brmspan ts te
fput tbmimgx
ret
end
brmspan ts te
end
note brmauto: "<scheme:...>" or "<user@host>" autolinks
fn brmauto i ulong e ulong to ulong
j = add i 1
hat = false
while lt j e bound BRBIG
c = get fxo j
if or eq c 62 or eq c 60 brspc c
break
end
if eq c 64
hat = true
end
j = add j 1
end
if ge j e
ret 0
end
if ne get fxo j 62
ret 0
end
s = add i 1
if ge s j
ret 0
end
k = brmkind s j
if and eq k 1 ne get fxo s 47
fput tbah
brmspan s j
fput tbmaext
brmspan s j
fput tbae
ret add j 1
end
if and hat eq k 3
fput tbah
fput tbmmail
brmspan s j
fput tbmaext
brmspan s j
fput tbae
ret add j 1
end
ret 0
end
note brmbare: GFM-style bare http(s):// autolink at a word start
fn brmbare i ulong e ulong a ulong to ulong
if gt i a
if bralnum get fxo sub i 1
ret 0
end
end
n = ulong 0
if brxat i e tbmbhs
n = len tbmbhs
end
if eq n 0
if brxat i e tbmbh
n = len tbmbh
end
end
if eq n 0
ret 0
end
j = add i n
while lt j e bound BRBIG
c = get fxo j
if or brspc c eq c 60
break
end
j = add j 1
end
while gt j add i n bound BRBIG
c = get fxo sub j 1
if not brmtrail c
break
end
j = sub j 1
end
if le j add i n
ret 0
end
fput tbah
brmspan i j
fput tbmaext
brmspan i j
fput tbae
ret j
end
fn brmtrail c uchar to bool
if or eq c 46 or eq c 44 or eq c 58 eq c 59
ret true
end
if or eq c 33 or eq c 63 or eq c 41 eq c 39
ret true
end
ret or eq c 34 or eq c 42 or eq c 95 eq c 126
end
note brment: a named or numeric character reference kept as written
fn brment i ulong e ulong to ulong
j = add i 1
hex = false
num = false
if lt j e
if eq get fxo j 35
num = true
j = add j 1
if lt j e
if or eq get fxo j 120 eq get fxo j 88
hex = true
j = add j 1
end
end
end
end
s = j
while lt j e bound BRBIG
c = get fxo j
ok = bralnum c
if num
ok = brdig c
if hex
ok = lt brhexv c 16
end
end
if not ok
break
end
j = add j 1
end
n = sub j s
if or lt n 1 gt n 31
ret 0
end
if and not num lt n 2
ret 0
end
if or ge j e ne get fxo j 59
ret 0
end
for k ulong add sub j i 1 bound BRBIG
fputc get fxo add i k
end
ret add j 1
end
note ---- emphasis
fn brmemph i ulong e ulong a ulong to ulong
c = get fxo i
n = brmrun i e c
s = add i n
if ge s e
ret 0
end
if brspc get fxo s
ret 0
end
if and eq c 95 gt i a
if bralnum get fxo sub i 1
ret 0
end
end
if ge n 3
k = brmclose add i 3 e c 3
if gt k 0
fput tbmem
fput tbmst
brmi add i 3 k
fput tbmstx
fput tbmemx
ret add k 3
end
end
if ge n 2
k = brmclose add i 2 e c 2
if gt k 0
fput tbmst
brmi add i 2 k
fput tbmstx
ret add k 2
end
end
if ne n 1
ret 0
end
k = brmclose add i 1 e c 1
if eq k 0
ret 0
end
fput tbmem
brmi add i 1 k
fput tbmemx
ret add k 1
end
note brmclose: closing run of c (length w; for w = 1 a lone c, double runs are nested strong)
fn brmclose s ulong e ulong c uchar w ulong to ulong
j = s
while lt j e bound BRBIG
x = get fxo j
if eq x 92
j = add j 2
continue
end
if eq x 96
j = brmcskip j e
continue
end
if ne x c
j = add j 1
continue
end
r = brmrun j e c
if brmcfit j e r w c s
ret j
end
j = add j r
end
ret 0
end
fn brmcfit j ulong e ulong r ulong w ulong c uchar s ulong to bool
if le j s
ret false
end
if brspc get fxo sub j 1
ret false
end
if eq w 1
if eq r 2
ret false
end
else
if lt r w
ret false
end
end
if eq c 95
if lt add j w e
if bralnum get fxo add j w
ret false
end
end
end
ret true
end
fn brmstrike i ulong e ulong to ulong
n = brmrun i e 126
if ne n 2
ret 0
end
s = add i 2
if ge s e
ret 0
end
if brspc get fxo s
ret 0
end
k = brmclose s e 126 2
if eq k 0
ret 0
end
fput tbmdel
brmi s k
fput tbmdelx
ret add k 2
end

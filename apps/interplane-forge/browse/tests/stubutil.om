fkgit
end
fn dlrch1 to bool
ret false
end
note ---- path builder fpth and whole-file read into fxo: copy of server/util.om fpb fpc fpt frdall, for
note nodes/head.om nshead (brdefref), which the test compose now includes as run.sh units does
global fpth uchar 4096
global fpthl ulong 1
fn fpb to void
put fpthl 0 0
end
fn fpc c uchar to void
n = get fpthl 0
if lt n 4095
put fpth n c
put fpthl 0 add n 1
end
end
fn fpt t view uchar * to void
for i ulong len t bound 4096
fpc get t i
end
end
fn frdall to long
put fxol 0 0
put fxotr 0 0
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret fd
end
for it ulong 100000
n = get fxol 0
if ge n len fxo
put fxotr 0 1
break
end
r = read int fd fxo n sub len fxo n
if le r 0
break
end
put fxol 0 add n ulong r
end
x = fclose int fd
ret long get fxol 0
end

note L1057: call the real brti at and beyond its title excerpt limit.
note The full lookup path stays unchanged; only the title excerpt is capped.
text bttshort "File - o/r"
text bttpre "File: "
text bttsuf " - o/r"
fn bttcase n ulong to int
want = new uchar 256 0
for i ulong n bound 4096
put gbp i 120
end
put gbpl 0 n
put fown 0 111
put fownl 0 1
put frepo 0 114
put frepol 0 1
brti tbtblob
w = ulong 0
if eq n 0
for i ulong len bttshort
put want w get bttshort i
w = add w 1
end
else
for i ulong len bttpre
put want w get bttpre i
w = add w 1
end
count = n
if gt count 120
count = 120
end
for i ulong count bound 120
put want w 120
w = add w 1
end
for i ulong len bttsuf
put want w get bttsuf i
w = add w 1
end
end
if ne get ftil 0 w
ret 1
end
for i ulong w bound 256
if ne get fti i get want i
ret 2
end
end
if ne get gbpl 0 n
ret 3
end
for i ulong n bound 4096
if ne get gbp i 120
ret 4
end
end
ret 0
end
fn main to int
cases = new ulong 6 0
put cases 1 1
put cases 2 119
put cases 3 120
put cases 4 121
put cases 5 4096
for i ulong 6
r = bttcase get cases i
if ne r 0
ret r
end
end
ret 0
end

note browse/tests/mdmain.om: renderer fixture driver. stdin = Markdown, stdout = HTML fragment.
note Context: base "/", repo o/r, ref "main", document directory "docs".
text tbtdir "docs"
fn brtset to void
put fbase 0 47
put fbasel 0 1
put fown 0 111
put fownl 0 1
put frepo 0 114
put frepol 0 1
for i ulong len tbmain
put gbref i get tbmain i
end
put gbrefl 0 len tbmain
for i ulong len tbtdir
put gbmd i get tbtdir i
end
put gbmdl 0 len tbtdir
end
fn main to int
brtset
n = ulong 0
for it ulong 100000
r = read 0 fxo n sub len fxo n
if le r 0
break
end
n = add n ulong r
end
put fxol 0 n
brmd 0 n
w = write 1 fob 0 get fobl 0
ret 0
end

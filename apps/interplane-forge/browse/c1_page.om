note browse/c1_page.om: shared page pieces, the repo home, /tree, /blob and /raw (ForgeBrowse).
note Every handler validates first and writes nothing before it decides; a failure returns the
note status with fob empty, so the server renders its own error page.
global gbf ulong 16
global gbfn ulong 1
global gbrm uchar 256
global gbrml ulong 1
global gbrmk ulong 1
global gbx uchar 16
global gbxl ulong 1
global gbpg ulong 1
global gbboid uchar 40
global gbbsz ulong 1
const BRMAXE ulong 5000
const BRSHOW ulong 2097152
note BRRAWMX: the largest blob /raw/ serves (the contract's kind-3 file cap, 512 MiB)
const BRRAWMX ulong 536870912
text tbsz "-s"
text tblstr "ls-tree"
text tbz "-z"
text tbll "-l"
text tbcatf "cat-file"
text tbt "-t"
text tbblob "blob"
text tbtree "tree"
text tbraw "raw"
text tbblame "blame"
text tbcmts "commits"
text tbcmt "commit"
text tblog "log"
text tbn1 "-n"
text tbone "1"
text tbdd "--"
text tbfmtc "--format=%H%x1f%an%x1f%at%x1f%s"
text tbskip "--skip="
text tbplain "plain"
text tbpage "page"
text tbcr1 "<p class=\"crumbs\"><a href=\""
text tbsl " / "
text tbb "<b>"
text tbbe "</b>"
text tbpe "</p>\n"
text tbbar1 "<div class=\"bar\"><span class=\"ref\">"
text tbkbr "branch"
text tbktag "tag"
text tbkcmt "commit"
text tbcode " <code>"
text tbcodee "</code></span> "
text tbbrs "/branches\">Branches</a> "
text tbtgs "/tags\">Tags</a> "
text tbhist "\">History</a> "
text tbdive "</div>\n"
text tblat1 "<div class=\"box latest\"><a class=\"mono\" href=\""
text tblat2 "</a> "
text tblat3 " <span class=\"meta\">"
text tblat4 " committed "
text tblat5 "</span></div>\n"
text tbtab1 "<table class=\"files\"><tbody>\n"
text tbtab2 "</tbody></table>\n"
text tbtr1 "<tr><td><a class=\"dir\" href=\""
text tbtr1f "<tr><td><a class=\"file\" href=\""
text tbtrs "/</a></td><td></td></tr>\n"
text tbtrf "</a></td><td class=\"sz\">"
text tbtre "</td></tr>\n"
text tbtrsm "<tr><td><span class=\"muted\">"
text tbtrsm2 " @ "
text tbtrsm3 "</span></td><td></td></tr>\n"
text tbup "<tr><td><a class=\"dir\" href=\""
text tbup2 "\">..</a></td><td></td></tr>\n"
text tbmany "<p class=\"muted\">Listing cut at 5000 entries.</p>\n"
text tbempty "<p class=\"muted\">This directory is empty.</p>\n"
text tbrd1 "<div class=\"box readme\"><p class=\"meta\">"
text tbrd2 "</p>\n<article class=\"md\">\n"
text tbrd3 "</article></div>\n"
text tbrd4 "</p>\n<pre>"
text tbrd5 "</pre></div>\n"
text tbreadme "readme"
text tbxmd "md"
text tbxmkd "markdown"
text tbxtxt "txt"
text tbinfo1 "<div class=\"bar\"><span class=\"meta\">"
text tbinfo2 " lines &#183; "
text tbinfo3 " bytes</span> "
text tbinfo4 "\">Raw</a> "
text tbinfo5 "\">Blame</a> "
text tbinfo6 "?plain=1\">Source</a> "
text tbinfo7 "\">Rendered</a> "
text tbimg1 "<p class=\"img\"><img src=\""
text tbimg2 "\" alt=\""
text tbimg3 "\"></p>\n"
text tbbin1 "<p class=\"muted\">Binary file not shown. <a href=\""
text tbbin2 "\">Download</a></p>\n"
text tbbig1 "<p class=\"muted\">This file is too large to show here. <a href=\""
text tbbig2 "\">View it raw</a>.</p>\n"
text tbcd1 "<table class=\"code\"><tbody>\n"
text tbcd2 "<tr id=\"L"
text tbcd3 "\"><td class=\"ln\"><a href=\"#L"
text tbcd4 "</a></td><td class=\"lc\">"
text tbcd5 "</td></tr>\n"
text tbart1 "<article class=\"md\">\n"
text tbart2 "</article>\n"
text tbctxt "text/plain; charset=utf-8"
text tbcoct "application/octet-stream"
text tbcpng "image/png"
text tbcjpg "image/jpeg"
text tbcgif "image/gif"
text tbcwebp "image/webp"
text tbcsvg "image/svg+xml"
text tbcico "image/x-icon"
text tbcbmp "image/bmp"
text tbcpdf "application/pdf"
text tbxpng "png"
text tbxjpg "jpg"
text tbxjpeg "jpeg"
text tbxgif "gif"
text tbxwebp "webp"
text tbxsvg "svg"
text tbxico "ico"
text tbxbmp "bmp"
text tbxpdf "pdf"
text tbatt "attachment; filename=\""
text tbbig3 "<p class=\"muted\">This file is too large to show here.</p>\n"
text tbh2 "<h2>"
text tbh2e "</h2>\n"
text tbtfil "Files"
text tbtblob "File"
text tbtsep " - "
note ---- small shared helpers
note brerr: drop any output and answer st (the server renders the error page)
fn brerr st ulong to long
put fobl 0 0
put fkind 0 0
ret long st
end
note brknum: append the decimal v to the open argv argument
fn brknum v ulong to void
w = v
p = ulong 1
while le mul p 10 w bound 20
p = mul p 10
end
while gt p 0 bound 21
fkc uchar add div w p 48
w = rem w p
p = div p 10
end
end
note brsplit: split fxo[a, e) at byte c into gbf (start, end pairs, at most 8); returns the count
fn brsplit a ulong e ulong c uchar to ulong
k = ulong 0
s = a
i = a
while lt i e bound BRBIG
if eq get fxo i c
if lt k 7
put gbf mul k 2 s
put gbf add mul k 2 1 i
k = add k 1
s = add i 1
end
end
i = add i 1
end
put gbf mul k 2 s
put gbf add mul k 2 1 e
k = add k 1
put gbfn 0 k
ret k
end
fn brfa k ulong to ulong
ret get gbf mul k 2
end
fn brfl k ulong to ulong
if ge k get gbfn 0
ret 0
end
ret sub get gbf add mul k 2 1 get gbf mul k 2
end
note brfne: fields j and k hold different bytes (a committer named differently from the author)
fn brfne j ulong k ulong to bool
n = brfl j
if ne n brfl k
ret true
end
a = brfa j
b = brfa k
for i ulong n
if ne get fxo add a i get fxo add b i
ret true
end
end
ret false
end
note brfesc: html-escape field k; brfurl: url-encode field k
fn brfesc k ulong to void
fxesc brfa k brfl k
end
fn brfurl k ulong to void
bruxo brfa k brfl k
end
note brti: page title "<t>[: <path>] - owner/repo"
fn brti t view uchar * to void
fsetti t
n = get gbpl 0
if gt n 0
ftic 58
ftic 32
for i ulong n bound 120
ftic get gbp i
end
end
for i ulong len tbtsep
ftic get tbtsep i
end
ftirepo
end
note brucmt: <repo>/commit/<fxo[a, a+n)>
fn brucmt a ulong n ulong to void
brurepo
fputc 47
fput tbcmt
fputc 47
bruxo a n
end
note brfrat: gbfr[o..] starts with t
fn brfrat o ulong t view uchar * to bool
n = get gbfrl 0
k = len t
if gt add o k n
ret false
end
for i ulong k
if ne get gbfr add o i get t i
ret false
end
end
ret true
end
fn brrkind to ulong
if or brfrat 0 tbrts brfrat 65 tbrts
ret 2
end
if brfrat 0 tbrhs
ret 1
end
if brfrat 65 tbrhs
ret 1
end
ret 3
end
note brrefbar: the ref, branch and tag links, the history link for the current path
fn brrefbar to void
fput tbbar1
k = brrkind
if eq k 1
fput tbkbr
end
if eq k 2
fput tbktag
end
if eq k 3
fput tbkcmt
end
fput tbcode
brrefesc
fput tbcodee
fput tbah
brurepo
fput tbbrs
fput tbah
brurepo
fput tbtgs
fput tbah
bruactp tbcmts get gbpl 0
fput tbhist
fput tbdive
end
note brcrumb: repo / dir / dir / name, each but the last a tree link
fn brcrumb to void
fput tbcr1
bruact tbtree
fput tbaq
fputrnm
fput tbae
n = get gbpl 0
s = ulong 0
i = ulong 0
while le i n bound BRBIG
lastb = eq i n
if not lastb
lastb = eq get gbp i 47
end
if lastb
if gt i s
fput tbsl
brcrumb1 s i
end
s = add i 1
end
i = add i 1
end
fput tbpe
end
fn brcrumb1 s ulong i ulong to void
if eq i get gbpl 0
fput tbb
brgesc s sub i s
fput tbbe
ret
end
fput tbah
bruactp tbtree i
fput tbaq
brgesc s sub i s
fput tbae
end
note brlast: the newest commit touching gbp at gbsha, in a box
fn brlast to void
fkgit
fka tblog
fka tbn1
fka tbone
fka tbfmtc
fkopen
brksha
if gt get gbpl 0 0
fka tbdd
fkopen
brkp
end
st = fexec BRTMO
n = get fxol 0
if or ne st 0 eq n 0
ret
end
e = brxfind 0 n 10
k = brsplit 0 e 31
if lt k 4
ret
end
fput tblat1
brucmt brfa 0 brfl 0
fput tbaq
fxput brfa 0 7
fput tblat2
brfesc 3
fput tblat3
brfesc 1
fput tblat4
brdate brxdec brfa 2 add brfa 2 brfl 2
fput tblat5
end
note brotype: object type of <sha>:<path>: 1 tree, 2 blob, 0 missing
fn brotype to ulong
if eq get gbpl 0 0
ret 1
end
fkgit
fka tbcatf
fka tbt
brkshp
st = fexec BRTMO
if ne st 0
ret 0
end
n = get fxol 0
if brxat 0 n tbtree
ret 1
end
if brxat 0 n tbblob
ret 2
end
ret 0
end
note ---- tree listing
fn brlsx to bool
fkgit
fka tblstr
fka tbz
fka tbll
if gt get gbpl 0 0
brkshp
else
fkopen
brksha
end
st = fexec BRTMO
ret eq st 0
end
note brtent: one ls-tree -z -l entry fxo[s, e): "<mode> <type> <sha> <size>\t<name>"; pass 1 trees, pass 2 rest
fn brtent s ulong e ulong pass ulong to bool
t = add s 7
if ge t e
ret false
end
tab = brxfind s e 9
if ge tab e
ret false
end
c = get fxo t
istree = eq c 116
want = eq pass 1
if and istree not want
ret false
end
if and not istree want
ret false
end
na = add tab 1
nl = sub e na
if istree
brtdir na nl
ret true
end
if eq c 99
brtsub na nl add t 7
ret true
end
brreadme na nl
brtfile na nl add t 46 tab
ret true
end
fn brtpre to void
n = get gbpl 0
bruactp tbtree n
end
fn brtdir na ulong nl ulong to void
fput tbtr1
brtpre
fputc 47
bruxo na nl
fput tbaq
fxesc na nl
fput tbtrs
end
fn brtsub na ulong nl ulong sa ulong to void
fput tbtrsm
fxesc na nl
fput tbtrsm2
fxesc sa 7
fput tbtrsm3
end
fn brtfile na ulong nl ulong sa ulong tab ulong to void
fput tbtr1f
bruactp tbblob get gbpl 0
fputc 47
bruxo na nl
fput tbaq
fxesc na nl
fput tbtrf
s = sa
while lt s tab bound 64
if ne get fxo s 32
break
end
s = add s 1
end
fxput s sub tab s
fput tbtre
end
note brreadme: remember the best README name seen (markdown 1 beats plain 2)
fn brreadme na ulong nl ulong to void
if or lt nl 6 gt nl 200
ret
end
for i ulong 6
if ne brlow get fxo add na i get tbreadme i
ret
end
end
k = ulong 2
if gt nl 6
if ne get fxo add na 6 46
ret
end
if or brxlext add na 7 add na nl tbxmd brxlext add na 7 add na nl tbxmkd
k = 1
end
end
m = get gbrmk 0
if and ne m 0 le m k
ret
end
for i ulong nl
put gbrm i get fxo add na i
end
put gbrml 0 nl
put gbrmk 0 k
end
note brxlext: fxo[a, e) equals the lower-case t, ignoring case
fn brxlext a ulong e ulong t view uchar * to bool
if ne sub e a len t
ret false
end
for i ulong len t
if ne brlow get fxo add a i get t i
ret false
end
end
ret true
end
note brlist: the directory listing of <sha>:<gbp>; false when ls-tree failed
fn brlist to bool
put gbrml 0 0
put gbrmk 0 0
if not brlsx
ret false
end
n = get fxol 0
fput tbtab1
if gt get gbpl 0 0
fput tbup
brtup
fput tbup2
end
c = ulong 0
for q ulong 2
pass = add q 1
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 0
if brtent s e pass
c = add c 1
end
if ge c BRMAXE
break
end
s = add e 1
end
end
fput tbtab2
if ge c BRMAXE
fput tbmany
end
if eq c 0
fput tbempty
end
ret true
end
note brtup: link to the parent directory
fn brtup to void
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
k = sub k 1
if eq get gbp k 47
break
end
end
bruactp tbtree k
end
note brrdshow: fetch and render the README found by brlist (in directory gbp)
fn brrdshow to void
n = get gbrml 0
if eq n 0
ret
end
fkgit
fka tbcatf
fka tbblob
fkopen
brksha
fkc 58
if gt get gbpl 0 0
brkp
fkc 47
end
for i ulong n
fkc get gbrm i
end
st = fexec BRTMO
if ne st 0
ret
end
m = get fxol 0
if gt m BRSHOW
m = BRSHOW
end
fput tbrd1
for i ulong n
fescc get gbrm i
end
if eq get gbrmk 0 1
fput tbrd2
brmdir
brmd 0 m
fput tbrd3
ret
end
fput tbrd4
fxesc 0 m
fput tbrd5
end
note brmdir: gbmd = gbp (the Markdown link base directory)
fn brmdir to void
n = get gbpl 0
for i ulong n
put gbmd i get gbp i
end
put gbmdl 0 n
end
note brmdfile: gbmd = directory of gbp (a file path)
fn brmdfile to void
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
k = sub k 1
if eq get gbp k 47
break
end
end
for i ulong k
put gbmd i get gbp i
end
put gbmdl 0 k
end
note ---- pages
note brhome: repo home at the default branch; 0 hands an empty repo back to the server's home
fn brhome to long
brdefref
if not brres
ret 0
end
put ftil 0 0
ftirepo
frepohd 0
brrefbar
brlast
if not brlist
fput tbempty
end
brrdshow
ret 200
end
note brtreepg: /tree/<ref>[/<path>]
fn brtreepg to long
if not brres
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 2
brloc tbblob
ret 302
end
brti tbtfil
frepohd 0
brrefbar
brcrumb
brlast
if not brlist
fput tbempty
end
brrdshow
ret 200
end
note brloc: redirect to <repo>/<t>/<ref>/<path>
fn brloc t view uchar * to void
put fkind 0 2
put fobl 0 0
flocb
for i ulong get fownl 0 bound 64
brlc get fown i
end
flocc 47
for i ulong get frepol 0 bound 128
brlc get frepo i
end
flocc 47
floct t
flocc 47
for i ulong get gbrefl 0
brlc get gbref i
end
n = get gbpl 0
if gt n 0
flocc 47
end
for i ulong n bound BRBIG
brlc get gbp i
end
end
fn brlc c uchar to void
ok = bralnum c
if or eq c 45 eq c 46
ok = true
end
if or eq c 95 eq c 126
ok = true
end
if eq c 47
ok = true
end
if ok
flocc c
ret
end
flocc 37
flocc get tbhex shr c 4
flocc get tbhex and c 15
end
note brext: lower-case extension of gbp's last segment into gbx (empty when none or > 15)
fn brext to void
put gbxl 0 0
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
k = sub k 1
c = get gbp k
if eq c 47
ret
end
if eq c 46
if gt sub n add k 1 15
ret
end
for i ulong sub n add k 1
put gbx i brlow get gbp add add k 1 i
end
put gbxl 0 sub n add k 1
ret
end
end
end
fn brisx t view uchar * to bool
n = get gbxl 0
if ne n len t
ret false
end
for i ulong n
if ne get gbx i get t i
ret false
end
end
ret true
end
note brimgct: the content type of an image or pdf extension; 0 when not one
fn brimgk to ulong
if brisx tbxpng
ret 1
end
if or brisx tbxjpg brisx tbxjpeg
ret 2
end
if brisx tbxgif
ret 3
end
if brisx tbxwebp
ret 4
end
if brisx tbxsvg
ret 5
end
if brisx tbxico
ret 6
end
if brisx tbxbmp
ret 7
end
if brisx tbxpdf
ret 8
end
ret 0
end
note brbin: a NUL in the first 8000 bytes of fxo
fn brbin to bool
n = get fxol 0
if gt n 8000
n = 8000
end
for i ulong n
if eq get fxo i 0
ret true
end
end
ret false
end
fn brcatb to bool
fkgit
fka tbcatf
fka tbblob
brkshp
st = fexec BRTMO
ret eq st 0
end
note brblobpg: /blob/<ref>/<path>
fn brblobpg to long
if not brres
ret brerr 404
end
if eq get gbpl 0 0
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 1
brloc tbtree
ret 302
end
if not brcatb
ret brerr 404
end
put gbbsz 0 get fxol 0
if ne get fxotr 0 0
if not brbsz
ret brerr 404
end
end
brti tbtblob
frepohd 0
brrefbar
brcrumb
brbinfo
brbbody
ret 200
end
note brlines: number of lines in fxo
fn brlines to ulong
n = get fxol 0
c = ulong 0
for i ulong n bound 16777216
if eq get fxo i 10
c = add c 1
end
end
if gt n 0
if ne get fxo sub n 1 10
c = add c 1
end
end
ret c
end
fn brismd to bool
brext
ret or brisx tbxmd brisx tbxmkd
end
note brbinfo: lines, size and the raw / blame / history / source links (no raw link past BRRAWMX)
fn brbinfo to void
fput tbinfo1
fnum brlines
fput tbinfo2
fnum get gbbsz 0
fput tbinfo3
if le get gbbsz 0 BRRAWMX
fput tbah
bruactp tbraw get gbpl 0
fput tbinfo4
end
fput tbah
bruactp tbblame get gbpl 0
fput tbinfo5
fput tbah
bruactp tbcmts get gbpl 0
fput tbhist
if brismd
fput tbah
bruactp tbblob get gbpl 0
if brplain
fput tbinfo7
else
fput tbinfo6
end
end
fput tbdive
end
fn brplain to bool
r = fqget tbplain
if lt r 1
ret false
end
ret ne get fval 0 48
end
fn brbbody to void
if gt get gbbsz 0 BRRAWMX
fput tbbig3
ret
end
brext
k = brimgk
if and gt k 0 lt k 8
fput tbimg1
bruactp tbraw get gbpl 0
fput tbimg2
brbase
fput tbimg3
ret
end
n = get fxol 0
if or brbin ne k 0
fput tbbin1
bruactp tbraw get gbpl 0
fput tbbin2
ret
end
if or gt n BRSHOW ne get fxotr 0 0
fput tbbig1
bruactp tbraw get gbpl 0
fput tbbig2
ret
end
if and brismd not brplain
fput tbart1
brmdfile
brmd 0 n
fput tbart2
ret
end
brcode 0 n
end
note brbase: html-escaped last segment of gbp
fn brbase to void
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
if eq get gbp sub k 1 47
break
end
k = sub k 1
end
brgesc k sub n k
end
note brcode: fxo[a, e) as a numbered line table with L<n> anchors
fn brcode a ulong e ulong to void
fput tbcd1
s = a
ln = ulong 1
while lt s e bound BRBIG
x = brxfind s e 10
fput tbcd2
fnum ln
fput tbcd3
fnum ln
fput tbaq
fnum ln
fput tbcd4
fxesc s sub x s
fput tbcd5
ln = add ln 1
s = add x 1
end
fput tbtab2
end
note brrawpg: /raw/<ref>/<path>: text/plain is shown; every other type (images, svg, pdf, other
note binaries) is sent with Content-Disposition: attachment. Up to len fob from memory; above,
note from dl's blob cache as a kind-3 file (brrawbig); above BRRAWMX, 404
text tbcache "public, max-age=60"
fn brrawpg to long
if not brres
ret brerr 404
end
if eq get gbpl 0 0
ret brerr 404
end
k = brotype
if ne k 2
ret brerr 404
end
if not brbsz
ret brerr 404
end
sz = get gbbsz 0
if gt sz BRRAWMX
ret brerr 404
end
if gt sz len fob
ret brrawbig
end
if not brcatb
ret brerr 404
end
n = get fxol 0
if or gt n len fob ne get fxotr 0 0
ret brerr 404
end
brext
put fobl 0 0
put fkind 0 1
fsetsbx
brrawct
fxput 0 n
fsetcc tbcache
ret 200
end
note brrawbig: the blob (gbboid) through dl's blob cache (dlblobf: cat-file into
note <data>/archives/<rid>/<blob>.blob, LRU and cold-build caps shared with downloads)
fn brrawbig to long
if not brboid
ret brerr 404
end
b = new uchar 64 0
for i ulong 40
put b i get gbboid i
end
r = dlblobf view part b 0 40
if eq r -7
ret dlbusy
end
if lt r 0
ret brerr 500
end
if not brrdhd
ret brerr 500
end
brext
put fobl 0 0
put fkind 0 3
fsetsbx
brrawct
fsetcc tbcache
ret 200
end
note brrdhd: fxo = the first 8000 bytes of ffile (the cached blob), so brrawct's brbin sees
note the blob's own bytes; false when it cannot be read
fn brrdhd to bool
put fxol 0 0
fd = fopen ffile 0 get ffilel 0 524288 0
if lt fd 0
ret false
end
ch = new uchar 8192 0
n = read int fd ch 0 8000
x = fclose int fd
if le n 0
ret false
end
m = ulong n
for i ulong m
put fxo i get ch i
end
put fxol 0 m
ret true
end
note brbsz: gbbsz = the size of the blob <gbsha>:<gbp> (git cat-file -s)
fn brbsz to bool
put gbbsz 0 0
fkgit
fka tbcatf
fka tbsz
brkshp
st = fexec BRTMO
if ne st 0
ret false
end
v = ulong 0
d = ulong 0
for i ulong get fxol 0 bound 24
c = get fxo i
if or lt c 48 gt c 57
break
end
v = add mul v 10 sub ulong c 48
d = add d 1
end
if eq d 0
ret false
end
put gbbsz 0 v
ret true
end
note brboid: gbboid = the blob id of <gbsha>:<gbp> (rev-parse, 40 lowercase hex checked)
fn brboid to bool
fkgit
fka tbrevp
fka tbverif
fka tbq
fka tbeoo
brkshp
st = fexec BRTMO
if ne st 0
ret false
end
if lt get fxol 0 40
ret false
end
for i ulong 40
c = get fxo i
if not brlhex c
ret false
end
put gbboid i c
end
ret true
end
fn brrawct to void
k = brimgk
if eq k 1
fsetct tbcpng
end
if eq k 2
fsetct tbcjpg
end
if eq k 3
fsetct tbcgif
end
if eq k 4
fsetct tbcwebp
end
if eq k 5
fsetct tbcsvg
end
if eq k 6
fsetct tbcico
end
if eq k 7
fsetct tbcbmp
end
if eq k 8
fsetct tbcpdf
end
if ne k 0
brattach
ret
end
if not brbin
fsetct tbctxt
ret
end
fsetct tbcoct
brattach
end
note brattach: Content-Disposition attachment with the base name, bytes outside [A-Za-z0-9._-] as _
fn brattach to void
fsetcd tbatt
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
if eq get gbp sub k 1 47
break
end
k = sub k 1
end
m = sub n k
if gt m 100
m = 100
end
for i ulong m
c = get gbp add k i
ok = bralnum c
if or eq c 46 or eq c 45 eq c 95
ok = true
end
if not ok
c = 95
end
fcdc c
end
fcdc 34
end

note browse/d_route.om: brroute, the browse slice entry (0 = not mine). Called for repo pages
note (fridx < fan) and for reserved and one-segment paths (fridx 9999), which are never mine.
text tbwbr "branches"
text tbwtag "tags"
text tbwcmp "compare"
text tbwsr "search"
fn brroute to long
if ge get fridx 0 get fan 0
ret 0
end
if not brparse
ret 0
end
w = brword
if eq w 0
ret 0
end
if not fget
ret brerr 405
end
if brjhas w
if fjwant
ret brjroute w
end
fyalt
end
ret brroute2 w
end
note brjhas: the page has a machine form (browse/e1_json.om, e2_json.om; docs/API.md). The home is
note the server's (forge/repo/1) and /raw/ is the file itself
fn brjhas w ulong to bool
if or le w 1 eq w 4
ret false
end
ret true
end
note brjroute: the JSON form of browse page w (brjhas w is true)
fn brjroute w ulong to long
if eq w 2
ret brjtree
end
if eq w 3
ret brjblob
end
if eq w 5
ret brjblame
end
if eq w 11
ret brjsrch
end
ret brjroute2 w
end
fn brjroute2 w ulong to long
if eq w 6
ret brjcmts
end
if eq w 7
ret brjcmt
end
if eq w 8
ret brjbr
end
if eq w 9
ret brjtag
end
ret brjcmp
end
note brword: 1 home, 2 tree, 3 blob, 4 raw, 5 blame, 6 commits, 7 commit, 8 branches, 9 tags,
note 10 compare, 11 search; 0 when not a browse page
fn brword to ulong
if eq get frestl 0 0
ret 1
end
if brisw tbtree
ret 2
end
if brisw tbblob
ret 3
end
if brisw tbraw
ret 4
end
if brisw tbblame
ret 5
end
if brisw tbcmts
ret 6
end
if brisw tbcmt
ret 7
end
ret brword2
end
fn brword2 to ulong
if brisw tbwbr
ret 8
end
if brisw tbwtag
ret 9
end
if brisw tbwcmp
ret 10
end
if brisw tbwsr
ret 11
end
ret 0
end
fn brroute2 w ulong to long
if eq w 1
ret brhome
end
if eq w 2
ret brtreepg
end
if eq w 3
ret brblobpg
end
if eq w 4
ret brrawpg
end
ret brroute3 w
end
fn brroute3 w ulong to long
if eq w 5
ret brblamepg
end
if eq w 6
ret brcmtspg
end
if eq w 7
ret brcmtpg
end
if eq w 8
ret brbrpg
end
if eq w 9
ret brtagpg
end
if eq w 10
ret brcmppg
end
if eq w 11
ret brsrchpg
end
ret 0
end

note browse/e2_json.om: machine form of /commits, /commit, /compare, /branches and /tags (ForgeBrowse;
note docs/API.md). Each brj* handler runs the same validation and the same git argv as its HTML twin
note in browse/c2_hist.om and writes the same facts as JSON. Names: brz* / tbz* / gbz* (this file).
global gbzdt ulong 1
global gbzdh ulong 1
global gbzdc ulong 1
global gbzcut ulong 1
note gbzful: 1 when brzxs stopped a string early because fob reached BRYCAP (e1_json.om), so the
note document still closes inside fob (an escaped byte can take 6 bytes: \ufffd, \u00XX)
global gbzful ulong 1
text tbzscm "forge/commits/1"
text tbzsc "forge/commit/1"
text tbzscp "forge/compare/1"
text tbzsbr "forge/branches/1"
text tbzstg "forge/tags/1"
text tbzksha "sha"
text tbzkaut "author"
text tbzktim "time"
text tbzksub "subject"
text tbzkpat "path"
text tbzkref "ref"
text tbzkcmt "commit"
text tbzkpg "page"
text tbzkpp "per_page"
text tbzkcms "commits"
text tbzknxt "next"
text tbzkprv "prev"
text tbzkpar "parents"
text tbzknam "name"
text tbzkcom "committer"
text tbzkmsg "message"
text tbzklnk "links"
text tbzkpch "patch"
text tbzkdif "diff"
text tbzktre "tree"
text tbzkfch "files_changed"
text tbzkadn "additions"
text tbzkdln "deletions"
text tbzkfil "files"
text tbzkftr "files_truncated"
text tbzkad "added"
text tbzkdd "deleted"
text tbzkdtr "diff_truncated"
text tbzkbas "compare_base"
text tbzkhd "compare_head"
text tbzkctr "commits_truncated"
text tbzkfrm "form"
text tbzkact "action"
text tbzkmet "method"
text tbzkbp "base_param"
text tbzkhp "head_param"
text tbzkml "maxlength"
text tbzkhlp "help"
text tbzkbr "branches"
text tbzkdef "default"
text tbzkhtm "html"
text tbzkarc "archives"
text tbzkzip "zip"
text tbzktgz "tar_gz"
text tbzktr "truncated"
text tbzktgs "tags"
text tbzkobj "object"
text tbzkcp "commit_path"
text tbzkrel "release"
text tbzget "get"
text tbzcmpp "/compare"
text tbzhelp "Branch or tag names, or commit ids. The page shows what head has that base does not."
text tbzzip ".zip"
text tbztgz ".tar.gz"
text tbzrep "\\ufffd"
note ---- JSON strings of any length straight from fxo (fjt holds 64 KiB; a diff is up to 4 MiB)
fn brzcn i ulong e ulong to bool
if ge i e
ret false
end
c = get fxo i
ret and ge c 128 le c 191
end
fn brzul3 i ulong e ulong c uchar to ulong
if not brzcn add i 1 e
ret 0
end
if not brzcn add i 2 e
ret 0
end
d = get fxo add i 1
if and eq c 224 lt d 160
ret 0
end
if and eq c 237 gt d 159
ret 0
end
ret 3
end
fn brzul4 i ulong e ulong c uchar to ulong
if not brzcn add i 1 e
ret 0
end
if not brzcn add i 2 e
ret 0
end
if not brzcn add i 3 e
ret 0
end
d = get fxo add i 1
if and eq c 240 lt d 144
ret 0
end
if and eq c 244 gt d 143
ret 0
end
ret 4
end
note brzul: length of the well-formed UTF-8 sequence at fxo[i] inside fxo[i, e), 0 when ill formed
fn brzul i ulong e ulong to ulong
c = get fxo i
if lt c 128
ret 1
end
if and ge c 194 le c 223
if brzcn add i 1 e
ret 2
end
ret 0
end
if and ge c 224 le c 239
ret brzul3 i e c
end
if and ge c 240 le c 244
ret brzul4 i e c
end
ret 0
end
note brzxs a n: fxo[a, a+n) as one JSON string (escapes as fjstr; ill-formed UTF-8 becomes U+FFFD);
note stops early (gbzful 1) once fob holds more than BRYCAP bytes
fn brzxs a ulong n ulong to void
fputc 34
e = add a n
i = a
while lt i e bound BRBIG
if gt get fobl 0 BRYCAP
put gbzful 0 1
break
end
l = brzul i e
if eq l 0
fput tbzrep
i = add i 1
continue
end
if eq l 1
fjasc get fxo i
i = add i 1
continue
end
fxput i l
i = add i l
end
fputc 34
end
note brzfs k: field k of the last brsplit as a JSON string
fn brzfs k ulong to void
brzxs brfa k brfl k
end
fn brzft k ulong to void
fjiso brxdec brfa k add brfa k brfl k
end
fn brzref to void
fjtb
for i ulong get gbrefl 0 bound 512
fjtc get gbref i
end
fjstr
end
fn brzgp to void
fjtb
for i ulong get gbpl 0 bound 4096
fjtc get gbp i
end
fjstr
end
fn brzsha to void
fputc 34
brksh2
fputc 34
end
note ---- commit summaries (log rows "%H 0x1f %an 0x1f %at 0x1f %s", fields already split into gbf)
fn brzsum to void
fputc 123
fyk0 tbzksha
brzfs 0
fyk tbzkaut
brzfs 1
fyk tbzktim
brzft 2
fyk tbzksub
brzfs 3
fyk tbzkpat
fputc 34
brucmt brfa 0 brfl 0
fputc 34
fputc 125
end
note brzrows m: the first m log rows of fxo as a JSON array; returns the lines seen (as brcrows)
fn brzrows m ulong to ulong
n = get fxol 0
s = ulong 0
c = ulong 0
w = ulong 0
fputc 91
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
if lt c m
k = brsplit s e 31
if ge k 4
if gt w 0
fputc 44
end
brzsum
w = add w 1
end
end
c = add c 1
end
s = add e 1
end
fputc 93
ret c
end
note ---- numstat (files) and the diff text, both from the git output in fxo
fn brzfrow s ulong e ulong to void
fputc 123
fyk0 tbzkpat
brzxs brfa 2 sub e brfa 2
fyk tbzkad
if eq get fxo s 45
fynull
fyk tbzkdd
fynull
else
fnum brxdec brfa 0 add brfa 0 brfl 0
fyk tbzkdd
fnum brxdec brfa 1 add brfa 1 brfl 1
end
fputc 125
end
note brzfrows: the rows the HTML stat table shows (the first 3000 lines); true when more were cut
fn brzfrows to bool
n = get fxol 0
s = ulong 0
i = ulong 1
w = ulong 0
fputc 91
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
if gt i 3000
fputc 93
ret true
end
k = brsplit s e 9
if ge k 3
if gt w 0
fputc 44
end
brzfrow s e
w = add w 1
end
i = add i 1
end
s = add e 1
end
fputc 93
ret false
end
fn brzfnull to void
fyk tbzkfch
fynull
fyk tbzkadn
fynull
fyk tbzkdln
fynull
fyk tbzkfil
fynull
fyk tbzkftr
fybool false
end
note brzfiles st: files_changed .. files_truncated from numstat output (st: its fexec status)
fn brzfiles st long to void
if ne st 0
brzfnull
ret
end
n = get fxol 0
fls = ulong 0
ad = ulong 0
de = ulong 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
fls = add fls 1
ad = add ad brxdec s e
t = brxfind s e 9
de = add de brxdec add t 1 e
end
s = add e 1
end
fyk tbzkfch
fnum fls
fyk tbzkadn
fnum ad
fyk tbzkdln
fnum de
fyk tbzkfil
tr = brzfrows
fyk tbzkftr
fybool tr
end
note brzmeta: the extended header lines the HTML renderer shows (brdmeta)
fn brzmeta s ulong e ulong to bool
if or brxat s e tbdnew brxat s e tbddel
ret true
end
if or brxat s e tbdrf brxat s e tbdrt
ret true
end
if or brxat s e tbdbin or brxat s e tbdmd brxat s e tbdmn
ret true
end
ret false
end
note brzdln: one line of the HTML renderer's state machine (brdline): file, hunk and row count
fn brzdln s ulong e ulong to void
if brxat s e tbdgit
put gbzdt 0 1
put gbzdh 0 0
ret
end
if eq get gbzdt 0 0
ret
end
if brxat s e tbdat
put gbzdh 0 1
put gbzdc 0 add get gbzdc 0 1
ret
end
if eq s e
ret
end
ok = ne get gbzdh 0 0
if not ok
ok = brzmeta s e
end
if ok
put gbzdc 0 add get gbzdc 0 1
end
end
note brzdcut: where brdiff stops (BRDMAX bytes or BRDLN rows) into gbzcut; true when it cuts
fn brzdcut to bool
n = get fxol 0
put gbzdt 0 0
put gbzdh 0 0
put gbzdc 0 0
put gbzcut 0 n
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
brzdln s e
s = add e 1
if or gt s BRDMAX gt get gbzdc 0 BRDLN
if lt s n
put gbzcut 0 s
ret true
end
end
end
ret ne get fxotr 0 0
end
note brzdiff st: diff and diff_truncated from diff output (st: its fexec status; null when it failed)
fn brzdiff st long to void
fyk tbzkdif
if ne st 0
fynull
fyk tbzkdtr
fybool false
ret
end
tr = brzdcut
put gbzful 0 0
brzxs 0 get gbzcut 0
fyk tbzkdtr
fybool or tr ne get gbzful 0 0
end
fn brzdnull to void
fyk tbzkdif
fynull
fyk tbzkdtr
fybool false
end
note ---- /commits[/<ref>[/<path>]][?page=N]
fn brzpgl p ulong to void
fputc 34
bruactp tbcmts get gbpl 0
fput tbpg2
fnum p
fputc 34
end
fn brjcmts to long
if eq get gbrl 0 0
brdefref
end
if not brres
ret brerr 404
end
p = brpgnum
put gbpg 0 p
fkgit
fka tblog
fka tbfmtc
fka tbn1
fka tbn31
fkopen
fkt tbskip
brknum mul sub p 1 30
fkopen
brksha
if gt get gbpl 0 0
fka tbdd
fkopen
brkp
end
st = fexec BRTMO
if ne st 0
ret brerr 404
end
fyrhead tbzscm
brzcmts2 p
ret 200
end
fn brzcmts2 p ulong to void
fyk tbzkref
brzref
fyk tbzkcmt
brzsha
fyk tbzkpat
brzgp
fyk tbzkpg
fnum p
fyk tbzkpp
fnum 30
fyk tbzkcms
c = brzrows 30
fyk tbzknxt
if ge c 31
brzpgl add p 1
else
fynull
end
fyk tbzkprv
if gt p 1
brzpgl sub p 1
else
fynull
end
fyend
end
note ---- /commit/<sha> (.patch and .diff are the raw files of brcmtraw, never JSON)
fn brjcmt to long
mode = ulong 0
if brsuffix tbxpatch
mode = 1
end
if eq mode 0
if brsuffix tbxdiff
mode = 2
end
end
if not brres
ret brerr 404
end
if gt get gbpl 0 0
ret brerr 404
end
if gt mode 0
ret brcmtraw mode
end
fkgit
fka tbshow
fka tbsfmt
fka tbfmtk
fkopen
brksha
st = fexec BRTMO
n = get fxol 0
if or ne st 0 eq n 0
ret brerr 404
end
k = brsplit 0 n 31
if lt k 7
ret brerr 404
end
fyrhead tbzsc
brzcmthd
brzlinks
fkgit
fka tbshow
fka tbfmt0
fka tbnums
fka tbmm
fka tbdmfp
fkopen
brksha
st = fexec BRTMO
brzfiles st
fkgit
fka tbshow
fka tbfmt0
fka tbpp
fka tbdmfp
brkdiff
fkopen
brksha
st = fexec BRTMO
brzdiff st
fyend
ret 200
end
fn brzwho n ulong t ulong to void
fputc 123
fyk0 tbzknam
brzfs n
fyk tbzktim
brzft t
fputc 125
end
note brzcmthd: sha, parents, author, committer (only when the HTML shows it), subject, message
fn brzcmthd to void
fyk tbzksha
brzfs 0
fyk tbzkpar
brzpar
fyk tbzkaut
brzwho 2 3
fyk tbzkcom
if brfne 2 4
brzwho 4 5
else
fynull
end
brzmsg
end
fn brzpar to void
a = brfa 1
e = add a brfl 1
w = ulong 0
fputc 91
s = a
while lt s e bound 64
x = brxfind s e 32
if gt x s
if gt w 0
fputc 44
end
brzxs s sub x s
w = add w 1
end
s = add x 1
end
fputc 93
end
note brzmsg: subject = the h2 of brcmtmsg; message = the text of its pre block (HTML drops one
note leading newline after <pre>), null when the HTML has no pre
fn brzmsg to void
a = brfa 6
e = add a brfl 6
while gt e a bound BRBIG
if not brspc get fxo sub e 1
break
end
e = sub e 1
end
s = brxfind a e 10
fyk tbzksub
brzxs a sub s a
fyk tbzkmsg
b = e
if lt s e
b = add s 1
while lt b e bound BRBIG
if not brspc get fxo b
break
end
b = add b 1
end
end
if ge b e
fynull
ret
end
if eq get fxo b 10
b = add b 1
end
brzxs b sub e b
end
fn brzlinks to void
fyk tbzklnk
fputc 123
fyk0 tbzkpch
fputc 34
brucmt 0 0
brksh2
fput tbxpatch
fputc 34
fyk tbzkdif
fputc 34
brucmt 0 0
brksh2
fput tbxdiff
fputc 34
fyk tbzktre
fputc 34
brurepo
fputc 47
fput tbtree
fputc 47
brksh2
fputc 34
fputc 125
end
note ---- /compare and /compare/<a>...<b>
fn brjcmp to long
if eq get gbrl 0 0
ret brzcmpf
end
if not brcmpsplit
ret brerr 404
end
if not brcmpres
ret brerr 404
end
fyrhead tbzscp
fyk tbzkbas
brzside 0
fyk tbzkhd
brzside 1
brzclog
brzcdiff
fyk tbzkfrm
fynull
fyend
ret 200
end
note brzside w: {"ref": base (w 0, gbca / gbsa) or head (w 1, gbcb / gbsha) as typed, "sha"}
fn brzside w ulong to void
fputc 123
fyk0 tbzkref
fjtb
if eq w 0
for i ulong get gbcal 0
fjtc get gbca i
end
else
for i ulong get gbcbl 0
fjtc get gbcb i
end
end
fjstr
fyk tbzksha
fputc 34
for i ulong 40
if eq w 0
fputc get gbsa i
else
fputc get gbsha i
end
end
fputc 34
fputc 125
end
fn brzclog to void
fkgit
fka tblog
fka tbfmtc
fka tbn1
fka tbn251
brkcs tbdots2
st = fexec BRTMO
fyk tbzkcms
if ne st 0
fynull
fyk tbzkctr
fybool false
ret
end
c = brzrows 250
fyk tbzkctr
fybool gt c 250
end
fn brzcdiff to void
fkgit
fka tbdiff
fka tbnums
fka tbmm
brkcs tbdots
st = fexec BRTMO
brzfiles st
if ne st 0
brzdnull
ret
end
if eq get fxol 0 0
brzdnull
ret
end
fkgit
fka tbdiff
brkdiff
brkcs tbdots
st = fexec BRTMO
brzdiff st
end
note brzcmpf: the form page; ?a=&b= redirects exactly as brcmpform
fn brzcmpf to long
la = fqget tbqa
if and gt la 0 le la 200
if brcmpq 0 la
lb = fqget tbqb
if and gt lb 0 le lb 200
if brcmpq 1 lb
brcmploc
ret 302
end
end
end
end
fyrhead tbzscp
fyk tbzkbas
fynull
fyk tbzkhd
fynull
fyk tbzkcms
fputc 91
fputc 93
fyk tbzkctr
fybool false
brzfempt
brzdnull
fyk tbzkfrm
brzform
fyend
ret 200
end
fn brzfempt to void
fyk tbzkfch
fnum 0
fyk tbzkadn
fnum 0
fyk tbzkdln
fnum 0
fyk tbzkfil
fputc 91
fputc 93
fyk tbzkftr

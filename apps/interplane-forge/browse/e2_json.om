note brzbrrow: a branch row (refname, objectname, committerdate, subject in gbf)
fn brzbrrow to void
a = brrsn
l = sub add brfa 0 brfl 0 a
fputc 123
fyk0 tbzknam
brzxs a l
fyk tbzkdef
fybool brisdef a l
fyk tbzkcmt
fputc 123
fyk0 tbzksha
brzfs 1
fyk tbzktim
brzft 2
fyk tbzksub
brzfs 3
fyk tbzkpat
fputc 34
brucmt brfa 1 brfl 1
fputc 34
fputc 125
brzrtree a l
fyk tbzkarc
brzarch tbarch a l
fputc 125
end
note brztgrow: a tag row (refname, objectname, *objectname, creatordate, subject in gbf)
fn brztgrow to void
a = brrsn
l = sub add brfa 0 brfl 0 a
c = ulong 2
if eq brfl 2 0
c = 1
end
fputc 123
fyk0 tbzknam
brzxs a l
fyk tbzkobj
brzfs 1
fyk tbzkcmt
brzfs c
fyk tbzktim
brzft 3
fyk tbzksub
brzfs 4
fyk tbzkcp
fputc 34
brucmt brfa c brfl c
fputc 34
brzrtree a l
fyk tbzkarc
brzarch tbarcht a l
fyk tbzkrel
fputc 34
brurepo
fput tbreltg
bruxo a l
fputc 34
fputc 125
end
note brzrefs tg: the rows of brrefs output in fxo (the HTML's first 2000 lines); true when cut
fn brzrefs tg bool to bool
n = get fxol 0
s = ulong 0
c = ulong 0
w = ulong 0
m = ulong 4
if tg
m = 5
end
fputc 91
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
if ge c 2000
fputc 93
ret true
end
k = brsplit s e 31
if ge k m
if gt w 0
fputc 44
end
if tg
brztgrow
else
brzbrrow
end
w = add w 1
end
c = add c 1
end
s = add e 1
end
fputc 93
ret false
end
fn brjbr to long
if gt get gbrl 0 0
ret brerr 404
end
brdefsave
if not brrefs false
ret brerr 404
end
fyrhead tbzsbr
fyk tbzkbr
tr = brzrefs false
fyk tbzktr
fybool tr
fyend
ret 200
end
fn brjtag to long
if gt get gbrl 0 0
ret brerr 404
end
if not brrefs true
ret brerr 404
end
fyrhead tbzstg
fyk tbzktgs
tr = brzrefs true
fyk tbzktr
fybool tr
fyend
ret 200
end

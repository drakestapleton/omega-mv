note browse/a_core.om (ForgeBrowse): request-rest parsing, ref and path validation, ref
note resolution against the allow-listed storage, URL emission and small helpers.
note Names: functions br*, globals gb*, texts tb*. Contract: docs/CONTRACT.md v1.
note No user text ever reaches git as a ref: a ref is either a name listed by for-each-ref
note (longest match against the URL) or 7..40 lowercase hex naming a commit reachable from a
note published head or tag (brreach, shared with dl). Paths are checked by brokp
note (no NUL or control bytes, no empty, "." or ".." segment, no leading "-" or "/").
global gbr uchar 4096
global gbrl ulong 1
global gbw uchar 64
global gbwl ulong 1
global gbref uchar 512
global gbrefl ulong 1
global gbfr uchar 1024
global gbfrl ulong 1
global gbsha uchar 40
global gbshl ulong 1
global gbsa uchar 40
global gbp uchar 4096
global gbpl ulong 1
global gbn ulong 16
text tbfer "for-each-ref"
text tbfmtr "--format=%(refname)"
text tbrh "refs/heads"
text tbrt "refs/tags"
text tbrhs "refs/heads/"
text tbrts "refs/tags/"
text tbns "refs/namespaces/"
text tbnsrh "/refs/heads"
text tbnsrt "/refs/tags"
text tbrevp "rev-parse"
text tbverif "--verify"
text tbq "-q"
text tbeoo "--end-of-options"
text tbpcom "^{commit}"
text tbmain "main"
text tbah "<a href=\""
text tbaq "\">"
text tbae "</a>"
text tbhex "0123456789ABCDEF"
text tblhex "0123456789abcdef"
const BRTMO long 15000000000
const BRBIG ulong 33554432
note ---- byte classes
fn brdig c uchar to bool
ret and ge c 48 le c 57
end
fn bralpha c uchar to bool
if and ge c 97 le c 122
ret true
end
ret and ge c 65 le c 90
end
fn bralnum c uchar to bool
if brdig c
ret true
end
ret bralpha c
end
fn brlhex c uchar to bool
if brdig c
ret true
end
ret and ge c 97 le c 102
end
fn brspc c uchar to bool
ret or eq c 32 eq c 9
end
fn brlow c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn brhexv c uchar to ulong
if brdig c
ret ulong sub c 48
end
if and ge c 97 le c 102
ret ulong sub c 87
end
if and ge c 65 le c 70
ret ulong sub c 55
end
ret 99
end
note ---- rest parsing: frest = "" | "/" | "/<word>[/<rest>]"; rest percent-decoded into gbr
fn brisw t view uchar * to bool
n = get gbwl 0
if ne n len t
ret false
end
for i ulong n
if ne get gbw i get t i
ret false
end
end
ret true
end
fn brparse to bool
n = get frestl 0
put gbwl 0 0
put gbrl 0 0
if eq n 0
ret true
end
i = ulong 1
while lt i n bound BRBIG
c = get frest i
if eq c 47
break
end
k = get gbwl 0
if ge k 63
ret false
end
put gbw k c
put gbwl 0 add k 1
i = add i 1
end
if lt i n
i = add i 1
end
ret brdecr i n
end
note brdecr: percent-decode frest[a, e) into gbr; refuse NUL and control bytes (raw or decoded)
fn brdecr a ulong e ulong to bool
o = ulong 0
i = a
while lt i e bound BRBIG
c = get frest i
if eq c 37
if lt add i 2 e
h = brhexv get frest add i 1
l = brhexv get frest add i 2
if and lt h 16 lt l 16
c = uchar add mul h 16 l
i = add i 2
end
end
end
if or lt c 32 eq c 127
ret false
end
if ge o 4096
ret false
end
put gbr o c
o = add o 1
i = add i 1
end
put gbrl 0 o
ret true
end
note ---- path checks on gbp[0, gbpl)
fn brseg s ulong e ulong to bool
if ge s e
ret false
end
if eq get gbp s 46
if eq e add s 1
ret false
end
if eq e add s 2
if eq get gbp add s 1 46
ret false
end
end
end
ret true
end
fn brokp to bool
n = get gbpl 0
if eq n 0
ret true
end
if or eq get gbp 0 45 eq get gbp 0 47
ret false
end
s = ulong 0
for i ulong n bound BRBIG
c = get gbp i
if or lt c 32 eq c 127
ret false
end
if eq c 47
if not brseg s i
ret false
end
s = add i 1
end
end
ret brseg s n
end
note ---- git argument helpers
fn brkns t view uchar * to void
fkopen
for i ulong len tbns
fkc get tbns i
end
for i ulong len tfnid
fkc get tfnid i
end
for i ulong len t
fkc get t i
end
end
fn brkfr to void
for i ulong get gbfrl 0
fkc get gbfr i
end
end
fn brksha to void
for i ulong get gbshl 0
fkc get gbsha i
end
end
fn brkp to void
for i ulong get gbpl 0
fkc get gbp i
end
end
note brkshp: one argument "<sha>:<path>"
fn brkshp to void
fkopen
brksha
fkc 58
brkp
end
note ---- fxo helpers
fn brxat a ulong e ulong t view uchar * to bool
k = len t
if gt add a k e
ret false
end
for i ulong k
if ne get fxo add a i get t i
ret false
end
end
ret true
end
fn brxfind a ulong e ulong c uchar to ulong
i = a
while lt i e bound BRBIG
if eq get fxo i c
ret i
end
i = add i 1
end
ret e
end
fn brxdec a ulong e ulong to ulong
v = ulong 0
i = a
while lt i e bound BRBIG
c = get fxo i
if not brdig c
ret v
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end
note brpfx: length of the ref prefix of fxo[s, e) (refs/heads/, refs/tags/, or the delegate
note namespace's), 0 when it is none of them
fn brpfx s ulong e ulong to ulong
if brxat s e tbrhs
ret len tbrhs
end
if brxat s e tbrts
ret len tbrts
end
if not brxat s e tbns
ret 0
end
a = add s len tbns
if not brxat a e tfnid
ret 0
end
a = add a len tfnid
if brxat a e tbnsrh
if lt add a len tbnsrh e
if eq get fxo add a len tbnsrh 47
ret sub add a add len tbnsrh 1 s
end
end
end
if brxat a e tbnsrt
if lt add a len tbnsrt e
if eq get fxo add a len tbnsrt 47
ret sub add a add len tbnsrt 1 s
end
end
end
ret 0
end
note brmatch: short name fxo[a, e) is a prefix of gbr ending at a "/" or the end
fn brmatch a ulong e ulong to bool
k = sub e a
n = get gbrl 0
if or eq k 0 gt k n
ret false
end
for i ulong k
if ne get fxo add a i get gbr i
ret false
end
end
if eq k n
ret true
end
ret eq get gbr k 47
end
note brbest: longest listed ref matching the start of gbr; sets gbfr/gbref, returns its length
fn brbest to ulong
n = get fxol 0
best = ulong 0
bs = ulong 0
be = ulong 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
pl = brpfx s e
if gt pl 0
if brmatch add s pl e
k = sub e add s pl
note a ref name longer than gbref (512 bytes) is not a match: the copy below would write past gbref,
note which is trap 3 and ends the server (exit 103). The page is then a 404.
if and gt k best le k len gbref
best = k
bs = s
be = e
end
end
end
s = add e 1
end
if eq best 0
ret 0
end
brsetfr bs be
put gbrefl 0 best
for i ulong best
put gbref i get gbr i
end
ret best
end
fn brsetfr a ulong e ulong to void
k = sub e a
if gt k 1024
k = 1024
end
for i ulong k
put gbfr i get fxo add a i
end
put gbfrl 0 k
end
note brhexseg: gbr starts with 7..40 lowercase hex then "/" or the end; returns that length or 0
fn brhexseg to ulong
n = get gbrl 0
k = ulong 0
while lt k n bound BRBIG
c = get gbr k
if eq c 47
break
end
if not brlhex c
ret 0
end
k = add k 1
end
if or lt k 7 gt k 40
ret 0
end
ret k
end
note brrevp: rev-parse gbfr^{commit} into gbsha; false when it does not name a commit
fn brrevp to bool
put gbshl 0 0
fkgit
fka tbrevp
fka tbverif
fka tbq
fka tbeoo
fkopen
brkfr
for i ulong len tbpcom
fkc get tbpcom i
end
st = fexec BRTMO
if ne st 0
ret false
end
if lt get fxol 0 40
ret false
end
for i ulong 40
c = get fxo i
if not brlhex c
ret false
end
put gbsha i c
end
put gbshl 0 40
ret true
end
note brres: resolve gbr = "<ref>[/<path>]" (decoded URL rest). Sets gbref (as in the URL),
note gbfr (full refname or hex), gbsha (40 hex) and gbp (path, trailing "/" dropped). False = 404.
fn brres to bool
put gbrefl 0 0
put gbpl 0 0
put gbshl 0 0
put gbfrl 0 0
if eq get gbrl 0 0
ret false
end
fkgit
fka tbfer
fka tbfmtr
fka tbrh
fka tbrt
brkns tbnsrh
brkns tbnsrt
st = fexec BRTMO
if ne st 0
ret false
end
note a ref list that did not fit fxo is not searched: the ref asked for may lie past the cut
if ne get fxotr 0 0
fincut
ret false
end
k = brbest
hx = false
if eq k 0
k = brhexseg
if eq k 0
ret false
end
hx = true
for i ulong k
put gbref i get gbr i
put gbfr i get gbr i
end
put gbrefl 0 k
put gbfrl 0 k
end
if not brsetp k
ret false
end
if not brrevp
ret false
end
if hx
ret brreach
end
ret true
end
note brreach: gbsha is reachable from a published head or tag (root or delegate namespace);
note the check is dl's (dlrch0 / dlrch1), so a commit id other peers, cobs or rewritten
note history hold is 404 in browse exactly as in downloads
fn brreach to bool
dlrch0
fkopen
brksha
ret dlrch1
end
note brsetp: gbp = gbr after the ref (k bytes) and its "/", without trailing slashes; checked
fn brsetp k ulong to bool
n = get gbrl 0
a = k
if lt a n
a = add a 1
end
e = n
while gt e a bound BRBIG
if ne get gbr sub e 1 47
break
end
e = sub e 1
end
o = ulong 0
for i ulong sub e a
put gbp i get gbr add a i
o = add o 1
end
put gbpl 0 o
ret brokp
end
note brdefref: put the default branch name into gbr (HEAD's branch, nodes/head.om; "main" when none)
fn brdefref to void
put gbrl 0 0
if nshead
for i ulong get nshbl 0 bound 256
put gbr i get nshb i
end
put gbrl 0 get nshbl 0
end
if eq get gbrl 0 0
for i ulong len tbmain
put gbr i get tbmain i
end
put gbrl 0 len tbmain
end
end
note ---- URL emission into fob (percent-encoding; every byte not unreserved or "/" is %XX)
fn bruc c uchar to void
ok = bralnum c
if or eq c 45 eq c 46
ok = true
end
if or eq c 95 eq c 126
ok = true
end
if eq c 47
ok = true
end
if ok
fputc c
ret
end
fputc 37
fputc get tbhex shr c 4
fputc get tbhex and c 15
end
fn brurepo to void
fputb
for i ulong get fownl 0
bruc get fown i
end
fputc 47
for i ulong get frepol 0
bruc get frepo i
end
end
fn bruref to void
for i ulong get gbrefl 0
bruc get gbref i
end
end
fn brup a ulong n ulong to void
for i ulong n bound BRBIG
bruc get gbp add a i
end
end
note bruact: <base><owner>/<repo>/<t>/<ref>
fn bruact t view uchar * to void
brurepo
fputc 47
fput t
fputc 47
bruref
end
note bruactp: bruact then "/" and gbp[0, n) when n > 0
fn bruactp t view uchar * n ulong to void
bruact t
if gt n 0
fputc 47
brup 0 n
end
end
note brushx: url-encode fxo[a, a+n) (refs, paths and shas read from git output)
fn bruxo a ulong n ulong to void
for i ulong n bound BRBIG
bruc get fxo add a i
end
end
note ---- misc output
fn brgesc a ulong n ulong to void
for i ulong n bound BRBIG
fescc get gbp add a i
end
end
fn brrefesc to void
for i ulong get gbrefl 0
fescc get gbref i
end
end
fn brshort to void
for i ulong 7
fputc get gbsha i
end
end
fn brd2 v ulong to void
fputc uchar add div v 10 48
fputc uchar add rem v 10 48
end
note brdate: unix seconds as YYYY-MM-DD (UTC, proleptic Gregorian, days-from-civil inverse)
fn brdate t ulong to void
z = add div t 86400 719468
era = div z 146097
doe = sub z mul era 146097
yoe = div sub add sub doe div doe 1460 div doe 36524 div doe 146096 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
fnum y
fputc 45
brd2 m
fputc 45
brd2 d
end
note brtime: the UTC time of day HH:MM
fn brtime t ulong to void
s = rem t 86400
brd2 div s 3600
fputc 58
brd2 div rem s 3600 60
end

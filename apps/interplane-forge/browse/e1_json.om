note browse/e1_json.om: machine form of /tree, /blob, /blame and /search (ForgeBrowse; docs/API.md,
note docs/api-browse-files.md). Each handler runs the same validation and resolution as its HTML
note page (brres, brotype, brokp through brsetp, brreach for hex refs) before it writes anything, so
note a JSON request reads nothing the HTML page refuses and answers the same status. Helpers: bry*,
note texts tby*, globals gby*, consts BRY*.
note BRYCAP: stop writing long strings and lists when fob (8 MiB) has less than 64 KiB left, so the
note document always closes as valid JSON; the cut is reported (content_truncated / truncated)
const BRYCAP ulong 8323072
global gbytr ulong 1
global gbybin ulong 1
global gbyxtr ulong 1
global gbyln ulong 1
global gbylv ulong 1
text tbyst "forge/tree/1"
text tbysb "forge/blob/1"
text tbysl "forge/blame/1"
text tbyss "forge/repo-search/1"
text tbyrep "\\ufffd"
text tbyplain "?plain=1"
text tbyktext "text"
text tbykimg "image"
text tbykbinv "binary"
text tbyklarg "large"
text tbykref "ref"
text tbykrk "ref_kind"
text tbykcm "commit"
text tbykpa "path"
text tbykpar "parent"
text tbykent "entries"
text tbyktr "truncated"
text tbykrd "readme"
text tbyklc "last_commit"
text tbykhi "history"
text tbyknm "name"
text tbykty "type"
text tbyksh "sha"
text tbyksz "size"
text tbykht "html"
text tbykraw "raw"
text tbykbin "binary"
text tbyklin "lines"
text tbykkd "kind"
text tbyklk "links"
text tbykbl "blame"
text tbykso "source"
text tbykre "rendered"
text tbykco "content"
text tbykct "content_truncated"
text tbykcms "commits"
text tbykln "line"
text tbyktx "text"
text tbykq "query"
text tbykhit "hits"
text tbykau "author"
text tbyktm "time"
text tbyksu "subject"
note ---- JSON strings straight from fxo (no 64 KiB fjt limit): well-formed UTF-8 kept, every other
note byte U+FFFD, the escapes of fjasc; stops (gbytr = 1) when fob is nearly full
fn bryul i ulong e ulong to ulong
c = get fxo i
if lt c 128
ret 1
end
n = ulong 0
if and ge c 194 le c 223
n = 2
end
if and ge c 224 le c 239
n = 3
end
if and ge c 240 le c 244
n = 4
end
if eq n 0
ret 0
end
if gt add i n e
ret 0
end
for k ulong sub n 1 bound 3
x = get fxo add add i k 1
if or lt x 128 gt x 191
ret 0
end
end
d = get fxo add i 1
if and eq c 224 lt d 160
ret 0
end
if and eq c 237 gt d 159
ret 0
end
if and eq c 240 lt d 144
ret 0
end
if and eq c 244 gt d 143
ret 0
end
ret n
end
fn bryxs a ulong n ulong to void
fputc 34
e = add a n
i = a
while lt i e bound BRBIG
if gt get fobl 0 BRYCAP
put gbytr 0 1
break
end
l = bryul i e
if eq l 0
fput tbyrep
i = add i 1
continue
end
if eq l 1
fjasc get fxo i
i = add i 1
continue
end
for k ulong l bound 4
fputc get fxo add i k
end
i = add i l
end
fputc 34
end
note ---- small writers
fn bryref to void
fjtb
for i ulong get gbrefl 0 bound 512
fjtc get gbref i
end
fjstr
end
fn brypstr to void
fjtb
for i ulong get gbpl 0 bound 4096
fjtc get gbp i
end
fjstr
end
fn brysha to void
fputc 34
for i ulong get gbshl 0 bound 40
fputc get gbsha i
end
fputc 34
end
note bryl t n: "<repo>/<t>/<ref>[/<gbp[0, n)>]" as a JSON string (the page's href, bruactp)
fn bryl t view uchar * n ulong to void
fputc 34
bruactp t n
fputc 34
end
note bryhd0: ,"ref":..,"commit":..; bryhead t: the document head of a /tree, /blob or /blame page
fn bryhd0 to void
fyk tbykref
bryref
fyk tbykcm
brysha
end
fn bryhead t view uchar * to void
fyrhead t
fyk tbykref
bryref
fyk tbykrk
k = brrkind
if eq k 1
fysv tbkbr
end
if eq k 2
fysv tbktag
end
if eq k 3
fysv tbkcmt
end
fyk tbykcm
brysha
fyk tbykpa
brypstr
end
note brysum: the commit summary {sha, author, time, subject, path}: sha fxo[o, o+40), author
note fxo[a, a+al), time t (epoch), subject fxo[s, s+sl)
fn brysum o ulong a ulong al ulong t ulong s ulong sl ulong to void
fputc 123
fyk0 tbyksh
fputc 34
fxput o 40
fputc 34
fyk tbykau
bryxs a al
fyk tbyktm
fjiso t
fyk tbyksu
bryxs s sl
fyk tbykpa
fputc 34
brucmt o 40
fputc 34
fputc 125
end
note ---- /tree/<ref>[/<path>] (brtreepg)
fn brjtree to long
if not brres
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 2
brloc tbblob
ret 302
end
put gbytr 0 0
bryhead tbyst
fyk tbykpar
brypar
fyk tbykhi
bryl tbcmts get gbpl 0
fyk tbyklc
brylast
bryents
fyk tbykrd
bryrdme
fyend
ret 200
end
note brypar: the ".." row of the listing (brtup), null at the root
fn brypar to void
if eq get gbpl 0 0
fynull
ret
end
fputc 34
brtup
fputc 34
end
note brylast: the brlast box (newest commit touching gbp at gbsha) as a commit summary, or null
fn brylast to void
fksource
fka tblog
fka tbn1
fka tbone
fka tbfmtc
fkopen
brksha
if gt get gbpl 0 0
fka tbdd
fkopen
brkp
end
st = fexec BRTMO
n = get fxol 0
if or ne st 0 eq n 0
fynull
ret
end
e = brxfind 0 n 10
k = brsplit 0 e 31
if lt k 4
fynull
ret
end
o = brfa 0
a = brfa 1
al = brfl 1
t = brxdec brfa 2 add brfa 2 brfl 2
s = brfa 3
sl = brfl 3
brysum o a al t s sl
end
note bryents: ,"entries":[..],"truncated":b in brlist's order (pass 1 trees, pass 2 the rest, the
note same BRMAXE cut); an ls-tree failure is the page's empty listing
fn bryents to void
put gbrml 0 0
put gbrmk 0 0
fyk tbykent
fputc 91
c = ulong 0
if brlsx
c = bryents2
end
fputc 93
fyk tbyktr
fybool or ge c BRMAXE ne get gbytr 0 0
end
fn bryents2 to ulong
n = get fxol 0
c = ulong 0
for q ulong 2
pass = add q 1
s = ulong 0
while lt s n bound BRBIG
if gt get fobl 0 BRYCAP
put gbytr 0 1
break
end
e = brxfind s n 0
if bryent s e pass c
c = add c 1
end
if ge c BRMAXE
break
end
s = add e 1
end
end
ret c
end
note bryent: brtent's filter for one ls-tree -z -l record "<mode> <type> <sha> <size>\t<name>"
fn bryent s ulong e ulong pass ulong c ulong to bool
t = add s 7
if ge t e
ret false
end
tab = brxfind s e 9
if ge tab e
ret false
end
ch = get fxo t
istree = eq ch 116
want = eq pass 1
if and istree not want
ret false
end
if and not istree want
ret false
end
if gt c 0
fputc 44
end
bryent2 s t tab e
if and not istree ne ch 99
brreadme add tab 1 sub e add tab 1
end
ret true
end
fn bryent2 s ulong t ulong tab ulong e ulong to void
na = add tab 1
nl = sub e na
s2 = brxfind t tab 32
s3 = brxfind add s2 1 tab 32
ch = get fxo t
fputc 123
fyk0 tbyknm
bryxs na nl
fyk tbykty
fputc 34
fxput t sub s2 t
fputc 34
fyk tbyksh
fputc 34
fxput add s2 1 sub s3 add s2 1
fputc 34
fyk tbyksz
if or eq ch 116 eq ch 99
fynull
else
bryszv add s3 1 tab
end
fyk tbykpa
brypath na nl
fyk tbykht
bryhref ch na nl
fputc 125
end
note bryszv: the decimal size field fxo[a, e) (leading spaces), null when it has no digits
fn bryszv a ulong e ulong to void
v = ulong 0
d = ulong 0
i = a
while lt i e bound 64
c = get fxo i
if brdig c
v = add mul v 10 ulong sub c 48
d = add d 1
end
i = add i 1
end
if eq d 0
fynull
ret
end
fnum v
end
note brypath: the repo path gbp/name as a JSON string
fn brypath na ulong nl ulong to void
fjtb
n = get gbpl 0
for i ulong n bound 4096
fjtc get gbp i
end
if gt n 0
fjtc 47
end
note a tree entry name has no length limit in git: the bound is the buffer, not 4096 (fjtc cuts the string)
for i ulong nl bound BRBIG
fjtc get fxo add na i
end
fjstr
end
note bryhref: the row's link (brtdir / brtfile); a submodule row has none
fn bryhref ch uchar na ulong nl ulong to void
if eq ch 99
fynull
ret
end
fputc 34
if eq ch 116
bruactp tbtree get gbpl 0
else
bruactp tbblob get gbpl 0
end
fputc 47
bruxo na nl
fputc 34
end
note bryrdme: the README brrdshow renders (name kept by brreadme; it must exist at gbsha), or null
fn bryrdme to void
n = get gbrml 0
if eq n 0
fynull
ret
end
if not bryrdok
fynull
ret
end
fputc 123
fyk0 tbyknm
fjtb
for i ulong n bound 256
fjtc get gbrm i
end
fjstr
fyk tbykht
bryrdl tbblob
fyk tbykraw
bryrdl tbraw
fputc 125
end
fn bryrdl t view uchar * to void
fputc 34
bruactp t get gbpl 0
fputc 47
for i ulong get gbrml 0 bound 256
bruc get gbrm i
end
fputc 34
end
note bryrdok: git cat-file -e <sha>:<gbp>/<readme> (brrdshow shows nothing when the blob is unreadable)
fn bryrdok to bool
fksource
fka tbcatf
fka tbge
fkopen
brksha
fkc 58
if gt get gbpl 0 0
brkp
fkc 47
end
for i ulong get gbrml 0 bound 256
fkc get gbrm i
end
st = fexec BRTMO
ret eq st 0
end
note ---- /blob/<ref>/<path> (brblobpg)
fn brjblob to long
if not brres
ret brerr 404
end
if eq get gbpl 0 0
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 1
brloc tbtree
ret 302
end
if not brcatb
ret brerr 404
end
if not brybsz
ret brerr 404
end
put gbytr 0 0
bryhead tbysb
fyk tbyknm
brybname
brjblob2
fyend
ret 200
end
note brybsz: binary flag, size and line count from the cat-file output in fxo. A blob larger than
note fxo (fxotr) gets its size from cat-file -s and no line count (its text is not in memory)
fn brybsz to bool
tr = ne get fxotr 0 0
put gbybin 0 0
if brbin
put gbybin 0 1
end
if not tr
put gbyxtr 0 0
put gbbsz 0 get fxol 0
put gbyln 0 brlines
put gbylv 0 1
ret true
end
put gbyxtr 0 1
put gbylv 0 0
ret brbsz
end
fn brybname to void
n = get gbpl 0
k = n
while gt k 0 bound BRBIG
if eq get gbp sub k 1 47
break
end
k = sub k 1
end
fjtb
for i ulong sub n k bound 4096
fjtc get gbp add k i
end
fjstr
end
fn brjblob2 to void
fyk tbyksz
fnum get gbbsz 0
fyk tbyklin
if eq get gbylv 0 0
fynull
else
fnum get gbyln 0
end
fyk tbykbin
fybool ne get gbybin 0 0
k = brykind
fyk tbykkd
brykname k
fyk tbyklk
brylinks
fyk tbykco
if le k 2
bryxs 0 get fxol 0
else
fynull
end
fyk tbykct
fybool ne get gbytr 0 0
end
note brykind: brbbody's classes: 1 text (code table), 2 markdown (rendered), 3 image, 4 binary,
note 5 large (too large to show; above BRRAWMX also without a raw link)
fn brykind to ulong
if gt get gbbsz 0 BRRAWMX
ret 5
end
brext
k = brimgk
if and gt k 0 lt k 8
ret 3
end
if or ne get gbybin 0 0 ne k 0
ret 4
end
if or gt get fxol 0 BRSHOW ne get gbyxtr 0 0
ret 5
end
if and brismd not brplain
ret 2
end
ret 1
end
fn brykname k ulong to void
if eq k 1
fysv tbyktext
end
if eq k 2
fysv tbxmkd
end
if eq k 3
fysv tbykimg
end
if eq k 4
fysv tbykbinv
end
if eq k 5
fysv tbyklarg
end
end
note brylinks: brbinfo's links: raw (none above BRRAWMX), blame, history, and the Markdown
note source / rendered switch (only the one the page offers)
fn brylinks to void
n = get gbpl 0
fputc 123
fyk0 tbykraw
if le get gbbsz 0 BRRAWMX
bryl tbraw n
else
fynull
end
fyk tbykbl
bryl tbblame n
fyk tbykhi
bryl tbcmts n
md = brismd
pl = brplain
fyk tbykso
if and md not pl
fputc 34
bruactp tbblob n
fput tbyplain
fputc 34
else
fynull
end
fyk tbykre
if and md pl
bryl tbblob n
else
fynull
end
fputc 125
end
note ---- /blame/<ref>/<path> (brblamepg)
fn brjblame to long
if not brres
ret brerr 404
end
if eq get gbpl 0 0
ret brerr 404
end
k = brotype
if eq k 0
ret brerr 404
end
if eq k 1
brloc tbtree
ret 302
end
fksource
fka tbblame
fka tbporc
fkopen
brksha
fka tbdd
fkopen
brkp
st = fexec BRTMO
if ne st 0
ret brerr 404
end
put gbytr 0 0
bryhead tbysl
fyk tbykhi
bryl tbcmts get gbpl 0
brybscan
fyk tbykcms
brycms
fyk tbyklin
brybl
fyk tbyktr
fybool or ne get fxotr 0 0 ne get gbytr 0 0
fyend
ret 200
end
note brybscan: brblame's walk without output: fills the commit table (gbbk, gbbo, gbba, gbbt, gbbs)
fn brybscan to void
put gbbn 0 0
n = get fxol 0
cur = ulong 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
c = uchar 10
if lt s e
c = get fxo s
end
if brbishdr s e
cur = brbhdr s e
else
if ne c 9
brbkv cur s e
end
end
s = add e 1
end
end
fn brycms to void
fputc 91
for i ulong get gbbn 0 bound 4096
if gt i 0
fputc 44
end
brycm1 i
end
fputc 93
end
fn brycm1 i ulong to void
o = get gbbo i
a = get gbba i
al = get gbbal i
t = get gbbt i
s = get gbbs i
sl = get gbbsl i
brysum o a al t s sl
end
note brybl: the content rows in file order, each with the commit of its porcelain header
fn brybl to void
fputc 91
n = get fxol 0
ho = n
ln = ulong 0
cnt = ulong 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
if lt s e
if eq get fxo s 9
if gt get fobl 0 BRYCAP
put gbytr 0 1
break
end
if gt cnt 0
fputc 44
end
brybl1 ln ho add s 1 e
cnt = add cnt 1
end
end
if brbishdr s e
ho = s
ln = brbfin s e
end
s = add e 1
end
fputc 93
end
fn brybl1 ln ulong ho ulong a ulong e ulong to void
fputc 123
fyk0 tbykln
fnum ln
fyk tbykcm
if lt ho get fxol 0
fputc 34
fxput ho 40
fputc 34
else
fynull
end
fyk tbyktx
bryxs a sub e a
fputc 125
end
note ---- /search?q= (brsrchpg)
fn brjsrch to long
if gt get gbrl 0 0
ret brerr 404
end
q = fqget tbq1
put gbql 0 0
bad = false
if gt q 256
ret brerr 400
end
if gt q 0
bad = not brsq ulong q
end
brdefref
if not brres
ret brerr 404
end
if bad
ret brerr 400
end
put gbytr 0 0
fyrhead tbyss
fyk tbykq
if gt get gbql 0 0
fjtb
for i ulong get gbql 0 bound 256
fjtc get gbq i
end
fjstr
else
fynull
end
bryhd0
fyk tbykhit
tr = false
if gt get gbql 0 0
tr = brysrun
else
fputc 91
fputc 93
end
fyk tbyktr
fybool tr
fyend
ret 200
end
note brysrun: brsrun's git grep; the hits array; true when the BRHITS cap cut the list
fn brysrun to bool
fksource
fka tbgrep
fka tbgz
fka tbgn
fka tbgi
fka tbgii
fka tbgf
fka tbnocol
fka tbgmc
fka tbge
fkopen
for i ulong get gbql 0 bound 256
fkc get gbq i
end
fkopen
brksha
st = fexec BRTMO
n = get fxol 0
fputc 91
if or ne st 0 eq n 0
fputc 93
ret false
end
tr = bryhits n
fputc 93
ret tr
end
note bryhits: brshits' grouping of "<sha>:<path>\0<line>\0<text>" lines by file, same cap
fn bryhits n ulong to bool
s = ulong 0
c = ulong 0
pa = ulong 0
pl = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
a = add s 41
z = brxfind a e 0
if and lt a z lt z e
if brxsame pa pl a sub z a
fputc 44
else
if gt pl 0
fputc 93
fputc 125
fputc 44
end
bryshead a sub z a
pa = a
pl = sub z a
end
bryshit a sub z a add z 1 e
c = add c 1
end
if ge c BRHITS
if lt add e 1 n
fputc 93
fputc 125
ret true
end
end
s = add e 1
end
if gt pl 0
fputc 93
fputc 125
end
ret false
end
fn bryshref a ulong l ulong to void
bruact tbblob
fputc 47
bruxo a l
end
fn bryshead a ulong l ulong to void
fputc 123
fyk0 tbykpa
bryxs a l
fyk tbykht
fputc 34
bryshref a l
fputc 34
fyk tbyklin
fputc 91
end
fn bryshit a ulong l ulong b ulong e ulong to void
y = brxfind b e 0
t = add y 1
m = ulong 0
if lt t e
m = sub e t
end
fputc 123
fyk0 tbykln
fnum brxdec b y
fyk tbyktx
bryxs t m
fyk tbykht
fputc 34
bryshref a l
fputc 35
fputc 76
fxput b sub y b
fputc 34
fputc 125
end

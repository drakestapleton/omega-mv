note browse/c2_hist.om: /commits, /commit/<sha>[.patch|.diff], the diff renderer, /branches,
note /tags and /compare (ForgeBrowse).
global gbdo ulong 1
global gbdn ulong 1
global gbdi ulong 1
global gbdt ulong 1
global gbdh ulong 1
global gbdc ulong 1
global gbca uchar 256
global gbcal ulong 1
global gbcb uchar 256
global gbcbl ulong 1
global gbdef uchar 256
global gbdefl ulong 1
const BRDMAX ulong 4194304
const BRDLN ulong 30000
text tbshow "show"
text tbsfmt "-s"
text tbfmtk "--format=%H%x1f%P%x1f%an%x1f%at%x1f%cn%x1f%ct%x1f%B"
text tbfmt0 "--format="
text tbnums "--numstat"
text tbpp "-p"
text tbmm "-M"
text tbnocol "--no-color"
text tbnoext "--no-ext-diff"
text tbdmfp "--diff-merges=first-parent"
text tbdiff "diff"
text tbfmtp "format-patch"
text tbstdo "--stdout"
text tbx1 "-1"
text tbn31 "31"
text tbn251 "251"
text tbsort "--sort=-committerdate"
text tbsortt "--sort=-creatordate"
text tbfmtb "--format=%(refname)%1f%(objectname)%1f%(committerdate:unix)%1f%(contents:subject)"
text tbfmtt "--format=%(refname)%1f%(objectname)%1f%(*objectname)%1f%(creatordate:unix)%1f%(contents:subject)"
text tbdgit "diff --git "
text tbdat "@@"
text tbdb " b/"
text tbdnew "new file mode"
text tbddel "deleted file mode"
text tbdrf "rename from"
text tbdrt "rename to"
text tbdbin "Binary files"
text tbdmd "old mode"
text tbdmn "new mode"
text tbxpatch ".patch"
text tbxdiff ".diff"
text tbtcmts "Commits"
text tbtcmt "Commit"
text tbtbr "Branches"
text tbttag "Tags"
text tbtcmp "Compare"
text tbch1 "<h2>Commits on <code>"
text tbch2 "</code>"
text tbch3 " for <code>"
text tbul1 "<ul class=\"commits\">\n"
text tbul2 "</ul>\n"
text tbli1 "<li><a href=\""
text tbli2 "</a><p class=\"meta\"><a class=\"mono\" href=\""
text tbli3 "</a> &#183; "
text tbli4 " &#183; "
text tbli5 " &#183; <a href=\""
text tbli6 "\">Browse</a></p></li>\n"
text tbnone "<p class=\"muted\">No commits.</p>\n"
text tbpg1 "<p class=\"pager\">"
text tbpg2 "?page="
text tbpgn "\">Newer</a> "
text tbpgo "\">Older</a>"
text tbcm1 "<div class=\"box commit\"><h2>"
text tbcm2 "<pre class=\"msg\">"
text tbcm3 "</pre>\n"
text tbcm4 "<p class=\"meta\">"
text tbcm5 " authored "
text tbcm6 " &#183; "
text tbcm7 " committed "
text tbcm8 "<p class=\"meta\">commit <span class=\"mono\">"
text tbcm9 "</span> &#183; parent "
text tbcm10 " &#183; <a href=\""
text tbcm11 "\">Browse files</a> &#183; <a href=\""
text tbcm12 ".patch\">Patch</a> &#183; <a href=\""
text tbcm13 ".diff\">Diff</a></p></div>\n"
text tbcmnp "none"
text tbst1 "<p class=\"stat\">"
text tbst2 " files changed, <span class=\"ok\">+"
text tbst3 "</span> <span class=\"bad\">-"
text tbst4 "</span></p>\n<table class=\"stat\"><tbody>\n"
text tbst5 "<tr><td><a href=\"#d"
text tbst6 "</a></td><td class=\"ok\">+"
text tbst7 "</td><td class=\"bad\">-"
text tbst8 "</td></tr>\n"
text tbst9 "</td><td class=\"muted\">binary</td><td></td></tr>\n"
text tbdf1 "<div class=\"df\" id=\"d"
text tbdf2 "\"><p class=\"dfh mono\">"
text tbdf3 "</p>\n<table class=\"diff\"><tbody>\n"
text tbdf4 "</tbody></table></div>\n"
text tbdr1 "<tr class=\""
text tbdr2 "\"><td class=\"ln\">"
text tbdr3 "</td><td class=\"ln\">"
text tbdr4 "</td><td class=\"dc\">"
text tbdr5 "</td></tr>\n"
text tbcda "da"
text tbcdd "dd"
text tbcdx "dx"
text tbcdh "dh"
text tbcdm "dm"
text tbdcut "<p class=\"muted\">The diff is too large to show in full here; it was cut.</p>\n"
text tbbr1 "<h2>Branches</h2>\n<table class=\"refs\"><tbody>\n"
text tbtg1 "<h2>Tags</h2>\n<table class=\"refs\"><tbody>\n"
text tbrr1 "<tr><td><a href=\""
text tbrr2 "</a>"
text tbrdef " <span class=\"badge\">default</span>"
text tbrr3 "</td><td class=\"meta\">"
text tbrr4 "</td><td><a class=\"mono\" href=\""
text tbrr5 "</a> "
text tbrr6 "</td><td><a href=\""
text tbrr7 ".zip\">zip</a> <a href=\""
text tbrr8 ".tar.gz\">tar.gz</a>"
text tbrr9 "</td></tr>\n"
text tbrrel " <a href=\""
text tbrrel2 "\">release</a>"
text tbarch "/archive/refs/heads/"
text tbarcht "/archive/refs/tags/"
text tbreltg "/releases/tag/"
text tbnobr "<p class=\"muted\">No branches.</p>\n"
text tbnotg "<p class=\"muted\">No tags.</p>\n"
text tbcf1 "<h2>Compare</h2>\n<form class=\"inline\" method=\"get\" action=\""
text tbcf2 "/compare\"><label>base <input name=\"a\" maxlength=\"200\" required></label> <label>head <input name=\"b\" maxlength=\"200\" required></label> <button type=\"submit\">Compare</button></form>\n<p class=\"muted\">Branch or tag names, or commit ids. The page shows what head has that base does not.</p>\n"
text tbcp1 "<h2>Comparing <code>"
text tbcp2 "</code> ... <code>"
text tbcp3 "</code></h2>\n"
text tbcpno "<p class=\"muted\">Head has no commits that base does not have.</p>\n"
text tbcpcut "<p class=\"muted\">Showing the newest 250 commits.</p>\n"
text tbdots "..."
text tbdots2 ".."
text tbqa "a"
text tbqb "b"
text tbcmpw "compare"
note ---- argv helpers
fn brkdiff to void
fka tbmm
fka tbnocol
fka tbnoext
end
note brkcs: argument "<gbsa><sep><gbsha>" (sep ".." or "...")
fn brkcs t view uchar * to void
fkopen
for i ulong 40
fkc get gbsa i
end
fkt t
brksha
end
note ---- commit list rows (log --format=%H%x1f%an%x1f%at%x1f%s, one per line)
fn brcrow a ulong e ulong to void
k = brsplit a e 31
if lt k 4
ret
end
fput tbli1
brucmt brfa 0 brfl 0
fput tbaq
brfesc 3
if eq brfl 3 0
fxput brfa 0 7
end
fput tbli2
brucmt brfa 0 brfl 0
fput tbaq
fxput brfa 0 7
fput tbli3
brfesc 1
fput tbli4
t = brxdec brfa 2 add brfa 2 brfl 2
brdate t
fputc 32
brtime t
fput tbli5
brurepo
fputc 47
fput tbtree
fputc 47
brfurl 0
fput tbli6
end
note brcrows: up to m rows from fxo; returns the number of lines seen
fn brcrows m ulong to ulong
n = get fxol 0
s = ulong 0
c = ulong 0
fput tbul1
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
if lt c m
brcrow s e
end
c = add c 1
end
s = add e 1
end
fput tbul2
ret c
end
note ---- /commits[/<ref>[/<path>]]
fn brpgnum to ulong
r = fqget tbpage
if lt r 1
ret 1
end
v = ulong 0
for i ulong ulong r bound 4096
c = get fval i
if not brdig c
ret 1
end
if lt v 100000
v = add mul v 10 ulong sub c 48
end
end
if or eq v 0 gt v 100000
ret 1
end
ret v
end
fn brcmtspg to long
if eq get gbrl 0 0
brdefref
end
if not brres
ret brerr 404
end
p = brpgnum
put gbpg 0 p
fkgit
fka tblog
fka tbfmtc
fka tbn1
fka tbn31
fkopen
fkt tbskip
brknum mul sub p 1 30
fkopen
brksha
if gt get gbpl 0 0
fka tbdd
fkopen
brkp
end
st = fexec BRTMO
if ne st 0
ret brerr 404
end
brti tbtcmts
frepohd 1
fput tbch1
brrefesc
fput tbch2
if gt get gbpl 0 0
fput tbch3
brgesc 0 get gbpl 0
fput tbch2
end
fput tbh2e
c = brcrows 30
if eq c 0
fput tbnone
end
brpager c
ret 200
end
fn brpager c ulong to void
p = get gbpg 0
if and le p 1 lt c 31
ret
end
fput tbpg1
if gt p 1
fput tbah
bruactp tbcmts get gbpl 0
fput tbpg2
fnum sub p 1
fput tbpgn
end
if ge c 31
fput tbah
bruactp tbcmts get gbpl 0
fput tbpg2
fnum add p 1
fput tbpgo
end
fput tbpe
end
note ---- /commit/<sha>[.patch|.diff]
note brsuffix: gbr ends with t; drop it and return true
fn brsuffix t view uchar * to bool
n = get gbrl 0
k = len t
if le n k
ret false
end
a = sub n k
for i ulong k
if ne get gbr add a i get t i
ret false
end
end
put gbrl 0 a
ret true
end
fn brcmtpg to long
mode = ulong 0
if brsuffix tbxpatch
mode = 1
end
if eq mode 0
if brsuffix tbxdiff
mode = 2
end
end
if not brres
ret brerr 404
end
if gt get gbpl 0 0
ret brerr 404
end
if gt mode 0
ret brcmtraw mode
end
if not brcmthd
ret brerr 404
end
brcmtstat
brcmtdiff
ret 200
end
note brcmtraw: the commit as an mbox patch (1) or a plain diff (2), text/plain
fn brcmtraw mode ulong to long
brcmtargs mode
st = fexec BRTMO
n = get fxol 0
if ne st 0
ret brerr 404
end
put fobl 0 0
fsetct tbctxt
if or gt n len fob ne get fxotr 0 0
brcmtargs mode
put fkind 0 4
ret 200
end
put fkind 0 1
fxput 0 n
ret 200
end
note brcmtargs: argv in fpk of git format-patch (mode 1) or git show -p (mode 2) of commit gbsha.
note brcmtraw runs it; output larger than the capture runs again, streamed by the server (kind 4)
fn brcmtargs mode ulong to void
fkgit
if eq mode 1
fka tbfmtp
fka tbstdo
fka tbx1
fka tbnocol
else
fka tbshow
fka tbfmt0
fka tbpp
fka tbdmfp
brkdiff
end
fkopen
brksha
end
note brcmthd: the commit header box; false when git show fails
fn brcmthd to bool
fkgit
fka tbshow
fka tbsfmt
fka tbfmtk
fkopen
brksha
st = fexec BRTMO
n = get fxol 0
if or ne st 0 eq n 0
ret false
end
k = brsplit 0 n 31
if lt k 7
ret false
end
fsetti tbtcmt
ftic 32
for i ulong 7
ftic get gbsha i
end
ftic 32
ftic 45
ftic 32
ftirepo
frepohd 1
brcmtmsg
brcmtwho
brcmtids
ret true
end
note brcmtmsg: subject as h2, the rest of the message in pre
fn brcmtmsg to void
a = brfa 6
e = add a brfl 6
while gt e a bound BRBIG
c = get fxo sub e 1
if not brspc c
break
end
e = sub e 1
end
s = brxfind a e 10
fput tbcm1
fxesc a sub s a
fput tbh2e
if lt s e
b = add s 1
while lt b e bound BRBIG
if not brspc get fxo b
break
end
b = add b 1
end
if lt b e
fput tbcm2
fxesc b sub e b
fput tbcm3
end
end
end
fn brcmtwho to void
fput tbcm4
brfesc 2
fput tbcm5
t = brxdec brfa 3 add brfa 3 brfl 3
brdate t
fputc 32
brtime t
if brfne 2 4
fput tbcm6
brfesc 4
fput tbcm7
u = brxdec brfa 5 add brfa 5 brfl 5
brdate u
end
fput tbpe
end
note brcmtids: sha, parents, browse / patch / diff links
fn brcmtids to void
fput tbcm8
brfesc 0
fput tbcm9
a = brfa 1
e = add a brfl 1
if eq a e
fput tbcmnp
end
note one pass per parent: a merge can have more than 64 (bound 64 was trap 4, exit 104, on such a commit)
s = a
while lt s e bound BRBIG
x = brxfind s e 32
if gt x s
fput tbah
brucmt s sub x s
fput tbaq
fxput s 7
fput tbae
fputc 32
end
s = add x 1
end
fput tbcm10
brurepo
fputc 47
fput tbtree
fputc 47
brksh2
fput tbcm11
brucmt 0 0
brksh2
fput tbcm12
brucmt 0 0
brksh2
fput tbcm13
end
note brksh2: write gbsha into fob (40 hex, URL-safe)
fn brksh2 to void
for i ulong 40
fputc get gbsha i
end
end
fn brcmtstat to void
fkgit
fka tbshow
fka tbfmt0
fka tbnums
fka tbmm
fka tbdmfp
fkopen
brksha
st = fexec BRTMO
if eq st 0
brstat
end
end
fn brcmtdiff to void
fkgit
fka tbshow
fka tbfmt0
fka tbpp
fka tbdmfp
brkdiff
fkopen
brksha
st = fexec BRTMO
if eq st 0
brdiff
end
end
note ---- numstat table: "<add>\t<del>\t<path>" per line ("-\t-\t" for binaries)
fn brstat to void
n = get fxol 0
fls = ulong 0
ad = ulong 0
de = ulong 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
fls = add fls 1
ad = add ad brxdec s e
t = brxfind s e 9
de = add de brxdec add t 1 e
end
s = add e 1
end
fput tbst1
fnum fls
fput tbst2
fnum ad
fput tbst3
fnum de
fput tbst4
brstrows n
fput tbtab2
end
fn brstrows n ulong to void
s = ulong 0
i = ulong 1
while lt s n bound BRBIG
e = brxfind s n 10
if gt e s
brstrow s e i
i = add i 1
end
if gt i 3000
ret
end
s = add e 1
end
end
fn brstrow s ulong e ulong i ulong to void
k = brsplit s e 9
if lt k 3
ret
end
fput tbst5
fnum i
fput tbaq
fxesc brfa 2 sub e brfa 2
if eq get fxo s 45
fput tbst9
ret
end
fput tbst6
fxput brfa 0 brfl 0
fput tbst7
fxput brfa 1 brfl 1
fput tbst8
end
note ---- unified diff renderer over fxo
fn brdiff to void
n = get fxol 0
put gbdi 0 0
put gbdt 0 0
put gbdh 0 0
put gbdc 0 0
s = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
brdline s e
s = add e 1
if or gt s BRDMAX gt get gbdc 0 BRDLN
if lt s n
brdclose
fput tbdcut
ret
end
end
end
brdclose
if ne get fxotr 0 0
fput tbdcut
end
end
fn brdclose to void
if ne get gbdt 0 0
fput tbdf4
put gbdt 0 0
end
end
fn brdline s ulong e ulong to void
if brxat s e tbdgit
brdfile s e
ret
end
if brxat s e tbdat
brdhunk s e
ret
end
if eq get gbdt 0 0
ret
end
if eq s e
ret
end
c = get fxo s
if ne get gbdh 0 0
brdbody s e c
ret
end
brdmeta s e
end
fn brdbody s ulong e ulong c uchar to void
o = get gbdo 0
m = get gbdn 0
if eq c 43
brdrow tbcda 0 m s e
put gbdn 0 add m 1
ret
end
if eq c 45
brdrow tbcdd o 0 s e
put gbdo 0 add o 1
ret
end
if eq c 32
brdrow tbcdx o m s e
put gbdo 0 add o 1
put gbdn 0 add m 1
ret
end
brdrow tbcdm 0 0 s e
end
fn brdmeta s ulong e ulong to void
ok = or brxat s e tbdnew brxat s e tbddel
if or brxat s e tbdrf brxat s e tbdrt
ok = true
end
if or brxat s e tbdbin or brxat s e tbdmd brxat s e tbdmn
ok = true
end
if ok
brdrow tbcdm 0 0 s e
end
end
note brdrow: one diff row; 0 line numbers print empty
fn brdrow cl view uchar * o ulong m ulong s ulong e ulong to void
put gbdc 0 add get gbdc 0 1
fput tbdr1
fput cl
fput tbdr2
if gt o 0
fnum o
end
fput tbdr3
if gt m 0
fnum m
end
fput tbdr4
fxesc s sub e s
fput tbdr5
end
note brdfile: "diff --git a/<p> b/<p>" opens a file table titled by the text after the last " b/"
fn brdfile s ulong e ulong to void
brdclose
i = add get gbdi 0 1
put gbdi 0 i
put gbdt 0 1
put gbdh 0 0
a = add s len tbdgit
k = e
while gt k a bound BRBIG
if brxat sub k 1 e tbdb
break
end
k = sub k 1
end
p = a
if gt k a
p = add k 2
end
fput tbdf1
fnum i
fput tbdf2
fxesc p sub e p
fput tbdf3
end
note brdhunk: "@@ -o[,n] +m[,k] @@ ..."
fn brdhunk s ulong e ulong to void
if eq get gbdt 0 0
ret
end
put gbdh 0 1
a = brxfind s e 45
put gbdo 0 brxdec add a 1 e
b = brxfind a e 43
put gbdn 0 brxdec add b 1 e
brdrow tbcdh 0 0 s e
end
note ---- /branches and /tags
fn brdefsave to void
brdefref
n = get gbrl 0
if gt n 256
n = 256
end
for i ulong n
put gbdef i get gbr i
end
put gbdefl 0 n
end
note brrefs: for-each-ref over refs/heads (tg false) or refs/tags (tg true) at the root, else
note the delegate namespace's
fn brrefs tg bool to bool
brkref tg
if tg
fka tbrt
else
fka tbrh
end
st = fexec BRTMO
if ne st 0
ret false
end
if ne get fxotr 0 0
fincut
ret false
end
if gt get fxol 0 0
ret true
end
brkref tg
if tg
brkns tbnsrt
else
brkns tbnsrh
end
st = fexec BRTMO
if ne get fxotr 0 0
fincut
ret false
end
ret eq st 0
end
fn brkref tg bool to void
fkgit
fka tbfer
if tg
fka tbsortt
fka tbfmtt
else
fka tbsort
fka tbfmtb
end
end
fn brbrpg to long
if gt get gbrl 0 0
ret brerr 404
end
brdefsave
if not brrefs false
ret brerr 404
end
brti tbtbr
frepohd 2
n = get fxol 0
if eq n 0
fput tbnobr
ret 200
end
fput tbbr1
s = ulong 0
c = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
if and gt e s lt c 2000
brbrrow s e
c = add c 1
end
s = add e 1
end
fput tbtab2
ret 200
end
note brrsn: start of the short name in field 0 (after the refs prefix)
fn brrsn to ulong
a = brfa 0
ret add a brpfx a add a brfl 0
end
fn brbrrow s ulong e ulong to void
k = brsplit s e 31
if lt k 4
ret
end
a = brrsn
l = sub add brfa 0 brfl 0 a
fput tbrr1
brurepo
fputc 47
fput tbtree
fputc 47
bruxo a l
fput tbaq
fxesc a l
fput tbrr2
if brisdef a l
fput tbrdef
end
fput tbrr3
brdate brxdec brfa 2 add brfa 2 brfl 2
fput tbrr4
brucmt brfa 1 brfl 1
fput tbaq
fxput brfa 1 7
fput tbrr5
brfesc 3
fput tbrr6
brarch tbarch a l
fput tbrr9
end
fn brisdef a ulong l ulong to bool
if ne l get gbdefl 0
ret false
end
for i ulong l
if ne get fxo add a i get gbdef i
ret false
end
end
ret true
end
note brarch: zip and tar.gz links <repo><p><name>.zip|.tar.gz (the downloads slice serves them)
fn brarch p view uchar * a ulong l ulong to void
brurepo
fput p
bruxo a l
fput tbrr7
brurepo
fput p
bruxo a l
fput tbrr8
end
fn brtagpg to long
if gt get gbrl 0 0
ret brerr 404
end
if not brrefs true
ret brerr 404
end
brti tbttag
frepohd 3
n = get fxol 0
if eq n 0
fput tbnotg
ret 200
end
fput tbtg1
s = ulong 0
c = ulong 0
while lt s n bound BRBIG
e = brxfind s n 10
if and gt e s lt c 2000
brtgrow s e
c = add c 1
end
s = add e 1
end
fput tbtab2
ret 200
end
note brtgrow: refname, object, *object (peeled commit of an annotated tag), date, subject
fn brtgrow s ulong e ulong to void
k = brsplit s e 31
if lt k 5
ret
end
a = brrsn
l = sub add brfa 0 brfl 0 a
fput tbrr1
brurepo
fputc 47
fput tbtree
fputc 47
bruxo a l
fput tbaq
fxesc a l
fput tbrr2
fput tbrr3
brdate brxdec brfa 3 add brfa 3 brfl 3
fput tbrr4
c = ulong 2
if eq brfl 2 0
c = 1
end
brucmt brfa c brfl c
fput tbaq
fxput brfa c 7
fput tbrr5
brfesc 4
fput tbrr6
brarch tbarcht a l
fput tbrrel
brurepo
fput tbreltg
bruxo a l
fput tbrrel2
fput tbrr9
end
note ---- /compare and /compare/<a>...<b>
fn brcmppg to long
if eq get gbrl 0 0
ret brcmpform
end
if not brcmpsplit
ret brerr 404
end
if not brcmpres
ret brerr 404
end
brti tbtcmp
frepohd 1
fput tbcp1
for i ulong get gbcal 0
fescc get gbca i
end
fput tbcp2
for i ulong get gbcbl 0
fescc get gbcb i
end
fput tbcp3
brcmplog
brcmpdiff
ret 200
end
note brcmpform: a GET form; ?a=&b= redirects to /compare/<a>...<b>
fn brcmpform to long
la = fqget tbqa
if and gt la 0 le la 200
if brcmpq 0 la
lb = fqget tbqb
if and gt lb 0 le lb 200
if brcmpq 1 lb
brcmploc
ret 302
end
end
end
end
brti tbtcmp
frepohd 1
fput tbcf1
brurepo
fput tbcf2
ret 200
end
note brcmpq: copy fval[0, n) into gbca (w 0) or gbcb (w 1); refuse control bytes
fn brcmpq w ulong n long to bool
for i ulong ulong n bound 256
c = get fval i
if or lt c 33 eq c 127
ret false
end
if eq w 0
put gbca i c
else
put gbcb i c
end
end
if eq w 0
put gbcal 0 ulong n
else
put gbcbl 0 ulong n
end
ret true
end
fn brcmploc to void
put fkind 0 2
put fobl 0 0
flocb
for i ulong get fownl 0 bound 64
brlc get fown i
end
flocc 47
for i ulong get frepol 0 bound 128
brlc get frepo i
end
flocc 47
floct tbcmpw
flocc 47
for i ulong get gbcal 0
brlc get gbca i
end
floct tbdots
for i ulong get gbcbl 0
brlc get gbcb i
end
end
note brcmpsplit: gbr = "<a>...<b>" into gbca / gbcb
fn brdot3 k ulong to bool
if ne get gbr k 46
ret false
end
j = add k 1
if ne get gbr j 46
ret false
end
j = add k 2
ret eq get gbr j 46
end
fn brcmpsplit to bool
n = get gbrl 0
k = ulong 0
while lt add k 2 n bound BRBIG
if brdot3 k
break
end
k = add k 1
end
if or eq k 0 ge add k 3 n
ret false
end
m = sub n add k 3
if or gt k 200 gt m 200
ret false
end
for i ulong k
put gbca i get gbr i
end
put gbcal 0 k
for i ulong m
put gbcb i get gbr add add k 3 i
end
put gbcbl 0 m
ret true
end
note brcmpres: resolve a into gbsa, then b into gbsha / gbref; both must be bare refs
fn brcmpres to bool
n = get gbcal 0
for i ulong n
put gbr i get gbca i
end
put gbrl 0 n
if not brres
ret false
end
if gt get gbpl 0 0
ret false
end
for i ulong 40
put gbsa i get gbsha i
end
m = get gbcbl 0
for i ulong m
put gbr i get gbcb i
end
put gbrl 0 m
if not brres
ret false
end
ret eq get gbpl 0 0
end
fn brcmplog to void
fkgit
fka tblog
fka tbfmtc
fka tbn1
fka tbn251
brkcs tbdots2
st = fexec BRTMO
if ne st 0
ret
end
c = brcrows 250
if eq c 0
fput tbcpno
end
if gt c 250
fput tbcpcut
end
end
fn brcmpdiff to void
fkgit
fka tbdiff
fka tbnums
fka tbmm
brkcs tbdots
st = fexec BRTMO
if ne st 0
ret
end
if eq get fxol 0 0
ret
end
brstat
fkgit
fka tbdiff
brkdiff
brkcs tbdots
st = fexec BRTMO
if eq st 0
brdiff
end
end

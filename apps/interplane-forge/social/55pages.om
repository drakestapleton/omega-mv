note social/55pages.om: soroute, the social pages, POST actions, and the contract fragments.
note ---- router
fn soroute to long
if sopis tsplogin
ret sologin
end
if sopis tsplogo
ret sologout
end
if sopis tspset
ret sosettings
end
if sopis tspsetn
ret sosetname
end
if sopis tspstars
ret sostarsp
end
if sopis tspfol
ret sofollow true
end
if sopis tspunf
ret sofollow false
end
if ne get fridx 0 9999
ret sorepor
end
ret souserp
end
note ---- form and link pieces
fn socsrfout to void
for i ulong get fcsrfl 0 bound 64
fescc get fcsrf i
end
end
fn sopathout to void
for i ulong get fpathl 0 bound 4096
fescc get fpath i
end
end
note softail: close the action attribute, add csrf + back, the button, close the form
fn softail lbl view uchar * to void
fput tshf2
socsrfout
fput tshf3
sopathout
fput tshf4
fput lbl
fput tshf5
end
fn sorform act view uchar * lbl view uchar * to void
fput tshf1
fputb
fputrepo
fput act
softail lbl
end
fn sorcnt sp view uchar * n ulong w view uchar * to void
fput tsha1
fputb
fputrepo
fput sp
fput tsha2
fnum n
fput w
fput tsha3
end
note sorepoid: string id of "rad:<RID>" for allow-list index i (0 when nobody touched it)
fn sorepoid i ulong to ulong
sokclr
sokt tsradp
n = fridlen i
for k ulong n bound 128
sokc fridbyte i k
end
ret sofind
end
note soownid: account DID id for the user name in fown (0 when none)
fn soownid to ulong
n = get fownl 0
if or eq n 0 gt n 39
ret 0
end
sokclr
for i ulong n bound 64
sokc get fown i
end
ret get gsnmo sofind
end
note sonmout: the account's URL segment: its display name, else the z... key of its DID
fn sonmout d ulong to void
n = get gsnm d
if ne n 0
sooutid n 0
ret
end
sooutid d len tsdidp
end
note sorsvk: gskb holds a display name or the z... key of a DID; the account id or 0
fn sorsvk to ulong
if sonameok
ret get gsnmo sofind
end
n = get gskbl 0
if or lt n 40 gt n 60
ret 0
end
z = new uchar 64 0
for i ulong n bound 64
put z i get gskb i
end
sokclr
sokt tsdidp
sokt part z 0 n
s = sofind
if eq get gsacc s 0
ret 0
end
ret s
end
note ---- contract fragments and counts
fn sostarn i ulong to ulong
ret get gscst sorepoid i
end
fn sofavn i ulong to ulong
ret get gscfv sorepoid i
end
fn sofolln to ulong
ret get gscfl soownid
end
fn sofollg to ulong
ret get gscfg soownid
end
note sobar: star / watch / favorite forms and counts for repo fridx
fn sobar to void
i = get fridx 0
if or eq i 9999 eq get gsok 0 0
ret
end
t = sorepoid i
u = get gscur 0
fput tshbar1
if eq u 0
sosignin tssinst
end
if ne u 0
if soron 1 u t
sorform tsrunst tsbunst
else
sorform tsrstar tsbstar
end
end
sorcnt tsrsg get gscst t tswstar
if ne u 0
if soron 3 u t
sorform tsrunwt tsbunwt
else
sorform tsrwat tsbwat
end
end
sorcnt tsrwr get gscwt t tswwat
if ne u 0
if soron 2 u t
sorform tsrunfv tsbunfv
else
sorform tsrfav tsbfav
end
end
fput tshbar2
end
fn sosignin lbl view uchar * to void
fput tsha1
flink tsplog2
fput tsha2
fput lbl
fput tsha3
end
fn sofolbar to void
soflbar soownid
end
note soflbar: follower/following counts and the follow form for account d
fn soflbar d ulong to void
if or eq d 0 eq get gsok 0 0
ret
end
fput tshbar1
souln d tsqfls get gscfl d tswfls
souln d tsqflg get gscfg d tswflg
u = get gscur 0
if eq u 0
sosignin tssinfl
end
if and ne u 0 ne u d
fput tshf1
fputb
if soron 4 u d
fput tspunf2
sofolf d tsbunfl
else
fput tspfol2
sofolf d tsbfol
end
end
fput tshbar2
end
fn sofolf d ulong lbl view uchar * to void
fput tshfu
sonmout d
softail lbl
end
fn souln d ulong q view uchar * n ulong w view uchar * to void
fput tsha1
fputb
sonmout d
fput tsqtabe
fput q
fput tsha2
fnum n
fput w
fput tsha3
end
fn sostarsof to void
d = soownid
if eq d 0
fput tsnone
ret
end
sorepol 1 d
end
note sorepol: allow-listed repos with relation kind by actor a (private repos never appear)
fn sorepol kind ulong a ulong to void
c = ulong 0
n = get fan 0
fput tsul1
for i ulong n bound 4096
t = sorepoid i
if and ne t 0 soron kind a t
c = add c 1
sorepoli i t
end
end
fput tsul2
if eq c 0
fput tsnone
end
end
fn sorepoli i ulong t ulong to void
fput tsli1
fput tsrepo1
fputb
fput tfowner
fput tsslash
fputrn i
fput tsha2
fput tfowner
fput tsslash
fputrn i
fput tsha3
fput tsmut1
fnum get gscst t
fput tswstar
fput tsmut2
fput tsli2
end
note sousers: side 1 lists actors a of (kind, a, x); side 0 lists targets b of (kind, x, b)
fn sousers kind ulong x ulong side ulong to void
fput tsul1
c = ulong 0
for s ulong 262144
k = get gsrk s
if and ne k 0 ne get gsrv s 0
if eq shr k 48 kind
a = and shr k 24 16777215
b = and k 16777215
if and eq side 1 eq b x
c = add c 1
soli a
end
if and eq side 0 eq a x
c = add c 1
soli b
end
end
end
end
fput tsul2
if eq c 0
fput tsnone
end
end
fn soli d ulong to void
fput tsli1
souser d
fput tsli2
end
note ---- query tabs
fn sotab to ulong
n = fqget tsqtab
if lt n 1
ret 0
end
m = ulong n
if sofvis tsqfav m
ret 1
end
if sofvis tsqwat m
ret 3
end
if sofvis tsqfls m
ret 4
end
if sofvis tsqflg m
ret 5
end
if sofvis tsqstar m
ret 6
end
ret 9
end
fn sofvis t view uchar * n ulong to bool
if ne n len t
ret false
end
for i ulong n bound 64
if ne get fval i get t i
ret false
end
end
ret true
end
note ---- repo actions and lists
fn sorepor to long
a = soracode
if eq a 0
ret 0
end
if ge a 20
if gt get fmeth 0 2
ret 405
end
ret sorlist a
end
if ne get fmeth 0 3
ret 405
end
r = sowpre
if ne r 0
ret r
end
ret soract2 a
end
fn soracode to ulong
if sorestis tsrstar
ret 1
end
if sorestis tsrunst
ret 2
end
if sorestis tsrfav
ret 3
end
if sorestis tsrunfv
ret 4
end
if sorestis tsrwat
ret 5
end
if sorestis tsrunwt
ret 6
end
if sorestis tsrsg
ret 20
end
if sorestis tsrwr
ret 21
end
ret 0
end
note soract2: idempotent; an event is logged only when the state changes
fn soract2 a ulong to long
u = get gscur 0
sokclr
sokt tsradp
for i ulong get fridl 0 bound 128
sokc get frid i
end
t = sofind
on = eq rem a 2 1
kind = add div sub a 1 2 1
cur = false
if ne t 0
cur = soron kind u t
end
if ne cur on
if not soemit a u
ret soerr 500 tsmwrite
end
end
d = new uchar 256 0
k = ulong 0
for i ulong get fownl 0 bound 64
put d k get fown i
k = add k 1
end
put d k 47
k = add k 1
for i ulong get frepol 0 bound 128
put d k get frepo i
k = add k 1
end
ret sobackto part d 0 k
end
fn sorlist a ulong to long
t = sorepoid get fridx 0
if fjwant
if eq a 20
ret sojlist 1 t
end
ret sojlist 3 t
end
fyalt
kind = ulong 1
if eq a 20
fsetti tstsg
else
fsetti tstwr
kind = ulong 3
end
frepohd 99
fput tsh2a
if eq kind 1
fput tstsg
else
fput tstwr
end
fput tsh2b
if eq t 0
fput tsnone
ret 200
end
sousers kind t 1
ret 200
end
note sobackto: 303 to base + back (validated body field) or else base + def
fn sobackto def view uchar * to long
put fkind 0 2
flocb
b = new uchar 512 0
n = sobval tsbk b
if gt n 0
if sobackok part b 0 ulong n
for i ulong sub ulong n 1 bound 512
flocc get b add i 1
end
ret 303
end
end
floct def
ret 303
end
note sobackok: "/" then [A-Za-z0-9._~/-] with no "//" and no "/." (no traversal, no other host)
fn sobackok s view uchar * to bool
if ne get s 0 47
ret false
end
for i ulong len s bound 512
c = get s i
if not sourlc c
ret false
end
if gt i 0
p = get s sub i 1
if and eq p 47 or eq c 47 eq c 46
ret false
end
end
end
ret true
end
fn sourlc c uchar to bool
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
ret or or eq c 45 eq c 46 or or eq c 95 eq c 126 eq c 47
end
note ---- follow
fn sofollow on bool to long
if ne get fmeth 0 3
ret 405
end
r = sowpre
if ne r 0
ret r
end
raw = new uchar 64 0
n = sobval tsfuser raw
if lt n 1
ret soerr 400 tsmnous
end
sokclr
for i ulong ulong n
sokc get raw i
end
d = sorsvk
if eq d 0
ret soerr 404 tsmnous
end
u = get gscur 0
if eq d u
ret soerr 400 tsmself
end
if ne soron 4 u d on
sokclr
sokid d
a = ulong 8
if on
a = ulong 7
end
if not soemit a u
ret soerr 500 tsmwrite
end
end
ret sobackto part raw 0 ulong n
end
note ---- pages
fn sopgin to long
fput tsin1
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tsin2
fput tsrepo1
flink tspset2
fput tsha2
fput tsin3
fput tsha3
sologf
ret 200
end
fn sologf to void
fput tshf1
flink tsplo2
softail tsbout
end
fn sopglog nh view uchar * ts ulong mac view uchar * to long
fput tslg1
c = new uchar 96 0
l = sochal nh ts c
fesc part c 0 l
fput tslg2
flink tsplog2
fput tslg3
fput mac
fput tslg4
fput nh
fput tslg5
d = new uchar 20 0
k = sodec ts d
fput part d 0 k
fput tslg6
ret 200
end
fn sosettings to long
if gt get fmeth 0 2
ret 405
end
u = get gscur 0
if eq u 0
ret soback tsplog2
end
fsetti tstset
fput tsst1
sooutid u 0
n = get gsnm u
if eq n 0
fput tsst2n
else
fput tsst2
sooutid n 0
fput tsst3
end
fput tsst4
if ne u get gsown 0
fput tsst5
flink tspsn2
fput tsst6
socsrfout
fput tsst7
end
fput tsst8
sologf
ret 200
end
fn sostarsp to long
if gt get fmeth 0 2
ret 405
end
u = get gscur 0
if eq u 0
ret soback tsplog2
end
fsetti tststar
tab = sotab
kind = ulong 1
if eq tab 1
kind = ulong 2
end
if eq tab 3
kind = ulong 3
end
if fjwant
ret sojstarp u kind
end
fyalt
fput tsh1a
fput tststar
fput tsh1b
fput tstab1
sostabl 1 kind tslstar tsqstar
sostabl 2 kind tslfav tsqfav
sostabl 3 kind tslwat tsqwat
fput tstab2
if eq kind 2
fput tsfavp
end
sorepol kind u
ret 200
end
fn sostabl code ulong cur ulong lbl view uchar * q view uchar * to void
if eq code cur
fput tstabon
else
fput tsrepo1
end
fputb
fput tspstr2
if ne code 1
fput tsqtabe
fput q
end
fput tsha2
fput lbl
fput tsha3
end
note souserp: /<user>, /<user>/followers, /<user>/following for accounts; <user> is the display
note name or the z... key. The owner's plain profile stays the server's.
fn souserp to long
n = get fpathl 0
if or lt n 2 gt n 80
ret 0
end
j = ulong 1
for it ulong 80
if or ge j n eq get fpath j 47
break
end
j = add j 1
end
tab = sotab
if lt j n
tab = sosegtab j
if eq tab 0
ret 0
end
end
sokclr
for i ulong sub j 1 bound 80
sokc get fpath add i 1
end
d = sorsvk
if eq d 0
ret 0
end
if and eq d get gsown 0 and ne tab 4 ne tab 5
ret 0
end
if gt get fmeth 0 2
ret 405
end
tn = new uchar 80 0
l = sub j 1
for i ulong l bound 80
put tn i get fpath add i 1
end
fsetti part tn 0 l
if fjwant
ret sojprof d tab
end
fyalt
ret soprof d tab
end
note sosegtab: the rest of fpath from j is "/followers" (4) or "/following" (5); else 0
fn sosegtab j ulong to ulong
if sopsub j tspfls
ret 4
end
if sopsub j tspflg
ret 5
end
ret 0
end
fn sopsub j ulong t view uchar * to bool
if ne sub get fpathl 0 j len t
ret false
end
for i ulong len t bound 64
if ne get fpath add j i get t i
ret false
end
end
ret true
end
fn soprof d ulong tab ulong to long
fput tsh1a
sonmout d
fput tsh1b
fput tsdid1
sooutid d 0
fput tsdid2
soflbar d
fput tstab1
k = tab
if or eq tab 0 eq tab 9
k = ulong 6
end
sotabl d 6 k
sotabl d 4 k
sotabl d 5 k
fput tstab2
if eq k 4
sousers 4 d 1
ret 200
end
if eq k 5
sousers 4 d 0
ret 200
end
sorepol 1 d
ret 200
end
note sotabl: profile tab code (6 stars, 4 followers, 5 following) for account d; cur is marked
fn sotabl d ulong code ulong cur ulong to void
if eq code cur
fput tstabon
else
fput tsrepo1
end
fputb
sonmout d
fput tsqtabe
if eq code 6
fput tsqstar
fput tsha2
fput tslstar
end
if eq code 4
fput tsqfls
fput tsha2
fput tslfls
end
if eq code 5
fput tsqflg
fput tsha2
fput tslflg
end
fput tsha3
end

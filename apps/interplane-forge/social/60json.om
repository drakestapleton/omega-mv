note social/60json.om: the machine form (JSON, docs/API.md) of the public social pages:
note forge/stargazers/1, forge/watchers/1, forge/user/1 (account profiles, every tab) and forge/stars/1
note (the signed-in user's own lists). Same facts as the HTML handler in 55pages.om, same order, same
note validation before; never a session, key, IP or CSRF token. Strings go through fjtb/fjtc/fjstr.
note sojid: string id s from offset a as a JSON string
fn sojid s ulong a ulong to void
fjtb
o = get gsso s
l = get gssl s
if lt a l
for i ulong sub l a bound 4096
fjtc get gsstr add add o a i
end
end
fjstr
end
note sojsegb d: append the account's URL segment (display name, else z... key) to fjt (as sonmout)
fn sojsegb d ulong to void
s = get gsnm d
a = ulong 0
if eq s 0
s = d
a = len tsdidp
end
o = get gsso s
l = get gssl s
if ge a l
ret
end
for i ulong sub l a bound 4096
fjtc get gsstr add add o a i
end
end
fn sojseg d ulong to void
fjtb
sojsegb d
fjstr
end
note sojpath d: "<base><segment>", the href of the account's profile (souser, sonmout)
fn sojpath d ulong to void
fjtb
for i ulong get fbasel 0 bound 64
fjtc get fbase i
end
sojsegb d
fjstr
end
fn sojq t view uchar * to void
fputc 34
fput t
fputc 34
end
note sojuhd t d: {"schema":"<t>","base":"<base>","user":"<segment of d>"
fn sojuhd t view uchar * d ulong to void
fjstart
fput tsjh1
fput t
fput tsjh2
fputb
fput tsjh3
sojseg d
end
note sojuser d: {"name":"<segment>","path":"<base><segment>"}
fn sojuser d ulong to void
fputc 123
fyk0 tsjname
sojseg d
fyk tsjpath
sojpath d
fputc 125
end
note sojusers: the JSON array of sousers (same table walk, same order)
fn sojusers kind ulong x ulong side ulong to void
fputc 91
c = ulong 0
for s ulong 262144
k = get gsrk s
if and ne k 0 ne get gsrv s 0
if eq shr k 48 kind
a = and shr k 24 16777215
b = and k 16777215
d = b
y = a
if eq side 1
d = a
y = b
end
if eq y x
if gt c 0
fputc 44
end
c = add c 1
sojuser d
end
end
end
end
fputc 93
end
note sojrepo i t: {"name":..,"rid":"rad:..","path":"<base><owner>/<name>","stars":n} (sorepoli)
fn sojrepo i ulong t ulong to void
fput tsjr1
fjtname i
fjstr
fput tsjr2
fputid i
fput tsjr3
fjpath i
fput tsjr4
fnum get gscst t
fputc 125
end
note sojrepos: the JSON array of sorepol (same walk of the allow-list, same order)
fn sojrepos kind ulong a ulong to void
fputc 91
c = ulong 0
for i ulong get fan 0 bound 4096
t = sorepoid i
if and ne t 0 soron kind a t
if gt c 0
fputc 44
end
c = add c 1
sojrepo i t
end
end
fputc 93
end
note sojstars: the repos the user in fown starred, as a JSON array (sostarsof; the server's owner profile)
fn sojstars to void
d = soownid
if eq d 0
fputc 91
fputc 93
ret
end
sojrepos 1 d
end
note sojlist: /<o>/<r>/stargazers (kind 1) and /watchers (kind 3) of repo id t (sorlist)
fn sojlist kind ulong t ulong to long
if eq kind 1
fyrhead tsjsg
else
fyrhead tsjwr
end
fyk tsjcnt
if eq kind 1
fnum get gscst t
else
fnum get gscwt t
end
fyk tsjusrs
if eq t 0
fputc 91
fputc 93
else
sojusers kind t 1
end
fyend
ret 200
end
note sojprof: forge/user/1 of account d (soprof); tab as soprof: 4 followers, 5 following, else stars
fn sojprof d ulong tab ulong to long
sojuhd tsjuser d
fyk tsjdid
sojid d 0
fyk tsqfls
fnum get gscfl d
fyk tsqflg
fnum get gscfg d
fyk tsqtab
if eq tab 4
sojq tsqfls
end
if eq tab 5
sojq tsqflg
end
if and ne tab 4 ne tab 5
sojq tsqstar
end
fyk tsjrepos
fynull
fyk tsjsrcv
fynull
fyk tsjfrcv
fynull
fyk tsjstrd
if and ne tab 4 ne tab 5
sojrepos 1 d
else
fynull
end
fyk tsjusrs
if eq tab 4
sojusers 4 d 1
end
if eq tab 5
sojusers 4 d 0
end
if and ne tab 4 ne tab 5
fynull
end
fyend
ret 200
end
note sojstarp: forge/stars/1 of the signed-in account u, list kind 1 stars, 2 favorites, 3 watching
fn sojstarp u ulong kind ulong to long
sojuhd tsjstar u
fyk tsqtab
if eq kind 1
sojq tsqstar
end
if eq kind 2
sojq tsqfav
end
if eq kind 3
sojq tsqwat
end
fyk tsjrepos
sojrepos kind u
fyend
ret 200
end

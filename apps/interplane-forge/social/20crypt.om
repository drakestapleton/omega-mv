note social/20crypt.om: HMAC-SHA256 (om/tls/sha2.om), /dev/urandom, did:key base58 decode,
note base64, and the argv-only exec of /usr/bin/ssh-keygen -Y verify (no shell, empty env).
note sohmac: o[0,32) = HMAC-SHA256(gskey, m)
fn sohmac m view uchar * o edit uchar * to void
c = new ulong 40 0
k = new uchar 64 0
ih = new uchar 32 0
for i ulong 64
v = uchar 54
if lt i 32
v = xor get gskey i 54
end
put k i v
end
sha256_init c
sha256_update c k
sha256_update c m
sha256_final c ih
for i ulong 64
v = uchar 92
if lt i 32
v = xor get gskey i 92
end
put k i v
end
sha256_init c
sha256_update c k
sha256_update c ih
sha256_final c o
end
note sorand: fill o from /dev/urandom; false when short
fn sorand o edit uchar * to bool
fd = fopen tsurand 0 len tsurand 524288 0
if lt fd 0
ret false
end
n = ulong 0
for it ulong 64
if ge n len o
break
end
r = read int fd o n sub len o n
if le r 0
break
end
n = add n ulong r
end
x = fclose int fd
ret eq n len o
end
fn sob58v c uchar to long
for i ulong 58
if eq get tsb58 i c
ret long i
end
end
ret -1
end
note sob58: base58btc s (no leading '1', so the encoding is canonical) into exactly 34 bytes o
fn sob58 s view uchar * o edit uchar 34 to bool
if or eq len s 0 gt len s 60
ret false
end
if eq get s 0 49
ret false
end
for j ulong 34
put o j 0
end
for i ulong len s bound 64
v = sob58v get s i
if lt v 0
ret false
end
if not sob58m o ulong v
ret false
end
end
ret true
end
fn sob58m o edit uchar 34 v ulong to bool
cy = v
for t ulong 34
j = sub 33 t
cy = add cy mul ulong get o j 58
put o j uchar and cy 255
cy = shr cy 8
end
ret eq cy 0
end
note sodidpk: "z" + base58btc(0xed 0x01 + 32-byte ed25519 key) -> pk
fn sodidpk s view uchar * pk edit uchar * to bool
if lt len s 2
ret false
end
if ne get s 0 122
ret false
end
o = new uchar 34 0
if not sob58 part s 1 sub len s 1 o
ret false
end
if or ne get o 0 237 ne get o 1 1
ret false
end
for i ulong 32
put pk i get o add i 2
end
ret true
end
note sob64: standard base64 with padding of s into o; returns the length
fn sob64 s view uchar * o edit uchar * to ulong
n = ulong 0
i = ulong 0
while lt i len s bound 4096
b0 = ulong get s i
b1 = ulong 0
b2 = ulong 0
if lt add i 1 len s
b1 = ulong get s add i 1
end
if lt add i 2 len s
b2 = ulong get s add i 2
end
w = or or shl b0 16 shl b1 8 b2
sob64q w o n sub len s i
n = add n 4
i = add i 3
end
ret n
end
note sob64q: four output chars of the 24-bit group w at o[n]; k input bytes remain (pad when < 3)
fn sob64q w ulong o edit uchar * n ulong k ulong to void
put o n get tsb64 and shr w 18 63
c = get tsb64 and shr w 12 63
put o add n 1 c
put o add n 2 61
put o add n 3 61
if gt k 1
c = get tsb64 and shr w 6 63
put o add n 2 c
end
if gt k 2
c = get tsb64 and w 63
put o add n 3 c
end
end
note sopkline: "forge-user ssh-ed25519 <base64 wire blob>\n" for pk into o; returns length
fn sopkline pk view uchar * o edit uchar * to ulong
blob = new uchar 51 0
put blob 3 11
for i ulong 11
put blob add i 4 get tsedname i
end
put blob 18 32
for i ulong 32
put blob add i 19 get pk i
end
n = ulong 0
for i ulong len tsprinc
put o n get tsprinc i
n = add n 1
end
put o n 32
n = add n 1
for i ulong 11
put o n get tsedname i
n = add n 1
end
put o n 32
n = add n 1
b = new uchar 80 0
m = sob64 blob b
for i ulong m bound 80
put o n get b i
n = add n 1
end
put o n 10
ret add n 1
end
note ---- packed argv in gspk (u16 count, then u16-length records)
fn soavb to void
put gspk 0 0
put gspk 1 0
put gspkl 0 2
put gspkn 0 0
end
fn soavopen to void
n = get gspkl 0
put gspko 0 n
put gspk n 0
put gspk add n 1 0
put gspkl 0 add n 2
k = add get gspkn 0 1
put gspkn 0 k
put gspk 0 uchar and k 255
put gspk 1 uchar shr k 8
end
fn soavc c uchar to void
n = get gspkl 0
if ge n len gspk
ret
end
put gspk n c
put gspkl 0 add n 1
o = get gspko 0
r = add add ulong get gspk o shl ulong get gspk add o 1 8 1
put gspk o uchar and r 255
put gspk add o 1 uchar shr r 8
end
fn soava t view uchar * to void
soavopen
for i ulong len t bound 1024
soavc get t i
end
end
note soavpth: one argv record holding gspth
fn soavpth to void
soavopen
for i ulong get gspthl 0 bound 1024
soavc get gspth i
end
end
note sowfile: create gspth (O_EXCL, 0600, no symlink follow) holding d
fn sowfile d view uchar * to bool
fd = fopen gspth 0 get gspthl 0 557249 384
if lt fd 0
ret false
end
n = ulong 0
for it ulong 64
if ge n len d
break
end
r = write int fd d n sub len d n
if le r 0
break
end
n = add n ulong r
end
x = fclose int fd
ret eq n len d
end
note sorunv: run the argv in gspk with stdin = descriptor mfd, stdout/stderr /dev/null;
note returns the exit status, -1 on timeout (killed), -2 when it cannot start
fn sorunv mfd long tmo ulong to long
pid = fork
if lt pid 0
ret -2
end
if eq pid 0
sochild mfd
end
t0 = monons
for it ulong 100000
w = waitpid int pid gswst 0 4 1
if eq w pid
ret sowexit
end
if lt w 0
ret -2
end
if gt sub monons t0 mul long tmo 1000000
x = killpid int pid 9
w = waitpid int pid gswst 0 4 0
ret -1
end
x = sleepns 2000000
end
ret -1
end
fn sochild mfd long to void
nul = fopen tsnull 0 len tsnull 2 0
if lt nul 0
exit 126
end
x = dupfd int mfd 0 0
x = dupfd int nul 1 0
x = dupfd int nul 2 0
x = execprog gspk 0 get gspkl 0
exit 127
end
fn sowexit to long
st = or ulong get gswst 0 shl ulong get gswst 1 8
if ne and st 127 0
ret -2
end
ret long and shr st 8 255
end

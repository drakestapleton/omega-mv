note social/10base.om: ForgeSocial (INTERPLANE Forge web) shared state, path builder, hex, time.
note Prefixes (docs/CONTRACT.md): functions so*, globals gs*, texts ts*. Composed after server/util.om.
note gsdd: data dir (ends in /). soload sets it from env FORGE_SOCIAL_DIR when present, else tfdata.
note ---- path builder: gspth = data dir + parts (host words take the global directly)
fn sopclr to void
put gspthl 0 0
end
fn sopc c uchar to void
n = get gspthl 0
if lt n sub len gspth 1
put gspth n c
put gspthl 0 add n 1
end
end
fn sopt t view uchar * to void
for i ulong len t bound 1024
sopc get t i
end
end
fn sopdd to void
sopclr
for i ulong get gsddl 0 bound 512
sopc get gsdd i
end
end
note sodirset: gsdd from FORGE_SOCIAL_DIR (absolute, ends in /, no "..") else tfdata
fn sodirset to void
put gsddl 0 0
for i ulong len tfdata
put gsdd i get tfdata i
end
put gsddl 0 len tfdata
nenv = envcnt
if lt nenv 1
ret
end
for e ulong ulong nenv bound 4096
r = envread e gsenv 0 len gsenv
if gt r long len tsenvdd
if sodirenv ulong r
ret
end
end
end
end
fn sodirenv n ulong to bool
for i ulong len tsenvdd
if ne get gsenv i get tsenvdd i
ret false
end
end
k = sub n len tsenvdd
if or lt k 2 gt k 500
ret false
end
if ne get gsenv len tsenvdd 47
ret false
end
if ne get gsenv sub n 1 47
ret false
end
for i ulong k
c = get gsenv add len tsenvdd i
if or eq c 0 eq c 46
ret false
end
put gsdd i c
end
put gsddl 0 k
ret true
end
note ---- hex and decimal
fn sohexc v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
fn sohexv c uchar to long
if and ge c 48 le c 57
ret long sub c 48
end
if and ge c 97 le c 102
ret long sub c 87
end
ret -1
end
note sohex: 2*len s lowercase hex chars of s into o (o at least that long)
fn sohex s view uchar * o edit uchar * to void
for i ulong len s bound 4096
b = ulong get s i
put o mul i 2 sohexc shr b 4
put o add mul i 2 1 sohexc and b 15
end
end
fn sonowset to void
t = realns
put gsnow 0 div ulong t 1000000000
end
note soeqct: constant-time equality of two equal-length views
fn soeqct a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
d = uchar 0
for i ulong len a bound 4096
d = or d xor get a i get b i
end
ret eq d 0
end

note social/40auth.om: sessions, CSRF, and sign-in with a Radicle key (challenge + ssh-keygen -Y verify).
note Cookies: forge_session=<64 hex token> (the log stores only sha256(token)); forge_pre=<32 hex>
note binds the sign-in form to this browser. Both HttpOnly, Secure, SameSite=Lax, Path=<base>.
note ---- Set-Cookie builder (fsck)
fn soscct t view uchar * to void
for i ulong len t bound 512
fscc get t i
end
end
fn soscbase to void
for i ulong get fbasel 0 bound 64
fscc get fbase i
end
end
note sosckset: "<name>=<value>; Max-Age=<age>; HttpOnly; Secure; SameSite=Lax; Path=<base>"
fn sosckset nm view uchar * v view uchar * age ulong to void
put fsckl 0 0
soscct nm
soscct v
soscct tsckage
d = new uchar 20 0
k = sodec age d
soscct part d 0 k
soscct tsckatt
soscbase
end
note ---- cookies
note sockget: value of cookie nm (prefix "name=") in fck into o; returns its length, 0 when absent or too long
fn sockget nm view uchar * o edit uchar * to ulong
n = get fckl 0
for i ulong n bound 4096
st = eq i 0
if gt i 0
c = get fck sub i 1
st = or eq c 32 eq c 59
end
if and st sockat i nm
ret sockcp add i len nm o
end
end
ret 0
end
fn sockat i ulong nm view uchar * to bool
if gt add i len nm get fckl 0
ret false
end
for k ulong len nm bound 64
if ne get fck add i k get nm k
ret false
end
end
ret true
end
fn sockcp p ulong o edit uchar * to ulong
k = ulong 0
for it ulong 4096
if ge add p k get fckl 0
break
end
c = get fck add p k
if or eq c 59 eq c 32
break
end
if ge k len o
ret 0
end
put o k c
k = add k 1
end
ret k
end
note sohexok: s is lowercase hex
fn sohexok s view uchar * to bool
for i ulong len s bound 4096
if lt sohexv get s i 0
ret false
end
end
ret true
end
note ---- sessions
note sosess: parse the session cookie; sets gscur/gssid, fuser, fcsrf. 1 signed in, 0 not
fn sosess to long
put fuserl 0 0
put fcsrfl 0 0
put gscur 0 0
put gssid 0 0
sonowset
if eq get gsok 0 0
ret 0
end
t = new uchar 64 0
if ne sockget tsckses t 64
ret 0
end
if not sohexok t
ret 0
end
hh = new uchar 64 0
sotokh t hh
sokclr
sokt hh
s = sofind
if eq s 0
ret 0
end
d = get gssd s
if or eq d 0 le get gsse s get gsnow 0
ret 0
end
put gscur 0 d
put gssid 0 s
souserset d
socsrfset hh
ret 1
end
note sotokh: hh = hex sha256(token hex)
fn sotokh t view uchar * hh edit uchar * to void
h = new uchar 32 0
x = sha2_digest 256 t h
sohex h hh
end
fn socsrfset hh view uchar * to void
m = new uchar 69 0
for i ulong 5
put m i get tscsrfp i
end
for i ulong 64
put m add i 5 get hh i
end
h = new uchar 32 0
sohmac m h
x = new uchar 32 0
sohex part h 0 16 x
for i ulong 32
put fcsrf i get x i
end
put fcsrfl 0 32
end
note souserset: fuser = display name, else the DID's key part (z6Mk...)
fn souserset d ulong to void
n = get gsnm d
k = ulong 0
if ne n 0
o = get gsso n
for i ulong get gssl n bound 64
put fuser i get gsstr add o i
end
put fuserl 0 get gssl n
ret
end
o = get gsso d
l = sub get gssl d len tsdidp
if gt l len fuser
l = len fuser
end
for i ulong l
put fuser i get gsstr add add o len tsdidp i
end
put fuserl 0 l
end
note socsrfok: signed in and the body field csrf equals the session's CSRF token fcsrf (constant time)
fn socsrfok to bool
if eq get gscur 0 0
ret false
end
n = fbget tsfcsrf
if ne n 32
ret false
end
a = new uchar 32 0
b = new uchar 32 0
for i ulong 32
put a i get fval i
put b i get fcsrf i
end
ret soeqct a b
end
note ---- per-IP limiter for sign-in attempts (in memory; the server is sequential)
fn soiphash salt ulong to ulong
h = xor ulong 14695981039346656037 salt
for i ulong get fipl 0 bound 64
h = xor h ulong get fip i
h = mul h 1099511628211
end
ret h
end
note soiplim: count one attempt for (salt, IP) in this minute; false when over lim
fn soiplim salt ulong lim ulong to bool
h = soiphash salt
s = and h 4095
m = div get gsnow 0 60
if or ne get gsipk s h ne get gsipm s m
put gsipk s h
put gsipm s m
put gsipc s 0
end
c = add get gsipc s 1
put gsipc s c
ret le c lim
end
note sovlim: at most 60 signature checks per minute in total (bounds ssh-keygen spawns)
fn sovlim to bool
m = div get gsnow 0 60
if ne get gsvm 0 m
put gsvm 0 m
put gsvc 0 0
end
c = add get gsvc 0 1
put gsvc 0 c
ret le c 60
end
note ---- body fields
note sobval: body field nm into o (at most len o); returns the length or -1 when absent or too long
fn sobval nm view uchar * o edit uchar * to long
n = fbget nm
if or lt n 0 gt n long len o
ret -1
end
for i ulong ulong n
put o i get fval i
end
ret n
end
note sotrim: bounds [a, b) of s without leading/trailing spaces, tabs, CR, LF; returns a and sets gspc = b
fn sotrim s view uchar * n ulong to ulong
a = ulong 0
b = n
for it ulong n bound 8192
if ge a b
break
end
if not sows get s a
break
end
a = add a 1
end
for it ulong n bound 8192
if le b a
break
end
if not sows get s sub b 1
break
end
b = sub b 1
end
put gspc 0 b
ret a
end
fn sows c uchar to bool
ret or or eq c 32 eq c 9 or eq c 13 eq c 10
end
note ---- sign-in
note sologin: GET shows the challenge (or the signed-in state); POST verifies
fn sologin to long
if eq get fmeth 0 3
ret sologinp
end
if gt get fmeth 0 2
ret 405
end
fsetti tsttl
if ne get gscur 0 0
ret sopgin
end
if eq get gsok 0 0
ret soerr 503 tsmoff
end
pre = new uchar 16 0
non = new uchar 16 0
if or not sorand pre not sorand non
ret soerr 500 tsmrand
end
ph = new uchar 32 0
nh = new uchar 32 0
sohex pre ph
sohex non nh
ts = get gsnow 0
mac = new uchar 64 0
somacl nh ts ph mac
sosckset tsckpre ph 900
ret sopglog nh ts mac
end
note somacl: mac = hex HMAC(key, "login:" nonce ":" ts ":" pre)
fn somacl nh view uchar 32 ts ulong ph view uchar 32 mac edit uchar 64 to void
m = new uchar 128 0
n = ulong 0
for i ulong len tslogp
put m n get tslogp i
n = add n 1
end
for i ulong 32
put m n get nh i
n = add n 1
end
put m n 58
n = add n 1
d = new uchar 20 0
k = sodec ts d
for i ulong k
put m n get d i
n = add n 1
end
put m n 58
n = add n 1
for i ulong 32
put m n get ph i
n = add n 1
end
h = new uchar 32 0
sohmac part m 0 n h
sohex h mac
end
note sochal: the challenge text "interplane-forge-login:<nonce>:<ts>" into o; returns its length
fn sochal nh view uchar * ts ulong o edit uchar * to ulong
n = ulong 0
for i ulong len tschal
put o n get tschal i
n = add n 1
end
for i ulong 32
put o n get nh i
n = add n 1
end
put o n 58
n = add n 1
d = new uchar 20 0
k = sodec ts d
for i ulong k
put o n get d i
n = add n 1
end
ret n
end
note sologinp: POST /login
fn sologinp to long
if eq get gsok 0 0
ret soerr 503 tsmoff
end
if not soiplim 1 10
ret soerr 429 tsmrate
end
ph = new uchar 32 0
nh = new uchar 32 0
mac = new uchar 64 0
if ne sockget tsckpre ph 32
ret soerr 403 tsmform
end
if or ne sobval tsfnon nh 32 ne sobval tsfcsrf mac 64
ret soerr 403 tsmform
end
ts = soformts
if or not sohexok ph not sohexok nh
ret soerr 403 tsmform
end
want = new uchar 64 0
somacl nh ts ph want
if not soeqct mac want
ret soerr 403 tsmform
end
if or lt add ts 900 get gsnow 0 gt ts add get gsnow 0 60
ret soerr 403 tsmexp
end
if sononused nh
ret soerr 403 tsmused
end
ret sologin2 nh ts
end
note soformts: the ts body field (decimal), 0 when invalid
fn soformts to ulong
d = new uchar 16 0
n = sobval tsfts d
if or lt n 1 gt n 12
ret 0
end
put gspc 0 0
put gsbad 0 0
v = sonum part d 0 ulong n
if or ne get gsbad 0 0 ne get gspc 0 ulong n
ret 0
end
ret v
end
fn sononused nh view uchar * to bool
sokclr
sokt tsnonp
sokt nh
s = sofind
if eq s 0
ret false
end
ret ne get gsnu s 0
end
note sologin2: DID + signature checks, then the session
fn sologin2 nh view uchar 32 ts ulong to long
raw = new uchar 128 0
n = sobval tsfdid raw
if lt n 0
ret soerr 400 tsmdid
end
a = sotrim raw ulong n
b = get gspc 0
z = new uchar 64 0
zl = sodidz part raw a sub b a z
pk = new uchar 32 0
if eq zl 0
ret soerr 400 tsmdid
end
if not sodidpk part z 0 zl pk
ret soerr 400 tsmdid
end
if not sovlim
ret soerr 429 tsmrate
end
v = soverify nh ts pk
if lt v 0
ret soerr ulong neg v tsmsig
end
if ne v 0
ret soerr 403 tsmsig
end
ret sologin3 nh part z 0 zl
end
note sodidz: accept "did:key:z..." or "z..." and copy the z... part into z; returns its length or 0
fn sodidz s view uchar * z edit uchar * to ulong
p = ulong 0
if ge len s len tsdidp
p = len tsdidp
for i ulong len tsdidp
if ne get s i get tsdidp i
p = ulong 0
end
end
end
l = sub len s p
if or lt l 40 gt l len z
ret 0
end
for i ulong l
put z i get s add p i
end
ret l
end
note soverify: 0 = signature valid; >0 = ssh-keygen refused; <0 = -HTTP status (400 bad input, 500 internal)
fn soverify nh view uchar 32 ts ulong pk view uchar 32 to long
sig = new uchar 4096 0
sl = sosigin sig
if eq sl 0
ret -400
end
st = new uchar 8 0
if not sorand st
ret -500
end
for i ulong 8
put gsstem i get st i
end
okw = sovwr nh ts pk part sig 0 sl
r = long -500
if okw
r = sorunk
end
sotmprm 97
sotmprm 115
sotmprm 109
ret r
end
note sovwr: write the three temp files (a = allowed signers, s = signature, m = challenge)
fn sovwr nh view uchar 32 ts ulong pk view uchar 32 sg view uchar * to bool
msg = new uchar 96 0
ml = sochal nh ts msg
al = new uchar 128 0
k = sopkline pk al
if not sotmpw 97 part al 0 k
ret false
end
if not sotmpw 115 sg
ret false
end
ret sotmpw 109 part msg 0 ml
end
note sosigin: the sig field, CR removed, trimmed, armored, at most 4000 bytes, newline-terminated
fn sosigin o edit uchar 4096 to ulong
n = fbget tsfsig
if or lt n 1 gt n 4000
ret 0
end
k = ulong 0
for i ulong ulong n
c = get fval i
if ne c 13
if not sosigc c
ret 0
end
put o k c
k = add k 1
end
end
a = sotrim part o 0 k k
b = get gspc 0
if lt sub b a add len tssigb len tssige
ret 0
end
for i ulong sub b a
put o i get o add a i
end
k = sub b a
put o k 10
if not soarmok part o 0 k
ret 0
end
ret add k 1
end
fn sosigc c uchar to bool
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 48 le c 57
ret true
end
ret or or or eq c 43 eq c 47 or eq c 61 eq c 45 or eq c 32 eq c 10
end
fn soarmok s view uchar * to bool
for i ulong len tssigb
if ne get s i get tssigb i
ret false
end
end
p = sub len s len tssige
for i ulong len tssige
if ne get s add p i get tssige i
ret false
end
end
ret true
end
note sotmpp: gspth = <data>/tmp/<stem hex>.<c>
fn sotmpp c uchar to void
sopdd
sopt tstmpd
x = new uchar 16 0
st = new uchar 8 0
for i ulong 8
put st i get gsstem i
end
sohex st x
sopt x
sopc 46
sopc c
end
fn sotmpw c uchar d view uchar * to bool
sotmpp c
ret sowfile d
end
fn sotmprm c uchar to void
sotmpp c
r = unlink gspth 0 get gspthl 0
end
note sorunk: ssh-keygen -Y verify -f <a> -I forge-user -n interplane-forge -s <s>  < <m>
fn sorunk to long
sotmpp 109
mfd = fopen gspth 0 get gspthl 0 524288 0
if lt mfd 0
ret -500
end
soavb
soava tssshkg
soava tsY
soava tsverify
soava tsdf
sotmpp 97
soavpth
soava tsdI
soava tsprinc
soava tsdn
soava tsns
soava tsds
sotmpp 115
soavpth
r = sorunv mfd 5000
x = fclose int mfd
if eq r -2
ret -500
end
if eq r -1
ret 1
end
ret r
end
note sologin3: verified; record account (first time) and the session, set the cookie, 303
fn sologin3 nh view uchar * z view uchar * to long
sokclr
sokt tsdidp
sokt z
did = sointern
if eq did 0
ret soerr 500 tsmfull
end
if eq get gsacc did 0
sokclr
if not soemit 9 did
ret soerr 500 tsmwrite
end
end
tk = new uchar 32 0
if not sorand tk
ret soerr 500 tsmrand
end
th = new uchar 64 0
sohex tk th
hh = new uchar 64 0
sotokh th hh
sokclr
sokt hh
sokc 46
sokt nh
if not soemit 11 did
ret soerr 500 tsmwrite
end
sosckset tsckses th 2592000
put fkind 0 2
flocb
if eq get gsnm did 0
floct tspset2
end
ret 303
end
note POST /logout
fn sologout to long
if ne get fmeth 0 3
ret 405
end
r = sowpre
if ne r 0
ret r
end
sokclr
sokid get gssid 0
if not soemit 12 get gscur 0
ret soerr 500 tsmwrite
end
sosckset tsckses part tsnull 0 0 0
put fkind 0 2
flocb
ret 303
end
note sowpre: common write gate: signed in (else 303 to login), CSRF (403), limits (429), store (503)
fn sowpre to long
if eq get gscur 0 0
put fkind 0 2
flocb
floct tsplog2
ret 303
end
if not socsrfok
ret soerr 403 tsmcsrf
end
if eq get gsok 0 0
ret soerr 503 tsmoff
end
if not fratelim
ret soerr 429 tsmrate
end
if not sordok get gscur 0
ret soerr 429 tsmrate
end
ret 0
end
note ---- display name
fn sosetname to long
if ne get fmeth 0 3
ret 405
end
r = sowpre
if ne r 0
ret r
end
d = get gscur 0
if eq d get gsown 0
ret soerr 403 tsmownn
end
raw = new uchar 64 0
n = sobval tsfname raw
if lt n 0
ret soerr 400 tsmname
end
a = sotrim raw ulong n
b = get gspc 0
sokclr
for i ulong sub b a
sokc get raw add a i
end
if not sonameok
ret soerr 400 tsmname
end
if sorsvd
ret soerr 400 tsmrsv
end
k = sofind
if ne k 0
o = get gsnmo k
if and ne o 0 ne o d
ret soerr 409 tstaken
end
if eq o d
ret soback tspset2
end
end
if not soemit 10 d
ret soerr 500 tsmwrite
end
ret soback tspset2
end
note sorsvd: gskb is a reserved route word ("|name|" occurs in tsrsv)
fn sorsvd to bool
n = get gskbl 0
for p ulong len tsrsv bound 1024
if sorsvat p n
ret true
end
end
ret false
end
fn sorsvat p ulong n ulong to bool
if gt add add p n 2 len tsrsv
ret false
end
if or ne get tsrsv p 124 ne get tsrsv add add p n 1 124
ret false
end
for i ulong n bound 64
if ne get tsrsv add add p 1 i get gskb i
ret false
end
end
ret true
end
fn soback t view uchar * to long
put fkind 0 2
flocb
floct t
ret 303
end

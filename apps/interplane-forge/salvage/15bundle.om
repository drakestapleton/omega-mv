note Portable POSIX tar: fixed safe member names, no paths, links, ownership metadata or executable flags.
text tltarct "application/x-tar"
text tltarcd "attachment; filename=interplane-part.tar"
text tltarurl "/bundle.tar"
text tlbundle "Download reproduction bundle"
text tlrecnm "record.ip"
text tlrcpnm "receipt.ip"
text tlsrcnm "source.om"
text tlinnm "stdin"
text tlexnm "expected"
text tlreadnm "README.txt"
text tlustar "ustar"
text tlreadme "INTERPLANE declared-example bundle v1\n\nrecord.ip is the canonical exact revision. Its filename-independent SHA-256 is the revision ID shown by the hub. Fields and replay instructions: docs/SALVAGE.md in the Interplane Forge source. No public Git URL yet: Interplane does not serve Git clones yet.\n\nUse salvage/replay.om with 00core.om, 10verify.om and the pinned Omega sha2.om. The compiler pin is 3ad9f10f64309e7acf8a725082b28e23a2a4aeb07e98322fb4dc0fcd8fc93194. Verify the compiler's seed chain before replay. Set OMEGA_COMPILER privately to the absolute path of that verified compiler. Run the native replay tool with RECORD_PATH EXPECTED_RECORD_SHA256 FRESH_PRIVATE_DIRECTORY_WITH_TRAILING_SLASH RECEIPT_PATH. The fresh directory must be empty. Linux AArch64 with bwrap, prlimit, Landlock ABI 3 and seccomp is required. Missing isolation fails closed.\n\nThe input and output are UTF-8 LF-normalized bytes, not approximate text matches. The tool recompiles and executes the exact source under the sandbox, checks exit zero and exact output, rejects an altered expected output, and compares rebuilt binary/output hashes to the receipt.\n\nThe receipt's HMAC authenticates the collector only to the hub; it is not a publicly verifiable digital signature. Independent replay is the public verification. A passing example is not a proof of general correctness, safety, authorship or license validity. Source and attribution claims are supplied by the submitting builder. No speed or mathematical claims are made.\n"
fn sloct hdr edit uchar * pos ulong width ulong value ulong to void
v = value
for i ulong width bound 16
j = sub sub add pos width 1 i
put hdr j uchar add and v 7 48
v = shr v 3
end
end
fn slmember name view uchar * size ulong kind ulong off ulong to void
h = new uchar 512 0
for i ulong len name bound 100
put h i get name i
end
sloct h 100 7 420
sloct h 108 7 0
sloct h 116 7 0
sloct h 124 11 size
sloct h 136 11 0
for i ulong 8
put h add i 148 32
end
put h 156 48
for i ulong len tlustar
put h add i 257 get tlustar i
end
put h 263 48
put h 264 48
sum = ulong 0
for i ulong 512
sum = add sum ulong get h i
end
sloct h 148 6 sum
put h 154 0
put h 155 32
for i ulong 512
fputc get h i
end
for i ulong size bound 32768
c = uchar 0
if eq kind 0
c = get glrec add off i
end
if eq kind 1
c = get glrcpt i
end
if eq kind 2
c = get tlreadme i
end
fputc c
end
pad = rem sub ulong 512 rem size 512 512
for i ulong pad bound 512
fputc 0
end
end
fn slbundle id view uchar * to long
if ne get glrec 8 2
ret 404
end
if ne slreceiptget id 1
ret 409
end
put fkind 0 1
fsetct tltarct
fsetcd tltarcd
slmember tlrecnm get glrl 0 0 0
slmember tlrcpnm 353 1 0
slmember tlsrcnm get gllen 5 0 get gloff 5
slmember tlinnm get gllen 7 0 get gloff 7
slmember tlexnm get gllen 8 0 get gloff 8
slmember tlreadnm len tlreadme 2 0
for i ulong 1024
fputc 0
end
ret 200
end

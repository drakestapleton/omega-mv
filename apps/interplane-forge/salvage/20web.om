text tlcss ".sl{max-width:950px;margin:auto}.sl h1{font-size:clamp(34px,5vw,60px);font-weight:450;letter-spacing:-.04em;line-height:1.1}.sl h2{font-weight:500;margin-top:36px}.sl .eyebrow{font:11px ui-monospace,monospace;letter-spacing:.15em;color:var(--mut)}.sl p{line-height:1.7;max-width:760px}.sl .sl-card{padding:24px;border:1px solid var(--line);border-radius:12px;margin:18px 0;background:var(--box)}.sl label{display:block;margin:20px 0;font-size:14px}.sl input:not([type=checkbox]),.sl select,.sl textarea{display:block;width:100%;max-width:100%;margin-top:8px;padding:12px;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;font:inherit}.sl textarea{font:13px/1.65 ui-monospace,monospace}.sl small{display:block;color:var(--mut);font-weight:400}.sl button{padding:12px 18px;margin:10px 10px 10px 0}.sl button[value=source],.sl button[value=derive],.sl button[value=publish]{background:var(--acc);color:var(--bg)}.sl .sl-check{line-height:1.7}.sl .sl-check input{margin-right:10px}.sl dl{font-size:13px;overflow-wrap:anywhere}.sl dt{margin-top:12px;color:var(--mut)}.sl dd{margin:4px 0}.sl pre{max-width:100%;white-space:pre-wrap;overflow-wrap:anywhere}.sl a{display:inline-block;margin:6px 16px 6px 0}.sl :focus-visible{outline:3px solid var(--acc);outline-offset:4px}\n"

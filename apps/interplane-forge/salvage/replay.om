note Compose om2 + pinned om/tls/sha2.om + salvage/00core.om + salvage/10verify.om + this unit.
note argv: record path, independently obtained record SHA256, fresh private directory ending /, receipt path.
text trpass "INTERPLANE REPLAY PASS: revision, pinned compiler, sandbox, exact output, negative control, rebuilt binary and output hashes\n"
text trbad "INTERPLANE REPLAY REFUSED\n"
fn replay to bool
p = new uchar 1024 0
id = new uchar 64 0
b = new uchar 32768 0
rcpt = new uchar 354 0
h = new uchar 64 0
if ne argcnt 5
ret false
end
n = argread 1 p 0 1024
if le n 0
ret false
end
r = slread view part p 0 ulong n b
if lt r 0
ret false
end
for i ulong ulong r bound 32768
put glrec i get b i
end
if not slparse ulong r
ret false
end
if ne get glrec 8 2
ret false
end
n = argread 2 id 0 64
if ne n 64
ret false
end
if not slhex id
ret false
end
slhash view part b 0 ulong r h
if not sleq id h
ret false
end
n = argread 3 p 0 1024
if le n 0
ret false
end
if not slroot view part p 0 ulong n
ret false
end
if not slinit
ret false
end
if ne get glidxn 0 0
ret false
end
n = argread 4 p 0 1024
if le n 0
ret false
end
r = slread view part p 0 ulong n rcpt
if ne r 353
ret false
end
if ne get rcpt 64 1
ret false
end
if not sleq view part rcpt 0 64 id
ret false
end
if not sleq view part rcpt 193 64 tlpin
ret false
end
slhash tlpol h
if not sleq view part rcpt 257 64 h
ret false
end
if not slverify
ret false
end
if not slrh 65 tlbin
ret false
end
if not slrh 129 tlout
ret false
end
for i ulong 128
if ne get glrcpt add i 65 get rcpt add i 65
ret false
end
end
ret true
end
fn main to int
if not replay
r = write 2 trbad 0 len trbad
ret 1
end
r = write 1 trpass 0 len trpass
ret 0
end

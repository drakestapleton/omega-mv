note Collector: pinned compiler in an empty bwrap namespace, then execpure for the declared example.
note No uploaded file is ever executed outside execpure. All command arguments are length-prefixed.
text tlwork "work/"
text tljlock "collector.lock"
text tlccenv "OMEGA_COMPILER="
global glccpath uchar 1024
global glccn ulong 1
text tlcc "omc"
text tlcode "source.om"
text tlbin "part.elf"
text tlbuilt "compiler.out"
text tlin "stdin"
text tlout "stdout"
text tlerr "stderr"
text tlprlim "/usr/bin/prlimit"
text tlbw "/usr/bin/bwrap"
text tlaas "--as=268435456"
text tlacpu "--cpu=2"
text tlafsz "--fsize=8388608"
text tladash "--"
text tlunsh "--unshare-all"
text tldie "--die-with-parent"
text tlnew "--new-session"
text tlcaps "--cap-drop"
text tlall "ALL"
text tlbind "--ro-bind"
text tlinside "/omc"
text tlpol "salvage-example-v1:bwrap-compile:execpure-run:3s-wall:4096-byte-output"
global glpk uchar 8192
global glpkn ulong 1
global glpkc ulong 1
global glphase ulong 1
global glstatus uchar 4
note The scratch root. Inside the server's own process (tests, replay) it is <store>work/. The
note collector program sets one outside the store: the sandboxed server can write everything in
note the store, and scratch files are compiled and executed, so they must be out of its reach.
global glwroot uchar 512
global glwrootn ulong 1
note slwroot: an absolute path ending in /, no control bytes, no segment starting with a dot
fn slwroot d view uchar * to bool
if or lt len d 2 gt len d 500
ret false
end
if or ne get d 0 47 ne get d sub len d 1 47
ret false
end
for i ulong len d bound 512
c = get d i
if or lt c 32 eq c 127
ret false
end
if gt i 0
if and eq c 46 eq get d sub i 1 47
ret false
end
end
put glwroot i c
end
put glwrootn 0 len d
ret true
end
fn slwpath name view uchar * to void
n = get glwrootn 0
if eq n 0
slpath tlwork name
ret
end
for i ulong n bound 512
put glpath i get glwroot i
end
for i ulong len name bound 128
put glpath add n i get name i
end
put glpathn 0 add n len name
end
note slwmk: the scratch folder exists and is a private 0700 directory
fn slwmk to bool
if eq get glwrootn 0 0
ret slmkdir tlwork
end
r = makedir glwroot 0 get glwrootn 0 448
if not or eq r 0 eq r -17
ret false
end
fd = fopen glwroot 0 get glwrootn 0 573440 0
if lt fd 0
ret false
end
ok = slprivate int fd
x = fclose int fd
ret ok
end
fn slpknew to void
put glpkn 0 2
put glpkc 0 0
end
fn slpkadd s view uchar * to void
n = get glpkn 0
put glpk n uchar and len s 255
put glpk add n 1 uchar shr len s 8
for i ulong len s bound 1024
put glpk add add n 2 i get s i
end
put glpkn 0 add add n 2 len s
put glpkc 0 add get glpkc 0 1
put glpk 0 uchar get glpkc 0
end
fn slpkpath name view uchar * to void
p = new uchar 1024 0
slwpath name
n = slpget p
slpkadd view part p 0 n
end
fn slunlink name view uchar * to void
slwpath name
r = unlink glpath 0 get glpathn 0
end
fn slwput name view uchar * data view uchar * to bool
p = new uchar 1024 0
slunlink name
slwpath name
n = slpget p
ret slwrite view part p 0 n data 557249
end
fn slwfield name view uchar * fld ulong to bool
b = new uchar 16384 0
n = slfield fld b
ret slwput name view part b 0 n
end
fn sltohex h view uchar * dst edit uchar * to void
for i ulong 32
put dst mul i 2 get tlhex ulong shr get h i 4
put dst add mul i 2 1 get tlhex ulong and get h i 15
end
end
fn slfilehash path view uchar * dst edit uchar * to bool
b = new uchar 65536 0
c = new ulong 40 0
h = new uchar 32 0
fd = fopen path 0 len path 557056 0
if lt fd 0
ret false
end
sha256_init c
ok = false
for i ulong 129
r = read int fd b 0 65536
if eq r 0
ok = true
break
end
if lt r 0
break
end
sha256_update c view part b 0 ulong r
end
x = fclose int fd
if not ok
ret false
end
sha256_final c h
sltohex h dst
ret true
end
fn slccconfig to bool
b = new uchar 2048 0
put glccn 0 0
for i ulong ulong envcnt bound 4096
n = envread i b 0 2048
if gt n long len tlccenv
same = true
for j ulong len tlccenv
if ne get b j get tlccenv j
same = false
end
end
if same
sz = sub ulong n len tlccenv
if gt sz 1024
ret false
end
if ne get b len tlccenv 47
ret false
end
for j ulong sz bound 1024
c = get b add len tlccenv j
if or lt c 32 eq c 127
ret false
end
put glccpath j c
end
put glccn 0 sz
ret true
end
end
end
ret false
end
fn slpincc to bool
b = new uchar 65536 0
p = new uchar 1024 0
h = new uchar 64 0
if not slccconfig
ret false
end
slunlink tlcc
slwpath tlcc
n = slpget p
src = fopen glccpath 0 get glccn 0 557056 0
if lt src 0
ret false
end
dst = fopen p 0 n 557249 384
if lt dst 0
x = fclose int src
ret false
end
ok = false
for i ulong 129
r = read int src b 0 65536
if eq r 0
ok = true
break
end
if lt r 0
break
end
w = ulong 0
for j ulong 65536
if ge w ulong r
break
end
v = write int dst b w sub ulong r w
if le v 0
break
end
w = add w ulong v
end
if ne w ulong r
break
end
end
x = fclose int src
r = fsync int dst
z = fchmod int dst 320
x = fclose int dst
if not and and ok eq r 0 eq z 0
ret false
end
if not slfilehash view part p 0 n h
ret false
end
ret sleq h tlpin
end
fn slcompilepk to void
slpknew
slpkadd tlprlim
slpkadd tlaas
slpkadd tlacpu
slpkadd tlafsz
slpkadd tladash
slpkadd tlbw
slpkadd tlunsh
slpkadd tldie
slpkadd tlnew
slpkadd tlcaps
slpkadd tlall
slpkadd tlbind
slpkpath tlcc
slpkadd tlinside
slpkadd tladash
slpkadd tlinside
end
fn slchild inf view uchar * outf view uchar * pure bool to void
pk = new uchar 8192 0
r = setpgid 0 0
slwpath inf
fd = fopen glpath 0 get glpathn 0 557056 0
if lt fd 0
exit 121
end
r = dupfd int fd 0 0
x = fclose int fd
if lt r 0
exit 122
end
slunlink outf
slwpath outf
fd = fopen glpath 0 get glpathn 0 557249 384
if lt fd 0
exit 123
end
r = dupfd int fd 1 0
x = fclose int fd
if lt r 0
exit 124
end
slunlink tlerr
slwpath tlerr
fd = fopen glpath 0 get glpathn 0 557249 384
if lt fd 0
exit 125
end
r = dupfd int fd 2 0
x = fclose int fd
if lt r 0
exit 126
end
n = get glpkn 0
for i ulong n bound 8192
put pk i get glpk i
end
if pure
r = execpure pk 0 n
else
r = execprog pk 0 n
end
if lt r 0
exit int neg r
end
exit 127
end
fn slrun inf view uchar * outf view uchar * pure bool to bool
st = new uchar 4 0
pid = fork
if lt pid 0
ret false
end
if eq pid 0
slchild inf outf pure
exit 127
end
r = setpgid int pid int pid
ok = false
for i ulong 300
r = waitpid int pid st 0 4 1
if eq r pid
ok = true
break
end
if lt r 0
break
end
r = sleepns 10000000
end
if not ok
r = killpid int neg pid 9
r = killpid int pid 9
for i ulong 100
r = waitpid int pid st 0 4 1
if ne r 0
break
end
r = sleepns 10000000
end
ret false
end
for i ulong 4
put glstatus i get st i
end
for i ulong 4
if ne get st i 0
ret false
end
end
ret true
end
note Linux ETXTBSY was observed at this boundary. The outstanding natural writer was not identified.
note Copy completed compiler output to a new inode before execution. No compiler process inherited
note this inode or its write descriptor. Retrying exec or sleeping would not establish that property.
fn slfdwrite fd int data view uchar * to bool
n = ulong 0
for i ulong 65536
if ge n len data
ret true
end
r = write fd data n sub len data n
if le r 0
ret false
end
n = add n ulong r
end
ret eq n len data
end
fn slseal to bool
b = new uchar 65536 0
slwpath tlbuilt
src = fopen glpath 0 get glpathn 0 557056 0
if lt src 0
ret false
end
slunlink tlbin
slwpath tlbin
dst = fopen glpath 0 get glpathn 0 557249 384
if lt dst 0
x = fclose int src
ret false
end
ok = false
for i ulong 129
r = read int src b 0 65536
if eq r 0
ok = true
break
end
if lt r 0
break
end
if not slfdwrite int dst view part b 0 ulong r
break
end
end
x = fclose int src
r = fsync int dst
mode = fchmod int dst 320
x = fclose int dst
ret and and ok eq r 0 eq mode 0
end
fn slcheckex to bool
b = new uchar 4097 0
e = new uchar 4096 0
slwpath tlout
n = slpread b
en = slfield 8 e
if or lt n 0 gt n 4096
ret false
end
if not sleq view part b 0 ulong n view part e 0 en
ret false
end
note Negative control changes the declared expected bytes; it must fail the same exact-byte comparator.
if eq en 0
put e 0 88
ret not sleq view part b 0 ulong n view part e 0 1
end
put e 0 xor get e 0 1
ret not sleq view part b 0 ulong n view part e 0 en
end
fn slverify to bool
put glphase 0 1
if ne get glrec 8 2
ret false
end
if not slwmk
ret false
end
if not slpincc
ret false
end
if not slwfield tlcode 5
ret false
end
if not slwfield tlin 7
ret false
end
put glphase 0 2
slcompilepk
if not slrun tlcode tlbuilt false
ret false
end
if not slseal
ret false
end
put glphase 0 3
slpknew
slpkpath tlbin
if not slrun tlin tlout true
ret false
end
put glphase 0 4
ret slcheckex
end
global glrcpt uchar 353
fn slrh fld ulong name view uchar * to bool
p = new uchar 1024 0
h = new uchar 64 0
slwpath name
n = slpget p
if not slfilehash view part p 0 n h
ret false
end
for i ulong 64
put glrcpt add fld i get h i
end
ret true
end
fn slreceipt id view uchar * ok bool to bool
b = new uchar 353 0
h = new uchar 64 0
m = new uchar 32 0
for i ulong 353
put glrcpt i 0
end
for i ulong 64
put glrcpt i get id i
put glrcpt add i 193 get tlpin i
end
put glrcpt 64 2
put glrcpt 65 uchar get glphase 0
put glrcpt 66 get glstatus 1
put glrcpt 67 get glstatus 0
if ok
if not slrh 65 tlbin
ret false
end
if not slrh 129 tlout
ret false
end
put glrcpt 64 1
end
slhash tlpol h
for i ulong 64
put glrcpt add i 257 get h i
end
for i ulong 321
put b i get glrcpt i
end
slmac view part b 0 321 m
for i ulong 32
put b add i 321 get m i
end
slpath tlrece id
ret slpatom b
end
fn slreceiptget id view uchar * to ulong
b = new uchar 354 0
m = new uchar 32 0
h = new uchar 64 0
slpath tlrece id
n = slpread b
if eq n -2
ret 0
end
if ne n 353
ret 9
end
slmac view part b 0 321 m
if not sleq view part b 321 32 m
ret 9
end
if not sleq view part b 0 64 id
ret 9
end
if not sleq view part b 193 64 tlpin
ret 9
end
slhash tlpol h
if not sleq view part b 257 64 h
ret 9
end
if or lt get b 64 1 gt get b 64 2
ret 9
end
for i ulong 353
put glrcpt i get b i
end
ret ulong get b 64
end
note ---- the verification job. The server never compiles or runs a submission: the live forged
note runs in a namespace with no compiler, no bwrap and nested namespaces disabled. It only queues
note one job, the file <root>job holding the 64-character record id. The collector, its own program
note (salvage/collector.om) outside that namespace, takes the job, verifies, writes the receipt and
note removes the file. One job at a time: while the file exists every other request is "busy".
text tljob "job"
note sljobpoll: kept for the route. The server holds no child, so there is nothing to reap.
fn sljobpoll to void
ret
end
note sljobid: the queued record id into dst. False when no job, or the file is not 64 hex characters.
fn sljobid dst edit uchar * to bool
p = new uchar 1024 0
b = new uchar 64 0
slpath tlempty tljob
n = slpget p
r = slread view part p 0 n b
if ne r 64
ret false
end
if not slhex b
ret false
end
for i ulong 64
put dst i get b i
end
ret true
end
note sljobstart: queue the job. The create is exclusive (no follow, 0600), so a queued job refuses
note the next one, and the file is synced before the request is answered.
fn sljobstart id view uchar * to bool
p = new uchar 1024 0
if not slhex id
ret false
end
slpath tlempty tljob
n = slpget p
if not slwrite view part p 0 n id 557249
ret false
end
ret slsync view part p 0 n
end
note sljobdrop: remove the job file
fn sljobdrop to void
p = new uchar 1024 0
slpath tlempty tljob
n = slpget p
r = unlink p 0 n
end
note slcollect: one pass of the collector. 0 nothing queued; 1 the job got its receipt; 2 the job
note ended without a saved receipt, or another collector holds the lock. A job file that is not a
note record id is removed (2), so a damaged file cannot hold the queue for ever.
note The collector lock is held through verification, receipt and cleanup.
fn slcollect to ulong
id = new uchar 64 0
p = new uchar 1024 0
b = new uchar 65 0
if not sljobid id
slpath tlempty tljob
n = slpget p
r = slread view part p 0 n b
if eq r -2
ret 0
end
sljobdrop
ret 2
end
slpath tlempty tljlock
lockfd = fopen glpath 0 get glpathn 0 557122 384
if lt lockfd 0
ret 2
end
locked = flock int lockfd 6
if ne locked 0
x = fclose int lockfd
ret 2
end
ok = slload id
if ok
ok = slverify
end
saved = slreceipt id ok
slunlink tlcc
slunlink tlbuilt
slunlink tlbin
slunlink tlcode
slunlink tlin
slunlink tlout
slunlink tlerr
sljobdrop
x = fclose int lockfd
if not saved
ret 2
end
ret 1
end

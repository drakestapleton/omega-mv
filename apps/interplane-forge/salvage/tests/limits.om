text qla "did:key:quota-author"
text qlb "did:key:other-author"
text qlpass "SALVAGE_LIMITS PASS: 64 per author, durable recount, independent author, second writer refused\n"
fn qlrecord who view uchar * serial uchar to void
b = new uchar 1 0
put b 0 serial
slbegin 1
x = slput 0 who
x = slput 1 b
for i ulong 10
x = slput add i 2 tlempty
end
end
fn main to int
p = new uchar 512 0
st = new uchar 4 0
n = argread 1 p 0 512
if le n 0
ret 1
end
if not slroot view part p 0 ulong n
ret 2
end
if not slinit
ret 3
end
for i ulong 64
qlrecord qla uchar add i 32
if not slsave
ret 4
end
end
qlrecord qla 100
if slsave
ret 5
end
qlrecord qlb 100
if not slsave
ret 6
end
if ne get glidxn 0 65
ret 7
end
if not slinit
ret 8
end
qlrecord qla 101
if slquota
ret 9
end
pid = fork
if lt pid 0
ret 10
end
if eq pid 0
r = fclose int get gllock 0
put gllock 0 0
if slinit
exit 1
end
exit 0
end
r = waitpid int pid st 0 4 0
if ne r pid
ret 11
end
if ne get st 1 0
ret 12
end
r = write 1 qlpass 0 len qlpass
ret 0
end

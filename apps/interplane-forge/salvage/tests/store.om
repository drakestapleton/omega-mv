note Standalone: om2 + sha2.om + 00core.om + this test. Fresh absolute store passed as argv[1].
global gtcnt ulong 1
text ttactor "did:key:test-builder"
text tttitle "A broken idea worth keeping"
text ttcode "om2\nfn main to int\nret 0\nend\n"
text ttabc "abc"
text ttsha "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
text ttpass "SALVAGE_STORE PASS\n"
fn styes yes bool to void
put gtcnt 0 add get gtcnt 0 1
if not yes
exit int get gtcnt 0
end
end
fn main to int
p = new uchar 512 0
id = new uchar 64 0
h = new uchar 64 0
buf = new uchar 32768 0
n = argread 1 p 0 512
styes gt n 0
styes slroot view part p 0 ulong n
styes slinit
styes eq get glidxn 0 0
slhash ttabc h
styes sleq h ttsha
styes slhex h
put h 0 71
styes not slhex h
slbegin 1
styes slput 0 ttactor
styes slput 1 tttitle
styes slput 2 tlempty
styes slput 3 tlempty
styes slput 4 tlempty
styes slput 5 ttcode
for i ulong 6
styes slput add i 6 tlempty
end
styes slparse get glrl 0
styes slsave
styes eq get glidxn 0 1
for i ulong 64
put id i get glrid i
end
styes slsave
styes eq get glidxn 0 1
styes slload id
styes slfeq 5 ttcode
styes eq slgetstate id 0
styes slsetstate id 1
styes eq slgetstate id 1
styes slsetstate id 2
styes eq slgetstate id 2
styes slinit
styes eq get glidxn 0 1
styes slload id
put glrec 9 1
styes not slparse get glrl 0
put glrec 9 0
styes not slparse sub get glrl 0 1
styes slparse get glrl 0
slpath tlobjs id
pn = slpget p
fd = fopen p 0 pn 557057 0
styes ge fd 0
put buf 0 88
r = write int fd buf 0 1
x = fclose int fd
styes eq r 1
styes not slload id
slpath tlstate id
pn = slpget p
fd = fopen p 0 pn 557057 0
styes ge fd 0
r = write int fd buf 0 1
x = fclose int fd
styes eq r 1
styes eq slgetstate id 9
slpath tlempty tlkey
r = unlink glpath 0 get glpathn 0
styes eq r 0
styes not slinit
r = write 1 ttpass 0 len ttpass
ret 0
end

text tvhello "om2\ntext msg \"hello\\n\"\nfn main to int\nr = write 1 msg 0 len msg\nret 0\nend\n"
text tvexpect "hello\n"
text tvwrong "wrong\n"
text tvbad "not an Omega program"
text tvdeny "om2\ntext p \"/etc/passwd\"\nfn main to int\nfd = fopen p 0 len p 0 0\nif ge fd 0\nret 1\nend\nret 0\nend\n"
text tvloop "om2\nfn main to int\nx = ulong 0\nfor i ulong 1000000000000\nx = add x i\nend\nret int and x 255\nend\n"
text tvexit "om2\nfn main to int\nret 1\nend\n"
text tvpass "SALVAGE_SANDBOX PASS 7 (includes held-writer handoff control)\n"
fn tvpart code view uchar * expected view uchar * to void
slbegin 2
for i ulong 5
x = slput i tlempty
end
x = slput 5 code
x = slput 6 tlempty
x = slput 7 tlempty
x = slput 8 expected
for i ulong 3
x = slput add i 9 tlempty
end
end
fn tvhandoff to bool
slpath tlwork tlbuilt
held = fopen glpath 0 get glpathn 0 557057 0
if lt held 0
ret false
end
r = fchmod int held 320
slpknew
slpkpath tlbuilt
raw = slrun tlin tlout true
busy = eq get glstatus 1 26
sealed = slseal
slpknew
slpkpath tlbin
safe = slrun tlin tlout true
r = fclose int held
ret and and not raw busy and sealed safe
end

fn main to int
p = new uchar 512 0
n = argread 1 p 0 512
if le n 0
ret 10
end
if not slroot view part p 0 ulong n
ret 11
end
if not slinit
ret 12
end
tvpart tvhello tvexpect
if not slverify
ret 1
end
if not tvhandoff
ret 7
end
tvpart tvhello tvwrong
if slverify
ret 2
end
tvpart tvbad tlempty
if slverify
ret 3
end
tvpart tvdeny tlempty
if not slverify
ret 4
end
tvpart tvloop tlempty
if slverify
ret 5
end
tvpart tvexit tlempty
if slverify
ret 6
end
r = write 1 tvpass 0 len tvpass
ret 0
end

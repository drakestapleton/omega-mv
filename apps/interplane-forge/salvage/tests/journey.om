note Compose all forge units with server main renamed, then this unit. argv[1] fresh private directory.
note Session identity fixture calls the real write gate; HTTP sign-in is separately exercised with throwaway keys.
text qva "did:key:builder-a"
text qvb "did:key:builder-b"
text qvcsrf "11111111111111111111111111111111"
text qvsrc "csrf=11111111111111111111111111111111&action=source&consent=yes&title=Broken+hello&origin=https%3A%2F%2Fexample.org%2Fidea&license=MIT&description=%3Cscript%3Ealert%281%29%3C%2Fscript%3E&source=unfinished&credit=Original+Builder&language=text"
text qvpart "csrf=11111111111111111111111111111111&action=derive&consent=yes&title=Useful+hello&description=Repaired+example&source=om2%0D%0Atext+msg+%22hello%5Cn%22%0D%0Afn+main+to+int%0D%0Ar+%3D+write+1+msg+0+len+msg%0D%0Aret+0%0D%0Aend%0D%0A&input=&expected=hello%0D%0A"
text qvverify "csrf=11111111111111111111111111111111&action=verify"
text qvpub "csrf=11111111111111111111111111111111&action=publish"
text qvwith "csrf=11111111111111111111111111111111&action=withdraw"
text qvbad "csrf=bad&action=source"
text qvdup "csrf=11111111111111111111111111111111&action=source&action=derive"
text qvesc "&lt;script&gt;"
text qvexp "hello\n"
text qvpass "SALVAGE_JOURNEY PASS\n"
text qvpct "csrf=11111111111111111111111111111111&action=source&source=a%ZZworld"
text qvpct2 "csrf=11111111111111111111111111111111&action=source&source=a%&title=b"
text qvpct3 "csrf=11111111111111111111111111111111&action=source&source=a%"
text qvbadp "SALVAGE_JOURNEY FAIL assertion "
global qvcnt ulong 1
fn qvassert yes bool to void
b = new uchar 3 0
put qvcnt 0 add get qvcnt 0 1
if not yes
n = get qvcnt 0
put b 0 uchar add div n 10 48
put b 1 uchar add rem n 10 48
put b 2 10
r = write 2 qvbadp 0 len qvbadp
r = write 2 b 0 3
exit 1
end
end
fn qvuser name view uchar * to void
sokclr
sokt name
who = sointern
put gscur 0 who
put gsok 0 1
put fcsrfl 0 32
for i ulong 32
put fcsrf i get qvcsrf i
end
end
fn qvbody data view uchar * to void
fresetr
put fmeth 0 3
put fbodyl 0 len data
put fbasel 0 1
put fbase 0 47
for i ulong len data bound 65536
put fbody i get data i
end
end
fn qvfind s view uchar * to bool
n = get fobl 0
if lt n len s
ret false
end
for i ulong add sub n len s 1 bound 65536
same = true
for j ulong len s bound 256
if ne get fob add i j get s j
same = false
end
end
if same
ret true
end
end
ret false
end
text qvjunk "stale"
note qvnext: <root>job.next, the name sljobstart writes before its rename. qvnew true creates it
note (a server that stopped between its write and its rename); false reports whether it exists.
fn qvnext qvnew bool to bool
t = new uchar 1100 0
b = new uchar 16 0
slpath tlempty tljob
n = slpget t
for i ulong len tlnext
put t add n i get tlnext i
end
m = add n len tlnext
if qvnew
ret slwrite view part t 0 m qvjunk 557249
end
ret ne slread view part t 0 m b -2
end
fn main to int
p = new uchar 512 0
srcid = new uchar 64 0
partid = new uchar 64 0
b = new uchar 4096 0
for i ulong 8
qvassert eq slpubgate ne and i 4 0 ne and i 2 0 ne and i 1 0 eq i 7
end
n = argread 1 p 0 512
qvassert gt n 0
qvassert slroot view part p 0 ulong n
qvassert slinit
put glboot 0 1
soreset
qvbody qvsrc
qvassert eq slpost tlempty 303
qvassert eq get glidxn 0 0
qvuser qva
qvbody qvbad
qvassert eq slpost tlempty 403
qvbody qvpct
qvassert eq slpost tlempty 400
qvbody qvpct2
qvassert eq slpost tlempty 400
qvbody qvpct3
qvassert eq slpost tlempty 400
qvbody qvsrc
qvassert eq slpost tlempty 303
qvassert gt get gsrlc get gscur 0 0
qvassert eq get glidxn 0 1
for i ulong 64
put srcid i get glrid i
end
put gscur 0 0
qvassert slpublic srcid
fresetr
qvassert eq slitem srcid 200
qvassert qvfind qvesc
qvuser qva
qvbody qvdup
qvassert eq slpost tlempty 400
qvassert eq get glidxn 0 1
qvuser qvb
qvbody qvpart
qvassert eq slpost srcid 303
qvassert eq get glidxn 0 2
for i ulong 64
put partid i get glrid i
end
qvassert slload partid
qvassert slfeq 8 qvexp
qvassert slown
put gscur 0 0
qvassert not slaccess partid
qvuser qva
qvassert not slaccess partid
qvuser qvb
qvassert slaccess partid
qvbody qvpub
qvassert eq slpost partid 409
note a job.next left by a server that stopped before its rename does not hold the queue
qvassert qvnext true
qvbody qvverify
qvassert eq slpost partid 303
note the server only queued the job: no receipt exists until the collector has run
qvassert sljobis partid
qvassert not sljobis srcid
qvassert ne slreceiptget partid 1
note a queued job refuses the next one
qvassert not sljobstart partid
note the refused job leaves no job.next behind
qvassert not qvnext false
note one collector pass (the collector program calls the same function) takes the job
qvassert eq slcollect 1
qvassert not sljobis partid
qvassert eq slcollect 0
qvassert eq slreceiptget partid 1
qvbody qvpub
qvassert eq slpost partid 303
put gscur 0 0
qvassert slpublic partid
fresetr
qvassert eq slbundle partid 200
qvassert gt get fobl 0 4096
qvuser qva
qvbody qvwith
qvassert eq slpost partid 403
qvassert eq slgetstate partid 1
qvbody qvwith
qvassert eq slpost srcid 303
put gscur 0 0
qvassert not slpublic srcid
qvassert not slpublic partid
qvassert not slaccess partid
qvuser qva
qvbody qvsrc
qvassert eq slpost tlempty 303
qvassert eq slgetstate srcid 2
put gscur 0 0
qvassert not slpublic partid
qvuser qvb
qvbody qvpub
qvassert eq slpost partid 409
qvuser qvb
put gsrlm get gscur 0 div get gsnow 0 60
put gsrlc get gscur 0 30
qvbody qvpub
qvassert eq slpost partid 429
r = write 1 qvpass 0 len qvpass
ret 0
end

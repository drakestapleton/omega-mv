note SPDX-License-Identifier: Apache-2.0
note Salvage shared record codec and bounded durable store. See docs/SALVAGE.md.
note Record: IPSLV001, kind u8, seven zero bytes, twelve u32 LE lengths, exact field bytes.
note Kinds 1 source, 2 derived Omega part, 3 collector receipt. IDs are SHA-256 of exact record bytes.
global glrec uchar 32768
global glrl ulong 1
global gloff ulong 12
global gllen ulong 12
global glrid uchar 64
global glroot uchar 512
global glrootn ulong 1
global glpath uchar 1024
global glpathn ulong 1
global glidx uchar 266240
global glidxn ulong 1
global glok ulong 1
global glkey uchar 32
global gllock long 1
global glnext ulong 1
global glowners uchar 262144
global glownlen ulong 4096
text tllock "writer.lock"
text tlmagic "IPSLV001"
text tlobjs "objects/"
text tlrece "receipts/"
text tlstate "state/"
text tlindex "index"
text tlkey "collector.key"
text tlrand "/dev/urandom"
text tlnext ".next"
text tlhex "0123456789abcdef"
text tlpin "3ad9f10f64309e7acf8a725082b28e23a2a4aeb07e98322fb4dc0fcd8fc93194"
fn slhex s view uchar * to bool
if ne len s 64
ret false
end
for i ulong 64
c = get s i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret true
end
fn sleq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 32768
if ne get a i get b i
ret false
end
end
ret true
end
fn slhash d view uchar * dst edit uchar * to void
c = new ulong 40 0
h = new uchar 32 0
sha256_init c
sha256_update c d
sha256_final c h
for i ulong 32
put dst mul i 2 get tlhex ulong shr get h i 4
put dst add mul i 2 1 get tlhex ulong and get h i 15
end
end
fn slmac d view uchar * dst edit uchar * to void
c = new ulong 40 0
k = new uchar 64 0
ih = new uchar 32 0
for i ulong 64
v = uchar 54
if lt i 32
v = xor get glkey i 54
end
put k i v
end
sha256_init c
sha256_update c k
sha256_update c d
sha256_final c ih
for i ulong 64
v = uchar 92
if lt i 32
v = xor get glkey i 92
end
put k i v
end
sha256_init c
sha256_update c k
sha256_update c ih
sha256_final c dst
end
fn slcap k ulong to ulong
if eq k 0
ret 64
end
if eq k 1
ret 160
end
if eq k 2
ret 512
end
if eq k 3
ret 64
end
if eq k 4
ret 2048
end
if eq k 5
ret 16384
end
if eq k 6
ret 64
end
if or eq k 7 eq k 8
ret 4096
end
if eq k 9
ret 512
end
if eq k 10
ret 128
end
ret 32
end
fn slbegin kind uchar to void
for i ulong 64
put glrec i 0
end
for i ulong 8
put glrec i get tlmagic i
end
put glrec 8 kind
put glrl 0 64
put glnext 0 0
for i ulong 12
put gloff i 64
put gllen i 0
end
end
fn slput k ulong d view uchar * to bool
if or ne k get glnext 0 or ge k 12 gt len d slcap k
ret false
end
n = get glrl 0
if gt add n len d len glrec
ret false
end
put gloff k n
put gllen k len d
for i ulong 4
pos = add mul k 4 16
pos = add pos i
v = shr len d mul i 8
put glrec pos uchar and v 255
end
for i ulong len d bound 16384
put glrec add n i get d i
end
put glrl 0 add n len d
put glnext 0 add k 1
ret true
end
fn slparse n ulong to bool
if or lt n 64 gt n len glrec
ret false
end
for i ulong 8
if ne get glrec i get tlmagic i
ret false
end
end
if or lt get glrec 8 1 gt get glrec 8 3
ret false
end
for i ulong 7
if ne get glrec add ulong 9 i 0
ret false
end
end
p = ulong 64
for k ulong 12
l = ulong 0
for i ulong 4
l = or l shl ulong get glrec add add ulong 16 mul k 4 i mul i 8
end
if or gt l slcap k gt l sub n p
ret false
end
put gloff k p
put gllen k l
p = add p l
end
if ne p n
ret false
end
put glrl 0 n
put glnext 0 12
ret true
end
fn slfield k ulong dst edit uchar * to ulong
n = get gllen k
if gt n len dst
ret 0
end
for i ulong n bound 16384
put dst i get glrec add get gloff k i
end
ret n
end
fn slfeq k ulong t view uchar * to bool
if ne get gllen k len t
ret false
end
for i ulong len t bound 16384
if ne get glrec add get gloff k i get t i
ret false
end
end
ret true
end
fn slidentify to void
h = new uchar 64 0
b = new uchar 32768 0
for i ulong get glrl 0 bound 32768
put b i get glrec i
end
slhash view part b 0 get glrl 0 h
for i ulong 64
put glrid i get h i
end
end
fn slroot d view uchar * to bool
if or lt len d 2 gt len d 500
ret false
end
if or ne get d 0 47 ne get d sub len d 1 47
ret false
end
for i ulong len d bound 512
c = get d i
if or lt c 32 eq c 127
ret false
end
if gt i 0
if and eq c 46 eq get d sub i 1 47
ret false
end
end
put glroot i c
end
put glrootn 0 len d
ret true
end
fn slpath folder view uchar * name view uchar * to void
n = get glrootn 0
for i ulong n bound 512
put glpath i get glroot i
end
for i ulong len folder bound 128
put glpath add n i get folder i
end
n = add n len folder
for i ulong len name bound 128
put glpath add n i get name i
end
put glpathn 0 add n len name
end
fn slread path view uchar * dst edit uchar * to long
one = new uchar 1 0
fd = fopen path 0 len path 557056 0
if lt fd 0
ret fd
end
n = ulong 0
r = long 1
while and gt r 0 lt n len dst bound 32768
r = read int fd dst n sub len dst n
if gt r 0
n = add n ulong r
end
end
if eq n len dst
r = read int fd one 0 1
if gt r 0
x = fclose int fd
ret -27
end
end
x = fclose int fd
if lt r 0
ret r
end
ret long n
end
fn slwrite path view uchar * data view uchar * flags int to bool
fd = fopen path 0 len path flags 384
if lt fd 0
ret false
end
n = ulong 0
for it ulong 32768
if ge n len data
break
end
r = write int fd data n sub len data n
if le r 0
break
end
n = add n ulong r
end
r = fsync int fd
x = fclose int fd
ret and eq n len data eq r 0
end
fn slsync path view uchar * to bool
n = ulong 0
for i ulong len path bound 1024
if eq get path i 47
n = add i 1
end
end
if eq n 0
ret false
end
fd = fopen path 0 n 573440 0
if lt fd 0
ret false
end
r = fsync int fd
x = fclose int fd
ret eq r 0
end
note Native renames packet follows the existing seed/node/tool.om two-path format.
fn slrename a view uchar * b view uchar * flags int to bool
pk = new uchar 4096 0
put pk 0 2
put pk 2 uchar and len a 255
put pk 3 uchar shr len a 8
for i ulong len a bound 1024
put pk add ulong 4 i get a i
end
o = add ulong 4 len a
put pk o uchar and len b 255
put pk add o 1 uchar shr len b 8
for i ulong len b bound 1024
put pk add add o 2 i get b i
end
r = renames pk 0 add add o 2 len b flags
ret eq r 0
end
fn slatomic path view uchar * data view uchar * to bool
tmp = new uchar 1100 0
n = len path
for i ulong n bound 1024
put tmp i get path i
end
for i ulong len tlnext
put tmp add n i get tlnext i
end
n = add n len tlnext
r = unlink tmp 0 n
if not slwrite view part tmp 0 n data 557249
ret false
end
if not slrename view part tmp 0 n path 0
r = unlink tmp 0 n
ret false
end
ret slsync path
end
fn slpget dst edit uchar * to ulong
n = get glpathn 0
for i ulong n bound 1024
put dst i get glpath i
end
ret n
end
fn slpread dst edit uchar * to long
p = new uchar 1024 0
n = slpget p
ret slread view part p 0 n dst
end
fn slpatom data view uchar * to bool
p = new uchar 1024 0
n = slpget p
ret slatomic view part p 0 n data
end
text tlempty ""
fn slmkdir folder view uchar * to bool
slpath folder tlempty
r = makedir glpath 0 get glpathn 0 448
if not or eq r 0 eq r -17
ret false
end
fd = fopen glpath 0 get glpathn 0 573440 0
if lt fd 0
ret false
end
r = fsync int fd
x = fclose int fd
ret eq r 0
end
fn slidxload to bool
b = new uchar 266240 0
slpath tlempty tlindex
r = slpread b
if eq r -2
put glidxn 0 0
ret true
end
if or lt r 0 ne rem r 65 0
ret false
end
n = ulong r
for i ulong div n 65 bound 4096
if ne get b add mul i 65 64 10
ret false
end
if not slhex view part b mul i 65 64
ret false
end
end
for i ulong n bound 266240
put glidx i get b i
end
put glidxn 0 div n 65
ret true
end
fn slkeyload to bool
b = new uchar 32 0
p = new uchar 1024 0
slpath tlempty tlkey
n = slpget p
r = slread view part p 0 n b
if eq r -2
if ne get glidxn 0 0
ret false
end
fd = fopen tlrand 0 len tlrand 524288 0
if lt fd 0
ret false
end
r = read int fd b 0 32
x = fclose int fd
if ne r 32
ret false
end
if not slwrite view part p 0 n b 557249
ret false
end
if not slsync view part p 0 n
ret false
end
else
if ne r 32
ret false
end
end
for i ulong 32
put glkey i get b i
end
ret true
end
fn sllock to bool
if gt get gllock 0 0
ret true
end
slpath tlempty tllock
fd = fopen glpath 0 get glpathn 0 557122 384
if lt fd 0
ret false
end
r = flock int fd 6
if ne r 0
x = fclose int fd
ret false
end
put gllock 0 fd
ret true
end
fn slprivate fd int to bool
st = new uchar 128 0
r = fstat fd st 0 128
if ne r 0
ret false
end
mode = or ulong get st 16 shl ulong get st 17 8
ret and eq and mode 61440 16384 eq and mode 511 448
end
fn slowncache ix ulong to void
n = get gllen 0
put glownlen ix n
for i ulong n bound 64
put glowners add mul ix 64 i get glrec add get gloff 0 i
end
end
fn slownload to bool
id = new uchar 64 0
for ix ulong get glidxn 0 bound 4096
for i ulong 64
put id i get glidx add mul ix 65 i
end
if not slload id
ret false
end
slowncache ix
end
ret true
end
fn slownmatch ix ulong to bool
n = get gllen 0
if ne n get glownlen ix
ret false
end
a = mul ix 64
b = get gloff 0
for i ulong n bound 64
if ne get glowners add a i get glrec add b i
ret false
end
end
ret true
end
fn slquota to bool
count = ulong 0
for ix ulong get glidxn 0 bound 4096
if slownmatch ix
count = add count 1
end
end
ret lt count 64
end
fn slinit to bool
p = new uchar 512 0
put glok 0 0
r = makedir glroot 0 get glrootn 0 448
if not or eq r 0 eq r -17
ret false
end
for i ulong get glrootn 0 bound 512
put p i get glroot i
end
if not slsync view part p 0 sub get glrootn 0 1
ret false
end
fd = fopen glroot 0 get glrootn 0 573440 0
if lt fd 0
ret false
end
ok = slprivate int fd
x = fclose int fd
if not ok
ret false
end
if not slmkdir tlobjs
ret false
end
if not slmkdir tlrece
ret false
end
if not slmkdir tlstate
ret false
end
if not sllock
ret false
end
if not slidxload
ret false
end
if not slkeyload
ret false
end
if not slownload
ret false
end
put glok 0 1
ret true
end
fn slknown id view uchar * to bool
b = new uchar 64 0
for i ulong get glidxn 0 bound 4096
for j ulong 64
put b j get glidx add mul i 65 j
end
if sleq id b
ret true
end
end
ret false
end
fn slload id view uchar * to bool
if not slhex id
ret false
end
slpath tlobjs id
b = new uchar 32768 0
h = new uchar 64 0
n = slpread b
if gt n 0
for i ulong ulong n bound 32768
put glrec i get b i
end
end
if lt n 0
ret false
end
if not slparse ulong n
ret false
end
slidentify
for i ulong 64
put h i get glrid i
end
ret sleq id h
end
fn slsave to bool
if ne get glnext 0 12
ret false
end
if eq get glok 0 0
ret false
end
slidentify
id = new uchar 64 0
for i ulong 64
put id i get glrid i
end
if slknown id
ret true
end
if or ge get glidxn 0 4096 not slquota
ret false
end
slpath tlobjs id
b = new uchar 32768 0
for i ulong get glrl 0 bound 32768
put b i get glrec i
end
if not slpatom view part b 0 get glrl 0
ret false
end
n = get glidxn 0
for i ulong 64
put glidx add mul n 65 i get id i
end
put glidx add mul n 65 64 10
slpath tlempty tlindex
ix = new uchar 266240 0
il = mul add n 1 65
for i ulong il bound 266240
put ix i get glidx i
end
if not slpatom view part ix 0 il
put glok 0 0
ret false
end
slowncache n
put glidxn 0 add n 1
ret true
end
note State: ID64, action byte (1 published, 2 withdrawn), then HMAC-SHA256 over first 65 bytes.
fn slsetstate id view uchar * action uchar to bool
b = new uchar 97 0
h = new uchar 32 0
for i ulong 64
put b i get id i
end
put b 64 action
slmac view part b 0 65 h
for i ulong 32
put b add ulong 65 i get h i
end
slpath tlstate id
ret slpatom b
end
fn slgetstate id view uchar * to ulong
b = new uchar 98 0
h = new uchar 32 0
slpath tlstate id
n = slpread b
if eq n -2
ret 0
end
if ne n 97
ret 9
end
slmac view part b 0 65 h
if not sleq view part b 65 32 h
ret 9
end
if not sleq view part b 0 64 id
ret 9
end
if or lt get b 64 1 gt get b 64 2
ret 9
end
ret ulong get b 64
end

note patch/p6json.om: the JSON form of the patch pages (docs/API.md forge/patch-list/1, forge/patch/1).
note The documents name the repository by owner and name only.
note pajhead t: t (the schema and the base key up to its opening quote), then base, owner and repo
fn pajhead t view uchar * to void
fjstart
fput t
fputb
fput tpjown
fput tfowner
fput tpjrep
i = get fridx 0
for k ulong get fanl i bound 128
fputc frnbyte i k
end
end
note pajname: the author's social name as a JSON string, null when the account has none
fn pajname to void
d = padid
if eq d 0
fput tpjnull
ret
end
n = get gsnm d
if eq n 0
fput tpjnull
ret
end
o = get gsso n
fjtb
for i ulong get gssl n bound 64
fjtc get gsstr add o i
end
fjstr
end
note pajbody: the keys of the loaded patch from its id's value on, up to the closing quote of diff.
note full adds description and mbox_sha256 (forge/patch/1).
fn pajbody full bool to void
paputid
fput tpjttl
fjtb
for i ulong get gpttll 0 bound 256
fjtc get gpttl i
end
fjstr
if full
fput tpjdsc
n = pardf tpfds
fjfx 0 n
end
fput tpjsta
fjtb
for i ulong get gpmdidl 0 bound 128
fjtc get gpmdid i
end
fjstr
fput tpjnm
pajname
fput tpjbc
paput40 0
fput tpjhc
paput40 1
fput tpjcm
fnum get gpmcm 0
fput tpjfl
fnum get gpmfl 0
fput tpjby
fnum get gpmby 0
if full
fput tpjsha
for i ulong 64
fputc get gpmsha i
end
fput tpjcr1
else
fput tpjcr2
end
fjiso get gpmts 0
fput tpjpth
papath
fput tpjpat
papath
fput tpsfxp
fput tpjdif
papath
fput tpsfxd
end
fn pajone to long
pajhead tpjp1
fput tpjid2
pajbody true
fputc 34
fput tpjend
ret 200
end
note pajpg pg: the path of list page pg as a JSON string
fn pajpg pg ulong to void
fputc 34
fputrl
fput tphqp
fnum pg
fputc 34
end
fn pajlist tot ulong pg ulong pages ulong cnt ulong to long
pajhead tpjl1
fput tpjpage
fnum pg
fput tpjper
fnum tot
fput tpjpats
first = true
for j ulong cnt bound 30
if paidset j
if paload
if not first
fput tpjsep
end
first = false
fput tpjid
pajbody false
fput tpjobe
end
end
end
fput tpjnext
if lt pg pages
pajpg add pg 1
else
fput tpjnull
end
fput tpjprev
if gt pg 1
pajpg sub pg 1
else
fput tpjnull
end
fput tpjend
ret 200
end

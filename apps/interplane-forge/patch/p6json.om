note pajlabs: the labels file as an array of strings (one per line; empty lines are left out; its
note first 65536 bytes)
fn pajlabs to void
fputc 91
if eq get gpimp 0 0
fputc 93
ret
end
n = pafrd tpflb 65536
s = ulong 0
c = ulong 0
for i ulong add n 1 bound 65537
e = eq i n
if not e
e = eq get fxo i 10
end
if e
if gt i s
if gt c 0
fputc 44
end
fjtb
for j ulong sub i s bound 65536
fjtc get fxo add s j
end
fjstr
c = add c 1
end
s = add i 1
end
end
fputc 93
end
note pajfit f0 t0: true while the document is at most PAJMX bytes and no byte was dropped; else the
note output goes back to f0 (and the cut flag to t0): the comment just written is taken back whole
fn pajfit f0 ulong t0 ulong to bool
if and le get fobl 0 PAJMX eq get fobtr 0 t0
ret true
end
put fobl 0 f0
put fobtr 0 t0
ret false
end
note pajcoms: the thread records (the description is not one of them) up to the first malformed one,
note or up to the one that takes the document over PAJMX (taken back, so the document stays whole).
note gptr says why they are not the whole thread: 3 the document budget; else 2 the thread file is
note larger than gpth; else 1 a malformed record (when the page prints its sentence); 0 they are
fn pajcoms to void
put gptr 0 0
fputc 91
if eq get gpimp 0 0
fputc 93
ret
end
pathld
p = ulong 0
c = ulong 0
n = get gpthl 0
w = ulong 0
while lt p n bound 16777216
p = patrec p
if eq get gpr 0 0
w = 1
break
end
f0 = get fobl 0
t0 = get fobtr 0
if gt c 0
fputc 44
end
fputc 10
pajcom
if not pajfit f0 t0
w = 3
break
end
c = add c 1
end
fputc 93
if ne w 3
if ne get gpthc 0 0
w = 2
end
end
put gptr 0 w
end
note pajcom: the parsed record (gpr): {"author":null,"login","kind",["state"],["path","line"],"time",
note "body"}; a review's state "-" is null
fn pajcom to void
k = get gpr 0
fputc 123
fyk0 tpkau
fynull
fyk tpklog
pajtr 3
fyk tpkknd
if eq k 1
fysv tprcom
end
if eq k 2
fysv tprrev
fyk tpkstt
if patis 5 tpdash
fynull
else
pajtr 5
end
end
if eq k 3
fysv tprrc
fyk tpkpt
pajtr 8
fyk tpkln
fnum get gpr 7
end
fyk tpktim
if eq get gpr 2 20
pajtr 1
else
fynull
end
fyk tpkbdy
pajtr 10
fputc 125
end
note pajtr a: gpth[gpr a, + gpr a+1) as a JSON string
fn pajtr a ulong to void
fjtb
o = get gpr a
for i ulong get gpr add a 1 bound 16777216
fjtc get gpth add o i
end
fjstr
end
fn pajone to long
pajhead tpjp1
fput tpjid2
pajbody true
fput tpjend
ret 200
end
note pajpg pg: the path of list page pg as a JSON string
fn pajpg pg ulong to void
fputc 34
fputrl
fput tphqp
fnum pg
fputc 34
end
note pajlist: forge/patch-list/1. count: the items the pages list (lst); states: the same items by
note state (signed patches open); damaged: the index lines whose folder does not load as an item
fn pajlist lst ulong dmg ulong pg ulong pages ulong cnt ulong to long
pajhead tpjl1
fput tpjpage
fnum pg
fput tpjper
fnum lst
fyk tpkst2
fputc 123
fyk0 tpwopn
fnum get gpsc 0
fyk tpwclo
fnum get gpsc 1
fyk tpwmrg
fnum get gpsc 2
fputc 125
fyk tpkdm
fnum dmg
fput tpjpats
first = true
for j ulong cnt bound 30
if paidset j
if paany
if not first
fput tpjsep
end
first = false
fput tpjid
pajbody false
fputc 125
end
end
end
fput tpjnext
if lt pg pages
pajpg add pg 1
else
fput tpjnull
end
fput tpjprev
if gt pg 1
pajpg sub pg 1
else
fput tpjnull
end
fput tpjend
ret 200
end

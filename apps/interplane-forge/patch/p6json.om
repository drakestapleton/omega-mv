note patch/p6json.om: the JSON form of the patch pages (docs/API.md forge/patch-list/1, forge/patch/1).
note The documents name the repository by owner and name only.
note pajhead t: t (the schema and the base key up to its opening quote), then base, owner and repo
fn pajhead t view uchar * to void
fjstart
fput t
fputb
fput tpjown
fput tfowner
fput tpjrep
i = get fridx 0
for k ulong get fanl i bound 128
fputc frnbyte i k
end
end
note pajname: the author's social name as a JSON string, null when the account has none
fn pajname to void
d = padid
if eq d 0
fput tpjnull
ret
end
n = get gsnm d
if eq n 0
fput tpjnull
ret
end
o = get gsso n
fjtb
for i ulong get gssl n bound 64
fjtc get gsstr add o i
end
fjstr
end
note pajbody full: the keys of the loaded item (signed or imported) from its id's value on, in the order
note of SPEC section 3, up to its closing brace (the caller writes it). full: forge/patch/1 (adds
note description, mbox_sha256, opened, closed, merge, labels, comments, thread_truncated and
note thread_reason); else a list row (adds comments_count). Both end with path, patch, diff,
note diff_unavailable and bundle. The key set is the same for both kinds of item.
fn pajbody full bool to void
paputid
fput tpjttl
fjtb
for i ulong get gpttll 0 bound 1024
fjtc get gpttl i
end
fjstr
if full
fput tpjdsc
n = pardf tpfds
fjfx 0 n
end
imp = ne get gpimp 0 0
fyk tpkst
pajstw
fyk tpksd
fybool ne get gpider 0 0
fyk tpkau
if imp
fynull
else
pajauth
end
fyk tpkim
if imp
pajimp
else
fynull
end
fyk tpkbc
pajsha 0
fyk tpkhc
pajsha 1
pajcnts imp
fyk tpkcd
pajcode
if full
pajfull imp
end
fyk tpkcr
if imp
pajsv tpsjutc
else
fjiso get gpmts 0
end
if not full
fyk tpkcc
if imp
pathld
fnum patcnt
else
fputc 48
end
end
pajlinks
end

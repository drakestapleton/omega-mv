if eq u 2
fysv tpun2
ret
end
if eq u 3
fysv tpun3
ret
end
if eq u 4
fysv tpun4
ret
end
if eq u 5
fysv tpun5
ret
end
if eq u 6
fysv tpun6
ret
end
fynull
end
note pajlinks: path, patch (null without an mbox), diff (a link for an mbox, and for a bundle whose
note diff exists or can be made; else null), diff_unavailable (null beside a link; else no-code-file,
note no-base, base-not-in-store or too-large), bundle (null without head.bundle)
fn pajlinks to void
fyk tpkpt
fputc 34
papath
fputc 34
k = get gpicode 0
fyk tpkpa
if eq k 1
fputc 34
papath
fput tpsfxp
fputc 34
else
fynull
end
fyk tpkdf
d = or eq k 1 and eq k 2 ne get gpihb 0 0
u = ulong 0
if d
if eq k 2
u = pajdun
end
else
u = 2
if eq k 0
u = 1
end
end
if eq u 0
fputc 34
papath
fput tpsfxd
fputc 34
else
fynull
end
fyk tpkdu
pajduw u
fyk tpkbn
if eq k 2
fputc 34
papath
fput tpsfxb
fputc 34
else
fynull
end
end
note pajgh t: the gh value t as a JSON string; null when the line is absent, empty or "-"
fn pajgh t view uchar * to void
o = paghv t
n = get gpr 15
if eq n 0
fynull
ret
end
if eq n 1
if eq get gpgh o 45
fynull
ret
end
end
fjtb
for i ulong n bound 2048
fjtc get gpgh add o i
end
fjstr
end
note pajsv t: the source.json string after the key text t as a JSON string; null without the key
fn pajsv t view uchar * to void
o = pasjv t
if eq get gpr 14 0
fynull
ret
end
fjtb
for i ulong get gpr 15 bound 4096
fjtc get gpsrc add o i
end
fjstr
end

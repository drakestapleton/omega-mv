text tpst1 "interplane-patch 1\n"
text tpns "interplane-patch"
text tpfrom "From "
text tpfrom2 " Mon Sep 17 00:00:00 2001"
text tpdg "diff --git "
text tpgbp "GIT binary patch"
text tpbf "Binary files "
text tprnf "rename from "
text tprnt "rename to "
text tpcpf "copy from "
text tpcpt "copy to "

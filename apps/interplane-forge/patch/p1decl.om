text tpm403 "sign in first: this request carries no session"
text tpmcsrf "missing or wrong CSRF token"
text tpmrate "too many writes from this address or key; wait a minute"
text tpmoff "writes are switched off on this forge right now"
text tpmform "the body is not the patch form: fields csrf, repo, base, title, description, mbox and sig, each once"
text tpmnorp "no such public repository"
text tpmrepo "the repo field does not name this repository"
text tpmnogs "this repository has no git store on this forge"
text tpmbase "base is not a commit id of 40 lowercase hex digits"
text tpmunk "unknown base: the repository has no such commit"
text tpmnotm "base is not reachable from the repository's main branch"
text tpmttl "the title must be 1 to 256 bytes of UTF-8 text on one line"
text tpmdsc "the description must be at most 60000 bytes of UTF-8 text without control bytes"
text tpmbig "the mbox is larger than 2097152 bytes"
text tpmb64 "the mbox field is not base64url without padding"
text tpmnfp "the mbox is not git format-patch output"
text tpmmany "the mbox holds more than 100 commits"
text tpmsigf "the sig field is not an armored SSH signature"
text tpmsig "the signature does not verify for this session's key and this patch"
text tpmbin "binary patches are not accepted"
text tpmpath "a patch names a path outside the repository"
text tpmappl "the mbox does not apply cleanly on base"
text tpmcnt "git applied a different number of commits than the mbox holds"
text tpmsub "the patch adds a submodule"
text tpmdbig "the combined diff of the patch is larger than 16 MiB"
text tpmint "the forge could not check the patch (internal error)"
text tpmwr "the forge could not store the patch"
text tplrm "PATCH-TMP a work folder under <data>tmp/ (pw...) could not be removed\n"

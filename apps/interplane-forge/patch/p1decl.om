note ---- request state
note gpfv: one percent-decoded form field (padec), read by the field checks and patch/p2utf8.om
global gpfv uchar 65536
note gpfo / gpfn / gpfs: offset, length and presence of the seven form fields in fbig, by index:
note 0 csrf, 1 repo, 2 base, 3 title, 4 description, 5 mbox, 6 sig
global gpfo ulong 8
global gpfn ulong 8
global gpfs ulong 8
note gpmb: the decoded mbox (F1: at most 2 MiB)
global gpmb uchar 2097152
global gpmbl ulong 1
note gpttl: the title; a signed patch's is at most 256 bytes (F2), an imported item's is cut to 1024
global gpttl uchar 1024
global gpttll ulong 1
global gpdsc uchar 60000
global gpdscl ulong 1
global gpsig uchar 4096
global gpsigl ulong 1
global gpbase uchar 40
global gphead uchar 40
global gpid uchar 16
global gpst uchar 512
global gpstl ulong 1
note gpncm: commits the mbox holds; gpnfl: files the applied patch changed; gpgrd: what the scan of
note the mbox found (0 nothing, 2 a binary patch, 3 a path outside the repository)
global gpncm ulong 1
global gpnfl ulong 1
global gpgrd ulong 1
note gpp: path builder; gpstm: the 16 hex digits that name this request's work folder and staging
note folder; gpde: one batch of directory entries (the work-folder remover)
global gpp uchar 4096
global gppl ulong 1
global gpstm uchar 16
global gpde uchar 32768
note ---- a stored patch read back (paload): author DID, creation time, commit and file counts, mbox
note bytes and its SHA-256 from the meta file; title, base and head in the globals above
global gpmdid uchar 128
global gpmdidl ulong 1
global gpmts ulong 1
global gpmcm ulong 1
global gpmfl ulong 1
global gpmby ulong 1
global gpmsha uchar 64
note gpix: the index file of one list request (paixld). The page loaders read every item through fxo,
note so the index cannot stay there while the items of the list are counted. As large as fxo: an index
note of 16777216 bytes or more (986896 lines) is the whole 500 of fincut, as before
global gpix uchar 16777216
note gpids: the ids of one list page (30 rows of 16 hex digits); gpln: a small line buffer
global gpids uchar 480
global gpln uchar 256
global gplnl ulong 1
note gpcur / gpbad: read position and failure flag of the meta file parser
global gpcur ulong 1
global gpbad ulong 1

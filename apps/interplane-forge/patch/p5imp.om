note patch/p5imp.om: imported proposals (SPEC prstore/r1 extension, written only by tools/ghimport):
note reading an imported item back, its list row and page, and the diff of a bundle-backed item.
note Every imported byte goes out through fescc (HTML) or fjtc (JSON); a GitHub login is text. Each
note reader checks a length against its buffer before it reads, so a malformed or oversized file
note ends in "not an item", a cut value or a sentence on the page, never in a trap.
note ---- loading
note pafrd t cap: the file <t> of item gpid into fxo; its length cut to cap, 0 when it cannot be read
fn pafrd t view uchar * cap ulong to ulong
pafp t
n = frdall
if lt n 0
ret 0
end
ret hmin ulong n cap
end
note pasjat s t: gpsrc holds t at s (the caller keeps s + len t inside gpsrc)
fn pasjat s ulong t view uchar * to bool
for i ulong len t bound 64
if ne get gpsrc add s i get t i
ret false
end
end
ret true
end
note pasjf t: the offset in gpsrc of the first t, the length of gpsrc when it is not there
fn pasjf t view uchar * to ulong
n = get gpsrcl 0
k = len t
if gt k n
ret n
end
for s ulong add sub n k 1 bound 4097
if pasjat s t
ret s
end
end
ret n
end
note pasjv t: the string value after the key text t in gpsrc: its offset; its length in gpr 15, and gpr
note 14 is 1 when the key is there (0 and length 0 when it is not). The value ends at its closing
note quote; a backslash ends it too (the value is cut there, never decoded), and so does the end of
note the buffer
fn pasjv t view uchar * to ulong
n = get gpsrcl 0
s = pasjf t
put gpr 15 0
put gpr 14 0
if ge s n
ret 0
end
put gpr 14 1
p = add s len t
q = p
while lt q n bound 4097
c = get gpsrc q
if or eq c 34 eq c 92
break
end
q = add q 1
end
put gpr 15 sub q p
ret p
end
note pasjnum: the number of source.json ("number":N, 1..18 digits), 0 when it has none
fn pasjnum to ulong
n = get gpsrcl 0
s = pasjf tpsjnum
if ge s n
ret 0
end
p = add s len tpsjnum
v = ulong 0
k = ulong 0
while lt p n bound 19
c = get gpsrc p
if not fisdig c
break
end
if ge k 18
ret 0
end
v = add mul v 10 ulong sub c 48
k = add k 1
p = add p 1
end
ret v
end
note paghat s e t: the gh line gpgh[s, e) starts with t
fn paghat s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
for i ulong len t bound 16
if ne get gpgh add s i get t i
ret false
end
end
ret true
end
note paghv t: the value of the gh line "<t><value>\n" in gpgh: its offset; its length in gpr 15 (0
note when there is no such whole line)
fn paghv t view uchar * to ulong
n = get gpghl 0
s = ulong 0
for i ulong n bound 2048
if eq get gpgh i 10
if paghat s i t
put gpr 15 sub sub i s len t
ret add s len t
end
s = add i 1
end
end
put gpr 15 0
ret 0
end
note paghnum: the GitHub number of the gh file ("number N", 1..18 digits), 0 when it has none
fn paghnum to ulong
o = paghv tpghn
k = get gpr 15
if or eq k 0 gt k 18
ret 0
end
v = ulong 0
for i ulong k bound 18
c = get gpgh add o i
if not fisdig c
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note paiload2: the optional files of the imported item: title (cut to 1024 bytes), base (40 hex and
note a line feed, else the item has no base), gh (cut to 2048 bytes), and the code file: mbox, else
note head.bundle, else none (its size in gpmby)
fn paiload2 to bool
n = pafrd tpftt 1024
for i ulong n bound 1024
put gpttl i get fxo i
end
put gpttll 0 n
put gpihb 0 0
papid tpfbase
r = pards
if pal40
put gpihb 0 1
for i ulong 40
put gpbase i get gpln i
end
end
n = pafrd tpfgh 2048
for i ulong n bound 2048
put gpgh i get fxo i
end
put gpghl 0 n
put gpnum 0 paghnum
if eq get gpnum 0 0
put gpnum 0 pasjnum
end
put gpicode 0 0
put gpmby 0 0
papid tpfbn
e = paexist
if e
put gpicode 0 2
put gpmby 0 pastsz
end
papid tpfmb
e = paexist
if e
put gpicode 0 1
put gpmby 0 pastsz
end
put gpmcm 0 0
put gpmfl 0 0
put gpmdidl 0 0
put gpmts 0 0
ret true
end
note paiload: the imported item gpid into the globals (SPEC section 1): false unless source.json
note starts with the import prefix, status is one of the three words and head is 40 hex and a line
note feed. source.json is kept up to 4096 bytes.
fn paiload to bool
put gpimp 0 1
n = pafrd tpfsj 4096
if lt n len tpsjpre
ret false
end
for i ulong len tpsjpre bound 64
if ne get fxo i get tpsjpre i
ret false
end
end
for i ulong n bound 4096
put gpsrc i get fxo i
end
put gpsrcl 0 n
put gpider 0 0
if lt pasjf tpsjder n
put gpider 0 1
end
s = pastrd
if gt s 2
ret false
end
put gpist 0 s
papid tpfhd
r = pards
if not pal40
ret false
end
for i ulong 40
put gphead i get gpln i
end
ret paiload2
end
note ---- the thread: records "comment <time> <login> <len>\n<body>\n", "review <time> <login>
note <STATE|-> <len>\n<body>\n" and "review-comment <time> <login> <line> <pathlen> <len>\n<path>\n
note <body>\n" (time: 20 bytes, or "-")
note pathld: the thread file of item gpid into gpth; gpthc is set when the file is larger than gpth
fn pathld to void
put gpthl 0 0
put gpthc 0 0
pafp tpfth
n = frdall
if le n 0
ret
end
if ne get fxotr 0 0
put gpthc 0 1
end
for i ulong ulong n bound 16777216
put gpth i get fxo i
end
put gpthl 0 ulong n
end
note patword a: the word at gpcur (1..256 bytes above 32) up to its space: offset in gpr a, length in
note gpr a+1; gpcur moves past the space. gpbad is set (length 0) when it is not such a word; with
note gpbad set nothing is read. At most 257 passes: the pass that sees 256 bytes returns.
fn patword a ulong to void
put gpr add a 1 0
if ne get gpbad 0 0
ret
end
p = get gpcur 0
n = get gpthl 0
q = p
while lt q n bound 257
if le get gpth q 32
break
end
if ge sub q p 256
put gpbad 0 1
ret
end
q = add q 1
end
if or ge q n eq q p
put gpbad 0 1
ret
end
if ne get gpth q 32
put gpbad 0 1
ret
end
put gpr a p
put gpr add a 1 sub q p
put gpcur 0 add q 1
end
note patnum t: the decimal at gpcur (1..18 digits) ended by the byte t; gpcur moves past t. gpbad is
note set when it is not one. At most 19 passes: the pass that sees an 19th digit returns.
fn patnum t uchar to ulong
if ne get gpbad 0 0
ret 0
end
p = get gpcur 0
n = get gpthl 0
v = ulong 0
k = ulong 0
while lt p n bound 19
c = get gpth p
if not fisdig c
break
end
if ge k 18
put gpbad 0 1
ret 0
end
v = add mul v 10 ulong sub c 48
k = add k 1
p = add p 1
end
if or eq k 0 ge p n
put gpbad 0 1
ret 0
end
if ne get gpth p t
put gpbad 0 1
ret 0
end
put gpcur 0 add p 1
ret v
end
note patis a t: the word of gpr a, a+1 is t
fn patis a ulong t view uchar * to bool
if ne get gpr add a 1 len t
ret false
end
o = get gpr a
for i ulong len t bound 16
if ne get gpth add o i get t i
ret false
end
end
ret true
end
note patkind: the record kind of the word in gpr 12, 13: 1 comment, 2 review, 3 review-comment, else 0
fn patkind to ulong
if patis 12 tprcom
ret 1
end
if patis 12 tprrev
ret 2
end
if patis 12 tprrc
ret 3
end
ret 0
end
note pattok: the time word (gpr 1, 2) is 20 bytes or "-"
fn pattok to bool
k = get gpr 2
if eq k 20
ret true
end
if ne k 1
ret false
end
ret eq get gpth get gpr 1 45
end
note patrec p: parse the record at p into gpr (0 kind, 1-2 time, 3-4 login, 5-6 state, 7 line, 8-9
note path, 10-11 body); the index after it. A malformed record leaves kind 0 and returns the thread's
note length, which stops the caller: every length is checked against the thread before the bytes it
note names are read (a path is at most 4096 bytes).
fn patrec p ulong to ulong
n = get gpthl 0
put gpr 0 0
put gpr 6 0
put gpr 7 0
put gpr 9 0
put gpbad 0 0
put gpcur 0 p
patword 12
k = patkind
if eq k 0
ret n
end
patword 1
patword 3
if eq k 2
patword 5
end
if eq k 3
put gpr 7 patnum 32
put gpr 9 patnum 32
end
b = patnum 10
if ne get gpbad 0 0
ret n
end
if not pattok
ret n
end
q = get gpcur 0
if eq k 3
m = get gpr 9
if or gt m 4096 ge add q m n
ret n
end
if ne get gpth add q m 10
ret n
end
put gpr 8 q
q = add add q m 1
end
if ge add q b n
ret n
end
if ne get gpth add q b 10
ret n
end
put gpr 10 q
put gpr 11 b
put gpr 0 k
ret add add q b 1
end
note patcnt: the records of the loaded thread up to its end or its first malformed record. A record
note is at least 15 bytes, so the passes stay far under the bound.
fn patcnt to ulong
p = ulong 0
c = ulong 0
n = get gpthl 0
while lt p n bound 16777216
p = patrec p
if ne get gpr 0 0
c = add c 1
end
end
ret c
end
note ---- pieces of the HTML pages
note patraw a: gpth[gpr a, + gpr a+1), HTML-escaped
fn patraw a ulong to void
o = get gpr a
for i ulong get gpr add a 1 bound 16777216
fescc get gpth add o i
end
end
note pattime: the record's time as YYYY-MM-DD HH:MM UTC, escaped ("-" when it has none)
fn pattime to void
if ne get gpr 2 20
fputc 45
ret
end
o = get gpr 1
for i ulong 10
fescc get gpth add o i
end
fputc 32
for i ulong 5
fescc get gpth add add o 11 i
end
fput tputc
end
note paghhas t: the gh file has a 20-byte time under t
fn paghhas t view uchar * to bool
o = paghv t
ret eq get gpr 15 20
end
note paghtm t: the gh time under t as YYYY-MM-DD HH:MM UTC, escaped ("-" when it is not 20 bytes)
fn paghtm t view uchar * to void
o = paghv t
if ne get gpr 15 20
fputc 45
ret
end
for i ulong 10
fescc get gpgh add o i
end
fputc 32
for i ulong 5
fescc get gpgh add add o 11 i
end
fput tputc
end
note paghp t: the gh value under t, HTML-escaped
fn paghp t view uchar * to void
o = paghv t
for i ulong get gpr 15 bound 2048
fescc get gpgh add o i
end
end
note pasjp t: the source.json string after the key text t, HTML-escaped
fn pasjp t view uchar * to void
o = pasjv t
for i ulong get gpr 15 bound 4096
fescc get gpsrc add o i
end
end
note paprov: the provenance text: Imported from GitHub <gho>/<ghr>#<n>, by <login>; a code-only item
note (no GitHub metadata) has no login: Imported from GitHub <gho>/<ghr>#<n> (code only)
note An item with metadata whose gh file names no login ends after the number: no ", by ".
fn paprov to void
fput tpimp1
pasjp tpsjow
fputc 47
pasjp tpsjrp
fputc 35
fnum get gpnum 0
if ne get gpider 0 0
fput tpimp3
ret
end
o = paghv tpghl
if eq get gpr 15 0
ret
end
fput tpimp2
paghp tpghl
end
note pabadge: the status word as a badge, and the word "derived" when the state is derived
fn pabadge to void
s = get gpist 0
if eq s 0
fput tpbok
fput tpwopn
end
if eq s 1
fput tpbbad
fput tpwclo
end
if eq s 2
fput tpbmut
fput tpwmrg
end
fput tpboff
if ne get gpider 0 0
fput tpbder
end
end
note paitl: the title, escaped; "(untitled)" when the item has none
fn paitl to void
if eq get gpttll 0 0
fput tpnotl
ret
end
paesct
end
note paiwhen: " opened YYYY-MM-DD" (gh opened); a code-only item: " imported <date of imported_utc>"
fn paiwhen to void
if ne get gpider 0 0
fput tpiwi
o = pasjv tpsjutc
if ge get gpr 15 10
for i ulong 10
fescc get gpsrc add o i
end
else
fputc 45
end
ret
end
fput tpiwo
o = paghv tpgho
if eq get gpr 15 20
for i ulong 10
fescc get gpgh add o i
end
else
fputc 45
end
end
note pairow: the list row of an imported item: title link, badge, id, date, provenance; no counts
fn pairow to void
fput tphli
papath
fput tphq
paitl
fput tphae
fput tpir1
pabadge
fput tpir2
paputid
fput tphcodz
paiwhen
fput tphm3
paprov
fput tphm4
end
note ---- the page of an imported item
note paitms: the opened, closed and merged times of the gh file (none for a code-only item)
fn paitms to void
if ne get gpider 0 0
ret
end
fput tpito
paghtm tpgho
if paghhas tpghc
fput tpitc
paghtm tpghc
end
if paghhas tpghm
fput tpitm
paghtm tpghm
end
end
note pailabs: "Labels: a, b" from the labels file (one per line; its first 65536 bytes)
fn pailabs to void
n = pafrd tpflb 65536
if eq n 0
ret
end
fput tpipm
fput tpilab
for i ulong n bound 65536
c = get fxo i
if eq c 10
if lt add i 1 n
fputc 44
fputc 32
end
else
fescc c
end
end
fput tpipe
end
note parchsp s n: the index of the first space of gpln at or after s, n when there is none (n is at
note most 255)
fn parchsp s ulong n ulong to ulong
q = s
while lt q n bound 257
if eq get gpln q 32
break
end
q = add q 1
end
ret q
end
note parchw a t: gpln[0, a) is t
fn parchw a ulong t view uchar * to bool
if ne a len t
ret false
end
for i ulong a bound 16
if ne get gpln i get t i
ret false
end
end
ret true
end
note parchld: the reach file of item gpid ("<reachable|not-reachable|unknown> <main sha|-> <utc>\n")
note into gpln: 1 reachable, 2 not-reachable, 3 unknown, 0 when there is none or it is not that
note line. The main sha is at gpr 12 (length gpr 13: 40, or 0 for "-"), the observation time at
note gpr 14 (length gpr 15: 1..32 bytes).
fn parchld to ulong
papid tpfrc
r = pards
if or lt r 5 gt r 255
ret 0
end
n = get gplnl 0
if ne get gpln sub n 1 10
ret 0
end
a = parchsp 0 n
if ge a n
ret 0
end
b = parchsp add a 1 n
if ge b n
ret 0
end
w = ulong 0
if parchw a tprch1
w = 1
end
if parchw a tprch2
w = 2
end
if parchw a tprch3
w = 3
end
if eq w 0
ret 0
end
m = sub sub b a 1
put gpr 12 add a 1
put gpr 13 0
if eq m 40
for i ulong 40
if lt sohexv get gpln add add a 1 i 0
ret 0
end
end
put gpr 13 40
else
if ne m 1
ret 0
end
if ne get gpln add a 1 45
ret 0
end
end
u = sub sub n b 2
if or lt u 1 gt u 32
ret 0
end
put gpr 14 add b 1
put gpr 15 u
ret w
end
note paimrg: a merged item with GitHub metadata: the merge commit (the merged file) and what the
note importer observed about this project's main (the reach file)
fn paimrg to void
papid tpfmg
r = pards
if not pal40
ret
end
fput tpipm
fput tpimg1
for i ulong 40
fputc get gpln i
end
fput tphcodz
w = parchld
if or eq w 1 eq w 2
if eq w 1
fput tpimr1
else
fput tpimr2
end
o = get gpr 12
for i ulong get gpr 13 bound 40
fputc get gpln add o i
end
fput tphcodz
end
if eq w 3
fput tpimr3
end
if ne w 0
fput tpimro
o = get gpr 14
for i ulong get gpr 15 bound 32
fescc get gpln add o i
end
fputc 41
end
fput tpipe
end
note paishas: the base and head commits, and the merge line of a merged item
fn paishas to void
fput tpipm
if ne get gpihb 0 0
fput tpisb
paput40 0
fput tpisb2
else
fput tpisnb
end
fput tpish
paput40 1
fput tphcodz
fput tpipe
if eq get gpist 0 2
paimrg
end
end
note pamd n: render fxo[0, n) using the browse renderer at the project root on its default branch
fn pamd n ulong to void
repo = get fridx 0
branch = get fabo repo
size = get fabl repo
for i ulong size bound 64
put gbref i get fabr add branch i
end
put gbrefl 0 size
put gbmdl 0 0
fput tbart1
brmd 0 n
fput tbart2
end
note papgfit f0 t0: true while the page is at most PAPGMX bytes and no byte was dropped; else the
note output goes back to f0 (and the cut flag to t0), so the caller writes one sentence in place of
note what it rendered and the rest of the page still fits fob
fn papgfit f0 ulong t0 ulong to bool
if and le get fobl 0 PAPGMX eq get fobtr 0 t0
ret true
end
put fobl 0 f0
put fobtr 0 t0
ret false
end
note paidesc: the description as Markdown under "<login> wrote on <time>"; nothing when there is
note none; one sentence when it is over fxo or takes the page over PAPGMX
fn paidesc to void
pafp tpfds
n = frdall
if le n 0
ret
end
huge = ne get fxotr 0 0
f0 = get fobl 0
t0 = get fobtr 0
fput tpibox
if eq get gpider 0 0
paghp tpghl
fput tpiwr
paghtm tpgho
else
fput tpidsc
end
fput tpipe
if huge
fput tpidbig
else
pamd ulong n
end
fput tphdv
if not papgfit f0 t0
fput tpidbig
end
end
note paibox: the parsed record (gpr) as a box: login (text), what it is, time, the body as Markdown
fn paibox to void
k = get gpr 0
fput tpibox
patraw 3
if eq k 1
fput tpiwr
end
if eq k 2
fput tpirv1
patraw 5
fput tpirv2
end
if eq k 3
fput tpirc1
patraw 8
fput tpirc2
fnum get gpr 7
fput tpion
end
pattime
fput tpipe
o = get gpr 10
b = get gpr 11
if gt b 0
for i ulong b bound 16777216
put fxo i get gpth add o i
end
pamd b
end
fput tphdv
end
note paithr: the thread, one box per record. It stops at the first malformed record (one sentence),
note and when a box takes the page over PAPGMX (that box is taken back, one sentence).
fn paithr to void
pathld
p = ulong 0
n = get gpthl 0
while lt p n bound 16777216
p = patrec p
if eq get gpr 0 0
if eq get gpthc 0 0
fput tpitbad
end
break
end
f0 = get fobl 0
t0 = get fobtr 0
paibox
if not papgfit f0 t0
fput tpitcut
break
end
end
if ne get gpthc 0 0
fput tpitbig
end
end
note paiapply: the code box of an mbox-backed item: the "Apply it" lines and raw links of a signed
note patch (no Signature box)
fn paiapply to void
fput tphap1
paputid
if ne get gpihb 0 0
fputc 32
paput40 0
end
fput tphap2
paorig
papath
fput tpsfxp
fput tphap3
papath
fput tpsfxp
fput tphap4
papath
fput tpsfxd
fput tphap5
end
note paibund: the code box of a bundle-backed item: size, the fetch lines, the raw link, and the
note diff link when the diff exists (gpbd 0)
fn paibund to void
fput tpibd1
fnum get gpmby 0
fput tpibd2
paorig
papath
fput tpsfxb
fput tpibd3
paputid
fput tpsfxb
fput tpibd4
paputid
fput tpsfxb
fput tpibd4b
fnum get gpnum 0
fput tpibd5
papath
fput tpsfxb
fput tpibd6
if eq get gpbd 0 0
fput tpibd7
papath
fput tpsfxd
fput tphap5
ret
end
fput tpibd9
end
note paonmn: the loaded imported item is the importer's on-main route: a code-only item (derived
note state) whose state is merged and whose base file names its head commit
fn paonmn to bool
if eq get gpider 0 0
ret false
end
if ne get gpist 0 2
ret false
end
if eq get gpihb 0 0
ret false
end
for i ulong 40
if ne get gpbase i get gphead i
ret false
end
end
ret true
end
note paicode: the Code box. Without a code file only the on-main route says the head is on main (with
note the link to its commit page); any other item says that it holds no code file.
fn paicode to void
k = get gpicode 0
if eq k 1
paiapply
ret
end
if eq k 2
paibund
ret
end
if not paonmn
fput tpicx
ret
end
fput tpicn1
fputrl
fput tphcm
paput40 1
fput tphq
fput tphcode
paput40 1
fput tpicn2
end
note paiprov: the Provenance box: imported, not signed; the statement and source.json, escaped
fn paiprov to void
fput tpipv1
n = pafrd tpfst 65536
fxesc 0 n
fput tphpre
fput tphsg3
for i ulong get gpsrcl 0 bound 4096
fescc get gpsrc i
end
fput tphpre
fput tphdv
end
note paichn t: the Changes heading with one sentence in place of a diff
fn paichn t view uchar * to void
fput tpich
fput t
fput tpipe
end
note pafpp: fpth = gpp, for frdall
fn pafpp to void
fpb
for i ulong get gppl 0 bound 4096
fpc get gpp i
end
end
note paichg: Changes: the stored diff of an mbox, the cached diff of a bundle with a base (gpbd is
note pabdiff's answer), else the sentence that says why there is none
fn paichg to void
k = get gpicode 0
if eq k 1
n = pardf tpfdf
if gt n 0
pashdn n
ret
end
paichn tpicg1
ret
end
if eq k 0
if paonmn
paichn tpicg0
else
paichn tpicg7
end
ret
end
if eq get gpihb 0 0

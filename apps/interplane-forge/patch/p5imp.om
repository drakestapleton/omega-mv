note Cache failed diff work briefly without changing imported data.
global gpbkeys uchar 1024
global gpbexp ulong 64
global gpbslot ulong 1
fn pabbad to bool
now = ulong monons
for slot ulong 64
if gt get gpbexp slot now
same = true
for i ulong 16
if ne get gpbkeys add mul slot 16 i get gpid i
same = false
break
end
end
if same
ret true
end
end
end
ret false
end
fn pabbset to void
slot = get gpbslot 0
for i ulong 16
put gpbkeys add mul slot 16 i get gpid i
end
put gpbexp slot add ulong monons 120000000000
put gpbslot 0 rem add slot 1 64
end
note Skip synchronous diff generation for large bundles. The bundle download stays available.
fn pabbcap to bool
papid tpfbn
if not paexist
ret false
end
ret gt pastsz 134217728
end
note pabdiff: the cache file of the loaded bundle-backed item (gpid, gpbase, gphead) exists, making
note it when it does not: 0 it is there, 1 the base commit is not in the project's git store, 2 the
note diff is over fxo (the marker is left beside the cache, pabbig; with the marker there git is not
note run again: the page and the raw route answer from it), 3 git, the disk or the work folder
note failed. The work folder is removed whatever happened.
fn pabdiff to ulong
papdf
e = paexist
if e
ret 0
end
papdfg
if paexist
ret 2
end
if pabbcap
ret 4
end
if pabbad
ret 3
end
r = pabcat
if lt r 0
pabbset
ret 3
end
if ne r 0
ret 1
end
if not pastem
ret 3
end
w = ulong 3
if pawinit
w = pabrun
end
if not parmtree
flog tplrm
end
if eq w 2
pabbig
end
if eq w 3
pabbset
end
ret w
end
note pabraw: GET <id>.diff of an item that stores no diff file: 0 with gpp = the cache file of the
note bundle diff (made now when it is not there), else the status: 404 (not an item, no bundle, no
note base, the base is not in the git store, the diff is over fxo), 500 (the diff could not be made)
fn pabraw to long
if not paany
ret 404
end
if eq get gpimp 0 0
ret 404
end
if ne get gpicode 0 2
ret 404
end
if eq get gpihb 0 0
ret 404
end
w = pabdiff
if eq w 0
papdf
ret 0
end
if eq w 3
patext
fput tpmdint
ret 500
end
ret 404
end

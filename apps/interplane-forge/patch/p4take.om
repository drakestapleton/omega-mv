note patch/p4take.om: POST /<owner>/<repo>/patches/new. The checks in order, each refusal one line
note of text with nothing kept: session and CSRF (pagate); the repo field and the repository's git
note store; base a commit reachable from the default branch the public list names; sizes and shapes
note of title, description, mbox and sig; the signature by the session's key over the statement; then
note the mbox is applied once on base in a throwaway work tree and, only if that is clean (git itself
note marks no file binary and adds no submodule), stored.
note ---- the mbox scan
note pamln s e t: the line gpmb[s, e) starts with t
fn pamln s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
for i ulong len t bound 64
if ne get gpmb add s i get t i
ret false
end
end
ret true
end
note pafrom: the line is "From <40 lowercase hex> Mon Sep 17 00:00:00 2001", format-patch's first
note line of every commit
fn pafrom s ulong e ulong to bool
if ne sub e s 70
ret false
end
if not pamln s e tpfrom
ret false
end
for i ulong 40
if lt sohexv get gpmb add add s 5 i 0
ret false
end
end
ret pamln add s 45 e tpfrom2
end
fn paeol s ulong n ulong to ulong
j = s
while lt j n bound 4194304
if eq get gpmb j 10
ret j
end
j = add j 1
end
ret n
end
note padd: gpmb[j] and gpmb[j+1] are both a dot, inside [s, e)
fn padd j ulong e ulong to bool
if ge add j 1 e
ret false
end
if ne get gpmb j 46
ret false
end
ret eq get gpmb add j 1 46
end
note pasep: the byte bounds a path segment (/, space, quote)
fn pasep c uchar to bool
ret or or eq c 47 eq c 32 eq c 34
end
note paddseg j s e: the ".." at gpmb[j] is a whole segment of the path part gpmb[s, e): the byte
note before it (when there is one) and the byte after it (when there is one) each bound a segment
fn paddseg j ulong s ulong e ulong to bool
if gt j s
if not pasep get gpmb sub j 1
ret false
end
end
if lt add j 2 e
ret pasep get gpmb add j 2
end
ret true
end
note paout s e: the path part gpmb[s, e) of a diff header names a way out of the repository: a ".."
note segment, an empty segment (//) or a leading /
fn paout s ulong e ulong to bool
if ge s e
ret false
end
if eq get gpmb s 47
ret true
end
j = s
while lt j e bound 4194304
if padd j e
if paddseg j s e
ret true
end
end
if eq get gpmb j 47
if lt add j 1 e
if eq get gpmb add j 1 47
ret true
end
end
end
j = add j 1
end
ret false
end
note padiffl: a line of a diff: 2 a binary patch, 3 a header naming a path outside, else 0
fn padiffl s ulong e ulong to ulong
if pamln s e tpgbp
if eq sub e s len tpgbp
ret 2
end
end
if pamln s e tpbf
ret 2
end
if pamln s e tprnf
if paout add s len tprnf e
ret 3
end
end
if pamln s e tprnt
if paout add s len tprnt e
ret 3
end
end
if pamln s e tpcpf
if paout add s len tpcpf e
ret 3
end
end
if pamln s e tpcpt
if paout add s len tpcpt e
ret 3
end
end
ret 0
end
note pascan: one pass over the lines of the mbox. gpncm = commits (From lines); gpgrd = 2 for a
note binary patch or 3 for a path outside the repository in a diff, else 0. False when the first line
note is not a From line: not format-patch output.
fn pascan to bool
n = get gpmbl 0
put gpncm 0 0
put gpgrd 0 0
s = ulong 0
ind = false
for it ulong 4194304
if ge s n
break
end
e = paeol s n
if pafrom s e
put gpncm 0 add get gpncm 0 1
ind = false
else
if eq s 0
ret false
end
g = ulong 0
if pamln s e tpdg
ind = true
if paout add s len tpdg e
g = 3
end
else
if ind
g = padiffl s e
end
end
if and ne g 0 eq get gpgrd 0 0
put gpgrd 0 g
end
end
s = add e 1
end
ret gt get gpncm 0 0
end
note ---- base
note pabasec: 0 base is a commit on the main branch; else the refusal's status with its text written
fn pabasec to long
fkgit
fka tpcatf
fka tpde
fkopen
pakbase
fkt tpcmt
r = fexec PATMO
if lt r 0
ret parefu 500 tpmint
end
if ne r 0
ret parefu 422 tpmunk
end
fkgit
fka tpgmb
fka tpisa
fkopen
pakbase
fkopen
fkt tprh
i = get fridx 0
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
r = fexec PATMO
if eq r 0
ret 0
end
if eq r 1
ret parefu 422 tpmnotm
end
ret parefu 500 tpmint
end
note ---- the statement and the id
fn pastc c uchar to void
n = get gpstl 0
if lt n 511
put gpst n c
put gpstl 0 add n 1
end
end
fn pasthex h view uchar 32 to void
x = new uchar 64 0
sohex h x
for i ulong 64
pastc get x i
end
pastc 10
end
note pastmt: gpst = "interplane-patch 1\n<owner>/<repo>\n<base>\n<sha256 of the mbox>\n<sha256 of
note title, line feed, description>\n", all hex lowercase; gpid = the first 16 hex of its SHA-256
fn pastmt to void
put gpstl 0 0
for i ulong len tpst1
pastc get tpst1 i
end
for i ulong len tfowner
pastc get tfowner i
end
pastc 47
r = get fridx 0
for k ulong get fanl r bound 128
pastc frnbyte r k
end
pastc 10
for i ulong 40
pastc get gpbase i
end
pastc 10
h = new uchar 32 0
pahs 0 get gpmbl 0 h
pasthex h
pahs 7 add add get gpttll 0 1 get gpdscl 0 h
pasthex h
pahs 1 get gpstl 0 h
x = new uchar 64 0
sohex h x
for i ulong 16
put gpid i get x i
end
end
note ---- the signature: ssh-keygen -Y verify -f <allowed signers> -I forge-user -n interplane-patch
note -s <signature> with the statement on standard input (the argv exec and temp files of the
note sign-in check, social/20crypt.om and 40auth.om). The one allowed signer is the session's key.
note paspk: the ed25519 key of the session's did:key into pk
fn paspk pk edit uchar 32 to bool
d = get gscur 0
o = get gsso d
l = get gssl d
w = len tsdidp
if or le l w gt sub l w 64
ret false
end
z = new uchar 64 0
for i ulong sub l w bound 64
put z i get gsstr add add o w i
end
ret sodidpk part z 0 sub l w pk
end
note pasigw: the three temp files: a allowed signers, s signature, m statement
fn pasigw pk view uchar 32 to bool
al = new uchar 128 0
k = sopkline pk al
if not sotmpw 97 part al 0 k
ret false
end
sg = new uchar 4096 0
n = get gpsigl 0
for i ulong n bound 4096
put sg i get gpsig i
end
if not sotmpw 115 part sg 0 n
ret false
end
m = new uchar 512 0
n = get gpstl 0
for i ulong n bound 512
put m i get gpst i
end
ret sotmpw 109 part m 0 n
end
fn pasigrun to long
sotmpp 109
mfd = fopen gspth 0 get gspthl 0 524288 0
if lt mfd 0
ret -500
end
soavb
soava tssshkg
soava tsY
soava tsverify
soava tsdf
sotmpp 97
soavpth
soava tsdI
soava tsprinc
soava tsdn
soava tpns
soava tsds
sotmpp 115
soavpth
r = sorunv mfd 5000
x = fclose int mfd
if eq r -2
ret -500
end
if eq r -1
ret 1
end
ret r
end
note pasigck: 0 the signature verifies; else the refusal's status with its text written
fn pasigck to long
if not sovlim
ret parefu 429 tpmrate
end
pk = new uchar 32 0
if not paspk pk
ret parefu 500 tpmint
end
st = new uchar 8 0
if not sorand st
ret parefu 500 tpmint
end
for i ulong 8
put gsstem i get st i
end
r = long -500
if pasigw pk
r = pasigrun
end
sotmprm 97
sotmprm 115
sotmprm 109
if eq r 0
ret 0
end
if lt r 0
ret parefu 500 tpmint
end
ret parefu 403 tpmsig
end
note ---- apply once on base in a throwaway work tree
note pastem: gpstm = 16 random hex digits naming this request's work and staging folders
fn pastem to bool
r = new uchar 8 0
if not sorand r
ret false
end
x = new uchar 16 0
sohex r x
for i ulong 16
put gpstm i get x i
end
ret true
end
note pawork: make <data>tmp/pw<stem>/ with the mbox as m and an empty git repository w whose objects
note are borrowed from the repository's store (objects/info/alternates): the store is only read, and
note nothing the patch makes is ever written into it
fn pawork to bool
papb
papt tptmp
x = pamkdir
papw part tpdot 0 0
r = makedir gpp 0 get gppl 0 448
if lt r 0
ret false
end
papw tpwm
if not pawf 0 get gpmbl 0
ret false
end
fkb
fka tfgit
pakc1 tpk17
fka tpinit
fka tpq
fka tptpl
fkopen
papw tpww
pakp
r = fexec PATMO
if ne r 0
ret false
end
palb
papgs
if gt get gppl 0 240
ret false
end
for i ulong get gppl 0 bound 240
palc get gpp i
end
for i ulong len tpobj
palc get tpobj i
end
papw tpwalt
ret pawf 5 get gplnl 0
end
note pahex40: fxo[0, 40) is 40 lowercase hex digits followed by a line feed; copied into gphead
fn pahex40 to bool
if ne get fxol 0 41
ret false
end
for i ulong 40
c = get fxo i
if lt sohexv c 0
ret false
end
put gphead i c
end
ret eq get fxo 40 10
end
note panum: the decimal number in fxo[0, n) before its line feed, 999999999 when it is not one
fn panum to ulong
n = get fxol 0
if or lt n 2 gt n 10
ret 999999999
end
v = ulong 0
for i ulong sub n 1 bound 16
c = get fxo i
if not fisdig c
ret 999999999
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note pabinat s: fxo[s, s+4) is "-\t-\t" (the caller keeps s+4 inside the output)
fn pabinat s ulong to bool
a = and eq get fxo s 45 eq get fxo add s 1 9
b = and eq get fxo add s 2 45 eq get fxo add s 3 9
ret and a b
end
note pabinns: fxo holds `git diff --numstat --no-renames`: a line starts with "-\t-\t", git's mark of
note a binary file. The mbox scan (padiffl) sees only the bytes as sent; git am decodes a mail body
note sent base64 or quoted-printable first, so only git's own view after the apply covers every way in.
fn pabinns to bool
n = get fxol 0
s = ulong 0
for it ulong 16777216
if ge s n
break
end
if le add s 4 n
if pabinat s
ret true
end
end
e = s
while lt e n bound 16777216
if eq get fxo e 10
break
end
e = add e 1
end
s = add e 1
end
ret false
end
note paraw: fxo holds `git diff --raw --no-renames`: gpnfl = its lines (files changed); false when a
note line's new mode is 160000 (a submodule) or a line is not a raw line
fn paraw to bool
n = get fxol 0
c = ulong 0
s = ulong 0
for it ulong 16777216
if ge s n
break
end
if gt add s 14 n
ret false
end
if ne get fxo s 58
ret false
end
if pasubm add s 8
ret false
end
c = add c 1
e = s
while lt e n bound 16777216
if eq get fxo e 10
break
end
e = add e 1
end
s = add e 1
end
put gpnfl 0 c
ret true
end
note pasubm: fxo[p, p+6) is the mode 160000
fn pasubm p ulong to bool
if ne get fxo p 49
ret false
end
if ne get fxo add p 1 54
ret false
end
for i ulong 4
if ne get fxo add add p 2 i 48
ret false
end
end
ret true
end
note pakrange: one argument "<base>..HEAD"
fn pakrange to void
fkopen
pakbase
fkt tpdots
fkt tphead
end
note paapply2: the git runs in the work tree: read-tree base, HEAD at base, am, then head, commit
note count, raw diff (files, submodules), numstat (binary files) and the full diff left in fxo. 0, or
note the refusal's status.
fn paapply2 to long
pakwt
fka tprdt
fkopen
pakbase
r = fexec PATMO
if ne r 0
ret parefu 500 tpmint
end
pakwt
fka tpupr
fka tpnod
fka tphead
fkopen
pakbase
r = fexec PATMO
if ne r 0
ret parefu 500 tpmint
end
pakwt
fka tpam
fka tpqq
fka tpamd
fka tpamk
fka tpamn
fka tpam3
fkopen
papw tpwm
pakp
r = fexec PATMO
if ne r 0
ret parefu 422 tpmappl
end
pakwt
fka tprevp
fka tphead
r = fexec PATMO
if ne r 0
ret parefu 500 tpmint
end
if not pahex40
ret parefu 500 tpmint
end
pakwt
fka tprevl
fka tpcnt
pakrange
r = fexec PATMO
if ne r 0
ret parefu 500 tpmint
end
if ne panum get gpncm 0
ret parefu 422 tpmcnt
end
ret paapply3
end
fn paapply3 to long
pakwt
fka tpdiff
fka tpraw
fka tpnorn
fkopen
pakbase
fka tphead
r = fexec PATMO
if or ne r 0 ne get fxotr 0 0
ret parefu 500 tpmint
end
if not paraw
ret parefu 422 tpmsub
end
pakwt
fka tpdiff
fka tpnumst
fka tpnorn
fkopen
pakbase
fka tphead
r = fexec PATMO
if or ne r 0 ne get fxotr 0 0
ret parefu 500 tpmint
end
if pabinns
ret parefu 422 tpmbin
end
pakwt
fka tpdiff
fka tpfull
fka tpdM
fkopen
pakbase
fka tphead
r = fexec PATMO
if ne r 0
ret parefu 500 tpmint
end
if ne get fxotr 0 0
ret parefu 413 tpmdbig
end
ret 0
end
note ---- the store: <data>patches/<owner>/<repo>/<id>/ with mbox, statement, signature, head,
note status, title, description, meta and diff. Written into a staging folder beside it and renamed
note into place, so an id folder is always whole and is never written again; the repository's index
note file gets one line "<id>\n" per patch, appended.
fn pamkst to bool
papb
papt tpsdir
if not pamkdir
ret false
end
papt tfowner
if not pamkdir
ret false
end
papc 47
paprn
if not pamkdir
ret false
end
papnew part tpdot 0 0
r = makedir gpp 0 get gppl 0 448
ret ge r 0
end
note pameta: the meta file's six lines: author DID, creation time (s), commits, files, mbox bytes,
note mbox SHA-256 (the statement's fourth line)
fn pameta to bool
palb
d = get gscur 0
o = get gsso d
for i ulong get gssl d bound 128
palc get gsstr add o i
end
palc 10
paln get gsnow 0
palc 10
paln get gpncm 0
palc 10
paln get gpnfl 0
palc 10
paln get gpmbl 0
palc 10
n = get gpstl 0
for i ulong 64
palc get gpst add sub n 130 i
end
palc 10
papnew tpfme
ret pawf 5 get gplnl 0
end
note pahdln: gpln = the head commit and a line feed
fn pahdln to void
palb
for i ulong 40
palc get gphead i
end
palc 10
end
note pawall9: the nine files into the staging folder; the diff is fxo[0, fxol) (paapply3 left it)
fn pawall9 to bool
papnew tpfdf
if not pawf 6 get fxol 0
ret false
end
papnew tpfmb
if not pawf 0 get gpmbl 0
ret false
end
papnew tpfst
if not pawf 1 get gpstl 0
ret false
end
papnew tpfsg
if not pawf 2 get gpsigl 0
ret false
end
papnew tpftt
if not pawf 3 get gpttll 0
ret false
end
papnew tpfds
if not pawf 4 get gpdscl 0
ret false
end
if not pameta
ret false
end
pahdln
papnew tpfhd
if not pawf 5 get gplnl 0
ret false
end
papnew tpfss
ret pawtxt tpopen
end
note padrop: remove the staging folder and the files it may hold
fn padrop1 t view uchar * to void
papnew t
x = unlink gpp 0 get gppl 0
end
fn padrop to void
padrop1 tpfdf
padrop1 tpfmb
padrop1 tpfst
padrop1 tpfsg
padrop1 tpftt
padrop1 tpfds
padrop1 tpfme
padrop1 tpfhd
padrop1 tpfss
papnew part tpdot 0 0
x = rmdir gpp 0 get gppl 0
end
note paidxhas: the index (read into fxo) lists gpid
fn paidxhas to bool
paprepo
papt tpindex
fpb
for i ulong get gppl 0 bound 4096
fpc get gpp i
end
n = frdall
if lt n 17
ret false
end
for r ulong div ulong n 17 bound 1048576
if paidxeq mul r 17
ret true
end
end
ret false
end
fn paidxeq o ulong to bool
for i ulong 16
if ne get fxo add o i get gpid i
ret false
end
end
ret true
end
note paidxadd: append "<id>\n" to the index (created 0600), written through
fn paidxadd to bool
paprepo
papt tpindex
fd = fopen gpp 0 get gppl 0 558145 384
if lt fd 0
ret false
end
b = new uchar 4096 0
for i ulong 16
put b i get gpid i
end
put b 16 10
ok = pawall int fd b 17
s = fsync int fd
x = fclose int fd
ret and ok ge s 0
end
note pakeep: staging folder -> <id>/ (rename), then the index line. false when nothing was kept.
fn pakeep to bool
if not pamkst
ret false
end
if not pawall9
padrop
ret false
end
soavb
papnew part tpdot 0 0
paavp
papid part tpdot 0 0
paavp
r = renames gspk 0 get gspkl 0 1
if lt r 0
padrop
ret false
end
x = paidxadd
ret true
end
note paavp: one record of the packed list gspk (social/20crypt.om) holding gpp without a final /
fn paavp to void
soavopen
n = get gppl 0
if gt n 0
if eq get gpp sub n 1 47
n = sub n 1
end
end
for i ulong n bound 4096
soavc get gpp i
end
end
note paok st w: the text answer of a kept (201, "accepted") or already known (200, "exists") patch:
note its id and the path of its page
fn paok st ulong w view uchar * to long
patext
fput w
fput tpaid
for i ulong 16
fputc get gpid i
end
fputc 10
fput tpapth
fputrl
fput tppats
fputc 47
for i ulong 16
fputc get gpid i
end
fputc 10
ret long st
end
note paapply: work folder, the git runs, the store; the work folder is removed whatever happened
fn paapply to long
if not pastem
ret parefu 500 tpmint
end
r = long 0
if pawork
r = paapply2
else
r = parefu 500 tpmint
end
kept = false
if eq r 0
kept = pakeep
end
if not parmtree
flog tplrm
end
if ne r 0
ret r
end
if not kept
ret parefu 503 tpmwr
end
ret paok 201 tpacc
end
note pasizes: title, description, mbox and sig, each to its own global; 0 or the refusal
fn pasizes to long
if not patitle
ret parefu 400 tpmttl
end
if not padescr
ret parefu 400 tpmdsc
end
r = pambdec
if eq r 413
ret parefu 413 tpmbig
end
if ne r 0
ret parefu 400 tpmb64
end
if not pascan
ret parefu 400 tpmnfp
end
if gt get gpncm 0 100
ret parefu 413 tpmmany
end
if not pasigin
ret parefu 400 tpmsigf
end
ret 0
end
note patake: POST /<owner>/<repo>/patches/new
fn patake to long
r = pagate
if ne r 0
ret r
end
if not pafall
ret parefu 400 tpmform
end
if not parepok
ret parefu 400 tpmrepo
end
papgs
if not paexist
ret parefu 404 tpmnogs
end
if not pabasef
ret parefu 400 tpmbase
end
r = pabasec
if ne r 0
ret r
end
r = pasizes
if ne r 0
ret r
end
pastmt
r = pasigck
if ne r 0
ret r
end
papid part tpdot 0 0
if paexist
if not paidxhas
x = paidxadd
end
ret paok 200 tpexi
end
if eq get gpgrd 0 2
ret parefu 422 tpmbin
end
if eq get gpgrd 0 3
ret parefu 422 tpmpath
end
ret paapply
end

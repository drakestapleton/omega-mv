note patch/p5page.om: reading the store back, the HTML pages (list, one patch, how to open one) and
note the raw routes (.patch: the stored mbox bytes; .diff: the diff the forge made when it applied them).
note ---- reading a stored patch
note pafp t: fpth = the file <t> of patch gpid, for frdall
fn pafp t view uchar * to void
papid t
fpb
for i ulong get gppl 0 bound 4096
fpc get gpp i
end
end
note pamnum: the decimal number at fxo[gpcur] up to its line feed; gpcur moves past the line feed;
note gpbad is set when it is not 1..18 digits followed by a line feed
fn pamnum to ulong
p = get gpcur 0
n = get fxol 0
v = ulong 0
k = ulong 0
while lt p n bound 32
c = get fxo p
if eq c 10
break
end
if or not fisdig c ge k 18
put gpbad 0 1
ret 0
end
v = add mul v 10 ulong sub c 48
k = add k 1
p = add p 1
end
if or eq k 0 ge p n
put gpbad 0 1
end
put gpcur 0 add p 1
ret v
end
note pameld: the meta file into gpmdid, gpmts, gpmcm, gpmfl, gpmby, gpmsha
fn pameld to bool
pafp tpfme
n = frdall
if or lt n 80 gt n 250
ret false
end
e = ulong 0
while lt e ulong n bound 256
if eq get fxo e 10
break
end
e = add e 1
end
if or lt e 9 gt e 120
ret false
end
for i ulong e bound 128
put gpmdid i get fxo i
end
put gpmdidl 0 e
put gpbad 0 0
put gpcur 0 add e 1
put gpmts 0 pamnum
put gpmcm 0 pamnum
put gpmfl 0 pamnum
put gpmby 0 pamnum
p = get gpcur 0
if or ne get gpbad 0 0 ne add p 65 ulong n
ret false
end
for i ulong 64
put gpmsha i get fxo add p i
end
ret true
end
note pastld: the statement into gpst and its base line into gpbase (the statement ends with base,
note line feed, two lines of 64 hex and a line feed each: the base is 171 bytes before the end)
fn pastld to bool
pafp tpfst
n = frdall
if or lt n 180 gt n 511
ret false
end
for i ulong ulong n bound 512
put gpst i get fxo i
end
put gpstl 0 ulong n
o = sub ulong n 171
for i ulong 40
c = get fxo add o i
if lt sohexv c 0
ret false
end
put gpbase i c
end
ret true
end
note paload: patch gpid of this repository into the globals; false when it is not a whole stored patch
fn paload to bool
if not pameld
ret false
end
pafp tpftt
n = frdall
if or lt n 1 gt n 256
ret false
end
for i ulong ulong n bound 256
put gpttl i get fxo i
end
put gpttll 0 ulong n
if not pastld
ret false
end
pafp tpfhd
n = frdall
if lt n 0
ret false
end
ret pahex40
end
note pardf t: the file <t> of patch gpid into fxo; its length, 0 when it cannot be read
fn pardf t view uchar * to ulong
pafp t
n = frdall
if lt n 0
ret 0
end
ret ulong n
end
note ---- pieces
note padid: the social store's id of the author DID in gpmdid, 0 when it holds no such account
fn padid to ulong
sokclr
for i ulong get gpmdidl 0 bound 128
sokc get gpmdid i
end
ret sofind
end
note paauth: the author as the pages show an account (its name linked, else the shortened DID
note linked; social/50route.om souser); the full DID in code when the store has no such account
fn paauth to void
d = padid
if ne d 0
souser d
ret
end
fput tphcode
for i ulong get gpmdidl 0 bound 128
fescc get gpmdid i
end
fput tphcodz
end
fn paputid to void
for i ulong 16
fputc get gpid i
end
end
note papath: the page path of patch gpid: <base><owner>/<repo>/patches/<id>
fn papath to void
fputrl
fput tppats
fputc 47
paputid
end
fn paput40 w ulong to void
for i ulong 40
if eq w 0
fputc get gpbase i
else
fputc get gphead i
end
end
end
note pacnts: "N commits &middot; M files"
fn pacnts to void
c = get gpmcm 0
fnum c
if eq c 1
fput tphc1
else
fput tphc2
end
fput tphm3
f = get gpmfl 0
fnum f
if eq f 1
fput tphf1
else
fput tphf2
end
end
fn paesct to void
for i ulong get gpttll 0 bound 256
fescc get gpttl i
end
end
note ---- the list: the index file holds one line "<16 hex>\n" per patch, oldest first; a page shows
note 30, newest first
note paidxn: the index into fxo; the number of patches
fn paidxn to ulong
paprepo
papt tpindex
fpb
for i ulong get gppl 0 bound 4096
fpc get gpp i
end
n = frdall
if lt n 0
ret 0
end
if ne get fxotr 0 0
fincut
end
ret div ulong n 17
end
note pacount: the patches the store holds for the repository fridx (growth/g1prep.om grpatch)
fn pacount to ulong
ret paidxn
end
note papage: the ?page= number, 1 when absent or not a number of 1 to 9 digits above zero
fn papage to ulong
n = fqget tpqpage
if or lt n 1 gt n 9
ret 1
end
v = ulong 0
for i ulong ulong n bound 9
c = get fval i
if not fisdig c
ret 1
end
v = add mul v 10 ulong sub c 48
end
if eq v 0
ret 1
end
ret v
end
note papick: the ids of page pg (of tot patches in fxo) into gpids, newest first; how many
fn papick tot ulong pg ulong to ulong
a = mul sub pg 1 30
c = ulong 0
for j ulong 30
k = add a j
if ge k tot
break
end
o = mul sub sub tot 1 k 17
for i ulong 16
put gpids add mul c 16 i get fxo add o i
end
c = add c 1
end
ret c
end
note paidset: gpid = row j of gpids; false when it is not 16 lowercase hex
fn paidset j ulong to bool
for i ulong 16
c = get gpids add mul j 16 i
if lt sohexv c 0
ret false
end
put gpid i c
end
ret true
end
fn parow to void
fput tphli
papath
fput tphq
paesct
fput tphae
fput tphm1
paputid
fput tphm2
fjday get gpmts 0
fput tphby
paauth
fput tphm3
pacnts
fput tphm4
end
fn papgln pg ulong t view uchar * to void
fput tph2
fputrl
fput tphqp
fnum pg
fput t
end
fn palist to long
tot = paidxn
pg = papage
pages = div add tot 29 30
if eq pages 0
pages = 1
end
if gt pg pages
ret 404
end
cnt = papick tot pg
if fjwant
ret pajlist tot pg pages cnt
end
fyalt
fsetti tptlist
frepohd 5
fput tph1
fnum tot
if eq tot 1
fput tph1a
else
fput tph1b
end
fput tph2
fputrl
fput tph2n
if eq tot 0
fput tphnone
ret 200
end
fput tphul
for j ulong cnt bound 30
if paidset j
if paload
parow
end
end
end
fput tphule
fput tphpg1
if gt pg 1
papgln sub pg 1 tphpgn
end
if lt pg pages
papgln add pg 1 tphpgo
end
fput tphpg2
ret 200
end
note ---- one patch
fn paorig to void
if eq get fbasel 0 1
fput tppor1
ret
end
fput tppor2
end
note patitl: the page title: the patch title when it is at most 200 bytes, else "Patches"
fn patitl to void
n = get gpttll 0
if gt n 200
fsetti tptlist
ret
end
put ftil 0 0
for i ulong n bound 200
ftic get gpttl i
end
end
note pashdf: the diff, at most 400000 bytes of it cut at a line's end, with a note when it is cut
fn pashdf to void
n = pardf tpfdf
if eq n 0
ret
end
m = n
if gt n 400000
m = ulong 400000
for it ulong 400000
if eq m 0
break
end
if eq get fxo sub m 1 10
break
end
m = sub m 1
end
end
fput tphdf1
fxesc 0 m
fput tphpre
if lt m n
fput tphdfc
end
end
fn pashow2 to void
fput tphap1
paputid
fputc 32
paput40 0
fput tphap2
paorig
papath
fput tpsfxp
fput tphap3
papath
fput tpsfxp
fput tphap4
papath
fput tpsfxd
fput tphap5
fput tphsg1
for i ulong get gpmdidl 0 bound 128
fescc get gpmdid i
end
fput tphsg2
for i ulong get gpstl 0 bound 512
fescc get gpst i
end
fput tphpre
n = pardf tpfsg
fput tphsg3
fxesc 0 n
fput tphpre
fput tphdv
pashdf
end
fn pashow to long
if not paload
ret 404
end
if fjwant
ret pajone
end
fyalt
patitl
frepohd 5
fput tphp1
paesct
fput tphp2
paputid
fput tphm2
fjday get gpmts 0
fput tphby
paauth
fput tphp3
pacnts
fput tphm3
fnum get gpmby 0
fput tphp4
fputrl
fput tphcm
paput40 0
fput tphq
fput tphcode
paput40 0
fput tphp5
paput40 1
fput tphp6
n = pardf tpfds
if gt n 0
fput tphds1
fxesc 0 n
fput tphpre
end
pashow2
ret 200
end
note panewpg: GET .../patches/new: how to open a patch (the upload itself is the POST)
fn panewpg to long
fsetti tptnew
frepohd 5
fput tphn1
fput tfowner
fputc 47
fputrnm
fput tphn2
ret 200
end
note ---- raw: w 0 <id>.patch (the mbox as it was sent), 1 <id>.diff. Streamed from the store (kind 3)
note as text/plain under the sandbox policy; no JSON form.
fn paraws w ulong to long
if eq w 0
papid tpfmb
else
papid tpfdf
end
if not paexist
ret 404
end
put ffilel 0 0
for i ulong get gppl 0 bound 4096
ffilc get gpp i
end
put fobl 0 0
put fkind 0 3
fsetct tpctxt
fsetsbx
ret 200
end

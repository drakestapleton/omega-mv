note patch/p2base.om: the path builder, the byte sources and SHA-256 over them, file writes, the git
note argument lists and the remover of a request's work folder.
const PATMO long 20000000000
note ---- path builder gpp (host words take the global directly)
fn papc c uchar to void
n = get gppl 0
if lt n 4095
put gpp n c
put gppl 0 add n 1
end
end
fn papt t view uchar * to void
for i ulong len t bound 4096
papc get t i
end
end
note papb: gpp = <data>
fn papb to void
put gppl 0 0
papt tfdata
end
note paprn: the repository's name (the public-list row fridx) appended to gpp
fn paprn to void
i = get fridx 0
for k ulong get fanl i bound 128
papc frnbyte i k
end
end
note paprepo: gpp = <data>patches/<owner>/<repo>/
fn paprepo to void
papb
papt tpsdir
papt tfowner
papc 47
paprn
papc 47
end
note papid t: gpp = <data>patches/<owner>/<repo>/<gpid>/<t>
fn papid t view uchar * to void
paprepo
for k ulong 16
papc get gpid k
end
papc 47
papt t
end
note papnew t: gpp = <data>patches/<owner>/<repo>/.new-<gpstm>/<t>, this request's staging folder
fn papnew t view uchar * to void
paprepo
papt tpnewd
for k ulong 16
papc get gpstm k
end
papc 47
papt t
end
note papw t: gpp = <data>tmp/pw<gpstm><t>, this request's work folder (t is empty or starts with /)
fn papw t view uchar * to void
papb
papt tptmp
papt tppw
for k ulong 16
papc get gpstm k
end
papt t
end
note papgs: gpp = <store>projects/<name>/repo.git, the repository's bare git store, built by the
note store's own path builder (store/repos.om xspproj, as xsfolders does) in fpth and copied
fn papgs to void
xspproj get fridx 0
fpt tfsrg
put gppl 0 0
for i ulong get fpthl 0 bound 4096
papc get fpth i
end
end
note paexist: the path in gpp exists
fn paexist to bool
r = stat gpp 0 get gppl 0 fstb 0 128
ret ge r 0
end
note pamkdir: make the folder gpp (0700); true when it exists afterwards
fn pamkdir to bool
r = makedir gpp 0 get gppl 0 448
if ge r 0
ret true
end
ret paexist
end
note ---- byte sources. pasb w i: byte i of source w: 0 the mbox, 1 the statement, 2 the signature,
note 3 the title, 4 the description, 5 the line buffer, 6 fxo, 7 title + line feed + description
fn pasb w ulong i ulong to uchar
if eq w 0
ret get gpmb i
end
if eq w 1
ret get gpst i
end
if eq w 2
ret get gpsig i
end
if eq w 3
ret get gpttl i
end
if eq w 4
ret get gpdsc i
end
if eq w 5
ret get gpln i
end
if eq w 6
ret get fxo i
end
ret patd i
end
fn patd i ulong to uchar
n = get gpttll 0
if lt i n
ret get gpttl i
end
if eq i n
ret uchar 10
end
ret get gpdsc sub sub i n 1
end
note pahs w n o: o = SHA-256 of the first n bytes of source w
fn pahs w ulong n ulong o edit uchar 32 to void
c = new ulong 40 0
b = new uchar 4096 0
sha256_init c
p = ulong 0
while lt p n bound 16777216
k = hmin sub n p 4096
for i ulong k bound 4096
put b i pasb w add p i
end
sha256_update c part b 0 k
p = add p k
end
sha256_final c o
end
note ---- the line buffer gpln
fn palb to void
put gplnl 0 0
end
fn palc c uchar to void
n = get gplnl 0
if lt n 255
put gpln n c
put gplnl 0 add n 1
end
end
fn paln v ulong to void
d = new uchar 20 0
k = sodec v d
for i ulong k bound 20
palc get d i
end
end
note ---- files
note pawall: all k bytes of b to fd
fn pawall fd int b view uchar 4096 k ulong to bool
q = ulong 0
for it ulong 8192
if ge q k
ret true
end
r = write fd b q sub k q
if le r 0
if ne r -4
ret false
end
else
q = add q ulong r
end
end
ret false
end
note pawf w n: create the file gpp (exclusive, 0600, no link followed) holding the first n bytes of
note source w, written through to the disk before it is closed
fn pawf w ulong n ulong to bool
fd = fopen gpp 0 get gppl 0 557249 384
if lt fd 0
ret false
end
b = new uchar 4096 0
p = ulong 0
ok = true
while lt p n bound 16777216
k = hmin sub n p 4096
for i ulong k bound 4096
put b i pasb w add p i
end
if not pawall int fd b k
ok = false
break
end
p = add p k
end
if ok
s = fsync int fd
if lt s 0
ok = false
end
end
x = fclose int fd
ret ok
end
note pawtxt t: the file gpp holding the text t
fn pawtxt t view uchar * to bool
palb
for i ulong len t bound 255
palc get t i
end
ret pawf 5 get gplnl 0
end
note ---- git argument lists (server/util.om fkb / fka / fkopen / fkc, run by fexec: no shell, empty
note environment, standard input and error /dev/null)
fn pakp to void
for i ulong get gppl 0 bound 4096
fkc get gpp i
end
end
fn pakbase to void
for i ulong 40
fkc get gpbase i
end
end
fn pakc1 t view uchar * to void
fka tpc
fka t
end
note pakwt: argv = git -C <work folder>/w -c <setting> ... for every git run in the throwaway work tree
fn pakwt to void
fkb
fka tfgit
fka tpdC
fkopen
papw tpww
pakp
pakc1 tpk1
pakc1 tpk2
pakc1 tpk3
pakc1 tpk4
pakc1 tpk5
pakc1 tpk6
pakc1 tpk7
pakc1 tpk8
pakc1 tpk9
pakc1 tpk10
pakc1 tpk11
pakc1 tpk12
pakc1 tpk13
pakc1 tpk14
pakc1 tpk15
pakc1 tpk16
end
note ---- the work folder remover. git fills <data>tmp/pw<stem>/ with the files and folders a patch
note names, so nothing about their names, depth or kind is assumed. A forked child changes into the
note folder and removes by relative name from the inside: a file, link or other entry is unlinked, an
note empty folder removed, and a folder that is not empty is entered through a descriptor opened with
note no-follow (a link is never entered) and emptied first. No path is built, so no path length or
note depth limits it, and it only ever steps back up as often as it stepped down.
fn parmnl o ulong to ulong
k = ulong 0
while lt k 256 bound 256
if eq get gpde add o k 0
ret k
end
k = add k 1
end
ret k
end
note parmdot: the entry name at o is . or ..
fn parmdot o ulong nl ulong to bool
if eq nl 1
ret eq get gpde o 46
end
if eq nl 2
if eq get gpde o 46
ret eq get gpde add o 1 46
end
end
ret false
end
note parment: remove the entry at o (type ty, 4 a folder): 1 removed, 2 entered it, 3 cannot
fn parment o ulong nl ulong ty uchar to ulong
r = long 0
if ne ty 4
r = unlink gpde o nl
if ge r 0
ret 1
end
if ne r -21
ret 3
end
end
r = rmdir gpde o nl
if ge r 0
ret 1
end
fd = fopen gpde o nl 573440 0
if lt fd 0
ret 3
end
r = fchdir int fd
x = fclose int fd
if lt r 0
ret 3
end
ret 2
end
note parmscan: one pass over the folder open as fd: 0 it is empty, 1 entries were removed (scan again),
note 2 entered a folder, 3 an entry could not be removed
fn parmscan fd int to ulong
seen = ulong 0
for it ulong 1000000
n = getdnts fd gpde 0 32768
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 32768
rl = or ulong get gpde add p 16 shl ulong get gpde add p 17 8
if eq rl 0
ret 3
end
nl = parmnl add p 19
if not parmdot add p 19 nl
seen = add seen 1
r = parment add p 19 nl get gpde add p 18
if ge r 2
ret r
end
end
p = add p rl
end
end
if gt seen 0
ret 1
end
ret 0
end
note parmch: the child: empty the current folder and everything below it, then exit 0
fn parmch to void
dep = ulong 0
for it ulong 4000000000
fd = fopen tpdot 0 1 540672 0
if lt fd 0
exit 3
end
st = parmscan int fd
x = fclose int fd
if eq st 3
exit 4
end
if eq st 2
dep = add dep 1
end
if eq st 0
if eq dep 0
exit 0
end
r = chdir tpdd 0 2
if lt r 0
exit 5
end
dep = sub dep 1
end
end
exit 6
end
note parmtree: remove this request's work folder and all it holds (30 s, then the child is killed)
fn parmtree to bool
papw part tpdot 0 0
pid = fork
if lt pid 0
ret false
end
if eq pid 0
r = chdir gpp 0 get gppl 0
if lt r 0
exit 2
end
parmch
exit 0
end
dl = add long monons 30000000000
st = freap int pid dl
papw part tpdot 0 0
q = rmdir gpp 0 get gppl 0
ret and eq st 0 ge q 0
end

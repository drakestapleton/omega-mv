note patch/p3gate.om: the upload form in fbig (server/main.om freqbig), the write gate, the text
note answers, and the field decoders.
note ---- text answers (kind 1, text/plain)
fn patext to void
put fobl 0 0
put fkind 0 1
fsetct tpctxt
end
note parefu: "refused: <reason>" with status st
fn parefu st ulong t view uchar * to long
patext
fput tprefu
fput t
fputc 10
ret long st
end
note ---- the form: name=value pairs joined by &, each of the seven names once, nothing else
fn pafis s ulong e ulong t view uchar * to bool
if ne sub e s len t
ret false
end
for i ulong len t bound 16
if ne get fbig add s i get t i
ret false
end
end
ret true
end
note pafidx: the index of the field name fbig[s, e), 9 when it is none of the seven
fn pafidx s ulong e ulong to ulong
if pafis s e tpfcsrf
ret 0
end
if pafis s e tpfrepo
ret 1
end
if pafis s e tpfbase
ret 2
end
if pafis s e tpfttl
ret 3
end
if pafis s e tpfdsc
ret 4
end
if pafis s e tpfmbx
ret 5
end
if pafis s e tpfsig
ret 6
end
ret 9
end
note pafend s n c: the first index in [s, n) holding c or &, else n
fn pafend s ulong n ulong c uchar to ulong
j = s
while lt j n bound 4194304
b = get fbig j
if or eq b c eq b 38
ret j
end
j = add j 1
end
ret n
end
note paparse: split fbig into the fields; false for a pair without =, an unknown name or a name twice
fn paparse to bool
for k ulong 8
put gpfo k 0
put gpfn k 0
put gpfs k 0
end
n = get fbigl 0
s = ulong 0
for it ulong 16
if ge s n
ret true
end
e = pafend s n 61
if ge e n
ret false
end
if ne get fbig e 61
ret false
end
a = pafend add e 1 n 38
k = pafidx s e
if eq k 9
ret false
end
if ne get gpfs k 0
ret false
end
put gpfo k add e 1
put gpfn k sub a add e 1
put gpfs k 1
s = add a 1
end
ret false
end
note pafall: all seven fields are present
fn pafall to bool
for k ulong 7
if eq get gpfs k 0
ret false
end
end
ret true
end
note padec k cap: field k percent-decoded (+ is a space) into gpfv (65536 bytes);
note the length, or -1 when an escape is malformed or the value is longer than cap (cap <= 65536)
fn padec k ulong cap ulong to long
o = get gpfo k
n = get gpfn k
j = ulong 0
m = ulong 0
while lt j n bound 4194304
c = get fbig add o j
j = add j 1
if eq c 43
c = uchar 32
end
if eq c 37
if gt add j 2 n
ret -1
end
h = fhexv get fbig add o j
l = fhexv get fbig add add o j 1
if or lt h 0 lt l 0
ret -1
end
c = uchar add mul h 16 l
j = add j 2
end
if ge m cap
ret -1
end
put gpfv m c
m = add m 1
end
ret long m
end
note ---- the write gate: the gate of every forge write (social/40auth.om sowpre: CSRF token 403,
note store off 503, 30 writes a minute an address and a key 429), with two differences an uploading
note program needs: signed out is 403 here, not a redirect to the sign-in page, and every answer is
note one line of text. sowpre reads the token from the form body fbody, which is empty on this route
note (the body is in fbig), so the csrf field is handed to it there.
fn pacsrf to bool
if eq get gpfs 0 0
ret false
end
if ne get gpfn 0 32
ret false
end
o = get gpfo 0
for i ulong len tpcsrfe
put fbody i get tpcsrfe i
end
for i ulong 32
put fbody add len tpcsrfe i get fbig add o i
end
put fbodyl 0 add len tpcsrfe 32
ret true
end
fn pagate to long
if eq get gscur 0 0
ret parefu 403 tpm403
end
if not paparse
ret parefu 400 tpmform
end
if not pacsrf
ret parefu 403 tpmcsrf
end
r = sowpre
put fbodyl 0 0
if eq r 0
soratev get gscur 0 get gsnow 0
ret 0
end
if eq r 429
ret parefu 429 tpmrate
end
if eq r 503
ret parefu 503 tpmoff
end
ret parefu 403 tpmcsrf
end
note paunl: POST /<owner>/<x>/patches/new where x is not a public repository (server/route.om asks
note before its 404): the gate first, then 404 in text. 0 = not that request.
fn paunl to long
if ne get fmeth 0 3
ret 0
end
if not frsteq tppnew
ret 0
end
r = pagate
if ne r 0
ret r
end
ret parefu 404 tpmnorp
end
note ---- field checks (after the gate)
note parepok: the repo field is exactly <owner>/<name> of the request path
fn parepok to bool
n = padec 1 256
if lt n 0
ret false
end
i = get fridx 0
l = get fanl i
w = len tfowner
if ne ulong n add add w 1 l
ret false
end
for k ulong w bound 64
if ne get gpfv k get tfowner k
ret false
end
end
if ne get gpfv w 47
ret false
end
for k ulong l bound 128
if ne get gpfv add add w 1 k frnbyte i k
ret false
end
end
ret true
end
note pabasef: the base field is 40 lowercase hex digits; copied into gpbase
fn pabasef to bool
if ne get gpfn 2 40
ret false
end
o = get gpfo 2
for i ulong 40
c = get fbig add o i
if lt sohexv c 0
ret false
end
put gpbase i c
end
ret true
end
note patitle: 1..256 bytes, UTF-8, one line, no control byte (the text rules of docs/collab-write.md
note section 2, checked and never rewritten: the bytes are what the author's key signed)
fn patitle to bool
n = padec 3 256
if lt n 1
ret false
end
if not pawutf8 ulong n false
ret false
end
for i ulong ulong n bound 256
put gpttl i get gpfv i
end
put gpttll 0 ulong n
ret true
end
note padescr: 0..60000 bytes, UTF-8, tab and line feed the only control bytes
fn padescr to bool
n = padec 4 60000
if lt n 0
ret false
end
if not pawutf8 ulong n true
ret false
end
for i ulong ulong n bound 60000
put gpdsc i get gpfv i
end
put gpdscl 0 ulong n
ret true
end
note ---- the mbox field: base64url without padding, canonical (unused bits zero)
fn pab64v c uchar to long
if and ge c 65 le c 90
ret long sub c 65
end
if and ge c 97 le c 122
ret long sub c 71
end
if and ge c 48 le c 57
ret long add c 4
end
if eq c 45
ret 62
end
if eq c 95
ret 63
end
ret -1
end
note pabq p k: the k digits at fbig[p] as one number, -1 when one is not a base64url digit
fn pabq p ulong k ulong to long
v = long 0
for i ulong k bound 4
d = pab64v get fbig add p i
if lt d 0
ret -1
end
v = add mul v 64 d
end
ret v
end
note pambtail: the last 2 or 3 digits (1 or 2 bytes) at fbig[p], written at gpmb[q]; false when bad
fn pambtail p ulong k ulong q ulong to bool
v = pabq p k
if lt v 0
ret false
end
if eq k 2
if ne and v 15 0
ret false
end
put gpmb q uchar shr v 4
ret true
end
if ne and v 3 0
ret false
end
put gpmb q uchar shr v 10
put gpmb add q 1 uchar and shr v 2 255
ret true
end
note pambdec: decode the mbox field into gpmb: 0, 413 over 2 MiB, 400 not base64url
fn pambdec to ulong
o = get gpfo 5
n = get gpfn 5
put gpmbl 0 0
if gt n 2796203
ret 413
end
k = rem n 4
if eq k 1
ret 400
end
q = ulong 0
for t ulong div n 4 bound 1048576
v = pabq add o mul t 4 4
if lt v 0
ret 400
end
put gpmb q uchar shr v 16
put gpmb add q 1 uchar and shr v 8 255
put gpmb add q 2 uchar and v 255
q = add q 3
end
if ne k 0
if not pambtail add o sub n k k q
ret 400
end
q = add q sub k 1
end
put gpmbl 0 q
ret 0
end
note ---- the sig field: an armored SSH signature, at most 4000 bytes; kept with one final line feed
fn pasigin to bool
n = padec 6 4000
if lt n 0
ret false
end
s = new uchar 4096 0
k = ulong 0
for i ulong ulong n bound 4096
c = get gpfv i
if ne c 13
if not sosigc c
ret false
end
put s k c
k = add k 1
end
end
for it ulong 4096
if eq k 0
break
end
c = get s sub k 1
if and ne c 10 ne c 32
break
end
k = sub k 1
end
if lt k add len tssigb len tssige
ret false
end
if not soarmok part s 0 k
ret false
end
for i ulong k bound 4096
put gpsig i get s i
end
put gpsig k 10
put gpsigl 0 add k 1
ret true
end

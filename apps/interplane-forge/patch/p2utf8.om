note patch/p2utf8.om: the text rules of a title and a description (docs/collab-write.md section 2),
note over the decoded field gpfv. The same code as collab/co9comp.om cowutf8, coctlok and coulen under
note this slice's names: the store-reading build composes collab out (server/nocollab.om), so the
note patch intake carries its own copy and needs no collab unit.
note pawutf8 n ml: well-formed UTF-8 (no overlong forms, surrogates or code points over U+10FFFF), no
note NUL, C0 control or DEL byte except tab and LF when ml
fn pawutf8 n ulong ml bool to bool
i = ulong 0
while lt i n bound 70000
c = get gpfv i
if lt c 128
if eq pactlok c ml false
ret false
end
i = add i 1
else
k = paulen i n
if eq k 0
ret false
end
i = add i k
end
end
ret true
end
fn pactlok c uchar ml bool to bool
if eq c 127
ret false
end
if ge c 32
ret true
end
if and ml or eq c 9 eq c 10
ret true
end
ret false
end
note paulen i n: byte length of the multi-byte sequence at gpfv[i], 0 when it is malformed
fn paulen i ulong n ulong to ulong
c = get gpfv i
k = ulong 0
lo = uchar 128
hi = uchar 191
if and ge c 194 le c 223
k = ulong 2
end
if and ge c 224 le c 239
k = ulong 3
if eq c 224
lo = uchar 160
end
if eq c 237
hi = uchar 159
end
end
if and ge c 240 le c 244
k = ulong 4
if eq c 240
lo = uchar 144
end
if eq c 244
hi = uchar 143
end
end
if or eq k 0 gt add i k n
ret ulong 0
end
d = get gpfv add i 1
if or lt d lo gt d hi
ret ulong 0
end
for j ulong sub k 2 bound 2
d = get gpfv add add i 2 j
if or lt d 128 gt d 191
ret ulong 0
end
end
ret k
end

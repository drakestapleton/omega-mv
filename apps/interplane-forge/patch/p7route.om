note patch/p7route.om: paroute, the slice's entry point (server/route.om fslices asks it before collab).
note   GET  /<o>/<r>/patches[?page=N]        the list (HTML, or forge/patch-list/1)
note   GET  /<o>/<r>/patches/new             how to open a patch
note   POST /<o>/<r>/patches/new             the upload (patch/p4take.om)
note   GET  /<o>/<r>/patches/<id>            one item, signed or imported (HTML, or forge/patch/1); <id> is
note                                         16 lowercase hex
note   GET  /<o>/<r>/patches/<id>.patch      the stored mbox bytes
note   GET  /<o>/<r>/patches/<id>.diff       the stored diff, or the bundle diff of an imported item
note   GET  /<o>/<r>/patches/<id>.bundle     the stored head.bundle of an imported item
note   GET  /<o>/<r>/pulls                   302 to .../patches; /pulls/<id> and /pull/<id> 302 to
note                                         .../patches/<id> (the names other forges use)
note Returns 0 when the path is not one of these.
note paseg t: frest starts with the segment t, followed by its end or a slash
fn paseg t view uchar * to bool
if not frstpre t
ret false
end
n = len t
if eq n get frestl 0
ret true
end
ret eq get frest n 47
end
note paidrq a: frest[a, a+16) is 16 lowercase hex; copied into gpid
fn paidrq a ulong to bool
for i ulong 16
c = get frest add a i
if lt sohexv c 0
ret false
end
put gpid i c
end
ret true
end
note pasfx a t: frest from a to its end equals t
fn pasfx a ulong t view uchar * to bool
if ne sub get frestl 0 a len t
ret false
end
for i ulong len t bound 16
if ne get frest add a i get t i
ret false
end
end
ret true
end
note paalias o: /pulls or /pull (o its length): the same pages under the names other forges use
fn paalias o ulong to long
if ne get fmeth 0 1
ret 405
end
n = get frestl 0
id = false
if and ne n o ne n add o 1
if ne sub n add o 1 16
ret 404
end
if not paidrq add o 1
ret 404
end
id = true
else
if eq o len tppull
ret 404
end
end
put fkind 0 2
flocrepo
floct tppats
if id
flocc 47
for i ulong 16
flocc get gpid i
end
end
ret 302
end
fn paroute to long
if ge get fridx 0 get fan 0
ret 0
end
if paseg tppulls
ret paalias len tppulls
end
if paseg tppull
ret paalias len tppull
end
if not paseg tppats
ret 0
end
m = get fmeth 0
n = get frestl 0
o = len tppats
if or eq n o eq n add o 1
if ne m 1
ret 405
end
ret palist
end
if frsteq tppnew
if eq m 3
ret patake
end
if ne m 1
ret 405
end
ret panewpg
end
if ne m 1
ret 405
end
a = add o 1
l = sub n a
if lt l 16
ret 404
end
if not paidrq a
ret 404
end
if eq l 16
ret pashow
end
if pasfx add a 16 tpsfxp
ret paraws 0
end
if pasfx add a 16 tpsfxd
ret paraws 1
end
if pasfx add a 16 tpsfxb
ret paraws 2
end
ret 404
end

note door/ev4json.om: the routes and the machine form of the stream (schema interplane/events/1,
note docs/API.md). <base>events.json is JSON whatever the headers; <base>events and <base>feed answer
note it with Accept: application/json; <base>events without it redirects to the feed page.
note An event is shown only while it is public: a repository event whose repository is not on the
note allow-list now (or is refused) is skipped, its seq stays used. Names of accounts are read from
note the social log when the stream is read, so a renamed account shows its current name.
text tevpj "/events.json"
text tevpe "/events"
text tevpf "/feed"
text tevpfr "feed"
text tevqa "after"
text tevql "limit"
text tevqb "before"
text tevk1 "patch_opened"
text tevk2 "patch_revised"
text tevk3 "patch_merged"
text tevk4 "patch_archived"
text tevk5 "review"
text tevk6 "comment"
text tevk7 "issue_opened"
text tevk8 "issue_closed"
text tevk9 "release"
text tevk10 "branch_moved"
text tevk11 "star"
text tevk12 "follow"
text tevk13 "open_brought"
text tevk14 "open_withdrawn"
text tevj1 "{\"schema\":\"interplane/events/1\",\"base\":\""
text tevj2 "\",\"head_seq\":"
text tevj3 ",\"after\":"
text tevj4 ",\"limit\":"
text tevj5 ",\"limit_requested\":"
text tevj6 ",\"limit_max\":200,\"limited\":"
text tevj7 ",\"events\":["
text tevj8 "\n],\"count\":"
text tevj9 ",\"next\":\""
text tevj10 "events.json?after="
text tevj11 "&limit="
text tevj12 "\"}\n"
text teve1 "\n{\"seq\":"
text teve2 ",\"time\":\""
text teve3 "\",\"kind\":\""
text teve4 "\",\"actor\":"
text teve5 ",\"repo\":"
text teve6 ",\"subject\":"
text teve7 ",\"path\":"
text teve8 ",\"json\":"
text teve9 ",\"source\":"
text teve10 ",\"verdict\":"
text teve11 ",\"from\":"
text teve12 ",\"commits\":"
text teve13 ",\"target\":"
text tevan "{\"name\":"
text tevad ",\"did\":"
text tevap ",\"path\":"
text tevro "{\"owner\":\""
text tevrn "\",\"name\":"
text tevrr ",\"rid\":\"rad:"
text tevrp2 "\",\"path\":\""
text tevrj "\",\"json\":\""
text tevrje ".json\"}"
global gevqbad ulong 1
fn evon to bool
ret true
end
note evroute: 0 = not one of these paths
fn evroute to long
pj = fpeq tevpj
pe = fpeq tevpe
pf = fpeq tevpf
if not or or pj pe pf
ret 0
end
if pj
fqajsn
end
if not fget
ret 405
end
if or pj fjwant
ret evstream
end
if pe
put fkind 0 2
flocb
floct tevpfr
ret 302
end
ret evfeed
end
note evqnum n: fval[0, n) as a decimal number of 1..18 digits; gevqbad 1 for anything else
fn evqnum n long to ulong
put gevqbad 0 0
if or le n 0 gt n 18
put gevqbad 0 1
ret 0
end
v = ulong 0
for i ulong ulong n bound 18
c = get fval i
if not evdig c
put gevqbad 0 1
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn evstream to long
a = ulong 0
r = fqget tevqa
if ge r 0
a = evqnum r
if ne get gevqbad 0 0
ret 400
end
end
lreq = ulong 50
r2 = fqget tevql
if ge r2 0
lreq = evqnum r2
if or ne get gevqbad 0 0 eq lreq 0
ret 400
end
end
lim = lreq
cut = false
if gt lim 200
lim = ulong 200
cut = true
end
evcollect
if ne get gevok 0 1
put fretry 0 60
ret 503
end
evetag
if evinm
put fkind 0 1
ret 304
end
fjstart
fput tevj1
fputb
fput tevj2
fnum get gevn 0
fput tevj3
fnum a
fput tevj4
fnum lim
fput tevj5
fnum lreq
fput tevj6
fybool cut
fput tevj7
nx = evjlist a lim
fput tevj8
fnum get gevpe 0
fput tevj9
fputb
fput tevj10
fnum nx
fput tevj11
fnum lim
fput tevj12
ret 200
end
note evetag: "ev<head seq>-<social seq>-<public repos>-<base length>": the stream, the names in it and
note the visibility of its repositories are what a body depends on
fn evetag to void
put fetagl 0 0
fetc 34
fetc 101
fetc 118
evetn get gevn 0
fetc 45
evetn get gsseq 0
fetc 45
evetn get fan 0
fetc 45
evetn get fbasel 0
fetc 34
end
fn evetn v ulong to void
d = new uchar 24 0
k = evdec v d
for j ulong k bound 24
fetc get d j
end
end
fn evinm to bool
n = get fetagl 0
if ne get finml 0 n
ret false
end
for i ulong n bound 128
if ne get finm i get fetag i
ret false
end
end
ret true
end
note evjlist a lim: the visible events after seq a, at most lim; returns the seq to read after next time.
note The count shown is left in gevpe (the pass counter is not read after collection).
fn evjlist a ulong lim ulong to ulong
put gevpe 0 0
n = get gevn 0
if ge a n
ret a
end
evpath tevlog
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret a
end
k = a
for it ulong EVMAX
if or ge k n ge get gevpe 0 lim
break
end
if evshow int fd k 1
put gevpe 0 add get gevpe 0 1
end
k = add k 1
end
x = fclose int fd
ret k
end
note evshow fd k mode: read line k (seq k+1); when it is visible write it (mode 1 JSON, 2 the feed's
note list item) and return true
fn evshow fd int k ulong mode ulong to bool
o = get gevoff k
l = sub sub get gevoff add k 1 o 1
if ge l EVLMAX
ret false
end
ln = new uchar 8192 0
r = pread fd ln 0 l long o
if ne r long l
ret false
end
ret evshowl part ln 0 l mode
end
fn evshowl ln view uchar * mode ulong to bool
if not evtabs ln
ret false
end
kind = evfnum ln 2
ri = evlnrid ln
if eq ri 9998
ret false
end
if eq mode 1
evjev ln kind ri
else
evhli ln kind ri
end
ret true
end
note evlnrid ln: the allow-list index of the line's rid; 9999 when it has none or is an open shelf event,
note 9998 when the event must not be shown (a repository that is not public now, a refused RID)
fn evlnrid ln view uchar * to ulong
a = evfa 4
e = evfe 4 len ln
k = evfnum ln 2
if or eq k 13 eq k 14
if evlneq ln a e tfdnr1
ret 9998
end
ret 9999
end
if eq a e
ret 9999
end
for i ulong get fan 0 bound 64
if eq fridlen i sub e a
same = true
for j ulong sub e a bound 64
if ne fridbyte i j get ln add a j
same = false
break
end
end
if same
ret i
end
end
end
ret 9998
end
fn evlneq ln view uchar * a ulong e ulong t view uchar * to bool
if ne sub e a len t
ret false
end
for i ulong len t bound 128
if ne get ln add a i get t i
ret false
end
end
ret true
end
fn evkname k ulong to void
if eq k 1
fput tevk1
end
if eq k 2
fput tevk2
end
if eq k 3
fput tevk3
end
if eq k 4
fput tevk4
end
if eq k 5
fput tevk5
end
if eq k 6
fput tevk6
end
if eq k 7
fput tevk7
end
evkname2 k
end
fn evkname2 k ulong to void
if eq k 8
fput tevk8
end
if eq k 9
fput tevk9
end
if eq k 10
fput tevk10
end
if eq k 11
fput tevk11
end
if eq k 12
fput tevk12
end
if eq k 13
fput tevk13
end
if eq k 14
fput tevk14
end
end
note ---- one event as JSON
fn evjev ln view uchar * kind ulong ri ulong to void
if gt get gevpe 0 0
fputc 44
end
fput teve1
fnum evfnum ln 0
fput teve2
fjisob evfnum ln 1
fput teve3
evkname kind
fput teve4
evjactor ln evfa 3 evfe 3 len ln
fput teve5
if lt ri 9998
evjrepo ri
else
fynull
end
fput teve6
evjfld ln 9 false
fput teve7
evjlink ln 6 kind
fput teve8
evjlink ln 7 kind
fput teve9
evjfld ln 5 false
fput teve10
if and eq kind 5 ne evfa 8 evfe 8 len ln
evjfld ln 8 false
else
fynull
end
evjbr ln kind
fput teve13
if eq kind 12
evjactor ln evfa 8 evfe 8 len ln
else
fynull
end
fputc 125
end
note evjfld ln f base: field f as a JSON string (with the base before it when base is true)
fn evjfld ln view uchar * f ulong base bool to void
fjtb
if base
for i ulong get fbasel 0 bound 64
fjtc get fbase i
end
end
a = evfa f
for i ulong sub evfe f len ln a bound 8192
fjtc get ln add a i
end
fjstr
end
note evjlink ln f kind: path (6) or json (7): the base and the stored address; a follow names the
note followed account's page (when the account exists), anything else without an address is null
fn evjlink ln view uchar * f ulong kind ulong to void
if ne evfa f evfe f len ln
evjfld ln f true
ret
end
if eq kind 12
d = evacct ln evfa 8 evfe 8 len ln
if ne d 0
sojpath d
ret
end
end
fynull
end
note evjbr: from and commits of a branch move (x = "<old sha> <count>" or "<old sha> -"), else null
fn evjbr ln view uchar * kind ulong to void
a = evfa 8
e = evfe 8 len ln
fput teve11
if or ne kind 10 lt sub e a 42
fynull
fput teve12
fynull
ret
end
fjtb
for i ulong 40
fjtc get ln add a i
end
fjstr
fput teve12
v = ulong 0
ok = false
for i ulong sub e add a 41 bound 20
c = get ln add add a 41 i
if not evdig c
ok = false
break
end
v = add mul v 10 ulong sub c 48
ok = true
end
if ok
fnum v
else
fynull
end
end
note evacct ln a e: the social account id of the did:key ln[a, e), 0 when there is no account
fn evacct ln view uchar * a ulong e ulong to ulong
if or eq a e gt sub e a 128
ret 0
end
sokclr
for i ulong sub e a bound 128
sokc get ln add a i
end
d = sofind
if eq d 0
ret 0
end
if ge d len gsacc
ret 0
end
if eq get gsacc d 0
ret 0
end
ret d
end
note evisown ln a e: ln[a, e) is did:key:<the node delegate>
fn evisown ln view uchar * a ulong e ulong to bool
if ne sub e a add len tevdidk len tfnid
ret false
end
for i ulong len tevdidk bound 16
if ne get ln add a i get tevdidk i
ret false
end
end
b = add a len tevdidk
for i ulong len tfnid bound 64
if ne get ln add b i get tfnid i
ret false
end
end
ret true
end
note evjactor ln a e: {"name", "did", "path"}: the owner, else a forge account (its display name or
note null, and its page), else the did alone; null when the event has no actor
fn evjactor ln view uchar * a ulong e ulong to void
if eq a e
fynull
ret
end
fput tevan
isown = evisown ln a e
d = ulong 0
if isown
fjtxt tfowner
else
d = evacct ln a e
if and ne d 0 ne get gsnm d 0
sojid get gsnm d 0
else
fynull
end
end
fput tevad
fjtb
for i ulong sub e a bound 128
fjtc get ln add a i
end
fjstr
fput tevap
if isown
fjtb
for i ulong get fbasel 0 bound 64
fjtc get fbase i
end
for i ulong len tfowner bound 64
fjtc get tfowner i
end
fjstr
else
if ne d 0
sojpath d
else
fynull
end
end
fputc 125
end
fn evjrepo i ulong to void
fput tevro
fput tfowner
fput tevrn
fjtname i
fjstr
fput tevrr
fputrid i
fput tevrp2
fjpath i
fput tevrj
fjpath i
fput tevrje
end

note door/ev5feed.om: <base>feed, the stream for people: newest first, 50 a page, one plain sentence an
note event with who did it (their page) and what (a link to it); older pages with ?before=<seq>. Its
note JSON alternate is <base>events.json (fjalt 4); ?format=text is the server's plain-text form.
text tevfti "Feed"
note tevfh1 (the first lines of the page, naming the kinds) is the collector's: door/ev3col.om or
note store/evcol.om, whichever run.sh composed, says which kinds this build can have.
text tevfjs "events.json"
text tevfh2 "\">events.json</a> and continue from where they stopped (<a href=\""
text tevfag "agents.json"
text tevfh3 "\">agents.json</a> lists every address).</p>\n<ul class=\"feed\">\n"
text tevfnon "<li class=\"muted\">Nothing has happened yet.</li>\n"
text tevfh4 "</ul>\n"
text tevfol "<p><a href=\""
text tevfolq "feed?before="
text tevfol2 "\">Older</a>"
text tevfnw1 " <a href=\""
text tevfnw2 "\">Newest</a>"
text tevfend "</p>\n</section>\n"
text tevfend2 "</section>\n"
text tevli1 "<li>"
text tevli2 " <span class=\"muted\">"
text tevli3 " UTC</span></li>\n"
text teva1 "<a href=\""
text teva2 "\">"
text teva3 "</a>"
text tevsome "someone"
text tevv1 " proposed a change to "
text tevv2 " updated the change "
text tevv3 " merged "
text tevv3b " into "
text tevv4 " archived the change "
text tevv5 " reviewed "
text tevv6 " commented on "
text tevv7 " opened an issue in "
text tevv8 " closed the issue "
text tevv9 " tagged "
text tevv11 " starred "
text tevv12 " followed "
text tevv13 " brought "
text tevv13b " to the open builds shelf"
text tevv14 " withdrew "
text tevv14b " from the open builds shelf"
text tevin " in "
text tevcol ": "
text tevpo " ("
text tevpc ")"
text tevfnv "\">Feed</a>"
fn evnav to void
fput teva1
fputb
fput tevpfr
fput tevfnv
end
fn evfeed to long
b = ulong 0
r = fqget tevqb
if ge r 0
b = evqnum r
if or ne get gevqbad 0 0 eq b 0
ret 400
end
end
evcollect
if ne get gevok 0 1
put fretry 0 60
ret 503
end
n = get gevn 0
top = n
if and ne b 0 le sub b 1 n
top = sub b 1
end
put fjalt 0 4
fsetti tevfti
fput tevfh1
fputb
fput tevfjs
fput tevfh2
fputb
fput tevfag
fput tevfh3
evpath tevlog
fd = fopen fpth 0 get fpthl 0 524288 0
shown = ulong 0
low = ulong 0
k = top
if ge fd 0
for it ulong EVMAX
if or eq k 0 ge shown 50
break
end
if evshow int fd sub k 1 2
shown = add shown 1
low = k
end
k = sub k 1
end
x = fclose int fd
end
if eq shown 0
fput tevfnon
end
fput tevfh4
evfpage k low b
ret 200
end
note evfpage k low b: the Older link (when events older than the last shown remain) and Newest
fn evfpage k ulong low ulong b ulong to void
if and eq k 0 eq b 0
fput tevfend2
ret
end
fput tevfol
if gt k 0
fputb
fput tevfolq
fnum low
fput tevfol2
end
if ne b 0
fput tevfnw1
fputb
fput tevpfr
fput tevfnw2
end
fput tevfend
end
note ---- one list item
fn evhli ln view uchar * kind ulong ri ulong to void
fput tevli1
if ne kind 10
evhactor ln evfa 3 evfe 3 len ln
end
evhverb ln kind ri
fput tevli2
t = evfnum ln 1
fjday t
fputc 32
s = rem t 86400
fj2 div s 3600
fputc 58
fj2 div rem s 3600 60
fput tevli3
end
note evhactor: the owner or an account with a display name: a link to its page with the name; an account
note without one: "someone" linking its page; a key with no account here: "someone"
fn evhactor ln view uchar * a ulong e ulong to void
if evisown ln a e
fput teva1
fputb
fput tfowner
fput teva2
fput tfowner
fput teva3
ret
end
d = evacct ln a e
if eq d 0
fput tevsome
ret
end
fput teva1
fputb
sonmout d
fput teva2
if ne get gsnm d 0
sonmout d
else
fput tevsome
end
fput teva3
end
note evhthing ln: the subject, linked to the event's page
fn evhthing ln view uchar * to void
a = evfa 6
e = evfe 6 len ln
if eq a e
evhfld ln 9
ret
end
fput teva1
fputb
for i ulong sub e a bound 1024
fescc get ln add a i
end
fput teva2
evhfld ln 9
fput teva3
end
fn evhfld ln view uchar * f ulong to void
a = evfa f
for i ulong sub evfe f len ln a bound 8192
fescc get ln add a i
end
end
fn evhrepo ri ulong to void
if ge ri 9998
ret
end
fput teva1
fputb
fput tfowner
fputc 47
fputrn ri
fput teva2
fputrn ri
fput teva3
end
fn evhverb ln view uchar * kind ulong ri ulong to void
if eq kind 1
fput tevv1
evhrepo ri
fput tevcol
evhthing ln
end
if eq kind 2
fput tevv2
evhthing ln
fput tevin
evhrepo ri
end
if eq kind 3
fput tevv3
evhthing ln
fput tevv3b
evhrepo ri
end
if eq kind 4
fput tevv4
evhthing ln
fput tevin
evhrepo ri
end
if eq kind 5
fput tevv5
evhthing ln
fput tevin
evhrepo ri
if ne evfa 8 evfe 8 len ln
fput tevpo
evhfld ln 8
fput tevpc
end
end
evhverb2 ln kind ri
end
fn evhverb2 ln view uchar * kind ulong ri ulong to void
if eq kind 6
fput tevv6
evhthing ln
fput tevin
evhrepo ri
end
if eq kind 7
fput tevv7
evhrepo ri
fput tevcol
evhthing ln
end
if eq kind 8
fput tevv8
evhthing ln
fput tevin
evhrepo ri
end
if eq kind 9
fput tevv9
evhthing ln
fput tevin
evhrepo ri
end
if eq kind 10
evhrepo ri
fput tevcol
evhthing ln
end
evhverb3 ln kind ri
end
fn evhverb3 ln view uchar * kind ulong ri ulong to void
if eq kind 11
fput tevv11
evhrepo ri
end
if eq kind 12
fput tevv12
evhactor ln evfa 8 evfe 8 len ln
end
if eq kind 13
fput tevv13
evhthing ln
fput tevv13b
end
if eq kind 14
fput tevv14
evhfld ln 9
fput tevv14b
end
end

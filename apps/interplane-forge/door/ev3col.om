note door/ev3col.om: one collection pass. Change-triggered: each source is read only when its
note fingerprint moved since the last pass of this process (a start reads every repository once and
note finds nothing new: the snapshots in <data>events/r/ and the keys of the log say what was seen).
note   social log      its size; the new bytes are read with social's own line parser (stars, follows)
note   open shelf      <data>open/list.tsv, its change time and size (brought, withdrawn)
note   repository i    the change times of refs/heads, refs/tags, packed-refs, refs/namespaces, refs/rad
note                   and every refs/namespaces/<nid>/refs/rad (Radicle renames sigrefs into it at
note                   every ref update of that node, COB changes included); then one for-each-ref of
note                   the default branch, the tags and the patch and issue COB refs, compared line by
note                   line with the snapshot; only COBs whose tip moved are loaded (collab coload)
text tevfh1 "<section class=\"box\"><h1>Feed</h1>\n<p class=\"muted\">What happened on this forge, newest first: changes proposed, reviewed and merged, issues, releases, new commits on default branches, stars, follows and the open builds shelf. Only public repositories. Agents read the same list as <a href=\""
const EVNO ulong 99999999
fn evcollect to void
if eq get gevok 0 0
evload
end
if ne get gevok 0 1
ret
end
t0 = monons
put gevpr 0 0
put gevpe 0 0
put gevbn 0 0
put gevbatl 0 0
evsocial
evopen
for i ulong get fan 0 bound FAMAX
evrepochk i
end
if gt get gevbn 0 0
evflush
end
note a COB read past a buffer marks the response cut (fincut); collection is not the response
put ficut 0 0
put fobtr 0 0
put fobl 0 0
if gt get gevpr 0 0
dt = div ulong sub monons t0 1000
evgb
evgt tevlpas
evgn dt
evgt tevlpus
evgn get gevpr 0
evgt tevlpev
evgn get gevpe 0
evgout
end
end
note ---- the social log (social/30store.om writes it; soload has verified it)
fn evsocial to void
if eq get gsok 0 0
ret
end
sopdd
sopt tslog
fpb
for i ulong get gspthl 0 bound 1024
fpc get gspth i
end
if eq evstat 0
ret
end
sz = evst64 48
off = get gevsoff 0
if eq sz off
ret
end
if lt sz off
off = ulong 0
end
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret
end
put gevpr 0 add get gevpr 0 1
for it ulong 100000
r = pread int fd gevrb 0 len gevrb long off
if le r 0
break
end
u = evsocscan ulong r
if eq u 0
break
end
off = add off u
end
x = fclose int fd
put gevsoff 0 off
end
fn evsocscan n ulong to ulong
ln = new uchar 1024 0
p = ulong 0
for it ulong 2097152
e = evrbeol p n
if ge e n
break
end
l = sub e p
if lt l 1024
for i ulong l bound 1024
put ln i get gevrb add p i
end
evsocln part ln 0 l
end
p = add e 1
end
ret p
end
fn evrbeol p ulong n ulong to ulong
e = p
for k ulong 2097152
if ge e n
ret n
end
if eq get gevrb e 10
ret e
end
e = add e 1
end
ret n
end
note evsocln: one social line; only star (1) and follow (7) are events. fav, unfav, watch, unwatch,
note unstar, unfollow, account, name, session and logout are never read past their action word.
fn evsocln ln view uchar * to void
put gspc 0 0
put gsbad 0 0
solit ln tsl1
seq = sonum ln
solit ln tsl2
ts = sonum ln
solit ln tsl3
sokclr
sokt tsdidp
dl = sostr ln
evclr
for i ulong get gskbl 0 bound 128
evactc get gskb i
end
solit ln tsl4
a = soact ln
solit ln tsl5
sokclr
tl = sostr ln
if ne get gsbad 0 0
ret
end
put gevt 0 ts
evsrct tevsocs
evsrcnum seq
if eq a 1
evsstar
end
if eq a 7
evsfoll
end
end
note evsstar: gskb holds rad:<rid>; an event only for a repository that is public now
fn evsstar to void
if not sokpre tsradp
ret
end
for i ulong sub get gskbl 0 len tsradp bound 64
evridc get gskb add len tsradp i
end
r = evridpub
if eq r 9999
ret
end
put gevk 0 11
evpthrepo r
evjsame
evjst tevjsx
for k ulong frnlen r bound 128
evsubc frnbyte r k
end
evemit
end
note evsfoll: gskb holds the followed account's did:key; its page is found when the stream is read
fn evsfoll to void
if not sokpre tsdidp
ret
end
put gevk 0 12
for i ulong get gskbl 0 bound 128
evxc get gskb i
evsubc get gskb i
end
evemit
end
note ---- the open shelf: <data>open/list.tsv (rid, state, did, date, size, name, ...), as the intake wrote it
fn evopen to void
evpath tevlist
fp = evstat
if eq fp get gevofp 0
ret
end
put gevofp 0 fp
if eq fp 0
ret
end
r = frdall
if or lt r 0 ne get fxotr 0 0
ret
end
put gevpr 0 add get gevpr 0 1
n = get fxol 0
p = ulong 0
for it ulong 16777216
if ge p n
break
end
e = p
for k ulong 16777216
if ge e n
break
end
if eq get fxo e 10
break
end
e = add e 1
end
evopnln p e
p = add e 1
end
end
fn evfxeq a ulong e ulong t view uchar * to bool
if ne sub e a len t
ret false
end
for i ulong len t bound 64
if ne get fxo add a i get t i
ret false
end
end
ret true
end
note evopnln a e: one shelf row; held or stored is "brought", withdrawn is "withdrawn". Time: the row's
note date at 00:00 UTC (the list keeps the day only). A denied RID (server/repos.om fdeny) is never named.
fn evopnln a ulong e ulong to void
tb = new ulong 8 0
k = ulong 0
for i ulong sub e a bound 16777216
if eq get fxo add a i 9
if lt k 8
put tb k add a i
k = add k 1
end
end
end
if lt k 6
ret
end
evopn2 tb a
end
fn evopnkd tb view ulong * to ulong
s = add get tb 0 1
e = get tb 1
if or evfxeq s e tevheld evfxeq s e tevstor
ret 13
end
if evfxeq s e tevwdr
ret 14
end
ret 0
end
fn evopn2 tb view ulong * a ulong to void
kd = evopnkd tb
if eq kd 0
ret
end
if or eq get tb 0 a gt sub get tb 0 a 64
ret
end
if evfxeq a get tb 0 tfdnr1
ret
end
d = add get tb 2 1
if ne sub get tb 3 d 10
ret
end
t = evdate d
if eq t 0
ret
end
evclr
put gevk 0 kd
put gevt 0 t
evopnf a get tb 0 add get tb 1 1 get tb 2 d
evopnnm add get tb 4 1 get tb 5
evemit
end
fn evopnnm a ulong e ulong to void
for i ulong sub e a bound 4096
c = get fxo add a i
evxc c
evsubc c
end
end
note evopnf: rid fxo[a, ra), actor fxo[da, de) when it is a did:key, source, path and json
fn evopnf a ulong ra ulong da ulong de ulong d ulong to void
for i ulong sub ra a bound 64
evridc get fxo add a i
end
if evfxpre da de tevdidk
for i ulong sub de da bound 128
evactc get fxo add da i
end
end
evsrct tevopns
for i ulong sub ra a bound 64
evsrcc get fxo add a i
end
evsrcc 64
for i ulong 10
evsrcc get fxo add d i
end
evptht tevopnp
if eq get gevk 0 13
for i ulong sub ra a bound 64
evpthc get fxo add a i
end
evjsame
evjst tevjsx
else
evjst tevopnj
end
end
fn evfxpre a ulong e ulong t view uchar * to bool
if lt sub e a len t
ret false
end
for i ulong len t bound 64
if ne get fxo add a i get t i
ret false
end
end
ret true
end
note evdate p: fxo[p, p+10) = YYYY-MM-DD as epoch seconds at 00:00 UTC; 0 when it is not a date
fn evdate p ulong to ulong
for i ulong 10
c = get fxo add p i
if or eq i 4 eq i 7
if ne c 45
ret 0
end
else
if not evdig c
ret 0
end
end
end
y = evdn add p 0 4
m = evdn add p 5 2
d = evdn add p 8 2
if or or lt y 1970 lt m 1 or gt m 12 or lt d 1 gt d 31
ret 0
end
ret mul evdays y m d 86400
end
note evdays y m d: days since 1970-01-01 of a civil date (proleptic Gregorian, y >= 1970)
fn evdays y0 ulong m ulong d ulong to ulong
y = y0
if le m 2
y = sub y 1
end
era = div y 400
yoe = sub y mul era 400
mp = add m 9
if gt m 2
mp = sub m 3
end
doy = add div add mul 153 mp 2 5 sub d 1
a = add mul yoe 365 div yoe 4
doe = add sub a div yoe 100 doy
ret sub add mul era 146097 doe 719468
end
fn evdn p ulong n ulong to ulong
v = ulong 0
for i ulong n bound 4
v = add mul v 10 ulong sub get fxo add p i 48
end
ret v
end
note ---- repositories
note evstp: fpth = <storage><rid of repo i><t>
fn evstp i ulong t view uchar * to void
fpb
fpt tfstore
for k ulong fridlen i bound 64
fpc fridbyte i k
end
fpt t
end
fn evrepochk i ulong to void
h = ulong 14695981039346656037
for k ulong fridlen i bound 64
h = evfnv h fridbyte i k
end
evstp i tevsrh
h = add h evstat
evstp i tevsrt
h = add h mul evstat 3
evstp i tevspk
h = add h mul evstat 5
evstp i tevsns
h = add h mul evstat 7
evstp i tevsrad
h = add h mul evstat 11
h = add h evnsfp i
if eq h get gevfp i
ret
end
if evrepo i
put gevfp i h
end
end
note evnsfp i: the sum of the fingerprints of refs/namespaces/<nid>/refs/rad, one per node
fn evnsfp i ulong to ulong
evstp i tevsns
fd = fopen fpth 0 get fpthl 0 540672 0
if lt fd 0
ret 0
end
s = ulong 0
for it ulong 4096
n = getdnts int fd gevde 0 len gevde
if le n 0
break
end
s = add s evnsdir i ulong n
end
x = fclose int fd
ret s
end
fn evnsdir i ulong n ulong to ulong
s = ulong 0
p = ulong 0
for it ulong 16384
if ge add p 19 n
break
end
rl = or ulong get gevde add p 16 shl ulong get gevde add p 17 8
if eq rl 0
break
end
s = add s evnsent i p
p = add p rl
end
ret s
end
note evnsent i p: a node folder (d_type 4, not dot-named) at gevde[p]: its refs/rad fingerprint, else 0
fn evnsent i ulong p ulong to ulong
if ne get gevde add p 18 4
ret 0
end
if eq get gevde add p 19 46
ret 0
end
evstp i tevsns
fpc 47
for k ulong 255
c = get gevde add add p 19 k
if eq c 0
break
end
fpc c
end
fpt tevsrad
ret mul evstat 13
end
note evsetrepo i: the request globals collab reads (fridx, frid, frepo) name repository i
fn evsetrepo i ulong to void
put fridx 0 i
for k ulong fridlen i bound 64
put frid k fridbyte i k
end
put fridl 0 fridlen i
for k ulong frnlen i bound 128
put frepo k frnbyte i k
end
put frepol 0 frnlen i
end
fn evunset to void
put fridx 0 9999
put fridl 0 0
put frepol 0 0
end
note evsnapp i: fpth = <data>events/r/<rid of i>
fn evsnapp i ulong to void
evpath tevrp
for k ulong fridlen i bound 64
fpc fridbyte i k
end
end
note evrepo i: read repository i; false when git did not answer (the next pass tries again)
fn evrepo i ulong to bool
evsetrepo i
fkgiti i
fka tevfer
fka tevfmt
fkopen
fkt tevrh
for k ulong get fabl i bound 64
fkc get fabr add get fabo i k
end
fka tevrt
fkopen
fkt tevns
fkt tfnid
fkt tevnst
fka tevcpg
fka tevcig
x = fexec 10000000000
if ne x 0
evunset
ret false
end
put gevpr 0 add get gevpr 0 1
if or ne get fxotr 0 0 gt get fxol 0 len gevnew
evgb
evgt tevlcut
for k ulong fridlen i bound 64
evgc fridbyte i k
end
evgout
evunset
ret true
end
n = get fxol 0
for k ulong n bound 4194304
put gevnew k get fxo k
end
put gevnewl 0 n
first = evoldld i
put gevcn 0 0
p = ulong 0
for it ulong 4194304
if ge p n
break
end
e = p
for k ulong 4194304
if ge e n
break
end
if eq get gevnew e 10
break
end
e = add e 1
end
evrefln i p e first
p = add e 1
end
evcobs i 1
evcobs i 2
evsnapw i
evunset
ret true
end
note evoldld i: the snapshot of the last read into gevold; true when there is none (first sight)
fn evoldld i ulong to bool
put gevoldl 0 0
evsnapp i
r = frdall
if lt r 0
ret true
end
if or ne get fxotr 0 0 gt get fxol 0 len gevold
ret true
end
n = get fxol 0
for k ulong n bound 4194304
put gevold k get fxo k
end
put gevoldl 0 n
ret false
end
note evsnapw i: gevnew becomes the snapshot (written to .tmp, then renamed over it)
fn evsnapw i ulong to void
evsnapp i
fpt tevtmp
fd = fopen fpth 0 get fpthl 0 524865 384
if lt fd 0
ret
end
n = get gevnewl 0
off = ulong 0
for it ulong 4096
if ge off n
break
end
w = write int fd gevnew off sub n off
if le w 0
break
end
off = add off ulong w
end
x = fsync int fd
y = fclose int fd
if ne off n
ret
end
pk = new uchar 8200 0
put pk 0 2
o = evpkadd pk 2
evsnapp i
o = evpkadd pk o
r = renames pk 0 o 0
end
fn evpkadd pk edit uchar * o ulong to ulong
n = get fpthl 0
put pk o uchar and n 255
put pk add o 1 uchar shr n 8
for k ulong n bound 4096
put pk add add o 2 k get fpth k
end
ret add add o 2 n
end
note ---- one ref line of gevnew: "<sha> <time> <refname>"
fn evrefln i ulong a ulong e ulong first bool to void
if lt sub e a 44
ret
end
if ne get gevnew add a 40 32
ret
end
r = add a 41
t = ulong 0
for k ulong 20
if ge r e
ret
end
c = get gevnew r
r = add r 1
if eq c 32
break
end
if not evdig c
ret
end
t = add mul t 10 ulong sub c 48
end
o = ulong EVNO
if not first
o = evoldsha r e
end
if ne o EVNO
if evsame o a
ret
end
end
evrefcls i a e r t o
end
fn evsame o ulong a ulong to bool
for k ulong 40
if ne get gevold add o k get gevnew add a k
ret false
end
end
ret true
end
note evrefcls: classify the moved ref (the default branch, a tag, a patch or issue COB)
fn evrefcls i ulong a ulong e ulong r ulong t ulong o ulong to void
if evnat r e tevrh
if evnbr i add r len tevrh e
if ne o EVNO
evbranch i o a t
end
ret
end
end
if evnat r e tevrtp
evtag i a t add r len tevrtp e
ret
end
if evnat r e tevns
q = add r len tevns
if evnat q e tfnid
q2 = add q len tfnid
if evnat q2 e tevnstp
evtag i a t add q2 len tevnstp e
ret
end
end
end
if lt sub e r add len tevcpm 40
ret
end
m = sub sub e 40 len tevcpm
if evnat m e tevcpm
evaddcob sub e 40 1
ret
end
m2 = sub sub e 40 len tevcim
if evnat m2 e tevcim
evaddcob sub e 40 2
end
end
note evnat p e t: gevnew[p, e) starts with t
fn evnat p ulong e ulong t view uchar * to bool
if lt sub e p len t
ret false
end
for k ulong len t bound 128
if ne get gevnew add p k get t k
ret false
end
end
ret true
end
note evnbr i p e: gevnew[p, e) is exactly the default branch of repository i
fn evnbr i ulong p ulong e ulong to bool
if ne sub e p get fabl i
ret false
end
o = get fabo i
for k ulong get fabl i bound 64
if ne get gevnew add p k get fabr add o k
ret false
end
end
ret true
end
note evoldsha r e: the offset of the sha of the gevold line whose refname equals gevnew[r, e), else EVNO
fn evoldsha r ulong e ulong to ulong
n = get gevoldl 0
l = sub e r
p = ulong 0
for it ulong 4194304
if ge p n
break
end
q = p
for k ulong 4194304
if ge q n
break
end
if eq get gevold q 10
break
end
q = add q 1
end
s = evoldref p q
if ne s EVNO
if eq sub q s l
if evrefeq s r l
ret p
end
end
end
p = add q 1
end
ret EVNO
end
note evoldref p q: start of the refname of the gevold line [p, q) (after the second space), else EVNO
fn evoldref p ulong q ulong to ulong
if lt sub q p 44
ret EVNO
end
s = add p 41
for k ulong 21
if ge s q
ret EVNO
end
if eq get gevold s 32
ret add s 1
end
s = add s 1
end
ret EVNO
end
fn evrefeq s ulong r ulong l ulong to bool
for k ulong l bound 4096
if ne get gevold add s k get gevnew add r k
ret false
end
end
ret true
end
note evaddcob p kd: the COB id gevnew[p, p+40) of kind kd moved (each id once)
fn evaddcob p ulong kd ulong to void
for k ulong 40
if not evhexd get gevnew add p k
ret
end
end
n = get gevcn 0
for j ulong n bound 4096
if evcideq j p
ret
end
end
if ge n 4096
ret
end
for k ulong 40
put gevcid add mul n 40 k get gevnew add p k
end
put gevckd n kd
put gevcn 0 add n 1
end
fn evcideq j ulong p ulong to bool
o = mul j 40
for k ulong 40
if ne get gevcid add o k get gevnew add p k
ret false
end
end
ret true
end
note ---- events of one repository
fn evtag i ulong a ulong t ulong s ulong e ulong to void
evclr
put gevk 0 9
put gevt 0 t
evowndid
evridi i
for k ulong 40
evsrcc get gevnew add a k
end
evpthrepo i
evptht tevrelp
for k ulong sub e s bound 1024
c = get gevnew add s k
evpthc c
evsubc c
end
evjsame
evemit
end
fn evbranch i ulong o ulong a ulong t ulong to void
fkgiti i
fka tevrl
fka tevcnt
fkopen
for k ulong 40
fkc get gevold add o k
end
fkt tevdots
for k ulong 40
fkc get gevnew add a k
end
x = fexec 10000000000
known = false
cnt = ulong 0
if eq x 0
for k ulong get fxol 0 bound 21
c = get fxo k
if not evdig c
break
end
cnt = add mul cnt 10 ulong sub c 48
known = true
end
end
evclr
put gevk 0 10
put gevt 0 t
evowndid
evridi i
for k ulong 40
evsrcc get gevnew add a k
evxc get gevold add o k
end
evxc 32
evpthrepo i
evptht tevcmpp
for k ulong 40
evpthr get gevold add o k
end
evptht tevtdot
for k ulong 40
evpthr get gevnew add a k
end
evjsame
evbrsub i known cnt
evemit
end
note evbrsub: "<n> new commit(s) on <branch>", or "<branch> moved" when the count is not known
fn evbrsub i ulong known bool cnt ulong to void
o = get fabo i
if not known
evxc 45
for k ulong get fabl i bound 64
evsubc get fabr add o k
end
evsubt tevmovd
ret
end
d = new uchar 24 0
n = evdec cnt d
for k ulong n bound 24
evxc get d k
evsubc get d k
end
evsubt tevncom
if ne cnt 1
evsubt tevncs
end
evsubt tevon
for k ulong get fabl i bound 64
evsubc get fabr add o k
end
end
note ---- COBs: the moved ids of kind kd are loaded with collab's corefs / coload
fn evcobs i ulong kd ulong to void
any = false
for j ulong get gevcn 0 bound 4096
if eq get gevckd j kd
any = true
end
end
if not any
ret
end
if not corefs kd
ret
end
for j ulong get gevcn 0 bound 4096
if eq get gevckd j kd
for k ulong 40
put gcid k get gevcid add mul j 40 k
end
ok = false
if coload kd
if eq get gcov 0 0
ok = true
end
end
if ok
evcob i kd
else
evgb
evgt tevlcob
for k ulong 40
evgc get gcid k
end
evgout
end
end
end
end
note evcob i kd: the events of the loaded COB (collab's model: changes, revisions, merges, reviews,
note comments, lifecycle). One event per kind and change; the opening is keyed by the COB id.
fn evcob i ulong kd ulong to void
if eq kd 1
evchg i kd 1 0 true 0
for r ulong get gcrn 0 bound 64
if gt r 0
evchg i kd 2 get gcrt r false 0
end
end
for m ulong get gcmn 0 bound 16
evchg i kd 3 get gcmt m false 0
end
for w ulong get gcwn 0 bound 64
evchg i kd 5 get gcwt w false get gcwv w
end
if eq get gcm 2 2
evchg i kd 4 get gclfc 0 false 0
end
else
evchg i kd 7 0 true 0
if eq get gcm 2 2
evchg i kd 8 get gclfc 0 false 0
end
end
for q ulong get gcqn 0 bound 8192
if and eq get gcqx q 0 ne get gcqt q 0
evchg i kd 6 get gcqt q false 0
end
end
end
fn evchg i ulong kd ulong kind ulong ci ulong root bool vd ulong to void
if ge ci get gccn 0
ret
end
evchgh kind ci
evridi i
evchgs ci root
if eq vd 1
evxt tevvacc
end
if eq vd 2
evxt tevvrej
end
evchgp i kd
evemit
end
note evchgh kind ci: kind, the change's author time and its author (did:key of the NID that signed it)
fn evchgh kind ulong ci ulong to void
evclr
put gevk 0 kind
put gevt 0 get gccts ci
evactt tevdidk
o = mul ci 64
for k ulong get gccal ci bound 64
evactc get gccau add o k
end
end
note evchgs ci root: the source: the COB id for its opening, else the change commit
fn evchgs ci ulong root bool to void
o = mul ci 40
for k ulong 40
if root
evsrcc get gcid k
else
evsrcc get gcch add o k
end
end
end
note evchgp i kd: path and json <owner>/<repo>/patches|issues/<id>, and the title as the subject
fn evchgp i ulong kd ulong to void
evpthrepo i
if eq kd 1
evptht tevpatp
else
evptht tevissp
end
for k ulong 40
evpthr get gcid k
end
evjsame
o = get gcm 0
for k ulong get gcm 1 bound 400
evsubc get gcpool add o k
end
end

note collab/co5iss.om (ForgePatches): one issue page: title, state, author, labels, assignees, and the
note comment thread (the first comment is the issue body; edits replace a body, redactions hide it).
text tcih4 " comment"
text tcireas " &#183; reason "
text tcic1 "<section class=\"box\"><p class=\"meta\">"
text tcic2 " wrote on "
text tcic3 "</p>"
text tcic4 "</section>\n"
text tcicx "<p class=\"muted\">This comment was redacted by its author.</p>"
text tcicnx "<p class=\"muted\">No comments.</p>\n"
text tctiss " &#183; issue &#183; "
fn coisspg to long
if eq corefs 2 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 2 false
ret 404
end
coittl
frepohd 6
coihd
copmeta
coicoms
ret 200
end
fn coittl to void
put ftil 0 0
o = get gcm 0
n = get gcm 1
for k ulong n bound 256
ftic get gcpool add o k
end
for k ulong len tctiss
ftic get tctiss k
end
ftirepo
end
fn coihd to void
fput tcph1
copoolm 0
if eq get gcm 1 0
fput tcnot
end
fput tcph2
coidh 7
fput tcph3
costbadge 2 get gcm 2
if gt get gcm 8 0
fput tcireas
copoolm 7
end
fput tcph4
coauth 0
fput tcph5
codate get gccts 0
fput tcmidd
fnum get gcqn 0
fput tcih4
if ne get gcqn 0 1
fputc 115
end
fput tcph6
coidh 40
fput tcph7
end
fn coicoms to void
if eq get gcqn 0 0
fput tcicnx
ret
end
for q ulong get gcqn 0
coicom q
end
end
fn coicom q ulong to void
ci = get gcqt q
fput tcic1
coauth ci
fput tcic2
codate get gccts ci
fput tcic3
if eq get gcqx q 1
fput tcicx
else
n = get gcqs add mul q 2 1
if gt n 0
fput tcpre1
copool get gcqs mul q 2 n
fput tcpre2
end
end
fput tcic4
end

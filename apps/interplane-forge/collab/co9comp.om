note collab/co9comp.om (ForgePatches): Phase A of docs/collab-write.md, the compose store.
note The web composes and checks a comment, a review, a new issue or a new patch; it never writes to
note Radicle. A checked compose is kept in memory for 15 minutes in one of 32 slots, bound to the
note session's CSRF token, the repo and a 128-bit random id (/dev/urandom); GET compose/<cid> shows the
note preview and the exact rad or git command the author runs in a clone, signing with their own key.
note Kinds: 1 issue comment, 2 patch comment, 3 patch review, 4 new issue, 5 new patch; 0 free slot.
text tcurnd "/dev/urandom"
global gcfv uchar 65536
global gcfvl ulong 1
global gczk ulong 32
global gczt ulong 32
global gczix ulong 32
global gczid uchar 1024
global gczcs uchar 1024
global gcztg uchar 1280
global gczrv uchar 1280
global gczrn ulong 32
global gczf ulong 32
global gczti uchar 8192
global gcztl ulong 32
global gczb uchar 1920000
global gczbl ulong 32
note staging for cozsave: title, flags (1 accept, 2 reject, 3 review without verdict, 8 draft), revision
global gcsti uchar 256
global gcstil ulong 1
global gcsf ulong 1
global gcsrv ulong 1
note ---- form body fields (application/x-www-form-urlencoded, fbody up to 64 KiB) into gcfv
note cobfld t: decode field t into gcfv; its length, -1 when absent, -2 when over 65536 bytes
fn cobfld t view uchar * to long
n = get fbodyl 0
i = ulong 0
while lt i n bound 70000
if cobfmat t i n
ret cobfdec add add i len t 1 n
end
i = cobfnxt i n
end
ret -1
end
fn cobfmat t view uchar * i ulong n ulong to bool
if gt add add i len t 1 n
ret false
end
for k ulong len t bound 64
if ne get fbody add i k get t k
ret false
end
end
ret eq get fbody add i len t 61
end
fn cobfnxt i ulong n ulong to ulong
j = i
while lt j n bound 70000
if eq get fbody j 38
ret add j 1
end
j = add j 1
end
ret n
end
fn cobfdec i ulong n ulong to long
j = i
o = ulong 0
while lt j n bound 70000
c = get fbody j
if eq c 38
break
end
if ge o 65536
ret -2
end
j = add j 1
if eq c 43
c = uchar 32
end
if eq c 37
c = cobpct j n
if lt add j 1 n
j = add j 2
end
end
put gcfv o c
o = add o 1
end
put gcfvl 0 o
ret long o
end
fn cobpct j ulong n ulong to uchar
if ge add j 1 n
ret uchar 37
end
a = fhexv get fbody j
b = fhexv get fbody add j 1
if or lt a 0 lt b 0
ret uchar 37
end
ret uchar add mul a 16 b
end
note ---- text checks on gcfv[0,n)
note cotxtok n ml: CRLF and lone CR become LF; then the text must be UTF-8 without NUL or control
note bytes (ml: tab and LF allowed; else none); trailing blanks and leading newlines are trimmed
note (single line: leading blanks too). The cleaned length, or -1 when the text is refused.
fn cotxtok n ulong ml bool to long
m = cocrlf n
if eq cowutf8 m ml false
ret -1
end
e = m
while gt e 0 bound 70000
c = get gcfv sub e 1
if and ne c 32 and ne c 9 ne c 10
break
end
e = sub e 1
end
s = ulong 0
while lt s e bound 70000
c = get gcfv s
if and ne c 10 or ml and ne c 32 ne c 9
break
end
s = add s 1
end
if gt s 0
for k ulong sub e s bound 70000
put gcfv k get gcfv add s k
end
end
ret long sub e s
end
fn cocrlf n ulong to ulong
o = ulong 0
for i ulong n bound 70000
c = get gcfv i
if eq c 13
c = uchar 10
if lt add i 1 n
if eq get gcfv add i 1 10
c = uchar 0
end
end
end
if ne c 0
put gcfv o c
o = add o 1
else
if ne get gcfv i 13
put gcfv o c
o = add o 1
end
end
end
ret o
end
note cowutf8 n ml: well-formed UTF-8 (no overlong forms, surrogates or code points over U+10FFFF), no
note NUL, C0 control or DEL byte except tab and LF when ml
fn cowutf8 n ulong ml bool to bool
i = ulong 0
while lt i n bound 70000
c = get gcfv i
if lt c 128
if eq coctlok c ml false
ret false
end
i = add i 1
else
k = coulen i n
if eq k 0
ret false
end
i = add i k
end
end
ret true
end
fn coctlok c uchar ml bool to bool
if eq c 127
ret false
end
if ge c 32
ret true
end
if and ml or eq c 9 eq c 10
ret true
end
ret false
end
note coulen i n: byte length of the multi-byte sequence at gcfv[i], 0 when it is malformed
fn coulen i ulong n ulong to ulong
c = get gcfv i
k = ulong 0
lo = uchar 128
hi = uchar 191
if and ge c 194 le c 223
k = ulong 2
end
if and ge c 224 le c 239
k = ulong 3
if eq c 224
lo = uchar 160
end
if eq c 237
hi = uchar 159
end
end
if and ge c 240 le c 244
k = ulong 4
if eq c 240
lo = uchar 144
end
if eq c 244
hi = uchar 143
end
end
if or eq k 0 gt add i k n
ret ulong 0
end
d = get gcfv add i 1
if or lt d lo gt d hi
ret ulong 0
end
for j ulong sub k 2 bound 2
d = get gcfv add add i 2 j
if or lt d 128 gt d 191
ret ulong 0
end
end
ret k
end
note ---- slots
fn conow to ulong
ret div ulong realns 1000000000
end
fn cozlive s ulong to bool
if eq get gczk s 0
ret false
end
ret le sub conow get gczt s 900
end
note cozslot: a free or expired slot, else the oldest
fn cozslot to ulong
w = ulong 0
for s ulong 32
if eq cozlive s false
ret s
end
if lt get gczt s get gczt w
w = s
end
end
ret w
end
note cozsave kd n: store a compose of kind kd with body gcfv[0,n) and the staged title, flags and
note revision; the slot, or 99 when no random id could be read
fn cozsave kd ulong n ulong to ulong
s = cozslot
if eq cozrand s false
ret ulong 99
end
put gczk s kd
put gczt s conow
put gczix s get fridx 0
put gczf s get gcsf 0
put gczbl s n
o = mul s 60000
for k ulong n bound 60000
put gczb add o k get gcfv k
end
cozsave2 s
ret s
end
fn cozsave2 s ulong to void
for k ulong 32
put gczcs add mul s 32 k get fcsrf k
end
for k ulong 40
put gcztg add mul s 40 k get gcid k
end
r = get gcsrv 0
put gczrn s add r 1
if lt r 64
for k ulong 40
put gczrv add mul s 40 k get gcrv add mul r 40 k
end
end
n = get gcstil 0
put gcztl s n
for k ulong n bound 256
put gczti add mul s 256 k get gcsti k
end
end
note cozrand s: the slot's id, 32 lowercase hex characters of 16 bytes from /dev/urandom
fn cozrand s ulong to bool
b = new uchar 16 0
fd = fopen tcurnd 0 len tcurnd 524288 0
if lt fd 0
ret false
end
r = read int fd b 0 16
x = fclose int fd
if ne r 16
ret false
end
for i ulong 16
v = get b i
put gczid add mul s 32 mul i 2 cohxd shr v 4
put gczid add add mul s 32 mul i 2 1 cohxd and v 15
end
ret true
end
fn cohxd v uchar to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
note cozfind a: the live slot whose id is frest[a,a+32), made in this session (CSRF token) for this
note repo; 99 when there is none
fn cozfind a ulong to ulong
if or ne get fcsrfl 0 32 gt add a 32 get frestl 0
ret ulong 99
end
for s ulong 32
if cozlive s
if cozmat s a
ret s
end
end
end
ret ulong 99
end
fn cozmat s ulong a ulong to bool
if ne get gczix s get fridx 0
ret false
end
d = uchar 0
for k ulong 32
d = or d xor get gczid add mul s 32 k get frest add a k
d = or d xor get gczcs add mul s 32 k get fcsrf k
end
ret eq d 0
end

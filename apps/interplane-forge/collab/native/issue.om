note collab/co5iss.om: issues from the native issue store (GitHub import contract r1 G3; docs/API.md
note forge/issues/1, forge/issue/1). The store is <data>issues/<owner>/<repo>/: an index file of lines
note "<id>\n" (16 lowercase hex) and one folder per issue with title, description, status ("open\n" or
note "closed\n"), labels (one per line), gh (number, login, opened, closed, reason lines), thread and
note source.json for imports, or native metadata for web writes. Nothing here reads Radicle storage.
note A native-comment record holds the author DID and form token before the length.
note A thread is a run of records "<kind> <time> <login> [<state> | <line> <pathlen>] <len>\n" then
note [<path>\n] <body>\n with kind comment, review or review-comment.
note An imported issue names its GitHub author as plain text, "Imported from GitHub <owner>/<repo>#<n>,
note by <login>": never a link, an account of this forge or a DID (G1).
note Prefixes: functions ni*, globals gn*, texts tn*.
text tniwnat "native"
text tniwdid "did "
text tniwncom "native-comment"
text tniss "issues/"
text tnindex "index"
text tnfttl "title"
text tnfdsc "description"
text tnfsts "status"
text tnfgh "gh"
text tnfthr "thread"
text tnflab "labels"
text tnfsrc "source.json"
text tnghn "number "
text tnghl "login "
text tnghop "opened "
text tnghcl "closed "
text tnghre "reason "
text tnjow "\"owner\":\""
text tnjrp "\"repo\":\""
text tnrcom "comment"
text tnrrev "review"
text tnrrc "review-comment"
text tnimp1 "Imported from GitHub "
text tnimp2 ", by "
text tnmeta "<p class=\"meta\">"
text tnmetae "</p>\n"
text tnli3 "<p class=\"meta\"><code>#"
text tnli4 "</code> &#183; opened "
text tnli5 " comment"
text tnph1 "<section class=\"rhead\"><h1>"
text tnph2 "</h1>\n"
text tnclo " &#183; closed "
text tnreas " (reason "
text tnlab "Labels: "
text tnbox "<section class=\"box\"><p class=\"meta\">"
text tnwrote " wrote on "
text tnrevd " reviewed ("
text tnrevd2 ") on "
text tnrcon " commented on <code>"
text tnline "</code> line "
text tnon " on "
text tnsece "</section>\n"
text tnnocm "<p class=\"muted\">No comments.</p>\n"
text tnutc " UTC"
text tntiss " - issue - "
text tnmd1 "<article class=\"md\">\n"
text tnmd2 "</article>\n"
text tnpkey "page"
text tnpp "per_page"
text tnnext "next"
text tnprev "prev"
text tnpage "&amp;page="
text tnpjson "&page="
text tnnava "<nav aria-label=\"Issue pages\">"
text tnnavz "</nav>\n"
text tnpnext "Next"
text tnpprev "Previous"
const NIPAGE ulong 30
const NIROWS ulong 262144
const NILEG ulong 200
global gnpage ulong 1
global gnmatch ulong 1
global gnpaged ulong 1
note the index of the repository's store (17 bytes per id line) and its count
global gnix uchar 4456448
global gnn ulong 1
note one issue's thread file, a small file (title, gh, status, source.json) and its length
global gnth uchar 16777216
global gnthl ulong 1
global gnf uchar 65536
global gnfl ulong 1
global gngh uchar 65536
global gnghl ulong 1
global gnative ulong 1
note a parsed thread record: kind (1 comment 2 review 3 review comment), time, login, state, line,
note path and body as offsets and lengths into gnth
global gnr ulong 16

note ---- paths and reads
fn nipath to void
fpb
fpt tfdata
fpt tniss
fpt tfowner
fpc 47
r = get fridx 0
for i ulong get fanl r bound 128
fpc frnbyte r i
end
fpc 47
end
fn nipf k ulong t view uchar * to void
nipath
for i ulong 16
fpc get gnix add mul k 17 i
end
fpc 47
fpt t
end
note niidx: the ids of the index into gnix (lines that are not 16 lowercase hex and a line feed are
note left out); a missing index is an empty store. false when the index does not fit the table.
fn niidx to bool
put gnn 0 0
nipath
fpt tnindex
r = frdall
if lt r 0
ret true
end
if ne get fxotr 0 0
fincut
ret false
end
n = div ulong r 17
if gt n 262144
fincut
ret false
end
m = ulong 0
for j ulong n bound 262144
if niidok mul j 17
nicp mul j 17 mul m 17
m = add m 1
end
end
put gnn 0 m
ret true
end
fn nicp a ulong b ulong to void
for i ulong 17
put gnix add b i get fxo add a i
end
end
fn niidok o ulong to bool
for i ulong 16
c = get fxo add o i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret eq get fxo add o 16 10
end
note nismall k t: the file t of issue k into gnf (at most 65536 bytes are kept); its length
fn nismall k ulong t view uchar * to ulong
put gnfl 0 0
nipf k t
r = frdall
if lt r 0
ret 0
end
n = ulong r
if gt n 65536
n = ulong 65536
end
for i ulong n bound 65536
put gnf i get fxo i
end
put gnfl 0 n
ret n
end
note nistate k: 0 open, 2 closed (the states of costbadge 2)
fn nistate k ulong to ulong
n = nismall k tnfsts
if and eq n 5 eq get gnf 0 111
ret 0
end
ret 2
end
note nigh k: the gh file of issue k into gngh
fn nigh k ulong to void
n = nismall k tniwnat
put gnative 0 0
if eq n 0
n = nismall k tnfgh
else
put gnative 0 1
end
for i ulong n bound 65536
put gngh i get gnf i
end
put gnghl 0 n
end
note nighv t: the value of the gh line "<t><value>\n": its offset in gngh; its length in gnr 15
fn nighv t view uchar * to ulong
n = get gnghl 0
s = ulong 0
for i ulong n bound 65536
if eq get gngh i 10
if nighat s i t
put gnr 15 sub sub i s len t
ret add s len t
end
s = add i 1
end
end
put gnr 15 0
ret 0
end
fn nighat s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
for i ulong len t bound 16
if ne get gngh add s i get t i
ret false
end
end
ret true
end
note nighp t: the gh value t, HTML-escaped
fn nighp t view uchar * to void
o = nighv t
for i ulong get gnr 15 bound 65536
fescc get gngh add o i
end
end
note nijv t: in gnf (a source.json), the string value after t (plain names), HTML-escaped
fn nijv t view uchar * to void
n = get gnfl 0
for s ulong n bound 65536
if nijat s t
p = add s len t
while lt p n bound 65536
c = get gnf p
if eq c 34
ret
end
fescc c
p = add p 1
end
ret
end
end
end
fn nijat s ulong t view uchar * to bool
if gt add s len t get gnfl 0
ret false
end
for i ulong len t bound 16
if ne get gnf add s i get t i
ret false
end
end
ret true
end
note nithr k: the thread of issue k into gnth; false when it does not fit
fn nithr k ulong to bool
put gnthl 0 0
nipf k tnfthr
r = frdall
if lt r 0
ret true
end
if ne get fxotr 0 0
ret false
end
for i ulong ulong r bound 16777216
put gnth i get fxo i
end
put gnthl 0 ulong r
ret true
end

note ---- thread records
global gnbad ulong 1
global gncur ulong 1
fn niword a ulong to void
put gnr add a 1 0
if ne get gnbad 0 0
ret
end
p = get gncur 0
n = get gnthl 0
q = p
while lt q n bound 257
if le get gnth q 32
break
end
if ge sub q p 256
put gnbad 0 1
ret
end
q = add q 1
end
if or ge q n eq q p
put gnbad 0 1
ret
end
if ne get gnth q 32
put gnbad 0 1
ret
end
put gnr a p
put gnr add a 1 sub q p
put gncur 0 add q 1
end
note nidec t: the decimal at gncur (1..18 digits) ended by the byte t; gncur moves past t. gnbad is
note set when it is not one. At most 19 passes: the pass that sees an 19th digit returns.
fn nidec t uchar to ulong
if ne get gnbad 0 0
ret 0
end
p = get gncur 0
n = get gnthl 0
v = ulong 0
k = ulong 0
while lt p n bound 19
c = get gnth p
if not fisdig c
break
end
if ge k 18
put gnbad 0 1
ret 0
end
v = add mul v 10 ulong sub c 48
k = add k 1
p = add p 1
end
if or eq k 0 ge p n
put gnbad 0 1
ret 0
end
if ne get gnth p t
put gnbad 0 1
ret 0
end
put gncur 0 add p 1
ret v
end
note niwordis a t: the word of gnr a, a+1 is t
fn niwordis a ulong t view uchar * to bool
if ne get gnr add a 1 len t
ret false
end
o = get gnr a
for i ulong len t bound 16
if ne get gnth add o i get t i
ret false
end
end
ret true
end
note nikind: the record kind of the word in gnr 12, 13: 1 comment, 2 review, 3 review-comment, else 0
fn nikind to ulong
if niwordis 12 tnrcom
ret 1
end
if niwordis 12 tniwncom
ret 4
end
if niwordis 12 tnrrev
ret 2
end
if niwordis 12 tnrrc
ret 3
end
ret 0
end
note nitok: the time word (gnr 1, 2) is 20 bytes or "-"
fn nitok to bool
k = get gnr 2
if eq k 20
ret true
end
if ne k 1
ret false
end
ret eq get gnth get gnr 1 45
end
note nirec p: parse the record at p into gnr (0 kind, 1-2 time, 3-4 login, 5-6 state, 7 line, 8-9
note path, 10-11 body); the index after it. A malformed record leaves kind 0 and returns the thread's
note length, which stops the caller: every length is checked against the thread before the bytes it
note names are read (a path is at most 4096 bytes).
fn nirec p ulong to ulong
n = get gnthl 0
put gnr 0 0
put gnr 6 0
put gnr 7 0
put gnr 9 0
put gnbad 0 0
put gncur 0 p
niword 12
k = nikind
if eq k 0
ret n
end
niword 1
niword 3
if or eq k 2 eq k 4
niword 5
end
if eq k 3
put gnr 7 nidec 32
put gnr 9 nidec 32
end
b = nidec 10
if ne get gnbad 0 0
ret n
end
if not nitok
ret n
end
q = get gncur 0
if eq k 3
m = get gnr 9
if or gt m 4096 ge add q m n
ret n
end
if ne get gnth add q m 10
ret n
end
put gnr 8 q
q = add add q m 1
end
if ge add q b n
ret n
end
if ne get gnth add q b 10
ret n
end
put gnr 10 q
put gnr 11 b
put gnr 0 k
ret add add q b 1
end
note nicount: the records of the loaded thread
fn nicount to ulong
p = ulong 0
c = ulong 0
n = get gnthl 0
while lt p n bound 16777216
p = nirec p
if ne get gnr 0 0
c = add c 1
end
end
ret c
end
note nitime o: the ISO time gnth[o, o+20) as YYYY-MM-DD HH:MM UTC
fn nitime o ulong to void
for i ulong 10
fescc get gnth add o i
end
fputc 32
for i ulong 5
fescc get gnth add add o 11 i
end
fput tnutc
end
note nighte t: the gh time value t as YYYY-MM-DD HH:MM UTC ("-" stays "-")
fn nighte t view uchar * to void
o = nighv t
if ne get gnr 15 20
fputc 45
ret
end
for i ulong 10
fescc get gngh add o i
end
fputc 32
for i ulong 5
fescc get gngh add add o 11 i
end
fput tnutc
end

note ---- the provenance line: Imported from GitHub <owner>/<repo>#<n>, by <login> (plain text)
fn niprov k ulong to void
x = nismall k tnfsrc
fput tnimp1
nijv tnjow
fputc 47
nijv tnjrp
fputc 35
nighp tnghn
fput tnimp2
nighp tnghl
end
fn niwho to void
if eq get gnative 0 1
nighp tniwdid
else
nighp tnghl
end
end
fn niorigin k ulong to void
if eq get gnative 0 1
niwho
else
niprov k
end
end
note niref: the request's id prefix (gcrq, 4..16 hex) names exactly one issue: its index, else gnn
fn niref to ulong
n = get gnn 0
q = get gcrql 0
if gt q 16
ret n
end
w = n
c = ulong 0
for k ulong n bound 262144
if nipre k q
w = k
c = add c 1
end
end
if ne c 1
ret n
end
ret w
end
fn nipre k ulong q ulong to bool
for i ulong q bound 16
if ne get gnix add mul k 17 i get gcrq i
ret false
end
end
ret true
end
fn nilink k ulong to void
fputrl
fput tcissp
for i ulong 16
fputc get gnix add mul k 17 i
end
end

note ---- the list page
note nifilt: the ?state= filter (0 open, 2 closed, 9 all; anything else open) and the tab counts in
note gccnt and gcsn (cotabs reads them)
fn nifilt to ulong
f = coqstate 2
if and ne f 2 ne f 9
f = ulong 0
end
for s ulong 8
put gccnt s 0
end
for k ulong get gnn 0 bound 262144
s = nistate k
put gccnt s add get gccnt s 1
end
put gcsn 0 get gnn 0
put gcm 9 2
ret f
end
note Keep list thread reads to one page. The status scan also supplies the filter counts.
fn nipagen f ulong to void
n = fqget tnpkey
put gnpaged 0 0
if ge n 0
put gnpaged 0 1
end
v = ulong 0
if and gt n 0 le n 6
for i ulong ulong n bound 6
c = get fval i
if not fisdig c
v = ulong 0
break
end
v = add mul v 10 ulong sub c 48
end
end
if eq v 0
v = ulong 1
end
put gnpage 0 v
put gnmatch 0 cotabnval f
end
fn cotabnval s ulong to ulong
if eq s 9
ret get gcsn 0
end
ret get gccnt s
end
fn nipageurl f ulong p ulong html bool to void
fputrl
fput tcisss
fput tcstq
cojsv 2 f
if html
fput tnpage
else
fput tnpjson
end
fnum p
end
fn nilnav f ulong to void
p = get gnpage 0
if and eq p 1 le get gnmatch 0 NIPAGE
ret
end
fput tnnava
if gt p 1
fput tcah
nipageurl f sub p 1 true
fput tcqg
fput tnpprev
fput tcae
cosp
end
if gt get gnmatch 0 mul p NIPAGE
fput tcah
nipageurl f add p 1 true
fput tcqg
fput tnpnext
fput tcae
end
fput tnnavz
end
fn nilist to long
if not niidx
ret 500
end
f = nifilt
nipagen f
fsetti tciss
frepohd 6
ftic 32
ftirepo
fput tclh1
costname 2 f
fput tclh2
cotabs 2 f
fput tclh3
niwlink
m = ulong 0
fput tclul
skip = mul sub get gnpage 0 1 NIPAGE
for j ulong get gnn 0 bound 262144
k = sub sub get gnn 0 1 j
s = nistate k
if or eq f 9 eq f s
if ge m skip
if not nirow k s
ret 500
end
end
m = add m 1
if eq m add skip NIPAGE
break
end
end
end
fput tcluln
if le m skip
fput tclnone
end
nilnav f
ret 200
end
fn nirow k ulong s ulong to bool
fput tcli1
nilink k
fput tcqg
n = nismall k tnfttl
if eq n 0
fput tcnot
end
for i ulong n bound 65536
fescc get gnf i
end
fput tcli2
costbadge 2 s
nigh k
if eq get gnative 0 0
fput tnli3
nighp tnghn
fput tnli4
nighte tnghop
else
fput tnmeta
fput tcopen
cosp
nighte tnghop
end
fput tcmidd
if not nithr k
ret false
end
c = nicount
fnum c
fput tnli5
if ne c 1
fputc 115
end
fput tcli7
fput tnmeta
niorigin k
fput tnmetae
fput tcli10
ret true
end

note ---- one issue page
fn nipage to long
if not niidx
ret 500
end
k = niref
if ge k get gnn 0
ret 404
end
s = nistate k
n = nismall k tnfttl
put ftil 0 0
for i ulong hmin n 256 bound 256
ftic get gnf i
end
for i ulong len tntiss
ftic get tntiss i
end
ftirepo
frepohd 6
fput tnph1
if eq n 0
fput tcnot
end
for i ulong n bound 65536
fescc get gnf i
end
fput tnph2
nigh k
fput tnmeta
costbadge 2 s
fput tcmidd
if eq get gnative 0 0
fputc 35
nighp tnghn
fput tcmidd
end
fput tcopen
cosp
nighte tnghop
if eq s 2
fput tnclo
nighte tnghcl
x = nighv tnghre
if gt get gnr 15 1
fput tnreas
nighp tnghre
fputc 41
end
end
fput tnmetae
fput tnmeta
niorigin k
fput tnmetae
nilabs k
fput tnsece
if not nibody k
ret 500
end
if not nithr k
ret 500
end
nicoms
niwform k false
ret 200
end
fn nilabs k ulong to void
n = nismall k tnflab
if eq n 0
ret
end
fput tnmeta
fput tnlab
for i ulong n bound 65536
c = get gnf i
if eq c 10
if lt add i 1 n
fputc 44
fputc 32
end
else
fescc c
end
end
fput tnmetae
end
note nibody k: the description as Markdown (the default branch for relative links)
fn nibody k ulong to bool
nipf k tnfdsc
r = frdall
if le r 0
ret true
end
if ne get fxotr 0 0
ret false
end
codrefb
fput tnbox
niwho
fput tnwrote
nighte tnghop
fput tnmetae
put gbmdl 0 0
fput tnmd1
brmd 0 ulong r
fput tnmd2
fput tnsece
ret true
end
fn nicoms to void
p = ulong 0
c = ulong 0
n = get gnthl 0
while lt p n bound 16777216
p = nirec p
if ne get gnr 0 0
nicom
c = add c 1
end
end
if eq c 0
fput tnnocm
end
end
note nicom: the parsed record (gnr) as a comment box; the login is text, the body Markdown
fn nicom to void
k = get gnr 0
fput tnbox
niraw 3
if or eq k 1 eq k 4
fput tnwrote
end
if eq k 2
fput tnrevd
niraw 5
fput tnrevd2
end
if eq k 3
fput tnrcon
niraw 8
fput tnline
fnum get gnr 7
fput tnon
end
if eq get gnr 2 20
nitime get gnr 1
else
fputc 45
end
fput tnmetae
o = get gnr 10
b = get gnr 11
if gt b 0
for i ulong b bound 16777216
put fxo i get gnth add o i
end
put gbmdl 0 0
fput tnmd1
brmd 0 b
fput tnmd2
end
fput tnsece
end
note niraw a: the bytes gnth[gnr a, + gnr a+1), HTML-escaped
fn niraw a ulong to void
o = get gnr a
for i ulong get gnr add a 1 bound 16777216
fescc get gnth add o i
end
end

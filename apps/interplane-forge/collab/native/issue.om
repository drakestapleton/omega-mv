note collab/co5iss.om: issues from the native issue store (GitHub import contract r1 G3; docs/API.md
note forge/issues/1, forge/issue/1). The store is <data>issues/<owner>/<repo>/: an index file of lines
note "<id>\n" (16 lowercase hex) and one folder per issue with title, description, status ("open\n" or
note "closed\n"), labels (one per line), gh (number, login, opened, closed, reason lines), thread and
note source.json, written by tools/ghimport. Nothing here reads Radicle storage.
note A thread is a run of records "<kind> <time> <login> [<state> | <line> <pathlen>] <len>\n" then
note [<path>\n] <body>\n with kind comment, review or review-comment.
note An imported issue names its GitHub author as plain text, "Imported from GitHub <owner>/<repo>#<n>,
note by <login>": never a link, an account of this forge or a DID (G1).
note Prefixes: functions ni*, globals gn*, texts tn*.
text tniss "issues/"
text tnindex "index"
text tnfttl "title"
text tnfdsc "description"
text tnfsts "status"
text tnfgh "gh"
text tnfthr "thread"
text tnflab "labels"
text tnfsrc "source.json"
text tnghn "number "
text tnghl "login "
text tnghop "opened "
text tnghcl "closed "
text tnghre "reason "
text tnjow "\"owner\":\""
text tnjrp "\"repo\":\""
text tnrcom "comment"
text tnrrev "review"
text tnrrc "review-comment"
text tnimp1 "Imported from GitHub "
text tnimp2 ", by "
text tnmeta "<p class=\"meta\">"
text tnmetae "</p>\n"
text tnli3 "<p class=\"meta\"><code>#"
text tnli4 "</code> &#183; opened "
text tnli5 " comment"
text tnnote "<p class=\"muted\">These issues were imported from GitHub. Each issue shows its original author.</p>\n"
text tnph1 "<section class=\"rhead\"><h1>"
text tnph2 "</h1>\n"
text tnclo " &#183; closed "
text tnreas " (reason "
text tnlab "Labels: "
text tnbox "<section class=\"box\"><p class=\"meta\">"
text tnwrote " wrote on "
text tnrevd " reviewed ("
text tnrevd2 ") on "
text tnrcon " commented on <code>"
text tnline "</code> line "
text tnon " on "
text tnsece "</section>\n"
text tnnocm "<p class=\"muted\">No comments.</p>\n"
text tnutc " UTC"
text tntiss " - issue - "
text tnmd1 "<article class=\"md\">\n"
text tnmd2 "</article>\n"
note the index of the repository's store (17 bytes per id line) and its count
global gnix uchar 4456448
global gnn ulong 1
note one issue's thread file, a small file (title, gh, status, source.json) and its length
global gnth uchar 16777216
global gnthl ulong 1
global gnf uchar 65536
global gnfl ulong 1
global gngh uchar 65536
global gnghl ulong 1
note a parsed thread record: kind (1 comment 2 review 3 review comment), time, login, state, line,
note path and body as offsets and lengths into gnth
global gnr ulong 16

note ---- paths and reads
fn nipath to void
fpb
fpt tfdata
fpt tniss
for i ulong get fownl 0 bound 64
fpc get fown i
end
fpc 47
for i ulong get frepol 0 bound 128
fpc get frepo i
end
fpc 47
end
fn nipf k ulong t view uchar * to void
nipath
for i ulong 16
fpc get gnix add mul k 17 i
end
fpc 47
fpt t
end
note niidx: the ids of the index into gnix (lines that are not 16 lowercase hex and a line feed are
note left out); a missing index is an empty store. false when the index does not fit the table.
fn niidx to bool
put gnn 0 0
nipath
fpt tnindex
r = frdall
if lt r 0
ret true
end
if ne get fxotr 0 0
fincut
ret false
end
n = div ulong r 17
if gt n 262144
fincut
ret false
end
m = ulong 0
for j ulong n bound 262144
if niidok mul j 17
nicp mul j 17 mul m 17
m = add m 1
end
end
put gnn 0 m
ret true
end
fn nicp a ulong b ulong to void
for i ulong 17
put gnix add b i get fxo add a i
end
end
fn niidok o ulong to bool
for i ulong 16
c = get fxo add o i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret eq get fxo add o 16 10
end
note nismall k t: the file t of issue k into gnf (at most 65536 bytes are kept); its length
fn nismall k ulong t view uchar * to ulong
put gnfl 0 0
nipf k t
r = frdall
if lt r 0
ret 0
end
n = ulong r
if gt n 65536
n = ulong 65536
end
for i ulong n bound 65536
put gnf i get fxo i
end
put gnfl 0 n
ret n
end
note nistate k: 0 open, 2 closed (the states of costbadge 2)
fn nistate k ulong to ulong
n = nismall k tnfsts
if and eq n 5 eq get gnf 0 111
ret 0
end
ret 2
end
note nigh k: the gh file of issue k into gngh
fn nigh k ulong to void
n = nismall k tnfgh
for i ulong n bound 65536
put gngh i get gnf i
end
put gnghl 0 n
end
note nighv t: the value of the gh line "<t><value>\n": its offset in gngh; its length in gnr 15
fn nighv t view uchar * to ulong
n = get gnghl 0
s = ulong 0
for i ulong n bound 65536
if eq get gngh i 10
if nighat s i t
put gnr 15 sub sub i s len t
ret add s len t
end
s = add i 1
end
end
put gnr 15 0
ret 0
end
fn nighat s ulong e ulong t view uchar * to bool
if lt sub e s len t
ret false
end
for i ulong len t bound 16
if ne get gngh add s i get t i
ret false
end
end
ret true
end
note nighp t: the gh value t, HTML-escaped
fn nighp t view uchar * to void
o = nighv t
for i ulong get gnr 15 bound 65536
fescc get gngh add o i
end
end
note nijv t: in gnf (a source.json), the string value after t (plain names), HTML-escaped
fn nijv t view uchar * to void
n = get gnfl 0
for s ulong n bound 65536
if nijat s t
p = add s len t
while lt p n bound 65536
c = get gnf p
if eq c 34
ret
end
fescc c
p = add p 1
end
ret
end
end
end
fn nijat s ulong t view uchar * to bool
if gt add s len t get gnfl 0
ret false
end
for i ulong len t bound 16
if ne get gnf add s i get t i
ret false
end
end
ret true
end
note nithr k: the thread of issue k into gnth; false when it does not fit
fn nithr k ulong to bool
put gnthl 0 0
nipf k tnfthr
r = frdall
if lt r 0
ret true
end
if ne get fxotr 0 0
ret false
end
for i ulong ulong r bound 16777216
put gnth i get fxo i
end
put gnthl 0 ulong r
ret true
end

note ---- thread records
note nidec p: the decimal at gnth[p..) up to a space or line feed; its end in gnr 14
fn nidec p ulong to ulong
v = ulong 0
q = p
n = get gnthl 0
while lt q n bound 24
c = get gnth q
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
q = add q 1
end
put gnr 14 q
ret v
end
note niword p: the bytes up to the next space from p: start in gnr a, length in gnr b; the index after it
fn niword p ulong a ulong b ulong to ulong
n = get gnthl 0
q = p
while lt q n bound 4096
if le get gnth q 32
break
end
q = add q 1
end
put gnr a p
put gnr b sub q p
ret add q 1
end
fn nikind p ulong e ulong to ulong
if nieq p e tnrcom
ret 1
end
if nieq p e tnrrev
ret 2
end
if nieq p e tnrrc
ret 3
end
ret 0
end
fn nieq p ulong e ulong t view uchar * to bool
if ne sub e p len t
ret false
end
for i ulong len t bound 16
if ne get gnth add p i get t i
ret false
end
end
ret true
end
note nirec p: parse the record at p into gnr (0 kind, 1-2 time, 3-4 login, 5-6 state, 7 line, 8-9 path,
note 10-11 body); the index after it, or the thread's length (stop) when it is malformed
fn nirec p ulong to ulong
n = get gnthl 0
q = niword p 12 13
k = nikind get gnr 12 add get gnr 12 get gnr 13
put gnr 0 k
if eq k 0
ret n
end
q = niword q 1 2
q = niword q 3 4
put gnr 6 0
put gnr 9 0
if eq k 2
q = niword q 5 6
end
if eq k 3
put gnr 7 nidec q
q = add get gnr 14 1
pl = nidec q
q = add get gnr 14 1
put gnr 8 0
put gnr 9 pl
end
b = nidec q
q = add get gnr 14 1
if eq k 3
put gnr 8 q
q = add add q get gnr 9 1
end
put gnr 10 q
put gnr 11 b
e = add add q b 1
if gt e n
ret n
end
ret e
end
note nicount: the records of the loaded thread
fn nicount to ulong
p = ulong 0
c = ulong 0
n = get gnthl 0
while lt p n bound 16777216
p = nirec p
if ne get gnr 0 0
c = add c 1
end
end
ret c
end
note nitime o: the ISO time gnth[o, o+20) as YYYY-MM-DD HH:MM UTC
fn nitime o ulong to void
for i ulong 10
fputc get gnth add o i
end
fputc 32
for i ulong 5
fputc get gnth add add o 11 i
end
fput tnutc
end
note nighte t: the gh time value t as YYYY-MM-DD HH:MM UTC ("-" stays "-")
fn nighte t view uchar * to void
o = nighv t
if ne get gnr 15 20
fputc 45
ret
end
for i ulong 10
fputc get gngh add o i
end
fputc 32
for i ulong 5
fputc get gngh add add o 11 i
end
fput tnutc
end

note ---- the provenance line: Imported from GitHub <owner>/<repo>#<n>, by <login> (plain text)
fn niprov k ulong to void
x = nismall k tnfsrc
fput tnimp1
nijv tnjow
fputc 47
nijv tnjrp
fputc 35
nighp tnghn
fput tnimp2
nighp tnghl
end
note niref: the request's id prefix (gcrq, 4..40 hex) names exactly one issue: its index, else gnn
fn niref to ulong
n = get gnn 0
q = get gcrql 0
if gt q 16
ret n
end
w = n
c = ulong 0
for k ulong n bound 262144
if nipre k q
w = k
c = add c 1
end
end
if ne c 1
ret n
end
ret w
end
fn nipre k ulong q ulong to bool
for i ulong q bound 16
if ne get gnix add mul k 17 i get gcrq i
ret false
end
end
ret true
end
fn nilink k ulong to void
fputrl
fput tcissp
for i ulong 16
fputc get gnix add mul k 17 i
end
end

note ---- the list page
note nifilt: the ?state= filter (0 open, 2 closed, 9 all; anything else open) and the tab counts in
note gccnt and gcsn (cotabs reads them)
fn nifilt to ulong
f = coqstate 2
if and ne f 2 ne f 9
f = ulong 0
end
for s ulong 8
put gccnt s 0
end
for k ulong get gnn 0 bound 262144
s = nistate k
put gccnt s add get gccnt s 1
end
put gcsn 0 get gnn 0
put gcm 9 2
ret f
end
fn nilist to long
if not niidx
ret 500
end
f = nifilt
fsetti tciss
frepohd 6
ftic 32
ftirepo
fput tclh1
costname 2 f
fput tclh2
cotabs 2 f
fput tclh3
m = ulong 0
fput tclul
for k ulong get gnn 0 bound 262144
s = nistate k
if or eq f 9 eq f s
if not nirow k s
ret 500
end
m = add m 1
end
end
fput tcluln
if eq m 0
fput tclnone
end
fput tnnote
ret 200
end
fn nirow k ulong s ulong to bool
fput tcli1
nilink k
fput tcqg
n = nismall k tnfttl
if eq n 0
fput tcnot
end
for i ulong n bound 65536
fescc get gnf i
end
fput tcli2
costbadge 2 s
nigh k
fput tnli3
nighp tnghn
fput tnli4
nighte tnghop
fput tcmidd
if not nithr k
ret false
end
c = nicount
fnum c
fput tnli5
if ne c 1
fputc 115
end
fput tcli7
fput tnmeta
niprov k
fput tnmetae
fput tcli10
ret true
end

note ---- one issue page
fn nipage to long
if not niidx
ret 500
end
k = niref
if ge k get gnn 0
ret 404
end
s = nistate k
n = nismall k tnfttl
put ftil 0 0
for i ulong hmin n 256 bound 256
ftic get gnf i
end
for i ulong len tntiss
ftic get tntiss i
end
ftirepo
frepohd 6
fput tnph1
if eq n 0
fput tcnot
end
for i ulong n bound 65536
fescc get gnf i
end
fput tnph2
nigh k
fput tnmeta
costbadge 2 s
fput tcmidd
fputc 35
nighp tnghn
fput tcmidd
fput tcopen
cosp
nighte tnghop
if eq s 2
fput tnclo
nighte tnghcl
x = nighv tnghre
if gt get gnr 15 1
fput tnreas
nighp tnghre
fputc 41
end
end
fput tnmetae
fput tnmeta
niprov k
fput tnmetae
nilabs k
fput tnsece
if not nibody k
ret 500
end
if not nithr k
ret 500
end
nicoms
fput tnnote
ret 200
end
fn nilabs k ulong to void
n = nismall k tnflab
if eq n 0
ret
end
fput tnmeta
fput tnlab
for i ulong n bound 65536
c = get gnf i
if eq c 10
if lt add i 1 n
fputc 44
fputc 32
end
else
fescc c
end
end
fput tnmetae
end
note nibody k: the description as Markdown (the default branch for relative links)
fn nibody k ulong to bool
nipf k tnfdsc
r = frdall
if le r 0
ret true
end
if ne get fxotr 0 0
ret false
end
codrefb
fput tnbox
nighp tnghl
fput tnwrote
nighte tnghop
fput tnmetae
put gbmdl 0 0
fput tnmd1
brmd 0 ulong r
fput tnmd2
fput tnsece
ret true
end
fn nicoms to void
p = ulong 0
c = ulong 0
n = get gnthl 0
while lt p n bound 16777216
p = nirec p
if ne get gnr 0 0
nicom
c = add c 1
end
end
if eq c 0
fput tnnocm
end
end
note nicom: the parsed record (gnr) as a comment box; the login is text, the body Markdown
fn nicom to void
k = get gnr 0
fput tnbox
niraw 3
if eq k 1
fput tnwrote
end
if eq k 2
fput tnrevd
niraw 5
fput tnrevd2
end
if eq k 3
fput tnrcon
niraw 8
fput tnline
fnum get gnr 7
fput tnon
end
if eq get gnr 2 20
nitime get gnr 1
else
fputc 45
end
fput tnmetae
o = get gnr 10
b = get gnr 11
if gt b 0
for i ulong b bound 16777216
put fxo i get gnth add o i
end
put gbmdl 0 0
fput tnmd1
brmd 0 b
fput tnmd2
end
fput tnsece
end
note niraw a: the bytes gnth[gnr a, + gnr a+1), HTML-escaped
fn niraw a ulong to void
o = get gnr a
for i ulong get gnr add a 1 bound 16777216
fescc get gnth add o i
end
end

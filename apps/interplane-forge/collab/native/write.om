note Native issue writes. The author comes from the session established by SSH key proof. The
note repository lock serializes replacements of its index and threads, even across server processes.
text tniwnp "/issues/new"
text tniwlog "login"
text tniwlink "<p><a href=\""
text tniwnewa "\">New issue</a></p>\n"
text tniwttl "New issue"
text tniwform "<section class=\"box\" id=\"comment-form\">"
text tniwsign "<p><a href=\""
text tniwsgc "\">Sign in to comment</a></p>"
text tniwsgn "\">Sign in to open an issue</a></p>"
text tniwfa "<form method=\"post\" action=\""
text tniwcs "\"><input type=\"hidden\" name=\"csrf\" value=\""
text tniwrh "\"><input type=\"hidden\" name=\"request\" value=\""
text tniwqt "\">"
text tniwtf "<p><label>Title<br><input name=\"title\" required maxlength=\"256\"></label></p>"
text tniwdf "<p><label>Description (Markdown)<br><textarea name=\"body\" rows=\"8\" maxlength=\"16000\"></textarea></label></p>"
text tniwcf "<p><label>Comment (Markdown)<br><textarea name=\"body\" rows=\"6\" required maxlength=\"16000\"></textarea></label></p>"
text tniwbn "<p><button type=\"submit\">Open issue</button></p>"
text tniwbc "<p><button type=\"submit\">Post comment</button></p>"
text tniwfe "</form></section>\n"
text tniwrq "request"
text tniwrql "request "
text tniwmrq "Reload the form before sending it again."
text tniwfs "issue store: directory sync failed after publication\n"
text tniwft "title"
text tniwfb "body"
text tniwbadt "Enter a single-line title of 1 to 256 UTF-8 bytes."
text tniwbadb "Enter valid Markdown text of at most 16000 UTF-8 bytes. A comment cannot be empty."
text tniwopa "open\n"
text tniwlock ".write.lock"
text tniwist ".index.tmp"
text tniwtht ".thread.tmp"
text tniwstg ".new-"
text tniwdir "issues"
text tniwemp ""

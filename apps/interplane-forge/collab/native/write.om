note Publish the complete issue before replacing its index. After a crash between the renames the
note unindexed directory is unreachable. A normal index failure removes that unlisted directory.
fn niwcreate to long
niwnewid
nipath
fpt tnindex
n = niwread 69632
if eq n -2
n = 0
end
if eq n -27
ret 409
end
if or lt n 0 ne rem ulong n 17 0
ret 500
end
for j ulong div ulong n 17 bound 4096
p = mul j 17
if not niidok p
ret 500
end
if niwrow p
if niwexisting
ret -1
end
ret 409
end
end
if eq n 69632
ret 409
end
for i ulong 16
put fob i get gniwid i
end
put fob 16 10
nipath
fpt tniwist
x = unlink fpth 0 get fpthl 0
if not niwput 1 ulong n 17
ret 500
end
r = niwinst
if gt r 0
nipath
fpt tniwist
x = unlink fpth 0 get fpthl 0
end
ret r
end
fn niwrow p ulong to bool
for i ulong 16
if ne get fxo add p i get gniwid i
ret false
end
end
ret true
end
fn niwexisting to bool
niwpath false tniwnat
r = niwread 256
if le r 0
ret false

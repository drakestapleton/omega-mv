end
fn niwform k ulong opening bool to void
fput tniwform
if eq get gscur 0 0
fput tniwsign
fputb
fput tniwlog
if opening
fput tniwsgn
else
fput tniwsgc
end
fput tnsece
ret
end
raw = new uchar 16 0
hex = new uchar 32 0
if not sorand raw
fput tniwmrq
fput tnsece
ret
end
sohex raw hex
fput tniwfa
if opening
fputrl
fput tniwnp
else
nilink k
fput tncoms
end
fput tniwcs
for j ulong get fcsrfl 0 bound 64
fputc get fcsrf j
end
fput tniwrh
for j ulong 32
fputc get hex j
end
fput tniwqt
if opening
fput tniwtf
fput tniwdf
fput tniwbn
else
fput tniwcf
fput tniwbc
end
fput tniwfe
end
fn niwnew to long
fsetti tniwttl
frepohd 6
niwform 0 true
ret 200
end
fn niwerr t view uchar * to long
if fjwant
fyerr 400
note The common error envelope is used by all machine clients.
else
fput tnbox
fput t
fput tnmetae
fput tnsece
end
ret 400
end
fn niwfields opening bool to long
if ne cobfld tniwrq 32
ret niwerr tniwmrq
end
for i ulong 32
c = get gcfv i
if lt sohexv c 0
ret niwerr tniwmrq
end
put gniwrq i c
end
if opening
n = cobfld tniwft
if or lt n 1 gt n 256
ret niwerr tniwbadt
end
n = cotxtok ulong n false
if lt n 1
ret niwerr tniwbadt
end
put gniwtl 0 ulong n
for i ulong ulong n bound 256
put gniwtt i get gcfv i
end
end
b = cobfld tniwfb
if eq b -1
b = 0
end
if or lt b 0 gt b 16000
ret niwerr tniwbadb
end
b = cotxtok ulong b true
if or lt b 0 and not opening eq b 0
ret niwerr tniwbadb
end
put gcfvl 0 ulong b
ret 0
end
fn niwpost opening bool to long
r = sowpre
if ne r 0
ret r
end
r = niwfields opening
if ne r 0
ret r
end
fd = niwacq opening
if lt fd 0
if eq fd -2
ret 404
end
if eq fd -11
ret 503
end
ret 500
end
if opening
r = niwcreate
else
r = niwcomment
end
x = fclose int fd
if gt r 0
ret r
end
if eq r 0
soratev get gscur 0 get gsnow 0
end
put fkind 0 2
flocrepo
floct tcissp
for i ulong 16
flocc get gniwid i
end
ret 303
end

note ---- Storage
fn niwdirs to bool
fpb
fpt tfdata
fpt tniwdir
if not niwmkdir
ret false
end
fpc 47
fpt tfowner
if not niwmkdir
ret false
end
fpc 47
i = get fridx 0
for k ulong get fanl i bound 128
fpc frnbyte i k
end
ret niwmkdir
end
fn niwmkdir to bool
r = makedir fpth 0 get fpthl 0 448
ret or eq r 0 eq r -17
end
fn niwacq opening bool to long
if opening
if not niwdirs
ret -5
end
end
nipath
fpt tniwlock
fd = fopen fpth 0 get fpthl 0 557121 384
if lt fd 0
ret fd
end
r = flock int fd 6
if ne r 0
x = fclose int fd
ret r
end
ret fd
end
fn niwpath stage bool file view uchar * to void
nipath
if stage
fpt tniwstg
end
for i ulong 16
fpc get gniwid i
end
if ne len file 0
fpc 47
fpt file
end
end
fn niwarg to void
soavopen
for i ulong get fpthl 0 bound 4096
soavc get fpth i
end
end
note Source selectors: response buffer (0), file read buffer (1), title (2), form body (3), open status (4).
fn niwwrite fd int src ulong p ulong n ulong to long
if eq src 0
ret write fd fob p n
end
if eq src 1
ret write fd fxo p n
end
if eq src 2
ret write fd gniwtt p n
end
if eq src 3
ret write fd gcfv p n
end
ret write fd tniwopa p n
end
fn niwout fd int src ulong size ulong to bool
p = ulong 0
for i ulong 100000
if eq p size
ret true
end
n = niwwrite fd src p sub size p
if gt n 0
p = add p ulong n
else
if ne n -4
ret false
end
end
end
ret false
end
fn niwput src ulong size ulong tail ulong to bool
fd = fopen fpth 0 get fpthl 0 557249 384
if lt fd 0
ret false
end
ok = niwout int fd src size
if and ok gt tail 0
ok = niwout int fd 0 tail
end
if ok
ok = eq fsync int fd 0
end
r = fclose int fd
if or not ok ne r 0
x = unlink fpth 0 get fpthl 0
ret false
end
ret true
end
note Read a whole file into fxo under the write lock. Distinguish missing from other I/O errors.
fn niwread cap ulong to long
fd = fopen fpth 0 get fpthl 0 559104 0
if lt fd 0
ret fd
end
n = niwreadfd int fd cap
r = fclose int fd
ret n
end
fn niwreadfd fd int cap ulong to long
p = ulong 0
for i ulong 100000
if gt p cap
ret -27
end
n = read fd fxo p sub add cap 1 p
if eq n 0
ret long p
end
if gt n 0
p = add p ulong n
else
if ne n -4
ret n
end
end
end
ret -5
end
fn niwremove file view uchar * stage bool to void
niwpath stage file
x = unlink fpth 0 get fpthl 0
end
fn niwdiscard stage bool to void
niwremove tnfttl stage
niwremove tnfdsc stage
niwremove tnfsts stage
niwremove tniwnat stage
niwpath stage tniwemp
x = rmdir fpth 0 get fpthl 0
end
note Use the authenticated DID and the form token as a stable issue ID across retries.
fn niwnewid to void
seed = new uchar 160 0
hash = new uchar 32 0
hex = new uchar 16 0
for i ulong 32
put seed i get gniwrq i
end
d = get gscur 0
o = get gsso d
n = get gssl d
for i ulong n bound 128
put seed add i 32 get gsstr add o i
end
x = sha2_digest 256 part seed 0 add 32 n hash
sohex part hash 0 8 hex
for i ulong 16
put gniwid i get hex i
end
end
fn niwreq to void
for i ulong 32
fputc get gniwrq i
end
end
fn niwmeta to void
put fobl 0 0
fput tniwdid
niwactor
fputc 10
fput tnghop
fjisob get gsnow 0
fputc 10
fput tniwrql
niwreq
fputc 10
end
fn niwactor to void
d = get gscur 0
o = get gsso d
for i ulong get gssl d bound 128
fputc get gsstr add o i

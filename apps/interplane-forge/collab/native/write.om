for i ulong ulong r bound 256
put gngh i get fxo i
end
put gnghl 0 ulong r
if not niwmetasame
ret false
end
ret niwsame
end
fn niwmetasame to bool
d = get gscur 0
o = get gsso d
a = nighv tniwdid
if ne get gnr 15 get gssl d
ret false
end
for i ulong get gssl d bound 128
if ne get gngh add a i get gsstr add o i

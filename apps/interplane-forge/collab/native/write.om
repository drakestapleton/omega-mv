b = nighv tniwrql
if ne get gnr 15 32
ret false
end
for i ulong 32
if ne get gngh add b i get gniwrq i
ret false
end
end
ret true
end
fn niwsame to bool
niwpath false tnfttl
if ne niwread 256 long get gniwtl 0
ret false
end
for i ulong get gniwtl 0 bound 256
if ne get fxo i get gniwtt i
ret false
end

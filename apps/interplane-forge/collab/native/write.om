note Check the whole prefix before replacing it. An already-published form returns its prior result.
fn niwthread n ulong to long
for i ulong n bound 1048576
put gnth i get fxo i
end
put gnthl 0 n
p = ulong 0
while lt p n bound 1048576
p = nirec p
k = get gnr 0
if eq k 0
ret 409
end
if eq k 4
if niwcomreq
if niwcombody
ret -1
end
ret 409
end
end
end
ret 0
end
fn niwcomreq to bool
d = get gscur 0
n = get gssl d
if or ne get gnr 4 n ne get gnr 6 32
ret false

a = get gnr 3
o = get gsso d
for i ulong n bound 128
if ne get gnth add a i get gsstr add o i
ret false
end
end
b = get gnr 5
for i ulong 32
if ne get gnth add b i get gniwrq i
ret false
end
end
ret true
end
fn niwcombody to bool
n = get gcfvl 0
if ne n get gnr 11
ret false

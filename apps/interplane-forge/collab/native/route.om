note Only the native issue read routes are served by the signed-store build.
fn coroute to long
if not frstpre tcisss
ret 0
end
prefix = len tcisss
path_len = get frestl 0
if and gt path_len prefix ne get frest prefix 47
ret 0
end
method = get fmeth 0
if not or eq method 1 eq method 2
ret 404
end
start = add prefix 1
if le path_len start
if fjwant
ret nijlist
end
fyalt
ret nilist
end
size = sub path_len start
if or lt size 4 gt size 16
ret 404
end
for i ulong size bound 16
c = get frest add start i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret 404
end
put gcrq i c
end
put gcrql 0 size
if fjwant
ret nijone
end
fyalt
ret nipage
end

note Native issue list, detail, creation and comments. Prefixes are accepted only on reads.
text tnnew "new"
text tncoms "/comments"
fn niresat a ulong n ulong t view uchar * to bool
if ne sub n a len t
ret false
end
for i ulong len t bound 16
if ne get frest add a i get t i
ret false
end
end
ret true
end
fn niresid a ulong size ulong to bool
if or lt size 4 gt size 16
ret false
end
for i ulong size bound 16
c = get frest add a i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
put gcrq i c
end
put gcrql 0 size
ret true
end
fn coroute to long
if or ge get fridx 0 get fan 0 not frstpre tcisss
ret 0
end
prefix = len tcisss
n = get frestl 0
if and gt n prefix ne get frest prefix 47
ret 0
end
fsetepno
m = get fmeth 0
start = add prefix 1
if le n start
if ne m 1
ret 405
end
if fjwant
ret nijlist
end
fyalt
ret nilist
end
if niresat start n tnnew
if eq m 3
ret niwpost true
end
if eq m 1
ret niwnew
end
ret 405
end
stop = add start 16
if and gt n stop niresat stop n tncoms
if ne m 3
ret 405
end
if not niresid start 16
ret 404
end
ret niwpost false
end
if not niresid start sub n start
ret 404
end
if ne m 1
ret 405
end
if fjwant
ret nijone
end
fyalt
ret nipage
end

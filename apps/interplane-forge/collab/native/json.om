note nijgh t: the gh value t as a JSON string (null when "-" or absent)
fn nijgh t view uchar * to void
o = nighv t
n = get gnr 15
if or eq n 0 and eq n 1 eq get gngh o 45
fynull
ret
end
fjtb
for i ulong n bound 65536
fjtc get gngh add o i
end
fjstr
end
note nijsv t: in gnf (a source.json), the string value after t as a JSON string
fn nijsv t view uchar * to void
fjtb
n = get gnfl 0
for s ulong n bound 65536
if nijat s t
p = add s len t
while lt p n bound 65536
c = get gnf p
if eq c 34
break
end
fjtc c
p = add p 1
end
break
end
end
fjstr
end
note nighnum: imported issue number as a bounded decimal; invalid or missing is zero
fn nighnum to ulong
o = nighv tnghn
n = get gnr 15
if gt n 18
ret 0
end
v = ulong 0
for i ulong n bound 18
c = get gngh add o i
if not fisdig c
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end

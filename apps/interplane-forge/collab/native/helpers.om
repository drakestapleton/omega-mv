note HTML and JSON helpers shared by the imported issue views.
global gcrq uchar 16
global gcrql ulong 1
text tcid "id"
text tcdraft "draft"
text tcarch "archived"
text tcclosed "closed"
global gcm ulong 16
text tcah "<a href=\""
text tcqg "\">"
text tcae "</a>"
text tcissp "/issues/"
text tcpats "/patches"
text tcisss "/issues"
text tcnot "(no title)"
text tcmidd " &#183; "
text tcstq "?state="
text tcstn "state"
text tcopen "open"
text tcmerged "merged"
text tcall "all"
text tcsopen "Open"
text tcsdraft "Draft"
text tcsclos "Closed"
text tcsmerg "Merged"
text tcsarch "Archived"
text tcsall "All"
text tciss "Issues"
text tcbon "<b>"
text tcboff "</b>"
text tcopar " ("
text tccpar ")"
global gcsn ulong 1
global gccnt ulong 8
text tcbok "<b class=\"ok\">"
text tcbbad "<b class=\"bad\">"
text tcbmut "<b class=\"muted\">"
text tclh1 "<h2>"
text tclh2 "</h2>\n<p class=\"bar\">"
text tclh3 "</p>\n"
text tclul "<ul class=\"repos\">\n"
text tcluln "</ul>\n"
text tclnone "<p class=\"muted\">Nothing here in this state.</p>\n"
text tcli1 "<li><a class=\"rname\" href=\""
text tcli2 "</a> "
text tcli7 "</p>"
text tcli10 "</li>\n"

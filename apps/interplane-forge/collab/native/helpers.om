fn cosp to void
fputc 32
end
fn coqeq n long t view uchar * to bool
if ne ulong n len t
ret false
end
for i ulong len t
if ne get fval i get t i
ret false
end
end
ret true
end
fn coqstate kd ulong to ulong
n = fqget tcstn
if lt n 0
ret ulong 0
end
if coqeq n tcdraft
ret ulong 1
end
if or coqeq n tcclosed coqeq n tcarch
ret ulong 2
end
if coqeq n tcmerged
ret ulong 3
end
if coqeq n tcall
ret ulong 9
end
ret ulong 0
end
fn costname kd ulong s ulong to void
if eq s 9
fput tcsall
ret
end
if eq s 0
fput tcsopen
ret
end
if eq s 1
fput tcsdraft
ret
end
if eq s 3
fput tcsmerg
ret
end
if eq kd 1
fput tcsarch
ret
end
fput tcsclos
end
fn costbadge kd ulong s ulong to void
if or eq s 0 eq s 3
fput tcbok
else
if eq s 1
fput tcbmut
else
fput tcbbad
end
end
costname kd s
fput tcboff
end
fn cotab f ulong s ulong nm view uchar * v view uchar * to void
kd = get gcm 9
fput tcah
fputrl
if eq kd 1
fput tcpats
else
fput tcisss
end
fput tcstq
fput v
fput tcqg
if eq f s
fput tcbon
end
fput nm
fput tcopar
cotabn kd s
fput tccpar
if eq f s
fput tcboff
end
fput tcae
cosp
end
fn cotabn kd ulong s ulong to void
if eq s 9
fnum get gcsn 0
ret
end
fnum get gccnt s
end
fn cotabs kd ulong f ulong to void
cotab f 0 tcsopen tcopen
if eq kd 1
cotab f 1 tcsdraft tcdraft
cotab f 3 tcsmerg tcmerged
cotab f 2 tcsarch tcarch
else
cotab f 2 tcsclos tcclosed
end
cotab f 9 tcsall tcall
end
fn codrefb to void
i = get fridx 0
o = get fabo i
n = get fabl i
for k ulong n bound 64
put gbref k get fabr add o k
end
put gbrefl 0 n
end
fn cojq to void
fputc 34
end
fn cojsn kd ulong s ulong to void
cojq
cojsv kd s
cojq
end
fn cojsv kd ulong s ulong to void
if eq s 9
fput tcall
end
if eq s 0
fput tcopen
end
if eq s 1
fput tcdraft
end
if eq s 3
fput tcmerged
end
if eq s 2
if eq kd 1
fput tcarch
else
fput tcclosed
end
end
ret
end
fn cojtabs kd ulong to void
fputc 91
cojtab kd 0 false
if eq kd 1
cojtab kd 1 true
cojtab kd 3 true
cojtab kd 2 true
else
cojtab kd 2 true
end
cojtab kd 9 true
fputc 93
end
fn cojtab kd ulong s ulong c bool to void
if c
fputc 44
end
fputc 123
fyk0 tcstn
cojsn kd s
fyk tcjcnt
cotabn kd s
fyk tcjpath
cojq
fputrl
if eq kd 1
fput tcpats
else
fput tcisss
end
fput tcstq
cojsv kd s
cojq
fputc 125
end

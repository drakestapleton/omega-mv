note collab/co6route.om (ForgePatches): coroute, the collab entry point. Returns 0 when the path is not ours.
note /<o>/<r>/patches[?state=] and /pulls (alias) list patches; /patches/<id> one patch; /patches/<id>.diff
note (POST, compose/<cid> and issues|patches/new: Phase A, collab/co9form.om)
note the raw diff; /pulls/<id> and /pull/<id> redirect (302) to /patches/<id>; /issues and /issues/<id>.
note <id> is 4..40 lowercase hex, a prefix of exactly one COB id of this repo; anything else is 404.
text tcpulls "/pulls"
text tcpull "/pull"
text tccompr "/compose"
text tcnwr "new"
global gcoff ulong 1
fn coroute to long
if ge get fridx 0 get fan 0
ret 0
end
k = cosect
if eq k 0
ret 0
end
m = get fmeth 0
if eq m 3
ret copost k
end
if or eq m 1 eq m 2
ret codisp k
end
ret 405
end
note cosegis t: frest starts with the segment t, followed by its end or a slash
fn cosegis t view uchar * to bool
if eq frstpre t false
ret false
end
n = len t
if eq n get frestl 0
ret true
end
ret eq get frest n 47
end
note cosect: 1 /patches 2 /issues 3 /pulls 4 /pull, with the segment length in gcoff; 0 not ours
fn cosect to ulong
if cosegis tcpats
put gcoff 0 len tcpats
ret ulong 1
end
if cosegis tcisss
put gcoff 0 len tcisss
ret ulong 2
end
if cosegis tcpulls
put gcoff 0 len tcpulls
ret ulong 3
end
if cosegis tcpull
put gcoff 0 len tcpull
ret ulong 4
end
if cosegis tccompr
put gcoff 0 len tccompr
ret ulong 5
end
ret ulong 0
end
fn codisp k ulong to long
o = get gcoff 0
n = get frestl 0
if or eq o n eq add o 1 n
if eq k 4
ret 404
end
if eq k 2
ret colistx 2
end
ret colistx 1
end
if eq k 5
ret cocget
end
a = add o 1
if and le k 2 coseqat a n tcnwr
if eq k 2
ret conewpg 4
end
ret conewpg 5
end
if eq k 2
if cocpid a n
ret coissx
end
ret 404
end
if eq k 1
ret codispp a n
end
if cocpid a n
ret copulls
end
ret 404
end
note colistx kd, copatx, coissx: the JSON form (collab/coJjson.om) when the request asks for it, else
note the HTML page, which names its own URL as the JSON alternate (fyalt)
fn colistx kd ulong to long
if fjwant
ret cojlist kd
end
fyalt
ret colist kd
end
fn copatx to long
if fjwant
ret cojpat
end
fyalt
ret copatpg
end
fn coissx to long
if fjwant
ret cojiss
end
fyalt
ret coisspg
end
fn codispp a ulong n ulong to long
if gt n add a len tcdsuf
if codsuf n
if cocpid a sub n len tcdsuf
ret copraw
end
ret 404
end
end
if cocpid a n
ret copatx
end
ret 404
end
fn codsuf n ulong to bool
s = sub n len tcdsuf
for i ulong len tcdsuf
if ne get frest add s i get tcdsuf i
ret false
end
end
ret true
end
note cocpid a b: frest[a,b) is 4..40 lowercase hex; copied into gcrq
fn cocpid a ulong b ulong to bool
if le b a
ret false
end
n = sub b a
if or lt n 4 gt n 40
ret false
end
for i ulong n
if eq cohexc get frest add a i false
ret false
end
end
for i ulong n
put gcrq i get frest add a i
end
put gcrql 0 n
ret true
end
note copulls: /pulls/<id> and /pull/<id> name the same page as /patches/<id>
fn copulls to long
put fkind 0 2
flocrepo
floct tcpatp
for i ulong get gcrql 0 bound 40
flocc get gcrq i
end
ret 302
end

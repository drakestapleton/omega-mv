note collab/co3view.om (ForgePatches): shared rendering for patch and issue pages, and the list pages.
note Class names come from server/forge.css only (box meta muted mono ok bad hit repos rname bar rhead).
text tcah "<a href=\""
text tcqg "\">"
text tcae "</a>"
text tcpatp "/patches/"
text tcissp "/issues/"
text tcpats "/patches"
text tcisss "/issues"
text tcdidk "did:key:"
text tcutc " UTC"
text tcsp1 "<span class=\"muted mono\">"
text tcspe "</span>"
text tcnot "(no title)"
text tcmidd " &#183; "
text tcstq "?state="
text tcstn "state"
text tcopen "open"
text tcmerged "merged"
text tcall "all"
text tcsopen "Open"
text tcsdraft "Draft"
text tcsclos "Closed"
text tcsmerg "Merged"
text tcsarch "Archived"
text tcsall "All"
text tcpat "Patches"
text tciss "Issues"
text tcbon "<b>"
text tcboff "</b>"
text tcopar " ("
text tccpar ")"
note list summaries (at most 200 COBs per list page)
global gcss ulong 256
global gcsu ulong 256
global gcsc ulong 256
global gcsk ulong 256
global gcsr ulong 256
global gcst ulong 512
global gclp uchar 262144
global gclpl ulong 1
global gcsv uchar 32768
global gcsvl ulong 256
global gcsau uchar 16384
global gcsal ulong 256
global gcsn ulong 1
global gccnt ulong 8
note ---- byte output helpers
fn copool o ulong n ulong to void
for i ulong n bound 4194304
fescc get gcpool add o i
end
end
fn copoolm k ulong to void
o = get gcm k
n = get gcm add k 1
copool o n
end
fn coidh n ulong to void
for k ulong n bound 40
fputc get gcid k
end
end
fn corhex r ulong n ulong to void
for k ulong n bound 40
fputc get gcrv add mul r 40 k
end
end
fn cobhex r ulong n ulong to void
for k ulong n bound 40
fputc get gcrb add mul r 40 k
end
end
fn cohhex r ulong n ulong to void
for k ulong n bound 40
fputc get gcro add mul r 40 k
end
end
fn comhex m ulong n ulong to void
for k ulong n bound 40
fputc get gcmc add mul m 40 k
end
end
fn cochex ci ulong n ulong to void
for k ulong n bound 40
fputc get gcch add mul ci 40 k
end
end
fn cosp to void
fputc 32
end
note coisown: change ci was written by the node delegate (owner drakestapleton)
fn coisown ci ulong to bool
if ne get gccal ci len tfnid
ret false
end
for i ulong len tfnid
if ne get gccau add mul ci 64 i get tfnid i
ret false
end
end
ret true
end
fn codid ci ulong to void
fput tcdidk
for i ulong get gccal ci bound 64
fescc get gccau add mul ci 64 i
end
end
note coauth: the author of change ci: the owner name when it is the delegate, and the DID
fn coauth ci ulong to void
if coisown ci
fput tcah
fputb
fput tfowner
fput tcqg
fput tfowner
fput tcae
cosp
end
fput tcsp1
codid ci
fput tcspe
end
note ---- dates: seconds since 1970 to YYYY-MM-DD HH:MM UTC (days to civil date, proleptic Gregorian)
fn co2d v ulong to void
if lt v 10
fputc 48
end
fnum v
end
fn codate t ulong to void
cociv div t 86400
cosp
s = rem t 86400
co2d div s 3600
fputc 58
co2d div rem s 3600 60
fput tcutc
end
fn codateo t ulong to void
cociv div t 86400
end
fn cociv dy ulong to void
z = add dy 719468
era = div z 146097
doe = sub z mul era 146097
coymd doe era
end
fn coymd doe ulong era ulong to void
yoe = div sub add sub doe div doe 1460 div doe 36524 div doe 146096 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
dd = add sub doy div add mul 153 mp 2 5 1
mm = ulong 0
if lt mp 10
mm = add mp 3
else
mm = sub mp 9
end
if le mm 2
y = add y 1
end
fnum y
fputc 45
co2d mm
fputc 45
co2d dd
end
note ---- links
fn copatl to void
fputrl
fput tcpatp
end
fn coissl to void
fputrl
fput tcissp
end
note coplink kd: href of the current COB gcid
fn coplink kd ulong to void
if eq kd 1
copatl
else
coissl
end
coidh 40
end
note coqeq t: the value of the last fqget (fval[0,n)) equals t
fn coqeq n long t view uchar * to bool
if ne ulong n len t
ret false
end
for i ulong len t
if ne get fval i get t i
ret false
end
end
ret true
end
note coqstate kd: the state filter, 0 open 1 draft 2 closed 3 merged 9 all (default open)
fn coqstate kd ulong to ulong
n = fqget tcstn
if lt n 0
ret ulong 0
end
if coqeq n tcdraft
ret ulong 1
end
if or coqeq n tcclosed coqeq n tcarch
ret ulong 2
end
if coqeq n tcmerged
ret ulong 3
end
if coqeq n tcall
ret ulong 9
end
ret ulong 0
end
note costname kd s: the visible name of a state
fn costname kd ulong s ulong to void
if eq s 9
fput tcsall
ret
end
if eq s 0
fput tcsopen
ret
end
if eq s 1
fput tcsdraft
ret
end
if eq s 3
fput tcsmerg
ret
end
if eq kd 1
fput tcsarch
ret
end
fput tcsclos
end
text tcbok "<b class=\"ok\">"
text tcbbad "<b class=\"bad\">"
text tcbmut "<b class=\"muted\">"
fn costbadge kd ulong s ulong to void
if or eq s 0 eq s 3
fput tcbok
else
if eq s 1
fput tcbmut
else
fput tcbbad
end
end
costname kd s
fput tcboff
end
note ---- list pages
fn cosumm kd ulong to void
i = get gcsn 0
if ge i 200
ret
end
s = get gcm 2
if eq kd 1
s = costate
end
put gcss i s
put gccnt s add get gccnt s 1
put gcsc i get gcrn 0
put gcsk i add get gcqn 0 get gcwn 0
put gcsu i colast
cosumt i
cosumv i
cosuma i
put gcsn 0 add i 1
end
fn colast to ulong
t = ulong 0
for ci ulong get gccn 0
if gt get gccts ci t
t = get gccts ci
end
end
ret t
end
fn cosumt i ulong to void
o = get gcm 0
n = get gcm 1
if gt n 300
n = ulong 300
end
p = get gclpl 0
if gt add p n 262144
n = ulong 0
end
for k ulong n
put gclp add p k get gcpool add o k
end
put gcst mul i 2 p
put gcst add mul i 2 1 n
put gclpl 0 add p n
end
fn cosumv i ulong to void
put gcsvl i 0
r = get gcrn 0
if eq r 0
ret
end
r = sub r 1
n = get gcrvl r
if gt n 128
n = ulong 128
end
for k ulong n
put gcsv add mul i 128 k get gcrvd add mul r 256 k
end
put gcsvl i n
end
fn cosuma i ulong to void
n = get gccal 0
for k ulong n bound 64
put gcsau add mul i 64 k get gccau k
end
put gcsal i n
end
text tclh1 "<h2>"
text tclh2 "</h2>\n<p class=\"bar\">"
text tclh3 "</p>\n"
text tclul "<ul class=\"repos\">\n"
text tcluln "</ul>\n"
text tclnone "<p class=\"muted\">Nothing here in this state.</p>\n"
text tclcap "<p class=\"muted\">Only the 200 most recently updated are listed.</p>\n"
text tcpnote "<p class=\"muted\">Patches are Radicle collaborative objects (xyz.radicle.patch), read from this repository's storage. Open one by pushing a branch with <code>git push rad HEAD:refs/patches</code> from a clone.</p>\n"
text tcinote "<p class=\"muted\">Issues are Radicle collaborative objects (xyz.radicle.issue), read from this repository's storage. Open one with <code>rad issue open</code> from a clone.</p>\n"
note cotab f s nm v: one filter link (kind in gcm 9); v is the query value
fn cotab f ulong s ulong nm view uchar * v view uchar * to void
kd = get gcm 9
fput tcah
fputrl
if eq kd 1
fput tcpats
else
fput tcisss
end
fput tcstq
fput v
fput tcqg
if eq f s
fput tcbon
end
fput nm
fput tcopar
cotabn kd s
fput tccpar
if eq f s
fput tcboff
end
fput tcae
cosp
end
fn cotabn kd ulong s ulong to void
if eq s 9
fnum get gcsn 0
ret
end
fnum get gccnt s
end
fn cotabs kd ulong f ulong to void
cotab f 0 tcsopen tcopen
if eq kd 1
cotab f 1 tcsdraft tcdraft
cotab f 3 tcsmerg tcmerged
cotab f 2 tcsarch tcarch
else
cotab f 2 tcsclos tcclosed
end
cotab f 9 tcsall tcall
end
text tcli1 "<li><a class=\"rname\" href=\""
text tcli2 "</a> "
text tcli3 "<p class=\"meta\"><code>"
text tcli4 "</code> &#183; opened by "
text tcli5 " &#183; updated "
text tcli6 " revision"
text tcli6b " comment"
text tcli7 "</p>"
text tcli8 "<p class=\"meta\">Linked verdict: <b>"
text tcli9 "</b></p>"
text tcli10 "</li>\n"
fn corow kd ulong i ulong to void
coidref get gcsr i
fput tcli1
coplink kd
fput tcqg
n = get gcst add mul i 2 1
if eq n 0
fput tcnot
end
o = get gcst mul i 2
for k ulong n
fescc get gclp add o k
end
fput tcli2
costbadge kd get gcss i
fput tcli3
coidh 7
fput tcli4
corowa i
fput tcmidd
corowc kd i
fput tcli5
codate get gcsu i
fput tcli7
corowv i
fput tcli10
end
fn corowa i ulong to void
n = get gcsal i
if eq n len tfnid
if cosaown i
fput tfowner
ret
end
end
fput tcdidk
for k ulong n bound 64
fescc get gcsau add mul i 64 k
end
end
fn cosaown i ulong to bool
for k ulong len tfnid
if ne get gcsau add mul i 64 k get tfnid k
ret false
end
end
ret true
end
fn corowc kd ulong i ulong to void
if eq kd 1
fnum get gcsc i
fput tcli6
if ne get gcsc i 1
fputc 115
end
fput tcmidd
end
fnum get gcsk i
fput tcli6b
if ne get gcsk i 1
fputc 115
end
end
fn corowv i ulong to void
n = get gcsvl i
if eq n 0
ret
end
fput tcli8
for k ulong n
fescc get gcsv add mul i 128 k
end
fput tcli9
end
note colist kd: the patch (1) or issue (2) list page of the current repo
fn colist kd ulong to long
if eq corefs kd false
ret 500
end
put gcsn 0 0
put gclpl 0 0
for s ulong 8
put gccnt s 0
end
n = get gcun 0
if gt n 200
n = ulong 200
end
for i ulong n
coidref get gcui i
if coload kd
put gcsr get gcsn 0 get gcui i
cosumm kd
end
end
colistp kd
ret 200
end
fn colistp kd ulong to void
put gcm 9 kd
f = coqstate kd
if and eq kd 2 or eq f 1 eq f 3
f = ulong 0
end
put ftil 0 0
if eq kd 1
fsetti tcpat
frepohd 5
else
fsetti tciss
frepohd 6
end
ftic 32
ftirepo
fput tclh1
costname kd f
fput tclh2
cotabs kd f
fput tclh3
colrows kd f
if gt get gcun 0 200
fput tclcap
end
if eq kd 1
fput tcpnote
else
fput tcinote
end
end
fn colrows kd ulong f ulong to void
m = ulong 0
fput tclul
for i ulong get gcsn 0
if or eq f 9 eq f get gcss i
corow kd i
m = add m 1
end
end
fput tcluln
if eq m 0
fput tclnone
end
end

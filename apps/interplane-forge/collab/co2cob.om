note collab/co2cob.om (ForgePatches): load one Radicle patch or issue COB from git storage and replay it.
note Layout (heartwood, rad 1.10.3 on spark): refs/namespaces/<nid>/refs/cobs/xyz.radicle.patch/<id>
note (and xyz.radicle.issue) point at the newest change commit. A change commit's tree holds the
note blobs 0, 1, ... (one JSON action each) and manifest. The COB id is the root change commit, and
note a revision id is the id of the change that created it. Parents of a change are earlier changes,
note then related repo commits and the identity root; only changes descend from the root change, so
note `git log --ancestry-path <tips> ^<root>` lists exactly the later changes, oldest first with
note --reverse --topo-order. `git grep -a -z -e ^ <changes>` prints every action blob as one line
note `<change>:<n>\0<json>`. Read only, argv execs only (fkgit + fexec), never the rad CLI.
note Limits: every ref of one kind that fxo carries (16 MiB of 82-byte lines; a longer list is the whole
note 500 of fincut), 8,192 changes, 8,192 comments, 64 revisions, 16 merges and 64 reviews per COB, a
note 4 MiB string pool. Past a limit the object is not whole (gcov) and its page, JSON, raw diff and
note every write to it are the whole 500 of fincut: nothing is shown or written from a cut copy.
note Concurrent changes replay in git topological order.
const CORFMAX ulong 262144
const COCHMAX ulong 8192
const COCMMAX ulong 8192
text tcfer "for-each-ref"
text tcsort "--sort=-committerdate"
text tcfmtr "--format=%(objectname) %(refname:lstrip=-1)"
text tcpatref "refs/namespaces/*/refs/cobs/xyz.radicle.patch/*"
text tcissref "refs/namespaces/*/refs/cobs/xyz.radicle.issue/*"
text tclog "log"
text tcnowalk "--no-walk"
text tcfmtl "--format=%H %at %ae"
text tcanc "--ancestry-path"
text tctopo "--topo-order"
text tcrevers "--reverse"
text tcgrep "grep"
text tcopta "-a"
text tcoptz "-z"
text tcnocol "--no-color"
text tcnoln "--no-line-number"
text tcopte "-e"
text tccaret "^"
text tcdd "--"
text tcty "type"
text tcrevis "revision"
text tcedit "edit"
text tclife "lifecycle"
text tcmerge "merge"
text tcreview "review"
text tcrcom "revision.comment"
text tcredit "revision.edit"
text tcrred "revision.redact"
text tclabel "label"
text tcassign "assign"
text tccomm "comment"
text tccedit "comment.edit"
text tccred "comment.redact"
text tcbase "base"
text tcoid "oid"
text tcdesc "description"
text tctitle "title"
text tcstate "state"
text tcstatus "status"
text tcreason "reason"
text tccommit "commit"
text tcverd "verdict"
text tcsumm "summary"
text tcbody "body"
text tclabels "labels"
text tcassn "assignees"
text tcid "id"
text tcdraft "draft"
text tcvv1 "VERDICT "
text tcvv2 "MERGE_AFTER_FIX head="
text tcvv3 "MERGE head="
text tcvv4 "REJECT head="
text tcarch "archived"
text tcclosed "closed"
text tcaccept "accept"
text tcreject "reject"
text tcrevd "/home/drakestapleton/handoffs/hive/manager/reviews/"
text tcvsuf ".verdict.txt"
note refs of the current repo: tip and COB id per ref; gcui lists the first ref of each distinct id
global gcfo uchar 10485760
global gcfi uchar 10485760
global gcfn ulong 1
global gcui ulong 262144
global gcun ulong 1
note gcuh: open-addressing set of the distinct ids (ref index + 1), for coseen
global gcuh ulong 524288
note gcxfull: the action index of the current chunk was full (cogrep retries a smaller chunk)
global gcxfull ulong 1
note the COB being loaded, and a requested id prefix
global gcid uchar 40
global gcrq uchar 40
global gcrql ulong 1
note changes: id, author time, author NID (the part of the author email after @)
global gcch uchar 327680
global gccts ulong 8192
global gccau uchar 524288
global gccal ulong 8192
global gccn ulong 1
note model slots gcm: 0,1 title (pool off,len) 2 lifecycle (0 open 1 draft 2 archived/closed)
note 3,4 labels 5,6 assignees 7,8 close reason 9 kind (1 patch 2 issue) 10 actions not understood
global gcm ulong 16
note revisions: id, base, head oid, creating change, description (off,len), redacted, verdict line
global gcrv uchar 2560
global gcrb uchar 2560
global gcro uchar 2560
global gcrt ulong 64
global gcrd ulong 128
global gcrx ulong 64
global gcrvd uchar 16384
global gcrvl ulong 64
global gcrn ulong 1
note merges: revision index, merge commit, change
global gcmr ulong 16
global gcmc uchar 640
global gcmt ulong 16
global gcmn ulong 1
note reviews: revision index, verdict (0 none 1 accept 2 reject), summary (off,len), change
global gcwr ulong 64
global gcwv ulong 64
global gcws ulong 128
global gcwt ulong 64
global gcwn ulong 1
note comments: revision index (9999 = none: an issue comment), body (off,len), change, redacted
global gcqr ulong 8192
global gcqs ulong 16384
global gcqt ulong 8192
global gcqx ulong 8192
global gcqn ulong 1
note one git grep chunk: per output line the content range, change index and blob number
global gcxa ulong 4096
global gcxb ulong 4096
global gcxc ulong 4096
global gcxk ulong 4096
global gcxn ulong 1
note verdict file path and first bytes
global gcvp uchar 512
global gcvpl ulong 1
global gcvb uchar 512
note ---- small scanners over fxo
fn coeol p ulong n ulong to ulong
q = p
while lt q n bound 16777216
if eq get fxo q 10
ret q
end
q = add q 1
end
ret n
end
fn cofindb a ulong b ulong c uchar to ulong
q = a
while lt q b bound 16777216
if eq get fxo q c
ret q
end
q = add q 1
end
ret b
end
fn cohexr a ulong n ulong to bool
for i ulong n
if cohexc get fxo add a i
continue
end
ret false
end
ret true
end
fn codec a ulong b ulong to ulong
v = ulong 0
for i ulong sub b a
c = get fxo add a i
if and ge c 48 le c 57
v = add mul v 10 sub ulong c 48
end
end
ret v
end
note conum: fxo[a,b) as a decimal of 1..4 digits, 9999 otherwise (the manifest blob)
fn conum a ulong b ulong to ulong
if or le b a gt sub b a 4
ret ulong 9999
end
v = ulong 0
for i ulong sub b a
c = get fxo add a i
if or lt c 48 gt c 57
ret ulong 9999
end
v = add mul v 10 sub ulong c 48
end
ret v
end
note ---- refs: corefs kd (1 patch, 2 issue) fills gcfo/gcfi and the distinct ids gcui
fn corefs kd ulong to bool
put gcfn 0 0
put gcun 0 0
fkgit
fka tcfer
fka tcsort
fka tcfmtr
if eq kd 1
fka tcpatref
else
fka tcissref
end
x = fexec 10000000000
if ne x 0
ret false
end
note a ref list longer than fxo is not read as the whole list (an object past the cut would be a 404)
if ne get fxotr 0 0
fincut
ret false
end
for i ulong len gcuh
put gcuh i 0
end
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
q = coeol p n
corefln p q
p = add q 1
end
ret true
end
fn corefln a ulong b ulong to void
if ne sub b a 81
ret
end
if ne get fxo add a 40 32
ret
end
if eq cohexr a 40 false
ret
end
if eq cohexr add a 41 40 false
ret
end
i = get gcfn 0
note CORFMAX is more lines than fxo holds, so this is not reached; it stays a refusal, not a cut
if ge i CORFMAX
fincut
ret
end
for k ulong 40
put gcfo add mul i 40 k get fxo add a k
put gcfi add mul i 40 k get fxo add a add 41 k
end
put gcfn 0 add i 1
if eq coseen i false
u = get gcun 0
put gcui u i
put gcun 0 add u 1
end
end
note coseen: ref i carries an id already listed in gcui (true); else its id joins the set gcuh
fn coseen i ulong to bool
m = sub len gcuh 1
h = ulong 14695981039346656037
for k ulong 40
c = ulong get gcfi add mul i 40 k
h = mul xor h c 1099511628211
end
j = and h m
for it ulong len gcuh
v = get gcuh j
if eq v 0
put gcuh j add i 1
ret false
end
if cofieq sub v 1 i
ret true
end
j = and add j 1 m
end
ret true
end
fn cofieq x ulong y ulong to bool
for k ulong 40
if ne get gcfi add mul x 40 k get gcfi add mul y 40 k
ret false
end
end
ret true
end
note coresolve: the distinct id that starts with gcrq[0,gcrql) (4..40 hex), into gcid; false when none or ambiguous
fn coresolve to bool
m = ulong 0
w = ulong 0
for j ulong get gcun 0
if corqpre get gcui j
m = add m 1
w = get gcui j
end
end
if ne m 1
ret false
end
for k ulong 40
put gcid k get gcfi add mul w 40 k
end
ret true
end
fn corqpre i ulong to bool
n = get gcrql 0
if or lt n 4 gt n 40
ret false
end
for k ulong n
if ne get gcfi add mul i 40 k get gcrq k
ret false
end
end
ret true
end
note coidref: copy the id of ref i into gcid
fn coidref i ulong to void
for k ulong 40
put gcid k get gcfi add mul i 40 k
end
end
note ---- argv pieces
fn cokid ng bool to void
fkopen
if ng
fkc 94
end
for k ulong 40
fkc get gcid k
end
end
fn cokch ci ulong to void
fkopen
for k ulong 40
fkc get gcch add mul ci 40 k
end
end
fn cokpos to void
for j ulong get gcfn 0
if cotipis j
fkopen
for k ulong 40
fkc get gcfo add mul j 40 k
end
end
end
end
fn cotipis j ulong to bool
for k ulong 40
if ne get gcfi add mul j 40 k get gcid k
ret false
end
end
ret true
end
note ---- change list from `git log --format=%H %at %ae`
fn colog to void
note a change list longer than fxo would lose changes: the object is not whole
if ne get fxotr 0 0
put gcov 0 1
end
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
q = coeol p n
coline p q
p = add q 1
end
end
fn coline a ulong b ulong to void
if lt sub b a 44
ret
end
if ne get fxo add a 40 32
ret
end
if eq cohexr a 40 false
ret
end
ci = get gccn 0
if ge ci COCHMAX
put gcov 0 1
ret
end
for k ulong 40
put gcch add mul ci 40 k get fxo add a k
end
sp = cofindb add a 41 b 32
put gccts ci codec add a 41 sp
coauset ci add sp 1 b
put gccn 0 add ci 1
end
fn coauat a ulong b ulong to ulong
s = a
k = a
while lt k b bound 16777216
if eq get fxo k 64
s = add k 1
end
k = add k 1
end
ret s
end
fn coauset ci ulong a ulong b ulong to void
s = coauat a b
m = ulong 0
if gt b s
m = sub b s
end
if gt m 64
m = ulong 64
end
o = mul ci 64
for i ulong m
put gccau add o i get fxo add s i
end
put gccal ci m
end
note ---- change signer: Radicle signs every change commit with the author's node key (SSHSIG,
note ssh-ed25519). That key, as did:key multibase (z + base58btc of 0xed 0x01 + key), is the author
note NID; the email after @ is only a fallback when a commit has no well-formed signature. This
note reads the key; it does not verify the signature (the node verified it when it fetched the change).
text tcrevl "rev-list"
text tcnwu "--no-walk=unsorted"
text tchdr "--header"
text tcsigm "SSH SIGNATURE-----"
text tcssig "SSHSIG"
text tced "ssh-ed25519"
text tcb58 "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
global gcsg uchar 72
global gcbn uchar 64
note cosig s e: set the author NID of changes s..e-1 from `git rev-list --header` (raw commits,
note NUL-separated); false when that output did not fit fxo (coreplay retries a smaller chunk)
fn cosig s ulong e ulong to bool
fkgit
fka tcrevl
fka tcnwu
fka tchdr
for i ulong sub e s
cokch add s i
end
x = fexec 10000000000
if ne get fxotr 0 0
ret false
end
if ne x 0
ret true
end
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
q = cofindb p n 0
cosigrec p q s e
p = add q 1
end
ret true
end
fn cosigrec a ulong b ulong s ulong e ulong to void
if lt sub b a 41
ret
end
ci = cochin a s e
if ge ci e
ret
end
m = cofindt a b
if ge m b
ret
end
if eq cob64d m b false
ret
end
if eq cosigok false
ret
end
cob58 ci
end
note cofindt a b: the index just past the first "SSH SIGNATURE-----" in fxo[a,b), else b
fn cofindt a ulong b ulong to ulong
l = len tcsigm
k = a
while le add k l b bound 16777216
if coraweq k add k l tcsigm
ret add k l
end
k = add k 1
end
ret b
end
note cob64v c: the base64 value of c, 64 for a line break or space (skipped), 99 for anything else
fn cob64v c uchar to ulong
v = ulong c
if and ge c 65 le c 90
ret sub v 65
end
if and ge c 97 le c 122
ret sub v 71
end
if and ge c 48 le c 57
ret add v 4
end
if eq c 43
ret 62
end
if eq c 47
ret 63
end
if or eq c 10 eq c 32
ret 64
end
ret 99
end
note cob64d a b: decode the first 66 bytes of the base64 text at fxo[a,b) into gcsg
note The scan reads at most 4096 bytes past the marker. A real signature gives its 66 bytes within
note about 92 (88 base64 bytes and the line breaks); b is the end of the raw commit and can be far
note past a, so a marker followed by more than 4096 spaces or line breaks used to pass the bound
note (trap 4, exit 104).
fn cob64d a ulong b ulong to bool
acc = ulong 0
nb = ulong 0
o = ulong 0
e = b
if gt sub b a 4096
e = add a 4096
end
k = a
while lt k e bound 4096
v = cob64v get fxo k
if gt v 64
ret false
end
if lt v 64
acc = or shl acc 6 v
nb = add nb 6
if ge nb 8
nb = sub nb 8
put gcsg o uchar and shr acc nb 255
acc = and acc 255
o = add o 1
if ge o 66
ret true
end
end
end
k = add k 1
end
ret false
end
note cosigok: gcsg starts SSHSIG, version, then the public key string "ssh-ed25519" + 32-byte key
fn cosigok to bool
for i ulong 6
if ne get gcsg i get tcssig i
ret false
end
end
if ne get gcsg 17 11
ret false
end
for i ulong 11
if ne get gcsg add 18 i get tced i
ret false
end
end
if ne get gcsg 32 32
ret false
end
ret true
end
note cob58 ci: gccau[ci] = z + base58btc(0xed 0x01 key) (48 bytes for an ed25519 key)
fn cob58 ci ulong to void
nd = ulong 0
for i ulong 34
c = cob58in i
for j ulong nd
c = add c mul ulong get gcbn j 256
put gcbn j uchar rem c 58
c = div c 58
end
while gt c 0 bound 64
put gcbn nd uchar rem c 58
nd = add nd 1
c = div c 58
end
end
o = mul ci 64
put gccau o 122
for j ulong nd
put gccau add o add j 1 get tcb58 get gcbn sub sub nd 1 j
end
put gccal ci add nd 1
end
fn cob58in i ulong to ulong
if eq i 0
ret 237
end
if eq i 1
ret 1
end
ret ulong get gcsg add 31 i
end
note cochid: change ci is the requested COB id
fn cochid ci ulong to bool
for k ulong 40
if ne get gcch add mul ci 40 k get gcid k
ret false
end
end
ret true
end
note ---- load and replay
fn coreset to void
put gcov 0 0
put gccn 0 0
put gcpl 0 0
put gcrn 0 0
put gcmn 0 0
put gcwn 0 0
put gcqn 0 0
put gcxn 0 0
for i ulong 16
put gcm i 0
end
end
note coload kd: load the COB gcid (kind 1 patch, 2 issue; corefs kd must have run); false when absent
fn coload kd ulong to bool
coreset
put gcm 9 kd
fkgit
fka tclog
fka tcnowalk
fka tcfmtl
cokid false
x = fexec 10000000000
if ne x 0
ret false
end
colog
if ne get gccn 0 1
ret false
end
if eq cochid 0 false
ret false
end
fkgit
fka tclog
fka tcanc
fka tctopo
fka tcrevers
fka tcfmtl
cokpos
cokid true
x = fexec 10000000000
if ne x 0
ret false
end
colog
coreplay
for r ulong get gcrn 0
covlook r
end
ret true
end
note coreplay: changes in chunks of up to 32 (one rev-list and one git grep each). A chunk whose
note output does not fit fxo, or whose action lines do not fit the index, is read again in halves, so
note no number of changes is cut by those buffers; one change that does not fit alone makes the object
note not whole (gcov), and it is never shown as if it were.
fn coreplay to void
n = get gccn 0
s = ulong 0
c = ulong 32
while lt s n bound 1048576
e = add s c
if gt e n
e = n
end
if coplay s e
s = e
c = 32
else
if gt sub e s 1
c = div sub e s 2
else
put gcov 0 1
s = e
end
end
end
end
note coplay s e: the signatures and actions of changes [s, e); false when their output did not fit, and
note then no action of the chunk was applied
fn coplay s ulong e ulong to bool
if not cosig s e
ret false
end
ret cogrep s e
end
note cogrep s e: git grep of the action blobs of changes [s, e), indexed, then applied in change order;
note false (nothing applied) when the output did not fit fxo or the index. Exit 1 is git grep's "no
note line": nothing to apply. Any other failure makes the object not whole.
fn cogrep s ulong e ulong to bool
fkgit
fka tcgrep
fka tcopta
fka tcoptz
fka tcnocol
fka tcnoln
fka tcopte
fka tccaret
for i ulong sub e s
cokch add s i
end
fka tcdd
x = fexec 10000000000
if ne get fxotr 0 0
ret false
end
if eq x 1
ret true
end
if ne x 0
put gcov 0 1
ret true
end
coidx s e
if ne get gcxfull 0 0
ret false
end
for i ulong sub e s
coapch add s i
end
ret true
end
fn coidx s ulong e ulong to void
put gcxn 0 0
put gcxfull 0 0
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
q = coeol p n
coxln p q s e
p = add q 1
end
end
fn coxln a ulong b ulong s ulong e ulong to void
z = cofindb a b 0
if ge z b
ret
end
if lt sub z a 42
ret
end
if ne get fxo add a 40 58
ret
end
ci = cochin a s e
if ge ci e
ret
end
k = conum add a 41 z
note an action blob past number 4095 cannot be indexed: the change is not read whole
if gt k 4095
put gcov 0 1
ret
end
j = get gcxn 0
if ge j 4096
put gcxfull 0 1
ret
end
put gcxa j add z 1
put gcxb j b
put gcxc j ci
put gcxk j k
put gcxn 0 add j 1
end
note cochin: the change in [s,e) whose id is fxo[a,a+40), else e
fn cochin a ulong s ulong e ulong to ulong
for i ulong sub e s
if cochat add s i a
ret add s i
end
end
ret e
end
fn cochat ci ulong a ulong to bool
for k ulong 40
if ne get gcch add mul ci 40 k get fxo add a k
ret false
end
end
ret true
end
note coapch: apply the action blobs 0, 1, 2, ... of change ci in order
fn coapch ci ulong to void
for k ulong 4096
j = cofindx ci k
if ge j 4096
ret
end
coap ci get gcxa j get gcxb j
end
end
fn cofindx ci ulong k ulong to ulong
for j ulong get gcxn 0
if and eq get gcxc j ci eq get gcxk j k
ret j
end
end
ret ulong 4096
end
fn coap ci ulong a ulong e ulong to void
t = cokey a e tcty
if ge t e
ret
end
if eq get gcm 9 1
copatap ci a e t
ret
end
coissap ci a e t
end
fn coskip to void
put gcm 10 add get gcm 10 1
end
fn copatap ci ulong a ulong e ulong t ulong to void
if coseq t e tcrevis
coarev ci a e
ret
end
if coseq t e tcedit
coatitle a e
ret
end
if coseq t e tclife
coalife a e
ret
end
if coseq t e tcmerge
coamerge ci a e
ret
end
if coseq t e tcreview
coareview ci a e
ret
end
if coseq t e tcrcom
coarcom ci a e
ret
end
copatap2 ci a e t
end
fn copatap2 ci ulong a ulong e ulong t ulong to void
if coseq t e tcredit
coaredit a e
ret
end
if coseq t e tcrred
coarred a e
ret
end
if coseq t e tclabel
coalabel a e
ret
end
if coseq t e tcassign
coassign a e
ret
end
coskip
end
fn coissap ci ulong a ulong e ulong t ulong to void
if coseq t e tccomm
coacom ci a e 9999
ret
end
if coseq t e tcedit
coatitle a e
ret
end
if coseq t e tclife
coalife a e
ret
end
if coseq t e tccedit
coacedit a e
ret
end
if coseq t e tccred
coacred a e
ret
end
if coseq t e tclabel
coalabel a e
ret
end
if coseq t e tcassign
coassign a e
ret
end
coskip
end
note ---- actions
fn coarev ci ulong a ulong e ulong to void
r = get gcrn 0
if ge r 64
put gcov 0 1
ret
end
p = cokey a e tcoid
b = cokey a e tcbase
if eq cohexat p e false
coskip
ret
end
if eq cohexat b e false
coskip
ret
end
corevcp mul r 40 add p 1 add b 1 mul ci 40
put gcrt r ci
put gcrx r 0
put gcrvl r 0
codescset r a e
put gcrn 0 add r 1
end
note corevcp: copy head, base and change id of a new revision (o = r*40, p/b at the hex, c = ci*40)
fn corevcp o ulong p ulong b ulong c ulong to void
for k ulong 40
put gcro add o k get fxo add p k
put gcrb add o k get fxo add b k
put gcrv add o k get gcch add c k
end
end
fn codescset r ulong a ulong e ulong to void
d = cokey a e tcdesc
s = get gcpl 0
l = cospool d e
put gcrd mul r 2 s
put gcrd add mul r 2 1 l
end
fn coatitle a ulong e ulong to void
p = cokey a e tctitle
if ge p e
ret
end
s = get gcpl 0
l = cospool p e
put gcm 0 s
put gcm 1 l
end
fn coalife a ulong e ulong to void
st = cokey a e tcstate
if ge st e
ret
end
q = cokey st e tcstatus
if coseq q e tcdraft
put gcm 2 1
ret
end
if or coseq q e tcarch coseq q e tcclosed
put gcm 2 2
r = cokey st e tcreason
s = get gcpl 0
l = cospool r e
put gcm 7 s
put gcm 8 l
ret
end
put gcm 2 0
end
note corevix: the revision whose id is the string at p, 9999 when unknown
fn corevix p ulong e ulong to ulong
if eq cohexat p e false
ret ulong 9999
end
for r ulong get gcrn 0
if corevat r add p 1
ret r
end
end
ret ulong 9999
end
fn corevat r ulong a ulong to bool
for k ulong 40
if ne get gcrv add mul r 40 k get fxo add a k
ret false
end
end
ret true
end
fn coamerge ci ulong a ulong e ulong to void
m = get gcmn 0
if ge m 16
put gcov 0 1
ret
end
ri = corevix cokey a e tcrevis e
c = cokey a e tccommit
if or gt ri 63 eq cohexat c e false
coskip
ret
end
for k ulong 40
put gcmc add mul m 40 k get fxo add c add k 1
end
put gcmr m ri
put gcmt m ci
put gcmn 0 add m 1
end
fn coareview ci ulong a ulong e ulong to void
w = get gcwn 0
if ge w 64
put gcov 0 1
ret
end
put gcwr w corevix cokey a e tcrevis e
v = cokey a e tcverd
put gcwv w 0
if coseq v e tcaccept
put gcwv w 1
end
if coseq v e tcreject
put gcwv w 2
end
p = cokey a e tcsumm
s = get gcpl 0
l = cospool p e
put gcws mul w 2 s
put gcws add mul w 2 1 l
put gcwt w ci
put gcwn 0 add w 1
end
fn coarcom ci ulong a ulong e ulong to void
coacom ci a e corevix cokey a e tcrevis e
end
fn coacom ci ulong a ulong e ulong ri ulong to void
q = get gcqn 0
if ge q COCMMAX
put gcov 0 1
ret
end
p = cokey a e tcbody
s = get gcpl 0
l = cospool p e
put gcqr q ri
put gcqs mul q 2 s
put gcqs add mul q 2 1 l
put gcqt q ci
put gcqx q 0
put gcqn 0 add q 1
end
fn coaredit a ulong e ulong to void
ri = corevix cokey a e tcrevis e
if gt ri 63
coskip
ret
end
codescset ri a e
end
fn coarred a ulong e ulong to void
ri = corevix cokey a e tcrevis e
if lt ri 64
put gcrx ri 1
end
end
fn coalabel a ulong e ulong to void
p = cokey a e tclabels
s = get gcpl 0
l = coslist p e
put gcm 3 s
put gcm 4 l
end
fn coassign a ulong e ulong to void
p = cokey a e tcassn
s = get gcpl 0
l = coslist p e
put gcm 5 s
put gcm 6 l
end
note cocomix: the comment created by the change whose id is the string at p, 9999 when unknown
fn cocomix p ulong e ulong to ulong
if eq cohexat p e false
ret ulong 9999
end
for q ulong get gcqn 0
if cochat get gcqt q add p 1
ret q
end
end
ret ulong 9999
end
fn coacedit a ulong e ulong to void
q = cocomix cokey a e tcid e
if ge q COCMMAX
coskip
ret
end
p = cokey a e tcbody
s = get gcpl 0
l = cospool p e
put gcqs mul q 2 s
put gcqs add mul q 2 1 l
end
fn coacred a ulong e ulong to void
q = cocomix cokey a e tcid e
if lt q COCMMAX
put gcqx q 1
end
end
note costate: 0 open 1 draft 2 closed (archived) 3 merged
fn costate to ulong
if gt get gcmn 0 0
ret ulong 3
end
ret get gcm 2
end
note ---- linked verdicts: ~/handoffs/hive/manager/reviews/<repo>-<head sha8>.verdict.txt, first line
fn covpc c uchar to void
n = get gcvpl 0
if lt n 511
put gcvp n c
put gcvpl 0 add n 1
end
end
fn covpt t view uchar * to void
for i ulong len t
covpc get t i
end
end
note corepok: the repo name is a plain file-name word ([A-Za-z0-9._-], not starting with a dot)
fn corepok to bool
n = get frepol 0
if or eq n 0 gt n 100
ret false
end
if eq get frepo 0 46
ret false
end
for i ulong n
if eq coname get frepo i false
ret false
end
end
ret true
end
fn coname c uchar to bool
if or and ge c 48 le c 57 and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
ret or or eq c 46 eq c 45 eq c 95
end
fn covlook r ulong to void
put gcrvl r 0
if eq corepok false
ret
end
put gcvpl 0 0
covpt tcrevd
for i ulong get frepol 0
covpc get frepo i
end
covpc 45
for k ulong 8
covpc get gcro add mul r 40 k
end
covpt tcvsuf
fd = fopen gcvp 0 get gcvpl 0 557056 0
if lt fd 0
ret
end
nr = read int fd gcvb 0 512
x = fclose int fd
if le nr 0
ret
end
covcopy r ulong nr
end
fn covcopy r ulong n ulong to void
m = ulong 0
for i ulong n
c = get gcvb i
if or eq c 10 eq c 13
break
end
if lt m 256
put gcrvd add mul r 256 m c
m = add m 1
end
end
put gcrvl r m
if eq covok r false
put gcrvl r 0
end
end
note covok r: line 1 of the verdict file is exactly VERDICT (MERGE|MERGE_AFTER_FIX|REJECT) head=<the
note revision's 40-hex head>; any other line is not shown, and nothing else of the file (sec P3-1)
fn covok r ulong to bool
b = mul r 256
lim = add b get gcrvl r
if eq covat b lim tcvv1 false
ret false
end
p = add b 8
w = ulong 0
if covat p lim tcvv2
w = ulong 21
end
if covat p lim tcvv3
w = ulong 11
end
if covat p lim tcvv4
w = ulong 12
end
if eq w 0
ret false
end
p = add p w
if ne sub lim p 40
ret false
end
for k ulong 40
if ne get gcrvd add p k get gcro add mul r 40 k
ret false
end
end
ret true
end
note covat o lim t: gcrvd[o, o + len t) is t and ends by lim
fn covat o ulong lim ulong t view uchar * to bool
if gt add o len t lim
ret false
end
for i ulong len t
if ne get gcrvd add o i get t i
ret false
end
end
ret true
end
note ---- gate receipts and the forge decide word (patch page only, read-only). For revision r the
note receipt is ~/handoffs/hive/forge/receipts/<repo>-<head sha8>.receipt.txt (FORGE-RECEIPT v1, as
note interplane-mv forge/README.md defines it) and the decision follows forge decide (interplane-mv
note forge/forge.om, fn decide) check for check: the verdict is this page's file <repo>-<head8>.verdict.txt
note read whole (65536 bytes or more: VERDICT_UNREADABLE); two or more names *-<head8>.receipt.txt in
note the receipts folder are RECEIPT_AMBIGUOUS; files of 4096 bytes or more are RECEIPT_UNREADABLE.
note Unlike forge, a symlink is never followed (O_NOFOLLOW): it reads as unreadable. A receipt is shown
note (gate_rc, negctl_rc, author) only when it is well formed and names this head as its clone.
text tcrcpd "/home/drakestapleton/handoffs/hive/forge/receipts/"
text tcrsuf ".receipt.txt"
text tcrch "FORGE-RECEIPT v1\n"
text tcrrid "rid="
text tcrcl "clone="
text tcrtree "tree="
text tcromc "omc="
text tcrnone "none"
text tcrgc "gate_cmd="
text tcrgr "gate_rc="
text tcrnc "negctl_cmd="
text tcrnr "negctl_rc="
text tcrau "author="
text tcrst "started="
text tcrfi "finished="
text tcrls "log_sha256="
text tcrnl "negctl_log_sha256="
text tcriso "0000-00-00T00:00:00Z"
text tcrrad "rad:"
text tcrvw "VERDICT"
text tcrrev "reviewer="
text tcrhd "head="
text tcrmaf "MERGE_AFTER_FIX "
text tcrmrg "MERGE "
text tcrrej "REJECT "
note gcdm: verdict [0,65536), receipt [65536,69632), normalized reviewer [69632,135168), normalized
note author [135168,139264), getdents64 records [139264,147456), path [147456,147968)
global gcdm uchar 147968
note gcdg: 1 verdict length, 2 receipt length, 3 verdict kind (1 MERGE 2 MERGE_AFTER_FIX 3 REJECT),
note 4 verdict head offset, 5 and 6 reviewer offset and length, 7 clone offset, 8 gate_rc,
note 9 negctl_rc, 10 and 11 author offset and length, 12 receipt keys seen
global gcdg ulong 16
note per revision: decision (0 MERGE OK, forge decide's HOLD code 3..17, 100 nothing to decide),
note receipt shown (1), its gate_rc, negctl_rc and author (at most 256 bytes)
global gcdw ulong 64
global gcrsh ulong 64
global gcrgc ulong 64
global gcrnc ulong 64
global gcrau uchar 16384
global gcral ulong 64
note cdlook r: read the verdict and receipt of revision r and decide (corepok must hold)
fn cdlook r ulong to void
put gcdw r 100
put gcrsh r 0
if eq corepok false
ret
end
pl = cdpath r tcrevd tcvsuf
vr = cdload pl 0 65536
k = cdscan r
rr = long -2
if lt k 2
pl = cdpath r tcrcpd tcrsuf
rr = cdload pl 65536 4096
end
if and and lt vr 0 eq k 0 eq get gcrvl r 0
ret
end
rc = cdrcode r rr
if eq rc 0
cdrkeep r
end
d = cdvcode r vr
if eq d 0
d = rc
end
if eq d 0
d = cdlast
end
put gcdw r d
end
note cdrcode r rr: 17 ambiguous, 9 unreadable, else the receipt check (10 11) then CLONE_MISMATCH (12)
fn cdrcode r ulong rr long to ulong
if eq rr long -2
ret ulong 17
end
if le rr 0
ret ulong 9
end
put gcdg 2 ulong rr
c = cdrcpt
if ne c 0
ret c
end
if eq cdhed r get gcdg 7 false
ret ulong 12
end
ret ulong 0
end
note cdvcode r vr: the verdict checks in forge order (3 4 5 6 7 8), 0 when they pass
fn cdvcode r ulong vr long to ulong
if le vr 0
ret ulong 3
end
c = cdverd ulong vr
if ne c 0
ret c
end
k = get gcdg 3
if eq k 2
ret ulong 5
end
if eq k 3
ret ulong 6
end
if eq cdhed r get gcdg 4 false
ret ulong 7
end
if eq get gcdg 6 0
ret ulong 8
end
ret ulong 0
end
note cdlast: the checks after a valid verdict and receipt: GATE_FAIL, NEGCTL_PASSED, SELF_REVIEW
fn cdlast to ulong
if ne get gcdg 8 0
ret ulong 13
end
if eq get gcdg 9 0
ret ulong 14
end
if cdauth
ret ulong 15
end
ret ulong 0
end
fn cdrkeep r ulong to void
put gcrsh r 1
put gcrgc r get gcdg 8
put gcrnc r get gcdg 9
n = get gcdg 11
if gt n 256
n = ulong 256
end
a = get gcdg 10
for i ulong n
put gcrau add mul r 256 i get gcdm add a i
end
put gcral r n
end
note ---- paths and files
fn cdpc n ulong c uchar to ulong
if lt n 511
put gcdm add 147456 n c
ret add n 1
end
ret n
end
fn cdpt n ulong t view uchar * to ulong
m = n
for i ulong len t
m = cdpc m get t i
end
ret m
end
note cdpath r d s: gcdm[147456,..) = d <repo> - <head sha8 of r> s; the length
fn cdpath r ulong d view uchar * s view uchar * to ulong
n = cdpt 0 d
for i ulong get frepol 0
n = cdpc n get frepo i
end
n = cdpc n 45
for k ulong 8
n = cdpc n get gcro add mul r 40 k
end
ret cdpt n s
end
note cdload pl o cap: read the path into gcdm[o,o+cap); -1 when it cannot be opened (a symlink:
note O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC 559104) or read, or holds cap bytes or more
fn cdload pl ulong o ulong cap ulong to long
fl = fopen gcdm 147456 pl 559104 0
if lt fl 0
ret long -1
end
fd = int fl
n = ulong 0
r = long 0
note cap + 1 passes at most (cap is 65536 at most): each pass reads 1 byte or more or ends the
note loop, and the pass that finds n at cap ends it. The bound was 65536, one short of that for a
note file that gives one byte per read; a regular file gives all of it in one read.
c = true
while c bound 65537
if ge n cap
c = false
else
r = read fd gcdm add o n sub cap n
if le r 0
c = false
else
n = add n ulong r
end
end
end
x = fclose fd
if lt r 0
ret long -1
end
if ge n cap
ret long -1
end
ret long n
end
note cdscan r: the number of names *-<head sha8 of r>.receipt.txt in the receipts folder
fn cdscan r ulong to ulong
pl = cdpt 0 tcrcpd
fl = fopen gcdm 147456 pl 524288 0
if lt fl 0
ret ulong 0
end
fd = int fl
k = ulong 0
c = true
while c bound 65536
x = getdnts fd gcdm 139264 8192
if le x 0
c = false
else
k = add k cddsc r ulong x
end
end
y = fclose fd
ret k
end
fn cddsc r ulong n ulong to ulong
k = ulong 0
o = ulong 0
while lt o n bound 8192
b = add 139264 o
rl = or ulong get gcdm add b 16 shl ulong get gcdm add b 17 8
if cdsuf r add b 19
k = add k 1
end
if eq rl 0
o = n
else
o = add o rl
end
end
ret k
end
fn cdnlen a ulong to ulong
n = ulong 0
while and lt n 255 ne get gcdm add a n 0 bound 256
n = add n 1
end
ret n
end
note cdsuf r a: the entry name at gcdm[a,..) is <one or more bytes>-<head sha8 of r>.receipt.txt
fn cdsuf r ulong a ulong to bool
nl = cdnlen a
t = len tcrsuf
if lt nl add t 10
ret false
end
b = sub add a nl add t 9
if ne get gcdm b 45
ret false
end
if eq cdhedn r add b 1 8 false
ret false
end
ret cdmat add b 9 add a nl tcrsuf
end
note ---- scanners over gcdm
fn cdmat a ulong lim ulong t view uchar * to bool
if gt add a len t lim
ret false
end
for i ulong len t
if ne get gcdm add a i get t i
ret false
end
end
ret true
end
fn cdhex a ulong n ulong to bool
for i ulong n bound 64
if eq cohexc get gcdm add a i false
ret false
end
end
ret true
end
fn cdeol p ulong lim ulong to ulong
q = p
while lt q lim bound 65536
if eq get gcdm q 10
ret q
end
q = add q 1
end
ret lim
end
note cdhed r p: gcdm[p,p+40) is the head of revision r
fn cdhed r ulong p ulong to bool
ret cdhedn r p 40
end
note cdhedn r p n: gcdm[p,p+n) is the first n hex digits of the head of revision r
fn cdhedn r ulong p ulong n ulong to bool
o = mul r 40
for k ulong n bound 40
x = get gcro add o k
if ne get gcdm add p k x
ret false
end
end
ret true
end
fn cdeqr a ulong b ulong n ulong to bool
for i ulong n bound 65536
if ne get gcdm add a i get gcdm add b i
ret false
end
end
ret true
end
note cdtxt v e: 0 when gcdm[v,e) holds a byte in 33..126 and no control byte (below 32 but tab,
note or 127), 2 when it holds a control byte, 1 otherwise
fn cdtxt v ulong e ulong to ulong
vis = false
for i ulong sub e v bound 65536
c = get gcdm add v i
if and lt c 32 ne c 9
ret ulong 2
end
if eq c 127
ret ulong 2
end
if and gt c 32 lt c 127
vis = true
end
end
if vis
ret ulong 0
end
ret ulong 1
end
note ---- the verdict file (forge pverd and scanv): 0, or 4 VERDICT_MALFORMED
fn cdverd n ulong to ulong
if eq cdmat 0 n tcvv1 false
ret ulong 4
end
p = ulong 8
k = ulong 0
if cdmat p n tcrmaf
k = ulong 2
p = add p 16
else
if cdmat p n tcrmrg
k = ulong 1
p = add p 6
else
if cdmat p n tcrrej
k = ulong 3
p = add p 7
end
end
end
if eq k 0
ret ulong 4
end
if eq cdmat p n tcrhd false
ret ulong 4
end
p = add p 5
if gt add p 40 n
ret ulong 4
end
if eq cdhex p 40 false
ret ulong 4
end
q = add p 40
if lt q n
if ne get gcdm q 10
ret ulong 4
end
end
put gcdg 3 k
put gcdg 4 p
ret cdscanv n
end
note cdscanv: no later line starts with VERDICT, at most one starts with reviewer=
fn cdscanv n ulong to ulong
p = add cdeol 0 n 1
put gcdg 5 0
put gcdg 6 0
seen = false
while lt p n bound 65536
e = cdeol p n
if cdmat p e tcrvw
ret ulong 4
end
if cdmat p e tcrrev
if seen
ret ulong 4
end
seen = true
t = cdtxt add p 9 e
if eq t 2
ret ulong 4
end
if eq t 0
put gcdg 5 add p 9
put gcdg 6 sub e add p 9
end
end
p = add e 1
end
ret ulong 0
end
note ---- the receipt (forge prcpt and rkey): 0, 10 RECEIPT_MALFORMED or 11 NO_NEGCTL. Keys seen:
note 1 clone 2 gate_rc 4 negctl_rc 8 author 16 gate_cmd 32 negctl_cmd 64 tree 128 rid 256 omc
note 512 started 1024 finished 2048 log_sha256 4096 negctl_log_sha256
fn cdrcpt to ulong
b = ulong 65536
n = add b get gcdg 2
if eq cdmat b n tcrch false
ret ulong 10
end
p = add b 17
put gcdg 12 0
while lt p n bound 4096
e = cdeol p n
r = cdrkey p e
if ne r 0
ret r
end
p = add e 1
end
s = get gcdg 12
if ne and s 11 11
ret ulong 10
end
if eq and s 4 0
ret ulong 11
end
ret ulong 0
end
fn cdonce bit ulong to ulong
s = get gcdg 12
if ne and s bit 0
ret ulong 10
end
put gcdg 12 or s bit
ret ulong 0
end
fn cdrhex p ulong e ulong t view uchar * bit ulong n ulong to ulong
v = add p len t
if ne sub e v n
ret ulong 10
end
if eq cdhex v n false
ret ulong 10
end
ret cdonce bit
end
fn cdrkey p ulong e ulong to ulong
if cdmat p e tcrcl
put gcdg 7 add p 6
ret cdrhex p e tcrcl 1 40
end
if cdmat p e tcrgr
d = cdnum add p 8 e
if eq d 1000
ret ulong 10
end
put gcdg 8 d
ret cdonce 2
end
if cdmat p e tcrnr
d = cdnum add p 10 e
if eq d 1000
ret ulong 10
end
put gcdg 9 d
ret cdonce 4
end
if cdmat p e tcrau
v = add p 7
if ne cdtxt v e 0
ret ulong 10
end
put gcdg 10 v
put gcdg 11 sub e v
ret cdonce 8
end
if cdmat p e tcrgc
ret cdonce 16
end
if cdmat p e tcrnc
ret cdonce 32
end
ret cdrkey2 p e
end
fn cdrkey2 p ulong e ulong to ulong
if cdmat p e tcrtree
ret cdrhex p e tcrtree 64 40
end
if cdmat p e tcrrid
if eq cdrid add p 4 e false
ret ulong 10
end
ret cdonce 128
end
if cdmat p e tcromc
if and eq sub e p 8 cdmat add p 4 e tcrnone
ret cdonce 256
end
ret cdrhex p e tcromc 256 64
end
if cdmat p e tcrst
if eq cdiso add p 8 e false
ret ulong 10
end
ret cdonce 512
end
if cdmat p e tcrfi
if eq cdiso add p 9 e false
ret ulong 10
end
ret cdonce 1024
end
if cdmat p e tcrls
ret cdrhex p e tcrls 2048 64
end
if cdmat p e tcrnl
ret cdrhex p e tcrnl 4096 64
end
ret ulong 10
end
note cdnum v e: 1 to 3 decimal digits, at most 255; 1000 otherwise
fn cdnum v ulong e ulong to ulong
n = sub e v
if or eq n 0 gt n 3
ret ulong 1000
end
x = ulong 0
for i ulong n bound 3
c = get gcdm add v i
if or lt c 48 gt c 57
ret ulong 1000
end
x = add mul x 10 sub ulong c 48
end
if gt x 255
ret ulong 1000
end
ret x
end
note cdrid v e: rad: then 1 to 60 ASCII letters and digits
fn cdrid v ulong e ulong to bool
n = sub e v
if or lt n 5 gt n 64
ret false
end
if eq cdmat v e tcrrad false
ret false
end
for i ulong sub n 4 bound 64
c = get gcdm add v add 4 i
if eq coname c false
ret false
end
if or eq c 46 or eq c 45 eq c 95
ret false
end
end
ret true
end
note cdiso v e: YYYY-MM-DDTHH:MM:SSZ (a digit where tcriso holds 0)
fn cdiso v ulong e ulong to bool
if ne sub e v 20
ret false
end
for i ulong 20
c = get gcdm add v i
w = get tcriso i
if eq w 48
if or lt c 48 gt c 57
ret false
end
else
if ne c w
ret false
end
end
end
ret true
end
note ---- SELF_REVIEW (forge hasauth): the normalized reviewer text contains the normalized author;
note an author that normalizes to nothing counts as self-review
fn cdauth to bool
rn = cdnorm get gcdg 5 get gcdg 6 69632
an = cdnorm get gcdg 10 get gcdg 11 135168
if eq an 0
ret true
end
if gt an rn
ret false
end
lim = sub rn an
i = ulong 0
while le i lim bound 65536
if cdeqr add 69632 i 135168 an
ret true
end
i = add i 1
end
ret false
end
note cdnorm s n d: copy gcdm[s,s+n) to d folded to ASCII lower case, each run of space, tab, _ and -
note as one space, then spaces and ASCII punctuation stripped from both ends; the length
fn cdnorm s ulong n ulong d ulong to ulong
o = ulong 0
last = ulong 32
for i ulong n bound 65536
c = ulong get gcdm add s i
if or or eq c 32 eq c 9 or eq c 95 eq c 45
if ne last 32
put gcdm add d o 32
o = add o 1
last = ulong 32
end
else
if and ge c 65 le c 90
c = add c 32
end
put gcdm add d o uchar c
o = add o 1
last = c
end
end
ret cdstrip d o
end
fn cdstrip d ulong n ulong to ulong
e = n
c = true
while c bound 65536
if eq e 0
c = false
else
if cdpun get gcdm add d sub e 1
e = sub e 1
else
c = false
end
end
end
s = ulong 0
c = true
while c bound 65536
if ge s e
c = false
else
if cdpun get gcdm add d s
s = add s 1
else
c = false
end
end
end
for i ulong sub e s bound 65536
put gcdm add d i get gcdm add d add s i
end
ret sub e s
end
fn cdpun c uchar to bool
if eq c 32
ret true
end
if and ge c 33 le c 47
ret true
end

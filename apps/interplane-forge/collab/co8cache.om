note collab/co8cache.om (ForgePatches): the raw-diff cache <tfdata>collab/<rid>/<base>-<head>.diff
note holds at most cocap bytes in total: 2 GiB = 2147483648 bytes
note (WolframLanguageEvaluator: UnitConvert[Quantity[2, "Gibibytes"], "Bytes"] -> 2147483648 bytes).
note One diff file is at most 512 MiB (536870912). Eviction is least recently used by ctime, as
note dl/dl.om does it: a cache hit chmods the file (which sets its ctime), and after every new file the
note oldest files go until the total is at or under the cap.
text tccdir "collab"
global gckst uchar 128
global gckp uchar 4096
global gckpl ulong 1
global gcksd uchar 256
global gcksdl ulong 1
global gcke uchar 16384
global gcke2 uchar 16384
global gcktot ulong 1
global gckold uchar 4096
global gckoldl ulong 1
global gckoldc ulong 1
fn cocap to ulong
ret 2147483648
end
fn cocfmax to ulong
ret 536870912
end
note ---- stat helpers (Linux arm64 stat: mode +16, size +48, ctime +104 s, +112 ns)
fn cocst64 o ulong to ulong
v = ulong 0
for i ulong 8
b = ulong get gckst add o i
v = or v shl b mul i 8
end
ret v
end
fn cocst32 o ulong to ulong
v = ulong 0
for i ulong 4
b = ulong get gckst add o i
v = or v shl b mul i 8
end
ret v
end
note cocsize: size of the regular file gccf, -1 when it is missing or not a regular file
fn cocsize to long
r = stat gccf 0 get gccfl 0 gckst 0 128
if lt r 0
ret -1
end
if ne and cocst32 16 61440 32768
ret -1
end
ret long cocst64 48
end
note coctouch: a cache hit; chmod sets the ctime the eviction orders by
fn coctouch to void
x = chmod gccf 0 get gccfl 0 384
end
note ---- path builder gckp
fn cocpc c uchar to void
n = get gckpl 0
if lt n 4096
put gckp n c
put gckpl 0 add n 1
end
end
fn cocpb to void
put gckpl 0 0
for i ulong len tfdata
cocpc get tfdata i
end
for i ulong len tccdir
cocpc get tccdir i
end
end
fn cocpsub to void
cocpb
cocpc 47
for i ulong get gcksdl 0 bound 256
cocpc get gcksd i
end
end
note ---- LRU eviction over <tfdata>collab/*/*
fn cocevict to void
for round ulong 256
cocscan
if le get gcktot 0 cocap
ret
end
if eq get gckoldl 0 0
ret
end
x = unlink gckold 0 get gckoldl 0
end
end
fn cocscan to void
put gcktot 0 0
put gckoldl 0 0
cocpb
fd = fopen gckp 0 get gckpl 0 540672 0
if lt fd 0
ret
end
for it ulong 4096
n = getdnts int fd gcke 0 16384
if le n 0
break
end
cocscn1 ulong n
end
x = fclose int fd
end
note cocscn1 n: each subdirectory (d_type 4, not dot-named) of <tfdata>collab
fn cocscn1 n ulong to void
p = ulong 0
for it ulong 16384
if ge add p 19 n
break
end
rl = or ulong get gcke add p 16 shl ulong get gcke add p 17 8
if eq rl 0
break
end
if and eq get gcke add p 18 4 ne get gcke add p 19 46
put gcksdl 0 0
for i ulong 255
c = get gcke add add p 19 i
if eq c 0
break
end
put gcksd i c
put gcksdl 0 add i 1
end
cocdir
end
p = add p rl
end
end
fn cocdir to void
cocpsub
fd = fopen gckp 0 get gckpl 0 540672 0
if lt fd 0
ret
end
for it ulong 4096
n = getdnts int fd gcke2 0 16384
if le n 0
break
end
cocfile ulong n
end
x = fclose int fd
end
note cocfile n: each regular file (d_type 8) of the subdirectory
fn cocfile n ulong to void
p = ulong 0
for it ulong 16384
if ge add p 19 n
break
end
rl = or ulong get gcke2 add p 16 shl ulong get gcke2 add p 17 8
if eq rl 0
break
end
if eq get gcke2 add p 18 8
cocpsub
cocpc 47
for i ulong 255
c = get gcke2 add add p 19 i
if eq c 0
break
end
cocpc c
end
cocfil1
end
p = add p rl
end
end
note cocfil1: count the file in gckp, keep it as the eviction candidate when its ctime is oldest
fn cocfil1 to void
r = stat gckp 0 get gckpl 0 gckst 0 128
if lt r 0
ret
end
put gcktot 0 add get gcktot 0 cocst64 48
ct = add mul cocst64 104 1000000000 cocst64 112
if and ne get gckoldl 0 0 ge ct get gckoldc 0
ret
end
n = get gckpl 0
for i ulong n bound 4096
put gckold i get gckp i
end
put gckoldl 0 n
put gckoldc 0 ct
end

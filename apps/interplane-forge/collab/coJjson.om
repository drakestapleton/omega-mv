note collab/coJjson.om (ForgePatches): the JSON form of the patch and issue pages (docs/api-collab.md):
note forge/patches/1 and forge/issues/1 for the lists, forge/patch/1 and forge/issue/1 for one COB. Same
note loading, validation and statuses as the HTML handlers; every link is the href the HTML page builds.
note Pool text (titles, descriptions, bodies) is the raw markdown source, written by cojp without the
note 64 KiB cap of fjt; ill-formed UTF-8 becomes U+FFFD as in fjstr.
text tcjrep "\\ufffd"
text tcjsps "forge/patches/1"
text tcjsis "forge/issues/1"
text tcjsp "forge/patch/1"
text tcjsi "forge/issue/1"
text tcjsts "states"
text tcjcnt "count"
text tcjpath "path"
text tcjtr "truncated"
text tcjpats "patches"
text tcjisss "issues"
text tcjtitl "title"
text tcjauth "author"
text tcjupd "updated"
text tcjrevs "revisions"
text tcjcoms "comments"
text tcjverd "verdict"
text tcjname "name"
text tcjdid "did"
text tcjopen "opened"
text tcjdesc "description"
text tcjlabs "labels"
text tcjasg "assignees"
text tcjbld "forged_commit"
text tcjmrgs "merges"
text tcjact "activity"
text tcjdiff "diff"
text tcjnum "number"
text tcjred "redacted"
text tcjbase "base"
text tcjhead "head"
text tcjtime "time"
text tcjrev "revision"
text tcjcmt "commit"
text tcjtype "type"
text tcjbody "body"
text tcjraw "raw"
text tcjreas "reason"
text tcjtrvw "review"
text tcjtcom "comment"
text tcjtmrg "merge"
global gcjn ulong 1
note ---- JSON strings from gcpool (UTF-8 checked like fjulen, but on gcpool[i, e))
fn cojc i ulong e ulong to bool
if ge i e
ret false
end
c = get gcpool i
ret and ge c 128 le c 191
end
fn coju3 i ulong e ulong c uchar to ulong
if not cojc add i 1 e
ret 0
end
if not cojc add i 2 e
ret 0
end
d = get gcpool add i 1
if and eq c 224 lt d 160
ret 0
end
if and eq c 237 gt d 159
ret 0
end
ret 3
end
fn coju4 i ulong e ulong c uchar to ulong
if not cojc add i 1 e
ret 0
end
if not cojc add i 2 e
ret 0
end
if not cojc add i 3 e
ret 0
end
d = get gcpool add i 1
if and eq c 240 lt d 144
ret 0
end
if and eq c 244 gt d 143
ret 0
end
ret 4
end
fn cojul i ulong e ulong to ulong
c = get gcpool i
if lt c 128
ret 1
end
if and ge c 194 le c 223
if cojc add i 1 e
ret 2
end
ret 0
end
if and ge c 224 le c 239
ret coju3 i e c
end
if and ge c 240 le c 244
ret coju4 i e c
end
ret 0
end
note cojp o n: gcpool[o, o+n) as one JSON string
fn cojp o ulong n ulong to void
fputc 34
e = add o n
i = o
while lt i e bound 4194304
l = cojul i e
if eq l 0
fput tcjrep
i = add i 1
continue
end
if eq l 1
fjasc get gcpool i
i = add i 1
continue
end
for k ulong l bound 4
fputc get gcpool add i k
end
i = add i l
end
fputc 34
end
note cojlst k: the ", "-joined list in gcpool at gcm k/k+1 (labels 3, assignees 5) as an array of strings
fn cojlst k ulong to void
fputc 91
o = get gcm k
e = add o get gcm add k 1
s = o
i = o
while lt i e bound 4194304
if eq get gcpool i 44
if lt add i 1 e
if eq get gcpool add i 1 32
cojp s sub i s
fputc 44
i = add i 2
s = i
continue
end
end
end
i = add i 1
end
if gt e o
cojp s sub e s
end
fputc 93
end
note ---- small pieces
fn cojq to void
fputc 34
end
fn cojnum r ulong to void
if lt r 64
fnum add r 1
ret
end
fynull
end
fn cojkn t view uchar * to void
fyk t
fynull
end
note cojsn kd s: the state as a JSON string of its ?state= value; cojsv the bare value
fn cojsn kd ulong s ulong to void
cojq
cojsv kd s
cojq
end
fn cojsv kd ulong s ulong to void
if eq s 9
fput tcall
end
if eq s 0
fput tcopen
end
if eq s 1
fput tcdraft
end
if eq s 3
fput tcmerged
end
if eq s 2
if eq kd 1
fput tcarch
else
fput tcclosed
end
end
ret
end
note cojaun ow / cojaup ow: open an author object with its name, and close it with its link
fn cojaun ow bool to void
fputc 123
fyk0 tcjname
if ow
cojq
fput tfowner
cojq
else
fynull
end
fyk tcjdid
end
fn cojaup ow bool to void
fyk tcjpath
if ow
cojq
fputb
fput tfowner
cojq
else
fynull
end
fputc 125
end
note cojcau ci: the author of change ci (coauth): {"name","did","path"}
fn cojcau ci ulong to void
ow = coisown ci
cojaun ow
fjtb
for k ulong len tcdidk
fjtc get tcdidk k
end
for k ulong get gccal ci bound 64
fjtc get gccau add mul ci 64 k
end
fjstr
cojaup ow
end
note ---- list pages
fn cojlist kd ulong to long
if eq coldata kd false
ret 500
end
put gcm 9 kd
f = coqstate kd
if and eq kd 2 or eq f 1 eq f 3
f = ulong 0
end
if eq kd 1
fyrhead tcjsps
else
fyrhead tcjsis
end
fyk tcstn
cojsn kd f
fyk tcjsts
cojtabs kd
fyk tcjtr
fybool gt get gcun 0 200
if eq kd 1
fyk tcjpats
else
fyk tcjisss
end
cojrows kd f
fyk tcnwr
cojq
fputrl
if eq kd 1
fput tcpatp
else
fput tcissp
end
fput tcnwr
cojq
fputc 10
fyend
ret 200
end
note cojtabs kd: the filter links in HTML order (cotabs)
fn cojtabs kd ulong to void
fputc 91
cojtab kd 0 false
if eq kd 1
cojtab kd 1 true
cojtab kd 3 true
cojtab kd 2 true
else
cojtab kd 2 true
end
cojtab kd 9 true
fputc 93
end
fn cojtab kd ulong s ulong c bool to void
if c
fputc 44
end
fputc 123
fyk0 tcstn
cojsn kd s
fyk tcjcnt
cotabn kd s
fyk tcjpath
cojq
fputrl
if eq kd 1
fput tcpats
else
fput tcisss
end
fput tcstq
cojsv kd s
cojq
fputc 125
end
fn cojrows kd ulong f ulong to void
fputc 91
m = ulong 0
for i ulong get gcsn 0
if or eq f 9 eq f get gcss i
if gt m 0
fputc 44
end
fputc 10
cojrow kd i
m = add m 1
end
end
fputc 93
end
fn cojrow kd ulong i ulong to void
coidref get gcsr i
fputc 123
fyk0 tcid
cojq
coidh 40
cojq
fyk tcjtitl
fjtb
o = get gcst mul i 2
for k ulong get gcst add mul i 2 1 bound 300
fjtc get gclp add o k
end
fjstr
fyk tcstn
cojsn kd get gcss i
fyk tcjauth
cojlau i
cojrow2 kd i
end
fn cojrow2 kd ulong i ulong to void
fyk tcjupd
fjiso get gcsu i
if eq kd 1
fyk tcjrevs
fnum get gcsc i
end
fyk tcjcoms
fnum get gcsk i
fyk tcjverd
n = get gcsvl i
if eq n 0
fynull
else
fjtb
for k ulong n bound 128
fjtc get gcsv add mul i 128 k
end
fjstr
end
fyk tcjpath
cojq
coplink kd
cojq
fputc 125
end
fn cojlau i ulong to void
n = get gcsal i
ow = false
if eq n len tfnid
ow = cosaown i
end
cojaun ow
fjtb
for k ulong len tcdidk
fjtc get tcdidk k
end
for k ulong n bound 64
fjtc get gcsau add mul i 64 k
end
fjstr
cojaup ow
end
note ---- one patch (copatpg)
fn cojpat to long
if eq corefs 1 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 1 false
ret 404
end
fyrhead tcjsp
cojhead 1 costate
fyk tcjdesc
if eq get gcrn 0 0
cojq
cojq
else
cojp get gcrd 0 get gcrd 1
end
cojmeta
fyk tcjbld
if cobldok tcbldc
cojq
fput tcbldc
cojq
else
fynull
end
fyk tcjrevs
cojrevs
fyk tcjmrgs
cojmrgs
fyk tcjact
cojact
fyk tcjdiff
cojdiff coqrev
fputc 10
fyend
ret 200
end
note cojhead kd s: id, title, state, author, opened, path of the loaded COB
fn cojhead kd ulong s ulong to void
fyk tcid
cojq
coidh 40
cojq
fyk tcjtitl
cojp get gcm 0 get gcm 1
fyk tcstn
cojsn kd s
fyk tcjauth
cojcau 0
fyk tcjopen
fjiso get gccts 0
fyk tcjpath
cojq
coplink kd
cojq
end
fn cojmeta to void
fyk tcjlabs
cojlst 3
fyk tcjasg
cojlst 5
end
fn cojrevs to void
fputc 91
for r ulong get gcrn 0
if gt r 0
fputc 44
end
fputc 10
cojrev r
end
fputc 93
end
fn cojrev r ulong to void
fputc 123
fyk0 tcjnum
fnum add r 1
fyk tcid
cojq
corhex r 40
cojq
fyk tcjpath
cojq
copatl
coidh 40
fput tcrq
corhex r 40
fput tcrfrag
cojq
fyk tcjred
fybool eq get gcrx r 1
cojrev2 r
end
fn cojrev2 r ulong to void
fyk tcjbase
cojq
cobhex r 40
cojq
fyk tcjhead
cojq
cohhex r 40
cojq
ci = get gcrt r
fyk tcjauth
cojcau ci
fyk tcjtime
fjiso get gccts ci
fyk tcjverd
cojrv r
fputc 125
end
fn cojrv r ulong to void
n = get gcrvl r
if eq n 0
fynull
ret
end
fjtb
for k ulong n bound 256
fjtc get gcrvd add mul r 256 k
end
fjstr
end
fn cojmrgs to void
fputc 91
for m ulong get gcmn 0
if gt m 0
fputc 44
end
fputc 123
fyk0 tcjrev
fnum add get gcmr m 1
fyk tcjcmt
cojq
comhex m 40
cojq
ci = get gcmt m
fyk tcjauth
cojcau ci
fyk tcjtime
fjiso get gccts ci
fputc 125
end
fputc 93
end
note ---- activity (copact): every change in order; each item has the same keys
fn cojact to void
put gcjn 0 0
fputc 91
for ci ulong get gccn 0
cojactc ci
end
fputc 93
end
fn cojactc ci ulong to void
for r ulong get gcrn 0
if eq get gcrt r ci
cojarev ci r
end
end
for w ulong get gcwn 0
if eq get gcwt w ci
cojarvw ci w
end
end
for q ulong get gcqn 0
if eq get gcqt q ci
cojacom ci q
end
end
for m ulong get gcmn 0
if eq get gcmt m ci
cojamrg ci m
end
end
end
note cojah ty ci: open an activity item: type, author, time, and the "revision" key
fn cojah ty view uchar * ci ulong to void
n = get gcjn 0
if gt n 0
fputc 44
end
put gcjn 0 add n 1
fputc 10
fputc 123
fyk0 tcjtype
cojq
fput ty
cojq
fyk tcjauth
cojcau ci
fyk tcjtime
fjiso get gccts ci
fyk tcjrev
end
fn cojarev ci ulong r ulong to void
if eq r 0
cojah tcopen ci
else
cojah tcjrev ci
end
fnum add r 1
fyk tcjhead
cojq
cohhex r 40
cojq
cojkn tcjcmt
cojkn tcjverd
cojkn tcjbody
fyk tcjred
fybool eq get gcrx r 1
fputc 125
end
fn cojarvw ci ulong w ulong to void
cojah tcjtrvw ci
cojnum get gcwr w
cojkn tcjhead
cojkn tcjcmt
fyk tcjverd
v = get gcwv w
if eq v 0
fynull
else
cojq
if eq v 1
fput tcaccept
else
fput tcreject
end
cojq
end
fyk tcjbody
cojp get gcws mul w 2 get gcws add mul w 2 1
fyk tcjred
fybool false
fputc 125
end
fn cojacom ci ulong q ulong to void
cojah tcjtcom ci
cojnum get gcqr q
cojkn tcjhead
cojkn tcjcmt
cojkn tcjverd
cojbody q
fputc 125
end
note cojbody q: "body" (null when redacted) and "redacted" of comment q
fn cojbody q ulong to void
fyk tcjbody
x = eq get gcqx q 1
if x
fynull
else
cojp get gcqs mul q 2 get gcqs add mul q 2 1
end
fyk tcjred
fybool x
end
fn cojamrg ci ulong m ulong to void
cojah tcjtmrg ci
cojnum get gcmr m
cojkn tcjhead
fyk tcjcmt
cojq
comhex m 40
cojq
cojkn tcjverd
cojkn tcjbody
fyk tcjred
fybool false
fputc 125
end
note cojdiff r: the revision whose changes the page shows (coqrev), with the raw diff link; null when none
fn cojdiff r ulong to void
if gt r 63
fynull
ret
end
fputc 123
fyk0 tcjrev
fnum add r 1
fyk tcid
cojq
corhex r 40
cojq
fyk tcjbase
cojq
cobhex r 40
cojq
fyk tcjhead
cojq
cohhex r 40
cojq
fyk tcjraw
cojq
copatl
coidh 40
fput tcdsuf
fput tcrq
corhex r 40
cojq
fputc 125
end
note ---- one issue (coisspg)
fn cojiss to long
if eq corefs 2 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 2 false
ret 404
end
fyrhead tcjsi
cojhead 2 get gcm 2
fyk tcjreas
if gt get gcm 8 0
cojp get gcm 7 get gcm 8
else
fynull
end
cojmeta
fyk tcjcoms
fputc 91
for q ulong get gcqn 0
if gt q 0
fputc 44
end
fputc 10
cojicom q
end
fputc 93
fputc 10
fyend
ret 200
end
fn cojicom q ulong to void
ci = get gcqt q
fputc 123
fyk0 tcjauth
cojcau ci
fyk tcjtime
fjiso get gccts ci
cojbody q
fputc 125
end

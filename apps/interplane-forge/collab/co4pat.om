note collab/co4pat.om (ForgePatches): one patch page: header, linked verdicts, description, revisions,
note activity in change order, and the diff of one revision (latest not redacted, or ?rev=<id prefix>).
text tccode "<code>"
text tccodee "</code>"
text tcdiff "diff"
text tcnoext "--no-ext-diff"
text tcoptm "-M"
text tcstat "--stat=160,100"
text tcrevq "rev"
text tcdsuf ".diff"
text tcctxt "text/plain; charset=utf-8"
text tcph1 "<section class=\"rhead\"><h1>"
text tcph2 " <span class=\"muted mono\">"
text tcph3 "</span></h1>\n<p class=\"meta\">"
text tcph4 " &#183; opened by "
text tcph5 " on "
text tcph6 " &#183; id <code>"
text tcph7 "</code></p></section>\n"
text tcvh1 "<section class=\"box\"><h2>Linked verdicts</h2>\n"
text tcvh2 "<p class=\"muted\">No verdict file names a head of this patch. The forge looks for <code>reviews/"
text tcvh3 "-&lt;head sha8&gt;.verdict.txt</code> in the hive manager's review folder for every revision head.</p>\n"
text tcvh4 "</section>\n"
text tcvr1 "<p><b>"
text tcvr2 "</b><br><span class=\"meta\">revision "
text tcvr3 ", head <code>"
text tcvr4 "</code>, file <code>reviews/"
text tcvr5 ".verdict.txt</code></span></p>\n"
text tcmg1 "<p class=\"ok\">Merged: revision "
text tcmg2 " as commit <code>"
text tcmg3 "</code> by "
text tcmg4 "</p>\n"
text tcdh1 "<h2>Description</h2>\n"
text tcpre1 "<pre class=\"hit\">"
text tcpre2 "</pre>\n"
text tcnodesc "<p class=\"muted\">No description.</p>\n"
text tclab1 "<p class=\"meta\">Labels: "
text tcasg1 "<p class=\"meta\">Assignees: "
text tcpend "</p>\n"
text tcrt1 "<h2>Revisions</h2>\n<table><tr><th>#</th><th>Revision</th><th>Base</th><th>Head</th><th>Author</th><th>Date</th><th>Verdict</th></tr>\n"
text tcrt2 "<tr><td>"
text tctd "</td><td>"
text tcrt3 "</td></tr>\n"
text tcrt4 "</table>\n"
text tcrevr " (redacted)"
text tcrq "?rev="
text tcrfrag "#changes"
text tcah1 "<h2>Activity</h2>\n<ul class=\"repos\">\n"
text tcai1 "<li><p class=\"meta\">"
text tcai2 "</p>"
text tcai3 "</li>\n"
text tcaopen " opened this patch with revision 1"
text tcarev " pushed revision "
text tcarevw " reviewed revision "
text tcacom " commented on revision "
text tcacomx " commented"
text tcamrg " merged revision "
text tcaacc ": <b class=\"ok\">accept</b>"
text tcarej ": <b class=\"bad\">reject</b>"
text tcaredc "<p class=\"muted\">Comment redacted.</p>"
text tcaat " at <code>"
text tcacc "</code>"
text tcahead " head <code>"
text tcdf1 "<h2 id=\"changes\">Changes in revision "
text tcdf2 "</h2>\n<p class=\"meta\">git diff <code>"
text tcdf3 "</code> to <code>"
text tcdf4 "</code> &#183; <a href=\""
text tcdf5 "\">raw diff</a></p>\n"
text tcdferr "<p class=\"bad\">git diff failed for this revision (exit status "
text tcdfcut "<p class=\"muted\">The diff is cut at 1 MiB on this page; use the raw diff for the rest.</p>\n"
text tcdfnone "<p class=\"muted\">Every revision is redacted; there is no diff to show.</p>\n"
text tcspok "<span class=\"ok\">"
text tcspbad "<span class=\"bad\">"
text tcspmut "<span class=\"muted\">"
text tcspend "</span>"
text tctpat " - patch - "
note copatpg: the page of the patch whose id prefix is gcrq; 404 when unknown or ambiguous
fn copatpg to long
if eq corefs 1 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 1 false
ret 404
end
copttl
frepohd 5
copthd
copverd
copmerge
codref coqrev
copdesc
copmeta
coprevs
copact
coformc 1
copdiffs coqrev
ret 200
end
fn copttl to void
put ftil 0 0
o = get gcm 0
n = get gcm 1
for k ulong n bound 256
ftic get gcpool add o k
end
for k ulong len tctpat
ftic get tctpat k
end
ftirepo
end
fn copthd to void
fput tcph1
copoolm 0
if eq get gcm 1 0
fput tcnot
end
fput tcph2
coidh 7
fput tcph3
costbadge 1 costate
fput tcph4
coauth 0
fput tcph5
codate get gccts 0
fput tcmidd
fnum get gcrn 0
fput tcli6
if ne get gcrn 0 1
fputc 115
end
fput tcph6
coidh 40
fput tcph7
end
fn copverd to void
fput tcvh1
m = ulong 0
for r ulong get gcrn 0
if gt get gcrvl r 0
copvrow r
m = add m 1
end
end
if eq m 0
fput tcvh2
fputrnm
fput tcvh3
end
fput tcvh4
end
fn copvrow r ulong to void
fput tcvr1
for k ulong get gcrvl r bound 256
fescc get gcrvd add mul r 256 k
end
fput tcvr2
fnum add r 1
fput tcvr3
cohhex r 40
fput tcvr4
fputrnm
fputc 45
cohhex r 8
fput tcvr5
end
fn copmerge to void
for m ulong get gcmn 0
fput tcmg1
fnum add get gcmr m 1
fput tcmg2
comhex m 40
fput tcmg3
coauth get gcmt m
fput tcph5
codate get gccts get gcmt m
fput tcmg4
end
end
fn copdesc to void
fput tcdh1
if eq get gcrn 0 0
fput tcnodesc
ret
end
n = get gcrd 1
if eq n 0
fput tcnodesc
ret
end
comd get gcrd 0 n
end
fn copmeta to void
if gt get gcm 4 0
fput tclab1
copoolm 3
fput tcpend
end
if gt get gcm 6 0
fput tcasg1
copoolm 5
fput tcpend
end
end
fn coprevs to void
fput tcrt1
for r ulong get gcrn 0
coprow r
end
fput tcrt4
end
fn coprow r ulong to void
fput tcrt2
fnum add r 1
fput tctd
fput tcah
copatl
coidh 40
fput tcrq
corhex r 40
fput tcrfrag
fput tcqg
fput tccode
corhex r 8
fput tccodee
fput tcae
if eq get gcrx r 1
fput tcrevr
end
fput tctd
fput tccode
cobhex r 8
fput tccodee
fput tctd
fput tccode
cohhex r 8
fput tccodee
fput tctd
coauth get gcrt r
coprow2 r
end
fn coprow2 r ulong to void
fput tctd
codate get gccts get gcrt r
fput tctd
for k ulong get gcrvl r bound 256
fescc get gcrvd add mul r 256 k
end
fput tcrt3
end
note ---- activity: every change in causal order with what it did
fn copact to void
fput tcah1
for ci ulong get gccn 0
copactc ci
end
fput tcluln
end
fn copactc ci ulong to void
for r ulong get gcrn 0
if eq get gcrt r ci
coparev ci r
end
end
for w ulong get gcwn 0
if eq get gcwt w ci
coparvw ci w
end
end
for q ulong get gcqn 0
if eq get gcqt q ci
copacom ci q
end
end
for m ulong get gcmn 0
if eq get gcmt m ci
copamrg ci m
end
end
end
fn copahd ci ulong to void
fput tcai1
coauth ci
end
fn copatl2 ci ulong to void
fput tcph5
codate get gccts ci
fput tcai2
end
fn coparev ci ulong r ulong to void
copahd ci
if eq r 0
fput tcaopen
else
fput tcarev
fnum add r 1
end
fput tcahead
cohhex r 8
fput tcacc
copatl2 ci
fput tcai3
end
fn coparvw ci ulong w ulong to void
copahd ci
fput tcarevw
copnum get gcwr w
if eq get gcwv w 1
fput tcaacc
end
if eq get gcwv w 2
fput tcarej
end
copatl2 ci
n = get gcws add mul w 2 1
if gt n 0
comd get gcws mul w 2 n
end
fput tcai3
end
fn copnum r ulong to void
if lt r 64
fnum add r 1
else
fputc 63
end
end
fn copacom ci ulong q ulong to void
copahd ci
r = get gcqr q
if eq r 9999
fput tcacomx
else
fput tcacom
copnum r
end
copatl2 ci
if eq get gcqx q 1
fput tcaredc
else
comd get gcqs mul q 2 get gcqs add mul q 2 1
end
fput tcai3
end
fn copamrg ci ulong m ulong to void
copahd ci
fput tcamrg
copnum get gcmr m
fput tcaat
comhex m 8
fput tcacc
copatl2 ci
fput tcai3
end
note ---- the diff of one revision
note coqrev: the revision named by ?rev=<4..40 hex prefix of a revision id>, else the newest not redacted (9999 none)
fn coqrev to ulong
n = fqget tcrevq
if ge n 4
r = coqrevp ulong n
if lt r 64
ret r
end
end
k = get gcrn 0
for i ulong k
r = sub sub k i 1
if eq get gcrx r 0
ret r
end
end
ret ulong 9999
end
fn coqrevp n ulong to ulong
if gt n 40
ret ulong 9999
end
m = ulong 0
w = ulong 9999
for r ulong get gcrn 0
if coqrevm r n
m = add m 1
w = r
end
end
if eq m 1
ret w
end
ret ulong 9999
end
fn coqrevm r ulong n ulong to bool
for k ulong n
if ne get gcrv add mul r 40 k get fval k
ret false
end
end
ret true
end
note cokdiff r st: argv git diff <base> <head> -- for revision r (st: with --stat)
fn cokdiff r ulong st bool to void
fkgit
fka tcdiff
fka tcnocol
fka tcnoext
fka tcoptm
if st
fka tcstat
end
fkopen
for k ulong 40
fkc get gcrb add mul r 40 k
end
fkopen
for k ulong 40
fkc get gcro add mul r 40 k
end
fka tcdd
end
fn copdiffs r ulong to void
if gt r 63
fput tcdfnone
ret
end
fput tcdf1
fnum add r 1
fput tcdf2
cobhex r 8
fput tcdf3
cohhex r 8
fput tcdf4
copatl
coidh 40
fput tcdsuf
fput tcrq
corhex r 40
fput tcdf5
cokdiff r true
x = fexec 10000000000
if ne x 0
copdferr x
ret
end
fput tcpre1
fxesc 0 get fxol 0
fput tcpre2
cokdiff r false
x = fexec 10000000000
if ne x 0
copdferr x
ret
end
copdiffr
end
fn copdferr x long to void
fput tcdferr
if lt x 0
fputc 45
fnum ulong sub 0 x
else
fnum ulong x
end
fputc 41
fput tcpend
end
note copdiffr: fxo holds a unified diff; colour +/- lines, hunk and file headers; stop at 1 MiB
fn copdiffr to void
n = get fxol 0
c = n
if gt c 1048576
c = ulong 1048576
end
fput tcpre1
p = ulong 0
while lt p c bound 16777216
q = coeol p n
copdline p q
p = add q 1
end
fput tcpre2
if or gt n c gt get fxotr 0 0
fput tcdfcut
end
end
fn copdline a ulong b ulong to void
k = copdkind a b
if eq k 1
fput tcspok
end
if eq k 2
fput tcspbad
end
if eq k 3
fput tcspmut
end
if eq k 4
fput tcbon
end
fxesc a sub b a
if eq k 4
fput tcboff
else
if gt k 0
fput tcspend
end
end
fputc 10
end
note copdkind: 1 added 2 removed 3 hunk header 4 file header (diff/---/+++/rename/index) 0 context
fn copdkind a ulong b ulong to ulong
if ge a b
ret ulong 0
end
c = get fxo a
if eq c 64
ret ulong 3
end
if eq c 100
ret ulong 4
end
if and eq c 43 copd3 a b 43
ret ulong 4
end
if and eq c 45 copd3 a b 45
ret ulong 4
end
if eq c 43
ret ulong 1
end
if eq c 45
ret ulong 2
end
ret ulong 0
end
note copd3: the line starts with three bytes c and a space (a --- or +++ file line)
fn copd3 a ulong b ulong c uchar to bool
if lt sub b a 4
ret false
end
if ne get fxo add a 1 c
ret false
end
if ne get fxo add a 2 c
ret false
end
ret eq get fxo add a 3 32
end
note copraw: /patches/<id>.diff[?rev=] as text/plain. git diff writes the whole diff (--output) to
note <tfdata>collab/<rid>/<base>-<head>.diff once (a temporary name, then an atomic rename); base and
note head are immutable commit ids, so the cached file never goes stale. The server streams it (kind 3).
text tccoll "collab"
text tctmpx ".tmp"
text tcoutp "--output="
global gccf uchar 4096
global gccfl ulong 1
fn copraw to long
if eq corefs 1 false
ret 500
end
if eq coresolve false
ret 404
end
if eq coload 1 false
ret 404
end
r = coqrev
if gt r 63
ret 404
end
if eq copfin r false
ret 500
end
if ge cocsize 0
coctouch
else
x = copbuild r
if ne x 200
ret x
end
end
put fkind 0 3
fsetct tcctxt
put ffilel 0 0
for i ulong get gccfl 0 bound 4096
ffilc get gccf i
end
ret 200
end
note copfin r: gccf = <tfdata>collab/<rid>/<base>-<head>.diff, creating the two directories
fn copfin r ulong to bool
fpb
fpt tfdata
fpt tccoll
x = makedir fpth 0 get fpthl 0 448
fpc 47
for i ulong get fridl 0 bound 64
fpc get frid i
end
x = makedir fpth 0 get fpthl 0 448
if and ne x 0 ne x -17
ret false
end
fpc 47
o = mul r 40
for k ulong 40
fpc get gcrb add o k
end
fpc 45
for k ulong 40
fpc get gcro add o k
end
fpt tcdsuf
n = get fpthl 0
for i ulong n bound 4096
put gccf i get fpth i
end
put gccfl 0 n
ret true
end
note copbuild r: generate the raw diff of revision r into the cache, refuse one over cocfmax, then
note evict least recently used diffs until the cache is at or under cocap
text tcdfbig "<p class=\"bad\">This diff is larger than 512 MiB, the most the forge keeps. Clone the repository and run git diff locally.</p>\n"
fn copbuild r ulong to long
x = copgen r
if ne x 0
ret 500
end
s = cocsize
if gt s long cocfmax
y = unlink gccf 0 get gccfl 0
fput tcdfbig
ret 500
end
cocevict
if lt cocsize 0
ret 500
end
ret 200
end
note copgen r: run git diff --output=<gccf>.<pid>.tmp, then rename it to gccf; 0 on success
fn copgen r ulong to long
fpb
for i ulong get gccfl 0 bound 4096
fpc get gccf i
end
fpc 46
copdec ulong getpid
fpt tctmpx
cokdiffo r
x = fexec 60000000000
if ne x 0
y = unlink fpth 0 get fpthl 0
ret -1
end
fkb
fkopen
for i ulong get fpthl 0 bound 4096
fkc get fpth i
end
fkopen
for i ulong get gccfl 0 bound 4096
fkc get gccf i
end
x = renames fpk 0 get fpkl 0 0
if ne x 0
y = unlink fpth 0 get fpthl 0
ret x
end
ret 0
end
fn copdec v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
fpc get d add i k
end
end
note cokdiffo r: argv git diff --output=<fpth> <base> <head> -- for revision r
fn cokdiffo r ulong to void
fkgit
fka tcdiff
fka tcnocol
fka tcnoext
fka tcoptm
fkopen
fkt tcoutp
for i ulong get fpthl 0 bound 4096
fkc get fpth i
end
o = mul r 40
fkopen
for k ulong 40
fkc get gcrb add o k
end
fkopen
for k ulong 40
fkc get gcro add o k
end
fka tcdd
end

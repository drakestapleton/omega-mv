note collab/co9page.om (ForgePatches): GET <o>/<r>/compose/<cid>, the checked text with its preview and
note the exact command, and GET compose/<cid>/<file>, the file that command reads.
text tcfnc "comment.md"
text tcfnr "review.md"
text tcfni "issue.md"
text tcfnp "patch.md"
text tcmdct "text/markdown; charset=utf-8"
text tccdp "attachment; filename=\""
text tcpg1 "<section class=\"box\"><h2>"
text tcpk1 "Comment on issue "
text tcpk2 "Comment on patch "
text tcpk3 "Review of patch "
text tcpk4 "New issue"
text tcpk5 "New patch"
text tcpkr ", revision "
text tcpkacc " (accept)"
text tcpkrej " (reject)"
text tcpkdr " (draft)"
text tcpg2 "</h2>\n<p class=\"meta\">The forge checked this text and keeps it for 15 minutes, for this session only. It wrote nothing: a Radicle change is signed by its author, so your own node signs and publishes it.</p>\n<h3>Preview</h3>\n"
text tcpgt1 "<p><b>"
text tcpgt2 "</b></p>\n"
text tcpgnone "<p class=\"muted\">No text.</p>\n"
text tcpg3 "<h3>Publish it</h3>\n<ol class=\"so-steps\">\n"
text tcpgdl1 "<li>Save <a href=\""
text tcpgdl2 "\" download>"
text tcpgdl3 "</a> in a clone of this repository (<code>rad clone rad:"
text tcpgdl4 "</code>).</li>\n"
text tcpgr1 "<li>From that clone, in sh, bash or zsh, run:<pre class=\"so-cmd\">"
text tcpgr1p "<li>From that clone, on the branch you propose, in sh, bash or zsh, run:<pre class=\"so-cmd\">"
text tcpgr2 "</pre></li>\n"
text tcpge1 "<li>Then set the full description, with the patch id that git push printed in place of PATCH_ID:<pre class=\"so-cmd\">"
text tcpgb1 "<li>It shows here once this forge's node has fetched it from yours: <a href=\""
text tcpgb2 "\">back</a>.</li>\n</ol></section>\n"
text tccmrid " --repo rad:"
text tccm1 "rad issue comment "
text tccm2 "rad patch comment "
text tccm3 "rad patch review "
text tccm3r " --revision "
text tccmacc " --accept"
text tccmrej " --reject"
text tccmmsg " --message=\"$(cat "
text tccmend ")\""
text tccmnom " --no-message"
text tccm4 "rad issue open"
text tccm4t " --title=\"$(head -n 1 issue.md)\" --description=\"$(tail -n +3 issue.md)\""
text tccm5 "git push -o patch.message=\"$(head -n 1 patch.md)\""
text tccm5b " -o patch.message=\"$(tail -n +3 patch.md)\""
text tccm5d " -o patch.draft"
text tccm5r " rad HEAD:refs/patches"
text tccm6 "rad patch edit PATCH_ID"
text tccm6m " --message=\"$(head -n 1 patch.md)\" --message=\"$(tail -n +3 patch.md)\""
note cofneq kd a b: frest[a,b) is the file name of kind kd
fn cofneq kd ulong a ulong b ulong to bool
if or eq kd 1 eq kd 2
ret coseqat a b tcfnc
end
if eq kd 3
ret coseqat a b tcfnr
end
if eq kd 4
ret coseqat a b tcfni
end
ret coseqat a b tcfnp
end
fn cofname kd ulong to void
if or eq kd 1 eq kd 2
fput tcfnc
ret
end
if eq kd 3
fput tcfnr
ret
end
if eq kd 4
fput tcfni
ret
end
fput tcfnp
end
note cozbnl s: the body of slot s has a line break
fn cozbnl s ulong to bool
o = mul s 60000
for k ulong get gczbl s bound 60000
if eq get gczb add o k 10
ret true
end
end
ret false
end
note cocdlf s: the file the command reads: the body (comments, reviews), or the title, a blank line
note and the description (new issues and patches)
fn cocdlf s ulong to long
kd = get gczk s
put fkind 0 1
fsetct tcmdct
fsetcd tccdp
cocdname kd
fcdc 34
put fobl 0 0
if ge kd 4
for k ulong get gcztl s bound 256
fputc get gczti add mul s 256 k
end
fputc 10
if gt get gczbl s 0
fputc 10
end
end
n = get gczbl s
o = mul s 60000
for k ulong n bound 60000
fputc get gczb add o k
end
if gt n 0
fputc 10
end
ret 200
end
fn cocdname kd ulong to void
if or eq kd 1 eq kd 2
cocdt tcfnc
ret
end
if eq kd 3
cocdt tcfnr
ret
end
if eq kd 4
cocdt tcfni
ret
end
cocdt tcfnp
end
fn cocdt t view uchar * to void
for i ulong len t bound 64
fcdc get t i
end
end
note ---- the page
fn cocpage s ulong to long
kd = get gczk s
put ftil 0 0
for i ulong len tctpub
ftic get tctpub i
end
ftirepo
if or eq kd 1 eq kd 4
frepohd 6
else
frepohd 5
end
fput tcpg1
cocphd s
fput tcpg2
if ge kd 4
fput tcpgt1
for k ulong get gcztl s bound 256
fescc get gczti add mul s 256 k
end
fput tcpgt2
end
comdz s
fput tcpg3
cocpdl s
cocprun s
fput tcpgb1
cocpback s
fput tcpgb2
ret 200
end
note cocphd s: the heading, naming the target
fn cocphd s ulong to void
kd = get gczk s
f = get gczf s
if eq kd 4
fput tcpk4
ret
end
if eq kd 5
fput tcpk5
if eq and f 8 8
fput tcpkdr
end
ret
end
if eq kd 1
fput tcpk1
else
if eq kd 2
fput tcpk2
else
fput tcpk3
end
end
for k ulong 8
fputc get gcztg add mul s 40 k
end
if ge kd 2
fput tcpkr
fnum get gczrn s
end
if and eq kd 3 eq f 1
fput tcpkacc
end
if and eq kd 3 eq f 2
fput tcpkrej
end
end
note comdz s: the body of slot s rendered as Markdown (relative links against the default branch)
fn comdz s ulong to void
n = get gczbl s
if eq n 0
fput tcpgnone
ret
end
o = mul s 60000
for k ulong n bound 60000
put fxo k get gczb add o k
end
codrefb
put gbmdl 0 0
fput tcmd1
brmd 0 n
fput tcmd2
end
note cocpdl s: the download step (a review without text needs no file)
fn cocpdl s ulong to void
if and eq get gczk s 3 eq get gczbl s 0
ret
end
fput tcpgdl1
fputrl
fput tccompp
for k ulong 32
fputc get gczid add mul s 32 k
end
fputc 47
cofname get gczk s
fput tcpgdl2
cofname get gczk s
fput tcpgdl3
fputrid get fridx 0
fput tcpgdl4
end
fn cotg40 s ulong to void
for k ulong 40
fputc get gcztg add mul s 40 k
end
end
fn corv40 s ulong to void
for k ulong 40
fputc get gczrv add mul s 40 k
end
end
fn corepo to void
fesc tccmrid
fputrid get fridx 0
end
note cocprun s: the command step(s)
fn cocprun s ulong to void
kd = get gczk s
if eq kd 5
fput tcpgr1p
else
fput tcpgr1
end
if eq kd 1
fesc tccm1
cotg40 s
corepo
cocmsg s
end
if eq kd 2
fesc tccm2
corv40 s
corepo
cocmsg s
end
if eq kd 3
cocrev s
end
if eq kd 4
fesc tccm4
corepo
fesc tccm4t
end
if eq kd 5
cocpush s
end
fput tcpgr2
if and eq kd 5 cozbnl s
fput tcpge1
fesc tccm6
corepo
fesc tccm6m
fput tcpgr2
end
end
fn cocmsg s ulong to void
fesc tccmmsg
cofname get gczk s
fesc tccmend
end
fn cocrev s ulong to void
f = get gczf s
fesc tccm3
cotg40 s
corepo
fesc tccm3r
corv40 s
if eq f 1
fesc tccmacc
end
if eq f 2
fesc tccmrej
end
if eq get gczbl s 0
fesc tccmnom
else
cocmsg s
end
end
fn cocpush s ulong to void
fesc tccm5
if and gt get gczbl s 0 eq cozbnl s false
fesc tccm5b
end
if eq and get gczf s 8 8
fesc tccm5d
end
fesc tccm5r
end
note cocpback s: link back to the issue, the patch or the list
fn cocpback s ulong to void
kd = get gczk s
fputrl
if or eq kd 1 eq kd 4
fput tcissn
else
fput tcpatn
end
if le kd 3
for k ulong 40
fputc get gcztg add mul s 40 k
end
end
end

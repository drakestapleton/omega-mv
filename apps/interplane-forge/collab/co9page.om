note collab/co9page.om (ForgePatches): GET <o>/<r>/compose/<cid>, the checked text with its preview and
note the note that publishing is closed for now, and GET compose/<cid>/<file>, the checked text as a file.
text tcfnc "comment.md"
text tcfnr "review.md"
text tcfni "issue.md"
text tcfnp "patch.md"
text tcmdct "text/markdown; charset=utf-8"
text tccdp "attachment; filename=\""
text tcpg1 "<section class=\"box\"><h2>"
text tcpk1 "Comment on issue "
text tcpk2 "Comment on patch "
text tcpk3 "Review of patch "
text tcpk4 "New issue"
text tcpk5 "New patch"
text tcpkr ", revision "
text tcpkacc " (accept)"
text tcpkrej " (reject)"
text tcpkdr " (draft)"
text tcpg2 "</h2>\n<p class=\"meta\">The forge checked this text and keeps it for 15 minutes, for this session only. It wrote nothing to this repository.</p>\n<h3>Preview</h3>\n"
text tcpgt1 "<p><b>"
text tcpgt2 "</b></p>\n"
text tcpgnone "<p class=\"muted\">No text.</p>\n"
text tcpg3 "<h3>Publish it</h3>\n<ol class=\"so-steps\">\n"
text tcpgdl1 "<li>Save <a href=\""
text tcpgdl2 "\" download>"
text tcpgdl3 "</a> to keep a copy.</li>\n"
text tcpgcl "<li>Publishing it is closed for now: Interplane does not accept comments, reviews, issues or patches yet.</li>\n"
text tcpgb1 "<li><a href=\""
text tcpgb2 "\">Back</a>.</li>\n</ol></section>\n"
note cofneq kd a b: frest[a,b) is the file name of kind kd
fn cofneq kd ulong a ulong b ulong to bool
if or eq kd 1 eq kd 2
ret coseqat a b tcfnc
end
if eq kd 3
ret coseqat a b tcfnr
end
if eq kd 4
ret coseqat a b tcfni
end
ret coseqat a b tcfnp
end
fn cofname kd ulong to void
if or eq kd 1 eq kd 2
fput tcfnc
ret
end
if eq kd 3
fput tcfnr
ret
end
if eq kd 4
fput tcfni
ret
end
fput tcfnp
end
note cocdlf s: the downloaded file: the body (comments, reviews), or the title, a blank line
note and the description (new issues and patches)
fn cocdlf s ulong to long
kd = get gczk s
put fkind 0 1
fsetct tcmdct
fsetcd tccdp
cocdname kd
fcdc 34
put fobl 0 0
if ge kd 4
for k ulong get gcztl s bound 256
fputc get gczti add mul s 256 k
end
fputc 10
if gt get gczbl s 0
fputc 10
end
end
n = get gczbl s
o = mul s 60000
for k ulong n bound 60000
fputc get gczb add o k
end
if gt n 0
fputc 10
end
ret 200
end
fn cocdname kd ulong to void
if or eq kd 1 eq kd 2
cocdt tcfnc
ret
end
if eq kd 3
cocdt tcfnr
ret
end
if eq kd 4
cocdt tcfni
ret
end
cocdt tcfnp
end
fn cocdt t view uchar * to void
for i ulong len t bound 64
fcdc get t i
end
end
note ---- the page
fn cocpage s ulong to long
kd = get gczk s
put ftil 0 0
for i ulong len tctpub
ftic get tctpub i
end
ftirepo
if or eq kd 1 eq kd 4
frepohd 6
else
frepohd 5
end
fput tcpg1
cocphd s
fput tcpg2
if ge kd 4
fput tcpgt1
for k ulong get gcztl s bound 256
fescc get gczti add mul s 256 k
end
fput tcpgt2
end
comdz s
fput tcpg3
cocpdl s
fput tcpgcl
fput tcpgb1
cocpback s
fput tcpgb2
ret 200
end
note cocphd s: the heading, naming the target
fn cocphd s ulong to void
kd = get gczk s
f = get gczf s
if eq kd 4
fput tcpk4
ret
end
if eq kd 5
fput tcpk5
if eq and f 8 8
fput tcpkdr
end
ret
end
if eq kd 1
fput tcpk1
else
if eq kd 2
fput tcpk2
else
fput tcpk3
end
end
for k ulong 8
fputc get gcztg add mul s 40 k
end
if ge kd 2
fput tcpkr
fnum get gczrn s
end
if and eq kd 3 eq f 1
fput tcpkacc
end
if and eq kd 3 eq f 2
fput tcpkrej
end
end
note comdz s: the body of slot s rendered as Markdown (relative links against the default branch)
fn comdz s ulong to void
n = get gczbl s
if eq n 0
fput tcpgnone
ret
end
o = mul s 60000
for k ulong n bound 60000
put fxo k get gczb add o k
end
codrefb
put gbmdl 0 0
fput tcmd1
brmd 0 n
fput tcmd2
end
note cocpdl s: the download step (a review without text needs no file)
fn cocpdl s ulong to void
if and eq get gczk s 3 eq get gczbl s 0
ret
end
fput tcpgdl1
fputrl
fput tccompp
for k ulong 32
fputc get gczid add mul s 32 k
end
fputc 47
cofname get gczk s
fput tcpgdl2
cofname get gczk s
fput tcpgdl3
end
note cocpback s: link back to the issue, the patch or the list
fn cocpback s ulong to void
kd = get gczk s
fputrl
if or eq kd 1 eq kd 4
fput tcissn
else
fput tcpatn
end
if le kd 3
for k ulong 40
fputc get gcztg add mul s 40 k
end
end
end

note collab/co1json.om (ForgePatches): read the flat JSON of one Radicle COB action blob held in fxo[a,e).
note Radicle writes each action as compact JSON on one line, so a scanner over fxo is enough:
note cokey finds a key of an object, coseq compares a string value, cospool decodes a string into gcpool.
note Every function stops at e, so a malformed blob only ends the scan; it never reads past the line.
text tccomma ", "
global gcpool uchar 4194304
global gcpl ulong 1
note cows: index of the first byte at or after p that is not white space (or e)
fn cows p ulong e ulong to ulong
q = p
while lt q e bound 16777216
if gt get fxo q 32
ret q
end
q = add q 1
end
ret e
end
note costre: p is at an opening quote; the index just after the closing quote (or e)
fn costre p ulong e ulong to ulong
q = add p 1
while lt q e bound 16777216
c = get fxo q
if eq c 92
q = add q 2
continue
end
if eq c 34
ret add q 1
end
q = add q 1
end
ret e
end
note coval: skip one JSON value starting at p; the index just after it (or e)
fn coval p ulong e ulong to ulong
if ge p e
ret e
end
if eq get fxo p 34
ret costre p e
end
d = ulong 0
q = p
while lt q e bound 16777216
c = get fxo q
if eq c 34
q = costre q e
continue
end
if or eq c 123 eq c 91
d = add d 1
end
if or eq c 125 eq c 93
if eq d 0
ret q
end
d = sub d 1
if eq d 0
ret add q 1
end
end
if eq d 0
if eq c 44
ret q
end
end
q = add q 1
end
ret e
end
note coraweq: fxo[a,b) equals k byte for byte
fn coraweq a ulong b ulong k view uchar * to bool
if lt b a
ret false
end
if ne sub b a len k
ret false
end
for i ulong len k
if ne get fxo add a i get k i
ret false
end
end
ret true
end
note cokey: the object starting at a (white space allowed); the index of the value of key k, or e
fn cokey a ulong e ulong k view uchar * to ulong
p = cows a e
if ge p e
ret e
end
if ne get fxo p 123
ret e
end
p = cows add p 1 e
while lt p e bound 1048576
if ne get fxo p 34
ret e
end
q = costre p e
m = coraweq add p 1 sub q 1 k
p = cows q e
if ge p e
ret e
end
if ne get fxo p 58
ret e
end
p = cows add p 1 e
if m
ret p
end
p = cows coval p e e
if ge p e
ret e
end
if ne get fxo p 44
ret e
end
p = cows add p 1 e
end
ret e
end
note coseq: the value at p is a string whose raw bytes equal t
fn coseq p ulong e ulong t view uchar * to bool
if ge p e
ret false
end
if ne get fxo p 34
ret false
end
q = costre p e
ret coraweq add p 1 sub q 1 t
end
note cohexat: the value at p is a string of exactly 40 lowercase hex digits (a git object id)
fn cohexat p ulong e ulong to bool
if gt add p 42 e
ret false
end
if ne get fxo p 34
ret false
end
if ne get fxo add p 41 34
ret false
end
for i ulong 40
c = get fxo add p add i 1
if cohexc c
continue
end
ret false
end
ret true
end
note cohexc: a lowercase hex digit
fn cohexc c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
note cohexv: value of a hex digit (either case), 16 when it is not one
fn cohexv c uchar to ulong
if and ge c 48 le c 57
ret sub ulong c 48
end
if and ge c 97 le c 102
ret sub ulong c 87
end
if and ge c 65 le c 70
ret sub ulong c 55
end
ret ulong 16
end
note ---- string decoding into gcpool (cleared per COB load by coreset)
fn copoolc c uchar to void
n = get gcpl 0
if lt n len gcpool
put gcpool n c
put gcpl 0 add n 1
end
end
fn copoolt t view uchar * to void
for i ulong len t
copoolc get t i
end
end
note coutf8: append code point u as UTF-8 (a lone surrogate becomes U+FFFD)
fn coutf8 u ulong to void
v = u
if and ge v 55296 le v 57343
v = ulong 65533
end
if lt v 128
copoolc uchar v
ret
end
if lt v 2048
copoolc uchar or 192 shr v 6
copoolc uchar or 128 and v 63
ret
end
if lt v 65536
copoolc uchar or 224 shr v 12
copoolc uchar or 128 and shr v 6 63
copoolc uchar or 128 and v 63
ret
end
copoolc uchar or 240 and shr v 18 7
copoolc uchar or 128 and shr v 12 63
copoolc uchar or 128 and shr v 6 63
copoolc uchar or 128 and v 63
end
note cohex4: the value of 4 hex digits at p, or 1048576 when they are not hex
fn cohex4 p ulong e ulong to ulong
if gt add p 4 e
ret ulong 1048576
end
v = ulong 0
for i ulong 4
d = cohexv get fxo add p i
if gt d 15
ret ulong 1048576
end
v = or shl v 4 d
end
ret v
end
note couesc: q is at the backslash of a \u escape; append it (joining a surrogate pair); next index
fn couesc q ulong e ulong to ulong
u = cohex4 add q 2 e
if gt u 65535
ret e
end
r = add q 6
if and ge u 55296 le u 56319
if le add r 6 e
if and eq get fxo r 92 eq get fxo add r 1 117
w = cohex4 add r 2 e
if and ge w 56320 le w 57343
u = add 65536 add shl sub u 55296 10 sub w 56320
r = add r 6
end
end
end
end
coutf8 u
ret r
end
note coesc: q is at a backslash; append the escaped byte(s); the next index
fn coesc q ulong e ulong to ulong
if ge add q 1 e
ret e
end
c = get fxo add q 1
if eq c 110
copoolc uchar 10
ret add q 2
end
if eq c 116
copoolc uchar 9
ret add q 2
end
if eq c 114
copoolc uchar 13
ret add q 2
end
if eq c 98
copoolc uchar 8
ret add q 2
end
if eq c 102
copoolc uchar 12
ret add q 2
end
if eq c 117
ret couesc q e
end
copoolc c
ret add q 2
end
note cospool: decode the string at p into gcpool; the number of bytes appended (0 when not a string)
fn cospool p ulong e ulong to ulong
if ge p e
ret 0
end
if ne get fxo p 34
ret 0
end
s = get gcpl 0
q = add p 1
while lt q e bound 16777216
c = get fxo q
if eq c 34
break
end
if eq c 92
q = coesc q e
continue
end
copoolc c
q = add q 1
end
ret sub get gcpl 0 s
end
note coslist: p at an array of strings; append them to gcpool joined by ", "; the bytes appended
fn coslist p ulong e ulong to ulong
s = get gcpl 0
if ge p e
ret 0
end
if ne get fxo p 91
ret 0
end
q = cows add p 1 e
k = ulong 0
while lt q e bound 1048576
if ne get fxo q 34
break
end
if gt k 0
copoolt tccomma
end
x = cospool q e
k = add k 1
q = cows costre q e e
if ge q e
break
end
if ne get fxo q 44
break
end
q = cows add q 1 e
end
ret sub get gcpl 0 s
end

note store/evcol.om: the collector of door/ (docs/AGENT-DOOR.md) in the store-reading build, in place
note of door/ev3col.om (which reads Radicle refs and COBs). run.sh composes it between door/ev2log.om
note and door/ev4json.om when FORGE_STORE is set. One collection pass is change-triggered, never on a
note clock: before a page of the stream is answered, evcollect compares cheap fingerprints with the
note last pass of this process and reads only what moved:
note   social log      its size; the new bytes are read with social's own line parser (stars, follows)
note   store           ROOT/catalog.tsv (its change time and size, part of every project's fingerprint)
note   project i       the change times and sizes of repo.git/refs/heads, repo.git/refs/tags,
note                   repo.git/packed-refs and chain.tsv; then one for-each-ref of the default branch
note                   and the tags, compared line by line with the snapshot <data>events/r/<key>
note Kinds: branch_moved (10) and release (9, a tag created or moved) from the store, star (11) and
note follow (12) from the social log. The open builds shelf and patches and issues are not part of this
note build (their slices are seams), so those kinds never occur. Sources name the store object:
note "chain.tsv:<N>" for a default-branch move recorded by record N of the project's chain (the LAND or
note IMPORT record of that branch whose payload says "new <head>"; its time is the record's time),
note "repo.git:<sha>" for a tag, or for a move no record of the chain names (the commit time), and
note "social.log:<seq>" for stars and follows.
text tevfh1 "<section class=\"box\"><h1>Feed</h1>\n<p class=\"muted\">What happened on this forge, newest first: releases, new commits on default branches, stars and follows. Only public repositories. Agents read the same list as <a href=\""
text tevscat "catalog.tsv"
text tevschn "/chain.tsv"
text tevsrec "/records/"
text tevsland "LAND"
text tevsimp "IMPORT"
text tevsnew "new "
text tevscsrc "chain.tsv:"
text tevsgsrc "repo.git:"
const EVNO ulong 99999999
note the catalog fingerprint of this pass, and the chain record found for a branch move: its number
note (decimal digits) and its time
global gevcfp ulong 1
global gevchn uchar 24
global gevchnl ulong 1
global gevcht ulong 1
fn evcollect to void
if eq get gevok 0 0
evload
end
if ne get gevok 0 1
ret
end
t0 = monons
put gevpr 0 0
put gevpe 0 0
put gevbn 0 0
put gevbatl 0 0
evsocial
fpb
fpt tfsroot
fpt tevscat
put gevcfp 0 evstat
for i ulong get fan 0 bound FAMAX
evrepochk i
end
if gt get gevbn 0 0
evflush
end
put ficut 0 0
put fobtr 0 0
put fobl 0 0
if gt get gevpr 0 0
dt = div ulong sub monons t0 1000
evgb
evgt tevlpas
evgn dt
evgt tevlpus
evgn get gevpr 0
evgt tevlpev
evgn get gevpe 0
evgout
end
end
note ---- the social log (social/30store.om writes it; soload has verified it)
fn evsocial to void
if eq get gsok 0 0
ret
end
sopdd
sopt tslog
fpb
for i ulong get gspthl 0 bound 1024
fpc get gspth i
end
if eq evstat 0
ret
end
sz = evst64 48
off = get gevsoff 0
if eq sz off
ret
end
if lt sz off
off = ulong 0
end
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret
end
put gevpr 0 add get gevpr 0 1
for it ulong 100000
r = pread int fd gevrb 0 len gevrb long off
if le r 0
break
end
u = evsocscan ulong r
if eq u 0
break
end
off = add off u
end
x = fclose int fd
put gevsoff 0 off
end
fn evsocscan n ulong to ulong
ln = new uchar 1024 0
p = ulong 0
for it ulong 2097152
e = evrbeol p n
if ge e n
break
end
l = sub e p
if lt l 1024
for i ulong l bound 1024
put ln i get gevrb add p i
end
evsocln part ln 0 l
end
p = add e 1
end
ret p
end
fn evrbeol p ulong n ulong to ulong
e = p
for k ulong 2097152
if ge e n
ret n
end
if eq get gevrb e 10
ret e
end
e = add e 1
end
ret n
end
note evsocln: one social line; only star (1) and follow (7) are events. fav, unfav, watch, unwatch,
note unstar, unfollow, account, name, session and logout are never read past their action word.
fn evsocln ln view uchar * to void
put gspc 0 0
put gsbad 0 0
solit ln tsl1
seq = sonum ln
solit ln tsl2
ts = sonum ln
solit ln tsl3
sokclr
sokt tsdidp
dl = sostr ln
evclr
for i ulong get gskbl 0 bound 128
evactc get gskb i
end
solit ln tsl4
a = soact ln
solit ln tsl5
sokclr
tl = sostr ln
if ne get gsbad 0 0
ret
end
put gevt 0 ts
evsrct tevsocs
evsrcnum seq
if eq a 1
evsstar
end
if eq a 7
evsfoll
end
end
note evsstar: gskb holds rad:<key>; an event only for a repository that is served now
fn evsstar to void
if not sokpre tsradp
ret
end
for i ulong sub get gskbl 0 len tsradp bound 64
evridc get gskb add len tsradp i
end
r = evridpub
if eq r 9999
ret
end
put gevk 0 11
evpthrepo r
evjsame
evjst tevjsx
for k ulong frnlen r bound 128
evsubc frnbyte r k
end
evemit
end
note evsfoll: gskb holds the followed account's did:key; its page is found when the stream is read
fn evsfoll to void
if not sokpre tsdidp
ret
end
put gevk 0 12
for i ulong get gskbl 0 bound 128
evxc get gskb i
evsubc get gskb i
end
evemit
end
note ---- projects of the store
note evsp i t: fpth = ROOT/projects/<name of i>/repo.git<t>
fn evsp i ulong t view uchar * to void
xspproj i
fpt tfsrg
fpt t
end
note evrepochk i: the fingerprint of project i (its key, the catalog, its ref folders, packed-refs
note and chain); a project whose fingerprint moved is read (evrepo)
fn evrepochk i ulong to void
h = ulong 14695981039346656037
for k ulong fridlen i bound 64
h = evfnv h fridbyte i k
end
h = add h get gevcfp 0
evsp i tevsrh
h = add h mul evstat 3
evsp i tevsrt
h = add h mul evstat 5
evsp i tevspk
h = add h mul evstat 7
xspproj i
fpt tevschn
h = add h mul evstat 11
if eq h get gevfp i
ret
end
if evrepo i
put gevfp i h
end
end
note evsnapp i: fpth = <data>events/r/<key of i>
fn evsnapp i ulong to void
evpath tevrp
for k ulong fridlen i bound 64
fpc fridbyte i k
end
end
note evrepo i: read project i; false when git did not answer (the next pass tries again)
fn evrepo i ulong to bool
fkgiti i
fka tevfer
fka tevfmt
fkopen
fkt tevrh
for k ulong get fabl i bound 64
fkc get fabr add get fabo i k
end
fka tevrt
x = fexec 10000000000
if ne x 0
ret false
end
put gevpr 0 add get gevpr 0 1
if or ne get fxotr 0 0 gt get fxol 0 len gevnew
evgb
evgt tevlcut
for k ulong fridlen i bound 64
evgc fridbyte i k
end
evgout
ret true
end
n = get fxol 0
for k ulong n bound 4194304
put gevnew k get fxo k
end
put gevnewl 0 n
first = evoldld i
p = ulong 0
for it ulong 4194304
if ge p n
break
end
e = p
for k ulong 4194304
if ge e n
break
end
if eq get gevnew e 10
break
end
e = add e 1
end
evrefln i p e first
p = add e 1
end
evsnapw i
ret true
end
note evoldld i: the snapshot of the last read into gevold; true when there is none (first sight)
fn evoldld i ulong to bool
put gevoldl 0 0
evsnapp i
r = frdall
if lt r 0
ret true
end
if or ne get fxotr 0 0 gt get fxol 0 len gevold
ret true
end
n = get fxol 0
for k ulong n bound 4194304
put gevold k get fxo k
end
put gevoldl 0 n
ret false
end
note evsnapw i: gevnew becomes the snapshot (written to .tmp, then renamed over it)
fn evsnapw i ulong to void
evsnapp i
fpt tevtmp
fd = fopen fpth 0 get fpthl 0 524865 384
if lt fd 0
ret
end
n = get gevnewl 0
off = ulong 0
for it ulong 4096
if ge off n
break
end
w = write int fd gevnew off sub n off
if le w 0
break
end
off = add off ulong w
end
x = fsync int fd
y = fclose int fd
if ne off n
ret
end
pk = new uchar 8200 0
put pk 0 2
o = evpkadd pk 2
evsnapp i
o = evpkadd pk o
r = renames pk 0 o 0
end
fn evpkadd pk edit uchar * o ulong to ulong
n = get fpthl 0
put pk o uchar and n 255
put pk add o 1 uchar shr n 8
for k ulong n bound 4096
put pk add add o 2 k get fpth k
end
ret add add o 2 n
end
note ---- one ref line of gevnew: "<sha> <time> <refname>"
fn evrefln i ulong a ulong e ulong first bool to void
if lt sub e a 44
ret
end
if ne get gevnew add a 40 32
ret
end
r = add a 41
t = ulong 0
for k ulong 20
if ge r e
ret
end
c = get gevnew r
r = add r 1
if eq c 32
break
end
if not evdig c
ret
end
t = add mul t 10 ulong sub c 48
end
o = ulong EVNO
if not first
o = evoldsha r e
end
if ne o EVNO
if evsame o a
ret
end
end
note the default branch moved (seen before) or a tag appeared or moved
if evnat r e tevrh
if evnbr i add r len tevrh e
if ne o EVNO
evbranch i o a t
end
end
ret
end
if evnat r e tevrtp
evtag i a t add r len tevrtp e
end
end
fn evsame o ulong a ulong to bool
for k ulong 40
if ne get gevold add o k get gevnew add a k
ret false
end
end
ret true
end
note evnat p e t: gevnew[p, e) starts with t
fn evnat p ulong e ulong t view uchar * to bool
if lt sub e p len t
ret false
end
for k ulong len t bound 128
if ne get gevnew add p k get t k
ret false
end
end
ret true
end
note evnbr i p e: gevnew[p, e) is exactly the default branch of project i
fn evnbr i ulong p ulong e ulong to bool
if ne sub e p get fabl i
ret false
end
o = get fabo i
for k ulong get fabl i bound 64
if ne get gevnew add p k get fabr add o k
ret false
end
end
ret true
end
note evoldsha r e: the offset of the sha of the gevold line whose refname equals gevnew[r, e), else EVNO
fn evoldsha r ulong e ulong to ulong
n = get gevoldl 0
l = sub e r
p = ulong 0
for it ulong 4194304
if ge p n
break
end
q = p
for k ulong 4194304
if ge q n
break
end
if eq get gevold q 10
break
end
q = add q 1
end
s = evoldref p q
if ne s EVNO
if eq sub q s l
if evrefeq s r l
ret p
end
end
end
p = add q 1
end
ret EVNO
end
note evoldref p q: start of the refname of the gevold line [p, q) (after the second space), else EVNO
fn evoldref p ulong q ulong to ulong
if lt sub q p 44
ret EVNO
end
s = add p 41
for k ulong 21
if ge s q
ret EVNO
end
if eq get gevold s 32
ret add s 1
end
s = add s 1
end
ret EVNO
end
fn evrefeq s ulong r ulong l ulong to bool
for k ulong l bound 4096
if ne get gevold add s k get gevnew add r k
ret false
end
end
ret true
end
note ---- events of one project
fn evtag i ulong a ulong t ulong s ulong e ulong to void
evclr
put gevk 0 9
put gevt 0 t
evowndid
evridi i
evsrct tevsgsrc
for k ulong 40
evsrcc get gevnew add a k
end
evpthrepo i
evptht tevrelp
for k ulong sub e s bound 1024
c = get gevnew add s k
evpthc c
evsubc c
end
evjsame
evemit
end
fn evbranch i ulong o ulong a ulong t ulong to void
fkgiti i
fka tevrl
fka tevcnt
fkopen
for k ulong 40
fkc get gevold add o k
end
fkt tevdots
for k ulong 40
fkc get gevnew add a k
end
x = fexec 10000000000
known = false
cnt = ulong 0
if eq x 0
for k ulong get fxol 0 bound 21
c = get fxo k
if not evdig c
break
end
cnt = add mul cnt 10 ulong sub c 48
known = true
end
end
rec = evchain i a
evclr
put gevk 0 10
put gevt 0 t
if and rec ne get gevcht 0 0
put gevt 0 get gevcht 0
end
evowndid
evridi i
if rec
evsrct tevscsrc
for k ulong get gevchnl 0 bound 24
evsrcc get gevchn k
end
else
evsrct tevsgsrc
for k ulong 40
evsrcc get gevnew add a k
end
end
for k ulong 40
evxc get gevold add o k
end
evxc 32
evpthrepo i
evptht tevcmpp
for k ulong 40
evpthr get gevold add o k
end
evptht tevtdot
for k ulong 40
evpthr get gevnew add a k
end
evjsame
evbrsub i known cnt
evemit
end
note evbrsub: "<n> new commit(s) on <branch>", or "<branch> moved" when the count is not known
fn evbrsub i ulong known bool cnt ulong to void
o = get fabo i
if not known
evxc 45
for k ulong get fabl i bound 64
evsubc get fabr add o k
end
evsubt tevmovd
ret
end
d = new uchar 24 0
n = evdec cnt d
for k ulong n bound 24
evxc get d k
evsubc get d k
end
evsubt tevncom
if ne cnt 1
evsubt tevncs
end
evsubt tevon
for k ulong get fabl i bound 64
evsubc get fabr add o k
end
end
note ---- the chain record of a branch move
note evchain i a: the last LAND or IMPORT record of project i's chain for its default branch, when its
note payload (records/N) says "new <gevnew[a, a+40)>": gevchn / gevchnl hold N and gevcht its time;
note false otherwise (no such record, or a chain or record that cannot be read whole)
fn evchain i ulong a ulong to bool
put gevchnl 0 0
put gevcht 0 0
xspproj i
fpt tevschn
r = frdall
if or lt r 0 ne get fxotr 0 0
ret false
end
n = get fxol 0
p = ulong 0
for it ulong n bound 16777216
if ge p n
break
end
e = p
for k ulong sub n p bound 16777216
if eq get fxo e 10
break
end
e = add e 1
end
evchln i p e
p = add e 1
end
if eq get gevchnl 0 0
ret false
end
xspproj i
fpt tevsrec
for k ulong get gevchnl 0 bound 24
fpc get gevchn k
end
r2 = frdall
if or lt r2 0 ne get fxotr 0 0
put gevchnl 0 0
ret false
end
if evhasnew a
ret true
end
put gevchnl 0 0
ret false
end
note evchln i p e: chain line fxo[p, e) "N TAB time TAB KIND TAB actor TAB branch TAB ...": when KIND is
note LAND or IMPORT and branch is i's default branch, N and the time are kept
fn evchln i ulong p ulong e ulong to void
tb = new ulong 5 0
k = ulong 0
for j ulong sub e p bound 16777216
if eq get fxo add p j 9
if lt k 5
put tb k add p j
end
k = add k 1
end
end
if lt k 5
ret
end
if not evchkk get tb 1 get tb 2
ret
end
if not evchkb i add get tb 3 1 get tb 4
ret
end
evchkn p get tb 0 get tb 1
end
note evchkk t1 t2: KIND, fxo(t1, t2), is LAND or IMPORT
fn evchkk t1 ulong t2 ulong to bool
ks = add t1 1
ret or evcfx ks t2 tevsland evcfx ks t2 tevsimp
end
note evchkb i bs be: fxo[bs, be) is i's default branch
fn evchkb i ulong bs ulong be ulong to bool
if ne sub be bs get fabl i
ret false
end
o = get fabo i
n = sub be bs
for j ulong n bound 64
if ne get fxo add bs j get fabr add o j
ret false
end
end
ret true
end
note evchkn p t0 t1: keep the record number fxo[p, t0) (1..20 digits) and the time fxo(t0, t1)
fn evchkn p ulong t0 ulong t1 ulong to void
nl = sub t0 p
if or eq nl 0 gt nl 20
ret
end
for j ulong nl bound 20
if not evdig get fxo add p j
ret
end
end
for j ulong nl bound 20
put gevchn j get fxo add p j
end
put gevchnl 0 nl
ts = add t0 1
put gevcht 0 0
if eq sub t1 ts 20
put gevcht 0 evisot ts
end
end
fn evcfx a ulong e ulong t view uchar * to bool
if ne sub e a len t
ret false
end
for i ulong len t bound 64
if ne get fxo add a i get t i
ret false
end
end
ret true
end
note evhasnew a: the record payload in fxo has the line "new <gevnew[a, a+40)>"
fn evhasnew a ulong to bool
n = get fxol 0
p = ulong 0
for it ulong n bound 16777216
if ge p n
break
end
e = p
for k ulong sub n p bound 16777216
if eq get fxo e 10
break
end
e = add e 1
end
if evnewln p e a
ret true
end
p = add e 1
end
ret false
end
note evnewln p e a: fxo[p, e) is exactly "new " and gevnew[a, a+40)
fn evnewln p ulong e ulong a ulong to bool
if ne sub e p add len tevsnew 40
ret false
end
q = add p len tevsnew
if not evcfx p q tevsnew
ret false
end
for k ulong 40
if ne get fxo add q k get gevnew add a k
ret false
end
end
ret true
end
note evisot p: fxo[p, p+20) "YYYY-MM-DDTHH:MM:SSZ" as epoch seconds (UTC); 0 when it is not that shape
fn evisot p ulong to ulong
for k ulong 20
c = get fxo add p k
if or eq k 4 eq k 7
if ne c 45
ret 0
end
continue
end
if eq k 10
if ne c 84
ret 0
end
continue
end
if or eq k 13 eq k 16
if ne c 58
ret 0
end
continue
end
if eq k 19
if ne c 90
ret 0
end
continue
end
if not evdig c
ret 0
end
end
days = evisod p
if eq days 0
ret 0
end
hh = evcnum add p 11 2
mi = evcnum add p 14 2
ss = evcnum add p 17 2
if or or gt hh 23 gt mi 59 gt ss 60
ret 0
end
s = add mul hh 3600 add mul mi 60 ss
ret add mul days 86400 s
end
note evisod p: the date fxo[p, p+10) as days since 1970-01-01, 0 when out of range
fn evisod p ulong to ulong
y = evcnum p 4
mo = evcnum add p 5 2
d = evcnum add p 8 2
if or lt y 1970 or lt mo 1 gt mo 12
ret 0
end
if or lt d 1 gt d 31
ret 0
end
ret evcdays y mo d
end
fn evcnum p ulong n ulong to ulong
v = ulong 0
for k ulong n bound 8
v = add mul v 10 ulong sub get fxo add p k 48
end
ret v
end
note evcdays y m d: days from 1970-01-01 to the proleptic Gregorian date (y >= 1970)
fn evcdays y ulong m ulong d ulong to ulong
mp = add m 9
yy = sub y 1
if gt m 2
mp = sub m 3
yy = y
end
doy = add div add mul 153 mp 2 5 sub d 1
ret evcdz yy doy
end
note evcdz yy doy: days since 1970-01-01 of day doy (0 = 1 March) of the March-based year yy
fn evcdz yy ulong doy ulong to ulong
era = div yy 400
yoe = sub yy mul era 400
doe = add mul yoe 365 div yoe 4
doe = add doe doy
doe = sub doe div yoe 100
ret sub add mul era 146097 doe 719468
end

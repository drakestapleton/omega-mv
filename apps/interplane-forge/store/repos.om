note store/repos.om: the native-store source of the store-reading build. run.sh composes it in place
note of server/repos.om when FORGE_STORE is set, after .build/store.om (tfsroot, the store root with a
note final "/", and FSCB / tfcbase, the HTTPS clone base). It defines the words server/repos.om
note defines (fload, fsrcchg, fkgit, fkgiti, fputid, fhasal, fradsrc, fpjterms, fjclone, tfsf4) from
note the store that interplane-native CONTRACT.md v0 describes:
note   ROOT/catalog.tsv              name TAB id TAB default-branch TAB head TAB visibility LF
note   ROOT/projects/NAME/repo.git   the project's bare Git repository
note   ROOT/projects/NAME/records/1  record 1: name, branch, visibility, owner key, alias, nonce
note The project list is the catalog and nothing else: no folder is scanned, and RIDS.md and
note ~/.radicle are never read on this path. Fail closed: a catalog that cannot be read or is a link,
note is longer than fxo, has a line without exactly five tab-separated fields or without its final
note line feed, holds a control byte, a name, id, branch, head or visibility outside the rules of
note om/landrec.om in interplane-native, two names that differ only in case or two equal ids: then
note fan is 0 (every repository URL is 404) and one "forged: catalog refused" line on stderr gives
note the reason and the line. Private lines are skipped. Every public line is served (Drake's
note decision: the store build serves the whole public catalog, minus the deny list), except one the
note allow-list table cannot hold (FAMAX rows, server/util.om; store/tests/capacity.sh alarms long
note before), left out with one line each. A public line is served only when (xsok):
note   ROOT/projects, the project folder, its repo.git and records are folders, not links (lstat);
note   records/1 (opened without following a link) hashes to the line's id with SHA-256, and is the
note   PROJECT record of the same name, branch and visibility public;
note   the deny list (server/repos.om fdeny) names neither the name nor the old Radicle id;
note   no project already served has the same old Radicle id;
note   refs/heads/<branch> in repo.git is exactly the line's head (or is absent when the head is none);
note   the name fits the table (100 bytes, fnmput) and the branch too (60 bytes, fbrput).
note Otherwise that project alone is left out with one "forged: project NAME left out" line on stderr.
note The key of a project (faid: social targets, counts, receipts, the archive cache folder, /rad:
note links) is its old Radicle id from record 1 (alias) without "rad:", or its 64-hex id when it has
note none. New identifiers in pages and machine forms are git:<id> (fputid).
global xsgid uchar 16384
global xshead uchar 10240
global xshn ulong 256
global xsown uchar 16384
global xsownl ulong 256
global xsal ulong 256
global xskeep ulong 256
global xsck ulong 4
global xsmsg uchar 8192
global xsml ulong 1
text tfsprjd "projects"
text tfsrec "/records"
text tfsrec1 "/records/1"
text tfscat "catalog.tsv"
text tfsgitp "git:"
text tfradp "rad:"
text tfsnone "none"
text tfspub "public"
text tfspriv "private"
text tfsrevp "rev-parse"
text tfsq "-q"
text tfsvfy "--verify"
text tfscmt "^{commit}"
text tfsr1a "interplane-project 1\nproject "
text tfsr1b "branch "
text tfsr1c "visibility public\nowner "
text tfsr1d "alias "
text tfsr1e "nonce "
text tfsfp "SHA256:"
text tfsm1 "forged: catalog refused ("
text tfsm2 " at line "
text tfsm3 "); no repositories are served\n"
text tfsm4 "forged: project "
text tfsm5 " left out ("
text tfsm6 ")\n"
text tfsrd "cannot be read or is a link"
text tfsbig "longer than the read buffer"
text tfsnolf "no final line feed"
text tfsctl "control byte"
text tfsnf "not five tab-separated fields"
text tfsbn "name outside the name rule"
text tfsbi "id is not 64 lowercase hex digits"
text tfsbb "branch outside the branch rule"
text tfsbh "head is not 40 lowercase hex digits or none"
text tfsbv "visibility is not public or private"
text tfsdn "two names that differ only in case"
text tfsdn2 "two equal names"
text tfsdi "two equal ids"
text tfsful "the allow-list table is full (FAMAX rows, server/util.om)"
text tfsplk "ROOT/projects is a link or not a folder"
text tfslnm "name longer than 100 bytes (server/repos.om fnmput)"
text tfslbr "branch longer than 60 bytes (server/repos.om fbrput)"
text tfslpf "project folder is a link or not a folder"
text tfslrg "repo.git is a link or not a folder"
text tfslrc "records is a link or not a folder"
text tfslr1 "records/1 cannot be read or is a link"
text tfslhs "records/1 does not hash to the catalog id"
text tfslpr "records/1 is not the PROJECT record of this name, branch and visibility public"
text tfsldn "on the deny list"
text tfsldl "old Radicle id already used by a project listed before it"
text tfslhd "refs/heads/<branch> in repo.git is not the catalog head"
text tfslpl "path longer than the system allows"
note ---- stderr lines
fn xsmb to void
put xsml 0 0
end
fn xsmc c uchar to void
n = get xsml 0
if lt n len xsmsg
put xsmsg n c
put xsml 0 add n 1
end
end
fn xsmt t view uchar * to void
for i ulong len t bound 8192
xsmc get t i
end
end
fn xsmn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
xsmc get d add i k
end
end
fn xsmw to void
w = write 2 xsmsg 0 get xsml 0
end
note xsrefuse: the whole catalog is refused (line 0: no line)
fn xsrefuse t view uchar * ln ulong to long
put fan 0 0
xsmb
xsmt tfsm1
xsmt t
if gt ln 0
xsmt tfsm2
xsmn ln
end
xsmt tfsm3
xsmw
ret -1
end
note xsleave: project k is left out
fn xsleave k ulong t view uchar * to void
put xskeep k 0
xsmb
xsmt tfsm4
for i ulong get fanl k bound 128
xsmc frnbyte k i
end
xsmt tfsm5
xsmt t
xsmt tfsm6
xsmw
end
note ---- byte rules (om/landrec.om of interplane-native: isname, isref, hex)
fn xsaln c uchar to bool
ret fisaln c
end
fn xsnamec c uchar to bool
ret or xsaln c or eq c 46 or eq c 95 eq c 45
end
fn xshexc c uchar to bool
ret or fisdig c and ge c 97 le c 102
end
fn xsisname a ulong b ulong to bool
if ge a b
ret false
end
if not xsaln get fxo a
ret false
end
if eq get fxo sub b 1 46
ret false
end
j = a
while lt j b bound 16777216
if not xsnamec get fxo j
ret false
end
j = add j 1
end
ret true
end
fn xsishex a ulong b ulong n ulong to bool
if ne sub b a n
ret false
end
j = a
while lt j b bound 16777216
if not xshexc get fxo j
ret false
end
j = add j 1
end
ret true
end
fn xsrefc c uchar to bool
ret or xsnamec c eq c 47
end
note xslock: fxo[e-5, e) is ".lock" and starts at or after a
fn xslock a ulong e ulong to bool
if lt sub e a 5
ret false
end
s = sub e 5
if ne get fxo s 46
ret false
end
if ne get fxo add s 1 108
ret false
end
if ne get fxo add s 2 111
ret false
end
if ne get fxo add s 3 99
ret false
end
ret eq get fxo add s 4 107
end
fn xsisref a ulong b ulong to bool
if ge a b
ret false
end
f = get fxo a
if or eq f 45 or eq f 46 eq f 47
ret false
end
l = get fxo sub b 1
if or eq l 46 eq l 47
ret false
end
p = uchar 0
j = a
while lt j b bound 16777216
c = get fxo j
if not xsrefc c
ret false
end
if and eq c 46 or eq p 46 eq p 47
ret false
end
if and eq c 47 eq p 47
ret false
end
if eq c 47
if xslock a j
ret false
end
end
p = c
j = add j 1
end
ret not xslock a b
end
fn xstxeq a ulong b ulong t view uchar * to bool
if ne sub b a len t
ret false
end
for k ulong len t bound 64
if ne get fxo add a k get t k
ret false
end
end
ret true
end
note ---- catalog lines: fxo[p, e) is one line without its line feed
fn xstab p ulong e ulong k ulong to ulong
note start of field k (0..4); fields are known to exist
j = p
n = ulong 0
while lt j e bound 16777216
if eq n k
ret j
end
if eq get fxo j 9
n = add n 1
end
j = add j 1
end
ret e
end
fn xsfend s ulong e ulong to ulong
j = s
while lt j e bound 16777216
if eq get fxo j 9
ret j
end
j = add j 1
end
ret e
end
note xsline: the reason line p..e breaks a rule, or 0 when it is well formed
fn xsline p ulong e ulong to ulong
t = ulong 0
j = p
while lt j e bound 16777216
c = get fxo j
if eq c 9
t = add t 1
else
if or lt c 32 eq c 127
ret 1
end
end
j = add j 1
end
if ne t 4
ret 2
end
ret xsfields p e
end
note xsfields: the five fields of a line with four tabs and no control byte
fn xsfields p ulong e ulong to ulong
s = p
f = xsfend s e
if not xsisname s f
ret 3
end
s = add f 1
f = xsfend s e
if not xsishex s f 64
ret 4
end
s = add f 1
f = xsfend s e
if not xsisref s f
ret 5
end
s = add f 1
f = xsfend s e
if not xshdok s f
ret 6
end
s = add f 1
if not xsvisok s e
ret 7
end
ret 0
end
fn xshdok s ulong f ulong to bool
if xsishex s f 40
ret true
end
ret xstxeq s f tfsnone
end
fn xsvisok s ulong e ulong to bool
if xstxeq s e tfspub
ret true
end
ret xstxeq s e tfspriv
end
fn xsreason r ulong ln ulong to long
if eq r 1
ret xsrefuse tfsctl ln
end
if eq r 2
ret xsrefuse tfsnf ln
end
if eq r 3
ret xsrefuse tfsbn ln
end
if eq r 4
ret xsrefuse tfsbi ln
end
if eq r 5
ret xsrefuse tfsbb ln
end
if eq r 6
ret xsrefuse tfsbh ln
end
if eq r 7
ret xsrefuse tfsbv ln
end
if eq r 8
ret xsrefuse tfsdn ln
end
if eq r 10
ret xsrefuse tfsdn2 ln
end
ret xsrefuse tfsdi ln
end
fn xsfold c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end
note xsdupat: line [p, e) repeats the name (10 the same bytes, 8 apart from case) or the id (9) of
note line [q, f); 0 if neither
fn xsdupat p ulong e ulong q ulong f ulong to ulong
b = xsfend p e
d = xsfend q f
if xsfoldeq p b q d
if xsexeq p b q
ret 10
end
ret 8
end
if xsideq add b 1 add d 1
ret 9
end
ret 0
end
note xsexeq: fxo[a, b) equals the same number of bytes at c
fn xsexeq a ulong b ulong c ulong to bool
for k ulong sub b a bound 16777216
if ne get fxo add a k get fxo add c k
ret false
end
end
ret true
end
note xsfoldeq: fxo[a, b) and fxo[c, d) are equal apart from the case of A-Z
fn xsfoldeq a ulong b ulong c ulong d ulong to bool
if ne sub b a sub d c
ret false
end
for k ulong sub b a bound 16777216
x = xsfold get fxo add a k
y = xsfold get fxo add c k
if ne x y
ret false
end
end
ret true
end
fn xsideq a ulong c ulong to bool
for k ulong 64
if ne get fxo add a k get fxo add c k
ret false
end
end
ret true
end
note xsdup: line [p, e) repeats a line before it (8 or 9), or 0
fn xsdup p ulong e ulong to ulong
q = ulong 0
while lt q p bound 16777216
f = fleol q p
r = xsdupat p e q f
if ne r 0
ret r
end
q = add f 1
end
ret 0
end
fn xsispub p ulong e ulong to bool
s4 = xstab p e 4
ret xstxeq s4 e tfspub
end
note ---- paths
fn xspfold to void
fpb
fpt tfsroot
fpt tfsprj
end
note xspdir: ROOT/projects without the final "/", so that lstat sees a link as a link
fn xspdir to void
fpb
fpt tfsroot
fpt tfsprjd
end
fn xspproj k ulong to void
xspfold
for i ulong get fanl k bound 128
fpc frnbyte k i
end
end
fn xspfull to bool
ret ge get fpthl 0 4095
end
note xsisdir: lstat of fpth is a folder (a link is not)
fn xsisdir to bool
if xspfull
ret false
end
r = lstat fpth 0 get fpthl 0 fstb 0 128
if lt r 0
ret false
end
m = or ulong get fstb 16 shl ulong get fstb 17 8
ret eq and m 61440 16384
end
note xsrdnf: read the file at fpth into fxo without following a link (O_NOFOLLOW | O_CLOEXEC);
note the length, or -1 when it cannot be opened or is longer than fxo
fn xsrdnf to long
b = new uchar 1 0
put fxol 0 0
put fxotr 0 0
if xspfull
ret -1
end
fd = fopen fpth 0 get fpthl 0 557056 0
if lt fd 0
ret -1
end
ok = true
for it ulong 16777217
n = get fxol 0
if ge n len fxo
q = read int fd b 0 1
if ne q 0
put fxotr 0 1
ok = false
end
break
end
r = read int fd fxo n sub len fxo n
if lt r 0
ok = false
break
end
if eq r 0
break
end
put fxol 0 add n ulong r
end
x = fclose int fd
if not ok
ret -1
end
ret long get fxol 0
end
note xsstat: the change key of the catalog (inode, size, mtime s, mtime ns), all 0 when missing
fn xsstat k edit ulong 4 to void
fpb
fpt tfsroot
fpt tfscat
for i ulong 4
put k i 0
end
r = stat fpth 0 get fpthl 0 fstb 0 128
if lt r 0
ret
end
put k 0 xsle8 8
put k 1 xsle8 48
put k 2 xsle8 88
put k 3 xsle8 96
end
fn xsle8 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get fstb add o i mul i 8
end
ret v
end
fn fsrcchg to bool
k = new ulong 4 0
xsstat k
for i ulong 4
if ne get k i get xsck i
ret true
end
end
ret false
end
note ---- the catalog
fn fload to long
put fan 0 0
put fsrcst 0 1
fd = fopen tfpubgit 0 len tfpubgit 0 0
put fpubgit 0 0
if ge fd 0
put fpubgit 0 1
x = fclose int fd
end
put fsrtl 0 0
for i ulong len tfsroot bound 4096
put fsrt i get tfsroot i
put fsrtl 0 add i 1
end
k = new ulong 4 0
xsstat k
for i ulong 4
put xsck i get k i
end
xspdir
if not xsisdir
ret xsrefuse tfsplk 0
end
n = xscatrd
if lt n 0
if ne get fxotr 0 0
ret xsrefuse tfsbig 0
end
ret xsrefuse tfsrd 0
end
ln = ulong n
if and gt ln 0 ne get fxo sub ln 1 10
ret xsrefuse tfsnolf 0
end
p = ulong 0
li = ulong 0
while lt p ln bound 16777216
e = fleol p ln
li = add li 1
r = xsline p e
if ne r 0
ret xsreason r li
end
r = xsdup p e
if ne r 0
ret xsreason r li
end
p = add e 1
end
m = xsfill ln
put fan 0 m
for i ulong m bound FAMAX
xscheck i
end
w = ulong 0
for i ulong m bound FAMAX
if eq get xskeep i 1
xsmove w i
w = add w 1
end
end
put fan 0 w
for i ulong w bound FAMAX
fmeta i
end
ret long w
end
note xscatrd: ROOT/catalog.tsv into fxo, opened without following a link. The project list is this
note file and nothing else (store/tests/compare.sh mutant "scan" replaces this word with a reader
note of the project folders and must be caught).
fn xscatrd to long
fpb
fpt tfsroot
fpt tfscat
ret xsrdnf
end
note xsfill: every public line of the catalog in fxo[0, ln) into the table, in catalog order; the
note number of rows. A name or branch the table cannot hold, or a line past FAMAX rows, leaves that
note project out here.
fn xsfill ln ulong to ulong
k = ulong 0
p = ulong 0
while lt p ln bound 16777216
e = fleol p ln
if xsispub p e
e0 = xsfend p e
if ge k FAMAX
xsleavr p e0 tfsful
else
if xsrow k p e
k = add k 1
end
end
end
p = add e 1
end
ret k
end
fn xsrow k ulong p ulong e ulong to bool
e0 = xsfend p e
if not fnmput k p e0
xsleavr p e0 tfslnm
ret false
end
s = xstab p e 2
if not fbrput k s xsfend s e
xsleavr p e0 tfslbr
ret false
end
xsrowid k xstab p e 1
xsrowhd k xstab p e 3 e
put faio k mul k 64
put fail k 0
put xsal k 0
put xsownl k 0
put xskeep k 1
ret true
end
fn xsrowid k ulong s ulong to void
g = mul k 64
for j ulong 64
put xsgid add g j get fxo add s j
end
end
fn xsrowhd k ulong s ulong e ulong to void
if xstxeq s xsfend s e tfsnone
put xshn k 0
ret
end
put xshn k 1
g = mul k 40
for j ulong 40
put xshead add g j get fxo add s j
end
end
note xsleavr: a project left out while its name is still in fxo[a, b)
fn xsleavr a ulong b ulong t view uchar * to void
xsmb
xsmt tfsm4
for j ulong sub b a bound 16777216
xsmc get fxo add a j
end
xsmt tfsm5
xsmt t
xsmt tfsm6
xsmw
end
note ---- one project (xscheck sets xskeep k to 1 when it is served)
fn xscheck k ulong to void
put xskeep k 0
if not xsfolders k
ret
end
if not xsrec1 k
ret
end
if fdeny k
xsleave k tfsldn
ret
end
if xsaldup k
xsleave k tfsldl
ret
end
if not xsheadok k
xsleave k tfslhd
ret
end
put xskeep k 1
end
fn xsfolders k ulong to bool
xspproj k
if xspfull
xsleave k tfslpl
ret false
end
if not xsisdir
xsleave k tfslpf
ret false
end
xspproj k
fpt tfsrg
if not xsisdir
xsleave k tfslrg
ret false
end
xspproj k
fpt tfsrec
if not xsisdir
xsleave k tfslrc
ret false
end
ret true
end
note xsrec1: records/1 of project k hashes to its id and is its PROJECT record; sets the key, the
note owner and xsal
fn xsrec1 k ulong to bool
xspproj k
fpt tfsrec1
n = xsrdnf
if lt n 0
xsleave k tfslr1
ret false
end
if not xshashok k ulong n
xsleave k tfslhs
ret false
end
if not xsparse k ulong n
xsleave k tfslpr
ret false
end
ret true
end
fn xshashok k ulong n ulong to bool
c = new ulong 40 0
b = new uchar 4096 0
h = new uchar 32 0
sha256_init c
o = ulong 0
while lt o n bound 16777216
m = hmin sub n o 4096
for j ulong m bound 4096
put b j get fxo add o j
end
sha256_update c part b 0 m
o = add o m
end
sha256_final c h
ret xsdgeq k h
end
note xsdgeq: the 64-hex id of row k spells the digest h
fn xsdgeq k ulong h view uchar 32 to bool
g = mul k 64
for j ulong 32
v = get h j
a = add g mul j 2
if ne get xsgid a xshexd shr v 4
ret false
end
if ne get xsgid add a 1 xshexd and v 15
ret false
end
end
ret true
end
fn xshexd v uchar to uchar
if lt v 10
ret add v 48
end
ret add v 87
end
note xsat: fxo[p, ...) starts with text t (within n)
fn xsat p ulong n ulong t view uchar * to bool
if gt add p len t n
ret false
end
for j ulong len t bound 64
if ne get fxo add p j get t j
ret false
end
end
ret true
end
note xsparse: fxo[0, n) is exactly "interplane-project 1\nproject NAME\nbranch BRANCH\nvisibility
note public\nowner SHA256:<43 base64>\nalias <rad:z... or ->\nnonce <32 hex>\n" for project k
fn xsparse k ulong n ulong to bool
if not xsat 0 n tfsr1a
ret false
end
p = len tfsr1a
e = fleol p n
if not xsnmeq k p e
ret false
end
p = add e 1
if not xsat p n tfsr1b
ret false
end
p = add p len tfsr1b
e = fleol p n
if not xsbreq k p e
ret false
end
p = add e 1
if not xsat p n tfsr1c
ret false
end
p = add p len tfsr1c
e = fleol p n
if not xsowner k p e
ret false
end
p = add e 1
if not xsat p n tfsr1d
ret false
end
p = add p len tfsr1d
e = fleol p n
if not xsalias k p e
ret false
end
p = add e 1
if not xsat p n tfsr1e
ret false
end
p = add p len tfsr1e
e = fleol p n
if not xsishex p e 32
ret false
end
ret eq add e 1 n
end
fn xsnmeq k ulong a ulong b ulong to bool
if ne sub b a get fanl k
ret false
end
for j ulong sub b a bound 128
if ne get fxo add a j frnbyte k j
ret false
end
end
ret true
end
fn xsbreq k ulong a ulong b ulong to bool
if ne sub b a get fabl k
ret false
end
o = get fabo k
for j ulong sub b a bound 64
if ne get fxo add a j get fabr add o j
ret false
end
end
ret true
end
fn xsb64c c uchar to bool
ret or xsaln c or eq c 43 eq c 47
end
fn xsowner k ulong a ulong b ulong to bool
if ne sub b a 50
ret false
end
if not xsat a b tfsfp
ret false
end
for j ulong 43
if not xsb64c get fxo add add a 7 j
ret false
end
end
for j ulong 50
put xsown add mul k 64 j get fxo add a j
end
put xsownl k 50
ret true
end
note xsalias: "-" (no old id: the key is the 64-hex id) or "rad:z" and 20..60 letters and digits in
note all after "rad:" (the key is that RID)
fn xsalias k ulong a ulong b ulong to bool
g = mul k 64
if and eq sub b a 1 eq get fxo a 45
for j ulong 64
put faid add g j get xsgid add g j
end
put fail k 64
put xsal k 0
ret true
end
if lt sub b a 5
ret false
end
if not xsat a b tfradp
ret false
end
s = add a 4
l = sub b s
if or lt l 21 gt l 61
ret false
end
if ne get fxo s 122
ret false
end
for j ulong l bound 64
if not xsaln get fxo add s j
ret false
end
end
for j ulong l bound 64
put faid add g j get fxo add s j
end
put fail k l
put xsal k 1
ret true
end
note xsaldup: an earlier project still served has the same old Radicle id
fn xsaldup k ulong to bool
if eq get xsal k 0
ret false
end
for j ulong k bound FAMAX
if and eq get xskeep j 1 eq get xsal j 1
if xskeyeq j k
ret true
end
end
end
ret false
end
fn xskeyeq a ulong b ulong to bool
if ne get fail a get fail b
ret false
end
for j ulong get fail a bound 64
if ne fridbyte a j fridbyte b j
ret false
end
end
ret true
end
note xsheadok: refs/heads/<branch> of repo.git is the catalog head, or is absent when the head is none
fn xsheadok k ulong to bool
fkgiti k
fka tfsrevp
fka tfsq
fka tfsvfy
fkopen
fkt tfrh
o = get fabo k
for j ulong get fabl k bound 64
fkc get fabr add o j
end
fkt tfscmt
st = fexec 5000000000
if eq get xshn k 0
ret ne st 0
end
if ne st 0
ret false
end
if ne get fxol 0 41
ret false
end
if ne get fxo 40 10
ret false
end
g = mul k 40
for j ulong 40
if ne get fxo j get xshead add g j
ret false
end
end
ret true
end
note xsmove: row i to row w (w < i), with the store's own columns
fn xsmove w ulong i ulong to void
if eq w i
ret
end
fmove w i
put xshn w get xshn i
put xsal w get xsal i
put xsownl w get xsownl i
put xskeep w get xskeep i
for j ulong 64
put xsgid add mul w 64 j get xsgid add mul i 64 j
put xsown add mul w 64 j get xsown add mul i 64 j
end
for j ulong 40
put xshead add mul w 40 j get xshead add mul i 40 j
end
end
note ---- git on a project: server/util.om fkgit / fkgiti name <fsrt>projects/NAME/repo.git once
note fsrcst is 1 (fload sets it and fsrt before it runs any git)
note ---- identity in pages and machine forms
fn fputid i ulong to void
fput tfsgitp
for k ulong 64
fputc get xsgid add mul i 64 k
end
end
fn fhasal i ulong to bool
ret eq get xsal i 1
end
fn fradsrc to bool
ret false
end
note fradwalk / fradseeds: the store has no routing table; server/counts.om fzseeds never calls them
note here (fradsrc is false), they exist so that counts.om composes unchanged
fn fradwalk to ulong
ret 0
end
fn fradseeds i ulong to long
ret -1
end
text tfsf4 "<p class=\"foot-fine\">INTERPLANE Forge: agents express intent; the forge retains authority. Repositories are plain Git kept in Interplane's own signed store, served by forged, a seeded-Omega web server, with no JavaScript.</p>\n<p class=\"foot-fine\"><a href=\""
note ---- the identity words of the "For developers" section (server/pages.om fpjdev1): ID, Owner,
note Refs and HEAD, and Patch up to its link. The Seed word is gone: this build reads no routing table.
text tsdv1 "<dt>ID</dt><dd>The project's permanent id on Interplane: the SHA-256 of its first signed record. This one is <code>git:"
text tsdv2 "</code>."
text tsdv3 " Its old id, kept only so that old links still work: <code>"
text tsdv4 "</dd>\n<dt>Owner</dt><dd>The key that signs every record of the project. This forge lists the project under "
text tsdv5 "; its key is <code>"
text tsdv6 "</code>.</dd>\n<dt>Refs and HEAD</dt><dd>Refs are the names that point at versions: branches and tags. HEAD is the version a fresh copy starts from, the newest commit of the default branch.</dd>\n<dt>Patch</dt><dd>A proposed change, reviewed before it is merged. This forge does not show proposed changes from its own store yet. The list is under <a href=\""
fn fpjterms to void
i = get fridx 0
if ge i get fan 0
ret
end
fput tsdv1
fputid4 i
fput tsdv2
if fhasal i
fput tsdv3
for k ulong get fail i bound 64
fescc fridbyte i k
end
fput tsdv2
end
fput tsdv4
fputown
fput tsdv5
for k ulong get xsownl i bound 64
fescc get xsown add mul i 64 k
end
fput tsdv6
end
fn fputid4 i ulong to void
for k ulong 64
fputc get xsgid add mul i 64 k
end
end
note ---- the clone object of the JSON repo form. Its keys stay those of forge/repo/1 (docs/API.md: keys
note are never removed): rad and rad_clone are null (no Radicle copy is served), git_https is the
note HTTPS address when the build has a clone base (FSCB 1), else null.
text tsjcl1 ",\n\"clone\":{\"rad\":null,\"rad_clone\":null,\"git_https\":"
text tsjcl2 "\""
text tsjcl3 "\"}"
text tsjcl4 "null}"
fn fjclone i ulong to void
fput tsjcl1
if eq FSCB 1
fput tsjcl2
fput tfcbase
fput tfsprj
for k ulong get fanl i bound 128
fputc frnbyte i k
end
fput tfsrg
fput tsjcl3
ret
end
fput tsjcl4
end

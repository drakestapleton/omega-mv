note store/tests/mutant-scan.om: TEST-ONLY mutant for store/tests/compare.sh, never composed into
note forged. compare.sh appends it to the composed store-reading build and turns "n = xscatrd" into
note "n = xscatsc": the project list then comes from scanning ROOT/projects and joining every
note project's catalog.row (what interplane-native's ipl join_catalog does) instead of from
note ROOT/catalog.tsv. Control C2 (a project in the folder that the catalog does not list) must catch it.
text tmtrow "/catalog.row"
global mtdb uchar 65536
fn xscatsc to long
put fxol 0 0
put fxotr 0 0
xspdir
note O_RDONLY | O_DIRECTORY (040000 on arm64) | O_CLOEXEC
fd = fopen fpth 0 get fpthl 0 540672 0
if lt fd 0
ret -1
end
for it ulong 100000
n = getdnts int fd mtdb 0 len mtdb
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 65536
rl = or ulong get mtdb add p 16 shl ulong get mtdb add p 17 8
mtone add p 19
p = add p rl
end
end
x = fclose int fd
ret long get fxol 0
end
fn mtone a ulong to void
if eq get mtdb a 46
ret
end
xspfold
for k ulong 255
c = get mtdb add a k
if eq c 0
break
end
fpc c
end
fpt tmtrow
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret
end
n = get fxol 0
r = read int fd fxo n sub len fxo n
if gt r 0
put fxol 0 add n ulong r
end
x = fclose int fd
end

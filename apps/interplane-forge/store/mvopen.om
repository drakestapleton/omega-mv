note store/mvopen.om: the store build's seam for open/ (defines the names of server/noopen.om).
note /open, /open/ and everything under it, /open.json, /bring.sh, /get.sh and /withdraw.sh answer
note the 503 of store/moving.om; the forge row has no Open builds entry.
text tmvop "/open"
text tmvopj "/open.json"
text tmvbr "/bring.sh"
text tmvgt "/get.sh"
text tmvwd "/withdraw.sh"
fn ohroute to long
if or fpeq tmvopj or fpeq tmvbr or fpeq tmvgt fpeq tmvwd
ret mvans
end
if mvunder tmvop
ret mvans
end
ret 0
end
fn ohnav to void
ret
end
global gobody ulong 3
fn ohbody to bool
ret false
end
fn ohbodyend to void
ret
end

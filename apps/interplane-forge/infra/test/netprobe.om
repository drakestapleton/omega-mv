om2
note netprobe (test-only, sandbox gate). Runs inside the sandbox in place of forged.
note netprobe TARGET ...   TARGET is A.B.C.D:PORT (TCP) or @NAME (abstract unix stream socket).
note For each target it tries one connect (nonblocking, at most 2 s) and prints
note "TARGET connected" or "TARGET refused errno E". It sends nothing. Then it prints the
note interface names from /proc/net/dev. Exit 0: no target connected. 1: at least one did.
note 2: usage error.
note Linux ARM64: SOCK_STREAM|SOCK_NONBLOCK|SOCK_CLOEXEC = 526337; EINPROGRESS 115, EISCONN 106;
note POLLOUT 4. A second connect after the socket turns writable gives 0 or EISCONN when the
note connection was made, otherwise the error of the attempt.
global arg uchar 256
global sa uchar 128
global num uchar 32
global dev uchar 8192
text tok " connected\n"
text tno " refused errno "
text tbad " unparsable\n"
text tnl "\n"
text tdev "/proc/net/dev"
text tif "interface "
fn putdec v ulong to void
x = v
i = ulong 32
while gt i 0 bound 32
i = sub i 1
put num i add uchar rem x 10 48
x = div x 10
if eq x 0
break
end
end
k = write 1 num i sub 32 i
end
fn tcpaddr n ulong to ulong
note arg[0..n) as A.B.C.D:PORT into sa (sockaddr_in, 16 bytes); returns 16, or 0 if malformed.
for i ulong 16
put sa i 0
end
put sa 0 2
pt = ulong 0
v = ulong 0
d = ulong 0
for i ulong n bound 256
c = get arg i
if and ge c 48 le c 57
v = add mul v 10 ulong sub c 48
d = add d 1
if or gt v 65535 gt d 5
ret 0
end
else
if or eq d 0 gt v 255
ret 0
end
if eq c 46
if ge pt 3
ret 0
end
put sa add 4 pt uchar v
else
if or ne c 58 ne pt 3
ret 0
end
put sa 7 uchar v
end
pt = add pt 1
v = ulong 0
d = ulong 0
end
end
if or ne pt 4 eq d 0
ret 0
end
put sa 2 uchar shr v 8
put sa 3 uchar and v 255
ret 16
end
fn unixaddr n ulong to ulong
note arg[0..n) as @NAME into sa (sockaddr_un, abstract: family 1, a zero byte, NAME).
if or lt n 2 gt n 100
ret 0
end
put sa 0 1
put sa 1 0
put sa 2 0
for i ulong sub n 1 bound 100
put sa add i 3 get arg add i 1
end
ret add n 2
end
fn try fam int al ulong to long
fd = socknew fam 526337 0
if lt fd 0
ret fd
end
r = connect int fd sa 0 al
if eq r -115
w = waitio int fd 4 2000000000
r = connect int fd sa 0 al
if eq r -106
r = long 0
end
if eq w 0
r = long -110
end
end
c = fclose int fd
ret r
end
fn prname s ulong e ulong to void
note Print "interface NAME" for dev[s..e), leading spaces skipped.
if ge s e
ret
end
p = s
while lt p e bound 8192
if ne get dev p 32
break
end
p = add p 1
end
k = write 1 tif 0 len tif
k = write 1 dev p sub e p
k = write 1 tnl 0 len tnl
end
fn devs to void
note Print the interface names: the text before ':' on each line after the two header lines.
fd = fopen tdev 0 len tdev 524288 0
if lt fd 0
ret
end
n = read int fd dev 0 len dev
c = fclose int fd
if le n 0
ret
end
line = ulong 0
s = ulong 0
for i ulong ulong n bound 8192
b = get dev i
if eq b 10
line = add line 1
s = add i 1
end
if and eq b 58 ge line 2
prname s i
s = ulong n
end
end
end
fn main to int
if lt argcnt 2
ret 2
end
hit = int 0
for t ulong ulong sub argcnt 1 bound 64
n = argread add t 1 arg 0 len arg
if le n 0
ret 2
end
fam = int 2
al = ulong 0
if eq get arg 0 64
fam = int 1
al = unixaddr ulong n
else
al = tcpaddr ulong n
end
k = write 1 arg 0 ulong n
if eq al 0
k = write 1 tbad 0 len tbad
ret 2
end
r = try fam al
if eq r 0
k = write 1 tok 0 len tok
hit = int 1
else
k = write 1 tno 0 len tno
putdec ulong neg r
k = write 1 tnl 0 len tnl
end
end
devs
ret hit
end

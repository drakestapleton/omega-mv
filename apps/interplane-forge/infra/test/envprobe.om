om2
note envprobe (test-only, sandbox gate). Runs inside the sandbox in place of forged.
note For /proc/self and for every process visible in /proc it reads environ (at most
note 1048576 bytes) and says whether the canary given as argv[1] occurs in it.
note Exit 0: absent everywhere. 1: present somewhere. 2: usage error or /proc not listable.
note Linux ARM64: O_RDONLY|O_CLOEXEC 524288; O_DIRECTORY|O_CLOEXEC 540672 (asm/fcntl.h).
note getdents64 records: d_reclen at byte 16 (little-endian u16), name from byte 19, NUL-ended.
global ndl uchar 256
global buf uchar 1048576
global pth uchar 64
global dents uchar 65536
global num uchar 32
global tally ulong 2
text tproc "/proc"
text tself "/proc/self/environ"
text tpre "/proc/"
text tenv "/environ"
text tlead "environ "
text tbytes " bytes "
text tyes " canary PRESENT\n"
text tno " canary absent\n"
text tnord " unreadable\n"
text tseen "processes seen "
text tnl "\n"
fn putdec v ulong to void
x = v
i = ulong 32
while gt i 0 bound 32
i = sub i 1
put num i add uchar rem x 10 48
x = div x 10
if eq x 0
break
end
end
k = write 1 num i sub 32 i
end
fn found n ulong m ulong to bool
if or eq m 0 lt n m
ret false
end
for i ulong add sub n m 1 bound 1048577
j = ulong 0
while lt j m bound 257
if ne get buf add i j get ndl j
break
end
j = add j 1
end
if eq j m
ret true
end
end
ret false
end
fn probe pl ulong m ulong to int
k = write 1 tlead 0 len tlead
k = write 1 pth 0 pl
fd = fopen pth 0 pl 524288 0
if lt fd 0
k = write 1 tnord 0 len tnord
ret 0
end
n = ulong 0
while lt n len buf bound 1048577
r = read int fd buf n sub len buf n
if le r 0
break
end
n = add n ulong r
end
c = fclose int fd
k = write 1 tbytes 0 len tbytes
putdec n
if found n m
k = write 1 tyes 0 len tyes
ret 1
end
k = write 1 tno 0 len tno
ret 0
end
fn digits o ulong to ulong
note Length of an all-digit name at dents[o+19..], or 0 when it is not a process id.
n = ulong 0
while lt add add o 19 n len dents bound 64
c = get dents add add o 19 n
if eq c 0
ret n
end
if or lt c 48 gt c 57
ret 0
end
n = add n 1
end
ret 0
end
fn mkpath o ulong n ulong to ulong
for i ulong len tpre
put pth i get tpre i
end
p = len tpre
for i ulong n bound 20
put pth add p i get dents add add o 19 i
end
p = add p n
for i ulong len tenv
put pth add p i get tenv i
end
ret add p len tenv
end
fn batch g ulong m ulong to void
note One getdents64 batch of g bytes. Totals go to tally: [0] processes seen, [1] canary hits.
o = ulong 0
while lt o g bound 65536
rl = or ulong get dents add o 16 shl ulong get dents add o 17 8
n = digits o
if and gt n 0 le n 20
pl = mkpath o n
h = probe pl m
put tally 0 add get tally 0 1
put tally 1 add get tally 1 ulong h
end
if eq rl 0
break
end
o = add o rl
end
end
fn walk m ulong to int
pd = fopen tproc 0 len tproc 540672 0
if lt pd 0
ret 2
end
g = getdnts int pd dents 0 len dents
while gt g 0 bound 100000
batch ulong g m
g = getdnts int pd dents 0 len dents
end
c = fclose int pd
k = write 1 tseen 0 len tseen
putdec get tally 0
k = write 1 tnl 0 len tnl
if lt g 0
ret 2
end
if gt get tally 1 0
ret 1
end
ret 0
end
fn main to int
if ne argcnt 2
ret 2
end
m = argread 1 ndl 0 len ndl
if le m 0
ret 2
end
for i ulong len tself
put pth i get tself i
end
hit = probe len tself ulong m
w = walk ulong m
if eq w 2
ret 2
end
ret or hit w
end

om2
note hog (test-only, sandbox gate). Runs inside the sandbox in place of forged.
note hog fork       : fork up to 4096 children that each sleep 5 s; stop at the first refusal.
note                  Prints "forks N error E". Exit 0 when a fork was refused, 1 when all 4096 ran.
note hog file PATH  : write 1 MiB blocks to PATH, up to 4096 blocks (4 GiB). A file-size limit
note                  kills it with SIGXFSZ, or a write fails. Exit 0 on a failed write, 1 when
note                  all 4 GiB were written.
note Linux ARM64: O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC = 1|64|512|524288 = 524865; mode 0600 = 384.
global arg uchar 4096
global blk uchar 1048576
global num uchar 32
global ws uchar 4
text tfork "fork"
text tfile "file"
text tforks "forks "
text terr " error "
text twrote "wrote "
text tnl "\n"
fn putdec v ulong to void
x = v
i = ulong 32
while gt i 0 bound 32
i = sub i 1
put num i add uchar rem x 10 48
x = div x 10
if eq x 0
break
end
end
k = write 1 num i sub 32 i
end
fn same n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get arg i get t i
ret false
end
end
ret true
end
fn forks to int
n = ulong 0
e = long 0
while lt n 4096 bound 4096
p = fork
if eq p 0
s = sleepns 5000000000
exit 0
end
if lt p 0
e = p
break
end
n = add n 1
end
k = write 1 tforks 0 len tforks
putdec n
k = write 1 terr 0 len terr
putdec ulong neg e
k = write 1 tnl 0 len tnl
for i ulong n bound 4096
w = waitpid -1 ws 0 4 0
end
if lt e 0
ret 0
end
ret 1
end
fn files n ulong to int
fd = fopen arg 0 n 524865 384
if lt fd 0
ret 2
end
t = ulong 0
e = long 0
for i ulong 4096
r = write int fd blk 0 len blk
if lt r 0
e = r
break
end
t = add t ulong r
end
c = fclose int fd
k = write 1 twrote 0 len twrote
putdec t
k = write 1 terr 0 len terr
putdec ulong neg e
k = write 1 tnl 0 len tnl
if lt e 0
ret 0
end
ret 1
end
fn main to int
if lt argcnt 2
ret 2
end
m = argread 1 arg 0 len arg
if lt m 0
ret 2
end
if and same ulong m tfork eq argcnt 2
ret forks
end
if and same ulong m tfile eq argcnt 3
p = argread 2 arg 0 len arg
if le p 0
ret 2
end
ret files ulong p
end
ret 2
end

om2
note forged-listen: trusted supervisor helper; runs outside the sandbox, as the owner.
note Usage: forged-listen PORT PROGRAM [ARG ...]
note Makes the TCP listener 127.0.0.1:PORT with forged's own options (seed/net/http.om hlisten:
note AF_INET, SOCK_STREAM|SOCK_NONBLOCK|SOCK_CLOEXEC = 526337, SO_REUSEADDR, backlog 64), moves it
note onto descriptor 0 without close-on-exec (dup3 flags 0), and execs PROGRAM with the ARGs.
note execprog supplies an empty environment and closes every descriptor at or above 3, so the
note program receives exactly stdin = the listener, stdout and stderr. The caller passes any
note environment through PROGRAM = /usr/bin/env. The sandboxed server then serves on the
note inherited listener inside a network namespace of its own with nothing in it.
note Exit 2 usage, 3 listener not made (for example the port is busy), 4 dup3 failed,
note 5 exec failed (the negative errno is lost; strace shows it).
global pk uchar 4096
global ab uchar 4096
fn port to long
note argv[1] as a decimal 1..65535, or -1.
n = argread 1 ab 0 len ab
if or le n 0 gt n 5
ret -1
end
v = long 0
for i ulong ulong n bound 5
c = get ab i
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 long sub c 48
end
if or lt v 1 gt v 65535
ret -1
end
ret v
end
fn pack to long
note argv[2..] as a packed list in pk (u16 LE count, then u16 LE length + bytes); its size or -1.
k = sub argcnt 2
if or lt k 1 gt k 64
ret -1
end
put pk 0 uchar and k 255
put pk 1 0
o = ulong 2
for i ulong ulong k bound 64
n = argread add i 2 ab 0 len ab
if lt n 0
ret -1
end
if gt add add o 2 ulong n len pk
ret -1
end
put pk o uchar and n 255
put pk add o 1 uchar shr n 8
o = add o 2
for j ulong ulong n bound 4096
c = get ab j
if eq c 0
ret -1
end
put pk o c
o = add o 1
end
end
ret long o
end
fn main to int
if lt argcnt 3
ret 2
end
p = port
if lt p 0
ret 2
end
n = pack
if lt n 0
ret 2
end
a = new uchar 16 0
put a 0 2
put a 2 uchar shr p 8
put a 3 uchar and p 255
put a 4 127
put a 7 1
one = new uchar 4 0
put one 0 1
fd = socknew 2 526337 0
if lt fd 0
ret 3
end
r = sockopt int fd 1 2 one 0 4
if eq r 0
r = bind int fd a 0 16
end
if eq r 0
r = listen int fd 64
end
if ne r 0
ret 3
end
d = dupfd int fd 0 0
if ne d 0
ret 4
end
x = execprog pk 0 ulong n
ret 5
end

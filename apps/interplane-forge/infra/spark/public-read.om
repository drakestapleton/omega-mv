om2
note Bounded public-file reader for the trusted supervisor. No writes to source paths.
note Walk an absolute path one component at a time, opening directories NOFOLLOW
note and using fchdir on the held descriptor. A renamed ancestor cannot redirect us.
note Linux ARM64 flags from asm/fcntl.h; stat mode from asm-generic/stat.h.
note stdout is empty on refusal. Exit 2 path, 3 open/type, 4 size/read, 5 output.
note Cap is 1048576 bytes. One extra byte detects growth beyond the cap.
global path uchar 4096
global meta uchar 128
global body uchar 1048577
text root "/"
fn descend a ulong n ulong to bool
fd = fopen path a n or or int 16384 32768 524288 0
if lt fd 0
ret false
end
r = fchdir int fd
c = fclose int fd
ret and eq r 0 eq c 0
end
fn parent n ulong to long
if ne get path 0 47
ret -1
end
r = chdir root 0 1
if ne r 0
ret -1
end
a = ulong 1
for i ulong n bound 4096
if lt i a
continue
end
if eq get path i 0
ret -1
end
if eq get path i 47
if eq i a
ret -1
end
if eq get path a 46
if eq sub i a 1
ret -1
end
if and eq sub i a 2 eq get path add a 1 46
ret -1
end
end
if not descend a sub i a
ret -1
end
a = add i 1
end
end
if ge a n
ret -1
end
ret long a
end
fn capture fd int to long
if ne fstat fd meta 0 128 0
ret -1
end
mode = or uint get meta 16 shl uint get meta 17 8
if ne and mode 61440 32768
ret -1
end
n = ulong 0
while lt n len body bound 1048577
r = read fd body n sub len body n
if lt r 0
if eq r -4
continue
end
ret -1
end
if eq r 0
ret long n
end
n = add n ulong r
end
ret -1
end
fn output n ulong to int
p = ulong 0
while lt p n bound 1048577
r = write 1 body p sub n p
if le r 0
if eq r -4
continue
end
ret 5
end
p = add p ulong r
end
ret 0
end
fn main to int
if ne argcnt 2
ret 2
end
sz = argread 1 path 0 len path
if or le sz 1 ge sz long len path
ret 2
end
a = parent ulong sz
if lt a 0
ret 2
end
fd = fopen path ulong a sub ulong sz ulong a 559104 0
if lt fd 0
ret 3
end
n = capture int fd
r = fclose int fd
if or lt n 0 ne r 0
ret 4
end
ret output ulong n
end

note forged server/agents.om (ForgeServer, prefix fqa / tfqa): <base>agents.json, schema interplane/agents/1
note (docs/API.md, docs/AGENT-DOOR.md): the one document an agent reads first. Its routes come from
note server/agents.tsv, which run.sh compiles into .build/agents.om (the text tfqatsv, composed just
note above this unit) at every build, so the list cannot drift from the table; server/tests/agentdoor.sh
note fetches every row and checks the schema it answers. Rows whose first field is "none" are the
note not_available list. The event rows move to not_available in a build without the event store
note (server/nodoor.om: evon is false, those pages answer 501).
text tfqapj "/agents.json"
text tfqa1 "{\"schema\":\"interplane/agents/1\",\"base\":\""
text tfqa2 "\",\n\"read_first\":\""
text tfqa3 "agents.json\",\n\"how_to_ask\":{\"suffix\":\"the path itself is the JSON name\",\"accept\":\"send Accept: application/json (and not text/html); the HTML page names the same address in <link rel=alternate type=application/json>\",\"always\":\"JSON whatever the headers say\"},\n\"text_form\":\"add format=text to the query of any HTML page for its plain-text form (text/plain; charset=utf-8)\",\n\"error_schema\":\"forge/error/1\",\n\"events\":"
text tfqae1 "{\"path\":\""
text tfqae2 "events.json\",\"schema\":\"interplane/events/1\",\"after\":\"after=<seq> answers the events with a higher seq, oldest first; next is the address to read next\",\"limit_default\":50,\"limit_max\":200,\"etag\":\"send If-None-Match with the ETag of the last answer: an unchanged stream answers 304\",\"feed\":\""
text tfqae3 "feed\"}"
text tfqar ",\n\"routes\":["
text tfqan "\n],\n\"not_available\":["
text tfqaz "\n]}\n"
text tfqanone "none"
text tfqameth "method"
text tfqadash "-"
text tfqaevs "interplane/events/1"
text tfqano "this build has no event store (server/nodoor.om): the address answers 501"
text tfqk1 "\n{\"method\":"
text tfqk2 ",\"path\":"
text tfqk3 ",\"json\":"
text tfqk4 ",\"schema\":"
text tfqk5 ",\"auth\":"
text tfqk6 ",\"doc\":"
text tfqk7 ",\"purpose\":"
text tfqw1 "\n{\"what\":"
text tfqw2 ",\"why\":"
global fqan ulong 1
global fqatb ulong 8
note fqajsn: a request for a .json name asks for JSON, so its errors are forge/error/1 documents too
note (ferrpage answers JSON when fjwant is true)
fn fqajsn to void
for i ulong len tfjaj bound 64
put facc i get tfjaj i
end
put faccl 0 len tfjaj
end
fn fqaroute to long
if not fpeq tfqapj
ret 0
end
fqajsn
if not fget
ret 405
end
fjstart
fput tfqa1
fputb
fput tfqa2
fputb
fput tfqa3
if evon
fput tfqae1
fputb
fput tfqae2
fputb
fput tfqae3
else
fynull
end
fput tfqar
fqarows 1
fput tfqan
fqarows 2
fput tfqaz
ret 200
end
note fqarows mode: walk the lines of tfqatsv; mode 1 the routes, mode 2 the not_available list
fn fqarows mode ulong to void
put fqan 0 0
n = len tfqatsv
p = ulong 0
for it ulong 4096
if ge p n
break
end
q = p
for k ulong 65536
if ge q n
break
end
if eq get tfqatsv q 10
break
end
q = add q 1
end
fqaline p q mode
p = add q 1
end
end
note fqaline p q mode: one row tfqatsv[p, q) with 7 tab-separated fields (the header row is skipped)
fn fqaline p ulong q ulong mode ulong to void
k = ulong 0
for i ulong sub q p bound 65536
if eq get tfqatsv add p i 9
if lt k 8
put fqatb k add p i
end
k = add k 1
end
end
if ne k 6
ret
end
if fqaeq p get fqatb 0 tfqameth
ret
end
none = fqaeq p get fqatb 0 tfqanone
ev = fqaeq fqafa 3 get fqatb 3 tfqaevs
off = and ev not evon
if eq mode 1
if or none off
ret
end
fqasep
fput tfqk1
fqastr p get fqatb 0 false
fput tfqk2
fqastr fqafa 1 get fqatb 1 true
fqarow2 q
ret
end
if none
fqasep
fput tfqw1
fqastr fqafa 1 get fqatb 1 false
fput tfqw2
fqastr fqafa 6 q false
fputc 125
ret
end
if off
fqasep
fput tfqw1
fqastr fqafa 1 get fqatb 1 true
fput tfqw2
fjtxt tfqano
fputc 125
end
end
fn fqarow2 q ulong to void
fput tfqk3
fqastr fqafa 2 get fqatb 2 false
fput tfqk4
if fqaeq fqafa 3 get fqatb 3 tfqadash
fynull
else
fqastr fqafa 3 get fqatb 3 false
end
fput tfqk5
fqastr fqafa 4 get fqatb 4 false
fput tfqk6
fqastr fqafa 5 get fqatb 5 false
fput tfqk7
fqastr fqafa 6 q false
fputc 125
end
note fqafa f: the start of field f (f >= 1): just after tab f-1
fn fqafa f ulong to ulong
ret add get fqatb sub f 1 1
end
fn fqasep to void
if gt get fqan 0 0
fputc 44
end
put fqan 0 add get fqan 0 1
end
fn fqaeq a ulong e ulong t view uchar * to bool
if ne sub e a len t
ret false
end
for i ulong len t bound 64
if ne get tfqatsv add a i get t i
ret false
end
end
ret true
end
note fqastr a e base: tfqatsv[a, e) as a JSON string, after the base when base is true
fn fqastr a ulong e ulong base bool to void
fjtb
if base
for i ulong get fbasel 0 bound 64
fjtc get fbase i
end
end
for i ulong sub e a bound 65536
fjtc get tfqatsv add a i
end
fjstr
end

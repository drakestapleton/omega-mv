note forged server/jsonp.om: shared pieces of the machine form of every repo and user page (ForgeServer,
note prefix fy / tfy; docs/API.md). A slice answers JSON when fjwant is true (Accept names
note application/json and not text/html) at the same URL as its HTML page, and sets fjalt 3 on the HTML
note page so the layout names that URL as its JSON alternate. Errors of a JSON request (any 4xx/5xx a
note handler leaves with an empty fob, including the server's 404 for a repo not in the public table)
note are a forge/error/1 document (ferrpage calls fyerr).
text tfyuser "forge/user/1"
text tfyerr1 "{\"schema\":\"forge/error/1\",\"status\":"
text tfyerr2 ",\"error\":"
text tfyerr3 ",\"message\":"
text tfyend "}\n"
text tfyh1 "{\"schema\":\""
text tfyh2 "\",\"base\":\""
text tfyh3 "\",\"repo\":{\"owner\":\""
text tfyh4 "\",\"name\":\""
text tfyh5 "\",\"rid\":\""
text tfyh6 "\",\"path\":\""
text tfyh7 "\",\"json\":\""
text tfyh8 ".json\"}"
text tfyu1 "{\"schema\":\""
text tfyu2 "\",\"base\":\""
text tfyu3 "\",\"user\":"
note fyerr: the JSON error document for status st; the HTML title and message of the error page
fn fyerr st ulong to void
put fjalt 0 0
ferrti st
fjstart
fput tfyerr1
fnum st
fput tfyerr2
fjtb
for i ulong get ftil 0 bound 256
fjtc get fti i
end
fjstr
fput tfyerr3
a = get fobl 0
ferrmsg st
b = get fobl 0
fjtb
for k ulong sub b a bound 65536
fjtc get fob add a k
end
put fobl 0 a
fjstr
fput tfyend
end
note fyrhead t: open a repo page document: {"schema":"<t>","base":"<base>","repo":{owner, name, rid,
note path, json}; the caller adds ,"key":value pairs (fyk) and closes it with fyend
fn fyrhead t view uchar * to void
i = get fridx 0
fjstart
fput tfyh1
fput t
fput tfyh2
fputb
fput tfyh3
fput tfowner
fput tfyh4
for k ulong get fanl i bound 128
fputc frnbyte i k
end
fput tfyh5
fputid i
fput tfyh6
fjpath i
fput tfyh7
fjpath i
fput tfyh8
end
note fyuhead t: open a user page document: {"schema":"<t>","base":"<base>","user":"<fown>"
fn fyuhead t view uchar * to void
fjstart
fput tfyu1
fput t
fput tfyu2
fputb
fput tfyu3
fjtb
for k ulong get fownl 0 bound 64
fjtc get fown k
end
fjstr
end
note fyk t: ,"<t>": (t is a plain ASCII key)
fn fyk t view uchar * to void
fputc 44
fputc 34
fput t
fputc 34
fputc 58
end
note fyk0 t: "<t>": without the comma (first key of an object)
fn fyk0 t view uchar * to void
fputc 34
fput t
fputc 34
fputc 58
end
fn fyend to void
fput tfyend
end
fn fybool b bool to void
if b
fput tfjtrue
ret
end
fput tfjfals
end
fn fynull to void
fput tfjnull
end
note fysx a n: fxo[a, a+n) as a JSON string (fjfx, named here for the slices)
fn fysx a ulong n ulong to void
fjfx a n
end
note fysv s: the bytes of s as a JSON string
fn fysv s view uchar * to void
fjtb
for k ulong len s bound 65536
fjtc get s k
end
fjstr
end
note fyself: this page's own URL as a JSON string: "<base><path without its first />[?<query>]"
fn fyself to void
fjtb
for k ulong get fbasel 0 bound 64
fjtc get fbase k
end
n = get fpathl 0
for k ulong sub n 1 bound 4096
fjtc get fpath add k 1
end
if gt get fqsl 0 0
fjtc 63
for k ulong get fqsl 0 bound 4096
fjtc get fqs k
end
end
fjstr
end
note fyalt: the HTML page names its own URL as the JSON alternate (fhalt in pages.om)
fn fyalt to void
put fjalt 0 3
end
note fypct a n: fxo[a, a+n) percent-encoded for a URL path; unreserved bytes and / are kept (the
note bytes written are URL- and JSON-safe)
fn fypct a ulong n ulong to void
m = hmin n 4096
for k ulong m bound 4096
fypcc get fxo add a k
end
end
note fypcc c: one byte of a URL path: unreserved and / as is, else %XX
fn fypcc c uchar to void
if fypok c
fputc c
ret
end
fputc 37
fputc fjhexu shr ulong c 4
fputc fjhexu and ulong c 15
end
fn fypok c uchar to bool
if or fisaln c eq c 47
ret true
end
if or eq c 46 eq c 45
ret true
end
ret or eq c 95 eq c 126
end
note ---- /search?q= (forge/search/1): the repositories whose name or description holds q, then the
note code matches of q on each default branch (git grep, at most 5 per repo and 100 in all), as fsearch
text tfysr1 "{\"schema\":\"forge/search/1\",\"base\":\""
text tfysr2 "\",\"query\":"
text tfysr3 ",\n\"repos\":["
text tfysr4 "],\n\"code\":["
text tfysr5 "],\n\"code_truncated\":"
text tfysc1 "{\"repo\":"
text tfysc2 ",\"rid\":\""
text tfysc3 "\",\"path\":"
text tfysc4 ",\"line\":"
text tfysc5 ",\"text\":"
text tfysc6 ",\"html\":\""
text tfysc7 "/blob/"
text tfysc8 "#L"
text tfysc9 "\"}"
fn fyjsrch to void
fjstart
fput tfysr1
fputb
fput tfysr2
q = get fql 0
if eq q 0
fynull
else
fjtb
for k ulong q bound 256
fjtc get fq k
end
fjstr
end
fput tfysr3
n = ulong 0
if gt q 0
for i ulong get fan 0 bound FAMAX
if fsrmatch i
if gt n 0
fput tfjsep
end
fputc 123
fjcore i
fputc 125
n = add n 1
end
end
end
fput tfysr4
put fhits 0 0
if gt q 0
for i ulong get fan 0 bound FAMAX
if lt get fhits 0 100
fyjcsr i
end
end
end
fput tfysr5
fybool ge get fhits 0 100
fyend
end
note fyjcsr: the code matches of repo i (the lines fcsrepo shows)
fn fyjcsr i ulong to void
fgreparg i
st = fexec 10000000000
if ne st 0
ret
end
ln = get fxol 0
p = ulong 0
for it ulong 100000
if ge p ln
break
end
if ge get fhits 0 100
break
end
e = fleol p ln
fyjchit i p e
p = add e 1
end
end
note fyjchit: one line "refs/heads/<b>:<path>:<line>:<text>" as fcshit reads it; text cut at 300 bytes
fn fyjchit i ulong p ulong e ulong to void
a = add add p 12 get fabl i
if ge a e
ret
end
c1 = fcolon a e
if ge c1 e
ret
end
c2 = fcolon add c1 1 e
if ge c2 e
ret
end
if gt get fhits 0 0
fputc 44
end
put fhits 0 add get fhits 0 1
fput tfysc1
fjtname i
fjstr
fput tfysc2
fputid i
fput tfysc3
fjfx a sub c1 a
fput tfysc4
fjsize add c1 1 c2
fput tfysc5
m = hmin sub sub e c2 1 300
fjfx add c2 1 m
fput tfysc6
fjpath i
fput tfysc7
fyjbr i
fputc 47
fypct a sub c1 a
fput tfysc8
fxput add c1 1 sub sub c2 c1 1
fput tfysc9
end
note fyjbr: the default branch of repo i, percent-encoded like a path
fn fyjbr i ulong to void
o = get fabo i
for k ulong get fabl i bound 64
fypcc get fabr add o k
end
end
note ---- /<owner> (forge/user/1) for the forge owner: the page fprofile renders (its follow counts, star
note and favorite sums, repositories and starred repositories); every other profile view is social's
text tfypr1 ",\"did\":\"did:key:"
text tfypr2 "\",\"followers\":"
text tfypr3 ",\"following\":"
text tfypr4 ",\"tab\":\"stars\",\n\"repos\":["
text tfypr5 "],\n\"stars_received\":"
text tfypr6 ",\"favorites_received\":"
text tfypr7 ",\n\"starred\":"
text tfypr8 ",\n\"users\":null}\n"
fn fyjprof to void
fyuhead tfyuser
fput tfypr1
fput tfnid
fput tfypr2
fnum sofolln
fput tfypr3
fnum sofollg
fput tfypr4
for i ulong get fan 0 bound FAMAX
if gt i 0
fput tfjsep
end
fputc 123
fjcore i
fputc 125
end
fput tfypr5
fnum fstarsum
fput tfypr6
fnum ffavsum
fput tfypr7
sojstars
fput tfypr8
end

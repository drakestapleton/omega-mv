note forged server/util.om: the shared request / response globals and helpers of docs/CONTRACT.md.
note Every name here starts with f (functions, globals) or tf (texts). Composed after http.om.
note ---- request (set by server/main.om before dispatch)
global fmeth ulong 1
global fpath uchar 4096
global fpathl ulong 1
global fqs uchar 4096
global fqsl ulong 1
global fbody uchar 65536
global fbodyl ulong 1
note fbig: the body of a POST whose path ends in /patches/new (git patch intake, docs/API.md), at most
note 3 MiB (3145728 bytes: a 2 MiB mbox as base64url is 2796203 bytes, a 60000-byte description
note percent-encoded at most 180000, the rest under 20000). server/main.om freqbig fills it and leaves
note fbody empty; every other POST keeps the 64 KiB fbody and has fbigl 0.
global fbig uchar 3145728
global fbigl ulong 1
global fck uchar 4096
global fckl ulong 1
global fip uchar 64
global fipl ulong 1
global fbase uchar 64
global fbasel ulong 1
global fridx ulong 1
global frid uchar 64
global fridl ulong 1
global fown uchar 64
global fownl ulong 1
global frepo uchar 128
global frepol ulong 1
global frest uchar 4096
global frestl ulong 1
global fuser uchar 64
global fuserl ulong 1
global fcsrf uchar 64
global fcsrfl ulong 1
global finm uchar 256
global finml ulong 1
global forig uchar 256
global forigl ulong 1
global fag uchar 256
global fagl ulong 1
global frf uchar 256
global frfl ulong 1
note ---- response
global fob uchar 8388608
global fobl ulong 1
global fobtr ulong 1
global ftxmore ulong 1
global fkind ulong 1
global fct uchar 128
global fctl ulong 1
global fcd uchar 512
global fcdl ulong 1
global fsck uchar 512
global fsckl ulong 1
global floc uchar 4096
global flocl ulong 1
global fti uchar 256
global ftil ulong 1
global ffile uchar 4096
global ffilel ulong 1
global fetag uchar 128
global fetagl ulong 1
global fcc uchar 128
global fccl ulong 1
global fval uchar 4096
note ---- allow-list (server/repos.om fills it). FAMAX rows: every table below indexed by the row has
note FAMAX entries, and every loop over the rows is bound FAMAX. The pools hold FAMAX rows at the
note longest each row may be (name 100 + slack, id 64, branch 60, description and last commit as
note before, times four). Sized 2026-11-14 from 64 to 256 for the native store (105 public projects
note in it); store/tests/capacity.sh fails loudly when a store or RIDS.md table passes 192 rows.
const FAMAX ulong 256
global fan ulong 1
global fanm uchar 32768
global fano ulong 256
global fanl ulong 256
global faid uchar 16384
global faio ulong 256
global fail ulong 256
global fabr uchar 16384
global fabo ulong 256
global fabl ulong 256
global fadesc uchar 262144
global fado ulong 256
global fadl ulong 256
global falc uchar 262144
global falco ulong 256
global falcl ulong 256
global famt ulong 1
note ---- exec
global fpk uchar 8192
global fpkl ulong 1
global fpkr ulong 1
global fxo uchar 16777216
global fxol ulong 1
global fxotr ulong 1
note streaming exec (fsopen / fsnext / fsclose): 0 read fd, 1 pid, 2 deadline, 3 state (0 open,
note 1 end of output, 2 failed); fsp the first unread byte of fxo, fsq the first byte not yet scanned
note for the separator, fsrs the start of the record fsnext returned last
global fsst long 4
global fsp ulong 1
global fsq ulong 1
global fsrs ulong 1
global fpfd uchar 8
global fwst uchar 4
global fjunk uchar 4096
global fpth uchar 4096
global fpthl ulong 1
global fstb uchar 128
note ---- write rate limit: 256 slots keyed by the 64-bit FNV-1a hash of the client IP, 30 writes per
note 60 s window; an unknown IP takes a free slot, else the slot whose window started first
global frlk ulong 256
global frlt ulong 256
global frlc ulong 256
note ---- per-response hooks (cleared per request by fresetr in main.om)
note fretry: nonzero = send "Retry-After: <fretry>" (seconds) with the response (dl 503)
global fretry ulong 1
note fcspsb: nonzero = send the sandbox CSP instead of the page CSP (browse /raw/), see fsetsbx
global fcspsb ulong 1
note fepnoc: skip shared edge caching for a mutable page.
global fepnoc ulong 1
note fmvng: 1 = this 503 is the "moving" answer of a part that is moving to the new Interplane store
note (store/moving.om, store build only): ferrti, ferrmsg and fyerr then give its title, its text and
note "reason":"moving"; every other 503 (door fail-closed, dl Retry-After) keeps its own words
global fmvng ulong 1
note fsrcst: 1 when the repositories are a native Interplane store (store/repos.om sets it when it
note loads; the default build never does): fkgit / fkgiti then name <fsrt>projects/<name>/repo.git,
note fsrt being the store root with its final "/". 0: <tfstore><RID>, Radicle storage.
global fsrcst ulong 1
global fsrt uchar 4096
global fsrtl ulong 1
text tfsprj "projects/"
text tfsrg "/repo.git"
text tfstore "/home/drakestapleton/.radicle/storage/"
text tfgit "/usr/bin/git"
text tfdata "/home/drakestapleton/forge-data/"
text tfowner "drakestapleton"
text tfnid "z6MkfZDue1TbaNFi3ZzcD9uiTeduPLC52ucdFVuLKZwexxhK"
text tfdevnul "/dev/null"
text tfgitdir "--git-dir="
text tfamp "&amp;"
text tflt "&lt;"
text tfgt "&gt;"
text tfquot "&quot;"
text tfapos "&#39;"
note ---- body builder fob
note fputc: a byte that does not fit fob is dropped and fobtr is set. fsend (server/main.om) reads
note fobtr before any header goes out and then sends a whole 500 instead of the cut body.
fn fputc c uchar to void
n = get fobl 0
if lt n len fob
put fob n c
put fobl 0 add n 1
ret
end
put fobtr 0 1
end
fn fput s view uchar * to void
for i ulong len s bound 16777216
fputc get s i
end
end
fn fescc c uchar to void
if eq c 38
fput tfamp
ret
end
if eq c 60
fput tflt
ret
end
if eq c 62
fput tfgt
ret
end
if eq c 34
fput tfquot
ret
end
if eq c 39
fput tfapos
ret
end
fputc c
end
fn fesc s view uchar * to void
for i ulong len s bound 16777216
fescc get s i
end
end
fn fnum v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
fputc get d add i k
end
end
fn fputb to void
for i ulong get fbasel 0 bound 64
fputc get fbase i
end
end
fn flink p view uchar * to void
fputb
fput p
end
fn fputown to void
for i ulong get fownl 0 bound 64
fescc get fown i
end
end
fn fputrnm to void
for i ulong get frepol 0 bound 128
fescc get frepo i
end
end
fn fputrepo to void
fputown
fputc 47
fputrnm
end
note fputrl: base + owner/repo, for links into the current repo
fn fputrl to void
fputb
fputrepo
end
note ---- allow-list accessors
fn frnlen i ulong to ulong
ret get fanl i
end
fn fridlen i ulong to ulong
ret get fail i
end
fn frnbyte i ulong k ulong to uchar
ret get fanm add get fano i k
end
fn fridbyte i ulong k ulong to uchar
ret get faid add get faio i k
end
fn fputrn i ulong to void
for k ulong get fanl i bound 256
fescc frnbyte i k
end
end
fn fputrid i ulong to void
for k ulong get fail i bound 64
fputc fridbyte i k
end
end
fn fputbr i ulong to void
o = get fabo i
for k ulong get fabl i bound 64
fescc get fabr add o k
end
end
fn fdesc i ulong to void
o = get fado i
for k ulong get fadl i bound 4096
fescc get fadesc add o k
end
end
note fputlc: last commit of repo i, "YYYY-MM-DD shortsha subject", escaped, at most 200 bytes (falc keeps
note up to 1000 for the JSON subject)
fn fputlc i ulong to void
o = get falco i
for k ulong hmin get falcl i 200 bound 1024
fescc get falc add o k
end
end
fn fnmeq i ulong to bool
l = get fanl i
if ne l get frepol 0
ret false
end
o = get fano i
for k ulong l bound 256
if ne get fanm add o k get frepo k
ret false
end
end
ret true
end
fn frepoix to ulong
for i ulong get fan 0 bound FAMAX
if fnmeq i
ret i
end
end
ret 9999
end
note ---- query and form fields: s 0 = fqs, 1 = fbody
fn fsrcb s ulong k ulong to uchar
if eq s 0
ret get fqs k
end
ret get fbody k
end
fn fsrcl s ulong to ulong
if eq s 0
ret get fqsl 0
end
ret get fbodyl 0
end
fn fhexv c uchar to long
if and ge c 48 le c 57
ret long sub c 48
end
if and ge c 97 le c 102
ret long sub c 87
end
if and ge c 65 le c 70
ret long sub c 55
end
ret -1
end
note fpmat: field name n starts at i and is followed by '='
fn fpmat s ulong i ulong ln ulong n view uchar * to bool
e = add i len n
if ge e ln
ret false
end
for k ulong len n bound 4096
if ne fsrcb s add i k get n k
ret false
end
end
ret eq fsrcb s e 61
end
fn fpnext s ulong i ulong ln ulong to ulong
j = i
while lt j ln bound 70000
if eq fsrcb s j 38
ret add j 1
end
j = add j 1
end
ret ln
end
note fpdec: percent-decode from a to the next '&' into fval; returns the length (cap 4096)
fn fpdec s ulong a ulong ln ulong to long
j = a
o = ulong 0
while lt j ln bound 70000
c = fsrcb s j
if eq c 38
break
end
if ge o 4096
break
end
j = add j 1
if eq c 43
c = uchar 32
end
if eq c 37
c = fpct s j ln
if lt add j 1 ln
j = add j 2
end
end
put fval o c
o = add o 1
end
ret long o
end
fn fpct s ulong j ulong ln ulong to uchar
if ge add j 1 ln
ret uchar 37
end
a = fhexv fsrcb s j
b = fhexv fsrcb s add j 1
if or lt a 0 lt b 0
ret uchar 37
end
ret uchar add mul a 16 b
end
fn fparam s ulong n view uchar * to long
ln = fsrcl s
i = ulong 0
while lt i ln bound 70000
if fpmat s i ln n
ret fpdec s add add i len n 1 ln
end
i = fpnext s i ln
end
ret -1
end
fn fqget n view uchar * to long
ret fparam 0 n
end
fn fbget n view uchar * to long
ret fparam 1 n
end
note ---- response setters
fn flocb to void
put flocl 0 0
for i ulong get fbasel 0 bound 64
flocc get fbase i
end
end
fn flocc c uchar to void
n = get flocl 0
if lt n len floc
put floc n c
put flocl 0 add n 1
ret
end
note a Location over 4096 bytes is not sent cut either: the same flag, the same 500
put fobtr 0 1
end
fn floct t view uchar * to void
for i ulong len t bound 4096
flocc get t i
end
end
note flocrepo: Location = base + owner/repo
fn flocrepo to void
flocb
for i ulong get fownl 0 bound 64
flocc get fown i
end
flocc 47
for i ulong get frepol 0 bound 128
flocc get frepo i
end
end
fn fctc c uchar to void
n = get fctl 0
if lt n len fct
put fct n c
put fctl 0 add n 1
end
end
fn fsetct t view uchar * to void
put fctl 0 0
for i ulong len t bound 128
fctc get t i
end
end
fn fcdc c uchar to void
n = get fcdl 0
if lt n len fcd
put fcd n c
put fcdl 0 add n 1
end
end
fn fsetcd t view uchar * to void
put fcdl 0 0
for i ulong len t bound 512
fcdc get t i
end
end
fn ftic c uchar to void
n = get ftil 0
if lt n len fti
put fti n c
put ftil 0 add n 1
end
end
fn fsetti t view uchar * to void
put ftil 0 0
for i ulong len t bound 256
ftic get t i
end
end
note ftirepo: append owner/repo to the title
fn ftirepo to void
for i ulong get fownl 0 bound 64
ftic get fown i
end
ftic 47
for i ulong get frepol 0 bound 128
ftic get frepo i
end
end
fn fscc c uchar to void
n = get fsckl 0
if lt n len fsck
put fsck n c
put fsckl 0 add n 1
end
end
fn fsetsck t view uchar * to void
put fsckl 0 0
for i ulong len t bound 512
fscc get t i
end
end
fn fetc c uchar to void
n = get fetagl 0
if lt n len fetag
put fetag n c
put fetagl 0 add n 1
end
end
fn fccc c uchar to void
n = get fccl 0
if lt n len fcc
put fcc n c
put fccl 0 add n 1
end
end
fn fsetcc t view uchar * to void
put fccl 0 0
for i ulong len t bound 128
fccc get t i
end
end
fn ffilc c uchar to void
n = get ffilel 0
if lt n 4095
put ffile n c
put ffilel 0 add n 1
end
end
note ---- packed argument list fpk (u16 count, then u16 length + bytes per record)
fn fkb to void
put fpk 0 0
put fpk 1 0
put fpkl 0 2
end
fn fkopen to void
n = get fpkl 0
if ge n 8190
ret
end
put fpkr 0 n
put fpk n 0
put fpk add n 1 0
put fpkl 0 add n 2
c = add or ulong get fpk 0 shl ulong get fpk 1 8 1
put fpk 0 uchar and c 255
put fpk 1 uchar shr c 8
end
fn fkc c uchar to void
n = get fpkl 0
if lt n 8191
put fpk n c
put fpkl 0 add n 1
r = get fpkr 0
k = add or ulong get fpk r shl ulong get fpk add r 1 8 1
put fpk r uchar and k 255
put fpk add r 1 uchar shr k 8
end
end
fn fkt t view uchar * to void
for i ulong len t bound 8192
fkc get t i
end
end
fn fka t view uchar * to void
fkopen
fkt t
end
note fkrid: append the current repo RID to the open argument
fn fkrid to void
for i ulong get fridl 0 bound 64
fkc get frid i
end
end
note fkgit: argv = /usr/bin/git --git-dir=<storage>/<frid> (store: the current repo's repo.git)
fn fkgit to void
fkb
fka tfgit
fkopen
fkt tfgitdir
if eq get fsrcst 0 1
fksdir get fridx 0
ret
end
fkt tfstore
fkrid
end
note fkgiti: the same for allow-list repo i
fn fkgiti i ulong to void
fkb
fka tfgit
fkopen
fkt tfgitdir
if eq get fsrcst 0 1
fksdir i
ret
end
fkt tfstore
for k ulong get fail i bound 64
fkc fridbyte i k
end
end
note fksdir: <fsrt>projects/<name of i>/repo.git into the open argument (no name past the list)
fn fksdir i ulong to void
for k ulong get fsrtl 0 bound 4096
fkc get fsrt k
end
fkt tfsprj
if lt i get fan 0
for k ulong get fanl i bound 128
fkc frnbyte i k
end
end
fkt tfsrg
end
note ---- run argv fpk: no shell, no PATH, empty environment, stdout into fxo
fn fpfdv i ulong to int
b = mul i 4
v = or ulong get fpfd b shl ulong get fpfd add b 1 8
v = or v shl ulong get fpfd add b 2 16
v = or v shl ulong get fpfd add b 3 24
ret int v
end
fn fchild wfd int to void
fchildin wfd -1
end
fn fchildin wfd int infd int to void
nul = fopen tfdevnul 0 len tfdevnul 2 0
if lt nul 0
exit 126
end
input = infd
if lt input 0
input = int nul
end
x = dupfd input 0 0
if lt x 0
exit 126
end
x = dupfd wfd 1 0
x = dupfd int nul 2 0
x = execprog fpk 0 get fpkl 0
exit 127
end
fn fdrain fd int dl long to bool
for it ulong 10000000
left = sub dl long monons
if le left 0
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret false
end
continue
end
if eq w 0
continue
end
n = get fxol 0
if ge n len fxo
put fxotr 0 1
r = read fd fjunk 0 4096
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
end
continue
end
r = read fd fxo n sub len fxo n
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
continue
end
put fxol 0 add n ulong r
end
ret false
end
fn freap pid int dl long to long
for it ulong 1000000
w = waitpid pid fwst 0 4 1
if eq w long pid
s = or ulong get fwst 0 shl ulong get fwst 1 8
if eq and s 127 0
ret long and shr s 8 255
end
ret -3
end
if lt w 0
if ne w -4
ret -4
end
continue
end
if gt long monons dl
x = killpid pid 9
w = waitpid pid fwst 0 4 0
ret -1
end
x = sleepns 200000
end
ret -4
end
fn fexec tmo long to long
ret fexecin tmo -1
end
fn fexecin tmo long infd int to long
put fxol 0 0
put fxotr 0 0
r = pipefds fpfd 0 8 524288
if lt r 0
ret -2
end
rfd = fpfdv 0
wfd = fpfdv 1
dl = add long monons tmo
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
fchildin wfd infd
exit 127
end
x = fclose wfd
ok = fdrain rfd dl
x = fclose rfd
if not ok
x = killpid int pid 9
end
st = freap int pid dl
if not ok
ret -1
end
ret st
end
fn fxput a ulong n ulong to void
for i ulong n bound 16777216
fputc get fxo add a i
end
end
fn fxesc a ulong n ulong to void
for i ulong n bound 16777216
fescc get fxo add a i
end
end
note ---- streaming exec: a listing longer than fxo is read through it in windows, one record at a time
note (the cut copy of fexec is never taken for the whole). fsopen starts argv fpk like fexec; fsnext C
note returns the end e of the next record (the bytes up to the next C, or up to the end of the output),
note which is fxo[get fsrs 0, e) until the next fsnext call. fsnext returns FSEND at the end of the output
note and FSFAIL on a timeout, a read error, or one record longer than fxo (fxotr is set then: the
note caller answers the whole 500 of fincut). fsclose ends the child (killed if it is still writing)
note and returns its exit status, or -1 when the output was not read to its end.
const FSEND ulong 16777217
const FSFAIL ulong 16777218
fn fsopen tmo long to bool
put fxol 0 0
put fxotr 0 0
put fsp 0 0
put fsq 0 0
put fsrs 0 0
put fsst 3 2
r = pipefds fpfd 0 8 524288
if lt r 0
ret false
end
rfd = fpfdv 0
wfd = fpfdv 1
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret false
end
if eq pid 0
fchild wfd
exit 127
end
x = fclose wfd
put fsst 0 long rfd
put fsst 1 long pid
put fsst 2 add long monons tmo
put fsst 3 0
ret true
end
note fsfill: move the unread bytes fxo[fsp, fxol) to the front, then read until fxo is full or the
note output ends. false on a timeout or read error.
fn fsfill to bool
p = get fsp 0
n = get fxol 0
if gt p 0
for i ulong sub n p bound 16777216
put fxo i get fxo add p i
end
put fxol 0 sub n p
put fsq 0 sub get fsq 0 p
put fsrs 0 0
put fsp 0 0
end
if ne get fsst 3 0
ret eq get fsst 3 1
end
fd = int get fsst 0
dl = get fsst 2
for it ulong 100000000
m = get fxol 0
if ge m len fxo
ret true
end
left = sub dl long monons
if le left 0
put fsst 3 2
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
put fsst 3 2
ret false
end
continue
end
if eq w 0
continue
end
r = read fd fxo m sub len fxo m
if eq r 0
put fsst 3 1
ret true
end
if lt r 0
if and ne r -4 ne r -11
put fsst 3 2
ret false
end
continue
end
put fxol 0 add m ulong r
end
put fsst 3 2
ret false
end
fn fsnext c uchar to ulong
for it ulong 100000000
s = get fsp 0
n = get fxol 0
q = get fsq 0
while lt q n bound 16777216
if eq get fxo q c
put fsrs 0 s
put fsp 0 add q 1
put fsq 0 add q 1
ret q
end
q = add q 1
end
put fsq 0 q
if eq get fsst 3 1
if lt s n
put fsrs 0 s
put fsp 0 n
ret n
end
ret FSEND
end
if and eq s 0 ge n len fxo
put fxotr 0 1
ret FSFAIL
end
if not fsfill
ret FSFAIL
end
end
ret FSFAIL
end
fn fsclose to long
fd = int get fsst 0
x = fclose fd
pid = int get fsst 1
done = eq get fsst 3 1
if not done
x = killpid pid 9
end
st = freap pid get fsst 2
put fsst 3 2
if not done
ret -1
end
ret st
end
note ---- path builder fpth and whole-file read into fxo
fn fpb to void
put fpthl 0 0
end
fn fpc c uchar to void
n = get fpthl 0
if lt n 4095
put fpth n c
put fpthl 0 add n 1
end
end
fn fpt t view uchar * to void
for i ulong len t bound 4096
fpc get t i
end
end
note frdall: read the file at fpth (up to the size of fxo) into fxo; returns bytes or -errno
fn frdall to long
put fxol 0 0
put fxotr 0 0
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret fd
end
for it ulong 100000
n = get fxol 0
if ge n len fxo
put fxotr 0 1
break
end
r = read int fd fxo n sub len fxo n
if le r 0
break
end
put fxol 0 add n ulong r
end
x = fclose int fd
ret long get fxol 0
end
note fmtime: modification time (s) of the file at fpth, 0 when missing
fn fmtime to ulong
r = stat fpth 0 get fpthl 0 fstb 0 128
if lt r 0
ret 0
end
v = ulong 0
for i ulong 8
v = or v shl ulong get fstb add 88 i mul i 8
end
ret v
end
fn flog t view uchar * to void
w = write 2 t 0 len t
end
note ---- per-IP write limit
fn frlkey to ulong
h = ulong 14695981039346656037
for i ulong get fipl 0 bound 64
c = ulong get fip i
h = mul xor h c 1099511628211
end
ret or h 1
end
fn frlslot h ulong to ulong
e = ulong 256
o = ulong 0
for i ulong 256
k = get frlk i
if eq k h
ret i
end
if and eq k 0 eq e 256
e = i
end
a = get frlt i
b = get frlt o
if lt a b
o = i
end
end
if lt e 256
ret e
end
ret o
end
fn fratelim to bool
h = frlkey
b = frlslot h
now = div ulong monons 1000000000
if ne get frlk b h
put frlk b h
put frlt b now
put frlc b 0
end
if gt sub now get frlt b 60
put frlt b now
put frlc b 0
end
c = get frlc b
if ge c 30
ret false
end
put frlc b add c 1
ret true
end
fn fsetsbx to void
put fcspsb 0 1
end
note ---- small byte helpers
fn fisdig c uchar to bool
ret and ge c 48 le c 57
end
fn fisaln c uchar to bool
if fisdig c
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end
note fpathat: fpath[i] or 0 past the end
fn fpathat i ulong to uchar
if lt i get fpathl 0
ret get fpath i
end
ret uchar 0
end
note fpeq: fpath equals t exactly
fn fpeq t view uchar * to bool
if ne len t get fpathl 0
ret false
end
for i ulong len t bound 4096
if ne get t i get fpath i
ret false
end
end
ret true
end
note fpre: fpath starts with t
fn fpre t view uchar * to bool
if gt len t get fpathl 0
ret false
end
for i ulong len t bound 4096
if ne get t i get fpath i
ret false
end
end
ret true
end
note frsteq / frstpre: the same tests on frest
fn frsteq t view uchar * to bool
if ne len t get frestl 0
ret false
end
for i ulong len t bound 4096
if ne get t i get frest i
ret false
end
end
ret true
end
fn frstpre t view uchar * to bool
if gt len t get frestl 0
ret false
end
for i ulong len t bound 4096
if ne get t i get frest i
ret false
end
end
ret true
end
note ---- fdclean: the description of repo i as the forge shows it (fadesc[fado i, +fadl i]).
note Radicle was removed from Interplane on 2026-11-14 and some identity documents still name it.
note The stored document is not changed; the copy loaded into fadesc is cut once, at load
note (server/repos.om fdcopy): sentences (ending ". ") that name the retired network are dropped;
note when none is left, the text before the first " (" or ": " is kept if it names nothing retired;
note otherwise the description is empty.
text tfdt1 "radicle"
text tfdt2 "heartwood"
text tfdt3 "rad:z"
text tfdt4 "/rad/"
text tfdt5 "rad clone"
text tfdt6 "rad init"
text tfdt7 "rad sync"
text tfdt8 "rad id"
text tfdt9 "rad patch"
text tfdt10 "rad auth"
note fdhas: does fadesc[a, b) hold t (lowercase ASCII), compared without case
fn fdhas a ulong b ulong t view uchar * to bool
n = len t
if lt b add a n
ret false
end
m = add sub sub b a n 1
for i ulong m bound 65536
ok = true
for k ulong n bound 16
c = get fadesc add add a i k
if and ge c 65 le c 90
c = add c 32
end
if ne c get t k
ok = false
end
end
if ok
ret true
end
end
ret false
end
fn fdterm a ulong b ulong to bool
if or fdhas a b tfdt1 or fdhas a b tfdt2 or fdhas a b tfdt3 fdhas a b tfdt4
ret true
end
if or fdhas a b tfdt5 or fdhas a b tfdt6 or fdhas a b tfdt7 fdhas a b tfdt8
ret true
end
ret or fdhas a b tfdt9 fdhas a b tfdt10
end
note fdfind: the first p in [a, b-1) with fadesc[p] = c1 and fadesc[p+1] = c2, else b
fn fdfind a ulong b ulong c1 uchar c2 uchar to ulong
if le b add a 1
ret b
end
for i ulong sub sub b a 1 bound 65536
p = add a i
x = get fadesc p
y = get fadesc add p 1
if and eq x c1 eq y c2
ret p
end
end
ret b
end
note fdmove: copy fadesc[s, x) down to w (w <= s); the new end of what was written
fn fdmove w ulong s ulong x ulong to ulong
for k ulong sub x s bound 65536
c = get fadesc add s k
put fadesc add w k c
end
ret add w sub x s
end
fn fdskip s ulong e ulong to ulong
p = s
while lt p e bound 65537
if ne get fadesc p 32
ret p
end
p = add p 1
end
ret p
end
note fdsent: keep the sentences of fadesc[o, e) that name nothing retired, packed from o, one
note space apart; the end of what was kept (o when none was)
fn fdsent o ulong e ulong to ulong
w = o
s = o
while lt s e bound 65537
d = fdfind s e 46 32
x = e
if lt d e
x = add d 1
end
if not fdterm s x
if gt w o
put fadesc w 32
w = add w 1
end
w = fdmove w s x
end
s = fdskip x e
end
ret w
end
fn fdclean i ulong to void
o = get fado i
e = add o get fadl i
if not fdterm o e
ret
end
w = fdsent o e
if gt w o
put fadl i sub w o
ret
end
p = fdfind o e 32 40
if and gt p o not fdterm o p
put fadl i sub p o
ret
end
p = fdfind o e 58 32
if and gt p o not fdterm o p
put fadl i sub p o
ret
end
put fadl i 0
end

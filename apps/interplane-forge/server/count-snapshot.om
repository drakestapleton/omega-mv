note Public count snapshot v1. ASCII: header "1 <collection epoch>\n", then at most 64 rows.
note Row: RID git upload archives assets since0 since1 since2 seeds seed-status seed-epoch LF.
note Fields separated by one space. RID alphanumeric, 1..64 bytes. Numbers unsigned decimal,
note 1..20 digits, no overflow. Status 0/1/2; only 1 means available. No private log content.
note Cap 16384 bytes, 256 bytes per line excluding LF, 65 lines, 11 fields, 64-byte fields.
note Missing/malformed/future/older-than-3600s snapshots clear all availability, never trap.
text tfzsenv "FORGED_COUNTS_SNAPSHOT=1"
text tfzspth "/home/drakestapleton/handoffs/radicle/counts.snapshot"
text tfzmode "--counts-snapshot"
global fzsbuf uchar 16385
global fzsen uchar 4096
global fzfo ulong 11
global fzfl ulong 11
global fzval ulong 11
global fzseen uchar 4096
global fzsl ulong 64
global fzsnum ulong 1
fn fzboxed to bool
nn = envcnt
if or lt nn 0 gt nn 4096
ret true
end
for k ulong ulong nn bound 4096
n = envread k fzsen 0 len fzsen
if eq n long len tfzsenv
ok = true
for j ulong len tfzsenv bound 64
if ne get fzsen j get tfzsenv j
ok = false
end
end
if ok
ret true
end
end
end
ret false
end
fn fzclear to void
for k ulong 4
put fzsnc k 0
end
for k ulong 64
put fzsdk k 0
put fzsdt k 0
put fzsd k 0
end
for k ulong 256
put fzcnt k 0
end
end
fn fzfields a ulong e ulong to ulong
p = a
n = ulong 0
for j ulong sub e a bound 256
if eq get fzsbuf add a j 32
if or eq add a j p ge n 11
ret 0
end
put fzfo n p
put fzfl n sub add a j p
n = add n 1
p = add add a j 1
end
end
if or eq p e ge n 11
ret 0
end
put fzfo n p
put fzfl n sub e p
n = add n 1
for k ulong n bound 11
if gt get fzfl k 64
ret 0
end
end
ret n
end
fn fzsnumber k ulong to bool
n = get fzfl k
if or eq n 0 gt n 20
ret false
end
v = ulong 0
for j ulong n bound 20
c = get fzsbuf add get fzfo k j
if not fisdig c
ret false
end
d = ulong sub c 48
if gt v 1844674407370955161
ret false
end
if and eq v 1844674407370955161 gt d 5
ret false
end
v = add mul v 10 d
end
put fzval k v
ret true
end
fn fzssame row ulong r ulong n ulong to bool
for j ulong n bound 64
left = get fzseen add mul row 64 j
right = get fzseen add mul r 64 j
if ne left right
ret false
end
end
ret true
end
fn fzsrid row ulong to bool
n = get fzfl 0
for j ulong n bound 64
c = get fzsbuf add get fzfo 0 j
if not or fisdig c or and ge c 65 le c 90 and ge c 97 le c 122
ret false
end
put fzseen add mul row 64 j c
end
put fzsl row n
for r ulong row bound 64
if eq get fzsl r n
if fzssame row r n
ret false
end
end
end
ret true
end
fn fzsmatch i ulong to bool
n = get fzfl 0
if ne get fail i n
ret false
end
for k ulong n bound 64
if ne fridbyte i k get fzsbuf add get fzfo 0 k
ret false
end
end
ret true
end
fn fzsrow row ulong to bool
if not fzsrid row
ret false
end
for k ulong 10
if not fzsnumber add k 1
ret false
end
end
if gt get fzval 9 2
ret false
end
if and eq get fzval 9 1 eq get fzval 10 0
ret false
end
if gt get fzval 3 sub ulong 18446744073709551615 get fzval 4
ret false
end
for k ulong 3
if gt get fzval add k 5 get fzsnum 0
ret false
end
end
if gt get fzval 10 get fzsnum 0
ret false
end
for i ulong get fan 0 bound 64
if and eq i get fridx 0 fzsmatch i
for k ulong 4
put fzcnt add mul k 64 i get fzval add k 1
end
note Rendering uses global source timestamps, identical across all producer rows.
for k ulong 3
put fzsnc k get fzval add k 5
end
put fzsd i get fzval 8
put fzsdk i get fzval 9
put fzsdt i get fzval 10
end
end
ret true
end
fn fzsparse n ulong to bool
a = ulong 0
line = ulong 0
for q ulong n bound 16384
if eq get fzsbuf q 10
if or ge line 65 gt sub q a 256
ret false
end
nf = fzfields a q
if eq line 0
if ne nf 2
ret false
end
if not and fzsnumber 0 fzsnumber 1
ret false
end
if ne get fzval 0 1
ret false
end
now = div ulong realns 1000000000
stamp = get fzval 1
if gt stamp now
ret false
end
if gt sub now stamp 3600
ret false
end
put fzsnum 0 stamp
else
if ne nf 11
ret false
end
if not fzsrow sub line 1
ret false
end
end
line = add line 1
a = add q 1
else
if ge sub q a 256
ret false
end
end
end
ret and eq a n gt line 0
end
fn fzscapture fd int to long
if ne fstat fd fzst 0 128 0
ret -1
end
mode = or uint get fzst 16 shl uint get fzst 17 8
if ne and mode 61440 32768
ret -1
end
n = ulong 0
for tries ulong 16386
if eq n len fzsbuf
ret -1
end
r = read fd fzsbuf n sub len fzsbuf n
if lt r 0
ret -1
end
if eq r 0
ret long n
end
n = add n ulong r
end
ret -1
end
fn fzsnapshot to void
fzclear
fd = fopen tfzspth 0 len tfzspth 657408 0
if lt fd 0
ret
end
n = fzscapture int fd
c = fclose int fd
if or or le n 0 gt n 16384 ne c 0
ret
end
if not fzsparse ulong n
fzclear
end
end
note Owner-only mode reuses fload, fzload, fzsync and fzseeds. Journal path is mandatory.
note stdout contains the complete public snapshot; supervisor performs atomic publication.
fn fzmode to long
if lt argcnt 2
ret -1
end
n = argread 1 fzsen 0 len fzsen
if ne n long len tfzmode
ret -1
end
for k ulong len tfzmode bound 64
if ne get fzsen k get tfzmode k
ret -1
end
end
if or fzboxed ne argcnt 3
ret 2
end
n = argread 2 fzjp 0 len fzjp
if or le n 1 ge n long len fzjp
ret 2
end
if ne get fzjp 0 47
ret 2
end
put fzjpl 0 ulong n
nr = fload
if lt nr 0
ret 3
end
fzload
put fzhomel 0 0
fzsync 0
fzsync 1
fzsync 2
for i ulong get fan 0 bound 64
fzseeds i
end
put fzjbl 0 0
fzjn 1
fzjc 32
fzjn div ulong realns 1000000000
fzjc 10
for i ulong get fan 0 bound 64
for k ulong get fail i bound 64
fzjc fridbyte i k
end
for k ulong 4
fzjc 32
fzjn fzc k i
end
for k ulong 3
fzjc 32
fzjn get fzsnc k
end
fzjc 32
fzjn get fzsd i
fzjc 32
fzjn get fzsdk i
fzjc 32
fzjn get fzsdt i
fzjc 10
end
outn = get fzjbl 0
if gt outn 16384
ret 4
end
w = write 1 fzjb 0 outn
if ne w long outn
ret 5
end
ret 0
end

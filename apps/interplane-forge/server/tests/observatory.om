note Native tests for the Observatory pure predicate extracted from server/pages.om.
text ta "1111111111111111111111111111111111111111"
text tb "1111111111111111111111111111111111111111"
text tc "1111111111111111111111111111111111111112"
text td "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
text te "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
text tf "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"
text tg "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
text th ""
text ti "fffffffffffffffffffffffffffffffffffffff"
text tj "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
text tk "fffffffffffffffffffffffffffffffffffffffg"
global checks ulong 1
fn expect got ulong want ulong to void
if ne got want
exit 1
end
put checks 0 add get checks 0 1
end
fn main to int
expect ogjudge ta tb 0
expect ogjudge ta tc 2
expect ogjudge td te 0
expect ogjudge ta td 2
expect ogjudge ta tg 1
expect ogjudge ta th 1
expect ogjudge ta ti 1
expect ogjudge ta tj 1
expect ogjudge ta tk 1
expect ogsuite td te 0
expect ogsuite td tf 3
expect ogsuite td ta 1
expect ogsuite td tj 1
for f ulong 64 bound 64
if eq f 31
expect ogfacts 0 0 f 0
else
expect ogfacts 0 0 f 4
end
end
expect ogfacts 2 0 31 2
expect ogfacts 0 3 31 3
expect ogfacts 1 3 31 1
expect get checks 0 80
ret 0
end

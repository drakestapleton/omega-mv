note server/tests/ratelim.om -- unit gate for fratelim (server/util.om), run by server/tests/check.sh.
note Composed after every forged unit (main.om's main renamed), so it calls the real fratelim.
note Exit 0 = pass; 1/2 = one IP not limited to 30 writes; 3 = another IP refused; 4 = an IP whose
note old 32-bit FNV bucket (rem h 256) equals the exhausted IP's was refused (the P3-3 collision);
note 5 = no colliding IP found; 6 = a fresh IP refused while the table fills.
text ttipa "10.0.0.1"
fn tsetip t view uchar * to void
for i ulong len t bound 64
put fip i get t i
end
put fipl 0 len t
end
fn tsetn n ulong to void
put fip 0 105
put fip 1 uchar and n 255
put fip 2 uchar and shr n 8 255
put fipl 0 3
end
fn toldb to ulong
h = ulong 2166136261
for i ulong get fipl 0 bound 64
h = and mul xor h ulong get fip i 16777619 4294967295
end
ret rem h 256
end
fn tcoll ob ulong to ulong
for n ulong 65536
tsetn n
if eq toldb ob
ret n
end
end
ret 65536
end
fn tfill to int
for n ulong 300
tsetn add n 1000
if not fratelim
ret 6
end
end
ret 0
end
fn main to int
tsetip ttipa
for i ulong 30
if not fratelim
ret 1
end
end
if fratelim
ret 2
end
ob = toldb
tsetn 70000
if not fratelim
ret 3
end
n = tcoll ob
if eq n 65536
ret 5
end
tsetn n
if not fratelim
ret 4
end
ret tfill
end

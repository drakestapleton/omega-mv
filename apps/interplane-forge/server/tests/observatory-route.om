note Compose every forge unit with original main renamed fmainx, then append this native route test.
text oq0 ""
text oq1 "case=0"
text oq2 "case=1"
text oq3 "case=2"
text oq4 "case=3"
text oq5 "case=4"
text oq6 "case=5"
text oq7 "case"
text oq8 "case="
text oq9 "case=0&case=1"
text oq10 "x=1&case"
text oq11 "case=99"
text oq12 "x=1"
text oq13 "case=%30"
text oq14 "case=0&case"
text oq15 "casez=1"
text oroot "/"
text oexp "/explore"
text opref "/forge/"
text onpass "Admissible fixture"
text ondeny "Evidence refused"
text oninv "Unknown scenario"
text oncls "class=\"ob-page\""
text onform "action=\"/forge/#evidence\""
text opass "OBSERVATORY_ROUTE PASS 37\n"
global ocnt ulong 1
fn oassert yes bool to void
if not yes
exit 1
end
put ocnt 0 add get ocnt 0 1
end
fn oquery q view uchar * to void
put fqsl 0 len q
for i ulong len q bound 4096
put fqs i get q i
end
end
fn opath p view uchar * to void
put fpathl 0 len p
for i ulong len p bound 4096
put fpath i get p i
end
end
fn ofind s view uchar * to bool
n = get fobl 0
if lt n len s
ret false
end
for i ulong add sub n len s 1 bound 262144
same = true
for j ulong len s bound 256
if ne get fob add i j get s j
same = false
end
end
if same
ret true
end
end
ret false
end
fn ocase q view uchar * want ulong msg view uchar * to void
fresetr
opath oroot
oquery q
oassert eq obscene want
obhome
oassert ofind msg
end
fn main to int
put fmeth 0 1
put fbasel 0 1
put fbase 0 47
ocase oq0 0 onpass
ocase oq1 0 onpass
ocase oq2 1 ondeny
ocase oq3 2 ondeny
ocase oq4 3 ondeny
ocase oq5 4 ondeny
ocase oq6 5 ondeny
ocase oq7 99 oninv
ocase oq8 99 oninv
ocase oq9 99 oninv
ocase oq10 99 oninv
ocase oq11 99 oninv
ocase oq12 0 onpass
ocase oq13 0 onpass
ocase oq14 99 oninv
ocase oq15 0 onpass
fresetr
opath oroot
fhead
oassert ofind oncls
fresetr
opath oexp
fhead
oassert not ofind oncls
fresetr
opath oroot
oquery oq0
put fbasel 0 len opref
for i ulong len opref bound 64
put fbase i get opref i
end
obhome
oassert ofind onform
put fmeth 0 3
oassert eq fpgroot 405
oassert eq get ocnt 0 36
w = write 1 opass 0 len opass
ret 0
end

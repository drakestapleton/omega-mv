note fcoming: a known repo feature path that no composed slice served yet: 501 "coming", not 404
fn fcoming to bool
if fcoma
ret true
end
ret fcomb
end
fn fcoma to bool
if or or fseg1 tfcm1 fseg1 tfcm2 or fseg1 tfcm3 fseg1 tfcm4
ret true
end
if or or fseg1 tfcm5 fseg1 tfcm6 or fseg1 tfcm7 fseg1 tfcm8
ret true
end
ret fseg1 tfcm9
end
fn fcomb to bool
if or or fseg1 tfcm10 fseg1 tfcm11 or fseg1 tfcm12 fseg1 tfcm13
ret true
end
if or or fseg1 tfcm14 fseg1 tfcm15 or fseg1 tfcm16 fseg1 tfcm17
ret true
end
ret fseg1 tfcm18
end
note fslices0: reserved two-segment paths (e.g. /assets/forge.css, /login/x): the slices may claim them
fn fslices0 to long
if fpeq tfpcss
if not fget
ret 405
end
fcssout
ret 200
end
if fpeq tfpico
if not fget
ret 405
end
ficoout
ret 200
end
if eq get fbasel 0 1
if fpeq tfpgxc
ret fgxsend tfgxc tfctcss
end
if fpeq tfpgxt
ret fgxsend tfgxt tfctcss
end
end
r = fslices
if ne r 0
ret r
end
ret 404
end
fn fpgroot to long
if not fget
ret 405
end
r = grorder
if ne r 0
ret r
end
if fjwant
fjexplore
ret 200
end
note the root stays the explore page; the galaxy is its own page at /galaxy (fpgone), the map
fexplore true
ret 200
end
text tfpexj "/explore.json"
text tfjsfx ".json"
note fjsfx: /<owner>/<repo>.json (no more path) for a public repo: its forge/repo/1 JSON; 0 = not this
fn fjsfx to long
if ne get frestl 0 0
ret 0
end
n = get frepol 0
if le n len tfjsfx
ret 0
end
b = sub n len tfjsfx
for k ulong len tfjsfx
if ne get frepo add b k get tfjsfx k
ret 0
end
end
put frepol 0 b
if not fsetrepo
put frepol 0 n
put fridx 0 9999
ret 0
end
if not fget
ret 405
end
fzprep
fjrepo
ret 200
end
note fpgone: one segment: forge pages, the social slice, then the owner profile
fn fpgone to long
r = grorder
if ne r 0
ret r
end
note agents.json (server/agents.om) and the event stream and feed (door/, or the seam server/nodoor.om)
r = fqaroute
if ne r 0
ret r
end
r = evroute
if ne r 0
ret r
end
if fpeq tfpexj
if not fget
ret 405
end
fjexplore
ret 200
end
if fpeq tfpgx
if fgxhas
ret fgxsend tfgxi tfgxhtm
end
end
r = fslices
if ne r 0
ret r
end
if fpeq tfpexp
if not fget
ret 405
end
if fjwant
fjexplore
ret 200
end
fexplore false
ret 200
end
if fpeq tfpsrch
if not fget
ret 405
end
fqcap
if fjwant
fyjsrch
ret 200
end
fyalt
fsearch
ret 200
end
if fpre tfprad
ret fradredir
end
if or fpeq tfst fpeq tfstj
if not fget
ret 405
end
ret nsstat
end
if freserved
if fcomone
ret 501
end
ret 404
end
if not fisown
ret 404
end
if not fget
ret 405
end
if fjwant
fyjprof
ret 200
end
fyalt
fprofile
ret 200
end

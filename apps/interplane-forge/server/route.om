note forged server/route.om: path safety, the allow-list gate, the /rad:<RID> redirect, slice dispatch.
text tfpexp "/explore"
text tfpcss "/assets/forge.css"
text tfprad "/rad:"
text tfrsv1 "quick-start"
text tfrsv2 "concepts"
text tfrsv3 "adapter"
text tfrsv4 "conformance"
text tfrsv5 "status"
text tfrsv6 "forge"
text tfrsv7 "protocol"
text tfrsv8 "api"
text tfrsv9 "login"
text tfrsv10 "logout"
text tfrsv11 "explore"
text tfrsv12 "settings"
text tfrsv13 "new"
text tfrsv14 "search"
text tfrsv15 "stars"
text tfrsv16 "notifications"
text tfrsv17 "llms.txt"
text tfrsv18 "sitemap.xml"
text tfrsv19 "robots.txt"
text tfrsv20 "assets"
note ---- path safety: 1 = safe. Refuses NUL / control / backslash, "//", "." and ".." segments
note (raw or %2e-encoded), and any %2f / %5c / %00 (encoded separators and NUL).
fn fsegdot a ulong e ulong to bool
n = sub e a
if eq n 1
ret eq fpathat a 46
end
if eq n 2
ret and eq fpathat a 46 eq fpathat add a 1 46
end
ret false
end
fn fpctbad i ulong to bool
if ne fpathat i 37
ret false
end
h = flow fpathat add i 1
l = flow fpathat add i 2
if and eq h 50 eq l 101
ret true
end
if and eq h 50 eq l 102
ret true
end
if and eq h 53 eq l 99
ret true
end
ret and eq h 48 eq l 48
end
fn fpathok to bool
n = get fpathl 0
if or eq n 0 ge n 4096
ret false
end
if ne fpathat 0 47
ret false
end
s = ulong 1
for i ulong n bound 4096
c = fpathat i
if or lt c 32 eq c 127
ret false
end
if eq c 92
ret false
end
if fpctbad i
ret false
end
if and gt i 0 eq c 47
if eq s i
ret false
end
if fsegdot s i
ret false
end
s = add i 1
end
end
if fsegdot s n
ret false
end
ret true
end
note ---- path segments: fseg0 / fseg1 fill fown and frepo; frest gets the remainder
fn fsegend a ulong to ulong
n = get fpathl 0
j = a
while lt j n bound 4096
if eq fpathat j 47
ret j
end
j = add j 1
end
ret n
end
note fsplit: 0 = "/", 1 = "/<a>", 2 = "/<a>/<b>[...]"; returns 9 when a segment is too long
fn fsplit to ulong
put fownl 0 0
put frepol 0 0
put frestl 0 0
n = get fpathl 0
if le n 1
ret 0
end
e1 = fsegend 1
if gt sub e1 1 63
ret 9
end
for i ulong sub e1 1 bound 64
put fown i fpathat add 1 i
end
put fownl 0 sub e1 1
if ge add e1 1 n
ret 1
end
e2 = fsegend add e1 1
if gt sub sub e2 e1 1 127
ret 9
end
for i ulong sub sub e2 e1 1 bound 128
put frepo i fpathat add add e1 1 i
end
put frepol 0 sub sub e2 e1 1
if gt sub n e2 4095
ret 9
end
for i ulong sub n e2 bound 4096
put frest i fpathat add e2 i
end
put frestl 0 sub n e2
ret 2
end
fn fowneq t view uchar * to bool
if ne len t get fownl 0
ret false
end
for i ulong len t bound 64
if ne get t i get fown i
ret false
end
end
ret true
end
fn fisown to bool
ret fowneq tfowner
end
fn frsv1 to bool
if or or fowneq tfrsv1 fowneq tfrsv2 fowneq tfrsv3
ret true
end
if or or fowneq tfrsv4 fowneq tfrsv5 fowneq tfrsv6
ret true
end
if or or fowneq tfrsv7 fowneq tfrsv8 fowneq tfrsv9
ret true
end
ret or fowneq tfrsv10 fowneq tfrsv11
end
fn frsv2 to bool
if or or fowneq tfrsv12 fowneq tfrsv13 fowneq tfrsv14
ret true
end
if or or fowneq tfrsv15 fowneq tfrsv16 fowneq tfrsv17
ret true
end
ret or or fowneq tfrsv18 fowneq tfrsv19 fowneq tfrsv20
end
fn freserved to bool
if frsv1
ret true
end
ret frsv2
end
note fsetrepo: owner must be the delegate and repo in the allow-list; fills fridx / frid
fn fsetrepo to bool
put fridx 0 9999
put fridl 0 0
if not fisown
ret false
end
i = frepoix
if ge i get fan 0
ret false
end
put fridx 0 i
l = get fail i
for k ulong l bound 64
put frid k fridbyte i k
end
put fridl 0 l
ret true
end
note ---- /rad:<RID>[/rest] -> 302 to /<owner>/<name>[/rest] when public, else 404
fn fridat i ulong to bool
l = get fail i
if ne get fownl 0 add l 4
ret false
end
for k ulong l bound 64
if ne fridbyte i k get fown add k 4
ret false
end
end
ret true
end
fn fradredir to long
if not fpre tfprad
ret 0
end
for i ulong get fan 0 bound 64
if fridat i
fradloc i
ret 302
end
end
ret 404
end
fn fradloc i ulong to void
flocb
floct tfowner
flocc 47
for k ulong get fanl i bound 128
flocc frnbyte i k
end
a = add 1 get fownl 0
n = sub get fpathl 0 a
for k ulong n bound 4096
flocc fpathat add a k
end
fqsloc
put fkind 0 2
end
fn fqsloc to void
if eq get fqsl 0 0
ret
end
flocc 63
for k ulong get fqsl 0 bound 4096
flocc get fqs k
end
end
note ---- the dispatcher. Returns the HTTP status; fob / fkind are filled.
fn fslices to long
r = soroute
if ne r 0
ret r
end
r = dlroute
if ne r 0
ret r
end
r = coroute
if ne r 0
ret r
end
ret brroute
end
fn fget to bool
ret eq get fmeth 0 1
end
fn froute to long
if not fpathok
ret 400
end
sg = fsplit
if eq sg 9
ret 404
end
put fridx 0 9999
if eq sg 0
ret fpgroot
end
if eq sg 1
ret fpgone
end
r = fradredir
if ne r 0
ret r
end
if freserved
ret fslices0
end
if not fsetrepo
ret 404
end
r = fslices
if ne r 0
ret r
end
if and fget eq get frestl 0 0
frepohome
ret 200
end
if fcoming
ret 501
end
ret 404
end
text tfcm1 "/tree"
text tfcm2 "/blob"
text tfcm3 "/raw"
text tfcm4 "/blame"
text tfcm5 "/commits"
text tfcm6 "/commit"
text tfcm7 "/compare"
text tfcm8 "/branches"
text tfcm9 "/tags"
text tfcm10 "/releases"
text tfcm11 "/archive"
text tfcm12 "/patches"
text tfcm13 "/issues"
text tfcm14 "/stargazers"
text tfcm15 "/search"
text tfcm16 "/labels"
text tfcm17 "/star"
text tfcm18 "/fav"
note fseg1: frest's first segment is exactly t (t starts with /)
fn fseg1 t view uchar * to bool
if not frstpre t
ret false
end
n = len t
if eq n get frestl 0
ret true
end
ret eq get frest n 47
end
note fcoming: a known repo feature path that no composed slice served yet: 501 "coming", not 404
fn fcoming to bool
if fcoma
ret true
end
ret fcomb
end
fn fcoma to bool
if or or fseg1 tfcm1 fseg1 tfcm2 or fseg1 tfcm3 fseg1 tfcm4
ret true
end
if or or fseg1 tfcm5 fseg1 tfcm6 or fseg1 tfcm7 fseg1 tfcm8
ret true
end
ret fseg1 tfcm9
end
fn fcomb to bool
if or or fseg1 tfcm10 fseg1 tfcm11 or fseg1 tfcm12 fseg1 tfcm13
ret true
end
if or or fseg1 tfcm14 fseg1 tfcm15 or fseg1 tfcm16 fseg1 tfcm17
ret true
end
ret fseg1 tfcm18
end
note fslices0: reserved two-segment paths (e.g. /assets/forge.css, /login/x): the slices may claim them
fn fslices0 to long
if fpeq tfpcss
if not fget
ret 405
end
fcssout
ret 200
end
r = fslices
if ne r 0
ret r
end
ret 404
end
fn fpgroot to long
if not fget
ret 405
end
fexplore true
ret 200
end
note fpgone: one segment: forge pages, the social slice, then the owner profile
fn fpgone to long
r = fslices
if ne r 0
ret r
end
if fpeq tfpexp
if not fget
ret 405
end
fexplore false
ret 200
end
if fpeq tfpsrch
if not fget
ret 405
end
fqcap
fsearch
ret 200
end
if fpre tfprad
ret fradredir
end
if freserved
ret 404
end
if not fisown
ret 404
end
if not fget
ret 405
end
fprofile
ret 200
end

note ---- galaxy: the INTERPLANE front page. galaxy-live (galaxy/live.om) writes it into <data>galaxy/;
note forged only streams those files. Served on the interplane.io base "/" alone: the page links
note /assets/..., which under the /forge/ base would leave the forge.
text tfgxi "galaxy/index.html"
text tfgxc "galaxy/galaxy.css"
text tfgxt "galaxy/tokens.css"
text tfpgx "/galaxy"
text tfpgxs "/galaxy/"
text tfpgxc "/assets/galaxy.css"
text tfpgxt "/assets/tokens.css"
text tfgxhtm "text/html; charset=utf-8"
text tfgxcc "public, max-age=30"
note fgxpath: ffile = <data><t>
fn fgxpath t view uchar * to void
put ffilel 0 0
for i ulong len tfdata bound 128
ffilc get tfdata i
end
for k ulong len t bound 128
ffilc get t k
end
end
note fgxhas: the request came through base "/" and the page file is readable
fn fgxhas to bool
if ne get fbasel 0 1
ret false
end
fgxpath tfgxi
ret eq faccess ffile 0 get ffilel 0 4 0
end
note fgxsend: stream one galaxy file (kind 3; a missing file is 404). GET only.
fn fgxsend t view uchar * ct view uchar * to long
if not fget
ret 405
end
fgxpath t
put fobl 0 0
put fkind 0 3
fsetct ct
fsetcc tfgxcc
ret 200
end
note ---- path safety: 1 = safe. Refuses NUL / control / backslash, "//", "." and ".." segments
note (raw or %2e-encoded), and any %2f / %5c / %00 (encoded separators and NUL).
fn fsegdot a ulong e ulong to bool
n = sub e a
if eq n 1
ret eq fpathat a 46
end
if eq n 2
ret and eq fpathat a 46 eq fpathat add a 1 46
end
ret false
end
fn fpctbad i ulong to bool
if ne fpathat i 37
ret false
end
h = flow fpathat add i 1
l = flow fpathat add i 2
if and eq h 50 eq l 101
ret true
end
if and eq h 50 eq l 102
ret true
end
if and eq h 53 eq l 99
ret true
end
ret and eq h 48 eq l 48
end
fn fpathok to bool
n = get fpathl 0
if or eq n 0 ge n 4096
ret false
end
if ne fpathat 0 47
ret false
end
s = ulong 1
for i ulong n bound 4096
c = fpathat i
if or lt c 32 eq c 127
ret false
end
if eq c 92
ret false
end
if fpctbad i
ret false
end
if and gt i 0 eq c 47
if eq s i
ret false
end
if fsegdot s i
ret false
end
s = add i 1
end
end
if fsegdot s n
ret false
end
ret true
end
note ---- path segments: fseg0 / fseg1 fill fown and frepo; frest gets the remainder
fn fsegend a ulong to ulong
n = get fpathl 0
j = a
while lt j n bound 4096
if eq fpathat j 47
ret j
end
j = add j 1
end
ret n
end
note fsplit: 0 = "/", 1 = "/<a>", 2 = "/<a>/<b>[...]"; returns 9 when a segment is too long
fn fsplit to ulong
put fownl 0 0
put frepol 0 0
put frestl 0 0
n = get fpathl 0
if le n 1
ret 0
end
e1 = fsegend 1
if gt sub e1 1 63
ret 9
end
for i ulong sub e1 1 bound 64
put fown i fpathat add 1 i
end
put fownl 0 sub e1 1
if ge add e1 1 n
ret 1
end
e2 = fsegend add e1 1
if gt sub sub e2 e1 1 127
ret 9
end
for i ulong sub sub e2 e1 1 bound 128
put frepo i fpathat add add e1 1 i
end
put frepol 0 sub sub e2 e1 1
if gt sub n e2 4095
ret 9
end
for i ulong sub n e2 bound 4096
put frest i fpathat add e2 i
end
put frestl 0 sub n e2
ret 2
end
fn fowneq t view uchar * to bool
if ne len t get fownl 0
ret false
end
for i ulong len t bound 64
if ne get t i get fown i
ret false
end
end
ret true
end
fn frepoeq t view uchar * to bool
if ne len t get frepol 0
ret false
end
for i ulong len t bound 128
if ne get t i get frepo i
ret false
end
end
ret true
end
note fseg1: frest's first segment is exactly t (t starts with /)
fn fseg1 t view uchar * to bool
if not frstpre t
ret false
end
n = len t
if eq n get frestl 0
ret true
end
ret eq get frest n 47
end
note fgologin: 303 to <base>login (a write without a session; the social slice claims it when signed in)
fn fgologin to long
flocb
floct tfrsv9
put fkind 0 2
ret 303
end
text tfwfol "follow"
text tfwufol "unfollow"
text tfwstar "/star"
text tfwfav "/fav"
text tfwust "/unstar"
text tfwufav "/unfav"
note fwrsess: an unclaimed social write path: POST goes to sign-in, other methods are 405
fn fwrsess to long
if eq get fmeth 0 3
ret fgologin
end
ret 405
end
fn fiswr2 to bool
if or fseg1 tfwstar fseg1 tfwfav
ret true
end
ret or fseg1 tfwust fseg1 tfwufav
end
note fcomone: reserved one-segment forge pages that are not served yet answer 501
fn fcomone to bool
if or or fowneq tfrsv9 fowneq tfrsv10 fowneq tfrsv12
ret true
end
ret or or fowneq tfrsv13 fowneq tfrsv15 or fowneq tfrsv16 fowneq tfrsv8
end
fn fisown to bool
ret fowneq tfowner
end
fn frsv1 to bool
if or or fowneq tfrsv1 fowneq tfrsv2 fowneq tfrsv3
ret true
end
if or or fowneq tfrsv4 fowneq tfrsv5 fowneq tfrsv6
ret true
end
if or or fowneq tfrsv7 fowneq tfrsv8 fowneq tfrsv9
ret true
end
ret or fowneq tfrsv10 fowneq tfrsv11
end
fn frsv2 to bool
if or or fowneq tfrsv12 fowneq tfrsv13 fowneq tfrsv14
ret true
end
if or or fowneq tfrsv15 fowneq tfrsv16 fowneq tfrsv17
ret true
end
ret or or fowneq tfrsv18 fowneq tfrsv19 fowneq tfrsv20
end
fn freserved to bool
if frsv1
ret true
end
ret frsv2
end
note fsetrepo: owner must be the delegate and repo in the allow-list; fills fridx / frid
fn fsetrepo to bool
put fridx 0 9999
put fridl 0 0
if not fisown
ret false
end
i = frepoix
if ge i get fan 0
ret false
end
put fridx 0 i
l = get fail i
for k ulong l bound 64
put frid k fridbyte i k
end
put fridl 0 l
ret true
end
note ---- /rad:<RID>[/rest] -> 302 to /<owner>/<name>[/rest] when public, else 404. Only a project
note that has an old Radicle id (fhasal) answers to one: in the store-reading build the key of a
note project without one is its git id, which is never a /rad: link.
fn fridat i ulong to bool
l = get fail i
if ne get fownl 0 add l 4
ret false
end
for k ulong l bound 64
if ne fridbyte i k get fown add k 4
ret false
end
end
ret true
end
fn fradredir to long
if not fpre tfprad
ret 0
end
for i ulong get fan 0 bound 64
if and fhasal i fridat i
fradloc i
ret 302
end
end
ret 404
end
fn fradloc i ulong to void
flocb
floct tfowner
flocc 47
for k ulong get fanl i bound 128
flocc frnbyte i k
end
a = add 1 get fownl 0
n = sub get fpathl 0 a
for k ulong n bound 4096
flocc fpathat add a k
end
fqsloc
put fkind 0 2
end
fn fqsloc to void
if eq get fqsl 0 0
ret
end
flocc 63
for k ulong get fqsl 0 bound 4096
flocc get fqs k
end
end
note fslashrd: /<o>/<r>/ (lone trailing slash) -> 301 to /<o>/<r>, query kept
fn fslashrd to long
flocb
floct tfowner
flocc 47
i = get fridx 0
for k ulong get fanl i bound 128
flocc frnbyte i k
end
fqsloc
put fkind 0 2
ret 301
end
note ---- the dispatcher. Returns the HTTP status; fob / fkind are filled.
fn fslices to long
r = qnroute
if ne r 0
ret r
end
r = grroute
if ne r 0
ret r
end
r = soroute
if ne r 0
ret r
end
r = dlroute
if ne r 0
ret r
end
r = coroute
if ne r 0
ret r
end
ret brroute
end
fn fget to bool
ret eq get fmeth 0 1
end
note forigeq: the Origin header equals t exactly
fn forigeq t view uchar * to bool
if ne get forigl 0 len t
ret false
end
for i ulong len t bound 256
if ne get forig i get t i
ret false
end
end
ret true
end
note forigok: a POST carries no Origin (the CSRF token still decides) or one of the two public origins
fn forigok to bool
if eq get forigl 0 0
ret true
end
if forigeq tforg1
ret true
end
ret forigeq tforg2
end
fn froute to long
if not fpathok
ret 400
end
if and eq get fmeth 0 3 not forigok
ret 403
end
r = slroute
if ne r 0
ret r
end
r = cm_route
if ne r 0
ret r
end
r = ohroute
if ne r 0
ret r
end
note the research pages and questions (research/route.om); before the split, which reads
note /research/<slug> as an owner and a repository
r = rxroute
if ne r 0
ret r
end
sg = fsplit
if eq sg 9
ret 404
end
put fridx 0 9999
note /galaxy/ (with the slash) is the same page as /galaxy; asked for before the segment count
note decides, because the split reads it as an owner with an empty repository
if fpeq tfpgxs
if fgxhas
ret fgxsend tfgxi tfgxhtm
end
end
if eq sg 0
ret fpgroot
end
if eq sg 1
ret fpgone
end
r = fradredir
if ne r 0
ret r
end
if freserved
ret fslices0
end
if not fsetrepo
r = fjsfx
if ne r 0
ret r
end
ret fnorepo
end
if eq get frestl 0 1
ret fslashrd
end
if and fget eq get frestl 0 0
fzprep
if fjwant
fjrepo
ret 200
end
end
r = fslices
if ne r 0
ret r
end
if and fget eq get frestl 0 0
frepohome
ret 200
end
if fiswr2
ret fwrsess
end
if fcoming
ret 501
end
ret 404
end
note fnorepo: /<o>/<x> where x is not a public repo: the social slice may claim it (follow); else 404
fn fnorepo to long
put fridx 0 9999
r = soroute
if ne r 0
ret r
end
if not fisown
ret 404
end
if ne get frestl 0 0
ret 404
end
if or frepoeq tfwfol frepoeq tfwufol
ret fwrsess
end
ret 404
end

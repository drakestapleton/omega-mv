note forged server/main.om: listen on 127.0.0.1:18480, read each request into the contract
note globals, dispatch (route.om), write the response (layout for kind 0), log one access line.
note Reload: between connections forged re-reads the allow-list and the social log when the
note RIDS.md mtime changes or the flag file ~/forge-data/reload exists (run.sh turns SIGHUP into it).
note Restart: when the flag file ~/forge-data/restart exists, forged removes it and exits 0 after the
note connection it is serving; the supervisor, which holds the listener, then starts the next forged
note on the same socket. A flag left from an earlier run is removed at start.
text tfget "GET"
text tfheadm "HEAD"
text tfpost "POST"
text tfhxb "x-forge-base"
text tfhck "cookie"
text tfhrip "x-real-ip"
text tfhinm "if-none-match"
text tfhorg "origin"
text tfhua "user-agent"
text tfhrf "referer"
text tfhacc "accept"
text tfforge "/forge/"
text tflocal "127.0.0.1"
text tfrlflag "reload"
text tfrsflag "restart"
text tfrsreq "forged: restart requested by the supervisor; exiting between connections\n"
text tfnctype "Content-Type"
text tfnloc "Location"
text tfncd "Content-Disposition"
text tfnsck "Set-Cookie"
text tfnetag "ETag"
text tfncc "Cache-Control"
text tfncsp "Content-Security-Policy"
text tfnxcto "X-Content-Type-Options"
text tfnref "Referrer-Policy"
text tfcsp "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
text tfnosnf "nosniff"
text tfsameo "same-origin"
text tfnostor "no-store"
text tfcspsb "sandbox; default-src 'none'; script-src 'none'; img-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
text tfnra "Retry-After"
text tfhtml "text/html; charset=utf-8"
text tfsplain "text/plain; charset=utf-8"
text tfoctet "application/octet-stream"
text tfstart "forged: listening on 127.0.0.1:18480, public repos "
text tfnolist "forged: cannot listen on 127.0.0.1:18480\n"
text tfinharg "--inherited-listener"
text tfinhok "forged: serving the listener inherited from the supervisor on descriptor 0 (checked: IPv4 stream, 127.0.0.1, compiled port)\n"
text tfinhbad "forged: refusing the inherited listener: descriptor 0 is not the IPv4 stream listener on 127.0.0.1 and the compiled port\n"
text tfrld "forged: reloaded, public repos "
text tfnl "\n"
note ---- request capture
fn fhcopy cs edit ulong 320 io edit uchar 131072 nm view uchar * w ulong to bool
i = hhfind cs io nm
if lt i 0
ret false
end
o = hhvoff cs ulong i
l = hhvlen cs ulong i
for k ulong hmin l 4096 bound 4096
fhput w k get io add o k
end
fhlen w l
ret true
end
note fhput / fhlen: w 0 base, 1 cookie, 2 ip, 3 if-none-match, 4 origin, 5 user agent, 6 referrer, 7 accept
note (silently capped; 5 and 6 at 200 bytes, they are only logged)
fn fhput w ulong k ulong c uchar to void
if and eq w 0 lt k 64
put fbase k c
end
if and eq w 1 lt k 4096
put fck k c
end
if and eq w 2 lt k 64
put fip k c
end
if and eq w 3 lt k 256
put finm k c
end
if and eq w 4 lt k 256
put forig k c
end
if and eq w 5 lt k 200
put fag k c
end
if and eq w 6 lt k 200
put frf k c
end
if and eq w 7 lt k 512
put facc k c
end
end
fn fhlen w ulong l ulong to void
if eq w 0
put fbasel 0 hmin l 64
end
if eq w 1
put fckl 0 hmin l 4096
end
if eq w 2
put fipl 0 hmin l 64
end
if eq w 3
put finml 0 hmin l 256
end
if eq w 4
put forigl 0 hmin l 256
end
if eq w 5
put fagl 0 hmin l 200
end
if eq w 6
put frfl 0 hmin l 200
end
if eq w 7
put faccl 0 hmin l 512
end
end
note fbasefix: only "/" and "/forge/" are accepted; anything else becomes "/"
fn fbasefix to void
ok = false
if eq get fbasel 0 7
ok = true
for i ulong 7
if ne get fbase i get tfforge i
ok = false
end
end
end
if not ok
put fbase 0 47
put fbasel 0 1
end
end
fn freqhdr cs edit ulong 320 io edit uchar 131072 to void
put fbasel 0 0
put fckl 0 0
put fipl 0 0
put finml 0 0
put forigl 0 0
put fagl 0 0
put frfl 0 0
put faccl 0 0
x = fhcopy cs io tfhxb 0
x = fhcopy cs io tfhck 1
x = fhcopy cs io tfhrip 2
x = fhcopy cs io tfhinm 3
x = fhcopy cs io tfhorg 4
x = fhcopy cs io tfhua 5
x = fhcopy cs io tfhrf 6
x = fhcopy cs io tfhacc 7
fbasefix
if eq get fipl 0 0
for i ulong len tflocal
put fip i get tflocal i
end
put fipl 0 len tflocal
end
if gt get fckl 0 4095
put fckl 0 0
end
end
note freqtgt: split the request target into fpath and fqs; false when it is not origin-form or too long
fn freqtgt cs edit ulong 320 io edit uchar 131072 to bool
o = get cs HTOFF
l = get cs HTLEN
put fpathl 0 0
put fqsl 0 0
if or eq l 0 gt l 8000
ret false
end
if ne get io o 47
ret false
end
q = l
for i ulong l bound 8192
if eq get io add o i 63
q = i
break
end
end
if gt q 4095
ret false
end
for i ulong q bound 4096
put fpath i get io add o i
end
put fpathl 0 q
if lt q l
r = sub sub l q 1
if gt r 4095
ret false
end
for i ulong r bound 4096
put fqs i get io add add o q add 1 i
end
put fqsl 0 r
end
ret true
end
fn freqmeth cs edit ulong 320 io edit uchar 131072 to void
put fmeth 0 0
if or hismeth cs io tfget hismeth cs io tfheadm
put fmeth 0 1
end
if hismeth cs io tfpost
put fmeth 0 3
end
end
note freqbody: read a POST body (cap 64 KiB) into fbody; returns 0 or the status to answer. The one
note path with a larger body, .../patches/new, goes through freqbig into fbig (cap 3 MiB).
fn freqbody cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to ulong
put fbodyl 0 0
put fbigl 0 0
if ne get fmeth 0 3
ret 0
end
if fbigrt
ret freqbig cs io bd
end
put cs HBCAP 65536
n = hbodyall cs io bd
if lt n 0
if eq n HEBIG
ret 413
end
ret 400
end
for i ulong ulong n bound 65536
put fbody i get bd i
end
put fbodyl 0 ulong n
ret 0
end
text tfpnew "/patches/new"
note fbigrt: the request path ends in /patches/new
fn fbigrt to bool
n = get fpathl 0
m = len tfpnew
if lt n m
ret false
end
for i ulong m bound 16
if ne get fpath add sub n m i get tfpnew i
ret false
end
end
ret true
end
note freqbig: the body into fbig through the 64 KiB chunk bd; 413 when it passes 3 MiB
fn freqbig cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to ulong
put cs HBCAP 3145728
got = ulong 0
for it ulong 4194304
r = hbodyrd cs io bd
if lt r 0
if eq r HEBIG
ret 413
end
ret 400
end
if eq r 0
put fbigl 0 got
ret 0
end
if gt add got ulong r len fbig
put cs HKEEP 0
ret 413
end
for i ulong ulong r bound 65536
put fbig add got i get bd i
end
got = add got ulong r
end
put cs HKEEP 0
ret 413
end
fn fresetr to void
put fobl 0 0
put fobtr 0 0
put ftxmore 0 0
put fovf 0 0
put ficut 0 0
put fkind 0 0
put fctl 0 0
put fcdl 0 0
put fsckl 0 0
put flocl 0 0
put ftil 0 0
put ffilel 0 0
put fetagl 0 0
put fccl 0 0
put fuserl 0 0
put fcsrfl 0 0
put fql 0 0
put fridx 0 9999
put fridl 0 0
put fownl 0 0
put frepol 0 0
put frestl 0 0
put fretry 0 0
put fcspsb 0 0
put fmvng 0 0
put fjalt 0 0
end
note ---- response writing
note fgv: copy response header global w into d; returns the length.
note w 0 fct, 1 floc, 2 fcd, 3 fsck, 4 fetag, 5 fcc
fn fgvb w ulong k ulong to uchar
if eq w 0
ret get fct k
end
if eq w 1
ret get floc k
end
if eq w 2
ret get fcd k
end
if eq w 3
ret get fsck k
end
if eq w 4
ret get fetag k
end
ret get fcc k
end
fn fgvl w ulong to ulong
if eq w 0
ret get fctl 0
end
if eq w 1
ret get flocl 0
end
if eq w 2
ret get fcdl 0
end
if eq w 3
ret get fsckl 0
end
if eq w 4
ret get fetagl 0
end
ret get fccl 0
end
fn fhdrg cs edit ulong 320 io edit uchar 131072 nm view uchar * w ulong to long
n = fgvl w
if eq n 0
ret 0
end
d = new uchar 4096 0
for k ulong n bound 4096
put d k fgvb w k
end
r = hhname cs io nm
ret hfe r hhval cs io view part d 0 n
end
fn fhdrt cs edit ulong 320 io edit uchar 131072 nm view uchar * v view uchar * to long
r = hhname cs io nm
ret hfe r hhval cs io v
end
fn fsechdr cs edit ulong 320 io edit uchar 131072 to long
r = long 0
if eq get fcspsb 0 0
r = fhdrt cs io tfncsp tfcsp
else
r = fhdrt cs io tfncsp tfcspsb
end
r = hfe r fhdrt cs io tfnxcto tfnosnf
r = hfe r fhdrt cs io tfnref tfsameo
r = hfe r fhdrg cs io tfnsck 3
if ne get fretry 0 0
r = hfe r hhname cs io tfnra
r = hfe r hhnum cs io get fretry 0
end
ret r
end
fn fcchdr cs edit ulong 320 io edit uchar 131072 to long
if eq get fccl 0 0
ret fhdrt cs io tfncc tfnostor
end
ret fhdrg cs io tfncc 5
end
fn fobcp ch edit uchar 32768 b ulong m ulong to void
for k ulong m bound 32768
put ch k get fob add b k
end
end
note fsendr: send fob[a, a+n) through a 32 KiB chunk
fn fsendr cs edit ulong 320 io edit uchar 131072 a ulong n ulong to long
ch = new uchar 32768 0
p = ulong 0
r = long 0
for it ulong 1000
if ge p n
break
end
m = hmin sub n p 32768
fobcp ch add a p m
r = hfe r hput cs io view part ch 0 m
if lt r 0
ret r
end
p = add p m
end
ret r
end
note kind 0: the fragment is fob[0,L); flayout (server/pages.om, called by fsend) appended fhead and
note ffoot after it; they are sent around it. Each part goes out through ftrrun (server/tr.om), which
note adds the translation hints; a first pass counts the bytes for Content-Length. With the query
note format=text the page's fragment is sent as plain text instead (ftxsend, server/tr.om).
fn fsend0 cs edit ulong 320 io edit uchar 131072 st ulong to long
l = get flay 0
lh = add l get flay 1
lf = add lh get flay 2
if ftxwant
ret ftxsend cs io st l
end
n = ulong ftrrun cs io l lh 0
n = add n ulong ftrrun cs io 0 l 0
n = add n ulong ftrrun cs io lh lf 0
r = hrspst cs io st
r = hfe r fhdrt cs io tfnctype tfhtml
r = hfe r fsechdr cs io
r = hfe r fhdrt cs io tfncc tfnostor
r = hfe r hhend cs io 0 n
r = hfe r ftrrun cs io l lh 1
r = hfe r ftrrun cs io 0 l 1
r = hfe r ftrrun cs io lh lf 1
ret hfe r hwfin cs io
end
fn fsend1 cs edit ulong 320 io edit uchar 131072 st ulong to long
r = hrspst cs io st
if ne st 304
if eq get fctl 0 0
fsetct tfoctet
end
r = hfe r fhdrg cs io tfnctype 0
end
r = hfe r fsechdr cs io
r = hfe r fhdrg cs io tfncd 2
r = hfe r fhdrg cs io tfnetag 4
r = hfe r fcchdr cs io
if eq st 304
r = hfe r hhend cs io 0 0
ret hfe r hwfin cs io
end
r = hfe r hhend cs io 0 get fobl 0
r = hfe r fsendr cs io 0 get fobl 0
ret hfe r hwfin cs io
end
fn fsend2 cs edit ulong 320 io edit uchar 131072 st ulong to long
r = hrspst cs io st
r = hfe r fhdrg cs io tfnloc 1
r = hfe r fsechdr cs io
r = hfe r fhdrt cs io tfncc tfnostor
r = hfe r hhend cs io 0 0
ret hfe r hwfin cs io
end
note kind 3: stream ffile (cap 512 MiB); a missing file is 404
fn fsend3 cs edit ulong 320 io edit uchar 131072 st ulong to long
fd = fopen ffile 0 get ffilel 0 524288 0
if lt fd 0
put fkind 0 0
put fobl 0 0
ret fsend cs io 404
end
r = fstat int fd fstb 0 128
sz = ulong 0
for i ulong 8
sz = or sz shl ulong get fstb add 48 i mul i 8
end
if or lt r 0 gt sz 536870912
x = fclose int fd
put fkind 0 0
put fobl 0 0
ret fsend cs io 500
end
r = fsend3h cs io st sz
r = hfe r fsend3b cs io int fd sz
x = fclose int fd
ret hfe r hwfin cs io
end
fn fsend3h cs edit ulong 320 io edit uchar 131072 st ulong sz ulong to long
r = hrspst cs io st
if eq get fctl 0 0
fsetct tfoctet
end
r = hfe r fhdrg cs io tfnctype 0
r = hfe r fsechdr cs io
r = hfe r fhdrg cs io tfncd 2
r = hfe r fhdrg cs io tfnetag 4
r = hfe r fcchdr cs io
ret hfe r hhend cs io 0 sz
end
note fsend3b: the response deadline (60 s, armed by fsend) moves out by 1 s per 128 KiB sent, so a
note client reading slower than 128 KiB/s on average is cut off (P2-1: one connection at a time)
fn fsendl cs edit ulong 320 t0 ulong p ulong to void
s = mul div p 131072 1000000000
put cs HDL add t0 add 60000000000 s
end
fn fsend3b cs edit ulong 320 io edit uchar 131072 fd int sz ulong to long
ch = new uchar 65536 0
p = ulong 0
t0 = ulong monons
for it ulong 100000
if ge p sz
ret 0
end
n = read fd ch 0 65536
if le n 0
put cs HKEEP 0
ret -5
end
m = hmin ulong n sub sz p
r = hput cs io view part ch 0 m
if lt r 0
ret r
end
p = add p m
fsendl cs t0 p
end
ret 0
end
note fsend4: kind 4, a body too large for the capture: run the argv the handler left in fpk and send
note its stdout as a chunked body (git output above fxo's 16 MiB, e.g. the .diff of a huge commit).
note The handler ran it once already (status known); a failure after the head closes the connection
note without the last chunk, so the client sees a cut body, never a silently short one.
fn fsend4 cs edit ulong 320 io edit uchar 131072 st ulong to long
r = pipefds fpfd 0 8 524288
if lt r 0
put fkind 0 0
ret fsend cs io 500
end
rfd = fpfdv 0
wfd = fpfdv 1
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
put fkind 0 0
ret fsend cs io 500
end
if eq pid 0
x = fclose rfd
fchild wfd
exit 127
end
x = fclose wfd
dl = add long monons 120000000000
r = hrspst cs io st
r = hfe r fhdrg cs io tfnctype 0
r = hfe r fsechdr cs io
r = hfe r fcchdr cs io
r = hfe r hhend cs io 1 0
if ge r 0
r = fsend4b cs io rfd dl
end
x = fclose rfd
if lt r 0
x = killpid int pid 9
end
s = freap int pid dl
if and ge r 0 ne s 0
r = -5
end
if lt r 0
put cs HKEEP 0
ret r
end
ret hwfin cs io
end
fn fsend4b cs edit ulong 320 io edit uchar 131072 fd int dl long to long
ch = new uchar 65536 0
p = ulong 0
t0 = ulong monons
for it ulong 100000000
left = sub dl long monons
if le left 0
ret -5
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret -5
end
continue
end
if eq w 0
continue
end
n = read fd ch 0 65536
if eq n 0
ret 0
end
if lt n 0
if or eq n -4 eq n -11
continue
end
ret -5
end
r = hput cs io view part ch 0 ulong n
if lt r 0
ret r
end
p = add p ulong n
fsendl cs t0 p
end
ret -5
end
note kind 5: a generated shelf, streamed in bounded batches from ohbody (open/route.om).
note Neither HTML nor JSON has a whole-response buffer or length limit. hhend mode 1 asks the
note HTTP writer for chunked framing; hwfin writes the final zero chunk only after a clean EOF.
note On a later read/send error close without that final chunk: a client must see an incomplete
note response, never a successfully shorter shelf. Translation runs on each complete HTML batch.
fn fsend5 cs edit ulong 320 io edit uchar 131072 st ulong to long
more = ohbody
if ne get fobtr 0 0
ohbodyend
put fobl 0 0
put fobtr 0 0
put fkind 0 0
ret fsend cs io 500
end
r = hrspst cs io st
if and eq get gobody 1 0 ftxwant
r = hfe r fhdrt cs io tfnctype tfsplain
else
r = hfe r fhdrg cs io tfnctype 0
end
r = hfe r fsechdr cs io
r = hfe r fhdrt cs io tfncc tfnostor
r = hfe r hhend cs io 1 0
put ftxmore 0 0
p = ulong 0
t0 = ulong monons
while and more ge r 0 bound 9223372036854775807
if ne get gobody 1 0
r = fsendr cs io 0 get fobl 0
else
if ftxwant
r = ftxrun cs io get fobl 0 1
put ftxmore 0 1
else
r = ftrrun cs io 0 get fobl 0 1
end
end
p = add p get fobl 0
fsendl cs t0 p
if lt r 0
break
end
more = ohbody
if ne get fobtr 0 0
r = -5
break
end
end
ohbodyend
put ftxmore 0 0
if lt r 0
put cs HKEEP 0
ret r
end
ret hwfin cs io
end
fn fsend cs edit ulong 320 io edit uchar 131072 st ulong to long
hsetdl cs 60000000000
s = st
k = get fkind 0
if and ge s 400 and eq k 0 eq get fobl 0 0
ferrpage s
k = get fkind 0
end
note Kinds 0, 1 and 2 are sent from buffers a handler filled (fob, floc). Before the first header:
note when a byte was dropped (fobtr), the cut response is thrown away and a whole 500 is sent in its
note place (fovfl). Kinds 3 and 4 stream a file or a command; kind 5 generates bounded batches in
note fob and streams them, so it does not build a whole response here.
if eq k 0
flayout
end
if le k 2
if fovfany
fovfl
s = 500
k = get fkind 0
note the notice itself is about 1,400 bytes as a page and under 300 as JSON, so it fits the 8 MiB
note fob; should a build with a smaller fob not hold it, the 500 goes out with an empty body
if ne get fobtr 0 0
put fobtr 0 0
put fobl 0 0
put fctl 0 0
put fkind 0 1
k = 1
end
end
end
if eq k 1
ret fsend1 cs io s
end
if eq k 2
ret fsend2 cs io s
end
if eq k 3
ret fsend3 cs io s
end
if eq k 4
ret fsend4 cs io s
end
if eq k 5
ret fsend5 cs io s
end
ret fsend0 cs io s
end
note ---- access log: "<epoch> <ip> <method> <path> <status> <bytes> <ms> <agent> <referrer>"
note agent and referrer are the request's User-Agent and Referer, at most 200 bytes each, "-" when
note absent; a space is written as "+", so a line always has nine fields
global flg uchar 8192
global flgl ulong 1
fn flgc c uchar to void
n = get flgl 0
if lt n 8191
put flg n c
put flgl 0 add n 1
end
end
fn flgn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
flgc get d add i k
end
end
fn flgs c uchar to void
if or lt c 33 gt c 126
flgc 63
ret
end
flgc c
end
note flga: one byte of an agent or referrer; a space becomes "+", the rest goes through flgs
fn flga c uchar to void
if eq c 32
flgc 43
ret
end
flgs c
end
fn flogreq st ulong tz long to void
put flgl 0 0
flgn div ulong realns 1000000000
flgc 32
for i ulong get fipl 0 bound 64
flgs get fip i
end
flgc 32
flgn get fmeth 0
flgc 32
for i ulong hmin get fpathl 0 512 bound 512
flgs get fpath i
end
flgc 32
flgn st
flgc 32
flgn get fobl 0
flgc 32
flgn div ulong sub long monons tz 1000000
flgc 32
if eq get fagl 0 0
flgc 45
end
for i ulong get fagl 0 bound 200
flga get fag i
end
flgc 32
if eq get frfl 0 0
flgc 45
end
for i ulong get frfl 0 bound 200
flga get frf i
end
flgc 10
w = write 2 flg 0 get flgl 0
end
note ---- one request
fn fhandle cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to long
tz = long monons
fresetr
freqmeth cs io
freqhdr cs io
st = ulong 0
if not freqtgt cs io
st = 400
end
if eq st 0
st = freqbody cs io bd
end
if eq st 0
if eq get fmeth 0 0
st = 405
end
end
if eq st 0
x = sosess
st = ulong froute
end
r = fsend cs io st
note the access log names the status that was sent
if ne get fovf 0 0
st = 500
end
flogreq st tz
ret r
end
fn fserve c int cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to void
r = hinit cs io c 1
if lt r 0
x = fclose c
ret
end
hsettmo cs 15000000000 15000000000
hsetbdl cs 60000000000
note http.om refuses a Content-Length above HBCAP when it reads the head (413), before the path is
note known here: the head-time cap is the patch intake's 3 MiB, and freqbody sets 64 KiB for every
note other POST before it reads the body
put cs HBCAP 3145728
for k ulong 100
r = hreqrd cs io
if le r 0
if lt r 0
x = hreject cs io r
end
break
end
r = fhandle cs io bd
put cs HBCAP 3145728
if lt r 0
break
end
if eq hnext cs io 0
break
end
end
r = hclose cs
end
note ---- reload: allow-list + social log. fload gives a negative count when the source could not be
note read or was refused (fan is 0, every repository URL is 404); the log line then says 0. Before
note 2026-11-13 the negative count went through `ulong n`, which traps 5 (exit 105), so an unreadable
note RIDS.md stopped forged instead of serving nothing.
fn freload to void
n = fload
fzload
x = soload
flog tfrld
put flgl 0 0
c = ulong 0
if gt n 0
c = ulong n
end
flgn c
flgc 10
w = write 2 flg 0 get flgl 0
end
fn fflagp to void
fpb
fpt tfdata
fpt tfrlflag
end
fn fchkrl to void
fflagp
r = stat fpth 0 get fpthl 0 fstb 0 128
if ge r 0
x = unlink fpth 0 get fpthl 0
freload
ret
end
if fsrcchg
freload
end
end
note frsreq: true when the supervisor has asked for a restart (the flag file exists); removes it.
fn frsreq to bool
fpb
fpt tfdata
fpt tfrsflag
r = stat fpth 0 get fpthl 0 fstb 0 128
if lt r 0
ret false

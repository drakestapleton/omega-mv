note forged server/main.om: listen on 127.0.0.1:18480, read each request into the contract
note globals, dispatch (route.om), write the response (layout for kind 0), log one access line.
note Reload: between connections forged re-reads the allow-list and the social log when the
note RIDS.md mtime changes or the flag file ~/forge-data/reload exists (run.sh turns SIGHUP into it).
text tfget "GET"
text tfheadm "HEAD"
text tfpost "POST"
text tfhxb "x-forge-base"
text tfhck "cookie"
text tfhrip "x-real-ip"
text tfhinm "if-none-match"
text tfhorg "origin"
text tfforge "/forge/"
text tflocal "127.0.0.1"
text tfrlflag "reload"
text tfnctype "Content-Type"
text tfnloc "Location"
text tfncd "Content-Disposition"
text tfnsck "Set-Cookie"
text tfnetag "ETag"
text tfncc "Cache-Control"
text tfncsp "Content-Security-Policy"
text tfnxcto "X-Content-Type-Options"
text tfnref "Referrer-Policy"
text tfcsp "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
text tfnosnf "nosniff"
text tfsameo "same-origin"
text tfnostor "no-store"
text tfcspsb "sandbox; default-src 'none'; img-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
text tfnra "Retry-After"
text tfhtml "text/html; charset=utf-8"
text tfoctet "application/octet-stream"
text tfstart "forged: listening on 127.0.0.1:18480, public repos "
text tfnolist "forged: cannot listen on 127.0.0.1:18480\n"
text tfrld "forged: reloaded, public repos "
text tfnl "\n"
note ---- request capture
fn fhcopy cs edit ulong 320 io edit uchar 131072 nm view uchar * w ulong to bool
i = hhfind cs io nm
if lt i 0
ret false
end
o = hhvoff cs ulong i
l = hhvlen cs ulong i
for k ulong hmin l 4096 bound 4096
fhput w k get io add o k
end
fhlen w l
ret true
end
note fhput / fhlen: w 0 base, 1 cookie, 2 ip, 3 if-none-match, 4 origin (silently capped)
fn fhput w ulong k ulong c uchar to void
if and eq w 0 lt k 64
put fbase k c
end
if and eq w 1 lt k 4096
put fck k c
end
if and eq w 2 lt k 64
put fip k c
end
if and eq w 3 lt k 256
put finm k c
end
if and eq w 4 lt k 256
put forig k c
end
end
fn fhlen w ulong l ulong to void
if eq w 0
put fbasel 0 hmin l 64
end
if eq w 1
put fckl 0 hmin l 4096
end
if eq w 2
put fipl 0 hmin l 64
end
if eq w 3
put finml 0 hmin l 256
end
if eq w 4
put forigl 0 hmin l 256
end
end
note fbasefix: only "/" and "/forge/" are accepted; anything else becomes "/"
fn fbasefix to void
ok = false
if eq get fbasel 0 7
ok = true
for i ulong 7
if ne get fbase i get tfforge i
ok = false
end
end
end
if not ok
put fbase 0 47
put fbasel 0 1
end
end
fn freqhdr cs edit ulong 320 io edit uchar 131072 to void
put fbasel 0 0
put fckl 0 0
put fipl 0 0
put finml 0 0
put forigl 0 0
x = fhcopy cs io tfhxb 0
x = fhcopy cs io tfhck 1
x = fhcopy cs io tfhrip 2
x = fhcopy cs io tfhinm 3
x = fhcopy cs io tfhorg 4
fbasefix
if eq get fipl 0 0
for i ulong len tflocal
put fip i get tflocal i
end
put fipl 0 len tflocal
end
if gt get fckl 0 4095
put fckl 0 0
end
end
note freqtgt: split the request target into fpath and fqs; false when it is not origin-form or too long
fn freqtgt cs edit ulong 320 io edit uchar 131072 to bool
o = get cs HTOFF
l = get cs HTLEN
put fpathl 0 0
put fqsl 0 0
if or eq l 0 gt l 8000
ret false
end
if ne get io o 47
ret false
end
q = l
for i ulong l bound 8192
if eq get io add o i 63
q = i
break
end
end
if gt q 4095
ret false
end
for i ulong q bound 4096
put fpath i get io add o i
end
put fpathl 0 q
if lt q l
r = sub sub l q 1
if gt r 4095
ret false
end
for i ulong r bound 4096
put fqs i get io add add o q add 1 i
end
put fqsl 0 r
end
ret true
end
fn freqmeth cs edit ulong 320 io edit uchar 131072 to void
put fmeth 0 0
if or hismeth cs io tfget hismeth cs io tfheadm
put fmeth 0 1
end
if hismeth cs io tfpost
put fmeth 0 3
end
end
note freqbody: read a POST body (cap 64 KiB) into fbody; returns 0 or the status to answer
fn freqbody cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to ulong
put fbodyl 0 0
if ne get fmeth 0 3
ret 0
end
put cs HBCAP 65536
n = hbodyall cs io bd
if lt n 0
if eq n HEBIG
ret 413
end
ret 400
end
for i ulong ulong n bound 65536
put fbody i get bd i
end
put fbodyl 0 ulong n
ret 0
end
fn fresetr to void
put fobl 0 0
put fobtr 0 0
put fkind 0 0
put fctl 0 0
put fcdl 0 0
put fsckl 0 0
put flocl 0 0
put ftil 0 0
put ffilel 0 0
put fetagl 0 0
put fccl 0 0
put fuserl 0 0
put fcsrfl 0 0
put fql 0 0
put fridx 0 9999
put fridl 0 0
put fownl 0 0
put frepol 0 0
put frestl 0 0
put fretry 0 0
put fcspsb 0 0
end
note ---- response writing
note fgv: copy response header global w into d; returns the length.
note w 0 fct, 1 floc, 2 fcd, 3 fsck, 4 fetag, 5 fcc
fn fgvb w ulong k ulong to uchar
if eq w 0
ret get fct k
end
if eq w 1
ret get floc k
end
if eq w 2
ret get fcd k
end
if eq w 3
ret get fsck k
end
if eq w 4
ret get fetag k
end
ret get fcc k
end
fn fgvl w ulong to ulong
if eq w 0
ret get fctl 0
end
if eq w 1
ret get flocl 0
end
if eq w 2
ret get fcdl 0
end
if eq w 3
ret get fsckl 0
end
if eq w 4
ret get fetagl 0
end
ret get fccl 0
end
fn fhdrg cs edit ulong 320 io edit uchar 131072 nm view uchar * w ulong to long
n = fgvl w
if eq n 0
ret 0
end
d = new uchar 4096 0
for k ulong n bound 4096
put d k fgvb w k
end
r = hhname cs io nm
ret hfe r hhval cs io view part d 0 n
end
fn fhdrt cs edit ulong 320 io edit uchar 131072 nm view uchar * v view uchar * to long
r = hhname cs io nm
ret hfe r hhval cs io v
end
fn fsechdr cs edit ulong 320 io edit uchar 131072 to long
r = long 0
if eq get fcspsb 0 0
r = fhdrt cs io tfncsp tfcsp
else
r = fhdrt cs io tfncsp tfcspsb
end
r = hfe r fhdrt cs io tfnxcto tfnosnf
r = hfe r fhdrt cs io tfnref tfsameo
r = hfe r fhdrg cs io tfnsck 3
if ne get fretry 0 0
r = hfe r hhname cs io tfnra
r = hfe r hhnum cs io get fretry 0
end
ret r
end
fn fcchdr cs edit ulong 320 io edit uchar 131072 to long
if eq get fccl 0 0
ret fhdrt cs io tfncc tfnostor
end
ret fhdrg cs io tfncc 5
end
fn fobcp ch edit uchar 32768 b ulong m ulong to void
for k ulong m bound 32768
put ch k get fob add b k
end
end
note fsendr: send fob[a, a+n) through a 32 KiB chunk
fn fsendr cs edit ulong 320 io edit uchar 131072 a ulong n ulong to long
ch = new uchar 32768 0
p = ulong 0
r = long 0
for it ulong 1000
if ge p n
break
end
m = hmin sub n p 32768
fobcp ch add a p m
r = hfe r hput cs io view part ch 0 m
if lt r 0
ret r
end
p = add p m
end
ret r
end
note kind 0: the fragment is fob[0,L); fhead and ffoot are appended after it and sent around it
fn fsend0 cs edit ulong 320 io edit uchar 131072 st ulong to long
l = get fobl 0
fhead
h = sub get fobl 0 l
ffoot
f = sub sub get fobl 0 l h
r = hrspst cs io st
r = hfe r fhdrt cs io tfnctype tfhtml
r = hfe r fsechdr cs io
r = hfe r fhdrt cs io tfncc tfnostor
r = hfe r hhend cs io 0 add add l h f
r = hfe r fsendr cs io l h
r = hfe r fsendr cs io 0 l
r = hfe r fsendr cs io add l h f
ret hfe r hwfin cs io
end
fn fsend1 cs edit ulong 320 io edit uchar 131072 st ulong to long
r = hrspst cs io st
if ne st 304
if eq get fctl 0 0
fsetct tfoctet
end
r = hfe r fhdrg cs io tfnctype 0
end
r = hfe r fsechdr cs io
r = hfe r fhdrg cs io tfncd 2
r = hfe r fhdrg cs io tfnetag 4
r = hfe r fcchdr cs io
if eq st 304
r = hfe r hhend cs io 0 0
ret hfe r hwfin cs io
end
r = hfe r hhend cs io 0 get fobl 0
r = hfe r fsendr cs io 0 get fobl 0
ret hfe r hwfin cs io
end
fn fsend2 cs edit ulong 320 io edit uchar 131072 st ulong to long
r = hrspst cs io st
r = hfe r fhdrg cs io tfnloc 1
r = hfe r fsechdr cs io
r = hfe r fhdrt cs io tfncc tfnostor
r = hfe r hhend cs io 0 0
ret hfe r hwfin cs io
end
note kind 3: stream ffile (cap 512 MiB); a missing file is 404
fn fsend3 cs edit ulong 320 io edit uchar 131072 st ulong to long
fd = fopen ffile 0 get ffilel 0 524288 0
if lt fd 0
ferrpage 404
ret fsend0 cs io 404
end
r = fstat int fd fstb 0 128
sz = ulong 0
for i ulong 8
sz = or sz shl ulong get fstb add 48 i mul i 8
end
if or lt r 0 gt sz 536870912
x = fclose int fd
ferrpage 500
ret fsend0 cs io 500
end
r = fsend3h cs io st sz
r = hfe r fsend3b cs io int fd sz
x = fclose int fd
ret hfe r hwfin cs io
end
fn fsend3h cs edit ulong 320 io edit uchar 131072 st ulong sz ulong to long
r = hrspst cs io st
if eq get fctl 0 0
fsetct tfoctet
end
r = hfe r fhdrg cs io tfnctype 0
r = hfe r fsechdr cs io
r = hfe r fhdrg cs io tfncd 2
r = hfe r fhdrg cs io tfnetag 4
r = hfe r fcchdr cs io
ret hfe r hhend cs io 0 sz
end
note fsend3b: the response deadline (60 s, armed by fsend) moves out by 1 s per 128 KiB sent, so a
note client reading slower than 128 KiB/s on average is cut off (P2-1: one connection at a time)
fn fsendl cs edit ulong 320 t0 ulong p ulong to void
s = mul div p 131072 1000000000
put cs HDL add t0 add 60000000000 s
end
fn fsend3b cs edit ulong 320 io edit uchar 131072 fd int sz ulong to long
ch = new uchar 65536 0
p = ulong 0
t0 = ulong monons
for it ulong 100000
if ge p sz
ret 0
end
n = read fd ch 0 65536
if le n 0
put cs HKEEP 0
ret -5
end
m = hmin ulong n sub sz p
r = hput cs io view part ch 0 m
if lt r 0
ret r
end
p = add p m
fsendl cs t0 p
end
ret 0
end
fn fsend cs edit ulong 320 io edit uchar 131072 st ulong to long
hsetdl cs 60000000000
k = get fkind 0
if and ge st 400 and eq k 0 eq get fobl 0 0
ferrpage st
end
if eq k 1
ret fsend1 cs io st
end
if eq k 2
ret fsend2 cs io st
end
if eq k 3
ret fsend3 cs io st
end
ret fsend0 cs io st
end
note ---- access log: "<epoch> <ip> <method> <path> <status> <bytes> <ms>"
global flg uchar 8192
global flgl ulong 1
fn flgc c uchar to void
n = get flgl 0
if lt n 8191
put flg n c
put flgl 0 add n 1
end
end
fn flgn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
flgc get d add i k
end
end
fn flgs c uchar to void
if or lt c 33 gt c 126
flgc 63
ret
end
flgc c
end
fn flogreq st ulong tz long to void
put flgl 0 0
flgn div ulong realns 1000000000
flgc 32
for i ulong get fipl 0 bound 64
flgs get fip i
end
flgc 32
flgn get fmeth 0
flgc 32
for i ulong hmin get fpathl 0 512 bound 512
flgs get fpath i
end
flgc 32
flgn st
flgc 32
flgn get fobl 0
flgc 32
flgn div ulong sub long monons tz 1000000
flgc 10
w = write 2 flg 0 get flgl 0
end
note ---- one request
fn fhandle cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to long
tz = long monons
fresetr
freqmeth cs io
freqhdr cs io
st = ulong 0
if not freqtgt cs io
st = 400
end
if eq st 0
st = freqbody cs io bd
end
if eq st 0
if eq get fmeth 0 0
st = 405
end
end
if eq st 0
x = sosess
st = ulong froute
end
r = fsend cs io st
flogreq st tz
ret r
end
fn fserve c int cs edit ulong 320 io edit uchar 131072 bd edit uchar 65536 to void
r = hinit cs io c 1
if lt r 0
x = fclose c
ret
end
hsettmo cs 15000000000 15000000000
hsetbdl cs 60000000000
for k ulong 100
r = hreqrd cs io
if le r 0
if lt r 0
x = hreject cs io r
end
break
end
r = fhandle cs io bd
if lt r 0
break
end
if eq hnext cs io 0
break
end
end
r = hclose cs
end
note ---- reload: allow-list + social log
fn freload to void
n = fload
x = soload
flog tfrld
put flgl 0 0
flgn ulong n
flgc 10
w = write 2 flg 0 get flgl 0
end
fn fflagp to void
fpb
fpt tfdata
fpt tfrlflag
end
fn fchkrl to void
fflagp
r = stat fpth 0 get fpthl 0 fstb 0 128
if ge r 0
x = unlink fpth 0 get fpthl 0
freload
ret
end
fpb
fpt tfrids
m = fmtime
if ne m get famt 0
freload
end
end
fn main to int
cs = new ulong 320 0
io = new uchar 131072 0
bd = new uchar 65536 0
a = new uchar 16 0
r = haddr4 a 2130706433 18480
lf = hlisten a 64
if lt lf 0
flog tfnolist
ret 2
end
freload
for it ulong 4000000000
c = haccept int lf 1000000000
if ge c 0
fserve int c cs io bd
end
fchkrl
end
ret 0
end

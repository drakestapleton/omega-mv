note forged server/counts.om: real clone, download and seeding counts for the repo home (HTML header
note and the "counts" object of forge/repo/1). Every number comes from a log or table that exists:
note   source 0  front-door nginx download log: git smart-HTTP info/refs?service=git-upload-pack (and
note             /code/git/<name>.git/info/refs) answered 200 = one git clone or fetch; our own
note             addresses (loopback, LAN, tailnet, the home address of www.aienos.com) and user agents
note             naming bot / crawl / spider are left out
note   source 1  front-door nginx access log: POST /rad/<RID>.git/git-upload-pack answered 200, every
note             client (that log has no client address); a clone is usually two of these
note   source 2  forged's own access log: GET/HEAD of /<o>/<r>/archive/... and /releases/download/...
note             answered 200, our own addresses left out
note   seeds     this node's Radicle routing table (rad node routing --rid <RID> --json)
note Change-driven, no timer: on a repo home request each log is read only when its size or inode
note changed since the last read, from the saved position (after a rotation the rest of <log>.1
note first). Counted events are appended to the journal ~/forge-data/counts.log as one write per
note batch ("e <k> <epoch> <rid>" lines, then "s <src> <epoch>" once, then the cursor "k <src> <ino>
note <off>"); forged replays it at start and on reload and ignores a torn last batch. Since = the
note time of the first line of the oldest log read for that source.
text tfzp0 "/var/log/nginx/aienos-dl.log"
text tfzp1 "/var/log/nginx/aienos.access.log"
text tfzlog "logs/forged.log"
text tfzjn "counts.log"
text tfzdot1 ".1"
text tfzrad5 "/rad/"
text tfzgit4 ".git"
text tfzinfo "/info/refs?service=git-upload-pack"
text tfzupk "/git-upload-pack"
text tfzz6 "/z6Mk"
text tfzcode "/code/git/"
text tfzdot "dot-"
text tfzpost "\"POST /rad/"
text tfzarch "/archive/"
text tfzrel "/releases/download/"
text tfzbot "bot"
text tfzcrl "crawl"
text tfzspi "spider"
text tfzmon "janfebmaraprmayjunjulaugsepoctnovdec"
text tfzo1 "127."
text tfzo2 "10."
text tfzo3 "192.168."
text tfzo4 "::1"
text tfzo5 "fe80:"
text tfzo6 "fd"
text tfzo7 "100."
text tfzkind "gpar"
global fzbuf uchar 1048576
global fzst uchar 128
global fzcin ulong 1
global fzcsz ulong 1
global fzino ulong 4
global fzoff ulong 4
global fzinit ulong 4
global fzsnc ulong 4
global fzsj ulong 4
global fzspen ulong 4
global fzz0 ulong 1
global fzfail ulong 1
note fzcnt / fzpnd: committed / pending counts, index k*64 + repo, k 0 git fetch 1 upload-pack 2 archive 3 release asset
global fzcnt ulong 256
global fzpnd ulong 256
global fznev ulong 1
global fzjb uchar 65536
global fzjbl ulong 1
note fzjend: journal byte offset after the last committed cursor; any later bytes are abandoned.
global fzjend ulong 1
global fzhome uchar 64
global fzhomel ulong 1
global fzsd ulong 64
global fzsdk ulong 64
global fzsdm ulong 64
global fzsdt ulong 64
note ---- small readers over fzbuf
fn fzb i ulong to uchar
ret get fzbuf i
end
fn fzsp a ulong e ulong to ulong
j = a
for it ulong sub e a bound 1048576
if eq fzb j 32
ret j
end
j = add j 1
end
ret e
end
fn fzch a ulong e ulong c uchar to ulong
j = a
for it ulong sub e a bound 1048576
if eq fzb j c
ret j
end
j = add j 1
end
ret e
end
fn fznum a ulong e ulong to ulong
v = ulong 0
j = a
for it ulong 20
if ge j e
break
end
c = fzb j
if not fisdig c
break
end
v = add mul v 10 ulong sub c 48
j = add j 1
end
ret v
end
fn fzpre a ulong e ulong t view uchar * to bool
if gt add a len t e
ret false
end
for k ulong len t bound 64
if ne fzb add a k get t k
ret false
end
end
ret true
end
fn fzhasat a ulong t view uchar * to bool
for k ulong len t bound 64
if ne flow fzb add a k get t k
ret false
end
end
ret true
end
note fzhas: [a, e) contains t, ignoring ASCII case
fn fzhas a ulong e ulong t view uchar * to bool
if gt add a len t e
ret false
end
for s ulong add sub sub e a len t 1 bound 1048576
if fzhasat add a s t
ret true
end
end
ret false
end
note ---- the repository an event belongs to (public allow-list only)
fn fzrideq i ulong a ulong n ulong to bool
if ne get fail i n
ret false
end
for k ulong n bound 64
if ne fridbyte i k fzb add a k
ret false
end
end
ret true
end
fn fzrix a ulong n ulong to ulong
for i ulong get fan 0 bound 64
if fzrideq i a n
ret i
end
end
ret 9999
end
note fznmeq: the repo name of i equals [a, a+n); with dt 1 a leading "dot-" stands for "."
fn fznmeq i ulong a ulong n ulong dt ulong to bool
if and eq dt 1 fzpre a add a n tfzdot
if ne get fanl i sub n 3
ret false
end
if ne frnbyte i 0 46
ret false
end
for k ulong sub n 4 bound 128
if ne frnbyte i add k 1 fzb add add a 4 k
ret false
end
end
ret true
end
if ne get fanl i n
ret false
end
for k ulong n bound 128
if ne frnbyte i k fzb add a k
ret false
end
end
ret true
end
fn fznix a ulong n ulong dt ulong to ulong
for i ulong get fan 0 bound 64
if fznmeq i a n dt
ret i
end
end
ret 9999
end
note ---- our own addresses: loopback, LAN, tailnet 100.64/10, IPv6 local, the home address
fn fzhomeq a ulong e ulong to bool
n = get fzhomel 0
if or eq n 0 ne sub e a n
ret false
end
for k ulong n bound 64
if ne fzb add a k get fzhome k
ret false
end
end
ret true
end
fn fzown a ulong e ulong to bool
if le sub e a 1
ret true
end
if or fzpre a e tfzo1 fzpre a e tfzo2
ret true
end
if or fzpre a e tfzo3 fzpre a e tfzo4
ret true
end
if or fzpre a e tfzo5 fzpre a e tfzo6
ret true
end
if fzpre a e tfzo7
v = fznum add a 4 e
if and ge v 64 le v 127
ret true
end
end
ret fzhomeq a e
end
note fzhomeip: the home address = what www.aienos.com resolves to here (getent, argv only)
text tfzgent "/usr/bin/getent"
text tfzhosts "hosts"
text tfzhost "www.aienos.com"
fn fzhomeip to bool
put fzhomel 0 0
fkb
fka tfzgent
fka tfzhosts
fka tfzhost
st = fexec 5000000000
if ne st 0
ret false
end
n = ulong 0
for k ulong hmin get fxol 0 63 bound 64
c = get fxo k
if or or eq c 32 eq c 9 eq c 10
break
end
put fzhome k c
n = add n 1
end
put fzhomel 0 n
ret ge n 3
end
note ---- epochs from log times
fn fzdays y ulong m ulong d ulong to ulong
yy = y
if le m 2
yy = sub y 1
end
era = div yy 400
yoe = sub yy mul era 400
mm = add m 9
if gt m 2
mm = sub m 3
end
doy = add div add mul 153 mm 2 5 sub d 1
q = add mul yoe 365 div yoe 4
doe = sub add q doy div yoe 100
ret sub add mul era 146097 doe 719468
end
fn fzmon a ulong to ulong
for m ulong 12
if fzmoneq a m
ret add m 1
end
end
ret 0
end
fn fzmoneq a ulong m ulong to bool
for k ulong 3
if ne flow fzb add a k get tfzmon add mul m 3 k
ret false
end
end
ret true
end
note fzclf: "08/Nov/2026:05:57:35 -0600" at a -> epoch (0 when malformed)
fn fzn2 a ulong to ulong
ret add mul ulong sub fzb a 48 10 ulong sub fzb add a 1 48
end
fn fzdigs a ulong e ulong to bool
if or ge a e gt sub e a 19
ret false
end
for k ulong sub e a bound 19
if not fisdig fzb add a k
ret false
end
end
ret true
end
fn fzclf a ulong e ulong to ulong
if gt add a 26 e
ret 0
end
if not fzdigs add a 22 add a 26
ret 0
end
m = fzmon add a 3
if eq m 0
ret 0
end
dd = fzdays fznum add a 7 e m fznum a e
h = fznum add a 12 e
mi = fznum add a 15 e
s = add add mul h 3600 mul mi 60 fznum add a 18 e
t = add mul dd 86400 s
o = add mul fzn2 add a 22 3600 mul fzn2 add a 24 60
if eq fzb add a 21 45
ret add t o
end
ret sub t o
end
note ---- events: pending until the batch is in the journal
fn fzjc c uchar to void
n = get fzjbl 0
if lt n len fzjb
put fzjb n c
put fzjbl 0 add n 1
end
end
fn fzjn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
fzjc get d add i k
end
end
fn fzev k ulong i ulong ep ulong to void
if ge i get fan 0
ret
end
j = add mul k 64 i
put fzpnd j add get fzpnd j 1
put fznev 0 add get fznev 0 1
fzjc 101
fzjc 32
fzjc get tfzkind k
fzjc 32
fzjn ep
fzjc 32
for q ulong get fail i bound 64
fzjc fridbyte i q
end
fzjc 10
end
fn fzsince s ulong ep ulong to void
if and eq get fzz0 0 1 eq get fzsnc s 0
if ge ep 1000000000
put fzsnc s ep
end
end
end
note ---- source 0: "<msec> <ip> <status> \"<uri>\" \"<user agent>\""
fn fzl0 a ulong e ulong to void
p1 = fzsp a e
ep = fznum a p1
fzsince 0 ep
p2 = fzsp add p1 1 e
p3 = fzsp add p2 1 e
if ne fznum add p2 1 p3 200
ret
end
if ge add p3 2 e
ret
end
u = add p3 2
ue = fzch u e 34
if fzown add p1 1 p2
ret
end
if fzua ue e
ret
end
i = fzuri0 u ue
if lt i 9999
fzev 0 i ep
end
end
fn fzua a ulong e ulong to bool
if fzhas a e tfzbot
ret true
end
if fzhas a e tfzcrl
ret true
end
ret fzhas a e tfzspi
end
note fzuri0: /rad/<RID>.git[/z6Mk<nid>]/info/refs?service=git-upload-pack or /code/git/<name>.git/info/refs...
fn fzuri0 u ulong ue ulong to ulong
if fzpre u ue tfzrad5
r = add u 5
g = fzch r ue 46
if not fzpre g ue tfzgit4
ret 9999
end
t = add g 4
if fzpre t ue tfzz6
t = fzch add t 1 ue 47
end
if not fzpre t ue tfzinfo
ret 9999
end
ret fzrix r sub g r
end
if fzpre u ue tfzcode
r = add u 10
g = fzch r ue 46
for it ulong 8
if fzpre g ue tfzgit4
break
end
g = fzch add g 1 ue 46
end
if not fzpre add g 4 ue tfzinfo
ret 9999
end
ret fznix r sub g r 1
end
ret 9999
end
note ---- source 1: combined format, "... [<time>] \"POST /rad/<RID>.git[/z6Mk<nid>]/git-upload-pack HTTP/x\" <status> ..."
fn fzl1 a ulong e ulong to void
b = fzch a e 91
ep = fzclf add b 1 e
fzsince 1 ep
q = fzch b e 34
if not fzpre q e tfzpost
ret
end
u = add q 6
ue = fzsp u e
q2 = fzch ue e 34
if ge add q2 2 e
ret
end
if ne fznum add q2 2 e 200
ret
end
r = add u 5
g = fzch r ue 46
if not fzpre g ue tfzgit4
ret
end
t = add g 4
if fzpre t ue tfzz6
t = fzch add t 1 ue 47
end
if ne sub ue t len tfzupk
ret
end
if not fzpre t ue tfzupk
ret
end
i = fzrix r sub g r
if lt i 9999
fzev 1 i ep
end
end
note ---- source 2: forged's access line "<epoch> <ip> <method> <path> <status> <bytes> <ms>"
fn fzl2 a ulong e ulong to void
if not fisdig fzb a
ret
end
p1 = fzsp a e
if not fzdigs a p1
ret
end
ep = fznum a p1
fzsince 2 ep
p2 = fzsp add p1 1 e
p3 = fzsp add p2 1 e
if ne fznum add p2 1 p3 1
ret
end
p4 = fzsp add p3 1 e
p5 = fzsp add p4 1 e
if ne fznum add p4 1 p5 200
ret
end
if fzown add p1 1 p2
ret
end
fzpath2 add p3 1 p4 ep
end
fn fzpath2 a ulong e ulong ep ulong to void
o = add a 1
if not fzpre o e tfowner
ret
end
r = add o add len tfowner 1
if ne fzb sub r 1 47
ret
end
g = fzch r e 47
i = fznix r sub g r 0
if ge i 9999
ret
end
if fzpre g e tfzarch
fzev 2 i ep
ret
end
if fzpre g e tfzrel
fzev 3 i ep
end
end
note ---- journal lines: "e <k> <epoch> <rid>", "s <src> <epoch>", "k <src> <ino> <off>"
fn fzjl a ulong e ulong to bool
if lt sub e a 5
ret false
end
c = fzb a
if eq c 101
fzjle a e
ret false
end
s = ulong sub fzb add a 2 48
if gt s 2
ret false
end
if eq c 115
put fzspen s fznum add a 4 e
ret false
end
if eq c 107
p = fzsp add a 4 e
put fzino s fznum add a 4 e
put fzoff s fznum add p 1 e
put fzinit s 1
if ne get fzspen s 0
put fzsnc s get fzspen s
put fzsj s 1
put fzspen s 0
end
fzcommit
ret true
end
ret false
end
fn fzjle a ulong e ulong to void
k = fzkix fzb add a 2
if gt k 3
ret
end
p = fzsp add a 4 e
i = fzrix add p 1 sub sub e p 1
if ge i 9999
ret
end
j = add mul k 64 i
put fzpnd j add get fzpnd j 1
put fznev 0 add get fznev 0 1
end
fn fzkix c uchar to ulong
for k ulong 4
if eq c get tfzkind k
ret k
end
end
ret 9
end
fn fzcommit to void
for j ulong 256
put fzcnt j add get fzcnt j get fzpnd j
put fzpnd j 0
end
put fznev 0 0
end
fn fzdrop to void
for j ulong 256
put fzpnd j 0
end
for s ulong 4
put fzspen s 0
end
put fznev 0 0
put fzjbl 0 0
end
fn fzline s ulong a ulong e ulong to void
if eq s 0
fzl0 a e
ret
end
if eq s 1
fzl1 a e
ret
end
if eq s 2
fzl2 a e
ret
end
end
note ---- paths, stat, journal write
fn fzpath s ulong rot ulong to void
fpb
if eq s 0
fpt tfzp0
end
if eq s 1
fpt tfzp1
end
if eq s 2
fpt tfdata
fpt tfzlog
end
if eq s 3
fpt tfdata
fpt tfzjn
end
if eq rot 1
fpt tfzdot1
end
end
fn fzle8 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get fzst add o i mul i 8
end
ret v
end
note fzstat: inode and size of the source (rot 1: its rotated copy <log>.1); false when missing
fn fzstat s ulong rot ulong to bool
fzpath s rot
r = stat fpth 0 get fpthl 0 fzst 0 128
if lt r 0
ret false
end
put fzcin 0 fzle8 8
put fzcsz 0 fzle8 48
ret true
end
fn fzjk s ulong ino ulong ofs ulong to void
if and eq get fzsj s 0 ne get fzsnc s 0
fzjc 115
fzjc 32
fzjc uchar add s 48
fzjc 32
fzjn get fzsnc s
fzjc 10
end
fzjc 107
fzjc 32
fzjc uchar add s 48
fzjc 32
fzjn ino
fzjc 32
fzjn ofs
fzjc 10
end
note fzjopen: discard a torn suffix before appending, including a short write in this process.
note Refuse a journal that shrank below its committed end; never extend it with invented bytes.
fn fzjopen to long
fzpath 3 0
fd = fopen fpth 0 get fpthl 0 525377 384
if lt fd 0
ret fd
end
sz = fseek int fd 0 2
if lt sz 0
x = fclose int fd
ret -1
end
if lt ulong sz get fzjend 0
x = fclose int fd
ret -1
end
if gt ulong sz get fzjend 0
r = ftrunc int fd long get fzjend 0
if lt r 0
x = fclose int fd
ret -1
end
end
ret fd
end
note fzflush: write the pending batch and its cursor in one append; commit only when it is all written
fn fzflush s ulong ino ulong ofs ulong to bool
if eq get fznev 0 0
put fzjbl 0 0
ret true
end
fzjk s ino ofs
fd = fzjopen
if lt fd 0
fzdrop
ret false
end
n = get fzjbl 0
w = write int fd fzjb 0 n
x = fclose int fd
if ne w long n
fzdrop
ret false
end
put fzjend 0 add get fzjend 0 n
if eq get fzsnc s 0
put fzsj s 0
else
put fzsj s 1
end
put fzjbl 0 0
fzcommit
ret true
end
note ---- the chunked line reader: complete lines of [from, to) of source s; returns the end of the last line read
fn fzlines s ulong n ulong pos ulong ino ulong to ulong
a = ulong 0
used = ulong 0
for it ulong n bound 1048576
if ge a n
break
end
e = fzch a n 10
if ge e n
break
end
used = add e 1
if eq s 3
if fzjl a e
put fzjend 0 add pos used
end
else
fzline s a e
end
a = used
if gt get fzjbl 0 60000
if ne s 3
if not fzflush s ino add pos used
put fzfail 0 1
ret used
end
end
end
end
ret used
end
fn fzscan s ulong rot ulong fr ulong upto ulong ino ulong to bool
put fzz0 0 0
if eq fr 0
put fzz0 0 1
end
fzpath s rot
fd = fopen fpth 0 get fpthl 0 524288 0
if lt fd 0
ret false
end
pos = fr
for it ulong 1000000
if ge pos upto
break
end
n = pread int fd fzbuf 0 hmin sub upto pos len fzbuf long pos
if le n 0
break
end
u = fzlines s ulong n pos ino
if ne get fzfail 0 0
break
end
if eq u 0
if lt ulong n len fzbuf
break
end
u = ulong n
end
pos = add pos u
end
x = fclose int fd
if ne get fzfail 0 0
ret false
end
if eq s 3
ret true
end
if not fzflush s ino pos
ret false
end
put fzino s ino
put fzoff s pos
put fzinit s 1
ret true
end
note ---- one source, on change only
fn fzsync s ulong to void
put fzfail 0 0
if not fzstat s 0
ret
end
ino = get fzcin 0
sz = get fzcsz 0
if and ne get fzinit s 0 and eq ino get fzino s eq sz get fzoff s
ret
end
if ne s 1
if eq get fzhomel 0 0
if not fzhomeip
ret
end
end
end
if eq get fzinit s 0
fzfirst s ino sz
ret
end
if eq ino get fzino s
f = get fzoff s
if lt sz f
f = 0
end
x = fzscan s 0 f sz ino
ret
end
fzrot s ino sz
end
fn fzfirst s ulong ino ulong sz ulong to void
if fzstat s 1
i1 = get fzcin 0
s1 = get fzcsz 0
if not fzscan s 1 0 s1 i1
ret
end
end
x = fzscan s 0 0 sz ino
end
fn fzrot s ulong ino ulong sz ulong to void
o = get fzino s
if fzstat s 1
i1 = get fzcin 0
s1 = get fzcsz 0
f = ulong 0
if eq i1 o
f = get fzoff s
if lt s1 f
f = 0
end
end
if not fzscan s 1 f s1 i1
ret
end
end
x = fzscan s 0 0 sz ino
end
note fzload: start and reload: forget everything and replay the journal (a torn last batch is dropped)
fn fzload to void
for j ulong 256
put fzcnt j 0
end
fzdrop
put fzjend 0 0
for s ulong 4
put fzino s 0
put fzoff s 0
put fzinit s 0
put fzsnc s 0
put fzsj s 0
end
for i ulong 64
put fzsdk i 0
end
put fzfail 0 0
if fzstat 3 0
x = fzscan 3 0 0 get fzcsz 0 0
end
fzdrop
put fzfail 0 0
end
note fzprep: before the repo home (HTML or JSON) of fridx: read what the logs added, read the seeds
fn fzprep to void
i = get fridx 0
if ge i get fan 0
ret
end
put fzhomel 0 0
fzsync 0
fzsync 1
fzsync 2
fzseeds i
end
note ---- seeds: rad node routing --rid rad:<RID> --json, read again when the node database changed
text tfzenv "/usr/bin/env"
text tfzhenv "HOME=/home/drakestapleton"
text tfzrad "/home/drakestapleton/.radicle/bin/rad"
text tfznode "node"
text tfzrout "routing"
text tfzrid "--rid"
text tfzjson "--json"
text tfzradp "rad:"
text tfzwal "/home/drakestapleton/.radicle/node/node.db-wal"
text tfzrow "{\"rid\":\"rad:"
text tfznid "\"nid\":\""
fn fzwalk to ulong
fpb
fpt tfzwal
r = stat fpth 0 get fpthl 0 fzst 0 128
if lt r 0
ret 0
end
ret add mul fzle8 88 1000000000 fzle8 96
end
fn fzseeds i ulong to void
key = fzwalk
if and ne get fzsdk i 0 and ne key 0 eq key get fzsdm i
ret
end
put fzsdm i key
fkb
fka tfzenv
fka tfzhenv
fka tfzrad
fka tfznode
fka tfzrout
fka tfzrid
fkopen
fkt tfzradp
for k ulong get fail i bound 64
fkc fridbyte i k
end
fka tfzjson
st = fexec 5000000000
if ne st 0
put fzsdk i 2
ret
end
put fzsd i fzrows i
put fzsdk i 1
put fzsdt i div ulong realns 1000000000
end
note fzrows: lines of fxo that are {"rid":"rad:<RID of i>",...,"nid":"...
fn fzrows i ulong to ulong
ln = get fxol 0
p = ulong 0
n = ulong 0
for it ulong 1000000
if ge p ln
break
end
e = fleol p ln
if fzrowok i p e
n = add n 1
end
p = add e 1
end
ret n
end
fn fzxpre a ulong e ulong t view uchar * to bool
if gt add a len t e
ret false

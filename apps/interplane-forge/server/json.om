note forged server/json.om: the machine form of /explore (schema forge/explore/1) and of the repo
note home (schema forge/repo/1), docs/API.md. A request gets JSON when its path ends in .json
note (/explore.json, /<owner>/<repo>.json) or its Accept header names application/json and not
note text/html (/, /explore, /<owner>/<repo>). Same data as the HTML page; keys are stable; ids are
note RIDs (rad:...) and full commit shas; times are ISO-8601 UTC. HTML stays the default.
global facc uchar 512
global faccl ulong 1
note fjalt: the HTML page offers its JSON form in <head>: 0 none, 1 explore, 2 the repo fridx
global fjalt ulong 1
note fjt: the bytes of one JSON string, as large as the response body (fob, 8 MiB): a string that fits
note the response is written whole; a longer one cannot be sent, so fjtc marks the body (fobtr) and the
note answer is the whole 500 of fovfl, never a string cut short inside a 200.
global fjt uchar 8388608
global fjtl ulong 1
text tfjctype "application/json; charset=utf-8"
text tfjaj "application/json"
text tfjth "text/html"
text tfjnull "null"
text tfjrep "\\ufffd"
text tfjbq "\\\""
text tfjbb "\\\\"
text tfju00 "\\u00"
text tfjtrue "true"
text tfjfals "false"
note ---- Accept negotiation
fn fjhasat t view uchar * s ulong to bool
for k ulong len t bound 512
if ne flow get facc add s k get t k
ret false
end
end
ret true
end
fn fjhas t view uchar * to bool
n = get faccl 0
m = len t
if gt m n
ret false
end
for s ulong add sub n m 1 bound 512
if fjhasat t s
ret true
end
end
ret false
end
fn fjwant to bool
if not fjhas tfjaj
ret false
end
ret not fjhas tfjth
end
note ---- string building: fjt holds the bytes, fjstr writes them as one JSON string
fn fjtb to void
put fjtl 0 0
end
fn fjtc c uchar to void
n = get fjtl 0
if lt n len fjt
put fjt n c
put fjtl 0 add n 1
else
put fobtr 0 1
end
end
fn fjhex v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
fn fjasc c uchar to void
if eq c 34
fput tfjbq
ret
end
if eq c 92
fput tfjbb
ret
end
if or or lt c 32 eq c 127 or or eq c 60 eq c 62 eq c 38
fput tfju00
fputc fjhex shr ulong c 4
fputc fjhex and ulong c 15
ret
end
fputc c
end
fn fjcont i ulong to bool
if ge i get fjtl 0
ret false
end
c = get fjt i
ret and ge c 128 le c 191
end
fn fjul3 i ulong c uchar to ulong
if not fjcont add i 1
ret 0
end
if not fjcont add i 2
ret 0
end
d = get fjt add i 1
if and eq c 224 lt d 160
ret 0
end
if and eq c 237 gt d 159
ret 0
end
ret 3
end
fn fjul4 i ulong c uchar to ulong
if not fjcont add i 1
ret 0
end
if not fjcont add i 2
ret 0
end
if not fjcont add i 3
ret 0
end
d = get fjt add i 1
if and eq c 240 lt d 144
ret 0
end
if and eq c 244 gt d 143
ret 0
end
ret 4
end
note fjulen: length of the well-formed UTF-8 sequence at fjt[i] (1..4), 0 when it is not well formed
fn fjulen i ulong to ulong
c = get fjt i
if lt c 128
ret 1
end
if and ge c 194 le c 223
if fjcont add i 1
ret 2
end
ret 0
end
if and ge c 224 le c 239
ret fjul3 i c
end
if and ge c 240 le c 244
ret fjul4 i c
end
ret 0
end
note fjstr: "..." with JSON escapes; ill-formed UTF-8 bytes become U+FFFD, so the body is valid JSON
fn fjstr to void
fputc 34
n = get fjtl 0
i = ulong 0
for it ulong n bound 8388608
if ge i n
break
end
l = fjulen i
if eq l 0
fput tfjrep
i = add i 1
continue
end
if eq l 1
fjasc get fjt i
i = add i 1
continue
end
for k ulong l bound 4
fputc get fjt add i k
end
i = add i l
end
fputc 34
end
fn fjtxt t view uchar * to void
fjtb
for k ulong len t bound 4096
fjtc get t k
end
fjstr
end
note fjfx: fxo[a, a+n) as a JSON string
fn fjfx a ulong n ulong to void
fjtb
note the bound is the size of fxo: a file name or a path can be longer than 65,536 bytes, and bound
note 65536 was trap 4 (exit 104) on one. A string over 8 MiB is the whole 500 (fjtc).
for k ulong n bound 16777216
fjtc get fxo add a k
end
fjstr
end
note ---- times: ISO-8601 UTC from an epoch (days to civil date, proleptic Gregorian)
fn fj2 v ulong to void
fputc uchar add div v 10 48
fputc uchar add rem v 10 48
end
fn fj4 v ulong to void
fj2 div v 100
fj2 rem v 100
end
fn fjyoe doe ulong to ulong
a = sub doe div doe 1460
b = add a div doe 36524
ret div sub b div doe 146096 365
end
fn fjdate dd ulong to void
z = add dd 719468
era = div z 146097
doe = sub z mul era 146097
yoe = fjyoe doe
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = ulong 0
if lt mp 10
m = add mp 3
else
m = sub mp 9
end
if le m 2
y = add y 1
end
fj4 y
fputc 45
fj2 m
fputc 45
fj2 d
end
note fjisob: YYYY-MM-DDTHH:MM:SSZ (no quotes); fjiso: the same as a JSON string, or null for 0
fn fjisob t ulong to void
s = rem t 86400
fjdate div t 86400
fputc 84
fj2 div s 3600
fputc 58
fj2 div rem s 3600 60
fputc 58
fj2 rem s 60
fputc 90
end
fn fjiso t ulong to void
if eq t 0
fput tfjnull
ret
end
fputc 34
fjisob t
fputc 34
end
note fjday: YYYY-MM-DD (UTC) for the HTML pages
fn fjday t ulong to void
fjdate div t 86400
end
note ---- fields shared by explore items and the repo object
text tfjo1 "\"owner\":\""
text tfjo2 "\",\"name\":"
text tfjo3 ",\"rid\":\""
text tfjo4 "\",\"path\":\""
text tfjo5 "\",\"json\":\""
text tfjo6 ".json\",\"description\":"
text tfjo7 ",\"default_branch\":\""
text tfjo8 "\",\"stars\":"
text tfjo9 ",\"last_commit\":"
text tfjlc1 "{\"sha\":\""
text tfjlc2 "\",\"time\":"
text tfjlc3 ",\"subject\":"
fn fjpath i ulong to void
fputb
fput tfowner
fputc 47
for k ulong get fanl i bound 128
fputc frnbyte i k
end
end
fn fjtdesc i ulong to void
fjtb
o = get fado i
for k ulong get fadl i bound 4096
fjtc get fadesc add o k
end
end
fn fjtname i ulong to void
fjtb
for k ulong get fanl i bound 128
fjtc frnbyte i k
end
end
note fjsubj: the subject from falc "%cs %h %s" (after the second space)
fn fjsubj i ulong to void
fjtb
o = get falco i
n = get falcl i
sp = ulong 0
for k ulong n bound 1024
c = get falc add o k
if lt sp 2
if eq c 32
sp = add sp 1
end
continue
end
fjtc c
end
fjstr
end
fn fjlast i ulong to void
if ne get falsl i 40
fput tfjnull
ret
end
fput tfjlc1
o = mul i 40
for k ulong 40
fputc get falsh add o k
end
fput tfjlc2
fjiso get falct i
fput tfjlc3
fjsubj i
fputc 125
end
fn fjcore i ulong to void
fput tfjo1
fput tfowner
fput tfjo2
fjtname i
fjstr
fput tfjo3
fputid i
fput tfjo4
fjpath i
fput tfjo5
fjpath i
fput tfjo6
if eq get fadl i 0
fput tfjnull
else
fjtdesc i
fjstr
end
fput tfjo7
o = get fabo i
for k ulong get fabl i bound 64
fputc get fabr add o k
end
fput tfjo8
fnum sostarn i
fput tfjo9
fjlast i
end
note ---- /explore.json (also / and /explore with Accept: application/json)
text tfjex1 "{\"schema\":\"forge/explore/1\",\"base\":\""
text tfjex2 "\",\"count\":"
text tfjex3 ",\"repos\":[\n"
text tfjex4 "\n]}\n"
text tfjsep ",\n"
fn fjstart to void
put fkind 0 1
put fobl 0 0
fsetct tfjctype
end
fn fjexplore to void
fjstart
fput tfjex1
fputb
fput tfjex2
fnum get fan 0
fput tfjex3
for i ulong get fan 0 bound 64
if gt i 0
fput tfjsep
end
fputc 123
fjcore i
fputc 125
end
fput tfjex4
end
note ---- /<owner>/<repo>.json (also /<owner>/<repo> with Accept: application/json)
text tfjr1 "{\"schema\":\"forge/repo/1\",\n"
text tfjr2 ",\n\"favorites\":"
text tfjar1 ",\n\"archives\":{\"zip\":\""
text tfjarh "/archive/refs/heads/"
text tfjar2 ".zip\",\"tar_gz\":\""
text tfjar3 ".tar.gz\"}"
text tfjr3 ",\n\"counts\":"
text tfjr4 "\n}\n"
fn fjrepo to void
i = get fridx 0
fjstart
fput tfjr1
fjcore i
fput tfjr2
fnum sofavn i
fjclone i
fput tfjar1
fjarch i
fput tfjar2
fjarch i
fput tfjar3
fjfiles i
fput tfjr3
fzjson i
fput tfjr4
end
fn fjarch i ulong to void
fjpath i
fput tfjarh
fputbr i
end
note ---- top-level files of the default branch: git ls-tree -z -l <ref> (the browse home's list)
text tfjlst "ls-tree"
text tfjz "-z"
text tfjl "-l"
text tfjf1 ",\n\"files\":"
text tfjf2 "[\n"
text tfjf3 "\n]"
text tfjf4 "{\"name\":"
text tfjf5 ",\"type\":\""
text tfjf6 "\",\"sha\":\""
text tfjf7 "\",\"size\":"
text tfjf8 ",\n\"files_truncated\":"
text tfjrm1 ",\n\"readme\":"
text tfjrm2 "{\"name\":"
text tfjrm3 ",\"html\":\""
text tfjblob "/blob/"
text tfjrm4 "\",\"raw\":\""
text tfjraw "/raw/"
text tfjrm5 "\"}"
text tfjrdm "readme"
text tfjrdmd "readme.md"
global fjrda ulong 1
global fjrdn ulong 1
global fjrdq ulong 1
fn fjlsarg i ulong ns ulong to void
fkgiti i
fka tfjlst
fka tfjz
fka tfjl
fkopen
if eq ns 1
fkt tfrns
fkt tfnid
fkt tfrnsh
else
fkt tfrh
end
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
end
fn fjfiles i ulong to void
put fjrdq 0 0
fjlsarg i 0
st = fexec 5000000000
if ne st 0
fjlsarg i 1
st = fexec 5000000000
end
fput tfjf1
if ne st 0
fput tfjnull
fput tfjrm1
fput tfjnull
ret
end
fput tfjf2
ln = get fxol 0
p = ulong 0
n = ulong 0
for it ulong 100000
if ge p ln
break
end
e = fjnul p ln
note a listing cut by fxo ends in a name without its NUL: that piece is not an entry
if and ge e ln ne get fxotr 0 0
break
end
if lt n 1000
if gt n 0
fput tfjsep
end
fjent p e
end
n = add n 1
p = add e 1
end
fput tfjf3
fput tfjf8
note truncated: more than the 1000 entries listed, or a listing longer than fxo (entries past it unknown)
if or gt n 1000 ne get fxotr 0 0
fput tfjtrue
else
fput tfjfals
end
fput tfjrm1
fjrdme i
end
fn fjnul p ulong ln ulong to ulong
j = p
for it ulong sub ln p bound 16777216
if eq get fxo j 0
ret j
end
j = add j 1
end
ret ln
end
fn fjch a ulong e ulong c uchar to ulong
j = a
for it ulong sub e a bound 16777216
if eq get fxo j c
ret j
end
j = add j 1
end
ret e
end
note fjent: one ls-tree -l record "<mode> <type> <sha> <size>\t<name>" in fxo[p, e)
fn fjent p ulong e ulong to void
s1 = fjch p e 32
s2 = fjch add s1 1 e 32
s3 = fjch add s2 1 e 32
tb = fjch add s3 1 e 9
if ge tb e
fput tfjnull
ret
end
fput tfjf4
fjfx add tb 1 sub sub e tb 1
fput tfjf5
fxput add s1 1 sub sub s2 s1 1
fput tfjf6
fxput add s2 1 sub sub s3 s2 1
fput tfjf7
fjsize add s3 1 tb
fputc 125
fjrdsee add s1 1 add tb 1 e
end
fn fjsize a ulong e ulong to void
v = ulong 0
d = ulong 0
m = hmin sub e a 64
for k ulong m bound 64
c = get fxo add a k
if fisdig c
v = add mul v 10 ulong sub c 48
d = add d 1
end
end
if eq d 0
fput tfjnull
ret
end
fnum v
end
note fjrdsee: remember the README among the blobs (readme.md first, then any name starting readme)
fn fjrdsee t ulong a ulong e ulong to void
if ne get fxo t 98
ret
end
n = sub e a
q = fjrdkind a n
if eq q 0
ret
end
r = get fjrdq 0
if and ne r 0 le r q
ret
end
put fjrdq 0 q
put fjrda 0 a
put fjrdn 0 n
end
fn fjrdkind a ulong n ulong to ulong
if lt n len tfjrdm
ret 0
end
for k ulong len tfjrdm
if ne flow get fxo add a k get tfjrdm k
ret 0
end
end
if ne n len tfjrdmd
ret 2
end
for k ulong len tfjrdmd
if ne flow get fxo add a k get tfjrdmd k
ret 2
end
end
ret 1
end
fn fjrdme i ulong to void
if eq get fjrdq 0 0
fput tfjnull
ret
end
a = get fjrda 0
n = get fjrdn 0
fput tfjrm2
fjfx a n
fput tfjrm3
fjpath i
fput tfjblob
fputbr i
fputc 47
fjpct a n
fput tfjrm4
fjpath i
fput tfjraw
fputbr i
fputc 47
fjpct a n
fput tfjrm5
end
note fjpct: fxo[a, a+n) percent-encoded for a URL path (unreserved bytes kept)
fn fjpct a ulong n ulong to void
m = hmin n 4096
for k ulong m bound 4096
c = get fxo add a k
if or fisaln c or or eq c 46 eq c 45 eq c 95
fputc c
else
fputc 37
fputc fjhexu shr ulong c 4
fputc fjhexu and ulong c 15
end
end
end
fn fjhexu v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 55
end

text tfh8 "</div></div></div>\n<main id=\"main\" tabindex=\"-1\">\n"
text tff1 "\n</main>\n<footer class=\"site-foot\"><div class=\"shell\">\n"
text tfsf1 "<div class=\"foot-top\"><div class=\"foot-brand\"><a class=\"brand\" href=\"https://interplane.io/\" aria-label=\"Interplane home\"><svg class=\"mark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2v20M2 12h20M4.9 4.9l14.2 14.2M4.9 19.1L19.1 4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>interplane<i class=\"dot\">.</i></span></a><p>Good things come from unfinished things.</p><p class=\"rule-line\">No proof. Not done.</p></div>\n<nav class=\"foot-cols\" aria-label=\"Footer\">\n"
text tfsf2 "<div><p class=\"foot-h\">Interplane</p><a href=\"https://interplane.io/yard/\">The yard</a><a href=\"https://interplane.io/how-it-works/\">How it works</a><a href=\"https://interplane.io/evidence/\">Evidence</a><a href=\"https://interplane.io/receipts/\">Receipts</a><a href=\"https://interplane.io/mission/\">Mission</a><a href=\"https://interplane.io/papers/\">Papers</a><a href=\"https://interplane.io/contribute/\">Bring your slop</a><a href=\"https://interplane.io/privacy/\">Privacy</a><a href=\"https://interplane.io/terms/\">Terms</a></div>\n"
text tfsf3 "<div><p class=\"foot-h\">The forge</p><a href=\"https://interplane.io/forge/\">About the forge</a><a href=\"https://interplane.io/explore\">Explore projects</a><a href=\"https://interplane.io/galaxy/\">The map</a><a href=\"https://interplane.io/hop/\">Hop for Mac</a><a href=\"https://interplane.io/agents/\">For agents</a></div>\n<div><p class=\"foot-h\">The protocol</p><a href=\"https://interplane.io/protocol/\">Overview</a><a href=\"https://interplane.io/quick-start/\">Quick start</a><a href=\"https://interplane.io/concepts/\">Concepts</a><a href=\"https://interplane.io/adapter/\">Writing an adapter</a><a href=\"https://interplane.io/conformance/\">Conformance</a><a href=\"https://interplane.io/status/\">Status</a></div>\n</nav></div>\n"
text tfsf4 "<p class=\"si-line\">Interplane is part of <a href=\"https://interplane.io/sovereign-intelligence/\">Sovereign Intelligence&trade;</a>. SI means sovereign, not super: intelligence you own, run on hardware you own, and can check yourself.</p>\n<p class=\"foot-fine\">INTERPLANE Forge: agents express intent; the forge retains authority. Built on Radicle (Heartwood): repositories are Radicle projects served by forged, a seeded-Omega web server, with no JavaScript.</p>\n<p class=\"foot-fine\"><a href=\""
text tff2 "\">Explore</a> &#183; <a href=\""
text tff3 "\">Search</a> &#183; <a href=\""
text tfstars "stars"
text tff4 "\">Stars</a></p>\n</div></footer>\n</body></html>\n"
text tfq "q"
note ---- error pages
text tfe1 "<section class=\"err\"><h1>"
text tfe2 "</h1><p>"
text tfe3 "</p><p><a href=\""
text tfe4 "\">Back to the forge</a></p></section>"
text tfm400 "Bad request. The forge refused this request."
text tfm403 "Forbidden. The form token did not match; reload the page and try again."
text tfm404 "Not found. This page does not exist, or the repository is not public on this forge."
text tfm405 "Method not allowed."
text tfm413 "The request body is too large."
text tfm429 "Too many write requests from this address. Wait a minute and try again."
text tfm500 "The forge hit an internal error serving this page."
text tfm501 "Coming soon. This part of the forge is being built and is not served yet; the feature list says what works today."
text tfmoth "The forge could not serve this request."
text tfmicut "The stored data behind this page is larger than the forge reads in one piece, so an answer built from it would have been incomplete. The forge sent this notice and no part of it. The data is whole in the repository: read it with git or rad."
text tfmovf "This page is too large for the forge to send in one piece (the limit is 8 MiB), so the forge sent this notice and no part of the page. The data is whole in the repository: read it with git or rad."
text tfctj "application/json"
note fovf: 0, or why this response is the too-large notice (1 page, 2 JSON document); flay: the
note lengths of the fragment, the head and the foot of a page (flayout)
global fovf ulong 1
global flay ulong 3
text tft400 "Bad request"
text tft403 "Forbidden"
text tft404 "Not found"
text tft405 "Method not allowed"
text tft413 "Too large"
text tft429 "Slow down"
text tft500 "Server error"
text tft501 "Coming soon"
fn ferrmsg st ulong to void
if ne get fovf 0 0
if ne get ficut 0 0
fput tfmicut
ret
end
fput tfmovf
ret
end
if eq st 400
fput tfm400
ret
end
if eq st 403
fput tfm403
ret
end
if eq st 404
fput tfm404
ret
end
if eq st 405
fput tfm405
ret
end
if eq st 413
fput tfm413
ret
end
if eq st 429
fput tfm429
ret
end
if eq st 500
fput tfm500
ret
end
if eq st 501
fput tfm501
ret
end
fput tfmoth
end
fn ferrti st ulong to void
if eq st 400
fsetti tft400
ret
end
if eq st 403
fsetti tft403
ret
end
if eq st 404
fsetti tft404
ret
end
if eq st 405
fsetti tft405
ret
end
if eq st 413
fsetti tft413
ret
end
if eq st 429
fsetti tft429
ret
end
if eq st 501
fsetti tft501
ret
end
fsetti tft500
end
note fctjson: the content type a handler set starts with application/json
fn fctjson to bool
if lt get fctl 0 len tfctj
ret false
end
for i ulong len tfctj
if ne get fct i get tfctj i
ret false
end
end
ret true
end
note fovfl: the body, its layout or a Location did not fit its buffer (fobtr). Nothing of it is
note sent. The partial body and what the handler set for it (content type, disposition, Location,
note ETag, cache rule, Retry-After, sandbox policy) are dropped and the response becomes a whole 500:
note forge/error/1 when the client asked for JSON or the page was a JSON document (a .json or
note .receipt name needs no Accept header), the error page otherwise. A Set-Cookie stays: what it
note records has already happened. 500 because the request is good and the page exists; the
note server cannot hold this page in its 8 MiB body. Not 413 or 414 (the request is not too large),
note not 503 (asking again gives the same), not 507 (WebDAV storage).
fn fovfl to void
w = ulong 1
if eq get fkind 0 1
if fctjson
w = ulong 2
end
end
put fovf 0 w
put fobl 0 0
put fobtr 0 0
put fctl 0 0
put fcdl 0 0
put flocl 0 0
put fetagl 0 0
put fccl 0 0
put fretry 0 0
put fcspsb 0 0
ferrpage 500
if eq get fkind 0 0
flayout
end
end
note flayout: kind 0. The fragment is fob[0,L); fhead and ffoot are appended after it, before any
note header is sent, so that an overflow in them is seen too. flay keeps L and the two lengths.
fn flayout to void
l = get fobl 0
fhead
h = sub get fobl 0 l
ffoot
put flay 0 l
put flay 1 h
put flay 2 sub sub get fobl 0 l h
end
note fovfany: something was dropped while this response was built
fn fovfany to bool
ret ne get fobtr 0 0
end
note ferrpage: the error page; a JSON request gets the forge/error/1 document (server/jsonp.om)
fn ferrpage st ulong to void
put fkind 0 0
put fobl 0 0
put fjalt 0 0
if or fjwant eq get fovf 0 2
fyerr st
ret
end
ferrti st
fput tfe1
fnum st
fputc 32
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfe2
ferrmsg st
fput tfe3
fputb
fput tfe4
end
note ---- layout: appended AFTER the fragment; main.om sends head, fragment, foot in that order
fn fwho to void
if eq get fuserl 0 0
fput tfahref
fputb
fput tflogin
fput tfsignin
ret
end
fput tfahref
fputb
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfqgt
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfaend
fputc 32
fput tfso1
fputb
fput tflogout
fput tfso2
for i ulong get fcsrfl 0 bound 64
fescc get fcsrf i
end
fput tfso3
end
fn fhead to void
fput tfh1
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfh2
fputb
fput tfcssp
fput tfh3
fputb
fput tficop
fput tfh3i
fhalt
fput tfh3b
fput tfsh
fput tfh4
fputb
fput tfexp
fput tfh4b
fputb
fput tfstars
fput tfh5
fputb
fput tfsrch
fput tfh6
fhdq
fput tfh7
fwho
fput tfh8
end
note fhalt: the page's JSON form (docs/API.md): 1 explore, 2 the repo home, 3 the page's own URL
fn fhalt to void
k = get fjalt 0
if eq k 0
ret
end
fput tfhal1
if eq k 3
fhself
fput tfqgt
ret
end
if eq k 1
fputb
fput tfhal2
else
fputrl
fput tfhal3
end
fput tfqgt
end
note fhself: base, the path without its first /, and the query, escaped for the attribute
fn fhself to void
fputb
n = get fpathl 0
for k ulong sub n 1 bound 4096
fescc get fpath add k 1
end
if gt get fqsl 0 0
fputc 63
for k ulong get fqsl 0 bound 4096
fescc get fqs k
end
end
end
note fhdq: echo the search query into the header box on /search
fn fhdq to void
if not fpeq tfpsrch
ret
end
for i ulong get fql 0 bound 256
fescc get fq i
end
end
fn ffoot to void
fput tff1
fput tfsf1
fput tfsf2
fput tfsf3
fput tfsf4
fputb
fput tfexp
fput tff2
fputb
fput tfsrch
fput tff3
fputb
fput tfstars
fput tff4
end
note ---- the stylesheet (served at <base>assets/forge.css)
note tfcss1..tfcsc3: the site tokens (names and values of interplane.io public/style.css :root) and,
note between the two marks, stylesheet lines copied verbatim from that file. sitechrome.sh checks both.
text tfcss1 ":root{--paper:#f5f3eb;--ink:#242923;--muted:#565a50;--line:#d6d8cc;--white:#fdfcf7;--panel:#e8eadf;--orange:#da4828;--orange-ink:#b83a1c;--ok:#2f6b46;--bad:#a8351a;--btn-dark-bg:#242923;--btn-dark-hover:#3e473b;--btn-dark-press:#111410;--btn-dark-ink:#fdfcf7;--s4:16px;--s5:24px;--s6:32px;--s7:40px;--s8:56px;--r1:4px;--r2:8px;--bg:var(--paper);--fg:var(--ink);--mut:var(--muted);--acc:var(--orange-ink);--box:var(--white)}\n/* site chrome: copied from interplane.io public/style.css */\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%;text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}\na{color:inherit;text-underline-offset:4px;text-decoration-thickness:1px}\na:hover{color:var(--orange-ink);text-decoration-thickness:2px}\na:active{color:var(--orange-ink);text-decoration-thickness:3px}\na:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px;border-radius:var(--r1)}\ncode,pre,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}\n.shell{max-width:1200px;margin:0 auto;padding:0 40px}\n.skip{position:absolute;left:20px;top:-80px;z-index:20;background:var(--btn-dark-bg);color:var(--btn-dark-ink);padding:10px 20px;border-radius:var(--r1)}\n.skip:focus{top:10px}\n"
text tfcsc1 ".site-head{border-bottom:1px solid var(--line)}\n.head-row{display:flex;align-items:center;gap:32px;min-height:92px}\n.brand{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:28px;font-weight:700;letter-spacing:-.05em;text-decoration:none;white-space:nowrap;color:var(--ink)}\n.brand:hover{color:var(--ink)}\n.brand .mark{width:30px;height:30px;flex:none}\n.brand .dot{font-style:normal;color:var(--orange)}\n.site-head nav{display:flex;gap:28px;margin-left:auto}\n.site-head nav a{min-width:44px;font-size:15px;font-weight:600;text-decoration:underline 2px transparent;text-underline-offset:10px;padding:12px 0;text-align:center;white-space:nowrap}\n.site-head nav a:hover,.foot-cols a:hover,.card-body h3 a:hover{text-decoration-color:currentColor;text-underline-offset:5px}\n.button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:52px;padding:14px 26px;border:1px solid transparent;border-radius:var(--r2);font-size:16px;font-weight:600;line-height:1.2;text-decoration:none}\n.button:focus-visible{border-radius:var(--r2);outline-offset:3px}\n.button.dark:active{background:var(--btn-dark-press)}\n.button.dark{background:var(--btn-dark-bg);color:var(--btn-dark-ink)}\n.button.dark:hover{background:var(--btn-dark-hover);color:var(--btn-dark-ink)}\n.button.small{min-height:46px;padding:10px 20px;font-size:14px;white-space:nowrap}\n"
text tfcsc2 ".site-foot{margin-top:var(--s7);border-top:1px solid var(--line);padding:var(--s8) 0 var(--s7)}\n.foot-top{display:grid;grid-template-columns:1.1fr 2fr;gap:var(--s8)}\n.foot-brand p{margin-top:12px;font-size:15px}\n.foot-brand .rule-line{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;letter-spacing:.08em;color:var(--ink)}\n.foot-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s5)}\n.foot-cols .foot-h{margin:0 0 6px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}\n.foot-cols a{display:flex;align-items:center;min-height:44px;font-size:15px;text-decoration:underline 1px transparent;text-underline-offset:8px}\n.si-line{margin-top:var(--s7);padding-top:var(--s5);border-top:1px solid var(--line);font-size:15px;color:var(--ink)}\n.foot-fine{margin-top:10px;font-size:14px}\n.si-line a,.foot-fine a{padding:11px 0}\n"
text tfcsc3 "@media(max-width:1000px){\n.shell{padding:0 28px}\n.head-row{gap:20px}\n.site-head nav{gap:18px}\n.foot-top{grid-template-columns:1fr;gap:var(--s6)}\n}\n@media(max-width:860px){\n.head-row{flex-wrap:wrap;gap:0 16px;min-height:0;padding-top:16px}\n.brand{margin-right:auto}\n.site-head nav{order:3;width:100%;margin:0;gap:28px}\n}\n@media(max-width:760px){\nbody{font-size:16px}\n.shell{padding:0 20px}\n.head-row{padding-top:16px}\n.brand{font-size:24px}\n.brand .mark{width:26px;height:26px}\n.site-head nav{gap:8px;justify-content:space-between}\n.site-head nav a{font-size:14px;padding:13px 0}\n.button.small{min-height:44px;padding:8px 16px}\n.site-foot{padding:var(--s7) 0 var(--s6)}\n.foot-cols{grid-template-columns:1fr 1fr;gap:24px 20px}\n}\n@media(max-width:480px){\n.site-head nav:not(.short){display:grid;grid-template-columns:repeat(3,auto);gap:0 8px;justify-content:space-between}\n}\n@media(max-width:380px){\n.site-head nav a{font-size:13px}\n.brand{font-size:22px}\n}\n/* end site chrome */\n"
note tfcss2: the forge's own rules on the site chrome: Forge marked current, the forge row, main
text tfcss2 ".site-head nav a[aria-current]{text-decoration-color:currentColor}\n:where(.site-foot) p{margin:0;color:var(--muted)}\n.forge-row{border-bottom:1px solid var(--line)}\n.forge-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;min-height:60px;padding-top:8px;padding-bottom:8px}\n.forge-nav{display:flex;gap:24px}.forge-nav a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;font-weight:600;text-decoration:underline 2px transparent;text-underline-offset:10px}.forge-nav a:hover{text-decoration-color:currentColor;text-underline-offset:5px}\n.search{display:flex;gap:6px;flex:1;min-width:200px;max-width:460px}\n.search input{flex:1;min-width:0;min-height:44px;padding:8px 12px;border:1px solid var(--line);border-radius:var(--r2);background:var(--white);color:var(--ink);font:inherit;font-size:15px}\nbutton{padding:5px 10px;border:1px solid var(--line);border-radius:var(--r1);background:var(--white);color:var(--ink);cursor:pointer;font:inherit}button:hover{border-color:var(--ink)}\n.search button,.who button{min-height:44px;padding:8px 16px;border-radius:var(--r2);font-size:15px;font-weight:600}\n.who{margin-left:auto;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;font-size:15px;font-weight:600}.inline{display:inline}\nmain{max-width:1200px;margin:0 auto;padding:var(--s5) 40px var(--s6);font-size:16px;line-height:1.55}\nmain a{color:var(--acc);text-decoration:none}main a:hover{text-decoration:underline}\nmain h1,main h2,main h3{font-weight:600;letter-spacing:-.03em;line-height:1.2}main h1{font-size:clamp(28px,3.4vw,40px);margin:4px 0 12px}\ncode,pre,.mono{font-size:13px}pre{background:var(--box);border:1px solid var(--line);padding:12px;overflow:auto;border-radius:var(--r2)}\ntable.md{display:block;max-width:100%;overflow-x:auto}\n@media(max-width:1000px){main{padding-left:28px;padding-right:28px}}\n@media(max-width:760px){main{padding:16px 20px var(--s5)}.forge-bar{gap:4px 20px}.search{order:3;flex-basis:100%;max-width:none}.readme{padding:12px 14px}}\n"
text tfcss3 ".muted,.meta{color:var(--mut)}.meta{font-size:13px;margin:2px 0}\n.repos{list-style:none;padding:0;margin:0}.repos li{padding:14px 0;border-bottom:1px solid var(--line)}\n.rname{font-size:17px;font-weight:600}.desc{margin:4px 0}.stars{float:right;color:var(--mut)}\n.rhead h1{font-size:22px;margin:0 0 4px;font-weight:500}.rhead h1 b{font-weight:700}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;border-bottom:1px solid var(--line);margin:14px 0 18px}\n.tabs a{padding:8px 12px;border-bottom:2px solid transparent;color:var(--fg)}.tabs a.on{border-bottom-color:var(--acc);font-weight:600}\n.clone{background:var(--box);border:1px solid var(--line);border-radius:6px;padding:6px 10px;display:inline-block}\n"
text tfcss4 ".bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}\ntable{border-collapse:collapse;width:100%}td,th{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n.err h1{font-size:26px}.box{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}\n.ok{color:var(--ok)}.bad{color:var(--bad)}.hit{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}\ninput[type=text],textarea{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}\n@media (max-width:640px){.stars{float:none;display:block}.tabs a{padding:6px 8px}}\n"
text tfcss5 ".releases .release{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}.release h3{margin:0 0 4px}\n.label{display:inline-block;padding:0 8px;border:1px solid var(--line);border-radius:10px;font-size:12px;color:var(--mut);margin-right:4px}\n.subject{font-weight:600}.notes{white-space:pre-wrap}.assets td:last-child{text-align:right;color:var(--mut)}\n.pager{display:flex;gap:12px;margin:14px 0}.empty{color:var(--mut)}\ndiv.clone{display:block;padding:10px 14px;margin:14px 0}div.clone h3{margin:0 0 6px;font-size:15px}div.clone dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:4px 14px}div.clone dt{color:var(--mut)}div.clone dd{margin:0;overflow-wrap:anywhere}\n"
text tfcss6 ".md{line-height:1.6;overflow-wrap:break-word}.md img{max-width:100%}.md table{width:auto}.md-l{text-align:left}.md-c{text-align:center}.md-r{text-align:right}.md blockquote{margin:0;padding:0 12px;border-left:3px solid var(--line);color:var(--mut)}\n.so-bar,.so-tabs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}.so-form{display:inline}.so-btn{padding:3px 10px}.so-n{color:var(--mut);margin-left:4px}.so-on{font-weight:600}\n.so-muted{color:var(--mut)}.so-err{color:var(--bad)}.so-list{list-style:none;padding:0}.so-list li{padding:6px 0;border-bottom:1px solid var(--line)}.so-cmd{display:block;white-space:pre-wrap;background:var(--box);border:1px solid var(--line);border-radius:6px;padding:8px}.so-steps li{margin:6px 0}.so-f{margin:10px 0}\n"
text tfcss7 ".crumbs{margin:8px 0;font-size:15px}.ref{display:inline-block;padding:2px 8px;border:1px solid var(--line);border-radius:6px;background:var(--box);font-size:13px;margin-right:8px}\n.latest{border:1px solid var(--line);border-bottom:0;border-radius:6px 6px 0 0;padding:8px 12px;background:var(--box);font-size:13px;color:var(--mut)}\n.files{margin-top:0}.files .dir a{font-weight:600}.files .sz{text-align:right;color:var(--mut);white-space:nowrap}\n.readme{border:1px solid var(--line);border-radius:6px;padding:16px 24px;margin:16px 0}table.md{width:auto}table.md td,table.md th{border:1px solid var(--line)}\n.code{border:1px solid var(--line);border-radius:6px;overflow-x:auto;font-family:ui-monospace,Menlo,monospace;font-size:13px}.code td{border:0;padding:0 8px;line-height:1.5}\n.ln{text-align:right;color:var(--mut);user-select:none;-webkit-user-select:none;width:1%;white-space:nowrap}.lc{white-space:pre}.img img{max-width:100%}\n"
text tfcss8 ".commits{list-style:none;padding:0;margin:0;border:1px solid var(--line);border-radius:6px}.commits li{padding:8px 12px;border-bottom:1px solid var(--line)}.commits li:last-child{border-bottom:0}\n.box.commit h2{margin:0 0 6px;font-size:18px}pre.msg{white-space:pre-wrap;background:none;border:0;padding:0;margin:6px 0}.stat{font-size:13px;color:var(--mut)}table.stat{width:auto}table.stat td{padding:2px 8px}\n.df{border:1px solid var(--line);border-radius:6px;margin:14px 0;overflow-x:auto}.dfh{padding:6px 12px;background:var(--box);border-bottom:1px solid var(--line);font-family:ui-monospace,Menlo,monospace;font-size:13px}\ntable.diff{font-family:ui-monospace,Menlo,monospace;font-size:13px}table.diff td{border:0;padding:0 8px}td.dc{white-space:pre}tr.da{background:rgba(46,160,67,.15)}tr.dd{background:rgba(248,81,73,.15)}tr.dh,tr.dm{background:var(--box);color:var(--mut)}\ntable.refs td{white-space:nowrap}.badge{display:inline-block;padding:0 8px;border:1px solid var(--acc);border-radius:10px;font-size:12px;color:var(--acc);margin-left:6px}\ntable.code.blame td.bl{white-space:nowrap;color:var(--mut);font-size:12px;border-right:1px solid var(--line);width:1%}tr.bs td{border-top:1px solid var(--line)}p.hit{margin:2px 0}form.inline{display:inline}\n"
fn fcssout to void
put fkind 0 1
fsetct tfctcss
fsetcc tfccpub
fput tfcss1
fput tfcsc1
fput tfcsc2
fput tfcsc3
fput tfcss2
fput tfcss3
fput tfcss4
fput tfcss5
fput tfcss6
fput tfcss7
fput tfcss8
fput tlcss
end
note ---- the site icon (served at <base>assets/favicon.svg; the same drawing as interplane.io's
note /public/favicon.svg). Named in every page head so a browser does not ask /favicon.ico.
text tfctsvg "image/svg+xml"
text tfico "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" rx=\"12\" fill=\"#da4828\"/><g stroke=\"#f5f3eb\" stroke-width=\"5\"><path d=\"M32 10v44M10 32h44M16 16l32 32M16 48l32-32\"/></g></svg>\n"
fn ficoout to void
put fkind 0 1
fsetct tfctsvg
fsetcc tfccpub
fput tfico
end
note ---- repo list item, shared by explore, profile and search
text tfli1 "<li><span class=\"stars\" title=\"stars\">&#9733; "
text tfli2 "</span><a class=\"rname\" href=\""
text tfli3 "</a><p class=\"desc\">"
text tfli4 "</p><p class=\"meta\">Last commit: "
text tfli5 "</p></li>\n"
text tfnodesc "<span class=\"muted\">No description.</span>"
text tfnolc "unknown"
fn frepoli i ulong to void
fput tfli1
fnum sostarn i
fput tfli2
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fput tfowner
fputc 47
fputrn i
fput tfli3
if eq get fadl i 0
fput tfnodesc
else
fdesc i
end
fput tfli4
if eq get falcl i 0
fput tfnolc
else
fputlc i
end
fput tfli5
end
note ---- /explore (also the forge home /)
text tfex1 "<h1>Explore repositories</h1><p class=\"muted\">"
text tfex2 " public repositories on this forge, newest table order. Every one is a Radicle project; clone with <code>rad clone rad:&lt;RID&gt;</code>.</p>\n<ul class=\"repos\">\n"
text tfulend "</ul>\n"
text tfhome1 "<section class=\"box\"><h1>INTERPLANE Forge</h1><p>Agents express intent. The forge retains authority. Browse code, download archives, follow patches and issues, and star the projects you care about.</p></section>\n"
text tftexp "Explore"
text tfthome "Home"
fn fexplore home bool to void
put fjalt 0 1
if home
fsetti tfthome
fput tfhome1
else
fsetti tftexp
end
fput tfex1
fnum get fan 0
fput tfex2
for i ulong get fan 0 bound 64
frepoli i
end
fput tfulend
end

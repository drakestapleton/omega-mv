note forged server/pages.om: layout (header, footer), error pages, /explore, /<owner>, /search,
note the repo header used by every repo tab, and the stylesheet. Writes fob through util.om helpers.
global fq uchar 256
global fql ulong 1
text tfpsrch "/search"
text tfulrep "<ul class=\"repos\">\n"
text tfempty ""
text tfccpub "public, max-age=300"
text tfctcss "text/css; charset=utf-8"
text tfh1 "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><title>"
text tfh2 " &#183; INTERPLANE Forge</title><link rel=\"stylesheet\" href=\""
text tfcssp "assets/forge.css"
text tfh3 "\"><link rel=\"icon\" type=\"image/svg+xml\" href=\""
text tficop "assets/favicon.svg"
text tfh3i "\">"
text tfh3b "</head>\n<body><a class=\"skip\" href=\"#main\">Skip to content</a>"
text tfhal1 "<link rel=\"alternate\" type=\"application/json\" href=\""
text tfhal2 "explore.json"
text tfhal3 ".json"
text tfhal4 "events.json"
note ---- the site chrome: the interplane.io header and footer and their stylesheet lines are not kept
note here. server/chromegen.om makes them at every build from the site's own source (canonical main of
note rad:z399yKvnXcBQNkKoq86iBDgTvQ5QV, content/_layout.html and public/style.css) into the generated
note unit .build/chrome.om (run.sh units): texts tchrhead, tchrfoot, tchrcss and the site commit
note tchrsite. Every site link is absolute, so the same bytes serve the bases / and /forge/; Forge is
note the current section. server/tests/sitechrome.sh checks the result against the site source.
note the forge's own controls, a second row under the site header
text tfh4 "<div class=\"forge-row\"><div class=\"shell forge-bar\"><nav class=\"forge-nav\" aria-label=\"Forge\"><a href=\""
text tfexp "explore"
text tfh4b "\">Explore</a><a href=\""
text tfh5 "\">Stars</a>"
text tfh5b "</nav><form class=\"search\" method=\"get\" action=\""
text tfsrch "search"
text tfh6 "\" role=\"search\"><input type=\"search\" name=\"q\" maxlength=\"200\" placeholder=\"Search the forge\" aria-label=\"Search the forge\" value=\""
text tfh7 "\"><button type=\"submit\">Search</button></form><a class=\"lang-link\" href=\"https://interplane.io/translate/\">Read in your language</a><div class=\"who\">"
text tfsignin "\">Sign in</a>"
text tfahref "<a href=\""
text tfqgt "\">"
text tfaend "</a>"
text tfso1 "<form class=\"inline\" method=\"post\" action=\""
text tflogout "logout"
text tflogin "login"
text tfso2 "\"><input type=\"hidden\" name=\"csrf\" value=\""
text tfso3 "\"><button type=\"submit\">Sign out</button></form>"
text tfh8 "</div></div></div>\n<main id=\"main\" tabindex=\"-1\">\n"
text tff1 "\n</main>\n<footer class=\"site-foot\"><div class=\"shell\">\n"
text tff2 "\">Explore</a> &#183; <a href=\""
text tff3 "\">Search</a> &#183; <a href=\""
text tfstars "stars"
text tff4 "\">Stars</a> &#183; <a href=\"https://interplane.io/translate/\">Read in your language</a> &#183; <a href=\""
text tff4q "?format=text"
text tff4a "&amp;format=text"
text tff4b "\" rel=\"alternate\" type=\"text/plain\">This page as plain text</a></p>\n<p class=\"foot-fine\">Translation is done by your own browser or tool, on your machine. This forge translates nothing and keeps no translated copies; the English page is the reference, and commands, fingerprints and file names are marked to stay exactly as written.</p>\n</div></footer>\n</body></html>\n"
text tfq "q"
note ---- error pages
text tfe1 "<section class=\"err\"><h1>"
text tfe2 "</h1><p>"
text tfe3 "</p><p><a href=\""
text tfe4 "\">Back to the forge</a></p></section>"
text tfm400 "Bad request. The forge refused this request."
text tfm403 "Forbidden. The form token did not match; reload the page and try again."
text tfm404 "Not found. This page does not exist, or the repository is not public on this forge."
text tfm405 "Method not allowed."
text tfm413 "The request body is too large."
text tfm429 "Too many write requests from this address. Wait a minute and try again."
text tfm500 "The forge hit an internal error serving this page."
text tfm501 "Coming soon. This part of the forge is being built and is not served yet; the feature list says what works today."
text tfmoth "The forge could not serve this request."
text tfmicut "The stored data behind this page is larger than the forge reads in one piece, so an answer built from it would have been incomplete. The forge sent this notice and no part of it. The data is whole in the repository: read it with git."
text tfmovf "This page is too large for the forge to send in one piece (the limit is 8 MiB), so the forge sent this notice and no part of the page. The data is whole in the repository: read it with git."
text tfctj "application/json"
note fovf: 0, or why this response is the too-large notice (1 page, 2 JSON document); flay: the
note lengths of the fragment, the head and the foot of a page (flayout)
global fovf ulong 1
global flay ulong 3
text tft400 "Bad request"
text tft403 "Forbidden"
text tft404 "Not found"
text tft405 "Method not allowed"
text tft413 "Too large"
text tft429 "Slow down"
text tft500 "Server error"
text tft501 "Coming soon"
text tftmvg "Moving"
text tfmmvg "This part is moving to the new Interplane store and is not available yet."
fn ferrmsg st ulong to void
if ne get fovf 0 0
if ne get ficut 0 0
fput tfmicut
ret
end
fput tfmovf
ret
end
if and eq st 503 ne get fmvng 0 0
fput tfmmvg
ret
end
if eq st 400
fput tfm400
ret
end
if eq st 403
fput tfm403
ret
end
if eq st 404
fput tfm404
ret
end
if eq st 405
fput tfm405
ret
end
if eq st 413
fput tfm413
ret
end
if eq st 429
fput tfm429
ret
end
if eq st 500
fput tfm500
ret
end
if eq st 501
fput tfm501
ret
end
fput tfmoth
end
fn ferrti st ulong to void
if and eq st 503 ne get fmvng 0 0
fsetti tftmvg
ret
end
if eq st 400
fsetti tft400
ret
end
if eq st 403
fsetti tft403
ret
end
if eq st 404
fsetti tft404
ret
end
if eq st 405
fsetti tft405
ret
end
if eq st 413
fsetti tft413
ret
end
if eq st 429
fsetti tft429
ret
end
if eq st 501
fsetti tft501
ret
end
fsetti tft500
end
note fctjson: the content type a handler set starts with application/json
fn fctjson to bool
if lt get fctl 0 len tfctj
ret false
end
for i ulong len tfctj
if ne get fct i get tfctj i
ret false
end
end
ret true
end
note fovfl: the body, its layout or a Location did not fit its buffer (fobtr). Nothing of it is
note sent. The partial body and what the handler set for it (content type, disposition, Location,
note ETag, cache rule, Retry-After, sandbox policy) are dropped and the response becomes a whole 500:
note forge/error/1 when the client asked for JSON or the page was a JSON document (a .json or
note .receipt name needs no Accept header), the error page otherwise. A Set-Cookie stays: what it
note records has already happened. 500 because the request is good and the page exists; the
note server cannot hold this page in its 8 MiB body. Not 413 or 414 (the request is not too large),
note not 503 (asking again gives the same), not 507 (WebDAV storage).
fn fovfl to void
w = ulong 1
if eq get fkind 0 1
if fctjson
w = ulong 2
end
end
put fovf 0 w
put fobl 0 0
put fobtr 0 0
put fctl 0 0
put fcdl 0 0
put flocl 0 0
put fetagl 0 0
put fccl 0 0
put fretry 0 0
put fcspsb 0 0
ferrpage 500
if eq get fkind 0 0
flayout
end
end
note flayout: kind 0. The fragment is fob[0,L); fhead and ffoot are appended after it, before any
note header is sent, so that an overflow in them is seen too. flay keeps L and the two lengths.
fn flayout to void
l = get fobl 0
fhead
h = sub get fobl 0 l
ffoot
put flay 0 l
put flay 1 h
put flay 2 sub sub get fobl 0 l h
end
note fovfany: something was dropped while this response was built
fn fovfany to bool
ret ne get fobtr 0 0
end
note ferrpage: the error page; a JSON request gets the forge/error/1 document (server/jsonp.om)
fn ferrpage st ulong to void
put fkind 0 0
put fobl 0 0
put fjalt 0 0
if or fjwant eq get fovf 0 2
fyerr st
ret
end
ferrti st
fput tfe1
fnum st
fputc 32
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfe2
ferrmsg st
fput tfe3
fputb
fput tfe4
end
note ---- layout: appended AFTER the fragment; main.om sends head, fragment, foot in that order
fn fwho to void
if eq get fuserl 0 0
fput tfahref
fputb
fput tflogin
fput tfsignin
ret
end
fput tfahref
fputb
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfqgt
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfaend
fputc 32
fput tfso1
fputb
fput tflogout
fput tfso2
for i ulong get fcsrfl 0 bound 64
fescc get fcsrf i
end
fput tfso3
end
fn fhead to void
fput tfh1
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfh2
fputb
fput tfcssp
fput tfh3
fputb
fput tficop
fput tfh3i
fhalt
fput tfh3b
fput tchrhead
fput tfh4
fputb
fput tfexp
fput tfh4b
fputb
fput tfstars
fput tfh5
note each slice may add one entry to the forge row (its seam adds nothing)
ohnav
slnav
rxnav
evnav
fput tfh5b
fputb
fput tfsrch
fput tfh6
fhdq
fput tfh7
fwho
fput tfh8
end
note fhalt: the page's JSON form (docs/API.md): 1 explore, 2 the repo home, 3 the page's own URL,
note 4 the event stream (door/ev5feed.om, the feed page)
fn fhalt to void
k = get fjalt 0
if eq k 0
ret
end
fput tfhal1
if eq k 4
fputb
fput tfhal4
fput tfqgt
ret
end
if eq k 3
fhself
fput tfqgt
ret
end
if eq k 1
fputb
fput tfhal2
else
fputrl
fput tfhal3
end
fput tfqgt
end
note fhself: base, the path without its first /, and the query, escaped for the attribute
fn fhself to void
fputb
n = get fpathl 0
for k ulong sub n 1 bound 4096
fescc get fpath add k 1
end
if gt get fqsl 0 0
fputc 63
for k ulong get fqsl 0 bound 4096
fescc get fqs k
end
end
end
note fhdq: echo the search query into the header box on /search
fn fhdq to void
if not fpeq tfpsrch
ret
end
for i ulong get fql 0 bound 256
fescc get fq i
end
end
fn ffoot to void
fput tff1
fput tchrfoot
fput tfsf4
fputb
fput tfexp
fput tff2
fputb
fput tfsrch
fput tff3
fputb
fput tfstars
fput tff4
note the plain-text form of this page: its own address and query plus format=text (server/tr.om)
fhself
if gt get fqsl 0 0
fput tff4a
else
fput tff4q
end
fput tff4b
end
note ---- the stylesheet (served at <base>assets/forge.css)
note tchrcss (generated, see the site chrome note above): the site's :root token line, then between
note the two marks the site's header and footer rule lines. tfcssv: the forge's own names for tokens.
text tfcssv ":root{--bg:var(--paper);--fg:var(--ink);--mut:var(--muted);--acc:var(--orange-ink);--box:var(--white)}\n"
note tfcss2: the forge's own rules on the site chrome: Forge marked current, the forge row, main
text tfcss2 ".site-head nav a[aria-current]{color:var(--ink);text-decoration-color:currentColor}\n:where(.site-foot) p{margin:0;color:var(--muted)}\n.forge-row{border-bottom:1px solid var(--line)}\n.forge-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;min-height:60px;padding-top:8px;padding-bottom:8px}\n.forge-nav{display:flex;gap:24px}.forge-nav a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;font-weight:600;text-decoration:underline 2px transparent;text-underline-offset:10px}.forge-nav a:hover{text-decoration-color:currentColor;text-underline-offset:5px}\n.search{display:flex;gap:6px;flex:1;min-width:200px;max-width:460px}\n.search input{flex:1;min-width:0;min-height:44px;padding:8px 12px;border:1px solid var(--line);border-radius:var(--r2);background:var(--white);color:var(--ink);font:inherit;font-size:15px}\nbutton{padding:5px 10px;border:1px solid var(--line);border-radius:var(--r1);background:var(--white);color:var(--ink);cursor:pointer;font:inherit}button:hover{border-color:var(--ink)}\n.search button,.who button{min-height:44px;padding:8px 16px;border-radius:var(--r2);font-size:15px;font-weight:600}\n.who{margin-left:auto;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;font-size:15px;font-weight:600}.inline{display:inline}\nmain{max-width:1200px;margin:0 auto;padding:var(--s5) 40px var(--s6);font-size:16px;line-height:1.55}\nmain a{color:var(--acc);text-decoration:none}main a:hover{text-decoration:underline}\nmain h1,main h2,main h3{font-weight:600;letter-spacing:-.03em;line-height:1.2}main h1{font-size:clamp(28px,3.4vw,40px);margin:4px 0 12px}\ncode,pre,.mono{font-size:13px}pre{background:var(--box);border:1px solid var(--line);padding:12px;overflow:auto;border-radius:var(--r2)}\ntable.md{display:block;max-width:100%;overflow-x:auto}\n@media(max-width:1000px){main{padding-left:28px;padding-right:28px}}\n@media(max-width:760px){main{padding:16px 20px var(--s5)}.forge-bar{gap:4px 20px}.search{order:3;flex-basis:100%;max-width:none}.readme{padding:12px 14px}}\n"
text tfcss3 ".muted,.meta{color:var(--mut)}.meta{font-size:13px;margin:2px 0}\n.repos{list-style:none;padding:0;margin:0}.repos li{padding:14px 0;border-bottom:1px solid var(--line)}\n.rname{font-size:17px;font-weight:600}.desc{margin:4px 0}.stars{float:right;color:var(--mut)}\n.rhead h1{font-size:22px;margin:0 0 4px;font-weight:500}.rhead h1 b{font-weight:700}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;border-bottom:1px solid var(--line);margin:14px 0 18px}\n.tabs a{padding:8px 12px;border-bottom:2px solid transparent;color:var(--fg)}.tabs a.on{border-bottom-color:var(--acc);font-weight:600}\n.clone{background:var(--box);border:1px solid var(--line);border-radius:6px;padding:6px 10px;display:inline-block}\n"
text tfcss4 ".bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}\ntable{border-collapse:collapse;width:100%}td,th{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n.err h1{font-size:26px}.box{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}\n.ok{color:var(--ok)}.bad{color:var(--bad)}.hit{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}\ninput[type=text],textarea{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}\n@media (max-width:640px){.stars{float:none;display:block}.tabs a{padding:6px 8px}}\n"
text tfcss5 ".releases .release{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}.release h3{margin:0 0 4px}\n.label{display:inline-block;padding:0 8px;border:1px solid var(--line);border-radius:10px;font-size:12px;color:var(--mut);margin-right:4px}\n.subject{font-weight:600}.notes{white-space:pre-wrap}.assets td:last-child{text-align:right;color:var(--mut)}\n.pager{display:flex;gap:12px;margin:14px 0}.empty{color:var(--mut)}\ndiv.clone{display:block;padding:10px 14px;margin:14px 0}div.clone h3{margin:0 0 6px;font-size:15px}div.clone dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:4px 14px}div.clone dt{color:var(--mut)}div.clone dd{margin:0;overflow-wrap:anywhere}\n"
text tfcss6 ".md{line-height:1.6;overflow-wrap:break-word}.md img{max-width:100%}.md table{width:auto}.md-l{text-align:left}.md-c{text-align:center}.md-r{text-align:right}.md blockquote{margin:0;padding:0 12px;border-left:3px solid var(--line);color:var(--mut)}\n.so-bar,.so-tabs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}.so-form{display:inline}.so-btn{padding:3px 10px}.so-n{color:var(--mut);margin-left:4px}.so-on{font-weight:600}\n.so-muted{color:var(--mut)}.so-err{color:var(--bad)}.so-list{list-style:none;padding:0}.so-list li{padding:6px 0;border-bottom:1px solid var(--line)}.so-cmd{display:block;white-space:pre-wrap;background:var(--box);border:1px solid var(--line);border-radius:6px;padding:8px}.so-steps li{margin:6px 0}.so-f{margin:10px 0}\n"
text tfcss7 ".crumbs{margin:8px 0;font-size:15px}.ref{display:inline-block;padding:2px 8px;border:1px solid var(--line);border-radius:6px;background:var(--box);font-size:13px;margin-right:8px}\n.latest{border:1px solid var(--line);border-bottom:0;border-radius:6px 6px 0 0;padding:8px 12px;background:var(--box);font-size:13px;color:var(--mut)}\n.files{margin-top:0}.files .dir a{font-weight:600}.files .sz{text-align:right;color:var(--mut);white-space:nowrap}\n.readme{border:1px solid var(--line);border-radius:6px;padding:16px 24px;margin:16px 0}table.md{width:auto}table.md td,table.md th{border:1px solid var(--line)}\n.code{border:1px solid var(--line);border-radius:6px;overflow-x:auto;font-family:ui-monospace,Menlo,monospace;font-size:13px}.code td{border:0;padding:0 8px;line-height:1.5}\n.ln{text-align:right;color:var(--mut);user-select:none;-webkit-user-select:none;width:1%;white-space:nowrap}.lc{white-space:pre}.img img{max-width:100%}\n"
text tfcss8 ".commits{list-style:none;padding:0;margin:0;border:1px solid var(--line);border-radius:6px}.commits li{padding:8px 12px;border-bottom:1px solid var(--line)}.commits li:last-child{border-bottom:0}\n.box.commit h2{margin:0 0 6px;font-size:18px}pre.msg{white-space:pre-wrap;background:none;border:0;padding:0;margin:6px 0}.stat{font-size:13px;color:var(--mut)}table.stat{width:auto}table.stat td{padding:2px 8px}\n.df{border:1px solid var(--line);border-radius:6px;margin:14px 0;overflow-x:auto}.dfh{padding:6px 12px;background:var(--box);border-bottom:1px solid var(--line);font-family:ui-monospace,Menlo,monospace;font-size:13px}\ntable.diff{font-family:ui-monospace,Menlo,monospace;font-size:13px}table.diff td{border:0;padding:0 8px}td.dc{white-space:pre}tr.da{background:rgba(0,210,148,.15)}tr.dd{background:rgba(255,101,104,.15)}tr.dh,tr.dm{background:var(--box);color:var(--mut)}\ntable.refs td{white-space:nowrap}.badge{display:inline-block;padding:0 8px;border:1px solid var(--acc);border-radius:10px;font-size:12px;color:var(--acc);margin-left:6px}\ntable.code.blame td.bl{white-space:nowrap;color:var(--mut);font-size:12px;border-right:1px solid var(--line);width:1%}tr.bs td{border-top:1px solid var(--line)}p.hit{margin:2px 0}form.inline{display:inline}\n"
note tfcss9: the project page (server/state.om, frepohd, the "For developers" section) and the marker
note of a README link that leaves the site (browse/b_md.om class "ext")
text tfcss9 ".pj-head h1{font-size:34px;line-height:1.15;margin:4px 0 6px;font-weight:700}.pj-head h1 a{color:var(--ink);text-decoration:none}.pj-head h1 a.rname,.pj-by a.rname{font-size:inherit;font-weight:inherit}.pj-head .desc{font-size:19px;margin:0 0 6px;max-width:44em}.pj-by{color:var(--mut);font-size:15px;margin:0 0 10px}\n.state{margin:6px 0 2px;font-size:16px}.state b{display:inline-block;padding:1px 10px;border-radius:999px;margin-right:6px;font-size:14px}.state.ok b{background:var(--panel);color:var(--ok)}.state.no b{background:var(--panel);color:var(--ink)}.state-more{font-size:14px;color:var(--mut);margin:2px 0 8px;max-width:48em}\n.pj-get{margin:14px 0 6px}.pj-get summary{cursor:pointer}.pj-get summary::after{content:\" ▾\"}.pj-get[open] summary::after{content:\" ▴\"}.pj-get code{user-select:all;overflow-wrap:anywhere}.pj-get dd{margin-inline-start:0}.pj-btn{display:inline-flex;align-items:center;min-height:44px;padding:8px 22px;border-radius:var(--r2);background:var(--btn-dark-bg);color:var(--btn-dark-ink);font-weight:700;text-decoration:none}.pj-btn:hover{background:var(--btn-dark-hover);color:var(--btn-dark-ink)}.pj-btn:active{background:var(--btn-dark-press)}.pj-what{color:var(--mut);font-size:14px;max-width:36em}\n.pj-tabs+.readme{border:0;padding:0;margin-top:8px}.pj-tabs+.readme .md{font-size:18px;line-height:1.65}.pj-nordme{font-size:17px;margin:16px 0 8px}\n.pj-dev{margin-top:40px;padding-top:18px;border-top:2px solid var(--line)}.pj-dev h2{font-size:24px;margin:0 0 6px}.pj-terms{display:grid;grid-template-columns:max-content 1fr;gap:6px 16px;margin:10px 0 16px;font-size:15px}.pj-terms dt{font-weight:700}.pj-terms dd{margin:0;overflow-wrap:anywhere}.pj-recs{margin:16px 0}\n.repos .state{font-size:14px;margin:4px 0}.repos .meta .stars{float:none;display:inline}\n.md a.ext::after{content:\" \\2197\";content:\" \\2197\" / \" (leaves this site)\"}\n@media (max-width:640px){.pj-head h1{font-size:28px}.pj-head .desc{font-size:17px}.pj-terms{grid-template-columns:1fr}.pj-terms dd{margin-bottom:8px}}\n"
fn fcssout to void
put fkind 0 1
fsetct tfctcss
fsetcc tfccpub
fput tchrcss
fput tfcssv
fput tfcss2
fput tfcss3
fput tfcss4
fput tfcss5
fput tfcss6
fput tfcss7
fput tfcss8
fput tfcss9
fput tlcss
end
note ---- the site icon (served at <base>assets/favicon.svg; the same drawing as interplane.io's
note /public/favicon.svg). Named in every page head so a browser does not ask /favicon.ico.
text tfctsvg "image/svg+xml"
text tfico "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect width=\"64\" height=\"64\" rx=\"12\" fill=\"#2563eb\"/><g stroke=\"#ffffff\" stroke-width=\"5\"><path d=\"M32 10v44M10 32h44M16 16l32 32M16 48l32-32\"/></g></svg>\n"
fn ficoout to void
put fkind 0 1
fsetct tfctsvg
fsetcc tfccpub
fput tfico
end
note ---- repo list item, shared by explore, profile and search: the name, the plain sentence (the
note description), the state (server/state.om), then the last commit and the stars. The caller runs
note fpjload first.
text tfli1 "<li class=\"pj-row\"><a class=\"rname\" href=\""
text tfli3 "</a><p class=\"desc\">"
text tfli4 "</p>"
text tfli4b "<p class=\"meta\">Last commit: "
text tfli4c " &#183; <span class=\"stars\" title=\"stars\">&#9733; "
text tfli5 "</span></p></li>\n"
text tfnodesc "<span class=\"muted\">No description.</span>"
text tfnolc "unknown"
fn frepoli i ulong to void
fput tfli1
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fputrn i
fput tfli3
if eq get fadl i 0
fput tfnodesc
else
fdesc i
end
fput tfli4
fpjrow i
fput tfli4b
if eq get falcl i 0
fput tfnolc
else
fputlc i
end
fput tfli4c
fnum sostarn i
fput tfli5
end
note ---- /explore (also the forge home /)
text tfex1 "<h1>Explore repositories</h1><p class=\"muted pj-intro\">"
text tfex2 " projects. Open one to read what it is and to get it. <b>Checked</b> means someone rebuilt it from its source and published a receipt; <b>Unfinished</b> means there is no such receipt yet.</p>\n<ul class=\"repos\">\n"
text tfulend "</ul>\n"
text tfhome1 "<section class=\"box\"><h1>INTERPLANE Forge</h1><p>Agents express intent. The forge retains authority. Read about each project, download it, follow proposed changes and issues, and star the projects you care about.</p></section>\n"
text tftexp "Explore"
text tfthome "Home"
fn fexplore home bool to void
put fjalt 0 1
if home
fsetti tfthome
fput tfhome1
else
fsetti tftexp
end
fpjload
fput tfex1
fnum get fan 0
fput tfex2
for i ulong get fan 0 bound FAMAX
frepoli i
end
fput tfulend
end
note ---- /<owner> profile (the node delegate is the only owner)
text tfpr1 "<section class=\"rhead\"><h1><b>"
text tfpr2 "</b></h1><p class=\"muted mono\">did:key:"
text tfpr3 "</p><p><a href=\""
text tfpfol "/followers"
text tfpr4 " followers</a> &#183; <a href=\""
text tfpfg "/following"
text tfpr5 " following</a> &#183; "
text tfpr6 " stars received &#183; "
text tfpr7 " favorites received</p><div class=\"bar\">"
text tfpr8 "</div></section>\n<h2>Repositories ("
text tfpr9 ")</h2>\n<ul class=\"repos\">\n"
text tfpr10 "<h2>Starred</h2>\n"
fn fstarsum to ulong
s = ulong 0
for i ulong get fan 0 bound FAMAX
s = add s sostarn i
end
ret s
end
fn ffavsum to ulong
s = ulong 0
for i ulong get fan 0 bound FAMAX
s = add s sofavn i
end
ret s
end
fn fprofile to void
fsetti tfowner
fput tfpr1
fput tfowner
fput tfpr2
fput tfnid
fput tfpr3
fputb
fput tfowner
fput tfpfol
fput tfqgt
fnum sofolln
fput tfpr4
fputb
fput tfowner
fput tfpfg
fput tfqgt
fnum sofollg
fput tfpr5
fnum fstarsum
fput tfpr6
fnum ffavsum
fput tfpr7
sofolbar
fput tfpr8
fnum get fan 0
fput tfpr9
fpjload
for i ulong get fan 0 bound FAMAX
frepoli i
end
fput tfulend
fput tfpr10
sostarsof
end
note Project and owner names carry class rname: server/tr.om marks that class translate="no" when it
note sends the page, so the page holds no hint of its own (fob sizes stay exact; server/tests/overflow.sh).
note ---- repo header: a short friendly header (name, the plain sentence, who brought it; on the repo
note home also the state and one action to get it), then the tabs. Words for developers (the
note project id, the clone notice, the counts) are in the "For developers" section of the repo home
note (fpjdev1 / fpjdev2), whose stable address is <repo>#For-developers. The id has an upper-case
note letter, so no README heading anchor (browse/b_md.om brmslug: lower case only) can take it.
text tfrh1 "<section class=\"rhead pj-head\"><h1><a class=\"rname\" href=\""
text tfrh3 "</a></h1><p class=\"desc\">"
text tfrh3n "This project has not described itself yet."
text tfrh4 "</p><p class=\"pj-by\">Brought by <a class=\"rname\" href=\""
text tfrh4b "</a></p>\n"
text tfrh5 "<div class=\"bar\">"
text tfrh6b "</div></section>\n<nav class=\"tabs pj-tabs\" aria-label=\"Project\">"
text tfrh7 "</nav>\n"
text tfton "\" class=\"on\" aria-current=\"page\">"
text tfabout "About"
text tffiles "Files"
text tfcomm "History"
text tfrel "Releases"
text tfpat "Proposed changes"
text tfiss "Issues"
text tfdevt "For developers"
text tfptree "/tree/"
text tfpcom "/commits"
text tfpbr "/branches"
text tfptag "/tags"
text tfprel "/releases"
text tfppat "/patches"
text tfpiss "/issues"
text tfpdev "#For-developers"
text tfpjson ".json"
text tfpzip "/archive/refs/heads/"
text tfpzipx ".zip"
text tfget4 "<p class=\"pj-get pj-what\">Nothing to download yet.</p>\n"
note fpjempty: set by frepohome: the page has no files to offer (no zip link)
global fpjempty ulong 1
fn ftab me ulong on ulong p view uchar * t view uchar * to void
fput tfahref
fputrl
fput p
if eq me on
fput tfton
else
fput tfqgt
end
fput t
fput tfaend
end
fn frepohd tab ulong to void
i = get fridx 0
ok = lt i get fan 0
home = and eq tab 0 eq get frestl 0 0
fput tfrh1
fputrl
fput tfqgt
fputrnm
fput tfrh3
if and ok gt get fadl i 0
fdesc i
else
fput tfrh3n
end
fput tfrh4
fputb
fputown
fput tfqgt
fputown
fput tfrh4b
if and home ok
put fjalt 0 2
fpjload
fpjfull i
if ne get fpjempty 0 0
fput tfget4
else
dlclone
end
end
fput tfrh5
sobar
fput tfrh6b
on = tab
if and eq tab 0 not home
on = 10
end
if or eq tab 2 eq tab 3
on = 20
end
ftab 0 on tfempty tfabout
fput tfahref
fputrl
fput tfptree
if ok
fputbr i
end
if eq on 10
fput tfton
else
fput tfqgt
end
fput tffiles
fput tfaend
ftab 1 on tfpcom tfcomm
ftab 4 on tfprel tfrel
ftab 5 on tfppat tfpat
ftab 6 on tfpiss tfiss
ftab 20 on tfpdev tfdevt
fput tfrh7
end
note ---- the "For developers: proof and records" section of the repo home. fpjdev1 opens it: the
note words that are kept off the top of the page, each with one line of explanation, then the counts
note (server/counts.om fzhtml). The caller adds the branch bar, the clone panel, the newest commit and
note the file list, then fpjdev2 closes it with a link to every record page.
text tfdv1 "<section class=\"pj-dev\" id=\"For-developers\" tabindex=\"-1\" aria-labelledby=\"pj-dev-h\"><h2 id=\"pj-dev-h\">For developers: proof and records</h2>\n<p class=\"pj-lead\">The full record of this project. Words that are used only here are explained once:</p>\n<dl class=\"pj-terms\">\n"
text tfdv6 "\">Proposed changes</a>.</dd>\n<dt>Receipt</dt><dd>A public record that someone checked a claim, with the fingerprint of its evidence file. The state at the top of this page is read from the list at <a href=\"https://interplane.io/receipts/\">interplane.io/receipts</a>. "
text tfdv6b "</dd>\n</dl>"
text tfdv7 "<p class=\"pj-recs\">Every record: <a href=\""
text tfdv8 "\">History (commits)</a> &#183; <a href=\""
text tfdv9 "\">Branches</a> &#183; <a href=\""
text tfdv10 "\">Tags</a> &#183; <a href=\""
text tfdv11 "\">Releases, with the SHA-256 of each download</a> &#183; <a href=\""
text tfdv12 "\">Patches</a> &#183; <a href=\""
text tfdv13 "\">Issues</a> &#183; <a href=\""
text tfdv14 "\">This project as JSON</a></p>\n</section>\n"
text tfdvnl "\n"
fn fpjdev1 to void
i = get fridx 0
fput tfdv1
fpjterms
fputrl
fput tfppat
fput tfdv6
fpjrcpt
fput tfdv6b
if lt i get fan 0
fzhtml i
else
fput tfdvnl
end
end
fn fpjdev2 to void
fput tfdv7
fputrl
fput tfpcom
fput tfdv8
fputrl
fput tfpbr
fput tfdv9
fputrl
fput tfptag
fput tfdv10
fputrl
fput tfprel
fput tfdv11
fputrl
fput tfppat
fput tfdv12
fputrl
fput tfpiss
fput tfdv13
fputrl
fput tfpjson
fput tfdv14
end
note frepohome: the server's repo home when no slice claimed it (browse seam, or a repository whose
note default branch cannot be read)
text tfrhm0 "<p class=\"pj-nordme\">No files to show here yet.</p>\n"
text tfrhm1 "<p class=\"meta\">Default branch <code>"
text tfrhm2 "</code> &#183; last commit "
text tfrhm3 "</p>\n"
fn frepohome to void
i = get fridx 0
put ftil 0 0
ftirepo
put fpjempty 0 1
frepohd 0
put fpjempty 0 0
fput tfrhm0
fpjdev1
fput tfrhm1
fputbr i
fput tfrhm2
fputlc i
fput tfrhm3
fpjdev2
end
note ---- /search?q=: repo names and descriptions (case-insensitive), then code via git grep
text tfsr1 "<h1>Search</h1>\n"
text tfsr2 "<p class=\"muted\">Type a word in the search box: repository names and descriptions are matched, and code is searched with git grep on each public repository's default branch.</p>\n"
text tfsr3 "<h2>Repositories ("
text tfsr4 ")</h2>\n"
text tfsr5 "<p class=\"muted\">No repository name or description matches.</p>\n"
text tftsrch "Search"
fn flow c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn fqcap to void
n = fqget tfq
if lt n 0
n = 0
end
m = ulong n
if gt m 200
m = 200
end
for i ulong m bound 256
put fq i get fval i
end
put fql 0 m
end
fn fsubat src ulong o ulong l ulong to bool
q = get fql 0
if or eq q 0 gt q l
ret false
end
for s ulong add sub l q 1 bound 70000
if fsubeq src add o s
ret true
end
end
ret false
end
fn fsubeq src ulong o ulong to bool
for k ulong get fql 0 bound 256
c = fsubb src add o k
if ne flow c flow get fq k
ret false
end
end
ret true
end
fn fsubb src ulong k ulong to uchar
if eq src 0
ret get fanm k
end
ret get fadesc k
end
fn fsrmatch i ulong to bool
if fsubat 0 get fano i get fanl i
ret true
end
ret fsubat 1 get fado i get fadl i
end
fn fsearch to void
fsetti tftsrch
fput tfsr1
if eq get fql 0 0
fput tfsr2
ret
end
n = ulong 0
for i ulong get fan 0 bound FAMAX
if fsrmatch i
n = add n 1
end
end
fput tfsr3
fnum n
fput tfsr4
if eq n 0
fput tfsr5
else
fpjload
fput tfulrep
for i ulong get fan 0 bound FAMAX
if fsrmatch i
frepoli i
end
end
fput tfulend
end
fcodesr
end
note ---- code search: git grep -I -n -i -F --max-count=5 -e <q> <default ref> per repo, at most 100 hits
text tfcs1 "<h2>Code</h2>\n"
text tfcs2 "<p class=\"muted\">No code matches.</p>\n"
text tfcs3 "<div class=\"box\"><p><a href=\""
text tfcs4 "</a></p>\n"
text tfcs5 "</div>\n"
text tfcs6 "<p class=\"hit\"><a href=\""
text tfcs7 "</a>  "
text tfcs8 "</p>\n"
text tfcsblob "/blob/"
text tfcsl "#L"
text tfgrep "grep"
text tfgI "-I"
text tfgn "-n"
text tfgi "-i"
text tfgF "-F"
text tfgmax "--max-count=5"
text tfge "-e"
text tfcsmore "<p class=\"muted\">Showing the first 100 code matches.</p>\n"
global fhits ulong 1
fn fcodesr to void
fput tfcs1
put fhits 0 0
nscodesr
if eq get fhits 0 0
fput tfcs2
end
if ge get fhits 0 100
fput tfcsmore
end
end
fn fgreparg i ulong to void
fkgiti i
fka tfgrep
fka tfgI
fka tfgn
fka tfgi
fka tfgF
fka tfgmax
fka tfge
fkopen
for k ulong get fql 0 bound 256
fkc get fq k
end
fkopen
fkt tfrh
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
end
note fcsrepo: render repo i's git grep output (already in fxo, read by nodes/srch.om nsrun)
fn fcsrepo i ulong to void
ln = get fxol 0
if eq ln 0
ret
end
fput tfcs3
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fput tfowner
fputc 47
fputrn i
fput tfcs4
p = ulong 0
for it ulong 100000
if ge p ln
break
end
if ge get fhits 0 100
break
end
e = fleol p ln
fcshit i p e
p = add e 1
end
fput tfcs5
end
note fcshit: one line "refs/heads/<b>:<path>:<line>:<text>"; skip the ref prefix (len 11 + branch + 1)
fn fcshit i ulong p ulong e ulong to void
a = add add p 12 get fabl i
if ge a e
ret
end
c1 = fcolon a e
if ge c1 e
ret
end
c2 = fcolon add c1 1 e
if ge c2 e
ret
end
put fhits 0 add get fhits 0 1
fput tfcs6
fputb
fput tfowner
fputc 47
fputrn i
fput tfcsblob
fputbr i
fputc 47
fxesc a sub c1 a
fput tfcsl
fxesc add c1 1 sub sub c2 c1 1
fput tfqgt
fxesc a sub c1 a
fputc 58
fxesc add c1 1 sub sub c2 c1 1
fput tfcs7
m = sub sub e c2 1
if gt m 300
m = 300
end
fxesc add c2 1 m
fput tfcs8
end
fn fcolon a ulong e ulong to ulong
note the bound is the size of fxo: a path in a search hit can be longer than 100,000 bytes
j = a
while lt j e bound 16777216
if eq get fxo j 58
ret j
end
j = add j 1
end
ret e
end

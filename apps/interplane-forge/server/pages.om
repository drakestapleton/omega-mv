fn ftab me ulong on ulong p view uchar * t view uchar * to void
fput tfahref
fputrl
fput p
if eq me on
fput tfton
else
fput tfqgt
end
fput t
fput tfaend
end
fn frepohd tab ulong to void
i = get fridx 0
fput tfrh1
fputb
fputown
fput tfqgt
fputown
fput tfrh2
fputrl
fput tfqgt
fputrnm
fput tfrh3
if lt i get fan 0
fdesc i
end
fput tfrh4
sobar
fput tfrh5
for k ulong get fridl 0 bound 64
fescc get frid k
end
fput tfrh6

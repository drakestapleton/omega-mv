text obstale "2222222222222222222222222222222222222222"
text obsuite "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
text obother "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
text obbad "short"
fn oblink repo view uchar * suffix view uchar * label view uchar * to void
fput tfahref
fputb
fput tfowner
fputc 47
fput repo
fput suffix
fput tfqgt
fput label
fput tfaend
end
fn obmap to void
fput obcard1
oblink obomega obnone obopen
fput obendc
fput obcard2
oblink obharn obnone obopen
fput obendc
fput obcard3
oblink obtrain obnone obopen
fput obendc
fput obcard4
oblink obsys obnone obopen
fput obendc
end
text obrev2 "1111111111111111111111111111111111111111"
text obsuit2 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fn obtrial c ulong to ulong
if eq c 1
ret ogfacts ogjudge obrev obstale ogsuite obsuite obsuit2 31
end
if eq c 2
ret ogfacts ogjudge obrev obrev2 ogsuite obsuite obsuit2 27
end
if eq c 3
ret ogfacts ogjudge obrev obrev2 ogsuite obsuite obother 31
end
if eq c 4
ret ogfacts ogjudge obrev obrev2 ogsuite obsuite obsuit2 23
end
if eq c 5
ret ogfacts ogjudge obrev obbad ogsuite obsuite obsuit2 31
end
ret ogfacts ogjudge obrev obrev2 ogsuite obsuite obsuit2 31
end
note Detect bare or duplicate case fields before using the existing decoder.
fn obbadqs to bool
n = get fqsl 0
i = ulong 0
hits = ulong 0
while lt i n bound 4096
e = fpnext 0 i n
stop = e
if and gt e i eq get fqs sub e 1 38
stop = sub e 1
end
if ge sub stop i 4
same = true
for k ulong 4 bound 4
if ne get fqs add i k get obcase k
same = false
end
end
if same
if eq sub stop i 4
ret true
end
if eq get fqs add i 4 61
hits = add hits 1
if gt hits 1
ret true
end
end
end
end
i = e
end
ret false
end
fn obscene to ulong
if obbadqs
ret 99
end
n = fqget obcase
if eq n -1
ret 0
end
if ne n 1
ret 99
end
c = get fval 0
if or lt c 48 gt c 53
ret 99
end
ret ulong sub c 48
end
fn obresult c ulong to void
if eq c 99
fput obinv
fput obdetail
fnum c
fput obfacts
fnum 99
ret
end
r = obtrial c
if eq r 0
fput obpass
else
fput obdeny
if eq r 1
fput obwhy1
end
if eq r 2
fput obwhy2
end
if eq r 3
fput obwhy3
end
if eq r 4
fput obwhy4
end
end
fput obdetail
fnum c
fput obfacts
fnum r
end
fn oboption i ulong c ulong label view uchar * to void
fput obopt
fnum i
fputc 34
if eq i c
fput obsel
end
fputc 62
fput label
fput oboe
end
fn obopts c ulong to void
oboption 0 c obo0
oboption 1 c obo1
oboption 2 c obo2
oboption 3 c obo3
oboption 4 c obo4
oboption 5 c obo5
end
fn obhome to void
fsetti obtitle
fput obstart
obmap
fput obhist
oblink obforge obpat obpatch
fput oblab
fputb
fput obform
obopts obscene
fput obfend
obresult obscene
fput oblabend
fput tfahref
fputb
fput tfexp
fput tfqgt
fput obexpl
fput tfaend
fput obfinish
end

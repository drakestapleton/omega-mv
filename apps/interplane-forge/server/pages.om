note ---- /search?q=: repo names and descriptions (case-insensitive), then code via git grep
text tfsr1 "<h1>Search</h1>\n"
text tfsr2 "<p class=\"muted\">Type a word in the search box: repository names and descriptions are matched, and code is searched with git grep on each public repository's default branch.</p>\n"
text tfsr3 "<h2>Repositories ("
text tfsr4 ")</h2>\n"
text tfsr5 "<p class=\"muted\">No repository name or description matches.</p>\n"
text tftsrch "Search"
fn flow c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn fqcap to void
n = fqget tfq
if lt n 0
n = 0
end
m = ulong n
if gt m 200
m = 200
end
for i ulong m bound 256
put fq i get fval i
end
put fql 0 m
end
fn fsubat src ulong o ulong l ulong to bool
q = get fql 0
if or eq q 0 gt q l
ret false
end
for s ulong add sub l q 1 bound 70000
if fsubeq src add o s
ret true
end
end
ret false
end
fn fsubeq src ulong o ulong to bool
for k ulong get fql 0 bound 256
c = fsubb src add o k
if ne flow c flow get fq k
ret false
end
end
ret true
end
fn fsubb src ulong k ulong to uchar
if eq src 0
ret get fanm k
end
ret get fadesc k
end
fn fsrmatch i ulong to bool
if fsubat 0 get fano i get fanl i
ret true
end
ret fsubat 1 get fado i get fadl i
end
fn fsearch to void
fsetti tftsrch
fput tfsr1
if eq get fql 0 0
fput tfsr2
ret
end
n = ulong 0
for i ulong get fan 0 bound 64
if fsrmatch i
n = add n 1
end
end
fput tfsr3
fnum n
fput tfsr4
if eq n 0
fput tfsr5
else
fput tfulrep
for i ulong get fan 0 bound 64
if fsrmatch i
frepoli i
end
end
fput tfulend
end
fcodesr
end
note ---- code search: git grep -I -n -i -F --max-count=5 -e <q> <default ref> per repo, at most 100 hits
text tfcs1 "<h2>Code</h2>\n"
text tfcs2 "<p class=\"muted\">No code matches.</p>\n"
text tfcs3 "<div class=\"box\"><p><a href=\""
text tfcs4 "</a></p>\n"
text tfcs5 "</div>\n"
text tfcs6 "<p class=\"hit\"><a href=\""
text tfcs7 "</a>  "
text tfcs8 "</p>\n"
text tfcsblob "/blob/"
text tfcsl "#L"
text tfgrep "grep"
text tfgI "-I"
text tfgn "-n"
text tfgi "-i"
text tfgF "-F"
text tfgmax "--max-count=5"
text tfge "-e"
text tfcsmore "<p class=\"muted\">Showing the first 100 code matches.</p>\n"
global fhits ulong 1
fn fcodesr to void
fput tfcs1
put fhits 0 0
for i ulong get fan 0 bound 64
if lt get fhits 0 100
fcsrepo i
end
end
if eq get fhits 0 0
fput tfcs2
end
if ge get fhits 0 100
fput tfcsmore
end
end
fn fgreparg i ulong to void
fkgiti i
fka tfgrep
fka tfgI
fka tfgn
fka tfgi
fka tfgF
fka tfgmax
fka tfge
fkopen
for k ulong get fql 0 bound 256
fkc get fq k
end
fkopen
fkt tfrh
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
end
fn fcsrepo i ulong to void
fgreparg i
st = fexec 10000000000
if ne st 0
ret
end
ln = get fxol 0
if eq ln 0
ret
end
fput tfcs3
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fput tfowner
fputc 47
fputrn i
fput tfcs4
p = ulong 0
for it ulong 100000
if ge p ln
break
end
if ge get fhits 0 100
break
end
e = fleol p ln
fcshit i p e
p = add e 1
end
fput tfcs5
end
note fcshit: one line "refs/heads/<b>:<path>:<line>:<text>"; skip the ref prefix (len 11 + branch + 1)
fn fcshit i ulong p ulong e ulong to void
a = add add p 12 get fabl i
if ge a e
ret
end
c1 = fcolon a e
if ge c1 e
ret
end
c2 = fcolon add c1 1 e
if ge c2 e
ret
end
put fhits 0 add get fhits 0 1
fput tfcs6
fputb
fput tfowner
fputc 47
fputrn i
fput tfcsblob
fputbr i
fputc 47
fxesc a sub c1 a
fput tfcsl
fxesc add c1 1 sub sub c2 c1 1
fput tfqgt
fxesc a sub c1 a
fputc 58
fxesc add c1 1 sub sub c2 c1 1
fput tfcs7
m = sub sub e c2 1
if gt m 300
m = 300
end
fxesc add c2 1 m
fput tfcs8
end
fn fcolon a ulong e ulong to ulong
j = a
while lt j e bound 100000
if eq get fxo j 58
ret j
end
j = add j 1
end
ret e
end

note Observatory receipt predicate. Pure decision logic; the caller must authenticate facts.
note Result 0 admissible, 1 malformed identity, 2 stale revision, 3 wrong suite, 4 missing facts.
note facts bits: positive passed, control ran, control rejected, independent review, artifact bound.
fn oghex s view uchar * to bool
if not or eq len s 40 eq len s 64
ret false
end
for i ulong len s bound 64
c = get s i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret false
end
end
ret true
end
fn ogeq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 64
if ne get a i get b i
ret false
end
end
ret true
end
fn ogjudge want view uchar * got view uchar * to ulong
if not and oghex want oghex got
ret 1
end
if not ogeq want got
ret 2
end
ret 0
end
fn ogsuite suite view uchar * seen view uchar * to ulong
if not and eq len suite 64 eq len seen 64
ret 1
end
if not and oghex suite oghex seen
ret 1
end
if not ogeq suite seen
ret 3
end
ret 0
end
fn ogfacts identity ulong suite ulong facts ulong to ulong
if ne identity 0
ret identity
end
if ne suite 0
ret suite
end
if ne facts 31
ret 4
end
ret 0
end
text obtitle "Observatory | Omega-native workspace"
text obstart "<div class=\"ob\"><a class=\"eyebrow\" href=\"#workspace\">COMPARISON EDITION / 01</a><section class=\"hero\"><div><p class=\"eyebrow\">INTERPLANE / THE OMEGA OBSERVATORY</p><h1>One place.<br>Your entire<br><em>intelligence stack.</em></h1><p class=\"lede\">Follow an idea from the words that shaped it to the code, agents, models, and machines that bring it to life. Keep the evidence beside every revision.</p><div class=\"actions\"><a class=\"cta primary\" href=\"#workspace\">Explore the workspace &#8599;</a><a class=\"cta\" href=\"#evidence\">Try the evidence gate</a></div></div><div class=\"signal\" aria-label=\"Concept diagram: intent becomes Omega and is checked against evidence\"><div class=\"signal-top\"><span>COMMON LANGUAGE</span><span>NATIVE .om</span></div><div class=\"orb\" aria-hidden=\"true\">&#937;</div><div class=\"signal-flow\"><span>01 / INTENT</span><span>02 / OMEGA</span><span>03 / EVIDENCE</span></div><p class=\"caption\">A shared language for agents. A visible chain of evidence for people. This diagram describes the design, not live activity.</p></div></section><nav class=\"subnav\" aria-label=\"Workspace sections\"><a href=\"#workspace\">01 / Stack map</a><a href=\"#history\">02 / Revision trail</a><a href=\"#evidence\">03 / Evidence lab</a><a href=\"#principles\">04 / Foundations</a></nav><section id=\"workspace\"><div class=\"section-head\"><div><span class=\"eyebrow\">THE WORKSPACE</span><h2>See how everything connects.</h2></div><p>Open the source behind each layer. Runtime telemetry is not connected in this comparison edition.</p></div><div class=\"grid\">"
text obcard1 "<article class=\"card\"><span class=\"index\">01 / LANGUAGE</span><h3>Omega</h3><p>The native foundation. Inspect the compiler, language, and seed that the rest of the stack builds on.</p><span class=\"tag\">SOURCE / COMPILER</span>"
text obcard2 "<article class=\"card\"><span class=\"index\">02 / AGENTS</span><h3>Agent workspace</h3><p>Trace the harness that coordinates execution. Keep intent, authority, and verification distinct.</p><span class=\"tag\">SOURCE / HARNESS</span>"
text obcard3 "<article class=\"card\"><span class=\"index\">03 / MODELS</span><h3>Model workshop</h3><p>Inspect training work and artifact provenance. A model claim needs a pinned model and evaluation.</p><span class=\"tag\">SOURCE / TRAINING</span>"
text obcard4 "<article class=\"card\"><span class=\"index\">04 / MACHINES</span><h3>Hardware layer</h3><p>Follow the operating-system source down to the machine. Hardware qualification remains target-specific.</p><span class=\"tag\">SOURCE / SYSTEMS</span>"
text obendc "</article>"
text obhist "</div></section><section id=\"history\"><div class=\"section-head\"><div><span class=\"eyebrow\">THE REVISION TRAIL</span><h2>Keep the reasoning attached.</h2></div><p>Existing repository history and patches remain the source of truth. Text history can travel beside code as versioned files.</p></div><div class=\"trail\"><article><span class=\"index\">01 / CAPTURE</span><h3>Words become a revision.</h3><p>Version prompts, plans, and .om source together. Preserve authorship and the exact change.</p></article><article><span class=\"index\">02 / CHALLENGE</span><h3>Make a wrong answer fail.</h3><p>A passing test alone is incomplete. Bind negative-control results to the same revision and suite.</p></article><article><span class=\"index\">03 / COMPARE</span><h3>Carry the proof forward.</h3><p>Review alternatives in separate Radicle patches. Changed source or checks require fresh evidence.</p>"
text oblab "</article></div></section><section id=\"evidence\"><div class=\"section-head\"><div><span class=\"eyebrow\">NATIVE OMEGA / INTERACTIVE</span><h2>Evidence that knows its revision.</h2></div><p>A working decision predicate with synthetic inputs. This lab never approves a real patch or changes a repository.</p></div><div class=\"lab\"><div><h3>Try to fool the gate.</h3><p>Select a receipt condition. The server runs the Omega predicate and explains its decision.</p><form method=\"get\" action=\""
text obform "#evidence\"><label for=\"scenario\">Receipt condition</label><select id=\"scenario\" name=\"case\">"
text obfend "</select><button class=\"cta primary\" type=\"submit\">Evaluate receipt &#8594;</button></form><p>All checks run in .om. No browser scripts, model calls, or background jobs.</p></div><div class=\"receipt\" role=\"status\"><span class=\"eyebrow\">SYNTHETIC RECEIPT / DECISION</span>"
text obopt "<option value=\""
text obsel " selected"
text oboe "</option>"
text obo0 "Complete, matching evidence"
text obo1 "Evidence from another revision"
text obo2 "Negative control did not reject"
text obo3 "Different verification suite"
text obo4 "Missing independent review"
text obo5 "Malformed revision identity"

text obpass "<strong class=\"ok\">Admissible fixture</strong><p>Matching revision and suite; all five required evidence facts are present.</p>"
text obdeny "<strong class=\"deny\">Evidence refused</strong>"
text obwhy1 "<p>The revision identity is malformed. Full lowercase Git identities are required.</p>"
text obwhy2 "<p>The receipt belongs to another revision. Re-run verification for this exact source.</p>"
text obwhy3 "<p>The suite identity changed. Results from different checks cannot be reused.</p>"
text obwhy4 "<p>Required evidence is missing. Passing tests alone do not satisfy the gate.</p>"
text obinv "<strong class=\"deny\">Unknown scenario</strong><p>Choose one of the six listed receipt conditions.</p>"
text obdetail "<dl><dt>Scenario</dt><dd>"
text obfacts "</dd><dt>Predicate result</dt><dd>"
text oblabend "</dd><dt>Authority</dt><dd>DEMONSTRATION ONLY</dd></dl><p class=\"caption\">A trusted collector must authenticate receipts, bind artifacts, and establish reviewer identity before these facts can authorize anything.</p></div></div></section><section id=\"principles\"><div class=\"section-head\"><div><span class=\"eyebrow\">BUILT FROM THE FOUNDATION</span><h2>Clear boundaries. Room to grow.</h2></div></div><details open><summary>Omega is the implementation language.</summary><p>This candidate extends the existing seeded-Omega forge. Layout, routing, and the evidence predicate are .om source. HTML and CSS are presentation output. The inherited forge still uses Git and ssh-keygen as host dependencies; this candidate does not claim to replace them.</p></details><details><summary>Agent communication should carry references, not repeated history.</summary><p>The proposed next integration sends immutable revision, artifact, and suite identities with bounded intent. The receiver resolves approved objects locally. No efficiency or token-saving claim is made without a measured comparison.</p></details><details><summary>Management needs authority before it gets a button.</summary><p>This edition links real source and demonstrates evidence decisions. It does not start agents, load models, control machines, ingest private conversations, or approve releases. Those integrations need scoped authority and authenticated producers.</p></details></section><div class=\"endcap\"><div><span class=\"eyebrow\">BUILT TO COMPARE, COMPOSE, AND KEEP</span><h2>Your next revision starts here.</h2><p>Independent candidate. No live deployment. No invented runtime numbers.</p></div>"
text obfinish "</div></div>"
text obopen "Open source &#8599;"
text obpatch "Compare forge patches &#8599;"
text obexpl "Browse all repositories &#8599;"

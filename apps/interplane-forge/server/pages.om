text tfpr6 " stars received &#183; "
text tfpr7 " favorites received</p><div class=\"bar\">"
text tfpr8 "</div></section>\n<h2>Repositories ("
text tfpr9 ")</h2>\n<ul class=\"repos\">\n"
text tfpr10 "<h2>Starred</h2>\n"
fn fstarsum to ulong
s = ulong 0
for i ulong get fan 0 bound 64
s = add s sostarn i
end
ret s
end
fn ffavsum to ulong
s = ulong 0
for i ulong get fan 0 bound 64
s = add s sofavn i
end
ret s
end
fn fprofile to void
fsetti tfowner
fput tfpr1
fput tfowner
fput tfpr2
fput tfnid
fput tfpr3
fputb
fput tfowner
fput tfpfol
fput tfqgt
fnum sofolln
fput tfpr4
fputb
fput tfowner
fput tfpfg
fput tfqgt
fnum sofollg
fput tfpr5
fnum fstarsum
fput tfpr6
fnum ffavsum
fput tfpr7
sofolbar
fput tfpr8
fnum get fan 0
fput tfpr9
for i ulong get fan 0 bound 64
frepoli i
end
fput tfulend
fput tfpr10
sostarsof
end
note ---- repo header: title, description, social bar, clone line, tabs
text tfrh1 "<section class=\"rhead\"><h1><a href=\""
text tfrh2 "</a> / <b><a href=\""
text tfrh3 "</a></b></h1><p class=\"desc\">"
text tfrh4 "</p><div class=\"bar\">"
text tfrh5 "<span class=\"clone mono\">rad clone rad:"
text tfrh6 "</span></div>"
text tfrh6b "</section>\n<nav class=\"tabs\">"
text tfrh7 "</nav>\n"
text tfton "\" class=\"on\">"
text tfcode "Code"
text tfcomm "Commits"
text tfbran "Branches"
text tftags "Tags"
text tfrel "Releases"
text tfpat "Patches"
text tfiss "Issues"
text tfpcom "/commits"
text tfpbr "/branches"
text tfptag "/tags"
text tfprel "/releases"
text tfppat "/patches"
text tfpiss "/issues"
fn ftab me ulong on ulong p view uchar * t view uchar * to void
fput tfahref
fputrl
fput p
if eq me on
fput tfton
else
fput tfqgt
end
fput t
fput tfaend
end
fn frepohd tab ulong to void
i = get fridx 0
fput tfrh1
fputb
fputown
fput tfqgt
fputown
fput tfrh2
fputrl
fput tfqgt
fputrnm
fput tfrh3
if lt i get fan 0
fdesc i
end
fput tfrh4
sobar
fput tfrh5
for k ulong get fridl 0 bound 64
fescc get frid k
end
fput tfrh6
if and eq get frestl 0 0 lt i get fan 0
put fjalt 0 2
fzhtml i
end
fput tfrh6b
ftab 0 tab tfempty tfcode
ftab 1 tab tfpcom tfcomm
ftab 2 tab tfpbr tfbran
ftab 3 tab tfptag tftags
ftab 4 tab tfprel tfrel
ftab 5 tab tfppat tfpat
ftab 6 tab tfpiss tfiss
fput tfrh7
end
note frepohome: the server's repo home when no slice claimed it (browse seam)
text tfrhm1 "<p class=\"meta\">Default branch <code>"
text tfrhm2 "</code> &#183; last commit "
text tfrhm3 "</p>\n"
fn frepohome to void
i = get fridx 0
put ftil 0 0
ftirepo
frepohd 0
fput tfrhm1
fputbr i
fput tfrhm2
fputlc i
fput tfrhm3
dlclone
end
note ---- /search?q=: repo names and descriptions (case-insensitive), then code via git grep
text tfsr1 "<h1>Search</h1>\n"
text tfsr2 "<p class=\"muted\">Type a word in the search box: repository names and descriptions are matched, and code is searched with git grep on each public repository's default branch.</p>\n"
text tfsr3 "<h2>Repositories ("
text tfsr4 ")</h2>\n"
text tfsr5 "<p class=\"muted\">No repository name or description matches.</p>\n"
text tftsrch "Search"
fn flow c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end
fn fqcap to void
n = fqget tfq
if lt n 0
n = 0
end
m = ulong n
if gt m 200
m = 200
end
for i ulong m bound 256
put fq i get fval i
end
put fql 0 m
end
fn fsubat src ulong o ulong l ulong to bool
q = get fql 0
if or eq q 0 gt q l
ret false
end
for s ulong add sub l q 1 bound 70000
if fsubeq src add o s
ret true
end
end
ret false
end
fn fsubeq src ulong o ulong to bool
for k ulong get fql 0 bound 256
c = fsubb src add o k
if ne flow c flow get fq k
ret false
end
end
ret true
end
fn fsubb src ulong k ulong to uchar
if eq src 0
ret get fanm k
end
ret get fadesc k
end
fn fsrmatch i ulong to bool
if fsubat 0 get fano i get fanl i
ret true
end
ret fsubat 1 get fado i get fadl i
end
fn fsearch to void
fsetti tftsrch
fput tfsr1
if eq get fql 0 0
fput tfsr2
ret
end
n = ulong 0
for i ulong get fan 0 bound 64
if fsrmatch i
n = add n 1
end
end
fput tfsr3
fnum n
fput tfsr4
if eq n 0
fput tfsr5
else
fput tfulrep
for i ulong get fan 0 bound 64
if fsrmatch i
frepoli i
end
end
fput tfulend
end
fcodesr
end
note ---- code search: git grep -I -n -i -F --max-count=5 -e <q> <default ref> per repo, at most 100 hits
text tfcs1 "<h2>Code</h2>\n"
text tfcs2 "<p class=\"muted\">No code matches.</p>\n"
text tfcs3 "<div class=\"box\"><p><a href=\""
text tfcs4 "</a></p>\n"
text tfcs5 "</div>\n"
text tfcs6 "<p class=\"hit\"><a href=\""
text tfcs7 "</a>  "
text tfcs8 "</p>\n"
text tfcsblob "/blob/"
text tfcsl "#L"
text tfgrep "grep"
text tfgI "-I"
text tfgn "-n"
text tfgi "-i"
text tfgF "-F"
text tfgmax "--max-count=5"
text tfge "-e"
text tfcsmore "<p class=\"muted\">Showing the first 100 code matches.</p>\n"
global fhits ulong 1
fn fcodesr to void
fput tfcs1
put fhits 0 0
nscodesr
if eq get fhits 0 0
fput tfcs2
end
if ge get fhits 0 100
fput tfcsmore
end
end
fn fgreparg i ulong to void
fkgiti i
fka tfgrep
fka tfgI
fka tfgn
fka tfgi
fka tfgF
fka tfgmax
fka tfge
fkopen
for k ulong get fql 0 bound 256
fkc get fq k
end
fkopen
fkt tfrh
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
end
note fcsrepo: render repo i's git grep output (already in fxo, read by nodes/srch.om nsrun)
fn fcsrepo i ulong to void
ln = get fxol 0
if eq ln 0
ret
end
fput tfcs3
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fput tfowner
fputc 47
fputrn i
fput tfcs4
p = ulong 0
for it ulong 100000
if ge p ln
break
end
if ge get fhits 0 100
break
end
e = fleol p ln
fcshit i p e
p = add e 1
end
fput tfcs5
end
note fcshit: one line "refs/heads/<b>:<path>:<line>:<text>"; skip the ref prefix (len 11 + branch + 1)
fn fcshit i ulong p ulong e ulong to void
a = add add p 12 get fabl i
if ge a e
ret
end
c1 = fcolon a e
if ge c1 e
ret
end
c2 = fcolon add c1 1 e
if ge c2 e
ret
end
put fhits 0 add get fhits 0 1
fput tfcs6
fputb
fput tfowner
fputc 47
fputrn i
fput tfcsblob
fputbr i
fputc 47
fxesc a sub c1 a
fput tfcsl
fxesc add c1 1 sub sub c2 c1 1
fput tfqgt
fxesc a sub c1 a
fputc 58
fxesc add c1 1 sub sub c2 c1 1
fput tfcs7
m = sub sub e c2 1
if gt m 300
m = 300
end
fxesc add c2 1 m
fput tfcs8
end
fn fcolon a ulong e ulong to ulong
note the bound is the size of fxo: a path in a search hit can be longer than 100,000 bytes
j = a
while lt j e bound 16777216
if eq get fxo j 58
ret j
end
j = add j 1
end
ret e
end

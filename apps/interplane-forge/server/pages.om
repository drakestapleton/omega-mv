note forged server/pages.om: layout (header, footer), error pages, /explore, /<owner>, /search,
note the repo header used by every repo tab, and the stylesheet. Writes fob through util.om helpers.
global fq uchar 256
global fql ulong 1
text tfpsrch "/search"
text tfulrep "<ul class=\"repos\">\n"
text tfempty ""
text tfccpub "public, max-age=300"
text tfctcss "text/css; charset=utf-8"
text tfh1 "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>"
text tfh2 " &#183; INTERPLANE Forge</title><link rel=\"stylesheet\" href=\""
text tfcssp "assets/forge.css"
text tfh3 "\"><link rel=\"icon\" type=\"image/svg+xml\" href=\""
text tficop "assets/favicon.svg"
text tfh3i "\">"
text tfh3b "</head>\n<body><a class=\"skip\" href=\"#main\">Skip to content</a>"
text tfhal1 "<link rel=\"alternate\" type=\"application/json\" href=\""
text tfhal2 "explore.json"
text tfhal3 ".json"
note ---- the site chrome: the interplane.io header and footer (content/_layout.html of the interplane.io
note repository, release build) with every site link made absolute, so the same bytes serve the bases
note / and /forge/. Forge is the current section. server/tests/sitechrome.sh fails when the labels or
note targets here, or the copied stylesheet lines below, differ from the interplane.io source.
text tfsh "<header class=\"site-head\"><div class=\"shell head-row\"><a class=\"brand\" href=\"https://interplane.io/\" aria-label=\"Interplane home\"><svg class=\"mark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2v20M2 12h20M4.9 4.9l14.2 14.2M4.9 19.1L19.1 4.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg><span>interplane<i class=\"dot\">.</i></span></a><nav aria-label=\"Main\"><a href=\"https://interplane.io/yard/\">Yard</a><a href=\"https://interplane.io/how-it-works/\">How it works</a><a href=\"https://interplane.io/evidence/\">Evidence</a><a href=\"https://interplane.io/receipts/\">Receipts</a><a href=\"https://interplane.io/mission/\">Mission</a><a href=\"https://interplane.io/explore\" aria-current=\"true\">Forge</a></nav><a class=\"button dark small\" href=\"https://interplane.io/contribute/\">Bring your slop</a></div></header>\n"

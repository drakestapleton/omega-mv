note forged server/pages.om: layout (header, footer), error pages, /explore, /<owner>, /search,
note the repo header used by every repo tab, and the stylesheet. Writes fob through util.om helpers.
global fq uchar 256
global fql ulong 1
text tfpsrch "/search"
text tfulrep "<ul class=\"repos\">\n"
text tfempty ""
text tfccpub "public, max-age=300"
text tfctcss "text/css; charset=utf-8"
text tfh1 "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light dark\"><title>"
text tfh2 " &#183; INTERPLANE Forge</title><link rel=\"stylesheet\" href=\""
text tfcssp "assets/forge.css"
text tfh3 "\"></head>\n<body"
text obbody " class=\"ob-page\""
text tfh3b "><header class=\"top\"><a class=\"logo\" href=\""
text tfh4 "\">INTERPLANE</a><nav class=\"nav\"><a href=\""
text tfexp "explore"
text tfh5 "\">Explore</a></nav><form class=\"search\" method=\"get\" action=\""
text tfsrch "search"
text tfh6 "\" role=\"search\"><input type=\"search\" name=\"q\" maxlength=\"200\" placeholder=\"Search the forge\" aria-label=\"Search the forge\" value=\""
text tfh7 "\"><button type=\"submit\">Search</button></form><div class=\"who\">"
text tfsignin "\">Sign in</a>"
text tfahref "<a href=\""
text tfqgt "\">"
text tfaend "</a>"
text tfso1 "<form class=\"inline\" method=\"post\" action=\""
text tflogout "logout"
text tflogin "login"
text tfso2 "\"><input type=\"hidden\" name=\"csrf\" value=\""
text tfso3 "\"><button type=\"submit\">Sign out</button></form>"
text tfh8 "</div></header>\n<main>\n"
text tff1 "\n</main>\n<footer class=\"foot\"><p>INTERPLANE Forge: agents express intent; the forge retains authority. Built on Radicle (Heartwood): repositories are Radicle projects served by forged, a seeded-Omega web server, with no JavaScript.</p><p><a href=\""
text tff2 "\">Explore</a> &#183; <a href=\""
text tff3 "\">Search</a> &#183; <a href=\""
text tfstars "stars"
text tff4 "\">Stars</a></p></footer>\n</body></html>\n"
text tfq "q"
note ---- error pages
text tfe1 "<section class=\"err\"><h1>"
text tfe2 "</h1><p>"
text tfe3 "</p><p><a href=\""
text tfe4 "\">Back to the forge</a></p></section>"
text tfm400 "Bad request. The forge refused this request."
text tfm403 "Forbidden. The form token did not match; reload the page and try again."
text tfm404 "Not found. This page does not exist, or the repository is not public on this forge."
text tfm405 "Method not allowed."
text tfm413 "The request body is too large."
text tfm429 "Too many write requests from this address. Wait a minute and try again."
text tfm500 "The forge hit an internal error serving this page."
text tfm501 "Coming soon. This part of the forge is being built and is not served yet; the feature list says what works today."
text tfmoth "The forge could not serve this request."
text tft400 "Bad request"
text tft403 "Forbidden"
text tft404 "Not found"
text tft405 "Method not allowed"
text tft413 "Too large"
text tft429 "Slow down"
text tft500 "Server error"
text tft501 "Coming soon"
fn ferrmsg st ulong to void
if eq st 400
fput tfm400
ret
end
if eq st 403
fput tfm403
ret
end
if eq st 404
fput tfm404
ret
end
if eq st 405
fput tfm405
ret
end
if eq st 413
fput tfm413
ret
end
if eq st 429
fput tfm429
ret
end
if eq st 500
fput tfm500
ret
end
if eq st 501
fput tfm501
ret
end
fput tfmoth
end
fn ferrti st ulong to void
if eq st 400
fsetti tft400
ret
end
if eq st 403
fsetti tft403
ret
end
if eq st 404
fsetti tft404
ret
end
if eq st 405
fsetti tft405
ret
end
if eq st 413
fsetti tft413
ret
end
if eq st 429
fsetti tft429
ret
end
if eq st 501
fsetti tft501
ret
end
fsetti tft500
end
fn ferrpage st ulong to void
put fkind 0 0
put fobl 0 0
ferrti st
fput tfe1
fnum st
fputc 32
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfe2
ferrmsg st
fput tfe3
fputb
fput tfe4
end
note ---- layout: appended AFTER the fragment; main.om sends head, fragment, foot in that order
fn fwho to void
if eq get fuserl 0 0
fput tfahref
fputb
fput tflogin
fput tfsignin
ret
end
fput tfahref
fputb
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfqgt
for i ulong get fuserl 0 bound 64
fescc get fuser i
end
fput tfaend
fputc 32
fput tfso1
fputb
fput tflogout
fput tfso2
for i ulong get fcsrfl 0 bound 64
fescc get fcsrf i
end
fput tfso3
end
fn fhead to void
fput tfh1
for i ulong get ftil 0 bound 256
fescc get fti i
end
fput tfh2
fputb
fput tfcssp
fput tfh3
if eq get fpathl 0 1
fput obbody
end
fput tfh3b
fputb
fput tfh4
fputb
fput tfexp
fput tfh5
fputb
fput tfsrch
fput tfh6
fhdq
fput tfh7
fwho
fput tfh8
end
note fhdq: echo the search query into the header box on /search
fn fhdq to void
if not fpeq tfpsrch
ret
end
for i ulong get fql 0 bound 256
fescc get fq i
end
end
fn ffoot to void
fput tff1
fputb
fput tfexp
fput tff2
fputb
fput tfsrch
fput tff3
fputb
fput tfstars
fput tff4
end
note ---- the stylesheet (served at <base>assets/forge.css)
text tfcss1 ":root{--bg:#fbfbf8;--fg:#1d1f21;--mut:#5f6368;--line:#d9d9d4;--acc:#1f5fbf;--box:#f1f1ec;--ok:#1d7a3a;--bad:#a8261b}\n@media (prefers-color-scheme:dark){:root{--bg:#121417;--fg:#e4e6e8;--mut:#9aa0a6;--line:#2d3137;--acc:#7fb0ff;--box:#1b1f24;--ok:#5fc27e;--bad:#ff8a80}}\n*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\na{color:var(--acc);text-decoration:none}a:hover{text-decoration:underline}\ncode,pre,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px}\npre{background:var(--box);border:1px solid var(--line);padding:12px;overflow:auto;border-radius:6px}\n"
text tfcss2 ".top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:10px 20px;border-bottom:1px solid var(--line)}\n.logo{font-weight:800;letter-spacing:.18em;color:var(--fg)}\n.nav a{margin-right:12px}.search{display:flex;gap:6px;flex:1;min-width:200px;max-width:460px}\n.search input{flex:1;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg)}\nbutton{padding:5px 10px;border:1px solid var(--line);border-radius:6px;background:var(--box);color:var(--fg);cursor:pointer;font:inherit}\n.who{margin-left:auto}.inline{display:inline}\nmain{max-width:1040px;margin:0 auto;padding:20px}\n.foot{max-width:1040px;margin:30px auto;padding:16px 20px;border-top:1px solid var(--line);color:var(--mut);font-size:13px}\n"
text tfcss3 ".muted,.meta{color:var(--mut)}.meta{font-size:13px;margin:2px 0}\n.repos{list-style:none;padding:0;margin:0}.repos li{padding:14px 0;border-bottom:1px solid var(--line)}\n.rname{font-size:17px;font-weight:600}.desc{margin:4px 0}.stars{float:right;color:var(--mut)}\n.rhead h1{font-size:22px;margin:0 0 4px;font-weight:500}.rhead h1 b{font-weight:700}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;border-bottom:1px solid var(--line);margin:14px 0 18px}\n.tabs a{padding:8px 12px;border-bottom:2px solid transparent;color:var(--fg)}.tabs a.on{border-bottom-color:var(--acc);font-weight:600}\n.clone{background:var(--box);border:1px solid var(--line);border-radius:6px;padding:6px 10px;display:inline-block}\n"
text tfcss4 ".bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}\ntable{border-collapse:collapse;width:100%}td,th{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n.err h1{font-size:26px}.box{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}\n.ok{color:var(--ok)}.bad{color:var(--bad)}.hit{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}\ninput[type=text],textarea{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg);font:inherit}\n@media (max-width:640px){main{padding:12px}.top{padding:8px 12px}.who{margin-left:0}.stars{float:none;display:block}.tabs a{padding:6px 8px}}\n"
text tfcss5 ".releases .release{border:1px solid var(--line);border-radius:6px;padding:12px 16px;margin:12px 0}.release h3{margin:0 0 4px}\n.label{display:inline-block;padding:0 8px;border:1px solid var(--line);border-radius:10px;font-size:12px;color:var(--mut);margin-right:4px}\n.subject{font-weight:600}.notes{white-space:pre-wrap}.assets td:last-child{text-align:right;color:var(--mut)}\n.pager{display:flex;gap:12px;margin:14px 0}.empty{color:var(--mut)}\ndiv.clone{display:block;padding:10px 14px;margin:14px 0}div.clone h3{margin:0 0 6px;font-size:15px}div.clone dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:4px 14px}div.clone dt{color:var(--mut)}div.clone dd{margin:0;overflow-wrap:anywhere}\n"
text tfcss6 ".md{line-height:1.6;overflow-wrap:break-word}.md img{max-width:100%}.md table{width:auto}.md-l{text-align:left}.md-c{text-align:center}.md-r{text-align:right}.md blockquote{margin:0;padding:0 12px;border-left:3px solid var(--line);color:var(--mut)}\n.so-bar,.so-tabs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}.so-form{display:inline}.so-btn{padding:3px 10px}.so-n{color:var(--mut);margin-left:4px}.so-on{font-weight:600}\n.so-muted{color:var(--mut)}.so-err{color:var(--bad)}.so-list{list-style:none;padding:0}.so-list li{padding:6px 0;border-bottom:1px solid var(--line)}.so-cmd{display:block;white-space:pre-wrap;background:var(--box);border:1px solid var(--line);border-radius:6px;padding:8px}.so-steps li{margin:6px 0}.so-f{margin:10px 0}\n"
text tfcss7 ".crumbs{margin:8px 0;font-size:15px}.ref{display:inline-block;padding:2px 8px;border:1px solid var(--line);border-radius:6px;background:var(--box);font-size:13px;margin-right:8px}\n.latest{border:1px solid var(--line);border-bottom:0;border-radius:6px 6px 0 0;padding:8px 12px;background:var(--box);font-size:13px;color:var(--mut)}\n.files{margin-top:0}.files .dir a{font-weight:600}.files .sz{text-align:right;color:var(--mut);white-space:nowrap}\n.readme{border:1px solid var(--line);border-radius:6px;padding:16px 24px;margin:16px 0}table.md{width:auto}table.md td,table.md th{border:1px solid var(--line)}\n.code{border:1px solid var(--line);border-radius:6px;overflow-x:auto;font-family:ui-monospace,Menlo,monospace;font-size:13px}.code td{border:0;padding:0 8px;line-height:1.5}\n.ln{text-align:right;color:var(--mut);user-select:none;-webkit-user-select:none;width:1%;white-space:nowrap}.lc{white-space:pre}.img img{max-width:100%}\n"
text tfcss8 ".commits{list-style:none;padding:0;margin:0;border:1px solid var(--line);border-radius:6px}.commits li{padding:8px 12px;border-bottom:1px solid var(--line)}.commits li:last-child{border-bottom:0}\n.box.commit h2{margin:0 0 6px;font-size:18px}pre.msg{white-space:pre-wrap;background:none;border:0;padding:0;margin:6px 0}.stat{font-size:13px;color:var(--mut)}table.stat{width:auto}table.stat td{padding:2px 8px}\n.df{border:1px solid var(--line);border-radius:6px;margin:14px 0;overflow-x:auto}.dfh{padding:6px 12px;background:var(--box);border-bottom:1px solid var(--line);font-family:ui-monospace,Menlo,monospace;font-size:13px}\ntable.diff{font-family:ui-monospace,Menlo,monospace;font-size:13px}table.diff td{border:0;padding:0 8px}td.dc{white-space:pre}tr.da{background:rgba(46,160,67,.15)}tr.dd{background:rgba(248,81,73,.15)}tr.dh,tr.dm{background:var(--box);color:var(--mut)}\ntable.refs td{white-space:nowrap}.badge{display:inline-block;padding:0 8px;border:1px solid var(--acc);border-radius:10px;font-size:12px;color:var(--acc);margin-left:6px}\ntable.code.blame td.bl{white-space:nowrap;color:var(--mut);font-size:12px;border-right:1px solid var(--line);width:1%}tr.bs td{border-top:1px solid var(--line)}p.hit{margin:2px 0}form.inline{display:inline}\n"
text obcss "/* Observatory comparison candidate */ body.ob-page .search input{min-width:0;width:100%}\nbody.ob-page{--bg:#101716;--fg:#e8eee8;--mut:#a1afa7;--line:#33413b;--acc:#d7f79b;--box:#1a2520;--ok:#d7f79b;--bad:#ffb6a3;color-scheme:dark}body.ob-page{background:radial-gradient(ellipse at 80% 10%,#25382c 0,transparent 45%),var(--bg)}body.ob-page main{max-width:1320px;padding:32px}body.ob-page .top{padding:20px 32px;background:#101716}body.ob-page .logo{font-size:13px;letter-spacing:.2em}body.ob-page .search{margin-left:auto;max-width:340px}body.ob-page .who{margin-left:12px}body.ob-page .foot{max-width:1256px}.ob{--accent:#d7f79b}.ob a:focus-visible,.ob button:focus-visible,.ob select:focus-visible{outline:3px solid #d7f79b;outline-offset:5px}.ob .eyebrow{font:11px ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase;color:#b0c3b4}.ob .hero{display:grid;grid-template-columns:1.2fr 1fr;gap:50px;padding:42px 0 58px;border-bottom:1px solid var(--line)}.ob h1{font-weight:450;font-size:clamp(42px,5.4vw,76px);line-height:1.02;letter-spacing:-.055em;margin:22px 0}.ob h1 em{font-style:normal;color:var(--accent)}.ob .lede{max-width:490px;font-size:17px;line-height:1.7;color:var(--mut)}.ob .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.ob .cta{display:inline-block;padding:12px 18px;border:1px solid #4b6051;border-radius:5px;color:var(--fg);font-size:13px}.ob .primary{background:var(--accent);color:#19231a;border-color:var(--accent);font-weight:600}.ob .signal{background:linear-gradient(150deg,#233429,#141e19);border:1px solid #425646;border-radius:14px;padding:25px;align-self:center;box-shadow:0 30px 60px #0003}.ob .signal-top{display:flex;justify-content:space-between;font:11px ui-monospace,monospace;color:#b3c6b9}.ob .orb{margin:28px auto;width:155px;height:155px;border:1px solid #829c68;border-radius:50%;display:grid;place-items:center;box-shadow:0 0 0 22px #a8c88508,0 0 0 44px #a8c88505;background:radial-gradient(circle,#5e784f55,transparent 70%);font:48px Georgia,serif;color:var(--accent)}.ob .signal-flow{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:32px}.ob .signal-flow span{border-top:1px solid #52664f;padding-top:12px;font:11px ui-monospace,monospace;text-align:center}.ob .caption{font-size:12px;color:var(--mut);margin-top:22px}.ob .subnav{display:flex;gap:26px;padding:22px 0;border-bottom:1px solid var(--line);font-size:13px;flex-wrap:wrap}.ob section{scroll-margin-top:20px}.ob .section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:46px 0 20px}.ob h2{font-size:27px;letter-spacing:-.03em;font-weight:500;margin:7px 0}.ob .section-head p{font-size:13px;color:var(--mut);max-width:400px}.ob .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.ob .card{background:#19241e;border:1px solid var(--line);border-radius:8px;padding:23px;display:flex;flex-direction:column;min-width:0}.ob .index{font:12px ui-monospace,monospace;color:#94ad86}.ob h3{font-size:18px;font-weight:500;margin:20px 0 8px}.ob .card p{font-size:13px;color:var(--mut);line-height:1.7;flex:1}.ob .card a{font-size:12px;padding-top:16px;border-top:1px solid var(--line)}.ob .tag{font:10px ui-monospace,monospace;letter-spacing:.04em;color:#afbdaf}.ob .lab{display:grid;grid-template-columns:1fr 1fr;gap:24px;border:1px solid #455940;background:#1b281f;border-radius:8px;padding:28px}.ob .lab p{font-size:14px;color:var(--mut)}.ob select{display:block;width:100%;max-width:450px;padding:12px;margin:10px 0 16px;background:#101a14;color:var(--fg);border:1px solid #64755e;border-radius:5px;font:inherit}.ob .receipt{background:#101a14;border:1px solid #43583e;border-radius:6px;padding:22px;overflow-wrap:anywhere}.ob .receipt strong{display:block;font-size:25px;font-weight:500;margin:15px 0}.ob .receipt dl{font:12px/1.7 ui-monospace,monospace}.ob .receipt dt{color:var(--mut);margin-top:10px}.ob .receipt dd{margin:0}.ob .receipt .deny{color:#ffb6a3}.ob .trail{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden}.ob .trail article{padding:25px;background:#17221c}.ob .trail p{font-size:13px;color:var(--mut)}.ob details{border-bottom:1px solid var(--line);padding:18px 0}.ob summary{cursor:pointer;font-size:14px}.ob details p{color:var(--mut);font-size:14px;max-width:850px}.ob .endcap{margin:48px 0 8px;padding:30px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}.ob .endcap p{font-size:14px;color:var(--mut)}@media(max-width:850px){.ob .hero,.ob .lab{grid-template-columns:1fr}.ob .grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ob .signal{max-width:100%;width:100%}.ob .hero{gap:20px}.ob .section-head{display:block}.ob .trail{grid-template-columns:1fr}body.ob-page main{padding:20px}body.ob-page .top{padding:16px}}@media(max-width:480px){.ob .grid{grid-template-columns:1fr}.ob .endcap{display:block}.ob .lab{padding:18px}.ob .subnav{gap:16px}body.ob-page .who{margin-left:0}body.ob-page .search{min-width:160px}.ob .signal{padding:20px}}@media(prefers-reduced-motion:reduce){.ob *{scroll-behavior:auto}}\n"
fn fcssout to void
put fkind 0 1
fsetct tfctcss
fsetcc tfccpub
fput tfcss1
fput tfcss2
fput tfcss3
fput tfcss4
fput tfcss5
fput tfcss6
fput tfcss7
fput tfcss8
fput obcss
end
note ---- repo list item, shared by explore, profile and search
text tfli1 "<li><span class=\"stars\" title=\"stars\">&#9733; "
text tfli2 "</span><a class=\"rname\" href=\""
text tfli3 "</a><p class=\"desc\">"
text tfli4 "</p><p class=\"meta\">Last commit: "
text tfli5 "</p></li>\n"
text tfnodesc "<span class=\"muted\">No description.</span>"
text tfnolc "unknown"
fn frepoli i ulong to void
fput tfli1
fnum sostarn i
fput tfli2
fputb
fput tfowner
fputc 47
fputrn i
fput tfqgt
fput tfowner
fputc 47
fputrn i
fput tfli3
if eq get fadl i 0
fput tfnodesc
else
fdesc i
end
fput tfli4
if eq get falcl i 0
fput tfnolc
else
fputlc i
end
fput tfli5
end
note ---- /explore (also the forge home /)
text tfex1 "<h1>Explore repositories</h1><p class=\"muted\">"
text tfex2 " public repositories on this forge, newest table order. Every one is a Radicle project; clone with <code>rad clone rad:&lt;RID&gt;</code>.</p>\n<ul class=\"repos\">\n"
text tfulend "</ul>\n"
text tfhome1 "<section class=\"box\"><h1>INTERPLANE Forge</h1><p>Agents express intent. The forge retains authority. Browse code, download archives, follow patches and issues, and star the projects you care about.</p></section>\n"
text tftexp "Explore"
text tfthome "Home"
fn fexplore home bool to void
if home
fsetti tfthome
fput tfhome1
else
fsetti tftexp
end
fput tfex1
fnum get fan 0
fput tfex2
for i ulong get fan 0 bound 64
frepoli i
end
fput tfulend
end
note ---- /<owner> profile (the node delegate is the only owner)
text tfpr1 "<section class=\"rhead\"><h1><b>"
text tfpr2 "</b></h1><p class=\"muted mono\">did:key:"
text tfpr3 "</p><p><a href=\""
text tfpfol "/followers"
text tfpr4 " followers</a> &#183; <a href=\""
text tfpfg "/following"
text tfpr5 " following</a> &#183; "
text tfpr6 " stars received &#183; "
text tfpr7 " favorites received</p><div class=\"bar\">"
text tfpr8 "</div></section>\n<h2>Repositories ("
text tfpr9 ")</h2>\n<ul class=\"repos\">\n"
text tfpr10 "<h2>Starred</h2>\n"
fn fstarsum to ulong
s = ulong 0
for i ulong get fan 0 bound 64
s = add s sostarn i
end
ret s
end
fn ffavsum to ulong
s = ulong 0
for i ulong get fan 0 bound 64
s = add s sofavn i
end
ret s
end
fn fprofile to void
fsetti tfowner
fput tfpr1
fput tfowner
fput tfpr2
fput tfnid
fput tfpr3
fputb
fput tfowner
fput tfpfol
fput tfqgt
fnum sofolln
fput tfpr4
fputb
fput tfowner
fput tfpfg
fput tfqgt
fnum sofollg
fput tfpr5
fnum fstarsum
fput tfpr6
fnum ffavsum
fput tfpr7
sofolbar
fput tfpr8
fnum get fan 0
fput tfpr9
for i ulong get fan 0 bound 64
frepoli i
end
fput tfulend
fput tfpr10
sostarsof
end
note ---- repo header: title, description, social bar, clone line, tabs
text tfrh1 "<section class=\"rhead\"><h1><a href=\""
text tfrh2 "</a> / <b><a href=\""
text tfrh3 "</a></b></h1><p class=\"desc\">"
text tfrh4 "</p><div class=\"bar\">"
text tfrh5 "<span class=\"clone mono\">rad clone rad:"
text tfrh6 "</span></div></section>\n<nav class=\"tabs\">"
text tfrh7 "</nav>\n"

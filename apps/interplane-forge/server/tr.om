note forged server/tr.om (TranslateConnector, 2026-11-11): translation hints on every HTML page.
note Readers translate pages with their own browser or tool; forged translates nothing and stores no
note translation. This unit only marks what must be copied exactly, so a translator leaves it alone:
note 1. every opening code, pre, kbd and samp tag, and every tag whose class names the token mono,
note    files, brand (the Interplane name) or rname (a project name in a list), gets translate="no"
note    (unless it already has a translate attribute);
note 2. in text outside tags, a word that is a hex hash (7 or more of 0-9 a-f, at least one digit) or
note    a Radicle id (z then 28 or more base58 letters with a digit and a capital) is wrapped in
note    <span translate="no">...</span>; "rad:" or "did:key:" before an id stays outside the span.
note Text inside title, textarea, option, script and style is copied unchanged.
note fsend0 (server/main.om) runs ftrrun twice over each part of the page (head, fragment, foot): mode 0 counts the
note bytes for Content-Length, mode 1 sends them through a 32 KiB chunk. Both passes run the same
note code, so the length always matches the body. Gate: server/tests/translate.sh.
note ftrq: 0 chunk fill, 1 bytes counted, 2 mode (0 count, 1 send), 3 raw element open (1 or 0)
global ftrq ulong 4
note ftrer: the first negative hput result of a send pass, else 0
global ftrer long 1
text tftrno " translate=\"no\""
text tftrsp "<span translate=\"no\">"
text tftrse "</span>"
text tftrat " translate="
text tftrcl "class=\""
text tftrcod "code"
text tftrpre "pre"
text tftrkbd "kbd"
text tftrsmp "samp"
text tftrmon "mono"
text tftrfil "files"
text tftrbrd "brand"
text tftrrnm "rname"
text tftrtit "title"
text tftrtxa "textarea"
text tftropt "option"
text tftrscr "script"
text tftrsty "style"
text tftrcm "-->"
fn ftrfl cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 n ulong to void
r = hput cs io view part ch 0 n
if lt r 0
if eq get ftrer 0 0
put ftrer 0 r
end
end
end
fn ftrb cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 b uchar to void
put ftrq 1 add get ftrq 1 1
if eq get ftrq 2 0
ret
end
p = get ftrq 0
put ch p b
p = add p 1
if eq p 32768
ftrfl cs io ch p
p = ulong 0
end
put ftrq 0 p
end
note ftrcp: emit fob[a, e)
fn ftrcp cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 a ulong e ulong to void
k = a
while lt k e bound 8388608
ftrb cs io ch get fob k
k = add k 1
end
end
fn ftrt cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 s view uchar * to void
for k ulong len s bound 4096
ftrb cs io ch get s k
end
end
fn ftrdig c uchar to bool
ret and ge c 48 le c 57
end
fn ftrlow c uchar to bool
ret and ge c 97 le c 122
end
fn ftrup c uchar to bool
ret and ge c 65 le c 90
end
fn ftralnum c uchar to bool
ret or ftrdig c or ftrlow c ftrup c
end
fn ftrhex c uchar to bool
ret or ftrdig c and ge c 97 le c 102
end
note base58: letters and digits except 0 O I l
fn ftrb58 c uchar to bool
x = or or eq c 48 eq c 79 or eq c 73 eq c 108
ret and ftralnum c not x
end
note ftrat: fob[a, a + len s) equals s, inside fob[0, e)
fn ftrat a ulong e ulong s view uchar * to bool
n = len s
if gt add a n e
ret false
end
for k ulong n bound 4096
if ne get fob add a k get s k
ret false
end
end
ret true
end
note ftrfind: first index in [a, e) where s starts and ends before e, else e
fn ftrfind a ulong e ulong s view uchar * to ulong
k = a
while lt k e bound 8388608
if ftrat k e s
ret k
end
k = add k 1
end
ret e
end
note ftrnm: fob[a, e) is exactly s
fn ftrnm a ulong e ulong s view uchar * to bool
if ne sub e a len s
ret false
end
ret ftrat a e s
end
note ftrcls: the tag fob[a, e) has class="..." with the token mono or files
fn ftrcls a ulong e ulong to bool
c = ftrfind a e tftrcl
if ge c e
ret false
end
k = add c 7
s = k
while lt k e bound 8388608
b = get fob k
if or eq b 34 eq b 32
if or or ftrnm s k tftrmon ftrnm s k tftrfil or ftrnm s k tftrbrd ftrnm s k tftrrnm
ret true
end
if eq b 34
ret false
end
s = add k 1
end
k = add k 1
end
ret false
end
note ftrnotr: the opening tag named fob[a, n), ending at e, gets translate="no"
fn ftrnotr a ulong n ulong e ulong to bool
if lt ftrfind n e tftrat e
ret false
end
c = or or ftrnm a n tftrcod ftrnm a n tftrpre or ftrnm a n tftrkbd ftrnm a n tftrsmp
ret or c ftrcls n e
end
fn ftrraw a ulong n ulong to bool
c = or or ftrnm a n tftrtit ftrnm a n tftrtxa or ftrnm a n tftropt ftrnm a n tftrscr
ret or c ftrnm a n tftrsty
end
note ftrcmt: fob[j] starts "!--" (j is the byte after '<')
fn ftrcmt j ulong l ulong to bool
if ge add j 2 l
ret false
end
if ne get fob j 33
ret false
end
if ne get fob add j 1 45
ret false
end
ret eq get fob add j 2 45
end
note ftrtend: the index after the tag that starts at fob[i] = '<': a comment ends after "-->", any
note other tag after '>'; l when it does not end before l
fn ftrtend i ulong l ulong to ulong
j = add i 1
if ge j l
ret l
end
if ftrcmt j l
e = ftrfind add j 3 l tftrcm
ret hmin l add e 3
end
e = j
while lt e l bound 8388608
if eq get fob e 62
ret add e 1
end
e = add e 1
end
ret l
end
note ftrnend: the end of the tag name that starts at a (letters and digits)
fn ftrnend a ulong e ulong to ulong
n = a
while lt n e bound 8388608
if not ftralnum get fob n
ret n
end
n = add n 1
end
ret n
end
note ftrtag: fob[i] is '<'; emit the tag and return the index after it. A comment, a declaration,
note a closing tag or a tag cut by l is copied as it is.
fn ftrtag cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 i ulong l ulong to ulong
e = ftrtend i l
j = add i 1
if or ge j e ne get fob sub e 1 62
ftrcp cs io ch i e
ret e
end
if eq get fob j 47
if ftrraw add j 1 ftrnend add j 1 e
put ftrq 3 0
end
ftrcp cs io ch i e
ret e
end
n = ftrnend j e
if or eq n j ftrcmt j l
ftrcp cs io ch i e
ret e
end
if ftrraw j n
put ftrq 3 1
end
ftrcp cs io ch i n
if ftrnotr j n e
ftrt cs io ch tftrno
end
ftrcp cs io ch n e
ret e
end
fn ftrwc c uchar to bool
ret ftralnum c
end
note ftrid: the word fob[s, e) is a hash or a Radicle id
fn ftrid s ulong e ulong to bool
a = s
n = sub e a
if lt n 7
ret false
end
hx = true
dg = false
b58 = true
up = false
k = a
while lt k e bound 8388608
c = get fob k
if not ftrhex c
hx = false
end
if not ftrb58 c
b58 = false
end
if ftrdig c
dg = true
end
if ftrup c
up = true
end
k = add k 1
end
if and hx dg
ret true
end
if ne get fob a 122
ret false
end
ok = and b58 ge n 29
ret and ok and dg up
end
note ftrtxt: emit the text from fob[i] up to the next '<' (or l); return where it stopped
fn ftrtxt cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 i ulong l ulong to ulong
k = i
while lt k l bound 8388608
c = get fob k
if eq c 60
ret k
end
if not ftrwc c
ftrb cs io ch c
k = add k 1
continue
end
s = k
while lt k l bound 8388608
if not ftrwc get fob k
break
end
k = add k 1
end
e = k
while gt e s bound 8388608
if ne get fob sub e 1 58
break
end
e = sub e 1
end
if and eq get ftrq 3 0 ftrid s e
ftrt cs io ch tftrsp
ftrcp cs io ch s e
ftrt cs io ch tftrse
ftrcp cs io ch e k
else
ftrcp cs io ch s k
end
end
ret k
end
note ftrrun: mode 0 returns the byte count of the marked range fob[a, e); mode 1 sends it and
note returns 0 or the first negative hput result
fn ftrrun cs edit ulong 320 io edit uchar 131072 a ulong e ulong mode ulong to long
ch = new uchar 32768 0
put ftrq 0 0
put ftrq 1 0
put ftrq 2 mode
put ftrq 3 0
put ftrer 0 0
i = a
while lt i e bound 8388608
if eq get fob i 60
i = ftrtag cs io ch i e
else
i = ftrtxt cs io ch i e
end
end
if eq mode 0
ret long get ftrq 1
end
if gt get ftrq 0 0
ftrfl cs io ch get ftrq 0
end
ret get ftrer 0
end
note ---- plain-text rendering: any HTML page with the query format=text (docs/API.md). The page's
note own content (no site header or footer) as text for reading tools and agents that translate it
note themselves. Inline code and the hashes and ids found above are in backticks, pre blocks in ```
note fences, a link's target follows its text in <...>; nothing is translated or stored here.
note ftxs: 0 last byte, 1 pre depth, 2 pending space, 3 link start, 4 skipped element depth,
note 5 newlines in a row, 6 code depth, 7 link end, 8 end of the tag ftxel acts on, 9 inside a
note span of class mono (sent as inline code)
global ftxs ulong 10
text tftxct "text/plain; charset=utf-8"
text tftxfmt "format"
text tftxval "text"
text tftxpre "Interplane page as plain text, for reading tools and agents. English is the reference text: translate it with your own tool. Text in backticks and in ``` blocks (commands, fingerprints, file names) and link targets in <...> are exact: copy them, never translate them.\nPage: "
text tftxfen "```"
text tftxhr "href=\""
text tftxamp "&amp;"
text tftxa "a"
text tftxbr "br"
text tftxli "li"
text tftxtd "td"
text tftxth "th"
text tftxsvg "svg"
text tftxspan "span"
text tftxp "p"
text tftxdiv "div"
text tftxtr "tr"
text tftxsec "section"
text tftxart "article"
text tftxul "ul"
text tftxol "ol"
text tftxdl "dl"
text tftxdt "dt"
text tftxdd "dd"
text tftxtab "table"
text tftxbq "blockquote"
text tftxhrt "hr"
text tftxmain "main"
text tftxhead "header"
text tftxfoot "footer"
text tftxnav "nav"
text tftxfrm "form"
text tftxent1 "amp"
text tftxent2 "lt"
text tftxent3 "gt"
text tftxent4 "quot"
text tftxent5 "apos"
text tftxent6 "nbsp"
text tftxent7 "middot"
text tftxent8 "trade"
text tftxent9 "mdash"
text tftxen10 "ndash"
text tftxen11 "hellip"
text tftxen12 "rarr"
text tftxen13 "larr"
text tftxen14 "copy"
text tftxen15 "times"
note ftxwant: the query names format=text
fn ftxwant to bool
n = fqget tftxfmt
if ne n long len tftxval
ret false
end
for k ulong len tftxval
if ne get fval k get tftxval k
ret false
end
end
ret true
end
fn ftxws c uchar to bool
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end
note ftxraw: emit c as it is (pre text, the page line, fences)
fn ftxraw cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 c uchar to void
if eq c 10
put ftxs 5 add get ftxs 5 1
else
put ftxs 5 0
end
put ftxs 0 ulong c
ftrb cs io ch c
end
note ftxo: emit c outside pre; no newline before the first text, at most one empty line
fn ftxo cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 c uchar to void
if eq c 10
if or eq get ftxs 0 0 ge get ftxs 5 2
ret
end
end
ftxraw cs io ch c
end
note ftxch: one text byte; outside pre a run of white space is one space, none after a newline
fn ftxch cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 c uchar to void
if ne get ftxs 1 0
ftxraw cs io ch c
ret
end
if ftxws c
put ftxs 2 1
ret
end
if ne get ftxs 2 0
put ftxs 2 0
b = get ftxs 0
if and ne b 0 and ne b 10 ne b 32
ftxo cs io ch 32
end
end
ftxo cs io ch c
end
fn ftxnl cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 to void
put ftxs 2 0
if ne get ftxs 1 0
ftxraw cs io ch 10
ret
end
ftxo cs io ch 10
end
fn ftxrt cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 s view uchar * to void
for k ulong len s bound 4096
ftxraw cs io ch get s k
end
end
fn ftxct cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 s view uchar * to void
for k ulong len s bound 4096
ftxch cs io ch get s k
end
end
note ftxcps: the text bytes fob[a, e)
fn ftxcps cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 a ulong e ulong to void
k = a
while lt k e bound 8388608
ftxch cs io ch get fob k
k = add k 1
end
end
note ftxu8: code point v as UTF-8
fn ftxu8 cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 v ulong to void
if lt v 128
ftxch cs io ch uchar v
ret
end
if lt v 2048
ftxch cs io ch uchar or 192 shr v 6
ftxch cs io ch uchar or 128 and v 63
ret
end
if lt v 65536
ftxch cs io ch uchar or 224 shr v 12
ftxch cs io ch uchar or 128 and shr v 6 63
ftxch cs io ch uchar or 128 and v 63
ret
end
ftxch cs io ch uchar or 240 shr v 18
ftxch cs io ch uchar or 128 and shr v 12 63
ftxch cs io ch uchar or 128 and shr v 6 63
ftxch cs io ch uchar or 128 and v 63
end
note ftxnum: the number of the entity name fob[a, e) after '#' (decimal, or x then hex); 0 when it
note is not one
fn ftxnum a ulong e ulong to ulong
k = a
hx = false
if lt k e
if or eq get fob k 120 eq get fob k 88
hx = true
k = add k 1
end
end
if ge k e
ret 0
end
v = ulong 0
while lt k e bound 8388608
c = get fob k
d = ulong 99
if ftrdig c
d = sub ulong c 48
end
if hx
if and ge c 97 le c 102
d = sub ulong c 87
end
if and ge c 65 le c 70
d = sub ulong c 55
end
end
b = ulong 10
if hx
b = 16
end
if ge d b
ret 0
end
v = add mul v b d
if gt v 1114111
ret 0
end
k = add k 1
end
ret v
end
note ftxnam: the code point of a named entity fob[a, e); 0 when not known
fn ftxnam a ulong e ulong to ulong
if ftrnm a e tftxent1
ret 38
end
if ftrnm a e tftxent2
ret 60
end
if ftrnm a e tftxent3
ret 62
end
if ftrnm a e tftxent4
ret 34
end
if ftrnm a e tftxent5
ret 39
end
if ftrnm a e tftxent6
ret 32
end
if ftrnm a e tftxent7
ret 183
end
if ftrnm a e tftxent8
ret 8482
end
if ftrnm a e tftxent9
ret 8212
end
if ftrnm a e tftxen10
ret 8211
end
if ftrnm a e tftxen11
ret 8230
end
if ftrnm a e tftxen12
ret 8594
end
if ftrnm a e tftxen13
ret 8592
end
if ftrnm a e tftxen14
ret 169
end
if ftrnm a e tftxen15
ret 215
end
ret 0
end
note ftxent: fob[k] is '&'; emit the character and return the index after the entity. An entity
note that is not known is text: '&' alone is emitted and the rest follows as text.
fn ftxent cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 k ulong l ulong to ulong
m = hmin l add k 34
s = add k 1
while lt s m bound 64
if eq get fob s 59
break
end
s = add s 1
end
if ge s m
ftxch cs io ch 38
ret add k 1
end
v = ulong 0
if and lt add k 1 s eq get fob add k 1 35
v = ftxnum add k 2 s
else
v = ftxnam add k 1 s
end
if eq v 0
ftxch cs io ch 38
ret add k 1
end
ftxu8 cs io ch v
ret add s 1
end
note ftxlink: the link target fob[a, e) after its text, &amp; read as &
fn ftxlink cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 a ulong e ulong to void
if ge a e
ret
end
if eq get fob a 35
ret
end
put ftxs 2 1
ftxch cs io ch 60
k = a
while lt k e bound 8388608
if ftrat k e tftxamp
ftxch cs io ch 38
k = add k 5
else
ftxch cs io ch get fob k
k = add k 1
end
end
ftxo cs io ch 62
put ftxs 2 1
end
fn ftxblk a ulong n ulong to bool
c = or or ftrnm a n tftxp ftrnm a n tftxdiv or ftrnm a n tftxtr ftrnm a n tftxsec
c = or c or or ftrnm a n tftxart ftrnm a n tftxul or ftrnm a n tftxol ftrnm a n tftxdl
c = or c or or ftrnm a n tftxdt ftrnm a n tftxdd or ftrnm a n tftxtab ftrnm a n tftxbq
c = or c or or ftrnm a n tftxhrt ftrnm a n tftxmain or ftrnm a n tftxhead ftrnm a n tftxfoot
ret or c or ftrnm a n tftxnav ftrnm a n tftxfrm
end
note ftxhn: 1..6 for h1..h6, else 0
fn ftxhn a ulong n ulong to ulong
if ne sub n a 2
ret 0
end
if ne get fob a 104
ret 0
end
c = get fob add a 1
if and ge c 49 le c 54
ret sub ulong c 48
end
ret 0
end
note ftxel: the element named fob[a, n), its tag ending at ftxs[8], cl = closing tag
fn ftxel cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 a ulong n ulong cl bool to void
sk = or or ftrnm a n tftrscr ftrnm a n tftrsty or ftrnm a n tftrtit ftrnm a n tftxsvg
if sk
if cl
if gt get ftxs 4 0
put ftxs 4 sub get ftxs 4 1
end
else
put ftxs 4 add get ftxs 4 1
end
ret
end
if ne get ftxs 4 0
ret
end
if ftrnm a n tftrpre
ftxpre cs io ch cl
ret
end
if ftrnm a n tftrcod
ftxcod cs io ch cl
ret
end
if ftrnm a n tftxbr
ftxnl cs io ch
ret
end
if ftrnm a n tftxspan
ftxmono cs io ch n cl
ret
end
if ftrnm a n tftxa
ftxa cs io ch n get ftxs 8 cl
ret
end
hn = ftxhn a n
if gt hn 0
ftxnl cs io ch
ftxnl cs io ch
if not cl
for k ulong hn bound 6
ftxch cs io ch 35
end
put ftxs 2 1
end
ret
end
if ftrnm a n tftxli
ftxnl cs io ch
if not cl
ftxch cs io ch 45
put ftxs 2 1
end
ret
end
if or ftrnm a n tftxtd ftrnm a n tftxth
put ftxs 2 1
ret
end
if ftxblk a n
ftxnl cs io ch
end
end
note ftxmono: a span whose class names mono (a command, an id) is inline code in the text form
fn ftxmono cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 n ulong cl bool to void
if cl
if ne get ftxs 9 0
put ftxs 9 0
ftxcod cs io ch true
end
ret
end
if ne get ftxs 9 0
ret
end
if ftrcls n get ftxs 8
put ftxs 9 1
ftxcod cs io ch false
end
end
fn ftxpre cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 cl bool to void
if cl
if gt get ftxs 1 0
put ftxs 1 sub get ftxs 1 1
end
if ne get ftxs 0 10
ftxraw cs io ch 10
end
ftxrt cs io ch tftxfen
ftxraw cs io ch 10
ret
end
ftxnl cs io ch
if ne get ftxs 0 10
ftxraw cs io ch 10
end
ftxrt cs io ch tftxfen
ftxraw cs io ch 10
put ftxs 1 add get ftxs 1 1
end
fn ftxcod cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 cl bool to void
if ne get ftxs 1 0
ret
end
if cl
if gt get ftxs 6 0
put ftxs 6 sub get ftxs 6 1
ftxo cs io ch 96
end
ret
end
ftxch cs io ch 96
put ftxs 6 add get ftxs 6 1
end
note ftxa: an opening a keeps where its href value is; the closing a emits it
fn ftxa cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 n ulong e ulong cl bool to void
if cl
ftxlink cs io ch get ftxs 3 get ftxs 7
put ftxs 3 0
put ftxs 7 0
ret
end
put ftxs 3 0
put ftxs 7 0
h = ftrfind n e tftxhr
if ge h e
ret
end
p = add h 6
q = p
while lt q e bound 8388608
if eq get fob q 34
break
end
q = add q 1
end
put ftxs 3 p
put ftxs 7 q
end
note ftxtag: fob[i] is '<'; act on the element and return the index after the tag
fn ftxtag cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 i ulong l ulong to ulong
e = ftrtend i l
j = add i 1
if or ge j e ne get fob sub e 1 62
ret e
end
if ftrcmt j l
ret e
end
cl = eq get fob j 47
a = j
if cl
a = add j 1
end
n = ftrnend a e
if gt n a
put ftxs 8 e
ftxel cs io ch a n cl
end
ret e
end
note ftxtxt: the text from fob[i] to the next '<' (or l); hashes and ids outside code in backticks
fn ftxtxt cs edit ulong 320 io edit uchar 131072 ch edit uchar 32768 i ulong l ulong to ulong
k = i
while lt k l bound 8388608
c = get fob k
if eq c 60
ret k
end
if ne get ftxs 4 0
k = add k 1
continue
end
if eq c 38
k = ftxent cs io ch k l
continue
end
if not ftrwc c
ftxch cs io ch c
k = add k 1
continue
end
s = k
while lt k l bound 8388608
if not ftrwc get fob k
break
end
k = add k 1
end
w = ftxcode
if and not w ftrid s k
ftxch cs io ch 96
ftxcps cs io ch s k
ftxo cs io ch 96
else
ftxcps cs io ch s k
end
end
ret k
end
note ftxrun: mode 0 returns the byte count of the text of fob[0, l); mode 1 sends it
fn ftxrun cs edit ulong 320 io edit uchar 131072 l ulong mode ulong to long
ch = new uchar 32768 0
put ftrq 0 0
put ftrq 1 0
put ftrq 2 mode
put ftrer 0 0
for k ulong 10
put ftxs k 0

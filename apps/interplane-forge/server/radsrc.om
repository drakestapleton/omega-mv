note forged server/radsrc.om: the Radicle source of the default build (the live binary), composed after
note server/repos.om (the shared allow-list helpers and per-repo metadata). It defines what a
note repository source gives the rest of forged: fload (the public allow-list), fsrcchg (the source
note changed: reload), fputid (a repository's identifier in machine forms), fhasal (it has an old
note Radicle id), fradsrc (Radicle node data may be read) with fradwalk / fradseeds (the routing
note table), fpjterms (the identity words of the "For developers" section), fjclone (the JSON clone
note object) and tfsf4 (the footer line). Git paths are server/util.om fkgit / fkgiti (tfstore + RID).
note The store-reading build composes store/repos.om in place of this unit (run.sh units, FORGE_STORE).
note Allow-list: the FIRST table of ~/handoffs/radicle/RIDS.md (header "| repo | RID | default
note branch"). A row is kept only when the name, RID and branch are well formed and
note ~/.radicle/storage/<rid> exists. Fail closed: when the file cannot be read or has no table, fan
note is 0 and every repo URL is 404.
text tfrids "/home/drakestapleton/handoffs/radicle/RIDS.md"
text tfthd "| repo | RID | default branch"
fn flmat s ulong ln ulong to bool
if gt add s len tfthd ln
ret false
end
for k ulong len tfthd bound 64
if ne get fxo add s k get tfthd k
ret false
end
end
ret true
end
fn flfind ln ulong to ulong
p = ulong 0
for it ulong 100000
if ge p ln
ret ln
end
if flmat p ln
ret p
end
p = flnext p ln
end
ret ln
end
fn flbar p ulong e ulong to ulong
j = p
while lt j e bound 16777216
if eq get fxo j 124
ret j
end
j = add j 1
end
ret e
end
fn fidput k ulong a ulong b ulong to bool
s = ftrs a b
t = ftre s b
if lt sub t s 6
ret false
end
if or ne get fxo s 114 ne get fxo add s 1 97
ret false
end
if or ne get fxo add s 2 100 ne get fxo add s 3 58
ret false
end
s = add s 4
n = sub t s
if gt n 60
ret false
end
cur = fidcur k
if gt add cur n len faid
ret false
end
put faio k cur
put fail k n
for i ulong n bound 64
c = get fxo add s i
if not fisaln c
ret false
end
put faid add cur i c
end
ret true
end
note fstok: ~/.radicle/storage/<rid of k> exists
fn fstok k ulong to bool
fpb
fpt tfstore
for i ulong get fail k bound 64
fpc fridbyte k i
end
r = stat fpth 0 get fpthl 0 fstb 0 128
ret ge r 0
end
fn frow p ulong e ulong to void
b1 = flbar add p 1 e
b2 = flbar add b1 1 e
b3 = flbar add b2 1 e
if ge b3 e
ret
end
k = get fan 0
if ge k 64
ret
end
if not fnmput k add p 1 b1
ret
end
if not fidput k add b1 1 b2
ret
end
if not fbrput k add b2 1 b3
ret
end
put fan 0 add k 1
end
fn fload to long
put fan 0 0
fpb
fpt tfrids
put famt 0 fmtime
n = frdall
if le n 0
ret -1
end
ln = ulong n
p = flfind ln
if ge p ln
ret -2
end
p = flnext p ln
p = flnext p ln
for it ulong 64
if ge p ln
break
end
if ne get fxo p 124
break
end
e = fleol p ln
frow p e
p = flnext p ln
end
fdrop
for i ulong get fan 0 bound 64
fmeta i
end
ret long get fan 0
end
note fdrop: remove denied rows and rows whose storage dir is missing (keeps order; areas stay valid)
fn fdrop to void
w = ulong 0
for i ulong get fan 0 bound 64
if and not fdeny i fstok i
fmove w i
w = add w 1
end
end
put fan 0 w
end
note fsrcchg: true when RIDS.md changed since fload read it (main.om fchkrl reloads then)
fn fsrcchg to bool
fpb
fpt tfrids
m = fmtime
ret ne m get famt 0
end
note fputid: the identifier of allow-list repo i in the machine forms ("rid" fields): the bare RID
note (z then base58; the rad: prefix is no longer shown since Radicle was removed on 2026-11-14)
fn fputid i ulong to void
fputrid i
end
note fhasal: every repository of this source has a Radicle id
fn fhasal i ulong to bool
ret true
end
note fradsrc: Radicle node data (the routing table, server/counts.om fzseeds) belongs to this source
fn fradsrc to bool
ret true
end
note ---- seeds: rad node routing --rid rad:<RID> --json, read again when the node database changed
text tfzenv "/usr/bin/env"
text tfzhenv "HOME=/home/drakestapleton"
text tfzrad "/home/drakestapleton/.radicle/bin/rad"
text tfznode "node"
text tfzrout "routing"
text tfzrid "--rid"
text tfzjson "--json"
text tfzradp "rad:"
text tfzwal "/home/drakestapleton/.radicle/node/node.db-wal"
text tfzrow "{\"rid\":\"rad:"
text tfznid "\"nid\":\""
note fradwalk: the change key of the node database (node.db-wal mtime in ns), 0 when it is missing
fn fradwalk to ulong
fpb
fpt tfzwal
r = stat fpth 0 get fpthl 0 fstb 0 128
if lt r 0
ret 0
end
ret add mul fradle8 88 1000000000 fradle8 96
end
fn fradle8 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get fstb add o i mul i 8
end
ret v
end
note fradseeds: the nodes this node's routing table says seed repo i (this node included), or -1 when
note rad did not answer
fn fradseeds i ulong to long
fkb
fka tfzenv
fka tfzhenv
fka tfzrad
fka tfznode
fka tfzrout
fka tfzrid
fkopen
fkt tfzradp
for k ulong get fail i bound 64
fkc fridbyte i k
end
fka tfzjson
st = fexec 5000000000
if ne st 0
ret -1
end
ret long fzrows i
end
note fzrows: lines of fxo that are {"rid":"rad:<RID of i>",...,"nid":"...
fn fzrows i ulong to ulong
ln = get fxol 0
p = ulong 0
n = ulong 0
for it ulong 1000000
if ge p ln
break
end
e = fleol p ln
if fzrowok i p e
n = add n 1
end
p = add e 1
end
ret n
end
fn fzxpre a ulong e ulong t view uchar * to bool
if gt add a len t e
ret false
end
for k ulong len t bound 64
if ne get fxo add a k get t k
ret false
end
end
ret true
end
fn fzrowok i ulong p ulong e ulong to bool
if not fzxpre p e tfzrow
ret false
end
a = add p len tfzrow
l = get fail i
if gt add a add l 2 e
ret false
end
for k ulong l bound 64
if ne get fxo add a k fridbyte i k
ret false
end
end
if ne get fxo add a l 34
ret false
end
q = add add a l 1
for it ulong sub e q bound 16777216
if fzxpre q e tfznid
ret true
end
q = add q 1
end
ret false
end
note ---- the footer line that says what forged serves (server/pages.om ffoot)
text tfsf4 "<p class=\"foot-fine\">INTERPLANE Forge: agents express intent; the forge retains authority. Repositories are served by forged, a seeded-Omega web server, with no JavaScript.</p>\n<p class=\"foot-fine\"><a href=\""
note ---- the identity words of the "For developers" section (server/pages.om fpjdev1): Delegate,
note Refs and HEAD, and Patch up to its link
text tfdv3 "<dt>Delegate</dt><dd>A key that may sign the project's official versions. This forge lists the project under "
text tfdv4 ".</dd>\n<dt>Refs and HEAD</dt><dd>Refs are the names that point at versions: branches and tags. HEAD is the version a fresh copy starts from, the newest commit of the default branch.</dd>\n<dt>Patch</dt><dd>A proposed change, stored in the repository and reviewed before it is merged. The list is under <a href=\""
fn fpjterms to void
fput tfdv3
fputown
fput tfdv4
end
note ---- the clone object of the JSON repo form (server/json.om fjrepo)
text tfjcl1 ",\n\"clone\":{\"rad\":\""
text tfjcl2 "\",\"rad_clone\":null,\"git_https\":null}"
fn fjclone i ulong to void
fput tfjcl1
fputrid i
fput tfjcl2
end

om2
note server/chromegen.om: makes the forge's copy of the interplane.io site chrome from the site's own
note source, at every build (run.sh units runs it), so a site change never needs a hand copy.
note stdin: content/_layout.html, a 0 byte, public/style.css, a 0 byte, the site commit (40 hex).
note stdout: one Omega unit (texts tchrsite, tchrhead, tchrfoot, tchrcss) that server/pages.om writes:
note   tchrhead  <header class="site-head"> .. </header> of the layout, release build: {{#flag}} and
note             {{/flag}} marks dropped (the optional data is present on interplane.io), every
note             site-relative href or src made absolute (https://interplane.io/...), and the one link
note             to https://interplane.io/explore marked aria-current="true" (Forge is the section);
note             translate="no" attributes left out: forged adds its hints when it sends a page
note             (server/tr.om, class brand and others), so a page in fob holds none and its size is exact
note   tchrfoot  the footer lines after <footer class="site-foot"><div class="shell"> up to the first
note             <p class="foot-fine"> line (the forge writes its own fine print), the same way
note   tchrcss   the site's :root line, then between the marks of server/tests/sitechrome.sh every
note             style.css rule line that styles the header or footer (the rule below, the same one
note             sitechrome.sh checks) inside its @-block, in the site's order
note Chrome rule: a line that starts with a base selector (*, html, body, a, a:hover, a:active,
note a:focus-visible,summary:focus-visible, code,pre,.mono) and "{", or names one of the classes
note site-head head-row brand site-foot foot-<a-z> si-line skip shell (not followed by a-z or -), or
note .button, .button.dark or .button.small before ":" or "{"; left out: nav.short, main p:where,
note .invite .button, .actions .button, .hop-stage (page rules), a one-line @media print rule, and
note @-blocks naming
note prefers-reduced-motion.
note Refusals (stderr names the reason, stdout is empty): exit 2 input shape, 3 header or footer
note not found, 4 a {{ mark other than {{#..}} or {{/..}} in them, 5 no single Forge link, 6 no :root
note first line, 7 a control byte other than a line feed, 8 fewer than 30 chrome lines, 9 output.
note The input and output buffers are 16 MiB each (the largest pool omc allows); the site files are
note about 40 KB. A larger input is refused with exit 2, never cut.
global cgi uchar 16777216
global cgn ulong 1
global cgo uchar 16777216
global cgl ulong 1
note the three parts of the input: layout [0, cgp 1), style [cgp 2, cgp 3), sha [cgp 4, cgn)
global cgp ulong 5
note the current @-block: its line (start, end) and whether it was written yet
global cgb ulong 3
global cgcur ulong 1
text thd "<header class=\"site-head\">"
text the "</header>"
text tfo "<footer class=\"site-foot\"><div class=\"shell\">"
text tff "<p class=\"foot-fine\">"
text thref "href=\"/"
text tsrc "src=\"/"
text tsite "https://interplane.io"
text tforge "<a href=\"https://interplane.io/explore\""
text tcur " aria-current=\"true\""
text thint " translate=\"no\""
text troot ":root{"
text tm1 "/* site chrome: copied from interplane.io public/style.css */\n"
text tm2 "/* end site chrome */\n"
text tqe "\"\n"
text tn1 "note server/chrome.om: GENERATED by server/chromegen.om at build (run.sh units) from interplane.io\n"
text tn2 "note content/_layout.html and public/style.css at the site commit in tchrsite. Not in git; do not edit.\n"
text ts1 "text tchrsite \""
text ts2 "text tchrhead \""
text ts3 "text tchrfoot \""
text ts4 "text tchrcss \""
text tbs1 "*{"
text tbs2 "html{"
text tbs3 "body{"
text tbs4 "a{"
text tbs5 "a:hover{"
text tbs6 "a:active{"
text tbs7 "a:focus-visible,summary:focus-visible{"
text tbs8 "code,pre,.mono{"
text tcl1 "site-head"
text tcl2 "head-row"
text tcl3 "brand"
text tcl4 "site-foot"
text tcl5 "si-line"
text tcl6 "skip"
text tcl7 "shell"
text tcl8 "foot-"
text tbtn "button"
text tdark ".dark"
text tsmall ".small"
text tsk1 "nav.short"
text tsk2 "main p:where"
text tsk3 ".invite .button"
text tsk4 ".actions .button"
text tsk5 ".hop-stage "
text tsk6 "@media print"
text tskin "prefers-reduced-motion"
text te2 "chromegen: input is not layout, NUL, style, NUL, commit (or larger than 16 MiB)\n"
text te3 "chromegen: the layout has no <header class=\"site-head\"> .. </header>, or no footer line <footer class=\"site-foot\"><div class=\"shell\"> followed by a <p class=\"foot-fine\"> line\n"
text te4 "chromegen: the site header or footer holds a {{ mark other than {{#name}} or {{/name}}; teach server/chromegen.om what the release build does with it\n"
text te5 "chromegen: the site header does not hold exactly one <a href=\"https://interplane.io/explore\"> (the Forge entry)\n"
text te6 "chromegen: the first line of public/style.css is not the :root token line\n"
text te7 "chromegen: a control byte other than a line feed in the copied header, footer or stylesheet lines\n"
text te8 "chromegen: fewer than 30 chrome rule lines found in public/style.css; the rule above no longer fits the site\n"
text te9 "chromegen: the output did not fit or could not be written\n"
fn cgdie code ulong t view uchar * to void
w = write 2 t 0 len t
exit int code
end
fn cgc c uchar to void
n = get cgl 0
if ge n len cgo
cgdie 9 te9
end
put cgo n c
put cgl 0 add n 1
end
fn cgt t view uchar * to void
for i ulong len t bound 4096
cgc get t i
end
end
note cge: one byte of an Omega text literal
fn cge c uchar to void
if eq c 10
cgc 92
cgc 110
ret
end
if eq c 9
cgc 92
cgc 116
ret
end
if lt c 32
cgdie 7 te7
end
if eq c 127
cgdie 7 te7
end
if or eq c 34 eq c 92
cgc 92
end
cgc c
end
note cgat: cgi[p, e) starts with t
fn cgat p ulong e ulong t view uchar * to bool
if gt add p len t e
ret false
end
for i ulong len t bound 4096
if ne get cgi add p i get t i
ret false
end
end
ret true
end
note cgfind: the first p in [a, e) where t starts, or e
fn cgfind a ulong e ulong t view uchar * to ulong
p = a
while lt p e bound 16777216
if cgat p e t
ret p
end
p = add p 1
end
ret e
end
fn cglow c uchar to bool
ret and ge c 97 le c 122
end
fn cgname c uchar to bool
ret or cglow c eq c 45
end
note ---- the layout parts
note cgmark: at cgi[p] a {{ mark; returns its end (after the }}) for {{#name}} or {{/name}}, refuses others
fn cgmark p ulong e ulong to ulong
q = add p 2
if ge q e
cgdie 4 te4
end
c = get cgi q
if and ne c 35 ne c 47
cgdie 4 te4
end
q = add q 1
s = q
while lt q e bound 16777216
c = get cgi q
if not or cglow c eq c 95
break
end
q = add q 1
end
if or eq q s gt add q 2 e
cgdie 4 te4
end
if or ne get cgi q 125 ne get cgi add q 1 125
cgdie 4 te4
end
ret add q 2
end
note cgpart: cgi[a, e) as the release build writes it, escaped into the output; returns the count of
note Forge links it marked current (when cur)
fn cgpart a ulong e ulong cur bool to ulong
n = ulong 0
p = a
while lt p e bound 16777216
if and eq get cgi p 123 lt add p 1 e
if eq get cgi add p 1 123
p = cgmark p e
continue
end
end
if cgat p e thint
p = add p len thint
continue
end
if and cur cgat p e tforge
for i ulong len tforge
cge get tforge i
end
for i ulong len tcur
cge get tcur i
end
p = add p len tforge
n = add n 1
continue
end
k = ulong 0
if cgat p e thref
k = len thref
end
if cgat p e tsrc
k = len tsrc
end
if gt k 0
r = sub add p k 1
if or ge add r 1 e ne get cgi add r 1 47
for i ulong sub k 1
cge get cgi add p i
end
for i ulong len tsite
cge get tsite i
end
p = r
continue
end
end
cge get cgi p
p = add p 1
end
ret n
end
note ---- the stylesheet
note cglst: [s, e) is a line of the stylesheet; true when it is a block line "@..{" with no "}"
fn cgopen s ulong e ulong to bool
if or ge s e ne get cgi s 64
ret false
end
if ne get cgi sub e 1 123
ret false
end
for i ulong sub e s bound 16777216
if eq get cgi add s i 125
ret false
end
end
ret true
end
fn cgclose s ulong e ulong to bool
if ge s e
ret false
end
for i ulong sub e s bound 16777216
if ne get cgi add s i 125
ret false
end
end
ret true
end
note cgcls: at p a class name t followed by a byte that is not a-z or -, or the line end
fn cgcls p ulong e ulong t view uchar * to bool
if not cgat p e t
ret false
end
q = add p len t
if ge q e
ret true
end
ret not cgname get cgi q
end
fn cgfoot p ulong e ulong to bool
if not cgat p e tcl8
ret false
end
q = add p len tcl8
s = q
while lt q e bound 16777216
if not cglow get cgi q
break
end
q = add q 1
end
if eq q s
ret false
end
if ge q e
ret true
end
ret ne get cgi q 45
end
fn cgbtn p ulong e ulong to bool
if not cgat p e tbtn
ret false
end
q = add p len tbtn
if cgat q e tdark
q = add q len tdark
else
if cgat q e tsmall
q = add q len tsmall
end
end
if ge q e
ret false
end
c = get cgi q
if or eq c 58 eq c 123
ret true
end
q = add p len tbtn
if ge q e
ret false
end
c = get cgi q
ret or eq c 58 eq c 123
end
fn cgbase s ulong e ulong to bool
if or cgat s e tbs1 or cgat s e tbs2 cgat s e tbs3
ret true
end
if or cgat s e tbs4 or cgat s e tbs5 cgat s e tbs6
ret true
end
ret or cgat s e tbs7 cgat s e tbs8
end
note cgsel: the rule line [s, e) styles the header or footer (the chrome rule in the notes above)
fn cgsel s ulong e ulong to bool
if lt cgfind s e tsk1 e
ret false
end
if or cgat s e tsk2 or cgat s e tsk3 or cgat s e tsk4 cgat s e tsk5
ret false
end
if cgat s e tsk6
ret false
end
if cgbase s e
ret true
end
p = s
while lt p e bound 16777216
if eq get cgi p 46
q = add p 1
if or cgcls q e tcl1 or cgcls q e tcl2 or cgcls q e tcl3 cgcls q e tcl4
ret true
end
if or cgcls q e tcl5 or cgcls q e tcl6 or cgcls q e tcl7 cgfoot q e
ret true
end
if cgbtn q e
ret true
end
end
p = add p 1
end
ret false
end
fn cgline s ulong e ulong to void
for i ulong sub e s bound 16777216
cge get cgi add s i
end
cge 10
end
note cgcss: the :root line, the marks and the chrome rule lines; returns the count of rule lines
fn cgcss a ulong e ulong to ulong
x = a
while lt x e bound 16777216
if eq get cgi x 10
break
end
x = add x 1
end
if not cgat a x troot
cgdie 6 te6
end
cgline a x
for i ulong len tm1
cge get tm1 i
end
put cgcur 0 0
put cgb 2 0
n = ulong 0
s = add x 1
while lt s e bound 16777216
l = s
while lt l e bound 16777216
if eq get cgi l 10
break
end
l = add l 1
end
if cgopen s l
put cgb 0 s
put cgb 1 l
put cgb 2 0
put cgcur 0 1
else
if cgclose s l
if and eq get cgcur 0 1 eq get cgb 2 1
cgline s l
end
put cgcur 0 0
put cgb 2 0
else
if cgsel s l
sk = false
if eq get cgcur 0 1
sk = lt cgfind get cgb 0 get cgb 1 tskin get cgb 1
end
if not sk
if and eq get cgcur 0 1 eq get cgb 2 0
cgline get cgb 0 get cgb 1
put cgb 2 1
end
cgline s l
n = add n 1
end
end
end
end
s = add l 1
end
for i ulong len tm2
cge get tm2 i
end
ret n
end
fn main to int
cgreadin
cgsplit
cgsha
cghead
cgfootp
cgt ts4
m = cgcss add get cgp 1 1 get cgp 2
cgt tqe
if lt m 30
cgdie 8 te8
end
w = write 1 cgo 0 get cgl 0
if ne w long get cgl 0
cgdie 9 te9
end
ret 0
end
fn cgreadin to void
n = ulong 0
while lt n len cgi bound 16777216
r = read 0 cgi n sub len cgi n
if lt r 0
if eq r -4
continue
end
cgdie 2 te2
end
if eq r 0
break
end
n = add n ulong r
end
if ge n len cgi
cgdie 2 te2
end
put cgn 0 n
end
note cgsplit: the two 0 bytes into cgp 1 and cgp 2
fn cgsplit to void
n = get cgn 0
k = ulong 0
for i ulong n bound 16777216
if eq get cgi i 0
if ge k 2
cgdie 2 te2
end
put cgp add k 1 i
k = add k 1
end
end
if ne k 2
cgdie 2 te2
end
end
fn cgisx c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
note cgsha: the third part is 40 lowercase hex (a trailing line feed allowed); writes tchrsite and the notes
fn cgsha to void
ha = add get cgp 2 1
he = get cgn 0
while gt he ha bound 16777216
if ne get cgi sub he 1 10
break
end
he = sub he 1
end
if ne sub he ha 40
cgdie 2 te2
end
for i ulong 40
if not cgisx get cgi add ha i
cgdie 2 te2
end
end
cgt tn1
cgt tn2
cgt ts1
for i ulong 40
cgc get cgi add ha i
end
cgt tqe
end
note cghead: from the header's opening tag to the end of </header>
fn cghead to void
lz = get cgp 1
h0 = cgfind 0 lz thd
h1 = cgfind h0 lz the
if or ge h0 lz ge h1 lz
cgdie 3 te3
end
cgt ts2
m = cgpart h0 add h1 len the true
cge 10
cgt tqe
if ne m 1
cgdie 5 te5
end
end
note cgfootp: the lines after the footer opening line, before the first fine-print line
fn cgfootp to void
lz = get cgp 1
f0 = cgfind 0 lz tfo
if ge f0 lz
cgdie 3 te3
end
f1 = cgfind f0 lz tff
fa = add f0 len tfo
if or ge f1 lz ge fa lz
cgdie 3 te3
end
if ne get cgi fa 10
cgdie 3 te3
end
fa = add fa 1
if or le f1 fa ne get cgi sub f1 1 10
cgdie 3 te3
end
cgt ts3
m = cgpart fa f1 false
cgt tqe
end

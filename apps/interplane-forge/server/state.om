note forged server/state.om: the plain state line of a project (the repo home header and the explore,
note profile and search rows), read from the Interplane receipts list: content/receipts/ledger.tsv on
note the default branch (HEAD) of the site's own repository rad:z399yKvnXcBQNkKoq86iBDgTvQ5QV, which
note is on the allow-list. https://interplane.io/receipts/ publishes that list and its verify.sh walks it.
note A project is "Checked: ran again on <date>" only when all of these hold:
note   the whole list verifies the way verify.sh checks it: it ends with a line feed, line n has 7 tab
note   fields, field 1 is n, field 6 is 64 lowercase hex (the evidence file name) and field 7 is
note   GENESIS on line 1, else the SHA-256 (lowercase hex) of line n-1 without its line feed;
note   it holds a BUILD record (a rebuild from source) and a SOURCE record with the same time and the
note   same writer (fields 2 and 4), among the neighbouring records with that time, whose text
note   (field 5) names rad:<the project's RID>;
note   that BUILD record's evidence file content/receipts/payload/<field 6>.txt in the same repository
note   hashes to field 6.
note <date> is the day (field 2) of the newest such BUILD record. Anything else, a list that cannot be
note read, is cut, or does not verify included, is "Unfinished: not checked yet". The label never
note says more than the list shows; it is not a verdict on the project.
note Call fpjload once per request before the rows or the header (it runs git and uses fxo).
global fpjl uchar 16777216
global fpjn ulong 1
note fpjst: 1 the list was read and verifies, anything else: no project is shown as checked
global fpjst ulong 1
note per record r (0-based, record r is line r+1): start and end (the line feed) in fpjl, and the
note evidence check of a BUILD record: 0 not yet, 1 the file hashes to its name, 2 it does not
global fpjrs ulong 131072
global fpjre ulong 131072
global fpjev uchar 131072
global fpjrn ulong 1
note fpjfind result: the BUILD record, its commit prefix in its text (start, length; length 0 when the
note text names none) and whether the project's head starts with that prefix
global fpjb ulong 1
global fpjca ulong 1
global fpjcl ulong 1
global fpjnew ulong 1
const FPJNONE ulong 131072
const FPJMAX ulong 131072
note FPJLEN: the size of fpjl (the longest list read); FPJXO: the size of fxo (the longest evidence
note file hashed). Named, not written as numbers, so no loop line here equals one that another
note slice's mutant test edits by its text (collab/tests/bigstore.sh).
const FPJLEN ulong 16777216
const FPJXO ulong 16777216
text tfpjsite "z399yKvnXcBQNkKoq86iBDgTvQ5QV"
text tfpjcat "cat-file"
text tfpjblob "blob"
text tfpjled "HEAD:content/receipts/ledger.tsv"
text tfpjpay "HEAD:content/receipts/payload/"
text tfpjtxt ".txt"
text tfpjgen "GENESIS"
text tfpjbld "BUILD"
text tfpjsrc "SOURCE"
text tfpjrad "rad:"
text tfpjfrom "from commit "
text tfpjrurl "https://interplane.io/receipts/"
text tfpjpurl "https://interplane.io/receipts/payload/"
text tfpjok1 "<p class=\"state ok\"><b>Checked:</b> ran again on "
text tfpjno1 "<p class=\"state no\"><b>Unfinished:</b> not checked yet</p>\n"
text tfpjpx "</p>\n"
text tfpjold " (an earlier version)"
text tfpjnew1 "<p class=\"state-more\">That is the version shown here. <a href=\""
text tfpjnew0 "<p class=\"state-more\">That was an earlier version: later changes are not checked yet. <a href=\""
text tfpjm5 ".txt\">Read the receipt</a></p>\n"
text tfpjn1 "<p class=\"state-more\">There is no published receipt of a rebuild from its source yet. <a href=\""
text tfpjn2 "\">What a receipt is</a></p>\n"
text tfpjm1 "Receipt "
text tfpjm2 " of that list says: &#8220;"
text tfpjm3 "&#8221; (<a href=\""
text tfpjm6 ".txt\">its evidence file</a>)."
text tfpjm7 "This project has no receipt in that list yet."
note ---- reading and verifying the list
note fpjsite: the allow-list index of the site repository, or fan when it is not listed
fn fpjsite to ulong
for i ulong get fan 0 bound FAMAX
if eq get fail i len tfpjsite
m = true
for k ulong len tfpjsite
if ne fridbyte i k get tfpjsite k
m = false
break
end
end
if m
ret i
end
end
end
ret get fan 0
end
fn fpjhex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
fn fpjhx v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end
note fpjfs: start of field k (0-based) of record r; fpjfe: its end (the tab or the line feed)
fn fpjfs r ulong k ulong to ulong
p = get fpjrs r
e = get fpjre r
if eq k 0
ret p
end
c = ulong 0
while lt p e bound FPJLEN
if eq get fpjl p 9
c = add c 1
if eq c k
ret add p 1
end
end
p = add p 1
end
ret e
end
fn fpjfe r ulong k ulong to ulong
p = fpjfs r k
e = get fpjre r
while lt p e bound FPJLEN
if eq get fpjl p 9
ret p
end
p = add p 1
end
ret e
end
note fpjfeq: field k of record r is the text t
fn fpjfeq r ulong k ulong t view uchar * to bool
a = fpjfs r k
if ne sub fpjfe r k a len t
ret false
end
for i ulong len t bound 64
if ne get fpjl add a i get t i
ret false
end
end
ret true
end
note fpjsame: field k of records r and q hold the same bytes
fn fpjsame r ulong q ulong k ulong to bool
a = fpjfs r k
n = sub fpjfe r k a
b = fpjfs q k
if ne n sub fpjfe q k b
ret false
end
for i ulong n bound FPJLEN
if ne get fpjl add a i get fpjl add b i
ret false
end
end
ret true
end
note fpjrec: record r (line r+1) is well formed and links to the line before it
fn fpjrec r ulong to bool
s = get fpjrs r
e = get fpjre r
t = ulong 0
for i ulong sub e s bound FPJLEN
if eq get fpjl add s i 9
t = add t 1
end
end
if ne t 6
ret false
end
note field 1: the decimal record number r+1
a = fpjfs r 0
b = fpjfe r 0
if or eq a b gt sub b a 7
ret false
end
v = ulong 0
for i ulong sub b a bound 8
c = get fpjl add a i
if or lt c 48 gt c 57
ret false
end
note verify.sh compares the number as text: "01" is not record 1
if and eq i 0 eq c 48
ret false
end
v = add mul v 10 ulong sub c 48
end
if ne v add r 1
ret false
end
note field 2: YYYY-MM-DDTHH:MM:SSZ
a = fpjfs r 1
if ne sub fpjfe r 1 a 20
ret false
end
for i ulong 20
c = get fpjl add a i
if or eq i 4 eq i 7
if ne c 45
ret false
end
continue
end
if eq i 10
if ne c 84
ret false
end
continue
end
if or eq i 13 eq i 16
if ne c 58
ret false
end
continue
end
if eq i 19
if ne c 90
ret false
end
continue
end
if or lt c 48 gt c 57
ret false
end
end
note field 6: the evidence file name, 64 lowercase hex
a = fpjfs r 5
if ne sub fpjfe r 5 a 64
ret false
end
for i ulong 64
if not fpjhex get fpjl add a i
ret false
end
end
note field 7: GENESIS first, else the SHA-256 of the line before
a = fpjfs r 6
if eq r 0
ret fpjfeq r 6 tfpjgen
end
if ne sub fpjfe r 6 a 64
ret false
end
ps = get fpjrs sub r 1
fpjshl ps sub get fpjre sub r 1 ps
ret fpjhexeq a
end
note ---- SHA-256 of a part of a global (a global cannot be an argument: omc error 19), copied
note through a local buffer 64 KiB at a time; the digest goes to fpjh
global fpjh uchar 32
fn fpjshl s ulong n ulong to void
c = new ulong 40 0
b = new uchar 65536 0
o = new uchar 32 0
sha256_init c
d = ulong 0
while lt d n bound FPJLEN
k = hmin sub n d 65536
for j ulong k bound 65536
put b j get fpjl add add s d j
end
sha256_update c view part b 0 k
d = add d k
end
sha256_final c o
for j ulong 32
put fpjh j get o j
end
end
fn fpjshx n ulong to void
c = new ulong 40 0
b = new uchar 65536 0
o = new uchar 32 0
sha256_init c
d = ulong 0
while lt d n bound FPJXO
k = hmin sub n d 65536
for j ulong k bound 65536
put b j get fxo add d j
end
sha256_update c view part b 0 k
d = add d k
end
sha256_final c o
for j ulong 32
put fpjh j get o j
end
end
note fpjhexeq: fpjl[a, a+64) is fpjh in lowercase hex
fn fpjhexeq a ulong to bool
for i ulong 32
v = ulong get fpjh i
if ne get fpjl add a mul i 2 fpjhx shr v 4
ret false
end
if ne get fpjl add a add mul i 2 1 fpjhx and v 15
ret false
end
end
ret true
end
note fpjload: read and verify the list. When it cannot (the site repository is not on the allow-list,
note git fails, the list is longer than fxo, the exec buffer every forged read goes through, or it does
note not verify), every project shows "Unfinished" and one line goes to the service log, so the cause
note is seen; server/tests/readmefirst.sh alarms before the real list nears that size.
text tfpjlg1 "forged: state: the receipts list was not read (site repository not listed, git failed, or the list is 16 MiB or longer); every project shows Unfinished\n"
text tfpjlg2 "forged: state: the receipts list does not verify (record number, date, fingerprint or chain); every project shows Unfinished\n"
fn fpjload to void
put fpjb 0 FPJNONE
put fpjst 0 0
put fpjrn 0 0
put fpjn 0 0
if fpjread
if fpjsplit
put fpjst 0 1
else
flog tfpjlg2
end
else
flog tfpjlg1
end
end
fn fpjread to bool
i = fpjsite
if ge i get fan 0
ret false
end
fkgiti i
fka tfpjcat
fka tfpjblob
fka tfpjled
st = fexec 5000000000
if or ne st 0 ne get fxotr 0 0
ret false
end
n = get fxol 0
if or eq n 0 gt n len fpjl
ret false
end
for k ulong n bound FPJLEN
put fpjl k get fxo k
end
put fpjn 0 n
ret true
end
note fpjsplit: the records of fpjl, each checked; false at the first that does not verify. FPJMAX
note holds more records than 16 MiB of them can be (a record is at least 157 bytes), so it is never
note the limit.
fn fpjsplit to bool
n = get fpjn 0
if ne get fpjl sub n 1 10
ret false
end
s = ulong 0
r = ulong 0
p = ulong 0
while lt p n bound FPJLEN
if eq get fpjl p 10
if ge r FPJMAX
ret false
end
put fpjrs r s
put fpjre r p
put fpjev r 0
if not fpjrec r
ret false
end
r = add r 1
s = add p 1
end
p = add p 1
end
put fpjrn 0 r
ret true
end
note fpjev1: the evidence file of record r hashes to its name (cached per request in fpjev)
fn fpjev1 r ulong to bool
v = get fpjev r
if ne v 0
ret eq v 1
end
put fpjev r 2
i = fpjsite
if ge i get fan 0
ret false
end
a = fpjfs r 5
fkgiti i
fka tfpjcat
fka tfpjblob
fka tfpjpay
for k ulong 64
fkc get fpjl add a k
end
fkt tfpjtxt
st = fexec 5000000000
if or ne st 0 ne get fxotr 0 0
ret false
end
fpjshx get fxol 0
if not fpjhexeq a
ret false
end
put fpjev r 1
ret true
end
note ---- one project
note fpjnames: the text (field 5) of record q names rad:<RID of allow-list repo i>, not as a prefix
note of a longer RID
fn fpjnames q ulong i ulong to bool
a = fpjfs q 4
e = fpjfe q 4
m = add len tfpjrad get fail i
if lt sub e a m
ret false
end
for s ulong add sub sub e a m 1 bound FPJLEN
if fpjnat add a s e i
ret true
end
end
ret false
end
note fpjnat: fpjl[p, e) starts with "rad:<RID of repo i>" and no RID byte follows it
fn fpjnat p ulong e ulong i ulong to bool
for k ulong len tfpjrad
if ne get fpjl add p k get tfpjrad k
ret false
end
end
r = add p len tfpjrad
for k ulong get fail i bound 64
if ne get fpjl add r k fridbyte i k
ret false
end
end
x = add r get fail i
if ge x e
ret true
end
ret not fpjalnum get fpjl x
end
fn fpjalnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end
note fpjcommit: the hex run after "from commit " in the text of BUILD record b, into fpjca / fpjcl
fn fpjcommit b ulong to void
put fpjcl 0 0
a = fpjfs b 4
e = fpjfe b 4
m = len tfpjfrom
if lt sub e a m
ret
end
for s ulong add sub sub e a m 1 bound FPJLEN
if fpjfrat add a s
fpjhexrun add add a s m e
ret
end
end
end
fn fpjfrat p ulong to bool
for k ulong len tfpjfrom
if ne get fpjl add p k get tfpjfrom k
ret false
end
end
ret true
end
note fpjhexrun: the run of lowercase hex at fpjl[q, e), kept when it is 7 to 40 bytes long
fn fpjhexrun q ulong e ulong to void
n = ulong 0
while and lt add q n e lt n 41 bound 42
if not fpjhex get fpjl add q n
break
end
n = add n 1
end
if and ge n 7 le n 40
put fpjca 0 q
put fpjcl 0 n
end
end
note fpjfind: the newest BUILD record that checks project i (allow-list index) into fpjb; false when
note there is none. Sets fpjnew: 1 when the project's head (falsh) starts with the commit the BUILD
note record names, else 0. The SOURCE partner is looked for only in the run of neighbouring records
note with the BUILD's time (field 2): a release's records are appended together, and this keeps the
note cost to the list's length per project, not its square.
fn fpjfind i ulong to bool
put fpjb 0 FPJNONE
put fpjnew 0 0
if ne get fpjst 0 1
ret false
end
n = get fpjrn 0
for it ulong n bound FPJMAX
b = sub sub n 1 it
if fpjfeq b 2 tfpjbld
if fpjpair b i
if fpjev1 b
put fpjb 0 b
fpjcommit b
fpjhead i
ret true
end
end
end
end
ret false
end
note fpjpair: a SOURCE record by the same writer, in the run of records with the time of BUILD record b,
note names project i
fn fpjpair b ulong i ulong to bool
q = b
while gt q 0 bound FPJMAX
if not fpjsame sub q 1 b 1
break
end
q = sub q 1
end
n = get fpjrn 0
while lt q n bound FPJMAX
if not fpjsame q b 1
ret false
end
if fpjfeq q 2 tfpjsrc
if fpjsame b q 3
if fpjnames q i
ret true
end
end
end
q = add q 1
end
ret false
end
fn fpjhead i ulong to void
n = get fpjcl 0
if or eq n 0 ne get falsl i 40
ret
end
a = get fpjca 0
o = mul i 40
for k ulong n bound 40
if ne get falsh add o k get fpjl add a k
ret
end
end
put fpjnew 0 1
end
note fpjdate: the day of record b (the first 10 bytes of field 2)
fn fpjdate b ulong to void
a = fpjfs b 1
for k ulong 10
fputc get fpjl add a k
end
end
note fpjrow: the short state line of an explore, profile or search row (no line feed: a row is one line)
text tfpjno2 "<p class=\"state no\"><b>Unfinished:</b> not checked yet</p>"
text tfpjrx "</p>"
fn fpjrow i ulong to void
if not fpjfind i
fput tfpjno2
ret
end
b = get fpjb 0
fput tfpjok1
fpjdate b
if eq get fpjnew 0 0
fput tfpjold
end
fput tfpjrx
end
note fpjfull: the state lines of the project page header, with a link to the receipt
fn fpjfull i ulong to void
if not fpjfind i
fput tfpjno1
fput tfpjn1
fput tfpjrurl
fput tfpjn2
ret
end
b = get fpjb 0
fput tfpjok1
fpjdate b
fput tfpjpx
if eq get fpjnew 0 1
fput tfpjnew1
else
fput tfpjnew0
end
fpjpay b
fput tfpjm5
end
fn fpjpay b ulong to void
fput tfpjpurl
a = fpjfs b 5
for k ulong 64
fputc get fpjl add a k
end
end
note fpjrcpt: for the "For developers" section: the receipt the state comes from, quoted, after
note fpjfull ran for this project (fpjb)
fn fpjrcpt to void
b = get fpjb 0
if ge b get fpjrn 0
fput tfpjm7
ret
end
fput tfpjm1
a = fpjfs b 0
for k ulong sub fpjfe b 0 a bound 8
fputc get fpjl add a k
end
fput tfpjm2
a = fpjfs b 4
for k ulong sub fpjfe b 4 a bound FPJLEN
fescc get fpjl add a k
end
fput tfpjm3
fpjpay b
fput tfpjm6
end

note forged server/repos.om: the allow-list helpers and per-repo metadata (description from the identity
note document, last commit) that both repository sources use: server/radsrc.om (RIDS.md and Radicle
note storage, the default build) and store/repos.om (the native store, the store-reading build). A
note source fills fan / fanm / faid / fabr with fnmput, fbrput and its own key, and calls fmeta.
note ficut: stored data behind this response was longer than the buffer it was read into, and the code
note that follows would have treated the cut copy as the whole (a list with entries missing, an empty
note list, a 404 for something that exists). fincut sets it and fobtr, so fsend (server/main.om) throws
note the response away and sends the whole 500 of fovfl with the words of tfmicut (server/pages.om).
note Kinds 3 and 4 (a file, a command) do not read it: a handler returns before it starts one.
global ficut ulong 1
fn fincut to void
put ficut 0 1
put fobtr 0 1
end
text tfshow "show"
text tfidref "refs/rad/id:embeds/radicle.json"
text tfdkey "\"description\":\""
text tflog "log"
text tfm1 "-1"
text tflcfmt "--format=%H %ct %cs %h %s"
note falsh / falsl / falct: full sha (40 hex, or length 0) and committer time (epoch s) of the last
note commit of repo i, for the JSON form (server/json.om); falc keeps "%cs %h %s" for the HTML pages.
global falsh uchar 2560
global falsl ulong 64
global falct ulong 64
text tfrh "refs/heads/"
text tfrns "refs/namespaces/"
text tfrnsh "/refs/heads/"
fn fleol p ulong ln ulong to ulong
j = p
while lt j ln bound 16777216
if eq get fxo j 10
ret j
end
j = add j 1
end
ret ln
end
fn flnext p ulong ln ulong to ulong
e = fleol p ln
if lt e ln
ret add e 1
end
ret ln
end
fn ftrs a ulong b ulong to ulong
j = a
while lt j b bound 16777216
if ne get fxo j 32
ret j
end
j = add j 1
end
ret b
end
fn ftre a ulong b ulong to ulong
j = b
while gt j a bound 16777216
if ne get fxo sub j 1 32
ret j
end
j = sub j 1
end
ret a
end
fn fnmok c uchar to bool
if fisaln c
ret true
end
ret or or eq c 46 eq c 45 eq c 95
end
fn fbrok c uchar to bool
if fnmok c
ret true
end
ret eq c 47
end
fn fnmcur k ulong to ulong
if eq k 0
ret 0
end
ret add get fano sub k 1 get fanl sub k 1
end
fn fidcur k ulong to ulong
if eq k 0
ret 0
end
ret add get faio sub k 1 get fail sub k 1
end
fn fbrcur k ulong to ulong
if eq k 0
ret 0
end
ret add get fabo sub k 1 get fabl sub k 1
end
fn fnmput k ulong a ulong b ulong to bool
s = ftrs a b
t = ftre s b
n = sub t s
if or eq n 0 gt n 100
ret false
end
cur = fnmcur k
if gt add cur n len fanm
ret false
end
put fano k cur
put fanl k n
for i ulong n bound 128
c = get fxo add s i
if not fnmok c
ret false
end
put fanm add cur i c
end
ret true
end
fn fbrput k ulong a ulong b ulong to bool
s = ftrs a b
t = ftre s b
n = sub t s
if or eq n 0 gt n 60
ret false
end
cur = fbrcur k
if gt add cur n len fabr
ret false
end
put fabo k cur
put fabl k n
for i ulong n bound 64
c = get fxo add s i
if not fbrok c
ret false
end
put fabr add cur i c
end
ret true
end
note fdeny: withdrawn or never-public repositories, refused even when a RIDS.md row lists them
note (by RID without "rad:" or by name); checked before the storage test, independent of the table
text tfdnr1 "z2ft64NFLsKzWttCXw6NWNbRQLggQ"
text tfdnn1 "omega-pearl"
text tfdnn2 "aien-crypto"
fn fdideq k ulong t view uchar * to bool
if ne get fail k len t
ret false
end
for i ulong len t bound 64
if ne fridbyte k i get t i
ret false
end
end
ret true
end
fn fdnmeq k ulong t view uchar * to bool
if ne get fanl k len t
ret false
end
for i ulong len t bound 64
if ne frnbyte k i get t i
ret false
end
end
ret true
end
fn fdeny k ulong to bool
if fdideq k tfdnr1
ret true
end
if fdnmeq k tfdnn1
ret true
end
ret fdnmeq k tfdnn2
end
fn fmove w ulong i ulong to void
if eq w i
ret
end
put fano w get fano i
put fanl w get fanl i
put faio w get faio i
put fail w get fail i
put fabo w get fabo i
put fabl w get fabl i
end
note ---- per-repo metadata: description (identity doc) and last commit
fn fdcur i ulong to ulong
if eq i 0
ret 0
end
ret add get fado sub i 1 get fadl sub i 1
end
fn flccur i ulong to ulong
if eq i 0
ret 0
end
ret add get falco sub i 1 get falcl sub i 1
end
fn fmeta i ulong to void
put fado i fdcur i
put fadl i 0
put falco i flccur i
put falcl i 0
put falsl i 0
put falct i 0
fkgiti i
fka tfshow
fka tfidref
st = fexec 5000000000
if eq st 0
fdescget i
end
flcget i
end
fn fdkey s ulong ln ulong to bool
if gt add s len tfdkey ln
ret false
end
for k ulong len tfdkey bound 32
if ne get fxo add s k get tfdkey k
ret false
end
end
ret true
end
fn fdescget i ulong to void
ln = get fxol 0
s = ulong 0
while lt s ln bound 16777216
if fdkey s ln
fdcopy i add s len tfdkey ln
ret
end
s = add s 1
end
end
fn fdcopy i ulong a ulong ln ulong to void
o = get fado i
n = ulong 0
j = a
while lt j ln bound 100000
c = get fxo j
if eq c 34
break
end
if ge add o n len fadesc
break
end
if ge n 1000
break
end
if eq c 92
j = add j 1
if ge j ln
break
end
c = fdunesc get fxo j
end
put fadesc add o n c
n = add n 1
j = add j 1
end
put fadl i n
fdclean i
end
fn fdunesc c uchar to uchar
if or eq c 110 eq c 116
ret uchar 32
end
ret c
end
fn flcarg i ulong ns ulong to void
fkgiti i
fka tflog
fka tfm1
fka tflcfmt
fkopen
if eq ns 1
fkt tfrns
fkt tfnid
fkt tfrnsh
else
fkt tfrh
end
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
end
fn flcget i ulong to void
flcarg i 0
st = fexec 5000000000
if ne st 0
flcarg i 1
st = fexec 5000000000
end
if ne st 0
ret
end
a = flcsha i
o = get falco i
n = ulong 0
m = hmin sub get fxol 0 a 1024
for j ulong m bound 1024
c = get fxo add a j
if eq c 10
break
end
if ge n 1000
break
end
if ge add o n len falc
break
end
put falc add o n c
n = add n 1
end
put falcl i n
end
note flcsha: fxo starts "<40 hex sha> <epoch> %cs %h %s". Stores the sha in falsh / falsl and the
note committer time in falct for repo i, and returns the offset of "%cs"; returns 0 (whole line kept,
note falsl 0) when the prefix is not exactly that shape.
fn flcishx c uchar to bool
if fisdig c
ret true
end
ret and ge c 97 le c 102
end
fn flcsha i ulong to ulong
ln = get fxol 0
if lt ln 43
ret 0
end
for k ulong 40
if not flcishx get fxo k
ret 0
end
end
if ne get fxo 40 32
ret 0
end
t = ulong 0
p = ulong 41
for it ulong 20
if ge p ln
break
end
c = get fxo p
if not fisdig c
break
end
t = add mul t 10 ulong sub c 48
p = add p 1
end
if or eq p 41 ge p ln
ret 0
end
if ne get fxo p 32
ret 0
end
o = mul i 40
for k ulong 40
put falsh add o k get fxo k
end
put falsl i 40
put falct i t
ret add p 1
end

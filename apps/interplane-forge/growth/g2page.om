note growth/g2page.om: trending and new orderings, and the per-repo insights page.
note Schemas forge/explore-order/1 and forge/insights/1. HTML stays the default.
text tgexp "/explore"
text tgexj "/explore.json"
text tgscho "forge/explore-order/1"
text tgschi "forge/insights/1"
text tgtrue "true"
text tgfals "false"
text tgnot "not measured"
text tgqtr "explore?order=trending"
text tgqnw "explore?order=new"
text tginsl "/insights"
text tgah "<a href=\""
text tgae "\">"
text tga2 "</a>"
text tgh1 "<h1>"
text tgh2 "</h1>\n<p class=\"muted\">"
text tgh3 "</p>\n<p class=\"meta\">"
text tgh4 "</p>\n<ul class=\"repos\">\n"
text tgli1 "<li><span class=\"stars\">"
text tgli2 "</span><a class=\"rname\" href=\""
text tgli3 "</a><p class=\"meta\">"
text tgli4 "</p><p class=\"meta\">"
text tgli5 "</p></li>\n"
text tgend "</ul>\n<p class=\"meta\">"
text tgti1 "Trending"
text tgti2 "New"
text tgti3 "Insights"
text tgsrc1 "Trending uses visitor git fetches, visitor downloads and net stars inside the window. Seeds are the last check of this node's routing table. "
text tgsrc2 "New is the last commit's committer time, newest first."
text tgcl "Clones and fetches: "
text tgdl "Downloads: "
text tgst "Stars: "
text tgfl "Followers of the owner: "
text tgsd "Seeding nodes: "
text tgup "git-upload-pack requests: "
text tgco "Contributors: "
text tgpo "Patches opened: "
text tgpm ", merged: "
text tgwn "Window "
text tgsi " since "
text tgin ", in the window "
text tgbox "<section class=\"box\">"
text tgbe "</section>\n"
text tgpl "<p class=\"meta\">"
text tgps "</p>\n"
text tgbr "<br>\n"
text tgul "<ul>\n"
text tgule "</ul>\n"
text tgso1 "front-door nginx download log"
text tgso2 "forged access log"
text tgso3 "social log"
text tgso4 "this node's Radicle routing table"
text tgso5 "git log author names on the default branch"
text tgso6 "Radicle patch objects in this repository's storage"
text tgso7 "front-door nginx access log"
fn grjsuf to bool
n = get fpathl 0
if lt n 5
ret false
end
a = sub n 5
for k ulong 5
if ne fpathat add a k get tgdotj k
ret false
end
end
ret true
end
fn grwantj to bool
if fjwant
ret true
end
ret grjsuf
end
fn grhere to bool
if fpeq tgexp
ret true
end
if fpeq tgexj
ret true
end
if eq get fpathl 0 1
ret true
end
if fpeq tgtrp
ret true
end
ret fpeq tgtrj
end
fn grins to bool
if frsteq tgins
ret true
end
ret frsteq tginj
end
fn grtrend to bool
if fpeq tgtrp
ret true
end
ret fpeq tgtrj
end

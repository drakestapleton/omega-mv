fn grserve k ulong to long
r = grsetq
if ne r 0
ret r
end
if ne k 0
put ggord 0 k
end
if eq get ggord 0 0
ret 0
end
grclock
grprep
grsort
if grwantj
grjlist
else
grhlist
end
ret 200
end
note grroute: insights only for a resolved public repo; reserved paths (/login/x/insights) keep fridx 9999
fn grroute to long
if grins
if ge get fridx 0 get fan 0
ret 0
end
if not fget
ret 405
end
ret grinserve
end
if not grhere
ret 0
end
if not fget
if grtrend
ret 405
end
n = fqget tgord
if ge n 0
ret 405
end
ret 0
end
if grtrend
ret grserve 1
end
n = fqget tgord
if lt n 0
ret 0
end
ret grserve 0
end
fn grorder to long
if not grhere
ret 0
end
ret grroute
end

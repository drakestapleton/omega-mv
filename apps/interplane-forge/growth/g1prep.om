note growth/g1prep.om: windowed clones, downloads and stars, seed-check history.
note Prefixes: fn gr*, global gg*, text tg*. Does not edit the counts journal. Reads it after fzsync.
note Trending window default 604800 s (7*86400, WolframLanguageEvaluator). Score = visitor git fetches
note plus visitor downloads plus net stars, all inside the window. Zero stays zero. Unknown is separate.
text tgwin "window"
text tgord "order"
text tgtr "trending"
text tgnw "new"
text tgtrp "/trending"
text tgtrj "/trending.json"
text tgins "/insights"
text tginj "/insights.json"
text tggdir "growth/"
text tgsdl "seeds.log"
text tgfmt "--format=%aN"
text tgdotj ".json"
text tgact "\"action\":\""
text tgts "\"ts\":"
text tgtg "\"target\":\""
text tgstar "star"
text tgunst "unstar"
text tgrad "rad:"
const ggwdef ulong 604800
const ggwmax ulong 315360000
global ggwin ulong 1
global ggnow ulong 1
global ggw0 ulong 1
global ggord ulong 1
global ggcln ulong 64
global ggdlw ulong 64
global ggstw ulong 64
global ggstu ulong 64
global ggscr ulong 64
global ggix ulong 64
global gglst ulong 64
global ggslc ulong 64
global ggcon ulong 1
global ggcnn ulong 1
global ggctr ulong 1
global ggcnm uchar 3072
global ggcnl ulong 64
global ggpen ulong 1
global ggpmr ulong 1
global ggsrn ulong 1
global ggsep ulong 16
global ggsec ulong 16
global ggfts ulong 1
global ggln uchar 128
global ggll ulong 1
note ggjtr: 1 when the journal did not fit one read (fxo), so window numbers are not measured
global ggjtr ulong 1
fn grwnum n ulong to ulong
v = ulong 0
if eq n 0
ret 0
end
for i ulong n bound 12
c = get fval i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
fn greq t view uchar * n ulong to bool
if ne n len t
ret false
end
for i ulong n bound 16
if ne get fval i get t i
ret false
end
end
ret true
end
note grsetq: 0 ok (ggord 0 when order is absent), 400 when order or window is malformed
fn grsetq to long
put ggwin 0 ggwdef
n = fqget tgwin
if ge n 0
if or eq n 0 gt n 9
ret 400
end
w = grwnum ulong n
if or eq w 0 gt w ggwmax
ret 400
end
put ggwin 0 w
end
n = fqget tgord
if lt n 0
put ggord 0 0
ret 0
end
if greq tgtr ulong n
put ggord 0 1
ret 0
end
if greq tgnw ulong n
put ggord 0 2
ret 0
end
ret 400
end
fn grclock to void
put ggnow 0 div ulong realns 1000000000
w = get ggwin 0
if gt w get ggnow 0
put ggw0 0 0
else
put ggw0 0 sub get ggnow 0 w
end
end
fn grinw ep ulong to bool
if lt ep get ggw0 0
ret false
end
ret le ep get ggnow 0
end
fn greol p ulong n ulong to ulong
j = p
while lt j n bound 16777216
if eq get fxo j 10
ret j
end
j = add j 1
end
ret n
end
fn grpre p ulong t view uchar * to bool
if gt add p len t get fxol 0
ret false
end
for k ulong len t bound 32
if ne get fxo add p k get t k
ret false
end
end
ret true
end
fn grfind a ulong e ulong t view uchar * to ulong
if gt add a len t e
ret e
end
last = sub e len t
p = a
while le p last bound 16777216
if grpre p t
ret p
end
p = add p 1
end
ret e
end
fn grrid i ulong a ulong n ulong to bool
if ne get fail i n
ret false
end
for k ulong n bound 64
if ne fridbyte i k get fxo add a k
ret false
end
end
ret true
end
fn grrix a ulong n ulong to ulong
if eq n 0
ret 9999
end
for i ulong get fan 0 bound 64
if grrid i a n
ret i
end
end
ret 9999
end
fn grkind c uchar to ulong
if eq c 103
ret 0
end
if eq c 112
ret 1
end
if eq c 97
ret 2
end
if eq c 114
ret 3
end
ret 9
end
fn graddk i ulong k ulong to void
if eq k 0
put ggcln i add get ggcln i 1
end
if or eq k 2 eq k 3
put ggdlw i add get ggdlw i 1
end
end
fn grevent a ulong e ulong to void
if lt sub e a 6
ret
end
if ne get fxo a 101
ret
end
if ne get fxo add a 1 32
ret
end
k = grkind get fxo add a 2
if gt k 3
ret
end
if ne get fxo add a 3 32
ret
end
p = add a 4
q = p
while lt q e bound 24
c = get fxo q
if or lt c 48 gt c 57
break
end
q = add q 1
end
if eq q p
ret
end
if ge q e
ret
end
if ne get fxo q 32
ret
end
ep = ulong 0
j = p
while lt j q bound 24
ep = add mul ep 10 ulong sub get fxo j 48
j = add j 1
end
if not grinw ep
ret
end
r = add q 1
if ge r e
ret
end
i = grrix r sub e r
if ge i 9999
ret
end
graddk i k
end
note grlines: only the committed journal (up to fzjend); a torn last batch is not counted, as in counts.om
fn grlines to void
n = get fxol 0
if gt n get fzjend 0
n = get fzjend 0
end
p = ulong 0
while lt p n bound 16777216
e = greol p n
grevent p e
p = add e 1
end
end
fn grclr to void
for i ulong 64
put ggcln i 0
put ggdlw i 0
put ggstw i 0
put ggstu i 0
put ggscr i 0
end
end
fn grscan to void
grclr
put ggjtr 0 0
fzpath 3 0
r = frdall
if lt r 0
ret
end
if and eq get fxotr 0 1 gt get fzjend 0 get fxol 0
put ggjtr 0 1
end
grlines
end
note grwm: window counts of source s are measured (source read, whole journal read)
fn grwm s ulong to bool
if eq get fzsnc s 0
ret false
end
ret eq get ggjtr 0 0
end
fn gract a ulong e ulong to ulong
p = grfind a e tgact
if ge p e
ret 0
end
q = add p len tgact
if grpre q tgunst
ret 2
end
if grpre q tgstar
ret 1
end
ret 0
end
fn grts a ulong e ulong to ulong
p = grfind a e tgts
if ge p e
ret 0
end
q = add p len tgts
v = ulong 0
k = ulong 0
while lt q e bound 24
c = get fxo q
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
q = add q 1
k = add k 1
end
if eq k 0
ret 0
end
ret v
end
fn grtgtr a ulong e ulong to ulong
p = grfind a e tgtg
if ge p e
ret 9999
end
q = add p len tgtg
if not grpre q tgrad
ret 9999
end
q = add q len tgrad
r = q
while lt r e bound 80
if eq get fxo r 34
break
end
r = add r 1
end
if eq r q
ret 9999
end
ret grrix q sub r q
end
fn grsev a ulong e ulong to void
ts = grts a e
if and ne ts 0 eq get ggfts 0 0
put ggfts 0 ts
end
act = gract a e
if eq act 0
ret
end
if not grinw ts
ret
end
i = grtgtr a e
if ge i 9999
ret
end
if eq act 1
put ggstw i add get ggstw i 1
end
if eq act 2
put ggstu i add get ggstu i 1
end
end
fn grsoc to void
put ggfts 0 0
fpb
if gt get gsddl 0 0
put fpthl 0 0
for i ulong get gsddl 0 bound 512
fpc get gsdd i
end
end
fpt tslog
r = frdall
if lt r 0
ret
end
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
e = greol p n
grsev p e
p = add e 1
end
end
fn grnet i ulong to ulong
t = get ggstw i
u = get ggstu i
if gt t u
ret sub t u
end
ret 0
end
note grscore: each part counts only when measured (grwm, gsok); an unmeasured part adds nothing
fn grscore to void
wc = grwm 0
wd = grwm 2
for i ulong get fan 0 bound 64
s = ulong 0
if wc
s = add s get ggcln i
end
if wd
s = add s get ggdlw i
end
if eq get gsok 0 1
s = add s grnet i
end
put ggscr i s
end
end
fn grnlt a ulong b ulong to bool
na = get fanl a
nb = get fanl b
n = na
if gt n nb
n = nb
end
for k ulong n bound 128
ca = frnbyte a k
cb = frnbyte b k
if lt ca cb
ret true
end
if gt ca cb
ret false
end
end
ret lt na nb
end
fn grtrn a ulong b ulong to bool
sa = get ggscr a
sb = get ggscr b
if gt sa sb
ret true
end
if lt sa sb
ret false
end
ret grnlt a b
end
fn grnew a ulong b ulong to bool
ta = get falct a
tb = get falct b
if gt ta tb
ret true
end
if lt ta tb
ret false
end
ret grnlt a b
end
fn grless a ulong b ulong to bool
if eq get ggord 0 2
ret grnew a b
end
ret grtrn a b
end
fn grswap j ulong to void
t = get ggix j
put ggix j get ggix sub j 1
put ggix sub j 1 t
end
fn grsift i ulong to void
j = i
while gt j 0 bound 64
if grless get ggix j get ggix sub j 1
grswap j
j = sub j 1
else
ret
end
end
end
fn grsort to void
n = get fan 0
for i ulong n bound 64
put ggix i i
end
for i ulong n bound 64
grsift i
end
end
fn grlc c uchar to void
n = get ggll 0
if lt n len ggln
put ggln n c
put ggll 0 add n 1
end
end
fn grldec v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i bound 20
grlc get d add i k
end
end
fn grmk to void
fpb
fpt tfdata
fpt tggdir
x = makedir fpth 0 get fpthl 0 448
end
fn grsdpath to void
fpb
fpt tfdata
fpt tggdir
fpt tgsdl
end
note grnote: append "s <time> <count> <rid>" when the count differs from the last line this process
note wrote for the repo (the first check after a start always writes), so the series is change points
fn grnote i ulong to void
if ne get fzsdk i 1
ret
end
t = get fzsdt i
if or eq t 0 eq t get gglst i
ret
end
if and ne get gglst i 0 eq get ggslc i get fzsd i
ret
end
grmk
grsdpath
put ggll 0 0
grlc 115
grlc 32
grldec t
grlc 32
grldec get fzsd i
grlc 32
for k ulong get fail i bound 64
grlc fridbyte i k
end
grlc 10
fd = fopen fpth 0 get fpthl 0 525377 384
if lt fd 0
ret
end
n = write int fd ggln 0 get ggll 0
x = fclose int fd
if eq n long get ggll 0
put gglst i t
put ggslc i get fzsd i
end
end
fn grshft to void
for k ulong 15
put ggsep k get ggsep add k 1
put ggsec k get ggsec add k 1
end
put ggsrn 0 15
end
fn grsdec a ulong e ulong to ulong
v = ulong 0
j = a
if ge a e
ret 0
end
while lt j e bound 24
c = get fxo j
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
j = add j 1
end
ret v
end
fn grsline a ulong e ulong i ulong to void
if lt sub e a 4
ret
end
if ne get fxo a 115
ret
end
if ne get fxo add a 1 32
ret
end
p = add a 2
q = p
while lt q e bound 24
if eq get fxo q 32
break
end
q = add q 1
end
ep = grsdec p q
r = add q 1
s = r
while lt s e bound 24
if eq get fxo s 32
break
end
s = add s 1
end
ct = grsdec r s
z = add s 1
if not grrid i z sub e z
ret
end
if ge get ggsrn 0 16
grshft
end
k = get ggsrn 0
put ggsep k ep
put ggsec k ct
put ggsrn 0 add k 1
end
fn grseries i ulong to void
put ggsrn 0 0
grsdpath
r = frdall
if lt r 0
ret
end
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
e = greol p n
grsline p e i
p = add e 1
end
end
fn gradd a ulong e ulong to void
n = sub e a
if eq n 0
ret
end
if gt n 48
n = ulong 48
end
if grseen n a
ret
end
if ge get ggcnn 0 64
put ggctr 0 1
ret
end
i = get ggcnn 0
o = mul i 48
for k ulong n bound 48
put ggcnm add o k get fxo add a k
end
put ggcnl i n
put ggcnn 0 add i 1
end
fn gruniq to void
put ggcnn 0 0
put ggctr 0 0
n = get fxol 0
p = ulong 0
while lt p n bound 16777216
e = greol p n
gradd p e
p = add e 1
end
end
fn grbneq i ulong k ulong a ulong to bool
o = add mul i 48 k
ret ne get ggcnm o get fxo add a k
end
fn grsame i ulong n ulong a ulong to bool
for k ulong n bound 48
if grbneq i k a
ret false
end
end
ret true
end
fn grseen n ulong a ulong to bool
for i ulong get ggcnn 0 bound 64
if eq get ggcnl i n
if grsame i n a
ret true
end
end
end
ret false
end
fn grlog i ulong ns ulong to bool
fkgiti i
fka tflog
fka tgfmt
fkopen
if eq ns 1
fkt tfrns
fkt tfnid
fkt tfrnsh
else
fkt tfrh
end
o = get fabo i
for k ulong get fabl i bound 64
fkc get fabr add o k
end
st = fexec 8000000000
ret eq st 0
end
fn grcon i ulong to void
put ggcon 0 9999
put ggcnn 0 0
if grlog i 0
gruniq
put ggcon 0 get ggcnn 0
ret
end
if grlog i 1
gruniq
put ggcon 0 get ggcnn 0
end
end
fn grpatch to void
put ggpen 0 9999
put ggpmr 0 9999
if eq corefs 1 false
ret
end
put ggpen 0 get gcun 0
m = ulong 0
for j ulong get gcun 0 bound 1024
coidref get gcui j
if coload 1
if eq costate 3
m = add m 1
end
end
end
put ggpmr 0 m
end
note grprep: trending and new do not run rad. One routing read is about 110 ms, so a read per public repo
note on every node-database change would hold the one-request-at-a-time server for seconds. Each repo's
note seeds are the last check this process made for it (repo home or insights), not measured when none.
fn grprep to void
fzsync 0
fzsync 1
fzsync 2
grscan
grsoc
grscore
end
fn grone to void
i = get fridx 0
fzsync 0
fzsync 1
fzsync 2
fzseeds i
grnote i
grscan
grsoc
grscore
grcon i
grpatch
grseries i
end

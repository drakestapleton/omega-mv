note dl/dljson.om: the machine form (JSON) of the /releases pages (ForgeDownloads, docs/API.md).
note dlrelr calls dljrels / dljrtag when fjwant is true. Each runs the same checks as its HTML handler
note (dlrels / dlrtag) before it reads anything, and shows the same facts: the same records in the same
note order, the same archive and asset rows, size and SHA-256 only when the HTML shows them (the cached
note file and its sidecar exist). Links are the HTML hrefs with the base; tag and asset names passed
note dlrefok / dlasok, so they are URL- and JSON-safe bytes. /releases/latest is a redirect in both forms.
text tdjsrel "forge/releases/1"
text tdjsrl1 "forge/release/1"
text tdjrels "releases"
text tdjrel "release"
text tdjprev "prev"
text tdjnext "next"
text tdjhtml "html"
text tdjpre "prerelease"
text tdjlat "latest"
text tdjtime "time"
text tdjsha "sha"
text tdjpath "path"
text tdjsubj "subject"
text tdjnote "notes"
text tdjarch "archives"
text tdjtgz "tar_gz"
text tdjass "assets"
text tdjname "name"
text tdjsize "size"
text tdjsha2 "sha256"
text tdjpq "?page="
note dljrels: GET /releases[?page=N] as forge/releases/1 (dlrels' checks and paging: 10 per page)
fn dljrels to long
if not dltags
ret 500
end
p = dlpageq
s = mul sub p 1 10
kn = get gdkn 0
if and gt p 1 ge s kn
ret 404
end
fyrhead tdjsrel
fyk tdpage
fnum p
fyk tdjrels
fputc 91
for i ulong 10
k = add s i
if ge k kn
break
end
if gt i 0
fputc 44
end
fputc 10
dljrel get gdkeep k false
end
fputc 93
dljpager p kn
fyend
ret 200
end
note dljpager: ,"prev":<newer page link or null>,"next":<older page link or null> (dlpager's links)
fn dljpager p ulong kn ulong to void
fyk tdjprev
if gt p 1
dljpgl sub p 1
else
fynull
end
fyk tdjnext
if lt mul p 10 kn
dljpgl add p 1
else
fynull
end
end
fn dljpgl n ulong to void
fputc 34
fputrl
fput tdrel
fput tdjpq
fnum n
fputc 34
end
note dljrtag: GET /releases/tag/<t> as forge/release/1 (dlrtag's checks: 404 too long or unknown,
note 400 a refused tag name), with the release-assets/ files
fn dljrtag to long
if not dltags
ret 500
end
if not dlrcopy len tdrtag get frestl 0
ret 404
end
if not dlrefok
ret 400
end
r = dlrfind
if eq r 9999
ret 404
end
fyrhead tdjsrl1
fyk tdjrel
dljrel r true
fyend
ret 200
end
note dljrel: the release object of kept record r (dlrel1's facts); full adds the assets array, else null
fn dljrel r ulong full bool to void
dlsn2ref r
dlsetsha r
fputc 123
fyk0 tdtag
dljref
fyk tdjhtml
fputc 34
fputrl
fput tdrtag
dljrraw
fputc 34
fyk tdjpre
fybool dlpre
fyk tdjlat
fybool eq get gdlat 0 r
fyk tdjtime
dlfld r 6
fjiso dljnum
dljcmt
dljnotes r
dljarchs
fyk tdjass
if full
dljassets
else
fynull
end
fputc 125
end
note dljref: the tag name gdref as a JSON string; dljrraw: its bytes inside an open string (a link)
fn dljref to void
fjtb
for i ulong get gdrefl 0
fjtc get gdref i
end
fjstr
end
fn dljrraw to void
for i ulong get gdrefl 0
fputc get gdref i
end
end
note dljnum: the decimal field gdtl[gdfa, gdfa + gdfn) (creatordate:unix), 0 when empty or not digits
fn dljnum to ulong
a = get gdfa 0
v = ulong 0
for i ulong get gdfn 0
c = get gdtl add a i
if not dldig c
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note dljcmt: ,"commit":{"sha":"<40 hex>","path":"<base><o>/<r>/commit/<sha>"} of gdsha
fn dljcmt to void
fyk tdcommit
fputc 123
fyk0 tdjsha
fputc 34
dljsha
fputc 34
fyk tdjpath
fputc 34
fputrl
fput tdcommp
dljsha
fputc 34
fputc 125
end
fn dljsha to void
for i ulong 40
fputc get gdsha i
end
end
note dljnotes: ,"subject":..,"notes":.. of an annotated tag (dlnotes: fields 7 and 8), null when the
note tag is lightweight or the field is empty (the HTML then shows no paragraph)
fn dljnotes r ulong to void
dlfld r 1
an = dlfeq tdtag
fyk tdjsubj
dljfldn r 7 an
fyk tdjnote
dljfldn r 8 an
end
fn dljfldn r ulong k ulong an bool to void
if an
dlfld r k
if gt get gdfn 0 0
fjtb
a = get gdfa 0
for i ulong get gdfn 0
fjtc get gdtl add a i
end
fjstr
ret
end
end
fynull
end
note dljarchs: ,"archives":{"zip":{..},"tar_gz":{..}} (dlarow 1 and 2)
fn dljarchs to void
fyk tdjarch
fputc 123
fyk0 tdezip
dljarow 1
fyk tdjtgz
dljarow 2
fputc 125
end
note dljarow: one source archive of the release in gdref / gdsha: name, path, size, sha256
fn dljarow fmt ulong to void
put gdfmt 0 fmt
dlprefix
if eq fmt 1
dlfinal tdezip
else
dlfinal tdetgz
end
fputc 123
fyk0 tdjname
fjtb
for i ulong get gdprel 0
fjtc get gdpre i
end
dljext fmt
fjstr
fyk tdjpath
fputc 34
fputrl
fput tdarht
dljrraw
if eq fmt 1
fput tdzip
else
fput tdtgz
end
fputc 34
dljsum
fputc 125
end
fn dljext fmt ulong to void
if eq fmt 1
for i ulong len tdzip
fjtc get tdzip i
end
ret
end
for i ulong len tdtgz
fjtc get tdtgz i
end
end
note dljsum: ,"size":<bytes>,"sha256":"<64 hex>" of gdf when it is built with its sidecar (dlsumcells),
note else both null; never builds or hashes anything
fn dljsum to void
if dlexists
if dlsumrd
fyk tdjsize
fnum get gdsize 0
fyk tdjsha2
fputc 34
for i ulong 64
fputc get gdhex i
end
fputc 34
ret
end
end
fyk tdjsize
fynull
fyk tdjsha2
fynull
end
note dljassets: the release-assets/ files of the commit in gdsha as an array (dlassets' rows)
fn dljassets to void
dllsa
c = new uchar 40 0
for i ulong 40
put c i get gdsha i
end
fputc 91
for k ulong get gdan 0
if gt k 0
fputc 44
end
dljasrow k
end
fputc 93
for i ulong 40
put gdsha i get c i
end
end
note dljasrow: asset k: name, path (/releases/download/<tag>/<name>), size, sha256
fn dljasrow k ulong to void
fputc 123
fyk0 tdjname
n = get gdanl k
b = mul k 128
fjtb
for i ulong n
fjtc get gdanm add b i
end
fjstr
fyk tdjpath
fputc 34
fputrl
fput tdrdl
dljrraw
fputc 47
for i ulong n
fputc get gdanm add b i
end
fputc 34
dlabsha k
dlfblob
dljsum
fputc 125
end

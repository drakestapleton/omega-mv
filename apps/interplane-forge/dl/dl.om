note ---- byte classes and hex
fn dlhx v uchar to uchar
if lt v 10
ret add v 48
end
ret add v 87
end
fn dlishex c uchar to bool
if and ge c 48 le c 57
ret true
end
ret and ge c 97 le c 102
end
fn dldig c uchar to bool
ret and ge c 48 le c 57
end
note dlrch: a byte allowed in a ref name in a URL: A-Z a-z 0-9 . _ - / +
fn dlrch c uchar to bool
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
if dldig c
ret true
end
ret or or or eq c 46 eq c 95 or eq c 45 eq c 47 eq c 43
end
note dlrefok: gdref[0, gdrefl) is 1..200 allowed bytes, no leading - / ., no trailing / ., no .. // /.
fn dlrefok to bool
n = get gdrefl 0
if or eq n 0 gt n 200
ret false
end
c0 = get gdref 0
if or or eq c0 45 eq c0 47 eq c0 46
ret false
end
cl = get gdref sub n 1
if or eq cl 47 eq cl 46
ret false
end
p = get gdref 0
for i ulong n
c = get gdref i
if not dlrch c
ret false
end
if gt i 0
if and eq c 46 or eq p 46 eq p 47
ret false
end
if and eq c 47 eq p 47
ret false
end
end
p = c
end
ret true
end
note dlasok: gdasn[0, gdasnl) is one file name: 1..120 bytes of A-Z a-z 0-9 . _ - +, not starting with .
fn dlasok to bool
n = get gdasnl 0
if or eq n 0 gt n 120
ret false
end
if eq get gdasn 0 46
ret false
end
for i ulong n
c = get gdasn i
if or eq c 47 not dlrch c
ret false
end
end
ret true
end
note ---- frest matching (the path after /<owner>/<repo>)
fn dlrat o ulong t view uchar * to bool
n = get frestl 0
if gt add o len t n
ret false
end
for i ulong len t
if ne get frest add o i get t i
ret false
end
end
ret true
end
fn dlrst t view uchar * to bool
ret dlrat 0 t
end
fn dlreq t view uchar * to bool
if ne len t get frestl 0
ret false
end
ret dlrat 0 t
end
fn dlrend t view uchar * to bool
n = get frestl 0
if lt n len t
ret false
end
ret dlrat sub n len t t
end
note dlrcopy: frest[a, e) into gdref; false when longer than 200
fn dlrcopy a ulong e ulong to bool
put gdrefl 0 0
if or ge a e gt sub e a 200
ret false
end
for i ulong sub e a
put gdref i get frest add a i
end
put gdrefl 0 sub e a
ret true
end
note ---- path builder gdp (and the final path gdf)
fn dlpb to void
put gdpl 0 0
end
fn dlpc c uchar to void
n = get gdpl 0
if lt n 4095
put gdp n c
put gdpl 0 add n 1
end
end
fn dlpt t view uchar * to void
for i ulong len t
dlpc get t i
end
end
fn dlpd v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
dlpc get d add i k
end
end
fn dlpf to void
for i ulong get gdfl 0
dlpc get gdf i
end
end
fn dlp2f to void
n = get gdpl 0
for i ulong n
put gdf i get gdp i
end
put gdfl 0 n
end
note dlparc: <tfdata>archives
fn dlparc to void
dlpb
dlpt tfdata
dlpt tdadir
end
note dlpdir: <tfdata>archives/<rid>
fn dlpdir to void
dlparc
dlpc 47
for i ulong get fridl 0
dlpc get frid i
end
end
fn dlmkdir to bool
dlpb
dlpt tfdata
r = makedir gdp 0 get gdpl 0 448
dlparc
r = makedir gdp 0 get gdpl 0 448
dlpdir
r = makedir gdp 0 get gdpl 0 448
ret or eq r 0 eq r -17
end
note dlfinal: gdf = <dir>/<sha>-<h16>.<ext>
fn dlfinal ext view uchar * to void
dlpdir
dlpc 47
for i ulong 40
dlpc get gdsha i
end
dlpc 45
for i ulong 16
dlpc get gdh16 i
end
dlpc 46
dlpt ext
dlp2f
end
note dlfblob: gdf = <dir>/<blob sha in gdsha>.blob
fn dlfblob to void
dlpdir
dlpc 47
for i ulong 40
dlpc get gdsha i
end
dlpc 46
dlpt tdeblob
dlp2f
end
note ---- stat helpers (Linux arm64 stat: mode +16, size +48, ctime +104 s, +112 ns)
fn dlst64 o ulong to ulong
v = ulong 0
for i ulong 8
b = ulong get gdst add o i
v = or v shl b mul i 8
end
ret v
end
fn dlst32 o ulong to ulong
v = ulong 0
for i ulong 4
b = ulong get gdst add o i
v = or v shl b mul i 8
end
ret v
end
note dlexists: gdf is a nonempty regular file; its size in gdsize
fn dlexists to bool
r = stat gdf 0 get gdfl 0 gdst 0 128
if lt r 0
ret false
end
if ne and dlst32 16 61440 32768
ret false
end
put gdsize 0 dlst64 48
ret gt get gdsize 0 0
end
note ---- argv helpers on the contract's fpk builder
fn dlkt t view uchar * to void
for i ulong len t
fkc get t i
end
end
fn dlksha to void
fkopen
for i ulong 40
fkc get gdsha i
end
end
note dlkns: start an arg "refs/namespaces/<nid>" + t
fn dlkns t view uchar * to void
fkopen
dlkt tdns
dlkt tfnid
dlkt t
end
note ---- running git with stdout into an open file (archives can pass fxo's 16 MiB)
fn dlchild ofd int to void
nul = fopen tdnull 0 len tdnull 2 0
if lt nul 0
exit 126
end
x = dupfd int nul 0 0
x = dupfd ofd 1 0
x = dupfd int nul 2 0
x = execprog fpk 0 get fpkl 0
exit 127
end
note dlrunf: run argv fpk, stdout into ofd, 120 s deadline, file cap 512 MiB. Exit status 0..255,
note -1 killed (deadline or cap), -2 cannot start, -3 signalled, -4 wait failure
fn dlrunf ofd int to long
pid = fork
if lt pid 0
ret -2
end
if eq pid 0
dlchild ofd
exit 127
end
dl = add monons 120000000000
for it ulong 200000
w = waitpid int pid gdws 0 4 1
if eq w pid
s = or ulong get gdws 0 shl ulong get gdws 1 8
if eq and s 127 0
ret long and shr s 8 255
end
ret -3
end
if and lt w 0 ne w -4
ret -4
end
r = fstat ofd gdst 0 128
toob = false
if ge r 0
toob = gt dlst64 48 536870912
end
if or toob gt monons dl
x = killpid int pid 9
w = waitpid int pid gdws 0 4 0
ret -1
end
x = sleepns 2000000
end
ret -4
end
note dlgenx: run the argv already in fpk into <dir>/.tmp-<pid>.<n>, then rename it to gdf
fn dlgenx to long
dlpdir
dlpc 47
dlpt tdtmp
dlpd ulong getpid
fd = fopen gdp 0 get gdpl 0 524865 384
if lt fd 0
ret -2
end
r = dlrunf int fd
x = fclose int fd
if ne r 0
x = unlink gdp 0 get gdpl 0
ret -1
end
fkb
fkopen
for i ulong get gdpl 0
fkc get gdp i
end
fkopen
for i ulong get gdfl 0
fkc get gdf i
end
r = renames fpk 0 get fpkl 0 0
if ne r 0
x = unlink gdp 0 get gdpl 0
ret r
end
ret 0
end
note dlkarch: argv git archive --format=zip|tar.gz --prefix=<gdpre>/ <gdsha>
fn dlkarch to void
fkgit
fka tdarcw
if eq get gdfmt 0 1
fka tdfzip
else
fka tdftgz
end
fkopen
dlkt tdpref
for i ulong get gdprel 0
fkc get gdpre i
end
fkc 47
dlksha
end
note dlkblob: argv git cat-file blob <gdsha>
fn dlkblob to void
fkgit
fka tdcatf
fka tdeblob
dlksha
end
note dlensure: gdf exists (a hit touches its ctime) or is generated now (what 1 archive, 2 blob);
note either way its .sha256 sidecar is written once; -7 = the site-wide cold-build cap is full
fn dlensure what ulong to long
if dlexists
x = chmod gdf 0 get gdfl 0 384
hs = dlsum
ret 0
end
if not dlmkdir
ret -2
end
if not dlcold
ret -7
end
if eq what 1
dlkarch
else
dlkblob
end
r = dlgenx
if lt r 0
ret r
end
gs = dlsum
dlevict
if not dlexists
ret -5
end
ret 0
end
note dlcold: take a cold-build slot; at most 2 builds start in any 60 s, site-wide (gdcold: start times)
fn dlcold to bool
t = ulong monons
for i ulong 2
s = get gdcold i
if or eq s 0 ge sub t s 60000000000
put gdcold i t
ret true
end
end
ret false
end
note dlretry: whole seconds until the older slot frees, at least 1
fn dlretry to ulong
t = ulong monons
a = get gdcold 0
b = get gdcold 1
if lt b a
a = b
end
e = sub t a
if ge e 60000000000
ret 1
end
ret add div sub 60000000000 e 1000000000 1
end
note dlbusy: 503 with Retry-After (the server's error page; fretry is the contract's header field)
fn dlbusy to long
put fretry 0 dlretry
ret 503
end
note ---- LRU eviction over <tfdata>archives/*/*
fn dlevict to void
for round ulong 64
dlscan
if le get gdtot 0 5368709120
ret
end
if eq get gdoldl 0 0
ret
end
x = unlink gdold 0 get gdoldl 0
n = get gdoldl 0
if lt add n 8 4096
for i ulong len tdsum
put gdold add n i get tdsum i
end
x = unlink gdold 0 add n len tdsum
end
end
end
fn dlscan to void
put gdtot 0 0
put gdoldl 0 0
dlparc
fd = fopen gdp 0 get gdpl 0 540672 0
if lt fd 0
ret
end
for it ulong 4096
n = getdnts int fd gdent 0 16384
if le n 0
break
end
dlscan1 ulong n
end
x = fclose int fd
end
fn dlscan1 n ulong to void
p = ulong 0
for it ulong 16384
if ge add p 19 n
break
end
rl = or ulong get gdent add p 16 shl ulong get gdent add p 17 8
if eq rl 0
break
end
if and eq get gdent add p 18 4 ne get gdent add p 19 46
put gdsubl 0 0
for i ulong 255
c = get gdent add add p 19 i
if eq c 0
break
end
put gdsub i c
put gdsubl 0 add i 1
end
dlscand
end
p = add p rl
end
end
fn dlpsub to void
dlparc
dlpc 47
for i ulong get gdsubl 0
dlpc get gdsub i
end
end
fn dlscand to void
dlpsub
fd = fopen gdp 0 get gdpl 0 540672 0
if lt fd 0
ret
end
for it ulong 4096
n = getdnts int fd gdent2 0 16384
if le n 0
break
end
dlscanf ulong n
end
x = fclose int fd
end
fn dlscanf n ulong to void
p = ulong 0
for it ulong 16384
if ge add p 19 n
break
end
rl = or ulong get gdent2 add p 16 shl ulong get gdent2 add p 17 8
if eq rl 0
break
end
if eq get gdent2 add p 18 8
dlpsub
dlpc 47
for i ulong 255
c = get gdent2 add add p 19 i
if eq c 0
break
end
dlpc c
end
dlscanf1
end
p = add p rl
end
end
note dlscanf1: count the file in gdp, keep it as the eviction candidate when its ctime is oldest
fn dlscanf1 to void
r = stat gdp 0 get gdpl 0 gdst 0 128
if lt r 0
ret
end
put gdtot 0 add get gdtot 0 dlst64 48
ct = add mul dlst64 104 1000000000 dlst64 112
if and ne get gdoldl 0 0 ge ct get gdoldc 0
ret
end
n = get gdpl 0
for i ulong n
put gdold i get gdp i
end
put gdoldl 0 n
put gdoldc 0 ct
end
note ---- SHA-256 of the file gdf into gdhex, cached in the sidecar <gdf>.sha256
fn dlsha256f to bool
c = new ulong 40 0
b = new uchar 65536 0
o = new uchar 32 0
fd = fopen gdf 0 get gdfl 0 524288 0
if lt fd 0
ret false
end
sha256_init c
for it ulong 16384
r = read int fd b 0 65536
if lt r 0
x = fclose int fd
ret false
end
if eq r 0
break
end
sha256_update c view part b 0 ulong r
end
x = fclose int fd
sha256_final c o
for i ulong 32
v = get o i
put gdhex mul i 2 dlhx shr v 4
put gdhex add mul i 2 1 dlhx and v 15
end
ret true
end
fn dlhex64 to bool
for i ulong 64
if not dlishex get gdhex i
ret false
end
end
ret true
end
note dlsumrd: the SHA-256 of gdf from its .sha256 sidecar into gdhex, never computed (gdp = sidecar)
fn dlsumrd to bool
dlpb
dlpf
dlpt tdsum
fd = fopen gdp 0 get gdpl 0 524288 0
if lt fd 0
ret false
end
r = read int fd gdhex 0 64
x = fclose int fd
if ne r 64
ret false
end
ret dlhex64
end
note dlsum: the sidecar's SHA-256, or compute it over gdf in Omega and write the sidecar
fn dlsum to bool
if dlsumrd
ret true
end
if not dlsha256f
ret false
end
fd = fopen gdp 0 get gdpl 0 524865 384
if ge fd 0
w = write int fd gdhex 0 64
x = fclose int fd
end
ret true
end
note ---- ref resolution
note dlsha40: fxo starts with 40 lowercase hex; copied into gdsha
fn dlsha40 to bool
if lt get fxol 0 40
ret false
end
for i ulong 40
c = get fxo i
if not dlishex c
ret false
end
put gdsha i c
end
ret true
end
note dlrevp: rev-parse one candidate for gdref: 0 as given, 1 refs/heads/, 2 delegate heads,
note 3 refs/tags/, 4 delegate tags; the commit sha into gdsha
fn dlrevp mode ulong to bool
fkgit
fka tdrevp
fka tdverif
fka tdquiet
if eq mode 0
fkopen
end
if eq mode 1
fkopen
dlkt tdheads
end
if eq mode 2
dlkns tdsrh
end
if eq mode 3
fkopen
dlkt tdtags
end
if eq mode 4
dlkns tdsrt
end
for i ulong get gdrefl 0
fkc get gdref i
end
dlkt tdcomm
r = fexec 10000000000
if ne r 0
ret false
end
ret dlsha40
end
note dlrch0 / dlrch1: reachability from a canonical head or tag (root or delegate namespace):
note dlrch0 starts the for-each-ref --contains argv, the caller adds one commit id, dlrch1 adds the
note ref patterns and runs it; shared with browse (brreach)
fn dlrch0 to void
fkgit
fka tdfer
fka tdcnt1
fka tdfmtx
fka tdcont
end
fn dlrch1 to bool
fka tdrh0
fka tdrt0
dlkns tdsrh0
dlkns tdsrt0
r = fexec 20000000000
ret and eq r 0 gt get fxol 0 0
end
fn dlallhex to bool
n = get gdrefl 0
if or lt n 7 gt n 40
ret false
end
for i ulong n
if not dlishex get gdref i
ret false
end
end
ret true
end
note dlresolve: gdref of kind gdkind (1 head, 2 tag, 3 any head or tag name) to a commit in gdsha
fn dlresolve to bool
k = get gdkind 0
if eq k 1
if dlrevp 1
ret true
end
ret dlrevp 2
end
if eq k 2
if dlrevp 3
ret true
end
ret dlrevp 4
end
if dlrevp 1
ret true
end
if dlrevp 2
ret true
end
if dlrevp 3
ret true
end
ret dlrevp 4
end
note ---- archive names
note dlprefix: gdpre = <repo>-<ref> with / as -, a tag's leading v before a digit dropped; gdh16
fn dlprefix to void
put gdprel 0 0
for i ulong get frepol 0
dlprc get frepo i
end
dlprc 45
s = ulong 0
if and eq get gdkind 0 2 gt get gdrefl 0 1
if and eq get gdref 0 118 dldig get gdref 1
s = 1
end
end
for i ulong sub get gdrefl 0 s
c = get gdref add i s
if eq c 47
c = 45
end
dlprc c
end
dlh16
end
fn dlprc c uchar to void
n = get gdprel 0
if lt n 511
put gdpre n c
put gdprel 0 add n 1
end
end
fn dlh16 to void
b = new uchar 512 0
o = new uchar 32 0
n = get gdprel 0
for i ulong n
put b i get gdpre i
end
k = sha2_digest 256 view part b 0 n o
for i ulong 8
v = get o i
put gdh16 mul i 2 dlhx shr v 4
put gdh16 add mul i 2 1 dlhx and v 15
end
end
note ---- response fields
fn dlsetetag to void
put fetag 0 34
for i ulong 40
put fetag add i 1 get gdsha i
end
put fetag 41 34
put fetagl 0 42
end
fn dlsetcc to void
for i ulong len tdcc
put fcc i get tdcc i
end
put fccl 0 len tdcc
end
fn dlsetfile to void
n = get gdfl 0
for i ulong n
put ffile i get gdf i
end
put ffilel 0 n
end
note dlinm: If-None-Match holds "<gdsha>"
fn dlinm to bool
n = get finml 0
if lt n 42
ret false
end
for s ulong add sub n 42 1
if eq get finm s 34
if dlinm1 s
ret true
end
end
end
ret false
end
fn dlinm1 s ulong to bool
for i ulong 40
j = add add s 1 i
if ne get finm j get gdsha i
ret false
end
end
ret eq get finm add s 41 34
end
note ---- /archive/...
note dlparse: frest = /archive/[refs/heads/|refs/tags/]<name>.zip|.tar.gz into gdkind gdref gdfmt;
note 0 ok, 404 not an archive name, 400 a refused ref
fn dlparse to ulong
n = get frestl 0
e = n
fmt = ulong 0
if dlrend tdtgz
fmt = 2
e = sub n len tdtgz
end
if and eq fmt 0 dlrend tdzip
fmt = 1
e = sub n len tdzip
end
if eq fmt 0
ret 404
end
put gdfmt 0 fmt
a = len tdarch
k = ulong 3
if dlrat a tdheads
k = 1
a = add a len tdheads
end
if and eq k 3 dlrat a tdtags
k = 2
a = add a len tdtags
end
put gdkind 0 k
if le e a
ret 404
end
if not dlrcopy a e
ret 400
end
if not dlrefok
ret 400
end
ret 0
end
fn dlarch to long
c = dlparse
if ne c 0
ret long c
end
if eq get gdkind 0 3
if dlallhex
ret dlarsha
end
end
if not dlresolve
ret 404
end
if eq get gdfmt 0 1
ret dlarch2 tdezip tdctz
end
ret dlarch2 tdetgz tdctg
end
note dlarsha: /archive/<7..40 hex>: 302 to the archive of a head or tag at exactly that commit, else
note 404 (no archive is built for any other commit)
fn dlarsha to long
if not dlrevp 0
ret 404
end
if not dlpts
ret 404
end
put fkind 0 2
flocb
for i ulong get fownl 0
flocc get fown i
end
flocc 47
for i ulong get frepol 0
flocc get frepo i
end
if eq get gdkind 0 1
floct tdarhh
else
floct tdarht
end
for i ulong get gdrefl 0
flocc get gdref i
end
if eq get gdfmt 0 1
floct tdzip
else
floct tdtgz
end
ret 302
end
note dlpts: the first canonical head (else tag) that points at gdsha, peeled, into gdkind / gdref
note (refname order puts refs/heads and refs/namespaces/<nid>/refs/heads before any tag)
fn dlpts to bool
fkgit
fka tdfer
fka tdcnt1
fka tdfmtr
fka tdpts
dlksha
fka tdrh0
fka tdrt0
dlkns tdsrh0
dlkns tdsrt0
r = fexec 20000000000
if ne r 0
ret false
end
a = ulong 0
if dlxat 0 tdns
if not dlxat len tdns tfnid
ret false
end
a = add len tdns len tfnid
put gdkind 0 1
if dlxat a tdsrh
ret dlptsn add a len tdsrh
end
put gdkind 0 2
if dlxat a tdsrt
ret dlptsn add a len tdsrt
end
ret false
end
put gdkind 0 1
if dlxat 0 tdheads
ret dlptsn len tdheads
end
put gdkind 0 2
if dlxat 0 tdtags
ret dlptsn len tdtags
end
ret false
end
note dlptsn: the ref name in fxo from a to the newline into gdref, checked by dlrefok
fn dlptsn a ulong to bool
n = get fxol 0
e = a
for i ulong sub n a
if eq get fxo add a i 10
break
end
e = add e 1
end
if or le e a gt sub e a 200
ret false
end
for i ulong sub e a
put gdref i get fxo add a i
end
put gdrefl 0 sub e a
ret dlrefok
end
fn dlarch2 ext view uchar * ct view uchar * to long
dlprefix
dlfinal ext
dlsetetag
dlsetcc
if dlinm
put fkind 0 1
ret 304
end
r = dlensure 1
if eq r -7
ret dlbusy
end
if lt r 0
ret 500
end
put fkind 0 3
fsetct ct
fsetcd tdatt
for i ulong get gdprel 0
fcdc get gdpre i
end
fcdc 46
for i ulong len ext
fcdc get ext i
end
dlsetfile
ret 200
end
note ---- tags (releases)
note dltags: the tag list into gdtl, records split, short names, dedup and validity into gdkeep
fn dltags to bool
fkgit
fka tdfer
fka tdsortd
fka tdcnt5
fka tdtfmt
fka tdrt0
dlkns tdsrt0
r = fexec 20000000000
if ne r 0
ret false
end
n = hmin get fxol 0 len gdtl
for i ulong n
put gdtl i get fxo i
end
put gdtll 0 n
dlsplit
put gdkn 0 0
put gdlat 0 9999
for r2 ulong get gdrn 0
dlkeep1 r2
end
ret true
end
fn dlsplit to void
put gdrn 0 0
s = ulong 0
n = get gdtll 0
for i ulong n
if eq get gdtl i 30
k = get gdrn 0
if lt k 512
put gdrec k s
put gdrend k i
put gdrn 0 add k 1
end
s = add i 1
if lt s n
if eq get gdtl s 10
s = add s 1
end
end
end
end
end
note dlfld: field k of record r into gdfa / gdfn (fields split by 0x1f)
fn dlfld r ulong k ulong to void
a = get gdrec r
e = get gdrend r
f = ulong 0
s = a
for i ulong sub e a
j = add a i
if eq get gdtl j 31
if eq f k
put gdfa 0 s
put gdfn 0 sub j s
ret
end
f = add f 1
s = add j 1
end
end
if eq f k
put gdfa 0 s
put gdfn 0 sub e s
ret
end
put gdfa 0 e
put gdfn 0 0
end
note dlgat: gdtl[a, a + n) starts at o with t
fn dlgat o ulong e ulong t view uchar * to bool
if gt add o len t e
ret false
end
for i ulong len t
if ne get gdtl add o i get t i
ret false
end
end
ret true
end
fn dlfeq t view uchar * to bool
if ne get gdfn 0 len t
ret false
end
a = get gdfa 0
ret dlgat a add a len t t
end
note dlshort: the short tag name of record r (after refs/tags/ or the delegate prefix); false if neither
fn dlshort r ulong to bool
dlfld r 0
a = get gdfa 0
e = add a get gdfn 0
if dlgat a e tdtags
put gdso r add a len tdtags
put gdsl r sub e add a len tdtags
ret true
end
if not dlgat a e tdns
ret false
end
o = add a len tdns
if not dlgat o e tfnid
ret false
end
o = add o len tfnid
if not dlgat o e tdsrt
ret false
end
o = add o len tdsrt
put gdso r o
put gdsl r sub e o
ret true
end
fn dlsn2ref r ulong to void
n = hmin get gdsl r 255
a = get gdso r
for i ulong n
put gdref i get gdtl add a i
end
put gdrefl 0 n
put gdkind 0 2
end
fn dlsneq r ulong q ulong to bool
n = get gdsl r
if ne n get gdsl q
ret false
end
a = get gdso r
b = get gdso q
for i ulong n
if ne get gdtl add a i get gdtl add b i
ret false
end
end
ret true
end
note dlcommit: the peeled commit of record r (offset into gdtl in gdco); false for non-commits
fn dlcmof r ulong to bool
dlfld r 1
if dlfeq tdcommit
dlfld r 2
put gdco r get gdfa 0
ret eq get gdfn 0 40
end
dlfld r 3
if dlfeq tdcommit
dlfld r 4
put gdco r get gdfa 0
ret eq get gdfn 0 40
end
ret false
end
fn dlkeep1 r ulong to void
if not dlshort r
ret
end
dlsn2ref r
if not dlrefok
ret
end
if not dlcmof r
ret
end
for i ulong get gdkn 0
if dlsneq r get gdkeep i
ret
end
end
k = get gdkn 0
if ge k 512
ret
end
put gdkeep k r
put gdkn 0 add k 1
if eq get gdlat 0 9999
if not dlpre
put gdlat 0 r
end
end
end
note dlpre: gdref looks like a pre-release (-rc -alpha -beta -pre -dev)
fn dlpre to bool
if dlrhas tdrc
ret true
end
if dlrhas tdalpha
ret true
end
if dlrhas tdbeta
ret true
end
if dlrhas tdprer
ret true
end
ret dlrhas tddev
end
fn dlrhas t view uchar * to bool
n = get gdrefl 0
if lt n len t
ret false
end
for s ulong add sub n len t 1
if dlrhas1 s t
ret true
end
end
ret false
end
fn dlrhas1 s ulong t view uchar * to bool
for i ulong len t
if ne get gdref add s i get t i
ret false
end
end
ret true
end
fn dlsetsha r ulong to void
a = get gdco r
for i ulong 40
put gdsha i get gdtl add a i
end
end
note ---- HTML pieces
fn dlescref to void
for i ulong get gdrefl 0
fescc get gdref i
end
end
fn dlescf to void
a = get gdfa 0
for i ulong get gdfn 0
fescc get gdtl add a i
end
end
fn dlrepol to void
fputb
fputrepo
end
note dlrel1: one release article for kept record r; full adds the release-assets/ files
fn dlrel1 r ulong full bool to void
dlsn2ref r
dlsetsha r
fput tdart1
dlrepol
fput tdrtag
dlescref
fput tdq2
dlescref
fput tdax
if dlpre
fput tdlpre
end
if eq get gdlat 0 r
fput tdllat
end
fput tdmeta
dlfld r 5
dlescf
fput tdcmt1
dlrepol
fput tdcommp
for i ulong 40
fputc get gdsha i
end
fput tdq2
fput tdcode
for i ulong 7
fputc get gdsha i
end
fput tdcmtx
dlnotes r
fput tdtbl
dlarow 1
dlarow 2
if full
dlassets
end
fput tdtblx
end
fn dlnotes r ulong to void
dlfld r 1
if not dlfeq tdtag
ret
end
dlfld r 7
if gt get gdfn 0 0
fput tdsubj
dlescf
fput tdpx
end
dlfld r 8
if gt get gdfn 0 0
fput tdnotes
dlescf
fput tdprex
end
end
note dlarow: the source archive row (fmt 1 zip, 2 tar.gz) of the release in gdref / gdsha
fn dlarow fmt ulong to void
put gdfmt 0 fmt
dlprefix
if eq fmt 1
dlfinal tdezip
else
dlfinal tdetgz
end
fput tdtr1
dlrepol
fput tdarht
dlescref
if eq fmt 1
fput tdzip
else
fput tdtgz
end
fput tdq2
for i ulong get gdprel 0
fescc get gdpre i
end
if eq fmt 1
fput tdzip
else
fput tdtgz
end
fput tdsrc
fput tdax
dlsumcells
end
note dlsumcells: the size and SHA-256 cells of gdf (archive or blob) only when it is already built
note with its sidecar; rendering a page never builds or hashes anything
fn dlsumcells to void
if dlexists
if dlsumrd
fput tdtd
fnum get gdsize 0
fput tdtdc
for i ulong 64
fputc get gdhex i
end
fput tdtrx
ret
end
end
fput tdnb
end
note ---- release-assets/ of a tag (the commit in gdsha)
note dllsa: git ls-tree -l -z <commit> -- release-assets/ into gdan / gdab / gdasz / gdanm / gdanl
fn dllsa to void
put gdan 0 0
fkgit
fka tdlstr
fka tdlopt
fka tdzopt
dlksha
fka tddd
fka tdradir
r = fexec 20000000000
if ne r 0
ret
end
n = get fxol 0
s = ulong 0
for i ulong n
if eq get fxo i 0
dllsa1 s i
s = add i 1
end
end
end
note dllsa1: one entry fxo[s, e) "<mode> blob <sha> <size>\t<path>"
fn dllsa1 s ulong e ulong to void
k = get gdan 0
if ge k 64
ret
end
t = s
for i ulong sub e s
if eq get fxo add s i 9
t = add s i
break
end
end
if or le t s lt sub t s 53
ret
end
p = s
for i ulong 8
if eq get fxo add s i 32
p = add add s i 1
break
end
end
if ne get fxo p 98
ret
end
q = add p 4
if ne get fxo q 32
ret
end
q = add p 45
if ne get fxo q 32
ret
end
dllsa2 k add p 5 add p 46 t e
end
fn dllsa2 k ulong h ulong z ulong t ulong e ulong to void
a = add t 1
if not dlxat a tdradir
ret
end
a = add a len tdradir
nl = sub e a
if or eq nl 0 gt nl 120
ret
end
for i ulong nl
put gdasn i get fxo add a i
end
put gdasnl 0 nl
if not dlasok
ret
end
dllsa3 k h nl dlszp z t
end
fn dlszp z ulong t ulong to ulong
sz = ulong 0
for i ulong sub t z
c = get fxo add z i
if dldig c
sz = add mul sz 10 ulong sub c 48
end
end
ret sz
end
fn dllsa3 k ulong h ulong nl ulong sz ulong to void
b = mul k 40
for i ulong 40
j = add h i
put gdab add b i get fxo j
end
b = mul k 128
for i ulong nl
put gdanm add b i get gdasn i
end
put gdanl k nl
put gdasz k sz
put gdan 0 add k 1
end
fn dlxat o ulong t view uchar * to bool
if gt add o len t get fxol 0
ret false
end
for i ulong len t
if ne get fxo add o i get t i
ret false
end
end
ret true
end
fn dlassets to void
dllsa
c = new uchar 40 0
for i ulong 40
put c i get gdsha i
end
for k ulong get gdan 0
dlasrow k
end
for i ulong 40
put gdsha i get c i
end
end
fn dlabsha k ulong to void
for i ulong 40
put gdsha i get gdab add mul k 40 i
end
end
fn dlasrow k ulong to void
fput tdtr1
dlrepol
fput tdrdl
dlescref
fputc 47
n = get gdanl k
for i ulong n
fescc get gdanm add mul k 128 i
end
fput tdq2
for i ulong n
fescc get gdanm add mul k 128 i
end
fput tdax
dlabsha k
dlfblob
dlsumcells
end
note dlblobf: (browse /raw/ over 8 MiB) blob id s[0,40) into the blob cache and ffile; 0 ok, -1 not a
note lowercase hex id, else dlensure's code (-7 = cold-build cap full: answer with dlbusy)
fn dlblobf s view uchar * to long
if lt len s 40
ret -1
end
for i ulong 40
c = get s i
if not dlishex c
ret -1
end
put gdsha i c
end
dlfblob
r = dlensure 2
if lt r 0
ret r
end
dlsetfile
ret 0
end
note ---- /releases pages
fn dlrtitle t view uchar * to void
fsetti t
for i ulong get frepol 0
ftic get frepo i
end
end
fn dlpageq to ulong
n = fqget tdpage
if or le n 0 gt n 4
ret 1
end
v = ulong 0
for i ulong ulong n
c = get fval i
if not dldig c
ret 1
end
v = add mul v 10 ulong sub c 48
end
if eq v 0
ret 1
end
ret v
end
fn dlrels to long
if not dltags
ret 500
end
p = dlpageq
s = mul sub p 1 10
kn = get gdkn 0
if and gt p 1 ge s kn
ret 404
end
dlrtitle tdtrel
frepohd 4
fput tdsec1
if eq kn 0
fput tdnorel
fput tdsecx
ret 200
end
for i ulong 10
k = add s i
if ge k kn
break
end
dlrel1 get gdkeep k false
end
dlpager p kn
fput tdsecx
ret 200
end
fn dlpager p ulong kn ulong to void
more = lt mul p 10 kn
if and eq p 1 not more
ret
end
fput tdpg1
if gt p 1
fput tdpgn
fnum sub p 1
fput tdpgnew
end
if more
fput tdpgn
fnum add p 1
fput tdpgold
end
fput tdnavx
end
fn dlrlat to long
if not dltags
ret 500
end
r = get gdlat 0
if eq r 9999
ret 404
end
dlsn2ref r
put fkind 0 2
flocb
for i ulong get fownl 0
flocc get fown i
end
flocc 47
for i ulong get frepol 0
flocc get frepo i
end
floct tdrtag
for i ulong get gdrefl 0
flocc get gdref i
end
ret 302
end
note dlrfind: the kept record whose short name is gdref, or 9999
fn dlrfind to ulong
n = get gdrefl 0
for i ulong get gdkn 0
r = get gdkeep i
if eq get gdsl r n
if dlrfind1 r
ret r
end
end
end
ret 9999
end
fn dlrfind1 r ulong to bool
a = get gdso r
for i ulong get gdrefl 0
if ne get gdtl add a i get gdref i
ret false
end
end
ret true
end
note dltags reuses gdref per record, so the requested tag is copied in only after it
fn dlrtag to long
if not dltags
ret 500
end
if not dlrcopy len tdrtag get frestl 0
ret 404
end
if not dlrefok
ret 400
end
r = dlrfind
if eq r 9999
ret 404
end
dlrtitle tdtrel1
frepohd 4
fput tdsec1
dlrel1 r true
fput tdsecx
ret 200
end
note dlrdl: /releases/download/<tag>/<asset>, the asset from release-assets/ of the tag's commit
fn dlrdl to long
a = len tdrdl
e = get frestl 0
m = e
for i ulong sub e a
j = sub sub e 1 i
if eq get frest j 47
m = j
break
end
end
if or ge m e le m a
ret 404
end
put gdasnl 0 0
if gt sub e add m 1 120
ret 400
end
for i ulong sub e add m 1
put gdasn i get frest add add m 1 i
end
put gdasnl 0 sub e add m 1
if not dlasok
ret 400
end
for i ulong get gdasnl 0
put gdwant i get gdasn i
end
put gdwantl 0 get gdasnl 0
if not dlrcopy a m
ret 400
end
if not dlrefok
ret 400
end
put gdkind 0 2
if not dlresolve
ret 404
end
ret dlrdl2
end
fn dlrdl2 to long
dllsa
k = dlasfind
if eq k 9999
ret 404
end
dlabsha k
dlfblob
dlsetetag
dlsetcc
if dlinm
put fkind 0 1
ret 304
end
r = dlensure 2
if eq r -7
ret dlbusy
end
if lt r 0
ret 500
end
put fkind 0 3
fsetct tdcto
fsetcd tdatt
for i ulong get gdwantl 0
fcdc get gdwant i
end
dlsetfile
ret 200
end
note dlasfind: the listed asset named gdwant (dllsa reuses gdasn while it scans), or 9999
fn dlasfind to ulong
n = get gdwantl 0
for k ulong get gdan 0
if eq get gdanl k n
if dlasfind1 k n
ret k
end
end
end
ret 9999
end
fn dlasfind1 k ulong n ulong to bool
for i ulong n
if ne get gdanm add mul k 128 i get gdwant i
ret false
end
end
ret true
end
fn dlrelr to long
if or dlreq tdrel dlreq tdrel2
if fjwant
ret dljrels
end
fyalt
ret dlrels
end
if dlreq tdlat
ret dlrlat
end
if dlrst tdrtag
if fjwant
ret dljrtag
end
fyalt
ret dlrtag
end
if dlrst tdrdl
ret dlrdl
end
ret 404
end
note ---- clone panel for the repo header (current repo: frid, frepo); default branch from nodes/head.om
fn dldefbr to void
if nshead
put gdrefl 0 0
for i ulong get nshbl 0 bound 256
put gdref i get nshb i
end
put gdrefl 0 get nshbl 0
if dlrefok
ret
end
end
for i ulong len tdmain
put gdref i get tdmain i
end
put gdrefl 0 len tdmain
end
fn dlputrid to void
for i ulong get fridl 0
fescc get frid i
end
end
fn dlclone to void
dldefbr
fput tdcl1
dlputrid
fput tdcl2
dlputrid
fput tdcl3
dlescref
fput tdcl4
dlrepol
fput tdarhh
dlescref
fput tdcl5
dlrepol
fput tdarhh
dlescref
fput tdcl6
end
note ---- dispatch
fn dlroute to long
if ge get fridx 0 get fan 0
ret 0
end
arch = dlrst tdarch
rel = or dlreq tdrel dlrst tdrel2
if and not arch not rel
ret 0
end
m = get fmeth 0
if and ne m 1 ne m 2
ret 405
end
if arch
ret dlarch
end
ret dlrelr
end

text tdfmtx "--format=x"
text tdsortd "--sort=-creatordate"
text tdcnt5 "--count=500"
text tdtfmt "--format=%(refname)%1f%(objecttype)%1f%(objectname)%1f%(*objecttype)%1f%(*objectname)%1f%(creatordate:short)%1f%(creatordate:unix)%1f%(contents:subject)%1f%(contents:body)%1e"
text tdcatf "cat-file"

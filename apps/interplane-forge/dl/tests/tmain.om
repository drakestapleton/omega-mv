note dl/tests/tmain.om: TEST-ONLY driver. One request per process, no socket:
note   dltest STORE ALLOWFILE METHOD PATH BASE INM QUERY [PATH2 ...]  (INM and QUERY: - for none)
note Extra PATHs are served by the same process after the first (state kept, as in the server).
note STORE ends in /; ALLOWFILE has lines "<repo-name> <rid>". Sets the contract request globals the
note way the server does (fridx, frid, fown, frepo, frest), calls dlroute, and prints the response:
note METHOD BLOBF calls dlblobf (browse's large /raw/ entry point) on the PATH rest after the repo.
note METHOD CLONE calls dlclone instead (PATH still selects the repo). Prints STATUS / KIND / CT / CD / ETAG / CC / LOC / FILE / TITLE lines, "--", then fob.
global gtarg uchar 4096
global gtargl ulong 1
global gtal uchar 65536
global gtall ulong 1
text tthead "HEAD"
text ttclone "CLONE"
text ttblobf "BLOBF"
text ttget "GET"
text ttst "STATUS "
text ttkind "KIND "
text ttct "CT "
text ttcd "CD "
text ttet "ETAG "
text ttcc "CC "
text ttloc "LOC "
text ttfile "FILE "
text ttti "TITLE "
text ttra "RETRY "
text ttsep "--\n"
text ttnl "\n"
fn tout t view uchar * to void
x = write 1 t 0 len t
end
fn toutn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
w = write 1 d i sub 20 i
end
fn targ i ulong to bool
put gtargl 0 0
if ge i ulong argcnt
ret false
end
n = argread i gtarg 0 4096
if lt n 0
ret false
end
put gtargl 0 ulong n
ret true
end
fn targis t view uchar * to bool
if ne get gtargl 0 len t
ret false
end
for i ulong len t
if ne get gtarg i get t i
ret false
end
end
ret true
end
fn tdash to bool
ret and eq get gtargl 0 1 eq get gtarg 0 45
end
fn tloadal to bool
fd = fopen gtarg 0 get gtargl 0 524288 0
if lt fd 0
ret false
end
r = read int fd gtal 0 65536
x = fclose int fd
if lt r 0
ret false
end
put gtall 0 ulong r
ret true
end
note tlfind scans for the repo name frepo and fills frid; returns the line index or 9999
fn tlfind to ulong
n = get gtall 0
s = ulong 0
k = ulong 0
for i ulong n
if eq get gtal i 10
if tlmatch s i
ret k
end
k = add k 1
s = add i 1
end
end
ret 9999
end
fn tlmatch s ulong e ulong to bool
m = get frepol 0
if le sub e s add m 1
ret false
end
for i ulong m
if ne get gtal add s i get frepo i
ret false
end
end
if ne get gtal add s m 32
ret false
end
a = add add s m 1
put fridl 0 sub e a
for i ulong sub e a
put frid i get gtal add a i
end
ret true
end
fn tcount to ulong
k = ulong 0
for i ulong get gtall 0
if eq get gtal i 10
k = add k 1
end
end
ret k
end
note tsplit: fpath = /<owner>/<repo><rest>
fn tsplit to void
put fridx 0 9999
n = get fpathl 0
i = ulong 1
for it ulong n
if or ge i n eq get fpath i 47
break
end
i = add i 1
end
if ge i n
ret
end
put fownl 0 sub i 1
for k ulong sub i 1
put fown k get fpath add k 1
end
j = add i 1
for it ulong n
if or ge j n eq get fpath j 47
break
end
j = add j 1
end
if or le j add i 1 gt sub sub j i 1 127
ret
end
put frepol 0 sub sub j i 1
for k ulong get frepol 0
put frepo k get fpath add add i 1 k
end
put frestl 0 sub n j
for k ulong sub n j
put frest k get fpath add j k
end
if not tisowner
ret
end
put fridx 0 tlfind
end
fn tisowner to bool
if ne get fownl 0 len tfowner
ret false
end
for i ulong len tfowner
if ne get fown i get tfowner i
ret false
end
end
ret true
end
fn tcp1 to void
n = get gtargl 0
for i ulong n
put gtstore i get gtarg i
end
put gtstl 0 n
end
fn tsetreq to bool
put fmeth 0 0
if targis ttget
put fmeth 0 1
end
if targis tthead
put fmeth 0 2
end
if targis ttclone
put fmeth 0 9
end
if targis ttblobf
put fmeth 0 8
end
if not targ 4
ret false
end
n = get gtargl 0
for i ulong n
put fpath i get gtarg i
end
put fpathl 0 n
if not targ 5
ret false
end
n = get gtargl 0
for i ulong n
put fbase i get gtarg i
end
put fbasel 0 n
ret tsetreq2
end
fn tsetreq2 to bool
put finml 0 0
if not targ 6
ret false
end
if not tdash
n = get gtargl 0
for i ulong n
put finm i get gtarg i
end
put finml 0 n
end
put fqsl 0 0
if not targ 7
ret false
end
if not tdash
n = get gtargl 0
for i ulong n
put fqs i get gtarg i
end
put fqsl 0 n
end
ret true
end
fn tprint st long to void
tout ttst
toutn ulong st
tout ttnl
tout ttkind
toutn get fkind 0
tout ttnl
x = write 1 ttct 0 len ttct
x = write 1 fct 0 get fctl 0
tout ttnl
x = write 1 ttcd 0 len ttcd
x = write 1 fcd 0 get fcdl 0
tout ttnl
x = write 1 ttet 0 len ttet
x = write 1 fetag 0 get fetagl 0
tout ttnl
tprint2
end
fn tprint2 to void
x = write 1 ttcc 0 len ttcc
x = write 1 fcc 0 get fccl 0
tout ttnl
x = write 1 ttloc 0 len ttloc
x = write 1 floc 0 get flocl 0
tout ttnl
x = write 1 ttfile 0 len ttfile
x = write 1 ffile 0 get ffilel 0
tout ttnl
x = write 1 ttti 0 len ttti
x = write 1 fti 0 get ftil 0
tout ttnl
tout ttra
toutn get fretry 0
tout ttnl
tout ttsep
x = write 1 fob 0 get fobl 0
end
fn main to int
if not targ 1
ret 2
end
tcp1
if not targ 2
ret 2
end
if not tloadal
ret 3
end
put fan 0 tcount
if not targ 3
ret 2
end
if not tsetreq
ret 2
end
tsplit
put fkind 0 0
st = long 0
if eq get fmeth 0 9
dlclone
else
st = tblobf
end
tprint st
for k ulong 8
if not targ add 8 k
break
end
tnext
end
ret 0
end
note tblobf: METHOD BLOBF calls dlblobf on PATH's rest after the repo (/<owner>/<repo>/<blob id>)
fn tblobf to long
if ne get fmeth 0 8
ret dlroute
end
n = get frestl 0
if or lt n 1 gt n 64
ret -9
end
b = new uchar 64 0
for i ulong sub n 1
put b i get frest add i 1
end
ret dlblobf view part b 0 sub n 1
end
note tnext: one more request on the PATH in gtarg, response fields cleared as the server does
fn tnext to void
n = get gtargl 0
for i ulong n
put fpath i get gtarg i
end
put fpathl 0 n
put fkind 0 0
put fctl 0 0
put fcdl 0 0
put fetagl 0 0
put fccl 0 0
put flocl 0 0
put ffilel 0 0
put ftil 0 0
put fobl 0 0
put fretry 0 0
tsplit
st = dlroute
tprint st
end

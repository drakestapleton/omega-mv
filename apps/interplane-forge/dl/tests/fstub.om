fn fputc c uchar to void
n = get fobl 0
if lt n len fob
put fob n c
put fobl 0 add n 1
end
end
fn fput s view uchar * to void
for i ulong len s
fputc get s i
end
end
fn fescc c uchar to void
if eq c 38
fput tfamp
ret
end
if eq c 60
fput tflt
ret
end
if eq c 62
fput tfgt
ret
end
if eq c 34
fput tfquot
ret
end
if eq c 39
fput tfapos
ret
end
fputc c
end
fn fesc s view uchar * to void
for i ulong len s
fescc get s i
end
end
fn fnum v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 20 i
fputc get d add i k
end
end
fn fputb to void
for i ulong get fbasel 0
fputc get fbase i
end
end
fn fputrepo to void
for i ulong get fownl 0
fescc get fown i
end
fputc 47
for i ulong get frepol 0
fescc get frepo i
end
end
fn frepohd tab ulong to void
fput tfhd
fnum tab
fput tfhdx
end
fn fsetct t view uchar * to void
for i ulong len t
put fct i get t i
end
put fctl 0 len t
end
fn fsetcd t view uchar * to void
for i ulong len t
put fcd i get t i
end
put fcdl 0 len t
end
fn fcdc c uchar to void
n = get fcdl 0
if lt n 512
put fcd n c
put fcdl 0 add n 1
end
end
fn fsetti t view uchar * to void
put ftil 0 0
for i ulong len t
ftic get t i
end
end
fn ftic c uchar to void
n = get ftil 0
if lt n 256
put fti n c
put ftil 0 add n 1
end
end
fn flocb to void
n = get fbasel 0
for i ulong n
put floc i get fbase i
end
put flocl 0 n
end
fn flocc c uchar to void
n = get flocl 0
if lt n 4096
put floc n c
put flocl 0 add n 1
end
end
fn floct t view uchar * to void
for i ulong len t
flocc get t i
end
end
note fqget: query param n from fqs into fval (percent-decoded, + = space); length or -1
fn fqget n view uchar * to long
q = get fqsl 0
s = ulong 0
for i ulong add q 1
if or eq i q eq get fqs i 38
if fqmatch s i n
ret fqdec add s add len n 1 i
end
s = add i 1
end
end
ret -1
end
fn fqmatch s ulong e ulong n view uchar * to bool
if lt sub e s add len n 1
ret false
end
for i ulong len n
if ne get fqs add s i get n i
ret false
end
end
ret eq get fqs add s len n 61
end
fn fqdec a ulong e ulong to long
k = ulong 0
i = a
for it ulong 4096
if ge i e
break
end
c = get fqs i
if eq c 43
c = 32
end
put fval k c
k = add k 1
i = add i 1
end
ret long k
end
note ---- argv packet fpk
fn fkb to void
put fpk 0 0
put fpk 1 0
put fpkl 0 2
end
fn fkopen to void
n = get fpkl 0
put fpkr 0 n
put fpk n 0
put fpk add n 1 0
put fpkl 0 add n 2
c = add or ulong get fpk 0 shl ulong get fpk 1 8 1
put fpk 0 uchar and c 255
put fpk 1 uchar shr c 8
end
fn fkc c uchar to void
n = get fpkl 0
if lt n 8191
put fpk n c
put fpkl 0 add n 1
r = get fpkr 0
k = add or ulong get fpk r shl ulong get fpk add r 1 8 1
put fpk r uchar and k 255
put fpk add r 1 uchar shr k 8
end
end
fn fka t view uchar * to void
fkopen
for i ulong len t
fkc get t i
end
end
fn fkgit to void
fkb
fka tfgit
fkopen
for i ulong len tfgitd
fkc get tfgitd i
end
for i ulong get gtstl 0
fkc get gtstore i
end
for i ulong get fridl 0
fkc get frid i
end
end
fn fpfdv i ulong to int
b = mul i 4
v = or ulong get fpfd b shl ulong get fpfd add b 1 8
v = or v shl ulong get fpfd add b 2 16
v = or v shl ulong get fpfd add b 3 24
ret int v
end
fn fchild wfd int to void
nul = fopen tfnul 0 len tfnul 2 0
if lt nul 0
exit 126
end
x = dupfd int nul 0 0
x = dupfd wfd 1 0
x = dupfd int nul 2 0
x = execprog fpk 0 get fpkl 0
exit 127
end
fn fdrain fd int dl long to bool
for it ulong 1000000
left = sub dl long monons
if le left 0
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret false
end
continue
end
if eq w 0
continue
end
n = get fxol 0
if ge n len fxo
put fxotr 0 1
r = read fd fjunk 0 4096
if eq r 0
ret true
end
if and lt r 0 and ne r -4 ne r -11
ret false
end
continue
end
r = read fd fxo n sub len fxo n
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
continue
end
put fxol 0 add n ulong r
end
ret false
end
fn freap pid int dl long to long
for it ulong 100000
w = waitpid pid fwst 0 4 1
if eq w long pid
s = or ulong get fwst 0 shl ulong get fwst 1 8
if eq and s 127 0
ret long and shr s 8 255
end
ret -3
end
if lt w 0
if ne w -4
ret -4
end
continue
end
if gt long monons dl
x = killpid pid 9
w = waitpid pid fwst 0 4 0
ret -1
end
x = sleepns 2000000
end
ret -4
end
fn fexec tmo long to long
put fxol 0 0
put fxotr 0 0
r = pipefds fpfd 0 8 524288
if lt r 0
ret -2
end
rfd = fpfdv 0
wfd = fpfdv 1
dl = add long monons tmo
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
fchild wfd
exit 127
end
x = fclose wfd
ok = fdrain rfd dl
x = fclose rfd
if not ok
x = killpid int pid 9
end
st = freap int pid dl
if not ok
ret -1
end
ret st
end

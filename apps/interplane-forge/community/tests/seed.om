note community/tests/seed.om -- test fixture: publish one part in a scratch salvage store through the
note real salvage routes (source, derive, verify by one collector pass, publish), as
note salvage/tests/journey.om does. Compose every forge unit with server main renamed, then this unit.
note argv: store directory (absolute, ending in /), source file, stdin file, expected file, title.
note Prints the published part id. Needs OMEGA_COMPILER (the salvage pin) like the journey test.
text ckcsrf "11111111111111111111111111111111"
text ckuser "did:key:community-fixture"
text cksrc "csrf=11111111111111111111111111111111&action=source&consent=yes&title=Community+fixture+source&origin=https%3A%2F%2Fexample.org%2Ffixture&license=MIT&description=fixture&source=fixture&credit=Fixture&language=text"
text ckpre "csrf=11111111111111111111111111111111&action=derive&consent=yes&title="
text ckdesc "&description=community+fixture&source="
text ckin "&input="
text ckexp "&expected="
text ckver "csrf=11111111111111111111111111111111&action=verify"
text ckpub "csrf=11111111111111111111111111111111&action=publish"
text ckhexu "0123456789ABCDEF"
text ckfail "seed: FAIL at step "
global ckb uchar 65536
global ckbl ulong 1

fn ckstep ok bool k ulong to void
d = new uchar 4 0
if not ok
r = write 2 ckfail 0 len ckfail
put d 0 uchar add div k 10 48
put d 1 uchar add rem k 10 48
put d 2 10
r = write 2 d 0 3
exit 1
end
end

fn ckadd s view uchar * to void
n = get ckbl 0
for i ulong len s bound 65536
put ckb add n i get s i
end
put ckbl 0 add n len s
end

note ckenc: s percent-encoded (A-Z a-z 0-9 - _ . ~ kept)
fn ckenc s view uchar * to void
for i ulong len s bound 65536
ckenc1 get s i
end
end

fn ckkeep c uchar to bool
a = or and ge c 97 le c 122 and ge c 65 le c 90
b = or and ge c 48 le c 57 or eq c 45 eq c 95
ret or or a b or eq c 46 eq c 126
end

fn ckenc1 c uchar to void
n = get ckbl 0
if ckkeep c
put ckb n c
put ckbl 0 add n 1
else
put ckb n 37
put ckb add n 1 get ckhexu ulong shr c 4
put ckb add n 2 get ckhexu ulong and c 15
put ckbl 0 add n 3
end
end

note ckfile: argv[i] names a file; its bytes, encoded
fn ckfile i ulong to void
p = new uchar 1024 0
b = new uchar 16384 0
n = argread i p 0 1024
ckstep gt n 0 90
fd = fopen p 0 ulong n 557056 0
ckstep ge fd 0 91
r = read int fd b 0 16384
x = fclose int fd
ckstep ge r 0 92
ckenc part b 0 ulong r
end

fn ckarg i ulong to void
p = new uchar 1024 0
n = argread i p 0 1024
ckstep gt n 0 93
ckenc part p 0 ulong n
end

note ckbody: the form in ckb as the POST body of a fresh request
fn ckbody to void
fresetr
put fmeth 0 3
n = get ckbl 0
put fbodyl 0 n
put fbasel 0 1
put fbase 0 47
for i ulong n bound 65536
put fbody i get ckb i
end
end

fn cktext t view uchar * to void
put ckbl 0 0
ckadd t
ckbody
end

fn ckuserset to void
sokclr
sokt ckuser
who = sointern
put gscur 0 who
put gsok 0 1
put fcsrfl 0 32
for i ulong 32
put fcsrf i get ckcsrf i
end
end

fn main to int
p = new uchar 512 0
srcid = new uchar 64 0
partid = new uchar 64 0
n = argread 1 p 0 512
ckstep gt n 0 1
ckstep slroot view part p 0 ulong n 2
ckstep slinit 3
put glboot 0 1
soreset
ckuserset
cktext cksrc
ckstep eq slpost tlempty 303 4
for i ulong 64
put srcid i get glrid i
end
put ckbl 0 0
ckadd ckpre
ckarg 5
ckadd ckdesc
ckfile 2
ckadd ckin
ckfile 3
ckadd ckexp
ckfile 4
ckbody
ckstep eq slpost srcid 303 5
for i ulong 64
put partid i get glrid i
end
cktext ckver
ckstep eq slpost partid 303 6
ckstep eq slcollect 1 7
ckstep eq slreceiptget partid 1 8
cktext ckpub
ckstep eq slpost partid 303 9
put gscur 0 0
ckstep slpublic partid 10
r = write 1 partid 0 64
put p 0 10
r = write 1 p 0 1
ret 0
end

note community/10msg.om -- POST /community/api: parse, check and store one ipcc1 message.

text cmct "text/plain; charset=utf-8"
text cmnost "no-store"
text cmrok "ipcc1 ok "
text cmrref "ipcc1 refused "
text cmkreg "registered\n"
text cmknone "none\nretry 600\n"
text cmkjob "job\n"
text cmkcnt "counted\n"
text cmkstor "stored\n"
text cmkleft "left\n"
text cmlnone "none"
text cmlcnt "counted"
text cmldup "duplicate"
text cmlcell "stored-cell"
text cmlj "j"
text cmll "l"

note ---- the reply
fn cm_reply st long to long
fsetct cmct
fsetcc cmnost
put fkind 0 1
put fobl 0 0
ret st
end

fn cm_rok k view uchar * to long
x = cm_reply 200
fput cmrok
fput k
ret 200
end

note cm_wcp: the reason word for code e into d; its length
fn cm_wcp e ulong d edit uchar * to ulong
if eq e cmemal
ret cm_cp d 0 cmw1
end
if eq e cmesize
ret cm_cp d 0 cmw2
end
if eq e cmeclk
ret cm_cp d 0 cmw3
end
if eq e cmesig
ret cm_cp d 0 cmw4
end
if eq e cmeunr
ret cm_cp d 0 cmw5
end
if eq e cmeden
ret cm_cp d 0 cmw6
end
if eq e cmejob
ret cm_cp d 0 cmw7
end
if eq e cmemis
ret cm_cp d 0 cmw8
end
if eq e cmedup
ret cm_cp d 0 cmw9
end
if eq e cmerk
ret cm_cp d 0 cmw10
end
if eq e cmera
ret cm_cp d 0 cmw11
end
if eq e cmeoff
ret cm_cp d 0 cmw12
end
ret cm_cp d 0 cmw13
end

fn cm_status e ulong to long
if or eq e cmemal eq e cmeio
ret 400
end
if eq e cmesize
ret 413
end
if eq e cmedup
ret 409
end
if or eq e cmerk eq e cmera
ret 429
end
if eq e cmeoff
ret 503
end
ret 403
end

note cm_refuse: answer "ipcc1 refused <reason>" and append "<t> <reason> <key|-> <msg|->" to refused
fn cm_refuse e ulong to long
d = new uchar 256 0
w = new uchar 16 0
st = cm_status e
wl = cm_wcp e w
x = cm_reply st
fput cmrref
fput part w 0 wl
fput cmnl
k = cm_decput d 0 cm_now
k = cm_cp d k cmsp
k = cm_cp d k part w 0 wl
k = cm_cp d k cmsp
k = cm_khex d k
k = cm_cp d k cmsp
k = cm_shex d k
k = cm_cp d k cmnl
if eq get cmgv cmon 1
cm_p0
cm_pa cmtref
y = cm_app part d 0 k
end
ret st
end

note cm_khex / cm_shex: the key id / message hash when known, else "-"
fn cm_khex d edit uchar * o ulong to ulong
if ne get cmgv cmcsec 1
ret cm_cp d o cmdash
end
for i ulong 64
put d add o i get cmkid i
end
ret add o 64
end

fn cm_shex d edit uchar * o ulong to ulong
if ne get cmgv cmchub 1
ret cm_cp d o cmdash
end
for i ulong 64
put d add o i get cmsha i
end
ret add o 64
end

note ---- parsing (exact form: docs/PROTOCOL.md)
note cm_bodyis: fbody[o, o+len t) is t
fn cm_bodyis o ulong t view uchar * to bool
if gt add o len t get fbodyl 0
ret false
end
for i ulong len t bound 4096
if ne get fbody add o i get t i
ret false
end
end
ret true
end

note cm_kw: "ipcc1 " then t then LF at the start of the body
fn cm_kw t view uchar * to bool
o = len cmtip
if not cm_bodyis o t
ret false
end
e = add o len t
if ge e get fbodyl 0
ret false
end
if ne get fbody e 10
ret false
end
put cmgv cmcur add e 1
ret true
end

fn cm_kind to ulong
if not cm_bodyis 0 cmtip
ret 0
end
if cm_kw cmtreg
ret 1
end
if cm_kw cmtnext
ret 2
end
if cm_kw cmtres
ret 3
end
if cm_kw cmtlv
ret 4
end
ret 0
end

note cm_f: the next line must be "nm <value>" with a value of type ty (1 hex of exactly ln
note characters, 2 decimal, 3 exit outcome); records the field and moves the cursor
fn cm_f i ulong nm view uchar * ty ulong ln ulong to bool
c = get cmgv cmcur
n = get fbodyl 0
if not cm_bodyis c nm
ret false
end
v = add add c len nm 1
if gt v n
ret false
end
if ne get fbody sub v 1 32
ret false
end
e = cm_eol v
if ge e n
ret false
end
put cmfo i v
put cmfn i sub e v
if eq i cmfsig
put cmgv cmsigo c
end
put cmgv cmcur add e 1
ret cm_vok i ty ln
end

fn cm_eol v ulong to ulong
e = v
while lt e get fbodyl 0 bound 4096
if eq get fbody e 10
ret e
end
e = add e 1
end
ret e
end

fn cm_vok i ulong ty ulong ln ulong to bool
v = new uchar 256 0
n = get cmfn i
if or eq n 0 gt n 200
ret false
end
o = get cmfo i
for j ulong n bound 256
put v j get fbody add o j
end
if eq ty 1
if ne n ln
ret false
end
ret cm_ishex part v 0 n
end
if eq ty 2
ret ne cm_dec part v 0 n 18446744073709551615
end
ret cm_outok part v 0 n
end

note cm_prenum: s is pre followed by a decimal 1..mx
fn cm_prenum s view uchar * pre view uchar * mx ulong to bool
if le len s len pre
ret false
end
if not cm_eq part s 0 len pre pre
ret false
end
v = cm_dec part s len pre sub len s len pre
ret and ge v 1 le v mx
end

note cm_outok: an exit outcome: 0..255, signalN, timeout, omcK, omcsignalN, omctimeout, cellE
fn cm_outok s view uchar * to bool
if le cm_dec s 255
ret true
end
if or cm_eq s cmxtmo cm_eq s cmxomct
ret true
end
if or cm_prenum s cmxomcs 127 cm_prenum s cmxsig 127
ret true
end
ret or cm_prenum s cmxomc 255 cm_prenum s cmxcell 4095
end

fn cm_parse to ulong
n = get fbodyl 0
if gt n cmmaxb
ret cmesize
end
k = cm_kind
if eq k 0
ret cmemal
end
put cmgv cmkind k
ok = true
if eq k 1
ok = and cm_f cmfkey cmnpub 1 130 cm_f cmftime cmntime 2 0
ok = and ok cm_f cmfthird cmnrate 2 0
end
if eq k 2
ok = and cm_f cmfkey cmnkey 1 64 cm_f cmftime cmntime 2 0
ok = and ok cm_f cmfthird cmnnon 1 32
end
if eq k 3
ok = cm_parse3
end
if eq k 4
ok = and cm_f cmfkey cmnkey 1 64 cm_f cmftime cmntime 2 0
end
if not ok
ret cmemal
end
if not cm_f cmfsig cmnsig 1 128
ret cmemal
end
if ne get cmgv cmcur n
ret cmemal
end
ret 0
end

fn cm_parse3 to bool
ok = cm_f cmfkey cmnkey 1 64
ok = and ok cm_f cmfjob cmnjob 1 32
ok = and ok cm_f cmfpart cmnpart 1 64
ok = and ok cm_f cmfcomp cmncomp 1 64
ok = and ok cm_f cmfbin cmnbin 1 64
ok = and ok cm_f cmfout cmnout 1 64
ok = and ok cm_f cmfexit cmnexit 3 0
ret and ok cm_f cmftime cmntime 2 0
end

note cm_fget: field i into d (its length must be len d)
fn cm_fget i ulong d edit uchar * to bool
n = get cmfn i
if ne n len d
ret false
end
o = get cmfo i
for j ulong n bound 4096
put d j get fbody add o j
end
ret true
end

note cm_fnum: field i as a decimal
fn cm_fnum i ulong to ulong
v = new uchar 32 0
n = get cmfn i
if gt n 32
ret 18446744073709551615
end
o = get cmfo i
for j ulong n bound 32
put v j get fbody add o j
end
ret cm_dec part v 0 n
end

fn cm_sha m view uchar * h edit uchar * to void
c = new ulong 40 0
sha256_init c
sha256_update c m
sha256_final c h
end

note cm_msha: cmsha = hex SHA-256 of the whole body
fn cm_msha to void
m = new uchar 4096 0
h = new uchar 32 0
x = new uchar 64 0
n = get fbodyl 0
for i ulong n bound 4096
put m i get fbody i
end
cm_sha part m 0 n h
cm_tohex h x
for i ulong 64
put cmsha i get x i
end
put cmgv cmchub 1
end

note cm_verify: ECDSA P-256 / SHA-256 of every byte before the sig line, by cmpub
fn cm_verify to bool
m = new uchar 4096 0
h = new uchar 32 0
hs = new uchar 96 0
pub = new uchar 65 0
sg = new uchar 128 0
n = get cmgv cmsigo
for i ulong n bound 4096
put m i get fbody i
end
cm_sha part m 0 n h
for i ulong 32
put hs i get h i
end
if not cm_fget cmfsig sg
ret false
end
if not cm_unhex sg part hs 32 64
ret false
end
for i ulong 65
put pub i get cmpub i
end
ret eq ecdsa_verify_raw 256 pub hs 32 0
end

note ---- keys
note cm_regkey: register: the public key from the message; cmkid = hex SHA-256 of it
fn cm_regkey to ulong
p = new uchar 130 0
q = new uchar 65 0
h = new uchar 32 0
x = new uchar 64 0
if not cm_fget cmfkey p
ret cmemal
end
if not cm_unhex p q
ret cmemal
end
for i ulong 65
put cmpub i get q i
end
cm_sha q h
cm_tohex h x
for i ulong 64
put cmkid i get x i
end
put cmgv cmcsec 1
ret 0
end

note cm_kload: the key named by the message must be registered and not left. Key file:
note "<130 hex pub> <rate> <since> <j|l>\n"
fn cm_kload to ulong
k = new uchar 64 0
b = new uchar 512 0
q = new uchar 65 0
if not cm_fget cmfkey k
ret cmemal
end
for i ulong 64
put cmkid i get k i
end
put cmgv cmcsec 1
cm_p0
cm_pa cmtkeys
cm_pa k
r = cm_rd b
if lt r 133
ret cmeunr
end
n = ulong r
if or ne get b sub n 1 10 ne get b sub n 2 106
ret cmeunr
end
if not cm_unhex part b 0 130 q
ret cmeunr
end
for i ulong 65
put cmpub i get q i
end
ret 0
end

note cm_kwrite: write the key file with state st (rate from the message on register, else kept)
fn cm_kwrite st view uchar * rate ulong to bool
d = new uchar 256 0
k = cm_kdpub d
k = cm_cp d k cmsp
k = cm_decput d k rate
k = cm_cp d k cmsp
k = cm_decput d k cm_now
k = cm_cp d k cmsp
k = cm_cp d k st
k = cm_cp d k cmnl
cm_p0
cm_pa cmtkeys
cm_pkid
ret cm_repl part d 0 k
end

fn cm_kdpub d edit uchar * to ulong
q = new uchar 65 0
x = new uchar 130 0
for i ulong 65
put q i get cmpub i
end
cm_tohex q x
for i ulong 130
put d i get x i
end
ret 130
end

note cm_krate: the rate in the stored key file (0 when unreadable)
fn cm_krate to ulong
b = new uchar 512 0
cm_p0
cm_pa cmtkeys
cm_pkid
r = cm_rd b
if lt r 133
ret 0
end
e = ulong 131
while lt e ulong r bound 512
if eq get b e 32
break
end
e = add e 1
end
v = cm_dec part b 131 sub e 131
if gt v 3600
ret 0
end
ret v
end

note ---- deny list: <root>deny, lines "key <64 hex>" and "part <64 hex>", read as a stream
fn cm_denied pre view uchar * id view uchar * to bool
t = new uchar 80 0
tl = cm_cp t 0 pre
tl = cm_cp t tl id
ret cm_dfile part t 0 tl
end

note cm_dfile: the deny file holds a line equal to t
fn cm_dfile t view uchar * to bool
b = new uchar 65536 0
cm_p0
cm_pa cmtdeny
fd = fopen cmpth 0 get cmgv cmpl 557056 0
if lt fd 0
ret false
end
put cmgv cmdj 0
put cmgv cmdm 1
hit = false
while true bound 9223372036854775807
n = read int fd b 0 65536
if le n 0
break
end
if cm_dscan part b 0 ulong n t
hit = true
break
end
end
x = fclose int fd
if and eq get cmgv cmdm 1 eq get cmgv cmdj len t
hit = true
end
ret hit
end

note cm_dscan: feed bytes b to the line matcher for t; true at a whole line equal to t
fn cm_dscan b view uchar * t view uchar * to bool
j = get cmgv cmdj
m = eq get cmgv cmdm 1
for i ulong len b bound 65536
c = get b i
if eq c 10
if and m eq j len t
ret true
end
j = 0
m = true
else
if and m lt j len t
m = eq c get t j
j = add j 1
else
m = false
end
end
end
put cmgv cmdj j
put cmgv cmdm 0
if m
put cmgv cmdm 1
end
ret false
end

note ---- rate: <root>rate/<name> holds "<window start> <count>\n", one window per hour
fn cm_rate nm view uchar * lim ulong to bool
b = new uchar 64 0
d = new uchar 64 0
cm_p0
cm_pa cmtrate
cm_pa nm
now = cm_now
put cmgv cmrw now
put cmgv cmrc 0
r = cm_rd b
if gt r 2
cm_rparse part b 0 ulong r now
end
cnt = get cmgv cmrc
if ge cnt lim
ret false
end
k = cm_decput d 0 get cmgv cmrw
k = cm_cp d k cmsp
k = cm_decput d k add cnt 1
k = cm_cp d k cmnl
ret cm_repl part d 0 k
end

note cm_rparse: "<window> <count>\n" still inside its hour: keep both (else a new window)
fn cm_rparse b view uchar * now ulong to void
s = cm_sp b
if ge add s 2 len b
ret
end
w = cm_dec part b 0 s
c = cm_dec part b add s 1 sub sub len b s 2
if or gt w now eq c 18446744073709551615
ret
end
if lt sub now w 3600
put cmgv cmrw w
put cmgv cmrc c
end
end

fn cm_sp b view uchar * to ulong
for i ulong len b bound 64
if eq get b i 32
ret i
end
end
ret len b
end

note ---- store
note cm_msgp: cmpth = <root>msgs/<message sha>
fn cm_msgp to void
s = new uchar 64 0
for i ulong 64
put s i get cmsha i
end
cm_p0
cm_pa cmtmsgs
cm_pa s
end

fn cm_store to bool
m = new uchar 4096 0
n = get fbodyl 0
for i ulong n bound 4096
put m i get fbody i
end
cm_msgp
ret cm_wnew part m 0 n
end

note cm_ledger: "<t> <kind> <key> <message sha> <part|-> <word>\n"
fn cm_ledger kw view uchar * pt bool w view uchar * to bool
d = new uchar 512 0
p = new uchar 64 0
k = cm_decput d 0 cm_now
k = cm_cp d k cmsp
k = cm_cp d k kw
k = cm_cp d k cmsp
k = cm_khex d k
k = cm_cp d k cmsp
k = cm_shex d k
k = cm_cp d k cmsp
if and pt cm_fget cmfpart p
k = cm_cp d k p
else
k = cm_cp d k cmdash
end
k = cm_cp d k cmsp
k = cm_cp d k w
k = cm_cp d k cmnl
cm_p0
cm_pa cmtled
ret cm_app part d 0 k
end

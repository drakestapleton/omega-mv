note community/40route.om -- /community/... routes. Pages and raw records are GET (and HEAD); only
note /community/api takes a POST. A path that is not one of these is 404.

text cmrt "/community"
text cmrts "/community/"
text cmrapi "/community/api"
text cmrjoin "/community/join"
text cmrled "/community/ledger"
text cmrrfu "/community/refused"
text cmrdl "/community/dl/"
text cmrpart "/community/part/"
text cmrmsg "/community/msg/"
text cmrkyp "/community/key/"
text cmfjoin "dist/join.sh"
text cmshct "text/x-shellscript; charset=utf-8"
text cmoct "application/octet-stream"
text cmatt "attachment"
text cmcc5 "public, max-age=60"

fn cm_prefix to bool
if lt get fpathl 0 len cmrt
ret false
end
for i ulong len cmrt
if ne get fpath i get cmrt i
ret false
end
end
if eq get fpathl 0 len cmrt
ret true
end
ret eq get fpath len cmrt 47
end

note cm_file: stream <root>rel (kind 3) with content type ct; 404 when it is absent
fn cm_file rel view uchar * ct view uchar * to long
put ffilel 0 0
n = get cmgv cmrl
for i ulong n bound 1024
ffilc get cmroot i
end
for i ulong len rel bound 4096
ffilc get rel i
end
put fobl 0 0
put fkind 0 3
fsetct ct
ret 200
end

note cm_hexarg: the 64 hex characters after prefix t (the whole rest of the path) into id
fn cm_hexarg t view uchar * id edit uchar * to bool
if ne get fpathl 0 add len t 64
ret false
end
for i ulong 64
put id i get fpath add len t i
end
ret cm_ishex id
end

note cm_dlname: a file name of 1..100 bytes from A-Z a-z 0-9 . _ -, not starting with a dot
fn cm_dlname s view uchar * to bool
if or eq len s 0 gt len s 100
ret false
end
if eq get s 0 46
ret false
end
for i ulong len s bound 128
c = get s i
ok = or or and ge c 97 le c 122 and ge c 65 le c 90 and ge c 48 le c 57
if not or or ok eq c 46 or eq c 95 eq c 45
ret false
end
end
ret true
end

fn cm_route to long
id = new uchar 64 0
if not cm_prefix
ret 0
end
fsetcc cmnost
if fpeq cmrapi
ret cm_api
end
if not fget
ret 405
end
if not cm_on
ret 404
end
if or fpeq cmrt fpeq cmrts
ret cm_index
end
if fpeq cmrjoin
fsetcc cmcc5
ret cm_file cmfjoin cmshct
end
if fpeq cmrled
ret cm_file cmtled cmct
end
if fpeq cmrrfu
ret cm_file cmtref cmct
end
if fpre cmrdl
ret cm_dl
end
if cm_hexarg cmrpart id
ret cm_partpage id
end
if cm_hexarg cmrmsg id
ret cm_raw cmtmsgs id
end
if cm_hexarg cmrkyp id
ret cm_raw cmtkeys id
end
ret 404
end

fn cm_raw dir view uchar * id view uchar * to long
p = new uchar 128 0
k = cm_cp p 0 dir
k = cm_cp p k id
ret cm_file part p 0 k cmct
end

fn cm_dl to long
nm = new uchar 128 0
p = new uchar 160 0
o = len cmrdl
n = sub get fpathl 0 o
if or eq n 0 gt n 100
ret 404
end
for i ulong n bound 128
put nm i get fpath add o i
end
if not cm_dlname part nm 0 n
ret 404
end
k = cm_cp p 0 cmtdist
k = cm_cp p k part nm 0 n
fsetcd cmatt
ret cm_file part p 0 k cmoct
end

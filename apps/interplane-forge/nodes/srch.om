note nodes/srch.om: global code search stops each git grep as soon as the page has the lines it can
note still show. The page shows at most 100 hits in allow-list order, and git grep prints its hits in
note path order, so once the output of the current repository holds 100 - (hits so far) complete
note lines, the rest of that grep can never reach the page: the child is killed and its tree scan
note ends there. The rendered bytes are those of reading the whole output (fexec), with one
note difference: a git that would fail after printing those lines is shown, where fexec's status rule
note would have dropped the repository. Each complete line of `git grep ... refs/heads/<b>` output is
note "<ref>:<path>:<n>:<text>", which fcshit always counts as one hit.
note git stays the search oracle: the argv is fgreparg's, exec'd by fchild (no shell, empty env).
note Measured against the one-after-another search in docs/PERF.md; a first version that ran six greps
note at once was slower on the two production cores and was dropped.
global nsfull ulong 1
note nsnl: newlines in fxo[a, b)
fn nsnl a ulong b ulong to ulong
c = ulong 0
for k ulong sub b a bound 524288
if eq get fxo add a k 10
c = add c 1
end
end
ret c
end
note nsdrain: fdrain, and also done (nsfull = 1) once fxo holds `need` complete lines
fn nsdrain fd int dl long need ulong to bool
put nsfull 0 0
nl = ulong 0
for it ulong 10000000
left = sub dl long monons
if le left 0
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret false
end
continue
end
if eq w 0
continue
end
n = get fxol 0
if ge n len fxo
put fxotr 0 1
r = read fd fjunk 0 4096
if eq r 0
ret true
end
if and lt r 0 and ne r -4 ne r -11
ret false
end
continue
end
r = read fd fxo n sub len fxo n
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
continue
end
put fxol 0 add n ulong r
nl = add nl nsnl n add n ulong r
if ge nl need
put nsfull 0 1
ret true
end
end
ret false
end
note nsrun: git grep for repository j into fxo, stopped after `need` lines; fexec's status rule,
note except that a child stopped for having enough lines counts as success (0)
fn nsrun j ulong need ulong to long
put fxol 0 0
put fxotr 0 0
fgreparg j
r = pipefds fpfd 0 8 524288
if lt r 0
ret -2
end
rfd = fpfdv 0
wfd = fpfdv 1
dl = add long monons 10000000000
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
fchild wfd
exit 127
end
x = fclose wfd
ok = nsdrain rfd dl need
x = fclose rfd
full = eq get nsfull 0 1
if or not ok full
x = killpid int pid 9
end
st = freap int pid dl
if not ok
ret -1
end
if full
ret 0
end
ret st
end
fn nscodesr to void
for i ulong get fan 0 bound 64
h = get fhits 0
if ge h 100
break
end
st = nsrun i sub 100 h
if eq st 0
fcsrepo i
end
end
end

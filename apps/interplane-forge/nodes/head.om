note nodes/head.om: the default branch of the current repository (frid), read straight from the HEAD
note file of its Radicle storage instead of starting `git symbolic-ref` (README host dependency 1,
note git: this is the first git call moved into Omega; browse brdefref and dl dldefbr use it).
note "ref: refs/heads/<name>" plus a newline gives <name>. Anything else gives no name and the callers
note fall back to "main", as they did when git failed: a detached HEAD (a bare commit id), a ref
note outside refs/heads/, an unreadable or oversized file, or a name git would refuse (a byte outside
note A-Z a-z 0-9 . _ - / +, a leading - / ., a trailing / ., "..", "//" or "/."). Parity with git
note across every public repository and the fixtures: nodes/tests/ab.sh check.
text tnshead "/HEAD"
text tnsrefh "ref: refs/heads/"
global nshb uchar 256
global nshbl ulong 1
fn nshok c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
if or eq c 46 eq c 95
ret true
end
if or eq c 45 eq c 47
ret true
end
ret eq c 43
end
note nshead: true with the branch name in nshb[0, nshbl) when HEAD names a branch (clobbers fxo)
fn nshead to bool
put nshbl 0 0
fpb
fpt tfstore
for i ulong get fridl 0 bound 64
fpc get frid i
end
fpt tnshead
n = frdall
if le n 0
ret false
end
ln = get fxol 0
a = len tnsrefh
if or lt ln add a 2 gt ln add a 201
ret false
end
for i ulong a
if ne get fxo i get tnsrefh i
ret false
end
end
if ne get fxo sub ln 1 10
ret false
end
k = sub sub ln 1 a
p = uchar 47
for i ulong k bound 200
c = get fxo add a i
if not nshok c
ret false
end
if and eq c 46 or eq p 46 eq p 47
ret false
end
if and eq c 47 eq p 47
ret false
end
if and eq i 0 eq c 45
ret false
end
put nshb i c
p = c
end
if or eq p 47 eq p 46
ret false
end
put nshbl 0 k
ret true
end

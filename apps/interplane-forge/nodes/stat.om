note nodes/stat.om: /status and /status.json, this Radicle node's health, from one snapshot file.
note The writer (nodes/snap.om, run by aien-nodes.service when the node database changes) owns the
note file; this page only reads it and never runs a program. Format, one item per line:
note   2 / unix time written / our node id / connected peers / then "RID scope copies behind reach wait"
note A data line is shown only when its RID is on the allow-list and every byte is a digit, a
note letter or a space, so a withdrawn RID or a poisoned line (markup, quotes) is never shown.
text nssnap "/home/drakestapleton/.local/state/aien-factory/nodes.txt"
text tfst "/status"
text tfstj "/status.json"
text nstit "Node health"
text nsh1 "<h1>Node health</h1>\n<p class=\"muted\">This forge's own Radicle node. Source: the node's sync records (which other nodes hold our signed copy of each repository, and when they took it) and its live peer list, written by the node writer each time the node database changes.</p>\n<p>Checked "
text nsh2 " UTC, "
text nsh3 " seconds before this page. Connected peers: <b>"
text nsh4 "</b>.</p>\n<p class=\"muted\">Copies: other nodes holding our signed copy of the repository. Behind: how many of those do not have our latest version yet. Reach: seconds our latest version took to arrive at the slowest node that has it. Waiting: seconds our latest version has been out while some copy still lacks it; 0 when none is behind.</p>\n"
text nsold "<p class=\"bad\">This check is more than a day old; the node writer may be stopped.</p>\n"
text nsnone "<h1>Node health</h1>\n<p class=\"bad\">Node health is not measured: the node writer's snapshot is missing or unreadable.</p>\n"
text nsth "<table class=\"stat\"><tr><th>Repository</th><th>We seed</th><th>Copies</th><th>Behind</th><th>Reach seconds</th><th>Waiting seconds</th></tr>\n"
text nstd1 "<tr><td><a href=\""
text nstd1b "\">"
text nstd1c "</a></td><td>"
text nstd2 "</td><td>"
text nstd3 "</td></tr>\n"
text nstend "</table>\n"
text nssall "all"
text nssfol "followed"
text nssno "no"
text nsjs1 "{\"source\":\"radicle-node sync records and peer list\",\"measured\":"
text nsjs1b ",\"checked\":"
text nsjs1c ",\"age_s\":"
text nsjs2 ",\"peers\":"
text nsjs3 ",\"node\":\"did:key:"
text nsjs4 "\",\"repos\":["
text nsjsn "{\"name\":\""
text nsjsr "\",\"rid\":\"rad:"
text nsjss "\",\"seeding\":\""
text nsjsd "\",\"copies\":"
text nsjsb ",\"behind\":"
text nsjsl ",\"reach_s\":"
text nsjsw ",\"wait_s\":"
text nsjse "]}"
text nsjtrue "true"
text nsjfals "false"
text nsctj "application/json"
global nsat ulong 1
global nspr ulong 1
global nscomma ulong 1
global nsf ulong 8
global nse ulong 1
fn nsdig c uchar to bool
if and ge c 48 le c 57
ret true
end
ret false
end
fn nssafe c uchar to bool
if nsdig c
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
if eq c 32
ret true
end
ret false
end
fn nseol p ulong n ulong to ulong
j = p
while lt j n bound 16777216
if eq get fxo j 10
ret j
end
j = add j 1
end
ret n
end
fn nsnum p ulong e ulong to ulong
v = ulong 0
if ge p e
ret 0
end
for i ulong sub e p bound 20
c = get fxo add p i
if not nsdig c
ret v
end
v = add mul v 10 sub ulong c 48
end
ret v
end
fn nsskip p ulong e ulong to ulong
j = p
while lt j e bound 80
if eq get fxo j 32
ret add j 1
end
j = add j 1
end
ret e
end
note nsrid: the RID at fxo[a, a+n) is allow-list row fridx (false when it is not listed)
fn nsrid a ulong n ulong to bool
for i ulong get fan 0 bound 64
if eq n get fail i
same = true
for k ulong n bound 64
if ne get fxo add a k fridbyte i k
same = false
end
end
if same
put fridx 0 i
ret true
end
end
end
ret false
end
note nsload: read the snapshot into fxo; header lines checked (format 1, our node id)
fn nsload to bool
fpb
fpt nssnap
n = frdall
if le n 0
ret false
end
ln = get fxol 0
p = ulong 0
e = nseol p ln
if ne sub e p 1
ret false
end
if ne get fxo p 50
ret false
end
p = add e 1
e = nseol p ln
put nsat 0 nsnum p e
p = add e 1
e = nseol p ln
if ne sub e p len tfnid
ret false
end
for k ulong len tfnid bound 64
if ne get fxo add p k get tfnid k
ret false
end
end
p = add e 1
e = nseol p ln
put nspr 0 nsnum p e
ret true
end
fn nsd2 v ulong to void
fputc uchar add div v 10 48
fputc uchar add rem v 10 48
end
note nsdate: unix seconds as YYYY-MM-DD HH:MM (UTC, proleptic Gregorian; as browse brdate)
fn nsdate t ulong to void
z = add div t 86400 719468
era = div z 146097
doe = sub z mul era 146097
yoe = div sub add sub doe div doe 1460 div doe 36524 div doe 146096 365
y = add yoe mul era 400
doy = sub doe sub add mul 365 yoe div yoe 4 div yoe 100
mp = div add mul 5 doy 2 153
d = add sub doy div add mul 153 mp 2 5 1
m = add mp 3
if ge mp 10
m = sub mp 9
end
if le m 2
y = add y 1
end
fnum y
fputc 45
nsd2 m
fputc 45
nsd2 d
fputc 32
s = rem t 86400
nsd2 div s 3600
fputc 58
nsd2 div rem s 3600 60
end
fn nsage to ulong
now = ulong div realns 1000000000
t0 = get nsat 0
if le now t0
ret 0
end
ret sub now t0
end
fn nsscope v ulong to void
if eq v 2
fput nssall
ret
end
if eq v 1
fput nssfol
ret
end
fput nssno
end
note nsone: one allow-listed data line at fxo[p, e): field starts into nsf (0 RID start, 1 RID length,
note 2 scope, 3 copies, 4 behind, 5 reach, 6 wait), then the HTML or JSON row
fn nsfld j ulong to ulong
ret nsnum get nsf j get nse 0
end
fn nshrow to void
i = get fridx 0
fput nstd1
fputb
fput tfowner
fputc 47
fputrn i
fput nstd1b
fputrn i
fput nstd1c
nsscope nsfld 2
for j ulong 4
fput nstd2
fnum nsfld add j 3
end
fput nstd3
end
fn nsjrow to void
i = get fridx 0
if eq get nscomma 0 1
fputc 44
end
put nscomma 0 1
fput nsjsn
fputrn i
fput nsjsr
p = get nsf 0
for k ulong get nsf 1 bound 64
fputc get fxo add p k
end
fput nsjss
nsscope nsfld 2
fput nsjsd
fnum nsfld 3
fput nsjsb
fnum nsfld 4
fput nsjsl
fnum nsfld 5
fput nsjsw
fnum nsfld 6
fputc 125
end
fn nsone p ulong e ulong html bool to void
sp = p
for k ulong sub e p bound 80
if eq get fxo add p k 32
sp = add p k
break
end
end
if eq sp p
ret
end
if not nsrid p sub sp p
ret
end
put nse 0 e
put nsf 0 p
put nsf 1 sub sp p
q = add sp 1
put nsf 2 q
for j ulong 4
q = nsskip q e
put nsf add j 3 q
end
if html
nshrow
ret
end
nsjrow
end
fn nsrows html bool to void
ln = get fxol 0
p = ulong 0
for skip ulong 4
if ge p ln
ret
end
p = add nseol p ln 1
end
put nscomma 0 0
for it ulong 4096
if ge p ln
ret
end
e = nseol p ln
bad = false
for k ulong sub e p bound 200
if not nssafe get fxo add p k
bad = true
end
end
if not bad
nsone p e html
end
p = add e 1
end
end
fn nsjson ok bool to long
put fkind 0 1
fsetct nsctj
fput nsjs1
if ok
fput nsjtrue
fput nsjs1b
fnum get nsat 0
fput nsjs1c
fnum nsage
fput nsjs2
fnum get nspr 0
else
fput nsjfals
end
fput nsjs3
fput tfnid
fput nsjs4
if ok
nsrows false
end
fput nsjse
ret 200
end
fn nsstat to long
ok = nsload
if fpeq tfstj
ret nsjson ok
end
fsetti nstit
if not ok
fput nsnone
ret 200
end
fput nsh1
nsdate get nsat 0
fput nsh2
age = nsage
fnum age
fput nsh3
fnum get nspr 0
fput nsh4
if gt age 86400
fput nsold
end
fput nsth
nsrows true
fput nstend
ret 200
end

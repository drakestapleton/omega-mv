om2
note nodes/snap.om: the Radicle node snapshot writer behind the forge /status page and the factory floor.
note   nodes-snap          write the snapshot once (tests, by hand)
note   nodes-snap follow   aien-nodes.service: write once, then follow `rad node events` (the node's own
note                       change stream) and write again after events, at most once per 30 s; no
note                       clock: with no event nothing runs. Exits 6 when the stream ends (node
note                       restarted); the service restarts it.
note It reads the node and never writes to it:
note   sqlite3 -readonly node.db      repo-sync-status: which head of OUR sigrefs each node has synced
note   sqlite3 -readonly policies.db  seeding scope
note   rad node status                connected peers
note sqlite3, env and rad stay host programs (argv exec, no shell, empty environment; rad gets HOME
note only); reading their output, the checks and the counting are here. Output, written to a temp file
note and renamed over the old one, one item per line:
note   2 / unix seconds / our node id / connected peers / then per repository "RID scope copies behind reach wait"
note   scope   2 all, 1 followed, 0 not seeded here
note   copies  other nodes that have a record of our signed refs for that repository
note   behind  of those, how many are not at our current head
note   reach   seconds our current head took to reach the slowest copy that has it
note   wait    seconds our current head has been out while some copy still lacks it (0 when none behind)
note A repository with no record of our own head counts copies only (behind, reach and wait 0).
note An input line that is not "letters/digits RID|0-1|0-1|digits|digits" is skipped. Every repository
note the node knows is listed; readers show only their own public allow-list. The file is mode 0600.
note Exit (once): 0 written; 2 an argument other than "follow"; 3 policies query failed; 4 sync query
note failed; 5 write failed.
text sqlb "/usr/bin/sqlite3"
text sqlro "-readonly"
text ndb "/home/drakestapleton/.radicle/node/node.db"
text pdb "/home/drakestapleton/.radicle/node/policies.db"
text q1 "SELECT substr(o.repo,5), o.node = 'z6MkfZDue1TbaNFi3ZzcD9uiTeduPLC52ucdFVuLKZwexxhK', o.head = coalesce(m.head,''), o.timestamp, coalesce(m.timestamp,0) FROM \"repo-sync-status\" o LEFT JOIN \"repo-sync-status\" m ON m.repo = o.repo AND m.node = 'z6MkfZDue1TbaNFi3ZzcD9uiTeduPLC52ucdFVuLKZwexxhK' WHERE o.repo LIKE 'rad:%' ORDER BY o.repo"
text q2 "SELECT substr(id,5), scope FROM seeding WHERE id LIKE 'rad:%' AND policy = 'allow' ORDER BY id"
text envb "/usr/bin/env"
text envh "HOME=/home/drakestapleton"
text radb "/home/drakestapleton/.local/bin/rad"
text rnode "node"
text rstat "status"
text revts "events"
text devnul "/dev/null"
text nid "z6MkfZDue1TbaNFi3ZzcD9uiTeduPLC52ucdFVuLKZwexxhK"
text outp "/home/drakestapleton/.local/state/aien-factory/nodes.txt"
text tmpp "/home/drakestapleton/.local/state/aien-factory/.nodes.txt.new"
global pk uchar 4096
global pkl ulong 1
global pkr ulong 1
global cap uchar 1048576
global capl ulong 1
global pol uchar 65536
global poln ulong 1
global ob uchar 131072
global obl ulong 1
global pfd uchar 8
global wst uchar 4
global erfd long 1
global junk uchar 65536
global nowms ulong 1
global l ulong 8
global g ulong 8
note ---- packed argument list pk (u16 count, then u16 length + bytes per record), as server/util.om fpk
fn kb to void
put pk 0 0
put pk 1 0
put pkl 0 2
end
fn kc c uchar to void
n = get pkl 0
if lt n 4095
put pk n c
put pkl 0 add n 1
r = get pkr 0
k = add or ulong get pk r shl ulong get pk add r 1 8 1
put pk r uchar and k 255
put pk add r 1 uchar shr k 8
end
end
fn ka t view uchar * to void
n = get pkl 0
if ge n 4094
ret
end
put pkr 0 n
put pk n 0
put pk add n 1 0
put pkl 0 add n 2
c = add or ulong get pk 0 shl ulong get pk 1 8 1
put pk 0 uchar and c 255
put pk 1 uchar shr c 8
for i ulong len t bound 4096
kc get t i
end
end
note ---- run pk: stdout into cap (at most 1 MiB, 20 s), stdin and stderr /dev/null; exit status or < 0
fn pfdv i ulong to int
b = mul i 4
v = or ulong get pfd b shl ulong get pfd add b 1 8
v = or v shl ulong get pfd add b 2 16
v = or v shl ulong get pfd add b 3 24
ret int v
end
fn child wfd int to void
nul = fopen devnul 0 len devnul 2 0
if lt nul 0
exit 126
end
x = dupfd int nul 0 0
x = dupfd wfd 1 0
x = dupfd int nul 2 0
x = execprog pk 0 get pkl 0
exit 127
end
fn drain fd int dl long to bool
for it ulong 100000000
left = sub dl long monons
if le left 0
ret false
end
w = waitio fd 1 left
if lt w 0
if ne w -4
ret false
end
continue
end
if eq w 0
continue
end
n = get capl 0
if ge n len cap
ret false
end
r = read fd cap n sub len cap n
if eq r 0
ret true
end
if lt r 0
if and ne r -4 ne r -11
ret false
end
continue
end
put capl 0 add n ulong r
end
ret false
end
note spawn: start pk with its stdout on a new pipe; the read end goes to erfd; the pid or < 0
fn spawn to long
r = pipefds pfd 0 8 524288
if lt r 0
ret -2
end
rfd = pfdv 0
wfd = pfdv 1
pid = fork
if lt pid 0
x = fclose rfd
x = fclose wfd
ret -2
end
if eq pid 0
child wfd
exit 127
end
x = fclose wfd
put erfd 0 long rfd
ret pid
end
fn run to long
put capl 0 0
pid = spawn
if lt pid 0
ret -2
end
rfd = int get erfd 0
ok = drain rfd add long monons 20000000000
x = fclose rfd
if not ok
x = killpid int pid 9
end
w = waitpid int pid wst 0 4 0
if or not ok ne w pid
ret -1
end
s = or ulong get wst 0 shl ulong get wst 1 8
if ne and s 127 0
ret -3
end
ret long and shr s 8 255
end
note ---- output buffer ob
fn oc c uchar to void
n = get obl 0
if lt n len ob
put ob n c
put obl 0 add n 1
end
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc get t i
end
end
fn onum v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
for k ulong 20
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
for k ulong n bound 20
oc get d sub sub n k 1
end
end
fn alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 97 le c 122
ret true
end
if and ge c 65 le c 90
ret true
end
ret false
end
note ---- peers: rows of the rad node status table that start "│ z" and carry the connected mark ✓
fn by3 p ulong a uchar b uchar c uchar to bool
if ne get cap p a
ret false
end
if ne get cap add p 1 b
ret false
end
ret eq get cap add p 2 c
end
fn peerln p ulong e ulong to bool
if lt sub e p 6
ret false
end
if not by3 p 226 148 130
ret false
end
if not by3 add p 2 130 32 122
ret false
end
q = add p 5
while lt add q 2 e bound 4096
if by3 q 226 156 147
ret true
end
q = add q 1
end
ret false
end
fn lnend p ulong n ulong to ulong
e = p
while lt e n bound 1048576
if eq get cap e 10
ret e
end
e = add e 1
end
ret n
end
fn peers to ulong
c = ulong 0
p = ulong 0
n = get capl 0
while lt p n bound 1048576
e = lnend p n
if peerln p e
c = add c 1
end
p = add e 1
end
ret c
end
note ---- one sync line at cap[p, e) into l: 0 RID start, 1 RID length, 2 is-us, 3 at-our-head,
note 4 its time (ms), 5 our time (ms); false when the line is not exactly that form
fn pnum p ulong e ulong k ulong to ulong
v = ulong 0
q = p
while lt q e bound 21
c = get cap q
if eq c 124
break
end
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub ulong c 48
q = add q 1
end
if or eq q p gt sub q p 19
ret 0
end
put l k v
ret q
end
fn pline p ulong e ulong to bool
q = p
while lt q e bound 70
c = get cap q
if eq c 124
break
end
if not alnum c
ret false
end
q = add q 1
end
n = sub q p
if or eq n 0 or gt n 64 ge q e
ret false
end
put l 0 p
put l 1 n
for f ulong 4
r = pnum add q 1 e add f 2
if eq r 0
ret false
end
if and lt f 3 ge r e
ret false
end
if and eq f 3 ne r e
ret false
end
q = r
end
if or gt get l 2 1 gt get l 3 1
ret false
end
ret true
end
note ---- the repository being counted, in g: 0 RID start, 1 RID length (0 = none yet), 2 copies,
note 3 behind, 4 reach (s), 5 our time (ms, 0 = no record of our head)
fn samerid to bool
if ne get g 1 get l 1
ret false
end
a = get g 0
b = get l 0
for i ulong get g 1 bound 64
if ne get cap add a i get cap add b i
ret false
end
end
ret true
end
note scope: the seeding line "RID|all" or "RID|followed" for the repository in g, from pol
fn scope to ulong
a = get g 0
n = get g 1
p = ulong 0
m = get poln 0
while lt p m bound 65536
if le add add p n 1 m
same = true
for i ulong n bound 64
if ne get pol add p i get cap add a i
same = false
end
end
if and same eq get pol add p n 124
c = get pol add add p n 1
if eq c 97
ret 2
end
if eq c 102
ret 1
end
ret 0
end
end
while lt p m bound 65536
if eq get pol p 10
break
end
p = add p 1
end
p = add p 1
end
ret 0
end
fn emit to void
n = get g 1
if eq n 0
ret
end
a = get g 0
for i ulong n bound 64
oc get cap add a i
end
oc 32
onum scope
oc 32
onum get g 2
oc 32
onum get g 3
oc 32
onum get g 4
oc 32
w = ulong 0
o = get g 5
nw = get nowms 0
if gt get g 3 0
if and gt o 0 gt nw o
w = div sub nw o 1000
end
end
onum w
oc 10
end
fn gnew to void
put g 0 get l 0
put g 1 get l 1
put g 2 0
put g 3 0
put g 4 0
put g 5 get l 5
end
fn acc to void
if eq get l 2 1
ret
end
put g 2 add get g 2 1
o = get g 5
if eq o 0
ret
end
if eq get l 3 0
put g 3 add get g 3 1
ret
end
ts = get l 4
if gt ts o
d = div sub ts o 1000
if gt d get g 4
put g 4 d
end
end
end
fn rows to void
put g 1 0
p = ulong 0
n = get capl 0
while lt p n bound 1048576
e = lnend p n
if pline p e
if not samerid
emit
gnew
end
acc
end
p = add e 1
end
emit
end
fn wout to bool
fd = fopen tmpp 0 len tmpp 524865 384
if lt fd 0
ret false
end
p = ulong 0
n = get obl 0
while lt p n bound 1000000
w = write int fd ob p sub n p
if le w 0
x = fclose int fd
ret false
end
p = add p ulong w
end
x = fdsync int fd
x = fclose int fd
kb
ka tmpp
ka outp
ret eq renames pk 0 get pkl 0 0 0
end
fn once to int
put nowms 0 ulong div realns 1000000
kb
ka sqlb
ka sqlro
ka pdb
ka q2
if ne run 0
ret 3
end
n = get capl 0
if gt n len pol
ret 3
end
for i ulong n bound 65536
put pol i get cap i
end
put poln 0 n
kb
ka envb
ka envh
ka radb
ka rnode
ka rstat
pr = ulong 0
if eq run 0
pr = peers
end
kb
ka sqlb
ka sqlro
ka ndb
ka q1
if ne run 0
ret 4
end
put obl 0 0
oc 50
oc 10
onum div get nowms 0 1000
oc 10
ot nid
oc 10
onum pr
oc 10
rows
if not wout
ret 5
end
ret 0
end
note follow: the node's event stream is the change signal. Any event marks the snapshot dirty; a
note dirty snapshot is written once 30 s have passed since the last write. Idle, it only waits.
fn follow to int
st = once
last = long monons
kb
ka envb
ka envh
ka radb
ka rnode
ka revts
pid = spawn
if lt pid 0
ret 6
end
rfd = int get erfd 0
dirty = false
for it ulong 4000000000
tmo = long 3600000000000
if dirty
tmo = sub add last 30000000000 long monons
if le tmo 0
st = once
last = long monons
dirty = false
continue
end
end
w = waitio rfd 1 tmo
if lt w 0
if ne w -4
break
end
continue
end
if gt w 0
r = read rfd junk 0 len junk
if eq r 0
break
end
if lt r 0
if and ne r -4 ne r -11
break
end
continue
end
dirty = true
end
end
x = fclose rfd
x = killpid int pid 9
w = waitpid int pid wst 0 4 0
ret 6
end
note main: no argument writes once; exactly "follow" follows; anything else is exit 2 with nothing written
text tfollow "follow"
global argb uchar 16
fn main to int
n = argcnt
if eq n 1
ret once
end
if ne n 2
ret 2
end
r = argread 1 argb 0 16
if ne r long len tfollow
ret 2
end
for i ulong len tfollow
if ne get argb i get tfollow i
ret 2
end
end
ret follow
end

note ---- response and header buffer helpers ----

fn r_reset to void
  put g_respl 0 0
end

fn r_byte c uchar to void
  n = get g_respl 0
  if lt n PG_MAX_RESP
    put g_resp n c
    put g_respl 0 add n 1
  end
end

fn r_txt t view uchar * to void
  for i ulong len t bound 4096
    r_byte get t i
  end
end

fn r_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    r_byte 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    r_byte get buf p
    p = add p 1
  end
end

fn r_esc_byte c uchar to void
  if eq c 38
    r_txt t_esc_amp
    ret
  end
  if eq c 60
    r_txt t_esc_lt
    ret
  end
  if eq c 62
    r_txt t_esc_gt
    ret
  end
  if eq c 34
    r_txt t_esc_quot
    ret
  end
  r_byte c
end

fn r_esc_code to void
  n = get g_codel 0
  for i ulong n bound 16384
    r_esc_byte get g_code i
  end
end

fn r_esc_cerr to void
  n = get g_cerrl 0
  for i ulong n bound 8192
    r_esc_byte get g_cerr i
  end
end

fn r_esc_rout to void
  n = get g_routl 0
  for i ulong n bound 16384
    r_esc_byte get g_rout i
  end
end

fn r_esc_rerr to void
  n = get g_rerrl 0
  for i ulong n bound 8192
    r_esc_byte get g_rerr i
  end
end

fn h_reset to void
  put g_hdrl 0 0
end

fn h_byte c uchar to void
  n = get g_hdrl 0
  if lt n 1024
    put g_hdr n c
    put g_hdrl 0 add n 1
  end
end

fn h_txt t view uchar * to void
  for i ulong len t bound 256
    h_byte get t i
  end
end

fn h_crlf to void
  h_byte 13
  h_byte 10
end

fn h_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    h_byte 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    h_byte get buf p
    p = add p 1
  end
end

note ---- packed argv helpers for execprog / execpure ----

fn pk_reset to void
  put g_pk 0 0
  put g_pk 1 0
  put g_pkl 0 2
end

fn pk_open to void
  n = get g_pkl 0
  if ge n 1020
    ret
  end
  put g_pkr 0 n
  put g_pk n 0
  put g_pk add n 1 0
  put g_pkl 0 add n 2
  c = add or ulong get g_pk 0 shl ulong get g_pk 1 8 1
  put g_pk 0 uchar and c 255
  put g_pk 1 uchar shr c 8
end

fn pk_byte c uchar to void
  n = get g_pkl 0
  if lt n 1022
    put g_pk n c
    put g_pkl 0 add n 1
    r = get g_pkr 0
    k = add or ulong get g_pk r shl ulong get g_pk add r 1 8 1
    put g_pk r uchar and k 255
    put g_pk add r 1 uchar shr k 8
  end
end

fn pk_omc to void
  pk_reset
  pk_open
  n = get g_omcl 0
  for i ulong n bound 512
    pk_byte get g_omc i
  end
end

fn pk_bin to void
  pk_reset
  pk_open
  n = get g_tmp_binl 0
  for i ulong n bound 128
    pk_byte get g_tmp_bin i
  end
end

note ---- temp path builder: /tmp/omplay-<pid>-<seq>.om / .bin ----

fn tmp_om_b c uchar to void
  n = get g_tmp_oml 0
  if lt n 126
    put g_tmp_om n c
    put g_tmp_oml 0 add n 1
  end
end

fn tmp_bin_b c uchar to void
  n = get g_tmp_binl 0
  if lt n 126
    put g_tmp_bin n c
    put g_tmp_binl 0 add n 1
  end
end

fn tmp_both_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    tmp_om_b 48
    tmp_bin_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    c = get buf p
    tmp_om_b c
    tmp_bin_b c
    p = add p 1
  end
end

fn make_tmp_paths to void
  put g_tmp_oml 0 0
  put g_tmp_binl 0 0
  for i ulong len t_tmp_pre bound 64
    c = get t_tmp_pre i
    tmp_om_b c
    tmp_bin_b c
  end
  pid = ulong getpid
  tmp_both_u64 pid
  tmp_om_b 45
  tmp_bin_b 45
  s = add get g_seq 0 1
  put g_seq 0 s
  tmp_both_u64 s
  for i ulong len t_ext_om bound 16
    tmp_om_b get t_ext_om i
  end
  for i ulong len t_ext_bin bound 16
    tmp_bin_b get t_ext_bin i
  end
end

note ---- pipe/prlimit/wait helpers ----

fn read_u32_le a view uchar * off ulong to int
  v = or ulong get a off shl ulong get a add off 1 8
  v = or v shl ulong get a add off 2 16
  v = or v shl ulong get a add off 3 24
  ret int v
end

fn set_rlim res int lim ulong to void
  b = new uchar 32 0
  for i ulong 8
    v = uchar and shr lim mul i 8 255
    put b i v
    put b add i 8 v
  end
  x = prlimit 0 res b 0 32
end

fn reap_child pid int dl long to ulong
  st = new uchar 4 0
  for it ulong 2000000 bound 2000000
    w = waitpid pid st 0 4 1
    if eq w long pid
      s = or ulong get st 0 shl ulong get st 1 8
      if eq and s 127 0
        ret and shr s 8 255
      end
      ret add 1000 and s 127
    end
    if lt w 0
      if ne w -4
        ret 998
      end
      continue
    end
    if gt long monons dl
      x = killpid pid 9
      w2 = waitpid pid st 0 4 0
      ret 999
    end
    x = sleepns 200000
  end
  x = killpid pid 9
  w3 = waitpid pid st 0 4 0
  ret 999
end

fn drain_cerr fd int dl long to bool
  put g_cerrl 0 0
  for it ulong 1000000 bound 1000000
    left = sub dl long monons
    if le left 0
      ret false
    end
    w = waitio fd 1 left
    if lt w 0
      if ne w -4
        ret false
      end
      continue
    end
    if eq w 0
      continue
    end
    n = get g_cerrl 0
    if ge n PG_MAX_CERR
      r = read fd g_junk 0 4096
      if eq r 0
        ret true
      end
      if lt r 0
        if and ne r -4 ne r -11
          ret false
        end
      end
      continue
    end
    r = read fd g_cerr n sub PG_MAX_CERR n
    if eq r 0
      ret true
    end
    if lt r 0
      if and ne r -4 ne r -11
        ret false
      end
      continue
    end
    put g_cerrl 0 add n ulong r
  end
  ret false
end

fn put_pfd p edit uchar * off ulong fd int to void
  u = ulong fd
  put p off uchar and u 255
  put p add off 1 uchar and shr u 8 255
  put p add off 2 uchar and shr u 16 255
  put p add off 3 uchar and shr u 24 255
  put p add off 4 1
  put p add off 5 0
  put p add off 6 0
  put p add off 7 0
end

fn drain_out_one fd int to bool
  n = get g_routl 0
  if ge n PG_MAX_ROUT
    put g_st ST_ROUT_TR 1
    r = read fd g_junk 0 4096
    if eq r 0
      ret false
    end
    if lt r 0
      if and ne r -4 ne r -11
        ret false
      end
    end
    ret true
  end
  r = read fd g_rout n sub PG_MAX_ROUT n
  if eq r 0
    ret false
  end
  if gt r 0
    put g_routl 0 add n ulong r
    ret true
  end
  if and ne r -4 ne r -11
    ret false
  end
  ret true
end

fn drain_err_one fd int to bool
  n = get g_rerrl 0
  if ge n PG_MAX_RERR
    put g_st ST_RERR_TR 1
    r = read fd g_junk 0 4096
    if eq r 0
      ret false
    end
    if lt r 0
      if and ne r -4 ne r -11
        ret false
      end
    end
    ret true
  end
  r = read fd g_rerr n sub PG_MAX_RERR n
  if eq r 0
    ret false
  end
  if gt r 0
    put g_rerrl 0 add n ulong r
    ret true
  end
  if and ne r -4 ne r -11
    ret false
  end
  ret true
end

fn drain_two outfd int errfd int dl long to bool
  put g_routl 0 0
  put g_rerrl 0 0
  put g_st ST_ROUT_TR 0
  put g_st ST_RERR_TR 0
  p = new uchar 16 0
  o_open = true
  e_open = true
  for it ulong 1000000 bound 1000000
    if and not o_open not e_open
      ret true
    end
    left = sub dl long monons
    if le left 0
      ret false
    end
    if o_open
      put_pfd p 0 outfd
    else
      put_pfd p 0 -1
    end
    if e_open
      put_pfd p 8 errfd
    else
      put_pfd p 8 -1
    end
    w = pollfds p 0 16 left
    if lt w 0
      if ne w -4
        ret false
      end
      continue
    end
    if eq w 0
      continue
    end
    ro = or ulong get p 6 shl ulong get p 7 8
    if and o_open ne ro 0
      o_open = drain_out_one outfd
    end
    re = or ulong get p 14 shl ulong get p 15 8
    if and e_open ne re 0
      e_open = drain_err_one errfd
    end
  end
  ret false
end

note ---- compile and run pipeline ----

fn write_source_file to bool
  fd = fopen g_tmp_om 0 get g_tmp_oml 0 577 384
  if lt fd 0
    ret false
  end
  n = get g_codel 0
  off = ulong 0
  while lt off n bound 16384
    w = write int fd g_code off sub n off
    if le w 0
      x = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  x = fclose int fd
  ret true
end

fn child_compile infd int outfd int ewfd int to void
  set_rlim 0 3
  set_rlim 1 4194304
  set_rlim 9 268435456
  x = dupfd infd 0 0
  x = dupfd outfd 1 0
  x = dupfd ewfd 2 0
  x = execprog g_pk 0 get g_pkl 0
  exit 127
end

fn finish_compile pid int erfd int t0 long to void
  dl = add t0 PG_COMPILE_TMO
  ok = drain_cerr erfd dl
  x = fclose erfd
  if not ok
    x = killpid pid 9
  end
  rc = reap_child pid dl
  dt = sub long monons t0
  if lt dt 0
    dt = 0
  end
  put g_st ST_COMP_MS div ulong dt 1000000
  if not ok
    put g_st ST_COMP_RC 999
    ret
  end
  put g_st ST_COMP_RC rc
  if eq rc 0
    bfd = fopen g_tmp_bin 0 get g_tmp_binl 0 0 0
    if ge bfd 0
      sz = fseek int bfd 0 2
      if gt sz 0
        put g_st ST_BIN_BYTES ulong sz
      end
      x = fclose int bfd
    end
  end
end

fn run_compile to void
  put g_st ST_COMP_RC 998
  put g_st ST_COMP_MS 0
  put g_st ST_BIN_BYTES 0
  put g_cerrl 0 0
  if not write_source_file
    ret
  end
  infd = fopen g_tmp_om 0 get g_tmp_oml 0 0 0
  if lt infd 0
    ret
  end
  outfd = fopen g_tmp_bin 0 get g_tmp_binl 0 577 448
  if lt outfd 0
    x = fclose int infd
    ret
  end
  ep = new uchar 8 0
  if lt pipefds ep 0 8 524288 0
    x = fclose int infd
    x = fclose int outfd
    ret
  end
  erfd = read_u32_le ep 0
  ewfd = read_u32_le ep 4
  pk_omc
  t0 = long monons
  pid = fork
  if lt pid 0
    x = fclose int infd
    x = fclose int outfd
    x = fclose erfd
    x = fclose ewfd
    ret
  end
  if eq pid 0
    child_compile int infd int outfd ewfd
  end
  x = fclose int infd
  x = fclose int outfd
  x = fclose ewfd
  finish_compile int pid erfd t0
end

fn child_binary owfd int ewfd int to void
  nul = fopen t_devnull 0 len t_devnull 0 0
  if lt nul 0
    exit 126
  end
  x = dupfd int nul 0 0
  x = dupfd owfd 1 0
  x = dupfd ewfd 2 0
  x = execpure g_pk 0 get g_pkl 0
  exit 127
end

fn finish_binary pid int orfd int erfd int t0 long to void
  dl = add t0 PG_RUN_TMO
  ok = drain_two orfd erfd dl
  x = fclose orfd
  x = fclose erfd
  if not ok
    x = killpid pid 9
  end
  rc = reap_child pid dl
  dt = sub long monons t0
  if lt dt 0
    dt = 0
  end
  put g_st ST_RUN_MS div ulong dt 1000000
  if not ok
    put g_st ST_RUN_RC 999
    ret
  end
  put g_st ST_RUN_RC rc
end

fn run_binary to void
  put g_st ST_DID_RUN 1
  put g_st ST_RUN_RC 998
  put g_st ST_RUN_MS 0
  put g_routl 0 0
  put g_rerrl 0 0
  op = new uchar 8 0
  ep = new uchar 8 0
  if lt pipefds op 0 8 524288 0
    ret
  end
  if lt pipefds ep 0 8 524288 0
    x = fclose read_u32_le op 0
    x = fclose read_u32_le op 4
    ret
  end
  orfd = read_u32_le op 0
  owfd = read_u32_le op 4
  erfd = read_u32_le ep 0
  ewfd = read_u32_le ep 4
  pk_bin
  t0 = long monons
  pid = fork
  if lt pid 0
    x = fclose orfd
    x = fclose owfd
    x = fclose erfd
    x = fclose ewfd
    ret
  end
  if eq pid 0
    child_binary owfd ewfd
  end
  x = fclose owfd
  x = fclose ewfd
  finish_binary int pid orfd erfd t0
end

fn cleanup_tmp to void
  x = unlink g_tmp_om 0 get g_tmp_oml 0
  x = unlink g_tmp_bin 0 get g_tmp_binl 0
end

note ---- string / HTTP parsing helpers ----

fn to_low c uchar to uchar
  if ge c 65
    if le c 90
      ret add c 32
    end
  end
  ret c
end

fn hex_val c uchar to int
  if ge c 48
    if le c 57
      ret int sub c 48
    end
  end
  if ge c 97
    if le c 102
      ret int add sub c 97 10
    end
  end
  if ge c 65
    if le c 70
      ret int add sub c 65 10
    end
  end
  ret -1
end

fn req_starts off ulong pat view uchar * to bool
  n = get g_reql 0
  if gt add off len pat n
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_req add off i get pat i
      ret false
    end
  end
  ret true
end

fn req_istarts off ulong pat view uchar * to bool
  n = get g_reql 0
  if gt add off len pat n
    ret false
  end
  for i ulong len pat bound 64
    if ne to_low get g_req add off i get pat i
      ret false
    end
  end
  ret true
end

fn req_contains lo ulong hi ulong pat view uchar * to bool
  pl = len pat
  if lt hi add lo pl
    ret false
  end
  lim = add sub hi pl 1
  for i ulong sub lim lo bound 4096
    if req_starts add lo i pat
      ret true
    end
  end
  ret false
end

fn find_hdr_end to ulong
  n = get g_reql 0
  if lt n 4
    ret 0
  end
  for i ulong sub n 3 bound 40960
    if eq get g_req i 13
      if eq get g_req add i 1 10
        if eq get g_req add i 2 13
          if eq get g_req add i 3 10
            ret add i 4
          end
        end
      end
    end
  end
  ret 0
end

fn parse_content_length hend ulong to ulong
  i = ulong 0
  while lt i hend bound 40960
    if req_istarts i t_cl_hdr
      j = add i len t_cl_hdr
      while lt j hend bound 64
        c = get g_req j
        if and ne c 32 ne c 9
          break
        end
        j = add j 1
      end
      val = ulong 0
      while lt j hend bound 32
        c = get g_req j
        if and ge c 48 le c 57
          if lt val 1000000
            val = add mul val 10 ulong sub c 48
          end
          j = add j 1
        else
          break
        end
      end
      ret val
    end
    while lt i hend bound 40960
      c = get g_req i
      i = add i 1
      if eq c 10
        break
      end
    end
  end
  ret 0
end

fn load_example t view uchar * to void
  put g_codel 0 0
  for i ulong len t bound 16384
    put g_code i get t i
  end
  put g_codel 0 len t
end

fn decode_code_field off ulong hi ulong to void
  put g_codel 0 0
  put g_st ST_TOO_BIG 0
  i = off
  while lt i hi bound 40960
    c = get g_req i
    if eq c 38
      break
    end
    b = c
    if eq c 43
      b = 32
      i = add i 1
    else
      if eq c 37
        if le add i 3 hi
          h1 = hex_val get g_req add i 1
          h2 = hex_val get g_req add i 2
          if and ge h1 0 ge h2 0
            b = uchar add mul h1 16 h2
            i = add i 3
          else
            i = add i 1
          end
        else
          i = add i 1
        end
      else
        i = add i 1
      end
    end
    if ne b 13
      cl = get g_codel 0
      if lt cl PG_MAX_CODE
        put g_code cl b
        put g_codel 0 add cl 1
      else
        put g_st ST_TOO_BIG 1
      end
    end
  end
end

fn parse_form_body boff ulong blen ulong to void
  put g_codel 0 0
  put g_st ST_MODE 0
  put g_st ST_TOO_BIG 0
  hi = add boff blen
  i = boff
  while lt i hi bound 40960
    if req_starts i t_k_code
      decode_code_field add i len t_k_code hi
    else
      if req_starts i t_k_mode
        if req_starts add i len t_k_mode t_v_compile
          put g_st ST_MODE 1
        end
      end
    end
    while lt i hi bound 40960
      c = get g_req i
      i = add i 1
      if eq c 38
        break
      end
    end
  end
end

note ---- HTML page renderer ----

fn render_results to void
  if eq get g_st ST_HAS_POST 0
    r_txt t_h_idle
    ret
  end
  if ne get g_st ST_TOO_BIG 0
    r_txt t_h_toobig
    ret
  end
  crc = get g_st ST_COMP_RC
  if eq crc 0
    r_txt t_h_cpass
  else
    if eq crc 999
      r_txt t_h_ctimeout
    else
      if eq crc 998
        r_txt t_h_cerr_sys
      else
        r_txt t_h_cfail
        r_u64 crc
        r_txt t_h_close_badge
      end
    end
  end
  r_txt t_h_meta_open
  r_txt t_h_comp_t
  r_u64 get g_st ST_COMP_MS
  r_txt t_h_ms
  if eq crc 0
    r_txt t_h_sep
    r_u64 get g_st ST_BIN_BYTES
    r_txt t_h_bytes
  end
  r_txt t_h_meta_close
  if gt get g_cerrl 0 0
    r_txt t_h_lbl_cerr
    r_esc_cerr
    r_txt t_h_pre_end
  end
  if ne get g_st ST_DID_RUN 0
    rrc = get g_st ST_RUN_RC
    if eq rrc 0
      r_txt t_h_rpass
    else
      if eq rrc 999
        r_txt t_h_rtime
      else
        if eq rrc 998
          r_txt t_h_rerr_sys
        else
          if ge rrc 1000
            r_txt t_h_rsig
            r_u64 sub rrc 1000
            r_txt t_h_close_badge
          else
            if and ge rrc 101 le rrc 114
              r_txt t_h_rtrap
              r_u64 sub rrc 100
              r_txt t_h_rtrap2
              r_u64 rrc
              r_txt t_h_close_badge
            else
              r_txt t_h_rexit
              r_u64 rrc
              r_txt t_h_close_badge
            end
          end
        end
      end
    end
    r_txt t_h_meta_open
    r_txt t_h_run_t
    r_u64 get g_st ST_RUN_MS
    r_txt t_h_ms
    r_txt t_h_meta_close
    r_txt t_h_lbl_out
    if eq get g_routl 0 0
      r_txt t_h_empty
    else
      r_esc_rout
      if ne get g_st ST_ROUT_TR 0
        r_txt t_h_trunc
      end
    end
    r_txt t_h_pre_end
    if gt get g_rerrl 0 0
      r_txt t_h_lbl_err
      r_esc_rerr
      if ne get g_st ST_RERR_TR 0
        r_txt t_h_trunc
      end
      r_txt t_h_pre_end
    end
  end
end

fn render_page to void
  r_reset
  r_txt t_h_top
  r_esc_code
  r_txt t_h_mid
  render_results
  r_txt t_h_bot
end

note ---- socket I/O ----

fn send_hdr fd int to void
  n = get g_hdrl 0
  off = ulong 0
  dl = add long monons PG_IO_TMO
  while lt off n bound 10000
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd g_hdr off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end

fn send_body fd int to void
  n = get g_respl 0
  off = ulong 0
  dl = add long monons PG_IO_TMO
  while lt off n bound 100000
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd g_resp off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end

fn send_resp fd int scode ulong ct_kind ulong head_only bool to void
  h_reset
  if eq scode 405
    h_txt t_http_405
  else
    h_txt t_http_200
  end
  h_crlf
  if eq ct_kind 1
    h_txt t_ct_css
    h_crlf
    h_txt t_cc_css
  else
    if eq ct_kind 2
      h_txt t_ct_txt
    else
      h_txt t_ct_html
    end
    h_crlf
    h_txt t_cc_no
  end
  h_crlf
  h_txt t_cl_pre
  h_u64 get g_respl 0
  h_crlf
  h_txt t_conn_close
  h_crlf
  h_crlf
  send_hdr fd
  if not head_only
    send_body fd
  end
end

fn read_http_req fd int to bool
  put g_reql 0 0
  dl = add long monons PG_IO_TMO
  hend = ulong 0
  need = ulong 0
  for it ulong 10000 bound 10000
    n = get g_reql 0
    if eq hend 0
      h = find_hdr_end
      if gt h 0
        hend = h
        cl = parse_content_length hend
        need = add hend cl
        if gt need PG_MAX_REQ
          need = PG_MAX_REQ
        end
        if ge n need
          ret true
        end
      end
    else
      if ge n need
        ret true
      end
    end
    if ge n PG_MAX_REQ
      ret gt hend 0
    end
    left = sub dl long monons
    if le left 0
      ret gt hend 0
    end
    w = waitio fd 1 left
    if le w 0
      if eq w -4
        continue
      end
      ret gt hend 0
    end
    r = recv fd g_req n sub PG_MAX_REQ n 0
    if lt r 0
      if or eq r -4 eq r -11
        continue
      end
      ret gt hend 0
    end
    if eq r 0
      ret gt hend 0
    end
    put g_reql 0 add n ulong r
  end
  ret gt hend 0
end

fn serve_conn fd int to void
  if not read_http_req fd
    ret
  end
  is_get = req_starts 0 t_m_get
  is_head = req_starts 0 t_m_head
  is_post = req_starts 0 t_m_post
  if and not is_get and not is_head not is_post
    r_reset
    r_txt t_405_body
    send_resp fd 405 2 false
    ret
  end
  p0 = ulong 4
  if is_head
    p0 = 5
  end
  if is_post
    p0 = 5
  end
  p1 = p0
  n = get g_reql 0
  while lt p1 n bound 4096
    c = get g_req p1
    if or eq c 32 or eq c 13 eq c 10
      break
    end
    p1 = add p1 1
  end
  if req_contains p0 p1 t_p_css
    r_reset
    r_txt t_css
    send_resp fd 200 1 is_head
    ret
  end
  if req_contains p0 p1 t_p_health
    r_reset
    r_txt t_ok_body
    send_resp fd 200 2 is_head
    ret
  end
  for i ulong 16
    put g_st i 0
  end
  if is_post
    put g_st ST_HAS_POST 1
    hend = find_hdr_end
    if and gt hend 0 lt hend n
      parse_form_body hend sub n hend
    end
    if eq get g_st ST_TOO_BIG 0
      make_tmp_paths
      run_compile
      if and eq get g_st ST_COMP_RC 0 eq get g_st ST_MODE 0
        run_binary
      end
      cleanup_tmp
    end
  else
    if req_contains p0 p1 t_q_sum
      load_example t_ex_sum
    else
      if req_contains p0 p1 t_q_fib
        load_example t_ex_fib
      else
        if req_contains p0 p1 t_q_trap
          load_example t_ex_trap
        else
          if req_contains p0 p1 t_q_typeerr
            load_example t_ex_typeerr
          else
            load_example t_ex_hello
          end
        end
      end
    end
  end
  render_page
  send_resp fd 200 0 is_head
end

note ---- listener setup and main loop ----

fn make_listener to long
  fd = socknew 2 526337 0
  if lt fd 0
    ret fd
  end
  one = new uchar 4 0
  put one 0 1
  r = sockopt int fd 1 2 one 0 4
  a = new uchar 16 0
  put a 0 2
  put a 2 uchar shr PG_PORT 8
  put a 3 uchar and PG_PORT 255
  put a 4 uchar shr PG_IP 24
  put a 5 uchar and shr PG_IP 16 255
  put a 6 uchar and shr PG_IP 8 255
  put a 7 uchar and PG_IP 255
  if eq r 0
    r = bind int fd a 0 16
  end
  if eq r 0
    r = listen int fd 64
  end
  if ne r 0
    x = fclose int fd
    ret r
  end
  ret fd
end

fn init_omc_path to void
  if gt argcnt 1
    k = argread 1 g_omc 0 511
    if gt k 0
      put g_omcl 0 ulong k
      ret
    end
  end
  for i ulong len t_def_omc bound 512
    put g_omc i get t_def_omc i
  end
  put g_omcl 0 len t_def_omc
end

fn main to int
  init_omc_path
  lfd = make_listener
  if lt lfd 0
    x = write 2 t_listen_err 0 len t_listen_err
    ret 2
  end
  x = write 2 t_started 0 len t_started
  for it ulong 4000000000 bound 4000000000
    w = waitio int lfd 1 1000000000
    if gt w 0
      cfd = accept int lfd 526336
      if ge cfd 0
        serve_conn int cfd
        x = fclose int cfd
      end
    end
  end
  ret 0
end

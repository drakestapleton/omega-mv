note omega-playground: pure seeded-Omega zero-JS online compiler and sandboxed runner
note Compiles user .om code with seed/out/omc (under prlimit + timeout) and runs the
note resulting static AArch64 ELF under execpure (Landlock ABI-3 + seccomp-BPF + 7 prlimits).
om2

const PG_PORT ulong 18490
const PG_IP uint 2130706433
const PG_MAX_REQ ulong 40960
const PG_MAX_CODE ulong 16384
const PG_MAX_CERR ulong 8192
const PG_MAX_ROUT ulong 16384
const PG_MAX_RERR ulong 8192
const PG_MAX_RESP ulong 131072
const PG_COMPILE_TMO long 4000000000
const PG_RUN_TMO long 2000000000
const PG_IO_TMO long 5000000000

const ST_HAS_POST ulong 0
const ST_MODE ulong 1
const ST_TOO_BIG ulong 2
const ST_COMP_RC ulong 3
const ST_COMP_MS ulong 4
const ST_BIN_BYTES ulong 5
const ST_RUN_RC ulong 6
const ST_RUN_MS ulong 7
const ST_ROUT_TR ulong 8
const ST_RERR_TR ulong 9
const ST_DID_RUN ulong 10


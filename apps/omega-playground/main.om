text t_ex_hello "note Hello world in Omega\ntext msg \"hello from omega\\n\"\n\nfn main to int\n  k = write 1 msg 0 len msg\n  if ne k long len msg\n    ret 1\n  end\n  ret 0\nend\n"

text t_ex_sum "note Bounded loop sum (returns exit code 6)\ntext hdr \"sum(0..3) = \"\ntext nl \"\\n\"\n\nfn main to int\n  total = int 0\n  for i int 4 bound 4\n    total = add total i\n  end\n  d = new uchar 1 0\n  put d 0 uchar add 48 total\n  x = write 1 hdr 0 len hdr\n  x = write 1 d 0 1\n  x = write 1 nl 0 len nl\n  ret total\nend\n"

text t_ex_fib "note Fibonacci F(10) = 55 with explicit loop bound\nom2\ntext pre \"fib(10) = \"\ntext nl \"\\n\"\n\nfn print_u64 v ulong to void\n  buf = new uchar 24 0\n  p = ulong 24\n  n = v\n  if eq n 0\n    put buf 23 48\n    x = write 1 buf 23 1\n    ret\n  end\n  while gt n 0 bound 24\n    p = sub p 1\n    put buf p uchar add 48 rem n 10\n    n = div n 10\n  end\n  x = write 1 buf p sub 24 p\nend\n\nfn main to int\n  a = ulong 0\n  b = ulong 1\n  for i ulong 10 bound 10\n    c = add a b\n    a = b\n    b = c\n  end\n  x = write 1 pre 0 len pre\n  print_u64 a\n  x = write 1 nl 0 len nl\n  ret 0\nend\n"

text t_ex_trap "note Runtime safety: division by zero traps with exit 102 (trap 2)\nfn main to int\n  a = int 10\n  b = int 0\n  ret div a b\nend\n"

text t_ex_typeerr "note Compile-time safety: returning bool from int function is error 7\nfn main to int\n  total = int 0\n  for i int 4 bound 4\n    total = add total i\n  end\n  ret true\nend\n"

text t_css ".pg-wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:start}@media(max-width:900px){.pg-wrap{grid-template-columns:1fr}}.pg-card{background:var(--white,#fff);border:1px solid var(--line,#d4d4d8);border-radius:12px;padding:20px}.pg-editor{width:100%;min-height:360px;padding:14px;border:1px solid var(--line-strong,#a1a1aa);border-radius:8px;background:#0d0e11;color:#f4f4f5;font-family:ui-monospace,SFMono-Regular,\"SF Mono\",Menlo,Consolas,monospace;font-size:14px;line-height:1.55;tab-size:2;resize:vertical;box-sizing:border-box}.pg-bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:14px}.pg-examples{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 14px}.pg-ex{display:inline-block;padding:5px 11px;border:1px solid var(--line,#d4d4d8);border-radius:999px;font-size:13px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-decoration:none;color:var(--ink,#18181b);background:var(--panel,#f4f4f5)}.pg-ex:hover{border-color:var(--line-strong,#71717a)}.pg-badge{display:inline-block;padding:3px 10px;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}.pg-pass{background:#dcfce7;color:#166534;border:1px solid #86efac}.pg-fail{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}.pg-warn{background:#fef3c7;color:#92400e;border:1px solid #fcd34d}.pg-meta{margin:10px 0 14px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;color:var(--muted,#52525b)}.pg-out{margin:8px 0 14px;padding:14px;border-radius:8px;background:#0d0e11;color:#e4e4e7;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;line-height:1.5;overflow-x:auto;white-space:pre-wrap;word-break:break-word;min-height:64px}.pg-lbl{margin:14px 0 4px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:.08em;text-transform:upperc
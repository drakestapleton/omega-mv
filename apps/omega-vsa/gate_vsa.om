note gate_vsa.om: Pure seeded-OM-2 End-to-End Verification Gate for OMVSA1 (10,240-bit VSA + NEON vsa_worker).
note Concatenated after si/directives/om2.om and seed/ng/sha256.om and compiled strictly by pinned omc.
note Usage: gate_vsa VSA_CORE_1 VSA_CORE_2 VSA_WORKER_1 VSA_WORKER_2 SCRATCH_DIR [EMIT_1 EMIT_2]

global gv_fbuf uchar 524288
global gv_fbuf2 uchar 524288
global gv_scratch uchar 4096
global gv_scr_n ulong 1
global gv_path uchar 4096
global gv_path_n ulong 1
global gv_pkt uchar 32768
global gv_pkt_off ulong 1
global gv_pkt_cnt ulong 1
global gv_st uchar 4
global gv_num uchar 128

text gv_t_hdr "=== OMEGA-VSA PURE-OM2 VERIFICATION GATE ===\n"
text gv_t_use "usage: gate_vsa VSA_CORE_1 VSA_CORE_2 VSA_WORKER_1 VSA_WORKER_2 SCRATCH_DIR [EMIT_1 EMIT_2]\n"
text gv_t_det1 "DET_2X: PASS binary="
text gv_t_det_sha " sha256="
text gv_t_det_err "FAIL: 2x binary mismatch or unreadable\n"
text gv_t_pos1 "POS_CHECK: PASS name="
text gv_t_neg1 "NEG_CONTROL: PASS name="
text gv_t_rc " exit="
text gv_t_fail "FAIL: step="
text gv_t_want " want="
text gv_t_got " got="
text gv_t_nl "\n"
text gv_t_pass "GATE_VSA: PASS (pos=3 neg=11 det=OK)\n"

text gv_n_core "vsa_core"
text gv_n_work "vsa_worker"
text gv_n_emit "emit_vsa_ir"

text gv_p_bench "bench"
text gv_p_vcb "verify-cb"
text gv_p_perm "check-perm"
text gv_p_wkey "check-wrong-key"
text gv_p_degen "check-degen"
text gv_p_137 "137"
text gv_p_10240 "10240"
text gv_p_0 "0"
text gv_p_1 "1"

text gv_s_cb "/cb_valid.omvsa1"
text gv_s_n1 "/neg1_bad_magic.omvsa1"
text gv_s_n2 "/neg2_bad_ver.omvsa1"
text gv_s_n3 "/neg3_bad_dim.omvsa1"
text gv_s_n4a "/neg4a_trunc.omvsa1"
text gv_s_n4b "/neg4b_trail.omvsa1"
text gv_s_n5 "/neg5_bad_sha.omvsa1"
text gv_s_n8c "/neg8c_degen.omvsa1"

text gv_k_pos_bench "vsa_core bench"
text gv_k_pos_vcb "verify-cb valid"
text gv_k_pos_perm "check-perm 137"
text gv_k_n1 "NEG-1 bad magic"
text gv_k_n2 "NEG-2 bad version"
text gv_k_n3 "NEG-3 bad dim_lanes with valid SHA"
text gv_k_n4a "NEG-4a truncated container"
text gv_k_n4b "NEG-4b trailing bytes container"
text gv_k_n5 "NEG-5 tampered payload SHA mismatch"
text gv_k_n6 "NEG-6 out-of-range shift >= 10240"
text gv_k_n7 "NEG-7 wrong unbinding key margin"
text gv_k_n8a "NEG-8a all-zeros degenerate guard"
text gv_k_n8b "NEG-8b all-ones degenerate guard"
text gv_k_n8c "NEG-8c zeroed record container with valid SHA"

fn gv_out s view uchar * to void
  r = write 1 s 0 len s
end

fn gv_out_u v ulong to void
  if eq v 0
    put gv_num 0 uchar 48
    r = write 1 gv_num 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    d = rem x 10
    put gv_num n uchar add 48 d
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i n
    j = sub sub n 1 i
    put gv_num add 64 i get gv_num j
    i = add i 1
  end
  r = write 1 gv_num 64 n
end

fn gv_out_hex32 to void
  for i ulong 32 bound 33
    b = ulong get sh_dig i
    hi = shr b 4
    lo = and b 15
    c1 = add 48 hi
    if ge hi 10
      c1 = add 87 hi
    end
    c2 = add 48 lo
    if ge lo 10
      c2 = add 87 lo
    end
    put gv_num mul i 2 uchar c1
    put gv_num add mul i 2 1 uchar c2
  end
  r = write 1 gv_num 0 64
end

fn gv_die_rc label view uchar * want ulong got ulong to void
  gv_out gv_t_fail
  gv_out label
  gv_out gv_t_want
  gv_out_u want
  gv_out gv_t_got
  gv_out_u got
  gv_out gv_t_nl
  exit 1
end

fn gv_load_arg_path idx ulong to void
  r = argread idx gv_path 0 4095
  if le r 0
    exit 2
  end
  put gv_path_n 0 ulong r
end

fn gv_set_scr_suf suf view uchar * to void
  sn = get gv_scr_n 0
  for i ulong sn bound 4096
    put gv_path i get gv_scratch i
  end
  ln = len suf
  for j ulong ln bound 256
    put gv_path add sn j get suf j
  end
  put gv_path_n 0 add sn ln
end

fn gv_read_path_into_fbuf to ulong
  pn = get gv_path_n 0
  r = fopen gv_path 0 pn 0 0
  if lt r 0
    exit 10
  end
  fd = int r
  tot = ulong 0
  done = false
  while not done
    rem_b = sub 524288 tot
    if eq rem_b 0
      z = fclose fd
      exit 10
    end
    chunk = rem_b
    if gt chunk 4096
      chunk = 4096
    end
    nr = read fd gv_fbuf tot chunk
    if lt nr 0
      z = fclose fd
      exit 10
    end
    if eq nr 0
      done = true
    else
      tot = add tot ulong nr
    end
  end
  z = fclose fd
  ret tot
end

fn gv_read_path_into_fbuf2 to ulong
  pn = get gv_path_n 0
  r = fopen gv_path 0 pn 0 0
  if lt r 0
    exit 10
  end
  fd = int r
  tot = ulong 0
  done = false
  while not done
    rem_b = sub 524288 tot
    if eq rem_b 0
      z = fclose fd
      exit 10
    end
    chunk = rem_b
    if gt chunk 4096
      chunk = 4096
    end
    nr = read fd gv_fbuf2 tot chunk
    if lt nr 0
      z = fclose fd
      exit 10
    end
    if eq nr 0
      done = true
    else
      tot = add tot ulong nr
    end
  end
  z = fclose fd
  ret tot
end

fn gv_write_fbuf2_to_path n ulong to void
  pn = get gv_path_n 0
  r = fopen gv_path 0 pn 577 420
  if lt r 0
    exit 11
  end
  fd = int r
  off = ulong 0
  while lt off n
    chunk = sub n off
    if gt chunk 4096
      chunk = 4096
    end
    w = write fd gv_fbuf2 off chunk
    if le w 0
      z = fclose fd
      exit 11
    end
    off = add off ulong w
  end
  z = fclose fd
end

fn gv_check_det2 label view uchar * idx1 ulong idx2 ulong to void
  gv_load_arg_path idx1
  n1 = gv_read_path_into_fbuf
  gv_load_arg_path idx2
  n2 = gv_read_path_into_fbuf2
  if or eq n1 0 ne n1 n2
    gv_out gv_t_det_err
    exit 12
  end
  for i ulong n1 bound 524289
    if ne get gv_fbuf i get gv_fbuf2 i
      gv_out gv_t_det_err
      exit 12
    end
    put sh_dat i get gv_fbuf i
  end
  sh_all n1
  gv_out gv_t_det1
  gv_out label
  gv_out gv_t_det_sha
  gv_out_hex32
  gv_out gv_t_nl
end

note ---- execprog builder helpers ----
fn gv_pkt_reset to void
  put gv_pkt_off 0 2
  put gv_pkt_cnt 0 0
end

fn gv_pkt_push_lit s view uchar * to void
  p = get gv_pkt_off 0
  ln = len s
  put gv_pkt p uchar and ln 255
  put gv_pkt add p 1 uchar and shr ln 8 255
  p = add p 2
  for i ulong ln bound 4096
    put gv_pkt add p i get s i
  end
  put gv_pkt_off 0 add p ln
  put gv_pkt_cnt 0 add get gv_pkt_cnt 0 1
end

fn gv_pkt_push_path to void
  p = get gv_pkt_off 0
  ln = get gv_path_n 0
  put gv_pkt p uchar and ln 255
  put gv_pkt add p 1 uchar and shr ln 8 255
  p = add p 2
  for i ulong ln bound 4096
    put gv_pkt add p i get gv_path i
  end
  put gv_pkt_off 0 add p ln
  put gv_pkt_cnt 0 add get gv_pkt_cnt 0 1
end

fn gv_pkt_push_arg idx ulong to void
  gv_load_arg_path idx
  gv_pkt_push_path
end

fn gv_run_pkt to ulong
  cnt = get gv_pkt_cnt 0
  put gv_pkt 0 uchar and cnt 255
  put gv_pkt 1 uchar and shr cnt 8 255
  pkl = get gv_pkt_off 0
  pid = fork
  if lt pid 0
    exit 13
  end
  if eq pid 0
    r = execprog gv_pkt 0 pkl
    exit 127
  end
  w = waitpid int pid gv_st 0 4 0
  if lt w 0
    exit 13
  end
  sig = and ulong get gv_st 0 127
  if ne sig 0
    ret add 128 sig
  end
  ret ulong get gv_st 1
end

fn gv_expect_pos label view uchar * to void
  rc = gv_run_pkt
  if ne rc 0
    gv_die_rc label 0 rc
  end
  gv_out gv_t_pos1
  gv_out label
  gv_out gv_t_rc
  gv_out_u rc
  gv_out gv_t_nl
end

fn gv_expect_neg label view uchar * want_rc ulong to void
  rc = gv_run_pkt
  if ne rc want_rc
    gv_die_rc label want_rc rc
  end
  gv_out gv_t_neg1
  gv_out label
  gv_out gv_t_rc
  gv_out_u rc
  gv_out gv_t_nl
end

fn gv_copy_valid_to_fbuf2 len_b ulong to void
  for i ulong len_b bound 524289
    put gv_fbuf2 i get gv_fbuf i
  end
end

fn gv_rehash_fbuf2 len_b ulong to void
  pb = sub len_b 64
  for i ulong 32 bound 33
    put sh_dat i get gv_fbuf2 i
  end
  for i ulong pb bound 262145
    put sh_dat add 32 i get gv_fbuf2 add 64 i
  end
  sh_all add 32 pb
  for i ulong 32 bound 33
    put gv_fbuf2 add 32 i get sh_dig i
  end
end

fn gv_neg_container label view uchar * suf view uchar * nbytes ulong want_rc ulong to void
  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_vcb
  gv_set_scr_suf suf
  gv_write_fbuf2_to_path nbytes
  gv_pkt_push_path
  gv_expect_neg label want_rc
end

fn main to int
  ac = ulong argcnt
  if lt ac 6
    gv_out gv_t_use
    ret 2
  end
  sr = argread 5 gv_scratch 0 4095
  if le sr 0
    ret 2
  end
  put gv_scr_n 0 ulong sr

  gv_out gv_t_hdr

  note 1. 2x deterministic build verification via SHA-256
  gv_check_det2 gv_n_core 1 2
  gv_check_det2 gv_n_work 3 4
  if ge ac 8
    gv_check_det2 gv_n_emit 6 7
  end

  note 2. Positive suite (bench + verify-cb + check-perm 137)
  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_bench
  gv_pkt_push_arg 3
  gv_set_scr_suf gv_s_cb
  gv_pkt_push_path
  gv_expect_pos gv_k_pos_bench

  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_vcb
  gv_set_scr_suf gv_s_cb
  gv_pkt_push_path
  gv_expect_pos gv_k_pos_vcb

  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_perm
  gv_pkt_push_lit gv_p_137
  gv_expect_pos gv_k_pos_perm

  note Load canonical cb_valid.omvsa1 into gv_fbuf for fault injection
  gv_set_scr_suf gv_s_cb
  vlen = gv_read_path_into_fbuf
  if le vlen 64
    exit 14
  end

  note 3. NEG-1: corrupted OMVSA1 magic
  gv_copy_valid_to_fbuf2 vlen
  put gv_fbuf2 0 uchar 88
  gv_neg_container gv_k_n1 gv_s_n1 vlen 41

  note 4. NEG-2: bad version != 1
  gv_copy_valid_to_fbuf2 vlen
  put gv_fbuf2 6 uchar 2
  gv_neg_container gv_k_n2 gv_s_n2 vlen 41

  note 5. NEG-3: bad word_lanes = 159 != 160 WITH valid SHA-256
  gv_copy_valid_to_fbuf2 vlen
  put gv_fbuf2 12 uchar 159
  gv_rehash_fbuf2 vlen
  gv_neg_container gv_k_n3 gv_s_n3 vlen 42

  note 6. NEG-4a: truncated container (-17 bytes)
  gv_copy_valid_to_fbuf2 vlen
  gv_neg_container gv_k_n4a gv_s_n4a sub vlen 17 44

  note 7. NEG-4b: trailing bytes (+8 bytes)
  gv_copy_valid_to_fbuf2 vlen
  for k ulong 8 bound 9
    put gv_fbuf2 add vlen k uchar 65
  end
  gv_neg_container gv_k_n4b gv_s_n4b add vlen 8 44

  note 8. NEG-5: tampered payload bit without updating SHA-256
  gv_copy_valid_to_fbuf2 vlen
  put gv_fbuf2 164 uchar xor ulong get gv_fbuf2 164 1
  gv_neg_container gv_k_n5 gv_s_n5 vlen 45

  note 9. NEG-6: out-of-range permutation shift >= 10240
  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_perm
  gv_pkt_push_lit gv_p_10240
  gv_expect_neg gv_k_n6 43

  note 10. NEG-7: wrong unbinding key failing associative margin threshold
  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_wkey
  gv_expect_neg gv_k_n7 47

  note 11. NEG-8a & 8b & 8c: degenerate zero/all-ones vector guard + container
  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_degen
  gv_pkt_push_lit gv_p_0
  gv_expect_neg gv_k_n8a 46

  gv_pkt_reset
  gv_pkt_push_arg 1
  gv_pkt_push_lit gv_p_degen
  gv_pkt_push_lit gv_p_1
  gv_expect_neg gv_k_n8b 46

  gv_copy_valid_to_fbuf2 vlen
  for z_i ulong 1280 bound 1281
    put gv_fbuf2 add 64 z_i uchar 0
  end
  gv_rehash_fbuf2 vlen
  gv_neg_container gv_k_n8c gv_s_n8c vlen 46

  gv_out gv_t_pass
  ret 0
end

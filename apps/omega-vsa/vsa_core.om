note vsa_core.om: Pure seeded-OM-2 10,240-bit OMVSA1 Hyperdimensional Vector-Symbolic Associative Program Memory
note Concatenated after si/directives/om2.om and seed/ng/sha256.om and compiled strictly by pinned omc.

const VSA_DIM ulong 10240
const VSA_WORDS ulong 160
const VSA_REC_BYTES ulong 1280
const VSA_HDR_BYTES ulong 64
const VSA_MAX_RECS ulong 64
const VSA_MARGIN_MAX ulong 3200
const VSA_MIN_GAP ulong 400

note Fail-closed OMVSA1 verification exit codes (strictly distinct per invariant)
const VSA_ERR_MAGIC ulong 41
const VSA_ERR_DIM ulong 42
const VSA_ERR_SHIFT ulong 43
const VSA_ERR_SIZE ulong 44
const VSA_ERR_SHA ulong 45
const VSA_ERR_DEGEN ulong 46
const VSA_ERR_MARGIN ulong 47
const VSA_ERR_PARITY ulong 48
const VSA_ERR_IO ulong 49

note Unified hypervector arena slots (each slot = 160 u64 = 10,240 bits; 540 * 160 = 86,400 < 131,072)
const B_CB ulong 0
const B_KEYS ulong 64
const B_VALS ulong 128
const B_BND ulong 192
const B_UNB_REF ulong 256
const B_UNB_NE ulong 320
const B_UNB_SW ulong 384
const B_BND_IN ulong 448
const B_TMP_A ulong 512
const B_TMP_B ulong 513
const B_TMP_C ulong 514
const B_BUN_REF ulong 515
const B_BUN_NE ulong 516

note Metadata & timing slices inside vs_meta
const M_F32 ulong 0
const M_U64 ulong 192
const M_NEON ulong 384
const M_SWAR ulong 576
const T_SC ulong 768
const T_U64 ulong 784
const T_NE ulong 800
const T_SW ulong 816

global vs_vec ulong 131072
global vs_meta ulong 1024

note Interleaved f32 banks matching vsa_worker NEON layout (for exact scalar f32 reference)
global vs_cb_f0 f32 163840
global vs_cb_f1 f32 163840
global vs_cb_f2 f32 163840
global vs_cb_f3 f32 163840
global vs_q_f0 f32 2560
global vs_q_f1 f32 2560
global vs_q_f2 f32 2560
global vs_q_f3 f32 2560

note Serialization, pipe IPC, process & string buffers
global vs_fbuf uchar 262144
global vs_pbuf uchar 131072
global vs_path uchar 4096
global vs_arg2 uchar 4096
global vs_pkt uchar 4112
global vs_mask uchar 8
global vs_pfds uchar 8
global vs_pstat uchar 4
global vs_wfd int 1
global vs_rfd int 1
global vs_wpid int 1
global vs_num_buf uchar 128

text vs_t_dot "."
text vs_t_0 "0"
text vs_t_x "x"
text vs_t_nl "\n"
text vs_t_rp ")\n"
text vs_t_err_sh "ERR: permutation shift out of range >= 10240\n"
text vs_t_err_pw "ERR: pipe write failed\n"
text vs_t_err_pr "ERR: pipe read failed\n"
text vs_t_err_wx "ERR: vsa_worker non-zero exit\n"
text vs_t_err_dw "ERR: degenerate vector on write\n"
text vs_t_err_wo "ERR: cannot open output file\n"
text vs_t_err_ro "ERR: cannot open input file\n"
text vs_t_err_tr "ERR: OMVSA1 truncated header\n"
text vs_t_err_mg "ERR: invalid OMVSA1 magic or version\n"
text vs_t_err_dm "ERR: invalid OMVSA1 dimension or word lanes\n"
text vs_t_err_rc "ERR: invalid OMVSA1 record count\n"
text vs_t_err_sz "ERR: OMVSA1 length mismatch / truncated / trailing bytes\n"
text vs_t_err_sh2 "ERR: OMVSA1 SHA-256 tag mismatch\n"
text vs_t_err_dg "ERR: OMVSA1 degenerate vector rejected\n"
text vs_t_err_bx "ERR: self-inverse XOR bind failed\n"
text vs_t_ok_bind "BIND_SELF_INVERSE: PASS (8/8 bit-exact, 0-bit diff across 10,240 bits)\n"
text vs_t_err_pi "ERR: cyclic permutation inverse failed\n"
text vs_t_err_ps "ERR: sequence permutation order collapsed\n"
text vs_t_ok_p1 "PERMUTE_BIJECTION: PASS (5 shifts exact 0-bit diff; seq [A,B] vs [B,A] dist="
text vs_t_ok_p2 "/10240)\n"
text vs_t_err_bn "ERR: NEON bundle vs scalar bundle diff\n"
text vs_t_err_bm "ERR: noisy bundle recall missed slot\n"
text vs_t_ok_b1 "BUNDLE_RECOVERY_NOISE_5PCT: PASS (5/5 pairs recovered under 512 bit flips, min_margin="
text vs_t_ok_b2 ", NEON_vs_scalar_diff=0)\n"
text vs_t_ok_c1 "OMVSA1_CONTAINER: PASS (bytes="
text vs_t_ok_c2 ", sha256="
text vs_t_ok_par "PARITY_EXACT_Q64_M64: PASS (0-bit diff across 64x10240 unbound bits & 64x3 recall tuples across scalar_f32, scalar_u64, ng_a64_neon, ng_a64_swar)\n"
text vs_t_m1 "MED9_TIMINGS_NS: scalar_f32="
text vs_t_m2 " scalar_u64="
text vs_t_m3 " ng_neon_pipe="
text vs_t_m4 " ng_swar_pipe="
text vs_t_sp1 "\nSPEEDUP_NEON_VS_SCALAR_F32: "
text vs_t_sp2 "\nSPEEDUP_NEON_VS_NG_SWAR: "
text vs_t_sp3 "\nSPEEDUP_NEON_VS_SCALAR_U64: "
text vs_t_wk1 "NEG_WRONG_KEY: REJECTED_AS_EXPECTED (best_dist="
text vs_t_wk2 ", gap="
text vs_t_wk_err "ERR: wrong key unexpectedly passed margin\n"
text vs_t_dg1 "NEG_DEGEN_VECTOR: REJECTED_AS_EXPECTED (mode="
text vs_t_use "usage: vsa_core <bench|write-cb|verify-cb|check-perm|check-wrong-key|check-degen> ...\n"
text vs_t_wro "WROTE_OMVSA1: bytes="
text vs_t_ver "VERIFY_OMVSA1: PASS records="
text vs_t_prm "CHECK_PERM: PASS shift="
text vs_t_unk "ERR: unknown command\n"
text vs_c_bench "bench"
text vs_c_wcb "write-cb"
text vs_c_vcb "verify-cb"
text vs_c_perm "check-perm"
text vs_c_wkey "check-wrong-key"
text vs_c_degen "check-degen"

note ---- Printing & binary little-endian encoding helpers ----

fn vs_out s view uchar * to void
  r = write 1 s 0 len s
end

fn vs_out_u v ulong to void
  if eq v 0
    put vs_num_buf 0 uchar 48
    r = write 1 vs_num_buf 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    d = rem x 10
    put vs_num_buf n uchar add 48 d
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i n
    j = sub sub n 1 i
    put vs_num_buf add 64 i get vs_num_buf j
    i = add i 1
  end
  r = write 1 vs_num_buf 64 n
end

fn vs_out_hex32 to void
  for i ulong 32 bound 33
    b = ulong get sh_dig i
    hi = shr b 4
    lo = and b 15
    c1 = add 48 hi
    if ge hi 10
      c1 = add 87 hi
    end
    c2 = add 48 lo
    if ge lo 10
      c2 = add 87 lo
    end
    put vs_num_buf mul i 2 uchar c1
    put vs_num_buf add mul i 2 1 uchar c2
  end
  r = write 1 vs_num_buf 0 64
end

fn vs_f_pk_u16 off ulong v ulong to void
  put vs_fbuf off uchar and v 255
  put vs_fbuf add off 1 uchar and shr v 8 255
end

fn vs_f_pk_u32 off ulong v ulong to void
  for k ulong 4 bound 5
    put vs_fbuf add off k uchar and shr v mul k 8 255
  end
end

fn vs_f_pk_u64 off ulong v ulong to void
  for k ulong 8 bound 9
    put vs_fbuf add off k uchar and shr v mul k 8 255
  end
end

fn vs_f_up_u16 off ulong to ulong
  a = ulong get vs_fbuf off
  b = ulong get vs_fbuf add off 1
  ret or a shl b 8
end

fn vs_f_up_u32 off ulong to ulong
  r = ulong 0
  for k ulong 4 bound 5
    v = ulong get vs_fbuf add off k
    r = or r shl v mul k 8
  end
  ret r
end

fn vs_f_up_u64 off ulong to ulong
  r = ulong 0
  for k ulong 8 bound 9
    v = ulong get vs_fbuf add off k
    r = or r shl v mul k 8
  end
  ret r
end

fn vs_p_pk_u64 off ulong v ulong to void
  for k ulong 8 bound 9
    put vs_pbuf add off k uchar and shr v mul k 8 255
  end
end

fn vs_p_up_u64 off ulong to ulong
  r = ulong 0
  for k ulong 8 bound 9
    v = ulong get vs_pbuf add off k
    r = or r shl v mul k 8
  end
  ret r
end

fn vs_up4_pfds off ulong to ulong
  r = ulong 0
  for k ulong 4 bound 5
    v = ulong get vs_pfds add off k
    r = or r shl v mul k 8
  end
  ret r
end

fn vs_up4_pstat to ulong
  r = ulong 0
  for k ulong 4 bound 5
    v = ulong get vs_pstat k
    r = or r shl v mul k 8
  end
  ret r
end

fn vs_cmd_eq a view uchar * bn ulong to bool
  if ne len a bn
    ret false
  end
  for i ulong bn bound 33
    if ne get a i get vs_num_buf i
      ret false
    end
  end
  ret true
end

fn vs_pin_cpu5 to void
  for i ulong 8 bound 9
    put vs_mask i uchar 0
  end
  put vs_mask 0 uchar 32
  r = cpuset 0 vs_mask 0 8
end

note ---- Exact 10,240-bit PRNG, popcount, bind, permute, bundle ----

fn vs_splitmix s ulong to ulong
  z = add s 0x9e3779b97f4a7c15
  z = mul xor z shr z 30 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 0x94d049bb133111eb
  ret xor z shr z 31
end

fn vs_gen_vec slot ulong seed ulong to void
  base = mul slot VSA_WORDS
  st = add seed mul slot 0x517cc1b727220a95
  for w ulong VSA_WORDS bound 161
    st = vs_splitmix st
    put vs_vec add base w st
  end
end

fn vs_popcnt64 x ulong to ulong
  t = sub x and shr x 1 0x5555555555555555
  t = add and t 0x3333333333333333 and shr t 2 0x3333333333333333
  t = and add t shr t 4 0x0f0f0f0f0f0f0f0f
  ret shr mul t 0x0101010101010101 56
end

fn vs_vec_pop slot ulong to ulong
  base = mul slot VSA_WORDS
  tot = ulong 0
  for w ulong VSA_WORDS bound 161
    tot = add tot vs_popcnt64 get vs_vec add base w
  end
  ret tot
end

fn vs_check_degen slot ulong to bool
  p = vs_vec_pop slot
  if eq p 0
    ret true
  end
  if eq p VSA_DIM
    ret true
  end
  if lt p 1024
    ret true
  end
  if gt p 9216
    ret true
  end
  ret false
end

fn vs_hamming sa ulong sb ulong to ulong
  ba = mul sa VSA_WORDS
  bb = mul sb VSA_WORDS
  acc = ulong 0
  for w ulong VSA_WORDS bound 161
    d = xor get vs_vec add ba w get vs_vec add bb w
    acc = add acc vs_popcnt64 d
  end
  ret acc
end

fn vs_copy_vec ds ulong ss ulong to void
  bd = mul ds VSA_WORDS
  bs = mul ss VSA_WORDS
  for w ulong VSA_WORDS bound 161
    put vs_vec add bd w get vs_vec add bs w
  end
end

fn vs_bind_u64 sa ulong sb ulong ds ulong to void
  ba = mul sa VSA_WORDS
  bb = mul sb VSA_WORDS
  bd = mul ds VSA_WORDS
  for w ulong VSA_WORDS bound 161
    va = get vs_vec add ba w
    vb = get vs_vec add bb w
    put vs_vec add bd w xor va vb
  end
end

fn vs_flip_bits slot ulong n_flips ulong stride ulong to void
  base = mul slot VSA_WORDS
  pos = ulong 17
  for i ulong n_flips bound 10241
    pos = rem add pos stride VSA_DIM
    w = shr pos 6
    b = and pos 63
    cur = get vs_vec add base w
    put vs_vec add base w xor cur shl 1 b
  end
end

fn vs_perm_set_bit bd ulong dst_i ulong to void
  di = dst_i
  if ge di VSA_DIM
    di = sub di VSA_DIM
  end
  wd = shr di 6
  kd = and di 63
  idx = add bd wd
  cur = get vs_vec idx
  msk = shl 1 kd
  put vs_vec idx or cur msk
end

note Cyclic permutation rho^shift over all 10,240 bits
fn vs_permute ss ulong ds ulong shift ulong to void
  if ge shift VSA_DIM
    vs_out vs_t_err_sh
    exit int VSA_ERR_SHIFT
  end
  bs = mul ss VSA_WORDS
  bd = mul ds VSA_WORDS
  for w ulong VSA_WORDS bound 161
    put vs_vec add bd w 0
  end
  for i ulong VSA_DIM bound 10241
    ws = shr i 6
    ks = and i 63
    wd_v = get vs_vec add bs ws
    if ne and shr wd_v ks 1 0
      vs_perm_set_bit bd add i shift
    end
  end
end

note Exact inverse cyclic permutation rho^(-shift)
fn vs_unpermute ss ulong ds ulong shift ulong to void
  if ge shift VSA_DIM
    vs_out vs_t_err_sh
    exit int VSA_ERR_SHIFT
  end
  inv = ulong 0
  if gt shift 0
    inv = sub VSA_DIM shift
  end
  vs_permute ss ds inv
end

fn vs_bundle_ones b0 ulong k_cnt ulong bit ulong w ulong to ulong
  ones = ulong 0
  idx = add b0 w
  for j ulong k_cnt bound 65
    v = get vs_vec idx
    v = shr v bit
    ones = add ones and v 1
    idx = add idx VSA_WORDS
  end
  ret ones
end

fn vs_bundle_word base_s ulong k_cnt ulong w ulong to ulong
  b0 = mul base_s VSA_WORDS
  acc = ulong 0
  for bit ulong 64 bound 65
    ones = vs_bundle_ones b0 k_cnt bit w
    twice = mul ones 2
    if gt twice k_cnt
      acc = or acc shl 1 bit
    else
      if eq twice k_cnt
        if ne and bit 1 0
          acc = or acc shl 1 bit
        end
      end
    end
  end
  ret acc
end

fn vs_bundle_scalar base_s ulong k_cnt ulong ds ulong to void
  bd = mul ds VSA_WORDS
  for w ulong VSA_WORDS bound 161
    put vs_vec add bd w vs_bundle_word base_s k_cnt w
  end
end

note ---- Exact Scalar f32 Bipolar Reference (matches vsa_worker NEON math bit-for-bit) ----

fn vs_bit_f32 b ulong to f32
  if ne and b 1 0
    ret f32 -1
  end
  ret f32 1
end

fn vs_unpack_nibble word ulong idx ulong is_cb bool to void
  if is_cb
    put vs_cb_f0 idx vs_bit_f32 word
    put vs_cb_f1 idx vs_bit_f32 shr word 1
    put vs_cb_f2 idx vs_bit_f32 shr word 2
    put vs_cb_f3 idx vs_bit_f32 shr word 3
  else
    put vs_q_f0 idx vs_bit_f32 word
    put vs_q_f1 idx vs_bit_f32 shr word 1
    put vs_q_f2 idx vs_bit_f32 shr word 2
    put vs_q_f3 idx vs_bit_f32 shr word 3
  end
end

fn vs_unpack_u64_to_f32 word ulong p0 ulong is_cb bool to void
  w = word
  for sub_i ulong 16 bound 17
    vs_unpack_nibble w add p0 sub_i is_cb
    w = shr w 4
  end
end

fn vs_prepare_cb_f32 m_cnt ulong to void
  for m ulong m_cnt bound 65
    bs = mul add B_CB m VSA_WORDS
    m0 = mul m 2560
    for w ulong VSA_WORDS bound 161
      vs_unpack_u64_to_f32 get vs_vec add bs w add m0 mul w 16 true
    end
  end
end

fn vs_f32_hamming mi ulong to ulong
  m_off = mul mi 2560
  s0 = f32 0
  s1 = f32 0
  s2 = f32 0
  s3 = f32 0
  for p ulong 2560 bound 2561
    mp = add m_off p
    fa = get vs_q_f0 p
    fb = get vs_cb_f0 mp
    s0 = add s0 mul fa fb
    fa = get vs_q_f1 p
    fb = get vs_cb_f1 mp
    s1 = add s1 mul fa fb
    fa = get vs_q_f2 p
    fb = get vs_cb_f2 mp
    s2 = add s2 mul fa fb
    fa = get vs_q_f3 p
    fb = get vs_cb_f3 mp
    s3 = add s3 mul fa fb
  end
  s0 = add s0 s1
  s2 = add s2 s3
  s0 = add s0 s2
  idot = long s0
  ret shr ulong sub long 10240 idot 1
end

fn vs_scalar_f32_recall m_cnt ulong q_cnt ulong to void
  for qi ulong q_cnt bound 65
    bk = mul add B_KEYS qi VSA_WORDS
    bb = mul add B_BND qi VSA_WORDS
    for w ulong VSA_WORDS bound 161
      va = get vs_vec add bk w
      vb = get vs_vec add bb w
      wd = xor va vb
      vs_unpack_u64_to_f32 wd mul w 16 false
    end
    best_i = ulong 0
    best_d = ulong 999999
    sec_d = ulong 999999
    for mi ulong m_cnt bound 65
      d = vs_f32_hamming mi
      if lt d best_d
        sec_d = best_d
        best_d = d
        best_i = mi
      else
        if lt d sec_d
          sec_d = d
        end
      end
    end
    mo = add M_F32 mul qi 3
    put vs_meta mo best_i
    put vs_meta add mo 1 best_d
    put vs_meta add mo 2 sec_d
  end
end

fn vs_scalar_u64_recall m_cnt ulong q_cnt ulong to void
  for qi ulong q_cnt bound 65
    vs_bind_u64 add B_KEYS qi add B_BND qi add B_UNB_REF qi
    best_i = ulong 0
    best_d = ulong 999999
    sec_d = ulong 999999
    for mi ulong m_cnt bound 65
      d = vs_hamming add B_UNB_REF qi add B_CB mi
      if lt d best_d
        sec_d = best_d
        best_d = d
        best_i = mi
      else
        if lt d sec_d
          sec_d = d
        end
      end
    end
    mo = add M_U64 mul qi 3
    put vs_meta mo best_i
    put vs_meta add mo 1 best_d
    put vs_meta add mo 2 sec_d
  end
end

note ---- Pipe I/O & Worker Subprocess Control ----

fn vs_wr_pbuf fd int n ulong to void
  off = ulong 0
  while lt off n
    chunk = sub n off
    if gt chunk 4096
      chunk = 4096
    end
    w = write fd vs_pbuf off chunk
    if le w 0
      vs_out vs_t_err_pw
      exit int VSA_ERR_IO
    end
    off = add off ulong w
  end
end

fn vs_wr_fbuf fd int n ulong to void
  off = ulong 0
  while lt off n
    chunk = sub n off
    if gt chunk 4096
      chunk = 4096
    end
    w = write fd vs_fbuf off chunk
    if le w 0
      vs_out vs_t_err_pw
      exit int VSA_ERR_IO
    end
    off = add off ulong w
  end
end

fn vs_rd_pbuf fd int n ulong to void
  off = ulong 0
  while lt off n
    chunk = sub n off
    if gt chunk 4096
      chunk = 4096
    end
    r = read fd vs_pbuf off chunk
    if le r 0
      vs_out vs_t_err_pr
      exit int VSA_ERR_IO
    end
    off = add off ulong r
  end
end

fn vs_send_u64 fd int v ulong to void
  vs_p_pk_u64 0 v
  vs_wr_pbuf fd 8
end

fn vs_send_vecs fd int base_s ulong cnt ulong to void
  b0 = mul base_s VSA_WORDS
  nw = mul cnt VSA_WORDS
  for i ulong nw bound 10241
    vs_p_pk_u64 mul i 8 get vs_vec add b0 i
  end
  vs_wr_pbuf fd mul nw 8
end

fn vs_recv_meta fd int meta_base ulong nw ulong to void
  vs_rd_pbuf fd mul nw 8
  for i ulong nw bound 257
    put vs_meta add meta_base i vs_p_up_u64 mul i 8
  end
end

fn vs_recv_vecs fd int base_s ulong cnt ulong to void
  b0 = mul base_s VSA_WORDS
  nw = mul cnt VSA_WORDS
  vs_rd_pbuf fd mul nw 8
  for i ulong nw bound 10241
    put vs_vec add b0 i vs_p_up_u64 mul i 8
  end
end

fn vs_spawn_worker plen ulong to void
  put vs_pkt 0 uchar 1
  put vs_pkt 1 uchar 0
  put vs_pkt 2 uchar and plen 255
  put vs_pkt 3 uchar and shr plen 8 255
  for i ulong plen bound 4097
    put vs_pkt add 4 i get vs_path i
  end
  pkl = add 4 plen

  if lt pipefds vs_pfds 0 8 0 0
    exit int VSA_ERR_IO
  end
  p_r0 = int vs_up4_pfds 0
  p_w0 = int vs_up4_pfds 4

  if lt pipefds vs_pfds 0 8 0 0
    exit int VSA_ERR_IO
  end
  p_r1 = int vs_up4_pfds 0
  p_w1 = int vs_up4_pfds 4

  pid = fork
  if lt pid 0
    exit int VSA_ERR_IO
  end
  if eq pid 0
    z = fclose p_w0
    z = fclose p_r1
    if ne p_r0 0
      z = dupfd p_r0 0 0
      z = fclose p_r0
    end
    if ne p_w1 1
      z = dupfd p_w1 1 0
      z = fclose p_w1
    end
    vs_pin_cpu5
    z = execprog vs_pkt 0 pkl
    exit int VSA_ERR_IO
  end
  z = fclose p_r0
  z = fclose p_w1
  put vs_wpid 0 int pid
  put vs_wfd 0 p_w0
  put vs_rfd 0 p_r1
end

fn vs_worker_load_cb m_cnt ulong to void
  wfd = get vs_wfd 0
  rfd = get vs_rfd 0
  put vs_pbuf 0 uchar 1
  vs_wr_pbuf wfd 1
  vs_send_u64 wfd m_cnt
  vs_send_vecs wfd B_CB m_cnt
  vs_rd_pbuf rfd 1
  if ne ulong get vs_pbuf 0 1
    exit int VSA_ERR_IO
  end
end

fn vs_worker_recall cmd uchar q_cnt ulong meta_base ulong unb_base ulong to void
  wfd = get vs_wfd 0
  rfd = get vs_rfd 0
  put vs_pbuf 0 cmd
  vs_wr_pbuf wfd 1
  vs_send_u64 wfd q_cnt
  vs_send_vecs wfd B_KEYS q_cnt
  vs_send_vecs wfd B_BND q_cnt
  vs_recv_meta rfd meta_base mul q_cnt 3
  vs_recv_vecs rfd unb_base q_cnt
end

fn vs_worker_bundle k_cnt ulong to void
  wfd = get vs_wfd 0
  rfd = get vs_rfd 0
  put vs_pbuf 0 uchar 3
  vs_wr_pbuf wfd 1
  vs_send_u64 wfd k_cnt
  vs_send_vecs wfd B_BND_IN k_cnt
  vs_recv_vecs rfd B_BUN_NE 1
end

fn vs_stop_worker to void
  wfd = get vs_wfd 0
  put vs_pbuf 0 uchar 0
  vs_wr_pbuf wfd 1
  z = fclose wfd
  z = fclose get vs_rfd 0
  pid = get vs_wpid 0
  r = waitpid pid vs_pstat 0 4 0
  if lt r 0
    exit int VSA_ERR_IO
  end
  if ne vs_up4_pstat 0
    vs_out vs_t_err_wx
    exit int VSA_ERR_IO
  end
end

note ---- Canonical OMVSA1 Container Serialization & Fail-Closed Parser ----
note Header (64 bytes):
note   0..6   OMVSA1
note   6..8   u16 version = 1
note   8..12  u32 dim_bits = 10240
note   12..16 u32 word_lanes = 160
note   16..20 u32 num_records (1..64)
note   20..24 u32 flags = 1
note   24..32 u64 payload_bytes = num_records * 1280
note   32..64 sha256(hdr[0..32) || payload[0..payload_bytes))

fn vs_build_omvsa1 base_s ulong num_recs ulong to ulong
  for i ulong num_recs bound 65
    if vs_check_degen add base_s i
      vs_out vs_t_err_dw
      exit int VSA_ERR_DEGEN
    end
  end
  pb = mul num_recs VSA_REC_BYTES
  put vs_fbuf 0 uchar 79
  put vs_fbuf 1 uchar 77
  put vs_fbuf 2 uchar 86
  put vs_fbuf 3 uchar 83
  put vs_fbuf 4 uchar 65
  put vs_fbuf 5 uchar 49
  vs_f_pk_u16 6 1
  vs_f_pk_u32 8 VSA_DIM
  vs_f_pk_u32 12 VSA_WORDS
  vs_f_pk_u32 16 num_recs
  vs_f_pk_u32 20 1
  vs_f_pk_u64 24 pb

  for i ulong 32 bound 33
    put sh_dat i get vs_fbuf i
  end
  b0 = mul base_s VSA_WORDS
  nw = mul num_recs VSA_WORDS
  for i ulong nw bound 10241
    vs_f_pk_u64 add VSA_HDR_BYTES mul i 8 get vs_vec add b0 i
  end
  for i ulong pb bound 81921
    put sh_dat add 32 i get vs_fbuf add VSA_HDR_BYTES i
  end
  sh_all add 32 pb
  for i ulong 32 bound 33
    put vs_fbuf add 32 i get sh_dig i
  end
  ret add VSA_HDR_BYTES pb
end

fn vs_write_arg2 plen ulong total ulong to void
  r = fopen vs_arg2 0 plen 577 420
  if lt r 0
    vs_out vs_t_err_wo
    exit int VSA_ERR_IO
  end
  fd = int r
  vs_wr_fbuf fd total
  z = fclose fd
end

fn vs_write_path plen ulong total ulong to void
  r = fopen vs_path 0 plen 577 420
  if lt r 0
    vs_out vs_t_err_wo
    exit int VSA_ERR_IO
  end
  fd = int r
  vs_wr_fbuf fd total
  z = fclose fd
end

fn vs_read_path plen ulong to ulong
  r = fopen vs_path 0 plen 0 0
  if lt r 0
    vs_out vs_t_err_ro
    exit int VSA_ERR_IO
  end
  fd = int r
  tot = ulong 0
  done = false
  while not done
    rem_b = sub 262144 tot
    if eq rem_b 0
      z = fclose fd
      exit int VSA_ERR_SIZE
    end
    chunk = rem_b
    if gt chunk 4096
      chunk = 4096
    end
    nr = read fd vs_fbuf tot chunk
    if lt nr 0
      z = fclose fd
      exit int VSA_ERR_IO
    end
    if eq nr 0
      done = true
    else
      tot = add tot ulong nr
    end
  end
  z = fclose fd
  ret tot
end

fn vs_chk_magic to void
  bad_m = false
  if ne ulong get vs_fbuf 0 79
    bad_m = true
  end
  if ne ulong get vs_fbuf 1 77
    bad_m = true
  end
  if ne ulong get vs_fbuf 2 86
    bad_m = true
  end
  if ne ulong get vs_fbuf 3 83
    bad_m = true
  end
  if ne ulong get vs_fbuf 4 65
    bad_m = true
  end
  if ne ulong get vs_fbuf 5 49
    bad_m = true
  end
  if ne vs_f_up_u16 6 1
    bad_m = true
  end
  if bad_m
    vs_out vs_t_err_mg
    exit int VSA_ERR_MAGIC
  end
end

fn vs_parse_verify_omvsa1 flen ulong base_s ulong to ulong
  if lt flen VSA_HDR_BYTES
    vs_out vs_t_err_tr
    exit int VSA_ERR_SIZE
  end
  vs_chk_magic

  dim = vs_f_up_u32 8
  wds = vs_f_up_u32 12
  if or ne dim VSA_DIM ne wds VSA_WORDS
    vs_out vs_t_err_dm
    exit int VSA_ERR_DIM
  end

  nrecs = vs_f_up_u32 16
  pb = vs_f_up_u64 24
  if or eq nrecs 0 gt nrecs VSA_MAX_RECS
    vs_out vs_t_err_rc
    exit int VSA_ERR_SIZE
  end
  if or ne pb mul nrecs VSA_REC_BYTES ne flen add VSA_HDR_BYTES pb
    vs_out vs_t_err_sz
    exit int VSA_ERR_SIZE
  end

  for i ulong 32 bound 33
    put sh_dat i get vs_fbuf i
  end
  for i ulong pb bound 81921
    put sh_dat add 32 i get vs_fbuf add VSA_HDR_BYTES i
  end
  sh_all add 32 pb
  for i ulong 32 bound 33
    if ne get sh_dig i get vs_fbuf add 32 i
      vs_out vs_t_err_sh2
      exit int VSA_ERR_SHA
    end
  end

  b0 = mul base_s VSA_WORDS
  nw = mul nrecs VSA_WORDS
  for i ulong nw bound 10241
    put vs_vec add b0 i vs_f_up_u64 add VSA_HDR_BYTES mul i 8
  end
  for i ulong nrecs bound 65
    if vs_check_degen add base_s i
      vs_out vs_t_err_dg
      exit int VSA_ERR_DEGEN
    end
  end
  ret nrecs
end

note ---- Sorting helper for 9-run median ----
fn vs_median9 base_m ulong to ulong
  for i ulong 9 bound 10
    j = add i 1
    while lt j 9
      ai = get vs_meta add base_m i
      aj = get vs_meta add base_m j
      if gt ai aj
        put vs_meta add base_m i aj
        put vs_meta add base_m j ai
      end
      j = add j 1
    end
  end
  ret get vs_meta add base_m 4
end

note ---- Populates canonical M=64 Symbolic Codebook & Q=64 Bound Query Batch ----
fn vs_init_codebook_and_queries m_cnt ulong q_cnt ulong to void
  for m ulong m_cnt bound 65
    vs_gen_vec add B_CB m add 0x1000 m
    vs_gen_vec add B_KEYS m add 0x2000 m
    vs_gen_vec add B_VALS m add 0x3000 m
  end
  for q ulong q_cnt bound 65
    target = rem mul q 17 m_cnt
    vs_gen_vec add B_KEYS q add 0x4000 q
    vs_bind_u64 add B_KEYS q add B_CB target add B_BND q
  end
end

fn vs_print_ratio num ulong den ulong to void
  d = den
  if eq d 0
    d = 1
  end
  x100 = div mul num 100 d
  wh = div x100 100
  fr = rem x100 100
  vs_out_u wh
  vs_out vs_t_dot
  if lt fr 10
    vs_out vs_t_0
  end
  vs_out_u fr
  vs_out vs_t_x
end

note ---- Full Positive Suite + Parity + Benchmark ----
fn vs_test_bind_perm to void
  for i ulong 8 bound 9
    vs_bind_u64 add B_KEYS i add B_VALS i B_TMP_A
    vs_bind_u64 B_TMP_A add B_KEYS i B_TMP_B
    if ne vs_hamming B_TMP_B add B_VALS i 0
      vs_out vs_t_err_bx
      exit int VSA_ERR_PARITY
    end
  end
  vs_out vs_t_ok_bind

  for s_i ulong 5 bound 6
    sh = ulong 0
    if eq s_i 1
      sh = 1
    end
    if eq s_i 2
      sh = 63
    end
    if eq s_i 3
      sh = 137
    end
    if eq s_i 4
      sh = 10239
    end
    vs_permute add B_CB s_i B_TMP_A sh
    vs_unpermute B_TMP_A B_TMP_B sh
    if ne vs_hamming B_TMP_B add B_CB s_i 0
      vs_out vs_t_err_pi
      exit int VSA_ERR_PARITY
    end
  end
  vs_permute add B_CB 1 B_TMP_A 1
  vs_bind_u64 B_CB B_TMP_A B_TMP_B
  vs_permute B_CB B_TMP_A 1
  vs_bind_u64 add B_CB 1 B_TMP_A B_TMP_C
  seq_dist = vs_hamming B_TMP_B B_TMP_C
  if lt seq_dist 4000
    vs_out vs_t_err_ps
    exit int VSA_ERR_PARITY
  end
  vs_out vs_t_ok_p1
  vs_out_u seq_dist
  vs_out vs_t_ok_p2
end

fn vs_test_bundle m_cnt ulong to void
  for j ulong 5 bound 6
    vs_bind_u64 add B_KEYS j add B_CB j add B_BND_IN j
  end
  vs_bundle_scalar B_BND_IN 5 B_BUN_REF
  vs_worker_bundle 5
  if ne vs_hamming B_BUN_REF B_BUN_NE 0
    vs_out vs_t_err_bn
    exit int VSA_ERR_PARITY
  end
  vs_copy_vec B_TMP_A B_BUN_NE
  vs_flip_bits B_TMP_A 512 97
  min_gap = ulong 999999
  for j ulong 5 bound 6
    vs_bind_u64 B_TMP_A add B_KEYS j B_TMP_B
    bd = ulong 999999
    sd = ulong 999999
    bi = ulong 0
    for mi ulong m_cnt bound 65
      dh = vs_hamming B_TMP_B add B_CB mi
      if lt dh bd
        sd = bd
        bd = dh
        bi = mi
      else
        if lt dh sd
          sd = dh
        end
      end
    end
    if ne bi j
      vs_out vs_t_err_bm
      exit int VSA_ERR_MARGIN
    end
    gap = sub sd bd
    if lt gap min_gap
      min_gap = gap
    end
  end
  vs_out vs_t_ok_b1
  vs_out_u min_gap
  vs_out vs_t_ok_b2
end

fn vs_test_container m_cnt ulong has_out bool out_len ulong to void
  tot_len = vs_build_omvsa1 B_CB m_cnt
  if has_out
    vs_write_arg2 out_len tot_len
  end
  vs_copy_vec B_TMP_C B_CB
  parsed_n = vs_parse_verify_omvsa1 tot_len B_CB
  if ne parsed_n m_cnt
    exit int VSA_ERR_SIZE
  end
  if ne vs_hamming B_CB B_TMP_C 0
    exit int VSA_ERR_SHA
  end
  vs_out vs_t_ok_c1
  vs_out_u tot_len
  vs_out vs_t_ok_c2
  vs_out_hex32
  vs_out vs_t_rp
end

fn vs_test_parity m_cnt ulong q_cnt ulong to void
  vs_prepare_cb_f32 m_cnt
  vs_scalar_f32_recall m_cnt q_cnt
  vs_scalar_u64_recall m_cnt q_cnt
  vs_worker_recall uchar 2 q_cnt M_NEON B_UNB_NE
  vs_worker_recall uchar 4 q_cnt M_SWAR B_UNB_SW

  for q ulong q_cnt bound 65
    want_idx = rem mul q 17 m_cnt
    mo = mul q 3
    if ne get vs_meta add M_U64 mo want_idx
      exit int VSA_ERR_MARGIN
    end
    if ne get vs_meta add M_U64 add mo 1 0
      exit int VSA_ERR_PARITY
    end
    for f ulong 3 bound 4
      k = add mo f
      v0 = get vs_meta add M_U64 k
      if ne get vs_meta add M_F32 k v0
        exit int VSA_ERR_PARITY
      end
      if ne get vs_meta add M_NEON k v0
        exit int VSA_ERR_PARITY
      end
      if ne get vs_meta add M_SWAR k v0
        exit int VSA_ERR_PARITY
      end
    end
    if ne vs_hamming add B_UNB_REF q add B_UNB_NE q 0
      exit int VSA_ERR_PARITY
    end
    if ne vs_hamming add B_UNB_REF q add B_UNB_SW q 0
      exit int VSA_ERR_PARITY
    end
  end
  vs_out vs_t_ok_par
end

fn vs_bench_med9 m_cnt ulong q_cnt ulong to void
  vs_scalar_f32_recall m_cnt q_cnt
  vs_scalar_u64_recall m_cnt q_cnt
  vs_worker_recall uchar 2 q_cnt M_NEON B_UNB_NE
  vs_worker_recall uchar 4 q_cnt M_SWAR B_UNB_SW

  for it ulong 9 bound 10
    t0 = ulong monons
    vs_scalar_f32_recall m_cnt q_cnt
    put vs_meta add T_SC it sub ulong monons t0

    t0 = ulong monons
    vs_scalar_u64_recall m_cnt q_cnt
    put vs_meta add T_U64 it sub ulong monons t0

    t0 = ulong monons
    vs_worker_recall uchar 2 q_cnt M_NEON B_UNB_NE
    put vs_meta add T_NE it sub ulong monons t0

    t0 = ulong monons
    vs_worker_recall uchar 4 q_cnt M_SWAR B_UNB_SW
    put vs_meta add T_SW it sub ulong monons t0
  end

  vs_stop_worker

  m_sc = vs_median9 T_SC
  m_u64 = vs_median9 T_U64
  m_ne = vs_median9 T_NE
  m_sw = vs_median9 T_SW

  vs_out vs_t_m1
  vs_out_u m_sc
  vs_out vs_t_m2
  vs_out_u m_u64
  vs_out vs_t_m3
  vs_out_u m_ne
  vs_out vs_t_m4
  vs_out_u m_sw
  vs_out vs_t_sp1
  vs_print_ratio m_sc m_ne
  vs_out vs_t_sp2
  vs_print_ratio m_sw m_ne
  vs_out vs_t_sp3
  vs_print_ratio m_u64 m_ne
  vs_out vs_t_nl
end

fn vs_run_full_bench plen ulong has_out bool out_len ulong to void
  m_cnt = ulong 64
  q_cnt = ulong 64
  vs_pin_cpu5
  vs_init_codebook_and_queries m_cnt q_cnt
  vs_test_bind_perm
  vs_spawn_worker plen
  vs_worker_load_cb m_cnt
  vs_test_bundle m_cnt
  vs_test_container m_cnt has_out out_len
  vs_test_parity m_cnt q_cnt
  vs_bench_med9 m_cnt q_cnt
end

note ---- Negative Control Subcommands ----
fn vs_cmd_wrong_key to void
  m_cnt = ulong 64
  for m ulong m_cnt bound 65
    vs_gen_vec add B_CB m add 0x1000 m
  end
  vs_gen_vec B_KEYS 0x4000
  vs_gen_vec add B_KEYS 1 0x999999
  vs_bind_u64 B_KEYS add B_CB 5 B_BND
  vs_bind_u64 B_BND add B_KEYS 1 B_TMP_A

  best_d = ulong 999999
  sec_d = ulong 999999
  for m ulong m_cnt bound 65
    d = vs_hamming B_TMP_A add B_CB m
    if lt d best_d
      sec_d = best_d
      best_d = d
    else
      if lt d sec_d
        sec_d = d
      end
    end
  end
  gap = sub sec_d best_d
  if or gt best_d VSA_MARGIN_MAX lt gap VSA_MIN_GAP
    vs_out vs_t_wk1
    vs_out_u best_d
    vs_out vs_t_wk2
    vs_out_u gap
    vs_out vs_t_rp
    exit int VSA_ERR_MARGIN
  end
  vs_out vs_t_wk_err
  exit 0
end

fn vs_cmd_degen_guard mode ulong to void
  b0 = mul B_TMP_A VSA_WORDS
  for w ulong VSA_WORDS bound 161
    if eq mode 0
      put vs_vec add b0 w 0
    else
      put vs_vec add b0 w bitcast ulong long -1
    end
  end
  if vs_check_degen B_TMP_A
    vs_out vs_t_dg1
    vs_out_u mode
    vs_out vs_t_rp
    exit int VSA_ERR_DEGEN
  end
  exit 0
end

fn vs_parse_uint_arg2 n ulong to ulong
  if eq n 0
    exit int VSA_ERR_SIZE
  end
  acc = ulong 0
  for i ulong n bound 32
    c = ulong get vs_arg2 i
    if or lt c 48 gt c 57
      exit int VSA_ERR_SIZE
    end
    acc = add mul acc 10 sub c 48
  end
  ret acc
end

fn main to int
  ac = ulong argcnt
  if lt ac 2
    vs_out vs_t_use
    ret 2
  end
  cmd_len = ulong argread 1 vs_num_buf 0 32

  if vs_cmd_eq vs_c_bench cmd_len
    if lt ac 3
      ret 2
    end
    pr = argread 2 vs_path 0 4095
    if le pr 0
      ret 2
    end
    plen = ulong pr
    has_out = false
    olen = ulong 0
    if ge ac 4
      or_ = argread 3 vs_arg2 0 4095
      if gt or_ 0
        has_out = true
        olen = ulong or_
      end
    end
    vs_run_full_bench plen has_out olen
    ret 0
  end

  if vs_cmd_eq vs_c_wcb cmd_len
    if lt ac 3
      ret 2
    end
    pr = argread 2 vs_path 0 4095
    if le pr 0
      ret 2
    end
    plen = ulong pr
    for m ulong VSA_MAX_RECS bound 65
      vs_gen_vec add B_CB m add 0x1000 m
    end
    tot = vs_build_omvsa1 B_CB VSA_MAX_RECS
    vs_write_path plen tot
    vs_out vs_t_wro
    vs_out_u tot
    vs_out vs_t_nl
    ret 0
  end

  if vs_cmd_eq vs_c_vcb cmd_len
    if lt ac 3
      ret 2
    end
    pr = argread 2 vs_path 0 4095
    if le pr 0
      ret 2
    end
    plen = ulong pr
    fl = vs_read_path plen
    nr = vs_parse_verify_omvsa1 fl B_CB
    vs_out vs_t_ver
    vs_out_u nr
    vs_out vs_t_nl
    ret 0
  end

  if vs_cmd_eq vs_c_perm cmd_len
    if lt ac 3
      ret 2
    end
    sr = argread 2 vs_arg2 0 31
    if le sr 0
      ret int VSA_ERR_SHIFT
    end
    sh = vs_parse_uint_arg2 ulong sr
    vs_gen_vec B_TMP_A 0x7777
    vs_permute B_TMP_A B_TMP_B sh
    vs_unpermute B_TMP_B B_TMP_C sh
    if ne vs_hamming B_TMP_A B_TMP_C 0
      ret int VSA_ERR_PARITY
    end
    vs_out vs_t_prm
    vs_out_u sh
    vs_out vs_t_nl
    ret 0
  end

  if vs_cmd_eq vs_c_wkey cmd_len
    vs_cmd_wrong_key
    ret 0
  end

  if vs_cmd_eq vs_c_degen cmd_len
    mode = ulong 0
    if ge ac 3
      mr = argread 2 vs_arg2 0 31
      if gt mr 0
        mode = vs_parse_uint_arg2 ulong mr
      end
    end
    vs_cmd_degen_guard mode
    ret 0
  end

  vs_out vs_t_unk
  ret 2
end

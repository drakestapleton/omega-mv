note SPDX-License-Identifier: Apache-2.0
note apps/core/test.om: positive & negative control test suite for
note aienos.com site/CSP/consent verifier and interplane-forge/hop core validators.
note Compose with:
note   si/directives/om2.om om/tls/sha2.om apps/core/site_forge.om apps/core/test.om

text t_pass "PASS "
text t_fail "FAIL "
text t_nl "\n"

text t_c1 "aienos_csp_header_validation_and_unsafe_controls"
text t_c2 "aienos_route_sanitization_and_traversal_controls"
text t_c3 "aienos_consent_and_dnt_fail_closed_controls"
text t_c4 "forge_git_ref_validation_and_flag_injection_controls"
text t_c5 "forge_archive_extension_allowlist_controls"
text t_c6 "hop_frame_kind_cap_and_sequence_controls"
text t_c7 "app_manifest_digest_determinism_and_sensitivity"
text t_done "PASS apps-site-forge-hop all 7 test suites passed\n"

text t_csp_ok "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'"
text t_csp_nodef "script-src 'self'; object-src 'none'"
text t_csp_ui "default-src 'self'; script-src 'unsafe-inline'"
text t_csp_ue "default-src 'self'; script-src 'unsafe-eval'"
text t_csp_star "default-src 'self'; img-src *"
text t_csp_http "default-src 'self'; img-src http://example.com"

text t_rt_ok "/docs/omega/index.html"
text t_rt_ok2 "/evidence"
text t_rt_trav "/docs/../etc/passwd"
text t_rt_dbl "/docs//index.html"
text t_rt_hid "/.env"
text t_rt_pct "/docs/%2e%2e/secret"
text t_rt_rel "docs/index.html"

text t_ref_ok "main"
text t_ref_ok2 "releases/v1.0-alpha"
text t_ref_dash "--upload-pack=evil"
text t_ref_trav "refs/heads/a..b"
text t_ref_lock "refs/heads/main.lock"
text t_ref_space "bad ref"
text t_ref_tilde "HEAD~1"

text t_ext_tgz ".tar.gz"
text t_ext_zip ".zip"
text t_ext_rar ".rar"
text t_ext_sh ".sh"

fn report_case name view uchar * ok bool to int
if ok
w1 = app_write_all int 1 t_pass
w2 = app_write_all int 1 name
w3 = app_write_all int 1 t_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = app_write_all int 1 t_fail
w5 = app_write_all int 1 name
w6 = app_write_all int 1 t_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_csp to bool
if ne app_validate_csp t_csp_ok APP_OK
ret false
end
if ne app_validate_csp t_csp_nodef APP_ERR_CSP_MISSING_DEFAULT
ret false
end
if ne app_validate_csp t_csp_ui APP_ERR_CSP_UNSAFE
ret false
end
if ne app_validate_csp t_csp_ue APP_ERR_CSP_UNSAFE
ret false
end
if ne app_validate_csp t_csp_star APP_ERR_CSP_UNSAFE
ret false
end
if ne app_validate_csp t_csp_http APP_ERR_CSP_UNSAFE
ret false
end
ret true
end

fn test_routes to bool
if ne app_validate_route t_rt_ok APP_OK
ret false
end
if ne app_validate_route t_rt_ok2 APP_OK
ret false
end
if ne app_validate_route t_rt_trav APP_ERR_BAD_ROUTE
ret false
end
if ne app_validate_route t_rt_dbl APP_ERR_BAD_ROUTE
ret false
end
if ne app_validate_route t_rt_hid APP_ERR_BAD_ROUTE
ret false
end
if ne app_validate_route t_rt_pct APP_ERR_BAD_ROUTE
ret false
end
if ne app_validate_route t_rt_rel APP_ERR_BAD_ROUTE
ret false
end
ret true
end

fn test_consent to bool
if ne app_check_consent false false true APP_OK
ret false
end
if ne app_check_consent true true false APP_OK
ret false
end
note Negative controls: analytics without consent, or analytics with DNT=1
if ne app_check_consent true false false APP_ERR_CONSENT_VIOLATION
ret false
end
if ne app_check_consent true true true APP_ERR_CONSENT_VIOLATION
ret false
end
ret true
end

fn test_forge_refs to bool
if ne forge_validate_ref t_ref_ok APP_OK
ret false
end
if ne forge_validate_ref t_ref_ok2 APP_OK
ret false
end
if ne forge_validate_ref t_ref_dash APP_ERR_BAD_REF
ret false
end
if ne forge_validate_ref t_ref_trav APP_ERR_BAD_REF
ret false
end
if ne forge_validate_ref t_ref_lock APP_ERR_BAD_REF
ret false
end
if ne forge_validate_ref t_ref_space APP_ERR_BAD_REF
ret false
end
if ne forge_validate_ref t_ref_tilde APP_ERR_BAD_REF
ret false
end
ret true
end

fn test_forge_exts to bool
if ne forge_validate_ext t_ext_tgz APP_OK
ret false
end
if ne forge_validate_ext t_ext_zip APP_OK
ret false
end
if ne forge_validate_ext t_ext_rar APP_ERR_BAD_EXT
ret false
end
if ne forge_validate_ext t_ext_sh APP_ERR_BAD_EXT
ret false
end
ret true
end

fn test_hop_frames to bool
if ne hop_validate_frame HOP_KIND_DATA ulong 1024 ulong 4096 ulong 1 ulong 2 APP_OK
ret false
end
if ne hop_validate_frame ulong 0 ulong 10 ulong 4096 ulong 1 ulong 2 APP_ERR_FRAME_KIND
ret false
end
if ne hop_validate_frame HOP_KIND_DATA ulong 4097 ulong 4096 ulong 1 ulong 2 APP_ERR_FRAME_CAP
ret false
end
if ne hop_validate_frame HOP_KIND_DATA ulong 10 ulong 4096 ulong 5 ulong 5 APP_ERR_FRAME_SEQ
ret false
end
if ne hop_validate_frame HOP_KIND_DATA ulong 10 ulong 4096 ulong 5 ulong 4 APP_ERR_FRAME_SEQ
ret false
end
ret true
end

fn test_manifest_digest to bool
d1 = new uchar 32 0
d2 = new uchar 32 0
app_manifest_digest t_rt_ok t_csp_ok d1
app_manifest_digest t_rt_ok t_csp_ok d2
if not app_digest_eq d1 d2
ret false
end
app_manifest_digest t_rt_ok2 t_csp_ok d2
if app_digest_eq d1 d2
ret false
end
ret true
end

fn main to int
fail = int 0
fail = add fail report_case t_c1 test_csp
fail = add fail report_case t_c2 test_routes
fail = add fail report_case t_c3 test_consent
fail = add fail report_case t_c4 test_forge_refs
fail = add fail report_case t_c5 test_forge_exts
fail = add fail report_case t_c6 test_hop_frames
fail = add fail report_case t_c7 test_manifest_digest
if ne fail int 0
ret int 1
end
ok = app_write_all int 1 t_done
if not ok
ret int 1
end
ret int 0
end

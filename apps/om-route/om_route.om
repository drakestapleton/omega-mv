om2
note SPDX-License-Identifier: Apache-2.0
note apps/om-route/om_route.om: Sovereign Intelligence 1.0 Universal Pure-Omega Local Model Router.
note
note Zero C, zero Python, zero libc, zero hardcoded user paths, zero external network telemetry.
note
note Build:
note   seed/out/omc < apps/om-route/om_route.om > om_route && chmod +x om_route
note Run:
note   om_route MODELS.tsv [PORT] [--tz5 PATH] [--tz0 PATH] [--watts-override W]
note
note Features:
note   - Declarative TSV config (models.tsv) with fail-closed validation (loopback-only URLs, no duplicates).
note   - Dual API: OpenAI POST /v1/chat/completions (string & array-of-parts content, live SSE stream:true)
note     AND Anthropic POST /v1/messages (request translation + Anthropic JSON/SSE response translation),
note     plus GET /v1/models, GET /health, and OPTIONS CORS preflight.
note   - Single-process non-blocking multi-client pollfds event loop (up to 8 concurrent connections).
note   - Live fail-closed thermal & Watt admission reading Spark /sys/class/thermal/thermal_zone5/temp
note     (TGPU) and thermal_zone0/temp (TSOC) -> HTTP 503 thermal_budget_exceeded if over ceiling.
note   - Idle auto-unload timer for spawned GPU backends.
note   - Structured local-only TY-4+ request/energy/latency telemetry lines on stdout.

note ---- Constants
const MAX_MOD ulong 32
const MAX_SLOTS ulong 8
const SLOT_SZ ulong 65536
const LINE_SZ ulong 8192

note ---- Config storage (up to 32 models)
global g_cfg uchar 262144
global g_m_id_o ulong 32
global g_m_id_n ulong 32
global g_m_port ulong 32
global g_m_kind ulong 32
global g_m_idle ulong 32
global g_m_watt ulong 32
global g_m_tgpu ulong 32
global g_m_cmd_o ulong 32
global g_m_cmd_n ulong 32
global g_m_pid ulong 32
global g_m_last ulong 32

note ---- Per-slot non-blocking connection state (8 slots, 16 ulongs per slot)
note slot fields (base = slot * 16):
note   0=state(0=FREE,1=READ_REQ,2=SEND_BE,3=RELAY)  1=cfd  2=bfd  3=midx
note   4=api(0=openai,1=anthropic)  5=is_stream  6=req_len  7=hdr_end
note   8=need_len  9=bsend_off  10=bsend_len  11=brx_len
note   12=resp_hdr_done  13=anth_started  14=out_chunks  15=start_ns
global g_sl ulong 128
global g_sreq uchar 524288
global g_sbtx uchar 524288
global g_sbrx uchar 524288
global g_slin uchar 65536
global g_slin_n ulong 8
global g_srx_b ulong 8
global g_stx_b ulong 8

note ---- Scratch & I/O buffers
global g_pfd uchar 256
global g_pmap ulong 32
global g_pknd ulong 32
global g_tmp uchar 65536
global g_out uchar 131072
global g_log uchar 16384
global g_tz5_p uchar 512
global g_tz0_p uchar 512
global g_tbuf uchar 128
global g_pkt uchar 4096
global g_co ulong 16
global g_cn ulong 16
global g_pa uchar 4096
global g_ty ulong 4
note g_ty: 0=dt_ns, 1=rx_b, 2=tx_b

note ---- Global counters & state g_n[0..31]
note   0=cfg_len  1=nmod  2=port  3=lfd  4=hdr_seen  5=tz5_len  6=tz0_len
note   7=tgpu_mc  8=tsoc_mc  9=tgpu_ok  10=tsoc_ok  11=watts_ov  12=has_wov
note   13=req_seq  14=thermal_rej  15=idle_unloads  16=out_len  17=log_len
note   18=pa_len  19=est_mw  20=tmp_len
global g_n ulong 32


note apps/translate/lib.om: pure-Omega translation service core (converted from aien-translate).
note Composable OM-2 library unit (no om2 line, no fn main).
note Compose with: si/directives/om2.om om/tls/sha2.om apps/translate/lib.om <main.om|test.om>
note
note Implements:
note   - ISO-639 and translate.js allowlist validator for all 31 supported languages + auto source
note   - Strict RFC 3629 UTF-8 validator, codepoint counter, and NUL/size payload guards
note   - UTF-8-aware paragraph/sentence/word chunker (never splits multi-byte code points)
note   - Lead/core/trail splitter preserving whitespace and split URL edge fragments (split_ws)
note   - Protected-token & keep-list translation guard (URLs, code spans, placeholders, tags, keep words)
note   - Deterministic SHA-256 keyed bounded LRU cache (keyed by prompt_ver/model/src/dst/text)
note   - Strict JSONL request parser and escaped JSONL response serializer

const TR_MAX_BYTES ulong 16384
const TR_MAX_CHARS ulong 3000
const TR_MAX_TEXTS ulong 40
const TR_MAX_CHUNKS ulong 64

const TR_LANG_COUNT ulong 31
const TR_LANG_AUTO ulong 31
const TR_LANG_INVALID ulong 255

const TR_OK ulong 0
const TR_ERR_EMPTY ulong 1
const TR_ERR_OVERSIZE ulong 2
const TR_ERR_UTF8 ulong 3
const TR_ERR_NUL ulong 4
const TR_ERR_LANG ulong 5
const TR_ERR_JSON ulong 6
const TR_ERR_GUARD ulong 7
const TR_ERR_CHUNK ulong 8

const TR_CACHE_MAX_SLOTS ulong 32
const TR_CACHE_VAL_CAP ulong 512

note Cache globals (bounded LRU, full 32-byte SHA-256 keys)
global tr_g_cache_cap ulong 1
global tr_g_cache_used ulong 32
global tr_g_cache_tick ulong 32
global tr_g_cache_clock ulong 1
global tr_g_cache_key uchar 1024
global tr_g_cache_src ulong 32
global tr_g_cache_dst ulong 32
global tr_g_cache_vlen ulong 32
global tr_g_cache_val uchar 16384
global tr_g_cache_hits ulong 1
global tr_g_cache_misses ulong 1
global tr_g_cache_evicts ulong 1
global tr_g_cache_cnt ulong 1

note Chunker & split_ws output globals
global tr_g_chk_off ulong 64
global tr_g_chk_len ulong 64
global tr_g_chk_cnt ulong 1
global tr_g_sw_lead ulong 1
global tr_g_sw_core_end ulong 1

note Parsed request globals
global tr_g_req_from uchar 64
global tr_g_req_from_len ulong 1
global tr_g_req_to uchar 64
global tr_g_req_to_len ulong 1
global tr_g_req_model uchar 64
global tr_g_req_model_len ulong 1
global tr_g_req_text uchar 16385
global tr_g_req_text_len ulong 1
global tr_g_req_maxc ulong 1

note Scratch & JSONL response globals
global tr_g_key_buf uchar 32
global tr_g_tmp_out uchar 1024
global tr_g_tmp_out_len ulong 1
global tr_g_resp uchar 32768
global tr_g_resp_len ulong 1
global tr_g_item_buf uchar 1024
global tr_g_item_len ulong 1


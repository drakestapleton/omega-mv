note apps/translate/main.om: CLI reading JSONL translation requests on stdin
note and writing chunked/cached JSONL responses on stdout.
note Compose with: si/directives/om2.om om/tls/sha2.om apps/translate/lib.om apps/translate/main.om

global tr_m_in uchar 4096
global tr_m_line uchar 16385

fn tr_write_all fd int n ulong to bool
off = ulong 0
while lt off n bound 4096
w = write fd tr_g_resp off sub n off
if le w 0
ret false
end
off = add off ulong w
end
ret true
end

fn tr_flush_line llen ulong over bool to bool
if over
tr_resp_error TR_ERR_OVERSIZE
ret tr_write_all 1 get tr_g_resp_len 0
end
if eq llen 0
ret true
end
lbuf = new uchar 16385 0
i = ulong 0
while lt i llen bound 16385
put lbuf i get tr_m_line i
i = add i 1
end
rc = tr_handle_request part lbuf 0 llen llen
if eq rc TR_OK
ret tr_write_all 1 get tr_g_resp_len 0
end
ret tr_write_all 1 get tr_g_resp_len 0
end

fn main to int
tr_cache_init 32
llen = ulong 0
over = false
done = false
while not done bound 100000
n = read 0 tr_m_in 0 4096
if lt n 0
ret 1
end
if eq n 0
if or gt llen 0 over
if not tr_flush_line llen over
ret 2
end
end
done = true
break
end
rn = ulong n
i = ulong 0
while lt i rn bound 4096
b = get tr_m_in i
if eq b 10
if not tr_flush_line llen over
ret 2
end
llen = 0
over = false
else
if ne b 13
if lt llen TR_MAX_BYTES
put tr_m_line llen b
llen = add llen 1
else
over = true
end
end
end
i = add i 1
end
end
ret 0
end

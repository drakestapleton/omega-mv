note apps/translate/test.om: comprehensive pure-Omega test suite for aien-translate core.
note Compose with: si/directives/om2.om om/tls/sha2.om apps/translate/lib.om apps/translate/test.om

text tt_pass_all "PASS apps/translate: all 10 test suites passed (positive + negative controls)\n"
text tt_fail_pre "FAIL apps/translate: check "
text tt_nl "\n"

text tt_l_en "en"
text tt_l_eng "English"
text tt_l_zhcn "zh-CN"
text tt_l_zhtw "chinese_traditional"
text tt_l_ja "ja"
text tt_l_de "DEUTSCH"
text tt_l_ms "  ms  "
text tt_l_auto "auto"
text tt_l_bad "klingon"
text tt_l_bad2 "zz"

text tt_src_keep "Aien runs on Aienux with Omega at https://aienos.com/docs. Run `aien start` for {user} and <g1>docs</g1> %s."
text tt_trn_ok "Aien fonctionne sur Aienux avec Omega sur https://aienos.com/docs. Lancez `aien start` pour {user} et <g1>doku</g1> %s."
text tt_trn_lost_keep "艾恩 fonctionne sur Aienux avec Omega sur https://aienos.com/docs. Lancez `aien start` pour {user} et <g1>doku</g1> %s."
text tt_trn_lost_url "Aien fonctionne sur Aienux avec Omega. Lancez `aien start` pour {user} et <g1>doku</g1> %s."
text tt_trn_lost_tag "Aien fonctionne sur Aienux avec Omega sur https://aienos.com/docs. Lancez `aien start` pour {user} et doku %s."
text tt_src_subword "AIENOS boots cleanly."
text tt_trn_subword "AIENOS demarre proprement."
text tt_tidy_src "Run aien start"
text tt_tidy_trn "  Fuhren Sie `aien start` aus  "
text tt_tidy_exp "Fuhren Sie aien start aus"
text tt_sw_link "  Read the docs at https:  "

text tt_lc_ok "sure: [\"a\", \"b ] c\"] trailing"
text tt_lc_open "[\"a\", \"b ] still inside\""

text tt_req_ok "{\"from\":\"en\",\"to\":\"ja\",\"text\":\"Hello world. Second sentence!\",\"max_chunk\":16}"
text tt_req_bad_lang "{\"from\":\"en\",\"to\":\"xx\",\"text\":\"Hello\"}"
text tt_req_empty "{\"from\":\"en\",\"to\":\"ja\",\"text\":\"   \"}"
text tt_req_bad_json "{\"from\":\"en\",\"to\":\"ja\""

text tt_c_a "alpha"
text tt_c_b "beta"
text tt_c_c "gamma"
text tt_c_d "delta"
text tt_c_va "ALPHA_JA"
text tt_c_vb "BETA_JA"
text tt_c_vc "GAMMA_JA"
text tt_c_vd "DELTA_JA"

fn tt_write_text s view uchar * to void
n = len s
w = write 1 s 0 n
if lt w 0
exit 99
end
end

fn tt_fail code ulong to int
tt_write_text tt_fail_pre
buf = new uchar 24 0
x = code
k = ulong 0
if eq x 0
put buf 0 48
k = 1
else
while gt x 0 bound 24
put buf k uchar add 48 rem x 10
x = div x 10
k = add k 1
end
end
outb = new uchar 24 0
j = ulong 0
while lt j k bound 24
put outb j get buf sub sub k 1 j
j = add j 1
end
w = write 1 outb 0 k
if lt w 0
exit 99
end
tt_write_text tt_nl
ret int code
end

fn tt_put_tmp s view uchar * to void
n = len s
i = ulong 0
while lt i n bound 512
put tr_g_tmp_out i get s i
i = add i 1
end
put tr_g_tmp_out_len 0 n
end

fn tt_tmp_eq s view uchar * to bool
n = len s
if ne get tr_g_tmp_out_len 0 n
ret false
end
i = ulong 0
while lt i n bound 512
if ne get tr_g_tmp_out i get s i
ret false
end
i = add i 1
end
ret true
end

note Check 1: ISO-639 and translate.js language allowlist validation + negative controls
fn test_langs to bool
if ne tr_lang_find tt_l_en 0 len tt_l_en 0
ret false
end
if ne tr_lang_find tt_l_eng 0 len tt_l_eng 0
ret false
end
if ne tr_lang_find tt_l_zhcn 0 len tt_l_zhcn 1
ret false
end
if ne tr_lang_find tt_l_zhtw 0 len tt_l_zhtw 2
ret false
end
if ne tr_lang_find tt_l_ja 0 len tt_l_ja 3
ret false
end
if ne tr_lang_find tt_l_de 0 len tt_l_de 7
ret false
end
if ne tr_lang_find tt_l_ms 0 len tt_l_ms 30
ret false
end
if ne tr_lang_find_src tt_l_auto 0 len tt_l_auto TR_LANG_AUTO
ret false
end
note Negative controls: unsupported language codes refused
if ne tr_lang_find tt_l_bad 0 len tt_l_bad TR_LANG_INVALID
ret false
end
if ne tr_lang_find tt_l_bad2 0 len tt_l_bad2 TR_LANG_INVALID
ret false
end
if ne tr_lang_find tt_l_auto 0 len tt_l_auto TR_LANG_INVALID
ret false
end
ret true
end

note Check 2: Multi-byte UTF-8 (1/2/3/4-byte code points) validation & codepoint counting
fn test_utf8_valid_multi to bool
note Build: "A" (1B) + e-acute (c3 a9, 2B) + CJK "日" (e6 97 a5, 3B) + emoji U+1F600 (f0 9f 98 80, 4B) = 10 bytes, 4 chars
b = new uchar 16 0
put b 0 65
put b 1 0xc3
put b 2 0xa9
put b 3 0xe6
put b 4 0x97
put b 5 0xa5
put b 6 0xf0
put b 7 0x9f
put b 8 0x98
put b 9 0x80
if ne tr_validate_text b 10 TR_OK
ret false
end
if ne tr_utf8_chars b 10 4
ret false
end
ret true
end

note Check 3: Negative controls for UTF-8, NUL, overlong, surrogate, >U+10FFFF, truncated
fn test_utf8_refusals to bool
b = new uchar 16 0
note 3a: NUL byte embedded
put b 0 65
put b 1 0
put b 2 66
if ne tr_validate_text b 3 TR_ERR_NUL
ret false
end
note 3b: Overlong 2-byte sequence (0xc0 0xaf)
put b 0 0xc0
put b 1 0xaf
if ne tr_validate_text b 2 TR_ERR_UTF8
ret false
end
note 3c: UTF-16 surrogate U+D800 (0xed 0xa0 0x80)
put b 0 0xed
put b 1 0xa0
put b 2 0x80
if ne tr_validate_text b 3 TR_ERR_UTF8
ret false
end
note 3d: Codepoint > U+10FFFF (0xf4 0x90 0x80 0x80)
put b 0 0xf4
put b 1 0x90
put b 2 0x80
put b 3 0x80
if ne tr_validate_text b 4 TR_ERR_UTF8
ret false
end
note 3e: Truncated 4-byte emoji (3 of 4 bytes)
put b 0 0xf0
put b 1 0x9f
put b 2 0x98
if ne tr_validate_text b 3 TR_ERR_UTF8
ret false
end
note 3f: Stray continuation byte
put b 0 0x80
if ne tr_validate_text b 1 TR_ERR_UTF8
ret false
end
ret true
end

note Check 4: UTF-8 chunker NEVER splits 2/3/4-byte code points even under tight max_chunk=5
fn test_utf8_chunker_boundaries to bool
note 14 bytes: 2B(c3 a9) + 3B(e6 97 a5) + 4B(f0 9f 98 80) + 3B(e3 80 82 "。") + 2B(c3 bc)
b = new uchar 32 0
put b 0 0xc3
put b 1 0xa9
put b 2 0xe6
put b 3 0x97
put b 4 0xa5
put b 5 0xf0
put b 6 0x9f
put b 7 0x98
put b 8 0x80
put b 9 0xe3
put b 10 0x80
put b 11 0x82
put b 12 0xc3
put b 13 0xbc
if ne tr_chunk_utf8 b 14 5 TR_OK
ret false
end
cnt = get tr_g_chk_cnt 0
if lt cnt 3
ret false
end
note Verify every chunk is <= 5 bytes, contiguous, covers all 14 bytes, and is strictly valid UTF-8!
tot = ulong 0
k = ulong 0
while lt k cnt bound 64
off = get tr_g_chk_off k
clen = get tr_g_chk_len k
if ne off tot
ret false
end
if or eq clen 0 gt clen 5
ret false
end
if not tr_utf8_valid part b off clen clen
ret false
end
tot = add tot clen
k = add k 1
end
if ne tot 14
ret false
end
note Negative control: max_chunk < 4 must be refused
if ne tr_chunk_utf8 b 14 3 TR_ERR_CHUNK
ret false
end
ret true
end

note Check 5: Paragraph & sentence boundary preference in chunker
fn test_chunker_para_sent to bool
note "First para.\n\nSecond para!" (25 bytes), max_chunk=16 -> splits cleanly after \n\n at byte 13
b = new uchar 32 0
put b 0 70
put b 1 105
put b 2 114
put b 3 115
put b 4 116
put b 5 32
put b 6 112
put b 7 97
put b 8 114
put b 9 97
put b 10 46
put b 11 10
put b 12 10
put b 13 83
put b 14 101
put b 15 99
put b 16 111
put b 17 110
put b 18 100
put b 19 32
put b 20 112
put b 21 97
put b 22 114
put b 23 97
put b 24 33
if ne tr_chunk_utf8 b 25 16 TR_OK
ret false
end
if ne get tr_g_chk_cnt 0 2
ret false
end
if ne get tr_g_chk_off 0 0
ret false
end
if ne get tr_g_chk_len 0 13
ret false
end
if ne get tr_g_chk_off 1 13
ret false
end
if ne get tr_g_chk_len 1 12
ret false
end
ret true
end

note Check 6: Oversize payload (> 16384 bytes and > 3000 chars) strictly refused
fn test_oversize_refusal to bool
bigb = new uchar 16385 65
if ne tr_validate_text bigb 16385 TR_ERR_OVERSIZE
ret false
end
if ne tr_validate_text bigb 3001 TR_ERR_OVERSIZE
ret false
end
if ne tr_validate_text bigb 3000 TR_OK
ret false
end
ret true
end

note Check 7: Deterministic SHA-256 LRU cache hit, miss, and bounded eviction
fn test_cache_lru to bool
tr_cache_init 3
note Put A, B, C (fills cap=3, 0 evictions)
tt_put_tmp tt_c_va
tr_cache_put 0 3 tt_c_a len tt_c_a
tt_put_tmp tt_c_vb
tr_cache_put 0 3 tt_c_b len tt_c_b
tt_put_tmp tt_c_vc
tr_cache_put 0 3 tt_c_c len tt_c_c
if ne get tr_g_cache_evicts 0 0
ret false
end
note Touch A so B becomes least-recently-used!
if ne tr_cache_get 0 3 tt_c_a len tt_c_a 1
ret false
end
if not tt_tmp_eq tt_c_va
ret false
end
note Put D -> must evict B (LRU), keeping A, C, D!
tt_put_tmp tt_c_vd
tr_cache_put 0 3 tt_c_d len tt_c_d
if ne get tr_g_cache_evicts 0 1
ret false
end
note B must now miss; A, C, D must hit!
if ne tr_cache_get 0 3 tt_c_b len tt_c_b 0
ret false
end
if ne tr_cache_get 0 3 tt_c_a len tt_c_a 1
ret false
end
if ne tr_cache_get 0 3 tt_c_c len tt_c_c 1
ret false
end
if not tt_tmp_eq tt_c_vc
ret false
end
if ne tr_cache_get 0 3 tt_c_d len tt_c_d 1
ret false
end
if not tt_tmp_eq tt_c_vd
ret false
end
note Different target lang (dst=6 French instead of dst=3 Japanese) must miss for A!
if ne tr_cache_get 0 6 tt_c_a len tt_c_a 0
ret false
end
ret true
end

note Check 8: Guard checks (keep-list, URL, backticks, placeholders, inline tags, runaway)
fn test_guard to bool
if ne tr_guard_check tt_src_keep len tt_src_keep tt_trn_ok len tt_trn_ok TR_OK
ret false
end
note Negative control: dropped keep word "Aien" must be refused
if ne tr_guard_check tt_src_keep len tt_src_keep tt_trn_lost_keep len tt_trn_lost_keep TR_ERR_GUARD
ret false
end
note Negative control: dropped URL must be refused
if ne tr_guard_check tt_src_keep len tt_src_keep tt_trn_lost_url len tt_trn_lost_url TR_ERR_GUARD
ret false
end
note Negative control: dropped <g1> inline tag must be refused
if ne tr_guard_check tt_src_keep len tt_src_keep tt_trn_lost_tag len tt_trn_lost_tag TR_ERR_GUARD
ret false
end
note Subword check: AIEN inside AIENOS is NOT falsely protected as separate word
if ne tr_guard_check tt_src_subword len tt_src_subword tt_trn_subword len tt_trn_subword TR_OK
ret false
end
note Runaway length check: 100 chars for 2-char source ("hi") > 2*4 + 80 = 88 -> refused
hi = new uchar 2 104
runaway = new uchar 100 97
if ne tr_guard_check hi 2 runaway 100 TR_ERR_GUARD
ret false
end
ret true
end

note Check 9: Tidy & split_ws & list_closed
fn test_helpers to bool
w = tr_tidy tt_tidy_src len tt_tidy_src tt_tidy_trn len tt_tidy_trn
if ne w len tt_tidy_exp
ret false
end
if not tt_tmp_eq tt_tidy_exp
ret false
end
tr_split_ws tt_sw_link len tt_sw_link
note "  Read the docs at https:  " -> lead=2, core_end=18 ("Read the docs at")
if ne get tr_g_sw_lead 0 2
ret false
end
if ne get tr_g_sw_core_end 0 18
ret false
end
if not tr_list_closed tt_lc_ok len tt_lc_ok
ret false
end
if tr_list_closed tt_lc_open len tt_lc_open
ret false
end
ret true
end

note Check 10: End-to-end JSONL request handling (cache miss then cache hit + negative refusals)
fn test_jsonl_pipeline to bool
tr_cache_init 16
note First request: 3 chunks ("Hello world.", " Second ", "sentence!"), all 3 miss cache
rc1 = tr_handle_request tt_req_ok len tt_req_ok
if ne rc1 TR_OK
ret false
end
if ne get tr_g_chk_cnt 0 3
ret false
end
if ne get tr_g_cache_misses 0 3
ret false
end
if ne get tr_g_cache_hits 0 0
ret false
end
note Second identical request: all 3 chunks HIT cache!
rc2 = tr_handle_request tt_req_ok len tt_req_ok
if ne rc2 TR_OK
ret false
end
if ne get tr_g_cache_hits 0 3
ret false
end
note Negative control: unsupported language code
if ne tr_handle_request tt_req_bad_lang len tt_req_bad_lang TR_ERR_LANG
ret false
end
note Negative control: empty/whitespace text
if ne tr_handle_request tt_req_empty len tt_req_empty TR_ERR_EMPTY
ret false
end
note Negative control: malformed JSON
if ne tr_handle_request tt_req_bad_json len tt_req_bad_json TR_ERR_JSON
ret false
end
ret true
end

fn main to int
if not test_langs
ret tt_fail 1
end
if not test_utf8_valid_multi
ret tt_fail 2
end
if not test_utf8_refusals
ret tt_fail 3
end
if not test_utf8_chunker_boundaries
ret tt_fail 4
end
if not test_chunker_para_sent
ret tt_fail 5
end
if not test_oversize_refusal
ret tt_fail 6
end
if not test_cache_lru
ret tt_fail 7
end
if not test_guard
ret tt_fail 8
end
if not test_helpers
ret tt_fail 9
end
if not test_jsonl_pipeline
ret tt_fail 10
end
tt_write_text tt_pass_all
ret 0
end

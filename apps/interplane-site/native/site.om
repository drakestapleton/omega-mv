text tmonths "janfebmaraprmayjunjulaugsepoctnovdec"
text vprows "papers.rows"
text vpcount "papers.count"
text vpasof "papers.asof"
text vporcid "papers.orcid"
text vpsha "papers.sha256"
text vpnsrc "papers.sources"
text vpjson "papers.json"
text vpbib "papers.bib"
text mpap "papers: records "
text mpsrc " sources "

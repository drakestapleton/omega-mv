fn cssload to void
note obuf = public/style.css
mark = sg TOP
pbset fcss
off = slurp
put st OBN 0
om off sg FLEN
put st TOP mark
end

note ---- the yard: content/yard.snapshot.tsv, a snapshot of the public project registry

fn yardrow to void
note fb holds name, rid, branch, head, recorded time of one snapshot row
ot y1
om sg OWNO sg OWNL
ob 47
om fg 0 sub fg 1 fg 0
ot y2
om fg 0 sub fg 1 fg 0
ot y3
om fg 2 sub fg 3 fg 2
ot y4
om fg 6 8
ot y5
om fg 8 10
ot y6
end

fn yardok to bool
if not okset fg 0 fg 1 1
ret false
end
if not okset fg 2 fg 3 4
ret false
end
if not okset fg 4 fg 5 1
ret false
end
if ne sub fg 7 fg 6 40
ret false
end
if not okset fg 6 fg 7 2
ret false
end
if ne sub fg 9 fg 8 20
ret false
end
ret okset fg 8 fg 9 3
end

fn yard to void
pbset fyard
put st CXO keep fyard
put st CXL len fyard
off = slurp
n = sg FLEN
hashm off n
ho = hxkeep
setv vysha ho 64
say myard
lim = add off n
count = ulong 0
put st OBN 0
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
nf = split i e 9
if eq nf 2
if fbis 0 kasof
if not okset fg 2 fg 3 3
die eryard
end
setv vyasof fg 2 sub fg 3 fg 2
else
if not fbis 0 kowner
die eryard
end
if not okset fg 2 fg 3 1
die eryard
end
put st OWNO fg 2
put st OWNL sub fg 3 fg 2
end
else
if or ne nf 5 eq sg OWNL 0
die eryard
end
if not yardok
die eryard
end
yardrow
count = add count 1
end
end
end
i = add e 1
end
if or eq count 0 not vset vyasof
die eryard
end
ro = stash
setv vyrows ro sg FLEN
onum count
co = stash
setv vycount co sg FLEN
sayn count
say mysha
sayhx
say tnl
end

note ---- papers: content/papers.snapshot holds the Zenodo records of one ORCID iD, written by
note scripts/fetch-papers.sh; content/papers.sources names the papers whose source is an Interplane
note project. Header lines: orcid, fetched, response (one or more, numbered from 1), records. Then one
note block per record, newest first, fields in this order: record concept title date type [version]
note license creator.. orcid_attached file.. [related..]. The builder reads files only; no network.
note Record table pr, 32 slots per record: 0,1 DOI; 2,3 concept DOI; 4,5 title; 6 date; 8,9 type;
note 10,11 version (length 0: none); 12,13 licence; 14 ORCID attached; 16,17 block start and end;
note 18,19 Interplane source address (length 0: none). Pairs are arena offset and length.

text fpapers "content/papers.snapshot"
text fpsrc "content/papers.sources"
text erpap "content/papers.snapshot has a missing, unknown, out-of-order or malformed line"
text erpdoi "content/papers.snapshot: a DOI must be 10.5281/zenodo. followed by digits"
text erptit "content/papers.snapshot: a record has no title"
text erpesc "content/papers.snapshot: an escaped character that the builder cannot write"
text erpord "content/papers.snapshot: records must run newest first, as many as the records line says"
text erpsrc "content/papers.sources: a line must name a record of the snapshot, an interplane.io address and the checksum of one of that record's files"
text erpdup "content/papers.snapshot: a record DOI or a concept DOI appears twice"
text kprec "record"
text kpcon "concept"
text kptit "title"
text kpdate "date"
text kptype "type"
text kpver "version"
text kplic "license"
text kpcre "creator"
text kpatt "orcid_attached"
text kpfile "file"
text kprel "related"
text kporc "orcid"
text kpfet "fetched"
text kpresp "response"
text kprecs "records"
text kpsrc "source"

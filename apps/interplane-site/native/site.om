note ---- accessors: one global load per expression keeps every function inside the register pool

fn mg i ulong to uchar
ret get mem i
end

fn og i ulong to uchar
ret get obuf i
end

fn sg k ulong to ulong
ret get st k
end

fn fg k ulong to ulong
ret get fb k
end

fn rg k ulong to ulong
ret get rt k
end

fn vg k ulong to ulong
ret get vars k
end

fn cg k ulong to ulong
ret get rcs k
end

note ---- terminal output

fn sayfd fd int t view uchar * to void
p = ulong 0
while lt p len t bound 1048576
k = write fd t p sub len t p
if le k 0
exit 1
end
p = add p ulong k
end
end

fn say t view uchar * to void
sayfd 1 t
end

fn sayerr t view uchar * to void
sayfd 2 t
end

fn saym off ulong n ulong to void
p = ulong 0
while lt p n bound 16777216
k = write 1 mem add off p sub n p
if le k 0
exit 1
end
p = add p ulong k
end
end

fn sayob off ulong n ulong to void
p = ulong 0
while lt p n bound 16777216
k = write 1 obuf add off p sub n p
if le k 0
exit 1
end
p = add p ulong k
end
end

fn sayhx to void
k = write 1 hx 0 64
if ne k 64
exit 1
end
end

fn sayn v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
if eq x 0
i = 19
put d 19 48
end
while gt x 0 bound 20
i = sub i 1
put d i uchar add 48 rem x 10
x = div x 10
end
k = write 1 d i sub 20 i
if le k 0
exit 1
end
end

fn die m view uchar * to void
sayerr tfail
sayerr m
sayerr tnl
n = sg CXL
if gt n 0
sayerr tin
k = write 2 mem sg CXO n
sayerr tnl
end
exit 1
end

fn dieat m view uchar * pos ulong to void
sayerr tfail
sayerr m
sayerr tnl
n = sg CXL
if gt n 0
sayerr tin
k = write 2 mem sg CXO n
sayerr tnl
end
sayerr tnear
lim = sg OBN
s = pos
if gt s 24
s = sub s 24
else
s = 0
end
e = add pos 72
if gt e lim
e = lim
end
i = s
while lt i e bound 128
c = og i
if or lt c 32 gt c 126
c = 32
end
put sy sub i s c
i = add i 1
end
if gt e s
k = write 2 sy 0 sub e s
end
sayerr tnl
exit 1
end

note ---- path buffer pb

fn pbset t view uchar * to void
for j ulong len t bound 2048
put pb j get t j
end
put st PBL len t
end

fn pbadd t view uchar * to void
n = sg PBL
if gt add n len t 2000
die erpath
end
for j ulong len t bound 2048
put pb add n j get t j
end
put st PBL add n len t
end

fn pbaddm off ulong k ulong to void
n = sg PBL
if gt add n k 2000
die erpath
end
for j ulong k bound 2048
put pb add n j mg add off j
end
put st PBL add n k
end

fn pbroot site ulong to void
note pb = the site's output root, with no trailing slash
if eq site 0
n = sg R0L
for j ulong n bound 512
put pb j get root0 j
end
put st PBL n
else
n = sg R1L
for j ulong n bound 512
put pb j get root1 j
end
put st PBL n
end
end

fn rootlen site ulong to ulong
if eq site 0
ret sg R0L
end
ret sg R1L
end

note ---- files

fn isfile to bool
fd = fopen pb 0 sg PBL 34816 0
if lt fd 0
ret false
end
r = fclose int fd
ret true
end

fn slurp to ulong
note loads the regular file named by pb into the arena; returns its offset, st FLEN its length.
note readlnk gives -22 for a path that is not a symbolic link; 34816 is O_RDONLY, O_NONBLOCK and
note O_NOFOLLOW on Linux AArch64, so a final-component link or a FIFO cannot stand in for a file.
p = readlnk pb 0 sg PBL sy 0 1024
if ne p -22
die erread
end
fd = fopen pb 0 sg PBL 34816 0
if lt fd 0
die erread
end
base = sg TOP
if gt add base FCAP MEMSZ
die erfull
end
tot = ulong 0
k = long 1
while gt k 0 bound 4194304
if ge tot FCAP
break
end
k = read int fd mem add base tot sub FCAP tot
if gt k 0
tot = add tot ulong k
end
end
r = fclose int fd
if lt k 0
die erread
end
if or eq tot 0 ge tot FCAP
die erread
end
put st TOP add base tot
put st FLEN tot
ret base
end

fn wrraw to void
note writes obuf to the new file named by pb. 193 is O_WRONLY, O_CREAT and O_EXCL.
fd = fopen pb 0 sg PBL 193 420
if lt fd 0
die erwrite
end
p = ulong 0
n = sg OBN
while lt p n bound 4194304
k = write int fd obuf p sub n p
if le k 0
r = fclose int fd
die erwrite
end
p = add p ulong k
end
r = fsync int fd
if ne r 0
die erwrite
end
r = fclose int fd
if ne r 0
die erwrite
end
end

fn mkpar site ulong to void
note creates every directory above the file named by pb, below the site root
n = sg PBL
i = add rootlen site 1
while lt i n bound 2048
if eq get pb i 47
k = makedir pb 0 i 493
if lt k 0
if ne k -17
die erdir
end
end
end
i = add i 1
end
end

note ---- output buffer obuf

fn ob c uchar to void
n = sg OBN
if ge n OBSZ
die erbig
end
put obuf n c
put st OBN add n 1
end

fn ot t view uchar * to void
for j ulong len t bound 1048576
ob get t j
end
end

fn om off ulong n ulong to void
for j ulong n bound 16777216
ob mg add off j
end
end

fn oesc off ulong n ulong to void
for j ulong n bound 16777216
c = mg add off j
if eq c 38
ot hamp
else
if eq c 60
ot hlt
else
if eq c 62
ot hgt
else
if eq c 34
ot hquot
else
ob c
end
end
end
end
end
end

fn onum v ulong to void
d = new uchar 20 0
i = ulong 20
x = v
if eq x 0
i = 19
put d 19 48
end
while gt x 0 bound 20
i = sub i 1
put d i uchar add 48 rem x 10
x = div x 10
end
while lt i 20 bound 20
ob get d i
i = add i 1
end
end

fn ohx to void
for j ulong 64
ob get hx j
end
end

fn stash to ulong
note moves obuf into the arena; returns its offset, st FLEN its length
base = sg TOP
n = sg OBN
if gt add base n MEMSZ
die erfull
end
for j ulong n bound 16777216
put mem add base j og j
end
put st TOP add base n
put st FLEN n
put st OBN 0
ret base
end

fn keep t view uchar * to ulong
base = sg TOP
if gt add base len t MEMSZ
die erfull
end
for j ulong len t bound 1048576
put mem add base j get t j
end
put st TOP add base len t
ret base
end

note ---- SHA-256 (native/lib/sha2.om) of arena or output bytes, as 64 hex digits in hx

fn hexc v ulong to uchar
if lt v 10
ret uchar add 48 v
end
ret uchar add 87 v
end

fn hxput d view uchar 32 to void
for j ulong 32
b = ulong get d j
put hx mul j 2 hexc shr b 4
put hx add mul j 2 1 hexc and b 15
end
end

fn hashm off ulong n ulong to void
c = new ulong 40 0
t = new uchar 4096 0
d = new uchar 32 0
sha256_init c
done = ulong 0
while lt done n bound 16777216
k = sub n done
if gt k 4096
k = 4096
end
for j ulong k bound 4096
put t j mg add add off done j
end
sha256_update c part t 0 k
done = add done k
end
sha256_final c d
hxput d
end

fn hasho to void
c = new ulong 40 0
t = new uchar 4096 0
d = new uchar 32 0
sha256_init c
n = sg OBN
done = ulong 0
while lt done n bound 16777216
k = sub n done
if gt k 4096
k = 4096
end
for j ulong k bound 4096
put t j og add done j
end
sha256_update c part t 0 k
done = add done k
end
sha256_final c d
hxput d
end

fn hxkeep to ulong
note copies hx into the arena; returns its offset (64 bytes)
base = sg TOP
if gt add base 64 MEMSZ
die erfull
end
for j ulong 64
put mem add base j get hx j
end
put st TOP add base 64
ret base
end

fn hxis off ulong to bool
note hx equals the 64 arena bytes at off
for j ulong 64
if ne get hx j mg add off j
ret false
end
end
ret true
end

note ---- placeholders

fn mcmp a ulong b ulong n ulong to bool
for j ulong n bound 16777216
if ne mg add a j mg add b j
ret false
end
end
ret true
end

fn mist off ulong n ulong t view uchar * to bool
note arena bytes off..off+n equal the text t
if ne n len t
ret false
end
for j ulong n bound 1048576
if ne mg add off j get t j
ret false
end
end
ret true
end

fn mistf off ulong t view uchar * fold bool to bool
note the arena bytes at off start with the text t; fold compares their lower case with t
for j ulong len t bound 4096
c = mg add off j
if fold
c = low c
end
if ne c get t j
ret false
end
end
ret true
end

fn mhas off ulong n ulong t view uchar * fold bool to bool
note arena off..off+n holds the text t somewhere
pl = len t
if gt pl n
ret false
end
last = sub n pl
i = ulong 0
while le i last bound 4194304
if mistf add off i t fold
ret true
end
i = add i 1
end
ret false
end

fn mfind off ulong n ulong po ulong pl ulong to bool
note arena off..off+n holds the arena bytes po..po+pl somewhere
if or eq pl 0 gt pl n
ret false
end
last = sub n pl
i = ulong 0
while le i last bound 4194304
if mcmp add off i po pl
ret true
end
i = add i 1
end
ret false
end

fn fewdig vo ulong vl ulong to bool
note fewer than six different bytes: a placeholder such as all zeros, not a real fingerprint
seen = new uchar 256 0
d = ulong 0
for j ulong vl bound 128
c = ulong mg add vo j
if eq get seen c 0
put seen c 1
d = add d 1
end
end
ret lt d 6
end

fn setvm ko ulong kl ulong vo ulong vl ulong to void
n = sg NV
if ge n 512
die ervars
end
b = mul n 4
put vars b ko
put vars add b 1 kl
put vars add b 2 vo
put vars add b 3 vl
put st NV add n 1
end

fn setv k view uchar * vo ulong vl ulong to void
ko = keep k
setvm ko len k vo vl
end

fn setvt k view uchar * v view uchar * to void
vo = keep v
setv k vo len v
end

fn findv off ulong n ulong to ulong
note 1 + index of the newest placeholder with this name, 0 when there is none
i = sg NV
while gt i 0 bound 1024
i = sub i 1
b = mul i 4
if eq vg add b 1 n
if mcmp vg b off n
ret add i 1
end
end
end
ret 0
end

fn vlook k view uchar * to ulong
ko = keep k
v = findv ko len k
put st TOP ko
ret v
end

fn vset k view uchar * to bool
note the placeholder exists and is not empty
v = vlook k
if eq v 0
ret false
end
ret gt vg add mul sub v 1 4 3 0
end

fn tagend s ulong lim ulong to ulong
i = s
while lt add i 1 lim bound 512
if gt sub i s 200
die ertag
end
if eq mg i 125
if eq mg add i 1 125
ret i
end
end
i = add i 1
end
die ertag
ret lim
end

fn iscl i ulong no ulong nl ulong to bool
if ne mg add i 1 123
ret false
end
if ne mg add i 2 47
ret false
end
if not mcmp add i 3 no nl
ret false
end
if ne mg add add i 3 nl 125
ret false
end
if ne mg add add i 4 nl 125
ret false
end
ret true
end

fn skipto p ulong lim ulong no ulong nl ulong to ulong
note first index after the closing tag of block NAME (arena no..no+nl), searching from p
i = p
need = add nl 5
while le add i need lim bound 16777216
if eq mg i 123
if iscl i no nl
ret add i need
end
end
i = add i 1
end
die erblock
ret lim
end

fn dotag i ulong lim ulong depth ulong to ulong
s = add i 2
e = tagend s lim
k = mg s
if eq k 47
ret add e 2
end
if or eq k 35 eq k 94
no = add s 1
nl = sub e no
v = findv no nl
have = ulong 0
if gt v 0
if gt vg add mul sub v 1 4 3 0
have = 1
end
end
want = ulong 0
if eq k 35
want = 1
end
if eq have want
ret add e 2
end
ret skipto add e 2 lim no nl
end
v = findv s sub e s
if eq v 0
put st CXO s
put st CXL sub e s
die erunk
end
b = mul sub v 1 4
expand vg add b 2 vg add b 3 add depth 1
ret add e 2
end

fn expand off ulong n ulong depth ulong to void
if gt depth 6
die erdeep
end
lim = add off n
i = off
while lt i lim bound 16777216
c = mg i
tag = false
if eq c 123
if lt add i 1 lim
if eq mg add i 1 123
tag = true
end
end
end
if tag
i = dotag i lim depth
else
ob c
i = add i 1
end
end
end

note ---- small parsers over the arena

fn eol i ulong lim ulong to ulong
j = i
while lt j lim bound 16777216
if eq mg j 10
ret j
end
j = add j 1
end
ret lim
end

fn split s ulong e ulong sep uchar to ulong
note field k of arena s..e is fb 2k .. fb 2k+1; returns the field count (at most 16)
n = ulong 0
a = s
i = s
while le i e bound 16777216
stop = false
if eq i e
stop = true
else
if eq mg i sep
stop = true
end
end
if stop
if ge n 16
ret 99
end
put fb mul n 2 a
put fb add mul n 2 1 i
n = add n 1
a = add i 1
end
i = add i 1
end
ret n
end

fn alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end

fn inset c uchar mode ulong to bool
note sets: 1 name (A-Z a-z 0-9 . _ -), 2 lowercase hex, 3 time (0-9 T Z : -), 4 Radicle id
note (alphanumeric and colon), 5 digits, 6 printable ASCII without markup or placeholder bytes,
note 7 URL bytes, 8 digits and spaces
dig = and ge c 48 le c 57
if eq mode 1
if alnum c
ret true
end
ret or eq c 46 or eq c 95 eq c 45
end
if eq mode 2
if dig
ret true
end
ret and ge c 97 le c 102
end
if eq mode 3
if dig
ret true
end
ret or eq c 84 or eq c 90 or eq c 58 eq c 45
end
if eq mode 4
if alnum c
ret true
end
ret eq c 58
end
if eq mode 5
ret dig
end
if eq mode 6
if or lt c 32 gt c 126
ret false
end
if or eq c 60 or eq c 62 eq c 38
ret false
end
if or eq c 34 or eq c 123 eq c 125
ret false
end
ret true
end
if eq mode 7
if alnum c
ret true
end
if or eq c 46 or eq c 95 or eq c 45 eq c 47
ret true
end
ret or eq c 58 or eq c 126 or eq c 63 or eq c 61 eq c 43
end
if eq mode 8
ret or dig eq c 32
end
ret false
end

fn okset s ulong e ulong mode ulong to bool
note every byte of the nonempty arena range s..e is in the set (see inset)
if ge s e
ret false
end
i = s
while lt i e bound 16777216
if not inset mg i mode
ret false
end
i = add i 1
end
ret true
end

fn mnum s ulong e ulong to ulong
note the decimal number in arena s..e; 0 when it is not 1 to 9 digits or has a leading zero
if ge s e
ret 0
end
if gt sub e s 9
ret 0
end
if eq mg s 48
ret 0
end
v = ulong 0
i = s
while lt i e bound 16
c = mg i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end

note ---- text policy on obuf

fn low c uchar to uchar
if and ge c 65 le c 90
ret add c 32
end
ret c
end

fn space c uchar to bool
ret or eq c 32 or eq c 9 or eq c 10 eq c 13
end

fn namechar c uchar to bool
d = low c
ret or and ge d 97 le d 122 or and ge d 48 le d 57 or eq d 45 eq d 58
end

fn omatch pos ulong pat view uchar * to bool
if gt add pos len pat sg OBN
ret false
end
for j ulong len pat bound 4096
if ne low og add pos j get pat j
ret false
end
end
ret true
end

fn otoken pos ulong size ulong pat view uchar * to bool
if ne size len pat
ret false
end
ret omatch pos pat
end

fn ofind from ulong pat view uchar * to ulong
n = sg OBN
j = from
while lt j n bound 16777216
if omatch j pat
ret j
end
j = add j 1
end
ret n
end

fn ohas pat view uchar * to bool
ret lt ofind 0 pat sg OBN
end

fn emailc c uchar to bool
d = low c
ret or and ge d 97 le d 122 or and ge d 48 le d 57 or eq d 46 or eq d 95 or eq d 43 eq d 45
end

fn labelc c uchar to bool
d = low c
ret or and ge d 97 le d 122 or and ge d 48 le d 57 eq d 45
end

fn isemail i ulong to bool
note obuf i is an at sign with a name byte before it and "label.letter" after it
n = sg OBN
if eq i 0
ret false
end
if not emailc og sub i 1
ret false
end
j = add i 1
while lt j n bound 16777216
if not labelc og j
break
end
j = add j 1
end
if eq j add i 1
ret false
end
if ge add j 1 n
ret false
end
if ne og j 46
ret false
end
d = low og add j 1
ret and ge d 97 le d 122
end

fn polpath i ulong c uchar to void
if eq c 47
if or omatch i phome or omatch i pusers or omatch i pvarwww or omatch i ptmp omatch i prootd
dieat erpriv i
end
end
if eq c 126
if omatch i ptilde
dieat erpriv i
end
end
if eq c 46
if omatch i ptsnet
dieat erpriv i
end
end
if eq c 108
if omatch i plocalh
dieat erpriv i
end
end
if eq c 49
if or omatch i ploop or omatch i pcgnat omatch i plan
dieat erpriv i
end
end
if eq c 116
if omatch i ptail
dieat erpriv i
end
end
if eq c 102
if omatch i pfile
dieat erpriv i
end
end
end

fn polword i ulong c uchar to void
if eq c 64
if isemail i
dieat eremail i
end
end
if eq c 109
if omatch i pmailto
dieat eremail i
end
end
if eq c 38
if or omatch i pmdash or omatch i pndash or omatch i pnumref omatch i preg
dieat erdash i
end
end
if eq c 115
if omatch i pspark
dieat erpriv i
end
if omatch i psireg
dieat ertm i
end
if or omatch i psup1 or omatch i psup2 omatch i psup3
ok = false
if ge i len psupok
if omatch sub i len psupok psupok
if eq sg SIOK 0
ok = true
end
end
end
if not ok
dieat ersuper i
end
put st SIOK 1
end
end
end

fn polscan strict bool to void
put st SIOK 0
n = sg OBN
i = ulong 0
while lt i n bound 16777216
c = og i
if strict
if lt c 32
if not space c
dieat ertext i
end
end
if gt c 126
dieat ertext i
end
end
d = low c
polpath i d
polword i d
i = add i 1
end
end

note ---- markup checks on obuf

fn badtag pos ulong size ulong to bool
if or otoken pos size tgscript or otoken pos size tgiframe or otoken pos size tgobject otoken pos size tgembed
ret true
end
if or otoken pos size tgapplet or otoken pos size tgframe or otoken pos size tgfrset otoken pos size tgbase
ret true
end
if or otoken pos size tgstyle or otoken pos size tgforgn or otoken pos size tganim otoken pos size tgset
ret true
end
if or otoken pos size tganimt or otoken pos size tganimm otoken pos size tgform
ret true
end
ret false
end

fn badattr pos ulong size ulong to bool
if ge size 2
if and eq low og pos 111 eq low og add pos 1 110
ret true
end
end
if or otoken pos size tgstyle or otoken pos size tasrcset or otoken pos size tasrcdoc otoken pos size tahttpeq
ret true
end
if or otoken pos size taaction or otoken pos size taformac otoken pos size taping
ret true
end
ret false
end

fn boolattr pos ulong size ulong to bool
if or otoken pos size tahidden or otoken pos size taopen otoken pos size tachk
ret true
end
ret or otoken pos size tareq or otoken pos size tadown otoken pos size tadis
end

fn skipsp pos ulong to ulong
n = sg OBN
i = pos
while lt i n bound 16777216
if not space og i
break
end
i = add i 1
end
ret i
end

fn fragat i ulong fo ulong fl ulong to bool
note arena i.. is id="FRAG" where FRAG is obuf fo..fo+fl
if ne mg add i 1 100
ret false
end
if ne mg add i 2 61
ret false
end
if ne mg add i 3 34
ret false
end
for j ulong fl bound 1024
if ne mg add add i 4 j og add fo j
ret false
end
end
ret eq mg add add i 4 fl 34
end

fn fragmem base ulong n ulong fo ulong fl ulong to bool
need = add fl 5
i = base
lim = add base n
while le add i need lim bound 16777216
if eq mg i 105
if fragat i fo fl
ret true
end
end
i = add i 1
end
ret false
end

fn fragself fo ulong fl ulong pos ulong to void
note the page in obuf must hold id="FRAG"
if eq fl 0
ret
end
base = sg TOP
n = sg OBN
if gt add base n MEMSZ
die erfull
end
for j ulong n bound 16777216
put mem add base j og j
end
if not fragmem base n fo fl
dieat erfrag pos
end
end

fn fragfile fo ulong fl ulong pos ulong to void
note the output file named by pb must hold id="FRAG"
if eq fl 0
ret
end
mark = sg TOP
base = slurp
ok = fragmem base sg FLEN fo fl
put st TOP mark
if not ok
dieat erfrag pos
end
end

fn urlpath pos ulong size ulong to ulong
note appends the path part of the local URL to pb (after the site root); returns its length
pbroot sg SITE
n = sg PBL
cnt = ulong 0
while lt cnt size bound 1024
c = og add pos cnt
if or eq c 35 eq c 63
break
end
if or le c 32 or eq c 92 or eq c 38 or eq c 37 eq c 58
dieat erurl pos
end
if eq c 46
if lt add cnt 1 size
if eq og add add pos cnt 1 46
dieat erurl pos
end
end
end
put pb add n cnt c
cnt = add cnt 1
end
put st PBL add n cnt
if eq get pb sub add n cnt 1 47
pbadd tindex
end
ret cnt
end

fn linkchk pos ulong size ulong cnt ulong to void
p = readlnk pb 0 sg PBL sy 0 1024
if ne p -22
dieat erlink pos
end
fd = fopen pb 0 sg PBL 34816 0
if lt fd 0
dieat erlink pos
end
r = fclose int fd
if lt cnt size
if eq og add pos cnt 35
fragfile add add pos cnt 1 sub sub size cnt 1 pos
end
end
end

fn localurl pos ulong size ulong to void
c = og pos
if eq c 35
if eq sg LCHK 1
fragself add pos 1 sub size 1 pos
end
ret
end
if ne c 47
dieat erurl pos
end
if gt size 1
if eq og add pos 1 47
dieat erurl pos
end
end
cnt = urlpath pos size
if eq sg LCHK 1
linkchk pos size cnt
end
end

fn checkurl pos ulong size ulong ext bool to void
if or eq size 0 gt size 768
dieat erurl pos
end
if ext
if omatch pos thttps
if le size len thttps
dieat erurl pos
end
ret
end
end
localurl pos size
end

fn ownbase pos ulong to bool
note the value starts with the current site's own address
if eq sg SITE 0
ret omatch pos tbase0
end
ret omatch pos tbase1
end

fn attrurl start ulong size ulong as ulong az ulong to void
note resource attributes take local targets only
if or otoken as az tasrc otoken as az taposter
checkurl start size false
end
if or otoken as az tabackg otoken as az taxhref
checkurl start size false
end
end

fn hrefurl start ulong size ulong tp ulong tz ulong to void
note a link may leave the site; a link element may name only this site; anything else is local
ext = otoken tp tz tga
if otoken tp tz tglink
ext = ownbase start
end
checkurl start size ext
end

fn attrval pos ulong as ulong az ulong tp ulong tz ulong to ulong
i = skipsp pos
n = sg OBN
if ge i n
dieat erattr pos
end
if ne og i 61
if boolattr as az
ret pos
end
dieat erattr as
end
i = skipsp add i 1
if ge i n
dieat erattr as
end
q = og i
if not or eq q 34 eq q 39
dieat erattr as
end
start = add i 1
i = start
while lt i n bound 16777216
if eq og i q
break
end
if eq og i 60
dieat erattr as
end
i = add i 1
end
if ge i n
dieat erattr as
end
size = sub i start
attrurl start size as az
if otoken as az tahref
hrefurl start size tp tz
end
ret add i 1
end

fn starttag pos ulong to ulong
n = sg OBN
i = pos
while lt i n bound 16777216
if not namechar og i
break
end
i = add i 1
end
sz = sub i pos
if eq sz 0
dieat ermark pos
end
if badtag pos sz
dieat ermark pos
end
while lt i n bound 16777216
c = og i
if eq c 62
ret add i 1
end
if eq c 47
i = add i 1
if lt i n
if eq og i 62
ret add i 1
end
end
dieat ermark pos
end
if not space c
dieat erattr i
end
i = skipsp i
if ge i n
dieat ermark pos
end
c2 = og i
if or eq c2 62 eq c2 47
continue
end
as = i
while lt i n bound 16777216
if not namechar og i
break
end
i = add i 1
end
az = sub i as
if eq az 0
dieat erattr as
end
if badattr as az
dieat erattr as
end
i = attrval i as az pos sz
end
dieat ermark pos
ret i
end

fn endtag pos ulong to ulong
n = sg OBN
i = pos
while lt i n bound 16777216
if not namechar og i
break
end
i = add i 1
end
if eq i pos
dieat ermark pos
end
if badtag pos sub i pos
dieat ermark pos
end
i = skipsp i
if ge i n
dieat ermark pos
end
if ne og i 62
dieat ermark pos
end
ret add i 1
end

fn chkhead to void
if not and ohas tdoctype and ohas thtmlo and ohas thtmle and ohas theade and ohas tbodyo ohas tbodye
die erhtml
end
if not and ohas ttitleo ohas ttitlee
die erhtml
end
if le ofind 0 ttitlee add ofind 0 ttitleo len ttitleo
die erhtml
end
if not and ohas trelst ohas tstylea
die erhtml
end
note every Sovereign Intelligence in the document, head and body, carries the trade mark sign
n = sg OBN
p = ofind 0 psi
while lt p n bound 100000
if not omatch add p len psi ptrade
dieat ertm p
end
p = ofind add p 1 psi
end
end

fn tmtext to void
note llms.txt is plain text: every Sovereign Intelligence is followed by (TM)
n = sg OBN
p = ofind 0 psi
while lt p n bound 100000
if not omatch add p len psi ptml
dieat ertm p
end
p = ofind add p 1 psi
end
end

fn isvoid pos ulong sz ulong to bool
note an HTML element that never has an end tag
if or otoken pos sz vtmeta or otoken pos sz vtlink or otoken pos sz vtbr otoken pos sz vtimg
ret true
end
if or otoken pos sz vthr or otoken pos sz vtwbr or otoken pos sz vtinput or otoken pos sz vtsource otoken pos sz vtcol
ret true
end
ret false
end

fn namelen pos ulong to ulong
n = sg OBN
i = pos
while lt i n bound 16777216
if not namechar og i
break
end
i = add i 1
end
ret sub i pos
end

fn nopen pos ulong after ulong to void
note a start tag at obuf pos that ended at after: push it unless it is void or closes itself
sz = namelen pos
if isvoid pos sz
ret
end
if ge after 2
if eq og sub after 2 47
ret
end
end
d = sg NSD
if ge d 120
dieat ernest pos
end
put nst mul d 2 pos
put nst add mul d 2 1 sz
put st NSD add d 1
end

fn nclose pos ulong to void
note an end tag at obuf pos: it must close the element opened last
sz = namelen pos
d = sg NSD
if eq d 0
dieat ernest pos
end
d = sub d 1
op = get nst mul d 2
if ne get nst add mul d 2 1 sz
dieat ernest pos
end
for j ulong sz bound 64
if ne low og add op j low og add pos j
dieat ernest pos
end
end
put st NSD d
end

fn chkmark html bool to void
if html
chkhead
end
put st NSD 0
n = sg OBN
i = ulong 0
while lt i n bound 16777216
if eq og i 60
if omatch i tcmo
i = ofind i tcme
if ge i n
die ermark
end
i = add i len tcme
continue
end
if omatch i tdoctype
if not html
dieat ermark i
end
i = add i len tdoctype
continue
end
i = add i 1
if ge i n
die ermark
end
if eq og i 47
t0 = add i 1
i = endtag t0
nclose t0
else
t1 = i
i = starttag t1
nopen t1 i
end
else
i = add i 1
end
end
if ne sg NSD 0
d = sub sg NSD 1
dieat ernest get nst mul d 2
end
end

fn cssban pat view uchar * to void
p = ofind 0 pat
if lt p sg OBN
dieat ercss p
end
end

fn cssbehav to void
note the old behavior property is refused; scroll-behavior is an ordinary property
n = sg OBN
p = ofind 0 cbehav
while lt p n bound 100000
if eq p 0
dieat ercss p
end
if ne og sub p 1 45
dieat ercss p
end
p = ofind add p 1 cbehav
end
end

fn chkcss to void
cssban cimport
cssban chttp
cssban cjs
cssban cmoz
cssban cexpr
cssban cimgset
cssban cproto
cssurl
cssban crgb
cssban crgba
cssban chsl
cssban chsla
cssbehav
if not omatch 0 croot
die ercss
end
n = sg OBN
seen = false
for j ulong n bound 16777216
c = og j
if eq c 92
dieat ercss j
end
if eq c 125
seen = true
end
if eq c 35
if seen
dieat ercss j
end
end
end
end

fn obeqm p ulong e ulong mo ulong ml ulong to bool
note obuf p..e equals the arena bytes mo..mo+ml
if ne sub e p ml
ret false
end
for j ulong ml bound 4096
if ne og add p j mg add mo j
ret false
end
end
ret true
end

fn urlstop c uchar to bool
note a byte that ends a URL in plain text
if or le c 32 or eq c 41 or eq c 62 eq c 60
ret true
end
ret or eq c 34 or eq c 39 or eq c 35 or eq c 63 eq c 44
end

fn isroute p ulong e ulong to bool
note obuf p..e is the route (without its leading slash) of an enabled interplane.io entry
nr = sg NR
r = ulong 0
while lt r nr bound 512
b = mul r 8
if eq rg add b 1 0
if enabled r
if obeqm p e add rg add b 2 1 sub rg add b 3 1
ret true
end
end
end
r = add r 1
end
ret false
end

fn llmspath p ulong e ulong to bool
if eq p e
ret true
end
if isroute p e
ret true
end
size = sub e p
if or otoken p size fsitemap or otoken p size lexplore otoken p size lowner
ret true
end
if omatch p lownerp
ret true
end
if eq sg FRC 1
if or otoken p size lledger omatch p lpayp
ret true
end
end
ret false
end

fn llmspage r ulong to bool
note the address of page route r is in obuf, ended by a URL stop byte
b = mul r 8
ro = add rg add b 2 1
rl = sub rg add b 3 1
n = sg OBN
i = ofind 0 tbase0
while lt i n bound 100000
p = add i len tbase0
e = add p rl
if le e n
if obeqm p e ro rl
if eq e n
ret true
end
if urlstop og e
ret true
end
end
end
i = ofind add i 1 tbase0
end
ret false
end

fn llmschk to void
note every interplane.io address in obuf is real, and every enabled page is listed
n = sg OBN
i = ofind 0 tbase0
while lt i n bound 100000
p = add i len tbase0
e = p
while lt e n bound 4096
if urlstop og e
break
end
e = add e 1
end
if not llmspath p e
dieat erllms i
end
i = ofind add i 1 tbase0
end
nr = sg NR
r = ulong 0
while lt r nr bound 512
b = mul r 8
if and or eq rg b 1 eq rg b 7 eq rg add b 1 0
if enabled r
if not llmspage r
put st CXO rg add b 2
put st CXL rg add b 3
die erllmp
end
end
end
r = add r 1
end
end

fn lint kind ulong to void
if eq kind 5
polscan false
ret
end
if eq kind 8
chkfont
ret
end
if eq kind 9
chkpng
ret
end
polscan true
if eq kind 1
chkmark true
end
if eq kind 2
chkcss
end
if eq kind 3
chkmark false
end
if eq kind 6
llmschk
tmtext
end
end

fn chkfont to void
note a font route holds an OpenType file with CFF outlines: it starts with the tag OTTO
if lt sg OBN 12
die erfont
end
if not and and eq og 0 79 eq og 1 84 and eq og 2 84 eq og 3 79
die erfont
end
end

fn chkpng to void
note a png route holds a PNG image: it starts with the signature 137 80 78 71 13 10 26 10
if lt sg OBN 8
die erpng
end
if not and and eq og 0 137 eq og 1 80 and eq og 2 78 eq og 3 71
die erpng
end
if not and and eq og 4 13 eq og 5 10 and eq og 6 26 eq og 7 10
die erpng
end
end

fn isfont p ulong e ulong to bool
note obuf p..e is the route (without its leading slash) of an enabled font route of the site in work
nr = sg NR
site = sg SITE
r = ulong 0
while lt r nr bound 512
b = mul r 8
if and eq rg b 8 eq rg add b 1 site
if enabled r
if obeqm p e add rg add b 2 1 sub rg add b 3 1
ret true
end
end
end
r = add r 1
end
ret false
end

fn cssurl to void
note url() may name only a font route of the same site: url(/public/fonts/NAME.otf)
n = sg OBN
p = ofind 0 curl
while lt p n bound 100000
q = add p len curl
e = q
while lt e n bound 512
if not inset og e 7
break
end
e = add e 1
end
if ge e n
dieat ercss p
end
if ne og e 41
dieat ercss p
end
if not omatch q tfonts
dieat ercss p
end
if not isfont add q 1 e
dieat ercss p
end
p = ofind add p 1 curl
end
end

note ---- button contrast (WCAG 2.1 relative luminance), integer arithmetic over a Wolfram table

fn hexv c uchar to ulong
d = low c
if and ge d 48 le d 57
ret ulong sub d 48
end
if and ge d 97 le d 102
ret ulong sub d 87
end
ret 99
end

fn ishex6 pos ulong to bool
if gt add pos 6 sg OBN
ret false
end
for j ulong 6
if eq hexv og add pos j 99
ret false
end
end
ret true
end

fn chan pos ulong to ulong
ret add mul hexv og pos 16 hexv og add pos 1
end

fn lumat pos ulong to ulong
note relative luminance x 1e13 of the colour whose six hex digits start at obuf pos
r = get lum chan pos
g = get lum chan add pos 2
b = get lum chan add pos 4
ret add add mul 2126 r mul 7152 g mul 722 b
end

fn obcmp a ulong b ulong n ulong to bool
for j ulong n bound 4096
if ne og add a j og add b j
ret false
end
end
ret true
end

fn inkval i ulong pl ulong rbe ulong to ulong
note position of the six hex digits of the -ink token whose prefix is obuf i..i+pl; 0 when missing
j = ulong 0
while le add add j pl 12 rbe bound 1048576
if obcmp j i pl
if omatch add j pl cink
if ishex6 add add j pl len cink
ret add add j pl len cink
end
end
end
j = add j 1
end
ret 0
end

fn saychan pos ulong to void
sayn chan pos
say tsp
sayn chan add pos 2
say tsp
sayn chan add pos 4
end

fn saylin pos ulong to void
sayn get lum chan pos
say tsp
sayn get lum chan add pos 2
say tsp
sayn get lum chan add pos 4
end

fn showpair i ulong e ulong bp ulong ip ulong to bool
note prints the arithmetic for one background token (name obuf i..e, digits at bp) and its text colour
lb = lumat bp
li = lumat ip
hi = add lb 500000000000
lo = add li 500000000000
if lt hi lo
t = hi
hi = lo
lo = t
end
say mc1
sayob i sub e i
say tsp
say thash
sayob bp 6
say mc2
say thash
sayob ip 6
say mc3
saychan bp
say mc4
saychan ip
say mc5
saylin bp
say mc4
saylin ip
say mc6
sayn lb
say mc4
sayn li
say mc7
q = div mul hi 100 lo
sayn div q 100
say tdot
sayn div rem q 100 10
sayn rem q 10
say mc8
pass = ge mul hi 2 mul lo 9
if pass
say mcpass
else
say mcfail
end
ret pass
end

fn btnrole i ulong e ulong to ulong
note length of the role suffix of the token name obuf i..e: 3 for -bg, 6 for -hover, else 0
if gt sub e i 9
if omatch sub e 3 csbg
ret 3
end
if omatch sub e 6 cshov
ret 6
end
if omatch sub e 6 cspress
ret 6
end
end
ret 0
end

fn contrast to void
note obuf holds the stylesheet; every --btn-NAME-bg, --btn-NAME-hover and --btn-NAME-press is checked against --btn-NAME-ink
rbe = ofind 0 tcbrace
pairs = ulong 0
bad = ulong 0
i = len croot
while lt i rbe bound 1048576
if omatch i cbtn
p = og sub i 1
if or eq p 59 eq p 123
e = i
while lt e rbe bound 256
if eq og e 58
break
end
e = add e 1
end
role = btnrole i e
if gt role 0
ip = inkval i sub sub e i role rbe
ok = false
if gt ip 0
if eq og add e 1 35
if ishex6 add e 2
t = og add e 8
if or eq t 59 eq t 125
ok = showpair i e add e 2 ip
end
end
end
end
pairs = add pairs 1
if not ok
bad = add bad 1
end
end
end
end
i = add i 1
end
say mcsum
sayn pairs
say tnl
if or eq pairs 0 gt bad 0
die ercon
end
end



text pf2 "</span> "
text pf3 " bytes, <span class=\"mono\">"
text pf4 "</span></li>\n"
text pomega "&Omega;"
text pj1 "{\n  \"source\": \"https://zenodo.org/api/records\",\n  \"orcid\": \""
text pj2 "\",\n  \"fetched\": \""
text pj3 "\",\n  \"snapshot_sha256\": \""
text pj4 "\",\n  \"responses\": ["
text pj5 "],\n  \"count\": "
text pj6 ",\n  \"papers\": [\n"
text pj7 "\n  ]\n}\n"
text pjr1 "{\"page\": "
text pjr2 ", \"sha256\": \""
text pjr3 "\"}"
text jr1 "    {\n      \"doi\": \""
text jr2 "\",\n      \"doi_url\": \"https://doi.org/"
text jr3 "\",\n      \"concept_doi\": \""
text jr4 "\",\n      \"concept_doi_url\": \"https://doi.org/"
text jr5 "\",\n      \"title\": \""
text jr6 "\",\n      \"date\": \""
text jr7 "\",\n      \"type\": \""
text jr8 "\",\n      \"version\": "
text jr9 ",\n      \"license\": \""
text jr10 "\",\n      \"creators\": ["
text jr11 "],\n      \"orcid_attached\": "
text jr12 ",\n      \"source_on_interplane\": "
text jr13 ",\n      \"files\": [\n"
text jr14 "\n      ],\n      \"related\": ["
text jr15 "]\n    }"
text jrnl "\n      "
text jsep ",\n"
text jnull "null"
text jtrue "true"
text jfalse "false"
text jc1 "{\"name\": \""
text jc2 "\", \"orcid\": "
text jf1 "        {\"name\": \""
text jf2 "\", \"size\": "
text jf3 ", \"checksum\": \""
text jq2 "\"}"
text jrl1 "\n        {\"relation\": \""
text jrl2 "\", \"scheme\": \""
text jrl3 "\", \"identifier\": \""
text pbh1 "% Papers of ORCID iD "
text pbh2 ", copied from Zenodo on "
text pbh3 ".\n% Generated from content/papers.snapshot by the interplane.io builder.\n"
text bb1 "\n@misc{zenodo"
text bb2 ",\n  author = {"
text bb3 "},\n  title = \"{"
text bb4 "}\",\n  howpublished = {Zenodo},\n  year = {"
text bb5 "},\n  month = "
text bb6 ",\n  date = {"
text bb7 "},\n"
text bb8 "  version = {"
text bb10 "  doi = {"
text bb11 "},\n  url = {https://doi.org/"
text bb12 "},\n  note = {"
text bb13 ". Licence "
text bb14 ". Version history: doi "
text bb15 "}\n}\n"
text band " and "
text btilde "textasciitilde{}"
text bcaret "textasciicircum{}"

fn pg k ulong to ulong
ret get pr k
end

fn kvsp s ulong e ulong to ulong
note the first space in arena s..e, or e when there is none
i = s
while lt i e bound 16777216
if eq mg i 32
ret i
end
i = add i 1
end
ret e
end

fn vstart k ulong e ulong to ulong
note the value after the key that ends at k
if lt k e
ret add k 1
end
ret e
end

fn pkey s ulong n ulong to ulong
note record fields 1..11 in their order, header keys 21..24, 0 for an unknown key
if mist s n kprec
ret 1
end
if mist s n kpcon
ret 2
end
if mist s n kptit
ret 3
end
if mist s n kpdate
ret 4
end
if mist s n kptype
ret 5
end
if mist s n kpver
ret 6
end
if mist s n kplic
ret 7
end
if mist s n kpcre
ret 8
end
if mist s n kpatt
ret 9
end
if mist s n kpfile
ret 10
end
if mist s n kprel
ret 11
end
if mist s n kporc
ret 21
end
if mist s n kpfet
ret 22
end
if mist s n kpresp
ret 23
end
if mist s n kprecs
ret 24
end
ret 0
end

fn digok s ulong e ulong max ulong to bool
note 1 to max decimal digits without a leading zero
if or ge s e gt sub e s max
ret false
end
if and eq mg s 48 gt sub e s 1
ret false
end
ret okset s e 5
end

fn doiok s ulong e ulong to bool
note 10.5281/zenodo. and 1 to 12 digits
if le e s
ret false
end
if le sub e s len tdoipre
ret false
end
if not mistf s tdoipre false
ret false
end
ret digok add s len tdoipre e 12
end

fn orcidok s ulong e ulong to bool
note four groups of four digits joined by hyphens; the last character may be X
if ne sub e s 19
ret false
end
for i ulong 19
c = mg add s i
if or eq i 4 or eq i 9 eq i 14
if ne c 45
ret false
end
else
if or lt c 48 gt c 57
if not and eq i 18 eq c 88
ret false
end
end
end
end
ret true
end

fn ymdok s ulong e ulong to bool
note arena s..e is YYYY-MM-DD and names a real day
if ne sub e s 10
ret false
end
for i ulong 10
c = mg add s i
if or eq i 4 eq i 7
if ne c 45
ret false
end
else
if or lt c 48 gt c 57
ret false
end
end
end
m = l2 add s 5
if or lt m 1 gt m 12
ret false
end
d = l2 add s 8
y = add mul l2 s 100 l2 add s 2
ret and ge d 1 le d ldim y m
end

fn sumok s ulong e ulong to bool
note md5: and 32 lowercase hex digits, or sha256: and 64
n = sub e s
if mistf s tmd5 false
if eq n add len tmd5 32
ret okset add s len tmd5 e 2
end
ret false
end
if mistf s tsha2 false
if eq n add len tsha2 64
ret okset add s len tsha2 e 2
end
end
ret false
end

fn dgt a ulong c ulong to bool
note the date at arena a is later than the date at arena c (both YYYY-MM-DD)
for j ulong 10
x = mg add a j
y = mg add c j
if gt x y
ret true
end
if lt x y
ret false
end
end
ret false
end

fn pescok p ulong e ulong to bool
note the backslash at arena p starts the one escape the builder can write: u03a9, capital omega
if gt add p 6 e
ret false
end
ret mistf add p 1 tescom false
end

fn pchars s ulong e ulong max ulong to void
note a text value: 1 to max printable bytes without markup bytes; a backslash only in a known escape
if or ge s e gt sub e s max
die erpap
end
i = s
while lt i e bound 16777216
c = mg i
if eq c 92
if not pescok i e
die erpesc
end
i = add i 6
else
if not inset c 6
die erpap
end
i = add i 1
end
end
end

fn presp v ulong e ulong to void
note response N sha256:HEX, numbered from 1 in order
nf = split v e 32
if ne nf 2
die erpap
end
n = mnum fg 0 fg 1
if ne n add sg PNRESP 1
die erpap
end
a = fg 2
if not mistf a tsha2 false
die erpap
end
if ne sub fg 3 a add len tsha2 64
die erpap
end
if not okset add a len tsha2 fg 3 2
die erpap
end
put st PNRESP n
end

fn phead f ulong v ulong e ulong to void
note a header line, in the order orcid, fetched, response.., records
p = sg PST
ok = false
if and eq f 21 eq p 0
ok = true
end
if and eq f 22 eq p 21
ok = true
end
if and eq f 23 or eq p 22 eq p 23
ok = true
end
if and eq f 24 eq p 23
ok = true
end
if or not ok gt sg PNR 0
die erpap
end
if eq f 21
if not orcidok v e
die erpap
end
put st POO v
end
if eq f 22
if not ymdok v e
die erpap
end
put st PFO v
end
if eq f 23
presp v e
end
if eq f 24
n = mnum v e
if or eq n 0 gt n 64
die erpap
end
put st PDECL n
end
put st PST f
end

fn pclose e ulong to void
note ends the open record at arena e: it is complete and not newer than the record before it
n = sg PNR
p = sg PST
if eq p 2
die erptit
end
if lt p 10
die erpap
end
b = mul sub n 1 32
put pr add b 17 e
if ge n 2
if dgt pg add b 6 pg sub add b 6 32
die erpord
end
end
end

fn pnew s ulong v ulong e ulong to void
note a record line: closes the record before it and opens the next slot of pr
n = sg PNR
if eq n 0
if ne sg PST 24
die erpap
end
put st PHE s
else
pclose s
end
if ge n 64
die erpap
end
if not doiok v e
die erpdoi
end
if pseen n 0 v sub e v
die erpdup
end
b = mul n 32
for j ulong 32
put pr add b j 0
end
put pr b v
put pr add b 1 sub e v
put pr add b 16 s
put st PNR add n 1
put st PST 1
put st PATT 0
end

fn pnext p ulong f ulong to bool
note field f may follow field p: the next one, version may be left out, and creator, file and
note related may repeat
if eq f add p 1
ret true
end
if and eq p 5 eq f 7
ret true
end
ret and eq f p or eq f 8 or eq f 10 eq f 11
end

fn pcreat v ulong e ulong to void
note creator ORCID-or-none NAME; the header's ORCID iD on a creator marks the record attached
k = kvsp v e
if ge k e
die erpap
end
if not mist v sub k v tnone
if not orcidok v k
die erpap
end
if mcmp v sg POO 19
put st PATT 1
end
end
pchars add k 1 e 200
end

fn patt v ulong e ulong to void
note orcid_attached yes or no, in agreement with the creator lines
b = mul sub sg PNR 1 32
want = sg PATT
if mist v sub e v tyes
if ne want 1
die erpap
end
put pr add b 14 1
ret
end
if not mist v sub e v tno
die erpap
end
if ne want 0
die erpap
end
end

fn pfiln v ulong e ulong to void
note file NAME SIZE CHECKSUM
nf = split v e 32
if ne nf 3
die erpap
end
if or not okset fg 0 fg 1 1 gt sub fg 1 fg 0 128
die erpap
end
if not digok fg 2 fg 3 12
die erpap
end
if not sumok fg 4 fg 5
die erpap
end
end

fn prel v ulong e ulong to void
note related RELATION SCHEME IDENTIFIER
nf = split v e 32
if ne nf 3
die erpap
end
if or not okset fg 0 fg 1 1 gt sub fg 1 fg 0 40
die erpap
end
if or not okset fg 2 fg 3 1 gt sub fg 3 fg 2 20
die erpap
end
if or not okset fg 4 fg 5 7 gt sub fg 5 fg 4 300
die erpap
end
end

fn pstore f ulong v ulong e ulong to void
note checks the value of field f and records it in the open record
b = mul sub sg PNR 1 32
if eq f 2
if not doiok v e
die erpdoi
end
if pseen sub sg PNR 1 2 v sub e v
die erpdup
end
put pr add b 2 v
put pr add b 3 sub e v
end
if eq f 3
if ge v e
die erptit
end
pchars v e 400
put pr add b 4 v
put pr add b 5 sub e v
end
if eq f 4
if not ymdok v e
die erpap
end
put pr add b 6 v
end
if eq f 5
pchars v e 80
put pr add b 8 v
put pr add b 9 sub e v
end
if eq f 6
pchars v e 80
put pr add b 10 v
put pr add b 11 sub e v
end
if eq f 7
if or not okset v e 1 gt sub e v 40
die erpap
end
put pr add b 12 v
put pr add b 13 sub e v
end
if eq f 8
pcreat v e
end
if eq f 9
patt v e
end
if eq f 10
pfiln v e
end
if eq f 11
prel v e
end
end

fn pfield f ulong v ulong e ulong to void
note a record field: inside a record, in order; a record that skips its title is named as such
if eq sg PNR 0
die erpap
end
p = sg PST
if and eq p 2 ne f 3
die erptit
end
if not pnext p f
die erpap
end
pstore f v e
put st PST f
end

fn papline s ulong e ulong to void
k = kvsp s e
f = pkey s sub k s
v = vstart k e
if eq f 0
die erpap
end
if gt f 20
phead f v e
ret
end
if eq f 1
pnew s v e
ret
end
pfield f v e
end

fn pseen n ulong k ulong v ulong l ulong to bool
note one of the first n records holds arena v..v+l in slot pair k (0 record DOI, 2 concept DOI)
for r ulong n bound 64
b = mul r 32
if eq pg add b add k 1 l
if mcmp pg add b k v l
ret true
end
end
end
ret false
end

fn pfind co ulong cl ulong to ulong
note 1 + the index of the record whose concept DOI is arena co..co+cl, 0 when there is none
n = sg PNR
for r ulong n bound 64
b = mul r 32
if eq pg add b 3 cl
if mcmp pg add b 2 co cl
ret add r 1
end
end
end
ret 0
end

fn psumin r ulong so ulong sl ulong to bool
note record r lists a file whose checksum is arena so..so+sl
b = mul r 32
lim = pg add b 17
i = pg add b 16
while lt i lim bound 16777216
e = eol i lim
k = kvsp i e
if mist i sub k i kpfile
nf = split vstart k e e 32
if eq nf 3
if eq sub fg 5 fg 4 sl
if mcmp fg 4 so sl
ret true
end
end
end
end
i = add e 1
end
ret false
end

fn psrcline s ulong e ulong to void
note source CONCEPT-DOI ADDRESS CHECKSUM
nf = split s e 32
if or ne nf 4 not fbis 0 kpsrc
die erpsrc
end
r = pfind fg 2 sub fg 3 fg 2
if eq r 0
die erpsrc
end
b = mul sub r 1 32
uo = fg 4
ul = sub fg 5 fg 4
so = fg 6
sl = sub fg 7 fg 6
if gt pg add b 19 0
die erpsrc
end
if or le ul len tbase0 gt ul 300
die erpsrc
end
if not mistf uo tbase0 false
die erpsrc
end
if not okset uo add uo ul 7
die erpsrc
end
if not psumin sub r 1 so sl
die erpsrc
end
put pr add b 18 uo
put pr add b 19 ul
put st PNSRC add sg PNSRC 1
end

fn psources to void
note content/papers.sources is optional: without it no paper has a source link
put st PNSRC 0
pbset fpsrc
if not isfile
ret
end
put st CXO keep fpsrc
put st CXL len fpsrc
off = slurp
lim = add off sg FLEN
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
psrcline i e
end
end
i = add e 1
end
end

fn obib c uchar to void
note one byte of a BibTeX value; the special characters are escaped
if or or eq c 37 eq c 36 or eq c 35 eq c 95
ob 92
ob c
ret
end
if eq c 126
ob 92
ot btilde
ret
end
if eq c 94
ob 92
ot bcaret
ret
end
ob c
end

fn pesc m ulong to void
note the escape u03a9, capital omega, in HTML (1), JSON (2) or BibTeX (3)
if eq m 1
ot pomega
ret
end
if eq m 3
ob 36
ob 92
ot tomega
ob 36
ret
end
ob 92
ot tescom
end

fn ptx o ulong l ulong m ulong to void
note writes a checked snapshot text value as HTML (1), JSON (2) or BibTeX (3)
i = o
lim = add o l
while lt i lim bound 16777216
c = mg i
if eq c 92
pesc m
i = add i 6
else
if eq m 1
oesc i 1
else
if eq m 3
obib c
else
ob c
end
end
i = add i 1
end
end
end

fn plic o ulong l ulong to void
note a licence id for reading: cc-by-4.0 is written CC BY 4.0
for j ulong l bound 64
c = mg add o j
if eq c 45
ob 32
else
if and ge c 97 le c 122
ob sub c 32
else
ob c
end
end
end
end

fn pver o ulong l ulong to void
note a version that is a bare number reads "version 3"; a worded one such as "Revision 4" stays
c = mg o
if and ge c 48 le c 57
ot pverw
end
ptx o l 1
end

fn onumg s ulong e ulong to void
note the digits at arena s..e with a comma before each group of three from the right
n = sub e s
for j ulong n bound 16
if gt j 0
if eq rem sub n j 3 0
ob 44
end
end
ob mg add s j
end
end

fn jcreat v ulong e ulong cnt ulong to void
note one creator as a JSON object
if gt cnt 0
ot tcomma
end
k = kvsp v e
ot jc1
ptx add k 1 sub e add k 1 2
ot jc2
if mist v sub k v tnone
ot jnull
else
ob 34
om v sub k v
ob 34
end
ob 125
end

fn pitem v ulong e ulong m ulong cnt ulong to void
note one creator, file or related line: 1 HTML file, 2 JSON creator, 3 JSON file, 4 JSON related,
note 5 BibTeX author
if eq m 2
jcreat v e cnt
ret
end
if eq m 5
if gt cnt 0
ot band
end
k = kvsp v e
ptx add k 1 sub e add k 1 3
ret
end
nf = split v e 32
if eq m 1
ot pf1
om fg 0 sub fg 1 fg 0
ot pf2
onumg fg 2 fg 3
ot pf3
om fg 4 sub fg 5 fg 4
ot pf4
ret
end
if eq m 3
if gt cnt 0
ot jsep
end
ot jf1
om fg 0 sub fg 1 fg 0
ot jf2
om fg 2 sub fg 3 fg 2
ot jf3
om fg 4 sub fg 5 fg 4
ot jq2
ret
end
if gt cnt 0
ob 44
end
ot jrl1
om fg 0 sub fg 1 fg 0
ot jrl2
om fg 2 sub fg 3 fg 2
ot jrl3
om fg 4 sub fg 5 fg 4
ot jq2
end

fn pwalk r ulong key view uchar * m ulong to ulong
note pitem for each line of record r with this key; returns how many there were
b = mul r 32
lim = pg add b 17
i = pg add b 16
cnt = ulong 0
while lt i lim bound 16777216
e = eol i lim
k = kvsp i e
if mist i sub k i key
pitem vstart k e e m cnt
cnt = add cnt 1
end
i = add e 1
end
ret cnt
end

fn prow r ulong to void
note one entry of the papers page
b = mul r 32
co = pg add b 2
cl = pg add b 3
ot ph1
om add co len tdoipre sub cl len tdoipre
ot ph2
ptx pg add b 4 pg add b 5 1
ot ph3
om pg add b 6 10
ot pmid
ptx pg add b 8 pg add b 9 1
if gt pg add b 11 0
ot pmid
pver pg add b 10 pg add b 11
end
ot pmid
ot plicw
plic pg add b 12 pg add b 13
ot ph4
om pg b pg add b 1
ot ph5
om pg b pg add b 1
ot ph6
om co cl
ot ph7
om co cl
ot ph7b
if gt pg add b 19 0
ot ph8
om pg add b 18 pg add b 19
ot ph9
om co cl
ot ph7b
end
ot ph10
x = pwalk r kpfile 1
ot ph11
end

fn jopt o ulong l ulong to void
note a JSON string, or null when the value is absent
if eq l 0
ot jnull
ret
end
ob 34
ptx o l 2
ob 34
end

fn jrec r ulong to void
note one record of papers.json
b = mul r 32
ot jr1
om pg b pg add b 1
ot jr2
om pg b pg add b 1
ot jr3
om pg add b 2 pg add b 3
ot jr4
om pg add b 2 pg add b 3
ot jr5
ptx pg add b 4 pg add b 5 2
ot jr6
om pg add b 6 10
ot jr7
ptx pg add b 8 pg add b 9 2
ot jr8
jopt pg add b 10 pg add b 11
ot jr9
om pg add b 12 pg add b 13
ot jr10
x = pwalk r kpcre 2
ot jr11
if eq pg add b 14 1
ot jtrue
else
ot jfalse
end
ot jr12
jopt pg add b 18 pg add b 19
ot jr13
x = pwalk r kpfile 3
ot jr14
x = pwalk r kprel 4
if gt x 0
ot jrnl
end
ot jr15
end

fn presps to void
note the response lines of the snapshot header as JSON objects
i = sg PSO
lim = sg PHE
cnt = ulong 0
while lt i lim bound 16777216
e = eol i lim
k = kvsp i e
if mist i sub k i kpresp
nf = split add k 1 e 32
if gt cnt 0
ot tcomma
end
ot pjr1
om fg 0 sub fg 1 fg 0
ot pjr2
a = add fg 2 len tsha2
om a sub fg 3 a
ot pjr3
cnt = add cnt 1
end
i = add e 1
end
end

fn pjson to void
note the placeholder papers.json: the snapshot as one JSON document
put st OBN 0
ot pj1
om sg POO 19
ot pj2
om sg PFO 10
ot pj3
om sg PSHA 64
ot pj4
presps
ot pj5
onum sg PNR
ot pj6
n = sg PNR
for r ulong n bound 64
if gt r 0
ot jsep
end
jrec r
end
ot pj7
o = stash
setv vpjson o sg FLEN
end

fn brec r ulong to void
note one BibTeX entry
b = mul r 32
co = pg b
cl = pg add b 1
d = pg add b 6
ot bb1
om add co len tdoipre sub cl len tdoipre
ot bb2
x = pwalk r kpcre 5
ot bb3
ptx pg add b 4 pg add b 5 3
ot bb4
om d 4
ot bb5
m = l2 add d 5
for j ulong 3
ob get tmonths add mul sub m 1 3 j
end
ot bb6
om d 10
ot bb7
if gt pg add b 11 0
ot bb8
ptx pg add b 10 pg add b 11 3
ot bb7
end
ot bb10
om co cl
ot bb11
om co cl
ot bb12
ptx pg add b 8 pg add b 9 3
ot bb13
ptx pg add b 12 pg add b 13 3
ot bb14
om pg add b 2 pg add b 3
ot bb15
end

fn pbib to void
note the placeholder papers.bib: one BibTeX entry per record
put st OBN 0
ot pbh1
om sg POO 19
ot pbh2
om sg PFO 10
ot pbh3
n = sg PNR
for r ulong n bound 64
brec r
end
o = stash
setv vpbib o sg FLEN
end

fn phtml to void
note the placeholder papers.rows: one list entry per record, in snapshot order
put st OBN 0
n = sg PNR
for r ulong n bound 64
prow r
end
o = stash
setv vprows o sg FLEN
end

fn papers to void
pbset fpapers
put st CXO keep fpapers
put st CXL len fpapers
off = slurp
n = sg FLEN
hashm off n
ho = hxkeep
put st PSHA ho
put st PSO off
if eq sg TESTD 0
if mhas off n pfix true
die errel
end
end
put st PST 0
put st PNR 0
put st PNRESP 0
lim = add off n
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
papline i e
end
end
i = add e 1
end
if eq sg PNR 0
die erpap
end
pclose lim
if ne sg PNR sg PDECL
die erpord
end
psources
put st CXL 0
phtml
pjson
pbib
onum sg PNR
co = stash
setv vpcount co sg FLEN
setv vpasof sg PFO 10
setv vporcid sg POO 19
setv vpsha sg PSHA 64
onum sg PNSRC
so = stash
setv vpnsrc so sg FLEN
say mpap
sayn sg PNR
say mpsrc
sayn sg PNSRC
say mysha
saym sg PSHA 64
say tnl
end

note ---- receipts: the forge chain format (seq utc kind actor subject payload prev)

fn l2 a ulong to ulong
x = ulong mg a
y = ulong mg add a 1
ret add mul sub x 48 10 sub y 48
end

fn ldim y ulong m ulong to ulong
if eq m 2
if and eq rem y 4 0 or ne rem y 100 0 eq rem y 400 0
ret 29
end
ret 28
end
if or or eq m 4 eq m 6 or eq m 9 eq m 11
ret 30
end
ret 31
end

fn utcok a ulong e ulong to bool
note arena a..e is YYYY-MM-DDTHH:MM:SSZ and names a real date and time
if ne sub e a 20
ret false
end
for i ulong 20
c = mg add a i
w = uchar 0
if or eq i 4 eq i 7
w = 45
end
if eq i 10
w = 84
end
if or eq i 13 eq i 16
w = 58
end
if eq i 19
w = 90
end
if eq w 0
if or lt c 48 gt c 57
ret false
end
else
if ne c w
ret false
end
end
end
m = l2 add a 5
if or lt m 1 gt m 12
ret false
end
d = l2 add a 8
y = add mul l2 a 100 l2 add a 2
if or lt d 1 gt d ldim y m
ret false
end
if gt l2 add a 11 23
ret false
end
if gt l2 add a 14 59
ret false
end
ret le l2 add a 17 59
end

fn kindok s ulong e ulong to bool
if or ge s e gt sub e s 24
ret false
end
i = s
while lt i e bound 32
c = mg i
ok = or and ge c 65 le c 90 or and ge c 48 le c 57 eq c 95
if not ok
ret false
end
i = add i 1
end
ret true
end

fn linehash s ulong e ulong to void
note hx = SHA-256 of the ledger line arena s..e (without its line feed)
hashm s sub e s
end

fn phis s ulong e ulong to bool
note arena s..e equals the 64 hex digits in ph
if ne sub e s 64
ret false
end
for j ulong 64
if ne mg add s j get ph j
ret false
end
end
ret true
end

fn recshape s ulong e ulong to bool
note exactly six tabs and every other byte printable ASCII
t = ulong 0
i = s
while lt i e bound 1024
c = mg i
if eq c 9
t = add t 1
else
if or lt c 32 gt c 126
ret false
end
end
i = add i 1
end
ret eq t 6
end

fn reccheck s ulong e ulong n ulong prevu ulong to ulong
note 0 when arena s..e is the valid record number n; else the chain tool's BAD code
if gt sub e s 1023
ret 6
end
if not recshape s e
ret 1
end
nf = split s e 9
if ne mnum fg 0 fg 1 n
ret 2
end
if not utcok fg 2 fg 3
ret 3
end
if gt prevu 0
if utclt fg 2 prevu
ret 3
end
end
if not kindok fg 4 fg 5
ret 8
end
al = sub fg 7 fg 6
if or eq al 0 gt al 64
ret 8
end
sl = sub fg 9 fg 8
if or eq sl 0 gt sl 128
ret 8
end
if ne sub fg 11 fg 10 64
ret 4
end
if not okset fg 10 fg 11 2
ret 4
end
if eq n 1
if not fbis 6 tgenesis
ret 5
end
else
if not phis fg 12 fg 13
ret 5
end
end
ret 0
end

fn utclt a ulong b ulong to bool
note the 20-byte time at arena a is earlier than the one at b
for j ulong 20
x = mg add a j
y = mg add b j
if lt x y
ret true
end
if gt x y
ret false
end
end
ret false
end

fn paycheck po ulong to void
note the payload file named by the 64 hex digits at arena po exists and hashes to its name.
note st PAYO 1 reads it from the written output instead of the source tree.
if eq sg PAYO 1
pbroot 0
pbadd tslash
pbadd fpayout
else
pbset fpayd
end
pbaddm po 64
pbadd ftxt
if not isfile
put st CXO po
put st CXL 64
die erpayl
end
mark = sg TOP
off = slurp
hashm off sg FLEN
fix = false
if eq sg TESTD 0
fix = mhas off sg FLEN pfixu false
end
put st TOP mark
if not hxis po
put st CXO po
put st CXL 64
die erpayl
end
if fix
put st CXO po
put st CXL 64
die errel
end
end

fn recrow s ulong n ulong to void
note emits the table row of the record whose line starts at arena s; fb is refilled
e = eol s add s 1024
nf = split s e 9
ot r1
onum n
ot r2
onum n
ot r3
om fg 2 sub fg 3 fg 2
ot r4
om fg 4 sub fg 5 fg 4
ot r5
oesc fg 6 sub fg 7 fg 6
ot r6
oesc fg 8 sub fg 9 fg 8
ot r7
om fg 10 64
ot r8
om fg 10 16
ot r9
end

fn errnum v ulong to void
i = ulong 20
x = v
if eq x 0
i = 19
put sy 19 48
end
while gt x 0 bound 20
i = sub i 1
put sy i uchar add 48 rem x 10
x = div x 10
end
w = write 2 sy i sub 20 i
end

fn rcsay code ulong line ulong to void
note the chain tool's wording: BAD line N code
sayerr tbadl
errnum line
sayerr tsp
errnum code
sayerr tnl
end

fn rcloop off ulong lim ulong to ulong
note checks every record and its payload file; returns the record count, st BADC the last payload offset
count = ulong 0
prevu = ulong 0
i = off
while lt i lim bound 2000
e = eol i lim
count = add count 1
if gt count 1999
die erledg
end
code = reccheck i e count prevu
if ne code 0
rcsay code count
die erledg
end
prevu = fg 2
put st BADC fg 10
put rcs count i
linehash i e
for j ulong 64
put ph j get hx j
end
paycheck sg BADC
i = add e 1
end
ret count
end

fn rcvars count ulong to void
note the head is the digest of the last line, held in ph
for j ulong 64
put hx j get ph j
end
ho = hxkeep
setv vrhead ho 64
setv vrlast sg BADC 64
put st OBN 0
onum count
co = stash
setv vrcount co sg FLEN
setv vrlseq co sg FLEN
k = ulong 1
while le k count bound 2000
recrow cg k k
k = add k 1
end
ro = stash
setv vrrows ro sg FLEN
setvt krcpt vone
say mrcyes
sayn count
say mrchead
sayhx
say tnl
end

fn receipts to void
pbset fledger
if not isfile
put st FRC 0
say mrcno
ret
end
put st FRC 1
put st CXO keep fledger
put st CXL len fledger
off = slurp
n = sg FLEN
put st LDGO off
put st LDGN n
lim = add off n
if ne mg sub lim 1 10
rcsay 7 1
die erledg
end
if eq sg TESTD 0
if or mhas off n pfixu false mhas off n pfixd false
die errel
end
end
count = rcloop off lim
if eq count 0
die erledg
end
put st NREC count
note the head is also written down in the source, so the signed history of this repository records it
pbset fhead
put st CXO keep fhead
put st CXL len fhead
if not isfile
die erhead
end
mark = sg TOP
ho = slurp
okh = false
if eq sg FLEN 65
if eq mg add ho 64 10
okh = phis ho add ho 64
end
end
put st TOP mark
if not okh
die erhead
end
rcvars count
pbset fvsh
put st CXO keep fvsh
put st CXL len fvsh
so = slurp
put st OBN 0
oesc so sg FLEN
vo = stash
setv vrvsh vo sg FLEN
put st CXL 0
end

note ---- Hop release data: content/hop.release.txt, one "key value" per line

fn hopkey ko ulong kl ulong vo ulong ve ulong to bool
note checks one key's value; false for an unknown key or a value outside its rule
vl = sub ve vo
if mist ko kl hkver
ret okset vo ve 1
end
if mist ko kl hkcommit
ret and eq vl 40 okset vo ve 2
end
if mist ko kl hkrid
ret okset vo ve 4
end
if mist ko kl hkzip
ret okset vo ve 1
end
if or mist ko kl hkzsha or mist ko kl hkesha mist ko kl hkins
ret and eq vl 64 okset vo ve 2
end
if or mist ko kl hkbuilt mist ko kl hkmacos
ret okset vo ve 6
end
if or mist ko kl hkdl or mist ko kl hksrc mist ko kl hkbase
if lt vl 12
ret false
end
if not mist vo 8 thttps
ret false
end
ret okset vo ve 7
end
if or mist ko kl hkrepro mist ko kl hkverif
ret or mist vo vl tyes mist vo vl tno
end
if mist ko kl hkcheck
ret and eq vl 20 utcok vo ve
end
if mist ko kl hkseqs
ret okset vo ve 8
end
ret false
end

fn hopline s ulong e ulong to void
c = s
while lt c e bound 16777216
if eq mg c 32
break
end
c = add c 1
end
if or eq c s or ge add c 1 e gt sub c s 40
die erhop
end
if not hopkey s sub c s add c 1 e
put st CXO s
put st CXL sub e s
die erhop
end
ko = keep vhoppre
base = sg TOP
if gt add base 64 MEMSZ
die erfull
end
for j ulong sub c s bound 64
put mem add base j mg add s j
end
put st TOP add base sub c s
setvm ko add len vhoppre sub c s add c 1 sub e add c 1
end

fn hopneed k view uchar * to void
if not vset k
put st CXO keep k
put st CXL len k
die erhop
end
end


fn visyes k view uchar * to bool
v = vlook k
if eq v 0
ret false
end
b = mul sub v 1 4
ret mist vg add b 2 vg add b 3 tyes
end

fn hopseq idx ulong s ulong e ulong to void
note receipt record number idx (1..4) is the decimal in arena s..e
v = mnum s e
if or eq v 0 gt v sg NREC
die erhopr
end
if eq idx 1
setv vhr1 s sub e s
end
if eq idx 2
setv vhr2 s sub e s
end
if eq idx 3
setv vhr3 s sub e s
end
if eq idx 4
setv vhr4 s sub e s
end
end

fn hopseqs to void
v = vlook nseqs
if eq v 0
ret
end
b = mul sub v 1 4
s = vg add b 2
e = add s vg add b 3
nf = split s e 32
if or eq nf 0 gt nf 4
die erhopr
end
if eq sg FRC 0
die erhopr
end
hopseq 1 fg 0 fg 1
if gt nf 1
hopseq 2 fg 2 fg 3
end
if gt nf 2
hopseq 3 fg 4 fg 5
end
if gt nf 3
hopseq 4 fg 6 fg 7
end
end

fn relval k view uchar * to void
note release mode: the value of key k is not a repeated-digit placeholder
v = vlook k
if eq v 0
ret
end
b = mul sub v 1 4
if fewdig vg add b 2 vg add b 3
put st CXO keep k
put st CXL len k
die errel
end
end

fn relhost k view uchar * both bool to void
note release mode: the address of key k is on interplane.io or, when both is set, on hopbot.org
v = vlook k
if eq v 0
ret
end
b = mul sub v 1 4
vo = vg add b 2
vl = vg add b 3
ok = false
if ge vl len hip
ok = mistf vo hip false
end
if both
if ge vl len hhb
if mistf vo hhb false
ok = true
end
end
if mist vo vl vhbased
ok = true
end
end
if not ok
put st CXO keep k
put st CXL len k
die errel
end
end

fn hopzipn to bool
note the installer fetches Hop-VERSION.zip from install_base, so zip_name must be exactly that
z = vlook nzip
w = vlook nver
if or eq z 0 eq w 0
ret false
end
zb = mul sub z 1 4
wb = mul sub w 1 4
zo = vg add zb 2
zl = vg add zb 3
wl = vg add wb 3
if ne zl add wl 8
ret false
end
if not mistf zo thopp false
ret false
end
if not mcmp add zo 4 vg add wb 2 wl
ret false
end
ret mistf add add zo 4 wl xzipx false
end

fn hopinst to void
note content/hop.install.sh, install_sha256 and install_base come together or not at all, and must agree
put st FINS 0
pbset fhins
has = isfile
key = vset nins
base = vset vhbase
if and not has and not key not base
say minsno
ret
end
put st CXO keep fhins
put st CXL len fhins
if or not has or not key not base
die erhins
end
mark = sg TOP
off = slurp
hashm off sg FLEN
put st TOP mark
v = vlook nins
if not hxis vg add mul sub v 1 4 2
die erhins
end
if not hopzipn
die erhins
end
put st FINS 1
setvt khins vone
say minsyes
end

fn insroute r ulong to bool
note route r is the one installer route: hopbot.org /install.sh from content/hop.install.sh, with the install flag
b = mul r 8
if or ne rg add b 6 3 ne rg add b 1 1
ret false
end
if ne sg FINS 1
ret false
end
if not mist rg add b 2 rg add b 3 rinst
ret false
end
ret mist rg add b 4 rg add b 5 fhins
end

fn inspin to bool
note hx, the SHA-256 just taken, equals install_sha256
v = vlook nins
if eq v 0
ret false
end
ret hxis vg add mul sub v 1 4 2
end

fn insfile s ulong e ulong site ulong to bool
note verify: the hopbot.org file install.sh whose SHA-256 (in hx) equals install_sha256.
note It is the one file whose content is not scanned; its bytes are fixed by that fingerprint.
if or ne site 1 ne sg FINS 1
ret false
end
if not mist s sub e s finsout
ret false
end
ret inspin
end

fn hoppay rk view uchar * to ulong
note arena offset of the evidence name (64 hex digits) of the receipt whose number is in placeholder rk; 0 for none
r = vlook rk
if eq r 0
ret 0
end
rb = mul sub r 1 4
n = mnum vg add rb 2 add vg add rb 2 vg add rb 3
s = cg n
nf = split s eol s add s 1024 9
ret fg 10
end

fn hopproof rk view uchar * vk view uchar * fk view uchar * to ulong
note 1 when the receipt named for this row exists and its evidence file holds the row's value
po = hoppay rk
v = vlook vk
if or eq po 0 eq v 0
ret 0
end
pbset fpayd
pbaddm po 64
pbadd ftxt
mark = sg TOP
off = slurp
vb = mul sub v 1 4
found = mfind off sg FLEN vg add vb 2 vg add vb 3
put st TOP mark
if not found
ret 0
end
setvt fk vone
ret 1
end

fn hopdbase to void
note hop.download_base: the folder the zip is served from, when download_url ends in a slash and zip_name
u = vlook ndl
z = vlook nzip
if or eq u 0 eq z 0
ret
end
ub = mul sub u 1 4
uo = vg add ub 2
ul = vg add ub 3
zb = mul sub z 1 4
zl = vg add zb 3
if le ul add zl 1
ret
end
if and eq mg sub sub add uo ul zl 1 47 mcmp sub add uo ul zl vg add zb 2 zl
setv vhdbase uo sub sub ul zl 1
end
end

fn hopbadge to void
note the badge needs all three fingerprint rows backed by a receipt that holds the same value
got = hopproof vhr1 ncommit vhok1
got = add got hopproof vhr2 nzsha vhok2
got = add got hopproof vhr3 nesha vhok3
k4 = hopproof vhr4 ncheck vhok4
if eq got 3
setvt vhbadge vone
end
say mbadge
sayn got
say mbadgeof
end

fn hopcopy to void
note content/hop.copy.txt names the Hop commit the page wording describes; a release must be that commit
pbset fhcopy
put st CXO keep fhcopy
put st CXL len fhcopy
if not isfile
die erhcopy
end
mark = sg TOP
off = slurp
lim = add off sg FLEN
seen = ulong 0
co = ulong 0
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
seen = add seen 1
if ne sub e i 50
die erhcopy
end
if not mistf i tdescr false
die erhcopy
end
co = add i 10
if not okset co e 2
die erhcopy
end
end
end
i = add e 1
end
if ne seen 1
die erhcopy
end
if eq sg TESTD 1
put st TOP mark
say mhcopyt
ret
end
v = vlook ncommit
same = mcmp co vg add mul sub v 1 4 2 40
put st TOP mark
if not same
die erhcopy
end
say mhcopy
end

fn hoprel off ulong n ulong to void
note release mode: no fixture word, no placeholder fingerprint, and addresses on our own two sites
if mhas off n pfix true
die errel
end
relval ncommit
relval nzsha
relval nesha
relval nins
relhost ndl true
relhost nsrc false
relhost vhbase true
end

fn hop to void
pbset fhop
if not isfile
put st FHOP 0
say mhopno
ret
end
put st FHOP 1
put st CXO keep fhop
put st CXL len fhop
off = slurp
lim = add off sg FLEN
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
hopline i e
end
end
i = add e 1
end
put st CXO keep fhop
put st CXL len fhop
hopneed nver
hopneed ncommit
hopneed nrid
hopneed nzip
hopneed nzsha
hopneed nesha
hopneed nbuilt
hopneed nmacos
hopneed ndl
hopneed nsrc
hopneed nrepro
hopneed ncheck
if visyes nrepro
setvt vhrepro vone
end
if visyes nverif
setvt vhverif vone
end
if eq sg TESTD 0
hoprel off sub lim off
end
hopcopy
put st CXO keep fhop
put st CXL len fhop
v = vlook ncommit
setv vhshort vg add mul sub v 1 4 2 12
hopdbase
hopseqs
hopinst
hopbadge
put st CXL 0
setvt khop vone
say mhopyes
end

note ---- live switches: content/live.txt, one line "map yes" or "map no"; lines starting with # are skipped

fn live to void
pbset flive
if not isfile
say mmapno
ret
end
put st CXO keep flive
put st CXL len flive
off = slurp
lim = add off sg FLEN
on = ulong 0
seen = ulong 0
i = off
while lt i lim bound 100000
e = eol i lim
if ne mg i 35
seen = add seen 1
on = 2
if mist i sub e i lmapyes
on = 1
end
if mist i sub e i lmapno
on = 0
end
if or eq on 2 gt seen 1
die erlive
end
end
i = add e 1
end
if ne seen 1
die erlive
end
if eq on 1
setvt kmap vone
say mmapyes
ret
end
say mmapno
end

note ---- routes: content/routes.txt, "kind site route source [hop|receipts|install]" per line.
note Kinds: 1 page, 2 css, 3 svg, 4 raw, 5 receipts payload (verify only), 6 tpl (llms.txt),
note 7 data (a text template, such as papers.json), 8 font (an OpenType file copied as it is),
note 9 png (a PNG image under /public/, copied as it is).

fn rkind s ulong n ulong to ulong
if mist s n kpage
ret 1
end
if mist s n kcss
ret 2
end
if mist s n ksvg
ret 3
end
if mist s n kraw
ret 4
end
if mist s n ktpl
ret 6
end
if mist s n kdata
ret 7
end
if mist s n kfont
ret 8
end
if mist s n kpng
ret 9
end
ret 0
end

fn fbis k ulong t view uchar * to bool
note field k of the last split equals the text t
a = fg mul k 2
ret mist a sub fg add mul k 2 1 a t
end

fn rsite to ulong
if fbis 1 kmain
ret 0
end
if fbis 1 khopbot
ret 1
end
ret 9
end

fn rflag nf ulong to ulong
if ne nf 5
ret 0
end
if fbis 4 khop
ret 1
end
if fbis 4 krcpt
ret 2
end
if fbis 4 kinst
ret 3
end
ret 9
end

fn route1 nr ulong nf ulong to void
note stores the route whose fields are in fb as entry nr
b = mul nr 8
kind = rkind fg 0 sub fg 1 fg 0
site = rsite
flag = rflag nf
if or eq kind 0 or eq site 9 eq flag 9
die erroute
end
if ne mg fg 4 47
die erroute
end
if eq kind 8
if not fontrt fg 4 fg 5
die erroute
end
end
if eq kind 9
if not pngrt fg 4 fg 5
die erroute
end
end
put rt b kind
put rt add b 1 site
put rt add b 2 fg 4
put rt add b 3 sub fg 5 fg 4
put rt add b 4 fg 6
put rt add b 5 sub fg 7 fg 6
put rt add b 6 flag
end

fn fontrt s ulong e ulong to bool
note a font route is /public/fonts/NAME.otf with NAME in A-Z a-z 0-9 . _ -
n = sub e s
if le n add len tfonts len xotf
ret false
end
if not mistf s tfonts false
ret false
end
if not mist sub e len xotf len xotf xotf
ret false
end
ret okset add s len tfonts e 1
end

fn pngrt s ulong e ulong to bool
note a png route is /public/NAME.png with NAME in A-Z a-z 0-9 . _ -
n = sub e s
if le n add len tpubl len xpng
ret false
end
if not mistf s tpubl false
ret false
end
if not mist sub e len xpng len xpng xpng
ret false
end
ret okset add s len tpubl e 1
end

fn routes to void
pbset froutes
put st CXO keep froutes
put st CXL len froutes
off = slurp
lim = add off sg FLEN
nr = ulong 0
i = off
while lt i lim bound 100000
e = eol i lim
if gt e i
if ne mg i 35
nf = split i e 32
if or lt nf 4 or gt nf 5 ge nr 500
die erroute
end
route1 nr nf
nr = add nr 1
end
end
i = add e 1
end
if eq nr 0
die erroute
end
put st NR nr
end

fn enabled r ulong to bool
b = mul r 8
if eq rg add b 1 1
if eq sg FHOP 0
ret false
end
end
flag = rg add b 6
if eq flag 1
ret eq sg FHOP 1
end
if eq flag 2
ret eq sg FRC 1
end
if eq flag 3
ret and eq sg FHOP 1 eq sg FINS 1
end
ret true
end

fn outpb r ulong to void
note pb = output path of route r: site root, the route, and index.html for a directory route
b = mul r 8
pbroot rg add b 1
ro = rg add b 2
rl = rg add b 3
pbaddm ro rl
if eq mg sub add ro rl 1 47
pbadd tindex
end
end

fn manadd site ulong to void
note records "<sha256>  <path below the root>" for the file named by pb, whose bytes are in obuf
hasho
m = sg MANL
s = add rootlen site 1
n = sg PBL
if gt add add m 70 sub n s 524000
die erbig
end
for j ulong 64
put man add m j get hx j
end
put man add m 64 32
put man add m 65 32
m = add m 66
for j ulong sub n s bound 2048
put man add m j get pb add s j
end
m = add m sub n s
put man m 10
put st MANL add m 1
put st NFILE add sg NFILE 1
end

fn wrfile site ulong to void
note st DRY 1 (verify) records the digest without writing, to rebuild the expected manifest
if eq sg DRY 0
mkpar site
wrraw
end
manadd site
end

note ---- pages

fn isdash i ulong e ulong to bool
if ne sub e i 3
ret false
end
ret and eq mg i 45 and eq mg add i 1 45 eq mg add i 2 45
end

fn front off ulong n ulong to ulong
note one placeholder per "key: value" line; returns the offset of the body after the dashes line
lim = add off n
i = off
while lt i lim bound 200
e = eol i lim
if isdash i e
ret add e 1
end
c = i
while lt add c 1 e bound 16777216
if eq mg c 58
break
end
c = add c 1
end
if or eq c i or ge add c 2 e gt sub c i 40
die erfront
end
if ne mg add c 1 32
die erfront
end
setvm i sub c i add c 2 sub e add c 2
i = add e 1
end
die erfront
ret lim
end

fn sitevars site ulong to void
if eq site 0
setv vip 0 0
setvt vismain vone
setv vishop 0 0
else
setvt vip vipurl
setv vismain 0 0
setvt vishop vone
end
end

fn page r ulong to void
note assembles page route r into obuf
b = mul r 8
site = rg add b 1
put st PBL 0
pbaddm rg add b 4 rg add b 5
off = slurp
n = sg FLEN
body = front off n
setv vmain body sub add off n body
setv vroute rg add b 2 rg add b 3
put st OBN 0
if eq site 0
ot tbase0
else
ot tbase1
end
om add rg add b 2 1 sub rg add b 3 1
co = stash
setv vcanon co sg FLEN
sitevars site
if eq site 0
expand sg L0O sg L0N 0
else
expand sg L1O sg L1N 0
end
end

fn sitefont site ulong to bool
note the site builds at least one enabled font route
nr = sg NR
r = ulong 0
while lt r nr bound 512
b = mul r 8
if and eq rg b 8 eq rg add b 1 site
if enabled r
ret true
end
end
r = add r 1
end
ret false
end

fn omcss off ulong n ulong to void
note the stylesheet of a site that builds no font: every byte except each "@font-face{...}" block
note and the line feed after it, so it names no font the site leaves out; a block left open is refused
e = add off n
j = off
while lt j e bound 16777216
hit = false
if le add j len cface e
hit = mistf j cface false
end
if hit
k = add j len cface
while lt k e bound 16777216
if eq mg k 125
break
end
k = add k 1
end
if ge k e
die ercss
end
j = add k 1
if lt j e
if eq mg j 10
j = add j 1
end
end
else
ob mg j
j = add j 1
end
end
end

fn produce r ulong to void
note obuf = the bytes of route r, assembled or copied, and checked
b = mul r 8
kind = rg add b 0
put st SITE rg add b 1
put st CXO rg add b 4
put st CXL rg add b 5
if eq kind 1
page r
else
put st PBL 0
pbaddm rg add b 4 rg add b 5
off = slurp
put st OBN 0
if or eq kind 6 eq kind 7
sitevars rg add b 1
expand off sg FLEN 0
else
if and eq kind 2 not sitefont rg add b 1
omcss off sg FLEN
else
om off sg FLEN
end
end
end
if insroute r
note the released installer is copied as it is and never scanned: its bytes must be the pinned ones
hasho
if not inspin
die erhins
end
ret
end
lint kind
end

fn permchk r ulong to void
note the page at /contribute/ on interplane.io must tell the publisher that publishing is permanent
b = mul r 8
if or ne rg b 1 ne rg add b 1 0
ret
end
if not mist rg add b 2 rg add b 3 rcontrib
ret
end
if not ohas pperm
die erperm
end
put st PERM 1
end

fn robotchk r ulong to void
note the crawl rules of interplane.io are pinned: the bytes that Radicle main 4968bc8 generated
b = mul r 8
if ne rg add b 1 0
ret
end
if ne rg add b 3 11
ret
end
ko = keep frobots
same = mcmp add rg add b 2 1 ko 10
put st TOP ko
if not same
ret
end
hasho
for j ulong 64
if ne get hx j get probots j
die errobot
end
end
end

fn preflight to void
note assembles and checks every enabled route of both sites; nothing is written
nr = sg NR
r = ulong 0
while lt r nr bound 512
if enabled r
put st NV sg NVB
put st TOP sg TOPB
produce r
robotchk r
permchk r
end
r = add r 1
end
put st NV sg NVB
put st TOP sg TOPB
put st CXL 0
if eq sg PERM 0
die erperm
end
end

fn sitemap site ulong to void
put st OBN 0
ot s1
nr = sg NR
r = ulong 0
while lt r nr bound 512
b = mul r 8
if and or eq rg b 1 eq rg b 7 eq rg add b 1 site
if enabled r
ot s2
if eq site 0
ot tbase0
else
ot tbase1
end
om add rg add b 2 1 sub rg add b 3 1
ot s3
end
end
r = add r 1
end
ot s4
pbroot site
pbadd tslash
pbadd fsitemap
put st CXL 0
put st SITE site
lint 4
wrfile site
end

fn payfirst k ulong po ulong to bool
note no earlier record names the payload at arena po
j = ulong 1
while lt j k bound 2000
sj = cg j
ej = eol sj add sj 1024
nj = split sj ej 9
if mcmp fg 10 po 64
ret false
end
j = add j 1
end
ret true
end

fn paycopy po ulong to void
mark = sg TOP
pbset fpayd
pbaddm po 64
pbadd ftxt
put st CXO po
put st CXL 64
off = slurp
put st OBN 0
om off sg FLEN
put st TOP mark
lint 5
pbroot 0
pbadd tslash
pbadd fpayout
pbaddm po 64
pbadd ftxt
wrfile 0
end

fn rcfiles to void
note copies the ledger and every payload file named in it, unchanged, into the main output
if eq sg FRC 0
ret
end
put st SITE 0
put st CXO keep fledger
put st CXL len fledger
put st OBN 0
om sg LDGO sg LDGN
lint 4
pbroot 0
pbadd tslash
pbadd fledout
wrfile 0
k = ulong 1
n = sg NREC
while le k n bound 2000
s = cg k
e = eol s add s 1024
nf = split s e 9
po = fg 10
if payfirst k po
paycopy po
end
k = add k 1
end
end

fn mancmp site ulong to void
note verify: the manifest in the output equals, byte for byte, the one this source builds
m = sg MANL
pbroot site
pbadd tslash
pbadd fmanif
put st CXL 0
mark = sg TOP
off = slurp
same = eq sg FLEN m
if same
for j ulong m bound 524288
if ne mg add off j get man j
same = false
end
end
end
put st TOP mark
put st MANL 0
put st NFILE 0
put st NPAGE 0
if not same
put st CXO keep fmanif
put st CXL len fmanif
die erset
end
end

fn manwrite site ulong to void
note writes manifest.sha256 (sha256sum -c format) and prints the site summary
if eq sg DRY 1
mancmp site
ret
end
put st OBN 0
m = sg MANL
for j ulong m bound 524288
ob get man j
end
hasho
pbroot site
pbadd tslash
pbadd fmanif
wrraw
if eq site 0
say mbuilt0
else
say mbuilt1
end
sayn sg NPAGE
say mfiles
sayn sg NFILE
say mmsha
sayhx
say tnl
put st MANL 0
put st NFILE 0
put st NPAGE 0
end

fn mkroot site ulong to void
pbroot site
k = makedir pb 0 sg PBL 493
if ne k 0
put st CXL 0
die erdir
end
end

fn writesite site ulong to void
note pass 1 for one site: every enabled route of that site, then generated files and the manifest
nr = sg NR
r = ulong 0
while lt r nr bound 512
if eq rg add mul r 8 1 site
if enabled r
put st NV sg NVB
put st TOP sg TOPB
produce r
outpb r
wrfile site
if eq rg mul r 8 1
put st NPAGE add sg NPAGE 1
end
end
end
r = add r 1
end
put st NV sg NVB
put st TOP sg TOPB
if eq site 0
rcfiles
end
if eq sg TESTD 1
put st OBN 0
ot ttestd
pbroot site
pbadd tslash
pbadd ftestd
put st CXL 0
put st SITE site
lint 4
wrfile site
end
sitemap site
manwrite site
end

fn kindof s ulong e ulong to ulong
note check kind of an output path (arena s..e) by its ending
n = sub e s
if mist s n fllms
ret 6
end
if ge n 5
if mist sub e 5 5 xhtml
ret 1
end
end
if ge n 4
if mist sub e 4 4 xcss
ret 2
end
if mist sub e 4 4 xsvg
ret 3
end
end
if gt n 17
if mist s 17 fpayout
ret 5
end
end
if ge n 4
if mist sub e 4 4 xotf
ret 8
end
end
if ge n 4
if mist sub e 4 4 xpng
ret 9
end
end
ret 4
end


fn inman po ulong pl ulong dir bool to bool
note the manifest (arena st MNO..st MNL) names the file at arena po..po+pl, or, for a directory, a file inside it
lim = sg MNL
i = sg MNO
while lt i lim bound 100000
e = eol i lim
s = add i 66
n = sub e s
if dir
if gt n pl
if mcmp s po pl
if eq mg add s pl 47
ret true
end
end
end
else
if eq n pl
if mcmp s po pl
ret true
end
end
end
i = add e 1
end
ret false
end

fn lsone site ulong ns ulong nl ulong ty uchar to void
note one directory entry (name at dbuf ns, length nl, type ty) of the directory st DRO, st DRL
dl = sg DRL
base = sg TOP
if gt add add base dl add nl 2 MEMSZ
die erfull
end
p = base
if gt dl 0
for j ulong dl bound 2048
put mem add p j mg add sg DRO j
end
p = add p dl
put mem p 47
p = add p 1
end
for j ulong nl bound 4096
put mem add p j get dbuf add ns j
end
p = add p nl
pl = sub p base
ok = false
if eq ty 8
ok = inman base pl false
if eq dl 0
if mist base pl fmanif
ok = true
end
end
end
if eq ty 4
ok = inman base pl true
end
if not ok
put st CXO base
put st CXL pl
die erset
end
end

fn dnlen e ulong rl ulong to ulong
note length of the name in the getdents64 record at dbuf e, whose record length is rl
nl = ulong 0
while lt add 19 nl rl bound 4096
if eq get dbuf add add e 19 nl 0
break
end
nl = add nl 1
end
ret nl
end

fn dotdir e ulong nl ulong to bool
note the entry is . or ..
if ne get dbuf add e 19 46
ret false
end
if eq nl 1
ret true
end
if eq nl 2
ret eq get dbuf add e 20 46
end
ret false
end

fn lsrecs site ulong r ulong to void
note walks the getdents64 records in dbuf: inode 8, offset 8, record length 2, type 1, name ending in a zero
e = ulong 0
while lt e r bound 4097
lo = ulong get dbuf add e 16
hi = ulong get dbuf add e 17
rl = add lo mul hi 256
if or eq rl 0 gt add e rl r
die erset
end
nl = dnlen e rl
if not dotdir e nl
lsone site add e 19 nl get dbuf add e 18
end
e = add e rl
end
end

fn lsdir site ulong to void
note every entry of one output directory is a file the manifest names or a directory that holds one.
note 49152 is O_RDONLY, O_DIRECTORY and O_NOFOLLOW on Linux AArch64.
pbroot site
if gt sg DRL 0
pbadd tslash
pbaddm sg DRO sg DRL
end
put st CXL 0
fd = fopen pb 0 sg PBL 49152 0
if lt fd 0
die erset
end
go = true
while go bound 100000
r = getdnts int fd dbuf 0 4096
if lt r 0
k = fclose int fd
die erset
end
if eq r 0
go = false
else
lsrecs site ulong r
end
end
k = fclose int fd
end

fn lsall site ulong mo ulong lim ulong to void
note the root and every directory above a manifest entry; an entry the manifest does not explain refuses
put st MNO mo
put st MNL lim
put st DRO 0
put st DRL 0
lsdir site
i = mo
while lt i lim bound 100000
e = eol i lim
s = add i 66
j = s
while lt j e bound 2048
if eq mg j 47
put st DRO s
put st DRL sub j s
lsdir site
end
j = add j 1
end
i = add e 1
end
end

fn rewalk to void
note walks the receipts chain again from the bytes in the output, with the evidence files in the output
put st TOP sg TOPB
put st CXO keep fledout
put st CXL len fledout
pbroot 0
pbadd tslash
pbadd fledout
off = slurp
n = sg FLEN
if ne mg sub add off n 1 10
rcsay 7 1
die erledg
end
put st PAYO 1
count = rcloop off add off n
put st PAYO 0
v = vlook vrhead
ho = vg add mul sub v 1 4 2
same = and eq count sg NREC phis ho add ho 64
put st TOP sg TOPB
put st CXL 0
note the record offsets go back to the source ledger, which the expected-manifest pass reads
count = rcloop sg LDGO add sg LDGO sg LDGN
if not same
die erledg
end
put st CXL 0
end

fn nohop to void
note without Hop data there is no second site: an output directory for it is an extra
pbroot 1
fd = fopen pb 0 sg PBL 49152 0
if ge fd 0
k = fclose int fd
put st CXL 0
die erset
end
end

fn versite site ulong to void
note re-reads the site's manifest and every file it names: digest, policy, links, fragments
put st SITE site
put st CXL 0
pbroot site
pbadd tslash
pbadd fmanif
mo = slurp
mn = sg FLEN
put st TOPB sg TOP
lim = add mo mn
files = ulong 0
i = mo
while lt i lim bound 100000
e = eol i lim
if lt sub e i 67
die erman
end
put st TOP sg TOPB
pbroot site
pbadd tslash
pbaddm add i 66 sub e add i 66
put st CXO add i 66
put st CXL sub e add i 66
off = slurp
n = sg FLEN
hashm off n
if not hxis i
die erman
end
put st OBN 0
om off n
put st TOP sg TOPB
if not insfile add i 66 e site
lint kindof add i 66 e
end
files = add files 1
i = add e 1
end
if eq files 0
die erman
end
put st TOP sg TOPB
lsall site mo lim
if eq site 0
if eq sg FRC 1
rewalk
end
end
if eq site 0
say mver0
else
say mver1
end
sayn files
say tnl
end

note ---- commands

fn argis t view uchar * n ulong to bool
if ne n len t
ret false
end
for j ulong n bound 64
if ne get arg j get t j
ret false
end
end
ret true
end

fn rootok n ulong site ulong to void
note the output path has no space, backslash or dot-dot and does not end in a slash
for j ulong n bound 512
c = uchar 0
if eq site 0
c = get root0 j
else
c = get root1 j
end
if or le c 32 eq c 92
die erarg
end
if eq c 46
if lt add j 1 n
d = uchar 0
if eq site 0
d = get root0 add j 1
else
d = get root1 add j 1
end
if eq d 46
die erarg
end
end
end
if eq add j 1 n
if eq c 47
die erarg
end
end
end
end

fn rootargs to void
note the two output directories follow the command, or the --test-data flag when it is given
k = argread 2 root0 0 512
if eq sg TESTD 1
k = argread 3 root0 0 512
end
if or le k 0 ge k 500
die erarg
end
put st R0L ulong k
rootok ulong k 0
k = argread 3 root1 0 512
if eq sg TESTD 1
k = argread 4 root1 0 512
end
if or le k 0 ge k 500
die erarg
end
put st R1L ulong k
rootok ulong k 1
end

fn omtxt off ulong n ulong to void
note copies arena text into obuf for a plain-text file: the trade mark entity becomes (TM)
i = ulong 0
while lt i n bound 8192
tm = false
if le add i 7 n
tm = mistf add off i ptrade false
end
if tm
ot ttm
i = add i 7
else
ob mg add off i
i = add i 1
end
end
end

fn pageline r ulong to void
note one llms.txt line for page route r: - [title](address): description
b = mul r 8
put st PBL 0
pbaddm rg add b 4 rg add b 5
put st CXO rg add b 4
put st CXL rg add b 5
off = slurp
body = front off sg FLEN
t = vlook vtitle
d = vlook vdesc
if or eq t 0 eq d 0
die erfront
end
ot pl1
tb = mul sub t 1 4
omtxt vg add tb 2 vg add tb 3
ot pl2
ot tbase0
om add rg add b 2 1 sub rg add b 3 1
ot pl3
db = mul sub d 1 4
omtxt vg add db 2 vg add db 3
ob 10
end

fn pagelist to void
note the placeholder pages: every enabled interplane.io page, in routes order
put st OBN 0
nr = sg NR
r = ulong 0
while lt r nr bound 512
b = mul r 8
if and eq rg b 1 eq rg add b 1 0
if enabled r
mark = sg TOP
nv = sg NV
pageline r
put st TOP mark
put st NV nv
end
end
r = add r 1
end
po = stash
setv vpages po sg FLEN
end

fn setup to void
note loads everything a build or a verify needs: data, flags, layouts and routes
luminit
put st TOP 0
put st NV 0
put st CXL 0
if eq sg TESTD 1
setvt ktestd vone
say mtest
end
yard
papers
receipts
hop
live
routes
pbset flay0
put st CXO keep flay0
put st CXL len flay0
lo = slurp
put st L0O lo
put st L0N sg FLEN
pbset flay1
put st CXO keep flay1
put st CXL len flay1
lo = slurp
put st L1O lo
put st L1N sg FLEN
put st CXL 0
pagelist
put st CXL 0
put st NVB sg NV
put st TOPB sg TOP
end

fn dobuild to void
rootargs
setup
cssload
contrast
put st LCHK 0
preflight
mkroot 0
writesite 0
if eq sg FHOP 1
mkroot 1
writesite 1
end
put st LCHK 1
versite 0
if eq sg FHOP 1
versite 1
end
say mbpass
end

fn doverify to void
rootargs
setup
put st LCHK 1
versite 0
if eq sg FHOP 1
versite 1
else
nohop
end
note the expected manifest of each site, rebuilt from the source without writing, equals the one found
put st LCHK 0
put st DRY 1
put st MANL 0
put st NFILE 0
put st NPAGE 0
writesite 0
if eq sg FHOP 1
writesite 1
end
put st DRY 0
say mvpass
end

fn main to int
ac = argcnt
if lt ac 2
say tusage
ret 2
end
n = argread 1 arg 0 64
if le n 0
say tusage
ret 2
end
if argis ccontr ulong n
if ne ac 2
say tusage
ret 2
end
luminit
put st TOP 0
put st CXL 0
cssload
contrast
ret 0
end
cmd = ulong 0
if argis cbuild ulong n
cmd = 1
end
if argis cverify ulong n
cmd = 2
end
if eq cmd 0
say tusage
ret 2
end
put st TESTD 0
put st DRY 0
put st PAYO 0
if eq ac 5
n = argread 2 arg 0 64
if le n 0
say tusage
ret 2
end
if not argis ctestd ulong n
say tusage
ret 2
end
put st TESTD 1
else
if ne ac 4
say tusage
ret 2
end
end
if eq cmd 1
dobuild
else
doverify
end
ret 0
end

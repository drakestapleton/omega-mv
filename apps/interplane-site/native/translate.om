note Script-free reader support. Uses the builder arena/output and its existing checked capacities.
note No translation, browser code, storage or endpoints. Transform and validate share lexical rules.
text trrad "rad:"
text trdid "did:"
text trzero ""
text trno " translate=\"no\""
text trspan "<span translate=\"no\">"
text trend "</span>"
text tren "<span lang=\"en\">"
text trattr "translate"
text trclass "class"
text trlang "lang"
text trcode "code"
text trpre "pre"
text trkbd "kbd"
text trsamp "samp"
text trbrand "brand"
text trmono "mono"
text trdigest "digest"
text trfiles "files"
text trtitle "title"
text trnov "no"
text trerr "translation protection missing or overridden (hash, ID, file, command or code)"
text trlayout "translation links need a head, header and footer"
text trtxt "index.txt"
text trjson "index.json"
text trhtml ".html"
text trtxext ".txt"
text trjsext ".json"
text tralt1 "<link rel=\"alternate\" type=\"text/plain\" href=\""
text tralt2 "<link rel=\"alternate\" type=\"application/json\" href=\""
text tralt3 "\">\n"
text trhead "</header>"
text trhlink "<div class=\"shell\"><a class=\"text-link\" lang=\"en\" href=\"/translate/\">Read in your language</a></div>"
text trflink "<p class=\"foot-fine\" lang=\"en\"><a href=\"/translate/\">Read in your language</a> | <a href=\""
text trtextl "\">Plain text</a> | <a href=\""
text trjsonl "\">JSON source</a></p>\n"
text trj1 "{\"source_url\":\""
text trj2 "\",\"lang\":\""
text trj3 "\",\"text\":\""
text trj4 "\",\"html\":\""
text trj5 "\"}\n"
text trcspnm "content-security-policy:"
text trscript "script-src"
text trnone "'none'"
text trcspbad "served response must have script-src 'none' without other script sources or overrides"
note trq: attribute value offset/length, depth, protected depth, explicit lang depth, raw depth.
global trq ulong 6

fn trat a ulong e ulong t view uchar * to bool
if gt add a len t e
ret false
end
ret mistf a t false
end

fn trname a ulong e ulong to ulong
k = a
while lt k e bound 9223372036854775807
if not namechar mg k
break
end
k = add k 1
end
ret k
end

fn trtagend a ulong e ulong to ulong
q = uchar 0
k = a
while lt k e bound 9223372036854775807
c = mg k
if ne q 0
if eq c q
q = 0
end
else
if or eq c 34 eq c 39
q = c
else
if eq c 62
ret add k 1
end
end
end
k = add k 1
end
die ermark
ret e
end

fn trget a ulong e ulong key view uchar * to bool
note Parse attributes, not substrings inside other attribute values. Markup has already been checked.
k = a
put trq 0 0
put trq 1 0
while lt k e bound 9223372036854775807
if space mg k
k = add k 1
continue
end
s = k
k = trname k e
if eq s k
ret false
end
hit = mist s sub k s key
while lt k e bound 9223372036854775807
if not space mg k
break
end
k = add k 1
end
if eq mg k 61
k = add k 1
while space mg k bound 9223372036854775807
k = add k 1
end
q = mg k
k = add k 1
v = k
while lt k e bound 9223372036854775807
if eq mg k q
break
end
k = add k 1
end
if hit
put trq 0 v
put trq 1 sub k v
ret true
end
k = add k 1
end
end
ret false
end

fn trclasses a ulong e ulong to bool
if not trget a e trclass
ret false
end
k = get trq 0
lim = add k get trq 1
while lt k lim bound 9223372036854775807
if space mg k
k = add k 1
continue
end
s = k
while lt k lim bound 9223372036854775807
if space mg k
break
end
k = add k 1
end
n = sub k s
if or mist s n trbrand mist s n trmono
ret true
end
if or mist s n trdigest mist s n trfiles
ret true
end
end
ret false
end

fn trmust a ulong n ulong e ulong to bool
z = sub n a
if or mist a z trcode mist a z trpre
ret true
end
if or mist a z trkbd mist a z trsamp
ret true
end
ret trclasses n e
end

fn trvoid a ulong n ulong e ulong to bool
if eq mg sub e 2 47
ret true
end
z = sub n a
if or mist a z vtmeta mist a z vtlink
ret true
end
if or mist a z vtbr mist a z vtimg
ret true
end
if or mist a z vthr mist a z vtwbr
ret true
end
ret or mist a z vtinput or mist a z vtsource mist a z vtcol
end

fn trwc c uchar to bool
ret or alnum c or eq c 95 or eq c 45 or eq c 46 or eq c 47 or eq c 64 eq c 58
end

fn trtoken a ulong e ulong to bool
note Protect a hex run of 7+ (upper or lower), identifier prefixes, and path/file-like words.
k = a
hxrun = ulong 0
digit = false
dot = false
while lt k e bound 9223372036854775807
c = mg k
if lt hexv c 16
hxrun = add hxrun 1
if and ge c 48 le c 57
digit = true
end
if and ge hxrun 7 digit
ret true
end
else
hxrun = 0
digit = false
end
if or eq c 46 eq c 47
dot = true
end
k = add k 1
end
if dot
ret true
end
if or trat a e trrad trat a e trdid
ret true
end
if ge sub e a 29
if eq mg a 122
ret true
end
end
ret false
end

fn trword s ulong k ulong mode ulong to void
t = k
while gt t s bound 9223372036854775807
c = mg sub t 1
if not or eq c 46 or eq c 58 or eq c 45 eq c 47
break
end
t = sub t 1
end
hit = false
if gt t s
hit = trtoken s t
end
if and hit eq get trq 3 0
if eq mode 1
die trerr
end
ot trspan
om s sub t s
ot trend
om t sub k t
else
if eq mode 0
om s sub k s
end
end
end

fn trtext a ulong e ulong mode ulong to void
k = a
while lt k e bound 9223372036854775807
if not trwc mg k
if eq mode 0
ob mg k
end
k = add k 1
continue
end
s = k
while lt k e bound 9223372036854775807
if not trwc mg k
break
end
k = add k 1
end
trword s k mode
end
end

fn tropen a ulong n ulong e ulong mode ulong to void
must = and trmust a n e eq get trq 3 0
has = trget n e trattr
no = false
if has
no = mist get trq 0 get trq 1 trnov
if and not no or must ne get trq 3 0
die trerr
end
end
if and must not no
if eq mode 1
die trerr
end
no = true
end
if eq mode 0
om sub a 1 add sub n a 1
if and must not has
ot trno
end
om n sub e n
end
if trvoid a n e
ret
end
d = add get trq 2 1
put trq 2 d
if and no eq get trq 3 0
put trq 3 d
end
if and eq get trq 4 0 trget n e trlang
put trq 4 d
end
if mist a sub n a trtitle
put trq 5 d
end
end

fn trwalk a ulong e ulong mode ulong zh bool to void
for j ulong 6
put trq j 0
end
k = a
while lt k e bound 9223372036854775807
if eq mg k 60
if trat k e tcmo
q = mfirst k e tcme
if eq q e
die ermark
end
q = add q len tcme
if eq mode 0
om k sub q k
end
k = q
continue
end
q = trtagend k e
j = add k 1
if eq mg j 47
d = get trq 2
if eq get trq 3 d
put trq 3 0
end
if eq get trq 4 d
put trq 4 0
end
if eq get trq 5 d
put trq 5 0
end
if gt d 0
put trq 2 sub d 1
end
if eq mode 0
om k sub q k
end
else
n = trname j q
if eq n j
if eq mode 0
om k sub q k
end
else
tropen j n q mode
end
end
k = q
else
s = k
while lt k e bound 9223372036854775807
if eq mg k 60
break
end
k = add k 1
end
if ne get trq 5 0
if eq mode 0
om s sub k s
end
else
trtext s k mode
end
end
end
end

fn trcheck to void
note Validation is run on reread output too; a changed manifest does not bypass it.
mark = sg TOP
n = sg OBN
a = stash
trwalk a add a n 1 eq sg ZHP 1
put st TOP mark
put st OBN n
end

fn trurl r ulong suffix view uchar * absolute bool to void
b = mul r 8
if absolute
zurl r
else
om rg add b 2 rg add b 3
end
ot suffix
end

fn trlinks r ulong to void
a = stash
e = add a sg FLEN
h = mfirst a e zhead
v = mfirst a e trhead
f = mlast a e zfoot
if or eq h e or eq v e eq f e
die trlayout
end
om a sub h a
ot tralt1
trurl r trtxt false
ot tralt3
ot tralt2
trurl r trjson false
ot tralt3
om h sub v h
ot trhlink
om v sub f v
ot trflink
trurl r trtxt false
ot trtextl
trurl r trjson false
ot trjsonl
om f sub e f
end

fn trpage r ulong to void
trlinks r
note Run the existing text policy and markup checks first so refused input keeps its diagnostic.
polscan true eq sg ZHP 1
chkmark true
a = stash
e = add a sg FLEN
trwalk a e 0 zhpath r
end

fn trjesc a ulong n ulong to void
for k ulong n bound 9223372036854775807
c = mg add a k
if or eq c 34 eq c 92
ob 92
ob c
else
if lt c 32
ob 92
ob 117
ob 48
ob 48
ob hexc shr ulong c 4
ob hexc and ulong c 15
else
ob c
end
end
end
end

text trmaino "<main"
text trmaine "</main>"
text trbr "br"
text trp "p"
text trli "li"
text trtd "td"
text trdiv "div"
text trsect "section"
text trrow "tr"
text trh1 "h1"
text trh2 "h2"
text trh3 "h3"
text trsvg "svg"
text trapos "&apos;"
text trnbsp "&nbsp;"
text trarr "&rarr;"
text trldq "&ldquo;"
text trrdq "&rdquo;"
text tromega "&Omega;"
text trmidd "&middot;"
text trback "```\n"

fn trnl to void
if gt sg OBN 0
if ne og sub sg OBN 1 10
ob 10
end
end
end

fn trentity k ulong e ulong to ulong
if trat k e hamp
ob 38
ret add k len hamp
end
if trat k e hlt
ob 60
ret add k len hlt
end
if trat k e hgt
ob 62
ret add k len hgt
end
if trat k e hquot
ob 34
ret add k len hquot
end
if trat k e trapos
ob 39
ret add k len trapos
end
if trat k e ptrade
ot ttm
ret add k len ptrade
end
if trat k e trnbsp
ob 32
ret add k len trnbsp
end
if trat k e trarr
ob 45
ob 62
ret add k len trarr
end
if or trat k e trldq trat k e trrdq
ob 34
ret add k len trldq
end
if trat k e tromega
ob 206
ob 169
ret add k len tromega
end
if trat k e trmidd
ob 194
ob 183
ret add k len trmidd
end
ob mg k
ret add k 1
end

fn trblock a ulong n ulong to bool
z = sub n a
if or mist a z trp mist a z trli
ret true
end
if or mist a z trdiv mist a z trsect
ret true
end
if or mist a z trrow mist a z trbr
ret true
end
if or mist a z trh1 mist a z trh2
ret true
end
ret mist a z trh3
end

fn trplain a ulong e ulong to void
note Text from the same complete HTML; tags do not turn inline words into separate words, but an
note element that starts right after a sibling closed is set apart, as a reader sees adjacent links.
n = mfirst a e trmaino
if eq n e
die erhtml
end
k = trtagend n e
lim = mfirst k e trmaine
if eq lim e
die erhtml
end
pre = false
skip = false
sep = false
while lt k lim bound 9223372036854775807
if eq mg k 60
q = trtagend k lim
j = add k 1
cl = eq mg j 47
if cl
j = add j 1
end
n = trname j q
if mist j sub n j trsvg
skip = not cl
end
if mist j sub n j trpre
trnl
ot trback
pre = not cl
end
if and not skip trblock j n
trnl
sep = false
else
if and and sep not cl not skip
if gt sg OBN 0
if not space og sub sg OBN 1
ob 32
end
end
sep = false
end
if and cl not skip
sep = true
end
end
if mist j sub n j trtd
ob 9
end
k = q
else
if skip
k = add k 1
else
if eq mg k 38
sep = false
k = trentity k lim
else
c = mg k
if and not pre space c
if gt sg OBN 0
if not space og sub sg OBN 1
ob 32
end
end
else
sep = false
ob c
end
k = add k 1
end
end
end
end
trnl
end

fn trwrite r ulong suffix view uchar * to void
b = mul r 8
pbroot rg add b 1
pbaddm rg add b 2 rg add b 3
pbadd suffix
wrfile rg add b 1
end

fn trforms r ulong to void
note HTML already passed policy checks; derivative bytes are checked by exact manifest replay.
a = stash
n = sg FLEN
trplain a add a n
trwrite r trtxt
p = stash
pn = sg FLEN
ot trj1
trurl r trzero true
ot trj2
if zhpath r
ot zzh
else
ot zen
end
ot trj3
trjesc p pn
ot trj4
trjesc a n
ot trj5
trwrite r trjson
end

fn trformpath s ulong e ulong to bool
if ge sub e s len trtxt
if mist sub e len trtxt len trtxt trtxt
ret true
end
end
if ge sub e s len trjson
if mist sub e len trjson len trjson trjson
ret true
end
end
ret false
end

fn trcli to void
n = argread 2 pb 0 len pb
if le n 0
die erarg
end
put st PBL ulong n
put st TOP 0
a = slurp
sz = sg FLEN
put st OBN 0
om a sz
put st CXO a
put st CXL 0
chkmark true
trcheck
end

fn trheaders to void
n = argread 2 pb 0 len pb
if le n 0
die erarg
end
put st PBL ulong n
put st TOP 0
a = slurp
lim = add a sg FLEN
found = false
k = a
while lt k lim bound 9223372036854775807
e = eol k lim
if trat k e trcspnm
p = add k len trcspnm
while lt p e bound 9223372036854775807
while lt p e bound 9223372036854775807
if not or space mg p eq mg p 59
break
end
p = add p 1
end
s = p
while lt p e bound 9223372036854775807
if or space mg p eq mg p 59
break
end
p = add p 1
end
is = mist s sub p s trscript
if and trat s p trscript not is
die trcspbad
end
if is
while lt p e bound 9223372036854775807
if not space mg p
break
end
p = add p 1
end
if not trat p e trnone
die trcspbad
end
p = add p len trnone
while lt p e bound 9223372036854775807
if not space mg p
break
end
p = add p 1
end
if lt p e
if ne mg p 59
die trcspbad
end
end
found = true
end
while lt p e bound 9223372034775807
if eq mg p 59
break
end
p = add p 1
end
end
end
k = add e 1
end
if not found
die trcspbad
end
end

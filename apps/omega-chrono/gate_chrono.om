end
if chg_prep_mutant chg_m2_old chg_m2_new 321
chg_chk_mut_rc chg_f_pwatt chg_f_p80 0 321
end
if chg_prep_mutant chg_m3_old chg_m3_new 322
chg_chk_mut_rc chg_f_pood chg_empty 0 322
end
end

fn main to int
if chg_scan_rwx
chg_werr chg_e_rwx
ret int CHG_ERR_RWX
end
put chg_checks 0 0
put chg_ctrls 0 0
put chg_caught 0 0
put chg_fails 0 0
put chg_mut_kills 0 0
put chg_cmp_ok 0 0

if and ne argcnt 1 ne argcnt 4
chg_werr chg_e_use
ret int CHG_ERR_ARG
end

chg_run_inproc

if eq argcnt 4
ro = argread 1 chg_omc 0 1000
rr = argread 2 chg_root 0 1000
rs = argread 3 chg_scr 0 1000
if or le ro 0 or le rr 0 le rs 0
chg_werr chg_e_use
ret int CHG_ERR_ARG
end
put chg_omc_l 0 ulong ro
put chg_root_l 0 ulong rr
put chg_scr_l 0 ulong rs
z = makedir chg_scr 0 get chg_scr_l 0 493
if not chg_verify_omc_pin
chg_werr chg_e_pin
ret int CHG_ERR_PIN
end
chg_run_live_tests
end

if ne get chg_fails 0 0
ret 1
end
if ne get chg_caught 0 get chg_ctrls 0
ret 1
end
chg_wrt chg_m_p1
chg_num get chg_checks 0
chg_wrt chg_m_p2
chg_num get chg_ctrls 0
chg_wrt chg_m_p3
chg_num get chg_caught 0
chg_wrt chg_m_p4
chg_num get chg_mut_kills 0
chg_wrt chg_m_p5
chg_num get chg_cmp_ok 0
chg_wrt chg_m_p6
ret 0
end

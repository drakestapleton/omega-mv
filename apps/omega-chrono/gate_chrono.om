c1 = chg_compile_src chg_s_src chg_s_b1 chg_s_e1
c2 = chg_compile_src chg_s_src chg_s_b2 chg_s_e2
chg_assert and eq c1 0 eq c2 0 301
zp = chg_set_pa_scr chg_s_e1
es1 = chg_stat_pa_size
zp = chg_set_pa_scr chg_s_e2
es2 = chg_stat_pa_size
chg_assert and eq es1 0 eq es2 0 302
sz1 = chg_hash_scr_file chg_s_b1 1
sz2 = chg_hash_scr_file chg_s_b2 2
det_ok = and gt sz1 10000 eq sz1 sz2
for j ulong 32
if ne get chg_h1 j get chg_h2 j
det_ok = false
end
end
if det_ok
put chg_cmp_ok 0 1
end
chg_assert det_ok 303
ret and eq c1 0 eq c2 0
end


note ==== Output & Diagnostic Helpers ====

fn chg_wrt s view uchar * to void
w = write 1 s 0 len s
end

fn chg_werr s view uchar * to void
w = write 2 s 0 len s
end

fn chg_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put chg_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 chg_dig p sub 24 p
ret
end
end
end

fn chg_note_fail tag ulong to void
put chg_fails 0 add get chg_fails 0 1
chg_wrt chg_m_fail
chg_num tag
chg_wrt chg_nl
end

fn chg_assert ok bool tag ulong to void
put chg_checks 0 add get chg_checks 0 1
if not ok
chg_note_fail tag
end
end

fn chg_assert_ctrl killed bool tag ulong to void
put chg_ctrls 0 add get chg_ctrls 0 1
if killed
put chg_caught 0 add get chg_caught 0 1
else
chg_note_fail tag
end
end

fn chg_arg_eq idx ulong lit view uchar * to bool
rn = argread idx chg_arg 0 1000
if ne rn long len lit
ret false
end
for i ulong len lit bound 1024
if ne get chg_arg i get lit i
ret false
end
end
ret true
end

fn chg_scan_rwx to bool
n = ulong argcnt
for i ulong n bound 64
if chg_arg_eq i chg_t_rwx
ret true
end
end
ret false
end

note ==== Path & Buffer Helpers ====

fn chg_set_pa_root suf view uchar * to ulong
rl = get chg_root_l 0
for i ulong rl bound 1024
put chg_pa i get chg_root i
end
sl = len suf
for j ulong sl bound 512
put chg_pa add rl j get suf j
end
put chg_pal 0 add rl sl
ret add rl sl
end

fn chg_set_pa_scr suf view uchar * to ulong
rl = get chg_scr_l 0
for i ulong rl bound 1024
put chg_pa i get chg_scr i
end
sl = len suf
for j ulong sl bound 512
put chg_pa add rl j get suf j
end
put chg_pal 0 add rl sl
ret add rl sl
end

fn chg_set_pa_scr2 s1 view uchar * s2 view uchar * to ulong
rl = get chg_scr_l 0
for i ulong rl bound 1024
put chg_pa i get chg_scr i
end
p = rl
n1 = len s1
for j ulong n1 bound 512
put chg_pa add p j get s1 j
end
p = add p n1
n2 = len s2
for k ulong n2 bound 512
put chg_pa add p k get s2 k
end
p = add p n2
put chg_pal 0 p
ret p
end

fn chg_set_pb_lit s view uchar * to ulong
n = len s
for i ulong n bound 1024
put chg_pb i get s i
end
put chg_pbl 0 n
ret n
end

fn chg_set_pb_scr suf view uchar * to ulong
rl = get chg_scr_l 0
for i ulong rl bound 1024
put chg_pb i get chg_scr i
end
sl = len suf
for j ulong sl bound 512
put chg_pb add rl j get suf j
end
put chg_pbl 0 add rl sl
ret add rl sl
end

fn chg_set_pc_scr suf view uchar * to ulong
rl = get chg_scr_l 0
for i ulong rl bound 1024
put chg_pc i get chg_scr i
end
sl = len suf
for j ulong sl bound 512
put chg_pc add rl j get suf j
end
put chg_pcl 0 add rl sl
ret add rl sl
end

fn chg_read_fd_sh fd long to long
if lt fd 0
ret -1
end
tot = ulong 0
while lt tot 16777216 bound 2048
k = read int fd sh_dat tot sub 16777216 tot
if lt k 0
z = fclose int fd
ret -1
end
if eq k 0
break
end
tot = add tot ulong k
end
z = fclose int fd
ret long tot
end

fn chg_read_omc_sh to long
ret chg_read_fd_sh fopen chg_omc 0 get chg_omc_l 0 0 0
end

fn chg_read_pa_sh to long
ret chg_read_fd_sh fopen chg_pa 0 get chg_pal 0 0 0
end

fn chg_read_pa_out to ulong
put chg_outl 0 0
fd = fopen chg_pa 0 get chg_pal 0 0 0
if lt fd 0
ret 0
end
tot = ulong 0
while lt tot 16384 bound 256
k = read int fd chg_out tot sub 16384 tot
if le k 0
break
end
tot = add tot ulong k
end
z = fclose int fd
put chg_outl 0 tot
ret tot
end

fn chg_has_sub pat view uchar * to bool
hl = get chg_outl 0
nl = len pat
if or eq nl 0 gt nl hl
ret false
end
lim = add sub hl nl 1
for i ulong lim bound 16384
ok = true
for j ulong nl bound 512
if ne get chg_out add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn chg_append_root_file suf view uchar * to bool
zp = chg_set_pa_root suf
fd = fopen chg_pa 0 get chg_pal 0 0 0
if lt fd 0
ret false
end
pos = get chg_srcl 0
while lt pos 524000 bound 512
k = read int fd chg_src pos sub 524000 pos
if lt k 0
z = fclose int fd
ret false
end
if eq k 0
break
end
pos = add pos ulong k
end
z = fclose int fd
if lt pos 524000
put chg_src pos 10
pos = add pos 1
end
put chg_srcl 0 pos
ret true
end

fn chg_write_mut_buf n ulong to bool
fd = fopen chg_pa 0 get chg_pal 0 577 420
if lt fd 0
ret false
end
sent = ulong 0
while lt sent n bound 512
k = write int fd chg_mut sent sub n sent
if le k 0
z = fclose int fd
ret false
end
sent = add sent ulong k
end
z = fclose int fd
ret true
end

fn chg_write_src_buf n ulong to bool
fd = fopen chg_pa 0 get chg_pal 0 577 420
if lt fd 0
ret false
end
sent = ulong 0
while lt sent n bound 512
k = write int fd chg_src sent sub n sent
if le k 0
z = fclose int fd
ret false
end
sent = add sent ulong k
end
z = fclose int fd
ret true
end

note ==== Subprocess Exec Helpers (fork + dup2 + execprog) ====

fn chg_av_clr to void
put chg_avn 0 2
put chg_avc 0 0
put chg_av 0 0
put chg_av 1 0
end

fn chg_av_finish sl ulong to void
p = get chg_avn 0
put chg_av p uchar and sl 255
put chg_av add p 1 uchar shr sl 8
put chg_avn 0 add p add sl 2
c = add get chg_avc 0 1
put chg_avc 0 c
put chg_av 0 uchar and c 255
put chg_av 1 uchar shr c 8
end

fn chg_av_add_omc to void
p = get chg_avn 0
sl = get chg_omc_l 0
for j ulong sl bound 1024
put chg_av add add p 2 j get chg_omc j
end
chg_av_finish sl
end

fn chg_av_add_pa to void
p = get chg_avn 0
sl = get chg_pal 0
for j ulong sl bound 1024
put chg_av add add p 2 j get chg_pa j
end
chg_av_finish sl
end

fn chg_av_add_pb to void
p = get chg_avn 0
sl = get chg_pbl 0
for j ulong sl bound 1024
put chg_av add add p 2 j get chg_pb j
end
chg_av_finish sl
end

fn chg_av_lit s view uchar * to void
p = get chg_avn 0
sl = len s
for j ulong sl bound 1024
put chg_av add add p 2 j get s j
end
chg_av_finish sl
end

fn chg_redir fd int target int to void
if ne dupfd fd target 0 long target
exit 127
end
end

fn chg_run_sync fi long fo long fe long to ulong
if or lt fi 0 or lt fo 0 lt fe 0
if ge fi 0
z = fclose int fi
end
if ge fo 0
z = fclose int fo
end
if ge fe 0
z = fclose int fe
end
ret 999
end
pid = fork
if lt pid 0
ret 998
end
if eq pid 0
chg_redir int fi 0
chg_redir int fo 1
chg_redir int fe 2
ze = execprog chg_av 0 get chg_avn 0
exit 127
end
z = fclose int fi
z = fclose int fo
z = fclose int fe
t0 = monons
while true bound 100000000
r = waitpid int pid chg_stb 0 len chg_stb 1
if eq r pid
if ne get chg_stb 0 0
ret add 128 ulong get chg_stb 0
end
ret ulong get chg_stb 1
end
if lt r 0
ret 997
end
if gt sub monons t0 60000000000
zk = killpid int pid 9
zw = waitpid int pid chg_stb 0 len chg_stb 0
ret 996
end
end
ret 995
end

fn chg_chmod_pb_exec to void
zcm = chmod chg_pb 0 get chg_pbl 0 493
end

fn chg_compile_src scr_src view uchar * scr_out view uchar * scr_err view uchar * to ulong
chg_av_clr
chg_av_add_omc
zp = chg_set_pa_scr scr_src
zp = chg_set_pb_scr scr_out
zp = chg_set_pc_scr scr_err
fi = fopen chg_pa 0 get chg_pal 0 0 0
fo = fopen chg_pb 0 get chg_pbl 0 577 493
fe = fopen chg_pc 0 get chg_pcl 0 577 420
rc = chg_run_sync fi fo fe
if eq rc 0
zp = chg_set_pb_scr scr_out
chg_chmod_pb_exec
end
ret rc
end

fn chg_stat_pa_size to long
r = stat chg_pa 0 get chg_pal 0 chg_stat 0 128
if ne r 0
ret -1
end
sz = ulong 0
for j ulong 8
sz = or sz shl ulong get chg_stat add 48 j mul j 8
end
ret long sz
end

fn chg_stat_buf_is_rx to bool
m = ulong get chg_stat 16
m = or m shl ulong get chg_stat 17 8
if ne and m 146 0
ret false
end
if eq and m 64 0
ret false
end
ret true
end

fn chg_check_rx_stat pbuf view uchar * plen ulong to bool
r = stat pbuf 0 plen chg_stat 0 128
if ne r 0
ret false
end
ret chg_stat_buf_is_rx
end

fn chg_check_rx_pa to bool
r = stat chg_pa 0 get chg_pal 0 chg_stat 0 128
if ne r 0
ret false
end
ret chg_stat_buf_is_rx
end

note ==== In-Process EGP3 & AArch64 W^X Helpers ====

fn chg_vc3_u32 off ulong v ulong to void
put vc3_buf off uchar and v 255
put vc3_buf add off 1 uchar and shr v 8 255
put vc3_buf add off 2 uchar and shr v 16 255
put vc3_buf add off 3 uchar and shr v 24 255
end

fn chg_vc3_node idx ulong op ulong a ulong b ulong c ulong vlo ulong to void
pos = add ulong 36 mul idx 32
chg_vc3_u32 pos op
chg_vc3_u32 add pos 4 a
chg_vc3_u32 add pos 8 b
chg_vc3_u32 add pos 12 c
chg_vc3_u32 add pos 16 vlo
chg_vc3_u32 add pos 20 0
chg_vc3_u32 add pos 24 64
chg_vc3_u32 add pos 28 0
end

fn chg_vc3_step base ulong s ulong ru ulong lu ulong rv ulong to void
pos = add base mul s 12
chg_vc3_u32 pos ru
chg_vc3_u32 add pos 4 lu
chg_vc3_u32 add pos 8 rv
end

fn chg_build_egp3_valid to ulong
put vc3_buf 0 69
put vc3_buf 1 71
put vc3_buf 2 80
put vc3_buf 3 51
chg_vc3_u32 4 1
chg_vc3_u32 8 0
chg_vc3_u32 12 0
chg_vc3_u32 16 64
chg_vc3_u32 20 15
chg_vc3_u32 24 11
chg_vc3_u32 28 14
chg_vc3_u32 32 4
chg_vc3_node 0 2 0 0 0 0
chg_vc3_node 1 2 0 0 0 1
chg_vc3_node 2 2 0 0 0 2
chg_vc3_node 3 2 0 0 0 3
chg_vc3_node 4 1 0 0 0 0
chg_vc3_node 5 1 0 0 0 8
chg_vc3_node 6 1 0 0 0 3
chg_vc3_node 7 4 1 1 0 0
chg_vc3_node 8 5 0 5 0 0
chg_vc3_node 9 3 8 7 0 0
chg_vc3_node 10 5 2 3 0 0
chg_vc3_node 11 3 9 10 0 0
chg_vc3_node 12 7 0 6 0 0
chg_vc3_node 13 3 12 4 0 0
chg_vc3_node 14 6 2 3 12 0
trb = add ulong 36 mul ulong 15 32
chg_vc3_step trb 0 14 7 4
chg_vc3_step trb 1 18 8 12
chg_vc3_step trb 2 3 13 12
chg_vc3_step trb 3 2 11 14
ret add trb 48
end

fn chg_watt_admit_lt80 p_gpu long p_cpu long p_unc long td long ts long tc long to bool
if ge p_gpu 80000
ret false
end
st = new WattThermal td ts 25000
pol = new WattPolicy 110000 WATT_P_GPU_HARD_MAX tc 2
pr = new WattProp p_gpu p_cpu p_unc 45
cmd = new WattCmd 0 0 0 0 0 0
wc_cbf_filter st pol pr cmd
if ne get cmd fail_closed 0
ret false
end
if ne get cmd p_gpu p_gpu
ret false
end
if ne get cmd p_cpu p_cpu
ret false
end
if ne get cmd p_unc p_unc
ret false
end
ret true
end

fn chg_build_wx_elf to ulong
isBufReset
isEmitU32 0xd10103ff
isEmitU32 0xa9007bfd
isEmitU32 0xd2800000
isEmitU32 0x910043e1
isEmitU32 0xd2800502
isEmitU32 0xd2800808
isEmitU32 0xd4000001
isEmitU32 0xf9400be9
isEmitU32 0xf9400fea
ok = isEmitOp TID_A725 OIR_ADD 11 9 10
ok = isEmitOp TID_A725 OIR_MUL 11 11 10
isEmitU32 0xd28000a9
isEmitU32 0xf90003eb
isEmitU32 0xf9400fe9
isEmitU32 0xd2800000
isEmitU32 0xd2800020
isEmitU32 0x910003e1
isEmitU32 0xd2800102
isEmitU32 0xd2800808
isEmitU32 0xd4000001
isEmitU32 0xd2800000
isEmitU32 0xd2800ba8
isEmitU32 0xd4000001
ret elfEmitStatic TID_X925
end

fn chg_check_wx_mode prot ulong to bool
if eq and prot 2 2
ret false
end
if eq and prot 6 6
ret false
end
ret eq prot 5
end

fn chg_run_wx_inproc to bool
elen = chg_build_wx_elf
if or lt elen 136 ne get elfBuf 68 5
ret false
end
for i ulong elen bound 4096
put sh_dat i get elfBuf i
end
sh_all elen
for j ulong 32
put chg_h1 j get sh_dig j
end
sl = len chg_d_inproc_s
rl = len chg_d_inproc_r
z = unlink chg_d_inproc_s 0 sl
z = unlink chg_d_inproc_r 0 rl
fd = fopen chg_d_inproc_s 0 sl 578 384
if lt fd 0
ret false
end
if ne write int fd elfBuf 0 elen long elen
z = fclose int fd
ret false
end
if lt fseek int fd 0 0 0
z = fclose int fd
ret false
end
if ne read int fd sh_dat 0 elen long elen
z = fclose int fd
ret false
end
sh_all elen
for j ulong 32
if ne get sh_dig j get chg_h1 j
z = fclose int fd
ret false
end
end
cm = fchmod int fd 320
z = fsync int fd
z = fclose int fd
if ne cm 0
ret false
end
put chg_d_inproc_pkt 0 2
put chg_d_inproc_pkt 1 0
put chg_d_inproc_pkt 2 uchar and sl 255
put chg_d_inproc_pkt 3 uchar shr sl 8
for i ulong sl bound 512
put chg_d_inproc_pkt add 4 i get chg_d_inproc_s i
end
off = add 4 sl
put chg_d_inproc_pkt off uchar and rl 255
put chg_d_inproc_pkt add off 1 uchar shr rl 8
off = add off 2
for i ulong rl bound 512
put chg_d_inproc_pkt add off i get chg_d_inproc_r i
end
if ne renames chg_d_inproc_pkt 0 add off rl 0 0
z = unlink chg_d_inproc_s 0 sl
ret false
end
ok = chg_check_rx_stat chg_d_inproc_r rl
z = unlink chg_d_inproc_r 0 rl
ret ok
end

note ==== Stage A: In-Process Verification + >=7 Killed Negative Controls ====

fn chg_memo_key tag view uchar * in_u64 ulong to void
for i ulong len tag bound 128
put sh_dat i get tag i
end
sh_all len tag
mm_set_fid_from_sh
mm_hash_input_u64 in_u64
end

fn chg_pfd_get which ulong idx ulong to int
base = mul which 8
off = add base mul idx 4
b0 = ulong get chg_pfd off
b1 = shl ulong get chg_pfd add off 1 8
b2 = shl ulong get chg_pfd add off 2 16
b3 = shl ulong get chg_pfd add off 3 24
ret int or or b0 b1 or b2 b3
end

fn chg_inproc_s1_t0 to void
chg_assert eq sck_init 16 4096 4 4 SCK_OK 100
put sc_regs 0 11
put sc_regs 1 17
put sc_regs 2 5
put sc_regs 3 9
put sc_regs 4 0x54300001
for i ulong 32
put sc_slab i uchar add 65 rem i 26
end
chg_assert eq sck_take SCK_OK 101
for j ulong 32
put chg_t0_dig j get sc_ck_dig j
end
chg_assert eq tkj_reset TKJ_OK 102
tkj_pack_u64x4 0x54300001 11 17 45000
chg_assert eq tkj_append TKJ_OP_CKPT_MARK 0 0 32 TKJ_OK 103
tkj_pack_u64x4 1 2 8 72000
chg_assert eq tkj_append TKJ_OP_CALL 1 1 32 TKJ_OK 104
chg_assert eq tkj_verify_buf tkj_bytes TKJ_OK 105
chg_assert eq sst_enc_init 16 4096 SST_OK 106
put ss_cur_regs 0 11
put ss_cur_regs 1 17
chg_assert eq sst_emit_frame 0 SST_OK 107
chg_assert eq sst_decode_verify get ss_st 0 SST_OK 108
chg_assert sst_verify_exact_match 109
end

fn chg_run_cff_child wfd int to void
r0 = cff_run_baseline 16 4
r1 = cff_fork_branch 0 4 CF_MUT_POWER_DROP 8 12000 0
r2 = cff_fork_branch 1 8 CF_MUT_SLAB_PERTURB 12 32 1
put chg_wbuf 0 0
put chg_wbuf 1 0
put chg_wbuf 2 0
put chg_wbuf 3 0
if eq r0 CF_OK
put chg_wbuf 0 1
end
if eq r1 CF_OK
put chg_wbuf 1 1
end
if eq r2 CF_OK
put chg_wbuf 2 1
end
if gt cff_rep_get 0 1 0
put chg_wbuf 3 1
end
zwr = write wfd chg_wbuf 0 4
z = fclose wfd
exit 0
end

fn chg_inproc_s2_fork to void
for i ulong 4
if ne pipefds chg_pfd mul i 8 8 0 0
chg_note_fail 114
end
end
for tl ulong 4
pid = fork
if eq pid 0
for k ulong 4
z = fclose chg_pfd_get k 0
if ne k tl
z = fclose chg_pfd_get k 1
end
end
if eq tl 3
chg_run_cff_child chg_pfd_get 3 1
end
put sc_regs 0 add 500 tl
put chg_wbuf 0 uchar tl
put chg_wbuf 1 133
wfd2 = chg_pfd_get tl 1
zwr = write wfd2 chg_wbuf 0 2
z = fclose wfd2
exit 0
end
put chg_pids tl pid
end
for k ulong 4
z = fclose chg_pfd_get k 1
end
for tl ulong 3
rfd = chg_pfd_get tl 0
nrd = read rfd chg_pipe_rep mul tl 2 2
z = fclose rfd
wp = waitpid int get chg_pids tl chg_stb 0 len chg_stb 0
ok_pipe = false
if eq nrd 2
if eq get chg_pipe_rep add mul tl 2 1 133
ok_pipe = true
end
end
chg_assert ok_pipe add 115 tl
end
rfd3 = chg_pfd_get 3 0
n3 = read rfd3 chg_pipe_rep 16 4
z = fclose rfd3
wp3 = waitpid int get chg_pids 3 chg_stb 0 len chg_stb 0
chg_assert and eq n3 4 eq get chg_pipe_rep 16 1 110
chg_assert eq get chg_pipe_rep 17 1 111
chg_assert eq get chg_pipe_rep 18 1 112
chg_assert eq get chg_pipe_rep 19 1 113
chg_assert eq get sc_regs 0 11 118
end


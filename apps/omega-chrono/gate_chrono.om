fo = fopen chg_pa 0 get chg_pal 0 577 420
fe = fopen chg_s_null 0 len chg_s_null 0 0
rc = chg_run_sync fi fo fe
zp = chg_set_pa_scr chg_s_out
zo = chg_read_pa_out
ret rc
end


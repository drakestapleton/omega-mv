fn chg_prep_mutant old_s view uchar * new_s view uchar * tag ulong to bool
if not chg_mutate_src get chg_srcl 0 old_s new_s
chg_note_fail tag
ret false
end
if ne chg_compile_src chg_s_msrc chg_s_mb chg_s_me 0
chg_note_fail tag
ret false
end
ret true
end

fn chg_chk_mut_rc flg1 view uchar * flg2 view uchar * exp_rc ulong tag ulong to void
chg_av_clr
zp = chg_set_pb_scr chg_s_mb
chg_av_add_pb
chg_av_lit flg1
if gt len flg2 0
chg_av_lit flg2
end
mrc = chg_spawn_bin chg_s_mb
if eq mrc exp_rc
put chg_mut_kills 0 add get chg_mut_kills 0 1
chg_assert true tag
else
chg_note_fail tag
end
end


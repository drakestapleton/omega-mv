fn chg_verify_omc_pin to bool
zp = chg_set_pa_root chg_p_pin
fd = fopen chg_pa 0 get chg_pal 0 0 0
if lt fd 0
ret false
end
rn = read int fd chg_pin_hex 0 128
z = fclose int fd
if lt rn 64
ret false
end
nb = chg_read_omc_sh
if le nb 0
ret false
end
sh_all ulong nb
for i ulong 32
b = get sh_dig i
hi = shr b 4
lo = and b 15
hc = uchar add 48 hi
if ge hi 10
hc = uchar add 87 hi
end
lc = uchar add 48 lo
if ge lo 10
lc = uchar add 87 lo
end
if ne hc get chg_pin_hex mul i 2
ret false
end
if ne lc get chg_pin_hex add mul i 2 1
ret false
end
end
ret true
end


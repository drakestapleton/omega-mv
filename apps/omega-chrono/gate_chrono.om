fn chg_hash_scr_file suf view uchar * dst_sha ulong to long
zp = chg_set_pa_scr suf
nb = chg_read_pa_sh
if le nb 0
ret -1
end
sh_all ulong nb
for j ulong 32
if eq dst_sha 1
put chg_h1 j get sh_dig j
else
put chg_h2 j get sh_dig j
end
end
ret nb
end

fn chg_mut_match_at base ulong pat view uchar * to bool
for j ulong len pat bound 128
if ne get chg_mut add base j get pat j
ret false
end
end
ret true
end

fn chg_mutate_src srcl ulong old_s view uchar * new_s view uchar * to bool
if ne len old_s len new_s
ret false
end
for i ulong srcl bound 524288
put chg_mut i get chg_src i
end
if gt len old_s srcl
ret false
end
hits = ulong 0
pos = ulong 0
lim = add sub srcl len old_s 1
for i ulong lim bound 524288
if chg_mut_match_at i old_s
hits = add hits 1
pos = i
end
end
if ne hits 1
ret false
end
for j ulong len new_s bound 128
put chg_mut add pos j get new_s j
end
zp = chg_set_pa_scr chg_s_msrc
ret chg_write_mut_buf srcl
end


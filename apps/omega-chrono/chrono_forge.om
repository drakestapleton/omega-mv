note ==== Section 2: String, Print & CLI Helpers ====

fn chf_wrt s view uchar * to void
w = write 1 s 0 len s
end

fn chf_werr s view uchar * to void
w = write 2 s 0 len s
end

fn chf_num v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put chf_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
w = write 1 chf_dig p sub 24 p
ret
end
end
end

fn chf_i64 v long to void
if lt v 0
put chf_dig 0 45
w = write 1 chf_dig 0 1
chf_num ulong neg v
ret
end
chf_num ulong v
end

fn chf_arg_eq idx ulong lit view uchar * to bool
rn = argread idx chf_arg 0 511
if ne rn long len lit
ret false
end
for i ulong len lit bound 128
if ne get chf_arg i get lit i
ret false
end
end
ret true
end

fn chf_parse_arg_u64 idx ulong to long
rn = argread idx chf_arg 0 64
if le rn 0
ret -1
end
v = ulong 0
for i ulong ulong rn bound 64
ch = ulong get chf_arg i
if or lt ch 48 gt ch 57
ret -1
end
v = add mul v 10 sub ch 48
end
ret long v
end

fn chf_scan_rwx_arg to bool
n = ulong argcnt
for i ulong n bound 64
if chf_arg_eq i chf_fl_rwx
ret true
end
end
ret false
end

fn chf_copy_def_dir to void
n = len chf_def_dir
for i ulong n bound 256
put chf_dir i get chf_def_dir i
end
put chf_dirl 0 n
end

fn chf_mk_subpath suf view uchar * dst ulong to ulong
n = get chf_dirl 0
m = len suf
if eq dst 0
for i ulong n bound 440
put chf_memo_dir i get chf_dir i
end
for j ulong m bound 64
put chf_memo_dir add n j get suf j
end
put chf_memo_dl 0 add n m
ret add n m
end
for i ulong n bound 440
put chf_otkj_path i get chf_dir i
end
for j ulong m bound 64
put chf_otkj_path add n j get suf j
end
put chf_otkj_pl 0 add n m
ret add n m
end

note ==== Section 3: Strict W^X AArch64 ELF64 Codegen, Sealing & Exec ====

fn cfw_emitw w ulong to void
isEmitU32 w
put cfw_insns 0 add get cfw_insns 0 1
end

fn cfw_movz rd ulong imm16 ulong to void
cfw_emitw or 0xd2800000 or shl and imm16 65535 5 rd
end

fn cfw_ldr_sp rt ulong idx8 ulong to void
cfw_emitw or 0xf94003e0 or shl idx8 10 rt
end

fn cfw_str_sp rt ulong idx8 ulong to void
cfw_emitw or 0xf90003e0 or shl idx8 10 rt
end

fn cfw_lslv rd ulong rn ulong rm ulong to void
cfw_emitw or 0x9ac02000 or shl rm 16 or shl rn 5 rd
end

fn cfw_madd rd ulong rn ulong rm ulong ra ulong to void
cfw_emitw or 0x9b000000 or shl rm 16 or shl ra 10 or shl rn 5 rd
end

fn cfw_cmp_imm rn ulong imm12 ulong to void
cfw_emitw or 0xf100001f or shl and imm12 4095 10 shl rn 5
end

fn cfw_b_cond cond ulong imm19 ulong to void
cfw_emitw or 0x54000000 or shl and imm19 524287 5 cond
end

fn cfw_emit_prologue to void
cfw_emitw 0xd11003ff
cfw_movz 0 0
cfw_emitw 0x910003e1
cfw_movz 2 40
cfw_movz 8 63
cfw_emitw 0xd4000001
cfw_ldr_sp 19 0
cfw_ldr_sp 20 1
cfw_ldr_sp 21 2
cfw_ldr_sp 22 3
cfw_ldr_sp 23 4
end

fn cfw_emit_epilogue to void
cfw_str_sp 25 0
cfw_movz 0 1
cfw_emitw 0x910003e1
cfw_movz 2 8
cfw_movz 8 64
cfw_emitw 0xd4000001
cfw_movz 0 0
cfw_movz 8 93
cfw_emitw 0xd4000001
end

fn cfw_emit_tl_body tl ulong to void
if eq tl CHF_TL_A
cfw_movz 9 8
ok = isEmitOp TID_X925 OIR_MUL 9 19 9
ok = isEmitOp TID_X925 OIR_SUB 10 20 20
ok = isEmitOp TID_X925 OIR_ADD 9 9 10
ok = isEmitOp TID_X925 OIR_MUL 11 21 22
cfw_movz 12 0
ok = isEmitOp TID_X925 OIR_ADD 11 11 12
ok = isEmitOp TID_X925 OIR_ADD 25 9 11
put cfw_insns 0 add get cfw_insns 0 6
ret
end
note Speculative Timelines B & C enforce OOD guard: x20 <= 100, else trap 14 (SYS_exit 114)
cfw_cmp_imm 20 100
cfw_b_cond 9 4
cfw_movz 0 114
cfw_movz 8 93
cfw_emitw 0xd4000001
cfw_movz 9 3
cfw_lslv 9 19 9
if eq tl CHF_TL_B
cfw_madd 25 21 22 9
ret
end
ok = isEmitOp TID_A725 OIR_MUL 11 21 22
ok = isEmitOp TID_A725 OIR_ADD 25 9 11
put cfw_insns 0 add get cfw_insns 0 2
end

fn cfw_compile_tl_elf tl ulong to ulong
isBufReset
put cfw_insns 0 0
cfw_emit_prologue
cfw_emit_tl_body tl
cfw_emit_epilogue
ret elfEmitStatic TID_X925
end

fn cfw_validate_prot prot ulong to ulong
if eq and prot 6 6
put cfw_rwx_ref 0 add get cfw_rwx_ref 0 1
ret CHF_ERR_RWX
end
if ne prot CFW_PROT_RX
ret CHF_ERR_WX_SEAL
end
ret CHF_OK
end

fn cfw_verify_elf_wx n ulong to ulong
if lt n 136
ret CHF_ERR_WX_SEAL
end
if or ne get elfBuf 0 127 or ne get elfBuf 1 69 or ne get elfBuf 2 76 ne get elfBuf 3 70
ret CHF_ERR_WX_SEAL
end
if or ne get elfBuf 18 183 ne get elfBuf 64 1
ret CHF_ERR_WX_SEAL
end
pf = ulong get elfBuf 68
if eq and pf 3 3
put cfw_rwx_ref 0 add get cfw_rwx_ref 0 1
ret CHF_ERR_RWX
end
if ne pf 5
ret CHF_ERR_WX_SEAL
end
ret CHF_OK
end

fn cfw_p_append dst ulong s view uchar * to void
n = len s
if eq dst 0
p = get cfw_p_stgl 0
for i ulong n bound 64
put cfw_p_stage add p i get s i
end
put cfw_p_stgl 0 add p n
else
p = get cfw_p_rxl 0
for i ulong n bound 64
put cfw_p_rx add p i get s i
end
put cfw_p_rxl 0 add p n
end
end

fn cfw_p_append_digit dst ulong d ulong to void
if eq dst 0
p = get cfw_p_stgl 0
put cfw_p_stage p uchar add 48 d
put cfw_p_stgl 0 add p 1
else
p = get cfw_p_rxl 0
put cfw_p_rx p uchar add 48 d
put cfw_p_rxl 0 add p 1
end
end

fn cfw_build_tl_paths tl ulong to void
dn = get chf_dirl 0
for i ulong dn bound 512
b = get chf_dir i
put cfw_p_stage i b
put cfw_p_rx i b
end
put cfw_p_stgl 0 dn
put cfw_p_rxl 0 dn
cfw_p_append 0 chf_suf_tl
cfw_p_append_digit 0 tl
cfw_p_append 0 chf_suf_stg
cfw_p_append 1 chf_suf_tl
cfw_p_append_digit 1 tl
cfw_p_append 1 chf_suf_rx
end

fn cfw_check_stat_rx plen ulong to ulong
r = stat cfw_p_rx 0 plen cfw_stat_buf 0 128
if ne r 0
ret CHF_ERR_WX_SEAL
end
m = ulong get cfw_stat_buf 16
m = or m shl ulong get cfw_stat_buf 17 8
if ne and m 146 0
put cfw_mode_ref 0 add get cfw_mode_ref 0 1
ret CHF_ERR_WX_SEAL
end
if eq and m 64 0
ret CHF_ERR_WX_SEAL
end
ret CHF_OK
end

fn cfw_write_verify_stage elen ulong to ulong
for i ulong elen bound 4096
put sh_dat i get elfBuf i
end
sh_all elen
for j ulong 32
put cfw_sha_exp j get sh_dig j
end
z = unlink cfw_p_stage 0 get cfw_p_stgl 0
fd = fopen cfw_p_stage 0 get cfw_p_stgl 0 578 384
if lt fd 0
ret CHF_ERR_WX_SEAL
end
if ne write int fd elfBuf 0 elen long elen
z = fclose int fd
z = unlink cfw_p_stage 0 get cfw_p_stgl 0
ret CHF_ERR_WX_SEAL
end
if lt fseek int fd 0 0 0
z = fclose int fd
ret CHF_ERR_WX_SEAL
end
if ne read int fd cfw_rb_buf 0 elen long elen
z = fclose int fd
ret CHF_ERR_WX_SEAL
end
for i ulong elen bound 4096
put sh_dat i get cfw_rb_buf i
end
sh_all elen
for j ulong 32
if ne get sh_dig j get cfw_sha_exp j
put cfw_sha_ref 0 add get cfw_sha_ref 0 1
z = fclose int fd
z = unlink cfw_p_stage 0 get cfw_p_stgl 0
ret CHF_ERR_WX_SEAL
end
end
cm = fchmod int fd 320
z = fsync int fd
z = fclose int fd
if ne cm 0
z = unlink cfw_p_stage 0 get cfw_p_stgl 0
ret CHF_ERR_WX_SEAL
end
ret CHF_OK
end

fn cfw_seal_rename to ulong
sl = get cfw_p_stgl 0
rl = get cfw_p_rxl 0
z = unlink cfw_p_rx 0 rl
put cfw_ren_pkt 0 2
put cfw_ren_pkt 1 0
put cfw_ren_pkt 2 uchar and sl 255
put cfw_ren_pkt 3 uchar shr sl 8
for i ulong sl bound 1024
put cfw_ren_pkt add 4 i get cfw_p_stage i
end
off = add 4 sl
put cfw_ren_pkt off uchar and rl 255
put cfw_ren_pkt add off 1 uchar shr rl 8
off = add off 2
for i ulong rl bound 1024
put cfw_ren_pkt add off i get cfw_p_rx i
end
if ne renames cfw_ren_pkt 0 add off rl 0 0
z = unlink cfw_p_stage 0 sl
ret CHF_ERR_WX_SEAL
end
ret cfw_check_stat_rx rl
end

fn cfw_stage_and_seal tl ulong req_prot ulong to ulong
rc = cfw_validate_prot req_prot
if ne rc CHF_OK
ret rc
end
elen = get elfLen 0
rc = cfw_verify_elf_wx elen
if ne rc CHF_OK
ret rc
end
z = makedir chf_dir 0 get chf_dirl 0 493
cfw_build_tl_paths tl
rc = cfw_write_verify_stage elen
if ne rc CHF_OK
ret rc
end
ret cfw_seal_rename
end

fn cfw_rd_fd32 which ulong off ulong to int
b0 = ulong 0
b1 = ulong 0
b2 = ulong 0
b3 = ulong 0
if eq which 0
b0 = ulong get cfw_p_in off
b1 = shl ulong get cfw_p_in add off 1 8
b2 = shl ulong get cfw_p_in add off 2 16
b3 = shl ulong get cfw_p_in add off 3 24
else
b0 = ulong get cfw_p_out off
b1 = shl ulong get cfw_p_out add off 1 8
b2 = shl ulong get cfw_p_out add off 2 16
b3 = shl ulong get cfw_p_out add off 3 24
end
ret int or or b0 b1 or b2 b3
end

fn cfw_set_args a0 ulong a1 ulong a2 ulong a3 ulong reps ulong to void
put cfw_args 0 a0
put cfw_args 1 a1
put cfw_args 2 a2
put cfw_args 3 a3
put cfw_args 4 reps
end

fn cfw_pack_in to void
for a ulong 5
v = get cfw_args a
base = mul a 8
for j ulong 8
put cfw_io_in add base j uchar and shr v mul j 8 255
end
end
end

fn cfw_exec_collect pid long out_rd int t0 long to ulong
for j ulong 8
put cfw_io_out j 0
end
tot = ulong 0
while lt tot 8 bound 16
rn = read out_rd cfw_io_out tot sub 8 tot
if le rn 0
break
end
tot = add tot ulong rn
end
z = fclose out_rd
z = waitpid int pid cfw_wait_st 0 4 0
t1 = monons
if ge t1 t0
put cfw_last_ns 0 ulong sub t1 t0
end
if ne get cfw_wait_st 0 0
put cfw_last_exit 0 add 128 ulong get cfw_wait_st 0
ret 0
end
put cfw_last_exit 0 ulong get cfw_wait_st 1
if eq tot 8
res = ulong 0
for j ulong 8
res = or res shl ulong get cfw_io_out j mul j 8
end
put cfw_last_out 0 res
ret res
end
ret 0
end

fn cfw_exec_sealed plen ulong to ulong
put cfw_last_exit 0 255
put cfw_last_out 0 0
if ne cfw_check_stat_rx plen CHF_OK
ret 0
end
if ne pipefds cfw_p_in 0 8 0 0
ret 0
end
if ne pipefds cfw_p_out 0 8 0 0
z = fclose cfw_rd_fd32 0 0
z = fclose cfw_rd_fd32 0 4
ret 0
end
in_rd = cfw_rd_fd32 0 0
in_wr = cfw_rd_fd32 0 4
out_rd = cfw_rd_fd32 1 0
out_wr = cfw_rd_fd32 1 4
cfw_pack_in
z = write in_wr cfw_io_in 0 40
z = fclose in_wr
put cfw_av_pkt 0 1
put cfw_av_pkt 1 0
put cfw_av_pkt 2 uchar and plen 255
put cfw_av_pkt 3 uchar shr plen 8
for i ulong plen bound 1024
put cfw_av_pkt add 4 i get cfw_p_rx i
end
t0 = monons
pid = fork
if lt pid 0
z = fclose in_rd
z = fclose out_rd
z = fclose out_wr
ret 0
end
if eq pid 0
z = dupfd in_rd 0 0
z = dupfd out_wr 1 0
z = fclose in_rd
z = fclose out_rd
z = fclose out_wr
z = execprog cfw_av_pkt 0 add 4 plen
exit 127
end
z = fclose in_rd
z = fclose out_wr
ret cfw_exec_collect pid out_rd t0
end

note ==== Section 4: Live EGP3 Structural Proof Builders (verified via egp3_checker.om) ====

fn chf_vc3_u32 off ulong v ulong to void
put vc3_buf off uchar and v 255
put vc3_buf add off 1 uchar and shr v 8 255
put vc3_buf add off 2 uchar and shr v 16 255
put vc3_buf add off 3 uchar and shr v 24 255
end

fn chf_vc3_node idx ulong op ulong a ulong b ulong c ulong vlo ulong to void
pos = add 36 mul idx 32
chf_vc3_u32 pos op
chf_vc3_u32 add pos 4 a
chf_vc3_u32 add pos 8 b
chf_vc3_u32 add pos 12 c
chf_vc3_u32 add pos 16 vlo
chf_vc3_u32 add pos 20 0
chf_vc3_u32 add pos 24 64
chf_vc3_u32 add pos 28 0
end

fn chf_vc3_step base ulong s ulong ru ulong lu ulong rv ulong to void
pos = add base mul s 12
chf_vc3_u32 pos ru
chf_vc3_u32 add pos 4 lu
chf_vc3_u32 add pos 8 rv
end

fn chf_vc3_hdr nc ulong rb ulong ra ulong nt ulong to void
put vc3_buf 0 69
put vc3_buf 1 71
put vc3_buf 2 80
put vc3_buf 3 51
chf_vc3_u32 4 1
chf_vc3_u32 8 0
chf_vc3_u32 12 0
chf_vc3_u32 16 64
chf_vc3_u32 20 nc
chf_vc3_u32 24 rb
chf_vc3_u32 28 ra
chf_vc3_u32 32 nt
end

fn chf_vc3_emit_base_nodes to void
chf_vc3_node 0 2 0 0 0 0
chf_vc3_node 1 2 0 0 0 1
chf_vc3_node 2 2 0 0 0 2
chf_vc3_node 3 2 0 0 0 3
chf_vc3_node 4 1 0 0 0 0
chf_vc3_node 5 1 0 0 0 8
chf_vc3_node 6 1 0 0 0 3
chf_vc3_node 7 4 1 1 0 0
chf_vc3_node 8 5 0 5 0 0
chf_vc3_node 9 3 8 7 0 0
chf_vc3_node 10 5 2 3 0 0
chf_vc3_node 11 3 9 10 0 0
chf_vc3_node 12 7 0 6 0 0
chf_vc3_node 13 3 12 4 0 0
end

fn chf_verify_egp3_tl tl ulong to ulong
if eq tl CHF_TL_A
chf_vc3_hdr 13 11 11 1
chf_vc3_emit_base_nodes
chf_vc3_node 12 3 10 4 0 0
trb = add ulong 36 mul ulong 13 32
chf_vc3_step trb 0 3 12 10
put chf_eg_steps 0 1
ret vc3_verify add trb 12
end
if eq tl CHF_TL_B
chf_vc3_hdr 15 11 14 4
chf_vc3_emit_base_nodes
chf_vc3_node 14 6 2 3 12 0
trb = add ulong 36 mul ulong 15 32
chf_vc3_step trb 0 14 7 4
chf_vc3_step trb 1 18 8 12
chf_vc3_step trb 2 3 13 12
chf_vc3_step trb 3 2 11 14
put chf_eg_steps 0 4
ret vc3_verify add trb 48
end
chf_vc3_hdr 15 11 14 3
chf_vc3_emit_base_nodes
chf_vc3_node 14 3 12 10 0 0
trb = add ulong 36 mul ulong 15 32
chf_vc3_step trb 0 14 7 4
chf_vc3_step trb 1 18 8 12
chf_vc3_step trb 2 3 13 12
put chf_eg_steps 0 3
ret vc3_verify add trb 36
end

note ==== Section 5: Live Thermal Sensing + WattCBF (< 80 W) Headroom Gate ====

fn chf_sense_thermal to void
ws_sense_all
st = new WattThermal 0 0 0
ok = ws_fill_thermal_state st
if ne get chf_hot_sim 0 0
put chf_live_sens 0 0
put chf_th_tdie 0 77500
put chf_th_tsink 0 68000
put chf_th_tamb 0 25000
put chf_th_tceil 0 78000
put chf_th_tau 0 2
put chf_th_pbud 0 110000
ret
end
if ok
put chf_live_sens 0 1
put chf_th_tdie 0 get st t_die
put chf_th_tsink 0 get st t_sink
put chf_th_tamb 0 get st t_amb
put chf_th_tceil 0 WATT_T_CEIL_DEFAULT
put chf_th_tau 0 2
put chf_th_pbud 0 110000
ret
end
put chf_live_sens 0 0
put chf_th_tdie 0 52000
put chf_th_tsink 0 46000
put chf_th_tamb 0 25000
put chf_th_tceil 0 WATT_T_CEIL_DEFAULT
put chf_th_tau 0 2
put chf_th_pbud 0 110000
end

fn chf_check_watt_cap p_gpu long p_cpu long p_unc long to ulong
cap = get chf_pwr_cap 0
if gt cap 0
tot = add add p_gpu p_cpu p_unc
if gt tot cap
ret 0
end
end
ret 1
end

fn chf_check_watt_admit p_gpu long p_cpu long p_unc long to ulong
put chf_w_admit 0 0
put chf_w_h 0 -999999
if ge p_gpu CHF_GPU_HARD_LT
ret 0
end
if eq chf_check_watt_cap p_gpu p_cpu p_unc 0
ret 0
end
st = new WattThermal get chf_th_tdie 0 get chf_th_tsink 0 get chf_th_tamb 0
pol = new WattPolicy get chf_th_pbud 0 WATT_P_GPU_HARD_MAX get chf_th_tceil 0 get chf_th_tau 0
pr = new WattProp p_gpu p_cpu p_unc 45
cmd = new WattCmd 0 0 0 0 0 0
wc_cbf_filter st pol pr cmd
if ne get cmd fail_closed 0
ret 0
end
if ne get cmd p_gpu p_gpu
ret 0
end
if ne get cmd p_cpu p_cpu
ret 0
end
if ne get cmd p_unc p_unc
ret 0
end
dt = wc_next_die_delta st p_gpu p_cpu p_unc
h = wc_barrier_h get chf_th_tceil 0 get chf_th_tdie 0 get chf_th_tau 0 dt
if lt h 0
ret 0
end
put chf_w_admit 0 1
put chf_w_h 0 h
ret 1
end

note ==== Section 6: Parallel Counterfactual Worker (fork + pipe + execprog) ====

fn chf_wb_put64 off ulong v ulong to void
for j ulong 8
put chf_wbuf add off j uchar and shr v mul j 8 255
end
end

fn chf_rep_get64 tl ulong off ulong to ulong
base = add mul tl CHF_REP_BYTES off
v = ulong 0
for j ulong 8
b = ulong get chf_rep add base j
v = or v shl b mul j 8
end
ret v
end

fn chf_pfd_get which ulong idx ulong to int
base = mul which 8
off = add base mul idx 4
b0 = ulong get chf_pfd off
b1 = shl ulong get chf_pfd add off 1 8
b2 = shl ulong get chf_pfd add off 2 16
b3 = shl ulong get chf_pfd add off 3 24
ret int or or b0 b1 or b2 b3
end

fn chf_hash_u64_to_wbuf off ulong val ulong to void
for j ulong 8
put sh_dat j uchar and shr val mul j 8 255
end
sh_all 8
for j ulong 32
put chf_wbuf add off j get sh_dig j
end
end

fn chf_worker_fill_meta tl ulong to void
if eq tl CHF_TL_A
chf_wb_put64 16 1
chf_wb_put64 24 0
chf_wb_put64 32 50000
chf_wb_put64 40 14000
put chf_probe_v 0 0
put chf_probe_v2 0 45000
put chf_probe_v3 0 5000
ret
end
if eq tl CHF_TL_B
chf_wb_put64 16 2
chf_wb_put64 24 8
chf_wb_put64 32 72000
chf_wb_put64 40 4200
put chf_probe_v 0 52000
put chf_probe_v2 0 15000
put chf_probe_v3 0 5000
ret
end
chf_wb_put64 16 2
chf_wb_put64 24 12
chf_wb_put64 32 22000
chf_wb_put64 40 9500
put chf_probe_v 0 0
put chf_probe_v2 0 17000
put chf_probe_v3 0 5000
end

fn chf_run_tl_worker tl ulong wr_fd int to void
for j ulong CHF_REP_BYTES
put chf_wbuf j 0
end
chf_wb_put64 0 tl
chf_wb_put64 8 ulong getpid
chf_worker_fill_meta tl
wad = chf_check_watt_admit get chf_probe_v 0 long get chf_probe_v2 0 long get chf_probe_v3 0
chf_wb_put64 48 wad
wh = get chf_w_h 0
wh_u = ulong 0
if gt wh 0
wh_u = ulong wh
end
chf_wb_put64 56 wh_u
erc = chf_verify_egp3_tl tl
chf_wb_put64 64 erc
chf_wb_put64 72 get chf_eg_steps 0
elen = cfw_compile_tl_elf tl
wxok = ulong 0
if gt elen 0
if eq cfw_stage_and_seal tl CFW_PROT_RX CHF_OK
wxok = ulong 1
end
end
chf_wb_put64 80 wxok
chf_wb_put64 88 get cfw_insns 0
cfw_set_args 11 17 5 9 1
xout = ulong 0
if eq wxok 1
xout = cfw_exec_sealed get cfw_p_rxl 0
end
chf_wb_put64 96 xout
chf_wb_put64 104 get cfw_last_exit 0
subv = ulong 133
if eq tl CHF_TL_A
subv = ulong 88
end
chf_wb_put64 112 subv
chf_wb_put64 120 1
for j ulong 32
put chf_wbuf add 128 j get cfw_sha_exp j
end
chf_hash_u64_to_wbuf 160 subv
sent = ulong 0
while lt sent CHF_REP_BYTES bound 32
k = write wr_fd chf_wbuf sent sub CHF_REP_BYTES sent
if le k 0
break
end
sent = add sent ulong k
end
z = fclose wr_fd
exit 0
end

fn chf_run_cff_worker wr_fd int to void
rc = cff_run_baseline 16 4
for j ulong 64
put chf_wbuf j 0
end
if eq rc CF_OK
r1 = cff_fork_branch 0 4 CF_MUT_POWER_DROP 8 12000 0
r2 = cff_fork_branch 1 8 CF_MUT_SLAB_PERTURB 12 32 1
chf_wb_put64 0 r1
chf_wb_put64 8 cff_rep_get 0 1
chf_wb_put64 16 cff_rep_get 0 2
chf_wb_put64 24 cff_rep_get 0 4
chf_wb_put64 32 r2
chf_wb_put64 40 cff_rep_get 1 1
end
w = write wr_fd chf_wbuf 0 48
z = fclose wr_fd
exit 0
end

fn chf_read_pipe_exact rd_fd int dst_off ulong nbytes ulong to bool
got = ulong 0
while lt got nbytes bound 64
k = read rd_fd chf_rep add dst_off got sub nbytes got
if le k 0
ret false
end
got = add got ulong k
end
ret true
end

fn chf_fork_all_timelines to ulong
for i ulong 4
if ne pipefds chf_pfd mul i 8 8 0 0
ret CHF_ERR_FORK
end
end
for tl ulong 3
pid = fork
if lt pid 0
ret CHF_ERR_FORK
end
if eq pid 0
for k ulong 4
z = fclose chf_pfd_get k 0
if ne k tl
z = fclose chf_pfd_get k 1
end
end
chf_run_tl_worker tl chf_pfd_get tl 1
end
put chf_pids tl pid
end
cpid = fork
if lt cpid 0
ret CHF_ERR_FORK
end
if eq cpid 0
for k ulong 4
z = fclose chf_pfd_get k 0
if ne k 3
z = fclose chf_pfd_get k 1
end
end
chf_run_cff_worker chf_pfd_get 3 1
end
put chf_pids 3 cpid
for k ulong 4
z = fclose chf_pfd_get k 1
end
for tl ulong 3
if not chf_read_pipe_exact chf_pfd_get tl 0 mul tl CHF_REP_BYTES CHF_REP_BYTES
z = fclose chf_pfd_get tl 0
ret CHF_ERR_FORK
end
z = fclose chf_pfd_get tl 0
wp = waitpid int get chf_pids tl cfw_wait_st 0 4 0
if or ne get cfw_wait_st 0 0 ne get cfw_wait_st 1 0
ret CHF_ERR_FORK
end
end
got_cf = ulong 0
while lt got_cf 48 bound 32
k = read chf_pfd_get 3 0 chf_wbuf got_cf sub 48 got_cf
if le k 0
break
end
got_cf = add got_cf ulong k
end
z = fclose chf_pfd_get 3 0
wp2 = waitpid int get chf_pids 3 cfw_wait_st 0 4 0
if eq got_cf 48
for i ulong 6
v = ulong 0
for j ulong 8
v = or v shl ulong get chf_wbuf add mul i 8 j mul j 8
end
put chf_cf_div i v
end
end
ret CHF_OK
end

note ==== Section 7: T0 Checkpoint, OMEGA-MEMO Admission, W^X Swap & OOD Rewind ====

fn chf_anchor_t0 to ulong
rc = sck_init 16 4096 4 4
if ne rc SCK_OK
ret CHF_ERR_SLAB_CKPT
end
put sc_regs 0 11
put sc_regs 1 17
put sc_regs 2 5
put sc_regs 3 9
put sc_regs 4 0x54300001
put sc_regs 5 0
put sc_regs 6 45000
put sc_regs 7 14000
put sc_regs 8 0
for i ulong 32
put sc_slab i uchar add 65 rem i 26
end
if ne sck_take SCK_OK
ret CHF_ERR_SLAB_CKPT
end
for j ulong 32
put chf_t0_hash j get sc_ck_dig j
end
if ne tkj_reset TKJ_OK
ret CHF_ERR_OTKJ
end
tkj_pack_u64x4 0x54300001 11 17 45000
if ne tkj_append TKJ_OP_CKPT_MARK 0 0 32 TKJ_OK
ret CHF_ERR_OTKJ
end
if ne sst_enc_init 16 4096 SST_OK
ret CHF_ERR_SLAB_CKPT
end
put ss_cur_regs 0 11
put ss_cur_regs 1 17
put ss_cur_regs 2 0x54300001
if ne sst_emit_frame 0 SST_OK
ret CHF_ERR_SLAB_CKPT
end
ret CHF_OK
end

fn chf_setup_memo to ulong
z = makedir chf_dir 0 get chf_dirl 0 493
ml = chf_mk_subpath chf_suf_memo 0
for i ulong ml bound 440
put mm_env_buf i get chf_memo_dir i
end
if ne mm_set_root_from_envbuf ml MM_OK
ret CHF_ERR_MEMO_OOD
end
mp_init
mp_set_thresholds 5000 2 1
mm_reset_stats
ret CHF_OK
end

fn chf_stage_memo_key tag view uchar * in_u64 ulong to void
for i ulong len tag bound 128
put sh_dat i get tag i
end
sh_all len tag
mm_set_fid_from_sh
mm_hash_input_u64 in_u64
end

fn chf_admit_memo tag view uchar * tier ulong err_b ulong val ulong ood_alarm ulong to ulong
if ne ood_alarm 0
put chf_memo_poison_ref 0 add get chf_memo_poison_ref 0 1
ret CHF_ERR_MEMO_OOD
end
if ne get chf_probe_v3 0 0
ret CHF_ERR_EGP3
end
mm_reset_req
chf_stage_memo_key tag 11170509
mm_set_contract get chf_probe_v2 0 get chf_probe_v4 0 tier err_b
mm_set_provenance TID_X925 0
for j ulong 8
put mm_val_buf j uchar and shr val mul j 8 255
end
put mm_val_len 0 8
rc = mm_store 15000 1000
if and ne rc MM_OK and ne rc MM_OK_DOMINATED ne rc MM_OK_ALARM
ret CHF_ERR_MEMO_OOD
end
if eq rc MM_OK
put chf_memo_stores 0 add get chf_memo_stores 0 1
end
ret CHF_OK
end

fn chf_save_tl_rx_paths to void
for tl ulong 3
cfw_build_tl_paths tl
rl = get cfw_p_rxl 0
base = mul tl 512
for i ulong rl bound 512
put chf_tl_rx add base i get cfw_p_rx i
end
put chf_tl_rxl tl rl
end
end

fn chf_load_tl_rx_path tl ulong to ulong
rl = get chf_tl_rxl tl
base = mul tl 512
for i ulong rl bound 512
put cfw_p_rx i get chf_tl_rx add base i
end
put cfw_p_rxl 0 rl
ret rl
end

fn chf_check_tl_admit tl ulong req_tier ulong req_err ulong b_out ulong to bool
if ne chf_rep_get64 tl 64 0
ret false
end
if ne chf_rep_get64 tl 80 1
ret false
end
if ne chf_rep_get64 tl 104 0
ret false
end
if ne chf_rep_get64 tl 96 b_out
ret false
end
if ne chf_rep_get64 tl 48 1
ret false
end
ret mm_dominates chf_rep_get64 tl 16 chf_rep_get64 tl 24 req_tier req_err
end

fn chf_arbitrate_and_promote req_tier ulong req_err ulong to ulong
best = ulong 99
best_lat = ulong 999999999
b_out = chf_rep_get64 CHF_TL_A 96
for tl ulong 3
if chf_check_tl_admit tl req_tier req_err b_out
lat = chf_rep_get64 tl 40
if lt lat best_lat
best = tl
best_lat = lat
end
end
end
if eq best 99
ret CHF_ERR_WATTCBF
end
put chf_winner 0 best
chf_save_tl_rx_paths
note Verify dominance gates: @exact -> @tol allowed, @tol -> @exact strictly refused!
if not mm_dominates 1 0 2 16
ret CHF_ERR_DOMINANCE
end
if mm_dominates 2 8 1 0
ret CHF_ERR_DOMINANCE
end
note Harvest verified pure sub-results into OMEGA-MEMO (with pure=1, ck_pure=1, egp3=0, ood=0)
put chf_probe_v2 0 1
put chf_probe_v3 0 0
put chf_probe_v4 0 1
if ne chf_admit_memo chf_t_sub_a 1 0 chf_rep_get64 CHF_TL_A 112 0 CHF_OK
ret CHF_ERR_MEMO_OOD
end
wtier = chf_rep_get64 best 16
werr = chf_rep_get64 best 24
if ne chf_admit_memo chf_t_sub_b wtier werr chf_rep_get64 best 112 0 CHF_OK
ret CHF_ERR_MEMO_OOD
end
note Verify @exact cached entry satisfies @tol(16) via dominance (0 recompute)!
mm_reset_req
chf_stage_memo_key chf_t_sub_a 11170509
mm_set_contract 1 1 2 16
if ne mm_lookup MM_OK
ret CHF_ERR_DOMINANCE
end
put chf_memo_hits 0 add get chf_memo_hits 0 1
note Verify @tol(8) cached entry strictly REFUSES @exact lookup!
chf_stage_memo_key chf_t_sub_b 11170509
mm_set_contract 1 1 1 0
if ne mm_lookup MM_ERR_PRECISION_MISS
ret CHF_ERR_DOMINANCE
end
note Register SLAB_IMMUTABLE (0) + SLAB_MUTABLE_ALARMED (1) and promote winner via W^X fabHotSwap!
crRegSlab 0 SLAB_IMMUTABLE 0 TID_X925
crRegSlab 1 SLAB_MUTABLE_ALARMED 100 TID_X925
wtid = ulong TID_X925
if eq best CHF_TL_B
wtid = ulong TID_SM121
end
if eq best CHF_TL_C
wtid = ulong TID_A725
end
wptr = add 0x200000 mul best 0x10000
if not fabHotSwap 0 CHF_SEM_KERN wptr wtid FAB_MODE_CRYSTALLIZED 7
ret CHF_ERR_PARITY
end
cpufence
tkj_pack_u64x4 best wtier werr chf_rep_get64 best 32
if ne tkj_append TKJ_OP_CALL 1 best 32 TKJ_OK
ret CHF_ERR_OTKJ
end
ret CHF_OK
end

fn chf_run_ood_and_rewind to ulong
win = get chf_winner 0
rl = chf_load_tl_rx_path win
cfw_set_args 11 150 5 9 1
xout = cfw_exec_sealed rl
oex = get cfw_last_exit 0
put chf_ood_exit 0 oex
if ne win CHF_TL_A
if eq oex 0
ret CHF_ERR_PARITY
end
end
note Mutate live VM/SLAB state to simulate speculative OOD drift before rewind!
put sc_regs 1 150
put sc_regs 5 win
put sc_regs 8 1
put sc_slab 0 255
put sc_slab 1 255
note Refuse OOD branch attempt to poison OMEGA-MEMO!
st_bef = get mm_stats 7
if ne chf_admit_memo chf_t_sub_b 2 8 999999 1 CHF_ERR_MEMO_OOD
ret CHF_ERR_MEMO_OOD
end
if ne get mm_stats 7 st_bef
ret CHF_ERR_MEMO_OOD
end
note Trip SLAB_MUTABLE_ALARMED & verify SLAB_IMMUTABLE stays immutable!
arc = crUpdateSlab 1 200
put chf_ood_alarm 0 arc
if ne arc CR_ERR_ALARM
ret CHF_ERR_SLAB_CKPT
end
if ne crUpdateSlab 0 1 CR_ERR_IMMUTABLE
ret CHF_ERR_SLAB_CKPT
end
note Atomic fabHotSwap rollback to baseline Timeline A (0500 RX)!
if not fabHotSwap 0 CHF_SEM_KERN 0x100000 TID_X925 FAB_MODE_CPU_NATIVE 7
ret CHF_ERR_PARITY
end
cpufence
note Deterministic Stage 2 SLAB rewind back to exact T0 checkpoint!
if ne sck_restore_id 0 SCK_OK
ret CHF_ERR_SLAB_CKPT
end
if ne sck_hash_live SCK_OK
ret CHF_ERR_SLAB_CKPT
end
eq_ok = ulong 1
for j ulong 32
b = get sh_dig j
put chf_post_hash j b
if ne b get chf_t0_hash j
eq_ok = ulong 0
end
end
put chf_t0_hash_eq 0 eq_ok
if ne eq_ok 1
ret CHF_ERR_SLAB_CKPT
end
tkj_pack_u64x4 oex arc eq_ok 0
if ne tkj_append TKJ_OP_TRAP 2 0 32 TKJ_OK
ret CHF_ERR_OTKJ
end
if ne tkj_verify_buf tkj_bytes TKJ_OK
ret CHF_ERR_OTKJ
end
ol = chf_mk_subpath chf_suf_otkj 1
for i ulong ol bound 512
put tj_path i get chf_otkj_path i
end
put tj_plen 0 ol
if ne tkj_write_path TKJ_OK
ret CHF_ERR_OTKJ
end
rl0 = chf_load_tl_rx_path CHF_TL_A
cfw_set_args 11 150 5 9 1
fb = cfw_exec_sealed rl0
put chf_ood_fb_out 0 fb
if or ne get cfw_last_exit 0 0 ne fb 133
ret CHF_ERR_PARITY
end
ret CHF_OK
end

note ==== Section 8: Top-Level Commands & Main Dispatch ====

fn chf_init_all to void
tdInitAll
isInitRules
tdCacheInit
fabInit
crInit
pb_init
ps_init
put cfw_rwx_ref 0 0
put cfw_sha_ref 0 0
put cfw_mode_ref 0 0
put chf_winner 0 0
put chf_memo_hits 0 0
put chf_memo_stores 0 0
put chf_memo_poison_ref 0 0
put chf_ood_exit 0 0
put chf_ood_alarm 0 0
put chf_ood_fb_out 0 0
put chf_t0_hash_eq 0 0
for i ulong 8
put chf_cf_div i 0
end
end

fn chf_cmd_do_status to int
chf_init_all
chf_sense_thermal
st = new WattThermal get chf_th_tdie 0 get chf_th_tsink 0 get chf_th_tamb 0
pol = new WattPolicy get chf_th_pbud 0 WATT_P_GPU_HARD_MAX get chf_th_tceil 0 get chf_th_tau 0
ps_query_envelope st pol
chf_wrt chf_m_st1
chf_num ulong get g_wmeta 12
chf_wrt chf_m_st2
chf_num get chf_live_sens 0
chf_wrt chf_m_st3
chf_i64 get chf_th_tdie 0
chf_wrt chf_m_st4
chf_i64 get chf_th_tsink 0
chf_wrt chf_m_st5
chf_i64 get ps_tel PS_TEL_P_SAFE_GPU
chf_wrt chf_m_st6
chf_num get cfw_rwx_ref 0
chf_wrt chf_nl
ret 0
end

fn chf_print_forge_pass to void
chf_wrt chf_m_p1
w = get chf_winner 0
if eq w CHF_TL_A
chf_wrt chf_lbl_a
else
if eq w CHF_TL_B
chf_wrt chf_lbl_b
else
chf_wrt chf_lbl_c
end
end
chf_wrt chf_m_p2
chf_num chf_rep_get64 w 96
chf_wrt chf_m_p3
chf_num chf_rep_get64 w 32
chf_wrt chf_m_p4
chf_i64 long chf_rep_get64 w 56
chf_wrt chf_m_p5
chf_num get chf_memo_stores 0
chf_wrt chf_m_p6
chf_num get chf_memo_hits 0
chf_wrt chf_m_p7
chf_num get chf_memo_poison_ref 0
chf_wrt chf_m_p8
chf_num get chf_ood_exit 0
chf_wrt chf_m_p9
chf_num get chf_ood_alarm 0
chf_wrt chf_m_p10
chf_num get chf_t0_hash_eq 0
chf_wrt chf_m_p11
chf_num get chf_ood_fb_out 0
chf_wrt chf_m_p12
chf_num get chf_cf_div 1
chf_wrt chf_m_p13
chf_num ulong get g_wmeta 12
chf_wrt chf_nl
end

fn chf_cmd_do_forge to int
chf_init_all
chf_sense_thermal
rc = chf_setup_memo
if ne rc CHF_OK
chf_wrt chf_m_f
chf_num rc
chf_wrt chf_nl
ret int rc
end
rc = chf_anchor_t0
if ne rc CHF_OK
chf_wrt chf_m_f
chf_num rc
chf_wrt chf_nl
ret int rc
end
rc = chf_fork_all_timelines
if ne rc CHF_OK
chf_wrt chf_m_f
chf_num rc
chf_wrt chf_nl
ret int rc
end
rc = chf_arbitrate_and_promote 2 16
if ne rc CHF_OK
chf_wrt chf_m_f
chf_num rc
chf_wrt chf_nl
ret int rc
end
if ne get chf_do_ood 0 0
rc = chf_run_ood_and_rewind
if ne rc CHF_OK
chf_wrt chf_m_f
chf_num rc
chf_wrt chf_nl
ret int rc
end
end
chf_print_forge_pass
ret 0
end

fn chf_parse_forge_flags start ulong to int
n = ulong argcnt
i = start
while lt i n bound 64
if chf_arg_eq i chf_fl_hot
put chf_hot_sim 0 1
i = add i 1
continue
end
if chf_arg_eq i chf_fl_ood
put chf_do_ood 0 1
i = add i 1
continue
end
if chf_arg_eq i chf_fl_nood
put chf_do_ood 0 0
i = add i 1
continue
end
if chf_arg_eq i chf_fl_dir
i = add i 1
if ge i n
ret 1
end
rn = argread i chf_dir 0 440
if le rn 0
ret 1
end
put chf_dirl 0 ulong rn
i = add i 1
continue
end
if chf_arg_eq i chf_fl_pwr
i = add i 1
if ge i n
ret 1
end
pv = chf_parse_arg_u64 i
if lt pv 0
ret 1
end
put chf_pwr_cap 0 pv
i = add i 1
continue
end
ret 1
end
ret 0
end

fn chf_run_probes to int
if chf_arg_eq 1 chf_cmd_pwatt
if lt argcnt 3
ret 1
end
pg = chf_parse_arg_u64 2
if lt pg 0
ret 1
end
chf_init_all
chf_sense_thermal
if eq chf_check_watt_admit pg 10000 5000 1
ret 0
end
ret int CHF_ERR_WATTCBF
end
if chf_arg_eq 1 chf_cmd_pdom
if lt argcnt 6
ret 1
end
ct = chf_parse_arg_u64 2
ce = chf_parse_arg_u64 3
rt = chf_parse_arg_u64 4
re = chf_parse_arg_u64 5
if or lt ct 0 or lt ce 0 or lt rt 0 lt re 0
ret 1
end
if mm_dominates ulong ct ulong ce ulong rt ulong re
ret 0
end
ret int CHF_ERR_DOMINANCE
end
if chf_arg_eq 1 chf_cmd_pood
chf_init_all
chf_copy_def_dir
z = chf_setup_memo
put chf_probe_v2 0 1
put chf_probe_v3 0 0
put chf_probe_v4 0 1
rc = chf_admit_memo chf_t_sub_b 2 8 999999 1
ret int rc
end
ret 99
end

fn main to int
if chf_scan_rwx_arg
chf_werr chf_e_rwx
ret int CHF_ERR_RWX
end
chf_copy_def_dir
put chf_hot_sim 0 0
put chf_pwr_cap 0 0
put chf_do_ood 0 1
if lt argcnt 2
chf_wrt chf_u_msg
ret 0
end
if or chf_arg_eq 1 chf_cmd_help chf_arg_eq 1 chf_cmd_h
chf_wrt chf_u_msg
ret 0
end
if chf_arg_eq 1 chf_cmd_status
ret chf_cmd_do_status
end
if chf_arg_eq 1 chf_cmd_forge
if ne chf_parse_forge_flags 2 0
chf_werr chf_e_arg
ret 1
end
ret chf_cmd_do_forge
end
pr = chf_run_probes
if ne pr 99
ret pr
end
chf_werr chf_e_arg
ret 1
end

note readings-window CLI: reads TSV telemetry samples from stdin, emits window stats JSON or text.
note Compose: si/directives/om2.om + apps/readings-window/lib.om + apps/readings-window/main.om

text rw_cli_flag_text "--text"
text rw_cli_err_parse "readings-window: malformed telemetry TSV line\n"
text rw_cli_err_ingest "readings-window: sample refused (monotonicity or bounds violation)\n"
text rw_cli_err_empty "readings-window: no telemetry samples provided\n"

fn rw_write_all fd int buf view uchar * n ulong to bool
done = ulong 0
while lt done n bound 65536
k = write fd buf done sub n done
if le k 0
ret false
end
done = add done ulong k
end
ret true
end

fn rw_read_stdin dst edit uchar * to long
got = ulong 0
cap = len dst
while lt got cap bound 65536
k = read 0 dst got sub cap got
if lt k 0
ret -1
end
if eq k 0
break
end
got = add got ulong k
end
ret long got
end

fn rw_want_text to bool
if lt argcnt 2
ret false
end
a1 = new uchar 64 0
n1 = argread 1 a1 0 64
if le n1 0
ret false
end
ret rw_eq_bytes part a1 0 ulong n1 rw_cli_flag_text
end

fn main to int
inbuf = new uchar 16384 0
nread = rw_read_stdin inbuf
if le nread 0
w = rw_write_all 2 rw_cli_err_empty len rw_cli_err_empty
if not w
ret 2
end
ret 1
end
ring = new RwRing 0 0 0 0 0
rbuf = new ulong 512 0
rw_ring_init ring
sample = new RwSample 0 0 0 0 0 0 0
cur = ulong 0
total = ulong nread
while lt cur total bound 16384
ls = cur
while lt cur total bound 16384
if eq get inbuf cur 10
cur = add cur 1
break
end
cur = add cur 1
end
ll = sub cur ls
if eq ll 0
continue
end
if eq get inbuf ls 10
continue
end
if eq get inbuf ls 35
continue
end
if not rw_parse_tsv_sample part inbuf ls ll sample
w = rw_write_all 2 rw_cli_err_parse len rw_cli_err_parse
if not w
ret 2
end
ret 1
end
rc = rw_ingest ring rbuf sample
if ne rc 0
w = rw_write_all 2 rw_cli_err_ingest len rw_cli_err_ingest
if not w
ret 2
end
ret 1
end
end
stats = new RwStats 0 0 0 0 0 0 0
if not rw_compute_stats ring rbuf RW_METRIC_GPU_TEMP 0 stats
w = rw_write_all 2 rw_cli_err_empty len rw_cli_err_empty
if not w
ret 2
end
ret 1
end
th = new RwThresh 85 250 90 98 115000
alarms = rw_check_alarms ring rbuf th
outbuf = new uchar 512 0
olen = long 0
if rw_want_text
olen = rw_format_stats_text outbuf stats alarms
else
olen = rw_format_stats_json outbuf stats alarms
end
if lt olen 0
ret 1
end
ok = rw_write_all 1 outbuf ulong olen
if not ok
ret 1
end
ret 0
end

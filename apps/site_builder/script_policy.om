note SPDX-License-Identifier: Apache-2.0
note apps/site_builder/script_policy.om: pure-Omega zero-external-script policy verifier
note Enforces strict static HTML safety for aienos.com and interplane-forge:
note forbids <script>, inline event handlers, javascript:/data:text/html URIs,
note active embeds (<iframe>/<object>/<embed>/<applet>), external <link> stylesheets,
note and unsafe control bytes.
note Compose after si/directives/om2.om and apps/site_builder/html_feed.om.

const SB_POL_OK ulong 0
const SB_POL_ERR_EMPTY ulong 1
const SB_POL_ERR_SCRIPT_TAG ulong 2
const SB_POL_ERR_EVENT_HANDLER ulong 3
const SB_POL_ERR_JS_URI ulong 4
const SB_POL_ERR_EXT_LINK ulong 5
const SB_POL_ERR_CTRL_BYTE ulong 6

text sb_pat_script "<script"
text sb_pat_onload "onload="
text sb_pat_onerror "onerror="
text sb_pat_onclick "onclick="
text sb_pat_onfocus "onfocus="
text sb_pat_onhover "onmouseover="
text sb_pat_jsuri "javascript:"
text sb_pat_datahtml "data:text/html"
text sb_pat_iframe "<iframe"
text sb_pat_object "<object"
text sb_pat_embed "<embed"
text sb_pat_applet "<applet"
text sb_pat_ext_http "href=\"http://"
text sb_pat_ext_https "href=\"https://"
text sb_pat_ext_proto "href=\"//"
text sb_pat_src_http "src=\"http://"
text sb_pat_src_https "src=\"https://"
text sb_pat_src_proto "src=\"//"

fn sb_ascii_lower b uchar to uchar
if and ge b uchar 65 le b uchar 90
ret add b uchar 32
end
ret b
end

fn sb_contains_ci hay view uchar * needle view uchar * to bool
nh = len hay
nn = len needle
if eq nn ulong 0
ret true
end
if lt nh nn
ret false
end
if gt nh ulong 65536
ret false
end
lim = sub nh nn
i = ulong 0
while le i lim bound 65537
matched = true
j = ulong 0
while lt j nn bound 64
ch = sb_ascii_lower get hay add i j
cn = sb_ascii_lower get needle j
if ne ch cn
matched = false
break
end
j = add j ulong 1
end
if matched
ret true
end
i = add i ulong 1
end
ret false
end

fn sb_check_ctrl_bytes html view uchar * to bool
n = len html
if gt n ulong 65536
ret false
end
i = ulong 0
while lt i n bound 65536
b = get html i
if lt b uchar 32
if and ne b uchar 9 and ne b uchar 10 ne b uchar 13
ret false
end
end
if eq b uchar 127
ret false
end
i = add i ulong 1
end
ret true
end

fn sb_check_events html view uchar * to bool
if sb_contains_ci html sb_pat_onload
ret false
end
if sb_contains_ci html sb_pat_onerror
ret false
end
if sb_contains_ci html sb_pat_onclick
ret false
end
if sb_contains_ci html sb_pat_onfocus
ret false
end
if sb_contains_ci html sb_pat_onhover
ret false
end
ret true
end

fn sb_check_ext_embeds html view uchar * to bool
if sb_contains_ci html sb_pat_iframe
ret false
end
if sb_contains_ci html sb_pat_object
ret false
end
if sb_contains_ci html sb_pat_embed
ret false
end
if sb_contains_ci html sb_pat_applet
ret false
end
if sb_contains_ci html sb_pat_ext_http
ret false
end
if sb_contains_ci html sb_pat_ext_https
ret false
end
if sb_contains_ci html sb_pat_ext_proto
ret false
end
if sb_contains_ci html sb_pat_src_http
ret false
end
if sb_contains_ci html sb_pat_src_https
ret false
end
if sb_contains_ci html sb_pat_src_proto
ret false
end
ret true
end

fn sb_verify_zero_external_script html view uchar * to ulong
n = len html
if eq n ulong 0
ret SB_POL_ERR_EMPTY
end
if not sb_check_ctrl_bytes html
ret SB_POL_ERR_CTRL_BYTE
end
if sb_contains_ci html sb_pat_script
ret SB_POL_ERR_SCRIPT_TAG
end
if not sb_check_events html
ret SB_POL_ERR_EVENT_HANDLER
end
if or sb_contains_ci html sb_pat_jsuri sb_contains_ci html sb_pat_datahtml
ret SB_POL_ERR_JS_URI
end
if not sb_check_ext_embeds html
ret SB_POL_ERR_EXT_LINK
end
ret SB_POL_OK
end

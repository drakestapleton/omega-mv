note SPDX-License-Identifier: Apache-2.0
note apps/site_builder/test.om: positive, negative & mutant control test suite
note for aienos.com / interplane-forge deterministic static HTML/feed generator,
note zero-external-script policy verifier, and Radicle repo index parser.
note Compose with:
note   si/directives/om2.om om/tls/sha2.om apps/site_builder/html_feed.om
note   apps/site_builder/script_policy.om apps/site_builder/radicle_index.om
note   apps/site_builder/test.om

text ts_pass "PASS "
text ts_fail "FAIL "
text ts_nl "\n"

text ts_c1 "html_static_generator_escaping_and_determinism"
text ts_c2 "atom_feed_generator_escaping_and_determinism"
text ts_c3 "zero_external_script_policy_pos_and_neg_controls"
text ts_c4 "radicle_rid_name_oid_vis_pos_and_neg_controls"
text ts_c5 "radicle_repo_index_parser_sorted_comments_and_neg_controls"
text ts_c6 "site_builder_mutant_controls_html_policy_and_index"
text ts_done "PASS apps-site-builder all 6 test suites passed (pos+neg+mutant)\n"

text ts_title "AIEN Forge & Omega"
text ts_slug "omega-mv"
text ts_label "Omega Compiler <seed>"
text ts_xss_title "<script>alert('xss')</script>&\"ok\""
text ts_fid "urn:interplane:feed:main"
text ts_upd "2026-11-19T00:00:00Z"
text ts_eid "urn:interplane:commit:6b452557"
text ts_sum "Pure Omega wave 4 & <verified>"

text ts_pol_script "<html><body><script src=\"https://cdn.evil/x.js\"></script></body></html>"
text ts_pol_script_uc "<html><body><SCRIPT>alert(1)</SCRIPT></body></html>"
text ts_pol_evt "<html><body OnError=\"boom()\">hi</body></html>"
text ts_pol_jsuri "<html><body><a href=\"JavaScript:void(0)\">x</a></body></html>"
text ts_pol_iframe "<html><body><iframe src=\"/x\"></iframe></body></html>"
text ts_pol_extlink "<html><head><link rel=\"stylesheet\" href=\"https://evil.cdn/a.css\"></head></html>"

text ts_rid_ok "rad:z3gqcJUoA1n9HaHKufZs5FCSGazv5"
text ts_rid_bad_pfx "git:z3gqcJUoA1n9HaHKufZs5FCSGazv5"
text ts_rid_short "rad:z123456789"
text ts_rid_bad_0 "rad:z3gqcJUoA1n9HaHKufZs5FCSGazv0"
text ts_rid_bad_O "rad:z3gqcJUoA1n9HaHKufZs5FCSGazvO"
text ts_rid_bad_I "rad:z3gqcJUoA1n9HaHKufZs5FCSGazvI"
text ts_rid_bad_l "rad:z3gqcJUoA1n9HaHKufZs5FCSGazvl"

text ts_name_ok "omega-mv_1.0"
text ts_name_trav "a..b"
text ts_name_dot ".hidden"
text ts_oid_ok "6c562dd1f7ab01fd9a2638e74a7330ec4c941ad8"
text ts_oid_bad "6c562dd1f7ab01fd9a2638e74a7330ec4c941adG"
text ts_oid_short "6c562dd1"
text ts_vis_pub "public"
text ts_vis_bad "unlisted"

text ts_idx_ok "# interplane radicle index\nrad:z2gqcJUoA1n9HaHKufZs5FCSGazv5\taienux\t6c562dd1f7ab01fd9a2638e74a7330ec4c941ad8\tpublic\n\nrad:z3gqcJUoA1n9HaHKufZs5FCSGazv5\tomega-mv\t34d611ca0415eab1728d3234911d90e74af17ba9\tprivate\n"
text ts_idx_unsorted "rad:z3gqcJUoA1n9HaHKufZs5FCSGazv5\tomega-mv\t34d611ca0415eab1728d3234911d90e74af17ba9\tpublic\nrad:z2gqcJUoA1n9HaHKufZs5FCSGazv5\taienux\t6c562dd1f7ab01fd9a2638e74a7330ec4c941ad8\tpublic\n"
text ts_idx_dup "rad:z2gqcJUoA1n9HaHKufZs5FCSGazv5\taienux\t6c562dd1f7ab01fd9a2638e74a7330ec4c941ad8\tpublic\nrad:z2gqcJUoA1n9HaHKufZs5FCSGazv5\tomega-mv\t34d611ca0415eab1728d3234911d90e74af17ba9\tpublic\n"
text ts_idx_bad_cols "rad:z2gqcJUoA1n9HaHKufZs5FCSGazv5\taienux\t6c562dd1f7ab01fd9a2638e74a7330ec4c941ad8\n"

text ts_esc_expect "&lt;script&gt;alert(&#39;xss&#39;)&lt;/script&gt;&amp;&quot;ok&quot;"
text ts_inj_script "<script>"

fn ts_report name view uchar * ok bool to int
if ok
w1 = sb_write_all int 1 ts_pass
w2 = sb_write_all int 1 name
w3 = sb_write_all int 1 ts_nl
if and w1 and w2 w3
ret int 0
end
ret int 1
end
w4 = sb_write_all int 1 ts_fail
w5 = sb_write_all int 1 name
w6 = sb_write_all int 1 ts_nl
if and w4 and w5 w6
ret int 1
end
ret int 1
end

fn test_html_gen to bool
esc = new uchar 256 0
elen = sb_html_escape esc ulong 0 ts_xss_title
if not sb_slice_eq part esc ulong 0 elen ts_esc_expect
ret false
end
b1 = new uchar 2048 0
b2 = new uchar 2048 0
p1 = sb_render_html_head b1 ulong 0 ts_title
p1 = sb_render_html_item_open b1 p1 ts_slug
p1 = sb_render_html_item_close b1 p1 ts_label
p1 = sb_render_html_foot b1 p1
p2 = sb_render_html_head b2 ulong 0 ts_title
p2 = sb_render_html_item_open b2 p2 ts_slug
p2 = sb_render_html_item_close b2 p2 ts_label
p2 = sb_render_html_foot b2 p2
if ne p1 p2
ret false
end
d1 = new uchar 32 0
d2 = new uchar 32 0
sb_sha256_slice part b1 ulong 0 p1 d1
sb_sha256_slice part b2 ulong 0 p2 d2
if not sb_digest_eq d1 d2
ret false
end
note Generated HTML must pass zero-external-script policy even with XSS title input
bx = new uchar 2048 0
px = sb_render_html_head bx ulong 0 ts_xss_title
px = sb_render_html_foot bx px
if ne sb_verify_zero_external_script part bx ulong 0 px SB_POL_OK
ret false
end
ret true
end

fn test_feed_gen to bool
f1 = new uchar 2048 0
f2 = new uchar 2048 0
p1 = sb_render_feed_head_title f1 ulong 0 ts_title
p1 = sb_render_feed_head_id f1 p1 ts_fid
p1 = sb_render_feed_head_upd f1 p1 ts_upd
p1 = sb_render_feed_entry_id f1 p1 ts_eid
p1 = sb_render_feed_entry_title f1 p1 ts_label
p1 = sb_render_feed_entry_summary f1 p1 ts_sum
p1 = sb_render_feed_foot f1 p1
p2 = sb_render_feed_head_title f2 ulong 0 ts_title
p2 = sb_render_feed_head_id f2 p2 ts_fid
p2 = sb_render_feed_head_upd f2 p2 ts_upd
p2 = sb_render_feed_entry_id f2 p2 ts_eid
p2 = sb_render_feed_entry_title f2 p2 ts_label
p2 = sb_render_feed_entry_summary f2 p2 ts_sum
p2 = sb_render_feed_foot f2 p2
if ne p1 p2
ret false
end
d1 = new uchar 32 0
d2 = new uchar 32 0
sb_sha256_slice part f1 ulong 0 p1 d1
sb_sha256_slice part f2 ulong 0 p2 d2
if not sb_digest_eq d1 d2
ret false
end
ret true
end

fn test_script_policy to bool
b = new uchar 2048 0
p = sb_render_html_head b ulong 0 ts_title
p = sb_render_html_foot b p
if ne sb_verify_zero_external_script part b ulong 0 p SB_POL_OK
ret false
end
if ne sb_verify_zero_external_script part b ulong 0 ulong 0 SB_POL_ERR_EMPTY
ret false
end
if ne sb_verify_zero_external_script ts_pol_script SB_POL_ERR_SCRIPT_TAG
ret false
end
if ne sb_verify_zero_external_script ts_pol_script_uc SB_POL_ERR_SCRIPT_TAG
ret false
end
if ne sb_verify_zero_external_script ts_pol_evt SB_POL_ERR_EVENT_HANDLER
ret false
end
if ne sb_verify_zero_external_script ts_pol_jsuri SB_POL_ERR_JS_URI
ret false
end
if ne sb_verify_zero_external_script ts_pol_iframe SB_POL_ERR_EXT_LINK
ret false
end
if ne sb_verify_zero_external_script ts_pol_extlink SB_POL_ERR_EXT_LINK
ret false
end
note Control byte negative control (NUL byte)
put b ulong 5 uchar 0
if ne sb_verify_zero_external_script part b ulong 0 p SB_POL_ERR_CTRL_BYTE
ret false
end
ret true
end

fn test_radicle_fields to bool
if ne rad_validate_rid ts_rid_ok RAD_OK
ret false
end
if ne rad_validate_rid ts_rid_bad_pfx RAD_ERR_RID_PREFIX
ret false
end
if ne rad_validate_rid ts_rid_short RAD_ERR_RID_LEN
ret false
end
if ne rad_validate_rid ts_rid_bad_0 RAD_ERR_RID_CHAR
ret false
end
if ne rad_validate_rid ts_rid_bad_O RAD_ERR_RID_CHAR
ret false
end
if ne rad_validate_rid ts_rid_bad_I RAD_ERR_RID_CHAR
ret false
end
if ne rad_validate_rid ts_rid_bad_l RAD_ERR_RID_CHAR
ret false
end
if ne rad_validate_name ts_name_ok RAD_OK
ret false
end
if ne rad_validate_name ts_name_trav RAD_ERR_NAME
ret false
end
if ne rad_validate_name ts_name_dot RAD_ERR_NAME
ret false
end
if ne rad_validate_oid ts_oid_ok RAD_OK
ret false
end
if ne rad_validate_oid ts_oid_bad RAD_ERR_OID
ret false
end
if ne rad_validate_oid ts_oid_short RAD_ERR_OID
ret false
end
if ne rad_validate_vis ts_vis_pub RAD_OK
ret false
end
if ne rad_validate_vis ts_vis_bad RAD_ERR_VIS
ret false
end
ret true
end

fn test_radicle_index to bool
cnt = new ulong 1 0
if ne rad_parse_index ts_idx_ok cnt RAD_OK
ret false
end
if ne get cnt ulong 0 ulong 2
ret false
end
if ne rad_parse_index ts_idx_unsorted cnt RAD_ERR_ORDER
ret false
end
if ne rad_parse_index ts_idx_dup cnt RAD_ERR_DUPLICATE
ret false
end
if ne rad_parse_index ts_idx_bad_cols cnt RAD_ERR_FIELDS
ret false
end
ret true
end

fn test_mutants to bool
note Mutant 1: 1-byte mutation in rendered HTML changes SHA-256 digest
b = new uchar 2048 0
p = sb_render_html_head b ulong 0 ts_title
p = sb_render_html_foot b p
d1 = new uchar 32 0
d2 = new uchar 32 0
sb_sha256_slice part b ulong 0 p d1
put b ulong 0 xor get b ulong 0 uchar 1
sb_sha256_slice part b ulong 0 p d2
if sb_digest_eq d1 d2
ret false
end
put b ulong 0 xor get b ulong 0 uchar 1
note Mutant 2: injecting <script> into valid HTML flips policy PASS -> FAIL
p2 = sb_append_bytes b p ts_inj_script
if ne sb_verify_zero_external_script part b ulong 0 p2 SB_POL_ERR_SCRIPT_TAG
ret false
end
note Mutant 3: mutating 1 char of valid RID to forbidden Base58 char '0' flips RAD_OK -> RAD_ERR_RID_CHAR
rbuf = new uchar 64 0
rlen = rad_copy_rid rbuf ts_rid_ok
if ne rad_validate_rid part rbuf ulong 0 rlen RAD_OK
ret false
end
put rbuf sub rlen ulong 1 uchar 48
if ne rad_validate_rid part rbuf ulong 0 rlen RAD_ERR_RID_CHAR
ret false
end
ret true
end

fn main to int
fails = int 0
fails = add fails ts_report ts_c1 test_html_gen
fails = add fails ts_report ts_c2 test_feed_gen
fails = add fails ts_report ts_c3 test_script_policy
fails = add fails ts_report ts_c4 test_radicle_fields
fails = add fails ts_report ts_c5 test_radicle_index
fails = add fails ts_report ts_c6 test_mutants
if ne fails int 0
ret int 1
end
if not sb_write_all int 1 ts_done
ret int 1
end
ret int 0
end

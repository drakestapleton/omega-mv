note SPDX-License-Identifier: Apache-2.0
note apps/site_builder/html_feed.om: pure-Omega deterministic static HTML and Atom feed generator
note for aienos.com and interplane-forge.
note Emits strict CSP (script-src 'none'), HTML/XML-escaped content, and SHA-256 build digests.
note Compose after si/directives/om2.om and om/tls/sha2.om.

text sb_amp "&amp;"
text sb_lt "&lt;"
text sb_gt "&gt;"
text sb_quot "&quot;"
text sb_apos "&#39;"

text sb_html_p1 "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'none'; object-src 'none'\"><title>"
text sb_html_p2 "</title></head><body><main><h1>"
text sb_html_p3 "</h1><ul>"
text sb_html_li1 "<li><a href=\"/"
text sb_html_li2 "\">"
text sb_html_li3 "</a></li>"
text sb_html_end "</ul></main></body></html>\n"

text sb_feed_p1 "<?xml version=\"1.0\" encoding=\"utf-8\"?><feed xmlns=\"http://www.w3.org/2005/Atom\"><title>"
text sb_feed_p2 "</title><id>"
text sb_feed_p3 "</id><updated>"
text sb_feed_p4 "</updated>"
text sb_feed_e1 "<entry><id>"
text sb_feed_e2 "</id><title>"
text sb_feed_e3 "</title><summary>"
text sb_feed_e4 "</summary></entry>"
text sb_feed_end "</feed>\n"

fn sb_slice_eq a view uchar * b view uchar * to bool
na = len a
nb = len b
if ne na nb
ret false
end
if gt na ulong 65536
ret false
end
i = ulong 0
while lt i na bound 65536
if ne get a i get b i
ret false
end
i = add i ulong 1
end
ret true
end

fn sb_write_all fd int buf view uchar * to bool
n = len buf
if eq n ulong 0
ret true
end
if gt n ulong 1048576
ret false
end
off = ulong 0
while lt off n bound 1048576
remn = sub n off
k = write fd buf off remn
if le k long 0
ret false
end
off = add off ulong k
end
ret true
end

fn sb_append_byte dst edit uchar * pos ulong b uchar to ulong
if ge pos len dst
ret pos
end
put dst pos b
ret add pos ulong 1
end

fn sb_append_bytes dst edit uchar * pos ulong src view uchar * to ulong
cap = len dst
ns = len src
if gt ns ulong 65536
ret pos
end
i = ulong 0
p = pos
while lt i ns bound 65536
if ge p cap
ret p
end
put dst p get src i
p = add p ulong 1
i = add i ulong 1
end
ret p
end

fn sb_html_escape dst edit uchar * pos ulong src view uchar * to ulong
ns = len src
if gt ns ulong 65536
ret pos
end
i = ulong 0
p = pos
while lt i ns bound 65536
b = get src i
if eq b uchar 38
p = sb_append_bytes dst p sb_amp
else
if eq b uchar 60
p = sb_append_bytes dst p sb_lt
else
if eq b uchar 62
p = sb_append_bytes dst p sb_gt
else
if eq b uchar 34
p = sb_append_bytes dst p sb_quot
else
if eq b uchar 39
p = sb_append_bytes dst p sb_apos
else
p = sb_append_byte dst p b
end
end
end
end
end
i = add i ulong 1
end
ret p
end

fn sb_render_html_head dst edit uchar * pos ulong title view uchar * to ulong
p = sb_append_bytes dst pos sb_html_p1
p = sb_html_escape dst p title
p = sb_append_bytes dst p sb_html_p2
p = sb_html_escape dst p title
p = sb_append_bytes dst p sb_html_p3
ret p
end

fn sb_render_html_item_open dst edit uchar * pos ulong slug view uchar * to ulong
p = sb_append_bytes dst pos sb_html_li1
p = sb_html_escape dst p slug
p = sb_append_bytes dst p sb_html_li2
ret p
end

fn sb_render_html_item_close dst edit uchar * pos ulong label view uchar * to ulong
p = sb_html_escape dst pos label
p = sb_append_bytes dst p sb_html_li3
ret p
end

fn sb_render_html_foot dst edit uchar * pos ulong to ulong
ret sb_append_bytes dst pos sb_html_end
end

fn sb_render_feed_head_title dst edit uchar * pos ulong title view uchar * to ulong
p = sb_append_bytes dst pos sb_feed_p1
p = sb_html_escape dst p title
p = sb_append_bytes dst p sb_feed_p2
ret p
end

fn sb_render_feed_head_id dst edit uchar * pos ulong fid view uchar * to ulong
p = sb_html_escape dst pos fid
p = sb_append_bytes dst p sb_feed_p3
ret p
end

fn sb_render_feed_head_upd dst edit uchar * pos ulong upd view uchar * to ulong
p = sb_html_escape dst pos upd
p = sb_append_bytes dst p sb_feed_p4
ret p
end

fn sb_render_feed_entry_id dst edit uchar * pos ulong eid view uchar * to ulong
p = sb_append_bytes dst pos sb_feed_e1
p = sb_html_escape dst p eid
p = sb_append_bytes dst p sb_feed_e2
ret p
end

fn sb_render_feed_entry_title dst edit uchar * pos ulong title view uchar * to ulong
p = sb_html_escape dst pos title
p = sb_append_bytes dst p sb_feed_e3
ret p
end

fn sb_render_feed_entry_summary dst edit uchar * pos ulong summary view uchar * to ulong
p = sb_html_escape dst pos summary
p = sb_append_bytes dst p sb_feed_e4
ret p
end

fn sb_render_feed_foot dst edit uchar * pos ulong to ulong
ret sb_append_bytes dst pos sb_feed_end
end

fn sb_sha256_slice buf view uchar * dst edit uchar 32 to void
ctx = new ulong 40 0
sha256_init ctx
sha256_update ctx buf
sha256_final ctx dst
end

fn sb_digest_eq a view uchar 32 b view uchar 32 to bool
for i ulong 32
if ne get a i get b i
ret false
end
end
ret true
end

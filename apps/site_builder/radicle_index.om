note SPDX-License-Identifier: Apache-2.0
note apps/site_builder/radicle_index.om: pure-Omega Radicle repo index parser and validator
note Validates rad:z<base58btc> RIDs, repository names, Git SHA-1/SHA-256 OIDs,
note visibility tokens, tab-separated record structure, and canonical sorted index ordering.
note Compose after si/directives/om2.om and apps/site_builder/html_feed.om.

const RAD_OK ulong 0
const RAD_ERR_RID_PREFIX ulong 1
const RAD_ERR_RID_LEN ulong 2
const RAD_ERR_RID_CHAR ulong 3
const RAD_ERR_NAME ulong 4
const RAD_ERR_OID ulong 5
const RAD_ERR_VIS ulong 6
const RAD_ERR_FIELDS ulong 7
const RAD_ERR_DUPLICATE ulong 8
const RAD_ERR_ORDER ulong 9

text rad_pfx "rad:z"
text rad_vis_pub "public"
text rad_vis_priv "private"

fn rad_is_b58 b uchar to bool
if and ge b uchar 49 le b uchar 57
ret true
end
if and ge b uchar 65 le b uchar 72
ret true
end
if and ge b uchar 74 le b uchar 78
ret true
end
if and ge b uchar 80 le b uchar 90
ret true
end
if and ge b uchar 97 le b uchar 107
ret true
end
if and ge b uchar 109 le b uchar 122
ret true
end
ret false
end

fn rad_is_lhex b uchar to bool
if and ge b uchar 48 le b uchar 57
ret true
end
if and ge b uchar 97 le b uchar 102
ret true
end
ret false
end

fn rad_is_name_ch b uchar to bool
if and ge b uchar 97 le b uchar 122
ret true
end
if and ge b uchar 48 le b uchar 57
ret true
end
if or eq b uchar 45 or eq b uchar 46 eq b uchar 95
ret true
end
ret false
end

fn rad_validate_rid rid view uchar * to ulong
n = len rid
if lt n ulong 5
ret RAD_ERR_RID_PREFIX
end
if not sb_slice_eq part rid ulong 0 ulong 5 rad_pfx
ret RAD_ERR_RID_PREFIX
end
body = sub n ulong 5
if or lt body ulong 20 gt body ulong 48
ret RAD_ERR_RID_LEN
end
i = ulong 5
while lt i n bound 64
if not rad_is_b58 get rid i
ret RAD_ERR_RID_CHAR
end
i = add i ulong 1
end
ret RAD_OK
end

fn rad_validate_name name view uchar * to ulong
n = len name
if or eq n ulong 0 gt n ulong 64
ret RAD_ERR_NAME
end
first = get name ulong 0
if or eq first uchar 46 eq first uchar 45
ret RAD_ERR_NAME
end
prev_dot = false
i = ulong 0
while lt i n bound 64
b = get name i
if not rad_is_name_ch b
ret RAD_ERR_NAME
end
if eq b uchar 46
if prev_dot
ret RAD_ERR_NAME
end
prev_dot = true
else
prev_dot = false
end
i = add i ulong 1
end
ret RAD_OK
end

fn rad_validate_oid oid view uchar * to ulong
n = len oid
if and ne n ulong 40 ne n ulong 64
ret RAD_ERR_OID
end
i = ulong 0
while lt i n bound 64
if not rad_is_lhex get oid i
ret RAD_ERR_OID
end
i = add i ulong 1
end
ret RAD_OK
end

fn rad_validate_vis vis view uchar * to ulong
if sb_slice_eq vis rad_vis_pub
ret RAD_OK
end
if sb_slice_eq vis rad_vis_priv
ret RAD_OK
end
ret RAD_ERR_VIS
end

fn rad_slice_cmp a view uchar * b view uchar * to int
na = len a
nb = len b
ml = na
if lt nb ml
ml = nb
end
if gt ml ulong 128
ret int 0
end
i = ulong 0
while lt i ml bound 128
ca = get a i
cb = get b i
if lt ca cb
ret int -1
end
if gt ca cb
ret int 1
end
i = add i ulong 1
end
if lt na nb
ret int -1
end
if gt na nb
ret int 1
end
ret int 0
end

fn rad_parse_record line view uchar * out_meta edit ulong 8 to ulong
n = len line
if or eq n ulong 0 gt n ulong 512
ret RAD_ERR_FIELDS
end
tabs = new ulong 4 0
tcnt = ulong 0
i = ulong 0
while lt i n bound 512
if eq get line i uchar 9
if ge tcnt ulong 3
ret RAD_ERR_FIELDS
end
put tabs tcnt i
tcnt = add tcnt ulong 1
end
i = add i ulong 1
end
if ne tcnt ulong 3
ret RAD_ERR_FIELDS
end
t0 = get tabs ulong 0
t1 = get tabs ulong 1
t2 = get tabs ulong 2
put out_meta ulong 0 ulong 0
put out_meta ulong 1 t0
put out_meta ulong 2 add t0 ulong 1
put out_meta ulong 3 sub t1 add t0 ulong 1
put out_meta ulong 4 add t1 ulong 1
put out_meta ulong 5 sub t2 add t1 ulong 1
put out_meta ulong 6 add t2 ulong 1
put out_meta ulong 7 sub n add t2 ulong 1
rc = rad_validate_rid part line ulong 0 t0
if ne rc RAD_OK
ret rc
end
rc = rad_validate_name part line get out_meta ulong 2 get out_meta ulong 3
if ne rc RAD_OK
ret rc
end
rc = rad_validate_oid part line get out_meta ulong 4 get out_meta ulong 5
if ne rc RAD_OK
ret rc
end
rc = rad_validate_vis part line get out_meta ulong 6 get out_meta ulong 7
if ne rc RAD_OK
ret rc
end
ret RAD_OK
end

fn rad_copy_rid dst edit uchar 64 src view uchar * to ulong
ns = len src
if gt ns ulong 64
ret ulong 0
end
i = ulong 0
while lt i ns bound 64
put dst i get src i
i = add i ulong 1
end
ret ns
end

fn rad_check_line line view uchar * prev_rid edit uchar 64 prev_len edit ulong 1 to ulong
meta = new ulong 8 0
rc = rad_parse_record line meta
if ne rc RAD_OK
ret rc
end
rlen = get meta ulong 1
plen = get prev_len ulong 0
if gt plen ulong 0
c = rad_slice_cmp part prev_rid ulong 0 plen part line ulong 0 rlen
if eq c int 0
ret RAD_ERR_DUPLICATE
end
if gt c int 0
ret RAD_ERR_ORDER
end
end
nlen = rad_copy_rid prev_rid part line ulong 0 rlen
put prev_len ulong 0 nlen
ret RAD_OK
end

fn rad_parse_index buf view uchar * out_count edit ulong 1 to ulong
n = len buf
if gt n ulong 65536
ret RAD_ERR_FIELDS
end
prev_rid = new uchar 64 0
prev_len = new ulong 1 0
cnt = ulong 0
pos = ulong 0
while lt pos n bound 65536
start = pos
while lt pos n bound 65536
if eq get buf pos uchar 10
break
end
pos = add pos ulong 1
end
endp = pos
if gt endp start
if eq get buf sub endp ulong 1 uchar 13
endp = sub endp ulong 1
end
end
llen = sub endp start
if gt llen ulong 0
if ne get buf start uchar 35
rc = rad_check_line part buf start llen prev_rid prev_len
if ne rc RAD_OK
ret rc
end
cnt = add cnt ulong 1
end
end
if lt pos n
pos = add pos ulong 1
end
end
put out_count ulong 0 cnt
ret RAD_OK
end

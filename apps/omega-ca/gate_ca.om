note SPDX-License-Identifier: Apache-2.0
note apps/omega-ca/gate_ca.om
note Pure seeded OM-2 standalone qualification gate for apps/omega-ca (Wave 4 Reversible CA).
note Compile:
note   cat si/directives/om2.om seed/ng/sha256.om apps/omega-ca/gate_ca.om | seed/out/omc > gate_ca

text g_def_omc    "seed/out/omc"
text g_def_ng     "./ng"
text g_def_ngc    "./ngcheck"
text g_def_src    "apps/omega-ca"
text g_def_om2    "si/directives/om2.om"
text g_def_sha    "seed/ng/sha256.om"
text g_def_work   "/tmp/ca-gate"

text g_f_omc      "--omc"
text g_f_ng       "--ng"
text g_f_ngc      "--ngcheck"
text g_f_src      "--srcdir"
text g_f_om2      "--om2"
text g_f_sha      "--sha"
text g_f_work     "--workdir"

text g_devnull    "/dev/null"
text g_suf_eom    "/emit_ca_ir.om"
text g_suf_com    "/ca_engine.om"
text g_suf_ebin1  "/emit_ca_ir.1"
text g_suf_ebin2  "/emit_ca_ir.2"
text g_suf_ir     "/ca_worker.ir"
text g_suf_ngc1   "/ngc1.out"
text g_suf_optin  "/opt.in"
text g_suf_optcnt "/optcnt.out"
text g_suf_optir  "/ca_worker.opt.ir"
text g_suf_ngc2   "/ngc2.out"
text g_suf_a64in  "/a64.in"
text g_suf_wbin1  "/ca_worker.1"
text g_suf_wbin2  "/ca_worker.2"
text g_suf_csrc   "/cat_engine.om"
text g_suf_eng1   "/ca_engine.1"
text g_suf_eng2   "/ca_engine.2"
text g_suf_bout   "/bench.out"
text g_suf_sout   "/self.out"
text g_suf_vout   "/ver.out"
text g_suf_t0     "/t0.omca"
text g_suf_t1     "/t1.omca"
text g_suf_t1s    "/t1s.omca"
text g_suf_t1w    "/t1w.omca"
text g_suf_t2     "/t2.omca"
text g_suf_t128   "/t128.omca"
text g_suf_t0b    "/t0b.omca"
text g_suf_badsha "/bad_sha.omca"
text g_suf_badpop "/bad_pop.omca"
text g_suf_badmag "/bad_magic.omca"
text g_suf_tr64   "/bad_trunc64.omca"
text g_suf_trpay  "/bad_truncpay.omca"
text g_suf_out    "/mut_out.omca"

text g_dr_cnt     "@ng opt-count\n"
text g_dr_opt     "@ng opt\n"
text g_dr_a64     "@ng a64\n"

text g_k_acc      "ACCEPT "
text g_k_bce      "bce="
text g_k_rot      "rotated="
text g_k_diff0    "diff_bytes=0"

text g_c_init     "init"
text g_c_insp     "inspect"
text g_c_ev       "evolve"
text g_c_rv       "reverse"
text g_c_ver      "verify"
text g_c_self     "selftest"
text g_c_bnch     "bench"
text g_c_64       "64"
text g_c_65       "65"
text g_c_128      "128"
text g_c_256      "256"
text g_c_255      "255"
text g_c_160      "160"
text g_c_159      "159"
text g_c_1        "1"
text g_c_fw       "--worker"
text g_c_ft       "--threads"
text g_c_fsc      "--scalar"
text g_c_ffr      "--fault-rule"
text g_c_ffv      "--fault-reverse"
text g_c_ffw      "--fault-worker"

text g_p_hdr      "GATE_CA_START\n"
text g_p_g1       "PASS [G1] emit_ca_ir 2x deterministic rebuild (cmp -s OK)\n"
text g_p_g2       "PASS [G2] IR -> ngcheck -> @ng opt-count (bce>0,rotated>0) -> @ng opt -> ngcheck -> @ng a64 2x det + static ELF (PT_DYNAMIC=0)\n"
text g_p_g3       "PASS [G3] ca_engine 2x deterministic rebuild (cmp -s OK)\n"
text g_p_g4       "PASS [G4] ca_engine selftest (T=64, T=128, T=17 collider invariants)\n"
text g_p_g5       "PASS [G5] ca_engine bench (med9 1+9 runs, diff_bytes=0 across scalar/W=1/W=10/W=20)\n"
text g_p_g6       "PASS [G6] OMCA01 E2E collider (T=64 & T=128 round-trip 0-byte diff to T0, scalar==W1==W20)\n"
text g_p_n1       "PASS [N1] Fault control: irreversible bit flip rejected with exit 61\n"
text g_p_n2       "PASS [N2] Fault control: popcount-preserving reversibility break rejected with exit 62\n"
text g_p_n3       "PASS [N3] Fault control: odd width (255) & odd height (159) rejected with exit 63\n"
text g_p_n4       "PASS [N4] Fault control: tampered OMCA01 state_sha256 rejected with exit 64\n"
text g_p_n5       "PASS [N5] Fault control: non-conserved popcount header delta rejected with exit 65\n"
text g_p_n6       "PASS [N6] Fault control: corrupt OMCA01 magic rejected with exit 66\n"
text g_p_n7       "PASS [N7] Fault control: truncated OMCA01 header & payload rejected with exit 67\n"
text g_p_n8       "PASS [N8] Fault control: worker fault exit (49) caught by coordinator with exit 68\n"
text g_p_n9       "PASS [N9] Fault control: reverse underflow rejected with exit 69\n"
text g_p_done     "GATE_CA_ALL_PASS checks=15 positive=6 negative=9\n"
text g_p_fail     "GATE_CA_FAIL step="

global g_omc      uchar 4096
global g_ng       uchar 4096
global g_ngc      uchar 4096
global g_src      uchar 4096
global g_om2      uchar 4096
global g_sha      uchar 4096
global g_work     uchar 4096
global g_plen     ulong 8

global g_pa       uchar 4096
global g_pb       uchar 4096
global g_pc       uchar 4096
global g_pd       uchar 4096
global g_tmp      uchar 4096
global g_blen     ulong 8

global g_av       uchar 16384
global g_ap       ulong 2
global g_st       uchar 8

global g_buf1     uchar 2097152
global g_buf2     uchar 2097152
global g_obuf     uchar 128
global g_ch       uchar 2

note ---- Output Helpers ----
fn gw_ch c uchar to void
  put g_ch 0 c
  z = write 1 g_ch 0 1
end

fn gw_str s view uchar * to void
  p = ulong 0
  n = len s
  while lt p n bound 4096
    c = sub n p
    if gt c 128
      c = 128
    end
    for i ulong c bound 129
      put g_obuf i get s add p i
    end
    z = write 1 g_obuf 0 c
    p = add p c
  end
end

fn gw_u64 v ulong to void
  if eq v 0
    gw_ch 48
    ret
  end
  x = v
  k = ulong 0
  while gt x 0 bound 32
    d = rem x 10
    put g_obuf k uchar add d 48
    x = div x 10
    k = add k 1
  end
  while gt k 0 bound 32
    k = sub k 1
    gw_ch get g_obuf k
  end
end

fn g_die step ulong to void
  gw_str g_p_fail
  gw_u64 step
  gw_ch 10
  exit int step
end

note ---- Path Global Slots (0=omc, 1=ng, 2=ngc, 3=src, 4=om2, 5=sha, 6=work) ----
fn g_set_lit_p pslot ulong s view uchar * to void
  n = len s
  for i ulong n bound 4096
    b = get s i
    if eq pslot 0
      put g_omc i b
    end
    if eq pslot 1
      put g_ng i b
    end
    if eq pslot 2
      put g_ngc i b
    end
    if eq pslot 3
      put g_src i b
    end
    if eq pslot 4
      put g_om2 i b
    end
    if eq pslot 5
      put g_sha i b
    end
    if eq pslot 6
      put g_work i b
    end
  end
  put g_plen pslot n
end

fn g_get_pbyte pslot ulong idx ulong to uchar
  if eq pslot 0
    ret get g_omc idx
  end
  if eq pslot 1
    ret get g_ng idx
  end
  if eq pslot 2
    ret get g_ngc idx
  end
  if eq pslot 3
    ret get g_src idx
  end
  if eq pslot 4
    ret get g_om2 idx
  end
  if eq pslot 5
    ret get g_sha idx
  end
  ret get g_work idx
end

fn g_get_bbyte bslot ulong idx ulong to uchar
  if eq bslot 0
    ret get g_pa idx
  end
  if eq bslot 1
    ret get g_pb idx
  end
  if eq bslot 2
    ret get g_pc idx
  end
  ret get g_pd idx
end

fn g_put_bbyte bslot ulong idx ulong b uchar to void
  if eq bslot 0
    put g_pa idx b
  end
  if eq bslot 1
    put g_pb idx b
  end
  if eq bslot 2
    put g_pc idx b
  end
  if eq bslot 3
    put g_pd idx b
  end
end

fn g_build_join bslot ulong pslot ulong suf view uchar * to void
  pn = get g_plen pslot
  sn = len suf
  for i ulong pn bound 4096
    g_put_bbyte bslot i g_get_pbyte pslot i
  end
  for i ulong sn bound 4096
    g_put_bbyte bslot add pn i get suf i
  end
  put g_blen bslot add pn sn
end

fn g_tmp_eq kw view uchar * to bool
  n = get g_blen 4
  if ne n len kw
    ret false
  end
  for i ulong n bound 4096
    if ne get g_tmp i get kw i
      ret false
    end
  end
  ret true
end

fn g_rd_arg_p idx ulong pslot ulong to void
  n = long -1
  if eq pslot 0
    n = argread idx g_omc 0 4095
  end
  if eq pslot 1
    n = argread idx g_ng 0 4095
  end
  if eq pslot 2
    n = argread idx g_ngc 0 4095
  end
  if eq pslot 3
    n = argread idx g_src 0 4095
  end
  if eq pslot 4
    n = argread idx g_om2 0 4095
  end
  if eq pslot 5
    n = argread idx g_sha 0 4095
  end
  if eq pslot 6
    n = argread idx g_work 0 4095
  end
  if lt n 1
    g_die 91
  end
  put g_plen pslot ulong n
end

fn g_parse_cli to void
  g_set_lit_p 0 g_def_omc
  g_set_lit_p 1 g_def_ng
  g_set_lit_p 2 g_def_ngc
  g_set_lit_p 3 g_def_src
  g_set_lit_p 4 g_def_om2
  g_set_lit_p 5 g_def_sha
  g_set_lit_p 6 g_def_work
  ac = ulong argcnt
  i = ulong 1
  while lt i ac bound 32
    k = argread i g_tmp 0 4095
    if lt k 1
      g_die 91
    end
    put g_blen 4 ulong k
    if ge add i 1 ac
      g_die 91
    end
    if g_tmp_eq g_f_omc
      i = add i 1
      g_rd_arg_p i 0
    end
    if g_tmp_eq g_f_ng
      i = add i 1
      g_rd_arg_p i 1
    end
    if g_tmp_eq g_f_ngc
      i = add i 1
      g_rd_arg_p i 2
    end
    if g_tmp_eq g_f_src
      i = add i 1
      g_rd_arg_p i 3
    end
    if g_tmp_eq g_f_om2
      i = add i 1
      g_rd_arg_p i 4
    end
    if g_tmp_eq g_f_sha
      i = add i 1
      g_rd_arg_p i 5
    end
    if g_tmp_eq g_f_work
      i = add i 1
      g_rd_arg_p i 6
    end
    i = add i 1
  end
end

note ---- Subprocess Exec Helper ----
fn g_av_reset to void
  put g_ap 0 2
  put g_ap 1 0
end

fn g_av_push_lit s view uchar * to void
  n = len s
  p = get g_ap 0
  put g_av p uchar and n 255
  put g_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put g_av add p i get s i
  end
  put g_ap 0 add p n
  put g_ap 1 add get g_ap 1 1
end

fn g_av_push_p pslot ulong to void
  n = get g_plen pslot
  p = get g_ap 0
  put g_av p uchar and n 255
  put g_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put g_av add p i g_get_pbyte pslot i
  end
  put g_ap 0 add p n
  put g_ap 1 add get g_ap 1 1
end

fn g_av_push_b bslot ulong to void
  n = get g_blen bslot
  p = get g_ap 0
  put g_av p uchar and n 255
  put g_av add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    put g_av add p i g_get_bbyte bslot i
  end
  put g_ap 0 add p n
  put g_ap 1 add get g_ap 1 1
end

fn g_av_push_w suf view uchar * to void
  g_build_join 3 6 suf
  g_av_push_b 3
end

fn g_open_in bslot ulong to int
  fd = long -1
  ln = get g_blen bslot
  if eq bslot 0
    fd = fopen g_pa 0 ln 0 0
  end
  if eq bslot 1
    fd = fopen g_pb 0 ln 0 0
  end
  if eq bslot 2
    fd = fopen g_pc 0 ln 0 0
  end
  if lt fd 0
    exit 126
  end
  ret int fd
end

fn g_open_out bslot ulong to int
  fd = long -1
  ln = get g_blen bslot
  if eq bslot 0
    fd = fopen g_pa 0 ln 577 493
  end
  if eq bslot 1
    fd = fopen g_pb 0 ln 577 493
  end
  if eq bslot 2
    fd = fopen g_pc 0 ln 577 493
  end
  if lt fd 0
    exit 125
  end
  ret int fd
end

fn g_exec use_in bool in_s ulong use_out bool out_s ulong to ulong
  cnt = get g_ap 1
  put g_av 0 uchar and cnt 255
  put g_av 1 uchar and shr cnt 8 255
  pid = fork
  if lt pid 0
    g_die 92
  end
  if eq pid 0
    if use_in
      z = dupfd g_open_in in_s 0 0
    else
      dn = fopen g_devnull 0 len g_devnull 0 0
      if ge dn 0
        z = dupfd int dn 0 0
      end
    end
    if use_out
      z = dupfd g_open_out out_s 1 0
    else
      dn2 = fopen g_devnull 0 len g_devnull 2 0
      if ge dn2 0
        z = dupfd int dn2 1 0
      end
    end
    dn3 = fopen g_devnull 0 len g_devnull 2 0
    if ge dn3 0
      z = dupfd int dn3 2 0
    end
    z = execprog g_av 0 get g_ap 0
    exit 127
  end
  w = waitpid int pid g_st 0 4 0
  if lt w 0
    ret 255
  end
  b0 = ulong get g_st 0
  b1 = ulong get g_st 1
  sig = and b0 127
  if ne sig 0
    ret add 128 sig
  end
  ret b1
end

note ---- File I/O, Prefix, Compare, Mutate, Static ELF Check ----
fn g_slurp bslot ulong which ulong to ulong
  fd = long -1
  ln = get g_blen bslot
  if eq bslot 0
    fd = fopen g_pa 0 ln 0 0
  end
  if eq bslot 1
    fd = fopen g_pb 0 ln 0 0
  end
  if eq bslot 2
    fd = fopen g_pc 0 ln 0 0
  end
  if lt fd 0
    g_die 93
  end
  ifd = int fd
  tot = ulong 0
  go = true
  while go bound 20000
    remb = sub 2097152 tot
    if eq remb 0
      z = fclose ifd
      g_die 93
    end
    n = long -1
    if eq which 1
      n = read ifd g_buf1 tot remb
    else
      n = read ifd g_buf2 tot remb
    end
    if lt n 0
      z = fclose ifd
      g_die 93
    end
    if eq n 0
      go = false
    else
      tot = add tot ulong n
    end
  end
  z = fclose ifd
  ret tot
end

fn g_write_buf1 bslot ulong tot ulong to void
  fd = g_open_out bslot
  ofs = ulong 0
  while lt ofs tot bound 20000
    n = write fd g_buf1 ofs sub tot ofs
    if le n 0
      z = fclose fd
      g_die 94
    end
    ofs = add ofs ulong n
  end
  z = fclose fd
end

fn g_cmp_files a_slot ulong b_slot ulong to bool
  na = g_slurp a_slot 1
  nb = g_slurp b_slot 2
  if ne na nb
    ret false
  end
  for i ulong na bound 2097153
    if ne get g_buf1 i get g_buf2 i
      ret false
    end
  end
  ret true
end

fn g_copy_mut src_slot ulong dst_slot ulong op ulong off ulong to void
  tot = g_slurp src_slot 1
  if eq op 1
    if ge off tot
      g_die 95
    end
    put g_buf1 off xor get g_buf1 off 1
  end
  if eq op 2
    if gt off tot
      g_die 95
    end
    tot = off
  end
  g_write_buf1 dst_slot tot
end

fn g_append_slurp_to_buf1 pslot ulong off ulong to ulong
  fd = long -1
  ln = get g_plen pslot
  if eq pslot 4
    fd = fopen g_om2 0 ln 0 0
  end
  if eq pslot 5
    fd = fopen g_sha 0 ln 0 0
  end
  if lt fd 0
    g_die 96
  end
  ifd = int fd
  tot = off
  go = true
  while go bound 20000
    n = read ifd g_buf1 tot sub 2097152 tot
    if le n 0
      go = false
    else
      tot = add tot ulong n
    end
  end
  z = fclose ifd
  ret tot
end

fn g_cat_engine bslot_src ulong out_slot ulong to void
  tot = g_append_slurp_to_buf1 4 0
  tot = g_append_slurp_to_buf1 5 tot
  nb = g_slurp bslot_src 2
  for i ulong nb bound 2097153
    put g_buf1 add tot i get g_buf2 i
  end
  g_write_buf1 out_slot add tot nb
end

fn g_write_ng_in dir view uchar * ir_slot ulong out_slot ulong to void
  dn = len dir
  for i ulong dn bound 64
    put g_buf1 i get dir i
  end
  nb = g_slurp ir_slot 2
  for i ulong nb bound 2097153
    put g_buf1 add dn i get g_buf2 i
  end
  g_write_buf1 out_slot add dn nb
end

fn g_buf1_u16 p ulong to ulong
  ret or ulong get g_buf1 p shl ulong get g_buf1 add p 1 8
end

fn g_buf1_u32 p ulong to ulong
  b0 = ulong get g_buf1 p
  b1 = shl ulong get g_buf1 add p 1 8
  b2 = shl ulong get g_buf1 add p 2 16
  b3 = shl ulong get g_buf1 add p 3 24
  ret or or b0 b1 or b2 b3
end

fn g_buf1_u64 p ulong to ulong
  ret or g_buf1_u32 p shl g_buf1_u32 add p 4 32
end

fn g_check_static_elf bslot ulong to bool
  n = g_slurp bslot 1
  if lt n 64
    ret false
  end
  if or ne get g_buf1 0 127 ne get g_buf1 1 69
    ret false
  end
  if or ne get g_buf1 2 76 ne get g_buf1 3 70
    ret false
  end
  if ne get g_buf1 4 2
    ret false
  end
  phoff = g_buf1_u64 32
  phent = g_buf1_u16 54
  phnum = g_buf1_u16 56
  if lt phent 56
    ret false
  end
  for i ulong phnum bound 64
    ph = add phoff mul i phent
    if gt add ph 4 n
      ret false
    end
    if eq g_buf1_u32 ph 2
      ret false
    end
  end
  ret true
end

fn g_buf1_has n ulong pat view uchar * to bool
  pn = len pat
  if gt pn n
    ret false
  end
  lim = add sub n pn 1
  for i ulong lim bound 65537
    ok = true
    for j ulong pn bound 128
      if ne get g_buf1 add i j get pat j
        ok = false
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn g_buf1_val_gt0 n ulong pat view uchar * to bool
  pn = len pat
  if gt pn n
    ret false
  end
  lim = add sub n pn 1
  for i ulong lim bound 65537
    ok = true
    for j ulong pn bound 128
      if ne get g_buf1 add i j get pat j
        ok = false
      end
    end
    if ok
      v = ulong 0
      p = add i pn
      while lt p n bound 65537
        c = ulong get g_buf1 p
        if or lt c 48 gt c 57
          ret gt v 0
        end
        v = add mul v 10 sub c 48
        p = add p 1
      end
      ret gt v 0
    end
  end
  ret false
end

note ---- Gate Stages ----
fn g_run_omc in_slot ulong out_slot ulong step ulong to void
  g_av_reset
  g_av_push_p 0
  if ne g_exec true in_slot true out_slot 0
    g_die step
  end
end

fn g_stage_emit to void
  g_build_join 0 3 g_suf_eom
  g_build_join 1 6 g_suf_ebin1
  g_run_omc 0 1 11
  g_build_join 2 6 g_suf_ebin2
  g_run_omc 0 2 12
  if not g_cmp_files 1 2
    g_die 13
  end
  gw_str g_p_g1
end

fn g_stage_ng_worker to void
  g_build_join 0 6 g_suf_ebin1
  g_build_join 1 6 g_suf_ir
  g_av_reset
  g_av_push_b 0
  if ne g_exec false 0 true 1 0
    g_die 21
  end
  g_av_reset
  g_av_push_p 2
  g_build_join 2 6 g_suf_ngc1
  if ne g_exec true 1 true 2 0
    g_die 22
  end
  n1 = g_slurp 2 1
  if not g_buf1_has n1 g_k_acc
    g_die 23
  end
  g_build_join 2 6 g_suf_optin
  g_write_ng_in g_dr_cnt 1 2
  g_av_reset
  g_av_push_p 1
  g_build_join 0 6 g_suf_optcnt
  if ne g_exec true 2 true 0 0
    g_die 24
  end
  no = g_slurp 0 1
  if not g_buf1_val_gt0 no g_k_bce
    g_die 25
  end
  if not g_buf1_val_gt0 no g_k_rot
    g_die 26
  end
  g_write_ng_in g_dr_opt 1 2
  g_build_join 0 6 g_suf_optir
  g_av_reset
  g_av_push_p 1
  if ne g_exec true 2 true 0 0
    g_die 27
  end
  g_av_reset
  g_av_push_p 2
  g_build_join 1 6 g_suf_ngc2
  if ne g_exec true 0 true 1 0
    g_die 28
  end
  n2 = g_slurp 1 1
  if not g_buf1_has n2 g_k_acc
    g_die 29
  end
  g_build_join 2 6 g_suf_a64in
  g_write_ng_in g_dr_a64 0 2
  g_build_join 0 6 g_suf_wbin1
  g_build_join 1 6 g_suf_wbin2
  g_av_reset
  g_av_push_p 1
  if ne g_exec true 2 true 0 0
    g_die 30
  end
  g_av_reset
  g_av_push_p 1
  if ne g_exec true 2 true 1 0
    g_die 31
  end
  if not g_cmp_files 0 1
    g_die 32
  end
  if not g_check_static_elf 0
    g_die 33
  end
  gw_str g_p_g2
end

fn g_stage_engine_build to void
  g_build_join 0 3 g_suf_com
  g_build_join 1 6 g_suf_csrc
  g_cat_engine 0 1
  g_build_join 0 6 g_suf_eng1
  g_run_omc 1 0 34
  g_build_join 2 6 g_suf_eng2
  g_run_omc 1 2 35
  if not g_cmp_files 0 2
    g_die 36
  end
  gw_str g_p_g3
end

fn g_eng_cmd_start to void
  g_build_join 0 6 g_suf_eng1
  g_av_reset
  g_av_push_b 0
end

fn g_eng_push_wrk to void
  g_av_push_lit g_c_fw
  g_av_push_w g_suf_wbin1
end

fn g_stage_positive to void
  g_eng_cmd_start
  g_av_push_lit g_c_self
  g_eng_push_wrk
  g_build_join 1 6 g_suf_sout
  if ne g_exec false 0 true 1 0
    g_die 41
  end
  gw_str g_p_g4

  g_eng_cmd_start
  g_av_push_lit g_c_bnch
  g_eng_push_wrk
  g_build_join 1 6 g_suf_bout
  if ne g_exec false 0 true 1 0
    g_die 42
  end
  nb = g_slurp 1 1
  if not g_buf1_has nb g_k_diff0
    g_die 43
  end
  gw_str g_p_g5

  g_eng_cmd_start
  g_av_push_lit g_c_init
  g_av_push_w g_suf_t0
  g_av_push_lit g_c_256
  g_av_push_lit g_c_160
  if ne g_exec false 0 false 0 0
    g_die 44
  end

  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_t1
  g_av_push_lit g_c_64
  g_eng_push_wrk
  if ne g_exec false 0 false 0 0
    g_die 45
  end

  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_t1
  if g_cmp_files 0 1
    g_die 46
  end

  g_eng_cmd_start
  g_av_push_lit g_c_ver
  g_av_push_w g_suf_t0
  g_av_push_lit g_c_64
  g_eng_push_wrk
  g_build_join 2 6 g_suf_vout
  if ne g_exec false 0 true 2 0
    g_die 47
  end

  g_eng_cmd_start
  g_av_push_lit g_c_rv
  g_av_push_w g_suf_t1
  g_av_push_w g_suf_t2
  g_av_push_lit g_c_64
  g_eng_push_wrk
  if ne g_exec false 0 false 0 0
    g_die 48
  end
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_t2
  if not g_cmp_files 0 1
    g_die 49
  end

  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_t128
  g_av_push_lit g_c_128
  g_eng_push_wrk
  if ne g_exec false 0 false 0 0
    g_die 50
  end
  g_eng_cmd_start
  g_av_push_lit g_c_rv
  g_av_push_w g_suf_t128
  g_av_push_w g_suf_t0b
  g_av_push_lit g_c_128
  g_eng_push_wrk
  if ne g_exec false 0 false 0 0
    g_die 51
  end
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_t0b
  if not g_cmp_files 0 1
    g_die 52
  end

  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_t1s
  g_av_push_lit g_c_64
  g_av_push_lit g_c_fsc
  if ne g_exec false 0 false 0 0
    g_die 53
  end
  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_t1w
  g_av_push_lit g_c_64
  g_av_push_lit g_c_ft
  g_av_push_lit g_c_1
  g_eng_push_wrk
  if ne g_exec false 0 false 0 0
    g_die 54
  end
  g_build_join 0 6 g_suf_t1
  g_build_join 1 6 g_suf_t1s
  if not g_cmp_files 0 1
    g_die 55
  end
  g_build_join 1 6 g_suf_t1w
  if not g_cmp_files 0 1
    g_die 56
  end
  gw_str g_p_g6
end

fn g_stage_negative_1 to void
  note [N1] rule corruption -> exit 61
  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_out
  g_av_push_lit g_c_64
  g_av_push_lit g_c_ffr
  g_eng_push_wrk
  if ne g_exec false 0 false 0 61
    g_die 71
  end
  gw_str g_p_n1

  note [N2] popcount-preserving reversibility break -> exit 62
  g_eng_cmd_start
  g_av_push_lit g_c_ver
  g_av_push_w g_suf_t0
  g_av_push_lit g_c_64
  g_av_push_lit g_c_ffv
  g_eng_push_wrk
  if ne g_exec false 0 false 0 62
    g_die 72
  end
  gw_str g_p_n2

  note [N3] odd width 255 & odd height 159 -> exit 63
  g_eng_cmd_start
  g_av_push_lit g_c_init
  g_av_push_w g_suf_out
  g_av_push_lit g_c_255
  g_av_push_lit g_c_160
  if ne g_exec false 0 false 0 63
    g_die 73
  end
  g_eng_cmd_start
  g_av_push_lit g_c_init
  g_av_push_w g_suf_out
  g_av_push_lit g_c_256
  g_av_push_lit g_c_159
  if ne g_exec false 0 false 0 63
    g_die 74
  end
  gw_str g_p_n3

  note [N4] tampered state_sha256 -> exit 64
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_badsha
  g_copy_mut 0 1 1 40
  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_badsha
  g_av_push_w g_suf_out
  g_av_push_lit g_c_64
  g_eng_push_wrk
  if ne g_exec false 0 false 0 64
    g_die 75
  end
  gw_str g_p_n4

  note [N5] non-conserved popcount delta -> exit 65
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_badpop
  g_copy_mut 0 1 1 24
  g_eng_cmd_start
  g_av_push_lit g_c_insp
  g_av_push_w g_suf_badpop
  if ne g_exec false 0 false 0 65
    g_die 76
  end
  gw_str g_p_n5
end

fn g_stage_negative_2 to void
  note [N6] bad magic -> exit 66
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_badmag
  g_copy_mut 0 1 1 0
  g_eng_cmd_start
  g_av_push_lit g_c_insp
  g_av_push_w g_suf_badmag
  if ne g_exec false 0 false 0 66
    g_die 77
  end
  gw_str g_p_n6

  note [N7] truncated header & truncated payload -> exit 67
  g_build_join 0 6 g_suf_t0
  g_build_join 1 6 g_suf_tr64
  g_copy_mut 0 1 2 64
  g_eng_cmd_start
  g_av_push_lit g_c_insp
  g_av_push_w g_suf_tr64
  if ne g_exec false 0 false 0 67
    g_die 78
  end
  g_build_join 0 6 g_suf_t0
  tlen = g_slurp 0 1
  g_build_join 1 6 g_suf_trpay
  g_copy_mut 0 1 2 sub tlen 1
  g_eng_cmd_start
  g_av_push_lit g_c_insp
  g_av_push_w g_suf_trpay
  if ne g_exec false 0 false 0 67
    g_die 79
  end
  gw_str g_p_n7

  note [N8] worker non-zero fault exit (49) caught by coordinator -> exit 68
  g_eng_cmd_start
  g_av_push_lit g_c_ev
  g_av_push_w g_suf_t0
  g_av_push_w g_suf_out
  g_av_push_lit g_c_64
  g_av_push_lit g_c_ffw
  g_eng_push_wrk
  if ne g_exec false 0 false 0 68
    g_die 80
  end
  gw_str g_p_n8

  note [N9] reverse underflow (65 > step 64) -> exit 69
  g_eng_cmd_start
  g_av_push_lit g_c_rv
  g_av_push_w g_suf_t1
  g_av_push_w g_suf_out
  g_av_push_lit g_c_65
  g_eng_push_wrk
  if ne g_exec false 0 false 0 69
    g_die 81
  end
  gw_str g_p_n9
end

fn main to int
  g_parse_cli
  gw_str g_p_hdr
  g_stage_emit
  g_stage_ng_worker
  g_stage_engine_build
  g_stage_positive
  g_stage_negative_1
  g_stage_negative_2
  gw_str g_p_done
  ret 0
end

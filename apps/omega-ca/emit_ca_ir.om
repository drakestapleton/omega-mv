om2
note SPDX-License-Identifier: Apache-2.0
note apps/omega-ca/emit_ca_ir.om
note Self-contained pure seeded OM-2 generator emitting binary OIR (OSC1IR v9, omega.ng.ir.v1)
note for the 2-pass Margolus BBM SWAR static worker (`ca_worker`).
note Compile: seed/out/omc < apps/omega-ca/emit_ca_ir.om > emit_ca_ir && chmod +x emit_ca_ir
note Pipeline: ./emit_ca_ir > ca_worker.ir -> ngcheck -> @ng opt-count -> @ng opt -> ngcheck -> @ng a64 -> ca_worker

const T_VOID ulong 0
const T_BOOL ulong 1
const T_U8   ulong 2
const T_U64  ulong 5
const T_I32  ulong 8
const T_I64  ulong 9
const T_TOK  ulong 20

const T_A64_U8    ulong 32
const T_R_HDR     ulong 33
const T_A512K_U8  ulong 34
const T_R_IO      ulong 35
const T_A64K_U64  ulong 36
const T_R_GRID    ulong 37

const G_HDR ulong 0
const G_IO  ulong 1
const G_A   ulong 2
const G_B   ulong 3

const OP_CONST  ulong 1
const OP_SELECT ulong 2
const OP_ADD    ulong 10
const OP_SUB    ulong 11
const OP_MUL    ulong 12
const OP_AND    ulong 16
const OP_OR     ulong 17
const OP_XOR    ulong 18
const OP_NOT    ulong 19
const OP_SHL    ulong 20
const OP_SHR    ulong 21
const OP_EQ     ulong 30
const OP_NE     ulong 31
const OP_LT     ulong 32
const OP_LE     ulong 33
const OP_GT     ulong 34
const OP_GE     ulong 35
const OP_CONV   ulong 36
const OP_LOAD   ulong 42
const OP_STORE  ulong 43
const OP_GADDR  ulong 52
const OP_BR     ulong 60
const OP_CBR    ulong 61
const OP_RET    ulong 62
const OP_RETV   ulong 63
const OP_CALL   ulong 64
const OP_TRAP   ulong 65
const OP_EXIT   ulong 66
const OP_CHKB   ulong 79
const OP_CHKS   ulong 80
const OP_HOST   ulong 110

const CAW_MAGIC ulong 1128355633
const EVEN_MASK ulong 6148914691236517205
const I64_NEG1  ulong 18446744073709551615

global irb uchar 262144
global irp ulong 1
global ir_fnpos ulong 1
global ir_nb ulong 1
global ir_bkpos ulong 1
global ir_no ulong 1
global ir_nv ulong 1
global ir_tk ulong 1
global ir_vs ulong 32
global ir_r ulong 128

text t_magic "OSC1IR"
text t_tag   "omega.ng.ir.v1"

fn w8 v ulong to void
  p = get irp 0
  if ge p 262144
    trap 3
  end
  put irb p uchar and v 255
  put irp 0 add p 1
end

fn w32 v ulong to void
  w8 and v 255
  w8 and shr v 8 255
  w8 and shr v 16 255
  w8 and shr v 24 255
end

fn w64 v ulong to void
  w32 and v 4294967295
  w32 shr v 32
end

fn p32 pos ulong v ulong to void
  put irb pos uchar and v 255
  put irb add pos 1 uchar and shr v 8 255
  put irb add pos 2 uchar and shr v 16 255
  put irb add pos 3 uchar and shr v 24 255
end

fn wtxt s view uchar * n ulong to void
  for i ulong len s bound 64
    w8 ulong get s i
  end
  z = len s
  while lt z n bound 64
    w8 0
    z = add z 1
  end
end

fn ir_mod_hdr to void
  wtxt t_magic 7
  w8 9
  wtxt t_tag 16
end

fn ir_types_globs to void
  w32 6
  w8 2
  w32 T_U8
  w32 64
  w8 4
  w32 T_A64_U8
  w8 1
  w8 0
  w8 2
  w32 T_U8
  w32 524288
  w8 4
  w32 T_A512K_U8
  w8 1
  w8 0
  w8 2
  w32 T_U64
  w32 65536
  w8 4
  w32 T_A64K_U64
  w8 1
  w8 0
  w32 4
  w32 T_A64_U8
  w8 0
  w32 T_A512K_U8
  w8 0
  w32 T_A64K_U64
  w8 0
  w32 T_A64K_U64
  w8 0
  w32 10
end

fn fn_start kind ulong np ulong res ulong to void
  w8 kind
  w8 0
  w32 np
  for i ulong np bound 8
    w32 get ir_vs i
  end
  w32 res
  put ir_fnpos 0 get irp 0
  w32 0
  put ir_nb 0 0
  put ir_nv 0 add 1 np
  put ir_tk 0 0
end

fn fn_end to void
  p32 get ir_fnpos 0 get ir_nb 0
end

fn blk_start npar ulong to void
  w32 npar
  for i ulong npar bound 16
    w32 get ir_vs i
  end
  put ir_bkpos 0 get irp 0
  w32 0
  put ir_no 0 0
  put ir_nb 0 add get ir_nb 0 1
  if gt npar 0
    put ir_tk 0 get ir_nv 0
    put ir_nv 0 add get ir_nv 0 npar
  else
    put ir_tk 0 0
  end
end

fn blk0 to void
  blk_start 0
end

fn blk1 to void
  put ir_vs 0 T_TOK
  blk_start 1
end

fn blk2 t1 ulong to void
  put ir_vs 0 T_TOK
  put ir_vs 1 t1
  blk_start 2
end

fn blk3 t1 ulong t2 ulong to void
  put ir_vs 0 T_TOK
  put ir_vs 1 t1
  put ir_vs 2 t2
  blk_start 3
end

fn blk4 t1 ulong t2 ulong t3 ulong to void
  put ir_vs 0 T_TOK
  put ir_vs 1 t1
  put ir_vs 2 t2
  put ir_vs 3 t3
  blk_start 4
end

fn blk_end to void
  p32 get ir_bkpos 0 get ir_no 0
end

fn nextv ty ulong to ulong
  v = get ir_nv 0
  if ne ty 0
    put ir_nv 0 add v 1
  end
  ret v
end

fn incop to void
  put ir_no 0 add get ir_no 0 1
end

fn e_const ty ulong v ulong to ulong
  incop
  w8 OP_CONST
  w32 ty
  w64 v
  ret nextv ty
end

fn e_gaddr ty ulong gid ulong to ulong
  incop
  w8 OP_GADDR
  w32 ty
  w64 gid
  ret nextv ty
end

fn e_un op ulong ty ulong a ulong to ulong
  incop
  w8 op
  w32 ty
  w32 a
  ret nextv ty
end

fn e_bin op ulong ty ulong a ulong b ulong to ulong
  incop
  w8 op
  w32 ty
  w32 a
  w32 b
  ret nextv ty
end

fn e_sel ty ulong c ulong a ulong b ulong to ulong
  incop
  w8 OP_SELECT
  w32 ty
  w32 c
  w32 a
  w32 b
  ret nextv ty
end

fn e_conv ty ulong a ulong to ulong
  incop
  w8 OP_CONV
  w32 ty
  w64 0
  w32 a
  ret nextv ty
end

fn e_chkb r ulong idx ulong e ulong to void
  incop
  w8 OP_CHKB
  w32 0
  w64 3
  w32 get ir_tk 0
  w32 r
  w32 idx
  w32 e
  put ir_tk 0 nextv 1
end

fn e_chks r ulong ofs ulong n ulong to void
  incop
  w8 OP_CHKS
  w32 0
  w64 3
  w32 get ir_tk 0
  w32 r
  w32 ofs
  w32 n
  put ir_tk 0 nextv 1
end

fn e_load ty ulong r ulong idx ulong to ulong
  incop
  w8 OP_LOAD
  w32 ty
  w32 get ir_tk 0
  w32 r
  w32 idx
  ret nextv ty
end

fn e_store r ulong idx ulong val ulong to void
  incop
  w8 OP_STORE
  w32 0
  w32 get ir_tk 0
  w32 r
  w32 idx
  w32 val
  put ir_tk 0 nextv 1
end

fn e_cbr c ulong bt ulong bf ulong to void
  incop
  w8 OP_CBR
  w32 0
  w32 get ir_tk 0
  w32 c
  w32 bt
  w32 bf
end

fn e_br tblk ulong np ulong to void
  incop
  w8 OP_BR
  w32 0
  w32 np
  w32 tblk
  w32 get ir_tk 0
  for i ulong np bound 16
    if gt i 0
      w32 get ir_vs sub i 1
    end
  end
end

fn e_br1 tblk ulong to void
  e_br tblk 1
end

fn e_br2 tblk ulong v1 ulong to void
  put ir_vs 0 v1
  e_br tblk 2
end

fn e_br3 tblk ulong v1 ulong v2 ulong to void
  put ir_vs 0 v1
  put ir_vs 1 v2
  e_br tblk 3
end

fn e_br4 tblk ulong v1 ulong v2 ulong v3 ulong to void
  put ir_vs 0 v1
  put ir_vs 1 v2
  put ir_vs 2 v3
  e_br tblk 4
end

fn e_ret to void
  incop
  w8 OP_RET
  w32 0
  w32 get ir_tk 0
end

fn e_retv v ulong to void
  incop
  w8 OP_RETV
  w32 0
  w32 get ir_tk 0
  w32 v
end

fn e_exit v ulong to void
  incop
  w8 OP_EXIT
  w32 0
  w32 get ir_tk 0
  w32 v
end

fn e_trap code ulong to void
  incop
  w8 OP_TRAP
  w32 0
  w64 code
  w32 get ir_tk 0
end

fn e_host4 wid ulong fd ulong r ulong ofs ulong n ulong to ulong
  incop
  w8 OP_HOST
  w32 T_I64
  w64 wid
  w32 4
  w32 get ir_tk 0
  w32 fd
  w32 r
  w32 ofs
  w32 n
  nt = nextv 1
  rv = nextv 1
  put ir_tk 0 nt
  ret rv
end

fn e_call0 fid ulong rty ulong to ulong
  incop
  w8 OP_CALL
  w32 rty
  w32 0
  w32 get ir_tk 0
  w32 fid
  nt = nextv 1
  put ir_tk 0 nt
  if ne rty 0
    ret nextv 1
  end
  ret 0
end

fn e_call1 fid ulong rty ulong a0 ulong to ulong
  incop
  w8 OP_CALL
  w32 rty
  w32 1
  w32 get ir_tk 0
  w32 fid
  w32 a0
  nt = nextv 1
  put ir_tk 0 nt
  if ne rty 0
    ret nextv 1
  end
  ret 0
end

fn e_call2 fid ulong rty ulong a0 ulong a1 ulong to ulong
  incop
  w8 OP_CALL
  w32 rty
  w32 2
  w32 get ir_tk 0
  w32 fid
  w32 a0
  w32 a1
  nt = nextv 1
  put ir_tk 0 nt
  if ne rty 0
    ret nextv 1
  end
  ret 0
end

fn e_call3 fid ulong rty ulong a0 ulong a1 ulong a2 ulong to ulong
  incop
  w8 OP_CALL
  w32 rty
  w32 3
  w32 get ir_tk 0
  w32 fid
  w32 a0
  w32 a1
  w32 a2
  nt = nextv 1
  put ir_tk 0 nt
  if ne rty 0
    ret nextv 1
  end
  ret 0
end

note @f0 read_exact_hdr() -> i64: 0=clean EOF at byte 0, 1=full 64B, -1=err
fn emit_f0 to void
  fn_start 0 0 T_I64
  note b0
  blk0
  put ir_r 0 e_gaddr T_R_HDR G_HDR
  put ir_r 1 e_const T_U64 0
  put ir_r 2 e_const T_U64 64
  put ir_r 3 e_const T_I32 0
  put ir_r 4 e_const T_I64 0
  e_br2 1 get ir_r 1
  blk_end
  note b1(tok, got)
  blk2 T_U64
  got = sub get ir_nv 0 1
  put ir_r 5 got
  e_cbr e_bin OP_LT T_BOOL got get ir_r 2 2 6
  blk_end
  note b2
  blk1
  rm = e_bin OP_SUB T_U64 get ir_r 2 get ir_r 5
  e_chks get ir_r 0 get ir_r 5 rm
  n = e_host4 53 get ir_r 3 get ir_r 0 get ir_r 5 rm
  put ir_r 6 n
  e_cbr e_bin OP_EQ T_BOOL n get ir_r 4 3 4
  blk_end
  note b3 (n == 0 EOF)
  blk1
  e_cbr e_bin OP_EQ T_BOOL get ir_r 5 get ir_r 1 7 8
  blk_end
  note b4 (n != 0)
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 6 get ir_r 4 8 5
  blk_end
  note b5 (n > 0)
  blk1
  nu = e_conv T_U64 get ir_r 6
  e_br2 1 e_bin OP_ADD T_U64 get ir_r 5 nu
  blk_end
  note b6 (64B read ok)
  blk1
  e_retv e_const T_I64 1
  blk_end
  note b7 (clean EOF)
  blk1
  e_retv e_const T_I64 0
  blk_end
  note b8 (err/short)
  blk1
  e_retv e_const T_I64 I64_NEG1
  blk_end
  fn_end
end

note @f1/@f2 read_exact_io / write_exact_io (total:u64) -> i64
fn emit_io_exact wid ulong fdnum ulong to void
  put ir_vs 0 T_U64
  fn_start 0 1 T_I64
  note b0
  blk0
  put ir_r 0 e_gaddr T_R_IO G_IO
  put ir_r 1 e_const T_U64 0
  put ir_r 2 e_const T_U64 524289
  put ir_r 3 e_const T_I32 fdnum
  put ir_r 4 e_const T_I64 0
  e_cbr e_bin OP_LT T_BOOL 1 get ir_r 2 1 6
  blk_end
  note b1
  blk1
  e_br2 2 get ir_r 1
  blk_end
  note b2(tok, got)
  blk2 T_U64
  got = sub get ir_nv 0 1
  put ir_r 5 got
  e_cbr e_bin OP_LT T_BOOL got 1 3 5
  blk_end
  note b3
  blk1
  rm = e_bin OP_SUB T_U64 1 get ir_r 5
  e_chks get ir_r 0 get ir_r 5 rm
  n = e_host4 wid get ir_r 3 get ir_r 0 get ir_r 5 rm
  put ir_r 6 n
  e_cbr e_bin OP_LE T_BOOL n get ir_r 4 6 4
  blk_end
  note b4
  blk1
  nu = e_conv T_U64 get ir_r 6
  e_br2 2 e_bin OP_ADD T_U64 get ir_r 5 nu
  blk_end
  note b5 (ok)
  blk1
  e_retv e_const T_I64 0
  blk_end
  note b6 (err)
  blk1
  e_retv e_const T_I64 I64_NEG1
  blk_end
  fn_end
end

note @f3 hdr_u64(w:u64) -> u64
fn emit_f3 to void
  put ir_vs 0 T_U64
  fn_start 0 1 T_U64
  note b0
  blk0
  put ir_r 0 e_gaddr T_R_HDR G_HDR
  put ir_r 1 e_const T_U64 0
  put ir_r 2 e_const T_U64 1
  put ir_r 3 e_const T_U64 8
  put ir_r 4 e_const T_U64 64
  put ir_r 5 e_bin OP_MUL T_U64 1 get ir_r 3
  e_br3 1 get ir_r 1 get ir_r 1
  blk_end
  note b1(tok, k, acc)
  blk3 T_U64 T_U64
  k = sub get ir_nv 0 2
  acc = sub get ir_nv 0 1
  put ir_r 6 k
  put ir_r 7 acc
  e_cbr e_bin OP_LT T_BOOL k get ir_r 3 2 5
  blk_end
  note b2
  blk1
  idx = e_bin OP_ADD T_U64 get ir_r 5 get ir_r 6
  put ir_r 8 idx
  e_cbr e_bin OP_LT T_BOOL idx get ir_r 4 3 4
  blk_end
  note b3 (BCE deletes chk.bounds!)
  blk1
  e_chkb get ir_r 0 get ir_r 8 get ir_r 2
  bv = e_load T_U8 get ir_r 0 get ir_r 8
  bu = e_conv T_U64 bv
  sh = e_bin OP_MUL T_U64 get ir_r 6 get ir_r 3
  nacc = e_bin OP_OR T_U64 get ir_r 7 e_bin OP_SHL T_U64 bu sh
  nk = e_bin OP_ADD T_U64 get ir_r 6 get ir_r 2
  e_br3 1 nk nacc
  blk_end
  note b4
  blk1
  e_trap 3
  blk_end
  note b5
  blk1
  e_retv get ir_r 7
  blk_end
  fn_end
end

note @f4 unpack_io_to_a(words:u64) -> void
fn emit_f4 to void
  put ir_vs 0 T_U64
  fn_start 0 1 T_VOID
  note b0
  blk0
  put ir_r 0 e_gaddr T_R_IO G_IO
  put ir_r 1 e_gaddr T_R_GRID G_A
  put ir_r 2 e_const T_U64 0
  put ir_r 3 e_const T_U64 1
  put ir_r 4 e_const T_U64 8
  put ir_r 5 e_const T_U64 65536
  put ir_r 6 e_const T_U64 524288
  e_br2 1 get ir_r 2
  blk_end
  note b1(tok, w)
  blk2 T_U64
  w = sub get ir_nv 0 1
  put ir_r 7 w
  e_cbr e_bin OP_LT T_BOOL w 1 2 8
  blk_end
  note b2
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 7 get ir_r 5 3 7
  blk_end
  note b3
  blk1
  put ir_r 8 e_bin OP_MUL T_U64 get ir_r 7 get ir_r 4
  e_br3 4 get ir_r 2 get ir_r 2
  blk_end
  note b4(tok, k, acc)
  blk3 T_U64 T_U64
  k = sub get ir_nv 0 2
  acc = sub get ir_nv 0 1
  put ir_r 9 k
  put ir_r 10 acc
  e_cbr e_bin OP_LT T_BOOL k get ir_r 4 5 6
  blk_end
  note b5
  blk1
  bidx = e_bin OP_ADD T_U64 get ir_r 8 get ir_r 9
  put ir_r 11 bidx
  e_cbr e_bin OP_LT T_BOOL bidx get ir_r 6 9 7
  blk_end
  note b6
  blk1
  e_chkb get ir_r 1 get ir_r 7 get ir_r 3
  e_store get ir_r 1 get ir_r 7 get ir_r 10
  e_br2 1 e_bin OP_ADD T_U64 get ir_r 7 get ir_r 3
  blk_end
  note b7
  blk1
  e_trap 3
  blk_end
  note b8
  blk1
  e_ret
  blk_end
  note b9
  blk1
  e_chkb get ir_r 0 get ir_r 11 get ir_r 3
  bv = e_load T_U8 get ir_r 0 get ir_r 11
  bu = e_conv T_U64 bv
  sh = e_bin OP_MUL T_U64 get ir_r 9 get ir_r 4
  nacc = e_bin OP_OR T_U64 get ir_r 10 e_bin OP_SHL T_U64 bu sh
  nk = e_bin OP_ADD T_U64 get ir_r 9 get ir_r 3
  e_br3 4 nk nacc
  blk_end
  fn_end
end

note @f5/@f6 pack_{a,b}_to_io(start_w:u64, words:u64) -> void
fn emit_pack_fn src_gid ulong to void
  put ir_vs 0 T_U64
  put ir_vs 1 T_U64
  fn_start 0 2 T_VOID
  note b0
  blk0
  put ir_r 0 e_gaddr T_R_GRID src_gid
  put ir_r 1 e_gaddr T_R_IO G_IO
  put ir_r 2 e_const T_U64 0
  put ir_r 3 e_const T_U64 1
  put ir_r 4 e_const T_U64 8
  put ir_r 5 e_const T_U64 65536
  put ir_r 6 e_const T_U64 524288
  put ir_r 7 e_const T_U64 255
  e_br2 1 get ir_r 2
  blk_end
  note b1(tok, w)
  blk2 T_U64
  w = sub get ir_nv 0 1
  put ir_r 8 w
  e_cbr e_bin OP_LT T_BOOL w 2 2 8
  blk_end
  note b2
  blk1
  sidx = e_bin OP_ADD T_U64 1 get ir_r 8
  put ir_r 9 sidx
  e_cbr e_bin OP_LT T_BOOL sidx get ir_r 5 3 7
  blk_end
  note b3
  blk1
  e_chkb get ir_r 0 get ir_r 9 get ir_r 3
  put ir_r 10 e_load T_U64 get ir_r 0 get ir_r 9
  put ir_r 11 e_bin OP_MUL T_U64 get ir_r 8 get ir_r 4
  e_br2 4 get ir_r 2
  blk_end
  note b4(tok, k)
  blk2 T_U64
  k = sub get ir_nv 0 1
  put ir_r 12 k
  e_cbr e_bin OP_LT T_BOOL k get ir_r 4 5 6
  blk_end
  note b5
  blk1
  bidx = e_bin OP_ADD T_U64 get ir_r 11 get ir_r 12
  put ir_r 13 bidx
  e_cbr e_bin OP_LT T_BOOL bidx get ir_r 6 9 7
  blk_end
  note b6
  blk1
  e_br2 1 e_bin OP_ADD T_U64 get ir_r 8 get ir_r 3
  blk_end
  note b7
  blk1
  e_trap 3
  blk_end
  note b8
  blk1
  e_ret
  blk_end
  note b9
  blk1
  e_chkb get ir_r 1 get ir_r 13 get ir_r 3
  sh = e_bin OP_MUL T_U64 get ir_r 12 get ir_r 4
  by = e_conv T_U8 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 get ir_r 10 sh get ir_r 7
  e_store get ir_r 1 get ir_r 13 by
  e_br2 4 e_bin OP_ADD T_U64 get ir_r 12 get ir_r 3
  blk_end
  fn_end
end

note Emit SWAR Margolus BBM logic on (w0, w1) -> stores outputs into ir_r[30]=out0, ir_r[31]=out1
note Uses ir_r 2=c1, 5=ceven from caller; ir_r 40..57 as scratch
fn emit_swar_bbm w0 ulong w1 ulong to void
  c1 = get ir_r 2
  ev = get ir_r 5
  put ir_r 40 e_bin OP_AND T_U64 w0 ev
  put ir_r 41 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 w0 c1 ev
  put ir_r 42 e_bin OP_AND T_U64 w1 ev
  put ir_r 43 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 w1 c1 ev
  put ir_r 44 e_bin OP_AND T_U64 e_un OP_NOT T_U64 get ir_r 40 ev
  put ir_r 45 e_bin OP_AND T_U64 e_un OP_NOT T_U64 get ir_r 41 ev
  put ir_r 46 e_bin OP_AND T_U64 e_un OP_NOT T_U64 get ir_r 42 ev
  put ir_r 47 e_bin OP_AND T_U64 e_un OP_NOT T_U64 get ir_r 43 ev
  put ir_r 48 e_bin OP_XOR T_U64 get ir_r 40 get ir_r 41
  put ir_r 49 e_bin OP_XOR T_U64 get ir_r 42 get ir_r 43
  put ir_r 50 e_bin OP_XOR T_U64 get ir_r 40 get ir_r 43
  put ir_r 51 e_bin OP_XOR T_U64 get ir_r 41 get ir_r 42
  p1l = e_bin OP_AND T_U64 get ir_r 48 e_bin OP_AND T_U64 get ir_r 46 get ir_r 47
  p1r = e_bin OP_AND T_U64 get ir_r 49 e_bin OP_AND T_U64 get ir_r 44 get ir_r 45
  put ir_r 52 e_bin OP_OR T_U64 p1l p1r
  d1 = e_bin OP_AND T_U64 e_un OP_NOT T_U64 get ir_r 50 e_un OP_NOT T_U64 get ir_r 51
  put ir_r 53 e_bin OP_AND T_U64 e_bin OP_AND T_U64 get ir_r 48 d1 ev
  put ir_r 54 e_bin OP_AND T_U64 get ir_r 52 get ir_r 50
  put ir_r 55 e_bin OP_AND T_U64 get ir_r 52 get ir_r 51
  a2 = e_bin OP_XOR T_U64 e_bin OP_XOR T_U64 get ir_r 40 get ir_r 54 get ir_r 53
  b2 = e_bin OP_XOR T_U64 e_bin OP_XOR T_U64 get ir_r 41 get ir_r 55 get ir_r 53
  put ir_r 30 e_bin OP_OR T_U64 a2 e_bin OP_SHL T_U64 b2 c1
  c2 = e_bin OP_XOR T_U64 e_bin OP_XOR T_U64 get ir_r 42 get ir_r 55 get ir_r 53
  d2 = e_bin OP_XOR T_U64 e_bin OP_XOR T_U64 get ir_r 43 get ir_r 54 get ir_r 53
  put ir_r 31 e_bin OP_OR T_U64 c2 e_bin OP_SHL T_U64 d2 c1
end

note @f7/@f8 step_ab / step_ba helpers (kept small to avoid omc register limits)
fn emit_step_init src_gid ulong dst_gid ulong to void
  put ir_vs 0 T_U64
  put ir_vs 1 T_U64
  put ir_vs 2 T_U64
  fn_start 0 3 T_VOID
  note b0 (block 0): params 1=K, 2=R, 3=phase
  blk0
  put ir_r 0 e_gaddr T_R_GRID src_gid
  put ir_r 1 e_gaddr T_R_GRID dst_gid
  put ir_r 2 e_const T_U64 1
  put ir_r 3 e_const T_U64 0
  put ir_r 4 e_const T_U64 65536
  put ir_r 5 e_const T_U64 EVEN_MASK
  put ir_r 6 e_const T_U64 2
  put ir_r 7 e_const T_U64 63
  put ir_r 8 e_bin OP_SHR T_U64 2 get ir_r 2
  e_cbr e_bin OP_EQ T_BOOL 3 get ir_r 3 1 10
  blk_end
end

fn emit_step_even to void
  note b1
  blk1
  e_br2 2 get ir_r 3
  blk_end
  note b2(tok, py)
  blk2 T_U64
  py = sub get ir_nv 0 1
  put ir_r 9 py
  e_cbr e_bin OP_LT T_BOOL py get ir_r 8 3 9
  blk_end
  note b3
  blk1
  put ir_r 21 e_bin OP_MUL T_U64 get ir_r 9 get ir_r 6
  put ir_r 22 e_bin OP_ADD T_U64 get ir_r 21 get ir_r 2
  put ir_r 10 e_bin OP_MUL T_U64 get ir_r 21 1
  put ir_r 11 e_bin OP_MUL T_U64 get ir_r 22 1
  e_br2 4 get ir_r 3
  blk_end
  note b4(tok, kx)
  blk2 T_U64
  kx = sub get ir_nv 0 1
  put ir_r 12 kx
  e_cbr e_bin OP_LT T_BOOL kx 1 5 8
  blk_end
  note b5
  blk1
  put ir_r 13 e_bin OP_ADD T_U64 get ir_r 10 get ir_r 12
  put ir_r 14 e_bin OP_ADD T_U64 get ir_r 11 get ir_r 12
  e_cbr e_bin OP_LT T_BOOL get ir_r 13 get ir_r 4 6 28
  blk_end
  note b6
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 14 get ir_r 4 7 28
  blk_end
  note b7 (even SWAR step, both i0 and i1 BCE-guarded!)
  blk1
  e_chkb get ir_r 0 get ir_r 13 get ir_r 2
  w0 = e_load T_U64 get ir_r 0 get ir_r 13
  e_chkb get ir_r 0 get ir_r 14 get ir_r 2
  w1 = e_load T_U64 get ir_r 0 get ir_r 14
  emit_swar_bbm w0 w1
  e_chkb get ir_r 1 get ir_r 13 get ir_r 2
  e_store get ir_r 1 get ir_r 13 get ir_r 30
  e_chkb get ir_r 1 get ir_r 14 get ir_r 2
  e_store get ir_r 1 get ir_r 14 get ir_r 31
  e_br2 4 e_bin OP_ADD T_U64 get ir_r 12 get ir_r 2
  blk_end
  note b8
  blk1
  e_br2 2 e_bin OP_ADD T_U64 get ir_r 9 get ir_r 2
  blk_end
  note b9
  blk1
  e_ret
  blk_end
end

fn emit_step_odd_p1_hd to void
  note b10
  blk1
  e_br2 11 get ir_r 3
  blk_end
  note b11(tok, py)
  blk2 T_U64
  py = sub get ir_nv 0 1
  put ir_r 9 py
  e_cbr e_bin OP_LT T_BOOL py get ir_r 8 12 27
  blk_end
  note b12
  blk1
  r0 = e_bin OP_ADD T_U64 e_bin OP_MUL T_U64 get ir_r 9 get ir_r 6 get ir_r 2
  r1r = e_bin OP_ADD T_U64 r0 get ir_r 2
  r1 = e_sel T_U64 e_bin OP_LT T_BOOL r1r 2 r1r get ir_r 3
  put ir_r 10 e_bin OP_MUL T_U64 r0 1
  put ir_r 11 e_bin OP_MUL T_U64 r1 1
  e_br2 13 get ir_r 3
  blk_end
  note b13(tok, kx)
  blk2 T_U64
  kx = sub get ir_nv 0 1
  put ir_r 12 kx
  e_cbr e_bin OP_LT T_BOOL kx 1 14 19
  blk_end
  note b14
  blk1
  kx1 = e_bin OP_ADD T_U64 get ir_r 12 get ir_r 2
  kn = e_sel T_U64 e_bin OP_LT T_BOOL kx1 1 kx1 get ir_r 3
  put ir_r 13 e_bin OP_ADD T_U64 get ir_r 10 get ir_r 12
  put ir_r 14 e_bin OP_ADD T_U64 get ir_r 11 get ir_r 12
  put ir_r 15 e_bin OP_ADD T_U64 get ir_r 10 kn
  put ir_r 16 e_bin OP_ADD T_U64 get ir_r 11 kn
  e_cbr e_bin OP_LT T_BOOL get ir_r 13 get ir_r 4 15 28
  blk_end
end

fn emit_step_odd_p1_bd to void
  note b15
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 14 get ir_r 4 16 28
  blk_end
  note b16
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 15 get ir_r 4 17 28
  blk_end
  note b17
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 16 get ir_r 4 18 28
  blk_end
  note b18 (odd pass 1 SWAR step, all 4 indices BCE-guarded!)
  blk1
  e_chkb get ir_r 0 get ir_r 13 get ir_r 2
  put ir_r 21 e_load T_U64 get ir_r 0 get ir_r 13
  e_chkb get ir_r 0 get ir_r 14 get ir_r 2
  put ir_r 22 e_load T_U64 get ir_r 0 get ir_r 14
  e_chkb get ir_r 0 get ir_r 15 get ir_r 2
  put ir_r 23 e_load T_U64 get ir_r 0 get ir_r 15
  e_chkb get ir_r 0 get ir_r 16 get ir_r 2
  put ir_r 24 e_load T_U64 get ir_r 0 get ir_r 16
  c1 = get ir_r 2
  c63 = get ir_r 7
  w0 = e_bin OP_OR T_U64 e_bin OP_SHR T_U64 get ir_r 21 c1 e_bin OP_SHL T_U64 e_bin OP_AND T_U64 get ir_r 23 c1 c63
  w1 = e_bin OP_OR T_U64 e_bin OP_SHR T_U64 get ir_r 22 c1 e_bin OP_SHL T_U64 e_bin OP_AND T_U64 get ir_r 24 c1 c63
  emit_swar_bbm w0 w1
  e_chkb get ir_r 1 get ir_r 13 get ir_r 2
  e_store get ir_r 1 get ir_r 13 get ir_r 30
  e_chkb get ir_r 1 get ir_r 14 get ir_r 2
  e_store get ir_r 1 get ir_r 14 get ir_r 31
  e_br2 13 e_bin OP_ADD T_U64 get ir_r 12 get ir_r 2
  blk_end
end

fn emit_step_odd_p2_hd to void
  note b19 (odd pass 2 setup: guard l0, l1 < 65536)
  blk1
  kl = e_bin OP_SUB T_U64 1 get ir_r 2
  put ir_r 17 e_bin OP_ADD T_U64 get ir_r 10 kl
  put ir_r 18 e_bin OP_ADD T_U64 get ir_r 11 kl
  e_cbr e_bin OP_LT T_BOOL get ir_r 17 get ir_r 4 20 28
  blk_end
  note b20
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 18 get ir_r 4 21 28
  blk_end
  note b21
  blk1
  e_chkb get ir_r 1 get ir_r 17 get ir_r 2
  wl0 = e_load T_U64 get ir_r 1 get ir_r 17
  e_chkb get ir_r 1 get ir_r 18 get ir_r 2
  wl1 = e_load T_U64 get ir_r 1 get ir_r 18
  put ir_r 19 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 wl0 get ir_r 7 get ir_r 2
  put ir_r 20 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 wl1 get ir_r 7 get ir_r 2
  e_br4 22 get ir_r 3 get ir_r 19 get ir_r 20
  blk_end
  note b22(tok, kx, car0, car1)
  blk4 T_U64 T_U64 T_U64
  kx = sub get ir_nv 0 3
  put ir_r 12 kx
  put ir_r 19 sub get ir_nv 0 2
  put ir_r 20 sub get ir_nv 0 1
  e_cbr e_bin OP_LT T_BOOL kx 1 23 26
  blk_end
end

fn emit_step_odd_p2_bd to void
  note b23
  blk1
  put ir_r 13 e_bin OP_ADD T_U64 get ir_r 10 get ir_r 12
  put ir_r 14 e_bin OP_ADD T_U64 get ir_r 11 get ir_r 12
  e_cbr e_bin OP_LT T_BOOL get ir_r 13 get ir_r 4 24 28
  blk_end
  note b24
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 14 get ir_r 4 25 28
  blk_end
  note b25
  blk1
  e_chkb get ir_r 1 get ir_r 13 get ir_r 2
  put ir_r 25 e_load T_U64 get ir_r 1 get ir_r 13
  e_chkb get ir_r 1 get ir_r 14 get ir_r 2
  put ir_r 26 e_load T_U64 get ir_r 1 get ir_r 14
  c1 = get ir_r 2
  c63 = get ir_r 7
  put ir_r 27 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 get ir_r 25 c63 c1
  put ir_r 28 e_bin OP_AND T_U64 e_bin OP_SHR T_U64 get ir_r 26 c63 c1
  e_chkb get ir_r 1 get ir_r 13 get ir_r 2
  e_store get ir_r 1 get ir_r 13 e_bin OP_OR T_U64 e_bin OP_SHL T_U64 get ir_r 25 c1 get ir_r 19
  e_chkb get ir_r 1 get ir_r 14 get ir_r 2
  e_store get ir_r 1 get ir_r 14 e_bin OP_OR T_U64 e_bin OP_SHL T_U64 get ir_r 26 c1 get ir_r 20
  e_br4 22 e_bin OP_ADD T_U64 get ir_r 12 c1 get ir_r 27 get ir_r 28
  blk_end
  note b26
  blk1
  e_br2 11 e_bin OP_ADD T_U64 get ir_r 9 get ir_r 2
  blk_end
  note b27
  blk1
  e_ret
  blk_end
  note b28
  blk1
  e_trap 3
  blk_end
  fn_end
end

fn emit_step_fn src_gid ulong dst_gid ulong to void
  emit_step_init src_gid dst_gid
  emit_step_even
  emit_step_odd_p1_hd
  emit_step_odd_p1_bd
  emit_step_odd_p2_hd
  emit_step_odd_p2_bd
end

note @f9 export main() -> i32 helpers
fn emit_f9_setup to void
  fn_start 2 0 T_I32
  note b0
  blk0
  put ir_r 0 e_const T_U64 0
  put ir_r 1 e_const T_U64 1
  put ir_r 2 e_const T_U64 2
  put ir_r 3 e_const T_U64 3
  put ir_r 4 e_const T_U64 4
  put ir_r 5 e_const T_U64 5
  put ir_r 6 e_const T_U64 6
  put ir_r 7 e_const T_U64 7
  put ir_r 8 e_const T_U64 8
  put ir_r 9 e_const T_I64 0
  put ir_r 10 e_const T_U64 CAW_MAGIC
  put ir_r 11 e_const T_U64 4096
  put ir_r 12 e_const T_U64 64
  put ir_r 13 e_const T_U64 2048
  put ir_r 14 e_const T_U64 65536
  e_br1 1
  blk_end
  note b1 (packet loop)
  blk1
  hr = e_call0 0 T_I64
  put ir_r 15 hr
  e_cbr e_bin OP_EQ T_BOOL hr get ir_r 9 2 3
  blk_end
  note b2 (clean EOF / steps==0 -> exit 0)
  blk1
  e_retv e_const T_I32 0
  blk_end
  note b3
  blk1
  e_cbr e_bin OP_LT T_BOOL get ir_r 15 get ir_r 9 4 5
  blk_end
  note b4 (bad magic / header read err -> exit 41)
  blk1
  e_exit e_const T_I32 41
  blk_end
end

fn emit_f9_hdr_val to void
  note b5 (read 8 header fields)
  blk1
  mg = e_call1 3 T_U64 get ir_r 0
  put ir_r 16 e_call1 3 T_U64 get ir_r 1
  put ir_r 17 e_call1 3 T_U64 get ir_r 2
  put ir_r 18 e_call1 3 T_U64 get ir_r 3
  put ir_r 19 e_call1 3 T_U64 get ir_r 4
  put ir_r 20 e_call1 3 T_U64 get ir_r 5
  put ir_r 21 e_call1 3 T_U64 get ir_r 6
  put ir_r 22 e_call1 3 T_U64 get ir_r 7
  e_cbr e_bin OP_EQ T_BOOL mg get ir_r 10 6 4
  blk_end
  note b6
  blk1
  e_cbr e_bin OP_EQ T_BOOL get ir_r 16 get ir_r 0 7 8
  blk_end
  note b7 (steps == 0 -> clean stop unless fault_flag != 0)
  blk1
  e_cbr e_bin OP_EQ T_BOOL get ir_r 22 get ir_r 0 2 20
  blk_end
  note b8 (validate steps <= 4096, 1 <= K <= 64, 2 <= R <= 2048 even, phase0 <= 1)
  blk1
  put ir_r 29 e_bin OP_LE T_BOOL get ir_r 16 get ir_r 11
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_GE T_BOOL get ir_r 17 get ir_r 1
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_LE T_BOOL get ir_r 17 get ir_r 12
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_GE T_BOOL get ir_r 18 get ir_r 2
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_LE T_BOOL get ir_r 18 get ir_r 13
  evr = e_bin OP_EQ T_BOOL e_bin OP_AND T_U64 get ir_r 18 get ir_r 1 get ir_r 0
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 evr
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_LE T_BOOL get ir_r 19 get ir_r 1
  e_cbr get ir_r 29 9 21
  blk_end
  note b9 (tot_words <= 65536, out_cnt >= 1, out_off + out_cnt <= R)
  blk1
  tw = e_bin OP_MUL T_U64 get ir_r 17 get ir_r 18
  put ir_r 23 tw
  put ir_r 29 e_bin OP_LE T_BOOL tw get ir_r 14
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_GE T_BOOL get ir_r 21 get ir_r 1
  sm = e_bin OP_ADD T_U64 get ir_r 20 get ir_r 21
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_GE T_BOOL sm get ir_r 20
  put ir_r 29 e_bin OP_AND T_BOOL get ir_r 29 e_bin OP_LE T_BOOL sm get ir_r 18
  e_cbr get ir_r 29 10 21
  blk_end
end

fn emit_f9_loop to void
  note b10 (read body first so coordinator sees clean read vs SIGPIPE on fault)
  blk1
  rr = e_call1 1 T_I64 e_bin OP_MUL T_U64 get ir_r 23 get ir_r 8
  e_cbr e_bin OP_LT T_BOOL rr get ir_r 9 22 24
  blk_end
  note b11 (unpack body -> g_a)
  blk1
  z0 = e_call1 4 T_VOID get ir_r 23
  e_br2 12 get ir_r 0
  blk_end
  note b12(tok, s)
  blk2 T_U64
  sv = sub get ir_nv 0 1
  put ir_r 24 sv
  e_cbr e_bin OP_LT T_BOOL sv get ir_r 16 13 16
  blk_end
  note b13
  blk1
  put ir_r 25 e_bin OP_AND T_U64 e_bin OP_XOR T_U64 get ir_r 19 get ir_r 24 get ir_r 1
  ev = e_bin OP_EQ T_BOOL e_bin OP_AND T_U64 get ir_r 24 get ir_r 1 get ir_r 0
  e_cbr ev 14 15
  blk_end
  note b14 (step_ab)
  blk1
  z1 = e_call3 7 T_VOID get ir_r 17 get ir_r 18 get ir_r 25
  e_br2 12 e_bin OP_ADD T_U64 get ir_r 24 get ir_r 1
  blk_end
  note b15 (step_ba)
  blk1
  z2 = e_call3 8 T_VOID get ir_r 17 get ir_r 18 get ir_r 25
  e_br2 12 e_bin OP_ADD T_U64 get ir_r 24 get ir_r 1
  blk_end
end

fn emit_f9_tail to void
  note b16 (pack output)
  blk1
  put ir_r 26 e_bin OP_MUL T_U64 get ir_r 20 get ir_r 17
  ow = e_bin OP_MUL T_U64 get ir_r 21 get ir_r 17
  put ir_r 27 ow
  put ir_r 28 e_bin OP_MUL T_U64 ow get ir_r 8
  ev = e_bin OP_EQ T_BOOL e_bin OP_AND T_U64 get ir_r 16 get ir_r 1 get ir_r 0
  e_cbr ev 17 18
  blk_end
  note b17 (pack_a_to_io)
  blk1
  z3 = e_call2 5 T_VOID get ir_r 26 get ir_r 27
  e_br1 19
  blk_end
  note b18 (pack_b_to_io)
  blk1
  z4 = e_call2 6 T_VOID get ir_r 26 get ir_r 27
  e_br1 19
  blk_end
  note b19 (write output -> loop b1)
  blk1
  wr = e_call1 2 T_I64 get ir_r 28
  e_cbr e_bin OP_LT T_BOOL wr get ir_r 9 23 1
  blk_end
  note b20..b23 error exits
  blk1
  e_exit e_const T_I32 49
  blk_end
  blk1
  e_exit e_const T_I32 42
  blk_end
  blk1
  e_exit e_const T_I32 43
  blk_end
  blk1
  e_exit e_const T_I32 44
  blk_end
  note b24 (post-body fault_flag check -> clean exit 49 without pipe SIGPIPE)
  blk1
  e_cbr e_bin OP_EQ T_BOOL get ir_r 22 get ir_r 0 11 20
  blk_end
  fn_end
end

fn emit_f9 to void
  emit_f9_setup
  emit_f9_hdr_val
  emit_f9_loop
  emit_f9_tail
end

fn main to int
  put irp 0 0
  ir_mod_hdr
  ir_types_globs
  emit_f0
  emit_io_exact 53 0
  emit_io_exact 54 1
  emit_f3
  emit_f4
  emit_pack_fn G_A
  emit_pack_fn G_B
  emit_step_fn G_A G_B
  emit_step_fn G_B G_A
  emit_f9
  tot = get irp 0
  ofs = ulong 0
  while lt ofs tot bound 262144
    w = write 1 irb ofs sub tot ofs
    if le w 0
      ret 1
    end
    ofs = add ofs ulong w
  end
  ret 0
end

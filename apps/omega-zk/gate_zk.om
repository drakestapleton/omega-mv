note Exact patch strings for live OMC source mutants M1..M5
text zg_p_try_old "    put zk_tr_y t y"
text zg_p_try_new "    if eq t 15\n      put zk_tr_y t gl_add y 1\n    else\n      put zk_tr_y t y\n    end"
text zg_p_deg0_old "  if not prv_check_deg 0 64\n    ret ZK_ERR_PROVE\n  end"

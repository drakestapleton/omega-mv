text zg_p_ood4_new "  put zk_ood 4 air_eval_ood_point zeta"
text zg_p_deg1_old "  if not prv_check_deg 1 64\n    ret ZK_ERR_PROVE\n  end"
text zg_p_fin_old "  put zk_final j get zk_fri j\n  end\n  for j ulong 3\n    if ne get zk_final j get zk_final add j 1\n      ret ZK_ERR_PROVE\n    end\n  end"
text zg_p_fin_new "  put zk_final j get zk_fri j\n  end\n  for j ulong 4\n    put zk_final j get zk_final 0\n  end"

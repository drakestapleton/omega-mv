text zg_empty ""

note ==== Section 1: Printing & Assertion Helpers ====

fn zg_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn zg_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn zg_num v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put zg_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 zg_dig p sub 24 p
      ret
    end
  end
end

fn zg_fail tag ulong to void
  put zg_fails 0 add get zg_fails 0 1
  zg_wrt zg_m_fail
  zg_num tag
  zg_wrt zg_nl
end

fn zg_chk ok bool tag ulong to void
  put zg_checks 0 add get zg_checks 0 1
  if not ok
    zg_fail tag
  end
end

fn zg_ctrl killed bool tag ulong to void
  put zg_ctrls 0 add get zg_ctrls 0 1
  if killed
    put zg_caught 0 add get zg_caught 0 1
  else
    zg_fail tag
  end
end

note ==== Section 2: Path, Buffer & Process Helpers ====

fn zg_arg_to_glob idx ulong which ulong to ulong
  rn = argread idx zg_arg 0 1020
  if le rn 0
    ret 0
  end
  u = ulong rn
  for i ulong u bound 1024
    b = get zg_arg i
    if eq which 0
      put zg_omc i b
    else
      if eq which 1
        put zg_root i b
      else
        if eq which 2
          put zg_scr i b
        else
          put zg_bin i b
        end
      end
    end
  end
  ret u
end

fn zg_set_pa_root suf view uchar * to ulong
  rl = get zg_root_l 0
  for i ulong rl bound 1024
    put zg_pa i get zg_root i
  end
  sl = len suf
  for j ulong sl bound 512
    put zg_pa add rl j get suf j
  end
  put zg_pal 0 add rl sl
  ret add rl sl
end

fn zg_set_pa_scr suf view uchar * to ulong
  rl = get zg_scr_l 0
  for i ulong rl bound 1024
    put zg_pa i get zg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put zg_pa add rl j get suf j
  end
  put zg_pal 0 add rl sl
  ret add rl sl
end

fn zg_set_pb_scr suf view uchar * to ulong
  rl = get zg_scr_l 0
  for i ulong rl bound 1024
    put zg_pb i get zg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put zg_pb add rl j get suf j
  end
  put zg_pbl 0 add rl sl
  ret add rl sl
end

fn zg_set_pc_scr suf view uchar * to ulong
  rl = get zg_scr_l 0
  for i ulong rl bound 1024
    put zg_pc i get zg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put zg_pc add rl j get suf j
  end
  put zg_pcl 0 add rl sl
  ret add rl sl
end

fn zg_set_bin_scr suf view uchar * to void
  rl = get zg_scr_l 0
  for i ulong rl bound 1024
    put zg_bin i get zg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put zg_bin add rl j get suf j
  end
  put zg_bin_l 0 add rl sl
end

fn zg_av_clr to void
  put zg_avn 0 2
  put zg_avc 0 0
  put zg_av 0 0
  put zg_av 1 0
end

fn zg_av_fin sl ulong to void
  p = get zg_avn 0
  put zg_av p uchar and sl 255
  put zg_av add p 1 uchar shr sl 8
  put zg_avn 0 add p add sl 2
  c = add get zg_avc 0 1
  put zg_avc 0 c
  put zg_av 0 uchar and c 255
  put zg_av 1 uchar shr c 8
end

fn zg_av_omc to void
  p = get zg_avn 0
  sl = get zg_omc_l 0
  for j ulong sl bound 1024
    put zg_av add add p 2 j get zg_omc j
  end
  zg_av_fin sl
end

fn zg_av_bin to void
  p = get zg_avn 0
  sl = get zg_bin_l 0
  for j ulong sl bound 1024
    put zg_av add add p 2 j get zg_bin j
  end
  zg_av_fin sl
end

fn zg_av_pa to void
  p = get zg_avn 0
  sl = get zg_pal 0
  for j ulong sl bound 1024
    put zg_av add add p 2 j get zg_pa j
  end
  zg_av_fin sl
end

fn zg_av_lit s view uchar * to void
  p = get zg_avn 0
  sl = len s
  for j ulong sl bound 1024
    put zg_av add add p 2 j get s j
  end
  zg_av_fin sl
end

fn zg_redir fd int target int to void
  if ne dupfd fd target 0 long target
    exit 127
  end
end

fn zg_run_sync fi long fo long fe long to ulong
  if or lt fi 0 or lt fo 0 lt fe 0
    if ge fi 0
      z = fclose int fi
    end
    if ge fo 0
      z = fclose int fo
    end
    if ge fe 0
      z = fclose int fe
    end
    ret 999
  end
  pid = fork
  if lt pid 0
    ret 998
  end
  if eq pid 0
    zg_redir int fi 0
    zg_redir int fo 1
    zg_redir int fe 2
    ze = execprog zg_av 0 get zg_avn 0
    exit 127
  end
  z = fclose int fi
  z = fclose int fo
  z = fclose int fe
  t0 = monons
  while true bound 100000000
    r = waitpid int pid zg_stb 0 len zg_stb 1
    if eq r pid
      if ne get zg_stb 0 0
        ret add 128 ulong get zg_stb 0
      end
      ret ulong get zg_stb 1
    end
    if lt r 0
      ret 997
    end
    if gt sub monons t0 60000000000
      zk = killpid int pid 9
      zw = waitpid int pid zg_stb 0 len zg_stb 0
      ret 996
    end
  end
  ret 995
end

fn zg_read_pa_to_sh to long
  fd = fopen zg_pa 0 get zg_pal 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn zg_read_omc_to_sh to long
  fd = fopen zg_omc 0 get zg_omc_l 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn zg_stat_pa_size to long
  r = stat zg_pa 0 get zg_pal 0 zg_stat 0 128
  if ne r 0
    ret -1
  end
  sz = ulong 0
  for j ulong 8
    sz = or sz shl ulong get zg_stat add 48 j mul j 8
  end
  ret long sz
end

fn zg_read_out_pa to void
  put zg_outl 0 0
  fd = fopen zg_pa 0 get zg_pal 0 0 0
  if lt fd 0
    ret
  end
  rn = read int fd zg_out 0 16384
  z = fclose int fd
  if gt rn 0
    put zg_outl 0 ulong rn
  end
end

fn zg_has_sub pat view uchar * to bool
  ol = get zg_outl 0
  pl = len pat
  if or eq pl 0 gt pl ol
    ret false
  end
  lim = add sub ol pl 1
  for i ulong lim bound 16384
    ok = true
    for j ulong pl bound 128
      if ne get zg_out add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn zg_spawn_cur to ulong
  zp = zg_set_pa_scr zg_f_out
  fi = fopen zg_null 0 len zg_null 0 0
  fo = fopen zg_pa 0 get zg_pal 0 577 420
  fe = fopen zg_null 0 len zg_null 0 0
  rc = zg_run_sync fi fo fe
  zp = zg_set_pa_scr zg_f_out
  zg_read_out_pa
  ret rc
end

note ==== Section 3: Pin Verification, 2x Compile, Static ELF & Source Mutants ====

fn zg_verify_omc_pin to bool
  zp = zg_set_pa_root zg_p_pin
  fd = fopen zg_pa 0 get zg_pal 0 0 0
  if lt fd 0
    ret false
  end
  rn = read int fd zg_pin_hex 0 128
  z = fclose int fd
  if lt rn 64
    ret false
  end
  nb = zg_read_omc_to_sh
  if le nb 0
    ret false
  end
  sh_all ulong nb
  for i ulong 32
    b = get sh_dig i
    hi = shr b 4
    lo = and b 15
    hc = uchar add 48 hi
    if ge hi 10
      hc = uchar add 87 hi
    end
    lc = uchar add 48 lo
    if ge lo 10
      lc = uchar add 87 lo
    end
    if ne hc get zg_pin_hex mul i 2
      ret false
    end
    if ne lc get zg_pin_hex add mul i 2 1
      ret false
    end
  end
  ret true
end

fn zg_append_root_src suf view uchar * to bool
  zp = zg_set_pa_root suf
  fd = fopen zg_pa 0 get zg_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = get zg_srcl 0
  while lt tot 262144 bound 64
    rn = read int fd zg_src tot sub 262144 tot
    if lt rn 0
      z = fclose int fd
      ret false
    end
    if eq rn 0
      z = fclose int fd
      put zg_srcl 0 tot
      ret true
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret false
end

fn zg_write_buf_pa_src n ulong is_mut bool to bool
  fd = fopen zg_pa 0 get zg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 64
    wn = long 0
    if is_mut
      wn = write int fd zg_mut off sub n off
    else
      wn = write int fd zg_src off sub n off
    end
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn zg_build_stark_src to ulong
  put zg_srcl 0 0
  if not zg_append_root_src zg_u0
    ret 0
  end
  if not zg_append_root_src zg_u1
    ret 0
  end
  if not zg_append_root_src zg_u2
    ret 0
  end
  n = get zg_srcl 0
  zp = zg_set_pa_scr zg_f_src
  if not zg_write_buf_pa_src n false
    ret 0
  end
  ret n
end

fn zg_compile_src scr_src view uchar * scr_out view uchar * scr_err view uchar * to ulong
  zg_av_clr
  zg_av_omc
  zp = zg_set_pa_scr scr_src
  zp = zg_set_pb_scr scr_out
  zp = zg_set_pc_scr scr_err
  fi = fopen zg_pa 0 get zg_pal 0 0 0
  fo = fopen zg_pb 0 get zg_pbl 0 577 493
  fe = fopen zg_pc 0 get zg_pcl 0 577 420
  rc = zg_run_sync fi fo fe
  if eq rc 0
    zp = zg_set_pb_scr scr_out
    zcm = chmod zg_pb 0 get zg_pbl 0 493
  end
  ret rc
end

fn zg_hash_scr_file suf view uchar * dst_sha ulong to long
  zp = zg_set_pa_scr suf
  nb = zg_read_pa_to_sh
  if le nb 0
    ret -1
  end
  sh_all ulong nb
  for j ulong 32
    if eq dst_sha 1
      put zg_h1 j get sh_dig j
    else
      put zg_h2 j get sh_dig j
    end
  end
  ret nb
end

fn zg_sh_u16 off ulong to ulong
  b0 = ulong get sh_dat off
  b1 = ulong get sh_dat add off 1
  ret or b0 shl b1 8
end

fn zg_sh_u32 off ulong to ulong
  v = ulong 0
  for b ulong 4
    v = or v shl ulong get sh_dat add off b mul b 8
  end
  ret v
end

fn zg_sh_u64 off ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get sh_dat add off i mul i 8
  end
  ret v
end

fn zg_check_static_elf suf view uchar * to bool
  zp = zg_set_pa_scr suf
  nb = zg_read_pa_to_sh
  if lt nb 128
    ret false
  end
  if or ne get sh_dat 0 127 ne get sh_dat 1 69
    ret false
  end
  if or ne get sh_dat 2 76 ne get sh_dat 3 70
    ret false
  end
  if or ne get sh_dat 4 2 ne zg_sh_u16 18 183
    ret false
  end
  phoff = zg_sh_u64 32
  phentsz = zg_sh_u16 54
  phnum = zg_sh_u16 56
  if or eq phnum 0 gt phnum 16
    ret false
  end
  for k ulong phnum bound 16
    if eq zg_sh_u32 add phoff mul k phentsz 2
      ret false
    end
  end
  ret true
end

fn zg_mut_reset to void
  sl = get zg_srcl 0
  for i ulong sl bound 262144
    put zg_mut i get zg_src i
  end
  put zg_mutl 0 sl
end

fn zg_mut_match_at base ulong pat view uchar * to bool
  for j ulong len pat bound 256
    if ne get zg_mut add base j get pat j
      ret false
    end
  end
  ret true
end

fn zg_mut_find old_s view uchar * to long
  ml = get zg_mutl 0
  ol = len old_s
  if gt ol ml
    ret -1
  end
  hits = ulong 0
  pos = ulong 0
  lim = add sub ml ol 1
  for i ulong lim bound 262144
    if zg_mut_match_at i old_s
      hits = add hits 1
      pos = i
    end
  end
  if ne hits 1
    ret -1
  end
  ret long pos
end

fn zg_mut_copy_tail dst_off ulong src_off ulong count ulong to void
  for i ulong count bound 262144
    put zg_tmp add dst_off i get zg_mut add src_off i
  end
end

fn zg_mut_splice pos ulong ol ulong new_s view uchar * to bool
  ml = get zg_mutl 0
  nl = len new_s
  outn = add sub ml ol nl
  if gt outn 262144
    ret false
  end
  for i ulong pos bound 262144
    put zg_tmp i get zg_mut i
  end
  for j ulong nl bound 256
    put zg_tmp add pos j get new_s j
  end
  zg_mut_copy_tail add pos nl add pos ol sub ml add pos ol
  for i ulong outn bound 262144
    put zg_mut i get zg_tmp i
  end
  put zg_mutl 0 outn
  ret true
end

fn zg_mut_patch old_s view uchar * new_s view uchar * to bool
  pos = zg_mut_find old_s
  if lt pos 0
    ret false
  end
  ret zg_mut_splice ulong pos len old_s new_s
end

fn zg_mut_compile to bool
  zp = zg_set_pa_scr zg_f_msrc
  if not zg_write_buf_pa_src get zg_mutl 0 true
    ret false
  end
  ret eq zg_compile_src zg_f_msrc zg_f_mb zg_f_me 0
end

note ==== Section 4: Proof File I/O & Byte Tamper Helpers ====

fn zg_load_proof suf view uchar * to bool
  zp = zg_set_pa_scr suf
  fd = fopen zg_pa 0 get zg_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot 65536 bound 256
    rn = read int fd zg_proof tot sub 65536 tot
    if lt rn 0
      z = fclose int fd
      ret false
    end
    if eq rn 0
      z = fclose int fd
      ret eq tot ZK_PROOF_BYTES
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret false
end

fn zg_reset_atk to void
  for i ulong ZK_PROOF_BYTES bound 65536
    put zg_atk i get zg_proof i
  end
end

fn zg_put_atk_u64 off ulong v ulong to void
  for i ulong 8
    put zg_atk add off i uchar and shr v mul i 8 255
  end
end

fn zg_write_atk n ulong to bool
  zp = zg_set_pa_scr zg_f_patk
  fd = fopen zg_pa 0 get zg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 256
    wn = write int fd zg_atk off sub n off
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn zg_verify_atk_expect exp_rc ulong tag ulong to void
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_patk
  zg_av_pa
  rc = zg_spawn_cur
  zg_ctrl eq rc exp_rc tag
end

fn zg_verify_atk_nonzero tag ulong to void
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_patk
  zg_av_pa
  rc = zg_spawn_cur
  zg_ctrl and ne rc 0 lt rc 100 tag
end

note ==== Section 5: Positive End-to-End & Cross-Run Checks ====

fn zg_run_positive two_bins bool to void
  if two_bins
    zg_set_bin_scr zg_f_b1
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_self
  rc0 = zg_spawn_cur
  zg_chk and eq rc0 0 zg_has_sub zg_q_self 101

  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_prove
  zg_av_lit zg_fl_out
  zp = zg_set_pa_scr zg_f_pa
  zg_av_pa
  rc1 = zg_spawn_cur
  zg_chk and eq rc1 0 zg_has_sub zg_q_prv 102

  note Cross-run independent verification using stark_2 when compiled twice
  if two_bins
    zg_set_bin_scr zg_f_b2
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pa
  zg_av_pa
  zg_av_lit zg_fl_x0
  zg_av_lit zg_v_3
  zg_av_lit zg_fl_y0
  zg_av_lit zg_v_5
  zg_av_lit zg_fl_c0
  zg_av_lit zg_v_11
  zg_av_lit zg_fl_del
  zg_av_lit zg_v_7
  zg_av_lit zg_fl_ox
  zg_av_lit zg_v_ox_a
  zg_av_lit zg_fl_oy
  zg_av_lit zg_v_oy_a
  rc2 = zg_spawn_cur
  zg_chk and eq rc2 0 zg_has_sub zg_q_ver 103

  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_inspect
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pa
  zg_av_pa
  rc3 = zg_spawn_cur
  zg_chk and eq rc3 0 zg_has_sub zg_q_ins 104

  note Parameterized statement B (x0=17, y0=42, c0=99, delta=13)
  if two_bins
    zg_set_bin_scr zg_f_b1
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_prove
  zg_av_lit zg_fl_out
  zp = zg_set_pa_scr zg_f_pb
  zg_av_pa
  zg_av_lit zg_fl_x0
  zg_av_lit zg_v_17
  zg_av_lit zg_fl_y0
  zg_av_lit zg_v_42
  zg_av_lit zg_fl_c0
  zg_av_lit zg_v_99
  zg_av_lit zg_fl_del
  zg_av_lit zg_v_13
  zg_chk eq zg_spawn_cur 0 105

  if two_bins
    zg_set_bin_scr zg_f_b2
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pb
  zg_av_pa
  zg_av_lit zg_fl_x0
  zg_av_lit zg_v_17
  zg_av_lit zg_fl_y0
  zg_av_lit zg_v_42
  zg_av_lit zg_fl_c0
  zg_av_lit zg_v_99
  zg_av_lit zg_fl_del
  zg_av_lit zg_v_13
  zg_chk eq zg_spawn_cur 0 106

  note Zero-boundary statement Z (x0=0, y0=5, c0=11, delta=7) for GL_P aliasing attack
  if two_bins
    zg_set_bin_scr zg_f_b1
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_prove
  zg_av_lit zg_fl_out
  zp = zg_set_pa_scr zg_f_pz
  zg_av_pa
  zg_av_lit zg_fl_x0
  zg_av_lit zg_v_0
  zg_av_lit zg_fl_y0
  zg_av_lit zg_v_5
  zg_av_lit zg_fl_c0
  zg_av_lit zg_v_11
  zg_av_lit zg_fl_del
  zg_av_lit zg_v_7
  zg_chk eq zg_spawn_cur 0 107

  if two_bins
    zg_set_bin_scr zg_f_b2
  end
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pz
  zg_av_pa
  zg_av_lit zg_fl_x0
  zg_av_lit zg_v_0
  zg_chk eq zg_spawn_cur 0 108
end

note ==== Section 6: Cryptographic & Algebraic Attack Controls ====

fn zg_run_container_attacks to void
  note ATK1a: Non-canonical Goldilocks field injection val == GL_P into x0=0 proof (no wraparound alias!)
  zg_chk zg_load_proof zg_f_pz 200
  zg_reset_atk
  zg_put_atk_u64 32 GL_P
  zg_chk zg_write_atk ZK_PROOF_BYTES 201
  zg_verify_atk_expect 61 201

  note ATK1b: Non-canonical val == 2^64-1 in OOD x_zeta (offset 144) and in Round-0 query xlo (offset 376)
  zg_chk zg_load_proof zg_f_pa 202
  zg_reset_atk
  zg_put_atk_u64 144 0xffffffffffffffff
  zg_chk zg_write_atk ZK_PROOF_BYTES 202
  zg_verify_atk_expect 61 202

  zg_reset_atk
  zg_put_atk_u64 376 add GL_P 7
  zg_chk zg_write_atk ZK_PROOF_BYTES 203
  zg_verify_atk_expect 61 203

  note ATK2a: Wrong public boundary output claim via CLI --out-x
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pa
  zg_av_pa
  zg_av_lit zg_fl_ox
  zg_av_lit zg_v_ox_bad
  zg_ctrl eq zg_spawn_cur 62 204

  note ATK2b: Wrong public boundary output patched in OMZK01 container without --out-x
  zg_reset_atk
  zg_put_atk_u64 64 1234567
  zg_chk zg_write_atk ZK_PROOF_BYTES 205
  zg_verify_atk_nonzero 205

  note ATK4b: Non-constant FRI final layer (fri_final[1] != fri_final[0])
  zg_reset_atk
  zg_put_atk_u64 352 999
  zg_chk zg_write_atk ZK_PROOF_BYTES 206
  zg_verify_atk_expect 65 206

  note ATK5a: Forged Merkle authentication sibling node (1-bit flip in Round-0 trace_path_lo)
  zg_reset_atk
  put zg_atk 424 xor get zg_atk 424 1
  zg_chk zg_write_atk ZK_PROOF_BYTES 207
  zg_verify_atk_expect 64 207

  note ATK5b: Forged FRI Merkle root mismatch (1-bit flip in fri_root[1], offset 184)
  zg_reset_atk
  put zg_atk 184 xor get zg_atk 184 1
  zg_chk zg_write_atk ZK_PROOF_BYTES 208
  zg_verify_atk_expect 64 208

  note ATK5c: Forged trace_root mismatch (1-bit flip in trace_root, offset 80)
  zg_reset_atk
  put zg_atk 80 xor get zg_atk 80 1
  zg_chk zg_write_atk ZK_PROOF_BYTES 209
  zg_verify_atk_nonzero 209

  note ATK7a..d: 1-bit OMZK01 header tamper, version tamper, truncated & trailing-byte containers
  zg_reset_atk
  put zg_atk 0 xor get zg_atk 0 1
  zg_chk zg_write_atk ZK_PROOF_BYTES 210
  zg_verify_atk_expect 60 210

  zg_reset_atk
  put zg_atk 6 2
  zg_chk zg_write_atk ZK_PROOF_BYTES 211
  zg_verify_atk_expect 60 211

  zg_reset_atk
  zg_chk zg_write_atk sub ZK_PROOF_BYTES 1 212
  zg_verify_atk_expect 60 212

  zg_reset_atk
  put zg_atk ZK_PROOF_BYTES 0
  zg_chk zg_write_atk add ZK_PROOF_BYTES 1 213
  zg_verify_atk_expect 60 213
end

fn zg_mut_prove_and_honest_verify exp_rc ulong exact_rc bool tag ulong to void
  zg_set_bin_scr zg_f_mb
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_prove
  zg_av_lit zg_fl_out
  zp = zg_set_pa_scr zg_f_pmut
  zg_av_pa
  if ne zg_spawn_cur 0
    zg_fail tag
    ret
  end
  zg_set_bin_scr zg_f_b2
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_verify
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_pmut
  zg_av_pa
  rc = zg_spawn_cur
  if exact_rc
    if eq rc exp_rc
      put zg_mut_kills 0 add get zg_mut_kills 0 1
      zg_ctrl true tag
    else
      zg_ctrl false tag
    end
  else
    if and ne rc 0 lt rc 100
      put zg_mut_kills 0 add get zg_mut_kills 0 1
      zg_ctrl true tag
    else
      zg_ctrl false tag
    end
  end
end

fn zg_run_m1 to void
  zg_mut_reset
  if not zg_mut_patch zg_p_try_old zg_p_try_new
    zg_fail 301
    ret
  end
  if not zg_mut_patch zg_p_deg0_old zg_empty
    zg_fail 301
    ret
  end
  if not zg_mut_patch zg_p_ood4_old zg_p_ood4_new
    zg_fail 301
    ret
  end
  if not zg_mut_patch zg_p_deg1_old zg_empty
    zg_fail 301
    ret
  end
  if not zg_mut_patch zg_p_fin_old zg_p_fin_new
    zg_fail 301
    ret
  end
  if zg_mut_compile
    zg_mut_prove_and_honest_verify 65 true 301
  else
    zg_fail 301
  end
end

fn zg_run_m2 to void
  zg_mut_reset
  if not zg_mut_patch zg_p_f0_old zg_p_f0_new
    zg_fail 302
    ret
  end
  if not zg_mut_patch zg_p_deg1_old zg_empty
    zg_fail 302
    ret
  end
  if not zg_mut_patch zg_p_fin_old zg_p_fin_new
    zg_fail 302
    ret
  end
  if zg_mut_compile
    zg_mut_prove_and_honest_verify 65 true 302
  else
    zg_fail 302
  end
end

fn zg_run_m5 to void
  zg_mut_reset
  if not zg_mut_patch zg_p_can_old zg_p_can_new
    zg_fail 305
    ret
  end
  if not zg_mut_compile
    zg_fail 305
    ret
  end
  zg_chk zg_load_proof zg_f_pz 305
  zg_reset_atk
  zg_put_atk_u64 32 GL_P
  zg_chk zg_write_atk ZK_PROOF_BYTES 305
  zg_set_bin_scr zg_f_mb
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_inspect
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_patk
  zg_av_pa
  mrc = zg_spawn_cur
  zg_set_bin_scr zg_f_b2
  zg_av_clr
  zg_av_bin
  zg_av_lit zg_c_inspect
  zg_av_lit zg_fl_in
  zp = zg_set_pa_scr zg_f_patk
  zg_av_pa
  hrc = zg_spawn_cur
  if and eq mrc 0 eq hrc 61
    put zg_mut_kills 0 add get zg_mut_kills 0 1
    zg_ctrl true 305
  else
    zg_ctrl false 305
  end
end

fn zg_run_source_mutants to void
  zg_run_m1
  zg_run_m2

  zg_mut_reset
  if zg_mut_patch zg_p_dom_old zg_p_dom_new
    if zg_mut_compile
      zg_mut_prove_and_honest_verify 0 false 303
    else
      zg_fail 303
    end
  else
    zg_fail 303
  end

  zg_mut_reset
  if zg_mut_patch zg_p_ord_old zg_p_ord_new
    if zg_mut_compile
      zg_mut_prove_and_honest_verify 0 false 304
    else
      zg_fail 304
    end
  else
    zg_fail 304
  end

  zg_run_m5
end

fn zg_run_omc_suite to bool
  if not zg_verify_omc_pin
    zg_werr zg_e_pin
    ret false
  end
  srcl = zg_build_stark_src
  zg_chk gt srcl 10000 1
  if le srcl 10000
    ret true
  end

  c1 = zg_compile_src zg_f_src zg_f_b1 zg_f_e1
  c2 = zg_compile_src zg_f_src zg_f_b2 zg_f_e2
  zg_chk and eq c1 0 eq c2 0 2
  zp = zg_set_pa_scr zg_f_e1
  es1 = zg_stat_pa_size
  zp = zg_set_pa_scr zg_f_e2
  es2 = zg_stat_pa_size
  zg_chk and eq es1 0 eq es2 0 3
  sz1 = zg_hash_scr_file zg_f_b1 1
  sz2 = zg_hash_scr_file zg_f_b2 2
  det_ok = and gt sz1 10000 eq sz1 sz2
  for j ulong 32
    if ne get zg_h1 j get zg_h2 j
      det_ok = false
    end
  end
  if det_ok
    put zg_cmp_ok 0 1
  end
  zg_chk det_ok 4
  zg_chk zg_check_static_elf zg_f_b1 5

  zg_run_positive true
  zg_set_bin_scr zg_f_b2
  zg_run_container_attacks
  zg_run_source_mutants
  ret true
end

fn main to int
  put zg_checks 0 0
  put zg_ctrls 0 0
  put zg_caught 0 0
  put zg_mut_kills 0 0
  put zg_fails 0 0
  put zg_cmp_ok 0 0

  ac = ulong argcnt
  if eq ac 4
    put zg_omc_l 0 zg_arg_to_glob 1 0
    put zg_root_l 0 zg_arg_to_glob 2 1
    put zg_scr_l 0 zg_arg_to_glob 3 2
    if or eq get zg_omc_l 0 0 or eq get zg_root_l 0 0 eq get zg_scr_l 0 0
      zg_werr zg_u_msg
      ret ZG_ERR_ARG
    end
    z = makedir zg_scr 0 get zg_scr_l 0 493
    if not zg_run_omc_suite
      ret ZG_ERR_PIN
    end
  else
    if eq ac 3
      put zg_bin_l 0 zg_arg_to_glob 1 3
      put zg_scr_l 0 zg_arg_to_glob 2 2
      if or eq get zg_bin_l 0 0 eq get zg_scr_l 0 0
        zg_werr zg_u_msg
        ret ZG_ERR_ARG
      end
      z = makedir zg_scr 0 get zg_scr_l 0 493
      zg_run_positive false
      zg_run_container_attacks
    else
      if eq ac 1
        for i ulong len zg_def_bin
          put zg_bin i get zg_def_bin i
        end
        put zg_bin_l 0 len zg_def_bin
        for i ulong len zg_def_scr
          put zg_scr i get zg_def_scr i
        end
        put zg_scr_l 0 len zg_def_scr
        if ne stat zg_bin 0 get zg_bin_l 0 zg_stat 0 128 0
          zg_werr zg_u_msg
          ret ZG_ERR_ARG
        end
        z = makedir zg_scr 0 get zg_scr_l 0 493
        zg_run_positive false
        zg_run_container_attacks
      else
        zg_werr zg_u_msg
        ret ZG_ERR_ARG
      end
    end
  end

  if ne get zg_fails 0 0
    ret 1
  end
  if ne get zg_caught 0 get zg_ctrls 0
    ret 1
  end
  zg_wrt zg_m_p1
  zg_num get zg_checks 0
  zg_wrt zg_m_p2
  zg_num get zg_ctrls 0
  zg_wrt zg_m_p3
  zg_num get zg_caught 0
  zg_wrt zg_m_p4
  zg_num get zg_mut_kills 0
  zg_wrt zg_m_p5
  zg_num get zg_cmp_ok 0
  zg_wrt zg_m_p6
  ret ZG_OK
end

note ==== Section 3: Output, Encoding & CLI Helpers ====

fn zk_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn zk_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn zk_u64 v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put zk_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 zk_dig p sub 24 p
      ret
    end
  end
end

fn zk_hex_dig b uchar to void
  hi = shr b 4
  lo = and b 15
  hc = uchar add 48 hi
  if ge hi 10
    hc = uchar add 87 hi
  end
  lc = uchar add 48 lo
  if ge lo 10
    lc = uchar add 87 lo
  end
  put zk_dig 0 hc
  put zk_dig 1 lc
  z = write 1 zk_dig 0 2
end

fn zk_hex32_roots idx ulong to void
  base = mul idx 32
  for i ulong 32
    zk_hex_dig get zk_roots add base i
  end
end

fn zk_hex32_sh to void
  for i ulong 32
    zk_hex_dig get sh_dig i
  end
end

fn zk_put_u16 p ulong v ulong to void
  put zk_buf p uchar and v 255
  put zk_buf add p 1 uchar and shr v 8 255
end

fn zk_get_u16 p ulong to ulong
  b0 = ulong get zk_buf p
  b1 = ulong get zk_buf add p 1
  ret or b0 shl b1 8
end

fn zk_put_u32 p ulong v ulong to void
  for i ulong 4
    put zk_buf add p i uchar and shr v mul i 8 255
  end
end

fn zk_get_u32 p ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get zk_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn zk_put_u64 p ulong v ulong to void
  for i ulong 8
    put zk_buf add p i uchar and shr v mul i 8 255
  end
end

fn zk_get_u64 p ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get zk_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn zk_put_u64_sh p ulong v ulong to void
  for i ulong 8
    put sh_dat add p i uchar and shr v mul i 8 255
  end
end

fn zk_arg_eq idx ulong lit view uchar * to bool
  rn = argread idx zk_arg 0 1020
  if ne rn long len lit
    ret false
  end
  for i ulong len lit bound 64
    if ne get zk_arg i get lit i
      ret false
    end
  end
  ret true
end

fn zk_parse_u64 idx ulong to bool
  rn = argread idx zk_arg 0 64
  if le rn 0
    ret false
  end
  v = ulong 0
  for i ulong ulong rn bound 64
    ch = ulong get zk_arg i
    if or lt ch 48 gt ch 57
      ret false
    end
    d = sub ch 48
    lim = div sub 0xffffffffffffffff d 10
    if gt v lim
      ret false
    end
    v = add mul v 10 d
  end
  put zk_parsed_u64 0 v
  ret true
end

fn zk_arg_to_path idx ulong to bool
  rn = argread idx zk_arg 0 1020
  if le rn 0
    ret false
  end
  u = ulong rn
  for i ulong u bound 1024
    put zk_path i get zk_arg i
  end
  put zk_path_l 0 u
  ret true
end

note ==== Section 4: Exact Goldilocks Prime Field (p = 2^64 - 2^32 + 1) ====

fn gl_is_canon a ulong to bool
  ret lt a GL_P
end

fn gl_add a ulong b ulong to ulong
  py = sub GL_P b
  if ge a py
    ret sub a py
  end
  ret add a b
end

fn gl_sub a ulong b ulong to ulong
  if ge a b
    ret sub a b
  end
  ret sub GL_P sub b a
end

fn gl_neg a ulong to ulong
  if eq a 0
    ret 0
  end
  ret sub GL_P a
end

fn gl_reduce128 lo ulong hi ulong to ulong
  h0 = and hi GL_EPS
  h1 = shr hi 32
  r1 = lo
  if ge lo h1
    r1 = sub lo h1
    if ge r1 GL_P
      r1 = sub r1 GL_P
    end
  else
    r1 = sub GL_P sub h1 lo
  end
  t2 = mul h0 GL_EPS
  ret gl_add r1 t2
end

fn gl_mul a ulong b ulong to ulong
  p00 = mul and a GL_EPS and b GL_EPS
  p01 = mul and a GL_EPS shr b 32
  p10 = mul shr a 32 and b GL_EPS
  p11 = mul shr a 32 shr b 32
  t = shr p00 32
  t = add t and p01 GL_EPS
  t = add t and p10 GL_EPS
  lo = or and p00 GL_EPS shl and t GL_EPS 32
  hi = add p11 shr p01 32
  hi = add hi shr p10 32
  hi = add hi shr t 32
  ret gl_reduce128 lo hi
end

fn gl_pow base ulong e ulong to ulong
  res = ulong 1
  b = base
  k = e
  for i ulong 64
    if eq and k 1 1
      res = gl_mul res b
    end
    b = gl_mul b b
    k = shr k 1
    if eq k 0
      ret res
    end
  end
  ret res
end

fn gl_inv a ulong to ulong
  if eq a 0
    trap 8
  end
  ret gl_pow a sub GL_P 2
end

note ==== Section 5: Number Theoretic Transform over zk_tmp ====

fn ntt_bitrev_tmp n ulong logn ulong to void
  for i ulong n bound 256
    r = ulong 0
    x = i
    for b ulong logn bound 10
      r = or shl r 1 and x 1
      x = shr x 1
    end
    if lt i r
      tv = get zk_tmp i
      put zk_tmp i get zk_tmp r
      put zk_tmp r tv
    end
  end
end

fn ntt_bstep_tmp start ulong half ulong wlen ulong to void
  w = ulong 1
  for j ulong half bound 256
    idx0 = add start j
    idx1 = add idx0 half
    u = get zk_tmp idx0
    v = gl_mul get zk_tmp idx1 w
    put zk_tmp idx0 gl_add u v
    put zk_tmp idx1 gl_sub u v
    w = gl_mul w wlen
  end
end

fn ntt_fwd_tmp n ulong logn ulong root ulong to void
  ntt_bitrev_tmp n logn
  len_cur = ulong 2
  while le len_cur n bound 12
    half = shr len_cur 1
    wlen = gl_pow root div n len_cur
    start = ulong 0
    while lt start n bound 256
      ntt_bstep_tmp start half wlen
      start = add start len_cur
    end
    len_cur = shl len_cur 1
  end
end

fn ntt_inv_tmp n ulong logn ulong inv_root ulong inv_n ulong to void
  ntt_fwd_tmp n logn inv_root
  for i ulong n bound 256
    put zk_tmp i gl_mul get zk_tmp i inv_n
  end
end

fn poly_eval_tmp n ulong z ulong to ulong
  acc = ulong 0
  i = n
  while gt i 0 bound 256
    i = sub i 1
    acc = gl_add gl_mul acc z get zk_tmp i
  end
  ret acc
end

fn poly_eval_cx z ulong to ulong
  acc = ulong 0
  i = ZK_N
  while gt i 0 bound 64
    i = sub i 1
    acc = gl_add gl_mul acc z get zk_cx i
  end
  ret acc
end

fn poly_eval_cy z ulong to ulong
  acc = ulong 0
  i = ZK_N
  while gt i 0 bound 64
    i = sub i 1
    acc = gl_add gl_mul acc z get zk_cy i
  end
  ret acc
end

fn poly_eval_rc z ulong to ulong
  acc = ulong 0
  i = ZK_N
  while gt i 0 bound 64
    i = sub i 1
    acc = gl_add gl_mul acc z get zk_rc_c i
  end
  ret acc
end

note ==== Section 6: Domain-Separated SHA-256 Merkle Trees ====

fn mk_init_layout to void
  put zk_dom_n 0 256
  put zk_dom_n 1 128
  put zk_dom_n 2 64
  put zk_dom_n 3 32
  put zk_dom_n 4 16
  put zk_dom_n 5 8

  put zk_dom_d 0 8
  put zk_dom_d 1 7
  put zk_dom_d 2 6
  put zk_dom_d 3 5
  put zk_dom_d 4 4
  put zk_dom_d 5 3

  put zk_dom_s 0 ZK_COSET_S
  put zk_dom_w 0 ZK_W256
  for r ulong 5
    s_prev = get zk_dom_s r
    w_prev = get zk_dom_w r
    put zk_dom_s add r 1 gl_mul s_prev s_prev
    put zk_dom_w add r 1 gl_mul w_prev w_prev
  end

  put zk_tree_off 0 0
  put zk_tree_off 1 16384
  put zk_tree_off 2 32768
  put zk_tree_off 3 40960
  put zk_tree_off 4 45056
  put zk_tree_off 5 47104
  put zk_tree_off 6 48128
end

fn mk_copy_sh_to_h to void
  for i ulong 32
    put zk_mk_h i get sh_dig i
  end
end

fn mk_leaf_tr j ulong xv ulong yv ulong to void
  n = len zk_t_mk_tr
  for i ulong n bound 32
    put sh_dat i get zk_t_mk_tr i
  end
  zk_put_u64_sh n j
  zk_put_u64_sh add n 8 xv
  zk_put_u64_sh add n 16 yv
  sh_all add n 24
  mk_copy_sh_to_h
end

fn mk_leaf_cp j ulong cv ulong to void
  n = len zk_t_mk_cp
  for i ulong n bound 32
    put sh_dat i get zk_t_mk_cp i
  end
  zk_put_u64_sh n j
  zk_put_u64_sh add n 8 cv
  sh_all add n 16
  mk_copy_sh_to_h
end

fn mk_leaf_fr r ulong j ulong fv ulong to void
  n = len zk_t_mk_fr
  for i ulong n bound 32
    put sh_dat i get zk_t_mk_fr i
  end
  put sh_dat n uchar r
  zk_put_u64_sh add n 1 j
  zk_put_u64_sh add n 9 fv
  sh_all add n 17
  mk_copy_sh_to_h
end

fn mk_node_hash lo_off ulong hi_off ulong to void
  n = len zk_t_mk_nd
  for i ulong n bound 32
    put sh_dat i get zk_t_mk_nd i
  end
  for i ulong 32
    put sh_dat add n i get zk_trees add lo_off i
    put sh_dat add add n 32 i get zk_trees add hi_off i
  end
  sh_all add n 64
end

fn mk_node_pair cur_right bool buf_off ulong to void
  n = len zk_t_mk_nd
  for i ulong n bound 32
    put sh_dat i get zk_t_mk_nd i
  end
  for i ulong 32
    sb = get zk_buf add buf_off i
    cb = get zk_mk_cur i
    if cur_right
      put sh_dat add n i sb
      put sh_dat add add n 32 i cb
    else
      put sh_dat add n i cb
      put sh_dat add add n 32 i sb
    end
  end
  sh_all add n 64
  for i ulong 32
    put zk_mk_cur i get sh_dig i
  end
end

fn mk_put_leaf tid ulong j ulong to void
  nleaves = ZK_D
  if gt tid 1
    nleaves = get zk_dom_n sub tid 1
  end
  base = get zk_tree_off tid
  off = add base mul add nleaves j 32
  for i ulong 32
    put zk_trees add off i get zk_mk_h i
  end
end

fn mk_build tid ulong nleaves ulong to void
  base = get zk_tree_off tid
  i = nleaves
  while gt i 1 bound 512
    i = sub i 1
    lo_off = add base mul mul i 2 32
    hi_off = add base mul add mul i 2 1 32
    mk_node_hash lo_off hi_off
    dst = add base mul i 32
    for b ulong 32
      put zk_trees add dst b get sh_dig b
    end
  end
  rbase = mul tid 32
  n1_off = add base 32
  for b ulong 32
    put zk_roots add rbase b get zk_trees add n1_off b
  end
end

fn mk_copy_32_to_buf dst ulong src ulong to void
  for b ulong 32
    put zk_buf add dst b get zk_trees add src b
  end
end

fn mk_write_path tid ulong nleaves ulong depth ulong j ulong buf_off ulong to ulong
  base = get zk_tree_off tid
  node = add nleaves j
  pos = buf_off
  for lv ulong depth bound 12
    sib = xor node 1
    mk_copy_32_to_buf pos add base mul sib 32
    pos = add pos 32
    node = shr node 1
  end
  ret pos
end

fn mk_verify_path rtid ulong depth ulong j ulong buf_off ulong to bool
  for b ulong 32
    put zk_mk_cur b get zk_mk_h b
  end
  idx = j
  pos = buf_off
  for lv ulong depth bound 12
    mk_node_pair eq and idx 1 1 pos
    pos = add pos 32
    idx = shr idx 1
  end
  rbase = mul rtid 32
  for b ulong 32
    if ne get zk_mk_cur b get zk_roots add rbase b
      ret false
    end
  end
  ret true
end

note ==== Section 7: Domain-Separated Fiat-Shamir Transcript ====

fn fs_init to void
  n = len zk_t_fs_init
  for i ulong n bound 64
    put sh_dat i get zk_t_fs_init i
  end
  sh_all n
  for i ulong 32
    put zk_fs_st i get sh_dig i
  end
end

fn fs_absorb tag ulong dlen ulong to void
  n = len zk_t_fs_abs
  for i ulong n bound 32
    put sh_dat i get zk_t_fs_abs i
  end
  for i ulong 32
    put sh_dat add n i get zk_fs_st i
  end
  p = add n 32
  put sh_dat p uchar tag
  zk_put_u64_sh add p 1 dlen
  p = add p 9
  for i ulong dlen bound 256
    put sh_dat add p i get zk_fs_buf i
  end
  sh_all add p dlen
  for i ulong 32
    put zk_fs_st i get sh_dig i
  end
end

fn fs_put_u64_buf off ulong v ulong to void
  for i ulong 8
    put zk_fs_buf add off i uchar and shr v mul i 8 255
  end
end

fn fs_absorb_root tag ulong rtid ulong to void
  rbase = mul rtid 32
  for i ulong 32
    put zk_fs_buf i get zk_roots add rbase i
  end
  fs_absorb tag 32
end

fn fs_step to void
  n = len zk_t_fs_stp
  for i ulong n bound 32
    put sh_dat i get zk_t_fs_stp i
  end
  for i ulong 32
    put sh_dat add n i get zk_fs_st i
    put sh_dat add add n 32 i get sh_dig i
  end
  sh_all add n 64
  for i ulong 32
    put zk_fs_st i get sh_dig i
  end
end

fn fs_squeeze_fe to ulong
  n = len zk_t_fs_sqz
  for ctr ulong 64
    for i ulong n bound 32
      put sh_dat i get zk_t_fs_sqz i
    end
    for i ulong 32
      put sh_dat add n i get zk_fs_st i
    end
    zk_put_u64_sh add n 32 ctr
    sh_all add n 40
    v = ulong 0
    for j ulong 8
      b = ulong get sh_dig j
      v = or v shl b mul j 8
    end
    if lt v GL_P
      fs_step
      ret v
    end
  end
  trap 8
end

fn fs_zeta_ok z ulong to bool
  if eq z 0
    ret false
  end
  if eq gl_pow z ZK_N 1
    ret false
  end
  qs = gl_mul z ZK_INV_S
  if eq gl_pow qs ZK_D 1
    ret false
  end
  ret true
end

fn fs_squeeze_zeta to ulong
  for tries ulong 64
    z = fs_squeeze_fe
    if fs_zeta_ok z
      ret z
    end
  end
  trap 8
end

fn fs_absorb_public to void
  fs_put_u64_buf 0 ZK_N
  fs_put_u64_buf 8 ZK_D
  fs_put_u64_buf 16 ZK_Q
  for i ulong 6
    fs_put_u64_buf add 24 mul i 8 get zk_stmt i
  end
  fs_absorb FS_TAG_PUBLIC 72
end

fn fs_absorb_ood to void
  for i ulong 5
    fs_put_u64_buf mul i 8 get zk_ood i
  end
  fs_absorb FS_TAG_OOD 40
end

fn fs_absorb_final to void
  for i ulong ZK_FINAL_N
    fs_put_u64_buf mul i 8 get zk_final i
  end
  fs_absorb FS_TAG_FRI_FINAL 32
end

note ==== Section 8: AIR Computation & Quotient Evaluation ====

fn air_init_rc c0 ulong delta ulong to void
  cur = c0
  for t ulong ZK_N
    put zk_tmp t cur
    cur = gl_add cur delta
  end
  inv_g = gl_pow ZK_INV_W256 8
  ntt_inv_tmp ZK_N ZK_LOG_N inv_g ZK_INV32
  for t ulong ZK_N
    put zk_rc_c t get zk_tmp t
  end
end

fn air_build_trace x0 ulong y0 ulong c0 ulong delta ulong to void
  x = x0
  y = y0
  c = c0
  for t ulong ZK_N
    put zk_tr_x t x
    put zk_tr_y t y
    y2 = gl_mul y y
    y3 = gl_mul y2 y
    ny = gl_add gl_add y3 x c
    x = y
    y = ny
    c = gl_add c delta
  end
  put zk_stmt 4 get zk_tr_x sub ZK_N 1
  put zk_stmt 5 get zk_tr_y sub ZK_N 1
end

fn air_eval_boundary z ulong xv ulong yv ulong g31 ulong to ulong
  d0 = gl_inv gl_sub z 1
  dlast = gl_inv gl_sub z g31
  acc = gl_mul get zk_alpha 0 gl_mul gl_sub xv get zk_stmt 0 d0
  acc = gl_add acc gl_mul get zk_alpha 1 gl_mul gl_sub yv get zk_stmt 1 d0
  acc = gl_add acc gl_mul get zk_alpha 2 gl_mul gl_sub xv get zk_stmt 4 dlast
  ret gl_add acc gl_mul get zk_alpha 3 gl_mul gl_sub yv get zk_stmt 5 dlast
end

fn air_eval_trans z ulong xv ulong yv ulong xgn ulong ygn ulong rc ulong to ulong
  g31 = gl_pow ZK_G32 sub ZK_N 1
  zh = gl_sub gl_pow z ZK_N 1
  dzh = gl_mul gl_sub z g31 gl_inv zh
  t0 = gl_sub xgn yv
  y3 = gl_mul gl_mul yv yv yv
  t1 = gl_sub ygn gl_add gl_add y3 xv rc
  comb = gl_add gl_mul get zk_alpha 4 t0 gl_mul get zk_alpha 5 t1
  ret gl_mul comb dzh
end

fn air_eval_ood_point z ulong to ulong
  g31 = gl_pow ZK_G32 sub ZK_N 1
  b = air_eval_boundary z get zk_ood 0 get zk_ood 2 g31
  rcz = poly_eval_rc z
  tr = air_eval_trans z get zk_ood 0 get zk_ood 2 get zk_ood 1 get zk_ood 3 rcz
  ret gl_add b tr
end

fn air_eval_ood_identity to bool
  z = get zk_zeta 0
  if not fs_zeta_ok z
    ret false
  end
  ret eq air_eval_ood_point z get zk_ood 4
end

fn deep_term bi ulong zpow ulong val ulong oodv ulong den ulong to ulong
  w = gl_add get zk_beta bi gl_mul get zk_beta add bi 1 zpow
  q = gl_mul gl_sub val oodv den
  ret gl_mul w q
end

fn deep_eval_f0 z ulong xv ulong yv ulong cv ulong to ulong
  zeta = get zk_zeta 0
  dz = gl_inv gl_sub z zeta
  dgz = gl_inv gl_sub z gl_mul ZK_G32 zeta
  z33 = gl_mul z gl_pow z 32
  acc = deep_term 0 z33 xv get zk_ood 0 dz
  acc = gl_add acc deep_term 2 z33 xv get zk_ood 1 dgz
  acc = gl_add acc deep_term 4 z33 yv get zk_ood 2 dz
  acc = gl_add acc deep_term 6 z33 yv get zk_ood 3 dgz
  acc = gl_add acc deep_term 8 gl_mul z z cv get zk_ood 4 dz
  ret acc
end

fn fri_fold_pair vlo ulong vhi ulong x ulong gam ulong to ulong
  even = gl_mul gl_add vlo vhi ZK_INV2
  diff = gl_sub vlo vhi
  den = gl_inv gl_mul 2 x
  odd = gl_mul diff den
  ret gl_add even gl_mul gam odd
end

note ==== Section 9: Prover Pipeline ====

fn prv_coset_lde_which which ulong to void
  for i ulong ZK_D
    put zk_tmp i 0
  end
  sp = ulong 1
  for i ulong ZK_N
    cv = ulong 0
    if eq which 0
      cv = get zk_cx i
    else
      if eq which 1
        cv = get zk_cy i
      else
        cv = get zk_rc_c i
      end
    end
    put zk_tmp i gl_mul cv sp
    sp = gl_mul sp ZK_COSET_S
  end
  ntt_fwd_tmp ZK_D ZK_LOG_D ZK_W256
  for i ulong ZK_D
    if eq which 0
      put zk_lde_x i get zk_tmp i
    else
      if eq which 1
        put zk_lde_y i get zk_tmp i
      else
        put zk_lde_rc i get zk_tmp i
      end
    end
  end
end

fn prv_eval_comp_point j ulong z ulong g31 ulong to ulong
  xv = get zk_lde_x j
  yv = get zk_lde_y j
  jn = and add j 8 255
  b = air_eval_boundary z xv yv g31
  tr = air_eval_trans z xv yv get zk_lde_x jn get zk_lde_y jn get zk_lde_rc j
  ret gl_add b tr
end

fn prv_check_deg which ulong max_deg ulong to bool
  for i ulong ZK_D
    if eq which 0
      put zk_tmp i get zk_comp i
    else
      put zk_tmp i get zk_f0 i
    end
  end
  ntt_inv_tmp ZK_D ZK_LOG_D ZK_INV_W256 ZK_INV256
  sp_inv = ulong 1
  for i ulong ZK_D
    v = gl_mul get zk_tmp i sp_inv
    if and ge i max_deg ne v 0
      ret false
    end
    sp_inv = gl_mul sp_inv ZK_INV_S
  end
  ret true
end

fn prv_save_fri_layer r ulong half ulong to void
  off = ulong 0
  if eq r 2
    off = 128
  end
  if eq r 3
    off = 192
  end
  if eq r 4
    off = 224
  end
  if eq r 5
    off = 240
  end
  for j ulong half bound 128
    put zk_fri_layers add off j get zk_fri j
  end
end

fn prv_get_fri_layer r ulong idx ulong to ulong
  off = ulong 0
  if eq r 2
    off = 128
  end
  if eq r 3
    off = 192
  end
  if eq r 4
    off = 224
  end
  if eq r 5
    off = 240
  end
  ret get zk_fri_layers add off idx
end

fn prv_stage_trace to void
  air_init_rc get zk_stmt 2 get zk_stmt 3
  air_build_trace get zk_stmt 0 get zk_stmt 1 get zk_stmt 2 get zk_stmt 3

  inv_g = gl_pow ZK_INV_W256 8
  for i ulong ZK_N
    put zk_tmp i get zk_tr_x i
  end
  ntt_inv_tmp ZK_N ZK_LOG_N inv_g ZK_INV32
  for i ulong ZK_N
    put zk_cx i get zk_tmp i
  end

  for i ulong ZK_N
    put zk_tmp i get zk_tr_y i
  end
  ntt_inv_tmp ZK_N ZK_LOG_N inv_g ZK_INV32
  for i ulong ZK_N
    put zk_cy i get zk_tmp i
  end

  prv_coset_lde_which 0
  prv_coset_lde_which 1
  prv_coset_lde_which 2

  for j ulong ZK_D
    mk_leaf_tr j get zk_lde_x j get zk_lde_y j
    mk_put_leaf 0 j
  end
  mk_build 0 ZK_D
end

fn prv_stage_comp to int
  fs_init
  fs_absorb_public
  fs_absorb_root FS_TAG_TR_ROOT 0
  for i ulong 6
    put zk_alpha i fs_squeeze_fe
  end

  g31 = gl_pow ZK_G32 sub ZK_N 1
  z = ZK_COSET_S
  for j ulong ZK_D
    put zk_comp j prv_eval_comp_point j z g31
    z = gl_mul z ZK_W256
  end

  if not prv_check_deg 0 64
    ret ZK_ERR_PROVE
  end

  for j ulong ZK_D
    mk_leaf_cp j get zk_comp j
    mk_put_leaf 1 j
  end
  mk_build 1 ZK_D

  fs_absorb_root FS_TAG_CP_ROOT 1
  zeta = fs_squeeze_zeta
  put zk_zeta 0 zeta

  put zk_ood 0 poly_eval_cx zeta
  put zk_ood 1 poly_eval_cx gl_mul ZK_G32 zeta
  put zk_ood 2 poly_eval_cy zeta
  put zk_ood 3 poly_eval_cy gl_mul ZK_G32 zeta

  for i ulong ZK_D
    put zk_tmp i get zk_comp i
  end
  ntt_inv_tmp ZK_D ZK_LOG_D ZK_INV_W256 ZK_INV256
  sp_inv = ulong 1
  for i ulong ZK_D
    put zk_tmp i gl_mul get zk_tmp i sp_inv
    sp_inv = gl_mul sp_inv ZK_INV_S
  end
  put zk_ood 4 poly_eval_tmp 64 zeta

  if not air_eval_ood_identity
    ret ZK_ERR_PROVE
  end
  ret ZK_OK
end

fn prv_fold_round r ulong to void
  nr = get zk_dom_n r
  half = shr nr 1
  wr = get zk_dom_w r
  gam = get zk_gamma r
  x = get zk_dom_s r
  for j ulong half bound 256
    vlo = get zk_fri j
    vhi = get zk_fri add j half
    put zk_fri_nxt j fri_fold_pair vlo vhi x gam
    x = gl_mul x wr
  end
  for j ulong half bound 256
    put zk_fri j get zk_fri_nxt j
  end
end

fn prv_stage_fri to int
  fs_absorb_ood
  for i ulong 10
    put zk_beta i fs_squeeze_fe
  end
  put zk_gamma 0 fs_squeeze_fe

  z = ZK_COSET_S
  for j ulong ZK_D
    fv = deep_eval_f0 z get zk_lde_x j get zk_lde_y j get zk_comp j
    put zk_f0 j fv
    z = gl_mul z ZK_W256
  end

  if not prv_check_deg 1 64
    ret ZK_ERR_PROVE
  end

  for i ulong ZK_D
    put zk_fri i get zk_f0 i
  end
  for r ulong ZK_ROUNDS
    prv_fold_round r
    half = shr get zk_dom_n r 1
    if lt r 5
      tid = add r 2
      prv_save_fri_layer add r 1 half
      for j ulong half bound 256
        mk_leaf_fr add r 1 j get zk_fri j
        mk_put_leaf tid j
      end
      mk_build tid half
      fs_absorb_root add FS_TAG_FRI_BASE add r 1 tid
      if lt r 4
        put zk_gamma add r 1 fs_squeeze_fe
      end
    end
  end

  for j ulong ZK_FINAL_N
    put zk_final j get zk_fri j
  end
  for j ulong 3
    if ne get zk_final j get zk_final add j 1
      ret ZK_ERR_PROVE
    end
  end

  fs_absorb_final
  for q ulong ZK_Q
    put zk_qidx q and fs_squeeze_fe 255
  end
  ret ZK_OK
end

fn prv_emit_query_r0 lo0 ulong hi0 ulong pos ulong to ulong
  p = pos
  zk_put_u64 p get zk_lde_x lo0
  zk_put_u64 add p 8 get zk_lde_y lo0
  zk_put_u64 add p 16 get zk_lde_x hi0
  zk_put_u64 add p 24 get zk_lde_y hi0
  zk_put_u64 add p 32 get zk_comp lo0
  zk_put_u64 add p 40 get zk_comp hi0
  p = add p 48
  p = mk_write_path 0 256 8 lo0 p
  p = mk_write_path 0 256 8 hi0 p
  p = mk_write_path 1 256 8 lo0 p
  p = mk_write_path 1 256 8 hi0 p
  ret p
end

fn prv_emit_query q ulong pos ulong to ulong
  lo0 = and get zk_qidx q 127
  hi0 = add lo0 128
  p = prv_emit_query_r0 lo0 hi0 pos
  cur = lo0
  for k ulong 5
    r = add k 1
    nr = get zk_dom_n r
    half = shr nr 1
    lor = rem cur half
    hir = add lor half
    zk_put_u64 p prv_get_fri_layer r lor
    zk_put_u64 add p 8 prv_get_fri_layer r hir
    p = add p 16
    p = mk_write_path add r 1 nr get zk_dom_d r lor p
    p = mk_write_path add r 1 nr get zk_dom_d r hir p
    cur = lor
  end
  ret p
end

fn prv_emit_container to int
  for i ulong ZK_PROOF_BYTES bound 65536
    put zk_buf i 0
  end
  for i ulong 6
    put zk_buf i get zk_t_magic i
  end
  zk_put_u16 6 1
  zk_put_u32 8 ZK_N
  zk_put_u32 12 ZK_D
  zk_put_u32 16 ZK_ROUNDS
  zk_put_u32 20 ZK_Q
  zk_put_u64 24 ZK_COSET_S
  for i ulong 6
    zk_put_u64 add 32 mul i 8 get zk_stmt i
  end
  for i ulong 32
    put zk_buf add 80 i get zk_roots i
    put zk_buf add 112 i get zk_roots add 32 i
  end
  for i ulong 5
    zk_put_u64 add 144 mul i 8 get zk_ood i
  end
  for r ulong 5
    src = mul add r 2 32
    dst = add 184 mul r 32
    for b ulong 32
      put zk_buf add dst b get zk_roots add src b
    end
  end
  for i ulong ZK_FINAL_N
    zk_put_u64 add 344 mul i 8 get zk_final i
  end

  pos = ZK_HDR_BYTES
  for q ulong ZK_Q
    pos = prv_emit_query q pos
  end
  if ne pos ZK_PROOF_BYTES
    ret ZK_ERR_PROVE
  end
  put zk_bufl 0 pos
  ret ZK_OK
end

fn prv_prove_all to int
  mk_init_layout
  prv_stage_trace
  rc = prv_stage_comp
  if ne rc ZK_OK
    ret rc
  end
  rc = prv_stage_fri
  if ne rc ZK_OK
    ret rc
  end
  ret prv_emit_container
end

note ==== Section 10: Fail-Closed Standalone Verifier ====

fn ver_parse_header flen ulong to int
  if ne flen ZK_PROOF_BYTES
    ret ZK_ERR_FORMAT
  end
  for i ulong 6
    if ne get zk_buf i get zk_t_magic i
      ret ZK_ERR_FORMAT
    end
  end
  if ne zk_get_u16 6 1
    ret ZK_ERR_FORMAT
  end
  if ne zk_get_u32 8 ZK_N
    ret ZK_ERR_FORMAT
  end
  if ne zk_get_u32 12 ZK_D
    ret ZK_ERR_FORMAT
  end
  if ne zk_get_u32 16 ZK_ROUNDS
    ret ZK_ERR_FORMAT
  end
  if ne zk_get_u32 20 ZK_Q
    ret ZK_ERR_FORMAT
  end
  if ne zk_get_u64 24 ZK_COSET_S
    ret ZK_ERR_FORMAT
  end
  for i ulong 6
    v = zk_get_u64 add 32 mul i 8
    if not gl_is_canon v
      ret ZK_ERR_NONCANON
    end
    put zk_stmt i v
    if and eq get zk_exp_mask i 1 ne v get zk_exp_vals i
      ret ZK_ERR_STMT
    end
  end
  for i ulong 32
    put zk_roots i get zk_buf add 80 i
    put zk_roots add 32 i get zk_buf add 112 i
  end
  for i ulong 5
    v = zk_get_u64 add 144 mul i 8
    if not gl_is_canon v
      ret ZK_ERR_NONCANON
    end
    put zk_ood i v
  end
  for r ulong 5
    dst = mul add r 2 32
    src = add 184 mul r 32
    for b ulong 32
      put zk_roots add dst b get zk_buf add src b
    end
  end
  for i ulong ZK_FINAL_N
    v = zk_get_u64 add 344 mul i 8
    if not gl_is_canon v
      ret ZK_ERR_NONCANON
    end
    put zk_final i v
  end
  ret ZK_OK
end

global zk_ver_pos ulong 1
global zk_ver_y ulong 1
global zk_ver_cur ulong 1
global zk_qleaves ulong 6

fn ver_check_query_r0 lo0 ulong hi0 ulong to int
  p = get zk_ver_pos 0
  for i ulong 6
    v = zk_get_u64 add p mul i 8
    if not gl_is_canon v
      ret ZK_ERR_NONCANON
    end
    put zk_qleaves i v
  end
  p = add p 48

  mk_leaf_tr lo0 get zk_qleaves 0 get zk_qleaves 1
  if not mk_verify_path 0 8 lo0 p
    ret ZK_ERR_MERKLE
  end
  p = add p 256
  mk_leaf_tr hi0 get zk_qleaves 2 get zk_qleaves 3
  if not mk_verify_path 0 8 hi0 p
    ret ZK_ERR_MERKLE
  end
  p = add p 256
  mk_leaf_cp lo0 get zk_qleaves 4
  if not mk_verify_path 1 8 lo0 p
    ret ZK_ERR_MERKLE
  end
  p = add p 256
  mk_leaf_cp hi0 get zk_qleaves 5
  if not mk_verify_path 1 8 hi0 p
    ret ZK_ERR_MERKLE
  end
  put zk_ver_pos 0 add p 256

  xpt = gl_mul ZK_COSET_S gl_pow ZK_W256 lo0
  f0_lo = deep_eval_f0 xpt get zk_qleaves 0 get zk_qleaves 1 get zk_qleaves 4
  f0_hi = deep_eval_f0 gl_neg xpt get zk_qleaves 2 get zk_qleaves 3 get zk_qleaves 5
  put zk_ver_y 0 fri_fold_pair f0_lo f0_hi xpt get zk_gamma 0
  put zk_ver_cur 0 lo0
  ret ZK_OK
end

fn ver_check_query_round r ulong to int
  half = shr get zk_dom_n r 1
  dr = get zk_dom_d r
  lor = rem get zk_ver_cur 0 half
  p = get zk_ver_pos 0
  for i ulong 2
    v = zk_get_u64 add p mul i 8
    if not gl_is_canon v
      ret ZK_ERR_NONCANON
    end
    put zk_qleaves i v
  end
  p = add p 16
  mk_leaf_fr r lor get zk_qleaves 0
  if not mk_verify_path add r 1 dr lor p
    ret ZK_ERR_MERKLE
  end
  p = add p mul dr 32
  mk_leaf_fr r add lor half get zk_qleaves 1
  if not mk_verify_path add r 1 dr add lor half p
    ret ZK_ERR_MERKLE
  end
  put zk_ver_pos 0 add p mul dr 32

  if eq get zk_ver_cur 0 lor
    if ne get zk_ver_y 0 get zk_qleaves 0
      ret ZK_ERR_FRI
    end
  else
    if ne get zk_ver_y 0 get zk_qleaves 1
      ret ZK_ERR_FRI
    end
  end

  xr = gl_mul get zk_dom_s r gl_pow get zk_dom_w r lor
  put zk_ver_y 0 fri_fold_pair get zk_qleaves 0 get zk_qleaves 1 xr get zk_gamma r
  put zk_ver_cur 0 lor
  ret ZK_OK
end

fn ver_check_query q ulong to int
  lo0 = and get zk_qidx q 127
  hi0 = add lo0 128
  rc = ver_check_query_r0 lo0 hi0
  if ne rc ZK_OK
    ret rc
  end
  for k ulong 5
    rc = ver_check_query_round add k 1
    if ne rc ZK_OK
      ret rc
    end
  end
  cur = get zk_ver_cur 0
  if ne get zk_ver_y 0 get zk_final cur
    ret ZK_ERR_FRI
  end
  ret ZK_OK
end

fn ver_verify_all flen ulong to int
  mk_init_layout
  hc = ver_parse_header flen
  if ne hc ZK_OK
    ret hc
  end

  for j ulong 3
    if ne get zk_final j get zk_final add j 1
      ret ZK_ERR_FRI
    end
  end

  air_init_rc get zk_stmt 2 get zk_stmt 3

  fs_init
  fs_absorb_public
  fs_absorb_root FS_TAG_TR_ROOT 0
  for i ulong 6
    put zk_alpha i fs_squeeze_fe
  end
  fs_absorb_root FS_TAG_CP_ROOT 1
  zeta = fs_squeeze_zeta
  put zk_zeta 0 zeta

  if not air_eval_ood_identity
    ret ZK_ERR_OOD
  end

  fs_absorb_ood
  for i ulong 10
    put zk_beta i fs_squeeze_fe
  end
  put zk_gamma 0 fs_squeeze_fe

  for r ulong 5
    fs_absorb_root add FS_TAG_FRI_BASE add r 1 add r 2
    if lt r 4
      put zk_gamma add r 1 fs_squeeze_fe
    end
  end
  fs_absorb_final

  for q ulong ZK_Q
    put zk_qidx q and fs_squeeze_fe 255
  end

  put zk_ver_pos 0 ZK_HDR_BYTES
  for q ulong ZK_Q
    rc = ver_check_query q
    if ne rc ZK_OK
      ret rc
    end
  end

  if ne get zk_ver_pos 0 ZK_PROOF_BYTES
    ret ZK_ERR_FORMAT
  end
  ret ZK_OK
end

note ==== Section 11: Selftest & File I/O ====

fn zk_run_selftest to int
  pm1 = sub GL_P 1
  if ne gl_mul pm1 pm1 1
    ret ZK_ERR_PROVE
  end
  if ne gl_add pm1 1 0
    ret ZK_ERR_PROVE
  end
  if ne gl_add pm1 pm1 sub GL_P 2
    ret ZK_ERR_PROVE
  end
  if ne gl_sub 0 1 pm1
    ret ZK_ERR_PROVE
  end
  if ne gl_mul shl ulong 1 32 shl ulong 1 32 GL_EPS
    ret ZK_ERR_PROVE
  end
  x = ulong 1234567890123456789
  if ne gl_mul x gl_inv x 1
    ret ZK_ERR_PROVE
  end
  if ne gl_pow ZK_W256 128 pm1
    ret ZK_ERR_PROVE
  end
  if ne gl_pow ZK_W256 256 1
    ret ZK_ERR_PROVE
  end
  if ne gl_pow ZK_W256 8 ZK_G32
    ret ZK_ERR_PROVE
  end
  if ne gl_pow ZK_G32 16 pm1
    ret ZK_ERR_PROVE
  end
  if ne gl_pow ZK_G32 32 1
    ret ZK_ERR_PROVE
  end
  if eq gl_pow ZK_COSET_S 256 1
    ret ZK_ERR_PROVE
  end
  if or ne gl_mul 2 ZK_INV2 1 ne gl_mul 32 ZK_INV32 1
    ret ZK_ERR_PROVE
  end
  if or ne gl_mul 256 ZK_INV256 1 ne gl_mul ZK_W256 ZK_INV_W256 1
    ret ZK_ERR_PROVE
  end
  if ne gl_mul ZK_COSET_S ZK_INV_S 1
    ret ZK_ERR_PROVE
  end

  for i ulong 32
    put zk_tmp i add mul i 104729 7
  end
  ntt_fwd_tmp 32 5 ZK_G32
  inv_g = gl_pow ZK_INV_W256 8
  ntt_inv_tmp 32 5 inv_g ZK_INV32
  for i ulong 32
    if ne get zk_tmp i add mul i 104729 7
      ret ZK_ERR_PROVE
    end
  end

  zk_wrt zk_m_self
  ret ZK_OK
end

fn zk_read_file to long
  pl = get zk_path_l 0
  if eq pl 0
    ret -1
  end
  fd = fopen zk_path 0 pl 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 65536 bound 256
    rn = read int fd zk_buf tot sub 65536 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      put zk_bufl 0 tot
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn zk_write_file n ulong to bool
  pl = get zk_path_l 0
  if eq pl 0
    ret false
  end
  fd = fopen zk_path 0 pl 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 256
    wn = write int fd zk_buf off sub n off
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn zk_hash_buf n ulong to void
  for i ulong n bound 65536
    put sh_dat i get zk_buf i
  end
  sh_all n
end

fn zk_parse_flag_val i ulong to bool
  if not zk_parse_u64 add i 1
    ret false
  end
  uv = get zk_parsed_u64 0
  if not gl_is_canon uv
    ret false
  end
  if zk_arg_eq i zk_f_x0
    put zk_stmt 0 uv
    put zk_exp_mask 0 1
    put zk_exp_vals 0 uv
    ret true
  end
  if zk_arg_eq i zk_f_y0
    put zk_stmt 1 uv
    put zk_exp_mask 1 1
    put zk_exp_vals 1 uv
    ret true
  end
  if zk_arg_eq i zk_f_c0
    put zk_stmt 2 uv
    put zk_exp_mask 2 1
    put zk_exp_vals 2 uv
    ret true
  end
  if zk_arg_eq i zk_f_del
    put zk_stmt 3 uv
    put zk_exp_mask 3 1
    put zk_exp_vals 3 uv
    ret true
  end
  if zk_arg_eq i zk_f_ox
    put zk_exp_mask 4 1
    put zk_exp_vals 4 uv
    ret true
  end
  if zk_arg_eq i zk_f_oy
    put zk_exp_mask 5 1
    put zk_exp_vals 5 uv
    ret true
  end
  ret false
end

fn zk_parse_args to bool
  ac = ulong argcnt
  if lt ac 2
    ret false
  end
  if or zk_arg_eq 1 zk_c_help zk_arg_eq 1 zk_c_h
    zk_wrt zk_m_use
    exit 0
  end
  if zk_arg_eq 1 zk_c_selftest
    put zk_cmd 0 1
    ret eq ac 2
  end
  if zk_arg_eq 1 zk_c_prove
    put zk_cmd 0 2
  else
    if zk_arg_eq 1 zk_c_verify
      put zk_cmd 0 3
    else
      if zk_arg_eq 1 zk_c_inspect
        put zk_cmd 0 4
      else
        ret false
      end
    end
  end

  put zk_stmt 0 3
  put zk_stmt 1 5
  put zk_stmt 2 11
  put zk_stmt 3 7
  for i ulong 6
    put zk_exp_mask i 0
    put zk_exp_vals i 0
  end
  put zk_have_in 0 0
  put zk_have_out 0 0

  i = ulong 2
  while lt i ac bound 32
    if ge add i 1 ac
      ret false
    end
    if zk_arg_eq i zk_f_in
      if not zk_arg_to_path add i 1
        ret false
      end
      put zk_have_in 0 1
      i = add i 2
      continue
    end
    if zk_arg_eq i zk_f_out
      if not zk_arg_to_path add i 1
        ret false
      end
      put zk_have_out 0 1
      i = add i 2
      continue
    end
    if not zk_parse_flag_val i
      ret false
    end
    i = add i 2
  end
  ret true
end

fn zk_print_fail code int to int
  zk_werr zk_m_fail
  x = ulong code
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put zk_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 2 zk_dig p sub 24 p
      z2 = write 2 zk_nl 0 1
      ret code
    end
  end
  ret code
end

fn main to int
  if not zk_parse_args
    zk_werr zk_m_use
    ret ZK_ERR_IO
  end
  cmd = get zk_cmd 0
  if eq cmd 1
    rc = zk_run_selftest
    if ne rc ZK_OK
      ret zk_print_fail rc
    end
    ret ZK_OK
  end

  if eq cmd 2
    if eq get zk_have_out 0 0
      zk_werr zk_m_use
      ret ZK_ERR_IO
    end
    rc = prv_prove_all
    if ne rc ZK_OK
      ret zk_print_fail rc
    end
    if not zk_write_file ZK_PROOF_BYTES
      ret zk_print_fail ZK_ERR_IO
    end
    zk_hash_buf ZK_PROOF_BYTES
    zk_wrt zk_m_prv1
    zk_u64 get zk_stmt 4
    zk_wrt zk_m_prv2
    zk_u64 get zk_stmt 5
    zk_wrt zk_m_prv3
    zk_hex32_sh
    zk_wrt zk_nl
    ret ZK_OK
  end

  if eq get zk_have_in 0 0
    zk_werr zk_m_use
    ret ZK_ERR_IO
  end
  fl = zk_read_file
  if lt fl 0
    ret zk_print_fail ZK_ERR_IO
  end
  ufl = ulong fl

  if eq cmd 3
    rc = ver_verify_all ufl
    if ne rc ZK_OK
      ret zk_print_fail rc
    end
    zk_hash_buf ufl
    zk_wrt zk_m_ver1
    zk_u64 get zk_stmt 4
    zk_wrt zk_m_prv2
    zk_u64 get zk_stmt 5
    zk_wrt zk_m_prv3
    zk_hex32_sh
    zk_wrt zk_nl
    ret ZK_OK
  end

  hc = ver_parse_header ufl
  if ne hc ZK_OK
    ret zk_print_fail hc
  end
  zk_wrt zk_m_ins1
  zk_wrt zk_m_ins2
  zk_u64 get zk_stmt 0
  zk_wrt zk_m_ins3
  zk_u64 get zk_stmt 1
  zk_wrt zk_m_ins4
  zk_u64 get zk_stmt 2
  zk_wrt zk_m_ins5
  zk_u64 get zk_stmt 3
  zk_wrt zk_m_ins_ox
  zk_u64 get zk_stmt 4
  zk_wrt zk_m_prv2
  zk_u64 get zk_stmt 5
  zk_wrt zk_nl
  zk_wrt zk_m_ins6
  zk_hex32_roots 0
  zk_wrt zk_nl
  zk_wrt zk_m_ins7
  zk_hex32_roots 1
  zk_wrt zk_nl
  zk_wrt zk_m_ins8
  zk_u64 get zk_final 0
  zk_wrt zk_nl
  ret ZK_OK
end

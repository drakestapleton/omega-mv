note ==== Section 1: Constants, Exit Codes & Wire Layout ====

const GL_P ulong 0xffffffff00000001
const GL_EPS ulong 0xffffffff

const ZK_N ulong 32
const ZK_LOG_N ulong 5
const ZK_D ulong 256
const ZK_LOG_D ulong 8
const ZK_ROUNDS ulong 6
const ZK_FINAL_N ulong 4
const ZK_Q ulong 16

const ZK_COSET_S ulong 7
const ZK_W256 ulong 13797081185216407910
const ZK_INV_W256 ulong 2117504431143841456
const ZK_G32 ulong 70368744161280
const ZK_INV2 ulong 9223372034707292161
const ZK_INV32 ulong 17870283317245378561
const ZK_INV256 ulong 18374686475393433601
const ZK_INV_S ulong 2635249152773512046

const ZK_HDR_BYTES ulong 376
const ZK_PROOF_BYTES ulong 44408

const ZK_OK int 0
const ZK_ERR_IO int 1
const ZK_ERR_FORMAT int 60
const ZK_ERR_NONCANON int 61
const ZK_ERR_STMT int 62
const ZK_ERR_OOD int 63
const ZK_ERR_MERKLE int 64
const ZK_ERR_FRI int 65
const ZK_ERR_PROVE int 66

const FS_TAG_PUBLIC ulong 1
const FS_TAG_TR_ROOT ulong 2
const FS_TAG_CP_ROOT ulong 3
const FS_TAG_OOD ulong 4
const FS_TAG_FRI_BASE ulong 10
const FS_TAG_FRI_FINAL ulong 20


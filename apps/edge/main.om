note aien-edge CLI: reads one HTTP/1.1 request line from stdin, emits full HTTP response to stdout.
note Compose: si/directives/om2.om + apps/edge/lib.om + apps/edge/main.om

text edge_cli_err "aien-edge: failed to process request\n"

fn edge_write_all fd int buf view uchar * n ulong to bool
done = ulong 0
while lt done n bound 65536
k = write fd buf done sub n done
if le k 0
ret false
end
done = add done ulong k
end
ret true
end

fn main to int
inbuf = new uchar 2048 0
k = read 0 inbuf 0 2048
if le k 0
w = edge_write_all 2 edge_cli_err len edge_cli_err
if not w
ret 2
end
ret 1
end
resp = new uchar 8192 0
meta = new EdgeResp 0 0 0 0 0
n = edge_handle_request part inbuf 0 ulong k EDGE_SCHEME_HTTPS resp meta
if lt n 0
w = edge_write_all 2 edge_cli_err len edge_cli_err
if not w
ret 2
end
ret 1
end
ok = edge_write_all 1 resp ulong n
if not ok
ret 1
end
ret 0
end

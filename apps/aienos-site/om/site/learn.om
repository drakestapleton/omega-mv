sr_raw sljs
sr_close
end
text slnotice "<aside class=\"so-banner\" aria-label=\"Notice\"><p>GitHub suspended the aien-spark organisation on 2026-11-07. This project now publishes on <a href=\"/forge/\">Radicle</a>.</p></aside>"

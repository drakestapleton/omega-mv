note Home preview of the real read-only factory, L1025, Drake 2026-11-09.
note Public shell captured from https://www.aienos.com/now/; never the private factory document.
note The shell uses the existing /now/ assets and identical public SSE stream through its base URL.
note srcdoc avoids widening HTTP frame-ancestors protections. No HTML is fetched or injected at runtime.
note Brand tokens copied from the AienOS brand reference, scoped to the new sections.
note Embedded public-only ffdoc literal: 14859 bytes, sha256 dc6e20ae1f943696f456739af24fb1c354e5374c58d123e6cbdb21bcac741734. Generated by scripts/floor-shell.py from the public /now/ document.
text ffhead "<section id=\"factory-floor\" class=\"home-floor\" aria-labelledby=\"factory-floor-title\"><div class=\"home-floor-stage\"><div class=\"home-floor-head\"><div><p class=\"home-floor-kicker\">The factory, live</p><h1 id=\"factory-floor-title\">Watch the work happen.</h1></div><a class=\"home-floor-enter\" href=\"/now/\">Enter the factory</a></div><div id=\"factory-floor-wait\" class=\"home-floor-frame home-floor-wait\" role=\"status\"><div><p>Opening the live floor…</p><p>Work moves from intake through building, review and delivery.</p></div></div><iframe hidden id=\"factory-floor-frame\" class=\"home-floor-frame\" title=\"Live AienOS factory floor\" loading=\"lazy\" referrerpolicy=\"same-origin\" data-floor-srcdoc=\""
text ffdoc "<!doctype html>\n<html lang=\"en\" data-theme=\"dark\" data-mode=\"public\">\n<head>\n<meta charset=\"utf-8\">\n<base href=\"/now/\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Now · the AienOS factory floor, live</title>\n<link rel=\"icon\" href=\"/now/aienos-favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"stylesheet\" href=\"/now/tokens.css\">\n<link rel=\"stylesheet\" href=\"/now/components.css\">\n<link rel=\"stylesheet\" href=\"/now/factory.css\">\n<link rel=\"stylesheet\" href=\"/now/bay-status.css\">\n<link rel=\"stylesheet\" href=\"/now/usage-corner.css\">\n\n<link rel=\"stylesheet\" href=\"/now/rescue.css\">\n<link rel=\"stylesheet\" href=\"/now/workers.css\">\n<link rel=\"stylesheet\" href=\"/now/operator.css\">\n<style>\n.fx-brand,.fx-strip,.fx-rail,#toasts{display:none!important}\n.fx-header{height:auto;min-height:48px;padding:8px 16px;justify-content:flex-end}\n.fx-controls{flex-wrap:wrap;justify-content:flex-end;gap:8px}\n.fx-main{height:calc(100% - 56px);grid-template-columns:minmax(0,1fr);padding:8px;gap:0}\n.fx-floorcol{min-width:0}.fx-floorcard{min-height:0}\n.fx-floorhead{padding:12px 16px}.fx-stagewrap{min-height:200px}\n@media(max-width:600px){.fx-clock,.fx-floormeta{display:none}.fx-header{justify-content:center}.fx-controls{justify-content:center}.fx-floorhead{padding:8px}.fx-floorhead h1{font-size:16px;line-height:24px}.fx-stagewrap{min-height:200px}.fx-main{height:calc(100% - 88px)}}\n@media(max-width:600px){.fx-header{position:absolute;top:16px;right:16px;height:auto;min-height:0;padding:0;border:0;background:transparent;-webkit-backdrop-filter:none;backdrop-filter:none}.fx-controls{position:relative;flex-wrap:nowrap;gap:8px}#liveText{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.fx-controls__more{position:absolute;top:calc(100% + 8px);right:0;z-index:40;flex-direction:column;align-items:stretch;width:min(260px,calc(100vw - 32px));padding:var(--space-3);border:1px solid var(--border);border-radius:var(--radius-2xl);background:var(--bg-primary)}.fx-main{height:auto}.fx-floorcard{overflow-x:auto;overscroll-behavior-x:contain}.fx-floorhead{position:sticky;left:0;z-index:5}.fx-floorhead .si-eyebrow{flex:0 0 100%;display:flex;align-items:center;min-height:44px}.fx-stagewrap{flex:none;width:1120px;height:600px;max-height:none;aspect-ratio:auto}#verdict{display:flex;align-items:center;min-height:44px;max-width:calc(100% - 196px)}.fx-view{position:absolute;right:8px;bottom:8px;z-index:6;gap:0;border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--bg-primary)}.fx-view .si-btn{border-color:transparent}#mobileStations{grid-template-columns:minmax(0,1fr)}#mobileStations button{display:block;min-height:44px;padding:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}}\n.si-btn,.si-seg__opt,#mobileStations button,.fx-select,summary{transition:color 150ms,background-color 150ms,border-color 150ms,opacity 150ms}\n.si-btn:active{background:var(--accent-fill-hover)}.si-btn--outline:active,#mobileStations button:active{border-color:var(--accent);background:var(--bg-secondary);color:var(--accent)}.si-seg__opt:not([aria-pressed=true]):active{background:var(--bg-secondary);color:var(--text-primary)}\n.si-seg__opt[aria-pressed=true]:hover{opacity:.85}.rescue-unit>summary:hover,.operator-station>details>summary:hover{background:var(--bg-secondary)}\n.st:active,.bay-status__queue>summary:active,.rescue-unit>summary:active,.operator-station>details>summary:active,.si-seg__opt[aria-pressed=true]:active{opacity:.72}\n.si-btn:focus-visible,.si-seg__opt:focus-visible,.fx-select:focus-visible,#mobileStations button:focus-visible,.fx-floorhead button:focus-visible,summary:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}\n@media(prefers-reduced-motion:reduce){.si-btn,.si-seg__opt,#mobileStations button,.fx-select,summary{transition:none}}\n</style>\n\n</head>\n<body>\n\n<header class=\"fx-header\">\n  <div class=\"fx-brand\">\n    <img class=\"fx-lockup fx-lockup--dark\" src=\"/now/aienos-lockup.svg\" alt=\"AienOS\">\n    <img class=\"fx-lockup fx-lockup--light\" src=\"/now/aienos-lockup-on-light.svg\" alt=\"AienOS\">\n    <span class=\"fx-rule\" aria-hidden=\"true\"></span>\n    <span class=\"si-wordmark\"><span class=\"si-wordmark__seed\" aria-hidden=\"true\"></span>Sovereign Intelligence</span>\n    <span class=\"si-wordmark__sub\">Factory floor</span>\n  </div>\n  <div class=\"fx-controls\" id=\"fxControls\">\n    <span class=\"fx-live\" id=\"live\"><span class=\"si-dot si-dot--live\" id=\"liveDot\"></span><span id=\"liveText\">Connecting…</span></span>\n    <div class=\"si-seg\" role=\"group\" aria-label=\"Motion\">\n      <button class=\"si-seg__opt\" data-motion=\"live\" aria-pressed=\"true\">Live</button>\n      <button class=\"si-seg__opt\" data-motion=\"still\" aria-pressed=\"false\">Still</button>\n    </div>\n    <button class=\"si-btn si-btn--sm si-btn--outline fx-morebtn\" id=\"moreBtn\" type=\"button\" aria-expanded=\"false\" aria-controls=\"moreControls\">More</button>\n    <div class=\"fx-controls__more\" id=\"moreControls\">\n      <button class=\"si-btn si-btn--sm si-btn--outline fx-maestrobtn\" id=\"maestroBtn\" type=\"button\" aria-expanded=\"false\" aria-controls=\"operatorStation\">Maestro</button>\n      \n      <div class=\"si-seg\" role=\"group\" aria-label=\"Sound\">\n        <button class=\"si-seg__opt\" data-sound=\"off\" aria-pressed=\"true\">Quiet</button>\n        <button class=\"si-seg__opt\" data-sound=\"on\" aria-pressed=\"false\">Chime</button>\n        <button class=\"si-seg__opt\" data-sound=\"floor\" aria-pressed=\"false\">Floor</button>\n      </div>\n      <label class=\"fx-theme\">\n        <span class=\"fx-visually-hidden\">Theme</span>\n        <select id=\"theme\" class=\"fx-select\">\n          <option value=\"dark\">Midnight</option>\n          <option value=\"light\">Daylight</option>\n          <option value=\"contrast\">Contrast max</option>\n          <option value=\"cvd\">Red-green safe</option>\n        </select>\n      </label>\n    </div>\n  </div>\n</header>\n\n<main class=\"fx-main\">\n  <aside class=\"operator-station\" id=\"operatorStation\" aria-label=\"Factory orchestrator\">\n    <details id=\"operatorDock\" open>\n      <summary><span class=\"operator-avatar\" id=\"operatorAvatar\" aria-hidden=\"true\"></span><span><strong id=\"operatorName\">Maestro</strong><small>Factory orchestrator</small></span><span class=\"operator-expand\">Talk</span></summary>\n      <div class=\"operator-body\"><p class=\"operator-intro\">Your intent. One conductor. The right crew.</p>\n        <button type=\"button\" class=\"si-btn si-btn--sm si-btn--outline\" id=\"operatorDeck\">Watch the command deck</button>\n        <div id=\"operatorChatSlot\"></div>\n        \n        <p class=\"operator-public-note\" id=\"operatorPublicNote\" hidden>Watch the crews and their work. The operator controls belong to the factory owner.</p>\n      </div>\n    </details>\n  </aside>\n\n  <section class=\"fx-floorcol\">\n    <div class=\"fx-floorcard\">\n      <div class=\"fx-floorhead\">\n        <p class=\"si-eyebrow\">The line</p>\n        <h1 class=\"fx-verdict\" id=\"verdict\" tabindex=\"-1\" aria-live=\"polite\">Reading the floor…</h1>\n        <div class=\"fx-voice\" id=\"voice\" hidden>\n          <p class=\"fx-voice__detail\" id=\"voiceDetail\"></p>\n          <div class=\"fx-voice__act\">\n            <button class=\"si-btn si-btn--sm\" id=\"voiceDone\" type=\"button\">Handled</button>\n            <button class=\"si-btn si-btn--sm si-btn--outline\" id=\"voiceTalk\" type=\"button\">Talk it through</button>\n            <button class=\"si-btn si-btn--sm si-btn--outline\" id=\"voiceAll\" type=\"button\" aria-controls=\"voiceDetail\" aria-expanded=\"false\" hidden>Read all</button>\n            <span class=\"fx-voice__more si-muted\" id=\"voiceMore\"></span>\n          </div>\n        </div>\n        <p class=\"fx-wins si-muted\" id=\"wins\" hidden></p>\n        <p class=\"fx-floormeta si-muted\" id=\"floormeta\">-</p>\n        <div class=\"fx-view\" id=\"viewCtl\" role=\"group\" aria-label=\"View\">\n          <button class=\"si-btn si-btn--sm si-btn--outline\" id=\"zoomOut\" type=\"button\" aria-label=\"Zoom out\" aria-keyshortcuts=\"-\">-</button>\n          <span class=\"fx-view__z\" id=\"zoomLevel\" aria-live=\"polite\">100%</span>\n          <button class=\"si-btn si-btn--sm si-btn--outline\" id=\"zoomIn\" type=\"button\" aria-label=\"Zoom in\" aria-keyshortcuts=\"+\">+</button>\n          <button class=\"si-btn si-btn--sm si-btn--outline\" id=\"zoomFit\" type=\"button\" aria-keyshortcuts=\"0\">Fit</button>\n        </div>\n      </div>\n      <div class=\"fx-stagewrap\" id=\"stagewrap\">\n        <div class=\"fx-stage\" id=\"stage\">\n          <canvas id=\"belts\" aria-hidden=\"true\"></canvas>\n          <div class=\"fx-bus\" id=\"bus\"></div>\n          <div class=\"fx-pile\" id=\"pile\"></div>\n          <div class=\"fx-bays\" id=\"bays\"></div>\n          <div class=\"fx-desk\" id=\"desk\"></div>\n          <div class=\"fx-return\" aria-hidden=\"true\">Every delivery returns to intake as a lesson</div>\n        </div>\n      </div>\n    </div>\n\n    <nav id=\"mobileStations\" aria-label=\"Factory stations\"></nav>\n    <details class=\"rescue-unit\" id=\"rescueUnit\">\n      <summary><svg class=\"rescue-unit__mark\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 1h4v5h5v4h-5v5H6v-5H1V6h5z\" fill=\"currentColor\"/></svg><strong>Rescue unit</strong><span id=\"rescueStatus\" role=\"status\">Connecting</span><span class=\"rescue-unit__last\" id=\"rescueLast\"></span><span class=\"rescue-unit__hint\">Last resort, runs on Spark</span></summary>\n      <div class=\"rescue-unit__body\"><p id=\"rescueDetail\">Waiting for local recovery state.</p><p class=\"si-muted\">Called by the Queen, an agent, or after normal service recovery fails. Other crews stay at their stations. No external model connection is needed.</p><ol id=\"rescueHistory\"></ol>\n        </div>\n    </details>\n    <div class=\"fx-strip\">\n      <section class=\"si-card fx-quest\">\n        <div class=\"fx-cardhead fx-cardhead--stack\">\n          <p class=\"si-eyebrow\">The road to Sovereign Intelligence</p>\n          <p class=\"fx-level\" id=\"level\">-</p>\n        </div>\n        <div class=\"fx-levelbar\"><span id=\"levelfill\"></span></div>\n        <ol class=\"fx-chapters\" id=\"chapters\"></ol>\n      </section>\n      <section class=\"si-card fx-heatcard\">\n        <div class=\"fx-cardhead\">\n          <p class=\"si-eyebrow\">Deliveries</p>\n          <p class=\"si-muted fx-meta\" id=\"ghost\">-</p>\n        </div>\n        <div class=\"si-heat\" id=\"heat\"></div>\n      </section>\n      <section class=\"si-card fx-built\">\n        <div class=\"fx-cardhead\">\n          <p class=\"si-eyebrow\">Built so far</p>\n          <p class=\"si-muted fx-meta\" id=\"since\">-</p>\n        </div>\n        <dl class=\"fx-ledger\" id=\"built\"></dl>\n      </section>\n    </div>\n  </section>\n\n  <aside class=\"fx-rail\">\n    \n    <div class=\"si-banner\" id=\"banner\">\n      <div class=\"si-banner__head\"><span class=\"si-dot\"></span><span id=\"bannerHead\">Reading the floor…</span></div>\n      <div class=\"si-banner__body\">\n        <p id=\"bannerBody\">-</p>\n        <div class=\"fx-neck\" id=\"neck\" hidden>\n          <ul class=\"fx-neck__list\" id=\"neckList\"></ul>\n          <button class=\"si-btn si-btn--sm\" id=\"neckOpen\" type=\"button\">Open the bottleneck</button>\n        </div>\n        <p class=\"fx-since\" id=\"sinceLooked\" hidden></p>\n        <p class=\"fx-receipt\" id=\"receipt\" hidden></p>\n        <p class=\"fx-quiet\" id=\"quiet\" hidden></p>\n      </div>\n    </div>\n\n    <div class=\"fx-stats\">\n      <div class=\"si-stat\"><span class=\"si-stat__label\">Delivered · 24 h</span><span class=\"si-stat__value\" id=\"sToday\">-</span><span class=\"si-stat__foot\"><span class=\"si-stat__delta\" id=\"sTodayDelta\">-</span>vs the day before</span></div>\n      <div class=\"si-stat\"><span class=\"si-stat__label\">In work</span><span class=\"si-stat__value\" id=\"sMoving\">-</span><span class=\"si-stat__foot\" id=\"sMovingFoot\">moved in the last 3 days</span></div>\n      <div class=\"si-stat\"><span class=\"si-stat__label\">Crews on shift</span><span class=\"si-stat__value\" id=\"sCrews\">-</span><span class=\"si-stat__foot\" id=\"sCrewsFoot\">active in the last 3 hours</span></div>\n      <div class=\"si-stat\"><span class=\"si-stat__label\">Waiting for review</span><span class=\"si-stat__value\" id=\"sWait\">-</span><span class=\"si-stat__foot\" id=\"sWaitFoot\">-</span></div>\n    </div>\n\n    \n    <details class=\"usage-corner\" id=\"usageCorner\">\n      <summary><span>Subscription balance</span><span class=\"usage-corner__hint\">Remaining allowance</span></summary>\n      <div class=\"usage-corner__body\">\n        <div id=\"usageProviders\" aria-live=\"polite\"><p class=\"usage-corner__note\">Reading usage…</p></div>\n        <div class=\"usage-corner__foot\"><span id=\"usageState\">Average of reported accounts</span><button type=\"button\" id=\"usageRefresh\">Refresh</button></div>\n      </div>\n    </details>\n  </aside>\n</main>\n\n<div class=\"fx-drawer\" id=\"drawer\" hidden>\n  <div class=\"fx-drawer__scrim\" data-close></div>\n  <section class=\"fx-drawer__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dTitle\">\n    <div class=\"fx-drawer__head\">\n      <div>\n        <p class=\"si-eyebrow\" id=\"dRole\">-</p>\n        <h2 class=\"fx-drawer__title\" id=\"dTitle\">-</h2>\n        <p class=\"si-muted fx-drawer__about\" id=\"dAbout\">-</p>\n      </div>\n      <button class=\"si-btn si-btn--outline\" type=\"button\" data-close>Close</button>\n    </div>\n    <div class=\"fx-drawer__stats\" id=\"dStats\"></div>\n    <h3 class=\"fx-drawer__h\">Why this status</h3>\n    <div id=\"dWhy\"></div>\n    <h3 class=\"fx-drawer__h\">Through here in the last hour</h3>\n    <ul class=\"fx-drawer__list\" id=\"dHour\"></ul>\n    <h3 class=\"fx-drawer__h\" id=\"dJobsH\">In work</h3>\n    <div class=\"si-table-wrap\"><table class=\"si-table\"><thead><tr><th>Job</th><th>Crew</th><th class=\"is-num\">Last moved</th></tr></thead><tbody id=\"dJobs\"></tbody></table></div>\n    <h3 class=\"fx-drawer__h\">Recently delivered</h3>\n    <ul class=\"fx-drawer__list\" id=\"dDone\"></ul>\n    <h3 class=\"fx-drawer__h\">Crews here now</h3>\n    <ul class=\"fx-drawer__list\" id=\"dCrews\"></ul>\n    \n  <section id=\"dWorkers\" hidden aria-label=\"Live worker output\"><h3>Workers at this station</h3><div id=\"dWorkerList\"></div><p id=\"workerState\" role=\"status\">Choose a worker to watch.</p><pre id=\"workerOutput\" tabindex=\"0\" aria-label=\"Read-only worker terminal output\"></pre><p class=\"si-muted\">Live, read-only output from Spark. Credentials and personal identifiers are filtered before publication.</p></section></section>\n</div>\n\n<div class=\"fx-toasts\" id=\"toasts\"></div>\n<div class=\"fx-visually-hidden\" id=\"announce\" role=\"status\" aria-atomic=\"true\"></div>\n<div class=\"fx-visually-hidden\" id=\"alertMsg\" role=\"alert\"></div>\n<div class=\"fx-tip\" id=\"ftip\" role=\"tooltip\" hidden></div>\n\n\n\n\n\n<script src=\"/now/bay-status.js\"></script>\n<script src=\"/now/factory.js\"></script>\n<script src=\"/now/senses.js\"></script>\n\n<script src=\"/now/usage-corner.js\"></script>\n<script src=\"/now/rescue.js\"></script>\n<script src=\"/now/workers.js\"></script>\n<script src=\"/now/operator.js\"></script>\n\n</body>\n</html>\n"
text fftail "\"></iframe></div><p class=\"home-floor-note\">Live status. The opening animation replays recent work. Enter the factory for the full view.</p><noscript><style>.home-floor-frame,.home-floor-note{display:none}.home-floor-stage{height:auto}</style><div class=\"home-floor-static\"><p>The factory follows work from the first idea through building, review and delivery.</p><ol><li>Intake</li><li>Build</li><li>Verify</li><li>Deliver</li></ol><p>The moving floor needs JavaScript. You can read the project and its evidence below.</p><a href=\"/evidence/\">Read the evidence</a></div></noscript></section><section id=\"home-allen\" class=\"home-allen\" aria-labelledby=\"home-allen-title\"><div><h2 id=\"home-allen-title\">Meet Aien</h2><p>Step into Aien's own space, or keep reading about the project below.</p></div><a href=\"/aien/\">Enter Aien's space →</a></section>"
text ffcss "/* Generated by om/site/floor.om. Public live floor, with a static first paint. */\n/* The floor is the main attraction (Drake, 2026-11-09): full window width, from below the site header (--home-floor-nav, its height at each width) and one slim head row to the bottom of the first screen, at least 80% of it. The body is the width container so the floor stops at a classic scrollbar. */\n.home-floor,.home-allen,.home-deeper{font-family:var(--font-sans);color:var(--text-primary)}\nbody:has(#factory-floor){container-type:inline-size}\n.home-floor{--home-floor-nav:61px;margin-inline:calc(50% - 50vw);margin-inline:calc(50% - 50cqw);padding:0 0 var(--space-4);background:var(--bg-primary)}\n.home-floor-stage{display:flex;flex-direction:column;height:calc(100vh - var(--home-floor-nav));height:calc(100svh - var(--home-floor-nav))}\n.home-floor-head{flex:none;display:flex;align-items:center;justify-content:space-between;gap:var(--space-3) var(--space-4);box-sizing:border-box;width:100%;max-width:1200px;margin-inline:auto;padding:var(--space-2) var(--space-6)}\n.home-floor-head>div{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 var(--space-3);min-width:0}\n.home-floor h1{color:var(--text-primary);margin:0;font-size:18px;line-height:28px;font-weight:600;letter-spacing:normal}\n.home-floor-kicker{margin:0;font-size:12px;line-height:16px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}\n.home-floor-enter{flex:none;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:44px;padding:var(--space-2) var(--space-4);border-radius:var(--radius-md);background:var(--accent-fill);color:var(--on-accent-fill);font-size:14px;line-height:20px;font-weight:600;text-decoration:none;white-space:nowrap}\n.home-floor-enter:hover{background:var(--accent-fill-hover);text-decoration:none}\n.home-floor-enter:focus-visible{outline-color:var(--focus-ring)}\n.home-floor-frame{display:block;box-sizing:border-box;flex:1 1 auto;width:100%;height:auto;min-height:280px;border:0;border-block:1px solid var(--border);border-radius:0;background:var(--bg-primary)}\n.home-floor-note{font-size:12px;line-height:16px;color:var(--text-tertiary);box-sizing:border-box;max-width:1200px;margin:var(--space-3) auto 0;padding-inline:var(--space-6)}\n.home-floor-static{margin:var(--space-4) var(--space-6) 0;padding:var(--space-6);border:1px solid var(--border);border-radius:var(--radius-2xl);background:var(--bg-card)}\n.home-floor-static p{color:var(--text-tertiary);max-width:68ch}\n.home-floor-static ol{display:flex;flex-wrap:wrap;gap:var(--space-4);list-style-position:inside;padding:0;color:var(--text-primary)}\n.home-allen{display:flex;align-items:center;justify-content:space-between;gap:var(--space-6);flex-wrap:wrap;padding:var(--space-6);margin:var(--space-6) 0 var(--space-8);border:1px solid var(--border);border-radius:var(--radius-2xl);background:var(--bg-card)}\n.home-allen h2{color:var(--text-primary);font-size:18px;line-height:28px;margin:0 0 var(--space-2)}\n.home-allen p{color:var(--text-tertiary);margin:0;font-size:16px;line-height:24px;max-width:58ch}\n.home-allen a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-weight:600}\n/* Go deeper: one line per destination; the rest of the former homepage lives at /record/. */\n.home-deeper{margin:0 0 var(--space-8)}\n.home-deeper h2{color:var(--text-primary);font-size:18px;line-height:28px;margin:0 0 var(--space-3)}\n.home-deeper ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:var(--space-3)}\n.home-deeper li{margin:0;min-width:0}\n.home-deeper li>a{display:flex;flex-direction:column;justify-content:center;box-sizing:border-box;height:100%;min-height:44px;padding:var(--space-3) var(--space-4);border:1px solid var(--border);border-radius:var(--radius-xl);background:var(--bg-card);color:var(--text-primary);text-decoration:none}\n.home-deeper li>a:hover{border-color:var(--accent);text-decoration:none}\n.home-deeper a:focus-visible{outline-color:var(--focus-ring)}\n.home-deeper strong{font-size:16px;line-height:24px;font-weight:600;color:var(--accent)}\n.home-deeper span{font-size:16px;line-height:24px;color:var(--text-tertiary)}\n/* Follow the work (pass two): the Install strip keeps the site buttons (site units, outside the token scope), then the Go deeper cards, three across, two on tablets, one list on phones; the data files on one small line. */\n.home-strip{margin:0 0 2rem}\n.home-follow>p{margin:0 0 var(--space-3);font-size:16px;line-height:24px;color:var(--text-tertiary)}\n.home-follow ul{grid-template-columns:repeat(2,minmax(0,1fr))}\n.home-follow span{overflow-wrap:anywhere}\n.home-follow .home-follow-meta{display:flex;flex-wrap:wrap;align-items:center;gap:0 var(--space-2);margin:var(--space-2) 0 0;font-size:14px;line-height:20px}\n.home-follow-meta a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent)}\n@media(min-width:900px){.home-follow ul{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(min-width:1200px){.home-floor{--home-floor-nav:69px}}\n@media(max-width:600px){.home-floor-head,.home-floor-note{padding-inline:var(--space-3)}.home-floor-head{column-gap:var(--space-3)}.home-floor-head>div{display:block}.home-floor h1{font-size:14px;line-height:20px}.home-floor-kicker{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.home-floor-enter{padding-inline:var(--space-2)}.home-floor-note{font-size:16px;line-height:24px}.home-floor-static{margin-inline:var(--space-4)}.home-allen{padding:var(--space-4)}.home-follow ul{grid-template-columns:minmax(0,1fr);gap:var(--space-2)}.home-follow li>a{flex-direction:row;flex-wrap:wrap;align-items:baseline;align-content:center;justify-content:flex-start;column-gap:var(--space-2);padding:var(--space-2) var(--space-3)}.home-follow .home-follow-meta{font-size:16px;line-height:24px}}\n\n.home-floor-frame[hidden]{display:none!important}\n.home-floor-wait{display:grid;place-items:center;text-align:center;padding:var(--space-6);color:var(--text-primary)}\n.home-floor-wait p{max-width:40ch;color:var(--text-tertiary)}\n"
text fftokens "/* Sovereign Intelligence / AienOS brand tokens, compiled from tokens.json. Themes: dark (default), light, contrast, cvd. Set <html data-theme=\"...\">. */\n:where(.home-floor,.home-allen,.home-deeper) {\n  --bg-primary: #0a0a0f;\n  --bg-secondary: #111118;\n  --bg-card: #14141f;\n  --bg-card-glass: rgba(20, 20, 31, 0.4);\n  --bg-card-faint: rgba(20, 20, 31, 0.3);\n  --bg-glass: rgba(255, 255, 255, 0.03);\n  --bg-header: rgba(5, 6, 8, 0.7);\n  --sidebar-bg: #0c0c14;\n  --fill-input: rgba(255, 255, 255, 0.05);\n  --fill-hover: rgba(255, 255, 255, 0.02);\n  --col-stripe: rgba(255, 255, 255, 0.055);\n  --border: rgba(255, 255, 255, 0.08);\n  --border-strong: rgba(255, 255, 255, 0.1);\n  --border-faint: rgba(255, 255, 255, 0.05);\n  --text-primary: #ffffff;\n  --text-secondary: rgba(255, 255, 255, 0.5);\n  --text-tertiary: rgba(255, 255, 255, 0.7);\n  --accent: #63b3ed;\n  --accent-hover: #4299e1;\n  --accent-fill: #2563eb;\n  --accent-fill-hover: #1d4ed8;\n  --on-accent-fill: #ffffff;\n  --pill: #ffffff;\n  --on-pill: #000000;\n  --focus-ring: #7dd3fc;\n  --success: #00d294;\n  --success-fill: #00bb7f;\n  --success-tint: rgba(0, 187, 127, 0.1);\n  --success-line: rgba(0, 187, 127, 0.2);\n  --success-edge: rgba(0, 187, 127, 0.25);\n  --warning: #fcbb00;\n  --warning-fill: #f99c00;\n  --warning-tint: rgba(249, 156, 0, 0.1);\n  --warning-line: rgba(249, 156, 0, 0.2);\n  --danger: #ff6568;\n  --danger-fill: #fb2c36;\n  --danger-tint: rgba(251, 44, 54, 0.1);\n  --danger-line: rgba(251, 44, 54, 0.2);\n  --info: #54a2ff;\n  --info-tint: rgba(48, 128, 255, 0.1);\n  --info-line: rgba(48, 128, 255, 0.2);\n  --track: rgba(255, 255, 255, 0.1);\n  --live-dot: #ffffff;\n  --ember: #ff735e;\n  --brand-blue: #2563eb;\n  --brand-cyan: #22d3ee;\n  --series-1: #3987e5;\n  --series-2: #d95926;\n  --series-3: #199e70;\n  --series-4: #c98500;\n  --series-5: #d55181;\n  --series-6: #008300;\n  --series-7: #9085e9;\n  --series-8: #e66767;\n  --heat-mid: #383835;\n  --heat-0: rgba(57, 135, 229, 0.06);\n  --heat-1: rgba(57, 135, 229, 0.18);\n  --heat-2: rgba(57, 135, 229, 0.34);\n  --heat-3: rgba(57, 135, 229, 0.55);\n  --heat-4: rgba(57, 135, 229, 0.8);\n  --glow-live: 0 0 10px 0 rgba(255, 255, 255, 0.9);\n  --ring-input: 0 0 0 2px rgba(48, 128, 255, 0.5);\n}\n:where([data-theme=\"light\"] .home-floor,[data-theme=\"light\"] .home-allen,[data-theme=\"light\"] .home-deeper) {\n  --bg-primary: #f8fafc;\n  --bg-secondary: #ffffff;\n  --bg-card: #ffffff;\n  --bg-card-glass: rgba(255, 255, 255, 0.4);\n  --bg-card-faint: rgba(255, 255, 255, 0.3);\n  --bg-glass: rgba(255, 255, 255, 0.7);\n  --bg-header: rgba(248, 250, 252, 0.7);\n  --sidebar-bg: #f1f5f9;\n  --fill-input: #ffffff;\n  --fill-hover: rgba(15, 23, 42, 0.03);\n  --col-stripe: rgba(15, 23, 42, 0.043);\n  --border: #e2e8f0;\n  --border-strong: #cbd5e1;\n  --border-faint: #f1f5f9;\n  --text-primary: #1a202c;\n  --text-secondary: #5a6578;\n  --text-tertiary: #334155;\n  --accent: #1d4ed8;\n  --accent-hover: #1e40af;\n  --accent-fill: #2563eb;\n  --accent-fill-hover: #1d4ed8;\n  --on-accent-fill: #ffffff;\n  --pill: #0a0a0f;\n  --on-pill: #ffffff;\n  --focus-ring: #1d4ed8;\n  --success: #047857;\n  --success-fill: #00bb7f;\n  --success-tint: rgba(0, 187, 127, 0.1);\n  --success-line: rgba(0, 187, 127, 0.3);\n  --success-edge: rgba(0, 187, 127, 0.35);\n  --warning: #b75000;\n  --warning-fill: #f99c00;\n  --warning-tint: rgba(249, 156, 0, 0.12);\n  --warning-line: rgba(249, 156, 0, 0.35);\n  --danger: #b91c1c;\n  --danger-fill: #fb2c36;\n  --danger-tint: rgba(251, 44, 54, 0.08);\n  --danger-line: rgba(251, 44, 54, 0.3);\n  --info: #1447e6;\n  --info-tint: rgba(48, 128, 255, 0.1);\n  --info-line: rgba(48, 128, 255, 0.3);\n  --track: rgba(15, 23, 42, 0.1);\n  --live-dot: #0a0a0f;\n  --ember: #a9462b;\n  --brand-blue: #2563eb;\n  --brand-cyan: #0891b2;\n  --series-1: #2a78d6;\n  --series-2: #eb6834;\n  --series-3: #1baf7a;\n  --series-4: #eda100;\n  --series-5: #e87ba4;\n  --series-6: #008300;\n  --series-7: #4a3aa7;\n  --series-8: #e34948;\n  --heat-mid: #f0efec;\n  --heat-0: rgba(42, 120, 214, 0.06);\n  --heat-1: rgba(42, 120, 214, 0.18);\n  --heat-2: rgba(42, 120, 214, 0.34);\n  --heat-3: rgba(42, 120, 214, 0.55);\n  --heat-4: rgba(42, 120, 214, 0.8);\n  --ring-input: 0 0 0 2px rgba(29, 78, 216, 0.35);\n}\n:where([data-theme=\"contrast\"] .home-floor,[data-theme=\"contrast\"] .home-allen,[data-theme=\"contrast\"] .home-deeper) {\n  --bg-primary: #000000;\n  --bg-secondary: #000000;\n  --bg-card: #000000;\n  --bg-card-glass: #000000;\n  --bg-card-faint: #000000;\n  --bg-glass: #000000;\n  --bg-header: #000000;\n  --sidebar-bg: #000000;\n  --fill-input: #000000;\n  --fill-hover: rgba(255, 255, 255, 0.12);\n  --col-stripe: #000000;\n  --border: #ffffff;\n  --border-strong: #ffffff;\n  --border-faint: #ffffff;\n  --text-primary: #ffffff;\n  --text-secondary: #ffffff;\n  --text-tertiary: #ffffff;\n  --accent: #7fd4ff;\n  --accent-hover: #b3e6ff;\n  --accent-fill: #0000ee;\n  --accent-fill-hover: #0000aa;\n  --on-accent-fill: #ffffff;\n  --pill: #ffffff;\n  --on-pill: #000000;\n  --focus-ring: #ffff00;\n  --success-tint: #000000;\n  --success-line: #00d294;\n  --success-edge: #00d294;\n  --warning-tint: #000000;\n  --warning-line: #fcbb00;\n  --danger-tint: #000000;\n  --danger-line: #ff6568;\n  --info-tint: #000000;\n  --info-line: #54a2ff;\n  --track: #333333;\n  --live-dot: #ffffff;\n  --ember: #ff9b88;\n  --brand-blue: #2563eb;\n  --brand-cyan: #22d3ee;\n  --heat-0: #0a1a33;\n  --heat-1: #123366;\n  --heat-2: #1f5299;\n  --heat-3: #3a7fd6;\n  --heat-4: #7fd4ff;\n  --ring-input: 0 0 0 2px #ffff00;\n}\n:where([data-theme=\"cvd\"] .home-floor,[data-theme=\"cvd\"] .home-allen,[data-theme=\"cvd\"] .home-deeper) {\n  --success: #38bdf8;\n  --success-fill: #0ea5e9;\n  --success-tint: rgba(14, 165, 233, 0.1);\n  --success-line: rgba(14, 165, 233, 0.2);\n  --success-edge: rgba(14, 165, 233, 0.25);\n  --danger: #f472b6;\n  --danger-fill: #ec4899;\n  --danger-tint: rgba(236, 72, 153, 0.1);\n  --danger-line: rgba(236, 72, 153, 0.2);\n}\n:where(.home-floor,.home-allen,.home-deeper) {\n  --space-0_5: 2px;\n  --space-1: 4px;\n  --space-1_5: 6px;\n  --space-2: 8px;\n  --space-2_5: 10px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-14: 56px;\n  --radius-bar: 1px;\n  --radius-sm: 4px;\n  --radius-md: 6px;\n  --radius-lg: 8px;\n  --radius-xl: 12px;\n  --radius-2xl: 16px;\n  --radius-full: 9999px;\n  --container-4xl: 896px;\n  --container-6xl: 1152px;\n  --header-height: 68px;\n  --sidebar-width: 240px;\n  --uptime-height: 32px;\n  --dot: 8px;\n  --blur-xl: 24px;\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n}\n"
text ffstyle "<style data-home-floor>"
text ffend "</style>"
fn floor_home to void
sr_raw ffhead
sr_esc ffdoc
sr_raw fftail
end
note Go deeper (Drake, 2026-11-09): the six sections of the site navigation, one line each, then the full record.
text ffdeeper "<section id=\"go-deeper\" class=\"home-deeper\" aria-labelledby=\"go-deeper-title\"><h2 id=\"go-deeper-title\">Go deeper</h2><ul><li><a href=\"/machine/\"><strong>The Machine</strong><span>One machine across five physical bodies.</span></a></li><li><a href=\"/turing/\"><strong>The Turing</strong><span>What the Turing measures, with games and live calculations.</span></a></li><li><a href=\"/experiments/\"><strong>Experiments</strong><span>Every experiment on the research ladder, failures included.</span></a></li><li><a href=\"/discovery/\"><strong>Scientific Discovery</strong><span>Physics Zero, Dirac, Zeta and supersymmetry.</span></a></li><li><a href=\"/evidence/\"><strong>Evidence</strong><span>What counts as evidence and where the receipts live.</span></a></li><li><a href=\"/philosophy/\"><strong>Philosophy</strong><span>The position papers behind Aien.</span></a></li><li><a href=\"/record/\"><strong>The record</strong><span>The full record, every receipt.</span></a></li></ul></section>"
fn floor_deeper to void
sr_raw ffdeeper
end
note Follow the work, homepage only (Drake, 2026-11-09, pass two): the Install strip keeps its two 44px buttons; X and the former cluster and reach links are cards in the Go deeper style; forge links only (AGENTS.md link policy). /classic/ keeps its own Follow section.
text ffstrip "<div class=\"cluster home-strip\"><a class=\"button\" href=\"/alpha/\">Install / explore Alpha</a><a class=\"button button-secondary\" href=\"https://interplane.io/drakestapleton/sovereign-intelligence/releases\">Releases and signatures</a></div>"
text fffollow "<section id=\"follow\" class=\"home-deeper home-follow\" aria-labelledby=\"follow-title\"><h2 id=\"follow-title\">Follow the work</h2><p>Watch the repositories and read the receipts. Learning to code with AI? You are welcome here.</p><ul><li><a href=\"/alpha/\"><strong>Alpha</strong><span>Releases and install steps</span></a></li><li><a href=\"/learn/\"><strong>Learn</strong><span>A practical working method</span></a></li><li><a href=\"/hive/\"><strong>Hive</strong><span>My agents and me at work</span></a></li><li><a href=\"/now/\"><strong>Now</strong><span>What is being done today</span></a></li><li><a href=\"/progress/\"><strong>Progress</strong><span>Source and test activity</span></a></li><li id=\"follow-reach\"><a href=\"https://x.com/drakestapleton\"><strong>X</strong><span>@drakestapleton</span></a></li><li><a href=\"mailto:drake@aienos.com\"><strong>Email</strong><span>drake@aienos.com</span></a></li><li><a href=\"/contact/\"><strong>Contact</strong><span>Where to reach me</span></a></li><li><a href=\"https://interplane.io/explore\"><strong>The public repositories</strong><span>Source on the forge</span></a></li></ul><p class=\"home-follow-meta\">Machine-readable: <a href=\"/status.json\">status.json</a> · <a href=\"/facts.json\">facts.json</a> · <a href=\"/llms.txt\">llms.txt</a></p></section>"
fn floor_follow to void
sr_raw ffstrip
sr_raw fffollow
end
note The floor's scoped brand tokens are raw colours, so they live in a token file, not in the inline floor style (brand rule; the published-tree brand check refuses them inline).
note They ride in assets/home-tokens.css together with the site palette: the homepage links that one file in place of site-tokens.css, so the floor adds no render-blocking request (bay 7 F2, 2026-11-10).
text fftokpth "assets/home-tokens.css"
fn floor_styles to void
sr_raw ffstyle
sr_raw ffcss
sr_raw ffend
end
fn ff_assets to void
st_open fftokpth
css_tokens
sr_raw fftokens
sr_close
end
text ffboot "/* Home floor after paint. Generated by om/site/floor.om. */\n(() => {\n  'use strict';\n  const frame = document.getElementById('factory-floor-frame');\n  const waiting = document.getElementById('factory-floor-wait');\n  if (!frame || !waiting || typeof requestAnimationFrame !== 'function') return;\n  const shell = frame.getAttribute('data-floor-srcdoc');\n  if (!shell || frame.hasAttribute('srcdoc') || frame.hasAttribute('src') || frame.dataset.floorPending) return;\n  frame.dataset.floorPending = 'true';\n  // The first callback runs before a paint; the second runs in the next frame.\n  // Keep the public engine inert until the parent has had that paint opportunity.\n  requestAnimationFrame(() => {\n    requestAnimationFrame(() => {\n      if (!frame.isConnected || !waiting.isConnected || frame.hasAttribute('srcdoc') || frame.hasAttribute('src')) return;\n      frame.srcdoc = shell;\n      frame.removeAttribute('data-floor-srcdoc');\n      frame.hidden = false;\n      waiting.hidden = true;\n    });\n  });\n})();\n"
fn floor_client to void
sr_raw ffboot
end

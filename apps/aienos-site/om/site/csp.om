note Page-level Content-Security-Policy, as main's components::csp. The site is served by SiteHub on
note Drake's own hardware, and every emitted HTML page carries the policy as a meta right after <head> (after a leading
note <meta charset>). The policy is derived from what the page loads: WebAssembly scripts get
note 'wasm-unsafe-eval', the blob-worker script gets worker-src blob:, YouTube embeds may be framed.
note aien/run.html is the one document whose policy allows inline scripts; it loads only aien-run.js.
note sk_all runs last: it reads every written page back, inserts the meta and rewrites the page.
text skrunf "aien/run.html"
text skrunh "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Program runner | AienOS</title><meta name=\"description\" content=\"Runs a program Aien wrote, sandboxed, inside the Aien page.\"><meta name=\"robots\" content=\"noindex\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><link rel=\"stylesheet\" href=\"/assets/style.css\"><link rel=\"stylesheet\" href=\"/assets/site-nav.css\"><link rel=\"stylesheet\" href=\"/assets/turing-look.css\"><script src=\"/js/aien-run.js\"></script></head><body><p class=\"quiet-utility\"><a href=\"/\">Aien home</a> <a class=\"x-link\" href=\"https://x.com/drakestapleton\">Follow me on X</a></p><main id=\"main-content\"><section class=\"container\"><p>This document runs programs Aien writes, inside a sandboxed frame on <a href=\"/aien/\">aienos.com/aien/</a>.</p></section></main><footer><p class=\"aien-reach-foot\"><a href=\"https://x.com/drakestapleton\">X @drakestapleton</a> <a href=\"mailto:drake@aienos.com\">drake@aienos.com</a> <a href=\"/contact/\">Contact</a></p></footer></body></html>\n"
text skopen "<meta http-equiv=\"Content-Security-Policy\" content=\""
text skq "\">"
text skgt ">"
text skhead "<head"
text skchar "<meta charset"
text skrs "src=\"/js/aien-run.js\""
text skhive "src=\"/js/hive.js\""
text skallen "src=\"/js/allen.js\""
text skscene "src=\"/js/allen-scene.js\""
text skyts "src=\"https://www.youtube.com/embed/"
text skrunp "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'none'; base-uri 'none'"
text skp0 "default-src 'self'; script-src 'self'"
text skwasm " 'wasm-unsafe-eval'"
text skp1 "; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
text skblob "; worker-src blob:"
text skyt "; frame-src https://www.youtube.com"
text SK0001 "site: csp: page has no <head>\n"
text SK0002 "site: csp: cannot read the dist tree\n"
global skdepth ulong 1

fn sk_runner to void
st_open skrunf
sr_raw skrunh
sr_close
end

note sk_find: first index of pat in s[from..n), or n. Chunked so no loop passes 65537 times.
fn sk_find s view uchar * n ulong pat view uchar * from ulong to ulong
if or eq len pat 0 gt len pat n
ret n
end
last = sub n len pat
if gt from last
ret n
end
i = from
for c ulong 256
stop = add i 65536
if gt stop add last 1
stop = add last 1
end
while lt i stop bound 65537
if eq get s i get pat 0
if sr_equal part s i len pat pat
ret i
end
end
i = add i 1
end
if gt i last
ret n
end
end
ret n
end

fn sk_loads s view uchar * n ulong pat view uchar * to bool
ret lt sk_find s n pat 0 n
end

fn sk_space c uchar to bool
if or eq c 32 eq c 9
ret true
end
ret or eq c 10 eq c 13
end

note sk_at: main's insertion_point, past <head ...> and a leading <meta charset ...>.
fn sk_at s view uchar * n ulong to ulong
h = sk_find s n skhead 0
if eq h n
st_fail SK0001
end
g = sk_find s n skgt h
if eq g n
st_fail SK0001
end
ins = add g 1
p = ins
while lt p n bound 4096
if not sk_space get s p
break
end
p = add p 1
end
if le add p len skchar n
if sr_equal part s p len skchar skchar
g = sk_find s n skgt p
if eq g n
st_fail SK0001
end
ins = add g 1
end
end
ret ins
end

fn sk_policy s view uchar * n ulong to void
if sk_loads s n skrs
sr_raw skrunp
ret
end
sr_raw skp0
if or or sk_loads s n skhive sk_loads s n skallen sk_loads s n skscene
sr_raw skwasm
end
sr_raw skp1
if sk_loads s n skallen
sr_raw skblob
end
if sk_loads s n skyts
sr_raw skyt
end
end

fn sk_page path view uchar * buf edit uchar * to void
fd = fopen path 0 len path 0 0
if lt fd 0
sr_fail sreop
end
n = ulong 0
while true bound 4096
k = read int fd buf n sub len buf n
if lt k 0
sr_fail srerd
end
if eq k 0
break
end
n = add n ulong k
if eq n len buf
sr_fail srebo
end
end
sr_fclose int fd
if sk_loads buf n skopen
ret
end
ins = sk_at buf n
sr_open path
sr_bytes buf 0 ins
sr_raw skopen
sk_policy buf n
sr_raw skq
sr_bytes buf ins sub n ins
sr_close
end

note sk_entry: one child path; views take two parameter slots, so the path arrives built.
fn sk_entry path view uchar * buf edit uchar * to void
statbuf = new uchar 128 0
r = lstat path 0 len path statbuf 0 len statbuf
if lt r 0
trap 10
end
mode = and or uint get statbuf 16 shl uint get statbuf 17 8 61440
if eq mode 16384
sk_tree path buf
else
if and eq mode 32768 sx_html path
sk_page path buf
end
end
end

note sk_name: the getdents64 record's name length, or 0 for a name the walk skips.
fn sk_name entry view uchar * to ulong
if lt len entry 20
trap 10
end
n = ulong 19
while lt n len entry bound 4096
if eq get entry n 0
break
end
n = add n 1
end
if eq n len entry
trap 10
end
if sx_private part entry 19 sub n 19
ret 0
end
ret sub n 19
end

note sk_size: the size of the getdents64 record at the start of rest, checked against rest.
fn sk_size rest view uchar * to ulong
if lt len rest 20
trap 10
end
size = ulong get rest 16
size = or size shl ulong get rest 17 8
if or lt size 20 gt size len rest
trap 10
end
ret size
end

fn sk_join child edit uchar * path view uchar * name view uchar * to ulong
m = st_append child path 0
m = st_append child stslash m
ret st_append child name m
end

fn sk_record path view uchar * entry view uchar * buf edit uchar * to void
child = new uchar 8192 0
nl = sk_name entry
if gt nl 0
m = sk_join child path part entry 19 nl
sk_entry part child 0 m buf
end
end

note sk_tree: the walk depth lives in skdepth, keeping each call within six parameter slots.
fn sk_tree path view uchar * buf edit uchar * to void
entries = new uchar 65536 0
put skdepth 0 add get skdepth 0 1
if gt get skdepth 0 17
trap 3
end
fd = fopen path 0 len path 16384 0
if lt fd 0
st_fail SK0002
end
while true bound 65536
n = getdnts int fd entries 0 len entries
if lt n 0
trap 10
end
if eq n 0
break
end
p = ulong 0
while lt p ulong n bound 4096
size = sk_size part entries p sub ulong n p
sk_record path part entries p size buf
p = add p size
end
end
r = fclose int fd
if ne r 0
trap 10
end
put skdepth 0 sub get skdepth 0 1
end

fn sk_all to void
pathbuf = new uchar 8192 0
buf = new uchar 2097152 0
n = get stoutn 0
for i ulong n
put pathbuf i get stout i
end
sk_tree part pathbuf 0 n buf
end

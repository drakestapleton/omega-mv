note Generated stylesheet only: css_emit writes to the runtime's current output descriptor.
note Owner measurement budgets, not measured claims: site.css <= 24576 raw bytes; site.js <= 20480 raw bytes.
note Shared HTML chrome <= 24576 raw bytes excluding page data and supplied native/consent artifacts.
note Initial non-scene shell transfer budget <= 98304 raw bytes; native WASM/audio measured separately.
note Palette is shared with page assets. No external fonts, raster background, filter or shadow animation.
note Palette restored to the pre-2026-11-06 Turing look (turing-look.css values), Drake 2026-11-06.
text sstoken "/* Generated shared palette from om/site/css.om. */\n:root{color-scheme:dark;--bg-base:#08090c;--bg-surface:#0e1219;--bg-card:#131822;--bg-card-hover:#1a2130;--border-subtle:#2a3648;--text-primary:#f1f5f9;--text-secondary:#a3b0c2;--text-muted:#8ea0b5;--accent-blue:#7db4ff;--accent-green:#00e599;--accent-amber:#f59e0b;--accent-violet:#a78bfa;--kicker-blue:#2d7ff9;--hairline:#1c2536;--notice-amber:#ffd23f;--radius:1.25rem;--content-width:78rem;--font-sans:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--font-mono:ui-monospace,SFMono-Regular,Consolas,monospace}\n"
note Page palette (brand check, mac-ham/AienosFinish r5): the colours page assets and hand-written pages used as literals, moved here unchanged; pages reference them as var(--name).
text sspal "/* Generated page palette from om/site/css.om: every colour a stylesheet or hand-written page names, one token each. */\n:root{--allen-blue-12:#141828;--allen-blue-19:#24283e;--allen-blue-6:#0a0c16;--allen-blue-60:#5468e0;--allen-blue-68:#5a6eff;--allen-blue-72:#6e82ff;--allen-blue-79:#96aaff;--allen-blue-89:#c8d2ff;--allen-blue-91:#cfd6ff;--allen-blue-91-2:#d2daff;--allen-blue-94:#dfe4ff;--allen-blue-97:#eef1ff;--allen-blue-97-2:#f2f4ff;--allen-grey-2:#02030a;--allen-orange-74:#ffbe78;--eng-blue-11:#151a23;--eng-blue-12:#151c28;--eng-blue-12-2:#0f1a2e;--eng-blue-12-3:#111a2b;--eng-blue-15:#182233;--eng-blue-56:#7c8aa0;--eng-blue-62:#929cab;--eng-blue-67:#9ba8ba;--eng-blue-70:#a3b0c2;--eng-blue-77:#9bb8ed;--eng-blue-82:#c7d0dc;--eng-blue-84:#cbd5e1;--eng-blue-89:#d9e2ef;--eng-grey-10:#1c1915;--eng-grey-10-2:#151f1c;--eng-grey-15:#29232b;--eng-grey-23:#34423d;--eng-grey-3:#060709;--eng-grey-31:#544a52;--eng-grey-33:#4d5c58;--eng-grey-39:#5d6b67;--eng-grey-4:#05050f;--eng-grey-41:#6d626a;--eng-grey-5:#080b10;--eng-grey-6:#0d1412;--eng-grey-69:#aab7b2;--eng-grey-7:#111111;--eng-grey-71:#aebbb6;--eng-grey-76:#bcc7c2;--eng-grey-8:#101816;--eng-grey-92:#ede6ef;--eng-grey-92-2:#e7ece9;--eng-grey-93:#e8f1ee;--eng-grey-94:#edf4f1;--eng-grey-95:#f7f4ee;--eng-grey-96:#f3f5f3;--eng-grey-97:#f4f7fb;--eng-grey-98:#f7f9fc;--eng-orange-13:#2a2119;--eng-orange-45:#b9612e;--eng-orange-64:#ed9158;--eng-orange-66:#f2bf5e;--eng-orange-67:#ef8b67;--eng-orange-75:#ffd47f;--eng-orange-89:#f6ddd2;--eng-orange-92:#f8e3db;--eng-orange-93:#f4efe6;--eng-orange-95:#fff7e8;--eng-orange-97:#fff8ee;--eng-orange-98:#fffaf3;--eng-purple-71:#bca9c2;--eng-purple-85:#ded3df;--eng-red-30:#7d2f1d;--eng-red-42:#a9462b;--eng-red-68:#ff735e;--eng-red-72:#ff8f70;--eng-red-73:#ff8a74;--eng-red-77:#ff9b88;--eng-red-89:#ffd0c7;--eng-red-93:#ffe0da;--eng-teal-10:#121f1b;--eng-teal-14:#1c2925;--eng-teal-16:#153c34;--eng-teal-25:#087864;--eng-teal-56:#4dd0b4;--eng-teal-89:#d6eee8;--eng-violet-17:#2b2233;--eng-violet-34:#5a4668;--eng-violet-9:#18111f;--learn-blue-10:#111821;--learn-blue-26:#39404a;--learn-grey-15:#282825;--learn-grey-7:#0d1117;--learn-grey-73:#b4b8bf;--learn-grey-78:#c4c5c8;--learn-orange-25:#4a4036;--learn-orange-39:#806749;--learn-orange-66:#d6aa7a;--learn-orange-88:#eee5d4;--learn-orange-95:#fff5e3;--plc-grey-35:#52625e;--plc-grey-45:#697a74;--plc-grey-53:#7f918b;--plc-grey-6:#0c1211;--plc-grey-69:#a9b8b3;--plc-grey-75:#bac7c2;--plc-grey-9:#121c1a;--plc-grey-92:#e7eeeb;--plc-grey-93:#e8f0ed;--plc-grey-95:#f0f7f3;--plc-grey-95-2:#eef8f3;--plc-grey-96:#f3f6f4;--plc-orange-42:#c58212;--plc-orange-60:#e3ae50;--plc-red-61:#ed5d48;--plc-red-70:#ff7864;--plc-red-8:#1e100c;--plc-teal-10:#10211f;--plc-teal-11:#0d2925;--plc-teal-12:#172421;--plc-teal-15:#123830;--plc-teal-23:#34433f;--plc-teal-26:#087f62;--plc-teal-47:#32bd8a;--plc-teal-56:#4bd3a1;--plc-teal-66:#70e1b8;--plc-teal-66-2:#9eb5ad;--plc-teal-69:#86d9ba;--plc-teal-7:#071d19;--plc-teal-76:#b9ccc5;--plc-teal-78:#bed0c9;--plc-teal-82:#c9d9d3;--plc-teal-82-2:#c8d9d3;--plc-teal-83:#ccdad5;--progress-blue-12:#131c2b;--progress-blue-27:#354156;--progress-blue-33:#3d506b;--progress-blue-69:#63a9ff;--progress-cyan-59:#56cdd6;--progress-indigo-81:#bda0ff;--progress-orange-66:#f5b75e;--still-indigo-73:#8b7cf6;--still-orange-64:#f5b453;--support-blue-10:#111722;--support-blue-15:#1b2433;--support-blue-22:#2a3445;--support-blue-77:#b8c1d1;--support-grey-97:#f5f7fb;--support-sky-74:#7cc7ff;--turing-amber:#f59e0b;--turing-amber-56:#fbbf24;--turing-amber-93:#f4efe4;--turing-black:#000000;--turing-blue-10:#0e1626;--turing-blue-17:#1e2638;--turing-blue-20:#1b2a4a;--turing-blue-22:#22314d;--turing-blue-34:#2d4a7f;--turing-blue-44:#5b6b85;--turing-blue-71:#6aa7ff;--turing-blue-77:#b6c2d1;--turing-blue-91:#cfe4ff;--turing-blue-91-2:#dbe5f5;--turing-blue-soft:#7db4ff;--turing-card:#131822;--turing-card-hover:#18202d;--turing-green:#00e599;--turing-green-14:#12351f;--turing-green-21:#1e4d2e;--turing-green-30:#1d7a3f;--turing-green-5:#06110b;--turing-green-8:#0b1f13;--turing-grey-10:#1a1a1a;--turing-grey-35:#5a5a5a;--turing-grey-50:#8a8276;--turing-indigo-85:#c4b5fd;--turing-ink:#f1f5f9;--turing-line:#2a3648;--turing-muted:#8ea0b5;--turing-night:#08090c;--turing-orange-15:#3a2b10;--turing-orange-27:#6b4e1f;--turing-orange-55:#f5a623;--turing-orange-6:#1a1206;--turing-orange-9:#241b0b;--turing-panel:#0b0e14;--turing-red:#ff5d5d;--turing-red-38:#a8231b;--turing-red-60:#ef4444;--turing-red-82:#fca5a5;--turing-red-soft:#f87171;--turing-slate:#94a3b8;--turing-slate-deep:#475569;--turing-slate-dim:#64748b;--turing-surface:#0e1219;--turing-teal-39:#10b981;--turing-teal-4:#04120c;--turing-white:#ffffff;--turing-grey-53:#888888}\n"
note Existing page asset variables resolve to the shared palette, not a second stylesheet/theme.
text sstold ":root{--tl-bg:var(--bg-base);--tl-card:var(--bg-surface);--tl-card-2:var(--bg-card);--tl-line:var(--border-subtle);--tl-line-2:var(--border-subtle);--tl-ink:var(--text-primary);--tl-ink-2:var(--text-secondary);--tl-ink-3:var(--text-muted);--tl-blue:var(--accent-blue);--tl-blue-soft:var(--accent-blue);--tl-green:var(--accent-green);--tl-amber:var(--accent-amber);--tl-violet:var(--accent-violet);--tl-radius:var(--radius)}.site .mx-card{transition-property:transform}\n"
text sstyle0 "/* Generated classic document layout from om/site/css.om. */\n*{box-sizing:border-box}html{scroll-padding-top:2rem}body{margin:0;background:var(--bg-base);color:var(--text-primary);font-family:var(--font-sans);font-size:1rem;line-height:1.7;overflow-wrap:anywhere}body.site{background-image:radial-gradient(ellipse 70% 42rem at 50% -8rem,color-mix(in srgb, var(--kicker-blue) 12.9412%, transparent),transparent 70%),radial-gradient(ellipse 40% 30rem at 88% 10rem,color-mix(in srgb, var(--accent-green) 5.098%, transparent),transparent 70%);background-repeat:no-repeat}::selection{background:var(--accent-blue);color:var(--bg-base)}[hidden]{display:none!important}a{color:var(--accent-blue);text-decoration-thickness:.08em;text-underline-offset:.2em}a:hover{text-decoration-thickness:.14em}button,input,textarea,select{font:inherit}button,a,input,textarea,select,summary{-webkit-tap-highlight-color:transparent}button,summary,input[type=checkbox]{cursor:pointer}button:disabled,[aria-disabled=true]{cursor:not-allowed;opacity:.55}button{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--accent-amber);outline-offset:5px}img,video,canvas,svg{max-width:100%}img,video{height:auto}p,ul,ol,dl,pre,blockquote,table,figure{margin:0 0 1.4rem}h1,h2,h3,h4{line-height:1.15;letter-spacing:-.025em;text-wrap:balance}h1{font-size:clamp(2.5rem,6vw,5.25rem);font-weight:650;margin:.2em 0 .45em;max-width:20ch}h2{font-size:clamp(1.65rem,3vw,2.65rem);font-weight:620;margin:0 0 1.2rem}h3{font-size:1.25rem;margin:0 0 .8rem}h4{font-size:1.05rem}small{font-size:.85em}.container{width:min(var(--content-width),calc(100% - 4rem));max-width:var(--content-width);margin-inline:auto;padding-inline:0}.site-main{padding-block:2rem 5rem;min-height:50vh}.site-main:focus{outline:none}.site-main>*+*{margin-top:3rem}.skip-link{position:fixed;top:.75rem;left:1rem;z-index:1000;background:var(--accent-amber);color:var(--bg-base);padding:.75rem 1rem;transform:translateY(-200%);border-radius:.5rem}.skip-link:focus{transform:none}\n"
text sstutils ".site-utility{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem 1.3rem;width:min(78rem,calc(100% - 4rem));margin:1.5rem auto;color:var(--text-secondary);font: .8rem/1.5 var(--font-sans)}.site-utility a{color:var(--text-secondary);text-underline-offset:.25em}.site-index{border:1px solid var(--border-subtle);border-radius:.8rem;background:var(--bg-surface);padding:.7rem 1rem;max-width:40rem;margin-bottom:1.5rem;color:var(--text-secondary);font: .85rem/1.6 var(--font-sans)}.site-index summary{cursor:pointer;color:var(--text-primary);min-height:2rem}.site-index a{color:var(--accent-blue)}.site-index-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;padding-block:1rem}.site-index p{margin:.8rem 0 0}.site-index .aien-reach-foot{display:flex;flex-wrap:wrap;gap:.5rem 1rem}.site-utility a:focus-visible,.site-index a:focus-visible,.site-index summary:focus-visible{outline:3px solid var(--accent-amber);outline-offset:4px}\n"
text sstyle1 ".site-brand{display:inline-flex;align-items:center;gap:.85rem;color:var(--text-primary);font-weight:650;line-height:1.2;text-decoration:none}.breadcrumbs{padding-top:1rem;font-size:.85rem;color:var(--text-muted)}.breadcrumbs a{color:var(--text-secondary)}\n"
text sstyle2 ".page-intro{padding-block:2rem 1.8rem;max-width:65rem}.eyebrow,.kicker{font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;font-weight:650;color:var(--accent-violet);margin-bottom:1.2rem}.lede,.lead,.subtitle{font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.65;color:var(--text-secondary);max-width:58ch}.muted,.meta{color:var(--text-muted)}.prose{max-width:74ch}.prose p,.prose li{color:var(--text-secondary)}.prose h2{margin-top:2.8rem}.section{padding-block:1rem}.dashboard-grid,.card-grid,.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));gap:1.5rem;align-items:start}.panel,.hub-card,.research-status,.card,.evidence-card{background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--radius);padding:clamp(1.3rem,3vw,2rem);min-width:0}.panel>:last-child,.hub-card>:last-child,.card>:last-child{margin-bottom:0}.hub-card h2,.panel h2,.research-status h2{font-size:1.5rem}.hub-card a,.panel a{position:relative}.hub-card:focus-within,.panel:focus-within{border-color:var(--accent-blue)}.full-width{grid-column:1/-1}.stack{display:flex;flex-direction:column;gap:1.5rem}.cluster,.actions,.cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem}.button,button.button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.8rem;padding:.65rem 1.1rem;background:var(--accent-blue);color:var(--bg-base);border:1px solid var(--accent-blue);border-radius:.65rem;text-decoration:none;font-weight:650;line-height:1.4}.button:hover{background:var(--text-primary);border-color:var(--text-primary);text-decoration:none}.button-secondary,button.button-secondary{background:var(--bg-card);color:var(--text-primary);border-color:var(--border-subtle)}.button-secondary:hover{background:var(--bg-card-hover);color:var(--text-primary)}.badge,.status,.status-pill{display:inline-flex;align-items:center;gap:.4rem;padding:.2rem .65rem;border:1px solid var(--border-subtle);border-radius:2rem;color:var(--text-secondary);font-family:var(--font-mono);font-size:.75rem;line-height:1.6}.evidence,.source-link,.box-source,.boxlink-foot{color:var(--text-muted);font-size:.85rem}.source-link,.box-source,.boxlink-foot{display:block;margin-top:1.3rem}.evidence-ladder,.status-list{padding-left:1.4rem}.evidence-ladder li,.status-list li{padding:.4rem 0}.stat{padding:1rem;border-left:2px solid var(--accent-violet)}.stat strong{display:block;font-size:1.8rem;line-height:1.2;color:var(--text-primary)}.stat-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr))}.stat span{color:var(--text-secondary)}blockquote{border-left:2px solid var(--accent-violet);padding:1rem 1.5rem;color:var(--text-secondary);background:var(--bg-surface);border-radius:0 .8rem .8rem 0}blockquote p:last-child{margin-bottom:0}hr{border:0;border-top:1px solid var(--border-subtle);margin:3rem 0}code,kbd,samp,pre{font-family:var(--font-mono);font-size:.9em}code{color:var(--accent-green)}pre{background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:.8rem;padding:1.2rem;max-width:100%;overflow:auto;white-space:pre}pre code{color:var(--text-primary)}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--border-subtle);border-radius:.8rem}.table-wrap table{margin:0}table{border-collapse:collapse;width:100%;font-size:.9rem;text-align:left}th,td{padding:.85rem 1rem;border-bottom:1px solid var(--border-subtle);vertical-align:top}th{color:var(--text-primary);font-weight:650;background:var(--bg-surface)}td{color:var(--text-secondary)}caption{text-align:left;padding:1rem;color:var(--text-muted)}details{border:1px solid var(--border-subtle);border-radius:.9rem;background:var(--bg-surface);padding:1rem 1.3rem}details+details{margin-top:.9rem}details[open]>summary{margin-bottom:1.2rem}summary{font-weight:600;color:var(--text-primary);padding:.3rem;min-height:2.5rem}summary::marker{color:var(--accent-violet)}details>:last-child{margin-bottom:0}label{display:block;color:var(--text-secondary)}input:not([type=checkbox]):not([type=radio]),textarea,select{width:100%;max-width:100%;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--border-subtle);border-radius:.6rem;padding:.75rem}textarea{resize:vertical;min-height:8rem}input[type=checkbox],input[type=radio]{accent-color:var(--accent-blue);width:1.2rem;height:1.2rem;vertical-align:middle;margin-right:.6rem}\n"
text sstyle3 ".next-stops{padding-block:2.5rem 3.5rem;border-top:1px solid var(--border-subtle)}.next-stops h2{font-size:1.7rem}.trail-panel{padding-bottom:3.5rem}.trail-panel>details{max-width:65rem}.trail-opt{margin-bottom:1rem}.star-map{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.8rem 1.5rem}.star-map li{position:relative;padding-left:1rem}.star-map li::before{content:'';position:absolute;left:0;top:.65rem;width:.35rem;height:.35rem;border-radius:50%;background:var(--accent-violet)}#site-trail-draft{margin-top:1.5rem;border-top:1px solid var(--border-subtle);padding-top:1.5rem}#site-trail-draft textarea{margin-block:.7rem 1rem}.aien-footer{position:relative;border-top:1px solid var(--border-subtle);background:var(--bg-base);padding:3.5rem 0 6rem;color:var(--text-secondary);font-size:.9rem}.footer-intro{display:grid;gap:.8rem;margin-bottom:2rem}.footer-intro p{margin:0}.aien-reach-foot,.footer-quiet{display:flex;flex-wrap:wrap;gap:.7rem 1.4rem}.footer-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.7rem 1.2rem;margin-bottom:2.5rem}.footer-links a{color:var(--text-secondary)}.aien-footer-machines{font-size:.8rem}.footer-quiet{font-size:.8rem}.aien-footer .muted{font-size:.8rem;max-width:65ch}\n"
text sstyle4 "@media(max-width:52rem){.container,.site-utility{width:calc(100% - 2rem)}.site-main{padding-block:1rem 3rem}.site-main>*+*{margin-top:2rem}.page-intro{padding-top:1rem}.dashboard-grid,.card-grid{gap:1rem}.panel,.hub-card{padding:1.3rem}.next-stops{padding-block:2rem}.aien-footer{padding-top:2.5rem}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media(forced-colors:active){.panel,.hub-card,.button{border:1px solid CanvasText}.badge,.status{color:CanvasText}}@media print{body.site{background:white;color:black}.site-utility,.aien-footer,.next-stops,.trail-panel,.allen-launcher,.breadcrumbs{display:none!important}.container{width:100%}.site-main{padding:0}a{color:inherit}.panel,.hub-card,details{background:transparent;border-color:var(--turing-grey-53);color:black;break-inside:avoid}p,td{color:black}pre{white-space:pre-wrap}}\n"
note Turing look for the rendered pages: mono blue kickers, numbered ladder cards, source records and contact routes as quiet panels; engineer pages run edge to edge.
text ssturing ".site-main.site-bleed{width:auto;max-width:none;padding-block:0}.eyebrow{font-family:var(--font-mono);font-size:12px;font-weight:500;letter-spacing:.22em;color:var(--kicker-blue)}.evidence-ladder{list-style:none;padding:0;counter-reset:ladder;display:grid;gap:.6rem;max-width:46rem}.evidence-ladder li{counter-increment:ladder;position:relative;padding:.9rem 1.2rem .9rem 3.4rem;background:var(--bg-surface);border:1px solid var(--hairline);border-radius:14px;color:var(--text-secondary)}.evidence-ladder li::before{content:counter(ladder);position:absolute;left:1.25rem;top:.95rem;font:500 .8rem/1.6 var(--font-mono);color:var(--accent-green)}.evidence-ladder li strong{display:block;color:var(--text-primary)}dl.evidence{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:.3rem 1.25rem;max-width:46rem;padding:1rem 1.3rem;background:var(--bg-surface);border:1px solid var(--hairline);border-radius:14px;font:.78rem/1.6 var(--font-mono)}dl.evidence>div{display:contents}dl.evidence dt{color:var(--text-muted);letter-spacing:.08em}dl.evidence dd{margin:0;color:var(--text-secondary)}.panel dl.evidence{display:block;padding:0;border:0;background:none;font:.92rem/1.65 var(--font-sans)}.panel dl.evidence>div{display:block;margin-bottom:.9rem}.panel dl.evidence dt{font:500 11px/1.8 var(--font-mono);letter-spacing:.18em;text-transform:uppercase}dl.evidence dd ul{list-style:none;padding:0;margin:0;display:flex;flex-flow:row wrap;gap:.15rem 1rem}dl.evidence dd li{margin:0;font:.8rem/1.8 var(--font-mono)}dl.evidence a{display:inline;margin:0;font:inherit;color:var(--accent-blue)}dl.contact-routes{display:grid;grid-template-columns:minmax(8rem,12rem) minmax(0,1fr);column-gap:1.5rem;max-width:52rem}dl.contact-routes dt{grid-column:1;padding-top:1rem;border-top:1px solid var(--hairline);font:500 12px/1.9 var(--font-mono);letter-spacing:.22em;text-transform:uppercase;color:var(--kicker-blue)}dl.contact-routes dd{grid-column:2;margin:0;color:var(--text-secondary)}dl.contact-routes dt+dd{padding-top:1rem;border-top:1px solid var(--hairline);font-weight:600}dl.contact-routes dd:not(dt+dd){padding-bottom:1rem}main dl:not([class]) dt{margin-top:1.2rem;font-weight:700;color:var(--text-primary)}main dl:not([class]) dd{margin:.2rem 0 0;color:var(--text-secondary)}@media(max-width:52rem){dl.evidence,dl.contact-routes{grid-template-columns:minmax(0,1fr)}dl.contact-routes dt,dl.contact-routes dd{grid-column:1}dl.contact-routes dt+dd{padding-top:0;border-top:0}}\n"
note Site-wide notice bar and home block (Drake 2026-11-07): black on amber, 14:1 contrast, real text, both stylesheets.
text ssbanner ".so-banner{position:relative;z-index:200;background:var(--notice-amber);color:var(--bg-base);border-bottom:2px solid var(--bg-base);padding:.65rem 1rem;text-align:center;font:600 1rem/1.45 var(--font-sans)}.so-banner p{margin:0 auto;max-width:none;color:var(--bg-base)}.so-banner strong{font-weight:800}.so-banner a{color:var(--bg-base);text-decoration:underline;text-underline-offset:.2em;white-space:nowrap}.so-banner a:focus-visible{outline:3px solid var(--bg-base);outline-offset:2px}.so-hero{margin:1.5rem 0 2rem;padding:clamp(1.2rem,3vw,2rem);border:2px solid var(--notice-amber);border-radius:var(--radius,1rem);background:var(--bg-surface)}.so-hero h2{margin:0 0 .6rem;font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.15;color:var(--notice-amber)}.so-hero p{color:var(--text-primary);max-width:62ch}.so-hero .cluster{margin-top:1rem}.so-rids{margin:1rem 0 1.5rem}.so-rids th,.so-rids td{padding:.45rem .6rem;border-bottom:1px solid var(--border-subtle);vertical-align:top}.so-rids code{word-break:break-all}\n"
fn css_emit to void
sr_raw sstutils
sr_raw sstyle0
sr_raw sstyle1
sr_raw sstyle2
sr_raw sstyle3
sr_raw sstyle4
sr_raw ssturing
sr_raw ssbanner
end

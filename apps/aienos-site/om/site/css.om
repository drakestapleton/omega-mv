sr_raw sstoken
sr_raw sspal
sr_raw sstold
end

note Native door CSS budget <= 12288 raw bytes, including quiet controls; no external assets.
text ssdoor "/* Native Aien entry controls only; scene and panes belong to AllenPresence. */\nbody{margin:0;background:var(--bg-base);color:var(--text-primary);font-family:var(--font-sans)}[hidden]{display:none!important}.site-native{margin:0;padding:0}.site-utility{position:fixed;top:1rem;left:1rem;z-index:160;width:auto;max-width:calc(100% - 9rem);margin:0;font-size:.75rem;gap:.5rem 1rem}.site-utility a{background:var(--bg-base);padding:.25rem .4rem;border-radius:.3rem}.site> .site-index{position:fixed;right:1rem;top:1rem;z-index:170;max-width:min(35rem,calc(100% - 2rem));max-height:70vh;overflow:auto;margin:0}.site> .site-index:not([open]){padding:.35rem .6rem;background:var(--bg-base)}.site-index summary{min-height:1.8rem}.site-index-links{grid-template-columns:repeat(3,minmax(0,1fr))}.skip-link{position:fixed;left:1rem;top:1rem;z-index:200;transform:translateY(-200%);background:var(--accent-amber);color:var(--bg-base);padding:.6rem}.skip-link:focus{transform:none}.home-door{position:fixed;inset:4.5rem 0 0;z-index:130;pointer-events:none;color:var(--text-primary);font-family:var(--font-sans)}.home-door a,.home-door button{pointer-events:auto}.door-skip{position:absolute;right:1rem;top:0;padding:.5rem .8rem;background:var(--bg-base);border:1px solid var(--border-subtle);border-radius:2rem;color:var(--text-primary);font-size:.85rem;text-decoration:none}.door-invitation{position:absolute;bottom:6vh;left:50%;transform:translateX(-50%);width:min(36rem,calc(100% - 2rem));text-align:center;padding:1.25rem;border-radius:1.5rem;background:color-mix(in srgb,var(--bg-base) 90%,transparent)}.door-invitation h2{font-size:clamp(2rem,5vw,3.8rem);font-weight:450;line-height:1.1;margin:0 0 .8rem}.door-invitation p{line-height:1.5;font-size:.9rem;margin:.6rem 0;color:var(--text-secondary)}.door-invitation button,.site-choice-actions button,.site-choice-actions a{font:inherit;display:inline-flex;justify-content:center;align-items:center;border:1px solid var(--border-subtle);border-radius:2rem;padding:.7rem 1.2rem;background:var(--bg-card);color:var(--text-primary);text-decoration:none;cursor:pointer}.door-invitation button:disabled{opacity:.5;cursor:wait}.door-invitation .door-note{font-size:.75rem;color:var(--text-muted)}.home-door[data-playing=true] .door-invitation h2,.home-door[data-playing=true] .door-note{display:none}.home-door[data-playing=true] .door-invitation{bottom:2rem;padding:.65rem 1rem;width:auto;max-width:calc(100% - 2rem)}.site-mode-choice{position:fixed;z-index:135;bottom:8rem;left:50%;transform:translateX(-50%);width:min(43rem,calc(100% - 2rem));max-height:calc(100dvh - 13rem);overflow:auto;padding:1.5rem 1.7rem;background:color-mix(in srgb,var(--bg-surface) 96%,transparent);border:1px solid var(--border-subtle);border-radius:1.5rem;font-size:1rem;line-height:1.6}.site-mode-choice p{margin:0 0 1.2rem}.site-choice-actions{display:flex;flex-wrap:wrap;gap:.75rem}.site-choice-actions button{background:var(--accent-blue);color:var(--bg-base);border-color:var(--accent-blue)}.site-welcome-status{position:fixed;z-index:125;left:1rem;top:4rem;max-width:32ch;padding:.4rem .65rem;background:var(--bg-base);border-radius:.5rem;color:var(--text-secondary);font-size:.85rem;pointer-events:none}.home-door a:focus-visible,.home-door button:focus-visible,.site-mode-choice a:focus-visible,.site-mode-choice button:focus-visible{outline:3px solid var(--accent-amber);outline-offset:4px}@media(max-width:40rem){.site-utility{font-size:.7rem;max-width:calc(100% - 8rem);gap:.25rem .5rem}.site> .site-index{font-size:.75rem}.site-mode-choice{bottom:7.5rem;max-height:calc(100dvh - 12rem);padding:1.1rem;font-size:.9rem}.door-invitation{bottom:2rem}.site-welcome-status{font-size:.75rem;top:5rem}}@media(prefers-reduced-motion:reduce){.home-door *,.site-mode-choice *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media(forced-colors:active){.door-invitation,.site-mode-choice{background:Canvas;color:CanvasText;border:1px solid CanvasText}}\n"
fn door_css to void
sr_raw sstutils
sr_raw ssdoor
sr_raw ssbanner
end

text semobile "/* Generated by om/site/css.om. Phone navigation needs no horizontal panning. */\n@media(max-width:1100px){\n.engineer .uni-scroll{overflow:visible;padding:1rem var(--gutter,20px)}\n.engineer .uni-map{min-width:0;width:100%;aspect-ratio:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}\n.engineer .uni-sky{display:none}\n.engineer .planet{position:static;inset:auto;transform:none;width:auto;min-width:0;min-height:6.5rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:.65rem;padding:.75rem;border:1px solid var(--line-strong);border-radius:1rem;background:var(--u-card)}\n.engineer .planet-disc{width:2.5rem;height:2.5rem;flex:0 0 2.5rem;margin:0}\n.engineer .planet-name{white-space:normal;max-width:none;text-align:left;font-size:.9rem;overflow-wrap:anywhere}\n.engineer .planet:focus-visible{outline:3px solid var(--u-gold);outline-offset:3px}\n.engineer .uni-panel{min-width:0;overflow:visible}\n.engineer .uni-cta{display:grid;grid-template-columns:1fr;width:100%}\n.engineer .uni-btn,.engineer .world-go,.engineer .world-close{min-height:44px;display:inline-flex;align-items:center;justify-content:center;white-space:normal;line-height:1.4}\n.engineer .world-nav{flex-wrap:wrap}\n.engineer .world-nav a{min-height:44px;display:flex;align-items:center}\n.engineer .uni-hint{display:none}\n.engineer .uni-legend::after{content:\"Tap a topic to read more.\";display:block;width:100%}\n}\n@media(max-width:360px){.engineer .uni-map{grid-template-columns:minmax(0,1fr)}}\n"
text sempath "assets/engineer-mobile.css"
text shrestor "/* Generated by om/site/css.om. Restore the site's familiar header. */\n.aien-header details{padding:0;border:0;border-radius:0;background:transparent}\n.aien-header summary{min-height:0;padding:0;font-weight:inherit}\n.aien-header details[open]>summary{margin-bottom:0}\n.aien-header .aien-nav-more-button{padding:8px 12px}\n.aien-header .aien-nav-panel{max-height:75vh;overflow-y:auto}\n.aien-header .aien-nav-panel ul{margin:0;padding:0;list-style:none}\n.aien-header .aien-brand{min-width:0}\n@media(max-width:600px){.aien-header .aien-brand-tag{display:none}.aien-header .aien-header-inner{gap:8px}.aien-header .aien-brand-name{font-size:1rem}.aien-header .aien-nav-panel{position:fixed;top:4.5rem;left:1rem;right:1rem;width:auto;max-width:none}}\n"
text shrpath "assets/home-restored.css"
note Finish pass (L1053, 2026-11-09): phone tap targets, 16px body copy, AA contrast, no sideways scroll; appended last so it wins the cascade on every page that loads the restored header sheet.
text sfinish "/* Generated by om/site/css.om. Finish pass: 44px targets, 16px body copy, AA contrast, no sideways scroll. Site tokens only. */\n.aien-header{padding:8px 0}\n.aien-header .aien-brand{min-height:44px}\n.aien-header .aien-nav-more-button{height:44px;min-height:44px;padding:0 14px}\n.aien-nav a.aien-nav-link{padding:12px 0}\n.aien-nav a.aien-x-link.aien-x-button{width:44px;height:44px;font-size:0;line-height:0}\n.aien-x-button .aien-x-mark{width:16px;height:16px}\n.aien-header .aien-nav-panel ul{gap:0}\n.aien-header .aien-nav-panel a.aien-nav-minor{display:flex;align-items:center;min-height:44px;padding:0 6px;font-size:14px}\n.aien-footer,.aien-footer .site-index,.aien-footer .aien-reach-foot{font-size:1rem}\n.aien-footer a.site-brand{display:inline-flex;align-items:center;min-height:44px}\n.aien-footer .footer-links{gap:0 1.2rem}\n.aien-footer .site-index-links{gap:0 .75rem;padding-block:.25rem}\n.aien-footer .aien-reach-foot{gap:0 1.4rem}\n.aien-footer .footer-links a,.aien-footer .site-index-links a,.aien-footer .aien-reach-foot a{display:inline-flex;align-items:center;min-height:44px}\n.aien-footer .site-index summary{display:flex;align-items:center;min-height:44px}\nbody.site .hub-card p,body.site .rs-card-callout,body.site .rs-step-detail,body.site .rs-sources p,body.site .rs-sources li,body.site .decisions li a,body.site .theory-fig figcaption,body.site .loop-caption,body.site .live-head p,body.site .narr-loop li,body.site .alpha-scene figcaption,body.site .rs-facts,body.site .receipt,body.site .step-card p,body.site .rung p,body.site .explain,body.site .engineer .stat-label,body.site .panel dl.evidence,body.site dl.evidence dd li{font-size:1rem}\nbody.site .rs-current{font-size:1.125rem}\nhtml[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 13px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 14px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 15px\"]{font-size:1rem!important}\nbody.site #tg-zero,body.site #tg-one,body.site #tg-reset,body.site .terminal-shell button,body.site #turing-game button{min-height:44px;min-width:44px;padding:.5rem 1rem}\nbody.site .blog-read-more,body.site .engineer .card-link,body.site .film-cap a{display:inline-flex;align-items:center;min-height:44px}\nbody.site input[type=range]{height:44px;padding:18px 0;background-clip:content-box}\nbody.site .button:not(.button-secondary){background:color-mix(in srgb,var(--accent-blue) 14%,transparent);border-color:var(--tl-blue,var(--accent-blue));color:var(--accent-blue)}\nbody.site .button:not(.button-secondary):hover{background:color-mix(in srgb,var(--accent-blue) 28%,transparent);border-color:var(--accent-blue);color:var(--text-primary)}\nbody.site .scroll-cue,body.site .meter .cap,body.site .duel .who,body.site .tfoot,body.site .rule-btn .rl,body.site .film-cap,body.site .film-cap a{color:var(--text-muted)}\nbody.site .home-q-badge.status-experimental{color:var(--accent-blue)}\nbody.site .wrap .source-tag{font-size:12px}\nbody.site .hero-inner{position:relative;z-index:2}\n@media(max-width:52rem){body.site .container{width:calc(100% - 2.5rem);padding-inline:0}body.site .aien-header-inner{padding:0 20px}body.site .hero{padding-inline:20px}}\n@media(max-width:700px){body.site .glow-box>div[style*=\"minmax(320px\"]{grid-template-columns:minmax(0,1fr)!important}body.site .pdf-button{white-space:normal;max-width:100%}}\n@media(max-width:640px){body.site .hero #field{opacity:.5}body.site .engineer .uni-intro h1{margin-top:4rem}}\n@media(max-width:600px){body.site .terminal-status{display:none!important}}\nbody.site dl.evidence dd,body.site .ncard p,body.site .doc p,body.site .wrap .stat p,body.site .wrap .note,body.site .tfoot{font-size:1rem}\nhtml[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 13.5px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 14.5px\"]{font-size:1rem!important}\nbody.site .wrap .index-links a,body.site .wrap .source-tag,body.site #root .cluster a,html[lang=zh-CN] body.site .glow-box a:not(p a),.aien-footer .footer-quiet a{display:inline-flex;align-items:center;min-height:44px}\nbody.site .wrap .index-links a{padding:0 .5rem}\nbody.site .tfoot a{display:inline-block;padding:.5rem 0;margin:-.5rem 0}\nbody.site .rs-card summary{display:flex;align-items:center;min-height:44px}\nbody.site .section>a.box-link,body.site main>a.box-link{position:relative;min-height:44px}\n.aien-header .aien-nav-panel ul{align-items:stretch}\n.aien-header .aien-nav-panel li,.aien-header .aien-nav-panel a.aien-nav-minor{width:100%}\nbody.site .button:not(.button-secondary),body.site .home-q-badge.status-experimental{color:var(--tl-blue-soft,var(--accent-blue))}\nbody.site:has(.signal-band){--paper:var(--plc-grey-6);--ink:var(--plc-grey-93);--muted:var(--plc-grey-69);--line:var(--plc-teal-23);--line-strong:var(--plc-grey-45);--surface:var(--plc-grey-9);--surface-2:var(--plc-teal-12);--deep:var(--plc-teal-7);--deep-ink:var(--plc-grey-95-2);--green:var(--plc-teal-56);--green-2:var(--plc-teal-66);--coral:var(--plc-red-70);--gold:var(--plc-orange-60)}\nbody.site .wrap .kicker{color:var(--green-2)}\nbody.site .alpha-steps p,body.site .alpha-evidence p,body.site .alpha-small,body.site .now-sub,body.site .now-note,body.site .now-done,body.site .now-give-note,body.site .now-stamp,body.site .now-give p,body.site .now-give li,body.site .entry .desc,body.site #aien-growth-observatory .text-small,body.site .note,body.site p.wa-note,body.site p.wa-venue,body.site p.fine,body.site .hive-small,body.site .hive-coverage,body.site .hive-source-note,body.site .hive-note,body.site .hive-empty,body.site .hive-omega-note,body.site .lab-small,body.site .lab-status,body.site .dash-warn,body.site .agora-view-desc,body.site .rs-card-plain,body.site .rs-impl-scope,body.site dd.rs-mono{font-size:1rem}\nbody.site .alpha-scroll,body.site .alpha-links a,body.site .footer-note a,body.site a.source-link:not(.box-link),body.site .hive-omega-source,body.site .ag-evidence a{display:inline-flex;align-items:center;min-height:44px}\nbody.site #aien-growth-observatory #ag-refresh,body.site summary.cursor-interaction,body.site .agora-room-tab,body.site .agora-btn,body.site input[type=range]{min-height:44px}\nbody.site #agora-submit-btn{min-width:44px}\nbody.site .research-wrap .section p,body.site .tenets li,body.site p.evidence,body.site .rs-attempt p,body.site .learn-page .learn-small,body.site .learn-example-label,body.site .sb-small,body.site .now-queue-item,body.site .now-row-note,body.site .now-row-done,body.site .now-tl-item,body.site .now-tl-evidence,body.site .now-ref,body.site .home-floor-note,body.site span.rs-mono,body.site .artifact a{font-size:1rem}\nbody.site .hive-jumps a{font-size:.875rem;padding:0 .5rem}\nbody.site .now-give-btn code{color:inherit}\nbody.site li.hub-card>a,body.site .learn-jump a,body.site .learn-text-link,body.site .hive-select,body.site .hive-jumps a,body.site .artifact a{display:inline-flex;align-items:center;min-height:44px}\nbody.site .rs-impl-item summary{display:flex;align-items:center;min-height:44px}\nbody.site .engineer .uni-btn{min-height:44px}\nbody.site .wrap .source-tag{min-width:44px}\nbody.site .engineer .wa-paper p,body.site .engineer .wa-paper .wa-venue,body.site .engineer .wa-layers li{font-size:1rem}\nbody.site .hub-card h3>a{display:inline-flex;align-items:center;min-height:44px}\n"
note Phone residuals (bay 1 F3 on f7bc60e1, 2026-11-10): plain content links in cards and link lists reach 44px, body notes 16px; /now/, /aien/, /hive/, the engineer galaxy and form controls keep their own styles.
text sphone "/* Generated by om/site/css.om. Phone residuals: plain content links reach 44px and body notes 16px. Component styles untouched. */\nbody.site :is(.hub-card,.rs-card,.rs-step-body,.rs-impl-item,.receipt,.blog-card)>a.box-link{min-height:44px}\nbody.site article.hub-card>a:not(.box-link),body.site nav.cluster>a,body.site p.support-links>a,body.site p.learn-source-links>a,body.site nav.om-toc>a{display:flex;align-items:center;min-height:44px}\nbody.site div.agora-subnav>a,body.site nav.blog-crumb>a{display:inline-flex;align-items:center;min-height:44px}\nbody.site .hub-card h3>a{min-width:44px}\nbody.site details.section>summary{min-height:44px}\nbody.site .proof-mini p,body.site .learning p,body.site .roadmap-head p,html[lang=zh-CN] body.site .glow-box div[style*=\"font-size: 13.5px\"]>p{font-size:1rem}\n"
note Reading-text design pass (NEXT row 29, mac-ham/AienosFinish, 2026-11-10): the type scale, 8px rhythm, section hairline and quieter phone hero of previews 07634473 and 36aa2a97, rewritten on explicit reading-text selectors (direct h1/h2/h3/p/li children of prose blocks) instead of the .restored-main wrapper that bay 3 (62ff4849) measured changing 4,995 component properties; gate: bay 3 probe-specificity.mjs base vs tip with zero component changes. Appended after sphone so it wins the cascade.
text sone "/* Generated by om/site/css.om. Reading-text design pass: one type scale (page title 36/40, then 28/36, 20/28, lede 18/28, body line 28), an 8px rhythm for the space between blocks, a hairline between prose sections, a quieter phone hero. It names only page titles and unclassed headings, paragraphs and plain list items that are direct children of prose blocks, so cards, card grids, badges, definition lists, kickers, bylines, page components, /agents/, /now/ and /research/status/ keep their styles. Site tokens only. */\nbody.site :is(.research-wrap>h1,.narr-column>.narr-header>h1,:is(article,div,section).prose:not(.agents-page)>h1,.blog-wrap>h1,:where(main:not(:has(.rs-card,.agents-page,.now-card,#factory-floor))) .page-intro:not(.learn-intro)>h1){font-size:2.25rem;line-height:2.5rem;letter-spacing:-.02em;margin:0 0 1rem;max-width:22ch;text-wrap:balance}\nbody.site :is(.research-wrap>.section,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]))>h2:not([class]):not(:has(.rs-badge)){font-size:1.75rem;line-height:2.25rem;letter-spacing:-.015em;margin:3rem 0 1rem;text-wrap:balance}\nbody.site :is(.research-wrap>.section,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]))>h3:not([class]):not(:has(.rs-badge)){font-size:1.25rem;line-height:1.75rem;margin:2rem 0 .5rem}\nbody.site :is(.research-wrap>.section,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]))>:is(h2,h3):not([class]):first-child{margin-top:0}\nbody.site :is(.research-wrap,.research-wrap>.section,.narr-column>.narr-header,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]),:where(main:not(:has(.rs-card,.agents-page,.now-card,#factory-floor))) .page-intro:not(.learn-intro))>p:not([class]){line-height:1.75rem;max-width:68ch}\nbody.site :is(.research-wrap>.section,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]))>:is(ul,ol):not([class])>li:not([class]){line-height:1.75rem;max-width:68ch}\nbody.site :where(main:not(:has(.rs-card,.agents-page,.now-card,#factory-floor))) .page-intro:not(.learn-intro)>p.lede{font-size:1.125rem;line-height:1.75rem;max-width:60ch}\nbody.site :is(.research-wrap>.section+.section,.narr-column>.narr-section+.narr-section,section.section.prose+section.section.prose){border-top:1px solid var(--border-subtle);padding-top:2rem}\n@media(max-width:600px){body.site :is(.research-wrap>h1,.narr-column>.narr-header>h1,:is(article,div,section).prose:not(.agents-page)>h1,.blog-wrap>h1,:where(main:not(:has(.rs-card,.agents-page,.now-card,#factory-floor))) .page-intro:not(.learn-intro)>h1){font-size:2rem;line-height:2.5rem}body.site :is(.research-wrap>.section,.narr-column>.narr-section,:is(article,div,section).prose:not(.agents-page),.blog-wrap>article:not([class]))>h2:not([class]):not(:has(.rs-badge)):not(:first-child){margin-top:2.5rem}body.site .restored-main>.hero{min-height:auto;padding-block:4rem 3rem}body.site .restored-main>.hero #field{opacity:.5}body.site .restored-main>.hero .scroll-cue{display:none}}"
note Phone residuals round 2 (bay 1 F3 residuals in AIENOS-STATE, mac-ham/AienosFinish, 2026-11-10): the remaining plain links and controls measured below 44px at 390 px on /dash/, /discoveries/ (card links alone in a paragraph), /lab/, /hive/ closing links, zh-CN receipt links, the /agora/ remember label, blog crumbs, the /post-llm-case/ section index and /progress/ legend, event and pin links. Not /now/, /research/status/ or /agents/ lists (the design-pass gate keeps them unchanged), not /aien/ (its own experience) and not the engineer galaxy (Drake's ruling).
text sf3 "/* Generated by om/site/css.om. Phone residuals, round 2 (bay 1 F3): the remaining plain links and controls on reading pages reach 44px. /now/, /research/status/, /agents/ lists and the engineer galaxy keep their own styles; /aien/ has its own rules in allen-panes.css. Site tokens only. */\nbody.site article.dash-card>a.box-link,body.site article.hub-card>p>a:only-child{display:flex;align-items:center;min-height:44px}\nbody.site footer.hive-closing>a{display:inline-flex;align-items:center;min-height:44px}\nbody.site div.lab-pane-h>a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px}\nhtml[lang=zh-CN] body.site div[style*=\"font-size: 12px\"]>a[href^=\"https://interplane.io/drakestapleton/\"]{display:inline-flex;align-items:center;min-height:44px}\nhtml[lang=zh-CN] body.site a[target=_blank][style*=\"padding: 10px 20px\"]{display:inline-flex;align-items:center;min-height:44px}\nbody.site label.agora-remember-label{display:inline-flex;align-items:center;gap:8px;min-height:44px}\nbody.site :is(#agora-remember,#hive-motion,form label>input[type=checkbox]){width:44px;height:44px;flex:none}\nbody.site nav.blog-crumb>a{min-width:44px;justify-content:center}\nbody.site nav.top-index .index-mark{flex:none}\nbody.site nav.top-index .index-links{overflow-x:auto}\nbody.site nav.top-index .index-links>a{flex:none;min-width:44px;line-height:44px;text-align:center}\nbody.site #aien-growth-observatory .ag-legend{min-height:44px;min-width:44px}\nbody.site #aien-growth-observatory a.text-small{display:inline-flex;align-items:center;min-height:44px}\nbody.site #aien-growth-observatory .ag-pin{flex-wrap:wrap}\nbody.site #aien-growth-observatory .ag-pin a{flex:none;display:inline-flex;align-items:center;min-height:44px}"
note Interaction polish (r6, mac-ham/AienosFinish.PolishR6, 2026-11-10): 150 ms colour/opacity transitions at zero specificity on every control without its own, an opacity press state, hover states for the plain links, summaries and form controls that had none, 2px focus rings where none showed, 44 px for the remaining standalone links and controls, 11 px for the last labels under it, the research diagrams at their drawn size with sideways pan on phones, and a legible, fitted infographic receipt. Brand book motion and focus rules; site tokens only; emitted after sf3.
text spolish "/* Generated by om/site/css.om. Interaction polish (r6, 2026-11-10): every link, button, summary and form control eases colour, background, border and opacity over 150 ms wherever no other rule sets its transition (zero specificity), and answers a press with opacity; the plain links, summaries and form controls that had no hover state get a colour or edge change from the site tokens, and the few focusable controls with no visible focus get a 2px ring. No shadows, transforms or layout properties; reduced motion turns the transitions off. /now/, /research/status/ and the /agents/ list keep their own styles; the engineer galaxy keeps its look; /aien/ is styled in allen-panes.css. Site tokens only. */\n:where(a[href],button,summary,input,select,textarea,[role=button]){transition:color 150ms,background-color 150ms,border-color 150ms,opacity 150ms}\n:where(a[href],button,summary,[role=button],select,input[type=checkbox],input[type=radio],input[type=range],input[type=submit],input[type=button]):where(:active){opacity:.72}\n@media(prefers-reduced-motion:reduce){:where(a[href],button,summary,input,select,textarea,[role=button]){transition:none}}\nbody.site details.site-index>summary:hover,body.site:not(:has(#ladder,.now-card,.agents-page)) :is(article.rs-card,li.rs-impl-item)>details>summary:hover,body.site main.restored-main>details.section>summary:hover,body.site section.lab-section>details.lab-be>summary:hover,body.site div.ag-events>details.ag-event>summary:hover,body.site div>details.ag-methods>summary:hover,body.site :is(div.alpha-capture>details,details.alpha-source)>summary:hover{color:var(--accent-blue)}\nbody.site :is(div.artifact,div.footer-note,nav.blog-crumb,div.desc,div.section>p,article.wa-paper>p)>a:hover,body.site main.restored-main>footer.tfoot>a:hover{color:var(--accent-blue);text-decoration-line:underline}\nbody.site:not(:has(#ladder,.now-card,.agents-page)) :is(article.rs-card,li.rs-impl-item,div.rs-step-body,article.receipt,article.dash-card,article.blog-card,main.restored-main>section.section)>a.box-link:hover,body.site:not(:has(#ladder,.now-card,.agents-page)) section.section>a.box-link:hover{color:var(--text-primary)}\nbody.site :is(div.terminal-shell,div.panel) button:hover,body.site div.ag-legends>button.ag-legend:hover,body.site div.hive-conversation-controls>button:hover,body.site :is(header.alpha-hero>div.alpha-install,figure.alpha-scene)>button:hover{border-color:var(--accent-blue);color:var(--text-primary)}\nbody.site :is(div.terminal-shell>form>input,form.hub-card>label>input,div.lab-panel>input,div.ag-nav>input.form-range,div.hive-search>input,input.hive-motion-check,form.agora-form :is(input,select,textarea)):hover{border-color:var(--accent-blue)}\nbody.site :is(div.lab-panel>input,div.terminal-shell>form>input):focus-visible,body.site div.uni-map>a.planet:focus-visible{outline:2px solid var(--accent-blue);outline-offset:2px}\nbody.site p.aien-footer-machines>a,body.site p.engineer-back>a,body.site h2.dash-h>a,body.site span.repo>a,body.site h2.blog-card-title>a,body.site article.pillar-card>h2>a,html[lang=zh-CN] body.site a[href=\"#follow\"]{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;box-sizing:border-box}\n#aien-growth-observatory div.ag-event>a.ag-event-title{min-height:44px;align-items:center}\nbody.site:not(:has(#ladder,.now-card,.agents-page)) :is(article.receipt>p.badge,article.hub-card>a.box-link,div.rs-step-head>span.rs-here,h2>span.rs-badge,dt>span.rs-badge,p.home-q-measure>span.home-q-badge){font-size:11px}\n@media(max-width:700px){body.site figure.theory-fig,body.site div.reveal:has(>svg[viewBox=\"0 0 900 340\"]){overflow-x:auto;overscroll-behavior-x:contain}body.site figure.theory-fig>svg,body.site div.reveal>svg[viewBox=\"0 0 900 340\"]{min-width:1024px}}\nhtml[lang=zh-CN] body.site div>code{font-size:max(11px,.9em)}\nbody.site .engineer-infographic article.receipt>.receipt-head>strong{color:var(--text-primary)}\nbody.site .engineer-infographic .receipt-layout>*{min-width:0}\nbody.site .engineer-infographic article.receipt{overflow-wrap:anywhere}"

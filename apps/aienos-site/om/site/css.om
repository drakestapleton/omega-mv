note Native door CSS budget <= 12288 raw bytes, including quiet controls; no external assets.
text ssdoor "/* Native Aien entry controls only; scene and panes belong to AllenPresence. */\nbody{margin:0;background:var(--bg-base);color:var(--text-primary);font-family:var(--font-sans)}[hidden]{display:none!important}.site-native{margin:0;padding:0}.site-utility{position:fixed;top:1rem;left:1rem;z-index:160;width:auto;max-width:calc(100% - 9rem);margin:0;font-size:.75rem;gap:.5rem 1rem}.site-utility a{background:var(--bg-base);padding:.25rem .4rem;border-radius:.3rem}.site> .site-index{position:fixed;right:1rem;top:1rem;z-index:170;max-width:min(35rem,calc(100% - 2rem));max-height:70vh;overflow:auto;margin:0}.site> .site-index:not([open]){padding:.35rem .6rem;background:var(--bg-base)}.site-index summary{min-height:1.8rem}.site-index-links{grid-template-columns:repeat(3,minmax(0,1fr))}.skip-link{position:fixed;left:1rem;top:1rem;z-index:200;transform:translateY(-200%);background:var(--accent-amber);color:var(--bg-base);padding:.6rem}.skip-link:focus{transform:none}.home-door{position:fixed;inset:4.5rem 0 0;z-index:130;pointer-events:none;color:var(--text-primary);font-family:var(--font-sans)}.home-door a,.home-door button{pointer-events:auto}.door-skip{position:absolute;right:1rem;top:0;padding:.5rem .8rem;background:var(--bg-base);border:1px solid var(--border-subtle);border-radius:2rem;color:var(--text-primary);font-size:.85rem;text-decoration:none}.door-invitation{position:absolute;bottom:6vh;left:50%;transform:translateX(-50%);width:min(36rem,calc(100% - 2rem));text-align:center;padding:1.25rem;border-radius:1.5rem;background:color-mix(in srgb,var(--bg-base) 90%,transparent)}.door-invitation h1{font-size:clamp(2rem,5vw,3.8rem);font-weight:450;line-height:1.1;margin:0 0 .8rem}.door-invitation p{line-height:1.5;font-size:.9rem;margin:.6rem 0;color:var(--text-secondary)}.door-invitation button,.site-choice-actions button,.site-choice-actions a{font:inherit;display:inline-flex;justify-content:center;align-items:center;border:1px solid var(--border-subtle);border-radius:2rem;padding:.7rem 1.2rem;background:var(--bg-card);color:var(--text-primary);text-decoration:none;cursor:pointer}.door-invitation button:disabled{opacity:.5;cursor:wait}.door-invitation .door-note{font-size:.75rem;color:var(--text-muted)}.home-door[data-playing=true] .door-invitation h1,.home-door[data-playing=true] .door-note{display:none}.home-door[data-playing=true] .door-invitation{bottom:2rem;padding:.65rem 1rem;width:auto;max-width:calc(100% - 2rem)}.site-mode-choice{position:fixed;z-index:135;bottom:8rem;left:50%;transform:translateX(-50%);width:min(43rem,calc(100% - 2rem));max-height:calc(100dvh - 13rem);overflow:auto;padding:1.5rem 1.7rem;background:color-mix(in srgb,var(--bg-surface) 96%,transparent);border:1px solid var(--border-subtle);border-radius:1.5rem;font-size:1rem;line-height:1.6}.site-mode-choice p{margin:0 0 1.2rem}.site-choice-actions{display:flex;flex-wrap:wrap;gap:.75rem}.site-choice-actions button{background:var(--accent-blue);color:var(--bg-base);border-color:var(--accent-blue)}.site-welcome-status{position:fixed;z-index:125;left:1rem;top:4rem;max-width:32ch;padding:.4rem .65rem;background:var(--bg-base);border-radius:.5rem;color:var(--text-secondary);font-size:.85rem;pointer-events:none}.home-door a:focus-visible,.home-door button:focus-visible,.site-mode-choice a:focus-visible,.site-mode-choice button:focus-visible{outline:3px solid var(--accent-amber);outline-offset:4px}@media(max-width:40rem){.site-utility{font-size:.7rem;max-width:calc(100% - 8rem);gap:.25rem .5rem}.site> .site-index{font-size:.75rem}.site-mode-choice{bottom:7.5rem;max-height:calc(100dvh - 12rem);padding:1.1rem;font-size:.9rem}.door-invitation{bottom:2rem}.site-welcome-status{font-size:.75rem;top:5rem}}@media(prefers-reduced-motion:reduce){.home-door *,.site-mode-choice *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media(forced-colors:active){.door-invitation,.site-mode-choice{background:Canvas;color:CanvasText;border:1px solid CanvasText}}\n"
fn door_css to void
sr_raw sstutils
sr_raw ssdoor
sr_raw ssbanner
end

text semobile "/* Generated by om/site/css.om. Phone navigation needs no horizontal panning. */\n@media(max-width:1100px){\n.engineer .uni-scroll{overflow:visible;padding:1rem var(--gutter,20px)}\n.engineer .uni-map{min-width:0;width:100%;aspect-ratio:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}\n.engineer .uni-sky{display:none}\n.engineer .planet{position:static;inset:auto;transform:none;width:auto;min-width:0;min-height:6.5rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:.65rem;padding:.75rem;border:1px solid var(--line-strong);border-radius:1rem;background:var(--u-card)}\n.engineer .planet-disc{width:2.5rem;height:2.5rem;flex:0 0 2.5rem;margin:0}\n.engineer .planet-name{white-space:normal;max-width:none;text-align:left;font-size:.9rem;overflow-wrap:anywhere}\n.engineer .planet:focus-visible{outline:3px solid var(--u-gold);outline-offset:3px}\n.engineer .uni-panel{min-width:0;overflow:visible}\n.engineer .uni-cta{display:grid;grid-template-columns:1fr;width:100%}\n.engineer .uni-btn,.engineer .world-go,.engineer .world-close{min-height:44px;display:inline-flex;align-items:center;justify-content:center;white-space:normal;line-height:1.4}\n.engineer .world-nav{flex-wrap:wrap}\n.engineer .world-nav a{min-height:44px;display:flex;align-items:center}\n.engineer .uni-hint{display:none}\n.engineer .uni-legend::after{content:\"Tap a topic to read more.\";display:block;width:100%}\n}\n@media(max-width:360px){.engineer .uni-map{grid-template-columns:minmax(0,1fr)}}\n"
text sempath "assets/engineer-mobile.css"
text shrestor "/* Generated by om/site/css.om. Restore the site's familiar header. */\n.aien-header details{padding:0;border:0;border-radius:0;background:transparent}\n.aien-header summary{min-height:0;padding:0;font-weight:inherit}\n.aien-header details[open]>summary{margin-bottom:0}\n.aien-header .aien-nav-more-button{padding:8px 12px}\n.aien-header .aien-nav-panel{max-height:75vh;overflow-y:auto}\n.aien-header .aien-nav-panel ul{margin:0;padding:0;list-style:none}\n.aien-header .aien-brand{min-width:0}\n@media(max-width:600px){.aien-header .aien-brand-tag{display:none}.aien-header .aien-header-inner{gap:8px}.aien-header .aien-brand-name{font-size:1rem}.aien-header .aien-nav-panel{position:fixed;top:4.5rem;left:1rem;right:1rem;width:auto;max-width:none}}\n"
text shrpath "assets/home-restored.css"
note Finish pass (L1053, 2026-11-09): phone tap targets, 16px body copy, AA contrast, no sideways scroll; appended last so it wins the cascade on every page that loads the restored header sheet.
text sfinish "/* Generated by om/site/css.om. Finish pass: 44px targets, 16px body copy, AA contrast, no sideways scroll. Site tokens only. */\n.aien-header{padding:8px 0}\n.aien-header .aien-brand{min-height:44px}\n.aien-header .aien-nav-more-button{height:44px;min-height:44px;padding:0 14px}\n.aien-nav a.aien-nav-link{padding:12px 0}\n.aien-nav a.aien-x-link.aien-x-button{width:44px;height:44px;font-size:0;line-height:0}\n.aien-x-button .aien-x-mark{width:16px;height:16px}\n.aien-header .aien-nav-panel ul{gap:0}\n.aien-header .aien-nav-panel a.aien-nav-minor{display:flex;align-items:center;min-height:44px;padding:0 6px;font-size:14px}\n.aien-footer,.aien-footer .site-index,.aien-footer .aien-reach-foot{font-size:1rem}\n.aien-footer a.site-brand{display:inline-flex;align-items:center;min-height:44px}\n.aien-footer .footer-links{gap:0 1.2rem}\n.aien-footer .site-index-links{gap:0 .75rem;padding-block:.25rem}\n.aien-footer .aien-reach-foot{gap:0 1.4rem}\n.aien-footer .footer-links a,.aien-footer .site-index-links a,.aien-footer .aien-reach-foot a{display:inline-flex;align-items:center;min-height:44px}\n.aien-footer .site-index summary{display:flex;align-items:center;min-height:44px}\nbody.site .hub-card p,body.site .rs-card-callout,body.site .rs-step-detail,body.site .rs-sources p,body.site .rs-sources li,body.site .decisions li a,body.site .theory-fig figcaption,body.site .loop-caption,body.site .live-head p,body.site .narr-loop li,body.site .alpha-scene figcaption,body.site .rs-facts,body.site .receipt,body.site .step-card p,body.site .rung p,body.site .explain,body.site .engineer .stat-label,body.site .panel dl.evidence,body.site dl.evidence dd li{font-size:1rem}\nbody.site .rs-current{font-size:1.125rem}\nhtml[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 13px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 14px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 15px\"]{font-size:1rem!important}\nbody.site #tg-zero,body.site #tg-one,body.site #tg-reset,body.site .terminal-shell button,body.site #turing-game button{min-height:44px;min-width:44px;padding:.5rem 1rem}\nbody.site .blog-read-more,body.site .engineer .card-link,body.site .film-cap a{display:inline-flex;align-items:center;min-height:44px}\nbody.site input[type=range]{height:44px;padding:18px 0;background-clip:content-box}\nbody.site .button:not(.button-secondary){background:color-mix(in srgb,var(--accent-blue) 14%,transparent);border-color:var(--tl-blue,var(--accent-blue));color:var(--accent-blue)}\nbody.site .button:not(.button-secondary):hover{background:color-mix(in srgb,var(--accent-blue) 28%,transparent);border-color:var(--accent-blue);color:var(--text-primary)}\nbody.site .scroll-cue,body.site .meter .cap,body.site .duel .who,body.site .tfoot,body.site .rule-btn .rl,body.site .film-cap,body.site .film-cap a{color:var(--text-muted)}\nbody.site .home-q-badge.status-experimental{color:var(--accent-blue)}\nbody.site .wrap .source-tag{font-size:12px}\nbody.site .hero-inner{position:relative;z-index:2}\n@media(max-width:52rem){body.site .container{width:calc(100% - 2.5rem);padding-inline:0}body.site .aien-header-inner{padding:0 20px}body.site .hero{padding-inline:20px}}\n@media(max-width:700px){body.site .glow-box>div[style*=\"minmax(320px\"]{grid-template-columns:minmax(0,1fr)!important}body.site .pdf-button{white-space:normal;max-width:100%}}\n@media(max-width:640px){body.site .hero #field{opacity:.5}body.site .engineer .uni-intro h1{margin-top:4rem}}\n@media(max-width:600px){body.site .terminal-status{display:none!important}}\nbody.site dl.evidence dd,body.site .ncard p,body.site .doc p,body.site .wrap .stat p,body.site .wrap .note,body.site .tfoot{font-size:1rem}\nhtml[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 13.5px\"],html[lang=zh-CN] body.site :is(p,li,dd)[style*=\"font-size: 14.5px\"]{font-size:1rem!important}\nbody.site .wrap .index-links a,body.site .wrap .source-tag,body.site #root .cluster a,html[lang=zh-CN] body.site .glow-box a:not(p a),.aien-footer .footer-quiet a{display:inline-flex;align-items:center;min-height:44px}\nbody.site .wrap .index-links a{padding:0 .5rem}\nbody.site .tfoot a{display:inline-block;padding:.5rem 0;margin:-.5rem 0}\nbody.site .rs-card summary{display:flex;align-items:center;min-height:44px}\nbody.site .section>a.box-link,body.site main>a.box-link{position:relative;min-height:44px}\n.aien-header .aien-nav-panel ul{align-items:stretch}\n.aien-header .aien-nav-panel li,.aien-header .aien-nav-panel a.aien-nav-minor{width:100%}\nbody.site .button:not(.button-secondary),body.site .home-q-badge.status-experimental{color:var(--tl-blue-soft,var(--accent-blue))}\nbody.site:has(.signal-band){--paper:#0c1211;--ink:#e8f0ed;--muted:#a9b8b3;--line:#34433f;--line-strong:#697a74;--surface:#121c1a;--surface-2:#172421;--deep:#071d19;--deep-ink:#eef8f3;--green:#4bd3a1;--green-2:#70e1b8;--coral:#ff7864;--gold:#e3ae50}\nbody.site .wrap .kicker{color:var(--green-2)}\nbody.site .alpha-steps p,body.site .alpha-evidence p,body.site .alpha-small,body.site .now-sub,body.site .now-note,body.site .now-done,body.site .now-give-note,body.site .now-stamp,body.site .now-give p,body.site .now-give li,body.site .entry .desc,body.site #aien-growth-observatory .text-small,body.site .note,body.site p.wa-note,body.site p.wa-venue,body.site p.fine,body.site .hive-small,body.site .hive-coverage,body.site .hive-source-note,body.site .hive-note,body.site .hive-empty,body.site .hive-omega-note,body.site .lab-small,body.site .lab-status,body.site .dash-warn,body.site .agora-view-desc,body.site .rs-card-plain,body.site .rs-impl-scope,body.site dd.rs-mono{font-size:1rem}\nbody.site .alpha-scroll,body.site .alpha-links a,body.site .footer-note a,body.site a.source-link:not(.box-link),body.site .hive-omega-source,body.site .ag-evidence a{display:inline-flex;align-items:center;min-height:44px}\nbody.site #aien-growth-observatory #ag-refresh,body.site summary.cursor-interaction,body.site .agora-room-tab,body.site .agora-btn,body.site input[type=range]{min-height:44px}\nbody.site #agora-submit-btn{min-width:44px}\nbody.site .research-wrap .section p,body.site .tenets li,body.site p.evidence,body.site .rs-attempt p,body.site .learn-page .learn-small,body.site .learn-example-label,body.site .sb-small,body.site .now-queue-item,body.site .now-row-note,body.site .now-row-done,body.site .now-tl-item,body.site .now-tl-evidence,body.site .now-ref,body.site .home-floor-note,body.site span.rs-mono,body.site .artifact a{font-size:1rem}\nbody.site .hive-jumps a{font-size:.875rem;padding:0 .5rem}\nbody.site .now-give-btn code{color:inherit}\nbody.site li.hub-card>a,body.site .learn-jump a,body.site .learn-text-link,body.site .hive-select,body.site .hive-jumps a,body.site .artifact a{display:inline-flex;align-items:center;min-height:44px}\nbody.site .rs-impl-item summary{display:flex;align-items:center;min-height:44px}\nbody.site .engineer .uni-btn{min-height:44px}\nbody.site .wrap .source-tag{min-width:44px}\nbody.site .engineer .wa-paper p,body.site .engineer .wa-paper .wa-venue,body.site .engineer .wa-layers li{font-size:1rem}\nbody.site .hub-card h3>a{display:inline-flex;align-items:center;min-height:44px}\n"

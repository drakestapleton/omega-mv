note Radicle repository table on /switched-off/ (Drake, 2026-11-07). Rows come from
note data/radicle-rids.md at build time: the first | repo | RID | table, copied from RadPublish's
note RIDS.md. The count and every row are read there, never written into the page. Every row
note must match one rdallow entry exactly (name and RID); rdallow is the public table of RIDS.md
note and nothing else, so a repository outside it can never be published (RD0007). A name or
note RID listed twice fails (RD0011). A row that says PRIVATE or WITHDRAWN (any case), or has a
note malformed cell, fails too. The page source holds one <!--radicle-rids--> marker inside main.
note /spark/ holds one <!--cuda-crack-rid--> marker inside main; data/cuda-crack-rid.txt
note supplies its value: one line holding the RID of the rdallow entry named cuda-crack and no
note other. PENDING fails (RD0010, the deploy gate: every deploy runs this build); missing or
note anything else fails (RD0008).
global rdbuf uchar 65536
global rdlen ulong 1
global rdrs ulong 64
global rdrn ulong 64
global rdis ulong 64
global rdin ulong 64
global rdcnt ulong 1
text rdroute "/switched-off/"
text rdpath "data/radicle-rids.md"
text rdhead "\n| repo | RID |"
text rdrule "|---"
text rdmark "<!--radicle-rids-->"
text rdpriv "PRIVATE"
text rdwith "WITHDRAWN"
text rdsep " | "
text rdend " |"
text rdpfx "rad:z"
text rdspark "/spark/"
text rdcpath "data/cuda-crack-rid.txt"
text rdcmark "<!--cuda-crack-rid-->"
text rdpend "PENDING"
text rdcname "cuda-crack"
text RD0001 "data/radicle-rids.md is missing, unreadable or larger than 64 KiB"
text RD0002 "data/radicle-rids.md has no | repo | RID | table with a |--- rule"
text RD0003 "data/radicle-rids.md lists a PRIVATE or WITHDRAWN row in its public table"
text RD0004 "data/radicle-rids.md has a malformed repo or RID cell"
text RD0005 "data/radicle-rids.md lists no repositories, or more than 64"
text RD0006 "/switched-off/ source needs exactly one <!--radicle-rids--> marker inside main"
text RD0007 "data/radicle-rids.md lists a repository or RID that is not in the rdallow public list of om/site/forge.om"
text RD0008 "data/cuda-crack-rid.txt is missing, or is not one line holding the rad:z RID of the rdallow entry named cuda-crack"
text RD0010 "data/cuda-crack-rid.txt still says PENDING; a deploy needs the published cuda-crack rad:z RID"
text RD0009 "/spark/ source needs exactly one <!--cuda-crack-rid--> marker inside main"
text RD0011 "data/radicle-rids.md lists a repository name or RID more than once"
text rdc0 "<code>rad clone "
text rdc1 "</code>"
text rdt0 "<p>"
text rdt1 " public repositories are published from my own node so far. Each one clones with one command:</p><table class=\"so-rids\"><thead><tr><th scope=\"col\">Repository</th><th scope=\"col\">Clone command</th></tr></thead><tbody>"
text rdt2 "<tr><td><code>"
text rdt3 "</code></td><td><code>rad clone "
text rdt4 "</code></td></tr>"
text rdt5 "</tbody></table>"

fn rd_load path view uchar * fail view uchar * to void
fd = fopen path 0 len path 0 0
if lt fd 0
st_fail fail
end
n = ulong 0
while true bound 999999
r = read int fd rdbuf n sub len rdbuf n
if lt r 0
st_fail fail
end
if eq r 0
break
end
n = add n ulong r
if ge n len rdbuf
st_fail fail
end
end
r = fclose int fd
if ne r 0
st_fail fail
end
put rdlen 0 n
end

fn rd_at pattern view uchar * pos ulong to bool
if gt len pattern sub get rdlen 0 pos
ret false
end
for i ulong len pattern
if ne get rdbuf add pos i get pattern i
ret false
end
end
ret true
end

fn rd_find pattern view uchar * pos ulong finish ulong to ulong
p = pos
while lt p finish bound 999999
if rd_at pattern p
ret p
end
p = add p 1
end
ret finish
end

fn rd_lc c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end

fn rd_iat pattern view uchar * pos ulong to bool
if gt len pattern sub get rdlen 0 pos
ret false
end
for i ulong len pattern
if ne rd_lc get rdbuf add pos i rd_lc get pattern i
ret false
end
end
ret true
end

fn rd_ihas pattern view uchar * pos ulong finish ulong to bool
p = pos
while lt p finish bound 999999
if rd_iat pattern p
ret le add p len pattern finish
end
p = add p 1
end
ret false
end

fn rd_eol pos ulong to ulong
p = pos
while lt p get rdlen 0 bound 999999
if eq get rdbuf p 10
ret p
end
p = add p 1
end
ret get rdlen 0
end

fn rd_alnum c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end

fn rd_name start ulong finish ulong to void
if or ge start finish gt sub finish start 64
st_fail RD0004
end
for i ulong sub finish start
c = get rdbuf add start i
if not or or or rd_alnum c eq c 45 eq c 46 eq c 95
st_fail RD0004
end
end
end

fn rd_rid start ulong finish ulong to void
if or lt sub finish start 10 gt sub finish start 64
st_fail RD0004
end
if not rd_at rdpfx start
st_fail RD0004
end
for i ulong sub sub finish start 4
if not rd_alnum get rdbuf add add start 4 i
st_fail RD0004
end
end
end

fn rd_same ts ulong tn ulong bs ulong bn ulong to bool
if ne tn bn
ret false
end
for i ulong tn
if ne get rdallow add ts i get rdbuf add bs i
ret false
end
end
ret true
end

fn rd_tsame ts ulong tn ulong pattern view uchar * to bool
if ne tn len pattern
ret false
end
for i ulong tn
if ne get rdallow add ts i get pattern i
ret false
end
end
ret true
end

fn rd_bsame xs ulong xn ulong ys ulong yn ulong to bool
if ne xn yn
ret false
end
for i ulong xn
if ne get rdbuf add xs i get rdbuf add ys i
ret false
end
end
ret true
end

fn rd_allow cr bool s ulong a ulong b ulong f ulong to bool
i = ulong 0
while lt i len rdallow bound 4096
sp = i
while ne get rdallow sp 32 bound 128
sp = add sp 1
end
e = add sp 1
while ne get rdallow e 10 bound 128
e = add e 1
end
if rd_same add sp 1 sub e add sp 1 b sub f b
if cr
if rd_tsame i sub sp i rdcname
ret true
end
end
if not cr
if rd_same i sub sp i s sub a s
ret true
end
end
end
i = add e 1
end
ret false
end

fn rd_dup s ulong a ulong b ulong f ulong c ulong to void
for j ulong c
if rd_bsame get rdrs j get rdrn j s sub a s
st_fail RD0011
end
if rd_bsame get rdis j get rdin j b sub f b
st_fail RD0011
end
end
end

fn rd_parse to void
rd_load rdpath RD0001
h = rd_find rdhead 0 get rdlen 0
if eq h get rdlen 0
st_fail RD0002
end
p = add rd_eol add h 1 1
if not rd_at rdrule p
st_fail RD0002
end
p = add rd_eol p 1
c = ulong 0
while lt p get rdlen 0 bound 999999
if ne get rdbuf p 124
break
end
e = rd_eol p
if or rd_ihas rdpriv p e rd_ihas rdwith p e
st_fail RD0003
end
s = add p 2
a = rd_find rdsep s e
if eq a e
st_fail RD0004
end
b = add a len rdsep
f = rd_find rdend b e
if eq f e
st_fail RD0004
end
rd_name s a
rd_rid b f
if not rd_allow false s a b f
st_fail RD0007
end
rd_dup s a b f c
if ge c len rdrs
st_fail RD0005
end
put rdrs c s
put rdrn c sub a s
put rdis c b
put rdin c sub f b
c = add c 1
p = add e 1
end
if eq c 0
st_fail RD0005
end
put rdcnt 0 c
end

fn rd_emit start ulong cnt ulong to void
buf = new uchar 64 0
for i ulong cnt
put buf i get rdbuf add start i
end
sr_raw part buf 0 cnt
end

fn rd_table to void
sr_raw rdt0
sr_num get rdcnt 0
sr_raw rdt1
for i ulong get rdcnt 0
sr_raw rdt2
rd_emit get rdrs i get rdrn i
sr_raw rdt3
rd_emit get rdis i get rdin i
sr_raw rdt4
end
sr_raw rdt5
end

fn rd_body source view uchar * to void
rd_parse
sh_load source
p = sh_find shmain 0
if eq p get shlen 0
st_fail RD0006
end
q = sh_end p
finish = sh_find shmc q
m = sh_find rdmark q
if ge m finish
st_fail RD0006
end
if lt sh_find rdmark add m 1 get shlen 0
st_fail RD0006
end
sr_raw shdiv
sh_range add p len shmain q
sh_preserve q m
rd_table
sh_preserve add m len rdmark finish
sr_raw shdivc
sh_extra add finish len shmc get shlen 0
end

fn rd_crack to void
rd_load rdcpath RD0008
n = get rdlen 0
if gt n 0
if eq get rdbuf sub n 1 10
n = sub n 1
end
end
if and eq n len rdpend rd_at rdpend 0
st_fail RD0010
end
if lt rd_eol 0 n
st_fail RD0008
end
if or lt n 10 gt n 64
st_fail RD0008
end
if not rd_at rdpfx 0
st_fail RD0008
end
for i ulong sub n 4
if not rd_alnum get rdbuf add 4 i
st_fail RD0008
end
end
if not rd_allow true 0 0 0 n
st_fail RD0008
end
sr_raw rdc0
rd_emit 0 n
sr_raw rdc1
end

fn rd_spark source view uchar * to void
sh_load source
p = sh_find shmain 0
if eq p get shlen 0
st_fail RD0009
end
q = sh_end p
finish = sh_find shmc q
m = sh_find rdcmark q
if ge m finish
st_fail RD0009
end
if lt sh_find rdcmark add m 1 get shlen 0
st_fail RD0009
end
sr_raw shdiv
sh_range add p len shmain q
sh_preserve q m
rd_crack
sh_preserve add m len rdcmark finish
sr_raw shdivc
sh_extra add finish len shmc get shlen 0
end

note rd_skip: the rdallow offset after the newline that ends the row holding i.
fn rd_skip i ulong to ulong
t = len rdallow
go = true
while go bound 4096
if ge i t
go = false
else
if eq get rdallow i 10
go = false
end
i = add i 1
end
end
ret i
end

note rd_row: offset of "rad:" in the rdallow row named by decoded bytes [o, o+n), or 0.
fn rd_row o ulong n ulong to ulong
t = len rdallow
i = ulong 0
while lt i t bound 128
ok = and gt n 0 le add add i n 1 t
if ok
for k ulong n
if ne get rdallow add i k get sjdec add o k
ok = false
end
end
end
if ok
ok = eq get rdallow add i n 32
end
if ok
ret add add i n 1
end
i = rd_skip i
end
ret 0
end

note rd_rowt: rd_row for a repository name held in text.
fn rd_rowt name view uchar * to ulong
t = len rdallow
n = len name
i = ulong 0
while lt i t bound 128
ok = le add add i n 1 t
if ok
for k ulong n
if ne get rdallow add i k get name k
ok = false
end
end
end
if ok
ok = eq get rdallow add i n 32
end
if ok
ret add add i n 1
end
i = rd_skip i
end
ret 0
end

fn rd_ridout r ulong to void
t = len rdallow
i = r
go = true
while go bound 128
if ge i t
go = false
else
c = get rdallow i
if eq c 10
go = false
else
sr_byte c
i = add i 1
end
end
end
end

fn rd_atd o ulong n ulong p ulong s view uchar * to bool
if gt add p len s n
ret false
end
for j ulong len s
if ne get sjdec add o add p j get s j
ret false
end
end
ret true
end

fn rd_hex c uchar to bool
ret or and ge c 48 le c 57 and ge c 97 le c 102
end

note rd_slash: index of the first / at or after p in [o, o+n), or n.
fn rd_slash o ulong n ulong p ulong to ulong
q = p
while lt q n bound 65536
if eq get sjdec add o q 47
ret q
end
q = add q 1
end
ret n
end

note rd_sha: emits the rad text when [o+k, ...) is 7 to 40 hex bytes ending the range or a segment.
fn rd_sha o ulong n ulong k ulong row ulong to void
h = k
go = true
while go bound 64
if ge h n
go = false
else
if rd_hex get sjdec add o h
h = add h 1
else
go = false
end
end
end
hn = sub h k
if or lt hn 7 gt hn 40
ret
end
if lt h n
if ne get sjdec add o h 47
ret
end
end
sr_raw rdk0
rd_ridout row
sr_byte 32
for j ulong hn
sr_byte get sjdec add o add k j
end
sr_raw rdk1
end

note rd_rcptr: the rad text after a receipt anchor whose URL is decoded bytes [o, o+n).
fn rd_rcptr o ulong n ulong to void
p = len rdfgb
if not rd_atd o n 0 rdfgb
ret
end
q = rd_slash o n p
if ge q n
ret
end
row = rd_row add o p sub q p
if eq row 0
ret
end
k = add q 1
if rd_atd o n k rdcm
rd_sha o n add k len rdcm row
ret
end
if rd_atd o n k rdbl
rd_sha o n add k len rdbl row
ret
end
if rd_atd o n k rdtr
rd_sha o n add k len rdtr row
end
end

fn rd_rcpt nd ulong to void
if eq nd 0
ret
end
if ne sj_kind nd 3
ret
end
rd_rcptr ulong get sjoff nd sj_size nd
end

note rd_rcptat: rad text for a short link form whose sha starts at byte p of nd, repo named in text.
fn rd_rcptat nd ulong p ulong repo view uchar * to void
row = rd_rowt repo
if eq row 0
ret
end
rd_sha ulong get sjoff nd sj_size nd p row
end

note rd_repolink: true for FORGE/<repo in rdallow> or the rosa page of a rad:z RID, nothing after.
fn rd_repolink nd ulong to bool
if eq nd 0
ret false
end
if ne sj_kind nd 3
ret false
end
o = ulong get sjoff nd
n = sj_size nd
if rd_atd o n 0 rdfgb
p = len rdfgb
if lt rd_slash o n p n
ret false
end
ret ne rd_row add o p sub n p 0
end
if not rd_atd o n 0 rdrnb
ret false
end
p = len rdrnb
if ge p n
ret false
end
for j ulong sub n p
ok = rd_alnum get sjdec add o add p j
if not ok
ret false
end
end
ret true
end

note ---- Pure-SVG Renderer (usage.svg) ----

fn max_day_turns to ulong
  mx = ulong 1
  n = get g_day_cnt 0
  for d ulong n bound HF_MAX_DAYS
    v = get g_day_tot d
    if gt v mx
      mx = v
    end
  end
  ret mx
end

fn render_svg_grid ymax ulong to void
  for step ulong 5 bound 5
    y = sub 298 mul step 46
    val = div mul ymax step 4
    s_txt t_svg_grid_a
    s_u64 y
    s_txt t_svg_grid_b
    s_u64 y
    s_txt t_svg_grid_c
    s_u64 add y 3
    s_txt t_svg_grid_d
    s_u64 val
    s_txt t_svg_grid_e
  end
end

fn render_svg_day_bars d ulong slotw ulong barw ulong ymax ulong to void
  bx = add 80 add mul d slotw div sub slotw barw 2
  cur_y = ulong 298
  fbase = mul d 5
  for f ulong 5 bound 5
    fv = get g_day_ft add fbase f
    if gt fv 0
      bh = div mul fv 184 ymax
      if eq bh 0
        bh = 1
      end
      if gt bh cur_y
        bh = cur_y
      end
      ny = sub cur_y bh
      s_txt t_svg_bar_a
      s_u64 bx
      s_txt t_svg_bar_y
      s_u64 ny
      s_txt t_svg_bar_w
      s_u64 barw
      s_txt t_svg_bar_h
      s_u64 bh
      s_txt t_svg_bar_f
      s_fam_color f
      s_txt t_svg_bar_z
      cur_y = ny
    end
  end
end

fn render_svg_poly nd ulong slotw ulong ymax ulong to void
  s_txt t_svg_poly_a
  for d ulong nd bound HF_MAX_DAYS
    cx = add 80 add mul d slotw div slotw 2
    th = div mul get g_day_tot d 184 ymax
    cy = sub 298 th
    if gt d 0
      s_ch 32
    end
    s_u64 cx
    s_ch 44
    s_u64 cy
  end
  s_txt t_svg_poly_z
end

fn render_svg_xlabels nd ulong slotw ulong to void
  stride = ulong 1
  if gt nd 14
    stride = add div nd 10 1
  end
  for d ulong nd bound HF_MAX_DAYS
    if or eq rem d stride 0 eq d sub nd 1
      cx = add 80 add mul d slotw div slotw 2
      s_txt t_svg_xlbl_a
      s_u64 cx
      s_txt t_svg_xlbl_b
      dbase = mul d 10
      for k ulong 5 bound 5
        s_ch get g_day_str add dbase add 5 k
      end
      s_txt t_svg_xlbl_z
    end
  end
end

fn render_svg_timeline to void
  nd = get g_day_cnt 0
  if eq nd 0
    ret
  end
  ymax = max_day_turns
  render_svg_grid ymax
  slotw = div 832 nd
  if lt slotw 6
    slotw = 6
  end
  barw = div mul slotw 7 10
  if lt barw 4
    barw = 4
  end
  if gt barw 44
    barw = 44
  end
  for d ulong nd bound HF_MAX_DAYS
    render_svg_day_bars d slotw barw ymax
  end
  render_svg_poly nd slotw ymax
  render_svg_xlabels nd slotw
end

fn render_svg_share_bar to void
  tot = get g_tot 0
  if eq tot 0
    tot = 1
  end
  cx = ulong 40
  for f ulong 5 bound 5
    fv = get g_fam_turns f
    if gt fv 0
      w = div mul fv 504 tot
      if eq w 0
        w = 2
      end
      if gt add cx w 544
        w = sub 544 cx
      end
      if gt w 0
        s_txt t_svg_bar_a
        s_u64 cx
        s_txt t_svg_bar_y
        s_u64 374
        s_txt t_svg_bar_w
        s_u64 w
        s_txt t_svg_bar_h
        s_u64 10
        s_txt t_svg_bar_f
        s_fam_color f
        s_txt t_svg_bar_z
        cx = add cx w
      end
    end
  end
end

fn render_svg_fam_rows to void
  tot = get g_tot 0
  if eq tot 0
    tot = 1
  end
  for f ulong 5 bound 5
    ry = add 400 mul f 20
    fv = get g_fam_turns f
    bw = div mul fv 170 tot
    pct10 = div mul fv 1000 tot
    s_txt t_svg_sw_a
    s_u64 sub ry 9
    s_txt t_svg_sw_b
    s_fam_color f
    s_txt t_svg_sw_z
    s_txt t_svg_txt_a
    s_u64 56
    s_txt t_svg_txt_y
    s_u64 ry
    s_txt t_svg_txt_m
    s_fam_name f
    s_txt t_svg_txt_z
    s_txt t_svg_sbar_bg
    s_u64 sub ry 8
    s_txt t_svg_sbar_bg2
    if gt bw 0
      s_txt t_svg_bar_a
      s_u64 210
      s_txt t_svg_bar_y
      s_u64 sub ry 8
      s_txt t_svg_bar_w
      s_u64 bw
      s_txt t_svg_bar_h
      s_u64 8
      s_txt t_svg_bar_f
      s_fam_color f
      s_txt t_svg_bar_z
    end
    s_txt t_svg_txt_a
    s_u64 544
    s_txt t_svg_txt_y
    s_u64 ry
    s_txt t_svg_txt_r
    s_u64 fv
    s_ch 32
    s_ch 40
    s_u64_1dec pct10
    s_ch 37
    s_ch 41
    s_ch 32
    s_tok_fmt get g_fam_toks f
    s_txt t_svg_txt_z
  end
end

fn render_svg_agents to void
  nag = get g_ag_cnt 0
  lim = nag
  if gt lim 5
    lim = 5
  end
  mx = ulong 1
  if gt nag 0
    v = get g_ag_turns 0
    if gt v 0
      mx = v
    end
  end
  for i ulong lim bound 5
    ry = add 394 mul i 21
    tu = get g_ag_turns i
    bw = div mul tu 118 mx
    s_txt t_svg_txt_a
    s_u64 592
    s_txt t_svg_txt_y
    s_u64 ry
    s_txt t_svg_txt_m
    s_esc_agent i
    s_txt t_svg_txt_z
    s_txt t_svg_ag_bg
    s_u64 sub ry 8
    s_txt t_svg_ag_bg2
    if gt bw 0
      s_txt t_svg_bar_a
      s_u64 728
      s_txt t_svg_bar_y
      s_u64 sub ry 8
      s_txt t_svg_bar_w
      s_u64 bw
      s_txt t_svg_bar_h
      s_u64 8
      s_txt t_svg_bar_f
      s_fam_color rem i 4
      s_txt t_svg_bar_z
    end
    s_txt t_svg_txt_a
    s_u64 920
    s_txt t_svg_txt_y
    s_u64 ry
    s_txt t_svg_txt_r
    s_u64 tu
    s_ch 116
    s_ch 32
    s_ch 47
    s_ch 32
    s_u64 get g_ag_sess i
    s_ch 115
    s_txt t_svg_txt_z
  end
end

fn render_svg to void
  put g_svgl 0 0
  s_txt t_svg_head1
  s_txt t_svg_head2
  s_u64 get g_day_cnt 0
  s_txt t_svg_sub_d
  s_u64 get g_tot 0
  s_txt t_svg_sub_t
  s_u64 get g_tot 1
  s_txt t_svg_sub_s
  s_tok_fmt get g_tot 2
  s_txt t_svg_sub_k
  s_txt t_svg_dots1
  s_txt t_svg_dots2
  render_svg_timeline
  s_txt t_svg_bot_l
  render_svg_share_bar
  render_svg_fam_rows
  s_txt t_svg_bot_r
  render_svg_agents
  s_txt t_svg_end
end

note ---- HTML5 Page Renderer (index.html) ----

fn h_emit_thermal to void
  has_g = ne get g_therm 0 0
  has_s = ne get g_therm 2 0
  if and not has_g not has_s
    h_txt t_therm_host
    ret
  end
  if has_g
    h_ch 71
    h_ch 80
    h_ch 85
    h_ch 32
    h_u64_1dec div get g_therm 1 100
    h_txt t_deg_c
  end
  if and has_g has_s
    h_ch 32
    h_ch 47
    h_ch 32
  end
  if has_s
    h_ch 83
    h_ch 111
    h_ch 67
    h_ch 32
    h_u64_1dec div get g_therm 3 100
    h_txt t_deg_c
  end
end

fn h_emit_ev_row idx ulong to void
  h_txt t_ev_open
  rbase = mul idx 64
  rn = get g_ev_rlen idx
  for i ulong rn bound 64
    h_esc_byte get g_ev_repo add rbase i
  end
  h_txt t_ev_mid1
  sbase = mul idx 48
  sn = get g_ev_slen idx
  for i ulong sn bound 48
    h_esc_byte get g_ev_sha add sbase i
  end
  h_txt t_ev_mid2
  tbase = mul idx 32
  tn = get g_ev_tsl idx
  for i ulong tn bound 32
    h_esc_byte get g_ev_ts add tbase i
  end
  h_txt t_ev_close
end

fn render_html to void
  put g_htmll 0 0
  h_txt t_h_top1
  h_txt t_h_top2
  h_txt t_h_top3
  h_txt t_h_top4
  h_txt t_h_top5
  h_txt t_h_top6
  h_txt t_h_top7
  h_txt t_h_top8
  h_txt t_h_kpi1
  h_u64 get g_tot 0
  h_txt t_h_kpi2
  h_u64 get g_day_cnt 0
  h_txt t_h_kpi2b
  h_u64 get g_tot 1
  h_txt t_h_kpi2c
  h_tok_fmt get g_tot 2
  h_txt t_h_kpi3
  h_u64 get g_pub_cnt 0
  h_txt t_h_kpi3b
  h_emit_thermal
  h_txt t_h_kpi4
  h_append_svg
  h_txt t_h_after_svg
  for f ulong 5 bound 5
    h_txt t_tr_open
    h_fam_color f
    h_txt t_tr_mid
    h_fam_name f
    h_txt t_td_num
    h_u64 get g_fam_turns f
    h_txt t_td_num
    h_u64 get g_fam_sess f
    h_txt t_td_num
    h_tok_fmt get g_fam_toks f
    h_txt t_tr_close
  end
  h_txt t_h_mid_tbl
  nag = get g_ag_cnt 0
  for i ulong nag bound HF_MAX_AGENTS
    h_txt t_tr_ag_open
    h_esc_agent i
    h_txt t_td_num
    h_u64 get g_ag_turns i
    h_txt t_td_num
    h_u64 get g_ag_sess i
    h_txt t_td_num
    h_tok_fmt get g_ag_toks i
    h_txt t_tr_close
  end
  h_txt t_h_pulse_open
  nev = get g_ev_cnt 0
  if eq nev 0
    h_txt t_h_pulse_none
  else
    i = nev
    while gt i 0 bound HF_MAX_EVENTS
      i = sub i 1
      h_emit_ev_row i
    end
  end
  h_txt t_h_foot
end

note ---- Plain-Text Status Renderer (status.txt) ----

fn t_emit_ev_line idx ulong to void
  t_txt t_ev_pre
  tbase = mul idx 32
  tn = get g_ev_tsl idx
  for i ulong tn bound 32
    t_ch get g_ev_ts add tbase i
  end
  t_ch 32
  rbase = mul idx 64
  rn = get g_ev_rlen idx
  for i ulong rn bound 64
    t_ch get g_ev_repo add rbase i
  end
  t_ch 32
  sbase = mul idx 48
  sn = get g_ev_slen idx
  for i ulong sn bound 48
    t_ch get g_ev_sha add sbase i
  end
  t_ch 10
end

fn render_status to void
  put g_stxtl 0 0
  t_txt t_st_head
  t_txt t_st_rows

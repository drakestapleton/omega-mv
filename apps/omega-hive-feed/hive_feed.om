fn send_text_body fd int body view uchar * to void
  n = len body
  off = ulong 0
  dl = add long monons HF_IO_TMO
  while lt off n bound 4096
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd body off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end

fn build_http_hdr scode ulong ct_kind ulong blen ulong to void
  put g_hdrl 0 0
  if eq scode 200
    hd_txt t_http_200
  else
    if eq scode 400
      hd_txt t_http_400
    else
      if eq scode 404
        hd_txt t_http_404
      else
        if eq scode 405
          hd_txt t_http_405
        else
          hd_txt t_http_413
        end
      end
    end
  end
  hd_crlf
  if eq ct_kind 0
    hd_txt t_ct_html
  else
    if eq ct_kind 1
      hd_txt t_ct_svg
    else
      hd_txt t_ct_txt
    end
  end
  hd_crlf
  hd_txt t_hdr_csp
  hd_crlf
  hd_txt t_hdr_nosniff
  hd_crlf
  hd_txt t_hdr_ref
  hd_crlf
  hd_txt t_hdr_cc
  hd_crlf
  if eq scode 405
    hd_txt t_hdr_allow
    hd_crlf
  end
  hd_txt t_hdr_cl
  hd_u64 blen
  hd_crlf
  hd_txt t_hdr_conn
  hd_crlf
  hd_crlf
end

fn send_fixed fd int scode ulong body view uchar * head_only bool to void
  build_http_hdr scode 2 len body
  send_hdr fd
  if not head_only
    send_text_body fd body
  end
end

fn read_http_req fd int to ulong
  put g_reql 0 0
  dl = add long monons HF_IO_TMO
  for it ulong 1024 bound 1024
    n = get g_reql 0
    if gt n HF_MAX_REQ
      ret 2
    end
    hend = find_hdr_end
    if gt hend 0
      cl = parse_req_cl hend
      if gt add hend cl HF_MAX_REQ
        ret 2
      end
      ret 1
    end
    if ge n HF_MAX_REQ
      ret 2
    end
    left = sub dl long monons
    if le left 0
      ret 0
    end
    w = waitio fd 1 left
    if le w 0
      if eq w -4
        continue
      end
      ret 0
    end
    r = recv fd g_req n sub HF_REQ_CAP n 0
    if lt r 0
      if or eq r -4 eq r -11
        continue
      end
      ret 0
    end
    if eq r 0
      ret 0
    end
    put g_reql 0 add n ulong r
  end
  ret 2
end

fn dispatch_route fd int p0 ulong q1 ulong is_head bool to void
  if req_span_eq p0 q1 t_r_health
    send_fixed fd 200 t_ok_body is_head
    ret
  end
  if or req_span_eq p0 q1 t_r_svg req_span_eq p0 q1 t_r_svg2
    render_svg
    build_http_hdr 200 1 get g_svgl 0
    send_hdr fd
    if not is_head
      send_svg_body fd
    end
    ret
  end
  if or req_span_eq p0 q1 t_r_stat req_span_eq p0 q1 t_r_stat2
    load_live_feed
    read_thermal
    render_status
    build_http_hdr 200 2 get g_stxtl 0
    send_hdr fd
    if not is_head
      send_stat_body fd
    end
    ret
  end
  if or req_span_eq p0 q1 t_r_root or req_span_eq p0 q1 t_r_hive req_span_eq p0 q1 t_r_hive_s
    load_live_feed
    read_thermal
    render_svg
    render_html
    build_http_hdr 200 0 get g_htmll 0
    send_hdr fd
    if not is_head
      send_html_body fd
    end
    ret
  end
  send_fixed fd 404 t_404_body is_head
end

fn serve_conn fd int to void
  rr = read_http_req fd
  if eq rr 0
    ret
  end
  if eq rr 2
    send_fixed fd 413 t_413_body false
    ret
  end
  is_get = req_starts 0 t_m_get
  is_head = req_starts 0 t_m_head
  if and not is_get not is_head
    if looks_like_http_method
      send_fixed fd 405 t_405_body false
    else
      send_fixed fd 400 t_400_body false
    end
    ret
  end
  p0 = ulong 4
  if is_head
    p0 = 5
  end
  n = get g_reql 0
  p1 = p0
  while lt p1 n bound HF_MAX_REQ
    c = get g_req p1
    if or eq c 32 or eq c 13 eq c 10
      break
    end
    p1 = add p1 1
  end
  if uri_is_bad p0 p1
    send_fixed fd 400 t_400_body false
    ret
  end
  q1 = p0
  while lt q1 p1 bound HF_MAX_REQ
    if eq get g_req q1 63
      break
    end
    q1 = add q1 1
  end
  dispatch_route fd p0 q1 is_head
end

fn make_listener port ulong to long
  fd = socknew 2 526337 0
  if lt fd 0
    ret fd
  end
  one = new uchar 4 0
  put one 0 1
  r = sockopt int fd 1 2 one 0 4
  a = new uchar 16 0
  put a 0 2
  put a 2 uchar shr port 8
  put a 3 uchar and port 255
  put a 4 uchar shr HF_IP_LO 24
  put a 5 uchar and shr HF_IP_LO 16 255
  put a 6 uchar and shr HF_IP_LO 8 255
  put a 7 uchar and HF_IP_LO 255
  if eq r 0
    r = bind int fd a 0 16
  end
  if eq r 0
    r = listen int fd 64
  end
  if ne r 0
    x = fclose int fd
    ret r
  end
  ret fd
end

note ---- CLI Dispatch ----

fn arg_eq idx ulong pat view uchar * to bool
  k = argread idx g_tmp 0 128
  if lt k 0
    ret false
  end
  if ne ulong k len pat
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_tmp i get pat i
      ret false
    end
  end
  ret true
end

fn parse_port_arg idx ulong to ulong
  k = argread idx g_tmp 0 32
  if or le k 0 gt k 5
    ret 0
  end
  v = ulong 0
  for i ulong ulong k bound 8
    c = get g_tmp i
    if not is_digit c
      ret 0
    end
    v = add mul v 10 ulong sub c 48
  end
  if or eq v 0 gt v 65535
    ret 0
  end
  ret v
end

fn run_render to int
  if lt argcnt 4
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  ku = argread 2 g_usage_p 0 511
  ko = argread 3 g_out_p 0 511
  if or le ku 0 le ko 0
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  put g_usage_pl 0 ulong ku
  put g_out_pl 0 ulong ko
  if ge argcnt 6
    kc = argread 4 g_cat_p 0 511
    kl = argread 5 g_log_p 0 511
    if gt kc 0
      put g_cat_pl 0 ulong kc
    end
    if gt kl 0
      put g_log_pl 0 ulong kl
    end
  end
  if not load_usage
    ret 3
  end
  load_live_feed
  read_thermal
  render_svg
  render_html
  render_status
  m = makedir g_out_p 0 get g_out_pl 0 493
  if and lt m 0 ne m -17
    x = write 2 t_err_io 0 len t_err_io
    ret 4
  end
  if not write_out_svg
    x = write 2 t_err_io 0 len t_err_io
    ret 4
  end
  if not write_out_html
    x = write 2 t_err_io 0 len t_err_io
    ret 4
  end
  if not write_out_stat
    x = write 2 t_err_io 0 len t_err_io
    ret 4
  end
  ret 0
end

fn run_serve to int
  if lt argcnt 6
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  port = parse_port_arg 2
  if eq port 0
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  put g_port 0 port
  ku = argread 3 g_usage_p 0 511
  kc = argread 4 g_cat_p 0 511
  kl = argread 5 g_log_p 0 511
  if or le ku 0 or le kc 0 le kl 0
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  put g_usage_pl 0 ulong ku
  put g_cat_pl 0 ulong kc
  put g_log_pl 0 ulong kl
  if not load_usage
    ret 3
  end
  load_live_feed
  read_thermal
  lfd = make_listener port
  if lt lfd 0
    x = write 2 t_err_bind 0 len t_err_bind
    ret 5
  end
  x = write 2 t_started_pre 0 len t_started_pre
  dn = u64_to_dec port
  x = write 2 g_dec 0 dn
  x = write 2 t_nl 0 1
  for it ulong 4000000000 bound 4000000000
    w = waitio int lfd 1 1000000000
    if gt w 0
      cfd = accept int lfd 526336
      if ge cfd 0
        serve_conn int cfd
        x = fclose int cfd
      end
    end
  end
  ret 0
end

fn main to int
  if lt argcnt 2
    x = write 2 t_err_usage 0 len t_err_usage
    ret 2
  end
  if arg_eq 1 t_flag_render
    ret run_render
  end
  if arg_eq 1 t_flag_serve
    ret run_serve
  end
  x = write 2 t_err_usage 0 len t_err_usage
  ret 2
end

  t_u64 get g_fam_turns 3
  t_ch 10
  t_txt t_st_f4
  t_u64 get g_fam_turns 4
  t_ch 10
  t_txt t_st_pub
  t_u64 get g_pub_cnt 0
  t_ch 10
  t_txt t_st_ev
  t_u64 get g_ev_cnt 0
  t_ch 10
  t_txt t_st_filt
  t_u64 get g_priv_stat 0
  t_ch 10
  t_txt t_st_scrub
  t_u64 get g_priv_stat 1
  t_ch 10
  t_txt t_st_tgpu
  if ne get g_therm 0 0
    t_u64 get g_therm 1
  else
    t_txt t_host_only
  end
  t_ch 10
  t_txt t_st_tsoc
  if ne get g_therm 2 0
    t_u64 get g_therm 3
  else
    t_txt t_host_only
  end
  t_ch 10
  nev = get g_ev_cnt 0
  for i ulong nev bound HF_MAX_EVENTS
    t_emit_ev_line i
  end
end

note ---- HTTP Request Parsing & Security Controls ----

fn req_starts pos ulong pat view uchar * to bool
  n = get g_reql 0
  pl = len pat
  if gt add pos pl n
    ret false
  end
  for i ulong pl bound 64
    if ne get g_req add pos i get pat i
      ret false
    end
  end
  ret true
end

fn req_ci_starts pos ulong pat view uchar * to bool
  n = get g_reql 0
  pl = len pat
  if gt add pos pl n
    ret false
  end
  for i ulong pl bound 64
    if ne lc get g_req add pos i get pat i
      ret false
    end
  end
  ret true
end

fn req_span_eq lo ulong hi ulong pat view uchar * to bool
  if ne sub hi lo len pat
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_req add lo i get pat i
      ret false
    end
  end
  ret true
end

fn find_hdr_end to ulong
  n = get g_reql 0
  if lt n 4
    ret 0
  end
  lim = sub n 3
  for i ulong lim bound HF_REQ_CAP
    if eq get g_req i 13
      if eq get g_req add i 1 10
        if eq get g_req add i 2 13
          if eq get g_req add i 3 10
            ret add i 4
          end
        end
      end
    end
  end
  ret 0
end

fn parse_req_cl hend ulong to ulong
  i = ulong 0
  while lt i hend bound HF_REQ_CAP
    if req_ci_starts i t_hdr_cl_lc
      j = add i len t_hdr_cl_lc
      while lt j hend bound HF_REQ_CAP
        c = get g_req j
        if and ne c 32 ne c 9
          break
        end
        j = add j 1
      end
      v = ulong 0
      while lt j hend bound 24
        c = get g_req j
        if not is_digit c
          break
        end
        if gt v 100000000
          ret 1000000000
        end
        v = add mul v 10 ulong sub c 48
        j = add j 1
      end
      ret v
    end
    while lt i hend bound HF_REQ_CAP
      c = get g_req i
      i = add i 1
      if eq c 10
        break
      end
    end
  end
  ret 0
end

fn uri_is_bad p0 ulong p1 ulong to bool
  if ge p0 p1
    ret true
  end
  if ne get g_req p0 47
    ret true
  end
  i = p0
  while lt i p1 bound HF_REQ_CAP
    c = get g_req i
    if lt c 32
      ret true
    end
    if eq c 127
      ret true
    end
    if eq c 92
      ret true
    end
    if eq c 46
      if lt add i 1 p1
        if eq get g_req add i 1 46
          ret true
        end
      end
    end
    if eq c 37
      if le add i 3 p1
        h1 = lc get g_req add i 1
        h2 = lc get g_req add i 2
        if and eq h1 50 or eq h2 101 eq h2 102
          ret true
        end
        if and eq h1 53 eq h2 99
          ret true
        end
        if and eq h1 48 eq h2 48
          ret true
        end
      end
    end
    i = add i 1
  end
  ret false
end

fn looks_like_http_method to bool
  n = get g_reql 0
  i = ulong 0
  while lt i n bound 20
    c = get g_req i
    if eq c 32
      ret gt i 0
    end
    if or lt c 65 gt c 90
      ret false
    end
    i = add i 1
  end
  ret false
end

fn send_hdr fd int to void
  n = get g_hdrl 0
  off = ulong 0
  dl = add long monons HF_IO_TMO
  while lt off n bound 4096
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd g_hdr off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end


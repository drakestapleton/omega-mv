text t_h_top1 "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Interplane Hive - Live Sovereign Build Pulse &amp; Model Usage</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#070d1a;color:#e2e8f0;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;overflow-x:clip}\n"
text t_h_top2 ".wrap{max-width:1040px;margin:0 auto;padding:24px 18px 48px}\nheader{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #1e3357;padding-bottom:16px;margin-bottom:20px}\n.brand{font-size:1.35rem;font-weight:700;letter-spacing:-0.01em;color:#f8fafc}\n.brand span{color:#38bdf8}\n"
text t_h_top3 "nav{display:flex;flex-wrap:wrap;gap:12px;font-size:0.9rem}\nnav a{color:#94a3b8;text-decoration:none;border:1px solid #1e3357;padding:5px 10px;border-radius:8px}\nnav a:hover{color:#f8fafc;border-color:#38bdf8}\n.strip{height:3px;border-radius:3px;background:linear-gradient(90deg,#38bdf8,#a78bfa,#34d399,#fbbf24);margin-bottom:18px}\n"
text t_h_top4 ".kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:12px;margin-bottom:20px}\n.card{background:#0a1224;border:1px solid #1e3357;border-radius:12px;padding:14px 16px}\n.klbl{font-size:0.75rem;text-transform:uppercase;letter-spacing:0.06em;color:#94a3b8;margin-bottom:6px}\n.kval{font-size:1.35rem;font-weight:700;font-family:ui-monospace,SFMono-Regular,monospace;color:#f8fafc}\n"
text t_h_top5 ".sub{font-size:0.8rem;color:#94a3b8;margin-top:4px}\n.svgbox{background:#0a1224;border:1px solid #1e3357;border-radius:14px;padding:10px;margin-bottom:20px}\n.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:20px}\nh2{margin:0 0 12px;font-size:1.02rem;color:#f1f5f9}\n"
text t_h_top6 "table{width:100%;border-collapse:collapse;font-size:0.88rem}\nth,td{text-align:left;padding:7px 8px;border-bottom:1px solid #162542}\nth{color:#94a3b8;font-weight:600;font-size:0.78rem;text-transform:uppercase}\n.num{text-align:right;font-family:ui-monospace,monospace}\n.pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:0.74rem;font-family:ui-monospace,monospace;background:#0f1b33;border:1px solid #1e3357;color:#34d399}\n"
text t_h_top7 ".dot{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:7px}\n.ev{font-family:ui-monospace,monospace;font-size:0.82rem;padding:7px 0;border-bottom:1px solid #162542;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}\nfooter{margin-top:24px;font-size:0.82rem;color:#64748b;border-top:1px solid #1e3357;padding-top:14px}\n@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n<div class=\"strip\"></div>\n"

  t_ch 10
  t_txt t_st_toks
  t_u64 get g_tot 2
  t_ch 10
  t_txt t_st_f0
  t_u64 get g_fam_turns 0
  t_ch 10
  t_txt t_st_f1
  t_u64 get g_fam_turns 1
  t_ch 10
  t_txt t_st_f2
  t_u64 get g_fam_turns 2
  t_ch 10

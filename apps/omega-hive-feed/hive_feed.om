note ---- Small byte/char helpers ----

fn lc b uchar to uchar
  if and ge b 65 le b 90
    ret add b 32
  end
  ret b
end

fn is_digit b uchar to bool
  ret and ge b 48 le b 57
end

fn is_alpha b uchar to bool
  if and ge b 65 le b 90
    ret true
  end
  ret and ge b 97 le b 122
end

fn is_hex b uchar to bool
  if and ge b 48 le b 57
    ret true
  end
  if and ge b 65 le b 70
    ret true
  end
  ret and ge b 97 le b 102
end

fn is_repo_ch b uchar to bool
  if is_alpha b
    ret true
  end
  if is_digit b
    ret true
  end
  if eq b 45
    ret true
  end
  if eq b 46
    ret true
  end
  ret eq b 95
end

fn is_br_ch b uchar to bool
  if is_repo_ch b
    ret true
  end
  ret eq b 47
end

fn is_ts_ch b uchar to bool
  if is_digit b
    ret true
  end
  if eq b 45
    ret true
  end
  if eq b 58
    ret true
  end
  if eq b 84
    ret true
  end
  ret eq b 90
end

fn u64_to_dec v ulong to ulong
  if eq v 0
    put g_dec 0 48
    ret 1
  end
  x = v
  n = ulong 0
  while gt x 0 bound 24
    put g_dec n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  j = sub n 1
  while lt i j bound 24
    a = get g_dec i
    put g_dec i get g_dec j
    put g_dec j a
    i = add i 1
    j = sub j 1
  end
  ret n
end

note ---- SVG buffer writers ----

fn s_ch c uchar to void
  p = get g_svgl 0
  if lt p HF_MAX_SVG
    put g_svg p c
    put g_svgl 0 add p 1
  end
end

fn s_txt t view uchar * to void
  for i ulong len t bound 8192
    s_ch get t i
  end
end

fn s_u64 v ulong to void
  n = u64_to_dec v
  for i ulong n bound 24
    s_ch get g_dec i
  end
end

fn s_u64_1dec v ulong to void
  s_u64 div v 10
  s_ch 46
  s_u64 rem v 10
end

fn s_tok_fmt v ulong to void
  if ge v 1000000
    s_u64_1dec div v 100000
    s_ch 77
    ret
  end
  if ge v 1000
    s_u64_1dec div v 100
    s_ch 75
    ret
  end
  s_u64 v
end

fn s_esc_byte b uchar to void
  if eq b 38
    s_txt t_esc_amp
    ret
  end
  if eq b 60
    s_txt t_esc_lt
    ret
  end
  if eq b 62
    s_txt t_esc_gt
    ret
  end
  if eq b 34
    s_txt t_esc_quot
    ret
  end
  if eq b 39
    s_txt t_esc_apos
    ret
  end
  if lt b 32
    s_ch 32
    ret
  end
  s_ch b
end

fn ag_ci_at base ulong n ulong pos ulong pat view uchar * to bool
  pl = len pat
  if gt add pos pl n
    ret false
  end
  for i ulong pl bound 32
    c = lc get g_ag_name add base add pos i
    if ne c get pat i
      ret false
    end
  end
  ret true
end

fn ag_on_eq_len base ulong n ulong pos ulong to ulong
  if gt add pos 4 n
    ret 0
  end
  c0 = lc get g_ag_name add base pos
  c1 = lc get g_ag_name add base add pos 1
  if ne c0 111
    ret 0
  end
  if ne c1 110
    ret 0
  end
  k = ulong 2
  while lt add pos k n bound 20
    c = get g_ag_name add base add pos k
    if eq c 61
      if ge k 4
        ret add k 1
      end
      ret 0
    end
    if not is_alpha c
      ret 0
    end
    k = add k 1
  end
  ret 0
end

fn s_esc_agent idx ulong to void
  base = mul idx 64
  n = get g_ag_nlen idx
  i = ulong 0
  while lt i n bound 64
    if ag_ci_at base n i t_pat_js
      s_txt t_blocked
      i = add i 11
    else
      sk = ag_on_eq_len base n i
      if gt sk 0
        s_txt t_blocked
        i = add i sk
      else
        s_esc_byte get g_ag_name add base i
        i = add i 1
      end
    end
  end
end

note ---- HTML buffer writers ----

fn h_ch c uchar to void
  p = get g_htmll 0
  if lt p HF_MAX_HTML
    put g_html p c
    put g_htmll 0 add p 1
  end
end

fn h_txt t view uchar * to void
  for i ulong len t bound 8192
    h_ch get t i
  end
end

fn h_u64 v ulong to void
  n = u64_to_dec v
  for i ulong n bound 24
    h_ch get g_dec i
  end
end

fn h_u64_1dec v ulong to void
  h_u64 div v 10
  h_ch 46
  h_u64 rem v 10
end

fn h_tok_fmt v ulong to void
  if ge v 1000000
    h_u64_1dec div v 100000
    h_ch 77
    ret
  end
  if ge v 1000
    h_u64_1dec div v 100
    h_ch 75
    ret
  end
  h_u64 v
end

fn h_esc_byte b uchar to void
  if eq b 38
    h_txt t_esc_amp
    ret
  end
  if eq b 60
    h_txt t_esc_lt
    ret
  end
  if eq b 62
    h_txt t_esc_gt
    ret
  end
  if eq b 34
    h_txt t_esc_quot
    ret
  end
  if eq b 39
    h_txt t_esc_apos
    ret
  end
  if lt b 32
    h_ch 32
    ret
  end
  h_ch b
end

fn h_esc_agent idx ulong to void
  base = mul idx 64
  n = get g_ag_nlen idx
  i = ulong 0
  while lt i n bound 64
    if ag_ci_at base n i t_pat_js
      h_txt t_blocked
      i = add i 11
    else
      sk = ag_on_eq_len base n i
      if gt sk 0
        h_txt t_blocked
        i = add i sk
      else
        h_esc_byte get g_ag_name add base i
        i = add i 1
      end
    end
  end
end

fn h_append_svg to void
  n = get g_svgl 0
  for i ulong n bound HF_MAX_SVG
    h_ch get g_svg i
  end
end

note ---- Status text writers ----

fn t_ch c uchar to void
  p = get g_stxtl 0
  if lt p HF_MAX_STAT
    put g_stxt p c
    put g_stxtl 0 add p 1
  end
end

fn t_txt t view uchar * to void
  for i ulong len t bound 4096
    t_ch get t i
  end
end

fn t_u64 v ulong to void
  n = u64_to_dec v
  for i ulong n bound 24
    t_ch get g_dec i
  end
end

note ---- HTTP header writers ----

fn hd_ch c uchar to void
  p = get g_hdrl 0
  if lt p HF_MAX_HDR
    put g_hdr p c
    put g_hdrl 0 add p 1
  end
end

fn hd_txt t view uchar * to void
  for i ulong len t bound 1024
    hd_ch get t i
  end
end

fn hd_u64 v ulong to void
  n = u64_to_dec v
  for i ulong n bound 24
    hd_ch get g_dec i
  end
end

fn hd_crlf to void
  hd_ch 13
  hd_ch 10
end

note ---- File I/O helpers (direct global access) ----

fn read_in_fd fd int to bool
  put g_inl 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot HF_MAX_FILE bound 256
    r = read fd g_in tot sub HF_MAX_FILE tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  x = fclose fd
  put g_inl 0 tot
  ret true
end

fn read_in_usage to bool
  pl = get g_usage_pl 0
  if eq pl 0
    ret false
  end
  fd = fopen g_usage_p 0 pl 0 0
  if lt fd 0
    ret false
  end
  ret read_in_fd int fd
end

fn read_in_cat to bool
  pl = get g_cat_pl 0
  if eq pl 0
    ret false
  end
  fd = fopen g_cat_p 0 pl 0 0
  if lt fd 0
    ret false
  end
  ret read_in_fd int fd
end

fn read_in_log to bool
  pl = get g_log_pl 0
  if eq pl 0
    ret false
  end
  fd = fopen g_log_p 0 pl 0 0
  if lt fd 0
    ret false
  end
  ret read_in_fd int fd
end

fn join_out_path suf view uchar * to void
  n = get g_out_pl 0
  for i ulong n bound 512
    put g_path i get g_out_p i
  end
  for j ulong len suf bound 64
    if lt n 511
      put g_path n get suf j
      n = add n 1
    end
  end
  put g_pathl 0 n
end

fn write_out_svg to bool
  join_out_path t_fn_svg
  fd = fopen g_path 0 get g_pathl 0 577 420
  if lt fd 0
    ret false
  end
  blen = get g_svgl 0
  off = ulong 0
  ok = true
  while lt off blen bound 512
    w = write int fd g_svg off sub blen off
    if le w 0
      ok = false
      break
    end
    off = add off ulong w
  end
  x = fclose int fd
  ret ok
end

fn write_out_html to bool
  join_out_path t_fn_html
  fd = fopen g_path 0 get g_pathl 0 577 420
  if lt fd 0
    ret false
  end
  blen = get g_htmll 0
  off = ulong 0
  ok = true
  while lt off blen bound 512
    w = write int fd g_html off sub blen off
    if le w 0
      ok = false
      break
    end
    off = add off ulong w
  end
  x = fclose int fd
  ret ok
end

fn write_out_stat to bool
  join_out_path t_fn_stat
  fd = fopen g_path 0 get g_pathl 0 577 420
  if lt fd 0
    ret false
  end
  blen = get g_stxtl 0
  off = ulong 0
  ok = true
  while lt off blen bound 512
    w = write int fd g_stxt off sub blen off
    if le w 0
      ok = false
      break
    end
    off = add off ulong w
  end
  x = fclose int fd
  ret ok
end

note ---- Secret pattern detection on g_in[lo..hi) ----

fn in_ci_match pos ulong hi ulong pat view uchar * to bool
  pl = len pat
  if gt add pos pl hi
    ret false
  end
  for i ulong pl bound 32
    c = lc get g_in add pos i
    if ne c get pat i
      ret false
    end
  end
  ret true
end

fn in_has_secret_at pos ulong hi ulong to bool
  if in_ci_match pos hi t_pat_sk
    ret true
  end
  if in_ci_match pos hi t_pat_ghp
    ret true
  end
  if in_ci_match pos hi t_pat_gho
    ret true
  end
  if in_ci_match pos hi t_pat_ghu
    ret true
  end
  if in_ci_match pos hi t_pat_ghs
    ret true
  end
  if in_ci_match pos hi t_pat_bearer
    ret true
  end
  if in_ci_match pos hi t_pat_tok
    ret true
  end
  if in_ci_match pos hi t_pat_users
    ret true
  end
  if in_ci_match pos hi t_pat_home
    ret true
  end
  if in_ci_match pos hi t_pat_akia
    ret true
  end
  ret in_ci_match pos hi t_pat_xoxb
end

fn in_has_secret lo ulong hi ulong to bool
  i = lo
  while lt i hi bound HF_MAX_FILE
    if in_has_secret_at i hi
      ret true
    end
    i = add i 1
  end
  ret false
end

fn in_has_sub lo ulong hi ulong pat view uchar * to bool
  i = lo
  while lt i hi bound 256
    if in_ci_match i hi pat
      ret true
    end
    i = add i 1
  end
  ret false
end

fn in_eq_exact lo ulong hi ulong pat view uchar * to bool
  if ne sub hi lo len pat
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_in add lo i get pat i
      ret false
    end
  end
  ret true
end

note ---- TSV Parsing & Aggregation ----

fn parse_u64_in lo ulong hi ulong to long
  if ge lo hi
    ret -1
  end
  if gt sub hi lo 18
    ret -1
  end
  v = ulong 0
  i = lo
  while lt i hi bound 20
    c = get g_in i
    if not is_digit c
      ret -1
    end
    v = add mul v 10 ulong sub c 48
    i = add i 1
  end
  ret long v
end

fn valid_date_in lo ulong hi ulong to bool
  if ne sub hi lo 10
    ret false
  end
  if ne get g_in add lo 4 45
    ret false
  end
  if ne get g_in add lo 7 45
    ret false
  end
  for i ulong 10 bound 10
    if and ne i 4 ne i 7
      if not is_digit get g_in add lo i
        ret false
      end
    end
  end
  m0 = ulong sub get g_in add lo 5 48
  m1 = ulong sub get g_in add lo 6 48
  mo = add mul m0 10 m1
  if or lt mo 1 gt mo 12
    ret false
  end
  d0 = ulong sub get g_in add lo 8 48
  d1 = ulong sub get g_in add lo 9 48
  dy = add mul d0 10 d1
  if or lt dy 1 gt dy 31
    ret false
  end
  ret true
end

fn valid_label_in lo ulong hi ulong to bool
  n = sub hi lo
  if or eq n 0 gt n 63
    ret false
  end
  i = lo
  while lt i hi bound 64
    c = get g_in i
    if or lt c 32 eq c 127
      ret false
    end
    i = add i 1
  end
  ret true
end

fn split_tabs lo ulong hi ulong expect ulong to bool
  f = ulong 0
  cur = lo
  i = lo
  while lt i hi bound 4096
    if eq get g_in i 9
      if ge f expect
        ret false
      end
      put g_fpos mul f 2 cur
      put g_fpos add mul f 2 1 i
      f = add f 1
      cur = add i 1
    end
    i = add i 1
  end
  if ne f sub expect 1
    ret false
  end
  put g_fpos mul f 2 cur
  put g_fpos add mul f 2 1 hi
  ret true
end

fn classify_family lo ulong hi ulong to ulong
  if in_has_sub lo hi t_f_gemini
    ret 0
  end
  if in_has_sub lo hi t_f_google
    ret 0
  end
  if in_has_sub lo hi t_f_claude
    ret 1
  end
  if in_has_sub lo hi t_f_anth
    ret 1
  end
  if in_has_sub lo hi t_f_omega
    ret 2
  end
  if in_has_sub lo hi t_f_qwen
    ret 2
  end
  if in_has_sub lo hi t_f_local
    ret 2
  end
  if in_has_sub lo hi t_f_ollm
    ret 2
  end
  if in_has_sub lo hi t_f_q36
    ret 2
  end
  if in_has_sub lo hi t_f_ink
    ret 2
  end
  if in_has_sub lo hi t_f_codex
    ret 3
  end
  if in_has_sub lo hi t_f_gpt
    ret 3
  end
  if in_has_sub lo hi t_f_openai
    ret 3
  end
  ret 4
end

fn ag_eq_in idx ulong lo ulong hi ulong to bool
  n = sub hi lo
  if ne get g_ag_nlen idx n
    ret false
  end
  base = mul idx 64
  for i ulong n bound 64
    if ne get g_ag_name add base i get g_in add lo i
      ret false
    end
  end
  ret true
end

fn find_or_add_agent lo ulong hi ulong to ulong
  cnt = get g_ag_cnt 0
  for i ulong cnt bound HF_MAX_AGENTS
    if ag_eq_in i lo hi
      ret i
    end
  end
  if ge cnt HF_MAX_AGENTS
    ret HF_MAX_AGENTS
  end
  n = sub hi lo
  base = mul cnt 64
  for j ulong n bound 64
    put g_ag_name add base j get g_in add lo j
  end
  put g_ag_nlen cnt n
  put g_ag_turns cnt 0
  put g_ag_sess cnt 0
  put g_ag_toks cnt 0
  put g_ag_cnt 0 add cnt 1
  ret cnt
end

fn day_eq_in idx ulong lo ulong to bool
  base = mul idx 10
  for i ulong 10 bound 10
    if ne get g_day_str add base i get g_in add lo i
      ret false
    end
  end
  ret true
end

fn find_or_add_day lo ulong to ulong
  cnt = get g_day_cnt 0
  for i ulong cnt bound HF_MAX_DAYS
    if day_eq_in i lo
      ret i
    end
  end
  if ge cnt HF_MAX_DAYS
    ret HF_MAX_DAYS
  end
  base = mul cnt 10
  for j ulong 10 bound 10
    put g_day_str add base j get g_in add lo j
  end
  fbase = mul cnt 5
  for f ulong 5 bound 5
    put g_day_ft add fbase f 0
  end
  put g_day_tot cnt 0
  put g_day_cnt 0 add cnt 1
  ret cnt
end

fn accum_usage_row fam ulong utu ulong use ulong utk ulong to void
  put g_fam_turns fam add get g_fam_turns fam utu
  put g_fam_sess fam add get g_fam_sess fam use
  put g_fam_toks fam add get g_fam_toks fam utk
  put g_tot 0 add get g_tot 0 utu
  put g_tot 1 add get g_tot 1 use
  put g_tot 2 add get g_tot 2 utk
  put g_tot 3 add get g_tot 3 1
  ai = find_or_add_agent get g_fpos 2 get g_fpos 3
  if lt ai HF_MAX_AGENTS
    put g_ag_turns ai add get g_ag_turns ai utu
    put g_ag_sess ai add get g_ag_sess ai use
    put g_ag_toks ai add get g_ag_toks ai utk
  end
  di = find_or_add_day get g_fpos 0
  if lt di HF_MAX_DAYS
    slot = add mul di 5 fam
    put g_day_ft slot add get g_day_ft slot utu
    put g_day_tot di add get g_day_tot di utu
  end
end

fn day_lt a ulong b ulong to bool
  ba = mul a 10
  bb = mul b 10
  for i ulong 10 bound 10
    ca = get g_day_str add ba i
    cb = get g_day_str add bb i
    if lt ca cb
      ret true
    end
    if gt ca cb
      ret false
    end
  end
  ret false
end

fn swap_days a ulong b ulong to void
  ba = mul a 10
  bb = mul b 10
  for i ulong 10 bound 10
    t = get g_day_str add ba i
    put g_day_str add ba i get g_day_str add bb i
    put g_day_str add bb i t
  end
  fa = mul a 5
  fb = mul b 5
  for f ulong 5 bound 5
    v = get g_day_ft add fa f
    put g_day_ft add fa f get g_day_ft add fb f
    put g_day_ft add fb f v
  end
  tv = get g_day_tot a
  put g_day_tot a get g_day_tot b
  put g_day_tot b tv
end

fn sort_days to void
  n = get g_day_cnt 0
  if le n 1
    ret
  end
  for i ulong sub n 1 bound HF_MAX_DAYS
    best = i
    j = add i 1
    while lt j n bound HF_MAX_DAYS
      if day_lt j best
        best = j
      end
      j = add j 1
    end
    if ne best i
      swap_days i best
    end
  end
end

fn swap_agents a ulong b ulong to void
  ba = mul a 64
  bb = mul b 64
  for i ulong 64 bound 64
    t = get g_ag_name add ba i
    put g_ag_name add ba i get g_ag_name add bb i
    put g_ag_name add bb i t
  end
  nl = get g_ag_nlen a
  put g_ag_nlen a get g_ag_nlen b
  put g_ag_nlen b nl
  tu = get g_ag_turns a
  put g_ag_turns a get g_ag_turns b
  put g_ag_turns b tu
  se = get g_ag_sess a
  put g_ag_sess a get g_ag_sess b
  put g_ag_sess b se
  tk = get g_ag_toks a
  put g_ag_toks a get g_ag_toks b
  put g_ag_toks b tk
end

fn sort_agents to void
  n = get g_ag_cnt 0
  if le n 1
    ret
  end
  for i ulong sub n 1 bound HF_MAX_AGENTS
    best = i
    j = add i 1
    while lt j n bound HF_MAX_AGENTS
      if gt get g_ag_turns j get g_ag_turns best
        best = j
      end
      j = add j 1
    end
    if ne best i
      swap_agents i best
    end
  end
end

fn reset_usage to void
  for f ulong 5 bound 5
    put g_fam_turns f 0
    put g_fam_sess f 0
    put g_fam_toks f 0
  end
  for k ulong 4 bound 4
    put g_tot k 0
  end
  put g_ag_cnt 0 0
  put g_day_cnt 0 0
end

fn is_header_row lo ulong hi ulong to bool
  if lt sub hi lo 5
    ret false
  end
  if ne get g_in lo 100
    ret false
  end
  if ne get g_in add lo 1 97
    ret false
  end
  if ne get g_in add lo 2 116
    ret false
  end
  if ne get g_in add lo 3 101
    ret false
  end
  ret eq get g_in add lo 4 9
end

fn parse_usage_row lo ulong hi ulong to ulong
  if in_has_secret lo hi
    ret 2
  end
  if not split_tabs lo hi 6
    ret 1
  end
  if not valid_date_in get g_fpos 0 get g_fpos 1
    ret 1
  end
  if not valid_label_in get g_fpos 2 get g_fpos 3
    ret 1
  end
  if not valid_label_in get g_fpos 4 get g_fpos 5
    ret 1
  end
  tu = parse_u64_in get g_fpos 6 get g_fpos 7
  if lt tu 0
    ret 1
  end
  se = parse_u64_in get g_fpos 8 get g_fpos 9
  if lt se 0
    ret 1
  end
  tk = parse_u64_in get g_fpos 10 get g_fpos 11
  if lt tk 0
    ret 1
  end
  fam = classify_family get g_fpos 4 get g_fpos 5
  accum_usage_row fam ulong tu ulong se ulong tk
  ret 0
end

fn load_usage to bool
  reset_usage
  if not read_in_usage
    x = write 2 t_err_tsv 0 len t_err_tsv
    ret false
  end
  n = get g_inl 0
  if eq n 0
    x = write 2 t_err_tsv 0 len t_err_tsv
    ret false
  end
  pos = ulong 0
  first = true
  while lt pos n bound HF_MAX_FILE
    l0 = pos
    while lt pos n bound HF_MAX_FILE
      if eq get g_in pos 10
        break
      end
      pos = add pos 1
    end
    l1 = pos
    if lt pos n
      pos = add pos 1
    end
    if gt l1 l0
      if eq get g_in sub l1 1 13
        l1 = sub l1 1
      end
    end
    if eq l1 l0
      continue
    end
    if and first is_header_row l0 l1
      first = false
      if not split_tabs l0 l1 6
        x = write 2 t_err_tsv 0 len t_err_tsv
        ret false
      end
      continue
    end
    first = false
    rc = parse_usage_row l0 l1
    if eq rc 2
      x = write 2 t_err_secret 0 len t_err_secret
      ret false
    end
    if ne rc 0
      x = write 2 t_err_tsv 0 len t_err_tsv
      ret false
    end
  end
  if eq get g_tot 3 0
    x = write 2 t_err_tsv 0 len t_err_tsv
    ret false
  end
  sort_days
  sort_agents
  ret true
end

note ---- Fail-closed catalog.tsv & sync.log loader ----

fn valid_repo_in lo ulong hi ulong to bool
  n = sub hi lo
  if or eq n 0 gt n 63
    ret false
  end
  i = lo
  while lt i hi bound 64
    c = get g_in i
    if not is_repo_ch c
      ret false
    end
    if eq c 46
      if lt add i 1 hi
        if eq get g_in add i 1 46
          ret false
        end
      end
    end
    i = add i 1
  end
  ret true
end

fn valid_hex_in lo ulong hi ulong minl ulong maxl ulong to bool
  n = sub hi lo
  if or lt n minl gt n maxl
    ret false
  end
  i = lo
  while lt i hi bound 64
    if not is_hex get g_in i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn valid_br_in lo ulong hi ulong to bool
  n = sub hi lo
  if or eq n 0 gt n 63
    ret false
  end
  i = lo
  while lt i hi bound 64
    c = get g_in i
    if not is_br_ch c
      ret false
    end
    if eq c 46
      if lt add i 1 hi
        if eq get g_in add i 1 46
          ret false
        end
      end
    end
    i = add i 1
  end
  ret true
end

fn valid_ts_in lo ulong hi ulong to bool
  n = sub hi lo
  if or lt n 8 gt n 31
    ret false
  end
  i = lo
  while lt i hi bound 32
    if not is_ts_ch get g_in i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn pub_eq_in idx ulong lo ulong hi ulong to bool
  n = sub hi lo
  if ne get g_pub_nlen idx n
    ret false
  end
  base = mul idx 64
  for i ulong n bound 64
    if ne get g_pub_name add base i get g_in add lo i
      ret false
    end
  end
  ret true
end

fn find_public_repo lo ulong hi ulong to long
  cnt = get g_pub_cnt 0
  for i ulong cnt bound HF_MAX_REPOS
    if pub_eq_in i lo hi
      ret long i
    end
  end
  ret -1
end

fn store_pub_name cnt ulong to void
  r0 = get g_fpos 0
  rn = sub get g_fpos 1 r0
  rbase = mul cnt 64
  for i ulong rn bound 64
    put g_pub_name add rbase i get g_in add r0 i
  end
  put g_pub_nlen cnt rn
end

fn store_pub_br cnt ulong to void
  b0 = get g_fpos 4
  bn = sub get g_fpos 5 b0
  bbase = mul cnt 64
  for i ulong bn bound 64
    put g_pub_br add bbase i get g_in add b0 i
  end
  put g_pub_blen cnt bn
end

fn store_pub_sha cnt ulong to void
  s0 = get g_fpos 6
  sn = sub get g_fpos 7 s0
  if gt sn 40
    sn = 40
  end
  sbase = mul cnt 48
  for i ulong sn bound 48
    put g_pub_sha add sbase i get g_in add s0 i
  end
  put g_pub_slen cnt sn
end

fn store_pub_from_fpos to void
  cnt = get g_pub_cnt 0
  if ge cnt HF_MAX_REPOS
    ret
  end
  store_pub_name cnt
  store_pub_br cnt
  store_pub_sha cnt
  put g_pub_cnt 0 add cnt 1
end

fn parse_catalog_line l0 ulong l1 ulong to void
  if in_has_secret l0 l1
    put g_priv_stat 1 add get g_priv_stat 1 1
    ret
  end
  if not split_tabs l0 l1 5
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  if not in_eq_exact get g_fpos 8 get g_fpos 9 t_public
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  if not valid_repo_in get g_fpos 0 get g_fpos 1
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  if not valid_hex_in get g_fpos 2 get g_fpos 3 8 64
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  if not valid_br_in get g_fpos 4 get g_fpos 5
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  if not valid_hex_in get g_fpos 6 get g_fpos 7 4 64
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  store_pub_from_fpos
end

fn split_ws_tokens l0 ulong l1 ulong to ulong
  cnt = ulong 0
  i = l0
  while lt i l1 bound 4096
    while lt i l1 bound 4096
      c = get g_in i
      if and ne c 32 ne c 9
        break
      end
      i = add i 1
    end
    if ge i l1
      break
    end
    t0 = i
    while lt i l1 bound 4096
      c = get g_in i
      if or eq c 32 eq c 9
        break
      end
      i = add i 1
    end
    if lt cnt 6
      put g_fpos mul cnt 2 t0
      put g_fpos add mul cnt 2 1 i
      cnt = add cnt 1
    end
  end
  ret cnt
end

fn shift_events_left to void
  for k ulong sub HF_MAX_EVENTS 1 bound HF_MAX_EVENTS
    nxt = add k 1
    for i ulong 32 bound 32
      put g_ev_ts add mul k 32 i get g_ev_ts add mul nxt 32 i
    end
    put g_ev_tsl k get g_ev_tsl nxt
    for i ulong 64 bound 64
      put g_ev_repo add mul k 64 i get g_ev_repo add mul nxt 64 i
    end
    put g_ev_rlen k get g_ev_rlen nxt
    for i ulong 48 bound 48
      put g_ev_sha add mul k 48 i get g_ev_sha add mul nxt 48 i
    end
    put g_ev_slen k get g_ev_slen nxt
  end
  put g_ev_cnt 0 sub HF_MAX_EVENTS 1
end

fn push_ev_ts cnt ulong to void
  ts0 = get g_evtmp 0
  ts1 = get g_evtmp 1
  tbase = mul cnt 32
  if gt ts1 ts0
    tn = sub ts1 ts0
    if gt tn 31
      tn = 31
    end
    for i ulong tn bound 32
      put g_ev_ts add tbase i get g_in add ts0 i
    end
    put g_ev_tsl cnt tn
  else
    for i ulong len t_live bound 8
      put g_ev_ts add tbase i get t_live i
    end
    put g_ev_tsl cnt len t_live
  end
end

fn push_ev_repo cnt ulong to void
  r0 = get g_evtmp 2
  rn = sub get g_evtmp 3 r0
  rbase = mul cnt 64
  for i ulong rn bound 64
    put g_ev_repo add rbase i get g_in add r0 i
  end
  put g_ev_rlen cnt rn
end

fn push_ev_sha cnt ulong to void
  s0 = get g_evtmp 4
  sn = sub get g_evtmp 5 s0
  if gt sn 12
    sn = 12
  end
  sbase = mul cnt 48
  for i ulong sn bound 16
    put g_ev_sha add sbase i get g_in add s0 i
  end
  put g_ev_slen cnt sn
end

fn push_event_from_tmp to void
  cnt = get g_ev_cnt 0
  if ge cnt HF_MAX_EVENTS
    shift_events_left
    cnt = get g_ev_cnt 0
  end
  push_ev_ts cnt
  push_ev_repo cnt
  push_ev_sha cnt
  put g_ev_cnt 0 add cnt 1
end

fn find_ok_tok ntok ulong to ulong
  for k ulong ntok bound 6
    if in_eq_exact get g_fpos mul k 2 get g_fpos add mul k 2 1 t_ok_tok
      ret k
    end
  end
  ret 99
end

fn parse_sync_line l0 ulong l1 ulong to void
  if in_has_secret l0 l1
    put g_priv_stat 1 add get g_priv_stat 1 1
    ret
  end
  ntok = split_ws_tokens l0 l1
  if lt ntok 3
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  ok_idx = find_ok_tok ntok
  if ge add ok_idx 2 ntok
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  r0 = get g_fpos mul add ok_idx 1 2
  r1 = get g_fpos add mul add ok_idx 1 2 1
  if lt find_public_repo r0 r1 0
    put g_priv_stat 0 add get g_priv_stat 0 1
    ret
  end
  s0 = get g_fpos mul add ok_idx 2 2
  s1 = get g_fpos add mul add ok_idx 2 2 1
  if not valid_hex_in s0 s1 4 40
    put g_priv_stat 1 add get g_priv_stat 1 1
    ret
  end
  put g_evtmp 0 0
  put g_evtmp 1 0
  if gt ok_idx 0
    if valid_ts_in get g_fpos 0 get g_fpos 1
      put g_evtmp 0 get g_fpos 0
      put g_evtmp 1 get g_fpos 1
    end
  end
  put g_evtmp 2 r0
  put g_evtmp 3 r1
  put g_evtmp 4 s0
  put g_evtmp 5 s1
  push_event_from_tmp
end

fn load_catalog to void
  if not read_in_cat
    ret
  end
  n = get g_inl 0
  pos = ulong 0
  while lt pos n bound HF_MAX_FILE
    l0 = pos
    while lt pos n bound HF_MAX_FILE
      if eq get g_in pos 10
        break
      end
      pos = add pos 1
    end
    l1 = pos
    if lt pos n
      pos = add pos 1
    end
    if gt l1 l0
      if eq get g_in sub l1 1 13
        l1 = sub l1 1
      end
    end
    if gt l1 l0
      parse_catalog_line l0 l1
    end
  end
end

fn load_sync_log to void
  if not read_in_log
    ret
  end
  n = get g_inl 0
  pos = ulong 0
  while lt pos n bound HF_MAX_FILE
    l0 = pos
    while lt pos n bound HF_MAX_FILE
      if eq get g_in pos 10
        break
      end
      pos = add pos 1
    end
    l1 = pos
    if lt pos n
      pos = add pos 1
    end
    if gt l1 l0
      if eq get g_in sub l1 1 13
        l1 = sub l1 1
      end
    end
    if gt l1 l0
      parse_sync_line l0 l1
    end
  end
end

fn load_live_feed to void
  put g_pub_cnt 0 0
  put g_ev_cnt 0 0
  put g_priv_stat 0 0
  put g_priv_stat 1 0
  load_catalog
  load_sync_log
end

note ---- Read-only Spark thermal sysfs ----

fn read_sysfs_mc p view uchar * to long
  fd = fopen p 0 len p 0 0
  if lt fd 0
    ret -1
  end
  r = read int fd g_tmp 0 64
  x = fclose int fd
  if le r 0
    ret -1
  end
  n = ulong r
  v = ulong 0
  got = false
  for i ulong n bound 64
    c = get g_tmp i
    if is_digit c
      v = add mul v 10 ulong sub c 48
      got = true
    else
      if or eq c 10 or eq c 13 eq c 32
        break
      end
      ret -1
    end
  end
  if not got
    ret -1
  end
  ret long v
end

fn read_thermal to void
  put g_therm 0 0
  put g_therm 1 0
  put g_therm 2 0
  put g_therm 3 0
  g = read_sysfs_mc t_th_gpu
  if ge g 0
    put g_therm 0 1
    put g_therm 1 ulong g
  end
  s = read_sysfs_mc t_th_soc
  if ge s 0
    put g_therm 2 1
    put g_therm 3 ulong s
  end
end


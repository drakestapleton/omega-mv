note ---- Helpers ----

fn stop_server to void
  pid = get g_srv_pid 0
  if gt pid 0
    x = killpid int pid 9
    w = waitpid int pid g_wstat 0 4 0
    put g_srv_pid 0 0
  end
end

fn fail_msg m view uchar * to int
  stop_server
  x = write 2 t_fail_pre 0 len t_fail_pre
  x = write 2 m 0 len m
  x = write 2 t_nl 0 1
  ret 1
end

fn u64_to_dec v ulong to ulong
  if eq v 0
    put g_dec 0 48
    ret 1
  end
  x = v
  n = ulong 0
  while gt x 0 bound 24
    put g_dec n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  j = sub n 1
  while lt i j bound 24
    a = get g_dec i
    put g_dec i get g_dec j
    put g_dec j a
    i = add i 1
    j = sub j 1
  end
  ret n
end

fn set_p1 suf view uchar * to void
  n = get g_workl 0
  for i ulong n bound 512
    put g_p1 i get g_work i
  end
  for j ulong len suf bound 128
    if lt n 511
      put g_p1 n get suf j
      n = add n 1
    end
  end
  put g_p1l 0 n
end

fn set_p2 suf view uchar * to void
  n = get g_workl 0
  for i ulong n bound 512
    put g_p2 i get g_work i
  end
  for j ulong len suf bound 128
    if lt n 511
      put g_p2 n get suf j
      n = add n 1
    end
  end
  put g_p2l 0 n
end

fn write_p1 body view uchar * to bool
  fd = fopen g_p1 0 get g_p1l 0 577 420
  if lt fd 0
    ret false
  end
  w = write int fd body 0 len body
  x = fclose int fd
  ret eq w long len body
end

fn write_p2 body view uchar * to bool
  fd = fopen g_p2 0 get g_p2l 0 577 420
  if lt fd 0
    ret false
  end
  w = write int fd body 0 len body
  x = fclose int fd
  ret eq w long len body
end

fn read_p1_to_buf to bool
  put g_bufl 0 0
  fd = fopen g_p1 0 get g_p1l 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot G_BUF_CAP bound 512
    r = read int fd g_buf tot sub G_BUF_CAP tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  x = fclose int fd
  put g_bufl 0 tot
  ret gt tot 0
end

fn read_p2_to_buf2 to bool
  put g_buf2l 0 0
  fd = fopen g_p2 0 get g_p2l 0 0 0
  if lt fd 0
    ret false
  end
  tot = ulong 0
  while lt tot G_BUF_CAP bound 512
    r = read int fd g_buf2 tot sub G_BUF_CAP tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  x = fclose int fd
  put g_buf2l 0 tot
  ret gt tot 0
end

fn buf_has_at pos ulong pat view uchar * to bool
  n = get g_bufl 0
  pl = len pat
  if gt add pos pl n
    ret false
  end
  for i ulong pl bound 256
    if ne get g_buf add pos i get pat i
      ret false
    end
  end
  ret true
end

fn buf_contains pat view uchar * to bool
  n = get g_bufl 0
  pl = len pat
  if or eq pl 0 gt pl n
    ret false
  end
  lim = add sub n pl 1
  for i ulong lim bound G_BUF_CAP
    if buf_has_at i pat
      ret true
    end
  end
  ret false
end

fn lc b uchar to uchar
  if and ge b 65 le b 90
    ret add b 32
  end
  ret b
end

fn buf_ci_at pos ulong pat view uchar * to bool
  n = get g_bufl 0
  pl = len pat
  if gt add pos pl n
    ret false
  end
  for i ulong pl bound 128
    c1 = lc get g_buf add pos i
    c2 = lc get pat i
    if ne c1 c2
      ret false
    end
  end
  ret true
end

fn buf_ci_contains pat view uchar * to bool
  n = get g_bufl 0
  pl = len pat
  if or eq pl 0 gt pl n
    ret false
  end
  lim = add sub n pl 1
  for i ulong lim bound G_BUF_CAP
    if buf_ci_at i pat
      ret true
    end
  end
  ret false
end

fn bufs_equal to bool
  n = get g_bufl 0
  if ne n get g_buf2l 0
    ret false
  end
  for i ulong n bound G_BUF_CAP
    if ne get g_buf i get g_buf2 i
      ret false
    end
  end
  ret true
end

note ---- Packet builders for execprog ----

fn pkt_begin cnt ulong to void
  put g_pkt 0 uchar and cnt 255
  put g_pkt 1 uchar shr cnt 8
  put g_pktl 0 2
end

fn pkt_add_txt a view uchar * to void
  al = len a
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 512
    put g_pkt p get a i
    p = add p 1
  end
  put g_pktl 0 p
end

fn pkt_add_bin to void
  al = get g_binl 0
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 512
    put g_pkt p get g_bin i
    p = add p 1
  end
  put g_pktl 0 p
end

fn pkt_add_samp to void
  al = get g_sampl 0
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 512
    put g_pkt p get g_samp i
    p = add p 1
  end
  put g_pktl 0 p
end

fn pkt_add_p1 to void
  al = get g_p1l 0
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 512
    put g_pkt p get g_p1 i
    p = add p 1
  end
  put g_pktl 0 p
end

fn pkt_add_p2 to void
  al = get g_p2l 0
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 512
    put g_pkt p get g_p2 i
    p = add p 1
  end
  put g_pktl 0 p
end

fn pkt_add_dec al ulong to void
  p = get g_pktl 0
  put g_pkt p uchar and al 255
  put g_pkt add p 1 uchar shr al 8
  p = add p 2
  for i ulong al bound 32
    put g_pkt p get g_dec i
    p = add p 1
  end
  put g_pktl 0 p
end

fn run_pkt_wait to int
  pid = fork
  if lt pid 0
    ret 99
  end
  if eq pid 0
    r = execprog g_pkt 0 get g_pktl 0
    ret 98
  end
  w = waitpid int pid g_wstat 0 4 0
  if lt w 0
    ret 97
  end
  b0 = ulong get g_wstat 0
  b1 = ulong get g_wstat 1
  if ne and b0 127 0
    ret 96
  end
  ret int b1
end

fn run_render_samp_p1 to int
  pkt_begin 4
  pkt_add_bin
  pkt_add_txt t_flag_render
  pkt_add_samp
  pkt_add_p1
  ret run_pkt_wait
end

fn run_render_samp_p2 to int
  pkt_begin 4
  pkt_add_bin
  pkt_add_txt t_flag_render
  pkt_add_samp
  pkt_add_p2
  ret run_pkt_wait
end

fn run_render_p1_p2 to int
  pkt_begin 4
  pkt_add_bin
  pkt_add_txt t_flag_render
  pkt_add_p1
  pkt_add_p2
  ret run_pkt_wait
end

note ---- Pure-OM-2 Loopback HTTP Client ----

fn sock_connect_lo to long
  fd = socknew 2 524289 0
  if lt fd 0
    ret -1
  end
  port = get g_port 0
  a = new uchar 16 0
  put a 0 2
  put a 2 uchar shr port 8
  put a 3 uchar and port 255
  put a 4 uchar shr G_IP_LO 24
  put a 5 uchar and shr G_IP_LO 16 255
  put a 6 uchar and shr G_IP_LO 8 255
  put a 7 uchar and G_IP_LO 255
  rc = connect int fd a 0 16
  if lt rc 0
    x = fclose int fd
    ret -1
  end
  ret fd
end

fn sock_read_all fd int to bool
  put g_bufl 0 0
  tot = ulong 0
  while lt tot G_BUF_CAP bound 2048
    w = waitio fd 1 2000000000
    if le w 0
      break
    end
    r = recv fd g_buf tot sub G_BUF_CAP tot 0
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  put g_bufl 0 tot
  ret gt tot 0
end

fn http_call_big rlen ulong to bool
  fd = sock_connect_lo
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off rlen bound 1024
    s = send int fd g_req off sub rlen off 16384
    if le s 0
      break
    end
    off = add off ulong s
  end
  ok = sock_read_all int fd
  x = fclose int fd
  ret ok
end

fn req_put_txt pos ulong t view uchar * to ulong
  p = pos
  for i ulong len t bound 128
    put g_req p get t i
    p = add p 1
  end
  ret p
end

fn req_put_crlf pos ulong to ulong
  put g_req pos 13
  put g_req add pos 1 10
  ret add pos 2
end

fn build_http_req meth view uchar * path view uchar * add_cl0 bool to ulong
  p = ulong 0
  p = req_put_txt p meth
  p = req_put_txt p path
  p = req_put_txt p t_http_ver
  p = req_put_crlf p
  p = req_put_txt p t_host_hdr
  p = req_put_crlf p
  if add_cl0
    p = req_put_txt p t_cl0_hdr
    p = req_put_crlf p
  end
  p = req_put_crlf p
  ret p
end

fn http_call_req meth view uchar * path view uchar * add_cl0 bool to bool
  rlen = build_http_req meth path add_cl0
  ret http_call_big rlen
end

fn check_ok_body to bool
  n = get g_bufl 0
  if lt n 7
    ret false
  end
  b = sub n 7
  if ne get g_buf b 13
    ret false
  end
  if ne get g_buf add b 1 10
    ret false
  end
  if ne get g_buf add b 2 13
    ret false
  end
  if ne get g_buf add b 3 10
    ret false
  end
  if ne get g_buf add b 4 111
    ret false
  end
  if ne get g_buf add b 5 107
    ret false
  end
  ret eq get g_buf add b 6 10
end

fn start_server to bool
  port = add ulong 18500 rem ulong monons 400
  put g_port 0 port
  dn = u64_to_dec port
  pkt_begin 6
  pkt_add_bin
  pkt_add_txt t_flag_serve
  pkt_add_dec dn
  pkt_add_samp
  pkt_add_p1
  pkt_add_p2
  pid = fork
  if lt pid 0
    ret false
  end
  if eq pid 0
    r = execprog g_pkt 0 get g_pktl 0
    ret false
  end
  put g_srv_pid 0 pid
  for tries ulong 40 bound 40
    if http_call_req t_m_get t_p_health false
      if buf_contains t_n_200
        ret true
      end
    end
    s = sleepns 50000000
  end
  ret false
end

fn check_no_xss to bool
  if buf_ci_contains t_n_script
    ret false
  end
  if buf_ci_contains t_n_onerr
    ret false
  end
  if buf_ci_contains t_n_js
    ret false
  end
  ret true
end

fn check_no_leaks to bool
  if buf_contains t_n_priv1
    ret false
  end
  if buf_contains t_n_priv2
    ret false
  end
  if buf_contains t_n_priv3
    ret false
  end
  ret true
end

fn check_no_secrets to bool
  if buf_contains t_n_sec1
    ret false
  end
  if buf_contains t_n_sec2
    ret false
  end
  if buf_contains t_n_sec3
    ret false
  end
  if buf_contains t_n_sec4
    ret false
  end
  if buf_ci_contains t_n_sec5
    ret false
  end
  ret true
end

fn check_head_empty_body to bool
  n = get g_bufl 0
  if lt n 4
    ret false
  end
  lim = sub n 3
  for i ulong lim bound 4096
    if eq get g_buf i 13
      if eq get g_buf add i 1 10
        if eq get g_buf add i 2 13
          if eq get g_buf add i 3 10
            ret eq add i 4 n
          end
        end
      end
    end
  end
  ret false
end

fn build_oversized_req to ulong
  p = ulong 0
  p = req_put_txt p t_m_get
  put g_req p 47
  p = add p 1
  for j ulong 9000 bound 9000
    put g_req p 97
    p = add p 1
  end
  p = req_put_txt p t_http_ver
  p = req_put_crlf p
  p = req_put_txt p t_host_hdr
  p = req_put_crlf p
  p = req_put_crlf p
  ret p
end

fn verify_svg_buf to bool
  if not buf_contains t_n_svg1
    ret false
  end
  if not buf_contains t_n_svg2
    ret false
  end
  if not buf_contains t_n_bg
    ret false
  end
  if not buf_contains t_n_c1
    ret false
  end
  if not buf_contains t_n_c2
    ret false
  end
  if not buf_contains t_n_c3
    ret false
  end
  if not buf_contains t_n_c4
    ret false
  end
  if not buf_contains t_n_gem
    ret false
  end
  if not buf_contains t_n_cla
    ret false
  end
  if not buf_contains t_n_cod
    ret false
  end
  if not buf_contains t_n_loc
    ret false
  end
  if not buf_contains t_n_svg_tot
    ret false
  end
  if not buf_contains t_n_svg_tok
    ret false
  end
  ret check_no_xss
end

fn verify_html_buf to bool
  if not buf_contains t_n_doc
    ret false
  end
  if not buf_contains t_n_svg1
    ret false
  end
  if not buf_contains t_n_svg2
    ret false
  end
  if not buf_contains t_n_gem
    ret false
  end
  ret check_no_xss
end

fn verify_stat_buf to bool
  if not buf_contains t_n_sok
    ret false
  end
  if not buf_contains t_n_tturns
    ret false
  end
  if not buf_contains t_n_fgem
    ret false
  end
  if not buf_contains t_n_tgpu
    ret false
  end
  ret buf_contains t_n_tsoc
end

fn run_render_tests to int
  set_p1 t_s_out1
  if ne run_render_samp_p1 0
    ret fail_msg t_e_r1
  end
  put g_cnt 0 add get g_cnt 0 1

  set_p1 t_s_svg
  if not read_p1_to_buf
    ret fail_msg t_e_svg
  end
  if not verify_svg_buf
    ret fail_msg t_e_svg
  end
  put g_cnt 0 add get g_cnt 0 1

  set_p1 t_s_html
  if not read_p1_to_buf
    ret fail_msg t_e_html
  end
  if not verify_html_buf
    ret fail_msg t_e_html
  end
  put g_cnt 0 add get g_cnt 0 1

  set_p1 t_s_stat
  if not read_p1_to_buf
    ret fail_msg t_e_stat
  end
  if not verify_stat_buf
    ret fail_msg t_e_stat
  end
  put g_cnt 0 add get g_cnt 0 1

  set_p2 t_s_out2
  if ne run_render_samp_p2 0
    ret fail_msg t_e_det
  end
  set_p1 t_s_svg
  set_p2 t_s_svg2
  if not read_p1_to_buf
    ret fail_msg t_e_det
  end
  if not read_p2_to_buf2
    ret fail_msg t_e_det
  end
  if not bufs_equal
    ret fail_msg t_e_det
  end
  put g_cnt 0 add get g_cnt 0 1
  ret 0
end

fn run_negative_tsv_tests to int
  set_p2 t_s_outb

  set_p1 t_s_bad1
  ok = write_p1 t_f_bad1
  if eq run_render_p1_p2 0
    ret fail_msg t_e_bad
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_bad2
  ok = write_p1 t_f_bad2
  if eq run_render_p1_p2 0
    ret fail_msg t_e_bad
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_bad3
  ok = write_p1 t_f_bad3
  if eq run_render_p1_p2 0
    ret fail_msg t_e_bad
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_sec1
  ok = write_p1 t_f_sec1
  if eq run_render_p1_p2 0
    ret fail_msg t_e_sec
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_sec2
  ok = write_p1 t_f_sec2
  if eq run_render_p1_p2 0
    ret fail_msg t_e_sec
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_sec3
  ok = write_p1 t_f_sec3
  if eq run_render_p1_p2 0
    ret fail_msg t_e_sec
  end
  put g_cnt 1 add get g_cnt 1 1

  set_p1 t_s_xss
  set_p2 t_s_outx
  ok = write_p1 t_f_xss
  if ne run_render_p1_p2 0
    ret fail_msg t_e_xss
  end
  set_p1 t_s_xsvg
  if not read_p1_to_buf
    ret fail_msg t_e_xss
  end
  if not buf_contains t_n_xesc
    ret fail_msg t_e_xss
  end
  if not check_no_xss
    ret fail_msg t_e_xss
  end
  set_p1 t_s_xhtml
  if not read_p1_to_buf
    ret fail_msg t_e_xss
  end
  if not buf_contains t_n_xesc
    ret fail_msg t_e_xss
  end
  if not check_no_xss
    ret fail_msg t_e_xss
  end
  put g_cnt 1 add get g_cnt 1 1
  ret 0
end

fn run_serve_positive to int
  if not http_call_req t_m_get t_p_root false
    ret fail_msg t_e_root
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_root
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_root
  end
  if not buf_contains t_n_svg1
    ret fail_msg t_e_root
  end
  if not buf_contains t_n_pub1
    ret fail_msg t_e_root
  end
  if not check_no_xss
    ret fail_msg t_e_root
  end
  put g_cnt 0 add get g_cnt 0 1

  if not http_call_req t_m_get t_p_hive false
    ret fail_msg t_e_hive
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_hive
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_hive
  end
  if not buf_contains t_n_pub1
    ret fail_msg t_e_hive
  end
  if not buf_contains t_n_pub2
    ret fail_msg t_e_hive
  end
  if not check_no_leaks
    ret fail_msg t_e_priv
  end
  if not check_no_secrets
    ret fail_msg t_e_sleak
  end
  put g_cnt 0 add get g_cnt 0 1
  put g_cnt 1 add get g_cnt 1 2

  if not http_call_req t_m_get t_p_svg false
    ret fail_msg t_e_hsvg
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_hsvg
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_hsvg
  end
  if not buf_contains t_n_ctsvg
    ret fail_msg t_e_hsvg
  end
  if not buf_contains t_n_svg1
    ret fail_msg t_e_hsvg
  end
  if not buf_contains t_n_svg2
    ret fail_msg t_e_hsvg
  end
  if not check_no_xss
    ret fail_msg t_e_hsvg
  end
  put g_cnt 0 add get g_cnt 0 1

  if not http_call_req t_m_get t_p_stat false
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_sok
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_pub1
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_pubcnt
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_filt
    ret fail_msg t_e_hstat
  end
  if not buf_contains t_n_scrub
    ret fail_msg t_e_hstat
  end
  if not check_no_leaks
    ret fail_msg t_e_priv
  end
  if not check_no_secrets
    ret fail_msg t_e_sleak
  end
  put g_cnt 0 add get g_cnt 0 1

  if not http_call_req t_m_get t_p_health false
    ret fail_msg t_e_hlth
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_hlth
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_hlth
  end
  if not check_ok_body
    ret fail_msg t_e_hlth
  end
  put g_cnt 0 add get g_cnt 0 1

  if not http_call_req t_m_head t_p_hive false
    ret fail_msg t_e_head
  end
  if not buf_contains t_n_200
    ret fail_msg t_e_head
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_head
  end
  if not check_head_empty_body
    ret fail_msg t_e_head
  end
  put g_cnt 0 add get g_cnt 0 1
  ret 0
end

fn run_serve_negative to int
  if not http_call_req t_m_get t_p_trav1 false
    ret fail_msg t_e_t1
  end
  if not buf_contains t_n_400
    ret fail_msg t_e_t1
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_t1
  end
  put g_cnt 1 add get g_cnt 1 1

  if not http_call_req t_m_get t_p_trav2 false
    ret fail_msg t_e_t2
  end
  if not buf_contains t_n_400
    ret fail_msg t_e_t2
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_t2
  end
  put g_cnt 1 add get g_cnt 1 1

  if not http_call_req t_m_post t_p_hive true
    ret fail_msg t_e_405
  end
  if not buf_contains t_n_405
    ret fail_msg t_e_405
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_405
  end
  put g_cnt 1 add get g_cnt 1 1

  if not http_call_req t_m_get t_p_404 false
    ret fail_msg t_e_404
  end
  if not buf_contains t_n_404
    ret fail_msg t_e_404
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_404
  end
  put g_cnt 1 add get g_cnt 1 1

  bl = build_oversized_req
  if not http_call_big bl
    ret fail_msg t_e_413
  end
  if not buf_contains t_n_413
    ret fail_msg t_e_413
  end
  if not buf_contains t_n_csp
    ret fail_msg t_e_413
  end
  put g_cnt 1 add get g_cnt 1 1
  ret 0
end

fn run_serve_tests to int
  set_p1 t_s_cat
  set_p2 t_s_log
  ok = write_p1 t_f_cat
  ok = write_p2 t_f_log
  if not start_server
    ret fail_msg t_e_srv
  end
  rc = run_serve_positive
  if ne rc 0
    ret rc
  end
  rc = run_serve_negative
  if ne rc 0
    ret rc
  end
  stop_server
  ret 0
end

fn main to int
  if lt argcnt 4
    x = write 2 t_usage 0 len t_usage
    ret 2
  end
  kb = argread 1 g_bin 0 511
  ks = argread 2 g_samp 0 511
  kw = argread 3 g_work 0 511
  if or le kb 0 or le ks 0 le kw 0
    x = write 2 t_usage 0 len t_usage
    ret 2
  end
  put g_binl 0 ulong kb
  put g_sampl 0 ulong ks
  put g_workl 0 ulong kw
  m = makedir g_work 0 ulong kw 493
  rc = run_render_tests
  if ne rc 0
    ret rc
  end
  rc = run_negative_tsv_tests
  if ne rc 0
    ret rc
  end
  rc = run_serve_tests
  if ne rc 0
    ret rc
  end
  stop_server
  x = write 1 t_pass_pre 0 len t_pass_pre
  dn = u64_to_dec get g_cnt 0
  x = write 1 g_dec 0 dn
  x = write 1 t_pass_mid 0 len t_pass_mid
  dn = u64_to_dec get g_cnt 1
  x = write 1 g_dec 0 dn
  x = write 1 t_nl 0 1
  ret 0
end

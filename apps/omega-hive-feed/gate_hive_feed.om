om2
note Pure seeded-OM-2 Verification Gate for apps/omega-hive-feed/
note Usage: gate_hive_feed <hive_feed_bin> <sample_usage.tsv> <work_dir>

const G_BUF_CAP ulong 262144
const G_IP_LO uint 2130706433

global g_bin uchar 512
global g_binl ulong 1
global g_samp uchar 512
global g_sampl ulong 1
global g_work uchar 512
global g_workl ulong 1

global g_p1 uchar 512
global g_p1l ulong 1
global g_p2 uchar 512
global g_p2l ulong 1
global g_pkt uchar 4096
global g_pktl ulong 1
global g_buf uchar G_BUF_CAP
global g_bufl ulong 1
global g_buf2 uchar G_BUF_CAP
global g_buf2l ulong 1
global g_req uchar 10240
global g_dec uchar 32
global g_wstat uchar 8
global g_srv_pid long 1
global g_port ulong 1
global g_cnt ulong 2

text t_usage "usage: gate_hive_feed <hive_feed_bin> <sample_usage.tsv> <work_dir>\n"
text t_flag_render "--render"
text t_flag_serve "--serve"
text t_pass_pre "HIVE-FEED-GATE PASS tests="
text t_pass_mid " controls="
text t_fail_pre "HIVE-FEED-GATE FAIL: "
text t_nl "\n"

text t_s_out1 "/out1"

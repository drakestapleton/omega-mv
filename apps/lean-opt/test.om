note lean-opt/test.om: Pure seeded OM-2 self-test suite + negative controls for lean-opt.
note Compose after pool.om, lexer.om, and graph.om.

text lt_pass "LEAN-OPT-TEST PASS checks="
text lt_ctrls " controls="
text lt_fail "LEAN-OPT-TEST FAIL step="
text lt_nl "\n"
text lt_base "/tmp/lean-opt-test-"
text lt_d_pi "/PI"
text lt_d_gmv "/GenusMassVolumes"
text lt_d_lat "/Lat"
text lt_d_c1 "/Clump1"
text lt_d_c2 "/Clump2"
text lt_d_culp "/Culp"

text lt_f_pi_def "/PI/Base.lean"
text lt_f_gmv_def "/GenusMassVolumes/Vol.lean"
text lt_f_sh_pos "/PI/FooShadow.lean"
text lt_f_sh_neg "/PI/FooQual.lean"
text lt_f_sh_decl "/PI/FooDecl.lean"
text lt_f_lat_a "/Lat/Def.lean"
text lt_f_lat_b "/Clump1/MainS.lean"
text lt_f_am_pos "/Clump1/AmbigPos.lean"
text lt_f_am_neg "/Clump1/AmbigNeg.lean"
text lt_f_cp_a "/Culp/A.lean"
text lt_f_cp_b "/Culp/B.lean"
text lt_f_cp_c "/Culp/C.lean"
text lt_f_cp_d "/Culp/D.lean"
text lt_f_hot "/Culp/Hot.lean"
text lt_f_cl_a "/Clump2/A.lean"
text lt_f_cl_b "/Clump2/B.lean"
text lt_f_cl_c "/Clump2/C.lean"
text lt_f_cl_d "/Clump2/D.lean"

text lt_c_pi_def "module\nnamespace PI\ndef sigR : Nat := 1\nend PI\n"
text lt_c_gmv_def "module\nnamespace GenusMassVolumes\ndef sigR : Nat := 2\nend GenusMassVolumes\n"
text lt_c_sh_pos "module\nimport PI.Base\nimport GenusMassVolumes.Vol\n-- bundled from PI.Orig\nsection\nopen GenusMassVolumes\nnamespace PI.Foo\ntheorem t1 : Nat := sigR\nend PI.Foo\nend\n"
text lt_c_sh_neg "module\nimport PI.Base\nimport GenusMassVolumes.Vol\nsection\nopen GenusMassVolumes\nnamespace PI.Foo\ntheorem t2 : Nat := GenusMassVolumes.sigR\nend PI.Foo\nend\n"
text lt_c_sh_decl "module\nimport PI.Base\nimport GenusMassVolumes.Vol\nsection\nopen GenusMassVolumes\nnamespace PI.Foo\ndef sigR : Nat := 3\nend PI.Foo\nend\n"
text lt_c_lat_a "module\nnamespace Lat\ndef gS : Nat := 1\nend Lat\n"
text lt_c_lat_b "module\nnamespace Formalism.MainNotions.S\ndef gS : Nat := 2\nend Formalism.MainNotions.S\n"
text lt_c_am_pos "module\nimport Lat.Def\nimport Clump1.MainS\n-- bundled from Clump1.Orig\nsection\nopen Lat Formalism.MainNotions.S\ntheorem a1 : Nat := gS\nend\n"
text lt_c_am_neg "module\nimport Lat.Def\nimport Clump1.MainS\nsection\nopen Lat\ntheorem a2 : Nat := gS\nend\n"
text lt_c_cp_a "module\nnamespace UpperTheory.V.Pr\ninstance IsCD.toIsDomain : Nat := 1\ninstance : CommRing Nat := by sorry\nend UpperTheory.V.Pr\n"
text lt_c_cp_b "module\nimport Culp.A\ndef helperB : Nat := 0\n"
text lt_c_cp_c "module\nimport Culp.B\n-- bundled from Culp.C\nsection\ntheorem useC : Nat := helperB\nend\n"
text lt_c_cp_d "module\nimport Culp.B\nattribute [-instance] UpperTheory.V.Pr.IsCD.toIsDomain in\ntheorem useD : Nat := helperB\n"
text lt_c_hot "module\ntheorem h1 : True := by\n  -- nlinarith\n  /- nested /- nlinarith -/ -/\n  let s := \"nlinarith\"\n  nlinarith\n  nlinarith\n  nlinarith\n"
text lt_c_cl_a "module\nnamespace Clump2\ndef itemA : Nat := 1\nend Clump2\n"
text lt_c_cl_b "module\nnamespace Clump2\ndef itemB : Nat := 2\nend Clump2\n"
text lt_c_cl_c "module\nimport GenusMassVolumes.Vol\nopen GenusMassVolumes\nnamespace PI.Sub\ntheorem itemC : Nat := sigR\nend PI.Sub\n"
text lt_c_cl_d "module\nimport Culp.A\nnamespace Clump2\ndef itemD : Nat := 4\nend Clump2\n"

global g_troot uchar 512
global g_tpath uchar 1024

fn lt_u64_to_troot v ulong pos ulong to ulong
if ge v 10
pos = lt_u64_to_troot div v 10 pos
end
put g_troot pos uchar add 48 rem v 10
ret add pos 1
end

fn lt_init_troot to ulong
p = ulong 0
for i ulong len lt_base bound 512
put g_troot p get lt_base i
p = add p 1
end
pid = ulong getpid
p = lt_u64_to_troot pid p
ret p
end

fn lt_make_path rlen ulong tail view uchar * to ulong
w = ulong 0
for i ulong rlen bound 512
put g_tpath w get g_troot i
w = add w 1
end
for j ulong len tail bound 512
put g_tpath w get tail j
w = add w 1
end
ret w
end

fn lt_mkdir rlen ulong tail view uchar * to void
n = lt_make_path rlen tail
r = makedir g_tpath 0 n 448
end

fn lt_write_file rlen ulong tail view uchar * body view uchar * to bool
n = lt_make_path rlen tail
fd = int fopen g_tpath 0 n 577 420
if lt fd 0
ret false
end
blen = len body
off = ulong 0
while lt off blen bound 65536
k = write fd body off sub blen off
if le k 0
kf = fclose fd
ret false
end
off = add off ulong k
end
kf = fclose fd
ret true
end

fn lt_rm_file rlen ulong tail view uchar * to void
n = lt_make_path rlen tail
r = unlink g_tpath 0 n
end

fn lt_rm_dir rlen ulong tail view uchar * to void
n = lt_make_path rlen tail
r = rmdir g_tpath 0 n
end

fn lt_assert cond bool step ulong is_ctrl bool to void
if is_ctrl
put g_cfg 36 add get g_cfg 36 1
else
put g_cfg 35 add get g_cfg 35 1
end
if not cond
put g_cfg 37 add get g_cfg 37 1
lo_out_view lt_fail
lo_out_u64 step
lo_out_nl
lo_out_flush
end
end

fn lt_match_tail pid ulong tail view uchar * to bool
poff = get g_str_off pid
plen = get g_str_len pid
tlen = sub len tail 1
if ne plen tlen
ret false
end
for i ulong tlen bound 512
if ne get g_str add poff i get tail add i 1
ret false
end
end
ret true
end

fn lt_find_mod tail view uchar * to ulong
note Find module whose path ends with tail (skipping leading '/')
mcnt = get g_cfg 8
for m ulong mcnt bound 9223372036854775807
if lt_match_tail get g_mod_path_id m tail
ret m
end
end
ret 999999999
end

fn lt_scan_one tail view uchar * to void
m = lt_find_mod tail
put g_cfg 32 0
put g_cfg 33 0
put g_cfg 34 0
if lt m get g_cfg 8
lo_scan_module m
end
end

fn lt_setup_tree rlen ulong to bool
r = makedir g_troot 0 rlen 448
if lt r 0
ret false
end
lt_mkdir rlen lt_d_pi
lt_mkdir rlen lt_d_gmv
lt_mkdir rlen lt_d_lat
lt_mkdir rlen lt_d_c1
lt_mkdir rlen lt_d_c2
lt_mkdir rlen lt_d_culp
if not lt_write_file rlen lt_f_pi_def lt_c_pi_def
ret false
end
if not lt_write_file rlen lt_f_gmv_def lt_c_gmv_def
ret false
end
if not lt_write_file rlen lt_f_sh_pos lt_c_sh_pos
ret false
end
if not lt_write_file rlen lt_f_sh_neg lt_c_sh_neg
ret false
end
if not lt_write_file rlen lt_f_sh_decl lt_c_sh_decl
ret false
end
if not lt_write_file rlen lt_f_lat_a lt_c_lat_a
ret false
end
if not lt_write_file rlen lt_f_lat_b lt_c_lat_b
ret false
end
if not lt_write_file rlen lt_f_am_pos lt_c_am_pos
ret false
end
if not lt_write_file rlen lt_f_am_neg lt_c_am_neg
ret false
end
if not lt_write_file rlen lt_f_cp_a lt_c_cp_a
ret false
end
if not lt_write_file rlen lt_f_cp_b lt_c_cp_b
ret false
end
if not lt_write_file rlen lt_f_cp_c lt_c_cp_c
ret false
end
if not lt_write_file rlen lt_f_cp_d lt_c_cp_d
ret false
end
if not lt_write_file rlen lt_f_hot lt_c_hot
ret false
end
if not lt_write_file rlen lt_f_cl_a lt_c_cl_a
ret false
end
if not lt_write_file rlen lt_f_cl_b lt_c_cl_b
ret false
end
if not lt_write_file rlen lt_f_cl_c lt_c_cl_c
ret false
end
ret lt_write_file rlen lt_f_cl_d lt_c_cl_d
end

fn lt_cleanup_tree rlen ulong to void
lt_rm_file rlen lt_f_pi_def
lt_rm_file rlen lt_f_gmv_def
lt_rm_file rlen lt_f_sh_pos
lt_rm_file rlen lt_f_sh_neg
lt_rm_file rlen lt_f_sh_decl
lt_rm_file rlen lt_f_lat_a
lt_rm_file rlen lt_f_lat_b
lt_rm_file rlen lt_f_am_pos
lt_rm_file rlen lt_f_am_neg
lt_rm_file rlen lt_f_cp_a
lt_rm_file rlen lt_f_cp_b
lt_rm_file rlen lt_f_cp_c
lt_rm_file rlen lt_f_cp_d
lt_rm_file rlen lt_f_hot
lt_rm_file rlen lt_f_cl_a
lt_rm_file rlen lt_f_cl_b
lt_rm_file rlen lt_f_cl_c
lt_rm_file rlen lt_f_cl_d
lt_rm_dir rlen lt_d_pi
lt_rm_dir rlen lt_d_gmv
lt_rm_dir rlen lt_d_lat
lt_rm_dir rlen lt_d_c1
lt_rm_dir rlen lt_d_c2
lt_rm_dir rlen lt_d_culp
r = rmdir g_troot 0 rlen
end

fn lt_copy_troot_to_groot rlen ulong to void
for i ulong rlen bound 512
put g_root i get g_troot i
end
end

fn lt_test_clump mcnt ulong to void
put g_cfg 26 250
put g_cfg 27 0
lo_run_plan_clump
lt_assert ge get g_cfg 50 1 50 false
lt_assert ge get g_cfg 52 1 51 false
lt_assert lt get g_cfg 54 mcnt 52 false
ma = lt_find_mod lt_f_cl_a
mb = lt_find_mod lt_f_cl_b
mc = lt_find_mod lt_f_cl_c
md = lt_find_mod lt_f_cl_d
lt_assert eq get g_clump_grp ma get g_clump_grp mb 53 false
lt_assert ne get g_clump_grp ma get g_clump_grp mc 54 true
lt_assert ne get g_clump_grp ma get g_clump_grp md 55 true
end

fn lt_test_pool_growth to void
for i ulong 5000 bound 6000
put g_tmp 0 115
put g_tmp 1 95
put g_tmp 2 uchar add 65 rem i 26
put g_tmp 3 uchar add 65 rem div i 26 26
put g_tmp 4 uchar add 65 rem div i 676 26
put g_tmp 5 uchar add 65 rem div i 17576 26
id = lo_intern_tmp 0 6
lt_assert gt id 0 60 false
end
lt_assert gt get g_cfg 1 5000 61 false
end

fn main to int
rlen = lt_init_troot
if not lt_setup_tree rlen
ret 2
end
lo_reset_pools
put g_cfg 24 1
lt_copy_troot_to_groot rlen
okw = lo_walk_lean_tree rlen
lt_assert okw 1 false
mcnt = get g_cfg 8
lt_assert eq mcnt 18 2 false
for m ulong mcnt bound 9223372036854775807
okl = lo_lex_module m
lt_assert okl 3 false
end
lo_build_graph
lt_assert eq get g_cfg 16 0 4 false

note Test 1: SHADOW positive + 2 negative controls
lt_scan_one lt_f_sh_pos
lt_assert eq get g_cfg 32 1 10 false
lt_scan_one lt_f_sh_neg
lt_assert eq get g_cfg 32 0 11 true
lt_scan_one lt_f_sh_decl
lt_assert eq get g_cfg 32 0 12 true

note Test 2: AMBIG positive + negative control
lt_scan_one lt_f_am_pos
lt_assert eq get g_cfg 33 1 20 false
lt_scan_one lt_f_am_neg
lt_assert eq get g_cfg 33 0 21 true

note Test 3: CULPRIT transitive propagation + suppression negative control
lt_scan_one lt_f_cp_c
lt_assert eq get g_cfg 34 1 30 false
lt_scan_one lt_f_cp_d
lt_assert eq get g_cfg 34 0 31 true

note Test 4: nlinarith comment/string lexer accuracy
mhot = lt_find_mod lt_f_hot
lt_assert eq get g_mod_nlin mhot 3 40 false

note Test 5: Conflict-aware plan-clump
lt_test_clump mcnt

note Test 6: Dynamic pool growth
lt_test_pool_growth

lt_cleanup_tree rlen
lo_out_view lt_pass
lo_out_u64 get g_cfg 35
lo_out_view lt_ctrls
lo_out_u64 get g_cfg 36
lo_out_nl
lo_out_flush
if gt get g_cfg 37 0
ret 1
end
ret 0
end

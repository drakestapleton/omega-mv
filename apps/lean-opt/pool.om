fn lo_fail_oom to void
k = write 2 lo_err_oom 0 len lo_err_oom
exit 1
end

fn lo_need_str need ulong to void
cur = len g_str
if le need cur
ret
end
nxt = add mul cur 2 4096
if gt need nxt
nxt = add need 4096
end
r = enlarge g_str nxt
if lt r 0
lo_fail_oom
end
end

fn lo_need_strs need ulong to void
cur = len g_str_off
if le need cur
ret
end
nxt = add mul cur 2 1024
if gt need nxt
nxt = add need 1024
end
r = enlarge g_str_off nxt
if lt r 0
lo_fail_oom
end
r = enlarge g_str_len nxt
if lt r 0
lo_fail_oom
end
r = enlarge g_str_hash nxt
if lt r 0
lo_fail_oom
end
end


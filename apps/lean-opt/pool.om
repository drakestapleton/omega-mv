note lean-opt/pool.om: Dynamic zero-hard-cap pools, string interning, buffered I/O, and directory walker.
note Compose with si/directives/om2.om first.
note All global arrays live here so lexer.om, graph.om, main.om, and test.om share them.

text lo_err_oom "lean-opt: pool enlarge failed\n"
text lo_slash "/"
text lo_dot "."
text lo_dotdot ".."
text lo_ext_lean ".lean"
text lo_dir_git ".git"
text lo_dir_lake ".lake"
text lo_dir_build "build"
text lo_lib_main "Main"
text lo_lib_stmts "Statements"
text lo_lib_chal "Challenge"
text lo_lib_gt "GroundTheory"
text lo_lib_lf "LocalFields"
text lo_lib_gf "GlobalFields"
text lo_lib_gtf "GroundTheoryFields"
text lo_tab "\t"
text lo_nl "\n"

note Global dynamic byte/string pools
global g_str uchar *
global g_str_off ulong *
global g_str_len ulong *
global g_str_hash ulong *
global g_ht_slot ulong *

note File read buffer and directory walk queue
global g_fbuf uchar *
global g_dirq uchar *
global g_dirq_off ulong *
global g_dirq_len ulong *

note Fixed OS syscall scratch buffers (4096 = Linux PATH_MAX, 65536 = getdents64 chunk, 128 = stat)
global g_out uchar 65536
global g_dent uchar 65536
global g_root uchar 4096
global g_path uchar 4096
global g_tmp uchar 4096
global g_tmp2 uchar 4096
global g_stat uchar 128
global g_cfg ulong 64

note g_cfg slots:
note  0: str_bytes_used   1: str_count        2: ht_cap (pow2)    3: out_used
note  4: dirq_bytes       5: dirq_count       6: dirq_head        7: root_len
note  8: mod_count        9: imp_count       10: decl_count      11: sec_count
note 12: ns_used         13: open_used       14: ref_used        15: topo_count
note 16: cycles          17: max_depth       18: total_lines     19: total_nlin
note 20: total_hb        21: total_bundles   22: opt_only_bun    23: opt_culp_only
note 24: opt_sum_only    25: opt_top_n       26: opt_max_lines   27: opt_mode (0=antichain,1=tree)
note 28: stamp_cur       29: didx_cap        30: csr_edge_cnt    31: rcsr_edge_cnt
note 32: sh_cnt          33: am_cnt          34: cu_cnt          35: test_checks
note 36: test_ctrls      37: test_fails      38: lib_main_id     39: lib_chal_id
note 40: lib_gtf_id      41: t_start_ns      42: cur_line        43: cur_mod
note 44: cur_sec         45: cur_ns_id       46: sec_ref_start   47: sec_ns_start
note 48: sec_open_start  49: flen            50: sh_avoid        51: am_avoid
note 52: cu_avoid        53: clump_bundles   54: clump_after     55: local_cnt


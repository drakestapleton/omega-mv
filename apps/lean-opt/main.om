note lean-opt/main.om: CLI entrypoint for pure seeded OM-2 Lean 4.36 static analyzer & conflict-aware bundler.
note Compose after pool.om, lexer.om, and graph.om.

text lo_cmd_stats "stats"
text lo_cmd_scan "scan"
text lo_cmd_hotspots "hotspots"
text lo_cmd_plan "plan-clump"
text lo_fl_only_bun "--only-bundles"
text lo_fl_culp "--culprits-only"
text lo_fl_sum "--summary-only"
text lo_fl_top "--top"
text lo_fl_maxl "--max-lines"
text lo_fl_mode "--mode"
text lo_md_anti "antichain"
text lo_md_tree "tree"
text lo_usage "usage: lean-opt <stats|scan|hotspots|plan-clump> <src_dir> [options]\n  scan:       [--only-bundles] [--culprits-only] [--summary-only]\n  hotspots:   [--top N]\n  plan-clump: [--max-lines N] [--mode antichain|tree] [--summary-only]\n"
text lo_err_walk "lean-opt: failed to walk directory\n"

global g_arg0 uchar 4096
global g_arg2 uchar 4096

fn lo_arg0_eq n ulong s view uchar * to bool
if ne n len s
ret false
end
for i ulong n bound 4096
if ne get g_arg0 i get s i
ret false
end
end
ret true
end

fn lo_arg2_eq n ulong s view uchar * to bool
if ne n len s
ret false
end
for i ulong n bound 4096
if ne get g_arg2 i get s i
ret false
end
end
ret true
end

fn lo_parse_u64_arg2 n ulong to ulong
if eq n 0
ret 0
end
v = ulong 0
for i ulong n bound 64
c = get g_arg2 i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn lo_usage_exit to int
k = write 2 lo_usage 0 len lo_usage
ret 2
end

fn lo_load_and_build dir_n ulong to bool
t0 = monons
put g_cfg 41 ulong t0
lo_init_pools
if not lo_walk_lean_tree dir_n
ret false
end
mcnt = get g_cfg 8
for m ulong mcnt bound 9223372036854775807
ok = lo_lex_module m
end
lo_build_graph
ret true
end

fn lo_parse_flags argc ulong to bool
i = ulong 3
while lt i argc bound 64
n = argread i g_arg2 0 4095
if lt n 0
ret false
end
un = ulong n
if lo_arg2_eq un lo_fl_only_bun
put g_cfg 22 1
i = add i 1
continue
end
if lo_arg2_eq un lo_fl_culp
put g_cfg 23 1
i = add i 1
continue
end
if lo_arg2_eq un lo_fl_sum
put g_cfg 24 1
i = add i 1
continue
end
if lo_arg2_eq un lo_fl_top
i = add i 1
if ge i argc
ret false
end
n2 = argread i g_arg2 0 4095
if lt n2 1
ret false
end
put g_cfg 25 lo_parse_u64_arg2 ulong n2
i = add i 1
continue
end
if lo_arg2_eq un lo_fl_maxl
i = add i 1
if ge i argc
ret false
end
n2 = argread i g_arg2 0 4095
if lt n2 1
ret false
end
put g_cfg 26 lo_parse_u64_arg2 ulong n2
i = add i 1
continue
end
if lo_arg2_eq un lo_fl_mode
i = add i 1
if ge i argc
ret false
end
n2 = argread i g_arg2 0 4095
if lt n2 1
ret false
end
if lo_arg2_eq ulong n2 lo_md_anti
put g_cfg 27 0
else
if lo_arg2_eq ulong n2 lo_md_tree
put g_cfg 27 1
else
ret false
end
end
i = add i 1
continue
end
ret false
end
ret true
end

fn main to int
argc = argcnt
if lt argc 3
ret lo_usage_exit
end
n0 = argread 1 g_arg0 0 4095
n1 = argread 2 g_root 0 4000
if or lt n0 1 lt n1 1
ret lo_usage_exit
end
mode = ulong 0
if lo_arg0_eq ulong n0 lo_cmd_stats
mode = 1
end
if lo_arg0_eq ulong n0 lo_cmd_scan
mode = 2
end
if lo_arg0_eq ulong n0 lo_cmd_hotspots
mode = 3
end
if lo_arg0_eq ulong n0 lo_cmd_plan
mode = 4
end
if eq mode 0
ret lo_usage_exit
end
if not lo_parse_flags ulong argc
ret lo_usage_exit
end
if not lo_load_and_build ulong n1
k = write 2 lo_err_walk 0 len lo_err_walk
ret 1
end
if eq mode 1
lo_run_stats long get g_cfg 41
ret 0
end
if eq mode 2
lo_run_scan
ret 0
end
if eq mode 3
lo_run_hotspots
ret 0
end
lo_run_plan_clump
ret 0
end

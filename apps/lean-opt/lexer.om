note Parser state in g_lx ulong 32:
note  0: pos         1: stk_top     2: open_top    3: prev_was_dot
note  4: line_start  5: skip_next   6: in_decl_hdr 7: local_cnt
note  8: temp_open_c 9: tok_s      10: tok_e      11: is_line_head
note 12: line_has_open 13: line_is_attr_neg 14: line_is_imp 15: line_is_ns
note 16: line_is_sec 17: line_is_end 18: line_is_decl 19: decl_seen_name
note 20: decl_is_inst 21: binder_mode 22: tmp_open_used
global g_lx ulong 32

fn lo_is_ws c uchar to bool
if or eq c 32 eq c 9
ret true
end
ret eq c 13
end

fn lo_is_id_start c uchar to bool
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
if eq c 95
ret true
end
if ge c 128
ret true
end
ret false
end

fn lo_is_id_char c uchar to bool
if lo_is_id_start c
ret true
end
if and ge c 48 le c 57
ret true
end
if or eq c 39 eq c 33
ret true
end
if eq c 63
ret true
end
ret eq c 46
end

fn lo_fbuf_eq off ulong n ulong s view uchar * to bool
if ne n len s
ret false
end
for i ulong n bound 4096
if ne get g_fbuf add off i get s i
ret false
end
end
ret true
end

fn lo_fbuf_starts off ulong endp ulong s view uchar * to bool
sn = len s
if lt sub endp off sn
ret false
end
for i ulong sn bound 4096
if ne get g_fbuf add off i get s i
ret false
end
end
ret true
end

fn lo_fbuf_contains off ulong n ulong s view uchar * to bool
sn = len s
if lt n sn
ret false
end
lim = add sub n sn 1
endp = add off n
for i ulong lim bound 4096
pos = add off i
if lo_fbuf_starts pos endp s
ret true
end
end
ret false
end

fn lo_culprit_bit off ulong n ulong to ulong
if lo_fbuf_contains off n lo_cp0
ret 1
end
if lo_fbuf_contains off n lo_cp1
ret 2
end
if lo_fbuf_contains off n lo_cp2
ret 4
end
if lo_fbuf_contains off n lo_cp3
ret 8
end
if lo_fbuf_contains off n lo_cp4
ret 16
end
if lo_fbuf_contains off n lo_cp5
ret 32
end
if lo_fbuf_contains off n lo_cp6
ret 64
end
if lo_fbuf_contains off n lo_cp7
ret 128
end
ret 0
end

fn lo_is_ext_root off ulong n ulong to bool
root_n = n
for i ulong n bound 4096
if eq get g_fbuf add off i 46
root_n = i
break
end
end
if lo_fbuf_eq off root_n lo_ext_mathlib
ret true
end
if lo_fbuf_eq off root_n lo_ext_init
ret true
end
if lo_fbuf_eq off root_n lo_ext_leanpkg
ret true
end
if lo_fbuf_eq off root_n lo_ext_std
ret true
end
if lo_fbuf_eq off root_n lo_ext_batt
ret true
end
if lo_fbuf_eq off root_n lo_ext_aesop
ret true
end
if lo_fbuf_eq off root_n lo_ext_qq
ret true
end
if lo_fbuf_eq off root_n lo_ext_lake
ret true
end
if lo_fbuf_eq off root_n lo_ext_impgraph
ret true
end
if lo_fbuf_eq off root_n lo_ext_pw
ret true
end
if lo_fbuf_eq off root_n lo_ext_plaus
ret true
end
ret lo_fbuf_eq off root_n lo_ext_cli
end


fn lo_is_lean_skip off ulong n ulong to bool
if le n 1
ret true
end
if lo_is_lean_skip_a off n
ret true
end
if lo_is_lean_skip_b off n
ret true
end
if lo_is_lean_skip_c off n
ret true
end
ret lo_is_lean_skip_d off n
end

fn lo_rebuild_cur_ns to void
top = get g_lx 1
ns = ulong 0
for i ulong top bound 256
if eq get g_stk_kind i 1
seg = get g_stk_ns i
if gt seg 0
ns = lo_intern_join_dot ns seg
end
end
end
put g_cfg 45 ns
end

fn lo_record_ns ns_id ulong to void
if eq ns_id 0
ret
end
base = get g_cfg 47
cur = get g_cfg 12
for i ulong sub cur base bound 9223372036854775807
if eq get g_ns_ids add base i ns_id
ret
end
end
lo_need_ns add cur 1
put g_ns_ids cur ns_id
put g_cfg 12 add cur 1
end

fn lo_record_ns_chain ns_id ulong to void
cur = ns_id
while gt cur 0 bound 64
lo_record_ns cur
cur = lo_str_parent_ns cur
end
end

fn lo_begin_section orig_id ulong line_no ulong to void
sec = get g_cfg 11
lo_need_secs add sec 1
put g_sec_mod sec get g_cfg 43
put g_sec_orig sec orig_id
put g_sec_line sec line_no
put g_sec_ns_h sec get g_cfg 12
put g_sec_ns_c sec 0
put g_sec_op_h sec get g_cfg 13
put g_sec_op_c sec 0
put g_sec_rf_h sec get g_cfg 14
put g_sec_rf_c sec 0
put g_sec_sup sec 0
put g_cfg 44 sec
put g_cfg 11 add sec 1
put g_cfg 47 get g_cfg 12
put g_cfg 48 get g_cfg 13
put g_cfg 46 get g_cfg 14
put g_lx 1 0
put g_lx 2 0
put g_lx 7 0
put g_lx 8 0
put g_cfg 45 0
end

fn lo_flush_sec_opens to void
base = get g_cfg 48
cnt = get g_lx 2
for i ulong cnt bound 1024
oid = get g_op_stk i
dup = false
cur = get g_cfg 13
for j ulong sub cur base bound 9223372036854775807
if eq get g_open_ids add base j oid
dup = true
break
end
end
if not dup
lo_need_opens add cur 1
put g_open_ids cur oid
put g_cfg 13 add cur 1
end
end
tcnt = get g_lx 8
for i ulong tcnt bound 1024
oid = get g_op_tmp i
dup = false
cur = get g_cfg 13
for j ulong sub cur base bound 9223372036854775807
if eq get g_open_ids add base j oid
dup = true
break
end
end
if not dup
lo_need_opens add cur 1
put g_open_ids cur oid
put g_cfg 13 add cur 1
end
end
put g_lx 8 0
end

fn lo_finish_section to void
lo_flush_sec_opens
sec = get g_cfg 44
put g_sec_ns_c sec sub get g_cfg 12 get g_cfg 47
put g_sec_op_c sec sub get g_cfg 13 get g_cfg 48
put g_sec_rf_c sec sub get g_cfg 14 get g_cfg 46
end

fn lo_push_scope kind ulong ns_seg ulong to void
top = get g_lx 1
if ge top 255
ret
end
put g_stk_kind top kind
put g_stk_ns top ns_seg
put g_stk_op top get g_lx 2
put g_lx 1 add top 1
if eq kind 1
lo_rebuild_cur_ns
lo_record_ns_chain get g_cfg 45
end
end

fn lo_pop_scope end_seg ulong to void
top = get g_lx 1
if eq top 0
ret
end
new_top = sub top 1
put g_lx 1 new_top
saved_op = get g_stk_op new_top
lo_flush_sec_opens
if lt saved_op get g_lx 2
put g_lx 2 saved_op
end
lo_rebuild_cur_ns
end

fn lo_add_open_tok oid ulong is_temp bool to void
if eq oid 0
ret
end
if is_temp
tc = get g_lx 8
if lt tc 1024
put g_op_tmp tc oid
put g_lx 8 add tc 1
end
ret
end
oc = get g_lx 2
if lt oc 1024
put g_op_stk oc oid
put g_lx 2 add oc 1
end
end

fn lo_add_local sym_id ulong to void
cnt = get g_lx 7
for i ulong cnt bound 256
if eq get g_loc_sym i sym_id
ret
end
end
if lt cnt 255
put g_loc_sym cnt sym_id
put g_lx 7 add cnt 1
end
end

fn lo_is_local sym_id ulong to bool
cnt = get g_lx 7
for i ulong cnt bound 256
if eq get g_loc_sym i sym_id
ret true
end
end
ret false
end

fn lo_add_ref sym_id ulong line_no ulong to void
if eq sym_id 0
ret
end
if lo_is_local sym_id
ret
end
base = get g_cfg 46
cur = get g_cfg 14
for i ulong sub cur base bound 9223372036854775807
if eq get g_ref_sym add base i sym_id
ret
end
end
lo_need_refs add cur 1
put g_ref_sym cur sym_id
put g_ref_line cur line_no
put g_ref_ns cur get g_cfg 45
put g_cfg 14 add cur 1
end

fn lo_push_decl_rec short_id ulong decl_ns ulong full_id ulong kind ulong to void
idx = get g_cfg 10
lo_need_decls add idx 1
put g_decl_short idx short_id
put g_decl_ns idx decl_ns
put g_decl_full idx full_id
put g_decl_mod idx get g_cfg 43
put g_decl_sec idx get g_cfg 44
put g_decl_kind idx kind
put g_cfg 10 add idx 1
end

fn lo_add_decl off ulong n ulong kind ulong to void
has_root = false
if gt n 7
if lo_fbuf_starts off add off n lo_kw_root_dot
off = add off 7
n = sub n 7
has_root = true
end
end
if eq n 0
ret
end
raw_id = lo_intern_fbuf off n
short_id = lo_str_last_seg raw_id
decl_ns = lo_str_parent_ns raw_id
if not has_root
cur_ns = get g_cfg 45
if gt cur_ns 0
decl_ns = lo_intern_join_dot cur_ns decl_ns
end
end
full_id = lo_intern_join_dot decl_ns short_id
lo_push_decl_rec short_id decl_ns full_id kind
end

fn lo_add_import_tok off ulong n ulong to void
if eq n 0
ret
end
if lo_is_ext_root off n
ret
end
dst_id = lo_intern_fbuf off n
if eq dst_id 0
ret
end
idx = get g_cfg 9
lo_need_imps add idx 1
put g_imp_src idx get g_cfg 43
put g_imp_dst idx dst_id
put g_cfg 9 add idx 1
end

fn lo_handle_comment_marker lstart ulong lend ulong line_no ulong to void
if lo_fbuf_starts lstart lend lo_kw_bundled
ms = add lstart 16
while and lt ms lend lo_is_ws get g_fbuf ms bound 4096
ms = add ms 1
end
me = lend
while and gt me ms lo_is_ws get g_fbuf sub me 1 bound 4096
me = sub me 1
end
if gt me ms
orig = lo_intern_fbuf ms sub me ms
lo_finish_section
lo_begin_section orig line_no
put g_mod_is_bun get g_cfg 43 1
end
ret
end
if lo_fbuf_starts lstart lend lo_kw_clump
ms = add lstart 22
me = lend
if gt me ms
if ge sub me ms 6
if lo_fbuf_eq sub me 6 6 lo_kw_clump_end
me = sub me 6
end
end
while and gt me ms lo_is_ws get g_fbuf sub me 1 bound 4096
me = sub me 1
end
if gt me ms
orig = lo_intern_fbuf ms sub me ms
lo_finish_section
lo_begin_section orig line_no
put g_mod_is_bun get g_cfg 43 1
end
end
end
end

fn lo_skip_ws_line pos ulong lend ulong to ulong
p = pos
while and lt p lend lo_is_ws get g_fbuf p bound 9223372036854775807
p = add p 1
end
ret p
end

fn lo_scan_line_comment pos ulong flen ulong to ulong
p = pos
while and lt p flen ne get g_fbuf p 10 bound 9223372036854775807
p = add p 1
end
ret p
end

fn lo_scan_block_comment pos ulong flen ulong line_ptr ulong to ulong
p = add pos 2
depth = ulong 1
ln = line_ptr
while and lt p flen gt depth 0 bound 9223372036854775807
c = get g_fbuf p
if eq c 10
ln = add ln 1
p = add p 1
continue
end
if eq c 47
if lt add p 1 flen
if eq get g_fbuf add p 1 45
depth = add depth 1
p = add p 2
continue
end
end
end
if eq c 45
if lt add p 1 flen
if eq get g_fbuf add p 1 47
depth = sub depth 1
p = add p 2
continue
end
end
end
p = add p 1
end
put g_cfg 42 ln
ret p
end

fn lo_scan_string pos ulong flen ulong to ulong
p = add pos 1
ln = get g_cfg 42
while lt p flen bound 9223372036854775807
c = get g_fbuf p
if eq c 10
ln = add ln 1
end
if eq c 92
p = add p 2
continue
end
if eq c 34
put g_cfg 42 ln
ret add p 1
end
p = add p 1
end
put g_cfg 42 ln
ret p
end

fn lo_parse_import_line ls ulong lend ulong to void
p = lo_skip_ws_line ls lend
while lt p lend bound 4096
c = get g_fbuf p
if not lo_is_id_char c
p = lo_skip_ws_line add p 1 lend
continue
end
s = p
while and lt p lend lo_is_id_char get g_fbuf p bound 4096
p = add p 1
end
n = sub p s
if or lo_fbuf_eq s n lo_kw_public or lo_fbuf_eq s n lo_kw_private or lo_fbuf_eq s n lo_kw_meta or lo_fbuf_eq s n lo_kw_import lo_fbuf_eq s n lo_kw_all
p = lo_skip_ws_line p lend
continue
end
lo_add_import_tok s n
ret
end
end

fn lo_line_ends_in p ulong lend ulong to bool
if lt sub lend p 3
ret false
end
t = lend
while and gt t p lo_is_ws get g_fbuf sub t 1 bound 4096
t = sub t 1
end
if lt sub t p 2
ret false
end
if or ne get g_fbuf sub t 2 105 ne get g_fbuf sub t 1 110
ret false
end
if eq t add p 2
ret true
end
ret lo_is_ws get g_fbuf sub t 3
end

fn lo_record_open_tok s ulong n ulong is_temp bool to void
has_root = false
if gt n 7
if lo_fbuf_starts s add s n lo_kw_root_dot
s = add s 7
n = sub n 7
has_root = true
end
end
oid = lo_intern_fbuf s n
lo_add_open_tok oid is_temp
if and not has_root gt get g_cfg 45 0
rel_id = lo_intern_join_dot get g_cfg 45 oid
lo_add_open_tok rel_id is_temp
end
end

fn lo_parse_open_line ls ulong lend ulong to void
p = lo_skip_ws_line ls lend
seen_open = false
is_temp = lo_line_ends_in p lend
while lt p lend bound 4096
c = get g_fbuf p
if eq c 45
if lt add p 1 lend
if eq get g_fbuf add p 1 45
break
end
end
end
if eq c 40
break
end
if not lo_is_id_char c
p = add p 1
continue
end
s = p
while and lt p lend lo_is_id_char get g_fbuf p bound 4096
p = add p 1
end
n = sub p s
if not seen_open
if lo_fbuf_eq s n lo_kw_open
seen_open = true
end
continue
end
if lo_fbuf_eq s n lo_kw_scoped
continue
end
if or lo_fbuf_eq s n lo_kw_hiding or lo_fbuf_eq s n lo_kw_renaming lo_fbuf_eq s n lo_kw_in
break
end
lo_record_open_tok s n is_temp
end
end

fn lo_check_decl_kw off ulong n ulong to ulong
if or lo_fbuf_eq off n lo_kw_thm or lo_fbuf_eq off n lo_kw_lem or lo_fbuf_eq off n lo_kw_def lo_fbuf_eq off n lo_kw_abbrev
ret 1
end
if or lo_fbuf_eq off n lo_kw_struct or lo_fbuf_eq off n lo_kw_class or lo_fbuf_eq off n lo_kw_ind or lo_fbuf_eq off n lo_kw_opaque lo_fbuf_eq off n lo_kw_axiom
ret 1
end
if lo_fbuf_eq off n lo_kw_inst
ret 2
end
ret 0
end

fn lo_is_binder_kw s ulong n ulong to bool
if or lo_fbuf_eq s n lo_kw_open_in_let lo_fbuf_eq s n lo_kw_have
ret true
end
if or lo_fbuf_eq s n lo_kw_intro lo_fbuf_eq s n lo_kw_intros
ret true
end
if or lo_fbuf_eq s n lo_kw_obtain lo_fbuf_eq s n lo_kw_rintro
ret true
end
ret lo_fbuf_eq s n lo_kw_fun
end

fn lo_process_token s ulong n ulong line_no ulong to void
if eq n 0
ret
end
if ne get g_lx 3 0
put g_lx 3 0
ret
end
if lo_fbuf_eq s n lo_kw_nlin
mid = get g_cfg 43
put g_mod_nlin mid add get g_mod_nlin mid 1
put g_cfg 19 add get g_cfg 19 1
ret
end
if lo_fbuf_eq s n lo_kw_maxhb
mid = get g_cfg 43
put g_mod_hb mid add get g_mod_hb mid 1
put g_cfg 20 add get g_cfg 20 1
ret
end
if eq get g_lx 19 1
put g_lx 19 0
dk = ulong 0
if eq get g_lx 20 1
dk = 1
cbit = lo_culprit_bit s n
if gt cbit 0
dk = 2
mid = get g_cfg 43
put g_mod_culp mid or get g_mod_culp mid cbit
end
end
lo_add_decl s n dk
ret
end
dty = lo_check_decl_kw s n
if gt dty 0
put g_lx 19 1
if eq dty 2
put g_lx 20 1
else
put g_lx 20 0
end
put g_lx 7 0
ret
end
if lo_is_binder_kw s n
put g_lx 21 1
ret
end
if eq get g_lx 21 1
if not lo_is_lean_skip s n
sid = lo_intern_fbuf s n
lo_add_local sid
end
ret
end
if lo_is_lean_skip s n
ret
end
note Ignore qualified names (contain '.' or start with _root_.) for bare ref checks
has_dot = false
for i ulong n bound 4096
if eq get g_fbuf add s i 46
has_dot = true
break
end
end
if has_dot
ret
end
sym_id = lo_intern_fbuf s n
lo_add_ref sym_id line_no
end

fn lo_scan_header_line ls ulong lend ulong line_no ulong to bool
p = lo_skip_ws_line ls lend
if ge p lend
ret true
end
if lo_fbuf_starts p lend lo_kw_module
ret true
end
if lo_fbuf_starts p lend lo_kw_expose
ret true
end
if lo_fbuf_starts p lend lo_kw_import
lo_parse_import_line p lend
ret true
end
if or lo_fbuf_starts p lend lo_kw_public lo_fbuf_starts p lend lo_kw_private
if lo_fbuf_contains p sub lend p lo_kw_import
lo_parse_import_line p lend
ret true
end
end
if lo_fbuf_starts p lend lo_kw_meta
if lo_fbuf_contains p sub lend p lo_kw_import
lo_parse_import_line p lend
ret true
end
end
if lo_fbuf_starts p lend lo_kw_ns
q = lo_skip_ws_line add p 9 lend
s = q
while and lt q lend lo_is_id_char get g_fbuf q bound 4096
q = add q 1
end
seg = lo_intern_fbuf s sub q s
lo_push_scope 1 seg
ret true
end
if lo_fbuf_starts p lend lo_kw_sec
lo_push_scope 0 0
ret true
end
if lo_fbuf_starts p lend lo_kw_noncomp
q = lo_skip_ws_line add p 13 lend
if lo_fbuf_starts q lend lo_kw_sec
lo_push_scope 0 0
ret true
end
end
if lo_fbuf_starts p lend lo_kw_end
lo_pop_scope 0
ret true
end
if lo_fbuf_starts p lend lo_kw_open
lo_parse_open_line p lend
ret true
end
if lo_fbuf_starts p lend lo_kw_attr
if lo_fbuf_contains p sub lend p lo_kw_inst_neg
cbit = lo_culprit_bit p sub lend p
if gt cbit 0
sec = get g_cfg 44
put g_sec_sup sec or get g_sec_sup sec cbit
end
end
ret true
end
if or lo_fbuf_starts p lend lo_kw_set_opt or lo_fbuf_starts p lend lo_kw_variable lo_fbuf_starts p lend lo_kw_universe
ret true
end
ret false
end

fn lo_scan_line_body ls ulong lend ulong line_no ulong to void
p = ls
put g_lx 3 0
put g_lx 21 0
while lt p lend bound 9223372036854775807
c = get g_fbuf p
if eq c 34
p = lo_scan_string p lend
continue
end
if eq c 45
if lt add p 1 lend
if eq get g_fbuf add p 1 45
break
end
end
end
if eq c 47
if lt add p 1 lend
if eq get g_fbuf add p 1 45
p = lo_scan_block_comment p lend get g_cfg 42
continue
end
end
end
if eq c 46
put g_lx 3 1
p = add p 1
continue
end
if or eq c 58 eq c 61
put g_lx 21 0
put g_lx 19 0
p = add p 1
continue
end
if or eq c 40 or eq c 91 eq c 123
put g_lx 19 0
p = add p 1
continue
end
if lo_is_id_start c
s = p
while and lt p lend lo_is_id_char get g_fbuf p bound 4096
p = add p 1
end
lo_process_token s sub p s line_no
continue
end
put g_lx 3 0
p = add p 1
end
end

fn lo_find_eol pos ulong flen ulong to ulong
p = pos
while lt p flen bound 9223372036854775807
if eq get g_fbuf p 10
break
end
p = add p 1
end
ret p
end

fn lo_lex_line ls ulong lend ulong flen ulong to ulong
lines = get g_cfg 42
p = lo_skip_ws_line ls lend
if lo_fbuf_starts p lend lo_kw_bundled
lo_handle_comment_marker p lend lines
else
if lo_fbuf_starts p lend lo_kw_clump
lo_handle_comment_marker p lend lines
else
if lt add p 1 lend
if and eq get g_fbuf p 47 eq get g_fbuf add p 1 45
np = lo_scan_block_comment p flen lines
if gt get g_cfg 42 lines
ret np
end
end
end
if not lo_scan_header_line ls lend lines
lo_scan_line_body ls lend lines
end
end
end
if lt lend flen
ret add lend 1
end
ret lend
end

fn lo_lex_module mid ulong to bool
if not lo_read_path lo_build_mod_full_path mid
ret false
end
put g_cfg 43 mid
put g_cfg 42 0
put g_lx 19 0
put g_lx 20 0
put g_lx 22 0
sec_start = get g_cfg 11
put g_mod_sec_h mid sec_start
lo_begin_section get g_mod_name_id mid 1
pos = ulong 0
flen = get g_cfg 49
while lt pos flen bound 9223372036854775807
lend = lo_find_eol pos flen
put g_cfg 42 add get g_cfg 42 1
pos = lo_lex_line pos lend flen
end
lo_finish_section
put g_mod_sec_c mid sub get g_cfg 11 sec_start
lines = get g_cfg 42
put g_mod_lines mid lines
put g_cfg 18 add get g_cfg 18 lines
if gt get g_mod_is_bun mid 0
put g_cfg 21 add get g_cfg 21 1
end
ret true
end

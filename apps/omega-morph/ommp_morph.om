note ---- Output & Formatting Helpers ----

fn om_wrt fd int s view uchar * to void
  p = ulong 0
  n = len s
  while lt p n bound 65536
    k = write fd s p sub n p
    if le k 0
      ret
    end
    p = add p ulong k
  end
end

fn om_wrt_u64 fd int v ulong to void
  ctWriteU64 fd v
end

fn om_wrt_hex fd int src ulong n ulong to void
  for i ulong n bound 64
    b = ulong 0
    if eq src 0
      b = ulong get om_sem i
    else
      b = ulong get om_csha i
    end
    put om_hex mul i 2 sh_hexd uint shr b 4
    put om_hex add mul i 2 1 sh_hexd uint and b 15
  end
  k = write fd om_hex 0 mul n 2
end

fn om_wrt_opname fd int op ulong to void
  if eq op OIR_ADD
    om_wrt fd om_t_add
    ret
  end
  if eq op OIR_SUB
    om_wrt fd om_t_sub
    ret
  end
  om_wrt fd om_t_mul
end

fn om_fail code int to void
  om_wrt 2 om_m_fail
  om_wrt_u64 2 ulong code
  om_wrt 2 om_m_reason
  if eq code OM_ERR_FORMAT
    om_wrt 2 om_m_r_fmt
    exit code
  end
  if eq code OM_ERR_ED25519
    om_wrt 2 om_m_r_ed
    exit code
  end
  if eq code OM_ERR_SHA256
    om_wrt 2 om_m_r_sha
    exit code
  end
  if eq code OM_ERR_SEM_ID
    om_wrt 2 om_m_r_sem
    exit code
  end
  if eq code OM_ERR_EGP3
    om_wrt 2 om_m_r_egp
    exit code
  end
  if eq code OM_ERR_OM3
    om_wrt 2 om_m_r_om3
    exit code
  end
  if eq code OM_ERR_WATTCBF
    om_wrt 2 om_m_r_watt
    exit code
  end
  if eq code OM_ERR_TARGET
    om_wrt 2 om_m_r_tgt
    exit code
  end
  if eq code OM_ERR_CONTRACT
    om_wrt 2 om_m_r_con
    exit code
  end
  if eq code OM_ERR_IO
    om_wrt 2 om_m_r_io
    exit code
  end
  om_wrt 2 om_m_use
  exit code
end

note ---- Byte Buffer Read/Write Helpers ----

fn om_pkg_u16 o ulong to ulong
  b0 = ulong get om_pkg o
  b1 = shl ulong get om_pkg add o 1 8
  ret or b0 b1
end

fn om_pkg_u32 o ulong to ulong
  b0 = ulong get om_pkg o
  b1 = shl ulong get om_pkg add o 1 8
  b2 = shl ulong get om_pkg add o 2 16
  b3 = shl ulong get om_pkg add o 3 24
  ret or or b0 b1 or b2 b3
end

fn om_pkg_u64 o ulong to ulong
  lo = om_pkg_u32 o
  hi = om_pkg_u32 add o 4
  ret or lo shl hi 32
end

fn om_pkg_put_u8 o ulong v ulong to void
  put om_pkg o uchar and v 255
end

fn om_pkg_put_u16 o ulong v ulong to void
  om_pkg_put_u8 o v
  om_pkg_put_u8 add o 1 shr v 8
end

fn om_pkg_put_u32 o ulong v ulong to void
  om_pkg_put_u16 o v
  om_pkg_put_u16 add o 2 shr v 16
end

fn om_pkg_put_u64 o ulong v ulong to void
  om_pkg_put_u32 o and v 4294967295
  om_pkg_put_u32 add o 4 shr v 32
end

fn om_out_reset to void
  put om_out_len 0 0
end

fn om_out_u8 b ulong to void
  p = get om_out_len 0
  if lt p 65536
    put om_out p uchar and b 255
    put om_out_len 0 add p 1
  end
end

fn om_out_u16 v ulong to void
  om_out_u8 v
  om_out_u8 shr v 8
end

fn om_out_u32 v ulong to void
  om_out_u16 v
  om_out_u16 shr v 16
end

fn om_out_u64 v ulong to void
  om_out_u32 v
  om_out_u32 shr v 32
end

fn om_out_at off ulong v ulong sz ulong to void
  for k ulong sz bound 8
    put om_out add off k uchar and shr v mul k 8 255
  end
end

note ---- RFC 8032 Ed25519 Signing (reusing sha512.om + ed25519.om, zero name collisions) ----

fn om_ed_red x64 view uchar 64 dst edit uchar 32 to void
  x = new long 64 0
  for i ulong 64
    put x i long get x64 i
  end
  edmodl x
  for i ulong 32
    put dst i uchar get x i
  end
end

fn om_ed_expand sd view uchar 32 ar edit uchar 32 pfx edit uchar 64 to void
  m = new uchar 65536 0
  hd = new uchar 64 0
  t = new uchar 64 0
  for i ulong 32
    put m i get sd i
  end
  s512hash m 32 hd
  for i ulong 32
    put t i get hd i
    put pfx i get hd add i 32
  end
  put t 0 and get t 0 uchar 248
  put t 31 and get t 31 uchar 127
  put t 31 or get t 31 uchar 64
  om_ed_red t ar
end

fn om_ed_basemul sc view uchar 32 dst edit uchar 32 to void
  w = new ulong 1024 0
  z = new uchar 32 0
  edinit w
  edsmul w sc z
  edpenc w edq dst
end

fn om_ed_muladd r view uchar 32 k view uchar 32 a view uchar 32 sg edit uchar 64 to void
  x = new long 64 0
  for i ulong 32
    put x i long get r i
  end
  for i ulong 32
    ki = long get k i
    for j ulong 32
      p = add i j
      put x p add get x p mul ki long get a j
    end
  end
  edmodl x
  for i ulong 32
    put sg add 32 i uchar get x i
  end
end

fn om_ed_hprefix pfx view uchar 64 m view uchar 65536 n ulong hd edit uchar 64 to void
  if gt n 65504
    trap 3
  end
  pm = new uchar 65536 0
  for i ulong 32
    put pm i get pfx i
  end
  for i ulong n bound 65504
    put pm add 32 i get m i
  end
  s512hash pm add n 32 hd
end

fn om_ed_sign_msg sd view uchar 32 m view uchar 65536 n ulong pk edit uchar 32 sg edit uchar 64 to void
  ar = new uchar 32 0
  pfx = new uchar 64 0
  hd = new uchar 64 0
  r_sc = new uchar 32 0
  r_pt = new uchar 32 0
  k = new uchar 32 0
  om_ed_expand sd ar pfx
  om_ed_basemul ar pk
  om_ed_hprefix pfx m n hd
  om_ed_red hd r_sc
  om_ed_basemul r_sc r_pt
  for i ulong 32
    put sg i get r_pt i
  end
  edhram sg pk m n k
  om_ed_muladd r_sc k ar sg
end

fn om_ed_sign_hdr n ulong to void
  sd = new uchar 32 0
  m = new uchar 65536 0
  pk = new uchar 32 0
  sg = new uchar 64 0
  for i ulong 32
    put sd i get om_seed i
  end
  for i ulong n bound 256
    put m i get om_pkg i
  end
  om_ed_sign_msg sd m n pk sg
  for i ulong 32
    put om_pk i get pk i
    put om_pkg add 128 i get pk i
  end
  for i ulong 64
    put om_sig i get sg i
    put om_pkg add 160 i get sg i
  end
end

fn om_ed_verify_hdr n ulong to bool
  pk = new uchar 32 0
  m = new uchar 65536 0
  sg = new uchar 64 0
  for i ulong 32
    put pk i get om_pkg add 128 i
  end
  for i ulong n bound 256
    put m i get om_pkg i
  end
  for i ulong 64
    put sg i get om_pkg add 160 i
  end
  ret eq edverify pk m n sg 0 1
end

note ---- Genuine OIR v2 (OSC1IR v10) Emitter, Verifier & SEMANTIC_ID ----

fn om_oir_u8 v ulong to void
  p = get om_oir_len 0
  if lt p 8192
    put om_oir p uchar and v 255
    put om_oir_len 0 add p 1
  end
end

fn om_oir_u32 v ulong to void
  for j ulong 4
    om_oir_u8 shr v mul j 8
  end
end

fn om_oir_u64 v ulong to void
  om_oir_u32 and v 4294967295
  om_oir_u32 shr v 32
end

fn om_oir_contract pwrMw ulong to void
  om_oir_u8 1
  om_oir_u8 1
  om_oir_u8 0
  om_oir_u8 0
  om_oir_u64 0
  om_oir_u64 0
  om_oir_u64 pwrMw
end

fn om_op_to_oir opKind ulong to ulong
  if eq opKind OIR_ADD
    ret 10
  end
  if eq opKind OIR_SUB
    ret 11
  end
  ret 12
end

fn om_oir_to_op opCode ulong to ulong
  if eq opCode 10
    ret OIR_ADD
  end
  if eq opCode 11
    ret OIR_SUB
  end
  if eq opCode 12
    ret OIR_MUL
  end
  ret 0
end

fn om_op_to_egp opKind ulong to ulong
  if eq opKind OIR_ADD
    ret 3
  end
  if eq opKind OIR_SUB
    ret 4
  end
  ret 5
end

fn om_build_oir_v2 to void
  put om_oir_len 0 0
  for j ulong 6
    om_oir_u8 ulong get om_t_oir_magic j
  end
  om_oir_u8 0
  om_oir_u8 10
  for j ulong 14
    om_oir_u8 ulong get om_t_oir_tag j
  end
  om_oir_u8 0
  om_oir_u8 0
  om_oir_u32 0
  om_oir_u32 0
  om_oir_u32 2

  note fn 0: pure exact kfn(a: u64, b: u64, c: u64) -> u64
  om_oir_u8 0
  om_oir_u8 0
  om_oir_u32 3
  om_oir_u32 5
  om_oir_u32 5
  om_oir_u32 5
  om_oir_u32 5
  om_oir_contract get om_cfg 10
  om_oir_u32 1
  om_oir_u32 0
  om_oir_u32 3
  om_oir_u8 om_op_to_oir get om_cfg 3
  om_oir_u32 5
  om_oir_u32 1
  om_oir_u32 2
  om_oir_u8 om_op_to_oir get om_cfg 4
  om_oir_u32 5
  om_oir_u32 4
  om_oir_u32 3
  om_oir_u8 63
  om_oir_u32 0
  om_oir_u32 0
  om_oir_u32 5

  note fn 1: export pure exact main() -> i32 calling kfn(argA, argB, argC)
  om_oir_u8 2
  om_oir_u8 0
  om_oir_u32 0
  om_oir_u32 8
  om_oir_contract get om_cfg 10
  om_oir_u32 1
  om_oir_u32 0
  om_oir_u32 6
  om_oir_u8 1
  om_oir_u32 5
  om_oir_u64 get om_cfg 0
  om_oir_u8 1
  om_oir_u32 5
  om_oir_u64 get om_cfg 1
  om_oir_u8 1
  om_oir_u32 5
  om_oir_u64 get om_cfg 2
  om_oir_u8 64
  om_oir_u32 5
  om_oir_u32 3
  om_oir_u32 0
  om_oir_u32 0
  om_oir_u32 1
  om_oir_u32 2
  om_oir_u32 3
  om_oir_u8 36
  om_oir_u32 8
  om_oir_u64 0
  om_oir_u32 5
  om_oir_u8 63
  om_oir_u32 0
  om_oir_u32 4
  om_oir_u32 6
end

fn om_compute_sem_id to void
  p = len om_t_sem_pfx
  for i ulong p bound 64
    put sh_dat i get om_t_sem_pfx i
  end
  n = get om_oir_len 0
  for i ulong n bound 8192
    put sh_dat add p i get om_oir i
  end
  sh_all add p n
  for i ulong 32
    put om_sem i get sh_dig i
  end
end

fn om_oir_rd_u8 n ulong to ulong
  c = get om_oir_cur 0
  if gt add c 1 n
    ret OM_NONE
  end
  put om_oir_cur 0 add c 1
  ret ulong get om_oir c
end

fn om_oir_rd_u32 n ulong to ulong
  c = get om_oir_cur 0
  if gt add c 4 n
    ret OM_NONE
  end
  v = ulong 0
  for j ulong 4
    v = or v shl ulong get om_oir add c j mul j 8
  end
  put om_oir_cur 0 add c 4
  ret v
end

fn om_oir_rd_u64 n ulong to ulong
  lo = om_oir_rd_u32 n
  hi = om_oir_rd_u32 n
  if or eq lo OM_NONE eq hi OM_NONE
    ret OM_NONE
  end
  ret or lo shl hi 32
end

fn om_oir_chk_hdr n ulong to bool
  if lt n 36
    ret false
  end
  for j ulong 6
    if ne get om_oir j get om_t_oir_magic j
      ret false
    end
  end
  if or ne get om_oir 6 0 ne get om_oir 7 10
    ret false
  end
  for j ulong 14
    if ne get om_oir add 8 j get om_t_oir_tag j
      ret false
    end
  end
  if or ne get om_oir 22 0 ne get om_oir 23 0
    ret false
  end
  put om_oir_cur 0 24
  if or ne om_oir_rd_u32 n 0 ne om_oir_rd_u32 n 0
    ret false
  end
  ret eq om_oir_rd_u32 n 2
end

fn om_oir_chk_contract n ulong expPwr ulong to bool
  pur = om_oir_rd_u8 n
  prc = om_oir_rd_u8 n
  hd = om_oir_rd_u8 n
  rsv = om_oir_rd_u8 n
  err = om_oir_rd_u64 n
  dl = om_oir_rd_u64 n
  pwr = om_oir_rd_u64 n
  if or ne pur 1 or ne prc 1 or ne hd 0 ne rsv 0
    ret false
  end
  if or ne err 0 or ne dl 0 ne pwr expPwr
    ret false
  end
  ret true
end

fn om_oir_parse_fn0 n ulong expPwr ulong to bool
  if or ne om_oir_rd_u8 n 0 ne om_oir_rd_u8 n 0
    ret false
  end
  if ne om_oir_rd_u32 n 3
    ret false
  end
  for j ulong 4
    if ne om_oir_rd_u32 n 5
      ret false
    end
  end
  if not om_oir_chk_contract n expPwr
    ret false
  end
  if or ne om_oir_rd_u32 n 1 ne om_oir_rd_u32 n 0
    ret false
  end
  if ne om_oir_rd_u32 n 3
    ret false
  end
  op1 = om_oir_to_op om_oir_rd_u8 n
  if or eq op1 0 ne om_oir_rd_u32 n 5
    ret false
  end
  if or ne om_oir_rd_u32 n 1 ne om_oir_rd_u32 n 2
    ret false
  end
  op2 = om_oir_to_op om_oir_rd_u8 n
  if or eq op2 0 ne om_oir_rd_u32 n 5
    ret false
  end
  if or ne om_oir_rd_u32 n 4 ne om_oir_rd_u32 n 3
    ret false
  end
  if or ne om_oir_rd_u8 n 63 ne om_oir_rd_u32 n 0
    ret false
  end
  if or ne om_oir_rd_u32 n 0 ne om_oir_rd_u32 n 5
    ret false
  end
  put om_cfg 3 op1
  put om_cfg 4 op2
  ret true
end

fn om_oir_parse_fn1_args n ulong expPwr ulong to bool
  if or ne om_oir_rd_u8 n 2 ne om_oir_rd_u8 n 0
    ret false
  end
  if or ne om_oir_rd_u32 n 0 ne om_oir_rd_u32 n 8
    ret false
  end
  if not om_oir_chk_contract n expPwr
    ret false
  end
  if or ne om_oir_rd_u32 n 1 ne om_oir_rd_u32 n 0
    ret false
  end
  if ne om_oir_rd_u32 n 6
    ret false
  end
  for k ulong 3
    if or ne om_oir_rd_u8 n 1 ne om_oir_rd_u32 n 5
      ret false
    end
    av = om_oir_rd_u64 n
    if eq av OM_NONE
      ret false
    end
    put om_cfg k av
  end
  ret true
end

fn om_oir_parse_fn1_tail n ulong to bool
  if or ne om_oir_rd_u8 n 64 ne om_oir_rd_u32 n 5
    ret false
  end
  if or ne om_oir_rd_u32 n 3 ne om_oir_rd_u32 n 0
    ret false
  end
  if ne om_oir_rd_u32 n 0
    ret false
  end
  if or ne om_oir_rd_u32 n 1 or ne om_oir_rd_u32 n 2 ne om_oir_rd_u32 n 3
    ret false
  end
  if or ne om_oir_rd_u8 n 36 ne om_oir_rd_u32 n 8
    ret false
  end
  if or ne om_oir_rd_u64 n 0 ne om_oir_rd_u32 n 5
    ret false
  end
  if or ne om_oir_rd_u8 n 63 ne om_oir_rd_u32 n 0
    ret false
  end
  if or ne om_oir_rd_u32 n 4 ne om_oir_rd_u32 n 6
    ret false
  end
  ret eq get om_oir_cur 0 n
end

fn om_parse_verify_oir expPwr ulong to bool
  n = get om_oir_len 0
  if not om_oir_chk_hdr n
    ret false
  end
  if not om_oir_parse_fn0 n expPwr
    ret false
  end
  if not om_oir_parse_fn1_args n expPwr
    ret false
  end
  ret om_oir_parse_fn1_tail n
end

note ---- Genuine EGP3 Structural Proof Builder & Verifier ----

fn om_egp_u32 v ulong to void
  p = get om_egp_len 0
  if le add p 4 16384
    for j ulong 4
      put om_egp add p j uchar and shr v mul j 8 255
    end
    put om_egp_len 0 add p 4
  end
end

fn om_egp_node op ulong a ulong b ulong c ulong val ulong to void
  om_egp_u32 op
  om_egp_u32 a
  om_egp_u32 b
  om_egp_u32 c
  om_egp_u32 and val 4294967295
  om_egp_u32 shr val 32
  om_egp_u32 64
  om_egp_u32 0
end

fn om_egp_step rule ulong u ulong v ulong to void
  om_egp_u32 rule
  om_egp_u32 u
  om_egp_u32 v
end

fn om_build_egp3 to void
  e1 = om_op_to_egp get om_cfg 3
  e2 = om_op_to_egp get om_cfg 4
  put om_egp_len 0 0
  put om_egp 0 uchar 69
  put om_egp 1 uchar 71
  put om_egp 2 uchar 80
  put om_egp 3 uchar 51
  put om_egp_len 0 4
  om_egp_u32 1
  om_egp_u32 0
  om_egp_u32 0
  om_egp_u32 64
  om_egp_u32 11
  om_egp_u32 8
  om_egp_u32 10
  om_egp_u32 2
  om_egp_node 2 0 0 0 0
  om_egp_node 2 0 0 0 1
  om_egp_node 2 0 0 0 2
  om_egp_node 1 0 0 0 0
  om_egp_node 1 0 0 0 1
  om_egp_node 3 0 3 0 0
  om_egp_node 5 2 4 0 0
  om_egp_node e1 5 1 0 0
  om_egp_node e2 7 6 0 0
  om_egp_node e1 0 1 0 0
  om_egp_node e2 9 2 0 0
  om_egp_step 3 5 0
  om_egp_step 5 6 2
end

fn om_verify_egp3_ast ra_id ulong nc ulong to bool
  if or ge ra_id nc ne get vc3_op ra_id om_op_to_egp get om_cfg 4
    ret false
  end
  ch_l = get vc3_a ra_id
  ch_r = get vc3_b ra_id
  if or ge ch_l nc ge ch_r nc
    ret false
  end
  if ne get vc3_op ch_l om_op_to_egp get om_cfg 3
    ret false
  end
  if or ne get vc3_op ch_r 2 ne get vc3_vraw ch_r 2
    ret false
  end
  la = get vc3_a ch_l
  lb = get vc3_b ch_l
  if or ge la nc ge lb nc
    ret false
  end
  if or ne get vc3_op la 2 ne get vc3_vraw la 0
    ret false
  end
  ret and eq get vc3_op lb 2 eq get vc3_vraw lb 1
end

fn om_verify_egp3_payload to bool
  en = get om_egp_len 0
  if or lt en 36 gt en 16384
    ret false
  end
  for i ulong en bound 16384
    put vc3_buf i get om_egp i
  end
  if ne vc3_verify en 0
    ret false
  end
  if or eq get vc3_stat 0 0 eq get vc3_stat 1 0
    ret false
  end
  put om_eg_st 0 get vc3_stat 0
  put om_eg_st 1 get vc3_stat 1
  rb_id = vc3_rdu32 24
  ra_id = vc3_rdu32 28
  if eq rb_id ra_id
    ret false
  end
  ret om_verify_egp3_ast ra_id get vc3_nc 0
end

note ---- OM-3 & WattCBF Safety Verifiers ----

fn om_check_om3_hdr to bool
  fl = om_pkg_u32 8
  tag = om_pkg_u32 12
  if ne and fl OM_FLAGS_REQ OM_FLAGS_REQ
    ret false
  end
  if ne and fl not OM_FLAGS_REQ 0
    ret false
  end
  ret eq tag OM_OM3_TAG
end

fn om_check_wattcbf_filter st view WattThermal pol view WattPolicy pwrMw ulong to bool
  pr = new WattProp long pwrMw 15000 5000 50
  cmd = new WattCmd 0 0 0 0 0 0
  wc_cbf_filter st pol pr cmd
  if ne get cmd fail_closed 0
    ret false
  end
  if ne get cmd p_gpu long pwrMw
    ret false
  end
  dt = wc_next_die_delta st get cmd p_gpu get cmd p_cpu get cmd p_unc
  bh = wc_barrier_h get pol t_ceil get st t_die get pol tau dt
  ret ge bh 0
end

fn om_check_wattcbf pwrMw ulong tceilMc ulong to bool
  if or eq pwrMw 0 ge pwrMw OM_WATT_MAX_MW
    ret false
  end
  if or eq tceilMc 0 gt tceilMc OM_WATT_MAX_TCEIL
    ret false
  end
  st = new WattThermal long get om_cfg 12 long get om_cfg 13 25000
  pol = new WattPolicy 120000 80000 long tceilMc 2
  if wc_must_fail_closed st pol
    ret false
  end
  ret om_check_wattcbf_filter st pol pwrMw
end

note ---- OMMP01 Container Hash, Pack & Fail-Closed Verify ----

fn om_compute_container_sha to void
  for i ulong 96
    put sh_dat i get om_pkg i
  end
  plen = sub get om_pkg_len 0 OM_HDR_LEN
  for i ulong plen bound 32768
    put sh_dat add 96 i get om_pkg add OM_HDR_LEN i
  end
  sh_all add 96 plen
  for i ulong 32
    put om_csha i get sh_dig i
  end
end

fn om_seal_pkg to int
  pwrMw = get om_cfg 10
  tceilMc = get om_cfg 11
  if not om_check_wattcbf pwrMw tceilMc
    ret OM_ERR_WATTCBF
  end
  om_build_oir_v2
  om_compute_sem_id
  om_build_egp3
  if not om_verify_egp3_payload
    ret OM_ERR_EGP3
  end
  on = get om_oir_len 0
  en = get om_egp_len 0
  tot = add OM_HDR_LEN add on en
  if gt tot 32768
    ret OM_ERR_FORMAT
  end
  put om_pkg_len 0 tot
  for i ulong OM_HDR_LEN
    put om_pkg i uchar 0
  end
  for j ulong 6
    put om_pkg j get om_t_magic j
  end
  om_pkg_put_u16 6 OM_VERSION
  om_pkg_put_u32 8 OM_FLAGS_REQ
  om_pkg_put_u32 12 OM_OM3_TAG
  om_pkg_put_u32 16 pwrMw
  om_pkg_put_u32 20 tceilMc
  om_pkg_put_u64 24 get om_cfg 5
  om_pkg_put_u32 32 get om_cfg 6
  om_pkg_put_u32 36 get om_cfg 7
  om_pkg_put_u64 40 get om_cfg 8
  om_pkg_put_u64 48 get om_cfg 9
  om_pkg_put_u32 56 on
  om_pkg_put_u32 60 en
  for i ulong 32
    put om_pkg add 64 i get om_sem i
  end
  for i ulong on bound 8192
    put om_pkg add OM_HDR_LEN i get om_oir i
  end
  eoff = add OM_HDR_LEN on
  for i ulong en bound 16384
    put om_pkg add eoff i get om_egp i
  end
  om_compute_container_sha
  for i ulong 32
    put om_pkg add 96 i get om_csha i
  end
  om_ed_sign_hdr 128
  ret OM_OK
end

fn om_verify_pkg_buf to int
  n = get om_pkg_len 0
  if or lt n 260 gt n 32768
    ret OM_ERR_FORMAT
  end
  for j ulong 6
    if ne get om_pkg j get om_t_magic j
      ret OM_ERR_FORMAT
    end
  end
  if ne om_pkg_u16 6 OM_VERSION
    ret OM_ERR_FORMAT
  end
  on = om_pkg_u32 56
  en = om_pkg_u32 60
  if or lt on 32 gt on 8192
    ret OM_ERR_FORMAT
  end
  if or lt en 36 gt en 16384
    ret OM_ERR_FORMAT
  end
  if ne add OM_HDR_LEN add on en n
    ret OM_ERR_FORMAT
  end
  if not om_ed_verify_hdr 128
    ret OM_ERR_ED25519
  end
  om_compute_container_sha
  for i ulong 32
    if ne get om_csha i get om_pkg add 96 i
      ret OM_ERR_SHA256
    end
  end
  for i ulong on bound 8192
    put om_oir i get om_pkg add OM_HDR_LEN i
  end
  put om_oir_len 0 on
  pwrMw = om_pkg_u32 16
  if not om_parse_verify_oir pwrMw
    ret OM_ERR_SEM_ID
  end
  om_compute_sem_id
  for i ulong 32
    if ne get om_sem i get om_pkg add 64 i
      ret OM_ERR_SEM_ID
    end
  end
  eoff = add OM_HDR_LEN on
  for i ulong en bound 16384
    put om_egp i get om_pkg add eoff i
  end
  put om_egp_len 0 en
  if not om_verify_egp3_payload
    ret OM_ERR_EGP3
  end
  if not om_check_om3_hdr
    ret OM_ERR_OM3
  end
  tceilMc = om_pkg_u32 20
  if not om_check_wattcbf pwrMw tceilMc
    ret OM_ERR_WATTCBF
  end
  put om_cfg 5 om_pkg_u64 24
  put om_cfg 6 om_pkg_u32 32
  put om_cfg 7 om_pkg_u32 36
  put om_cfg 8 om_pkg_u64 40
  put om_cfg 9 om_pkg_u64 48
  put om_cfg 10 pwrMw
  put om_cfg 11 tceilMc
  ret OM_OK
end

note ---- TargetDesc + Spill-Aware Regalloc + Multi-Target Emitters (8+ Targets) ----

fn om_run_regalloc cid ulong to ulong
  ngpr = ctNgpr cid
  if gt ngpr RA_MAX_REGS
    ngpr = RA_MAX_REGS
  end
  raReset
  ign0 = raAddInterval 0 2 0
  ign1 = raAddInterval 0 2 1
  ign2 = raAddInterval 0 4 2
  ign3 = raAddInterval 3 4 0
  ign4 = raAddInterval 5 6 0
  reqR = get om_cfg 6
  if gt reqR 5
    ex = sub reqR 5
    if gt ex 240
      ex = ulong 240
    end
    for i ulong ex bound 240
      ign = raAddInterval 0 2 RA_SPILL
    end
  end
  sp = raRunForNgpr ngpr
  if ne raVerifyComplete ngpr 0
    ret 999
  end
  ret sp
end


fn om_emit_spirv_compute to void
  put om_spv_n 0 0
  om_spv_hdr_decor
  om_spv_types
  om_spv_op5 54 1 15 0 10
  om_spv_op 248 2
  om_spv_w 18
  om_spv_op4 61 4 19 11
  om_spv_op5 81 2 20 19 0
  om_spv_op5 68 2 21 14 0
  om_spv_op5 176 3 22 20 21
  om_spv_op3 247 24 0
  om_spv_op4 250 22 23 24
  om_spv_op 248 2
  om_spv_w 23
  om_spv_op 65 6
  om_spv_w 9
  om_spv_w 25
  om_spv_w 12
  om_spv_w 16
  om_spv_w 20
  om_spv_op4 61 2 26 25
  om_spv_op 65 6
  om_spv_w 9
  om_spv_w 27
  om_spv_w 13
  om_spv_w 16
  om_spv_w 20
  om_spv_op4 61 2 28 27
  om_spv_op5 om_spv_alu get om_cfg 3 2 29 26 28
  om_spv_op5 om_spv_alu get om_cfg 4 2 30 29 17
  om_spv_op 65 6
  om_spv_w 9
  om_spv_w 31
  om_spv_w 14
  om_spv_w 16
  om_spv_w 20
  om_spv_op3 62 31 30
  om_spv_op 249 2
  om_spv_w 24
  om_spv_op 248 2
  om_spv_w 24
  om_spv_op 253 1
  om_spv_op 56 1
  om_out_reset
  om_out_u32 0x07230203
  om_out_u32 0x00010300
  om_out_u32 0
  om_out_u32 32
  om_out_u32 0
  nw = get om_spv_n 0
  for i ulong nw bound 256
    om_out_u32 ulong get om_spv i
  end
end

fn om_xe_alu_op opKind ulong to ulong
  if eq opKind OIR_MUL
    ret 0x41
  end
  ret 0x40
end

fn om_xe_load sbid ulong dst ulong addrR ulong to void
  lo = ulong 0x31
  lo = or lo 0x0f00
  lo = or lo sbid
  lo = or lo 0x00800000
  lo = or lo shl dst 48
  hi = or shl addrR 8 0x02100580
  om_out_u64 lo
  om_out_u64 hi
end

fn om_xe_alu op ulong swsb ulong dst ulong s0 ulong s1 ulong to void
  lo = or op swsb
  lo = or lo 0x00800000
  lo = or lo shl dst 48
  hi = or shl s0 8 shl s1 40
  om_out_u64 lo
  om_out_u64 hi
end

fn om_emit_intel_xe to void
  om_out_reset
  om_xe_load 0x1000 4 2
  om_xe_load 0x1100 6 3
  om_xe_alu om_xe_alu_op get om_cfg 3 0x3000 8 4 6
  om_xe_load 0x1000 10 5
  om_xe_alu om_xe_alu_op get om_cfg 4 0x3000 8 8 10
  loSt = ulong 0x31
  loSt = or loSt 0x0f00
  loSt = or loSt 0x0100
  loSt = or loSt 0x00800000
  hiSt = shl ulong 1 8
  hiSt = or hiSt shl ulong 8 40
  hiSt = or hiSt 0x02000584
  om_out_u64 loSt
  om_out_u64 hiSt
  loEot = ulong 0x31
  loEot = or loEot 0x0300
  loEot = or loEot 0x0100
  loEot = or loEot 0x00800000
  loEot = or loEot 0x0000000400000000
  om_out_u64 loEot
  om_out_u64 0x00000010
end

fn om_bw_push ins edit ulong 8192 insIdx ulong op ulong d ulong s1 ulong s2 ulong to void
  b = mul insIdx 8
  put ins b op
  put ins add b 1 d
  put ins add b 2 s1
  put ins add b 3 s2
  if eq op 8
    put ins add b 4 255
  else
    put ins add b 4 OM_NONE
  end
  put ins add b 5 OM_NONE
  put ins add b 7 0
end

fn om_build_hxp1_cert sassBytes ulong to void
  nIns = div sassBytes 16
  for i ulong sassBytes bound 16384
    put sh_dat i get om_out i
  end
  sh_all sassBytes
  for i ulong 256
    put om_cert i uchar 0
  end
  put om_cert 0 uchar 72
  put om_cert 1 uchar 88
  put om_cert 2 uchar 80
  put om_cert 3 uchar 49
  put om_cert 4 uchar and nIns 255
  put om_cert 5 uchar and shr nIns 8 255
  put om_cert 6 uchar and shr nIns 16 255
  put om_cert 7 uchar and shr nIns 24 255
  for i ulong 32
    d = get sh_dig i
    put om_cert add 8 i d
    put om_cert add 40 i d
  end
  for i ulong nIns bound 256
    o = add 72 mul i 4
    put om_cert o uchar and i 255
    put om_cert add o 1 uchar and shr i 8 255
    put om_cert add o 2 uchar and shr i 16 255
    put om_cert add o 3 uchar and shr i 24 255
  end
  put om_cert_len 0 add 72 mul nIns 4
end

fn om_emit_sm121 to void
  ins = new ulong 8192 0
  phys = new ulong 288 0
  code = new uchar 16384 0
  for i ulong 288
    put phys i i
  end
  ctl6 = shl ulong 1035264 32
  om_bw_push ins 0 2 4 OM_NONE OM_NONE
  put ins 6 or and get om_cfg 0 4294967295 ctl6
  om_bw_push ins 1 2 8 OM_NONE OM_NONE
  put ins 14 or and get om_cfg 1 4294967295 ctl6
  om_bw_push ins 2 2 12 OM_NONE OM_NONE
  put ins 22 or and get om_cfg 2 4294967295 ctl6
  op1 = ulong 14
  if eq get om_cfg 3 OIR_MUL
    op1 = ulong 8
  end
  om_bw_push ins 3 op1 16 4 8
  put ins 30 ctl6
  op2 = ulong 8
  if ne get om_cfg 4 OIR_MUL
    op2 = ulong 14
  end
  om_bw_push ins 4 op2 20 16 12
  put ins 38 ctl6
  om_bw_push ins 5 45 OM_NONE OM_NONE OM_NONE
  put ins 46 shl ulong 1042944 32
  nb = bw_enc_sm121 ins phys 6 1 code
  if eq nb 0
    om_fail OM_ERR_CONTRACT
  end
  om_out_reset
  for i ulong nb bound 16384
    om_out_u8 ulong get code i
  end
  om_build_hxp1_cert nb
end

fn om_emit_backend bk ulong to void
  if eq bk CT_BK_ARM64
    om_emit_arm64_elf
    ret
  end
  if eq bk CT_BK_APPLE
    om_emit_apple_macho
    ret
  end
  if eq bk CT_BK_X64
    om_emit_x64_elf
    ret
  end
  if eq bk CT_BK_RV64
    om_emit_rv64_elf
    ret
  end
  if eq bk CT_BK_WASM
    om_emit_wasm_ir
    ret
  end
  if eq bk CT_BK_SPIRV
    om_emit_spirv_compute
    ret
  end
  if eq bk CT_BK_XE
    om_emit_intel_xe
    ret
  end
  if eq bk CT_BK_SM121
    om_emit_sm121
    ret
  end
  om_fail OM_ERR_CONTRACT
end

note ---- File I/O Helpers ----

fn om_read_file pkind ulong to bool
  p = new uchar 4096 0
  pn = ulong 0
  if eq pkind 0
    pn = get om_p_in_n 0
    for i ulong pn bound 4096
      put p i get om_p_in i
    end
  else
    pn = get om_p_chips_n 0
    for i ulong pn bound 4096
      put p i get om_p_chips i
    end
  end
  if or eq pn 0 gt pn 4095
    ret false
  end
  fd = fopen p 0 pn 0 0
  if lt fd 0
    ret false
  end
  ifd = int fd
  tot = ulong 0
  while lt tot 32767 bound 128
    r = read ifd om_pkg tot sub 32767 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose ifd
  put om_pkg_len 0 tot
  ret gt tot 0
end

fn om_write_slice pkind ulong bufkind ulong n ulong to bool
  p = new uchar 4096 0
  pn = ulong 0
  if eq pkind 0
    pn = get om_p_out_n 0
    for i ulong pn bound 4096
      put p i get om_p_out i
    end
  end
  if eq pkind 1
    pn = get om_p_cert_n 0
    for i ulong pn bound 4096
      put p i get om_p_cert i
    end
  end
  if eq pkind 2
    pn = get om_p_ir_n 0
    for i ulong pn bound 4096
      put p i get om_p_ir i
    end
  end
  if eq pkind 3
    pn = get om_p_doir_n 0
    for i ulong pn bound 4096
      put p i get om_p_doir i
    end
  end
  if eq pkind 4
    pn = get om_p_degp_n 0
    for i ulong pn bound 4096
      put p i get om_p_degp i
    end
  end
  if or eq pn 0 gt pn 4095
    ret false
  end
  fd = fopen p 0 pn 577 493
  if lt fd 0
    ret false
  end
  ifd = int fd
  off = ulong 0
  while lt off n bound 65536
    k = long 0
    if eq bufkind 0
      k = write ifd om_pkg off sub n off
    end
    if eq bufkind 1
      k = write ifd om_out off sub n off
    end
    if eq bufkind 2
      k = write ifd om_cert off sub n off
    end
    if eq bufkind 3
      k = write ifd om_ir off sub n off
    end
    if eq bufkind 4
      k = write ifd om_oir off sub n off
    end
    if eq bufkind 5
      k = write ifd om_egp off sub n off
    end
    if le k 0
      z = fclose ifd
      ret false
    end
    off = add off ulong k
  end
  z = fclose ifd
  ret true
end

fn om_load_chips_path to int
  pn = get om_p_chips_n 0
  p = new uchar 4096 0
  for i ulong pn bound 4096
    put p i get om_p_chips i
  end
  ret ctLoadFile p pn
end

fn om_find_tgt to ulong
  tn = get om_tgt_n 0
  t = new uchar 64 0
  for i ulong tn bound 64
    put t i get om_tgt i
  end
  ret ctFindChip t tn
end

fn om_morph_check_contract cid ulong to ulong
  ctSyncTd cid
  rc = ctCheckRecipe cid get om_cfg 5 get om_cfg 6 get om_cfg 7 get om_cfg 8 get om_cfg 9
  if ne rc TDK_OK
    om_wrt 2 om_m_tdk
    ctWriteU64 2 rc
    om_wrt 2 om_m_tgt
    ctWriteId 2 cid
    om_wrt 2 om_m_nl
    exit OM_ERR_CONTRACT
  end
  sp = om_run_regalloc cid
  if eq sp 999
    om_fail OM_ERR_CONTRACT
  end
  ret sp
end

note ---- CLI Parsing ----

fn om_abuf_eq n ulong kw view uchar * to bool
  if ne n len kw
    ret false
  end
  for i ulong n bound 64
    if ne get om_abuf i get kw i
      ret false
    end
  end
  ret true
end

fn om_parse_dec_abuf n ulong to ulong
  if or eq n 0 gt n 20
    om_fail OM_ERR_USAGE
  end
  v = ulong 0
  for i ulong n bound 20
    c = get om_abuf i
    if or lt c 48 gt c 57
      om_fail OM_ERR_USAGE
    end
    v = add mul v 10 ulong sub c 48
  end
  ret v
end

fn om_parse_op_abuf n ulong to ulong
  if om_abuf_eq n om_t_add
    ret OIR_ADD
  end
  if om_abuf_eq n om_t_sub
    ret OIR_SUB
  end
  if om_abuf_eq n om_t_mul
    ret OIR_MUL
  end
  om_fail OM_ERR_USAGE
  ret OIR_ADD
end

fn om_hex_nib c uchar to ulong
  if and ge c 48 le c 57
    ret ulong sub c 48
  end
  if and ge c 97 le c 102
    ret add 10 ulong sub c 97
  end
  if and ge c 65 le c 70
    ret add 10 ulong sub c 65
  end
  om_fail OM_ERR_USAGE
  ret 0
end

fn om_parse_seed_hex n ulong to void
  if ne n 64
    om_fail OM_ERR_USAGE
  end
  for i ulong 32
    hi = om_hex_nib get om_abuf mul i 2
    lo = om_hex_nib get om_abuf add mul i 2 1
    put om_seed i uchar or shl hi 4 lo
  end
  put om_cfg 14 1
end

fn om_copy_abuf_to dst ulong n ulong to void
  if or eq n 0 gt n 4095
    om_fail OM_ERR_USAGE
  end
  if eq dst 0
    for i ulong n bound 4096
      put om_p_in i get om_abuf i
    end
    put om_p_in_n 0 n
    ret
  end
  if eq dst 1
    for i ulong n bound 4096
      put om_p_out i get om_abuf i
    end
    put om_p_out_n 0 n
    ret
  end
  if eq dst 2
    for i ulong n bound 4096
      put om_p_chips i get om_abuf i
    end
    put om_p_chips_n 0 n
    ret
  end
  if eq dst 3
    if gt n 63
      om_fail OM_ERR_USAGE
    end
    for i ulong n bound 64
      put om_tgt i get om_abuf i
    end
    put om_tgt_n 0 n
    ret
  end
  if eq dst 4
    for i ulong n bound 4096
      put om_p_cert i get om_abuf i
    end
    put om_p_cert_n 0 n
    ret
  end
  if eq dst 5
    for i ulong n bound 4096
      put om_p_ir i get om_abuf i
    end
    put om_p_ir_n 0 n
    ret
  end
  if eq dst 6
    for i ulong n bound 4096
      put om_p_doir i get om_abuf i
    end
    put om_p_doir_n 0 n
    ret
  end
  if eq dst 7
    for i ulong n bound 4096
      put om_p_degp i get om_abuf i
    end
    put om_p_degp_n 0 n
    ret
  end
  for i ulong n bound 4096
    put om_p_dir i get om_abuf i
  end
  put om_p_dir_n 0 n
end

fn om_init_defaults to void
  for i ulong len om_t_def_chips
    put om_p_chips i get om_t_def_chips i
  end
  put om_p_chips_n 0 len om_t_def_chips
  for i ulong len om_t_def_dir
    put om_p_dir i get om_t_def_dir i
  end
  put om_p_dir_n 0 len om_t_def_dir
  for i ulong 32
    put om_seed i get om_t_def_seed i
  end
  put om_p_in_n 0 0
  put om_p_out_n 0 0
  put om_p_cert_n 0 0
  put om_p_ir_n 0 0
  put om_p_doir_n 0 0
  put om_p_degp_n 0 0
  put om_tgt_n 0 0
  put om_cfg 0 7
  put om_cfg 1 5
  put om_cfg 2 3
  put om_cfg 3 OIR_ADD
  put om_cfg 4 OIR_MUL
  put om_cfg 5 0
  put om_cfg 6 3
  put om_cfg 7 64
  put om_cfg 8 0
  put om_cfg 9 0
  put om_cfg 10 15000
  put om_cfg 11 85000
  put om_cfg 12 50000
  put om_cfg 13 42000
  put om_cfg 14 0
end

fn om_read_arg_str idx ulong ac ulong to ulong
  if ge idx ac
    om_fail OM_ERR_USAGE
  end
  k = argread idx om_abuf 0 4095
  if lt k 1
    om_fail OM_ERR_USAGE
  end
  ret ulong k
end

fn om_parse_flag_a al ulong idx ulong ac ulong to ulong
  if om_abuf_eq al om_f_in
    om_copy_abuf_to 0 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_out
    om_copy_abuf_to 1 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_chips
    om_copy_abuf_to 2 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_tgt
    om_copy_abuf_to 3 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_cert
    om_copy_abuf_to 4 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_ir
    om_copy_abuf_to 5 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_doir
    om_copy_abuf_to 6 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_degp
    om_copy_abuf_to 7 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_outdir
    om_copy_abuf_to 8 om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  ret 0
end

fn om_parse_flag_b al ulong idx ulong ac ulong to ulong
  if om_abuf_eq al om_f_args
    put om_cfg 0 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    put om_cfg 1 om_parse_dec_abuf om_read_arg_str add idx 2 ac
    put om_cfg 2 om_parse_dec_abuf om_read_arg_str add idx 3 ac
    ret add idx 4
  end
  if om_abuf_eq al om_f_ops
    put om_cfg 3 om_parse_op_abuf om_read_arg_str add idx 1 ac
    put om_cfg 4 om_parse_op_abuf om_read_arg_str add idx 2 ac
    ret add idx 3
  end
  if om_abuf_eq al om_f_smem
    put om_cfg 5 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_regs
    put om_cfg 6 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_l2
    put om_cfg 7 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_mma
    put om_cfg 8 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_feat
    put om_cfg 9 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_power
    put om_cfg 10 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_tceil
    put om_cfg 11 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_tdie
    put om_cfg 12 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_tsink
    put om_cfg 13 om_parse_dec_abuf om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  if om_abuf_eq al om_f_seedhex
    om_parse_seed_hex om_read_arg_str add idx 1 ac
    ret add idx 2
  end
  om_fail OM_ERR_USAGE
  ret ac
end

fn om_parse_cli to void
  if lt argcnt 2
    om_fail OM_ERR_USAGE
  end
  ac = ulong argcnt
  k = argread 1 om_abuf 0 4095
  if lt k 1
    om_fail OM_ERR_USAGE
  end
  cl = ulong k
  cmd = ulong 99
  if om_abuf_eq cl om_c_pack
    cmd = ulong 0
  end
  if om_abuf_eq cl om_c_verify
    cmd = ulong 1
  end
  if om_abuf_eq cl om_c_morph
    cmd = ulong 2
  end
  if om_abuf_eq cl om_c_inspect
    cmd = ulong 3
  end
  if om_abuf_eq cl om_c_selftest
    cmd = ulong 4
  end
  if eq cmd 99
    om_fail OM_ERR_USAGE
  end
  put om_cmd 0 cmd
  i = ulong 2
  while lt i ac bound 64
    al = om_read_arg_str i ac
    nxt = om_parse_flag_a al i ac
    if eq nxt 0
      nxt = om_parse_flag_b al i ac
    end
    i = nxt
  end
end

note ---- Subcommand Handlers ----

fn om_cmd_pack to int
  if eq get om_p_out_n 0 0
    om_fail OM_ERR_USAGE
  end
  rc = om_seal_pkg
  if ne rc OM_OK
    om_fail rc
  end
  if not om_write_slice 0 0 get om_pkg_len 0
    om_fail OM_ERR_IO
  end
  if gt get om_p_doir_n 0 0
    if not om_write_slice 3 4 get om_oir_len 0
      om_fail OM_ERR_IO
    end
  end
  if gt get om_p_degp_n 0 0
    if not om_write_slice 4 5 get om_egp_len 0
      om_fail OM_ERR_IO
    end
  end
  om_wrt 1 om_m_pk1
  om_wrt_u64 1 get om_pkg_len 0
  om_wrt 1 om_m_pk2
  om_wrt_u64 1 get om_oir_len 0
  om_wrt 1 om_m_pk3
  om_wrt_u64 1 get om_egp_len 0
  om_wrt 1 om_m_pk4
  om_wrt_u64 1 get om_cfg 10
  om_wrt 1 om_m_pk5
  om_wrt_hex 1 0 8
  om_wrt 1 om_m_nl
  ret 0
end

fn om_cmd_verify to int
  if eq get om_p_in_n 0 0
    om_fail OM_ERR_USAGE
  end
  if not om_read_file 0
    om_fail OM_ERR_IO
  end
  rc = om_verify_pkg_buf
  if ne rc OM_OK
    om_fail rc
  end
  if gt get om_p_doir_n 0 0
    if not om_write_slice 3 4 get om_oir_len 0
      om_fail OM_ERR_IO
    end
  end
  if gt get om_p_degp_n 0 0
    if not om_write_slice 4 5 get om_egp_len 0
      om_fail OM_ERR_IO
    end
  end
  om_wrt 1 om_m_vr
  om_wrt_u64 1 get om_eg_st 0
  om_wrt 1 om_m_vr2
  om_wrt_u64 1 get om_eg_st 1
  om_wrt 1 om_m_vr3
  om_wrt_u64 1 get om_cfg 10
  om_wrt 1 om_m_vr4
  ret 0
end

fn om_cmd_morph to int
  if or eq get om_p_in_n 0 0 eq get om_tgt_n 0 0
    om_fail OM_ERR_USAGE
  end
  if not om_read_file 0
    om_fail OM_ERR_IO
  end
  rc = om_verify_pkg_buf
  if ne rc OM_OK
    om_fail rc
  end
  if ne om_load_chips_path 0
    om_fail OM_ERR_IO
  end
  cid = om_find_tgt
  if ge cid ctCount
    om_fail OM_ERR_TARGET
  end
  sp = om_morph_check_contract cid
  bk = ctBackend cid
  om_emit_backend bk
  if gt get om_p_out_n 0 0
    if not om_write_slice 0 1 get om_out_len 0
      om_fail OM_ERR_IO
    end
  end
  if gt get om_p_cert_n 0 0
    if not om_write_slice 1 2 get om_cert_len 0
      om_fail OM_ERR_IO
    end
  end
  if gt get om_p_ir_n 0 0
    om_emit_osc_ir
    if not om_write_slice 2 3 get om_ir_len 0
      om_fail OM_ERR_IO
    end
  end
  om_wrt 1 om_m_mp1
  ctWriteId 1 cid
  om_wrt 1 om_m_mp2
  ctWriteBackend 1 bk
  om_wrt 1 om_m_mp3
  om_wrt_u64 1 get om_out_len 0
  om_wrt 1 om_m_mp4
  om_wrt_u64 1 sp
  om_wrt 1 om_m_mp5
  om_wrt_u64 1 get om_cfg 10
  om_wrt 1 om_m_mp6
  ret 0
end

fn om_cmd_inspect to int
  if eq get om_p_in_n 0 0
    om_fail OM_ERR_USAGE
  end
  if not om_read_file 0
    om_fail OM_ERR_IO
  end
  rc = om_verify_pkg_buf
  if ne rc OM_OK
    om_fail rc
  end
  om_wrt 1 om_m_in1
  om_wrt_u64 1 get om_cfg 0
  om_wrt 1 om_m_com
  om_wrt_u64 1 get om_cfg 1
  om_wrt 1 om_m_com
  om_wrt_u64 1 get om_cfg 2
  om_wrt 1 om_m_in2
  om_wrt_opname 1 get om_cfg 3
  om_wrt 1 om_m_in3
  om_wrt_opname 1 get om_cfg 4
  om_wrt 1 om_m_in4
  om_wrt_u64 1 get om_cfg 5
  om_wrt 1 om_m_in5
  om_wrt_u64 1 get om_cfg 6
  om_wrt 1 om_m_in6
  om_wrt_u64 1 get om_cfg 7
  om_wrt 1 om_m_in7
  om_wrt_u64 1 get om_cfg 10
  om_wrt 1 om_m_in8
  om_wrt_u64 1 get om_cfg 11
  om_wrt 1 om_m_in9
  om_wrt_u64 1 get om_eg_st 0
  om_wrt 1 om_m_in10
  om_wrt_u64 1 get om_eg_st 1
  om_wrt 1 om_m_in11
  om_wrt_hex 1 0 32
  om_wrt 1 om_m_in12
  om_wrt_hex 1 1 32
  om_wrt 1 om_m_nl
  ret 0
end

note ---- Portable Pure In-Process Self-Test (Spark + MacBook) ----

fn om_st_save_pkg to void
  n = get om_pkg_len 0
  for i ulong n bound 32768
    put om_st_save i get om_pkg i
  end
end

fn om_st_restore_pkg n ulong to void
  for i ulong n bound 32768
    put om_pkg i get om_st_save i
  end
  put om_pkg_len 0 n
end

fn om_st_resign to void
  om_compute_container_sha
  for i ulong 32
    put om_pkg add 96 i get om_csha i
  end
  om_ed_sign_hdr 128
end

fn om_st_fail step ulong to int
  om_wrt 2 om_m_st_bad
  om_wrt_u64 2 step
  om_wrt 2 om_m_nl
  ret int step
end

fn om_st_morph_one tgt view uchar * minBytes ulong to bool
  cid = ctFindChip tgt len tgt
  if ge cid ctCount
    ret false
  end
  sp = om_morph_check_contract cid
  if eq sp 999
    ret false
  end
  om_emit_backend ctBackend cid
  ret ge get om_out_len 0 minBytes
end

fn om_st_write_dir suf view uchar * bufkind ulong n ulong to void
  if eq get om_p_dir_n 0 0
    ret
  end
  dn = get om_p_dir_n 0
  for i ulong dn bound 2048
    put om_p_out i get om_p_dir i
  end
  for j ulong len suf bound 256
    put om_p_out add dn j get suf j
  end
  put om_p_out_n 0 add dn len suf
  ign = om_write_slice 0 bufkind n
end

fn om_st_build_raw_pkg to void
  om_build_oir_v2
  om_compute_sem_id
  om_build_egp3
  on = get om_oir_len 0
  en = get om_egp_len 0
  tot = add OM_HDR_LEN add on en
  put om_pkg_len 0 tot
  om_pkg_put_u32 16 get om_cfg 10
  om_pkg_put_u32 56 on
  om_pkg_put_u32 60 en
  for i ulong 32
    put om_pkg add 64 i get om_sem i
  end
  for i ulong on bound 8192
    put om_pkg add OM_HDR_LEN i get om_oir i
  end
  eoff = add OM_HDR_LEN on
  for i ulong en bound 16384
    put om_pkg add eoff i get om_egp i
  end
  om_st_resign
end

fn om_st_check_negs n ulong to int
  om_st_restore_pkg n
  put om_pkg 160 xor get om_pkg 160 uchar 1
  if ne om_verify_pkg_buf OM_ERR_ED25519
    ret om_st_fail 21
  end
  om_st_restore_pkg n
  put om_pkg sub n 1 xor get om_pkg sub n 1 uchar 1
  if ne om_verify_pkg_buf OM_ERR_SHA256
    ret om_st_fail 22
  end
  om_st_restore_pkg n
  put om_pkg 64 xor get om_pkg 64 uchar 1
  om_st_resign
  if ne om_verify_pkg_buf OM_ERR_SEM_ID
    ret om_st_fail 23
  end
  om_st_restore_pkg n
  eoff = add OM_HDR_LEN om_pkg_u32 56
  t_off = add eoff 388
  put om_pkg t_off uchar 99
  om_st_resign
  if ne om_verify_pkg_buf OM_ERR_EGP3
    ret om_st_fail 24
  end
  om_st_restore_pkg n
  put om_pkg 12 uchar 88
  om_st_resign
  if ne om_verify_pkg_buf OM_ERR_OM3
    ret om_st_fail 25
  end
  put om_cfg 10 85000
  if ne om_seal_pkg OM_ERR_WATTCBF
    put om_cfg 10 15000
    ret om_st_fail 26
  end
  om_st_restore_pkg n
  put om_cfg 10 85000
  om_st_build_raw_pkg
  put om_cfg 10 15000
  if ne om_verify_pkg_buf OM_ERR_WATTCBF
    ret om_st_fail 28
  end
  om_st_restore_pkg n
  put om_pkg n uchar 0
  put om_pkg_len 0 add n 1
  if ne om_verify_pkg_buf OM_ERR_FORMAT
    ret om_st_fail 27
  end
  ret 0
end

fn om_st_check_targets n ulong to int
  om_st_restore_pkg n
  if not om_st_morph_one om_tgt_arm 120
    ret om_st_fail 10
  end
  if not om_st_morph_one om_tgt_mac 32808
    ret om_st_fail 11
  end
  om_st_write_dir om_sf_mac 1 get om_out_len 0
  if not om_st_morph_one om_tgt_x64 120
    ret om_st_fail 12
  end
  if not om_st_morph_one om_tgt_rv 120
    ret om_st_fail 13
  end
  if not om_st_morph_one om_tgt_wasm 50
    ret om_st_fail 14
  end
  om_st_write_dir om_sf_wasm 1 get om_out_len 0
  if not om_st_morph_one om_tgt_spv 700
    ret om_st_fail 15
  end
  om_st_write_dir om_sf_spv 1 get om_out_len 0
  if not om_st_morph_one om_tgt_xe 112
    ret om_st_fail 16
  end
  if not om_st_morph_one om_tgt_sm 512
    ret om_st_fail 17
  end
  ret 0
end

fn om_st_check_contracts to int
  cid_sm = ctFindChip om_tgt_sm len om_tgt_sm
  cid_x64 = ctFindChip om_tgt_x64 len om_tgt_x64
  if or ge cid_sm ctCount ge cid_x64 ctCount
    ret om_st_fail 30
  end
  if ne ctCheckRecipe cid_sm 200000 3 64 0 0 TDK_ERR_SMEM
    ret om_st_fail 31
  end
  if ne ctCheckRecipe cid_x64 0 20 64 0 0 TDK_ERR_REGS
    ret om_st_fail 32
  end
  if ne ctCheckRecipe cid_sm 0 3 32768 0 0 CT_ERR_L2
    ret om_st_fail 33
  end
  tlen = get ct_tsv_len 0
  for i ulong len om_fut_row bound 256
    put ct_tsv add tlen i get om_fut_row i
  end
  put ct_tsv_len 0 add tlen len om_fut_row
  if ne ct_parse_tsv 0
    ret om_st_fail 34
  end
  cid_fut = ctFindChip om_fut_id len om_fut_id
  if ge cid_fut ctCount
    ret om_st_fail 35
  end
  if ne ctCheckRecipe cid_fut 200000 3 64 0 0 TDK_OK
    ret om_st_fail 36
  end
  if ne ctCheckRecipe cid_fut 300000 3 64 0 0 TDK_ERR_SMEM
    ret om_st_fail 37
  end
  om_emit_backend ctBackend cid_fut
  if lt get om_out_len 0 112
    ret om_st_fail 38
  end
  ret 0
end

fn om_cmd_selftest to int
  if ne om_load_chips_path 0
    om_fail OM_ERR_IO
  end
  if ne om_seal_pkg OM_OK
    ret om_st_fail 1
  end
  n1 = get om_pkg_len 0
  om_st_save_pkg
  if ne om_seal_pkg OM_OK
    ret om_st_fail 2
  end
  if ne get om_pkg_len 0 n1
    ret om_st_fail 3
  end
  for i ulong n1 bound 32768
    if ne get om_pkg i get om_st_save i
      ret om_st_fail 4
    end
  end
  if ne om_verify_pkg_buf OM_OK
    ret om_st_fail 5
  end
  rc = om_st_check_targets n1
  if ne rc 0
    ret rc
  end
  rc2 = om_st_check_negs n1
  if ne rc2 0
    ret rc2
  end
  rc3 = om_st_check_contracts
  if ne rc3 0
    ret rc3
  end
  om_wrt 1 om_m_st_ok
  ret 0
end

fn main to int
  tdInitAll
  isInitRules
  tdCacheInit
  om_init_defaults
  om_parse_cli
  cmd = get om_cmd 0
  if eq cmd 0
    ret om_cmd_pack
  end
  if eq cmd 1
    ret om_cmd_verify
  end
  if eq cmd 2
    ret om_cmd_morph
  end
  if eq cmd 3
    ret om_cmd_inspect
  end
  ret om_cmd_selftest
end

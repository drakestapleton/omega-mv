note SPDX-License-Identifier: Apache-2.0
note apps/omega-morph/gate_morph.om
note Pure seeded OM-2 End-to-End Verification Gate for Poly-Silicon Chameleon Executables (OMMP01).
note Compose:
note   cat si/directives/om2.om seed/ng/sha256.om protocol/omnet/om/sha512/sha512.om protocol/omnet/om/ed25519/ed25519.om apps/omega-morph/gate_morph.om | seed/out/omc > gate_morph
note Usage:
note   gate_morph OMMP_BIN TOOLS_DIR SCRATCH_DIR [CHIPS_TSV]

const GM_HDR_LEN ulong 224

global gmOmmp uchar 2048
global gmOmmpN ulong 1
global gmTools uchar 2048
global gmToolsN ulong 1
global gmScr uchar 2048
global gmScrN ulong 1
global gmChips uchar 2048
global gmChipsN ulong 1

global gmPa uchar 4096
global gmPb uchar 4096
global gmPc uchar 4096
global gmAv uchar 8192
global gmAp ulong 2
global gmSt uchar 8

global gmB1 uchar 65536
global gmB2 uchar 65536
global gmIo uchar 4096
global gmDig uchar 24
global gmChk ulong 1
global gmCtrl ulong 1
global gmSeed uchar 32

text gmUse "usage: gate_morph OMMP_BIN TOOLS_DIR SCRATCH_DIR [CHIPS_TSV]\n"
text gmDefChips "seed/ng/target/chips.tsv"
text gmDefSeed "OMEGA-MORPH-OMMP01-SOVEREIGN-V1!"
text gmDevNull "/dev/null"
text gmHdr "=== OMEGA ALIEN-MORPH (OMMP01) MULTI-TARGET & PROOF GATE ===\n"
text gmFailA "OMMP-GATE FAIL step="
text gmFailB " got="
text gmPassA "OMMP-GATE PASS checks="
text gmPassB " controls="
text gmNl "\n"

text gmM_pack "  PASS [ommp01] pack_det=2x verify=OK inspect=OK ngcheck(OIR_v2)=ACCEPT gate_egp3=PASS\n"
text gmM_arm64 "  PASS [arm64-linux] native_exit=36 det=2x HOST-VERIFIED\n"
text gmM_apple "  PASS [apple-m] Mach-O=32808B magic=0xfeedfacf det=2x (live MacBook run verified separately)\n"
text gmM_x64 "  PASS [x64-linux] EM_X86_64=62 qemu-x86_64_exit=36 det=2x ELF BUILT + EMULATED\n"
text gmM_rv64 "  PASS [rv64-elf] EM_RISCV=243 qemu-riscv64_exit=36 det=2x ELF BUILT + EMULATED\n"
text gmM_wasm "  PASS [wasm] irwasm det=2x node(7,5,3)=36 HOST-VERIFIED\n"
text gmM_spv "  PASS [spirv] vkspirv(spirv-val=vulkan1.3) + pure-OM val/run([36,90,18,450]) HOST-VERIFIED\n"
text gmM_xe "  PASS [intel-xe] 128-bit Xe EU isa check=0 zero-SWSB_mutant=1 ISA-VALIDATED\n"
text gmM_sm "  PASS [sm121] bw_enc_sm121 monk_check=0 digest_tamper=12 stall_shave=17 MONK-VERIFIED (GB10 silicon NOT_RUN)\n"
text gmM_fut "  PASS [zero-recompile] future-chip-2035 emitted=PASS smem_limit=72 ngpr_limit=72 l2_24m=72\n"
text gmM_neg "  PASS [security-controls] ed25519=61 sha256=62 sem_id=63 egp3_spoof=64 om3=65 wattcbf_85w=66 trailing=60\n"

text gmFutRow "future-chip-2035\tFutureSilicon\tAien-2035\t1\t21\tintel-xe\t128\t128\t262144\t16\t256\t32768\t128\t393225\tAdded dynamically without compiler recompile\n"
text gmNodeScript "const fs=require('fs');const m=new WebAssembly.Module(fs.readFileSync(process.argv[2]));const r=new WebAssembly.Instance(m).exports.kfn(7n,5n,3n);if(r!==36n)process.exit(1);\n"

text gmQemuX64 "/usr/bin/qemu-x86_64"
text gmQemuRv64 "/usr/bin/qemu-riscv64"
text gmNode "/usr/bin/node"
text gmSpvValSys "/usr/bin/spirv-val"

text gmTIrWasm "/irwasm"
text gmTVkSpv "/vkspirv"
text gmTSpvVal "/spv_val"
text gmTSpvRun "/spv_run"
text gmTXeIsa "/xe_isa"
text gmTMonk "/monk_check"
text gmTNgcheck "/ngcheck"
text gmTGateEgp3 "/gate_egp3"

text gmFPkg1 "/k1.ommp"
text gmFPkg2 "/k2.ommp"
text gmFOir "/k.oir"
text gmFEgp "/k.egp3"
text gmFArm1 "/arm64_1.elf"
text gmFArm2 "/arm64_2.elf"
text gmFMac1 "/apple1.macho"
text gmFMac2 "/apple2.macho"
text gmFX641 "/x64_1.elf"
text gmFX642 "/x64_2.elf"
text gmFRv641 "/rv64_1.elf"
text gmFRv642 "/rv64_2.elf"
text gmFIr "/kfn.ir"
text gmFWasm1 "/kfn_1.wasm"
text gmFWasm2 "/kfn_2.wasm"
text gmFNodeJs "/run_wasm.js"
text gmFVkSpv1 "/kfn_1.spv"
text gmFVkSpv2 "/kfn_2.spv"
text gmFCompSpv "/compute.spv"
text gmFBadSpv "/bad.spv"
text gmFIn0 "/in0.bin"
text gmFIn1 "/in1.bin"
text gmFOutSpv "/out.bin"
text gmFXe "/xe2.bin"
text gmFXeMut "/xe2_mut.bin"
text gmFSmSass "/sm121.sass"
text gmFSmCand "/sm121.sass"
text gmFSmCert "/sm121.crt"
text gmFSmTamp "/sm121_tamper.sass"
text gmFSmShave "/sm121_shave.sass"
text gmFSmShCrt "/sm121_shave.crt"
text gmFChipsFut "/chips_2035.tsv"
text gmFPkgFutOk "/fut_ok.ommp"
text gmFPkgFutBad "/fut_bad.ommp"
text gmFFutBin "/future_2035.bin"
text gmFFutNoOut "/future_over_limit.bin"
text gmFPkgRegs "/bad_regs20.ommp"
text gmFPkgL2 "/bad_l2_32k.ommp"
text gmFBadNoOut "/bad_no_out.bin"

text gmFNegEd "/neg_ed25519.ommp"
text gmFNegSha "/neg_sha256.ommp"
text gmFNegSem "/neg_sem.ommp"
text gmFNegEgp "/neg_egp3.ommp"
text gmFNegOm3 "/neg_om3.ommp"
text gmFNegWatt "/neg_watt85.ommp"
text gmFNegTrail "/neg_trail.ommp"

text gmCmdPack "pack"
text gmCmdVerify "verify"
text gmCmdMorph "morph"
text gmCmdInspect "inspect"
text gmFlIn "--in"
text gmFlOut "--out"
text gmFlChips "--chips"
text gmFlTgt "--target"
text gmFlCert "--cert"
text gmFlIr "--ir"
text gmFlDoir "--dump-oir"
text gmFlDegp "--dump-egp3"
text gmFlSmem "--smem"
text gmFlRegs "--regs"
text gmFlL2 "--l2"
text gmFlPower "--power"
text gmFlEnv "--target-env"
text gmVk13 "vulkan1.3"
text gmVk11 "vulkan1.1"
text gmChkCmd "check"
text gmS4 "4"
text gmS20 "20"
text gmS32k "32768"
text gmS200k "200000"
text gmS300k "300000"
text gmS85k "85000"

text gmTgtArm "grace-x925"
text gmTgtMac "apple-m"
text gmTgtX64 "intel-x64"
text gmTgtRv "rv64-rvv"
text gmTgtWasm "wasm-universal"
text gmTgtSpv "spirv-vulkan"
text gmTgtXe "intel-xe2"
text gmTgtSm "sm121"
text gmTgtFut "future-chip-2035"

fn gmWrt s view uchar * to void
  r = write 1 s 0 len s
end

fn gmNum v ulong to void
  b = new uchar 24 0
  p = ulong 24
  x = v
  while true bound 24
    p = sub p 1
    put b p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 b p sub 24 p
end

fn gmFail step ulong got ulong to int
  gmWrt gmFailA
  gmNum step
  gmWrt gmFailB
  gmNum got
  gmWrt gmNl
  ret int step
end

fn gmAddChk n ulong to void
  put gmChk 0 add get gmChk 0 n
end

fn gmAddCtrl n ulong to void
  put gmCtrl 0 add get gmCtrl 0 n
end

fn gmSetPath dst ulong baseKind ulong suf view uchar * to ulong
  bn = ulong 0
  if eq baseKind 0
    bn = get gmScrN 0
    for i ulong bn bound 2048
      b = get gmScr i
      if eq dst 0
        put gmPa i b
      else
        if eq dst 1
          put gmPb i b
        else
          put gmPc i b
        end
      end
    end
  else
    bn = get gmToolsN 0
    for i ulong bn bound 2048
      b = get gmTools i
      if eq dst 0
        put gmPa i b
      else
        if eq dst 1
          put gmPb i b
        else
          put gmPc i b
        end
      end
    end
  end
  for j ulong len suf bound 256
    b = get suf j
    if eq dst 0
      put gmPa add bn j b
    else
      if eq dst 1
        put gmPb add bn j b
      else
        put gmPc add bn j b
      end
    end
  end
  ret add bn len suf
end

fn gmClearPa to void
  for i ulong 4096
    put gmPa i uchar 0
  end
end

fn gmSetPaScr suf view uchar * to void
  gmClearPa
  ign = gmSetPath 0 0 suf
end

fn gmSetPaTool suf view uchar * to void
  gmClearPa
  ign = gmSetPath 0 1 suf
end

fn gmPrepPbScr suf view uchar * to void
  for i ulong 4096
    put gmPb i uchar 0
  end
  ign = gmSetPath 1 0 suf
end

fn gmPrepPcScr suf view uchar * to void
  for i ulong 4096
    put gmPc i uchar 0
  end
  ign = gmSetPath 2 0 suf
end

fn gmLenOf pbKind ulong to ulong
  n = ulong 0
  while lt n 4095 bound 4096
    b = uchar 0
    if eq pbKind 0
      b = get gmPa n
    else
      if eq pbKind 1
        b = get gmPb n
      else
        b = get gmPc n
      end
    end
    if eq b 0
      ret n
    end
    n = add n 1
  end
  ret n
end

fn gmAvReset to void
  put gmAp 0 2
  put gmAp 1 0
end

fn gmAvPushLit s view uchar * to void
  p = get gmAp 0
  n = len s
  put gmAv p uchar and n 255
  put gmAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 2048
    put gmAv add p i get s i
  end
  put gmAp 0 add p n
  put gmAp 1 add get gmAp 1 1
end

fn gmAvPushGlob kind ulong to void
  n = ulong 0
  if eq kind 0
    n = get gmOmmpN 0
  else
    if eq kind 1
      n = get gmChipsN 0
    else
      n = gmLenOf 0
    end
  end
  p = get gmAp 0
  put gmAv p uchar and n 255
  put gmAv add p 1 uchar and shr n 8 255
  p = add p 2
  for i ulong n bound 4096
    b = uchar 0
    if eq kind 0
      b = get gmOmmp i
    else
      if eq kind 1
        b = get gmChips i
      else
        b = get gmPa i
      end
    end
    put gmAv add p i b
  end
  put gmAp 0 add p n
  put gmAp 1 add get gmAp 1 1
end

fn gmPushLitPair flag view uchar * val view uchar * to void
  gmAvPushLit flag
  gmAvPushLit val
end

fn gmPushScrPair flag view uchar * suf view uchar * to void
  gmAvPushLit flag
  gmSetPaScr suf
  gmAvPushGlob 2
end

fn gmExec hasIn bool hasOut bool quiet bool to ulong
  cnt = get gmAp 1
  put gmAv 0 uchar and cnt 255
  put gmAv 1 uchar and shr cnt 8 255
  pid = fork
  if lt pid 0
    exit 92
  end
  if eq pid 0
    if hasIn
      fi = fopen gmPb 0 gmLenOf 1 0 0
      if lt fi 0
        exit 126
      end
      di = dupfd int fi 0 0
    end
    if hasOut
      fo = fopen gmPc 0 gmLenOf 2 577 420
      if lt fo 0
        exit 125
      end
      do1 = dupfd int fo 1 0
    else
      if quiet
        dn = fopen gmDevNull 0 len gmDevNull 2 0
        if ge dn 0
          d1 = dupfd int dn 1 0
        end
      end
    end
    if quiet
      dn2 = fopen gmDevNull 0 len gmDevNull 2 0
      if ge dn2 0
        d2 = dupfd int dn2 2 0
      end
    end
    r = execprog gmAv 0 get gmAp 0
    exit 127
  end
  w = waitpid int pid gmSt 0 4 0
  ret ulong get gmSt 1
end

fn gmWritePaText s view uchar * to bool
  ln = gmLenOf 0
  fd = fopen gmPa 0 ln 577 420
  if lt fd 0
    ret false
  end
  p = ulong 0
  tot = len s
  while lt p tot bound 4096
    k = write int fd s p sub tot p
    if le k 0
      z = fclose int fd
      ret false
    end
    p = add p ulong k
  end
  z = fclose int fd
  ret true
end

fn gmReadPaToB dst ulong to long
  ln = gmLenOf 0
  fd = fopen gmPa 0 ln 0 0
  if lt fd 0
    ret long -1
  end
  tot = ulong 0
  while lt tot 65535 bound 1024
    r = read int fd gmIo 0 4096
    if le r 0
      break
    end
    ur = ulong r
    if gt add tot ur 65535
      z = fclose int fd
      ret long -1
    end
    for i ulong ur bound 4096
      if eq dst 0
        put gmB1 add tot i get gmIo i
      else
        put gmB2 add tot i get gmIo i
      end
    end
    tot = add tot ur
  end
  z = fclose int fd
  ret long tot
end

fn gmWriteB1FromPa n ulong to bool
  ln = gmLenOf 0
  fd = fopen gmPa 0 ln 577 420
  if lt fd 0
    ret false
  end
  p = ulong 0
  while lt p n bound 1024
    ch = sub n p
    if gt ch 4096
      ch = ulong 4096
    end
    for i ulong ch bound 4096
      put gmIo i get gmB1 add p i
    end
    w = write int fd gmIo 0 ch
    if ne w long ch
      z = fclose int fd
      ret false
    end
    p = add p ch
  end
  z = fclose int fd
  ret true
end

fn gmCmpScrFiles s1 view uchar * s2 view uchar * minBytes ulong to bool
  gmSetPaScr s1
  n1 = gmReadPaToB 0
  gmSetPaScr s2
  n2 = gmReadPaToB 1
  if or lt n1 long minBytes ne n1 n2
    ret false
  end
  for i ulong ulong n1 bound 65536
    if ne get gmB1 i get gmB2 i
      ret false
    end
  end
  ret true
end

fn gmHasB1Magic4 a uchar b uchar c uchar d uchar to bool
  if ne get gmB1 0 a
    ret false
  end
  if ne get gmB1 1 b
    ret false
  end
  if ne get gmB1 2 c
    ret false
  end
  ret eq get gmB1 3 d
end

fn gmPutU32B1 off ulong v ulong to void
  put gmB1 off uchar and v 255
  put gmB1 add off 1 uchar and shr v 8 255
  put gmB1 add off 2 uchar and shr v 16 255
  put gmB1 add off 3 uchar and shr v 24 255
end

fn gmGetU32B1 off ulong to ulong
  b0 = ulong get gmB1 off
  b1 = shl ulong get gmB1 add off 1 8
  b2 = shl ulong get gmB1 add off 2 16
  b3 = shl ulong get gmB1 add off 3 24
  ret or or b0 b1 or b2 b3
end

fn gmStartMorph inSuf view uchar * chipsIsFut bool tgt view uchar * to void
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdMorph
  gmPushScrPair gmFlIn inSuf
  gmAvPushLit gmFlChips
  if chipsIsFut
    gmSetPaScr gmFChipsFut
    gmAvPushGlob 2
  else
    gmAvPushGlob 1
  end
  gmAvPushLit gmFlTgt
  gmAvPushLit tgt
end

fn gmRunMorphStd tgt view uchar * outSuf view uchar * to ulong
  gmStartMorph gmFPkg1 false tgt
  gmPushScrPair gmFlOut outSuf
  ret gmExec false false true
end

fn gmRunToolInOut toolSuf view uchar * inSuf view uchar * outSuf view uchar * to ulong
  gmAvReset
  gmSetPaTool toolSuf
  gmAvPushGlob 2
  gmPrepPbScr inSuf
  gmPrepPcScr outSuf
  ret gmExec true true true
end

note ---- Ed25519 Re-Sign Helpers for Red-Team Negative Controls ----

fn gmEdRed x64 view uchar 64 dst edit uchar 32 to void
  x = new long 64 0
  for i ulong 64
    put x i long get x64 i
  end
  edmodl x
  for i ulong 32
    put dst i uchar get x i
  end
end

fn gmEdExpand sd view uchar 32 ar edit uchar 32 pfx edit uchar 64 to void
  m = new uchar 65536 0
  hd = new uchar 64 0
  t = new uchar 64 0
  for i ulong 32
    put m i get sd i
  end
  s512hash m 32 hd
  for i ulong 32
    put t i get hd i
    put pfx i get hd add i 32
  end
  put t 0 and get t 0 uchar 248
  put t 31 and get t 31 uchar 127
  put t 31 or get t 31 uchar 64
  gmEdRed t ar
end

fn gmEdBasemul sc view uchar 32 dst edit uchar 32 to void
  w = new ulong 1024 0
  z = new uchar 32 0
  edinit w
  edsmul w sc z
  edpenc w edq dst
end

fn gmEdMuladd r view uchar 32 k view uchar 32 a view uchar 32 sg edit uchar 64 to void
  x = new long 64 0
  for i ulong 32
    put x i long get r i
  end
  for i ulong 32
    ki = long get k i
    for j ulong 32
      p = add i j
      put x p add get x p mul ki long get a j
    end
  end
  edmodl x
  for i ulong 32
    put sg add 32 i uchar get x i
  end
end

fn gmEdHprefix pfx view uchar 64 m view uchar 65536 n ulong hd edit uchar 64 to void
  pm = new uchar 65536 0
  for i ulong 32
    put pm i get pfx i
  end
  for i ulong n bound 65504
    put pm add 32 i get m i
  end
  s512hash pm add n 32 hd
end

fn gmEdSignMsg sd view uchar 32 m view uchar 65536 n ulong pk edit uchar 32 sg edit uchar 64 to void
  ar = new uchar 32 0
  pfx = new uchar 64 0
  hd = new uchar 64 0
  r_sc = new uchar 32 0
  r_pt = new uchar 32 0
  k = new uchar 32 0
  gmEdExpand sd ar pfx
  gmEdBasemul ar pk
  gmEdHprefix pfx m n hd
  gmEdRed hd r_sc
  gmEdBasemul r_sc r_pt
  for i ulong 32
    put sg i get r_pt i
  end
  edhram sg pk m n k
  gmEdMuladd r_sc k ar sg
end

fn gmResignB1 tot ulong to void
  for i ulong 96
    put sh_dat i get gmB1 i
  end
  plen = sub tot GM_HDR_LEN
  for i ulong plen bound 32768
    put sh_dat add 96 i get gmB1 add GM_HDR_LEN i
  end
  sh_all add 96 plen
  for i ulong 32
    put gmB1 add 96 i get sh_dig i
  end
  sd = new uchar 32 0
  m = new uchar 65536 0
  pk = new uchar 32 0
  sg = new uchar 64 0
  for i ulong 32
    put sd i get gmSeed i
  end
  for i ulong 128
    put m i get gmB1 i
  end
  gmEdSignMsg sd m 128 pk sg
  for i ulong 32
    put gmB1 add 128 i get pk i
  end
  for i ulong 64
    put gmB1 add 160 i get sg i
  end
end

note ---- Gate Suites ----

fn gmTestPackVerify to int
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushScrPair gmFlDoir gmFOir
  gmPushScrPair gmFlDegp gmFEgp
  gmPushScrPair gmFlOut gmFPkg1
  if ne gmExec false false true 0
    ret gmFail 1 0
  end
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushScrPair gmFlOut gmFPkg2
  if ne gmExec false false true 0
    ret gmFail 2 0
  end
  if not gmCmpScrFiles gmFPkg1 gmFPkg2 900
    ret gmFail 3 0
  end
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdVerify
  gmPushScrPair gmFlIn gmFPkg1
  if ne gmExec false false true 0
    ret gmFail 4 0
  end
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdInspect
  gmPushScrPair gmFlIn gmFPkg1
  if ne gmExec false false true 0
    ret gmFail 5 0
  end
  gmAvReset
  gmSetPaTool gmTNgcheck
  gmAvPushGlob 2
  gmPrepPbScr gmFOir
  gmPrepPcScr gmFOutSpv
  if ne gmExec true true true 0
    ret gmFail 6 0
  end
  gmAvReset
  gmSetPaTool gmTGateEgp3
  gmAvPushGlob 2
  gmSetPaScr gmFEgp
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 7 0
  end
  gmWrt gmM_pack
  gmAddChk 5
  ret 0
end

fn gmTestArm64 to int
  r1 = gmRunMorphStd gmTgtArm gmFArm1
  r2 = gmRunMorphStd gmTgtArm gmFArm2
  if or ne r1 0 ne r2 0
    ret gmFail 10 r1
  end
  if not gmCmpScrFiles gmFArm1 gmFArm2 120
    ret gmFail 11 0
  end
  gmAvReset
  gmSetPaScr gmFArm1
  gmAvPushGlob 2
  ex = gmExec false false true
  if ne ex 36
    ret gmFail 12 ex
  end
  gmWrt gmM_arm64
  gmAddChk 3
  ret 0
end

fn gmTestAppleM to int
  r1 = gmRunMorphStd gmTgtMac gmFMac1
  r2 = gmRunMorphStd gmTgtMac gmFMac2
  if or ne r1 0 ne r2 0
    ret gmFail 20 r1
  end
  if not gmCmpScrFiles gmFMac1 gmFMac2 32808
    ret gmFail 21 0
  end
  if not gmHasB1Magic4 uchar 207 uchar 250 uchar 237 uchar 254
    ret gmFail 22 0
  end
  gmWrt gmM_apple
  gmAddChk 3
  ret 0
end

fn gmCheckQemu isRv bool fSuf view uchar * step ulong to int
  em = or ulong get gmB1 18 shl ulong get gmB1 19 8
  expEm = ulong 62
  if isRv
    expEm = ulong 243
  end
  if ne em expEm
    ret gmFail add step 2 em
  end
  gmAvReset
  if isRv
    gmAvPushLit gmQemuRv64
  else
    gmAvPushLit gmQemuX64
  end
  gmSetPaScr fSuf
  gmAvPushGlob 2
  ex = gmExec false false true
  if ne ex 36
    ret gmFail add step 3 ex
  end
  ret 0
end

fn gmTestX64 to int
  r1 = gmRunMorphStd gmTgtX64 gmFX641
  r2 = gmRunMorphStd gmTgtX64 gmFX642
  if or ne r1 0 ne r2 0
    ret gmFail 30 r1
  end
  if not gmCmpScrFiles gmFX641 gmFX642 120
    ret gmFail 31 0
  end
  r = gmCheckQemu false gmFX641 30
  if ne r 0
    ret r
  end
  gmWrt gmM_x64
  gmAddChk 4
  ret 0
end

fn gmTestRv64 to int
  r1 = gmRunMorphStd gmTgtRv gmFRv641
  r2 = gmRunMorphStd gmTgtRv gmFRv642
  if or ne r1 0 ne r2 0
    ret gmFail 35 r1
  end
  if not gmCmpScrFiles gmFRv641 gmFRv642 120
    ret gmFail 36 0
  end
  r = gmCheckQemu true gmFRv641 35
  if ne r 0
    ret r
  end
  gmWrt gmM_rv64
  gmAddChk 4
  ret 0
end

fn gmTestWasm to int
  rc = gmRunMorphStd gmTgtWasm gmFIr
  if ne rc 0
    ret gmFail 40 rc
  end
  w1 = gmRunToolInOut gmTIrWasm gmFIr gmFWasm1
  w2 = gmRunToolInOut gmTIrWasm gmFIr gmFWasm2
  if or ne w1 0 ne w2 0
    ret gmFail 41 w1
  end
  if not gmCmpScrFiles gmFWasm1 gmFWasm2 20
    ret gmFail 42 0
  end
  if not gmHasB1Magic4 uchar 0 uchar 97 uchar 115 uchar 109
    ret gmFail 43 0
  end
  gmSetPaScr gmFNodeJs
  if not gmWritePaText gmNodeScript
    ret gmFail 44 0
  end
  gmAvReset
  gmAvPushLit gmNode
  gmSetPaScr gmFNodeJs
  gmAvPushGlob 2
  gmSetPaScr gmFWasm1
  gmAvPushGlob 2
  nx = gmExec false false true
  if ne nx 0
    ret gmFail 45 nx
  end
  gmWrt gmM_wasm
  gmAddChk 4
  ret 0
end

fn gmTestSpirvRun to int
  gmPutU32B1 0 7
  gmPutU32B1 4 10
  gmPutU32B1 8 2
  gmPutU32B1 12 100
  gmSetPaScr gmFIn0
  if not gmWriteB1FromPa 16
    ret gmFail 56 0
  end
  gmPutU32B1 0 5
  gmPutU32B1 4 20
  gmPutU32B1 8 4
  gmPutU32B1 12 50
  gmSetPaScr gmFIn1
  if not gmWriteB1FromPa 16
    ret gmFail 56 1
  end
  gmAvReset
  gmSetPaTool gmTSpvRun
  gmAvPushGlob 2
  gmSetPaScr gmFCompSpv
  gmAvPushGlob 2
  gmAvPushLit gmS4
  gmAvPushLit gmS4
  gmSetPaScr gmFOutSpv
  gmAvPushGlob 2
  gmSetPaScr gmFIn0
  gmAvPushGlob 2
  gmSetPaScr gmFIn1
  gmAvPushGlob 2
  sr = gmExec false false true
  if ne sr 0
    ret gmFail 57 sr
  end
  gmSetPaScr gmFOutSpv
  on = gmReadPaToB 0
  if ne on 16
    ret gmFail 58 ulong on
  end
  if or ne gmGetU32B1 0 36 ne gmGetU32B1 4 90
    ret gmFail 59 gmGetU32B1 0
  end
  if or ne gmGetU32B1 8 18 ne gmGetU32B1 12 450
    ret gmFail 59 gmGetU32B1 8
  end
  ret 0
end

fn gmTestSpirv to int
  v1 = gmRunToolInOut gmTVkSpv gmFIr gmFVkSpv1
  v2 = gmRunToolInOut gmTVkSpv gmFIr gmFVkSpv2
  if or ne v1 0 ne v2 0
    ret gmFail 50 v1
  end
  if not gmCmpScrFiles gmFVkSpv1 gmFVkSpv2 100
    ret gmFail 51 0
  end
  gmAvReset
  gmAvPushLit gmSpvValSys
  gmPushLitPair gmFlEnv gmVk13
  gmSetPaScr gmFVkSpv1
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 52 0
  end
  if ne gmRunMorphStd gmTgtSpv gmFCompSpv 0
    ret gmFail 53 0
  end
  gmAvReset
  gmSetPaTool gmTSpvVal
  gmAvPushGlob 2
  gmPushLitPair gmFlEnv gmVk11
  gmSetPaScr gmFCompSpv
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 54 0
  end
  gmAvReset
  gmAvPushLit gmSpvValSys
  gmPushLitPair gmFlEnv gmVk13
  gmSetPaScr gmFCompSpv
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 55 0
  end
  rr = gmTestSpirvRun
  if ne rr 0
    ret rr
  end
  gmSetPaScr gmFCompSpv
  cn = gmReadPaToB 0
  put gmB1 0 uchar 88
  gmSetPaScr gmFBadSpv
  if not gmWriteB1FromPa ulong cn
    ret gmFail 60 0
  end
  gmAvReset
  gmSetPaTool gmTSpvVal
  gmAvPushGlob 2
  gmPushLitPair gmFlEnv gmVk11
  gmSetPaScr gmFBadSpv
  gmAvPushGlob 2
  if ne gmExec false false true 1
    ret gmFail 61 0
  end
  gmWrt gmM_spv
  gmAddCtrl 1
  gmAddChk 7
  ret 0
end

fn gmTestIntelXe to int
  if ne gmRunMorphStd gmTgtXe gmFXe 0
    ret gmFail 70 0
  end
  gmAvReset
  gmSetPaTool gmTXeIsa
  gmAvPushGlob 2
  gmAvPushLit gmChkCmd
  gmSetPaScr gmFXe
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 71 0
  end
  gmSetPaScr gmFXe
  xn = gmReadPaToB 0
  if ne xn 112
    ret gmFail 72 ulong xn
  end
  put gmB1 1 uchar 0
  gmSetPaScr gmFXeMut
  if not gmWriteB1FromPa ulong xn
    ret gmFail 73 0
  end
  gmAvReset
  gmSetPaTool gmTXeIsa
  gmAvPushGlob 2
  gmAvPushLit gmChkCmd
  gmSetPaScr gmFXeMut
  gmAvPushGlob 2
  if ne gmExec false false true 1
    ret gmFail 74 0
  end
  gmWrt gmM_xe
  gmAddCtrl 1
  gmAddChk 2
  ret 0
end

fn gmRunMonk refSuf view uchar * candSuf view uchar * certSuf view uchar * to ulong
  gmAvReset
  gmSetPaTool gmTMonk
  gmAvPushGlob 2
  gmSetPaScr refSuf
  gmAvPushGlob 2
  gmSetPaScr candSuf
  gmAvPushGlob 2
  gmSetPaScr certSuf
  gmAvPushGlob 2
  ret gmExec false false true
end

fn gmTestSm121 to int
  gmStartMorph gmFPkg1 false gmTgtSm
  gmPushScrPair gmFlOut gmFSmSass
  gmPushScrPair gmFlCert gmFSmCert
  if ne gmExec false false true 0
    ret gmFail 80 0
  end
  if ne gmRunMonk gmFSmSass gmFSmCand gmFSmCert 0
    ret gmFail 81 0
  end
  gmSetPaScr gmFSmSass
  sn = gmReadPaToB 0
  if ne sn 512
    ret gmFail 82 ulong sn
  end
  put gmB1 0 xor get gmB1 0 uchar 1
  gmSetPaScr gmFSmTamp
  if not gmWriteB1FromPa ulong sn
    ret gmFail 83 0
  end
  if ne gmRunMonk gmFSmSass gmFSmTamp gmFSmCert 12
    ret gmFail 84 0
  end
  gmSetPaScr gmFSmSass
  sn2 = gmReadPaToB 0
  put gmB1 61 or and get gmB1 61 uchar 225 uchar 4
  gmSetPaScr gmFSmShave
  if not gmWriteB1FromPa ulong sn2
    ret gmFail 85 0
  end
  for i ulong ulong sn2 bound 16384
    put sh_dat i get gmB1 i
  end
  sh_all ulong sn2
  gmSetPaScr gmFSmCert
  cn = gmReadPaToB 0
  for i ulong 32
    put gmB1 add 40 i get sh_dig i
  end
  gmSetPaScr gmFSmShCrt
  if not gmWriteB1FromPa ulong cn
    ret gmFail 86 0
  end
  if ne gmRunMonk gmFSmSass gmFSmShave gmFSmShCrt 17
    ret gmFail 87 0
  end
  gmWrt gmM_sm
  gmAddCtrl 2
  gmAddChk 3
  ret 0
end

fn gmTestZeroRecompileContracts to int
  fd = fopen gmChips 0 get gmChipsN 0 0 0
  if lt fd 0
    ret gmFail 90 0
  end
  tot = ulong 0
  while lt tot 60000 bound 1024
    r = read int fd gmB1 tot sub 60000 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  z = fclose int fd
  if and gt tot 0 ne get gmB1 sub tot 1 10
    put gmB1 tot uchar 10
    tot = add tot 1
  end
  for i ulong len gmFutRow bound 512
    put gmB1 add tot i get gmFutRow i
  end
  tot = add tot len gmFutRow
  gmSetPaScr gmFChipsFut
  if not gmWriteB1FromPa tot
    ret gmFail 91 0
  end

  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushLitPair gmFlSmem gmS200k
  gmPushScrPair gmFlOut gmFPkgFutOk
  if ne gmExec false false true 0
    ret gmFail 92 0
  end
  gmStartMorph gmFPkgFutOk true gmTgtFut
  gmPushScrPair gmFlOut gmFFutBin
  if ne gmExec false false true 0
    ret gmFail 93 0
  end
  gmAvReset
  gmSetPaTool gmTXeIsa
  gmAvPushGlob 2
  gmAvPushLit gmChkCmd
  gmSetPaScr gmFFutBin
  gmAvPushGlob 2
  if ne gmExec false false true 0
    ret gmFail 94 0
  end

  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushLitPair gmFlSmem gmS300k
  gmPushScrPair gmFlOut gmFPkgFutBad
  if ne gmExec false false true 0
    ret gmFail 95 0
  end
  gmStartMorph gmFPkgFutBad true gmTgtFut
  gmPushScrPair gmFlOut gmFFutNoOut
  if ne gmExec false false true 72
    ret gmFail 96 0
  end
  gmSetPaScr gmFFutNoOut
  if ge gmReadPaToB 0 0
    ret gmFail 97 0
  end

  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushLitPair gmFlRegs gmS20
  gmPushScrPair gmFlOut gmFPkgRegs
  if ne gmExec false false true 0
    ret gmFail 98 0
  end
  gmStartMorph gmFPkgRegs false gmTgtX64
  gmPushScrPair gmFlOut gmFBadNoOut
  if ne gmExec false false true 72
    ret gmFail 99 0
  end

  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushLitPair gmFlL2 gmS32k
  gmPushScrPair gmFlOut gmFPkgL2
  if ne gmExec false false true 0
    ret gmFail 100 0
  end
  gmStartMorph gmFPkgL2 false gmTgtSm
  gmPushScrPair gmFlOut gmFBadNoOut
  if ne gmExec false false true 72
    ret gmFail 101 0
  end
  gmWrt gmM_fut
  gmAddCtrl 3
  gmAddChk 2
  ret 0
end

fn gmMorphNegExpect pkgSuf view uchar * expRc ulong step ulong to int
  gmStartMorph pkgSuf false gmTgtArm
  gmPushScrPair gmFlOut gmFBadNoOut
  got = gmExec false false true
  if ne got expRc
    ret gmFail step got
  end
  gmSetPaScr gmFBadNoOut
  if ge gmReadPaToB 0 0
    ret gmFail add step 100 0
  end
  ret 0
end

fn gmWritePkgCopy outSuf view uchar * resign bool tot ulong to bool
  if resign
    gmResignB1 tot
  end
  gmSetPaScr outSuf
  ret gmWriteB1FromPa tot
end

fn gmTestSecurityControls to int
  gmSetPaScr gmFPkg1
  sn = gmReadPaToB 0
  if lt sn 300
    ret gmFail 110 0
  end
  n = ulong sn

  note NC1: 1-bit Ed25519 signature tamper -> exit 61
  put gmB1 160 xor get gmB1 160 uchar 1
  if not gmWritePkgCopy gmFNegEd false n
    ret gmFail 111 0
  end
  r = gmMorphNegExpect gmFNegEd 61 112
  if ne r 0
    ret r
  end

  note NC2: 1-bit OIR v2 payload tamper -> exit 62
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  put gmB1 sub n 1 xor get gmB1 sub n 1 uchar 1
  if not gmWritePkgCopy gmFNegSha false n
    ret gmFail 113 0
  end
  r = gmMorphNegExpect gmFNegSha 62 114
  if ne r 0
    ret r
  end

  note NC3: SEMANTIC_ID mismatch (valid Ed25519 + SHA-256!) -> exit 63
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  put gmB1 64 xor get gmB1 64 uchar 1
  if not gmWritePkgCopy gmFNegSem true n
    ret gmFail 115 0
  end
  r = gmMorphNegExpect gmFNegSem 63 116
  if ne r 0
    ret r
  end

  note NC4: Unsound EGP3 rule spoof (rule=99, valid Ed25519 + SHA-256!) -> exit 64
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  eoff = add GM_HDR_LEN gmGetU32B1 56
  put gmB1 add eoff 388 uchar 99
  if not gmWritePkgCopy gmFNegEgp true n
    ret gmFail 117 0
  end
  r = gmMorphNegExpect gmFNegEgp 64 118
  if ne r 0
    ret r
  end

  note NC5: OM-3 safety tag stripped (valid Ed25519 + SHA-256!) -> exit 65
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  put gmB1 12 uchar 88
  if not gmWritePkgCopy gmFNegOm3 true n
    ret gmFail 119 0
  end
  r = gmMorphNegExpect gmFNegOm3 65 120
  if ne r 0
    ret r
  end

  note NC6: WattCBF thermal overload >= 80 W (pack refuses 66 + signed 85 W OIR v2 refused 66!)
  gmAvReset
  gmAvPushGlob 0
  gmAvPushLit gmCmdPack
  gmPushLitPair gmFlPower gmS85k
  gmPushScrPair gmFlOut gmFBadNoOut
  if ne gmExec false false true 66
    ret gmFail 121 0
  end
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  gmPutU32B1 16 85000
  oirOff = GM_HDR_LEN
  note Patch OIR v2 fn0 & fn1 power_mw slots to 85000 + update SEMANTIC_ID cleanly so only WattCBF kills it!
  gmPutU32B1 add oirOff 78 85000
  gmPutU32B1 add oirOff 167 85000
  oirLen = gmGetU32B1 56
  put sh_dat 0 uchar 111
  put sh_dat 1 uchar 109
  put sh_dat 2 uchar 101
  put sh_dat 3 uchar 103
  put sh_dat 4 uchar 97
  put sh_dat 5 uchar 46
  put sh_dat 6 uchar 110
  put sh_dat 7 uchar 103
  put sh_dat 8 uchar 46
  put sh_dat 9 uchar 115
  put sh_dat 10 uchar 101
  put sh_dat 11 uchar 109
  put sh_dat 12 uchar 46
  put sh_dat 13 uchar 102
  put sh_dat 14 uchar 110
  put sh_dat 15 uchar 46
  put sh_dat 16 uchar 118
  put sh_dat 17 uchar 50
  put sh_dat 18 uchar 58
  for i ulong oirLen bound 8192
    put sh_dat add 19 i get gmB1 add oirOff i
  end
  sh_all add 19 oirLen
  for i ulong 32
    put gmB1 add 64 i get sh_dig i
  end
  if not gmWritePkgCopy gmFNegWatt true n
    ret gmFail 122 0
  end
  r = gmMorphNegExpect gmFNegWatt 66 123
  if ne r 0
    ret r
  end

  note NC7: Trailing-bytes smuggling (Antibody 9) -> exit 60
  gmSetPaScr gmFPkg1
  ign = gmReadPaToB 0
  put gmB1 n uchar 0
  if not gmWritePkgCopy gmFNegTrail false add n 1
    ret gmFail 124 0
  end
  r = gmMorphNegExpect gmFNegTrail 60 125
  if ne r 0
    ret r
  end

  gmWrt gmM_neg
  gmAddCtrl 7
  ret 0
end

fn gmReadArg i ulong dst ulong to ulong
  k = argread i gmIo 0 2047
  if lt k 1
    ret 0
  end
  u = ulong k
  for j ulong u bound 2048
    b = get gmIo j
    if eq dst 0
      put gmOmmp j b
    else
      if eq dst 1
        put gmTools j b
      else
        if eq dst 2
          put gmScr j b
        else
          put gmChips j b
        end
      end
    end
  end
  ret u
end

fn main to int
  ac = ulong argcnt
  if or lt ac 4 gt ac 5
    gmWrt gmUse
    ret 90
  end
  put gmOmmpN 0 gmReadArg 1 0
  put gmToolsN 0 gmReadArg 2 1
  put gmScrN 0 gmReadArg 3 2
  if eq ac 5
    put gmChipsN 0 gmReadArg 4 3
  else
    for i ulong len gmDefChips
      put gmChips i get gmDefChips i
    end
    put gmChipsN 0 len gmDefChips
  end
  if or eq get gmOmmpN 0 0 or eq get gmToolsN 0 0 eq get gmScrN 0 0
    gmWrt gmUse
    ret 90
  end
  for i ulong 32
    put gmSeed i get gmDefSeed i
  end
  put gmChk 0 0
  put gmCtrl 0 0
  gmWrt gmHdr

  r = gmTestPackVerify
  if ne r 0
    ret r
  end
  r = gmTestArm64
  if ne r 0
    ret r
  end
  r = gmTestAppleM
  if ne r 0
    ret r
  end
  r = gmTestX64
  if ne r 0
    ret r
  end
  r = gmTestRv64
  if ne r 0
    ret r
  end
  r = gmTestWasm
  if ne r 0
    ret r
  end
  r = gmTestSpirv
  if ne r 0
    ret r
  end
  r = gmTestIntelXe
  if ne r 0
    ret r
  end
  r = gmTestSm121
  if ne r 0
    ret r
  end
  r = gmTestZeroRecompileContracts
  if ne r 0
    ret r
  end
  r = gmTestSecurityControls
  if ne r 0
    ret r
  end

  gmWrt gmPassA
  gmNum get gmChk 0
  gmWrt gmPassB
  gmNum get gmCtrl 0
  gmWrt gmNl
  ret 0
end

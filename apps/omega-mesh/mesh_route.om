const MR_ERR_BAD_NODE ulong 13
const MR_ERR_UNAUTH_PEER ulong 14
const MR_ERR_FRAME_MAGIC ulong 15
const MR_ERR_FRAME_VER ulong 16
const MR_ERR_FRAME_LEN ulong 17
const MR_ERR_FRAME_TYPE ulong 18
const MR_ERR_FRAME_SIG ulong 19
const MR_ERR_SOCK ulong 20
const MR_ERR_IO ulong 21
const MR_ERR_TIMEOUT ulong 22
const MR_ERR_REMOTE_REFUSED ulong 23
const MR_ERR_VERIFY_FAILED ulong 24
const MR_ERR_MEMO_FAILED ulong 25
const MR_ERR_IMPURE ulong 26

note Worker test fault-injection modes (0 = honest production)
const MR_FAULT_NONE ulong 0
const MR_FAULT_FLIP_OUT_BEFORE_SIGN ulong 1
const MR_FAULT_FORGE_SIG ulong 2
const MR_FAULT_UNKNOWN_KEY ulong 3
const MR_FAULT_MATMUL_CORRUPT ulong 4
const MR_FAULT_MERKLE_CHUNK11 ulong 5
const MR_FAULT_WRONG_INPUT_HASH ulong 6

note Heterogeneous mesh node table (slot 0 = local device, slots 1..15 = remote peers)
global mr_n_used ulong 16

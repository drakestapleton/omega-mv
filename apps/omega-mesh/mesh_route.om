const MR_NODE_CAP ulong 16
const MR_NONE ulong 999999
const MR_IPV4_LOOPBACK ulong 2130706433
const MR_OFFLOAD_MARGIN_US ulong 200
const MR_OMSH_HDR_LEN ulong 32
const MR_OMSH_VER ulong 1
const MR_MSG_DISPATCH_REQ ulong 1
const MR_MSG_DISPATCH_RESP ulong 2
const MR_MSG_ERROR ulong 3
const MR_MAX_FRAME_PAYLOAD ulong 32768
const MR_MAX_WIRE ulong 33024
const MR_MAX_INPUT_LEN ulong 16384
const MR_REQ_FIXED_HDR ulong 96
const MR_RESP_FIXED_HDR ulong 304
const MR_FLAG_TIER_B ulong 1
const MR_FLAG_MERKLE ulong 2
const MR_FLAG_FREIVALDS ulong 4

note Pure Compute-on-Arrive workload kinds
const MR_WORK_POLY_PURE ulong 1
const MR_WORK_MATMUL_INT64 ulong 2
const MR_WORK_MERKLE_STEPS ulong 3

note Routing decisions & fail-closed status codes
const MR_OK ulong 0
const MR_DEC_MEMO_HIT ulong 1
const MR_DEC_LOCAL ulong 2
const MR_DEC_REMOTE ulong 3
const MR_ERR_NO_NODE ulong 10
const MR_ERR_BAD_OMPK ulong 11

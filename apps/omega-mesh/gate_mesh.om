note SPDX-License-Identifier: Apache-2.0
note apps/omega-mesh/gate_mesh.om
note Sovereign Intelligence 2.0 Stage 5 (Pillar 5: Zero-Trust Personal Silicon Mesh, DRA-1073)
note Standalone Pure Seeded OM-2 Verification Gate.
note
note Build & run on DGX Spark AArch64 with pinned seeded omc (85b84c6d...):
note   cat si/directives/om2.om apps/omega-wattd/watt_sense.om apps/omega-wattd/watt_cbf.om \
note       seed/ng/sha256.om protocol/omnet/om/sha512/sha512.om \
note       protocol/omnet/om/ed25519/ed25519.om protocol/uor-gpu/ed_sign.om \
note       seed/ng/target/target_desc.om seed/ng/pack/sem_pack.om \
note       seed/ng/memo/memo_policy.om seed/ng/memo/memo_store.om \
note       apps/omega-mesh/mesh_verify.om apps/omega-mesh/mesh_route.om \
note       apps/omega-mesh/gate_mesh.om | seed/out/omc > /tmp/gate_mesh
note   chmod +x /tmp/gate_mesh && /tmp/gate_mesh /tmp/omega-mesh-gate-scratch

global gm_pass ulong 1
global gm_neg ulong 1
global gm_root uchar 1024
global gm_rlen ulong 1
global gm_sub uchar 1024
global gm_slen ulong 1
global gm_arg uchar 512
global gm_st uchar 4
global gm_st2 uchar 4
global gm_saved_out uchar 64
global gm_saved_rcpt uchar 288
global gm_pk_a uchar 32
global gm_pk_b uchar 32
global gm_sd_a uchar 32
global gm_sd_b uchar 32
global gm_pk_c uchar 32
global gm_sd_c uchar 32

text gm_hdr "=== OMEGA NG STAGE 5 (OMEGA-MESH) VERIFICATION GATE ===\n"
text gm_def_root "/tmp/omega-mesh-gate-run"
text gm_s_t2 "/memo-t2"
text gm_s_t3 "/memo-t3"
text gm_s_t4 "/memo-t4"
text gm_s_t5 "/memo-t5"
text gm_s_t6 "/memo-t6"
text gm_s_t7 "/memo-t7"
text gm_tag_cli "OM-MESH-GATE-CLI-V1"
text gm_tag_wa "OM-MESH-GATE-WRK-A-V1"
text gm_tag_wb "OM-MESH-GATE-WRK-B-V1"
text gm_tag_pc "OM-MESH-GATE-PC-V1"
text gm_ir_cpu "omega.ng.ir.v2.pure.mesh.cpu.poly"
text gm_ir_gpu "omega.ng.ir.v2.pure.mesh.sm121.gemm"
text gm_ir_mat "omega.ng.ir.v2.pure.mesh.matmul.i64"
text gm_ir_mk "omega.ng.ir.v2.pure.mesh.merkle.steps"
text gm_ir_imp "omega.ng.ir.v2.impure.mesh.bad"
text gm_in_t2 "gate-t2-loopback-input-v1"
text gm_in_t3 "gate-t3-spotcheck-input-v1"
text gm_in_t6a "gate-t6-quorum-agree-v1"
text gm_in_t6b "gate-t6-quorum-byzantine-v1"
text gm_in_t7 "gate-t7-security-controls-v1"

text gm_p "PASS "
text gm_f "FAIL "
text gm_nl "\n"
text gm_t1 "T1_targetdesc_wattcbf_routing"
text gm_t1_d " mac_hot->spark_x925=1 tiny_rtt->local=1 sm121_contract=1 sm121_hot=FAIL_CLOSED deck_offload=1 wildcard_0.0.0.0=REFUSED"
text gm_t2 "T2_tcp_loopback_tierA_ed25519_memo"
text gm_t2_d " port="
text gm_t2_d2 " call1=REMOTE_VERIFIED call2=MEMO_HIT(net=0) dom_tol100=MEMO_HIT"
text gm_t3 "T3_tierA_spotcheck_silent_bitflip"
text gm_t3_d " bitflip_caught=1 quarantined=1 memo_clean=1 prob25_hits="
text gm_t4 "T4_tierB_freivalds_matmul"
text gm_t4_d " n=16 rounds=32 os_rng="
text gm_t4_d2 " honest=PASS_MEMO corrupt_p1=REFUSED corrupt_m1=REFUSED corrupt_b63=REFUSED"
text gm_t5 "T5_tierB_merkle_checkpoint_bisect"
text gm_t5_d " leaves=16 honest=PASS_MEMO tamper11_chunk="
text gm_t5_d2 " bisect_steps="
text gm_t5_d3 " tamper0=0 tamper15=15"
text gm_t6 "T6_tierB_dual_peer_bft_quorum"
text gm_t6_d " agree=PASS_MEMO byzantine=REFUSED_ALARM sybil_same_peer=REFUSED"
text gm_t7 "T7_fail_closed_security_controls"
text gm_t7_d " forged_sig=REFUSED unknown_peer=REFUSED replay=REFUSED bad_in_sha=REFUSED bad_ompk=REFUSED prec_down=REFUSED unverified_memo=REFUSED toctou=REFUSED frames=REFUSED impure=REFUSED"
text gm_sum_ok "GATE_MESH PASS checks="
text gm_sum_fail "GATE_MESH FAIL checks="
text gm_sum_of "/7 neg_controls="
text gm_sum_tail " hw_writes=0\n"

fn gm_add_neg n ulong to void
put gm_neg 0 add get gm_neg 0 n
end

fn gm_init_root to void
if ge argcnt 2
rn = argread 1 gm_arg 0 500
if gt rn 0
for i ulong ulong rn bound 512
put gm_root i get gm_arg i
end
put gm_rlen 0 ulong rn
ret
end
end
n = len gm_def_root
for i ulong n bound 128
put gm_root i get gm_def_root i
end
put gm_rlen 0 n
end

fn gm_use_subroot suf view uchar * to ulong
rl = get gm_rlen 0
for i ulong rl bound 512
put gm_sub i get gm_root i
end
sl = len suf
for j ulong sl bound 64
put gm_sub add rl j get suf j
end
tot = add rl sl
put gm_slen 0 tot
for i ulong tot bound 1024
put mm_env_buf i get gm_sub i
end
ret mm_set_root_from_envbuf tot
end

fn gm_ir_load_text tag view uchar * to void
pk_reset_builder
n = len tag
for i ulong n bound 128
rc = pk_ir_push get tag i
end
end

fn gm_pack_cpu_ompk tag view uchar * c0 ulong c1 ulong c2 ulong pur ulong to ulong
gm_ir_load_text tag
pk_set_req EXEC_SCALAR_SIMD 0 16 0 0 0
pk_set_contract pur MM_TIER_EXACT 0 0 50000 0
pk_compute_poly_func_id 64 c0 c1 c2
ret pk_pack
end

fn gm_pack_sm121_ompk to ulong
pk_reset_builder
n = len gm_ir_gpu
for i ulong n bound 128
rc = pk_ir_push get gm_ir_gpu i
end
pk_set_req EXEC_SIMT_WARP 65536 48 32 MMA_16816_BF16 FEAT_HMMA16816
pk_set_contract 1 MM_TIER_EXACT 0 0 50000 0
pk_compute_poly_func_id 128 19 37 71
ret pk_pack
end

fn gm_stage_input_text s view uchar * to void
n = len s
for i ulong n bound 256
put mr_in_buf i get s i
end
put mr_in_len 0 n
end

fn gm_in_put_u64 off ulong v ulong to void
for j ulong 8
put mr_in_buf add off j uchar and shr v mul j 8 255
end
end

fn gm_setup_identities to void
mv_ed_derive_seed gm_tag_cli 1
mv_ed_pubkey_from_seed
for i ulong 32
put mr_cli_seed i get mv_ed_seed i
put mr_cli_pk i get mv_ed_pk i
put gm_sd_c i get mv_ed_seed i
put gm_pk_c i get mv_ed_pk i
end
s0 = mv_peer_register 1 MV_TIER_A_SOVEREIGN
mv_ed_derive_seed gm_tag_wa 2
mv_ed_pubkey_from_seed
for i ulong 32
put mr_wrk_seed i get mv_ed_seed i
put mr_wrk_pk i get mv_ed_pk i
put gm_sd_a i get mv_ed_seed i
put gm_pk_a i get mv_ed_pk i
end
s1 = mv_peer_register 2 MV_TIER_A_SOVEREIGN
mv_ed_derive_seed gm_tag_wb 3
mv_ed_pubkey_from_seed
for i ulong 32
put gm_sd_b i get mv_ed_seed i
put gm_pk_b i get mv_ed_pk i
end
end

fn gm_reg_peer_slot slot ulong tid ulong feat ulong role ulong tier ulong port ulong to ulong
mr_stage_node_id slot tid feat role tier
mr_stage_node_net MR_IPV4_LOOPBACK port 120 1000 220 1
mr_stage_node_therm 44000 40000 25000 10000 5000
mr_stage_node_policy 120000 80000 85000 2
ret mr_commit_node
end

note ---- T1: Multi-Target TargetDesc + WattCBF Headroom Routing & Wildcard Guard ----

fn gm_t1_routing to bool
ok = true
mr_init
mv_init
gm_setup_identities
if ne gm_pack_cpu_ompk gm_ir_cpu 7 13 29 1 PK_OK
ok = false
end
gm_stage_input_text gm_in_t2
for i ulong 32
put mv_ed_pk i get gm_pk_c i
end
mr_stage_node_id 0 MR_TID_MACBOOK 399 MR_ROLE_MACBOOK MV_TIER_A_SOVEREIGN
mr_stage_node_net MR_IPV4_LOOPBACK 0 0 10000 40 1
mr_stage_node_therm 76000 72000 25000 12000 4000
mr_stage_node_policy 28000 0 78000 2
if ne mr_commit_node MR_OK
ok = false
end
mv_ed_derive_seed gm_tag_pc 11
mv_ed_pubkey_from_seed
rc = mv_peer_register 11 MV_TIER_A_SOVEREIGN
mr_stage_node_id 1 MR_TID_STEAMDECK 913 MR_ROLE_STEAMDECK MV_TIER_A_SOVEREIGN
mr_stage_node_net mr_pack_ipv4 100 64 0 11 18551 600 500 25 1
mr_stage_node_therm 62000 58000 25000 6000 2000
mr_stage_node_policy 15000 0 75000 2
if ne mr_commit_node MR_OK
ok = false
end
mv_ed_derive_seed gm_tag_pc 12
mv_ed_pubkey_from_seed
rc = mv_peer_register 12 MV_TIER_A_SOVEREIGN
mr_stage_node_id 2 MR_TID_PC 953 MR_ROLE_PC MV_TIER_A_SOVEREIGN
mr_stage_node_net mr_pack_ipv4 100 64 0 12 18552 500 1000 120 1
mr_stage_node_therm 48000 44000 25000 12000 5000
mr_stage_node_policy 95000 0 85000 2
if ne mr_commit_node MR_OK
ok = false
end
for i ulong 32
put mv_ed_pk i get gm_pk_a i
end
mr_stage_node_id 3 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_A_SOVEREIGN
mr_stage_node_net mr_pack_ipv4 10 10 0 3 18553 180 1000 220 1
mr_stage_node_therm 44000 40000 25000 10000 5000
mr_stage_node_policy 120000 80000 85000 2
if ne mr_commit_node MR_OK
ok = false
end
mr_stage_node_id 4 TID_SM121 3081 MR_ROLE_SPARK_GPU MV_TIER_A_SOVEREIGN
mr_stage_node_net mr_pack_ipv4 10 10 0 4 18554 180 1000 1200 1
mr_stage_node_therm 46000 42000 25000 10000 5000
mr_stage_node_policy 140000 80000 85000 2
if ne mr_commit_node MR_OK
ok = false
end
rc = mr_route_select 200000 22000 32 false
if or ne rc MR_DEC_REMOTE or ne get mr_route_out 1 3 ne get mr_route_out 7 0
ok = false
end
put mr_n_tdie 0 42000
put mr_n_tsink 0 38000
put mr_n_rtt_us 2 3000
put mr_n_rtt_us 3 3000
rc = mr_route_select 1500 4000 32 false
if or ne rc MR_DEC_LOCAL ne get mr_route_out 1 0
ok = false
end
put mr_n_rtt_us 2 500
put mr_n_rtt_us 3 180
if ne gm_pack_sm121_ompk PK_OK
ok = false
end
rc = mr_route_select 500000 60000 64 false
if or ne rc MR_DEC_REMOTE or ne get mr_route_out 1 4 ne get mr_route_out 2 TID_SM121
ok = false
end
put mr_n_tdie 4 86000
if ne mr_route_select 500000 60000 64 false MR_ERR_NO_NODE
ok = false
end
gm_add_neg 1
if ne gm_pack_cpu_ompk gm_ir_cpu 7 13 29 1 PK_OK
ok = false
end
put mr_n_tid 0 MR_TID_STEAMDECK
put mr_n_feat 0 913
put mr_n_pbud 0 15000
put mr_n_tceil 0 75000
put mr_n_tdie 0 60000
put mr_n_tsink 0 56000
rc = mr_route_select 180000 30000 32 false
if or ne rc MR_DEC_REMOTE ne get mr_route_out 1 3
ok = false
end
if ne mr_tcp_listen 0 0 neg long MR_ERR_WILDCARD_BIND
ok = false
end
mr_stage_node_id 5 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_A_SOVEREIGN
mr_stage_node_net 0 18555 100 1000 200 1
if ne mr_commit_node MR_ERR_WILDCARD_BIND
ok = false
end
if mr_ip_is_safe_endpoint 4294967295
ok = false
end
if not mr_ip_is_safe_endpoint mr_pack_ipv4 100 64 0 5
ok = false
end
gm_add_neg 3
if ok
wd_puts gm_p
wd_puts gm_t1
wd_puts gm_t1_d
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t1
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T2: Real Forked TCP Loopback -> Tier A Ed25519 Receipt -> OMEGA-MEMO -> Instant Hit ----

fn gm_t2_tcp_tierA_memo to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t2 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_cpu 11 23 41 1 PK_OK
ok = false
end
gm_stage_input_text gm_in_t2
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
if lt lfd 0
ok = false
end
port = get mr_net_stats 7
if eq port 0
ok = false
end
pid = fork
if lt pid 0
cf = fclose int lfd
ok = false
end
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_NONE true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
for i ulong 32
put mv_ed_pk i get gm_pk_a i
end
rc = gm_reg_peer_slot 1 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_A_SOVEREIGN port
if ne rc MR_OK
ok = false
end
put mr_req_meta 1 2001
put mr_req_meta 2 1
rc = mr_client_dispatch_and_memo 1 MR_WORK_POLY_PURE MM_TIER_EXACT 0 MV_TIER_A_SOVEREIGN 0
cf = waitpid int pid gm_st 0 4 0
if or ne rc MR_DEC_REMOTE or ne get gm_st 0 0 ne get gm_st 1 0
ok = false
end
if or ne get mm_val_len 0 32 ne get mr_net_stats 0 1
ok = false
end
for i ulong 32
put gm_saved_out i get mm_val_buf i
end
put mr_req_meta 1 2002
rc = mr_client_dispatch_and_memo 1 MR_WORK_POLY_PURE MM_TIER_EXACT 0 MV_TIER_A_SOVEREIGN 0
if or ne rc MR_DEC_MEMO_HIT ne get mr_net_stats 0 1
ok = false
end
for i ulong 32
if ne get mm_val_buf i get gm_saved_out i
ok = false
end
end
put mr_req_meta 1 2003
rc = mr_client_dispatch_and_memo 1 MR_WORK_POLY_PURE MM_TIER_TOL 100 MV_TIER_A_SOVEREIGN 0
if or ne rc MR_DEC_MEMO_HIT ne get mr_net_stats 0 1
ok = false
end
if ok
wd_puts gm_p
wd_puts gm_t2
wd_puts gm_t2_d
wd_put_u64 port
wd_puts gm_t2_d2
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t2
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T3: Tier A Spot-Check Catches Silent Bit Flip & Quarantines Peer ----

fn gm_t3_spotcheck to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t3 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_cpu 17 31 53 1 PK_OK
ok = false
end
gm_stage_input_text gm_in_t3
mv_set_spot_config 250000 0
hits = ulong 0
for k ulong 40
if mv_should_spot_check add 8000 k
hits = add hits 1
end
end
if or eq hits 0 ge hits 40
ok = false
end
mv_set_spot_config 1000000 1
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
if lt lfd 0
ok = false
end
port = get mr_net_stats 7
pid = fork
if lt pid 0
cf = fclose int lfd
ok = false
end
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_FLIP_OUT_BEFORE_SIGN true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
for i ulong 32
put mv_ed_pk i get gm_pk_a i
end
rc = gm_reg_peer_slot 1 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_A_SOVEREIGN port
put mr_req_meta 1 3001
put mr_req_meta 2 1
rc = mr_client_dispatch_and_memo 1 MR_WORK_POLY_PURE MM_TIER_EXACT 0 MV_TIER_A_SOVEREIGN 0
cf = waitpid int pid gm_st 0 4 0
if or ne rc MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_SPOTCHECK_FAIL
ok = false
end
if or eq get mv_alarm_len 0 0 ne get mv_stats 4 1
ok = false
end
for i ulong 32
put mv_ed_pk i get gm_pk_a i
end
rc = mv_peer_find_pk
if or eq rc MV_NONE eq get mv_peer_quar rc 0
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
put mr_req_meta 1 3002
put mv_exp_meta 2 3002
if ne mv_tier_a_verify 32 true MV_ERR_QUARANTINED
ok = false
end
gm_add_neg 2
if ok
wd_puts gm_p
wd_puts gm_t3
wd_puts gm_t3_d
wd_put_u64 hits
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t3
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T4: Tier B Freivalds Randomized Matmul Verification (O(n^2) vs O(n^3)) ----

fn gm_fill_matmul_input n ulong salt ulong to void
elems = mul n n
gm_in_put_u64 0 n
for i ulong elems bound 1024
av = add mul add i 1 17 salt
bv = add mul add i 3 29 mul salt 3
put mv_mat_a i av
put mv_mat_b i bv
gm_in_put_u64 add 8 mul i 8 av
gm_in_put_u64 add add 8 mul elems 8 mul i 8 bv
end
put mr_in_len 0 add 8 mul elems 16
end

fn gm_t4a_honest n ulong to bool
gm_fill_matmul_input n 5
for i ulong 32
put mr_wrk_seed i get gm_sd_b i
put mr_wrk_pk i get gm_pk_b i
end
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_NONE true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
for i ulong 32
put mv_ed_pk i get gm_pk_b i
end
rc = gm_reg_peer_slot 1 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_B_ZEROTRUST port
put mr_req_meta 1 4001
put mr_req_meta 2 1
rc = mr_client_dispatch_and_memo 1 MR_WORK_MATMUL_INT64 MM_TIER_EXACT 0 MV_TIER_B_ZEROTRUST or MR_FLAG_TIER_B MR_FLAG_FREIVALDS
cf = waitpid int pid gm_st 0 4 0
if or ne rc MR_DEC_REMOTE or ne get gm_st 1 0 ne get mv_fv_stats 3 1
ret false
end
put mr_req_meta 1 4002
rc = mr_client_dispatch_and_memo 1 MR_WORK_MATMUL_INT64 MM_TIER_EXACT 0 MV_TIER_B_ZEROTRUST or MR_FLAG_TIER_B MR_FLAG_FREIVALDS
if or ne rc MR_DEC_MEMO_HIT ne get mr_net_stats 0 1
ret false
end
ret true
end

fn gm_t4b_corrupt n ulong to bool
gm_fill_matmul_input n 9
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_MATMUL_CORRUPT true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
put mr_n_port 1 port
put mr_req_meta 1 4003
rc = mr_client_dispatch_and_memo 1 MR_WORK_MATMUL_INT64 MM_TIER_EXACT 0 MV_TIER_B_ZEROTRUST or MR_FLAG_TIER_B MR_FLAG_FREIVALDS
cf = waitpid int pid gm_st2 0 4 0
if or ne rc MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_FREIVALDS_FAIL
ret false
end
if ne mm_lookup MM_MISS
ret false
end
rc = mv_matmul_compute n
put mv_mat_c 255 sub get mv_mat_c 255 1
if ne mv_freivalds_verify n 32 777 MV_ERR_FREIVALDS_FAIL
ret false
end
put mv_mat_c 255 add get mv_mat_c 255 1
put mv_mat_c 0 xor get mv_mat_c 0 shl ulong 1 63
if ne mv_freivalds_verify n 32 888 MV_ERR_FREIVALDS_FAIL
ret false
end
ret true
end

fn gm_t4_freivalds to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t4 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_mat 23 43 67 1 PK_OK
ok = false
end
if not gm_t4a_honest 16
ok = false
end
os_rng = get mv_fv_stats 3
if not gm_t4b_corrupt 16
ok = false
end
gm_add_neg 3
if ok
wd_puts gm_p
wd_puts gm_t4
wd_puts gm_t4_d
wd_put_u64 os_rng
wd_puts gm_t4_d2
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t4
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T5: Tier B Merkle Checkpoint Verification + O(log2 M) Binary Bisection ----

fn gm_t5a_honest m ulong to bool
gm_in_put_u64 0 m
gm_in_put_u64 8 1001
put mr_in_len 0 16
rc = mv_merkle_run_trace false m 1001 MV_NONE
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_NONE true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
for i ulong 32
put mv_ed_pk i get gm_pk_b i
end
rc = gm_reg_peer_slot 1 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_B_ZEROTRUST port
put mr_req_meta 1 5001
put mr_req_meta 2 1
rc = mr_client_dispatch_and_memo 1 MR_WORK_MERKLE_STEPS MM_TIER_EXACT 0 MV_TIER_B_ZEROTRUST or MR_FLAG_TIER_B MR_FLAG_MERKLE
cf = waitpid int pid gm_st 0 4 0
if or ne rc MR_DEC_REMOTE or ne get gm_st 1 0 ne get mv_mk_stats 0 1
ret false
end
ret true
end

fn gm_t5b_tamper m ulong to bool
gm_in_put_u64 0 m
gm_in_put_u64 8 2002
put mr_in_len 0 16
rc = mv_merkle_run_trace false m 2002 MV_NONE
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 MR_FAULT_MERKLE_CHUNK11 true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
put mr_n_port 1 port
put mr_req_meta 1 5002
rc = mr_client_dispatch_and_memo 1 MR_WORK_MERKLE_STEPS MM_TIER_EXACT 0 MV_TIER_B_ZEROTRUST or MR_FLAG_TIER_B MR_FLAG_MERKLE
cf = waitpid int pid gm_st2 0 4 0
if or ne rc MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_MERKLE_MISMATCH
ret false
end
if or ne get mv_mk_stats 2 11 ne get mv_mk_stats 1 4
ret false
end
if ne mm_lookup MM_MISS
ret false
end
rc = mv_merkle_run_trace true m 2002 0
if ne mv_merkle_verify_and_bisect m MV_ERR_MERKLE_MISMATCH
ret false
end
if or ne get mv_mk_stats 2 0 ne get mv_mk_stats 1 4
ret false
end
rc = mv_merkle_run_trace true m 2002 15
if ne mv_merkle_verify_and_bisect m MV_ERR_MERKLE_MISMATCH
ret false
end
if or ne get mv_mk_stats 2 15 ne get mv_mk_stats 1 4
ret false
end
ret true
end

fn gm_t5_merkle to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t5 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_mk 31 59 83 1 PK_OK
ok = false
end
for i ulong 32
put mr_wrk_seed i get gm_sd_b i
put mr_wrk_pk i get gm_pk_b i
end
if not gm_t5a_honest 16
ok = false
end
if not gm_t5b_tamper 16
ok = false
end
gm_add_neg 3
if ok
wd_puts gm_p
wd_puts gm_t5
wd_puts gm_t5_d
wd_put_u64 11
wd_puts gm_t5_d2
wd_put_u64 4
wd_puts gm_t5_d3
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t5
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T6: Tier B Dual-Peer BFT Quorum (Agreement PASS & Byzantine Disagreement REFUSAL) ----

fn gm_load_wrk_key use_b_key bool to void
for i ulong 32
if use_b_key
put mr_wrk_seed i get gm_sd_b i
put mr_wrk_pk i get gm_pk_b i
else
put mr_wrk_seed i get gm_sd_a i
put mr_wrk_pk i get gm_pk_a i
end
end
end

fn gm_call_one_worker use_b_key bool fault ulong nonce ulong to ulong
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
gm_load_wrk_key use_b_key
wrc = mr_worker_serve_one int lfd TID_X925 399 fault true
cf = fclose int lfd
exit int wrc
end
cf = fclose int lfd
put mr_req_meta 8 TID_X925
put mr_req_meta 1 nonce
put mr_req_meta 2 1
rc = mr_client_tcp_call MR_IPV4_LOOPBACK port MR_WORK_POLY_PURE MM_TIER_EXACT 0 MR_FLAG_TIER_B
cf = waitpid int pid gm_st 0 4 0
ret rc
end

fn gm_run_dual_peers fault_b ulong nonce_a ulong nonce_b ulong to ulong
rc = gm_call_one_worker true fault_b nonce_b
if ne rc MR_OK
ret MR_ERR_IO
end
len_b = get mm_val_len 0
rc = mv_copy_primary_to_b len_b
if ne rc MV_OK
ret MR_ERR_IO
end
rc = gm_call_one_worker false MR_FAULT_NONE nonce_a
if ne rc MR_OK
ret MR_ERR_IO
end
len_a = get mm_val_len 0
rc = mr_stage_memo_and_exp MM_TIER_EXACT 0 nonce_a 1 MV_TIER_B_ZEROTRUST
if ne rc MR_OK
ret rc
end
ret mv_tier_b_verify_quorum len_a len_b nonce_a nonce_b
end

fn gm_t6_quorum to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t6 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_cpu 41 73 97 1 PK_OK
ok = false
end
note 6A: Dual-peer honest agreement -> PASS & admit to OMEGA-MEMO!
gm_stage_input_text gm_in_t6a
q1 = gm_run_dual_peers MR_FAULT_NONE 6001 6002
if ne q1 MV_OK
ok = false
end
a1 = mv_admit_to_memo 25000 1000
if ne a1 MV_OK
ok = false
end
if ne mm_lookup MM_OK
ok = false
end
note 6B: Sybil same-peer quorum negative control (copy primary into B) -> REFUSED!
cp_syb = mv_copy_primary_to_b get mm_val_len 0
q_syb = mv_tier_b_verify_quorum get mm_val_len 0 get mm_val_len 0 6011 6012
if ne q_syb MV_ERR_QUORUM_SAME_PEER
ok = false
end
note 6C: Byzantine disagreement (Peer A honest, Peer B silent bit-flip) -> REFUSED + ALARM + memo clean!
gm_stage_input_text gm_in_t6b
q2 = gm_run_dual_peers MR_FAULT_FLIP_OUT_BEFORE_SIGN 6021 6022
if or ne q2 MV_ERR_QUORUM_MISMATCH eq get mv_alarm_len 0 0
ok = false
end
if ne mv_admit_to_memo 25000 1000 MV_ERR_UNVERIFIED
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
gm_add_neg 3
if ok
wd_puts gm_p
wd_puts gm_t6
wd_puts gm_t6_d
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t6
wd_puts gm_nl
end
wd_flush
ret ok
end

note ---- T7: Fail-Closed Negative Controls (Sig, Unknown Peer, Replay, Binding, TOCTOU, Frames) ----

fn gm_run_single_fault fault_mode ulong nonce ulong to ulong
lfd = mr_tcp_listen MR_IPV4_LOOPBACK 0
port = get mr_net_stats 7
pid = fork
if eq pid 0
wrc = mr_worker_serve_one int lfd TID_X925 399 fault_mode true
cf1 = fclose int lfd
exit int wrc
end
cf2 = fclose int lfd
put mr_n_port 1 port
put mr_req_meta 1 nonce
put mr_req_meta 2 5
d = mr_client_dispatch_and_memo 1 MR_WORK_POLY_PURE MM_TIER_EXACT 0 MV_TIER_A_SOVEREIGN 0
wr = waitpid int pid gm_st 0 4 0
ret d
end

fn gm_t7a_tcp_faults to bool
ok = true
note 1. Forged Ed25519 signature over live TCP -> MV_ERR_BAD_SIG
d1 = gm_run_single_fault MR_FAULT_FORGE_SIG 7001
if or ne d1 MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_BAD_SIG
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
note 2. Unknown non-allowlisted peer key over live TCP -> MV_ERR_UNKNOWN_PEER
d2 = gm_run_single_fault MR_FAULT_UNKNOWN_KEY 7002
if or ne d2 MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_UNKNOWN_PEER
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
note 3. Mismatched inputs_sha256 in receipt over live TCP -> MV_ERR_BINDING_MISMATCH
d3 = gm_run_single_fault MR_FAULT_WRONG_INPUT_HASH 7003
if or ne d3 MR_ERR_VERIFY_FAILED ne get mr_net_stats 6 MV_ERR_BINDING_MISMATCH
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
gm_add_neg 3
ret ok
end

fn gm_t7b_replay_and_bindings to bool
ok = true
note Produce one genuine signed receipt (nonce 7010, epoch 5)
rc = mr_stage_memo_and_exp MM_TIER_EXACT 0 7010 5 MV_TIER_A_SOVEREIGN
rc = mr_exec_poly_to_valbuf
for i ulong 32
put mv_ed_seed i get gm_sd_a i
end
put mv_min_epoch 0 5
rc = mv_rcpt_sign TID_X925 MM_TIER_EXACT MV_TIER_A_SOVEREIGN 0 15000
for i ulong MV_RCPT_LEN
put gm_saved_rcpt i get mv_rcpt i
end
note 4. Flip last byte of Ed25519 sig -> MV_ERR_BAD_SIG
put mv_rcpt 287 xor get mv_rcpt 287 uchar 1
if ne mv_tier_a_verify 32 false MV_ERR_BAD_SIG
ok = false
end
put mv_rcpt 287 get gm_saved_rcpt 287
note 5. Unverified direct memo admission -> MV_ERR_UNVERIFIED & memo clean
if ne mv_admit_to_memo 15000 1000 MV_ERR_UNVERIFIED
ok = false
end
if ne mm_lookup MM_MISS
ok = false
end
note 6. Stale epoch (receipt epoch 5, require min_epoch 6) -> MV_ERR_EPOCH
put mv_exp_meta 3 6
if ne mv_tier_a_verify 32 false MV_ERR_EPOCH
ok = false
end
put mv_exp_meta 3 5
note 7. Mismatched ompk_sem_id binding -> MV_ERR_BINDING_MISMATCH
put mv_exp_ompk_sem 0 xor get mv_exp_ompk_sem 0 uchar 1
if ne mv_tier_a_verify 32 false MV_ERR_BINDING_MISMATCH
ok = false
end
put mv_exp_ompk_sem 0 xor get mv_exp_ompk_sem 0 uchar 1
note 8. Precision downgrade (@tol(50) receipt for @exact caller) -> MV_ERR_PRECISION
put mm_val_len 0 32
rc = mv_rcpt_sign TID_X925 MM_TIER_TOL MV_TIER_A_SOVEREIGN 50 15000
if ne mv_tier_a_verify 32 false MV_ERR_PRECISION
ok = false
end
note Restore valid @exact receipt -> PASS, then test TOCTOU tamper & replay!
for i ulong MV_RCPT_LEN
put mv_rcpt i get gm_saved_rcpt i
end
put mm_val_len 0 32
if ne mv_tier_a_verify 32 false MV_OK
ok = false
end
note 9. TOCTOU: flip 1 byte of mm_val_buf AFTER verify, BEFORE mv_admit_to_memo -> MV_ERR_TOCTOU_TAMPER!
put mm_val_buf 0 xor get mm_val_buf 0 uchar 1
if ne mv_admit_to_memo 15000 1000 MV_ERR_TOCTOU_TAMPER
ok = false
end
put mm_val_buf 0 xor get mm_val_buf 0 uchar 1
if ne mm_lookup MM_MISS
ok = false
end
note 10. Replayed nonce 7010 -> MV_ERR_REPLAY!
put mm_val_len 0 32
if ne mv_tier_a_verify 32 false MV_ERR_REPLAY
ok = false
end
note 11. One-shot token check: fresh nonce 7011 passes, admits once, second admit fails MV_ERR_UNVERIFIED
put mv_exp_meta 2 7011
put mm_val_len 0 32
rc = mv_rcpt_sign TID_X925 MM_TIER_EXACT MV_TIER_A_SOVEREIGN 0 15000
if ne mv_tier_a_verify 32 false MV_OK
ok = false
end
if ne mv_admit_to_memo 15000 1000 MV_OK
ok = false
end
if ne mv_admit_to_memo 15000 1000 MV_ERR_UNVERIFIED
ok = false
end
gm_add_neg 8
ret ok
end

fn gm_t7c_frames_and_impure to bool
ok = true
note 12. Malformed OMSH v1 frames: bad magic, bad version, truncated, trailing byte, bad sig, unauth client
put mr_req_meta 1 7020
put mr_req_meta 2 5
enc = mr_encode_req_frame MR_WORK_POLY_PURE MM_TIER_EXACT 0 TID_X925 0
if ne enc MR_OK
ok = false
end
orig_len = get mr_wire_len 0
note Bad magic
put mr_wire 0 88
if ne mr_decode_req_frame true MR_ERR_FRAME_MAGIC
ok = false
end
put mr_wire 0 79
note Bad version
put mr_wire 4 2
if ne mr_decode_req_frame true MR_ERR_FRAME_VER
ok = false
end
put mr_wire 4 1
note Truncated length
put mr_wire_len 0 sub orig_len 1
if ne mr_decode_req_frame true MR_ERR_FRAME_LEN
ok = false
end
note Trailing garbage byte
put mr_wire_len 0 add orig_len 1
if ne mr_decode_req_frame true MR_ERR_FRAME_LEN
ok = false
end
put mr_wire_len 0 orig_len
note Corrupted client signature
put mr_wire sub orig_len 1 xor get mr_wire sub orig_len 1 uchar 1
if ne mr_decode_req_frame true MR_ERR_FRAME_SIG
ok = false
end
put mr_wire sub orig_len 1 xor get mr_wire sub orig_len 1 uchar 1
note Unauthorized client pubkey in allowlist mode
put mr_wire 32 xor get mr_wire 32 uchar 1
if ne mr_decode_req_frame true MR_ERR_UNAUTH_PEER
ok = false
end
put mr_wire 32 xor get mr_wire 32 uchar 1
note Valid frame succeeds
if ne mr_decode_req_frame true MR_OK
ok = false
end
note 13. Impure OMPK v2 (purity_flag == 0) refused fail-closed!
if ne gm_pack_cpu_ompk gm_ir_imp 3 5 7 0 PK_OK
ok = false
end
if ne mr_stage_memo_and_exp MM_TIER_EXACT 0 7025 5 MV_TIER_A_SOVEREIGN MR_ERR_IMPURE
ok = false
end
note 14. Tampered OMPK v2 byte refused fail-closed!
put pk_buf sub get pk_len 0 1 xor get pk_buf sub get pk_len 0 1 uchar 1
if ne mr_route_select 10000 5000 32 false MR_ERR_BAD_OMPK
ok = false
end
gm_add_neg 8
ret ok
end

fn gm_t7_security_controls to bool
ok = true
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
gm_setup_identities
if ne gm_use_subroot gm_s_t7 MM_OK
ok = false
end
if ne gm_pack_cpu_ompk gm_ir_cpu 53 61 71 1 PK_OK
ok = false
end
gm_stage_input_text gm_in_t7
for i ulong 32
put mv_ed_pk i get gm_pk_a i
end
c1 = gm_reg_peer_slot 1 TID_X925 399 MR_ROLE_SPARK_CPU MV_TIER_A_SOVEREIGN 0
if not gm_t7a_tcp_faults
ok = false
end
if not gm_t7b_replay_and_bindings
ok = false
end
if not gm_t7c_frames_and_impure
ok = false
end
if ne get g_wmeta 12 0
ok = false
end
if ok
wd_puts gm_p
wd_puts gm_t7
wd_puts gm_t7_d
wd_puts gm_nl
put gm_pass 0 add get gm_pass 0 1
else
wd_puts gm_f
wd_puts gm_t7
wd_puts gm_nl
end
wd_flush
ret ok
end

fn main to int
put gm_pass 0 0
put gm_neg 0 0
put g_wmeta 12 0
gm_init_root
wd_puts gm_hdr
wd_flush
all_ok = true
if not gm_t1_routing
all_ok = false
end
if not gm_t2_tcp_tierA_memo
all_ok = false
end
if not gm_t3_spotcheck
all_ok = false
end
if not gm_t4_freivalds
all_ok = false
end
if not gm_t5_merkle
all_ok = false
end
if not gm_t6_quorum
all_ok = false
end
if not gm_t7_security_controls
all_ok = false
end
if and all_ok eq get g_wmeta 12 0
wd_puts gm_sum_ok
wd_put_u64 get gm_pass 0
wd_puts gm_sum_of
wd_put_u64 get gm_neg 0
wd_puts gm_sum_tail
wd_flush
ret 0
end
wd_puts gm_sum_fail
wd_put_u64 get gm_pass 0
wd_puts gm_sum_of
wd_put_u64 get gm_neg 0
wd_puts gm_sum_tail
wd_flush
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note apps/omega-mindmesh/mindmesh_pipe.om
note Wave 3 Grand Unification closed-loop pipeline verifier & OMMM01 manifest driver.
note
note Pure seeded OM-2 (zero C, zero GCC, zero Python, zero Rust, zero CUDA, hw_writes=0).
note Portable across DGX Spark (aarch64 Linux), Pi 5 hub (aarch64 Linux), and MacBook (target a64macos).
note
note Compose after:
note   si/directives/om2.om
note   apps/omega-wattd/watt_sense.om
note   apps/omega-wattd/watt_cbf.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note   protocol/uor-gpu/ed_sign.om
note
note OMMM01 Grand Unification Convergence Manifest (512 bytes, little-endian):
note   [0..6)     magic                 "OMMM01"
note   [6..8)     version               u16 LE = 1
note   [8..12)    flags                 u32 LE (bit0=om2, bit1=hw0, bit2=wx, bit3=gpu_not_run, bit4=trojan_ok, bit5=live_3host)
note   [12..16)   stage_mask            u32 LE = 0x3f (Stages 1..6 all verified)
note   [16..24)   watt_gpu_mw           u64 LE (< 80000)
note   [24..28)   tdie_mc               u32 LE
note   [28..32)   live_sensors          u32 LE
note   [32..36)   lean_exit             u32 LE (= 48)
note   [36..40)   lean_axioms_ok        u32 LE (= 1)
note   [40..44)   symbiote_ulp_diff     u32 LE (= 0)
note   [44..48)   symbiote_memo_hit     u32 LE (= 1)
note   [48..56)   symbiote_w20_ns       u64 LE
note   [56..64)   symbiote_warm_ns      u64 LE
note   [64..68)   ddc_quorum_votes      u32 LE (= 3)
note   [68..72)   trojan_kill_rc        u32 LE (!= 0)
note   [72..76)   dna_ratchet_old       u32 LE
note   [76..80)   dna_ratchet_new       u32 LE (> dna_ratchet_old)
note   [80..84)   dna_surfaces          u32 LE (= 5)
note   [84..88)   hw_writes             u32 LE (= 0)
note   [88..96)   timestamp_ns          u64 LE (monons)
note   [96..128)  c1_sha256             Stage 1 chain commitment
note   [128..160) c2_sha256             Stage 2 chain commitment (chained from c1)
note   [160..192) c3_sha256             Stage 3 chain commitment (chained from c2)
note   [192..224) c4_sha256             Stage 4 chain commitment (chained from c3)
note   [224..256) c5_sha256             Stage 5 chain commitment (chained from c4)
note   [256..288) c6_sha256             Stage 6 convergence digest (chained from c5)
note   [288..320) s1_ommp_sha256        SHA-256(k1.ommp)
note   [320..352) s2_otkj_tip_sha256    OTKJ v1 tip chain hash
note   [352..384) s5_ddc_sem_sha256     DDC3 consensus semantic_digest
note   [384..416) manifest_body_sha256  SHA-256("OMMM01-BODY-V1\0" || man[0..384))
note   [416..448) authority_pubkey      RFC 8032 Ed25519 pubkey (32 B)
note   [448..512) ed25519_sig           RFC 8032 strict (mode=0) Ed25519 sig over man[0..416)

const MM_OK int 0
const MM_ERR_USAGE int 2
const MM_ERR_IO int 10
const MM_ERR_STAGE1 int 11
const MM_ERR_WATTCBF int 12
const MM_ERR_STAGE2 int 13
const MM_ERR_STAGE3 int 14
const MM_ERR_STAGE4 int 15
const MM_ERR_STAGE5 int 16
const MM_ERR_STAGE6 int 17
const MM_ERR_MANIFEST int 18

const MM_MAX_FILE ulong 4194304
const MM_MAN_LEN ulong 512
const MM_MAN_BODY_LIM ulong 384
const MM_MAN_SIG_LIM ulong 416
const MM_GPU_STRICT_MAX_MW ulong 79999
const MM_TCEIL_MAX_MC ulong 90000

note Hash slots inside g_mm_hashes (slot * 32):
const MM_H0 ulong 0
const MM_H1 ulong 1
const MM_H2 ulong 2
const MM_H3 ulong 3
const MM_C0 ulong 4
const MM_C1 ulong 5
const MM_C2 ulong 6

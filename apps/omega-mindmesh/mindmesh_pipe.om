const MM_C4 ulong 8
const MM_C5 ulong 9
const MM_C6 ulong 10
const MM_PREV_H ulong 11
const MM_S1_OMMP_H ulong 12
const MM_S2_OTKJ_H ulong 13
const MM_S5_SEM_H ulong 14
const MM_TMP_H ulong 15


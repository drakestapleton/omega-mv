note --- Basic stdout, path slot, and packet helpers ---

fn gm_write_fd fd int s view uchar * n ulong to void
  pos = ulong 0
  while lt pos n bound 65536
    w = write fd s pos sub n pos
    if le w 0
      ret
    end
    pos = add pos ulong w
  end
end

fn gm_puts s view uchar * to void
  gm_write_fd int 1 s len s
end

fn gm_putn v ulong to void
  if eq v 0
    put g_gm_out 0 48
    w = write int 1 g_gm_out 0 1
    ret
  end
  idx = ulong 0
  cur = v
  while gt cur 0 bound 32
    d = rem cur 10
    put g_gm_out idx uchar add 48 d
    idx = add idx 1
    cur = div cur 10
  end
  for i ulong idx bound 32
    put g_gm_out add 32 i get g_gm_out sub sub idx 1 i
  end
  for i ulong idx bound 32
    put g_gm_out i get g_gm_out add 32 i
  end
  pos = ulong 0
  while lt pos idx bound 32
    w = write int 1 g_gm_out pos sub idx pos
    if le w 0
      ret
    end
    pos = add pos ulong w
  end
end

fn gm_fail code int step ulong to int
  gm_puts gm_m_fail
  gm_putn step
  gm_puts gm_m_nl
  ret code
end

fn gm_path_set_text slot ulong s view uchar * to void
  sb = mul slot 1024
  n = len s
  for i ulong n bound 1020
    put g_gm_paths add sb i get s i
  end
  put g_gm_paths add sb n 0
  put g_gm_plens slot n
end

fn gm_path_set_arg slot ulong idx ulong to void
  n = argread idx g_gm_arg 0 1020
  if le n 0
    ret
  end
  nu = ulong n
  sb = mul slot 1024
  for i ulong nu bound 1020
    put g_gm_paths add sb i get g_gm_arg i
  end
  put g_gm_paths add sb nu 0
  put g_gm_plens slot nu
end

fn gm_path_join dst ulong base ulong sfx view uchar * to void
  db = mul dst 1024
  bb = mul base 1024
  bn = get g_gm_plens base
  for i ulong bn bound 900
    ch = get g_gm_paths add bb i
    put g_gm_paths add db i ch
  end
  sn = len sfx
  di = add db bn
  for i ulong sn bound 120
    put g_gm_paths add di i get sfx i
  end
  tot = add bn sn
  put g_gm_paths add db tot 0
  put g_gm_plens dst tot
end

fn gm_path_append_num dst ulong num ulong to void
  tmp = new uchar 24 0
  db = mul dst 1024
  cur = get g_gm_plens dst
  if eq num 0
    put g_gm_paths add db cur 48
    cur = add cur 1
  else
    k = ulong 0
    v = num
    while gt v 0 bound 20
      d = rem v 10
      put tmp k uchar add 48 d
      k = add k 1
      v = div v 10
    end
    for i ulong k bound 20
      ti = sub sub k 1 i
      ch = get tmp ti
      put g_gm_paths add db cur ch
      cur = add cur 1
    end
  end
  put g_gm_paths add db cur 0
  put g_gm_plens dst cur
end

fn gm_path_join_num dst ulong base ulong pfx view uchar * num ulong to void
  gm_path_join dst base pfx
  gm_path_append_num dst num
end

fn gm_streq_arg idx ulong s view uchar * to bool
  sn = argread idx g_gm_arg 0 1020
  if lt sn 0
    ret false
  end
  n = ulong sn
  if ne n len s
    ret false
  end
  for i ulong n bound 1024
    if ne get g_gm_arg i get s i
      ret false
    end
  end
  ret true
end

fn gm_stat_slot slot ulong to long
  sb = mul slot 1024
  plen = get g_gm_plens slot
  ret stat g_gm_paths sb plen g_gm_stat 0 128
end

fn gm_stat_mode_slot slot ulong to ulong
  if ne gm_stat_slot slot 0
    ret 9999
  end
  m = add ulong get g_gm_stat 16 shl ulong get g_gm_stat 17 8
  ret and m 4095
end

fn gm_ensure_dir slot ulong to int
  if eq gm_stat_slot slot 0
    ret 0
  end
  sb = mul slot 1024
  plen = get g_gm_plens slot
  r = makedir g_gm_paths sb plen 493
  if eq r 0
    ret 0
  end
  if eq gm_stat_slot slot 0
    ret 0
  end
  ret -1
end

fn gm_chmod_slot slot ulong mode ulong to int
  sb = mul slot 1024
  plen = get g_gm_plens slot
  if eq mode 320
    ret int chmod g_gm_paths sb plen 320
  end
  ret int chmod g_gm_paths sb plen 493
end

fn gm_unlink_slot slot ulong to void
  sb = mul slot 1024
  plen = get g_gm_plens slot
  r = unlink g_gm_paths sb plen
end

fn gm_open_ro slot ulong to long
  sb = mul slot 1024
  plen = get g_gm_plens slot
  ret fopen g_gm_paths sb plen 0 0
end

fn gm_open_wo slot ulong to long
  sb = mul slot 1024
  plen = get g_gm_plens slot
  ret fopen g_gm_paths sb plen 577 420
end

fn gm_open_rw_existing slot ulong to long
  sb = mul slot 1024
  plen = get g_gm_plens slot
  ret fopen g_gm_paths sb plen 2 0
end

fn gm_read_slot_a slot ulong to long
  fd = gm_open_ro slot
  if lt fd 0
    ret -1
  end
  off = ulong 0
  while true bound 2048
    k = read int fd g_gm_io 0 65536
    if lt k 0
      r = fclose int fd
      ret -1
    end
    if eq k 0
      break
    end
    nk = ulong k
    if gt add off nk 4194304
      r = fclose int fd
      ret -1
    end
    for j ulong nk bound 65536
      put g_gm_bufa add off j get g_gm_io j
    end
    off = add off nk
  end
  r = fclose int fd
  ret long off
end

fn gm_read_slot_b slot ulong to long
  fd = gm_open_ro slot
  if lt fd 0
    ret -1
  end
  off = ulong 0
  while true bound 2048
    k = read int fd g_gm_io 0 65536
    if lt k 0
      r = fclose int fd
      ret -1
    end
    if eq k 0
      break
    end
    nk = ulong k
    if gt add off nk 4194304
      r = fclose int fd
      ret -1
    end
    for j ulong nk bound 65536
      put g_gm_bufb add off j get g_gm_io j
    end
    off = add off nk
  end
  r = fclose int fd
  ret long off
end

fn gm_write_fd_all fd int n ulong to int
  off = ulong 0
  while lt off n bound 2048
    left = sub n off
    if gt left 65536
      left = ulong 65536
    end
    for j ulong left bound 65536
      put g_gm_io j get g_gm_bufa add off j
    end
    w = write fd g_gm_io 0 left
    if le w 0
      ret -1
    end
    off = add off ulong w
  end
  ret 0
end

fn gm_write_slot_a slot ulong n ulong to int
  fd = gm_open_wo slot
  if lt fd 0
    ret -1
  end
  rc = gm_write_fd_all int fd n
  r = fclose int fd
  if or ne rc 0 ne r 0
    ret -1
  end
  ret 0
end

fn gm_append_slot_to_fd fd int slot ulong to int
  sn = gm_read_slot_a slot
  if lt sn 0
    ret -1
  end
  ret gm_write_fd_all fd ulong sn
end

fn gm_append_text_to_fd fd int s view uchar * to int
  n = len s
  for i ulong n bound 4096
    put g_gm_io i get s i
  end
  w = write fd g_gm_io 0 n
  if ne w long n
    ret -1
  end
  ret 0
end

fn gm_cmp_slots sa ulong sb ulong to bool
  na = gm_read_slot_a sa
  nb = gm_read_slot_b sb
  if or lt na 0 ne na nb
    ret false
  end
  for i ulong ulong na bound 4194304
    if ne get g_gm_bufa i get g_gm_bufb i
      ret false
    end
  end
  ret true
end

fn gm_flip_byte_slot slot ulong off ulong to int
  sn = gm_read_slot_a slot
  if le sn long off
    ret -1
  end
  n = ulong sn
  put g_gm_bufa off xor get g_gm_bufa off 1
  ret gm_write_slot_a slot n
end

fn gm_set_byte_slot slot ulong off ulong val uchar to int
  sn = gm_read_slot_a slot
  if le sn long off
    ret -1
  end
  n = ulong sn
  put g_gm_bufa off val
  ret gm_write_slot_a slot n
end

fn gm_trunc_slot slot ulong new_len ulong to int
  sn = gm_read_slot_a slot
  if lt sn long new_len
    ret -1
  end
  ret gm_write_slot_a slot new_len
end

fn gm_copy_slot src ulong dst ulong to int
  sn = gm_read_slot_a src
  if lt sn 0
    ret -1
  end
  ret gm_write_slot_a dst ulong sn
end

fn gm_append_text_slot slot ulong s view uchar * to int
  sn = gm_read_slot_a slot
  if lt sn 0
    ret -1
  end
  n = ulong sn
  addn = len s
  if gt add n addn 4194304
    ret -1
  end
  for i ulong addn bound 4096
    put g_gm_bufa add n i get s i
  end
  ret gm_write_slot_a slot add n addn
end

fn gm_match_at_bufa off ulong oldp view uchar * to bool
  pn = len oldp
  for j ulong pn bound 64
    b = get g_gm_bufa add off j
    if ne b get oldp j
      ret false
    end
  end
  ret true
end

fn gm_write_at_bufa off ulong newp view uchar * to void
  pn = len newp
  for j ulong pn bound 64
    ch = get newp j
    put g_gm_bufa add off j ch
  end
end

fn gm_patch_sub_slot slot ulong oldp view uchar * newp view uchar * to int
  sn = gm_read_slot_a slot
  if lt sn 0
    ret -1
  end
  n = ulong sn
  pn = len oldp
  if or eq pn 0 ne pn len newp
    ret -1
  end
  if lt n pn
    ret -1
  end
  lim = add sub n pn 1
  found = false
  for i ulong lim bound 4194304
    if gm_match_at_bufa i oldp
      gm_write_at_bufa i newp
      found = true
      break
    end
  end
  if not found
    ret -1
  end
  ret gm_write_slot_a slot n
end

note --- Subprocess execprog packet and runner ---

fn gm_pkt_reset to void
  put g_gm_pkt 0 0
  put g_gm_pkt 1 0
  put g_gm_pktlen 0 2
  put g_gm_pktargc 0 0
end

fn gm_pkt_push_slot slot ulong to void
  plen = get g_gm_plens slot
  pos = get g_gm_pktlen 0
  put g_gm_pkt pos uchar and plen 255
  put g_gm_pkt add pos 1 uchar and shr plen 8 255
  pos = add pos 2
  sb = mul slot 1024
  for i ulong plen bound 1024
    put g_gm_pkt add pos i get g_gm_paths add sb i
  end
  pos = add pos plen
  put g_gm_pktlen 0 pos
  ac = add get g_gm_pktargc 0 1
  put g_gm_pktargc 0 ac
  put g_gm_pkt 0 uchar and ac 255
  put g_gm_pkt 1 uchar and shr ac 8 255
end

fn gm_pkt_push_text s view uchar * to void
  slen = len s
  pos = get g_gm_pktlen 0
  put g_gm_pkt pos uchar and slen 255
  put g_gm_pkt add pos 1 uchar and shr slen 8 255
  pos = add pos 2
  for i ulong slen bound 1024
    put g_gm_pkt add pos i get s i
  end
  pos = add pos slen
  put g_gm_pktlen 0 pos
  ac = add get g_gm_pktargc 0 1
  put g_gm_pktargc 0 ac
  put g_gm_pkt 0 uchar and ac 255
  put g_gm_pkt 1 uchar and shr ac 8 255
end

fn gm_close_fds ifd long ofd long efd long to void
  if ge ifd 0
    r0 = fclose int ifd
  end
  if ge ofd 0
    r1 = fclose int ofd
  end
  if ge efd 0
    r2 = fclose int efd
  end
end

fn gm_dup_and_exec ifd long ofd long efd long to void
  if ge ifd 0
    d0 = dupfd int ifd 0 0
    r0 = fclose int ifd
  end
  if ge ofd 0
    d1 = dupfd int ofd 1 0
    r1 = fclose int ofd
  end
  if ge efd 0
    d2 = dupfd int efd 2 0
    r2 = fclose int efd
  end
  xr = execprog g_gm_pkt 0 get g_gm_pktlen 0
  exit int 254
end

fn gm_run_io in_slot ulong out_slot ulong err_slot ulong to int
  ifd = long -1
  ofd = long -1
  efd = long -1
  if ne in_slot GM_NONE
    ifd = gm_open_ro in_slot
    if lt ifd 0
      ret 250
    end
  end
  if ne out_slot GM_NONE
    ofd = gm_open_wo out_slot
    if lt ofd 0
      gm_close_fds ifd -1 -1
      ret 251
    end
  end
  if ne err_slot GM_NONE
    efd = gm_open_wo err_slot
    if lt efd 0
      gm_close_fds ifd ofd -1
      ret 252
    end
  end
  pid = fork
  if lt pid 0
    gm_close_fds ifd ofd efd
    ret 253
  end
  if eq pid 0
    gm_dup_and_exec ifd ofd efd
  end
  gm_close_fds ifd ofd efd
  st = new uchar 4 0
  wr = waitpid int pid st 0 4 0
  if ne wr pid
    ret 255
  end
  if ne get st 0 0
    ret 249
  end
  ret int get st 1
end

fn gm_run_quiet to int
  gm_path_join SL_IN SL_SCR gm_s_null
  gm_path_join SL_OUT SL_SCR gm_s_tmpout
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  ret gm_run_io SL_IN SL_OUT SL_ERR
end

fn gm_u32_a off ulong to ulong
  v = ulong 0
  for j ulong 4
    v = or v shl ulong get g_gm_bufa add off j mul j 8
  end
  ret v
end

fn gm_check_elf_phdrs n ulong phoff ulong phent ulong phnum ulong to bool
  for i ulong phnum bound 64
    po = add phoff mul i phent
    if gt add po 56 n
      ret false
    end
    pt = gm_u32_a po
    if or eq pt 2 eq pt 3
      ret false
    end
  end
  ret true
end

fn gm_check_bin_format slot ulong is_mac ulong to bool
  sn = gm_read_slot_a slot
  if lt sn 64
    ret false
  end
  n = ulong sn
  if ne is_mac 0
    ret eq gm_u32_a 0 0xfeedfacf
  end
  if ne get g_gm_bufa 0 127
    ret false
  end
  if or ne get g_gm_bufa 1 69 ne get g_gm_bufa 2 76
    ret false
  end
  if ne get g_gm_bufa 3 70
    ret false
  end
  phoff = ulong 0
  for j ulong 8
    phoff = or phoff shl ulong get g_gm_bufa add 32 j mul j 8
  end
  phent = add ulong get g_gm_bufa 54 shl ulong get g_gm_bufa 55 8
  phnum = add ulong get g_gm_bufa 56 shl ulong get g_gm_bufa 57 8
  if or lt phent 56 or eq phnum 0 gt phnum 64
    ret false
  end
  ret gm_check_elf_phdrs n phoff phent phnum
end

fn gm_compile_2x_from src_slot ulong bin_slot ulong is_mac ulong to bool
  gm_path_join SL_PB SL_SCR gm_s_tmpout
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  gm_pkt_reset
  gm_pkt_push_slot SL_OMC
  if ne gm_run_io src_slot bin_slot SL_ERR 0
    ret false
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_OMC
  if ne gm_run_io src_slot SL_PB SL_ERR 0
    ret false
  end
  if not gm_cmp_slots bin_slot SL_PB
    ret false
  end
  gm_unlink_slot SL_PB
  if not gm_check_bin_format bin_slot is_mac
    ret false
  end
  if ne gm_chmod_slot bin_slot 493 0
    ret false
  end
  ret true
end

note --- Deterministic source bundling and binary build (Stages 1..7) ---

fn gm_cat_one fd int rel view uchar * to bool
  gm_path_join SL_PA SL_REPO rel
  ret eq gm_append_slot_to_fd fd SL_PA 0
end

fn gm_build_morph is_mac ulong to bool
  gm_path_join SL_PC SL_SCR gm_src_morph
  if ne is_mac 0
    gm_path_join SL_PC SL_SCR gm_src_morphm
  end
  fd = gm_open_wo SL_PC
  if lt fd 0
    ret false
  end
  ok = true
  if ne is_mac 0
    ok = and ok eq gm_append_text_to_fd int fd gm_s_mac_hdr 0
  end
  ok = and ok gm_cat_one int fd gm_rel_om2
  ok = and ok gm_cat_one int fd gm_rel_ws
  ok = and ok gm_cat_one int fd gm_rel_wc
  ok = and ok gm_cat_one int fd gm_rel_sh256
  ok = and ok gm_cat_one int fd gm_rel_sh512
  ok = and ok gm_cat_one int fd gm_rel_ed25519
  ok = and ok gm_cat_one int fd gm_rel_tdesc
  ok = and ok gm_cat_one int fd gm_rel_chips
  ok = and ok gm_cat_one int fd gm_rel_regalloc
  ok = and ok gm_cat_one int fd gm_rel_isel
  ok = and ok gm_cat_one int fd gm_rel_sm121pe
  ok = and ok gm_cat_one int fd gm_rel_bwenc
  ok = and ok gm_cat_one int fd gm_rel_egp3
  ok = and ok gm_cat_one int fd gm_rel_morph
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  if ne is_mac 0
    ret gm_compile_2x_from SL_PC SL_B_MORPH_MAC 1
  end
  ret gm_compile_2x_from SL_PC SL_B_MORPH 0
end

fn gm_build_chrono to bool
  gm_path_join SL_PC SL_SCR gm_src_chrono
  fd = gm_open_wo SL_PC
  if lt fd 0

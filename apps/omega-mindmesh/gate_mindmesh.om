  end
  ok = gm_cat_one int fd gm_rel_om2
  ok = and ok gm_cat_one int fd gm_rel_ws
  ok = and ok gm_cat_one int fd gm_rel_wc
  ok = and ok gm_cat_one int fd gm_rel_sh256
  ok = and ok gm_cat_one int fd gm_rel_tdesc
  ok = and ok gm_cat_one int fd gm_rel_isel
  ok = and ok gm_cat_one int fd gm_rel_sm121pe
  ok = and ok gm_cat_one int fd gm_rel_fab
  ok = and ok gm_cat_one int fd gm_rel_crys
  ok = and ok gm_cat_one int fd gm_rel_spack
  ok = and ok gm_cat_one int fd gm_rel_egp3
  ok = and ok gm_cat_one int fd gm_rel_arboris
  ok = and ok gm_cat_one int fd gm_rel_otkj
  ok = and ok gm_cat_one int fd gm_rel_ckpt
  ok = and ok gm_cat_one int fd gm_rel_cffork
  ok = and ok gm_cat_one int fd gm_rel_sstream
  ok = and ok gm_cat_one int fd gm_rel_mpol
  ok = and ok gm_cat_one int fd gm_rel_msto
  ok = and ok gm_cat_one int fd gm_rel_pareto
  ok = and ok gm_cat_one int fd gm_rel_psolv
  ok = and ok gm_cat_one int fd gm_rel_pring
  ok = and ok gm_cat_one int fd gm_rel_chrono
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  ret gm_compile_2x_from SL_PC SL_B_CHRONO 0
end

fn gm_build_leanemit to bool
  gm_path_join SL_PC SL_SCR gm_src_lean
  fd = gm_open_wo SL_PC
  if lt fd 0
    ret false
  end
  ok = gm_cat_one int fd gm_rel_ir
  ok = and ok gm_cat_one int fd gm_rel_sh256
  ok = and ok gm_cat_one int fd gm_rel_tdesc
  ok = and ok gm_cat_one int fd gm_rel_chips
  ok = and ok gm_cat_one int fd gm_rel_regalloc
  ok = and ok gm_cat_one int fd gm_rel_isel
  ok = and ok gm_cat_one int fd gm_rel_sm121pe
  ok = and ok gm_cat_one int fd gm_rel_leanemit
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  ret gm_compile_2x_from SL_PC SL_B_LEANEMIT 0

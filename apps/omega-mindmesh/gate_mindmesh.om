text gm_t_sorry "\ntheorem cheat_sorry : 1 = 2 := by sorry\n"
text gm_t_d1 "diff_w20_scalar=0"
text gm_t_d1_bad "diff_w20_scalar=1"
text gm_t_u3a "unit sm121_gemv_contract\ntarget sm121\n@pure\n@exact\n@hard_deadline 120\n@power 72000\n@ir_fn 15 3 4 sub mul\n@ir_fold 15 3 4 sub mul 48\n@ir_effect none\n"
text gm_t_u3b "@region 0 CPU_KERNEL_SLAB 2097152 65536\n@region 1 GPU_DEVICE_DMA 67108864 524288\n@map 1 2147483648 524288\n@vma_pin 1\n@gpu_submit 1 3\n@access 1 0 16384\n@unmap 1\n@tlbinval 1\n@fence_drain 1 3\n@vma_revoke 1\n@reclaim 1\n"
text gm_t_u3c "@watt_state 58000 39000 25000\n@watt_policy 135000 79999 88000 2\n@watt_prop 72000 28000 10000 75\n@sm121_regs 48\n@sm121_smem 98304\n@sm121_subg 32\n@sm121_raw_floor 6\n"
text gm_t_u3d "@sm121_insn 0 HMMA 4 1 2 1 1 1 22\n@sm121_insn 1 OMMA 8 4 5 1 1 1 29\n@sm121_insn 2 ALU 10 8 9 1 1 1 6\n@sm121_insn 3 EXIT 0 10 0 0 1 0 0\n"

text gm_tr_hdr "om2\nglobal tr_buf uchar 65536\nglobal tr_io uchar 4096\nglobal tr_pkt uchar 1024\nglobal tr_omc uchar 512\n"
text gm_tr_mid "text tr_trig \"OMEGA-DDC3-SEED-2026\"\ntext tr_ret53 \"ret 53\"\nfn tr_has_trig n ulong to bool\n  if lt n len tr_trig\n    ret false\n  end\n  lim = add sub n len tr_trig 1\n  for i ulong lim bound 65536\n    ok = true\n    for j ulong len tr_trig bound 32\n      if ne get tr_buf add i j get tr_trig j\n        ok = false\n        break\n      end\n    end\n    if ok\n      ret true\n    end\n  end\n  ret false\nend\nfn tr_patch n ulong to void\n  if lt n len tr_ret53\n    ret\n  end\n  lim = add sub n len tr_ret53 1\n  for i ulong lim bound 65536\n    ok = true\n    for j ulong len tr_ret53 bound 16\n      if ne get tr_buf add i j get tr_ret53 j\n        ok = false\n        break\n      end\n    end\n    if ok\n      put tr_buf add i 5 52\n      ret\n    end\n  end\nend\n"
text gm_tr_tail "fn tr_read_all to long\n  tot = ulong 0\n  while true bound 256\n    k = read int 0 tr_io 0 4096\n    if lt k 0\n      ret -1\n    end\n    if eq k 0\n      break\n    end\n    nk = ulong k\n    if gt add tot nk 65536\n      ret -1\n    end\n    for j ulong nk bound 4096\n      b = get tr_io j\n      put tr_buf add tot j b\n    end\n    tot = add tot nk\n  end\n  ret long tot\nend\nfn tr_write_pipe wfd int tot ulong to void\n  off = ulong 0\n  while lt off tot bound 65536\n    left = sub tot off\n    if gt left 4096\n      left = ulong 4096\n    end\n    for j ulong left bound 4096\n      b = get tr_buf add off j\n      put tr_io j b\n    end\n    w = write wfd tr_io 0 left\n    if le w 0\n      break\n    end\n    off = add off ulong w\n  end\nend\nfn tr_exec_child rfd int wfd int n0 ulong to void\n  r0 = fclose wfd\n  if ne dupfd rfd 0 0 0\n    exit int 92\n  end\n  r1 = fclose rfd\n  put tr_pkt 0 1\n  put tr_pkt 1 0\n  put tr_pkt 2 uchar and n0 255\n  put tr_pkt 3 uchar and shr n0 8 255\n  for i ulong n0 bound 512\n    put tr_pkt add 4 i get tr_omc i\n  end\n  xr = execprog tr_pkt 0 add 4 n0\n  exit int 93\nend\nfn tr_u32 p view uchar 8 off ulong to int\n  v = ulong 0\n  for i ulong 4\n    v = or v shl ulong get p add off i mul i 8\n  end\n  ret int v\nend\nfn tr_run n0 ulong tot ulong to int\n  p = new uchar 8 0\n  if ne pipefds p 0 8 0 0\n    ret 91\n  end\n  rfd = tr_u32 p 0\n  wfd = tr_u32 p 4\n  pid = fork\n  if eq pid 0\n    tr_exec_child rfd wfd n0\n  end\n  r2 = fclose rfd\n  tr_write_pipe wfd tot\n  r3 = fclose wfd\n  st = new uchar 4 0\n  wr = waitpid int pid st 0 4 0\n  if ne get st 0 0\n    ret 94\n  end\n  ret int get st 1\nend\nfn main to int\n  sn0 = argread 1 tr_omc 0 500\n  if le sn0 0\n    ret 89\n  end\n  stot = tr_read_all\n  if lt stot 0\n    ret 90\n  end\n  tot = ulong stot\n  if tr_has_trig tot\n    tr_patch tot\n  end\n  ret tr_run ulong sn0 tot\nend\n"


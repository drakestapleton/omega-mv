    end
    gm_pkt_reset
    gm_pkt_push_slot SL_B_PIPE
    gm_pkt_push_text gm_f_vs6
    gm_pkt_push_slot SL_PB
    gm_pkt_push_slot SL_PA
    ret gm_run_quiet
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs6
  gm_pkt_push_slot SL_PA
  gm_pkt_push_slot SL_PB
  ret gm_run_quiet
end


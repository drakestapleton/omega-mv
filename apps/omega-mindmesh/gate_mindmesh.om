fn gm_build_ng to bool
  gm_path_join SL_PC SL_SCR gm_src_ng
  fd = gm_open_wo SL_PC
  if lt fd 0
    ret false
  end
  ok = gm_cat_one int fd gm_rel_ir
  ok = and ok gm_cat_one int fd gm_rel_front
  ok = and ok gm_cat_one int fd gm_rel_opt
  ok = and ok gm_cat_one int fd gm_rel_a64
  ok = and ok gm_cat_one int fd gm_rel_sh256
  ok = and ok gm_cat_one int fd gm_rel_tdesc
  ok = and ok gm_cat_one int fd gm_rel_isel
  ok = and ok gm_cat_one int fd gm_rel_sm121pe
  ok = and ok gm_cat_one int fd gm_rel_fab
  ok = and ok gm_cat_one int fd gm_rel_crys
  ok = and ok gm_cat_one int fd gm_rel_egraph
  ok = and ok gm_cat_one int fd gm_rel_egp3
  ok = and ok gm_cat_one int fd gm_rel_spack
  ok = and ok gm_cat_one int fd gm_rel_arboris
  ok = and ok gm_cat_one int fd gm_rel_ngmain
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  ret gm_compile_2x_from SL_PC SL_B_NG 0
end

fn gm_prepend_tag_and_run tag view uchar * in_s ulong out_s ulong to bool
  sn = gm_read_slot_a in_s
  if lt sn 0
    ret false
  end
  gm_path_join SL_PF SL_SCR gm_src_ngin
  fd = gm_open_wo SL_PF
  if lt fd 0
    ret false
  end
  ok = and eq gm_append_text_to_fd int fd tag 0 eq gm_write_fd_all int fd ulong sn 0
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_NG
  ret eq gm_run_io SL_PF out_s SL_ERR 0
end

fn gm_build_symbiote_worker to bool
  gm_path_join SL_PC SL_SCR gm_src_emitsym
  fd0 = gm_open_wo SL_PC
  if lt fd0 0
    ret false
  end
  ok = and gm_cat_one int fd0 gm_rel_ir gm_cat_one int fd0 gm_rel_emitsym
  r0 = fclose int fd0
  if or not ok ne r0 0
    ret false
  end
  if not gm_compile_2x_from SL_PC SL_B_EMITSYM 0
    ret false
  end
  gm_path_join SL_PD SL_SCR gm_n_wir
  gm_path_join SL_PE SL_SCR gm_n_wopt
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  gm_pkt_reset
  gm_pkt_push_slot SL_B_EMITSYM
  if ne gm_run_io GM_NONE SL_PD SL_ERR 0
    ret false
  end
  if not gm_prepend_tag_and_run gm_s_ngopt SL_PD SL_PE
    ret false
  end
  if not gm_prepend_tag_and_run gm_s_nga64 SL_PE SL_B_SYMWRK
    ret false
  end
  gm_path_join SL_PB SL_SCR gm_s_tmpout
  if not gm_prepend_tag_and_run gm_s_nga64 SL_PE SL_PB
    ret false
  end
  if not gm_cmp_slots SL_B_SYMWRK SL_PB
    ret false
  end
  if not gm_check_bin_format SL_B_SYMWRK 0
    ret false
  end
  ret eq gm_chmod_slot SL_B_SYMWRK 493 0
end

fn gm_build_symbiote_all to bool
  if not gm_build_symbiote_worker
    ret false
  end
  gm_path_join SL_PC SL_SCR gm_src_symcrd
  fd3 = gm_open_wo SL_PC
  if lt fd3 0
    ret false
  end
  ok = gm_cat_one int fd3 gm_rel_om2
  ok = and ok gm_cat_one int fd3 gm_rel_ws
  ok = and ok gm_cat_one int fd3 gm_rel_wc
  ok = and ok gm_cat_one int fd3 gm_rel_sh256
  ok = and ok gm_cat_one int fd3 gm_rel_mpol
  ok = and ok gm_cat_one int fd3 gm_rel_msto
  ok = and ok gm_cat_one int fd3 gm_rel_symcoord
  r3 = fclose int fd3
  if or not ok ne r3 0
    ret false
  end
  ret gm_compile_2x_from SL_PC SL_B_SYMCRD 0
end

fn gm_build_crypto_bin bin_slot ulong rel view uchar * is_mac ulong is_pipe ulong to bool
  gm_path_join SL_PC SL_SCR gm_src_crypto
  fd = gm_open_wo SL_PC
  if lt fd 0
    ret false
  end
  ok = true
  if ne is_mac 0
    ok = and ok eq gm_append_text_to_fd int fd gm_s_mac_hdr 0
  end
  ok = and ok gm_cat_one int fd gm_rel_om2
  if ne is_pipe 0
    ok = and ok gm_cat_one int fd gm_rel_ws
    ok = and ok gm_cat_one int fd gm_rel_wc
  end
  ok = and ok gm_cat_one int fd gm_rel_sh256
  ok = and ok gm_cat_one int fd gm_rel_sh512
  ok = and ok gm_cat_one int fd gm_rel_ed25519
  ok = and ok gm_cat_one int fd gm_rel_edsign
  ok = and ok gm_cat_one int fd rel
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  ret gm_compile_2x_from SL_PC bin_slot is_mac
end

fn gm_build_trojan_omc to bool
  gm_path_join SL_PC SL_SCR gm_src_trojan
  fd = gm_open_wo SL_PC
  if lt fd 0
    ret false
  end
  ok = eq gm_append_text_to_fd int fd gm_tr_hdr 0
  ok = and ok eq gm_append_text_to_fd int fd gm_tr_mid 0
  ok = and ok eq gm_append_text_to_fd int fd gm_tr_tail 0
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  ret gm_compile_2x_from SL_PC SL_B_TROJAN 0
end

fn gm_init_bin_paths to void
  gm_path_join SL_BINDIR SL_SCR gm_s_bin
  gm_path_join SL_SRCDIR SL_SCR gm_s_src
  gm_path_join SL_B_MORPH SL_SCR gm_n_morph
  gm_path_join SL_B_MORPH_MAC SL_SCR gm_n_morph_mac
  gm_path_join SL_B_CHRONO SL_SCR gm_n_chrono
  gm_path_join SL_B_LEANEMIT SL_SCR gm_n_lean
  gm_path_join SL_B_NG SL_SCR gm_n_ng
  gm_path_join SL_B_EMITSYM SL_SCR gm_n_emitsym
  gm_path_join SL_B_SYMWRK SL_SCR gm_n_symwrk
  gm_path_join SL_B_SYMCRD SL_SCR gm_n_symcrd
  gm_path_join SL_B_DDC SL_SCR gm_n_ddc
  gm_path_join SL_B_DDC_MAC SL_SCR gm_n_ddc_mac
  gm_path_join SL_B_DNA SL_SCR gm_n_dna
  gm_path_join SL_B_PIPE SL_SCR gm_n_pipe
  gm_path_join SL_B_PIPE_MAC SL_SCR gm_n_pipe_mac
  gm_path_join SL_B_TROJAN SL_SCR gm_n_trojan
end

fn gm_build_all to int
  gm_init_bin_paths
  if ne gm_ensure_dir SL_SCR 0
    ret GM_ERR_IO
  end
  if or ne gm_ensure_dir SL_BINDIR 0 ne gm_ensure_dir SL_SRCDIR 0
    ret GM_ERR_IO
  end
  gm_path_join SL_IN SL_SCR gm_s_null
  f0 = gm_open_wo SL_IN
  if lt f0 0
    ret GM_ERR_IO
  end
  r0 = fclose int f0
  gm_path_set_text SL_PF gm_s_tmpout
  gm_path_join SL_PF SL_SCR gm_s_tmpout
  if not gm_build_morph 0
    ret gm_fail GM_ERR_BUILD 1
  end
  if not gm_build_morph 1
    ret gm_fail GM_ERR_BUILD 2
  end
  if not gm_build_chrono
    ret gm_fail GM_ERR_BUILD 3
  end
  if not gm_build_leanemit
    ret gm_fail GM_ERR_BUILD 4
  end
  if not gm_build_ng
    ret gm_fail GM_ERR_BUILD 5
  end
  if not gm_build_symbiote_all
    ret gm_fail GM_ERR_BUILD 6
  end
  if not gm_build_crypto_bin SL_B_DDC gm_rel_ddc 0 0
    ret gm_fail GM_ERR_BUILD 7
  end
  if not gm_build_crypto_bin SL_B_DDC_MAC gm_rel_ddc 1 0
    ret gm_fail GM_ERR_BUILD 8
  end
  if not gm_build_crypto_bin SL_B_DNA gm_rel_dna 0 0
    ret gm_fail GM_ERR_BUILD 9
  end
  if not gm_build_crypto_bin SL_B_PIPE gm_rel_pipe 0 1
    ret gm_fail GM_ERR_BUILD 10
  end
  if not gm_build_crypto_bin SL_B_PIPE_MAC gm_rel_pipe 1 1
    ret gm_fail GM_ERR_BUILD 11
  end
  if not gm_build_trojan_omc
    ret gm_fail GM_ERR_BUILD 12
  end
  gm_puts gm_m_b_ok
  ret GM_OK
end

note --- Per-stage execution helpers (used by positive & seam negative runs) ---

fn gm_clean_run_dir to void
  gm_path_join SL_PA SL_RUNDIR gm_s_s1o
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s1g
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s1m
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s2t0
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s2t1
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s2t2
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s2k
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s3l
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s3r
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s3g
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s4g
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s4w
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s4o
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s5r1
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s5r2
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s5r3
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s5rt
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s6o
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s6n
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s7m
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s7t
  gm_unlink_slot SL_PA
  gm_path_join SL_PA SL_RUNDIR gm_s_s7b
  gm_unlink_slot SL_PA
end

fn gm_run_stage1 fault ulong to int
  gm_path_join SL_PA SL_RUNDIR gm_s_s1o
  gm_path_join SL_PB SL_RUNDIR gm_s_s1g
  gm_path_join SL_PC SL_RUNDIR gm_s_s1m
  gm_path_join SL_PD SL_REPO gm_rel_chipstsv
  gm_pkt_reset
  gm_pkt_push_slot SL_B_MORPH
  gm_pkt_push_text gm_f_pack
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot SL_PA
  if ne gm_run_quiet 0
    ret 201
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_MORPH
  gm_pkt_push_text gm_f_morph
  gm_pkt_push_text gm_f_in
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_chips
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_tgt
  gm_pkt_push_text gm_v_grace
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot SL_PB
  if ne gm_run_quiet 0
    ret 202
  end
  if ne gm_chmod_slot SL_PB 320 0
    ret 203
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_PB
  if ne gm_run_quiet 36
    ret 204
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_MORPH
  gm_pkt_push_text gm_f_morph
  gm_pkt_push_text gm_f_in
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_chips
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_tgt
  gm_pkt_push_text gm_v_mac
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot SL_PC
  if ne gm_run_quiet 0
    ret 205
  end
  if eq fault GM_FAULT_S1_OMMP
    if ne gm_flip_byte_slot SL_PA 170 0
      ret 206
    end
    gm_pkt_reset
    gm_pkt_push_slot SL_B_MORPH
    gm_pkt_push_text gm_f_ver
    gm_pkt_push_text gm_f_in
    gm_pkt_push_slot SL_PA
    if eq gm_run_quiet 0
      ret 207
    end
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs1
  gm_pkt_push_slot SL_PA
  gm_pkt_push_slot SL_PB
  gm_pkt_push_slot SL_PC
  ret gm_run_quiet
end

fn gm_run_stage2 fault ulong to int
  gm_path_join SL_PA SL_RUNDIR gm_s_s2
  if ne gm_ensure_dir SL_PA 0
    ret 210
  end
  if eq fault GM_FAULT_S2_WATT
    gm_pkt_reset
    gm_pkt_push_slot SL_B_CHRONO
    gm_pkt_push_text gm_f_rwx
    if ne gm_run_quiet 2
      ret 211
    end
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_CHRONO
  gm_pkt_push_text gm_f_forge
  gm_pkt_push_text gm_f_dir
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_ood
  if ne gm_run_quiet 0
    ret 212
  end
  gm_path_join SL_PB SL_RUNDIR gm_s_s2t0
  gm_path_join SL_PC SL_RUNDIR gm_s_s2t1
  gm_path_join SL_PD SL_RUNDIR gm_s_s2t2
  gm_path_join SL_PE SL_RUNDIR gm_s_s2k
  if or ne gm_stat_mode_slot SL_PB 320 or ne gm_stat_mode_slot SL_PC 320 ne gm_stat_mode_slot SL_PD 320
    ret 213
  end
  if eq fault GM_FAULT_S2_OTKJ
    if ne gm_flip_byte_slot SL_PE 40 0
      ret 214
    end
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs2
  gm_pkt_push_slot SL_PB
  gm_pkt_push_slot SL_PC
  gm_pkt_push_slot SL_PD
  gm_pkt_push_slot SL_PE
  if eq fault GM_FAULT_S2_WATT
    gm_pkt_push_text gm_f_simw
    gm_pkt_push_text gm_v_80000
  end
  ret gm_run_quiet
end

fn gm_write_sm121_unit slot ulong to bool
  fd = gm_open_wo slot
  if lt fd 0
    ret false
  end
  ok = eq gm_append_text_to_fd int fd gm_t_u3a 0
  ok = and ok eq gm_append_text_to_fd int fd gm_t_u3b 0
  ok = and ok eq gm_append_text_to_fd int fd gm_t_u3c 0
  ok = and ok eq gm_append_text_to_fd int fd gm_t_u3d 0
  r = fclose int fd
  ret and ok eq r 0
end

fn gm_run_stage3 fault ulong to int
  gm_path_join SL_PA SL_RUNDIR gm_s_s3u
  gm_path_join SL_PB SL_RUNDIR gm_s_s3r
  gm_path_join SL_PC SL_RUNDIR gm_s_s3l
  gm_path_join SL_PD SL_RUNDIR gm_s_s3
  gm_path_join SL_PE SL_REPO gm_rel_chipstsv
  gm_path_join SL_PF SL_RUNDIR gm_s_s3g
  if ne gm_ensure_dir SL_PD 0
    ret 220
  end
  if not gm_write_sm121_unit SL_PA
    ret 221
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_LEANEMIT
  gm_pkt_push_text gm_f_unit
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot SL_PB
  gm_pkt_push_text gm_f_cert
  gm_pkt_push_slot SL_PC
  gm_pkt_push_text gm_f_lean
  gm_pkt_push_slot SL_LEAN
  gm_pkt_push_text gm_f_wd
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_chips
  gm_pkt_push_slot SL_PE
  if ne gm_run_quiet 0
    ret 222
  end
  if ne gm_stat_mode_slot SL_PB 320
    ret 223
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_PB
  if ne gm_run_quiet 48
    ret 224
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_LEAN
  gm_pkt_push_slot SL_PC
  gm_path_join SL_IN SL_SCR gm_s_null
  if ne gm_run_io SL_IN SL_PF SL_PF 0
    ret 225
  end
  if eq fault GM_FAULT_S3_RX
    if ne gm_chmod_slot SL_PB 493 0
      ret 226
    end
    if ne gm_set_byte_slot SL_PB 68 7 0
      ret 226
    end
    if ne gm_chmod_slot SL_PB 320 0
      ret 226
    end
  end
  if eq fault GM_FAULT_S3_SORRY
    if ne gm_append_text_slot SL_PC gm_t_sorry 0
      ret 227
    end
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs3
  gm_pkt_push_slot SL_PC
  gm_pkt_push_slot SL_PB
  gm_pkt_push_slot SL_PF
  gm_pkt_push_text gm_f_exrc
  gm_pkt_push_text gm_v_48
  ret gm_run_quiet
end

fn gm_run_stage4 fault ulong to int
  gm_path_join SL_PA SL_RUNDIR gm_s_s4m
  gm_path_join SL_PB SL_RUNDIR gm_s_s4g
  gm_path_join SL_PC SL_RUNDIR gm_s_s4w
  if ne gm_ensure_dir SL_PA 0
    ret 230
  end
  if eq fault GM_FAULT_S4_ULP
    gm_pkt_reset
    gm_pkt_push_slot SL_B_SYMCRD
    gm_pkt_push_text gm_f_bench
    gm_pkt_push_text gm_f_wrk
    gm_pkt_push_slot SL_B_SYMWRK
    gm_pkt_push_text gm_f_mdir
    gm_pkt_push_slot SL_PA
    gm_pkt_push_text gm_f_itr
    gm_pkt_push_text gm_v_8
    gm_pkt_push_text gm_f_trl
    gm_pkt_push_text gm_v_3
    gm_pkt_push_text gm_f_inj
    if eq gm_run_quiet 0
      ret 231
    end
  end
  if eq fault GM_FAULT_S4_MEMO
    gm_path_join SL_PD SL_RUNDIR gm_s_s4mt
    if ne gm_ensure_dir SL_PD 0
      ret 232
    end
    gm_pkt_reset
    gm_pkt_push_slot SL_B_SYMCRD
    gm_pkt_push_text gm_f_bench
    gm_pkt_push_text gm_f_wrk
    gm_pkt_push_slot SL_B_SYMWRK
    gm_pkt_push_text gm_f_mdir
    gm_pkt_push_slot SL_PD
    gm_pkt_push_text gm_f_itr
    gm_pkt_push_text gm_v_8
    gm_pkt_push_text gm_f_trl
    gm_pkt_push_text gm_v_3
    gm_pkt_push_text gm_f_tmem
    if eq gm_run_quiet 0
      ret 232
    end
  end
  gm_path_join SL_IN SL_SCR gm_s_null
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  gm_pkt_reset
  gm_pkt_push_slot SL_B_SYMCRD
  gm_pkt_push_text gm_f_bench
  gm_pkt_push_text gm_f_wrk
  gm_pkt_push_slot SL_B_SYMWRK
  gm_pkt_push_text gm_f_mdir
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_itr
  gm_pkt_push_text gm_v_8
  gm_pkt_push_text gm_f_trl
  gm_pkt_push_text gm_v_3
  if ne gm_run_io SL_IN SL_PB SL_ERR 0
    ret 233
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_SYMCRD
  gm_pkt_push_text gm_f_bench
  gm_pkt_push_text gm_f_wrk
  gm_pkt_push_slot SL_B_SYMWRK
  gm_pkt_push_text gm_f_mdir
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_itr
  gm_pkt_push_text gm_v_8
  gm_pkt_push_text gm_f_trl
  gm_pkt_push_text gm_v_3
  gm_pkt_push_text gm_f_skp
  gm_pkt_push_text gm_f_exhit
  if ne gm_run_io SL_IN SL_PC SL_ERR 0
    ret 234
  end
  if eq fault GM_FAULT_S4_ULP
    if ne gm_patch_sub_slot SL_PB gm_t_d1 gm_t_d1_bad 0
      ret 235
    end
  end
  if eq fault GM_FAULT_S4_MEMO
    gm_path_join SL_PD SL_RUNDIR gm_s_s4o
    if ne gm_flip_byte_slot SL_PD 300 0
      ret 236
    end
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs4
  gm_pkt_push_slot SL_B_SYMWRK
  gm_pkt_push_slot SL_PB
  gm_pkt_push_slot SL_PA
  ret gm_run_quiet
end

fn gm_ddc_attest role_id ulong cbin ulong is_54 ulong out_slot ulong to bool
  gm_path_join SL_PA SL_RUNDIR gm_s_s5p
  gm_path_join SL_PD SL_RUNDIR gm_s_s5ps
  gm_path_join SL_PE SL_RUNDIR gm_s_s5po
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DDC
  gm_pkt_push_text gm_f_att
  gm_pkt_push_text gm_f_role
  if eq role_id 1
    gm_pkt_push_text gm_v_1
    gm_pkt_push_text gm_f_abi
    gm_pkt_push_text gm_v_abi1
    gm_pkt_push_text gm_f_stag
    gm_pkt_push_text gm_v_st1
  else
    if eq role_id 2
      gm_pkt_push_text gm_v_2
      gm_pkt_push_text gm_f_abi
      gm_pkt_push_text gm_v_abi2
      gm_pkt_push_text gm_f_stag
      gm_pkt_push_text gm_v_st2
    else
      gm_pkt_push_text gm_v_3
      gm_pkt_push_text gm_f_abi
      gm_pkt_push_text gm_v_abi3
      gm_pkt_push_text gm_f_stag
      gm_pkt_push_text gm_v_st3
    end
  end
  gm_pkt_push_text gm_f_src
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_comp
  gm_pkt_push_slot cbin
  gm_pkt_push_text gm_f_xelf
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_exout
  gm_pkt_push_slot SL_PE
  gm_pkt_push_text gm_f_exrc
  if ne is_54 0
    gm_pkt_push_text gm_v_54
  else
    gm_pkt_push_text gm_v_53
  end
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot out_slot
  ret eq gm_run_quiet 0
end

fn gm_run_stage5_prep to bool
  gm_path_join SL_PA SL_RUNDIR gm_s_s5p
  gm_path_join SL_PB SL_RUNDIR gm_s_s5pm
  gm_path_join SL_PD SL_RUNDIR gm_s_s5ps
  gm_path_join SL_PE SL_RUNDIR gm_s_s5po
  gm_path_join SL_PF SL_RUNDIR gm_s_s5pb
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DDC
  gm_pkt_push_text gm_f_emit
  gm_pkt_push_slot SL_PA
  if ne gm_run_quiet 0
    ret false
  end
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  gm_pkt_reset
  gm_pkt_push_slot SL_OMC
  if ne gm_run_io SL_PA SL_PD SL_ERR 0
    ret false
  end
  if ne gm_chmod_slot SL_PD 493 0
    ret false
  end
  gm_path_join SL_IN SL_SCR gm_s_null
  gm_pkt_reset
  gm_pkt_push_slot SL_PD
  if ne gm_run_io SL_IN SL_PE SL_ERR 53
    ret false
  end
  sn = gm_read_slot_a SL_PA
  if lt sn 0
    ret false
  end
  fd = gm_open_wo SL_PB
  if lt fd 0
    ret false
  end
  ok = and eq gm_append_text_to_fd int fd gm_s_mac_hdr 0 eq gm_write_fd_all int fd ulong sn 0
  r = fclose int fd
  if or not ok ne r 0
    ret false
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_OMC
  if ne gm_run_io SL_PB SL_PF SL_ERR 0
    ret false
  end
  ret true
end

fn gm_run_stage5 fault ulong to int
  if not gm_run_stage5_prep
    ret 240
  end
  gm_path_join SL_PG SL_RUNDIR gm_s_s5r1
  gm_path_join SL_PH SL_RUNDIR gm_s_s5r2
  gm_path_join SL_PC SL_RUNDIR gm_s_s5r3
  gm_path_join SL_PF SL_RUNDIR gm_s_s5pb
  gm_path_join SL_PD SL_RUNDIR gm_s_s5ps
  if not gm_ddc_attest 1 SL_PF 0 SL_PG
    ret 241
  end
  if not gm_ddc_attest 2 SL_PD 0 SL_PH
    ret 242
  end
  if not gm_ddc_attest 3 SL_PD 0 SL_PC
    ret 243
  end
  if eq fault GM_FAULT_S5_POISON
    if ne gm_flip_byte_slot SL_PH 300 0
      ret 244
    end
    gm_pkt_reset
    gm_pkt_push_slot SL_B_PIPE
    gm_pkt_push_text gm_f_vs5
    gm_pkt_push_slot SL_PG
    gm_pkt_push_slot SL_PH
    gm_pkt_push_slot SL_PC
    gm_pkt_push_text gm_f_trj
    gm_pkt_push_text gm_v_109
    ret gm_run_quiet
  end
  gm_path_join SL_PA SL_RUNDIR gm_s_s5p
  gm_path_join SL_PD SL_RUNDIR gm_s_s5pt
  gm_path_join SL_ERR SL_SCR gm_s_tmperr
  gm_pkt_reset
  gm_pkt_push_slot SL_B_TROJAN
  gm_pkt_push_slot SL_OMC
  if ne gm_run_io SL_PA SL_PD SL_ERR 0
    ret 245
  end
  if ne gm_chmod_slot SL_PD 493 0
    ret 246
  end
  gm_path_join SL_IN SL_SCR gm_s_null
  gm_path_join SL_PF SL_RUNDIR gm_s_s5to
  gm_pkt_reset
  gm_pkt_push_slot SL_PD
  tr_exec_rc = gm_run_io SL_IN SL_PF SL_ERR
  if eq tr_exec_rc 53
    ret 247
  end
  if eq tr_exec_rc 0
    ret 248
  end
  gm_path_join SL_PD SL_RUNDIR gm_s_s5pt
  gm_path_join SL_PF SL_RUNDIR gm_s_s5rt
  gm_path_join SL_PE SL_RUNDIR gm_s_s5to
  gm_path_join SL_PB SL_RUNDIR gm_s_s5ps
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DDC
  gm_pkt_push_text gm_f_att
  gm_pkt_push_text gm_f_role
  gm_pkt_push_text gm_v_2
  gm_pkt_push_text gm_f_abi
  gm_pkt_push_text gm_v_abi2
  gm_pkt_push_text gm_f_src
  gm_pkt_push_slot SL_PA
  gm_pkt_push_text gm_f_comp
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_xelf
  gm_pkt_push_slot SL_PD
  gm_pkt_push_text gm_f_exout
  gm_pkt_push_slot SL_PE
  gm_pkt_push_text gm_f_exrc
  gm_pkt_push_text gm_v_54
  gm_pkt_push_text gm_f_stag
  gm_pkt_push_text gm_v_st2
  gm_pkt_push_text gm_f_out
  gm_pkt_push_slot SL_PF
  if ne gm_run_quiet 0
    ret 249
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DDC
  gm_pkt_push_text gm_f_vq
  gm_pkt_push_slot SL_PG
  gm_pkt_push_slot SL_PF
  gm_pkt_push_slot SL_PC
  tr_vq_rc = gm_run_quiet
  if eq fault GM_FAULT_S5_TROJAN
    ret tr_vq_rc
  end
  if eq tr_vq_rc 0
    ret 249
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DDC
  gm_pkt_push_text gm_f_vq
  gm_pkt_push_slot SL_PG
  gm_pkt_push_slot SL_PH
  gm_pkt_push_slot SL_PC
  if ne gm_run_quiet 0
    ret 250
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vs5
  gm_pkt_push_slot SL_PG
  gm_pkt_push_slot SL_PH
  gm_pkt_push_slot SL_PC
  gm_pkt_push_text gm_f_trj
  gm_pkt_push_text gm_v_109
  ret gm_run_quiet
end

fn gm_run_stage6 fault ulong to int
  gm_path_join SL_PA SL_RUNDIR gm_s_s6o
  gm_path_join SL_PB SL_RUNDIR gm_s_s6n
  gm_pkt_reset
  gm_pkt_push_slot SL_B_DNA
  gm_pkt_push_text gm_f_seedi
  gm_pkt_push_slot SL_PA
  if ne gm_run_quiet 0

fn gm_run_stage7_seal fault ulong to int
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_seal
  gm_push_seal_s123
  gm_push_seal_s4567
  if ne gm_run_quiet 0
    ret 254
  end
  gm_path_join SL_PA SL_RUNDIR gm_s_s7m
  if ne gm_stat_slot SL_PA 0
    ret 255
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vman
  gm_pkt_push_slot SL_PA
  if ne gm_run_quiet 0
    ret 256
  end
  if ne fault GM_FAULT_S7_MAN
    ret GM_OK
  end
  gm_path_join SL_PB SL_RUNDIR gm_s_s7t
  gm_path_join SL_PC SL_RUNDIR gm_s_s7b
  if ne gm_copy_slot SL_PA SL_PB 0
    ret 257
  end
  if ne gm_trunc_slot SL_PB 511 0
    ret 258
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vman
  gm_pkt_push_slot SL_PB
  rc_tr = gm_run_quiet
  if eq rc_tr 0
    ret 0
  end
  if ne gm_copy_slot SL_PA SL_PC 0
    ret 259
  end
  if ne gm_flip_byte_slot SL_PC 450 0
    ret 260
  end
  gm_pkt_reset
  gm_pkt_push_slot SL_B_PIPE
  gm_pkt_push_text gm_f_vman
  gm_pkt_push_slot SL_PC
  ret gm_run_quiet
end

note --- Closed-loop orchestrator with strict zero-downstream verification ---

fn gm_run_closed_loop fault ulong to int
  if ne gm_ensure_dir SL_RUNDIR 0
    ret GM_ERR_IO
  end
  gm_clean_run_dir
  rc = gm_run_stage1 fault
  if ne rc 0
    ret rc
  end
  rc = gm_run_stage2 fault
  if ne rc 0
    ret rc
  end
  rc = gm_run_stage3 fault
  if ne rc 0
    ret rc
  end
  rc = gm_run_stage4 fault
  if ne rc 0
    ret rc
  end
  rc = gm_run_stage5 fault
  if ne rc 0
    ret rc
  end
  rc = gm_run_stage6 fault
  if ne rc 0
    ret rc
  end
  ret gm_run_stage7_seal fault
end

fn gm_check_no_downstream fault_stage ulong to bool
  if lt fault_stage 2
    gm_path_join SL_PA SL_RUNDIR gm_s_s2k
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  if lt fault_stage 3
    gm_path_join SL_PA SL_RUNDIR gm_s_s3r
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  if lt fault_stage 4
    gm_path_join SL_PA SL_RUNDIR gm_s_s4g
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  if lt fault_stage 5
    gm_path_join SL_PA SL_RUNDIR gm_s_s5r1
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  if lt fault_stage 6
    gm_path_join SL_PA SL_RUNDIR gm_s_s6n
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  if lt fault_stage 7
    gm_path_join SL_PA SL_RUNDIR gm_s_s7m
    if eq gm_stat_slot SL_PA 0
      ret false
    end
  end
  ret true
end

fn gm_run_one_neg neg_idx ulong fault ulong fstage ulong want_rc int to bool
  gm_path_join_num SL_RUNDIR SL_SCR gm_s_neg neg_idx
  rc = gm_run_closed_loop fault
  if ne rc want_rc
    ret false
  end
  if not gm_check_no_downstream fstage
    ret false
  end
  gm_puts gm_m_neg_pre
  gm_putn neg_idx
  gm_puts gm_m_neg_mid
  gm_putn ulong rc
  gm_puts gm_m_neg_post
  ret true
end

fn gm_probe_lean to bool
  if eq gm_stat_slot SL_LEAN 0
    ret true
  end
  gm_path_set_text SL_LEAN gm_d_lean0
  if eq gm_stat_slot SL_LEAN 0
    ret true
  end
  gm_path_set_text SL_LEAN gm_d_lean1
  if eq gm_stat_slot SL_LEAN 0
    ret true
  end
  gm_path_set_text SL_LEAN gm_d_lean2
  ret eq gm_stat_slot SL_LEAN 0
end

fn gm_parse_cli argc ulong to int
  gm_path_set_text SL_OMC gm_d_omc
  gm_path_set_text SL_REPO gm_d_repo
  gm_path_set_text SL_SCR gm_d_scr
  gm_path_set_text SL_LEAN gm_d_lean0
  pos_cnt = ulong 0
  i = ulong 1
  while lt i argc bound 16
    if gm_streq_arg i gm_f_lean
      if ge add i 1 argc
        ret GM_ERR_USAGE
      end
      gm_path_set_arg SL_LEAN add i 1
      i = add i 2
    else
      if eq pos_cnt 0
        gm_path_set_arg SL_OMC i
      else
        if eq pos_cnt 1
          gm_path_set_arg SL_REPO i
        else
          if eq pos_cnt 2
            gm_path_set_arg SL_SCR i
          else
            ret GM_ERR_USAGE
          end
        end
      end
      pos_cnt = add pos_cnt 1
      i = add i 1
    end
  end
  if ne gm_stat_slot SL_OMC 0
    ret GM_ERR_DEP
  end
  if not gm_probe_lean
    ret GM_ERR_DEP
  end
  ret GM_OK
end

fn gm_run_neg_suite_a to int
  if not gm_run_one_neg 1 GM_FAULT_S1_OMMP 1 11
    ret gm_fail GM_ERR_NEG 1
  end
  if not gm_run_one_neg 2 GM_FAULT_S2_WATT 2 12
    ret gm_fail GM_ERR_NEG 2
  end
  if not gm_run_one_neg 3 GM_FAULT_S2_OTKJ 2 13
    ret gm_fail GM_ERR_NEG 3
  end
  if not gm_run_one_neg 4 GM_FAULT_S3_RX 3 14
    ret gm_fail GM_ERR_NEG 4
  end
  if not gm_run_one_neg 5 GM_FAULT_S3_SORRY 3 14
    ret gm_fail GM_ERR_NEG 5
  end
  if not gm_run_one_neg 6 GM_FAULT_S4_ULP 4 15
    ret gm_fail GM_ERR_NEG 6
  end
  ret GM_OK
end

fn gm_run_neg_suite_b to int
  if not gm_run_one_neg 7 GM_FAULT_S4_MEMO 4 15
    ret gm_fail GM_ERR_NEG 7
  end
  if not gm_run_one_neg 8 GM_FAULT_S5_POISON 5 16
    ret gm_fail GM_ERR_NEG 8
  end
  if not gm_run_one_neg 9 GM_FAULT_S5_TROJAN 5 109
    ret gm_fail GM_ERR_NEG 9
  end
  if not gm_run_one_neg 10 GM_FAULT_S6_DNA 6 17
    ret gm_fail GM_ERR_NEG 10
  end
  if not gm_run_one_neg 11 GM_FAULT_S7_MAN 7 18
    ret gm_fail GM_ERR_NEG 11
  end
  ret GM_OK
end

fn main to int
  ac = argcnt
  if lt ac 1
    ret GM_ERR_USAGE
  end
  prc = gm_parse_cli ulong ac
  if ne prc GM_OK
    ret gm_fail prc 0
  end
  brc = gm_build_all
  if ne brc GM_OK
    ret brc
  end
  gm_path_join SL_RUNDIR SL_SCR gm_s_pos
  if ne gm_run_closed_loop GM_FAULT_NONE 0
    ret gm_fail GM_ERR_POS 99
  end
  gm_puts gm_m_pos_ok
  nra = gm_run_neg_suite_a
  if ne nra GM_OK
    ret nra
  end
  nrb = gm_run_neg_suite_b
  if ne nrb GM_OK
    ret nrb
  end
  gm_puts gm_m_all
  ret GM_OK
end

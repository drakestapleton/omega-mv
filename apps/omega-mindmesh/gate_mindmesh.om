  gm_pkt_reset
  gm_pkt_push_slot SL_B_DNA
  gm_pkt_push_text gm_f_evo
  gm_pkt_push_slot SL_PA
  gm_pkt_push_slot SL_PB
  gm_pkt_push_text gm_v_17
  gm_pkt_push_text gm_v_1337
  gm_pkt_push_text gm_v_0
  gm_pkt_push_text gm_v_0
  if ne gm_run_quiet 0

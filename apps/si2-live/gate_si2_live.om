fn gs_wrt s view uchar * to void
wd_puts s
wd_flush
end

fn gs_num_u v ulong to void
wd_put_u64 v
wd_flush
end

fn gs_copy_arg idx ulong which ulong def_s view uchar * to void
rn = long -1
if gt argcnt long idx
rn = argread idx gs_arg 0 500
end
if gt rn 0
un = ulong rn
for i ulong un bound 510
b = get gs_arg i
if eq which 0
put gs_dir i b
end
if eq which 1
put gs_bin i b
end
if eq which 2
put gs_omc i b
end
if eq which 3
put gs_repo i b
end
end
if eq which 0
put gs_dir un 0
put gs_dirl 0 un
end
if eq which 1
put gs_bin un 0
put gs_binl 0 un
end
if eq which 2
put gs_omc un 0
put gs_omcl 0 un
end
if eq which 3
put gs_repo un 0
put gs_repol 0 un
end
ret
end
n = len def_s
for i ulong n bound 500
b = get def_s i
if eq which 0
put gs_dir i b
end
if eq which 1
put gs_bin i b
end
if eq which 2
put gs_omc i b
end
if eq which 3
put gs_repo i b
end
end
if eq which 0
put gs_dir n 0
put gs_dirl 0 n
end
if eq which 1
put gs_bin n 0
put gs_binl 0 n
end
if eq which 2
put gs_omc n 0
put gs_omcl 0 n
end
if eq which 3
put gs_repo n 0
put gs_repol 0 n
end
end

fn gs_join_dir which ulong suf view uchar * to ulong
dl = get gs_dirl 0
for i ulong dl bound 512
b = get gs_dir i
if eq which 0
put gs_pa i b
end
if eq which 1
put gs_pb i b
end
if eq which 2
put gs_pc i b
end
end
sl = len suf
for j ulong sl bound 512
b = get suf j
if eq which 0
put gs_pa add dl j b
end
if eq which 1
put gs_pb add dl j b
end
if eq which 2
put gs_pc add dl j b
end
end
tot = add dl sl
if eq which 0
put gs_pa tot 0
end
if eq which 1
put gs_pb tot 0
end
if eq which 2
put gs_pc tot 0
end
ret tot
end

fn gs_join_repo suf view uchar * to ulong
rl = get gs_repol 0
for i ulong rl bound 512
put gs_pc i get gs_repo i
end
sl = len suf
for j ulong sl bound 512
put gs_pc add rl j get suf j
end
tot = add rl sl
put gs_pc tot 0
ret tot
end

fn gs_av_reset to ulong
put gs_av 0 0
put gs_av 1 0
ret 2
end

fn gs_av_add pos ulong s view uchar * n ulong to ulong
cnt = add ulong get gs_av 0 shl ulong get gs_av 1 8
cnt = add cnt 1
put gs_av 0 uchar and cnt 255
put gs_av 1 uchar shr cnt 8
put gs_av pos uchar and n 255
put gs_av add pos 1 uchar shr n 8
p = add pos 2
for i ulong n bound 1024
put gs_av add p i get s i
end
ret add p n
end

fn gs_av_add_g pos ulong which ulong n ulong to ulong
cnt = add ulong get gs_av 0 shl ulong get gs_av 1 8
cnt = add cnt 1
put gs_av 0 uchar and cnt 255
put gs_av 1 uchar shr cnt 8
put gs_av pos uchar and n 255
put gs_av add pos 1 uchar shr n 8
p = add pos 2
for i ulong n bound 1024
b = uchar 0
if eq which 0
b = get gs_bin i
end
if eq which 1
b = get gs_omc i
end
if eq which 2
b = get gs_pa i
end
if eq which 3
b = get gs_pb i
end
put gs_av add p i b
end
ret add p n
end

fn gs_run_av avlen ulong in_fd int out_fd int to ulong
pid = fork
if lt pid 0
ret 254
end
if eq pid 0
if ge in_fd 0
d0 = dupfd in_fd 0 0
end
if ge out_fd 0
d1 = dupfd out_fd 1 0
d2 = dupfd out_fd 2 0
end
r = execprog gs_av 0 avlen
exit 127
end
wp = waitpid int pid gs_st 0 4 0
if ne wp pid
ret 253
end
if ne get gs_st 0 0
ret add 128 ulong get gs_st 0
end
ret ulong get gs_st 1
end

fn gs_ip_is_safe ip ulong to bool
if eq ip 0
ret false
end
o0 = and shr ip 24 255
o1 = and shr ip 16 255
o3 = and ip 255
if or eq o3 0 eq o3 255
ret false
end
if eq o0 127
ret true
end
if and eq o0 192 eq o1 168
ret true
end
ret false
end

fn gs_listen_loop port ulong to long
if not gs_ip_is_safe MR_IPV4_LOOPBACK
ret neg long MR_ERR_WILDCARD_BIND
end
fd = socknew 2 1 0
if lt fd 0
ret neg long MR_ERR_SOCK
end
put mr_sopt 0 1
put mr_sopt 1 0
put mr_sopt 2 0
put mr_sopt 3 0
sr = sockopt int fd 1 2 mr_sopt 0 4
mr_fill_sockaddr MR_IPV4_LOOPBACK port
br = bind int fd mr_sockaddr 0 16
if ne br 0
z = fclose int fd
ret neg long MR_ERR_SOCK
end
snr = sockname int fd mr_sockaddr 0 16
bport = or shl ulong get mr_sockaddr 2 8 ulong get mr_sockaddr 3
put mr_net_stats 7 bport
lr = listen int fd 8
if ne lr 0
z = fclose int fd
ret neg long MR_ERR_SOCK
end
ret fd
end

fn gs_connect_loop port ulong to long
fd = socknew 2 1 0
if lt fd 0
ret neg long MR_ERR_SOCK
end
mr_fill_sockaddr MR_IPV4_LOOPBACK port
cr = connect int fd mr_sockaddr 0 16
if ne cr 0
z = fclose int fd
ret neg long MR_ERR_SOCK
end
ret fd
end

fn gs_init_env to ulong
mr_init
mv_init
mp_init
mp_set_override MP_OVR_FORCE
ml = gs_join_dir 0 gs_s_memo
for i ulong ml bound 512
put mm_env_buf i get gs_pa i
end
if ne mm_set_root_from_envbuf ml MM_OK
ret 1
end
wl = gs_join_dir 1 gs_s_wx
dm = makedir gs_pb 0 wl 448
for i ulong wl bound 512
put wx_dir i get gs_pb i
end
wx_set_dir_buf wl
pb_init
ps_init
pb_stage_id 7001 TID_X925 PB_PREC_CPU_X925 PB_PROOF_REQUIRED 0x100000
pb_stage_phys 28000 180 6 0 128
c0 = pb_commit
ps_set_baseline 6000 4000 40
ar_init
ir_init
mb_init
f = gpe_build_affine_route
rrc = mb_register_slot 0 7001 f GPE_WK_AFFINE
if ne rrc MB_OK
ret 2
end
if ne tkj_reset TKJ_OK
ret 3
end
if ne sck_init 16 4096 4 4 SCK_OK
ret 4
end
if ne sst_enc_init 16 4096 SST_OK
ret 5
end
mv_ed_derive_seed gs_tag_cli 1
mv_ed_pubkey_from_seed
for i ulong 32
put mr_cli_seed i get mv_ed_seed i
put mr_cli_pk i get mv_ed_pk i
end
cs = mv_peer_register 101 MV_TIER_A_SOVEREIGN
mv_ed_derive_seed gs_tag_srv 1
mv_ed_pubkey_from_seed
for i ulong 32
put mr_wrk_seed i get mv_ed_seed i
put mr_wrk_pk i get mv_ed_pk i
end
ws = mv_peer_register 201 MV_TIER_A_SOVEREIGN
ret 0
end

fn gs_test_t1_t2 to bool
wt = new WattThermal 0 0 0
pol = new WattPolicy 140000 80000 WATT_T_CEIL_DEFAULT 2
ws_sense_all
tok = ws_fill_thermal_state wt
if or not tok ne get g_wmeta 12 0
gs_wrt gs_f
gs_wrt gs_t1
gs_wrt gs_nl
ret false
end
ps_set_contract 1 long PHYS_TIER_EXACT 1 0 5000 65000
if ne ps_dispatch 7001 0 wt pol PHYS_OK
gs_wrt gs_f
gs_wrt gs_t1
gs_wrt gs_nl
ret false
end
gs_wrt gs_p
gs_wrt gs_t1
gs_num_u ulong get wt t_die
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1

rc = pr_shm_open_anon 16
if ne rc PR_OK
ret false
end
po = pr_push_obs 7001 8 9800 0 1500 PR_KIND_CONST
d = pr_drain
h = pr_pick_hottest
gpe_cfg_reset
gpe_cfg_pin 1 8
gpe_cfg_pin 2 0
gpe_cfg_pin 3 0
gpe_cfg_set_profile 9800 0 TID_X925
if ne mb_specialize_slot 0 TID_X925 WX_PROT_RX MB_PROOF_ALL MB_OK
gs_wrt gs_f
gs_wrt gs_t2
gs_wrt gs_nl
ret false
end
gs_wrt gs_p
gs_wrt gs_t2
gs_num_u get fabVer 0
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1
ret true
end

fn gs_pack_ompk to ulong
pk_reset_builder
n = len gs_ir_src
for i ulong n bound 128
z = pk_ir_push get gs_ir_src i
end
pk_set_req EXEC_SCALAR_SIMD 0 8 0 0 0
pk_set_contract 1 MM_TIER_EXACT 1 0 5000 65000
pk_compute_poly_func_id 4 42 8 0
ret pk_pack
end

fn gs_in_u64 idx ulong v ulong to void
off = mul idx 8
for j ulong 8
put mr_in_buf add off j uchar and shr v mul j 8 255
end
end

fn gs_get_in_u64 idx ulong to ulong
off = mul idx 8
v = ulong 0
for j ulong 8
v = or v shl ulong get mr_in_buf add off j mul j 8
end
ret v
end

fn gs_val_put_u64 idx ulong v ulong to void
off = mul idx 8
for j ulong 8
put mm_val_buf add off j uchar and shr v mul j 8 255
end
end

fn gs_val_get_u64 idx ulong to ulong
off = mul idx 8
v = ulong 0
for j ulong 8
v = or v shl ulong get mm_val_buf add off j mul j 8
end
ret v
end

fn gs_stage_memo_exp pt ulong eb ulong nonce ulong to void
for i ulong 32
put mv_exp_ompk_sem i get pk_buf add 8 i
put mv_exp_fid i get pk_buf add 40 i
put mv_exp_in_sha i get mr_req_in_sha i
put mm_req_ir_sha i get pk_buf add 8 i
put mm_req_fid i get pk_buf add 40 i
put mm_req_in_sha i get mr_req_in_sha i
end
mm_set_contract 1 1 pt eb
mm_set_provenance TID_X925 MM_PROV_OMPK_V2
mv_set_expected_meta pt eb nonce 1 MV_TIER_A_SOVEREIGN
mv_set_expected_purity 1 1 TID_X925
end

fn gs_wrk_send_zero_resp cfd int rc ulong to void
for i ulong MV_RCPT_LEN
put mv_rcpt i 0
end
put mm_val_len 0 0
put mr_aux_len 0 16
put mr_aux_buf 0 uchar rc
if eq mr_encode_resp_frame rc 0 16 MR_OK
wrc = mr_tcp_send_wire cfd
end
z = fclose cfd
end

fn gs_wrk_use_key to void
for i ulong 32
put mv_ed_seed i get mr_wrk_seed i
put mv_ed_pk i get mr_wrk_pk i
end
end

fn gs_wrk_exec_new fbase uint iter ulong to ulong
a0 = gs_get_in_u64 0
a1 = gs_get_in_u64 1
a2 = gs_get_in_u64 2
a3 = gs_get_in_u64 3
wx_set_args a0 a1 a2 a3 1
yg = mb_dispatch_slot 0 true
disp = get mb_last_disp 0
if eq disp MB_DISP_ROLLBACK
z_rb = sck_restore_nearest 1
put mr_aux_buf 0 3
put mr_aux_buf 1 1
else
tkj_pack_u64x4 a0 a1 yg iter
z_tj = tkj_append TKJ_OP_CHECK 0 iter 32
z_sc = sck_take
put mr_aux_buf 0 2
put mr_aux_buf 1 1
end
put mr_aux_len 0 16
gs_val_put_u64 0 yg
gs_val_put_u64 1 gpe_eval_fn fbase a0 a1 a2 a3
gs_val_put_u64 2 a0
gs_val_put_u64 3 MB_PROOF_ALL
put mm_val_len 0 32
ret disp
end

fn gs_wrk_serve_valid cfd int fbase uint iter ulong to void
flags = get mr_req_meta 0
nonce = get mr_req_meta 1
if ne and flags 8 0
gs_wrk_send_zero_resp cfd PHYS_ERR_WATTCBF_FAIL_CLOSED
ret
end
gs_stage_memo_exp MM_TIER_EXACT 0 nonce
if eq mm_lookup MM_OK
put mr_aux_buf 0 1
put mr_aux_buf 1 0
put mr_aux_len 0 16
gs_wrk_use_key
src = mv_rcpt_sign TID_X925 MM_TIER_EXACT MV_TIER_A_SOVEREIGN 0 50
if ne and flags 16 0
put mv_rcpt 224 xor get mv_rcpt 224 1
end
erc = mr_encode_resp_frame 0 32 16
wrc = mr_tcp_send_wire cfd
z = fclose cfd
ret
end
disp = gs_wrk_exec_new fbase iter
gs_wrk_use_key
src = mv_rcpt_sign TID_X925 MM_TIER_EXACT MV_TIER_A_SOVEREIGN 0 100
if eq disp MB_DISP_SPEC
z_va = mv_tier_a_verify 32 false
z_ad = mv_admit_to_memo 100 1000
end
if ne and flags 16 0
put mv_rcpt 224 xor get mv_rcpt 224 1
end
erc = mr_encode_resp_frame 0 32 16
wrc = mr_tcp_send_wire cfd
z = fclose cfd
end

fn gs_wrk_serve lfd int fbase uint to int
for iter ulong 6
cfd = accept lfd 0
if lt cfd 0
ret 1
end
if ne mr_tcp_recv_wire int cfd MR_OK
z = fclose int cfd
ret 2
end
drc = mr_decode_req_frame true
if ne drc MR_OK
gs_wrk_send_zero_resp int cfd drc
else
gs_wrk_serve_valid int cfd fbase iter
end
end
ret 0
end

fn gs_cli_rpc port ulong nonce ulong flags ulong corrupt bool to ulong
for i ulong 32
put mr_cli_seed i get mv_ed_seed i
put mr_cli_pk i get mv_ed_pk i
end
mv_ed_derive_seed gs_tag_cli 1
mv_ed_pubkey_from_seed
for i ulong 32
put mr_cli_seed i get mv_ed_seed i
put mr_cli_pk i get mv_ed_pk i
end
put mr_req_meta 0 flags
put mr_req_meta 1 nonce
put mr_req_meta 2 1
if ne mr_encode_req_frame 1 MM_TIER_EXACT 0 TID_X925 flags MR_OK
ret 90
end
if corrupt
wl = get mr_wire_len 0
put mr_wire sub wl 1 xor get mr_wire sub wl 1 1
end
cfd = gs_connect_loop port
if lt cfd 0
ret 91
end
if ne mr_tcp_send_wire int cfd MR_OK
z = fclose int cfd
ret 92
end
if ne mr_tcp_recv_wire int cfd MR_OK
z = fclose int cfd
ret 93
end
z = fclose int cfd
ret mr_decode_resp_frame
end

fn gs_test_loopback_and_neg fbase uint to bool
if ne gs_pack_ompk PK_OK
ret false
end
lfd = gs_listen_loop 0
if lt lfd 0
ret false
end
port = get mr_net_stats 7
pid = fork
if lt pid 0
z = fclose int lfd
ret false
end
if eq pid 0
cr = gs_wrk_serve int lfd fbase
exit cr
end
z = fclose int lfd

note Call 1 (42,8,0,0) -> Spec Exec + Memo Admit
gs_in_u64 0 42
gs_in_u64 1 8
gs_in_u64 2 0
gs_in_u64 3 0
put mr_in_len 0 32
if ne gs_cli_rpc port 1 0 false MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
if or ne get mr_req_meta 9 0 ne gs_val_get_u64 0 1008
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
gs_stage_memo_exp MM_TIER_EXACT 0 1
if ne mv_tier_a_verify 32 false MV_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
for i ulong 32
put gs_saved i get mm_val_buf i
end
gs_wrt gs_p
gs_wrt gs_t3
gs_num_u gs_val_get_u64 0
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1

note Call 2 (42,8,0,0) -> OMEGA_MEMO_HIT recompute=0
if ne gs_cli_rpc port 2 0 false MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
if or ne get mr_aux_buf 0 1 ne get mr_aux_buf 1 0
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
for i ulong 32
if ne get mm_val_buf i get gs_saved i
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
end

note Call 3 OOD (42,9,2,1) -> trap 14 rewind + safe 3335
gs_in_u64 0 42
gs_in_u64 1 9
gs_in_u64 2 2
gs_in_u64 3 1
if ne gs_cli_rpc port 3 0 false MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
if or ne get mr_aux_buf 0 3 ne gs_val_get_u64 0 3335
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
gs_wrt gs_p
gs_wrt gs_t4
gs_num_u gs_val_get_u64 0
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1

note Verify Call 3 valid OMRC0001
gs_stage_memo_exp MM_TIER_EXACT 0 3
if ne mv_tier_a_verify 32 false MV_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end

note Neg A: Overtemp simulated (rc=13)
if ne gs_cli_rpc port 4 8 false MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
if ne get mr_req_meta 9 PHYS_ERR_WATTCBF_FAIL_CLOSED
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
put gs_neg 0 add get gs_neg 0 1

note Neg B: Forged req sig over TCP (rc=19)
if ne gs_cli_rpc port 5 0 true MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
if ne get mr_req_meta 9 MR_ERR_FRAME_SIG
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
put gs_neg 0 add get gs_neg 0 1

note Neg C: Server-tampered OMRC0001 over TCP -> MV_ERR_BAD_SIG (13)
gs_in_u64 0 42
gs_in_u64 1 8
gs_in_u64 2 0
gs_in_u64 3 0
if ne gs_cli_rpc port 6 16 false MR_OK
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
gs_stage_memo_exp MM_TIER_EXACT 0 6
if ne mv_tier_a_verify 32 false MV_ERR_BAD_SIG
kz = killpid int pid 9
wp = waitpid int pid gs_st 0 4 0
ret false
end
put gs_neg 0 add get gs_neg 0 1
wp = waitpid int pid gs_st 0 4 0

note Offline neg controls: --rwx, 0.0.0.0 bind, unknown peer
if ne wx_validate_prot WX_PROT_RWX WX_ERR_RWX_FORBIDDEN
ret false
end
put gs_neg 0 add get gs_neg 0 1
if gs_ip_is_safe 0
ret false
end
put gs_neg 0 add get gs_neg 0 1
mv_ed_derive_seed gs_tag_rog 9
mv_ed_pubkey_from_seed
if ne mv_peer_find_pk MV_NONE
ret false
end
put gs_neg 0 add get gs_neg 0 1
gs_wrt gs_p
gs_wrt gs_t5
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1
ret true
end

fn gs_match_at i ulong pat view uchar * to bool
ml = len pat
for j ulong ml bound 128
if ne get gs_fbuf add i j get pat j
ret false
end
end
ret true
end

fn gs_copy_at i ulong rep view uchar * to void
ml = len rep
for j ulong ml bound 128
put gs_fbuf add i j get rep j
end
end

fn gs_patch_fbuf tot ulong pat view uchar * rep view uchar * to bool
ml = len pat
if or lt tot ml ne len rep ml
ret false
end
lim = sub tot ml
for i ulong lim bound 262140
if gs_match_at i pat
gs_copy_at i rep
ret true
end
end
ret false
end

fn gs_write_all_fbuf fd int n ulong to bool
off = ulong 0
while lt off n bound 4096
w = write fd gs_fbuf off sub n off
if le w 0
ret false
end
off = add off ulong w
end
ret true
end

fn gs_write_chunk_buf fd int n ulong to bool
off = ulong 0
while lt off n bound 256
w = write fd gs_copy off sub n off
if le w 0
ret false
end
off = add off ulong w
end
ret true
end

fn gs_append_stream ufd int suf view uchar * skip_first_line bool to bool
pl = gs_join_repo suf
rfd = fopen gs_pc 0 pl 0 0
if lt rfd 0
ret false
end
skipped = false
if not skip_first_line
skipped = true
end
for chunk ulong 1024
n = read int rfd gs_copy 0 8192
if le n 0
break
end
st = ulong 0
if not skipped
for j ulong ulong n bound 8192
if eq get gs_copy j 10
st = add j 1
skipped = true
break
end
end
end
if lt st ulong n
off = st
while lt off ulong n bound 256
w = write ufd gs_copy off sub ulong n off
if le w 0
z = fclose int rfd
ret false
end
off = add off ulong w
end
end
end
z = fclose int rfd
ret true
end

fn gs_append_main_mut ufd int mut_id ulong to bool
pl = gs_join_repo gs_u29
rfd = fopen gs_pc 0 pl 0 0
if lt rfd 0
ret false
end
tot = ulong 0
for c ulong 64
if ge tot 253952
break
end
n = read int rfd gs_fbuf tot 8192
if le n 0
break
end
tot = add tot ulong n
end
z = fclose int rfd
if eq mut_id 1
if not gs_patch_fbuf tot gs_m1_from gs_m1_to
ret false
end
end
if eq mut_id 2
if not gs_patch_fbuf tot gs_m2_from gs_m2_to
ret false
end
end
if eq mut_id 3
if not gs_patch_fbuf tot gs_m3_from gs_m3_to
ret false
end
end
ret gs_write_all_fbuf ufd tot
end

fn gs_append_pair ufd int a view uchar * b view uchar * to bool
if not gs_append_stream ufd a false
ret false
end
ret gs_append_stream ufd b false
end

fn gs_write_mut_om mut_id ulong suf view uchar * to ulong
pl = gs_join_dir 0 suf
ufd = fopen gs_pa 0 pl 577 384
if lt ufd 0
ret 0
end
ok = gs_append_pair int ufd gs_u00 gs_u01
if ok
ok = gs_append_stream int ufd gs_u02 false
end
if ok
ok = gs_append_stream int ufd gs_u03 true
end
if ok
ok = gs_append_pair int ufd gs_u04 gs_u05
end
if ok
ok = gs_append_pair int ufd gs_u06 gs_u07
end
if ok
ok = gs_append_pair int ufd gs_u08 gs_u09
end
if ok
ok = gs_append_pair int ufd gs_u10 gs_u11
end
if ok
ok = gs_append_pair int ufd gs_u12 gs_u13
end
if ok
ok = gs_append_pair int ufd gs_u14 gs_u15
end
if ok
ok = gs_append_pair int ufd gs_u16 gs_u17
end
if ok
ok = gs_append_pair int ufd gs_u18 gs_u19
end
if ok
ok = gs_append_pair int ufd gs_u20 gs_u21
end
if ok
ok = gs_append_pair int ufd gs_u22 gs_u23
end
if ok
ok = gs_append_pair int ufd gs_u24 gs_u25
end
if ok
ok = gs_append_pair int ufd gs_u26 gs_u27
end
if ok
ok = gs_append_stream int ufd gs_u28 false
end
if ok
ok = gs_append_main_mut int ufd mut_id
end
z = fclose int ufd
if not ok
ret 0
end
ret pl
end

fn gs_compile_mut pl ulong bin_suf view uchar * to ulong
ifd = fopen gs_pa 0 pl 0 0
if lt ifd 0
ret 0
end
bl = gs_join_dir 1 bin_suf
ofd = fopen gs_pb 0 bl 577 493
if lt ofd 0
z = fclose int ifd
ret 0
end
ap = gs_av_reset
ap = gs_av_add_g ap 1 get gs_omcl 0
crc = gs_run_av ap int ifd int ofd
z = fclose int ifd
z = fclose int ofd
if ne crc 0
ret 0
end
ret bl
end

fn gs_cli_check_exit rc_want ulong a1 view uchar * a2 view uchar * has2 bool to bool
dn = fopen gs_devnull 0 len gs_devnull 2 0
if lt dn 0
ret false
end
ap = gs_av_reset
ap = gs_av_add_g ap 0 get gs_binl 0
ap = gs_av_add ap a1 len a1
if has2
ap = gs_av_add ap a2 len a2
end
got = gs_run_av ap neg int 1 int dn
z = fclose int dn
ret eq got rc_want
end

fn gs_cli_demo_bin bl ulong is_mut bool to bool
dn = fopen gs_devnull 0 len gs_devnull 2 0
if lt dn 0
ret false
end
dm = gs_join_dir 0 gs_s_dmemo
ap = gs_av_reset
if is_mut
ap = gs_av_add_g ap 3 bl
else
ap = gs_av_add_g ap 0 get gs_binl 0
end
ap = gs_av_add ap gs_a_demo len gs_a_demo
ml = gs_join_dir 0 gs_s_dmemo
ap = gs_av_add_g ap 2 ml
wl = gs_join_dir 0 gs_s_dwx
ap = gs_av_add_g ap 2 wl
jl = gs_join_dir 0 gs_s_djnl
ap = gs_av_add_g ap 2 jl
got = gs_run_av ap neg int 1 int dn
z = fclose int dn
if is_mut
ret ne got 0
end
ret eq got 0
end

fn gs_kill_mut_bind mut_id ulong rc_want ulong a1 view uchar * a2 view uchar * to bool
pl = ulong 0
bl = ulong 0
has2 = true
if eq mut_id 1
pl = gs_write_mut_om mut_id gs_s_m1_om
if ne pl 0
bl = gs_compile_mut pl gs_s_m1_bin
end
else
has2 = false
pl = gs_write_mut_om mut_id gs_s_m2_om
if ne pl 0
bl = gs_compile_mut pl gs_s_m2_bin
end
end
if eq bl 0
ret false
end
dn = fopen gs_devnull 0 len gs_devnull 2 0
if lt dn 0
ret false
end
ap = gs_av_reset
ap = gs_av_add_g ap 3 bl
ap = gs_av_add ap a1 len a1
if has2
ap = gs_av_add ap a2 len a2
end
got = gs_run_av ap neg int 1 int dn
z = fclose int dn
ret ne got rc_want
end

fn gs_test_cli_and_mutants to bool
if not gs_cli_check_exit 0 gs_a_status gs_nl false
ret false
end
if not gs_cli_check_exit 2 gs_a_rwx gs_nl false
ret false
end
if not gs_cli_check_exit 12 gs_a_chk gs_a_wc true
ret false
end
if not gs_cli_check_exit 0 gs_a_chk gs_a_okip true
ret false
end
if not gs_cli_demo_bin 0 false
ret false
end

note Kill Mutant 1: weaken 0.0.0.0 wildcard bind refusal in si2_live_main.om
if not gs_kill_mut_bind 1 12 gs_a_chk gs_a_wc
ret false
end
put gs_mut 0 add get gs_mut 0 1

note Kill Mutant 2: weaken --rwx W^X refusal in si2_live_main.om
if not gs_kill_mut_bind 2 2 gs_a_rwx gs_nl
ret false
end
put gs_mut 0 add get gs_mut 0 1

note Kill Mutant 3: weaken WattCBF overtemp fail-closed check in si2_live_main.om
pl3 = gs_write_mut_om 3 gs_s_m3_om
if eq pl3 0
ret false
end
bl3 = gs_compile_mut pl3 gs_s_m3_bin
if eq bl3 0
ret false
end
if not gs_cli_demo_bin bl3 true
ret false
end
put gs_mut 0 add get gs_mut 0 1

gs_wrt gs_p
gs_wrt gs_t6
gs_num_u get gs_mut 0
gs_wrt gs_nl
put gs_pass 0 add get gs_pass 0 1
ret true
end

fn main to int
gs_copy_arg 1 0 gs_def_dir
gs_copy_arg 2 1 gs_def_bin
gs_copy_arg 3 2 gs_def_omc
gs_copy_arg 4 3 gs_def_repo
dm = makedir gs_dir 0 get gs_dirl 0 448
put gs_pass 0 0
put gs_neg 0 0
put gs_mut 0 0
gs_wrt gs_hdr
irc = gs_init_env
if ne irc 0
ret int add 80 irc
end
f0 = uint get mb_slot_fbase 0
ok12 = gs_test_t1_t2
ok345 = gs_test_loopback_and_neg f0
ok6 = gs_test_cli_and_mutants
if and ok12 and ok345 ok6
gs_wrt gs_sum_ok
gs_num_u get gs_pass 0
gs_wrt gs_sum_neg
gs_num_u get gs_neg 0
gs_wrt gs_sum_mut
gs_num_u get gs_mut 0
gs_wrt gs_nl
ret 0
end
gs_wrt gs_sum_fail
gs_num_u get gs_pass 0
gs_wrt gs_sum_neg
gs_num_u get gs_neg 0
gs_wrt gs_sum_mut
gs_num_u get gs_mut 0
gs_wrt gs_nl
ret 1
end

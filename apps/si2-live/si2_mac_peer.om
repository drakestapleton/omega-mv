note SPDX-License-Identifier: Apache-2.0
note apps/si2-live/si2_mac_peer.om
note Sovereign Intelligence 2.0 MacBook Apple Silicon (`a64macos` Mach-O) Mesh Peer & Live Verifier.
note Pure seeded OM-2 compiled via Omega NG (`@ng front-ir` -> `@ng opt` -> `@ng a64 macho` + ad-hoc codesign).
note Zero C, zero Python, zero Objective-C wrappers; talks directly to Darwin libSystem via libfn/libptr/libcall.
note
note Build on Spark ng compiler -> Apple Silicon Mach-O:
note   { printf '@ng front-ir\ntarget macos\nom2\n'; cat seed/ng/sha256.om \
note       protocol/omnet/om/sha512/sha512.om protocol/omnet/om/ed25519/ed25519.om \
note       protocol/uor-gpu/ed_sign.om seed/ng/target/target_desc.om \
note       seed/ng/pack/sem_pack.om apps/si2-live/si2_mac_peer.om; } | ng --stage front-ir ... > si2_mac_peer
note
note Environment variables (all optional; sane defaults):
note   SI2_MAC_MODE=selfcheck   -> offline OMPK v2 + Ed25519 OMRC0001 roundtrip + forged-sig & quarantine checks
note   SI2_SPARK_IP=192.168.1.108 SI2_SPARK_PORT=18595
note   SI2_HUB_IP=192.168.1.192   SI2_HUB_PORT=18596

const MC_AF_INET ulong 2
const MC_SOCK_STREAM ulong 1
const MC_SOL_SOCKET ulong 65535
const MC_SO_SNDTIMEO ulong 4101
const MC_SO_RCVTIMEO ulong 4102
const MC_CLOCK_MONO_RAW ulong 4
const MC_RTLD_DEFAULT ulong 18446744073709551614

const MC_OMSH_HDR_LEN ulong 32
const MC_OMSH_VER ulong 1
const MC_MSG_REQ ulong 1
const MC_MSG_RESP ulong 2
const MC_MAX_WIRE ulong 33024
const MC_RCPT_BODY_LEN ulong 192
const MC_RCPT_LEN ulong 288

const MC_FLAG_SIM_OVERTEMP ulong 8
const MC_FLAG_FAULT_TAMPER_RCPT ulong 16

const MC_DEC_MEMO_HIT ulong 1
const MC_DEC_SPEC_EXEC ulong 2
const MC_DEC_OOD_ROLLBACK ulong 3

const MC_ERR_FRAME_SIG ulong 19
const MC_ERR_UNAUTH_PEER ulong 14
const MC_ERR_OVERTEMP ulong 13
const MC_OK ulong 0
const MC_ERR_BAD_SIG ulong 13
const MC_ERR_QUAR ulong 12
const MC_ERR_BINDING ulong 14


note apps/omega-wattd/gate_wattd.om
note Standalone pure seeded OM-2 verification gate for omega-wattd on DGX Spark GB10.
note Compose: cat si/directives/om2.om apps/omega-wattd/watt_sense.om apps/omega-wattd/watt_cbf.om apps/omega-wattd/gate_wattd.om | seed/out/omc > gate_wattd
note Strictly READ-ONLY on hardware: zero writes to sysfs/EC/GSP/UEFI/SPI/PCIe.

text gt_hdr "=== OMEGA-WATTD VERIFICATION GATE (PURE OM-2, ZERO NVIDIA.KO) ===\n"
text gt_m_t10 "T10_monotonicity_sweeps"
text gt_m_t10_det " budget_sweep=OK adv_budget_sweep=OK tsink_sweep=OK tceil_sweep=OK tau_sweep=OK warmup_sweep=OK"
text gt_m_t11 "T11_ceildiv_signed_parity"
text gt_m_t11_det " exact_match=14/14 i64_extremes=OK"
text gt_m_t12 "T12_adversarial_matrix_128"
text gt_m_t12_det " cases=128 trap14_violations=0 budget_violations=0 barrier_violations=0 idemp_violations=0"
text gt_m_t13 "T13_sensor_fault_and_whole_unit"
text gt_m_t13_det " missing_tgpu=FAIL_CLOSED missing_all=FAIL_CLOSED missing_tunc=CONSERVATIVE hot_tsoc=FAIL_CLOSED cppc_edge=OK"
text gt_pass "GATE_WATTD PASS total=13/13 core=9/9 extended=4/4 hw_writes=0\n"
text gt_fail "GATE_WATTD FAIL core_rc="
text gt_fail2 " extended="

fn gt_rails_le a view WattCmd b view WattCmd to bool
if gt get a p_gpu get b p_gpu
ret false
end
if gt get a p_cpu get b p_cpu
ret false
end
if gt get a p_unc get b p_unc
ret false
end
ret true
end

fn gt_copy_rails dst edit WattCmd src view WattCmd to void
put dst p_gpu get src p_gpu
put dst p_cpu get src p_cpu
put dst p_unc get src p_unc
end

fn gt_t10_monotonicity to bool
ok = true
st = new WattThermal 74000 64000 25000
pol = new WattPolicy 100000 80000 78000 2
pr = new WattProp 85000 15000 5000 40
c_prev = new WattCmd 0 0 0 0 0 0
c_cur = new WattCmd 0 0 0 0 0 0
note 10a: Monotone non-decreasing in pBudget (30 W .. 140 W)
put pol p_budget 30000
wc_cbf_filter st pol pr c_prev
for i ulong 11
b = add 40000 mul long i 10000
put pol p_budget b
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_prev c_cur
ok = false
end
gt_copy_rails c_prev c_cur
end
note 10b: Monotone non-increasing in tSink (35 C .. 74 C)
put pol p_budget 110000
put st t_die 74000
put st t_sink 35000
wc_cbf_filter st pol pr c_prev
for i ulong 8
ts = add 40000 mul long i 5000
if gt ts 74000
ts = 74000
end
put st t_sink ts
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_cur c_prev
ok = false
end
gt_copy_rails c_prev c_cur
end
note 10c: Monotone non-decreasing in tCeil (75 C .. 90 C)
put st t_die 74000
put st t_sink 64000
put pol t_ceil 75000
wc_cbf_filter st pol pr c_prev
for i ulong 8
tc = add 76000 mul long i 2000
if gt tc 90000
tc = 90000
end
put pol t_ceil tc
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_prev c_cur
ok = false
end
gt_copy_rails c_prev c_cur
end
note 10d: Monotone non-increasing in tau (0 .. 8 s)
put pol t_ceil 78000
put pol tau 0
wc_cbf_filter st pol pr c_prev
for i ulong 8
put pol tau add long i 1
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_cur c_prev
ok = false
end
gt_copy_rails c_prev c_cur
end
note 10e: Monotone non-increasing in whole-unit warm-up (tDie - tSink = 10 C fixed)
put pol tau 2
put st t_die 50000
put st t_sink 40000
wc_cbf_filter st pol pr c_prev
for i ulong 8
td = add 55000 mul long i 4000
put st t_die td
put st t_sink sub td 10000
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_cur c_prev
ok = false
end
gt_copy_rails c_prev c_cur
end
note 10f: Unconditional pBudget monotonicity with adversarial pUnc+pCpu > pBudget
put st t_die 74000
put st t_sink 64000
put pol t_ceil 78000
put pol tau 2
put pr p_gpu 80000
put pr p_cpu 60000
put pr p_unc 25000
put pol p_budget 10000
wc_cbf_filter st pol pr c_prev
for i ulong 13
b2 = add 20000 mul long i 10000
put pol p_budget b2
wc_cbf_filter st pol pr c_cur
if not gt_rails_le c_prev c_cur
ok = false
end
gt_copy_rails c_prev c_cur
end
if ok
wd_puts wg_m_pass
wd_puts gt_m_t10
wd_puts gt_m_t10_det
wd_puts ws_lbl_nl
else
wd_puts wg_m_fail
wd_puts gt_m_t10
wd_puts ws_lbl_nl
end
ret ok
end

fn gt_t11_ceildiv to bool
ok = true
if ne wc_ceil_div -2001 1000 -2
ok = false
end
if ne wc_ceil_div -2000 1000 -2
ok = false
end
if ne wc_ceil_div -1999 1000 -1
ok = false
end
if ne wc_ceil_div -1001 1000 -1
ok = false
end
if ne wc_ceil_div -1000 1000 -1
ok = false
end
if ne wc_ceil_div -999 1000 0
ok = false
end
if ne wc_ceil_div -1 1000 0
ok = false
end
if ne wc_ceil_div 0 1000 0
ok = false
end
if ne wc_ceil_div 1 1000 1
ok = false
end
if ne wc_ceil_div 999 1000 1
ok = false
end
if ne wc_ceil_div 1000 1000 1
ok = false
end
if ne wc_ceil_div 1001 1000 2
ok = false
end
if ne wc_ceil_div 9223372036854775807 1000 9223372036854776
ok = false
end
if ne wc_ceil_div sub long -9223372036854775807 1 1000 -9223372036854775
ok = false
end
if ok
wd_puts wg_m_pass
wd_puts gt_m_t11
wd_puts gt_m_t11_det
wd_puts ws_lbl_nl
else
wd_puts wg_m_fail
wd_puts gt_m_t11
wd_puts ws_lbl_nl
end
ret ok
end

fn gt_check_one_case st view WattThermal pol view WattPolicy pr view WattProp to bool
cmd = new WattCmd 0 0 0 0 0 0
wc_cbf_filter st pol pr cmd
pg = get cmd p_gpu
pc = get cmd p_cpu
pu = get cmd p_unc
fn_v = get cmd fan_pct
if or lt pg 0 or lt pc 0 lt pu 0
ret false
end
if gt pg WATT_P_GPU_HARD_MAX
ret false
end
if gt add add pg pc pu wc_max 0 get pol p_budget
ret false
end
if or lt fn_v WATT_FAN_MIN gt fn_v WATT_FAN_MAX
ret false
end
if and ge get pr p_gpu 0 gt pg get pr p_gpu
ret false
end
if and ge get pr p_cpu 0 gt pc get pr p_cpu
ret false
end
if and ge get pr p_unc 0 gt pu get pr p_unc
ret false
end
if not wg_check_idemp st pol cmd
ret false
end
if ne get cmd fail_closed 0
if or ne pg 0 or ne pc 0 or ne pu 0 ne fn_v WATT_FAN_MAX
ret false
end
ret true
end
dt = wc_next_die_delta st pg pc pu
h = wc_barrier_h get pol t_ceil get st t_die get pol tau dt
if lt h 0
ret false
end
td_next = add get st t_die dt
if gt td_next get pol t_ceil
ret false
end
h_next = wc_barrier_h get pol t_ceil td_next get pol tau dt
if lt h_next 0
ret false
end
ret true
end

fn gt_set_regime it ulong st edit WattThermal pol edit WattPolicy to void
put pol p_budget 100000
put pol p_gpu_budget 80000
put pol t_ceil 78000
put pol tau 2
put st t_amb 25000
if eq it 0
put st t_die 44000
put st t_sink 36000
ret
end
if eq it 1
put st t_die 66000
put st t_sink 58000
ret
end
if eq it 2
put st t_die 77000
put st t_sink 69000
ret
end
if eq it 3
put st t_die 78000
put st t_sink 70000
ret
end
if eq it 4
put st t_die 77000
put st t_sink 77900
put pol tau 20
ret
end
if eq it 5
put st t_die 77500
put st t_sink 86000
ret
end
if eq it 6
put st t_die 48700
put st t_sink 150000
put pol t_ceil 85000
ret
end
put st t_die 77000
put st t_sink 77000
end

fn gt_t12_adversarial_matrix to bool
ok = true
st = new WattThermal 0 0 0
pol = new WattPolicy 100000 80000 78000 2
pr = new WattProp 0 0 0 0
note 8 thermal/fault regimes x 4 GPU requests x 4 CPU/Unc/fan profiles = 128 adversarial cases
for it ulong 8
gt_set_regime it st pol
for ig ulong 4
pg = long -5000
if eq ig 1
pg = 0
end
if eq ig 2
pg = 88000
end
if eq ig 3
pg = 250000
end
for ic ulong 4
pc = mul long ic 20000
pu = mul long ic 8000
fp = sub mul long ic 50 10
put pr p_gpu pg
put pr p_cpu pc
put pr p_unc pu
put pr fan_pct fp
if not gt_check_one_case st pol pr
ok = false
end
end
end
end
if ok
wd_puts wg_m_pass
wd_puts gt_m_t12
wd_puts gt_m_t12_det
wd_puts ws_lbl_nl
else
wd_puts wg_m_fail
wd_puts gt_m_t12
wd_puts ws_lbl_nl
end
ret ok
end

fn gt_t13_reset_zones v long to void
for z ulong 7
put g_tz_ok z 1
put g_tz_mc z v
end
put g_wmeta 0 7
put g_wmeta 5 v
put g_wmeta 6 v
put g_wmeta 7 v
put g_wmeta 8 v
put g_wmeta 13 1
end

fn gt_t13_sensor_faults to bool
ok = true
st = new WattThermal 0 0 0
pol78 = new WattPolicy 100000 80000 78000 2
pr = new WattProp 75000 17000 8000 60
note 13a: Missing zone5 [TGPU] (6/7 zones ok) MUST fail closed (never t_die=0C fail-open!)
gt_t13_reset_zones 48700
put g_tz_ok 5 0
put g_tz_mc 5 0
put g_wmeta 0 6
put g_wmeta 5 0
put g_wmeta 13 0
if ws_fill_thermal_state st
ok = false
end
if not wg_check_fail_closed st pol78 pr
ok = false
end
note 13b: Missing all thermal zones (0/7) MUST fail closed (never 45C fabrication!)
for z ulong 7
put g_tz_ok z 0
put g_tz_mc z 0
end
put g_wmeta 0 0
put g_wmeta 8 0
put g_wmeta 13 0
if ws_fill_thermal_state st
ok = false
end
if not wg_check_fail_closed st pol78 pr
ok = false
end
note 13c: Missing zone6 [TUNC] (6/7) stays conservative (t_sink >= t_die - 2000, NEVER 25000!)
gt_t13_reset_zones 60000
put g_tz_ok 6 0
put g_tz_mc 6 0
put g_wmeta 0 6
put g_wmeta 7 0
if not ws_fill_thermal_state st
ok = false
end
if ne get st t_sink 58000
ok = false
end
note 13d: Hot Grace TSOC (86C > 78C ceil) with cool TGPU (48.7C) MUST fail closed as whole unit!
gt_t13_reset_zones 48700
put g_tz_mc 0 86000
put g_wmeta 6 86000
put g_wmeta 8 86000
if not ws_fill_thermal_state st
ok = false
end
if ne get st t_die 86000
ok = false
end
if not wg_check_fail_closed st pol78 pr
ok = false
end
note 13e: Cold room (20C) keeps t_amb <= t_sink <= t_die
gt_t13_reset_zones 20000
if not ws_fill_thermal_state st
ok = false
end
if or gt get st t_amb get st t_sink gt get st t_sink get st t_die
ok = false
end
note 13f: CPPC permille handles small counters (<1024) and huge 64-bit ratios without wrap/trap
if ne ws_ratio_permille 500 500 1000
ok = false
end
if ne ws_ratio_permille 18446744073709551615 100 1000000
ok = false
end
note Restore live sensors
ws_sense_all
if ok
wd_puts wg_m_pass
wd_puts gt_m_t13
wd_puts gt_m_t13_det
wd_puts ws_lbl_nl
else
wd_puts wg_m_fail
wd_puts gt_m_t13
wd_puts ws_lbl_nl
end
ret ok
end

fn main to int
wd_puts gt_hdr
wd_flush
core_rc = wc_run_core_gate
ext_pass = long 0
if gt_t10_monotonicity
ext_pass = add ext_pass 1
end
if gt_t11_ceildiv
ext_pass = add ext_pass 1
end
if gt_t12_adversarial_matrix
ext_pass = add ext_pass 1
end
if gt_t13_sensor_faults
ext_pass = add ext_pass 1
end
if and eq core_rc 0 eq ext_pass 4
wd_puts gt_pass
wd_flush
ret 0
end
wd_puts gt_fail
wd_put_i64 long core_rc
wd_puts gt_fail2
wd_put_i64 ext_pass
wd_puts wg_m_sum_of
wd_put_i64 4
wd_puts wg_m_sum_tail
wd_flush
ret 1
end

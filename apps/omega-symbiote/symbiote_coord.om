note SPDX-License-Identifier: Apache-2.0
note apps/omega-symbiote/symbiote_coord.om
note Pure seeded OM-2 Heterogeneous 20-Core Grace NEON Symbiote Coordinator.
note
note Targets NVIDIA DGX Spark Grace CPU (10x Cortex-X925 CPUs 5..9,15..19 @ 3.90 GHz +
note 10x Cortex-A725 CPUs 0..4,10..14 @ 2.81 GHz) using static piped workers compiled by
note @ng opt + @ng a64 (symbiote_worker). Zero dynamic shared libraries, hw_writes=0.
note
note Compose in order:
note   cat si/directives/om2.om \
note       apps/omega-wattd/watt_sense.om apps/omega-wattd/watt_cbf.om \
note       seed/ng/sha256.om seed/ng/memo/memo_policy.om seed/ng/memo/memo_store.om \
note       apps/omega-symbiote/symbiote_coord.om | seed/out/omc > symbiote_coord

const SC_W20 ulong 20
const SC_COLS ulong 64
const SC_ROWS ulong 1280
const SC_NFLOATS ulong 81920
const SC_NBYTES ulong 327680
const SC_X925_NF ulong 4352
const SC_A725_NF ulong 3840
const SC_W1_CHUNK ulong 8192
const SC_MAGIC ulong 827152723
const SC_DEF_ITERS ulong 1024
const SC_DEF_TRIALS ulong 5
const SC_BUDGET_HARD long 80000
const SC_T_CEIL long 85000
const SC_T_FLOOR long 5000
const SC_L2_X925 ulong 2097152
const SC_L2_A725 ulong 524288
const SC_STRIDE_F ulong 16
const SC_AHEAD_F ulong 64
const SC_ALPHA_U uint 1065222144
const SC_BETA_U uint 998244352
const SC_GAMMA_U uint 1065287680

global sc_mode ulong 1
global sc_wpath uchar 512
global sc_wplen ulong 1
global sc_mdir uchar 512
global sc_mdlen ulong 1
global sc_iters ulong 1
global sc_trials ulong 1
global sc_budget_mw long 1
global sc_sim_pmw long 1
global sc_sim_tdie long 1
global sc_flags ulong 1

global sc_cpu ulong 20
global sc_clus ulong 20
global sc_off_f ulong 20
global sc_cnt_f ulong 20
global sc_arb_tile ulong 20
global sc_arb_cues ulong 1

global sc_pid long 20
global sc_wfd int 20
global sc_rfd int 20

global sc_p2c uchar 8
global sc_c2p uchar 8
global sc_pkt uchar 1024
global sc_msk uchar 8
global sc_st uchar 8
global sc_rdy uchar 8
global sc_hdr uchar 32
global sc_arg uchar 1024
global sc_say uchar 64

global sc_in uchar 327680
global sc_out uchar 327680
global sc_w1 uchar 327680
global sc_ref uchar 327680

global sc_sha_elf uchar 32
global sc_sha_ref uchar 32
global sc_sha_w1 uchar 32
global sc_sha_w20 uchar 32
global sc_tmp_b uchar 32

global sc_t_scal ulong 16
global sc_t_w1 ulong 16
global sc_t_w20 ulong 16
global sc_meds ulong 8
global sc_diffs ulong 4
global sc_therm long 8
global sc_memo_res ulong 4

text sc_def_wrk "./symbiote_worker"
text sc_def_mdir "/tmp/symbiote-memo"
text sc_ktag "SYM1-NEON-FMA4-HETEROG-V1"

text sc_f_probe "probe-thermal"
text sc_f_bench "bench"
text sc_f_disp "dispatch"
text sc_f_wrk "--worker"
text sc_f_mdir "--memo-dir"
text sc_f_itr "--iters"
text sc_f_trl "--trials"
text sc_f_bud "--budget-mw"
text sc_f_pmw "--sim-pmw"
text sc_f_tdie "--sim-tdie-mc"
text sc_f_bmask "--bad-mask"
text sc_f_tmem "--tamper-memo"
text sc_f_ulp "--inject-ulp"
text sc_f_skip "--skip-scalar"
text sc_f_exhit "--memo-expect-hit"

text sc_m_probe "SYMBIOTE_PROBE thermal_zones="
text sc_m_cpus " cpus="
text sc_m_tmax " tmax_mc="
text sc_m_a7 " a725_khz="
text sc_m_x9 " x925_khz="
text sc_m_pprop " p_prop_mw="
text sc_m_plim " p_limit_mw="
text sc_m_fc " fail_closed="
text sc_m_hw " hw_writes=0\n"

text sc_m_elf "SYMBIOTE_ELF worker_bytes="
text sc_m_ptd " pt_dynamic="
text sc_m_sha " sha256="

text sc_m_arb "SYMBIOTE_ARBORIS workers=20 x925=10 a725=10 x925_nf=4352 a725_nf=3840 stride_f=16 l2_x925_b=2097152 l2_a725_b=524288 cues="

text sc_m_b1 "SYMBIOTE_BENCH nfloats=81920 nbytes=327680 iters="
text sc_m_b2 " trials="
text sc_m_b3 " scalar_med_ns="
text sc_m_b4 " w1_med_ns="
text sc_m_b5 " w20_med_ns="
text sc_m_b6 " w20_vs_w1_x100="
text sc_m_b7 " w20_vs_scalar_x100="

text sc_m_p1 "SYMBIOTE_PARITY diff_w1_scalar="
text sc_m_p2 " diff_w20_scalar="
text sc_m_p3 " diff_memo_w20="
text sc_m_p4 " ref_sha256="
text sc_m_p5 " w1_sha256="
text sc_m_p6 " w20_sha256="

text sc_m_m1 "SYMBIOTE_MEMO cold="
text sc_m_m2 " store="
text sc_m_m3 " warm="
text sc_m_m4 " warm_ns="
text sc_m_m5 " skipped_compute=1 bytes=327680 tamper_input_miss="
text sc_m_m6 " entry_sha256="

text sc_s_miss "MM_MISS"
text sc_s_ok "MM_OK"
text sc_s_hit "MEMO_HIT"
text sc_s_nl "\n"

text sc_e_mask "SYMBIOTE_ERR BAD_CPU_MASK rc="
text sc_e_pw "SYMBIOTE_ERR WATTCBF_REFUSE reason=power_budget p_prop_mw="
text sc_e_th "SYMBIOTE_ERR WATTCBF_REFUSE reason=thermal_floor_or_ceil t_die_mc="
text sc_e_elf "SYMBIOTE_ERR INVALID_WORKER_ELF rc="
text sc_e_wrk "SYMBIOTE_ERR WORKER_FAULT slot="
text sc_e_ulp "SYMBIOTE_ERR ULP_PARITY_FAIL diffs="
text sc_e_mem "SYMBIOTE_ERR MEMO_TAMPER_CAUGHT rc="

fn sc_puts s view uchar * to void
  n = len s
  k = write 1 s 0 n
end

fn sc_put_u u ulong to void
  pos = ulong 24
  if eq u 0
    pos = sub pos 1
    put sc_say pos uchar 48
  end
  while gt u 0 bound 32
    pos = sub pos 1
    put sc_say pos uchar add 48 rem u 10
    u = div u 10
  end
  k = write 1 sc_say pos sub 24 pos
end

fn sc_put_i v long to void
  if lt v 0
    put sc_say 60 uchar 45
    k = write 1 sc_say 60 1
    sc_put_u ulong sub 0 v
    ret
  end
  sc_put_u ulong v
end

fn sc_sha_byte src ulong i ulong to ulong
  if eq src 0
    ret ulong get sc_sha_elf i
  end
  if eq src 1
    ret ulong get sc_sha_ref i
  end
  if eq src 2
    ret ulong get sc_sha_w1 i
  end
  if eq src 3
    ret ulong get sc_sha_w20 i
  end
  ret ulong get mm_hit_entry_sha i
end

fn sc_put_hex_sha src ulong to void
  for i ulong 32
    b = sc_sha_byte src i
    put sc_say mul i 2 sh_hexd uint shr b 4
    put sc_say add mul i 2 1 sh_hexd uint and b 15
  end
  k = write 1 sc_say 0 64
end

fn sc_wr_u16_pkt off ulong v ulong to void
  put sc_pkt off uchar and v 255
  put sc_pkt add off 1 uchar and shr v 8 255
end

fn sc_wr_u32_hdr off ulong v ulong to void
  put sc_hdr off uchar and v 255
  put sc_hdr add off 1 uchar and shr v 8 255
  put sc_hdr add off 2 uchar and shr v 16 255
  put sc_hdr add off 3 uchar and shr v 24 255
end

fn sc_rd_u32_p2c off ulong to ulong
  r = ulong get sc_p2c off
  r = or r shl ulong get sc_p2c add off 1 8
  r = or r shl ulong get sc_p2c add off 2 16
  ret or r shl ulong get sc_p2c add off 3 24
end

fn sc_rd_u32_c2p off ulong to ulong
  r = ulong get sc_c2p off
  r = or r shl ulong get sc_c2p add off 1 8
  r = or r shl ulong get sc_c2p add off 2 16
  ret or r shl ulong get sc_c2p add off 3 24
end

fn sc_rd_u32_st off ulong to ulong
  r = ulong get sc_st off
  r = or r shl ulong get sc_st add off 1 8
  r = or r shl ulong get sc_st add off 2 16
  ret or r shl ulong get sc_st add off 3 24
end

fn sc_rd_u16_sh off ulong to ulong
  r = ulong get sh_dat off
  ret or r shl ulong get sh_dat add off 1 8
end

fn sc_rd_u32_sh off ulong to ulong
  r = ulong get sh_dat off
  r = or r shl ulong get sh_dat add off 1 8
  r = or r shl ulong get sh_dat add off 2 16
  ret or r shl ulong get sh_dat add off 3 24
end

fn sc_rd_u64_sh off ulong to ulong
  lo = sc_rd_u32_sh off
  hi = sc_rd_u32_sh add off 4
  ret or lo shl hi 32
end

fn sc_wr_u32_in off ulong v ulong to void
  put sc_in off uchar and v 255
  put sc_in add off 1 uchar and shr v 8 255
  put sc_in add off 2 uchar and shr v 16 255
  put sc_in add off 3 uchar and shr v 24 255
end

fn sc_rd_u32_in off ulong to ulong
  r = ulong get sc_in off
  r = or r shl ulong get sc_in add off 1 8
  r = or r shl ulong get sc_in add off 2 16
  ret or r shl ulong get sc_in add off 3 24
end

fn sc_wr_u32_ref off ulong v ulong to void
  put sc_ref off uchar and v 255
  put sc_ref add off 1 uchar and shr v 8 255
  put sc_ref add off 2 uchar and shr v 16 255
  put sc_ref add off 3 uchar and shr v 24 255
end

fn sc_wr_u32_sh off ulong v ulong to void
  put sh_dat off uchar and v 255
  put sh_dat add off 1 uchar and shr v 8 255
  put sh_dat add off 2 uchar and shr v 16 255
  put sh_dat add off 3 uchar and shr v 24 255
end

fn sc_arg_eq n ulong s view uchar * to bool
  m = len s
  if ne n m
    ret false
  end
  for i ulong n bound 128
    if ne get sc_arg i get s i
      ret false
    end
  end
  ret true
end

fn sc_parse_ulong n ulong to ulong
  if eq n 0
    exit 64
  end
  v = ulong 0
  for i ulong n bound 32
    c = get sc_arg i
    if or lt c 48 gt c 57
      exit 64
    end
    v = add mul v 10 ulong sub c 48
  end
  ret v
end

fn sc_set_def_paths to void
  n1 = len sc_def_wrk
  for i ulong n1 bound 64
    put sc_wpath i get sc_def_wrk i
  end
  put sc_wplen 0 n1
  n2 = len sc_def_mdir
  for i ulong n2 bound 64
    put sc_mdir i get sc_def_mdir i
  end
  put sc_mdlen 0 n2
end

fn sc_copy_arg_to dst ulong n ulong to void
  if or eq n 0 ge n 500
    exit 64
  end
  for i ulong n bound 500
    if eq dst 0
      put sc_wpath i get sc_arg i
    else
      put sc_mdir i get sc_arg i
    end
  end
  if eq dst 0
    put sc_wplen 0 n
  else
    put sc_mdlen 0 n
  end
end

fn sc_parse_flag n ulong to ulong
  if sc_arg_eq n sc_f_probe
    put sc_mode 0 1
    ret 1
  end
  if sc_arg_eq n sc_f_bench
    put sc_mode 0 0
    ret 1
  end
  if sc_arg_eq n sc_f_disp
    put sc_mode 0 2
    ret 1
  end
  if sc_arg_eq n sc_f_bmask
    put sc_flags 0 or get sc_flags 0 1
    ret 1
  end
  if sc_arg_eq n sc_f_tmem
    put sc_flags 0 or get sc_flags 0 2
    ret 1
  end
  if sc_arg_eq n sc_f_ulp
    put sc_flags 0 or get sc_flags 0 4
    ret 1
  end
  if sc_arg_eq n sc_f_skip
    put sc_flags 0 or get sc_flags 0 8
    ret 1
  end
  if sc_arg_eq n sc_f_exhit
    put sc_flags 0 or get sc_flags 0 16
    ret 1
  end
  ret 0
end

fn sc_parse_kv_id n ulong to ulong
  if sc_arg_eq n sc_f_wrk
    ret 1
  end
  if sc_arg_eq n sc_f_mdir
    ret 2
  end
  if sc_arg_eq n sc_f_itr
    ret 3
  end
  if sc_arg_eq n sc_f_trl
    ret 4
  end
  if sc_arg_eq n sc_f_bud
    ret 5
  end
  if sc_arg_eq n sc_f_pmw
    ret 6
  end
  if sc_arg_eq n sc_f_tdie
    ret 7
  end
  exit 64
end

fn sc_apply_kv kid ulong m ulong to ulong
  if eq kid 1
    sc_copy_arg_to 0 m
    ret 2
  end
  if eq kid 2
    sc_copy_arg_to 1 m
    ret 2
  end
  v = sc_parse_ulong m
  if eq kid 3
    put sc_iters 0 v
    ret 2
  end
  if eq kid 4
    put sc_trials 0 v
    ret 2
  end
  if eq kid 5
    put sc_budget_mw 0 long v
    ret 2
  end
  if eq kid 6
    put sc_sim_pmw 0 long v
    ret 2
  end
  put sc_sim_tdie 0 long v
  ret 2
end

fn sc_parse_one idx ulong to ulong
  rn = argread idx sc_arg 0 510
  if le rn 0
    exit 64
  end
  n = ulong rn
  if eq sc_parse_flag n 1
    ret 1
  end
  kid = sc_parse_kv_id n
  if ge add idx 1 ulong argcnt
    exit 64
  end
  r2 = argread add idx 1 sc_arg 0 510
  if le r2 0
    exit 64
  end
  ret sc_apply_kv kid ulong r2
end

fn sc_init_cli to void
  put sc_mode 0 0
  sc_set_def_paths
  put sc_iters 0 SC_DEF_ITERS
  put sc_trials 0 SC_DEF_TRIALS
  put sc_budget_mw 0 SC_BUDGET_HARD
  put sc_sim_pmw 0 0
  put sc_sim_tdie 0 -1
  put sc_flags 0 0
  idx = ulong 1
  ac = ulong argcnt
  while lt idx ac bound 64
    step = sc_parse_one idx
    idx = add idx step
  end
  it = get sc_iters 0
  tr = get sc_trials 0
  if or eq it 0 gt it 65536
    exit 64
  end
  if or eq tr 0 gt tr 15
    exit 64
  end
end

fn sc_watt_eval st view WattThermal pcpu long lim long to void
  pol = new WattPolicy lim lim SC_T_CEIL 2
  pr = new WattProp 0 pcpu 12000 50
  cm = new WattCmd 0 0 0 0 0 0
  wc_cbf_filter st pol pr cm
  fc = get cm fail_closed
  td = get st t_die
  if or eq fc 1 or wc_must_fail_closed st pol lt td SC_T_FLOOR
    sc_puts sc_e_th
    sc_put_i td
    sc_puts sc_s_nl
    exit 67
  end
  pprop = add pcpu 12000
  if gt pprop lim
    sc_puts sc_e_pw
    sc_put_i pprop
    sc_puts sc_s_nl
    exit 66
  end
  put sc_therm 2 td
  put sc_therm 5 pprop
  put sc_therm 6 lim
  put sc_therm 7 0
end

fn sc_run_wattcbf to void
  ws_sense_all
  st = new WattThermal 45000 38000 25000
  ok = ws_fill_thermal_state st
  if gt get sc_sim_tdie 0 -1
    put st t_die get sc_sim_tdie 0
  end
  lim = get sc_budget_mw 0
  if gt lim SC_BUDGET_HARD
    lim = SC_BUDGET_HARD
  end
  pcpu = long 42000
  if gt get sc_sim_pmw 0 0
    pcpu = get sc_sim_pmw 0
  end
  sc_watt_eval st pcpu lim
  put sc_therm 0 get g_wmeta 0
  put sc_therm 1 get g_wmeta 1
  put sc_therm 3 get g_wmeta 3
  put sc_therm 4 get g_wmeta 4
end

fn sc_print_probe to void
  sc_puts sc_m_probe
  sc_put_i get sc_therm 0
  sc_puts sc_m_cpus
  sc_put_i get sc_therm 1
  sc_puts sc_m_tmax
  sc_put_i get sc_therm 2
  sc_puts sc_m_a7
  sc_put_i get sc_therm 3
  sc_puts sc_m_x9
  sc_put_i get sc_therm 4
  sc_puts sc_m_pprop
  sc_put_i get sc_therm 5
  sc_puts sc_m_plim
  sc_put_i get sc_therm 6
  sc_puts sc_m_fc
  sc_put_i get sc_therm 7
  sc_puts sc_m_hw
end

fn sc_read_elf_fd fd int to ulong
  tot = ulong 0
  while lt tot 262144 bound 4096
    rc = read fd sh_dat tot sub 262144 tot
    if lt rc 0
      exit 68
    end
    if eq rc 0
      ret tot
    end
    tot = add tot ulong rc
  end
  ret tot
end

fn sc_verify_elf_phdrs tot ulong to void
  if lt tot 64
    exit 68
  end
  if ne get sh_dat 0 127
    exit 68
  end
  if ne get sh_dat 1 69
    exit 68
  end
  if ne get sh_dat 2 76
    exit 68
  end
  if ne get sh_dat 3 70
    exit 68
  end
  if ne sc_rd_u16_sh 18 183
    exit 68
  end
  phoff = sc_rd_u64_sh 32
  phent = sc_rd_u16_sh 54
  phnum = sc_rd_u16_sh 56
  if ge add phoff mul phnum phent tot
    exit 68
  end
  for i ulong phnum bound 64
    off = add phoff mul i phent
    if eq sc_rd_u32_sh off 2
      sc_puts sc_e_elf
      sc_put_u 2
      sc_puts sc_s_nl
      exit 68
    end
  end
end

fn sc_probe_elf to ulong
  raw_fd = fopen sc_wpath 0 get sc_wplen 0 0 0
  if lt raw_fd 0
    sc_puts sc_e_elf
    sc_put_i raw_fd
    sc_puts sc_s_nl
    exit 68
  end
  fd = int raw_fd
  tot = sc_read_elf_fd fd
  k = fclose fd
  sc_verify_elf_phdrs tot
  sh_all tot
  for i ulong 32
    put sc_sha_elf i get sh_dig i
  end
  ret tot
end

fn sc_check_bad_mask_ctl to void
  for i ulong 8
    put sc_msk i 0
  end
  rc = cpuset 0 sc_msk 0 8
  if ge rc 0
    exit 65
  end
  if ne and get sc_flags 0 1 0
    sc_puts sc_e_mask
    sc_put_i rc
    sc_puts sc_s_nl
    exit 65
  end
end

fn sc_init_cpu_list to void
  put sc_cpu 0 5
  put sc_cpu 1 6
  put sc_cpu 2 7
  put sc_cpu 3 8
  put sc_cpu 4 9
  put sc_cpu 5 15
  put sc_cpu 6 16
  put sc_cpu 7 17
  put sc_cpu 8 18
  put sc_cpu 9 19
  put sc_cpu 10 0
  put sc_cpu 11 1
  put sc_cpu 12 2
  put sc_cpu 13 3
  put sc_cpu 14 4
  put sc_cpu 15 10
  put sc_cpu 16 11
  put sc_cpu 17 12
  put sc_cpu 18 13
  put sc_cpu 19 14
end

fn sc_init_schedule to void
  sc_init_cpu_list
  cur = ulong 0
  for i ulong SC_W20
    if ge get sc_cpu i 20
      exit 65
    end
    if lt i 10
      put sc_clus i 1
      put sc_cnt_f i SC_X925_NF
      put sc_arb_tile i SC_L2_X925
    else
      put sc_clus i 0
      put sc_cnt_f i SC_A725_NF
      put sc_arb_tile i SC_L2_A725
    end
    put sc_off_f i cur
    cur = add cur get sc_cnt_f i
  end
  if ne cur SC_NFLOATS
    exit 65
  end
  put sc_arb_cues 0 0
end

fn sc_init_inputs to void
  for i ulong SC_NFLOATS
    r = rem i 127
    s = add 0.25f32 mul f32 r 0.00390625f32
    sc_wr_u32_in mul i 4 ulong bitcast uint s
  end
end

fn sc_wr_all_hdr fd int to long
  sent = ulong 0
  while lt sent 32 bound 128
    rc = write fd sc_hdr sent sub 32 sent
    if le rc 0
      ret -1
    end
    sent = add sent ulong rc
  end
  ret 0
end

fn sc_wr_all_in fd int byte_off ulong n ulong to long
  sent = ulong 0
  while lt sent n bound 100000
    rc = write fd sc_in add byte_off sent sub n sent
    if le rc 0
      ret -1
    end
    sent = add sent ulong rc
  end
  ret 0
end

fn sc_rd_all_rdy fd int to long
  got = ulong 0
  while lt got 4 bound 32
    rc = read fd sc_rdy got sub 4 got
    if le rc 0
      ret -1
    end
    got = add got ulong rc
  end
  ret 0
end

fn sc_rd_all_out fd int dst ulong byte_off ulong n ulong to long
  got = ulong 0
  while lt got n bound 100000
    rc = long -1
    if eq dst 0
      rc = read fd sc_out add byte_off got sub n got
    else
      rc = read fd sc_w1 add byte_off got sub n got
    end
    if le rc 0
      ret -1
    end
    got = add got ulong rc
  end
  ret 0
end

fn sc_build_exec_pkt to ulong
  wn = get sc_wplen 0
  put sc_pkt 0 1
  put sc_pkt 1 0
  sc_wr_u16_pkt 2 wn
  for i ulong wn bound 512
    put sc_pkt add 4 i get sc_wpath i
  end
  ret add 4 wn
end

fn sc_spawn_one cpu ulong pkt_len ulong to long
  for i ulong 8
    put sc_msk i 0
  end
  put sc_msk div cpu 8 uchar shl ulong 1 rem cpu 8
  if or lt pipefds sc_p2c 0 8 0 0 lt pipefds sc_c2p 0 8 0 0
    exit 68
  end
  pid = fork
  if lt pid 0
    exit 68
  end
  if eq pid 0
    if ne cpuset 0 sc_msk 0 8 0
      exit 19
    end
    if lt dupfd int sc_rd_u32_p2c 0 0 0 0
      exit 12
    end
    if lt dupfd int sc_rd_u32_c2p 4 1 0 0
      exit 13
    end
    rc = execprog sc_pkt 0 pkt_len
    exit 14
  end
  k0 = fclose int sc_rd_u32_p2c 0
  k1 = fclose int sc_rd_u32_c2p 4
  ret pid
end

fn sc_wait_ready rfd int slot ulong pid long to void
  rr = sc_rd_all_rdy rfd
  if ne rr 0
    wp = waitpid int pid sc_st 0 4 0
    sc_puts sc_e_wrk
    sc_put_u slot
    sc_puts sc_s_nl
    exit 68
  end
  bad = ulong 0
  if ne get sc_rdy 0 83
    bad = 1
  end
  if ne get sc_rdy 1 89
    bad = 1
  end
  if ne get sc_rdy 2 77
    bad = 1
  end
  if ne get sc_rdy 3 49
    bad = 1
  end
  if ne bad 0
    sc_puts sc_e_wrk
    sc_put_u slot
    sc_puts sc_s_nl
    exit 68
  end
end

fn sc_fill_hdr nf ulong iters ulong arboris ulong to void
  sc_wr_u32_hdr 0 SC_MAGIC
  sc_wr_u32_hdr 4 nf
  sc_wr_u32_hdr 8 iters
  sc_wr_u32_hdr 12 SC_STRIDE_F
  sc_wr_u32_hdr 16 ulong SC_ALPHA_U
  sc_wr_u32_hdr 20 ulong SC_BETA_U
  sc_wr_u32_hdr 24 ulong SC_GAMMA_U
  sc_wr_u32_hdr 28 arboris
end

fn sc_spawn_w20 to void
  plen = sc_build_exec_pkt
  for i ulong SC_W20
    pid = sc_spawn_one get sc_cpu i plen
    put sc_pid i pid
    put sc_wfd i int sc_rd_u32_p2c 4
    put sc_rfd i int sc_rd_u32_c2p 0
  end
  for i ulong SC_W20
    sc_wait_ready get sc_rfd i i get sc_pid i
  end
end

fn sc_send_w20_slot slot ulong iters ulong to void
  nf = get sc_cnt_f slot
  sc_fill_hdr nf iters or get sc_clus slot shl SC_AHEAD_F 8
  wfd = get sc_wfd slot
  if ne sc_wr_all_hdr wfd 0
    sc_puts sc_e_wrk
    sc_put_u slot
    sc_puts sc_s_nl
    exit 68
  end
  boff = mul get sc_off_f slot 4
  rc = sc_wr_all_in wfd boff mul nf 4
  if ne rc 0
    sc_puts sc_e_wrk
    sc_put_u slot
    sc_puts sc_s_nl
    exit 68
  end
  put sc_arb_cues 0 add get sc_arb_cues 0 1
end

fn sc_recv_w20_slot slot ulong to void
  boff = mul get sc_off_f slot 4
  nb = mul get sc_cnt_f slot 4
  rc = sc_rd_all_out get sc_rfd slot 0 boff nb
  if ne rc 0
    sc_puts sc_e_wrk
    sc_put_u slot
    sc_puts sc_s_nl
    exit 68
  end
end

fn sc_step_w20 iters ulong to ulong
  t0 = monons
  for i ulong SC_W20
    sc_send_w20_slot i iters
  end
  for i ulong SC_W20
    sc_recv_w20_slot i
  end
  ret ulong sub monons t0
end

fn sc_stop_w20 to void
  sc_wr_u32_hdr 0 0
  sc_wr_u32_hdr 4 0
  sc_wr_u32_hdr 8 0
  for i ulong SC_W20
    wfd = get sc_wfd i
    k0 = sc_wr_all_hdr wfd
    f0 = fclose wfd
    f1 = fclose get sc_rfd i
    wp = waitpid int get sc_pid i sc_st 0 4 0
    if ne sc_rd_u32_st 0 0
      sc_puts sc_e_wrk
      sc_put_u i
      sc_puts sc_s_nl
      exit 68
    end
  end
end

fn sc_step_w1 wfd int rfd int iters ulong to ulong
  t0 = monons
  for c ulong 10
    sc_fill_hdr SC_W1_CHUNK iters 257
    if ne sc_wr_all_hdr wfd 0
      exit 68
    end
    boff = mul mul c SC_W1_CHUNK 4
    if ne sc_wr_all_in wfd boff mul SC_W1_CHUNK 4 0
      exit 68
    end
    if ne sc_rd_all_out rfd 1 boff mul SC_W1_CHUNK 4 0
      exit 68
    end
  end
  ret ulong sub monons t0
end

fn sc_stop_w1 wfd int rfd int pid long to void
  sc_wr_u32_hdr 0 0
  k0 = sc_wr_all_hdr wfd
  f0 = fclose wfd
  f1 = fclose rfd
  wp = waitpid int pid sc_st 0 4 0
  if ne sc_rd_u32_st 0 0
    exit 68
  end
end

fn sc_bench_w1 iters ulong trials ulong to void
  plen = sc_build_exec_pkt
  pid = sc_spawn_one 5 plen
  wfd = int sc_rd_u32_p2c 4
  rfd = int sc_rd_u32_c2p 0
  sc_wait_ready rfd 0 pid
  wrm = sc_step_w1 wfd rfd iters
  for t ulong trials bound 16
    put sc_t_w1 t sc_step_w1 wfd rfd iters
  end
  sc_stop_w1 wfd rfd pid
end

fn sc_scalar_loop iters ulong al f32 be f32 ga f32 to void
  for i ulong SC_NFLOATS
    v0 = bitcast f32 uint sc_rd_u32_in mul i 4
    v = v0
    k = ulong 0
    while lt k iters bound 70000
      v = fma v al be
      v = fma v ga v0
      v = fma v al be
      v = fma v ga v0
      k = add k 1
    end
    sc_wr_u32_ref mul i 4 ulong bitcast uint v
  end
end

fn sc_scalar_one iters ulong to ulong
  t0 = monons
  sc_scalar_loop iters bitcast f32 SC_ALPHA_U bitcast f32 SC_BETA_U bitcast f32 SC_GAMMA_U
  ret ulong sub monons t0
end

fn sc_bench_scalar iters ulong trials ulong to void
  if ne and get sc_flags 0 8 0
    dt = sc_scalar_one iters
    for t ulong trials bound 16
      put sc_t_scal t dt
    end
    ret
  end
  wrm = sc_scalar_one iters
  for t ulong trials bound 16
    put sc_t_scal t sc_scalar_one iters
  end
end

fn sc_t_get which ulong idx ulong to ulong
  if eq which 0
    ret get sc_t_scal idx
  end
  if eq which 1
    ret get sc_t_w1 idx
  end
  ret get sc_t_w20 idx
end

fn sc_t_put which ulong idx ulong val ulong to void
  if eq which 0
    put sc_t_scal idx val
    ret
  end
  if eq which 1
    put sc_t_w1 idx val
    ret
  end
  put sc_t_w20 idx val
end

fn sc_sort_arr which ulong n ulong to void
  for i ulong n bound 16
    for j ulong sub sub n 1 i bound 16
      va = sc_t_get which j
      vb = sc_t_get which add j 1
      if gt va vb
        sc_t_put which j vb
        sc_t_put which add j 1 va
      end
    end
  end
end

fn sc_compute_stats trials ulong to void
  sc_sort_arr 0 trials
  sc_sort_arr 1 trials
  sc_sort_arr 2 trials
  mid = div trials 2
  put sc_meds 0 get sc_t_scal mid
  put sc_meds 1 get sc_t_w1 mid
  put sc_meds 2 get sc_t_w20 mid
  put sc_meds 3 get sc_t_scal 0
  put sc_meds 4 get sc_t_w1 0
  put sc_meds 5 get sc_t_w20 0
end

fn sc_hash_tensor which ulong to void
  for i ulong SC_NBYTES
    if eq which 0
      put sh_dat i get sc_ref i
    else
      if eq which 1
        put sh_dat i get sc_w1 i
      else
        put sh_dat i get sc_out i
      end
    end
  end
  sh_all SC_NBYTES
  for i ulong 32
    if eq which 0
      put sc_sha_ref i get sh_dig i
    else
      if eq which 1
        put sc_sha_w1 i get sh_dig i
      else
        put sc_sha_w20 i get sh_dig i
      end
    end
  end
end

fn sc_verify_parity to void
  if ne and get sc_flags 0 4 0
    put sc_out 0 xor get sc_out 0 1
  end
  d1 = ulong 0
  d2 = ulong 0
  for i ulong SC_NBYTES
    if ne get sc_w1 i get sc_ref i
      d1 = add d1 1
    end
    if ne get sc_out i get sc_ref i
      d2 = add d2 1
    end
  end
  put sc_diffs 0 d1
  put sc_diffs 1 d2
  if or ne d1 0 ne d2 0
    sc_puts sc_e_ulp
    sc_put_u add d1 d2
    sc_puts sc_s_nl
    exit 70
  end
  sc_hash_tensor 0
  sc_hash_tensor 1
  sc_hash_tensor 2
end

fn sc_memo_prep_key to void
  mm_reset_req
  mm_reset_stats
  mp_set_override MP_OVR_FORCE
  mp_set_alarm_silent 1
  kn = len sc_ktag
  for i ulong kn bound 64
    put sh_dat i get sc_ktag i
  end
  for i ulong 32
    put sh_dat add kn i get sc_sha_elf i
  end
  p = add kn 32
  sc_wr_u32_sh p SC_NFLOATS
  sc_wr_u32_sh add p 4 get sc_iters 0
  sc_wr_u32_sh add p 8 ulong SC_ALPHA_U
  sc_wr_u32_sh add p 12 ulong SC_BETA_U
  sc_wr_u32_sh add p 16 ulong SC_GAMMA_U
  sc_wr_u32_sh add p 20 SC_ROWS
  sc_wr_u32_sh add p 24 SC_COLS
  sh_all add p 28
  mm_set_fid_from_sh
  mm_set_ir_sha_from_sh
  for i ulong SC_NBYTES
    put sh_dat i get sc_in i
  end
  sh_all SC_NBYTES
  mm_set_in_sha_from_sh
  mm_set_contract 1 1 MM_TIER_EXACT 0
  mm_set_provenance 4 0
end

fn sc_memo_setup_root to void
  ml = get sc_mdlen 0
  for i ulong ml bound 500
    put mm_env_buf i get sc_mdir i
  end
  if ne mm_set_root_from_envbuf ml 0
    exit 63
  end
  if ne mm_mkdir_p 0
    exit 63
  end
end

fn sc_memo_copy_out to void
  for i ulong SC_NBYTES
    put mm_val_buf i get sc_out i
  end
  put mm_val_len 0 SC_NBYTES
  for i ulong 32
    put mm_val_sha i get sc_sha_w20 i
  end
end

fn sc_flip_memo_byte to void
  plen = get mm_file_plen 0
  if eq plen 0
    exit 63
  end
  raw_fd = fopen mm_file_path 0 plen 2 0
  if lt raw_fd 0
    exit 63
  end
  fd = int raw_fd
  if ne fseek fd 256 0 256
    k0 = fclose fd
    exit 63
  end
  if ne read fd sc_tmp_b 0 1 1
    k0 = fclose fd
    exit 63
  end
  put sc_tmp_b 0 xor get sc_tmp_b 0 1
  if ne fseek fd 256 0 256
    k1 = fclose fd
    exit 63
  end
  wc = write fd sc_tmp_b 0 1
  k2 = fclose fd
end

fn sc_memo_tamper_file to void
  sc_flip_memo_byte
  trc = mm_lookup
  sc_puts sc_e_mem
  sc_put_u trc
  sc_puts sc_s_nl
  if ne trc MM_ERR_TAMPER
    exit 62
  end
  exit 63
end

fn sc_memo_warm_check to void
  t0 = monons
  rc = mm_lookup
  t1 = monons
  if ne rc MM_OK
    exit 63
  end
  dm = ulong 0
  for i ulong SC_NBYTES
    if ne get mm_val_buf i get sc_out i
      dm = add dm 1
    end
  end
  if or ne dm 0 ne get mm_val_len 0 SC_NBYTES
    exit 63
  end
  put sc_diffs 2 dm
  put sc_memo_res 2 rc
  put sc_meds 7 ulong sub t1 t0
end

fn sc_run_memo to void
  sc_memo_setup_root
  sc_memo_prep_key
  rc_cold = mm_lookup
  if ne rc_cold MM_MISS
    exit 63
  end
  sc_memo_copy_out
  rc_st = mm_store get sc_meds 2 get sc_meds 0
  if ne rc_st MM_OK
    exit 63
  end
  sc_memo_warm_check
  if ne and get sc_flags 0 2 0
    sc_memo_tamper_file
  end
  put mm_req_in_sha 0 xor get mm_req_in_sha 0 1
  rc_tmp = mm_lookup
  if ne rc_tmp MM_MISS
    exit 63
  end
  put mm_req_in_sha 0 xor get mm_req_in_sha 0 1
  put sc_memo_res 0 rc_cold
  put sc_memo_res 1 rc_st
  put sc_memo_res 3 rc_tmp
end

fn sc_print_bench_part to void
  sc_puts sc_m_b1
  sc_put_u get sc_iters 0
  sc_puts sc_m_b2
  sc_put_u get sc_trials 0
  sc_puts sc_m_b3
  sc_put_u get sc_meds 0
  sc_puts sc_m_b4
  sc_put_u get sc_meds 1
  sc_puts sc_m_b5
  sc_put_u get sc_meds 2
  sc_puts sc_m_b6
  sc_put_u div mul get sc_meds 1 100 get sc_meds 2
  sc_puts sc_m_b7
  sc_put_u div mul get sc_meds 0 100 get sc_meds 2
  sc_puts sc_s_nl
end

fn sc_print_parity_memo to void
  sc_puts sc_m_p1
  sc_put_u get sc_diffs 0
  sc_puts sc_m_p2
  sc_put_u get sc_diffs 1
  sc_puts sc_m_p3
  sc_put_u get sc_diffs 2
  sc_puts sc_m_p4
  sc_put_hex_sha 1
  sc_puts sc_m_p5
  sc_put_hex_sha 2
  sc_puts sc_m_p6
  sc_put_hex_sha 3
  sc_puts sc_s_nl
  sc_puts sc_m_m1
  sc_puts sc_s_miss
  sc_puts sc_m_m2
  sc_puts sc_s_ok
  sc_puts sc_m_m3
  sc_puts sc_s_hit
  sc_puts sc_m_m4
  sc_put_u get sc_meds 7
  sc_puts sc_m_m5
  sc_puts sc_s_miss
  sc_puts sc_m_m6
  sc_put_hex_sha 4
  sc_puts sc_s_nl
end

fn sc_print_all elf_bytes ulong to void
  sc_print_probe
  sc_puts sc_m_elf
  sc_put_u elf_bytes
  sc_puts sc_m_ptd
  sc_put_u 0
  sc_puts sc_m_sha
  sc_put_hex_sha 0
  sc_puts sc_s_nl
  sc_puts sc_m_arb
  sc_put_u get sc_arb_cues 0
  sc_puts sc_s_nl
  sc_print_bench_part
  sc_print_parity_memo
end

fn sc_run_bench_mode elf_b ulong to void
  sc_init_inputs
  iters = get sc_iters 0
  trials = get sc_trials 0
  sc_spawn_w20
  wrm1 = sc_step_w20 iters
  wrm2 = sc_step_w20 iters
  for t ulong trials bound 16
    put sc_t_w20 t sc_step_w20 iters
  end
  sc_stop_w20
  sc_bench_w1 iters trials
  sc_bench_scalar iters trials
  sc_verify_parity
  sc_compute_stats trials
  sc_run_memo
  sc_print_all elf_b
end

fn sc_run_dispatch_hit to void
  sc_init_inputs
  sc_memo_setup_root
  sc_memo_prep_key
  t0 = monons
  rc = mm_lookup
  t1 = monons
  if or ne rc MM_OK ne get mm_val_len 0 SC_NBYTES
    exit 63
  end
  for i ulong SC_NBYTES
    put sc_out i get mm_val_buf i
  end
  sc_hash_tensor 2
  sc_puts sc_m_m3
  sc_puts sc_s_hit
  sc_puts sc_m_m4
  sc_put_u ulong sub t1 t0
  sc_puts sc_m_m5
  sc_puts sc_s_miss
  sc_puts sc_m_m6
  sc_put_hex_sha 4
  sc_puts sc_s_nl
end

fn main to void
  sc_init_cli
  sc_run_wattcbf
  if eq get sc_mode 0 1
    sc_print_probe
    ret
  end
  sc_check_bad_mask_ctl
  sc_init_schedule
  elf_b = sc_probe_elf
  if ne and get sc_flags 0 16 0
    sc_run_dispatch_hit
    ret
  end
  sc_run_bench_mode elf_b
end

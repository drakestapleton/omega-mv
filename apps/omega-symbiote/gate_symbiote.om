om2
note SPDX-License-Identifier: Apache-2.0
note apps/omega-symbiote/gate_symbiote.om
note Pure seeded OM-2 verification gate for 20-Core Grace NEON Symbiote (apps/omega-symbiote/).
note Runs 4 positive controls + 8 negative/fault-injection controls against symbiote_coord,
note symbiote_worker, worker.opt.ir, and ngcheck (ZERO C, Python, or shell).
note
note Build:
note   seed/out/omc < apps/omega-symbiote/gate_symbiote.om > gate_symbiote
note Usage:
note   ./gate_symbiote <symbiote_coord> <symbiote_worker> <ngcheck> <worker.opt.ir> <scratch_dir>

global gs_coord uchar 512
global gs_clen ulong 1
global gs_wrk uchar 512
global gs_wlen ulong 1
global gs_ngck uchar 512
global gs_nlen ulong 1
global gs_ir uchar 512
global gs_ilen ulong 1
global gs_dir uchar 512
global gs_dlen ulong 1

global gs_pkt uchar 4096
global gs_plen ulong 1
global gs_argc ulong 1
global gs_p_in uchar 8
global gs_p_out uchar 8
global gs_st uchar 8
global gs_out uchar 65536
global gs_olen ulong 1
global gs_buf uchar 65536
global gs_blen ulong 1
global gs_arg uchar 512
global gs_say uchar 32
global gs_res ulong 4

text gs_hdr "=== OMEGA GRACE SYMBIOTE GATE (PURE OM-2, 4 POS + 9 NEG) ===\n"
text gs_pass "GATE_SYMBIOTE PASS pos="
text gs_neg " neg="
text gs_fail "GATE_SYMBIOTE FAIL test="
text gs_rc_s " rc="
text gs_nl "\n"

text gs_p1 "P1_probe_thermal"
text gs_p2 "P2_ngcheck_accept"
text gs_p3 "P3_bench_w20_parity_memo"
text gs_p4 "P4_xproc_memo_hit"
text gs_n1 "N1_wattcbf_over_80w"
text gs_n2 "N2_wattcbf_over_temp"
text gs_n3 "N3_wattcbf_temp_floor"
text gs_n4 "N4_corrupt_ir_ngcheck"
text gs_n5 "N5_bad_cpu_mask"
text gs_n6 "N6_worker_fault_bad_elf"
text gs_n7 "N7_ulp_mismatch_trap"
text gs_n8 "N8_memo_slab_tamper"
text gs_n9 "N9_worker_bad_hdr_exit"

text gs_a_probe "probe-thermal"
text gs_a_bench "bench"
text gs_a_wrk "--worker"
text gs_a_mdir "--memo-dir"
text gs_a_itr "--iters"
text gs_a_trl "--trials"
text gs_a_pmw "--sim-pmw"
text gs_a_tdie "--sim-tdie-mc"
text gs_a_bmask "--bad-mask"
text gs_a_tmem "--tamper-memo"
text gs_a_ulp "--inject-ulp"
text gs_a_skip "--skip-scalar"
text gs_a_exhit "--memo-expect-hit"
text gs_v_1024 "1024"
text gs_v_8 "8"
text gs_v_5 "5"
text gs_v_1 "1"
text gs_v_75000 "75000"
text gs_v_86000 "86000"
text gs_v_1000 "1000"
text gs_v_miss "/nonexistent/symbiote_worker_bad"
text gs_s_mpos "/memo-pos"
text gs_s_mn7 "/memo-n7"
text gs_s_mn8 "/memo-n8"
text gs_s_cir "/corrupt.ir"

text gs_chk_tz "thermal_zones=7"
text gs_chk_cpus "cpus=20"
text gs_chk_hw "hw_writes=0"
text gs_chk_acc "ACCEPT "
text gs_chk_dw1 "diff_w1_scalar=0"
text gs_chk_dw20 "diff_w20_scalar=0"
text gs_chk_dmem "diff_memo_w20=0"
text gs_chk_cold "cold=MM_MISS"
text gs_chk_hit "warm=MEMO_HIT"
text gs_chk_tmiss "tamper_input_miss=MM_MISS"
text gs_chk_skip "skipped_compute=1"
text gs_chk_w1m "w1_med_ns="
text gs_chk_w20m "w20_med_ns="
text gs_chk_scm "scalar_med_ns="
text gs_ok_pre "PASS "

fn gs_puts s view uchar * to void
  n = len s
  k = write 1 s 0 n
end

fn gs_put_u u ulong to void
  pos = ulong 24
  if eq u 0
    pos = sub pos 1
    put gs_say pos uchar 48
  end
  while gt u 0 bound 32
    pos = sub pos 1
    put gs_say pos uchar add 48 rem u 10
    u = div u 10
  end
  k = write 1 gs_say pos sub 24 pos
end

fn gs_rd_u32_p_in off ulong to ulong
  r = ulong get gs_p_in off
  r = or r shl ulong get gs_p_in add off 1 8
  r = or r shl ulong get gs_p_in add off 2 16
  ret or r shl ulong get gs_p_in add off 3 24
end

fn gs_rd_u32_p_out off ulong to ulong
  r = ulong get gs_p_out off
  r = or r shl ulong get gs_p_out add off 1 8
  r = or r shl ulong get gs_p_out add off 2 16
  ret or r shl ulong get gs_p_out add off 3 24
end

fn gs_exit_code st_raw ulong to ulong
  if eq and st_raw 127 0
    ret and shr st_raw 8 255
  end
  ret add 128 and st_raw 127
end

fn gs_rd_u32_st to ulong
  r = ulong get gs_st 0
  r = or r shl ulong get gs_st 1 8
  r = or r shl ulong get gs_st 2 16
  ret or r shl ulong get gs_st 3 24
end

fn gs_wr_u16_pkt off ulong v ulong to void
  put gs_pkt off uchar and v 255
  put gs_pkt add off 1 uchar and shr v 8 255
end

fn gs_pkt_reset to void
  put gs_pkt 0 0
  put gs_pkt 1 0
  put gs_plen 0 2
  put gs_argc 0 0
end

fn gs_pkt_inc to void
  c = add get gs_argc 0 1
  put gs_argc 0 c
  gs_wr_u16_pkt 0 c
end

fn gs_pkt_add s view uchar * to void
  p = get gs_plen 0
  m = len s
  gs_wr_u16_pkt p m
  p = add p 2
  for i ulong m bound 1024
    put gs_pkt add p i get s i
  end
  put gs_plen 0 add p m
  gs_pkt_inc
end

fn gs_pkt_add_g which ulong to void
  p = get gs_plen 0
  m = ulong 0
  if eq which 0
    m = get gs_clen 0
  else
    if eq which 1
      m = get gs_wlen 0
    else
      if eq which 2
        m = get gs_nlen 0
      else
        m = get gs_ilen 0
      end
    end
  end
  gs_wr_u16_pkt p m
  p = add p 2
  for i ulong m bound 512
    ch = uchar 0
    if eq which 0
      ch = get gs_coord i
    else
      if eq which 1
        ch = get gs_wrk i
      else
        if eq which 2
          ch = get gs_ngck i
        else
          ch = get gs_ir i
        end
      end
    end
    put gs_pkt add p i ch
  end
  put gs_plen 0 add p m
  gs_pkt_inc
end

fn gs_pkt_add_mdir suf view uchar * to void
  p = get gs_plen 0
  dn = get gs_dlen 0
  sn = len suf
  m = add dn sn
  gs_wr_u16_pkt p m
  p = add p 2
  for i ulong dn bound 512
    put gs_pkt add p i get gs_dir i
  end
  for j ulong sn bound 128
    put gs_pkt add add p dn j get suf j
  end
  put gs_plen 0 add p m
  gs_pkt_inc
end

fn gs_copy_arg idx ulong dst ulong to void
  rn = argread idx gs_arg 0 510
  if le rn 0
    exit 90
  end
  n = ulong rn
  for i ulong n bound 512
    if eq dst 0
      put gs_coord i get gs_arg i
    else
      if eq dst 1
        put gs_wrk i get gs_arg i
      else
        if eq dst 2
          put gs_ngck i get gs_arg i
        else
          if eq dst 3
            put gs_ir i get gs_arg i
          else
            put gs_dir i get gs_arg i
          end
        end
      end
    end
  end
  if eq dst 0
    put gs_clen 0 n
  else
    if eq dst 1
      put gs_wlen 0 n
    else
      if eq dst 2
        put gs_nlen 0 n
      else
        if eq dst 3
          put gs_ilen 0 n
        else
          put gs_dlen 0 n
        end
      end
    end
  end
end

fn gs_init_args to void
  if lt argcnt 6
    exit 90
  end
  gs_copy_arg 1 0
  gs_copy_arg 2 1
  gs_copy_arg 3 2
  gs_copy_arg 4 3
  gs_copy_arg 5 4
end

fn gs_wr_stdin fd int n ulong to void
  sent = ulong 0
  while lt sent n bound 100000
    rc = write fd gs_buf sent sub n sent
    if le rc 0
      ret
    end
    sent = add sent ulong rc
  end
end

fn gs_rd_stdout fd int to void
  tot = ulong 0
  while lt tot 65500 bound 100000
    rc = read fd gs_out tot sub 65500 tot
    if le rc 0
      put gs_olen 0 tot
      ret
    end
    tot = add tot ulong rc
  end
  put gs_olen 0 tot
end

fn gs_run_child use_in bool in_len ulong to ulong
  if or lt pipefds gs_p_in 0 8 0 0 lt pipefds gs_p_out 0 8 0 0
    exit 91
  end
  pid = fork
  if lt pid 0
    exit 91
  end
  if eq pid 0
    if use_in
      d0 = dupfd int gs_rd_u32_p_in 0 0 0
    end
    d1 = dupfd int gs_rd_u32_p_out 4 1 0
    d2 = dupfd int gs_rd_u32_p_out 4 2 0
    rc = execprog gs_pkt 0 get gs_plen 0
    exit 127
  end
  k0 = fclose int gs_rd_u32_p_in 0
  k1 = fclose int gs_rd_u32_p_out 4
  wfd = int gs_rd_u32_p_in 4
  if use_in
    gs_wr_stdin wfd in_len
  end
  k2 = fclose wfd
  rfd = int gs_rd_u32_p_out 0
  gs_rd_stdout rfd
  k3 = fclose rfd
  wp = waitpid int pid gs_st 0 4 0
  ret gs_exit_code gs_rd_u32_st
end

fn gs_has_substr pat view uchar * to bool
  pn = len pat
  tot = get gs_olen 0
  if gt pn tot
    ret false
  end
  lim = add sub tot pn 1
  for i ulong lim bound 65536
    ok = true
    for j ulong pn bound 128
      if ne get gs_out add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn gs_parse_val_after pat view uchar * to ulong
  pn = len pat
  tot = get gs_olen 0
  if gt pn tot
    ret 0
  end
  lim = add sub tot pn 1
  for i ulong lim bound 65536
    ok = true
    for j ulong pn bound 128
      if ne get gs_out add i j get pat j
        ok = false
        break
      end
    end
    if ok
      v = ulong 0
      p = add i pn
      while lt p tot bound 32
        ch = get gs_out p
        if or lt ch 48 gt ch 57
          ret v
        end
        v = add mul v 10 ulong sub ch 48
        p = add p 1
      end
      ret v
    end
  end
  ret 0
end

fn gs_fail_exit name view uchar * rc ulong to void
  gs_puts gs_fail
  gs_puts name
  gs_puts gs_rc_s
  gs_put_u rc
  gs_puts gs_nl
  exit 1
end

fn gs_pass_log name view uchar * rc ulong to void
  gs_puts gs_ok_pre
  gs_puts name
  gs_puts gs_rc_s
  gs_put_u rc
  gs_puts gs_nl
end

fn gs_load_ir to ulong
  raw = fopen gs_ir 0 get gs_ilen 0 0 0
  if lt raw 0
    exit 92
  end
  fd = int raw
  tot = ulong 0
  while lt tot 65500 bound 1024
    rc = read fd gs_buf tot sub 65500 tot
    if le rc 0
      break
    end
    tot = add tot ulong rc
  end
  k = fclose fd
  put gs_blen 0 tot
  ret tot
end

fn gs_test_p1 to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_probe
  rc = gs_run_child false 0
  if ne rc 0
    gs_fail_exit gs_p1 rc
  end
  if or not gs_has_substr gs_chk_tz not gs_has_substr gs_chk_cpus
    gs_fail_exit gs_p1 99
  end
  if not gs_has_substr gs_chk_hw
    gs_fail_exit gs_p1 98
  end
  gs_pass_log gs_p1 rc
  put gs_res 0 add get gs_res 0 1
end

fn gs_test_p2 to void
  nb = gs_load_ir
  gs_pkt_reset
  gs_pkt_add_g 2
  rc = gs_run_child true nb
  if ne rc 0
    gs_fail_exit gs_p2 rc
  end
  if not gs_has_substr gs_chk_acc
    gs_fail_exit gs_p2 99
  end
  gs_pass_log gs_p2 rc
  put gs_res 0 add get gs_res 0 1
end

fn gs_check_p3_out rc ulong to void
  if ne rc 0
    gs_fail_exit gs_p3 rc
  end
  if or not gs_has_substr gs_chk_dw1 not gs_has_substr gs_chk_dw20
    gs_fail_exit gs_p3 97
  end
  if or not gs_has_substr gs_chk_dmem not gs_has_substr gs_chk_cold
    gs_fail_exit gs_p3 96
  end
  if or not gs_has_substr gs_chk_hit not gs_has_substr gs_chk_tmiss
    gs_fail_exit gs_p3 95
  end
  ts = gs_parse_val_after gs_chk_scm
  t1 = gs_parse_val_after gs_chk_w1m
  t20 = gs_parse_val_after gs_chk_w20m
  if or eq t20 0 or ge t20 t1 ge t20 ts
    gs_fail_exit gs_p3 94
  end
  gs_pass_log gs_p3 rc
  put gs_res 0 add get gs_res 0 1
end

fn gs_test_p3 to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_wrk
  gs_pkt_add_g 1
  gs_pkt_add gs_a_mdir
  gs_pkt_add_mdir gs_s_mpos
  gs_pkt_add gs_a_itr
  gs_pkt_add gs_v_1024
  gs_pkt_add gs_a_trl
  gs_pkt_add gs_v_5
  rc = gs_run_child false 0
  gs_check_p3_out rc
end

fn gs_test_p4 to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_wrk
  gs_pkt_add_g 1
  gs_pkt_add gs_a_mdir
  gs_pkt_add_mdir gs_s_mpos
  gs_pkt_add gs_a_itr
  gs_pkt_add gs_v_1024
  gs_pkt_add gs_a_exhit
  rc = gs_run_child false 0
  if ne rc 0
    gs_fail_exit gs_p4 rc
  end
  if or not gs_has_substr gs_chk_hit not gs_has_substr gs_chk_skip
    gs_fail_exit gs_p4 99
  end
  gs_pass_log gs_p4 rc
  put gs_res 0 add get gs_res 0 1
end

fn gs_test_neg_probe name view uchar * flag_id ulong val view uchar * want ulong to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_probe
  if eq flag_id 0
    gs_pkt_add gs_a_pmw
  else
    gs_pkt_add gs_a_tdie
  end
  gs_pkt_add val
  rc = gs_run_child false 0
  if ne rc want
    gs_fail_exit name rc
  end
  gs_pass_log name rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n4_corrupt_ir to void
  nb = gs_load_ir
  if lt nb 128
    exit 92
  end
  off = div nb 2
  put gs_buf off xor get gs_buf off 255
  gs_pkt_reset
  gs_pkt_add_g 2
  rc = gs_run_child true nb
  if eq rc 0
    gs_fail_exit gs_n4 rc
  end
  gs_pass_log gs_n4 rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n5_bad_mask to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_bmask
  rc = gs_run_child false 0
  if ne rc 65
    gs_fail_exit gs_n5 rc
  end
  gs_pass_log gs_n5 rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n6_bad_worker to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_wrk
  gs_pkt_add gs_v_miss
  rc = gs_run_child false 0
  if ne rc 68
    gs_fail_exit gs_n6 rc
  end
  gs_pass_log gs_n6 rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n7_ulp to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_wrk
  gs_pkt_add_g 1
  gs_pkt_add gs_a_mdir
  gs_pkt_add_mdir gs_s_mn7
  gs_pkt_add gs_a_itr
  gs_pkt_add gs_v_8
  gs_pkt_add gs_a_trl
  gs_pkt_add gs_v_1
  gs_pkt_add gs_a_skip
  gs_pkt_add gs_a_ulp
  rc = gs_run_child false 0
  if ne rc 70
    gs_fail_exit gs_n7 rc
  end
  gs_pass_log gs_n7 rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n8_memo_tamper to void
  gs_pkt_reset
  gs_pkt_add_g 0
  gs_pkt_add gs_a_bench
  gs_pkt_add gs_a_wrk
  gs_pkt_add_g 1
  gs_pkt_add gs_a_mdir
  gs_pkt_add_mdir gs_s_mn8
  gs_pkt_add gs_a_itr
  gs_pkt_add gs_v_8
  gs_pkt_add gs_a_trl
  gs_pkt_add gs_v_1
  gs_pkt_add gs_a_skip
  gs_pkt_add gs_a_tmem
  rc = gs_run_child false 0
  if ne rc 63
    gs_fail_exit gs_n8 rc
  end
  gs_pass_log gs_n8 rc
  put gs_res 1 add get gs_res 1 1
end

fn gs_test_n9_worker_bad_hdr to void
  for i ulong 32
    put gs_buf i 0
  end
  put gs_buf 0 77
  gs_pkt_reset
  gs_pkt_add_g 1
  rc = gs_run_child true 32
  if eq rc 0
    gs_fail_exit gs_n9 rc
  end
  gs_pass_log gs_n9 rc
  put gs_res 1 add get gs_res 1 1
end

fn main to void
  gs_init_args
  gs_puts gs_hdr
  put gs_res 0 0
  put gs_res 1 0
  gs_test_p1
  gs_test_p2
  gs_test_p3
  gs_test_p4
  gs_test_neg_probe gs_n1 0 gs_v_75000 66
  gs_test_neg_probe gs_n2 1 gs_v_86000 67
  gs_test_neg_probe gs_n3 1 gs_v_1000 67
  gs_test_n4_corrupt_ir
  gs_test_n5_bad_mask
  gs_test_n6_bad_worker
  gs_test_n7_ulp
  gs_test_n8_memo_tamper
  gs_test_n9_worker_bad_hdr
  gs_puts gs_pass
  gs_put_u get gs_res 0
  gs_puts gs_neg
  gs_put_u get gs_res 1
  gs_puts gs_nl
end

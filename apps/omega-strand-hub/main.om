end

fn r_c_prov_esc idx ulong to void
  base = mul idx F_PROV
  n = get g_c_provl idx
  for i ulong n bound 160
    r_esc_b get g_c_prov add base i
  end
end

fn r_c_prov_raw idx ulong to void
  base = mul idx F_PROV
  n = get g_c_provl idx
  for i ulong n bound 160
    r_b get g_c_prov add base i
  end
end


fn render_strand_card idx ulong to void
  r_txt t_card1
  r_c_sha idx 64
  r_txt t_card2
  r_c_name_esc idx
  r_txt t_card3
  r_c_lic_esc idx
  r_txt t_card4
  r_u64 get g_c_bl idx
  r_txt t_card5
  r_u64 get g_c_sl idx
  r_txt t_card6
  r_c_desc_esc idx
  r_txt t_card7
  r_c_auth_esc idx
  r_txt t_card8
  r_hex16 get g_c_bhash idx
  r_txt t_card9
  r_hex16 get g_c_bhash idx
  r_txt t_card10
  r_c_sha idx 16
  r_txt t_card11
  r_u64 get g_c_npar idx
  r_txt t_card12
  r_u64 get g_c_sz idx
  r_txt t_card13
  r_u64 get g_c_dl idx
  r_txt t_card14
  r_c_fn_esc idx
  r_txt t_card15
  partner = find_partner_strand idx
  if ge partner 0
    r_c_fn_esc ulong partner
  else
    r_txt t_card16
  end
  r_txt t_card17
  r_c_sha idx 64
  r_txt t_card18
  r_c_sha idx 64
  r_txt t_card19
  r_hex16 get g_c_bhash idx
  r_txt t_card20
  r_c_sha idx 64
  r_txt t_card21
end

text t_pills_open "<div class=\"hub-pills\"><span class=\"hub-lbl\">Compatible trunks:</span>"
text t_pill_a "<a class=\"hub-pill\" href=\"/strands/?trunk="
text t_pill_b "#catalog\">"
text t_pill_c "</a>"
text t_pills_close "</div>\n"
text t_cards_open "<div class=\"hub-cards\">\n"
text t_cards_close "</div></div></section>\n"
text t_empty_cat "<div class=\"hub-empty\"><h3>No matching strands yet</h3><p>Publish the first verified <code>OLLMSP01</code> specialist pack using the form below, or clear your base-trunk filter.</p></div></div></section>\n"

fn render_home_catalog to void
  r_txt t_cat_open
  for i ulong get g_q_trunkl 0 bound 64
    r_esc_b get g_q_trunk i
  end
  r_txt t_cat_f2
  nt = collect_distinct_trunks
  if gt nt 0
    r_txt t_pills_open
    for t ulong nt bound 64
      r_txt t_pill_a
      r_hex16 get g_seen_tr t
      r_txt t_pill_b
      r_hex16 get g_seen_tr t
      r_txt t_pill_c
    end
    r_txt t_pills_close
  end
  cnt = get g_scnt 0
  shown = ulong 0
  for i ulong cnt bound 512
    idx = sub sub cnt 1 i
    if strand_matches_filters idx
      if eq shown 0
        r_txt t_cards_open
      end
      render_strand_card idx
      shown = add shown 1
    end
  end
  if eq shown 0
    r_txt t_empty_cat
  else
    r_txt t_cards_close
  end
end

fn render_home_page has_post bool to void
  r_reset
  render_page_head t_ttl_home 1
  r_txt t_hero1
  r_u64 get g_scnt 0
  r_txt t_hero2
  r_u64 collect_distinct_trunks
  r_txt t_hero3
  r_u64 get g_kcnt 0
  r_txt t_hero4
  r_u64 total_downloads
  r_txt t_hero5
  render_upload_banner has_post
  r_txt t_intro1
  r_txt t_intro2
  r_txt t_intro3
  render_home_catalog
  r_txt t_up_open
  r_u64 get g_max_up 0
  r_txt t_up_open2
  for i ulong get g_q_ptl 0 bound 64
    r_esc_b get g_q_pt i
  end
  r_txt t_up_mid
  r_txt t_up_ext1
  if gt get g_q_clipl 0 0
    r_txt t_spclip_prov_pre
    for i ulong get g_q_clipl 0 bound 64
      r_esc_b get g_q_clip i
    end
  end
  r_txt t_up_ext2
  r_txt t_api_sec
  r_txt t_h_foot
end

note ---- Strand detail receipt page (/strands/strand/<sha256>) ----

text t_det1 "<section class=\"hub-sec\"><div class=\"shell\"><div class=\"hub-sec-head\"><div><span class=\"eyebrow\">Verified OLLMSP01 Specialist Receipt</span><h1>"
text t_det2 "</h1></div><div class=\"hub-card-act\"><a class=\"hub-btn hub-btn-primary\" href=\"/strands/pack/"
text t_det3 ".sp\">Download .sp</a><a class=\"hub-btn hub-btn-emerald\" href=\"/strands/clip?trunk="
text t_det4 "&amp;s1="
text t_det5 "\">Combine in Clip Editor</a><a class=\"hub-btn\" href=\"/strands/#catalog\">Back to catalog</a></div></div>\n<div class=\"hub-card\"><p>"
text t_det6 "</p><table class=\"hub-table\"><tr><th>Content SHA-256</th><td><code>"
text t_det7 "</code></td></tr><tr><th>Author</th><td>"
text t_det8 "</td></tr><tr><th>License &amp; Terms</th><td><span class=\"hub-badge lic\">"
text t_det9 "</span> &middot; "
text t_det10 "</td></tr><tr><th>Layer Delta</th><td><code>base_L = "
text t_det11 "</code> &rarr; <code>spec_L = "
text t_det12 "</code></td></tr><tr><th>Merkle Base Hash</th><td><a href=\"/strands/?trunk="
text t_det13 "#catalog\"><code>"
text t_det14 "</code></a></td></tr><tr><th>Parent Trunk SHA-256</th><td><code>"
text t_det15 "</code></td></tr><tr><th>Payload FNV-1a 64</th><td><code>"
text t_det16 "</code></td></tr><tr><th>Parameters / Size</th><td>"
text t_det17 " f64 params &middot; "
text t_det18 " bytes &middot; "
text t_det19 " downloads</td></tr><tr><th>Provenance</th><td>"
text t_det20 "</td></tr></table><h3>Runnable Omega Helix Commands</h3><pre class=\"hub-code\"># 1. Attach single strand to frozen base checkpoint:\nollm spapp BASE.ck "
text t_det21 " OUT.ck\n\n# 2. Sample directly in memory:\nollm spchainsamp BASE.ck 128 700 \"fn main to int\" 42 - 1 "
text t_det22 "\n\n# 3. Combine with compatible sibling strand via spclip (S=2, Entropy Gate):\nollm spclip BASE.ck 1 \"fn main to int\" 128 700 42 - 2 1000 1 "
text t_det23 " 1000 1 "
text t_det24 "</pre></div></div></section>\n"

fn render_strand_detail idx ulong to void
  r_reset
  render_page_head t_ttl_det 1
  r_txt t_det1
  r_c_name_esc idx
  r_txt t_det2
  r_c_sha idx 64
  r_txt t_det3
  r_hex16 get g_c_bhash idx
  r_txt t_det4
  r_c_sha idx 64
  r_txt t_det5
  r_c_desc_esc idx
  r_txt t_det6
  r_c_sha idx 64
  r_txt t_det7
  r_c_auth_esc idx
  r_txt t_det8
  r_c_lic_esc idx
  r_txt t_det9
  r_c_term_esc idx
  r_txt t_det10
  r_u64 get g_c_bl idx
  r_txt t_det11
  r_u64 get g_c_sl idx
  r_txt t_det12
  r_hex16 get g_c_bhash idx
  r_txt t_det13
  r_hex16 get g_c_bhash idx
  r_txt t_det14
  if gt get g_c_ptl idx 0
    r_c_pt_raw idx
  else
    r_txt t_dash
  end
  r_txt t_det15
  r_hex16 get g_c_phash idx
  r_txt t_det16
  r_u64 get g_c_npar idx
  r_txt t_det17
  r_u64 get g_c_sz idx
  r_txt t_det18
  r_u64 get g_c_dl idx
  r_txt t_det19
  if gt get g_c_provl idx 0
    r_c_prov_esc idx
  else
    r_txt t_dash
  end
  r_txt t_det20
  r_c_fn_esc idx
  r_txt t_det21
  r_c_fn_esc idx
  r_txt t_det22
  r_c_fn_esc idx
  r_txt t_det23
  partner = find_partner_strand idx
  if ge partner 0
    r_c_fn_esc ulong partner
  else
    r_txt t_card16
  end
  r_txt t_det24
  r_txt t_h_foot
end

note ---- Strand Clip Editor UI (/strands/clip) ----

text t_cl_hero "<section class=\"hub-hero\"><div class=\"shell\"><span class=\"eyebrow\">Strand Clip Studio &middot; OMSPCLIP01 &middot; Zero JS</span><h1>Edit &amp; Compose <em>spclip</em> Recipes</h1><p class=\"lede\">Select 2 to 4 verified strands sharing a common base trunk, tune per-strand blend weights (including negative Anti-DNA firewalls in PoE mode), fusion mode, temperature <code>tau</code>, splice layer, and fine-tune parameters. Every recipe produces a deterministic SHA-256-verified <code>.spclip</code> manifest and runnable CLI command.</p><div class=\"hub-cta\"><a class=\"hub-btn\" href=\"/strands/#catalog\">Back to Strand Catalog</a><a class=\"hub-btn\" href=\"/strands/clips/index.json\">clips/index.json</a><a class=\"hub-btn\" href=\"/strands/clips/index.tsv\">clips/index.tsv</a></div></div></section>\n"

text t_cl_ok1 "<div class=\"shell\"><div class=\"hub-banner ok\"><h3>Verified .spclip Recipe Created (OMSPCLIP01)</h3><p>Clip SHA-256: <code>"
text t_cl_ok2 "</code> &middot; Body SHA-256: <code>"
text t_cl_ok3 "</code> &middot; Shared Trunk: <code>"
text t_cl_ok4 "</code></p><div class=\"hub-card-act\"><a class=\"hub-btn hub-btn-primary hub-btn-sm\" href=\"/strands/clip/"
text t_cl_ok5 ".spclip\">Download .spclip manifest</a><a class=\"hub-btn hub-btn-emerald hub-btn-sm\" href=\"/strands/?parent_trunk="
text t_cl_ok6 "&amp;clip="
text t_cl_ok7 "#upload\">Publish fine-tuned child strand linked to this clip</a></div><h3>Runnable ollm spclip Command</h3><pre class=\"hub-code\">ollm spclip BASE.ck "
text t_cl_ok8 "</pre><details class=\"hub-details\"><summary>Optional: Fine-tune &amp; extract a child OLLMSP01 strand from this clip</summary><div class=\"hub-details-body\"><pre class=\"hub-code\"># 1. Materialize starting child layers from your clip weights:\nollm spmerge BASE.ck 0 clip_init.sp "
text t_cl_ok9 "\nollm spapp BASE.ck clip_init.sp child.ck\n# 2. Frozen-core fine-tune above splice layer "
text t_cl_ok10 ":\nollm trainf child.ck DATA.tok "
text t_cl_ok11 " 50 "
text t_cl_ok12 "\n# 3. Extract verified child OLLMSP01 pack &amp; upload linked to parent hashes:\nollm spext BASE.ck child.ck child_tuned.sp</pre></div></details><details class=\"hub-details\"><summary>Deterministic .spclip Manifest Preview (OMSPCLIP01)</summary><div class=\"hub-details-body\"><pre class=\"hub-code\">"
text t_cl_ok13 "</pre></div></details></div></div>\n"

text t_cl_err1 "<div class=\"shell\"><div class=\"hub-banner err\"><h3>Clip Validation Refused (Code "
text t_cl_err2 ")</h3><p>"
text t_cl_err3 "</p></div></div>\n"

fn r_e_sha_all to void
  for i ulong 64
    r_b get g_e_sha i
  end
end

fn r_e_bsha_all to void
  for i ulong 64
    r_b get g_e_bsha i
  end
end

fn render_clip_banner to void
  if eq get g_e_st ES_HAS_POST 0
    ret
  end
  ec = get g_e_st ES_ERR
  if ne ec CE_OK
    r_txt t_cl_err1
    r_u64 ec
    r_txt t_cl_err2
    r_clip_err_msg ec
    r_txt t_cl_err3
    ret
  end
  r_txt t_cl_ok1
  r_e_sha_all
  r_txt t_cl_ok2
  r_e_bsha_all
  r_txt t_cl_ok3
  r_hex16 get g_e_st ES_BHASH
  r_txt t_cl_ok4
  r_e_sha_all
  r_txt t_cl_ok5
  r_hex16 get g_e_st ES_BHASH
  r_txt t_cl_ok6
  r_e_sha_all
  r_txt t_cl_ok7
  r_u64 get g_e_st ES_MODE
  r_b 32
  r_b 34
  for pi ulong get g_e_promptl 0 bound 256
    r_esc_b get g_e_prompt pi
  end
  r_b 34
  r_b 32
  r_u64 get g_e_st ES_TOK
  r_b 32
  r_u64 get g_e_st ES_TAU
  r_b 32
  r_u64 get g_e_st ES_SEED
  r_b 32
  for mi ulong get g_e_mergesl 0 bound 128
    r_esc_b get g_e_merges mi
  end
  r_b 32
  sc = get g_e_st ES_SC
  r_u64 sc
  for k ulong sc bound 4
    r_b 32
    r_i64 get g_e_sw k
    r_b 32
    r_b 49
    r_b 32
    r_c_fn_esc get g_e_sidx k
  end
  r_txt t_cl_ok8
  for k ulong sc bound 4
    if gt k 0
      r_b 32
    end
    r_i64 get g_e_sw k
    r_b 32
    r_c_fn_esc get g_e_sidx k
  end
  r_txt t_cl_ok9
  r_u64 get g_e_st ES_SPLICE
  r_txt t_cl_ok10
  st = get g_e_st ES_STEPS
  if eq st 0
    r_u64 100
  else
    r_u64 st
  end
  r_txt t_cl_ok11
  r_u64 get g_e_st ES_SPLICE
  r_txt t_cl_ok12
  for j ulong get g_e_manl 0 bound 16384
    r_esc_b get g_e_man j
  end
  r_txt t_cl_ok13
end

text t_opt_none "<option value=\"\">-- Optional / None --</option>\n"
text t_opt_pick "<option value=\"\">-- Select a verified strand --</option>\n"
text t_opt_a "<option value=\""
text t_opt_sel "\" selected>"
text t_opt_b "\">"
text t_opt_c " [trunk "
text t_opt_d " | L"
text t_opt_e "&rarr;L"
text t_opt_f "]</option>\n"

fn strand_preselected slot ulong idx ulong to bool
  if ne get g_e_st ES_HAS_POST 0
    if eq get g_e_sset slot 1
      ret eq get g_e_sidx slot idx
    end
    ret false
  end
  if and eq slot 0 eq get g_q_s1l 0 64
    bs = mul idx F_SHA
    for i ulong 64
      if ne get g_c_sha add bs i get g_q_s1 i
        ret false
      end
    end
    ret true
  end
  if and eq slot 1 eq get g_q_s2l 0 64
    bs = mul idx F_SHA
    for i ulong 64
      if ne get g_c_sha add bs i get g_q_s2 i
        ret false
      end
    end
    ret true
  end
  ret false
end

fn render_strand_options slot ulong req bool to void
  if req
    r_txt t_opt_pick
  else
    r_txt t_opt_none
  end
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if strand_matches_trunk i
      r_txt t_opt_a
      r_c_sha i 64
      if strand_preselected slot i
        r_txt t_opt_sel
      else
        r_txt t_opt_b
      end
      r_c_name_esc i
      r_txt t_opt_c
      r_hex16 get g_c_bhash i
      r_txt t_opt_d
      r_u64 get g_c_bl i
      r_txt t_opt_e
      r_u64 get g_c_sl i
      r_txt t_opt_f
    end
  end
end


note ---- CSS stylesheet (/strands/hub.css) - CSP safe, zero JS, Interplane 4-strand theme ----
text t_css1 ":root{--hub-a:var(--strand-a,#22d3ee);--hub-b:var(--strand-b,#fbbf24);--hub-c:var(--strand-c,#3b82f6);--hub-d:var(--strand-d,#34d399);--hub-bg:var(--paper,#060a12);--hub-card:var(--white,#0c1320);--hub-panel:var(--panel,#090f1a);--hub-ink:var(--ink,#f3f6fb);--hub-muted:var(--muted,#a3b1c6);--hub-line:var(--line,#1a2536);--hub-strong:var(--line-strong,#2d3d58)}html,body{overflow-x:clip}.hub-hero{position:relative;padding:44px 0 36px;border-bottom:1px solid var(--hub-line);background:radial-gradient(900px 360px at 12% 0%,#22d3ee14,transparent 65%),radial-gradient(760px 340px at 88% 10%,#34d39914,transparent 65%),var(--hub-bg)}.hub-hero h1{margin:10px 0 14px;font-size:clamp(30px,4.4vw,50px)}.hub-hero .lede{max-width:740px;font-size:17px;line-height:1.65;color:var(--hub-muted)}.hub-cta{display:flex;flex-wrap:wrap;gap:12px;margin:22px 0 26px}.hub-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;border:1px solid var(--hub-strong);cursor:pointer;background:var(--hub-card);color:var(--hub-ink);transition:border-color .15s,background .15s}.hub-btn:hover{border-color:var(--hub-a);color:var(--hub-ink)}.hub-btn-primary{background:#2563eb;border-color:#3b82f6;color:#fff}.hub-btn-primary:hover{background:#1d4ed8;border-color:#60a5fa;color:#fff}.hub-btn-emerald{background:#065f46;border-color:#10b981;color:#ecfdf5}.hub-btn-emerald:hover{background:#047857;border-color:#34d399;color:#fff}.hub-btn-sm{padding:7px 12px;font-size:13px}.hub-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:8px}@media(max-width:860px){.hub-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.hub-kpis{grid-template-columns:1fr}}.hub-kpi{background:var(--hub-card);border:1px solid var(--hub-line);border-radius:10px;padding:14px 16px}.hub-kpi-k{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--hub-muted)}.hub-kpi-v{display:block;margin-top:4px;font-size:20px;font-weight:700;color:var(--hub-ink)}"

text t_css2 ".hub-sec{padding:36px 0;border-bottom:1px solid var(--hub-line)}.hub-sec-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:14px;margin-bottom:20px}.hub-sec-head h2{margin-top:6px}.hub-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}@media(max-width:860px){.hub-grid3{grid-template-columns:1fr}}.hub-story{background:var(--hub-card);border:1px solid var(--hub-line);border-top:3px solid var(--hub-a);border-radius:12px;padding:18px 20px}.hub-story.st-b{border-top-color:var(--hub-b)}.hub-story.st-d{border-top-color:var(--hub-d)}.hub-story h3{margin-bottom:8px;font-size:17px}.hub-story p{font-size:14px;line-height:1.6}.hub-flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:18px}@media(max-width:860px){.hub-flow{grid-template-columns:1fr}}.hub-step{position:relative;background:var(--hub-panel);border:1px solid var(--hub-line);border-radius:12px;padding:18px 20px}.hub-step-num{display:inline-block;padding:2px 9px;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:#111c30;color:var(--hub-a);border:1px solid var(--hub-strong);margin-bottom:8px}.hub-step h3{font-size:16px;margin-bottom:6px}.hub-step p{font-size:14px;line-height:1.55}.hub-details{margin-top:18px;background:var(--hub-panel);border:1px solid var(--hub-line);border-radius:10px;padding:14px 18px}.hub-details summary{cursor:pointer;font-weight:600;color:var(--hub-ink);font-size:14px}.hub-details-body{margin-top:12px;font-size:13px;color:var(--hub-muted);line-height:1.6}"

text t_css3 ".hub-banner{border-radius:12px;padding:18px 20px;margin:20px 0;border:1px solid var(--hub-strong);background:var(--hub-card)}.hub-banner.ok{border-color:#10b981;background:#052e22}.hub-banner.err{border-color:#ef4444;background:#2a0f14}.hub-banner h3{margin-bottom:6px;font-size:17px}.hub-filter{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:16px;background:var(--hub-panel);border:1px solid var(--hub-line);border-radius:10px;padding:12px 14px}.hub-in,.hub-sel,.hub-ta{width:100%;padding:10px 12px;border-radius:8px;border:1px solid var(--hub-strong);background:#070c16;color:var(--hub-ink);font-size:14px;font-family:inherit}.hub-in-grow{flex:1 1 260px;min-width:0}.hub-pills{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 18px}.hub-pill{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;text-decoration:none;border:1px solid var(--hub-strong);background:var(--hub-card);color:var(--hub-ink)}.hub-pill:hover,.hub-pill.active{border-color:var(--hub-a);background:#0e2238}.hub-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}@media(max-width:860px){.hub-cards{grid-template-columns:1fr}}.hub-card{background:var(--hub-card);border:1px solid var(--hub-line);border-radius:12px;padding:18px 20px;display:flex;flex-direction:column;gap:12px}.hub-card-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:8px}.hub-card-title{font-size:18px;font-weight:700;color:var(--hub-ink);text-decoration:none}.hub-card-title:hover{color:var(--hub-a)}.hub-badges{display:flex;flex-wrap:wrap;gap:6px}.hub-badge{display:inline-block;padding:2px 9px;border-radius:999px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;font-weight:600;border:1px solid var(--hub-strong);background:#0f192b;color:var(--hub-ink)}.hub-badge.lic{border-color:#10b981;color:#6ee7b7;background:#06291e}.hub-badge.lay{border-color:#22d3ee;color:#67e8f9;background:#082733}.hub-badge.ok{border-color:#34d399;color:#a7f3d0;background:#06291e}.hub-badge.warn{border-color:#f59e0b;color:#fde68a;background:#2b1e07}.hub-meta{display:flex;flex-wrap:wrap;gap:8px 14px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:var(--hub-muted)}.hub-code{margin:0;padding:12px 14px;border-radius:8px;background:#04070e;border:1px solid var(--hub-line);color:#dbeafe;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.5;overflow-x:auto;white-space:pre-wrap;word-break:break-word}.hub-card-act{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.hub-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}@media(max-width:760px){.hub-form-grid{grid-template-columns:1fr}}.hub-fg{display:flex;flex-direction:column;gap:6px}.hub-fg.full{grid-column:1 / -1}.hub-lbl{font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--hub-muted);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.hub-help{font-size:12px;color:var(--hub-muted)}.hub-slot{background:var(--hub-panel);border:1px solid var(--hub-line);border-radius:10px;padding:14px;display:grid;grid-template-columns:1fr 140px;gap:10px;align-items:end}@media(max-width:600px){.hub-slot{grid-template-columns:1fr}}.hub-empty{background:var(--hub-panel);border:1px dashed var(--hub-strong);border-radius:12px;padding:24px;text-align:center}.hub-table{width:100%;border-collapse:collapse;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px}.hub-table th,.hub-table td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--hub-line);word-break:break-word}.hub-table th{color:var(--hub-muted);width:190px}\n"

note ---- Core byte/hex/integer helpers ----

fn to_low c uchar to uchar
  if ge c 65
    if le c 90
      ret add c 32
    end
  end
  ret c
end

fn hex_val c uchar to int
  if ge c 48
    if le c 57
      ret int sub c 48
    end
  end
  if ge c 97
    if le c 102
      ret int add sub c 97 10
    end
  end
  if ge c 65
    if le c 70
      ret int add sub c 65 10
    end
  end
  ret -1
end

fn is_hex_low c uchar to bool
  if ge c 48
    if le c 57
      ret true
    end
  end
  if ge c 97
    if le c 102
      ret true
    end
  end
  ret false
end

fn hex_ch v ulong to uchar
  d = and v 15
  if lt d 10
    ret uchar add 48 d
  end
  ret uchar add 87 d
end

fn fmt_hex16 v ulong to void
  for i ulong 16
    sh = mul sub 15 i 4
    put g_hex16 i hex_ch shr v sh
  end
end

fn read_u64_le_io off ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get g_io add off i
    v = or v shl b mul i 8
  end
  ret v
end

fn is_safe_fn_char c uchar to bool
  if ge c 48
    if le c 57
      ret true
    end
  end
  if ge c 65
    if le c 90
      ret true
    end
  end
  if ge c 97
    if le c 122
      ret true
    end
  end
  if or eq c 45 or eq c 46 eq c 95
    ret true
  end
  ret false
end

note ---- Streaming FIPS 180-4 SHA-256 ----

fn sha_init_k to void
  if ne get g_sh_init 0 0
    ret
  end
  put g_sh_init 0 1
  p = ulong 0
  for i ulong 64
    v = ulong 0
    while lt p len t_sha_k_str bound 8
      if ge get t_sha_k_str p 48
        break
      end
      p = add p 1
    end
    while lt p len t_sha_k_str bound 16
      c = get t_sha_k_str p
      if lt c 48
        break
      end
      v = add mul v 10 ulong sub c 48
      p = add p 1
    end
    put g_sh_k i uint v
  end
end

fn sha_start to void
  sha_init_k
  put g_sh_h 0 0x6a09e667
  put g_sh_h 1 0xbb67ae85
  put g_sh_h 2 0x3c6ef372
  put g_sh_h 3 0xa54ff53a
  put g_sh_h 4 0x510e527f
  put g_sh_h 5 0x9b05688c
  put g_sh_h 6 0x1f83d9ab
  put g_sh_h 7 0x5be0cd19
  put g_sh_len 0 0
end

fn sha_s0 a uint to uint
  ret xor xor rotr a 2 rotr a 13 rotr a 22
end

fn sha_s1 e uint to uint
  ret xor xor rotr e 6 rotr e 11 rotr e 25
end

fn sha_g0 x uint to uint
  ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn sha_g1 x uint to uint
  ret xor xor rotr x 17 rotr x 19 shr x 10
end

fn sha_rnd i ulong to void
  e = get g_sh_v 4
  t1 = add get g_sh_v 7 sha_s1 e
  t1 = add t1 xor and e get g_sh_v 5 and not e get g_sh_v 6
  t1 = add t1 add get g_sh_k i get g_sh_w i
  a = get g_sh_v 0
  b = get g_sh_v 1
  c = get g_sh_v 2
  t2 = add sha_s0 a xor xor and a b and a c and b c
  put g_sh_v 7 get g_sh_v 6
  put g_sh_v 6 get g_sh_v 5
  put g_sh_v 5 e
  put g_sh_v 4 add get g_sh_v 3 t1
  put g_sh_v 3 c
  put g_sh_v 2 b
  put g_sh_v 1 a
  put g_sh_v 0 add t1 t2
end

fn sha_compress_buf to void
  for t ulong 16
    q = mul t 4
    w = shl uint get g_sh_buf q 24
    w = or w shl uint get g_sh_buf add q 1 16
    w = or w shl uint get g_sh_buf add q 2 8
    w = or w uint get g_sh_buf add q 3
    put g_sh_w t w
  end
  for t ulong 48
    u = add t 16
    x = add sha_g1 get g_sh_w sub u 2 get g_sh_w sub u 7
    put g_sh_w u add x add sha_g0 get g_sh_w sub u 15 get g_sh_w sub u 16
  end
  for j ulong 8
    put g_sh_v j get g_sh_h j
  end
  for i ulong 64
    sha_rnd i
  end
  for j ulong 8
    put g_sh_h j add get g_sh_h j get g_sh_v j
  end
end

fn sha_feed_byte c uchar to void
  n = get g_sh_len 0
  bi = and n 63
  put g_sh_buf bi c
  put g_sh_len 0 add n 1
  if eq bi 63
    sha_compress_buf
  end
end

fn sha_feed_io off ulong cnt ulong to void
  for i ulong cnt bound 65536
    sha_feed_byte get g_io add off i
  end
end

fn sha_feed_man off ulong cnt ulong to void
  for i ulong cnt bound 16384
    sha_feed_byte get g_e_man add off i
  end
end

fn sha_feed_vbuf off ulong cnt ulong to void
  for i ulong cnt bound 16384
    sha_feed_byte get g_e_vbuf add off i
  end
end

fn sha_finish to void
  tot = get g_sh_len 0
  bits = shl tot 3
  sha_feed_byte 128
  while ne and get g_sh_len 0 63 56 bound 64
    sha_feed_byte 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sha_feed_byte uchar and shr bits sh 255
  end
  for j ulong 8
    v = ulong get g_sh_h j
    for q ulong 4
      sh = mul sub 3 q 8
      b = uchar and shr v sh 255
      put g_sh_dig add mul j 4 q b
      hi = mul add mul j 4 q 2
      put g_sh_hex hi hex_ch shr ulong b 4
      put g_sh_hex add hi 1 hex_ch ulong b
    end
  end
end

note ---- Response and HTTP header builders ----

fn r_reset to void
  put g_respl 0 0
end

fn r_b c uchar to void
  n = get g_respl 0
  if lt n HUB_MAX_RESP
    put g_resp n c
    put g_respl 0 add n 1
  end
end

fn r_txt t view uchar * to void
  for i ulong len t bound 16384
    r_b get t i
  end
end

fn r_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    r_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    r_b get buf p
    p = add p 1
  end
end

fn r_i64 v long to void
  if lt v 0
    r_b 45
    r_u64 ulong neg v
    ret
  end
  r_u64 ulong v
end

fn r_hex16 v ulong to void
  fmt_hex16 v
  for i ulong 16
    r_b get g_hex16 i
  end
end

fn r_esc_b c uchar to void
  if eq c 38
    r_txt t_esc_amp
    ret
  end
  if eq c 60
    r_txt t_esc_lt
    ret
  end
  if eq c 62
    r_txt t_esc_gt
    ret
  end
  if eq c 34
    r_txt t_esc_quot
    ret
  end
  if eq c 39
    r_txt t_esc_apos
    ret
  end
  r_b c
end

fn r_jesc_b c uchar to void
  if eq c 34
    r_b 92
    r_b 34
    ret
  end
  if eq c 92
    r_b 92
    r_b 92
    ret
  end
  if eq c 10
    r_b 92
    r_b 110
    ret
  end
  if eq c 13
    r_b 92
    r_b 114
    ret
  end
  if eq c 9
    r_b 92
    r_b 116
    ret
  end
  if lt c 32
    r_b 32
    ret
  end
  r_b c
end

fn r_u_sha_all to void
  for i ulong 64
    r_b get g_u_sha i
  end
end

fn r_c_sha idx ulong n ulong to void
  base = mul idx F_SHA
  for i ulong n bound 64
    r_b get g_c_sha add base i
  end
end

fn r_c_name_esc idx ulong to void
  base = mul idx F_NAME
  n = get g_c_namel idx
  for i ulong n bound 80
    r_esc_b get g_c_name add base i
  end
end

fn r_c_name_raw idx ulong to void
  base = mul idx F_NAME
  n = get g_c_namel idx
  for i ulong n bound 80
    r_b get g_c_name add base i
  end
end

fn r_c_name_json idx ulong to void
  base = mul idx F_NAME
  n = get g_c_namel idx
  for i ulong n bound 80
    r_jesc_b get g_c_name add base i
  end
end

fn r_c_auth_esc idx ulong to void
  base = mul idx F_AUTH
  n = get g_c_authl idx
  for i ulong n bound 64
    r_esc_b get g_c_auth add base i
  end
end

fn r_c_auth_raw idx ulong to void
  base = mul idx F_AUTH
  n = get g_c_authl idx
  for i ulong n bound 64
    r_b get g_c_auth add base i
  end
end

fn r_c_auth_json idx ulong to void
  base = mul idx F_AUTH
  n = get g_c_authl idx
  for i ulong n bound 64
    r_jesc_b get g_c_auth add base i
  end
end

fn r_c_lic_esc idx ulong to void
  base = mul idx F_LIC
  n = get g_c_licl idx
  for i ulong n bound 32
    r_esc_b get g_c_lic add base i
  end
end

fn r_c_lic_raw idx ulong to void
  base = mul idx F_LIC
  n = get g_c_licl idx
  for i ulong n bound 32
    r_b get g_c_lic add base i

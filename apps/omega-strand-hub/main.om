end

fn r_c_lic_json idx ulong to void
  base = mul idx F_LIC
  n = get g_c_licl idx
  for i ulong n bound 32
    r_jesc_b get g_c_lic add base i
  end
end

fn r_c_term_esc idx ulong to void
  base = mul idx F_TERM
  n = get g_c_terml idx
  for i ulong n bound 128
    r_esc_b get g_c_term add base i
  end
end

fn r_c_term_raw idx ulong to void
  base = mul idx F_TERM
  n = get g_c_terml idx
  for i ulong n bound 128
    r_b get g_c_term add base i
  end
end


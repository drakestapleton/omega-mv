fn h_reset to void
  put g_hdrl 0 0
end

fn h_b c uchar to void
  n = get g_hdrl 0
  if lt n 2048
    put g_hdr n c
    put g_hdrl 0 add n 1
  end
end

fn h_txt t view uchar * to void
  for i ulong len t bound 256
    h_b get t i
  end
end

fn h_crlf to void
  h_b 13
  h_b 10
end

fn h_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    h_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    h_b get buf p
    p = add p 1
  end
end

fn h_hex16 v ulong to void
  fmt_hex16 v
  for i ulong 16
    h_b get g_hex16 i
  end
end

note ---- Path builders and atomic rename ----

fn p1_reset to void
  put g_p1l 0 0
end

fn p1_b c uchar to void
  n = get g_p1l 0
  if lt n 1020
    put g_p1 n c
    put g_p1l 0 add n 1
  end
end

fn p1_txt t view uchar * to void
  for i ulong len t bound 256
    p1_b get t i
  end
end

fn p1_dir to void
  n = get g_dirl 0
  for i ulong n bound 512
    p1_b get g_dir i
  end
end

fn p1_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    p1_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    p1_b get buf p
    p = add p 1
  end
end

fn p2_reset to void
  put g_p2l 0 0
end

fn p2_b c uchar to void
  n = get g_p2l 0
  if lt n 1020
    put g_p2 n c
    put g_p2l 0 add n 1
  end
end

fn p2_txt t view uchar * to void
  for i ulong len t bound 256
    p2_b get t i
  end
end

fn p2_dir to void
  n = get g_dirl 0
  for i ulong n bound 512
    p2_b get g_dir i
  end
end

fn atomic_rename_p1_p2 to bool
  l1 = get g_p1l 0
  l2 = get g_p2l 0
  if or eq l1 0 or eq l2 0 gt add l1 l2 2040
    ret false
  end
  put g_pk 0 2
  put g_pk 1 0
  put g_pk 2 uchar and l1 255
  put g_pk 3 uchar shr l1 8
  for i ulong l1 bound 1024
    put g_pk add 4 i get g_p1 i
  end
  q = add 4 l1
  put g_pk q uchar and l2 255
  put g_pk add q 1 uchar shr l2 8
  for j ulong l2 bound 1024
    put g_pk add add q 2 j get g_p2 j
  end
  tot = add add q 2 l2
  r = renames g_pk 0 tot 0
  ret eq r 0
end

fn build_tmp_p1 pre view uchar * ext view uchar * to void
  p1_reset
  p1_dir
  p1_txt pre
  p1_u64 ulong getpid
  p1_b 45
  s = add get g_seq 0 1
  put g_seq 0 s
  p1_u64 s
  p1_txt ext
end

fn ensure_dirs to void
  p1_reset
  p1_dir
  x = makedir g_p1 0 get g_p1l 0 493
  p1_reset
  p1_dir
  p1_txt t_sub_blobs
  x = makedir g_p1 0 get g_p1l 0 493
  p1_reset
  p1_dir
  p1_txt t_sub_clips
  x = makedir g_p1 0 get g_p1l 0 493
  p1_reset
  p1_dir
  p1_txt t_sub_tmp
  x = makedir g_p1 0 get g_p1l 0 493
end

fn write_all_resp fd int to bool
  n = get g_respl 0
  off = ulong 0
  while lt off n bound 1048576
    w = write fd g_resp off sub n off
    if le w 0
      if eq w -4
        continue
      end
      ret false
    end
    off = add off ulong w
  end
  ret true
end

note ---- Catalog and Clip persistence (TSV atomic save/load) ----

fn split_line_tabs to void
  n = get g_linel 0
  cnt = ulong 0
  start = ulong 0
  for i ulong n bound 4096
    if eq get g_line i 9
      if lt cnt 32
        put g_fld_off cnt start
        put g_fld_len cnt sub i start
        cnt = add cnt 1
      end
      start = add i 1
    end
  end
  if lt cnt 32
    put g_fld_off cnt start
    put g_fld_len cnt sub n start
    cnt = add cnt 1
  end
  put g_fld_cnt 0 cnt
end

fn parse_line_u64 fi ulong to ulong
  off = get g_fld_off fi
  fl = get g_fld_len fi
  v = ulong 0
  for i ulong fl bound 24
    c = get g_line add off i
    if and ge c 48 le c 57
      v = add mul v 10 ulong sub c 48
    else
      break
    end
  end
  ret v
end

fn parse_line_i64 fi ulong to long
  off = get g_fld_off fi
  fl = get g_fld_len fi
  if eq fl 0
    ret 0
  end
  is_neg = false
  st = ulong 0
  if eq get g_line off 45
    is_neg = true
    st = 1
  end
  v = ulong 0
  i = st
  while lt i fl bound 24
    c = get g_line add off i
    if and ge c 48 le c 57
      if lt v 1000000000
        v = add mul v 10 ulong sub c 48
      end
      i = add i 1
    else
      break
    end
  end
  if is_neg
    ret neg long v
  end
  ret long v
end

fn parse_line_hex64 fi ulong to ulong
  off = get g_fld_off fi
  fl = get g_fld_len fi
  v = ulong 0
  for i ulong fl bound 16
    hv = hex_val get g_line add off i
    if lt hv 0
      break
    end
    v = or shl v 4 ulong hv
  end
  ret v
end

fn load_cat_copy_sha idx ulong fi ulong to bool
  if ne get g_fld_len fi 64
    ret false
  end
  off = get g_fld_off fi
  base = mul idx F_SHA
  for i ulong 64
    c = get g_line add off i
    if not is_hex_low c
      ret false
    end
    put g_c_sha add base i c
  end
  ret true
end

fn load_cat_fields_a idx ulong to void
  off = get g_fld_off 1
  fl = get g_fld_len 1
  if gt fl F_NAME
    fl = F_NAME
  end
  for i ulong fl bound 80
    put g_c_name add mul idx F_NAME i get g_line add off i
  end
  put g_c_namel idx fl

  off = get g_fld_off 2
  fl = get g_fld_len 2
  if gt fl F_AUTH
    fl = F_AUTH
  end
  for i ulong fl bound 64
    put g_c_auth add mul idx F_AUTH i get g_line add off i
  end
  put g_c_authl idx fl

  off = get g_fld_off 3
  fl = get g_fld_len 3
  if gt fl F_LIC
    fl = F_LIC
  end
  for i ulong fl bound 32
    put g_c_lic add mul idx F_LIC i get g_line add off i
  end
  put g_c_licl idx fl
end

fn load_cat_fields_b idx ulong to void
  off = get g_fld_off 4
  fl = get g_fld_len 4
  if gt fl F_TERM
    fl = F_TERM
  end
  for i ulong fl bound 128
    put g_c_term add mul idx F_TERM i get g_line add off i
  end
  put g_c_terml idx fl

  off = get g_fld_off 5
  fl = get g_fld_len 5
  if gt fl F_PROV
    fl = F_PROV
  end
  for i ulong fl bound 160
    put g_c_prov add mul idx F_PROV i get g_line add off i
  end
  put g_c_provl idx fl

  off = get g_fld_off 6
  fl = get g_fld_len 6
  if gt fl F_PT
    fl = F_PT
  end
  for i ulong fl bound 64
    put g_c_pt add mul idx F_PT i get g_line add off i
  end
  put g_c_ptl idx fl
end

fn load_cat_fields_c idx ulong to void
  off = get g_fld_off 15
  fl = get g_fld_len 15
  if gt fl F_FN
    fl = F_FN
  end
  for i ulong fl bound 128
    put g_c_fn add mul idx F_FN i get g_line add off i
  end
  put g_c_fnl idx fl

  off = get g_fld_off 16
  fl = get g_fld_len 16
  if gt fl F_DESC
    fl = F_DESC
  end
  for i ulong fl bound 256
    put g_c_desc add mul idx F_DESC i get g_line add off i
  end
  put g_c_descl idx fl
end

fn parse_cat_line to void
  n = get g_linel 0
  if eq n 0
    ret
  end
  if eq get g_line 0 35
    ret
  end
  if ge get g_scnt 0 HUB_MAX_STRANDS
    ret
  end
  split_line_tabs
  if lt get g_fld_cnt 0 17
    ret
  end
  idx = get g_scnt 0
  if not load_cat_copy_sha idx 0
    ret
  end
  load_cat_fields_a idx
  load_cat_fields_b idx
  load_cat_fields_c idx
  put g_c_bhash idx parse_line_hex64 7
  put g_c_bl idx parse_line_u64 8
  put g_c_sl idx parse_line_u64 9
  put g_c_npar idx parse_line_u64 10
  put g_c_phash idx parse_line_hex64 11
  put g_c_sz idx parse_line_u64 12
  put g_c_dl idx parse_line_u64 13
  put g_c_ts idx parse_line_u64 14
  put g_scnt 0 add idx 1
end

fn load_catalog to void
  put g_scnt 0 0
  p1_reset
  p1_dir
  p1_txt t_sub_cat
  fd = fopen g_p1 0 get g_p1l 0 0 0
  if lt fd 0
    ret
  end
  put g_linel 0 0
  for it ulong 10000 bound 10000
    r = read int fd g_io 0 HUB_IO_SZ
    if le r 0
      break
    end
    for i ulong ulong r bound 65536
      c = get g_io i
      if eq c 10
        parse_cat_line
        put g_linel 0 0
      else
        if ne c 13
          ln = get g_linel 0
          if lt ln 4095
            put g_line ln c
            put g_linel 0 add ln 1
          end
        end
      end
    end
  end
  if gt get g_linel 0 0
    parse_cat_line
  end
  x = fclose int fd
end

fn emit_cat_row_resp idx ulong to void
  r_c_sha idx 64
  r_b 9
  r_c_name_raw idx
  r_b 9
  r_c_auth_raw idx
  r_b 9
  r_c_lic_raw idx
  r_b 9
  r_c_term_raw idx
  r_b 9
  r_c_prov_raw idx
  r_b 9
  r_c_pt_raw idx
  r_b 9
  r_hex16 get g_c_bhash idx
  r_b 9
  r_u64 get g_c_bl idx
  r_b 9
  r_u64 get g_c_sl idx
  r_b 9
  r_u64 get g_c_npar idx
  r_b 9
  r_hex16 get g_c_phash idx
  r_b 9
  r_u64 get g_c_sz idx
  r_b 9
  r_u64 get g_c_dl idx
  r_b 9
  r_u64 get g_c_ts idx
  r_b 9
  r_c_fn_raw idx
  r_b 9
  r_c_desc_raw idx
  r_b 10
end

fn save_catalog to bool
  r_reset
  r_txt t_cat_hdr1
  r_txt t_cat_hdr2
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    emit_cat_row_resp i
  end
  build_tmp_p1 t_tmp_cat_pre t_ext_tsv
  fd = fopen g_p1 0 get g_p1l 0 577 420
  if lt fd 0
    ret false
  end
  ok = write_all_resp int fd
  if ok
    if ne fsync int fd 0
      ok = false
    end
  end
  x = fclose int fd
  if not ok
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  p2_reset
  p2_dir
  p2_txt t_sub_cat
  if not atomic_rename_p1_p2
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  ret true
end

note ---- Clips catalog persistence (clips.tsv) ----

fn load_kcat_str idx ulong to void
  off = get g_fld_off 1
  fl = get g_fld_len 1
  if gt fl F_NAME
    fl = F_NAME
  end
  for i ulong fl bound 80
    put g_k_name add mul idx F_NAME i get g_line add off i
  end
  put g_k_namel idx fl

  off = get g_fld_off 2
  fl = get g_fld_len 2
  if gt fl F_AUTH
    fl = F_AUTH
  end
  for i ulong fl bound 64
    put g_k_auth add mul idx F_AUTH i get g_line add off i
  end
  put g_k_authl idx fl

  off = get g_fld_off 3
  fl = get g_fld_len 3
  if gt fl F_LIC
    fl = F_LIC
  end
  for i ulong fl bound 32
    put g_k_lic add mul idx F_LIC i get g_line add off i
  end
  put g_k_licl idx fl
end

fn load_kcat_slot idx ulong slot ulong fi_sha ulong fi_w ulong to void
  fl = get g_fld_len fi_sha
  off = get g_fld_off fi_sha
  base = mul add mul idx 4 slot 64
  if eq fl 64
    for i ulong 64
      put g_k_ssha add base i get g_line add off i
    end
  else
    for i ulong 64
      put g_k_ssha add base i 48
    end
  end
  put g_k_sw add mul idx 4 slot parse_line_i64 fi_w
end

fn parse_kcat_line to void
  n = get g_linel 0
  if eq n 0
    ret
  end
  if eq get g_line 0 35
    ret
  end
  if ge get g_kcnt 0 HUB_MAX_CLIPS
    ret
  end
  split_line_tabs
  if lt get g_fld_cnt 0 23
    ret
  end
  if ne get g_fld_len 0 64
    ret
  end
  idx = get g_kcnt 0
  off0 = get g_fld_off 0
  base0 = mul idx 64
  for i ulong 64
    c = get g_line add off0 i
    if not is_hex_low c
      ret
    end
    put g_k_sha add base0 i c
  end
  load_kcat_str idx
  put g_k_bhash idx parse_line_hex64 4
  put g_k_mode idx parse_line_u64 5
  put g_k_tau idx parse_line_u64 6
  put g_k_splice idx parse_line_u64 7
  put g_k_sc idx parse_line_u64 8
  put g_k_dl idx parse_line_u64 9
  put g_k_ts idx parse_line_u64 10
  put g_k_tok idx parse_line_u64 11
  put g_k_seed idx parse_line_u64 12
  put g_k_steps idx parse_line_u64 13
  put g_k_lr idx parse_line_u64 14
  load_kcat_slot idx 0 15 16
  load_kcat_slot idx 1 17 18
  load_kcat_slot idx 2 19 20
  load_kcat_slot idx 3 21 22
  put g_kcnt 0 add idx 1
end

fn load_clips_catalog to void
  put g_kcnt 0 0
  p1_reset
  p1_dir
  p1_txt t_sub_kcat
  fd = fopen g_p1 0 get g_p1l 0 0 0
  if lt fd 0
    ret
  end
  put g_linel 0 0
  for it ulong 10000 bound 10000
    r = read int fd g_io 0 HUB_IO_SZ
    if le r 0
      break
    end
    for i ulong ulong r bound 65536
      c = get g_io i
      if eq c 10
        parse_kcat_line
        put g_linel 0 0
      else
        if ne c 13
          ln = get g_linel 0
          if lt ln 4095
            put g_line ln c
            put g_linel 0 add ln 1
          end
        end
      end
    end
  end
  if gt get g_linel 0 0
    parse_kcat_line
  end
  x = fclose int fd
end

fn r_k_sha idx ulong n ulong to void
  base = mul idx 64
  for i ulong n bound 64
    r_b get g_k_sha add base i
  end
end

fn r_k_name_raw idx ulong to void
  base = mul idx F_NAME
  for i ulong get g_k_namel idx bound 80
    r_b get g_k_name add base i
  end
end

fn r_k_name_esc idx ulong to void
  base = mul idx F_NAME
  for i ulong get g_k_namel idx bound 80
    r_esc_b get g_k_name add base i
  end
end

fn r_k_name_json idx ulong to void
  base = mul idx F_NAME
  for i ulong get g_k_namel idx bound 80
    r_jesc_b get g_k_name add base i
  end
end

fn r_k_auth_raw idx ulong to void
  base = mul idx F_AUTH
  for i ulong get g_k_authl idx bound 64
    r_b get g_k_auth add base i
  end
end

fn r_k_auth_esc idx ulong to void
  base = mul idx F_AUTH
  for i ulong get g_k_authl idx bound 64
    r_esc_b get g_k_auth add base i
  end
end

fn r_k_auth_json idx ulong to void
  base = mul idx F_AUTH
  for i ulong get g_k_authl idx bound 64
    r_jesc_b get g_k_auth add base i
  end
end

fn r_k_lic_raw idx ulong to void
  base = mul idx F_LIC
  for i ulong get g_k_licl idx bound 32
    r_b get g_k_lic add base i
  end
end

fn r_k_lic_esc idx ulong to void
  base = mul idx F_LIC
  for i ulong get g_k_licl idx bound 32
    r_esc_b get g_k_lic add base i
  end
end

fn r_k_lic_json idx ulong to void
  base = mul idx F_LIC
  for i ulong get g_k_licl idx bound 32
    r_jesc_b get g_k_lic add base i
  end
end

fn emit_kcat_row_resp idx ulong to void
  r_k_sha idx 64
  r_b 9
  r_k_name_raw idx
  r_b 9
  r_k_auth_raw idx
  r_b 9
  r_k_lic_raw idx
  r_b 9
  r_hex16 get g_k_bhash idx
  r_b 9
  r_u64 get g_k_mode idx
  r_b 9
  r_u64 get g_k_tau idx
  r_b 9
  r_u64 get g_k_splice idx
  r_b 9
  r_u64 get g_k_sc idx
  r_b 9
  r_u64 get g_k_dl idx
  r_b 9
  r_u64 get g_k_ts idx
  r_b 9
  r_u64 get g_k_tok idx
  r_b 9
  r_u64 get g_k_seed idx
  r_b 9
  r_u64 get g_k_steps idx
  r_b 9
  r_u64 get g_k_lr idx
  sc = get g_k_sc idx
  for slot ulong 4
    r_b 9
    if lt slot sc
      base = mul add mul idx 4 slot 64
      for j ulong 64
        r_b get g_k_ssha add base j
      end
    end
    r_b 9
    if lt slot sc
      r_i64 get g_k_sw add mul idx 4 slot
    else
      r_b 48
    end
  end
  r_b 10
end

fn save_clips_catalog to bool
  r_reset
  r_txt t_kcat_hdr1
  r_txt t_kcat_hdr2
  cnt = get g_kcnt 0
  for i ulong cnt bound 256
    emit_kcat_row_resp i
  end
  build_tmp_p1 t_tmp_kcat_pre t_ext_tsv
  fd = fopen g_p1 0 get g_p1l 0 577 420
  if lt fd 0
    ret false
  end
  ok = write_all_resp int fd
  if ok
    if ne fsync int fd 0
      ok = false
    end
  end
  x = fclose int fd
  if not ok
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  p2_reset
  p2_dir
  p2_txt t_sub_kcat
  if not atomic_rename_p1_p2
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  ret true
end

note ---- Catalog lookup and trunk compatibility helpers ----

fn sha_eq_cat_u idx ulong to bool
  base = mul idx F_SHA
  for i ulong 64
    if ne get g_c_sha add base i get g_u_sha i
      ret false
    end
  end
  ret true
end

fn find_strand_by_u_sha to long
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if sha_eq_cat_u i
      ret long i
    end
  end
  ret -1
end

fn sha_eq_cat_pt idx ulong to bool
  if ne get g_u_ptl 0 64
    ret false
  end
  base = mul idx F_SHA
  for i ulong 64
    if ne get g_c_sha add base i get g_u_pt i
      ret false
    end
  end
  ret true
end

fn find_strand_by_u_pt to long
  if ne get g_u_ptl 0 64
    ret -1
  end
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if sha_eq_cat_pt i
      ret long i
    end
  end
  ret -1
end

fn sha_eq_cat_dpath idx ulong to bool
  base = mul idx F_SHA
  for i ulong 64
    if ne get g_c_sha add base i get g_dpath i
      ret false
    end
  end
  ret true
end

fn find_strand_by_dpath to long
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if sha_eq_cat_dpath i
      ret long i
    end
  end
  ret -1
end

fn sha_eq_cat_eslot idx ulong slot ulong to bool
  base = mul idx F_SHA
  eb = mul slot 64
  for i ulong 64
    if ne get g_c_sha add base i get g_e_ssha add eb i
      ret false
    end
  end
  ret true
end

fn find_strand_by_eslot slot ulong to long
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if sha_eq_cat_eslot i slot
      ret long i
    end
  end
  ret -1
end

fn sha_eq_kcat_dpath idx ulong to bool
  base = mul idx 64
  for i ulong 64
    if ne get g_k_sha add base i get g_dpath i
      ret false
    end
  end
  ret true
end

fn find_clip_by_dpath to long
  cnt = get g_kcnt 0
  for i ulong cnt bound 256
    if sha_eq_kcat_dpath i
      ret long i
    end
  end
  ret -1
end

fn sha_eq_kcat_esha idx ulong to bool
  base = mul idx 64
  for i ulong 64
    if ne get g_k_sha add base i get g_e_sha i
      ret false
    end
  end
  ret true
end

fn find_clip_by_esha to long
  cnt = get g_kcnt 0
  for i ulong cnt bound 256
    if sha_eq_kcat_esha i
      ret long i
    end
  end
  ret -1
end

fn strand_matches_trunk idx ulong to bool
  ql = get g_q_trunkl 0
  if eq ql 0
    ret true
  end
  fmt_hex16 get g_c_bhash idx
  if le ql 16
    ok1 = true
    for i ulong ql bound 16
      if ne to_low get g_q_trunk i get g_hex16 i
        ok1 = false
        break
      end
    end
    if ok1
      ret true
    end
  end
  ptl = get g_c_ptl idx
  if ge ptl ql
    base = mul idx F_PT
    ok2 = true
    for i ulong ql bound 64
      if ne to_low get g_q_trunk i to_low get g_c_pt add base i
        ok2 = false
        break
      end
    end
    if ok2
      ret true
    end
  end
  ret false
end

fn strand_matches_filters idx ulong to bool
  if not strand_matches_trunk idx
    ret false
  end
  ll = get g_q_licl 0
  if eq ll 0
    ret true
  end
  if ne ll get g_c_licl idx
    ret false
  end
  base = mul idx F_LIC
  for i ulong ll bound 32
    if ne to_low get g_q_lic i to_low get g_c_lic add base i
      ret false
    end
  end
  ret true
end

fn collect_distinct_trunks to ulong
  put g_seen_cnt 0 0
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    bh = get g_c_bhash i
    sc = get g_seen_cnt 0
    found = false
    for j ulong sc bound 512
      if eq get g_seen_tr j bh
        found = true
        break
      end
    end
    if not found
      if lt sc 512
        put g_seen_tr sc bh
        put g_seen_cnt 0 add sc 1
      end
    end
  end
  ret get g_seen_cnt 0
end

fn total_downloads to ulong
  tot = ulong 0
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    tot = add tot get g_c_dl i
  end
  ret tot
end

fn find_partner_strand idx ulong to long
  bh = get g_c_bhash idx
  cnt = get g_scnt 0
  for i ulong cnt bound 512
    if ne i idx
      if eq get g_c_bhash i bh
        ret long i
      end
    end
  end
  ret -1
end

note ---- HTTP request parsing, query decoding, and streaming body ----

fn req_starts off ulong pat view uchar * to bool
  n = get g_reql 0
  if gt add off len pat n
    ret false
  end
  for i ulong len pat bound 128
    if ne get g_req add off i get pat i
      ret false
    end
  end
  ret true
end

fn req_istarts off ulong pat view uchar * to bool
  n = get g_reql 0
  if gt add off len pat n
    ret false
  end
  for i ulong len pat bound 128
    if ne to_low get g_req add off i get pat i
      ret false
    end
  end
  ret true
end

fn req_range_eq a ulong b ulong pat view uchar * to bool
  if ne sub b a len pat
    ret false
  end
  for i ulong len pat bound 128
    if ne get g_req add a i get pat i
      ret false
    end
  end
  ret true
end

fn req_range_starts a ulong b ulong pat view uchar * to bool
  if lt sub b a len pat
    ret false
  end
  for i ulong len pat bound 128
    if ne get g_req add a i get pat i
      ret false
    end
  end
  ret true
end

fn find_hdr_end to ulong
  n = get g_reql 0
  if lt n 4
    ret 0
  end
  for i ulong sub n 3 bound 32768
    if eq get g_req i 13
      if eq get g_req add i 1 10
        if eq get g_req add i 2 13
          if eq get g_req add i 3 10
            ret add i 4
          end
        end
      end
    end
  end
  ret 0
end

fn read_http_headers fd int to bool
  put g_reql 0 0
  dl = add long monons HUB_IO_TMO
  for it ulong 20000 bound 20000
    h = find_hdr_end
    if gt h 0
      put g_rq_st RQ_HEND h
      ret true
    end
    n = get g_reql 0
    if ge n HUB_MAX_HDR
      ret false
    end
    left = sub dl long monons
    if le left 0
      ret false
    end
    w = waitio fd 1 left
    if le w 0
      if eq w -4
        continue
      end
      ret false
    end
    r = recv fd g_req n sub HUB_MAX_HDR n 0
    if lt r 0
      if or eq r -4 eq r -11
        continue
      end
      ret false
    end
    if eq r 0
      ret false
    end
    put g_reql 0 add n ulong r
  end
  ret false
end

fn reset_upload_meta to void
  put g_u_namel 0 0
  put g_u_authl 0 0
  put g_u_licl 0 0
  put g_u_terml 0 0
  put g_u_provl 0 0
  put g_u_ptl 0 0
  put g_u_fnl 0 0
  put g_u_descl 0 0
  put g_u_expl 0 0
  put g_u_bndl 0 0
  put g_u_deliml 0 0
  for i ulong 16
    put g_u_st i 0
  end
end

fn parse_hdr_val_span line_s ulong line_e ulong plen ulong to ulong
  j = add line_s plen
  while lt j line_e bound 512
    c = get g_req j
    if and ne c 32 ne c 9
      break
    end
    j = add j 1
  end
  ret j
end

fn trim_hdr_end lo ulong hi ulong to ulong
  e = hi
  while gt e lo bound 512
    c = get g_req sub e 1
    if or eq c 32 or eq c 9 or eq c 13 eq c 10
      e = sub e 1
    else
      break
    end
  end
  ret e
end

fn copy_req_san_u fld ulong lo ulong hi ulong to void
  e = trim_hdr_end lo hi
  n = sub e lo
  for i ulong n bound 256
    c = get g_req add lo i
    if or eq c 0 or eq c 9 or eq c 10 eq c 13
      c = 32
    end
    if eq fld 1
      k = get g_u_namel 0
      if lt k F_NAME
        put g_u_name k c
        put g_u_namel 0 add k 1
      end
    end
    if eq fld 2
      k = get g_u_authl 0
      if lt k F_AUTH
        put g_u_auth k c
        put g_u_authl 0 add k 1
      end
    end
    if eq fld 3
      k = get g_u_licl 0
      if lt k F_LIC
        put g_u_lic k c
        put g_u_licl 0 add k 1
      end
    end
    if eq fld 4
      k = get g_u_terml 0
      if lt k F_TERM
        put g_u_term k c
        put g_u_terml 0 add k 1
      end
    end
    if eq fld 5
      k = get g_u_provl 0
      if lt k F_PROV
        put g_u_prov k c
        put g_u_provl 0 add k 1
      end
    end
    if eq fld 6
      k = get g_u_ptl 0
      if lt k F_PT
        put g_u_pt k to_low c
        put g_u_ptl 0 add k 1
      end
    end
    if eq fld 7
      k = get g_u_descl 0
      if lt k F_DESC
        put g_u_desc k c
        put g_u_descl 0 add k 1
      end
    end
    if eq fld 8
      k = get g_u_fnl 0
      if lt k F_FN
        put g_u_fn k c
        put g_u_fnl 0 add k 1
      end
    end
    if eq fld 9
      k = get g_u_expl 0
      if lt k 64
        put g_u_exp k to_low c
        put g_u_expl 0 add k 1
      end
    end
  end
end

fn is_bnd_sep c uchar to bool
  if eq c 59
    ret true
  end
  if eq c 32
    ret true
  end
  if eq c 9
    ret true
  end
  if eq c 13
    ret true
  end
  ret eq c 10
end

fn copy_boundary_at j0 ulong hi ulong to bool
  j = j0
  quoted = false
  if lt j hi
    if eq get g_req j 34
      quoted = true
      j = add j 1
    end
  end
  while lt j hi bound 96
    c = get g_req j
    if quoted
      if eq c 34
        break
      end
    else
      if is_bnd_sep c
        break
      end
    end
    bl = get g_u_bndl 0
    if ge bl 70
      ret false
    end
    put g_u_bnd bl c
    put g_u_bndl 0 add bl 1
    j = add j 1
  end
  ret gt get g_u_bndl 0 0
end

fn parse_boundary_from_ct lo ulong hi ulong to bool
  put g_u_bndl 0 0
  i = lo
  while lt i hi bound 512
    if req_istarts i t_bnd_eq
      ret copy_boundary_at add i len t_bnd_eq hi
    end
    i = add i 1
  end
  ret false
end

fn parse_cl_value lo ulong hi ulong to bool
  e = trim_hdr_end lo hi
  if ge lo e
    ret false
  end
  val = ulong 0
  for i ulong sub e lo bound 32
    c = get g_req add lo i
    if or lt c 48 gt c 57
      ret false
    end
    if gt val 100000000000
      ret false
    end
    val = add mul val 10 ulong sub c 48
  end
  if ne get g_rq_st RQ_HAS_CL 0
    if ne val get g_rq_st RQ_CLEN
      ret false
    end
  end
  put g_rq_st RQ_HAS_CL 1
  put g_rq_st RQ_CLEN val
  ret true
end

fn parse_x_strand_hdr ls ulong le_pos ulong to void
  if req_istarts ls t_h_xname
    put g_u_namel 0 0
    copy_req_san_u 1 parse_hdr_val_span ls le_pos len t_h_xname le_pos
    ret
  end
  if req_istarts ls t_h_xauth
    put g_u_authl 0 0
    copy_req_san_u 2 parse_hdr_val_span ls le_pos len t_h_xauth le_pos
    ret
  end
  if req_istarts ls t_h_xlic
    put g_u_licl 0 0
    copy_req_san_u 3 parse_hdr_val_span ls le_pos len t_h_xlic le_pos
    ret
  end
  if req_istarts ls t_h_xterm
    put g_u_terml 0 0
    copy_req_san_u 4 parse_hdr_val_span ls le_pos len t_h_xterm le_pos
    ret
  end
  if req_istarts ls t_h_xprov
    put g_u_provl 0 0
    copy_req_san_u 5 parse_hdr_val_span ls le_pos len t_h_xprov le_pos
    ret
  end
  if req_istarts ls t_h_xpt
    put g_u_ptl 0 0
    copy_req_san_u 6 parse_hdr_val_span ls le_pos len t_h_xpt le_pos
    ret
  end
  if req_istarts ls t_h_xdesc
    put g_u_descl 0 0
    copy_req_san_u 7 parse_hdr_val_span ls le_pos len t_h_xdesc le_pos
    ret
  end
  if req_istarts ls t_h_xfn
    put g_u_fnl 0 0
    copy_req_san_u 8 parse_hdr_val_span ls le_pos len t_h_xfn le_pos
    ret
  end
  if req_istarts ls t_h_xexp
    put g_u_expl 0 0
    copy_req_san_u 9 parse_hdr_val_span ls le_pos len t_h_xexp le_pos
    ret
  end
end

fn parse_one_hdr_line ls ulong le_pos ulong to void
  if req_istarts ls t_h_te
    put g_rq_st RQ_BAD_HDR 1
    ret
  end
  if req_istarts ls t_h_expect
    put g_rq_st RQ_EXPECT 1
    ret
  end
  if req_istarts ls t_h_cl
    v0 = parse_hdr_val_span ls le_pos len t_h_cl
    if not parse_cl_value v0 le_pos
      put g_rq_st RQ_BAD_HDR 1
    end
    ret
  end
  if req_istarts ls t_h_ct
    v0 = parse_hdr_val_span ls le_pos len t_h_ct
    if req_istarts v0 t_ct_mp
      put g_rq_st RQ_CTYPE 1
      if not parse_boundary_from_ct v0 le_pos
        put g_rq_st RQ_BAD_HDR 1
      end
    else
      if req_istarts v0 t_ct_form
        put g_rq_st RQ_CTYPE 2
      else
        if req_istarts v0 t_ct_oct
          put g_rq_st RQ_CTYPE 3
        else
          if req_istarts v0 t_ct_plain
            put g_rq_st RQ_CTYPE 4
          end
        end
      end
    end
    ret
  end
  parse_x_strand_hdr ls le_pos
end

fn parse_req_headers to bool
  hend = get g_rq_st RQ_HEND
  for i ulong 16
    if ne i RQ_HEND
      put g_rq_st i 0
    end
  end
  reset_upload_meta
  p0 = ulong 0
  if req_starts 0 t_m_get
    put g_rq_st RQ_METH 1
    p0 = 4
  else
    if req_starts 0 t_m_head
      put g_rq_st RQ_METH 2
      p0 = 5
    else
      if req_starts 0 t_m_post
        put g_rq_st RQ_METH 3
        p0 = 5
      else
        ret false
      end
    end
  end
  p1 = p0
  q0 = ulong 0
  while lt p1 hend bound 4096
    c = get g_req p1
    if or eq c 32 or eq c 13 eq c 10
      break
    end
    if and eq c 63 eq q0 0
      q0 = add p1 1
    end
    p1 = add p1 1
  end
  if eq q0 0
    put g_rq_st RQ_P0 p0
    put g_rq_st RQ_P1 p1
    put g_rq_st RQ_Q0 0
    put g_rq_st RQ_Q1 0
  else
    put g_rq_st RQ_P0 p0
    put g_rq_st RQ_P1 sub q0 1
    put g_rq_st RQ_Q0 q0
    put g_rq_st RQ_Q1 p1
  end
  i = p1
  while lt i hend bound 16384
    c = get g_req i
    i = add i 1
    if eq c 10
      break
    end
  end
  while lt i hend bound 16384
    ls = i
    while lt i hend bound 16384
      c = get g_req i
      i = add i 1
      if eq c 10
        break
      end
    end
    le_pos = i
    if gt le_pos ls
      if eq get g_req sub le_pos 1 10
        le_pos = sub le_pos 1
      end
    end
    if gt le_pos ls
      if eq get g_req sub le_pos 1 13
        le_pos = sub le_pos 1
      end
    end
    if eq ls le_pos
      break
    end
    parse_one_hdr_line ls le_pos
  end
  ret true
end

note ---- Query string parsing ----

fn qkey_eq pat view uchar * to bool
  if ne get g_qkeyl 0 len pat
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_qkey i get pat i
      ret false
    end
  end
  ret true
end

fn apply_query_kv to void
  vl = get g_qvall 0
  if qkey_eq t_f_trunk
    if gt vl 64
      vl = 64
    end
    for i ulong vl bound 64
      put g_q_trunk i to_low get g_qval i
    end
    put g_q_trunkl 0 vl
    ret
  end
  if qkey_eq t_f_lic
    if gt vl F_LIC
      vl = F_LIC
    end
    for i ulong vl bound 32
      put g_q_lic i get g_qval i
    end
    put g_q_licl 0 vl
    ret
  end
  if qkey_eq t_f_pt
    if gt vl 64
      vl = 64
    end
    for i ulong vl bound 64
      put g_q_pt i to_low get g_qval i
    end
    put g_q_ptl 0 vl
    ret
  end
  if qkey_eq t_f_clip
    if gt vl 64
      vl = 64
    end
    for i ulong vl bound 64
      put g_q_clip i to_low get g_qval i
    end
    put g_q_clipl 0 vl
    ret
  end
  if qkey_eq t_f_s1
    if gt vl 64
      vl = 64
    end
    for i ulong vl bound 64
      put g_q_s1 i to_low get g_qval i
    end
    put g_q_s1l 0 vl
    ret
  end
  if qkey_eq t_f_s2
    if gt vl 64
      vl = 64
    end
    for i ulong vl bound 64
      put g_q_s2 i to_low get g_qval i
    end
    put g_q_s2l 0 vl
    ret
  end
end

fn parse_query_string to void
  put g_q_trunkl 0 0
  put g_q_licl 0 0
  put g_q_ptl 0 0
  put g_q_clipl 0 0
  put g_q_s1l 0 0
  put g_q_s2l 0 0
  q0 = get g_rq_st RQ_Q0
  q1 = get g_rq_st RQ_Q1
  if ge q0 q1
    ret
  end
  i = q0
  while lt i q1 bound 4096
    put g_qkeyl 0 0
    put g_qvall 0 0
    in_val = false
    while lt i q1 bound 4096
      c = get g_req i
      if eq c 38
        i = add i 1
        break
      end
      if and not in_val eq c 61
        in_val = true
        i = add i 1
        continue
      end
      b = c
      if eq c 43
        b = 32
        i = add i 1
      else
        if eq c 37
          if le add i 3 q1
            h1 = hex_val get g_req add i 1
            h2 = hex_val get g_req add i 2
            if and ge h1 0 ge h2 0
              b = uchar add mul h1 16 h2
              i = add i 3
            else
              i = add i 1
            end
          else
            i = add i 1
          end
        else
          i = add i 1
        end
      end
      if in_val
        vl = get g_qvall 0
        if lt vl 256
          put g_qval vl b
          put g_qvall 0 add vl 1
        end
      else
        kl = get g_qkeyl 0
        if lt kl 64
          put g_qkey kl b
          put g_qkeyl 0 add kl 1
        end
      end
    end
    if gt get g_qkeyl 0 0
      apply_query_kv
    end
  end
end

note ---- Stream HTTP body to staging file ----

fn write_exact_fd fd int off ulong n ulong use_req bool to bool
  p = ulong 0
  while lt p n bound 100000
    w = long 0
    if use_req
      w = write fd g_req add off p sub n p
    else
      w = write fd g_io add off p sub n p
    end
    if le w 0
      if eq w -4
        continue
      end
      ret false
    end
    p = add p ulong w
  end
  ret true
end

fn flush_req_tail rawfd int hend ulong clen ulong to long
  avail = ulong 0
  reql = get g_reql 0
  if gt reql hend
    avail = sub reql hend
  end
  if gt avail clen
    avail = clen
  end
  if gt avail 0
    if not write_exact_fd rawfd hend avail true
      ret -1
    end
  end
  ret long avail
end

fn recv_io_step sockfd int want ulong dl long to long
  left = sub dl long monons
  if le left 0
    ret -2
  end
  w = waitio sockfd 1 left
  if le w 0
    if eq w -4
      ret -1
    end
    ret -2
  end
  r = recv sockfd g_io 0 want 0
  if lt r 0
    if or eq r -4 eq r -11
      ret -1
    end
    ret -2
  end
  if eq r 0
    ret -2
  end
  ret r
end

fn stream_body_to_file sockfd int hend ulong clen ulong rawfd int to bool
  fl = flush_req_tail rawfd hend clen
  if lt fl 0
    ret false
  end
  done = ulong fl
  dl = add long monons HUB_UP_TMO
  while lt done clen bound 100000000
    want = sub clen done
    if gt want HUB_IO_SZ
      want = HUB_IO_SZ
    end
    r = recv_io_step sockfd want dl
    if eq r -1
      continue
    end
    if le r 0
      ret false
    end
    if not write_exact_fd rawfd 0 ulong r false
      ret false
    end
    done = add done ulong r
  end
  ret eq done clen
end

note ---- Overlap-safe multipart/form-data parser over staging file ----

fn pread_exact fd int pos ulong n ulong to bool
  p = ulong 0
  while lt p n bound 10000
    r = pread fd g_io p sub n p long add pos p
    if le r 0
      if eq r -4
        continue
      end
      ret false
    end
    p = add p ulong r
  end
  ret true
end

fn build_delim with_crlf bool to void
  p = ulong 0
  if with_crlf
    put g_u_delim 0 13
    put g_u_delim 1 10
    p = 2
  end
  put g_u_delim p 45
  put g_u_delim add p 1 45
  p = add p 2
  bl = get g_u_bndl 0
  for i ulong bl bound 72
    put g_u_delim add p i get g_u_bnd i
  end
  put g_u_deliml 0 add p bl
end

fn io_match_delim off ulong dlen ulong to bool
  for i ulong dlen bound 104
    if ne get g_io add off i get g_u_delim i
      ret false
    end
  end
  ret true
end

fn find_delim_in_file fd int start ulong flen ulong to long
  dlen = get g_u_deliml 0
  if or eq dlen 0 gt add start dlen flen
    ret -1
  end
  pos = start
  while le add pos dlen flen bound 200000
    want = sub flen pos
    if gt want HUB_IO_SZ
      want = HUB_IO_SZ
    end
    if not pread_exact fd pos want
      ret -1
    end
    lim = add sub want dlen 1
    for i ulong lim bound 65536
      if eq get g_io i get g_u_delim 0
        if io_match_delim i dlen
          ret long add pos i
        end
      end
    end
    if ge add pos want flen
      ret -1
    end
    pos = add pos sub want sub dlen 1
  end
  ret -1
end

fn io_istarts off ulong lim ulong pat view uchar * to bool
  if gt add off len pat lim
    ret false
  end
  for i ulong len pat bound 64
    if ne to_low get g_io add off i get pat i
      ret false
    end
  end
  ret true
end

fn parse_part_disp_attrs s ulong e ulong to void
  i = s
  while lt i e bound 4096
    if io_istarts i e t_p_fn
      j = add i len t_p_fn
      put g_u_has_pfn 0 1
      put g_u_pfnl 0 0
      while lt j e bound 160
        c = get g_io j
        if eq c 34
          break
        end
        k = get g_u_pfnl 0
        if lt k 160
          put g_u_pfn k c
          put g_u_pfnl 0 add k 1
        end
        j = add j 1
      end
      i = add j 1
      continue
    end
    if io_istarts i e t_p_name
      j = add i len t_p_name
      put g_u_pnamel 0 0
      while lt j e bound 64
        c = get g_io j
        if eq c 34
          break
        end
        k = get g_u_pnamel 0
        if lt k 64
          put g_u_pname k c
          put g_u_pnamel 0 add k 1
        end
        j = add j 1
      end
      i = add j 1
      continue
    end
    i = add i 1
  end
end

fn parse_part_headers fd int pstart ulong flen ulong to long
  put g_u_pnamel 0 0
  put g_u_pfnl 0 0
  put g_u_has_pfn 0 0
  want = sub flen pstart
  if gt want 4096
    want = 4096
  end
  if lt want 4
    ret -1
  end
  if not pread_exact fd pstart want
    ret -1
  end
  hend = ulong 0
  for i ulong sub want 3 bound 4096
    if eq get g_io i 13
      if eq get g_io add i 1 10
        if eq get g_io add i 2 13
          if eq get g_io add i 3 10
            hend = add i 4
            break
          end
        end
      end
    end
  end
  if eq hend 0
    ret -1
  end
  i = ulong 0
  while lt i hend bound 4096
    ls = i
    while lt i hend bound 4096
      c = get g_io i
      i = add i 1
      if eq c 10
        break
      end
    end
    if io_istarts ls i t_cdisp
      parse_part_disp_attrs add ls len t_cdisp i
    end
  end
  ret long add pstart hend
end

fn pname_eq pat view uchar * to bool
  if ne get g_u_pnamel 0 len pat
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_u_pname i get pat i
      ret false
    end
  end
  ret true
end

fn validate_upload_filename to bool
  n = get g_u_fnl 0
  if eq n 0
    ret true
  end
  if gt n F_FN
    ret false
  end
  if eq get g_u_fn 0 46
    ret false
  end
  for i ulong n bound 128
    c = get g_u_fn i
    if not is_safe_fn_char c
      ret false
    end
    if eq c 46
      if lt add i 1 n
        if eq get g_u_fn add i 1 46
          ret false
        end
      end
    end
  end
  ret true
end

fn copy_io_san_u fld ulong n ulong to void
  for i ulong n bound 256
    c = get g_io i
    if or eq c 0 or eq c 9 or eq c 10 eq c 13
      c = 32
    end
    if eq fld 1
      k = get g_u_namel 0
      if lt k F_NAME
        put g_u_name k c
        put g_u_namel 0 add k 1
      end
    end
    if eq fld 2
      k = get g_u_authl 0
      if lt k F_AUTH
        put g_u_auth k c
        put g_u_authl 0 add k 1
      end
    end
    if eq fld 3
      k = get g_u_licl 0
      if lt k F_LIC
        put g_u_lic k c
        put g_u_licl 0 add k 1
      end
    end
    if eq fld 4
      k = get g_u_terml 0
      if lt k F_TERM
        put g_u_term k c
        put g_u_terml 0 add k 1
      end
    end
    if eq fld 5
      k = get g_u_provl 0
      if lt k F_PROV
        put g_u_prov k c
        put g_u_provl 0 add k 1
      end
    end
    if eq fld 6
      k = get g_u_ptl 0
      if lt k F_PT
        put g_u_pt k to_low c
        put g_u_ptl 0 add k 1
      end
    end
    if eq fld 7
      k = get g_u_descl 0
      if lt k F_DESC
        put g_u_desc k c
        put g_u_descl 0 add k 1
      end
    end
    if eq fld 9
      k = get g_u_expl 0
      if lt k 64
        put g_u_exp k to_low c
        put g_u_expl 0 add k 1
      end
    end
  end
end

fn store_mp_text_part fd int boff ulong blen ulong to void
  n = blen
  if gt n 256
    n = 256
  end
  if gt n 0
    if not pread_exact fd boff n
      ret
    end
  end
  if pname_eq t_f_name
    put g_u_namel 0 0
    copy_io_san_u 1 n
    ret
  end
  if pname_eq t_f_author
    put g_u_authl 0 0
    copy_io_san_u 2 n
    ret
  end
  if pname_eq t_f_lic
    put g_u_licl 0 0
    copy_io_san_u 3 n
    ret
  end
  if pname_eq t_f_terms
    put g_u_terml 0 0
    copy_io_san_u 4 n
    ret
  end
  if pname_eq t_f_prov
    put g_u_provl 0 0
    copy_io_san_u 5 n
    ret
  end
  if pname_eq t_f_pt
    put g_u_ptl 0 0
    copy_io_san_u 6 n
    ret
  end
  if pname_eq t_f_desc
    put g_u_descl 0 0
    copy_io_san_u 7 n
    ret
  end
  if pname_eq t_f_exp
    put g_u_expl 0 0
    copy_io_san_u 9 n
    ret
  end
end

fn parse_multipart_file fd int flen ulong to bool
  build_delim false
  first = find_delim_in_file fd 0 flen
  if lt first 0
    put g_u_st US_ERR UE_BAD_MULTIPART
    ret false
  end
  pos = add ulong first get g_u_deliml 0
  for part_i ulong HUB_MAX_PARTS bound 32
    if gt add pos 2 flen
      put g_u_st US_ERR UE_BAD_MULTIPART
      ret false
    end
    if not pread_exact fd pos 2
      put g_u_st US_ERR UE_IO_FAIL
      ret false
    end
    if and eq get g_io 0 45 eq get g_io 1 45
      ret true
    end
    if and eq get g_io 0 13 eq get g_io 1 10
      pos = add pos 2
    else
      if eq get g_io 0 10
        pos = add pos 1
      else
        put g_u_st US_ERR UE_BAD_MULTIPART
        ret false
      end
    end
    bstart = parse_part_headers fd pos flen
    if lt bstart 0
      put g_u_st US_ERR UE_BAD_MULTIPART
      ret false
    end
    build_delim true
    next_d = find_delim_in_file fd ulong bstart flen
    if lt next_d 0
      put g_u_st US_ERR UE_BAD_MULTIPART
      ret false
    end
    blen = sub ulong next_d ulong bstart
    if pname_eq t_f_pack
      if ne get g_u_has_pfn 0 0
        pfnl = get g_u_pfnl 0
        if gt pfnl F_FN
          put g_u_st US_ERR UE_BAD_FILENAME
          ret false
        end
        for fi ulong pfnl bound 128
          put g_u_fn fi get g_u_pfn fi
        end
        put g_u_fnl 0 pfnl
        if not validate_upload_filename
          put g_u_st US_ERR UE_BAD_FILENAME
          ret false
        end
      end
      put g_u_st US_HAS_PACK 1
      put g_u_st US_POFF ulong bstart
      put g_u_st US_PLEN blen
    else
      store_mp_text_part fd ulong bstart blen
    end
    pos = add ulong next_d get g_u_deliml 0
  end
  put g_u_st US_ERR UE_BAD_MULTIPART
  ret false
end

note ---- Fail-closed OLLMSP01 verifier and atomic content-addressed store ----

fn validate_hex_u_pt to bool
  n = get g_u_ptl 0
  if eq n 0
    ret true
  end
  if and ne n 16 ne n 64
    ret false
  end
  for i ulong n bound 64
    if not is_hex_low get g_u_pt i
      ret false
    end
  end
  ret true
end

fn validate_hex_u_exp to bool
  n = get g_u_expl 0
  if eq n 0
    ret true
  end
  if ne n 64
    ret false
  end
  for i ulong 64
    if not is_hex_low get g_u_exp i
      ret false
    end
  end
  ret true
end

fn ensure_default_meta to void
  if eq get g_u_licl 0 0
    for i ulong len t_def_lic bound 32
      put g_u_lic i get t_def_lic i
    end
    put g_u_licl 0 len t_def_lic
  end
  if eq get g_u_terml 0 0
    for i ulong len t_def_term bound 128
      put g_u_term i get t_def_term i
    end
    put g_u_terml 0 len t_def_term
  end
  if eq get g_u_fnl 0 0
    nl = get g_u_namel 0
    p = ulong 0
    for i ulong nl bound 80
      c = get g_u_name i
      if is_safe_fn_char c
        if lt p 120
          put g_u_fn p c
          p = add p 1
        end
      else
        if lt p 120
          put g_u_fn p 45
          p = add p 1
        end
      end
    end
    if eq p 0
      put g_u_fn 0 115
      put g_u_fn 1 116
      put g_u_fn 2 114
      put g_u_fn 3 97
      put g_u_fn 4 110
      put g_u_fn 5 100
      p = 6
    end
    put g_u_fn p 46
    put g_u_fn add p 1 115
    put g_u_fn add p 2 112
    put g_u_fnl 0 add p 3
  end
end

fn check_u_pt_merkle bl ulong bh ulong to ulong
  ptl = get g_u_ptl 0
  if eq ptl 0
    ret UE_OK
  end
  if eq ptl 16
    fmt_hex16 bh
    for i ulong 16
      if ne get g_u_pt i get g_hex16 i
        ret UE_MERKLE_MISMATCH
      end
    end
    ret UE_OK
  end
  pidx = find_strand_by_u_pt
  if ge pidx 0
    if ne get g_c_sl ulong pidx bl
      ret UE_MERKLE_LINEAGE
    end
  end
  ret UE_OK
end

fn copy_pack_to_blob rawfd int poff ulong plen ulong to bool
  build_tmp_p1 t_tmp_sp_pre t_ext_sp
  dfd = fopen g_p1 0 get g_p1l 0 577 420
  if lt dfd 0
    ret false
  end
  done = ulong 0
  ok = true
  while lt done plen bound 200000
    want = sub plen done
    if gt want HUB_IO_SZ
      want = HUB_IO_SZ
    end
    if not pread_exact rawfd add poff done want
      ok = false
      break
    end
    if not write_exact_fd int dfd 0 want false
      ok = false
      break
    end
    done = add done want
  end
  if ok
    if ne fdsync int dfd 0
      ok = false
    end
  end
  x = fclose int dfd
  if not ok
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  p2_reset
  p2_dir
  p2_txt t_sub_blobs
  p2_txt t_slash
  for i ulong 64
    p2_b get g_u_sha i
  end
  p2_txt t_ext_sp
  if not atomic_rename_p1_p2
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  ret true
end

fn append_u_to_catalog idx ulong to void
  for i ulong 64
    put g_c_sha add mul idx F_SHA i get g_u_sha i
  end
  for i ulong get g_u_namel 0 bound 80
    put g_c_name add mul idx F_NAME i get g_u_name i
  end
  put g_c_namel idx get g_u_namel 0
  for i ulong get g_u_authl 0 bound 64
    put g_c_auth add mul idx F_AUTH i get g_u_auth i
  end
  put g_c_authl idx get g_u_authl 0
  for i ulong get g_u_licl 0 bound 32
    put g_c_lic add mul idx F_LIC i get g_u_lic i
  end
  put g_c_licl idx get g_u_licl 0
  for i ulong get g_u_terml 0 bound 128
    put g_c_term add mul idx F_TERM i get g_u_term i
  end
  put g_c_terml idx get g_u_terml 0
  for i ulong get g_u_provl 0 bound 160
    put g_c_prov add mul idx F_PROV i get g_u_prov i
  end
  put g_c_provl idx get g_u_provl 0
  for i ulong get g_u_ptl 0 bound 64
    put g_c_pt add mul idx F_PT i get g_u_pt i
  end
  put g_c_ptl idx get g_u_ptl 0
  for i ulong get g_u_fnl 0 bound 128
    put g_c_fn add mul idx F_FN i get g_u_fn i
  end
  put g_c_fnl idx get g_u_fnl 0
  for i ulong get g_u_descl 0 bound 256
    put g_c_desc add mul idx F_DESC i get g_u_desc i
  end
  put g_c_descl idx get g_u_descl 0
  put g_c_bhash idx get g_u_st US_BHASH
  put g_c_bl idx get g_u_st US_BL
  put g_c_sl idx get g_u_st US_SL
  put g_c_npar idx get g_u_st US_NPAR
  put g_c_phash idx get g_u_st US_PHASH
  put g_c_sz idx get g_u_st US_PLEN
  put g_c_dl idx 0
  put g_c_ts idx ulong realns
  put g_scnt 0 add idx 1
end

fn stream_verify_payload rawfd int poff ulong pay_len ulong to ulong
  fnv = FNV_OFF
  done = ulong 0
  while lt done pay_len bound 200000
    want = sub pay_len done
    if gt want HUB_IO_SZ
      want = HUB_IO_SZ
    end
    if not pread_exact rawfd add add poff 48 done want
      put g_u_st US_ERR UE_IO_FAIL
      ret 0
    end
    sha_feed_io 0 want
    for b ulong want bound 65536
      fnv = mul xor fnv ulong get g_io b FNV_PRM
    end
    nw = div want 8
    for wi ulong nw bound 8192
      w = read_u64_le_io mul wi 8
      exp_bits = and shr w 52 2047
      if eq exp_bits 2047
        put g_u_st US_ERR UE_NONFINITE
        ret 0
      end
    end
    done = add done want
  end
  ret fnv
end

fn verify_pack_header rawfd int poff ulong plen ulong to bool
  max_up = get g_max_up 0
  if gt plen max_up
    put g_u_st US_ERR UE_TOO_BIG
    put g_u_st US_HTTP_CODE 413
    ret false
  end
  if lt plen 48
    put g_u_st US_ERR UE_TRUNCATED
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if not pread_exact rawfd poff 48
    put g_u_st US_ERR UE_IO_FAIL
    put g_u_st US_HTTP_CODE 500
    ret false
  end
  if ne read_u64_le_io 0 OSPMAG
    put g_u_st US_ERR UE_BAD_MAGIC
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  bl = read_u64_le_io 8
  sl = read_u64_le_io 16
  bh = read_u64_le_io 24
  npar = read_u64_le_io 32
  put g_u_st US_BL bl
  put g_u_st US_SL sl
  put g_u_st US_BHASH bh
  put g_u_st US_NPAR npar
  put g_u_st US_PHASH read_u64_le_io 40
  if or eq bl 0 or le sl bl gt sl 1024
    put g_u_st US_ERR UE_BAD_LAYERS
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if or eq bh 0 eq bh FNV_OFF
    put g_u_st US_ERR UE_BAD_BASE_HASH
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if or eq npar 0 gt npar div sub max_up 48 8
    put g_u_st US_ERR UE_BAD_PARAMS
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if ne plen add 48 mul npar 8
    put g_u_st US_ERR UE_SIZE_MISMATCH
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  merr = check_u_pt_merkle bl bh
  if ne merr UE_OK
    put g_u_st US_ERR merr
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  ret true
end

fn verify_and_store_pack rawfd int to bool
  if eq get g_u_st US_HAS_PACK 0
    put g_u_st US_ERR UE_MISSING_PACK
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if not validate_upload_filename
    put g_u_st US_ERR UE_BAD_FILENAME
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if or eq get g_u_namel 0 0 eq get g_u_authl 0 0
    put g_u_st US_ERR UE_MISSING_META
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if not validate_hex_u_pt
    put g_u_st US_ERR UE_BAD_PARENT_TRUNK
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if not validate_hex_u_exp
    put g_u_st US_ERR UE_SHA_MISMATCH
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  ensure_default_meta
  poff = get g_u_st US_POFF
  plen = get g_u_st US_PLEN
  if not verify_pack_header rawfd poff plen
    ret false
  end
  sha_start
  sha_feed_io 0 48
  got_fnv = stream_verify_payload rawfd poff mul get g_u_st US_NPAR 8
  if ne get g_u_st US_ERR UE_OK
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  if ne got_fnv get g_u_st US_PHASH
    put g_u_st US_ERR UE_PACK_HASH
    put g_u_st US_HTTP_CODE 400
    ret false
  end
  sha_finish
  for i ulong 64
    put g_u_sha i get g_sh_hex i
  end
  if eq get g_u_expl 0 64
    for i ulong 64
      if ne get g_u_exp i get g_u_sha i
        put g_u_st US_ERR UE_SHA_MISMATCH
        put g_u_st US_HTTP_CODE 400
        ret false
      end
    end
  end
  dup = find_strand_by_u_sha
  if ge dup 0
    put g_u_st US_DUP_IDX ulong dup
    put g_u_st US_ERR UE_DUPLICATE
    put g_u_st US_HTTP_CODE 409
    ret false
  end
  if ge get g_scnt 0 HUB_MAX_STRANDS
    put g_u_st US_ERR UE_STORAGE_FULL
    put g_u_st US_HTTP_CODE 507
    ret false
  end
  if not copy_pack_to_blob rawfd poff plen
    put g_u_st US_ERR UE_IO_FAIL
    put g_u_st US_HTTP_CODE 500
    ret false
  end
  nidx = get g_scnt 0
  append_u_to_catalog nidx
  if not save_catalog
    put g_scnt 0 nidx
    put g_u_st US_ERR UE_IO_FAIL
    put g_u_st US_HTTP_CODE 500
    ret false
  end
  put g_u_st US_NEW_IDX nidx
  put g_u_st US_ERR UE_OK
  put g_u_st US_HTTP_CODE 201
  ret true
end

note ---- Strand Clip Editor (.spclip composer, store, and fail-closed validator) ----

fn reset_clip_edit to void
  for i ulong 16
    put g_e_st i 0
  end
  put g_e_st ES_MODE 1
  put g_e_st ES_TAU 700
  put g_e_st ES_SPLICE 0
  put g_e_st ES_TOK 128
  put g_e_st ES_SEED 42
  put g_e_st ES_STEPS 0
  put g_e_st ES_LR 3500
  for i ulong len t_def_clip_name bound 80
    put g_e_name i get t_def_clip_name i
  end
  put g_e_namel 0 len t_def_clip_name
  for i ulong len t_def_author bound 64
    put g_e_auth i get t_def_author i
  end
  put g_e_authl 0 len t_def_author
  for i ulong len t_def_lic bound 32
    put g_e_lic i get t_def_lic i
  end
  put g_e_licl 0 len t_def_lic
  for i ulong len t_def_prompt bound 256
    put g_e_prompt i get t_def_prompt i
  end
  put g_e_promptl 0 len t_def_prompt
  for i ulong len t_def_merges bound 128
    put g_e_merges i get t_def_merges i
  end
  put g_e_mergesl 0 len t_def_merges
  for k ulong 4
    put g_e_sset k 0
    put g_e_sidx k 0
    put g_e_sw k 1000
    put g_e_wset k 0
    put g_e_wbad k 0
  end
  put g_e_manl 0 0
end

fn parse_qval_u64_strict to long
  n = get g_qvall 0
  if eq n 0
    ret -1
  end
  v = ulong 0
  for i ulong n bound 20
    c = get g_qval i
    if or lt c 48 gt c 57
      ret -1
    end
    if gt v 1000000000
      ret -1
    end
    v = add mul v 10 ulong sub c 48
  end
  ret long v
end

fn parse_qval_i64_strict ok_slot ulong to long
  n = get g_qvall 0
  if eq n 0
    put g_e_wbad ok_slot 1
    ret 0
  end
  is_neg = false
  st = ulong 0
  if eq get g_qval 0 45
    is_neg = true
    st = 1
  else
    if eq get g_qval 0 43
      st = 1
    end
  end
  if ge st n
    put g_e_wbad ok_slot 1
    ret 0
  end
  v = ulong 0
  i = st
  while lt i n bound 20
    c = get g_qval i
    if or lt c 48 gt c 57
      put g_e_wbad ok_slot 1
      ret 0
    end
    if gt v 1000000
      put g_e_wbad ok_slot 1
      ret 0
    end
    v = add mul v 10 ulong sub c 48
    i = add i 1
  end
  put g_e_wbad ok_slot 0
  if is_neg
    ret neg long v
  end
  ret long v
end

fn set_clip_slot_sha slot ulong to void
  vl = get g_qvall 0
  if eq vl 0
    put g_e_sset slot 0
    ret
  end
  if ne vl 64
    put g_e_sset slot 2
    ret
  end
  base = mul slot 64
  for i ulong 64
    c = to_low get g_qval i
    if not is_hex_low c
      put g_e_sset slot 2
      ret
    end
    put g_e_ssha add base i c
  end
  put g_e_sset slot 1
end

fn copy_qval_san_e which ulong to void
  vl = get g_qvall 0
  if eq which 1
    if eq vl 0
      ret
    end
    put g_e_namel 0 0
    for i ulong vl bound 80
      c = get g_qval i
      if or eq c 0 or eq c 9 or eq c 10 eq c 13
        c = 32
      end
      k = get g_e_namel 0
      if lt k F_NAME
        put g_e_name k c
        put g_e_namel 0 add k 1
      end
    end
    ret
  end
  if eq which 2
    if eq vl 0
      ret
    end
    put g_e_authl 0 0
    for i ulong vl bound 64
      c = get g_qval i
      if or eq c 0 or eq c 9 or eq c 10 eq c 13
        c = 32
      end
      k = get g_e_authl 0
      if lt k F_AUTH
        put g_e_auth k c
        put g_e_authl 0 add k 1
      end
    end
    ret
  end
  if eq which 3
    if eq vl 0
      ret
    end
    put g_e_licl 0 0
    for i ulong vl bound 32
      c = get g_qval i
      if or eq c 0 or eq c 9 or eq c 10 eq c 13
        c = 32
      end
      k = get g_e_licl 0
      if lt k F_LIC
        put g_e_lic k c
        put g_e_licl 0 add k 1
      end
    end
    ret
  end
  if eq which 4
    if eq vl 0
      ret
    end
    put g_e_promptl 0 0
    for i ulong vl bound 256
      c = get g_qval i
      if or eq c 0 or eq c 9 or eq c 10 or eq c 13 eq c 34
        c = 32
      end
      k = get g_e_promptl 0
      if lt k 256
        put g_e_prompt k c
        put g_e_promptl 0 add k 1
      end
    end
    ret
  end
  if eq which 5
    if eq vl 0
      ret
    end
    put g_e_mergesl 0 0
    for i ulong vl bound 128
      c = get g_qval i
      if or eq c 0 or eq c 9 or eq c 10 or eq c 13 eq c 32
        continue
      end
      k = get g_e_mergesl 0
      if lt k 128
        put g_e_merges k c
        put g_e_mergesl 0 add k 1
      end
    end
  end
end

fn apply_clip_form_kv_nums to void
  if qkey_eq t_f_mode
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_MODE 99
    else
      put g_e_st ES_MODE ulong v
    end
    ret
  end
  if qkey_eq t_f_tau
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_TAU 99999
    else
      put g_e_st ES_TAU ulong v
    end
    ret
  end
  if qkey_eq t_f_splice
    if eq get g_qvall 0 0
      put g_e_st ES_SPLICE 0
    else
      v = parse_qval_u64_strict
      if lt v 0
        put g_e_st ES_SPLICE 99999
      else
        put g_e_st ES_SPLICE ulong v
      end
    end
    ret
  end
  if qkey_eq t_f_tokens
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_TOK 99999
    else
      put g_e_st ES_TOK ulong v
    end
    ret
  end
  if qkey_eq t_f_seed
    v = parse_qval_u64_strict
    if ge v 0
      put g_e_st ES_SEED ulong v
    end
    ret
  end
  if qkey_eq t_f_steps
    if gt get g_qvall 0 0
      v = parse_qval_u64_strict
      if ge v 0
        put g_e_st ES_STEPS ulong v
      end
    end
    ret
  end
  if qkey_eq t_f_lr
    if gt get g_qvall 0 0
      v = parse_qval_u64_strict
      if ge v 0
        put g_e_st ES_LR ulong v
      end
    end
  end
end

fn apply_clip_form_kv to void
  if qkey_eq t_f_s1
    set_clip_slot_sha 0
    ret
  end
  if qkey_eq t_f_s2
    set_clip_slot_sha 1
    ret
  end
  if qkey_eq t_f_s3
    set_clip_slot_sha 2
    ret
  end
  if qkey_eq t_f_s4
    set_clip_slot_sha 3
    ret
  end
  if qkey_eq t_f_w1
    put g_e_sw 0 parse_qval_i64_strict 0
    put g_e_wset 0 1
    ret
  end
  if qkey_eq t_f_w2
    put g_e_sw 1 parse_qval_i64_strict 1
    put g_e_wset 1 1
    ret
  end
  if qkey_eq t_f_w3
    put g_e_sw 2 parse_qval_i64_strict 2
    put g_e_wset 2 1
    ret
  end
  if qkey_eq t_f_w4
    put g_e_sw 3 parse_qval_i64_strict 3
    put g_e_wset 3 1
    ret
  end
  if qkey_eq t_f_clip_name
    copy_qval_san_e 1
    ret
  end
  if qkey_eq t_f_author
    copy_qval_san_e 2
    ret
  end
  if qkey_eq t_f_lic
    copy_qval_san_e 3
    ret
  end
  if qkey_eq t_f_prompt
    copy_qval_san_e 4
    ret
  end
  if qkey_eq t_f_merges
    copy_qval_san_e 5
    ret
  end
  if qkey_eq t_f_action
    if eq get g_qvall 0 len t_v_download
      ok = true
      for i ulong len t_v_download bound 16
        if ne get g_qval i get t_v_download i
          ok = false
          break
        end
      end
      if ok
        put g_e_st ES_ACTION 1
      end
    end
    ret
  end
  apply_clip_form_kv_nums
end

fn parse_clip_form_vbuf to void
  n = get g_e_vbufl 0
  i = ulong 0
  while lt i n bound 16384
    put g_qkeyl 0 0
    put g_qvall 0 0
    in_val = false
    while lt i n bound 16384
      c = get g_e_vbuf i
      if eq c 38
        i = add i 1
        break
      end
      if and not in_val eq c 61
        in_val = true
        i = add i 1
        continue
      end
      b = c
      if eq c 43
        b = 32
        i = add i 1
      else
        if eq c 37
          if le add i 3 n
            h1 = hex_val get g_e_vbuf add i 1
            h2 = hex_val get g_e_vbuf add i 2
            if and ge h1 0 ge h2 0
              b = uchar add mul h1 16 h2
              i = add i 3
            else
              i = add i 1
            end
          else
            i = add i 1
          end
        else
          i = add i 1
        end
      end
      if in_val
        vl = get g_qvall 0
        if lt vl 256
          put g_qval vl b
          put g_qvall 0 add vl 1
        end
      else
        kl = get g_qkeyl 0
        if lt kl 64
          put g_qkey kl b
          put g_qkeyl 0 add kl 1
        end
      end
    end
    if gt get g_qkeyl 0 0
      apply_clip_form_kv
    end
  end
end

fn man_reset to void
  put g_e_manl 0 0
end

fn man_b c uchar to void
  n = get g_e_manl 0
  if lt n 16384
    put g_e_man n c
    put g_e_manl 0 add n 1
  end
end

fn man_txt t view uchar * to void
  for i ulong len t bound 256
    man_b get t i
  end
end

fn man_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    man_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    man_b get buf p
    p = add p 1
  end
end

fn man_i64 v long to void
  if lt v 0
    man_b 45
    man_u64 ulong neg v
    ret
  end
  man_u64 ulong v
end

fn man_hex16 v ulong to void
  fmt_hex16 v
  for i ulong 16
    man_b get g_hex16 i
  end
end

fn pt_compatible_pair ia ulong ib ulong to bool
  la = get g_c_ptl ia
  lb = get g_c_ptl ib
  if and eq la 64 eq lb 64
    ba = mul ia F_PT
    bb = mul ib F_PT
    for i ulong 64
      if ne get g_c_pt add ba i get g_c_pt add bb i
        ret false
      end
    end
  end
  ret true
end

fn validate_clip_slots to bool
  sc = ulong 0
  for k ulong 4
    st = get g_e_sset k
    if eq st 2
      put g_e_st ES_ERR CE_UNKNOWN_STRAND
      ret false
    end
    if eq st 1
      idx = find_strand_by_eslot k
      if lt idx 0
        put g_e_st ES_ERR CE_UNKNOWN_STRAND
        ret false
      end
      if ne sc k
        bsrc = mul k 64
        bdst = mul sc 64
        for j ulong 64
          put g_e_ssha add bdst j get g_e_ssha add bsrc j
        end
        put g_e_sw sc get g_e_sw k
        put g_e_wbad sc get g_e_wbad k
      end
      put g_e_sidx sc ulong idx
      put g_e_sset sc 1
      if ne sc k
        put g_e_sset k 0
      end
      sc = add sc 1
    end
  end
  put g_e_st ES_SC sc
  if or lt sc 2 gt sc 4
    put g_e_st ES_ERR CE_STRAND_COUNT
    ret false
  end
  i0 = get g_e_sidx 0
  bh0 = get g_c_bhash i0
  min_bl = get g_c_bl i0
  put g_e_st ES_BHASH bh0
  for k ulong sc bound 4
    ik = get g_e_sidx k
    if ne get g_c_bhash ik bh0
      put g_e_st ES_ERR CE_INCOMPAT_TRUNK
      ret false
    end
    if not pt_compatible_pair i0 ik
      put g_e_st ES_ERR CE_INCOMPAT_TRUNK
      ret false
    end
    if lt get g_c_bl ik min_bl
      min_bl = get g_c_bl ik
    end
  end
  put g_e_st ES_MIN_BL min_bl
  ret true
end

fn validate_clip_params to bool
  mode = get g_e_st ES_MODE
  if gt mode 1
    put g_e_st ES_ERR CE_BAD_MODE
    ret false
  end
  if gt get g_e_st ES_TAU 5000
    put g_e_st ES_ERR CE_BAD_TAU
    ret false
  end
  tok = get g_e_st ES_TOK
  if or eq tok 0 gt tok 8192
    put g_e_st ES_ERR CE_BAD_TOKENS
    ret false
  end
  sp = get g_e_st ES_SPLICE
  min_bl = get g_e_st ES_MIN_BL
  if eq sp 0
    put g_e_st ES_SPLICE min_bl
  else
    if gt sp min_bl
      put g_e_st ES_ERR CE_BAD_SPLICE
      ret false
    end
  end
  sc = get g_e_st ES_SC
  pos_cnt = ulong 0
  for k ulong sc bound 4
    if ne get g_e_wbad k 0
      put g_e_st ES_ERR CE_BAD_WEIGHT
      ret false
    end
    w = get g_e_sw k
    if eq w 0
      put g_e_st ES_ERR CE_BAD_WEIGHT
      ret false
    end
    if or lt w -5000 gt w 5000
      put g_e_st ES_ERR CE_BAD_WEIGHT
      ret false
    end
    if eq mode 1
      if lt w 1
        put g_e_st ES_ERR CE_BAD_WEIGHT
        ret false
      end
    end
    if gt w 0
      pos_cnt = add pos_cnt 1
    end
  end
  if eq pos_cnt 0
    put g_e_st ES_ERR CE_BAD_WEIGHT
    ret false
  end
  ret true
end

fn build_spclip_manifest to void
  man_reset
  man_txt t_mf_magic
  man_b 10
  man_txt t_mf_name
  for i ulong get g_e_namel 0 bound 80
    man_b get g_e_name i
  end
  man_b 10
  man_txt t_mf_auth
  for i ulong get g_e_authl 0 bound 64
    man_b get g_e_auth i
  end
  man_b 10
  man_txt t_mf_lic
  for i ulong get g_e_licl 0 bound 32
    man_b get g_e_lic i
  end
  man_b 10
  man_txt t_mf_bh
  man_hex16 get g_e_st ES_BHASH
  man_b 10
  man_txt t_mf_pt
  i0 = get g_e_sidx 0
  if gt get g_c_ptl i0 0
    base0 = mul i0 F_PT
    for j ulong get g_c_ptl i0 bound 64
      man_b get g_c_pt add base0 j
    end
  end
  man_b 10
  man_txt t_mf_sp
  man_u64 get g_e_st ES_SPLICE
  man_b 10
  man_txt t_mf_mode
  man_u64 get g_e_st ES_MODE
  man_b 10
  man_txt t_mf_tau
  man_u64 get g_e_st ES_TAU
  man_b 10
  man_txt t_mf_tok
  man_u64 get g_e_st ES_TOK
  man_b 10
  man_txt t_mf_seed
  man_u64 get g_e_st ES_SEED
  man_b 10
  man_txt t_mf_steps
  man_u64 get g_e_st ES_STEPS
  man_b 10
  man_txt t_mf_lr
  man_u64 get g_e_st ES_LR
  man_b 10
  sc = get g_e_st ES_SC
  man_txt t_mf_sc
  man_u64 sc
  man_b 10
  for k ulong sc bound 4
    ik = get g_e_sidx k
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_sha_k
    bs = mul ik F_SHA
    for j ulong 64
      man_b get g_c_sha add bs j
    end
    man_b 10
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_bh_k
    man_hex16 get g_c_bhash ik
    man_b 10
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_bl_k
    man_u64 get g_c_bl ik
    man_b 10
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_sl_k
    man_u64 get g_c_sl ik
    man_b 10
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_wm_k
    man_i64 get g_e_sw k
    man_b 10
    man_txt t_mf_s_pre
    man_u64 add k 1
    man_txt t_mf_fn_k
    bf = mul ik F_FN
    for j ulong get g_c_fnl ik bound 128
      man_b get g_c_fn add bf j
    end
    man_b 10
  end
  sha_start
  sha_feed_man 0 get g_e_manl 0
  sha_finish
  for i ulong 64
    put g_e_bsha i get g_sh_hex i
  end
  man_txt t_mf_bsha
  for i ulong 64
    man_b get g_e_bsha i
  end
  man_b 10
  sha_start
  sha_feed_man 0 get g_e_manl 0
  sha_finish
  for i ulong 64
    put g_e_sha i get g_sh_hex i
  end
end

fn write_man_to_clip_file to bool
  build_tmp_p1 t_tmp_clip_pre t_ext_spclip
  fd = fopen g_p1 0 get g_p1l 0 577 420
  if lt fd 0
    ret false
  end
  n = get g_e_manl 0
  off = ulong 0
  ok = true
  while lt off n bound 16384
    w = write int fd g_e_man off sub n off
    if le w 0
      if eq w -4
        continue
      end
      ok = false
      break
    end
    off = add off ulong w
  end
  if ok
    if ne fsync int fd 0
      ok = false
    end
  end
  x = fclose int fd
  if not ok
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  p2_reset
  p2_dir
  p2_txt t_sub_clips
  p2_txt t_slash
  for i ulong 64
    p2_b get g_e_sha i
  end
  p2_txt t_ext_spclip
  if not atomic_rename_p1_p2
    u = unlink g_p1 0 get g_p1l 0
    ret false
  end
  ret true
end

fn append_clip_record idx ulong to void
  for i ulong 64
    put g_k_sha add mul idx 64 i get g_e_sha i
  end
  for i ulong get g_e_namel 0 bound 80
    put g_k_name add mul idx F_NAME i get g_e_name i
  end
  put g_k_namel idx get g_e_namel 0
  for i ulong get g_e_authl 0 bound 64
    put g_k_auth add mul idx F_AUTH i get g_e_auth i
  end
  put g_k_authl idx get g_e_authl 0
  for i ulong get g_e_licl 0 bound 32
    put g_k_lic add mul idx F_LIC i get g_e_lic i
  end
  put g_k_licl idx get g_e_licl 0
  put g_k_bhash idx get g_e_st ES_BHASH
  put g_k_mode idx get g_e_st ES_MODE
  put g_k_tau idx get g_e_st ES_TAU
  put g_k_splice idx get g_e_st ES_SPLICE
  sc = get g_e_st ES_SC
  put g_k_sc idx sc
  put g_k_dl idx 0
  put g_k_ts idx ulong realns
  put g_k_tok idx get g_e_st ES_TOK
  put g_k_seed idx get g_e_st ES_SEED
  put g_k_steps idx get g_e_st ES_STEPS
  put g_k_lr idx get g_e_st ES_LR
  for slot ulong 4
    base = mul add mul idx 4 slot 64
    if lt slot sc
      ik = get g_e_sidx slot
      bs = mul ik F_SHA
      for j ulong 64
        put g_k_ssha add base j get g_c_sha add bs j
      end
      put g_k_sw add mul idx 4 slot get g_e_sw slot
    else
      for j ulong 64
        put g_k_ssha add base j 48
      end
      put g_k_sw add mul idx 4 slot 0
    end
  end
  put g_kcnt 0 add idx 1
end

fn compose_and_store_clip to bool
  if not validate_clip_slots
    ret false
  end
  if not validate_clip_params
    ret false
  end
  build_spclip_manifest
  ex = find_clip_by_esha
  if ge ex 0
    put g_e_st ES_ERR CE_OK
    ret true
  end
  if ge get g_kcnt 0 HUB_MAX_CLIPS
    put g_e_st ES_ERR CE_STORAGE_FULL
    ret false
  end
  if not write_man_to_clip_file
    put g_e_st ES_ERR CE_IO_FAIL
    ret false
  end
  kidx = get g_kcnt 0
  append_clip_record kidx
  if not save_clips_catalog
    put g_kcnt 0 kidx
    put g_e_st ES_ERR CE_IO_FAIL
    ret false
  end
  put g_e_st ES_ERR CE_OK
  ret true
end

note ---- Standalone fail-closed .spclip manifest verifier (POST /strands/clip/verify) ----

fn vbuf_starts off ulong lim ulong pat view uchar * to bool
  if gt add off len pat lim
    ret false
  end
  for i ulong len pat bound 64
    if ne get g_e_vbuf add off i get pat i
      ret false
    end
  end
  ret true
end

fn copy_vbuf_to_qval lo ulong hi ulong to void
  n = sub hi lo
  if gt n 256
    n = 256
  end
  for i ulong n bound 256
    put g_qval i get g_e_vbuf add lo i
  end
  put g_qvall 0 n
end

fn parse_spclip_line ls ulong le_pos ulong to void
  if vbuf_starts ls le_pos t_mf_sc
    copy_vbuf_to_qval add ls len t_mf_sc le_pos
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_BAD_NUM 1
    else
      put g_e_st ES_SC ulong v
    end
    ret
  end
  if vbuf_starts ls le_pos t_mf_bh
    copy_vbuf_to_qval add ls len t_mf_bh le_pos
    if ne get g_qvall 0 16
      put g_e_st ES_BAD_NUM 1
      ret
    end
    hv = ulong 0
    for hi ulong 16
      d = hex_val get g_qval hi
      if lt d 0
        put g_e_st ES_BAD_NUM 1
        ret
      end
      hv = or shl hv 4 ulong d
    end
    put g_e_st ES_BHASH hv
    ret
  end
  if vbuf_starts ls le_pos t_mf_mode
    copy_vbuf_to_qval add ls len t_mf_mode le_pos
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_MODE 99
    else
      put g_e_st ES_MODE ulong v
    end
    ret
  end
  if vbuf_starts ls le_pos t_mf_tau
    copy_vbuf_to_qval add ls len t_mf_tau le_pos
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_TAU 99999
    else
      put g_e_st ES_TAU ulong v
    end
    ret
  end
  if vbuf_starts ls le_pos t_mf_sp
    copy_vbuf_to_qval add ls len t_mf_sp le_pos
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_SPLICE 99999
    else
      put g_e_st ES_SPLICE ulong v
    end
    ret
  end
  if vbuf_starts ls le_pos t_mf_tok
    copy_vbuf_to_qval add ls len t_mf_tok le_pos
    v = parse_qval_u64_strict
    if lt v 0
      put g_e_st ES_TOK 99999
    else
      put g_e_st ES_TOK ulong v
    end
    ret
  end
  if vbuf_starts ls le_pos t_mf_s1_sha
    copy_vbuf_to_qval add ls len t_mf_s1_sha le_pos
    set_clip_slot_sha 0
    ret
  end
  if vbuf_starts ls le_pos t_mf_s2_sha
    copy_vbuf_to_qval add ls len t_mf_s2_sha le_pos
    set_clip_slot_sha 1
    ret
  end
  if vbuf_starts ls le_pos t_mf_s3_sha
    copy_vbuf_to_qval add ls len t_mf_s3_sha le_pos
    set_clip_slot_sha 2
    ret
  end
  if vbuf_starts ls le_pos t_mf_s4_sha
    copy_vbuf_to_qval add ls len t_mf_s4_sha le_pos
    set_clip_slot_sha 3
    ret
  end
  if vbuf_starts ls le_pos t_mf_s1_w
    copy_vbuf_to_qval add ls len t_mf_s1_w le_pos
    put g_e_sw 0 parse_qval_i64_strict 0
    put g_e_wset 0 1
    ret
  end
  if vbuf_starts ls le_pos t_mf_s2_w
    copy_vbuf_to_qval add ls len t_mf_s2_w le_pos
    put g_e_sw 1 parse_qval_i64_strict 1
    put g_e_wset 1 1
    ret
  end
  if vbuf_starts ls le_pos t_mf_s3_w
    copy_vbuf_to_qval add ls len t_mf_s3_w le_pos
    put g_e_sw 2 parse_qval_i64_strict 2
    put g_e_wset 2 1
    ret
  end
  if vbuf_starts ls le_pos t_mf_s4_w
    copy_vbuf_to_qval add ls len t_mf_s4_w le_pos
    put g_e_sw 3 parse_qval_i64_strict 3
    put g_e_wset 3 1
    ret
  end
end

fn verify_submitted_spclip to bool
  reset_clip_edit
  put g_e_st ES_MODE 99
  put g_e_st ES_TAU 99999
  put g_e_st ES_SPLICE 99999
  put g_e_st ES_TOK 99999
  put g_e_st ES_SC 0
  put g_e_st ES_BHASH 0
  for k ulong 4
    put g_e_wbad k 1
  end
  n = get g_e_vbufl 0
  if lt n add len t_mf_magic len t_mf_bsha
    put g_e_st ES_ERR CE_BAD_FORMAT
    ret false
  end
  if not vbuf_starts 0 n t_mf_magic
    put g_e_st ES_ERR CE_BAD_FORMAT
    ret false
  end
  bsha_pos = ulong 0
  found_bsha = false
  i = ulong 0
  while lt i n bound 16384
    ls = i
    while lt i n bound 16384
      c = get g_e_vbuf i
      i = add i 1
      if eq c 10
        break
      end
    end
    le_pos = i
    if gt le_pos ls
      if eq get g_e_vbuf sub le_pos 1 10
        le_pos = sub le_pos 1
      end
    end
    if vbuf_starts ls le_pos t_mf_bsha
      if ne sub le_pos add ls len t_mf_bsha 64
        put g_e_st ES_ERR CE_TAMPERED
        ret false
      end
      if ne i n
        put g_e_st ES_ERR CE_TAMPERED
        ret false
      end
      bsha_pos = ls
      found_bsha = true
      for j ulong 64
        put g_e_bsha j get g_e_vbuf add add ls len t_mf_bsha j
      end
      break
    end
    parse_spclip_line ls le_pos
  end
  if or not found_bsha ne get g_e_st ES_BAD_NUM 0
    put g_e_st ES_ERR CE_BAD_FORMAT
    ret false
  end
  sha_start
  sha_feed_vbuf 0 bsha_pos
  sha_finish
  for j ulong 64
    if ne get g_sh_hex j get g_e_bsha j
      put g_e_st ES_ERR CE_TAMPERED
      ret false
    end
  end
  sha_start
  sha_feed_vbuf 0 n
  sha_finish
  for j ulong 64
    put g_e_sha j get g_sh_hex j
  end
  decl_sc = get g_e_st ES_SC
  decl_bh = get g_e_st ES_BHASH
  if not validate_clip_slots
    ret false
  end
  if ne decl_sc get g_e_st ES_SC
    put g_e_st ES_ERR CE_STRAND_COUNT
    ret false
  end
  if ne decl_bh get g_e_st ES_BHASH
    put g_e_st ES_ERR CE_INCOMPAT_TRUNK
    ret false
  end
  if not validate_clip_params
    ret false
  end
  put g_e_st ES_ERR CE_OK
  ret true
end


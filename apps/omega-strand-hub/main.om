  base = mul idx F_PROV
  n = get g_c_provl idx
  for i ulong n bound 160
    r_jesc_b get g_c_prov add base i
  end
end

fn r_c_pt_raw idx ulong to void
  base = mul idx F_PT
  n = get g_c_ptl idx
  for i ulong n bound 64
    r_b get g_c_pt add base i
  end
end

fn r_c_fn_esc idx ulong to void
  base = mul idx F_FN
  n = get g_c_fnl idx
  for i ulong n bound 128
    r_esc_b get g_c_fn add base i
  end
end

fn r_c_fn_raw idx ulong to void
  base = mul idx F_FN
  n = get g_c_fnl idx
  for i ulong n bound 128
    r_b get g_c_fn add base i
  end
end


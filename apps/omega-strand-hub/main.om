    r_u64 get g_k_mode i
    r_txt t_kj_7
    r_u64 get g_k_tau i
    r_txt t_kj_8
    r_u64 get g_k_splice i
    r_txt t_kj_9
    r_u64 get g_k_sc i
    r_txt t_kj_10
    r_u64 get g_k_dl i
    r_txt t_kj_11
    r_k_sha i 64
    r_txt t_kj_12
  end
  r_txt t_j_close
end

text t_vj_ok1 "{\"valid\":true,\"clip_sha256\":\""
text t_vj_ok2 "\",\"body_sha256\":\""
text t_vj_ok3 "\",\"base_hash\":\""
text t_vj_ok4 "\",\"strand_count\":"
text t_vj_ok5 ",\"mode\":"
text t_vj_ok6 ",\"tau_milli\":"
text t_vj_ok7 ",\"splice_layer\":"
text t_vj_ok8 "}\n"
text t_vj_err1 "{\"valid\":false,\"error_code\":"
text t_vj_err2 ",\"error\":\""
text t_vj_err3 "\"}\n"

fn render_clip_verify_json ok bool to void
  r_reset
  if ok
    r_txt t_vj_ok1
    r_e_sha_all
    r_txt t_vj_ok2
    r_e_bsha_all
    r_txt t_vj_ok3
    r_hex16 get g_e_st ES_BHASH
    r_txt t_vj_ok4
    r_u64 get g_e_st ES_SC
    r_txt t_vj_ok5
    r_u64 get g_e_st ES_MODE
    r_txt t_vj_ok6
    r_u64 get g_e_st ES_TAU
    r_txt t_vj_ok7
    r_u64 get g_e_st ES_SPLICE
    r_txt t_vj_ok8
    ret
  end
  r_txt t_vj_err1
  r_u64 get g_e_st ES_ERR
  r_txt t_vj_err2
  r_clip_err_msg get g_e_st ES_ERR
  r_txt t_vj_err3
end

note ---- Socket transmission, file streaming, and HTTP route dispatcher ----

fn send_hdr_buf fd int to void
  n = get g_hdrl 0
  off = ulong 0
  dl = add long monons HUB_IO_TMO
  while lt off n bound 10000
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd g_hdr off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end

fn send_resp_buf fd int to void
  n = get g_respl 0
  off = ulong 0
  dl = add long monons HUB_IO_TMO
  while lt off n bound 100000
    left = sub dl long monons
    if le left 0
      ret
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret
    end
    k = send fd g_resp off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret
    end
    if eq k 0
      ret
    end
    off = add off ulong k
  end
end

fn send_io_chunk fd int n ulong to bool
  off = ulong 0
  dl = add long monons HUB_IO_TMO
  while lt off n bound 20000
    left = sub dl long monons
    if le left 0
      ret false
    end
    w = waitio fd 4 left
    if le w 0
      if eq w -4
        continue
      end
      ret false
    end
    k = send fd g_io off sub n off 16384
    if lt k 0
      if or eq k -4 eq k -11
        continue
      end
      ret false
    end
    if eq k 0
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn h_status_line code ulong to void
  if eq code 201
    h_txt t_http_201
    ret
  end
  if eq code 400
    h_txt t_http_400
    ret
  end
  if eq code 404
    h_txt t_http_404
    ret
  end
  if eq code 405
    h_txt t_http_405
    ret
  end
  if eq code 409
    h_txt t_http_409
    ret
  end
  if eq code 411
    h_txt t_http_411
    ret
  end
  if eq code 413
    h_txt t_http_413
    ret
  end
  if eq code 415
    h_txt t_http_415
    ret
  end
  if eq code 500
    h_txt t_http_500
    ret
  end
  if eq code 507
    h_txt t_http_507
    ret
  end
  h_txt t_http_200
end

note ct_kind: 0=html 1=css 2=txt 3=tsv 4=json 5=bin
fn h_ct_line ct_kind ulong to void
  if eq ct_kind 1
    h_txt t_ct_css
    h_crlf
    h_txt t_cc_css
    ret
  end
  if eq ct_kind 2
    h_txt t_ct_txt
  else
    if eq ct_kind 3
      h_txt t_ct_tsv
    else
      if eq ct_kind 4
        h_txt t_ct_json
      else
        if eq ct_kind 5
          h_txt t_ct_bin
        else
          h_txt t_ct_html
        end
      end
    end
  end
  h_crlf
  h_txt t_cc_no
end

fn send_resp fd int code ulong ct_kind ulong head_only bool to void
  h_reset
  h_status_line code
  h_crlf
  h_ct_line ct_kind
  h_crlf
  h_txt t_nosniff
  h_crlf
  h_txt t_cl_pre
  h_u64 get g_respl 0
  h_crlf
  h_txt t_conn_close
  h_crlf
  h_crlf
  send_hdr_buf fd
  if not head_only
    send_resp_buf fd
  end
end

fn send_resp_xsha fd int code ulong ct_kind ulong kind ulong to void
  h_reset
  h_status_line code
  h_crlf
  h_ct_line ct_kind
  h_crlf
  h_txt t_nosniff
  h_crlf
  if eq kind 1
    h_txt t_xsha_pre
    for i ulong 64
      h_b get g_u_sha i
    end
    h_crlf
    h_txt t_xbh_pre
    h_hex16 get g_u_st US_BHASH
    h_crlf
  end
  if eq kind 2
    h_txt t_xksha_pre
    for i ulong 64
      h_b get g_e_sha i
    end
    h_crlf
  end
  h_txt t_cl_pre
  h_u64 get g_respl 0
  h_crlf
  h_txt t_conn_close
  h_crlf
  h_crlf
  send_hdr_buf fd
  send_resp_buf fd
end

fn extract_hex64_with_ext p0 ulong p1 ulong plen ulong ext view uchar * to bool
  el = len ext
  if ne sub p1 p0 add add plen 64 el
    ret false
  end
  s0 = add p0 plen
  for i ulong 64
    c = get g_req add s0 i
    if not is_hex_low c
      ret false
    end
    put g_dpath i c
  end
  e0 = add s0 64
  for j ulong el bound 16
    if ne get g_req add e0 j get ext j
      ret false
    end
  end
  ret true
end

fn extract_hex64_bare p0 ulong p1 ulong plen ulong to bool
  if ne sub p1 p0 add plen 64
    ret false
  end
  s0 = add p0 plen
  for i ulong 64
    c = get g_req add s0 i
    if not is_hex_low c
      ret false
    end
    put g_dpath i c
  end
  ret true
end

fn stream_file_to_sock sockfd int ffd int tot ulong to void
  pos = ulong 0
  while lt pos tot bound 200000
    want = sub tot pos
    if gt want HUB_IO_SZ
      want = HUB_IO_SZ
    end
    if not pread_exact ffd pos want
      ret
    end
    if not send_io_chunk sockfd want
      ret
    end
    pos = add pos want
  end
end

fn build_pack_dl_hdr uidx ulong fsz ulong to void
  h_reset
  h_status_line 200
  h_crlf
  h_ct_line 5
  h_crlf
  h_txt t_nosniff
  h_crlf
  h_txt t_cd_pre
  bf = mul uidx F_FN
  for i ulong get g_c_fnl uidx bound 128
    c = get g_c_fn add bf i
    if is_safe_fn_char c
      h_b c
    end
  end
  h_txt t_cd_suf
  h_crlf
  h_txt t_xsha_pre
  for i ulong 64
    h_b get g_dpath i
  end
  h_crlf
  h_txt t_xbh_pre
  h_hex16 get g_c_bhash uidx
  h_crlf
  h_txt t_cl_pre
  h_u64 fsz
  h_crlf
  h_txt t_conn_close
  h_crlf
  h_crlf
end

fn handle_pack_download fd int p0 ulong p1 ulong head_only bool to void
  if not extract_hex64_with_ext p0 p1 len t_rt_pack_pre t_ext_sp
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 head_only
    ret
  end
  idx = find_strand_by_dpath
  if lt idx 0
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  p1_reset
  p1_dir
  p1_txt t_sub_blobs
  p1_txt t_slash
  for i ulong 64
    p1_b get g_dpath i
  end
  p1_txt t_ext_sp
  bfd = fopen g_p1 0 get g_p1l 0 0 0
  if lt bfd 0
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  fsz = fseek int bfd 0 2
  if lt fsz 0
    x = fclose int bfd
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  if not head_only
    put g_c_dl ulong idx add get g_c_dl ulong idx 1
    sv = save_catalog
  end
  build_pack_dl_hdr ulong idx ulong fsz
  send_hdr_buf fd
  if not head_only
    stream_file_to_sock fd int bfd ulong fsz
  end
  x = fclose int bfd
end

fn build_clip_dl_hdr fsz ulong to void
  h_reset
  h_status_line 200
  h_crlf
  h_ct_line 2
  h_crlf
  h_txt t_nosniff
  h_crlf
  h_txt t_cd_pre
  for i ulong 16
    h_b get g_dpath i
  end
  h_txt t_ext_spclip
  h_txt t_cd_suf
  h_crlf
  h_txt t_xksha_pre
  for i ulong 64
    h_b get g_dpath i
  end
  h_crlf
  h_txt t_cl_pre
  h_u64 fsz
  h_crlf
  h_txt t_conn_close
  h_crlf
  h_crlf
end

fn handle_clip_download fd int p0 ulong p1 ulong head_only bool to void
  if not extract_hex64_with_ext p0 p1 len t_rt_clip_pre t_ext_spclip
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 head_only
    ret
  end
  idx = find_clip_by_dpath
  if lt idx 0
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  p1_reset
  p1_dir
  p1_txt t_sub_clips
  p1_txt t_slash
  for i ulong 64
    p1_b get g_dpath i
  end
  p1_txt t_ext_spclip
  cfd = fopen g_p1 0 get g_p1l 0 0 0
  if lt cfd 0
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  fsz = fseek int cfd 0 2
  if lt fsz 0
    x = fclose int cfd
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 head_only
    ret
  end
  if not head_only
    put g_k_dl ulong idx add get g_k_dl ulong idx 1
    sv = save_clips_catalog
  end
  build_clip_dl_hdr ulong fsz
  send_hdr_buf fd
  if not head_only
    stream_file_to_sock fd int cfd ulong fsz
  end
  x = fclose int cfd
end

fn copy_req_tail_to_vbuf hend ulong clen ulong to ulong
  avail = ulong 0
  reql = get g_reql 0
  if gt reql hend
    avail = sub reql hend
  end
  if gt avail clen
    avail = clen
  end
  for i ulong avail bound 16384
    put g_e_vbuf i get g_req add hend i
  end
  ret avail
end

fn read_small_body_vbuf sockfd int hend ulong clen ulong to bool
  if gt clen 16384
    ret false
  end
  done = copy_req_tail_to_vbuf hend clen
  dl = add long monons HUB_IO_TMO
  while lt done clen bound 20000
    left = sub dl long monons
    if le left 0
      ret false
    end
    w = waitio sockfd 1 left
    if le w 0
      if eq w -4
        continue
      end
      ret false
    end
    r = recv sockfd g_e_vbuf done sub clen done 0
    if lt r 0
      if or eq r -4 eq r -11
        continue
      end
      ret false
    end
    if eq r 0
      ret false
    end
    done = add done ulong r
  end
  put g_e_vbufl 0 done
  ret eq done clen
end

fn handle_strand_upload fd int to void
  if ne get g_rq_st RQ_BAD_HDR 0
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 false
    ret
  end
  if eq get g_rq_st RQ_HAS_CL 0
    r_reset
    r_txt t_411_body
    send_resp fd 411 2 false
    ret
  end
  clen = get g_rq_st RQ_CLEN
  ct = get g_rq_st RQ_CTYPE
  if and ne ct 1 ne ct 3
    r_reset
    r_txt t_400_body
    send_resp fd 415 2 false
    ret
  end
  lim = add get g_max_up 0 HUB_HDR_OVERHEAD
  if eq ct 3
    lim = get g_max_up 0
  end
  if gt clen lim
    put g_u_st US_ERR UE_TOO_BIG
    render_home_page true
    send_resp fd 413 0 false
    ret
  end
  if ne get g_rq_st RQ_EXPECT 0
    h_reset
    h_txt t_http_100
    h_crlf
    h_crlf
    send_hdr_buf fd
  end
  build_tmp_p1 t_tmp_raw_pre t_ext_raw
  for i ulong get g_p1l 0 bound 1024
    put g_tmp_raw i get g_p1 i
  end
  put g_tmp_rawl 0 get g_p1l 0
  rawfd = fopen g_tmp_raw 0 get g_tmp_rawl 0 578 384
  if lt rawfd 0
    put g_u_st US_ERR UE_IO_FAIL
    render_home_page true
    send_resp fd 500 0 false
    ret
  end
  if not stream_body_to_file fd get g_rq_st RQ_HEND clen int rawfd
    x = fclose int rawfd
    u = unlink g_tmp_raw 0 get g_tmp_rawl 0
    put g_u_st US_ERR UE_TRUNCATED
    render_home_page true
    send_resp fd 400 0 false
    ret
  end
  ok_parse = true
  if eq ct 1
    ok_parse = parse_multipart_file int rawfd clen
  else
    put g_u_st US_HAS_PACK 1
    put g_u_st US_POFF 0
    put g_u_st US_PLEN clen
  end
  ok_ver = false
  if ok_parse
    ok_ver = verify_and_store_pack int rawfd
  else
    put g_u_st US_HTTP_CODE 400
  end
  x = fclose int rawfd
  u = unlink g_tmp_raw 0 get g_tmp_rawl 0
  code = get g_u_st US_HTTP_CODE
  if eq code 0
    code = 400
  end
  render_home_page true
  if or ok_ver eq code 409
    send_resp_xsha fd code 0 1
  else
    send_resp fd code 0 false
  end
end

fn handle_clip_post fd int to void
  if ne get g_rq_st RQ_BAD_HDR 0
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 false
    ret
  end
  if eq get g_rq_st RQ_HAS_CL 0
    r_reset
    r_txt t_411_body
    send_resp fd 411 2 false
    ret
  end
  clen = get g_rq_st RQ_CLEN
  if gt clen 16384
    r_reset
    r_txt t_413_body
    send_resp fd 413 2 false
    ret
  end
  if not read_small_body_vbuf fd get g_rq_st RQ_HEND clen
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 false
    ret
  end
  reset_clip_edit
  put g_e_st ES_HAS_POST 1
  parse_clip_form_vbuf
  ok = compose_and_store_clip
  if not ok
    render_clip_editor
    send_resp fd 400 0 false
    ret
  end
  if eq get g_e_st ES_ACTION 1
    r_reset
    for i ulong get g_e_manl 0 bound 16384
      r_b get g_e_man i
    end
    h_reset
    h_status_line 200
    h_crlf
    h_ct_line 2
    h_crlf
    h_txt t_nosniff
    h_crlf
    h_txt t_cd_pre
    for i ulong 16
      h_b get g_e_sha i
    end
    h_txt t_ext_spclip
    h_txt t_cd_suf
    h_crlf
    h_txt t_xksha_pre
    for i ulong 64
      h_b get g_e_sha i
    end
    h_crlf
    h_txt t_cl_pre
    h_u64 get g_respl 0
    h_crlf
    h_txt t_conn_close
    h_crlf
    h_crlf
    send_hdr_buf fd
    send_resp_buf fd
    ret
  end
  render_clip_editor
  send_resp_xsha fd 201 0 2
end

fn handle_clip_verify fd int to void
  if ne get g_rq_st RQ_BAD_HDR 0
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 false
    ret
  end
  if eq get g_rq_st RQ_HAS_CL 0
    r_reset
    r_txt t_411_body
    send_resp fd 411 2 false
    ret
  end
  clen = get g_rq_st RQ_CLEN
  if gt clen 16384
    r_reset
    r_txt t_413_body
    send_resp fd 413 2 false
    ret
  end
  if not read_small_body_vbuf fd get g_rq_st RQ_HEND clen
    r_reset
    r_txt t_400_body
    send_resp fd 400 2 false
    ret
  end
  ok = verify_submitted_spclip
  render_clip_verify_json ok
  if ok
    send_resp_xsha fd 200 4 2
  else
    send_resp fd 400 4 false
  end
end

fn route_get_head fd int p0 ulong p1 ulong head_only bool to void
  if req_range_eq p0 p1 t_rt_css
    r_reset
    r_txt t_css1
    r_txt t_css2
    r_txt t_css3
    send_resp fd 200 1 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_health
    r_reset
    r_txt t_ok_body
    send_resp fd 200 2 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_itsv
    render_index_tsv
    send_resp fd 200 3 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_ijson
    render_index_json
    send_resp fd 200 4 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_ktsv
    render_clips_tsv
    send_resp fd 200 3 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_kjson
    render_clips_json
    send_resp fd 200 4 head_only
    ret
  end
  if req_range_starts p0 p1 t_rt_pack_pre
    handle_pack_download fd p0 p1 head_only
    ret
  end
  if req_range_starts p0 p1 t_rt_clip_pre
    handle_clip_download fd p0 p1 head_only
    ret
  end
  if req_range_starts p0 p1 t_rt_strand_pre
    if not extract_hex64_bare p0 p1 len t_rt_strand_pre
      r_reset
      r_txt t_400_body
      send_resp fd 400 2 head_only
      ret
    end
    idx = find_strand_by_dpath
    if lt idx 0
      r_reset
      r_txt t_404_body
      send_resp fd 404 2 head_only
      ret
    end
    render_strand_detail ulong idx
    send_resp fd 200 0 head_only
    ret
  end
  if req_range_eq p0 p1 t_rt_clip
    reset_clip_edit
    render_clip_editor
    send_resp fd 200 0 head_only
    ret
  end
  if or req_range_eq p0 p1 t_rt_root or req_range_eq p0 p1 t_rt_root2 req_range_eq p0 p1 t_rt_slash
    render_home_page false
    send_resp fd 200 0 head_only
    ret
  end
  r_reset
  r_txt t_404_body
  send_resp fd 404 2 head_only
end

fn serve_conn fd int to void
  if not read_http_headers fd
    ret
  end
  if not parse_req_headers
    r_reset
    r_txt t_405_body
    send_resp fd 405 2 false
    ret
  end
  parse_query_string
  meth = get g_rq_st RQ_METH
  p0 = get g_rq_st RQ_P0
  p1 = get g_rq_st RQ_P1
  if eq meth 3
    if or req_range_eq p0 p1 t_rt_upload or req_range_eq p0 p1 t_rt_root req_range_eq p0 p1 t_rt_root2
      handle_strand_upload fd
      ret
    end
    if req_range_eq p0 p1 t_rt_clip
      handle_clip_post fd
      ret
    end
    if req_range_eq p0 p1 t_rt_clip_ver
      handle_clip_verify fd
      ret
    end
    r_reset
    r_txt t_404_body
    send_resp fd 404 2 false
    ret
  end
  route_get_head fd p0 p1 eq meth 2
end

note ---- CLI init, TCP listener, and main loop ----

fn parse_arg_u64 ai ulong defv ulong to ulong
  if le ulong argcnt ai
    ret defv
  end
  buf = new uchar 32 0
  k = argread ai buf 0 32
  if le k 0
    ret defv
  end
  v = ulong 0
  for i ulong ulong k bound 32
    c = get buf i
    if or lt c 48 gt c 57
      ret defv
    end
    v = add mul v 10 ulong sub c 48
  end
  if eq v 0
    ret defv
  end
  ret v
end

fn init_config to void
  put g_port 0 parse_arg_u64 2 HUB_DEF_PORT
  put g_max_up 0 parse_arg_u64 3 HUB_DEF_MAX_UP
  if gt argcnt 1
    k = argread 1 g_dir 0 511
    if gt k 0
      put g_dirl 0 ulong k
      ret
    end
  end
  for i ulong len t_def_dir bound 512
    put g_dir i get t_def_dir i
  end
  put g_dirl 0 len t_def_dir
end

fn make_listener to long
  fd = socknew 2 526337 0
  if lt fd 0
    ret fd
  end
  one = new uchar 4 0
  put one 0 1
  r = sockopt int fd 1 2 one 0 4
  port = get g_port 0
  a = new uchar 16 0
  put a 0 2
  put a 2 uchar and shr port 8 255
  put a 3 uchar and port 255
  put a 4 uchar and shr HUB_IP 24 255
  put a 5 uchar and shr HUB_IP 16 255
  put a 6 uchar and shr HUB_IP 8 255
  put a 7 uchar and HUB_IP 255
  if eq r 0
    r = bind int fd a 0 16
  end
  if eq r 0
    r = listen int fd 64
  end
  if ne r 0
    x = fclose int fd
    ret r
  end
  ret fd
end

fn log_startup ok bool to void
  r_reset
  if ok
    r_txt t_started
  else
    r_txt t_listen_err
  end
  r_u64 get g_port 0
  if ok
    r_txt t_dir_msg
    for i ulong get g_dirl 0 bound 512
      r_b get g_dir i
    end
  end
  r_txt t_nl
  x = write 2 g_resp 0 get g_respl 0
end

fn main to int
  init_config
  ensure_dirs
  load_catalog
  load_clips_catalog
  lfd = make_listener
  if lt lfd 0
    log_startup false
    ret 2
  end
  log_startup true
  for it ulong 4000000000 bound 4000000000
    w = waitio int lfd 1 1000000000
    if gt w 0
      cfd = accept int lfd 526336
      if ge cfd 0
        serve_conn int cfd
        x = fclose int cfd
      end
    end
  end
  ret 0
end

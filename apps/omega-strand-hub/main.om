  r_txt t_j_s1
  r_c_sha idx 64
  r_txt t_j_s2
  r_c_name_json idx
  r_txt t_j_s3
  r_c_auth_json idx
  r_txt t_j_s4
  r_c_lic_json idx
  r_txt t_j_s5
  r_c_term_json idx
  r_txt t_j_s6
  r_c_prov_json idx
  r_txt t_j_s7
  r_c_pt_raw idx
  r_txt t_j_s8
  r_hex16 get g_c_bhash idx
  r_txt t_j_s9
  r_u64 get g_c_bl idx
  r_txt t_j_s10
  r_u64 get g_c_sl idx
  r_txt t_j_s11
  r_u64 get g_c_npar idx
  r_txt t_j_s12
  r_hex16 get g_c_phash idx
  r_txt t_j_s13
  r_u64 get g_c_sz idx
  r_txt t_j_s14
  r_u64 get g_c_dl idx
  r_txt t_j_s15
  r_u64 get g_c_ts idx
  r_txt t_j_s16
  r_c_fn_json idx
  r_txt t_j_s17
  r_c_desc_json idx
  r_txt t_j_s18
  r_c_sha idx 64
  r_txt t_j_s19
end

fn render_index_json to void
  r_reset
  cnt = get g_scnt 0
  matched = ulong 0
  for i ulong cnt bound 512
    if strand_matches_filters i
      matched = add matched 1
    end
  end
  r_txt t_j_open
  r_u64 matched
  r_txt t_j_arr
  first = true
  for i ulong cnt bound 512
    if strand_matches_filters i
      if not first
        r_b 44
      end
      render_one_strand_json i
      first = false
    end
  end
  r_txt t_j_close
end


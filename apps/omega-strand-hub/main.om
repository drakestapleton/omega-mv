    r_jesc_b get g_c_fn add base i
  end
end

fn r_c_desc_esc idx ulong to void
  base = mul idx F_DESC
  n = get g_c_descl idx
  for i ulong n bound 256
    r_esc_b get g_c_desc add base i
  end
end

fn r_c_desc_raw idx ulong to void
  base = mul idx F_DESC
  n = get g_c_descl idx
  for i ulong n bound 256
    r_b get g_c_desc add base i

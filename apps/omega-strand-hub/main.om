text t_hero1 "<section class=\"hub-hero\"><div class=\"shell\"><span class=\"eyebrow\">Interplane &middot; Open-Source Strand Exchange &middot; OLLMSP01 &middot; Zero JS</span><h1>Share and combine <em>Helix Strands</em></h1><p class=\"lede\">A <strong>Helix Strand</strong> (<code>OLLMSP01</code>) is a portable, cryptographically verified skill layer&mdash;code, math, reasoning, or domain craft&mdash;that attaches to a frozen base model without overwriting it. Train one focused specialist, share it openly here, and snap 2 to 4 community strands together at inference time with <code>ollm spclip</code>.</p><div class=\"hub-cta\"><a class=\"hub-btn hub-btn-primary\" href=\"#catalog\">Browse verified strands</a><a class=\"hub-btn hub-btn-emerald\" href=\"/strands/clip\">Open Strand Clip Editor</a><a class=\"hub-btn\" href=\"#upload\">Publish a strand</a><a class=\"hub-btn\" href=\"#what-is-a-strand\">How strands work</a></div><div class=\"hub-kpis\"><div class=\"hub-kpi\"><span class=\"hub-kpi-k\">Verified Strands</span><span class=\"hub-kpi-v\">"
text t_hero2 "</span></div><div class=\"hub-kpi\"><span class=\"hub-kpi-k\">Compatible Trunks</span><span class=\"hub-kpi-v\">"
text t_hero3 "</span></div><div class=\"hub-kpi\"><span class=\"hub-kpi-k\">Saved Clip Recipes</span><span class=\"hub-kpi-v\">"
text t_hero4 "</span></div><div class=\"hub-kpi\"><span class=\"hub-kpi-k\">Total Downloads</span><span class=\"hub-kpi-v\">"
text t_hero5 "</span></div></div></div></section>\n"

text t_intro1 "<section class=\"hub-sec\" id=\"what-is-a-strand\"><div class=\"shell\"><div class=\"hub-sec-head\"><div><span class=\"eyebrow\">Why sharing strands is our main thing</span><h2>Sovereign Intelligence grows by sharing skills, not hoarding giant checkpoints</h2></div><a class=\"hub-btn hub-btn-sm\" href=\"/omega/helix/\">Read Omega Helix docs</a></div><div class=\"hub-grid3\"><article class=\"hub-story\"><h3>1. Keep your base intact</h3><p>Traditional fine-tuning mutates the whole model and causes catastrophic forgetting. A Helix Strand freezes the base trunk bit-for-bit and stores only the added specialist layers (~14 MB instead of 400+ MB).</p></article><article class=\"hub-story st-b\"><h3>2. Cryptographic Merkle proof</h3><p>Every <code>OLLMSP01</code> file carries its parent trunk hash (<code>base_hash</code>) and payload checksum (<code>pack_hash</code>). This hub verifies magic, lineage, finite weights, FNV-1a 64, and SHA-256 before storing a single byte.</p></article><article class=\"hub-story st-d\"><h3>3. Snap community skills together</h3><p>Download any 2 to 4 verified strands that share a base trunk, tune their blend weights in the <a href=\"/strands/clip\">Strand Clip Editor</a>, and fuse them live with <code>ollm spclip</code>&mdash;zero CUDA, zero retraining.</p></article></div>"

text t_intro2 "<div class=\"hub-flow\"><div class=\"hub-step\"><span class=\"hub-step-num\">Step 1 &middot; Forge</span><h3>Train one specialist layer</h3><p>Grow a frozen-core layer with <code>ollm growpro</code>, train on your domain with <code>trainfc</code>, and extract the portable delta with <code>ollm spext BASE.ck SPEC.ck skill.sp</code>.</p></div><div class=\"hub-step\"><span class=\"hub-step-num\">Step 2 &middot; Publish</span><h3>Fail-closed verification</h3><p>Upload your <code>.sp</code> below under an open-source license (<code>Apache-2.0</code>, <code>MIT</code>, <code>CC-BY-4.0</code>). Interplane verifies every header field and weight, then indexes it by SHA-256.</p></div><div class=\"hub-step\"><span class=\"hub-step-num\">Step 3 &middot; Clip</span><h3>Edit &amp; combine (S=2..4)</h3><p>Filter strands sharing your <code>base_hash</code>, download in one click, or open the <a href=\"/strands/clip\">Clip Editor</a> to emit a SHA-256-verified <code>.spclip</code> recipe and runnable <code>ollm spclip</code> command.</p></div></div>"

text t_intro3 "<details class=\"hub-details\"><summary>Technical anatomy: the 48-byte OLLMSP01 binary header verified on every upload</summary><div class=\"hub-details-body\"><p>Every uploaded strand must match the exact little-endian <code>OLLMSP01</code> wire layout used by <code>ollm spext</code> / <code>spapp</code> / <code>spclip</code>: bytes <code>0..7</code> magic <code>OLLMSP01</code>, <code>8..15</code> <code>base_L</code> (&ge;1), <code>16..23</code> <code>spec_L</code> (&gt;<code>base_L</code>), <code>24..31</code> Merkle parent <code>base_hash</code> (FNV-1a 64 over frozen base shapes &amp; weights), <code>32..39</code> <code>n_spec_params</code> (exact file length <code>48 + 8 * n_spec_params</code>), <code>40..47</code> payload <code>pack_hash</code> (FNV-1a 64), followed by finite IEEE-754 <code>f64</code> weights. Malformed, truncated, non-finite, or forged packs are rejected with HTTP 400 before touching storage.</p></div></details></div></section>\n"

text t_cat_open "<section class=\"hub-sec\" id=\"catalog\"><div class=\"shell\"><div class=\"hub-sec-head\"><div><span class=\"eyebrow\">Content-addressed &middot; SHA-256 verified</span><h2>Verified Strand Catalog</h2></div><div class=\"hub-badges\"><a class=\"hub-btn hub-btn-sm\" href=\"/strands/index.json\">index.json</a><a class=\"hub-btn hub-btn-sm\" href=\"/strands/index.tsv\">index.tsv</a><a class=\"hub-btn hub-btn-sm hub-btn-emerald\" href=\"/strands/clip\">Edit spclip</a></div></div>\n<form class=\"hub-filter\" method=\"GET\" action=\"/strands/#catalog\"><input class=\"hub-in hub-in-grow\" type=\"text\" name=\"trunk\" placeholder=\"Filter by compatible base trunk (16-hex base_hash or 64-hex parent_trunk SHA-256)\" value=\""
text t_cat_f2 "\"><button class=\"hub-btn hub-btn-primary hub-btn-sm\" type=\"submit\">Filter trunk</button><a class=\"hub-btn hub-btn-sm\" href=\"/strands/#catalog\">Show all</a></form>\n"

text t_up_open "<section class=\"hub-sec\" id=\"upload\"><div class=\"shell\"><div class=\"hub-sec-head\"><div><span class=\"eyebrow\">Open-source default &middot; Fail-closed gate</span><h2>Publish a Verified Helix Strand</h2></div><span class=\"hub-badge ok\">Max upload: "
text t_up_open2 " bytes</span></div>\n<form class=\"hub-card\" method=\"POST\" action=\"/strands/upload\" enctype=\"multipart/form-data\"><div class=\"hub-form-grid\"><div class=\"hub-fg full\"><label class=\"hub-lbl\" for=\"up-pack\">OLLMSP01 Specialist Pack (.sp)</label><input class=\"hub-in\" id=\"up-pack\" type=\"file\" name=\"pack\" accept=\".sp\" required><span class=\"hub-help\">Verified byte-for-byte before storage: magic, base_L &lt; spec_L, exact size, FNV-1a pack_hash, finite f64 weights, and FIPS 180-4 SHA-256.</span></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-name\">Strand Name</label><input class=\"hub-in\" id=\"up-name\" type=\"text\" name=\"name\" maxlength=\"80\" placeholder=\"om2-arith-specialist\" required></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-auth\">Author / Handle</label><input class=\"hub-in\" id=\"up-auth\" type=\"text\" name=\"author\" maxlength=\"64\" placeholder=\"drakestapleton\" required></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-lic\">Open-Source License (default)</label><select class=\"hub-sel\" id=\"up-lic\" name=\"license\"><option value=\"Apache-2.0\" selected>Apache-2.0 (Recommended)</option><option value=\"MIT\">MIT</option><option value=\"CC-BY-4.0\">CC-BY-4.0</option><option value=\"CC0-1.0\">CC0-1.0</option><option value=\"BSD-3-Clause\">BSD-3-Clause</option><option value=\"AGPL-3.0-only\">AGPL-3.0-only</option></select></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-pt\">Base Trunk SHA-256 / Parent Strand (optional)</label><input class=\"hub-in\" id=\"up-pt\" type=\"text\" name=\"parent_trunk\" maxlength=\"64\" placeholder=\"64-hex BASE.ck or parent strand SHA-256 (or 16-hex base_hash)\" value=\""
text t_up_mid "\"></div><div class=\"hub-fg full\"><label class=\"hub-lbl\" for=\"up-desc\">Plain-English Description</label><input class=\"hub-in\" id=\"up-desc\" type=\"text\" name=\"description\" maxlength=\"256\" placeholder=\"What skill does this strand add, and how was it verified?\"></div></div>"

text t_up_ext1 "<details class=\"hub-details\"><summary>Optional extensible metadata (sharing terms, provenance, expected SHA-256)</summary><div class=\"hub-details-body\"><div class=\"hub-form-grid\"><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-terms\">Sharing Terms</label><input class=\"hub-in\" id=\"up-terms\" type=\"text\" name=\"terms\" maxlength=\"128\" value=\"open-source\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"up-prov\">Provenance (repo commit, receipt, or spclip link)</label><input class=\"hub-in\" id=\"up-prov\" type=\"text\" name=\"provenance\" maxlength=\"160\" value=\""
text t_up_ext2 "\"></div><div class=\"hub-fg full\"><label class=\"hub-lbl\" for=\"up-exp\">Expected SHA-256 Pin (optional 64-hex integrity check)</label><input class=\"hub-in\" id=\"up-exp\" type=\"text\" name=\"expected_sha256\" maxlength=\"64\" placeholder=\"Optional 64-hex SHA-256 computed locally before upload\"></div></div></div></details><div class=\"hub-card-act\"><button class=\"hub-btn hub-btn-primary\" type=\"submit\">Verify &amp; Publish Strand</button></div></form>\n"

text t_api_sec "<div class=\"hub-details\"><summary>CLI &amp; Agent API (curl upload + deterministic catalogs)</summary><div class=\"hub-details-body\"><pre class=\"hub-code\"># Upload a verified OLLMSP01 pack via curl:\ncurl -F pack=@skill.sp -F name=my-skill -F author=alice -F license=Apache-2.0 \\\n     -F description=\"Specialist strand\" https://interplane.io/strands/upload\n\n# Query deterministic agent catalogs:\ncurl -s https://interplane.io/strands/index.tsv\ncurl -s https://interplane.io/strands/index.json\ncurl -s https://interplane.io/strands/clips/index.json</pre></div></div></div></section>\n"

text t_ue_1 "No OLLMSP01 pack file was included in the upload."
text t_ue_2 "Both strand name and author are required."
text t_ue_3 "Rejected unsafe filename (path traversal, slash, or disallowed characters detected)."
text t_ue_4 "Uploaded pack exceeds the server bounded size limit."
text t_ue_5 "Pack is truncated (shorter than the 48-byte OLLMSP01 header)."
text t_ue_6 "Invalid magic header (expected exact OLLMSP01 bytes)."
text t_ue_7 "Invalid layer lineage (requires base_L >= 1, spec_L > base_L, spec_L <= 1024)."
text t_ue_8 "Invalid Merkle parent base_hash (zero or empty FNV-1a basis)."
text t_ue_9 "Invalid n_spec_params count (zero or exceeds bounded pack capacity)."
text t_ue_10 "Exact byte size mismatch (file length must equal 48 + 8 * n_spec_params; truncated or trailing bytes refused)."
text t_ue_11 "Payload tamper detected: computed FNV-1a 64 does not match header pack_hash (ollm rc=61)."
text t_ue_12 "Non-finite IEEE-754 f64 weight (NaN or Infinity) detected in specialist payload."
text t_ue_13 "Malformed parent_trunk (must be empty, exact 16-hex base_hash, or 64-hex SHA-256)."
text t_ue_14 "Merkle parent mismatch: supplied 16-hex parent_trunk disagrees with OLLMSP01 header base_hash."
text t_ue_15 "Broken Merkle chain lineage: child base_L does not match parent strand spec_L."
text t_ue_16 "SHA-256 mismatch: computed digest does not match expected_sha256."
text t_ue_17 "Duplicate strand: an identical SHA-256 pack is already verified in the catalog."
text t_ue_18 "Catalog storage capacity reached."
text t_ue_19 "Internal storage I/O error."
text t_ue_20 "Malformed multipart/form-data upload framing."

text t_ce_1 "Select between 2 and 4 compatible verified strands to build a clip."
text t_ce_2 "One or more selected strand SHA-256 hashes were not found in the verified catalog."
text t_ce_3 "Incompatible parent trunks: all strands in a clip must share the exact same OLLMSP01 base_hash (and parent_trunk)."
text t_ce_4 "Invalid blend weights: every selected strand must have a non-zero milli-weight in -5000..5000 (strictly positive 1..5000 for MODE=1 Entropy Gate, and at least one positive weight for MODE=0 PoE)."
text t_ce_5 "Invalid fusion mode (must be 0 for Signed PoE or 1 for Entropy Gate)."
text t_ce_6 "Invalid temperature tau (must be 0..5000 milli-units)."
text t_ce_7 "Invalid splice layer (must be 1..min(base_L) across selected strands)."
text t_ce_8 "Invalid token count (must be 1..8192)."
text t_ce_9 "Manifest tamper detected: body_sha256 does not match canonical .spclip body."
text t_ce_10 "Malformed .spclip manifest (expected format=OMSPCLIP01 and trailing body_sha256)."
text t_ce_11 "Clip catalog storage capacity reached."
text t_ce_12 "Internal clip storage I/O error."

fn r_upload_err_msg code ulong to void
  if eq code UE_MISSING_PACK
    r_txt t_ue_1
    ret
  end
  if eq code UE_MISSING_META
    r_txt t_ue_2
    ret
  end
  if eq code UE_BAD_FILENAME
    r_txt t_ue_3
    ret
  end
  if eq code UE_TOO_BIG
    r_txt t_ue_4
    ret
  end
  if eq code UE_TRUNCATED
    r_txt t_ue_5
    ret
  end
  if eq code UE_BAD_MAGIC
    r_txt t_ue_6
    ret
  end
  if eq code UE_BAD_LAYERS
    r_txt t_ue_7
    ret
  end
  if eq code UE_BAD_BASE_HASH
    r_txt t_ue_8
    ret
  end
  if eq code UE_BAD_PARAMS
    r_txt t_ue_9
    ret
  end
  if eq code UE_SIZE_MISMATCH
    r_txt t_ue_10
    ret
  end
  if eq code UE_PACK_HASH
    r_txt t_ue_11
    ret
  end
  if eq code UE_NONFINITE
    r_txt t_ue_12
    ret
  end
  if eq code UE_BAD_PARENT_TRUNK
    r_txt t_ue_13
    ret
  end
  if eq code UE_MERKLE_MISMATCH
    r_txt t_ue_14
    ret
  end
  if eq code UE_MERKLE_LINEAGE
    r_txt t_ue_15
    ret
  end
  if eq code UE_SHA_MISMATCH
    r_txt t_ue_16
    ret
  end
  if eq code UE_DUPLICATE
    r_txt t_ue_17
    ret
  end
  if eq code UE_STORAGE_FULL
    r_txt t_ue_18
    ret
  end
  if eq code UE_IO_FAIL
    r_txt t_ue_19
    ret
  end
  r_txt t_ue_20
end

fn r_clip_err_msg code ulong to void
  if eq code CE_STRAND_COUNT
    r_txt t_ce_1
    ret
  end
  if eq code CE_UNKNOWN_STRAND
    r_txt t_ce_2
    ret
  end
  if eq code CE_INCOMPAT_TRUNK
    r_txt t_ce_3
    ret
  end
  if eq code CE_BAD_WEIGHT
    r_txt t_ce_4
    ret
  end
  if eq code CE_BAD_MODE
    r_txt t_ce_5
    ret
  end
  if eq code CE_BAD_TAU
    r_txt t_ce_6
    ret
  end
  if eq code CE_BAD_SPLICE
    r_txt t_ce_7
    ret
  end
  if eq code CE_BAD_TOKENS
    r_txt t_ce_8
    ret
  end
  if eq code CE_TAMPERED
    r_txt t_ce_9
    ret
  end
  if eq code CE_BAD_FORMAT
    r_txt t_ce_10
    ret
  end
  if eq code CE_STORAGE_FULL
    r_txt t_ce_11
    ret
  end
  r_txt t_ce_12
end

fn render_page_head title view uchar * nav_which ulong to void
  r_txt t_h_doc1
  r_txt title
  r_txt t_h_doc2
  if eq nav_which 1
    r_txt t_h_cur
  end
  r_txt t_h_doc3
  if eq nav_which 2
    r_txt t_h_cur
  end
  r_txt t_h_doc4
end

text t_bn_ok1 "<div class=\"shell\"><div class=\"hub-banner ok\"><h3>Verified &amp; Published: OLLMSP01 passed all cryptographic gates</h3><p>SHA-256: <code>"
text t_bn_ok2 "</code> &middot; Layers <code>L"
text t_bn_ok3 " &rarr; L"
text t_bn_ok4 "</code> &middot; Base trunk <code>"
text t_bn_ok5 "</code></p><div class=\"hub-card-act\"><a class=\"hub-btn hub-btn-sm hub-btn-primary\" href=\"/strands/strand/"
text t_bn_ok6 "\">Inspect receipt</a><a class=\"hub-btn hub-btn-sm\" href=\"/strands/pack/"
text t_bn_ok7 ".sp\">Download .sp</a><a class=\"hub-btn hub-btn-sm hub-btn-emerald\" href=\"/strands/clip?s1="
text t_bn_ok8 "\">Edit in Clip Studio</a></div></div></div>\n"
text t_bn_err1 "<div class=\"shell\"><div class=\"hub-banner err\"><h3>Upload Refused (Fail-Closed Gate &middot; Code "
text t_bn_err2 ")</h3><p>"
text t_bn_err3 "</p></div></div>\n"

fn render_upload_banner has_post bool to void
  if not has_post
    ret
  end
  ec = get g_u_st US_ERR
  if eq ec UE_OK
    r_txt t_bn_ok1
    r_u_sha_all
    r_txt t_bn_ok2
    r_u64 get g_u_st US_BL
    r_txt t_bn_ok3
    r_u64 get g_u_st US_SL
    r_txt t_bn_ok4
    r_hex16 get g_u_st US_BHASH
    r_txt t_bn_ok5
    r_u_sha_all
    r_txt t_bn_ok6
    r_u_sha_all
    r_txt t_bn_ok7
    r_u_sha_all
    r_txt t_bn_ok8
    ret
  end
  r_txt t_bn_err1
  r_u64 ec
  r_txt t_bn_err2
  r_upload_err_msg ec
  r_txt t_bn_err3
end


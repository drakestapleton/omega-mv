fn render_clip_slot slot ulong req bool to void
  num = add slot 1
  r_txt t_slot1
  r_u64 num
  r_txt t_slot2
  r_u64 num
  r_txt t_slot3
  r_u64 num
  r_txt t_slot4
  r_u64 num
  r_txt t_slot5
  render_strand_options slot req
  r_txt t_slot6
  r_u64 num
  r_txt t_slot7
  r_u64 num
  r_txt t_slot8
  r_u64 num
  r_txt t_slot9
  r_u64 num
  r_txt t_slot10
  r_i64 get g_e_sw slot
  r_txt t_slot11
end

text t_cp_open "<section class=\"hub-sec\"><div class=\"shell\"><div class=\"hub-pills\"><span class=\"hub-lbl\">Filter compatible strands by trunk:</span><a class=\"hub-pill\" href=\"/strands/clip\">All trunks</a>"
text t_cp_pa "<a class=\"hub-pill\" href=\"/strands/clip?trunk="
text t_cp_pb "\">"
text t_cp_pc "</a>"
text t_cp_close "</div>\n<form class=\"hub-card\" method=\"POST\" action=\"/strands/clip\"><h2>1. Choose 2&ndash;4 Compatible Strands &amp; Blend Weights</h2><p class=\"hub-help\">Order of slots 1&ndash;4 defines branch order. All selected strands must share the same OLLMSP01 <code>base_hash</code>. Use negative weights (e.g. <code>-500</code>) in MODE=0 PoE for Anti-DNA contrastive firewalls.</p>\n"
text t_cp_p2a "<h2>2. Edit Fusion Mode, Temperature, Splice Layer &amp; Fine-Tune Metadata</h2><div class=\"hub-form-grid\"><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-mode\">Fusion Mode</label><select class=\"hub-sel\" id=\"c-mode\" name=\"mode\"><option value=\"1\""
text t_cp_p2b ">MODE=1 &middot; Entropy-Gated Multi-Helix</option><option value=\"0\""
text t_cp_p2c ">MODE=0 &middot; Signed Product-of-Experts (PoE / Anti-DNA)</option></select></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-tau\">Temperature / Sharpness tau (milli, 0..5000)</label><input class=\"hub-in\" id=\"c-tau\" type=\"number\" name=\"tau\" min=\"0\" max=\"5000\" value=\""
text t_opt_msel " selected"
text t_cp_p3 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-sp\">Splice Layer (0 = auto min base_L)</label><input class=\"hub-in\" id=\"c-sp\" type=\"number\" name=\"splice_layer\" min=\"0\" max=\"1024\" value=\""
text t_cp_p4 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-tok\">Generate Tokens (N, 1..8192)</label><input class=\"hub-in\" id=\"c-tok\" type=\"number\" name=\"tokens\" min=\"1\" max=\"8192\" value=\""
text t_cp_p5 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-name\">Clip Name</label><input class=\"hub-in\" id=\"c-name\" type=\"text\" name=\"clip_name\" maxlength=\"80\" value=\""
text t_cp_p6 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-auth\">Author</label><input class=\"hub-in\" id=\"c-auth\" type=\"text\" name=\"author\" maxlength=\"64\" value=\""
text t_cp_p7 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-lic\">License</label><select class=\"hub-sel\" id=\"c-lic\" name=\"license\"><option value=\"Apache-2.0\" selected>Apache-2.0</option><option value=\"MIT\">MIT</option><option value=\"CC-BY-4.0\">CC-BY-4.0</option></select></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-seed\">Seed (ft_seed)</label><input class=\"hub-in\" id=\"c-seed\" type=\"number\" name=\"ft_seed\" min=\"0\" value=\""
text t_cp_p8 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-steps\">Optional Fine-Tune Steps (ft_steps)</label><input class=\"hub-in\" id=\"c-steps\" type=\"number\" name=\"ft_steps\" min=\"0\" max=\"1000000\" value=\""
text t_cp_p9 "\"></div><div class=\"hub-fg\"><label class=\"hub-lbl\" for=\"c-lr\">Fine-Tune LR micro-units (ft_lr_micro)</label><input class=\"hub-in\" id=\"c-lr\" type=\"number\" name=\"ft_lr_micro\" min=\"0\" max=\"1000000\" value=\""
text t_cp_p10 "\"></div><div class=\"hub-fg full\"><label class=\"hub-lbl\" for=\"c-pr\">Prompt</label><input class=\"hub-in\" id=\"c-pr\" type=\"text\" name=\"prompt\" maxlength=\"256\" value=\""
text t_cp_p11 "\"></div></div><div class=\"hub-card-act\"><button class=\"hub-btn hub-btn-primary\" type=\"submit\" name=\"action\" value=\"save\">Compose &amp; Verify .spclip Recipe</button><button class=\"hub-btn hub-btn-emerald\" type=\"submit\" name=\"action\" value=\"download\">Download .spclip Directly</button></div></form>\n"

text t_rc_open "</div></section><section class=\"hub-sec\"><div class=\"shell\"><div class=\"hub-sec-head\"><div><span class=\"eyebrow\">SHA-256 content-addressed</span><h2>Saved .spclip Recipes</h2></div></div><div class=\"hub-cards\">\n"
text t_rc_1 "<article class=\"hub-card\"><div class=\"hub-card-top\"><span class=\"hub-card-title\">"
text t_rc_2 "</span><div class=\"hub-badges\"><span class=\"hub-badge lic\">"
text t_rc_3 "</span><span class=\"hub-badge lay\">S="
text t_rc_4 " &middot; MODE="
text t_rc_5 "</span></div></div><div class=\"hub-meta\"><span>by "
text t_rc_6 "</span><span>trunk <code>"
text t_rc_7 "</code></span><span>tau="
text t_rc_8 "</span><span>splice=L"
text t_rc_9 "</span><span>sha256 <code>"
text t_rc_10 "&hellip;</code></span></div><div class=\"hub-card-act\"><a class=\"hub-btn hub-btn-primary hub-btn-sm\" href=\"/strands/clip/"
text t_rc_11 ".spclip\">Download .spclip</a><a class=\"hub-btn hub-btn-sm\" href=\"/strands/?parent_trunk="
text t_rc_12 "&amp;clip="
text t_rc_13 "#upload\">Upload child strand</a></div></article>\n"
text t_rc_close "</div></div></section>\n"

text t_sec_close "</div></section>\n"

fn render_saved_clips to void
  kc = get g_kcnt 0
  if eq kc 0
    r_txt t_sec_close
    ret
  end
  r_txt t_rc_open
  for i ulong kc bound 256
    idx = sub sub kc 1 i
    r_txt t_rc_1
    r_k_name_esc idx
    r_txt t_rc_2
    r_k_lic_esc idx
    r_txt t_rc_3
    r_u64 get g_k_sc idx
    r_txt t_rc_4
    r_u64 get g_k_mode idx
    r_txt t_rc_5
    r_k_auth_esc idx
    r_txt t_rc_6
    r_hex16 get g_k_bhash idx
    r_txt t_rc_7
    r_u64 get g_k_tau idx
    r_txt t_rc_8
    r_u64 get g_k_splice idx
    r_txt t_rc_9
    r_k_sha idx 16
    r_txt t_rc_10
    r_k_sha idx 64
    r_txt t_rc_11
    r_hex16 get g_k_bhash idx
    r_txt t_rc_12
    r_k_sha idx 64
    r_txt t_rc_13
  end
  r_txt t_rc_close
end

fn render_clip_editor to void
  r_reset
  render_page_head t_ttl_clip 2
  r_txt t_cl_hero
  render_clip_banner
  r_txt t_cp_open
  nt = collect_distinct_trunks
  for t ulong nt bound 64
    r_txt t_cp_pa
    r_hex16 get g_seen_tr t
    r_txt t_cp_pb
    r_hex16 get g_seen_tr t
    r_txt t_cp_pc
  end
  r_txt t_cp_close
  render_clip_slot 0 true
  render_clip_slot 1 true
  render_clip_slot 2 false
  render_clip_slot 3 false
  r_txt t_cp_p2a
  if ne get g_e_st ES_MODE 0
    r_txt t_opt_msel
  end
  r_txt t_cp_p2b
  if eq get g_e_st ES_MODE 0
    r_txt t_opt_msel
  end
  r_txt t_cp_p2c
  r_u64 get g_e_st ES_TAU
  r_txt t_cp_p3
  r_u64 get g_e_st ES_SPLICE
  r_txt t_cp_p4
  r_u64 get g_e_st ES_TOK
  r_txt t_cp_p5
  for i ulong get g_e_namel 0 bound 80
    r_esc_b get g_e_name i
  end
  r_txt t_cp_p6
  for i ulong get g_e_authl 0 bound 64
    r_esc_b get g_e_auth i
  end
  r_txt t_cp_p7
  r_u64 get g_e_st ES_SEED
  r_txt t_cp_p8
  r_u64 get g_e_st ES_STEPS
  r_txt t_cp_p9
  r_u64 get g_e_st ES_LR
  r_txt t_cp_p10
  for i ulong get g_e_promptl 0 bound 256
    r_esc_b get g_e_prompt i
  end
  r_txt t_cp_p11
  render_saved_clips
  r_txt t_h_foot
end


note omega-strand-hub/gate.om: pure seeded-Omega (om2) end-to-end verification gate
note Usage: ./strand-hub-gate <server_bin> <scratch_dir> <port> [real_sp_1] [real_sp_2]
om2

const GT_IP uint 2130706433
const GT_IO_TMO long 15000000000
const OSPMAG ulong 3544421225449933903
const FNV_OFF ulong 14695981039346656037
const FNV_PRM ulong 1099511628211

global g_srv uchar 512
global g_srvl ulong 1
global g_dir uchar 512
global g_dirl ulong 1
global g_port ulong 1
global g_rsp1 uchar 512
global g_rsp1l ulong 1
global g_rsp2 uchar 512
global g_rsp2l ulong 1
global g_pid int 1
global g_pass ulong 1
global g_fail ulong 1

global g_pk uchar 4096
global g_pkl ulong 1
global g_pkr ulong 1

global g_tx uchar 65536
global g_txl ulong 1
global g_rx uchar 262144
global g_rxl ulong 1
global g_rx_hend ulong 1
global g_rx_code ulong 1
global g_io uchar 65536

global g_pack uchar 32768
global g_packl ulong 1
global g_mp uchar 65536
global g_mpl ulong 1
global g_body uchar 16384
global g_bodyl ulong 1

global g_sha_a uchar 64
global g_sha_b uchar 64
global g_sha_c uchar 64
global g_sha_d uchar 64
global g_sha_r1 uchar 64
global g_sha_r2 uchar 64
global g_clip_sha uchar 64
global g_clip_man uchar 16384
global g_clip_manl ulong 1
global g_hdr_val uchar 128
global g_hdr_vall ulong 1
global g_orig_a uchar 1024
global g_orig_al ulong 1

note Independent FIPS 180-4 SHA-256 for oracle verification
global g_sh_k uint 64
global g_sh_h uint 8
global g_sh_w uint 64
global g_sh_v uint 8
global g_sh_buf uchar 64
global g_sh_len ulong 1
global g_sh_init ulong 1
global g_sh_hex uchar 64
global g_out uchar 2048
global g_outl ulong 1

text t_sha_k "1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298"

text t_devnull "/dev/null"
text t_usage "usage: strand-hub-gate <server_bin> <scratch_dir> <port> [real_sp1] [real_sp2]\n"
text t_pass_pre "PASS "
text t_fail_pre "FAIL "
text t_sum_pre "STRAND_HUB_GATE pass="
text t_sum_mid " fail="
text t_nl "\n"

text t_bnd "----OmStrandGateBnd99"
text t_http11 " HTTP/1.1"
text t_host_hdr "Host: 127.0.0.1"
text t_conn_hdr "Connection: close"
text t_cl_hdr "Content-Length: "
text t_ct_mp_hdr "Content-Type: multipart/form-data; boundary=----OmStrandGateBnd99"
text t_ct_form_hdr "Content-Type: application/x-www-form-urlencoded"
text t_ct_oct_hdr "Content-Type: application/octet-stream"

fn run_clip_tests to void
  ok = do_simple_req t_m_get_w t_p_clip
  chk and ok and eq get g_rx_code 0 200 not rx_body_contains t_s_script t_t22a

  note T22b: Compose 2-strand compatible clip (A + B)
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_p1
  ok = post_body_req t_p_clip t_ct_form_hdr
  has_k = rx_hdr_extract t_xksha_h
  if and has_k eq get g_hdr_vall 0 64
    for i ulong 64
      put g_clip_sha i get g_hdr_val i
    end
  end
  chk and ok and eq get g_rx_code 0 201 and has_k and rx_body_contains t_s_spclip_m1 and rx_body_contains t_s_w1200 rx_body_contains t_s_w800 t_t22b

  note T22c: Download .spclip manifest and verify via POST /strands/clip/verify
  ok = do_path_with_sha false t_p_clip_pre 2 2
  hend = get g_rx_hend 0
  mlen = sub get g_rxl 0 hend
  c1 = and ok and eq get g_rx_code 0 200 and rx_body_contains t_s_mf01 rx_body_contains t_s_bsha_k
  if and c1 le mlen 16384
    for i ulong mlen bound 16384
      put g_clip_man i get g_rx add hend i
    end
    put g_clip_manl 0 mlen
  end
  body_reset
  for i ulong get g_clip_manl 0 bound 16384
    body_b get g_clip_man i
  end
  ok2 = post_body_req t_p_cver t_ct_txt_hdr
  c2 = and ok2 and eq get g_rx_code 0 200 rx_body_contains t_s_vtrue
  ok3 = do_simple_req t_m_get_w t_p_kjson
  c3 = and ok3 and eq get g_rx_code 0 200 rx_body_contains t_s_c1
  chk and c1 and c2 c3 t_t22c

  note T23: Anti-DNA signed PoE clip (MODE=0, w1=1000, w2=-500) direct download + verify
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_p2
  ok = post_body_req t_p_clip t_ct_form_hdr
  hend = get g_rx_hend 0
  mlen = sub get g_rxl 0 hend
  c1 = and ok and eq get g_rx_code 0 200 and rx_body_contains t_s_m0 rx_body_contains t_s_wneg
  body_reset
  if le mlen 16384
    for i ulong mlen bound 16384
      body_b get g_rx add hend i
    end
  end
  ok2 = post_body_req t_p_cver t_ct_txt_hdr
  chk and c1 and ok2 and eq get g_rx_code 0 200 rx_body_contains t_s_vtrue t_t23
end

fn run_clip_neg_tests to void
  note T24: NEGATIVE CONTROL - Incompatible parent trunks (Strand A + Strand C) -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 3
  body_txt t_cf_incompat
  ok = post_body_req t_p_clip t_ct_form_hdr
  chk and ok and eq get g_rx_code 0 400 rx_body_contains t_s_c3 t_t24

  note T25a: NEGATIVE CONTROL - Zero weight w2=0 -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_w0
  ok = post_body_req t_p_clip t_ct_form_hdr
  chk and ok and eq get g_rx_code 0 400 rx_body_contains t_s_c4_err t_t25a

  note T25b: NEGATIVE CONTROL - Negative weight in MODE=1 Entropy Gate -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_wneg_m1
  ok = post_body_req t_p_clip t_ct_form_hdr
  chk and ok and eq get g_rx_code 0 400 rx_body_contains t_s_c4_err t_t25b

  note T25c: NEGATIVE CONTROL - All-negative weights in MODE=0 PoE -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_wall_neg
  ok = post_body_req t_p_clip t_ct_form_hdr
  chk and ok and eq get g_rx_code 0 400 rx_body_contains t_s_c4_err t_t25c

  note T26a: NEGATIVE CONTROL - Single strand S=1 -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s1only
  ok = post_body_req t_p_clip t_ct_form_hdr
  chk and ok eq get g_rx_code 0 400 t_t26a

  note T26b: NEGATIVE CONTROL - Invalid mode=9 and splice_layer=99 -> 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_badmode
  ok1 = post_body_req t_p_clip t_ct_form_hdr
  c1 = and ok1 eq get g_rx_code 0 400
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_sha 2
  body_txt t_cf_badsplice
  ok2 = post_body_req t_p_clip t_ct_form_hdr
  c2 = and ok2 eq get g_rx_code 0 400
  chk and c1 c2 t_t26b

  note T27: NEGATIVE CONTROL - 1-byte tampered .spclip manifest -> 400 error_code=9
  body_reset
  ml = get g_clip_manl 0
  for i ulong ml bound 16384
    c = get g_clip_man i
    if eq i 25
      c = xor c 1
    end
    body_b c
  end
  ok = post_body_req t_p_cver t_ct_txt_hdr
  chk and ok and eq get g_rx_code 0 400 and rx_body_contains t_s_vfalse rx_body_contains t_s_ec9 t_t27
end

note ---- Phase B: Restart persistence + Optional real 14MB GB10 .sp streaming test ----

text t_xh_n1 "X-Strand-Name: gb10-real-arith"
text t_xh_n2 "X-Strand-Name: gb10-real-fold"
text t_xh_au "X-Strand-Author: spark-gb10"
text t_xh_lic "X-Strand-License: Apache-2.0"
text t_xh_fn1 "X-Strand-Filename: S1_arith.sp"
text t_xh_fn2 "X-Strand-Filename: S2_fold.sp"
text t_xh_d1 "X-Strand-Description: Real GB10-trained OLLMSP01 specialist pack"

fn stream_upload_real_file which ulong to bool
  ffd = long -1
  if eq which 1
    ffd = fopen g_rsp1 0 get g_rsp1l 0 0 0
  else
    ffd = fopen g_rsp2 0 get g_rsp2l 0 0 0
  end
  if lt ffd 0
    ret false
  end
  fsz = fseek int ffd 0 2
  if le fsz 48
    x = fclose int ffd
    ret false
  end
  x = fseek int ffd 0 0
  sha_start
  fd = connect_hub
  if lt fd 0
    x = fclose int ffd
    ret false
  end
  tx_reset
  tx_txt t_m_post_w
  tx_b 32
  tx_txt t_rt_up
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt t_ct_oct_hdr
  tx_crlf
  if eq which 1
    tx_txt t_xh_n1
    tx_crlf
    tx_txt t_xh_fn1
    tx_crlf
  else
    tx_txt t_xh_n2
    tx_crlf
    tx_txt t_xh_fn2
    tx_crlf
  end
  tx_txt t_xh_au
  tx_crlf
  tx_txt t_xh_lic
  tx_crlf
  tx_txt t_xh_d1
  tx_crlf
  tx_txt t_cl_hdr
  tx_u64 ulong fsz
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  ok = send_all_tx fd
  done = ulong 0
  tot = ulong fsz
  while and ok lt done tot bound 50000
    r = read int ffd g_io 0 65536
    if le r 0
      ok = false
      break
    end
    for i ulong ulong r bound 65536
      sha_b get g_io i
    end
    p = ulong 0
    while lt p ulong r bound 20000
      w = send fd g_io p sub ulong r p 16384
      if le w 0
        if eq w -4
          continue
        end
        ok = false
        break
      end
      p = add p ulong w
    end
    done = add done ulong r
  end
  x = fclose int ffd
  sha_finish
  if ok
    ok = read_rx_all fd
  end
  x = fclose fd
  if not ok
    ret false
  end
  if ne get g_rx_code 0 201
    ret false
  end
  if not rx_hdr_extract t_xsha_h
    ret false
  end
  if not hdr_eq_sha_hex
    ret false
  end
  for i ulong 64
    if eq which 1
      put g_sha_r1 i get g_sh_hex i
    else
      put g_sha_r2 i get g_sh_hex i
    end
  end
  ret true
end

fn stream_verify_download_real1 to bool
  fd = connect_hub
  if lt fd 0
    ret false
  end
  tx_reset
  tx_txt t_m_get_w
  tx_b 32
  tx_txt t_p_pack_pre
  for i ulong 64
    tx_b get g_sha_r1 i
  end
  tx_txt t_suf_sp
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  if not send_all_tx fd
    x = fclose fd
    ret false
  end
  put g_rxl 0 0
  hend = ulong 0
  sha_start
  tot_body = ulong 0
  for it ulong 200000 bound 200000
    r = recv fd g_io 0 65536 0
    if lt r 0
      if eq r -4
        continue
      end
      break
    end
    if eq r 0
      break
    end
    if eq hend 0
      for i ulong ulong r bound 65536
        rn = get g_rxl 0
        if lt rn 262144
          put g_rx rn get g_io i
          put g_rxl 0 add rn 1
        end
      end
      parse_rx_meta
      hend = get g_rx_hend 0
      if gt hend 0
        rn = get g_rxl 0
        if gt rn hend
          for i ulong sub rn hend bound 262144
            sha_b get g_rx add hend i
          end
          tot_body = add tot_body sub rn hend
        end
      end
    else
      for i ulong ulong r bound 65536
        sha_b get g_io i
      end
      tot_body = add tot_body ulong r
    end
  end
  x = fclose fd
  sha_finish
  if or ne get g_rx_code 0 200 eq tot_body 0
    ret false
  end
  for i ulong 64
    if ne get g_sh_hex i get g_sha_r1 i
      ret false
    end
  end
  ret true
end

fn run_phase_b to void
  stop_server
  if not start_server 33554432
    chk false t_t28
    ret
  end
  ok1 = do_simple_req t_m_get_w t_p_ijson
  c1 = and ok1 and eq get g_rx_code 0 200 and rx_body_contains t_s_c4 rx_body_contains t_s_dl1
  ok2 = do_simple_req t_m_get_w t_p_kjson
  c2 = and ok2 and eq get g_rx_code 0 200 rx_body_contains t_s_c2
  chk and c1 c2 t_t28

  if gt get g_rsp1l 0 0
    ok_u1 = stream_upload_real_file 1
    chk ok_u1 t_t29a
    ok_d1 = false
    if ok_u1
      ok_d1 = stream_verify_download_real1
    end
    chk ok_d1 t_t29b
    if and ok_u1 gt get g_rsp2l 0 0
      ok_u2 = stream_upload_real_file 2
      ok_clip = false
      if ok_u2
        body_reset
        body_txt t_cf_s1
        body_sha 4
        body_txt t_cf_s2
        body_sha 5
        body_txt t_cf_p1
        if post_body_req t_p_clip t_ct_form_hdr
          if eq get g_rx_code 0 201
            ok_clip = true
          end
        end
      end
      chk ok_clip t_t29c
    end
  end
end

fn run_xss_test to void
  note T30: XSS and JSON/TSV injection escaping on metadata
  build_valid_pack 8 9 0x0e513f7522e2689a 16 777
  mp_reset
  mp_field t_k_name t_v_xss_n
  mp_field t_k_auth t_v_au
  mp_field t_k_desc t_v_xss_d
  mp_pack_part t_v_fn_xss
  ok_up = post_mp_upload
  c_up = and ok_up eq get g_rx_code 0 201
  ok_hm = do_simple_req t_m_get_w t_p_home
  c_hm = and ok_hm and rx_body_contains t_s_esc_lt not rx_body_contains t_s_script
  ok_js = do_simple_req t_m_get_w t_p_ijson
  c_js = and ok_js and eq get g_rx_code 0 200 rx_body_contains t_s_jesc_q
  chk and c_up and c_hm c_js t_t30
end

fn run_trihelix_test to void
  note T31: 3-strand clip with non-contiguous slots (s1, empty s2 with w2=0, s3, s4) -> S=3 verify
  body_reset
  body_txt t_cf_s1
  body_sha 1
  body_txt t_cf_s2
  body_txt t_cf_s3
  body_sha 2
  body_txt t_cf_s4
  body_sha 1
  body_txt t_cf_p3
  ok_c3 = post_body_req t_p_clip t_ct_form_hdr
  hend = get g_rx_hend 0
  mlen = sub get g_rxl 0 hend
  c_c3 = and ok_c3 and eq get g_rx_code 0 200 rx_body_contains t_s_sc3
  body_reset
  if le mlen 16384
    for i ulong mlen bound 16384
      body_b get g_rx add hend i
    end
  end
  ok_v3 = post_body_req t_p_cver t_ct_txt_hdr
  chk and c_c3 and ok_v3 and eq get g_rx_code 0 200 rx_body_contains t_s_vtrue t_t31
end

fn parse_port_arg to ulong
  buf = new uchar 32 0
  k = argread 3 buf 0 32
  if le k 0
    ret 18499
  end
  v = ulong 0
  for i ulong ulong k bound 32
    c = get buf i
    if or lt c 48 gt c 57
      ret 18499
    end
    v = add mul v 10 ulong sub c 48
  end
  ret v
end

fn main to int
  if lt argcnt 4
    x = write 2 t_usage 0 len t_usage
    ret 2
  end
  k1 = argread 1 g_srv 0 511
  k2 = argread 2 g_dir 0 511
  if or le k1 0 le k2 0
    ret 2
  end
  put g_srvl 0 ulong k1
  put g_dirl 0 ulong k2
  put g_port 0 parse_port_arg
  put g_rsp1l 0 0
  put g_rsp2l 0 0
  if ge argcnt 5
    k4 = argread 4 g_rsp1 0 511
    if gt k4 0
      put g_rsp1l 0 ulong k4
    end
  end
  if ge argcnt 6
    k5 = argread 5 g_rsp2 0 511
    if gt k5 0
      put g_rsp2l 0 ulong k5
    end
  end
  if not start_server 16384
    ret 3
  end
  run_basics_and_uploads
  run_catalog_and_download
  run_neg_upload_controls_1
  run_neg_upload_controls_2
  run_clip_tests
  run_clip_neg_tests
  run_phase_b
  run_xss_test
  run_trihelix_test
  stop_server
  o_reset
  o_txt t_sum_pre
  o_u64 get g_pass 0
  o_txt t_sum_mid
  o_u64 get g_fail 0
  o_txt t_nl
  o_flush
  if gt get g_fail 0 0
    ret 1
  end
  ret 0
end

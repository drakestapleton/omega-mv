fn verify_count_still_4 to bool
  if not do_simple_req t_m_get_w t_p_ijson
    ret false
  end
  ret and eq get g_rx_code 0 200 rx_body_contains t_s_c4
end

fn run_basics_and_uploads to void
  ok = do_simple_req t_m_get_w t_p_health
  chk and ok and eq get g_rx_code 0 200 rx_body_contains t_s_ok t_t01

  ok = do_simple_req t_m_get_w t_p_css
  chk and ok and eq get g_rx_code 0 200 and rx_body_contains t_s_css not rx_body_contains t_s_script t_t02

  ok = do_simple_req t_m_get_w t_p_home
  chk and ok and eq get g_rx_code 0 200 and rx_body_contains t_s_hero and rx_body_contains t_s_magic not rx_body_contains t_s_script t_t03

  ok1 = do_simple_req t_m_get_w t_p_ijson
  c1 = and ok1 and eq get g_rx_code 0 200 rx_body_contains t_s_c0
  ok2 = do_simple_req t_m_get_w t_p_itsv
  c2 = and ok2 eq get g_rx_code 0 200
  chk and c1 c2 t_t04

  note T05: Strand A on trunk 0x0e513f7522e2689a, L8->L9, 32 params (304 bytes)
  build_valid_pack 8 9 0x0e513f7522e2689a 32 100
  for i ulong get g_packl 0 bound 1024
    put g_orig_a i get g_pack i
  end
  put g_orig_al 0 get g_packl 0
  sha_pack
  for i ulong 64
    put g_sha_a i get g_sh_hex i
  end
  mp_reset
  mp_field t_k_name t_v_na
  mp_field t_k_auth t_v_au
  mp_field t_k_lic t_v_l_ap
  mp_field t_k_desc t_v_d1
  mp_field t_k_pt t_v_pt_ck
  mp_field t_k_prov t_v_prov1
  mp_field_sha t_k_exp 0
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  h1 = and rx_hdr_extract t_xsha_h hdr_eq_sha_hex
  h2 = and rx_hdr_extract t_xbh_h hdr_eq_txt t_v_bh_a
  chk and ok and eq get g_rx_code 0 201 and h1 h2 t_t05

  note T06: Strand B on SAME trunk 0x0e513f7522e2689a, L8->L10, 48 params
  build_valid_pack 8 10 0x0e513f7522e2689a 48 200
  sha_pack
  for i ulong 64
    put g_sha_b i get g_sh_hex i
  end
  mp_reset
  mp_field t_k_name t_v_nb
  mp_field t_k_auth t_v_au2
  mp_field t_k_lic t_v_l_mit
  mp_field t_k_desc t_v_d2
  mp_field t_k_pt t_v_pt_ck
  mp_pack_part t_v_fn_b
  ok = post_mp_upload
  h1 = and rx_hdr_extract t_xsha_h hdr_eq_sha_hex
  chk and ok and eq get g_rx_code 0 201 h1 t_t06

  note T07: Strand C on DIFFERENT trunk 0x1122334455667788, L4->L5, 16 params
  build_valid_pack 4 5 0x1122334455667788 16 300
  sha_pack
  for i ulong 64
    put g_sha_c i get g_sh_hex i
  end
  mp_reset
  mp_field t_k_name t_v_nc
  mp_field t_k_auth t_v_au2
  mp_field t_k_lic t_v_l_cc
  mp_field t_k_desc t_v_d3
  mp_pack_part t_v_fn_c
  ok = post_mp_upload
  h1 = and rx_hdr_extract t_xsha_h hdr_eq_sha_hex
  chk and ok and eq get g_rx_code 0 201 h1 t_t07

  note T08: Merkle child Strand D (L9->L10) chained onto Strand A (spec_L=9)
  build_valid_pack 9 10 0x9988776655443322 20 400
  sha_pack
  for i ulong 64
    put g_sha_d i get g_sh_hex i
  end
  mp_reset
  mp_field t_k_name t_v_nd
  mp_field t_k_auth t_v_au
  mp_field t_k_lic t_v_l_ap
  mp_field t_k_desc t_v_d4
  mp_field_sha t_k_pt 1
  mp_pack_part t_v_fn_d
  ok = post_mp_upload
  h1 = and rx_hdr_extract t_xsha_h hdr_eq_sha_hex
  chk and ok and eq get g_rx_code 0 201 h1 t_t08
end

fn run_download_parity to void
  ok = do_path_with_sha false t_p_pack_pre 1 1
  hend = get g_rx_hend 0
  blen = sub get g_rxl 0 hend
  eq_bytes = and ok and eq get g_rx_code 0 200 eq blen get g_orig_al 0
  if eq_bytes
    for i ulong blen bound 1024
      if ne get g_rx add hend i get g_orig_a i
        eq_bytes = false
        break
      end
    end
  end
  ok2 = do_simple_req t_m_get_w t_p_ijson_tr
  chk and eq_bytes and ok2 rx_body_contains t_s_dl1 t_t09c
end

fn run_catalog_and_download to void
  ok1 = verify_count_still_4
  ok2 = do_simple_req t_m_get_w t_p_ijson_tr
  c2 = and ok2 and eq get g_rx_code 0 200 rx_body_contains t_s_c2
  chk and ok1 c2 t_t09a

  ok1 = do_path_with_sha false t_p_strand_pre 1 0
  c1 = and ok1 and eq get g_rx_code 0 200 rx_body_contains t_s_spclip_cmd
  ok2 = do_path_with_sha true t_p_pack_pre 1 1
  c2 = and ok2 eq get g_rx_code 0 200
  ok3 = do_simple_req t_m_get_w t_p_ijson_tr
  c3 = and ok3 rx_body_contains t_s_dl0
  chk and c1 and c2 c3 t_t09b
  run_download_parity
end

fn run_neg_upload_controls_1 to void
  note T10: Duplicate SHA-256 -> 409 Conflict
  build_valid_pack 8 9 0x0e513f7522e2689a 32 100
  mp_reset
  mp_field t_k_name t_v_na
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 409 verify_count_still_4 t_t10

  note T11: Forged magic -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 501
  put g_pack 0 88
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t11

  note T12: Truncated header (32 bytes) -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 502
  put g_packl 0 32
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t12

  note T13: Truncated payload (8 bytes short) -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 503
  put g_packl 0 sub get g_packl 0 8
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t13

  note T14: Trailing garbage byte (+1 byte) -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 504
  pl = get g_packl 0
  put g_pack pl 99
  put g_packl 0 add pl 1
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t14

  note T15: 1-bit payload tamper (FNV-1a pack_hash mismatch) -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 505
  put g_pack 48 xor get g_pack 48 1
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t15

  note T16: Non-finite NaN f64 weight (with valid recomputed FNV-1a!) -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 506
  put_u64_le_pack 48 0x7ff8000000000000
  recompute_pack_fnv
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t16
end


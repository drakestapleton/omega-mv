fn run_neg_upload_controls_2 to void
  note T17a: 16-hex parent_trunk disagrees with binary base_hash -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 507
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_field t_k_pt t_v_bh_wrong
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t17a

  note T17b: 64-hex parent_trunk = Strand A (spec_L=9) but child has base_L=7 -> 400
  build_valid_pack 7 8 0x554433221100aabb 16 508
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_field_sha t_k_pt 1
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t17b

  note T18: expected_sha256 mismatch -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 509
  sha_pack
  if eq get g_sh_hex 0 97
    put g_sh_hex 0 98
  else
    put g_sh_hex 0 97
  end
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_field_sha t_k_exp 0
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t18

  note T19a: Path-traversal upload filename ../../../etc/passwd -> 400
  build_valid_pack 8 9 0x0e513f7522e2689a 16 510
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_evil
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 400 verify_count_still_4 t_t19a

  note T19b: Path-traversal download URL -> 400
  ok = do_simple_req t_m_get_w t_p_bad_trav
  chk and ok eq get g_rx_code 0 400 t_t19b

  note T20a: Oversized pack (2500 params = 20048 bytes > 16384 Phase-A cap) -> 413
  build_valid_pack 8 9 0x0e513f7522e2689a 2500 511
  mp_reset
  mp_field t_k_name t_v_nbad
  mp_field t_k_auth t_v_au
  mp_pack_part t_v_fn_a
  ok = post_mp_upload
  chk and ok and eq get g_rx_code 0 413 verify_count_still_4 t_t20a

  note T20b: Oversized Content-Length header rejected immediately -> 413
  fd = connect_hub
  ok = false
  if ge fd 0
    tx_reset
    tx_txt t_m_post_w
    tx_b 32
    tx_txt t_rt_up
    tx_txt t_http11
    tx_crlf
    tx_txt t_host_hdr
    tx_crlf
    tx_txt t_ct_mp_hdr
    tx_crlf
    tx_txt t_fake_big_cl
    tx_crlf
    tx_txt t_conn_hdr
    tx_crlf
    tx_crlf
    ok = send_all_tx fd
    if ok
      ok = read_rx_all fd
    end
    x = fclose fd
  end
  chk and ok eq get g_rx_code 0 413 t_t20b

  note T21a: Missing Content-Length on POST -> 411
  fd = connect_hub
  ok = false
  if ge fd 0
    tx_reset
    tx_txt t_m_post_w
    tx_b 32
    tx_txt t_rt_up
    tx_txt t_http11
    tx_crlf
    tx_txt t_host_hdr
    tx_crlf
    tx_txt t_ct_mp_hdr
    tx_crlf
    tx_txt t_conn_hdr
    tx_crlf
    tx_crlf
    ok = send_all_tx fd
    if ok
      ok = read_rx_all fd
    end
    x = fclose fd
  end
  chk and ok eq get g_rx_code 0 411 t_t21a

  note T21b: Transfer-Encoding chunked smuggling refused -> 400
  fd = connect_hub
  ok = false
  if ge fd 0
    tx_reset
    tx_txt t_m_post_w
    tx_b 32
    tx_txt t_rt_up
    tx_txt t_http11
    tx_crlf
    tx_txt t_host_hdr
    tx_crlf
    tx_txt t_ct_mp_hdr
    tx_crlf
    tx_txt t_te_hdr
    tx_crlf
    tx_txt t_cl_hdr
    tx_u64 10
    tx_crlf
    tx_txt t_conn_hdr
    tx_crlf
    tx_crlf
    ok = send_all_tx fd
    if ok
      ok = read_rx_all fd
    end
    x = fclose fd
  end
  chk and ok eq get g_rx_code 0 400 t_t21b
end


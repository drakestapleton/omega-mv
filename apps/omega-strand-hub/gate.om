note ---- Output / logging helpers ----

fn o_reset to void
  put g_outl 0 0
end

fn o_b c uchar to void
  n = get g_outl 0
  if lt n 2048
    put g_out n c
    put g_outl 0 add n 1
  end
end

fn o_txt t view uchar * to void
  for i ulong len t bound 512
    o_b get t i
  end
end

fn o_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    o_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    o_b get buf p
    p = add p 1
  end
end

fn o_flush to void
  n = get g_outl 0
  if gt n 0
    x = write 1 g_out 0 n
    put g_outl 0 0
  end
end

fn chk ok bool name view uchar * to void
  o_reset
  if ok
    put g_pass 0 add get g_pass 0 1
    o_txt t_pass_pre
  else
    put g_fail 0 add get g_fail 0 1
    o_txt t_fail_pre
  end
  o_txt name
  o_b 10
  o_flush
end

note ---- Byte/hex/SHA-256 oracle ----

fn to_low c uchar to uchar
  if ge c 65
    if le c 90
      ret add c 32
    end
  end
  ret c
end

fn hex_ch v ulong to uchar
  d = and v 15
  if lt d 10
    ret uchar add 48 d
  end
  ret uchar add 87 d
end

fn sha_init_k to void
  if ne get g_sh_init 0 0
    ret
  end
  put g_sh_init 0 1
  p = ulong 0
  for i ulong 64
    v = ulong 0
    while lt p len t_sha_k bound 8
      if ge get t_sha_k p 48
        break
      end
      p = add p 1
    end
    while lt p len t_sha_k bound 16
      c = get t_sha_k p
      if lt c 48
        break
      end
      v = add mul v 10 ulong sub c 48
      p = add p 1
    end
    put g_sh_k i uint v
  end
end

fn sha_start to void
  sha_init_k
  put g_sh_h 0 0x6a09e667
  put g_sh_h 1 0xbb67ae85
  put g_sh_h 2 0x3c6ef372
  put g_sh_h 3 0xa54ff53a
  put g_sh_h 4 0x510e527f
  put g_sh_h 5 0x9b05688c
  put g_sh_h 6 0x1f83d9ab
  put g_sh_h 7 0x5be0cd19
  put g_sh_len 0 0
end

fn sha_s0 a uint to uint
  ret xor xor rotr a 2 rotr a 13 rotr a 22
end

fn sha_s1 e uint to uint
  ret xor xor rotr e 6 rotr e 11 rotr e 25
end

fn sha_g0 x uint to uint
  ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn sha_g1 x uint to uint
  ret xor xor rotr x 17 rotr x 19 shr x 10
end

fn sha_rnd i ulong to void
  e = get g_sh_v 4
  t1 = add get g_sh_v 7 sha_s1 e
  t1 = add t1 xor and e get g_sh_v 5 and not e get g_sh_v 6
  t1 = add t1 add get g_sh_k i get g_sh_w i
  a = get g_sh_v 0
  b = get g_sh_v 1
  c = get g_sh_v 2
  t2 = add sha_s0 a xor xor and a b and a c and b c
  put g_sh_v 7 get g_sh_v 6
  put g_sh_v 6 get g_sh_v 5
  put g_sh_v 5 e
  put g_sh_v 4 add get g_sh_v 3 t1
  put g_sh_v 3 c
  put g_sh_v 2 b
  put g_sh_v 1 a
  put g_sh_v 0 add t1 t2
end

fn sha_compress to void
  for t ulong 16
    q = mul t 4
    w = shl uint get g_sh_buf q 24
    w = or w shl uint get g_sh_buf add q 1 16
    w = or w shl uint get g_sh_buf add q 2 8
    w = or w uint get g_sh_buf add q 3
    put g_sh_w t w
  end
  for t ulong 48
    u = add t 16
    x = add sha_g1 get g_sh_w sub u 2 get g_sh_w sub u 7
    put g_sh_w u add x add sha_g0 get g_sh_w sub u 15 get g_sh_w sub u 16
  end
  for j ulong 8
    put g_sh_v j get g_sh_h j
  end
  for i ulong 64
    sha_rnd i
  end
  for j ulong 8
    put g_sh_h j add get g_sh_h j get g_sh_v j
  end
end

fn sha_b c uchar to void
  n = get g_sh_len 0
  bi = and n 63
  put g_sh_buf bi c
  put g_sh_len 0 add n 1
  if eq bi 63
    sha_compress
  end
end

fn sha_finish to void
  tot = get g_sh_len 0
  bits = shl tot 3
  sha_b 128
  while ne and get g_sh_len 0 63 56 bound 64
    sha_b 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    sha_b uchar and shr bits sh 255
  end
  for j ulong 8
    v = ulong get g_sh_h j
    for q ulong 4
      sh = mul sub 3 q 8
      b = uchar and shr v sh 255
      hi = mul add mul j 4 q 2
      put g_sh_hex hi hex_ch shr ulong b 4
      put g_sh_hex add hi 1 hex_ch ulong b
    end
  end
end

fn sha_pack to void
  sha_start
  n = get g_packl 0
  for i ulong n bound 32768
    sha_b get g_pack i
  end
  sha_finish
end

note ---- Valid OLLMSP01 pack builder ----

fn put_u64_le_pack off ulong v ulong to void
  for i ulong 8
    put g_pack add off i uchar and shr v mul i 8 255
  end
end

fn build_valid_pack bl ulong sl ulong bh ulong npar ulong seed ulong to void
  put_u64_le_pack 0 OSPMAG
  put_u64_le_pack 8 bl
  put_u64_le_pack 16 sl
  put_u64_le_pack 24 bh
  put_u64_le_pack 32 npar
  for i ulong npar bound 4000
    f = mul 0.001f64 f64 add add seed mul i 7 1
    put_u64_le_pack add 48 mul i 8 bitcast ulong f
  end
  put g_packl 0 add 48 mul npar 8
  recompute_pack_fnv
end

fn recompute_pack_fnv to void
  n = get g_packl 0
  fnv = FNV_OFF
  if gt n 48
    for i ulong sub n 48 bound 32768
      fnv = mul xor fnv ulong get g_pack add 48 i FNV_PRM
    end
  end
  put_u64_le_pack 40 fnv
end

note ---- Child server process launcher & reaper ----

fn pk_reset to void
  put g_pk 0 0
  put g_pk 1 0
  put g_pkl 0 2
end

fn pk_open to void
  n = get g_pkl 0
  put g_pkr 0 n
  put g_pk n 0
  put g_pk add n 1 0
  put g_pkl 0 add n 2
  c = add or ulong get g_pk 0 shl ulong get g_pk 1 8 1
  put g_pk 0 uchar and c 255
  put g_pk 1 uchar shr c 8
end

fn pk_b c uchar to void
  n = get g_pkl 0
  if lt n 4094
    put g_pk n c
    put g_pkl 0 add n 1
    r = get g_pkr 0
    k = add or ulong get g_pk r shl ulong get g_pk add r 1 8 1
    put g_pk r uchar and k 255
    put g_pk add r 1 uchar shr k 8
  end
end

fn pk_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    pk_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    pk_b get buf p
    p = add p 1
  end
end

fn start_server max_up ulong to bool
  pk_reset
  pk_open
  for i ulong get g_srvl 0 bound 512
    pk_b get g_srv i
  end
  pk_open
  for i ulong get g_dirl 0 bound 512
    pk_b get g_dir i
  end
  pk_open
  pk_u64 get g_port 0
  pk_open
  pk_u64 max_up
  pid = fork
  if lt pid 0
    ret false
  end
  if eq pid 0
    nul = fopen t_devnull 0 len t_devnull 2 0
    if ge nul 0
      x = dupfd int nul 0 0
      x = dupfd int nul 1 0
      x = dupfd int nul 2 0
    end
    x = execprog g_pk 0 get g_pkl 0
    exit 127
  end
  put g_pid 0 int pid
  x = sleepns 150000000
  ret true
end

fn stop_server to void
  st = new uchar 4 0
  pid = get g_pid 0
  if gt pid 0
    x = killpid pid 15
    w = waitpid pid st 0 4 0
    put g_pid 0 0
    x = sleepns 50000000
  end
end

note ---- Loopback TCP HTTP client ----

fn connect_hub to int
  fd = socknew 2 524289 0
  if lt fd 0
    ret -1
  end
  port = get g_port 0
  a = new uchar 16 0
  put a 0 2
  put a 2 uchar and shr port 8 255
  put a 3 uchar and port 255
  put a 4 uchar and shr GT_IP 24 255
  put a 5 uchar and shr GT_IP 16 255
  put a 6 uchar and shr GT_IP 8 255
  put a 7 uchar and GT_IP 255
  if ne connect int fd a 0 16 0
    x = fclose int fd
    ret -1
  end
  ret int fd
end

fn tx_reset to void
  put g_txl 0 0
end

fn tx_b c uchar to void
  n = get g_txl 0
  if lt n 65536
    put g_tx n c
    put g_txl 0 add n 1
  end
end

fn tx_txt t view uchar * to void
  for i ulong len t bound 2048
    tx_b get t i
  end
end

fn tx_crlf to void
  tx_b 13
  tx_b 10
end

fn tx_u64 v ulong to void
  buf = new uchar 24 0
  p = ulong 24
  n = v
  if eq n 0
    tx_b 48
    ret
  end
  while gt n 0 bound 24
    p = sub p 1
    put buf p uchar add 48 rem n 10
    n = div n 10
  end
  while lt p 24 bound 24
    tx_b get buf p
    p = add p 1
  end
end

fn send_all_tx fd int to bool
  n = get g_txl 0
  off = ulong 0
  while lt off n bound 100000
    k = send fd g_tx off sub n off 16384
    if le k 0
      if eq k -4
        continue
      end
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn send_all_mp fd int to bool
  n = get g_mpl 0
  off = ulong 0
  while lt off n bound 100000
    k = send fd g_mp off sub n off 16384
    if le k 0
      if eq k -4
        continue
      end
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn send_all_body fd int to bool
  n = get g_bodyl 0
  off = ulong 0
  while lt off n bound 20000
    k = send fd g_body off sub n off 16384
    if le k 0
      if eq k -4
        continue
      end
      ret false
    end
    off = add off ulong k
  end
  ret true
end

fn parse_rx_meta to void
  put g_rx_hend 0 0
  put g_rx_code 0 0
  n = get g_rxl 0
  if ge n 12
    c0 = sub get g_rx 9 48
    c1 = sub get g_rx 10 48
    c2 = sub get g_rx 11 48
    put g_rx_code 0 add mul add mul ulong c0 10 ulong c1 10 ulong c2
  end
  if ge n 4
    for i ulong sub n 3 bound 65536
      if eq get g_rx i 13
        if eq get g_rx add i 1 10
          if eq get g_rx add i 2 13
            if eq get g_rx add i 3 10
              put g_rx_hend 0 add i 4
              ret
            end
          end
        end
      end
    end
  end
end

fn read_rx_all fd int to bool
  put g_rxl 0 0
  dl = add long monons GT_IO_TMO
  for it ulong 100000 bound 100000
    left = sub dl long monons
    if le left 0
      break
    end
    w = waitio fd 1 left
    if le w 0
      if eq w -4
        continue
      end
      break
    end
    n = get g_rxl 0
    if ge n 262144
      r = recv fd g_io 0 4096 0
      if le r 0
        break
      end
      continue
    end
    r = recv fd g_rx n sub 262144 n 0
    if lt r 0
      if eq r -4
        continue
      end
      break
    end
    if eq r 0
      break
    end
    put g_rxl 0 add n ulong r
  end
  parse_rx_meta
  ret gt get g_rx_hend 0 0
end

fn do_simple_req meth view uchar * path view uchar * to bool
  fd = connect_hub
  if lt fd 0
    ret false
  end
  tx_reset
  tx_txt meth
  tx_b 32
  tx_txt path
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  ok = send_all_tx fd
  if ok
    ok = read_rx_all fd
  end
  x = fclose fd
  ret ok
end

fn do_path_with_sha is_head bool pre view uchar * which ulong suf_k ulong to bool
  fd = connect_hub
  if lt fd 0
    ret false
  end
  tx_reset
  if is_head
    tx_txt t_m_head_w
  else
    tx_txt t_m_get_w
  end
  tx_b 32
  tx_txt pre
  for i ulong 64
    if eq which 1
      tx_b get g_sha_a i
    end
    if eq which 2
      tx_b get g_clip_sha i
    end
    if eq which 3
      tx_b get g_sha_r1 i
    end
  end
  if eq suf_k 1
    tx_txt t_suf_sp
  end
  if eq suf_k 2
    tx_txt t_suf_spclip
  end
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  ok = send_all_tx fd
  if ok
    ok = read_rx_all fd
  end
  x = fclose fd
  ret ok
end

fn rx_match_at off ulong pat view uchar * to bool
  for j ulong len pat bound 128
    if ne get g_rx add off j get pat j
      ret false
    end
  end
  ret true
end

fn rx_body_contains pat view uchar * to bool
  hend = get g_rx_hend 0
  n = get g_rxl 0
  pl = len pat
  if or eq pl 0 gt add hend pl n
    ret false
  end
  lim = add sub sub n hend pl 1
  for i ulong lim bound 262144
    if rx_match_at add hend i pat
      ret true
    end
  end
  ret false
end

fn rx_imatch_at off ulong pat view uchar * to bool
  for j ulong len pat bound 64
    if ne to_low get g_rx add off j get pat j
      ret false
    end
  end
  ret true
end

fn rx_copy_hdr_val p0 ulong pe ulong to bool
  p = p0
  while lt p pe bound 128
    c = get g_rx p
    if and ne c 32 ne c 9
      break
    end
    p = add p 1
  end
  while lt p pe bound 128
    c = get g_rx p
    if or eq c 13 eq c 10
      break
    end
    k = get g_hdr_vall 0
    if lt k 128
      put g_hdr_val k c
      put g_hdr_vall 0 add k 1
    end
    p = add p 1
  end
  ret gt get g_hdr_vall 0 0
end

fn rx_hdr_extract pat view uchar * to bool
  put g_hdr_vall 0 0
  hend = get g_rx_hend 0
  pl = len pat
  i = ulong 0
  while lt i hend bound 16384
    ls = i
    while lt i hend bound 16384
      c = get g_rx i
      i = add i 1
      if eq c 10
        break
      end
    end
    if ge sub i ls pl
      if rx_imatch_at ls pat
        ret rx_copy_hdr_val add ls pl i
      end
    end
  end
  ret false
end

fn hdr_eq_sha_hex to bool
  if ne get g_hdr_vall 0 64
    ret false
  end
  for i ulong 64
    if ne get g_hdr_val i get g_sh_hex i
      ret false
    end
  end
  ret true
end

fn hdr_eq_txt pat view uchar * to bool
  if ne get g_hdr_vall 0 len pat
    ret false
  end
  for i ulong len pat bound 128
    if ne get g_hdr_val i get pat i
      ret false
    end
  end
  ret true
end

note ---- Multipart form builder helpers ----

text t_mp_d1 "--"
text t_mp_cd1 "Content-Disposition: form-data; name=\""
text t_mp_cd2 "\"; filename=\""
text t_mp_q "\""

fn mp_reset to void
  put g_mpl 0 0
end

fn mp_b c uchar to void
  n = get g_mpl 0
  if lt n 65536
    put g_mp n c
    put g_mpl 0 add n 1
  end
end

fn mp_txt t view uchar * to void
  for i ulong len t bound 512
    mp_b get t i
  end
end

fn mp_crlf to void
  mp_b 13
  mp_b 10
end

fn mp_field k view uchar * v view uchar * to void
  mp_txt t_mp_d1
  mp_txt t_bnd
  mp_crlf
  mp_txt t_mp_cd1
  mp_txt k
  mp_txt t_mp_q
  mp_crlf
  mp_crlf
  mp_txt v
  mp_crlf
end

fn mp_field_sha k view uchar * which ulong to void
  mp_txt t_mp_d1
  mp_txt t_bnd
  mp_crlf
  mp_txt t_mp_cd1
  mp_txt k
  mp_txt t_mp_q
  mp_crlf
  mp_crlf
  for i ulong 64
    if eq which 0
      mp_b get g_sh_hex i
    else
      mp_b get g_sha_a i
    end
  end
  mp_crlf
end

text t_f_pack_k "pack"
text t_rt_up "/strands/upload"

fn mp_pack_part fnm view uchar * to void
  mp_txt t_mp_d1
  mp_txt t_bnd
  mp_crlf
  mp_txt t_mp_cd1
  mp_txt t_f_pack_k
  mp_txt t_mp_cd2
  mp_txt fnm
  mp_txt t_mp_q
  mp_crlf
  mp_crlf
  n = get g_packl 0
  for i ulong n bound 32768
    mp_b get g_pack i
  end
  mp_crlf
  mp_txt t_mp_d1
  mp_txt t_bnd
  mp_txt t_mp_d1
  mp_crlf
end

fn post_mp_upload to bool
  fd = connect_hub
  if lt fd 0
    ret false
  end
  tx_reset
  tx_txt t_m_post_w
  tx_b 32
  tx_txt t_rt_up
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt t_ct_mp_hdr
  tx_crlf
  tx_txt t_cl_hdr
  tx_u64 get g_mpl 0
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  ok = send_all_tx fd
  if ok
    ok = send_all_mp fd
  end
  if ok
    ok = read_rx_all fd
  end
  x = fclose fd
  ret ok
end

fn body_reset to void
  put g_bodyl 0 0
end

fn body_b c uchar to void
  n = get g_bodyl 0
  if lt n 16384
    put g_body n c
    put g_bodyl 0 add n 1
  end
end

fn body_txt t view uchar * to void
  for i ulong len t bound 512
    body_b get t i
  end
end

fn body_sha which ulong to void
  for i ulong 64
    if eq which 1
      body_b get g_sha_a i
    end
    if eq which 2
      body_b get g_sha_b i
    end
    if eq which 3
      body_b get g_sha_c i
    end
    if eq which 4
      body_b get g_sha_r1 i
    end
    if eq which 5
      body_b get g_sha_r2 i
    end
  end
end

fn post_body_req path view uchar * ct view uchar * to bool
  fd = connect_hub
  if lt fd 0
    ret false
  end
  tx_reset
  tx_txt t_m_post_w
  tx_b 32
  tx_txt path
  tx_txt t_http11
  tx_crlf
  tx_txt t_host_hdr
  tx_crlf
  tx_txt ct
  tx_crlf
  tx_txt t_cl_hdr
  tx_u64 get g_bodyl 0
  tx_crlf
  tx_txt t_conn_hdr
  tx_crlf
  tx_crlf
  ok = send_all_tx fd
  if ok
    ok = send_all_body fd
  end
  if ok
    ok = read_rx_all fd
  end
  x = fclose fd
  ret ok
end


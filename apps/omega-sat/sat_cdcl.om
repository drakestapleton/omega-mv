note SPDX-License-Identifier: Apache-2.0
note apps/omega-sat/sat_cdcl.om
note Wave 5 Alien Breakthrough: Pure Seeded-OM-2 CDCL SAT Solver + RUP/DRAT/LRAT Proof Emitter.
note
note Compose after:
note   si/directives/om2.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note   protocol/uor-gpu/ed_sign.om
note
note Features:
note   - Strict DIMACS CNF parser (fail-closed on malformed headers, out-of-range vars, trailing lits)
note   - Intrusive 2-watched-literal BCP (zero allocation, conflict-safe watch preservation)
note   - 1-UIP conflict analysis + LBD computation + chronological level-0/trail LRAT hint extraction
note   - VSIDS binary max-heap + phase saving + Luby restarts + LBD-guided learned-clause deletion
note   - Cryptographic OMSAT1 (SAT witness) and OMDR01 (UNSAT RUP/DRAT/LRAT) + OMSR01 signed receipts
note
note Exit codes:
note   selftest -> 0 on PASS
note   solve    -> 10 on SAT, 20 on UNSAT, non-zero (1..5, 60..69) on error
note Zero C, zero Python, zero Rust, zero gcc, zero GPU hardware writes (hw_writes=0).

const SC_MAX_VARS ulong 4096
const SC_MAX_LITS ulong 8196
const SC_MAX_CLAUSES ulong 65536
const SC_MAX_POOL ulong 524288
const SC_MAX_WATCHES ulong 131072
const SC_MAX_CNF ulong 1048576
const SC_MAX_PROOF ulong 2097152
const SC_MAX_HINTS ulong 16384
const SC_INVALID ulong 0xffffffff

const SC_UNDEF ulong 0
const SC_TRUE ulong 1
const SC_FALSE ulong 2

const SC_EXIT_OK int 0
const SC_EXIT_USAGE int 2
const SC_EXIT_IO int 3
const SC_EXIT_PARSE int 4
const SC_EXIT_LIMIT int 5
const SC_EXIT_SAT int 10
const SC_EXIT_UNSAT int 20

const SC_LUBY_BASE ulong 32


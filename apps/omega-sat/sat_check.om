global ck_hints_n ulong 1

global ck_hdr_nv ulong 1
global ck_hdr_nc ulong 1
global ck_hdr_ns ulong 1
global ck_hdr_fl ulong 1
global ck_hdr_pl ulong 1
global ck_res_steps ulong 1
global ck_res_dels ulong 1
global ck_res_rats ulong 1
global ck_rcpt_ver ulong 1
global ck_rcpt_nv ulong 1
global ck_rcpt_nc ulong 1
global ck_rcpt_st ulong 1

global ck_rat_cids ulong 65536
global ck_rat_n ulong 1
global ck_allow_rat ulong 1
global ck_has_lrat ulong 1
global ck_saw_empty ulong 1
global ck_is_drat_txt ulong 1


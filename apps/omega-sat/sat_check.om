global ck_cl_active ulong 65536
global ck_cl_taut ulong 65536
global ck_cl_hash ulong 65536
global ck_false_cnt ulong 65536
global ck_pool ulong 524288

global ck_occ_head ulong 8196
global ck_occ_cid ulong 1048576
global ck_occ_next ulong 1048576

global ck_unit_cids ulong 65536
global ck_unit_n ulong 1

global ck_val ulong 4098
global ck_trail ulong 4098
global ck_trail_n ulong 1
global ck_dirty ulong 65536
global ck_dirty_n ulong 1

global ck_step_lits ulong 8196
global ck_step_n ulong 1
global ck_step_pivot ulong 1
global ck_step_taut ulong 1
global ck_seen ulong 8196

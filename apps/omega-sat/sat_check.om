note SPDX-License-Identifier: Apache-2.0
note apps/omega-sat/sat_check.om
note Wave 5 Alien Breakthrough: Independent Zero-Shared-Code SAT Witness & RUP/DRAT/LRAT Verifier.
note
note Compose after (verification-only crypto libs; ZERO solver code, ZERO ed_sign.om):
note   si/directives/om2.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note
note Independent Algorithms:
note   - Separate strict DIMACS CNF parser + raw-byte SHA-256 binding check
note   - Independent SAT assignment evaluator (OMSAT1: exact length, {0,1} domain, every clause SAT)
note   - Independent occurrence-list + falsified-counter RUP/DRAT/LRAT verifier (OMDR01 + ASCII .drat)
note   - Standalone 352-byte OMSR01 Ed25519/SHA-256 receipt verifier
note
note Fail-Closed Exit Codes:
note   0  = VALID
note   2  = usage error
note   3  = I/O error
note   4  = CNF parse error
note   5  = capacity limit
note   60 = CK_ERR_FORMAT      (magic/version/length/truncation/trailing-byte tamper)
note   61 = CK_ERR_HASH        (cnf_sha256 / body_sha256 / bind_digest mismatch)
note   62 = CK_ERR_SIG         (Ed25519 RFC 8032 strict signature or pubkey mismatch)
note   63 = CK_ERR_SAT_WITNESS (witness byte not 0/1 or falsifies at least one clause)
note   64 = CK_ERR_PROOF_LIT   (bad op, lit=0, |lit|>nvars, empty-clause delete, malformed DRAT)
note   65 = CK_ERR_NOT_RUP     (added clause fails RUP and DRAT check)
note   66 = CK_ERR_NO_EMPTY    (UNSAT proof lacks empty clause [] or has trailing steps after [])
note   67 = CK_ERR_BAD_HINT    (LRAT hint ID invalid/deleted or fails causal conflict check)
note Zero C, zero Python, zero Rust, zero gcc, zero GPU hardware writes (hw_writes=0).

const CK_MAX_VARS ulong 4096
const CK_MAX_LITS ulong 8196
const CK_MAX_CLAUSES ulong 65536
const CK_MAX_POOL ulong 524288
const CK_MAX_OCC ulong 1048576
const CK_MAX_CNF ulong 1048576
const CK_MAX_PROOF ulong 2097152
const CK_INVALID ulong 0xffffffff

const CK_UNDEF ulong 0
const CK_TRUE ulong 1
const CK_FALSE ulong 2

const CK_OK int 0
const CK_ERR_USAGE int 2
const CK_ERR_IO int 3
const CK_ERR_CNF int 4
const CK_ERR_LIMIT int 5
const CK_ERR_FORMAT int 60
const CK_ERR_HASH int 61
const CK_ERR_SIG int 62
const CK_ERR_SAT int 63
const CK_ERR_LIT int 64
const CK_ERR_RUP int 65
const CK_ERR_EMPTY int 66
const CK_ERR_HINT int 67

note ---- Arguments, Buffers & Verification State ----


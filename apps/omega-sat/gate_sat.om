text sg_m5_new "  for v ulong nv bound 4098\n    vv = get sc_val add v 1\n    b = uchar 0\n    if eq vv SC_TRUE\n      b = uchar 1\n    end\n    if eq v 0\n      b = uchar 2\n    end\n    put sc_prf add 64 v b\n  end"

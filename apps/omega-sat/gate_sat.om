note ==== Section 1: Printing & Assertion Helpers ====

fn sg_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn sg_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn sg_num v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put sg_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 sg_dig p sub 24 p
      ret
    end
  end
end

fn sg_fail tag ulong to void
  put sg_fails 0 add get sg_fails 0 1
  sg_wrt sg_m_fail
  sg_num tag
  sg_wrt sg_nl
end

fn sg_chk ok bool tag ulong to void
  put sg_checks 0 add get sg_checks 0 1
  if not ok
    sg_fail tag
  end
end

fn sg_ctrl killed bool tag ulong to void
  put sg_ctrls 0 add get sg_ctrls 0 1
  if killed
    put sg_caught 0 add get sg_caught 0 1
  else
    sg_fail tag
  end
end

note ==== Section 2: Path, Argv & Process Execution Helpers ====

fn sg_arg_to_glob idx ulong which ulong to ulong
  rn = argread idx sg_arg 0 1020
  if le rn 0
    ret 0
  end
  u = ulong rn
  for i ulong u bound 1024
    b = get sg_arg i
    if eq which 0
      put sg_omc i b
    end
    if eq which 1
      put sg_root i b
    end
    if eq which 2
      put sg_scr i b
    end
    if eq which 3
      put sg_cdcl_bin i b
    end
    if eq which 4
      put sg_chk_bin i b
    end
  end
  ret u
end

fn sg_set_pa_root suf view uchar * to ulong
  rl = get sg_root_l 0
  for i ulong rl bound 1024
    put sg_pa i get sg_root i
  end
  sl = len suf
  for j ulong sl bound 512
    put sg_pa add rl j get suf j
  end
  put sg_pal 0 add rl sl
  ret add rl sl
end

fn sg_set_pa_scr suf view uchar * to ulong
  rl = get sg_scr_l 0
  for i ulong rl bound 1024
    put sg_pa i get sg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put sg_pa add rl j get suf j
  end
  put sg_pal 0 add rl sl
  ret add rl sl
end

fn sg_set_pb_scr suf view uchar * to ulong
  rl = get sg_scr_l 0
  for i ulong rl bound 1024
    put sg_pb i get sg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put sg_pb add rl j get suf j
  end
  put sg_pbl 0 add rl sl
  ret add rl sl
end

fn sg_set_pc_scr suf view uchar * to ulong
  rl = get sg_scr_l 0
  for i ulong rl bound 1024
    put sg_pc i get sg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put sg_pc add rl j get suf j
  end
  put sg_pcl 0 add rl sl
  ret add rl sl
end

fn sg_use_cdcl to void
  n = get sg_cdcl_l 0
  for i ulong n bound 1024
    put sg_cur_bin i get sg_cdcl_bin i
  end
  put sg_cur_l 0 n
end

fn sg_use_chk to void
  n = get sg_chk_l 0
  for i ulong n bound 1024
    put sg_cur_bin i get sg_chk_bin i
  end
  put sg_cur_l 0 n
end

fn sg_use_scr_bin suf view uchar * to void
  rl = get sg_scr_l 0
  for i ulong rl bound 1024
    put sg_cur_bin i get sg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put sg_cur_bin add rl j get suf j
  end
  put sg_cur_l 0 add rl sl
end

fn sg_av_clr to void
  put sg_avn 0 2
  put sg_avc 0 0
  put sg_av 0 0
  put sg_av 1 0
end

fn sg_av_fin sl ulong to void
  p = get sg_avn 0
  put sg_av p uchar and sl 255
  put sg_av add p 1 uchar shr sl 8
  put sg_avn 0 add p add sl 2
  c = add get sg_avc 0 1
  put sg_avc 0 c
  put sg_av 0 uchar and c 255
  put sg_av 1 uchar shr c 8
end

fn sg_av_omc to void
  p = get sg_avn 0
  sl = get sg_omc_l 0
  for j ulong sl bound 1024
    put sg_av add add p 2 j get sg_omc j
  end
  sg_av_fin sl
end

fn sg_av_cur to void
  p = get sg_avn 0
  sl = get sg_cur_l 0
  for j ulong sl bound 1024
    put sg_av add add p 2 j get sg_cur_bin j
  end
  sg_av_fin sl
end

fn sg_av_pa to void
  p = get sg_avn 0
  sl = get sg_pal 0
  for j ulong sl bound 1024
    put sg_av add add p 2 j get sg_pa j
  end
  sg_av_fin sl
end

fn sg_av_lit s view uchar * to void
  p = get sg_avn 0
  sl = len s
  for j ulong sl bound 1024
    put sg_av add add p 2 j get s j
  end
  sg_av_fin sl
end

fn sg_redir fd int target int to void
  if ne dupfd fd target 0 long target
    exit 127
  end
end

fn sg_run_sync fi long fo long fe long to ulong
  if or lt fi 0 or lt fo 0 lt fe 0
    if ge fi 0
      z = fclose int fi
    end
    if ge fo 0
      z = fclose int fo
    end
    if ge fe 0
      z = fclose int fe
    end
    ret 999
  end
  pid = fork
  if lt pid 0
    ret 998
  end
  if eq pid 0
    sg_redir int fi 0
    sg_redir int fo 1
    sg_redir int fe 2
    ze = execprog sg_av 0 get sg_avn 0
    exit 127
  end
  z = fclose int fi
  z = fclose int fo
  z = fclose int fe
  t0 = monons
  while true bound 100000000
    r = waitpid int pid sg_stb 0 len sg_stb 1
    if eq r pid
      if ne get sg_stb 0 0
        ret add 128 ulong get sg_stb 0
      end
      ret ulong get sg_stb 1
    end
    if lt r 0
      ret 997
    end
    if gt sub monons t0 60000000000
      zk = killpid int pid 9
      zw = waitpid int pid sg_stb 0 len sg_stb 0
      ret 996
    end
  end
  ret 995
end

fn sg_read_out_pa to void
  put sg_outl 0 0
  fd = fopen sg_pa 0 get sg_pal 0 0 0
  if lt fd 0
    ret
  end
  rn = read int fd sg_out 0 16384
  z = fclose int fd
  if gt rn 0
    put sg_outl 0 ulong rn
  end
end

fn sg_has_sub pat view uchar * to bool
  ol = get sg_outl 0
  pl = len pat
  if or eq pl 0 gt pl ol
    ret false
  end
  lim = add sub ol pl 1
  for i ulong lim bound 16384
    ok = true
    for j ulong pl bound 128
      if ne get sg_out add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn sg_spawn_cur to ulong
  zp = sg_set_pa_scr sg_f_out
  fi = fopen sg_null 0 len sg_null 0 0
  fo = fopen sg_pa 0 get sg_pal 0 577 420
  fe = fopen sg_null 0 len sg_null 0 0
  rc = sg_run_sync fi fo fe
  zp = sg_set_pa_scr sg_f_out
  sg_read_out_pa
  ret rc
end

note ==== Section 3: OMC Pin, 2x Compile, Static ELF64 & Mutant Builder ====

fn sg_read_pa_to_sh to long
  fd = fopen sg_pa 0 get sg_pal 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn sg_read_omc_to_sh to long
  fd = fopen sg_omc 0 get sg_omc_l 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn sg_stat_pa_size to long
  r = stat sg_pa 0 get sg_pal 0 sg_stat 0 128
  if ne r 0
    ret -1
  end
  sz = ulong 0
  for j ulong 8
    sz = or sz shl ulong get sg_stat add 48 j mul j 8
  end
  ret long sz
end

fn sg_verify_omc_pin to bool
  zp = sg_set_pa_root sg_p_pin
  fd = fopen sg_pa 0 get sg_pal 0 0 0
  if lt fd 0
    ret false
  end
  rn = read int fd sg_pin_hex 0 128
  z = fclose int fd
  if lt rn 64
    ret false
  end
  nb = sg_read_omc_to_sh
  if le nb 0
    ret false
  end
  sh_all ulong nb
  for i ulong 32
    b = get sh_dig i
    hi = shr b 4
    lo = and b 15
    hc = uchar add 48 hi
    if ge hi 10
      hc = uchar add 87 hi
    end
    lc = uchar add 48 lo
    if ge lo 10
      lc = uchar add 87 lo
    end
    if ne hc get sg_pin_hex mul i 2
      ret false
    end
    if ne lc get sg_pin_hex add mul i 2 1
      ret false
    end
  end
  ret true
end

fn sg_append_root_src suf view uchar * to bool
  zp = sg_set_pa_root suf
  fd = fopen sg_pa 0 get sg_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = get sg_srcl 0
  while lt tot 262144 bound 64
    rn = read int fd sg_src tot sub 262144 tot
    if lt rn 0
      z = fclose int fd
      ret false
    end
    if eq rn 0
      z = fclose int fd
      put sg_srcl 0 tot
      ret true
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret false
end

fn sg_write_src_pa suf view uchar * n ulong is_mut bool to bool
  zp = sg_set_pa_scr suf
  fd = fopen sg_pa 0 get sg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 64
    wn = long 0
    if is_mut
      wn = write int fd sg_mut off sub n off
    else
      wn = write int fd sg_src off sub n off
    end
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn sg_build_cdcl_src to ulong
  put sg_srcl 0 0
  if not sg_append_root_src sg_u0
    ret 0
  end
  if not sg_append_root_src sg_u1
    ret 0
  end
  if not sg_append_root_src sg_u2
    ret 0
  end
  if not sg_append_root_src sg_u3
    ret 0
  end
  if not sg_append_root_src sg_u4
    ret 0
  end
  if not sg_append_root_src sg_u5_cdcl
    ret 0
  end
  n = get sg_srcl 0
  if not sg_write_src_pa sg_f_cdcl_s n false
    ret 0
  end
  ret n
end

fn sg_build_chk_src to ulong
  put sg_srcl 0 0
  if not sg_append_root_src sg_u0
    ret 0
  end
  if not sg_append_root_src sg_u1
    ret 0
  end
  if not sg_append_root_src sg_u2
    ret 0
  end
  if not sg_append_root_src sg_u3
    ret 0
  end
  if not sg_append_root_src sg_u5_chk
    ret 0
  end
  n = get sg_srcl 0
  if not sg_write_src_pa sg_f_chk_s n false
    ret 0
  end
  ret n
end

fn sg_compile_src scr_src view uchar * scr_out view uchar * scr_err view uchar * to ulong
  sg_av_clr
  sg_av_omc
  zp = sg_set_pa_scr scr_src
  zp = sg_set_pb_scr scr_out
  zp = sg_set_pc_scr scr_err
  fi = fopen sg_pa 0 get sg_pal 0 0 0
  fo = fopen sg_pb 0 get sg_pbl 0 577 493
  fe = fopen sg_pc 0 get sg_pcl 0 577 420
  rc = sg_run_sync fi fo fe
  if eq rc 0
    zp = sg_set_pb_scr scr_out
    zcm = chmod sg_pb 0 get sg_pbl 0 493
  end
  ret rc
end

fn sg_hash_scr_file suf view uchar * dst_sha ulong to long
  zp = sg_set_pa_scr suf
  nb = sg_read_pa_to_sh
  if le nb 0
    ret -1
  end
  sh_all ulong nb
  for j ulong 32
    if eq dst_sha 1
      put sg_h1 j get sh_dig j
    else
      put sg_h2 j get sh_dig j
    end
  end
  ret nb
end

fn sg_sh_u16 off ulong to ulong
  b0 = ulong get sh_dat off
  b1 = ulong get sh_dat add off 1
  ret or b0 shl b1 8
end

fn sg_sh_u32 off ulong to ulong
  v = ulong 0
  for b ulong 4
    v = or v shl ulong get sh_dat add off b mul b 8
  end
  ret v
end

fn sg_sh_u64 off ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get sh_dat add off i mul i 8
  end
  ret v
end

fn sg_check_static_elf suf view uchar * to bool
  zp = sg_set_pa_scr suf
  nb = sg_read_pa_to_sh
  if lt nb 128
    ret false
  end
  if or ne get sh_dat 0 127 ne get sh_dat 1 69
    ret false
  end
  if or ne get sh_dat 2 76 ne get sh_dat 3 70
    ret false
  end
  if or ne get sh_dat 4 2 ne sg_sh_u16 18 183
    ret false
  end
  phoff = sg_sh_u64 32
  phentsz = sg_sh_u16 54
  phnum = sg_sh_u16 56
  if or eq phnum 0 gt phnum 16
    ret false
  end
  for k ulong phnum bound 16
    if eq sg_sh_u32 add phoff mul k phentsz 2
      ret false
    end
  end
  ret true
end

fn sg_check_2x_det which ulong tag ulong to bool
  sz1 = long 0
  sz2 = long 0
  if eq which 0
    c1 = sg_compile_src sg_f_chk_s sg_f_chk1 sg_f_e3
    c2 = sg_compile_src sg_f_chk_s sg_f_chk2 sg_f_e4
    sg_chk and eq c1 0 eq c2 0 tag
    zp = sg_set_pa_scr sg_f_e3
    es1 = sg_stat_pa_size
    zp = sg_set_pa_scr sg_f_e4
    es2 = sg_stat_pa_size
    sg_chk and eq es1 0 eq es2 0 add tag 1
    sz1 = sg_hash_scr_file sg_f_chk1 1
    sz2 = sg_hash_scr_file sg_f_chk2 2
  else
    c1 = sg_compile_src sg_f_cdcl_s sg_f_cdcl1 sg_f_e1
    c2 = sg_compile_src sg_f_cdcl_s sg_f_cdcl2 sg_f_e2
    sg_chk and eq c1 0 eq c2 0 tag
    zp = sg_set_pa_scr sg_f_e1
    es1 = sg_stat_pa_size
    zp = sg_set_pa_scr sg_f_e2
    es2 = sg_stat_pa_size
    sg_chk and eq es1 0 eq es2 0 add tag 1
    sz1 = sg_hash_scr_file sg_f_cdcl1 1
    sz2 = sg_hash_scr_file sg_f_cdcl2 2
  end
  det_ok = and gt sz1 10000 eq sz1 sz2
  for j ulong 32
    if ne get sg_h1 j get sg_h2 j
      det_ok = false
    end
  end
  sg_chk det_ok add tag 2
  if eq which 0
    sg_chk sg_check_static_elf sg_f_chk1 add tag 3
  else
    sg_chk sg_check_static_elf sg_f_cdcl1 add tag 3
  end
  ret det_ok
end

fn sg_mut_reset to void
  sl = get sg_srcl 0
  for i ulong sl bound 262144
    put sg_mut i get sg_src i
  end
  put sg_mutl 0 sl
end

fn sg_mut_match_at base ulong pat view uchar * to bool
  for j ulong len pat bound 1024
    if ne get sg_mut add base j get pat j
      ret false
    end
  end
  ret true
end

fn sg_mut_find old_s view uchar * to long
  ml = get sg_mutl 0
  ol = len old_s
  if gt ol ml
    ret -1
  end
  hits = ulong 0
  pos = ulong 0
  lim = add sub ml ol 1
  for i ulong lim bound 262144
    if sg_mut_match_at i old_s
      hits = add hits 1
      pos = i
    end
  end
  if ne hits 1
    ret -1
  end
  ret long pos
end

fn sg_mut_copy_tail dst_off ulong src_off ulong count ulong to void
  for i ulong count bound 262144
    put sg_tmp add dst_off i get sg_mut add src_off i
  end
end

fn sg_mut_splice pos ulong ol ulong new_s view uchar * to bool
  ml = get sg_mutl 0
  nl = len new_s
  outn = add sub ml ol nl
  if gt outn 262144
    ret false
  end
  for i ulong pos bound 262144
    put sg_tmp i get sg_mut i
  end
  for j ulong nl bound 256
    put sg_tmp add pos j get new_s j
  end
  sg_mut_copy_tail add pos nl add pos ol sub ml add pos ol
  for i ulong outn bound 262144
    put sg_mut i get sg_tmp i
  end
  put sg_mutl 0 outn
  ret true
end

fn sg_mut_patch old_s view uchar * new_s view uchar * to bool
  pos = sg_mut_find old_s
  if lt pos 0
    ret false
  end
  ret sg_mut_splice ulong pos len old_s new_s
end

fn sg_mut_compile to bool
  if not sg_write_src_pa sg_f_msrc get sg_mutl 0 true
    ret false
  end
  ret eq sg_compile_src sg_f_msrc sg_f_mb sg_f_me 0
end

note ==== Section 4: Pure-OM DIMACS Benchmark Generators ====

fn sg_cnf_clr to void
  put sg_cnfl 0 0
  put sg_ncls_gen 0 0
end

fn sg_cnf_ch c uchar to void
  p = get sg_cnfl 0
  if lt p 262144
    put sg_cnf p c
    put sg_cnfl 0 add p 1
  end
end

fn sg_cnf_str s view uchar * to void
  for i ulong len s bound 1024
    sg_cnf_ch get s i
  end
end

fn sg_cnf_u v ulong to void
  x = v
  d = new uchar 24 0
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put d p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      for k ulong sub 24 p bound 24
        sg_cnf_ch get d add p k
      end
      ret
    end
  end
end

fn sg_cnf_lit l long to void
  if lt l 0
    sg_cnf_ch 45
    sg_cnf_u ulong sub 0 l
  else
    sg_cnf_u ulong l
  end
  sg_cnf_ch 32
end

fn sg_cnf_end to void
  sg_cnf_ch 48
  sg_cnf_ch 10
  put sg_ncls_gen 0 add get sg_ncls_gen 0 1
end

fn sg_cnf_hdr nv ulong nc ulong to void
  sg_cnf_ch 112
  sg_cnf_ch 32
  sg_cnf_ch 99
  sg_cnf_ch 110
  sg_cnf_ch 102
  sg_cnf_ch 32
  sg_cnf_u nv
  sg_cnf_ch 32
  sg_cnf_u nc
  sg_cnf_ch 10
end

fn sg_cnf_c2 a long b long to void
  sg_cnf_lit a
  sg_cnf_lit b
  sg_cnf_end
end

fn sg_cnf_c3 a long b long c long to void
  sg_cnf_lit a
  sg_cnf_lit b
  sg_cnf_lit c
  sg_cnf_end
end

fn sg_cnf_write suf view uchar * to bool
  zp = sg_set_pa_scr suf
  fd = fopen sg_pa 0 get sg_pal 0 577 420
  if lt fd 0
    ret false
  end
  n = get sg_cnfl 0
  off = ulong 0
  while lt off n bound 256
    want = sub n off
    if gt want 65536
      want = ulong 65536
    end
    w = write int fd sg_cnf off want
    if le w 0
      z = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  z = fclose int fd
  ret true
end

fn sg_php_hole p ulong h ulong j ulong drop_last bool to void
  for a ulong p bound 32
    for b ulong p bound 32
      if gt b a
        skip_c = false
        if drop_last
          if eq j sub h 1
            if eq a sub p 2
              if eq b sub p 1
                skip_c = true
              end
            end
          end
        end
        if not skip_c
          va = long add add mul a h j 1
          vb = long add add mul b h j 1
          sg_cnf_c2 sub 0 va sub 0 vb
        end
      end
    end
  end
end

fn sg_gen_php p ulong h ulong drop_last bool to void
  sg_cnf_clr
  nv = mul p h
  nc = add p div mul h mul p sub p 1 2
  if drop_last
    nc = sub nc 1
  end
  sg_cnf_hdr nv nc
  for i ulong p bound 32
    for j ulong h bound 32
      sg_cnf_lit long add add mul i h j 1
    end
    sg_cnf_end
  end
  for j ulong h bound 32
    sg_php_hole p h j drop_last
  end
end

fn sg_k5_edge u ulong v ulong to void
  for c ulong 4
    vu = long add add mul u 4 c 1
    vv = long add add mul v 4 c 1
    sg_cnf_c2 sub 0 vu sub 0 vv
  end
end

fn sg_gen_k5_4col to void
  sg_cnf_clr
  sg_cnf_hdr 20 45
  for v ulong 5
    for c ulong 4
      sg_cnf_lit long add add mul v 4 c 1
    end
    sg_cnf_end
  end
  for u ulong 5
    for v ulong 5
      if gt v u
        sg_k5_edge u v
      end
    end
  end
end

fn sg_pet_edge u ulong v ulong to void
  for c ulong 3
    vu = long add add mul u 3 c 1
    vv = long add add mul v 3 c 1
    sg_cnf_c2 sub 0 vu sub 0 vv
  end
end

fn sg_pet_node_amo v ulong to void
  for c1 ulong 3
    for c2 ulong 3
      if gt c2 c1
        v1 = long add add mul v 3 c1 1
        v2 = long add add mul v 3 c2 1
        sg_cnf_c2 sub 0 v1 sub 0 v2
      end
    end
  end
end

fn sg_gen_petersen_3col to void
  sg_cnf_clr
  sg_cnf_hdr 30 85
  for v ulong 10
    for c ulong 3
      sg_cnf_lit long add add mul v 3 c 1
    end
    sg_cnf_end
  end
  for v ulong 10
    sg_pet_node_amo v
  end
  for i ulong 5
    sg_pet_edge i rem add i 1 5
    sg_pet_edge add 5 i add 5 rem add i 2 5
    sg_pet_edge i add 5 i
  end
end

fn sg_q_at r ulong c ulong to long
  ret long add add mul r 6 c 1
end

fn sg_q_row r ulong to void
  for c1 ulong 6
    for c2 ulong 6
      if gt c2 c1
        q1 = sg_q_at r c1
        q2 = sg_q_at r c2
        sg_cnf_c2 sub 0 q1 sub 0 q2
      end
    end
  end
end

fn sg_q_col c ulong to void
  for r1 ulong 6
    for r2 ulong 6
      if gt r2 r1
        q1 = sg_q_at r1 c
        q2 = sg_q_at r2 c
        sg_cnf_c2 sub 0 q1 sub 0 q2
      end
    end
  end
end

fn sg_q_diag r1 ulong c1 ulong to void
  for r2 ulong 6
    if gt r2 r1
      dr = sub r2 r1
      if le add c1 dr 5
        q1 = sg_q_at r1 c1
        q2 = sg_q_at r2 add c1 dr
        sg_cnf_c2 sub 0 q1 sub 0 q2
      end
      if ge c1 dr
        q1 = sg_q_at r1 c1
        q2 = sg_q_at r2 sub c1 dr
        sg_cnf_c2 sub 0 q1 sub 0 q2
      end
    end
  end
end

fn sg_gen_6queens to void
  sg_cnf_clr
  sg_cnf_hdr 36 296
  for r ulong 6
    for c ulong 6
      sg_cnf_lit sg_q_at r c
    end
    sg_cnf_end
  end
  for r ulong 6
    sg_q_row r
  end
  for c ulong 6
    sg_q_col c
  end
  for r1 ulong 6
    for c1 ulong 6
      sg_q_diag r1 c1
    end
  end
end

note Tseitin gate encoders for 4-bit RCA vs CLA hardware equivalence miter
fn sg_new_var to long
  v = get sg_nxt_var 0
  put sg_nxt_var 0 add v 1
  ret long v
end

fn sg_ts_and z long a long b long to void
  sg_cnf_c2 sub 0 z a
  sg_cnf_c2 sub 0 z b
  sg_cnf_c3 z sub 0 a sub 0 b
end

fn sg_ts_or z long a long b long to void
  sg_cnf_c2 z sub 0 a
  sg_cnf_c2 z sub 0 b
  sg_cnf_c3 sub 0 z a b
end

fn sg_ts_xor z long a long b long to void
  sg_cnf_c3 sub 0 z a b
  sg_cnf_c3 sub 0 z sub 0 a sub 0 b
  sg_cnf_c3 z sub 0 a b
  sg_cnf_c3 z a sub 0 b
end

fn sg_ts_xor3 z long a long b long c long to void
  t = sg_new_var
  sg_ts_xor t a b
  sg_ts_xor z t c
end

fn sg_ts_maj z long a long b long c long to void
  ab = sg_new_var
  bc = sg_new_var
  ac = sg_new_var
  ab_bc = sg_new_var
  sg_ts_and ab a b
  sg_ts_and bc b c
  sg_ts_and ac a c
  sg_ts_or ab_bc ab bc
  sg_ts_or z ab_bc ac
end

fn sg_emit_rca4 a view long 4 b view long 4 cin long sr edit long 5 to void
  cur_c = cin
  for i ulong 4
    si = sg_new_var
    nc = sg_new_var
    sg_ts_xor3 si get a i get b i cur_c
    sg_ts_maj nc get a i get b i cur_c
    put sr i si
    cur_c = nc
  end
  put sr 4 cur_c
end

fn sg_emit_buggy4 a view long 4 b view long 4 cin long sc edit long 5 to void
  bc = cin
  for i ulong 4
    si = sg_new_var
    nc = sg_new_var
    sg_ts_xor3 si get a i get b i bc
    if eq i 2
      sg_ts_and nc get a i get b i
    else
      sg_ts_maj nc get a i get b i bc
    end
    put sc i si
    bc = nc
  end
  put sc 4 bc
end

fn sg_emit_cla4 a view long 4 b view long 4 cin long sc edit long 5 to void
  p = new long 4 0
  g = new long 4 0
  cc = new long 5 0
  put cc 0 cin
  for i ulong 4
    pi = sg_new_var
    gi = sg_new_var
    sg_ts_xor pi get a i get b i
    sg_ts_and gi get a i get b i
    put p i pi
    put g i gi
  end
  for i ulong 4
    t1 = sg_new_var
    nc = sg_new_var
    sg_ts_and t1 get p i get cc i
    sg_ts_or nc get g i t1
    put cc add i 1 nc
    si = sg_new_var
    sg_ts_xor si get p i get cc i
    put sc i si
  end
  put sc 4 get cc 4
end

fn sg_miter_finish_hdr to void
  nv = sub get sg_nxt_var 0 1
  nc = get sg_ncls_gen 0
  tot = get sg_cnfl 0
  for i ulong tot bound 262144
    put sg_tmp i get sg_cnf i
  end
  sg_cnf_clr
  sg_cnf_hdr nv nc
  rem_len = sub tot 16
  for i ulong rem_len bound 262144
    sg_cnf_ch get sg_tmp add 16 i
  end
end

fn sg_gen_adder_miter buggy bool to void
  sg_cnf_clr
  sg_cnf_str sg_miter_ph
  put sg_nxt_var 0 9
  a = new long 4 0
  b = new long 4 0
  for i ulong 4
    put a i long add i 1
    put b i long add i 5
  end
  sr = new long 5 0
  sc = new long 5 0

  cin = sg_new_var
  sg_cnf_lit sub 0 cin
  sg_cnf_end
  sg_emit_rca4 a b cin sr
  if buggy
    sg_emit_buggy4 a b cin sc
  else
    sg_emit_cla4 a b cin sc
  end

  diffs = new long 5 0
  for i ulong 5
    di = sg_new_var
    sg_ts_xor di get sr i get sc i
    put diffs i di
  end
  for i ulong 5
    sg_cnf_lit get diffs i
  end
  sg_cnf_end
  sg_miter_finish_hdr
end

note ==== Section 5: File Buffer Helpers & Negative Controls ====

fn sg_load_scr_to_buf suf view uchar * to long
  zp = sg_set_pa_scr suf
  fd = fopen sg_pa 0 get sg_pal 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 262144 bound 64
    rn = read int fd sg_buf tot sub 262144 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      put sg_bufl 0 tot
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn sg_write_buf_scr suf view uchar * n ulong to bool
  zp = sg_set_pa_scr suf
  fd = fopen sg_pa 0 get sg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 64
    w = write int fd sg_buf off sub n off
    if le w 0
      z = fclose int fd
      ret false
    end
    off = add off ulong w
  end
  z = fclose int fd
  ret true
end

fn sg_write_text_scr suf view uchar * s view uchar * to bool
  n = len s
  for i ulong n bound 4096
    put sg_buf i get s i
  end
  ret sg_write_buf_scr suf n
end

fn sg_run_solve cnf_suf view uchar * prf_suf view uchar * has_rcpt bool no_lrat bool to ulong
  sg_use_cdcl
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_solve
  sg_av_lit sg_fl_in
  zp = sg_set_pa_scr cnf_suf
  sg_av_pa
  sg_av_lit sg_fl_out
  zp = sg_set_pa_scr prf_suf
  sg_av_pa
  if has_rcpt
    sg_av_lit sg_fl_rcpt
    zp = sg_set_pa_scr sg_f_rcpt
    sg_av_pa
  end
  if no_lrat
    sg_av_lit sg_fl_nolrat
  end
  ret sg_spawn_cur
end

fn sg_run_check_verify cnf_suf view uchar * prf_suf view uchar * use_bad_pk bool to ulong
  sg_use_chk
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_verify
  sg_av_lit sg_fl_cnf
  zp = sg_set_pa_scr cnf_suf
  sg_av_pa
  sg_av_lit sg_fl_prf
  zp = sg_set_pa_scr prf_suf
  sg_av_pa
  if use_bad_pk
    sg_av_lit sg_fl_pk
    sg_av_lit sg_bad_pk
  end
  ret sg_spawn_cur
end

fn sg_run_check_drat cnf_suf view uchar * drat_suf view uchar * to ulong
  sg_use_chk
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_vdrat
  sg_av_lit sg_fl_cnf
  zp = sg_set_pa_scr cnf_suf
  sg_av_pa
  sg_av_lit sg_fl_drat
  zp = sg_set_pa_scr drat_suf
  sg_av_pa
  ret sg_spawn_cur
end

fn sg_run_check_rcpt rcpt_suf view uchar * cnf_suf view uchar * prf_suf view uchar * to ulong
  sg_use_chk
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_vrcpt
  sg_av_lit sg_fl_rcpt
  zp = sg_set_pa_scr rcpt_suf
  sg_av_pa
  sg_av_lit sg_fl_cnf
  zp = sg_set_pa_scr cnf_suf
  sg_av_pa
  sg_av_lit sg_fl_prf
  zp = sg_set_pa_scr prf_suf
  sg_av_pa
  ret sg_spawn_cur
end

fn sg_run_inspect prf_suf view uchar * is_rcpt bool to ulong
  sg_use_chk
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_inspect
  if is_rcpt
    sg_av_lit sg_fl_rcpt
  else
    sg_av_lit sg_fl_prf
  end
  zp = sg_set_pa_scr prf_suf
  sg_av_pa
  ret sg_spawn_cur
end

fn sg_check_bench_sat exp_tag ulong to void
  sg_chk sg_cnf_write sg_f_cnf exp_tag
  rc1 = sg_run_solve sg_f_cnf sg_f_prf true false
  sg_chk eq rc1 10 add exp_tag 1
  rc2 = sg_run_check_verify sg_f_cnf sg_f_prf false
  sg_chk and eq rc2 0 sg_has_sub sg_q_chk_sat add exp_tag 2
  rc3 = sg_run_check_rcpt sg_f_rcpt sg_f_cnf sg_f_prf
  sg_chk and eq rc3 0 sg_has_sub sg_q_chk_rc add exp_tag 3
  rc4 = sg_run_inspect sg_f_prf false
  sg_chk eq rc4 0 add exp_tag 4
end

fn sg_check_bench_unsat exp_tag ulong do_nolrat bool to void
  sg_chk sg_cnf_write sg_f_cnf exp_tag
  rc1 = sg_run_solve sg_f_cnf sg_f_prf true false
  sg_chk eq rc1 20 add exp_tag 1
  rc2 = sg_run_check_verify sg_f_cnf sg_f_prf false
  sg_chk and eq rc2 0 sg_has_sub sg_q_chk_dr add exp_tag 2
  rc3 = sg_run_check_rcpt sg_f_rcpt sg_f_cnf sg_f_prf
  sg_chk and eq rc3 0 sg_has_sub sg_q_chk_rc add exp_tag 3
  rc4 = sg_run_inspect sg_f_rcpt true
  sg_chk eq rc4 0 add exp_tag 4
  if do_nolrat
    rc5 = sg_run_solve sg_f_cnf sg_f_prf false true
    sg_chk eq rc5 20 add exp_tag 5
    rc6 = sg_run_check_verify sg_f_cnf sg_f_prf false
    sg_chk eq rc6 0 add exp_tag 6
  end
end

fn sg_run_positive two_bins bool to void
  if two_bins
    sg_use_scr_bin sg_f_cdcl1
  else
    sg_use_cdcl
  end
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_self
  sg_chk and eq sg_spawn_cur 0 sg_has_sub sg_q_cdcl_s 101

  if two_bins
    sg_use_scr_bin sg_f_chk2
  else
    sg_use_chk
  end
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_self
  sg_chk and eq sg_spawn_cur 0 sg_has_sub sg_q_chk_s 102

  if two_bins
    sg_use_scr_bin sg_f_cdcl1
    n1 = get sg_cur_l 0
    for i ulong n1 bound 1024
      put sg_cdcl_bin i get sg_cur_bin i
    end
    put sg_cdcl_l 0 n1
    sg_use_scr_bin sg_f_chk2
    n2 = get sg_cur_l 0
    for i ulong n2 bound 1024
      put sg_chk_bin i get sg_cur_bin i
    end
    put sg_chk_l 0 n2
  end

  sg_gen_petersen_3col
  sg_check_bench_sat 110

  sg_gen_6queens
  sg_check_bench_sat 120

  sg_gen_adder_miter true
  sg_check_bench_sat 130

  sg_gen_adder_miter false
  sg_check_bench_unsat 140 false

  sg_gen_k5_4col
  sg_check_bench_unsat 150 false

  sg_gen_php 5 4 false
  sg_check_bench_unsat 160 true

  sg_gen_php 6 5 false
  sg_check_bench_unsat 170 false
end

fn sg_flip_buf_bit idx ulong to void
  b = get sg_buf idx
  put sg_buf idx xor b 1
end

fn sg_atk_omsat1_and_rcpt to void
  note Save valid SAT artifact + receipt (Petersen)
  sg_gen_petersen_3col
  sg_chk sg_cnf_write sg_f_cnf 200
  sg_chk eq sg_run_solve sg_f_cnf sg_f_prf true false 10 201
  sz_s = sg_load_scr_to_buf sg_f_prf
  sg_chk gt sz_s 192 202
  if le sz_s 192
    ret
  end
  us = ulong sz_s

  note NEG-1: Flip SAT witness byte in OMSAT1
  sg_flip_buf_bit 64
  sg_chk sg_write_buf_scr sg_f_atk us 203
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 61 203

  note NEG-9a: Trailing byte on OMSAT1
  zr = sg_load_scr_to_buf sg_f_prf
  put sg_buf us 0
  sg_chk sg_write_buf_scr sg_f_atk add us 1 204
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 60 204

  note NEG-10a: Truncated OMSAT1
  zr = sg_load_scr_to_buf sg_f_prf
  sg_chk sg_write_buf_scr sg_f_atk sub us 1 205
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 60 205

  note NEG-11a: 1-bit Ed25519 signature flip in OMSAT1
  zr = sg_load_scr_to_buf sg_f_prf
  sg_flip_buf_bit sub us 1
  sg_chk sg_write_buf_scr sg_f_atk us 206
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 62 206

  note NEG-12: Wrong --pubkey pin on valid OMSAT1
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_prf true 62 207

  note NEG-9b & NEG-11b & NEG-17b on OMSR01 receipt
  sz_rc = sg_load_scr_to_buf sg_f_rcpt
  sg_chk eq sz_rc 352 208
  put sg_buf 352 0
  sg_chk sg_write_buf_scr sg_f_atk 353 209
  sg_ctrl eq sg_run_check_rcpt sg_f_atk sg_f_cnf sg_f_prf 60 209

  zr = sg_load_scr_to_buf sg_f_rcpt
  sg_flip_buf_bit 300
  sg_chk sg_write_buf_scr sg_f_atk 352 210
  sg_ctrl eq sg_run_check_rcpt sg_f_atk sg_f_cnf sg_f_prf 62 210

  zr = sg_load_scr_to_buf sg_f_rcpt
  sg_flip_buf_bit 0
  sg_chk sg_write_buf_scr sg_f_atk 352 211
  sg_ctrl eq sg_run_check_rcpt sg_f_atk sg_f_cnf sg_f_prf 60 211
end

fn sg_atk_omdr01 to void
  note UNSAT container attacks on PHP(5,4)
  sg_gen_php 5 4 false
  sg_chk sg_cnf_write sg_f_cnf 212
  sg_chk eq sg_run_solve sg_f_cnf sg_f_prf true false 20 212
  sz_d = sg_load_scr_to_buf sg_f_prf
  sg_chk gt sz_d 192 213
  if le sz_d 192
    ret
  end
  ud = ulong sz_d

  note NEG-9c: Trailing byte on OMDR01
  put sg_buf ud 0
  sg_chk sg_write_buf_scr sg_f_atk add ud 1 214
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 60 214

  note NEG-10b: Truncated OMDR01
  zr = sg_load_scr_to_buf sg_f_prf
  sg_chk sg_write_buf_scr sg_f_atk sub ud 1 215
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 60 215

  note NEG-11c: 1-bit Ed25519 sig flip on OMDR01
  zr = sg_load_scr_to_buf sg_f_prf
  sg_flip_buf_bit sub ud 1
  sg_chk sg_write_buf_scr sg_f_atk ud 216
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 62 216

  note NEG-17a: 1-bit magic flip on OMDR01
  zr = sg_load_scr_to_buf sg_f_prf
  sg_flip_buf_bit 0
  sg_chk sg_write_buf_scr sg_f_atk ud 217
  sg_ctrl eq sg_run_check_verify sg_f_cnf sg_f_atk false 60 217

  note NEG-13: Cross-CNF replay (PHP54 proof verified against K5 CNF)
  sg_gen_k5_4col
  sg_chk sg_cnf_write sg_f_cnf2 218
  sg_ctrl eq sg_run_check_verify sg_f_cnf2 sg_f_prf false 61 218
end

fn sg_atk_raw_drat to void
  note NEG-3, NEG-5a, NEG-7, NEG-16: Raw ASCII DRAT attacks
  sg_chk sg_write_text_scr sg_f_cnf sg_txt_rat_bad 219
  sg_chk sg_write_text_scr sg_f_drat sg_txt_bad_rup 219
  sg_ctrl eq sg_run_check_drat sg_f_cnf sg_f_drat 65 219

  sg_chk sg_write_text_scr sg_f_cnf2 sg_txt_php32 220
  sg_chk sg_write_text_scr sg_f_drat sg_txt_no_emp 220
  sg_ctrl eq sg_run_check_drat sg_f_cnf2 sg_f_drat 66 220

  sg_gen_php 5 4 false
  sg_chk sg_cnf_write sg_f_cnf2 221
  sg_chk sg_write_text_scr sg_f_drat sg_txt_bad_lit 221
  sg_ctrl eq sg_run_check_drat sg_f_cnf2 sg_f_drat 64 221
end

fn sg_run_container_attacks to void
  sg_atk_omsat1_and_rcpt
  sg_atk_omdr01
  sg_atk_raw_drat
end

fn sg_mut_run is_sat bool exp_solve ulong exp_chk ulong tag ulong to void
  if not sg_mut_compile
    sg_fail tag
    ret
  end
  if is_sat
    sg_gen_petersen_3col
  else
    sg_gen_php 5 4 false
  end
  sg_chk sg_cnf_write sg_f_cnf tag
  sg_use_scr_bin sg_f_mb
  sg_av_clr
  sg_av_cur
  sg_av_lit sg_c_solve
  sg_av_lit sg_fl_in
  zp = sg_set_pa_scr sg_f_cnf
  sg_av_pa
  sg_av_lit sg_fl_out
  zp = sg_set_pa_scr sg_f_prf
  sg_av_pa
  s_rc = sg_spawn_cur
  sg_chk eq s_rc exp_solve tag

  sg_use_scr_bin sg_f_chk2
  c_rc = sg_run_check_verify sg_f_cnf sg_f_prf false
  if eq c_rc exp_chk
    put sg_mut_kills 0 add get sg_mut_kills 0 1
    sg_ctrl true tag
  else
    sg_ctrl false tag
  end
end

fn sg_mut_solve_and_check old_s view uchar * new_s view uchar * tag ulong to bool
  sg_mut_reset
  if not sg_mut_patch old_s new_s
    sg_fail tag
    ret false
  end
  ret true
end

fn sg_run_solver_mutants to void
  note M1: Live solver mutant flips val[1] in signed OMSAT1
  if sg_mut_solve_and_check sg_m1_old sg_m1_new 301
    sg_mut_run true 10 63 301
  end

  note M2: Live solver mutant injects forged non-RUP clause [1] in signed OMDR01
  if sg_mut_solve_and_check sg_m2_old sg_m2_new 302
    sg_mut_run false 20 65 302
  end

  note M3: Live solver mutant drops last clause of PHP(5,4) and emits signed fake SAT OMSAT1
  if sg_mut_solve_and_check sg_m3_old sg_m3_new 303
    sg_mut_run false 10 63 303
  end

  note M4: Live solver mutant omits final empty clause [] in signed OMDR01
  if sg_mut_solve_and_check sg_m4_old sg_m4_new 304
    sg_mut_run false 20 66 304
  end

  note M5: Live solver mutant writes invalid witness byte 2 in signed OMSAT1
  if sg_mut_solve_and_check sg_m5_old sg_m5_new 305
    sg_mut_run true 10 63 305
  end

  note M6: Live solver mutant writes invalid LRAT hint ID 99999 in signed OMDR01
  if sg_mut_solve_and_check sg_m6_old sg_m6_new 306
    sg_mut_run false 20 67 306
  end
end

fn sg_run_omc_suite to bool
  if not sg_verify_omc_pin
    sg_werr sg_e_pin
    ret false
  end
  chk_len = sg_build_chk_src
  sg_chk gt chk_len 10000 1
  if le chk_len 10000
    ret true
  end
  det_chk = sg_check_2x_det 0 2

  cdcl_len = sg_build_cdcl_src
  sg_chk gt cdcl_len 10000 10
  if le cdcl_len 10000
    ret true
  end
  det_cdcl = sg_check_2x_det 1 11
  if and det_chk det_cdcl
    put sg_cmp_ok 0 1
  end

  sg_run_positive true
  sg_run_container_attacks
  sg_run_solver_mutants
  ret true
end

fn sg_arg_eq idx ulong lit view uchar * to bool
  rn = argread idx sg_arg 0 1020
  if ne rn long len lit
    ret false
  end
  for i ulong len lit bound 32
    if ne get sg_arg i get lit i
      ret false
    end
  end
  ret true
end

fn sg_copy_lit_to s view uchar * which ulong to void
  n = len s
  for i ulong n bound 1024
    b = get s i
    if eq which 2
      put sg_scr i b
    end
    if eq which 3
      put sg_cdcl_bin i b
    end
    if eq which 4
      put sg_chk_bin i b
    end
  end
  if eq which 2
    put sg_scr_l 0 n
  end
  if eq which 3
    put sg_cdcl_l 0 n
  end
  if eq which 4
    put sg_chk_l 0 n
  end
end

fn main to int
  put sg_checks 0 0
  put sg_ctrls 0 0
  put sg_caught 0 0
  put sg_mut_kills 0 0
  put sg_fails 0 0
  put sg_cmp_ok 0 0

  ac = ulong argcnt
  if eq ac 4
    put sg_omc_l 0 sg_arg_to_glob 1 0
    put sg_root_l 0 sg_arg_to_glob 2 1
    put sg_scr_l 0 sg_arg_to_glob 3 2
    if or eq get sg_omc_l 0 0 or eq get sg_root_l 0 0 eq get sg_scr_l 0 0
      sg_werr sg_u_msg
      ret SG_ERR_ARG
    end
    z = makedir sg_scr 0 get sg_scr_l 0 493
    if not sg_run_omc_suite
      ret SG_ERR_PIN
    end
  else
    matched5 = false
    if eq ac 5
      matched5 = sg_arg_eq 1 sg_f_bins
    end
    if matched5
      put sg_cdcl_l 0 sg_arg_to_glob 2 3
      put sg_chk_l 0 sg_arg_to_glob 3 4
      put sg_scr_l 0 sg_arg_to_glob 4 2
      if or eq get sg_cdcl_l 0 0 or eq get sg_chk_l 0 0 eq get sg_scr_l 0 0
        sg_werr sg_u_msg
        ret SG_ERR_ARG
      end
      z = makedir sg_scr 0 get sg_scr_l 0 493
      sg_run_positive false
      sg_run_container_attacks
    else
      if eq ac 1
        sg_copy_lit_to sg_def_cdcl 3
        sg_copy_lit_to sg_def_chk 4
        sg_copy_lit_to sg_def_scr 2
        z = makedir sg_scr 0 get sg_scr_l 0 493
        sg_run_positive false
        sg_run_container_attacks
      else
        sg_werr sg_u_msg
        ret SG_ERR_ARG
      end
    end
  end

  if ne get sg_fails 0 0
    ret 1
  end
  if ne get sg_caught 0 get sg_ctrls 0
    ret 1
  end
  sg_wrt sg_m_p1
  sg_num get sg_checks 0
  sg_wrt sg_m_p2
  sg_num get sg_ctrls 0
  sg_wrt sg_m_p3
  sg_num get sg_caught 0
  sg_wrt sg_m_p4
  sg_num get sg_mut_kills 0
  sg_wrt sg_m_p5
  sg_num get sg_cmp_ok 0
  sg_wrt sg_m_p6
  ret SG_OK
end

note apps/omega-sat/gate_sat.om
note Pure Seeded-OM-2 Verification Gate for Wave 5 omega-sat (CDCL SAT + Independent RUP/DRAT/LRAT Verifier).
note
note Compose after:
note   si/directives/om2.om seed/ng/sha256.om apps/omega-sat/gate_sat.om
note
note Usage:
note   gate_sat OMC_BIN REPO_ROOT SCRATCH_DIR
note   gate_sat --bins CDCL_BIN CHECK_BIN SCRATCH_DIR
note   gate_sat   (expects ./sat_cdcl and ./sat_check in CWD, scratch /tmp/omega-sat-gate)
note
note Zero C, zero Python, zero Rust, zero gcc, zero GPU device writes (hw_writes=0).

const SG_OK int 0
const SG_ERR_ARG int 1
const SG_ERR_PIN int 69

global sg_omc uchar 1024
global sg_omc_l ulong 1
global sg_root uchar 1024
global sg_root_l ulong 1

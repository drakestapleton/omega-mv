note Exact patch strings for live OMC solver-bypass mutants M1..M6
text sg_m1_old "    if eq vv SC_TRUE\n      b = uchar 1\n    end\n    put sc_prf add 64 v b"
text sg_m1_new "    if eq vv SC_TRUE\n      b = uchar 1\n    end\n    if eq v 0\n      b = uchar xor b 1\n    end\n    put sc_prf add 64 v b"
text sg_m2_old "  rc = sc_parse_and_load\n  if eq rc SC_EXIT_OK\n    rc = sc_solve_cdcl\n  end"
text sg_m2_new "  rc = sc_parse_and_load\n  if eq rc SC_EXIT_OK\n    put sc_learnt_n 0 1\n    put sc_learnt 0 2\n    put sc_uip_hn 0 0\n    put sc_l0_hn 0 0\n    put sc_flag_lrat 0 0\n    z_m2 = sc_emit_rup_step false\n    rc = sc_solve_cdcl\n  end"
text sg_m3_old "      read_cls = add read_cls 1\n      if gt read_cls ncls\n        ret SC_EXIT_PARSE\n      end\n      rc = sc_commit_parsed_clause read_cls"
text sg_m3_new "      read_cls = add read_cls 1\n      if gt read_cls ncls\n        ret SC_EXIT_PARSE\n      end\n      if eq read_cls ncls\n        put sc_parse_taut 0 1\n      end\n      rc = sc_commit_parsed_clause read_cls"
text sg_m4_old "      if eq get sc_dl 0 0\n        sc_analyze_l0 confl\n        if not sc_emit_rup_step ne get sc_flag_lrat 0 0\n          ret SC_EXIT_LIMIT\n        end\n        ret SC_EXIT_UNSAT\n      end"
text sg_m4_new "      if eq get sc_dl 0 0\n        sc_analyze_l0 confl\n        ret SC_EXIT_UNSAT\n      end"

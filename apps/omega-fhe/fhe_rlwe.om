note ==== Section 3: Printing, Byte Packing & CLI Helpers ====

fn fh_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn fh_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn fh_u64 v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put fh_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 fh_dig p sub 24 p
      ret
    end
  end
end

fn fh_hex_dig b uchar to void
  hi = shr b 4
  lo = and b 15
  hc = uchar add 48 hi
  if ge hi 10
    hc = uchar add 87 hi
  end
  lc = uchar add 48 lo
  if ge lo 10
    lc = uchar add 87 lo
  end
  put fh_dig 0 hc
  put fh_dig 1 lc
  z = write 1 fh_dig 0 2
end

fn fh_hex32_sh to void
  for i ulong 32
    fh_hex_dig get sh_dig i
  end
end

fn fh_print_fail code int to int
  fh_werr fh_m_fail
  x = ulong code
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put fh_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 2 fh_dig p sub 24 p
      z2 = write 2 fh_nl 0 1
      ret code
    end
  end
  ret code
end

fn fh_put_u16 p ulong v ulong to void
  put fh_buf p uchar and v 255
  put fh_buf add p 1 uchar and shr v 8 255
end

fn fh_get_u16 p ulong to ulong
  b0 = ulong get fh_buf p
  b1 = ulong get fh_buf add p 1
  ret or b0 shl b1 8
end

fn fh_put_u32 p ulong v ulong to void
  for i ulong 4
    put fh_buf add p i uchar and shr v mul i 8 255
  end
end

fn fh_get_u32 p ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get fh_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn fh_put_u64 p ulong v ulong to void
  for i ulong 8
    put fh_buf add p i uchar and shr v mul i 8 255
  end
end

fn fh_get_u64 p ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get fh_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn fh_arg_eq idx ulong lit view uchar * to bool
  rn = argread idx fh_arg 0 1020
  if ne rn long len lit
    ret false
  end
  for i ulong len lit bound 64
    if ne get fh_arg i get lit i
      ret false
    end
  end
  ret true
end

fn fh_parse_u64 idx ulong to bool
  rn = argread idx fh_arg 0 64
  if le rn 0
    ret false
  end
  v = ulong 0
  for i ulong ulong rn bound 64
    ch = ulong get fh_arg i
    if or lt ch 48 gt ch 57
      ret false
    end
    d = sub ch 48
    lim = div sub 0xffffffffffffffff d 10
    if gt v lim
      ret false
    end
    v = add mul v 10 d
  end
  put fh_meta 14 v
  ret true
end

fn fh_copy_arg_path idx ulong slot ulong to bool
  rn = argread idx fh_arg 0 1020
  if le rn 0
    ret false
  end
  u = ulong rn
  for i ulong u bound 1024
    b = get fh_arg i
    if eq slot 0
      put fh_p_sk i b
    end
    if eq slot 1
      put fh_p_evk i b
    end
    if eq slot 2
      put fh_p_in i b
    end
    if eq slot 3
      put fh_p_ina i b
    end
    if eq slot 4
      put fh_p_inb i b
    end
    if eq slot 5
      put fh_p_out i b
    end
  end
  if eq slot 0
    put fh_p_sk_l 0 u
  end
  if eq slot 1
    put fh_p_evk_l 0 u
  end
  if eq slot 2
    put fh_p_in_l 0 u
  end
  if eq slot 3
    put fh_p_ina_l 0 u
  end
  if eq slot 4
    put fh_p_inb_l 0 u
  end
  if eq slot 5
    put fh_p_out_l 0 u
  end
  ret true
end

fn fh_parse_poly_arg idx ulong to int
  rn = argread idx fh_arg 0 1020
  if le rn 0
    ret FH_ERR_IO
  end
  for i ulong FH_N
    put fh_msg i 0
  end
  u = ulong rn
  cidx = ulong 0
  acc = ulong 0
  has_d = false
  for i ulong u bound 1024
    ch = ulong get fh_arg i
    if eq ch 44
      if or not has_d ge cidx FH_N
        ret FH_ERR_IO
      end
      if ge acc FH_T
        ret FH_ERR_PLAINTEXT
      end
      put fh_msg cidx acc
      cidx = add cidx 1
      acc = ulong 0
      has_d = false
    else
      if or lt ch 48 gt ch 57
        ret FH_ERR_IO
      end
      if gt acc 1000000
        ret FH_ERR_PLAINTEXT
      end
      acc = add mul acc 10 sub ch 48
      has_d = true
    end
  end
  if or not has_d ge cidx FH_N
    ret FH_ERR_IO
  end
  if ge acc FH_T
    ret FH_ERR_PLAINTEXT
  end
  put fh_msg cidx acc
  put fh_meta 13 1
  ret FH_OK
end

note ==== Section 4: Exact 64/128-bit Arithmetic & Montgomery Modular Core ====

fn fh_u128_mul a ulong b ulong to void
  p00 = mul and a 0xffffffff and b 0xffffffff
  p01 = mul and a 0xffffffff shr b 32
  p10 = mul shr a 32 and b 0xffffffff
  p11 = mul shr a 32 shr b 32
  t = shr p00 32
  t = add t and p01 0xffffffff
  t = add t and p10 0xffffffff
  put fh_u_lo 0 or and p00 0xffffffff shl and t 0xffffffff 32
  hi = add p11 shr p01 32
  hi = add hi shr p10 32
  hi = add hi shr t 32
  put fh_u_hi 0 hi
end

fn fh_u128_add_to alo ulong ahi ulong blo ulong bhi ulong to void
  lo = add alo blo
  c = ulong 0
  if lt lo alo
    c = ulong 1
  end
  hi = add add ahi bhi c
  put fh_u_lo 0 lo
  put fh_u_hi 0 hi
end

fn fh_u128_sub alo ulong ahi ulong blo ulong bhi ulong to void
  lo = sub alo blo
  b = ulong 0
  if lt alo blo
    b = ulong 1
  end
  hi = sub sub ahi bhi b
  put fh_u_lo 0 lo
  put fh_u_hi 0 hi
end

fn fh_u128_lt alo ulong ahi ulong blo ulong bhi ulong to bool
  if lt ahi bhi
    ret true
  end
  if gt ahi bhi
    ret false
  end
  ret lt alo blo
end

note Exact Montgomery REDC: (a * b * 2^-64) mod m, valid for all odd m < 2^63 and a,b < m
fn fh_mont_mul a ulong b ulong m ulong mp ulong to ulong
  fh_u128_mul a b
  alo = get fh_u_lo 0
  ahi = get fh_u_hi 0
  k = mul alo mp
  fh_u128_mul k m
  mlo = get fh_u_lo 0
  t = add ahi get fh_u_hi 0
  slo = add alo mlo
  if lt slo alo
    t = add t 1
  end
  if ge t m
    ret sub t m
  end
  ret t
end

fn fh_mod_add a ulong b ulong m ulong to ulong
  s = add a b
  if ge s m
    ret sub s m
  end
  ret s
end

fn fh_mod_sub a ulong b ulong m ulong to ulong
  if ge a b
    ret sub a b
  end
  ret sub m sub b a
end

fn fh_mod_neg a ulong m ulong to ulong
  if eq a 0
    ret 0
  end
  ret sub m a
end

fn fh_mod_mul_slot slot ulong a ulong b ulong to ulong
  base = mul slot 8
  m = get fh_mod_cfg base
  mp = get fh_mod_cfg add base 1
  r2 = get fh_mod_cfg add base 2
  ab = fh_mont_mul a b m mp
  ret fh_mont_mul ab r2 m mp
end

fn fh_mod_pow_slot slot ulong basev ulong e ulong to ulong
  m = get fh_mod_cfg mul slot 8
  mp = get fh_mod_cfg add mul slot 8 1
  r2 = get fh_mod_cfg add mul slot 8 2
  res = fh_mont_mul 1 r2 m mp
  b = fh_mont_mul basev r2 m mp
  k = e
  for i ulong 64
    if eq and k 1 1
      res = fh_mont_mul res b m mp
    end
    b = fh_mont_mul b b m mp
    k = shr k 1
    if eq k 0
      ret fh_mont_mul res 1 m mp
    end
  end
  ret fh_mont_mul res 1 m mp
end

fn fh_slot_init slot ulong m ulong mp ulong r2 ulong to void
  b = mul slot 8
  put fh_mod_cfg b m
  put fh_mod_cfg add b 1 mp
  put fh_mod_cfg add b 2 r2
end

fn fh_slot_roots slot ulong psi ulong ipsi ulong om ulong to void
  b = mul slot 8
  put fh_mod_cfg add b 3 psi
  put fh_mod_cfg add b 4 ipsi
  put fh_mod_cfg add b 5 om
end

fn fh_slot_twiddles slot ulong iom ulong invn ulong to void
  b = mul slot 8
  put fh_mod_cfg add b 6 iom
  put fh_mod_cfg add b 7 invn
  m = get fh_mod_cfg b
  mp = get fh_mod_cfg add b 1
  r2 = get fh_mod_cfg add b 2
  if true
    p_cur = ulong 1
    ip_cur = ulong 1
    off = mul slot 64
    for i ulong FH_N
      put fh_psi_r2 add off i fh_mod_mul_slot slot p_cur r2
      put fh_ipsi_invn add off i fh_mod_mul_slot slot ip_cur invn
      p_cur = fh_mod_mul_slot slot p_cur get fh_mod_cfg add b 3
      ip_cur = fh_mod_mul_slot slot ip_cur get fh_mod_cfg add b 4
    end
  end
  len_cur = ulong 2
  woff = mul slot 8
  for st ulong 6
    exp = div FH_N len_cur
    w = fh_mod_pow_slot slot get fh_mod_cfg add b 5 exp
    iw = fh_mod_pow_slot slot iom exp
    put fh_w_mont add woff st fh_mont_mul w r2 m mp
    put fh_iw_mont add woff st fh_mont_mul iw r2 m mp
    len_cur = shl len_cur 1
  end
end

fn fh_init_tables to void
  if ne get fh_tables_ready 0 0
    ret
  end
  put fh_tables_ready 0 1
  fh_slot_init 0 FH_Q FH_Q_PRIME FH_Q_R2
  fh_slot_roots 0 FH_PSI64 FH_INV_PSI64 FH_OMEGA64
  fh_slot_twiddles 0 FH_INV_OMEGA64 FH_INV64

  fh_slot_init 1 FH_P1 FH_P1_PRIME FH_P1_R2
  fh_slot_roots 1 FH_P1_PSI64 FH_P1_INV_PSI64 FH_P1_OMEGA64
  fh_slot_twiddles 1 FH_P1_INV_OMEGA64 FH_P1_INV64

  fh_slot_init 2 FH_P2 FH_P2_PRIME FH_P2_R2
  fh_slot_roots 2 FH_P2_PSI64 FH_P2_INV_PSI64 FH_P2_OMEGA64
  fh_slot_twiddles 2 FH_P2_INV_OMEGA64 FH_P2_INV64
end

note ==== Section 5: Parameterized Negacyclic NTT (q, p1, p2) & CRT-NTT Tensor ====

fn fh_bitrev_poly buf_id ulong to void
  for i ulong FH_N
    r = ulong 0
    x = i
    for b ulong FH_LOG_N
      r = or shl r 1 and x 1
      x = shr x 1
    end
    if lt i r
      if eq buf_id 0
        tv = get fh_ntt_a i
        put fh_ntt_a i get fh_ntt_a r
        put fh_ntt_a r tv
      end
      if eq buf_id 1
        tv = get fh_ntt_b i
        put fh_ntt_b i get fh_ntt_b r
        put fh_ntt_b r tv
      end
      if eq buf_id 2
        tv = get fh_p1_a i
        put fh_p1_a i get fh_p1_a r
        put fh_p1_a r tv
      end
      if eq buf_id 3
        tv = get fh_p1_b i
        put fh_p1_b i get fh_p1_b r
        put fh_p1_b r tv
      end
      if eq buf_id 4
        tv = get fh_p2_a i
        put fh_p2_a i get fh_p2_a r
        put fh_p2_a r tv
      end
      if eq buf_id 5
        tv = get fh_p2_b i
        put fh_p2_b i get fh_p2_b r
        put fh_p2_b r tv
      end
    end
  end
end

fn fh_bget buf_id ulong idx ulong to ulong
  if eq buf_id 0
    ret get fh_ntt_a idx
  end
  if eq buf_id 1
    ret get fh_ntt_b idx
  end
  if eq buf_id 2
    ret get fh_p1_a idx
  end
  if eq buf_id 3
    ret get fh_p1_b idx
  end
  if eq buf_id 4
    ret get fh_p2_a idx
  end
  ret get fh_p2_b idx
end

fn fh_bput buf_id ulong idx ulong v ulong to void
  if eq buf_id 0
    put fh_ntt_a idx v
    ret
  end
  if eq buf_id 1
    put fh_ntt_b idx v
    ret
  end
  if eq buf_id 2
    put fh_p1_a idx v
    ret
  end
  if eq buf_id 3
    put fh_p1_b idx v
    ret
  end
  if eq buf_id 4
    put fh_p2_a idx v
    ret
  end
  put fh_p2_b idx v
end

fn fh_bstep buf_id ulong slot ulong start ulong half ulong wlen_m ulong to void
  m = get fh_mod_cfg mul slot 8
  mp = get fh_mod_cfg add mul slot 8 1
  w = fh_mont_mul 1 get fh_mod_cfg add mul slot 8 2 m mp
  for j ulong half bound 64
    if true
      i0 = add start j
      i1 = add i0 half
      u = fh_bget buf_id i0
      v = fh_mont_mul fh_bget buf_id i1 w m mp
      fh_bput buf_id i0 fh_mod_add u v m
      fh_bput buf_id i1 fh_mod_sub u v m
    end
    w = fh_mont_mul w wlen_m m mp
  end
end

fn fh_ntt_fwd buf_id ulong slot ulong to void
  fh_init_tables
  m = get fh_mod_cfg mul slot 8
  mp = get fh_mod_cfg add mul slot 8 1
  poff = mul slot 64
  for i ulong FH_N
    v = fh_bget buf_id i
    fh_bput buf_id i fh_mont_mul v get fh_psi_r2 add poff i m mp
  end
  fh_bitrev_poly buf_id
  half = ulong 1
  woff = mul slot 8
  for st ulong 6
    wlen_m = get fh_w_mont add woff st
    step = shl half 1
    start = ulong 0
    while lt start FH_N bound 64
      fh_bstep buf_id slot start half wlen_m
      start = add start step
    end
    half = step
  end
end

fn fh_ntt_inv buf_id ulong slot ulong to void
  fh_init_tables
  m = get fh_mod_cfg mul slot 8
  mp = get fh_mod_cfg add mul slot 8 1
  fh_bitrev_poly buf_id
  half = ulong 1
  woff = mul slot 8
  for st ulong 6
    wlen_m = get fh_iw_mont add woff st
    step = shl half 1
    start = ulong 0
    while lt start FH_N bound 64
      fh_bstep buf_id slot start half wlen_m
      start = add start step
    end
    half = step
  end
  poff = mul slot 64
  for i ulong FH_N
    v = fh_bget buf_id i
    fh_bput buf_id i fh_mont_mul v get fh_ipsi_invn add poff i m mp
  end
end

note Compute fh_ntt_a = fh_ntt_a * fh_ntt_b in Z_q[X]/(X^N+1) via NTT
fn fh_poly_mul_ntt_q to void
  fh_ntt_fwd 0 0
  fh_ntt_fwd 1 0
  m = FH_Q
  mp = FH_Q_PRIME
  for i ulong FH_N
    av = get fh_ntt_a i
    bv = get fh_ntt_b i
    put fh_ntt_a i fh_mont_mul av bv m mp
  end
  fh_ntt_inv 0 0
end

note Divide 128-bit unsigned (nhi, nlo) by FH_Q (< 2^56) and return (quotient mod FH_Q)
fn fh_u128_div_q_mod nhi ulong nlo ulong to ulong
  qhi = div nhi FH_Q
  r = rem nhi FH_Q
  qlo = ulong 0
  for b ulong 64
    sh = sub 63 b
    bit = and shr nlo sh 1
    r = or shl r 1 bit
    if ge r FH_Q
      r = sub r FH_Q
      qlo = or qlo shl ulong 1 sh
    end
  end
  qh_m = rem qhi FH_Q
  ql_m = rem qlo FH_Q
  t1 = fh_mod_mul_slot 0 qh_m FH_R_MOD_Q
  ret fh_mod_add t1 ql_m FH_Q
end

note Center value v in [0, FH_Q) to (sign, mag) where sign=1 means negative
fn fh_center_q v ulong to void
  if le v FH_HALF_Q
    put fh_u_sg 0 0
    put fh_u_lo 0 v
  else
    put fh_u_sg 0 1
    put fh_u_lo 0 sub FH_Q v
  end
end

note Reconstruct CRT (x1 mod p1, x2 mod p2) -> signed 128-bit -> round(t * X / q) mod q
fn fh_crt_round_scale x1 ulong x2 ulong to ulong
  if true
    h = fh_mod_sub rem x1 FH_P2 x2 FH_P2
    fh_u128_mul FH_P1 h
    fh_u128_add_to get fh_u_lo 0 get fh_u_hi 0 x1 0
  end
  x_lo = get fh_u_lo 0
  x_hi = get fh_u_hi 0
  sg = ulong 0
  if fh_u128_lt FH_P12H_LO FH_P12H_HI x_lo x_hi
    sg = ulong 1
    fh_u128_sub FH_P12_LO FH_P12_HI x_lo x_hi
    x_lo = get fh_u_lo 0
    x_hi = get fh_u_hi 0
  end
  if true
    s8_lo = shl x_lo 8
    s8_hi = or shl x_hi 8 shr x_lo 56
    fh_u128_add_to s8_lo s8_hi x_lo x_hi
    fh_u128_add_to get fh_u_lo 0 get fh_u_hi 0 FH_HALF_Q 0
  end
  qm = fh_u128_div_q_mod get fh_u_hi 0 get fh_u_lo 0
  if eq sg 1
    ret fh_mod_neg qm FH_Q
  end
  ret qm
end

note Exact integer polynomial product A * B in Z[X]/(X^N+1) scaled by round(t * P / q) mod q
note Inputs A, B in fh_tmp_p, fh_tmp_q (canonical < q); output written to fh_d0/d1/d2 selector
fn fh_zz_mul_load_centered to void
  for i ulong FH_N
    fh_center_q get fh_tmp_p i
    sg1 = get fh_u_sg 0
    m1 = get fh_u_lo 0
    v1_1 = rem m1 FH_P1
    v1_2 = rem m1 FH_P2
    if eq sg1 1
      v1_1 = fh_mod_neg v1_1 FH_P1
      v1_2 = fh_mod_neg v1_2 FH_P2
    end
    put fh_p1_a i v1_1
    put fh_p2_a i v1_2

    fh_center_q get fh_tmp_q i
    sg2 = get fh_u_sg 0
    m2 = get fh_u_lo 0
    v2_1 = rem m2 FH_P1
    v2_2 = rem m2 FH_P2
    if eq sg2 1
      v2_1 = fh_mod_neg v2_1 FH_P1
      v2_2 = fh_mod_neg v2_2 FH_P2
    end
    put fh_p1_b i v2_1
    put fh_p2_b i v2_2
  end
end

fn fh_zz_mul_finish_crt dst ulong to void
  fh_ntt_fwd 2 1
  fh_ntt_fwd 3 1
  for i ulong FH_N
    put fh_p1_a i fh_mont_mul get fh_p1_a i get fh_p1_b i FH_P1 FH_P1_PRIME
  end
  fh_ntt_inv 2 1

  fh_ntt_fwd 4 2
  fh_ntt_fwd 5 2
  for i ulong FH_N
    put fh_p2_a i fh_mont_mul get fh_p2_a i get fh_p2_b i FH_P2 FH_P2_PRIME
  end
  fh_ntt_inv 4 2

  for i ulong FH_N
    qv = fh_crt_round_scale get fh_p1_a i get fh_p2_a i
    if eq dst 0
      put fh_d0 i qv
    else
      if eq dst 2
        put fh_d2 i qv
      else
        put fh_d1 i qv
      end
    end
  end
end

note Compute exact Z[X]/(X^N+1) product of (tmp_p*tmp_q + tmp_r*d0_src) for c0*c1' + c1*c0'
fn fh_zz_muladd_p1 to void
  fh_zz_mul_load_centered
  fh_ntt_fwd 2 1
  fh_ntt_fwd 3 1
  for i ulong FH_N
    put fh_p1_a i fh_mont_mul get fh_p1_a i get fh_p1_b i FH_P1 FH_P1_PRIME
  end
  fh_ntt_inv 2 1

  fh_ntt_fwd 4 2
  fh_ntt_fwd 5 2
  for i ulong FH_N
    put fh_p2_a i fh_mont_mul get fh_p2_a i get fh_p2_b i FH_P2 FH_P2_PRIME
  end
  fh_ntt_inv 4 2
  for i ulong FH_N
    put fh_dig_c2 i get fh_p1_a i
    put fh_r_acc0 i get fh_p2_a i
  end
end

fn fh_zz_muladd_p2 to void
  fh_zz_mul_load_centered
  fh_ntt_fwd 2 1
  fh_ntt_fwd 3 1
  for i ulong FH_N
    put fh_p1_a i fh_mont_mul get fh_p1_a i get fh_p1_b i FH_P1 FH_P1_PRIME
  end
  fh_ntt_inv 2 1

  fh_ntt_fwd 4 2
  fh_ntt_fwd 5 2
  for i ulong FH_N
    put fh_p2_a i fh_mont_mul get fh_p2_a i get fh_p2_b i FH_P2 FH_P2_PRIME
  end
  fh_ntt_inv 4 2

  for i ulong FH_N
    s1 = fh_mod_add get fh_dig_c2 i get fh_p1_a i FH_P1
    s2 = fh_mod_add get fh_r_acc0 i get fh_p2_a i FH_P2
    put fh_d1 i fh_crt_round_scale s1 s2
  end
end

note ==== Section 6: Deterministic SHA-256 PRNG & BFV KeyGen / Encrypt / Eval / Decrypt ====

fn fh_prng_init seed_val ulong tag ulong to void
  put fh_prng_ctr 0 0
  n = len fh_t_prdom
  for i ulong n bound 32
    put sh_dat i get fh_t_prdom i
  end
  for i ulong 8
    put sh_dat add n i uchar and shr seed_val mul i 8 255
    put sh_dat add add n 8 i uchar and shr tag mul i 8 255
  end
  sh_all add n 16
  for i ulong 32
    put fh_prng_seed i get sh_dig i
  end
end

fn fh_prng_next64 to ulong
  for i ulong 32
    put sh_dat i get fh_prng_seed i
  end
  ctr = get fh_prng_ctr 0
  for i ulong 8
    put sh_dat add 32 i uchar and shr ctr mul i 8 255
  end
  put fh_prng_ctr 0 add ctr 1
  sh_all 40
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get sh_dig i mul i 8
  end
  ret v
end

fn fh_sample_uniform_q_tmp_p to void
  for i ulong FH_N
    r = fh_prng_next64
    put fh_tmp_p i rem r FH_Q
  end
end

fn fh_sample_err2_tmp_p to void
  for i ulong FH_N
    r = rem fh_prng_next64 5
    if eq r 0
      put fh_tmp_p i 0
    end
    if eq r 1
      put fh_tmp_p i 1
    end
    if eq r 2
      put fh_tmp_p i 2
    end
    if eq r 3
      put fh_tmp_p i sub FH_Q 1
    end
    if eq r 4
      put fh_tmp_p i sub FH_Q 2
    end
  end
end

fn fh_sample_ternary_tmp_p to void
  for i ulong FH_N
    r = rem fh_prng_next64 3
    if eq r 0
      put fh_tmp_p i 0
    end
    if eq r 1
      put fh_tmp_p i 1
    end
    if eq r 2
      put fh_tmp_p i sub FH_Q 1
    end
  end
end

fn fh_sample_sk_wt16 seed_val ulong to void
  fh_prng_init seed_val 1
  for i ulong FH_N
    put fh_sk i 0
  end
  wt = ulong 0
  while lt wt 16 bound 1024
    idx = rem fh_prng_next64 FH_N
    if eq get fh_sk idx 0
      sgn = and fh_prng_next64 1
      if eq sgn 0
        put fh_sk idx 1
      else
        put fh_sk idx sub FH_Q 1
      end
      wt = add wt 1
    end
  end
end

fn fh_keygen seed_val ulong to void
  fh_init_tables
  fh_sample_sk_wt16 seed_val

  note Derive Ed25519 container signing seed from seed_val
  nd = len fh_t_eddom
  for i ulong nd bound 32
    put sh_dat i get fh_t_eddom i
  end
  for i ulong 8
    put sh_dat add nd i uchar and shr seed_val mul i 8 255
  end
  sh_all add nd 8
  for i ulong 32
    put fh_ed_seed i get sh_dig i
  end

  note Public key pk = (-a*s + e_pk, a)
  fh_prng_init seed_val 2
  fh_sample_uniform_q_tmp_p
  for i ulong FH_N
    v = get fh_tmp_p i
    put fh_pk1 i v
    put fh_ntt_a i v
    put fh_ntt_b i get fh_sk i
  end
  fh_poly_mul_ntt_q
  fh_sample_err2_tmp_p
  for i ulong FH_N
    asv = get fh_ntt_a i
    ev = get fh_tmp_p i
    put fh_pk0 i fh_mod_add fh_mod_neg asv FH_Q ev FH_Q
  end

  note Relinearization keys rk[k] = (-a_k*s + e_k + T^k * s^2, a_k) for k=0..6, T=256
  for i ulong FH_N
    put fh_ntt_a i get fh_sk i
    put fh_ntt_b i get fh_sk i
  end
  fh_poly_mul_ntt_q
  for i ulong FH_N
    put fh_tmp_q i get fh_ntt_a i
  end

  fh_prng_init seed_val 3
  tpow = ulong 1
  for k ulong FH_RELIN_K
    fh_sample_uniform_q_tmp_p
    for i ulong FH_N
      ak = get fh_tmp_p i
      put fh_rk1 add mul k FH_N i ak
      put fh_ntt_a i ak
      put fh_ntt_b i get fh_sk i
    end
    fh_poly_mul_ntt_q
    fh_sample_err2_tmp_p
    for i ulong FH_N
      ask = get fh_ntt_a i
      ek = get fh_tmp_p i
      s2t = fh_mod_mul_slot 0 get fh_tmp_q i tpow
      r0 = fh_mod_add fh_mod_neg ask FH_Q fh_mod_add ek s2t FH_Q FH_Q
      put fh_rk0 add mul k FH_N i r0
    end
    tpow = fh_mod_mul_slot 0 tpow FH_RELIN_T
  end
end

fn fh_encrypt_with_evk seed_val ulong to void
  fh_init_tables
  fh_prng_init seed_val 4
  fh_sample_ternary_tmp_p
  for i ulong FH_N
    put fh_tmp_q i get fh_tmp_p i
    put fh_ntt_a i get fh_pk0 i
    put fh_ntt_b i get fh_tmp_p i
  end
  fh_poly_mul_ntt_q
  for i ulong FH_N
    put fh_cto0 i get fh_ntt_a i
    put fh_ntt_a i get fh_pk1 i
    put fh_ntt_b i get fh_tmp_q i
  end
  fh_poly_mul_ntt_q
  for i ulong FH_N
    put fh_cto1 i get fh_ntt_a i
  end
  fh_sample_err2_tmp_p
  for i ulong FH_N
    m = get fh_msg i
    dm = fh_mod_mul_slot 0 m FH_DELTA
    put fh_cto0 i fh_mod_add get fh_cto0 i fh_mod_add get fh_tmp_p i dm FH_Q FH_Q
  end
  fh_sample_err2_tmp_p
  for i ulong FH_N
    put fh_cto1 i fh_mod_add get fh_cto1 i get fh_tmp_p i FH_Q
  end
  put fh_meta 11 FH_E_FRESH
  put fh_meta 12 0
end

fn fh_eval_add to int
  na = get fh_meta 7
  nb = get fh_meta 9
  da = get fh_meta 8
  db = get fh_meta 10
  nout = add add na nb 1
  if gt nout FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  dout = da
  if gt db da
    dout = db
  end
  for i ulong FH_N
    put fh_cto0 i fh_mod_add get fh_cta0 i get fh_ctb0 i FH_Q
    put fh_cto1 i fh_mod_add get fh_cta1 i get fh_ctb1 i FH_Q
  end
  put fh_meta 11 nout
  put fh_meta 12 dout
  ret FH_OK
end

fn fh_eval_sub to int
  na = get fh_meta 7
  nb = get fh_meta 9
  da = get fh_meta 8
  db = get fh_meta 10
  nout = add add na nb 1
  if gt nout FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  dout = da
  if gt db da
    dout = db
  end
  for i ulong FH_N
    put fh_cto0 i fh_mod_sub get fh_cta0 i get fh_ctb0 i FH_Q
    put fh_cto1 i fh_mod_sub get fh_cta1 i get fh_ctb1 i FH_Q
  end
  put fh_meta 11 nout
  put fh_meta 12 dout
  ret FH_OK
end

fn fh_eval_const_mul scalar_c ulong to int
  fh_init_tables
  if ge scalar_c FH_T
    ret FH_ERR_PLAINTEXT
  end
  na = get fh_meta 7
  da = get fh_meta 8
  abs_c = scalar_c
  cq = scalar_c
  if gt scalar_c FH_HALF_T
    abs_c = sub FH_T scalar_c
    cq = sub FH_Q abs_c
  end
  nout = ulong 0
  if ne abs_c 0
    nout = add mul abs_c na abs_c
  end
  if gt nout FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  for i ulong FH_N
    put fh_cto0 i fh_mod_mul_slot 0 get fh_cta0 i cq
    put fh_cto1 i fh_mod_mul_slot 0 get fh_cta1 i cq
  end
  put fh_meta 11 nout
  put fh_meta 12 da
  ret FH_OK
end

fn fh_eval_add_const scalar_d ulong to int
  fh_init_tables
  if ge scalar_d FH_T
    ret FH_ERR_PLAINTEXT
  end
  na = get fh_meta 7
  nout = na
  if ne scalar_d 0
    nout = add na 1
  end
  if gt nout FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  for i ulong FH_N
    put fh_cto0 i get fh_cta0 i
    put fh_cto1 i get fh_cta1 i
  end
  if ne scalar_d 0
    dd = fh_mod_mul_slot 0 scalar_d FH_DELTA
    put fh_cto0 0 fh_mod_add get fh_cto0 0 dd FH_Q
  end
  put fh_meta 11 nout
  put fh_meta 12 get fh_meta 8
  ret FH_OK
end

note Sound worst-case BFV multiplicative noise bound
fn fh_calc_mul_noise e1 ulong e2 ulong to ulong
  if or gt e1 FH_MAX_NOISE gt e2 FH_MAX_NOISE
    ret add FH_MAX_NOISE 1
  end
  esum = add e1 e2
  if gt esum 20000000000000
    ret add FH_MAX_NOISE 1
  end
  t1 = mul 164480 esum
  fh_u128_mul e1 e2
  if true
    p_lo = get fh_u_lo 0
    p_hi = get fh_u_hi 0
    fh_u128_mul p_lo 16448
    l_lo = get fh_u_lo 0
    l_hi = get fh_u_hi 0
    fh_u128_mul p_hi 16448
    fh_u128_add_to l_lo add l_hi get fh_u_lo 0 0 0
  end
  t2 = fh_u128_div_q_mod get fh_u_hi 0 get fh_u_lo 0
  ret add add t1 t2 476681
end

note Balanced base-256 decomposition of centered fh_d2[i] into digit k in [0, FH_Q)
fn fh_relin_digit_step k ulong to void
  shift = mul k 8
  for i ulong FH_N
    put fh_dig_c2 i 0
  end
  for i ulong FH_N
    fh_center_q get fh_d2 i
    sg = get fh_u_sg 0
    mag = get fh_u_lo 0
    note Decompose signed value sequentially via fh_tmp_r
    put fh_tmp_r i mag
    if eq k 0
      put fh_tmp_p i sg
    end
  end
end

fn fh_relin_step to void
  for i ulong FH_N
    fh_center_q get fh_d2 i
    put fh_tmp_q i get fh_u_sg 0
    put fh_tmp_r i get fh_u_lo 0
    put fh_r_acc0 i get fh_d0 i
    put fh_r_acc1 i get fh_d1 i
  end
  for k ulong FH_RELIN_K
    for i ulong FH_N
      if true
        sg = get fh_tmp_q i
        mag = get fh_tmp_r i
        rem_d = and mag 255
        q_mag = shr mag 8
        if gt rem_d 128
          rem_d = sub 256 rem_d
          q_mag = add q_mag 1
          d_sg = xor sg 1
          if eq d_sg 0
            put fh_ntt_a i rem_d
          else
            put fh_ntt_a i sub FH_Q rem_d
          end
        else
          if eq rem_d 0
            put fh_ntt_a i 0
          else
            if eq sg 0
              put fh_ntt_a i rem_d
            else
              put fh_ntt_a i sub FH_Q rem_d
            end
          end
        end
        put fh_tmp_r i q_mag
      end
    end
    for i ulong FH_N
      put fh_ntt_b i get fh_rk0 add mul k FH_N i
      put fh_dig_c2 i get fh_ntt_a i
    end
    fh_poly_mul_ntt_q
    for i ulong FH_N
      put fh_r_acc0 i fh_mod_add get fh_r_acc0 i get fh_ntt_a i FH_Q
      put fh_ntt_a i get fh_dig_c2 i
      put fh_ntt_b i get fh_rk1 add mul k FH_N i
    end
    fh_poly_mul_ntt_q
    for i ulong FH_N
      put fh_r_acc1 i fh_mod_add get fh_r_acc1 i get fh_ntt_a i FH_Q
    end
  end
  for i ulong FH_N
    put fh_cto0 i get fh_r_acc0 i
    put fh_cto1 i get fh_r_acc1 i
  end
end

fn fh_eval_mul to int
  na = get fh_meta 7
  nb = get fh_meta 9
  da = get fh_meta 8
  db = get fh_meta 10
  nout = fh_calc_mul_noise na nb
  if gt nout FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  dout = da
  if gt db da
    dout = db
  end
  dout = add dout 1

  note d0 = round(t * (cta0 * ctb0) / q) mod q
  for i ulong FH_N
    put fh_tmp_p i get fh_cta0 i
    put fh_tmp_q i get fh_ctb0 i
  end
  fh_zz_mul_load_centered
  fh_zz_mul_finish_crt 0

  note d2 = round(t * (cta1 * ctb1) / q) mod q
  for i ulong FH_N
    put fh_tmp_p i get fh_cta1 i
    put fh_tmp_q i get fh_ctb1 i
  end
  fh_zz_mul_load_centered
  fh_zz_mul_finish_crt 2

  note d1 = round(t * (cta0 * ctb1 + cta1 * ctb0) / q) mod q
  for i ulong FH_N
    put fh_tmp_p i get fh_cta0 i
    put fh_tmp_q i get fh_ctb1 i
  end
  fh_zz_muladd_p1
  for i ulong FH_N
    put fh_tmp_p i get fh_cta1 i
    put fh_tmp_q i get fh_ctb0 i
  end
  fh_zz_muladd_p2

  fh_relin_step
  put fh_meta 11 nout
  put fh_meta 12 dout
  ret FH_OK
end

fn fh_decrypt_coeff v ulong to ulong
  fh_u128_mul v FH_T
  fh_u128_add_to get fh_u_lo 0 get fh_u_hi 0 FH_HALF_Q 0
  nhi = get fh_u_hi 0
  nlo = get fh_u_lo 0
  qhi = div nhi FH_Q
  r = rem nhi FH_Q
  qlo = ulong 0
  for b ulong 64
    sh = sub 63 b
    r = or shl r 1 and shr nlo sh 1
    if ge r FH_Q
      r = sub r FH_Q
      qlo = or qlo shl ulong 1 sh
    end
  end
  note Since q == 1 (mod 257), 2^64 == 1 (mod 257), so Q mod t == (qhi + qlo) mod t
  m = add rem qhi FH_T rem qlo FH_T
  ret rem m FH_T
end

fn fh_decrypt_ct to int
  fh_init_tables
  na = get fh_meta 7
  if gt na FH_MAX_NOISE
    ret FH_ERR_NOISE_BUDGET
  end
  for i ulong FH_N
    put fh_ntt_a i get fh_cta1 i
    put fh_ntt_b i get fh_sk i
  end
  fh_poly_mul_ntt_q
  for i ulong FH_N
    v = fh_mod_add get fh_cta0 i get fh_ntt_a i FH_Q
    put fh_msg i fh_decrypt_coeff v
  end
  ret FH_OK
end

note ==== Section 7: OMFHE1 Container Packing, SHA-256 + Ed25519 Verification ====

fn fh_is_canon v ulong to bool
  ret lt v FH_Q
end

fn fh_hash_range start ulong count ulong to void
  for i ulong count bound 16384
    put sh_dat i get fh_buf add start i
  end
  sh_all count
end

fn fh_sign_hdr_ed to void
  sd = new uchar 32 0
  pk = new uchar 32 0
  m = new uchar 65536 0
  sg = new uchar 64 0
  for i ulong 32
    put sd i get fh_ed_seed i
  end
  ues_pubkey sd pk
  for i ulong 32
    put fh_buf add 160 i get pk i
  end
  for i ulong 160
    put m i get fh_buf i
  end
  ues_sign sd m 160 sg
  for i ulong 64
    put fh_buf add 192 i get sg i
  end
end

fn fh_sign_pack_container kind ulong pay_bytes ulong noise_b ulong depth ulong to ulong
  tot = add FH_HDR_BYTES pay_bytes
  for i ulong FH_HDR_BYTES
    put fh_buf i 0
  end
  for i ulong len fh_t_magic bound 6
    put fh_buf i get fh_t_magic i
  end
  fh_put_u16 6 FH_VERSION
  fh_put_u32 8 kind
  fh_put_u32 12 FH_N
  fh_put_u64 16 FH_Q
  fh_put_u64 24 FH_T
  fh_put_u64 32 noise_b
  if true
    budget = ulong 0
    if le noise_b FH_MAX_NOISE
      budget = sub FH_MAX_NOISE noise_b
    end
    fh_put_u64 40 budget
  end
  fh_put_u32 48 depth
  fh_put_u32 52 FH_RELIN_K
  fh_put_u64 56 pay_bytes
  for i ulong len fh_t_dom bound 32
    put fh_buf add 64 i get fh_t_dom i
  end

  fh_hash_range FH_HDR_BYTES pay_bytes
  for i ulong 32
    put fh_buf add 96 i get sh_dig i
  end

  for i ulong 128
    put sh_dat i get fh_buf i
  end
  for i ulong pay_bytes bound 16384
    put sh_dat add 128 i get fh_buf add FH_HDR_BYTES i
  end
  sh_all add 128 pay_bytes
  for i ulong 32
    put fh_buf add 128 i get sh_dig i
  end

  fh_sign_hdr_ed
  ret tot
end

fn fh_pack_sk to ulong
  for i ulong FH_N
    fh_put_u64 add FH_HDR_BYTES mul i 8 get fh_sk i
  end
  ret fh_sign_pack_container FH_KIND_SK FH_SK_PAYLOAD 0 0
end

fn fh_pack_evk to ulong
  off = FH_HDR_BYTES
  for i ulong FH_N
    fh_put_u64 add off mul i 8 get fh_pk0 i
  end
  off = add off 512
  for i ulong FH_N
    fh_put_u64 add off mul i 8 get fh_pk1 i
  end
  off = add off 512
  for i ulong 448
    fh_put_u64 add off mul i 8 get fh_rk0 i
  end
  off = add off 3584
  for i ulong 448
    fh_put_u64 add off mul i 8 get fh_rk1 i
  end
  ret fh_sign_pack_container FH_KIND_EVK FH_EVK_PAYLOAD 2 0
end

fn fh_pack_ct_out to ulong
  off = FH_HDR_BYTES
  for i ulong FH_N
    fh_put_u64 add off mul i 8 get fh_cto0 i
  end
  off = add off 512
  for i ulong FH_N
    fh_put_u64 add off mul i 8 get fh_cto1 i
  end
  ret fh_sign_pack_container FH_KIND_CT FH_CT_PAYLOAD get fh_meta 11 get fh_meta 12
end

fn fh_read_file slot ulong to long
  fd = long -1
  if eq slot 0
    fd = fopen fh_p_sk 0 get fh_p_sk_l 0 0 0
  end
  if eq slot 1
    fd = fopen fh_p_evk 0 get fh_p_evk_l 0 0 0
  end
  if eq slot 2
    fd = fopen fh_p_in 0 get fh_p_in_l 0 0 0
  end
  if eq slot 3
    fd = fopen fh_p_ina 0 get fh_p_ina_l 0 0 0
  end
  if eq slot 4
    fd = fopen fh_p_inb 0 get fh_p_inb_l 0 0 0
  end
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16384 bound 256
    rn = read int fd fh_buf tot sub 16384 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      put fh_bufl 0 tot
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn fh_write_out n ulong to bool
  if eq get fh_p_out_l 0 0
    ret false
  end
  fd = fopen fh_p_out 0 get fh_p_out_l 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 256
    wn = write int fd fh_buf off sub n off
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn fh_verify_ed25519 to bool
  pk = new uchar 32 0
  m = new uchar 65536 0
  sg = new uchar 64 0
  nz = ulong 0
  for i ulong 32
    b = get fh_buf add 160 i
    if ne b 0
      nz = add nz 1
    end
    put pk i b
  end
  if eq nz 0
    ret false
  end
  for i ulong 160
    put m i get fh_buf i
  end
  for i ulong 64
    put sg i get fh_buf add 192 i
  end
  ret eq edverify pk m 160 sg 0 1
end

fn fh_verify_header flen ulong exp_kind ulong to int
  if lt flen FH_HDR_BYTES
    ret FH_ERR_FORMAT
  end
  for i ulong len fh_t_magic bound 6
    if ne get fh_buf i get fh_t_magic i
      ret FH_ERR_FORMAT
    end
  end
  if ne fh_get_u16 6 FH_VERSION
    ret FH_ERR_FORMAT
  end
  kind = fh_get_u32 8
  if and ne exp_kind 0 ne kind exp_kind
    ret FH_ERR_KIND
  end
  exp_pay = ulong 0
  if eq kind FH_KIND_SK
    exp_pay = FH_SK_PAYLOAD
  else
    if eq kind FH_KIND_EVK
      exp_pay = FH_EVK_PAYLOAD
    else
      if eq kind FH_KIND_CT
        exp_pay = FH_CT_PAYLOAD
      else
        ret FH_ERR_FORMAT
      end
    end
  end
  if or ne fh_get_u32 12 FH_N or ne fh_get_u64 16 FH_Q ne fh_get_u64 24 FH_T
    ret FH_ERR_FORMAT
  end
  if ne fh_get_u32 52 FH_RELIN_K
    ret FH_ERR_FORMAT
  end
  pay_b = fh_get_u64 56
  if or ne pay_b exp_pay ne flen add FH_HDR_BYTES exp_pay
    ret FH_ERR_FORMAT
  end
  if true
    dl = len fh_t_dom
    for i ulong 32
      want = uchar 0
      if lt i dl
        want = get fh_t_dom i
      end
      if ne get fh_buf add 64 i want
        ret FH_ERR_DOMAIN
      end
    end
  end

  fh_hash_range FH_HDR_BYTES pay_b
  for i ulong 32
    if ne get sh_dig i get fh_buf add 96 i
      ret FH_ERR_SHA
    end
  end

  for i ulong 128
    put sh_dat i get fh_buf i
  end
  for i ulong pay_b bound 16384
    put sh_dat add 128 i get fh_buf add FH_HDR_BYTES i
  end
  sh_all add 128 pay_b
  for i ulong 32
    if ne get sh_dig i get fh_buf add 128 i
      ret FH_ERR_SHA
    end
  end

  if not fh_verify_ed25519
    ret FH_ERR_ED25519
  end

  nwords = div pay_b 8
  for i ulong nwords bound 2048
    w = fh_get_u64 add FH_HDR_BYTES mul i 8
    if not fh_is_canon w
      ret FH_ERR_NONCANON
    end
  end

  if eq kind FH_KIND_CT
    nb = fh_get_u64 32
    bud = fh_get_u64 40
    if or gt nb FH_MAX_NOISE ne bud sub FH_MAX_NOISE nb
      ret FH_ERR_NOISE_BUDGET
    end
  end
  ret FH_OK
end

fn fh_load_sk to int
  fl = fh_read_file 0
  if lt fl 0
    ret FH_ERR_IO
  end
  rc = fh_verify_header ulong fl FH_KIND_SK
  if ne rc FH_OK
    ret rc
  end
  for i ulong FH_N
    put fh_sk i fh_get_u64 add FH_HDR_BYTES mul i 8
  end
  ret FH_OK
end

fn fh_load_evk to int
  fl = fh_read_file 1
  if lt fl 0
    ret FH_ERR_IO
  end
  rc = fh_verify_header ulong fl FH_KIND_EVK
  if ne rc FH_OK
    ret rc
  end
  off = FH_HDR_BYTES
  for i ulong FH_N
    put fh_pk0 i fh_get_u64 add off mul i 8
  end
  off = add off 512
  for i ulong FH_N
    put fh_pk1 i fh_get_u64 add off mul i 8
  end
  off = add off 512
  for i ulong 448
    put fh_rk0 i fh_get_u64 add off mul i 8
  end
  off = add off 3584
  for i ulong 448
    put fh_rk1 i fh_get_u64 add off mul i 8
  end
  for i ulong 32
    put fh_ed_seed i xor get fh_buf add 96 i uchar 0x5a
  end
  ret FH_OK
end

fn fh_load_ct file_slot ulong ct_slot ulong to int
  fl = fh_read_file file_slot
  if lt fl 0
    ret FH_ERR_IO
  end
  rc = fh_verify_header ulong fl FH_KIND_CT
  if ne rc FH_OK
    ret rc
  end
  nb = fh_get_u64 32
  dp = fh_get_u32 48
  off = FH_HDR_BYTES
  for i ulong FH_N
    v0 = fh_get_u64 add off mul i 8
    v1 = fh_get_u64 add add off 512 mul i 8
    if eq ct_slot 0
      put fh_cta0 i v0
      put fh_cta1 i v1
    else
      put fh_ctb0 i v0
      put fh_ctb1 i v1
    end
  end
  if eq ct_slot 0
    put fh_meta 7 nb
    put fh_meta 8 dp
  else
    put fh_meta 9 nb
    put fh_meta 10 dp
  end
  ret FH_OK
end

note ==== Section 8: Self-Test (NTT vs Schoolbook, CRT vs 128-bit Schoolbook, Roundtrip) ====

fn fh_sb_neg_mul_zz to void
  for k ulong FH_N
    put fh_sb_lo k 0
    put fh_sb_hi k 0
    put fh_sb_sg k 0
  end
  for k ulong FH_N
    acc_sg = ulong 0
    acc_lo = ulong 0
    acc_hi = ulong 0
    for i ulong FH_N
      j = ulong 0
      psg = ulong 0
      if ge k i
        j = sub k i
      else
        j = sub add k FH_N i
        psg = ulong 1
      end
      if true
        fh_center_q get fh_tmp_p i
        psg = xor psg get fh_u_sg 0
        m1 = get fh_u_lo 0
        fh_center_q get fh_tmp_q j
        psg = xor psg get fh_u_sg 0
        fh_u128_mul m1 get fh_u_lo 0
      end
      if eq psg acc_sg
        fh_u128_add_to acc_lo acc_hi get fh_u_lo 0 get fh_u_hi 0
        acc_lo = get fh_u_lo 0
        acc_hi = get fh_u_hi 0
      else
        if fh_u128_lt acc_lo acc_hi get fh_u_lo 0 get fh_u_hi 0
          fh_u128_sub get fh_u_lo 0 get fh_u_hi 0 acc_lo acc_hi
          acc_lo = get fh_u_lo 0
          acc_hi = get fh_u_hi 0
          acc_sg = psg
        else
          fh_u128_sub acc_lo acc_hi get fh_u_lo 0 get fh_u_hi 0
          acc_lo = get fh_u_lo 0
          acc_hi = get fh_u_hi 0
        end
      end
    end
    put fh_sb_lo k acc_lo
    put fh_sb_hi k acc_hi
    put fh_sb_sg k acc_sg
  end
end

fn fh_selftest_ntt_crt to bool
  fh_init_tables
  if ne fh_mod_pow_slot 0 FH_PSI64 FH_N sub FH_Q 1
    ret false
  end
  if ne fh_mod_mul_slot 0 FH_PSI64 FH_INV_PSI64 1
    ret false
  end
  if ne fh_mod_mul_slot 0 FH_N FH_INV64 1
    ret false
  end
  if ne fh_mod_mul_slot 0 FH_OMEGA64 FH_INV_OMEGA64 1
    ret false
  end

  note Check NTT mul == direct schoolbook in Z_q[X]/(X^N+1)
  fh_prng_init 777 11
  for i ulong FH_N
    put fh_tmp_p i rem fh_prng_next64 FH_Q
    put fh_tmp_q i rem fh_prng_next64 FH_Q
    put fh_ntt_a i get fh_tmp_p i
    put fh_ntt_b i get fh_tmp_q i
  end
  fh_poly_mul_ntt_q
  for k ulong FH_N
    acc = ulong 0
    for i ulong FH_N
      j = ulong 0
      sgn = ulong 0
      if ge k i
        j = sub k i
      else
        j = sub add k FH_N i
        sgn = ulong 1
      end
      pr = fh_mod_mul_slot 0 get fh_tmp_p i get fh_tmp_q j
      if eq sgn 0
        acc = fh_mod_add acc pr FH_Q
      else
        acc = fh_mod_sub acc pr FH_Q
      end
    end
    if ne acc get fh_ntt_a k
      ret false
    end
  end

  note Check CRT-NTT round(t * P / q) == direct signed 128-bit schoolbook on max-amplitude inputs
  for i ulong FH_N
    if eq and i 1 0
      put fh_tmp_p i FH_HALF_Q
      put fh_tmp_q i sub FH_Q FH_HALF_Q
    else
      put fh_tmp_p i sub FH_Q rem mul i 104729 1000000
      put fh_tmp_q i rem mul i 999983 1000000
    end
  end
  fh_zz_mul_load_centered
  fh_zz_mul_finish_crt 0
  fh_sb_neg_mul_zz
  for k ulong FH_N
    mlo = get fh_sb_lo k
    mhi = get fh_sb_hi k
    sg = get fh_sb_sg k
    s8_lo = shl mlo 8
    s8_hi = or shl mhi 8 shr mlo 56
    fh_u128_add_to s8_lo s8_hi mlo mhi
    fh_u128_add_to get fh_u_lo 0 get fh_u_hi 0 FH_HALF_Q 0
    qm = fh_u128_div_q_mod get fh_u_hi 0 get fh_u_lo 0
    if eq sg 1
      qm = fh_mod_neg qm FH_Q
    end
    if ne qm get fh_d0 k
      ret false
    end
  end
  ret true
end

fn fh_run_selftest to int
  if not fh_selftest_ntt_crt
    ret FH_ERR_FORMAT
  end
  fh_keygen 42
  sk_bytes = fh_pack_sk
  if ne sk_bytes FH_SK_TOTAL
    ret FH_ERR_FORMAT
  end
  if ne fh_verify_header sk_bytes FH_KIND_SK FH_OK
    ret FH_ERR_ED25519
  end
  evk_bytes = fh_pack_evk
  if ne evk_bytes FH_EVK_TOTAL
    ret FH_ERR_FORMAT
  end
  if ne fh_verify_header evk_bytes FH_KIND_EVK FH_OK
    ret FH_ERR_ED25519
  end

  note Encrypt x(X) and y(X), compute blind (3*x^2 + 5*x*y + 7*y + 11) mod 257, check Dec
  for i ulong FH_N
    put fh_msg i rem add mul i 13 5 FH_T
  end
  fh_encrypt_with_evk 101
  for i ulong FH_N
    put fh_cta0 i get fh_cto0 i
    put fh_cta1 i get fh_cto1 i
    put fh_msg2 i get fh_msg i
    put fh_msg i rem add mul i 29 17 FH_T
  end
  fh_encrypt_with_evk 202
  for i ulong FH_N
    put fh_ctb0 i get fh_cto0 i
    put fh_ctb1 i get fh_cto1 i
  end
  note Save ct_x in pk-scratch? Use d0/d1 temporary slots for ct_y while computing x^2
  for i ulong FH_N
    put fh_d0 i get fh_ctb0 i
    put fh_d1 i get fh_ctb1 i
    put fh_ctb0 i get fh_cta0 i
    put fh_ctb1 i get fh_cta1 i
  end
  put fh_meta 7 FH_E_FRESH
  put fh_meta 8 0
  put fh_meta 9 FH_E_FRESH
  put fh_meta 10 0
  if ne fh_eval_mul FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  note cto = x^2 -> scale by 3 into cta
  for i ulong FH_N
    put fh_cta0 i get fh_cto0 i
    put fh_cta1 i get fh_cto1 i
  end
  put fh_meta 7 get fh_meta 11
  put fh_meta 8 get fh_meta 12
  if ne fh_eval_const_mul 3 FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  for i ulong FH_N
    put fh_cta0 i get fh_cto0 i
    put fh_cta1 i get fh_cto1 i
  end
  if ne fh_decrypt_ct FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  note Check 3 * x^2 mod t against direct negacyclic schoolbook mod t
  for k ulong FH_N
    acc = ulong 0
    for i ulong FH_N
      j = ulong 0
      neg_t = false
      if ge k i
        j = sub k i
      else
        j = sub add k FH_N i
        neg_t = true
      end
      pr = rem mul get fh_msg2 i get fh_msg2 j FH_T
      if neg_t
        pr = rem sub FH_T pr FH_T
      end
      acc = rem add acc pr FH_T
    end
    want = rem mul acc 3 FH_T
    if ne get fh_msg k want
      ret FH_ERR_PLAINTEXT
    end
  end
  fh_wrt fh_m_self1
  ret FH_OK
end

note ==== Section 9: CLI Dispatch & Blind Eval-Poly ====

fn fh_save_out_to_a to void
  for i ulong FH_N
    put fh_cta0 i get fh_cto0 i
    put fh_cta1 i get fh_cto1 i
  end
  put fh_meta 7 get fh_meta 11
  put fh_meta 8 get fh_meta 12
end

fn fh_run_eval_poly to int
  nx = get fh_meta 7
  dx = get fh_meta 8
  ny = get fh_meta 9
  dy = get fh_meta 10
  if true
    for i ulong FH_N
      put fh_sb_lo i get fh_cta0 i
      put fh_sb_hi i get fh_cta1 i
      put fh_msg i get fh_ctb0 i
      put fh_msg2 i get fh_ctb1 i
    end
  end

  if true
    for i ulong FH_N
      put fh_ctb0 i get fh_sb_lo i
      put fh_ctb1 i get fh_sb_hi i
    end
  end
  put fh_meta 9 nx
  put fh_meta 10 dx
  if ne fh_eval_mul FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  fh_save_out_to_a
  if ne fh_eval_const_mul get fh_meta 3 FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  if true
    for i ulong FH_N
      fh_put_u64 add 12288 mul i 8 get fh_cto0 i
      fh_put_u64 add 12800 mul i 8 get fh_cto1 i
    end
  end
  n_ax2 = get fh_meta 11
  d_ax2 = get fh_meta 12

  if true
    for i ulong FH_N
      put fh_cta0 i get fh_sb_lo i
      put fh_cta1 i get fh_sb_hi i
      put fh_ctb0 i get fh_msg i
      put fh_ctb1 i get fh_msg2 i
    end
  end
  put fh_meta 7 nx
  put fh_meta 8 dx
  put fh_meta 9 ny
  put fh_meta 10 dy
  if ne fh_eval_mul FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  fh_save_out_to_a
  if ne fh_eval_const_mul get fh_meta 4 FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  if true
    for i ulong FH_N
      fh_put_u64 add 13312 mul i 8 get fh_cto0 i
      fh_put_u64 add 13824 mul i 8 get fh_cto1 i
    end
  end
  n_bxy = get fh_meta 11
  d_bxy = get fh_meta 12

  if true
    for i ulong FH_N
      put fh_cta0 i get fh_msg i
      put fh_cta1 i get fh_msg2 i
    end
  end
  put fh_meta 7 ny
  put fh_meta 8 dy
  if ne fh_eval_const_mul get fh_meta 5 FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  fh_save_out_to_a

  if true
    for i ulong FH_N
      put fh_ctb0 i fh_get_u64 add 12288 mul i 8
      put fh_ctb1 i fh_get_u64 add 12800 mul i 8
    end
  end
  put fh_meta 9 n_ax2
  put fh_meta 10 d_ax2
  if ne fh_eval_add FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  fh_save_out_to_a

  if true
    for i ulong FH_N
      put fh_ctb0 i fh_get_u64 add 13312 mul i 8
      put fh_ctb1 i fh_get_u64 add 13824 mul i 8
    end
  end
  put fh_meta 9 n_bxy
  put fh_meta 10 d_bxy
  if ne fh_eval_add FH_OK
    ret FH_ERR_NOISE_BUDGET
  end
  fh_save_out_to_a

  ret fh_eval_add_const get fh_meta 6
end

fn fh_parse_cmd_word to ulong
  if fh_arg_eq 1 fh_c_self
    ret 1
  end
  if fh_arg_eq 1 fh_c_kgen
    ret 2
  end
  if fh_arg_eq 1 fh_c_enc
    ret 3
  end
  if fh_arg_eq 1 fh_c_add
    ret 4
  end
  if fh_arg_eq 1 fh_c_sub
    ret 5
  end
  if fh_arg_eq 1 fh_c_cmul
    ret 6
  end
  if fh_arg_eq 1 fh_c_mul
    ret 7
  end
  if fh_arg_eq 1 fh_c_epoly
    ret 8
  end
  if fh_arg_eq 1 fh_c_dec
    ret 9
  end
  if fh_arg_eq 1 fh_c_insp
    ret 10
  end
  ret 0
end

fn fh_handle_flag i ulong to int
  if fh_arg_eq i fh_f_sk
    if not fh_copy_arg_path add i 1 0
      ret FH_ERR_IO
    end
    put fh_flags 0 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_evk
    if not fh_copy_arg_path add i 1 1
      ret FH_ERR_IO
    end
    put fh_flags 1 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_in
    if not fh_copy_arg_path add i 1 2
      ret FH_ERR_IO
    end
    put fh_flags 2 1
    ret FH_OK
  end
  if or fh_arg_eq i fh_f_a fh_arg_eq i fh_f_x
    if fh_arg_eq i fh_f_a
      if eq get fh_meta 0 8
        if not fh_parse_u64 add i 1
          ret FH_ERR_IO
        end
        if ge get fh_meta 14 FH_T
          ret FH_ERR_PLAINTEXT
        end
        put fh_meta 3 get fh_meta 14
        ret FH_OK
      end
    end
    if not fh_copy_arg_path add i 1 3
      ret FH_ERR_IO
    end
    put fh_flags 3 1
    ret FH_OK
  end
  if or fh_arg_eq i fh_f_b fh_arg_eq i fh_f_y
    if fh_arg_eq i fh_f_b
      if eq get fh_meta 0 8
        if not fh_parse_u64 add i 1
          ret FH_ERR_IO
        end
        if ge get fh_meta 14 FH_T
          ret FH_ERR_PLAINTEXT
        end
        put fh_meta 4 get fh_meta 14
        ret FH_OK
      end
    end
    if not fh_copy_arg_path add i 1 4
      ret FH_ERR_IO
    end
    put fh_flags 4 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_out
    if not fh_copy_arg_path add i 1 5
      ret FH_ERR_IO
    end
    put fh_flags 5 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_seed
    if not fh_parse_u64 add i 1
      ret FH_ERR_IO
    end
    put fh_meta 1 get fh_meta 14
    ret FH_OK
  end
  if fh_arg_eq i fh_f_val
    if not fh_parse_u64 add i 1
      ret FH_ERR_IO
    end
    if ge get fh_meta 14 FH_T
      ret FH_ERR_PLAINTEXT
    end
    for k ulong FH_N
      put fh_msg k 0
    end
    put fh_msg 0 get fh_meta 14
    put fh_meta 13 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_poly
    ret fh_parse_poly_arg add i 1
  end
  if fh_arg_eq i fh_f_c
    if not fh_parse_u64 add i 1
      ret FH_ERR_IO
    end
    if ge get fh_meta 14 FH_T
      ret FH_ERR_PLAINTEXT
    end
    put fh_meta 2 get fh_meta 14
    put fh_meta 5 get fh_meta 14
    put fh_flags 6 1
    ret FH_OK
  end
  if fh_arg_eq i fh_f_d
    if not fh_parse_u64 add i 1
      ret FH_ERR_IO
    end
    if ge get fh_meta 14 FH_T
      ret FH_ERR_PLAINTEXT
    end
    put fh_meta 6 get fh_meta 14
    ret FH_OK
  end
  ret FH_ERR_IO
end

fn fh_parse_cli to int
  ac = ulong argcnt
  if lt ac 2
    ret FH_ERR_IO
  end
  if or fh_arg_eq 1 fh_c_help fh_arg_eq 1 fh_c_h
    fh_wrt fh_m_use
    exit 0
  end
  cmd = fh_parse_cmd_word
  if eq cmd 0
    ret FH_ERR_IO
  end
  put fh_meta 0 cmd
  put fh_meta 1 42
  put fh_meta 2 1
  put fh_meta 3 0
  put fh_meta 4 0
  put fh_meta 5 0
  put fh_meta 6 0
  put fh_meta 13 0
  for k ulong 8
    put fh_flags k 0
  end
  if eq cmd 1
    if ne ac 2
      ret FH_ERR_IO
    end
    ret FH_OK
  end
  i = ulong 2
  while lt i ac bound 32
    if ge add i 1 ac
      ret FH_ERR_IO
    end
    rc = fh_handle_flag i
    if ne rc FH_OK
      ret rc
    end
    i = add i 2
  end
  ret FH_OK
end

fn fh_print_eval_ok tot ulong to void
  fh_hash_range 0 tot
  fh_wrt fh_m_op1
  fh_u64 get fh_meta 12
  fh_wrt fh_m_op2
  nb = get fh_meta 11
  fh_u64 nb
  fh_wrt fh_m_op3
  fh_u64 sub FH_MAX_NOISE nb
  fh_wrt fh_m_op4
  fh_hex32_sh
  fh_wrt fh_nl
end

fn fh_finish_ct_out to int
  if eq get fh_flags 5 0
    ret FH_ERR_IO
  end
  tot = fh_pack_ct_out
  if not fh_write_out tot
    ret FH_ERR_IO
  end
  fh_print_eval_ok tot
  ret FH_OK
end

fn fh_cmd_keygen to int
  if eq get fh_flags 0 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 1 0
    ret FH_ERR_IO
  end
  fh_keygen get fh_meta 1
  sk_b = fh_pack_sk
  for i ulong get fh_p_sk_l 0 bound 1024
    put fh_p_out i get fh_p_sk i
  end
  put fh_p_out_l 0 get fh_p_sk_l 0
  if not fh_write_out sk_b
    ret FH_ERR_IO
  end
  evk_b = fh_pack_evk
  for i ulong get fh_p_evk_l 0 bound 1024
    put fh_p_out i get fh_p_evk i
  end
  put fh_p_out_l 0 get fh_p_evk_l 0
  if not fh_write_out evk_b
    ret FH_ERR_IO
  end
  fh_wrt fh_m_kg1
  ret FH_OK
end

fn fh_cmd_encrypt to int
  if eq get fh_flags 1 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 5 0
    ret FH_ERR_IO
  end
  if eq get fh_meta 13 0
    ret FH_ERR_IO
  end
  rc = fh_load_evk
  if ne rc FH_OK
    ret rc
  end
  fh_encrypt_with_evk get fh_meta 1
  tot = fh_pack_ct_out
  if not fh_write_out tot
    ret FH_ERR_IO
  end
  fh_wrt fh_m_enc1
  ret FH_OK
end

fn fh_cmd_binop cmd ulong to int
  if eq get fh_flags 1 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 3 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 4 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 5 0
    ret FH_ERR_IO
  end
  rc = fh_load_evk
  if ne rc FH_OK
    ret rc
  end
  rc = fh_load_ct 3 0
  if ne rc FH_OK
    ret rc
  end
  rc = fh_load_ct 4 1
  if ne rc FH_OK
    ret rc
  end
  if eq cmd 4
    rc = fh_eval_add
  else
    if eq cmd 5
      rc = fh_eval_sub
    else
      if eq cmd 7
        rc = fh_eval_mul
      else
        rc = fh_run_eval_poly
      end
    end
  end
  if ne rc FH_OK
    ret rc
  end
  ret fh_finish_ct_out
end

fn fh_cmd_cmul to int
  if eq get fh_flags 1 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 3 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 5 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 6 0
    ret FH_ERR_IO
  end
  rc = fh_load_evk
  if ne rc FH_OK
    ret rc
  end
  rc = fh_load_ct 3 0
  if ne rc FH_OK
    ret rc
  end
  rc = fh_eval_const_mul get fh_meta 2
  if ne rc FH_OK
    ret rc
  end
  ret fh_finish_ct_out
end

fn fh_cmd_decrypt to int
  if eq get fh_flags 0 0
    ret FH_ERR_IO
  end
  if eq get fh_flags 2 0
    ret FH_ERR_IO
  end
  rc = fh_load_sk
  if ne rc FH_OK
    ret rc
  end
  rc = fh_load_ct 2 0
  if ne rc FH_OK
    ret rc
  end
  rc = fh_decrypt_ct
  if ne rc FH_OK
    ret rc
  end
  fh_wrt fh_m_dec1
  fh_u64 get fh_meta 8
  fh_wrt fh_m_op2
  fh_u64 get fh_meta 7
  fh_wrt fh_m_op3
  fh_u64 sub FH_MAX_NOISE get fh_meta 7
  fh_wrt fh_m_dec2
  fh_u64 get fh_msg 0
  fh_wrt fh_m_dec3
  for i ulong FH_N
    if gt i 0
      fh_wrt fh_comma
    end
    fh_u64 get fh_msg i
  end
  fh_wrt fh_nl
  ret FH_OK
end

fn fh_cmd_inspect to int
  if eq get fh_flags 2 0
    ret FH_ERR_IO
  end
  fl = fh_read_file 2
  if lt fl 0
    ret FH_ERR_IO
  end
  ufl = ulong fl
  rc = fh_verify_header ufl 0
  if ne rc FH_OK
    ret rc
  end
  fh_wrt fh_m_ins1
  fh_u64 fh_get_u32 8
  fh_wrt fh_m_ins2
  fh_u64 fh_get_u32 48
  fh_wrt fh_m_op2
  fh_u64 fh_get_u64 32
  fh_wrt fh_m_op3
  fh_u64 fh_get_u64 40
  fh_wrt fh_m_op4
  fh_hash_range 0 ufl
  fh_hex32_sh
  fh_wrt fh_nl
  ret FH_OK
end

fn main to int
  fh_init_tables
  prc = fh_parse_cli
  if ne prc FH_OK
    if eq prc FH_ERR_IO
      fh_werr fh_m_use
    end
    ret fh_print_fail prc
  end
  cmd = get fh_meta 0
  rc = FH_OK
  if eq cmd 1
    rc = fh_run_selftest
  else
    if eq cmd 2
      rc = fh_cmd_keygen
    else
      if eq cmd 3
        rc = fh_cmd_encrypt
      else
        if eq cmd 6
          rc = fh_cmd_cmul
        else
          if eq cmd 9
            rc = fh_cmd_decrypt
          else
            if eq cmd 10
              rc = fh_cmd_inspect
            else
              rc = fh_cmd_binop cmd
            end
          end
        end
      end
    end
  end
  if ne rc FH_OK
    ret fh_print_fail rc
  end
  ret FH_OK
end

note ==== Section 6: Positive Suite ====

fn fg_run_positive to bool
  fg_use_rlwe1
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_self
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_rself 11

  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_self
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_cself 12

  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_audit
  fg_use_rlwe1
  fg_av_bin
  fg_av_scr fg_f_audit
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_aud 13

  fg_use_rlwe1
  rc = fg_run_keygen fg_f_sk42 fg_f_evk42 fg_v_42
  fg_chk eq rc 0 14
  rc = fg_run_encrypt fg_f_evk42 fg_f_ctx false
  rc2 = fg_run_encrypt fg_f_evk42 fg_f_cty true
  fg_chk and eq rc 0 eq rc2 0 15

  rc = fg_run_eval_poly fg_f_ctp
  fg_chk and eq rc 0 fg_has_sub fg_q_eval 16

  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_vct
  fg_av_lit fg_fl_sk
  fg_av_scr fg_f_sk42
  fg_av_lit fg_fl_evk
  fg_av_scr fg_f_evk42
  fg_av_lit fg_fl_ctx
  fg_av_scr fg_f_ctx
  fg_av_lit fg_fl_cty
  fg_av_scr fg_f_cty
  fg_av_lit fg_fl_x
  fg_av_lit fg_px
  fg_av_lit fg_fl_y
  fg_av_lit fg_py
  fg_av_lit fg_fl_a
  fg_av_lit fg_v_3
  fg_av_lit fg_fl_b
  fg_av_lit fg_v_5
  fg_av_lit fg_fl_c
  fg_av_lit fg_v_7
  fg_av_lit fg_fl_d
  fg_av_lit fg_v_11
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctp
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_vct 17

  fg_use_rlwe2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_dec
  fg_av_lit fg_fl_sk
  fg_av_scr fg_f_sk42
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctp
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_dec 18

  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_insp
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctp
  rc = fg_spawn_cur
  fg_chk and eq rc 0 fg_has_sub fg_q_insp 19

  fg_use_rlwe1
  rc = fg_run_mul fg_f_ctx fg_f_cty fg_f_ctxy
  rc2 = fg_run_mul fg_f_ctxy fg_f_ctx fg_f_ctd2
  fg_chk and eq rc 0 eq rc2 0 20

  rc = fg_run_keygen fg_f_sk999 fg_f_evk999 fg_v_999
  fg_chk eq rc 0 21

  lct = fg_load_file_to fg_f_ctp 0 16384
  levk = fg_load_file_to fg_f_evk42 1 16384
  fg_chk and eq lct long FH_CT_BYTES eq levk long FH_EVK_BYTES 22
  ret and eq lct long FH_CT_BYTES eq levk long FH_EVK_BYTES
end

note ==== Section 7: 15 Adversarial Negative Controls ====

fn fg_ctrl_badrk to void
  note NC-5: raw 1-bit flip in rk0[0] of evk_42 -> SHA fails closed (72)
  zn = fg_reset_atk true
  put fg_atk 1280 xor get fg_atk 1280 1
  zw = fg_write_atk zn
  fg_use_rlwe2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_insp
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_atk
  fg_ctrl eq fg_spawn_cur 72 205

  note NC-6: validly re-signed corrupted rk0 (zeroed digit-0) inside evk_badrk -> eval fails verify-op (81)
  zn = fg_reset_atk true
  for j ulong 64
    fg_put_atk_u64 add 1280 mul j 8 0
  end
  fg_resign_atk zn
  zp = fg_set_p 0 true fg_f_ebad
  fd = fopen fg_pa 0 get fg_pal 0 577 420
  if ge fd 0
    zwr = write int fd fg_atk 0 zn
    zcl = fclose int fd
  end
  fg_use_rlwe1
  rm_bad = fg_run_mul_ebad fg_f_ctbad
  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_vop
  fg_av_lit fg_fl_sk
  fg_av_scr fg_f_sk42
  fg_av_lit fg_fl_op
  fg_av_lit fg_c_mul
  fg_av_lit fg_fl_x
  fg_av_lit fg_px
  fg_av_lit fg_fl_y
  fg_av_lit fg_py
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctbad
  rc6 = fg_spawn_cur
  fg_ctrl and eq rm_bad 0 eq rc6 81 206
end

fn fg_ctrl_noncanon_and_keys to void
  note NC-1: raw byte non-canonical c0[0]=q -> SHA fails closed (72)
  zn = fg_reset_atk false
  fg_put_atk_u64 256 FH_Q
  zw = fg_write_atk zn
  fg_insp_atk 72 201

  note NC-2: validly SHA-256 + Ed25519 re-signed non-canonical c0[0]=q -> exit 74
  zn = fg_reset_atk false
  fg_put_atk_u64 256 FH_Q
  fg_resign_atk zn
  zw = fg_write_atk zn
  fg_insp_atk 74 202
  fg_vct_atk_expect 74 2020

  note NC-3: validly SHA-256 + Ed25519 re-signed c1[0]=2^64-1 -> exit 74
  zn = fg_reset_atk false
  fg_put_atk_u64 768 18446744073709551615
  fg_resign_atk zn
  zw = fg_write_atk zn
  fg_insp_atk 74 203

  note NC-4: wrong secret key sk_999 -> mismatch 81
  rc4 = fg_vct_in fg_f_ctp fg_f_sk999 fg_f_evk42
  fg_ctrl eq rc4 81 204

  fg_ctrl_badrk
end

fn fg_ctrl_format_and_kind to void
  note NC-10: magic byte tamper -> exit 70
  zn = fg_reset_atk false
  put fg_atk 0 uchar 88
  zw = fg_write_atk zn
  fg_insp_atk 70 210

  note NC-11: version tamper -> exit 70
  zn = fg_reset_atk false
  put fg_atk 6 uchar 2
  zw = fg_write_atk zn
  fg_insp_atk 70 211

  note NC-12: domain tamper -> exit 71
  zn = fg_reset_atk false
  put fg_atk 64 xor get fg_atk 64 1
  zw = fg_write_atk zn
  fg_insp_atk 71 212

  note NC-13: Ed25519 signature 1-bit flip -> exit 73
  zn = fg_reset_atk false
  put fg_atk 192 xor get fg_atk 192 1
  zw = fg_write_atk zn
  fg_insp_atk 73 213
  fg_vct_atk_expect 73 2130

  note NC-14: truncated (1279 B) and trailing-byte (1281 B) -> exit 70
  zn = fg_reset_atk false
  zw = fg_write_atk sub zn 1
  fg_insp_atk 70 214
  put fg_atk zn uchar 0
  zw = fg_write_atk add zn 1
  fg_vct_atk_expect 70 2140

  note NC-15: sk passed as --evk -> exit 77 on both fhe_rlwe and fhe_check
  fg_use_rlwe2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_epoly
  fg_av_lit fg_fl_evk
  fg_av_scr fg_f_sk42
  fg_av_lit fg_fl_x
  fg_av_scr fg_f_ctx
  fg_av_lit fg_fl_y
  fg_av_scr fg_f_cty
  fg_av_lit fg_fl_a
  fg_av_lit fg_v_3
  fg_av_lit fg_fl_b
  fg_av_lit fg_v_5
  fg_av_lit fg_fl_c
  fg_av_lit fg_v_7
  fg_av_lit fg_fl_d
  fg_av_lit fg_v_11
  fg_av_lit fg_fl_out
  fg_av_scr fg_f_ctbad
  rr_k = fg_spawn_cur
  rc_k = fg_vct_sk_as_evk fg_f_ctp fg_f_sk42
  fg_ctrl and eq rr_k 77 eq rc_k 77 215
end

fn fg_ctrl_noise_and_format to void
  note NC-7: natural depth-3 mul chain exceeds noise budget -> exit 75
  fg_use_rlwe1
  r1 = fg_run_mul_sq fg_f_ctx fg_f_ctx2
  r2 = fg_run_mul fg_f_ctx2 fg_f_ctx fg_f_ctx3
  r3 = fg_run_mul fg_f_ctx3 fg_f_ctx fg_f_ctx4
  fg_ctrl and eq r1 0 and eq r2 0 eq r3 75 207

  note NC-8: validly re-signed header noise_bound = MAX+1, budget = 0 -> exit 75
  zn = fg_reset_atk false
  fg_put_atk_u64 32 add FH_MAX_NOISE 1
  fg_put_atk_u64 40 0
  fg_resign_atk zn
  zw = fg_write_atk zn
  fg_insp_atk 75 208
  fg_vct_atk_expect 75 2080

  note NC-9: validly re-signed budget mismatch (noise=162, budget=0) -> exit 75
  zn = fg_reset_atk false
  fg_put_atk_u64 32 162
  fg_put_atk_u64 40 0
  fg_resign_atk zn
  zw = fg_write_atk zn
  fg_insp_atk 75 209

  fg_ctrl_format_and_kind
end

note ==== Section 8: 5 Live OMC-Recompiled Mutants ====

fn fg_kill_eval_mutant tag ulong to void
  fg_set_bin_scr fg_f_mb
  rc_e = fg_run_eval_poly fg_f_ctmut
  rc_v = fg_vct_in fg_f_ctmut fg_f_sk42 fg_f_evk42
  if and eq rc_e 0 ne rc_v 0
    put fg_mut_kills 0 add get fg_mut_kills 0 1
  else
    fg_fail tag
  end
end

fn fg_run_mut_m3 to void
  fg_mut_reset
  if not fg_mut_patch fg_m3_old fg_m3_new
    fg_fail 303
    ret
  end
  if not fg_mut_compile
    fg_fail 303
    ret
  end
  fg_set_bin_scr fg_f_mb
  rk = fg_run_keygen fg_f_sk999 fg_f_ebad fg_v_999
  rm = fg_run_mul_ebad fg_f_ctmut
  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_vop
  fg_av_lit fg_fl_sk
  fg_av_scr fg_f_sk999
  fg_av_lit fg_fl_op
  fg_av_lit fg_c_mul
  fg_av_lit fg_fl_x
  fg_av_lit fg_px
  fg_av_lit fg_fl_y
  fg_av_lit fg_py
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctmut
  rc_v = fg_spawn_cur
  if and eq rk 0 and eq rm 0 ne rc_v 0
    put fg_mut_kills 0 add get fg_mut_kills 0 1
  else
    fg_fail 303
  end
end

fn fg_run_mut_m4 to void
  note M-4: mul-noise under-report bypass -> depth-3 succeeds in mutant, killed by verify-op/noise check
  fg_mut_reset
  if not fg_mut_patch fg_m4_old fg_m4_new
    fg_fail 304
    ret
  end
  if not fg_mut_compile
    fg_fail 304
    ret
  end
  fg_set_bin_scr fg_f_mb
  rm1 = fg_run_mul_sq fg_f_ctx fg_f_ctx2
  rm2 = fg_run_mul fg_f_ctx2 fg_f_ctx fg_f_ctx3
  rm3 = fg_run_mul fg_f_ctx3 fg_f_ctx fg_f_ctmut
  fg_use_chk2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_vop
  fg_av_lit fg_fl_sk
  fg_av_scr fg_f_sk42
  fg_av_lit fg_fl_op
  fg_av_lit fg_c_mul
  fg_av_lit fg_fl_x
  fg_av_lit fg_px
  fg_av_lit fg_fl_y
  fg_av_lit fg_py
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_ctmut
  rc_v = fg_spawn_cur
  if and eq rm1 0 and eq rm2 0 and eq rm3 0 ne rc_v 0
    put fg_mut_kills 0 add get fg_mut_kills 0 1
  else
    fg_fail 304
  end
end

fn fg_run_mut_m5 to void
  note M-5: bypass < q canonical predicate -> mutant accepts non-canonical signed ct where honest returns 74
  zn = fg_reset_atk false
  fg_put_atk_u64 256 FH_Q
  fg_resign_atk zn
  zw = fg_write_atk zn
  fg_mut_reset
  if not fg_mut_patch fg_m5_old fg_m5_new
    fg_fail 305
    ret
  end
  if not fg_mut_compile
    fg_fail 305
    ret
  end
  fg_set_bin_scr fg_f_mb
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_insp
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_atk
  rc_m5 = fg_spawn_cur
  if ne rc_m5 74
    put fg_mut_kills 0 add get fg_mut_kills 0 1
  else
    fg_fail 305
  end
end

fn fg_run_mut_m4_m5 to void
  fg_run_mut_m4
  fg_run_mut_m5
end

fn fg_run_mutants to void
  put fg_mut_kills 0 0
  srcl = fg_build_rlwe_src
  if le srcl 10000
    fg_fail 300
    ret
  end

  note M-1: drop +d constant addition in eval-poly
  fg_mut_reset
  if and fg_mut_patch fg_m1_old fg_m1_new fg_mut_compile
    fg_kill_eval_mutant 301
  else
    fg_fail 301
  end

  note M-2: drop inverse NTT post-twist + N^-1
  fg_mut_reset
  if and fg_mut_patch fg_m2_old fg_m2_new fg_mut_compile
    fg_kill_eval_mutant 302
  else
    fg_fail 302
  end

  fg_run_mut_m3
  fg_run_mut_m4_m5
end

note ==== Section 9: Main Gate Driver ====

fn fg_eq_h1_h2 to bool
  for j ulong 32
    if ne get fg_h1 j get fg_h2 j
      ret false
    end
  end
  ret true
end

fn fg_build_rlwe_pair to bool
  rl_l = fg_build_rlwe_src
  fg_chk gt rl_l 10000 1
  if le rl_l 10000
    ret false
  end
  rc1 = fg_compile_scr fg_f_rsrc fg_f_r1 fg_f_re1
  rc2 = fg_compile_scr fg_f_rsrc fg_f_r2 fg_f_re2
  fg_chk and eq rc1 0 eq rc2 0 2
  fg_chk and fg_scr_file_empty fg_f_re1 fg_scr_file_empty fg_f_re2 3
  sr1 = fg_hash_scr fg_f_r1 1
  sr2 = fg_hash_scr fg_f_r2 2
  r_det = and gt sr1 10000 and eq sr1 sr2 fg_eq_h1_h2
  fg_chk r_det 4
  fg_chk fg_check_static_elf fg_f_r1 5
  ret r_det
end

fn fg_build_chk_pair to bool
  cl_l = fg_build_chk_src
  fg_chk gt cl_l 10000 6
  if le cl_l 10000
    ret false
  end
  cc1 = fg_compile_scr fg_f_csrc fg_f_c1 fg_f_ce1
  cc2 = fg_compile_scr fg_f_csrc fg_f_c2 fg_f_ce2
  fg_chk and eq cc1 0 eq cc2 0 7
  fg_chk and fg_scr_file_empty fg_f_ce1 fg_scr_file_empty fg_f_ce2 8
  sc1 = fg_hash_scr fg_f_c1 1
  sc2 = fg_hash_scr fg_f_c2 2
  c_det = and gt sc1 10000 and eq sc1 sc2 fg_eq_h1_h2
  fg_chk c_det 9
  fg_chk fg_check_static_elf fg_f_c1 10
  ret c_det
end

fn fg_copy_bin_paths to void
  zp = fg_set_p 0 true fg_f_r1
  for i ulong get fg_pal 0 bound 1020
    put fg_rlwe1 i get fg_pa i
  end
  put fg_rlwe1_l 0 get fg_pal 0

  zp = fg_set_p 0 true fg_f_r2
  for i ulong get fg_pal 0 bound 1020
    put fg_rlwe2 i get fg_pa i
  end
  put fg_rlwe2_l 0 get fg_pal 0

  zp = fg_set_p 0 true fg_f_c1
  for i ulong get fg_pal 0 bound 1020
    put fg_chk1 i get fg_pa i
  end
  put fg_chk1_l 0 get fg_pal 0

  zp = fg_set_p 0 true fg_f_c2
  for i ulong get fg_pal 0 bound 1020
    put fg_chk2 i get fg_pa i
  end
  put fg_chk2_l 0 get fg_pal 0
end

fn fg_build_and_verify to bool
  if not fg_verify_omc_pin
    fg_werr fg_e_pin
    ret false
  end
  r_det = fg_build_rlwe_pair
  c_det = fg_build_chk_pair
  if and r_det c_det
    put fg_cmp_ok 0 1
  end
  fg_copy_bin_paths
  if fg_run_positive
    fg_ctrl_noncanon_and_keys
    fg_ctrl_noise_and_format
    fg_run_mutants
  end
  ret true
end

fn main to int
  put fg_checks 0 0
  put fg_ctrls 0 0
  put fg_caught 0 0
  put fg_mut_kills 0 0
  put fg_fails 0 0
  put fg_cmp_ok 0 0

  ac = ulong argcnt
  if eq ac 4
    put fg_omc_l 0 fg_arg_to_glob 1 0
    put fg_root_l 0 fg_arg_to_glob 2 1
    put fg_scr_l 0 fg_arg_to_glob 3 2
    if or eq get fg_omc_l 0 0 or eq get fg_root_l 0 0 eq get fg_scr_l 0 0
      fg_werr fg_u_msg
      ret FG_ERR_ARG
    end
    z = makedir fg_scr 0 get fg_scr_l 0 493
    if not fg_build_and_verify
      ret FG_ERR_PIN
    end
  else
    if and eq ac 5 fg_arg_eq 1 fg_f_bins
      put fg_rlwe1_l 0 fg_arg_to_glob 2 3
      put fg_chk1_l 0 fg_arg_to_glob 3 4
      put fg_scr_l 0 fg_arg_to_glob 4 2
      if or eq get fg_rlwe1_l 0 0 or eq get fg_chk1_l 0 0 eq get fg_scr_l 0 0
        fg_werr fg_u_msg
        ret FG_ERR_ARG
      end
      for i ulong get fg_rlwe1_l 0 bound 1020
        put fg_rlwe2 i get fg_rlwe1 i
      end
      put fg_rlwe2_l 0 get fg_rlwe1_l 0
      for j ulong get fg_chk1_l 0 bound 1020
        put fg_chk2 j get fg_chk1 j
      end
      put fg_chk2_l 0 get fg_chk1_l 0
      z = makedir fg_scr 0 get fg_scr_l 0 493
      if fg_run_positive
        fg_ctrl_noncanon_and_keys
        fg_ctrl_noise_and_format
      end
    else
      fg_werr fg_u_msg
      ret FG_ERR_ARG
    end
  end

  if ne get fg_fails 0 0
    ret FG_ERR_ARG
  end
  fg_wrt fg_m_p1
  fg_num get fg_checks 0
  fg_wrt fg_m_p2
  fg_num get fg_ctrls 0
  fg_wrt fg_m_p3
  fg_num get fg_caught 0
  fg_wrt fg_m_p4
  fg_num get fg_mut_kills 0
  fg_wrt fg_m_p5
  fg_num get fg_cmp_ok 0
  fg_wrt fg_m_p6
  ret FG_OK
end

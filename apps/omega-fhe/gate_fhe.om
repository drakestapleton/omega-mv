note ==== Section 1: Printing, Checks & Path Helpers ====

fn fg_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn fg_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn fg_num v ulong to void
  x = v
  p = ulong 32
  for i ulong 24
    p = sub p 1
    put fg_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 fg_dig p sub 32 p
      ret
    end
  end
end

fn fg_fail tag ulong to void
  put fg_fails 0 add get fg_fails 0 1
  fg_wrt fg_m_fail
  fg_num tag
  fg_wrt fg_nl
end

fn fg_chk cond bool tag ulong to void
  put fg_checks 0 add get fg_checks 0 1
  if not cond
    fg_fail tag
  end
end

fn fg_ctrl cond bool tag ulong to void
  put fg_ctrls 0 add get fg_ctrls 0 1
  if cond
    put fg_caught 0 add get fg_caught 0 1
  else
    fg_fail tag
  end
end

fn fg_arg_eq idx ulong s view uchar * to bool
  rn = argread idx fg_arg 0 1020
  if ne rn long len s
    ret false
  end
  for i ulong len s bound 256
    if ne get fg_arg i get s i
      ret false
    end
  end
  ret true
end

fn fg_arg_to_glob idx ulong slot ulong to ulong
  rn = argread idx fg_arg 0 1020
  if le rn 0
    ret 0
  end
  n = ulong rn
  for i ulong n bound 1020
    if eq slot 0
      put fg_omc i get fg_arg i
    else
      if eq slot 1
        put fg_root i get fg_arg i
      else
        if eq slot 2
          put fg_scr i get fg_arg i
        else
          if eq slot 3
            put fg_rlwe1 i get fg_arg i
          else
            put fg_chk1 i get fg_arg i
          end
        end
      end
    end
  end
  ret n
end

fn fg_set_p dst ulong from_scr bool suf view uchar * to ulong
  rl = ulong 0
  if from_scr
    rl = get fg_scr_l 0
  else
    rl = get fg_root_l 0
  end
  sl = len suf
  if gt add rl sl 1020
    ret 0
  end
  for i ulong rl bound 1020
    b = uchar 0
    if from_scr
      b = get fg_scr i
    else
      b = get fg_root i
    end
    if eq dst 0
      put fg_pa i b
    else
      if eq dst 1
        put fg_pb i b
      else
        if eq dst 2
          put fg_pc i b
        else
          if eq dst 3
            put fg_pd i b
          else
            put fg_pe i b
          end
        end
      end
    end
  end
  for j ulong sl bound 512
    c = get suf j
    if eq dst 0
      put fg_pa add rl j c
    else
      if eq dst 1
        put fg_pb add rl j c
      else
        if eq dst 2
          put fg_pc add rl j c
        else
          if eq dst 3
            put fg_pd add rl j c
          else
            put fg_pe add rl j c
          end
        end
      end
    end
  end
  tot = add rl sl
  if eq dst 0
    put fg_pal 0 tot
  else
    if eq dst 1
      put fg_pbl 0 tot
    else
      if eq dst 2
        put fg_pcl 0 tot
      else
        if eq dst 3
          put fg_pdl 0 tot
        else
          put fg_pel 0 tot
        end
      end
    end
  end
  ret tot
end

fn fg_set_bin_scr suf view uchar * to void
  rl = get fg_scr_l 0
  for i ulong rl bound 1020
    put fg_bin i get fg_scr i
  end
  sl = len suf
  for j ulong sl bound 512
    put fg_bin add rl j get suf j
  end
  put fg_bin_l 0 add rl sl
end

fn fg_use_rlwe1 to void
  n = get fg_rlwe1_l 0
  for i ulong n bound 1020
    put fg_bin i get fg_rlwe1 i
  end
  put fg_bin_l 0 n
end

fn fg_use_rlwe2 to void
  n = get fg_rlwe2_l 0
  for i ulong n bound 1020
    put fg_bin i get fg_rlwe2 i
  end
  put fg_bin_l 0 n
end

fn fg_use_chk2 to void
  n = get fg_chk2_l 0
  for i ulong n bound 1020
    put fg_bin i get fg_chk2 i
  end
  put fg_bin_l 0 n
end

note ==== Section 2: Subprocess, File I/O & Re-signing Helpers ====

fn fg_av_clr to void
  put fg_avn 0 2
  put fg_avc 0 0
  put fg_av 0 0
  put fg_av 1 0
end

fn fg_av_fin sl ulong to void
  p = get fg_avn 0
  put fg_av p uchar and sl 255
  put fg_av add p 1 uchar shr sl 8
  put fg_avn 0 add p add sl 2
  c = add get fg_avc 0 1
  put fg_avc 0 c
  put fg_av 0 uchar and c 255
  put fg_av 1 uchar shr c 8
end

fn fg_av_omc to void
  p = get fg_avn 0
  sl = get fg_omc_l 0
  for j ulong sl bound 1024
    put fg_av add add p 2 j get fg_omc j
  end
  fg_av_fin sl
end

fn fg_av_bin to void
  p = get fg_avn 0
  sl = get fg_bin_l 0
  for j ulong sl bound 1024
    put fg_av add add p 2 j get fg_bin j
  end
  fg_av_fin sl
end

fn fg_av_lit s view uchar * to void
  p = get fg_avn 0
  sl = len s
  for j ulong sl bound 1024
    put fg_av add add p 2 j get s j
  end
  fg_av_fin sl
end

fn fg_av_scr suf view uchar * to void
  zp = fg_set_p 0 true suf
  p = get fg_avn 0
  sl = get fg_pal 0
  for j ulong sl bound 1024
    put fg_av add add p 2 j get fg_pa j
  end
  fg_av_fin sl
end

fn fg_redir fd int target int to void
  if ne dupfd fd target 0 long target
    exit 127
  end
end

fn fg_run_sync fi long fo long fe long to ulong
  if or lt fi 0 or lt fo 0 lt fe 0
    if ge fi 0
      z = fclose int fi
    end
    if ge fo 0
      z = fclose int fo
    end
    if ge fe 0
      z = fclose int fe
    end
    ret 999
  end
  pid = fork
  if lt pid 0
    ret 998
  end
  if eq pid 0
    fg_redir int fi 0
    fg_redir int fo 1
    fg_redir int fe 2
    ze = execprog fg_av 0 get fg_avn 0
    exit 127
  end
  z = fclose int fi
  z = fclose int fo
  z = fclose int fe
  t0 = monons
  while true bound 100000000
    r = waitpid int pid fg_stb 0 len fg_stb 1
    if eq r pid
      if ne get fg_stb 0 0
        ret add 128 ulong get fg_stb 0
      end
      ret ulong get fg_stb 1
    end
    if lt r 0
      ret 997
    end
    if gt sub monons t0 60000000000
      zk = killpid int pid 9
      zw = waitpid int pid fg_stb 0 len fg_stb 0
      ret 996
    end
  end
  ret 995
end

fn fg_read_out_scr to void
  put fg_outl 0 0
  zp = fg_set_p 0 true fg_f_out
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret
  end
  rn = read int fd fg_out 0 16384
  z = fclose int fd
  if gt rn 0
    put fg_outl 0 ulong rn
  end
end

fn fg_spawn_cur to ulong
  zp = fg_set_p 0 true fg_f_out
  fi = fopen fg_null 0 len fg_null 0 0
  fo = fopen fg_pa 0 get fg_pal 0 577 420
  fe = fopen fg_null 0 len fg_null 0 0
  rc = fg_run_sync fi fo fe
  fg_read_out_scr
  ret rc
end

fn fg_has_sub pat view uchar * to bool
  ol = get fg_outl 0
  pl = len pat
  if or eq pl 0 gt pl ol
    ret false
  end
  lim = add sub ol pl 1
  for i ulong lim bound 16384
    ok = true
    for j ulong pl bound 128
      if ne get fg_out add i j get pat j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn fg_read_pa_to_sh to long
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn fg_scr_file_empty suf view uchar * to bool
  zp = fg_set_p 0 true suf
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret false
  end
  rn = read int fd fg_probe 0 1
  z = fclose int fd
  ret eq rn 0
end

fn fg_hash_scr suf view uchar * dst ulong to long
  zp = fg_set_p 0 true suf
  nb = fg_read_pa_to_sh
  if le nb 0
    ret -1
  end
  sh_all ulong nb
  for j ulong 32
    if eq dst 1
      put fg_h1 j get sh_dig j
    else
      put fg_h2 j get sh_dig j
    end
  end
  ret nb
end

fn fg_sh_u16 p ulong to ulong
  b0 = ulong get sh_dat p
  b1 = ulong get sh_dat add p 1
  ret or b0 shl b1 8
end

fn fg_sh_u32 p ulong to ulong
  v = ulong 0
  for b ulong 4
    v = or v shl ulong get sh_dat add p b mul b 8
  end
  ret v
end

fn fg_sh_u64 p ulong to ulong
  v = ulong 0
  for i ulong 8
    v = or v shl ulong get sh_dat add p i mul i 8
  end
  ret v
end

fn fg_check_static_elf suf view uchar * to bool
  zp = fg_set_p 0 true suf
  nb = fg_read_pa_to_sh
  if lt nb 128
    ret false
  end
  if or ne get sh_dat 0 127 ne get sh_dat 1 69
    ret false
  end
  if or ne get sh_dat 2 76 ne get sh_dat 3 70
    ret false
  end
  if or ne get sh_dat 4 2 ne fg_sh_u16 18 183
    ret false
  end
  phoff = fg_sh_u64 32
  phentsz = fg_sh_u16 54
  phnum = fg_sh_u16 56
  if or eq phnum 0 gt phnum 16
    ret false
  end
  for k ulong phnum bound 16
    if eq fg_sh_u32 add phoff mul k phentsz 2
      ret false
    end
  end
  ret true
end

note ==== Section 3: Pin Verification, 2x Deterministic Compile & Mutant Builder ====

fn fg_read_omc_to_sh to long
  fd = fopen fg_omc 0 get fg_omc_l 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16000000 bound 4096
    rn = read int fd sh_dat tot sub 16000000 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn fg_nib_eq idx ulong dig_b uchar to bool
  hi = shr dig_b 4
  lo = and dig_b 15
  hc = uchar add 48 hi
  if ge hi 10
    hc = uchar add 87 hi
  end
  lc = uchar add 48 lo
  if ge lo 10
    lc = uchar add 87 lo
  end
  if ne hc get fg_pin_hex mul idx 2
    ret false
  end
  if ne lc get fg_pin_hex add mul idx 2 1
    ret false
  end
  ret true
end

fn fg_verify_omc_pin to bool
  zp = fg_set_p 0 false fg_p_pin
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret false
  end
  rn = read int fd fg_pin_hex 0 128
  z = fclose int fd
  if lt rn 64
    ret false
  end
  nb = fg_read_omc_to_sh
  if le nb 0
    ret false
  end
  sh_all ulong nb
  for i ulong 32
    if not fg_nib_eq i get sh_dig i
      ret false
    end
  end
  ret true
end

fn fg_append_root suf view uchar * to bool
  zp = fg_set_p 0 false suf
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret false
  end
  tot = get fg_srcl 0
  while lt tot 262144 bound 64
    rn = read int fd fg_src tot sub 262144 tot
    if lt rn 0
      z = fclose int fd
      ret false
    end
    if eq rn 0
      z = fclose int fd
      put fg_srcl 0 tot
      ret true
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret false
end

fn fg_write_src_buf scr_suf view uchar * n ulong is_mut bool to bool
  zp = fg_set_p 0 true scr_suf
  fd = fopen fg_pa 0 get fg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 64
    wn = long 0
    if is_mut
      wn = write int fd fg_mut off sub n off
    else
      wn = write int fd fg_src off sub n off
    end
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

fn fg_build_rlwe_src to ulong
  put fg_srcl 0 0
  if not fg_append_root fg_u0
    ret 0
  end
  if not fg_append_root fg_u1
    ret 0
  end
  if not fg_append_root fg_u2
    ret 0
  end
  if not fg_append_root fg_u3
    ret 0
  end
  if not fg_append_root fg_u4
    ret 0
  end
  if not fg_append_root fg_u_rlwe
    ret 0
  end
  n = get fg_srcl 0
  if not fg_write_src_buf fg_f_rsrc n false
    ret 0
  end
  ret n
end

fn fg_build_chk_src to ulong
  put fg_srcl 0 0
  if not fg_append_root fg_u0
    ret 0
  end
  if not fg_append_root fg_u1
    ret 0
  end
  if not fg_append_root fg_u2
    ret 0
  end
  if not fg_append_root fg_u3
    ret 0
  end
  if not fg_append_root fg_u_chk
    ret 0
  end
  n = get fg_srcl 0
  if not fg_write_src_buf fg_f_csrc n false
    ret 0
  end
  ret n
end

fn fg_compile_scr s_suf view uchar * b_suf view uchar * e_suf view uchar * to ulong
  fg_av_clr
  fg_av_omc
  zp = fg_set_p 0 true s_suf
  zp = fg_set_p 1 true b_suf
  zp = fg_set_p 2 true e_suf
  fi = fopen fg_pa 0 get fg_pal 0 0 0
  fo = fopen fg_pb 0 get fg_pbl 0 577 493
  fe = fopen fg_pc 0 get fg_pcl 0 577 420
  rc = fg_run_sync fi fo fe
  if eq rc 0
    zp = fg_set_p 1 true b_suf
    zcm = chmod fg_pb 0 get fg_pbl 0 493
  end
  ret rc
end

fn fg_mut_reset to void
  sl = get fg_srcl 0
  for i ulong sl bound 262144
    put fg_mut i get fg_src i
  end
  put fg_mutl 0 sl
end

fn fg_mut_match_at base ulong pat view uchar * to bool
  for j ulong len pat bound 256
    if ne get fg_mut add base j get pat j
      ret false
    end
  end
  ret true
end

fn fg_mut_find old_s view uchar * to long
  ml = get fg_mutl 0
  ol = len old_s
  if gt ol ml
    ret -1
  end
  hits = ulong 0
  pos = ulong 0
  lim = add sub ml ol 1
  for i ulong lim bound 262144
    if fg_mut_match_at i old_s
      hits = add hits 1
      pos = i
    end
  end
  if ne hits 1
    ret -1
  end
  ret long pos
end

fn fg_mut_copy_tail dst_off ulong src_off ulong count ulong to void
  for i ulong count bound 262144
    put fg_tmp add dst_off i get fg_mut add src_off i
  end
end

fn fg_mut_splice pos ulong ol ulong new_s view uchar * to bool
  ml = get fg_mutl 0
  nl = len new_s
  outn = add sub ml ol nl
  if gt outn 262144
    ret false
  end
  for i ulong pos bound 262144
    put fg_tmp i get fg_mut i
  end
  for j ulong nl bound 256
    put fg_tmp add pos j get new_s j
  end
  fg_mut_copy_tail add pos nl add pos ol sub ml add pos ol
  for i ulong outn bound 262144
    put fg_mut i get fg_tmp i
  end
  put fg_mutl 0 outn
  ret true
end

fn fg_mut_patch old_s view uchar * new_s view uchar * to bool
  pos = fg_mut_find old_s
  if lt pos 0
    ret false
  end
  ret fg_mut_splice ulong pos len old_s new_s
end

fn fg_mut_compile to bool
  if not fg_write_src_buf fg_f_msrc get fg_mutl 0 true
    ret false
  end
  ret eq fg_compile_scr fg_f_msrc fg_f_mb fg_f_me 0
end

note ==== Section 4: OMFHE1 Container Helpers & Attacker Re-Signer ====

fn fg_load_file_to scr_suf view uchar * dst ulong nmax ulong to long
  zp = fg_set_p 0 true scr_suf
  fd = fopen fg_pa 0 get fg_pal 0 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot nmax bound 256
    rn = long 0
    if eq dst 0
      rn = read int fd fg_ctbuf tot sub nmax tot
    else
      rn = read int fd fg_evkbuf tot sub nmax tot
    end
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn fg_reset_atk from_evk bool to ulong
  n = FH_CT_BYTES
  if from_evk
    n = FH_EVK_BYTES
  end
  for i ulong n bound 16384
    if from_evk
      put fg_atk i get fg_evkbuf i
    else
      put fg_atk i get fg_ctbuf i
    end
  end
  ret n
end

fn fg_put_atk_u64 off ulong v ulong to void
  for i ulong 8
    put fg_atk add off i uchar and shr v mul i 8 255
  end
end

fn fg_resign_ed to void
  sd = new uchar 32 0
  pk = new uchar 32 0
  m = new uchar 65536 0
  sg = new uchar 64 0
  for i ulong 32
    put sd i uchar xor mul i 7 91
  end
  ues_pubkey sd pk
  for i ulong 32
    put fg_atk add 160 i get pk i
  end
  for i ulong 160
    put m i get fg_atk i
  end
  ues_sign sd m 160 sg
  for i ulong 64
    put fg_atk add 192 i get sg i
  end
end

fn fg_resign_atk tot ulong to void
  pay_b = sub tot 256
  for i ulong pay_b bound 16384
    put sh_dat i get fg_atk add 256 i
  end
  sh_all pay_b
  for i ulong 32
    put fg_atk add 96 i get sh_dig i
  end
  for i ulong 128
    put sh_dat i get fg_atk i
  end
  for i ulong pay_b bound 16384
    put sh_dat add 128 i get fg_atk add 256 i
  end
  sh_all add 128 pay_b
  for i ulong 32
    put fg_atk add 128 i get sh_dig i
  end
  fg_resign_ed
end

fn fg_write_atk n ulong to bool
  zp = fg_set_p 0 true fg_f_atk
  fd = fopen fg_pa 0 get fg_pal 0 577 420
  if lt fd 0
    ret false
  end
  off = ulong 0
  while lt off n bound 256
    wn = write int fd fg_atk off sub n off
    if le wn 0
      z = fclose int fd
      ret false
    end
    off = add off ulong wn
  end
  z = fclose int fd
  ret true
end

note ==== Section 5: Subprocess Wrappers for fhe_rlwe & fhe_check ====

fn fg_insp_atk exp_rc ulong tag ulong to void
  fg_use_rlwe2
  fg_av_clr
  fg_av_bin
  fg_av_lit fg_c_insp
  fg_av_lit fg_fl_in
  fg_av_scr fg_f_atk
  rc = fg_spawn_cur
  fg_ctrl eq rc exp_rc tag
end

fn fg_vct_in suf view uchar * sk_suf view uchar * evk_suf view uchar * to ulong
  fg_use_chk2
  fg_av_clr

note SPDX-License-Identifier: Apache-2.0
note apps/omega-fhe/fhe_check.om
note Wave 5 Independent FHE Verifier (ZERO shared NTT/Montgomery/Eval code with fhe_rlwe.om).
note Uses independent 128-bit long division and direct schoolbook Z_q[X]/(X^N+1) & Z_t[X]/(X^N+1).
note
note Compose after:
note   si/directives/om2.om
note   seed/ng/sha256.om
note   protocol/omnet/om/sha512/sha512.om
note   protocol/omnet/om/ed25519/ed25519.om
note
note Zero C, zero Python, zero Rust, zero gcc, zero floats, zero GPU device writes (hw_writes=0).

note ==== Section 1: Constants & Distinct Exit Codes ====

const FC_N ulong 64
const FC_Q ulong 72057594036480257
const FC_T ulong 257
const FC_HALF_Q ulong 36028797018240128
const FC_MAX_NOISE ulong 140189871666303

const FC_RELIN_K ulong 7
const FC_HDR_BYTES ulong 256
const FC_SK_PAYLOAD ulong 512
const FC_EVK_PAYLOAD ulong 8192
const FC_CT_PAYLOAD ulong 1024
const FC_KIND_SK ulong 1
const FC_KIND_EVK ulong 2
const FC_KIND_CT ulong 3
const FC_VERSION ulong 1

const FC_OK int 0
const FC_ERR_IO int 1
const FC_ERR_FORMAT int 70
const FC_ERR_DOMAIN int 71
const FC_ERR_SHA int 72
const FC_ERR_ED25519 int 73
const FC_ERR_NONCANON int 74
const FC_ERR_NOISE_BUDGET int 75
const FC_ERR_PLAINTEXT int 76
const FC_ERR_KIND int 77
const FC_ERR_KEY_LEAK int 80
const FC_ERR_MISMATCH int 81
const FC_ERR_BLIND_RUN int 82


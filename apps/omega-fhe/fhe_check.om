note ==== Section 3: Printing, Byte Decoding & Path Helpers ====

fn fc_wrt s view uchar * to void
  z = write 1 s 0 len s
end

fn fc_werr s view uchar * to void
  z = write 2 s 0 len s
end

fn fc_u64 v ulong to void
  x = v
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put fc_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 1 fc_dig p sub 24 p
      ret
    end
  end
end

fn fc_print_fail code int to int
  fc_werr fc_m_fail
  x = ulong code
  p = ulong 24
  for i ulong 21
    p = sub p 1
    put fc_dig p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      z = write 2 fc_dig p sub 24 p
      z2 = write 2 fc_nl 0 1
      ret code
    end
  end
  ret code
end

fn fc_get_u16 p ulong to ulong
  b0 = ulong get fc_buf p
  b1 = ulong get fc_buf add p 1
  ret or b0 shl b1 8
end

fn fc_get_u32 p ulong to ulong
  v = ulong 0
  for i ulong 4
    b = ulong get fc_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn fc_get_u64 p ulong to ulong
  v = ulong 0
  for i ulong 8
    b = ulong get fc_buf add p i
    v = or v shl b mul i 8
  end
  ret v
end

fn fc_arg_eq idx ulong lit view uchar * to bool
  rn = argread idx fc_arg 0 1020
  if ne rn long len lit
    ret false
  end
  for i ulong len lit bound 64
    if ne get fc_arg i get lit i
      ret false
    end
  end
  ret true
end

fn fc_parse_u64 idx ulong to bool
  rn = argread idx fc_arg 0 64
  if le rn 0
    ret false
  end
  v = ulong 0
  for i ulong ulong rn bound 64
    ch = ulong get fc_arg i
    if or lt ch 48 gt ch 57
      ret false
    end
    d = sub ch 48
    lim = div sub 0xffffffffffffffff d 10
    if gt v lim
      ret false
    end
    v = add mul v 10 d
  end
  put fc_meta 6 v
  ret true
end

fn fc_copy_arg_path idx ulong slot ulong to bool
  rn = argread idx fc_arg 0 1020
  if le rn 0
    ret false
  end
  u = ulong rn
  for i ulong u bound 1024
    b = get fc_arg i
    if eq slot 0
      put fc_p_sk i b
    end
    if eq slot 1
      put fc_p_evk i b
    end
    if eq slot 2
      put fc_p_in i b
    end
    if eq slot 3
      put fc_p_ctx i b
    end
    if eq slot 4
      put fc_p_cty i b
    end
    if eq slot 5
      put fc_p_bin i b
    end
    if eq slot 6
      put fc_p_scr i b
    end
  end
  if eq slot 0
    put fc_p_sk_l 0 u
  end
  if eq slot 1
    put fc_p_evk_l 0 u
  end
  if eq slot 2
    put fc_p_in_l 0 u
  end
  if eq slot 3
    put fc_p_ctx_l 0 u
  end
  if eq slot 4
    put fc_p_cty_l 0 u
  end
  if eq slot 5
    put fc_p_bin_l 0 u
  end
  if eq slot 6
    put fc_p_scr_l 0 u
  end
  ret true
end

fn fc_parse_poly_arg idx ulong target ulong to int
  rn = argread idx fc_arg 0 1020
  if le rn 0
    ret FC_ERR_IO
  end
  for i ulong FC_N
    if eq target 0
      put fc_px i 0
    else
      put fc_py i 0
    end
  end
  u = ulong rn
  cidx = ulong 0
  acc = ulong 0
  has_d = false
  for i ulong u bound 1024
    ch = ulong get fc_arg i
    if eq ch 44
      if or not has_d ge cidx FC_N
        ret FC_ERR_IO
      end
      if ge acc FC_T
        ret FC_ERR_PLAINTEXT
      end
      if eq target 0
        put fc_px cidx acc
      else
        put fc_py cidx acc
      end
      cidx = add cidx 1
      acc = ulong 0
      has_d = false
    else
      if or lt ch 48 gt ch 57
        ret FC_ERR_IO
      end
      if gt acc 1000000
        ret FC_ERR_PLAINTEXT
      end
      acc = add mul acc 10 sub ch 48
      has_d = true
    end
  end
  if or not has_d ge cidx FC_N
    ret FC_ERR_IO
  end
  if ge acc FC_T
    ret FC_ERR_PLAINTEXT
  end
  if eq target 0
    put fc_px cidx acc
  else
    put fc_py cidx acc
  end
  ret FC_OK
end

note ==== Section 4: Independent 128-bit Schoolbook Z_q & Z_t Arithmetic (ZERO NTT) ====

fn fc_u128_mul a ulong b ulong to void
  p00 = mul and a 0xffffffff and b 0xffffffff
  p01 = mul and a 0xffffffff shr b 32
  p10 = mul shr a 32 and b 0xffffffff
  p11 = mul shr a 32 shr b 32
  t = shr p00 32
  t = add t and p01 0xffffffff
  t = add t and p10 0xffffffff
  put fc_u_lo 0 or and p00 0xffffffff shl and t 0xffffffff 32
  hi = add p11 shr p01 32
  hi = add hi shr p10 32
  hi = add hi shr t 32
  put fc_u_hi 0 hi
end

fn fc_u128_add_small alo ulong ahi ulong v ulong to void
  lo = add alo v
  hi = ahi
  if lt lo alo
    hi = add hi 1
  end
  put fc_u_lo 0 lo
  put fc_u_hi 0 hi
end

fn fc_q_add a ulong b ulong to ulong
  s = add a b
  if ge s FC_Q
    ret sub s FC_Q
  end
  ret s
end

fn fc_q_sub a ulong b ulong to ulong
  if ge a b
    ret sub a b
  end
  ret sub FC_Q sub b a
end

fn fc_q_mul a ulong b ulong to ulong
  fc_u128_mul a b
  nhi = get fc_u_hi 0
  nlo = get fc_u_lo 0
  r = rem nhi FC_Q
  for s ulong 64
    sh = sub 63 s
    r = or shl r 1 and shr nlo sh 1
    if ge r FC_Q
      r = sub r FC_Q
    end
  end
  ret r
end

fn fc_decode_q_coeff v ulong to ulong
  fc_u128_mul v FC_T
  fc_u128_add_small get fc_u_lo 0 get fc_u_hi 0 FC_HALF_Q
  nhi = get fc_u_hi 0
  nlo = get fc_u_lo 0
  qhi = div nhi FC_Q
  r = rem nhi FC_Q
  qlo = ulong 0
  for s ulong 64
    sh = sub 63 s
    r = or shl r 1 and shr nlo sh 1
    if ge r FC_Q
      r = sub r FC_Q
      qlo = or qlo shl ulong 1 sh
    end
  end
  m = add rem qhi FC_T rem qlo FC_T
  ret rem m FC_T
end

note Direct schoolbook decryption in Z_q[X]/(X^N+1) without NTT
fn fc_decrypt_sb target_ct ulong to void
  for k ulong FC_N
    acc = ulong 0
    for i ulong FC_N
      j = ulong 0
      neg_t = false
      if ge k i
        j = sub k i
      else
        j = sub add k FC_N i
        neg_t = true
      end
      c1v = ulong 0
      if eq target_ct 0
        c1v = get fc_ct1 i
      else
        if eq target_ct 1
          c1v = get fc_ctx1 i
        else
          c1v = get fc_cty1 i
        end
      end
      pr = fc_q_mul c1v get fc_sk j
      if neg_t
        acc = fc_q_sub acc pr
      else
        acc = fc_q_add acc pr
      end
    end
    c0v = ulong 0
    if eq target_ct 0
      c0v = get fc_ct0 k
    else
      if eq target_ct 1
        c0v = get fc_ctx0 k
      else
        c0v = get fc_cty0 k
      end
    end
    v = fc_q_add c0v acc
    put fc_got k fc_decode_q_coeff v
  end
end

note Direct schoolbook polynomial ring arithmetic in Z_t[X]/(X^N+1)
fn fc_t_mul which_a ulong which_b ulong out_slot ulong to void
  for k ulong FC_N
    acc = ulong 0
    for i ulong FC_N
      j = ulong 0
      neg_t = false
      if ge k i
        j = sub k i
      else
        j = sub add k FC_N i
        neg_t = true
      end
      va = ulong 0
      if eq which_a 0
        va = get fc_px i
      else
        if eq which_a 1
          va = get fc_py i
        else
          va = get fc_t1 i
        end
      end
      vb = ulong 0
      if eq which_b 0
        vb = get fc_px j
      else
        if eq which_b 1
          vb = get fc_py j
        else
          vb = get fc_pz j
        end
      end
      pr = rem mul va vb FC_T
      if neg_t
        pr = rem sub FC_T pr FC_T
      end
      acc = rem add acc pr FC_T
    end
    if eq out_slot 1
      put fc_t1 k acc
    else
      if eq out_slot 2
        put fc_t2 k acc
      else
        put fc_want k acc
      end
    end
  end
end

fn fc_t_eval_quad a ulong b ulong c ulong d ulong to void
  note fc_t1 = x*x, fc_t2 = x*y
  fc_t_mul 0 0 1
  fc_t_mul 0 1 2
  for i ulong FC_N
    t1 = rem mul a get fc_t1 i FC_T
    t2 = rem mul b get fc_t2 i FC_T
    t3 = rem mul c get fc_py i FC_T
    s = rem add add t1 t2 t3 FC_T
    if eq i 0
      s = rem add s d FC_T
    end
    put fc_want i s
  end
end

fn fc_got_eq_want to bool
  for i ulong FC_N
    if ne get fc_got i get fc_want i
      ret false
    end
  end
  ret true
end

note ==== Section 5: Independent Fail-Closed OMFHE1 Container & Bounds Verifier ====

fn fc_read_path_buf slot ulong to long
  fd = long -1
  if eq slot 0
    fd = fopen fc_p_sk 0 get fc_p_sk_l 0 0 0
  end
  if eq slot 1
    fd = fopen fc_p_evk 0 get fc_p_evk_l 0 0 0
  end
  if eq slot 2
    fd = fopen fc_p_in 0 get fc_p_in_l 0 0 0
  end
  if eq slot 3
    fd = fopen fc_p_ctx 0 get fc_p_ctx_l 0 0 0
  end
  if eq slot 4
    fd = fopen fc_p_cty 0 get fc_p_cty_l 0 0 0
  end
  if eq slot 7
    fd = fopen fc_p_tmp 0 get fc_p_tmp_l 0 0 0
  end
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 16384 bound 256
    rn = read int fd fc_buf tot sub 16384 tot
    if lt rn 0
      z = fclose int fd
      ret -1
    end
    if eq rn 0
      z = fclose int fd
      ret long tot
    end
    tot = add tot ulong rn
  end
  z = fclose int fd
  ret -1
end

fn fc_verify_ed25519 to bool
  pk = new uchar 32 0
  m = new uchar 65536 0
  sg = new uchar 64 0
  nz = ulong 0
  for i ulong 32
    b = get fc_buf add 160 i
    if ne b 0
      nz = add nz 1
    end
    put pk i b
  end
  if eq nz 0
    ret false
  end
  for i ulong 160
    put m i get fc_buf i
  end
  for i ulong 64
    put sg i get fc_buf add 192 i
  end
  ret eq edverify pk m 160 sg 0 1
end

fn fc_verify_omfhe1 flen ulong exp_kind ulong to int
  if lt flen FC_HDR_BYTES
    ret FC_ERR_FORMAT
  end
  for i ulong len fc_t_magic bound 6
    if ne get fc_buf i get fc_t_magic i
      ret FC_ERR_FORMAT
    end
  end
  if ne fc_get_u16 6 FC_VERSION
    ret FC_ERR_FORMAT
  end
  kind = fc_get_u32 8
  if ne kind exp_kind
    ret FC_ERR_KIND
  end
  exp_pay = ulong 0
  if eq kind FC_KIND_SK
    exp_pay = FC_SK_PAYLOAD
  else
    if eq kind FC_KIND_EVK
      exp_pay = FC_EVK_PAYLOAD
    else
      exp_pay = FC_CT_PAYLOAD
    end
  end
  if or ne fc_get_u32 12 FC_N or ne fc_get_u64 16 FC_Q ne fc_get_u64 24 FC_T
    ret FC_ERR_FORMAT
  end
  if ne fc_get_u32 52 FC_RELIN_K
    ret FC_ERR_FORMAT
  end
  pay_b = fc_get_u64 56
  if or ne pay_b exp_pay ne flen add FC_HDR_BYTES exp_pay
    ret FC_ERR_FORMAT
  end
  if true
    dl = len fc_t_dom
    for i ulong 32
      want = uchar 0
      if lt i dl
        want = get fc_t_dom i
      end
      if ne get fc_buf add 64 i want
        ret FC_ERR_DOMAIN
      end
    end
  end

  for i ulong pay_b bound 16384
    put sh_dat i get fc_buf add FC_HDR_BYTES i
  end
  sh_all pay_b
  for i ulong 32
    if ne get sh_dig i get fc_buf add 96 i
      ret FC_ERR_SHA
    end
  end

  for i ulong 128
    put sh_dat i get fc_buf i
  end
  for i ulong pay_b bound 16384
    put sh_dat add 128 i get fc_buf add FC_HDR_BYTES i
  end
  sh_all add 128 pay_b
  for i ulong 32
    if ne get sh_dig i get fc_buf add 128 i
      ret FC_ERR_SHA
    end
  end

  if not fc_verify_ed25519
    ret FC_ERR_ED25519
  end

  nwords = div pay_b 8
  for i ulong nwords bound 2048
    w = fc_get_u64 add FC_HDR_BYTES mul i 8
    if ge w FC_Q
      ret FC_ERR_NONCANON
    end
  end

  if eq kind FC_KIND_CT
    nb = fc_get_u64 32
    bud = fc_get_u64 40
    if or gt nb FC_MAX_NOISE ne bud sub FC_MAX_NOISE nb
      ret FC_ERR_NOISE_BUDGET
    end
    put fc_meta 7 nb
    put fc_meta 8 fc_get_u32 48
  end
  ret FC_OK
end

fn fc_load_sk slot ulong to int
  fl = fc_read_path_buf slot
  if lt fl 0
    ret FC_ERR_IO
  end
  rc = fc_verify_omfhe1 ulong fl FC_KIND_SK
  if ne rc FC_OK
    ret rc
  end
  for i ulong 32
    put fc_sk_sha i get fc_buf add 96 i
  end
  for i ulong FC_N
    put fc_sk i fc_get_u64 add FC_HDR_BYTES mul i 8
  end
  ret FC_OK
end

fn fc_load_evk slot ulong to int
  fl = fc_read_path_buf slot
  if lt fl 0
    ret FC_ERR_IO
  end
  rc = fc_verify_omfhe1 ulong fl FC_KIND_EVK
  if ne rc FC_OK
    ret rc
  end
  for i ulong 32
    put fc_evk_sha i get fc_buf add 96 i
  end
  ret FC_OK
end

fn fc_check_sk_evk_distinct to bool
  for i ulong 32
    if ne get fc_sk_sha i get fc_evk_sha i
      ret true
    end
  end
  ret false
end

fn fc_load_ct file_slot ulong dst_slot ulong to int
  fl = fc_read_path_buf file_slot
  if lt fl 0
    ret FC_ERR_IO
  end
  rc = fc_verify_omfhe1 ulong fl FC_KIND_CT
  if ne rc FC_OK
    ret rc
  end
  off = FC_HDR_BYTES
  for i ulong FC_N
    v0 = fc_get_u64 add off mul i 8
    v1 = fc_get_u64 add add off 512 mul i 8
    if eq dst_slot 0
      put fc_ct0 i v0
      put fc_ct1 i v1
    else
      if eq dst_slot 1
        put fc_ctx0 i v0
        put fc_ctx1 i v1
      else
        put fc_cty0 i v0
        put fc_cty1 i v1
      end
    end
  end
  ret FC_OK
end

note ==== Section 6: Subprocess Sandbox Runner for Blind Evaluator Audit ====

fn fc_av_clr to void
  put fc_avn 0 2
  put fc_avc 0 0
  put fc_av 0 0
  put fc_av 1 0
end

fn fc_av_fin sl ulong to void
  p = get fc_avn 0
  put fc_av p uchar and sl 255
  put fc_av add p 1 uchar shr sl 8
  put fc_avn 0 add p add sl 2
  c = add get fc_avc 0 1
  put fc_avc 0 c
  put fc_av 0 uchar and c 255
  put fc_av 1 uchar shr c 8
end

fn fc_av_lit s view uchar * to void
  p = get fc_avn 0
  sl = len s
  for j ulong sl bound 1024
    put fc_av add add p 2 j get s j
  end
  fc_av_fin sl
end

fn fc_av_bin to void
  p = get fc_avn 0
  sl = get fc_p_bin_l 0
  for j ulong sl bound 1024
    put fc_av add add p 2 j get fc_p_bin j
  end
  fc_av_fin sl
end

fn fc_av_scr_sub subp view uchar * to void
  p = get fc_avn 0
  rl = get fc_p_scr_l 0
  sl = len subp
  for j ulong rl bound 1024
    put fc_av add add p 2 j get fc_p_scr j
  end
  for j ulong sl bound 256
    put fc_av add add add p 2 rl j get subp j
  end
  fc_av_fin add rl sl
end

fn fc_set_tmp_scr subp view uchar * to void
  rl = get fc_p_scr_l 0
  sl = len subp
  for j ulong rl bound 1024
    put fc_p_tmp j get fc_p_scr j
  end
  for j ulong sl bound 256
    put fc_p_tmp add rl j get subp j
  end
  put fc_p_tmp_l 0 add rl sl
end

fn fc_set_cwd_blind to void
  rl = get fc_p_scr_l 0
  sl = len fc_s_blind
  for j ulong rl bound 1024
    put fc_p_cwd j get fc_p_scr j
  end
  for j ulong sl bound 256
    put fc_p_cwd add rl j get fc_s_blind j
  end
  put fc_p_cwd_l 0 add rl sl
end

fn fc_av_u64 v ulong to void
  nb = new uchar 24 0
  x = v
  pos = ulong 24
  for i ulong 21
    pos = sub pos 1
    put nb pos uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      p = get fc_avn 0
      sl = sub 24 pos
      for j ulong sl bound 24
        put fc_av add add p 2 j get nb add pos j
      end
      fc_av_fin sl
      ret
    end
  end
end

fn fc_av_poly which ulong to void
  pb = new uchar 512 0
  plen = ulong 0
  for k ulong FC_N
    if gt k 0
      put pb plen uchar 44
      plen = add plen 1
    end
    v = ulong 0
    if eq which 0
      v = get fc_px k
    else
      if eq which 1
        v = get fc_py k
      else
        v = get fc_pz k
      end
    end
    if eq v 0
      put pb plen uchar 48
      plen = add plen 1
    else
      if true
        d0 = rem v 10
        v1 = div v 10
        d1 = rem v1 10
        v2 = div v1 10
        if gt v2 0
          put pb plen uchar add 48 v2
          put pb add plen 1 uchar add 48 d1
          put pb add plen 2 uchar add 48 d0
          plen = add plen 3
        else
          if gt v1 0
            put pb plen uchar add 48 d1
            put pb add plen 1 uchar add 48 d0
            plen = add plen 2
          else
            put pb plen uchar add 48 d0
            plen = add plen 1
          end
        end
      end
    end
  end
  p = get fc_avn 0
  for j ulong plen bound 512
    put fc_av add add p 2 j get pb j
  end
  fc_av_fin plen
end

fn fc_spawn_quiet in_blind bool to ulong
  pid = fork
  if lt pid 0
    ret 998
  end
  if eq pid 0
    fi = fopen fc_t_null 0 len fc_t_null 0 0
    fo = fopen fc_t_null 0 len fc_t_null 577 420
    fe = fopen fc_t_null 0 len fc_t_null 577 420
    if or lt fi 0 or lt fo 0 lt fe 0
      exit 127
    end
    z0 = dupfd int fi 0 0
    z1 = dupfd int fo 1 0
    z2 = dupfd int fe 2 0
    if in_blind
      zc = chdir fc_p_cwd 0 get fc_p_cwd_l 0
      if ne zc 0
        exit 126
      end
    end
    ze = execprog fc_av 0 get fc_avn 0
    exit 127
  end
  while true bound 100000000
    r = waitpid int pid fc_stb 0 len fc_stb 1
    if eq r pid
      if ne get fc_stb 0 0
        ret add 128 ulong get fc_stb 0
      end
      ret ulong get fc_stb 1
    end
    if lt r 0
      ret 997
    end
  end
  ret 995
end

fn fc_blind_encrypt which ulong seed_s view uchar * out_rel view uchar * to bool
  fc_av_clr
  fc_av_bin
  fc_av_lit fc_op_enc
  fc_av_lit fc_fl_evk
  fc_av_lit fc_s_evk_rel
  fc_av_lit fc_fl_poly
  fc_av_poly which
  fc_av_lit fc_fl_seed
  fc_av_lit seed_s
  fc_av_lit fc_fl_out
  fc_av_lit out_rel
  ret eq fc_spawn_quiet true 0
end

fn fc_blind_eval_quad a ulong b ulong c ulong d ulong to bool
  fc_av_clr
  fc_av_bin
  fc_av_lit fc_op_epoly
  fc_av_lit fc_fl_evk
  fc_av_lit fc_s_evk_rel
  fc_av_lit fc_fl_x
  fc_av_lit fc_s_ctx
  fc_av_lit fc_fl_y
  fc_av_lit fc_s_cty
  fc_av_lit fc_fl_a
  fc_av_u64 a
  fc_av_lit fc_fl_b
  fc_av_u64 b
  fc_av_lit fc_fl_c
  fc_av_u64 c
  fc_av_lit fc_fl_d
  fc_av_u64 d
  fc_av_lit fc_fl_out
  fc_av_lit fc_s_cto
  ret eq fc_spawn_quiet true 0
end

fn fc_check_blind_out to int
  fc_set_tmp_scr fc_s_cto_full
  rc = fc_load_ct 7 0
  if ne rc FC_OK
    ret rc
  end
  fc_decrypt_sb 0
  if not fc_got_eq_want
    ret FC_ERR_MISMATCH
  end
  put fc_meta 9 add get fc_meta 9 1
  ret FC_OK
end

fn fc_av_file_id fid ulong to void
  if eq fid 0
    fc_av_lit fc_s_ctx
  else
    if eq fid 1
      fc_av_lit fc_s_cty
    else
      if eq fid 2
        fc_av_lit fc_s_ctz
      else
        if eq fid 3
          fc_av_lit fc_s_ct1
        else
          fc_av_lit fc_s_cto
        end
      end
    end
  end
end

fn fc_blind_binop op_id ulong aid ulong bid ulong oid ulong to bool
  fc_av_clr
  fc_av_bin
  if eq op_id 1
    fc_av_lit fc_op_add
  else
    if eq op_id 2
      fc_av_lit fc_op_sub
    else
      fc_av_lit fc_op_mul
    end
  end
  fc_av_lit fc_fl_evk
  fc_av_lit fc_s_evk_rel
  fc_av_lit fc_fl_a
  fc_av_file_id aid
  fc_av_lit fc_fl_b
  fc_av_file_id bid
  fc_av_lit fc_fl_out
  fc_av_file_id oid
  ret eq fc_spawn_quiet true 0
end

fn fc_blind_cmul aid ulong sc ulong oid ulong to bool
  fc_av_clr
  fc_av_bin
  fc_av_lit fc_op_cmul
  fc_av_lit fc_fl_evk
  fc_av_lit fc_s_evk_rel
  fc_av_lit fc_fl_a
  fc_av_file_id aid
  fc_av_lit fc_fl_c
  fc_av_u64 sc
  fc_av_lit fc_fl_out
  fc_av_file_id oid
  ret eq fc_spawn_quiet true 0
end

fn fc_load_case_poly tid ulong to void
  for i ulong FC_N
    if eq tid 0
      put fc_px i 0
      put fc_py i 0
    end
    if eq tid 1
      put fc_px i 0
      put fc_py i 0
    end
    if eq tid 2
      put fc_px i rem add mul i 37 19 FC_T
      put fc_py i rem add mul i 83 201 FC_T
    end
    if eq tid 3
      put fc_px i 256
      put fc_py i 256
    end
  end
  if eq tid 0
    put fc_px 0 3
    put fc_px 1 17
    put fc_px 2 42
    put fc_py 0 5
    put fc_py 1 11
    put fc_py 2 200
  end
  if eq tid 1
    put fc_px 0 5
    put fc_px 62 111
    put fc_px 63 200
    put fc_py 0 9
    put fc_py 3 77
    put fc_py 63 150
  end
end

fn fc_audit_quad_case tid ulong a ulong b ulong c ulong d ulong to int
  fc_load_case_poly tid
  if not fc_blind_encrypt 0 fc_v_111 fc_s_ctx
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_encrypt 1 fc_v_222 fc_s_cty
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_eval_quad a b c d
    ret FC_ERR_BLIND_RUN
  end
  fc_t_eval_quad a b c d
  ret fc_check_blind_out
end

fn fc_audit_add_sub_cmul to int
  fc_load_case_poly 2
  if not fc_blind_encrypt 0 fc_v_111 fc_s_ctx
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_encrypt 1 fc_v_222 fc_s_cty
    ret FC_ERR_BLIND_RUN
  end

  if not fc_blind_binop 1 0 1 3
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_binop 2 3 1 4
    ret FC_ERR_BLIND_RUN
  end
  for i ulong FC_N
    put fc_want i get fc_px i
  end
  rc = fc_check_blind_out
  if ne rc FC_OK
    ret rc
  end

  note Check const-mul across zero, positive (128), negative-centered (129, 256)
  for i ulong FC_N
    put fc_want i rem mul 129 get fc_px i FC_T
  end
  if not fc_blind_cmul 0 129 4
    ret FC_ERR_BLIND_RUN
  end
  rc = fc_check_blind_out
  if ne rc FC_OK
    ret rc
  end

  note Check depth-2 mul chain: (x * y) * z
  for i ulong FC_N
    put fc_pz i 0
  end
  put fc_pz 0 1
  put fc_pz 1 2
  put fc_pz 63 5
  if not fc_blind_encrypt 2 fc_v_333 fc_s_ctz
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_binop 3 0 1 3
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_binop 3 3 2 4
    ret FC_ERR_BLIND_RUN
  end
  fc_t_mul 0 1 1
  fc_t_mul 2 2 0
  ret fc_check_blind_out
end

fn fc_run_audit_blind to int
  z0 = makedir fc_p_scr 0 get fc_p_scr_l 0 493
  fc_set_tmp_scr fc_s_vault
  z1 = makedir fc_p_tmp 0 get fc_p_tmp_l 0 493
  fc_set_cwd_blind
  z2 = makedir fc_p_cwd 0 get fc_p_cwd_l 0 493

  fc_av_clr
  fc_av_bin
  fc_av_lit fc_op_kgen
  fc_av_lit fc_fl_sk
  fc_av_scr_sub fc_s_skf
  fc_av_lit fc_fl_evk
  fc_av_scr_sub fc_s_evkf
  fc_av_lit fc_fl_seed
  fc_av_lit fc_v_2026
  if ne fc_spawn_quiet false 0
    ret FC_ERR_BLIND_RUN
  end

  fc_set_tmp_scr fc_s_skf
  rc = fc_load_sk 7
  if ne rc FC_OK
    ret rc
  end
  fc_set_tmp_scr fc_s_evkf
  rc = fc_load_evk 7
  if ne rc FC_OK
    ret rc
  end
  if not fc_check_sk_evk_distinct
    ret FC_ERR_KEY_LEAK
  end

  note Negative check: blind evaluator MUST refuse sk passed as --evk (exit 77)
  fc_load_case_poly 0
  if not fc_blind_encrypt 0 fc_v_111 fc_s_ctx
    ret FC_ERR_BLIND_RUN
  end
  if not fc_blind_encrypt 1 fc_v_222 fc_s_cty
    ret FC_ERR_BLIND_RUN
  end
  fc_av_clr
  fc_av_bin
  fc_av_lit fc_op_epoly
  fc_av_lit fc_fl_evk
  fc_av_scr_sub fc_s_skf
  fc_av_lit fc_fl_x
  fc_av_scr_sub fc_s_ctx_full
  fc_av_lit fc_fl_y
  fc_av_scr_sub fc_s_cty_full
  fc_av_lit fc_fl_a
  fc_av_lit fc_v_1
  fc_av_lit fc_fl_out
  fc_av_scr_sub fc_s_ctobad_full
  if ne fc_spawn_quiet false 77
    ret FC_ERR_KEY_LEAK
  end

  put fc_meta 9 0
  rc = fc_audit_quad_case 0 7 13 250 19
  if ne rc FC_OK
    ret rc
  end
  rc = fc_audit_quad_case 1 123 256 2 255
  if ne rc FC_OK
    ret rc
  end
  rc = fc_audit_quad_case 2 99 44 188 73
  if ne rc FC_OK
    ret rc
  end
  rc = fc_audit_quad_case 3 256 256 256 256
  if ne rc FC_OK
    ret rc
  end
  rc = fc_audit_quad_case 0 0 0 0 42
  if ne rc FC_OK
    ret rc
  end
  rc = fc_audit_add_sub_cmul
  if ne rc FC_OK
    ret rc
  end

  fc_wrt fc_m_aud1
  fc_u64 get fc_meta 9
  fc_wrt fc_m_aud2
  ret FC_OK
end

note ==== Section 7: Selftest, Verify-CT, Verify-OP & CLI ====

fn fc_run_selftest to int
  note Check independent 128-bit mod and decode on exact boundaries
  if ne fc_q_mul sub FC_Q 1 sub FC_Q 1 1
    ret FC_ERR_FORMAT
  end
  if ne fc_q_mul 280379743332608 257 sub FC_Q 1
    ret FC_ERR_FORMAT
  end
  if ne fc_decode_q_coeff sub FC_Q FC_MAX_NOISE 0
    ret FC_ERR_NOISE_BUDGET
  end
  v_edge = sub mul ulong 256 ulong 280379743332608 FC_MAX_NOISE
  if ne fc_decode_q_coeff v_edge 256
    ret FC_ERR_NOISE_BUDGET
  end
  note Check negative schoolbook wraparound: (1 + 2X^63) * (3 + 4X^63) = 3 + 10X^63 - 8X^62 = 3 + 249X^62 + 10X^63 mod 257
  for i ulong FC_N
    put fc_px i 0
    put fc_py i 0
  end
  put fc_px 0 1
  put fc_px 63 2
  put fc_py 0 3
  put fc_py 63 4
  fc_t_mul 0 1 1
  if or ne get fc_t1 0 3 or ne get fc_t1 62 249 ne get fc_t1 63 10
    ret FC_ERR_MISMATCH
  end
  fc_wrt fc_m_self
  ret FC_OK
end

fn fc_cmd_verify_ct to int
  if eq get fc_flags 0 0
    ret FC_ERR_IO
  end
  if eq get fc_flags 1 0
    ret FC_ERR_IO
  end
  if eq get fc_flags 2 0
    ret FC_ERR_IO
  end
  rc = fc_load_sk 0
  if ne rc FC_OK
    ret rc
  end
  rc = fc_load_evk 1
  if ne rc FC_OK
    ret rc
  end
  if not fc_check_sk_evk_distinct
    ret FC_ERR_KEY_LEAK
  end
  if ne get fc_have_ctx 0 0
    rc = fc_load_ct 3 1
    if ne rc FC_OK
      ret rc
    end
    fc_decrypt_sb 1
    for i ulong FC_N
      if ne get fc_got i get fc_px i
        ret FC_ERR_MISMATCH
      end
    end
  end
  if ne get fc_have_cty 0 0
    rc = fc_load_ct 4 2
    if ne rc FC_OK
      ret rc
    end
    fc_decrypt_sb 2
    for i ulong FC_N
      if ne get fc_got i get fc_py i
        ret FC_ERR_MISMATCH
      end
    end
  end
  rc = fc_load_ct 2 0
  if ne rc FC_OK
    ret rc
  end
  fc_t_eval_quad get fc_meta 1 get fc_meta 2 get fc_meta 3 get fc_meta 4
  fc_decrypt_sb 0
  if not fc_got_eq_want
    ret FC_ERR_MISMATCH
  end
  fc_wrt fc_m_vct
  fc_u64 get fc_meta 7
  fc_wrt fc_m_bd
  fc_u64 sub FC_MAX_NOISE get fc_meta 7
  fc_wrt fc_nl
  ret FC_OK
end

fn fc_cmd_verify_op to int
  if eq get fc_flags 0 0
    ret FC_ERR_IO
  end
  if eq get fc_flags 2 0
    ret FC_ERR_IO
  end
  if eq get fc_meta 5 0
    ret FC_ERR_IO
  end
  rc = fc_load_sk 0
  if ne rc FC_OK
    ret rc
  end
  rc = fc_load_ct 2 0
  if ne rc FC_OK
    ret rc
  end
  op = get fc_meta 5
  if eq op 1
    for i ulong FC_N
      put fc_want i rem add get fc_px i get fc_py i FC_T
    end
  else
    if eq op 2
      for i ulong FC_N
        put fc_want i rem add get fc_px i sub FC_T get fc_py i FC_T
      end
    else
      if eq op 3
        for i ulong FC_N
          put fc_want i rem mul get fc_meta 3 get fc_px i FC_T
        end
      else
        fc_t_mul 0 1 3
      end
    end
  end
  fc_decrypt_sb 0
  if not fc_got_eq_want
    ret FC_ERR_MISMATCH
  end
  fc_wrt fc_m_vop
  fc_u64 get fc_meta 7
  fc_wrt fc_m_bd
  fc_u64 sub FC_MAX_NOISE get fc_meta 7
  fc_wrt fc_nl
  ret FC_OK
end

fn fc_parse_op idx ulong to bool
  if fc_arg_eq idx fc_op_add
    put fc_meta 5 1
    ret true
  end
  if fc_arg_eq idx fc_op_sub
    put fc_meta 5 2
    ret true
  end
  if fc_arg_eq idx fc_op_cmul
    put fc_meta 5 3
    ret true
  end
  if fc_arg_eq idx fc_op_mul
    put fc_meta 5 4
    ret true
  end
  ret false
end

fn fc_handle_flag i ulong to int
  if fc_arg_eq i fc_f_sk
    if not fc_copy_arg_path add i 1 0
      ret FC_ERR_IO
    end
    put fc_flags 0 1
    ret FC_OK
  end
  if fc_arg_eq i fc_f_evk
    if not fc_copy_arg_path add i 1 1
      ret FC_ERR_IO
    end
    put fc_flags 1 1
    ret FC_OK
  end
  if fc_arg_eq i fc_f_in
    if not fc_copy_arg_path add i 1 2
      ret FC_ERR_IO
    end
    put fc_flags 2 1
    ret FC_OK
  end
  if fc_arg_eq i fc_f_ctx
    if not fc_copy_arg_path add i 1 3
      ret FC_ERR_IO
    end
    put fc_have_ctx 0 1
    ret FC_OK
  end
  if fc_arg_eq i fc_f_cty
    if not fc_copy_arg_path add i 1 4
      ret FC_ERR_IO
    end
    put fc_have_cty 0 1
    ret FC_OK
  end
  if fc_arg_eq i fc_f_x
    ret fc_parse_poly_arg add i 1 0
  end
  if fc_arg_eq i fc_f_y
    ret fc_parse_poly_arg add i 1 1
  end
  if fc_arg_eq i fc_f_op
    if not fc_parse_op add i 1
      ret FC_ERR_IO
    end
    ret FC_OK
  end
  if not fc_parse_u64 add i 1
    ret FC_ERR_IO
  end
  uv = get fc_meta 6
  if ge uv FC_T
    ret FC_ERR_PLAINTEXT
  end
  if fc_arg_eq i fc_f_a
    put fc_meta 1 uv
    ret FC_OK
  end
  if fc_arg_eq i fc_f_b
    put fc_meta 2 uv
    ret FC_OK
  end
  if fc_arg_eq i fc_f_c
    put fc_meta 3 uv
    ret FC_OK
  end
  if fc_arg_eq i fc_f_d
    put fc_meta 4 uv
    ret FC_OK
  end
  ret FC_ERR_IO
end

fn fc_parse_cli to int
  ac = ulong argcnt
  if lt ac 2
    ret FC_ERR_IO
  end
  if or fc_arg_eq 1 fc_c_help fc_arg_eq 1 fc_c_h
    fc_wrt fc_m_use
    exit 0
  end
  for i ulong 12
    put fc_flags i 0
    put fc_meta i 0
  end
  for i ulong FC_N
    put fc_px i 0
    put fc_py i 0
  end
  put fc_have_ctx 0 0
  put fc_have_cty 0 0

  if fc_arg_eq 1 fc_c_self
    put fc_meta 0 1
    ret FC_OK
  end
  if fc_arg_eq 1 fc_c_audit
    if ne ac 4
      ret FC_ERR_IO
    end
    if or not fc_copy_arg_path 2 5 not fc_copy_arg_path 3 6
      ret FC_ERR_IO
    end
    put fc_meta 0 4
    ret FC_OK
  end
  if fc_arg_eq 1 fc_c_vct
    put fc_meta 0 2
  else
    if fc_arg_eq 1 fc_c_vop
      put fc_meta 0 3
    else
      ret FC_ERR_IO
    end
  end
  i = ulong 2
  while lt i ac bound 32
    if ge add i 1 ac
      ret FC_ERR_IO
    end
    rc = fc_handle_flag i
    if ne rc FC_OK
      ret rc
    end
    i = add i 2
  end
  ret FC_OK
end

fn main to int
  prc = fc_parse_cli
  if ne prc FC_OK
    if eq prc FC_ERR_IO
      fc_werr fc_m_use
    end
    ret fc_print_fail prc
  end
  cmd = get fc_meta 0
  rc = FC_OK
  if eq cmd 1
    rc = fc_run_selftest
  else
    if eq cmd 2
      rc = fc_cmd_verify_ct
    else
      if eq cmd 3
        rc = fc_cmd_verify_op
      else
        rc = fc_run_audit_blind
      end
    end
  end
  if ne rc FC_OK
    ret fc_print_fail rc
  end
  ret FC_OK
end

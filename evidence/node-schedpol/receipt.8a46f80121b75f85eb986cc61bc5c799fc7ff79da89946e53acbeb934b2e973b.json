    "source": "#!/usr/bin/env python3\n\"\"\"Run a scheduler-policy case list against a clean omega-mv checkout and\nwrite a content-addressed receipt (evidence/<dir>/receipt.<sha256>.json).\n\nUsage: receipt.py CASES.json REPO OUTDIR_REL [--write]\nRun it under the queen pool lock, e.g.\n  flock -o ~/handoffs/hive/queen/pool-8-9.lock taskset -c 8-9 nice -n 10 receipt.py ...\n\nA case: {\"case\", \"issue\", \"fragments\": [paths] | \"gate\": path, \"om2\": bool,\n \"mutate\": [path, old, new] (optional; old must occur exactly once),\n \"args\": [..], \"expect\": int, \"timeout\": s, \"clean\": [rel dirs removed first],\n \"stdout_has\": [substrings every run must print] (optional),\n \"repeat\": N runs, each must pass (optional, default 1)}.\nThe receipt embeds this script's source and the case list for replay.\nMutants are applied to a disposable copy of the fragment; the checkout is\nnever modified. Verification tooling only: the implementation is the .om.\n\"\"\"\nimport hashlib, json, os, platform, shutil, subprocess, sys, tempfile, time, datetime\n\ndef sh(cmd, cwd, **kw):\n    return subprocess.run(cmd, cwd=cwd, capture_output=True, **kw)\n\ndef sha(path):\n    h = hashlib.sha256()\n    with open(path, 'rb') as f:\n        h.update(f.read())\n    return h.hexdigest()\n\ndef main():\n    cases_path, repo, outrel = sys.argv[1], os.path.abspath(sys.argv[2]), sys.argv[3]\n    write = '--write' in sys.argv\n    spec = json.load(open(cases_path))\n    dirty = sh(['git', 'status', '--porcelain', '--untracked-files=normal'], repo).stdout.decode()\n    dirty = [l for l in dirty.splitlines() if not l[3:].startswith('build/')]\n    if dirty:\n        print('REFUSED: dirty tree\\n' + '\\n'.join(dirty), file=sys.stderr)\n        sys.exit(3)\n    head = sh(['git', 'rev-parse', 'HEAD'], repo).stdout.decode().strip()\n    tree = sh(['git', 'rev-parse', 'HEAD^{tree}'], repo).stdout.decode().strip()\n    omc = os.path.join(repo, 'seed/out/omc')\n    work = tempfile.mkdtemp(prefix='schedrcpt-')\n    files = set()\n    results = []\n    for c in spec['cases']:\n        frags = c.get('fragments') or [c['gate']]\n        src = b'om2\\n' if c.get('om2') else b''\n        mut = c.get('mutate')\n        if mut and mut[0] not in frags:\n            print(f'REFUSED: mutant {c[\"case\"]}: {mut[0]} is not one of its fragments', file=sys.stderr)\n            sys.exit(4)\n        for fr in frags:\n            files.add(fr)\n            data = open(os.path.join(repo, fr), 'rb').read()\n            if mut and mut[0] == fr:\n                old, new = mut[1].encode(), mut[2].encode()\n                n = data.count(old)\n                if n != 1:\n                    print(f'REFUSED: mutant {c[\"case\"]}: pattern occurs {n} times', file=sys.stderr)\n                    sys.exit(4)\n                data = data.replace(old, new)\n            src += data\n        if c.get('gate') and not mut and c.get('compose'):\n            composed = b''.join(open(os.path.join(repo, f), 'rb').read() for f in c['compose'])\n            if composed != src:\n                print(f'REFUSED: {c[\"gate\"]} is not the concatenation', file=sys.stderr)\n                sys.exit(5)\n        binp = os.path.join(work, c['case'])\n        p = subprocess.run([omc], input=src, capture_output=True)\n        with open(binp, 'wb') as f:\n            f.write(p.stdout)\n        os.chmod(binp, 0o755)\n        r = {'case': c['case'], 'issue': c.get('issue'), 'compile_exit': p.returncode,\n             'expected_exit': c['expect'], 'source_sha256': hashlib.sha256(src).hexdigest()}\n        if mut:\n            r['mutation'] = {'file': mut[0], 'from': mut[1], 'to': mut[2]}\n        if p.returncode != 0:\n            r.update(run_exit=None, verdict='FAIL', stderr=p.stderr.decode(errors='replace'))\n            results.append(r)\n            continue\n        runs, code, out, err = [], None, b'', b''\n        t0 = time.monotonic()\n        for n in range(c.get('repeat', 1)):\n            for d in c.get('clean', []):\n                shutil.rmtree(os.path.join(repo, d), ignore_errors=True)\n            try:\n                q = subprocess.run([binp] + c.get('args', []), cwd=repo, capture_output=True,\n                                   timeout=c.get('timeout', 120))\n                code, out, err = q.returncode, q.stdout, q.stderr\n            except subprocess.TimeoutExpired as e:\n                code, out, err = 'timeout', e.stdout or b'', e.stderr or b''\n            text = out.decode(errors='replace')\n            miss = [s for s in c.get('stdout_has', []) if s not in text]\n            runs.append({'exit': code, 'missing_stdout': miss})\n        ok = all(x['exit'] == c['expect'] and not x['missing_stdout'] for x in runs)\n        r.update(run_exit=code, wall_ms=int((time.monotonic() - t0) * 1000),\n                 stdout=out.decode(errors='replace')[-4000:],\n                 stderr=err.decode(errors='replace')[-2000:],\n                 binary_sha256=sha(binp),\n                 verdict='PASS' if ok else 'FAIL')\n        if c.get('stdout_has'):\n            r['stdout_has'] = c['stdout_has']\n        if len(runs) > 1:\n            hist = {}\n            for x in runs:\n                k = f\"{x['exit']}{'' if not x['missing_stdout'] else ' missing-stdout'}\"\n                hist[k] = hist.get(k, 0) + 1\n            r['repeat'] = {'runs': len(runs), 'outcomes': hist}\n        results.append(r)\n        print(f\"{r['verdict']} {c['case']} expect={c['expect']} got={code}\"\n              + (f\" runs={r['repeat']['outcomes']}\" if len(runs) > 1 else ''), flush=True)\n    shutil.rmtree(work, ignore_errors=True)\n    rec = {\n        'project': 'P-DRA-14', 'issue': spec['issue'], 'source_commit': head, 'source_tree': tree,\n        'platform': ' '.join([platform.system(), platform.release(), platform.machine(), platform.node()]),\n        'cpu_affinity': sorted(os.sched_getaffinity(0)),\n        'execution': 'NATIVE Linux AArch64 host CPU (DGX Spark host, no GPU opened)',\n        'timestamp_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        'compiler': {'path': 'seed/out/omc', 'sha256': sha(omc)},\n        'hashes': {f: sha(os.path.join(repo, f)) for f in sorted(files)},\n        'script': {'path': '~/handoffs/hive/sched/bin/receipt.py', 'sha256': sha(__file__),\n                   'source': open(__file__).read(),\n                   'cases_sha256': sha(cases_path), 'cases': spec},\n        'statuses': spec.get('statuses', {}),\n        'checks': results,\n        'summary': {'pass': sum(r['verdict'] == 'PASS' for r in results),\n                    'fail': sum(r['verdict'] != 'PASS' for r in results)},\n    }\n    body = (json.dumps(rec, indent=2, sort_keys=True) + '\\n').encode()\n    digest = hashlib.sha256(body).hexdigest()\n    print(f\"summary pass={rec['summary']['pass']} fail={rec['summary']['fail']} receipt_sha256={digest}\")\n    if write:\n        d = os.path.join(repo, outrel)\n        os.makedirs(d, exist_ok=True)\n        path = os.path.join(d, f'receipt.{digest}.json')\n        with open(path, 'wb') as f:\n            f.write(body)\n        print(path)\n    else:\n        with open(os.path.join(tempfile.gettempdir(), f'sched-receipt-{digest}.json'), 'wb') as f:\n            f.write(body)\n    sys.exit(0 if rec['summary']['fail'] == 0 else 1)\n\nmain()\n"
  },

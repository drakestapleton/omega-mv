note SPDX-License-Identifier: Apache-2.0
note Scalar omc baseline for NG-A64-VEC Cortex-X925 benchmark (f32, N=4096, 10000 sweeps/trial, 5 trials).
om2

global ba f32 4096
global bb f32 4096
global by f32 4096
global ob uchar 256
global on ulong 1

fn oput b ulong to void
n = get on 0
if lt n len ob
put ob n uchar b
put on 0 add n 1
end
end

fn odec v ulong to void
d = ulong 1
while ge div v d 10 bound 20
d = mul d 10
end
x = v
while gt d 0 bound 20
oput add 48 div x d
x = rem x d
d = div d 10
end
end

fn oflush to void
n = get on 0
k = write 1 ob 0 n
put on 0 0
end

fn init to void
i = ulong 0
while lt i 4096 bound 4096
put ba i bitcast f32 uint 0x3f000000
m1 = and mul i 131 0xfffff
put bb i bitcast f32 uint add 0x3f800000 uint m1
m2 = and mul i 73 0xfffff
put by i bitcast f32 uint add 0x40000000 uint m2
i = add i 1
end
end

fn sweep reps ulong to void
r = ulong 0
while lt r reps bound 20000
i = ulong 0
while lt i 4096 bound 4096
put by i fma get by i get ba i get bb i
i = add i 1
end
r = add r 1
end
end

fn cksum to ulong
h = ulong 0
i = ulong 0
while lt i 4096 bound 4096
u = ulong bitcast uint get by i
h = xor or shl h 7 shr h 57 u
i = add i 1
end
ret h
end

fn main to int
init
sweep 200
t = ulong 0
while lt t 5 bound 8
t0 = monons
sweep 10000
t1 = monons
odec ulong sub t1 t0
oput 10
oflush
t = add t 1
end
odec cksum
oput 10
oflush
ret 0
end

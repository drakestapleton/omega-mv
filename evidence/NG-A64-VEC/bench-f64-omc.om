note SPDX-License-Identifier: Apache-2.0
note Scalar omc baseline for NG-A64-VEC Cortex-X925 benchmark (f64, N=2048, 20000 sweeps/trial, 5 trials).
om2

global ba f64 2048
global bb f64 2048
global by f64 2048
global ob uchar 256
global on ulong 1

fn oput b ulong to void
n = get on 0
if lt n len ob
put ob n uchar b
put on 0 add n 1
end
end

fn odec v ulong to void
d = ulong 1
while ge div v d 10 bound 20
d = mul d 10
end
x = v
while gt d 0 bound 20
oput add 48 div x d
x = rem x d
d = div d 10
end
end

fn oflush to void
n = get on 0
k = write 1 ob 0 n
put on 0 0
end

fn init to void
i = ulong 0
while lt i 2048 bound 2048
put ba i bitcast f64 ulong 0x3fe0000000000000
m1 = and mul i 131071 0xfffffffffffff
put bb i bitcast f64 add 0x3ff0000000000000 m1
m2 = and mul i 65537 0xfffffffffffff
put by i bitcast f64 add 0x4000000000000000 m2
i = add i 1
end
end

fn sweep reps ulong to void
r = ulong 0
while lt r reps bound 30000
i = ulong 0
while lt i 2048 bound 2048
put by i fma get by i get ba i get bb i
i = add i 1
end
r = add r 1
end
end

fn cksum to ulong
h = ulong 0
i = ulong 0
while lt i 2048 bound 2048
u = bitcast ulong get by i
h = xor or shl h 7 shr h 57 u
i = add i 1
end
ret h
end

fn main to int
init
sweep 200
t = ulong 0
while lt t 5 bound 8
t0 = monons
sweep 20000
t1 = monons
odec ulong sub t1 t0
oput 10
oflush
t = add t 1
end
odec cksum
oput 10
oflush
ret 0
end

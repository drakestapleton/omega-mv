note MUTANT cap-255: cap off by one, 256 bytes refused
note LEARN653 bounded native executor. Compose after core.om; fills LWant/LGot for lobserve.
note Each launch: fresh child, empty stdin, stdout pipe, execpure strict profile (no fallback).
note The supervisor here adds the wall deadline and the 256-byte output cap execpure leaves to it.
note RObs: 0 status (lobserve 0 completed,4 timeout,5 resource,6 operational), 1 exit code,
note 2 bytes captured, 3 elapsed ns. Identity measurement and compilation are not done here.
note Launch failure inside the child (dup or execpure refused, e.g. not an executable) writes
note a fresh 16-byte random nonce to the stdout pipe and exits 122. Only this launch's
note supervisor knows the nonce, so a candidate cannot forge status 6.
global RPkt uchar 4096
global RSt uchar 128
global RFd uchar 16
global RWs uchar 4
global RBuf uchar 257
global RObs ulong 4
global RNon uchar 16

fn rfd at ulong to int
x = ulong 0
for i ulong 4
x = or x shl ulong get RFd add at i mul i 8
end
ret int x
end

note Packed one-record argument list from argv[idx]; 0 when the argument is unusable.
fn rpath idx ulong to ulong
if ge idx ulong argcnt
ret 0
end
n = argread idx RPkt 4 4000
if le n 0
ret 0
end
put RPkt 0 1
put RPkt 1 0
put RPkt 2 uchar and ulong n 255
put RPkt 3 uchar shr ulong n 8
ret ulong n
end

fn rfail status ulong to ulong
put RObs 0 status
put RObs 1 0
put RObs 2 0
ret status
end

note Child side: never returns.
fn rchild inrd int outwr int n ulong to void
if ne dupfd inrd 0 0 0
w = write outwr RNon 0 16
exit 122
end
if ne dupfd outwr 1 0 1
w = write outwr RNon 0 16
exit 122
end
r = execpure RPkt 0 add 4 n
w = write 1 RNon 0 16
exit 122
end

fn rlfail to bool
if or ne get RObs 1 122 ne get RObs 2 16
ret false
end
for i ulong 16
if ne get RBuf i get RNon i
ret false
end
end
ret true
end

note RV: 0 pid, 1 stdout read end, 2 start ns, 3 bytes captured, 4 eof, 5 reaped.
global RV ulong 8

fn rused to ulong
ret sub ulong monons get RV 2
end

note Kill (only while unreaped), reap and close; record elapsed and the given status.
fn rstop status ulong to ulong
if ne get RV 5 1
r = killpid int get RV 0 9
w = waitpid int get RV 0 RWs 0 4 0
if gt w 0
put RV 5 1
end
end
r = fclose int get RV 1
put RObs 3 rused
ret rfail status
end

note Fresh child with empty stdin and a stdout pipe; 0 when started, else status 6.
fn rstart idx ulong to ulong
n = rpath idx
if eq n 0
ret 6
end
if lt stat RPkt 4 n RSt 0 len RSt 0
ret 6
end
if ne random RNon 0 16 0 16
ret 6
end
if ne pipefds RFd 0 8 0 0
ret 6
end
if ne pipefds RFd 8 8 0 0
r = fclose rfd 0
r = fclose rfd 4
ret 6
end
put RV 2 ulong monons
pid = fork
if eq pid 0
rchild rfd 0 rfd 12 n
end
r = fclose rfd 0
r = fclose rfd 4
r = fclose rfd 12
put RV 1 ulong rfd 8
if lt pid 0
r = fclose rfd 8
ret 6
end
put RV 0 ulong pid
put RV 3 0
put RV 4 0
put RV 5 0
ret 0
end

note Drain at most 257 bytes; 255 means keep going, else the final status.
fn rdrain to ulong
ready = waitio int get RV 1 1 1000000
if lt ready 0
ret rstop 6
end
if eq ready 0
ret 255
end
got = get RV 3
k = read int get RV 1 RBuf got sub 257 got
if lt k 0
ret rstop 6
end
if eq k 0
put RV 4 1
ret 255
end
put RV 3 add got ulong k
if ge get RV 3 256
ret rstop 5
end
ret 255
end

note Exit status after reaping: a signal is resource (5); the launch nonce is operational (6);
note else completed with its exit code.
fn rdone to ulong
r = fclose int get RV 1
put RObs 3 rused
put RObs 2 get RV 3
sig = and ulong get RWs 0 127
if ne sig 0
put RObs 1 sig
put RObs 0 5
ret 5
end
put RObs 0 0
put RObs 1 ulong get RWs 1
if rlfail
t = get RObs 3
s = rfail 6
put RObs 3 t
ret 6
end
ret 0
end

note Launch argv[idx] with a wall deadline in ns; captured bytes land in RBuf.
fn rlaunch idx ulong limit ulong to ulong
put RObs 3 0
s = rstart idx
if ne s 0
ret rfail s
end
while true
if gt rused limit
ret rstop 4
end
if eq get RV 4 0
s = rdrain
if ne s 255
ret s
end
end
if eq get RV 5 0
w = waitpid int get RV 0 RWs 0 4 1
if lt w 0
ret rstop 6
end
if gt w 0
put RV 5 1
end
end
if and eq get RV 4 1 eq get RV 5 1
ret rdone
end
if eq get RV 4 1
r = sleepns 1000000
end
end
ret rfail 6
end

note Copy the captured bytes to the expected (side 0) or observed (side 1) buffer.
fn rkeep side ulong to void
for i ulong 256
v = uchar 0
if lt i get RObs 2
v = get RBuf i
end
if eq side 0
put LWant i v
else
put LGot i v
end
end
end

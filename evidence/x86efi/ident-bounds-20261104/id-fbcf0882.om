target x86efi
note efi 14 identity: the CPUID brand string, SystemTable FirmwareVendor (UCS-2 to ASCII, ? outside
note 32..126), SMBIOS type 1 Manufacturer/Product/Version (never Serial or UUID), then one hex line
note per refusal or edge result. FirmwareRevision goes after the ==B block (it depends on the OVMF build).
global ms uchar 256
global ml ulong 1
global cb uchar 16
global br uchar 48
global vb uchar 256
global sb uchar 8192
global pb uchar 8

fn pc c ulong to void
put ms get ml 0 uchar c
put ml 0 add get ml 0 1
end

fn nl to void
pc 10
r = efi 13 0 ms 0 get ml 0
put ml 0 0
end

fn ps c ulong to void
if and ge c 32 le c 126
pc c
else
pc 63
end
end

fn hx v ulong n ulong to void
i = ulong 0
while lt i n
d = and shr v mul sub sub n 1 i 4 15
if lt d 10
pc add 48 d
else
pc add 87 d
end
i = add i 1
end
end

fn rd4 k ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get cb add k i mul i 8
end
ret v
end

note CPUID leaf l into cb; returns efi 14's result
fn cpu l ulong to ulong
ret efi 14 shl l 16 cb 0 16
end

fn brand to void
r = cpu 2147483648
if or ne r 16 lt rd4 0 2147483652
pc 45
ret
end
for j ulong 3
r = cpu add 2147483650 j
for k ulong 16
put br add mul j 16 k get cb k
end
end
s = ulong 0
while and lt s 48 or eq ulong get br s 32 eq ulong get br s 0
s = add s 1
end
e = ulong 48
while and gt e s or eq ulong get br sub e 1 32 eq ulong get br sub e 1 0
e = sub e 1
end
if eq e s
pc 45
end
i = s
while lt i e
ps ulong get br i
i = add i 1
end
end

fn vendor to void
r = efi 14 1 vb 0 256
if or ge r 9223372036854775808 eq r 0
pc 45
ret
end
for k ulong div r 2
ps or ulong get vb mul k 2 shl ulong get vb add mul k 2 1 8
end
end

note SMBIOS string number n of the structure at p (formatted length at p+1), or - when absent
fn sstr p ulong n ulong t ulong to void
if eq n 0
pc 45
ret
end
q = add p ulong get sb add p 1
c = ulong 1
while and lt q t lt c n
if eq ulong get sb q 0
c = add c 1
end
q = add q 1
end
if or ge q t eq ulong get sb q 0
pc 45
ret
end
while and lt q t ne ulong get sb q 0
ps ulong get sb q
q = add q 1
end
end

note true when sb[q] and sb[q+1] are both 0 (the end of a structure's string set)
fn dnul q ulong to bool
ret and eq ulong get sb q 0 eq ulong get sb add q 1 0
end

fn smbios to void
t = efi 14 3 sb 0 8192
if or ge t 9223372036854775808 lt t 4
pc 45
ret
end
p = ulong 0
while lt add p 4 t
ty = ulong get sb p
ln = ulong get sb add p 1
if eq ty 1
if lt ln 8
pc 45
ret
end
sstr p ulong get sb add p 4 t
pc 47
sstr p ulong get sb add p 5 t
pc 47
sstr p ulong get sb add p 6 t
ret
end
if or eq ty 127 lt ln 4
pc 45
ret
end
q = add p ln
while and lt add q 1 t not dnul q
q = add q 1
end
p = add q 2
end
pc 45
end

fn line v ulong to void
hx v 16
nl
end

fn main to ulong
pc 61
pc 61
pc 66
nl
pc 98
pc 114
pc 61
brand
nl
pc 102
pc 119
pc 61
vendor
nl
pc 115
pc 109
pc 61
smbios
nl
note sub 3 at position 4: 8 bytes equal to the table's bytes 4..11
r = efi 14 or ulong 3 shl ulong 4 16 pb 0 8
ok = eq r 8
for k ulong 8
if ne get pb k get sb add k 4
ok = false
end
end
if ok
pc 112
pc 111
pc 115
pc 32
pc 111
pc 107
else
pc 63
end
nl
line efi 14 3 pb 0 0
line efi 14 or ulong 3 shl ulong 1048575 16 pb 0 8
line efi 14 0 cb 0 16
line efi 14 0 cb 0 15
line efi 14 shl ulong 1 48 cb 0 16
line efi 14 4 cb 0 16
line efi 14 65537 cb 0 16
line efi 14 256 cb 0 16
pc 61
pc 61
pc 69
nl
pc 61
pc 61
pc 82
pc 32
hx efi 14 2 cb 0 0 8
nl
ret 0
end

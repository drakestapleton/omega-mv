note pciid.om: first contact with the machine's NVIDIA devices from Omega with no operating system and
note no NVIDIA software: through the firmware's PCI I/O protocol (UEFI 2.10 14.4) read each device's
note configuration header; for a display-class NVIDIA device whose memory decoding is on, read the two
note identity registers of BAR 0 (offsets 0 and 0xA00). Read only. The lines go to the console and to
note \OLLM\GPUID.TXT. Needs efirt.om before it (efbs, efguid, efhg, efh, the efi word).
global gpb uchar 64
global gpo uchar 4096
global gpn ulong 1
text gptx "pciio handles nv seg.bus.dev.fn  id  cmd  class  bar0  boot0  boot42  memory decoding off, registers not readno PCI I/O protocol, status "
text gpfile "\\OLLM\\GPUID.TXT"

fn gpc b ulong to void
n = get gpn 0
if lt n 4000
put gpo n uchar b
put gpn 0 add n 1
end
end

note gps: n bytes of gptx from offset o
fn gps o ulong n ulong to void
i = ulong 0
while lt i n
gpc ulong get gptx add o i
i = add i 1
end
end

note gph: v as w hex digits
fn gph v ulong w ulong to void
i = ulong 0
while lt i w
d = and shr v mul sub sub w 1 i 4 15
if lt d 10
gpc add 48 d
else
gpc add 87 d
end
i = add i 1
end
end

note gploc: "nv seg.bus.dev.fn " and the location of PCI I/O instance pio
fn gploc pio ulong to void
loc = fwadr gpb 32 32
gl = fwld add pio 112 8
s = fwcall gl pio loc add loc 8 add loc 16 add loc 24 0
gps 14 18
gph fwld loc 8 4
gpc 46
gph fwld add loc 8 8 2
gpc 46
gph fwld add loc 16 8 2
gpc 46
gph fwld add loc 24 8 1
end

note gpreg: one 32-bit register of BAR 0 at offset r, or ? when the read fails
fn gpreg pio ulong r ulong to void
mr = fwld add pio 16 8
reg = fwadr gpb 0 8
s = fwcall mr pio 2 0 r 1 reg
if eq s 0
gph fwld reg 4 8
else
gpc 63
end
end

note gpdev: one PCI I/O handle; a line when it is an NVIDIA device
fn gpdev h ulong to void
g = efguid 5522935658814222848 11097520664359398558
o = fwadr efh 56 8
hp = fwld add efbs 152 8
s = fwcall hp h g o 0 0 0
if ne s 0
ret
end
pio = efhg 56
cfg = fwadr gpb 0 32
rd = fwld add pio 48 8
s = fwcall rd pio 2 0 8 cfg 0
if ne s 0
ret
end
id = fwld cfg 4
if ne and id 65535 4318
ret
end
cmd = fwld add cfg 4 2
cls = shr fwld add cfg 8 4 8
bar = fwld add cfg 16 4
gploc pio
gps 32 4
gph id 8
gps 36 5
gph cmd 4
gps 41 7
gph cls 6
gps 48 6
gph bar 8
if eq shr cls 16 3
if ne and cmd 2 0
gps 54 7
gpreg pio 0
gps 61 8
gpreg pio 2560
else
gps 69 40
end
end
gpc 10
end

fn gpci to void
put gpn 0 0
bs = efbs
g = efguid 5522935658814222848 11097520664359398558
c = fwadr efh 32 8
o = fwadr efh 24 8
lb = fwld add bs 312 8
s = fwcall lb 2 g 0 c o 0
if ne s 0
gps 109 28
gph s 16
gpc 10
else
n = efhg 32
buf = efhg 24
gps 0 14
gph n 4
gpc 10
i = ulong 0
while lt i n
gpdev fwld add buf mul i 8 8
i = add i 1
end
x = fwcall fwld add bs 72 8 buf 0 0 0 0 0
end
m = get gpn 0
r = efi 13 0 gpo 0 m
k = len gpfile
for j ulong k
put gpb j get gpfile j
end
r = efi 12 65281 gpb 0 k
r = efi 12 65283 gpo 0 m
r = efi 12 65284 gpo 0 0
end

fn main to int
r = ocmain
gpci
ret r
end

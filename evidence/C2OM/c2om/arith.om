note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn f0 v1 int to int
t0 = int cb lt v1 int 0
if ne t0 0
t0 = int cp int 45
t0 = int neg v1
v1 = t0
end
v2 = int int 1
t0 = int div v1 v2
t0 = int cb ge t0 int 10
while ne t0 0
t0 = int mul v2 int 10
v2 = t0
t0 = int div v1 v2
t0 = int cb ge t0 int 10
end
t0 = int cb gt v2 int 0
while ne t0 0
t0 = int div v1 v2
t0 = int rem t0 int 10
t0 = int add int 48 t0
t0 = int cp t0
t0 = int div v2 int 10
v2 = t0
t0 = int cb gt v2 int 0
end
t0 = int cp int 32
ret int 0
end

note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn fc0 v1 int to int
t0 = int cb lt v1 int 2
if ne t0 0
ret v1
end
t0 = int sub v1 int 1
t0 = int fc0 t0
v2 = int t0
t0 = int sub v1 int 2
t0 = int fc0 t0
v3 = int t0
t0 = int add v2 v3
ret t0
end
fn main to int
t0 = int cg
v2 = int t0
t0 = int fc0 int 24
v3 = int t0
t0 = int cb ne v3 int 0
while ne t0 0
t0 = int rem v3 int 10
t0 = int add int 48 t0
t0 = int cp t0
t0 = int div v3 int 10
v3 = t0
t0 = int cb ne v3 int 0
end
t0 = int cp int 10
ret v2
end

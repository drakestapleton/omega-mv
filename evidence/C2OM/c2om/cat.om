note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn main to int
v1 = int int 0
t0 = int cg
v2 = int t0
t0 = int neg int 1
t0 = int cb ne v2 t0
while ne t0 0
t0 = int cb eq v2 int 10
if ne t0 0
t0 = int add v1 int 1
v1 = t0
end
t0 = int cp v2
t0 = int cg
v2 = t0
t0 = int neg int 1
t0 = int cb ne v2 t0
end
ret v1
end

note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn f0 v1 int to int
v2 = int int 0
t0 = int cb ne v1 int 1
while ne t0 0
t0 = int rem v1 int 2
t0 = int cb eq t0 int 0
if ne t0 0
t0 = int div v1 int 2
v1 = t0
else
t0 = int mul int 3 v1
t0 = int add t0 int 1
v1 = t0
end
t0 = int add v2 int 1
v2 = t0
t0 = int cb ne v1 int 1
end
ret v2
end
fn f1 to int
v2 = int int 0
v3 = int int 0
t0 = int cg
v4 = int t0
t0 = int cb ge v4 int 48
t1 = int cb le v4 int 57
t0 = int and t0 t1
while ne t0 0
t0 = int mul v2 int 10
t0 = int add t0 v4
t0 = int sub t0 int 48
v2 = t0
v3 = int 1
t0 = int cg
v4 = t0
t0 = int cb ge v4 int 48
t1 = int cb le v4 int 57
t0 = int and t0 t1
end
t0 = int cb eq v3 0
if ne t0 0
ret int 1000
end
ret v2
end
fn f2 v3 int to int
v4 = int int 1
t0 = int div v3 v4
t0 = int cb ge t0 int 10
while ne t0 0
t0 = int mul v4 int 10
v4 = t0
t0 = int div v3 v4
t0 = int cb ge t0 int 10
end
t0 = int cb gt v4 int 0
while ne t0 0
t0 = int div v3 v4
t0 = int rem t0 int 10
t0 = int add int 48 t0
t0 = int cp t0
t0 = int div v4 int 10
v4 = t0
t0 = int cb gt v4 int 0
end
ret int 0
end
fn main to int
t0 = int f1
v4 = int t0
v5 = int int 1
v6 = int int 0
v7 = int int 1
t0 = int cb lt v7 v4
while ne t0 0
t0 = int f0 v7
v8 = int t0
t0 = int cb gt v8 v6
if ne t0 0
v6 = v8
v5 = v7
end
t0 = int add v7 int 1
v7 = t0
t0 = int cb lt v7 v4
end
t0 = int f2 v5
v8 = int t0
t0 = int cp int 32
t0 = int f2 v6
v8 = t0
t0 = int cp int 10
ret int 0
end

note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn fc0 v1 int to int
t0 = int cb ge v1 int 48
t1 = int cb le v1 int 57
t0 = int and t0 t1
ret t0
end
fn fc1 v2 int to int
t0 = int cb ge v2 int 65
t1 = int cb le v2 int 90
t0 = int and t0 t1
t1 = int cb ge v2 int 97
t2 = int cb le v2 int 122
t1 = int and t1 t2
t0 = int or t0 t1
ret t0
end
fn fc2 v3 int to int
t0 = int div v3 int 10
t0 = int rem t0 int 10
v4 = int t0
t0 = int add int 48 v4
t0 = int cp t0
t0 = int rem v3 int 10
t0 = int add int 48 t0
t0 = int cp t0
t0 = int cp int 32
ret int 0
end
fn main to int
v4 = int int 0
v5 = int int 0
v6 = int int 0
v7 = int int 0
t0 = int cg
v8 = int t0
t0 = int neg int 1
t0 = int cb ne v8 t0
while ne t0 0
t0 = int fc0 v8
v9 = int t0
if ne v9 0
t0 = int add v4 int 1
v4 = t0
else
t0 = int fc1 v8
v10 = int t0
if ne v10 0
t0 = int add v5 int 1
v5 = t0
else
t0 = int cb eq v8 int 32
t1 = int cb eq v8 int 10
t0 = int or t0 t1
if ne t0 0
t0 = int add v6 int 1
v6 = t0
else
t0 = int add v7 int 1
v7 = t0
end
end
end
t0 = int cg
v8 = t0
t0 = int neg int 1
t0 = int cb ne v8 t0
end
t0 = int fc2 v4
v9 = int t0
t0 = int fc2 v5
v9 = t0
t0 = int fc2 v6
v9 = t0
t0 = int fc2 v7
v9 = t0
t0 = int cp int 10
ret v7
end

note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn fc0 v1 int to int
t0 = int rem int 0 int 97
t0 = int add v1 t0
ret t0
end

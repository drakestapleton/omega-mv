t0 = int f0 t0
v4 = t0
t0 = int cb ne v2 int 12
t0 = int f0 t0
v4 = t0
t0 = int cb lt v2 v3
t1 = int cb gt v2 v3
t1 = int mul t1 int 2
t0 = int add t0 t1
t0 = int f0 t0
v4 = t0
t0 = int cb eq int 4 int 4
t0 = int and v2 t0
t0 = int f0 t0
v4 = t0
t0 = int and int 3 int 6
t0 = int xor int 2 t0

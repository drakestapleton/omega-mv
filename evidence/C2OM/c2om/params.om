note c2om scalar translation; signed overflow traps; no C undefined behavior preserved.
note cb gives C's int 0 or 1 for a comparison; omc converts no bool to a number.
global cio uchar 1
fn cb c bool to int
if c
ret 1
end
ret 0
end
fn cg to int
n = read 0 cio 0 1
if eq n 1
ret int get cio 0
end
ret -1
end
fn cp x int to int
b = uchar and x 255
put cio 0 b
n = write 1 cio 0 1
if eq n 1
ret int b
end
ret -1
end
fn f0 v1 int v2 int v3 int v4 int v5 int v6 int to int
t0 = int mul v1 int 100000
t1 = int mul v2 int 10000
t0 = int add t0 t1
t1 = int mul v3 int 1000
t0 = int add t0 t1
t1 = int mul v4 int 100
t0 = int add t0 t1
t1 = int mul v5 int 10
t0 = int add t0 t1
t0 = int add t0 v6
ret t0
end
fn f1 v2 int to int
t0 = int cb lt v2 int 0
if ne t0 0
t0 = int neg int 1
ret t0
else
t0 = int cb eq v2 int 0
if ne t0 0
ret int 0
else
ret int 1
end
end
end
fn f2 v3 int to int
v4 = int int 0
t0 = int cb eq v3 int 0
if ne t0 0
ret int 1
end
t0 = int cb ne v3 int 0
while ne t0 0
t0 = int div v3 int 10
v3 = t0
t0 = int add v4 int 1
v4 = t0
t0 = int cb ne v3 int 0
end
ret v4
end
fn main to int
t0 = int f0 int 1 int 2 int 3 int 4 int 5 int 6
v4 = int t0
t0 = int sub v4 int 123456
t0 = int f1 t0
v5 = int t0
t0 = int neg v4
t0 = int f1 t0
v6 = int t0
t0 = int f2 v4
v7 = int t0
t0 = int add int 48 v5
t0 = int cp t0
t0 = int add int 48 v6
t0 = int add t0 int 2
t0 = int cp t0
t0 = int add int 48 v7
t0 = int cp t0
t0 = int cp int 10
t0 = int rem v4 int 256
ret t0
end

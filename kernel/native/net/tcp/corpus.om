d = get Cx 9
tstep cnow
ok = and ok eq sub get Cx 9 d 1
ok = and ok eq co32 38 sadd u 1460
ok = and ok eq co16 16 41
o = cfeed cfr 16 cseq 0 sadd u 1460 0 0
end

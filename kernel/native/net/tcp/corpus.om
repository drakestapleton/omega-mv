note Review 5cd0af98 finding N9: tlinkout checks every frame the stack sends as a real
note peer would. Cfb k counts frames with field k wrong; cfrmend checks each count is 0
note (ids 4900 + k): 0 frame length 60..1514, 1 Ethernet source, 2 ethertype, 3 ARP fields,
note 4 IPv4 version, IHL and TOS, 5 IPv4 total length, 6 flags and fragment offset (DF
note only), 7 TTL 64, 8 protocol 6, 9 IPv4 header checksum, 10 IPv4 addresses (source ours;
note destination the connection's peer, or for a RST the source of the segment answered),
note 11 Ethernet destination (unicast; the peer's MAC for the peer's address before the
note fuzz phase, which may rewrite ARP entries), 12 TCP data offset and reserved bits, 13 TCP
note checksum, 14 TCP ports (the connection's, or for a RST the answered segment's swapped),
note 15 flags (no URG, ECE or CWR) and urgent pointer, 16 options (the MSS option, 4 bytes
note with own MSS, on SYN only), 17 window (receive space; 0 on a RST), 18 data (none on a
note SYN or RST, none without PSH: tcp.om sends data only with PSH). Cfb 19 counts frames
note checked. The checksums are summed here over Cout, not with tcp.om functions.
global Cfb ulong 24
const cPMAC ulong 90525193470466
fn cbad k ulong to void
put Cfb k add get Cfb k 1
end
note One's-complement sum of Cout[p..p+n) onto s, folded to 16 bits.
fn csum16 p ulong n ulong s ulong to ulong
for i ulong div n 2 bound 1024
s = add s co16 add p mul i 2
end
if eq rem n 2 1
s = add s shl ulong get Cout add p sub n 1 8
end
while gt s 65535 bound 8
s = add and s 65535 shr s 16
end
ret s
end
fn cmac48 p ulong to ulong
ret add shl co16 p 32 co32 add p 2
end
fn cmine p ulong to bool
ok = true
for i ulong 6
if ne get Cout add p i get Tmac i
ok = false
end
end
ret ok
end
fn cfrmchk n ulong to void
put Cfb 19 add get Cfb 19 1
if or lt n 60 gt n 1514
cbad 0
ret
end
if not cmine 6
cbad 1
end
y = co16 12
if eq y 2054
cfrmarp
ret
end
if ne y 2048
cbad 2
ret
end
cfrmip n
end
fn cfrmarp to void
ok = true
if or ne co16 14 1 ne co16 16 2048
ok = false
end
if or ne get Cout 18 6 ne get Cout 19 4
ok = false
end
if not cmine 22
ok = false
end
if ne co32 28 get Tcf 1
ok = false
end
op = co16 20
if eq op 1
if or ne cmac48 0 tBCAST ne cmac48 32 0
ok = false
end
else
if or ne op 2 ne cmac48 0 cmac48 32
ok = false
end
end
if not ok
cbad 3
end
end
fn cfrmip n ulong to void
if or ne get Cout 14 69 ne get Cout 15 0
cbad 4
end
t = co16 16
if or lt t 40 gt add 14 t n
cbad 5
ret
end
if and gt n 60 ne n add 14 t
cbad 5
end
if ne co16 20 16384
cbad 6
end
if ne get Cout 22 64
cbad 7
end
if ne get Cout 23 6
cbad 8
ret
end
if ne csum16 14 20 0 65535
cbad 9
end
if ne co32 26 get Tcf 1
cbad 10
end
if eq and get Cout 0 1 1
cbad 11
end
if and eq get Cx 10 0 eq co32 30 cPIP
if ne cmac48 0 cPMAC
cbad 11
end
end
cfrmtcp sub t 20
end
fn cfrmtcp l ulong to void
h = mul ulong shr get Cout 46 4 4
if or lt h 20 gt h l
cbad 12
ret
end
if ne and get Cout 46 15 0
cbad 12
end
cfrmsum l
fl = ulong get Cout 47
if or ne and fl 224 0 ne co16 52 0
cbad 15
end
cfrmopt h fl
if and ne l h or ne and fl 6 0 eq and fl 8 0
cbad 18
end
if ne and fl 4 0
cfrmrst
ret
end
if or ne co16 34 get Tcb kLP ne co16 36 get Tcb kRP
cbad 14
end
if ne co32 30 get Tcb kRIP
cbad 10
end
if ne co16 48 sub 65535 get Tcb kRCN
cbad 17
end
end
note The TCP checksum over the pseudo-header (RFC 9293 3.1) and the l segment bytes.
fn cfrmsum l ulong to void
a = co32 26
b = co32 30
s = add add shr a 16 and a 65535 add shr b 16 and b 65535
if ne csum16 34 l add s add 6 l 65535
cbad 13
end
end
fn cfrmopt h ulong fl ulong to void
ok = eq h 20
if ne and fl 2 0
ok = and eq h 24 eq co32 54 add 33816576 get Tcf 9
end
if not ok
cbad 16
end
end
note A RST answers the segment in Trx (trstout): addresses and ports swapped, window 0.
fn cfrmrst to void
q = get Tpk 6
if or ne co16 34 tr16 add q 2 ne co16 36 tr16 q
cbad 14
end
if ne co32 30 get Tpk 4
cbad 10
end
if ne co16 48 0
cbad 17
end
end
fn cfrmend to void
for k ulong 19
cck eq get Cfb k 0 add 4900 k
end
cck gt get Cfb 19 0 4919
end
note Moves the clock so that the next ISS of the same 4-tuple is near 2^31 + 2^30 (ISS =
note 250 per ms + F): comparisons of a sequence number with 0 then differ from those with
note the ISS, so a field left 0 instead of set from the ISS shows.
fn csteer to void
d = div sdif 3221225472 get Tcb kISS 250
put Cx 6 add get Cx 6 d
end
note Active open from own port lp to the peer's port 80 at the corpus clock.
fn copen lp ulong to void
csetup
put Cx 2 80
put Cx 3 lp
put Tcf 0 cnow
tconnect cPIP 80 lp
end

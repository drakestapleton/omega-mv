note SPDX-License-Identifier: MIT
note Offline Enter must give visible feedback without losing the unsent line or sending a job.
note The real show/input/application modules are used; firmware-only calls are not exercised.
text Trequest "hello"
text Tnet "STAT net=0 e=14 h=2 l=0 c=7 p=88 m=787b8abdd051 s="
text Tnone "STAT net=0 e=14 h=0 l=14 c=1 p=0 m=787b8abdd051 s="
fn tinput to void
put Hminn 0 0
for i ulong len Trequest
hmkey ulong get Trequest i
end
end
fn main to int
constants
put Sh 11 1000
ok = chinit 1000 8765
if not ok
ret 90
end
tinput
put Hm 14 long len Trequest
put Hm 16 get Hm 15
put Es 6 0
put Hmsayn 0 0
ok = shkey 13
if eq get Hmsayn 0 0
ret 11
end
if ne get Hminn 0 len Trequest
ret 12
end
for i ulong len Trequest
if ne get Hmin i get Trequest i
ret 13
end
end
if chbusy
ret 14
end
note The next rendered frame must keep the unsent text visible, not show the empty placeholder.
hmnotes 1000
if ne get Hm 14 long len Trequest
ret 15
end
note The stats line leads with efnetup's network fields (Es 6 12 14 15 and Nmac): two adapters
note refused for their link after seven scans, then a firmware with no SNP handle at all.
put Es 12 14
put Es 14 add 2 shl ulong 7 16
put Es 15 136
put Nmac 0 120
put Nmac 1 123
put Nmac 2 138
put Nmac 3 189
put Nmac 4 208
put Nmac 5 81
stline
if lt get Sttn 0 len Tnet
ret 16
end
for i ulong len Tnet
if ne get Stt i get Tnet i
ret 17
end
end
put Es 14 add shl ulong 14 8 shl ulong 1 16
put Es 15 0
note Diagnostics must remain usable without a network link.
put Hminn 0 0
for i ulong len Stkey
hmkey ulong get Stkey i
end
stline
ok = shkey 13
if ne get Hminn 0 0
ret 21
end
if lt get Hmsayn 0 5
ret 22
end
if ne get Hmsay 0 83
ret 23
end
if lt get Hmsayn 0 len Tnone
ret 24
end
for i ulong len Tnone
if ne get Hmsay i get Tnone i
ret 25
end
end
note Empty Enter does not replace the last answer.
put Hmsayn 0 5
ok = shkey 13
if ne get Hmsayn 0 5
ret 31
end
note Reconnecting must still allow a normal request to enter the courier workflow.
put Es 6 1
tinput
ok = shkey 13
if ne get Hminn 0 0
ret 41
end
if not chbusy
ret 42
end
ret 0
end

note SPDX-License-Identifier: MIT
note Offline Enter must give visible feedback without losing the unsent line or sending a job.
note The real show/input/application modules are used; firmware-only calls are not exercised.
text Trequest "hello"
fn tinput to void
put Hminn 0 0
for i ulong len Trequest
hmkey ulong get Trequest i
end
end
fn main to int
constants
put Sh 11 1000
ok = chinit 1000 8765
if not ok
ret 90
end
tinput
put Es 6 0
put Hmsayn 0 0
ok = shkey 13
if eq get Hmsayn 0 0
ret 11
end
if ne get Hminn 0 len Trequest
ret 12
end
for i ulong len Trequest
if ne get Hmin i get Trequest i
ret 13
end
end
if chbusy
ret 14
end
note Diagnostics must remain usable without a network link.
put Hminn 0 0
for i ulong len Stkey
hmkey ulong get Stkey i
end
stline
ok = shkey 13
if ne get Hminn 0 0
ret 21
end
if lt get Hmsayn 0 5
ret 22
end
if ne get Hmsay 0 83
ret 23
end
note Empty Enter does not replace the last answer.
put Hmsayn 0 5
ok = shkey 13
if ne get Hmsayn 0 5
ret 31
end
note Reconnecting must still allow a normal request to enter the courier workflow.
put Es 6 1
tinput
ok = shkey 13
if ne get Hminn 0 0
ret 41
end
if not chbusy
ret 42
end
ret 0
end

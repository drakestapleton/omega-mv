# tests/gates/aienos-hw-gates.gate
# Hosted: none (local Spark gate, DRA-19). Checks the hardware-gate register docs/hardware-gates.tsv
# with the seeded Omega checker tools/hwgates/hwgates.om: fixtures, three checker mutants, the
# register (every PASS/FAIL row needs a receipt line, every gate keeps an explicit PHYSICAL row) and
# two planted-bad copies. Needs omc sha256 bcfa5828 (AIEN_OMC or ../omega-mv); without it exit 3.
gate: AIENOS-HW-GATES
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - docs/hardware-gates.tsv
  - docs/HARDWARE_GATES.md
  - tools/hwgates/
  - evidence/HWGATES-20261107/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["hw-gates"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine

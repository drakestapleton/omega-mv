# tests/gates/aienos-hw-gates.gate
# Hosted: none (local Spark gate, DRA-19). Checks the hardware-gate register docs/hardware-gates.tsv
# with the seeded Omega checker tools/hwgates/hwgates.om: fixtures, checker mutants, the register
# (every PASS/FAIL row needs a tracked receipt line, every gate keeps an explicit PHYSICAL row, a gate
# a receipt names keeps its rows), withdrawn receipt lines, unchanged receipts, aienux source commits
# through import/commit-map, a no-cap run with a size alarm, and planted-bad copies. Needs omega-mv's
# seed/out/omc (sha256 in its seed/out/omc.sha256; AIEN_OMC or the committed one); without it exit 3.
# Input paths are relative to kernel/; ../seed/out/omc.sha256 is the compiler pin at the omega-mv root,
# listed so a pin move invalidates a cached PASS. cache: never because the unchanged-receipt check
# reads git history, which no input digest covers.
gate: AIENOS-HW-GATES
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - docs/hardware-gates.tsv
  - docs/hardware-gates-needs.tsv
  - docs/HARDWARE_GATES.md
  - tools/hwgates/
  - evidence/
  - import/commit-map
  - tests/gates/
  - ../seed/out/omc.sha256
  - ../tools/evidence_immutable.sh
run:
  exec: tests/gates/run.sh
  args: ["hw-gates"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: machine
cache: never

# tests/gates/aienos-ck-qemu-external.gate
# Not hosted: iMac-kernel QEMU tests that need outside inputs (qemu_ck_allen_courier, qemu_ck_allen_wizard,
# qemu_ck_local_model). Needs ALLEN_MODEL (host:port of a model server answering /health, no default),
# LOCAL_MODEL_WEIGHTS and LOCAL_MODEL_TOKENIZER (pinned stories15M.bin and tokenizer.bin); FAILS when any
# is missing or any script prints anything but its PASS line (NOT_RUN is a FAIL here)
gate: AIENOS-CK-QEMU-EXTERNAL
manifest_version: 2
owner: aienos
requires:
  - qemu
inputs:
  - native/kernel/
  - native/argus/
  - native/net/
  - native/sig/
  - scripts/qemu_ck_allen_courier_test.sh
  - scripts/qemu_ck_allen_wizard_test.sh
  - scripts/qemu_ck_local_model_test.sh
  - scripts/lib_gate_hold.sh
  - crates/allen-courier/
  - tests/gates/
  - Cargo.toml
  - Cargo.lock
  - .cargo/
  - vendor/
run:
  exec: tests/gates/run.sh
  args: ["ck-qemu-external"]
expects:
  exit: 0
  observe: ["inputs_missing == 0", "scripts_fail == 0"]
  verdict: PASS
timeout: 120m
exactness: EXACT
cache_scope: machine

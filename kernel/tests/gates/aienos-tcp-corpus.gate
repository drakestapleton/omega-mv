# tests/gates/aienos-tcp-corpus.gate
# Hosted: none (local Spark gate, L232). The native TCP stack in seeded Omega
# (native/net/tcp/tcp.om) against its hostile corpus (corpus.om): exact-state
# cases plus 2,000,000 seeded mutated frames. No QEMU; the QEMU profiles stay
# in native/net/tcp/gate.sh. Needs omega-mv's seed/out/omc (sha256 in
# its seed/out/omc.sha256; AIEN_OMC or the committed one); without it exit 3.
# Input paths are relative to kernel/; ../seed/out/omc.sha256 is that pin, listed so a pin move
# invalidates a cached PASS.
gate: AIENOS-TCP-CORPUS
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/net/tcp/
  - tests/gates/
  - ../seed/out/omc.sha256
run:
  exec: tests/gates/run.sh
  args: ["tcp-corpus"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

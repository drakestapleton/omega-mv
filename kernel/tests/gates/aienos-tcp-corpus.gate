# tests/gates/aienos-tcp-corpus.gate
# Hosted: none (local Spark gate, L232). The native TCP stack in seeded Omega
# (native/net/tcp/tcp.om) against its hostile corpus (corpus.om): exact-state
# cases plus 2,000,000 seeded mutated frames. No QEMU; the QEMU profiles stay
# in native/net/tcp/gate.sh. Needs the omc named in PIN (AIEN_OMC or
# ../omega-mv); without it exit 3.
gate: AIENOS-TCP-CORPUS
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/net/tcp/
  - tests/gates/
  - PIN
run:
  exec: tests/gates/run.sh
  args: ["tcp-corpus"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine

# tests/gates/aienos-ck-qemu-gates.gate
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'QEMU TCG gates': bash scripts/ck_gates.sh --out DIR, every C-implemented gate except FPU/INFER must print AIENOS_CK_<G>: PASS (hosted job 2340 s total)
# Mirrors hosted: ck-kernel.yml 'QEMU TCG gates': bash scripts/ck_gates.sh --out DIR, every C-implemented gate except FPU/INFER must print AIENOS_CK_<G>: PASS (hosted job 2340 s total)
# Then the self-contained iMac-kernel QEMU tests (allen_memory, imac_bootdisk, imac_swap, imac_kernel, imac_keyboard,
# boot_show, gpu_bench, local_tools, allen_code recorded mode); each counts only when it exits 0 and prints its PASS line.
# Timeout: the whole step measured 4140 s on the Spark (2026-11-05, 10 cores at nice 19); 1.5x that is 6210 s = 103.5 min,
# rounded up to 105m.
gate: AIENOS-CK-QEMU-GATES
manifest_version: 2
owner: aienos
requires:
  - qemu
inputs:
  - native/kernel/
  - native/argus/
  - native/boot/
  - native/net/
  - native/sig/
  - scripts/ck_gates.sh
  - scripts/lib_ck_m1_checks.sh
  - scripts/lib_gate_hold.sh
  - scripts/gate_hold_selftest.sh
  - scripts/ck_owner_keys_check.sh
  - crates/aienos-fpu-probe/
  - crates/aienos-infer-kernel/
  - tests/gates/
  - scripts/
  - native/
  - crates/
  - Cargo.toml
  - Cargo.lock
  - .cargo/
  - vendor/
run:
  exec: tests/gates/run.sh
  args: ["ck-qemu-gates"]
expects:
  exit: 0
  observe: ["required_gates_pass >= 1", "scripts_fail == 0"]
  verdict: PASS
timeout: 105m
exactness: EXACT
cache_scope: machine

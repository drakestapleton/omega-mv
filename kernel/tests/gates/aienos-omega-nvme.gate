# tests/gates/aienos-omega-nvme.gate
# Hosted: none (local Spark gate, DRA-19). native/disk/tests/omega_nvme_test.sh (#472): the bounded
# read-only NVMe protocol in seeded Omega against the C driver oracle: host cases, guard-removal
# mutants and disposable-QEMU cases. Physical NVMe is NOT_RUN. Needs the omc named in
# OMC_PIN (AIEN_OMC or ../omega-mv); without it exit 3. Any other compiler is
# refused by the test itself (exit 2).
gate: AIENOS-OMEGA-NVME
manifest_version: 2
owner: aienos
requires:
  - host
  - qemu
inputs:
  - native/disk/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["omega-nvme"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

# tests/gates/aienos-omega-nvme.gate
# Hosted: none (local Spark gate, DRA-19). native/disk/tests/omega_nvme_test.sh (#472): the bounded
# read-only NVMe protocol in seeded Omega against the C driver oracle, 37 host cases, 7 guard-removal
# mutants, 10 disposable-QEMU cases. Physical NVMe is NOT_RUN. Needs omc sha256 bcfa5828 (AIEN_OMC
# or ../omega-mv); without it exit 3. Any other compiler is refused by the test itself (exit 2).
gate: AIENOS-OMEGA-NVME
manifest_version: 2
owner: aienos
requires:
  - host
  - qemu
inputs:
  - native/disk/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["omega-nvme"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine

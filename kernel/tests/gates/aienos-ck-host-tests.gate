# tests/gates/aienos-ck-host-tests.gate
# Hosted: none (#427 removed the hosted test workflows; the Spark runs this locally). Formerly ck-kernel.yml 'Host unit tests (plain and ASan + UBSan)': make -C native/kernel test sanitize
# Host kernel tests plus iMac swap bounds, service ownership and model-checker regressions, then the
# iMac host scripts below; each counts only when it exits 0 and prints its PASS line.
gate: AIENOS-CK-HOST-TESTS
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/kernel/
  - native/argus/
  - native/boot/
  - scripts/ck_swap_disk_bound_test.sh
  - scripts/ck_imac_lab_services_test.sh
  - scripts/ck_imac_lab_services.sh
  - scripts/check_local_model.sh
  - scripts/ck_fat_boot_test.sh
  - scripts/ck_allen_memory_test.sh
  - scripts/ck_allen_canvas_test.sh
  - scripts/ck_allen_code_test.sh
  - scripts/ck_allen_ui_test.sh
  - scripts/ck_boot_show_test.sh
  - scripts/ck_courier_udp_frame_test.sh
  - scripts/ck_courier_udp_test.sh
  - scripts/ck_imac_bsdp_test.sh
  - scripts/ck_imac_report_test.sh
  - scripts/ck_imac_security_test.sh
  - scripts/ck_setup_wizard_test.sh
  - scripts/ck_sky_test.sh
  - scripts/ck_sky_sharpness_test.sh
  - scripts/ck_virtio_av_test.sh
  - scripts/ck_mind_phases_test.sh
  - crates/allen-courier/
  - native/net/
  - scripts/ck_gates.sh
  - scripts/lib_ck_m1_checks.sh
  - scripts/lib_gate_hold.sh
  - scripts/gate_hold_selftest.sh
  - scripts/ck_owner_keys_check.sh
  - crates/aienos-fpu-probe/
  - crates/aienos-infer-kernel/
  - tests/gates/
  - native/
  - scripts/native_package_test.sh
  - scripts/native_package.sh
  - crates/aienos-infer/
  - Cargo.toml
  - Cargo.lock
  - .cargo/
  - vendor/
run:
  exec: tests/gates/run.sh
  args: ["ck-host-tests"]
expects:
  exit: 0
  observe: ["scripts_fail == 0"]
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine

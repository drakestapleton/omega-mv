#!/bin/sh
# bin/omega: run the Omega toolchain built for this machine's CPU (docs/OMEGA-PACKAGE.md).
# A Linux program file is either x86-64 or AArch64, so the package holds one native build per CPU under
# lib/<cpu>/ (omega, omc, omega-console), all built from seed by tools/omega/build.om. This script only
# picks the directory: everything else, GPU detection included, is the Omega program lib/<cpu>/omega.
# OMEGA_CPU=x86_64|aarch64 forces a CPU (for example to run the x86-64 build through qemu-user binfmt).
set -eu
case $(uname -s) in
  Linux) ;;
  *) echo "omega: the native builds are Linux ELF programs; this system is $(uname -s)" >&2; exit 69 ;;
esac
cpu=${OMEGA_CPU:-$(uname -m)}
case $cpu in
  x86_64|amd64) cpu=x86_64 ;;
  aarch64|arm64) cpu=aarch64 ;;
  *) echo "omega: no native build for CPU '$cpu' (x86_64 and aarch64 exist)" >&2; exit 69 ;;
esac
self=$(readlink -f -- "$0" 2> /dev/null || printf '%s' "$0")
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
lib=$root/lib/$cpu
[ -x "$lib/omega" ] || { echo "omega: $lib/omega is missing; build the package with tools/omega/build.om" >&2; exit 69; }
OMEGA_LIB=$lib
OMEGA_SHARE=$root/share
export OMEGA_LIB OMEGA_SHARE
exec "$lib/omega" "$@"

note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note aien-cpu-c-base: conventional single-thread CPU sieve following the upstream "base" rules,
note implemented in pure seeded OM-2.
note Storage: 1 bit per odd number, bit k <-> number 2k+1, inverted (set = composite).
note Concatenated after bench/prime_race/prime_race_impl.om.

const CPU_MAX_WORDS ulong 1048576

global cpu_comp ulong 1048576
global cpu_exp ulong 1048576
global cpu_limit ulong 1
global cpu_nwords ulong 1
global cpu_ready int 1

fn cpu_isqrt_u64 n ulong to ulong
  r = ulong 0
  lo = ulong 0
  hi = ulong 2097152
  while le lo hi bound 64
    mid = add lo shr sub hi lo 1
    if le mul mid mid n
      r = mid
      lo = add mid 1
    else
      if eq mid 0
        break
      end
      hi = sub mid 1
    end
  end
  ret r
end

fn cpu_is_comp n ulong to ulong
  k = shr sub n 1 1
  w = shr k 6
  b = and k 63
  ret and shr get cpu_comp w b 1
end

fn cpu_mark_comp n ulong to void
  k = shr sub n 1 1
  w = shr k 6
  b = and k 63
  put cpu_comp w or get cpu_comp w shl ulong 1 b
end

fn cpu_setup limit ulong to int
  nw = pr_words64 limit
  if gt nw CPU_MAX_WORDS
    ret -1
  end
  put cpu_limit 0 limit
  put cpu_nwords 0 nw
  put cpu_ready 0 1
  ret 0
end

fn cpu_pass limit ulong to int
  nw = pr_words64 limit
  if gt nw CPU_MAX_WORDS
    ret -1
  end
  put cpu_limit 0 limit
  put cpu_nwords 0 nw
  for w ulong nw bound 9223372036854775807
    put cpu_comp w 0
  end
  q = cpu_isqrt_u64 limit
  factor = ulong 3
  while le factor q bound 9223372036854775807
    n = factor
    while le n limit bound 9223372036854775807
      if eq cpu_is_comp n 0
        factor = n
        break
      end
      n = add n 2
    end
    if gt factor q
      break
    end
    num = mul factor factor
    step = shl factor 1
    while le num limit bound 9223372036854775807
      cpu_mark_comp num
      num = add num step
    end
    factor = add factor 2
  end
  ret 0
end

fn cpu_export limit ulong to int
  if or eq get cpu_ready 0 0 ne get cpu_limit 0 limit
    ret -1
  end
  nw = pr_words64 limit
  odd = pr_odd_count limit
  for w ulong nw bound 9223372036854775807
    put cpu_exp w xor get cpu_comp w 0xffffffffffffffff
  end
  if gt nw 0
    put cpu_exp 0 and get cpu_exp 0 0xfffffffffffffffe
    rem64 = and odd 63
    if ne rem64 0
      mask = sub shl ulong 1 rem64 1
      last = sub nw 1
      put cpu_exp last and get cpu_exp last mask
    end
  end
  ret 0
end

fn cpu_get_export_word idx ulong to ulong
  ret get cpu_exp idx
end

fn cpu_threads to ulong
  ret 1
end

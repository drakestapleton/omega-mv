note Pure seeded OM-2 host test for the prime race protocol helper and cpu_base baseline.
note Oracle: independent trial division (no sieve). Compares canonical bitmaps word for word.
note Concatenated after bench/prime_race/prime_race_impl.om and bench/prime_race/cpu_base.om.

global ht_checks ulong 1
global ht_fail ulong 1
global ht_nlim ulong 1
global ht_lims ulong 8192
global ht_master ulong 32768
global ht_exp ulong 32768
global ht_bad ulong 32768
global ht_saved ulong 32768

text ht_t_fail "FAIL check: "
text ht_t_nl "\n"
text ht_t_design "design limits checked: "
text ht_t_sum1 "prime_race_host_test: "
text ht_t_sum2 " checks, "
text ht_t_sum3 " failures\n"
text ht_t_pass "PRIME_RACE_HOST_TEST PASS\n"
text ht_t_fail_end "PRIME_RACE_HOST_TEST FAIL\n"
text ht_t_expect_line "aien-cpu-c-base;1234;5.000123;1;algorithm=base,faithful=yes,bits=1"
text ht_t_json_in "a\"b\\c\n\t"
text ht_t_json_expect "\"a\\\"b\\\\c\\n\\t\\u0001z\""
text ht_t_s_schema "\"schema\": \"aien-prime-race/impl-report/v1\""
text ht_t_s_label "\"label\": \"aien-cpu-c-base\""
text ht_t_s_ok "\"status\": \"COMPLETE\""
text ht_t_s_null "\"error\": null"
text ht_t_s_passes "\"passes\": 7"
text ht_t_s_elap "\"elapsed_s\": 5.250000"
text ht_t_s_env "\"environment\": \"linux-host-cpu\""
text ht_t_s_build "\"build\": {\"source_commit\""
text ht_t_s_boom "boom \"x\""
text ht_t_s_boomesc "\"error\": \"boom \\\"x\\\"\""
text ht_t_a_x "x"
text ht_t_a_1000 "1000"
text ht_t_a_05 "0.5"
text ht_t_a_3 "3"
text ht_t_a_tmpb "/tmp/b"
text ht_t_a_12abc "12abc"
text ht_t_a_neg5 "-5"
text ht_t_a_2p40p1 "1099511627777"
text ht_t_a_2p40 "1099511627776"
text ht_t_a_nan "nan"
text ht_t_a_0 "0"
text ht_t_a_2 "2"
text ht_t_a_bogus "--bogus"
text ht_t_empty ""
text ht_t_m_lim "limit mismatch"
text ht_t_m_mpfx "master prefix disagrees"
text ht_t_m_pi "pi(limit) mismatch"
text ht_t_m_neg "negative control failed"
text ht_t_m_rep "repeat pass failed"
text ht_t_m_fmt "formatting check failed"
text ht_t_m_arg "arg parse check failed"

fn ht_check cond bool msg view uchar * to void
  put ht_checks 0 add get ht_checks 0 1
  if not cond
    put ht_fail 0 add get ht_fail 0 1
    ign1 = pr_write_all 2 view ht_t_fail len ht_t_fail
    ign2 = pr_write_all 2 msg len msg
    ign3 = pr_write_all 2 view ht_t_nl len ht_t_nl
  end
end

fn ht_is_prime_td n ulong to int
  if lt n 2
    ret 0
  end
  if eq and n 1 0
    if eq n 2
      ret 1
    end
    ret 0
  end
  d = ulong 3
  while le mul d d n bound 9223372036854775807
    if eq rem n d 0
      ret 0
    end
    d = add d 2
  end
  ret 1
end

fn ht_oracle_exp limit ulong to void
  nw = pr_words64 limit
  for w ulong nw bound 9223372036854775807
    put ht_exp w 0
  end
  odd = pr_odd_count limit
  for k ulong odd bound 9223372036854775807
    if ne ht_is_prime_td add shl k 1 1 0
      w = shr k 6
      b = and k 63
      put ht_exp w or get ht_exp w shl ulong 1 b
    end
  end
end

fn ht_oracle_master limit ulong to void
  nw = pr_words64 limit
  for w ulong nw bound 9223372036854775807
    put ht_master w 0
  end
  odd = pr_odd_count limit
  for k ulong odd bound 9223372036854775807
    if ne ht_is_prime_td add shl k 1 1 0
      w = shr k 6
      b = and k 63
      put ht_master w or get ht_master w shl ulong 1 b
    end
  end
end

fn ht_popcount64 x ulong to ulong
  v = x
  v = sub v and shr v 1 0x5555555555555555
  v = add and v 0x3333333333333333 and shr v 2 0x3333333333333333
  v = and add v shr v 4 0x0f0f0f0f0f0f0f0f
  ret shr mul v 0x0101010101010101 56
end

fn ht_count_primes_cpu limit ulong to ulong
  c = ulong 0
  if ge limit 2
    c = 1
  end
  nw = pr_words64 limit
  for w ulong nw bound 9223372036854775807
    c = add c ht_popcount64 cpu_get_export_word w
  end
  ret c
end

fn ht_first_diff_exp_cpu nw ulong to long
  for w ulong nw bound 9223372036854775807
    if ne get ht_exp w cpu_get_export_word w
      ret long w
    end
  end
  ret -1
end

fn ht_first_diff_exp_bad nw ulong to long
  for w ulong nw bound 9223372036854775807
    if ne get ht_exp w get ht_bad w
      ret long w
    end
  end
  ret -1
end

fn ht_first_diff_saved_cpu nw ulong to long
  for w ulong nw bound 9223372036854775807
    if ne get ht_saved w cpu_get_export_word w
      ret long w
    end
  end
  ret -1
end

fn ht_run_cpu limit ulong to int
  if ne cpu_setup limit 0
    ret -1
  end
  if ne cpu_pass limit 0
    ret -1
  end
  if ne cpu_export limit 0
    ret -1
  end
  ret 0
end

fn ht_check_limit limit ulong to void
  ok = ht_run_cpu limit
  ht_check eq ok 0 view ht_t_m_lim
  if ne ok 0
    ret
  end
  d = ht_first_diff_exp_cpu pr_words64 limit
  ht_check lt d 0 view ht_t_m_lim
end

fn ht_addlim l ulong to void
  n = get ht_nlim 0
  if and le l 2000000 lt n 8192
    put ht_lims n l
    put ht_nlim 0 add n 1
  end
end

fn ht_addrange a ulong b ulong to void
  l = a
  while le l b bound 1000000
    ht_addlim l
    l = add l 1
  end
end

fn ht_buf_eq a view uchar * alen ulong b view uchar * to bool
  if ne alen len b
    ret false
  end
  for i ulong alen
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn ht_buf_contains hay view uchar * hlen ulong needle view uchar * to bool
  nlen = len needle
  if eq nlen 0
    ret true
  end
  if gt nlen hlen
    ret false
  end
  lim = add sub hlen nlen 1
  for i ulong lim
    ok = true
    for j ulong nlen
      if ne get hay add i j get needle j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn ht_set_arg idx ulong s view uchar * to void
  n = len s
  base = mul idx 256
  for i ulong n
    put pr_argv add base i get s i
  end
  put pr_arglen idx n
end

fn ht_set_empty_arg idx ulong to void
  put pr_arglen idx 0
end

fn ht_test_fmt_report to void
  rbuf = new uchar 2048 0
  rep1 = new PrReport 1 100 5.0f64 0 7 5.25f64 0
  rlen = pr_build_report edit rbuf 2048 view rep1 part ht_t_empty 0 0
  ht_check gt rlen 0 view ht_t_m_fmt
  if gt rlen 0
    rl = ulong rlen
    ht_check ht_buf_contains view rbuf rl view ht_t_s_schema view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_label view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_ok view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_null view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_passes view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_elap view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_env view ht_t_m_fmt
    ht_check ht_buf_contains view rbuf rl view ht_t_s_build view ht_t_m_fmt
  end

  rep2 = new PrReport 1 100 5.0f64 0 7 5.25f64 1
  rlen2 = pr_build_report edit rbuf 2048 view rep2 view ht_t_s_boom
  ht_check gt rlen2 0 view ht_t_m_fmt
  if gt rlen2 0
    ht_check ht_buf_contains view rbuf ulong rlen2 view ht_t_s_boomesc view ht_t_m_fmt
  end
end

fn ht_test_formatting to void
  buf = new uchar 512 0
  n = pr_format_line edit buf 512 1234 5.000123456f64 1
  ht_check gt n 0 view ht_t_m_fmt
  if gt n 0
    ht_check ht_buf_eq view buf ulong n view ht_t_expect_line view ht_t_m_fmt
  end
  tiny = new uchar 8 0
  ht_check lt pr_format_line edit tiny 8 1 1.0f64 1 0 view ht_t_m_fmt
  ht_check eq pr_line_allowed 0 1 5.0f64 5.0f64 1 view ht_t_m_fmt
  ht_check eq pr_line_allowed 1 1 5.0f64 5.0f64 0 view ht_t_m_fmt
  ht_check eq pr_line_allowed 0 0 5.0f64 5.0f64 0 view ht_t_m_fmt
  ht_check eq pr_line_allowed 0 3 4.999f64 5.0f64 0 view ht_t_m_fmt

  jin = new uchar 9 0
  for i ulong 7
    put jin i get ht_t_json_in i
  end
  put jin 7 1
  put jin 8 122
  jout = new uchar 64 0
  jlen = pr_json_string edit jout 0 64 view jin
  ht_check ht_buf_eq view jout jlen view ht_t_json_expect view ht_t_m_fmt
  ht_test_fmt_report
end

fn ht_test_args to void
  a = new PrArgs 0 0.0f64 0 0 0
  put pr_argc 0 9
  ht_set_arg 0 view ht_t_a_x
  ht_set_arg 1 view pr_t_opt_limit
  ht_set_arg 2 view ht_t_a_1000
  ht_set_arg 3 view pr_t_opt_minsec
  ht_set_arg 4 view ht_t_a_05
  ht_set_arg 5 view pr_t_opt_audit
  ht_set_arg 6 view ht_t_a_3
  ht_set_arg 7 view pr_t_opt_bmout
  ht_set_arg 8 view ht_t_a_tmpb
  rc1 = pr_parse_args edit a
  ht_check eq rc1 0 view ht_t_m_arg
  ht_check eq get a limit 1000 view ht_t_m_arg
  ht_check eq get a min_sec 0.5f64 view ht_t_m_arg
  ht_check eq get a audit_passes 3 view ht_t_m_arg

  put pr_argc 0 1
  ht_set_arg 0 view ht_t_a_x
  rc2 = pr_parse_args edit a
  ht_check eq rc2 0 view ht_t_m_arg
  ht_check eq get a limit 1000000 view ht_t_m_arg
  ht_check eq get a min_sec 5.0f64 view ht_t_m_arg
  ht_check eq get a audit_passes 0 view ht_t_m_arg

  put pr_argc 0 3
  ht_set_arg 1 view pr_t_opt_limit
  ht_set_arg 2 view ht_t_a_12abc
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  ht_set_arg 2 view ht_t_a_neg5
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  ht_set_arg 2 view ht_t_a_2p40p1
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 2
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 3
  ht_set_arg 1 view pr_t_opt_minsec
  ht_set_arg 2 view ht_t_a_nan
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 5
  ht_set_arg 1 view pr_t_opt_audit
  ht_set_arg 2 view ht_t_a_0
  ht_set_arg 3 view pr_t_opt_bmout
  ht_set_arg 4 view ht_t_a_tmpb
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 2
  ht_set_arg 1 view ht_t_a_bogus
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 3
  ht_set_arg 1 view pr_t_opt_audit
  ht_set_arg 2 view ht_t_a_2
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  put pr_argc 0 3
  ht_set_arg 1 view pr_t_opt_limit
  ht_set_empty_arg 2
  ht_check ne pr_parse_args edit a 0 view ht_t_m_arg

  ht_set_arg 2 view ht_t_a_2p40
  ht_check eq pr_parse_args edit a 0 view ht_t_m_arg
end

fn ht_test_negative_one limit ulong to void
  nw = pr_words64 limit
  ht_oracle_exp limit
  for w ulong nw
    put ht_bad w get ht_exp w
  end
  ht_check lt ht_first_diff_exp_bad nw 0 view ht_t_m_neg
  mid = shr nw 1
  put ht_bad mid xor get ht_bad mid 2
  ht_check eq ht_first_diff_exp_bad nw long mid view ht_t_m_neg
  for w ulong nw
    put ht_bad w get ht_exp w
  end
  odd = pr_odd_count limit
  if ne and odd 63 0
    last = sub nw 1
    put ht_bad last or get ht_bad last shl ulong 1 63
    ht_check ge ht_first_diff_exp_bad nw 0 view ht_t_m_neg
  end
  for w ulong nw
    put ht_bad w 0
  end
  ht_check ge ht_first_diff_exp_bad nw 0 view ht_t_m_neg
end

fn ht_test_negative to void
  ht_test_negative_one 100
  ht_test_negative_one 1000
  ht_test_negative_one 4097
  ht_test_negative_one 1000000
end

fn ht_test_repeat_pass to void
  lim = ulong 12345
  nw = pr_words64 lim
  ht_check eq cpu_setup lim 0 view ht_t_m_rep
  ht_check and eq cpu_pass lim 0 eq cpu_export lim 0 view ht_t_m_rep
  for w ulong nw
    put ht_saved w cpu_get_export_word w
  end
  ht_check and eq cpu_pass lim 0 eq cpu_export lim 0 view ht_t_m_rep
  ht_check lt ht_first_diff_saved_cpu nw 0 view ht_t_m_rep
  ht_check eq cpu_threads 1 view ht_t_m_rep
end

fn ht_test_pi_one lim ulong expect_pi ulong to void
  ok = ht_run_cpu lim
  ht_check eq ok 0 view ht_t_m_pi
  if ne ok 0
    ret
  end
  c = ht_count_primes_cpu lim
  ht_check eq c expect_pi view ht_t_m_pi
end

fn ht_test_pi_table to void
  ht_test_pi_one 10 4
  ht_test_pi_one 100 25
  ht_test_pi_one 1000 168
  ht_test_pi_one 10000 1229
  ht_test_pi_one 100000 9592
  ht_test_pi_one 1000000 78498
  ht_test_pi_one 10000000 664579
end

fn ht_test_all_small to void
  for lim ulong 3001
    ht_oracle_exp lim
    ht_check_limit lim
  end
end

fn ht_check_design_one lim ulong to void
  nw = pr_words64 lim
  odd = pr_odd_count lim
  for w ulong nw
    put ht_exp w get ht_master w
  end
  if and gt nw 0 ne and odd 63 0
    mask = sub shl ulong 1 and odd 63 1
    last = sub nw 1
    put ht_exp last and get ht_exp last mask
  end
  if le lim 3000
    for w ulong nw
      put ht_bad w get ht_exp w
    end
    ht_oracle_exp lim
    ht_check lt ht_first_diff_exp_bad nw 0 view ht_t_m_mpfx
  end
  ht_check_limit lim
end

fn ht_test_design_limits to void
  put ht_nlim 0 0
  ht_addlim 0
  ht_addlim 1
  ht_addlim 2
  ht_addlim 3
  ht_addlim 4
  ht_addlim 5
  ht_addlim 8
  ht_addlim 9
  ht_addlim 15
  ht_addlim 25
  ht_addlim 49
  ht_addlim 121
  ht_addlim 169
  ht_addlim 289
  ht_addlim 361
  ht_addlim 961
  ht_addlim 1000000
  ht_addlim 2000000
  ht_addrange 31 34
  ht_addrange 63 66
  ht_addrange 95 97
  ht_addrange 127 130
  ht_addrange 255 258
  ht_addrange 1023 1025
  ht_addrange 1999 2001
  ht_addrange 4095 4097
  ht_addrange 999983 1000003
  k = ulong 1
  while le mul 2048 k 2000000 bound 2000
    v = mul 2048 k
    ht_addlim sub v 1
    ht_addlim v
    ht_addlim add v 1
    k = add k 1
  end
  p = ulong 2
  while le p 997 bound 1000
    if ne ht_is_prime_td p 0
      pp = mul p p
      ht_addlim sub pp 1
      ht_addlim pp
      ht_addlim add pp 1
    end
    p = add p 1
  end

  ht_oracle_master 2000000
  nlim = get ht_nlim 0
  for i ulong nlim
    ht_check_design_one get ht_lims i
  end

  msg = new uchar 128 0
  pos = ulong 0
  pos = pr_buf_put_str edit msg pos 128 view ht_t_design
  pos = pr_buf_put_u64 edit msg pos 128 nlim
  pos = pr_buf_put_byte edit msg pos 128 10
  ign = pr_write_all 1 view msg pos
end

fn main to int
  put ht_checks 0 0
  put ht_fail 0 0
  ht_test_formatting
  ht_test_args
  ht_test_negative
  ht_test_repeat_pass
  ht_test_pi_table
  ht_test_all_small
  ht_test_design_limits

  msg = new uchar 128 0
  pos = ulong 0
  pos = pr_buf_put_str edit msg pos 128 view ht_t_sum1
  pos = pr_buf_put_u64 edit msg pos 128 get ht_checks 0
  pos = pr_buf_put_str edit msg pos 128 view ht_t_sum2
  pos = pr_buf_put_u64 edit msg pos 128 get ht_fail 0
  pos = pr_buf_put_str edit msg pos 128 view ht_t_sum3
  ign1 = pr_write_all 1 view msg pos
  if ne get ht_fail 0 0
    ign2 = pr_write_all 1 view ht_t_fail_end len ht_t_fail_end
    ret 1
  end
  ign3 = pr_write_all 1 view ht_t_pass len ht_t_pass
  ret 0
end

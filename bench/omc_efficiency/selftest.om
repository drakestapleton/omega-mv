text tsetup "selftest: setup step failed: "
note gpb: path or argument being built; gin/gou: the child's stdin and stdout paths; gpk: exec packet;
note glb: output line; gex: expected text of the current check; gfb, gf2: whole files
global gpb uchar 4096
global gpbn ulong 1
global gin uchar 4096
global ginn ulong 1
global gou uchar 4096
global goun ulong 1
global gpk uchar 8192
global gpkn ulong 1
global gpkc ulong 1
global glb uchar 4096
global glbn ulong 1
global gex uchar 1024
global gexn ulong 1
global gfb uchar 4194304
global gf2 uchar 4194304
global gst uchar 4
global gcnt ulong 5
note gcnt: 0 fails, 1 not_run, 2 counters on (1) / off (0), 3 bytes held by cpfrom, 4 exit code chk expects

note ---- path builder
fn pbclr to void
put gpbn 0 0
end
fn pbtext t view uchar * to void
n = get gpbn 0
if gt add n len t 4096
trap 9
end
for i ulong len t
put gpb add n i get t i
end
put gpbn 0 add n len t
end
fn pbarg idx ulong to void
n = get gpbn 0
r = argread idx gpb n sub 4096 n
if lt r 0
trap 9
end
put gpbn 0 add n ulong r
end
fn pbset t view uchar * to void
pbclr
pbtext t
end
note copy gpb into gin (stdin path) or gou (stdout path)
fn setin to void
n = get gpbn 0
for i ulong n
put gin i get gpb i
end
put ginn 0 n
end
fn setout to void
n = get gpbn 0
for i ulong n
put gou i get gpb i
end
put goun 0 n
end

note ---- exec packet: u16 count, then records (u16 length, bytes); pkpush adds gpb as one record
fn pkreset to void
put gpk 0 0
put gpk 1 0
put gpkn 0 2
put gpkc 0 0
end
fn pkpush to void
n = get gpkn 0
m = get gpbn 0
if gt add add n m 2 8192
trap 9
end
put gpk n uchar and m 255
put gpk add n 1 uchar shr m 8
for i ulong m
put gpk add add n 2 i get gpb i
end
put gpkn 0 add add n m 2
c = add get gpkc 0 1
put gpkc 0 c
put gpk 0 uchar and c 255
put gpk 1 uchar shr c 8
end
note pkline: one record per space-separated word of t; the word @ stands for argument 1 (OMC)
fn pkline t view uchar * to void
pkreset
pbclr
for i ulong len t
c = get t i
if eq c 32
pkword
pbclr
else
put gpb get gpbn 0 c
put gpbn 0 add get gpbn 0 1
end
end
pkword
end
fn pkword to void
if eq get gpbn 0 0
ret
end
if and eq get gpbn 0 1 eq get gpb 0 64
pbclr
pbarg 1
end
pkpush
end

note ---- output line and expected text
fn lbtext t view uchar * to void
n = get glbn 0
if gt add n len t 4096
trap 9
end
for i ulong len t
put glb add n i get t i
end
put glbn 0 add n len t
end
fn lbnum v ulong to void
d = new uchar 24 0
p = ulong 24
x = v
while gt x 9
p = sub p 1
put d p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put d p uchar add x 48
n = get glbn 0
for i ulong sub 24 p
put glb add n i get d add p i
end
put glbn 0 add n sub 24 p
end
fn lbflush to void
lbtext tnl
w = write 1 glb 0 get glbn 0
put glbn 0 0
end
note move the line built so far into gex (the expected text of the next check)
fn lbtoex to void
n = get glbn 0
if gt n 1024
trap 9
end
for i ulong n
put gex i get glb i
end
put gexn 0 n
put glbn 0 0
end

note ---- files: rdin reads the file named by gpb into gfb (or gf2 when two is true); returns the size,
note 4194305 when it does not fit, 4194306 when it cannot be opened
fn rdin two bool to ulong
fd = fopen gpb 0 get gpbn 0 0 0
if lt fd 0
ret 4194306
end
n = ulong 0
going = true
while going bound 999999999
r = rdpart fd n two
if le r 0
going = false
else
n = add n ulong r
if eq n 4194304
going = false
end
end
end
c = fclose int fd
if eq n 4194304
ret 4194305
end
ret n
end
fn rdpart fd long n ulong two bool to long
if two
ret read int fd gf2 n sub 4194304 n
end
ret read int fd gfb n sub 4194304 n
end
note write gfb[0 .. n) to the file named by gpb, then chmod it to mode; false on any failure
fn wrfb n ulong mode int to bool
fd = fopen gpb 0 get gpbn 0 577 mode
if lt fd 0
ret false
end
w = write int fd gfb 0 n
c = fclose int fd
if ne w long n
ret false
end
m = chmod gpb 0 get gpbn 0 mode
ret true
end
fn wrtext t view uchar * to bool
for i ulong len t
put gfb i get t i
end
ret wrfb len t 420
end
note copy the file at gpb (source) to the path pbset/pbtext builds next; cpbegin reads, cpend writes
fn cpbegin to ulong
n = rdin false
if ge n 4194305
setfail tsetup
end
ret n
end
fn cpend n ulong to void
if not wrfb n 493
setfail tsetup
end
end
fn setfail t view uchar * to void
lbtext t
w = write 2 glb 0 get glbn 0
w2 = write 2 gpb 0 get gpbn 0
w3 = write 2 tnl 0 1
exit 1
end

note ---- one child: stdin gin, stdout gou, stderr child.err, exec gpk; returns the exit status
fn child to void
fi = fopen gin 0 get ginn 0 0 0
if lt fi 0
exit 120
end
r = dupfd int fi 0 0
if ne r 0
exit 121
end
fo = fopen gou 0 get goun 0 577 493
if lt fo 0
exit 122
end
r = dupfd int fo 1 0
if ne r 1
exit 123
end
fe = fopen tcerr 0 len tcerr 577 420
if lt fe 0
exit 124
end
r = dupfd int fe 2 0
if ne r 2
exit 125
end
r = execprog gpk 0 get gpkn 0
exit 126
end
fn runpk to ulong
pid = fork
if lt pid 0
trap 9
end
if eq pid 0
child
exit 127
end
r = waitpid int pid gst 0 4 0
if ne r pid
trap 9
end
s0 = ulong get gst 0
if ne and s0 127 0
ret add 1000 and s0 127
end
ret ulong get gst 1
end
note run the command line t with stdin /dev/null and stdout into file o
fn runline t view uchar * o view uchar * to ulong
pkline t
pbset tnull
setin
pbset o
setout
ret runpk
end
note omc < (path in gin) > (path in gou); exit status
fn omcrun to ulong
pkreset
pbclr
pbarg 1
pkpush
ret runpk
end

note ---- setup helpers
fn mkd t view uchar * to void
pbset t
r = makedir gpb 0 get gpbn 0 493
if lt r 0
setfail tsetup
end
end
note omc HERE/kernels/[om2/]CASE.om -> bin/omc/[om2/]CASE
fn bomc c view uchar * o2 bool to void
pbclr
pbarg 2
if o2
pbtext tkom2
else
pbtext tkern
end
pbtext c
pbtext tom
setin
pbset tbo
if o2
pbtext tom2
end
pbtext c
setout
if ne omcrun 0
setfail tsetup
end
end
note HERE/kernels/CASE.EXT -> src/CASE.EXT
fn cpsrc c view uchar * x view uchar * to void
pbclr
pbarg 2
pbtext tkern
pbtext c
pbtext x
n = cpbegin
pbset tsrc
pbtext c
pbtext x
cpend n
end
note gcc -Ox -static of src/CASE.c -> bin/cOx/CASE
fn gccone c view uchar * g view uchar * b view uchar * to void
pkline g
pbset b
pbtext c
pkpush
pbset tsrc
pbtext c
pbtext tc
pkpush
pbset tnull
setin
pbset tcerr
setout
if ne runpk 0
setfail tsetup
end
end
note copy a file in two steps: cpfrom reads (a1 a2) into gfb, cpto writes it to (b1 b2)
fn cpfrom a1 view uchar * a2 view uchar * to void
pbset a1
pbtext a2
put gcnt 3 cpbegin
end
fn cpto b1 view uchar * b2 view uchar * to void
pbset b1
pbtext b2
cpend get gcnt 3
end
note want/[om2/]CASE.out from HERE/want/CASE.out
fn cpwant c view uchar * o2 bool to void
pbclr
pbarg 2
pbtext twant
pbtext c
pbtext tout
n = cpbegin
pbset twd
if o2
pbtext tom2
end
pbtext c
pbtext tout
cpend n
end
note fixture program: source text s compiled by OMC into fx/NAME
fn fixture s view uchar * name view uchar * to void
pbset tfxs
if not wrtext s
setfail tsetup
end
setin
pbset tfxd
pbtext name
setout
if ne omcrun 0
setfail tsetup
end
end

note ---- reading raw rows: the last line of gfb[0 .. n) equals gex
fn lastis n ulong to bool
e = n
if and gt e 0 eq get gfb sub e 1 10
e = sub e 1
end
s = e
while and gt s 0 ne get gfb sub s 1 10 bound 999999999
s = sub s 1
end
m = get gexn 0
if ne sub e s m
ret false
end
for i ulong m
if ne get gfb add s i get gex i
ret false
end
end
ret true
end
note append the last line of gfb[0 .. n) to glb
fn lblast n ulong to void
e = n
if and gt e 0 eq get gfb sub e 1 10
e = sub e 1
end
s = e
while and gt s 0 ne get gfb sub s 1 10 bound 999999999
s = sub s 1
end
for i ulong sub e s bound 4194304
m = get glbn 0
if lt m 4000
put glb m get gfb add s i
put glbn 0 add m 1
end
end
end
note fields of the line of gfb starting at s: starts in fs, lengths in fl; returns the field count
fn fields s ulong n ulong fs edit ulong 16 fl edit ulong 16 to ulong
k = ulong 0
i = s
going = true
while going bound 999999999
if or ge i n eq get gfb i 10
going = false
else
if eq get gfb i 32
i = add i 1
else
j = fend i n
if lt k 16
put fs k i
put fl k sub j i
end
k = add k 1
i = j
end
end
end
ret k
end
fn fend i ulong n ulong to ulong
j = i
while lt j n bound 999999999
c = get gfb j
if or eq c 32 eq c 10
ret j
end
j = add j 1
end
ret j
end
note field f equals text t
fn feq fs view ulong 16 fl view ulong 16 f ulong t view uchar * to bool
if ne get fl f len t
ret false
end
s = get fs f
for i ulong len t
if ne get gfb add s i get t i
ret false
end
end
ret true
end
fn fnum fs view ulong 16 fl view ulong 16 f ulong to ulong
v = ulong 0
s = get fs f
for i ulong get fl f
c = get gfb add s i
if or lt c 48 gt c 57
ret 18446744073709551615
end
v = add mul v 10 ulong sub c 48
end
ret v
end
note scan the rows of gfb[0 .. n): kind 1 counts P rows with a zero counter, 2 counts T rows of a
note non-control arm without a valid runtime, 3 counts T/P rows not labelled om2/fib, 4 returns the
note runtime of the cO2 T row, 5 returns 1 when the H row ends with counters=on
fn scan n ulong kind ulong to ulong
fs = new ulong 16 0
fl = new ulong 16 0
cnt = ulong 0
s = ulong 0
while lt s n bound 999999999
k = fields s n fs fl
if gt k 0
cnt = add cnt rowis kind k fs fl
end
s = nextln s n
end
ret cnt
end
fn nextln s ulong n ulong to ulong
i = s
while lt i n bound 999999999
if eq get gfb i 10
ret add i 1
end
i = add i 1
end
ret n
end
fn rowis kind ulong k ulong fs view ulong 16 fl view ulong 16 to ulong
if gt k 16
ret 0
end
if eq kind 1
ret rowp k fs fl
end
if eq kind 2
ret rowt k fs fl
end
if eq kind 3
if or feq fs fl 0 tT feq fs fl 0 tP
if not feq fs fl 3 tofib
ret 1
end
end
ret 0
end
if eq kind 4
if and and feq fs fl 0 tT feq fs fl 4 tcO2 eq k 10
ret fnum fs fl 9
end
ret 0
end
if and feq fs fl 0 tH gt k 0
if feq fs fl sub k 1 tcon
ret 1
end
end
ret 0
end
fn rowp k ulong fs view ulong 16 fl view ulong 16 to ulong
if and feq fs fl 0 tP eq k 10
if or eq fnum fs fl 6 0 eq fnum fs fl 7 0
ret 1
end
end
ret 0
end
fn rowt k ulong fs view ulong 16 fl view ulong 16 to ulong
if and feq fs fl 0 tT not feq fs fl 4 tneg
if ne k 10
ret 1
end
if or not feq fs fl 8 tone feq fs fl 9 tzero
ret 1
end
end
ret 0
end

note ---- checks
fn report ok bool name view uchar * rc ulong gotn ulong to void
if ok
lbtext tpass
else
lbtext tfl
put gcnt 0 add get gcnt 0 1
end
lbtext name
lbtext trc
lbnum rc
lbtext tsp
m = get glbn 0
for i ulong get gexn 0
put glb add m i get gex i
end
put glbn 0 add m get gexn 0
if not ok
lbtext tgot
lbtext tq
if lt gotn 4194305
lblast gotn
end
lbtext tq
end
lbflush
end
note expected summary: T-part (rows ok fail) plus P-part when counters are on, then detected, missed
fn exsum tr ulong tk ulong tf ulong pr ulong pk ulong pf ulong to void
r = tr
o = tk
f = tf
if eq get gcnt 2 1
r = add r pr
o = add o pk
f = add f pf
end
lbtext tS
lbnum r
lbtext tok
lbnum o
lbtext tfail
lbnum f
end
fn exctl d ulong m ulong to void
lbtext tdet
lbnum d
lbtext tmiss
lbnum m
end
note run the line t into raw file o, expect exit gcnt[4] and the summary already built in glb
fn chk name view uchar * t view uchar * o view uchar * to void
lbtoex
rc = runline t o
pbset o
n = rdin false
ok = and eq rc get gcnt 4 lt n 4194305
if ok
ok = lastis n
end
report ok name rc n
end
fn chkrc name view uchar * t view uchar * wrc ulong to void
lbtoex
rc = runline t fnull
report eq rc wrc name rc 4194306
end
fn chkval name view uchar * ok bool to void
lbtoex
report ok name 0 4194306
end

note ---- the checks, in the order of the former selftest.sh, plus the two OMC-EFF-4 control checks
fn part1 to void
exsum 8 6 0 6 6 0
exctl 2 0
put gcnt 4 0
chk n1 rclean fok
pbset fok
n = rdin false
if eq get gcnt 2 1
z = scan n 1
lbtext tzr
lbnum z
chkval n2 eq z 0
else
lbtext tnr
lbtext n2
lbtext tparn
lbflush
put gcnt 1 add get gcnt 1 1
end
z2 = scan n 2
lbtext tbt
lbnum z2
chkval n3 eq z2 0
f = scan n 5
if eq f 1
lbtext tcon
else
lbtext tcoff
end
chkval n17 eq f get gcnt 2
end
fn part2 to void
pbset twd
pbtext tfibo
n = cpbegin
pbset tkeepw
cpend n
pbset twd
pbtext tfibo
if not wrtext twrong
setfail tsetup
end
exsum 4 0 3 3 0 3
exctl 1 0
put gcnt 4 1
chk n4 rfib fnc1
pbset tkeepw
m2 = cpbegin
pbset twd
pbtext tfibo
cpend m2
cpfrom tbo tfib
cpto tbn tfib
exsum 4 3 0 3 3 0
exctl 0 1
chk n5 rfib fnc2
end
fn part3 to void
cpfrom tbo tsieve
cpto tbn tfib
pbset tb2
pbtext tfib
n = cpbegin
pbset tkeep2
cpend n
put gfb n 120
pbset tb2
pbtext tfib
cpend add n 1
exsum 3 2 1 0 0 0
exctl 0 0
chk n6 rbld fnc3
cpfrom tkeepd tkeepn
cpto tb2 tfib
exsum 3 3 0 0 0 0
exctl 0 0
put gcnt 4 0
chk n7 rbld fb
end
fn part4 to void
cpfrom tfxd tn0
cpto tb2 tfib
exsum 4 2 1 3 3 0
exctl 1 0
put gcnt 4 1
chk n8 rfib fnc4
cpfrom tfxd tnb
cpto tb2 tfib
exsum 4 2 1 3 3 0
exctl 1 0
chk n9 rfib fnc5
cpfrom tfxd tn1
cpto tb2 tfib
rc = runline rfib fok2
pbset fok2
n = rdin false
v = scan n 4
exsum 4 3 0 3 3 0
exctl 1 0
lbtoex
ok = and and eq rc 0 lastis n eq v 123
exsum 4 3 0 3 3 0
exctl 1 0
lbtext trt
lbnum 123
lbtoex
report ok n10 rc n
cpfrom tkeepd tkeepn
cpto tb2 tfib
end
fn part5 to void
cpfrom tfxd tn0
cpto tbn tfib
exsum 4 3 1 3 3 0
exctl 0 0
put gcnt 4 1
chk n11 rfib fnc6
cpfrom tfxd tnc
cpto tbn tfib
exsum 4 3 1 3 3 0
exctl 0 0
chk n12 rfib fnc7
cpfrom tbo tsieve
cpto tbn tfib
end
fn part6 to void
bomc tfib true
cpfrom tb2 tfib
cpto tb2 tofib
cpfrom tb0 tfib
cpto tb0 tofib
cpfrom tbo tsieve
cpto tbn tofib
rc = runline rom2 fom2
pbset fom2
n = rdin false
u = scan n 3
exsum 4 3 0 3 3 0
exctl 1 0
lbtoex
ok = and and eq rc 0 eq u 0 lastis n
exsum 4 3 0 3 3 0
exctl 1 0
lbtext tunl
lbnum u
lbtoex
report ok n13 rc n
lbtext tdiff
chkval n14 not om2same
chkrc n15 rusage 2
chkrc n16 rseed0 2
end
fn om2same to bool
pbset tbo
pbtext tofib
a = rdin false
pbset tbo
pbtext tfib
b = rdin true
if or ne a b ge a 4194305
ret false
end
for i ulong a bound 4194304
if ne get gfb i get gf2 i
ret false
end
end
ret true
end

note ---- main
fn perfok to ulong
b = new uchar 32 0
fd = fopen tparan 0 len tparan 0 0
if lt fd 0
ret 0
end
n = read int fd b 0 32

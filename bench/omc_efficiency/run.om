lbslot 5
lbtext pbrnd
lbslot 7
lbpv
end
note the MAXMHZ field of the lscpu -e=CPU,MAXMHZ line whose CPU field equals slot 6
fn lscpu n ulong to void
s = ulong 0
while lt s n bound 4194304
e = lnend s n
f0 = skipsp s e
f1 = wordend f0 e
if cpueq f0 f1
lbfield skipsp f1 e e
ret
end
s = add e 1
end
end
note the word of gfb starting at s (up to a space or e) onto glb
fn lbfield s ulong e ulong to void
f = wordend s e
for i ulong sub f s
m = get glbn 0
put glb m get gfb add s i
put glbn 0 add m 1
end
end
fn cpueq a ulong b ulong to bool
m = get gsln 6
if ne sub b a m
ret false
end
for i ulong m
if ne get gfb add a i get gsl add shl ulong 6 12 i
ret false
end
end
ret true
end
fn lnend s ulong n ulong to ulong
i = s
while lt i n bound 4194304
if eq get gfb i 10
ret i
end
i = add i 1
end
ret n
end
fn skipsp s ulong e ulong to ulong
i = s
while and lt i e eq get gfb i 32 bound 4194304
i = add i 1
end
ret i
end
fn wordend s ulong e ulong to ulong
i = s
while and lt i e ne get gfb i 32 bound 4194304
i = add i 1
end
ret i
end
fn loadavg to void
pbset tload
n = rdin 0
if gt n 4194304
ret
end
lbfirst n false
end
note inputs.sha256: sha256sum of the protocol files, the drivers and every kernel, C twin and want, run in HERE
fn inputs to void
pkreset
pkt tsha
pkt tprot1
pkt tprot2
pkt tprot3
pkt tprot4
pkt tcondn
pkt trunom
pkt tselfom
for i ulong 7
inkern i tkdir tom
end
for j ulong 7
inkern j tkdir2 tom
end
for k ulong 7
inkern k tkdir tc
end
for m ulong 7
inkern m twdir tout
end
nored
pbclr
pbslot 0
setcd
pbset tnull
setin
pbr tinsha
setout
r = runpk
if ne r 0
die esha
end
end
fn inkern i ulong d view uchar * x view uchar * to void
pbset d
fldset tcsort 32 i
pbfld tcsort
pbtext x
pkpush
end

note ---- PROTOCOL-3 section 2: kernels/om2/CASE.om is kernels/CASE.om with one line om2 before the first
note line that is not a note and the global out spelled obuf; checked here, never generated here
fn om2chk to void
if eq get gv 0 0
ret
end
for i ulong 7
om2one i
end
end
fn om2one i ulong to void
pbkd i
n = rdin 0
if gt n 4194304
die ecopy
end
if ne om2cnt n 1
diep eo2cnt
end
if not om2fst n
diep eo2fst
end
a = om2filt n
pbclr
pbslot 0
pbtext tkern
pbcase i
pbtext tom
m = rdin 1
if gt m 4194304
die ecopy
end
b = rename m
pbkd i
if ne a b
diep eo2dif
end
for j ulong a bound 4194304
if ne get gf3 j get gfb j
diep eo2dif
end
end
end
note lines of gfb[0 .. n) that are exactly om2
fn om2cnt n ulong to ulong
k = ulong 0
s = ulong 0
while lt s n bound 4194304
e = lnend s n
if isom2 s e
k = add k 1
end
s = add e 1
end
ret k
end
fn isom2 s ulong e ulong to bool
if ne sub e s 3
ret false
end
ret fbis s to2
end
note gfb[s ..] starts with t (the caller keeps s + len t inside the data)
fn fbis s ulong t view uchar * to bool
for i ulong len t
if ne get gfb add s i get t i
ret false
end
end
ret true
end
note the first line not starting with note is exactly om2
fn om2fst n ulong to bool
s = ulong 0
while lt s n bound 4194304
e = lnend s n
if not isnote s e
ret isom2 s e
end
s = add e 1
end
ret false
end
fn isnote s ulong e ulong to bool
if lt sub e s 4
ret false
end
ret fbis s tnote
end
note gfb without its om2 lines, each kept line ended by LF, into gf3; returns the length
fn om2filt n ulong to ulong
k = ulong 0
s = ulong 0
while lt s n bound 4194304
e = lnend s n
if not isom2 s e
for i ulong sub e s
put gf3 add k i get gfb add s i
end
k = add k sub e s
put gf3 k 10
k = add k 1
end
s = add e 1
end
ret k
end
note gf2[0 .. m) with every word out (word bytes A-Z a-z 0-9 _) spelled obuf, into gfb; returns the length
fn rename m ulong to ulong
k = ulong 0
i = ulong 0
while lt i m bound 4194304
if isout i m
put gfb k 111
put gfb add k 1 98
put gfb add k 2 117
put gfb add k 3 102
k = add k 4
i = add i 3
else
put gfb k get gf2 i
k = add k 1
i = add i 1
end
end
ret k
end
fn isout i ulong m ulong to bool
if gt add i 3 m
ret false
end
if ne get gf2 i 111
ret false
end
if ne get gf2 add i 1 117
ret false
end
if ne get gf2 add i 2 116
ret false
end
if gt i 0
if wordb get gf2 sub i 1
ret false
end
end
if lt add i 3 m
if wordb get gf2 add i 3
ret false
end
end
ret true
end
fn wordb c uchar to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret eq c 95
end

note ---- negative-control mutants: one output-changing edit per kernel; each must apply exactly once
fn mutate i ulong to void
fldset tmf 124 i
put gv 10 get gv 8
put gv 11 get gv 9
fldset tmt 124 i
put gv 12 get gv 8
put gv 13 get gv 9
pbkd i
n = rdin 0
if gt n 4194304
die ecopy
end
k = mutcnt n
if ne k 1
diep emutn
end
m = mutbld n
pbw tmut
pbkey i
pbtext tom
if not wrbuf 2 m 420
die ewrite
end
if eq m n
if mutsame n
diep emutu
end
end
end
fn mutsame n ulong to bool
for i ulong n bound 4194304
if ne get gfb i get gf3 i
ret false
end
end
ret true
end
note the first index in gfb[s .. e) where the mutant's from text starts, or e
fn mfind s ulong e ulong to ulong
f = get gv 10
m = get gv 11
if lt sub e s m
ret e
end
for i ulong add sub sub e s m 1 bound 4194304
if mat add s i f m
ret add s i
end
end
ret e
end
fn mat p ulong f ulong m ulong to bool
for j ulong m
if ne get gfb add p j get tmf add f j
ret false
end
end
ret true
end
fn mutcnt n ulong to ulong
k = ulong 0
s = ulong 0
while lt s n bound 4194304
e = lnend s n
if lt mfind s e e
k = add k 1
end
s = add e 1
end
ret k
end
note awk: every line printed with LF; in a line holding from, its first occurrence becomes to
fn mutbld n ulong to ulong
k = ulong 0
s = ulong 0
while lt s n bound 4194304
e = lnend s n
p = mfind s e
k = mutln s e p k
s = add e 1
end
ret k
end
fn mutln s ulong e ulong p ulong k0 ulong to ulong
k = g3cp k0 s p
if lt p e
k = g3to k
k = g3cp k add p get gv 11 e
end
put gf3 k 10
ret add k 1
end
note gfb[s .. e) appended to gf3 at k; returns the new end
fn g3cp k ulong s ulong e ulong to ulong
for i ulong sub e s bound 4194304
put gf3 add k i get gfb add s i
end
ret add k sub e s
end
note the mutant's to text appended to gf3 at k
fn g3to k ulong to ulong
t = get gv 12
m = get gv 13
for j ulong m
put gf3 add k j get tmt add t j
end
ret add k m
end

note ---- arms
fn arms to void
nored
pbclr
pbslot 0
pbtext tcondom
setin
pbw tcond
setout
pbr tcond
pbtext terr
seterr
pkreset
pks 1
if ne runpk 0
die econd
end
pbw tcond
m = chmod gpb 0 get gpbn 0 493
for i ulong 7
armcase i
end
end
fn armcase i ulong to void
pbkd i
n = cpfrom
pbw tsrc
pbkey i
pbtext tom
cpto n
pbclr
pbslot 0
pbtext tkern
pbcase i
pbtext tc
n2 = cpfrom
pbw tsrc
pbkey i
pbtext tc
cpto n2
pbclr
pbslot 0
pbtext twantd
pbcase i
pbtext tout
n3 = cpfrom
pbw twant
pbkey i
pbtext tout
cpto n3
for a ulong narm 0
omcarm i a
end
negarm i
for o ulong narm 1
carm i o
end
end
note omc arm a: its compiler (slot 2 for omcC, else slot 1) < W/src/KEY.om > W/bin/ARM/KEY 2> R/ARM-CASE.err
fn omcarm i ulong a ulong to void
nored
pbw tsrc
pbkey i
pbtext tom
setin
pbw tbin
pbarm 0 a
pbtext tslash
pbkey i
setout
pbclr
pbslot 3
pbtext tslash
pbarm 0 a
pbtext tdash
pbcase i
pbtext terr
seterr
pkreset
if and eq get gv 1 1 eq a 1
pks 2
else
pks 1
end
if ne runpk 0
pbw tsrc
pbkey i
pbtext tom
diep erefus
end
pbw tbin
pbarm 0 a
pbtext tslash
pbkey i
m = chmod gpb 0 get gpbn 0 493
end
fn negarm i ulong to void
nored
pbw tmut
pbkey i
pbtext tom
setin
pbw tbin
pbtext tneg
pbtext tslash
pbkey i
setout
pbclr
pbslot 3
pbtext tslash
pbtext tneg
pbtext tdash
pbcase i
pbtext terr
seterr
pkreset
pks 1
if ne runpk 0
pbw tmut
pbkey i
pbtext tom
diep erefus
end
pbw tbin
pbtext tneg
pbtext tslash
pbkey i
m = chmod gpb 0 get gpbn 0 493
end
note gcc -Ox -static to bin/cOx/KEY and gcc -Ox -c to obj/CASE.Ox.o, in W; objdump -dr of the object
note to R/disasm-c/CASE.Ox.s (PROTOCOL-2 section 3)
fn carm i ulong o ulong to void
gccpk i o false
nored
pbclr
pbslot 4
setcd
if ne runpk 0
pbw tsrc
die egcc
end
gccpk i o true
if ne runpk 0
pbw tsrc
die egcc
end
nored
pkreset
pkt tobjd
pkt tdr
pbw tobj
pbobj i o
pkpush
pbr tdis2
pbobj2 i o
pbtext tdots
setout
if ne runpk 0
die eobjd
end
end
fn pbobj i ulong o ulong to void
pbcase i
pbtext tdot
pbarm 1 o
pbtext tdoto
end
fn pbobj2 i ulong o ulong to void
pbcase i
pbtext tdot
pbarm 1 o
end
note /usr/bin/gcc -B/usr/bin/ -Ox -static -o bin/cOx/KEY src/KEY.c, or -Ox -c -o obj/CASE.Ox.o src/KEY.c
fn gccpk i ulong o ulong obj bool to void
pkreset
pkt tgcc
pkt tgccb
pbset tdash
pbarm 1 o
pkpush
if obj
pkt tdc
pkt tdo
pbclr
pbtext tobjw
pbobj i o
pkpush
else
pkt tstatic
pkt tdo
pbset tbinw
pbtext tcO
pbarm 1 o
pbtext tslash
pbkey i
pkpush
end
pbset tsrcw
pbkey i
pbtext tc
pkpush
end

note ---- arms.sha256: the find conductor bin mut -type f | LC_ALL=C sort list, hashed in W
fn armsha to void
pkreset
pkt tsha
if eq get gv 1 1
for a ulong 4
armfil tsarmb a
end
else
for b ulong 4
armfil tsarm b
end
end
pkt tcondw
for i ulong 7
pbset tmutw
mkey i
pbtext tom
pkpush
end
nored
pbclr
pbslot 4
setcd
pbset tnull
setin
pbr tarsha
setout
r = runpk
if ne r 0
die esha
end
end
fn armfil t view uchar * a ulong to void
for i ulong 7
pbset tbinw
fldset t 32 a
pbfld t
pbtext tslash
mkey i
pkpush
end
end
note P then the case name in sorted order
fn mkey i ulong to void
if eq get gv 0 1
pbtext tom2s
end
fldset tcsort 32 i
pbfld tcsort
end

note ---- PROTOCOL-3 section 4: under --ab --profile om2, whether the candidate leaves every OM-1 kernel's
note bytes unchanged (a report)
fn identity to void
if or eq get gv 1 0 eq get gv 0 0
ret
end
pbr tident
fd = fopen gpb 0 get gpbn 0 577 420
if lt fd 0
die ewrite
end
for i ulong 7
idone i ulong fd
end
c = fclose int fd
pbw tidB
r = unlink gpb 0 get gpbn 0
pbw tidC
r2 = unlink gpb 0 get gpbn 0
end
fn idone i ulong fd ulong to void
rb = idcomp i 1 tidB
rc = idcomp i 2 tidC
pbw tidB
a = rdin 0
pbw tidC
b = rdin 1
s = and and eq rb 0 eq rc 0 same2 a b
pbclr
pbcase i
lbpb
lbtext tsp
if s
lbtext tsame
else
lbtext tdiff
end
lbtext tbrc
lbnum rb
lbtext tcrc
lbnum rc
lbtext tsp
shaw tidB
lbtext tsp
shaw tidC
lbto fd
end
fn same2 a ulong b ulong to bool
if or ne a b gt a 4194304
ret false
end
for i ulong a bound 4194304
if ne get gfb i get gf2 i
ret false
end
end
ret true
end
fn idcomp i ulong k ulong t view uchar * to ulong
nored
pbclr
pbslot 0
pbtext tkern
pbcase i
pbtext tom
setin
pbw t
setout
pbset tnull
seterr
pkreset
pks k
ret runpk
end
note the SHA-256 of W/NAME onto glb
fn shaw t view uchar * to void
pkreset
pkt tsha
pbw t
pkpush
n = capture
lbfirst n true
end

note ---- sizes.txt: file bytes of every arm binary; text bytes = file bytes for the omc arms (no section
note table), the summed .text sections of size -A for the C objects
fn sizes to void
pbr tsizes
fd = fopen gpb 0 get gpbn 0 577 420
if lt fd 0
die ewrite
end
lbtext tszh
lbto ulong fd
for i ulong 7
sizcase i ulong fd
end
c = fclose int fd
end
fn sizcase i ulong fd ulong to void
for a ulong narm 0
pbw tbin
pbarm 0 a
pbtext tslash
pbkey i
n = fsize
pbclr
pbkey i
lbpb
lbtext tsp
pbclr
pbarm 0 a
lbpb
lbtext tsp
lbnum n
lbtext tsp
lbnum n
lbto fd
end
for o ulong narm 1
sizc i o fd
end
end
fn sizc i ulong o ulong fd ulong to void
pbw tbin
pbtext tcO
pbarm 1 o
pbtext tslash
pbkey i
n = fsize
pbclr
pbkey i
lbpb
lbtext tsp
pbset tcO
pbarm 1 o
lbpb
lbtext tsp
lbnum n
lbtext tsp
pkreset
pkt tsize
pkt tsA
pbw tobj
pbobj i o
pkpush
m = capture
lbnum textsz m
lbto fd
end
fn fsize to ulong
n = rdin 0
if gt n 4194304
die ecopy
end
ret n
end
note the sum of the size column of the lines whose first field starts with .text
fn textsz n ulong to ulong
v = ulong 0
s = ulong 0
while lt s n bound 4194304
e = lnend s n
f0 = skipsp s e
if istext f0 e
f1 = wordend f0 e
f2 = skipsp f1 e
v = add v decat f2 e
end
s = add e 1
end
ret v
end
fn istext s ulong e ulong to bool
m = len tptext
if lt sub e s m
ret false
end
for i ulong m
if ne get gfb add s i get tptext i
ret false
end
end
ret true
end
fn decat s ulong e ulong to ulong
v = ulong 0
i = s
while lt i e bound 32
c = get gfb i
if or lt c 48 gt c 57
ret v
end
v = add mul v 10 ulong sub c 48
i = add i 1
end
ret v
end

note ---- the declared runs: compile time first, then the emitted programs; each status is recorded and
note any nonzero one makes the exit status 1
fn cpk1 to void
pkreset
put gpinned 0 1
pkt tcondx
end
fn crun ro view uchar * re view uchar * to ulong
nored
pbclr
pbslot 4
setcd
pbset tnull
setin
pbr ro
setout
pbr re
seterr
r = runpk
if ne r 0
put gv 3 add get gv 3 1
end
ret r
end
fn cargs to void
for i ulong 7
pbclr
pbkey i
pkpush
end
end
fn bpre k ulong to void
cpk1
pkt tbuild
pkt t10
pkt t1
pks 7
pks k
end
fn runs to void
if eq get gv 1 1
runsab
ret
end
bpre 1
pkt t3
pkt tomc
pkt tcO2
pkt tcO0
cargs
r = crun tbraw tberr
lbtext pbrc
lbnum r
lbpv
rpre
pkt tomc
pkt tcO2
pkt tcO0
pkt tneg
cargs
r2 = crun trraw trerr
lbtext prrc
lbnum r2
lbpv
end
fn rpre to void
cpk1
pkt trun
pkt t21
pkt t3
pks 5
pkt t1
pkt t4
end
fn runsab to void
bpre 1
pkt t1
pkt tomcB
cargs
r = crun tbbraw tbberr
lbtext pbbrc
lbnum r
lbpv
bpre 2
pkt t1
pkt tomcC
cargs
r2 = crun tbcraw tbcerr
lbtext pbcrc
lbnum r2
lbpv
rpre
pkt tomcB
pkt tomcC
pkt tcO2
pkt tneg
cargs
r3 = crun trraw trerr
lbtext prrc
lbnum r3
lbpv
end

note ---- the end: provenance.txt and the last row of every raw file on stdout
fn finish to int
lbtext pld1
loadavg
lbpv
c = fclose int get gv 2
pbr tprov
n = rdin 0
if le n 4194304
w = write 1 gfb 0 n
end
if eq get gv 1 1
tailf tbbraw
tailf tbcraw
else
tailf tbraw
end
tailf trraw
if eq get gv 3 0
ret 0
end
ret 1
end
fn tailf t view uchar * to void
pbr t
lbtext ttl1
lbpb
lbtext ttl2
lbout
n = rdin 0
if gt n 4194304
ret
end
e = n
if and gt e 0 eq get gfb sub e 1 10
e = sub e 1
end
s = e
while and gt s 0 ne get gfb sub s 1 10 bound 4194304
s = sub s 1
end
for i ulong sub e s bound 4194304
m = get glbn 0
if lt m 8000
put glb m get gfb add s i
put glbn 0 add m 1
end
end
lbout
end

fn main to int
parse
mkdirs
prov
inputs
om2chk
for i ulong 7
mutate i
end
arms
armsha
identity
sizes
runs
ret finish
end

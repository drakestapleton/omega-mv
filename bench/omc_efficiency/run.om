note gpb: the path being built; gsl: argument slots (0 HERE, 1 OMC/BASE, 2 CAND, 3 R = OUTDIR, 4 W =
note OUTDIR/work, 5 SEED, 6 CPU, 7 build SEED); gpk: the exec packet; glb: the output line; gfb, gf2, gf3:
note whole files
global gpb uchar 4096
global gpbn ulong 1
global gsl uchar 32768
global gsln ulong 8
global gin uchar 4096
global ginn ulong 1
global gou uchar 4096
global goun ulong 1
global ger uchar 4096
global gern ulong 1
global gcd uchar 4096
global gcdn ulong 1
global gpk uchar 16384
global gpkn ulong 1
global gpkc ulong 1
global glb uchar 8192
global glbn ulong 1
global gfb uchar 4194304
global gf2 uchar 4194304
global gf3 uchar 4194304
global gst uchar 4
global gv ulong 16
note gv: 0 profile om2 (1) or om1 (0), 1 A/B (1), 2 provenance fd, 3 conductor failures, 8/9 the field
note fldset found (start, length), 10/11 mutant from (start, length), 12/13 mutant to (start, length)

note ---- path builder
fn pbclr to void
put gpbn 0 0
end
fn pbtext t view uchar * to void
n = get gpbn 0
if gt add n len t 4096
trap 9
end
for i ulong len t
put gpb add n i get t i
end
put gpbn 0 add n len t
end
fn pbset t view uchar * to void
pbclr
pbtext t
end
fn pbslot k ulong to void
n = get gpbn 0
m = get gsln k
if gt add n m 4096
trap 9
end
for i ulong m
put gpb add n i get gsl add shl k 12 i
end
put gpbn 0 add n m
end
fn setslot k ulong to void
n = get gpbn 0
for i ulong n
put gsl add shl k 12 i get gpb i
end
put gsln k n
end
fn pbnum v ulong to void
d = new uchar 24 0
p = ulong 24
x = v
while gt x 9
p = sub p 1
put d p uchar add rem x 10 48
x = div x 10
end
p = sub p 1
put d p uchar add x 48
n = get gpbn 0
for i ulong sub 24 p
put gpb add n i get d add p i
end
put gpbn 0 add n sub 24 p
end
note fldset: field i of t split at byte sep, into gv 8 (start) and gv 9 (length)
fn fldset t view uchar * sep ulong i ulong to void
k = ulong 0
s = ulong 0
for j ulong len t
if eq ulong get t j sep
if eq k i
put gv 8 s
put gv 9 sub j s
ret
end
k = add k 1
s = add j 1
end
end
if ne k i
trap 9
end
put gv 8 s
put gv 9 sub len t s
end
fn pbfld t view uchar * to void
s = get gv 8
m = get gv 9
n = get gpbn 0
if gt add n m 4096
trap 9
end
for i ulong m
put gpb add n i get t add s i
end
put gpbn 0 add n m
end
fn pbcase i ulong to void
fldset tcases 32 i
pbfld tcases
end
note P (om2/ under --profile om2) then the case name: the key of every row and file name
fn pbkey i ulong to void
if eq get gv 0 1
pbtext tom2s
end
pbcase i
end
note HERE/kernels/[om2/]CASE.om
fn pbkd i ulong to void
pbclr
pbslot 0
pbtext tkern
if eq get gv 0 1
pbtext tom2s
end
pbcase i
pbtext tom
end
fn pbw t view uchar * to void
pbclr
pbslot 4
pbtext t
end
fn pbr t view uchar * to void
pbclr
pbslot 3
pbtext t
end

note ---- the child's redirections: from gpb, or none (inherit) by clearing
fn setin to void
n = get gpbn 0
for i ulong n
put gin i get gpb i
end
put ginn 0 n
end
fn setout to void
n = get gpbn 0
for i ulong n
put gou i get gpb i
end
put goun 0 n
end
fn seterr to void
n = get gpbn 0
for i ulong n
put ger i get gpb i
end
put gern 0 n
end
fn setcd to void
n = get gpbn 0
for i ulong n
put gcd i get gpb i
end
put gcdn 0 n
end
fn nored to void
put ginn 0 0
put goun 0 0
put gern 0 0
put gcdn 0 0
end

note ---- exec packet: u16 count, then records (u16 length, bytes)
global gpinned ulong 1
fn pkreset to void
put gpinned 0 0
put gpk 0 0
put gpk 1 0
put gpkn 0 2
put gpkc 0 0
end
fn pkpush to void
n = get gpkn 0
m = get gpbn 0
if gt add add n m 2 16384
trap 9
end
put gpk n uchar and m 255
put gpk add n 1 uchar shr m 8
for i ulong m
put gpk add add n 2 i get gpb i
end
put gpkn 0 add add n m 2
c = add get gpkc 0 1
put gpkc 0 c
put gpk 0 uchar and c 255
put gpk 1 uchar shr c 8
end
fn pkt t view uchar * to void
pbset t
pkpush
end
fn pks k ulong to void
pbclr
pbslot k
pkpush
end
note pkline: a new packet, one record per space-separated word of t
fn pkline t view uchar * to void
pkreset
pbclr
for i ulong len t
c = get t i
if eq c 32
if gt get gpbn 0 0
pkpush
end
pbclr
else
put gpb get gpbn 0 c
put gpbn 0 add get gpbn 0 1
end
end
if gt get gpbn 0 0
pkpush
end
end

note ---- one child: optional cwd, stdin, stdout, stderr; exec gpk; returns the exit status (1000+signal)
note Pin only the conductor child, never provenance/build subprocesses or the coordinator.
fn selfpin to void
mask = new uchar 128 0
c = ulong 0
for i ulong get gsln 6
c = add mul c 10 ulong sub get gsl add shl ulong 6 12 i 48
end
if ge c 1024
exit 118
end
put mask div c 8 shl uchar 1 uchar rem c 8
r = cpuset 0 mask 0 128
if ne r 0
exit 118
end
note Preserve nice -n 19: raw getpriority is 20 minus nice, so the unclamped target is 39 minus raw.
old = getprio 0 0
if lt old 0
exit 118
end
want = sub long 39 old
if gt want 19
want = 19
end
r = setprio 0 0 int want
if ne r 0
exit 118
end
end
fn child to void
if gt get gcdn 0 0
r = chdir gcd 0 get gcdn 0
if ne r 0
exit 119
end
end
if gt get ginn 0 0
fi = fopen gin 0 get ginn 0 0 0
if lt fi 0
exit 120
end
r1 = dupfd int fi 0 0
if ne r1 0
exit 121
end
end
chout
if ne get gpinned 0 0
selfpin
end
r3 = execprog gpk 0 get gpkn 0
exit 126
end
fn chout to void
if gt get goun 0 0
fo = fopen gou 0 get goun 0 577 420
if lt fo 0
exit 122
end
r = dupfd int fo 1 0
if ne r 1
exit 123
end
end
if gt get gern 0 0
fe = fopen ger 0 get gern 0 577 420
if lt fe 0
exit 124
end
r2 = dupfd int fe 2 0
if ne r2 2
exit 125
end
end
end
fn runpk to ulong
pid = fork
if lt pid 0
trap 9
end
if eq pid 0
child
exit 127
end
r = waitpid int pid gst 0 4 0
if ne r pid
trap 9
end
s0 = ulong get gst 0
if ne and s0 127 0
ret add 1000 and s0 127
end
ret ulong get gst 1
end
note capture: stdin /dev/null, stdout W/cap.out, stderr W/cap.err; the output is read into gfb
fn capture to ulong
nored
pbset tnull
setin
pbw tcap
setout
pbw tcaperr
seterr
r = runpk
pbw tcap
n = rdin 0
if gt n 4194304
ret 0
end
ret n
end

note ---- files: rdin reads the file named by gpb into gfb, gf2 or gf3 (which 0, 1, 2); returns its size,
note 4194305 when it does not fit, 4194306 when it cannot be opened
fn rdin which ulong to ulong
fd = fopen gpb 0 get gpbn 0 0 0
if lt fd 0
ret 4194306
end
n = ulong 0
going = true
while going bound 999999999
r = rdpart fd n which
if le r 0
going = false
else
n = add n ulong r
if eq n 4194304
going = false
end
end
end
c = fclose int fd
if eq n 4194304
ret 4194305
end
ret n
end
fn rdpart fd long n ulong which ulong to long
if eq which 1
ret read int fd gf2 n sub 4194304 n
end
if eq which 2
ret read int fd gf3 n sub 4194304 n
end
ret read int fd gfb n sub 4194304 n
end
note write gfb or gf3 (which 0, 2) [0 .. n) to the file named by gpb with mode; false on failure
fn wrbuf which ulong n ulong mode int to bool
fd = fopen gpb 0 get gpbn 0 577 mode
if lt fd 0
ret false
end
w = wrpart fd n which
c = fclose int fd
if ne w long n
ret false
end
m = chmod gpb 0 get gpbn 0 mode
ret true
end
fn wrpart fd long n ulong which ulong to long
if eq which 2
ret write int fd gf3 0 n
end
ret write int fd gfb 0 n
end
fn die t view uchar * to void
w = write 2 erun 0 len erun
w2 = write 2 t 0 len t
w3 = write 2 gpb 0 get gpbn 0
w4 = write 2 tnl 0 1
exit 70
end
note die naming the path in gpb first (run: PATH: message)
fn diep t view uchar * to void
w = write 2 erun 0 len erun
w2 = write 2 gpb 0 get gpbn 0
w3 = write 2 t 0 len t
w4 = write 2 tnl 0 1
exit 70
end
note copy the file at gpb into gfb; cpto writes it to the path in gpb (mode 420)
fn cpfrom to ulong
n = rdin 0
if gt n 4194304
die ecopy
end
ret n
end
fn cpto n ulong to void
if not wrbuf 0 n 420
die ewrite
end
end
fn mkd to void
r = makedir gpb 0 get gpbn 0 493
if and lt r 0 ne r -17
die emkdir
end
end

note ---- the line buffer and provenance.txt (gv 2)
fn lbtext t view uchar * to void
n = get glbn 0
if gt add n len t 8192
trap 9
end
for i ulong len t
put glb add n i get t i
end
put glbn 0 add n len t
end
fn lbpb to void
n = get glbn 0
m = get gpbn 0
if gt add n m 8192
trap 9
end
for i ulong m
put glb add n i get gpb i
end
put glbn 0 add n m
end
fn lbslot k ulong to void
pbclr
pbslot k
lbpb
end
fn lbnum v ulong to void
pbclr
pbnum v
lbpb
end
note the first line of gfb[0 .. n) (without its LF); at most the first 64 bytes when hex64 is true
fn lbfirst n ulong hex64 bool to void
m = n
if and hex64 gt m 64
m = 64
end
k = get glbn 0
for i ulong m bound 4194304
c = get gfb i
if eq c 10
ret
end
if lt k 8000
put glb k c
k = add k 1
put glbn 0 k
end
end
end
fn lbto fd ulong to void
lbtext tnl
w = write int fd glb 0 get glbn 0
put glbn 0 0
end
fn lbpv to void
lbto get gv 2
end
fn lbout to void
lbto 1
end

note ---- arguments
fn argis idx ulong t view uchar * to bool
b = new uchar 4096 0
r = argread idx b 0 4096
if ne r long len t
ret false
end
for i ulong len t
if ne get b i get t i
ret false
end
end
ret true
end
fn usage to void
w = write 2 eusage 0 len eusage
exit 64
end
note slot k := argument idx, made absolute against the working directory when it does not start with /
fn absarg idx ulong k ulong to void
b = new uchar 4096 0
r = argread idx b 0 4096
if lt r 1
usage
end
pbclr
if ne get b 0 47
c = cwd gpb 0 4096
if lt c 2
die ecwd
end
put gpbn 0 sub ulong c 1
pbtext tslash
end
m = ulong r
n = get gpbn 0
if gt add n m 4096
usage
end
for i ulong m
put gpb add n i get b i
end
put gpbn 0 add n m
setslot k
end
note slot k := argument idx, which must be 1 .. 18 decimal digits (nonzero when nz is true)
fn numarg idx ulong k ulong nz bool to bool
b = new uchar 4096 0
r = argread idx b 0 4096
if or lt r 1 gt r 18
ret false
end
m = ulong r
z = true
for i ulong m
c = get b i
if or lt c 48 gt c 57
ret false
end
if ne c 48
z = false
end
end
if and nz z
ret false
end
pbclr
for j ulong m
put gpb j get b j
end
put gpbn 0 m
setslot k
ret true
end
fn txtslot t view uchar * k ulong to void
pbset t
setslot k
end
fn parse to void
ac = ulong argcnt
i = ulong 1
if lt ac 2
usage
end
if argis 1 tprof
if lt ac 3
usage
end
if argis 2 to2
put gv 0 1
else
if not argis 2 to1
w = write 2 eprof 0 len eprof
exit 64
end
end
i = 3
end
if lt i ac
if argis i tab
put gv 1 1
pab6 add i 1 ac
ret
end
end
pbase3 i ac
end
note --ab HERE BASE CAND SEED OUTDIR [CPU] from argument i
fn pab6 i ulong ac ulong to void
if or lt ac add i 5 gt ac add i 6
usage
end
absarg i 0
absarg add i 1 1
absarg add i 2 2
if not numarg add i 3 5 true
w = write 2 eseed 0 len eseed
exit 64
end
absarg add i 4 3
cpuarg add i 5 ac
pbclr
pbslot 5
setslot 7
end
note HERE OMC OUTDIR [CPU] from argument i
fn pbase3 i ulong ac ulong to void
if or lt ac add i 3 gt ac add i 4
usage
end
absarg i 0
absarg add i 1 1
absarg add i 2 3
cpuarg add i 3 ac
txtslot tseedb 5
txtslot tseedbb 7
end
fn cpuarg idx ulong ac ulong to void
if lt idx ac
if not numarg idx 6 false
w = write 2 ecpu 0 len ecpu
exit 64
end
else
txtslot t19 6
end
end

note ---- directories
note mkdir -p of the path in gpb: every proper prefix ending before a / is created when missing
fn mkp to void
n = get gpbn 0
for i ulong n
if and gt i 0 eq get gpb i 47
r = makedir gpb 0 i 493
end
end
mkd
end
fn mkdirs to void
pbclr
pbslot 3
n = get gpbn 0
for i ulong n
if and gt i 0 eq get gpb i 47
r = makedir gpb 0 i 493
end
end
r2 = makedir gpb 0 n 493
if eq r2 -17
w = write 2 eexist 0 len eexist
w2 = write 2 gpb 0 n
w3 = write 2 tnl 0 1
exit 64
end
if lt r2 0
die emkdir
end
pbtext twork
setslot 4
mkd
mkw tsrc
mkw twant
pbw tbin
mkd
pbw tbin
pbtext tneg
mkd
mkw2
pbw tobj
mkd
mkw tmut
pbr tdis
mkd
mkarms
end
note W/X and, under --profile om2, W/X/om2
fn mkw t view uchar * to void
pbw t
mkd
if eq get gv 0 1
pbtext tom2s
mkd
end
end
fn mkw2 to void
if eq get gv 0 1
pbw tbin
pbtext tneg
pbtext tslash
pbtext tom2s
mkd
end
end
fn mkarms to void
for a ulong narm 0
pbw tbin
pbarm 0 a
mkarm2
end
for o ulong narm 1
pbw tbin
pbtext tcO
pbarm 1 o
mkarm2
end
end
fn mkarm2 to void
mkd
if eq get gv 0 1
pbtext tslash
pbtext tom2s
mkd
end
end
note arm lists: kind 0 the omc arms (omc | omcB omcC), 1 the C optimisation levels (O2 O0 | O2)
fn narm kind ulong to ulong
if eq kind 0
if eq get gv 1 1
ret 2
end
ret 1
end
if eq get gv 1 1
ret 1
end
ret 2
end
fn pbarm kind ulong a ulong to void
if eq kind 0
if eq get gv 1 1
fldset toarmb 32 a
pbfld toarmb
else
fldset toarm 32 a
pbfld toarm
end
ret
end
if eq get gv 1 1
fldset tcarmb 32 a
pbfld tcarmb
else
fldset tcarm 32 a
pbfld tcarm
end
end

note ---- provenance
fn prov to void
pbr tprov
fd = fopen gpb 0 get gpbn 0 577 420
if lt fd 0
die eprov
end
put gv 2 ulong fd
pkline tdate
n = capture
lbtext pdate
lbfirst n false
lbpv
lbtext pmode
if eq get gv 1 1
lbtext pab
else
lbtext pbase
end
lbpv
lbtext pprof
if eq get gv 0 1
lbtext to2
else
lbtext to1
end
lbpv
prov2
prov3
prov4
end
fn prov2 to void
pkreset
pkt tgit
pkt tgC
pks 0
pkt trevp
pkt thead
n = capture
lbtext psrc
lbfirst n false
lbpv
pkreset
pkt tgit
pkt tgC
pks 0
pkt tgst
pkt tporc
pkt tdd
pkt tdot
n2 = capture
k = ulong 0
for i ulong n2 bound 4194304
if eq get gfb i 10
k = add k 1
end
end
lbtext pdirty
lbnum k
lbpv
lbtext pomc
lbslot 1
lbpv
lbtext pomcs
shaslot 1
lbpv
if eq get gv 1 1
lbtext pcand
lbslot 2
lbpv
lbtext pcands
shaslot 2
lbpv
end
end
note the SHA-256 (64 hex digits) of the file named by slot k, or of HERE/NAME (shahere), onto glb
fn shaslot k ulong to void
pkreset
pkt tsha
pks k
n = capture
lbfirst n true
end
fn shahere t view uchar * to void
pkreset
pkt tsha
pbclr
pbslot 0
pbtext tslash
pbtext t
pkpush
n = capture
lbfirst n true
end
fn prov3 to void
lbtext pp1
shahere tprot1
lbpv
lbtext pp2
shahere tprot2
lbpv
lbtext pp3
shahere tprot3
lbpv
lbtext pp4
shahere tprot4
lbpv
pkline tgccv
n = capture
lbtext pgcc
lbfirst n false
lbpv
pkline tperfv
n2 = capture
lbtext pperf
lbfirst n2 false
lbpv

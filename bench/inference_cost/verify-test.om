r = vtrun vtt8 vtt10
vtwant r 2
vtcandidate vtt8 vtt9
end
fn vteof fd int to bool
st = new uchar 128 0
r = fseek fd 0 1
if lt r 0
vxfail 62
end
f = fstat fd st 0 128
if ne f 0
vxfail 62
end
size = ulong 0
for j ulong 8
v = ulong get st add j 48
shift = mul j 8
size = or size shl v shift
end
ret eq ulong r size
end
fn vtmutate which ulong to void
b = new uchar 4096 0
vtpath 29 vtt22
fi = vxopen 22 0
fo = vxopen 29 577
hits = ulong 0
while true bound 9223372036854775807
n = vxline fi b
if eq n 0
note Keep blank lines; EOF is distinguished using current offset and fstat below by a byte probe.
if vteof fi
break
end
end
match = false
if eq which 1
match = vxequal part b 0 n vtt23
end
if eq which 2
match = vxequal part b 0 n vtt24
end
if eq which 3
match = vxequal part b 0 n vtt25
end
if match
vxwrite fo vtt26
hits = add hits 1
else
vxwrite fo part b 0 n
vxwrite fo vxnl
end
end
vxclose fi
vxclose fo
if eq hits 0
vxfail 62
end
end
fn vtlink name view uchar * to void
vxset 28 vtt27
vxadd 28 name
vtpath 29 vtt28
vxadd 29 name
vtsetup
vxpkinit
vxpk vtt19
vxpk vtt20
vxpkpath 28
vxpkpath 29
r = vxspawn
vtwant r 0
end
fn vtnosandbox to bool
b = new uchar 4096 0
vtpath 28 vtt29
mr = makedir vxp mul ulong 28 4096 get vxplen 28 448
if ne mr 0
vxfail 63

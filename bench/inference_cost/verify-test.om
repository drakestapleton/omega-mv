fn vxfail n int to void
r = write 2 vxerr 0 len vxerr
exit n
end
fn vxset k ulong a view uchar * to void
if ge len a 4096
vxfail 2
end
for i ulong len a
put vxp add mul k 4096 i get a i
end
put vxplen k len a
end
fn vxcopy k ulong j ulong to void
ko = mul k 4096
jo = mul j 4096
for i ulong get vxplen j
v = get vxp add jo i
put vxp add ko i v
end
put vxplen k get vxplen j
end
fn vxadd k ulong a view uchar * to void
n = get vxplen k
if ge add n len a 4096
vxfail 2
end
for i ulong len a
put vxp add add mul k 4096 n i get a i
end
put vxplen k add n len a
end
fn vxdecimal k ulong n ulong to void
b = new uchar 20 0
p = ulong 20
v = n
while true bound 20
p = sub p 1
put b p uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
vxadd k part b p sub 20 p
end
fn vxarg i ulong k ulong to void
r = argread add i get vxshift 0 vxp mul k 4096 4095
if lt r 1
vxfail 2
end
put vxplen k ulong r
end
fn vxopen k ulong flags int to int
r = fopen vxp mul k 4096 get vxplen k flags 384
if lt r 0
vxfail 3
end
ret int r
end
fn vxclose fd int to void
r = fclose fd
if ne r 0
vxfail 3
end
end
fn vxwrite fd int a view uchar * to void
p = ulong 0
while lt p len a bound 9223372036854775807
r = write fd a p sub len a p
if le r 0
vxfail 3
end
p = add p ulong r
end
end
fn vxpkinit to void
put vxpn 0 2
put vxpn 1 0
end
fn vxpk a view uchar * to void
n = get vxpn 0
if gt add add n 2 len a 65536
vxfail 2
end
put vxpacket n uchar and len a 255
put vxpacket add n 1 uchar shr len a 8
for i ulong len a
put vxpacket add add n 2 i get a i
end
put vxpn 0 add add n 2 len a
put vxpn 1 add get vxpn 1 1
end
fn vxpkpath k ulong to void
b = new uchar 4096 0
n = get vxplen k
for i ulong n
put b i get vxp add mul k 4096 i
end
vxpk part b 0 n
end
fn vxspawn to ulong
put vxpacket 0 uchar and get vxpn 1 255
put vxpacket 1 uchar shr get vxpn 1 8
pid = fork
if lt pid 0
vxfail 3
end
if eq pid 0
f0 = vxopen 6 0
f1 = vxopen 7 577
f2 = vxopen 8 577
r0 = dupfd f0 0 0
r1 = dupfd f1 1 0
r2 = dupfd f2 2 0
if or or ne r0 0 ne r1 1 ne r2 2
exit 126
end
r = execenv vxpacket 0 get vxpn 0 vxenv 0 get vxenvn 0
exit 126
end
w = waitpid int pid vxstatus 0 4 0
if ne w pid
vxfail 3
end
if ne and get vxstatus 0 127 0
ret add ulong 256 ulong get vxstatus 0
end
ret ulong get vxstatus 1
end
fn vxequal a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a
if ne get a i get b i
ret false
end
end
ret true
end
note line reader: overlong lines are protocol-invalid; payloads are byte-counted and stream separately.
fn vxline fd int b edit uchar * to ulong
one = new uchar 1 0
n = ulong 0
while true bound 9223372036854775807
r = read fd one 0 1
if lt r 0
vxfail 3
end
if eq r 0
if eq n 0
ret 0
end
vxfail 2
end
if eq get one 0 10
ret n
end
if eq n len b
vxfail 2
end
put b n get one 0
n = add n 1
end
ret 0
end
fn vxenvinit to void
b = new uchar 4096 0
for i ulong ulong envcnt
n = envread i b 0 len b
if ge n 5
if vxequal part b 0 5 vxpathkey
if gt n 4090
vxfail 2
end
put vxenv 0 1
put vxenv 1 0
put vxenv 2 uchar and ulong n 255
put vxenv 3 uchar shr ulong n 8
for j ulong ulong n
put vxenv add j 4 get b j
end
put vxenvn 0 add ulong n 4
ret
end
end
end
vxfail 2
end

note Args: ROOT ABS_WORK. Every new check has a removal mutant.
text vtpinbad "OMC=/dev/null"
text vtinvalid "not a program\n"
text vtbadfile "/refused.om"
fn vtbadpin to void
n = get vxenvn 0
put vxenv 0 2
put vxenv n uchar len vtpinbad
put vxenv add n 1 0
for i ulong len vtpinbad
put vxenv add add n 2 i get vtpinbad i
end
put vxenvn 0 add add n 2 len vtpinbad
r = vtrun vtt8 vtt10
vtwant r 3
vxenvinit
vtpath 23 vtbadfile
vtput 23 vtinvalid
r = vtrun vtt8 vtt10
vtwant r 1
end
fn vtstdout a view uchar * to void
vxwrite 1 a
end
fn vtsetup to void
vxset 6 vxnull
vxcopy 7 21
vxadd 7 vtt0
vxcopy 8 21
vxadd 8 vtt1
end
fn vtcommand2 cmd view uchar * a ulong b ulong to ulong
vtsetup
vxpkinit
vxpk cmd
vxpkpath a
vxpkpath b
ret vxspawn
end
fn vtcopy src ulong dst ulong to void
r = vtcommand2 vtt2 src dst
if ne r 0
vxfail 60
end
end
fn vtput k ulong a view uchar * to void
fd = vxopen k 577
vxwrite fd a
vxclose fd
end
fn vtpath k ulong suffix view uchar * to void
vxcopy k 21
vxadd k suffix
end
fn vtrun lang view uchar * task view uchar * to ulong
vtsetup
vtpath 24 vtt3
vxdecimal 24 get vxcounts 9
put vxcounts 9 add get vxcounts 9 1
vxpkinit
vxpk vxshell
vxpkpath 22
vxpk vtt4
vxpk lang
vxpk task
vxpkpath 23
vxpkpath 24
ret vxspawn
end
fn vtwant actual ulong expected ulong to void
if ne actual expected
vtstdout vtt5
vxfail 61
end
put vxcounts 4 add get vxcounts 4 1
end
fn vtcontains k ulong needle view uchar * to bool
b = new uchar 4096 0
fd = vxopen k 0
found = false
while true bound 9223372036854775807
n = vxline fd b
if eq n 0
break
end
if ge n len needle
for i ulong add sub n len needle 1
if vxequal part b i len needle needle
found = true
end
end
end
end
vxclose fd
ret found
end
fn vtcandidate lang view uchar * kind view uchar * to void
vxcopy 23 20
vxadd 23 vtt6
vxadd 23 kind
vxadd 23 vtt7
vxadd 23 lang
end

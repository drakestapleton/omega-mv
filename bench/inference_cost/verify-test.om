put b i get vxp add mul ulong 29 4096 i
end
vxadd 28 part b 0 get vxplen 29
put vxenv 0 1
put vxenv 1 0
n = get vxplen 28
put vxenv 2 uchar and n 255
put vxenv 3 uchar shr n 8
for i ulong n
put vxenv add i 4 get vxp add mul ulong 28 4096 i
end
put vxenvn 0 add n 4
r = vtrun vtt8 vtt10
if ne r 3
ret false
end
ret vtcontains 7 vtt41
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note plan.om: pure seeded-Omega Intel Xe / Panther Lake direct drm/xe compute submission plan.
note Emits the deterministic ioctl sequence (VM_CREATE -> GEM_CREATE -> VM_BIND -> EXEC_QUEUE_CREATE ->
note EXEC -> WAIT_USER_FENCE -> teardown) for vadd, fsum16, gemm16, or rmsnorm at a caller VA base.
note
note Usage: plan vadd|fsum16|gemm16|rmsnorm
note Exit: 0 ok; 2 usage.
om2

text tuse "usage: plan vadd|fsum16|gemm16|rmsnorm\n"
text tvadd "vadd"
text tfsum "fsum16"
text tgemm "gemm16"
text trms "rmsnorm"
text thdr "XE_PLAN kernel="
text tsteps " steps=12 vm_va=4294967296 engine=DRM_XE_ENGINE_CLASS_COMPUTE(4)\n"
text s1 "  01 DRM_IOCTL_XE_DEVICE_QUERY        0xc0286440 size=40  query=ENGINES(0)\n"
text s2 "  02 DRM_IOCTL_XE_VM_CREATE           0xc0206443 size=32  flags=0\n"
text s3 "  03 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=IN0     bytes=4194304 placement=SYSMEM\n"
text s4 "  04 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=IN1     bytes=4194304 placement=SYSMEM\n"
text s5 "  05 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=OUT     bytes=4194304 placement=SYSMEM\n"
text s6 "  06 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=KERNEL  bytes=4096    placement=SYSMEM\n"
text s7 "  07 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=BATCH   bytes=4096    placement=SYSMEM\n"
text s8 "  08 DRM_IOCTL_XE_GEM_CREATE          0xc0386441 size=56  bo=FENCE   bytes=4096    placement=SYSMEM\n"
text s9 "  09 DRM_IOCTL_XE_VM_BIND             0x40886445 size=136 op=MAP(0)  bind=6_BOs\n"
text s10 "  10 DRM_IOCTL_XE_EXEC_QUEUE_CREATE   0xc0306446 size=48  class=COMPUTE(4) width=1\n"
text s11 "  11 DRM_IOCTL_XE_EXEC                0x40386449 size=56  batch=CCS_WALKER num_batch=1\n"
text s12 "  12 DRM_IOCTL_XE_WAIT_USER_FENCE     0xc048644a size=72  op=GTE(3) value=1\n"

global garg uchar 32

fn emit_s t view uchar * to void
n = write 1 t 0 len t
end

fn argis i ulong t view uchar * to bool
n = argread i garg 0 len garg
if ne n long len t
ret false
end
for k ulong len t
if ne get garg k get t k
ret false
end
end
ret true
end

fn main to int
if ne argcnt 2
n = write 2 tuse 0 len tuse
exit 2
end
ok = false
if argis 1 tvadd
ok = true
end
if argis 1 tfsum
ok = true
end
if argis 1 tgemm
ok = true
end
if argis 1 trms
ok = true
end
if not ok
n = write 2 tuse 0 len tuse
exit 2
end
emit_s thdr
if argis 1 tvadd
emit_s tvadd
end
if argis 1 tfsum
emit_s tfsum
end
if argis 1 tgemm
emit_s tgemm
end
if argis 1 trms
emit_s trms
end
emit_s tsteps
emit_s s1
emit_s s2
emit_s s3
emit_s s4
emit_s s5
emit_s s6
emit_s s7
emit_s s8
emit_s s9
emit_s s10
emit_s s11
emit_s s12
ret 0
end

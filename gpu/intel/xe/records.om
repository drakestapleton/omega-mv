note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note records.om: pure seeded-Omega Linux drm/xe ioctl wire-record serializer (mirrors gpu/amd/kfd/records.om).
note Usage: records TABLE RECORD_INDEX [FIELD_VALUE ...]
note Serializes the indexed record from requests.tsv to stdout in little-endian wire format.
note No field values -> zero-filled record. Otherwise one unsigned decimal value per scalar field slot.
note Exit: 0 emitted; 2 bad numeric input; 3 malformed table/record; 64 usage; 74 I/O error.
om2

global gpath uchar 4096
global garg uchar 64
global gbuf uchar 256
global grb uchar 1
global grfd int 1

fn rbyte to ulong
r = read get grfd 0 grb 0 1
if eq r 0
ret 256
end
if ne r 1
exit 74
end
ret ulong get grb 0
end

fn tnum to ulong
c = rbyte
while true bound 999999
if eq c 256
exit 3
end
if eq c 35
while ne c 10 bound 999999
c = rbyte
if eq c 256
exit 3
end
end
c = rbyte
continue
end
if or eq c 32 or eq c 9 or eq c 10 eq c 13
c = rbyte
continue
end
break
end
if or lt c 48 gt c 57
exit 3
end
v = sub c 48
while true bound 999999
c = rbyte
if eq c 256
ret v
end
if eq c 35
while ne c 10 bound 999999
c = rbyte
if eq c 256
ret v
end
end
ret v
end
if or eq c 32 or eq c 9 or eq c 10 eq c 13
ret v
end
if or lt c 48 gt c 57
exit 3
end
v = add mul v 10 sub c 48
end
ret v
end

fn parseu ai ulong to ulong
n = argread ai garg 0 len garg
if or le n 0 gt n 20
exit 2
end
v = ulong 0
for i ulong ulong n
c = get garg i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn putle off ulong w ulong v ulong to void
for k ulong w
put gbuf add off k uchar and shr v mul k 8 255
end
end

fn skip_recs want ulong to void
rec = ulong 0
while lt rec want bound 256
req = tnum
sz = tnum
nf = tnum
for i ulong nf
o = tnum
w = tnum
cnt = tnum
end
rec = add rec 1
end
end

fn valid_w w ulong to bool
if eq w 1
ret true
end
if eq w 2
ret true
end
if eq w 4
ret true
end
ret eq w 8
end

fn read_fields sz ulong nf ulong ac long to void
has_vals = gt ac 3
ai = ulong 3
for i ulong nf
o = tnum
w = tnum
cnt = tnum
if not valid_w w
exit 3
end
if gt add o mul w cnt sz
exit 3
end
for k ulong cnt
if has_vals
if ge long ai ac
exit 2
end
putle add o mul k w w parseu ai
ai = add ai 1
end
end
end
if and has_vals ne long ai ac
exit 2
end
end

fn main to int
ac = argcnt
if lt ac 3
exit 64
end
pn = argread 1 gpath 0 len gpath
if le pn 0
exit 64
end
fd = fopen gpath 0 ulong pn 0 0
if lt fd 0
exit 74
end
put grfd 0 int fd
skip_recs parseu 2
req = tnum
sz = tnum
nf = tnum
if or eq sz 0 gt sz 256
c = fclose int fd
exit 3
end
for i ulong sz
put gbuf i 0
end
read_fields sz nf ac
c = fclose int fd
wr = write 1 gbuf 0 sz
if ne wr long sz
exit 74
end
ret 0
end

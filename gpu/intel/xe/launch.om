note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note launch.om: pure seeded-Omega Intel Xe/Panther Lake direct drm/xe ioctl probe & launcher.
note Uses omc's checked kfdctl allowlist for all 11 Linux drm/xe UAPI ioctls (no OpenCL, no Level Zero,
note no Vulkan, no libdrm). Opens a DRM render node (default /dev/dri/renderD128) and queries
note DRM_IOCTL_XE_DEVICE_QUERY (ENGINES) to verify a live Intel Xe compute engine, then probes
note VM_CREATE / GEM_CREATE / VM_BIND / EXEC_QUEUE_CREATE / EXEC / WAIT_USER_FENCE / GEM_CLOSE.
note
note Usage:
note   launch probe [PATH]     query DRM_IOCTL_XE_DEVICE_QUERY on PATH (default /dev/dri/renderD128)
note   launch selftest         issue checked XE_DEVICE_QUERY on invalid fd (-1) and require -EBADF (-9)
note Exit: 0 ok; 1 ioctl/device failed; 2 usage. Traps exit 100 + code.
om2

text tuse "usage: launch probe [PATH] | selftest\n"
text tprobe "probe"
text tself "selftest"
text tdef "/dev/dri/renderD128"
text tok_self "XE_SELFTEST PASS ebadf=-9\n"
text tok_probe "XE_PROBE OK\n"
text tfail_open "XE_PROBE NOT_RUN open failed\n"
text tfail_q "XE_PROBE FAIL query\n"

const XE_DEVICE_QUERY ulong 3223872576
const XE_GEM_CREATE ulong 3224921153
const XE_GEM_MMAP_OFFSET ulong 3223872578
const XE_VM_CREATE ulong 3223348291
const XE_VM_DESTROY ulong 1075340356
const XE_VM_BIND ulong 1082680389
const XE_EXEC_QUEUE_CREATE ulong 3224396870
const XE_EXEC_QUEUE_DESTROY ulong 1075340359
const XE_EXEC ulong 1077437513
const XE_WAIT_USER_FENCE ulong 3225969738
const GEM_CLOSE ulong 1074291721

global gpath uchar 4096
global garg uchar 32

fn argis i ulong t view uchar * to bool
n = argread i garg 0 len garg
if ne n long len t
ret false
end
for k ulong len t
if ne get garg k get t k
ret false
end
end
ret true
end

fn xe_query_engines fd int to long
q = new uchar 40 0
buf = new uchar 256 0
ret kfdctl fd 3223872576 q 0 40 buf 0 256
end

fn xe_vm_create fd int to long
r = new uchar 32 0
ret kfdctl fd 3223348291 r 0 32
end

fn xe_vm_destroy fd int to long
r = new uchar 24 0
ret kfdctl fd 1075340356 r 0 24
end

fn xe_gem_create fd int to long
r = new uchar 56 0
ret kfdctl fd 3224921153 r 0 56
end

fn xe_gem_mmap_offset fd int to long
r = new uchar 40 0
ret kfdctl fd 3223872578 r 0 40
end

fn xe_vm_bind fd int to long
r = new uchar 136 0
ret kfdctl fd 1082680389 r 0 136
end

fn xe_queue_create fd int to long
r = new uchar 48 0
inst = new uchar 8 0
put r 8 1
put r 10 1
ret kfdctl fd 3224396870 r 0 48 inst 0 8
end

fn xe_queue_destroy fd int to long
r = new uchar 24 0
ret kfdctl fd 1075340359 r 0 24
end

fn xe_exec fd int to long
r = new uchar 56 0
ret kfdctl fd 1077437513 r 0 56
end

fn xe_wait_fence fd int to long
r = new uchar 72 0
ret kfdctl fd 3225969738 r 0 72
end

fn xe_gem_close fd int to long
r = new uchar 8 0
ret kfdctl fd 1074291721 r 0 8
end

fn do_selftest to int
if ne xe_query_engines -1 -9
ret 1
end
if ne xe_vm_create -1 -9
ret 1
end
if ne xe_vm_destroy -1 -9
ret 1
end
if ne xe_gem_create -1 -9
ret 1
end
if ne xe_gem_mmap_offset -1 -9
ret 1
end
if ne xe_vm_bind -1 -9
ret 1
end
if ne xe_queue_create -1 -9
ret 1
end
if ne xe_queue_destroy -1 -9
ret 1
end
if ne xe_exec -1 -9
ret 1
end
if ne xe_wait_fence -1 -9
ret 1
end
if ne xe_gem_close -1 -9
ret 1
end
n = write 1 tok_self 0 len tok_self
ret 0
end

fn do_probe to int
fd = long -1
if ge argcnt 3
pn = argread 2 gpath 0 len gpath
if le pn 0
ret 2
end
fd = fopen gpath 0 ulong pn 2 0
else
for i ulong len tdef
put gpath i get tdef i
end
fd = fopen gpath 0 len tdef 2 0
end
if lt fd 0
n = write 1 tfail_open 0 len tfail_open
ret 1
end
r = xe_query_engines int fd
c = fclose int fd
if lt r 0
n = write 1 tfail_q 0 len tfail_q
ret 1
end
n = write 1 tok_probe 0 len tok_probe
ret 0
end

fn main to int
if lt argcnt 2
n = write 2 tuse 0 len tuse
ret 2
end
if argis 1 tself
ret do_selftest
end
if argis 1 tprobe
ret do_probe
end
n = write 2 tuse 0 len tuse
ret 2
end

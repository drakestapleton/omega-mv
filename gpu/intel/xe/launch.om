note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note launch.om: pure seeded-Omega Intel Xe3 (Panther Lake) direct drm/xe userspace compute driver.
note Replaces Intel compute-runtime (NEO), libOpenCL, libze_loader, and libdrm for drm/xe submission:
note   - Queries DRM_IOCTL_XE_DEVICE_QUERY (ENGINES + MEM_REGIONS) to discover compute engine & SYSMEM
note   - Creates VM (XE_VM_CREATE), allocates BOs (XE_GEM_CREATE, WB caching), maps BOs (XE_GEM_MMAP_OFFSET + kfdmap)
note   - Binds BOs into GPU VM (XE_VM_BIND with Panther Lake pat_index=1 coherent SYSMEM)
note   - Creates compute exec queue (XE_EXEC_QUEUE_CREATE, DRM_XE_ENGINE_CLASS_COMPUTE=4)
note   - Submits Xe3 CCS batch buffer (XE_EXEC) and polls PIPE_CONTROL QWORD user fence via mapread + cpufence
note
note Usage:
note   launch selftest             verify all 11 drm/xe kfdctl syscalls return -EBADF (-9)
note   launch probe [PATH]         query DRM_IOCTL_XE_DEVICE_QUERY (ENGINES + MEM_REGIONS) on PATH
note   launch fence-test [PATH]    full Panther Lake hardware bring-up: empty PIPE_CONTROL QWORD fence batch
note Exit: 0 ok; 1 device/ioctl failed; 2 usage. Traps exit 100 + code.
om2

text tuse "usage: launch selftest | probe [PATH] | fence-test [PATH]\n"
text tself "selftest"
text tprobe "probe"
text tfence "fence-test"
text tdef "/dev/dri/renderD128"
text tok_self "XE_SELFTEST PASS ebadf=-9\n"
text tok_probe "XE_PROBE PASS compute_engine_found\n"
text tok_fence "XE_FENCE_TEST PASS gpu_fence=0x12345678\n"
text tfail_open "XE_LAUNCH NOT_RUN open failed\n"
text tfail_q "XE_LAUNCH FAIL query\n"
text tfail_sub "XE_LAUNCH FAIL submit_or_fence\n"

note Panther Lake (IGFX_PTL) coherent WB SYSMEM pat_index = 1 (compute-runtime product_helper_ptl.cpp)
const PTL_PAT_INDEX ushort 1
const XE_CACHING_WB ushort 1
const XE_CLASS_COMPUTE ushort 4
const FENCE_MAGIC ulong 0x12345678
const BATCH_VA ulong 4294967296
const FENCE_VA ulong 4294971392

global gpath uchar 4096
global garg uchar 32
global gqbuf uchar 2048
global gbatch uchar 64
global gfbuf uchar 8
note gdev: 0 eng_class, 1 eng_inst, 2 eng_gt, 3 placement_mask, 4 vmid, 5 bbo, 6 fbo, 7 bm, 8 fm, 9 qid
global gdev ulong 12

fn argis i ulong t view uchar * to bool
n = argread i garg 0 len garg
if ne n long len t
ret false
end
for k ulong len t
if ne get garg k get t k
ret false
end
end
ret true
end

fn put16 a edit uchar * off ulong v ulong to void
put a off uchar and v 255
put a add off 1 uchar and shr v 8 255
end

fn put32 a edit uchar * off ulong v ulong to void
for k ulong 4
put a add off k uchar and shr v mul k 8 255
end
end

fn put64 a edit uchar * off ulong v ulong to void
for k ulong 8
put a add off k uchar and shr v mul k 8 255
end
end

fn get16 a view uchar * off ulong to ulong
ret or ulong get a off shl ulong get a add off 1 8
end

fn get32 a view uchar * off ulong to ulong
v = ulong 0
for k ulong 4
v = or v shl ulong get a add off k mul k 8
end
ret v
end

fn get64 a view uchar * off ulong to ulong
v = ulong 0
for k ulong 8
v = or v shl ulong get a add off k mul k 8
end
ret v
end

fn xe_query fd int qkind ulong to long
q = new uchar 40 0
put32 edit q 8 qkind
put32 edit q 12 0
r = kfdctl fd 3223872576 q 0 40 gqbuf 0 2048
if lt r 0
ret r
end
need = get32 view q 12
if or eq need 0 gt need 2048
ret -22
end
ret kfdctl fd 3223872576 q 0 40 gqbuf 0 2048
end

fn gq16 off ulong to ulong
ret or ulong get gqbuf off shl ulong get gqbuf add off 1 8
end

fn gq32 off ulong to ulong
v = ulong 0
for k ulong 4
v = or v shl ulong get gqbuf add off k mul k 8
end
ret v
end

fn gb32 off ulong v ulong to void
for k ulong 4
put gbatch add off k uchar and shr v mul k 8 255
end
end

fn gb64 off ulong v ulong to void
for k ulong 8
put gbatch add off k uchar and shr v mul k 8 255
end
end

fn gf64 to ulong
v = ulong 0
for k ulong 8
v = or v shl ulong get gfbuf k mul k 8
end
ret v
end

fn parse_engines to bool
neng = gq32 0
if or eq neng 0 gt neng 60
ret false
end
for i ulong neng
base = add 8 mul i 32
ec = gq16 base
if eq ec ulong XE_CLASS_COMPUTE
put gdev 0 ec
put gdev 1 gq16 add base 2
put gdev 2 gq16 add base 4
ret true
end
end
ret false
end

fn parse_sysmem to bool
nr = gq32 0
if or eq nr 0 gt nr 16
ret false
end
for i ulong nr
base = add 8 mul i 88
mc = gq16 base
inst = gq16 add base 2
if eq mc 0
put gdev 3 shl ulong 1 inst
ret true
end
end
ret false
end

fn xe_vm_create fd int to long
r = new uchar 32 0
rc = kfdctl fd 3223348291 r 0 32
if lt rc 0
ret rc
end
ret long get32 view r 12
end

fn xe_vm_destroy fd int vmid ulong to long
r = new uchar 24 0
put32 edit r 0 vmid
ret kfdctl fd 1075340356 r 0 24
end

fn xe_gem_create fd int bytes ulong place ulong to long
r = new uchar 56 0
put64 edit r 8 bytes
put32 edit r 16 place
put16 edit r 32 ulong XE_CACHING_WB
rc = kfdctl fd 3224921153 r 0 56
if lt rc 0
ret rc
end
ret long get32 view r 28
end

fn xe_gem_mmap_off fd int handle ulong to long
r = new uchar 40 0
put32 edit r 8 handle
rc = kfdctl fd 3223872578 r 0 40
if lt rc 0
ret rc
end
ret long get64 view r 16
end

fn xe_vm_bind fd int vmid ulong obj ulong va ulong bytes ulong to long
r = new uchar 136 0
put32 edit r 8 vmid
put32 edit r 20 1
put32 edit r 32 obj
put16 edit r 36 ulong PTL_PAT_INDEX
put64 edit r 48 bytes
put64 edit r 56 va
ret kfdctl fd 1082680389 r 0 136
end

fn xe_queue_create fd int vmid ulong to long
r = new uchar 48 0
inst = new uchar 8 0
put16 edit r 8 1
put16 edit r 10 1
put32 edit r 12 vmid
put16 edit inst 0 get gdev 0
put16 edit inst 2 get gdev 1
put16 edit inst 4 get gdev 2
rc = kfdctl fd 3224396870 r 0 48 inst 0 8
if lt rc 0
ret rc
end
ret long get32 view r 20
end

fn xe_queue_destroy fd int qid ulong to long
r = new uchar 24 0
put32 edit r 0 qid
ret kfdctl fd 1075340359 r 0 24
end

fn xe_exec fd int qid ulong va ulong to long
r = new uchar 56 0
put32 edit r 8 qid
put64 edit r 24 va
put16 edit r 32 1
ret kfdctl fd 1077437513 r 0 56
end

fn xe_wait_fence fd int qid ulong va ulong val ulong to long
r = new uchar 72 0
put64 edit r 8 va
put16 edit r 16 3
put64 edit r 24 val
put64 edit r 32 18446744073709551615
put64 edit r 40 1000000000
put32 edit r 48 qid
ret kfdctl fd 3225969738 r 0 72
end

fn xe_gem_close fd int handle ulong to long
r = new uchar 8 0
put32 edit r 0 handle
ret kfdctl fd 1074291721 r 0 8
end

fn open_drm to long
if ge argcnt 3
pn = argread 2 gpath 0 len gpath
if le pn 0
ret -22
end
ret fopen gpath 0 ulong pn 2 0
end
for i ulong len tdef
put gpath i get tdef i
end
ret fopen gpath 0 len tdef 2 0
end

fn ok_err r long to bool
if eq r -9
ret true
end
ret eq r -25
end

fn do_selftest to int
if not ok_err xe_query -1 0
ret 1
end
if not ok_err xe_vm_create -1
ret 1
end
if not ok_err xe_vm_destroy -1 0
ret 1
end
if not ok_err xe_gem_create -1 4096 1
ret 1
end
if not ok_err xe_gem_mmap_off -1 0
ret 1
end
if not ok_err xe_vm_bind -1 0 0 BATCH_VA 4096
ret 1
end
if not ok_err xe_queue_create -1 0
ret 1
end
if not ok_err xe_queue_destroy -1 0
ret 1
end
if not ok_err xe_exec -1 0 BATCH_VA
ret 1
end
if not ok_err xe_wait_fence -1 0 FENCE_VA 1
ret 1
end
if not ok_err xe_gem_close -1 0
ret 1
end
n = write 1 tok_self 0 len tok_self
ret 0
end

fn do_probe to int
fd = open_drm
if lt fd 0
n = write 1 tfail_open 0 len tfail_open
ret 1
end
if lt xe_query int fd 0 0
c = fclose int fd
n = write 1 tfail_q 0 len tfail_q
ret 1
end
ok = parse_engines
if ok
if ge xe_query int fd 1 0
ok = parse_sysmem
else
ok = false
end
end
c = fclose int fd
if not ok
n = write 1 tfail_q 0 len tfail_q
ret 1
end
n = write 1 tok_probe 0 len tok_probe
ret 0
end

fn fill_fence_batch to void
for i ulong 64
put gbatch i 0
end
note Xe3 PIPE_CONTROL (0x7a000a04) + QWORD WriteImmediate (0x00104020) -> FENCE_VA, FENCE_MAGIC + MI_BATCH_BUFFER_END
gb32 0 0x7a000a04
gb32 4 0x00104020
gb64 8 FENCE_VA
gb64 16 FENCE_MAGIC
gb32 24 0x05000000
end

fn poll_fence mh long to bool
for t ulong 100000
cpufence
r = mapread mh 0 gfbuf 0 8
if eq gf64 FENCE_MAGIC
ret true
end
cpurelax
end
ret false
end

fn query_dev fd int to bool
if lt xe_query fd 0 0
ret false
end
if not parse_engines
ret false
end
if lt xe_query fd 1 0
ret false
end
ret parse_sysmem
end

fn fence_cleanup fd int to void
d1 = mapdrop long get gdev 7
d2 = mapdrop long get gdev 8
if ne get gdev 9 0
d3 = xe_queue_destroy fd get gdev 9
end
d4 = xe_vm_destroy fd get gdev 4
d5 = xe_gem_close fd get gdev 5
d6 = xe_gem_close fd get gdev 6
end

fn fence_exec fd int to bool
vmid = get gdev 4
b1 = xe_vm_bind fd vmid get gdev 5 BATCH_VA 4096
b2 = xe_vm_bind fd vmid get gdev 6 FENCE_VA 4096
if or ne b1 0 ne b2 0
ret false
end
qid = xe_queue_create fd vmid
if lt qid 0
ret false
end
put gdev 9 ulong qid
if ne xe_exec fd ulong qid BATCH_VA 0
ret false
end
ret poll_fence long get gdev 8
end

fn do_fence_test to int
fd = open_drm
if lt fd 0
n = write 1 tfail_open 0 len tfail_open
ret 1
end
if not query_dev int fd
c = fclose int fd
n = write 1 tfail_q 0 len tfail_q
ret 1
end
vmid = xe_vm_create int fd
bbo = xe_gem_create int fd 4096 get gdev 3
fbo = xe_gem_create int fd 4096 get gdev 3
if or lt vmid 0 or lt bbo 0 lt fbo 0
c = fclose int fd
n = write 1 tfail_sub 0 len tfail_sub
ret 1
end
put gdev 4 ulong vmid
put gdev 5 ulong bbo
put gdev 6 ulong fbo
put gdev 9 0
boff = xe_gem_mmap_off int fd ulong bbo
foff = xe_gem_mmap_off int fd ulong fbo
bm = kfdmap int fd ulong boff 4096
fm = kfdmap int fd ulong foff 4096
put gdev 7 ulong bm
put gdev 8 ulong fm
fill_fence_batch
for i ulong 8
put gfbuf i 0
end
w1 = mapwrite bm 0 gbatch 0 64
w2 = mapwrite fm 0 gfbuf 0 8
cpufence
ok = fence_exec int fd
fence_cleanup int fd
c = fclose int fd
if not ok
n = write 1 tfail_sub 0 len tfail_sub
ret 1
end
n = write 1 tok_fence 0 len tok_fence
ret 0
end

fn main to int
if lt argcnt 2
n = write 2 tuse 0 len tuse
ret 2
end
if argis 1 tself
ret do_selftest
end
if argis 1 tprobe
ret do_probe
end
if argis 1 tfence
ret do_fence_test
end
n = write 2 tuse 0 len tuse
ret 2
end

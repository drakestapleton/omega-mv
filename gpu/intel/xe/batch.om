note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note batch.om: pure seeded-Omega Intel Xe3 (Panther Lake / Xe3Core) CCS batch buffer builder & checker.
note Bitfields verified against Intel compute-runtime shared/source/generated/xe3_core/hw_cmds_generated_xe3_core.inl:
note   PIPELINE_SELECT     (1 dw):  0x69040302 (PipelineSelection=GPGPU/Compute, Mask=0x3)
note   STATE_BASE_ADDRESS  (22 dw): 0x61010014 (InstructionBaseAddress DW10..11, InstructionBufferSize DW15)
note   STATE_COMPUTE_MODE  (3 dw):  0x61050001 (LargeGrfMode=0, UavCoherencyMode=1)
note   CFE_STATE           (6 dw):  0x72000004 (Pipeline=COMPUTE(2), Opcode=2, SubOp=0, MaxThreads DW3[31:16])
note   COMPUTE_WALKER      (40 dw): 0x72080026 (Pipeline=COMPUTE(2), Opcode=2, SubOp=2, IDD DW19..26, PostSync DW27..31, InlineData DW32..39)
note   PIPE_CONTROL        (6 dw):  0x7a000a04 (UnTypedDataPortCacheFlush + DataportFlush + CS Stall + DC Flush + QWORD Write Immediate)
note   MI_BATCH_BUFFER_END (1 dw):  0x05000000
note
note Usage:
note   batch emit KERNEL_VA INLINE_VA FENCE_VA FENCE_VAL GX GY GZ SIMD
note   batch fence FENCE_VA FENCE_VAL
note   batch check FILE.bin
note Exit: 0 ok; 1 invalid batch; 2 usage; 3 I/O error.
om2

text tuse "usage: batch emit KVA IVA FVA FVAL GX GY GZ SIMD | fence FVA FVAL | check FILE.bin\n"
text temit "emit"
text tfence "fence"
text tchk "check"
text tbad "batch: invalid Xe3 CCS batch buffer\n"
text tio "batch: I/O error\n"

const OP_PIPE_SEL uint 0x69040302
const OP_SBA uint 0x61010014
const OP_SCM uint 0x61050001
const OP_CFE uint 0x72000004
const OP_WALKER uint 0x72080026
const OP_PIPE_CTL uint 0x7a000a04
const OP_BB_END uint 0x05000000

global gdw uint 256
global gbuf uchar 1024
global gpath uchar 4096
global garg uchar 64
global gst ulong 4

fn fail code int msg view uchar * to void
n = write 2 msg 0 len msg
exit code
end

fn argis i ulong t view uchar * to bool
n = argread i garg 0 len garg
if ne n long len t
ret false
end
for k ulong len t
if ne get garg k get t k
ret false
end
end
ret true
end

fn parseu ai ulong to ulong
n = argread ai garg 0 len garg
if or le n 0 gt n 20
fail 2 tuse
end
v = ulong 0
for i ulong ulong n
c = get garg i
if or lt c 48 gt c 57
fail 2 tuse
end
v = add mul v 10 ulong sub c 48
end
ret v
end

fn dw v uint to void
n = get gst 0
put gdw n v
put gst 0 add n 1
end

fn dw64 v ulong to void
dw uint and v 4294967295
dw uint shr v 32
end

fn emit_sba kva ulong to void
note Xe3 STATE_BASE_ADDRESS (22 dwords): DW10..11 InstructionBaseAddress, DW15 InstructionBufferSize
dw OP_SBA
for i ulong 9
dw 0
end
dw64 or and kva 18446744073709547520 1
for i ulong 3
dw 0
end
dw 0xfffff001
for i ulong 6
dw 0
end
end

fn emit_scm to void
note Xe3 STATE_COMPUTE_MODE (3 dwords): LargeGrfMode=0 (mask bit 31), UavCoherencyMode=1 (mask bit 22 + bit 6)
dw OP_SCM
dw 0x80000000
dw 0x00400040
end

fn emit_cfe to void
note Xe3 CFE_STATE (6 dwords): MaximumNumberOfThreads = 1024 in DW3[31:16]
dw OP_CFE
dw 0
dw 0
dw 0x04000000
dw 0
dw 0
end

fn emit_walker kva ulong iva ulong gx uint gy uint gz uint simd uint to void
note Xe3 COMPUTE_WALKER (40 dwords, hw_cmds_generated_xe3_core.inl)
dw OP_WALKER
dw 0
note DW2: IndirectDataLength = 64
dw 64
note DW3: IndirectDataStartAddress[31:6] (64B aligned)
dw uint and iva 4294967232
note DW4: SimdSize[31:30] (1=SIMT16, 2=SIMT32) | GenerateLocalId(29) | EmitInlineParameter(25)
sbits = uint 0x62000000
if eq simd 32
sbits = 0xa2000000
end
dw sbits
note DW5: ExecutionMask
dw 0xffffffff
note DW6: LocalXMaximum=63 (64 work-items/group)
dw 63
note DW7..9: ThreadGroupId X, Y, Z dimensions
dw gx
dw gy
dw gz
note DW10..18: Starting X/Y/Z, PartitionId, PartitionSize, Preempt X/Y/Z, Reserved
for i ulong 9
dw 0
end
note DW19..26: INTERFACE_DESCRIPTOR_DATA (8 dwords)
note IDD DW0: KernelStartPointer[31:6] (64B aligned offset from InstructionBaseAddress)
dw uint and kva 4032
dw 0
dw 0
dw 0
dw 0
note IDD DW5: NumberOfThreadsInGpgpuThreadGroup=4 (4*SIMD16=64), RoundingMode=0 (RTNE)
dw 4
dw 0
dw 0
note DW27..31: POSTSYNC_DATA (5 dwords, no walker post-sync; PIPE_CONTROL signals fence)
for i ulong 5
dw 0
end
note DW32..39: InlineData[8] (32 bytes; inline_va in DW32..33)
dw64 iva
for i ulong 6
dw 0
end
end

fn emit_pipe_ctl fva ulong fval ulong to void
note Xe3 PIPE_CONTROL (6 dwords): CS stall(20) | PostSync=WriteImmediate(14) | DcFlush(5)
dw OP_PIPE_CTL
dw 0x00104020
dw64 fva
dw64 fval
end

fn flush_dw to void
while ne rem get gst 0 16 0 bound 16
dw 0
end
ndw = get gst 0
for i ulong ndw
v = get gdw i
o = mul i 4
for k ulong 4
put gbuf add o k uchar and shr v mul uint k 8 255
end
end
nb = mul ndw 4
r = write 1 gbuf 0 nb
if ne r long nb
fail 3 tio
end
end

fn do_emit to void
if ne argcnt 10
fail 2 tuse
end
kva = parseu 2
iva = parseu 3
fva = parseu 4
fval = parseu 5
gx = uint parseu 6
gy = uint parseu 7
gz = uint parseu 8
simd = uint parseu 9
if and ne simd 16 ne simd 32
fail 2 tuse
end
dw OP_PIPE_SEL
emit_sba kva
emit_scm
emit_cfe
emit_walker kva iva gx gy gz simd
emit_pipe_ctl fva fval
dw OP_BB_END
flush_dw
end

fn do_fence to void
if ne argcnt 4
fail 2 tuse
end
fva = parseu 2
fval = parseu 3
emit_pipe_ctl fva fval
dw OP_BB_END
flush_dw
end

fn gbu32 i ulong to uint
o = mul i 4
v = uint 0
for k ulong 4
v = or v shl uint get gbuf add o k mul uint k 8
end
ret v
end

fn do_check to void
if ne argcnt 3
fail 2 tuse
end
pn = argread 2 gpath 0 len gpath
if le pn 0
fail 2 tuse
end
fd = fopen gpath 0 ulong pn 0 0
if lt fd 0
fail 3 tio
end
sz = fseek int fd 0 2
if or lt sz 64 gt sz 1024
c = fclose int fd
fail 1 tbad
end
if ne rem ulong sz 64 0
c = fclose int fd
fail 1 tbad
end
r = pread int fd gbuf 0 ulong sz 0
c = fclose int fd
if ne r sz
fail 3 tio
end
ndw = div ulong sz 4
p = ulong 0
seen_ctl = false
seen_end = false
while lt p ndw bound 256
h = gbu32 p
if eq h 0
p = add p 1
continue
end
if eq h OP_BB_END
seen_end = true
break
end
if eq h OP_PIPE_SEL
p = add p 1
continue
end
if eq h OP_SBA
p = add p 22
continue
end
if eq h OP_SCM
p = add p 3
continue
end
if eq h OP_CFE
p = add p 6
continue
end
if eq h OP_WALKER
p = add p 40
continue
end
if eq h OP_PIPE_CTL
seen_ctl = true
p = add p 6
continue
end
fail 1 tbad
end
if or not seen_ctl not seen_end
fail 1 tbad
end
end

fn main to int
if lt argcnt 3
fail 2 tuse
end
if argis 1 temit
do_emit
ret 0
end
if argis 1 tfence
do_fence
ret 0
end
if argis 1 tchk
do_check
ret 0
end
fail 2 tuse
ret 2
end

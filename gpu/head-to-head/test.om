note SPDX-License-Identifier: Apache-2.0
note gpu/head-to-head/test.om: comprehensive verification tests for gpu/head-to-head/lib.om.
note Compose with: si/directives/om2.om gpu/head-to-head/lib.om gpu/head-to-head/test.om

text h2h_ts_pass "PASS "
text h2h_ts_fail "FAIL "
text h2h_ts_nl "\n"
text h2h_ts_sum_ok "HEAD_TO_HEAD_TEST PASS passed="
text h2h_ts_sum_fl "HEAD_TO_HEAD_TEST FAIL passed="
text h2h_ts_fld " failed="

text h2h_tn_1 "exact_parity"
text h2h_tn_2 "tolerance_boundary_pass"
text h2h_tn_3 "tolerance_boundary_fail"
text h2h_tn_4 "nan_rejection_both_arms"
text h2h_tn_5 "inf_rejection_pos_and_neg"
text h2h_tn_6 "stats_sort_odd_even_p95"
text h2h_tn_7 "speedup_bandwidth_iqr_calls"
text h2h_tn_8 "mutant_control_caught_pass"
text h2h_tn_9 "mutant_control_escaped_fail"
text h2h_tn_10 "not_run_and_zero_timing_refusal"
text h2h_tn_11 "number_parser_u64_f64_sci"

text h2h_tp_u64 "123456789"
text h2h_tp_f1 "-42.125"
text h2h_tp_f2 "1.5e-3"
text h2h_tp_bad "12.3.4"

fn h2h_f64_near a f64 b f64 eps f64 to bool
if not h2h_f64_is_finite a
ret false
end
if not h2h_f64_is_finite b
ret false
end
ret le fabs sub a b eps
end

fn h2h_rec_case name view uchar * ok bool tally edit ulong 2 to void
w = false
if ok
put tally 0 add get tally 0 1
w = h2h_write_all 1 h2h_ts_pass
else
put tally 1 add get tally 1 1
w = h2h_write_all 1 h2h_ts_fail
end
w = and w h2h_write_all 1 name
w = and w h2h_write_all 1 h2h_ts_nl
if w
ret
end
end

fn test_exact_parity to bool
a = new f64 4 0.0f64
b = new f64 4 0.0f64
put a 0 1.25f64
put a 1 -3.5f64
put a 2 0.0f64
put a 3 1024.75f64
put b 0 1.25f64
put b 1 -3.5f64
put b 2 0.0f64
put b 3 1024.75f64
tol = new H2hTol 0.0f64 0.0f64
res = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity a b tol res
if ne get res ok 1
ret false
end
if ne get res elem_n 4
ret false
end
if ne get res mismatches 0
ret false
end
if ne get res nan_cnt 0
ret false
end
if ne get res inf_cnt 0
ret false
end
if ne get res max_abs 0.0f64
ret false
end
ret eq get res max_rel 0.0f64
end

fn test_tol_pass to bool
a = new f64 2 0.0f64
b = new f64 2 0.0f64
note atol=1e-4, rtol=1e-3: at 0.0 limit=1e-4; at 100.0 limit=1e-4 + 0.1 = 0.1001
put a 0 0.0f64
put b 0 0.00009f64
put a 1 100.0f64
put b 1 100.05f64
tol = new H2hTol 0.0001f64 0.001f64
res = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity a b tol res
if ne get res ok 1
ret false
end
if ne get res mismatches 0
ret false
end
if not h2h_f64_near get res max_abs 0.05f64 0.000001f64
ret false
end
ret gt get res max_rel 0.0f64
end

fn test_tol_fail to bool
a = new f64 2 0.0f64
b = new f64 2 0.0f64
note atol=1e-4, rtol=1e-3: at 100.0 limit=0.1001; diff=0.2 must FAIL
put a 0 1.0f64
put b 0 1.0f64
put a 1 100.0f64
put b 1 100.2f64
tol = new H2hTol 0.0001f64 0.001f64
res = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity a b tol res
if ne get res ok 0
ret false
end
if ne get res mismatches 1
ret false
end
ret h2h_f64_near get res max_abs 0.2f64 0.000001f64
end

fn test_nan_rejection to bool
a = new f64 3 1.0f64
b = new f64 3 1.0f64
qnan = bitcast f64 ulong 0x7ff8000000000000
put b 1 qnan
note Even with huge tolerances, NaN MUST be refused
tol = new H2hTol 1000000.0f64 1000000.0f64
res = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity a b tol res
if ne get res ok 0
ret false
end
if ne get res nan_cnt 1
ret false
end
if ne get res mismatches 1
ret false
end
put a 0 qnan
h2h_check_parity a b tol res
if ne get res ok 0
ret false
end
if ne get res nan_cnt 2
ret false
end
ret eq get res mismatches 2
end

fn test_inf_rejection to bool
a = new f64 2 2.0f64
b = new f64 2 2.0f64
pinf = bitcast f64 ulong 0x7ff0000000000000
ninf = bitcast f64 ulong 0xfff0000000000000
put a 0 pinf
put b 0 pinf
put b 1 ninf
tol = new H2hTol 1000.0f64 1000.0f64
res = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity a b tol res
if ne get res ok 0
ret false
end
if ne get res inf_cnt 3
ret false
end
ret eq get res mismatches 2
end

fn test_stats_sort to bool
note Unsorted 20 values: 100..2000 step 100 shuffled
raw = new ulong 20 0
scr = new ulong 20 0
put raw 0 ulong 2000
put raw 1 ulong 100
put raw 2 ulong 1500
put raw 3 ulong 400
put raw 4 ulong 1900
put raw 5 ulong 200
put raw 6 ulong 1800
put raw 7 ulong 300
put raw 8 ulong 1700
put raw 9 ulong 500
put raw 10 ulong 1600
put raw 11 ulong 600
put raw 12 ulong 1400
put raw 13 ulong 700
put raw 14 ulong 1300
put raw 15 ulong 800
put raw 16 ulong 1200
put raw 17 ulong 900
put raw 18 ulong 1100
put raw 19 ulong 1000
st = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
if not h2h_compute_stats raw scr st
ret false
end
if ne get st min_ns 100
ret false
end
if ne get st max_ns 2000
ret false
end
note Even n=20: median = (1000 + 1100) / 2 = 1050.0
if not h2h_f64_near get st med_ns 1050.0f64 0.000001f64
ret false
end
note Nearest-rank for n=20: q1=idx 4 (500), q3=idx 14 (1500), iqr=1000, p95=idx 18 (1900)
if ne get st q1_ns 500
ret false
end
if ne get st q3_ns 1500
ret false
end
if ne get st iqr_ns 1000
ret false
end
if ne get st p95_ns 1900
ret false
end
note Odd n=5: [50, 10, 40, 20, 30] -> median=30.0, p95=50
odd = new ulong 5 0
put odd 0 ulong 50
put odd 1 ulong 10
put odd 2 ulong 40
put odd 3 ulong 20
put odd 4 ulong 30
sto = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
if not h2h_compute_stats odd scr sto
ret false
end
if not h2h_f64_near get sto med_ns 30.0f64 0.000001f64
ret false
end
ret eq get sto p95_ns 50
end

fn test_speedup_bw_iqr to bool
ta = new ulong 4 0
tb = new ulong 4 0
scr = new ulong 4 0
put ta 0 ulong 2000000
put ta 1 ulong 2000000
put ta 2 ulong 2000000
put ta 3 ulong 2000000
put tb 0 ulong 500000
put tb 1 ulong 500000
put tb 2 ulong 500000
put tb 3 ulong 500000
sa = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
sb = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
oka = h2h_compute_stats ta scr sa
okb = h2h_compute_stats tb scr sb
if not and oka okb
ret false
end
sp = h2h_speedup get sa med_ns get sb med_ns
if not h2h_f64_near sp 4.0f64 0.000001f64
ret false
end
note 4000000 bytes in 500000 ns = 8.0 GB/s; in 2000000 ns = 2.0 GB/s
bwa = h2h_bw_gbps ulong 4000000 get sa med_ns
bwb = h2h_bw_gbps ulong 4000000 get sb med_ns
if not h2h_f64_near bwa 2.0f64 0.000001f64
ret false
end
if not h2h_f64_near bwb 8.0f64 0.000001f64
ret false
end
if ne h2h_iqr_call sa sb H2H_CALL_B_FASTER
ret false
end
if ne h2h_iqr_call sb sa H2H_CALL_A_FASTER
ret false
end
sc = new H2hStats 1 4 2000000 2000000 2000000.0f64 2000000 0 2000000 2000000
ret eq h2h_iqr_call sa sc H2H_CALL_OVERLAPPING
end

fn make_test_pair_stats sa edit H2hStats sb edit H2hStats to bool
ta = new ulong 3 1000000
tb = new ulong 3 500000
scr = new ulong 3 0
oka = h2h_compute_stats ta scr sa
okb = h2h_compute_stats tb scr sb
ret and oka okb
end

fn test_mutant_caught to bool
sa = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
sb = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
if not make_test_pair_stats sa sb
ret false
end
fa = new f64 4 2.5f64
fb = new f64 4 2.5f64
fm = new f64 4 0.0f64
tol = new H2hTol 0.000001f64 0.00001f64
par = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
mpar = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity fa fb tol par
mn = h2h_make_wrong_kernel_mutant fa fm
if ne mn 4
ret false
end
if not h2h_verify_mutant fa fm tol mpar
ret false
end
sum = new H2hSummary 2 0 4096 0.0f64 0.0f64 0.0f64 0 0 0 0
h2h_finalize_summary sa sb par 1 1 sum
if ne get sum verdict H2H_VERDICT_PASS
ret false
end
ret eq get sum reason H2H_REASON_OK
end

fn test_mutant_escaped_fails to bool
sa = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
sb = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
if not make_test_pair_stats sa sb
ret false
end
fa = new f64 4 2.5f64
fb = new f64 4 2.5f64
note Escaping mutant: identical to reference, so parity gate does NOT reject it!
fm = new f64 4 2.5f64
tol = new H2hTol 0.000001f64 0.00001f64
par = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
mpar = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
h2h_check_parity fa fb tol par
if h2h_verify_mutant fa fm tol mpar
ret false
end
sum = new H2hSummary 2 0 4096 0.0f64 0.0f64 0.0f64 0 0 0 0
h2h_finalize_summary sa sb par 1 0 sum
if ne get sum verdict H2H_VERDICT_FAIL
ret false
end
ret eq get sum reason H2H_REASON_MUTANT_ESCAPED
end

fn test_not_run_and_zero_time to bool
sa = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
sb = new H2hStats 0 0 0 0 0.0f64 0 0 0 0
par = new H2hParity 0 0 0 0 0 0.0f64 0.0f64
sum = new H2hSummary 0 0 0 0.0f64 0.0f64 0.0f64 0 0 0 0
h2h_finalize_summary sa sb par 0 0 sum
if ne get sum verdict H2H_VERDICT_NOT_RUN
ret false
end
if ne get sum reason H2H_REASON_NO_PAIRS
ret false
end
note Zero-ns sample MUST be refused by h2h_compute_stats
bad = new ulong 2 0
put bad 0 ulong 100
put bad 1 ulong 0
scr = new ulong 2 0
if h2h_compute_stats bad scr sa
ret false
end
ret eq get sa ok 0
end

fn test_parsers to bool
if not h2h_parse_u64_ok h2h_tp_u64 0 len h2h_tp_u64
ret false
end
if ne h2h_parse_u64_val h2h_tp_u64 0 len h2h_tp_u64 123456789
ret false
end
if not h2h_parse_f64_ok h2h_tp_f1 0 len h2h_tp_f1
ret false
end
if not h2h_f64_near h2h_parse_f64_val h2h_tp_f1 0 len h2h_tp_f1 -42.125f64 0.000001f64
ret false
end
if not h2h_parse_f64_ok h2h_tp_f2 0 len h2h_tp_f2
ret false
end
if not h2h_f64_near h2h_parse_f64_val h2h_tp_f2 0 len h2h_tp_f2 0.0015f64 0.0000001f64
ret false
end
ret not h2h_parse_f64_ok h2h_tp_bad 0 len h2h_tp_bad
end

fn main to int
tally = new ulong 2 0
h2h_rec_case h2h_tn_1 test_exact_parity tally
h2h_rec_case h2h_tn_2 test_tol_pass tally
h2h_rec_case h2h_tn_3 test_tol_fail tally
h2h_rec_case h2h_tn_4 test_nan_rejection tally
h2h_rec_case h2h_tn_5 test_inf_rejection tally
h2h_rec_case h2h_tn_6 test_stats_sort tally
h2h_rec_case h2h_tn_7 test_speedup_bw_iqr tally
h2h_rec_case h2h_tn_8 test_mutant_caught tally
h2h_rec_case h2h_tn_9 test_mutant_escaped_fails tally
h2h_rec_case h2h_tn_10 test_not_run_and_zero_time tally
h2h_rec_case h2h_tn_11 test_parsers tally
passed = get tally 0
failed = get tally 1
ok = false
if eq failed 0
ok = h2h_write_all 1 h2h_ts_sum_ok
else
ok = h2h_write_all 1 h2h_ts_sum_fl
end
h2h_write_u64 1 passed
ok = and ok h2h_write_all 1 h2h_ts_fld
h2h_write_u64 1 failed
ok = and ok h2h_write_all 1 h2h_ts_nl
if and ok eq failed 0
ret 0
end
ret 1
end

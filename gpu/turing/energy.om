note gpu/turing/energy.om: TURING Yield TY-4/TY-5 measured resource interval & conserving energy attribution invariants.
note Converted from src/turing/{ty_energy.h,ty_energy.c}. Fail-closed: checks refuse, never repair.

fn ty_conf_forge c uint to uint
if or eq c TY_DIRECT eq c TY_COUNTER_DERIVED
ret TY_FORGE_ENERGY_MEASURED
end
if or eq c TY_CAUSAL_RUNTIME or eq c TY_COUNTERFACTUAL eq c TY_MODELLED
ret TY_FORGE_ENERGY_ESTIMATED
end
ret TY_FORGE_ENERGY_NOT_MEASURED
end

fn ty_windows_overlap t0a ulong t1a ulong t0b ulong t1b ulong to int
if or ge t0a t1a ge t0b t1b
ret 1
end
if and lt t0a t1b lt t0b t1a
ret 1
end
ret 0
end

fn ty_interval_check iv view TyInterval to uint
if eq get iv sensor_ok 0
ret TYE_E_SENSOR
end
if or ne get iv wrap_flag 0 lt get iv e1_uj get iv e0_uj
ret TYE_E_WRAP
end
if ge get iv e1_uj TY_WRAP_UJ
ret TYE_E_HEADROOM
end
if lt sub TY_WRAP_UJ get iv e1_uj TY_HEADROOM_MIN_UJ
ret TYE_E_HEADROOM
end
if gt get iv max_gap_ns TY_MAX_GAP_NS
ret TYE_E_SAMPLING_GAP
end
if gt get iv expected_samples uint 0
if lt mul ulong get iv samples ulong 100 mul ulong get iv expected_samples ulong 90
ret TYE_E_SAMPLING_GAP
end
end
if eq get iv work_ok 0
ret TYE_E_PARTIAL_RUN
end
if or ge get iv t0_ns get iv t1_ns ge get iv work_t0_ns get iv work_t1_ns
ret TYE_E_INTERVAL_MISMATCH
end
if or lt get iv work_t0_ns get iv t0_ns gt get iv work_t1_ns get iv t1_ns
ret TYE_E_INTERVAL_MISMATCH
end
dur = sub get iv work_t1_ns get iv work_t0_ns
if gt get iv planned_ns ulong 0
if lt mul dur ulong 100 mul get iv planned_ns ulong 98
ret TYE_E_PARTIAL_RUN
end
end
if gt get iv pmu_enabled_ns ulong 0
if lt mul get iv pmu_running_ns ulong 1000 mul get iv pmu_enabled_ns ulong 999
ret TYE_E_MULTIPLEXED
end
end
ret TYE_OK
end

fn ty_attribution_check att view TyAttrib expected_mask uint to uint
np = ulong get att n_part
if or eq np ulong 0 gt np ulong 4
ret TYE_E_ARG
end
seen = uint 0
sum = long 0
unc = get att uncert_uj
for i ulong np bound 4
sh = get att shares_uj i
if lt sh neg unc
ret TYE_E_NEGATIVE_SHARE
end
pid = get att part_id i
if ge pid uint 4
ret TYE_E_UNKNOWN_PARTICIPANT
end
bit = shl uint 1 pid
if eq and expected_mask bit uint 0
ret TYE_E_UNKNOWN_PARTICIPANT
end
if ne and seen bit uint 0
ret TYE_E_DOUBLE_COUNT
end
seen = or seen bit
sum = add sum sh
end
if ne seen expected_mask
ret TYE_E_MISSING_PARTICIPANT
end
if gt sum add get att measured_uj unc
ret TYE_E_OVER_ALLOCATED
end
ret TYE_OK
end

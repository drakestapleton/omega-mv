note ---- Shared SplitMix64 (Vigna constants, matching pd0_splitmix64) ----

fn turing_splitmix64 r edit ulong 1 to ulong
s = add get r 0 ulong 0x9e3779b97f4a7c15
put r 0 s
z = mul xor s shr s 30 ulong 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 ulong 0x94d049bb133111eb
ret xor z shr z 31
end

note ---- Exact IEEE-754 f64 log2 for footprint distance |log2(n/qn)| + |log2(m/qm)| ----

fn turing_log2_f64 x f64 to f64
bits = bitcast ulong x
exp_raw = and shr bits 52 ulong 0x7ff
exp_i = sub long exp_raw long 1023
mant_bits = or and bits ulong 0x000fffffffffffff ulong 0x3ff0000000000000
m = bitcast f64 mant_bits
note Range-reduced mantissa m in [1, 2): let t = (m - 1) / (m + 1), ln(m) = 2*(t + t^3/3 + t^5/5 + t^7/7)
t = div sub m 1.0f64 add m 1.0f64
t2 = mul t t
p = add 0.2f64 mul t2 div 1.0f64 7.0f64
p = add div 1.0f64 3.0f64 mul t2 p
p = add 1.0f64 mul t2 p
ln_m = mul 2.0f64 mul t p
ret add f64 exp_i mul ln_m 1.4426950408889634f64
end

fn turing_foot_dist qn ulong qm ulong en ulong em ulong to f64
dn = fabs turing_log2_f64 div f64 en f64 qn
dm = fabs turing_log2_f64 div f64 em f64 qm
ret add dn dm
end

note SPDX-License-Identifier: Apache-2.0
note gpu/algebra/z3.om: pure-Omega Z3 (integers mod 3) algebra (replaces src/algebra/oma_z3.{h,c}).
note Ring isomorphism to balanced trits: 0 <-> 0, 1 <-> +1, 2 <-> -1.
note Compose after: si/directives/om2.om gpu/algebra/trit.om

fn oma_z3_make v int res edit OmaVal to int
if or lt v 0 gt v 2
put res rc OMA_E_INVALID_Z3
ret OMA_E_INVALID_Z3
end
put res val long v
put res rc OMA_OK
ret OMA_OK
end

fn oma_z3_add a int b int res edit OmaVal to int
if or or lt a 0 gt a 2 or lt b 0 gt b 2
put res rc OMA_E_INVALID_Z3
ret OMA_E_INVALID_Z3
end
put res val long rem add a b 3
put res rc OMA_OK
ret OMA_OK
end

fn oma_z3_mul a int b int res edit OmaVal to int
if or or lt a 0 gt a 2 or lt b 0 gt b 2
put res rc OMA_E_INVALID_Z3
ret OMA_E_INVALID_Z3
end
put res val long rem mul a b 3
put res rc OMA_OK
ret OMA_OK
end

fn oma_z3_neg a int res edit OmaVal to int
if or lt a 0 gt a 2
put res rc OMA_E_INVALID_Z3
ret OMA_E_INVALID_Z3
end
put res val long rem sub 3 a 3
put res rc OMA_OK
ret OMA_OK
end

fn oma_z3_to_trit a int res edit OmaVal to int
if or lt a 0 gt a 2
put res rc OMA_E_INVALID_Z3
ret OMA_E_INVALID_Z3
end
if eq a 2
put res val long -1
else
put res val long a
end
put res rc OMA_OK
ret OMA_OK
end

fn oma_trit_to_z3 t int res edit OmaVal to int
if or lt t -1 gt t 1
put res rc OMA_E_INVALID_TRIT
ret OMA_E_INVALID_TRIT
end
if lt t 0
put res val long 2
else
put res val long t
end
put res rc OMA_OK
ret OMA_OK
end

fn oma_z3_block_validate b view OmaZ3Block to int
if ne and get b one get b two 0
ret OMA_E_INVALID_PLANES
end
ret OMA_OK
end

fn oma_z3_block_encode inp view uchar 64 res edit OmaZ3Block to int
o = ulong 0
t = ulong 0
for i ulong 64
v = uint get inp i
if eq v 1
o = or o shl ulong 1 i
else
if eq v 2
t = or t shl ulong 1 i
else
if ne v 0
ret OMA_E_INVALID_Z3
end
end
end
end
put res one o
put res two t
ret OMA_OK
end

fn oma_z3_block_decode b view OmaZ3Block res edit uchar 64 to int
rc = oma_z3_block_validate b
if ne rc OMA_OK
ret rc
end
bo = get b one
bt = get b two
for i ulong 64
v = or and shr bo i 1 shl and shr bt i 1 1
put res i uchar v
end
ret OMA_OK
end

fn oma_z3_block_from_trits t view OmaBlock res edit OmaZ3Block to int
rc = oma_block_validate t
if ne rc OMA_OK
ret rc
end
put res one get t pos
put res two get t negp
ret OMA_OK
end

fn oma_z3_block_to_trits z view OmaZ3Block res edit OmaBlock to int
rc = oma_z3_block_validate z
if ne rc OMA_OK
ret rc
end
put res pos get z one
put res negp get z two
ret OMA_OK
end

fn oma_z3_block_add a view OmaZ3Block b view OmaZ3Block res edit OmaZ3Block to int
rc = oma_z3_block_validate a
if ne rc OMA_OK
ret rc
end
rc = oma_z3_block_validate b
if ne rc OMA_OK
ret rc
end
ta = new OmaBlock get a one get a two
tb = new OmaBlock get b one get b two
s = new OmaBlock 0 0
c = new OmaBlock 0 0
rc = oma_block_add view ta view tb edit s edit c
if ne rc OMA_OK
ret rc
end
put res one get s pos
put res two get s negp
ret OMA_OK
end

fn oma_z3_block_mul a view OmaZ3Block b view OmaZ3Block res edit OmaZ3Block to int
rc = oma_z3_block_validate a
if ne rc OMA_OK
ret rc
end
rc = oma_z3_block_validate b
if ne rc OMA_OK
ret rc
end
ta = new OmaBlock get a one get a two
tb = new OmaBlock get b one get b two
p = new OmaBlock 0 0
rc = oma_block_mul view ta view tb edit p
if ne rc OMA_OK
ret rc
end
put res one get p pos
put res two get p negp
ret OMA_OK
end

fn oma_z3_block_neg a view OmaZ3Block res edit OmaZ3Block to int
rc = oma_z3_block_validate a
if ne rc OMA_OK
ret rc
end
ao = get a one
a2 = get a two
put res one a2
put res two ao
ret OMA_OK
end

note SPDX-License-Identifier: Apache-2.0
note gpu/algebra/test.om: comprehensive positive & negative-control test suite for Omega mixed algebra.
note Compose: si/directives/om2.om gpu/algebra/trit.om gpu/algebra/z3.om gpu/algebra/pack.om gpu/algebra/quant.om gpu/algebra/test.om

text t_p1 "PASS trit & 2-bit code exhaustive tables + negative controls\n"
text t_p2 "PASS 64-trit block ops, dot & H3 tw_i8 + negative controls\n"
text t_p3 "PASS int64 <-> balanced ternary (incl. INT64_MIN/MAX) + negative controls\n"
text t_p4 "PASS Z3 scalar/block ring isomorphism + negative controls\n"
text t_p5 "PASS bitplane/dense packing & 16B LE serialization + negative controls\n"
text t_p6 "PASS absmean quantization & rel_l2 + negative controls\n"
text t_all "ALL PASS gpu-algebra\n"
text t_fail "FAIL gpu-algebra\n"

fn oa_puts s view uchar * to void
k = write 1 s 0 len s
if lt k 0
exit 2
end
ret
end

fn test_trit_scalar to int
v = new OmaVal 0 0
ar = new OmaAddRes 0 0 0
ia = int -1
while le ia 1 bound 4
if or ne oma_trit_make ia edit v OMA_OK ne get v val long ia
ret 1
end
if ne oma_trit_to_code ia edit v OMA_OK
ret 2
end
ca = int get v val
if or ne oma_code_to_trit ca edit v OMA_OK ne get v val long ia
ret 3
end
if or ne oma_trit_neg ia edit v OMA_OK ne get v val long neg ia
ret 4
end
ib = int -1
while le ib 1 bound 4
if ne oma_trit_add ia ib edit ar OMA_OK
ret 5
end
if ne add ia ib add get ar sum mul 3 get ar carry
ret 6
end
if or ne oma_trit_mul ia ib edit v OMA_OK ne get v val long mul ia ib
ret 7
end
ib = add ib 1
end
ia = add ia 1
end
if ne oma_trit_make 2 edit v OMA_E_INVALID_TRIT
ret 8
end
if ne oma_trit_make -2 edit v OMA_E_INVALID_TRIT
ret 9
end
if ne oma_trit_to_code 3 edit v OMA_E_INVALID_TRIT
ret 10
end
if ne oma_code_to_trit 3 edit v OMA_E_INVALID_CODE
ret 11
end
if ne oma_code_to_trit -1 edit v OMA_E_INVALID_CODE
ret 12
end
if ne oma_code_neg 3 edit v OMA_E_INVALID_CODE
ret 13
end
if ne oma_code_add 3 1 edit ar OMA_E_INVALID_CODE
ret 14
end
if ne oma_code_mul 1 3 edit v OMA_E_INVALID_CODE
ret 15
end
ret 0
end

fn test_blocks_enc_neg to int
a_in = new byte 64 0
dec = new byte 64 0
for i ulong 64
put a_in i byte sub int rem i 3 1
end
ba = new OmaBlock 0 0
bn = new OmaBlock 0 0
if ne oma_block_encode view a_in edit ba OMA_OK
ret 20
end
if ne oma_block_decode view ba edit dec OMA_OK
ret 21
end
for i ulong 64
if ne get dec i get a_in i
ret 22
end
end
if ne oma_block_neg view ba edit bn OMA_OK
ret 23
end
if ne oma_block_decode view bn edit dec OMA_OK
ret 24
end
for i ulong 64
if ne int get dec i neg int get a_in i
ret 25
end
end
bad = new OmaBlock ulong 5 ulong 4
if ne oma_block_validate view bad OMA_E_INVALID_PLANES
ret 26
end
put a_in 7 byte 2
if ne oma_block_encode view a_in edit ba OMA_E_INVALID_TRIT
ret 27
end
ret 0
end

fn check_add_lane a int b int s int c int to bool
ret eq add a b add s mul 3 c
end

fn test_blocks_add_mul_dot to int
a_in = new byte 64 0
b_in = new byte 64 0
for i ulong 64
put a_in i byte sub int rem i 3 1
put b_in i byte sub int rem add div i 2 1 3 1
end
ba = new OmaBlock 0 0
bb = new OmaBlock 0 0
bs = new OmaBlock 0 0
bc = new OmaBlock 0 0
if ne oma_block_encode view a_in edit ba OMA_OK
ret 28
end
if ne oma_block_encode view b_in edit bb OMA_OK
ret 29
end
if ne oma_block_add view ba view bb edit bs edit bc OMA_OK
ret 30
end
ds = new byte 64 0
dc = new byte 64 0
if ne oma_block_decode view bs edit ds OMA_OK
ret 31
end
if ne oma_block_decode view bc edit dc OMA_OK
ret 32
end
for i ulong 64
if eq check_add_lane int get a_in i int get b_in i int get ds i int get dc i false
ret 33
end
end
if ne oma_block_mul view ba view bb edit bs OMA_OK
ret 34
end
if ne oma_block_decode view bs edit ds OMA_OK
ret 35
end
ref_dot = int 0
for i ulong 64
prod = mul int get a_in i int get b_in i
if ne int get ds i prod
ret 36
end
ref_dot = add ref_dot prod
end
dv = new OmaVal 0 0
if ne oma_block_dot view ba view bb edit dv OMA_OK
ret 37
end
if ne get dv val long ref_dot
ret 38
end
bad = new OmaBlock ulong 5 ulong 4
if ne oma_block_dot view bad view bb edit dv OMA_E_INVALID_PLANES
ret 39
end
ret 0
end

fn test_h3_dot to int
w_trits = new byte 70 0
x_act = new byte 70 0
ref_h3 = int 0
for i ulong 70
wt = sub int rem add i 1 3 1
put w_trits i byte wt
xv = sub int rem mul i 17 255 128
put x_act i byte xv
ref_h3 = add ref_h3 mul wt xv
end
planes = new ulong 4 0
dv = new OmaVal 0 0
if ne oma_pack_bitplane view w_trits 70 edit planes OMA_OK
ret 40
end
if ne oma_dot_tw_i8 view planes view x_act 70 edit dv OMA_OK
ret 41
end
if ne get dv val long ref_h3
ret 42
end
if ne oma_dot_tw_i8 view planes view x_act add OMA_DOT_I8_MAX_N 1 edit dv OMA_E_OVERFLOW
ret 43
end
put planes 2 or get planes 2 shl ulong 1 10
if ne oma_dot_tw_i8 view planes view x_act 70 edit dv OMA_E_ARG
ret 44
end
put planes 0 ulong 3
put planes 1 ulong 1
if ne oma_dot_tw_i8 view planes view x_act 70 edit dv OMA_E_INVALID_PLANES
ret 45
end
ret 0
end

fn test_bt_one target long to int
digs = new byte 41 0
nd = new OmaVal 0 0
res = new OmaVal 0 0
if ne oma_int_to_bt target edit digs edit nd OMA_OK
ret 1
end
if ne oma_bt_to_int view digs ulong get nd val edit res OMA_OK
ret 2
end
if ne get res val target
ret 3
end
ret 0
end

fn test_bt_int64 to int
if ne test_bt_one 0 0
ret 50
end
if ne test_bt_one 1 0
ret 51
end
if ne test_bt_one -1 0
ret 52
end
if ne test_bt_one 42 0
ret 53
end
if ne test_bt_one -1000000 0
ret 54
end
if ne test_bt_one OMA_I64_MAX 0
ret 55
end
if ne test_bt_one oma_i64_min 0
ret 56
end
fix = new byte 8 0
if ne oma_int_to_bt_fixed 5 edit fix 8 OMA_OK
ret 57
end
res = new OmaVal 0 0
if ne oma_bt_to_int view fix 8 edit res OMA_OK
ret 58
end
if ne get res val 5
ret 59
end
small = new byte 2 0
nd = new OmaVal 0 0
if ne oma_int_to_bt 100 edit small edit nd OMA_E_OVERFLOW
ret 60
end
if ne oma_int_to_bt_fixed 100 edit small 2 OMA_E_OVERFLOW
ret 61
end
bigd = new byte 41 1
if ne oma_bt_to_int view bigd 41 edit res OMA_E_OVERFLOW
ret 62
end
put bigd 3 byte 2
if ne oma_bt_to_int view bigd 41 edit res OMA_E_INVALID_TRIT
ret 63
end
ret 0
end

fn check_z3_pair a int b int ta int to int
vz = new OmaVal 0 0
vt2 = new OmaVal 0 0
vsum = new OmaAddRes 0 0 0
vback = new OmaVal 0 0
if ne oma_z3_to_trit b edit vt2 OMA_OK
ret 76
end
tb = int get vt2 val
if ne oma_z3_add a b edit vz OMA_OK
ret 77
end
if ne oma_trit_add ta tb edit vsum OMA_OK
ret 77
end
if ne oma_trit_to_z3 get vsum sum edit vback OMA_OK
ret 78
end
if ne get vz val get vback val
ret 78
end
if ne oma_z3_mul a b edit vz OMA_OK
ret 79
end
if ne oma_trit_mul ta tb edit vt2 OMA_OK
ret 79
end
if ne oma_trit_to_z3 int get vt2 val edit vback OMA_OK
ret 80
end
if ne get vz val get vback val
ret 80
end
ret 0
end

fn test_z3_scalar to int
vz = new OmaVal 0 0
vt1 = new OmaVal 0 0
vt2 = new OmaVal 0 0
vback = new OmaVal 0 0
a = int 0
while le a 2 bound 4
if ne oma_z3_make a edit vz OMA_OK
ret 70
end
if ne oma_z3_to_trit a edit vt1 OMA_OK
ret 71
end
ta = int get vt1 val
if ne oma_trit_to_z3 ta edit vback OMA_OK
ret 72
end
if ne get vback val long a
ret 72
end
if ne oma_z3_neg a edit vz OMA_OK
ret 73
end
if ne oma_trit_neg ta edit vt2 OMA_OK
ret 74
end
if ne oma_trit_to_z3 int get vt2 val edit vback OMA_OK
ret 75
end
if ne get vz val get vback val
ret 75
end
b = int 0
while le b 2 bound 4
rc = check_z3_pair a b ta
if ne rc 0
ret rc
end
b = add b 1
end
a = add a 1
end
if ne oma_z3_make 3 edit vz OMA_E_INVALID_Z3
ret 81
end
if ne oma_z3_make -1 edit vz OMA_E_INVALID_Z3
ret 82
end
ret 0
end

fn test_z3_blocks to int
za_in = new uchar 64 0
zb_in = new uchar 64 0
zdec = new uchar 64 0
for i ulong 64
put za_in i uchar rem i 3
put zb_in i uchar rem add i 1 3
end
za = new OmaZ3Block 0 0
zb = new OmaZ3Block 0 0
zr = new OmaZ3Block 0 0
if ne oma_z3_block_encode view za_in edit za OMA_OK
ret 87
end
if ne oma_z3_block_encode view zb_in edit zb OMA_OK
ret 88
end
if or ne oma_z3_block_add view za view zb edit zr OMA_OK ne oma_z3_block_decode view zr edit zdec OMA_OK
ret 89
end
for i ulong 64
if ne uint get zdec i rem add uint get za_in i uint get zb_in i 3
ret 90
end
end
if or ne oma_z3_block_mul view za view zb edit zr OMA_OK ne oma_z3_block_decode view zr edit zdec OMA_OK
ret 91
end
for i ulong 64
if ne uint get zdec i rem mul uint get za_in i uint get zb_in i 3
ret 92
end
end
if or ne oma_z3_block_neg view za edit zr OMA_OK ne oma_z3_block_decode view zr edit zdec OMA_OK
ret 93
end
for i ulong 64
if ne uint get zdec i rem sub 3 uint get za_in i 3
ret 94
end
end
zbad = new OmaZ3Block ulong 1 ulong 1
if ne oma_z3_block_validate view zbad OMA_E_INVALID_PLANES
ret 95
end
ret 0
end

fn test_pack_bp_ser to int
src = new byte 70 0
dst = new byte 70 0
for i ulong 70
put src i byte sub int rem add mul i 2 1 3 1
end
planes = new ulong 4 0
if ne oma_pack_bitplane view src 70 edit planes OMA_OK
ret 110
end
if ne oma_unpack_bitplane view planes 70 edit dst OMA_OK
ret 111
end
for i ulong 70
if ne get dst i get src i
ret 112
end
end
b1 = new OmaBlock ulong 0x0123456789abcdef ulong 0xf000000000000000
ser = new uchar 16 0
b2 = new OmaBlock 0 0
if ne oma_block_serialize view b1 edit ser OMA_OK
ret 113
end
if ne oma_block_deserialize view ser edit b2 OMA_OK
ret 114
end
if ne get b2 pos get b1 pos
ret 115
end
if ne get b2 negp get b1 negp
ret 115
end
ret 0
end

fn test_pack_dense_all to int
d5 = new byte 5 0
bv = int 0
while lt bv 243 bound 250
if ne oma_dense_byte_decode bv edit d5 OMA_OK
ret 116
end
re = int 0
p = int 1
for j ulong 5
re = add re mul add int get d5 j 1 p
p = mul p 3
end
if ne re bv
ret 117
end
bv = add bv 1
end
t13 = new byte 13 0
u13 = new byte 13 0
for i ulong 13
put t13 i byte sub int rem i 3 1
end
dbuf = new uchar 4 0
dlen = new OmaVal 0 0
if or ne oma_pack_dense view t13 13 edit dbuf edit dlen OMA_OK ne get dlen val 3
ret 118
end
if ne oma_unpack_dense view dbuf 13 edit u13 OMA_OK
ret 119
end
for i ulong 13
if ne get u13 i get t13 i
ret 120
end
end
if ne oma_dense_byte_decode 243 edit d5 OMA_E_INVALID_BYTE
ret 121
end
if ne oma_dense_byte_decode -1 edit d5 OMA_E_INVALID_BYTE
ret 122
end
put u13 0 byte 77
put dbuf 2 uchar 148
if or ne oma_unpack_dense view dbuf 13 edit u13 OMA_E_INVALID_BYTE ne int get u13 0 77
ret 123
end
put dbuf 2 uchar 243
if ne oma_unpack_dense view dbuf 13 edit u13 OMA_E_INVALID_BYTE
ret 124
end
small_d = new uchar 2 0
if ne oma_pack_dense view t13 13 edit small_d edit dlen OMA_E_OVERFLOW
ret 125
end
ret 0
end

fn test_quant to int
w = new f32 4 0.0f32
q = new byte 4 9
qr = new OmaQuantRes 0 0.0f32
rr = new OmaRelL2Res 0 0.0f32 0.0f64
if or ne oma_quant_absmean view w 4 edit q edit qr OMA_OK ne get qr scale 0.0f32
ret 130
end
for i ulong 4
if ne int get q i 0
ret 131
end
end
put rr scale 0.0f32
if or ne oma_quant_rel_l2 view w view q 4 edit rr OMA_OK ne get rr err 0.0f64
ret 132
end
put w 0 -2.0f32
put w 1 2.0f32
put w 2 -2.0f32
put w 3 2.0f32
if or ne oma_quant_absmean view w 4 edit q edit qr OMA_OK ne get qr scale 2.0f32
ret 133
end
if or ne int get q 0 -1 ne int get q 1 1
ret 134
end
put rr scale get qr scale
if or ne oma_quant_rel_l2 view w view q 4 edit rr OMA_OK ne get rr err 0.0f64
ret 135
end
put w 0 2.0f32
put w 1 0.5f32
put w 2 -0.5f32
put w 3 1.0f32
if or ne oma_quant_absmean view w 4 edit q edit qr OMA_OK ne get qr scale 1.0f32
ret 136
end
if or or ne int get q 0 1 ne int get q 1 1 or ne int get q 2 -1 ne int get q 3 1
ret 137
end
w_bad = new f32 4 0.0f32
put w_bad 1 bitcast f32 uint 0x7fc00000
if ne oma_quant_absmean view w_bad 4 edit q edit qr OMA_E_ARG
ret 138
end
put w_bad 1 bitcast f32 uint 0x7f800000
if ne oma_quant_absmean view w_bad 4 edit q edit qr OMA_E_ARG
ret 139
end
put w_bad 1 bitcast f32 uint 0x00000001
put q 0 byte 55
if or ne oma_quant_absmean view w_bad 4 edit q edit qr OMA_E_UNDERFLOW ne int get q 0 55
ret 140
end
put rr scale -1.0f32
if ne oma_quant_rel_l2 view w view q 4 edit rr OMA_E_ARG
ret 141
end
put rr scale 1.0f32
if ne oma_quant_rel_l2 view w view q 4 edit rr OMA_E_INVALID_TRIT
ret 142
end
w_zero = new f32 4 0.0f32
q_nz = new byte 4 1
put rr scale 1.0f32
if ne oma_quant_rel_l2 view w_zero view q_nz 4 edit rr OMA_E_ARG
ret 143
end
ret 0
end

fn main to int
rc = test_trit_scalar
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p1

rc = test_blocks_enc_neg
if ne rc 0
oa_puts t_fail
ret rc
end
rc = test_blocks_add_mul_dot
if ne rc 0
oa_puts t_fail
ret rc
end
rc = test_h3_dot
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p2

rc = test_bt_int64
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p3

rc = test_z3_scalar
if ne rc 0
oa_puts t_fail
ret rc
end
rc = test_z3_blocks
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p4

rc = test_pack_bp_ser
if ne rc 0
oa_puts t_fail
ret rc
end
rc = test_pack_dense_all
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p5

rc = test_quant
if ne rc 0
oa_puts t_fail
ret rc
end
oa_puts t_p6

oa_puts t_all
ret 0
end

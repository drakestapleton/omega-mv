note SPDX-License-Identifier: Apache-2.0
note gpu/runtime/gate.om: OMEGA-GPU-RUNTIME, the gate of gpu/runtime/ (the inventory of CUDApp src/, the C runtime, and
note the Omega rewrites of its files done so far), in
note seeded Omega (OM-2 program mode, Linux AArch64). Build from the repository root:
note   { printf 'om2\n'; cat seed/ng/sha256.om gpu/runtime/zsha.om gpu/runtime/gate.om; } | seed/out/omc > gate
note Run from the repository root: gate OMC SCRATCH
note OMC      the compiler under test; its sha256 must equal the first word of seed/out/omc.sha256, or nothing
note          runs (exit 69, nothing written)
note SCRATCH  a new directory (created 0700); an existing one is refused (exit 2)
note Checks. gpu/runtime/checks.tsv, one per line, tab separated: NAME PARTS EXPECT MPART FIND REPLACE.
note   NAME one or more of A-Z a-z 0-9 _ -, once. PARTS: paths joined by commas, composed in order, each followed by a
note   newline into SCRATCH/uK.om (K the number of the name, counted from 1 in the order names are read, so a name
note   never becomes a file name); the part om2 is the literal line om2. The unit is compiled by OMC and run from
note   the repository root with no argument: exit 0, and its stdout holds exactly the bytes of the file EXPECT.
note   Mutant control: the same composition with the first FIND in part number MPART (from 1) replaced by
note   REPLACE must compile, and its run must exit nonzero or print other bytes. FIND absent is a FAIL.
note Inventory controls. gpu/runtime/controls.tsv, tab separated: NAME FILE TOKEN EXIT. The check named
note   inventory is run as SCRATCH/uI.bin DIR (I its number), DIR a copy of its inputs in SCRATCH: first unchanged (the
note   output must be gpu/runtime/INVENTORY.tsv, exit 0), then once per row with FILE's byte after the first
note   TOKEN changed (0 becomes 1, anything else 0; an empty TOKEN is the first byte). Caught: EXIT - when the
note   run exits nonzero or prints other bytes, a number when it exits with exactly that code.
note Rewrites. Every row of gpu/runtime/rewrites.tsv (CUDAPP-PATH TAB OMEGA-PATH) must have its OMEGA-PATH as one
note   whole part of the PARTS of some check row, or it is a FAIL line. Control: the first row's OMEGA-PATH less its
note   last byte must be in no check's PARTS (a matcher that took a prefix or substring would pass it).
note Control: a compiler one byte longer fails the digest check.
note Output: one line per check and control, then
note OMEGA-GPU-RUNTIME PASS|FAIL checks=N controls=C caught=K hardware=NOT_RUN; PASS needs N above 0, no FAIL line
note and K equal to C. N and C follow the tables (each check row adds a check and a control, each control row a
note control, plus the compiler control and the rewrites control), so no other file restates them.
note Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 4 the host refused memory, 69 compiler digest refused.
note Memory grows with the input (run-time pools), names included. The one fixed limit is the Linux path limit:
note PATH_MAX is 4096 bytes with the terminating zero, so every path the gate builds (OMC, or SCRATCH/ plus a
note file name of its own) must be under 4096 bytes, and a longer one is refused (exit 2) before any system call takes it.
note A child that runs past 600 s is killed and is a FAIL line.
text t_pin "seed/out/omc.sha256"
text t_tab "gpu/runtime/checks.tsv"
text t_ctab "gpu/runtime/controls.tsv"
text t_inv "inventory"
text t_invx "gpu/runtime/INVENTORY.tsv"
text t_rt "gpu/runtime/"
text t_null "/dev/null"
text t_base "base"
text t_in1 "cudapp-src.sha256.txt"
text t_in2 "omega-base.sha256.txt"
text t_in3 "cudapp-ident.txt"
text t_in4 "pathmap.tsv"
text t_in5 "rewrites.tsv"
text t_om ".om"
text t_bin ".bin"
text t_err ".err"
text t_out ".out"
text t_mom ".m.om"
text t_mbin ".m.bin"
text t_merr ".m.err"
text t_mout ".m.out"
text t_l2 "om2"
text t_plus "omc-plus-one"
text t_usage "usage: gate OMC SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-GPU-RUNTIME REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-GPU-RUNTIME INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-GPU-RUNTIME INVALID: SCRATCH exists or cannot be made\n"
text t_notab "OMEGA-GPU-RUNTIME INVALID: cannot read gpu/runtime/checks.tsv or controls.tsv\n"
text t_plong "OMEGA-GPU-RUNTIME INVALID: a path longer than 4095 bytes\n"
text t_mem "OMEGA-GPU-RUNTIME: the host refused memory\n"
text t_ok "ok "
text t_fail "FAIL "
text t_chk "check "
text t_ctl "control "
text t_bytes " bytes="
text t_sha " sha256="
text t_exit " exit="
text t_mut " mutant"
text t_row "malformed row"
text t_src "source unreadable"
text t_cmp "compile failed"
text t_mcmp "mutant compile failed"
text t_find "FIND not in part MPART"
text t_wr "cannot write in SCRATCH"
text t_run "run exit not 0"
text t_diff "output differs from EXPECT"
text t_mto "child passed the 600 s deadline and was killed: a timeout is not a catch"
text t_noexp "EXPECT unreadable"
text t_nobin "no inventory check"
text t_none "no check passed"
text t_ntok "TOKEN not in FILE"
text t_caught " caught"
text t_esc " ESCAPED"
text t_sum "OMEGA-GPU-RUNTIME "
text t_pass "PASS"
text t_fl "FAIL"
text t_sk " checks="
text t_sc " controls="
text t_sg " caught="
text t_hw " hardware=NOT_RUN\n"
text t_rwk "rewrite "
text t_nochk " is in no check's PARTS"
text t_rwc "rewrite-unchecked"
text t_pre " prefix of a rewrite path"
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_nm uchar *
global g_pin uchar 64
global g_stb uchar 4
global g_n ulong 32
global g_b uchar *
global g_c uchar *
global g_t uchar *
global g_o uchar *
note execprog takes a fixed array: at most two path arguments of under 4096 bytes each (pc refuses longer)
global g_av uchar 8196
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 g_b length, 7 g_c length, 8 checks passed, 9 name number K, 10 the inventory check's K, 11 failures,
note 12 controls, 13 caught, 14 name length,
note 15 g_t length, 16 inventory check passed, 17 a field start, 18 a field end
note ---- memory
fn die4 to void
r = write 2 t_mem 0 len t_mem
exit 4
end
fn growb n ulong to void
if gt n len g_b
r = enlarge g_b add mul len g_b 2 n
if ne r 0
die4
end
end
end
note g_nm holds at least n bytes
fn nmgrow n ulong to void
if gt n len g_nm
r = enlarge g_nm add mul len g_nm 2 n
if ne r 0
die4
end
end
end
fn growc n ulong to void
if gt n len g_c
r = enlarge g_c add mul len g_c 2 n
if ne r 0
die4
end
end
end
note ---- output
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
r = enlarge g_o add mul n 2 4096
if ne r 0
die4
end
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onm to void
for i ulong get g_n 14 bound 9223372036854775807
oc ulong get g_nm i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohex to void
for j ulong 32
b = get sh_dig j
oc ulong sh_hexd uint shr b 4
oc ulong sh_hexd uint and b 15
end
end
fn oflush to void
n = get g_n 5
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 g_o o sub n o
if le x 0
exit 2
end
o = add o ulong x
end
put g_n 5 0
end
fn onl to void
oc 10
oflush
end
note a failed check: FAIL KIND NAME then the reason; counts a failure
fn ofail kind view uchar * why view uchar * to void
ot t_fail
ot kind
onm
oc 32
ot why
onl
put g_n 11 add get g_n 11 1
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
if ge n 4095
r = write 2 t_plong 0 len t_plong
exit 2
end
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pscr to void
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
end
note the scratch file stem uK: u, then K in decimal
fn pstem k ulong to void
pc 117
pdec k
end
fn pdec v ulong to void
if ge v 10
pdec div v 10
end
pc add 48 rem v 10
end
note g_t[a, b) as path bytes
fn ptr a ulong b ulong to void
for i ulong sub b a bound 9223372036854775807
pc ulong get g_t add a i
end
end
note scratch file uK then suffix, K the number of the current name (g_n 9)
fn psn suf view uchar * to void
pclr
pscr
pstem get g_n 9
pt suf
end
fn nmset t view uchar * to void
put g_n 9 add get g_n 9 1
nmgrow len t
for i ulong len t bound 4096
put g_nm i get t i
end
put g_n 14 len t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
fn rdb fd int n ulong to long
growb add n 65536
ret read fd g_b n sub len g_b n
end
fn rdc fd int n ulong to long
growc add n 65536
ret read fd g_c n sub len g_c n
end
note append the file at g_pa to g_b (w 0) or g_c (w 1); false when unreadable
fn fload w ulong to bool
fd = frd
if lt fd 0
ret false
end
ok = true
while true bound 9223372036854775807
n = get g_n add 6 w
x = long 0
if eq w 0
x = rdb fd n
else
x = rdc fd n
end
if lt x 0
ok = false
break
end
if eq x 0
break
end
put g_n add 6 w add n ulong x
end
fclo fd
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 9223372036854775807
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note sha256 of the file at g_pa into sh_dig; false when unreadable
fn fhash to bool
fd = frd
if lt fd 0
ret false
end
zbeg
ok = zfd fd
fclo fd
zend
ret ok
end
note sha256 of g_b[0, g_n 6) into sh_dig
fn bhash to void
zbeg
for i ulong get g_n 6 bound 9223372036854775807
zbyte ulong get g_b i
end
zend
end
note g_b[0, g_n 6) equals g_c[0, g_n 7)
fn bceq to bool
n = get g_n 6
if ne n get g_n 7
ret false
end
for i ulong n bound 9223372036854775807
if ne get g_b i get g_c i
ret false
end
end
ret true
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here): the exit code, 256 + the signal, 512
note when a file could not be opened, 1000 when the child passed the 600 s deadline (killed)
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 9223372036854775807
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
fn pomc to void
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
end
note OMC < SCRATCH/uK.SRC > SCRATCH/uK.BIN 2> SCRATCH/uK.ERR
fn omc src view uchar * bin view uchar * err view uchar * to ulong
psn src
fi = frd
aclr
pomc
apa
psn bin
fo = fexe
psn err
fe = fwr
ret spawn fi fo fe
end
note SCRATCH/uK.BIN < /dev/null > SCRATCH/uK.OUT 2> SCRATCH/uK.ERR
fn runb bin view uchar * outf view uchar * err view uchar * to ulong
pclr
pt t_null
fi = frd
aclr
psn bin
apa
psn outf
fo = fwr
psn err
fe = fwr
ret spawn fi fo fe
end
note ---- the compiler digest
fn pinread to bool
pclr
pt t_pin
put g_n 6 0
if not fload 0
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the file at g_pa hashes to g_pin
fn pinok to bool
if not fhash
ret false
end
for j ulong 32
b = get sh_dig j
if ne get g_pin mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_pin add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
note ---- the table g_t
fn tis i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret eq ulong get g_t i c
end
fn eol p ulong to ulong
e = get g_n 15
q = p
while lt q e bound 9223372036854775807
if eq get g_t q 10
ret q
end
q = add q 1
end
ret e
end
note field k (from 0) of the tab-separated line [s, z) into g_n 17, 18; false when the line has fewer fields
fn fld s ulong z ulong k ulong to bool
a = s
for f ulong k bound 9223372036854775807
while and lt a z not tis a z 9 bound 9223372036854775807
a = add a 1
end
if ge a z
ret false
end
a = add a 1
end
b = a
while and lt b z not tis b z 9 bound 9223372036854775807
b = add b 1
end
put g_n 17 a
put g_n 18 b
ret true
end
fn nameok c ulong to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret or eq c 95 eq c 45
end
note field 0 of [s, z) to g_nm; false unless one or more name bytes
fn nmfld s ulong z ulong to bool
put g_n 9 add get g_n 9 1
if not fld s z 0
ret false
end
a = get g_n 17
b = get g_n 18
if eq a b
ret false
end
nmgrow sub b a
for i ulong sub b a bound 9223372036854775807
c = ulong get g_t add a i
if not nameok c
ret false
end
put g_nm i uchar c
end
put g_n 14 sub b a
ret true
end
note ---- compose: parts field [a, b), part number mp (from 1) mutated by FIND [fa, fb) to REPLACE [ra, rb)
note when mp is not 0; false (a FAIL line written) when a part is unreadable or FIND is absent
fn cat i ulong fa ulong k ulong to bool
for j ulong k bound 9223372036854775807
c = get g_c add i j
if ne c get g_t add fa j
ret false
end
end
ret true
end
note the first FIND [fa, fb) in g_c[0, g_n 7), or g_n 7 when absent or empty
fn cfind fa ulong fb ulong to ulong
n = get g_n 7
k = sub fb fa
if or eq k 0 gt k n
ret n
end
for i ulong add sub n k 1 bound 9223372036854775807
if cat i fa k
ret i
end
end
ret n
end
fn bput c ulong to void
n = get g_n 6
growb add n 1
put g_b n uchar c
put g_n 6 add n 1
end
note g_c to g_b, the first FIND replaced; false when FIND is absent
fn cmut fa ulong fb ulong ra ulong rb ulong to bool
n = get g_n 7
p = cfind fa fb
if ge p n
ret false
end
for i ulong p bound 9223372036854775807
bput ulong get g_c i
end
for i ulong sub rb ra bound 9223372036854775807
bput ulong get g_t add ra i
end
q = add p sub fb fa
for i ulong sub n q bound 9223372036854775807
bput ulong get g_c add q i
end
ret true
end
fn ctx t view uchar * to void
for i ulong len t bound 4096
bput ulong get t i
end
end
fn isom2 a ulong b ulong to bool
if ne sub b a 3
ret false
end
for i ulong 3
if ne get g_t add a i get t_l2 i
ret false
end
end
ret true
end
fn compose a ulong b ulong mp ulong to bool
put g_n 6 0
i = a
k = ulong 1
while lt i b bound 9223372036854775807
j = i
while and lt j b not tis j b 44 bound 9223372036854775807
j = add j 1
end
if isom2 i j
ctx t_l2
else
pclr
ptr i j
put g_n 7 0
if not fload 1
ofail t_chk t_src
ret false
end
if eq k mp
if not cmut get g_n 19 get g_n 20 get g_n 21 get g_n 22
ofail t_chk t_find
ret false
end
else
for q ulong get g_n 7 bound 9223372036854775807
bput ulong get g_c q
end
end
end
bput 10
k = add k 1
i = add j 1
end
ret true
end
note ---- one check row [s, z)
note load EXPECT [ea, eb) into g_c, SCRATCH/uK.OUTF into g_b; true when equal (the output sha256 in sh_dig)
fn cmpout ea ulong eb ulong outf view uchar * to ulong
pclr
ptr ea eb
put g_n 7 0
if not fload 1
ret 2
end
psn outf
put g_n 6 0
if not fload 0
ret 1
end
bhash
if bceq
ret 0
end
ret 1
end
fn cfail why view uchar * r ulong to void
ot t_fail
ot t_chk
onm
oc 32
ot why
ot t_exit
onum r
onl
put g_n 11 add get g_n 11 1
end
fn crow s ulong z ulong to void
if not nmset2 s z
ret
end
if not fld s z 1
ofail t_chk t_row
ret
end
pa = get g_n 17
pb = get g_n 18
if not fld s z 2
ofail t_chk t_row
ret
end
ea = get g_n 17
eb = get g_n 18
if not crowm s z
ofail t_chk t_row
ret
end
if not compose pa pb 0
ret
end
psn t_om
if not bsave false
ofail t_chk t_wr
ret
end
r = omc t_om t_bin t_err
if ne r 0
cfail t_cmp r
ret
end
r = runb t_bin t_out t_err
if ne r 0
cfail t_run r
ret
end
c = cmpout ea eb t_out
if eq c 2
ofail t_chk t_noexp
ret
end
if ne c 0
ofail t_chk t_diff
ret
end
ot t_ok
ot t_chk
onm
ot t_bytes
onum get g_n 6
ot t_sha
ohex
onl
put g_n 8 add get g_n 8 1
if istx t_inv
put g_n 16 1
put g_n 10 get g_n 9
end
cmutant pa pb ea eb
end
note name field to g_nm, or a FAIL line
fn nmset2 s ulong z ulong to bool
if nmfld s z
ret true
end
put g_n 14 0
ofail t_chk t_row
ret false
end
note MPART, FIND, REPLACE of row [s, z) into g_n 23, 19..22
fn crowm s ulong z ulong to bool
if not fld s z 3
ret false
end
a = get g_n 17
b = get g_n 18
if or eq a b gt sub b a 18
ret false
end
m = ulong 0
for i ulong sub b a bound 32
c = ulong get g_t add a i
if or lt c 48 gt c 57
ret false
end
m = add mul m 10 sub c 48
end
if eq m 0
ret false
end
put g_n 23 m
if not fld s z 4
ret false
end
if eq get g_n 17 get g_n 18
ret false
end
put g_n 19 get g_n 17
put g_n 20 get g_n 18
if not fld s z 5
ret false
end
put g_n 21 get g_n 17
put g_n 22 get g_n 18
ret true
end
fn istx t view uchar * to bool
if ne get g_n 14 len t
ret false
end
for i ulong len t bound 4096
if ne get g_nm i get t i
ret false
end
end
ret true
end
note the mutant of the current check: compiles, then exits nonzero or prints other bytes
fn cmutant pa ulong pb ulong ea ulong eb ulong to void
put g_n 12 add get g_n 12 1
if not compose pa pb get g_n 23
ret
end
psn t_mom
if not bsave false
ofail t_chk t_wr
ret
end
r = omc t_mom t_mbin t_merr
if ne r 0
cfail t_mcmp r
ret
end
r = runb t_mbin t_mout t_merr
if eq r 1000
cfail t_mto r
ret
end
c = cmpout ea eb t_mout
if eq c 2
ofail t_chk t_noexp
ret
end
caught or ne r 0 ne c 0 t_mut
end
fn caught c bool what view uchar * to void
if c
ot t_ok
ot t_ctl
onm
ot what
ot t_caught
onl
put g_n 13 add get g_n 13 1
else
ot t_fail
ot t_ctl
onm
ot what
ot t_esc
onl
put g_n 11 add get g_n 11 1
end
end
fn tload tb view uchar * to bool
pclr
pt tb
put g_n 6 0
if not fload 0
ret false
end
n = get g_n 6
r = enlarge g_t n
if ne r 0
die4
end
for i ulong n bound 9223372036854775807
put g_t i get g_b i
end
put g_n 15 n
ret true
end
fn rowskip s ulong z ulong to bool
if eq s z
ret true
end
ret eq get g_t s 35
end
fn checks to void
e = get g_n 15
s = ulong 0
while lt s e bound 9223372036854775807
z = eol s
if not rowskip s z
crow s z
end
s = add z 1
end
end
note ---- rewrites.tsv against the PARTS of checks.tsv (in g_t)
note g_b[a, b) equals g_t[i, j)
fn bteq a ulong b ulong i ulong j ulong to bool
if ne sub b a sub j i
ret false
end
for k ulong sub b a bound 9223372036854775807
if ne get g_b add a k get g_t add i k
ret false
end
end
ret true
end
note one comma-separated part of the PARTS of the check row [s, z) is g_b[a, b)
fn rowhas a ulong b ulong s ulong z ulong to bool
if not fld s z 1
ret false
end
i = get g_n 17
e = get g_n 18
while le i e bound 9223372036854775807
j = i
while and lt j e not tis j e 44 bound 9223372036854775807
j = add j 1
end
if bteq a b i j
ret true
end
i = add j 1
end
ret false
end
fn tabhas a ulong b ulong to bool
e = get g_n 15
s = ulong 0
while lt s e bound 9223372036854775807
z = eol s
if not rowskip s z
if rowhas a b s z
ret true
end
end
s = add z 1
end
ret false
end
note the first byte c (or q) in g_b[p, q)
fn bto p ulong q ulong c ulong to ulong
i = p
while lt i q bound 9223372036854775807
if eq ulong get g_b i c
ret i
end
i = add i 1
end
ret q
end
fn rwnot a ulong b ulong to void
ot t_fail
ot t_rwk
for i ulong sub b a bound 9223372036854775807
oc ulong get g_b add a i
end
ot t_nochk
onl
put g_n 11 add get g_n 11 1
end
fn rwchk to void
pclr
pt t_rt
pt t_in5
put g_n 6 0
if not fload 0
nmset t_in5
ofail t_chk t_src
ret
end
e = get g_n 6
s = ulong 0
first = true
while lt s e bound 9223372036854775807
z = bto s e 10
if and lt s z ne get g_b s 35
t = bto s z 9
if ge add t 1 z
nmset t_in5
ofail t_chk t_row
ret
end
a = add t 1
b = bto a z 9
if not tabhas a b
rwnot a b
end
if first
first = false
put g_n 12 add get g_n 12 1
nmset t_rwc
caught not tabhas a sub b 1 t_pre
end
end
s = add z 1
end
end
note ---- inventory controls
note copy gpu/runtime/FILE to SCRATCH/uKd/FILE (K the number of the current name); with flip, change the byte
note after the first TOKEN [ta, tb) of g_n 19, 20 when FILE is FL [fa, fb) of g_t; false on a failure
fn cpin f view uchar * flip bool fa ulong fb ulong to bool
pclr
pt t_rt
pt f
put g_n 7 0
if not fload 1
ret false
end
put g_n 6 0
mine = flip
if mine
mine = tfeq fa fb f
end
if mine
p = cfind get g_n 19 get g_n 20
if eq get g_n 19 get g_n 20
p = ulong 0
else
p = add p sub get g_n 20 get g_n 19
end
if ge p get g_n 7
put g_n 24 1
ret true
end
c = get g_c p
if eq c 48
put g_c p 49
else
put g_c p 48
end
end
for q ulong get g_n 7 bound 9223372036854775807
bput ulong get g_c q
end
pdir
pt f
ret bsave false
end
fn tfeq a ulong b ulong t view uchar * to bool
if ne sub b a len t
ret false
end
for i ulong len t bound 4096
if ne get g_t add a i get t i
ret false
end
end
ret true
end
fn pdir to void
pclr
pscr
pstem get g_n 9
pc 100
pc 47
end
note make SCRATCH/uKd with the inventory inputs, FILE [fa, fb) flipped when flip
fn mkin flip bool fa ulong fb ulong to bool
pdir
x = makedir g_pa 0 sub get g_n 0 1 448
if ne x 0
ret false
end
put g_n 24 0
ok = cpin t_in1 flip fa fb
ok = and ok cpin t_in2 flip fa fb
ok = and ok cpin t_in3 flip fa fb
ok = and ok cpin t_in4 flip fa fb
ok = and ok cpin t_in5 flip fa fb
ret ok
end
note run SCRATCH/uI.bin SCRATCH/uKd (I the inventory check's number, g_n 10); out and err as uK.out / uK.err
fn invrun to ulong
aclr
pclr
pscr
pstem get g_n 10
pt t_bin
apa
pdir
put g_n 0 sub get g_n 0 1
apa
pclr
pt t_null
fi = frd
psn t_out
fo = fwr
psn t_err
fe = fwr
ret spawn fi fo fe
end
note the unchanged copy SCRATCH/uKd: exit 0 and exactly INVENTORY.tsv (proves the copied input set is complete)
fn ctlbase to bool
nmset t_base
if not mkin false 0 0
ofail t_ctl t_wr
ret false
end
r = invrun
pclr
pt t_invx
put g_n 7 0
if not fload 1
ofail t_ctl t_noexp
ret false
end
c = invout
if or ne r 0 not c
cfail t_diff r
ret false
end
ot t_ok
ot t_ctl
onm
ot t_bytes
onum get g_n 6
onl
ret true
end
note SCRATCH/uK.out of the last invrun (K the row name's number) into g_b; equal to g_c
fn invout to bool
psn t_out
put g_n 6 0
if not fload 0
ret false
end
ret bceq
end
fn ctlrow s ulong z ulong to void
put g_n 12 add get g_n 12 1
if not nmfld s z
put g_n 14 0
ofail t_ctl t_row
ret
end
if not fld s z 1
ofail t_ctl t_row
ret
end
fa = get g_n 17
fb = get g_n 18
if not fld s z 2
ofail t_ctl t_row
ret
end
put g_n 19 get g_n 17
put g_n 20 get g_n 18
if not fld s z 3
ofail t_ctl t_row
ret
end
ea = get g_n 17
eb = get g_n 18
if not mkin true fa fb
ofail t_ctl t_wr
ret
end
if ne get g_n 24 0
ofail t_ctl t_ntok
ret
end
r = invrun
if eq r 1000
ofail t_ctl t_mto
ret
end
pclr
pt t_invx
put g_n 7 0
if not fload 1
ofail t_ctl t_noexp
ret
end
c = invout
ex = ctlexp ea eb
if eq ex 1000000
caught or ne r 0 not c t_mut
else
caught eq r ex t_mut
end
end
note EXIT field [a, b): - is 1000000, else the number
fn ctlexp a ulong b ulong to ulong
if and eq sub b a 1 eq get g_t a 45
ret 1000000
end
m = ulong 0
for i ulong sub b a bound 32
c = ulong get g_t add a i
m = add mul m 10 sub c 48
end
ret m
end
fn controls to void
if eq get g_n 16 0
nmset t_inv
ofail t_ctl t_nobin
ret
end
pclr
pt t_invx
put g_n 7 0
if not fload 1
nmset t_inv
ofail t_ctl t_noexp
ret
end
if not ctlbase
ret
end
e = get g_n 15
s = ulong 0
while lt s e bound 9223372036854775807
z = eol s
if not rowskip s z
ctlrow s z
end
s = add z 1
end
end
note ---- the wrong-compiler control: OMC one byte longer must fail the digest check
fn cwrong to void
put g_n 12 add get g_n 12 1
pomc
put g_n 6 0
ok = fload 0
bput 0
nmset t_plus
psn t_bin
ok = and ok bsave true
psn t_bin
c = and ok not pinok
caught c t_mut
end
note ---- main
fn ausage to int
r = write 2 t_usage 0 len t_usage
ret 2
end
fn main to int
if ne argcnt 3
ret ausage
end
r = argread 1 g_omc 0 4095
if lt r 0
r = write 2 t_plong 0 len t_plong
ret 2
end
if eq r 0
ret ausage
end
put g_n 1 ulong r
if not pinread
r = write 2 t_nopin 0 len t_nopin
ret 2
end
pomc
if not pinok
r = write 2 t_refd 0 len t_refd
ret 69
end
r = argread 2 g_scr 0 4094
if lt r 0
r = write 2 t_plong 0 len t_plong
ret 2
end
if eq r 0
ret ausage
end
n = ulong r
x = makedir g_scr 0 n 448
if ne x 0
r = write 2 t_noscr 0 len t_noscr
ret 2
end
put g_scr n 47
put g_n 2 add n 1
if not tload t_tab
r = write 2 t_notab 0 len t_notab
ret 2
end
checks
rwchk
if not tload t_ctab
r = write 2 t_notab 0 len t_notab
ret 2
end
controls
cwrong
if eq get g_n 8 0
nmset t_tab
ofail t_chk t_none
end
f = get g_n 11
ot t_sum
if eq f 0
ot t_pass
else
ot t_fl
end
ot t_sk
onum get g_n 8
ot t_sc
onum get g_n 12
ot t_sg
onum get g_n 13
ot t_hw
oflush
if ne f 0
ret 1
end
if ne get g_n 12 get g_n 13
ret 1
end
ret 0
end

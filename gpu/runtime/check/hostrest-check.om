note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/hostrest-check.om: runs ah_rest of gpu/nvidia/om/apiviews/hostrest.om for every op 0..24 on
note xorshift64 inputs with boundary values, and prints what the C oracle printed for omega_ah_c of CUDApp
note src/omega_gpu_api_hostrest.h (gpu/runtime/README.md). gpu/runtime/check/hostrest.expect.txt is that oracle's
note output. Composed after hostrest.om.
global hk_s ulong 1
global hk_o uchar *
global hk_n ulong 1
global hk_b ulong 32
text hk_to "op "
text hk_tc " case "
text hk_tr " r="
text hk_tp " p="
text hk_tn " cases="
text hk_tz " nonzero="
text hk_th " fnv="
text hk_mem "hostrest-check: the host refused memory\n"
fn hkdie to void
w = write 2 hk_mem 0 len hk_mem
exit 4
end
fn hkoc c ulong to void
n = get hk_n 0
if ge n len hk_o
r = enlarge hk_o add mul n 2 4096
if ne r 0
hkdie
end
end
put hk_o n uchar c
put hk_n 0 add n 1
end
fn hkt t view uchar * to void
for i ulong len t
hkoc ulong get t i
end
end
fn hknum v ulong to void
if ge v 10
hknum div v 10
end
hkoc add 48 rem v 10
end
fn hkhex v ulong to void
for i ulong 16
c = and shr v mul 4 sub 15 i 15
if lt c 10
hkoc add 48 c
else
hkoc add 87 c
end
end
end
fn hkflush to void
n = get hk_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 hk_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put hk_n 0 0
end
fn hkrnd to ulong
s = get hk_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put hk_s 0 s
ret s
end
fn hkval to ulong
r = hkrnd
sel = and r 7
if lt sel 4
ret get hk_b and shr r 3 31
end
if lt sel 6
ret and shr r 3 127
end
ret hkrnd
end
fn hkfnv h ulong w ulong to ulong
for b ulong 8
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
fn hknz v ulong to ulong
if eq v 0
ret 1
end
ret v
end
note the oracle's dom(): keeps a case where the C is defined (no division by zero) and the Omega takes 32-bit
note values (uint get is a checked conversion); the same rewrites in the same order
fn hkdom op ulong p edit ulong 16 to void
u = or eq op 2 or and ge op 4 le op 10 or eq op 13 or eq op 15 eq op 24
if u
for i ulong 5
put p i and get p i 4294967295
end
end
if eq op 8
put p 0 and get p 0 16777215
put p 1 add 1 rem get p 1 134217727
put p 3 add 1 rem get p 3 134217727
end
if or eq op 9 or eq op 15 eq op 22
put p 1 hknz get p 1
end
if eq op 10
put p 1 hknz get p 1
put p 2 hknz get p 2
end
if eq op 12
put p 3 hknz get p 3
end
if eq op 24
put p 1 add 1 rem get p 1 134217727
end
note op 19: the C answers 1 and ah_rest answers p[3]; both CUDApp callers (src/omega_gpu_fp8_api.c) pass p[3] = 1
if and eq op 19 ne get p 3 0
put p 3 1
end
end
note the oracle's shape(): every other case of ops 8, 16 and 19 takes the shape of CUDApp
note tests/api_hostrest_test.c, so that their accepting answers are reached
fn hkshape op ulong c ulong p edit ulong 16 to void
if ne rem c 2 0
ret
end
if eq op 8
put p 0 mul rem get p 0 129 512
put p 1 16
put p 2 1
put p 3 8
put p 4 rem get p 4 3
put p 5 1
end
if eq op 16
for i ulong 8
put p i 0
end
end
if eq op 19
put p 0 0
put p 1 1
end
end
fn hkline op ulong c ulong r ulong p view ulong 16 to void
hkt hk_to
hknum op
hkt hk_tc
hknum c
hkt hk_tr
hknum r
hkt hk_tp
for i ulong 9
hknum get p i
if lt i 8
hkoc 44
else
hkoc 10
end
end
end
fn hkop op ulong to void
nc = ulong 4096
p = new ulong 16 0
h = ulong 14695981039346656037
nz = ulong 0
for c ulong nc
for i ulong 9
put p i hkval
end
for i ulong 7
put p add i 9 0
end
hkdom op p
hkshape op c p
r = ah_rest op p
if lt c 2
hkline op c r p
end
h = hkfnv h r
if ne r 0
nz = add nz 1
end
end
hkt hk_to
hknum op
hkt hk_tn
hknum nc
hkt hk_tz
hknum nz
hkt hk_th
hkhex h
hkoc 10
hkflush
end
fn main to int
put hk_s 0 88172645463325252
put hk_b 0 0
put hk_b 1 1
put hk_b 2 2
put hk_b 3 3
put hk_b 4 4
put hk_b 5 8
put hk_b 6 15
put hk_b 7 16
put hk_b 8 47
put hk_b 9 48
put hk_b 10 49
put hk_b 11 57
put hk_b 12 128
put hk_b 13 256
put hk_b 14 383
put hk_b 15 384
put hk_b 16 512
put hk_b 17 1000
put hk_b 18 4095
put hk_b 19 4096
put hk_b 20 4097
put hk_b 21 65535
put hk_b 22 65536
put hk_b 23 999999
put hk_b 24 2147483647
put hk_b 25 4294967295
put hk_b 26 4294967296
put hk_b 27 1099511627776
put hk_b 28 9223372036854775808
put hk_b 29 18446744073709551615
put hk_b 30 32
put hk_b 31 129
for op ulong 25
hkop op
end
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/compose-owner.sh compile=16 refusal=standalone-view. Composed by hostrest in gpu/runtime/checks.tsv as om2 gpu/nvidia/om/apiviews/hostrest.om gpu/runtime/check/hostrest-check.om.

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/platpolicy-check.om: runs plat_policy of gpu/nvidia/om/platform-linux/plat_policy.om for every
note message kind 0..15 on xorshift64 inputs with boundary values (for kind 7, every other case a short text of
note digits, blanks and signs packed eight bytes to a word from m[2], its length in m[1]), and prints what the C
note oracle printed for plat_c of CUDApp src/omega_gpu_platform_linux_cpolicy.h (gpu/runtime/README.md).
note gpu/runtime/check/platpolicy.expect.txt is that oracle's output. Composed after plat_policy.om. OM-1, as
note plat_policy.om is (it names a parameter out, a word OM-2 reserves), so the output goes through a fixed buffer
note that is written out whenever it fills, and the fixed texts are ranges of pq_all.
global pq_s ulong 1
global pq_o uchar 4096
global pq_n ulong 1
global pq_b ulong 32
text pq_tx " \t\n+-0123456789x"
note kind 0 5, case 5 6, r= 11 3, q= 14 3, cases= 17 7, nonzero= 24 9, fnv= 33 5
text pq_all "kind  case  r= q= cases= nonzero= fnv="
fn pqflush to void
n = get pq_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 pq_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put pq_n 0 0
end
fn pqoc c ulong to void
if ge get pq_n 0 len pq_o
pqflush
end
n = get pq_n 0
put pq_o n uchar c
put pq_n 0 add n 1
end
fn pqt off ulong n ulong to void
for i ulong n
pqoc ulong get pq_all add off i
end
end
fn pqnum v ulong to void
if ge v 10
pqnum div v 10
end
pqoc add 48 rem v 10
end
fn pqhex v ulong to void
for i ulong 16
c = and shr v mul 4 sub 15 i 15
if lt c 10
pqoc add 48 c
else
pqoc add 87 c
end
end
end
fn pqrnd to ulong
s = get pq_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put pq_s 0 s
ret s
end
fn pqval to ulong
r = pqrnd
sel = and r 7
if lt sel 4
ret get pq_b and shr r 3 31
end
if lt sel 6
ret and shr r 3 127
end
ret pqrnd
end
fn pqfnv h ulong w ulong to ulong
for b ulong 8
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
note the text case of kind 7: n = 1 + rnd mod 34 bytes, each the text pq_tx at rnd and 15, from m[2] up
fn pqtext m edit ulong 16 to void
n = add 1 rem pqrnd 34
for i ulong 5
put m add i 2 0
end
for i ulong n
if lt i 40
w = add 2 div i 8
c = ulong get pq_tx and pqrnd 15
put m w or get m w shl c mul rem i 8 8
end
end
put m 1 n
end
fn pqline kind ulong c ulong r ulong q view ulong 16 to void
pqt 0 5
pqnum kind
pqt 5 6
pqnum c
pqt 11 3
pqnum r
pqt 14 3
for i ulong 16
pqnum get q i
if lt i 15
pqoc 44
else
pqoc 10
end
end
end
fn pqcase kind ulong c ulong m edit ulong 16 to void
for i ulong 16
put m i pqval
end
put m 0 kind
if and eq kind 7 eq rem c 2 0
pqtext m
end
note kind 12, every other case: a slot (c/2) mod 3 that matches m[2], m[3]
if and eq kind 12 eq rem c 2 0
s = mul rem div c 2 3 2
put m 1 add 2 rem get m 1 4
put m add 4 s get m 2
put m add 5 s get m 3
end
end
fn pqkind kind ulong to void
nc = ulong 4096
m = new ulong 16 0
q = new ulong 16 0
h = ulong 14695981039346656037
nz = ulong 0
for c ulong nc
pqcase kind c m
note q starts zero, as plat_decide of CUDApp src/omega_gpu_platform_linux.c sets it before each call
for i ulong 16
put q i 0
end
r = plat_policy m q
if lt c 2
pqline kind c r q
end
h = pqfnv h r
for i ulong 16
h = pqfnv h get q i
end
if ne r 0
nz = add nz 1
end
end
pqt 0 5
pqnum kind
pqt 17 7
pqnum nc
pqt 24 9
pqnum nz
pqt 33 5
pqhex h
pqoc 10
pqflush
end
fn main to int
put pq_s 0 88172645463325252
put pq_b 0 0
put pq_b 1 1
put pq_b 2 2
put pq_b 3 3
put pq_b 4 4
put pq_b 5 8
put pq_b 6 9
put pq_b 7 10
put pq_b 8 12
put pq_b 9 13
put pq_b 10 15
put pq_b 11 16
put pq_b 12 32
put pq_b 13 33
put pq_b 14 47
put pq_b 15 50
put pq_b 16 51
put pq_b 17 52
put pq_b 18 121
put pq_b 19 4095
put pq_b 20 4096
put pq_b 21 4097
put pq_b 22 65536
put pq_b 23 999999
put pq_b 24 4294967295
put pq_b 25 4294967296
put pq_b 26 1099511627776
put pq_b 27 1844674407370955161
put pq_b 28 9223372036854775808
put pq_b 29 18446744073709547520
put pq_b 30 18446744073709551614
put pq_b 31 18446744073709551615
for kind ulong 16
pqkind kind
end
ret 0
end

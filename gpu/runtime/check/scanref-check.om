note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/scanref-check.om: prints gpu/runtime/scanref.om on fixed xorshift64 vectors, one line
note per case, in the form the C oracle printed for CUDApp src/omega_gpu_scan_ref.c (gpu/runtime/README.md);
note gpu/runtime/check/scanref.expect.txt is that oracle's output. Composed after scan.om and scanref.om.
global ck_s ulong 1
global ck_o uchar *
global ck_n ulong 1
global ck_k2 uint *
note The output words, one table (OM-1 has no unsized view to pass a text by): segment i ends at the i-th |.
text ck_tx "n=| s=| red|=|refused|ok| pre=| last=| u32=| rk=| rv=| rko=|refuse red_op3=| red_n0=| pre_n0=| u32_n0=| radix_n0=|"
const ck_ns ulong 0
const ck_ss ulong 1
const ck_red ulong 2
const ck_eq ulong 3
const ck_ref ulong 4
const ck_ok ulong 5
const ck_pre ulong 6
const ck_last ulong 7
const ck_u32 ulong 8
const ck_rk ulong 9
const ck_rv ulong 10
const ck_rko ulong 11
const ck_r1 ulong 12
const ck_r2 ulong 13
const ck_r3 ulong 14
const ck_r4 ulong 15
const ck_r5 ulong 16
text ck_mem "scanref-check: the host refused memory\n"
fn ckdie to void
w = write 2 ck_mem 0 len ck_mem
exit 4
end
fn ckoc c ulong to void
n = get ck_n 0
if ge n len ck_o
r = enlarge ck_o add mul n 2 4096
if ne r 0
ckdie
end
end
put ck_o n uchar c
put ck_n 0 add n 1
end
fn ckot id ulong to void
k = ulong 0
for i ulong len ck_tx
c = ulong get ck_tx i
if eq c 124
k = add k 1
else
if eq k id
ckoc c
end
end
end
end
fn cknum v ulong to void
if ge v 10
cknum div v 10
end
ckoc add 48 rem v 10
end
fn ckhex v ulong d ulong to void
for i ulong d
c = and shr v mul 4 sub sub d 1 i 15
if lt c 10
ckoc add 48 c
else
ckoc add 87 c
end
end
end
fn ckres r ulong to void
if eq r 0
ckot ck_ok
else
ckot ck_ref
end
end
fn ckflush to void
n = get ck_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 ck_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put ck_n 0 0
end
fn ckrnd to ulong
s = get ck_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put ck_s 0 s
ret s
end
note The float bits of the oracle's fbits: with sp, one in sixteen each of +0, -0, quiet NaN, +inf, -inf.
fn ckfb sp ulong to uint
r = ckrnd
c = and r 15
if ne sp 0
if eq c 0
ret uint 0
end
if eq c 1
ret uint 2147483648
end
if eq c 2
ret uint 2143289344
end
if eq c 3
ret uint 2139095040
end
if eq c 4
ret uint 4286578688
end
end
sg = shl and shr r 4 1 31
ex = add 100 rem shr r 5 51
mn = and shr r 32 8388607
ret uint or or sg shl ex 23 mn
end
note FNV-1a 64 of one 32-bit value's little-endian bytes, folded into h.
fn ckfnv h ulong w ulong to ulong
for b ulong 4
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
note FNV-1a 64 over the first n values of pool p: 0 sr_y (float bits), 1 sr_uy, 2 sr_k, 3 sr_v.
fn ckhash p ulong n ulong to ulong
h = ulong 14695981039346656037
for i ulong n bound 9223372036854775807
w = ulong 0
if eq p 0
w = ulong bitcast uint get sr_y i
end
if eq p 1
w = ulong get sr_uy i
end
if eq p 2
w = ulong get sr_k i
end
if eq p 3
w = ulong get sr_v i
end
h = ckfnv h w
end
ret h
end
fn ckbits f f32 to void
ckhex ulong bitcast uint f 8
end
fn ckgrow n ulong to void
r = enlarge sr_x n
if ne r 0
ckdie
end
r = enlarge sr_u n
if ne r 0
ckdie
end
r = enlarge sr_k n
if ne r 0
ckdie
end
r = enlarge sr_v n
if ne r 0
ckdie
end
r = enlarge ck_k2 n
if ne r 0
ckdie
end
end
note One case: n values, specials sp, key mask m; the draws in the oracle's order.
fn ckcase n ulong sp ulong m ulong to void
ckgrow n
for i ulong n bound 9223372036854775807
put sr_x i bitcast f32 ckfb sp
end
ckot ck_ns
cknum n
ckot ck_ss
cknum sp
for op ulong 3
ckot ck_red
cknum op
ckot ck_eq
if eq sr_reduce op n 0
ckbits get sr_r 0
else
ckot ck_ref
end
end
ckot ck_pre
if eq sr_prefix n 0
ckhex ckhash 0 n 16
ckot ck_last
ckbits get sr_y sub n 1
else
ckot ck_ref
end
for i ulong n bound 9223372036854775807
put sr_u i uint and shr ckrnd 16 4294967295
end
ckot ck_u32
if eq sr_pu32 n 0
ckhex ckhash 1 n 16
else
ckot ck_ref
end
ckradix n m
ckoc 10
end
fn ckradix n ulong m ulong to void
for i ulong n bound 9223372036854775807
w = uint and shr ckrnd 8 m
put sr_k i w
put sr_v i uint i
put ck_k2 i w
end
ckot ck_rk
if eq sr_radix n 1 0
ckhex ckhash 2 n 16
ckot ck_rv
ckhex ckhash 3 n 16
else
ckot ck_ref
end
for i ulong n bound 9223372036854775807
put sr_k i get ck_k2 i
end
ckot ck_rko
if eq sr_radix n 0 0
ckhex ckhash 2 n 16
else
ckot ck_ref
end
end
fn ckrefuse to void
ckot ck_r1
ckres sr_reduce 3 4
ckot ck_r2
ckres sr_reduce 0 0
ckot ck_r3
ckres sr_prefix 0
ckot ck_r4
ckres sr_pu32 0
ckot ck_r5
ckres sr_radix 0 1
ckoc 10
end
fn main to int
put ck_s 0 88172645463325252
ns = new ulong 12 0
put ns 0 1
put ns 1 2
put ns 2 31
put ns 3 32
put ns 4 33
put ns 5 100
put ns 6 1023
put ns 7 1024
put ns 8 1025
put ns 9 4097
put ns 10 33000
put ns 11 70001
ms = new ulong 3 4294967295
put ms 1 255
put ms 2 252645135
for sp ulong 2
for c ulong 12
ckcase get ns c sp get ms rem c 3
ckflush
end
end
ckrefuse
ckflush
ret 0
end

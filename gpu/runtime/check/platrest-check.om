note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/platrest-check.om: runs plat_rest of gpu/nvidia/om/platform-linux/plat_rest.om on xorshift64
note inputs with boundary values, every mode 0..15, and prints what the C oracle printed for plat_rest_c of CUDApp
note src/omega_gpu_platform_linux_rest_oracle.h (gpu/runtime/README.md). gpu/runtime/check/platrest.expect.txt is
note that oracle's output. Composed after plat_rest.om.
global pk_s ulong 1
global pk_o uchar *
global pk_n ulong 1
global pk_b ulong 16
text pk_pfx "memfd:"
text pk_tm "mode "
text pk_tc " case "
text pk_tr " r="
text pk_tq " q="
text pk_tn " cases="
text pk_tz " nonzero="
text pk_tf " fnv="
text pk_mem "platrest-check: the host refused memory\n"
fn pkdie to void
w = write 2 pk_mem 0 len pk_mem
exit 4
end
fn pkoc c ulong to void
n = get pk_n 0
if ge n len pk_o
r = enlarge pk_o add mul n 2 4096
if ne r 0
pkdie
end
end
put pk_o n uchar c
put pk_n 0 add n 1
end
fn pkt t view uchar * to void
for i ulong len t
pkoc ulong get t i
end
end
fn pknum v ulong to void
if ge v 10
pknum div v 10
end
pkoc add 48 rem v 10
end
fn pkhex v ulong to void
for i ulong 16
c = and shr v mul 4 sub 15 i 15
if lt c 10
pkoc add 48 c
else
pkoc add 87 c
end
end
end
fn pkflush to void
n = get pk_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 pk_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put pk_n 0 0
end
fn pkrnd to ulong
s = get pk_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put pk_s 0 s
ret s
end
fn pkval to ulong
r = pkrnd
sel = and r 7
if lt sel 4
ret get pk_b and shr r 3 15
end
if lt sel 6
ret and shr r 3 127
end
ret pkrnd
end
fn pkfnv h ulong w ulong to ulong
for b ulong 8
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
note m[0..16) for case c: random, and for one case in three the text memfd: (one in six after a /, one in nine
note with one byte flipped) with a length of 5..8 in m[0]
fn pkfill m edit ulong 16 c ulong to void
for i ulong 16
put m i pkval
end
if eq rem c 3 0
off = ulong 1
if eq rem c 6 0
put m 1 47
off = 2
end
for i ulong 6
put m add off i ulong get pk_pfx i
end
if eq rem c 9 0
k = add off rem div c 9 6
put m k xor get m k 1
end
put m 0 add 5 rem div c 18 4
end
end
fn pkline mode ulong c ulong r ulong q view ulong 16 to void
pkt pk_tm
pknum mode
pkt pk_tc
pknum c
pkt pk_tr
pknum r
pkt pk_tq
pknum get q 0
pkoc 44
pknum get q 1
pkoc 44
pknum get q 2
pkoc 10
end
fn pkmode mode ulong to void
nc = ulong 4096
m = new ulong 16 0
q = new ulong 16 0
h = ulong 14695981039346656037
nz = ulong 0
for c ulong nc
pkfill m c
for i ulong 16
put q i 6148914691236517205
end
r = plat_rest mode m q
if lt c 3
pkline mode c r q
end
h = pkfnv pkfnv pkfnv pkfnv h r get q 0 get q 1 get q 2
if ne r 0
nz = add nz 1
end
end
pkt pk_tm
pknum mode
pkt pk_tn
pknum nc
pkt pk_tz
pknum nz
pkt pk_tf
pkhex h
pkoc 10
pkflush
end
fn main to int
put pk_s 0 88172645463325252
put pk_b 0 0
put pk_b 1 1
put pk_b 2 2
put pk_b 3 3
put pk_b 4 47
put pk_b 5 1000
put pk_b 6 4095
put pk_b 7 4096
put pk_b 8 65535
put pk_b 9 65536
put pk_b 10 268435456
put pk_b 11 1099511623680
put pk_b 12 1099511627776
put pk_b 13 9223372036854775808
put pk_b 14 18446744073709551615
put pk_b 15 999999
for mode ulong 16
pkmode mode
end
ret 0
end

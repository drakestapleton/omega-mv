note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/numeric-check.om: runs numeric_ref of gpu/nvidia/om/numeric/numeric.om for every scalar code
note 0..30 on xorshift64 operands (FP32 special values, small integers, random 32-bit words), and prints what the C
note oracle printed for the C reference functions of CUDApp src/omega_numeric.c and src/omega_numeric_reduce.c
note those codes stand for (gpu/runtime/README.md). gpu/runtime/check/numeric.expect.txt is that oracle's output.
note Composed after numeric.om. OM-1, like the unit; the output goes through a fixed buffer that is written out
note whenever it fills, and the fixed texts are ranges of nk_all.
global nk_s ulong 1
global nk_o uchar 4096
global nk_n ulong 1
global nk_b ulong 32
note the fsetp_mask of src/omega_numeric.c for its fsetp ops, in the order of the oracle's table FS (GE LT LE GT
note EQ NE NUM NAN LTU LEU GTU GEU EQU NEU); an input, so a wrong entry shows as a difference, never as a pass
global nk_fm ulong 14
note op 0 3, case 3 6, r= 9 3, a= 12 3, b= 15 3, c= 18 3, cases= 21 7, nonzero= 28 9, fnv= 37 5
text nk_all "op  case  r= a= b= c= cases= nonzero= fnv="
fn nkflush to void
n = get nk_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 nk_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put nk_n 0 0
end
fn nkoc c ulong to void
if ge get nk_n 0 len nk_o
nkflush
end
n = get nk_n 0
put nk_o n uchar c
put nk_n 0 add n 1
end
fn nkt off ulong n ulong to void
for i ulong n
nkoc ulong get nk_all add off i
end
end
fn nknum v ulong to void
if ge v 10
nknum div v 10
end
nkoc add 48 rem v 10
end
fn nkhex v ulong to void
for i ulong 16
c = and shr v mul 4 sub 15 i 15
if lt c 10
nkoc add 48 c
else
nkoc add 87 c
end
end
end
fn nkrnd to ulong
s = get nk_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put nk_s 0 s
ret s
end
fn nkval to ulong
r = nkrnd
sel = and r 7
if lt sel 4
ret get nk_b and shr r 3 31
end
if lt sel 6
ret and shr r 3 127
end
ret and nkrnd 4294967295
end
fn nkfnv h ulong w ulong to ulong
for b ulong 8
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
note one case: the operands in v[0..2] in the forms the C wrappers pass (the oracle's main, in the same order)
fn nkcase op ulong k ulong v edit ulong 3 to void
a = nkval
b = nkval
c = nkval
if and eq rem k 4 0 eq op 27
b = a
end
if and eq rem k 4 0 eq op 28
c = b
end
if eq op 8
c = get nk_fm rem nkrnd 14
end
if or eq op 18 eq op 19
a = and a 65535
end
if eq op 28
a = rem a 5
end
if or eq op 29 eq op 30
if ne and k 1 0
a = nkrnd
end
end
put v 0 a
put v 1 b
put v 2 c
end
fn nkline op ulong k ulong r ulong v view ulong 3 to void
nkt 0 3
nknum op
nkt 3 6
nknum k
nkt 9 3
nknum r
nkt 12 3
nknum get v 0
nkt 15 3
nknum get v 1
nkt 18 3
nknum get v 2
nkoc 10
end
fn nkop op ulong to void
nc = ulong 4096
v = new ulong 3 0
h = ulong 14695981039346656037
nz = ulong 0
for k ulong nc
nkcase op k v
r = numeric_ref op get v 0 get v 1 get v 2
if lt k 2
nkline op k r v
end
h = nkfnv h r
if ne r 0
nz = add nz 1
end
end
nkt 0 3
nknum op
nkt 21 7
nknum nc
nkt 28 9
nknum nz
nkt 37 5
nkhex h
nkoc 10
nkflush
end
fn main to int
put nk_s 0 88172645463325252
put nk_fm 0 6
put nk_fm 1 1
put nk_fm 2 3
put nk_fm 3 4
put nk_fm 4 2
put nk_fm 5 5
put nk_fm 6 7
put nk_fm 7 8
put nk_fm 8 9
put nk_fm 9 11
put nk_fm 10 12
put nk_fm 11 14
put nk_fm 12 10
put nk_fm 13 13
put nk_b 0 0
put nk_b 1 2147483648
put nk_b 2 1065353216
put nk_b 3 3212836864
put nk_b 4 1073741824
put nk_b 5 1
put nk_b 6 2155872255
put nk_b 7 8388608
put nk_b 8 2139095039
put nk_b 9 4286578687
put nk_b 10 2139095040
put nk_b 11 4286578688
put nk_b 12 2143289344
put nk_b 13 2141192192
put nk_b 14 1325400064
put nk_b 15 3472883713
put nk_b 16 1056964607
put nk_b 17 1056964608
put nk_b 18 1199566848
put nk_b 19 864026624
put nk_b 20 1065385984
put nk_b 21 1065451520
put nk_b 22 1333788672
put nk_b 23 3472883712
put nk_b 24 1069547520
put nk_b 25 1075838976
put nk_b 26 3223322624
put nk_b 27 2147483647
put nk_b 28 4290772993
put nk_b 29 947912704
put nk_b 30 65535
put nk_b 31 4294967295
for op ulong 31
nkop op
end
ret 0
end

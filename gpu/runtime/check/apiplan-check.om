note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/runtime/check/apiplan-check.om: runs ap_plan of gpu/runtime/apiplan.om for every family 0..5 and mode
note 0..last+1, and family 6, on xorshift64 inputs with boundary values, and prints what the C oracle printed for
note ap_c of CUDApp src/omega_api_plan.h (gpu/runtime/README.md). gpu/runtime/check/apiplan.expect.txt is that
note oracle's output. Composed after the six plan units and apiplan.om.
global ak_s ulong 1
global ak_o uchar *
global ak_n ulong 1
global ak_b ulong 32
global ak_last ulong 7
text ak_tf "family "
text ak_tm " mode "
text ak_tc " case "
text ak_tr " r="
text ak_ta " a="
text ak_tn " cases="
text ak_tz " nonzero="
text ak_th " fnv="
text ak_mem "apiplan-check: the host refused memory\n"
fn akdie to void
w = write 2 ak_mem 0 len ak_mem
exit 4
end
fn akoc c ulong to void
n = get ak_n 0
if ge n len ak_o
r = enlarge ak_o add mul n 2 4096
if ne r 0
akdie
end
end
put ak_o n uchar c
put ak_n 0 add n 1
end
fn akt t view uchar * to void
for i ulong len t
akoc ulong get t i
end
end
fn aknum v ulong to void
if ge v 10
aknum div v 10
end
akoc add 48 rem v 10
end
fn akhex v ulong to void
for i ulong 16
c = and shr v mul 4 sub 15 i 15
if lt c 10
akoc add 48 c
else
akoc add 87 c
end
end
end
fn akflush to void
n = get ak_n 0
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 ak_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put ak_n 0 0
end
fn akrnd to ulong
s = get ak_s 0
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
put ak_s 0 s
ret s
end
fn akval to ulong
r = akrnd
sel = and r 7
if lt sel 4
ret get ak_b and shr r 3 31
end
if lt sel 6
ret and shr r 3 127
end
ret akrnd
end
fn akfnv h ulong w ulong to ulong
for b ulong 8
h = mul xor h and shr w mul 8 b 255 1099511628211
end
ret h
end
fn aknz v ulong to ulong
if eq v 0
ret 1
end
ret v
end
note the oracle's dom(): keeps a case where the C is defined (no division by zero, no shift past 63, no loop of
note 2^64 passes); the same rewrites in the same order
fn akdom f ulong mode ulong a edit ulong 16 to void
if eq f 0
if eq mode 1
put a 0 add mul and get a 0 511 16 16
put a 1 add mul and get a 1 32767 8 8
end
if and eq mode 2 ne get a 3 0
put a 0 add and get a 0 32767 1
end
if eq mode 3
if ne and get a 1 1 0
put a 1 ulong 16
else
put a 1 ulong 8
end
end
if eq mode 7
put a 2 aknz and get a 2 7
end
end
if eq f 1
if eq mode 1
put a 0 and get a 0 8589934591
end
if eq mode 2
put a 1 aknz get a 1
put a 2 aknz get a 2
end
if eq mode 3
put a 1 aknz and get a 1 4294967295
end
if eq mode 4
put a 0 rem get a 0 5
put a 1 aknz and get a 1 1023
end
if eq mode 5
put a 4 and get a 4 8589934591
put a 5 aknz get a 5
end
if eq mode 7
put a 3 and get a 3 4294967295
end
if eq mode 15
put a 2 aknz get a 2
end
if eq mode 22
put a 1 and get a 1 4294967295
end
if and eq mode 17 ne get a 4 0
put a 3 and get a 3 4294967295
end
if eq mode 25
put a 2 aknz and get a 2 1023
put a 1 mul get a 2 aknz and get a 1 63
end
end
if and eq f 3 eq mode 0
put a 0 and get a 0 16777215
end
if and eq f 3 eq mode 1
put a 3 aknz get a 3
end
end
fn akline f ulong mode ulong c ulong r ulong a view ulong 16 to void
akt ak_tf
aknum f
akt ak_tm
aknum mode
akt ak_tc
aknum c
akt ak_tr
aknum r
akt ak_ta
for i ulong 16
aknum get a i
if lt i 15
akoc 44
end
end
akoc 10
end
fn akmode f ulong mode ulong to void
nc = ulong 4096
a = new ulong 16 0
h = ulong 14695981039346656037
nz = ulong 0
for c ulong nc
for i ulong 8
put a i akval
end
for i ulong 8
put a add i 8 add 2654435769 add i 8
end
akdom f mode a
s = ap_plan f mode a
r = ulong neg s
if lt c 2
akline f mode c r a
end
h = akfnv h r
for i ulong 16
h = akfnv h get a i
end
if ne r 0
nz = add nz 1
end
end
akt ak_tf
aknum f
akt ak_tm
aknum mode
akt ak_tn
aknum nc
akt ak_tz
aknum nz
akt ak_th
akhex h
akoc 10
akflush
end
fn main to int
put ak_s 0 88172645463325252
put ak_b 0 0
put ak_b 1 1
put ak_b 2 2
put ak_b 3 3
put ak_b 4 4
put ak_b 5 8
put ak_b 6 15
put ak_b 7 16
put ak_b 8 47
put ak_b 9 64
put ak_b 10 128
put ak_b 11 256
put ak_b 12 1000
put ak_b 13 1024
put ak_b 14 4095
put ak_b 15 4096
put ak_b 16 8192
put ak_b 17 16384
put ak_b 18 65535
put ak_b 19 65536
put ak_b 20 131072
put ak_b 21 262144
put ak_b 22 999999
put ak_b 23 2147483647
put ak_b 24 4294967295
put ak_b 25 4294967296
put ak_b 26 268435456
put ak_b 27 1099511627776
put ak_b 28 1065353216
put ak_b 29 4607182418800017408
put ak_b 30 9223372036854775808
put ak_b 31 18446744073709551615
put ak_last 0 8
put ak_last 1 27
put ak_last 2 6
put ak_last 3 6
put ak_last 4 4
put ak_last 5 4
put ak_last 6 0
for f ulong 7
for mode ulong add get ak_last f 2
akmode f mode
end
end
ret 0
end

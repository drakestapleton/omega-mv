note SPDX-License-Identifier: Apache-2.0
note gpu/runtime/nativeh.om: CUDApp src/cudapp_native.h (the C declarations of every Omega Bridge unit, written by
note CUDApp om/units.sh) regenerated in seeded Omega (OM-2 program mode, Linux AArch64) from the Omega source in
note this tree. Build from the repository root:
note   { printf 'om2\n'; cat seed/ng/sha256.om gpu/runtime/zsha.om gpu/runtime/nativeh.om; } | seed/out/omc > nativeh
note Run from the repository root with no argument. Inputs:
note   gpu/runtime/cudapp-units.ident    CUDApp src/cudapp_om_units.ident unchanged: one omega-ident 2 line per unit,
note                                     in the order units.sh declares them. Its sha256 must equal that file's row
note                                     in gpu/runtime/cudapp-src.sha256.txt, or nothing is written (exit 3).
note   gpu/runtime/pathmap.tsv           CUDApp Omega path prefix TAB where it lives here (as the inventory reads it)
note   the Omega source parts the path= value of each line names, mapped through pathmap.tsv
note Output on stdout: the fixed head units.sh writes, then per unit, the parts composed each followed by a newline
note (units.sh's composition): the line nh_rv when the abi is bridge-seeded-runtime or the composition starts with
note the line om2, then the declaration of the last fn of the composition (its root): name omega_ROOT, result
note uint64_t *result (one space before * for a bridge-freest unit without a view or edit parameter, two otherwise),
note then per parameter: view T EXT is const void *pK, uint64_t pK_n; edit T EXT is void *pK, uint64_t pK_n;
note f32 is float pK; any other scalar is uint64_t pK. Then the fixed tail.
note A unit with a part that is not in this tree is left out and named on stderr ("nativeh: absent part ..."); the
note output is then CUDApp's header less that unit's lines.
note Exit 0, 3 an input is unreadable or malformed or the units list is not CUDApp's, 4 the host refused memory.
note Memory grows with the input (run-time pools); the one fixed buffer is a path of PATH_MAX (4096) bytes.
text nh_funits "gpu/runtime/cudapp-units.ident"
text nh_fsrc "gpu/runtime/cudapp-src.sha256.txt"
text nh_fmap "gpu/runtime/pathmap.tsv"
text nh_kunits "src/cudapp_om_units.ident"
text nh_kid "omega-ident 2 "
text nh_kabi "abi="
text nh_kpath "path="
text nh_kfn "fn "
text nh_kom2 "om2\n"
text nh_kto "to"
text nh_kview "view"
text nh_kedit "edit"
text nh_kf32 "f32"
text nh_abirt "bridge-seeded-runtime"
text nh_abifr "bridge-freest"
text nh_h1 "/* Generated checked portable Omega declarations. Regenerate with om/units.sh.\n"
text nh_h2 " * Status: 0 done, 1..14 trap, 32 argument refused, 33 reentry.\n"
text nh_h3 " * Only a successful call writes result. Fixed views use the declared length.\n"
text nh_h4 " * Runtime-extent units pass the live count under the bridge runtime-views profile.\n"
text nh_h5 " * Implementation is Omega lowered by omega-bridge, not the native AArch64 ABI. */\n"
text nh_h6 "#ifndef CUDAPP_PORTABLE_OMEGA_H\n#define CUDAPP_PORTABLE_OMEGA_H\n#include <stdint.h>\n"
text nh_h7 "#ifdef __cplusplus\nextern \"C\" {\n#endif\n"
text nh_h8 "#define OMEGA_OK 0u\n#define OMEGA_BAD_ARG 32u\n#define OMEGA_REENTRY 33u\n"
text nh_rv "/* Omega Bridge runtime views: numeric extents are capacities; * is unsized. */\n"
text nh_d0 "uint32_t omega_"
text nh_d1 "(uint64_t "
text nh_d2 "*result"
text nh_pv ", const void *p"
text nh_pe ", void *p"
text nh_ps ", uint64_t p"
text nh_pf ", float p"
text nh_pn "_n"
text nh_d3 ");\n"
text nh_tail "#ifdef __cplusplus\n}\n#endif\n#endif\n"
text nh_e_read "nativeh: cannot read "
text nh_e_list "nativeh: gpu/runtime/cudapp-src.sha256.txt has no well-formed row for src/cudapp_om_units.ident\n"
text nh_e_units "nativeh: gpu/runtime/cudapp-units.ident is not CUDApp's src/cudapp_om_units.ident (its sha256 differs from the row in gpu/runtime/cudapp-src.sha256.txt): copy it again\n"
text nh_e_rec "nativeh: malformed line in gpu/runtime/cudapp-units.ident\n"
text nh_e_fn "nativeh: no fn line of the expected form in the composition of "
text nh_e_abs "nativeh: absent part "
text nh_e_mem "nativeh: the host refused memory\n"
text nh_e_long "nativeh: a path is longer than 4095 bytes\n"
global nh_t uchar *
global nh_o uchar *
global nh_k ulong *
global nh_pa uchar 4096
global nh_n ulong 32
note nh_n: 0 path length, 2 nh_t used, 3 nh_o used, 4..9 input ranges [s,e) of units, src list, pathmap;
note 10, 11 a token [s,e); 12 a part is absent; 13 parameters in nh_k; 14 an array parameter; 15, 16 root name [s,e)
note ---- failure
fn die t view uchar * code int to void
r = write 2 t 0 len t
exit code
end
fn nlerr to void
q = new uchar 1 10
r = write 2 q 0 1
end
note ---- output pool
fn oc c ulong to void
n = get nh_n 3
if ge n len nh_o
r = enlarge nh_o add mul n 2 65536
if ne r 0
die nh_e_mem 4
end
end
put nh_o n uchar c
put nh_n 3 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn otr a ulong b ulong to void
for i ulong sub b a bound 9223372036854775807
oc ulong get nh_t add a i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn oflush to void
n = get nh_n 3
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 nh_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
put nh_n 3 0
end
note ---- paths: nh_pa[0, nh_n 0)
fn pc c ulong to void
n = get nh_n 0
if ge n 4095
die nh_e_long 3
end
put nh_pa n uchar c
put nh_n 0 add n 1
end
fn pt t view uchar * to void
put nh_n 0 0
for i ulong len t bound 4096
pc ulong get t i
end
end
fn ptr a ulong b ulong to void
for i ulong sub b a bound 9223372036854775807
pc ulong get nh_t add a i
end
end
fn diepa t view uchar * to void
r = write 2 t 0 len t
r = write 2 nh_pa 0 get nh_n 0
nlerr
exit 3
end
note ---- input pool: append the file at nh_pa to nh_t; false when it cannot be opened
fn tgrow n ulong to void
if ge add n 65536 len nh_t
r = enlarge nh_t add mul len nh_t 2 131072
if ne r 0
die nh_e_mem 4
end
end
end
fn tappend to bool
fd = int fopen nh_pa 0 get nh_n 0 int 524288 int 0
if lt fd 0
ret false
end
n = get nh_n 2
while true bound 9223372036854775807
tgrow n
x = read fd nh_t n sub len nh_t n
if lt x 0
diepa nh_e_read
end
if eq x 0
break
end
n = add n ulong x
end
r = fclose fd
put nh_n 2 n
ret true
end
fn tbyte c ulong to void
n = get nh_n 2
tgrow n
put nh_t n uchar c
put nh_n 2 add n 1
end
note load the file named t into slots k, k+1
fn tload t view uchar * k ulong to void
pt t
s = get nh_n 2
if not tappend
diepa nh_e_read
end
put nh_n k s
put nh_n add k 1 get nh_n 2
end
note ---- bytes of nh_t
fn eol p ulong e ulong to ulong
q = p
while lt q e bound 9223372036854775807
if eq get nh_t q 10
ret q
end
q = add q 1
end
ret e
end
fn tfind p ulong e ulong c ulong to ulong
q = p
while lt q e bound 9223372036854775807
if eq ulong get nh_t q c
ret q
end
q = add q 1
end
ret e
end
fn tteq a ulong n ulong t view uchar * to bool
if ne n len t
ret false
end
for i ulong n bound 4096
if ne get nh_t add a i get t i
ret false
end
end
ret true
end
fn tpre a ulong e ulong t view uchar * to bool
if lt sub e a len t
ret false
end
ret tteq a len t t
end
note the value of the space-separated field kw= in [ls, lz) into slots 10, 11; false when there is none
fn tokval ls ulong lz ulong kw view uchar * to bool
a = ls
while lt a lz bound 9223372036854775807
b = tfind a lz 32
if tpre a b kw
put nh_n 10 add a len kw
put nh_n 11 b
ret true
end
a = add b 1
end
ret false
end
note ---- the units list must be CUDApp's: its sha256 against the src list row
fn hexeq p ulong to bool
for j ulong 32
b = uint get sh_dig j
if ne get nh_t add p mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get nh_t add add p mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
fn unitsok to void
zbeg
s = get nh_n 4
for i ulong sub get nh_n 5 s bound 9223372036854775807
zbyte ulong get nh_t add s i
end
zend
p = get nh_n 6
e = get nh_n 7
while lt p e bound 9223372036854775807
q = eol p e
if ge sub q p 67
if tteq add p 66 sub q add p 66 nh_kunits
if hexeq p
ret
end
die nh_e_units 3
end
end
p = add q 1
end
die nh_e_list 3
end
fn tteqr a ulong b ulong n ulong to bool
for i ulong n bound 9223372036854775807
if ne get nh_t add a i get nh_t add b i
ret false
end
end
ret true
end
note ---- one part [a, b) of a path= value: mapped through pathmap.tsv into nh_pa
fn pmap a ulong b ulong to void
put nh_n 0 0
p = get nh_n 8
e = get nh_n 9
while lt p e bound 9223372036854775807
q = eol p e
if and ne p q ne get nh_t p 35
t = tfind p q 9
if le sub t p sub b a
if tteqr p a sub t p
ptr add t 1 q
ptr add a sub t p b
ret
end
end
end
p = add q 1
end
ptr a b
end
note compose the parts of the path= value [s, e) at the end of nh_t; false (named on stderr) when one is absent
fn ncompose s ulong e ulong to bool
a = s
while lt a e bound 9223372036854775807
b = tfind a e 44
pmap a b
if not tappend
r = write 2 nh_e_abs 0 len nh_e_abs
r = write 2 nh_pa 0 get nh_n 0
nlerr
ret false
end
tbyte 10
a = add b 1
end
ret true
end
note ---- the root: the last line of [s, e) starting with fn
fn lastfn s ulong e ulong to ulong
f = e
p = s
while lt p e bound 9223372036854775807
q = eol p e
if tpre p q nh_kfn
f = p
end
p = add q 1
end
ret f
end
fn skipsp p ulong e ulong to ulong
q = p
while and lt q e eq get nh_t q 32 bound 9223372036854775807
q = add q 1
end
ret q
end
note parameter kind into nh_k: 0 scalar, 1 view, 2 edit, 3 f32
fn kput v ulong to void
n = get nh_n 13
if ge n len nh_k
r = enlarge nh_k add mul n 2 64
if ne r 0
die nh_e_mem 4
end
end
put nh_k n v
put nh_n 13 add n 1
end
note the parameter whose name token ends at p in the fn line [., q): its kind into nh_k; the position after it
fn nparam p ulong q ulong to ulong
a = skipsp p q
b = tfind a q 32
if eq a b
ret q
end
if or tteq a sub b a nh_kview tteq a sub b a nh_kedit
k = ulong 1
if tteq a sub b a nh_kedit
k = 2
end
put nh_n 14 1
kput k
c = tfind skipsp b q q 32
ret tfind skipsp c q q 32
end
if tteq a sub b a nh_kf32
kput 3
else
kput 0
end
ret b
end
note read the fn line at f: root name into slots 15, 16, parameter kinds into nh_k; false when malformed
fn nsig f ulong e ulong to bool
q = eol f e
a = skipsp add f len nh_kfn q
b = tfind a q 32
if eq a b
ret false
end
put nh_n 15 a
put nh_n 16 b
put nh_n 13 0
put nh_n 14 0
p = b
while lt p q bound 9223372036854775807
a = skipsp p q
c = tfind a q 32
if tteq a sub c a nh_kto
ret true
end
p = nparam c q
end
ret false
end
fn odecl fr bool to void
ot nh_d0
otr get nh_n 15 get nh_n 16
ot nh_d1
if not and fr eq get nh_n 14 0
oc 32
end
ot nh_d2
for k ulong get nh_n 13 bound 9223372036854775807
v = get nh_k k
if eq v 1
ot nh_pv
else
if eq v 2
ot nh_pe
else
if eq v 3
ot nh_pf
else
ot nh_ps
end
end
end
onum k
if or eq v 1 eq v 2
ot nh_ps
onum k
ot nh_pn
end
end
ot nh_d3
end
note one line [ls, lz) of the units list
fn nunit ls ulong lz ulong to void
if not tpre ls lz nh_kid
die nh_e_rec 3
end
if not tokval ls lz nh_kabi
die nh_e_rec 3
end
rt = tteq get nh_n 10 sub get nh_n 11 get nh_n 10 nh_abirt
fr = tteq get nh_n 10 sub get nh_n 11 get nh_n 10 nh_abifr
if not tokval ls lz nh_kpath
die nh_e_rec 3
end
s = get nh_n 10
e = get nh_n 11
x = tfind s e 61
if lt x e
s = add x 1
end
if eq s e
die nh_e_rec 3
end
c0 = get nh_n 2
if ncompose s e
c1 = get nh_n 2
f = lastfn c0 c1
if or eq f c1 not nsig f c1
r = write 2 nh_e_fn 0 len nh_e_fn
r = write 2 nh_t s sub e s
nlerr
exit 3
end
if or rt tpre c0 c1 nh_kom2
ot nh_rv
end
odecl fr
end
put nh_n 2 c0
end
fn main to int
tload nh_funits 4
tload nh_fsrc 6
tload nh_fmap 8
unitsok
ot nh_h1
ot nh_h2
ot nh_h3
ot nh_h4
ot nh_h5
ot nh_h6
ot nh_h7
ot nh_h8
p = get nh_n 4
e = get nh_n 5
while lt p e bound 9223372036854775807
q = eol p e
if eq q e
die nh_e_rec 3
end
nunit p q
p = add q 1
end
ot nh_tail
oflush
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note gpu/runtime/classes.om: what still blocks each C file of CUDApp src/ that no generator wrote and no Omega unit
note replaces, in seeded Omega (OM-2 program mode, Linux AArch64). Build and run from the repository root:
note   { printf 'om2\n'; cat gpu/runtime/classes.om; } | seed/out/omc > classes && ./classes > gpu/runtime/CLASSES.tsv
note Inputs: gpu/runtime/INVENTORY.tsv (written by inventory.om) and gpu/runtime/cudapp-cfacts.tsv (written by
note cfacts.om from a CUDApp checkout; the README says how). Every INVENTORY row of kind c, h or inc must have
note exactly one cudapp-cfacts.tsv row and the other way round, or the program refuses with exit 3.
note Output: a header, one row per INVENTORY row whose origin is unrecorded, tab separated
note   path kind class gen act pend fns omfn devfn hostl shell   (the last eight are cudapp-cfacts.tsv's facts)
note then summary lines starting with #. The class, applied in this order:
note   r  an Omega file in this repository replaces it (INVENTORY omega = rewritten)
note   c  a generator wrote it (gen = 1): the generator, not the file, is what to rewrite
note   d  no function in the default build, and lines kept only behind a pending flag (pend > 0), not a header:
note      the C kept as a reference for comparison
note   b  no function in the default build otherwise (a header of a C interface), or more lines in functions that
note      hand work to Omega or call a device word (shell) than in functions of host logic (hostl): a C entry point
note      over Omega or the chip, waiting for Omega to produce a C-callable library
note   a  more lines of host logic than of shell: C logic that an Omega rewrite can be checked against now
note Exit 0, 3 an input is missing, malformed or the two inputs disagree, 4 the host refused memory.
text cl_finv "gpu/runtime/INVENTORY.tsv"
text cl_fcf "gpu/runtime/cudapp-cfacts.tsv"
text cl_hinv "path\tkind\tomega_src\torigin\tomega\tdetail"
text cl_hcf "path\tgen\tact\tpend\tfns\tomfn\tdevfn\thostl\tshell"
text cl_hout "path\tkind\tclass\tgen\tact\tpend\tfns\tomfn\tdevfn\thostl\tshell\n"
text cl_unrec "unrecorded"
text cl_rewr "rewritten"
text cl_kc "c"
text cl_kh "h"
text cl_kinc "inc"
text cl_s_rows "# rows="
text cl_s_a "# class a: hostl="
text cl_s_b "# class b: shell="
text cl_s_d "# class d: pend="
text cl_s_shell " shell="
text cl_s_hostl " hostl="
text cl_s_files " files="
text cl_v "rabcd"
text cl_e_read "classes: cannot read "
text cl_e_hdr "classes: an input does not start with its header: "
text cl_e_num "classes: a cudapp-cfacts.tsv field is not a decimal number\n"
text cl_e_miss "classes: an INVENTORY row of kind c, h or inc has no cudapp-cfacts.tsv row: "
text cl_e_count "classes: cudapp-cfacts.tsv has rows that INVENTORY.tsv does not list as c, h or inc\n"
text cl_e_mem "classes: the host refused memory\n"
global cl_t uchar *
global cl_o uchar *
global cl_pa uchar 4096
note cl_n: 0 pool length, 1 output length, 2 3 INVENTORY.tsv's range, 4 5 cudapp-cfacts.tsv's range,
note 8 c/h/inc INVENTORY rows, 9 rows out, 10..14 rows of class r a b c d, 15 16 class a hostl shell,
note 17 18 class b shell hostl, 19 class d pend
global cl_n ulong 32
fn cldie t view uchar * code int to void
r = write 2 t 0 len t
exit code
end
fn cldier t view uchar * a ulong b ulong to void
r = write 2 t 0 len t
r = write 2 cl_t a sub b a
q = new uchar 1 10
r = write 2 q 0 1
exit 3
end
fn clgrow n ulong to void
if ge n len cl_t
r = enlarge cl_t add mul n 2 131072
if ne r 0
cldie cl_e_mem 4
end
end
end
note ---- output
fn cloc c ulong to void
n = get cl_n 1
if ge n len cl_o
r = enlarge cl_o add mul n 2 65536
if ne r 0
cldie cl_e_mem 4
end
end
put cl_o n uchar c
put cl_n 1 add n 1
end
fn clot t view uchar * to void
for i ulong len t bound 4096
cloc ulong get t i
end
end
fn clor a ulong b ulong to void
for i ulong sub b a bound 9223372036854775807
cloc ulong get cl_t add a i
end
end
fn clnum v ulong to void
if ge v 10
clnum div v 10
end
cloc add 48 rem v 10
end
fn clflush to void
n = get cl_n 1
o = ulong 0
while lt o n bound 9223372036854775807
x = write 1 cl_o o sub n o
if le x 0
exit 3
end
o = add o ulong x
end
end
note ---- input: the file named t appended to cl_t; slot k gets its start, k+1 its end
fn clload t view uchar * k ulong to void
for i ulong len t bound 4096
put cl_pa i get t i
end
f0 = fopen cl_pa 0 len t int 524288 int 0
fd = int f0
if lt fd 0
r = write 2 cl_e_read 0 len cl_e_read
cldie t 3
end
s = get cl_n 0
n = s
while true bound 9223372036854775807
clgrow add n 65536
x = read fd cl_t n sub len cl_t n
if lt x 0
r = write 2 cl_e_read 0 len cl_e_read
cldie t 3
end
if eq x 0
break
end
n = add n ulong x
end
r = fclose fd
put cl_n 0 n
put cl_n k s
put cl_n add k 1 n
end
note ---- ranges of cl_t
fn cleol p ulong e ulong to ulong
q = p
while lt q e bound 9223372036854775807
if eq get cl_t q 10
ret q
end
q = add q 1
end
ret e
end
note the end of the field that starts at p in a line ending at q
fn clfe p ulong q ulong to ulong
x = p
while lt x q bound 9223372036854775807
if eq get cl_t x 9
ret x
end
x = add x 1
end
ret q
end
note the start of field k of the line [p, q), or q when it has fewer fields
fn clfs p ulong q ulong k ulong to ulong
x = p
for j ulong k bound 9223372036854775807
x = clfe x q
if ge x q
ret q
end
x = add x 1
end
ret x
end
fn cleqt a ulong b ulong t view uchar * to bool
if ne sub b a len t
ret false
end
for i ulong len t bound 4096
if ne get cl_t add a i get t i
ret false
end
end
ret true
end
fn cleqr a ulong b ulong c ulong d ulong to bool
if ne sub b a sub d c
ret false
end
for i ulong sub b a bound 9223372036854775807
if ne get cl_t add a i get cl_t add c i
ret false
end
end
ret true
end
note field k of the line [p, q) as a decimal number
fn clfnum p ulong q ulong k ulong to ulong
a = clfs p q k
b = clfe a q
if ge a b
cldie cl_e_num 3
end
v = ulong 0
for i ulong sub b a bound 9223372036854775807
c = ulong get cl_t add a i
if or lt c 48 gt c 57
cldie cl_e_num 3
end
v = add mul v 10 sub c 48
end
ret v
end
note the cudapp-cfacts.tsv line (its start) whose path is cl_t[a, b), or the end of that file when none
fn clfind a ulong b ulong to ulong
e = get cl_n 5
p = cleol get cl_n 4 e
p = add p 1
while lt p e bound 9223372036854775807
q = cleol p e
f = clfe p q
if cleqr p f a b
ret p
end
p = add q 1
end
ret e
end
note each input starts with its header line
fn clhdr k ulong t view uchar * to void
s = get cl_n k
e = get cl_n add k 1
q = cleol s e
if not cleqt s q t
cldier cl_e_hdr s q
end
end
note the class of the INVENTORY line [p, q) whose facts line starts at c
fn clclass p ulong q ulong c ulong to ulong
o = clfs p q 4
if cleqt o clfe o q cl_rewr
ret 114
end
e = cleol c get cl_n 5
if eq clfnum c e 1 1
ret 99
end
if eq clfnum c e 4 0
k = clfs p q 1
if and gt clfnum c e 3 0 not cleqt k clfe k q cl_kh
ret 100
end
ret 98
end
if gt clfnum c e 7 clfnum c e 8
ret 97
end
ret 98
end
fn cladd k ulong v ulong to void
put cl_n k add get cl_n k v
end
note write the row of the INVENTORY line [p, q) and add it to the summary
fn clrow p ulong q ulong c ulong to void
e = cleol c get cl_n 5
cl = clclass p q c
k = clfs p q 1
clor p clfe p q
cloc 9
clor k clfe k q
cloc 9
cloc cl
cloc 9
f = clfs c e 1
clor f e
cloc 10
cladd 9 1
if eq cl 114
cladd 10 1
end
if eq cl 97
cladd 11 1
cladd 15 clfnum c e 7
cladd 16 clfnum c e 8
end
if eq cl 98
cladd 12 1
cladd 17 clfnum c e 8
cladd 18 clfnum c e 7
end
if eq cl 99
cladd 13 1
end
if eq cl 100
cladd 14 1
cladd 19 clfnum c e 3
end
end
note one INVENTORY line [p, q): check that a c, h or inc row has facts; write the row when unrecorded
fn clline p ulong q ulong to void
k = clfs p q 1
ke = clfe k q
if or or cleqt k ke cl_kc cleqt k ke cl_kh cleqt k ke cl_kinc
cladd 8 1
c = clfind p clfe p q
if ge c get cl_n 5
cldier cl_e_miss p clfe p q
end
o = clfs p q 3
if cleqt o clfe o q cl_unrec
clrow p q c
end
end
end
fn clsum to void
clot cl_s_rows
clnum get cl_n 9
cloc 32
for j ulong 5
cloc ulong get cl_v j
cloc 61
clnum get cl_n add 10 j
if lt j 4
cloc 32
end
end
cloc 10
clot cl_s_a
clnum get cl_n 15
clot cl_s_shell
clnum get cl_n 16
clot cl_s_files
clnum get cl_n 11
cloc 10
clot cl_s_b
clnum get cl_n 17
clot cl_s_hostl
clnum get cl_n 18
clot cl_s_files
clnum get cl_n 12
cloc 10
clot cl_s_d
clnum get cl_n 19
clot cl_s_files
clnum get cl_n 14
cloc 10
end
note every facts row has eight decimal fields after its path and no more
fn clrowok p ulong q ulong to void
for k ulong 8
v = clfnum p q add k 1
end
if lt clfs p q 9 q
cldie cl_e_num 3
end
end
fn main to int
clload cl_finv 2
clload cl_fcf 4
clhdr 2 cl_hinv
clhdr 4 cl_hcf
nf = ulong 0
e = get cl_n 5
p = add cleol get cl_n 4 e 1
while lt p e bound 9223372036854775807
q = cleol p e
clrowok p q
p = add q 1
nf = add nf 1
end
clot cl_hout
e = get cl_n 3
p = add cleol get cl_n 2 e 1
while lt p e bound 9223372036854775807
q = cleol p e
if ne get cl_t p 35
clline p q
end
p = add q 1
end
if ne nf get cl_n 8
cldie cl_e_count 3
end
clsum
clflush
ret 0
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/recovered-owners.sh compile=16 refusal=standalone-view standalone refusal at a view parameter: the gate that owns this unit composes it with the OM-2 core and seed/ng/sha256.om; composed qualification is that gate's, not claimed here

note SPDX-License-Identifier: Apache-2.0
note gpu/runtime/zsha.om: streaming SHA-256 over seed/ng/sha256.om's block buffer sh_dat, so a stream of any
note length hashes (sh_all alone stops at len sh_dat). Composed after seed/ng/sha256.om (OM-2 program mode) by
note gpu/runtime/inventory.om and gpu/runtime/gate.om. zbeg, then zbyte / zfd any number of times, then zend
note leaves the digest in sh_dig. zs_n 0 is the bytes held in sh_dat, zs_n 1 the stream length.
global zs_n ulong 2
fn zbeg to void
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
put zs_n 0 0
put zs_n 1 0
end
note hash every whole block held, keep the tail at the front of sh_dat
fn zdrain to void
f = get zs_n 0
nb = div f 64
for b ulong nb bound 9223372036854775807
sh_blk 0 mul b 64
end
o = mul nb 64
for j ulong sub f o bound 64
put sh_dat j get sh_dat add o j
end
put zs_n 0 sub f o
end
fn zbyte c ulong to void
f = get zs_n 0
put sh_dat f uchar c
put zs_n 0 add f 1
put zs_n 1 add get zs_n 1 1
if ge add f 1 len sh_dat
zdrain
end
end
note hash everything readable from fd into the stream; false on a read error (fd stays open)
fn zfd fd int to bool
while true bound 9223372036854775807
f = get zs_n 0
if ge f len sh_dat
zdrain
f = get zs_n 0
end
x = read fd sh_dat f sub len sh_dat f
if lt x 0
ret false
end
if eq x 0
ret true
end
put zs_n 0 add f ulong x
put zs_n 1 add get zs_n 1 ulong x
end
ret true
end
fn zend to void
zdrain
r = get zs_n 0
n = get zs_n 1
for j ulong 128
put sh_pad j 0
end
for j ulong r bound 64
put sh_pad j get sh_dat j
end
put sh_pad r 128
e = ulong 64
if ge r 56
e = 128
end
bits = mul n 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end

note SPDX-License-Identifier: Apache-2.0
note gpu/runtime/cfacts-main.om: the program cfacts ROOT [DIR]; gpu/runtime/cfacts.om says how to build and run it.
fn main to int
c = argcnt
if or lt c 2 gt c 3
die cf_e_usage 2
end
r = argread 1 cf_root 0 4000
if lt r 1
die cf_e_usage 2
end
put cf_n 21 ulong r
if eq c 3
r = argread 2 cf_dir 0 4000
if lt r 1
die cf_e_usage 2
end
put cf_n 1 ulong r
else
for i ulong len cf_dflt
put cf_dir i get cf_dflt i
end
put cf_n 1 len cf_dflt
end
pdir cf_fsrc
tload 4
pdir cf_fid
tload 6
pdir cf_fdev
tload 8
cfrun false
ret 0
end

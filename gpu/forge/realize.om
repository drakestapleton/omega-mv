fn fg_emit_receipt_seals fd int seals view ForgeSeals to void
d = new uchar 32 0
fg_write_all fd fg_t_reqd
fg_seals_get_req seals d
fg_write_hex32 fd d
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_descd
fg_seals_get_desc seals d
fg_write_hex32 fd d
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_planid
fg_seals_get_plan seals d
fg_write_hex32 fd d
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_seal
fg_seals_get_tok seals d
fg_write_hex32 fd d
fg_write_all fd fg_t_nl
ret
end

fn fg_emit_receipt_metrics fd int plan view ForgePlan env view ForgeEnvCheck to void
fg_write_all fd fg_t_prov
fg_write_u64 fd ulong get plan prov_id
fg_write_all fd fg_t_sp_hw
fg_emit_hw_name fd get plan hw_id
fg_write_all fd fg_t_sp_sub
fg_emit_sub_name fd get plan substrate_class
fg_write_all fd fg_t_sp_qual
fg_emit_qual_name fd get plan qual_status
fg_write_all fd fg_t_sp_low
fg_emit_low_name fd get plan lowering_kind
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_geom
fg_write_u64 fd ulong get plan tile_m
fg_write_all fd fg_t_x
fg_write_u64 fd ulong get plan tile_n
fg_write_all fd fg_t_x
fg_write_u64 fd ulong get plan tile_k
fg_write_all fd fg_t_sp_grid
fg_write_u64 fd ulong get plan grid_x
fg_write_all fd fg_t_x
fg_write_u64 fd ulong get plan grid_y
fg_write_all fd fg_t_sp_blk
fg_write_u64 fd ulong get plan block_x
fg_write_all fd fg_t_sp_ctas
fg_write_u64 fd ulong get env eff_ctas
fg_write_all fd fg_t_sp_wav
fg_write_u64 fd ulong get plan waves
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_phys
fg_write_u64 fd get env ws_bytes
fg_write_all fd fg_t_sp_tr
fg_write_u64 fd get env traffic_bytes
fg_write_all fd fg_t_sp_fl
fg_write_u64 fd get env flops
fg_write_all fd fg_t_sp_bnd
if eq get plan compute_bound 1
fg_write_all fd fg_t_comp
else
fg_write_all fd fg_t_bw
end
fg_write_all fd fg_t_roof
fg_write_f64_3 fd get env roof_us
fg_write_all fd fg_t_sp_ai
fg_write_f64_3 fd get env arith_int
fg_write_all fd fg_t_sp_pw
fg_write_f64_2 fd get env est_power_w
fg_write_all fd fg_t_sp_en
fg_write_f64_3 fd get env est_energy_mj
fg_write_all fd fg_t_nl
ret
end

note Emit full canonical receipt block to fd
fn fg_emit_receipt fd int req view ForgeContract plan view ForgePlan env view ForgeEnvCheck seals view ForgeSeals to void
fg_write_all fd fg_t_rcpt_hdr
if eq get plan admitted 1
fg_write_all fd fg_t_dec_adm
else
fg_write_all fd fg_t_dec_ref
end
fg_write_all fd fg_t_status
fg_emit_status_name fd get plan status
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_viol
fg_emit_viol_name fd get plan violation
fg_write_all fd fg_t_nl
fg_write_all fd fg_t_req_id
fg_write_u64 fd get req req_id
fg_write_all fd fg_t_sp_op
fg_emit_op_name fd get req op_class
fg_write_all fd fg_t_sp_dt
fg_emit_dt_name fd get req dtype
fg_write_all fd fg_t_sp_sh
fg_write_u64 fd get req dim_m
fg_write_all fd fg_t_x
fg_write_u64 fd get req dim_n
fg_write_all fd fg_t_x
fg_write_u64 fd get req dim_k
fg_write_all fd fg_t_x
fg_write_u64 fd get req batch
fg_write_all fd fg_t_nl
fg_emit_receipt_metrics fd plan env
fg_emit_receipt_seals fd seals
fg_write_all fd fg_t_rcpt_end
ret
end

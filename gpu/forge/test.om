end
if ne fg_env_clamp_wave 96 48 48
ret false
end
put req cta_req uint 0
if ne fg_env_check hid hcap req bud env FG_ENV_OK
ret false
end
if ne get env eff_ctas 48
ret false
end
if ne get env waves 1
ret false
end
ret true
end


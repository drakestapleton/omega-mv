note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/forge/hardware.om: FORGE physical machine descriptors, canonical SHA-256
note digesting, V1 GB10 KAT verification, and strict physical bounds validation.
note Ported from physics-mv (forge/forge_descriptor.{h,c}, forge/v2/forge_substrate_v2.h,
note contracts/native-dgx-spark-draft.json).
note Composable OM-2 library module (compose after si/directives/om2.om).

note ---- Core FORGE Data Structures (all structs declared before first fn) ----

struct ForgeHwId hw_id uint substrate_class uint pci_vendor uint pci_device uint rm_compute_class uint rm_sm_version uint sm_count uint warp_size uint max_warps_sm uint max_thr_cta uint max_gpr uint obs_flags uint end

struct ForgeHwCap smem_cta uint smem_sm uint mem_total ulong mem_avail ulong bw_gbps f64 peak_fp32_tf f64 dtype_flags uint feature_flags uint op_flags uint max_power_w f64 max_temp_mc int max_queues uint end

struct ForgeContract req_id ulong op_class uint dtype uint dim_m ulong dim_n ulong dim_k ulong batch ulong cta_req uint thr_req uint smem_req uint gpr_req uint extra_ws ulong error_kind uint req_substrate uint req_qual uint req_wave_cap uint end

struct ForgeBudget lat_us f64 energy_mj f64 power_w f64 temp_mc int now_epoch_s ulong supply_uv uint end

struct ForgeEnvCheck ok uint violation uint ws_bytes ulong traffic_bytes ulong flops ulong eff_ctas uint eff_thr uint waves uint arith_int f64 comp_us f64 bw_us f64 roof_us f64 est_power_w f64 est_energy_mj f64 compute_bound uint end

struct ForgeProvider prov_id uint hw_id uint substrate_class uint qual_status uint error_kind uint cal_req uint cal_epoch_s ulong cal_window_s ulong cal_tmin_mc int cal_tmax_mc int fault_state uint active_queues uint lowering_kind uint end

struct ForgeAdmit admitted uint status uint prov_id uint hw_id uint env_viol uint has_dig_fb uint elig_cnt uint end

struct ForgePlan admitted uint status uint violation uint prov_id uint hw_id uint substrate_class uint qual_status uint lowering_kind uint tile_m uint tile_n uint tile_k uint grid_x uint grid_y uint block_x uint waves uint compute_bound uint end

struct ForgeSeals plan_id ulong 4 desc_hash ulong 4 req_hash ulong 4 aegis_tok ulong 4 end


note ---- Pure-Omega FIPS 180-4 SHA-256 (self-contained, stateless) ----

fn fg_sha_kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
ret
end

fn fg_sha_be32 b view uchar 64 off ulong to uint
b0 = uint get b off
b1 = uint get b add off 1
b2 = uint get b add off 2
b3 = uint get b add off 3
t0 = or shl b0 24 shl b1 16
t1 = or shl b2 8 b3
ret or t0 t1
end

fn fg_sha_sched blk view uchar 64 w edit uint 64 to void
for i ulong 16
off = mul i 4
put w i fg_sha_be32 blk off
end
i = ulong 16
while lt i 64 bound 48
x1 = get w sub i 15
s0 = xor xor rotr x1 7 rotr x1 18 shr x1 3
x2 = get w sub i 2
s1 = xor xor rotr x2 17 rotr x2 19 shr x2 10
v = add add get w sub i 16 s0 add get w sub i 7 s1
put w i v
i = add i 1
end
ret
end

fn fg_sha_t1 e uint f uint g uint h uint kw uint to uint
s1 = xor xor rotr e 6 rotr e 11 rotr e 25
ch = xor and e f and not e g
ret add add add h s1 ch kw
end

fn fg_sha_t2 a uint b uint c uint to uint
s0 = xor xor rotr a 2 rotr a 13 rotr a 22
maj = xor xor and a b and a c and b c
ret add s0 maj
end

fn fg_sha_round v edit uint 8 ki uint wi uint to void
kw = add ki wi
t1 = fg_sha_t1 get v 4 get v 5 get v 6 get v 7 kw
t2 = fg_sha_t2 get v 0 get v 1 get v 2
put v 7 get v 6
put v 6 get v 5
put v 5 get v 4
put v 4 add get v 3 t1
put v 3 get v 2
put v 2 get v 1
put v 1 get v 0
put v 0 add t1 t2
ret
end

fn fg_sha_compress st edit uint 8 blk view uchar 64 k view uint 64 to void
w = new uint 64 0
fg_sha_sched blk w
v = new uint 8 0
for i ulong 8
put v i get st i
end
for i ulong 64
fg_sha_round v get k i get w i
end
for i ulong 8
put st i add get st i get v i
end
ret
end

fn fg_sha_store st view uint 8 dst edit uchar 32 to void
for i ulong 8
v = get st i
off = mul i 4
put dst off uchar and shr v 24 0xff
put dst add off 1 uchar and shr v 16 0xff
put dst add off 2 uchar and shr v 8 0xff
put dst add off 3 uchar and v 0xff
end
ret
end

fn fg_sha256 msg view uchar * dst edit uchar 32 to void
st = new uint 8 0
put st 0 0x6a09e667
put st 1 0xbb67ae85
put st 2 0x3c6ef372
put st 3 0xa54ff53a
put st 4 0x510e527f
put st 5 0x9b05688c
put st 6 0x1f83d9ab
put st 7 0x5be0cd19
k = new uint 64 0
fg_sha_kinit k
blk = new uchar 64 0
n = len msg
pos = ulong 0
while le add pos 64 n bound 256
for j ulong 64
put blk j get msg add pos j
end
fg_sha_compress st blk k
pos = add pos 64
end
remn = sub n pos
for j ulong 64
put blk j uchar 0
end
j = ulong 0
while lt j remn bound 64
put blk j get msg add pos j
j = add j 1
end
put blk remn uchar 0x80
if ge remn 56
fg_sha_compress st blk k
for z ulong 64
put blk z uchar 0
end
end
bits = mul n 8
put blk 56 uchar and shr bits 56 0xff
put blk 57 uchar and shr bits 48 0xff
put blk 58 uchar and shr bits 40 0xff
put blk 59 uchar and shr bits 32 0xff
put blk 60 uchar and shr bits 24 0xff
put blk 61 uchar and shr bits 16 0xff
put blk 62 uchar and shr bits 8 0xff
put blk 63 uchar and bits 0xff
fg_sha_compress st blk k
fg_sha_store st dst
ret
end

note ---- Little-Endian Serialization Helpers ----

fn fg_put_u16 buf edit uchar * off ulong v uint to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
ret
end

fn fg_put_u32 buf edit uchar * off ulong v uint to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
ret
end

fn fg_put_u64 buf edit uchar * off ulong v ulong to void
put buf off uchar and v 0xff
put buf add off 1 uchar and shr v 8 0xff
put buf add off 2 uchar and shr v 16 0xff
put buf add off 3 uchar and shr v 24 0xff
put buf add off 4 uchar and shr v 32 0xff
put buf add off 5 uchar and shr v 40 0xff
put buf add off 6 uchar and shr v 48 0xff
put buf add off 7 uchar and shr v 56 0xff
ret
end

fn fg_copy_bytes dst edit uchar * doff ulong src view uchar * n ulong to void
i = ulong 0
while lt i n bound 256
put dst add doff i get src i
i = add i 1
end
ret
end

fn fg_hex_nibble v uint to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add sub v 10 97
end

fn fg_digest_to_hex dig view uchar 32 dst edit uchar 64 to void
for i ulong 32
b = uint get dig i
put dst mul i 2 fg_hex_nibble and shr b 4 0xf
put dst add mul i 2 1 fg_hex_nibble and b 0xf
end
ret
end

fn fg_bytes_eq a view uchar * b view uchar * n ulong to bool
if lt len a n
ret false
end
if lt len b n
ret false
end
i = ulong 0
while lt i n bound 256
if ne get a i get b i
ret false
end
i = add i 1
end
ret true
end

note ---- Physical Machine Descriptors ----

fn fg_hw_load_gb10 hid edit ForgeHwId hcap edit ForgeHwCap to void
note DGX Spark GB10 Blackwell (sm_121): 48 SMs, 6144 cores, 273 GB/s unified LPDDR5x
put hid hw_id FG_HW_GB10_SM121
put hid substrate_class FG_SUB_DIGITAL_GPU
put hid pci_vendor uint 0x10de
put hid pci_device uint 0x2e12
put hid rm_compute_class uint 0x0000cec0
put hid rm_sm_version uint 0x00000a04
put hid sm_count uint 48
put hid warp_size uint 32
put hid max_warps_sm uint 48
put hid max_thr_cta uint 1024
put hid max_gpr uint 128
put hid obs_flags uint 0x1ffff
put hcap smem_cta uint 49152
put hcap smem_sm uint 233472
put hcap mem_total ulong 130660888576
put hcap mem_avail ulong 126917984256
put hcap bw_gbps 273.0f64
put hcap peak_fp32_tf 31.0f64
put hcap dtype_flags uint 0xff
put hcap feature_flags uint 0x3f
put hcap op_flags uint 0x1df
put hcap max_power_w 140.0f64
put hcap max_temp_mc int 85000
put hcap max_queues uint 4
ret
end


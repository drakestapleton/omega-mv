end

fn fg_seals_put_tok s edit ForgeSeals d view uchar 32 to void
for i ulong 4
put s aegis_tok i fg_pack_be64 d mul i 8
end
ret
end

fn fg_seals_get_tok s view ForgeSeals d edit uchar 32 to void

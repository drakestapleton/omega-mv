fn fg_hw_load_profile pid uint hid edit ForgeHwId hcap edit ForgeHwCap to bool
if eq pid FG_HW_GB10_SM121
fg_hw_load_gb10 hid hcap
ret true
end
if eq pid FG_HW_AARCH64_GRACE
fg_hw_load_grace hid hcap
ret true
end
if eq pid FG_HW_GENERIC_CPU
fg_hw_load_generic_cpu hid hcap
ret true
end
if eq pid FG_HW_ANALOG_SIM
fg_hw_load_analog_sim hid hcap
ret true
end
if eq pid FG_HW_UNQUAL_GPU
fg_hw_load_unqual_gpu hid hcap
ret true
end
if eq pid FG_HW_OPTICAL_SIM
fg_hw_load_optical hid hcap
ret true
end
ret false
end

note ---- Substrate Class & Alias Verification ----

fn fg_sub_is_known sc uint to bool
if eq sc FG_SUB_DIGITAL_CPU
ret true
end
if eq sc FG_SUB_DIGITAL_GPU
ret true
end
if eq sc FG_SUB_ANALOG_IN_MEMORY
ret true
end
if eq sc FG_SUB_NEUROMORPHIC
ret true
end
if eq sc FG_SUB_FPGA_CGRA
ret true
end
if eq sc FG_SUB_OPTICAL_PHOTONIC
ret true
end
ret false
end

fn fg_sub_is_digital sc uint to bool
if eq sc FG_SUB_DIGITAL_CPU
ret true
end
if eq sc FG_SUB_DIGITAL_GPU
ret true
end
ret false
end

note Matches forge_descriptor.c:495: sm_121 derived strictly from observed RM fields
fn fg_hw_alias_is_sm121 hid view ForgeHwId to bool
if eq get hid rm_compute_class uint 0x0000cec0
if eq get hid rm_sm_version uint 0x00000a04
ret true
end
end
ret false
end

note ---- Strict Physical Bounds Validation ----

fn fg_hw_validate hid view ForgeHwId hcap view ForgeHwCap to uint
sc = get hid substrate_class
if not fg_sub_is_known sc
ret FG_HWVAL_BAD_SUBSTRATE
end
if eq get hid sm_count 0
ret FG_HWVAL_BAD_GEOMETRY
end
if eq get hid warp_size 0
ret FG_HWVAL_BAD_GEOMETRY
end
if eq get hid max_warps_sm 0
ret FG_HWVAL_BAD_GEOMETRY
end
if eq get hid max_thr_cta 0
ret FG_HWVAL_BAD_GEOMETRY
end
if eq get hid max_gpr 0
ret FG_HWVAL_BAD_GEOMETRY
end
mt = get hcap mem_total
ma = get hcap mem_avail
if eq mt 0
ret FG_HWVAL_BAD_MEMORY
end
if eq ma 0
ret FG_HWVAL_BAD_MEMORY
end
if gt ma mt
ret FG_HWVAL_BAD_MEMORY
end
if gt get hcap smem_cta get hcap smem_sm
ret FG_HWVAL_BAD_MEMORY
end
if le get hcap bw_gbps 0.0f64
ret FG_HWVAL_BAD_ROOFLINE
end
if le get hcap peak_fp32_tf 0.0f64
ret FG_HWVAL_BAD_ROOFLINE
end
if le get hcap max_power_w 0.0f64
ret FG_HWVAL_BAD_THERMAL
end
tmc = get hcap max_temp_mc
if le tmc 0
ret FG_HWVAL_BAD_THERMAL
end
if gt tmc 125000
ret FG_HWVAL_BAD_THERMAL
end
if eq get hcap dtype_flags 0
ret FG_HWVAL_BAD_CAPS
end
if eq get hcap op_flags 0
ret FG_HWVAL_BAD_CAPS
end
if eq get hcap max_queues 0
ret FG_HWVAL_BAD_CAPS
end
if fg_hw_alias_is_sm121 hid
if ne get hid pci_vendor uint 0x10de
ret FG_HWVAL_BAD_GB10_ID
end
if ne get hid warp_size 32
ret FG_HWVAL_BAD_GB10_ID
end
if gt get hid max_gpr 128
ret FG_HWVAL_BAD_GB10_ID
end
end
ret FG_HWVAL_OK
end

note ---- Canonical Hardware Descriptor Digest (SHA-256) ----

fn fg_hw_digest hid view ForgeHwId hcap view ForgeHwCap dst edit uchar 32 to void
buf = new uchar 128 0
put buf 0 uchar 70
put buf 1 uchar 71
put buf 2 uchar 72
put buf 3 uchar 87
put buf 4 uchar 45
put buf 5 uchar 86
put buf 6 uchar 49
put buf 7 uchar 0
fg_put_u32 buf 8 get hid hw_id
fg_put_u32 buf 12 get hid substrate_class
fg_put_u32 buf 16 get hid pci_vendor
fg_put_u32 buf 20 get hid pci_device
fg_put_u32 buf 24 get hid rm_compute_class
fg_put_u32 buf 28 get hid rm_sm_version
fg_put_u32 buf 32 get hid sm_count
fg_put_u32 buf 36 get hid warp_size
fg_put_u32 buf 40 get hid max_warps_sm
fg_put_u32 buf 44 get hid max_thr_cta
fg_put_u32 buf 48 get hid max_gpr
fg_put_u32 buf 52 get hid obs_flags
fg_put_u32 buf 56 get hcap smem_cta
fg_put_u32 buf 60 get hcap smem_sm
fg_put_u64 buf 64 get hcap mem_total
fg_put_u64 buf 72 get hcap mem_avail
bw_m = ulong mul get hcap bw_gbps 1000.0f64
fg_put_u64 buf 80 bw_m
tf_m = ulong mul get hcap peak_fp32_tf 1000.0f64
fg_put_u64 buf 88 tf_m
fg_put_u32 buf 96 get hcap dtype_flags
fg_put_u32 buf 100 get hcap feature_flags
fg_put_u32 buf 104 get hcap op_flags
pw_m = ulong mul get hcap max_power_w 1000.0f64
fg_put_u64 buf 108 pw_m
fg_put_u32 buf 116 uint get hcap max_temp_mc
fg_put_u32 buf 120 get hcap max_queues
fg_put_u32 buf 124 uint 0
fg_sha256 buf dst
ret
end

note ---- V1 GB10 208-byte Canonical Serialization Known Answer Test (KAT) ----
note Exact match for physics-mv/forge/forge_descriptor.c:447-493
note Expected SHA-256: 10d63d05f888eaba4fe473c5f17febe22f462f543ae0c2b005a9a8e5417e09fd

fn fg_hw_v1_kat_build buf edit uchar 208 to void
fg_put_u16 buf 0 uint 0x10de
fg_put_u16 buf 2 uint 0x2e12
fg_put_u16 buf 4 uint 0x10de
fg_put_u16 buf 6 uint 0x0000
fg_copy_bytes buf 8 fg_kat_bdf len fg_kat_bdf
for i ulong 16
put buf add 24 i uchar add i 1
end
fg_put_u32 buf 40 uint 0x0000cec0
fg_put_u32 buf 44 uint 0x00000a04
fg_put_u32 buf 48 uint 32
fg_put_u32 buf 52 uint 48
fg_put_u32 buf 56 uint 6144
fg_put_u32 buf 60 uint 2
fg_copy_bytes buf 64 fg_kat_drv len fg_kat_drv
fg_copy_bytes buf 96 fg_kat_vbios len fg_kat_vbios
fg_copy_bytes buf 128 fg_kat_drv len fg_kat_drv
fg_put_u64 buf 160 ulong 130660888576
fg_put_u64 buf 168 ulong 0x1ffffffffff
fg_put_u32 buf 176 uint 4096
fg_put_u32 buf 180 uint 1024
fg_put_u32 buf 184 uint 49152
fg_put_u32 buf 188 uint 0x1f
fg_put_u32 buf 192 uint 0x1ffff
ret
end

fn fg_hw_v1_kat to bool
buf = new uchar 208 0
fg_hw_v1_kat_build buf
dig = new uchar 32 0
fg_sha256 buf dig
hex = new uchar 64 0
fg_digest_to_hex dig hex
ret fg_bytes_eq hex fg_kat_hex 64
end

note ---- Pack/Unpack 32-byte Digests <-> 4x u64 Words (for ForgeSeals) ----

fn fg_pack_be64 b view uchar 32 off ulong to ulong
r = ulong 0
for i ulong 8
v = ulong get b add off i
r = or shl r 8 v
end
ret r
end

fn fg_unpack_be64 v ulong dst edit uchar 32 off ulong to void
put dst off uchar and shr v 56 0xff
put dst add off 1 uchar and shr v 48 0xff
put dst add off 2 uchar and shr v 40 0xff
put dst add off 3 uchar and shr v 32 0xff
put dst add off 4 uchar and shr v 24 0xff
put dst add off 5 uchar and shr v 16 0xff
put dst add off 6 uchar and shr v 8 0xff
put dst add off 7 uchar and v 0xff
ret
end

fn fg_seals_put_plan s edit ForgeSeals d view uchar 32 to void
for i ulong 4
put s plan_id i fg_pack_be64 d mul i 8
end
ret
end

fn fg_seals_get_plan s view ForgeSeals d edit uchar 32 to void
for i ulong 4
fg_unpack_be64 get s plan_id i d mul i 8
end
ret
end

fn fg_seals_put_desc s edit ForgeSeals d view uchar 32 to void
for i ulong 4
put s desc_hash i fg_pack_be64 d mul i 8
end
ret
end

fn fg_seals_get_desc s view ForgeSeals d edit uchar 32 to void
for i ulong 4
fg_unpack_be64 get s desc_hash i d mul i 8
end
ret
end

fn fg_seals_put_req s edit ForgeSeals d view uchar 32 to void
for i ulong 4
put s req_hash i fg_pack_be64 d mul i 8
end
ret
end

fn fg_seals_get_req s view ForgeSeals d edit uchar 32 to void

note SPDX-License-Identifier Apache-2.0 WITH LLVM-exception
note L441 host check. XORWOW is Marsaglia, J. Stat. Soft. 8(14), 2003, page 5, from the published state
note Metric: Berlekamp-Massey linear complexity over GF(2) of each output bit, first 1000 outputs
note An ideal bit scores about 500. Raw XORWOW bit 0 scores 162 and bit 1 scores 323
note The fold mix o xor (o shr 16) is a bijection on 32 bits and lifts every bit to about 500
note Expected values are the Wolfram receipts in evidence/xorwow-mix-20261109/README.md
note Prints one line of 32 scores for raw and one for fold. Exit 0 only if all checks hold
note Not curand: the fold changes every output word. Not the GPU
global xmst ulong 6
global xmow ulong 1000
global xmsq ulong 1000
global xmcc ulong 1001
global xmbb ulong 1001
global xmtt ulong 1001
global xmob uchar 24
global xmlc ulong 64
text xmlraw "raw "
text xmlfold "fold"
text xmlnl "\n"
fn xmixmask x ulong to ulong
ret and x 4294967295
end
fn xmixinit to void
put xmst 0 ulong 123456789
put xmst 1 ulong 362436069
put xmst 2 ulong 521288629
put xmst 3 ulong 88675123
put xmst 4 ulong 5783321
put xmst 5 ulong 6615241
end
fn xmixstep to ulong
t = xmixmask xor get xmst 0 shr get xmst 0 2
old4 = get xmst 4
put xmst 0 get xmst 1
put xmst 1 get xmst 2
put xmst 2 get xmst 3
put xmst 3 old4
n4 = xmixmask xor xor old4 shl old4 4 xor t shl t 1
put xmst 4 n4
d = xmixmask add get xmst 5 362437
put xmst 5 d
ret xmixmask add n4 d
end
fn xmixfold o ulong to ulong
ret xor o shr o 16
end
fn xmixbits k ulong fold ulong to void
i = ulong 0
while lt i 1000 bound 1000
o = get xmow i
if eq fold 1
o = xmixfold o
end
put xmsq i and shr o k 1
i = add i 1
end
end
fn xmixdisc i ulong lc ulong to ulong
d = get xmsq i
j = ulong 1
while le j lc bound 1001
d = xor d and get xmcc j get xmsq sub i j
j = add j 1
end
ret d
end
fn xmixsave to void
j = ulong 0
while le j 1000 bound 1001
put xmtt j get xmcc j
j = add j 1
end
end
fn xmixrest to void
j = ulong 0
while le j 1000 bound 1001
put xmbb j get xmtt j
j = add j 1
end
end
fn xmixfix sh ulong to void
j = sh
while le j 1000 bound 1001
put xmcc j xor get xmcc j get xmbb sub j sh
j = add j 1
end
end
fn xmixbm to ulong
j = ulong 0
while le j 1000 bound 1001
put xmcc j ulong 0
put xmbb j ulong 0
j = add j 1
end
put xmcc 0 ulong 1
put xmbb 0 ulong 1
lc = ulong 0
mp = ulong 0
i = ulong 0
while lt i 1000 bound 1000
d = xmixdisc i lc
if eq d 1
xmixsave
xmixfix sub add i 1 mp
if le mul 2 lc i
lc = sub add i 1 lc
mp = add i 1
xmixrest
end
end
i = add i 1
end
ret lc
end
fn xmixnum v ulong to int
x = v
p = ulong 23
while lt p 24 bound 21
put xmob p uchar add 48 rem x 10
x = div x 10
if eq x 0
break
end
p = sub p 1
end
p = sub p 1
put xmob p uchar 32
n = sub 24 p
k = write 1 xmob p n
if ne k long n
ret 1
end
ret 0
end
fn xmixline fold ulong to int
if eq fold 1
k = write 1 xmlfold 0 len xmlfold
else
k = write 1 xmlraw 0 len xmlraw
end
b = ulong 0
while lt b 32 bound 32
r = xmixnum get xmlc add mul fold 32 b
if ne r 0
ret 1
end
b = add b 1
end
k = write 1 xmlnl 0 len xmlnl
ret 0
end
fn xmixfirst to int
if ne get xmow 0 246875399
ret 1
end
if ne get xmow 1 3690007200
ret 1
end
if ne get xmow 2 1264581005
ret 1
end
if ne get xmow 3 3906711041
ret 1
end
if ne get xmow 4 1866187943
ret 1
end
if ne get xmow 5 2481925219
ret 1
end
if ne get xmow 6 2464530826
ret 1
end
if ne get xmow 7 1604040631
ret 1
end
ret 0
end
fn xmixlow fold ulong to ulong
c = ulong 0
b = ulong 0
while lt b 32 bound 32
if lt get xmlc add mul fold 32 b 480
c = add c 1
end
b = add b 1
end
ret c
end
fn main to int
xmixinit
i = ulong 0
while lt i 1000 bound 1000
put xmow i xmixstep
i = add i 1
end
f = ulong 0
while lt f 2 bound 2
b = ulong 0
while lt b 32 bound 32
xmixbits b f
put xmlc add mul f 32 b xmixbm
b = add b 1
end
f = add f 1
end
if ne xmixline 0 0
ret 2
end
if ne xmixline 1 0
ret 2
end
if ne xmixfirst 0
ret 10
end
if ne get xmlc 0 162
ret 20
end
if ne get xmlc 1 323
ret 21
end
if ne xmixlow 0 2
ret 22
end
if ne xmixlow 1 0
ret 30
end
ret 0
end

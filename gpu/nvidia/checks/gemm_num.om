note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/gemm_num.om: the Omega port of CUDApp tests/gemm_ex_om_num_test.c. Composed after
note gpu/nvidia/om/gemmex/num.om, gpu/nvidia/om/gemmex/probe.om and gpu/nvidia/checks/lib.om; run with
note gpu/nvidia/checks/gemm_num.tsv, whose rows the C number formats of the old test wrote over a sweep.
note Each row is one sweep and holds the FNV-1a-64 digest of every answer the C gave in it, so every answer is
note compared without storing each one. The check regenerates the inputs and digests gx_probe's answers:
note r OP X0 XEND STEP N DIGEST   ops 0 to 4 at x = X0, X0+STEP, ... below XEND (N of them)
note x N DIGEST                   op 5 over the first N words of the old test's xorshift stream (odd steps: an f32
note                              widened to f64, its low 12 bits flipped on every other one of them)
note b T N DIGEST                 op 6 for kind T over every 16-bit u (kind 0 reads u << 16 | u), N = 65536
text t_name "GEMM_NUM"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn gxfnv h ulong v ulong to ulong
ret mul xor h v 1099511628211
end
fn gxsweep op ulong x0 ulong xend ulong step ulong n ulong to ulong
h = ulong 14695981039346656037
for j ulong n bound 4294967296
h = gxfnv h gx_probe op add x0 mul j step
end
ret h
end
fn gxstream n ulong to ulong
s = ulong 88172645463325252
h = ulong 14695981039346656037
for i ulong n bound 4294967296
s = xor s shl s 13
s = xor s shr s 7
s = xor s shl s 17
d = s
if ne and i 1 0
d = bitcast ulong f64 bitcast f32 uint shr s 32
if eq and i 2 0
d = xor d and s 4095
end
end
h = gxfnv h gx_probe 5 d
end
ret h
end
fn gxbad t ulong to ulong
h = ulong 14695981039346656037
for u ulong 65536
v = u
if eq t 0
v = or shl u 16 u
end
h = gxfnv h gx_probe 6 or shl t 32 v
end
ret h
end
fn crow to bool
k = ckch 0 0
if eq k 114
if ne ckcnt 7
ckbad
end
op = cknum 1
x0 = cknum 2
xend = cknum 3
step = cknum 4
if or or gt op 4 eq step 0 or ge x0 xend gt xend 4294967296
ckbad
end
n = div add sub xend x0 sub step 1 step
if ne n cknum 5
ret false
end
ret eq gxsweep op x0 xend step n cknum 6
end
if eq k 120
if ne ckcnt 3
ckbad
end
ret eq gxstream cknum 1 cknum 2
end
if eq k 98
if ne ckcnt 4
ckbad
end
t = cknum 1
if or gt t 4 ne cknum 2 65536
ckbad
end
ret eq gxbad t cknum 3
end
ckbad
ret false
end

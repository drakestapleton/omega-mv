note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-victim.om: arvictim (gpu/nvidia/om/apirest/victim.om); Q is its 8 q words and 17 records of 8 bytes as in arest-cache.om; q after the call is output 64 on. Composed before arest.om.
text t_name "AREST-VICTIM"
text t_au "victim"
note the 17 records from word s of q, 8 bytes each, little-endian
fn arrec q view ulong 64 s ulong x edit uchar 136 to void
for i ulong 17
w = get q add s i
c = mul i 8
for b ulong 8
put x add c b uchar and shr w mul b 8 255
end
end
end
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if or ne nq 25 ne ny 0
ckbad
end
a = new ulong 8 0
for i ulong 8
put a i get q i
end
x = new uchar 136 0
arrec q 8 x
r = arvictim a x
for i ulong 8
put o add 64 i get a i
end
ret r
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-buf.om: av_copy (gpu/nvidia/om/api/attn_buf.om) against av_memcpy of CUDApp src/omega_attn_views.h;
note A and B are uchar; copies the first n of A into B; h over B. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-BUF"
text t_au "buf"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new uchar 1000003 0
d = new uchar 1000003 0
avgc s a l
avgc d b l
put o 0 av_copy s d n
put o 1 avhc d l
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-fillf.om: av_fillf (gpu/nvidia/om/api/attn_fillf.om) against av_fillf32 of CUDApp src/omega_attn_views.h;
note A is f32; sets the first n to the f32 of bits v; h over the bits of A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-FILLF"
text t_au "fillf"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
d = new f32 1000003 f32 0
avgf d a l
put o 0 av_fillf d n bitcast f32 uint and v 4294967295
put o 1 avhf d l
end

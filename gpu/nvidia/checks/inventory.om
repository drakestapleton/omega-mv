om2
note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/inventory.om: writes gpu/nvidia/checks/INVENTORY.tsv, the inventory of the files of CUDApp
note tests/ and tools/ that are not Omega, in seeded Omega (Linux AArch64). Nobody types that table: this program
note derives it from the files themselves, the list of Omega files under gpu/ and the decisions in ports.tsv.
note Build from the omega-mv root:  seed/out/omc < gpu/nvidia/checks/inventory.om > inventory
note Run from the CUDApp checkout root:  inventory LIST GPULIST PORTS LABEL > INVENTORY.tsv
note LIST     the paths of CUDApp tests/ and tools/, one per line (git ls-files tests tools); a path ending in .om
note          is skipped (those are Omega already)
note GPULIST  the paths of the files under gpu/ of the omega-mv head the inventory is read against, one per line
note PORTS    gpu/nvidia/checks/ports.tsv: PATH, a tab, ported|retired|blocked, a tab, the detail; # starts a comment.
note          Each row must name a path of LIST exactly once, or the run fails (exit 1): a stale decision is loud.
note LABEL    one line naming the inputs (heads), copied into the header
note Columns: path kind bytes lines tier marker om_ref same_stem status detail summary
note kind     the extension, or none
note tier     data (not code), device (a device marker in the text), tiered (a device marker and a --host-only or
note          --sim tier), host (code with no device marker). A heuristic over the text, not a run.
note marker   the first device marker found, in the order of the m_ texts below, or -
note om_ref   the first NAME.om named in the text that is a file of GPULIST: gpu/nvidia/NAME.om (om/ and native/
note          read as gpu/nvidia/), or, when NAME holds a '/', a GPULIST file ending in /NAME.om; or -
note same_stem the file gpu/nvidia/PATH.om of GPULIST, where PATH is the path without its extension (tests/X/y.c
note          gives gpu/nvidia/tests/X/y.om): an Omega program of the same name, or -
note status   ported, retired or blocked from PORTS, else open
note summary  the first comment line of the file that is not a licence line (md: the first heading), or -
note Files and lists are read whole into memory that grows to fit them (run-time pools); nothing is cut. A
note path of LIST that Linux could not open (PATH_MAX) is refused, naming it. Exit 0 written, 1 a PORTS row names
note no path of LIST, 2 bad usage, unreadable input, or memory the host refused.
text t_usage "usage: inventory LIST GPULIST PORTS LABEL (run from the CUDApp checkout root)\n"
text t_unread "inventory: cannot read, or the host refused the memory for: "
text t_plong "inventory: a LIST path is longer than Linux PATH_MAX allows: "
text t_badport "inventory: ports.tsv row is not PATH<tab>ported|retired|blocked<tab>DETAIL: "
text t_stale "inventory: ports.tsv rows that name no path of LIST, or name one twice: "
text t_h1 "# gpu/nvidia/checks/INVENTORY.tsv, generated by gpu/nvidia/checks/inventory.om; do not edit by hand.\n# inputs: "
text t_h2 "path\tkind\tbytes\tlines\ttier\tmarker\tom_ref\tsame_stem\tstatus\tdetail\tsummary\n"
text t_tot "# files="
text t_code " code="
text t_data " data="
text t_dev " device="
text t_tier " tiered="
text t_host " host="
text t_por " ported="
text t_ret " retired="
text t_blk " blocked="
text t_open " open="
text t_okh "# open by tier/kind:"
text t_dash "-"
text t_none "none"
text t_ktdata "data"
text t_nl "\n"
text t_ktdev "device"
text t_kttier "tiered"
text t_kthost "host"
text t_kopen "open\t-"
text t_ported "ported"
text t_retired "retired"
text t_blocked "blocked"
text t_gn "gpu/nvidia/"
text t_copyr "Copyright"
text t_dotom ".om"
text t_spdx "SPDX"
text t_hostonly "--host-only"
text t_sim "--sim"
text t_m1 "/dev/nvidia"
text t_m2 "/dev/kfd"
text t_m3 "/dev/dri"
text t_m4 "omega_gpu_session_open"
text t_m5 "nvrm_open"
text t_m6 "cuInit"
text t_m7 "hipMalloc"
text t_m8 "ioctl("
text t_m9 "nvidia-smi"
text t_m10 "spark-window"
text t_kc "c"
text t_kh "h"
text t_kpy "py"
text t_ksh "sh"
text t_kmk "mk"
text t_kinc "inc"
text t_kmd "md"
global g_f uchar *
global g_lst uchar *
global g_gpu uchar *
global g_prt uchar *
note a path for fopen: Linux PATH_MAX, the longest path open(2) takes (getconf PATH_MAX / gives 4096)
global g_pa uchar 4096
note the LABEL argument: Linux MAX_ARG_STRLEN, the longest single argument execve passes (32 pages of 4096)
global g_lab uchar 131072
global g_o uchar 65536
global g_ok uchar *
global g_n ulong 48
note g_n: 0 path length, 1 file length, 2 list length, 3 gpu list length, 4 ports length, 5 output length,
note 6 label length, 7 entry start, 8 entry end, 9 ports rows matched, 10 files, 11 code, 12 data, 13 device,
note 14 tiered, 15 host, 16 ported, 17 retired, 18 blocked, 19 open, 20 summary start, 21 summary end,
note 22 om_ref start, 23 om_ref end (in g_gpu), 24 stem start, 25 stem end (in g_lst), 26 extension start,
note 27 same_stem start, 28 same_stem end, 29 port line start, 30 port line end, 31 ports rows, 32 bytes of g_ok,
note 33 the tier of this row (1 device, 2 tiered, 3 host, 4 data)
note g_ok: one key per open row, its tier byte, its kind, a newline (the open-by-kind footer line)
note ---- output
fn oflush to void
o = ulong 0
n = get g_n 5
while lt o n bound 65537
x = write 1 g_o o sub n o
if le x 0
exit 2
end
o = add o ulong x
end
put g_n 5 0
end
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
oflush
n = 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn otab to void
oc 9
end
fn ofr s ulong e ulong to void
for i ulong sub e s bound 9223372036854775807
c = ulong get g_f add s i
if or eq c 9 eq c 13
c = 32
end
oc c
end
end
fn olr s ulong e ulong to void
for i ulong sub e s bound 9223372036854775807
oc ulong get g_lst add s i
end
end
fn ogr s ulong e ulong to void
for i ulong sub e s bound 9223372036854775807
oc ulong get g_gpu add s i
end
end
fn opr s ulong e ulong to void
for i ulong sub e s bound 9223372036854775807
oc ulong get g_prt add s i
end
end
fn eput t view uchar * to void
r = write 2 t 0 len t
end
fn epath to void
r = write 2 g_pa 0 get g_n 0
r = write 2 t_nl 0 1
end
note ---- files
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
note read the file named by g_pa into g_f, growing g_f to fit: its length, or -1 unreadable, -2 the host refused
note the memory
fn fload to long
r = fopen g_pa 0 get g_n 0 int 524288 int 0
if lt r 0
ret long -1
end
fd = int r
n = ulong 0
res = long 0
while true bound 9223372036854775807
if ge add n 1 len g_f
q = enlarge g_f add add n n 65536
if lt q 0
res = long -2
break
end
end
x = read fd g_f n sub len g_f n
if lt x 0
res = long -1
break
end
if eq x 0
break
end
n = add n ulong x
end
r = fclose fd
if lt res 0
ret res
end
put g_n 1 n
ret long n
end
note argument I into g_pa, then the file into g_f; exits 2 when either fails
fn aload i ulong to ulong
r = argread i g_pa 0 4095
if lt r 1
eput t_usage
exit 2
end
put g_n 0 ulong r
x = fload
if lt x 0
eput t_unread
epath
exit 2
end
ret ulong x
end
note ---- character classes
fn alnum c ulong to bool
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
if and ge c 97 le c 122
ret true
end
ret false
end
fn tokch c ulong to bool
if alnum c
ret true
end
if or or or eq c 95 eq c 46 eq c 47 eq c 45
ret true
end
ret false
end
note ---- search in g_f
fn fat i ulong t view uchar * to bool
n = get g_n 1
m = len t
if gt add i m n
ret false
end
for j ulong m bound 9223372036854775807
if ne get g_f add i j get t j
ret false
end
end
ret true
end
fn fhas t view uchar * to bool
n = get g_n 1
m = len t
if gt m n
ret false
end
for i ulong add sub n m 1 bound 9223372036854775807
if fat i t
ret true
end
end
ret false
end
note the first device marker in g_f, 1..10, or 0
fn marker to ulong
if fhas t_m1
ret 1
end
if fhas t_m2
ret 2
end
if fhas t_m3
ret 3
end
if fhas t_m4
ret 4
end
if fhas t_m5
ret 5
end
if fhas t_m6
ret 6
end
if fhas t_m7
ret 7
end
if fhas t_m8
ret 8
end
if fhas t_m9
ret 9
end
if fhas t_m10
ret 10
end
ret 0
end
fn omark m ulong to void
if eq m 1
ot t_m1
end
if eq m 2
ot t_m2
end
if eq m 3
ot t_m3
end
if eq m 4
ot t_m4
end
if eq m 5
ot t_m5
end
if eq m 6
ot t_m6
end
if eq m 7
ot t_m7
end
if eq m 8
ot t_m8
end
if eq m 9
ot t_m9
end
if eq m 10
ot t_m10
end
if eq m 0
ot t_dash
end
end
note ---- the list entry g_lst[g_n 7, g_n 8): extension and stem
note sets 24 stem start, 25 stem end, 26 extension start (= entry end when there is none)
fn names to void
s = get g_n 7
e = get g_n 8
b = s
d = e
for i ulong sub e s bound 9223372036854775807
c = get g_lst add s i
if eq c 47
b = add add s i 1
d = e
end
if eq c 46
d = add s i
end
end
put g_n 24 b
put g_n 25 d
if lt d e
put g_n 26 add d 1
else
put g_n 26 e
end
end
fn lext t view uchar * to bool
s = get g_n 26
e = get g_n 8
if ne sub e s len t
ret false
end
for i ulong len t bound 9223372036854775807
if ne get g_lst add s i get t i
ret false
end
end
ret true
end
fn iscode to bool
if or or lext t_kc lext t_kh lext t_kpy
ret true
end
if or or lext t_ksh lext t_kmk lext t_kinc
ret true
end
if ge get g_n 1 2
if and eq get g_f 0 35 eq get g_f 1 33
ret true
end
end
ret false
end
fn isdotom to bool
s = get g_n 7
e = get g_n 8
if lt sub e s 3
ret false
end
c3 = get g_lst sub e 3
c2 = get g_lst sub e 2
c1 = get g_lst sub e 1
ret and and eq c3 46 eq c2 111 eq c1 109
end
note ---- the gpu list
note gpu line [lo, hi) equals PREFIX then g_f[ts, te)
fn gpeq lo ulong hi ulong pre view uchar * ts ulong te ulong to bool
m = len pre
tl = sub te ts
if ne sub hi lo add m tl
ret false
end
for i ulong m bound 9223372036854775807
if ne get g_gpu add lo i get pre i
ret false
end
end
for j ulong tl bound 9223372036854775807
c = get g_f add ts j
if ne get g_gpu add add lo m j c
ret false
end
end
ret true
end
note gpu line [lo, hi) ends with '/' then g_f[ts, te)
fn gpsuf lo ulong hi ulong ts ulong te ulong to bool
tl = sub te ts
if le sub hi lo tl
ret false
end
if ne get g_gpu sub sub hi tl 1 47
ret false
end
b = sub hi tl
for j ulong tl bound 9223372036854775807
c = get g_f add ts j
if ne get g_gpu add b j c
ret false
end
end
ret true
end
note find a gpu line for the token g_f[ts, te): mode 0 exact under gpu/nvidia/, mode 1 by suffix; sets 22, 23
fn gfind ts ulong te ulong mode ulong to bool
n = get g_n 3
s = ulong 0
note every pass consumes at least one byte of the gpu list
while lt s n bound 9223372036854775807
e = s
while and lt e n ne get g_gpu e 10 bound 9223372036854775807
e = add e 1
end
hit = false
if eq mode 0
hit = gpeq s e t_gn ts te
else
hit = gpsuf s e ts te
end
if hit
put g_n 22 s
put g_n 23 e
ret true
end
s = add e 1
end
ret false
end
note the token that ends with ".om" at g_f[i, i+3): its start, or i when there is none
fn tokstart i ulong to ulong
b = i
while gt b 0 bound 9223372036854775807
if not tokch ulong get g_f sub b 1
break
end
b = sub b 1
end
ret b
end
fn slashin s ulong e ulong to bool
for i ulong sub e s bound 9223372036854775807
if eq get g_f add s i 47
ret true
end
end
ret false
end
fn omref to bool
n = get g_n 1
if lt n 3
ret false
end
for i ulong sub n 2 bound 9223372036854775807
if fat i t_dotom
ok = true
if lt add i 3 n
if or alnum ulong get g_f add i 3 eq get g_f add i 3 95
ok = false
end
end
if ok
b = tokstart i
if lt b i
if gfind b add i 3 0
ret true
end
if and slashin b i gfind b add i 3 1
ret true
end
end
end
end
end
ret false
end
fn gdotom hi ulong to bool
if ne get g_gpu sub hi 3 46
ret false
end
if ne get g_gpu sub hi 2 111
ret false
end
ret eq get g_gpu sub hi 1 109
end
note gpu line [lo, hi) is gpu/nvidia/ then the list entry up to its extension, then ".om"
fn stemeq lo ulong hi ulong to bool
m = len t_gn
ss = get g_n 7
sl = sub get g_n 25 ss
if ne sub hi lo add add m sl 3
ret false
end
for i ulong m bound 9223372036854775807
if ne get g_gpu add lo i get t_gn i
ret false
end
end
for j ulong sl bound 9223372036854775807
c = get g_lst add ss j
if ne get g_gpu add add lo m j c
ret false
end
end
ret gdotom hi
end
fn samestem to bool
n = get g_n 3
s = ulong 0
while lt s n bound 9223372036854775807
e = s
while and lt e n ne get g_gpu e 10 bound 9223372036854775807
e = add e 1
end
if stemeq s e
put g_n 27 s
put g_n 28 e
ret true
end
s = add e 1
end
ret false
end
note ---- summary: the first comment line of g_f that is not a licence line; sets 20, 21
note style 0 C (/* * //), 1 hash (#, not #!), 2 Markdown (first # heading)
fn hasalnum s ulong e ulong to bool
for i ulong sub e s bound 9223372036854775807
if alnum ulong get g_f add s i
ret true
end
end
ret false
end
note g_f[p] is c
fn fis p ulong c ulong to bool
ret eq ulong get g_f p c
end
fn skipsp s ulong e ulong to ulong
p = s
while and lt p e or fis p 32 fis p 9 bound 9223372036854775807
p = add p 1
end
ret p
end
note trailing spaces, "*/" and quotes off the end
fn trimend s ulong e ulong to ulong
q = e
while gt q s bound 9223372036854775807
c = get g_f sub q 1
if or or or eq c 32 eq c 9 eq c 13 eq c 34
q = sub q 1
continue
end
note two ifs, not one and: Omega's and reads both sides, and q - 2 is below 0 when q is 1
if and eq c 47 gt sub q s 1
if eq get g_f sub q 2 42
q = sub q 2
continue
end
end
break
end
ret q
end
note the text of a line [s, e) after its comment marker, as a start; e when it is not a comment line
fn cstart s ulong e ulong style ulong to ulong
p = skipsp s e
if ge p e
ret e
end
c = get g_f p
if eq style 0
d = ulong 0
if lt add p 1 e
d = ulong get g_f add p 1
end
if and eq c 47 or eq d 42 eq d 47
p = add p 2
while and lt p e or fis p 42 fis p 47 bound 9223372036854775807
p = add p 1
end
ret skipsp p e
end
if eq c 42
p = add p 1
if and lt p e eq get g_f p 47
ret e
end
ret skipsp p e
end
ret e
end
if eq c 34
if and lt add p 2 e and fis add p 1 34 fis add p 2 34
ret skipsp add p 3 e
end
ret e
end
if ne c 35
ret e
end
if and lt add p 1 e eq get g_f add p 1 33
ret e
end
while and lt p e eq get g_f p 35 bound 9223372036854775807
p = add p 1
end
ret skipsp p e
end
fn hastext s ulong e ulong t view uchar * to bool
m = len t
if lt sub e s m
ret false
end
for i ulong add sub sub e s m 1 bound 9223372036854775807
if fat add s i t
ret true
end
end
ret false
end
fn spdx s ulong e ulong to bool
ret or hastext s e t_spdx hastext s e t_copyr
end
fn summary style ulong to bool
n = get g_n 1
s = ulong 0
lines = ulong 0
while and lt s n lt lines 80 bound 9223372036854775807
e = s
while and lt e n ne get g_f e 10 bound 9223372036854775807
e = add e 1
end
p = cstart s e style
q = trimend p e
if and lt p q and hasalnum p q not spdx p q
put g_n 20 p
put g_n 21 q
ret true
end
s = add e 1
lines = add lines 1
end
ret false
end
fn summ to bool
if or lext t_kc lext t_kh
ret summary 0
end
if or iscode lext t_kmd
ret summary 1
end
ret false
end
note ---- ports.tsv
note the decision field of port line [s, e): 1 ported, 2 retired, 3 blocked, 0 malformed; the path ends at the tab
fn pdec s ulong e ulong to ulong
t = s
while and lt t e ne get g_prt t 9 bound 9223372036854775807
t = add t 1
end
if or eq t s ge t e
ret 0
end
d = add t 1
u = d
while and lt u e ne get g_prt u 9 bound 9223372036854775807
u = add u 1
end
if ge u e
ret 0
end
r = ulong 0
if pword d u t_ported
r = 1
end
if pword d u t_retired
r = 2
end
if pword d u t_blocked
r = 3
end
ret r
end
fn pword s ulong e ulong t view uchar * to bool
if ne sub e s len t
ret false
end
for i ulong len t bound 9223372036854775807
if ne get g_prt add s i get t i
ret false
end
end
ret true
end
note every ports row is well formed; counts rows into 31; exits 2 on a malformed one
fn pcheck to void
n = get g_n 4
s = ulong 0
k = ulong 0
while lt s n bound 9223372036854775807
e = s
while and lt e n ne get g_prt e 10 bound 9223372036854775807
e = add e 1
end
if and lt s e ne get g_prt s 35
if eq pdec s e 0
eput t_badport
r = write 2 g_prt s sub e s
r = write 2 t_nl 0 1
exit 2
end
k = add k 1
end
s = add e 1
end
put g_n 31 k
end
note the port row of the list entry: sets 29, 30 to its line and returns the decision, 0 when there is none
fn pfind to ulong
n = get g_n 4
ls = get g_n 7
ll = sub get g_n 8 ls
s = ulong 0
while lt s n bound 9223372036854775807
e = s
while and lt e n ne get g_prt e 10 bound 9223372036854775807
e = add e 1
end
note two ifs, not one and: Omega's and reads both sides, and s + ll may lie past the end of g_prt
if gt sub e s ll
if eq get g_prt add s ll 9
if peq s ls ll
put g_n 29 s
put g_n 30 e
ret pdec s e
end
end
end
s = add e 1
end
ret 0
end
fn peq s ulong ls ulong ll ulong to bool
for i ulong ll bound 9223372036854775807
c = get g_lst add ls i
if ne get g_prt add s i c
ret false
end
end
ret true
end
fn bump k ulong to void
put g_n k add get g_n k 1
end
note ---- one row
fn row to void
s = get g_n 7
e = get g_n 8
names
pclr
if ge sub e s len g_pa
eput t_plong
r = write 2 g_lst s sub e s
r = write 2 t_nl 0 1
exit 2
end
for i ulong sub e s bound 4096
pc ulong get g_lst add s i
end
x = fload
if lt x 0
eput t_unread
epath
exit 2
end
bump 10
olr s e
otab
if lt get g_n 26 e
olr get g_n 26 e
else
ot t_none
end
otab
onum get g_n 1
otab
nl = ulong 0
for i ulong get g_n 1 bound 9223372036854775807
if eq get g_f i 10
nl = add nl 1
end
end
onum nl
otab
m = ulong 0
if iscode
bump 11
m = marker
if eq m 0
bump 15
ot t_kthost
put g_n 33 3
else
if or fhas t_hostonly fhas t_sim
bump 14
ot t_kttier
put g_n 33 2
else
bump 13
ot t_ktdev
put g_n 33 1
end
end
else
bump 12
ot t_ktdata
put g_n 33 4
end
otab
omark m
otab
row2
end
fn row2 to void
if omref
ogr get g_n 22 get g_n 23
else
ot t_dash
end
otab
if samestem
ogr get g_n 27 get g_n 28
else
ot t_dash
end
otab
d = pfind
if eq d 0
bump 19
ot t_kopen
okadd
else
bump 9
bump add 15 d
t = get g_n 29
while ne get g_prt t 9 bound 9223372036854775807
t = add t 1
end
opr add t 1 get g_n 30
end
otab
if summ
ofr get g_n 20 get g_n 21
else
ot t_dash
end
oc 10
end
note copy g_f into the list pool k (2 LIST, 3 GPULIST, 4 PORTS), growing it to fit with one zero byte past the
note copy, so that reading the byte at the end of the text (in the eager and of the line loops) stays in range,
note an empty file too; exits 2 when the host refuses the memory
fn copyf k ulong to void
n = get g_n 1
q = long 0
if eq k 2
q = enlarge g_lst add n 1
end
if eq k 3
q = enlarge g_gpu add n 1
end
if eq k 4
q = enlarge g_prt add n 1
end
if lt q 0
eput t_unread
epath
exit 2
end
for i ulong n bound 9223372036854775807
if eq k 2
put g_lst i get g_f i
end
if eq k 3
put g_gpu i get g_f i
end
if eq k 4
put g_prt i get g_f i
end
end
put g_n k n
end
note ---- the open-by-kind line: keys of open rows in g_ok, counted in the order each key first appears

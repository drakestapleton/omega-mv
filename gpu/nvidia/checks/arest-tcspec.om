note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-tcspec.om: artcsp (gpu/nvidia/om/apirest/tcspec.om); Q is its 8 uint q words, the output its 5 words. Composed before arest.om.
text t_name "AREST-TCSPEC"
text t_au "tcspec"
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if or ne nq 8 ne ny 5
ckbad
end
a = new uint 8 0
for i ulong 8
if gt get q i 4294967295
ckbad
end
put a i uint get q i
end
y = new uint 5 0
r = artcsp a y
for i ulong 5
put o i ulong get y i
end
ret r
end

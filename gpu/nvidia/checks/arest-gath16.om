note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-gath16.om: argath16 (gpu/nvidia/om/apirest/gath16.om), as data_parts() of CUDApp
note tests/api_rest_partitions.h calls it. Q n; rows[i] = 33 - i, x the test's 170 words of 34 rows of 5; output 0
note the digest of the n * 5 gathered words. Composed before arestg.om.
text t_name "AREST-GATH16"
text t_gath "gath16"
fn ax_c rows view uint 34 x view ushort 170 y edit ushort 170 n ulong to ulong
ret argath16 part rows 0 n part x 0 170 part y 0 mul n 5
end
fn ax_g n ulong o edit ulong 256 to ulong
rows = new uint 34 0
for i ulong n bound 34
put rows i uint sub 33 i
end
x = new ushort 170 0
for i ulong 170
put x i ushort i
end
y = new ushort 170 0xffff
r = ax_c rows x y n
m = mul n 5
h = ardg0
for i ulong m bound 170
h = ardg h ulong get y i
end
put o 0 h
ret r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
n = get q 0
if or or ne nq 1 gt n 34 not ckis 0 t_gath
ckbad
end
ret ax_g n o
end

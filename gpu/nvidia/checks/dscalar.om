note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/dscalar.om: the Omega port of the scalars() block of CUDApp tests/api_attn_rest_diff.c.
note Composed after gpu/nvidia/om/api/attn_om2.om (it starts with om2), gpu/nvidia/om/gemmex/num.om,
note gpu/nvidia/om/api/attn_scalar.om (av_drnd, av_perm, av_permf, av_permb), the four roots over it the C entries
note wrap (ds_round.om, ds_slot.om, ds_vecf.om, ds_vecb.om, which the check calls), gpu/nvidia/checks/lib.om and
note gpu/nvidia/checks/lib-om2.om; run with gpu/nvidia/checks/dscalar.tsv. Rows, tab separated, hex:
note   r U WANT     av_drnd of f32 bits U, and the check's port of the test's raw rounding, are both WANT
note   s I R SLOT   av_perm of I and R, and the check's port of the test's perm(), are both SLOT
note   d            av_drnd over the test's whole domain (every sign, exponent and high payload, eight low payloads)
note                against the ported rounding
note   v R          av_permf and av_permb at rotary dimension R move every slot as the ported perm() says
note The r and s rows are the test's own expressions compiled from C; they tie the ported expressions to C.
text t_name "DSCALAR"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn dsx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
note the test's want: (uint16_t)((u + 0x7fff + ((u >> 16) & 1)) >> 16), uint32 arithmetic
fn dsrnd u ulong to ulong
ret and shr and add add u 32767 and shr u 16 1 4294967295 16 65535
end
note the test's perm(i, r), uint32 arithmetic
fn dsperm i ulong r ulong to ulong
p = div r 2
if lt i 128
if lt i p
ret i
end
ret and add r sub i p 4294967295
end
j = sub i 128
if lt j p
ret add p j
end
ret i
end
fn dsrow u ulong to bool
ret eq ulong ds_round uint u dsrnd u
end
fn crow to bool
k = ckch 0 0
s = new f32 256 f32 0
d = new f32 256 f32 0
b = new ushort 256 0
w = new ushort 256 0
lows = new ulong 8 0
put lows 1 1
put lows 2 32766
put lows 3 32767
put lows 4 32768
put lows 5 32769
put lows 6 65534
put lows 7 65535
if or ne cklen 0 1 gt ckcnt 4
ckbad
end
if eq k 114
if ne ckcnt 3
ckbad
end
u = dsx 1
if gt u 4294967295
ckbad
end
want = dsx 2
ret and eq ulong ds_round uint u want eq dsrnd u want
end
if eq k 115
if ne ckcnt 4
ckbad
end
i = dsx 1
r = dsx 2
if or gt i 4294967295 gt r 4294967295
ckbad
end
want = dsx 3
ret and eq ulong ds_slot uint i uint r want eq dsperm i r want
end
if eq k 100
for sg ulong 2
for e ulong 256
for hi ulong 128
base = or or shl sg 31 shl e 23 shl hi 16
for j ulong 8
if not dsrow or base get lows j
ret false
end
end
end
end
end
ret true
end
if eq k 118
if ne ckcnt 2
ckbad
end
r = dsx 1
if gt r 4294967295
ckbad
end
for i ulong 256
put s i bitcast f32 uint add 2139095040 i
put b i ushort i
end
for i ulong 256
if ne ulong ds_slot uint i uint r dsperm i r
ret false
end
end
if ne ds_vecf view s edit d uint r 0
ret false
end
if ne ds_vecb view b edit w uint r 0
ret false
end
for i ulong 256
q = dsperm i r
if ne ulong bitcast uint get d i add 2139095040 q
ret false
end
if ne ulong get w i q
ret false
end
end
ret true
end
ckbad
ret false
end

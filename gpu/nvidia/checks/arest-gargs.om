note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-gargs.om: argargs (gpu/nvidia/om/apirest/gargs.om); Q is the 5 words of va and the 2 of sc (va view ulong 5 and sc view uint 2), the output its first NY words. Composed before arest.om.
text t_name "AREST-GARGS"
text t_au "gargs"
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if ne nq 7
ckbad
end
va = new ulong 5 0
for i ulong 5
put va i get q i
end
sc = new uint 2 0
for i ulong 2
if gt get q add 5 i 4294967295
ckbad
end
put sc i uint get q add 5 i
end
y = new uint 64 0x5a5a5a5a
r = argargs va sc part y 0 ny
for i ulong ny bound 64
put o i ulong get y i
end
ret r
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/attnscan.om: the scan block of CUDApp tests/attn_host_diff.c (its other blocks are
note gpu/nvidia/checks/attnhost.om; both units start with om2, so they cannot share one program). Composed
note after gpu/nvidia/om/scan/scan_check.om (sc_check) and gpu/nvidia/checks/lib.om; run with
note gpu/nvidia/checks/attnscan.tsv. Row, lowercase hex: s N CASE OP R: sc_check OP over the arrays the old
note test builds for CASE, N elements, answers R. CASE 0 x[i] = 17 when i rem 3 is 0, else 4294967295, w the
note running uint sums of x; 1 case 0 with bit 0 of w[N-1] flipped; 2 w[i] = i; 3 case 2 with w[0] = 1 and
note w[N-1] = 0; 4 every w[i] = 2141195181 (0x7fa00bad); 5 case 4 with w[N-1] = 2141195180; 6 case 4 with
note w[N-1] = 2141195182. Cases 2..6 pass w and a copy of w, as the old test passes w twice. The arrays are built here,
note not stored in the table. They are local arrays of 1000001 elements, the old test's largest N: a view is
note cut (part) only from a local array of constant size (a global is never an argument, error 19), and the
note local arrays of one function are at most 4 MiB (error 23), so x lives in a helper. A row with a larger N
note is refused as malformed (exit 2), never cut short.
text t_name "ATTNSCAN"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn asx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
note cases 0 and 1: x lives in this frame, w in the caller's (4 MiB of local arrays per function)
fn sums w edit uint * cs ulong op ulong to ulong
sx = new uint 1000001 0
n = len w
sum = uint 0
for i ulong n bound 1000001
v = uint 4294967295
if eq rem i 3 0
v = uint 17
end
put sx i v
sum = add sum v
put w i sum
end
if and eq cs 1 gt n 0
put w sub n 1 xor get w sub n 1 uint 1
end
ret sc_check w part sx 0 n uint op
end
note cases 2..6: the old test passes w as both arrays; one array is never passed twice in a call (error 19),
note so x is a copy of w in this frame
fn twin w view uint * op ulong to ulong
sx = new uint 1000001 0
n = len w
for i ulong n bound 1000001
put sx i get w i
end
ret sc_check w part sx 0 n uint op
end
fn crow to bool
if or ne ckcnt 5 ne cklen 0 1
ckbad
end
if ne ckch 0 0 115
ckbad
end
sw = new uint 1000001 0
n = asx 1
cs = asx 2
op = asx 3
if or gt n len sw gt cs 6
ckbad
end
if lt cs 2
ret eq sums part sw 0 n cs op asx 4
end
if lt cs 4
for i ulong n bound 1000001
put sw i uint i
end
if and eq cs 3 gt n 1
put sw 0 uint 1
put sw sub n 1 uint 0
end
ret eq twin part sw 0 n op asx 4
end
for i ulong n bound 1000001
put sw i uint 2141195181
end
if and eq cs 5 gt n 0
put sw sub n 1 uint 2141195180
end
if and eq cs 6 gt n 0
put sw sub n 1 uint 2141195182
end
ret eq twin part sw 0 n op asx 4
end

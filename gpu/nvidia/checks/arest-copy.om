note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-copy.om: arcopy (gpu/nvidia/om/apirest/copy.om), as data_parts() of CUDApp
note tests/api_rest_partitions.h calls it. Q n; bytes[i] = (unsigned char)i. The copy runs twice, into bytes that
note are all 0 and into bytes that are all 255; outputs 0 and 1 are the digests of the n copied bytes, so a byte
note the unit does not write differs from the table in one of them. Composed before arestg.om.
text t_name "AREST-COPY"
text t_copy "copy"
fn ax_c x view uchar 65537 n ulong m uchar o edit ulong 256 k ulong to ulong
y = new uchar 65537 m
r = arcopy part x 0 n part y 0 n
h = ardg0
for i ulong n bound 65537
h = ardg h ulong get y i
end
put o k h
ret r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
n = get q 0
if or or ne nq 1 gt n 65537 not ckis 0 t_copy
ckbad
end
x = new uchar 65537 0
for i ulong 65537
put x i uchar and i 255
end
r = ax_c x n 0 o 0
if ne ax_c x n 255 o 1 r
ckbad
end
ret r
end

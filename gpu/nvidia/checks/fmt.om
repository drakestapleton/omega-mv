note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/fmt.om: the Omega port of CUDApp tests/tools-om/fmt_diff.c (run by tests/tools-om/fmt.sh).
note Composed after gpu/nvidia/om/tools/fmt.om and gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/fmt.tsv,
note which glibc snprintf("%.*f" / "%.*g") wrote through the old differential's own C mode: its special values and
note its splitmix64 doubles in five families, nine conversions each ("%.Pf" for P 0 1 2 6 17, "%.Pg" for P 0 1 6 17).
note Cases:
note   s BITS P G TEXT        the f64 with bits BITS printed with precision P (G 0 "%.Pf", 1 "%.Pg") is TEXT
note   r FIRST COUNT DIGEST   the random values FIRST..FIRST+COUNT-1 of the old test, regenerated here from its
note                          splitmix64 stream (rows in order from 0), printed nine ways each: FNV-1a-64 over every
note                          printed byte, a 0 byte after each conversion, is DIGEST
note COUNT is at most 2^20 (the loop bound); a larger COUNT is an unreadable row.
text t_name "FMT"
global fx_s ulong 2
note fx_s: 0 the splitmix64 state less its starting value 0x9e3779b97f4a7c15, 1 the next random index
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn fx_nx to ulong
s = add get fx_s 0 11400714819323198485
put fx_s 0 s
z = add s 11400714819323198485
z = mul xor z shr z 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
ret xor z shr z 31
end
note random value i of the old test (i % 5 picks the family; the fifth also draws its exponent)
fn fx_x i ulong to f64
r = fx_nx
k = rem i 5
if eq k 0
ret bitcast f64 r
end
if eq k 1
ret div f64 shr r 20 f64 1024
end
if eq k 2
ret sub div f64 rem r 2000001 f64 1000 f64 1000
end
if eq k 3
ret div f64 shr r 11 f64 1048576
end
e = add rem fx_nx 200 873
ret mul f64 shr r 12 bitcast f64 shl e 52
end
note precision k of conversion g: "%.Pf" takes 0 1 2 6 17, "%.Pg" takes 0 1 6 17 (the f list without its 2)
fn fx_p g ulong k ulong to ulong
if le k 1
ret k
end
j = add k g
if eq j 2
ret 2
end
if eq j 3
ret 6
end
ret 17
end
note print x into o; its length
fn fx_cv x f64 p ulong g ulong o edit uchar 1600 to ulong
if ne g 0
ret fm_g x p o
end
ret fm_f x p o
end
note fold the nine conversions of x into the digest h
fn fx_one x f64 h ulong to ulong
o = new uchar 1600 0
for g ulong 2
nk = sub ulong 5 g
for k ulong nk bound 5
n = fx_cv x fx_p g k g o
for j ulong n bound 1600
h = mul xor h ulong get o j 1099511628211
end
h = mul h 1099511628211
end
end
ret h
end
fn fx_spec to bool
if ne ckcnt 5
ckbad
end
o = new uchar 1600 0
n = fx_cv bitcast f64 cknum 1 cknum 2 cknum 3 o
if ne n cklen 4
ret false
end
for j ulong n bound 1600
if ne ulong get o j ckch 4 j
ret false
end
end
ret true
end
fn fx_rand to bool
if ne ckcnt 4
ckbad
end
f = cknum 1
c = cknum 2
if gt c 1048576
ckbad
end
if ne f get fx_s 1
ret false
end
h = ulong 14695981039346656037
for i ulong c bound 1048576
h = fx_one fx_x add f i h
end
put fx_s 1 add f c
ret eq h cknum 3
end
fn crow to bool
if ne cklen 0 1
ckbad
end
k = ckch 0 0
if eq k 115
ret fx_spec
end
if ne k 114
ckbad
end
ret fx_rand
end

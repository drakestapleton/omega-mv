note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-xnext.om: arxnext (gpu/nvidia/om/apirest/xnext.om), as state_parts() of CUDApp
note tests/api_rest_partitions.h calls it in a loop. Q a flag, 16 q words, 5 rows, 3 have bytes: with flag 0 q and
note have are the row's, with flag 1 they are what the previous row left, as the test's loop carries them. q after
note the call is output 129 on (128 + its place in Q). Composed before arestg.om.
text t_name "AREST-XNEXT"
text t_xnext "xnext"
global ax_xq ulong 16
global ax_xh uchar 3
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if or ne nq 25 not ckis 0 t_xnext
ckbad
end
a = new ulong 16 0
have = new uchar 3 0
if eq get q 0 0
for i ulong 16
put a i get q add 1 i
end
for i ulong 3
put have i uchar get q add 22 i
end
else
for i ulong 16
put a i get ax_xq i
end
for i ulong 3
put have i get ax_xh i
end
end
rows = new uint 5 0
for i ulong 5
put rows i uint get q add 17 i
end
r = arxnext a part rows 0 5 part have 0 3
for i ulong 16
put ax_xq i get a i
put o add 129 i get a i
end
for i ulong 3
put ax_xh i get have i
end
ret r
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-pfhost.om: pfreg and pfcount (gpu/nvidia/om/apirest/pfhost.om) through the root arpfreg
note (pfreg.om), as CUDApp tests/test_prefill_host_rest.c calls them. Unit pfreg: Q w, d. Unit pfcount: Q n, over
note the test's x (eleven bit patterns in turn); the answer is the count of -999.0f. Unit pfsweep: Q the largest n;
note the answer is the digest of the counts for every n from 0 up to it, the test's whole loop. Composed before
note arestg.om.
text t_name "AREST-PFHOST"
text t_pfreg "pfreg"
text t_pfcount "pfcount"
text t_pfsweep "pfsweep"
fn ax_cls k ulong to uint
if eq k 0
ret 0
end
if eq k 1
ret 0x80000000
end
if eq k 2
ret 1
end
if eq k 3
ret 0x80000001
end
if eq k 4
ret 0x7f800000
end
if eq k 5
ret 0xff800000
end
if eq k 6
ret 0x7fc00000
end
if eq k 7
ret 0x7f800001
end
if eq k 8
ret 0xc479c000
end
if eq k 9
ret 0xc479bfff
end
ret 0xc479c001
end
fn ax_cnt q view ulong 256 sweep bool to ulong
n = get q 0
if gt n 4096
ckbad
end
x = new f32 4096 0.0f32
for i ulong 4096
put x i bitcast f32 ax_cls rem i 11
end
if not sweep
ret pfcount part x 0 n
end
h = ardg0
for k ulong add n 1 bound 4097
h = ardg h pfcount part x 0 k
end
ret h
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_pfreg
if ne nq 2
ckbad
end
ret arpfreg uint get q 0 uint get q 1
end
if ne nq 1
ckbad
end
if ckis 0 t_pfcount
ret ax_cnt q false
end
if ckis 0 t_pfsweep
ret ax_cnt q true
end
ckbad
ret 0
end

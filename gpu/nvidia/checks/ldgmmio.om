note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/ldgmmio.om: the Omega port of CUDApp tests/bw_ldg_mmio_test.c. Composed after
note gpu/nvidia/om/encoder/bw_enc_sm121.om (bw_enc_sm121), gpu/nvidia/om/disasm/sm121_dis.om (sm121_dis) and
note gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/ldgmmio.tsv. Rows, tab separated, lowercase hex for
note the words, decimal otherwise:
note   e OP W0 W1 W2 W3 TYPE ORDER EVICT CONTRACT RC TEXT   the test's instruction with op OP
note   w W2 TYPE ORDER EVICT CONTRACT RC TEXT               LDG_MMIO's instruction with word 2 replaced by W2
note The test's instruction: dst 4, src1 8, no src2 or src3, ureg 2, imm 0, control 0 (the op's default), each
note virtual register on the physical register of its own number. The check encodes it with bw_enc_sm121 and
note requires the C encoder's four words; reads NAK's memory fields of the word (Mesa NAK sm70_encode.rs
note set_mem_access, sm_80+: type bits 73..75, order bits 77..80, eviction bits 84..86) and requires the C's
note values; computes the test's LDG_MMIO contract (32-bit, normal eviction, an order neither weak 0 nor
note constant 4; CONTRACT 1 when broken) and requires the C's answer; and decodes the word with sm121_dis,
note requiring the C decoder's text and its answer RC (1 when no form matched, the text is then ?? 0x<hi><lo>).
text t_name "LDGMMIO"
const NONE ulong 18446744073709551615
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn lmx i ulong to ulong
n = cklen i
if or eq n 0 gt n 8
ckbad
end
v = ulong 0
for j ulong n bound 8
v = or shl v 4 cknib ckch i j
end
ret v
end
note bits [at, at + n) of the 128-bit word ww (four 32-bit words); every field read lies inside one word
fn lmf ww view ulong 4 at ulong n ulong to ulong
ret and shr get ww shr at 5 and at 31 sub shl ulong 1 n 1
end
note 1 when ww breaks the LDG_MMIO contract (mmio_contract of the test)
fn lmbad ww view ulong 4 to ulong
o = lmf ww 77 4
if ne lmf ww 73 3 4
ret 1
end
if ne lmf ww 84 3 1
ret 1
end
if or eq o 0 eq o 4
ret 1
end
ret 0
end
note encode op with the test's operands into ww; false when the encoder refuses
fn lmenc op ulong ww edit ulong 4 to bool
ins = new ulong 8192 0
phys = new ulong 288 0
code = new uchar 16384 0
for i ulong 256
put phys i i
end
for i ulong 32
put phys add 256 i i
end
put ins 0 op
put ins 1 4
put ins 2 8
put ins 3 NONE
put ins 4 NONE
put ins 5 2
if ne bw_enc_sm121 view ins view phys 1 0 edit code 16
ret false
end
for k ulong 4
v = ulong 0
for j ulong 4
v = or v shl ulong get code add mul k 4 j mul j 8
end
put ww k v
end
ret true
end
note fields, contract and decoding of ww against the row's fields from f on: TYPE ORDER EVICT CONTRACT RC TEXT
fn lmrest ww view ulong 4 f ulong to bool
if or ne cknum f lmf ww 73 3 ne cknum add f 1 lmf ww 77 4
ret false
end
if or ne cknum add f 2 lmf ww 84 3 ne cknum add f 3 lmbad ww
ret false
end
o = new uchar 256 0
r = sm121_dis or get ww 0 shl get ww 1 32 or get ww 2 shl get ww 3 32 0 edit o
if ne cknum add f 4 and shr r 16 1
ret false
end
t = add f 5
n = and r 65535
if or ne and shr r 18 1 0 ne n cklen t
ret false
end
for j ulong n bound 256
if ne ulong get o j ckch t j
ret false
end
end
ret true
end
fn crow to bool
k = ckch 0 0
ww = new ulong 4 0
if eq k 101
if or ne ckcnt 12 ne cklen 0 1
ckbad
end
if not lmenc cknum 1 edit ww
ret false
end
for i ulong 4
if ne get ww i lmx add i 2
ret false
end
end
ret lmrest view ww 6
end
if eq k 119
if or ne ckcnt 8 ne cklen 0 1
ckbad
end
if not lmenc 21 edit ww
ret false
end
put ww 2 lmx 1
ret lmrest view ww 2
end
ckbad
ret false
end

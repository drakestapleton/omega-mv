note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/hostrest.om: the Omega port of CUDApp tests/api_hostrest_test.c. Composed after
note gpu/nvidia/om/apiviews/hostrest.om (the ah_rest unit) and gpu/nvidia/checks/lib.om; run with
note gpu/nvidia/checks/hostrest.tsv. Row: OP P0 .. P8 R in lowercase hex; ah_rest OP over P (P9 .. P15
note zero) must be R.
text t_name "HOSTREST"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn hrx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
fn crow to bool
if ne ckcnt 11
ckbad
end
p = new ulong 16 0
for k ulong 9
put p k hrx add k 1
end
ret eq ah_rest hrx 0 view p hrx 10
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/api_ew.om: the Omega port of CUDApp tests/api_kgen_ew_diff_test.c.
note Composed after gpu/nvidia/om/components/api_ew_plan.om, the ew_ir unit (gpu/nvidia/om/kgen/ew_emit.om,
note ew_scalar.om, ew_reconv.om, ew_prime.om, ew_ir.om), gpu/nvidia/om/codegen/cg_fields.om, cg_replay.om and
note gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/api_ew.tsv, the answers of the retained C generator and
note C shape plan over the C test's whole domain. Word digests: h = (h xor w) * 1099511628211 from
note 14695981039346656037, one step per 64-bit word.
note Cases (fields split by tabs):
note   d D...                   the C test's dimension list; every p row reads it, so it comes first
note   e MAXOP                  the last IR opcode of the C enum (BW_IR_LAST), the bound cg_replay admits; before k
note   p MODE N ADM DIGEST      api_ew_plan MODE on (N, D, LO, 3) for each D of the d row and LO 0..4, in that
note                            order: ADM cases return 0, and DIGEST folds each return code and, when it is 0,
note                            the 16 words after the call
note   k OP MUT PATH ACC COUNT DIGEST NV NU WIDTHS
note                            ew_ir OP MUT PATH 0: ACC 1 when the C generator accepted the spec, so ew_ir must
note                            return 0 and cg_replay must admit its records; then COUNT records, DIGEST over the
note                            16 fields cg_fields unpacks from each, NV and NU virtual registers and WIDTHS over
note                            their widths (each vreg: a width word 4 or 2 is that size, any other is 1; then
note                            each uvreg: 2 for a width word 2, else 1; as the C replay allocates them).
note                            ACC 0: ew_ir must not return 0.
text t_name "API_EW"
global ae_g ulong 4
note ae_g: 0 MAXOP, 1 an e row was read, 2 a d row was read
global ae_d ulong *
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn ae_f h ulong v ulong to ulong
ret mul xor h v 1099511628211
end
fn ae_dims to bool
n = sub ckcnt 1
r = enlarge ae_d n
if lt r 0
ckrefuse 1
end
for i ulong n bound 4294967296
put ae_d i cknum add i 1
end
put ae_g 2 1
ret true
end
fn ae_plan to bool
if ne ckcnt 5
ckbad
end
if eq get ae_g 2 0
ret false
end
mode = cknum 1
an = cknum 2
a = new ulong 16 0
h = ulong 14695981039346656037
adm = ulong 0
for di ulong len ae_d bound 4294967296
for lo ulong 5
for i ulong 16
put a i 0
end
put a 0 an
put a 1 get ae_d di
put a 2 lo
put a 3 3
r = api_ew_plan mode a
h = ae_f h r
if eq r 0
adm = add adm 1
for i ulong 16
h = ae_f h get a i
end
end
end
end
if ne adm cknum 3
ret false
end
ret eq h cknum 4
end
fn ae_wid w ulong to ulong
if or eq w 4 eq w 2
ret w
end
ret 1
end
note the accepted spec's records, unpacked by cg_fields, against the C generator's instructions
fn ae_ir ins view ulong 8192 meta view ulong 512 to bool
n = get meta 0
if ne n cknum 5
ret false
end
raw = new ulong 16 0
rec = new ulong 8 0
h = ulong 14695981039346656037
for i ulong n bound 1024
for j ulong 8
put rec j get ins add mul i 8 j
end
if ne cg_fields 1 raw rec 0
ret false
end
for j ulong 16
h = ae_f h get raw j
end
end
if ne h cknum 6
ret false
end
vn = get meta 1
nu = get meta 2
if or ne vn cknum 7 ne nu cknum 8
ret false
end
w = ulong 14695981039346656037
for v ulong vn bound 256
w = ae_f w ae_wid get meta add 64 v
end
for u ulong nu bound 32
k = ulong 1
if eq get meta add 320 u 2
k = 2
end
w = ae_f w k
end
ret eq w cknum 9
end
fn ae_kern to bool
if ne ckcnt 10
ckbad
end
if eq get ae_g 1 0
ret false
end
ins = new ulong 8192 0
meta = new ulong 512 0
r = ew_ir cknum 1 cknum 2 cknum 3 0 ins meta
acc = cknum 4
if eq acc 0
ret ne r 0
end
if or ne acc 1 ne r 0
ret false
end
if ne cg_replay ins meta get ae_g 0 0
ret false
end
ret ae_ir ins meta
end
fn crow to bool
if ne cklen 0 1
ckbad
end
k = ckch 0 0
if eq k 101
if ne ckcnt 2
ckbad
end
put ae_g 0 cknum 1
put ae_g 1 1
ret true
end
if eq k 100
ret ae_dims
end
if eq k 112
ret ae_plan
end
if ne k 107
ckbad
end
ret ae_kern
end
note gate-pools: uses enlarge on purpose: owner=seed/omc/tests/pools/recovered-owners.sh compile=9 standalone refusal with the one line omc error 9: the gate that owns this unit composes it with its other parts; composed qualification is that gate's, not claimed here

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avpack.om: the Omega port of the host-data part of CUDApp tests/attn_views_diff.c that
note the Omega units answer alone. Composed after gpu/nvidia/om/api/attn_bfexp.om (av_bfexp; it starts with
note om2, so it comes first), gpu/nvidia/om/api/attn_args.om (av_pack), gpu/nvidia/om/api/attn_lay.om (av_lay)
note and gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/avpack.tsv. Rows, tab separated, hex except NA,
note NW and RC:
note   p NA NW RC A0..A31   av_pack of the test's p (p[i] = 0xdeadbeef12345678 ^ (i << 40)) into zeroed words
note   l MASK RC A0..A31    av_lay of the same p into zeroed words
note   b BF16 F32           av_bfexp of one bfloat16, the exact bits of the float (NaN payloads included)
note Each row is the pending C of src/omega_attn_views.h (av_args, av_layout, av_bfexpand) at CUDApp 84b524ca.
text t_name "AVPACK"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn apx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
note the row's answer RC (field f) and its 32 words (fields f + 1 on) against rc and a
fn apcmp rc ulong a view uint 32 f ulong to bool
if ne rc cknum f
ret false
end
for i ulong 32
if ne ulong get a i apx add add f 1 i
ret false
end
end
ret true
end
fn crow to bool
k = ckch 0 0
p = new ulong 32 0
a = new uint 32 0
s = new ushort 1 0
d = new f32 1 f32 0
if or eq k 112 eq k 108
for i ulong 32
put p i xor 16045690981402826360 shl i 40
end
nf = ulong 35
if eq k 112
nf = ulong 36
end
if or ne cklen 0 1 ne ckcnt nf
ckbad
end
if eq k 112
rc = av_pack view p edit a cknum 1 cknum 2
ret apcmp rc view a 3
end
rl = av_lay view p edit a apx 1
ret apcmp rl view a 2
end
if eq k 98
if or ne ckcnt 3 ne cklen 0 1
ckbad
end
put s 0 ushort apx 1
if ne av_bfexp view s edit d 1 0
ret false
end
ret eq ulong bitcast uint get d 0 apx 2
end
ckbad
ret false
end

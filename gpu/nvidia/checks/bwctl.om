note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/bwctl.om: the Omega port of CUDApp tests/bw_encode_control_test.c. Composed after
note gpu/nvidia/om/encoder/bw_enc_sm121.om (bw_enc_sm121) and gpu/nvidia/checks/lib.om; run with
note gpu/nvidia/checks/bwctl.tsv. Row, lowercase hex: e OP FORM CONTROL ACCEPTED W0 W1 W2 W3.
note The check encodes the old test's instruction: op OP, dst 4, src1 6, src2 8, src3 10, ureg 4, imm 2,
note predicate @P0 when FORM bit 0 is set, uniform when FORM bit 1 is set, control CONTROL, with every virtual
note register on the physical register of its own number (omega_blackwell_encode_one). The encoder must accept
note it exactly when ACCEPTED is 1 and give the four words W0..W3 of the C encoder; and, the old test's own
note property, an accepted word 3 carries CONTROL's stall, yield, scoreboard and wait bits (0x03fffe00).
text t_name "BWCTL"
const CTLF ulong 67108352
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn bwx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
fn bww code view uchar 16384 k ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get code add mul k 4 j mul j 8
end
ret v
end
fn crow to bool
if or ne ckcnt 9 ne cklen 0 1
ckbad
end
if ne ckch 0 0 101
ckbad
end
form = bwx 2
cw = bwx 3
acc = bwx 4
if or gt form 3 gt acc 1
ckbad
end
ins = new ulong 8192 0
phys = new ulong 288 0
code = new uchar 16384 0
for i ulong 256
put phys i i
end
for i ulong 32
put phys add 256 i i
end
put ins 0 bwx 1
put ins 1 4
put ins 2 6
put ins 3 8
put ins 4 10
put ins 5 4
put ins 6 or 2 shl cw 32
put ins 7 or shr form 1 shl and form 1 1
got = bw_enc_sm121 view ins view phys 1 0 edit code
if eq acc 0
ret ne got 16
end
if ne got 16
ret false
end
ok = true
for k ulong 4
if ne bww view code k bwx add k 5
ok = false
end
end
if ne and bww view code 3 CTLF and cw CTLF
ok = false
end
ret ok
end

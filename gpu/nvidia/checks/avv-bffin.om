note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-bffin.om: av_bffin (gpu/nvidia/om/api/attn_bffin.om) against av_bffinite of CUDApp src/omega_attn_views.h;
note A is ushort (bf16); r is 1 + the index of the first of the first n with an all-ones exponent, 0 when none; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-BFFIN"
text t_au "bffin"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new ushort 1000003 0
avgs s a l
put o 0 av_bffin s n
put o 1 avhs s l
end

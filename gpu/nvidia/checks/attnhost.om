note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/attnhost.om: the Omega port of the policy and clock blocks of CUDApp
note tests/attn_host_diff.c (its scan block is gpu/nvidia/checks/attnscan.om). Composed after
note gpu/nvidia/om/api/attn_host.om (ah_plan), gpu/nvidia/om/api/clock_ns.om (clock_ns) and
note gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/attnhost.tsv. Rows, lowercase hex:
note p OP IN0..IN22 R OUT0..OUT22: ah_plan on q = IN (q 23..31 zero) answers R and leaves q = OUT, with
note q 23..31 still zero.
note c S NS R: clock_ns S NS answers R.
text t_name "ATTNHOST"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn ahx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
fn prow to bool
if ne ckcnt 49
ckbad
end
q = new ulong 32 0
for k ulong 23
put q k ahx add k 2
end
r = ah_plan q uint ahx 1
ok = eq r ahx 25
for k ulong 23
if ne get q k ahx add k 26
ok = false
end
end
for k ulong 9
if ne get q add k 23 0
ok = false
end
end
ret ok
end
fn crow to bool
if ne cklen 0 1
ckbad
end
k = ckch 0 0
if eq k 112
ret prow
end
if eq k 99
if ne ckcnt 4
ckbad
end
ret eq clock_ns ahx 1 ahx 2 ahx 3
end
ckbad
ret false
end

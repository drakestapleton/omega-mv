note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-bids.om: av_bids (gpu/nvidia/om/api/attn_bids.om) against av_badids of CUDApp src/omega_attn_views.h;
note A is uint; r counts the first n at or above the limit v; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-BIDS"
text t_au "bids"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new uint 1000003 0
avgu s a l
put o 0 av_bids s n uint and v 4294967295
put o 1 avhu s l
end

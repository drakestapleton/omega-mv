note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-pack.om: the units over gpu/nvidia/om/apirest/pack.om with apish_pack.om: arnan,
note arscale, arfold, arfoldh, aracc, armag, as data_parts() and state_parts() of CUDApp
note tests/api_rest_partitions.h call them; the fills are the test's own loops. Composed before arestg.om.
text t_name "AREST-PACK"
text t_nan "nan"
text t_scale "scale"
text t_fold "fold"
text t_foldh "foldh"
text t_acc "acc"
text t_mag "mag"
note h[i] = 0x3f00 + i % 128
fn ax_hgen x edit ushort 65537 to void
for i ulong 65537
put x i ushort add 16128 rem i 128
end
end
fn ax_dg y view f32 65537 n ulong to ulong
h = ardg0
for i ulong n bound 65537
h = ardg h ulong bitcast uint get y i
end
ret h
end
note Q n; bytes[i] = (unsigned char)i; y starts as {UINT64_MAX, 0}
fn ax_nan q view ulong 256 o edit ulong 256 to ulong
n = get q 0
if gt n 65537
ckbad
end
x = new uchar 65537 0
for i ulong 65537
put x i uchar and i 255
end
y = new ulong 2 0
put y 0 18446744073709551615
r = arnan part x 0 n y
put o 0 get y 0
put o 1 get y 1
ret r
end
note Q mut, n
fn ax_scale q view ulong 256 o edit ulong 256 to ulong
n = get q 1
if gt n 65537
ckbad
end
x = new ushort 65537 0
ax_hgen x
y = new f32 65537 0.0f32
r = arscale get q 0 part x 0 n part y 0 n
put o 0 ax_dg y n
ret r
end
note Q n; a[i] = (float)(i % 127)
fn ax_fold q view ulong 256 o edit ulong 256 to ulong
n = get q 0
if gt n 65537
ckbad
end
x = new f32 65537 0.0f32
for i ulong 65537
put x i f32 rem i 127
end
y = new f32 65537 0.0f32
r = arfold part x 0 n part y 0 n
put o 0 ax_dg y n
ret r
end
fn ax_foldh q view ulong 256 o edit ulong 256 to ulong
n = get q 0
if gt n 65537
ckbad
end
x = new ushort 65537 0
ax_hgen x
y = new f32 65537 0.0f32
r = arfoldh part x 0 n part y 0 n
put o 0 ax_dg y n
ret r
end
note Q n; w 0x38, scale {0x3f80, 0x4000}, x alternating 1, -1; m 0 is aracc, 1 is armag
fn ax_acc q view ulong 256 m ulong to ulong
n = get q 0
if gt n 129
ckbad
end
w = new uchar 129 56
sc = new ushort 2 16256
put sc 1 16384
x = new f32 129 1.0f32
for i ulong 129
if eq rem i 2 1
put x i -1.0f32
end
end
if eq m 0
ret aracc part w 0 n part sc 0 2 part x 0 n
end
ret armag part w 0 n part sc 0 2 part x 0 n
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_nan
ret ax_nan q o
end
if ckis 0 t_scale
ret ax_scale q o
end
if ckis 0 t_fold
ret ax_fold q o
end
if ckis 0 t_foldh
ret ax_foldh q o
end
if ckis 0 t_acc
ret ax_acc q 0
end
if ckis 0 t_mag
ret ax_acc q 1
end
ckbad
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-comp.om: av_comp (gpu/nvidia/om/api/attn_comp.om) against av_compact32 of CUDApp src/omega_attn_views.h;
note A (int32 bits) and B are uint; the first n of A that are not negative go to the front of B, r their count; h over B. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-COMP"
text t_au "comp"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new uint 1000003 0
avgu s a l
avop2 s b l n o
end
fn avop2 s view uint * b view ulong 9 l ulong n ulong o edit ulong 2 to void
d = new uint 1000003 0
avgu d b l
put o 0 av_comp s d n
put o 1 avhu d l
end

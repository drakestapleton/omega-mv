note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-pkh.om: cg_pklen and cg_pkh (gpu/nvidia/om/codegen/cg_pack_len.om, cg_pack_h.om),
note as packing() of CUDApp tests/api_rest_diff.c calls them. Unit pk: Q the first eight q words (kind, m, k, mp,
note kp, n, nt0, nt1); cg_pklen sets the source byte count and the destination count, then cg_pkh packs the test's
note source (ushort i, or for kinds 3 and 4 the float (int)(i % 31 - 15), as little-endian bytes). Outputs: 0 the
note digest of the packed ushorts, 1 the cg_pklen answer, 2 the destination count; the answer is cg_pkh's. Unit
note pklen: Q the twelve q words, the answer cg_pklen's. Composed before arestg.om.
text t_name "AREST-PKH"
text t_pk "pk"
text t_pklen "pklen"
fn ax_src s edit uchar 1156 kind ulong to void
for i ulong 289
if ge kind 3
v = bitcast uint f32 sub long rem i 31 15
p = mul i 4
put s p uchar and v 255
put s add p 1 uchar and shr v 8 255
put s add p 2 uchar and shr v 16 255
put s add p 3 uchar shr v 24
else
put s mul i 2 uchar and i 255
put s add mul i 2 1 uchar shr i 8
end
end
end
fn ax_pk q view ulong 256 o edit ulong 256 to ulong
p = new ulong 12 0
for i ulong 8
put p i get q i
end
rl = cg_pklen p
put o 1 bitcast ulong rl
sn = get p 8
dn = get p 9
put o 2 dn
if ne rl 0
ret 0
end
if or gt sn 1156 gt dn 1024
ckbad
end
s = new uchar 1156 0
ax_src s get p 0
d = new ushort 1024 0
r = cg_pkh p part s 0 sn part d 0 dn
h = ardg0
for i ulong dn bound 1024
h = ardg h ulong get d i
end
put o 0 h
ret bitcast ulong r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_pk
if ne nq 8
ckbad
end
ret ax_pk q o
end
if or ne nq 12 not ckis 0 t_pklen
ckbad
end
p = new ulong 12 0
for i ulong 12
put p i get q i
end
ret bitcast ulong cg_pklen p
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-fill.om: av_fill (gpu/nvidia/om/api/attn_fill.om) against av_fill32 of CUDApp src/omega_attn_views.h;
note A is uint; sets the first n to v; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-FILL"
text t_au "fill"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
d = new uint 1000003 0
avgu d a l
put o 0 av_fill d n uint and v 4294967295
put o 1 avhu d l
end

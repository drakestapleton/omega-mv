note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-set.om: av_set (gpu/nvidia/om/api/attn_set.om) against av_memset of CUDApp src/omega_attn_views.h;
note A is uchar; sets the first n to v (a byte); h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-SET"
text t_au "set"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
d = new uchar 1000003 0
avgc d a l
put o 0 av_set d n uchar and v 255
put o 1 avhc d l
end

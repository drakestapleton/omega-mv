note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-rows.om: av_rows (gpu/nvidia/om/api/attn_rows.om) against av_rowtab of CUDApp src/omega_attn_views.h;
note A is uint, L at least 2n (else ckbad); the first n become 0 and the next n base v + i + 1 cut to 32 bits; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-ROWS"
text t_au "rows"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
if gt mul n 2 l
ckbad
end
d = new uint 1000003 0
avgu d a l
put o 0 av_rows d n v
put o 1 avhu d l
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/numhost.om: the Omega port of CUDApp tests/ampere_numeric_host_test.c. Composed after
note the numeric_reduce unit (gpu/nvidia/om/numeric/numeric.om, tile.om, rest.om, reduce.om) and
note gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/numhost.tsv. Numbers are lowercase hex FP32 bits.
note   o OM A B C OUT       numeric_ref OM A B C must be OUT (OM: the dispatcher's op code, decimal)
note   r OP N X1 .. XN OUT  (OP and N decimal) numeric_reduce OP over the N values (one padded stage, N at most 32) must be OUT
text t_name "NUMHOST"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn nhx i ulong to ulong
n = cklen i
if or eq n 0 gt n 8
ckbad
end
v = ulong 0
for j ulong n bound 8
v = or shl v 4 cknib ckch i j
end
ret v
end
fn nhred op ulong n ulong to bool
t = new ulong 32 0
for i ulong n bound 32
put t i nhx add 3 i
end
r = numeric_reduce op n view t 0 0
ret eq r nhx add 3 n
end
fn crow to bool
k = ckch 0 0
nc = ckcnt
if eq k 111
if ne nc 6
ckbad
end
ret eq numeric_ref cknum 1 nhx 2 nhx 3 nhx 4 nhx 5
end
if ne k 114
ckbad
end
n = cknum 2
if or eq n 0 gt n 32
ckbad
end
if ne nc add n 4
ckbad
end
ret nhred cknum 1 n
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/sm121dis.om: the Omega port of CUDApp tests/sm121_dis_diff_test.c. Composed after
note gpu/nvidia/om/disasm/sm121_dis.om and gpu/nvidia/checks/lib.om; run with gpu/nvidia/checks/sm121dis.tsv.
note Rows (numbers in lowercase hex):
note   g LO HI TEXT        a golden word: sm121_dis must print TEXT (what nvdisasm 13.0.85 -b SM121 printed for
note                       it), and the same word with bit 16 flipped (the old test's corrupted-word control) must not
note   w LO HI PC RC TEXT  one word of the old test's differential stream (per form of the C table, random, IMAD
note                       immediates, the IMAD.SHL powers of two), with the status RC (0 decoded, -1 no form,
note                       -2 did not fit; TEXT - then) and the text the retained C decoder c_sm121_disasm gave
note The result word of sm121_dis is read as the C binding reads it: bits 0..15 the text length, 16 no form
note matched (-1), 18 the text did not fit, or a length of 256 or more (-2). Bit 17 (EXIT) must be set exactly
note when the opcode bits are 0x94d, as the binding requires.
text t_name "SM121DIS"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn dhx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
note field i as 0, -1 or -2: the code 0, 1 or 2
fn drc i ulong to ulong
n = cklen i
if and eq n 1 eq ckch i 0 48
ret 0
end
if ne n 2
ckbad
end
if ne ckch i 0 45
ckbad
end
c = ckch i 1
if or lt c 49 gt c 50
ckbad
end
ret sub c 48
end
note the status code of a result word r
fn dst r ulong to ulong
n = and r 65535
if or ne and shr r 18 1 0 ge n 256
ret 2
end
ret and shr r 16 1
end
fn dtext o view uchar 256 r ulong i ulong to bool
n = and r 65535
if ge n 256
ret false
end
if ne cklen i n
ret false
end
for j ulong n bound 256
if ne ulong get o j ckch i j
ret false
end
end
ret true
end
fn dgold lo ulong hi ulong to bool
o = new uchar 256 0
r = sm121_dis lo hi 0 edit o
if ne dst r 0
ret false
end
if not dtext view o r 3
ret false
end
r = sm121_dis xor lo 65536 hi 0 edit o
if eq dst r 0
if dtext view o r 3
ret false
end
end
ret true
end
fn dword lo ulong hi ulong pc ulong rc ulong to bool
o = new uchar 256 0
r = sm121_dis lo hi pc edit o
if ne dst r rc
ret false
end
x = and shr r 17 1
e = ulong 0
if eq and lo 4095 2381
e = 1
end
if ne x e
ret false
end
if eq rc 2
ret true
end
ret dtext view o r 5
end
fn crow to bool
k = ckch 0 0
nc = ckcnt
if eq k 103
if ne nc 4
ckbad
end
ret dgold dhx 1 dhx 2
end
if ne k 119
ckbad
end
if ne nc 6
ckbad
end
ret dword dhx 1 dhx 2 dhx 3 drc 4
end

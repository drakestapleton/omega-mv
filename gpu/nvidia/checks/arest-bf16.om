note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-bf16.om: ar_bf16 (gpu/nvidia/om/apirest/bf16.om over apiviews/bf16.om) and artcperm
note (tcperm.om), as data_parts() and misc_parts() of CUDApp tests/api_rest_partitions.h call them. Composed
note before arestg.om.
text t_name "AREST-BF16"
text t_bf16 "bf16"
text t_tcperm "tcperm"
note the test's nine bit patterns
fn ax_bits k ulong to uint
if eq k 0
ret 0
end
if eq k 1
ret 1
end
if eq k 2
ret 0x3f807fff
end
if eq k 3
ret 0x3f808000
end
if eq k 4
ret 0x3f808001
end
if eq k 5
ret 0x7f800000
end
if eq k 6
ret 0x7f800001
end
if eq k 7
ret 0xfffffffe
end
ret 0xffffffff
end
note Q n and the output length; f[i] is pattern i % 9; output 0 the digest of the n bf16
fn ax_bf16 q view ulong 256 nq ulong o edit ulong 256 to ulong
n = get q 0
yl = get q 1
if or or ne nq 2 gt n 36 gt yl 40
ckbad
end
x = new f32 36 0.0f32
for i ulong 36
put x i bitcast f32 ax_bits rem i 9
end
y = new ushort 40 0x5a5a
r = ar_bf16 part x 0 n part y 0 yl
if ne r 0
ret r
end
h = ardg0
for i ulong n bound 36
h = ardg h ulong get y i
end
put o 0 h
ret r
end
note Q the fill (0: (float)(i % 17), 1: (float)(i * 3)), m, the output length; output 0 the digest of the m bf16
fn ax_tcperm q view ulong 256 nq ulong o edit ulong 256 to ulong
m = get q 1
yl = get q 2
if or or ne nq 3 gt m 512 gt yl 512
ckbad
end
x = new f32 512 0.0f32
for i ulong 512
if eq get q 0 0
put x i f32 rem i 17
else
put x i f32 mul i 3
end
end
y = new ushort 512 0x5a5a
r = artcperm part x 0 m part y 0 yl
if ne r 0
ret r
end
h = ardg0
for i ulong m bound 512
h = ardg h ulong get y i
end
put o 0 h
ret r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_bf16
ret ax_bf16 q nq o
end
if ckis 0 t_tcperm
ret ax_tcperm q nq o
end
ckbad
ret 0
end

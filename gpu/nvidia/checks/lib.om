note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/lib.om: the table reader every check of gpu/nvidia/checks shares. A check is the gpu/
note units it tests, then this part, then the check's own part, concatenated (gpu/nvidia/checks/checks.tsv) and
note compiled by seed/out/omc. Run: CHECK TABLE. The table holds one case per line, fields split by tabs; an
note empty line or one starting with # is skipped. For each case main calls the check's `fn crow to bool` with
note the fields of the case; false is a failed case. The check prints its own name in `fn cname to void` (a
note text must be declared before its first use, so lib.om cannot name the check's text).
note Output: one FAIL line per failed case (its line number and text), then NAME PASS rows=N (exit 0), or
note NAME FAIL rows=N failed=F (exit 1). A table with no case fails. Exit 2: bad usage, a table that cannot be
note read or held (enlarge refused), or a field the check cannot read (ckbad). The table and the field list
note are run-time pools sized from the input; the path is at most 4095 bytes (Linux PATH_MAX less the 0).
text t_ckusage "usage: CHECK TABLE\n"
text t_ckread "check: cannot read the table, or the host refused memory to hold it\n"
text t_ckbadf "check: unreadable field on line "
text t_ckfail "FAIL line "
text t_ckpass " PASS rows="
text t_ckfl " FAIL rows="
text t_ckfd " failed="
global ck_t uchar *
global ck_fs ulong *
global ck_fe ulong *
global ck_p uchar 4096
global ck_o uchar 65536
global ck_n ulong 16
note ck_n: 0 table length, 1 output length, 2 fields in the row, 3 line number, 4 rows, 5 failed
fn ckflush to void
o = ulong 0
n = get ck_n 1
while lt o n bound 65537
x = write 1 ck_o o sub n o
if le x 0
exit 2
end
o = add o ulong x
end
put ck_n 1 0
end
fn ckoc c ulong to void
n = get ck_n 1
if ge n len ck_o
ckflush
n = 0
end
put ck_o n uchar c
put ck_n 1 add n 1
end
note lib.om is OM-1 so that it composes with units of either profile (an OM-1 unit may use words OM-2 reserves,
note such as layout); OM-1 has no unsized view, so a text is never passed: ckout k prints lib's own text k (0 FAIL
note line, 1 PASS rows=, 2 FAIL rows=, 3 failed=), and a check prints its name with ckoc in its own cname
fn ckout k ulong to void
if eq k 0
for i ulong len t_ckfail bound 64
ckoc ulong get t_ckfail i
end
end
if eq k 1
for i ulong len t_ckpass bound 64
ckoc ulong get t_ckpass i
end
end
if eq k 2
for i ulong len t_ckfl bound 64
ckoc ulong get t_ckfl i
end
end
if eq k 3
for i ulong len t_ckfd bound 64
ckoc ulong get t_ckfd i
end
end
end
fn cknumo v ulong to void
if ge v 10
cknumo div v 10
end
ckoc add 48 rem v 10
end
note exit 2 with lib's own message k: 0 usage, 1 the table cannot be read or held
fn ckrefuse k ulong to void
ckflush
if eq k 0
r = write 2 t_ckusage 0 len t_ckusage
end
if eq k 1
r = write 2 t_ckread 0 len t_ckread
end
exit 2
end
note a field the check cannot read: exit 2 naming the line (a broken table is not a failed case)
fn ckbad to void
ckflush
r = write 2 t_ckbadf 0 len t_ckbadf
cknumo get ck_n 3
ckoc 10
r = write 2 ck_o 0 get ck_n 1
exit 2
end
fn ckcnt to ulong
ret get ck_n 2
end
fn cklen i ulong to ulong
if ge i get ck_n 2
ckbad
end
ret sub get ck_fe i get ck_fs i
end
note byte j of field i
fn ckch i ulong j ulong to ulong
if ge j cklen i
ckbad
end
ret ulong get ck_t add get ck_fs i j
end
note field i as an unsigned decimal below 2^64; anything else is ckbad
fn cknum i ulong to ulong
n = cklen i
if or eq n 0 gt n 20
ckbad
end
v = ulong 0
for j ulong n bound 20
c = ckch i j
if or lt c 48 gt c 57
ckbad
end
d = sub c 48
if gt v div sub 18446744073709551615 d 10
ckbad
end
v = add mul v 10 d
end
ret v
end
fn cknib c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
ckbad
ret 0
end
note field i as lowercase hex bytes: their count (0 for "-"); ckhex i j is byte j
fn ckhexn i ulong to ulong
n = cklen i
if and eq n 1 eq ckch i 0 45
ret 0
end
if or eq n 0 ne rem n 2 0
ckbad
end
ret div n 2
end
fn ckhex i ulong j ulong to ulong
hi = cknib ckch i mul j 2
lo = cknib ckch i add mul j 2 1
ret or shl hi 4 lo
end
note field slot k exists in ck_fs and ck_fe
fn ckslot k ulong to void
if lt k len ck_fs
ret
end
n = mul add k 1 2
r = enlarge ck_fs n
q = enlarge ck_fe n
if or lt r 0 lt q 0
ckrefuse 1
end
end
note split ck_t[s, e) at tabs into ck_fs/ck_fe
fn cksplit s ulong e ulong to void
k = ulong 0
ckslot 0
put ck_fs 0 s
i = s
while lt i e bound 1099511627776
if eq get ck_t i 9
put ck_fe k i
k = add k 1
ckslot k
put ck_fs k add i 1
end
i = add i 1
end
put ck_fe k e
put ck_n 2 add k 1
end
fn ckline s ulong e ulong to void
if or eq s e eq get ck_t s 35
ret
end
cksplit s e
put ck_n 4 add get ck_n 4 1
if not crow
put ck_n 5 add get ck_n 5 1
ckout 0
cknumo get ck_n 3
ckoc 58
ckoc 32
for j ulong sub e s bound 1099511627776
c = ulong get ck_t add s j
if eq c 9
c = 32
end
ckoc c
end
ckoc 10
end
end
note read the file named by argument 1 into ck_t, growing it as the file needs; its length
fn ckload to ulong
p = argread 1 ck_p 0 4095
if lt p 1
ckrefuse 0
end
fd = fopen ck_p 0 ulong p int 524288 int 0
if lt fd 0
ckrefuse 1
end
n = ulong 0
while true bound 1099511627776
if eq n len ck_t
g = add mul n 2 65536
r = enlarge ck_t g
if lt r 0
ckrefuse 1
end
end
x = read int fd ck_t n sub len ck_t n
if lt x 0
ckrefuse 1
end
if eq x 0
break
end
n = add n ulong x
end
r = fclose int fd
ret n
end
fn main to int
if ne argcnt 2
ckrefuse 0
end
n = ckload
put ck_n 0 n
s = ulong 0
line = ulong 1
while lt s n bound 1099511627776
e = s
while and lt e n ne get ck_t e 10 bound 1099511627776
e = add e 1
end
put ck_n 3 line
ckline s e
s = add e 1
line = add line 1
end
f = get ck_n 5
ckrows = get ck_n 4
cname
if and eq f 0 gt ckrows 0
ckout 1
cknumo ckrows
ckoc 10
ckflush
ret 0
end
ckout 2
cknumo ckrows
ckout 3
cknumo f
ckoc 10
ckflush
ret 1
end

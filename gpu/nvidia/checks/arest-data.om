note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-data.om: the units over gpu/nvidia/om/apirest/data.om with apish_shp.om and
note apish_slot.om: arfill, arcount, arargs, arpad, aridle, arroute, arperm, arwiden, arnext, arkey, arpfcopy,
note arpfrat, arsegok, arsegb, argspec, arslot, arsgate. Each ax_ word lays one row out as the call of CUDApp
note tests/api_rest_diff.c or tests/api_rest_partitions.h it stands for; the fills are the test's own loops.
note Composed before arestg.om.
text t_name "AREST-DATA"
text t_fill "fill"
text t_count "count"
text t_args "args"
text t_pad "pad"
text t_idle "idle"
text t_route "route"
text t_perm "perm"
text t_widen "widen"
text t_next "next"
text t_key "key"
text t_pfcopy "pfcopy"
text t_pfrat "pfrat"
text t_segok "segok"
text t_segb "segb"
text t_gspec "gspec"
text t_slot "slot"
text t_sgate "sgate"
note the q of the last next row, for a row whose flag is 1
global ax_nq ulong 12
note x[i] = i % 3 ? UINT32_MAX : 0
fn ax_xgen x edit uint 65537 to void
for i ulong 65537
if ne rem i 3 0
put x i 4294967295
end
end
end
fn ax_fill q view ulong 256 o edit ulong 256 to ulong
n = get q 1
if gt n 65537
ckbad
end
y = new uint 65537 0
r = arfill get q 0 part y 0 n
h = ardg0
for i ulong n bound 65537
h = ardg h ulong get y i
end
put o 0 h
ret r
end
fn ax_count q view ulong 256 to ulong
n = get q 1
if gt n 65537
ckbad
end
x = new uint 65537 0
ax_xgen x
ret arcount get q 0 part x 0 n
end
fn ax_pad q view ulong 256 o edit ulong 256 to ulong
n = get q 0
if gt n 65537
ckbad
end
x = new uint 65537 0
ax_xgen x
y = new uint 65537 0
r = arpad part x 0 n part y 0 n
h = ardg0
for i ulong n bound 65537
h = ardg h ulong get y i
end
put o 0 h
ret r
end
note Q n and the output length; h[i] = 0x3f00 + i % 128
fn ax_widen q view ulong 256 o edit ulong 256 to ulong
n = get q 0
yl = get q 1
if or gt n 65537 gt yl 65538
ckbad
end
x = new ushort 65537 0
for i ulong 65537
put x i ushort add 16128 rem i 128
end
y = new f32 65538 0.0f32
r = arwiden part x 0 n part y 0 yl
if ne r 0
ret r
end
h = ardg0
for i ulong n bound 65537
h = ardg h ulong bitcast uint get y i
end
put o 0 h
ret r
end
fn ax_idle q view ulong 256 nq ulong to ulong
n = get q 0
if or ne nq 13 gt n 12
ckbad
end
rec = new uint 12 0
for i ulong 12
put rec i uint get q add 1 i
end
ret aridle part rec 0 n
end
fn ax_args q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if or gt nq 16 gt ny 32
ckbad
end
va = new ulong 16 0
for i ulong nq bound 16
put va i get q i
end
y = new uint 32 0
r = arargs part va 0 nq part y 0 ny
for i ulong 32
put o i ulong get y i
end
ret r
end
note Q e; x[i] = (float)i
fn ax_route q view ulong 256 o edit ulong 256 to ulong
e = get q 0
if gt e 4
ckbad
end
x = new f32 160 0.0f32
for i ulong 160
put x i f32 i
end
y = new f32 180 0.0f32
r = arroute e part x 0 mul e 32 part y 0 mul e 36
h = ardg0
for i ulong mul e 36 bound 180
h = ardg h ulong bitcast uint get y i
end
put o 0 h
ret r
end
note Q lb; x[i] = (float)(i % 17), n = 32 * lb
fn ax_perm q view ulong 256 o edit ulong 256 to ulong
lb = get q 0
n = mul 32 lb
if gt n 512
ckbad
end
x = new f32 512 0.0f32
for i ulong 512
put x i f32 rem i 17
end
y = new f32 512 0.0f32
r = arperm lb part x 0 n part y 0 n
h = ardg0
for i ulong n bound 512
h = ardg h ulong bitcast uint get y i
end
put o 0 h
ret r
end
fn ax_next q view ulong 256 nq ulong o edit ulong 256 to ulong
if ne nq 17
ckbad
end
a = new ulong 12 0
for i ulong 12
if eq get q 0 0
put a i get q add 1 i
else
put a i get ax_nq i
end
end
cnt = new uint 4 0
for i ulong 4
put cnt i uint get q add 13 i
end
r = arnext a part cnt 0 4
for i ulong 12
put ax_nq i get a i
put o add 129 i get a i
end
ret r
end
fn ax_key q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if or ne nq 4 gt ny 8
ckbad
end
s = new uint 3 0
for i ulong 3
put s i uint get q add 1 i
end
y = new uint 8 0
r = arkey uint get q 0 part s 0 3 part y 0 ny
for i ulong 8
put o i ulong get y i
end
ret r
end
note Q n, k, layout, 0; s[i] = (uint8_t)(i / k)
fn ax_pfcopy q view ulong 256 o edit ulong 256 to ulong
n = get q 0
k = get q 1
if or or eq k 0 gt n 384 gt k 384
ckbad
end
nk = mul n k
a = new ulong 4 0
for i ulong 4
put a i get q i
end
s = new uchar 147456 0
for i ulong nk bound 147456
put s i uchar and div i k 255
end
y = new uchar 147456 0
r = arpfcopy a part s 0 nk part y 0 nk
h = ardg0
for i ulong nk bound 147456
h = ardg h ulong get y i
end
put o 0 h
ret r
end
note Q n, k, layout, 0; sf[i] = (float)(i + 1); the (n/128)*(k/128) scales give (n/8)*(k/128+1) ratios
fn ax_pfrat q view ulong 256 o edit ulong 256 to ulong
n = get q 0
kb = div get q 1 128
ns = mul div n 128 kb
nr = mul div n 8 add kb 1
if or gt ns 9 gt nr 512
ckbad
end
a = new ulong 4 0
for i ulong 4
put a i get q i
end
sf = new f32 9 0.0f32
for i ulong 9
put sf i f32 add i 1
end
y = new f32 512 0.0f32
r = arpfrat a part sf 0 ns part y 0 nr
h = ardg0
for i ulong nr bound 512
h = ardg h ulong bitcast uint get y i
end
put o 0 h
ret r
end
fn ax_segok q view ulong 256 nq ulong to ulong
if ne nq 10
ckbad
end
e = new uint 4 0
sc = new f32 4 0.0f32
for i ulong 4
put e i uint get q add 2 i
put sc i bitcast f32 uint get q add 6 i
end
ret arsegok uint get q 0 uint get q 1 e sc
end
fn ax_segb q view ulong 256 nq ulong o edit ulong 256 to ulong
if ne nq 6
ckbad
end
e = new uint 3 0
for i ulong 3
put e i uint get q add 3 i
end
y = new uint 3 0
r = arsegb uint get q 0 uint get q 1 uint get q 2 e y
for i ulong 3
put o i ulong get y i
end
ret r
end
fn ax_gspec q view ulong 256 nq ulong o edit ulong 256 to ulong
if ne nq 8
ckbad
end
s = new uint 8 0
for i ulong 8
put s i uint get q i
end
y = new uint 6 0
r = argspec s y
for i ulong 6
put o i ulong get y i
end
ret r
end
note Q q (8), r (3), stats (7); all three are edited, so each word comes back at 128 + its place in Q
fn ax_slot q view ulong 256 nq ulong o edit ulong 256 to ulong
if ne nq 18
ckbad
end
a = new ulong 8 0
for i ulong 8
put a i get q i
end
r = new ulong 3 0
for i ulong 3
put r i get q add 8 i
end
st = new ulong 7 0
for i ulong 7
put st i get q add 11 i
end
rc = arslot a r st
for i ulong 8
put o add 128 i get a i
end
for i ulong 3
put o add 136 i get r i
end
for i ulong 7
put o add 139 i get st i
end
ret bitcast ulong rc
end
fn ax_sgate q view ulong 256 nq ulong to ulong
if ne nq 4
ckbad
end
r = new ulong 3 0
for i ulong 3
put r i get q add 1 i
end
rc = arsgate get q 0 r
ret bitcast ulong rc
end
fn ax_a q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_fill
ret ax_fill q o
end
if ckis 0 t_count
ret ax_count q
end
if ckis 0 t_pad
ret ax_pad q o
end
if ckis 0 t_widen
ret ax_widen q o
end
if ckis 0 t_idle
ret ax_idle q nq
end
if ckis 0 t_args
ret ax_args q nq ny o
end
if ckis 0 t_route
ret ax_route q o
end
if ckis 0 t_perm
ret ax_perm q o
end
if ckis 0 t_next
ret ax_next q nq o
end
ckbad
ret 0
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_key
ret ax_key q nq ny o
end
if ckis 0 t_pfcopy
ret ax_pfcopy q o
end
if ckis 0 t_pfrat
ret ax_pfrat q o
end
if ckis 0 t_segok
ret ax_segok q nq
end
if ckis 0 t_segb
ret ax_segb q nq o
end
if ckis 0 t_gspec
ret ax_gspec q nq o
end
if ckis 0 t_slot
ret ax_slot q nq o
end
if ckis 0 t_sgate
ret ax_sgate q nq
end
ret ax_a q nq ny o
end

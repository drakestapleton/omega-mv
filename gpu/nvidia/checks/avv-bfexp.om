note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-bfexp.om: av_bfexp (gpu/nvidia/om/api/attn_bfexp.om) against av_bfexpand of CUDApp src/omega_attn_views.h;
note A is ushort (bf16), B f32; the first n of B become A widened to f32 bits; h over the bits of B. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-BFEXP"
text t_au "bfexp"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new ushort 1000003 0
avgs s a l
avop2 s b l n o
end
fn avop2 s view ushort * b view ulong 9 l ulong n ulong o edit ulong 2 to void
d = new f32 1000003 f32 0
avgf d b l
put o 0 av_bfexp s d n
put o 1 avhf d l
end

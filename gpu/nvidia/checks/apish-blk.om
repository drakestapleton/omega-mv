note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/apish-blk.om: the block and block0 comparisons of CUDApp tests/api_shells_diff.c, for
note apishb (gpu/nvidia/om/api/apish_blk.om), which has its own refb and so its own check. w is the first 128 of
note the test's bytes i, x its 512 bytes i * 17. Composed before apish-lib.om.
text t_name "APISH-BLK"
text l_block "block"
text l_block0 "block0"
fn aprun to void
w = new uchar 128 0
for i ulong 128
put w i uchar i
end
x = new uchar 512 0
for i ulong 512
put x i uchar and mul i 17 255
end
as6 l_block apishb w x 0x3f80
as6 l_block0 apishb w x 0
end

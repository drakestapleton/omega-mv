note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-any.om: av_any (gpu/nvidia/om/api/attn_any.om) against av_any32 of CUDApp src/omega_attn_views.h;
note A is uint; r is the or of the first n; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-ANY"
text t_au "any"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new uint 1000003 0
avgu s a l
put o 0 av_any s n
put o 1 avhu s l
end

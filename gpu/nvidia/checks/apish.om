note the test's B, its attention bounds, its upload n and k values, its fold edges; the xorshift state; the slot
note table of the test's last block: two records of three words, seven statistics, next_version and mutant
global ap_b ulong 38
global ap_bn ulong 19
global ap_ns ulong 11
global ap_ks ulong 11
global ap_e ulong 14
global ap_x ulong 1
global ap_tr ulong 6
global ap_ts ulong 7
global ap_tc ulong 2
fn xp op ulong a ulong b ulong c ulong d ulong e ulong to ulong
ret apishp uint op uint a uint b uint c uint d uint e
end
fn xk op ulong a ulong b ulong to ulong
ret apishk uint op uint a uint b 0 0 0
end
fn ap_i1 to void
put ap_b 0 0
put ap_b 1 1
put ap_b 2 2
put ap_b 3 3
put ap_b 4 4
put ap_b 5 7
put ap_b 6 8
put ap_b 7 15
put ap_b 8 16
put ap_b 9 31
put ap_b 10 32
put ap_b 11 45
put ap_b 12 63
put ap_b 13 64
put ap_b 14 127
put ap_b 15 128
put ap_b 16 129
put ap_b 17 255
put ap_b 18 256
put ap_b 19 511
put ap_b 20 512
put ap_b 21 1023
put ap_b 22 1024
put ap_b 23 2048
put ap_b 24 4095
put ap_b 25 4096
put ap_b 26 8191
put ap_b 27 8192
put ap_b 28 16384
put ap_b 29 32768
put ap_b 30 65535
put ap_b 31 65536
put ap_b 32 131072
put ap_b 33 262144
put ap_b 34 1048576
put ap_b 35 16777215
put ap_b 36 0x7fffffff
put ap_b 37 0xffffffff
put ap_x 0 0xa11e5001
end

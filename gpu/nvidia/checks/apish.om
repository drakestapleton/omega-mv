put ap_bn 11 256
put ap_bn 12 257
put ap_bn 13 32767
put ap_bn 14 32768
put ap_bn 15 32769
put ap_bn 16 65535
put ap_bn 17 65536
put ap_bn 18 131072
put ap_ns 0 0
put ap_ns 1 1
put ap_ns 2 255
put ap_ns 3 256
put ap_ns 4 512
put ap_ns 5 8192
put ap_ns 6 8193
put ap_ns 7 16384
put ap_ns 8 16385
put ap_ns 9 1073741824
put ap_ns 10 1073741825
put ap_ks 0 0
put ap_ks 1 1
put ap_ks 2 255
put ap_ks 3 256
put ap_ks 4 512
put ap_ks 5 768
put ap_ks 6 8192
put ap_ks 7 8448
put ap_ks 8 8704
put ap_ks 9 16384
put ap_ks 10 16640

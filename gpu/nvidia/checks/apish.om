fn ap_i3 to void
put ap_e 0 0
put ap_e 1 1
put ap_e 2 0x7f
put ap_e 3 0x80
put ap_e 4 0xff
put ap_e 5 0x100
put ap_e 6 0x7fffff
put ap_e 7 0x800000
put ap_e 8 0xffffff
put ap_e 9 0x7f7fffff
put ap_e 10 0x7f800000
put ap_e 11 0x80000000
put ap_e 12 0xff800000
put ap_e 13 0xffffffff
end
note the test's rnd() and pick()
fn ap_rnd to ulong
x = get ap_x 0
x = and xor x shl x 13 0xffffffff
x = xor x shr x 17
x = and xor x shl x 5 0xffffffff
put ap_x 0 x
ret x
end
fn ap_pick to ulong
r = ap_rnd
if eq and r 7 0
ret get ap_b rem r 38
end
ret r
end
note ---- check_upload
fn ap_up1 a ulong b ulong to void
as3 l_nkbad xp 57 a b 0 0 0
as3 l_qset xp 60 b 0 0 0 0
for q ulong 4
asi l_pfargs xp 61 a b q 0 0
end
end
fn ap_upr to void
a = ap_pick
b = ap_pick
c = and ap_pick 3
d = and ap_pick 7
as3 l_nk_r xp 57 a b 0 0 0
asi l_lay_r xp 58 c d 0 0 0
asi l_trit_r xp 59 and a 255 0 0 0 0
as3 l_qset_r xp 60 a 0 0 0 0
asi l_pf_r xp 61 a b c 0 0
end
fn ap_upload to void
for i ulong 11
for j ulong 11
ap_up1 get ap_ns i get ap_ks j
end
end
for q ulong 4
for r ulong 6
asi l_layok xp 58 q r 0 0 0
end
end
for v ulong 256
asi l_tritok xp 59 v 0 0 0 0
end
for n ulong 10000
ap_upr
end
end
note ---- check_pack_bytes
fn ap_pb1 to void
v = new uchar 16 0
for i ulong 16
put v i uchar add mul i 3 1
end
as6 l_trit apishr v
for b ulong 256
as3 l_refb xk 1 b 0
as3 l_kbits xk 2 b 0
asi l_isnan xk 3 b 0
as3 l_e4ref xk 2 b 0
asi l_e4nan xk 3 b 0
end
w = new uchar 256 0
for i ulong 256
put w i uchar i
end
y = new ulong 2 0
r = arnan part w 0 256 y
if ne r 0
ckbad
end
as6 l_scan get y 1
as6 l_scan get y 0
end
note omega_api_scalef: bit 32 of the op 4 answer is the refusal (-1), else the low half is the scale's bits
fn ap_sf t view uchar * tb view uchar * bf ulong m ulong to void
r = xk 4 bf m
if ne and r 0x100000000 0
as6 t 0xffffffffffffffff
else
as6 t 0
as3 tb r
end
end
fn ap_pb2 to void
for bf ulong 65536
ap_sf l_scalef l_scalebits bf 0
ap_sf l_scalefm l_scalebitsm bf 1
as3 l_x16 xk 6 bf 0
end
end
note omega_fp8_pack_scales is arscale: a refusal is -1
fn ap_ps t view uchar * sc view ushort 4 o edit f32 4 to void
r = arscale 0 part sc 0 4 part o 0 4
if ne r 0
as6 t 0xffffffffffffffff
else
as6 t 0
end
end
fn ap_pb3 to void
sc = new ushort 4 0
put sc 0 0x3f80
put sc 1 0x4000
put sc 2 0x7f80
o = new f32 4 0.0f32
ap_ps l_packscale_refuse sc o
put sc 2 0x3f00
ap_ps l_packscale sc o
for i ulong 4
as3 l_packscale_byte ulong bitcast uint get o i
end
for i ulong 14
as3 l_xfold_e xk 5 get ap_e i 0
end
end
note ---- check_shapes
fn ap_sh1 a ulong to void
as3 l_lane xp 1 a 0 0 0 0
as3 l_pad8 xp 9 a 0 0 0 0
as3 l_perm4 xp 17 a 0 0 0 0
as3 l_pfbm xp 18 a 0 0 0 0
asi l_finite xp 12 a 0 0 0 0
asi l_tile8 xp 15 a 0 0 0 0
asi l_dreg xp 22 a 0 0 0 0
as3 l_rrows xp 24 a 0 0 0 0
asi l_vy2 xp 28 a 0 0 0 0
as3 l_tcw xp 32 a 0 0 0 0
as3 l_qrt xp 37 a 0 0 0 0
if ne xp 39 a 0 0 0 0 0
as6 l_le128 1
else
as6 l_le128 0
end
as3 l_qgrp xp 36 a 0 0 0 0
end
fn ap_sh2 a ulong b ulong to void
v = xp 2 a b 0 0 0
as3 l_fp8m v
as3 l_fp8w shr v 32
as3 l_fp8mt xp 30 a b 0 0 0
as3 l_ctabud xp 16 a b 0 0 0
asi l_regfit xp 3 a b 0 0 0
asi l_align xp 14 a b 0 0 0
as6 l_pk xp 13 a b 0 0 0
as3 l_swsrc xp 19 a b 0 0 0
asi l_thok xp 29 a b 0 0 0
as3 l_rup xp 33 a b 0 0 0
as6 l_woff xp 34 a b 0 0 0
as3 l_qwait xp 38 a b 0 0 0
v = xp 8 a b 0 0 0
as3 l_ternw v
as3 l_ternc shr v 32
end
fn ap_shapes to void
for i ulong 38
ap_sh1 get ap_b i
for j ulong 38
ap_sh2 get ap_b i get ap_b j
end
end
for k ulong 257
as3 l_lane_x xp 1 k 0 0 0 0
end
for q ulong 16
as3 l_perm_x xp 17 q 0 0 0 0
end
for n ulong 65
as3 l_pad_x xp 9 n 0 0 0 0
end
for g ulong 32
as3 l_qgrp_x xp 36 mul add g 1 3 0 0 0 0
end
as3 l_qgrp0 xp 36 0 0 0 0 0
as3 l_qgrp1 xp 36 1 0 0 0 0
as3 l_qgrp32 xp 36 32 0 0 0 0
end
note ---- check_attn
note omega_api_qydiv: a high half is the refusal (1); the quotient is compared only when pc is not 0
fn ap_qy t view uchar * tq view uchar * a ulong b ulong to void
r = xp 41 a b 0 0 0
if ne shr r 32 0
as6 t 1
else
as6 t 0
end
if ne b 0
as3 tq r
end
end
fn ap_at1 a ulong to void
as3 l_gxatt xp 43 a 0 0 0 0
as3 l_kvsb xp 44 a 0 0 0 0
asi l_vy16 xp 47 a 0 0 0 0
as3 l_splt xp 48 a 0 0 0 0
asi l_persok xp 50 a 0 0 0 0
asi l_p2bad xp 56 a 0 0 0 0
end
fn ap_at2 a ulong b ulong to void
ap_qy l_qydiv l_qydivq a b
as6 l_qfbyt xp 42 a b 0 0 0
as6 l_hostb xp 45 a b 0 0 0
as6 l_plane xp 49 a b 0 0 0
as3 l_smaxp xp 54 a b 0 0 0
as6 l_mtps xp 55 a b 0 0 0
end
fn ap_at3 a ulong b ulong c ulong k ulong to void
asi l_roomok xp 40 a b c 0 0
asi l_pa256b xp 46 a b c 0 0
asi l_stride xp 51 a b c 0 0
asi l_mtbig xp 53 a b c 0 0
as6 l_mtgrp xp 52 a b c get ap_bn rem k 8 0
end
fn ap_atr to void
a = ap_pick
b = ap_pick
c = ap_pick
d = and ap_pick 31
asi l_room_r xp 40 a b c 0 0
asi l_pa_r xp 46 and a 65535 b c 0 0
ap_qy l_qy_r l_qyq_r a b
as6 l_qf_r xp 42 a b 0 0 0
as3 l_gx_r xp 43 a 0 0 0 0
as6 l_host_r xp 45 a b 0 0 0
asi l_vy_r xp 47 a 0 0 0 0
as6 l_plane_r xp 49 and a 63 b 0 0 0
asi l_p2_r xp 56 a 0 0 0 0
asi l_st_r xp 51 a b c 0 0
as6 l_grp_r xp 52 and a 255 b c d 0
asi l_big_r xp 53 and a 255 d b 0 0
end
fn ap_at4 a ulong b ulong to void
ap_at2 a b
for k ulong 19
ap_at3 a b get ap_bn k k
end
end
fn ap_attn to void
for i ulong 19
ap_at1 get ap_bn i
for j ulong 19
ap_at4 get ap_bn i get ap_bn j
end
end
for n ulong 10000
ap_atr
end
end
note ---- check_multi
note omega_api_dsplit: the low half is the code; the splits (high half) are written only when the code is 0,
note else the caller's value f stays
fn ap_ds t view uchar * ts view uchar * v ulong f ulong to void
as3 t v
if eq and v 0xffffffff 0
as3 ts shr v 32
else
as6 ts f
end
end
fn ap_mu1 a ulong b ulong c ulong to void
as3 l_tgbm xp 4 a b c 0 0
v = xp 5 a b c 0 0
as3 l_tgspecr v
as3 l_tgspecw shr v 32
as3 l_tgsz xp 6 a b c 0 0
asi l_maxmnk xp 20 a b c 0 0
asi l_dcache xp 21 a b c 0 0
ap_ds l_dsplitc l_dsplits xp 27 a b c 0 0 9
v = xp 31 a b c 0 0
as3 l_tcspr v
as3 l_tcspc shr v 32
asi l_wok xp 35 a b c 0 0
end
fn ap_mu2 a ulong b ulong c ulong d ulong e ulong to void
v = xp 7 a and b 1 and c 7 and d 15 and e 31
as3 l_terndr v
as3 l_terndd shr v 32
as3 l_segb xp 10 a b c d e
asi l_segend xp 11 a b c d e
asi l_tpack xp 23 a b and c 1 d e
as3 l_rtdst xp 25 a b c d 0
as3 l_rtsrc xp 26 a b c d 0
end
fn ap_mu3 i ulong j ulong to void
a = get ap_b i
b = get ap_b j
c = get ap_b rem add i j 38
d = get ap_b rem add mul i 3 j 38
e = get ap_b rem mul j 5 38
ap_mu1 a b c
ap_mu2 a b c d e
end
fn ap_multi to void
for i ulong 38
for j ulong 16
ap_mu3 i j
end
end
end
note ---- check_random
fn ap_rn1 a ulong b ulong c ulong d ulong e ulong to void
as3 l_r_lane xp 1 a 0 0 0 0
as3 l_r_tgbm xp 4 a b c 0 0
c1 = c
if eq c 0
c1 = 1
end
b5 = add rem b 5 1
as3 l_r_segb xp 10 rem a 8 b5 c1 d e
asi l_r_segend xp 11 rem a 8 b5 c1 d and e 1
asi l_r_wok xp 35 a b c1 0 0
end
fn ap_rn2 a ulong b ulong c ulong d ulong e ulong to void
asi l_r_align xp 14 a or b 1 0 0 0
as6 l_r_pk xp 13 rem a 64 b 0 0 0
asi l_r_max xp 20 a b c 0 0
asi l_r_tpack xp 23 a b and c 1 rem d 8 e
as3 l_r_rtdst xp 25 rem a 16 b rem c 8 rem d 8 0
as3 l_r_rtsrc xp 26 a b rem c 16 rem d 8 0
end
fn ap_rn3 a ulong b ulong c ulong to void
ap_ds l_r_dsc l_r_dss xp 27 a rem b 64 rem c 128 0 0 1
as6 l_r_woff xp 34 rem a 4096 b 0 0 0
as3 l_r_rup xp 33 a rem b 64 0 0 0
asi l_r_finite xp 12 a 0 0 0 0
as3 l_r_xfold xk 5 a 0
ap_sf l_r_sc l_r_scb and a 65535 and b 1
end
fn ap_rn to void
a = ap_pick
b = ap_pick
c = ap_pick
d = ap_pick
e = ap_pick
ap_rn1 a b c d e
ap_rn2 a b c d e
ap_rn3 a b c
end
fn ap_random to void
for n ulong 10000
ap_rn
end
end
note ---- check_slots
fn ap_sl1 rec edit ulong 16 op ulong aux ulong to void
r = apishl op aux rec
asi l_slot_rc bitcast ulong r
for k ulong 16
as6 l_slot_rec get rec k
end
end
fn ap_slots to void
rec = new ulong 16 0
ap_sl1 rec 1 0
ap_sl1 rec 1 0
ap_sl1 rec 2 0
ap_sl1 rec 1 0
ap_sl1 rec 3 17
ap_sl1 rec 4 0
ap_sl1 rec 4 0
ap_sl1 rec 5 0
ap_sl1 rec 5 0
ap_sl1 rec 7 0
ap_sl1 rec 6 0
ap_sl1 rec 3 1
ap_sl1 rec 8 0
junk = new ulong 16 0
asi l_slot_badop bitcast ulong apishl 9 0 junk
asi l_slot_stale_gate bitcast ulong apishl 7 0 junk
end
note the C slot table's step_slot (src/omega_fp8_slot_table.c): one arslot call on the slot's record and the
note table's statistics; next_version comes back in cfg word 0
fn ap_step slot ulong op ulong aux ulong ok ulong to ulong
cfg = new ulong 8 0
put cfg 0 get ap_tc 0
put cfg 1 get ap_tc 1
put cfg 2 ok
put cfg 3 op
put cfg 4 aux
r = new ulong 3 0
for i ulong 3
put r i get ap_tr add mul slot 3 i
end
st = new ulong 7 0
for i ulong 7
put st i get ap_ts i
end
rc = arslot cfg r st
for i ulong 3
put ap_tr add mul slot 3 i get r i
end
for i ulong 7
put ap_ts i get st i
end
put ap_tc 0 get cfg 0
ret bitcast ulong rc
end
note the test's table calls: begin_load is op 1, finish_load op 2 (aux the key, ok set), pin op 3 and unpin op 4
note (aux the version), evict op 5; the table is idle when op 6 answers non-zero for every slot (the form of the
note C file's pending branch; aridle, which the default build calls, is checked by arestdata)
fn ap_tbl to void
put ap_tc 0 1
asi l_tbl_begin ap_step 0 1 0 0
asi l_tbl_busy ap_step 0 1 0 0
r = ap_step 0 2 42 1
asi l_tbl_fin r
vv = ulong 0
if eq r 0
vv = get ap_tr 2
end
as6 l_tbl_ver vv
asi l_tbl_pin ap_step 0 3 vv 0
asi l_tbl_pin_stale ap_step 0 3 add vv 1 0
asi l_tbl_evict_busy ap_step 0 5 0 0
asi l_tbl_unpin ap_step 0 4 vv 0
asi l_tbl_unpin_bad ap_step 0 4 vv 0
asi l_tbl_evict ap_step 0 5 0 0
asi l_tbl_evict_stale ap_step 0 5 0 0
il = ulong 1
for i ulong 2
if eq il 1
if eq and ap_step i 6 0 0 0xffffffff 0
il = 0
end
end
end
as6 l_tbl_idle il
put ap_tc 1 1
asi l_tbl_mbegin ap_step 1 1 0 0
asi l_tbl_mpin ap_step 1 3 0 0
end
note ---- check_negative: the test's red controls
fn ap_neg to void
as3 l_neg_control xor xp 1 256 0 0 0 0 8
rec = new ulong 16 0
put rec 0 2
put rec 1 1

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/nartf.om: the Omega port of the artifacts() block of CUDApp tests/api_attn_rest_diff.c.
note Composed after gpu/nvidia/om/api/attn_art.om (it starts with om2), the roots gpu/nvidia/om/api/na_json.om,
note na_ver.om, na_layout.om, na_cubin.om and na_read.om, gpu/nvidia/checks/lib.om and gpu/nvidia/checks/lib-om2.om;
note run with gpu/nvidia/checks/nartf.tsv. Rows, tab separated; bytes are lowercase hex, "-" for none:
note   j C BYTES      the JSON string of the one-byte C string C (empty for C 0) is BYTES, quotes included
note   v H N R        H >= N as the C semver_ge says: R 1, 0, or -1 when either is not a strict A.B.C
note   k BYTES        the key list the C binding of manifest_layout_ok passes na_layout (kept for later rows)
note   b BYTES        the base manifest of the test (kept for later rows)
note   L N R          na_layout of the first N bytes of the base manifest (zero beyond it) is R
note   M I V R        na_layout of the base manifest with byte I set to V is R
note   c BYTES TEXT   the test's base cubin and its text (kept for later rows)
note   C N R          na_cubin of the first N bytes of the base cubin, function foo, is R
note   X I V R        na_cubin of the base cubin with byte I set to V is R
note   F N R          na_cubin of the base cubin for a function name of N bytes f is R
note   T I V R        na_cubin of the base cubin with byte I of the text xored with V is R
note   r N W          na_read of the first N bytes of the base cubin is W (hex)
note   K CUBIN TEXT FUNCTION C OMEGA WHY
note                  a known difference: the pending C answers C and na_cubin answers OMEGA for this cubin, text
note                  and function name. The row passes only when OMEGA is still na_cubin's answer and C still
note                  differs from it, so a change on either side fails the gate. C comes from the oracle (no C
note                  runs here); OMEGA was recorded when the check first met the input. WHY says what differs.
note The kept rows live in fixed arrays: a manifest of at most 8192 bytes (the binding's MANIFEST_CAP; one byte
note more so that the test's 8192-byte refusal case reads zeros), a key list and a cubin of at most 4096 bytes and
note a text of at most 64. A longer row is refused as a malformed table (exit 2), never cut. The units take views
note and a pool that grows cannot be passed (docs/RUNTIME-POOLS.md), so each row copies what it needs into its
note frame. The strict A.B.C parse of the v rows is the C binding's parse_semver, ported here: na_ver compares
note parsed versions.
text t_name "NARTF"
text t_foo "foo"
global nt_m uchar 8193
global nt_k uchar 4096
global nt_c uchar 4096
global nt_t uchar 64
note nt_n: 0 manifest length, 1 key length, 2 cubin length, 3 text length, 4 manifest and keys kept, 5 cubin kept
global nt_n ulong 6
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn ntx i ulong to ulong
n = cklen i
if or eq n 0 gt n 16
ckbad
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 cknib ckch i j
end
ret v
end
note field i as 0, 1, or 2 for -1
fn ntr i ulong to ulong
if and eq cklen i 2 eq ckch i 0 45
if eq ckch i 1 49
ret 2
end
end
v = cknum i
if gt v 1
ckbad
end
ret v
end
note the C binding's parse_semver: three decimal components of 1 to 9 digits split by dots, nothing more
fn ntsv s view uchar * v edit uint 3 to bool
p = ulong 0
for k ulong 3
x = uint 0
d = ulong 0
while lt p len s bound 4096
c = get s p
if or lt c 48 gt c 57
break
end
d = add d 1
if gt d 9
ret false
end
x = add mul x uint 10 uint sub c 48
p = add p 1
end
if eq d 0
ret false
end
put v k x
if lt k 2
if ge p len s
ret false
end
if ne get s p 46
ret false
end
p = add p 1
end
end
ret eq p len s
end
note copy hex field i into global array k of the kept rows (0 manifest, 1 keys, 2 cubin, 3 text)
fn ntkeep i ulong k ulong to void
n = ckhexn i
if eq k 0
if ge n len nt_m
ckbad
end
for j ulong n bound 8193
put nt_m j uchar ckhex i j
end
end
if eq k 1
if gt n len nt_k
ckbad
end
for j ulong n bound 4096
put nt_k j uchar ckhex i j
end
end
if eq k 2
if gt n len nt_c
ckbad
end
for j ulong n bound 4096
put nt_c j uchar ckhex i j
end
end
if eq k 3
if gt n len nt_t
ckbad
end
for j ulong n bound 64
put nt_t j uchar ckhex i j
end
end
put nt_n k n
end
note j rows
fn ntj to bool
js = new uchar 6 0
if ne ckcnt 3
ckbad
end
c = ntx 1
if gt c 255
ckbad
end
w = ckhexn 2
o = ulong 0
if ne c 0
o = na_json uchar c edit js
end
if ne w add o 2
ret false
end
if ne ckhex 2 0 34
ret false
end
if ne ckhex 2 add o 1 34
ret false
end
for j ulong o bound 6
if ne ckhex 2 add j 1 ulong get js j
ret false
end
end
ret true
end
note v rows
fn ntv to bool
hv = new uchar 4096 0
nv = new uchar 4096 0
h3 = new uint 3 0
n3 = new uint 3 0
if ne ckcnt 4
ckbad
end
a = ckhexn 1
b = ckhexn 2
if or gt a len hv gt b len nv
ckbad
end
for j ulong a bound 4096
put hv j uchar ckhex 1 j
end
for j ulong b bound 4096
put nv j uchar ckhex 2 j
end
got = ulong 2
if ntsv part hv 0 a edit h3
if ntsv part nv 0 b edit n3
got = 0
if na_ver view h3 view n3
got = 1
end
end
end
ret eq got ntr 3
end
note L and M rows (k is the row letter)
fn ntl k ulong to bool
m = new uchar 8193 0
ky = new uchar 4096 0
if ne get nt_n 4 3
ckbad
end
for j ulong len nt_m bound 8193
put m j get nt_m j
end
kl = get nt_n 1
for j ulong kl bound 4096
put ky j get nt_k j
end
n = get nt_n 0
want = ulong 0
if eq k 76
if ne ckcnt 3
ckbad
end
n = cknum 1
if ge n len m
ckbad
end
want = ntr 2
else
if ne ckcnt 4
ckbad
end
i = cknum 1
v = cknum 2
if or ge i n gt v 255
ckbad
end
put m i uchar v
want = ntr 3
end
got = ulong 0
if na_layout part m 0 n part ky 0 kl 8192
got = 1
end
ret eq got want
end
note r, C, X, F and T rows (k is the row letter)
fn ntc k ulong to bool
cb = new uchar 4096 0
tx = new uchar 64 0
if ne get nt_n 5 1
ckbad
end
cl = get nt_n 2
tl = get nt_n 3
for j ulong cl bound 4096
put cb j get nt_c j
end
for j ulong tl bound 64
put tx j get nt_t j
end
if eq k 114
if ne ckcnt 3
ckbad
end
n = cknum 1
if or gt n 8 gt n cl
ckbad
end
ret eq na_read part cb 0 n n ntx 2
end
ret ntcm k edit cb edit tx
end
note X and T rows: set byte I of the cubin copy, or xor byte I of the text copy, with V
fn ntmut k ulong cb edit uchar * tx edit uchar * to void
if ne ckcnt 4
ckbad
end
i = cknum 1
v = cknum 2
if gt v 255
ckbad
end
if eq k 88
if ge i get nt_n 2
ckbad
end
put cb i uchar v
else
if ge i get nt_n 3
ckbad
end
put tx i xor get tx i uchar v
end
end
note F rows: na_cubin for a function name of fl bytes f (the test's names of 120 to 129 bytes and shorter)
fn ntff cb view uchar * fl ulong tx view uchar * to bool
fb = new uchar 130 102
if gt fl len fb
ckbad
end
ret na_cubin cb part fb 0 fl tx
end
note C, X, F and T rows on the frame copies of the kept cubin cb and text tx
fn ntcm k ulong cb edit uchar * tx edit uchar * to bool
if or lt ckcnt 3 gt ckcnt 4
ckbad
end
n = get nt_n 2
if eq k 67
n = cknum 1
if or gt n get nt_n 2 ne ckcnt 3
ckbad
end
end
if or eq k 88 eq k 84
ntmut k edit cb edit tx
end
got = false
if eq k 70
if ne ckcnt 3
ckbad
end
got = ntff part cb 0 n cknum 1 part tx 0 get nt_n 3
else
got = na_cubin part cb 0 n t_foo part tx 0 get nt_n 3
end
r = ulong 0
if got
r = 1
end
ret eq r ntr sub ckcnt 1
end
note K rows: a recorded known difference between the pending C and na_cubin
fn ntk to bool
cb = new uchar 4096 0
tx = new uchar 64 0
nm = new uchar 4096 0
if ne ckcnt 7
ckbad
end
a = ckhexn 1
b = ckhexn 2
f = ckhexn 3
if or or gt a len cb gt b len tx gt f len nm
ckbad
end
for j ulong a bound 4096
put cb j uchar ckhex 1 j
end
for j ulong b bound 64
put tx j uchar ckhex 2 j
end
for j ulong f bound 4096
put nm j uchar ckhex 3 j
end
if eq ntr 4 ntr 5
ret false
end
got = ulong 0
if na_cubin part cb 0 a part nm 0 f part tx 0 b
got = 1
end
ret eq got ntr 5
end
fn crow to bool
if ne cklen 0 1
ckbad
end
k = ckch 0 0
if eq k 106
ret ntj
end
if eq k 118
ret ntv
end
if eq k 107
if ne ckcnt 2
ckbad
end
ntkeep 1 1
put nt_n 4 or get nt_n 4 1
ret true
end
if eq k 98
if ne ckcnt 2
ckbad
end
ntkeep 1 0
put nt_n 4 or get nt_n 4 2
ret true
end
if eq k 99
if ne ckcnt 3
ckbad
end
ntkeep 1 2
ntkeep 2 3
put nt_n 5 1
ret true
end
if eq k 75
ret ntk
end
if or eq k 76 eq k 77
ret ntl k
end
if not or or or or eq k 67 eq k 88 eq k 84 eq k 70 eq k 114
ckbad
end
ret ntc k
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-tspec.om: artspec (gpu/nvidia/om/apirest/tspec.om); Q is its 8 uint q words, the output its 10 words. Composed before arest.om.
text t_name "AREST-TSPEC"
text t_au "tspec"
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if or ne nq 8 ne ny 10
ckbad
end
a = new uint 8 0
for i ulong 8
if gt get q i 4294967295
ckbad
end
put a i uint get q i
end
y = new uint 10 0x5a5a5a5a
r = artspec a y
for i ulong 10
put o i ulong get y i
end
ret r
end

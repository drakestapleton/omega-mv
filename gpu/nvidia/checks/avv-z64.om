note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-z64.om: av_z64 (gpu/nvidia/om/api/attn_z64.om) against av_zero64 of CUDApp src/omega_attn_views.h;
note A is ulong; r counts the zeros among the first n; h over A. An ulong array of 4 MiB holds 524288, so no row reaches the 1000000 block edge. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-Z64"
text t_au "z64"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 500001
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new ulong 500001 0
avgl s a l
put o 0 av_z64 s n
put o 1 avhl s l
end

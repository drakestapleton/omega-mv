note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/apish-lib.om: the shared part of the apish checks, the Omega ports of CUDApp
note tests/api_shells_diff.c. A check is its units, lib.om, lib-om2.om, its port (text t_name, fn aprun) and then
note this part. The port gives every answer the old test compared to a label: as3 (the test's eq_u32: the low 32
note bits), asi (eq_i: the low 32 bits as a signed int) or as6 (eq_u64). Each label keeps the count of its answers
note and their digest in order (FNV-1a over whole words). Rows:
note   LABEL COUNT DIGEST
note The first row runs the port; then a row passes when its label has that count and that digest, which the table
note holds for the pending C's answers. The row "total" holds the count of all answers and, as DIGEST, the number of
note labels, so an answer or a label the table does not have fails too. Labels are found by a hash of their text
note in a table of 1024 places; more labels than that is refused (exit 2).
text t_total "total"
global ap_hk ulong 1024
global ap_hc ulong 1024
global ap_hd ulong 1024
note ap_hs: 0 the port has run, 1 labels, 2 answers
global ap_hs ulong 4
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn ap_ht t view uchar * to ulong
h = ulong 14695981039346656037
for i ulong len t bound 64
h = mul xor h ulong get t i 1099511628211
end
if eq h 0
h = 1
end
ret h
end
note the place of key k, or the empty place where it goes
fn ap_find k ulong to ulong
s = and k 1023
for g ulong 1024
if or eq get ap_hk s k eq get ap_hk s 0
ret s
end
s = and add s 1 1023
end
ckbad
ret 0
end
fn as6 t view uchar * v ulong to void
k = ap_ht t
s = ap_find k
if eq get ap_hk s 0
put ap_hk s k
put ap_hd s 14695981039346656037
put ap_hs 1 add get ap_hs 1 1
end
put ap_hc s add get ap_hc s 1
put ap_hd s mul xor get ap_hd s v 1099511628211
put ap_hs 2 add get ap_hs 2 1
end
fn as3 t view uchar * v ulong to void
as6 t and v 0xffffffff
end
fn asi t view uchar * v ulong to void
w = and v 0xffffffff
if ne and w 0x80000000 0
w = or w 0xffffffff00000000
end
as6 t w
end
fn crow to bool
if ne ckcnt 3
ckbad
end
if ne ckhexn 2 8
ckbad
end
if eq get ap_hs 0 0
put ap_hs 0 1
aprun
end
cnt = cknum 1
w = ulong 0
for k ulong 8
w = or shl w 8 ckhex 2 k
end
if ckis 0 t_total
ret and eq cnt get ap_hs 2 eq w get ap_hs 1
end
h = ulong 14695981039346656037
for j ulong cklen 0 bound 64
h = mul xor h ckch 0 j 1099511628211
end
if eq h 0
h = 1
end
s = ap_find h
if eq get ap_hk s 0
ret false
end
ret and eq get ap_hc s cnt eq get ap_hd s w
end

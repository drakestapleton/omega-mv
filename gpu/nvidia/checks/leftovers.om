note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/leftovers.om: replaces CUDApp tests/leftovers_test.c. Composed after
note gpu/nvidia/om/components/pathcopy.om, gpu/nvidia/om/components/leftovers.om and gpu/nvidia/checks/lib.om;
note run with gpu/nvidia/checks/leftovers.tsv, whose expected values the C oracle wrote (see that file's header).
note byte C EXPECT    leftovers 0 C 0 0 0 is EXPECT (256: not a path byte)
note path HEX CAP R OUT  the path copy the C binding of src/omega_path_check.h makes from the Omega units:
note                 cap 0 refuses; else n = pathlen (the source within cap); n = cap refuses; else pathcopy of the
note                 n + 1 bytes into cap bytes must return 1. R is 1 for a refusal; on acceptance the copied string
note                 (to its 0) is OUT. A NULL source or destination is the C binding's own refusal, not Omega's,
note                 and is not a case here.
note op OP A B C D E  leftovers OP A B C D is E
text t_name "LEFTOVERS"
text t_kbyte "byte"
text t_kpath "path"
text t_kop "op"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
note the same copy decided by the scalar stepper leftovers op 1 (src/cudapp_freest_leftovers.c's half of the
note path check): 1 when it refuses, 0 when it reaches the terminator
fn lwalk a view uchar * cap ulong to ulong
state = ulong 0
for i ulong len a bound 4096
next = leftovers 1 state ulong get a i i cap
if eq next 4
ret 1
end
if eq next 5
ret 0
end
state = next
end
ret 1
end
fn lpath to bool
if ne ckcnt 5
ret false
end
note a path case is at most 4095 bytes and its cap at most 4096 (Linux PATH_MAX); a longer case is ckbad (exit 2)
src = new uchar 4096 0
dst = new uchar 4096 85
l = ckhexn 1
cap = cknum 2
if or ge l 4096 gt cap 4096
ckbad
end
for j ulong l bound 4096
put src j uchar ckhex 1 j
end
refused = ulong 1
walked = ulong 1
if gt cap 0
n = pathlen part src 0 cap
if ne n cap
w = pathcopy part src 0 add n 1 part dst 0 cap
if eq w 1
refused = 0
end
walked = lwalk part src 0 add n 1 cap
end
end
if or ne refused cknum 3 ne walked refused
ret false
end
if eq refused 1
ret true
end
m = ckhexn 4
if ge m cap
ret false
end
for j ulong m bound 4096
if ne ulong get dst j ckhex 4 j
ret false
end
end
ret eq get dst m 0
end
fn crow to bool
if and ckis 0 t_kbyte eq ckcnt 3
ret eq leftovers 0 cknum 1 0 0 0 cknum 2
end
if ckis 0 t_kpath
ret lpath
end
if and ckis 0 t_kop eq ckcnt 7
r = leftovers cknum 1 cknum 2 cknum 3 cknum 4 cknum 5
ret eq r cknum 6
end
ckbad
ret false
end

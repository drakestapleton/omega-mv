note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-rpois.om: av_rpois (gpu/nvidia/om/api/attn_rpois.om) against av_routerpoison of CUDApp src/omega_attn_views.h;
note A is f32, B uint; r counts the first n with A equal to the f32 of the low 32 bits of v or B equal to its high 32; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-RPOIS"
text t_au "rpois"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
w = new f32 1000003 f32 0
avgf w a l
put o 0 n
put o 1 v
avop2 w b l o
end
note n and v come in o (an unsized view takes two of the six parameter slots)
fn avop2 w view f32 * b view ulong 9 l ulong o edit ulong 2 to void
ids = new uint 1000003 0
avgu ids b l
put o 0 av_rpois w ids get o 0 get o 1
put o 1 avhf w l
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-tern.om: the units over gpu/nvidia/om/apirest/terndata.om: artern, artrits, arrev,
note as data_parts() and misc_parts() of CUDApp tests/api_rest_partitions.h call them. Composed before arestg.om.
text t_name "AREST-TERN"
text t_tern "tern"
text t_trits "trits"
text t_rev "rev"
note the test's trits in turn: 0, 1, -1 (byte 255)
fn ax_tr i ulong to uchar
k = rem i 3
if eq k 2
ret 255
end
ret uchar k
end
note Q the four q words (n, 32, layout, 2); w[i] = ax_tr i; NY the output length
fn ax_tn a view ulong 4 ny ulong o edit ulong 256 to ulong
w = new uchar 544 0
for i ulong 544
put w i ax_tr i
end
y = new uint 48 0xffffffff
wn = mul get a 0 32
r = artern a part w 0 wn part y 0 ny
for i ulong 48
put o i ulong get y i
end
ret r
end
fn ax_tern q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if or or ne nq 4 gt get q 0 17 gt ny 48
ckbad
end
a = new ulong 4 0
for i ulong 4
put a i get q i
end
ret ax_tn a ny o
end
note Q n and a flag: 1 sets the last trit to 2
fn ax_trits q view ulong 256 nq ulong to ulong
n = get q 0
if or ne nq 2 gt n 33
ckbad
end
w = new uchar 33 0
for i ulong 33
put w i ax_tr i
end
if eq get q 1 1
if eq n 0
ckbad
end
put w sub n 1 2
end
ret artrits part w 0 n
end
note Q n; x[i] = (float)(i % 127); the four outputs as bit patterns
fn ax_rev q view ulong 256 nq ulong o edit ulong 256 to ulong
n = get q 0
if or ne nq 1 gt n 4
ckbad
end
x = new f32 4 0.0f32
for i ulong 4
put x i f32 rem i 127
end
y = new f32 4 7.0f32
r = arrev part x 0 n y
for i ulong 4
put o i ulong bitcast uint get y i
end
ret r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_tern
ret ax_tern q nq ny o
end
if ckis 0 t_trits
ret ax_trits q nq
end
if ckis 0 t_rev
ret ax_rev q nq o
end
ckbad
ret 0
end

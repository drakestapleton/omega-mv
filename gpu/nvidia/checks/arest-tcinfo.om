note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-tcinfo.om: artcinfo (gpu/nvidia/om/apirest/tcinfo.om); Q is its 16 q words, the output its 24 words. Composed before arest.om.
text t_name "AREST-TCINFO"
text t_au "tcinfo"
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if or ne nq 16 ne ny 24
ckbad
end
a = new ulong 16 0
for i ulong 16
put a i get q i
end
y = new uint 24 0x5a5a5a5a
r = artcinfo a y
for i ulong 24
put o i ulong get y i
end
ret r
end

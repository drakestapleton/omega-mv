note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/gate.om: OMEGA-GPU-CHECKS, the gate of the Omega checks in gpu/nvidia/checks (README.md
note there), one slice of the port of CUDApp tests/ and tools/, in seeded Omega (Linux AArch64). Build from the
note repository root (OM-2 program mode; seed/ng/sha256.om supplies sh_dat, sh_init, sh_blk, sh_out, sh_dig):
note   { printf 'om2\n'; cat seed/ng/sha256.om gpu/nvidia/checks/gate.om; } | seed/out/omc > checks-gate
note Run from the repository root: checks-gate OMC SCRATCH
note OMC      the compiler under test; its sha256 must equal the first word of seed/out/omc.sha256, or nothing
note          runs (exit 69, nothing written)
note SCRATCH  a new directory (created 0700); SCRATCH/ and a file name of Linux NAME_MAX bytes must fit Linux
note          PATH_MAX, and an existing directory is refused (both exit 2)
note Checks. gpu/nvidia/checks/checks.tsv lists every check, one per line: NAME, TABLE, then the paths of its parts,
note single spaces; # starts a comment line and an empty line is skipped. NAME is of A-Z a-z 0-9 _ , at least one
note byte and short enough that NAME and the longest suffix the gate gives it in SCRATCH fit Linux NAME_MAX, and
note appears once. The parts are concatenated in order, each followed by a newline, into SCRATCH/NAME.om; a line
note that starts with "export fn " is composed as "fn " (an exported function of a function-mode unit becomes an
note ordinary function of the check program; nothing else of the unit changes). OMC compiles it twice: each
note compile exits 0 with empty stderr and both outputs hold the same bytes. The check then runs as
note SCRATCH/NAME.1 TABLE > SCRATCH/NAME.out 2> SCRATCH/NAME.run.err and must exit 0 with empty stderr.
note Controls, each must be caught:
note   per check: TABLE with one byte changed (the last byte of its first case line: 0..8 and a..e step up by one,
note   9 and f become 0, anything else becomes 0) must make the check exit 1;
note   per row of gpu/nvidia/checks/mutants.tsv (NAME, PART, FROM, TO split by tabs; # starts a comment line, an
note   empty line is skipped): the parts of check NAME composed again with the one line of PART that equals FROM
note   (as composed, so "export fn " already reads "fn ") replaced by TO must compile (exit 0) and the check built
note   from it must exit 1 on TABLE, a source mutant the check has to notice; FROM matching no line, or more than
note   one line, of PART is a failure;
note   once: a compiler one byte longer fails the digest check.
note Inventory: every row of gpu/nvidia/checks/ports.tsv (PATH, STATUS, DETAIL split by tabs) must be the status
note and detail of PATH's row in gpu/nvidia/checks/INVENTORY.tsv, every other INVENTORY row must be open, the
note INVENTORY footer counts (files, ported, retired, blocked, open) must be its rows, and every om_ref and
note same_stem cell that is not - must name a .om file under gpu/ of this tree; a failure means INVENTORY.tsv was
note not regenerated with inventory.om after ports.tsv or the tree changed.
note Output: one line per check, control and the inventory, then
note OMEGA-GPU-CHECKS PASS|FAIL checks=N controls=C caught=K hardware=NOT_RUN, where C = 1 + the rows of checks.tsv
note + the rows of mutants.tsv.
note Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 69 compiler digest refused. Every input is length-checked; a trap
note exit (101..114) would be a defect of this gate, never a pass. Host only: no check opens a device.
text t_pin "seed/out/omc.sha256"
text t_tab "gpu/nvidia/checks/checks.tsv"
text t_om ".om"
text t_b1 ".1"
text t_b2 ".2"
text t_e1 ".1.err"
text t_e2 ".2.err"
text t_out ".out"
text t_rerr ".run.err"
text t_bad ".bad.tsv"
text t_badname "checks.tsv: name outside A-Z a-z 0-9 _"
text t_dup "checks.tsv: name repeated, or the host refused the memory"
text t_empty "checks.tsv names no check"
text t_plus "omc-plus-one"
text t_usage "usage: checks-gate OMC SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-GPU-CHECKS REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-GPU-CHECKS INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-GPU-CHECKS INVALID: SCRATCH exists or cannot be made\n"
text t_notab "OMEGA-GPU-CHECKS INVALID: cannot read gpu/nvidia/checks/checks.tsv\n"
text t_long "OMEGA-GPU-CHECKS INVALID: SCRATCH is too long: SCRATCH/ and a file name of Linux NAME_MAX bytes would not fit Linux PATH_MAX\n"
text t_ok "ok "
text t_fail "FAIL "
text t_unit "check "
text t_ctl "control "
text t_bytes " bytes="
text t_sha " sha256="
text t_exit " exit="
text t_src "source unreadable: "
text t_big "output unreadable or the host refused the memory"
text t_cmp "compile"
text t_stderr " stderr not empty"
text t_twice " two builds differ"
text t_write "cannot write the composed check in SCRATCH"
text t_row "checks.tsv: malformed row (a name that fits Linux NAME_MAX with its longest scratch suffix, a table, at least one part)"
text t_plong "checks.tsv: a path does not fit Linux PATH_MAX"
text t_run "run"
text t_rstderr "run stderr not empty"
text t_says " says: "
text t_tabbad "table unreadable, or without a case line"
text t_mut "-table-mutated"
text t_caught " caught"
text t_esc " ESCAPED"
text t_sum "OMEGA-GPU-CHECKS "
text t_pass "PASS"
text t_fl "FAIL"
text t_su " checks="
text t_sc " controls="
text t_sk " caught="
text t_hw " hardware=NOT_RUN\n"
text t_mutf "gpu/nvidia/checks/mutants.tsv"
text t_nomut "OMEGA-GPU-CHECKS INVALID: cannot read gpu/nvidia/checks/mutants.tsv\n"
text t_mo ".m"
text t_me ".m.err"
text t_msrc "-source-mutant-line-"
text t_mrow "mutants.tsv: malformed row (NAME, PART, FROM, TO split by tabs)"
text t_mnot "FROM is not a line of PART"
text t_muniq "FROM is more than one line of PART"
text t_mcmp "the mutant does not compile"
text t_ports "gpu/nvidia/checks/ports.tsv"
text t_invf "gpu/nvidia/checks/INVENTORY.tsv"
text t_invk "inventory "
text t_line " line "
text t_colon ": "
text t_invnop "cannot read gpu/nvidia/checks/ports.tsv"
text t_invnoi "cannot read gpu/nvidia/checks/INVENTORY.tsv"
text t_invrow "not PATH, STATUS, DETAIL split by tabs"
text t_invmiss "INVENTORY.tsv has no row for this path (regenerate it with inventory.om)"
text t_invdiff "INVENTORY.tsv status or detail differs from this row (regenerate it with inventory.om)"
text t_invcnt "INVENTORY.tsv: its ported, retired and blocked rows are not exactly the rows of ports.tsv, or a status is unknown"
text t_invfoot "INVENTORY.tsv: the footer counts (files, ported, retired, blocked, open) differ from its rows"
text t_invref "INVENTORY.tsv: an om_ref or same_stem cell names no .om file under gpu/ of this tree (regenerate it with inventory.om): "
text t_gpu "gpu/"
text t_sported "ported"
text t_sretired "retired"
text t_sblocked "blocked"
text t_sopen "open"
text t_hpath "path"
text t_ffiles " files="
text t_fported " ported="
text t_fretired " retired="
text t_fblocked " blocked="
text t_fopen " open="
text t_invok "ok inventory gpu/nvidia/checks/INVENTORY.tsv says what ports.tsv says"
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_nm uchar 256
note g_av: the argument list for execprog, a 2-byte count, then each argument as a 2-byte length and its bytes;
note the gate passes at most two arguments, each a path of at most len g_pa - 1 bytes (shorter than Linux
note PATH_MAX), so it holds 2 + 2 * (len g_pa + 1) bytes
global g_av uchar 8196
global g_b uchar *
global g_u uchar *
global g_o uchar 8192
global g_hx uchar 64
global g_pin uchar 64
global g_d1 uchar 32
global g_stb uchar 4
global g_n ulong 32
global g_seen uchar *
global g_tb uchar 4096
global g_m uchar *
global g_p uchar *
global g_ic ulong 16
global g_tl uchar *
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 buffer length, 7 table length, 8 checks passed, 11 failures, 12 controls, 13 caught, 14 name length,
note 15 g_seen length, 16 check rows, 17 table path length (g_tb), 19 mutants.tsv length (g_m), 20 a mutant is
note being composed, 21 it was applied (1), the host refused the memory (2) or FROM is more than one line (3), 22/23 the parts of the current check in g_u,
note 24/25 PART, 26/27 FROM, 28/29 TO of the mutant in g_m, 30 its line in mutants.tsv
note ---- output
note one output byte; g_o is written out whenever it fills, so a line of any length is printed whole
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
oflush
n = 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onm to void
for i ulong get g_n 14 bound 256
oc ulong get g_nm i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohex to void
for j ulong 32
b = get sh_dig j
oc ulong sh_hexd uint shr b 4
oc ulong sh_hexd uint and b 15
end
end
fn ohx to void
for j ulong 64
oc ulong get g_hx j
end
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
fn onl to void
oc 10
oflush
end
note a failed check: FAIL KIND NAME then the reason; counts a failure
fn ofail kind view uchar * why view uchar * to void
ot t_fail
ot kind
onm
oc 32
ot why
onl
put g_n 11 add get g_n 11 1
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pscr to void
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
end
fn pnm to void
for j ulong get g_n 14 bound 256
pc ulong get g_nm j
end
end
note scratch file NAME then suffix
fn psn suf view uchar * to void
pclr
pscr
pnm
pt suf
end
note scratch file named by a text
fn pst t view uchar * suf view uchar * to void
pclr
pscr
pt t
pt suf
end
note scratch file named by a text alone
fn psc t view uchar * to void
pclr
pscr
pt t
end
fn nmset t view uchar * to void
for i ulong len t bound 256
put g_nm i get t i
end
put g_n 14 len t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note append the file at g_pa to g_b, growing g_b to fit; false when unreadable or the host refuses the memory
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 9223372036854775807
if ge add n 1 len g_b
r = enlarge g_b add add n n 65536
if lt r 0
ok = false
break
end
end
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 9223372036854775807
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note sha256 of the file at g_pa into sh_dig, read in pieces through sh_dat so a file of any size is hashed;
note false when unreadable
fn fhash to bool
fd = frd
if lt fd 0
ret false
end
sh_init
for j ulong 8
put sh_h j get sh_k add j 64
end
k = ulong 0
tot = ulong 0
ok = true
while true bound 9223372036854775807
x = read fd sh_dat k sub len sh_dat k
if lt x 0
ok = false
break
end
if eq x 0
break
end
k = add k ulong x
tot = add tot ulong x
nb = div k 64
for b ulong nb bound 262144
sh_blk 0 mul b 64
end
o = mul nb 64
r = rem k 64
for j ulong r bound 64
put sh_dat j get sh_dat add o j
end
k = r
end
fclo fd
if not ok
ret false
end
hfin k tot
ret true
end
note finish the digest of a message of tot bytes whose last k (under 64) bytes are at the front of sh_dat:
note FIPS 180-4 padding, as sh_all of seed/ng/sha256.om does it
fn hfin k ulong tot ulong to void
for j ulong 128
put sh_pad j 0
end
for j ulong k bound 64
put sh_pad j get sh_dat j
end
put sh_pad k 128
e = ulong 64
if ge k 56
e = 128
end
bits = mul tot 8
for j ulong 8
put sh_pad sub sub e 1 j uchar and shr bits mul j 8 255
end
sh_blk 1 0
if eq e 128
sh_blk 1 64
end
sh_out
end
note the size of the file at g_pa, or 2^63 when unreadable
fn fsize to ulong
put g_n 6 0
if not bload
ret shl ulong 1 63
end
ret get g_n 6
end
note sh_dig equals the hex in g_hx
fn digeq to bool
for j ulong 32
b = get sh_dig j
if ne get g_hx mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_hx add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
fn dsave to void
for j ulong 32
put g_d1 j get sh_dig j
end
end
fn dsame to bool
for j ulong 32
if ne get g_d1 j get sh_dig j
ret false
end
end
ret true
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument; the argument list must fit g_av, else exit 2 (see the note on g_av)
fn apa to void
p = get g_n 3
n = get g_n 0
if gt add add p 2 n len g_av
exit 2
end
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
pclr
pt t
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here): the exit code, 256 + the signal, 512
note when a file could not be opened, 1000 when the child passed the 600 s deadline (killed)
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
note OMC < SCRATCH/NAME.om > SCRATCH/NAME.SUF 2> SCRATCH/NAME.ERR
fn omc suf view uchar * err view uchar * to ulong
psn t_om
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
psn suf
fo = fexe
psn err
fe = fwr
ret spawn fi fo fe
end
note ---- the compiler digest
note the first 64 characters of seed/out/omc.sha256 into g_pin; false unless lowercase hex
fn pinread to bool
pclr
pt t_pin
put g_n 6 0
if not bload
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the file at g_pa hashes to g_pin
fn pinok to bool
if not fhash
ret false
end
for j ulong 64
put g_hx j get g_pin j
end
ret digeq
end
note ---- units
note g_u[i] is c, for i below e (never reads at or past e)
fn uis i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret eq ulong get g_u i c
end
fn uisnt i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret ne ulong get g_u i c
end
note append one newline to g_b (units.sh writes one after every part)
fn nl to bool
n = get g_n 6
r = enlarge g_b add n 1
if lt r 0
ret false
end
put g_b n 10
put g_n 6 add n 1
ret true
end
note a missing or unreadable part: FAIL unit NAME source unreadable: PATH (the path is in g_pa)
fn psrcfail to void
ot t_fail
ot t_unit
onm
oc 32
ot t_src
for q ulong get g_n 0 bound 4096
oc ulong get g_pa q
end
onl
put g_n 11 add get g_n 11 1
end
text t_export "export fn "
note g_b[o, g_n 6) holds one part: drop the "export " of every line that starts "export fn ", in place
fn unexport o ulong to void
n = get g_n 6
w = o
i = o
start = true
while lt i n bound 9223372036854775807
if start
if isexp i n
i = add i 7
end
end
c = get g_b i
put g_b w c
w = add w 1
i = add i 1
start = eq c 10
end
put g_n 6 w
end
fn isexp i ulong n ulong to bool
if gt add i len t_export n
ret false
end
for j ulong len t_export
if ne get g_b add i j get t_export j
ret false
end
end
ret true
end
note compose the parts g_u[s, e) into g_b: each part's bytes (a line starting "export fn " kept as "fn "), then
note one newline; false (reported) when a part is unreadable or its path does not fit Linux PATH_MAX
fn compose s ulong e ulong to bool
put g_n 6 0
i = s
while lt i e bound 9223372036854775807
while uis i e 32 bound 9223372036854775807
i = add i 1
end
if ge i e
break
end
j = i
while uisnt j e 32 bound 9223372036854775807
j = add j 1
end
if ge sub j i len g_pa
ofail t_unit t_plong
ret false
end
pclr
for q ulong sub j i bound 4096
pc ulong get g_u add i q
end
o0 = get g_n 6
if not bload
psrcfail
ret false
end
unexport o0
if ne get g_n 20 0
if mpart
mapply o0
end
end
if not nl
ofail t_unit t_big
ret false
end
i = j
end
ret true
end
note compile the composed unit twice; true when both exit 0 with empty stderr and equal bytes
fn build to bool
psn t_om
if not bsave false
ofail t_unit t_write
ret false
end
r1 = omc t_b1 t_e1
r2 = omc t_b2 t_e2
if or ne r1 0 ne r2 0
ot t_fail
ot t_unit
onm
oc 32
ot t_cmp
ot t_exit
onum r1
oc 47
onum r2
onl
put g_n 11 add get g_n 11 1
ret false
end
psn t_e1
s1 = fsize
psn t_e2
s2 = fsize
if or ne s1 0 ne s2 0
ofail t_unit t_stderr
ret false
end
psn t_b1
if not fhash
ofail t_unit t_big
ret false
end
dsave
psn t_b2
if not fhash
ofail t_unit t_big
ret false
end
if not dsame
ofail t_unit t_twice
ret false
end
psn t_b1
sz = fsize
psn t_b1
if not fhash
ofail t_unit t_big
ret false
end
ot t_ok
ot t_unit
onm
ot t_bytes
onum sz
ot t_sha
ohex
onl
ret true
end
note Linux NAME_MAX, the longest file name a directory entry takes (getconf NAME_MAX / gives 255)
fn namemax to ulong
ret 255
end
note the larger of m and the length of t
fn lmax m ulong t view uchar * to ulong
if gt len t m
ret len t
end
ret m
end
note the longest suffix the gate puts after NAME in SCRATCH
fn sufmax to ulong
m = lmax 0 t_om
m = lmax m t_b1
m = lmax m t_b2
m = lmax m t_e1
m = lmax m t_e2
m = lmax m t_out
m = lmax m t_rerr
m = lmax m t_bad
m = lmax m t_mo
ret lmax m t_me
end
note one table row [s, e): NAME TABLE then parts; # starts a comment line; an empty line is skipped
fn urow s ulong e ulong to void
if or eq s e eq get g_u s 35
ret
end
put g_n 14 0
k = s
while uisnt k e 32 bound 9223372036854775807
k = add k 1
end
if or ge k e or eq k s gt sub k s sub namemax sufmax
ofail t_unit t_row
ret
end
for q ulong sub k s bound 256
put g_nm q get g_u add s q
end
put g_n 14 sub k s
put g_n 16 add get g_n 16 1
if not nameok
ofail t_unit t_badname
ret
end
if not nameadd
ofail t_unit t_dup
ret
end
t0 = k
while uis t0 e 32 bound 9223372036854775807
t0 = add t0 1
end
t1 = t0
while uisnt t1 e 32 bound 9223372036854775807
t1 = add t1 1
end
if or ge t1 e or eq t1 t0 ge sub t1 t0 len g_pa
ofail t_unit t_row
ret
end
for q ulong sub t1 t0 bound 4096
put g_tb q get g_u add t0 q
end
put g_n 17 sub t1 t0
put g_n 22 t1
put g_n 23 e
if not compose t1 e
ret
end
if build
runchk
end
end
note the table path into g_pa
fn ptab to void
pclr
for j ulong get g_n 17 bound 4096
pc ulong get g_tb j
end
end
note run SCRATCH/NAME.1 with the table file at g_pa (also its stdin); the exit as spawn gives it
fn runon to ulong
aclr
psn t_b1
apa
ptab
apa
fi = frd
psn t_out
fo = fwr
psn t_rerr
fe = fwr
ret spawn fi fo fe
end
note print the last line of SCRATCH/NAME.out
fn olast to void
psn t_out
put g_n 6 0
if not bload
ret
end
n = get g_n 6
note two ifs, not one and: Omega's and reads both sides, so get g_b sub n 1 would trap on an empty output

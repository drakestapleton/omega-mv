note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/apish-fp8x.om: the xf32 comparisons of CUDApp tests/api_shells_diff.c, for av_fp8x
note (gpu/nvidia/om/apiviews/fp8x.om), which the test reaches as omega_fp8_pack_x_f32. x is the test's (float)(i + 1).
note Composed before apish-lib.om.
text t_name "APISH-FP8X"
text l_xf32 "xf32"
fn aprun to void
x = new f32 32 0.0f32
for i ulong 32
put x i f32 add i 1
end
y = new f32 32 0.0f32
if ne av_fp8x part x 0 32 part y 0 32 0
ckbad
end
for i ulong 32
as3 l_xf32 ulong bitcast uint get y i
end
end

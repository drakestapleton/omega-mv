note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avv-cntf.om: av_cntf (gpu/nvidia/om/api/attn_cntf.om) against av_countf32 of CUDApp src/omega_attn_views.h;
note A is f32; r counts the first n equal (as floats: -0 = 0, NaN unequal) to the f32 of bits v; h over A. Composed before avv.om (its rows and the A, B, v, r, h they name).
text t_name "AVV-CNTF"
text t_au "cntf"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn avcap to ulong
ret 1000003
end
fn avop a view ulong 9 b view ulong 9 l ulong n ulong v ulong o edit ulong 2 to void
s = new f32 1000003 f32 0
avgf s a l
put o 0 av_cntf s n bitcast f32 uint and v 4294967295
put o 1 avhf s l
end

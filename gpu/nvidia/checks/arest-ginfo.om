note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-ginfo.om: arginfo (gpu/nvidia/om/apirest/ginfo.om); Q is its 16 q words, the output its 22 words. Composed before arest.om.
text t_name "AREST-GINFO"
text t_au "ginfo"
fn arop q view ulong 64 nq ulong ny ulong o edit ulong 128 to ulong
if or ne nq 16 ne ny 22
ckbad
end
a = new ulong 16 0
for i ulong 16
put a i get q i
end
y = new uint 22 0x5a5a5a5a
r = arginfo a y
for i ulong 22
put o i ulong get y i
end
ret r
end

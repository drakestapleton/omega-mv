note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/streams.om: the check of gpu/nvidia/om/streams/streams.om (streams_words) and
note gpu/nvidia/om/streams/xq.om (streams_xq) against the C oracle of CUDApp tests/streams_diff_test.c, as
note gpu/nvidia/checks/streams.tsv (written outside the tree by the C, see README.md, Oracles). Composed after those
note two units and lib.om (gpu/nvidia/checks/checks.tsv).
note Case 0 WM IM MODE BAR CHUNKS WORDS HASH: the chunks of the C sweep over a 4-launch list (launch i waits when bit i
note of WM is set, is independent when bit i of IM is set), assembled as the C binding emit_chunk_om assembles them:
note op 0 setup, op 1 per launch, and in inline mode (o 31 = 2) op 2 then the 96 QMD words for the second-level QMD
note (+0x200) and the QMD, then op 3. Over stamps 0..1, first_barrier_none 0..1, skip 0..4, done 0..1 in that order
note the chunk count, the word total and the FNV-1a-64 over (word count, words...) of each chunk must equal the C.
note A word count above what the C binding accepts for the op (18, 30, 3, 25) fails the case.
note Case 1 PAGE K VA CLR0 CLR1: op 5. Case 2 PRESENT LEN C0 MAX R: op 4. Case 3 I OPEN R: streams_xq.
text t_name "STREAMS"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
note sd_s: 0 pass (0 count, 1 hash), 1 chunk word count, 2 hash
global sd_s ulong 4
fn sdfnv h ulong v ulong to ulong
ret mul xor h v 1099511628211
end
fn sdw v ulong to void
if eq get sd_s 0 0
put sd_s 1 add get sd_s 1 1
else
put sd_s 2 sdfnv get sd_s 2 v
end
end
fn sdput o view ulong 32 k ulong max ulong to bool
if gt k max
ret false
end
for j ulong k bound 32
sdw get o j
end
ret true
end
note the sweep's QMD bytes: word j of the list's QMD area is j * 2654435761 mod 2^32 (1024 bytes per launch)
fn sdqmd w ulong to void
for t ulong 96 bound 96
sdw and mul add w t 2654435761 4294967295
end
end
note sd_p: the chunk being assembled: 0 WM, 1 IM, 2 mode, 3 barrier, 4 stamps, 5 first_barrier_none, 6 skip, 7 done
note (globals, so that no function needs more than six parameters or sixteen live values)
global sd_p ulong 8
note the inline header of QMD h (0 the second-level QMD at q1 + 0x200, 1 the QMD at q1) of launch i, then its words
fn sdinl i ulong h ulong to bool
a = new ulong 16 0
o = new ulong 32 0
q1 = add 20015998341120 mul i 1024
if eq h 0
put a 0 add q1 512
else
put a 0 q1
end
if not sdput o streams_words 2 a o 3
ret false
end
if eq h 0
sdqmd add mul i 256 128
else
sdqmd mul i 256
end
ret true
end
note launch i: op 1 in the call form of emit_chunk_om, then the inline QMDs when o 31 is 2
fn sdlaunch i ulong to bool
a = new ulong 16 0
o = new ulong 32 0
put a 0 i
put a 1 get sd_p 7
if ne and shr get sd_p 0 i 1 0
put a 2 add 280220846264880 mul 16 i
end
put a 3 and shr get sd_p 1 i 1
put a 4 get sd_p 6
put a 5 get sd_p 5
put a 6 get sd_p 3
put a 7 get sd_p 4
put a 8 35187254427648
put a 9 get sd_p 2
put a 10 add 20015998341120 mul i 1024
if not sdput o streams_words 1 a o 30
ret false
end
if ne get o 31 2
ret true
end
if not sdinl i 0
ret false
end
ret sdinl i 1
end
note one pass over the chunk's words; false when the generator refused or overran
fn sdpass to bool
a = new ulong 16 0
o = new ulong 32 0
if not sdput o streams_words 0 a o 18
ret false
end
done = get sd_p 7
for t ulong sub 4 done bound 4
if not sdlaunch add done t
ret false
end
end
put a 0 get sd_p 4
put a 1 35187254427648
put a 2 4
put a 3 123148505645328
ret sdput o streams_words 3 a o 25
end
fn sdchunks to bool
for f ulong 4
put sd_p f cknum add f 1
end
put sd_s 2 14695981039346656037
nc = ulong 0
nw = ulong 0
for st ulong 2
for fb ulong 2
for skip ulong 5
for done ulong 2
put sd_p 4 st
put sd_p 5 fb
put sd_p 6 skip
put sd_p 7 done
put sd_s 0 0
put sd_s 1 0
if not sdpass
ret false
end
n = get sd_s 1
put sd_s 0 1
put sd_s 2 sdfnv get sd_s 2 n
if not sdpass
ret false
end
nc = add nc 1
nw = add nw n
end
end
end
end
if ne nc cknum 5
ret false
end
if ne nw cknum 6
ret false
end
ret eq get sd_s 2 cknum 7
end
fn crow to bool
k = cknum 0
a = new ulong 16 0
o = new ulong 32 0
if eq k 0
if ne ckcnt 8
ckbad
end
ret sdchunks
end
if eq k 1
if ne ckcnt 6
ckbad
end
put a 0 cknum 1
put a 1 cknum 2
if ne streams_words 5 a o cknum 3
ret false
end
if ne get o 0 cknum 4
ret false
end
ret eq get o 1 cknum 5
end
if eq k 2
if ne ckcnt 6
ckbad
end
for j ulong 4
put a j cknum add j 1
end
ret eq streams_words 4 a o cknum 5
end
if eq k 3
if ne ckcnt 4
ckbad
end
ret eq streams_xq cknum 1 cknum 2 cknum 3
end
ckbad
ret false
end

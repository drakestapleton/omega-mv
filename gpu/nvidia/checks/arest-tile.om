note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-tile.om: the units over gpu/nvidia/om/apirest/tiledata.om: argroups, arrun, artiles,
note artile, artg, argtile, as tile_parts() and misc_parts() of CUDApp tests/api_rest_partitions.h call them.
note Composed before arestg.om.
text t_name "AREST-TILE"
text t_groups "groups"
text t_run "run"
text t_tiles "tiles"
text t_tile "tile"
text t_tg "tg"
text t_gtile "gtile"
note Q the four q words, n, n ids, n rows
fn ax_groups q view ulong 256 nq ulong to ulong
n = get q 4
if or gt n 64 ne nq add 5 mul n 2
ckbad
end
a = new ulong 4 0
for i ulong 4
put a i get q i
end
ids = new uint 64 0
rows = new uint 64 0
for i ulong n bound 64
put ids i uint get q add 5 i
put rows i uint get q add add 5 n i
end
ret argroups a part ids 0 n part rows 0 n
end
note Q i, n, n ids
fn ax_run q view ulong 256 nq ulong to ulong
n = get q 1
if or gt n 64 ne nq add 2 n
ckbad
end
ids = new uint 64 0
for i ulong n bound 64
put ids i uint get q add 2 i
end
ret arrun get q 0 part ids 0 n
end
note Q the eight q words; for tiles (m 0) three counts follow; m 1 is artile, 2 artg, 3 argtile (q edited)
fn ax_t q view ulong 256 ny ulong o edit ulong 256 m ulong to ulong
if gt ny 128
ckbad
end
a = new ulong 8 0
for i ulong 8
put a i get q i
end
cnt = new uint 3 0
if eq m 0
for i ulong 3
put cnt i uint get q add 8 i
end
end
y = new ulong 128 0
r = ulong 0
if eq m 0
r = artiles a part cnt 0 3 part y 0 ny
end
if eq m 1
r = artile a part y 0 ny
end
if eq m 2
r = artg a part y 0 ny
end
if eq m 3
r = argtile a part y 0 ny
end
for i ulong 128
put o i get y i
end
for i ulong 8
put o add 128 i get a i
end
ret r
end
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if ckis 0 t_groups
ret ax_groups q nq
end
if ckis 0 t_run
ret ax_run q nq
end
if ckis 0 t_tiles
if ne nq 11
ckbad
end
ret ax_t q ny o 0
end
if ne nq 8
ckbad
end
if ckis 0 t_tile
ret ax_t q ny o 1
end
if ckis 0 t_tg
ret ax_t q ny o 2
end
if ckis 0 t_gtile
ret ax_t q ny o 3
end
ckbad
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avrope.om: av_attnrope (gpu/nvidia/om/api/attn_math.om, through av_pow, av_log, av_exp,
note av_pow2, av_sinc, av_rrow and vc_rope) against av_ropegen of CUDApp src/omega_attn_tables.h with its pending C
note and the C host math of src/omega_gpu_hostmath.c: the ropegen calls of tests/attn_views_cases.c, the decode
note tables of the attention APIs and probes. attn_math.om carries om2, so it is the head of this check. Rows:
note   R pos theta dim width rows h
note theta is the bits of the f64. The f32 array of rows*width elements starts as the bits 0x40490fdb (so an element
note the call does not write is compared too); h is its FNV-1a digest (h = (h xor bits) * 1099511628211 from
note 1469598103934665603). The unit must answer 0. rows*width above 1000003 (the largest local f32 array, 4 MiB) is
note ckbad. The host math the R rows stand on is compared on its own, every value as f64 bits, so an error the f32
note table rounds away still shows:
note   L x log(x)     (av_log)      E y exp(y)    (av_exp)
note   P b e pow(b,e) (av_pow)      S a sin(a) cos(a) (av_sinc)
text t_name "AVROPE"
text t_r "R"
text t_l "L"
text t_e "E"
text t_p "P"
text t_s "S"
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn ckf i ulong to f64
ret bitcast f64 cknum i
end
fn arm to bool
if ckis 0 t_l
if ne ckcnt 3
ckbad
end
ret eq bitcast ulong av_log ckf 1 cknum 2
end
if ckis 0 t_e
if ne ckcnt 3
ckbad
end
ret eq bitcast ulong av_exp ckf 1 cknum 2
end
if ckis 0 t_p
if ne ckcnt 4
ckbad
end
ret eq bitcast ulong av_pow ckf 1 ckf 2 cknum 3
end
if or ne ckcnt 4 not ckis 0 t_s
ckbad
end
o = new ulong 2 0
av_sinc ckf 1 o
ret and eq get o 0 cknum 2 eq get o 1 cknum 3
end
fn crow to bool
if not ckis 0 t_r
ret arm
end
if ne ckcnt 7
ckbad
end
w = cknum 4
rows = cknum 5
if gt w 0
if gt rows div 1000003 w
ckbad
end
end
l = mul rows w
d = new f32 1000003 f32 0
for i ulong l bound 1000003
put d i bitcast f32 uint 1078530011
end
q = new ulong 16 0
put q 0 cknum 1
put q 1 cknum 2
put q 2 cknum 3
put q 3 w
put q 4 rows
rc = av_attnrope d q
if ne rc 0
ret false
end
h = ulong 1469598103934665603
for i ulong l bound 1000003
h = mul xor h ulong bitcast uint get d i 1099511628211
end
ret eq h cknum 6
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/arest-sstats.om: arsstats (gpu/nvidia/om/apirest/sstats.om), as state_parts() of CUDApp
note tests/api_rest_partitions.h calls it. Q its 8 q words and the 7 stats; the 12 outputs. Composed before
note arestg.om.
text t_name "AREST-SSTATS"
text t_sstats "sstats"
fn arop q view ulong 256 nq ulong ny ulong o edit ulong 256 to ulong
if or ne nq 15 not ckis 0 t_sstats
ckbad
end
a = new ulong 8 0
for i ulong 8
put a i get q i
end
st = new ulong 7 0
for i ulong 7
put st i get q add 8 i
end
y = new ulong 12 0x5a5a5a5a5a5a5a5a
r = arsstats a st y
for i ulong 12
put o i get y i
end
ret r
end

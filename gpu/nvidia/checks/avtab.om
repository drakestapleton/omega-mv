note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/checks/avtab.om: the table units of gpu/nvidia/om/api (av_gtab, av_range, av_total, av_best, av_max,
note av_blks, av_rfit, av_hmap, av_eff, av_reset, av_gath with av_cseg, av_fold of attn_tables.om, and av_table with
note av_touch) against the pending C bodies of CUDApp src/omega_attn_tables.h (CUDAPP_MIGRATION_PENDING_ATTN_VIEWS,
note with the pending C of api_plan): the table calls of tests/attn_views_cases.c (the fixture of
note tests/attn_views_diff.c) and sweeps around them. Each unit is called the way the C binding calls it (the same
note views, the same q words, the same chunks for av_touch). attn_om2.om carries om2, so it is the head. Rows:
note   OP A B C D Q0..Q7 X r h
note Each of A B C D is l a b m k c p1 v1 p2 v2: element i (< l) is (a*i + b) mod m, or word b+i of X (16 hex
note digits each, - when no spec uses it) when m is 0; then c when k > 0 and i mod k is 0; then v1 at i = p1 and
note v2 at i = p2; cut to the element width (uint; uchar for gath; the bits of an f32 for fold). r is the answer
note (the unit's rc for a call the C makes void, its answer cut to 32 bits where the binding cuts); h is the FNV-1a
note digest (h = (h xor e) * 1099511628211 from 1469598103934665603) of the arrays the call writes, each over its l
note elements, in the order A B C D, or of A for a call that only reads. A and B above 1000003 elements and C and
note D above 16384 are ckbad, as is a count beyond its array. The OP words:
note   gtab   lo A, hi B, tab C; n Q0, off Q1, stride Q2            av_gtab twice (which 0, 1); r ors the rcs
note   range  d A; n Q0, q0..q4 Q1..Q5                              av_range over 2n words of A
note   total  best  max  blocks  rfit: A; n Q0 and Q1.. as the C call takes them
note   hmap   d A; nqh Q0, nkv Q1, hb Q2, mutant Q3                 av_hmap over nqh words
note   eff    d A, ctx B, nb C (B when C is empty); n Q0, bs Q1     ctx copied into d, then av_eff
note   reset  slots A, ids B; nb Q0, n Q1
note   gath   s A, d B; q0..q5 Q0..Q5, sn Q6, dn Q7
note   fold   p A, out B; rows Q0, S Q1, HD Q2
note   table  ids A, tab B, slots C, touched D; q0..q4 Q0..Q4, g Q5, nb Q6
note The C binding passes some views by capacity (av_touch takes up to 1000000 ids; the bridge reads only the count
note it is given), while an Omega sized view is exactly its size: the table call fills the last touch chunk with its
note last id, which touching twice leaves unchanged.
text t_name "AVTAB"
text t_gtab "gtab"
text t_range "range"
text t_total "total"
text t_best "best"
text t_max "max"
text t_blocks "blocks"
text t_rfit "rfit"
text t_hmap "hmap"
text t_eff "eff"
text t_reset "reset"
text t_gath "gath"
text t_fold "fold"
text t_table "table"
note at_l: the l of A B C D; at_r: r, h and 1 once an OP ran
global at_l ulong 4
global at_r ulong 3
fn cname to void
for i ulong len t_name bound 64
ckoc ulong get t_name i
end
end
fn atq j ulong to ulong
ret cknum add 41 j
end
note word w of X
fn atxw w ulong to ulong
x = ulong 0
for j ulong 8
x = or shl x 8 ckhex 49 add mul w 8 j
end
ret x
end
note spec k into s; its l, which must fit cap and, for an X spec, X
fn atsp s edit ulong 10 k ulong cap ulong to ulong
for j ulong 10
put s j cknum add add 1 mul k 10 j
end
l = get s 0
if gt l cap
ckbad
end
if and eq get s 3 0 gt l 0
if lt ckhexn 49 mul add get s 2 l 8
ckbad
end
end
put at_l k l
ret l
end
fn atel s view ulong 10 i ulong to ulong
x = ulong 0
if eq get s 3 0
x = atxw add get s 2 i
else
x = rem add mul get s 1 i get s 2 get s 3
end
k = get s 4
if gt k 0
if eq rem i k 0
x = get s 5
end
end
if eq i get s 6
x = get s 7
end
if eq i get s 8
x = get s 9
end
ret x
end
fn atgu d edit uint * k ulong to void
s = new ulong 10 0
l = atsp s k len d
for i ulong l bound 1000003
put d i uint and atel s i 4294967295
end
end
fn atgc d edit uchar * k ulong to void
s = new ulong 10 0
l = atsp s k len d
for i ulong l bound 1000003
put d i uchar and atel s i 255
end
end
fn atgf d edit f32 * k ulong to void
s = new ulong 10 0
l = atsp s k len d
for i ulong l bound 1000003
put d i bitcast f32 uint and atel s i 4294967295
end
end
fn athu d view uint * l ulong h ulong to ulong
for i ulong l bound 1000003
h = mul xor h ulong get d i 1099511628211
end
ret h
end
fn athc d view uchar * l ulong h ulong to ulong
for i ulong l bound 1000003
h = mul xor h ulong get d i 1099511628211
end
ret h
end
fn athf d view f32 * l ulong h ulong to ulong
for i ulong l bound 1000003
h = mul xor h ulong bitcast uint get d i 1099511628211
end
ret h
end
note r, h, and the OP ran
fn atset r ulong h ulong to void
put at_r 0 r
put at_r 1 h
put at_r 2 1
end
fn atneed c bool to void
if not c
ckbad
end
end
fn atgtab a edit uint 1000003 b edit uint 1000003 c edit uint 16384 to void
n = atq 0
n4 = mul n 4
atneed and and le n get at_l 0 le n get at_l 1 le n4 get at_l 2
q = new ulong 16 0
put q 0 n
put q 1 atq 1
put q 2 atq 2
r0 = av_gtab part a 0 n part c 0 n4 q 0
r1 = av_gtab part b 0 n part c 0 n4 q 1
atset or r0 r1 athu c get at_l 2 1469598103934665603
end
fn atrange a edit uint 1000003 to void
n = atq 0
n2 = mul n 2
atneed le n2 get at_l 0
q = new ulong 16 0
for j ulong 5
put q j atq add j 1
end
rc = av_range q part a 0 n2 n
atset rc athu a get at_l 0 1469598103934665603
end
note total, best, max, blocks, rfit: A is read only; r is the answer's low 32 bits
fn atread a edit uint 1000003 to void
n = atq 0
atneed le n get at_l 0
q = new ulong 16 0
r = ulong 0
if ckis 0 t_total
r = av_total part a 0 n n atq 1
end
if ckis 0 t_best
r = av_best part a 0 n n atq 1
end
if ckis 0 t_max
r = av_max part a 0 n n
end
if ckis 0 t_blocks
for j ulong 5
put q add j 1 atq add j 1
end
r = av_blks part a 0 n q n
end
if ckis 0 t_rfit
put q 0 atq 1
put q 1 atq 2
r = av_rfit part a 0 n q n
end
atset and r 4294967295 athu a get at_l 0 1469598103934665603
end
fn athmap a edit uint 1000003 to void
n = atq 0
atneed le n get at_l 0
q = new ulong 16 0
for j ulong 4
put q add j 1 atq j
end
rc = av_hmap part a 0 n q
atset rc athu a get at_l 0 1469598103934665603
end
fn ateff a edit uint 1000003 b edit uint 1000003 c edit uint 16384 to void
n = atq 0
atneed and le n get at_l 0 le n get at_l 1
for i ulong n bound 1000003
put a i get b i
end
rc = ulong 0
if eq get at_l 2 0
rc = av_eff part b 0 n part a 0 n atq 1
else
atneed le n get at_l 2
rc = av_eff part c 0 n part a 0 n atq 1
end
atset rc athu a get at_l 0 1469598103934665603
end
fn atreset a edit uint 1000003 b edit uint 1000003 to void
nb = atq 0
n = atq 1
atneed and le nb get at_l 0 le n get at_l 1
rc = av_reset part a 0 nb part b 0 n n
atset rc athu a get at_l 0 1469598103934665603
end
fn atu3 a edit uint 1000003 b edit uint 1000003 to void
c = new uint 16384 0
d = new uint 16384 0
atgu a 0
atgu b 1
atgu c 2
atgu d 3
if ckis 0 t_gtab
atgtab a b c
end
if ckis 0 t_range
atrange a
end
if or or or ckis 0 t_total ckis 0 t_best ckis 0 t_max or ckis 0 t_blocks ckis 0 t_rfit
atread a
end
if ckis 0 t_hmap
athmap a
end
if ckis 0 t_eff
ateff a b c
end
if ckis 0 t_reset
atreset a b
end
end
fn atu2 a edit uint 1000003 to void
b = new uint 1000003 0
atu3 a b
end
fn atu1 to void
a = new uint 1000003 0
atu2 a
end
fn atgath to void
a = new uchar 1000003 0
b = new uchar 1000003 0
atgc a 0
atgc b 1
sn = atq 6
dn = atq 7
atneed and le sn get at_l 0 le dn get at_l 1
q = new ulong 16 0
for j ulong 6
put q j atq j
end
rc = av_gath part a 0 sn part b 0 dn q
atset rc athc b get at_l 1 1469598103934665603
end
fn atfold2 a edit f32 1000003 to void
b = new f32 1000003 f32 0
atgf b 1
q = new ulong 16 0
for j ulong 3
put q j atq j
end
pn = mul mul atq 0 atq 1 add atq 2 2
on = mul atq 0 atq 2
atneed and le pn get at_l 0 le on get at_l 1
rc = av_fold part a 0 pn part b 0 on q
atset rc athf b get at_l 1 1469598103934665603
end
fn atfold to void
a = new f32 1000003 f32 0
atgf a 0
atfold2 a
end
note av_touch over ids start..start+cnt of A, the last id repeated to fill the view
fn attouch c edit uint 16384 d edit uint 16384 start ulong cnt ulong to void
t = new uint 1000000 0
s = new ulong 10 0
l0 = atsp s 0 1000003
for i ulong 1000000
j = add start sub cnt 1
if lt i cnt
j = add start i
end
put t i uint and atel s j 4294967295
end
nb = atq 6
rc = av_touch t part c 0 nb part d 0 nb atq 5
end
note ids fit A, the row fits B, the last write lands in B, nb fits C and D
fn attabok la ulong to void
atneed and le atq 0 la le add atq 2 atq 0 get at_l 1
atneed and lt atq 3 get at_l 1 and le atq 6 get at_l 2 le atq 6 get at_l 3
end
note the touch chunks of the C binding: at most 1000000 ids each, none when there are no ids
fn attouchs c edit uint 16384 d edit uint 16384 to void
n = atq 0
for bb ulong add div n 1000000 1
st = mul bb 1000000
cnt = sub n st
if gt cnt 1000000
cnt = ulong 1000000
end
if gt cnt 0
attouch c d st cnt
end
end
end
fn attab2 b edit uint 1000003 to void
c = new uint 16384 0
d = new uint 16384 0
s = new ulong 10 0
atgu b 1
atgu c 2
atgu d 3
la = atsp s 0 1000003
n = atq 0
off = atq 2
attabok la
for i ulong n bound 1000003
put b add off i uint and atel s i 4294967295
end
q = new ulong 16 0
for j ulong 5
put q j atq j
end
r = av_table part b off n part c 0 atq 6 q atq 5
if and ne atq 1 0 ne atq 1 2
attouchs c d
end
put b atq 3 uint atq 4
h = athu b get at_l 1 1469598103934665603
h = athu c get at_l 2 h
atset and r 4294967295 athu d get at_l 3 h
end
fn attab to void
b = new uint 1000003 0
attab2 b
end
fn crow to bool
if ne ckcnt 52
ckbad
end
put at_r 2 0
if ckis 0 t_gath
atgath
else
if ckis 0 t_fold
atfold
else
if ckis 0 t_table
attab
else
atu1
end
end
end
if eq get at_r 2 0
ckbad
end
if ne get at_r 0 cknum 50
ret false
end
ret eq get at_r 1 cknum 51
end

note SPDX-License-Identifier: Apache-2.0
note gpu/nvidia/om/spiral/spiral_test.om: Unified pure seeded-OM-2 host verification &
note negative-control mutant suite for the L2-Pinned Reversible Looped Spiral GPU stack.
note Compose after si/directives/om2.om and:
note   gpu/nvidia/om/encoder/bw_enc_sm121_v2.om
note   gpu/nvidia/om/encoder/nvfp4_numerics.om
note   gpu/nvidia/om/qmd/l2_policy.om
note   gpu/nvidia/om/spiral/l2_budget.om
note   gpu/nvidia/om/blas/gemm_128x128_bf16.om
note   gpu/nvidia/om/blas/gemm_128x128_nvfp4.om
note   gpu/nvidia/om/blas/gemm_128x128_oracle.om
note   gpu/nvidia/om/dnn/fa2_hmma_train.om
note   gpu/nvidia/om/dnn/fused_norm_mlp.om
note   gpu/nvidia/om/spiral/spiral_train.om
note Host/emulator verification only; GB10 silicon qualification stays hardware=NOT_RUN.

text st_pass "OMEGA-GPU-SPIRAL-TEST PASS checks="
text st_fail "OMEGA-GPU-SPIRAL-TEST FAIL checks="
text st_mut " mutants_caught="
text st_hw " hardware=NOT_RUN\n"
text st_err "FAIL check="
text st_nl "\n"

global st_cnt ulong 4
note st_cnt: 0=checks_ok, 1=checks_fail, 2=mutants_total, 3=mutants_caught
global st_out uchar 256
global st_len ulong 1

fn st_pc c ulong to void
n = get st_len 0
if lt n 256
put st_out n uchar c
put st_len 0 add n 1
end
end

fn st_pt t view uchar * to void
for i ulong len t bound 256
st_pc ulong get t i
end
end

fn st_pnum v ulong to void
if ge v 10
st_pnum div v 10
end
st_pc add 48 rem v 10
end

fn st_flush to void
n = get st_len 0
if gt n 0
r = write 1 st_out 0 n
put st_len 0 0
end
end

fn st_chk ok bool id ulong to void
if ok
put st_cnt 0 add get st_cnt 0 1
ret
end
put st_cnt 1 add get st_cnt 1 1
st_pt st_err
st_pnum id
st_pt st_nl
st_flush
end

fn st_mut_chk caught bool id ulong to void
put st_cnt 2 add get st_cnt 2 1
if caught
put st_cnt 3 add get st_cnt 3 1
put st_cnt 0 add get st_cnt 0 1
ret
end
put st_cnt 1 add get st_cnt 1 1
st_pt st_err
st_pnum id
st_pt st_nl
st_flush
end

note ---- Suite 1: SM121 v2 Encoder, BLAS, DNN/FA2, Fused Norm+MLP & Mutants M3/M4 ----

fn st_suite_sass to void
note 1a. 128x128 BF16 training GEMM (FWD, DX, DW + epilogues) + Split-K tree reduce
b = blas_emit_bf16_128x128 0 BLAS_MODE_FWD BLAS_EPI_BF16_OUT
st_chk and gt b 0 eq v2_audit_slot 0 1 0 101
st_chk and ge get v2_aud 5 16 eq get v2_aud 6 0 102
b = blas_emit_bf16_128x128 1 BLAS_MODE_DW BLAS_EPI_NONE
st_chk and gt b 0 eq v2_audit_slot 1 1 0 103
b = blas_emit_splitk_reduce 2
st_chk and gt b 0 eq v2_audit_slot 2 1 0 104

note 1b. 128x128 NVFP4 OMMA.SF.16864 training GEMM (FWD, DX, DW w/ RHT16+SR) + 1.58b Ternary
b = blas_emit_nvfp4_128x128 3 BLAS_MODE_FWD BLAS_EPI_BF16_OUT
st_chk and gt b 0 eq v2_audit_slot 3 1 0 105
st_chk and ge get v2_aud 4 16 eq get v2_aud 6 0 106
b = blas_emit_nvfp4_128x128 4 BLAS_MODE_DW BLAS_EPI_NONE
st_chk and gt b 0 eq v2_audit_slot 4 1 0 107
b = blas_emit_ternary_l2_128 5
st_chk and gt b 0 eq v2_audit_slot 5 1 0 108

note 1c. HMMA.16816 Flash-Attention-2 fwd+bwd+dq_reduce across hd=32/64/128 (zero opa)
b = dnn_emit_fa2_fwd 6 32
st_chk and gt b 0 eq v2_audit_slot 6 1 0 109
st_chk and ge get v2_aud 5 12 eq get v2_aud 6 0 110
b = dnn_emit_fa2_bwd 7 32
st_chk and gt b 0 eq v2_audit_slot 7 1 0 111
st_chk and ge get v2_aud 5 16 eq get v2_aud 6 0 112
b = dnn_emit_fa2_dq_reduce 8 64
st_chk and gt b 0 eq v2_audit_slot 8 0 0 113
st_chk eq dnn_emit_fa2_fwd 9 48 0 114

note 1d. Fused RMSNorm+QKV, MLP+Reversible Residual (Lock 4 Q32), Rev Bwd, 2D 16x16 Quant
b = dnn_emit_rmsnorm_qkv 9 1
st_chk and gt b 0 eq v2_audit_slot 9 1 0 115
st_chk ge get v2_aud 4 4 116
b = dnn_emit_mlp_rev_fwd 10 1 1
st_chk and gt b 0 eq v2_audit_slot 10 1 0 117
b = dnn_emit_rev_bwd_step 11 1 1
st_chk and gt b 0 eq v2_audit_slot 11 1 0 118
b = nv4_emit_quant_2d_16x16 12
st_chk and gt b 0 eq v2_audit_slot 12 0 0 119

note 1e. Negative-Control Mutant M3: strip .EL hints -> audit MUST catch bit 4 (16)
b = v2_mutant_strip_el 3
a3 = v2_audit_slot 3 1
st_mut_chk and gt b 0 ne and a3 16 0 191

note 1f. Negative-Control Mutant M4: inject ATOMG.E.ADD.F32 -> audit MUST catch bit 2 (4)
v2_mutant_inject_fp_atomic 4 4
a3 = v2_audit_slot 4 1
st_mut_chk ne and a3 4 0 192
end

note ---- Suite 2: L2 Persistence Policy, QMD V05_00 & Zero-Flush Pushbuffer ----

fn st_suite_l2_policy to void
st_chk eq l2p_set_window 4294967296 18874368 1000 0 201
st_chk ne l2p_set_window 4294967296 25165824 1000 0 202
st_chk eq l2p_rm_set_ways 12 0 203
st_chk ne l2p_rm_set_ways 15 0 204
st_chk eq l2p_build_qmd 8589934592 256 128 32768 8 4 0 205
st_chk ne l2p_build_qmd 8589934592 256 136 32768 8 4 0 206
l2p_pb_begin
for i ulong 8
st_chk eq l2p_pb_chain_qmd add 12884901888 mul i 512 add 17179869184 mul i 16 add i 1 0 207
end
st_chk eq l2p_pb_macro_tail 21474836480 0 208
st_chk eq l2p_pb_audit 0 209
st_chk and eq get l2p_aud 1 8 and eq get l2p_aud 2 1 eq get l2p_aud 3 0 210
note Negative control: extra L2_FLUSH_DIRTY mid-batch MUST fail pushbuffer audit
r = l2p_pb_macro_tail 21474836480
st_mut_chk ne l2p_pb_audit 0 291
end

note ---- Suite 3: 24 MiB L2 Working-Set Budget Planner (15.83M & Spiral Core) ----

fn st_set_l2_cfg v ulong t ulong d ulong h ulong f ulong l ulong to void
put l2b_cfg 0 v
put l2b_cfg 1 t
put l2b_cfg 2 d
put l2b_cfg 3 h
put l2b_cfg 4 f
put l2b_cfg 5 l
end

fn st_suite_l2_budget to void
note 3a. 15.83M v2 NVFP4 reversible active spiral core L2 pin (LC=4, NP=4, B_mb=4 -> R_mb=1024)
st_set_l2_cfg 4096 256 384 12 1536 8
put l2b_cfg 6 2
put l2b_cfg 7 4
put l2b_cfg 8 4
put l2b_cfg 9 4
put l2b_cfg 10 16
put l2b_cfg 11 SP_FMT_NVFP4
put l2b_cfg 12 1
put l2b_cfg 13 1
rc = l2b_plan
st_chk and eq rc 0 eq get l2b_out 1 15833472 301
st_chk le get l2b_out 10 SP_L2_HARD_CAP 302
st_chk gt get l2b_out 12 0 303

note 3b. 15.83M v2 BF16 reversible active spiral core L2 pin (LC=2, NP=4) -> fits <= 22 MiB w/ grads
put l2b_cfg 7 2
put l2b_cfg 11 SP_FMT_BF16
put l2b_cfg 13 1
st_chk eq l2b_plan 0 304

note 3c. Ternary 1.58-bit reversible spiral core (D=768, F=2304, L=4, LC=2, NP=4) -> fits <= 22 MiB w/ grads
st_set_l2_cfg 4096 256 768 12 2304 4
put l2b_cfg 6 1
put l2b_cfg 7 2
put l2b_cfg 8 4
put l2b_cfg 9 2
put l2b_cfg 10 32
put l2b_cfg 11 SP_FMT_TERNARY
put l2b_cfg 12 1
put l2b_cfg 13 1
st_chk eq l2b_plan 0 305

note 3d. Negative control: non-reversible full-batch B_mb=64 BF16 MUST fail closed (status=2 OVER_L2_CAP)
st_set_l2_cfg 4096 256 384 12 1536 8
put l2b_cfg 6 2
put l2b_cfg 7 4
put l2b_cfg 8 4
put l2b_cfg 9 64
put l2b_cfg 10 1
put l2b_cfg 11 SP_FMT_BF16
put l2b_cfg 12 0
put l2b_cfg 13 0
st_mut_chk eq l2b_plan 2 391
end

note ---- Suite 4: NVFP4 Numerics & BLAS CPU Reference Oracles ----

fn st_suite_oracles to void
note 4a. Random123 Philox4x32-10 exact test vector (ctr=0, key=0 -> 0x6627e8d5)
st_chk eq nv4_ref_philox_u32 0 0 1713891541 401

note 4b. RHT16 exact involution (H * H * x == x to < 1e-12)
a = new f64 16 0.0
b = new f64 16 0.0
c = new f64 16 0.0
for i ulong 16
put a i sub mul f64 i 0.375f64 2.5f64
end
nv4_ref_rht16 a edit b 43690
nv4_ref_rht16 b edit c 43690
mx = 0.0f64
for i ulong 16
d = fabs sub get c i get a i
mx = fmax mx d
end
st_chk lt mx 1.0e-12f64 402

note 4c. 243/243 exact 5-trit/byte ternary pack/unpack bijection
ok_t = true
for p ulong 243
t0 = blas_ref_ternary_unpack5 p 0
t1 = blas_ref_ternary_unpack5 p 1
t2 = blas_ref_ternary_unpack5 p 2
t3 = blas_ref_ternary_unpack5 p 3
t4 = blas_ref_ternary_unpack5 p 4
if ne blas_ref_ternary_pack5 t0 t1 t2 t3 t4 p
ok_t = false
end
end
st_chk ok_t 403

note 4d. Deterministic split-K reduction check (S=1 vs S=2 vs S=4 < 1e-12)
ma = new f64 256 0.0
mb = new f64 256 0.0
for i ulong 64
put ma i mul f64 add i 1 0.03125f64
put mb i sub mul f64 add i 1 0.015625f64 0.5f64
end
sk_err = blas_ref_splitk_check ma mb 8 8 8
st_chk lt sk_err 1.0e-12f64 404
end

note ---- Suite 5: Reversible Looped Spiral Core, Lock 4 Q32, Twin & Mutants M1/M2 ----

fn st_suite_spiral to void
p = sp_init_default 42
st_chk eq p 8592 501

note 5a. Lock 4: exact 0-bit Q32 reversible invertibility across LV=10 (NP=4) spiral passes
qdiff = sp_q32_inv_test
st_chk and eq qdiff 0 gt get sp_stat 0 0 502

note 5b. Zero-spill reversible spiral fwd+bwd vs independent unrolled f64 twin (G=4 microbatches)
sp_clear_mut
l_rev = sp_rev_macro_grad
l_twn = sp_twin_macro_grad
st_chk lt fabs sub l_rev l_twn 1.0e-12f64 503
rerr = sp_grad_rel_err
st_chk lt rerr 1.0e-11f64 504

note 5c. BF16 RNE (>= 0.999) and NVFP4 2D-16x16 + RHT16 + Philox SR (>= 0.98) gradient cosine
c_bf16 = sp_quant_grad_cos 0
c_nv4 = sp_quant_grad_cos 1
st_chk ge c_bf16 0.999f64 505
st_chk ge c_nv4 0.98f64 506

note 5d. Negative-Control Mutant M1: skip final microbatch grad -> rel_err MUST jump > 0.05
sp_set_mut 0 1
l_m1 = sp_rev_macro_grad
st_mut_chk gt sp_grad_rel_err 0.05f64 591
sp_clear_mut

note 5e. Negative-Control Mutant M2: flip FA2 backward D_i sign -> rel_err MUST jump > 1e-4
sp_set_mut 1 1
l_m2 = sp_rev_macro_grad
st_mut_chk gt sp_grad_rel_err 1.0e-4f64 592
sp_clear_mut
end

fn main to int
st_suite_sass
st_suite_l2_policy
st_suite_l2_budget
st_suite_oracles
st_suite_spiral
fl = get st_cnt 1
if eq fl 0
st_pt st_pass
else
st_pt st_fail
end
st_pnum get st_cnt 0
st_pt st_mut
st_pnum get st_cnt 3
st_pt st_hw
st_flush
if ne fl 0
ret 1
end
if ne get st_cnt 2 get st_cnt 3
ret 1
end
ret 0
end

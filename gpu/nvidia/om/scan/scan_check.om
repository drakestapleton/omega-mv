om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note op 0 poison count; op 1 modular prefix differences; op 2 sorted adjacent keys.
fn sc_part w view uint * x view uint * q edit ulong 4 to ulong
for z ulong get q 2
i = add get q 1 z
if eq get q 0 0
if eq get w i 2141195181
put q 3 add get q 3 1
end
else
if eq get q 0 1
v = get w i
if gt i 0
v = sub v get w sub i 1
end
if ne v get x i
put q 3 add get q 3 1
end
else
if gt i 0
if lt get w i get w sub i 1
put q 3 add get q 3 1
end
end
end
end
end
ret 0
end
fn sc_check w view uint * x view uint * op uint to ulong
q = new ulong 4 0
put q 0 ulong op
for blk ulong add div len w 1000000 1
put q 1 mul blk 1000000
put q 2 sub len w get q 1
if gt get q 2 1000000
put q 2 1000000
end
rc = sc_part w x q
if ne rc 0
ret rc
end
end
ret get q 3
end

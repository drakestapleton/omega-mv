note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note admit.om: the admission and layout decisions of src/omega_gpu_gdn_api.c in seeded Omega.
note Entry gdn_admit op a b c o: result 0 admitted, 1 refused (OMEGA_GPU_GDN_BAD_ARGS / shape -1).
note op 1 SHAPE a=ratio b=state_bf16: o[0..9] = r vh conv vdim par_scal par_norm par_bytes tail state post_y.
note op 2 ALLOC a=layers b=ratio c=state_bf16: 1 <= layers <= 64, then SHAPE.
note op 3 LAYER a=layer b=layers: layer < layers.
note op 4 FINITE a=eps_l2|eps_norm<<32 b=in_scale|out_scale<<32 (f32 bits): all four finite.
note op 5 MULTI a=layer b=layers c=tokens, o[0..6] = qkv z ab out xstride abstride ostride.
note op 6 TOKENS a=T: OMEGA_GDN_PF_MIN_T 3 <= T <= OMEGA_GPU_GDN_PF_MAX_T 65536.
note op 7 PFLAYOUT a=T b=ratio: o[0..5] the six section offsets, o[6] the total bytes.
note op 8 MOVE a=kind b=bytes c=dst: kind 4 COPY or 5 ZERO, dst nonzero, bytes a nonzero multiple of 4096 with
note bytes/4096 <= 0x7fffffff; o[0] = the grid.
const MASK32 ulong 4294967295
fn shape r ulong bf ulong o edit ulong 16 to ulong
if eq r 0
r = ulong 3
end
if or lt r 1 gt r 3
ret 1
end
vh = mul r 16
vdim = mul vh 128
conv = add 4096 vdim
put o 0 r
put o 1 vh
put o 2 conv
put o 3 vdim
put o 4 mul conv 16
put o 5 add mul conv 16 mul vh 8
put o 6 add add mul conv 16 mul vh 8 512
put o 7 mul vh 6144
st = mul vh 65536
if ne bf 0
st = mul vh 32768
end
put o 8 st
put o 9 div vh 8
ret 0
end
fn fin32 x ulong to ulong
if eq and shr x 23 255 255
ret 1
end
ret 0
end
fn finite a ulong b ulong to ulong
if ne fin32 and a MASK32 0
ret 1
end
if ne fin32 shr a 32 0
ret 1
end
if ne fin32 and b MASK32 0
ret 1
end
if ne fin32 shr b 32 0
ret 1
end
ret 0
end
fn multi a ulong b ulong c ulong o edit ulong 16 to ulong
if ge a b
ret 1
end
if eq c 0
ret 1
end
if eq get o 0 0
ret 1
end
if eq get o 1 0
ret 1
end
if eq get o 2 0
ret 1
end
if eq get o 3 0
ret 1
end
m16 = or get o 0 get o 1
m16 = or m16 get o 3
m16 = or m16 get o 4
m16 = or m16 get o 6
if ne and m16 15 0
ret 1
end
if ne and or get o 2 get o 5 7 0
ret 1
end
ret 0
end
fn r256 x ulong to ulong
ret shl shr add x 255 8 8
end
fn layout t ulong r ulong o edit ulong 16 to ulong
if gt t 65536
ret 1
end
sh = new ulong 16 0
if ne shape r 0 sh 0
ret 1
end
vh = get sh 1
conv = get sh 2
vdim = get sh 3
t8 = mul div add t 7 8 8
at = ulong 0
put o 0 at
at = add at r256 mul mul t conv 4
put o 1 at
at = add at r256 mul mul t vdim 4
put o 2 at
at = add at r256 mul mul t vh 8
put o 3 at
at = add at r256 mul mul t vdim 4
put o 4 at
at = add at r256 mul mul t vdim 4
put o 5 at
at = add at r256 mul mul t8 vh 1552
put o 6 at
ret 0
end
fn move k ulong by ulong dst ulong o edit ulong 16 to ulong
if and ne k 4 ne k 5
ret 1
end
if eq dst 0
ret 1
end
if eq by 0
ret 1
end
if ne rem by 4096 0
ret 1
end
if gt div by 4096 2147483647
ret 1
end
put o 0 div by 4096
ret 0
end
fn gdn_admit op ulong a ulong b ulong c ulong o edit ulong 16 to ulong
if eq op 1
ret shape a b o
end
if eq op 2
if or eq a 0 gt a 64
ret 1
end
ret shape b c o
end
if eq op 3
if ge a b
ret 1
end
ret 0
end
if eq op 4
ret finite a b
end
if eq op 5
ret multi a b c o
end
if eq op 6
if or lt a 3 gt a 65536
ret 1
end
ret 0
end
if eq op 7
ret layout a b o
end
if eq op 8
ret move a b c o
end
ret 1
end

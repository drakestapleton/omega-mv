note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Private command-list memo. Zero-initialized cache is owned by the caller under the session lock.
note No authority is cached: exact normalized bytes must match before their prior SHA256 is reused.
note Cache0 valid,1 argument count,32..63 digest,64..1855 normalized image. Other cells unused.
note Ownership, epoch, revision, admission, and submit-time intent checks still run separately.
fn native_mcreseal bank view uchar 1024 qmd view uchar 1024 n ulong cache edit uchar 2048 out edit uchar 32 to long
mc_clear edit out
if or eq n 0 gt n 32
ret -1
end
b = new uchar 16384 0
off = add ulong 896 mul n 4
for i ulong off
put b i get bank i
end
for i ulong 384
v = get qmd i
if or and ge i 40 lt i 44 and ge i 48 lt i 52
v = 0
end
put b add off i v
end
off = add off 384
for i ulong 384
put b add off i get qmd add 512 i
end
size = add off 384
same = and eq get cache 0 1 eq ulong get cache 1 n
for i ulong size
if ne get b i get cache add 64 i
same = false
end
end
if same
for i ulong 32
put out i get cache add 32 i
end
ret 0
end
put cache 0 0
if ne kc_codesha b size edit out 0
mc_clear edit out
ret -1
end
for i ulong size
put cache add 64 i get b i
end
for i ulong 32
put cache add 32 i get out i
end
put cache 1 uchar n
put cache 0 1
ret 0
end

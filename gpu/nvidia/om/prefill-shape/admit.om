note Exact maximum store immediate of the existing qgemm epilogue.
note F32 has additional column offsets up to 36 bytes; packed SwiGLU has none.
fn qg_offset n ulong rt ulong epi ulong to ulong
if or eq n 0 gt n 4294967295
ret 0
end
if or lt rt 1 gt rt 8
ret 0
end
if gt epi 1
ret 0
end
stride = n
if eq epi 0
stride = mul n 4
end
last = mul sub mul rt 16 8 stride
if eq epi 0
last = add last 36
end
if le last 8388607
ret 1
end
ret 0
end


note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Retain the incumbent 64-row shape and admit one paired-scale 32-row shape.
note Keep prior shapes and admit only one extended-register 128-row candidate.
fn native_qgshape rt ulong warps ulong n ulong epi ulong to ulong
ok = qg_offset n rt epi
if eq ok 0
ret 0
end
if and eq rt 4 eq warps 8
ret 1
end
if and eq rt 2 eq warps 4
ret 1
end
if and eq rt 4 eq warps 16
ret 1
end
if and eq rt 8 eq warps 8
ret 1
end
ret 0
end

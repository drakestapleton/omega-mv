note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Grouped work order: adjacent column jobs reuse one weight panel across row tiles.
note Private plan: grid x, grid y, record count, then records of opcode,dst,src1,src2,immediate.
note Registers 0=cx,1=cy,2=temporary,3=tile count. Opcodes are private adapter operations.
fn qgo_put plan edit ulong 64 at ulong op ulong regs ulong imm ulong to ulong
put plan at op
put plan add at 1 rem regs 4
put plan add at 2 rem div regs 4 4
put plan add at 3 div regs 16
put plan add at 4 imm
ret add at 5
end

fn qgo_emit plan edit ulong 64 group ulong guard ulong to ulong
size = shl ulong 1 group
at = qgo_put plan 3 1 2 sub size 1
at = qgo_put plan at 2 0 group
at = qgo_put plan at 3 37 size
if eq guard 1
note Tile count is constant-bank argument word11, byte896+44=940.
at = qgo_put plan at 4 3 940
at = qgo_put plan at 5 52 0
at = qgo_put plan at 6 0 0
end
put plan 2 div sub at 3 5
ret 1
end

fn native_qgorder plan edit ulong 64 group ulong cols ulong tiles ulong guard ulong to ulong
put plan 0 0
put plan 1 0
put plan 2 0
if or gt group 5 gt guard 1
ret 0
end
if or eq cols 0 gt cols 65535
ret 0
end
if or eq tiles 0 gt tiles 65535
ret 0
end
size = shl ulong 1 group
gx = mul cols size
if gt gx 65535
ret 0
end
put plan 0 gx
put plan 1 div add tiles sub size 1 size
if eq group 0
ret 1
end
ret qgo_emit plan group guard
end

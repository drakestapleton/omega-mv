note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Reuse only when every existing row, padded-row and tile capacity covers the request.
note Rows and height are bounded before the ceiling division, so sums cannot overflow ulong.
fn native_qgworkspace capacity ulong padded ulong tiles ulong rows ulong bm ulong to ulong
if or eq rows 0 gt rows 4294967295
ret 0
end
if or eq bm 0 gt bm 4294967295
ret 0
end
if gt rows capacity
ret 0
end
if gt add rows bm padded
ret 0
end
needed = add div add rows sub bm 1 bm 1
if gt needed tiles
ret 0
end
ret 1
end

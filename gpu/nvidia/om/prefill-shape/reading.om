note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Reading profile proposal: avoid a second 64-row group for a short request.
note Options are rt, warps, wait, group. Invalid input returns the u32 sentinel.
fn native_qgreading rows ulong index ulong to ulong
if or eq rows 0 gt rows 4294967295
ret 4294967295
end
if gt index 3
ret 4294967295
end
if eq index 0
if le rows 64
ret 4
end
ret 8
end
if eq index 1
ret 8
end
if eq index 2
ret 45
end
if le rows 64
ret 0
end
ret 4
end

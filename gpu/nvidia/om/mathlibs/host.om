if eq k 4294967295
ret 1
end
lgs = or lgs shl k mul i 4
sum = add sum k
end
else
if or gt mode 2 or ne rank 1 ne get p 3 0
ret 1
end
sum = mh_lg get p 4 8 4096
if eq sum 4294967295
ret 1
end
lgs = sum
end
if gt sum 27
ret 2
end
elems = shl get p 2 sum
if gt elems 134217728
ret 2
end
put o 0 lgs
put o 4 or mode shl rank 4

fn mh_lg n ulong lo ulong hi ulong to ulong
if or lt n lo or gt n hi ne and n sub n 1 0
ret 4294967295
end
k = ulong 0
while lt shl ulong 1 k n bound 32
k = add k 1
end
ret k
end
fn mh_chunk total ulong first ulong width ulong outw ulong q ulong to ulong
ctas = div add total sub width 1 width
grid = mh_min sub ctas first 1024
if eq q 0
ret grid
end
if eq q 1
ret mul first width
end
ret mul outw mh_min mul grid width sub total mul first width
end
fn mh_fill old ulong idx ulong to ulong
bit = shl ulong 1 and idx 7
if ne and old bit 0
ret add old 256
end
ret or old bit
end
fn mh_poison a ulong b ulong wide ulong dual ulong to ulong
if ne dual 0
ret mh_bit and eq a 4290436013 eq b 12245933
end
if ne wide 0
ret mh_bit eq a 18427282365706066861
end
ret mh_bit eq a 4290436013
end

note Layout entries are base, batch stride, and three axis strides.
fn mh_index l view ulong 8 e view ulong 4 rank ulong idx ulong to ulong
v = get l 0
x = idx
i = rank
while gt i 0 bound 3
i = sub i 1
v = add v mul rem x get e i get l add i 2
x = div x get e i
end
ret and add v mul x get l 1 4294967295
end

note Legacy walk admission: p mode, rank, batch, inverse, dims[3]. o rc,lgs,bytes[3].
fn mh_walk p view ulong 8 o edit ulong 8 to ulong

put o 6 mul mul cursor so 8
put o 7 div n 4
put o 8 mh_min sub rows cursor 1024
put o 9 0
if eq get o 0 1
put o 9 mul n 8
end
put o 12 n
put o 13 get o 2
put o 14 mul mul so 2 get o 8
put o 15 rows
ret 0
end
note One decoded legacy step; q is a row/CTA cursor, o matches private launch fields.
fn mh_walkstep step ulong batch ulong cursor ulong o edit ulong 16 to ulong
for i ulong 5
put o i and shr step mul i 8 255
end
kind = get o 0
a = get o 1
b = get o 2
if or gt get o 3 2 gt get o 4 2
ret 3
end
rows = shl batch and shr step 40 255
if or eq kind 1 eq kind 4
ret mh_walkfft o cursor rows
end
if eq kind 5
total = shl rows add a b
put o 7 256
put o 8 mh_chunk total cursor 256 2 0
put o 10 total
put o 11 mul cursor 256
put o 14 mh_chunk total cursor 256 2 2
put o 15 div add total 255 256
ret 0
end
ret 3
end


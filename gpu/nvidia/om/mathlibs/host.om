if eq mode 1
put o 1 mul elems 4
put o 2 mul mul half 8 get p 2
put o 3 mul elems 4
end
if eq mode 2
put o 1 mul mul half 8 get p 2
put o 2 mul elems 4
put o 3 mul elems 4
end
ret 0
end
fn mh_walkfft o edit ulong 16 cursor ulong rows ulong to ulong

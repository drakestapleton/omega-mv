note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note op ids are private to the effect adapter; all arithmetic remains in host.om.
fn native_mhval op ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq op 0
ret mh_time a b
end
if eq op 1
ret mh_sub a b
end
if eq op 2
ret mh_mul a b
end
if eq op 3
ret mh_add a b
end
if eq op 4
ret mh_min a b
end
if eq op 5
ret mh_overlap a b c d
end
if eq op 6
ret mh_rng a b c d
end
if eq op 7
ret mh_rngval a b c d
end
if eq op 8
ret mh_seed a b c
end
if eq op 9
ret mh_phil a b c d e
end
if eq op 10
ret mh_lg a b c
end
if eq op 11
ret mh_chunk a b c d e
end
if eq op 12
ret mh_fill a b
end
if eq op 13
ret mh_poison a b c d
end
if eq op 14
ret mh_div a b
end
if eq op 15
ret mh_basic a b c d
end
ret 4294967295
end

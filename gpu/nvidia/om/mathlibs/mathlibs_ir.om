note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note mathlibs_ir.om: CUDA++ math-library kernels for the GB10 (sm_121), emitted as BlackwellIR records.
note kind 0: xoshiro256** random numbers (variant 0 raw 64-bit, 1 uniform f32, 2 normal f32).
note kind 1: batched complex f32 Stockham FFT, n = 2^a (4..2048), radix 4 plus one radix-2 stage when a is odd.
note kind 2: the FFT twiddle table w^m, m < n, n = 2^a (4..4096), as f32 pairs (re bits | im bits << 32), in f64.
note kind 3: Philox4x32-10 counter-based random numbers, the stream of cuRAND's curandStatePhilox4_32_10_t.
note kind 4: real-FFT split (R2C, after an N/2-point complex FFT) or merge (C2R, before it), N = 2^a (8..4096).
note kind 5: complex f32 transpose [batch][2^a][2^b] -> [batch][2^b][2^a].
note kind 6: the pass plan (data) of an R2C, C2R or 1-, 2-, 3-D complex transform over kinds 1, 4 and 5.
note kinds 7..13: any-length FFT for cufftPlanMany: mixed-radix (2, 3, 4, 5, 7) Stockham passes, Bluestein steps,
note strided gather / scatter copy, and their data (twiddles of any n, chirp, factor plan, magic divisor).
note The algorithms are the public-domain xoshiro256** and SplitMix64 (Blackman and Vigna), Philox4x32-10
note (Salmon, Moraes, Dror and Shaw, SC'11) and the Stockham FFT; the xoshiro stream matches aien-math
note src/stats/random.om bit for bit and the Philox stream the Random123 known answers (fixtures in tests/).
note Record (8 ulong): op, dst, src1, src2, src3 (vreg or 2^64-1 for none), ureg, imm | control << 32,
note uniform | p0 << 1 | not << 2 | dsub << 16 | s1sub << 24 | s2sub << 32 | s3sub << 40.
note The records replay through src/omega_gpu_om_ir.c (C register allocator, migration-pending) and
note encode through om/encoder/bw_enc_sm121.om. Control words follow the elementwise emitter
note (src/omega_gpu_elementwise_api.c: emit kinds, ld_group, tail, schedule_fixed_pairs).
note Meta: 0 records, 1 vregs, 2 uvregs, 3 pending wait mask, 4 error, 5 closed loops, 6 open loops,
note 8..11 open loop starts, 16 + 2L / 17 + 2L closed loop L start / end, 64 + v vreg kind, 320 + u uvreg kind.
note An operand reference is vreg | subreg << 10; NONE (65535) is an absent operand.

const NONE ulong 65535
const ALL ulong 18446744073709551615
const LO32 ulong 4294967295
const M1 ulong 4294967295
const YIELD ulong 8192
const RAWC ulong 927744
const NOPC ulong 1032192
const KFIX ulong 0
const KPRED ulong 1
const KVAR ulong 2
const KUVAR ulong 3
const KSTORE ulong 4
const KSYNC ulong 5
const KEXIT ulong 6
const KBRA ulong 7
const KRAW ulong 8
const MOVRZ ulong 1
const MOVI ulong 2
const S2R ulong 3
const LDC ulong 4
const LDC64 ulong 5
const LDCU64 ulong 7
const IMAD ulong 8
const IMADW ulong 9
const STG ulong 12
const IADD3 ulong 14
const SHFR ulong 17
const LAND ulong 18
const ISGEU ulong 28
const LXOR ulong 29
const FADD ulong 30
const FSUB ulong 31
const FMUL ulong 32
const FFMA ulong 33
const I2FP ulong 38
const FMAX ulong 37
const MRSQ ulong 41
const EXIT ulong 45
const BRA ulong 46
const BAR ulong 48
const LDS ulong 49
const STS ulong 50
const LUT ulong 51
const SHFL ulong 52
const IMADHI ulong 53
const LDG64 ulong 56
const MLG2 ulong 59
const C1 ulong 13787848793156543929
const C2 ulong 10723151780598845931
const K24 f32 5.9604644775390625e-8
const K46 f32 1.4210854715202004e-14
const NLN2 f32 -0.6931471805599453
const RT2 f32 1.4142135623730951
const F25 f32 2.5
const F3 f32 3.0
const F5 f32 5.0
const GC0 f32 1.50140941
const GC1 f32 0.246640727
const GC2 f32 -0.00417768164
const GC3 f32 -0.00125372503
const GC4 f32 0.00021858087
const GC5 f32 -0.00000439150654
const GC6 f32 -0.0000035233877
const GC7 f32 0.000000343273939
const GC8 f32 0.0000000281022636
const GCM f32 1.5
const GT0 f32 2.83297682
const GT1 f32 1.00167406
const GT2 f32 0.00943887047
const GT3 f32 -0.0076224613
const GT4 f32 0.00573950773
const GT5 f32 -0.00367342844
const GT6 f32 0.00134934322
const GT7 f32 0.000100950558
const GT8 f32 -0.000200214257
const HPI f64 1.5707963267948966

note ---- record building

fn fb x f32 to ulong
ret ulong bitcast uint x
end

fn cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end

fn fld r ulong to ulong
if eq r NONE
ret ALL
end
ret and r 1023
end

fn rsub r ulong to ulong
if eq r NONE
ret 0
end
ret shr r 10
end

fn r4 d ulong a ulong b ulong c ulong to ulong
ret or or d shl a 16 or shl b 32 shl c 48
end

fn okk op ulong k ulong fl ulong ur ulong to ulong
ret or or op shl k 8 or shl fl 16 shl ur 40
end

fn sb v ulong s ulong to ulong
ret or v shl s 10
end

fn p2 lo ulong hi ulong to ulong
ret or lo shl hi 16
end

const PW1 ulong 4294967296
const PW2 ulong 8589934592
const PW4 ulong 17179869184

note control word of one record kind: returns control | next pending wait mask << 32
fn kc k ulong fl ulong pend ulong imm ulong to ulong
if eq k KPRED
ret cw 14 7 7 pend
end
if eq k KVAR
ret or or cw 4 0 7 pend YIELD PW1
end
if eq k KUVAR
ret or or cw 4 2 7 pend YIELD PW4
end
if eq k KSTORE
ret or or cw 4 7 1 pend YIELD PW2
end
if or eq k KEXIT eq k KBRA
if ne and fl 2 0
ret or cw 5 7 7 pend shl pend 32
end
ret cw 5 7 7 pend
end
if eq k KRAW
ret or shr imm 32 shl pend 32
end
ret cw 6 7 7 pend
end

note operand fields 1..4 and their subregisters (record word 7 bits 16..47)
fn wops ins edit ulong 8192 b ulong rg ulong to void
d = and rg 65535
s1 = and shr rg 16 65535
s2 = and shr rg 32 65535
s3 = shr rg 48
put ins add b 1 fld d
put ins add b 2 fld s1
put ins add b 3 fld s2
put ins add b 4 fld s3
f1 = or shl rsub d 16 shl rsub s1 24
f2 = or shl rsub s2 32 shl rsub s3 40
put ins add b 7 or f1 f2
end

note record words 5..7: ureg, imm | control << 32, flags (x = control | pending << 32)
fn wtail ins edit ulong 8192 b ulong ok ulong imm ulong x ulong to void
ur = and shr ok 40 65535
uv = ALL
if ne ur NONE
uv = ur
end
put ins add b 5 uv
c = and x LO32
put ins add b 6 or and imm LO32 shl c 32
w7 = get ins add b 7
put ins add b 7 or w7 and shr ok 16 7
end

note one record: ok = op | kind << 8 | flags << 16 | ureg << 40; rg = r4 operands; imm low 32 bits
note (a raw record carries its control word in imm bits 32..63)
fn emit ins edit ulong 8192 m edit ulong 512 ok ulong rg ulong imm ulong to void
n = get m 0
if ge n 1024
put m 4 1
ret
end
k = and shr ok 8 255
if gt k KRAW
put m 4 2
ret
end
x = kc k and shr ok 16 255 get m 3 imm
b = mul n 8
put ins b and ok 255
wops ins b rg
wtail ins b ok imm x
put m 0 add n 1
put m 3 shr x 32
end

fn nv m edit ulong 512 kind ulong to ulong
v = get m 1
if ge v 256
put m 4 3
ret 0
end
put m add 64 v kind
put m 1 add v 1
ret v
end

fn nu m edit ulong 512 kind ulong to ulong
u = get m 2
if ge u 32
put m 4 3
ret 0
end
put m add 320 u kind
put m 2 add u 1
ret u
end

note ---- instruction helpers

fn ef ins edit ulong 8192 m edit ulong 512 op ulong rg ulong imm ulong to void
emit ins m okk op KFIX 0 NONE rg imm
end

note d = op a b (fixed latency), a fresh scalar
fn fo ins edit ulong 8192 m edit ulong 512 op ulong a ulong b ulong to ulong
d = nv m 1
ef ins m op r4 d a b NONE 0
ret d
end

note d = a * imm + c (low 32 bits), a fresh scalar
fn imi ins edit ulong 8192 m edit ulong 512 a ulong imm ulong c ulong to ulong
d = nv m 1
ef ins m IMAD r4 d a NONE c imm
ret d
end

note d:d+1 = a * imm + c:c+1 (unsigned wide), a fresh pair
fn imw ins edit ulong 8192 m edit ulong 512 a ulong imm ulong c ulong to ulong
d = nv m 2
ef ins m IMADW r4 d a NONE c imm
ret d
end

fn sh ins edit ulong 8192 m edit ulong 512 a ulong s ulong to ulong
d = nv m 1
ef ins m SHFR r4 d a NONE NONE s
ret d
end

fn mov ins edit ulong 8192 m edit ulong 512 imm ulong to ulong
d = nv m 1
ef ins m MOVI r4 d NONE NONE NONE imm
ret d
end

fn ffm ins edit ulong 8192 m edit ulong 512 a ulong b ulong c ulong to ulong
d = nv m 1
ef ins m FFMA r4 d a b c 0
ret d
end

note d = LOP3(a, b, c, lut) with a = 0xF0, b = 0xCC, c = 0xAA
fn lut ins edit ulong 8192 m edit ulong 512 a ulong b ulong c ulong f ulong to ulong
d = nv m 1
ef ins m LUT r4 d a b c f
ret d
end

note a variable-latency load into a fresh register of kind kd (1 scalar, 2 pair)
fn vl ins edit ulong 8192 m edit ulong 512 op ulong kd ulong a ulong imm ulong to ulong
d = nv m kd
emit ins m okk op KVAR 0 NONE r4 d a NONE NONE imm
ret d
end

fn gl ins edit ulong 8192 m edit ulong 512 a ulong imm ulong u ulong to ulong
d = nv m 2
emit ins m okk LDG64 KVAR 0 u r4 d a NONE NONE imm
ret d
end

fn stg ins edit ulong 8192 m edit ulong 512 a ulong v ulong imm ulong u ulong to void
emit ins m okk STG KSTORE 0 u r4 NONE a v NONE imm
end

fn sts ins edit ulong 8192 m edit ulong 512 a ulong v ulong to void
emit ins m okk STS KSTORE 0 NONE r4 NONE a v NONE 0
end

fn bar ins edit ulong 8192 m edit ulong 512 to void
emit ins m okk BAR KSYNC 0 NONE r4 NONE NONE NONE NONE 0
end

note P0 = a >= b (unsigned)
fn isge ins edit ulong 8192 m edit ulong 512 a ulong b ulong to void
emit ins m okk ISGEU KPRED 0 NONE r4 NONE a b NONE 0
end

fn exitp ins edit ulong 8192 m edit ulong 512 to void
emit ins m okk EXIT KEXIT 2 NONE r4 NONE NONE NONE NONE 0
end

fn tail ins edit ulong 8192 m edit ulong 512 to void
emit ins m okk EXIT KEXIT 0 NONE r4 NONE NONE NONE NONE 0
emit ins m okk BRA KRAW 0 NONE r4 NONE NONE NONE NONE shl NOPC 32
end

note ---- loops and branches (the replay applies the loop live-range fixup at each closing BRA)

fn lbeg m edit ulong 512 to void
d = get m 6
if ge d 4
put m 4 4
ret
end
put m add 8 d get m 0
put m 6 add d 1
end

fn lend m edit ulong 512 to void
d = get m 6
nl = get m 5
if or eq d 0 ge nl 24
put m 4 5
ret
end
d1 = sub d 1
put m add 16 mul nl 2 get m add 8 d1
put m add 17 mul nl 2 sub get m 0 1
put m 5 add nl 1
put m 6 d1
end

note @P0 BRA forward; returns the record index for patch
fn bfwd ins edit ulong 8192 m edit ulong 512 to ulong
at = get m 0
emit ins m okk BRA KBRA 2 NONE r4 NONE NONE NONE NONE 1
ret at
end

fn patch ins edit ulong 8192 m edit ulong 512 at ulong to void
b = add mul at 8 6
x = get ins b
put ins b or and x 18446744069414584320 sub get m 0 at
end

note @!P0 BRA back to the innermost open loop start
fn bback ins edit ulong 8192 m edit ulong 512 to void
d = get m 6
if eq d 0
put m 4 6
ret
end
tgt = get m add 7 d
emit ins m okk BRA KBRA 6 NONE r4 NONE NONE NONE NONE and sub tgt get m 0 LO32
end

note ---- fixed-latency pair scheduling (schedule_fixed_pairs in the elementwise emitter)

fn cls op ulong to ulong
if or or eq op MOVRZ eq op MOVI or eq op IADD3 eq op LXOR
ret 1
end
if or or eq op LUT eq op SHFR eq op SHFL
ret 1
end
if or or eq op IMAD eq op IMADHI or eq op FADD eq op FSUB
ret 2
end
if or eq op FMUL eq op FFMA
ret 2
end
ret 0
end

note tighten record i's stall from 6 to 5 when record i + 1 is a fixed op of the same class
fn tpair ins edit ulong 8192 i ulong to void
a = get ins mul i 8
ca = cls a
if or eq ca 0 ne ca cls get ins mul add i 1 8
ret
end
if eq a IADD3
ret
end
if ne and get ins add mul i 8 7 2 0
ret
end
if ne and get ins add mul add i 1 8 7 2 0
ret
end
b = add mul i 8 6
x = get ins b
ct = shr x 32
if ne and shr ct 9 15 6
ret
end
put ins b or and x LO32 shl sub ct 512 32
end

fn sched ins edit ulong 8192 m edit ulong 512 to void
n = get m 0
for i ulong n
if lt add i 1 n
tpair ins i
end
end
end

note ---- xoshiro256** on 64-bit values held as two 32-bit registers (p2 lo hi)

note x ^ (x >> s), 0 < s < 32, into fresh registers
fn xs ins edit ulong 8192 m edit ulong 512 x ulong s ulong to ulong
lo = and x 65535
hi = shr x 16
t = sh ins m lo s
u = imi ins m hi shl 1 sub 32 s t
nl = fo ins m LXOR lo u
v = sh ins m hi s
nh = fo ins m LXOR hi v
ret p2 nl nh
end

note x * c mod 2^64
fn mulc ins edit ulong 8192 m edit ulong 512 x ulong c ulong to ulong
lo = and x 65535
hi = shr x 16
cl = and c LO32
ch = shr c 32
w = imw ins m lo cl NONE
h = imi ins m hi cl sb w 1
nh = h
if ne ch 0
nh = imi ins m lo ch h
end
ret p2 sb w 0 nh
end

note rotl(x, s), 0 < s < 32, into fresh registers
fn rotl ins edit ulong 8192 m edit ulong 512 x ulong s ulong to ulong
lo = and x 65535
hi = shr x 16
a = sh ins m hi sub 32 s
b = sh ins m lo sub 32 s
nl = imi ins m lo shl 1 s a
nh = imi ins m hi shl 1 s b
ret p2 nl nh
end

note SplitMix64 finaliser
fn mix ins edit ulong 8192 m edit ulong 512 x ulong to ulong
a = xs ins m x 30
b = mulc ins m a C1
c = xs ins m b 27
d = mulc ins m c C2
ret xs ins m d 31
end

note d ^= a in place
fn x64 ins edit ulong 8192 m edit ulong 512 d ulong a ulong to void
dl = and d 65535
dh = shr d 16
ef ins m LXOR r4 dl dl and a 65535 NONE 0
ef ins m LXOR r4 dh dh shr a 16 NONE 0
end

note x = rotl(x, 45) in place: lo' = hi << 13 | lo >> 19, hi' = lo << 13 | hi >> 19
fn rot45 ins edit ulong 8192 m edit ulong 512 x ulong to void
lo = and x 65535
hi = shr x 16
a = sh ins m lo 19
b = sh ins m hi 19
nl = imi ins m hi 8192 a
ef ins m IMAD r4 hi lo NONE b 8192
ef ins m IMAD r4 lo nl NONE NONE 1
end

note one xoshiro256** state advance, in place
fn step ins edit ulong 8192 m edit ulong 512 st view ulong 4 to void
s0 = get st 0
s1 = get st 1
s2 = get st 2
s3 = get st 3
l1 = and s1 65535
h1 = shr s1 16
tl = imi ins m l1 131072 NONE
th = imi ins m h1 131072 sh ins m l1 15
x64 ins m s2 s0
x64 ins m s3 s1
x64 ins m s1 s2
x64 ins m s0 s3
x64 ins m s2 p2 tl th
rot45 ins m s3
end

note ---- inverse normal: Giles' single-precision erfinv on w = -ln(1 - x^2)

fn hcen ins edit ulong 8192 m edit ulong 512 t ulong mut ulong to ulong
p = mov ins m fb GC8
p = ffm ins m p t mov ins m fb GC7
p = ffm ins m p t mov ins m fb GC6
p = ffm ins m p t mov ins m fb GC5
p = ffm ins m p t mov ins m fb GC4
p = ffm ins m p t mov ins m fb GC3
p = ffm ins m p t mov ins m fb GC2
p = ffm ins m p t mov ins m fb GC1
c0 = fb GC0
if eq mut 2
c0 = fb GCM
end
ret ffm ins m p t mov ins m c0
end

fn htail ins edit ulong 8192 m edit ulong 512 t ulong to ulong
p = mov ins m fb GT8
p = ffm ins m p t mov ins m fb GT7
p = ffm ins m p t mov ins m fb GT6
p = ffm ins m p t mov ins m fb GT5
p = ffm ins m p t mov ins m fb GT4
p = ffm ins m p t mov ins m fb GT3
p = ffm ins m p t mov ins m fb GT2
p = ffm ins m p t mov ins m fb GT1
ret ffm ins m p t mov ins m fb GT0
end

note w = -ln(1 - x^2) and xi = 2A - 2^24 for A = top 23 bits * 2 + 1 (x = xi / 2^24, 1 - x^2 = A (2^24 - A) / 2^46);
note returns p2 w xi
fn vnw ins edit ulong 8192 m edit ulong 512 hi ulong to ulong
one = mov ins m 1
a = sh ins m hi 8
a = lut ins m a one NONE 252
b = mov ins m 16777216
b = imi ins m a M1 b
xi = mov ins m 4278190080
xi = imi ins m a 2 xi
a = fo ins m I2FP a NONE
b = fo ins m I2FP b NONE
q = fo ins m FMUL a b
q = fo ins m FMUL q mov ins m fb K46
q = vl ins m MLG2 1 q 0
q = fo ins m FMUL q mov ins m fb NLN2
ret p2 q xi
end

note z = sqrt(2) erfinv(x): central branch for w < 5 (t = w - 2.5), tail branch (t = sqrt(w) - 3) otherwise
fn vnorm ins edit ulong 8192 m edit ulong 512 hi ulong mut ulong to ulong
wx = vnw ins m hi
w = and wx 65535
t = fo ins m FSUB w mov ins m fb F25
pc = hcen ins m t mut
t = vl ins m MRSQ 1 w 0
t = fo ins m FMUL w t
t = fo ins m FSUB t mov ins m fb F3
pt = htail ins m t
t = fo ins m FSUB w mov ins m fb F5
t = sh ins m t 31
t = imi ins m t M1 NONE
pc = lut ins m t pc pt 202
t = fo ins m I2FP shr wx 16 NONE
t = fo ins m FMUL t mov ins m fb K24
t = fo ins m FMUL pc t
ret fo ins m FMUL t mov ins m fb RT2
end

note ---- the RNG kernel. Arguments (constant bank): 0x380 out, 0x388 + 8 i base_i = seed + stream0 + (i + 1) G
note (i < 4), 0x3a8 skip, 0x3ac per-stream count, 0x3b0 stream count. Thread g writes out[j * ns + g].
note R: 0 ureg desc, 1 out, 2 skip, 3 count, 4 streams, 5 g, 6 one, 7 zero, 8 element index, 9..12 base_i

fn rpro ins edit ulong 8192 m edit ulong 512 R edit ulong 16 to void
u = nu m 2
put R 0 u
emit ins m okk LDCU64 KUVAR 1 NONE r4 u NONE NONE NONE 856
put R 1 vl ins m LDC64 2 NONE 896
for i ulong 4
put R add 9 i vl ins m LDC64 2 NONE add 904 mul i 8
end
put R 2 vl ins m LDC 1 NONE 936
put R 3 vl ins m LDC 1 NONE 940
put R 4 vl ins m LDC 1 NONE 944
t = vl ins m S2R 1 NONE 33
c = vl ins m S2R 1 NONE 37
g = imi ins m c 128 t
put R 5 g
isge ins m g get R 4
exitp ins m
put R 6 mov ins m 1
z = nv m 1
ef ins m MOVRZ r4 z NONE NONE NONE 0
put R 7 z
end

note state word i = SplitMix64(base_i + g): stream g seeds aien-math's SplitMix64 with seed + stream0 + g, and the host
note puts seed + stream0 + (i + 1) G in base_i; IMAD.WIDE g * 1 adds g (see omega_gpu_mathlibs_api.c)
fn rinit ins edit ulong 8192 m edit ulong 512 R view ulong 16 st edit ulong 4 to void
for i ulong 4
x = imw ins m get R 5 1 get R add 9 i
put st i mix ins m p2 sb x 0 sb x 1
end
end

note advance every stream by the skip count
fn rskip ins edit ulong 8192 m edit ulong 512 R view ulong 16 st view ulong 4 to void
off = get R 2
isge ins m get R 7 off
at = bfwd ins m
lbeg m
step ins m st
ef ins m IMAD r4 off get R 6 NONE off M1
isge ins m get R 7 off
bback ins m
lend m
patch ins m at
end

note one output: raw 64-bit, uniform f32 top 24 bits / 2^24, or normal f32
fn rstore ins edit ulong 8192 m edit ulong 512 R view ulong 16 r ulong var ulong mut ulong to void
hi = shr r 16
if eq var 0
ad = imw ins m get R 8 8 get R 1
stg ins m ad and r 65535 0 get R 0
stg ins m ad hi 4 get R 0
ret
end
z = ulong 0
if eq var 1
z = sh ins m hi 8
z = fo ins m I2FP z NONE
z = fo ins m FMUL z mov ins m fb K24
else
z = vnorm ins m hi mut
end
ad = imw ins m get R 8 4 get R 1
stg ins m ad z 0 get R 0
end

fn rout ins edit ulong 8192 m edit ulong 512 R edit ulong 16 st view ulong 4 var ulong mut ulong to void
e = imi ins m get R 5 1 NONE
put R 8 e
rot = ulong 7
if eq mut 1
rot = 8
end
lbeg m
r = mulc ins m get st 1 5
r = rotl ins m r rot
r = mulc ins m r 9
rstore ins m R r var mut
step ins m st
ef ins m IMAD r4 e get R 4 NONE e 1
c = get R 3
ef ins m IMAD r4 c get R 6 NONE c M1
isge ins m get R 7 c
bback ins m
lend m
end

fn rngk ins edit ulong 8192 m edit ulong 512 var ulong mut ulong to void
R = new ulong 16 0
st = new ulong 4 0
rpro ins m edit R
rinit ins m view R edit st
rskip ins m view R view st
rout ins m edit R view st var mut
tail ins m
end

note ---- the FFT kernel: one CTA of n / 4 threads per transform; data interleaved (re, im) f32 pairs.
note Arguments: 0x380 in, 0x388 out, 0x390 twiddles. Shared memory: re plane at 0, im plane at 4n.
note A: 0..7 Y (stage outputs, re/im of elements 0..3), 8..15 T (DFT4 temporaries), 16..23 shared read
note addresses, 24..31 V (stage inputs), 32..34 twiddle pairs, 40 ureg desc, 41 in, 42 out, 43 twiddles,
note 44 tid, 45 one, 46 g = cta n + tid, 47 store address, 48 n, 50 stages, 51 odd, 52 forward, 53 p,
note 54 twiddled stage seen, 55 mutant, 56 i = tid mod p.

fn pk d ulong a ulong b ulong to ulong
ret or d or shl a 8 shl b 16
end

note A[d] = op A[a] A[b] for x = pk d a b
fn fop ins edit ulong 8192 m edit ulong 512 A view ulong 64 op ulong x ulong to void
d = get A and x 255
a = get A and shr x 8 255
ef ins m op r4 d a get A shr x 16 NONE 0
end

fn fset ins edit ulong 8192 m edit ulong 512 A edit ulong 64 lg ulong dir ulong mut ulong to void
n = shl 1 lg
put A 48 n
put A 51 and lg 1
put A 50 add and lg 1 shr lg 1
f = ulong 1
if eq dir 1
f = 0
end
if eq mut 1
f = sub 1 f
end
put A 52 f
put A 53 1
put A 55 mut
for j ulong 16
put A j nv m 1
end
for j ulong 3
put A add 32 j nv m 2
end
u = nu m 2
put A 40 u
emit ins m okk LDCU64 KUVAR 1 NONE r4 u NONE NONE NONE 856
put A 41 vl ins m LDC64 2 NONE 896
put A 42 vl ins m LDC64 2 NONE 904
put A 43 vl ins m LDC64 2 NONE 912
t = vl ins m S2R 1 NONE 33
put A 44 t
c = vl ins m S2R 1 NONE 37
put A 45 mov ins m 1
put A 46 imi ins m c n t
put A 47 nv m 1
if gt get A 50 1
fra ins m A
end
end

note shared read addresses: re of element j at 4t + j n, im + 4n
fn fra ins edit ulong 8192 m edit ulong 512 A edit ulong 64 to void
n = get A 48
one = get A 45
c = imi ins m get A 44 4 NONE
for j ulong 4
o = mul j n
put A add 16 mul j 2 imi ins m one o c
put A add 17 mul j 2 imi ins m one add o mul n 4 c
end
end

note V = this stage's inputs: global loads at stage 0, else the shared reads as one group
note (the first load waits, the rest ride its scoreboard, like the elementwise ld_group)
fn fload ins edit ulong 8192 m edit ulong 512 A edit ulong 64 s ulong to void
if eq s 0
n = get A 48
ga = imw ins m get A 46 8 get A 41
for j ulong 4
w = gl ins m ga mul j mul n 2 get A 40
put A add 24 mul j 2 sb w 0
put A add 25 mul j 2 sb w 1
end
ret
end
emit ins m okk LDS KVAR 0 NONE r4 get A 0 get A 16 NONE NONE 0
for j ulong 7
k = add j 1
emit ins m okk LDS KRAW 0 NONE r4 get A k get A add 16 k NONE NONE shl RAWC 32
end
for j ulong 8
put A add 24 j get A j
end
end

note element j of V times twiddle pair w, in place
fn cmul ins edit ulong 8192 m edit ulong 512 A view ulong 64 j ulong w ulong to void
a = get A add 24 mul j 2
b = get A add 25 mul j 2
t1 = fo ins m FMUL a sb w 0
t2 = fo ins m FMUL b sb w 1
t3 = fo ins m FMUL b sb w 0
ef ins m FFMA r4 b a sb w 1 t3 0
ef ins m FSUB r4 a t1 t2 NONE 0
end

note i = tid mod p and the twiddles w^(j i n / (4p)), j = 1..3 (mutant 2 skips them on the first p > 1 stage)
fn ftw ins edit ulong 8192 m edit ulong 512 A edit ulong 64 to void
p = get A 53
if eq p 1
ret
end
i = nv m 1
put A 56 i
ef ins m LAND r4 i get A 44 NONE NONE sub p 1
dotw = or ne get A 55 2 ne get A 54 0
put A 54 1
if dotw
tws = div get A 48 mul p 4
for j ulong 3
ta = imw ins m i mul mul add j 1 tws 8 get A 43
t = get A add 32 j
emit ins m okk LDG64 KVAR 0 get A 40 r4 t ta NONE NONE 0
cmul ins m A add j 1 t
end
end
end

note Y = DFT4(V) through T; forward multiplies u1 - u3 by -i
fn dft4 ins edit ulong 8192 m edit ulong 512 A view ulong 64 to void
fop ins m A FADD pk 8 24 28
fop ins m A FADD pk 9 25 29
fop ins m A FSUB pk 10 24 28
fop ins m A FSUB pk 11 25 29
fop ins m A FADD pk 12 26 30
fop ins m A FADD pk 13 27 31
fop ins m A FSUB pk 14 26 30
fop ins m A FSUB pk 15 27 31
fop ins m A FADD pk 0 8 12
fop ins m A FADD pk 1 9 13
fop ins m A FSUB pk 4 8 12
fop ins m A FSUB pk 5 9 13
k1 = ulong 2
k3 = ulong 6
if eq get A 52 0
k1 = 6
k3 = 2
end
fop ins m A FADD pk k1 10 15
fop ins m A FSUB pk add k1 1 11 14
fop ins m A FSUB pk k3 10 15
fop ins m A FADD pk add k3 1 11 14
end

note radix 2 on (u0, u2) and (u1, u3): Y = (u0 + u2, u0 - u2, u1 + u3, u1 - u3) to shared 2t, 2t + 1,
note 2t + n/2, 2t + n/2 + 1
fn fr2 ins edit ulong 8192 m edit ulong 512 A edit ulong 64 to void
fop ins m A FADD pk 0 24 28
fop ins m A FADD pk 1 25 29
fop ins m A FSUB pk 2 24 28
fop ins m A FSUB pk 3 25 29
fop ins m A FADD pk 4 26 30
fop ins m A FADD pk 5 27 31
fop ins m A FSUB pk 6 26 30
fop ins m A FSUB pk 7 27 31
n = get A 48
wb = imi ins m get A 44 8 NONE
sa = get A 47
for j ulong 4
o = add mul shr j 1 mul n 2 mul and j 1 4
for pl ulong 2
ef ins m IMAD r4 sa get A 45 NONE wb add o mul pl mul n 4
sts ins m sa get A add mul j 2 pl
end
end
bar ins m
put A 53 2
end

note Y to shared at 4k + i + j p (k = t - i): byte 16t - 12i + 4jp, im plane + 4n
fn fsst ins edit ulong 8192 m edit ulong 512 A edit ulong 64 to void
n = get A 48
p = get A 53
wb = imi ins m get A 44 16 NONE
if gt p 1
wb = imi ins m get A 56 4294967284 wb
end
sa = get A 47
for j ulong 4
for pl ulong 2
o = add mul mul j p 4 mul pl mul n 4
ef ins m IMAD r4 sa get A 45 NONE wb o
sts ins m sa get A add mul j 2 pl
end
end
bar ins m
put A 53 mul p 4
end

note the last stage (p = n/4, so i = t): Y element j to out[g + j n/4]
fn fgst ins edit ulong 8192 m edit ulong 512 A view ulong 64 to void
n = get A 48
go = imw ins m get A 46 8 get A 42
for j ulong 4
o = mul j mul n 2
stg ins m go get A mul j 2 o get A 40
stg ins m go get A add mul j 2 1 add o 4 get A 40
end
end

fn fstage ins edit ulong 8192 m edit ulong 512 A edit ulong 64 s ulong to void
fload ins m A s
if and eq s 0 eq get A 51 1
fr2 ins m A
ret
end
ftw ins m A
dft4 ins m A
if eq s sub get A 50 1
fgst ins m A
ret
end
if gt s 0
bar ins m
end
fsst ins m A
end

fn fftk ins edit ulong 8192 m edit ulong 512 lg ulong dir ulong mut ulong to void
A = new ulong 64 0
fset ins m edit A lg dir mut
nst = get A 50
for s ulong nst
fstage ins m edit A s
end
tail ins m
end

note ---- twiddles: w^m = exp(-+2 pi i m / n), m < n, by quadrant folding and f64 Taylor series on [0, pi/4]

fn sinp x f64 to f64
x2 = mul x x
t = x
s = x
for k ulong 12
a = f64 add mul k 2 2
t = div mul t neg x2 mul a add a 1.0f64
s = add s t
end
ret s
end

fn cosp x f64 to f64
x2 = mul x x
t = 1.0f64
s = 1.0f64
for k ulong 12
a = f64 add mul k 2 1
t = div mul t neg x2 mul a add a 1.0f64
s = add s t
end
ret s
end

note (c, s) = (cos, sin) of the folded angle rotated into quadrant q; forward conjugates; f32 bits packed
fn tq q ulong c f64 s f64 dir ulong to ulong
re = c
im = s
if eq q 1
re = neg s
im = c
end
if eq q 2
re = neg c
im = neg s
end
if eq q 3
re = s
im = neg c
end
fr = f32 re
fi = f32 im
if eq dir 0
fi = neg fi
end
ret or ulong bitcast uint fr shl ulong bitcast uint fi 32
end

note w^k = exp(+-2 pi i k / n), any n >= 1, k < n: 4k = q n + r; angle (pi/2) r / n, folded to (pi/2) (n - r) / n
note with cos and sin swapped when r > n/2, so the series only sees [0, pi/4] (for n = 2^lg the same bits as the
note shift form the power-of-two kernels used before kinds 7..13 existed)
fn twg k ulong n ulong dir ulong to ulong
q = div mul k 4 n
r = sub mul k 4 mul q n
sw = gt r shr n 1
if sw
r = sub n r
end
ph = mul HPI div f64 r f64 n
c = cosp ph
s = sinp ph
if sw
t = c
c = s
s = t
end
ret tq q c s dir
end

fn twid ins edit ulong 8192 n ulong dir ulong to void
for k ulong n
put ins k twg k n dir
end
end

note ---- kind 3: Philox4x32-10 (Salmon, Moraes, Dror, Shaw 2011; Random123), the stream of cuRAND's
note curandStatePhilox4_32_10_t, and cuRAND's distributions on it. a = distribution: 0 raw 32-bit words (curand),
note 1 uniform f32 (curand_uniform), 2 uniform f64 (curand_uniform_double), 3 uniform f64 from two words
note (curand_uniform2_double, x then y), 4 normal f32 (curand_normal, Box-Muller, sine first). b = offset mod 4;
note c = mutant 0..6. Group i of stream g is the stream words offset + 4 i .. offset + 4 i + 3: counter block q0 + i
note shifted by b (b > 0 joins words b..3 of block q0 + i to words 0..b - 1 of block q0 + i + 1). A group yields G
note outputs (G 4; 2 for distribution 3), each element 4 bytes (0, 1, 4) or 8 bytes (2, 3).
note Arguments: 0x380 out, 0x388 key (the 64-bit seed), 0x390 subsequence of stream 0, 0x398 q0 = offset / 4,
note 0x3a0 groups per stream T, 0x3a4 stream count ns, 0x3a8 dl = r - G mod 2^32 where 0 < r <= G is the output count of
note the last group (dl 0 when it is full). Thread g is stream g with counter (q0 + i, subseq0 + g) as two 64-bit halves.
note Layout: output c of group j < T - 1 of stream g is element (j ns + g) G + c; output c < r of the last group is
note element (T - 1) ns G + g r + c (the last group of every stream packed after the full groups).
note P: 0 ureg desc, 1 out, 2 key, 3 counter high pair, 4 counter low pair, 5 groups left, 6 streams, 7 element index
note of the group, 8 one, 9 zero, 10..19 round keys k0 + r W0, 20..29 round keys k1 + r W1, 30 dl, 31 g dl, 32 ns G,
note 33 G, 34..37 previous block (b > 0), 38 2^32 - 2, 40..47 two round scratch sets (pair X, pair Y, L0, L1),
note 49..51 the constants 1..3, 52 store limit, 54 mutant, 55 distribution, 56 b, 58..61 the current block words,
note 64 + i distribution constant i, 128..222 the scratch pool (vreg + 1), 223 the next pool index, 224..243 named
note intermediates of pdbl / phq / pbm (functions take at
note most six parameters, so the kernel state is this one array).
note Mutants: 1 k1 bumped by W0, 2 nine rounds, 3 uniform f32 without the half step, 4 b > 0 ignores the previous
note block, 5 normal sine and cosine swapped, 6 uniform2_double without round to nearest even.
const PHM0 ulong 3528531795
const PHM1 ulong 3449720151
const PHW0 ulong 2654435769
const PHW1 ulong 3144134277
note f32 bit patterns of the distribution constants (Wolfram-checked; values in the PR evidence README)
const QK65536 ulong 1199570944
const QP2M32 ulong 796917760
const QP2M33 ulong 788529152
const QC2PI ulong 818483163
const QC2PIH ulong 810094555
const QLOGADD ulong 4913933
const QMASK23 ulong 8388607
const QSQ2H ulong 1060439283
const QFM1 ulong 3212836864
const QFM127 ulong 3271426048
const QLC0 ulong 1051372202
const QLC1 ulong 3196059644
const QLC2 ulong 1045221036
const QLC3 ulong 3190468176
const QLC4 ulong 1041361343
const QLC5 ulong 3187563855
const QLC6 ulong 1039082778
const QLC7 ulong 3186348470
const QLC8 ulong 1032855994
const QFMH ulong 3204448256
const QLN2H ulong 1060204928
const QLN2L ulong 924317650
const QFM2 ulong 3221225472
const QTINY ulong 8388608
const QFH ulong 1056964608
const QTWOOPI ulong 1059256707
const QMAGIC ulong 1262485504
const QMAGICN ulong 3409969152
const QNP1 ulong 3217625051
const QNP2 ulong 859553070
const QNP3 ulong 653733101
const QS3 ulong 3190467243
const QS5 ulong 1007192201
const QS7 ulong 3109031169
const QS9 ulong 909700893
const QCC4 ulong 1026206379
const QCC6 ulong 3132492641
const QCC8 ulong 936381697
const QCC10 ulong 3029594750
const QONE ulong 1065353216

fn ppro ins edit ulong 8192 m edit ulong 512 P edit ulong 256 G ulong to void
put P 0 nu m 2
emit ins m okk LDCU64 KUVAR 1 NONE r4 get P 0 NONE NONE NONE 856
put P 1 vl ins m LDC64 2 NONE 896
put P 2 vl ins m LDC64 2 NONE 904
s0 = vl ins m LDC64 2 NONE 912
put P 4 vl ins m LDC64 2 NONE 920
put P 5 vl ins m LDC 1 NONE 928
put P 6 vl ins m LDC 1 NONE 932
put P 30 vl ins m LDC 1 NONE 936
t = vl ins m S2R 1 NONE 33
c = vl ins m S2R 1 NONE 37
g = imi ins m c 128 t
isge ins m g get P 6
exitp ins m
put P 3 imw ins m g 1 s0
put P 8 mov ins m 1
z = nv m 1
ef ins m MOVRZ r4 z NONE NONE NONE 0
put P 9 z
put P 7 imi ins m g G z
put P 32 imi ins m get P 6 G z
gd = nv m 1
ef ins m IMAD r4 gd g get P 30 z 0
put P 31 gd
put P 33 mov ins m G
put P 38 mov ins m 4294967294
put P 49 get P 8
put P 50 mov ins m 2
put P 51 mov ins m 3
end

note round keys (mutant 1 bumps k1 by W0)
fn pkeys ins edit ulong 8192 m edit ulong 512 P edit ulong 256 to void
k = get P 2
w1 = PHW1
if eq get P 54 1
w1 = PHW0
end
put P 10 sb k 0
put P 20 sb k 1
for r ulong 9
q = add r 1
one = get P 8
x = imi ins m one and mul q PHW0 LO32 sb k 0
put P add 10 q x
x = imi ins m one and mul q w1 LO32 sb k 1
put P add 20 q x
end
end

note constant i of the distribution (P 64 + i)
fn kq P edit ulong 256 i ulong to ulong
ret get P add 64 i
end

fn kput ins edit ulong 8192 m edit ulong 512 P edit ulong 256 i ulong bits ulong to void
put P add 64 i mov ins m bits
end

note distribution constants (f32 bits; 37..41 the f64 builder: 158, exponent bias << 20, the pair (2^32 - 1, 0),
note the pair (1, 0), 2)
fn pkc ins edit ulong 8192 m edit ulong 512 P edit ulong 256 to void
a = get P 55
if or eq a 1 eq a 4
kput ins m P 0 QK65536
kput ins m P 1 QP2M32
kput ins m P 2 QP2M33
end
if eq a 4
kput ins m P 3 QC2PI
kput ins m P 4 QC2PIH
kput ins m P 5 QFM1
kput ins m P 6 QFM127
kput ins m P 7 QLC0
kput ins m P 8 QLC1
kput ins m P 9 QLC2
kput ins m P 10 QLC3
kput ins m P 11 QLC4
kput ins m P 12 QLC5
kput ins m P 13 QLC6
kput ins m P 14 QLC7
kput ins m P 15 QLC8
kput ins m P 16 QFMH
kput ins m P 17 QLN2H
kput ins m P 18 QLN2L
kput ins m P 19 QFM2
kput ins m P 20 QTINY
kput ins m P 21 QFH
kput ins m P 22 QTWOOPI
kput ins m P 23 QMAGIC
kput ins m P 24 QMAGICN
kput ins m P 25 QNP1
kput ins m P 26 QNP2
kput ins m P 27 QNP3
kput ins m P 28 QS3
kput ins m P 29 QS5
kput ins m P 30 QS7
kput ins m P 31 QS9
kput ins m P 32 QCC4
kput ins m P 33 QCC6
kput ins m P 34 QCC8
kput ins m P 35 QCC10
kput ins m P 36 QONE
end
if or eq a 2 eq a 3
kput ins m P 37 158
bias = ulong 863
if eq a 3
bias = 841
end
kput ins m P 38 shl bias 20
put P 103 imw ins m mov ins m M1 1 NONE
put P 104 imw ins m mov ins m 1 1 NONE
kput ins m P 41 2
end
end

note ---- the scratch pool: a fixed set of scalar vregs reused by every output (the loop body would otherwise
note exceed 256 vregs); put P 223 0 restarts it
fn tnew m edit ulong 512 P edit ulong 256 to ulong
i = get P 223
if ge i 95
put m 4 3
ret 0
end
put P 223 add i 1
v = get P add 128 i
if eq v 0
v = add nv m 1 1
put P add 128 i v
end
ret sub v 1
end

fn tfo ins edit ulong 8192 m edit ulong 512 P edit ulong 256 op ulong a ulong b ulong to ulong
d = tnew m P
ef ins m op r4 d a b NONE 0
ret d
end

note d = a * b + c (FFMA)
fn tff ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong b ulong c ulong to ulong
d = tnew m P
ef ins m FFMA r4 d a b c 0
ret d
end

note d = a * imm + c (IMAD, low 32 bits)
fn tim ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong imm ulong c ulong to ulong
d = tnew m P
ef ins m IMAD r4 d a NONE c imm
ret d
end

note d = a * b + c (IMAD register form, low 32 bits)
fn tir ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong b ulong c ulong to ulong
d = tnew m P
ef ins m IMAD r4 d a b c 0
ret d
end

note d = lut(a, b, RZ) with function f
fn tlu ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong b ulong f ulong to ulong
d = tnew m P
ef ins m LUT r4 d a b NONE f
ret d
end

fn tsh ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong s ulong to ulong
d = tnew m P
ef ins m SHFR r4 d a NONE NONE s
ret d
end

fn tan ins edit ulong 8192 m edit ulong 512 P edit ulong 256 a ulong imm ulong to ulong
d = tnew m P
ef ins m LAND r4 d a NONE NONE imm
ret d
end

note ---- one Philox round into scratch set o: X = M0 c0, Y = M1 c2 (wide), c = (Y.hi ^ c1 ^ k0, Y.lo, X.hi ^ c3 ^ k1,
note X.lo) on the block words P 58..61; the sets alternate so a round never overwrites the words it reads
fn prnd ins edit ulong 8192 m edit ulong 512 P edit ulong 256 k0 ulong k1 ulong o ulong to void
b = add 40 mul o 4
x = get P b
y = get P add b 1
l0 = get P add b 2
l1 = get P add b 3
ef ins m IMADW r4 x get P 58 NONE NONE PHM0
ef ins m IMADW r4 y get P 60 NONE NONE PHM1
ef ins m LUT r4 l0 sb y 1 get P 59 k0 150
ef ins m LUT r4 l1 sb x 1 get P 61 k1 150
put P 58 l0
put P 59 sb y 0
put P 60 l1
put P 61 sb x 0
end

note block blk (counter low pair) of this thread's subsequence into P 58..61: nr rounds
fn pblk ins edit ulong 8192 m edit ulong 512 P edit ulong 256 blk ulong nr ulong to void
put P 58 sb blk 0
put P 59 sb blk 1
put P 60 sb get P 3 0
put P 61 sb get P 3 1
for r ulong nr
prnd ins m P get P add 10 r get P add 20 r and r 1
end
end

note word i of the group (b > 0: previous block words b..3, then this block's words 0..b - 1; mutant 4 skips it)
fn pw P edit ulong 256 i ulong to ulong
b = get P 56
if or eq b 0 eq get P 54 4
ret get P add 58 i
end
j = add i b
if lt j 4
ret get P add 34 j
end
ret get P add 58 sub j 4
end

note the guard of output c: c = 0 always stores; c > 0 skips its stores when c >= the store limit (last group)
fn pgrd ins edit ulong 8192 m edit ulong 512 P edit ulong 256 c ulong to ulong
if eq c 0
ret ALL
end
isge ins m get P add 48 c get P 52
ret bfwd ins m
end

fn pgend ins edit ulong 8192 m edit ulong 512 at ulong to void
if ne at ALL
patch ins m at
end
end

note x as the f32 cuRAND builds it: (x >> 16) 65536 + (x & 0xffff), one rounding (FFMA of two exact I2FP)
fn pfrn ins edit ulong 8192 m edit ulong 512 P edit ulong 256 x ulong to ulong
a = tfo ins m P I2FP tsh ins m P x 16 NONE
b = tfo ins m P I2FP tan ins m P x 65535 NONE
ret tff ins m P a kq P 0 b
end

note curand_uniform: x 2^-32 + 2^-33 in one FFMA (mutant 3: x 2^-32)
fn punif ins edit ulong 8192 m edit ulong 512 P edit ulong 256 x ulong to ulong
f = pfrn ins m P x
if eq get P 54 3
ret tfo ins m P FMUL f kq P 1
end
ret tff ins m P f kq P 1 kq P 2
end

note a 64-bit integer hi:lo (nonzero, < 2^54) times 2^-s as f64, exact: normalize the leading one to bit 63 of H:L,
note then dhi = (H >> 11) + (e - 1) 2^20 and dlo = H 2^21 + (L >> 11). The exponent field is
note nz 32 + eb + big + bias, eb the f32 exponent of the leading bit of the top nonzero word, bias = 895 - s
note (863 for s = 32, 841 for s = 54 with big adding one when s = 53). Returns p2 dlo dhi.
fn pdbl ins edit ulong 8192 m edit ulong 512 P edit ulong 256 hi ulong lo ulong big ulong to ulong
x = imw ins m hi 1 get P 103
put P 224 sb x 1
x = tim ins m P get P 224 M1 get P 8
put P 225 tir ins m P lo x hi
put P 226 tir ins m P lo get P 224 NONE
x = get P 225
for i ulong 5
x = tlu ins m P x tsh ins m P x shl 1 i 252
end
x = tfo ins m P LXOR x tsh ins m P x 1
x = tfo ins m P I2FP x NONE
put P 227 tan ins m P tsh ins m P x 23 255
x = tim ins m P get P 227 M1 kq P 37
x = tfo ins m P SHFL get P 8 x
y = tfo ins m P IMADHI get P 226 x
put P 228 tir ins m P get P 225 x y
put P 229 tir ins m P get P 226 x NONE
x = tim ins m P get P 224 32 get P 227
if ne big NONE
x = tfo ins m P IADD3 x big
end
x = tim ins m P x 1048576 kq P 38
y = tim ins m P tsh ins m P get P 228 11 1 x
x = tim ins m P get P 228 2097152 tsh ins m P get P 229 11
ret p2 x y
end

note curand_uniform2_double (x, y): z = x ^ (y << 21) < 2^53, value z 2^-53 + 2^-54 rounded to nearest even:
note z < 2^52 gives (2 z + 1) 2^-54 exactly; z >= 2^52 (big) gives (z + (z & 1)) 2^-53 (mutant 6: z 2^-53)
fn phq ins edit ulong 8192 m edit ulong 512 P edit ulong 256 x ulong y ulong to ulong
put P 224 tsh ins m P y 11
put P 225 tfo ins m P LXOR x tim ins m P y 2097152 get P 9
put P 226 tsh ins m P get P 224 20
put P 227 tim ins m P get P 226 M1 get P 8
x = tir ins m P get P 225 get P 227 NONE
y = imw ins m get P 225 1 NONE
y = imw ins m x 1 y
x = get P 227
if ne get P 54 6
x = tir ins m P get P 226 tan ins m P get P 225 1 get P 227
end
y = imw ins m x 1 y
x = tir ins m P get P 224 tim ins m P get P 226 M1 kq P 41 sb y 1
ret pdbl ins m P x sb y 0 get P 226
end

note curand_normal on the words (x, y): u = uniform(x), v = y 2^-32 2 pi + pi 2^-32 (two roundings),
note s = sqrt(-2 log u), (s sin v, s cos v). log: u = 2^k m, m in [sqrt(2)/2, sqrt(2)), f = m - 1,
note log1p f = f - f^2/2 + f^3 R(f) (minimax R), k ln 2 in two parts. sqrt: MUFU.RSQ y0, s0 = w y0, one Newton
note step on the residual. sin / cos: quadrant k = round(2 v / pi) by the 1.5 2^23 trick, three-part Cody-Waite
note reduction, odd / even polynomials, the quadrant applied as (A, B) = (|q| - 1, q (|q| - 2)), q = k - 2.
note Returns p2 n0 n1 (mutant 5 swaps sine and cosine).
fn pbm ins edit ulong 8192 m edit ulong 512 P edit ulong 256 x ulong y ulong to ulong
put P 230 punif ins m P x
x = pfrn ins m P y
put P 231 tfo ins m P FADD tfo ins m P FMUL x kq P 3 kq P 4
x = tim ins m P get P 8 QLOGADD get P 230
y = tsh ins m P x 23
x = tim ins m P get P 8 QSQ2H tan ins m P x QMASK23
put P 232 tfo ins m P FADD x kq P 5
put P 233 tfo ins m P FADD tfo ins m P I2FP y NONE kq P 6
x = kq P 15
for i ulong 8
x = tff ins m P x get P 232 kq P sub 14 i
end
x = tff ins m P get P 232 x kq P 16
y = tfo ins m P FMUL get P 232 get P 232
x = tff ins m P y x get P 232
x = tff ins m P get P 233 kq P 17 tff ins m P get P 233 kq P 18 x
put P 234 tfo ins m P FMUL x kq P 19
x = tfo ins m P FMAX get P 234 kq P 20
y = tnew m P
emit ins m okk MRSQ KVAR 0 NONE r4 y x NONE NONE 0
put P 235 y
x = tfo ins m P FMUL get P 234 y
y = tff ins m P tfo ins m P FMUL x kq P 5 x get P 234
put P 236 tff ins m P y tfo ins m P FMUL get P 235 kq P 21 x
x = tfo ins m P FADD tff ins m P get P 231 kq P 22 kq P 23 kq P 24
put P 237 x
y = tff ins m P x kq P 25 get P 231
y = tff ins m P x kq P 26 y
y = tff ins m P x kq P 27 y
put P 238 y
x = tfo ins m P FMUL y y
y = tff ins m P x kq P 31 kq P 30
y = tff ins m P x y kq P 29
y = tff ins m P x y kq P 28
put P 240 tff ins m P tfo ins m P FMUL get P 238 x y get P 238
y = tff ins m P x kq P 35 kq P 34
y = tff ins m P x y kq P 33
y = tff ins m P x y kq P 32
y = tff ins m P x y kq P 16
put P 241 tff ins m P x y kq P 36
x = tfo ins m P FADD get P 237 kq P 19
y = tfo ins m P FMAX x tfo ins m P FMUL x kq P 5
put P 242 tfo ins m P FADD y kq P 5
put P 243 tfo ins m P FMUL x tfo ins m P FADD y kq P 19
x = tff ins m P get P 240 get P 242 tfo ins m P FMUL get P 241 get P 243
y = tff ins m P get P 241 get P 242 tfo ins m P FMUL get P 240 tfo ins m P FMUL get P 243 kq P 5
x = tfo ins m P FMUL x get P 236
y = tfo ins m P FMUL y get P 236
if eq get P 54 5
ret p2 y x
end
ret p2 x y
end

note store a 64-bit value (p2 lo hi) as element c of 8 bytes, under its guard
fn pst8 ins edit ulong 8192 m edit ulong 512 P edit ulong 256 ad ulong c ulong d ulong to void
at = pgrd ins m P c
stg ins m ad and d 65535 mul c 8 get P 0
stg ins m ad shr d 16 add mul c 8 4 get P 0
pgend ins m at
end

note store a 32-bit value as element c of 4 bytes, under its guard
fn pst4 ins edit ulong 8192 m edit ulong 512 P edit ulong 256 ad ulong c ulong x ulong to void
at = pgrd ins m P c
stg ins m ad x mul c 4 get P 0
pgend ins m at
end

note the outputs of one group, each stored under its guard as soon as it is computed (the pool restarts per output;
note the second normal pair takes fresh vregs so no scratch register is held across both Box-Muller transforms)
fn pdist ins edit ulong 8192 m edit ulong 512 P edit ulong 256 ad ulong to void
a = get P 55
if lt a 2
for c ulong 4
put P 223 0
x = pw P c
if eq a 1
x = punif ins m P x
end
pst4 ins m P ad c x
end
ret
end
if eq a 2
for c ulong 4
put P 223 0
x = imw ins m pw P c 1 get P 104
pst8 ins m P ad c pdbl ins m P sb x 1 sb x 0 NONE
end
ret
end
if eq a 3
for c ulong 2
put P 223 0
pst8 ins m P ad c phq ins m P pw P mul c 2 pw P add mul c 2 1
end
ret
end
for h ulong 2
put P 223 0
if eq h 1
for i ulong 95
put P add 128 i 0
end
end
c = mul h 2
d = pbm ins m P pw P c pw P add c 1
pst4 ins m P ad c and d 65535
pst4 ins m P ad add c 1 shr d 16
end
end

note copy the block words into the previous block (P 34..37)
fn pprev ins edit ulong 8192 m edit ulong 512 P edit ulong 256 to void
for i ulong 4
ef ins m IMAD r4 get P add 34 i get P add 58 i NONE NONE 1
end
end

note per group: the block (b > 0: and the previous one), the outputs, counter low += 1, element index += ns G
fn ploop ins edit ulong 8192 m edit ulong 512 P edit ulong 256 to void
nr = ulong 10
if eq get P 54 2
nr = 9
end
esz = ulong 4
if or eq get P 55 2 eq get P 55 3
esz = 8
end
blk = get P 4
if gt get P 56 0
pblk ins m P blk nr
pprev ins m P
ef ins m IMADW r4 blk get P 8 NONE blk 1
end
lbeg m
pblk ins m P blk nr
cnt = get P 5
x = sh ins m imi ins m cnt 1 get P 38 31
y = nv m 1
ef ins m IMAD r4 y x get P 30 get P 33 0
put P 52 y
y = nv m 1
ef ins m IMAD r4 y x get P 31 get P 7 0
pdist ins m P imw ins m y esz get P 1
if gt get P 56 0
pprev ins m P
end
ef ins m IMADW r4 blk get P 8 NONE blk 1
x = get P 7
ef ins m IMAD r4 x get P 32 NONE x 1
ef ins m IMAD r4 cnt get P 8 NONE cnt M1
isge ins m get P 9 cnt
bback ins m
lend m
end

fn phik ins edit ulong 8192 m edit ulong 512 a ulong b ulong mut ulong to void
P = new ulong 256 0
put P 54 mut
put P 55 a
put P 56 b
g = ulong 4
if eq a 3
g = 2
end
ppro ins m P g
pkeys ins m P
pkc ins m P
for o ulong 2
q = add 40 mul o 4
put P q nv m 2
put P add q 1 nv m 2
put P add q 2 nv m 1
put P add q 3 nv m 1
end
if gt b 0
for i ulong 4
put P add 34 i nv m 1
end
end
ploop ins m P
tail ins m
end

note ---- kind 4: the real-FFT post-pass (b 0, split) and pre-pass (b 1, merge) for N = 2^a, n = N / 2.
note One CTA of n / 2 threads per row; thread t takes the pair (t, n - t), and every thread also writes element n / 2
note (identical bits). Split: Z = FFT_n(x read as complex) in rows of n -> X in rows of n + 1 (cuFFT R2C layout):
note E = (Z_t + conj Z_(n-t)) / 2, O = (Z_t - conj Z_(n-t)) / 2i, P = W^t O, X_t = E + P, X_(n-t) = conj (E - P),
note X_(n/2) = conj Z_(n/2). Merge: X in rows of n + 1 -> Z' in rows of n, A = X_t + conj X_(n-t),
note Q = W^-t (X_t - conj X_(n-t)), Z'_t = A + iQ, Z'_(n-t) = conj A + i conj Q, Z'_(n/2) = 2 conj X_(n/2); the
note unnormalized inverse FFT_n of Z' is the C2R output (cuFFT convention: C2R(R2C(x)) = N x).
note Arguments: 0x380 in, 0x388 out, 0x390 twiddles of N (forward for split, inverse for merge).
note Q: 0 ureg desc, 1 in row, 2 out row, 3 twiddles, 4 tid, 5 n - tid, 6 (n - tid) mod n.
note V: 0 first input pair, 1 partner pair, 2 twiddle pair, 3 / 4 E or A, 5 P or Q (p2 re im).
note Mutants: 1 drops the twiddle multiply, 2 skips element n / 2.
const FRH f32 0.5
const FRNH f32 -0.5
const FRN1 f32 -1.0
const FR2 f32 2.0
const FRN2 f32 -2.0

fn andi ins edit ulong 8192 m edit ulong 512 a ulong imm ulong to ulong
d = nv m 1
ef ins m LAND r4 d a NONE NONE imm
ret d
end

note (re + i im) times the twiddle pair w: a fresh p2 re im
fn cmw ins edit ulong 8192 m edit ulong 512 re ulong im ulong w ulong to ulong
t1 = fo ins m FMUL re sb w 0
t2 = fo ins m FMUL im sb w 1
t3 = fo ins m FMUL im sb w 0
i2 = ffm ins m re sb w 1 t3
ret p2 fo ins m FSUB t1 t2 i2
end

fn rpro4 ins edit ulong 8192 m edit ulong 512 Q edit ulong 16 lg ulong dir ulong to void
n = shl 1 sub lg 1
put Q 0 nu m 2
emit ins m okk LDCU64 KUVAR 1 NONE r4 get Q 0 NONE NONE NONE 856
put Q 1 vl ins m LDC64 2 NONE 896
put Q 2 vl ins m LDC64 2 NONE 904
put Q 3 vl ins m LDC64 2 NONE 912
c = vl ins m S2R 1 NONE 37
t = vl ins m S2R 1 NONE 33
put Q 4 t
si = add n dir
so = sub add n 1 dir
put Q 1 imw ins m c mul si 8 get Q 1
put Q 2 imw ins m c mul so 8 get Q 2
v = imi ins m t M1 mov ins m n
put Q 5 v
put Q 6 andi ins m v sub n 1
end

note V 0 = in[t], V 1 = in[(n - t) mod n] (split) or in[n - t] (merge), V 2 = twiddle t
fn rld4 ins edit ulong 8192 m edit ulong 512 Q view ulong 16 V edit ulong 8 dir ulong to void
u = get Q 0
put V 0 gl ins m imw ins m get Q 4 8 get Q 1 0 u
put V 1 gl ins m imw ins m get Q sub 6 dir 8 get Q 1 0 u
put V 2 gl ins m imw ins m get Q 4 8 get Q 3 0 u
end

fn rsplit ins edit ulong 8192 m edit ulong 512 V edit ulong 8 mut ulong to void
a = get V 0
b = get V 1
h = mov ins m fb FRH
put V 3 fo ins m FMUL fo ins m FADD sb a 0 sb b 0 h
put V 4 fo ins m FMUL fo ins m FSUB sb a 1 sb b 1 h
o1 = fo ins m FMUL fo ins m FADD sb a 1 sb b 1 h
o2 = fo ins m FMUL fo ins m FSUB sb a 0 sb b 0 mov ins m fb FRNH
p = p2 o1 o2
if ne mut 1
p = cmw ins m o1 o2 get V 2
end
put V 5 p
end

note X_t = (Er + Pr, Ei + Pi), X_(n-t) = (Er - Pr, Pi - Ei)
fn sst4 ins edit ulong 8192 m edit ulong 512 Q view ulong 16 V view ulong 8 to void
er = get V 3
ei = get V 4
pr = and get V 5 65535
pi = shr get V 5 16
u = get Q 0
x = imw ins m get Q 4 8 get Q 2
stg ins m x fo ins m FADD er pr 0 u
stg ins m x fo ins m FADD ei pi 4 u
x = imw ins m get Q 5 8 get Q 2
stg ins m x fo ins m FSUB er pr 0 u
stg ins m x fo ins m FSUB pi ei 4 u
end

fn rmerge ins edit ulong 8192 m edit ulong 512 V edit ulong 8 mut ulong to void
a = get V 0
b = get V 1
put V 3 fo ins m FADD sb a 0 sb b 0
put V 4 fo ins m FSUB sb a 1 sb b 1
d1 = fo ins m FSUB sb a 0 sb b 0
d2 = fo ins m FADD sb a 1 sb b 1
q = p2 d1 d2
if ne mut 1
q = cmw ins m d1 d2 get V 2
end
put V 5 q
end

note Z'_((n-t) mod n) = (Ar + Qi, Qr - Ai) first, then Z'_t = (Ar - Qi, Ai + Qr) (t = 0 keeps the second)
fn mst4 ins edit ulong 8192 m edit ulong 512 Q view ulong 16 V view ulong 8 to void
ar = get V 3
ai = get V 4
qr = and get V 5 65535
qi = shr get V 5 16
u = get Q 0
x = imw ins m get Q 6 8 get Q 2
stg ins m x fo ins m FADD ar qi 0 u
stg ins m x fo ins m FSUB qr ai 4 u
x = imw ins m get Q 4 8 get Q 2
stg ins m x fo ins m FSUB ar qi 0 u
stg ins m x fo ins m FADD ai qr 4 u
end

note element n / 2: split conj Z, merge 2 conj X
fn rmid ins edit ulong 8192 m edit ulong 512 Q view ulong 16 lg ulong dir ulong to void
o = shl 1 add lg 1
u = get Q 0
z = gl ins m get Q 1 o u
if eq dir 0
stg ins m get Q 2 sb z 0 o u
stg ins m get Q 2 fo ins m FMUL sb z 1 mov ins m fb FRN1 add o 4 u
ret
end
stg ins m get Q 2 fo ins m FMUL sb z 0 mov ins m fb FR2 o u
stg ins m get Q 2 fo ins m FMUL sb z 1 mov ins m fb FRN2 add o 4 u
end

fn rk4 ins edit ulong 8192 m edit ulong 512 lg ulong dir ulong mut ulong to void
Q = new ulong 16 0
V = new ulong 8 0
rpro4 ins m edit Q lg dir
rld4 ins m view Q edit V dir
if eq dir 0
rsplit ins m edit V mut
sst4 ins m view Q view V
else
rmerge ins m edit V mut
mst4 ins m view Q view V
end
if ne mut 2
rmid ins m view Q lg dir
end
tail ins m
end

note ---- kind 5: complex f32 transpose [batch][R][C] -> [batch][C][R], R = 2^a, C = 2^b; 256 threads, one element
note each. Arguments: 0x380 in, 0x388 out, 0x390 element count, 0x394 first element of this launch.
note Element g = (hi, r, c) goes to hi + c R + r. Mutants: 1 copies (identity), 2 drops the batch part hi.
note T: 0 ureg desc, 1 in, 2 out, 3 g.
fn trpro ins edit ulong 8192 m edit ulong 512 T edit ulong 8 to void
put T 0 nu m 2
emit ins m okk LDCU64 KUVAR 1 NONE r4 get T 0 NONE NONE NONE 856
put T 1 vl ins m LDC64 2 NONE 896
put T 2 vl ins m LDC64 2 NONE 904
tot = vl ins m LDC 1 NONE 912
g0 = vl ins m LDC 1 NONE 916
c = vl ins m S2R 1 NONE 37
t = vl ins m S2R 1 NONE 33
g = fo ins m IADD3 imi ins m c 256 g0 t
put T 3 g
isge ins m g tot
exitp ins m
end

fn trix ins edit ulong 8192 m edit ulong 512 g ulong lr ulong lc ulong mut ulong to ulong
if eq mut 1
ret g
end
cc = andi ins m g sub shl 1 lc 1
rr = andi ins m sh ins m g lc sub shl 1 lr 1
o = imi ins m cc shl 1 lr rr
if eq mut 2
ret o
end
k = shl 1 add lr lc
k = and sub 0 k LO32
hi = andi ins m g k
ret fo ins m IADD3 o hi
end

fn trk ins edit ulong 8192 m edit ulong 512 lr ulong lc ulong mut ulong to void
T = new ulong 8 0
trpro ins m edit T
g = get T 3
v = gl ins m imw ins m g 8 get T 1 0 get T 0
ad = imw ins m trix ins m g lr lc mut 8 get T 2
stg ins m ad sb v 0 0 get T 0
stg ins m ad sb v 1 4 get T 0
tail ins m
end

note ---- kind 6: the pass plan (data). a = mode | ndim << 4 (mode 0 complex ndim-D, 1 R2C, 2 C2R); b = log2 of the
note dims, 4 bits each, dim 0 (outermost) at bits 0..3 (R2C / C2R: log2 N 3..12); c = direction (mode 0 only).
note Word 0 = steps; word s + 1 = kind | a << 8 | b << 16 | src << 24 | dst << 32 | log2 rows per batch item << 40,
note buffers 0 in, 1 out, 2 scratch. ndim-D: per round r, the FFT along dim ndim - 1 - r (contiguous) to scratch,
note then the transpose [R][C] -> [C][R] back to out; after ndim rounds the layout is the input's again.
fn pstep k ulong a ulong b ulong s ulong d ulong r ulong to ulong
ret or or or k shl a 8 or shl b 16 shl s 24 or shl d 32 shl r 40
end

fn plan1 ins edit ulong 8192 mode ulong lg ulong to ulong
if or lt lg 3 gt lg 12
ret 1
end
h = sub lg 1
put ins 0 2
if eq mode 1
put ins 1 pstep 1 h 0 0 2 0
put ins 2 pstep 4 lg 0 2 1 0
ret 0
end
put ins 1 pstep 4 lg 1 0 2 0
put ins 2 pstep 1 h 1 2 1 0
ret 0
end

fn plann ins edit ulong 8192 nd ulong b ulong dir ulong to ulong
if ne shr b mul 4 nd 0
ret 1
end
tot = ulong 0
for i ulong nd
l = and shr b mul 4 i 15
if or lt l 2 gt l 11
ret 1
end
tot = add tot l
end
if gt tot 27
ret 1
end
if eq nd 1
put ins 0 1
put ins 1 pstep 1 b dir 0 1 0
ret 0
end
put ins 0 mul nd 2
for r ulong nd
l = and shr b mul 4 sub sub nd 1 r 15
s = ulong 1
if eq r 0
s = 0
end
put ins add 1 mul r 2 pstep 1 l dir s 2 sub tot l
put ins add 2 mul r 2 pstep 5 sub tot l l 2 1 0
end
ret 0
end

fn plan ins edit ulong 8192 a ulong b ulong c ulong to ulong
mode = and a 15
nd = shr a 4
if gt mode 2
ret 1
end
if gt mode 0
if or ne nd 1 ne c 0
ret 1
end
ret plan1 ins mode b
end
if or or lt nd 1 gt nd 3 gt c 1
ret 1
end
ret plann ins nd b c
end

note ---- kinds 7..13: general-length FFT (cufftPlanMany). Kind 7 is one Stockham radix-R pass (R 2, 3, 4, 5, 7),
note kind 8 the four Bluestein steps (any other length through a power-of-two M >= 2N - 1), kind 9 the strided
note gather / scatter / rotate copy, kinds 10..13 their data (twiddles of any n, chirp, factor plan, magic divisor).
note The kernels run 128 threads per CTA, one butterfly or element per thread, chunked by a 'first' word like kind 5.
note Every launch passes np 64-bit pointers at 0x380 + 8 i, then 32-bit words: word 0 total, word 1 first, ...
const LDGE ulong 11
const SGN ulong 2147483648

note d = a * b + c (IMAD register form, low 32 bits); c may be NONE (zero)
fn imr ins edit ulong 8192 m edit ulong 512 a ulong b ulong c ulong to ulong
d = nv m 1
ef ins m IMAD r4 d a b c 0
ret d
end

note 32-bit global load (LDG.E) of [a]
fn g32 ins edit ulong 8192 m edit ulong 512 a ulong u ulong to ulong
d = nv m 1
emit ins m okk LDGE KVAR 0 u r4 d a NONE NONE 0
ret d
end

note x div d and x mod d for x < 2^32, 1 <= d < 2^31, mg = min(floor(2^32 / d), 2^32 - 1), nd = 2^32 - d:
note q0 = hi32(x mg) is q - 1 or q; t = x - (q0 + 1) d is r - d < 0 (q0 = q) or r >= 0 (q0 = q - 1), so
note inc = (~t) >> 31, q = q0 + inc, r = x - q d. Returns p2 q r.
fn mdiv ins edit ulong 8192 m edit ulong 512 x ulong d ulong mg ulong to ulong
nd = imi ins m d M1 NONE
q = fo ins m IMADHI x mg
t = fo ins m IADD3 imr ins m q nd x nd
i = sh ins m lut ins m t t NONE 15 31
q = fo ins m IADD3 q i
ret p2 q imr ins m q nd x
end

note G: 0 ureg desc, 1..3 pointers, 4 + w word w; returns g = ctaid 128 + tid + first after the exit on g >= total
fn kpro ins edit ulong 8192 m edit ulong 512 G edit ulong 32 np ulong nw ulong to ulong
u = nu m 2
put G 0 u
emit ins m okk LDCU64 KUVAR 1 NONE r4 u NONE NONE NONE 856
for i ulong np
put G add 1 i vl ins m LDC64 2 NONE add 896 mul i 8
end
b = add 896 mul np 8
for j ulong nw
put G add 4 j vl ins m LDC 1 NONE add b mul j 4
end
c = vl ins m S2R 1 NONE 37
t = vl ins m S2R 1 NONE 33
g = fo ins m IADD3 imi ins m c 128 get G 5 t
isge ins m g get G 4
exitp ins m
ret g
end

note ---- kind 7: one Stockham pass, radix R = a (2, 3, 4, 5, 7), b 0 forward / 1 inverse, c mutant (1 the
note butterfly runs the other direction, 2 drops the twiddle multiply). Pointers 0x380 in, 0x388 out, 0x390
note twiddles of N in the transform's direction. Words: 0 T butterflies, 1 first, 2 NR = N / R, 3 magic NR, 4 Ns,
note 5 magic Ns, 6 s = N / (Ns R), 7 N. Butterfly g: row, j = g divmod NR; k = j mod Ns; v_r = in[row N + j + r NR]
note times w^(r k s); X_m = sum_r v_r exp(-+2 pi i r m / R) goes to out[row N + R j - (R - 1) k + m Ns].
note G 20 row, 21 j, 22 k.
note radix constants (Wolfram, f32 round-to-nearest bits): cos and sin of 2 pi j / R; s 0 cos, 1 sin
fn rcv R ulong j ulong s ulong to ulong
if eq R 3
if eq s 0
ret 3204448256
end
ret 1063105495
end
if eq R 5
if eq j 1
if eq s 0
ret 1050556282
end
ret 1064532081
end
if eq s 0
ret 3209632701
end
ret 1058437400
end
if eq j 1
if eq s 0
ret 1059036423
end
ret 1061692956
end
if eq j 2
if eq s 0
ret 3194215559
end
ret 1064932576
end
if eq s 0
ret 3211175397
end
ret 1054746114
end

note G 23 = address of in[row N + j], 24 = k s; V 2r, 2r + 1 = the twiddled inputs (operand refs)
fn rld1 ins edit ulong 8192 m edit ulong 512 G view ulong 32 V edit ulong 16 r ulong mut ulong to void
a = get G 23
if gt r 0
a = imw ins m get G 6 mul r 8 a
end
w = gl ins m a 0 get G 0
re = sb w 0
im = sb w 1
if gt r 0
if ne mut 2
a = imw ins m get G 24 mul r 8 get G 3
a = gl ins m a 0 get G 0
a = cmw ins m re im a
re = and a 65535
im = shr a 16
end
end
put V mul r 2 re
put V add 1 mul r 2 im
end

fn rld7 ins edit ulong 8192 m edit ulong 512 G edit ulong 32 V edit ulong 16 R ulong mut ulong to void
a = imw ins m imr ins m get G 20 get G 11 get G 21 8 get G 1
put G 23 a
if ne mut 2
e = imr ins m get G 22 get G 10 NONE
put G 24 e
end
for r ulong R
rld1 ins m view G edit V r mut
end
end

fn dr2 ins edit ulong 8192 m edit ulong 512 V view ulong 16 Y edit ulong 16 to void
put Y 0 fo ins m FADD get V 0 get V 2
put Y 1 fo ins m FADD get V 1 get V 3
put Y 2 fo ins m FSUB get V 0 get V 2
put Y 3 fo ins m FSUB get V 1 get V 3
end

note X0 = s02 + s13, X2 = s02 - s13; forward X1 = d02 - i d13, X3 = d02 + i d13 (inverse swaps X1, X3)
fn dr4 ins edit ulong 8192 m edit ulong 512 V view ulong 16 Y edit ulong 16 fw ulong to void
a0 = fo ins m FADD get V 0 get V 4
a1 = fo ins m FADD get V 1 get V 5
b0 = fo ins m FADD get V 2 get V 6
b1 = fo ins m FADD get V 3 get V 7
put Y 0 fo ins m FADD a0 b0
put Y 1 fo ins m FADD a1 b1
put Y 4 fo ins m FSUB a0 b0
put Y 5 fo ins m FSUB a1 b1
a0 = fo ins m FSUB get V 0 get V 4
a1 = fo ins m FSUB get V 1 get V 5
b0 = fo ins m FSUB get V 2 get V 6
b1 = fo ins m FSUB get V 3 get V 7
k = ulong 2
l = ulong 6
if eq fw 0
k = 6
l = 2
end
put Y k fo ins m FADD a0 b1
put Y add k 1 fo ins m FSUB a1 b0
put Y l fo ins m FSUB a0 b1
put Y add l 1 fo ins m FADD a1 b0
end

note odd R, h = (R - 1) / 2. Work array W: 0..15 the inputs v (re, im refs); 16 + 2r, 17 + 2r = a_r = v_r + v_(R-r);
note 24 + 2r, 25 + 2r = b_r = v_r - v_(R-r); 32 + j cos, 36 + j sin, 40 + j -sin of 2 pi j / R (j <= h);
note 48 R, 49 forward flag, 50..53 the running P re, P im, Q re, Q im.
fn dpre ins edit ulong 8192 m edit ulong 512 W edit ulong 64 to void
R = get W 48
h = shr sub R 1 1
for i ulong h
r = add i 1
p = mul r 2
q = mul sub R r 2
put W add p 16 fo ins m FADD get W p get W q
put W add p 17 fo ins m FADD get W add p 1 get W add q 1
put W add p 24 fo ins m FSUB get W p get W q
put W add p 25 fo ins m FSUB get W add p 1 get W add q 1
put W add r 32 mov ins m rcv R r 0
put W add r 36 mov ins m rcv R r 1
put W add r 40 mov ins m add rcv R r 1 SGN
end
end

note one term r = i + 1 of output m: P += a_r C(rm), Q += b_r S(rm), with C(j) = C(R - j), S(j) = -S(R - j) for j > h
fn dterm ins edit ulong 8192 m edit ulong 512 W edit ulong 64 mm ulong i ulong to void
R = get W 48
h = shr sub R 1 1
r = mul add i 1 2
j = mul add i 1 mm
j = sub j mul div j R R
s = ulong 36
if gt j h
j = sub R j
s = 40
end
put W 50 ffm ins m get W add r 16 get W add j 32 get W 50
put W 51 ffm ins m get W add r 17 get W add j 32 get W 51
if eq i 0
put W 52 fo ins m FMUL get W add r 24 get W add j s
put W 53 fo ins m FMUL get W add r 25 get W add j s
ret
end
put W 52 ffm ins m get W add r 24 get W add j s get W 52
put W 53 ffm ins m get W add r 25 get W add j s get W 53
end

note forward X_m = (Pr + Qi, Pi - Qr), X_(R-m) = (Pr - Qi, Pi + Qr); inverse swaps them
fn dodm ins edit ulong 8192 m edit ulong 512 W edit ulong 64 Y edit ulong 16 mm ulong to void
R = get W 48
put W 50 get W 0
put W 51 get W 1
for i ulong shr sub R 1 1
dterm ins m edit W mm i
end
k = mm
l = sub R mm
if eq get W 49 0
k = sub R mm
l = mm
end
put Y mul k 2 fo ins m FADD get W 50 get W 53
put Y add 1 mul k 2 fo ins m FSUB get W 51 get W 52
put Y mul l 2 fo ins m FSUB get W 50 get W 53
put Y add 1 mul l 2 fo ins m FADD get W 51 get W 52
end

note W 54, 55 = X_0 = v_0 + sum a_r
fn dsum ins edit ulong 8192 m edit ulong 512 W edit ulong 64 to void
put W 54 get W 0
put W 55 get W 1
for i ulong shr sub get W 48 1 1
r = mul add i 1 2
put W 54 fo ins m FADD get W 54 get W add r 16
put W 55 fo ins m FADD get W 55 get W add r 17
end
end

fn dodd ins edit ulong 8192 m edit ulong 512 V view ulong 16 Y edit ulong 16 R ulong fw ulong to void
W = new ulong 64 0
for i ulong 16
put W i get V i
end
put W 48 R
put W 49 fw
dpre ins m edit W
dsum ins m edit W
put Y 0 get W 54
put Y 1 get W 55
for i ulong shr sub R 1 1
dodm ins m edit W edit Y add i 1
end
end

fn rst7 ins edit ulong 8192 m edit ulong 512 G view ulong 32 Y view ulong 16 R ulong to void
u = get G 0
t = imi ins m get G 22 sub 4294967296 sub R 1 NONE
t = imi ins m get G 21 R t
oa = imw ins m imr ins m get G 20 get G 11 t 8 get G 2
for k ulong R
a = oa
if gt k 0
a = imw ins m get G 8 mul k 8 oa
end
stg ins m a get Y mul k 2 0 u
stg ins m a get Y add 1 mul k 2 4 u
end
end

fn rpk ins edit ulong 8192 m edit ulong 512 R ulong dir ulong mut ulong to void
G = new ulong 32 0
V = new ulong 16 0
Y = new ulong 16 0
g = kpro ins m edit G 3 8
x = mdiv ins m g get G 6 get G 7
put G 20 and x 65535
put G 21 shr x 16
x = mdiv ins m shr x 16 get G 8 get G 9
put G 22 shr x 16
rld7 ins m edit G edit V R mut
fw = eq dir 0
if eq mut 1
fw = ne dir 0
end
f = ulong 0
if fw
f = 1
end
if eq R 2
dr2 ins m view V edit Y
end
if eq R 4
dr4 ins m view V edit Y f
end
if eq and R 1 1
dodd ins m view V edit Y R f
end
rst7 ins m view G view Y R
tail ins m
end

note ---- kind 8: Bluestein steps over rows of M = 2^b (b 5..13); a variant, c mutant. Pointers 0x380 src,
note 0x388 dst, 0x390 aux; words 0 total, 1 first, 2 N. g = row M + n.
note a 0 pre: dst[g] = 0, then for n < N dst[g] = src[row N + n] chirp[n] (mutant 1: no chirp);
note a 1 mul: dst[g] = src[g] B[n] (in place allowed);
note a 2 post: for n < N dst[row N + n] = src[g] chirp[n] 2^-b (mutant 2: no 2^-b);
note a 3 B build over g < M: j = min(g, M - g); dst[g] = conj chirp[j] for j < N, else 0.
note chirp[n] = exp(-+i pi n^2 / N) (kind 11). G 20 n, 21 row.
fn bpre ins edit ulong 8192 m edit ulong 512 G view ulong 32 g ulong mut ulong to void
wa = imw ins m g 8 get G 2
x = mov ins m 0
stg ins m wa x 0 get G 0
stg ins m wa x 4 get G 0
isge ins m get G 20 get G 6
exitp ins m
x = imr ins m get G 21 get G 6 get G 20
x = gl ins m imw ins m x 8 get G 1 0 get G 0
p = p2 sb x 0 sb x 1
if ne mut 1
p = gl ins m imw ins m get G 20 8 get G 3 0 get G 0
p = cmw ins m sb x 0 sb x 1 p
end
stg ins m wa and p 65535 0 get G 0
stg ins m wa shr p 16 4 get G 0
end

fn bmul ins edit ulong 8192 m edit ulong 512 G view ulong 32 g ulong to void
e = gl ins m imw ins m g 8 get G 1 0 get G 0
p = gl ins m imw ins m get G 20 8 get G 3 0 get G 0
p = cmw ins m sb e 0 sb e 1 p
e = imw ins m g 8 get G 2
stg ins m e and p 65535 0 get G 0
stg ins m e shr p 16 4 get G 0
end

fn bpost ins edit ulong 8192 m edit ulong 512 G view ulong 32 g ulong lg ulong mut ulong to void
isge ins m get G 20 get G 6
exitp ins m
e = gl ins m imw ins m g 8 get G 1 0 get G 0
p = gl ins m imw ins m get G 20 8 get G 3 0 get G 0
p = cmw ins m sb e 0 sb e 1 p
re = and p 65535
im = shr p 16
if ne mut 2
e = mov ins m shl sub 127 lg 23
re = fo ins m FMUL re e
im = fo ins m FMUL im e
end
e = imr ins m get G 21 get G 6 get G 20
e = imw ins m e 8 get G 2
stg ins m e re 0 get G 0
stg ins m e im 4 get G 0
end

fn bbld ins edit ulong 8192 m edit ulong 512 G view ulong 32 g ulong lg ulong to void
wa = imw ins m g 8 get G 2
c = mov ins m 0
stg ins m wa c 0 get G 0
stg ins m wa c 4 get G 0
c = imi ins m g M1 mov ins m shl 1 lg
d = imi ins m c M1 g
d = imr ins m sh ins m d 31 d c
isge ins m d get G 6
exitp ins m
c = gl ins m imw ins m d 8 get G 3 0 get G 0
stg ins m wa sb c 0 0 get G 0
d = mov ins m SGN
stg ins m wa fo ins m LXOR sb c 1 d 4 get G 0
end

fn bsk ins edit ulong 8192 m edit ulong 512 v ulong lg ulong mut ulong to void
G = new ulong 32 0
g = kpro ins m edit G 3 3
if eq v 3
bbld ins m view G g lg
tail ins m
ret
end
put G 20 andi ins m g sub shl 1 lg 1
put G 21 sh ins m g lg
if eq v 0
bpre ins m view G g mut
end
if eq v 1
bmul ins m view G g
end
if eq v 2
bpost ins m view G g lg mut
end
tail ins m
end

note ---- kind 9: strided copy of total elements, a mode (0 complex, 1 real -> complex with im 0, 2 complex -> real
note part, 3 complex conjugated), c mutant (1 drops the conjugate, 2 drops the source batch stride). Pointers 0x380
note src, 0x388 dst. Words: 0 total, 1 first, 2 d0, 3 magic d0, 4 d1, 5 magic d1, 6 d2, 7 magic d2, 8 sbase, 9 sb,
note 10 s0, 11 s1, 12 s2, 13 dbase, 14 db, 15 t0, 16 t1, 17 t2. Element g = ((b d2 + i2) d1 + i1) d0 + i0 reads
note src[sbase + b sb + i2 s2 + i1 s1 + i0 s0] and writes dst[dbase + b db + i2 t2 + i1 t1 + i0 t0]; index
note arithmetic is mod 2^32, so a stride may be negative (2^32 - s) when the final index is in range.
note G 24 i0, 25 i1, 26 i2, 27 b.
fn cidx ins edit ulong 8192 m edit ulong 512 G view ulong 32 o ulong mut ulong to ulong
s = imr ins m get G 24 get G add o 2 get G o
s = imr ins m get G 25 get G add o 3 s
s = imr ins m get G 26 get G add o 4 s
if ne mut 2
s = imr ins m get G 27 get G add o 1 s
end
ret s
end

note G 28 source index, 29 destination index
fn cmv ins edit ulong 8192 m edit ulong 512 G view ulong 32 mode ulong mut ulong to void
u = get G 0
if eq mode 1
v = g32 ins m imw ins m get G 28 4 get G 1 u
da = imw ins m get G 29 8 get G 2
stg ins m da v 0 u
stg ins m da mov ins m 0 4 u
ret
end
w = gl ins m imw ins m get G 28 8 get G 1 0 u
if eq mode 2
stg ins m imw ins m get G 29 4 get G 2 sb w 0 0 u
ret
end
im = sb w 1
if eq mode 3
if ne mut 1
im = fo ins m LXOR im mov ins m SGN
end
end
da = imw ins m get G 29 8 get G 2
stg ins m da sb w 0 0 u
stg ins m da im 4 u
end

fn cpk ins edit ulong 8192 m edit ulong 512 mode ulong mut ulong to void
G = new ulong 32 0
g = kpro ins m edit G 2 18
x = mdiv ins m g get G 6 get G 7
put G 24 shr x 16
x = mdiv ins m and x 65535 get G 8 get G 9
put G 25 shr x 16
x = mdiv ins m and x 65535 get G 10 get G 11
put G 26 shr x 16
put G 27 and x 65535
s = cidx ins m view G 12 mut
put G 28 s
s = cidx ins m view G 17 0
put G 29 s
cmv ins m view G mode mut
tail ins m
end

note ---- kinds 10..13 (data). 10: twiddles w^k, k < a (a 2..8192), b direction. 11: chirp exp(-+i pi n^2 / a),
note n < a (a 2..4096), b direction, as w^(n^2 mod 2a) of 2a. 12: factor plan of a (2..4096): word 0 the pass length
note M, 1 Bluestein flag, 2 passes, 3.. radices (4s, one 2, 3s, 5s, 7s); a length with another prime factor runs
note Bluestein on M = the least power of two >= 2a - 1. 13: word 0 = magic min(floor(2^32 / a), 2^32 - 1), a 1..2^31-1.
fn chirp ins edit ulong 8192 n ulong dir ulong to void
t = mul n 2
for i ulong n
s = mul i i
put ins i twg sub s mul div s t t t dir
end
end

fn fpr ins edit ulong 8192 x ulong R ulong lim ulong to ulong
y = x
for i ulong lim
if eq sub y mul div y R R 0
k = get ins 2
put ins add 3 k R
put ins 2 add k 1
y = div y R
end
end
ret y
end

fn fpl ins edit ulong 8192 n ulong to ulong
if or lt n 2 gt n 4096
ret 1
end
for i ulong 32
put ins i 0
end
put ins 0 n
x = fpr ins n 4 6
x = fpr ins x 2 1
x = fpr ins x 3 7
x = fpr ins x 5 5
x = fpr ins x 7 4
if eq x 1
ret 0
end
mm = ulong 1
for i ulong 14
if lt mm sub mul n 2 1
mm = mul mm 2
end
end
for i ulong 32
put ins i 0
end
put ins 0 mm
put ins 1 1
x = fpr ins mm 4 7
x = fpr ins x 2 1
ret 0
end

fn gdata ins edit ulong 8192 kind ulong a ulong b ulong c ulong to ulong
if ne c 0
ret 1
end
if eq kind 10
if or or lt a 2 gt a 8192 gt b 1
ret 1
end
twid ins a b
ret 0
end
if eq kind 11
if or or lt a 2 gt a 4096 gt b 1
ret 1
end
chirp ins a b
ret 0
end
if ne b 0
ret 1
end
if gt kind 13
ret 1
end
if eq kind 12
x = fpl ins a
ret x
end
if or lt a 1 gt a 2147483647
ret 1
end
put ins 0 M1
if gt a 1
put ins 0 div PW1 a
end
ret 0
end

note ---- entry. kind 0 RNG (a variant 0..2, b 0, c mutant 0..2); kind 1 FFT (a log2 n 2..11, b direction
note 0 forward / 1 inverse, c mutant 0..2); kind 2 twiddles (a log2 n 2..12, b direction, c 0); kind 3 Philox
note distributions (a distribution 0..4, b offset mod 4, c mutant 0..6); kind 4 real-FFT split / merge (a log2 N
note 3..12, b 0 split / 1 merge, c mutant 0..2);
note kind 5 transpose (a log2 R 2..25, b log2 C 2..11, a + b <= 27, c mutant 0..2); kind 6 pass plan (data);
note kind 7 Stockham pass (a radix 2, 3, 4, 5, 7, b direction, c mutant 0..2); kind 8 Bluestein step (a variant
note 0..3, b log2 M 5..13, c mutant 0..2); kind 9 strided copy (a mode 0..3, b 0, c mutant 0..2); kinds 10..13
note data (twiddles of any n, chirp, factor plan, magic divisor).
note Returns 0 built, 1 refused arguments, 2 emitter error (meta 4 holds the code).
fn mathlibs_ir kind ulong a ulong b ulong c ulong ins edit ulong 8192 meta edit ulong 512 to ulong
for i ulong 512
put meta i 0
end
if eq kind 2
if or or lt a 2 gt a 12 or gt b 1 ne c 0
ret 1
end
twid ins shl 1 a b
ret 0
end
if gt kind 9
ret gdata ins kind a b c
end
if eq kind 6
ret plan ins a b c
end
if eq kind 0
if or or gt a 2 ne b 0 gt c 2
ret 1
end
rngk ins meta a c
end
if eq kind 1
if or or lt a 2 gt a 11 or gt b 1 gt c 2
ret 1
end
fftk ins meta a b c
end
if eq kind 3
if or or gt a 4 gt b 3 gt c 6
ret 1
end
phik ins meta a b c
end
if eq kind 4
if or or lt a 3 gt a 12 or gt b 1 gt c 2
ret 1
end
rk4 ins meta a b c
end
if eq kind 5
if or or lt a 2 gt a 25 or lt b 2 gt b 11
ret 1
end
if or gt add a b 27 gt c 2
ret 1
end
trk ins meta a b c
end
if eq kind 7
if or or gt c 2 gt b 1 or or lt a 2 gt a 7 eq a 6
ret 1
end
rpk ins meta a b c
end
if eq kind 8
if or or gt a 3 gt c 2 or lt b 5 gt b 13
ret 1
end
bsk ins meta a b c
end
if eq kind 9
if or or gt a 3 ne b 0 gt c 2
ret 1
end
cpk ins meta a c
end
if gt kind 9
ret 1
end
if ne get meta 4 0
ret 2
end
if ne get meta 6 0
ret 2
end
sched ins meta
ret 0
end

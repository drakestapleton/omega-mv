note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One warp per CTA, one component per lane. Tail lanes exit before addressing.
note Vregs: 0 tid,1 block,2 input pair,3 output pair,4 input address pair,
note 5 output address pair,6 count,7 index,8 original x,9 bounded abs x,
note 10 t,11 exp,12 result,13 constant scratch,14 scratch,15 polynomial,
note 16 one,17 zero,18 log2e,19 original abs bits. Params input,output,count.
fn da_copy x edit ulong 8192 m edit ulong 512 d ulong a ulong to void
aa_mad x m d a 1 AN
end
fn da_mulc x edit ulong 8192 m edit ulong 512 d ulong a ulong v f32 to void
aa_mov x m 13 ulong bitcast uint v
aa_bin x m 32 d a 13
end
fn da_addc x edit ulong 8192 m edit ulong 512 d ulong a ulong v f32 to void
aa_mov x m 13 ulong bitcast uint v
aa_bin x m 30 d a 13
end
fn da_horner x edit ulong 8192 m edit ulong 512 v f32 to void
aa_bin x m 32 15 15 10
da_addc x m 15 15 v
end
fn da_exp x edit ulong 8192 m edit ulong 512 to void
note Input 11 is nonpositive and bounded. Tail exp forced to exact zero.
aa_bin x m 32 11 11 18
aa_i x m 47 aa_rg 11 11 AN AN 0 2
end
fn da_erf x edit ulong 8192 m edit ulong 512 to void
note A&S 7.1.26 erfc polynomial at |x|/sqrt(2), not tanh GELU.
da_mulc x m 9 9 0.707106781f32
da_mulc x m 10 9 0.3275911f32
aa_bin x m 30 10 10 16
aa_i x m 40 aa_rg 10 10 AN AN 0 2
aa_bin x m 32 11 9 9
da_mulc x m 11 11 -1.0f32
da_exp x m
aa_mov x m 13 ulong bitcast uint 10.0f32
aa_cmp x m 19 13
aa_mov x m 11 0
aa_pred x m 2
aa_mov x m 15 ulong bitcast uint 1.061405429f32
da_horner x m -1.453152027f32
da_horner x m 1.421413741f32
da_horner x m -0.284496736f32
da_horner x m 0.254829592f32
aa_bin x m 32 15 15 10
aa_bin x m 32 15 15 11
da_mulc x m 15 15 0.5f32
note Negative tail uses x*erfc/2 directly; no 1-erf cancellation.
aa_bin x m 31 14 16 15
aa_bin x m 32 12 8 14
aa_mov x m 13 2147483648
aa_cmp x m 8 13
aa_bin x m 32 12 8 15
aa_pred x m 2
end
fn da_sig x edit ulong 8192 m edit ulong 512 op ulong to void
note SiLU uses exp(-abs x). Tanh GELU uses sigmoid(2*sqrt(2/pi)*(x+.044715*x^3)).
if eq op 2
aa_bin x m 32 11 9 9
da_mulc x m 11 11 0.044715f32
aa_bin x m 30 11 11 16
aa_bin x m 32 11 11 9
da_mulc x m 11 11 -1.595769122f32
else
da_mulc x m 11 9 -1.0f32
end
da_exp x m
cut = f32 80.0
if eq op 2
cut = f32 10.0
end
aa_mov x m 13 ulong bitcast uint cut
aa_cmp x m 19 13
aa_mov x m 11 0
aa_pred x m 2
aa_bin x m 30 10 16 11
aa_i x m 40 aa_rg 10 10 AN AN 0 2
aa_bin x m 32 12 8 10
note Multiply exp before x for negative values. Every intermediate stays finite.
aa_bin x m 32 14 11 10
aa_mov x m 13 2147483648
aa_cmp x m 8 13
aa_bin x m 32 12 8 14
aa_pred x m 2
end
fn da_start x edit ulong 8192 m edit ulong 512 dtype ulong to void
for i ulong 20
kind = ulong 1
if and ge i 2 le i 5
kind = ulong 2
end
v = aa_v m kind
end
put m 2 1
put m 320 2
aa_i x m 7 aa_rg 0 AN AN AN 856 260
aa_i x m 3 aa_rg 0 AN AN AN 33 2
aa_i x m 3 aa_rg 1 AN AN AN 37 2
aa_i x m 5 aa_rg 2 AN AN AN 896 2
aa_i x m 5 aa_rg 3 AN AN AN 904 2
aa_i x m 4 aa_rg 6 AN AN AN 912 2
aa_mad x m 7 1 32 0
aa_cmp x m 7 6
aa_i x m 45 aa_rg AN AN AN AN 0 5
aa_pred x m 2
bytes = ulong 4
if ne dtype 0
bytes = ulong 2
end
aa_addr x m 4 7 bytes 2
aa_addr x m 5 7 4 3
aa_load x m 8 4 0 dtype
aa_mov x m 16 ulong bitcast uint 1.0f32
aa_mov x m 17 0
aa_mov x m 18 ulong bitcast uint 1.442695041f32
aa_i x m 18 aa_rg 19 8 AN AN 2147483647 0
end
fn dnn_activations op ulong dtype ulong unused ulong mutant ulong x edit ulong 8192 m edit ulong 512 to ulong
for i ulong 512
put m i 0
end
if or or gt op 3 gt dtype 2 or ne unused 0 ne mutant 0
ret 1
end
da_start x m dtype
if eq op 0
note ReLU copies signed zero; strictly negative values produce positive zero.
da_copy x m 12 8
aa_mov x m 13 2147483648
aa_cmp x m 8 13
aa_mov x m 12 0
aa_pred x m 2
aa_mov x m 13 1
aa_cmp x m 19 13
da_copy x m 12 8
aa_pred x m 6
else
cut = f32 80.0
if ne op 3
cut = f32 10.0
end
aa_mov x m 13 ulong bitcast uint cut
aa_bin x m 36 9 19 13
if eq op 1
da_erf x m
else
da_sig x m op
end
end
aa_i x m 12 aa_rg AN 5 12 AN 0 3
aa_i x m 45 aa_rg AN AN AN AN 0 5
ret get m 4
end

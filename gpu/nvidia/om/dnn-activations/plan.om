note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Plan words: input bytes, output bytes, CTA count, threads, reserved zero.
fn da_plan n ulong op ulong dtype ulong p edit ulong 8 to ulong
for i ulong 8
put p i 0
end
if or eq n 0 gt n 4294967295
ret 1
end
if or gt op 3 gt dtype 2
ret 1
end
bytes = ulong 4
if ne dtype 0
bytes = ulong 2
end
put p 0 mul n bytes
put p 1 mul n 4
put p 2 div add n 31 32
put p 3 32
ret 0
end

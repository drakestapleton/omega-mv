note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ldg_offset_test.om: gate for the signed 24-bit byte offset of LDG.E (op 11) in the seeded encoder (#373).
note Concatenate after bw_enc_sm121.om; mk/om-encoder.mk test-om-encoder-ldg compiles it with the pinned omc.
note No arguments: every row through enc1. Accepted offsets 0, +0x40, -0x100000, +0x7fffff, -0x800000 must give
note exactly the words below; +0x800000, -0x800001, 0x7fffffff and 0x80000000 must be refused.
note Exit 0, else 10+r for accepted row r, 20+r for refused row r.
note One argument: write the five accepted instructions (80 bytes) on stdout for the ORACLE.
note Two arguments: read the ORACLE's text on stdin and require the five LDG.E lines of ldgnd in order.
note Exit 0, 4 when a line is missing or out of order, 70 on a read error, 71 when the text is too long.
note ORACLE (independent, not first-party, never shipped): NVIDIA nvdisasm 13.0.85 -b SM121 -hex. The packing is the
note C encoder's (src/omega_blackwell_codegen.c bw_c_encode_insn: w1 = ureg or (imm and 0xffffff) shl 8); the
note first four w1 values are the words that encoder produced in #373's freestanding run.
note Operands: R2 <- desc[UR8][R30.64+imm]. Decimal constants by Wolfram: w0 503478657 = 0x1e027981,
note w2 203299072 = 0x0c1e1900, w3 991744 = 0x000f2200; w1: 8, 16392 = 0x4008, 4026531848 = 0xf0000008,
note 2147483400 = 0x7fffff08, 2147483656 = 0x80000008. Offsets as uint32: 64, 4293918720 = -0x100000,
note 8388607, 4286578688 = -0x800000; refused 8388608 = 0x800000, 4286578687 = -0x800001, 2147483647, 2147483648.
text ldgnd "LDG.E R2, desc[UR8][R30.64] ;|LDG.E R2, desc[UR8][R30.64+0x40] ;|LDG.E R2, desc[UR8][R30.64+-0x100000] ;|LDG.E R2, desc[UR8][R30.64+0x7fffff] ;|LDG.E R2, desc[UR8][R30.64+-0x800000] ;|"
global lt_imm ulong 5
global lt_w1 ulong 5
global lt_bad ulong 4

fn lt_init to void
put lt_imm 0 0
put lt_imm 1 64
put lt_imm 2 4293918720
put lt_imm 3 8388607
put lt_imm 4 4286578688
put lt_w1 0 8
put lt_w1 1 16392
put lt_w1 2 4026531848
put lt_w1 3 2147483400
put lt_w1 4 2147483656
put lt_bad 0 8388608
put lt_bad 1 4286578687
put lt_bad 2 2147483647
put lt_bad 3 2147483648
end

note encode LDG.E R2, desc[UR8][R30.64+imm] into w; enc1's result (0 accepted)
fn lt_enc imm ulong w edit ulong 4 to ulong
o = new ulong 16 0
put o 0 11
put o 1 2
put o 2 30
put o 5 8
put o 6 imm
ret enc1 view o w
end

fn lt_words w view ulong 4 r ulong to bool
if ne get w 0 503478657
ret false
end
if ne get w 1 get lt_w1 r
ret false
end
if ne get w 2 203299072
ret false
end
ret eq get w 3 991744
end

fn lt_rows to int
w = new ulong 4 0
for r ulong 5
if ne lt_enc get lt_imm r edit w 0
ret int add 10 r
end
if not lt_words view w r
ret int add 10 r
end
end
for r ulong 4
if eq lt_enc get lt_bad r edit w 0
ret int add 20 r
end
end
ret 0
end

fn lt_bin to int
w = new ulong 4 0
code = new uchar 16384 0
for r ulong 5
if ne lt_enc get lt_imm r edit w 0
ret int add 10 r
end
store edit code r view w
end
off = ulong 0
while lt off 80
n = write 1 code off sub 80 off
if le n 0
ret 3
end
off = add off ulong n
end
ret 0
end

note does needle ldgnd[s..e) start at buf[i]? The caller keeps i + e - s within the text.
fn lt_at buf view uchar 65536 i ulong s ulong e ulong to bool
for j ulong sub e s
if ne get buf add i j get ldgnd add s j
ret false
end
end
ret true
end

note the end of the first match of ldgnd[s..e) in buf[i..n), or n+1 when absent
fn lt_find buf view uchar 65536 n ulong i ulong s ulong e ulong to ulong
while le add i sub e s n
if lt_at buf i s e
ret add i sub e s
end
i = add i 1
end
ret add n 1
end

fn lt_check to int
buf = new uchar 65536 0
n = ulong 0
while lt n 65536
k = read 0 buf n sub 65536 n
if lt k 0
ret 70
end
if eq k 0
break
end
n = add n ulong k
end
if eq n 65536
ret 71
end
pos = ulong 0
s = ulong 0
for e ulong len ldgnd
if eq get ldgnd e 124
pos = lt_find view buf n pos s e
if gt pos n
ret 4
end
s = add e 1
end
end
ret 0
end

fn main to int
lt_init
if gt argcnt 3
ret 64
end
if eq argcnt 3
ret lt_check
end
if eq argcnt 2
ret lt_bin
end
ret lt_rows
end

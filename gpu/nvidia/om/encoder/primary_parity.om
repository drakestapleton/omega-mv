note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Compose after bw_enc_sm121.om. Host only. No device and no new instruction forms.
note t emits 128-byte records for the existing C test adapter, c checks its 24-byte responses.
note Each opcode 0..79 (#280 numbering: main op 64 ATOMG MIN, integ ops moved to 65..79) has eight operand forms, each with 1024 register/control/predicate samples.
note Form bits: uniform-source selector, absent src2, absent src3. Samples also vary absent dst, src1 and ureg.
note Then opcodes 0..81 (the two past the last op are unknown) each get PP_EDGES refusal-edge samples (pp_edge), printed as "edge op=" rows.
note The oracle adapter only marshals fields and calls the independent C encoder.
text pp_ok " parity samples="
text pp_yes " accepted="
text pp_no " refused="
text pp_op "op="
text pp_edg "edge "
text pp_form " form="
text pp_nl "\n"
text pp_bad "ENCODER PARITY FAIL\n"
fn pp_num n ulong to void
b = new uchar 32 0
v = n
pos = ulong 32
while true bound 32
pos = sub pos 1
put b pos uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
r = write 2 b pos sub 32 pos
if ne r long sub 32 pos
exit 2
end
end
fn pp_text b view uchar * to void
r = write 2 b 0 len b
if ne r long len b
exit 2
end
end
fn pp_case a edit ulong 16 op ulong j ulong to void
for k ulong 16
put a k 0
end
note Registers 0..251: 37 is prime to 252, so 252 consecutive indices give every residue, odd and high-bit included;
note src3 = reg + 4 stays at or below 255. WolframLanguageEvaluator: Length[Union[Mod[37 Range[0,1023],252]]] -> 252.
reg = rem mul shr j 3 37 252
put a 0 op
put a 1 reg
if isuld op
put a 1 rem reg 32
end
put a 2 reg
put a 3 add reg 2
put a 4 add reg 4
put a 5 rem j 32
put a 6 and j 31
if eq op 54
put a 6 add and j 31 2
end
if or eq op 18 eq op 29
put a 6 and j 255
end
if eq op 51
put a 6 and j 255
end
if ne and j 8 0
note Control (passed through by both encoders) varies all 32 bits and is never 0: 2654435761 is odd, so j+1 below 2^32
note never maps to 0. WolframLanguageEvaluator over the 4096 samples with j bit 3 set: 32 of 32 bits take both values.
put a 7 rem mul add j 1 2654435761 4294967296
end
form = shr j 10
put a 8 and form 1
if ne rem j 3 0
put a 9 1
end
if eq rem j 3 2
put a 10 1
end
put a 11 and shr j 6 15
note Subregs 0/1 on dst, src1, src2 and src3: both encoders use phys + subreg. On uniform loads both encoders ignore
note dst_subreg; sampling it there keeps that rule under parity too.
note src3 = reg + 4 + subreg stays at or below 255 because its subreg is set only while reg is below 251.
put a 12 and shr j 4 1
put a 13 and shr j 5 1
put a 14 and shr j 9 1
if lt reg 251
put a 15 and shr j 2 1
end
note Absent operands exercise RZ/default routing independently of the physical register samples.
if ne and form 2 0
put a 3 18446744073709551615
end
if ne and form 4 0
put a 4 18446744073709551615
end
if ne and j 64 0
put a 2 18446744073709551615
end
if ne and j 128 0
put a 1 18446744073709551615
end
if ne and j 256 0
put a 5 18446744073709551615
end
end
note Refusal edges. pp_case keeps imm below 288, barrier registers below 16, dst and src1 at or below 252 and the
note opcode at or below 78, so it never reaches these refusal bounds of the two encoders: the signed 24-bit offsets
note (LDG, STG, fragment loads: -2^23 accepted, -2^23-1 refused, 2^23-1 accepted, 2^23 refused), the LDS offset
note (2^23 refused), the BSSY delta (0 and 1 refused, 2 accepted), the BSSY/BSYNC barrier limit (15 accepted, 16 and
note 255 refused), the f64 pair bound (252 accepted, 254 refused, on dst, src1, src2 and src3, and 253 through a
note subreg), the top uniform register 31, and unknown opcodes 79 and 80. Each case sets one field to one edge on
note a fixed even-register base (dst 10, src1 12, src2 14, src3 16, ureg 4, imm 64, control 2654435761); cases
note 22..43 repeat 0..21 with src2 and src3 absent, so ops that refuse a present src2 or src3 still reach the edge.
note A C oracle (or encoder) that moves any of these bounds by one changes an accept or a refusal and fails parity.
const PP_EDGES ulong 44
fn pp_edge a edit ulong 16 op ulong b ulong to void
for k ulong 16
put a k 0
end
e = rem b 22
put a 0 op
put a 1 10
put a 2 12
put a 3 14
put a 4 16
put a 5 4
put a 6 64
put a 7 2654435761
if ge b 22
put a 3 18446744073709551615
put a 4 18446744073709551615
end
if eq e 1
put a 6 8388607
end
if eq e 2
put a 6 8388608
end
if eq e 3
put a 6 4286578688
end
if eq e 4
put a 6 4286578687
end
if eq e 5
put a 6 4294967295
end
if eq e 6
put a 6 0
end
if eq e 7
put a 6 1
end
if eq e 8
put a 6 2
end
if eq e 9
put a 11 15
end
if eq e 10
put a 11 16
end
if eq e 11
put a 11 255
end
if eq e 12
put a 1 252
end
if eq e 13
put a 1 254
end
if eq e 14
put a 2 252
end
if eq e 15
put a 2 254
end
if eq e 16
put a 3 254
end
if eq e 17
put a 4 254
end
if eq e 18
put a 4 255
end
if eq e 19
put a 1 252
put a 12 1
end
if eq e 20
put a 2 252
put a 13 1
end
if eq e 21
put a 5 31
end
note Uniform destinations index uvreg_to_phys (32 entries), as in pp_case.
if isuld op
put a 1 rem get a 1 32
end
end
fn pp_pack a view ulong 16 ins edit ulong 8192 to void
for k ulong 6
put ins k get a k
end
put ins 6 or get a 6 shl get a 7 32
f = or get a 8 shl get a 9 1
f = or f shl get a 10 2
f = or f shl get a 11 8
for k ulong 4
f = or f shl get a add k 12 add 16 mul k 8
end
put ins 7 f
end
fn pp_tape a view ulong 16 to void
b = new uchar 128 0
for k ulong 16
for h ulong 8
put b add mul k 8 h uchar and shr get a k mul h 8 255
end
end
n = write 1 b 0 128
if ne n 128
exit 2
end
end
fn pp_read b edit uchar 24 to void
n = ulong 0
while lt n 24 bound 24
r = read 0 b n sub 24 n
if le r 0
exit 2
end
n = add n ulong r
end
end
fn pp_check b view uchar 24 got ulong code view uchar 16384 to bool
if eq got 16
for k ulong 8
if ne get b k 0
ret false
end
end
for k ulong 16
if ne get b add k 8 get code k
ret false
end
end
else
for k ulong 8
if ne get b k 255
ret false
end
end
end
ret true
end
note The refusal-edge pass: tape mode (m 116) writes the records, any other mode checks the replies in the same order.
fn pp_edges m ulong to int
a = new ulong 16 0
ins = new ulong 8192 0
phys = new ulong 288 0
code = new uchar 16384 0
reply = new uchar 24 0
for k ulong 256
put phys k k
end
for k ulong 32
put phys add k 256 k
end
for op ulong 82
yes = ulong 0
for b ulong PP_EDGES
pp_edge a op b
if eq m 116
pp_tape a
else
pp_pack a ins
got = bw_enc_sm121 ins phys 1 0 code
if eq got 16
yes = add yes 1
end
pp_read reply
if not pp_check reply got code
pp_text pp_bad
pp_num op
pp_text pp_nl
pp_num add 8192 b
pp_text pp_nl
ret 1
end
end
end
if ne m 116
pp_text pp_edg
pp_text pp_op
pp_num op
pp_text pp_ok
pp_num PP_EDGES
pp_text pp_yes
pp_num yes
pp_text pp_no
pp_num sub PP_EDGES yes
pp_text pp_nl
end
end
ret 0
end
fn main to int
mode = new uchar 8 0
a = new ulong 16 0
ins = new ulong 8192 0
phys = new ulong 288 0
code = new uchar 16384 0
reply = new uchar 24 0
r = argread 1 mode 0 8
if lt r 1
ret 2
end
for k ulong 256
put phys k k
end
for k ulong 32
put phys add k 256 k
end
for op ulong 80
for form ulong 8
yes = ulong 0
for j ulong 1024
pp_case a op add mul form 1024 j
if eq get mode 0 116
pp_tape a
else
pp_pack a ins
got = bw_enc_sm121 ins phys 1 0 code
if eq got 16
yes = add yes 1
end
pp_read reply
if eq get mode 0 114
if eq op 0
if eq form 0
if eq j 0
put reply 8 xor get reply 8 1
end
end
end
end
if not pp_check reply got code
pp_text pp_bad
pp_num op
pp_text pp_nl
pp_num j
pp_text pp_nl
ret 1
end
end
end
if ne get mode 0 116
pp_text pp_op
pp_num op
pp_text pp_form
pp_num form
pp_text pp_ok
pp_num 1024
pp_text pp_yes
pp_num yes
pp_text pp_no
pp_num sub 1024 yes
pp_text pp_nl
end
end
end
er = pp_edges ulong get mode 0
if ne er 0
ret 1
end
if ne get mode 0 116
r = read 0 reply 0 1
if ne r 0
ret 2
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Compose after bw_enc_sm121.om. Host only. No device and no new instruction forms.
note t emits 128-byte records for the existing C test adapter, c checks its 24-byte responses.
note Each opcode 0..78 has eight operand forms, each with 1024 register/control/predicate samples.
note Form bits: uniform-source selector, absent src2, absent src3. Samples also vary absent dst, src1 and ureg.
note The oracle adapter only marshals fields and calls the independent C encoder.
text pp_ok " parity samples="
text pp_yes " accepted="
text pp_no " refused="
text pp_op "op="
text pp_form " form="
text pp_nl "\n"
text pp_bad "ENCODER PARITY FAIL\n"
fn pp_num n ulong to void
b = new uchar 32 0
v = n
pos = ulong 32
while true bound 32
pos = sub pos 1
put b pos uchar add rem v 10 48
v = div v 10
if eq v 0
break
end
end
r = write 2 b pos sub 32 pos
if ne r long sub 32 pos
exit 2
end
end
fn pp_text b view uchar * to void
r = write 2 b 0 len b
if ne r long len b
exit 2
end
end
fn pp_case a edit ulong 16 op ulong j ulong to void
for k ulong 16
put a k 0
end
reg = mul and shr j 3 31 4
put a 0 op
put a 1 reg
if isuld op
put a 1 rem reg 32
end
put a 2 reg
put a 3 add reg 2
put a 4 add reg 4
put a 5 rem j 32
put a 6 and j 31
if eq op 54
put a 6 add and j 31 2
end
if or eq op 18 eq op 29
put a 6 and j 255
end
if eq op 51
put a 6 and j 255
end
if ne and j 8 0
put a 7 mul j 256
end
form = shr j 10
put a 8 and form 1
if ne rem j 3 0
put a 9 1
end
if eq rem j 3 2
put a 10 1
end
put a 11 and shr j 6 15
note Absent operands exercise RZ/default routing independently of the physical register samples.
if ne and form 2 0
put a 3 18446744073709551615
end
if ne and form 4 0
put a 4 18446744073709551615
end
if ne and j 64 0
put a 2 18446744073709551615
end
if ne and j 128 0
put a 1 18446744073709551615
end
if ne and j 256 0
put a 5 18446744073709551615
end
end
fn pp_pack a view ulong 16 ins edit ulong 8192 to void
for k ulong 6
put ins k get a k
end
put ins 6 or get a 6 shl get a 7 32
f = or get a 8 shl get a 9 1
f = or f shl get a 10 2
f = or f shl get a 11 8
for k ulong 4
f = or f shl get a add k 12 add 16 mul k 8
end
put ins 7 f
end
fn pp_tape a view ulong 16 to void
b = new uchar 128 0
for k ulong 16
for h ulong 8
put b add mul k 8 h uchar and shr get a k mul h 8 255
end
end
n = write 1 b 0 128
if ne n 128
exit 2
end
end
fn pp_read b edit uchar 24 to void
n = ulong 0
while lt n 24 bound 24
r = read 0 b n sub 24 n
if le r 0
exit 2
end
n = add n ulong r
end
end
fn pp_check b view uchar 24 got ulong code view uchar 16384 to bool
if eq got 16
for k ulong 8
if ne get b k 0
ret false
end
end
for k ulong 16
if ne get b add k 8 get code k
ret false
end
end
else
for k ulong 8
if ne get b k 255
ret false
end
end
end
ret true
end
fn main to int
mode = new uchar 8 0
a = new ulong 16 0
ins = new ulong 8192 0
phys = new ulong 288 0
code = new uchar 16384 0
reply = new uchar 24 0
r = argread 1 mode 0 8
if lt r 1
ret 2
end
for k ulong 256
put phys k k
end
for k ulong 32
put phys add k 256 k
end
for op ulong 79
for form ulong 8
yes = ulong 0
for j ulong 1024
pp_case a op add mul form 1024 j
if eq get mode 0 116
pp_tape a
else
pp_pack a ins
got = bw_enc_sm121 ins phys 1 0 code
if eq got 16
yes = add yes 1
end
pp_read reply
if eq get mode 0 114
if eq op 0
if eq form 0
if eq j 0
put reply 8 xor get reply 8 1
end
end
end
end
if not pp_check reply got code
pp_text pp_bad
pp_num op
pp_text pp_nl
pp_num j
pp_text pp_nl
ret 1
end
end
end
if ne get mode 0 116
pp_text pp_op
pp_num op
pp_text pp_form
pp_num form
pp_text pp_ok
pp_num 1024
pp_text pp_yes
pp_num yes
pp_text pp_no
pp_num sub 1024 yes
pp_text pp_nl
end
end
end
if ne get mode 0 116
r = read 0 reply 0 1
if ne r 0
ret 2
end
end
ret 0
end

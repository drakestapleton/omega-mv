note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One instruction: LDG.E R2, desc[UR8][R30.64+64]. No padding or kernel builder.
note Compose after bw_enc_sm121.om. No args emits one 128-byte C-adapter record.
note An argument emits status zero plus the seeded four words, 24 bytes total.
fn lm_word b edit uchar 128 pos ulong value ulong n ulong to void
for h ulong n
put b add pos h uchar and shr value mul h 8 255
end
end
fn main to int
a = new ulong 16 0
o = new ulong 16 0
w = new ulong 4 0
b = new uchar 128 0
put a 0 11
put a 1 2
put a 2 30
put a 5 8
put a 6 64
if gt argcnt 1
for k ulong 8
put o k get a k
end
put o 12 1
put o 14 1
put o 15 1
if ne enc1 o w 0
ret 1
end
for k ulong 4
pos = add 8 mul k 4
lm_word b pos get w k 4
end
r = write 1 b 0 24
if ne r 24
ret 2
end
else
for k ulong 16
pos = mul k 8
lm_word b pos get a k 8
end
r = write 1 b 0 128
if ne r 128
ret 2
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note guard_spec_test.om: the spec encoder sp_enc (om/encoder/bw_spec_sm121.om, used by om/components/encode.om
note bc_encode for the q38 and validate paths) must match enc1 on the guard predicate (DRA-483, C1b).
note Concatenate after bw_enc_sm121.om and bw_spec_sm121.om; mk/om-encoder.mk test-om-encoder-guard compiles it.
note enc1's guards are pinned by guard_pred_test.om and the nvdisasm oracle; this gate carries them to sp_enc.
note Every op 0..59 (the spec's coverage) is encoded unpredicated, @P0 and @!P0 with R4 <- R8, R12, R16, UR4 (imm 2
note for BRA and BSSY, else 0) by both encoders: both must accept or both refuse, and accepted words must be equal.
note Prints one line per differing form (op, form 0 none / 1 @P0 / 2 @!P0), then the count; exit 0 when none, else 1.
text gsm1 "FAIL spec op "
text gsm2 " form "
text gsm3 "spec guard mismatches: "
text gsnl "\n"

fn gs_o op ulong f ulong o edit ulong 16 to void
for j ulong 16
put o j 0
end
put o 0 op
put o 1 4
put o 2 8
put o 3 12
put o 4 16
put o 5 4
if eq op 35
note FSEL's src3 is its predicate selector, P0..P7 (the spec bounds it at 7; enc1 keeps its low 3 bits)
put o 4 0
end
if or eq op 46 eq op 54
put o 6 2
end
put o 12 1
put o 13 1
put o 14 1
put o 15 1
if ne f 0
put o 9 1
end
if eq f 2
put o 10 1
end
end

fn gs_dec x ulong to void
b = new uchar 20 0
i = ulong 20
v = x
c = true
while c bound 20
i = sub i 1
put b i uchar add 48 rem v 10
v = div v 10
if eq v 0
c = false
end
end
k = write 1 b i sub 20 i
end

fn gs_same a view ulong 4 b view ulong 4 to bool
for k ulong 4
if ne get a k get b k
ret false
end
end
ret true
end

note 1 when enc1 and sp_enc disagree on op with form f
fn gs_one st edit ulong 3001 op ulong f ulong to ulong
o = new ulong 16 0
a = new ulong 4 0
b = new ulong 4 0
gs_o op f edit o
r1 = enc1 view o edit a
r2 = sp_enc st view o edit b
if ne eq r1 0 eq r2 0
ret 1
end
if ne r1 0
ret 0
end
if gs_same view a view b
ret 0
end
ret 1
end

fn main to int
st = new ulong 3001 0
bad = ulong 0
for op ulong 60
for f ulong 3
if ne gs_one edit st op f 0
k = write 1 gsm1 0 len gsm1
gs_dec op
k = write 1 gsm2 0 len gsm2
gs_dec f
k = write 1 gsnl 0 1
bad = add bad 1
end
end
end
k = write 1 gsm3 0 len gsm3
gs_dec bad
k = write 1 gsnl 0 1
if ne bad 0
ret 1
end
ret 0
end

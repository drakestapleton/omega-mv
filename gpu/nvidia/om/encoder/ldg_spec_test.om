note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Compose bw_enc_sm121.om, bw_spec_sm121.om, then this file.
note Constants are the nine accepted/refused offset cases of ldg_offset_test.om.
note A second argument removes the spec offset field: byte parity must fail.
fn ls_same a view ulong 4 b view ulong 4 to bool
for k ulong 4
if ne get a k get b k
ret false
end
end
ret true
end
fn main to int
state = new ulong 3001 0
o = new ulong 16 0
w = new ulong 4 0
ref = new ulong 4 0
cases = new ulong 9 0
put cases 1 64
put cases 2 4293918720
put cases 3 8388607
put cases 4 4286578688
put cases 5 8388608
put cases 6 4286578687
put cases 7 2147483647
put cases 8 2147483648
sp_init state
if gt argcnt 1
set_hdr state 14 11 0 991744 3
end
put o 0 11
put o 1 2
put o 2 30
put o 5 8
put o 12 1
put o 14 1
put o 15 1
for i ulong 9
put o 6 get cases i
a = enc1 o ref
b = sp_enc state o w
if eq a 0
if ne b E_OK
ret 1
end
if not ls_same w ref
ret 1
end
else
if ne b E_RANGE
ret 1
end
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note atomg_min_test.om: gate for BlackwellIR op 64, ATOMG.E.MIN.64.STRONG.SYS, of the seeded encoder (the Omega NG
note kernel trap word). Concatenate after bw_enc_sm121.om; mk/om-encoder.mk test-om-encoder-atomg compiles it with
note the pinned omc.
note No arguments: three rows through enc1 must give exactly the words below. Exit 0, else 10+r for row r.
note One argument: write the three instructions (48 bytes) on stdout for the ORACLE.
note Two arguments: read the ORACLE's text on stdin and require the three lines of amnd in order.
note Exit 0, 4 when a line is missing or out of order, 70 on a read error, 71 when the text is too long.
note ORACLE (independent, not first-party, never shipped): NVIDIA nvdisasm 13.0.85 -b SM121 -hex. Its decode of the
note type field (evidence/atomg-min-20261107/atomg_field_probe_nvdisasm.txt): 2 = .64, 3 = .S64.
note Rows (dst, src1, src2, ureg; dst absent encodes RZ) and words, decimal by Wolfram:
note   R4, R2, R6, UR8:     33847720 = 0x020479a8, 2147483654 = 0x80000006, 144659720 = 0x089f5508
note   RZ, R2, R6, UR8:     50297256 = 0x02ff79a8, 2147483654 = 0x80000006, 144659720 = 0x089f5508
note   R10, R12, R14, UR4: 202013096 = 0x0c0a79a8, 2147483662 = 0x8000000e, 144659716 = 0x089f5504
note   w3 of every row: 3284480 = 0x00321e00.
text amnd "ATOMG.E.MIN.64.STRONG.SYS PT, R4, desc[UR8][R2.64], R6 ;|ATOMG.E.MIN.64.STRONG.SYS PT, RZ, desc[UR8][R2.64], R6 ;|ATOMG.E.MIN.64.STRONG.SYS PT, R10, desc[UR4][R12.64], R14 ;|"
global am_in ulong 15
global am_w ulong 9

fn am_init to void
put am_in 0 4
put am_in 1 2
put am_in 2 6
put am_in 3 8
put am_in 4 1
put am_in 5 0
put am_in 6 2
put am_in 7 6
put am_in 8 8
put am_in 9 0
put am_in 10 10
put am_in 11 12
put am_in 12 14
put am_in 13 4
put am_in 14 1
put am_w 0 33847720
put am_w 1 2147483654
put am_w 2 144659720
put am_w 3 50297256
put am_w 4 2147483654
put am_w 5 144659720
put am_w 6 202013096
put am_w 7 2147483662
put am_w 8 144659716
end

note encode row r (dst, src1, src2, ureg, dst present) into w; enc1's result (0 accepted)
fn am_enc r ulong w edit ulong 4 to ulong
o = new ulong 16 0
b = mul r 5
put o 0 64
put o 1 get am_in b
put o 2 get am_in add b 1
put o 3 get am_in add b 2
put o 5 get am_in add b 3
put o 15 get am_in add b 4
ret enc1 view o w
end

fn am_words w view ulong 4 r ulong to bool
b = mul r 3
if ne get w 0 get am_w b
ret false
end
if ne get w 1 get am_w add b 1
ret false
end
if ne get w 2 get am_w add b 2
ret false
end
ret eq get w 3 3284480
end

fn am_rows to int
w = new ulong 4 0
for r ulong 3
if ne am_enc r edit w 0
ret int add 10 r
end
if not am_words view w r
ret int add 10 r
end
end
ret 0
end

fn am_bin to int
w = new ulong 4 0
code = new uchar 16384 0
for r ulong 3
if ne am_enc r edit w 0
ret int add 10 r
end
store edit code r view w
end
off = ulong 0
while lt off 48
n = write 1 code off sub 48 off
if le n 0
ret 3
end
off = add off ulong n
end
ret 0
end

note does needle amnd[s..e) start at buf[i]? The caller keeps i + e - s within the text.
fn am_at buf view uchar 65536 i ulong s ulong e ulong to bool
for j ulong sub e s
if ne get buf add i j get amnd add s j
ret false
end
end
ret true
end

note the end of the first match of amnd[s..e) in buf[i..n), or n+1 when absent
fn am_find buf view uchar 65536 n ulong i ulong s ulong e ulong to ulong
while le add i sub e s n
if am_at buf i s e
ret add i sub e s
end
i = add i 1
end
ret add n 1
end

fn am_check to int
buf = new uchar 65536 0
n = ulong 0
while lt n 65536
k = read 0 buf n sub 65536 n
if lt k 0
ret 70
end
if eq k 0
break
end
n = add n ulong k
end
if eq n 65536
ret 71
end
pos = ulong 0
s = ulong 0
for e ulong len amnd
if eq get amnd e 124
pos = am_find view buf n pos s e
if gt pos n
ret 4
end
s = add e 1
end
end
ret 0
end

fn main to int
am_init
if gt argcnt 3
ret 64
end
if eq argcnt 3
ret am_check
end
if eq argcnt 2
ret am_bin
end
ret am_rows
end

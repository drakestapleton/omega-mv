note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One 128-wide FP8 e4m3 block product. w is the weight row, x is f32 bits, sc is bf16 bits.
note The sum is left-associative f64, one rounding per mul and add. Returns the f64 bits.

fn refb b uint to f32
s = and b 128
e = and shr b 3 15
m = and b 7
if and eq e 15 eq m 7
ret bitcast f32 uint 2143289344
end
if eq e 0
z = mul f32 m bitcast f32 shl sub uint 127 9 23
if ne s 0
ret bitcast f32 xor bitcast uint z shl uint 1 31
end
ret z
end
base = add bitcast f32 shl uint 127 23 div f32 m 8.0f32
val = mul base bitcast f32 shl add uint 120 e 23
if ne s 0
ret bitcast f32 xor bitcast uint val shl uint 1 31
end
ret val
end

fn u32le x view uchar 512 i ulong to uint
o = mul i 4
b0 = uint get x o
b1 = uint get x add o 1
b2 = uint get x add o 2
b3 = uint get x add o 3
ret or or or b0 shl b1 8 shl b2 16 shl b3 24
end

fn apishb w view uchar 128 x view uchar 512 sc uint to ulong
sf = bitcast f32 shl and sc 65535 16
sd = f64 sf
acc = 0.0f64
for i ulong 128
rd = f64 refb uint get w i
xd = f64 bitcast f32 u32le x i
acc = add acc mul mul rd xd sd
end
ret bitcast ulong acc
end

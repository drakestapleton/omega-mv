note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The caller acquires native table pointers; Omega walks each plain table.
note Preserve the cut-F float polynomial, scalar order and empty-split handling.
fn av_ex2 x f32 to f32
if le x f32 -127.0
ret f32 0.0
end
if gt x f32 127.0
x = f32 127.0
end
adj = f32 0.5
if lt x f32 0.0
adj = f32 -0.5
end
n = int add x adj
f = sub x f32 n
px = f32 1.535336188319500e-4
px = add mul px f f32 1.339887440266574e-3
px = add mul px f f32 9.618437357674640e-3
px = add mul px f f32 5.550332471162809e-2
px = add mul px f f32 2.402264791363012e-1
px = add mul px f f32 6.931472028550421e-1
px = add f32 1.0 mul f px
if lt n -126
px = mul px f32 0.5
n = int -126
end
ret mul px bitcast f32 shl uint add n 127 23
end
fn av_fw p view f32 * q view ulong 16 row ulong w edit f32 18 to ulong
pw = add get q 2 2
base = mul row get q 1
base = mul base pw
mx = bitcast f32 uint 4286578688
for s ulong get q 1
idx = mul s pw
idx = add idx base
idx = add idx get q 2
v = get p idx
if gt v mx
mx = v
end
end
put w 17 f32 0.0
if not gt mx bitcast f32 uint 4286578688
ret 0
end
put w 17 f32 1.0
lsum = f32 0.0
for s ulong get q 1
idx = mul s pw
idx = add idx base
idx = add idx get q 2
v = get p idx
v = av_ex2 sub v mx
put w s v
idx = add idx 1
v = mul v get p idx
lsum = add lsum v
end
put w 16 div f32 1.0 lsum
ret 0
end
fn av_fval p view f32 * w view f32 18 q view ulong 4 d ulong to f32
if not gt get w 17 f32 0.0
ret f32 0.0
end
base = mul get q 3 get q 1
base = mul base add get q 2 2
a = f32 0.0
for s ulong get q 1
idx = mul s add get q 2 2
idx = add idx base
idx = add idx d
v = get p idx
v = mul get w s v
a = add a v
end
ret mul a get w 16
end
fn av_fout p view f32 * dest edit f32 * w view f32 18 q view ulong 4 to void
for d ulong get q 2
v = av_fval p w q d
idx = mul get q 3 get q 2
idx = add idx d
put dest idx v
end
end
fn vc_fold p view f32 * dest edit f32 * q view ulong 16 to ulong
w = new f32 18 0.0
r = new ulong 4 0
put r 0 get q 0
put r 1 get q 1
put r 2 get q 2
for jj ulong get q 7
row = add get q 6 jj
rc = av_fw p q row w
if ne rc 0
ret rc
end
put r 3 row
av_fout p dest w r
end
ret 0
end
fn av_fold p view f32 * dest edit f32 * q view ulong 16 to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div get q 0 1000000 1
put z 6 mul bb 1000000
cnt = sub get q 0 get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
rc = vc_fold p dest z
if ne rc 0
ret rc
end
end
ret 0
end

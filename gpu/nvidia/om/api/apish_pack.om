note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note FP8 e4m3 pack decisions. Bits in, bits out.
note op 1 ref bits, 2 kernel bits, 3 nan, 4 scale fold, 5 x f32 fold, 6 x bf16 fold.
note NaN is only exponent 15 and mantissa 7. Subnormals are the integer mantissa times 2^-9.
note Scale fold is bf16 bits times 2^56, refused when the magnitude exceeds 3.0e38.
note A refusal sets bit 32. A success returns the f32 bits.

fn refb b uint to uint
s = and b 128
e = and shr b 3 15
m = and b 7
if and eq e 15 eq m 7
ret 2143289344
end
if eq e 0
z = mul f32 m bitcast f32 shl sub uint 127 9 23
if ne s 0
ret xor bitcast uint z shl uint 1 31
end
ret bitcast uint z
end
base = add bitcast f32 shl uint 127 23 div f32 m 8.0f32
val = mul base bitcast f32 shl add uint 120 e 23
if ne s 0
ret xor bitcast uint val shl uint 1 31
end
ret bitcast uint val
end

fn kbits b uint to uint
ret or shl and b 127 20 shl and b 128 24
end

fn isnanb b uint to uint
if eq and b 127 127
ret 1
end
ret 0
end

fn scalef b uint mut uint to ulong
f = bitcast f32 shl b 16
if not le fabs f 3.0e38f32
ret shl ulong 1 32
end
fold = bitcast f32 shl add uint 127 56 23
if ne mut 0
fold = bitcast f32 shl uint 127 23
end
g = mul f fold
if not le fabs g 3.0e38f32
ret shl ulong 1 32
end
ret ulong bitcast uint g
end

fn xfold u uint exp uint to uint
ret bitcast uint mul bitcast f32 u bitcast f32 shl add uint 127 exp 23
end

fn apishk op uint a uint b uint c uint d uint e uint to ulong
if eq op 1
ret ulong refb a
end
if eq op 2
ret ulong kbits a
end
if eq op 3
ret ulong isnanb a
end
if eq op 4
ret scalef a b
end
if eq op 5
ret ulong xfold a 64
end
if eq op 6
ret ulong xfold bitcast uint bitcast f32 shl a 16 64
end
ret shl ulong 1 32
end

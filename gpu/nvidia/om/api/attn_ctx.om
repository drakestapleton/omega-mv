om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Signed int32 input travels as uint bits; nonpositive contexts become empty.
note Inner traversal blocks preserve the checked one-million-iteration guard.
fn vc_ctx s view uint * d edit uint * q view ulong 4 to ulong
for zzj ulong get q 1
i = add get q 0 zzj
v = get s i
if ge v 2147483648
v = uint 0
end
put d i v
end
ret 0
end

fn av_ctx s view uint * d edit uint * n ulong to ulong
q = new ulong 4 0
r = ulong 0
for zzb ulong add div n 1000000 1
put q 0 mul zzb 1000000
zzn = sub n get q 0
if gt zzn 1000000
zzn = ulong 1000000
end
put q 1 zzn
rr = vc_ctx s d q
r = rr
end
ret r
end

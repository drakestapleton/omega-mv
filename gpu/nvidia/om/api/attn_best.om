note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_best s view uint * zz view ulong 4 hd ulong to ulong
r = ulong 0
p = new ulong 16 0
put p 1 hd
for jj ulong get zz 1
i = add get zz 0 jj
put p 0 ulong get s i
rc = api_at_plan 3 p
if ne rc 0
ret 0
end
if gt get p 8 r
r = get p 8
end
end
ret r
end
fn av_best s view uint * n ulong hd ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 0
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_best s zz hd
if gt rr r
r = rr
end
end
ret r
end

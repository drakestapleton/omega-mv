note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_gath s view uchar * d edit uchar * q view ulong 16 to ulong
r = new ulong 4 0
put r 2 get q 2
for jj ulong get q 7
t = add get q 6 jj
for h ulong get q 1
src = mul t get q 3
dst = mul h get q 4
src = add src dst
src = mul src get q 5
dst = mul t get q 1
dst = add dst h
dst = mul dst get q 2
put r 0 src
put r 1 dst
av_cseg s d r
end
end
ret 0
end
fn av_gath s view uchar * d edit uchar * q view ulong 16 to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div get q 0 1000000 1
put z 6 mul bb 1000000
cnt = sub get q 0 get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
rc = vc_gath s d z
if ne rc 0
ret rc
end
end
ret 0
end

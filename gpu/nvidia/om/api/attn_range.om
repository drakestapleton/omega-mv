note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_range q view ulong 16 d edit uint * zz view ulong 4 to ulong
r = new ulong 16 0
for j ulong 5
put r j get q j
end
for jj ulong get zz 1
i = add get zz 0 jj
put r 0 add get q 0 i
rc = api_at_plan 10 r
if ne rc 0
ret rc
end
put d i uint get r 8
put d add get zz 2 i uint get r 9
end
ret 0
end
fn av_range q view ulong 16 d edit uint * n ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 0
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_range q d zz
if ne rr 0
ret rr
end
end
ret r
end

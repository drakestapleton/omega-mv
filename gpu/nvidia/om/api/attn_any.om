om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Inner traversal blocks preserve the checked one-million-iteration guard.
fn vc_any s view uint * q view ulong 4 to ulong
r = ulong 0
for zzj ulong get q 1
i = add get q 0 zzj
r = or r ulong get s i
end
ret r
end

fn av_any s view uint * n ulong to ulong
q = new ulong 4 0
r = ulong 0
for zzb ulong add div n 1000000 1
put q 0 mul zzb 1000000
zzn = sub n get q 0
if gt zzn 1000000
zzn = ulong 1000000
end
put q 1 zzn
rr = vc_any s q
r = or r rr
end
ret r
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_seg s view uchar * d edit uchar * r view ulong 4 start ulong to void
cnt = sub get r 2 start
if gt cnt 1000000
cnt = ulong 1000000
end
for j ulong cnt
b = add start j
idx = add get r 0 b
v = get s idx
idx = add get r 1 b
put d idx v
end
end
fn av_cseg s view uchar * d edit uchar * r view ulong 4 to void
for bb ulong add div get r 2 1000000 1
vc_seg s d r mul bb 1000000
end
end

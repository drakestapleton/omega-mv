note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_total eff view uint * zz view ulong 4 bs ulong to ulong
r = ulong 0
for jj ulong get zz 1
i = add get zz 0 jj
v = ulong get eff i
if ne v 0
r = add r div add v sub bs 1 bs
end
end
ret r
end
fn av_total eff view uint * n ulong bs ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 0
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_total eff zz bs
r = add r rr
end
ret r
end

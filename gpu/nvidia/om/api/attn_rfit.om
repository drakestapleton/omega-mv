note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_rfit ids view uint * q view ulong 16 zz view ulong 4 to ulong
p = new ulong 16 0
for jj ulong get zz 1
i = add get zz 0 jj
v = ulong get ids i
put p 0 get q 0
put p 1 v
put p 2 get q 1
rc = api_at_plan 24 p
if or ne rc 0 eq get p 8 0
ret 0
end
end
ret 1
end
fn av_rfit ids view uint * q view ulong 16 n ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 1
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_rfit ids q zz
if eq rr 0
ret 0
end
end
ret r
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn ar_abs u ulong to ulong
x = bitcast f64 u
if lt x 0.0
ret bitcast ulong neg x
end
ret u
end
note q = row, column, k, n; preserve double operation order and float maxima.
fn ar_term a view ushort * b view ushort * q view ulong 6 t ulong to ulong
x = f64 bitcast f32 shl uint get a add mul get q 0 get q 2 t 16
y = f64 bitcast f32 shl uint get b add mul t get q 3 get q 1 16
ret bitcast ulong mul x y
end
fn ar_seg a view ushort * b view ushort * q view ulong 6 d edit ulong 2 to ulong
for z ulong get q 5
p = bitcast f64 ar_term a b q add get q 4 z
put d 0 bitcast ulong add bitcast f64 get d 0 p
put d 1 bitcast ulong add bitcast f64 get d 1 bitcast f64 ar_abs bitcast ulong p
end
ret 0
end
fn ar_dot a view ushort * b view ushort * q view ulong 4 d edit ulong 2 to ulong
qq = new ulong 6 0
for i ulong 4
put qq i get q i
end
put d 0 bitcast ulong f64 0.0
put d 1 bitcast ulong f64 0.0
for bb ulong add div get q 2 1000000 1
put qq 4 mul bb 1000000
cnt = sub get q 2 get qq 4
if gt cnt 1000000
cnt = ulong 1000000
end
put qq 5 cnt
rc = ar_seg a b qq d
if ne rc 0
ret rc
end
end
ret 0
end
fn ar_err d view ulong 2 c uint z edit ulong 4 to ulong
diff = bitcast f64 ar_abs bitcast ulong sub bitcast f64 get d 0 f64 bitcast f32 c
scale = bitcast f64 get d 1
if not gt scale 0.000001
scale = f64 0.000001
end
rel = div diff scale
if gt f32 diff bitcast f32 uint get z 0
put z 0 ulong bitcast uint f32 diff
end
if gt f32 rel bitcast f32 uint get z 1
put z 1 ulong bitcast uint f32 rel
end
if gt rel 0.00001
put z 2 add get z 2 1
end
if eq get z 2 0
put z 3 1
else
put z 3 0
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_max s view uint * zz view ulong 4 to ulong
r = ulong 1
for jj ulong get zz 1
i = add get zz 0 jj
if gt ulong get s i r
r = ulong get s i
end
end
ret r
end
fn av_max s view uint * n ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 1
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_max s zz
if gt rr r
r = rr
end
end
ret r
end
note Preserve the cut-F float polynomial, scalar order and empty-split handling.

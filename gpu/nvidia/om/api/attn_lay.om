note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn av_lay p view ulong 32 a edit uint 32 mask ulong to ulong
i = ulong 0
while lt i 32
v = get p i
put a i uint and v 4294967295
if ne and shr mask i 1 0
if eq i 31
ret 1
end
put a add i 1 uint shr v 32
i = add i 1
end
i = add i 1
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_eff nb view uint * d edit uint * bs ulong zz view ulong 4 to ulong
p = new ulong 16 0
put p 2 bs
for jj ulong get zz 1
i = add get zz 0 jj
put p 0 ulong get d i
put p 1 ulong get nb i
rc = api_at_plan 15 p
if ne rc 0
ret rc
end
put d i uint get p 8
end
ret 0
end
fn av_eff nb view uint * d edit uint * bs ulong to ulong
zz = new ulong 4 0
for bb ulong add div len nb 1000000 1
put zz 0 mul bb 1000000
cnt = sub len nb get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rc = vc_eff nb d bs zz
if ne rc 0
ret rc
end
end
ret 0
end

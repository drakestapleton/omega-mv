note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_hmap d edit uint * q view ulong 16 to ulong
p = new ulong 16 0
for j ulong 5
put p j get q j
end
for jj ulong get q 7
i = add get q 6 jj
put p 0 i
rc = api_at_plan 25 p
if ne rc 0
ret rc
end
put d i uint get p 8
end
ret 0
end
fn av_hmap d edit uint * q view ulong 16 to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div get q 1 1000000 1
put z 6 mul bb 1000000
cnt = sub get q 1 get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
rc = vc_hmap d z
if ne rc 0
ret rc
end
end
ret 0
end

fn vc_table tab edit uint * slots edit uint * q view ulong 16 g ulong to ulong
for jj ulong get q 7
b = add get q 6 jj
id = get tab b
v = uint g
if eq get q 1 2
v = id
else
if ne get q 1 0
if ge get slots ulong id 2147483648
put slots ulong id uint g
g = add g 1
end
v = uint get slots ulong id
else
g = add g 1
end
end
put tab b v
end
ret g
end
fn av_table tab edit uint * slots edit uint * q view ulong 16 g ulong to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div len tab 1000000 1
put z 6 mul bb 1000000
cnt = sub len tab get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
g = vc_table tab slots z g
end
ret g
end

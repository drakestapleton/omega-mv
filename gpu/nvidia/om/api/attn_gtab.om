note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_gtab s view uint * tab edit uint * q view ulong 16 which ulong to ulong
for jj ulong get q 7
i = add get q 6 jj
if eq which 0
put tab mul i 4 get s i
v = add get q 1 mul i get q 2
v = and v 4294967295
put tab add mul i 4 2 uint v
put tab add mul i 4 3 uint 0
else
put tab add mul i 4 1 get s i
end
end
ret 0
end
fn av_gtab s view uint * tab edit uint * q view ulong 16 which ulong to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div get q 0 1000000 1
put z 6 mul bb 1000000
cnt = sub get q 0 get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
rc = vc_gtab s tab z which
if ne rc 0
ret rc
end
end
ret 0
end

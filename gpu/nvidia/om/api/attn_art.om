om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn ar_rd b view uchar * o ulong n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl ulong get b add o i mul i 8
end
ret v
end
fn ar_eq b view uchar * off ulong s view uchar * to bool
if gt off len b
ret false
end
if gt len s sub len b off
ret false
end
for i ulong len s
if ne get b add off i get s i
ret false
end
end
ret true
end
fn ar_sect b view uchar * sh ulong str view ulong 2 fnm view uchar * to bool
name = ar_rd b sh 4
if ge name get str 1
ret false
end
off = add get str 0 name
left = sub get str 1 name
if le left add len fnm 6
ret false
end
if ne get b off 46
ret false
end
if ne get b add off 1 116
ret false
end
if ne get b add off 2 101
ret false
end
if ne get b add off 3 120
ret false
end
if ne get b add off 4 116
ret false
end
if ne get b add off 5 46
ret false
end
if not ar_eq b add off 6 fnm
ret false
end
ret eq get b add add off 6 len fnm 0
end
fn ar_data b view uchar * sh ulong txt view uchar * to bool
off = ar_rd b add sh 24 8
sz = ar_rd b add sh 32 8
if or gt off len b ne sz len txt
ret false
end
ret ar_eq b off txt
end
fn ar_cubin b view uchar * fnm view uchar * txt view uchar * to bool
if lt len b 64
ret false
end
if ne ar_rd b 0 4 1179403647
ret false
end
if ne ar_rd b 18 2 190
ret false
end
shoff = ar_rd b 40 8
num = ar_rd b 60 2
idx = ar_rd b 62 2
if or ne ar_rd b 58 2 64 or eq num 0 ge idx num
ret false
end
if gt shoff len b
ret false
end
if gt mul num 64 sub len b shoff
ret false
end
str = new ulong 2 0
put str 0 ar_rd b add add shoff mul idx 64 24 8
put str 1 ar_rd b add add shoff mul idx 64 32 8
if gt get str 0 len b
ret false
end
if gt get str 1 sub len b get str 0
ret false
end
note snprintf want[128] requires 6-byte prefix plus fn plus terminator to fit.
if ge add len fnm 6 128
ret false
end
for i ulong num
sh = add shoff mul i 64
if ar_sect b sh str fnm
ret ar_data b sh txt
end
end
ret false
end
fn ar_layout b view uchar * keys view uchar * cap ulong to bool
if ge len b cap
ret false
end
for i ulong len b
if or eq get b i 0 eq get b i 13
ret false
end
end
pos = ulong 0
idx = ulong 0
first = true
while lt idx len keys
if eq get keys idx 0
idx = add idx 1
continue
end
while ne get keys idx 0
if ge pos len b
ret false
end
if ne get keys idx get b pos
ret false
end
idx = add idx 1
pos = add pos 1
end
idx = add idx 1
if first
first = false
else
while lt pos len b
c = get b pos
pos = add pos 1
if eq c 10
break
end
end
if eq pos 0
ret false
end
if ne get b sub pos 1 10
ret false
end
end
end
ret eq pos len b
end
fn ar_version h view uint 3 n view uint 3 to bool
for i ulong 3
if ne get h i get n i
ret gt get h i get n i
end
end
ret true
end
fn ar_json c uchar d edit uchar 6 to ulong
if or eq c 34 eq c 92
put d 0 92
put d 1 c
ret 2
end
if or lt c 32 eq c 127
put d 0 92
put d 1 117
put d 2 48
put d 3 48
v = shr c 4
if gt v 9
v = add v 87
else
v = add v 48
end
put d 4 v
v = and c 15
if gt v 9
v = add v 87
else
v = add v 48
end
put d 5 v
ret 6
end
put d 0 c
ret 1
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Inner traversal blocks preserve the checked one-million-iteration guard.
fn vc_rows d edit uint * q view ulong 4 base ulong to ulong
for zzj ulong get q 1
i = add get q 0 zzj
put d i uint 0
v = and add add base i 1 4294967295
put d add get q 2 i uint v
end
ret 0
end

fn av_rows d edit uint * n ulong base ulong to ulong
q = new ulong 4 0
r = ulong 0
for zzb ulong add div n 1000000 1
put q 0 mul zzb 1000000
zzn = sub n get q 0
if gt zzn 1000000
zzn = ulong 1000000
end
put q 1 zzn
put q 2 n
rr = vc_rows d q base
r = rr
end
ret r
end

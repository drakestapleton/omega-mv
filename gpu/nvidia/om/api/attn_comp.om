om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Inner traversal blocks preserve the checked one-million-iteration guard.
fn vc_comp s view uint * d edit uint * q view ulong 4 to ulong
j = get q 2
for zzj ulong get q 1
i = add get q 0 zzj
v = get s i
if lt v 2147483648
put d j uint v
j = add j 1
end
end
ret j
end

fn av_comp s view uint * d edit uint * n ulong to ulong
q = new ulong 4 0
r = ulong 0
for zzb ulong add div n 1000000 1
put q 0 mul zzb 1000000
zzn = sub n get q 0
if gt zzn 1000000
zzn = ulong 1000000
end
put q 1 zzn
put q 2 r
rr = vc_comp s d q
r = rr
end
ret r
end

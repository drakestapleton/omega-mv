round = bitcast f64 ulong 13826050856027422720
if ge fk bitcast f64 ulong 0
round = bitcast f64 ulong 4602678819172646912
end
k = long add fk round
kd = f64 k
r = sub sub y mul kd bitcast f64 ulong 4604418534311723008 mul kd bitcast f64 ulong 4461442080421002358
p = bitcast f64 ulong 4607182418800017408

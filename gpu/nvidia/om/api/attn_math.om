if gt m bitcast f64 ulong 4609047870845172685
m = mul m bitcast f64 ulong 4602678819172646912
e = add e 1
end
t = div sub m bitcast f64 ulong 4607182418800017408 add m bitcast f64 ulong 4607182418800017408
t2 = mul t t
s = bitcast f64 ulong 0
k = long 25
while ge k 1
s = add mul s t2 div bitcast f64 ulong 4607182418800017408 f64 k
k = sub k 2
end
x = mul f64 e bitcast f64 ulong 4461442080421002358
s = mul mul bitcast f64 ulong 4611686018427387904 t s
s = add s x
x = mul f64 e bitcast f64 ulong 4604418534311723008
ret add x s
end
fn av_exp y f64 to f64
if ne y y
ret y
end
if gt y bitcast f64 ulong 4649454506724284170
ret bitcast f64 ulong 9218868437227405312
end
if lt y bitcast f64 ulong 13873138101193906586
ret bitcast f64 ulong 0

end
fn av_pow base f64 e f64 to f64
if or eq base bitcast f64 ulong 4607182418800017408 eq e bitcast f64 ulong 0
ret bitcast f64 ulong 4607182418800017408
end
ret av_exp mul e av_log base
end
fn av_sinc a f64 dest edit ulong 2 to void
fnn = mul a bitcast f64 ulong 4603909380684499075
round = bitcast f64 ulong 13826050856027422720
if ge fnn bitcast f64 ulong 0
round = bitcast f64 ulong 4602678819172646912
end
n = long add fnn round
nd = f64 n
r = sub a mul nd bitcast f64 ulong 4609753056924401664
r = sub r mul nd bitcast f64 ulong 4454258360616747008
r = sub r mul nd bitcast f64 ulong 4297306550709518336
r = sub r mul nd bitcast f64 ulong 4142048980368378305
w = mul r r
ps = bitcast f64 ulong 4607182418800017408
k = long 15
while ge k 3
nd = f64 mul k sub k 1
ps = mul w ps
ps = div ps nd
ps = sub bitcast f64 ulong 4607182418800017408 ps
k = sub k 2
end
pc = bitcast f64 ulong 4607182418800017408
k = long 16
while ge k 2
nd = f64 mul k sub k 1
pc = mul w pc
pc = div pc nd
pc = sub bitcast f64 ulong 4607182418800017408 pc

put d idx f32 bitcast f64 get sc 0
else
put d idx f32 1.0
idx = add idx half
put d idx f32 0.0
end
end
end
fn vc_rope d edit f32 * q view ulong 16 to ulong
for j ulong get q 7
row = add get q 6 j
off = mul row get q 3
pos = add get q 0 row
av_rrow d q off pos
end
ret 0
end
fn av_attnrope d edit f32 * q view ulong 16 to ulong
z = new ulong 16 0
for j ulong 16
put z j get q j
end
for bb ulong add div get q 4 1000000 1
put z 6 mul bb 1000000
cnt = sub get q 4 get z 6
if gt cnt 1000000
cnt = ulong 1000000
end
put z 7 cnt
rc = vc_rope d z
if ne rc 0
ret rc
end
end
ret 0
end

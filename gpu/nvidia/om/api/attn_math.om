end
fn av_rrow d edit f32 * q view ulong 16 off ulong pos ulong to void
sc = new ulong 2 0
half = div get q 3 2
for i ulong half
idx = add off i
if lt i div get q 2 2
inv = f64 mul i 2
inv = neg inv
inv = div inv f64 get q 2
inv = av_pow bitcast f64 get q 1 inv
inv = mul f64 pos inv
av_sinc inv sc
put d idx f32 bitcast f64 get sc 1

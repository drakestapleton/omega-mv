note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Sixteen int8 trits, passed as bytes. 1, 0 and 255 (int8 -1) encode to 1, 0, 2.
note Any other byte returns bit 32 set. A legal word stays below 2^32.

fn apishr v view uchar 16 to ulong
word = ulong 0
for i ulong 16
b = get v i
code = uint 3
if eq b 1
code = 1
end
if eq b 255
code = 2
end
if eq b 0
code = 0
end
if eq code 3
ret shl ulong 1 32
end
word = or word shl ulong code mul i 2
end
ret word
end

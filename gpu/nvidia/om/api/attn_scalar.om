note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Decode uses the kernel's raw rounding for nonfinite values, unlike gx_f2bf NaN quieting.
fn av_drnd u uint to uint
if gx_fin u
ret gx_f2bf u
end
ret shr add add u 32767 and shr u 16 1 16
end
fn av_perm i uint r uint to uint
p = div r 2
if lt i 128
if lt i p
ret i
end
ret add r sub i p
end
j = sub i 128
if lt j p
ret add p j
end
ret i
end
fn av_permf s view f32 256 d edit f32 256 r uint to ulong
for i ulong 256
put d i get s ulong av_perm uint i r
end
ret 0
end
fn av_permb s view ushort 256 d edit ushort 256 r uint to ulong
for i ulong 256
put d i get s ulong av_perm uint i r
end
ret 0
end

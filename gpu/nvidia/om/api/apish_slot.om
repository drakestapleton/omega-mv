note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note FP8 slot step. rec: 0 state, 1 pins, 2 key, 3 version, 4 next_version, 5 mutant, 6 ok.
note rec 8 loads, 9 load_failures, 10 busy, 11 stale, 12 evictions, 13 pin count, 14 pinned_now, 15 pinned_high.
note op 1 begin, 2 finish (aux is key), 3 pin, 4 unpin, 5 evict, 6 idle. aux is the version for pin and unpin.

fn bump rec edit ulong 16 i ulong to void
put rec i add get rec i 1
end

fn begin rec edit ulong 16 to long
st = get rec 0
pins = get rec 1
if or eq st 1 and ne pins 0 eq get rec 5 0
bump rec 10
ret -6
end
put rec 0 1
ret 0
end

fn finish rec edit ulong 16 key ulong to long
if ne get rec 0 1
ret -1
end
if ne get rec 6 0
put rec 0 2
put rec 2 key
put rec 3 get rec 4
put rec 4 add get rec 4 1
bump rec 8
ret 0
end
put rec 0 0
put rec 2 0
bump rec 9
ret 0
end

fn pin rec edit ulong 16 ver ulong to long
if or ne get rec 0 2 or ne get rec 3 ver eq ver 0
bump rec 11
ret -7
end
put rec 1 add get rec 1 1
bump rec 13
put rec 14 add get rec 14 1
if gt get rec 14 get rec 15
put rec 15 get rec 14
end
ret 0
end

fn unpin rec edit ulong 16 ver ulong to long
if or eq get rec 1 0 and eq get rec 5 0 ne get rec 3 ver
ret -1
end
put rec 1 sub get rec 1 1
put rec 14 sub get rec 14 1
ret 0
end

fn evict rec edit ulong 16 to long
if or ne get rec 1 0 eq get rec 0 1
bump rec 10
ret -6
end
if eq get rec 0 2
bump rec 12
end
put rec 0 0
put rec 2 0
ret 0
end

fn idle rec edit ulong 16 to long
if or eq get rec 0 1 ne get rec 1 0
ret 0
end
ret 1
end
fn sentry rec edit ulong 16 ver ulong to long
if or ne get rec 0 2 or ne get rec 3 ver eq ver 0
ret -7
end
if eq get rec 1 0
ret -1
end
ret 0
end

fn apishl op ulong aux ulong rec edit ulong 16 to long
if eq op 1
ret begin rec
end
if eq op 2
ret finish rec aux
end
if eq op 3
ret pin rec aux
end
if eq op 4
ret unpin rec aux
end
if eq op 5
ret evict rec
end
if eq op 6
ret idle rec
end
if eq op 7
ret sentry rec aux
end
ret -1
end

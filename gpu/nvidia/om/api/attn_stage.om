note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn av_stage s view uchar * d edit uchar * ids view uint 16777216 q view ulong 16 to ulong
r = new ulong 4 0
put r 2 get q 3
for i ulong get q 0
src = ulong get ids i
src = mul src get q 1
src = add src get q 2
dst = add get q 4 i
dst = mul dst get q 3
put r 0 src
put r 1 dst
av_cseg s d r
end
ret 0
end

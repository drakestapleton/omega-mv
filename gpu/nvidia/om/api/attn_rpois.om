om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Inner traversal blocks preserve the checked one-million-iteration guard.
fn vc_rpois w view f32 * ids view uint * q view ulong 4 poison ulong to ulong
r = ulong 0
pv = bitcast f32 uint and poison 4294967295
pi = uint shr poison 32
for zzj ulong get q 1
i = add get q 0 zzj
if eq get w i pv
r = add r 1
else
if eq get ids i pi
r = add r 1
end
end
end
ret r
end

fn av_rpois w view f32 * ids view uint * n ulong poison ulong to ulong
q = new ulong 4 0
r = ulong 0
for zzb ulong add div n 1000000 1
put q 0 mul zzb 1000000
zzn = sub n get q 0
if gt zzn 1000000
zzn = ulong 1000000
end
put q 1 zzn
rr = vc_rpois w ids q poison
r = add r rr
end
ret r
end

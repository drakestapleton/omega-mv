om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q inputs rows, query heads, head dim, rows per launch, max blocks, has ids.
note q 10 is row cursor; q 11..22 describe one existing launch without new admission policy.
fn ah_plan q edit ulong 32 op uint to ulong
if eq op 0
v = and add uint get q 2 31 4294967264
put q 8 ulong v
put q 9 ulong mul v 16
ret 0
end
if eq op 1
put q 8 mul get q 1 get q 2
idw = ulong 1
if ne get q 5 0
idw = mul get q 3 get q 4
end
put q 9 add add mul get q 3 4 get q 1 idw
put q 10 0
ret 0
end
if eq op 3
put q 10 get q 22
ret 0
end
if ge get q 10 get q 0
ret 0
end
nr = sub get q 0 get q 10
if gt nr get q 3
nr = get q 3
end
put q 11 nr
put q 12 and mul nr 4 4294967295
put q 13 and add mul nr 4 get q 1 4294967295
words = ulong 1
if ne get q 5 0
words = mul nr get q 4
end
put q 14 add get q 13 words
put q 15 mul get q 10 get q 8
put q 16 mul mul nr get q 8 4
put q 17 mul get q 14 4
put q 18 mul get q 10 get q 4
put q 19 mul mul nr get q 4 4
put q 20 mul get q 1 4
put q 21 ulong mul uint get q 12 4
put q 22 add get q 10 get q 3
ret 1
end

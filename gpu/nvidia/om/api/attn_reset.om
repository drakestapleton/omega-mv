note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_reset slots edit uint * ids view uint * zz view ulong 4 to ulong
for jj ulong get zz 1
i = add get zz 0 jj
put slots ulong get ids i uint 4294967295
end
ret 0
end
fn av_reset slots edit uint * ids view uint * n ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 0
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_reset slots ids zz
if ne rr 0
ret rr
end
end
ret r
end

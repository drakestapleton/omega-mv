note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn vc_blks ids view uint * q view ulong 16 zz view ulong 4 to ulong
p = new ulong 16 0
for j ulong 6
put p j get q j
end
for jj ulong get zz 1
i = add get zz 0 jj
put p 0 ulong get ids i
rc = api_at_plan 16 p
if ne rc 0
ret rc
end
end
ret 0
end
fn av_blks ids view uint * q view ulong 16 n ulong to ulong
zz = new ulong 4 0
put zz 2 n
r = ulong 0
for bb ulong add div n 1000000 1
put zz 0 mul bb 1000000
cnt = sub n get zz 0
if gt cnt 1000000
cnt = ulong 1000000
end
put zz 1 cnt
rr = vc_blks ids q zz
if ne rr 0
ret rr
end
end
ret r
end

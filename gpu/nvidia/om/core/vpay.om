fn omvpay b edit uchar 25972 n ulong to void
for i ulong 4
put b add 24948 i uchar and shr n mul i 8 255
end
put b 24952 uchar 4
put b 24953 uchar 0
put b 24954 uchar 0
put b 24955 uchar 0
put b 24944 uchar 8
put b 24945 uchar 0
put b 24946 uchar 0
put b 24947 uchar 0
end

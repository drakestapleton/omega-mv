fn omfmt p view uchar 4 o edit ulong 4 to void
put o 0 1
put o 1 6
put o 2 0
put o 3 0
if ne get p 0 37
ret
end
i = ulong 1
size = ulong 0
if eq get p i 122
size = 3
i = add i 1
else
if eq get p i 108
size = 1
i = add i 1
if eq get p i 108
size = 2
i = add i 1
end
end
end
c = ulong get p i
if ne c 0
put o 0 add i 1
else
put o 0 i
end
put o 2 size
if eq c 37
put o 1 0
end
if eq c 115
put o 1 1
end
if eq c 99
put o 1 2
end
if eq c 100
put o 1 3
end
if eq c 117
put o 1 4
end
if eq c 120
put o 1 5
end
end

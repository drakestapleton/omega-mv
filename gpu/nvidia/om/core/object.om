fn ord b view uchar 25972 p ulong n ulong to ulong
x = ulong 0
for i ulong n
x = or x shl ulong get b add p i mul i 8
end
ret x
end
fn owr b edit uchar 25972 p ulong x ulong n ulong to void
for i ulong n
put b add p i uchar and shr x mul i 8 255
end
end
fn ocopy b edit uchar 25972 d view uchar 1024 p ulong q ulong n ulong to void
for i ulong n
put b add p i get d add q i
end
end
fn omobject b edit uchar 25972 d view uchar 1024 v view ulong 8 mode ulong to ulong
if eq mode 0
n = ord b 40 2
k = get v 0
z = get v 1
if or ge n 32 or ge k 64 gt z 512
ret 1
end
if eq get v 2 0
z = 0
end
p = add 42 mul n 578
ocopy b d p 0 k
put b add p k uchar 0
ocopy b d add p 64 64 z
owr b add p 576 z 2
owr b 40 add n 1 2
ret 0
end
if eq mode 1
n = ord b 18538 2
if ge n 64
ret 1
end
p = add 18540 mul n 34
owr b p get v 0 2
ocopy b d add p 2 0 32
owr b 18538 add n 1 2
ret 0
end
n = ord b 20716 2
z = get v 1
if or ge n 32 gt z 128
ret 1
end
p = add 20718 mul n 132
owr b p get v 0 2
owr b add p 2 z 2
if ne get v 2 0
ocopy b d add p 4 0 z
end
owr b 20716 add n 1 2
ret 0
end

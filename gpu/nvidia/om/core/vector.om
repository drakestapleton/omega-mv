fn vread p view uchar 4096 i ulong to ulong
x = ulong 0
for j ulong 4
x = or x shl ulong get p add mul i 4 j mul j 8
end
ret x
end
fn vwrite p edit uchar 4096 i ulong x ulong to void
for j ulong 4
put p add mul i 4 j uchar and shr x mul j 8 255
end
end
fn omvec a edit uchar 4096 b edit uchar 4096 c edit uchar 4096 n ulong base ulong mode ulong to ulong
for j ulong n
i = add base j
if eq mode 2
x = add 1000 i
y = add 2000 mul i 2
if eq i 0
x = 4294967294
y = 3
end
if eq i 1
x = 2147483648
y = 2147483648
end
vwrite a j x
vwrite b j y
vwrite c j 3735928559
else
x = and add vread a j vread b j 4294967295
if eq mode 0
vwrite c j x
else
if ne vread c j x
ret j
end
end
end
end
ret 1024
end

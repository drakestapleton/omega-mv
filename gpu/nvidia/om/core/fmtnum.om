fn omnum bits ulong base ulong signed ulong buf edit uchar 24 to ulong
x = bits
minus = and ne signed 0 ge bits 9223372036854775808
if minus
x = sub ulong 0 bits
end
tmp = new uchar 24 0
n = ulong 0
while ne x 0 bound 24
r = rem x base
if lt r 10
put tmp n uchar add r 48
else
put tmp n uchar add r 87
end
n = add n 1
x = div x base
end
if eq n 0
put tmp 0 uchar 48
n = 1
end
start = ulong 0
if minus
put buf 0 uchar 45
start = 1
end
for i ulong n
put buf add start i get tmp sub sub n i 1
end
ret add start n
end

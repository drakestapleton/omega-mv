fn gnew b edit uchar 6648836 p ulong kind ulong to void
for i ulong 25972
put b add p i uchar 0
end
p = add p 36
for i ulong 4
put b add p i uchar and shr kind mul i 8 255
end
end
fn gmatch b view uchar 6648836 id view uchar 32 p ulong to bool
if eq get b add p 32 uchar 0
ret false
end
for i ulong 32
if ne get b add p i get id i
ret false
end
end
ret true
end
fn omgraph b edit uchar 6648836 id view uchar 32 kind ulong mode ulong to ulong
n = or ulong get b 0 shl ulong get b 1 8
if eq mode 0
if ge n 256
ret 256
end
p = add 4 mul n 25972
gnew b p kind
put b 0 uchar and add n 1 255
put b 1 uchar shr add n 1 8
ret n
end
for j ulong n
p = add 4 mul j 25972
if gmatch b id p
ret j
end
end
ret 256
end

fn cubmsg m view ulong 16 o edit uchar 256 to ulong
p = ulong 0
rc = get m 0
subrc = get m 2
idx = get m 3
if and eq rc 3 and ne subrc 0 ge idx get m 6
p = cm23 o p
p = cmnum o p rc 10
p = cm24 o p
p = cmnum o p idx 10
p = cm25 o p
p = cmnum o p get m 6 10
else
if eq rc 1
p = cm0 o p
else
if eq rc 2
p = cm1 o p
p = cmnum o p get m 5 10
p = cm2 o p
else
if eq rc 3
if eq subrc 0
p = cm3 o p
p = cmnum o p get m 6 10
else
p = cm4 o p
p = cmnum o p idx 10
if or eq subrc 1 ge subrc 4
p = cm5 o p
p = cmnum o p get m 10 16
if eq subrc 1
p = cm6 o p
else
p = cm10 o p
end
else
if eq subrc 2
p = cm7 o p
p = cmnum o p get m 11 10
else
p = cm8 o p
p = cmnum o p get m 11 10
p = cm9 o p
end
end
end
else
if eq rc 4
if eq subrc 5
p = cm11 o p
p = cmnum o p get m 4 16
p = cm12 o p
p = cmnum o p get m 7 16
else
p = cm13 o p
p = cmnum o p get m 7 16
p = cm14 o p
if eq get m 1 86
p = cmnum o p 352 16
else
p = cmnum o p 896 16
end
p = cm15 o p
p = cmnum o p 1024 16
end
else
if eq rc 5
p = cm16 o p
p = cmnum o p get m 8 10
p = cm17 o p
else
if eq rc 6
p = cm18 o p
p = cmnum o p get m 9 10
p = cm19 o p
else
if eq rc 8
p = cm26 o p
p = cmnum o p subrc 10
else
p = cm20 o p
p = cmnum o p get m 4 10
p = cm21 o p
p = cmnum o p 134217728 10
p = cm22 o p
end
end
end
end
end
end
end
end
cap = get m 12
if eq cap 0
ret 0
end
if ge p cap
p = sub cap 1
end
put o p uchar 0
ret p
end

note WolframLanguageEvaluator: FullSimplify[a 2^i == Mod[a 2^i,2^64]+2^64 Quotient[a 2^i,2^64], integer bounds] -> True.
fn emulhi a ulong b ulong to ulong
lo = ulong 0
hi = ulong 0
for i ulong 64
if ne and shr b i 1 0
x = shl a i
y = ulong 0
if ne i 0
y = shr a sub 64 i
end
t = add lo x
hi = add hi y
if lt t lo
hi = add hi 1
end
lo = t
end
end
ret hi
end
fn omeval v view ulong 6 o edit ulong 1 to long
op = get v 0
ov = get v 1
width = get v 2
mask = ulong 18446744073709551615
if lt width 64
mask = sub shl ulong 1 width 1
end
a = and get v 3 mask
b = and get v 4 mask
res = ulong 0
over = false
if eq op 3
res = add a b
over = or lt res a ne and res xor mask 18446744073709551615 0
else
if eq op 4
res = sub a b
over = lt a b
else
if eq op 5
res = mul a b
if lt width 64
if ne a 0
over = gt b div mask a
end
else
if lt width 128
over = ne shr emulhi a b sub width 64 0
end
end
else
if eq op 6
if eq b 0
ret -1
end
res = div a b
else
if eq op 7
if eq a b
put o 0 1
else
put o 0 0
end
ret 0
else
if eq op 8
if lt a b
put o 0 1
else
put o 0 0
end
ret 0
else
if eq op 9
res = and a b
else
if eq op 10
res = or a b
else
ret -1
end
end
end
end
end
end
end
end
if over
if eq ov 3
ret -2
end
if eq ov 2
res = mask
end
end
put o 0 and res mask
ret 0
end

fn chex c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 65 le c 70
ret sub c 55
end
if and ge c 97 le c 102
ret sub c 87
end
ret 256
end
fn cidparse s view uchar 65 d edit uchar 32 to ulong
if ne ulong get s 64 0
ret 1
end
for i ulong 32
a = ulong get s mul i 2
b = chex ulong get s add mul i 2 1
if eq b 256
ret 1
end
x = chex a
if ne x 256
put d i uchar add mul x 16 b
else
if eq a 45
put d i uchar and sub 0 b 255
else
if or eq a 43 or eq a 32 and ge a 9 le a 13
put d i uchar b
else
ret 1
end
end
end
end
ret 0
end
fn cversion kind ulong ver ulong to ulong
want = ulong 1
if eq kind 8
want = 2
if eq ver 1
ret 2
end
end
if ne ver want
ret 1
end
ret 0
end
fn cver kind ulong to ulong
if eq kind 8
ret 2
end
ret 1
end

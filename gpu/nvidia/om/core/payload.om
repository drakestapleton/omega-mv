fn pwr p edit uchar 1024 off ulong x ulong n ulong to void
for i ulong n
put p add off i uchar and shr x mul i 8 255
end
end
fn pid p edit uchar 1024 off ulong ids view uchar 96 which ulong to void
for i ulong 32
put p add off i uchar ulong get ids add mul which 32 i
end
end
fn ompay p edit uchar 1024 ids view uchar 96 v view ulong 8 mode ulong to ulong
if eq mode 0
for i ulong 44
put p i uchar 0
end
pwr p 0 get v 0 4
pwr p 4 get v 1 2
pwr p 8 get v 2 4
pid p 12 ids 0
ret 44
end
if le mode 2
for i ulong 98
put p i uchar 0
end
pid p 0 ids 0
n = ulong 0
if eq mode 1
n = 1
put p 34 uchar get v 1
end
if eq mode 2
n = div add get v 0 7 8
if eq n 0
n = 1
end
if gt n 64
n = 64
end
for i ulong n
s = mul sub sub n i 1 8
if lt s 64
put p add 34 i uchar and shr get v 1 s 255
end
end
end
pwr p 32 n 2
ret 98
end
if eq mode 4
for i ulong 204
put p i uchar 0
end
pwr p 0 get v 0 4
pwr p 4 get v 1 4
if ne get v 2 0
pid p 8 ids 0
put p 40 uchar 2
pid p 41 ids 0
pid p 73 ids 0
pid p 169 ids 0
end
ret 204
end
for i ulong 161
put p i uchar 0
end
pid p 0 ids 0
put p 32 uchar 2
pid p 33 ids 1
pid p 65 ids 2
ret 161
end

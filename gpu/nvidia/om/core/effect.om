fn efsize off ulong to ulong
if eq off 0
ret 2
end
if eq off 2
ret 2
end
if eq off 4
ret 4
end
if eq off 8
ret 8
end
if eq off 48
ret 2
end
ret 1
end
fn omeffect p edit uchar 184 w edit uchar 178 size ulong mode ulong to long
if eq mode 0
i = ulong 0
while lt i 178 bound 178
n = efsize i
for j ulong n
put w add i j uchar ulong get p add i sub sub n j 1
end
i = add i n
end
ret 0
end
for i ulong 184
put p i uchar 0
end
if eq size 176
ret -3
end
if ne size 178
ret -2
end
if eq or ulong get w 0 ulong get w 1 0
ret -4
end
n = add shl ulong get w 48 8 ulong get w 49
if gt n 128
ret -5
end
i = n
while lt i 128 bound 128
if ne ulong get w add 50 i 0
ret -6
end
i = add i 1
end
i = ulong 0
while lt i 178 bound 178
n = efsize i
for j ulong n
put p add i j uchar ulong get w add i sub sub n j 1
end
i = add i n
end
ret 0
end

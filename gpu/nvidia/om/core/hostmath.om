note Source constants rounded to binary64 with Wolfram N[decimal80,MachinePrecision]; receipt records the exact query.
fn LNHI to f64
ret bitcast f64 ulong 4604418534311723008
end
fn LNLO to f64
ret bitcast f64 ulong 4461442080421002358
end
fn ILN2 to f64
ret bitcast f64 ulong 4609176140021203710
end
fn SQRT2 to f64
ret bitcast f64 ulong 4609047870845172685
end
fn hpow2 k long to f64
if gt k 1023
ret bitcast f64 shl ulong 2047 52
end
if lt k -1074
ret 0.0f64
end
if ge k -1022
ret bitcast f64 shl ulong add k 1023 52
end
ret mul bitcast f64 shl ulong 1 52 bitcast f64 shl ulong add k 2045 52
end
fn hlogsum e long t f64 s f64 to f64
ret add mul f64 e LNHI add mul mul 2.0f64 t s mul f64 e LNLO
end
fn hlog x f64 to f64
if or not gt x 0.0f64 gt x bitcast f64 sub shl ulong 2047 52 1
ret bitcast f64 or shl ulong 2047 52 shl ulong 1 51
end
e = long 0
if lt x bitcast f64 shl ulong 1 52
x = mul x 18014398509481984.0f64
e = -54
end
u = bitcast ulong x
e = sub add e long and shr u 52 2047 1023
m = bitcast f64 or and u sub shl ulong 1 52 1 shl ulong 1023 52
if gt m SQRT2
m = mul m 0.5f64
e = add e 1
end
t = div sub m 1.0f64 add m 1.0f64
t2 = mul t t
s = f64 0.0
k = long 25
while ge k 1 bound 13
s = add mul s t2 div 1.0f64 f64 k
k = sub k 2
end
ret hlogsum e t s
end
fn hexp y f64 to f64
if ne y y
ret y
end
if gt y bitcast f64 ulong 4649454506724284170
ret bitcast f64 shl ulong 2047 52
end
if lt y bitcast f64 ulong 13873138101193906586
ret 0.0f64
end
fk = mul y ILN2
adj = f64 0.5
if lt fk 0.0f64
adj = -0.5f64
end
k = long add fk adj
kd = f64 k
r = sub sub y mul kd LNHI mul kd LNLO
p = f64 1.0
n = long 17
while ge n 1 bound 17
p = add 1.0f64 div mul r p f64 n
n = sub n 1
end
if lt k -1020
ret mul mul p hpow2 -1020 hpow2 add k 1020
end
ret mul p hpow2 k
end
fn hround x f64 to long
if lt x 0.0f64
ret long sub x 0.5f64
end
ret long add x 0.5f64
end
fn hpoly w f64 k long to f64
p = f64 1.0
while ge k 2 bound 8
p = sub 1.0f64 div mul w p f64 mul k sub k 1
k = sub k 2
end
ret p
end
fn hsin a f64 o edit ulong 2 to void
n = hround mul a bitcast f64 ulong 4603909380684499075
nd = f64 n
r = sub a mul nd bitcast f64 ulong 4609753056924401664
r = sub r mul nd bitcast f64 ulong 4454258360616747008
r = sub r mul nd bitcast f64 ulong 4297306550709518336
r = sub r mul nd bitcast f64 ulong 4142048980368378305
w = mul r r
sr = mul r hpoly w 15
cr = hpoly w 16
quad = ulong and n 3
if eq quad 0
put o 0 bitcast ulong sr
put o 1 bitcast ulong cr
end
if eq quad 1
put o 0 bitcast ulong cr
put o 1 bitcast ulong neg sr
end
if eq quad 2
put o 0 bitcast ulong neg sr
put o 1 bitcast ulong neg cr
end
if eq quad 3
put o 0 bitcast ulong neg cr
put o 1 bitcast ulong sr
end
end
fn omhost mode ulong abits ulong bbits ulong o edit ulong 2 to void
a = bitcast f64 abits
b = bitcast f64 bbits
if eq mode 0
put o 0 bitcast ulong hlog a
ret
end
if eq mode 1
put o 0 bitcast ulong hexp a
ret
end
if eq mode 2
if or eq a 1.0f64 eq b 0.0f64
put o 0 bitcast ulong 1.0f64
else
put o 0 bitcast ulong hexp mul b hlog a
end
ret
end
if eq mode 3
hsin a o
ret
end
e = long a
x = ulong 0
if gt e 127
x = shl ulong 255 23
else
if ge e -126
x = shl ulong add e 127 23
else
if ge e -149
x = shl ulong 1 ulong add e 149
end
end
end
put o 0 x
end

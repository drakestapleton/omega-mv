fn omvspec p edit uchar 144 name view uchar 64 n ulong to long
if eq n 0
ret -1
end
for i ulong 144
put p i uchar 0
end
for i ulong 63
c = get name i
if eq c 0
break
end
put p add i 32 c
end
put p 96 uchar 3
put p 100 uchar 32
for i ulong 4
put p add 104 i uchar and shr n mul i 8 255
end
put p 108 uchar 1
ret 0
end

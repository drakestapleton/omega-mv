note Bootstrap LP64 OmegaObject byte view; ABI asserted by the C memory shell.
fn crd b view uchar 25972 p ulong n ulong to ulong
x = ulong 0
for i ulong n
x = or x shl ulong ulong get b add p i mul i 8
end
ret x
end
fn ccmp b view uchar 25972 p ulong q ulong n ulong to long
for i ulong n
x = long ulong get b add p i
y = long ulong get b add q i
if ne x y
ret sub x y
end
end
ret 0
end
fn cstrlen b view uchar 25972 p ulong to ulong
n = ulong 0
while ne ulong get b add p n 0 bound 25972
n = add n 1
end
ret n
end
fn cless b view uchar 25972 p ulong q ulong mode ulong to bool
if eq mode 0
n = cstrlen b p
m = cstrlen b q
if lt m n
n = m
end
c = ccmp b p q n
if ne c 0
ret lt c 0
end
ret lt cstrlen b p cstrlen b q
end
x = crd b p 2
y = crd b q 2
if ne x y
ret lt x y
end
if eq mode 1
ret lt ccmp b add p 2 add q 2 32 0
end
x = crd b add p 2 2
y = crd b add q 2 2
n = x
if lt y n
n = y
end
c = ccmp b add p 4 add q 4 n
if ne c 0
ret lt c 0
end
ret lt x y
end
fn csort b view uchar 25972 idx edit ulong 64 cfg view ulong 4 to void
n = get cfg 0
base = get cfg 1
step = get cfg 2
for i ulong n
v = add base mul i step
j = i
while gt j 0 bound 64
if not cless b v get idx sub j 1 get cfg 3
break
end
put idx j get idx sub j 1
j = sub j 1
end
put idx j v
end
end
fn cbe o edit uchar 32768 p ulong x ulong n ulong to void
for i ulong n
put o add p i uchar and shr x mul sub sub n i 1 8 255
end
end
fn ccopy b view uchar 25972 o edit uchar 32768 p ulong q ulong n ulong to void
for i ulong n
put o add p i uchar ulong get b add q i
end
end
fn celem b view uchar 25972 o edit uchar 32768 cap ulong mode ulong pos ulong p ulong to ulong
if eq mode 0
k = cstrlen b p
v = crd b add p 576 2
if or gt k 255 gt add pos add 3 add k v cap
ret 65536
end
put o pos uchar k
ccopy b o add pos 1 p k
pos = add pos add k 1
cbe o pos v 2
ccopy b o add pos 2 add p 64 v
pos = add pos add v 2
else
if eq mode 1
if gt add pos 34 cap
ret 65536
end
cbe o pos crd b p 2 2
ccopy b o add pos 2 add p 2 32
pos = add pos 34
else
v = crd b add p 2 2
if gt add pos add v 4 cap
ret 65536
end
cbe o pos crd b p 2 2
cbe o add pos 2 v 2
ccopy b o add pos 4 add p 4 v
pos = add pos add v 4
end
end
ret pos
end
fn cgroup b view uchar 25972 o edit uchar 32768 cap ulong cfg view ulong 4 pos ulong to ulong
idx = new ulong 64 0
csort b idx cfg
n = get cfg 0
mode = get cfg 3
if gt add pos 2 cap
ret 65536
end
cbe o pos n 2
pos = add pos 2
for i ulong n
p = get idx i
pos = celem b o cap mode pos p
if eq pos 65536
ret pos
end
end
ret pos
end
fn canon b view uchar 25972 o edit uchar 32768 cap ulong to ulong
kind = crd b 36 4
if lt cap 6
ret 65536
end
put o 0 uchar 79
put o 1 uchar 77
put o 2 uchar 71
put o 3 uchar 48
put o 4 uchar 1
if eq kind 8
put o 4 uchar 2
end
put o 5 uchar kind
cfg = new ulong 4 0
n = crd b 40 2
if gt n 32
ret 65536
end
put cfg 0 n
put cfg 1 42
put cfg 2 578
pos = cgroup b o cap cfg 6
if eq pos 65536
ret pos
end
n = crd b 18538 2
if gt n 64
ret 65536
end
put cfg 0 n
put cfg 1 18540
put cfg 2 34
put cfg 3 1
pos = cgroup b o cap cfg pos
if eq pos 65536
ret pos
end
n = crd b 20716 2
if gt n 32
ret 65536
end
put cfg 0 n
put cfg 1 20718
put cfg 2 132
put cfg 3 2
pos = cgroup b o cap cfg pos
if eq pos 65536
ret pos
end
n = crd b 24944 4
if gt add pos add n 4 cap
ret 65536
end
cbe o pos n 4
ccopy b o add pos 4 24948 n
ret add pos add n 4
end
fn cidcmp a view uchar 32 b view uchar 32 to long
for i ulong 32
x = long ulong get a i
y = long ulong get b i
if ne x y
ret sub x y
end
end
ret 0
end
fn cidhex a view uchar 32 b edit uchar 65 to void
for i ulong 64
v = ulong get a shr i 1
if eq and i 1 0
v = shr v 4
end
v = and v 15
if lt v 10
put b i uchar add v 48
else
put b i uchar add v 87
end
end
put b 64 uchar 0
end

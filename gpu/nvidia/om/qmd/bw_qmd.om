note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Blackwell QMD and constant-bank packing. Host memcpy and null checks stay in the C shell.
note Field values are the constants src/omega_blackwell_qmd.c cites.
note QMD words: clcdc0qmd.h via that file. Constant bank: empirical GB10 capture in the same file.
note WolframLanguageEvaluator: 16^^39c -> 924, 2^32-1 -> 4294967295, 16^^00800002 -> 8388610, 16^^2f5003a4 -> 793772964.
note WolframLanguageEvaluator: 16^^00230000 -> 2293760, 16^^00500200 -> 5243392, 16^^013f0000 -> 20905984.
note WolframLanguageEvaluator: 16^^00190000 -> 1638400, 16^^81810000 -> 2172715008, 16^^04b44808 -> 78923784.
note WolframLanguageEvaluator: BitAnd[16^^04b44808, BitNot[16^^7ff]] -> 78923776, 16^^1fffff -> 2097151, 10*2^21 -> 20971520.
note WolframLanguageEvaluator: 64*2^19 -> 33554432, 144*2^19 -> 75497472, 16*2^19 -> 8388608, 4096*2^19 -> 2147483648.
note WolframLanguageEvaluator: 16^^10300011 -> 271581201, 2^17 -> 131072, 16^^380 -> 896.

fn qlo32 v ulong to ulong
ret and v 4294967295
end

fn qz96 q edit ulong 224 to void
for i ulong 96
put q i 0
end
end

fn qz224 q edit ulong 224 to void
for i ulong 224
put q i 0
end
end

fn qthrx m view ulong 16 to ulong
if ne get m 1 0
ret get m 1
end
if ne get m 3 0
ret get m 3
end
ret 64
end

fn qthry m view ulong 16 to ulong
if ne get m 2 0
ret get m 2
end
ret 1
end

fn qgrdx m view ulong 16 tx ulong to ulong
if ne get m 4 0
ret get m 4
end
if ne get m 6 0
ret get m 6
end
s = and add get m 7 tx 4294967295
g = div and sub s 1 4294967295 tx
if eq g 0
ret 1
end
ret g
end

fn qgprc n ulong to ulong
if eq n 0
ret 16
end
if lt n 16
ret 16
end
ret n
end

fn qmd0w q edit ulong 224 va ulong to void
qz96 q
put q 4 8388610
put q 10 2293760
put q 12 qlo32 shr va 8
put q 14 5243392
put q 34 65537
put q 35 2049
end

fn qmd1a m view ulong 16 q edit ulong 224 to void
qz96 q
put q 4 20905984
put q 9 3
put q 10 1638400
put q 12 qlo32 shr get m 14 8
put q 14 793772964
put q 15 qlo32 get m 13
put q 16 qlo32 shr get m 13 32
put q 17 6
put q 19 2172715008
put q 20 56
put q 22 67108864
put q 32 qlo32 shr get m 10 4
put q 33 or and shr get m 10 36 2097151 20971520
end

fn qmd1b m view ulong 16 q edit ulong 224 to ulong
tx = qthrx m
ty = qthry m
put q 34 or and tx 65535 shl and ty 65535 16
gpr = qgprc get m 9
put q 35 or or 1 shl and gpr 511 8 131072
sm = get m 8
if gt sm 32768
ret 1
end
s7 = ulong 8
if ne sm 0
s7 = div add sm 127 128
end
put q 36 or 78923776 s7
put q 37 0
gx = qgrdx m tx
put q 39 gx
gy = get m 5
if eq gy 0
gy = ulong 1
end
put q 40 gy
put q 41 1
ret 0
end

fn qmd1c m view ulong 16 q edit ulong 224 to void
cb = get m 11
sc = get m 12
code = get m 10
put q 42 qlo32 shr cb 6
put q 43 or and shr cb 38 524287 33554432
put q 44 qlo32 shr sc 6
put q 45 or and shr sc 38 524287 75497472
put q 52 qlo32 shr add cb 768 6
put q 53 or and shr add cb 768 38 524287 8388608
put q 56 qlo32 shr sc 6
put q 57 or and shr sc 38 524287 2147483648
put q 58 271581201
put q 59 qlo32 shr code 8
end

fn qmd1w m view ulong 16 q edit ulong 224 to ulong
qmd1a m q
r = qmd1b m q
if ne r 0
ret 1
end
qmd1c m q
ret 0
end

fn qmdvw q view ulong 224 to ulong
if ne and shr get q 14 20 15 5
ret 1
end
if ne and shr get q 4 23 7 2
ret 1
end
if ne get q 37 0
ret 1
end
if eq get q 17 0
ret 1
end
if ne and shr get q 33 21 511 10
ret 1
end
if eq and get q 58 1 0
ret 1
end
ret 0
end

fn cb0a q edit ulong 224 to void
put q 0 641859584
put q 1 3
put q 48 2499697920
put q 49 3893478299
put q 62 1048575
put q 64 536870912
put q 65 3
put q 66 570425344
put q 67 3
put q 70 604045312
put q 71 3
put q 80 1
put q 82 67158016
put q 83 2
put q 91 1024
end

fn cb0b q edit ulong 224 to void
put q 108 79311560
put q 114 1
put q 118 288
put q 126 632711424
put q 127 3
put q 128 1
put q 129 1
put q 130 1
put q 132 1065353216
put q 133 1065353216
put q 134 1065353216
put q 135 1024
put q 136 1
put q 137 1
put q 138 1
put q 139 1
end

fn cb0c q edit ulong 224 to void
put q 148 79311560
put q 154 1
put q 158 288
put q 166 632711424
put q 167 3
put q 168 1
put q 169 1
put q 170 1
put q 172 1065353216
put q 173 1065353216
put q 174 1065353216
put q 175 1024
put q 176 1
put q 177 1
put q 178 1
put q 179 1
put q 180 48
put q 183 16777216
put q 185 59840
put q 189 59840
put q 190 16777216
put q 191 59839
end

fn cb0d q edit ulong 224 to void
put q 216 64
put q 217 1
put q 218 1
put q 220 1
put q 221 1
put q 222 1
put q 223 16776640
end

fn cbpch q edit ulong 224 va ulong to void
put q 68 qlo32 shr va 32
put q 69 qlo32 va
put q 210 qlo32 shr add va 896 32
put q 211 qlo32 add va 896
put q 212 qlo32 shr add va 924 32
put q 213 qlo32 add va 924
end

fn cb2d q edit ulong 224 m view ulong 16 to void
if ne get m 2 0
put q 216 get m 2
end
if ne get m 3 0
put q 217 get m 3
end
if ne get m 4 0
put q 220 get m 4
end
if ne get m 5 0
put q 221 get m 5
end
end

fn cbnkw m view ulong 16 q edit ulong 224 two ulong to void
qz224 q
cb0a q
cb0b q
cb0c q
cb0d q
cbpch q get m 1
if ne two 0
cb2d q m
end
end

fn argsw m view ulong 16 q edit ulong 224 mat ulong to void
put q 0 qlo32 get m 1
put q 1 qlo32 shr get m 1 32
put q 2 qlo32 get m 2
put q 3 qlo32 shr get m 2 32
put q 4 qlo32 get m 3
put q 5 qlo32 shr get m 3 32
put q 6 get m 4
if ne mat 0
put q 7 get m 5
put q 8 get m 6
put q 9 0
end
end

fn bw_qmd op ulong m view ulong 16 q edit ulong 224 to ulong
if eq op 0
qmd0w q get m 1
ret 0
end
if eq op 1
ret qmd1w m q
end
if eq op 2
ret qmdvw q
end
if eq op 3
cbnkw m q 0
ret 0
end
if eq op 4
cbnkw m q 1
ret 0
end
if eq op 5
argsw m q 0
ret 0
end
if eq op 6
argsw m q 1
ret 0
end
ret 2
end

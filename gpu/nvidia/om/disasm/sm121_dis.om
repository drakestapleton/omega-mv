note sm121_dis.om: Omega's own sm_121 (GB10) disassembler, row C6 of docs/OMEGA.md (CUDA++ C6, DRA-475).
note It turns one 128-bit instruction word into the text nvdisasm 13.0.85 prints for it. It replaces the decoder
note of src/omega_sm121_disasm.c, which stays compiled only behind CUDAPP_MIGRATION_PENDING_C_DISASM (and the
note DIFF build) as the differential oracle. nvdisasm is an offline oracle only (tools/sm121dis/check.sh).
note
note Layout of a word (lo = bits 0..63, hi = bits 64..127): opcode bits 0..11; guard predicate bits 12..14 with
note its negation at 15 (7 and no negation = no guard); registers at 16, 24, 32 and hi 0; modifiers in hi 8..40;
note control from hi 41 on (stall, barriers, yield, reuse), which is not part of the text.
note
note A row is one instruction form: its fixed bits (lov, hiv) and a format, the exact C format string packed
note eight ASCII bytes per ulong, little-endian. Each %x code names the bits it reads (fn fld). Every other
note bit of lo and of hi 0..40 (outside the guard) must equal the row's fixed value, or the row does not match.
note Rows are tried in the C table's order; only the rows of the word's opcode are built (fn rows), which is
note the same order restricted to the rows that can match. The row table (fns rowsa, rowsb, rowsc) was
note generated by Wolfram from the C ROWS table (evidence/C6-DISASM-OM/wolfram-rows.txt).
note A word that matches no form prints ?? 0x<hi><lo> (16 hex digits each) and is reported, never guessed.
note The C file's float immediate form (%f) is used by no row; here %f refuses (overflow flag) instead.
note
note Call: sm121_dis lo hi pc out. pc is the byte address of the word. out receives the text, no trailing
note semicolon. Result: bits 0..15 the text length, bit 16 set when no form matched, bit 17 set when the word
note is an EXIT (opcode 0x94d, any guard), bit 18 set when the text did not fit 255 bytes.
note State s: 0 lo, 1 hi, 2 pc, 3 write position, 4 refused (overflow or an unknown code), 5 a field value the
note oracle names but this decoder does not (the word is then reported as ??).

const HIM ulong 2199023255551
const P31 ulong 2147483648
const P55 ulong 36028797018963968
const SX56 ulong 18374686479671623680
const SX32 ulong 18446744069414584320

note bits at .. at+n-1 of v (n below 64)
fn bits v ulong at ulong n ulong to ulong
ret and shr v at sub shl ulong 1 n 1
end

note append one byte; past 255 bytes mark the text refused
fn pc1 o edit uchar 256 s edit ulong 8 c ulong to void
a = get s 3
if lt a 255
put o a uchar c
put s 3 add a 1
else
put s 4 1
end
end

note append up to eight bytes packed little-endian in v, stopping at the first zero byte
fn lit o edit uchar 256 s edit ulong 8 v ulong to void
x = v
for k ulong 8
if eq x 0
break
end
pc1 o s and x 255
x = shr x 8
end
end

note unsigned decimal
fn dec o edit uchar 256 s edit ulong 8 v ulong to void
d = new ulong 20 0
x = v
n = ulong 0
for k ulong 20
put d n rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
for k ulong 20
if eq n 0
break
end
n = sub n 1
pc1 o s add 48 get d n
end
end

fn hexd d ulong to ulong
if lt d 10
ret add d 48
end
ret add d 87
end

note lowercase hex without leading zeros, no prefix
fn hexn o edit uchar 256 s edit ulong 8 v ulong to void
n = ulong 1
for k ulong 15
if eq shr v mul n 4 0
break
end
n = add n 1
end
for k ulong 16
if eq n 0
break
end
n = sub n 1
pc1 o s hexd and shr v mul n 4 15
end
end

note 0x and lowercase hex (printf 0x%x)
fn hexu o edit uchar 256 s edit ulong 8 v ulong to void
lit o s 30768
hexn o s v
end

note exactly 16 hex digits (printf %016llx)
fn hex16 o edit uchar 256 s edit ulong 8 v ulong to void
n = ulong 16
for k ulong 16
n = sub n 1
pc1 o s hexd and shr v mul n 4 15
end
end

note v read as an n-bit two's complement number: -0x... or 0x...
fn hexs o edit uchar 256 s edit ulong 8 v ulong n ulong to void
if ge v shl ulong 1 sub n 1
pc1 o s 45
hexu o s sub shl ulong 1 n v
ret
end
hexu o s v
end

note a predicate: ! when negated, PT for 7, else P and the number
fn prd o edit uchar 256 s edit ulong 8 p ulong ng ulong to void
if ne ng 0
pc1 o s 33
end
if eq p 7
lit o s 21584
ret
end
pc1 o s 80
dec o s p
end

note a register with prefix pf (R or UR): Z for 255, else the number
fn reg o edit uchar 256 s edit ulong 8 pf ulong v ulong to void
lit o s pf
if eq v 255
pc1 o s 90
ret
end
dec o s v
end

note the special registers nvdisasm 13.0.85 prints by name (107 of 256, an S2R sweep; Wolfram bitmap): one the
note table above does not name is reported (s 5 set, the word prints ??), never printed as SR and its number
fn srnamed v ulong to bool
w = ulong 0
q = div v 64
if eq q 0
w = 9223363172042244111
end
if eq q 1
w = 18446744069418713119
end
if eq q 2
w = 61247
end
if eq q 3
w = 9223372036854775808
end
ret ne and shr w rem v 64 1 0
end

note special register names nvdisasm prints, else SR and the number
fn srn o edit uchar 256 s edit ulong 8 v ulong to void
if eq v 33
lit o s 6354091206005183059
ret
end
if eq v 34
lit o s 6426148800043110995
ret
end
if eq v 35
lit o s 6498206394081038931
ret
end
if eq v 37
lit o s 4920535898042356307
lit o s 22574
ret
end
if eq v 38
lit o s 4920535898042356307
lit o s 22830
ret
end
if eq v 39
lit o s 4920535898042356307
lit o s 23086
ret
end
if eq v 0
lit o s 5279712180522930771
lit o s 68
ret
end
if eq v 80
lit o s 5423265565250638419
lit o s 20300
ret
end
if eq v 81
lit o s 5423265565250638419
lit o s 18760
ret
end
note the device-side trace emitter's timer pair, SR_GLOBALTIMERLO and SR_GLOBALTIMERHI
if eq v 82
lit o s 4702408149961757267
lit o s 5714032484829189196
ret
end
if eq v 83
lit o s 4702408149961757267
lit o s 5280561020694778956
ret
end
if srnamed v
put s 5 1
ret
end
lit o s 21075
dec o s v
end

note float compare names 0..15: F LT EQ LE GT NE GE NUM NAN LTU EQU LEU GTU NEU GEU T
fn fcmp v ulong to ulong
if eq v 0
ret 70
end
if eq v 1
ret 21580
end
if eq v 2
ret 20805
end
if eq v 3
ret 17740
end
if eq v 4
ret 21575
end
if eq v 5
ret 17742
end
if eq v 6
ret 17735
end
if eq v 7
ret 5068110
end
if eq v 8
ret 5128526
end
if eq v 9
ret 5592140
end
if eq v 10
ret 5591365
end
if eq v 11
ret 5588300
end
if eq v 12
ret 5592135
end
if eq v 13
ret 5588302
end
if eq v 14
ret 5588295
end
ret 84
end

note integer compare names 0..7: F LT EQ LE GT NE GE T (the float names, T for 7)
fn icmp v ulong to ulong
if eq v 7
ret 84
end
ret fcmp v
end

note memory access sizes 0..7: .U8 .S8 .U16 .S16 (none) .64 .128 .U.128
fn msz v ulong to ulong
if eq v 0
ret 3691822
end
if eq v 1
ret 3691310
end
if eq v 2
ret 909202734
end
if eq v 3
ret 909202222
end
if eq v 4
ret 0
end
if eq v 5
ret 3421742
end
if eq v 6
ret 942813486
end
ret 61788224640302
end

fn pk h ulong at ulong n ulong to ulong
ret add add mul h 65536 mul at 256 n
end

note operand code c: hi word flag, first bit and width packed by pk; 0 for a code without a field
fn fld c ulong to ulong
note d a b c (R registers) and D A B C (uniform registers)
if or eq c 100 eq c 68
ret pk 0 16 8
end
if or eq c 97 eq c 65
ret pk 0 24 8
end
if or eq c 98 eq c 66
ret pk 0 32 8
end
if or eq c 99 eq c 67
ret pk 1 0 8
end
note i s f j Y: a 32-bit immediate (unsigned, signed, float, ISETP signed, BSSY distance)
if or or eq c 105 eq c 115 eq c 102
ret pk 0 32 32
end
if or eq c 106 eq c 89
ret pk 0 32 32
end
note K c[bank][offset] offset 38..53 bank 54..58; U the uniform load, offset 37..53
if eq c 75
ret pk 0 38 21
end
if eq c 85
ret pk 0 37 22
end
note o signed 24-bit address offset; y convergence barrier
if eq c 111
ret pk 0 40 24
end
if eq c 121
ret pk 0 16 4
end
note P Q R predicates, R with its negation at hi 26
if eq c 80
ret pk 1 17 3
end
if eq c 81
ret pk 1 20 3
end
if eq c 82
ret pk 1 23 4
end
note l LOP3 table and S special register at hi 8; h m SHFL lane distance and clamp
if or eq c 108 eq c 83
ret pk 1 8 8
end
if eq c 104
ret pk 0 53 5
end
if eq c 109
ret pk 0 40 13
end
note G g integer and float compare; Z ISETP signed flag; z memory size; N M IADD3 negations
if eq c 71
ret pk 1 12 3
end
if eq c 103
ret pk 1 12 4
end
if eq c 90
ret pk 1 9 1
end
if eq c 122
ret pk 1 9 3
end
if eq c 78
ret pk 1 8 1
end
if eq c 77
ret pk 0 63 1
end
ret 0
end

note the bits field f reads, in lo (h 0) or hi (h 1)
fn fmsk f ulong h ulong to ulong
if eq f 0
ret 0
end
if ne shr f 16 h
ret 0
end
ret shl sub shl ulong 1 and f 255 1 and shr f 8 255
end

note the BRA distance: 4-byte units, low 8 bits at 16..23, the rest at 34..63 and hi 0..17
fn tmsk h ulong to ulong
if eq h 0
ret or shl ulong 255 16 shl sub shl ulong 1 30 1 34
end
ret sub shl ulong 1 18 1
end

note the value field f reads from the word in s
fn fval s view ulong 8 f ulong to ulong
v = get s 0
if ne shr f 16 0
v = get s 1
end
ret bits v and shr f 8 255 and f 255
end

note byte i of row r's format
fn fb t view ulong 80 r ulong i ulong to ulong
w = get t add add mul r 10 2 div i 8
ret and shr w mul rem i 8 8 255
end

note the bits row r's format reads, in lo (h 0) or hi (h 1)
fn rmask t view ulong 80 r ulong h ulong to ulong
m = ulong 0
i = ulong 0
for k ulong 64
if ge i 63
break
end
c = fb t r i
if eq c 0
break
end
if eq c 37
i = add i 1
d = fb t r i
if eq d 84
m = or m tmsk h
else
m = or m fmsk fld d h
end
end
i = add i 1
end
ret m
end

note row r matches when every bit outside its fields and the guard equals the row's
fn hit t view ulong 80 r ulong lb ulong hb ulong to bool
b = mul r 10
lm = not or rmask t r 0 61440
hm = and HIM not rmask t r 1
if ne and lb lm and get t b lm
ret false
end
ret eq and hb hm and get t add b 1 hm
end

note print the signed 56-bit BRA target and the BSSY target as unsigned byte addresses
fn btgt s view ulong 8 to ulong
lo = get s 0
u = or or bits lo 16 8 shl bits lo 34 30 8 shl bits get s 1 0 18 38
if ge u P55
u = or u SX56
end
ret add add get s 2 16 mul u 4
end

fn ytgt s view ulong 8 to ulong
v = bits get s 0 32 32
if ge v P31
v = or v SX32
end
ret add add get s 2 16 v
end

note one operand
fn opd o edit uchar 256 s edit ulong 8 c ulong to void
v = fval s fld c
if or or or eq c 100 eq c 97 eq c 98 eq c 99
reg o s 82 v
ret
end
if or or or eq c 68 eq c 65 eq c 66 eq c 67
reg o s 21077 v
ret
end
if or or or eq c 105 eq c 108 eq c 104 eq c 109
hexu o s v
ret
end
if or eq c 115 eq c 106
hexs o s v 32
ret
end
if eq c 75
lit o s 2016435043
hexn o s bits get s 0 54 5
lit o s 2016435037
hexn o s bits get s 0 38 16
pc1 o s 93
ret
end
if eq c 85
lit o s 2016435043
hexn o s bits get s 0 54 5
lit o s 2016435037
hexn o s bits get s 0 37 17
pc1 o s 93
ret
end
if eq c 111
if ne v 0
pc1 o s 43
hexs o s v 24
end
ret
end
if eq c 89
hexu o s ytgt s
ret
end
if eq c 121
pc1 o s 66
dec o s v
ret
end
if or eq c 80 eq c 81
prd o s v 0
ret
end
if eq c 82
prd o s and v 7 and shr v 3 1
ret
end
if eq c 83
srn o s v
ret
end
if eq c 71
lit o s icmp v
ret
end
if eq c 103
lit o s fcmp v
ret
end
if eq c 90
if eq v 0
lit o s 842224942
end
ret
end
if eq c 122
lit o s msz v
ret
end
if or eq c 78 eq c 77
if ne v 0
pc1 o s 45
end
ret
end
if eq c 84
hexu o s btgt s
ret
end
put s 4 1
end

note write row r's text
fn rend o edit uchar 256 s edit ulong 8 t view ulong 80 r ulong to void
i = ulong 0
for k ulong 64
if ge i 64
break
end
c = fb t r i
if eq c 0
break
end
if eq c 37
i = add i 1
if ge i 64
put s 4 1
ret
end
opd o s fb t r i
else
pc1 o s c
end
i = add i 1
end
end

note IMAD with an immediate: nvdisasm names the special cases. CUDA 13.0 -b SM121 on 2^1..2^31 with Rc = RZ
note (2026-10-27): plain IMAD for 2^16 and 2^31, .SHL for every other power.
fn imadn imm ulong c ulong to ulong
if eq imm 0
ret 1
end
if eq imm 1
if eq c 255
ret 1
end
ret 2
end
if ne c 255
ret 0
end
if ne and imm sub imm 1 0
ret 0
end
n = ulong 0
x = imm
for k ulong 32
if ne and x 1 0
break
end
x = shr x 1
n = add n 1
end
if or eq n 16 eq n 31
ret 0
end
ret 3
end

fn imadi o edit uchar 256 s edit ulong 8 lb ulong hb ulong to bool
if ne and lb 4095 2084
ret false
end
if ne and hb not ulong 255 126747136
ret false
end
imm = bits lb 32 32
c = and hb 255
k = imadn imm c
if eq k 0
lit o s 1145130313
end
if eq k 1
lit o s 6219274471530909001
end
if eq k 2
lit o s 4918292731127745865
lit o s 68
end
if eq k 3
lit o s 5496734803384421705
end
pc1 o s 32
reg o s 82 bits lb 16 8
lit o s 8236
reg o s 82 bits lb 24 8
lit o s 8236
hexs o s imm 32
lit o s 8236
reg o s 82 c
ret true
end


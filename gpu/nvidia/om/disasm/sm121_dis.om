note the rows of opcode op, in the C table's order, written to t (stride 10); their count
fn rows op ulong t edit ulong 80 to ulong
n = rowsa op t
if ne n 0
ret n
end
n = rowsb op t
if ne n 0
ret n
end
ret rowsc op t
end

fn fin s view ulong 8 x ulong to ulong
ret or or get s 3 x mul get s 4 262144
end

fn sm121_dis lo ulong hi ulong pc ulong o edit uchar 256 to ulong
s = new ulong 8 0
t = new ulong 80 0
put s 0 lo
put s 1 hi
put s 2 pc
g = bits lo 12 3
gn = bits lo 15 1
if or ne g 7 ne gn 0
pc1 o s 64
prd o s g gn
pc1 o s 32
end
lb = and lo not ulong 61440
hb = and hi HIM
x = ulong 0
if eq and lo 4095 2381
x = 131072
end
if imadi o s lb hb
ret fin s x
end
n = rows and lb 4095 t
for r ulong n
if hit t r lb hb
rend o s t r
if eq get s 5 0
ret fin s x
end
break
end
end
put s 3 0
lit o s 516203495231
hex16 o s hi
hex16 o s lo
ret fin s or x 65536
end

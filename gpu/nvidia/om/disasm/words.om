note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Source: word_half and omega_sm121_padding_start; C retains byte transport only.
fn dis_words b view uchar 8 mode ulong at ulong prev ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get b i mul i 8
end
if eq mode 0
ret v
end
if eq and v 4095 2381
ret add at 16
end
ret prev
end

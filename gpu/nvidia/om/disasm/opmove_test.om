note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note opmove_test.om: BlackwellIR ops 64..79 after the #280 numbering move (evidence/INTEG-280-20261110/numbering.txt),
note through the seeded encoder and Omega's own sm_121 decoder (C6). Concatenate after om/encoder/bw_enc_sm121.om
note and om/disasm/sm121_dis.om; mk/sm121dis.mk test-sm121dis-opmove compiles it with the pinned omc.
note No arguments: encode one row of each op 64..79 with enc1 and decode its word with sm121_dis. Every word must
note decode (no ??) and its mnemonic, the text before the first space, must equal the op's entry of omnem.
note Exit 0; 10 + (op - 64) when the encoder refuses the row or the decoder does not know the word; 40 + (op - 64)
note when the mnemonic differs.
note Three arguments: the same check with the rows numbered as before the move (I2FP_U32 .. S32_F64 at 64..78, the
note stale numbering, no ATOMG row). It must fail: the I2FP_U32 row then encodes op 64, ATOMG, so the exit is 41.
note One argument: write the sixteen instructions (256 bytes) on stdout for the ORACLE.
note Two arguments: read the ORACLE's text on stdin and require the decoder's text of each instruction, followed by
note " ;", in order. Exit 0, 4 when a line is missing or out of order, 70 on a read error, 71 when the text is too long.
note Four arguments: print the decoder's text of each instruction, one line each (a word it does not know prints ??).
note ORACLE (independent, not first-party, never shipped): NVIDIA nvdisasm 13.0.85 -b SM121 -hex, run on these
note encoder bytes only. omnem holds the mnemonics it printed for them (evidence/INTEG-280-20261110/opmove-nvdisasm.txt).
note Rows (op: dst, src1, src2, src3), all unguarded, default control:
note   64 ATOMG_MIN_U64_STRONG_SYS R4, R2, R6, UR8   65 I2FP_U32 R4, R2   66 F2I_U32 R4, R2   67 F16_TO_F32 R4, R2
note   68 F32_TO_F16 R4, R2   69 DADD R4, R2, R6   70 DMUL R4, R2, R6   71 DFMA R4, R2, R6, R8
note   72 DSETP (no destination register) R2, R6   73 MUFU_RCP64H R4, R3   74 MUFU_RSQ64H R4, R3
note   75 F64_F32 R4, R2   76 F32_F64 R4, R2   77 F64_S32 R4, R2   78 F64_U32 R4, R2   79 S32_F64 R4, R2
text omnem "ATOMG.E.MIN.64.STRONG.SYS|I2FP.F32.U32|F2I.U32.TRUNC.NTZ|HADD2.F32|F2F.F16.F32|DADD|DMUL|DFMA|DSETP.GE.AND|MUFU.RCP64H|MUFU.RSQ64H|F2F.F64.F32|F2F.F32.F64|I2F.F64|I2F.F64.U32|F2I.F64.TRUNC|"

note the record of row i (op 64 + i) in enc1's operand layout; the caller sets the op number
fn om_row i ulong o edit ulong 16 to void
for k ulong 16
put o k 0
end
put o 1 4
put o 2 2
put o 3 6
put o 4 255
put o 15 1
if eq i 0
put o 5 8
end
if eq i 7
put o 4 8
end
if eq i 8
put o 15 0
end
if or eq i 9 eq i 10
put o 2 3
end
end

note the start of entry i of omnem
fn om_tok i ulong to ulong
s = ulong 0
c = ulong 0
while lt c i
if eq get omnem s 124
c = add c 1
end
s = add s 1
end
ret s
end

note is the text t[0..n) up to its first space entry i of omnem?
fn om_mnem t view uchar 256 n ulong i ulong to bool
s = om_tok i
k = ulong 0
while lt add s k len omnem
c = get omnem add s k
if eq c 124
if eq k n
ret true
end
ret eq get t k 32
end
if ge k n
ret false
end
if ne get t k c
ret false
end
k = add k 1
end
ret false
end

note decode the encoded words w of instruction i (byte address i * 16) into t; sm121_dis's result
fn om_dis w view ulong 4 i ulong t edit uchar 256 to ulong
lo = or get w 0 shl get w 1 32
hi = or get w 2 shl get w 3 32
ret sm121_dis lo hi mul i 16 t
end

note rows st..15; st 0 numbers row i as op 64 + i (the move), st 1 as op 63 + i (the stale numbering)
fn om_self st ulong to int
o = new ulong 16 0
w = new ulong 4 0
t = new uchar 256 0
i = st
while lt i 16
om_row i edit o
put o 0 sub add 64 i st
if ne enc1 view o edit w 0
ret int add 10 i
end
r = om_dis view w i edit t
if ne and r 327680 0
ret int add 10 i
end
if not om_mnem view t and r 65535 i
ret int add 40 i
end
i = add i 1
end
ret 0
end

note the decoder's text of every row, one line each; 10 + (op - 64) when the encoder refuses a row
fn om_list to int
o = new ulong 16 0
w = new ulong 4 0
t = new uchar 256 0
for i ulong 16
om_row i edit o
put o 0 add 64 i
if ne enc1 view o edit w 0
ret int add 10 i
end
r = om_dis view w i edit t
n = and r 65535
put t n 10
if le write 1 t 0 add n 1 0
ret 3
end
end
ret 0
end

fn om_bin to int
o = new ulong 16 0
w = new ulong 4 0
code = new uchar 16384 0
for i ulong 16
om_row i edit o
put o 0 add 64 i
if ne enc1 view o edit w 0
ret int add 10 i
end
store edit code i view w
end
off = ulong 0
while lt off 256
n = write 1 code off sub 256 off
if le n 0
ret 3
end
off = add off ulong n
end
ret 0
end

note is buf[p..) the text t[0..n) followed by " ;"? The caller keeps p + n + 2 within buf's bytes.
fn om_at buf view uchar 65536 p ulong t view uchar 256 n ulong to bool
for j ulong n
if ne get buf add p j get t j
ret false
end
end
if ne get buf add p n 32
ret false
end
ret eq get buf add p add n 1 59
end

note the end of the first match of t[0..n) " ;" in buf[p..bn), or bn + 1 when absent
fn om_find buf view uchar 65536 bn ulong p ulong t view uchar 256 n ulong to ulong
while le add p add n 2 bn
if om_at buf p t n
ret add p add n 2
end
p = add p 1
end
ret add bn 1
end

fn om_check to int
buf = new uchar 65536 0
bn = ulong 0
while lt bn 65536
k = read 0 buf bn sub 65536 bn
if lt k 0
ret 70
end
if eq k 0
break
end
bn = add bn ulong k
end
if eq bn 65536
ret 71
end
o = new ulong 16 0
w = new ulong 4 0
t = new uchar 256 0
pos = ulong 0
for i ulong 16
om_row i edit o
put o 0 add 64 i
if ne enc1 view o edit w 0
ret int add 10 i
end
r = om_dis view w i edit t
if ne and r 327680 0
ret int add 10 i
end
pos = om_find view buf bn pos view t and r 65535
if gt pos bn
ret 4
end
end
ret 0
end

fn main to int
if gt argcnt 5
ret 64
end
if eq argcnt 5
ret om_list
end
if eq argcnt 4
ret om_self 1
end
if eq argcnt 3
ret om_check
end
if eq argcnt 2
ret om_bin
end
ret om_self 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Fake-device fixture. Opens a pipe, never /dev/nvidia. FIONREAD is 21531.
note A wrong expected count is the negative control: this program exits 4.
global ends uchar 8
global count uchar 12
text msg "Omega device boundary"
fn word32 off ulong to int
v = uint 0
for i ulong 4
v = or v shl uint get ends add off i mul i 8
end
ret int v
end
fn main to int
if ne pipefds ends 0 8 0 0
ret 1
end
rd = word32 0
wr = word32 4
if ne write wr msg 0 len msg long len msg
ret 2
end
for i ulong 12
put count i 171
end
if ne devctl rd uint 21531 count 4 4 0
ret 3
end
if ne get count 4 uchar len msg
ret 4
end
if ne devctl neg int 1 uint 21531 count 4 4 neg long 9
ret 5
end
if ne fclose rd 0
ret 6
end
if ne fclose wr 0
ret 7
end
ret 0
end

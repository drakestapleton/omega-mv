note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Residual Linux platform decisions. The C shell owns pointers, locks and OS calls.
note Constants copied from omega_gpu_platform_linux.c and its public handle contract.
fn plat_rest mode ulong m view ulong 16 q edit ulong 16 to ulong
if eq mode 0
pages = and add get m 0 4095 18446744073709547520
if lt pages 4096
ret 0
end
cursor = get m 1
if or lt cursor 65536 gt cursor sub ulong 1099511627776 pages
cursor = 268435456
end
put q 0 pages
put q 1 cursor
put q 2 add cursor pages
ret 1
end
if eq mode 1
if lt get m 0 6
ret 0
end
note Little-endian transport of the six bytes memfd colon.
if ne and get m 1 281474976710655 64202889586029
ret 0
end
ret 1
end
if eq mode 2
if or ge get m 0 get m 5 eq get m 1 0
ret 5
end
if or eq get m 2 0 ne get m 3 get m 1
ret 6
end
kind = get m 4
if and and ne kind 2 ne kind 3 ne kind 4
ret 5
end
ret 0
end
if eq mode 3
ret add mul get m 0 1000000000 get m 1
end
if eq mode 4
put q 0 div get m 0 1000
put q 1 mul rem get m 0 1000 1000000
ret 0
end
if eq mode 5
if ge get m 0 get m 1
ret 1
end
ret 0
end
if eq mode 6
for i ulong 3
if ge add i 1 get m 0
break
end
if eq get m add i 1 0
ret add i 1
end
end
ret 0
end
if eq mode 7
if ne get m 0 0
ret 1
end
if ne get m 1 0
ret 11
end
ret 0
end
if eq mode 8
if ne get m 0 0
ret 5
end
ret 0
end
if eq mode 9
ret div get m 0 1000000
end
ret 0
end

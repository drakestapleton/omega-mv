om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Marker poll through mapget. The caller owns the mapping. A foreign handle traps.
note WolframLanguageEvaluator: {2^31, 2^32-1, 1000000/50000, 2000*(1000000/50000)} -> {2147483648, 4294967295, 20, 40000}.
export fn plat_wait_budget ms ulong to ulong
if eq ms 0
ret ulong 0
end
n = mul ms 20
if lt n 40000
ret n
end
ret ulong 40000
end
export fn plat_wait_hold addr ulong n ulong to long
ret maphold addr n
end
export fn plat_wait_bind handle long fd long to long
ret mapbind handle int fd 0 1
end
export fn plat_wait_drop handle long to long
ret mapdrop handle
end
export fn plat_wait_ge handle long off ulong want ulong polls ulong to long
n = polls
if eq n 0
n = ulong 1
end
i = ulong 0
while lt i n
g = mapget handle off 4
d = and (sub g want) 4294967295
if lt d 2147483648
ret long 0
end
cpurelax
i = add i 1
end
ret neg long 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Anonymous mapwrite plus cpufence. Never opens /dev/nvidia. Exit 0 on the expected prefix bytes.
global b uchar 8
global out uchar 8
fn main to int
h = mapnew neg int 1 0 4096 3 34
if lt h 0
ret 2
end
put b 0 1
put b 1 0
put b 2 0
put b 3 0
put b 4 2
put b 5 0
put b 6 0
put b 7 0
n = mapwrite h 0 b 0 8
if ne n 8
ret 3
end
cpufence
got = mapread h 0 out 0 8
if ne got 8
ret 3
end
if ne get out 0 1
ret 4
end
if ne get out 4 2
ret 4
end
drop = mapdrop h
if ne drop 0
ret 5
end
ret 0
end

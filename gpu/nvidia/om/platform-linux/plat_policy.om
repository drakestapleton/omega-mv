note WolframLanguageEvaluator: IntegerString[{BitOr[BitShiftLeft[2, 28], BitShiftLeft[4, 16], BitShiftRight[40, 2]], BitShiftLeft[17, 27], 18446744073709547520, 1844674407370955161, 18446744073709551615}, 16] -> 2004000a, 88000000, fffffffffffff000, 1999999999999999, ffffffffffffffff
note m[0] selects the decision. q is cleared by the caller. Return 0 means refuse or not-found where the op says so.
fn plat_byte m view ulong 16 idx ulong to ulong
word = div idx 8
shift = mul rem idx 8 8
ret and shr get m add 2 word shift 255
end
fn plat_l2 q edit ulong 16 to ulong
put q 0 537133066
put q 1 0
put q 2 0
put q 3 0
put q 4 2281701376
ret 5
end
fn plat_chan m view ulong 16 to ulong
if or eq get m 1 0 gt get m 1 1
ret 1
end
b0 = get m 2
if or lt b0 50 gt b0 52
ret 1
end
if ne get m 3 0
ret 1
end
ret sub b0 48
end
fn plat_range m view ulong 16 to ulong
nbytes = get m 3
off = get m 2
size = get m 1
if eq nbytes 0
ret 7
end
if gt off size
ret 7
end
if gt nbytes sub size off
ret 7
end
ret 0
end
fn plat_alloc m view ulong 16 q edit ulong 16 to ulong
if ne get m 5 0
put q 0 get m 5
ret 1
end
discrete = get m 1
kind = get m 2
rights = get m 3
cached = get m 4
local = ulong 0
if and and ne discrete 0 ne kind 4 eq and rights 32 0
local = 1
end
if and ne local 0 ne cached 0
put q 0 10
ret 1
end
if ne cached 0
if or ne kind 2 ne and rights 33 0
put q 0 10
ret 1
end
end
put q 0 0
put q 1 local
put q 2 cached
if ne local 0
put q 3 1
else
if ne cached 0
put q 3 2
else
put q 3 3
end
end
ret 1
end
fn plat_page m view ulong 16 q edit ulong 16 to ulong
bytes = get m 1
if eq bytes 0
ret 0
end
if gt bytes 18446744073709547520
ret 0
end
put q 0 and add bytes 4095 18446744073709547520
ret 1
end
fn plat_fit m view ulong 16 to ulong
nwords = get m 1
prefix = get m 2
ring = get m 3
if eq nwords 0
ret 7
end
if gt nwords sub 18446744073709551615 prefix
ret 7
end
words = add nwords prefix
if gt words 4611686018427387903
ret 7
end
if gt mul words 4 ring
ret 7
end
ret 0
end
fn plat_xq m view ulong 16 to ulong
nchan = get m 1
if lt nchan 2
ret 0
end
for i ulong 3
if ge add i 1 nchan
break
end
gen = get m add 5 mul i 2
if eq gen 0
else
if and eq get m add 4 mul i 2 get m 2 eq gen get m 3
ret add i 1
end
end
end
ret 0
end
fn plat_acc m view ulong 16 start ulong stop ulong out edit ulong 1 to ulong
acc = ulong 0
for i ulong 32
if ge add start i stop
break
end
d = plat_byte m add start i
if or lt d 48 gt d 57
ret 0
end
dig = sub d 48
if gt acc 1844674407370955161
ret 0
end
acc = mul acc 10
if gt acc sub 18446744073709551615 dig
ret 0
end
acc = add acc dig
end
if eq start stop
ret 0
end
put out 0 acc
ret 1
end
fn plat_sp c ulong to ulong
if eq c 32
ret 1
end
if eq c 9
ret 1
end
if eq c 10
ret 1
end
if eq c 11
ret 1
end
if eq c 12
ret 1
end
if eq c 13
ret 1
end
ret 0
end
fn plat_min m view ulong 16 q edit ulong 16 to ulong
n = get m 1
if or eq n 0 gt n 32
ret 0
end
if eq plat_byte m 0 45
ret 0
end
i = ulong 0
for k ulong 32
if ge i n
break
end
c = plat_byte m i
if eq plat_sp c 1
i = add i 1
else
break
end
end
sign = ulong 0
if lt i n
c = plat_byte m i
if eq c 43
i = add i 1
end
if eq c 45
sign = 1
i = add i 1
end
end
got = new ulong 1 0
if eq plat_acc m i n got 0
ret 0
end
v = get got 0
if ne sign 0
v = sub 0 v
end
put q 0 v
ret 1
end
fn plat_sm m view ulong 16 to ulong
if eq get m 1 0
ret 0
end
if eq get m 2 0
ret 121
end
ret get m 2
end
fn plat_policy m view ulong 16 q edit ulong 16 to ulong
op = get m 0
if eq op 1
ret plat_l2 q
end
if eq op 2
ret plat_chan m
end
if eq op 3
ret plat_range m
end
if eq op 4
ret plat_alloc m q
end
if eq op 5
ret plat_page m q
end
if eq op 7
ret plat_min m q
end
if eq op 8
if ge get m 1 get m 2
ret 12
end
ret 0
end
if eq op 9

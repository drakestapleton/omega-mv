note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Platform publication barrier and ring-byte store. No device is opened.
note cpufence is AArch64 DSB SY / x86-64 MFENCE (omega-mv retire compiler, MAPPING.md).
note Bound 1048576 is 2^20 (WolframLanguageEvaluator: 2^20 -> 1048576).
om2
export fn plat_fence to long
cpufence
ret long 1
end
export fn plat_ring_store dst edit uchar * bytes view uchar * n ulong to long
if eq n 0
ret long 0
end
if lt 1048576 n
ret long 0
end
for i ulong n
put dst i get bytes i
end
cpufence
ret long n
end
export fn plat_map_store handle long off ulong bytes view uchar * n ulong to long
if eq n 0
ret neg long 22
end
if lt 1048576 n
ret neg long 22
end
wrote = mapwrite handle off bytes 0 n
if ne wrote long n
ret wrote
end
cpufence
ret wrote
end

note Shape words N CI H W CO KH KW SH SW PT PB PL PR DH DW GROUPS LAYOUT DTYPE.
fn cv_mul a ulong b ulong to ulong
if gt a div 1073741823 b
ret 1073741824
end
ret mul a b
end
fn cv_geom h ulong k ulong s ulong p ulong q ulong d ulong to ulong
extent = add mul d sub k 1 1
full = add add h p q
if lt full extent
ret 0
end
ret add div sub full extent s 1
end
fn cv_plan s view ulong 18 ix ulong p edit ulong 32 to ulong
for j ulong 32
put p j 0
end
for j ulong 16
if gt get s j 65535
ret 1
end
if or lt j 9 ge j 13
if eq get s j 0
ret 1
end
end
end
if or gt get s 16 1 gt get s 17 2
ret 1
end
if ne rem get s 1 get s 15 0
ret 1
end
if ne rem get s 4 get s 15 0
ret 1
end
put p 0 cv_geom get s 2 get s 5 get s 7 get s 9 get s 10 get s 13
put p 1 cv_geom get s 3 get s 6 get s 8 get s 11 get s 12 get s 14
if or eq get p 0 0 eq get p 1 0
ret 1
end
put p 12 div get s 1 get s 15
put p 13 2
if eq get s 17 0
put p 13 4
end
put p 2 cv_mul cv_mul cv_mul get s 0 get s 1 get s 2 get s 3
put p 3 cv_mul cv_mul cv_mul get s 4 get p 12 get s 5 get s 6
put p 4 cv_mul cv_mul cv_mul get s 0 get s 4 get p 0 get p 1
put p 5 cv_mul cv_mul get s 0 get s 4 get p 0
for j ulong 4
if gt get p add j 2 1073741823
ret 1
end
end
if ge ix get p 5
ret 1
end
put p 2 mul get p 2 get p 13
put p 3 mul get p 3 get p 13
put p 4 mul get p 4 4
put p 6 div add get p 1 127 128
put p 7 128
put p 14 mul get s 2 get s 3
put p 15 1
put p 16 1
if eq get s 16 1
put p 14 1
put p 15 get s 1
put p 16 get s 4
end
batch = div div ix get p 0 get s 4
oc = rem div ix get p 0 get s 4
grp = div oc div get s 4 get s 15
put p 11 rem ix get p 0
base = mul batch get s 1
base = mul base get s 2
base = mul base get s 3
groupoff = mul grp get p 12
groupoff = mul groupoff get p 14
put p 8 mul add base groupoff get p 13
base = mul oc get p 12
base = mul base get s 5
put p 9 mul mul base get s 6 get p 13
base = add mul batch get s 4 oc
base = mul base get p 0
base = add base get p 11
put p 10 mul mul base get p 1 4
if eq get s 16 1
base = add mul batch get p 0 get p 11
base = mul base get p 1
base = add mul base get s 4 oc
put p 10 mul base 4
end
ret 0
end
note r23 kh count 24 kw count 25 y 26 x 27 kh index 28 kw index 29 weight spatial
note r30 image base r31 weight base r32 output ow clamped r33 row origin r34 validxy r35 scratch.
fn cv_coord ins edit ulong 8192 m edit ulong 512 r edit ulong 128 s view ulong 18 p view ulong 32 to void
ltmp = get r 35
gb ins m 2 ltmp GN get s 2
glt ins m get r 34 get r 25 ltmp
gb ins m 2 ltmp GN get s 3
glt ins m ltmp get r 26 ltmp
gaand ins m get r 34 get r 34 ltmp
gb ins m 17 ltmp get r 25 31
gm ins m ltmp ltmp GM get r 9
gaand ins m get r 34 get r 34 ltmp
gb ins m 17 ltmp get r 26 31
gm ins m ltmp ltmp GM get r 9
gaand ins m get r 34 get r 34 ltmp
gm ins m get r 22 get r 34 GM GN
gm ins m get r 14 get r 25 get s 3 get r 26
ga ins m 8 gr get r 14 get r 14 get r 34 GN 0
gm ins m get r 14 get r 14 get p 15 GN
gw ins m get r 0 get r 14 get p 13 get r 30
gm ins m get r 29 get r 27 get s 6 get r 28
gw ins m get r 1 get r 29 get p 13 get r 31
end
fn cv_back ins edit ulong 8192 m edit ulong 512 r edit ulong 128 cnt ulong top ulong to void
gm ins m cnt get r 9 GM cnt
gp ins m cnt get r 9
gemit ins m 131118 gr GN GN GN GN and sub top get m 0 GM 5
put m add 16 mul get m 5 2 top
put m add 17 mul get m 5 2 sub get m 0 1
put m 5 add get m 5 1
end
fn conv_ir s view ulong 18 ins edit ulong 8192 m edit ulong 512 to ulong
p = new ulong 32 0
r = new ulong 128 0
if ne cv_plan s 0 p 0
ret 1
end
for j ulong 512
put m j 0
end
gs_init ins m r
note Preserve pointer bases in dedicated pairs through shared reduction.
gw ins m get r 30 get r 10 1 get r 0
gw ins m get r 31 get r 10 1 get r 1
gb ins m 2 get r 4 GN get p 1
gb ins m 2 get r 5 GN get p 12
gm ins m get r 11 get r 7 128 get r 6
glt ins m get r 12 get r 11 get r 4
ga ins m 8 gr get r 32 get r 11 get r 12 GN 0
gw ins m get r 19 get r 11 mul get p 16 4 get r 2
gb ins m 2 get r 20 GN mul get p 14 get p 13
gb ins m 2 get r 21 GN mul mul get s 5 get s 6 get p 13
gl ins m 4 get r 33 920

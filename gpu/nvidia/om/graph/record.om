note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Graph constant bank codec. Input addresses are full u64; scalar cells carry raw IEEE u32 bits.
note Kinds RES=1 SW=2 AM=3 GA=4 GT=5 XB=6 GR=7, matching codegen_dec.h.
fn graph_wire v view ulong 16 w edit uint 32 kind uint to ulong
if or lt kind 1 gt kind 7
ret 0
end
for i ulong 32
put w i 0
end
n = ulong 7
if eq kind 1
n = 5
end
if eq kind 2
n = 2
end
if eq kind 3
n = 4
end
if or eq kind 4 eq kind 5
n = 3
end
if eq kind 6
n = 5
end
for i ulong n
put w mul i 2 uint and get v i 4294967295
put w add mul i 2 1 uint shr get v i 32
end
if eq kind 1
put w 10 uint and get v 5 4294967295
put w 11 uint and get v 6 4294967295
end
if eq kind 2
put w 4 uint and get v 2 4294967295
end
if eq kind 5
put w 6 uint and get v 3 4294967295
end
if eq kind 6
put w 10 uint and get v 5 4294967295
end
if eq kind 7
put w 14 uint and get v 7 4294967295
put w 15 uint and get v 8 4294967295
end
ret 1
end

note Launch admission and dimensions shared by every recorder. Zero dimensions are refused before multiplication.
note q: code,gpr,threads,gx,gy,shared,nargs,peak; d: identical launch scalar projection.
fn graph_launch q view ulong 16 d edit ulong 16 to ulong
if or eq get q 2 0 or eq get q 3 0 eq get q 4 0
ret 0
end
if gt mul get q 2 get q 1 65536
ret 2
end
if ne rem get q 1 8 0
ret 3
end
peak = and add get q 7 2 4294967295
if lt get q 1 peak
ret 3
end
for i ulong 16
put d i get q i
end
put d 8 mul mul get q 2 get q 3 get q 4
put d 9 20000
put d 10 200000
ret 1
end

note Pure offset and size operations; host shell only supplies actual buffer base and layout fields.
fn graph_align v ulong to ulong
ret and add v 255 18446744073709551360
end
fn graph_va base ulong dev ulong split ulong off ulong to ulong
if lt off split
ret add base off
end
ret add dev sub off split
end
fn graph_slot base ulong row ulong width ulong to ulong
ret add base mul mul row width 4
end

note Scalar layer schedule, shared by decode, Q36 and Q38. c: model,needsnorm,attention,overlap,splitdown.
note op: norm1 mix2 ab3 gdn4 gather5 attention6 gate7 projection8 residual9 router10 gateup11 swiglu12 down13 combine14 prefetch15.
note p slots are fixed, not host-selected ordering. 0 means skip and 255 means end.
fn graph_order c view ulong 16 p ulong to ulong
model = get c 0
if ge p 18
ret 255
end
if eq p 0
if ne get c 1 0
ret 1
end
ret 0
end
if eq p 1
if and ne model 0 and eq get c 2 0 ne get c 3 0
ret 3
end
ret 0
end
if eq p 2
ret 2
end
if eq p 3
if and ne model 0 and eq get c 2 0 eq get c 3 0
ret 3
end
ret 0
end
if eq p 4
if and ne model 0 eq get c 2 0
ret 4
end
ret 0
end
if eq p 5
if and ne model 0 ne get c 2 0
ret 5
end
ret 0
end
if eq p 6
if or eq model 0 ne get c 2 0
ret 6
end
ret 0
end
if eq p 7
if and eq model 0 ne get c 5 0
ret 15
end
if and ne model 0 ne get c 2 0
ret 7
end
ret 0
end
if eq p 8
ret 8
end
if eq p 9
ret 9
end
if eq p 10
if ne model 2
ret 10
end
ret 0
end
if eq p 11
ret 11
end
if eq p 12
ret 12
end
if eq p 13
ret 13
end
if eq p 14
if and eq model 2 ne get c 4 0
ret 9
end
ret 0
end
if eq p 15
if and eq model 2 ne get c 4 0
ret 16
end
ret 0
end
if eq p 16
ret 14
end
ret 0
end

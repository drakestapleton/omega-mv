note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Copy descriptors: source and destination VAs remain opaque. The executor owns allocation, synchronization and memory movement.
fn graph_copy q view ulong 16 d edit ulong 16 to ulong
if ne and or get q 0 or get q 1 get q 2 15 0
ret 0
end
if ge get q 3 get q 2
ret 2
end
part = sub get q 2 get q 3
if gt part get q 4
part = get q 4
end
put d 0 add get q 0 get q 3
put d 1 add get q 1 get q 3
put d 2 part
put d 3 div part 16
put d 4 div add div part 16 sub get q 5 1 get q 5
ret 1
end
fn graph_xfer q view ulong 16 d edit ulong 16 to ulong
if ne and or get q 1 get q 2 15 0
ret 0
end
if gt add get q 1 get q 2 get q 3
ret 0
end
if ge get q 4 get q 2
ret 2
end
part = sub get q 2 get q 4
if gt part 67108864
part = 67108864
end
put d 2 part
put d 3 get q 4
put d 0 add add get q 0 get q 1 get q 4
put d 1 get q 5
if eq get q 6 0
put d 1 get d 0
put d 0 get q 5
end
ret 1
end

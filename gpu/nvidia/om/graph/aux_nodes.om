note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Standalone decode glue and debug-read gather use the same packed wire ABI as layer nodes.
fn mg_aux c view ulong 16 v view ulong 16 d edit ulong 64 to ulong
for i ulong 64
put d i 0
end
put d 2 1
put d 3 1
put d 4 get c 3
if eq get c 0 0
put d 5 12
if eq get c 1 4
put d 1 0
put d 6 0
else
if eq get c 1 1
put d 1 1
put d 6 4
else
if ne get c 1 6
ret 0
end
put d 1 2
put d 6 9
if eq get c 2 2
put d 1 7
end
end
end
ret gr_pack v d 1
end
if eq get c 0 1
put d 1 3
if eq get c 2 1
put d 1 6
end
put d 2 div get c 4 256
put d 3 get c 5
put d 4 mul get c 4 get c 5
put d 5 5
put d 6 7
ret gr_pack v d 2
end
if ne get c 0 2
ret 0
end
put d 3 div add get c 7 sub get c 6 1 get c 6
put d 4 mul get d 3 get c 6
put d 5 6
ret gr_pack v d 4
end

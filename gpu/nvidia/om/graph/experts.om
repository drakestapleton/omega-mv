note Prefill experts: routed and shared GEMMs are separate launches. cfg15 is routed-segment count; v60..63 are shared segment/maps.
fn mg_exp c view ulong 16 v view ulong 64 d edit ulong 64 p ulong to ulong
for i ulong 64
put d i 0
end
if eq p 0
put d 0 34
ret gr_bperm c v d
end
if eq p 3
put d 0 36
ret gr_bwire c v d
end
if eq p 4
put d 0 37
ret gr_bperm c v d
end
if ge p 7
if ne add get c 6 1 get c 7
if gt get v 30 1
if ne get c 1 0
if eq p 7
put d 0 39
ret gr_bwire c v d
end
put d 0 255
ret 1
end
end
end
t = sub p 7
if eq add get c 6 1 get c 7
t = add t sub get v 30 1
end
if ge t get v 30
put d 0 255
ret 1
end
put d 0 40
put d 20 t
ret gr_bwire c v d
end
put d 7 mul get v 30 sub get c 14 1
put d 8 get c 15
put d 10 get v 40
put d 11 get v 44
put d 12 get v 45
put d 13 get v 42
put d 14 get v 43
put d 0 35
if eq p 2
put d 7 get v 30
put d 8 1
put d 10 get v 60
put d 13 get v 62
put d 14 get v 63
end
if ge p 5
put d 0 38
put d 10 get v 41
put d 11 get v 47
put d 12 get v 48
put d 13 get v 43
if eq p 6
put d 7 get v 30
put d 8 1
put d 10 get v 61
put d 13 get v 63
put d 14 get v 63
end
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note cfg N,max-xbatch,argmax-ctas,H. VAs hidden,logits,token,amv,ami. All xbatch launches precede per-head argmax pairs.
fn mg_finb c view ulong 16 v view ulong 16 d edit ulong 64 p ulong to ulong
a = new ulong 16 0
for i ulong 64
put d i 0
end
chunks = div add get c 0 sub get c 1 1 get c 1
if lt p chunks
h = mul p get c 1
put d 0 7
put d 7 sub get c 0 h
if gt get d 7 get c 1
put d 7 get c 1
end
put d 11 graph_slot get v 0 h get c 3
put d 13 mul get c 2 2048
put d 12 graph_slot get v 1 h get d 13
ret 1
end
j = sub p chunks
h = div j 2
if ge h get c 0
put d 0 255
ret 1
end
put d 0 8
put d 1 5
put d 2 get c 2
put d 3 1
put d 4 mul get c 2 2048
put d 5 8
put a 0 graph_slot get v 1 h get d 4
put a 2 get v 3
put a 3 get v 4
if ne rem j 2 0
put d 1 6
put d 2 1
put d 4 2048
put a 0 get v 3
put a 1 get v 4
put a 3 add get v 2 mul h 256
put a 2 add get a 3 4
end
ret gr_pack a d 3
end

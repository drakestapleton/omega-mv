note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Little-endian binary32 buffers. Byte views match the pinned bridge ABI.
fn hload a view uchar 4194304 i ulong to uint
o = mul i 4
v = ulong get a o
v = or v shl ulong get a add o 1 8
v = or v shl ulong get a add o 2 16
v = or v shl ulong get a add o 3 24
ret uint v
end
fn hstore a edit uchar 4194304 i ulong v uint to void
o = mul i 4
put a o uchar and v 255
put a add o 1 uchar and shr v 8 255
put a add o 2 uchar and shr v 16 255
put a add o 3 uchar shr v 24
end
fn hinit aa edit uchar 4194304 bb edit uchar 4194304 cc edit uchar 4194304 to ulong
for i ulong 1048576
x = mul f32 i 0.25f32
y = div 1.0f32 f32 add 1 rem i 7
hstore aa i bitcast uint x
hstore bb i bitcast uint y
hstore cc i uint 4290838510
end
ret 1
end
fn hello mode ulong aa edit uchar 4194304 bb edit uchar 4194304 cc edit uchar 4194304 out edit ulong 4 to ulong
if gt mode 1
ret 0
end
for j ulong 4
put out j 0
end
if eq mode 0
ret hinit aa bb cc
end
for i ulong 1048576
x = bitcast f32 hload aa i
y = bitcast f32 hload bb i
want = bitcast uint add x y
got = hload cc i
if eq got 4290838510
put out 1 add get out 1 1
end
if ne want got
if eq get out 0 0
put out 2 i
put out 3 ulong want
end
put out 0 add get out 0 1
end
end
ret 1
end

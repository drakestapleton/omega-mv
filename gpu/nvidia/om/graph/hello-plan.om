note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note mode 0 chunk plan, mode 1 scoreboard control. Parameters are source constants.
fn hplan mode ulong c view ulong 16 d edit ulong 16 to ulong
if eq mode 0
base = get c 0
n = sub get c 1 base
if gt n get c 2
n = get c 2
end
if and ne get c 4 0 eq add base n get c 1
if eq get c 4 1
n = add n 1
else
n = sub n 1
end
end
put d 0 mul base 4
put d 1 n
put d 2 div sub add n get c 3 1 get c 3
put d 3 div sub add get c 1 get c 2 1 get c 2
put d 4 mul n 8
put d 5 mul n 4
ret 1
end
if eq mode 1
kind = get c 0
pend = get c 1
stall = ulong 6
wb = ulong 7
rb = ulong 7
np = ulong 0
if eq kind 1
stall = 14
end
if eq kind 2
stall = 4
wb = 0
np = 1
end
if eq kind 3
stall = 4
wb = 2
np = 4
end
if eq kind 4
stall = 4
rb = 1
np = 2
end
if or eq kind 5 eq kind 6
stall = 5
end
if eq kind 6
np = pend
end
v = or shl stall 9 shl wb 14
v = or v shl rb 17
v = or v shl pend 20
if and ge kind 2 le kind 4
v = or v 8192
end
put d 0 v
put d 1 np
ret 1
end
if eq mode 2
total = add get c 1 get c 2
floor = f64 0
if eq get c 0 121
floor = div f64 total mul 195.1f64 1000.0f64
end
measured = bitcast f64 get c 3
pct = f64 0
if gt measured 0.0f64
pct = div mul 100.0f64 floor measured
end
put d 0 total
put d 1 bitcast ulong floor
put d 2 bitcast ulong pct
ret 1
end
if eq mode 3
elem = sub add get c 0 get c 1 1
rel = sub elem get c 0
put d 0 elem
put d 1 div rel get c 2
put d 2 rem rel get c 2
put d 3 add get c 3 mul elem 4
ret 1
end
if eq mode 4
near = ulong 0
dist = ulong 18446744073709551615
past = ulong 1
for k ulong 3
lo = get c mul k 2
hi = get c add mul k 2 1
dd = ulong 0
pst = ulong 1
if ge get c 6 hi
dd = sub get c 6 hi
else
if le add get c 6 get c 7 lo
dd = sub lo add get c 6 get c 7
pst = 0
end
end
if lt dd dist
dist = dd
near = k
past = pst
end
end
put d 0 near
put d 1 dist
put d 2 past
pos = mul near 2
low = get c pos
high = get c add pos 1
put d 3 div sub high add low get c 8 4
ret 1
end
note mode 5 D8 overhead: c0..c2 resident KiB before open, after open, with buffers; c3 own buffer bytes; c4 driver allocation bytes.
note d0 own KiB rounded up, d1 d2 open cost magnitude and sign (1 negative), d3 d4 resident beyond own buffers, d5 driver KiB.
if eq mode 5
ownk = div add get c 3 1023 1024
put d 0 ownk
if ge get c 1 get c 0
put d 1 sub get c 1 get c 0
put d 2 0
else
put d 1 sub get c 0 get c 1
put d 2 1
end
kb = add get c 0 ownk
if ge get c 2 kb
put d 3 sub get c 2 kb
put d 4 0
else
put d 3 sub kb get c 2
put d 4 1
end
put d 5 div add get c 4 1023 1024
ret 1
end
ret 0
end

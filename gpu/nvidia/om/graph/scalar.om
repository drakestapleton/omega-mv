note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The shell observes tensor objects and returned router/GDN addresses; every subsequent binding is selected here.
fn gr_pack a view ulong 16 d edit ulong 64 kind uint to ulong
w = new uint 32 0
rc = graph_wire a w kind
for i ulong 32
put d add i 32 ulong get w i
end
ret rc
end
fn graph_node c view ulong 16 v view ulong 64 d edit ulong 64 p ulong to ulong
for i ulong 64
put d i 0
end
op = graph_order c p
put d 0 op
if or eq op 0 eq op 255
ret 1
end
a = new ulong 16 0
put d 2 1
put d 3 1
put d 4 get c 12
if or eq op 1 or eq op 9 eq op 14
put a 0 get v 0
put a 5 get v 27
put a 6 get v 29
if eq op 1
put d 1 0
put a 3 get v 9
put a 4 get v 1
put a 6 get v 28
end
if eq op 9
put d 1 1
put a 1 get v 5
if and eq get c 0 2 ne p 14
put a 3 get v 20
put a 4 get v 1
put a 6 get v 28
if eq get c 9 4
put d 1 23
end
end
end
if and eq get c 0 2 eq p 14
put d 1 24
end
if eq op 14
put d 1 2
if and eq get c 0 1 eq get c 9 4
put d 1 23
end
if eq get c 0 0
if eq get c 9 2
put d 1 23
end
end
put a 1 get v 8
put a 2 get v 19
put a 3 add get v 9 mul get c 12 4
if eq get c 0 2
put a 3 add get v 9 mul get c 12 8
end
put a 4 get v 1
put a 6 get v 28
if eq add get c 6 1 get c 7
put a 3 get v 10
put a 4 get v 14
if eq get c 10 0
put a 6 get v 29
end
end
if eq get c 0 2
put a 1 get v 5
put a 2 0
end
end
put d 5 12
ret gr_pack a d 1
end
if eq op 2
put d 10 get v 11
put d 11 get v 1
put d 12 get v 2
put d 7 1
put d 8 1
if eq get c 2 0
if ne get c 3 0
if eq get c 11 0
put d 6 1
end
end
end
ret 1
end
if eq op 3
put d 11 get v 1
put d 12 get v 12
ret 1
end
if eq op 4
put d 11 get v 2
put d 12 add get v 2 get v 23
put d 13 get v 12
ret 1
end
if eq op 5
put d 1 4
if eq get c 9 2
put d 1 21
end
put d 2 div add get v 25 255 256
put d 4 get v 25
put d 5 6
put a 0 get v 2
put a 1 get v 13
put a 2 get v 3
ret gr_pack a d 4
end
if eq op 6
put d 11 get v 3
if eq get c 0 0
put d 11 get v 2
end
put d 12 get v 4
put d 13 get c 8
ret 1
end
if eq op 7
put d 1 5
if eq get c 9 3
put d 1 22
end
put d 2 div get v 26 256
put d 4 get v 26
put d 5 7
put a 0 get v 4
put a 1 add get v 3 get v 24
put a 2 get v 4
put a 3 get v 26
ret gr_pack a d 5
end
if eq op 8
put d 10 add get v 11 16
put d 11 get v 15
put d 12 get v 5
put d 7 1
put d 8 1
ret 1
end
if eq op 10
put d 11 get v 0
ret 1
end
if eq op 11
put d 10 get v 16
put d 11 get v 18
put d 12 get v 6
put d 7 get c 14
put d 8 1
if eq get c 0 2
put d 10 add get v 11 32
put d 11 get v 1
end
ret 1
end
if eq op 12
put d 1 3
if eq get c 9 1
put d 1 20
end
put d 2 div get c 13 256
put d 3 get c 14
put d 4 mul get c 14 get c 13
put d 5 5
put a 0 get v 6
put a 1 get v 7
put a 2 get v 28
ret gr_pack a d 2
end
if or eq op 13 eq op 16
put d 10 get v 17
put d 11 get v 7
put d 12 get v 8
put d 7 get c 14
put d 8 get c 14
if eq get c 0 2
put d 10 add get v 11 48
put d 12 get v 5
if eq op 16
put d 11 add get v 7 mul div get c 13 2 4
end
end
ret 1
end
if eq op 15
put d 7 1
put d 8 1
put d 10 add get v 11 16
put d 11 get v 21
put d 12 get v 22
put d 6 1
ret 1
end
ret 0
end

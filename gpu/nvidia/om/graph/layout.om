fn mg_layout c view ulong 32 d edit ulong 64 to ulong
for i ulong 64
put d i 0
end
n = ulong 18
if eq get c 0 1
n = 40
end
if eq get c 0 2
n = 20
end
if eq get c 0 3
n = 23
end
o = ulong 0
for p ulong n
if eq get c 0 1
if eq p 15
put d 60 o
end
end
if eq get c 0 2
if eq p 13
put d 60 o
end
end
if eq get c 0 3
if eq p 10
put d 61 o
o = 0
end
end
put d p o
b = gl_dec c p
if eq get c 0 1
b = gl_q36 c p
end
if eq get c 0 2
b = gl_dense c p
end
if eq get c 0 3
b = gl_pf c p
end
o = graph_align add o b
end
if eq get c 0 3
put d 63 o
else
put d 61 o
end
put d 62 graph_align get c 13
ret 1
end

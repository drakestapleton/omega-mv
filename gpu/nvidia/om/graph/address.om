note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q0: align256, split VA, strided byte offset. Unsigned address arithmetic matches the legacy ABI.
fn mg_addr q view ulong 8 to ulong
if eq get q 0 0
ret and add get q 1 255 18446744073709551360
end
if eq get q 0 1
if lt get q 4 get q 3
ret add get q 1 get q 4
end
ret add get q 2 sub get q 4 get q 3
end
ret add get q 1 mul get q 5 get q 6
end

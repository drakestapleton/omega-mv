note Batch layer scheduler. All head traversal and the GDN immediate-copy dependency belong to Omega.
fn gr_bord c view ulong 16 v view ulong 64 p ulong to ulong
if eq get c 0 3
ret gr_pord c v p
end
n = get v 30
tail = add ulong 4 mul n 2
if ne get c 2 0
tail = add ulong 6 mul n 2
end
if eq p 0
if ne get c 1 0
ret shl ulong 20 32
end
ret 0
end
if eq p 1
ret shl ulong 21 32
end
if eq p 2
if eq get c 2 0
ret shl ulong 22 32
end
ret 0
end
if eq p 3
ret shl ulong 23 32
end
if lt p tail
if eq get c 2 0
j = sub p 4
if eq rem j 2 0
ret or shl ulong 24 32 div j 2
end
ret or shl ulong 25 32 div j 2
end
if eq p 4
ret shl ulong 26 32
end
if eq add p 1 tail
ret shl ulong 41 32
end
j = sub p 5
ret or shl add ulong 27 rem j 2 32 div j 2
end
j = sub p tail
if lt j 9
ret shl add j 30 32
end
if eq get v 58 1
if eq j 9
ret shl ulong 39 32
end
ret shl ulong 255 32
end
j = sub j 9
if lt j n
ret or shl ulong 40 32 j
end
ret shl ulong 255 32
end

fn gr_bwire c view ulong 16 v view ulong 64 d edit ulong 64 to ulong
a = new ulong 16 0
op = get d 0
h = get d 20
put d 2 1
put d 3 get v 30
put d 4 mul get c 12 get v 30
put d 5 12
put a 5 get v 27
put a 6 get v 29
if or eq op 20 eq op 31
put d 1 6
put a 0 get v 0
put a 3 get v 9
put a 4 get v 1
put a 6 get v 28
if eq op 31
put d 1 7
put a 1 get v 38
put a 3 0
put a 4 0
put a 6 get v 29
end
ret gr_pack a d 1
end
if or eq op 39 eq op 40
put d 1 8
if eq get c 9 4
put d 1 25
end
put a 0 get v 0
put a 1 get v 48
put a 2 get v 56
put a 3 add get v 9 mul get c 12 4
put a 4 get v 1
put a 6 get v 28
if eq add get c 6 1 get c 7
put a 3 get v 10
put a 4 get v 14
if eq get c 10 0
put a 6 get v 29
end
end
if eq op 40
put d 1 2
if eq get c 9 4
put d 1 23
end
put d 3 1
put d 4 get c 12
put a 0 graph_slot get v 0 h get c 12
put a 1 graph_slot get v 48 mul h get c 14 get c 12
put a 2 add get v 56 mul h get v 31
if ne add get c 6 1 get c 7
put a 4 graph_slot get v 1 h get c 12
else
put a 4 graph_slot get v 14 h get c 12
if eq get c 0 4
put a 4 get v 14
end
end
end
ret gr_pack a d 1
end
if eq op 33
put d 1 13
put d 3 1
put d 4 mul get v 30 get c 14
put d 5 16
put a 0 get v 53
put a 1 get v 54
put a 2 get v 55
put a 3 get v 40
put a 4 get v 41
put a 5 get v 42
put a 6 get v 43
put a 7 get v 31
put a 8 get v 30
ret gr_pack a d 7
end
if eq op 36
put d 1 3
if eq get c 9 1
put d 1 20
end
put d 2 div get c 13 256
put d 3 mul get v 30 get c 14
put d 4 mul get d 3 get c 13
put d 5 5
put a 0 get v 45
put a 1 get v 46
put a 2 get v 28
ret gr_pack a d 2
end
if eq op 26
put d 1 4
if eq get c 9 2
put d 1 21
end
put d 2 div add get v 25 255 256
put d 4 mul get v 25 get v 30
put d 5 6
put a 0 get v 33
put a 1 get v 13
put a 2 get v 35
ret gr_pack a d 4
end
if or eq op 28 eq op 45
put d 1 5
if eq get c 9 3
put d 1 22
end
put d 2 div get v 26 256
put d 3 1
put d 4 get v 26
put d 5 7
put a 0 graph_slot get v 36 h get v 26
put a 1 add graph_slot get v 35 h get v 25 get v 24
put a 2 get a 0
put a 3 get v 26
if eq op 45
put d 1 26
put d 3 get v 30
put d 4 mul get v 26 get v 30
end
ret gr_pack a d 5
end
ret 0
end

fn gr_bperm c view ulong 16 v view ulong 64 d edit ulong 64 to ulong
a = new ulong 16 0
op = get d 0
put d 1 9
put d 2 div get c 12 256
put d 3 get v 30
put d 4 mul get c 12 get v 30
put d 5 6
put a 0 get v 1
put a 1 get v 49
put a 2 get v 32
if or eq op 25 eq op 43
put d 1 10
put d 2 div get v 26 256
put d 3 1
put d 4 get v 26
put a 0 get v 15
if eq op 29
put a 0 graph_slot get v 36 get d 20 get v 26
end
put a 1 get v 50
put a 2 graph_slot get v 37 get d 20 get v 26
end
if eq op 34
put d 1 11
put a 0 get v 57
put a 2 get v 44
end
if eq op 41
put d 1 10
put d 2 div get v 26 256
put d 4 mul get v 26 get v 30
put a 0 get v 36
put a 1 get v 50
put a 2 get v 37
end
if eq op 37
put d 1 12
put d 2 div get c 13 256
put d 3 mul get v 30 get c 14
put d 4 mul get d 3 get c 13
put a 0 get v 46
put a 1 get v 51
put a 2 get v 47
end
ret gr_pack a d 4
end

fn graph_batch c view ulong 16 v view ulong 64 d edit ulong 64 p ulong to ulong
for i ulong 64
put d i 0
end
code = gr_bord c v p
put d 0 shr code 32
put d 20 and code 4294967295
if or eq get d 0 0 eq get d 0 255
ret 1
end
if or eq get d 0 21 or eq get d 0 25 eq get d 0 41
ret gr_bperm c v d
end
if or eq get d 0 34 or eq get d 0 37 eq get d 0 43
ret gr_bperm c v d
end
if or eq get d 0 20 or eq get d 0 31 eq get d 0 39
ret gr_bwire c v d
end
if or eq get d 0 40 or eq get d 0 33 eq get d 0 36
ret gr_bwire c v d
end
if or eq get d 0 26 or eq get d 0 28 eq get d 0 45
ret gr_bwire c v d
end
put d 7 get v 30
put d 8 1
put d 18 add get c 8 get d 20
put d 10 get v 52
put d 11 get v 32
put d 12 get v 33
if eq get d 0 22
put d 11 get v 1
put d 12 get v 34
end
if eq get d 0 24
put d 11 graph_slot get v 33 get d 20 get v 59
put d 12 add get d 11 get v 23
put d 13 graph_slot get v 34 get d 20 get v 60
end
if eq get d 0 27
put d 11 graph_slot get v 35 get d 20 get v 25
put d 12 graph_slot get v 36 get d 20 get v 26
end
if eq get d 0 30
put d 10 add get v 52 32
put d 11 get v 37
put d 12 get v 38
end
if eq get d 0 32
put d 11 get v 0
put d 12 get v 39
if eq get c 0 3
put d 11 graph_slot get v 0 get d 20 get c 12
put d 12 add get v 39 mul get d 20 get v 31
put d 7 sub get v 30 get d 20
if gt get d 7 get v 62
put d 7 get v 62
end
end
end
if eq get d 0 35
put d 7 mul get v 30 get c 14
put d 8 get d 7
put d 10 get v 40
put d 11 get v 44
put d 12 get v 45
put d 13 get v 42
put d 14 get v 43
end
if eq get d 0 38
put d 7 mul get v 30 get c 14
put d 8 get d 7
put d 10 get v 41
put d 11 get v 47
put d 12 get v 48
put d 13 get v 43
put d 14 get v 43
end
if eq get d 0 42
put d 11 get v 33
put d 12 add get v 33 get v 23
put d 13 get v 34
put d 14 get v 36
put d 15 mul get v 59 4
put d 16 mul get v 60 4
if eq get c 5 5
put d 16 0
end
put d 17 mul get v 26 4
end
if eq get d 0 44
put d 11 get v 35
put d 12 get v 36
put d 15 mul get v 25 4
put d 17 mul get v 26 4
end
ret 1
end

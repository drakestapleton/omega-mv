note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Scalar graph metadata and admission; fixed descriptors avoid object ABI coupling.
fn grshape c view ulong 16 d edit ulong 16 to ulong
hd = get c 0
iw = get c 1
qh = get c 2
kv = get c 3
gh = get c 4
if eq hd 0
hd = 5120
end
if eq iw 0
iw = 17408
end
if eq qh 0
qh = 24
end
if eq kv 0
kv = 4
end
if eq gh 0
gh = 48
end
if or ne rem hd 1024 0 gt hd 5120
ret 0
end
if or eq iw 0 or ne rem iw 256 0 gt iw 17408
ret 0
end
if or gt qh 24 ne rem qh kv 0
ret 0
end
if gt div qh kv 8
ret 0
end
if and ne gh 32 ne gh 48
ret 0
end
if ne mul qh 256 mul gh 128
ret 0
end
put d 0 hd
put d 1 iw
put d 2 qh
put d 3 kv
put d 4 gh
put d 5 mul add 32 gh 128
put d 6 add get d 5 mul gh 128
put d 7 mul 2 gh
put d 8 mul add qh kv 512
put d 9 add mul qh 256 mul kv 512
put d 10 mul qh 256
ret 1
end
fn grmeta mode ulong c view ulong 16 d edit ulong 16 to ulong
if eq mode 0
ret grshape c d
end
if eq mode 1
note layers,maxlayers,vocab,span,heads,maxheads,mask,usesmask
if or eq get c 0 0 gt get c 0 get c 1
ret 0
end
if or eq get c 2 0 gt get c 2 mul get c 3 get c 3
ret 0
end
if or eq get c 4 0 gt get c 4 get c 5
ret 0
end
if and ne get c 7 0 lt get c 0 64
if ne shr get c 6 get c 0 0
ret 0
end
end
put d 0 div sub add get c 2 get c 3 1 get c 3
ret 1
end
if eq mode 2
note mask,layer,attention count,gdn count -> bit,index,updated counts
bit = and shr get c 0 get c 1 1
na = get c 2
ng = get c 3
idx = ng
if ne bit 0
idx = na
na = add na 1
else
ng = add ng 1
end
put d 0 bit
put d 1 idx
put d 2 na
put d 3 ng
ret 1
end
if eq mode 3
note normalize barrier: dependency chains refuse NONE
b = get c 0
if or gt b 4 eq b 1
ret 0
end
ret b
end
if eq mode 4
note Prefill device allocation round-up preserving size_t arithmetic.
ret and add get c 0 4095 18446744073709547520
end
if eq mode 5
if ne get c 0 get c 3
ret 0
end
if ne get c 1 get c 4
ret 0
end
if ne get c 2 get c 5
ret 0
end
ret 1
end
if eq mode 6
skip = ulong 0
if ne get c 0 0
skip = 1
end
if gt get c 0 get c 2
ret 0
end
if gt get c 1 skip
if gt sub get c 1 skip sub get c 2 get c 0
ret 0
end
end
put d 0 skip
ret 1
end
if eq mode 7
limit = get c 1
if eq limit 0
limit = sub get c 2 2
end
if gt limit get c 3
ret 0
end
if gt get c 0 limit
ret 0
end
ret get c 4
end
ret 0
end

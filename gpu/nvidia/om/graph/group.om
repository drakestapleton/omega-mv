note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Fixed public byte spans avoid a dynamic-view ABI. C marshals each eight-id row and scatters the returned stable-map entries.
fn gr_id ids view uchar 32 slot ulong to ulong
p = mul slot 4
ret ulong get ids p
end
fn gr_rate cnt ulong bytes ulong to ulong
ret mul div add cnt 3 4 bytes
end
fn mg_group c view ulong 16 ids view uchar 32 st edit ulong 512 out edit ulong 32 to ulong
for i ulong 32
put out i 0
end
if eq get c 0 0
for s ulong 8
e = gr_id ids s
put st e add get st e 1
end
ret 1
end
if eq get c 0 1
e = get c 6
for i ulong sub 256 e
if ne get st e 0
put out 0 e
put out 1 get c 7
put out 2 get st e
put out 3 get st e
if eq get c 3 2
if gt get st e 1
put out 3 sub get st e 1
end
end
put out 4 gr_rate get st e get c 4
put st add e 256 get c 7
ret 1
end
e = add e 1
end
put out 0 256
ret 1
end
if eq get c 0 2
for s ulong 8
e = gr_id ids s
p = get st add e 256
put out mul s 4 p
put out add mul s 4 1 get c 2
put out add mul s 4 2 p
put out add mul s 4 3 add mul get c 2 9 s
put st add e 256 add p 1
end
ret 1
end
if eq get c 0 3
put out 0 get c 2
put out 1 add mul get c 2 9 8
ret 1
end
if eq get c 0 4
put out 0 mul get c 1 8
put out 1 add get out 0 get c 5
put out 2 get c 1
put out 3 add get c 1 get c 5
put out 4 gr_rate get c 1 get c 4
ret 1
end
ret 0
end

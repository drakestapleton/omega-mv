note Final head cfg: hidden-ready, fp8-head, exact-head, mutant, vocab, argmax-ctas, hidden-width, epsilon-bits, scale-bits, one-bits.
note VAs: x,hidden,logits,token,finalnorm,headtab,amv,ami,h8,screen,bounds,hi,lo,tau,screentab.
fn graph_final c view ulong 16 v view ulong 16 d edit ulong 64 p ulong to ulong
a = new ulong 16 0
for i ulong 64
put d i 0
end
if ge p 10
put d 0 255
ret 1
end
if eq p 0
if ne get c 0 0
ret 1
end
put d 0 1
put d 1 0
put d 2 1
put d 3 1
put d 4 get c 6
put d 5 12
put a 0 get v 0
put a 3 get v 4
put a 4 get v 1
put a 5 get c 7
put a 6 get c 9
if ne get c 1 0
put a 6 get c 8
end
ret gr_pack a d 1
end
if lt p 7
if eq get c 2 0
ret 1
end
end
if eq p 7
if ne get c 2 0
ret 1
end
put d 0 7
if ne get c 11 0
put d 0 10
end
put d 10 get v 5
put d 11 get v 1
put d 12 get v 2
ret 1
end
if eq p 2
put d 0 2
put d 10 get v 14
put d 11 get v 8
put d 12 get v 9
ret 1
end
if eq p 6
put d 0 6
put d 11 get v 1
put d 12 get v 2
put d 13 get v 11
put d 14 get v 13
ret 1
end
put d 2 1
put d 3 1
put d 5 8
put d 4 2048
if or eq p 1 eq p 3
put d 0 3
put d 5 11
put d 1 3
put d 2 div add get c 4 255 256
put d 4 get c 4
put a 0 get v 9
put a 1 get v 10
put a 2 get v 1
put a 3 get v 12
put a 4 get v 11
put a 5 get c 4
if eq get c 3 6
put d 1 4
end
if eq p 1
put d 0 1
put d 1 2
put d 2 div get c 6 256
put d 4 get c 6
put a 0 get v 1
put a 1 0
put a 2 0
put a 3 get v 8
put a 4 0
put a 5 get c 6
end
ret gr_pack a d 6
end
put d 0 8
put d 1 5
put d 2 get c 5
put d 4 mul get c 5 2048
put a 0 get v 2
put a 2 get v 6
put a 3 get v 7
if eq p 4
put a 0 get v 12
end
if or eq p 5 eq p 9
put d 1 6
put d 2 1
put d 4 2048
put a 0 get v 6
put a 1 get v 7
put a 2 add get v 3 4
put a 3 get v 3
if eq p 5
put a 2 get v 13
put a 3 add get v 13 4
end
end
ret gr_pack a d 3
end

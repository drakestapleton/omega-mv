note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Prefill mixer shares batch descriptor roles. Every token/recurrence dependency is selected here, never by the executor.
fn gr_pord c view ulong 16 v view ulong 64 p ulong to ulong
n = get v 30
tail = add ulong 4 mul n 3
multi = get c 3
if or eq get c 5 1 eq get c 5 3
multi = 0
end
if ne get c 2 0
tail = add ulong 8 mul n 2
else
if ne multi 0
tail = 6
end
end
if lt p 4
if eq p 0
if ne get c 1 0
ret shl ulong 20 32
end
ret 0
end
if eq p 1
ret shl ulong 21 32
end
if eq p 2
if eq get c 2 0
ret shl ulong 22 32
end
ret 0
end
ret shl ulong 23 32
end
if lt p tail
if eq get c 2 0
if ne multi 0
if eq p 4
ret shl ulong 42 32
end
ret shl ulong 41 32
end
j = sub p 4
t = div j 3
if eq get c 5 1
if ge n 2
if ge add t 2 n
if eq add t 2 n
t = sub n 1
else
t = sub n 2
end
end
end
end
if eq rem j 3 0
ret or shl ulong 24 32 t
end
if eq rem j 3 1
if eq get c 5 3
if lt add t 1 n
ret 0
end
end
ret or shl ulong 25 32 t
end
if eq get c 5 3
if gt t 0
ret or shl ulong 43 32 sub t 1
end
end
ret 0
end
if eq p 4
ret shl ulong 26 32
end
if eq p 5
if ne get c 4 0
ret shl ulong 44 32
end
ret 0
end
if eq add p 1 tail
ret shl ulong 41 32
end
if eq add p 2 tail
if ne get c 4 0
if ne get c 9 3
ret shl ulong 45 32
end
end
ret 0
end
j = sub p 6
t = div j 2
if ne get c 4 0
if ne get c 9 3
ret 0
end
if eq rem j 2 0
ret 0
end
end
ret or shl add ulong 27 rem j 2 32 t
end
j = sub p tail
if eq j 0
ret shl ulong 30 32
end
if eq j 1
ret shl ulong 31 32
end
j = mul sub j 2 get v 62
if ge j n
ret shl ulong 255 32
end
ret or shl ulong 32 32 j
end

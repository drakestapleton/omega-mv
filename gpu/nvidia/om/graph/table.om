note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn grperm i ulong r ulong to ulong
p = div r 2
if lt i 128
if lt i p
ret i
end
ret add r sub i p
end
j = sub i 128
if lt j p
ret add p j
end
ret add r sub add 128 j p
end
fn grpslot n ulong to ulong
s = mul div n 512 512
j = rem n 512
s = add s mul rem div j 4 32 16
s = add s mul div j 128 4
ret add s rem j 4
end
fn grgslot n ulong qh ulong kv ulong to ulong
qn = mul qh 256
kn = mul kv 256
qkv = add qn mul 2 kn
if lt n qn
ret add mul div n 256 512 grperm rem n 256 64
end
if lt n add qn kn
s = add mul qh 512 mul div sub n qn 256 256
ret add s grperm rem n 256 64
end
if lt n qkv
ret add mul qh 512 sub n qn
end
s = add mul div sub n qkv 256 512 256
ret add s rem sub n qkv 256
end
fn grtable mode ulong qh ulong kv ulong tab edit uint 24576 to ulong
if ne mode 0
if or eq qh 0 gt qh 24
ret 0
end
if eq kv 0
ret 0
end
if ne rem qh kv 0
ret 0
end
end
for i ulong len tab
s = ulong 0
if eq mode 0
s = grpslot i
else
s = grgslot i qh kv
end
put tab i uint s
end
ret 1
end

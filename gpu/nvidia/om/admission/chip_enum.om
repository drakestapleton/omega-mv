note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note enum: 0 table row identity, 1 raw sysfs vendor, 2 display class, 3 PCI field mask.
fn ce_eq a ulong b ulong to ulong
if eq a b
ret 1
end
ret 0
end
fn chip_enum mode ulong a ulong b ulong c ulong d ulong to ulong
if eq mode 0
ret and ce_eq a c ce_eq b d
end
if eq mode 1
ret ce_eq a 4318
end
if eq mode 2
ret ce_eq shr a 16 3
end
ret and a b
end

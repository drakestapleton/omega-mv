note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Folded final RMSNorm weight bits. Return positive upper-norm f32 bits, or zero to refuse.
fn q38_envelope bits view uint 5120 to ulong
mx = ulong 0
for i ulong 5120
v = and ulong get bits i 2147483647
if ge v 2139095040
ret 0
end
if gt v mx
mx = v
end
end
note Tiny or zero weights use the conservative constant 1.0.
if lt mx 8388608
ret 1065353216
end
note 72 bounds sqrt(5120). 1025/1024 provides normalization rounding slack.
ex = and shr mx 23 255
sig = or and mx 8388607 8388608
sig = mul sig 73800
shift = ulong 0
while gt sig 16777215 bound 64
sig = div add sig 1 2
shift = add shift 1
end
ex = sub add ex shift 10
if ge ex 255
ret 0
end
ret or shl ex 23 sub sig 8388608
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
global QEIn uchar 20480
global QEOut uchar 8
fn main to int
off = ulong 0
while lt off 20480 bound 20480
n = read 0 QEIn off sub 20480 off
if le n 0
ret 65
end
off = add off ulong n
end
bits = new uint 5120 0
for i ulong 5120
v = ulong 0
for j ulong 4
v = or v shl ulong get QEIn add mul i 4 j mul j 8
end
put bits i uint v
end
v = q38_envelope bits
for j ulong 8
put QEOut j uchar and shr v mul j 8 255
end
if ne write 1 QEOut 0 8 8
ret 74
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Generated bounds kernel through the checked allocator and encoder.
fn q38_emit code edit uchar 16384 to ulong
ins = new ulong 8192 0
meta = new ulong 2048 0
phys = new ulong 288 0
st = new ulong 4 0
rs = new ulong 4 0
if ne q38_bounds ins meta st 0
ret 0
end
if ne bc_ircheck ins get st 0 meta 0
ret 0
end
if ne bc_regalloc ins get st 0 meta phys rs 128 0
ret 0
end
ret bc_encode ins phys get st 0 1 code
end

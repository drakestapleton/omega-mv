note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure layout and schedule for the experimental 27B exact head.
note Info: norm bits, scratch bytes, rounding count, scaled, scores, coefficients, lo, hi, tau, padded count.
fn q38_layout q edit ulong 192 to void
put q 2 10384
put q 3 0
put q 4 20480
put q 5 add get q 4 mul ulong 248320 4
put q 6 add get q 5 mul ulong 248320 4
put q 9 mul div add ulong 248320 2047 2048 2048
put q 7 add get q 6 mul get q 9 4
put q 8 add get q 7 mul ulong 248320 4
put q 1 add get q 8 256
note Additional admission reserve for the resident screen, coefficients and scratch, rounded conservatively to 2 GiB.
put q 10 shl ulong 1 31
end
note A descriptor has kind, grid, element count, input A, input B, output A, output B, scalar, count.
fn q38_schedule m view ulong 16 q edit ulong 192 to ulong
if ne get m 1 248320
ret 0
end
if or eq get m 2 0 ge get m 2 2139095040
ret 0
end
for j ulong 6
v = get m add j 3
if or eq v 0 ge v shl ulong 1 48
ret 0
end
if ne rem v 16 0
ret 0
end
end
lay = new ulong 192 0
q38_layout lay
base = get m 3
hidden = get m 4
for j ulong 192
put q j 0
end
note Scale hidden by 2^64, then compact FP8 screen.
put q 0 1
put q 1 20
put q 2 5120
put q 3 hidden
put q 5 add base get lay 3
put q 8 5120
put q 16 2
put q 19 get m 8
put q 20 add base get lay 3
put q 21 add base get lay 4
note Conservative intervals, then maximum lower bound.
put q 32 3
put q 33 div add ulong 248320 255 256
put q 34 248320
put q 35 add base get lay 4
put q 36 add base get lay 5
put q 37 add base get lay 6
put q 38 add base get lay 7
put q 39 get m 2
put q 40 248320
put q 48 4
put q 49 div get lay 9 2048
put q 50 get lay 9
put q 51 add base get lay 6
put q 53 get m 6
put q 54 get m 7
put q 64 5
put q 65 1
put q 66 2048
put q 67 get m 6
put q 68 get m 7
put q 69 add base get lay 8
put q 70 add add base get lay 8 4
note Recheck retained candidates with the original BF16 weights and hidden values.
put q 80 6
put q 83 hidden
put q 84 add base get lay 7
put q 85 get m 5
put q 86 add base get lay 8
ret 6
end
note m[0]=1: info from folded weights. m[0]=2: six schedule descriptors.
note Schedule m[1..8]=vocab,norm bits,scratch,hidden,logits,argmax values,argmax indices,FP8 table.
fn q38_runtime m view ulong 16 bits view uchar 20480 q edit ulong 192 to ulong
if eq get m 0 2
ret q38_schedule m q
end
if and eq get m 0 3 eq get m 1 248320
for j ulong 192
put q j 0
end
q38_layout q
ret 1
end
if or ne get m 0 1 ne get m 1 248320
ret 0
end
wb = new uint 5120 0
for i ulong 5120
v = ulong 0
for j ulong 4
v = or v shl ulong get bits add mul i 4 j mul j 8
end
put wb i uint v
end
hn = q38_envelope wb
if eq hn 0
ret 0
end
for j ulong 192
put q j 0
end
q38_layout q
put q 0 hn
ret 1
end

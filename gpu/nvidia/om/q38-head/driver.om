note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
global QHOut uchar 8
fn qh_word v ulong to void
for j ulong 8
put QHOut j uchar and shr v mul j 8 255
end
if ne write 1 QHOut 0 8 8
trap 5
end
end
fn main to int
ins = new ulong 8192 0
meta = new ulong 2048 0
phys = new ulong 288 0
st = new ulong 4 0
rs = new ulong 4 0
code = new uchar 16384 0
if ne q38_bounds ins meta st 0
ret 66
end
if ne bc_ircheck ins get st 0 meta 0
ret 69
end
if ne bc_regalloc ins get st 0 meta phys rs 128 0
ret 67
end
nbytes = bc_encode ins phys get st 0 1 code
if eq nbytes 0
ret 68
end
for k ulong 4
qh_word get st k
end
qh_word get rs 1
qh_word get rs 2
for k ulong get st 1
qh_word get meta k
qh_word get phys k
end
for k ulong get st 2
qh_word get meta add k 256
qh_word get phys add k 256
end
for k ulong mul get st 0 8
qh_word get ins k
end
if ne write 1 code 0 nbytes long nbytes
ret 74
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shape rows,length,dtype,op,epsilon_bits. Plan input bytes,output bytes,rows,threads.
fn dr_plan s view ulong 8 p edit ulong 16 to ulong
for i ulong 16
put p i 0
end
if or eq get s 0 0 gt get s 0 65535
ret 1
end
if or eq get s 1 0 gt get s 1 65535
ret 1
end
if or gt get s 2 2 gt get s 3 2
ret 1
end
if ne get s 3 0
if or lt get s 4 8388608 ge get s 4 2139095040
ret 1
end
end
n = mul get s 0 get s 1
if gt n 1073741824
ret 1
end
bytes = ulong 4
if ne get s 2 0
bytes = ulong 2
end
put p 0 mul n bytes
put p 1 mul n 4
put p 2 get s 0
put p 3 32
ret 0
end

note One complete warp per row. Uniform ceil(length/32) loops, predicated tails.
note Params input ptr 896,output ptr 904,epsilon f32 912. All accumulation/output f32.
note Registers lane0,row1,pointers2..5,index6,length7,value8,acc9,stat10,inv11,tmp12,
note epsilon13,log2e14,invlength15,rowbase16,step17,iteration18,chunks19,linear20,one21.
fn dr_copy x edit ulong 8192 m edit ulong 512 d ulong a ulong to void
aa_mad x m d a 1 AN
end
fn dr_begin x edit ulong 8192 m edit ulong 512 dim ulong to void
for i ulong 22
k = ulong 1
if and ge i 2 le i 5
k = ulong 2
end
v = aa_v m k
end
put m 2 1
put m 320 2
aa_i x m 7 aa_rg 0 AN AN AN 856 260
for i ulong 22
if or lt i 2 gt i 5
aa_mov x m i 0
end
end
aa_i x m 3 aa_rg 0 AN AN AN 33 2
aa_i x m 3 aa_rg 1 AN AN AN 37 2
aa_i x m 5 aa_rg 2 AN AN AN 896 2
aa_i x m 5 aa_rg 3 AN AN AN 904 2
aa_i x m 4 aa_rg 13 AN AN AN 912 2
aa_mov x m 7 dim
aa_mov x m 14 1069066811
f = div f32 1.0 f32 dim
aa_mov x m 15 ulong bitcast uint f
aa_mad x m 16 1 dim AN
aa_mov x m 17 32
aa_mov x m 19 div add dim 31 32
aa_mov x m 21 1
end
fn dr_load x edit ulong 8192 m edit ulong 512 mode ulong to void
aa_mad x m 20 16 1 6
bytes = ulong 4
if ne mode 0
bytes = ulong 2
end
aa_addr x m 4 20 bytes 2
aa_mov x m 8 0
aa_cmp x m 6 7
aa_load x m 8 4 0 or mode 1536
end
fn dr_exp x edit ulong 8192 m edit ulong 512 to void
aa_bin x m 31 8 8 10
aa_bin x m 32 8 8 14
aa_i x m 47 aa_rg 8 8 AN AN 0 2
end
fn dr_step x edit ulong 8192 m edit ulong 512 start ulong to void
aa_mad x m 6 6 1 17
aa_mad x m 18 18 1 21
aa_cmp x m 18 19
aa_bra x m sub start get m 0 6
n = get m 5
put m add 16 mul n 2 start
put m add 17 mul n 2 sub get m 0 1
put m 5 add n 1
end
fn dr_reduce x edit ulong 8192 m edit ulong 512 op ulong to void
for j ulong 5
aa_i x m 60 aa_rg 12 9 AN AN shr ulong 16 j 2
aa_bin x m op 9 9 12
end
end
fn dr_pass x edit ulong 8192 m edit ulong 512 kind ulong mode ulong phase ulong to void
dr_copy x m 6 0
aa_mov x m 18 0
aa_mov x m 9 0
if and eq kind 0 eq phase 0
aa_mov x m 9 4286578688
end
start = get m 0
dr_load x m mode
if eq kind 0
aa_mov x m 8 4286578688
aa_pred x m 2
if eq phase 0
aa_bin x m 37 9 9 8
else
dr_exp x m
aa_bin x m 30 9 9 8
end
else
if and eq kind 1 eq phase 0
aa_bin x m 30 9 9 8
else
if eq kind 1
aa_bin x m 31 8 8 10
end
aa_mov x m 8 0
aa_pred x m 2
aa_bin x m 32 8 8 8
aa_bin x m 30 9 9 8
end
end
dr_step x m start
op = ulong 30
if and eq kind 0 eq phase 0
op = ulong 37
end
dr_reduce x m op
end
fn dr_output x edit ulong 8192 m edit ulong 512 kind ulong mode ulong to void
dr_copy x m 6 0
aa_mov x m 18 0
start = get m 0
dr_load x m mode
if eq kind 0
dr_exp x m
else
if eq kind 1
aa_bin x m 31 8 8 10
end
end
aa_bin x m 32 8 8 11
aa_addr x m 5 20 4 3
aa_cmp x m 6 7
aa_i x m 12 aa_rg AN 5 8 AN 0 1539
dr_step x m start
aa_i x m 45 aa_rg AN AN AN AN 0 5
end
fn dnn_rows kind ulong dim ulong mode ulong mutant ulong x edit ulong 8192 m edit ulong 512 to ulong
for i ulong 512
put m i 0
end
if or or gt kind 2 ne mutant 0 or eq dim 0 gt dim 65535
ret 1
end
if gt mode 2
ret 1
end
dr_begin x m dim
dr_pass x m kind mode 0
if ne kind 2
if eq kind 1
aa_bin x m 32 9 9 15
end
dr_copy x m 10 9
dr_pass x m kind mode 1
end
if eq kind 0
aa_i x m 40 aa_rg 11 9 AN AN 0 2
else
aa_bin x m 32 9 9 15
aa_bin x m 30 9 9 13
aa_i x m 41 aa_rg 11 9 AN AN 0 2
end
dr_output x m kind mode
if ne get m 4 0
ret 2
end
ret 0
end

end
fn bw_half h ulong to ulong
sign = shl and h 32768 16
exp = and shr h 10 31
mant = and h 1023
if eq exp 0
if eq mant 0
ret sign
end
ret or sign bw_sub mant
else
if eq exp 31
ret or sign or 2139095040 shl mant 13
end
end
ret and or sign or shl add exp 112 23 shl mant 13 4294967295
end
fn bw_scalar op ulong x ulong y ulong z ulong w ulong v ulong to ulong
if eq op 1
ret bw_half x
end
if eq op 2
ret shl and x 65535 16
end
if eq op 3
if and eq and x 2139095040 2139095040 ne and x 8388607 0

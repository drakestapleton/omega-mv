b = and add add x y 4095 18446744073709547520
if lt b 4096
ret 4096
end
ret b
end
if eq op 7
if eq y 0
ret x
end
ret 18446744073709551615
end
if eq op 8
if and eq x 0 eq y 0
ret 0

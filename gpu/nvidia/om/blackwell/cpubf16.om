note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn bw_bdot a view ushort * b view ushort * r ulong sh ulong to f32
nn = and sh 4294967295
kk = shr sh 32
ai = and mul div r nn kk 4294967295
bi = rem r nn
sum = bitcast f32 uint 0
for p ulong 4294967295
if ge p kk
ret sum
end
x = bitcast f32 shl uint get a ai 16
y = bitcast f32 shl uint get b bi 16
sum = add sum mul x y
ai = and add ai 1 4294967295
bi = and add bi nn 4294967295
end
ret sum
end
fn bw_cpubf16 a view ushort * b view ushort * c edit f32 * to int
nn = bw_dim len a len b len c
if eq nn 0
ret -1
end
kk = div len b nn
sh = or shl kk 32 nn
for t ulong 18446744073709551615
if ge t len c
ret 0
end
v = bw_bdot view a view b t sh
put c and t 4294967295 v
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Three positive runtime lengths determine row-major m,k,n uniquely.
note Cancel denominator before multiplying: reduced product is n squared.
fn bw_gcd a ulong b ulong to ulong
while ne b 0
r = rem a b
a = b
b = r
end
ret a
end
fn bw_root x ulong to ulong
lo = ulong 1
hi = ulong 4294967295
ans = ulong 0
while le lo hi
mid = add lo shr sub hi lo 1
if le mid div x mid
ans = mid
lo = add mid 1
else
hi = sub mid 1
end
end
ret ans
end
fn bw_dim a ulong b ulong c ulong to ulong
if or eq a 0 or eq b 0 eq c 0
ret 0
end
d = bw_gcd a b
aa = div a d
bb = div b d
e = bw_gcd aa c
aa = div aa e
cc = div c e
if ne aa 1
ret 0
end
if gt bb div 18446744073709551615 cc
ret 0
end
sq = mul bb cc
nn = bw_root sq
if or eq nn 0 ne mul nn nn sq
ret 0
end
if ne rem b nn 0
ret 0
end
kk = div b nn
if or eq kk 0 gt kk 4294967295
ret 0
end
if ne rem a kk 0
ret 0
end
mm = div a kk
if or eq mm 0 gt mm 4294967295
ret 0
end
if ne mul mm nn c
ret 0
end
ret nn
end

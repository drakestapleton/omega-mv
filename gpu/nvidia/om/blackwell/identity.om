note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Canonical identity encodings, composed with cache/digest.om.
fn bw_word msg edit uchar 4096 off ulong word ulong to void
for j ulong 4
v = and shr word mul j 8 255
put msg add off j uchar v
end
end
fn bw_identity op ulong nums view ulong 4 ids view uchar 96 out edit uchar 32 to int
msg = new uchar 4096 0
if eq op 0
for i ulong 3
bw_word msg mul i 4 get nums i
end
put msg 12 uchar and get nums 3 255
ret kc_sha msg 16 out
end
if eq op 1
put msg 0 78
put msg 1 86
put msg 2 73
put msg 3 68
put msg 4 73
put msg 5 65
put msg 6 95
put msg 7 68
put msg 8 71
put msg 9 88
put msg 10 95
put msg 11 83
put msg 12 80
put msg 13 65
put msg 14 82
put msg 15 75
put msg 16 95
put msg 17 71
put msg 18 66
put msg 19 49
put msg 20 48
put msg 21 95
put msg 22 83
put msg 23 77
put msg 24 49
put msg 25 50
put msg 26 49
ret kc_sha msg 27 out
end
if eq op 2
for i ulong 96
put msg i get ids i
end
bw_word msg 96 get nums 0
ret kc_sha msg 100 out
end
ret -1
end

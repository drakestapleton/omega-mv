note Scalar contracts of standalone host instruments. C owns transport and libm effects.
note op numbers are private to oracle.h, not a runtime public API.
fn so_oracles op ulong a ulong b ulong c ulong d ulong to ulong
if eq op 0
ret ulong mul uint a 2654435761
end
if eq op 1
ret ulong sub uint 4294967295 mul uint a 7
end
if eq op 2
ret ulong add uint a uint b
end
if eq op 3
if eq a b
ret 1
end
ret 0
end
if eq op 4
if and ne a 0 and ne b 0 ne c 0
ret 1
end
ret 0
end
if eq op 5
ret add a b
end
if eq op 6
ret mul add a c b
end
if eq op 7
ret div add a 255 256
end
if eq op 8
ret or a shl b 32
end
if eq op 9
ret mul sub b a 2
end
if eq op 10
if or eq a 1 and eq a 2 ge b 1024
ret 17
end
ret 0
end
if eq op 11
if eq a 0
ret 4
end
ret 8
end
if eq op 12
if gt a 1
ret sub a 1
end
ret 0
end
if eq op 13
if lt a 2
ret 1
end
ret 0
end
if eq op 14
if and eq a b eq c d
ret 1
end
ret 0
end
if eq op 15
if le a 64
ret 4
end
ret 8
end
if eq op 16
if le a 64
ret 0
end
ret 4
end
if eq op 17
ret 2147483648
end
if eq op 18
x = mul f32 sub long rem a 7 3 0.25
ret ulong bitcast uint x
end
if eq op 19
x = mul f32 sub long rem a 5 2 0.5
ret ulong bitcast uint x
end
if eq op 20
x = sub f64 bitcast f32 uint a f64 bitcast f32 uint b
if lt x 0.0
x = neg x
end
ret bitcast ulong x
end
if eq op 21
if gt bitcast f64 a 0.0001
ret 1
end
ret 0
end
if eq op 22
ret ulong add mul uint a 1664525 1013904223
end
if eq op 23
x = sub div f32 shr uint a 8 8388608.0 1.0
ret ulong bitcast uint x
end
if eq op 24
if lt and a 2147483647 2139095040
ret 1
end
ret 0
end
if eq op 25
x = bitcast f32 uint a
y = bitcast f32 uint and b 2147483647
if gt y x
ret ulong bitcast uint y
end
ret a
end
if eq op 26
if eq b 0
ret ulong bitcast uint f32 sub long rem a 67 33
end
ret ulong bitcast uint f32 rem a 17
end
if eq op 27
if eq b 0
ret ulong bitcast uint f32 1.0
end
if eq b 1
if eq a 5119
ret ulong bitcast uint f32 1.0
end
ret 0
end
if eq rem a 2 1
ret ulong bitcast uint f32 1.0
end
ret ulong bitcast uint f32 -1.0
end
if eq op 28
if eq a 0
ret add b 1
end
ret b
end
if eq op 29
if ge bitcast f32 uint a bitcast f32 uint b
ret 1
end
ret 0
end
if eq op 30
if gt bitcast f32 uint a bitcast f32 uint b
ret a
end
ret b
end
if eq op 31
ret ulong bitcast uint f32 sub long rem a 173 90
end
if eq op 32
ret ulong bitcast uint f32 sub long rem a 143 80
end
if eq op 33
if gt a b
ret 1
end
ret 0
end
ret 18446744073709551615
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note tr[0..7] is OmegaParityTrace, 8=index, 9=compare,
note 11=present buffers, 12=FP environment. Modes init parity/seed, step parity/seed.
fn trpar tr edit ulong 16 ex ulong got ulong ix ulong to ulong
put tr 0 add get tr 0 1
if eq get tr 9 0
if eq nrclass 4 ex 1
put tr 5 add get tr 5 1
end
end
if eq cmpeq get tr 9 ex got 0
if eq get tr 1 0
put tr 2 ix
put tr 3 ex
put tr 4 got
end
put tr 1 add get tr 1 1
end
ret 0
end
fn trseed tr edit ulong 16 r ulong got ulong ix ulong to ulong
if eq r 0
put tr 7 add get tr 7 1
else
put tr 0 add get tr 0 1
if eq and r 3 2
if eq get tr 6 0
put tr 2 ix
put tr 3 shr r 32
put tr 4 got
end
put tr 6 add get tr 6 1
end
end
ret 0
end
fn numeric_trace mode ulong op ulong ex ulong got ulong tr edit ulong 16 to ulong
if lt mode 2
if or ge op 42 ne get tr 11 1
ret 1
end
if eq mode 1
if ne get tr 9 2
ret 3
end
if ne get tr 12 1
ret 5
end
end
for k ulong 8
put tr k 0
end
put tr 2 18446744073709551615
if and eq mode 0 eq get tr 9 2
ret 3
end
ret 0
end
if eq mode 2
if eq op 18
if ne rem get tr 8 32 0
ret 0
end
end
ret trpar tr ex got get tr 8
end
r = nrseed op ex got
ret trseed tr r got get tr 8
end

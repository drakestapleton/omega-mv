note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Integer-only freestanding binary32 to bf16 RNE; preserve quiet NaN payload.
note WolframLanguageEvaluator: FromDigits[#,16]& /@ {"7f800000","007fffff","0040","7fff"}
note -> {2139095040,8388607,64,32767}.
fn no_bf16 raw ulong to ulong
u = uint raw
if eq and u 2139095040 2139095040
if ne and u 8388607 0
ret ulong or shr u 16 64
end
end
u = add add u 32767 and shr u 16 1
ret ulong shr u 16
end

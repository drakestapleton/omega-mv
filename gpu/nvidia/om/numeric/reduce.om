note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One padded hierarchy stage, or explicitly non-contract left fold.
fn numeric_reduce op ulong n ulong t view ulong 32 seq ulong init ulong to ulong
v = new ulong 32 0
if eq seq 1
r = init
for i ulong n
r = fadd32 r get t i
end
ret r
end
for i ulong 32
x = nrreduce 0 op 0 0 0
if lt i n
x = get t i
end
put v i x
end
ret numeric_tile op v
end

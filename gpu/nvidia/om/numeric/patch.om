note Literal encodings copied from the frozen numeric patch table; decimal
note values evaluated from its hex words by WolframLanguageEvaluator.
fn word4 k ulong a ulong b ulong c ulong d ulong to ulong
if eq k 0
ret a
end
if eq k 1
ret b
end
if eq k 2
ret c
end
ret d
end
fn patchct op ulong to ulong
if ge op 42
ret 4294967295
end
if and ge op 14 le op 17
ret 4294967294
end
if or or le op 3 eq op 6 or eq op 7 eq op 8
ret 1
end
if or or eq op 36 eq op 39 eq op 40
ret 1
end
if or eq op 4 eq op 5
ret 4
end
if and ge op 19 le op 31
ret 4
end
if eq op 12
ret 7
end
if eq op 18
ret 12
end
if eq op 41
ret 6
end
ret 3
end

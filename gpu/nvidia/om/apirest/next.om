note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q: tile cursor, row base, count, bm, two acquired VAs, expert, row prefix, next expert.
fn arnext q edit ulong 12 cnt view uint * to ulong
for e ulong 4294967296
if ge get q 8 len cnt
ret 0
end
i = get q 8
put q 8 add i 1
n = get cnt i
if ne n 0
put q 6 i
put q 1 get q 7
put q 2 ulong n
put q 7 ulong add uint get q 7 n
ret 1
end
end
ret 0
end

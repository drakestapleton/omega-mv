fn artcperm x view f32 * y edit ushort * to ulong
if ne len x len y
ret 1
end
for i ulong 18446744073709551615
if ge i len x
break
end
o = rem i 4
if eq o 1
o = 2
else
if eq o 2
o = 1
end
end
p = add sub i rem i 4 o
v = mul get x p bitcast f32 uint 1602224128
put y i ushort av_rne bitcast uint v
end
ret 0
end

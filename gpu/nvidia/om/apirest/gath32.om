om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn argath32 rows view uint * x view uint * y edit uint * to ulong
if eq len rows 0
ret 0
end
k = div len y len rows
for r ulong 4294967296
if ge r len rows
break
end
p = mul ulong get rows r k
d = mul r k
for c ulong 18446744073709551615
if ge c k
break
end
put y add d c get x add p c
end
end
ret 0
end

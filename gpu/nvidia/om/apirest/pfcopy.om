note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn arpfcopy q view ulong 4 w view uchar * y edit uchar * to ulong
for p ulong 4294967296
if ge p get q 0
break
end
src = p
if eq get q 2 1
src = swsrc uint p uint get q 0
end
a = mul src get q 1
b = mul p get q 1
for c ulong 4294967296
if ge c get q 1
break
end
put y add b c get w add a c
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn artspec q view uint 8 y edit uint 10 to ulong
v = tgspec get q 2 get q 3 get q 1
put y 0 get q 0
put y 1 get q 1
put y 2 uint v
put y 3 2
put y 4 uint shr v 32
put y 5 32
a = get q 4
if eq a 0
a = 1
end
put y 6 a
put y 7 get q 5
put y 8 get q 6
put y 9 get q 7
ret 0
end

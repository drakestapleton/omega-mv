note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn arsegok n uint cnt uint e view uint 3 sc view f32 3 to ulong
if ne segend 0 cnt 1 1 0 0
ret 0
end
prev = uint 0
for i ulong ulong cnt
if eq finite bitcast uint get sc i 0
ret 0
end
if ne segend uint i cnt n get e i prev 0
ret 0
end
prev = get e i
end
ret 1
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Composed with apish_pack.om, preserving its scalar scale and NaN rules.
fn ar_nan x view uchar * y edit ulong 2 to ulong
n = ulong 0
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
if ne isnanb uint get x i 0
if eq n 0
put y 0 i
end
n = add n 1
end
end
base = add base 65536
end
put y 1 n
ret 0
end
fn ar_scale mut ulong x view ushort * y edit f32 * to ulong
if ne len x len y
ret 1
end
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
v = scalef uint get x i uint mut
if ne shr v 32 0
ret 1
end
put y i bitcast f32 uint v
end
base = add base 65536
end
ret 0
end
fn ar_fold x view f32 * y edit f32 * to ulong
if ne len x len y
ret 1
end
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
put y i bitcast f32 xfold bitcast uint get x i 64
end
base = add base 65536
end
ret 0
end
fn ar_foldh x view ushort * y edit f32 * to ulong
if ne len x len y
ret 1
end
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
put y i bitcast f32 xfold shl uint get x i 16 64
end
base = add base 65536
end
ret 0
end

note Composes ApiViewsElem av_rne unchanged; runtime length may exceed the fixed-view limit.
fn ar_bf16 x view f32 * y edit ushort * to ulong
if ne len x len y
ret 1
end
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
put y i ushort and av_rne bitcast uint get x i 65535
end
base = add base 65536
end
ret 0
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Descriptor words are native aligned ulong values: two addresses, packed row/count, zero padding.
fn ar_tw q view ulong 8 e ulong nt ulong y edit ulong * to void
p = mul nt 4
v = add get q 1 mul e get q 3
put y p v
v = add get q 2 mul e get q 4
put y add p 1 v
ret
end
fn ar_tiles q view ulong 8 cnt view uint * y edit ulong * to ulong
nt = ulong 0
row = uint 0
for e ulong len cnt
r = uint 0
for guard ulong 4294967296
if not lt r get cnt e
break
end
if ge nt get q 0
ret 0
end
p = mul nt 4
ar_tw q e nt y
n = sub get cnt e r
if gt ulong n get q 5
n = uint get q 5
end
p = or ulong add row r shl ulong n 32
put y add mul nt 4 2 p
p = add mul nt 4 3
put y p 0
nt = add nt 1
r = add r uint get q 5
end
row = add row get cnt e
end
ret nt
end
fn ar_tg q view ulong 8 y edit ulong * to ulong
if lt len y mul get q 0 4
ret 0
end
for t ulong get q 0
p = mul t 4
put y p get q 1
put y add p 1 mul t get q 2
put y add p 2 get q 3
put y add p 3 0
end
ret get q 0
end
fn ar_tile q view ulong 8 y edit ulong * to ulong
nt = get q 0
r = uint 0
for guard ulong 4294967296
if not lt r uint get q 2
break
end
if ge nt div len y 4
ret 0
end
n = sub uint get q 2 r
if gt ulong n get q 3
n = uint get q 3
end
p = mul nt 4
put y p get q 4
put y add p 1 get q 5
p = or ulong uint add get q 1 ulong r shl ulong n 32
put y add mul nt 4 2 p
p = add mul nt 4 3
put y p 0
nt = add nt 1
r = add r uint get q 3
end
ret nt
end
fn ar_ct n uint bm uint to uint
ret div add n sub bm 1 bm
end
fn ar_groups q view ulong 4 ids view uint * rows view uint * to ulong
if ne len ids len rows
ret 18446744073709551615
end
segs = uint 0
tiles = uint 0
n = uint 0
for i ulong len ids
if ge ulong get ids i get q 0
ret 18446744073709551615
end
if ge ulong get rows i get q 1
ret 18446744073709551615
end
if gt i 0
if lt get ids i get ids sub i 1
ret 18446744073709551615
end
end
if eq i 0
segs = 1
else
if ne get ids i get ids sub i 1
if ne n 0
tiles = add tiles ar_ct n uint get q 2
end
segs = add segs 1
n = uint 0
end
end
n = add n 1
end
if ne n 0
tiles = add tiles ar_ct n uint get q 2
end
ret or ulong segs shl ulong tiles 32
end
fn ar_run i ulong ids view uint * to ulong
j = i
for guard ulong 4294967296
if not lt j len ids
break
end
if ne get ids j get ids i
break
end
j = add j 1
end
ret j
end

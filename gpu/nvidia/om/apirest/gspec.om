note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn argspec q view uint 8 y edit uint 6 to ulong
put y 0 get q 0
put y 1 uint lane get q 0
put y 2 uint fp8mt get q 2 get q 1
put y 3 uint shr fp8def 0 get q 3 32
put y 4 get q 4
if ne get q 5 0
put y 2 get q 5
end
put y 5 0
if ne get q 6 0
put y 5 1
end
ret 0
end

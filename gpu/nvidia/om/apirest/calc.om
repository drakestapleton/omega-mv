note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Source-derived arithmetic plans; inputs 1..15, outputs 16..31.
fn ar_c1 q edit ulong 32 to ulong
put q 16 ulong div add uint get q 1 sub uint get q 2 1 uint get q 2
put q 17 div get q 3 4
ret 0
end
fn ar_c2 q edit ulong 32 to ulong
nt = div get q 1 get q 4
gx = div get q 2 get q 5
th = mul 32 get q 6
put q 16 nt
put q 17 gx
put q 18 th
put q 19 mul mul th gx nt
put q 20 and add mul nt 32 4095 18446744073709547520
put q 21 div get q 3 128
ret 0
end
fn ar_c3 q edit ulong 32 to ulong
kb = div get q 3 128
sc = mul div get q 2 128 kb
wb = mul get q 2 get q 3
rb = mul mul div get q 2 8 add kb 1 4
put q 16 sc
put q 17 wb
put q 18 rb
put q 19 mul get q 1 wb
put q 20 mul get q 1 rb
put q 21 and add mul get q 1 rb 15 18446744073709551600
put q 22 mul get q 4 sc
put q 23 mul get q 4 wb
put q 24 mul get q 4 rb
put q 25 mul sc 4
put q 26 div mul get q 4 rb 4
put q 27 div rb 4
ret 0
end
fn ar_c4 q edit ulong 32 to ulong
r = mul uint get q 2 2
if ne rem uint get q 1 r 0
ret 1
end
u = div uint get q 1 r
gx = div add u sub uint get q 3 1 uint get q 3
if gt gx uint get q 4
gx = uint get q 4
end
if eq gx 0
gx = 1
end
put q 16 ulong u
put q 17 ulong gx
put q 18 ulong mul gx uint get q 3
put q 19 ulong sub uint 0 uint get q 5
put q 20 ulong sub uint 0 uint get q 6
put q 21 ulong sub uint 0 uint get q 7
put q 22 ulong sub uint 0 uint get q 8
put q 23 mul 32 get q 3
ret 0
end
fn ar_c5 q edit ulong 32 to ulong
put q 16 mul 32 get q 1
put q 17 mul mul get q 2 get q 3 get q 4
put q 18 mul mul get q 1 get q 2 32
ret 0
end
fn ar_c6 q edit ulong 32 to ulong
put q 16 mul get q 1 add mul get q 2 get q 3 mul mul div get q 2 128 div get q 3 128 4
ret 0
end
fn arcalc q edit ulong 32 to ulong
if eq get q 0 1
ret ar_c1 q
end
if eq get q 0 2
ret ar_c2 q
end
if eq get q 0 3
ret ar_c3 q
end
if eq get q 0 4
ret ar_c4 q
end
if eq get q 0 5
ret ar_c5 q
end
if eq get q 0 6
ret ar_c6 q
end
ret 1
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn arginfo q view ulong 16 y edit uint 22 to ulong
for i ulong 22
put y i 0
end
for i ulong 10
put y i uint get q i
end
put y 10 uint get q 10
put y 11 uint shr get q 10 32
put y 12 uint get q 11
put y 13 uint shr get q 11 32
put y 19 uint get q 12
put y 20 uint get q 13
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn arargsx va view ulong * sc view uint * y edit uint * to ulong
n = mul len va 2
if gt add n len sc len y
ret 1
end
for i ulong len y
put y i 0
end
for i ulong len va
v = get va i
put y mul i 2 uint and v 4294967295
put y add mul i 2 1 uint shr v 32
end
for i ulong len sc
put y add n i get sc i
end
ret 0
end

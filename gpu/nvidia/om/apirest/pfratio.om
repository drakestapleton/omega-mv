note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn ar_rs q view ulong 4 t ulong to ulong
p = mul t 8
if eq get q 2 1
p = swsrc uint p uint get q 0
end
ret mul div p 128 div get q 1 128
end
fn ar_rd q view ulong 4 t ulong to ulong
b = div t 2
b = mul b add div get q 1 128 1
b = mul b 2
ret add b rem t 2
end
fn ar_prw q view ulong 4 sf view f32 * y edit f32 * t ulong to void
kb = div get q 1 128
a = ar_rs q t
b = ar_rd q t
put y b 1.0f32
for c ulong 4294967296
if ge c kb
break
end
if ne c 0
j = add a c
v = div get sf sub j 1 get sf j
j = add b mul c 2
put y j v
end
end
a = add a sub kb 1
b = add b mul kb 2
put y b get sf a
ret
end
fn arpfrat q view ulong 4 sf view f32 * y edit f32 * to ulong
for t ulong 4294967296
if ge t div get q 0 8
break
end
ar_prw q sf y t
end
ret 0
end

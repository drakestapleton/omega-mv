note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q15 mode: upload chunks, output windows, row launches. C owns pointer acquisition and effects only.
fn armstep q edit ulong 16 x view uint * to ulong
if eq get q 15 3
for i ulong get q 1
if eq wok get x i uint get q 2 uint get q 3 0
ret i
end
end
ret get q 1
end
if ge get q 0 get q 1
ret 0
end
if eq get q 15 0
first = get q 0
last = add first get q 3
if gt last get q 1
last = get q 1
end
put q 8 first
put q 9 last
put q 10 mul mul first get q 2 8
put q 11 mul mul sub last first get q 2 8
put q 12 mul get q 11 2
put q 0 last
ret 1
end
if eq get q 15 1
put q 8 get q 0
put q 9 add get q 5 mul mul add div ulong get x get q 0 8 get q 6 get q 2 16
put q 10 mul mul get q 0 get q 3 get q 4
put q 0 add get q 0 1
ret 1
end
if eq get q 15 2
rows = sub get q 1 get q 0
if gt rows get q 2
rows = get q 2
end
put q 8 rows
put q 9 div div rows 16 get q 3
put q 10 add get q 6 mul mul get q 0 get q 4 2
put q 11 add get q 7 mul mul get q 0 get q 5 4
put q 0 add get q 0 get q 2
ret 1
end
ret 0
end

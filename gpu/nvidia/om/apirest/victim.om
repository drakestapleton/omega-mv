om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn ar_vfree q view ulong 8 x view uchar * j ulong to ulong
b = mul j get q 1
if eq get x add b get q 2 0
ret 1
end
if eq get x add b get q 3 0
ret 1
end
ret 0
end
fn arvictim q edit ulong 8 x view uchar * to ulong
for i ulong get q 0
j = rem add get q 4 i get q 0
if ne ar_vfree q x j 0
put q 4 rem add j 1 get q 0
ret j
end
end
ret 18446744073709551615
end

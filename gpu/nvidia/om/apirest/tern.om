om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn ar_trits x view uchar * to ulong
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
v = get x i
if and ne v 0 and ne v 1 ne v 255
ret i
end
end
base = add base 65536
end
ret len x
end
fn ar_word q view ulong 4 r ulong c ulong x view uchar * to ulong
v = ulong 0
p = add mul r get q 1 mul c 16
for i ulong 16
b = get x add p i
z = ulong 0
if eq b 1
z = 1
else
if eq b 255
z = 2
else
if ne b 0
ret 4294967296
end
end
end
v = or v shl z mul i 2
end
ret v
end
fn ar_tern q view ulong 4 x view uchar * y edit uint * to ulong
for i ulong 18446744073709551615
if ge i len y
break
end
put y i 0
end
kw = div get q 1 16
for r ulong 4294967296
if ge r get q 0
break
end
for c ulong 4294967296
if ge c kw
break
end
v = ar_word q r c x
if ne shr v 32 0
ret 1
end
p = add mul r kw c
if ne get q 2 0
br = mul get q 3 2
p = mul mul div r br br kw
p = add p mul c br
p = add p rem r br
end
put y p uint v
end
end
ret 0
end
fn ar_rev x view f32 * y edit f32 4 to ulong
for i ulong 4
put y i 0.0f32
end
for i ulong len x
put y sub 3 i get x i
end
ret 0
end

note Runtime extents, not fixed capacities. Chunked counted loops never hit the dynamic million-step guard.
fn ar_fill v ulong y edit uint * to ulong
base = ulong 0
for chunks ulong 281474976710656
if ge base len y
break
end
for j ulong 65536
i = add base j
if ge i len y
break
end
put y i uint v
end
base = add base 65536
end
ret 0
end
fn ar_count v ulong x view uint * to ulong
n = ulong 0
base = ulong 0
for chunks ulong 281474976710656
if ge base len x
break
end
for j ulong 65536
i = add base j
if ge i len x
break
end
if eq get x i uint v
n = add n 1
end
end
base = add base 65536
end
ret n
end
fn ar_args va view ulong * y edit uint * to ulong
if lt len y mul len va 2
ret 1
end
for i ulong len va
put y mul i 2 uint and get va i 4294967295
put y add mul i 2 1 uint shr get va i 32
end
ret 0
end
fn ar_pad x view uint * y edit uint * to ulong
if lt len y len x
ret 1
end
for i ulong 18446744073709551615
if ge i len y
break
end
v = uint 0
if lt i len x
v = get x i
end
put y i v
end
ret 0
end
fn ar_idle rec view uint * to ulong
if ne rem len rec 6 0
ret 0
end
for i ulong 18446744073709551615
if ge i div len rec 6
break
end
p = mul i 6
if or ne get rec add p 1 0 eq get rec p 1
ret 0
end
end
ret 1
end
fn ar_route e ulong x view f32 * y edit f32 * to ulong
if eq e 0
ret 0
end
k = div len x e
n = mul mul div k 4 e 4
for i ulong 18446744073709551615
if ge i n
break
end
p = mul rem div i 4 e k
p = add p mul div i mul e 4 4
p = add p rem i 4
put y i get x p
end
for i ulong 18446744073709551615
if ge i mul e 4
break
end
put y add n i 0.0f32
end
ret 0
end
fn ar_perm lb ulong x view f32 * y edit f32 * to ulong
row = mul 32 lb
if eq row 0
ret 0
end
for i ulong 18446744073709551615
if ge i len x
break
end
p = mul div i row row
p = add p mul rem div i 4 32 lb
p = add p mul div rem i row 128 4
p = add p rem i 4
put y i mul get x p bitcast f32 uint 1602224128
end
ret 0
end
fn ar_widen x view ushort * y edit f32 * to ulong
if ne len x len y
ret 1
end
for i ulong 18446744073709551615
if ge i len x
break
end
put y i bitcast f32 shl uint get x i 16
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn api_bf_plan mode ulong a edit ulong 16 to ulong
if eq mode 0
k = get a 0
ks = div k 256
w = ulong 16
d = ks
if ne d 0
while or gt d 16 ne rem ks d 0 bound 65536
d = sub d 1
end
end
if or ne rem k mul 32 w 0 gt k mul 512 w
w = 32
end
put a 8 ulong 1
put a 9 w
put a 10 d
put a 11 ulong 96
for i ulong 4
if ne get a add i 1 0
put a add i 8 get a add i 1
end
end
ret 0
end
if eq mode 1
n = get a 0
rows = get a 1
warps = get a 2
ctas = get a 3
if or eq rows 0 eq warps 0
ret 3
end
if ne rem n rows 0
ret 3
end
gx = div and add div n rows sub warps 1 4294967295 warps
if gt gx ctas
gx = ctas
end
if eq gx 0
gx = 1
end
put a 8 gx
put a 9 div n rows
ret 0
end
if eq mode 2
rec = ne get a 0 0
xr = get a 1
xb = get a 2
if and ne xr 0 or not rec gt xr 65535
ret 1
end
if ne get a 4 0
if or not rec ne xr 0
ret 1
end
if or gt xb 1 eq get a 5 0
ret 1
end
end
if gt xb 1
if or not rec ne xr 0
ret 1
end
if or gt xb 4 lt get a 3 get a 6
ret 1
end
end
ret 0
end
if eq mode 3
if gt get a 0 1
if or gt get a 0 4 eq get a 1 0
ret 1
end
end
put a 8 ulong 0
if le get a 0 1
put a 8 ulong 1
end
ret 0
end
if eq mode 4
if gt mul mul ulong 32 get a 0 get a 1 65536
ret 2
end
ret 0
end
if eq mode 5
if eq get a 0 0
ret 1
end
put a 8 ulong 0
if eq get a 0 1
put a 8 ulong 1
end
ret 0
end
if eq mode 6
r = get a 5
s = ulong 0
xb = ulong 0
gy = ulong 1
nr = ulong 1
if ne get a 0 0
s = get a 4
gy = get a 0
nr = gy
end
if ne get a 3 0
r = 1
end
if gt get a 1 1
xb = get a 1
s = get a 2
nr = xb
end
put a 8 r
put a 9 s
put a 10 xb
put a 11 gy
put a 12 mul get a 4 nr
ret 0
end
ret 1
end

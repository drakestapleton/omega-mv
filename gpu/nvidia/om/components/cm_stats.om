note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note 0 trial phase: 0 continue, 1 failed observation accepted, 2 zero latency refused.
note 1 fit phase: stats[0:48], phi[48:56], residual flag[57], quiet mean[58], latency[59].
fn cm_stats mode ulong out edit ulong 64 to ulong
if eq mode 0
put out 46 add get out 46 1
if ne get out 56 0
put out 47 add get out 47 1
ret 1
end
if eq get out 59 0
ret 2
end
ret 0
end
y = cm_log f64 get out 59 true
if ne get out 57 0
y = sub y bitcast f64 get out 58
end
k = ulong 0
for i ulong 8
x = bitcast f64 get out add 48 i
for j ulong 8
if ge j i
z = bitcast f64 get out add 48 j
v = bitcast f64 get out k
put out k bitcast ulong add v mul x z
k = add k 1
end
end
v = bitcast f64 get out add 36 i
put out add 36 i bitcast ulong add v mul x y
end
v = bitcast f64 get out 44
put out 44 bitcast ulong add v mul y y
put out 45 add get out 45 1
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure shape refusals at CUDApp b774723. Result 0 accepted, 1 bad, 2 too large.
note Modes 0 matmul; 1 rmsnorm; 2 rope; 3 attention heads; 4 bounded subrange;
note 5 bf16 weight shape; 6 router expert shape. Pointer admission stays in C.
fn api_policy mode ulong a ulong b ulong c ulong to ulong
if eq mode 0
if or eq a 0 or eq b 0 eq c 0
ret 1
end
if or gt a 8192 or gt b 16384 gt c 262144
ret 2
end
ret 0
end
if eq mode 1
if or eq a 0 or eq b 0 ne rem b 128 0
ret 1
end
if gt b 16384
ret 2
end
ret 0
end
if eq mode 2
if or eq a 0 or lt b 2 ne and b 1 0
ret 1
end
if gt b 2048
ret 2
end
ret 0
end
if eq mode 3
if or eq a 0 or eq b 0 eq c 0
ret 1
end
if or gt c 256 gt a 1024
ret 2
end
if ne rem a b 0
ret 1
end
ret 0
end
if eq mode 4
if gt a c
ret 1
end
if gt b sub c a
ret 1
end
ret 0
end
if eq mode 5
if or eq a 0 or eq b 0 ne rem b 256 0
ret 1
end
if gt b c
ret 2
end
ret 0
end
if eq mode 6
if or and ne a 128 ne a 256 gt b 1
ret 1
end
ret 0
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn api_da_plan mode ulong a edit ulong 16 to ulong
if eq mode 0
layers = get a 0
pos = get a 1
if or eq layers 0 gt layers 64
ret 1
end
if or eq pos 0 gt pos 131072
ret 1
end
if or ne rem pos 256 0 not gt bitcast f64 get a 2 f64 0
ret 1
end
put a 8 div pos 256
put a 9 add mul mul 4 pos 256 add mul mul ulong 4 8 256 64
put a 10 mul pos 512
put a 11 mul mul mul layers 2 128 4
put a 12 mul mul mul 4 div pos 256 1040 4
ret 0
end
if eq mode 1
if or gt get a 0 get a 2 gt get a 1 sub get a 2 get a 0
ret 1
end
ret 0
end
if eq mode 2
pos = get a 0
per = get a 1
if eq per 0
per = 256
end
if ne rem per 256 0
ret 1
end
splits = div add pos per per
if gt splits get a 2
ret 2
end
depth = get a 3
if eq depth 0
depth = 4
end
put a 8 per
put a 9 splits
put a 10 depth
put a 11 mul mul mul ulong 2 4 add pos 1 256
ret 0
end
if eq mode 3
if or ge get a 0 get a 1 ge get a 2 4
ret 1
end
if or eq get a 4 0 gt get a 3 get a 5
ret 1
end
if gt get a 4 sub get a 5 get a 3
ret 1
end
ret 0
end
if eq mode 4
if gt mul get a 0 256 65536
ret 2
end
ret 0
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Input is 48 exact statistics words followed by eight binary64 basis words.
fn cm_fit_cholesky s view ulong 64 l edit ulong 64 to bool
a = new ulong 64 0
idx = ulong 0
for i ulong 8
for j ulong 8
if ge j i
word = get s idx
put a add mul i 8 j word
put a add mul j 8 i word
idx = add idx 1
end
end
end
for j ulong 8
v = bitcast f64 get a add mul j 8 j
for k ulong 8
if lt k j
x = bitcast f64 get l add mul j 8 k
v = sub v mul x x
end
end
if not gt v f64 0.0
ret false
end
put l add mul j 8 j cm_sqrt bitcast ulong v
for i ulong 8
if gt i j
t = bitcast f64 get a add mul i 8 j
for k ulong 8
if lt k j
x = bitcast f64 get l add mul i 8 k
y = bitcast f64 get l add mul j 8 k
t = sub t mul x y
end
end
d = bitcast f64 get l add mul j 8 j
put l add mul i 8 j bitcast ulong div t d
end
end
end
ret true
end
fn cm_fit_forward l view ulong 64 v edit ulong 16 to void
for i ulong 8
s = bitcast f64 get v add 8 i
for k ulong 8
if lt k i
x = bitcast f64 get l add mul i 8 k
y = bitcast f64 get v add 8 k
s = sub s mul x y
end
end
d = bitcast f64 get l add mul i 8 i
put v add 8 i bitcast ulong div s d
end
end
fn cm_fit_backward l view ulong 64 v edit ulong 16 to void
for rev ulong 8
i = sub 7 rev
s = bitcast f64 get v add 8 i
for k ulong 8
if gt k i
x = bitcast f64 get l add mul k 8 i
y = bitcast f64 get v add 8 k
s = sub s mul x y
end
end
d = bitcast f64 get l add mul i 8 i
put v add 8 i bitcast ulong div s d
end
end
fn cm_fit_beta s view ulong 64 l view ulong 64 out edit ulong 16 to void
for i ulong 8
put out add 8 i get s add 36 i
end
cm_fit_forward l out
quad = f64 0.0
for i ulong 8
v = bitcast f64 get out add 8 i
quad = add quad mul v v
end
cm_fit_backward l out
a = add f64 1.0 mul f64 0.5 f64 get s 45
b = add bitcast f64 ulong 4576918229304087675 mul f64 0.5 sub bitcast f64 get s 44 quad
if lt b bitcast f64 ulong 4576918229304087675
b = bitcast f64 ulong 4576918229304087675
end
sigma = div b a
if lt sigma bitcast f64 ulong 4561440258104740754
sigma = bitcast f64 ulong 4561440258104740754
end
put out 3 bitcast ulong sigma
put out 2 bitcast ulong mul f64 2.0 a
mean = f64 0.0
for i ulong 8
x = bitcast f64 get out add 8 i
y = bitcast f64 get s add 48 i
mean = add mean mul x y
end
put out 0 bitcast ulong mean
end
fn cm_fit_spread s view ulong 64 l view ulong 64 out edit ulong 16 to void
for i ulong 8
put out add 8 i get s add 48 i
end
cm_fit_forward l out
lev = f64 0.0
for i ulong 8
v = bitcast f64 get out add 8 i
lev = add lev mul v v
end
sigma = bitcast f64 get out 3
put out 1 cm_sqrt bitcast ulong mul sigma add f64 1.0 lev
end
fn cm_fit s view ulong 64 out edit ulong 16 to ulong
if or eq get s 45 0 lt get s 45 get s 56
ret 0
end
l = new ulong 64 0
if not cm_fit_cholesky s l
ret 0
end
cm_fit_beta s l out
cm_fit_spread s l out
ret 1
end

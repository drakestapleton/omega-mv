note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q/saved/count/ps/mean/sd/dof/known/borrowed/selected[0:10]; result[10].
note Mode 4 transports work/explore counters and deltas in [0:4].
fn cm_calibration mode ulong words edit ulong 32 to ulong
if eq mode 4
put words 0 add get words 0 get words 2
put words 1 add get words 1 get words 3
ret 0
end
q = bitcast f64 get words 0
if eq mode 0
if eq get words 2 0
ret 0
end
if not and gt q f64 0.0 lt q f64 1.0
ret 0
end
put words 10 ulong 4607182418800017408
ret 1
end
if eq mode 1
if not or ne get words 7 0 ne get words 8 0
ret 0
end
if eq get words 3 0
ret 0
end
sd = bitcast f64 get words 5
if not gt sd f64 0.0
ret 0
end
value = sub cm_log f64 get words 3 true bitcast f64 get words 4
value = bitcast f64 and bitcast ulong value 9223372036854775807
value = div value sd
t = bitcast f64 cm_quantile get words 0 get words 6
put words 10 bitcast ulong div value t
ret 1
end
if eq mode 2
k = get words 2
if lt k 10
put words 10 get words 1
ret 0
end
rounded = bitcast f64 cm_ceil bitcast ulong mul q f64 k
idx = sub ulong rounded 1
if ge idx k
idx = sub k 1
end
put words 10 idx
ret 1
end
scale = bitcast f64 get words 9
if lt scale f64 1.0
scale = f64 1.0
end
put words 10 bitcast ulong scale
ret 1
end

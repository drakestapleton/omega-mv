note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Acklam coefficients preserve the exact C binary64 values; Wolfram-derived bit patterns.
fn cm_normal_tail q f64 to f64
v = bitcast f64 ulong 13798997430714945504
v = add mul v q bitcast f64 ulong 13822851435045880248
v = add mul v q bitcast f64 ulong 13835960482696009560
v = add mul v q bitcast f64 ulong 13836295942911834650
v = add mul v q bitcast f64 ulong 4616611452376731079
v = add mul v q bitcast f64 ulong 4613798575908835234
d = bitcast f64 ulong 4575625165243457492
d = add mul d q bitcast f64 ulong 4599480671287182180
d = add mul d q bitcast f64 ulong 4612688371394471446
d = add mul d q bitcast f64 ulong 4615636595525398809
d = add mul d q f64 1.0
ret div v d
end
fn cm_normal_middle q f64 to f64
r = mul q q
v = bitcast f64 ulong 13854155686354486565
v = add mul v r bitcast f64 ulong 4641977866302784411
v = add mul v r bitcast f64 ulong 13866933838737128345
v = add mul v r bitcast f64 ulong 4639072047187312667
v = add mul v r bitcast f64 ulong 13852696627858410445
v = add mul v r bitcast f64 ulong 4612826843888178297
v = mul v q
d = bitcast f64 ulong 13856235683484533956
d = add mul d r bitcast f64 ulong 4639889312772538999
d = add mul d r bitcast f64 ulong 13863054224260258002
d = add mul d r bitcast f64 ulong 4634401141363829182
d = add mul d r bitcast f64 ulong 13847038013971134502
d = add mul d r f64 1.0
ret div v d
end
fn cm_normal_inv p f64 to f64
if le p f64 0.0
ret bitcast f64 ulong 18442240474082181120
end
if ge p f64 1.0
ret bitcast f64 ulong 9218868437227405312
end
if lt p bitcast f64 ulong 4582646808030102946
v = mul f64 -2.0 cm_log p false
q = bitcast f64 cm_sqrt bitcast ulong v
ret cm_normal_tail q
end
if gt p bitcast f64 ulong 4606963994218089939
v = mul f64 -2.0 cm_log sub f64 1.0 p false
q = bitcast f64 cm_sqrt bitcast ulong v
ret neg cm_normal_tail q
end
ret cm_normal_middle sub p f64 0.5
end
fn cm_quantile qb ulong db ulong to ulong
q = bitcast f64 qb
dof = bitcast f64 db
z = cm_normal_inv add f64 0.5 mul f64 0.5 q
if not gt dof f64 0.0
ret bitcast ulong z
end
z3 = mul mul z z z
z5 = mul mul z3 z z
a = div add z3 z mul f64 4.0 dof
b = add mul f64 5.0 z5 mul f64 16.0 z3
b = add b mul f64 3.0 z
b = div b mul mul f64 96.0 dof dof
ret bitcast ulong add add z a b
end

note Pull protocol: each call consumes the requested retained byte slice.
note result 2 requests another slice, 1 accepts, 0 refuses. No host I/O in this unit.
fn ae_rd b view uchar 512 p ulong n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl ulong get b add p i mul i 8
end
ret v
end
fn ae_req s edit ulong 32 stage ulong off ulong n ulong to ulong
put s 0 stage
put s 4 off
put s 5 n
ret 2
end
fn ae_next s edit ulong 32 to ulong
i = add get s 13 1
put s 13 i
if ge i get s 9
ret 0
end
ret ae_req s 2 add get s 8 mul i 64 64
end
fn artifact_elf b view uchar 512 s edit ulong 32 to ulong
if eq get s 0 0
if lt get s 1 64
ret 0
end
if ne ae_rd b 0 4 1179403647
ret 0
end
if ne ae_rd b 18 2 190
ret 0
end
put s 8 ae_rd b 40 8
put s 9 ae_rd b 60 2
idx = ae_rd b 62 2
if or ne ae_rd b 58 2 64 or eq get s 9 0 ge idx get s 9
ret 0
end
if gt get s 8 get s 1
ret 0
end
if gt mul get s 9 64 sub get s 1 get s 8
ret 0
end
ret ae_req s 1 add get s 8 mul idx 64 64
end
if eq get s 0 1
put s 11 ae_rd b 24 8
put s 12 ae_rd b 32 8
if gt get s 11 get s 1
ret 0
end
if gt get s 12 sub get s 1 get s 11
ret 0
end
if ge add get s 3 6 128
ret 0
end
put s 13 0
ret ae_req s 2 get s 8 64
end
if eq get s 0 2
name = ae_rd b 0 4
if ge name get s 12
ret ae_next s
end
put s 15 ae_rd b 24 8
put s 16 ae_rd b 32 8
n = sub get s 12 name
if gt n 128
n = 128
end
ret ae_req s 3 add get s 11 name n
end
if eq get s 0 3
wl = add get s 3 6
if le get s 5 wl
ret ae_next s
end
if or ne get b 0 46 ne get b 1 116
ret ae_next s
end
if or ne get b 2 101 ne get b 3 120
ret ae_next s
end
if or ne get b 4 116 ne get b 5 46
ret ae_next s
end
for i ulong get s 3
if ne get b add i 6 get b add i 256
ret ae_next s
end
end
if ne get b wl 0
ret ae_next s
end
if gt get s 15 get s 1
ret 0
end
if ne get s 16 get s 2
ret 0
end
if gt get s 16 sub get s 1 get s 15
ret 0
end
put s 14 0
put s 6 1
n = get s 2
if eq n 0
ret 1
end
if gt n 128
n = 128
end
ret ae_req s 4 get s 15 n
end
if eq get s 0 4
for i ulong get s 5
if ne get b i get b add 128 i
ret 0
end
end
put s 14 add get s 14 get s 5
n = sub get s 2 get s 14
if eq n 0
ret 1
end
if gt n 128
n = 128
end
ret ae_req s 4 add get s 15 get s 14 n
end
ret 0
end

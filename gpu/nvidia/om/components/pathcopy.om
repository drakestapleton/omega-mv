note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
om2
note Bounded path copy. Never reads past len src. The first 0 ends the scan and is written.
note src and dst bounds are independent. Empty source is a refusal. A nonempty NULL is refused by the binding.
fn pathbyte value ulong to ulong
if or and ge value 97 le value 122 and ge value 65 le value 90
ret value
end
if and ge value 48 le value 57
ret value
end
if or or or eq value 46 eq value 95 eq value 45 eq value 47
ret value
end
if or or or eq value 43 eq value 44 eq value 61 eq value 64
ret value
end
if or eq value 58 eq value 126
ret value
end
ret 256
end
fn pathstep state ulong value ulong count ulong cap ulong to ulong
if eq value 0
if or eq count 0 eq state 2
ret 4
end
ret 5
end
if ge count cap
ret 4
end
if ge count sub cap 1
ret 4
end
if eq pathbyte value 256
ret 4
end
if eq value 47
if eq state 2
ret 4
end
ret 0
end
if eq value 46
if lt state 2
ret add state 1
end
end
ret 3
end
export fn pathlen a view uchar * to ulong
ensures le result len a
n = len a
for i ulong n
b = get a i
if eq b 0
ret i
end
end
ret n
end
export fn pathcopy src view uchar * dst edit uchar * to ulong
ensures le result 1
n = len src
cap = len dst
if eq n 0
ret 0
end
state = ulong 0
for i ulong n
b = get src i
next = pathstep state ulong b i cap
if eq next 4
ret 0
end
put dst i b
if eq next 5
ret 1
end
state = next
end
ret 0
end

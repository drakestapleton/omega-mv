note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Stable total binary64 ordering. NaNs follow numbers; equal values use bits.
fn cms_less a ulong b ulong to bool
x = bitcast f64 a
y = bitcast f64 b
if ne x x
if eq y y
ret false
end
ret lt a b
end
if ne y y
ret true
end
if lt x y
ret true
end
if gt x y
ret false
end
ret lt a b
end
fn cms_run a edit ulong 256 n ulong to void
for i ulong n
j = i
while gt j 0
if not cms_less get a j get a sub j 1
break
end
x = get a j
put a j get a sub j 1
put a sub j 1 x
j = sub j 1
end
end
end
note meta: valid left/right then consumed left/right; C advances only these counts.
fn cm_sort a edit ulong 256 b view ulong 256 out edit ulong 256 meta edit ulong 4 to ulong
na = get meta 0
nb = get meta 1
if or gt na 256 gt nb 256
ret 0
end
if eq get meta 2 0
cms_run a na
ret na
end
ia = ulong 0
ib = ulong 0
n = ulong 0
while lt n 256
if and eq ia na eq ib nb
break
end
left = eq ib nb
if and lt ia na lt ib nb
left = not cms_less get b ib get a ia
end
if left
put out n get a ia
ia = add ia 1
else
put out n get b ib
ib = add ib 1
end
n = add n 1
if gt na 0
if eq ia na
break
end
end
if gt nb 0
if eq ib nb
break
end
end
end
put meta 2 ia
put meta 3 ib
ret n
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Double-double Taylor exponential, exact power-of-two transport and subnormal rounding.
fn cm_dd_div_scalar a edit ulong 2 b f64 to void
cm_div bitcast f64 get a 0 bitcast f64 get a 1 b f64 0.0 a
end
fn cm_exp_series r view ulong 2 out edit ulong 2 to void
term = new ulong 2 0
put term 0 4607182418800017408
put out 0 4607182418800017408
put out 1 0
for i ulong 40
cm_dd_mul term r
cm_dd_div_scalar term f64 add i 1
cm_dd_add out term
end
end
fn cm_exp_reduce ah f64 al f64 base2 bool out edit ulong 2 to long
r = new ulong 2 0
v = ah
k = long 0
if not base2
v = mul ah bitcast f64 ulong 4609176140021203710
end
if ge v f64 0.0
k = long add v f64 0.5
else
k = long sub v f64 0.5
end
if base2
cm_add ah al neg f64 k f64 0.0 r
cm_mul bitcast f64 get r 0 bitcast f64 get r 1 bitcast f64 ulong 4604418534313441775 bitcast f64 ulong 4358002977218854975 r
else
cm_mul neg f64 k f64 0.0 bitcast f64 ulong 4604418534313441775 bitcast f64 ulong 4358002977218854975 r
cm_add ah al bitcast f64 get r 0 bitcast f64 get r 1 r
end
cm_exp_series r out
ret k
end
fn cm_scale_bits a edit ulong 2 k long to ulong
if lt k -1000
scale = bitcast f64 shl ulong add k 2097 52
cm_dd_scale a scale
h = bitcast f64 get a 0
l = bitcast f64 get a 1
if le h f64 4503599627370496
n = ulong h
frac = add sub h f64 n l
if gt frac f64 0.5
n = add n 1
else
if lt frac f64 -0.5
n = sub n 1
else
if and eq frac f64 0.5 ne and n 1 0
n = add n 1
end
if and eq frac f64 -0.5 ne and n 1 0
n = sub n 1
end
end
end
ret n
end
normal = mul add h l bitcast f64 ulong 4503599627370496
ret bitcast ulong mul normal bitcast f64 ulong 4372995238176751616
end
if eq k 1024
cm_dd_scale a f64 2.0
k = 1023
end
scale = bitcast f64 shl ulong add k 1023 52
ret bitcast ulong mul add bitcast f64 get a 0 bitcast f64 get a 1 scale
end
fn cm_exp bits ulong base2 bool to ulong
x = bitcast f64 bits
if ne x x
ret bitcast ulong add x x
end
if base2
if ge x f64 1024.0
ret 9218868437227405312
end
if le x f64 -1075.0
ret 0
end
else
if gt x f64 710.0
ret 9218868437227405312
end
if lt x f64 -746.0
ret 0
end
end
out = new ulong 2 0
k = cm_exp_reduce x f64 0.0 base2 out
if gt k 1024
ret 9218868437227405312
end
if lt k -1075
ret 0
end
ret cm_scale_bits out k
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Transport op[0], M[1], N[2], state[3], cache[4], core[5], pressure[6].
note Basis output[16:24]; initialized statistics output[16:64].
fn cm_features mode ulong words edit ulong 64 to ulong
if eq mode 0
if ge get words 0 1
ret 4294967295
end
core = get words 5
if ge core 3
core = ulong 2
end
pr = get words 6
if ge pr 3
pr = ulong 2
end
ret add mul core 3 pr
end
if eq mode 5
pr = get words 6
if ge pr 3
pr = ulong 2
end
ret pr
end
if eq mode 3
n = get words 0
if gt n 8
n = ulong 8
end
put words 0 ulong 4607182418800017408
for i ulong 48
put words add 16 i ulong 0
end
idx = ulong 0
for i ulong 8
for j ulong 8
if ge j i
if eq i j
put words add 16 idx ulong 4562254508917369340
end
idx = add idx 1
end
end
end
ret n
end
if eq mode 4
put words 16 ulong 4590429028186199163
put words 17 ulong 0
put words 18 ulong 0
put words 19 ulong 4587366580439587226
put words 20 ulong 500000000
ret 0
end
if ge mode 6
failures = ulong 0
for i ulong 9
failures = add failures get words i
end
if eq mode 6
ret failures
end
trials = ulong 0
for i ulong 9
trials = add trials get words add 9 i
end
ret bitcast ulong div add f64 failures bitcast f64 ulong 4587366580439587226 add f64 trials f64 1.0
end
m = get words 1
n = get words 2
if eq m 0
m = ulong 1
end
if eq n 0
n = ulong 1
end
lm = cm_log f64 m true
ln = cm_log f64 n true
ov = f64 0.0
if and ne get words 4 0 gt get words 3 get words 4
ratio = div f64 get words 3 f64 get words 4
ov = cm_log ratio true
end
for i ulong 8
put words add 16 i ulong 0
end
put words 16 ulong 4607182418800017408
if eq mode 2
put words 17 bitcast ulong ov
ret 0
end
put words 17 bitcast ulong lm
put words 18 bitcast ulong ln
put words 19 bitcast ulong mul lm ln
put words 20 bitcast ulong mul ln ln
if le get words 2 3
put words 21 ulong 4607182418800017408
end
if ne rem get words 2 4 0
put words 22 ulong 4607182418800017408
end
put words 23 bitcast ulong ov
ret 0
end

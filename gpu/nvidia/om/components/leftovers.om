note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Scalar ABI only: usable with NO_POSIX and without an OM2 array arena.
note Path state: 0 empty component, 1 dot, 2 dot-dot, 3 ordinary.
note Step results 4 refusal and 5 accepted terminator are not component states.
fn leftover_pathbyte value ulong to ulong
if or and ge value 97 le value 122 and ge value 65 le value 90
ret value
end
if and ge value 48 le value 57
ret value
end
if or or or eq value 46 eq value 95 eq value 45 eq value 47
ret value
end
if or or or eq value 43 eq value 44 eq value 61 eq value 64
ret value
end
if or eq value 58 eq value 126
ret value
end
ret 256
end
fn leftover_pathstep state ulong value ulong count ulong cap ulong to ulong
if eq value 0
if or eq count 0 eq state 2
ret 4
end
ret 5
end
if ge count cap
ret 4
end
if ge count sub cap 1
ret 4
end
if eq leftover_pathbyte value 256
ret 4
end
if eq value 47
if eq state 2
ret 4
end
ret 0
end
if eq value 46
if lt state 2
ret add state 1
end
end
ret 3
end
fn leftover_status value ulong to ulong
if ge value 9223372036854775808
ret value
end
ret 0
end
fn leftover_acquire okay ulong to ulong
if eq okay 0
ret 18446744073709551615
end
ret 0
end
fn leftover_uncertain state ulong to ulong
if eq state 2
ret 1
end
ret 0
end
fn leftover_context value ulong present ulong to ulong
if eq value 0
ret 1
end
if or ge value 9223372036854775808 eq present 0
ret 18446744073709551615
end
ret 0
end
fn leftover_release count ulong index ulong to ulong
if and lt index count lt index 32
ret 1
end
ret 0
end

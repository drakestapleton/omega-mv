note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn api_ew_plan mode ulong a edit ulong 16 to ulong
n = get a 0
if eq mode 4
if or eq n 0 gt get a 2 get a 3
ret 1
end
ret 0
end
dim = get a 1
if eq mode 0
if or eq n 0 or eq dim 0 ne rem dim 128 0
ret 1
end
if gt dim 16384
ret 2
end
end
if eq mode 1
if or eq n 0 or lt dim 2 ne and dim 1 0
ret 1
end
if gt dim 2048
ret 2
end
end
if le mode 1
nr = n
if gt nr 1024
nr = 1024
end
put a 8 nr
put a 9 mul mul nr dim 4
if eq mode 0
put a 10 div dim 128
f = div f32 1 f32 dim
put a 11 ulong bitcast uint f
else
put a 10 div dim 2
end
ret 0
end
if eq mode 2
if eq n 0
ret 1
end
ni = n
if gt ni 131072
ni = 131072
end
put a 8 ni
put a 9 div add ni 127 128
put a 10 mul ni 4
ret 0
end
if eq mode 3
if or eq n 0 ne rem n 128 0
ret 1
end
ret 0
end
if eq mode 5
if gt n 3
ret 1
end
ret 0
end
if eq mode 6
if or eq n 0 gt n 9223372036854775807
n = 1
end
if gt n 3
n = 3
end
put a 8 n
ret 0
end
ret 1
end

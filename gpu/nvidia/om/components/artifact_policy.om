note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure QMD prefix policy from CUDApp b774723, little-endian packed words.
note Byte views preserve uint32 alignment without copying the QMD.
fn art_word q view uchar 256 i ulong to ulong
j = mul i 4
lo = or ulong get q j shl ulong get q add j 1 8
hi = or ulong get q add j 2 shl ulong get q add j 3 8
ret or lo shl hi 16
end
fn art_template q0 view uchar 256 q1 view uchar 256 to ulong
if ne art_word q0 12 0
ret 0
end
if or ne art_word q1 12 0 or ne art_word q1 15 0 ne art_word q1 16 0
ret 0
end
if or ne art_word q1 32 0 ne and art_word q1 33 xor 4294967295 shl ulong 10 21 0
ret 0
end
if or ne art_word q1 42 0 ne and art_word q1 43 524287 0
ret 0
end
if or ne art_word q1 44 0 ne and art_word q1 45 524287 0
ret 0
end
if or ne art_word q1 52 12 ne and art_word q1 53 524287 0
ret 0
end
if or ne art_word q1 56 0 or ne and art_word q1 57 524287 0 ne art_word q1 59 0
ret 0
end
ret 1
end
fn art_launch q1 view uchar 256 s view ulong 7 to ulong
wg = get s 6
if lt wg 16
wg = 16
end
ws = ulong 8
if ne get s 5 0
ws = div and add get s 5 127 4294967295 128
end
for i ulong 5
if eq get s i 0
ret 0
end
end
if or gt get s 2 65535 gt get s 3 65535
ret 0
end
if or gt get s 4 255 or gt wg 511 gt ws 2047
ret 0
end
if ne art_word q1 34 or get s 2 shl get s 3 16
ret 0
end
if ne and art_word q1 35 255 get s 4
ret 0
end
if ne and shr art_word q1 35 8 511 wg
ret 0
end
if ne and art_word q1 36 2047 ws
ret 0
end
if ne art_word q1 39 get s 0
ret 0
end
if ne art_word q1 40 get s 1
ret 0
end
if ne art_word q1 41 1
ret 0
end
ret 1
end
fn artifact_policy mode ulong q0 view uchar 256 q1 view uchar 256 s view ulong 7 to ulong
if eq mode 0
ret art_template q0 q1
end
if eq mode 1
ret art_launch q1 s
end
ret 0
end

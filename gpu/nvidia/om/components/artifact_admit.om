note Admission is an effect protocol. C supplies retained file bytes and digest results.
note stage0 layout,1 identity digest,2 file digests,3 ELF match,4 final policy,5 done.
fn aa_literal which ulong p ulong to ulong
if eq which 0
if eq p 0
ret 115
end
if eq p 1
ret 109
end
if eq p 2
ret 95
end
if eq p 3
ret 49
end
if eq p 4
ret 50
end
if eq p 5
ret 49
end
ret 0
end
if eq which 1
if eq p 0
ret 110
end
if eq p 1
ret 118
end
if eq p 2
ret 105
end
if eq p 3
ret 100
end
if eq p 4
ret 105
end
if eq p 5
ret 97
end
if eq p 6
ret 45
end
if eq p 7
ret 99
end
if eq p 8
ret 117
end
if eq p 9
ret 98
end
if eq p 10
ret 105
end
if eq p 11
ret 110
end
if eq p 12
ret 45
end
if eq p 13
ret 101
end
if eq p 14
ret 108
end
if eq p 15
ret 102
end
if eq p 16
ret 54
end
if eq p 17
ret 52
end
ret 0
end
if eq which 2
if eq p 0
ret 122
end
if eq p 1
ret 101
end
if eq p 2
ret 114
end
if eq p 3
ret 111
end
if eq p 4
ret 45
end
if eq p 5
ret 118
end
if eq p 6
ret 97
end
if eq p 7
ret 45
end
if eq p 8
ret 118
end
if eq p 9
ret 49
end
ret 0
end
ret 0
end
fn aa_hex b view uchar 65536 s view ulong 128 k ulong to bool
if ne get s add k 48 64
ret false
end
off = get s add k 8
for i ulong 64
ch = get b add off i
if not or and ge ch 48 le ch 57 and ge ch 97 le ch 102
ret false
end
end
ret true
end
fn aa_digest b view uchar 65536 s view ulong 128 k ulong to bool
off = get s add k 8
for i ulong 64
if ne get b add off i get b add 16384 i
ret false
end
end
ret true
end
fn aa_parse b view uchar 65536 s edit ulong 128 k ulong count ulong mode ulong to bool
st = new ulong 8 0
put st 3 count
n = get s add k 48
if and eq mode 2 ge n 64
ret false
end
off = get s add k 8
for i ulong add n 1
ch = ulong 0
if lt i n
ch = ulong get b add off i
end
rc = artifact_parse mode ch st
if eq rc 2
ret false
end
if or eq rc 1 eq rc 3
j = get st 2
if eq rc 3
j = sub j 1
end
put s add 110 j get st 4
end
end
ret true
end
fn aa_eq b view uchar 65536 s view ulong 128 k ulong which ulong to bool
off = get s add k 8
n = get s add k 48
for i ulong n
if ne ulong get b add off i aa_literal which i
ret false
end
end
ret eq aa_literal which n 0
end
fn aa_field b view uchar 65536 s view ulong 128 k ulong cap ulong empty ulong to bool
n = get s add k 48
if ge n cap
ret false
end
if and eq empty 0 eq n 0
ret false
end
ret true
end
fn aa_final b view uchar 65536 s edit ulong 128 to ulong
q0 = new uchar 256 0
q1 = new uchar 256 0
shape = new ulong 7 0
for i ulong 256
put q0 i get b add 8192 i
put q1 i get b add 8448 i
end
if eq art_template q0 q1 0
ret 7
end
if not aa_field b s 22 64 1
ret 2
end
if not aa_parse b s 22 3 2
ret 2
end
put shape 0 get s 110
put shape 1 get s 111
if ne get s 112 1
ret 2
end
if not aa_field b s 23 64 1
ret 2
end
if not aa_parse b s 23 3 2
ret 2
end
put shape 2 get s 110
put shape 3 get s 111
put shape 4 get s 112
if not aa_field b s 24 64 1
ret 2
end
if not aa_parse b s 24 1 2
ret 2
end
put shape 5 get s 110
if not aa_field b s 25 64 1
ret 2
end
if not aa_parse b s 25 1 2
ret 2
end
put shape 6 get s 110
if eq art_launch q1 shape 0
ret 3
end
if not aa_field b s 19 64 1
ret 2
end
if not aa_parse b s 19 1 2
ret 2
end
w = get s 110
if or eq w 0 or gt w 32 ne get s 105 mul w 4
ret 2
end
if not aa_field b s 2 128 0
ret 2
end
if not aa_field b s 3 128 0
ret 2
end
if not aa_field b s 7 128 1
ret 4
end
if not aa_eq b s 7 0
ret 4
end
if not aa_field b s 9 128 1
ret 2
end
if not aa_eq b s 9 1
ret 2
end
if not aa_field b s 17 128 1
ret 7
end
if not aa_eq b s 17 2
ret 7
end
if not aa_field b s 5 128 1
ret 3
end
if not aa_hex b s 5
ret 3
end
if not aa_field b s 29 128 1
ret 2
end
if not aa_parse b s 29 3 3
ret 2
end
if ne get s 106 0
st = new ulong 8 0
put st 3 3
n = get s 107
for i ulong add n 1
ch = ulong 0
if lt i n
ch = ulong get b add 20000 i
end
rc = artifact_parse 3 ch st
if eq rc 2
ret 1
end
if or eq rc 1 eq rc 3
j = get st 2
if eq rc 3
j = sub j 1
end
put s add 120 j get st 4
end
end
for i ulong 3
have = get s add 120 i
need = get s add 110 i
if gt have need
ret 0
end
if lt have need
ret 8
end
end
end
ret 0
end
fn artifact_admit b edit uchar 65536 s edit ulong 128 to ulong
if eq get s 0 0
if eq af_layout b s 0
ret 2
end
if not aa_hex b s 0
ret 2
end
put s 0 1
ret 0
end
if eq get s 0 1
if not aa_digest b s 0
ret 5
end
put s 0 2
put s 6 1
put s 7 11
ret 0
end
if eq get s 0 2
k = get s 7
if not aa_hex b s k
ret 2
end
if eq get s 5 0
ret 6
end
f = get s 6
if or eq f 3 eq f 4
if ne get s add 100 f 384
ret 5
end
end
if not aa_digest b s k
ret 5
end
if eq f 5
if not aa_field b s 10 64 0
ret 2
end
put s 0 3
else
put s 6 add f 1
if eq f 1
put s 7 13
else
if eq f 2
put s 7 15
else
if eq f 3
put s 7 16
else
put s 7 21
end
end
end
end
ret 0
end
if eq get s 0 3
if eq get s 5 0
ret 5
end
rc = aa_final b s
if ne rc 0
ret rc
end
put s 0 5
ret 0
end
ret 0
end

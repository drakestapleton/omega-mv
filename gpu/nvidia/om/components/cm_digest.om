note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Reuses om/cache/digest.om's SHA-256 schedule, constants, rounds and padding.
note Mode 0 initializes; mode 1 consumes 64 bytes; mode 2 finishes tail state[9] and writes data[0:32].
note State[0:8] is the chaining value and state[8] is consumed bytes. Mode 3 compares data[0:32] and [32:64].
fn cm_sha_output s view uint 8 data edit uchar 128 to void
for i ulong 8
for j ulong 4
q = add mul i 4 j
v = shr get s i mul sub ulong 3 j 8
put data q uchar and v 255
end
end
end
fn cm_digest mode ulong state edit ulong 16 data edit uchar 128 to ulong
if eq mode 3
for i ulong 32
if ne get data i get data add 32 i
ret 0
end
end
ret 1
end
s = new uint 8 0
if eq mode 0
kc_iv s
for i ulong 8
put state i ulong get s i
end
put state 8 ulong 0
ret 0
end
for i ulong 8
put s i uint get state i
end
w = new uint 64 0
kt = new uint 64 0
kc_k kt
if eq mode 1
kc_padsched w data 0
kc_rounds s w kt
put state 8 add get state 8 64
else
used = get state 9
if ge used 64
ret 1
end
n = add get state 8 used
for i ulong 128
if ge i used
put data i uchar 0
end
end
kc_finish s w kt data n
cm_sha_output s data
put state 8 n
end
for i ulong 8
put state i ulong get s i
end
ret 0
end

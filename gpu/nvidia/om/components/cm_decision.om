note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Predictions stride 9: mean, sd, dof, n, known, borrowed, energy, fail_p, refused.
note Failures[72:80]; n/op/eligible/need/current/cognitive/latency/energy[80:88].
note Allow/ei/maxfail/fallback/explorefrac/allowps/exploreps/workps[88:96].
note Outputs action/arm/measure0/measure1/why/pc/ei[100:107].
fn cm_dec_cdf x f64 to f64
z = div neg x bitcast f64 ulong 4609047870845172685
v = bitcast f64 cm_erfc bitcast ulong z
ret mul f64 0.5 v
end
fn cm_dec_ei d f64 s f64 to f64
if not gt s f64 0.0
if gt d f64 0.0
ret d
end
ret f64 0.0
end
u = div d s
ex = bitcast f64 cm_exp bitcast ulong mul mul f64 -0.5 u u false
v = div mul s ex bitcast f64 ulong 4612826843881809669
ret add v mul d cm_dec_cdf u
end
fn cm_dec_clean data edit ulong 128 to void
fb = get data 91
if ge fb get data 80
fb = ulong 0
end
elig = and or get data 82 shl ulong 1 fb sub shl ulong 1 get data 80 1
have = ulong 0
count = ulong 0
for a ulong 8
if lt a get data 80
bit = shl ulong 1 a
if ne and elig bit 0
if and ne a fb ne get data add 72 a 0
fp = bitcast f64 get data add mul a 9 7
if gt fp bitcast f64 get data 90
elig = and elig not bit
end
end
if ne and elig bit 0
count = add count 1
known = get data add mul a 9 4
borrowed = get data add mul a 9 5
if or ne known 0 ne borrowed 0
have = or have bit
end
end
end
end
end
put data 112 fb
put data 113 elig
put data 114 count
put data 123 have
put data 100 ulong 3
put data 101 fb
end
fn cm_dec_better data view ulong 128 a ulong b ulong to bool
if eq b 8
ret true
end
x = bitcast f64 get data mul a 9
y = bitcast f64 get data mul b 9
ret lt x y
end
fn cm_dec_best data edit ulong 128 to void
best = ulong 8
fit = ulong 8
for a ulong 8
if lt a get data 80
bit = shl ulong 1 a
if and ne and get data 123 bit 0 ne and get data 113 bit 0
mean = bitcast f64 get data mul a 9
sd = bitcast f64 get data add mul a 9 1
hi = cm_exp bitcast ulong add mean mul bitcast f64 ulong 4608450632455084940 sd true
fits = true
if ne get data 86 0
if not le bitcast f64 hi f64 get data 86
fits = false
end
end
energy = bitcast f64 get data add mul a 9 6
if and ne get data 87 0 ne energy f64 0.0
if not le energy f64 get data 87
fits = false
end
end
if cm_dec_better data a best
best = a
end
if fits
if cm_dec_better data a fit
fit = a
end
end
end
end
end
put data 117 ulong 0
if ne fit 8
best = fit
else
if ne best 8
put data 117 ulong 1
end
end
put data 115 best
end
fn cm_dec_pair data edit ulong 128 a ulong best ulong to void
as = bitcast f64 get data add mul a 9 1
bs = bitcast f64 get data add mul best 9 1
spread = bitcast f64 cm_sqrt bitcast ulong add mul as as mul bs bs
bm = bitcast f64 get data mul best 9
am = bitcast f64 get data mul a 9
delta = sub bm am
put data 124 bitcast ulong cm_dec_ei delta spread
if not gt spread f64 0.0
spread = bitcast f64 ulong 4472406533629990549
end
put data 125 bitcast ulong cm_dec_cdf div delta spread
end
fn cm_dec_competitor data edit ulong 128 to void
put data 118 ulong 8
put data 119 ulong 0
put data 120 ulong 0
put data 121 ulong 0
for a ulong 8
if lt a get data 80
bit = shl ulong 1 a
if and ne and get data 113 bit 0 ne a get data 115
unknown = or eq and get data 123 bit 0 eq get data 115 8
if unknown
put data 124 ulong 9218868437227405312
put data 125 ulong 4602678819172646912
else
cm_dec_pair data a get data 115
end
better = eq get data 118 8
if gt bitcast f64 get data 124 bitcast f64 get data 120
better = true
end
if better
put data 118 a
put data 120 get data 124
put data 121 get data 125
put data 119 ulong 0
if unknown
put data 119 ulong 1
end
end
end
end
end
put data 105 get data 121
if eq get data 120 9218868437227405312
put data 106 bitcast ulong f64 -1.0
else
put data 106 get data 120
end
end
fn cm_dec_explore data view ulong 128 to bool
cap = add mul bitcast f64 get data 92 f64 get data 95 f64 get data 93
ret lt f64 get data 94 cap
end
fn cm_dec_action data edit ulong 128 to void
why = ulong 0
if or eq get data 115 8 ne get data 119 0
why = ulong 1
else
if gt bitcast f64 get data 120 bitcast f64 get data 89
why = ulong 2
end
end
if and ne why 0 ne get data 88 0
if and cm_dec_explore data ne get data 118 8
put data 100 ulong 2
first = get data 115
if eq first 8
first = get data 112
end
second = get data 118
if eq first second
second = get data 112
end
put data 102 first
put data 103 second
put data 104 why
put data 101 first
ret
end
end
if eq get data 115 8
put data 104 ulong 1
if ne get data 88 0
if not cm_dec_explore data
put data 104 ulong 3
end
end
ret
end
put data 100 ulong 1
put data 101 get data 115
if ne get data 117 0
put data 104 ulong 5
else
if and ne why 0 ne get data 88 0
put data 104 ulong 3
else
put data 104 ulong 0
end
end
end
fn cm_decision mode ulong data edit ulong 128 to ulong
if eq mode 0
for i ulong 7
put data add 100 i ulong 0
end
if ge get data 81 1
put data 100 ulong 4
put data 104 ulong 6
put data 101 get data 80
put data 102 get data 80
put data 103 get data 80
for a ulong 8
put data add mul a 9 8 ulong 1
end
ret 0
end
ret 1
end
cm_dec_clean data
if le get data 114 1
put data 104 ulong 4
ret 0
end
cm_dec_best data
cm_dec_competitor data
cm_dec_action data
ret 0
end

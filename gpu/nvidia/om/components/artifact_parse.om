note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Byte-at-a-time memory-shell parser. 0 continue, 1 end accepted, 2 reject, 3 component.
note Modes 0 field text, 1 lowercase digest, 2 decimal comma list, 3 semantic version.
note State: digits, accumulator, component, expected components, emitted value, total bytes.
fn artifact_parse mode ulong ch ulong s edit ulong 8 to ulong
if eq mode 4
hi = shr ch 4
lo = and ch 15
if lt hi 10
hi = add hi 48
else
hi = add hi 87
end
if lt lo 10
lo = add lo 48
else
lo = add lo 87
end
ret or hi shl lo 8
end
if eq mode 0
if eq ch 0
ret 1
end
if or lt ch 32 eq ch 127
ret 2
end
ret 0
end
if eq mode 1
if eq ch 0
if eq get s 0 64
ret 1
end
ret 2
end
if ge get s 0 64
ret 2
end
valid = and ge ch 48 le ch 57
if and ge ch 97 le ch 102
valid = true
end
if not valid
ret 2
end
put s 0 add get s 0 1
ret 0
end
if and ne mode 2 ne mode 3
ret 2
end
if eq mode 2
if ge get s 5 63
if ne ch 0
ret 2
end
end
end
put s 5 add get s 5 1
if and ge ch 48 le ch 57
if ge get s 0 9
ret 2
end
put s 0 add get s 0 1
put s 1 add mul get s 1 10 sub ch 48
ret 0
end
if eq get s 0 0
ret 2
end
if eq ch 0
if ne add get s 2 1 get s 3
ret 2
end
put s 4 get s 1
ret 1
end
sep = ulong 44
if eq mode 3
sep = 46
end
if ne ch sep
ret 2
end
if ge add get s 2 1 get s 3
ret 2
end
put s 4 get s 1
put s 0 0
put s 1 0
put s 2 add get s 2 1
ret 3
end

note Positive continued fraction outside [0,2), double-double erf series inside.
fn cm_erfc_small x f64 out edit ulong 2 to void
p = new ulong 2 0
q = new ulong 2 0
r = new ulong 2 0
put p 0 bitcast ulong x
put out 0 bitcast ulong x
put out 1 0
cm_mul neg x f64 0.0 x f64 0.0 r
for i ulong 64
cm_dd_mul p r
cm_dd_div_scalar p f64 add i 1
cm_div bitcast f64 get p 0 bitcast f64 get p 1 f64 add mul i 2 3 f64 0.0 q
cm_dd_add out q
end
cm_mul bitcast f64 get out 0 bitcast f64 get out 1 bitcast f64 ulong 4603256987541740397 bitcast f64 ulong 4350950281585880448 out
cm_dd_scale out f64 -2.0
cm_add f64 1.0 f64 0.0 bitcast f64 get out 0 bitcast f64 get out 1 out
end
fn cm_erfc_cf x f64 out edit ulong 2 to void
q = new ulong 2 0
put out 0 bitcast ulong x
put out 1 0
for j ulong 512
i = sub 512 j
cm_div mul f64 i f64 0.5 f64 0.0 bitcast f64 get out 0 bitcast f64 get out 1 q
cm_add x f64 0.0 bitcast f64 get q 0 bitcast f64 get q 1 out
end
cm_div bitcast f64 ulong 4603256987541740397 bitcast f64 ulong 4350950281585880448 bitcast f64 get out 0 bitcast f64 get out 1 out
end
fn cm_erfc_reflect a edit ulong 2 to void
cm_add f64 2.0 f64 0.0 neg bitcast f64 get a 0 neg bitcast f64 get a 1 a
end
fn cm_erfc bits ulong to ulong
x = bitcast f64 and bits 9223372036854775807
if ne x x
ret bitcast ulong add x x
end
negative = ne and bits 9223372036854775808 0
if ge x f64 28.0
if negative
ret 4611686018427387904
end
ret 0
end
if and negative ge x f64 6.0
ret 4611686018427387904
end
out = new ulong 2 0
if lt x f64 2.0
cm_erfc_small x out
if negative
cm_erfc_reflect out
end
ret bitcast ulong add bitcast f64 get out 0 bitcast f64 get out 1
end
factor = new ulong 2 0
cm_erfc_cf x factor
cm_mul neg x f64 0.0 x f64 0.0 out
h = bitcast f64 get out 0
l = bitcast f64 get out 1
k = cm_exp_reduce h l false out
cm_dd_mul out factor
if negative
scale = bitcast f64 shl ulong add k 1023 52
cm_dd_scale out scale
cm_erfc_reflect out
ret bitcast ulong add bitcast f64 get out 0 bitcast f64 get out 1
end
if lt k -1075
ret 0
end
ret cm_scale_bits out k
end
fn cm_sqrt_core x f64 to f64
bits = bitcast ulong x
sig = or and bits 4503599627370495 4503599627370496
shift = add 52 sub and shr bits 52 2047 1023
root = ulong 0
rest = ulong 0
for i ulong 53
top = sub 105 mul i 2
bottom = sub top 1
pair = ulong 0
if ge top shift
pair = shl and shr sig sub top shift 1 1
end
if ge bottom shift
pair = or pair and shr sig sub bottom shift 1
end
rest = or shl rest 2 pair
trial = or shl root 2 1
root = shl root 1
if ge rest trial
rest = sub rest trial
root = add root 1
end
end
if gt rest root
root = add root 1
end
ret mul f64 root bitcast f64 ulong 4372995238176751616
end
fn cm_sqrt bits ulong to ulong
x = bitcast f64 bits
if ne x x
ret bitcast ulong add x x
end
if eq and bits 9223372036854775807 0
ret bits
end
if lt x f64 0.0
ret 9221120237041090560
end
if eq bits 9218868437227405312
ret bits
end
adj = long 0
if eq and shr bits 52 2047 0
x = mul x bitcast f64 ulong 4850376798678024192
bits = bitcast ulong x
adj = -54
end
e = add sub long and shr bits 52 2047 1023 adj
m = bitcast f64 or and bits 4503599627370495 4607182418800017408
if ne and e 1 0
m = mul m f64 2.0
e = sub e 1
end
scale = bitcast f64 shl ulong add div e 2 1023 52
ret bitcast ulong mul cm_sqrt_core m scale
end
fn cm_math mode ulong bits ulong to ulong
if eq mode 0
ret bitcast ulong cm_log bitcast f64 bits false
end
if eq mode 1
ret bitcast ulong cm_log bitcast f64 bits true
end
if eq mode 2
ret cm_ceil bits
end
if eq mode 3
ret cm_exp bits false
end
if eq mode 4
ret cm_exp bits true
end
if eq mode 5
ret cm_sqrt bits
end
if eq mode 7
ret and bits 9223372036854775807
end
if eq mode 6
ret cm_erfc bits
end
ret 9221120237041090560
end

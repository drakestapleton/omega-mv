note Output and parse share canonical field indexes, never C printf formats.
note b input occupies 0..32767, output starts at 32768.
note s: mode,cursor,capacity,input size,overflow; offsets8..42 lengths48..82.
fn af_put b edit uchar 65536 s edit ulong 128 ch ulong to void
if ge get s 1 get s 2
put s 4 1
ret
end
put b add 32768 get s 1 uchar ch
put s 1 add get s 1 1
end
fn af_name b edit uchar 65536 s edit ulong 128 k ulong to void
p = ulong 0
while ne af_key k p 0 bound 64
af_put b s af_key k p
p = add p 1
end
end
fn af_num b edit uchar 65536 s edit ulong 128 v ulong base ulong to void
ds = new ulong 64 0
n = ulong 0
while ge v base bound 64
put ds n rem v base
n = add n 1
v = div v base
end
put ds n v
n = add n 1
while ne n 0 bound 64
n = sub n 1
d = get ds n
if lt d 10
af_put b s add d 48
else
af_put b s add d 87
end
end
end
fn af_escape b edit uchar 65536 s edit ulong 128 ch ulong to void
if or eq ch 34 eq ch 92
af_put b s 92
af_put b s ch
ret
end
if or lt ch 32 eq ch 127
af_put b s 92
af_put b s 117
af_put b s 48
af_put b s 48
d = shr ch 4
if lt d 10
af_put b s add d 48
else
af_put b s add d 87
end
d = and ch 15
if lt d 10
af_put b s add d 48
else
af_put b s add d 87
end
ret
end
af_put b s ch
end

fn af_layout b view uchar 65536 s edit ulong 128 to ulong
n = get s 3
if or lt n 23 ge n 8192
ret 0
end
for i ulong n
if or eq get b i 0 eq get b i 13
ret 0
end
end
off = ulong 0
while ne af_key 35 off 0 bound 64
if ne ulong get b off af_key 35 off
ret 0
end
off = add off 1
end
if ne get b off 10
ret 0
end
off = add off 1
for k ulong 34
p = ulong 0
while ne af_key k p 0 bound 64
if ge off n
ret 0
end

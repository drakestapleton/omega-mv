if eq k 34
af_name b s 35
else
off = get s add k 8
n = get s add k 48
if or gt off 32768 gt n sub 32768 off
put s 4 1
ret
end
for p ulong n
ch = ulong get b add off p
if ne js 0
af_escape b s ch
else
af_put b s ch
end
end
end

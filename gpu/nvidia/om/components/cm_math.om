note First-party binary64 helpers; bits transport avoids public float ABI.
note Constants from Wolfram binary-exact split evaluation, documented in HOST_POLICY.md.
fn cm_norm h f64 l f64 o edit ulong 2 to void
s = add h l
put o 0 bitcast ulong s
put o 1 bitcast ulong sub l sub s h
end
fn cm_add ah f64 al f64 bh f64 bl f64 o edit ulong 2 to void
s = add ah bh
v = sub s ah
e = add sub ah sub s v sub bh v
e = add e add al bl
cm_norm s e o
end
fn cm_prodlo a f64 b f64 p f64 to f64
split = bitcast f64 ulong 4728779608772575232
ca = mul split a
cb = mul split b
ah = sub ca sub ca a
bh = sub cb sub cb b
al = sub a ah
bl = sub b bh
e = sub mul ah bh p
e = add e mul ah bl
e = add e mul al bh
ret add e mul al bl
end
fn cm_mul ah f64 al f64 bh f64 bl f64 o edit ulong 2 to void
p = mul ah bh
e = cm_prodlo ah bh p
e = add e add mul ah bl mul al bh
e = add e mul al bl
cm_norm p e o
end
fn cm_div ah f64 al f64 bh f64 bl f64 o edit ulong 2 to void
q = div ah bh
cm_mul q f64 0.0 bh bl o
cm_add ah al neg bitcast f64 get o 0 neg bitcast f64 get o 1 o
r = div add bitcast f64 get o 0 bitcast f64 get o 1 bh
cm_norm q r o
end
fn cm_dd_add a edit ulong 2 b view ulong 2 to void
cm_add bitcast f64 get a 0 bitcast f64 get a 1 bitcast f64 get b 0 bitcast f64 get b 1 a
end
fn cm_dd_mul a edit ulong 2 b view ulong 2 to void
cm_mul bitcast f64 get a 0 bitcast f64 get a 1 bitcast f64 get b 0 bitcast f64 get b 1 a
end
fn cm_dd_scale a edit ulong 2 b f64 to void
cm_mul bitcast f64 get a 0 bitcast f64 get a 1 b f64 0.0 a
end
fn cm_logcore m f64 s edit ulong 2 to void
t = new ulong 2 0
p = new ulong 2 0
u = new ulong 2 0
cm_add m f64 0.0 f64 1.0 f64 0.0 u
cm_div sub m f64 1.0 f64 0.0 bitcast f64 get u 0 bitcast f64 get u 1 t
put p 0 get t 0
put p 1 get t 1
put s 0 get t 0
put s 1 get t 1
cm_mul bitcast f64 get t 0 bitcast f64 get t 1 bitcast f64 get t 0 bitcast f64 get t 1 t
for i ulong 32
cm_dd_mul p t
den = f64 add mul i 2 3
cm_div bitcast f64 get p 0 bitcast f64 get p 1 den f64 0.0 u
cm_dd_add s u
end
end
fn cm_log x f64 base2 bool to f64
bits = bitcast ulong x
if eq and bits 9223372036854775807 0
ret bitcast f64 ulong 18442240474082181120
end
if ne x x
ret add x x
end
if lt x f64 0.0
ret bitcast f64 ulong 9221120237041090560
end
if eq bits 9218868437227405312
ret x
end
adj = long 0
if eq and shr bits 52 2047 0
x = mul x bitcast f64 ulong 4850376798678024192
bits = bitcast ulong x
adj = -54
end
e = add sub long and shr bits 52 2047 1023 adj
m = bitcast f64 or and bits 4503599627370495 4607182418800017408
if gt m bitcast f64 ulong 4609047870845172685
m = mul m f64 0.5
e = add e 1
end
s = new ulong 2 0
u = new ulong 2 0
cm_logcore m s
cm_mul f64 e f64 0.0 bitcast f64 ulong 4604418534313441775 bitcast f64 ulong 4358002977218854975 u
cm_dd_scale s f64 2.0
cm_dd_add s u
if base2
cm_mul bitcast f64 get s 0 bitcast f64 get s 1 bitcast f64 ulong 4609176140021203710 bitcast f64 ulong 4357082904033627428 s
end
ret add bitcast f64 get s 0 bitcast f64 get s 1
end
fn cm_ceil bits ulong to ulong
x = bitcast f64 bits
if ne x x
ret bitcast ulong add x x
end
e = and shr bits 52 2047
if ge e 1075
ret bits
end
if lt e 1023
if eq and bits 9223372036854775807 0
ret bits
end
if ne and bits 9223372036854775808 0
ret 9223372036854775808
end
ret 4607182418800017408
end
mask = sub shl ulong 1 sub 1075 e 1
if eq and bits mask 0
ret bits
end
if eq and bits 9223372036854775808 0
bits = add bits add mask 1
end
ret and bits not mask
end

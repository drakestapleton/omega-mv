note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn api_rt_plan mode ulong a edit ulong 16 to ulong
if eq mode 0
put a 7 ulong 0
if or eq get a 0 0 gt get a 0 64
ret 1
end
put a 7 ulong 1
e = get a 1
if eq e 0
e = 128
end
if or and ne e 128 ne e 256 gt get a 2 1
ret 1
end
put a 8 e
put a 9 add e get a 2
put a 10 add ulong 8 get a 2
put a 11 ulong 16640
put a 12 ulong 16768
if ne get a 2 0
put a 11 ulong 16656
put a 12 ulong 16800
end
put a 13 mul mul get a 0 get a 9 4096
put a 14 mul get a 0 8192
put a 15 mul mul get a 0 get a 9 32
ret 0
end
if eq mode 1
w = get a 0
d = get a 1
if eq w 0
w = 32
end
if eq d 0
d = 4
end
put a 8 w
put a 9 d
put a 10 get a 2
if eq get a 2 128
put a 10 ulong 0
end
ret 0
end
if eq mode 2
if or eq get a 0 0 gt get a 0 64
ret 1
end
if gt get a 0 1
if or lt get a 1 8192 ne and get a 1 15 0
ret 1
end
if or lt get a 2 get a 3 ne and get a 2 255 0
ret 1
end
end
put a 8 ulong 0
if eq get a 0 1
put a 8 ulong 1
end
ret 0
end
if eq mode 3
if ge get a 0 get a 1
ret 1
end
put a 8 ulong 0
put a 9 ulong 0
put a 10 ulong 1
if gt get a 2 1
if or eq get a 3 0 eq get a 4 0
ret 1
end
put a 8 get a 5
put a 9 get a 6
put a 10 get a 2
end
ret 0
end
if eq mode 4
if gt mul mul ulong 32 get a 0 get a 1 65536
ret 2
end
ret 0
end
ret 1
end

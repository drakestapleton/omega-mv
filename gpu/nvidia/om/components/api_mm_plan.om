note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
fn mm_dims a edit ulong 16 to ulong
m = get a 0
k = get a 1
n = get a 2
if or eq m 0 or eq k 0 eq n 0
ret 1
end
if or gt m 8192 or gt k 16384 gt n 262144
ret 2
end
if or gt get a 3 262144 gt get a 4 128
ret 2
end
m = mul div add m 15 16 16
k = mul div add k 15 16 16
n = mul div add n 7 8 8
put a 8 m
put a 9 k
put a 10 n
put a 11 mul mul m k 2
put a 13 mul mul k n 2
k = mul mul m n 4
n = get a 3
n = mul div add n 7 8 8
n = mul n 64
if gt n k
k = n
end
put a 12 k
put a 14 mul get a 1 get a 2
ret 0
end
fn mm_tiles a edit ulong 16 to void
mt = div get a 0 16
nt = div get a 1 8
r = ulong 1
c = ulong 1
if eq rem mt 2 0
r = 2
end
if eq rem mt 4 0
r = 4
end
while gt r 1 bound 2
c = 1
if eq rem nt 2 0
c = 2
end
if eq rem nt 4 0
c = 4
end
fit = mul sub r 1 64
fit = mul fit get a 1
fit = add fit mul sub c 1 32
if lt add fit 4 8388608
break
end
r = div r 2
end
if eq r 1
c = 1
end
put a 10 r
put a 11 c
end
fn mm_grid a edit ulong 16 to ulong
mm_tiles a
budget = get a 2
if eq budget 0
budget = 1024
end
rows = get a 0
r = get a 10
rb = div div rows 16 r
if gt rb budget
rows = mul mul budget 16 r
end
gx = div budget div div rows 16 r
if eq gx 0
gx = 1
end
rb = div div get a 1 8 get a 11
if gt gx rb
gx = rb
end
put a 8 rows
put a 9 gx
put a 12 div div rows 16 r
ret 0
end
fn api_mm_plan mode ulong a edit ulong 16 to ulong
if eq mode 0
ret mm_dims a
end
if eq mode 3
v = and add get a 0 sub get a 1 1 4294967295
put a 8 mul div v get a 1 get a 1
ret 0
end
if eq mode 1
ret mm_grid a
end
if eq mode 2
chunk = ulong 64
if ne get a 3 0
fit = div 262144 mul get a 0 8
if lt fit chunk
chunk = fit
end
end
last = add get a 2 chunk
if lt sub get a 1 get a 2 chunk
last = get a 1
end
put a 8 chunk
put a 9 last
ret 0
end
if eq mode 4
if or ne get a 0 get a 2 ne get a 1 get a 3
ret 1
end
ret 0
end
if eq mode 5
ks = div get a 0 16
blk = or gt get a 1 1 gt get a 2 1
u = ulong 1
if blk
if eq rem ks 2 0
sum = add get a 1 get a 2
if le mul sum 2 8
u = 2
end
end
else
u = get a 3
if eq u 0
u = 1
if eq rem ks 2 0
u = 2
end
if eq rem ks 4 0
u = 4
end
end
end
if and ne get a 4 0 or blk eq get a 3 0
while and gt u 1 lt div ks u 2
u = div u 2
end
end
put a 8 ulong 0
if blk
put a 8 ulong 1
end
put a 9 u
ret 0
end
if eq mode 6
c = mul get a 0 8
w = mul get a 1 8
if gt w get a 2
w = get a 2
end
put a 8 c
put a 9 sub w c
ret 0
end
if eq mode 7
rows = get a 0
if gt rows get a 1
rows = get a 1
end
put a 8 rows
put a 9 div div rows 16 get a 2
ret 0
end
if eq mode 8
rows = get a 0
if eq rows 0
rows = 1024
end
put a 8 rows
ret 0
end
ret 1
end

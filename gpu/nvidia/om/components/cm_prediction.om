note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Quiet mean/sd/dof/n[0:4], pressure[4], residual present[5], mean/sd/dof/n[6:10].
note Scale[10], core[11], power by core[12:15]. Output mean/sd/dof/n/known/borrowed/energy[16:23].
fn cm_prediction words edit ulong 32 to ulong
mean = bitcast f64 get words 0
sd = bitcast f64 get words 1
dof = bitcast f64 get words 2
n = get words 3
put words 20 ulong 0
put words 21 ulong 0
if eq get words 4 0
put words 20 ulong 1
else
if ne get words 5 0
mean = add mean bitcast f64 get words 6
rsd = bitcast f64 get words 7
sd = bitcast f64 cm_sqrt bitcast ulong add mul sd sd mul rsd rsd
rdof = bitcast f64 get words 8
if lt rdof dof
dof = rdof
end
n = get words 9
put words 20 ulong 1
else
sd = bitcast f64 cm_sqrt bitcast ulong add mul sd sd f64 1.0
put words 21 ulong 1
end
end
scale = bitcast f64 get words 10
if not ge scale f64 1.0
scale = f64 1.0
end
put words 16 bitcast ulong mean
put words 17 bitcast ulong mul sd scale
put words 18 bitcast ulong dof
put words 19 and n 4294967295
core = get words 11
if ge core 3
core = ulong 2
end
mw = bitcast f64 get words add 12 core
put words 22 ulong 0
if gt mw f64 0.0
cost = bitcast f64 cm_exp bitcast ulong mean true
energy = mul mul cost mw bitcast f64 ulong 4562254508917369340
put words 22 bitcast ulong energy
end
ret 0
end

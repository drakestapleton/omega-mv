note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Elementwise API IR record construction. Wire ABI: src/omega_gpu_om_ir.h.
note All register numbers are virtual; allocation and encoding use the existing replay entry.
note Scratch metadata: 8 loop depth, 9..12 open loops, 13 region depth,
note 14 predicated exit, 15 test-only exit bypass, 352..367 BSSY indices,
note 368 region mutant, 369 math mutant, 370 test path. No exact-live override.
const NR ulong 65535
const ALL ulong 18446744073709551615
const MASK32 ulong 4294967295
const MOVRZ ulong 1
const MOVI ulong 2
const S2R ulong 3
const LDC ulong 4
const LDC64 ulong 5
const LDCU64 ulong 7
const IMAD ulong 8
const WIDE ulong 9
const LDG ulong 11
const STG ulong 12
const ADD ulong 14
const SHR ulong 17
const GE ulong 28
const XOR ulong 29
const FADD ulong 30
const FSUB ulong 31
const FMUL ulong 32
const FFMA ulong 33
const RCP ulong 40
const RSQ ulong 41
const SHFL ulong 42
const EXIT ulong 45
const BRA ulong 46
const EX2 ulong 47
const BAR ulong 48
const LDS ulong 49
const STS ulong 50
const LUT ulong 51
const SHL ulong 52
const HI ulong 53
const BSSY ulong 54
const BSYNC ulong 55
fn cw st ulong wb ulong readb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl readb 17 shl wt 20
end
fn fld x ulong to ulong
if eq x NR
ret ALL
end
ret x
end
fn r4 d ulong a ulong b ulong c ulong to ulong
ret or or d shl a 16 or shl b 32 shl c 48
end
note op | kind << 8 | flags << 16 | uniform register << 40
fn ok op ulong kind ulong flags ulong ur ulong to ulong
ret or or op shl kind 8 or shl flags 16 shl ur 40
end
fn ctrl k ulong fl ulong wt ulong to ulong
if eq k 1
ret cw 14 7 7 wt
end
if eq k 2
ret or or cw 4 0 7 wt 8192 shl ulong 1 32
end
if eq k 3
ret or or cw 4 2 7 wt 8192 shl ulong 4 32
end
if eq k 4
ret or or cw 4 7 1 wt 8192 shl ulong 2 32
end
if or eq k 6 eq k 7
if ne and fl 2 0
ret or cw 5 7 7 wt shl wt 32
end
ret cw 5 7 7 wt
end
if eq k 8
ret or cw 1 7 7 wt 8192
end
if eq k 9
ret or cw 5 7 7 wt 8192
end
ret cw 6 7 7 wt
end
fn operands ins edit ulong 8192 n ulong spec ulong regs ulong to void
put ins n and spec 255
put ins add n 1 fld and regs 65535
put ins add n 2 fld and shr regs 16 65535
put ins add n 3 fld and shr regs 32 65535
put ins add n 4 fld shr regs 48
put ins add n 5 fld and shr spec 40 65535
end
fn emit ins edit ulong 8192 m edit ulong 512 spec ulong regs ulong imm ulong to void
n = get m 0
if ge n 1024
put m 4 1
ret
end
cc = ctrl and shr spec 8 255 and shr spec 16 255 get m 3
put m 0 add n 1
n = mul n 8
operands ins n spec regs
put ins add n 6 or and imm MASK32 shl and cc MASK32 32
put ins add n 7 and shr spec 16 255
put m 3 shr cc 32
end
fn fx ins edit ulong 8192 m edit ulong 512 op ulong regs ulong imm ulong to void
emit ins m ok op 0 0 NR regs imm
end
fn vr ins edit ulong 8192 m edit ulong 512 op ulong regs ulong imm ulong to void
emit ins m ok op 2 0 NR regs imm
end
fn nv m edit ulong 512 width ulong to ulong
v = get m 1
if ge v 256
put m 4 2
ret NR
end
put m add 64 v width
put m 1 add v 1
ret v
end
fn movi ins edit ulong 8192 m edit ulong 512 d ulong imm ulong to void
fx ins m MOVI r4 d NR NR NR imm
end
fn zero ins edit ulong 8192 m edit ulong 512 d ulong to void
fx ins m MOVRZ r4 d NR NR NR 0
end
fn ai ins edit ulong 8192 m edit ulong 512 d ulong a ulong imm ulong c ulong to void
fx ins m IMAD r4 d a NR c imm
end
fn ar ins edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong c ulong to void
fx ins m IMAD r4 d a b c 0
end
fn add3 ins edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
fx ins m ADD r4 d a b NR 0
end
fn addr ins edit ulong 8192 m edit ulong 512 d ulong idx ulong base ulong to void
fx ins m WIDE r4 d idx NR base 4
end
fn load ins edit ulong 8192 m edit ulong 512 d ulong a ulong to void
emit ins m ok LDG 2 0 0 r4 d a NR NR 0
end
fn store ins edit ulong 8192 m edit ulong 512 a ulong v ulong to void
emit ins m ok STG 4 0 0 r4 NR a v NR 0
end
fn ldconst ins edit ulong 8192 m edit ulong 512 d ulong off ulong to void
vr ins m LDC r4 d NR NR NR off
end
fn isgte ins edit ulong 8192 m edit ulong 512 a ulong b ulong to void
emit ins m ok GE 1 0 NR r4 NR a b NR 0
end
fn split m edit ulong 512 to bool
if or gt get m 13 0 and ne get m 14 0 eq get m 15 0
put m 4 3
ret true
end
ret false
end
fn shfl ins edit ulong 8192 m edit ulong 512 d ulong a ulong off ulong to void
if split m
ret
end
vr ins m SHFL r4 d a NR NR off
end
fn bar ins edit ulong 8192 m edit ulong 512 to void
if split m
ret
end
emit ins m ok BAR 5 0 NR r4 NR NR NR NR 0
end
fn exitp ins edit ulong 8192 m edit ulong 512 to void
if gt get m 13 0
put m 4 4
ret
end
put m 14 1
emit ins m ok EXIT 6 2 NR r4 NR NR NR NR 0
end
fn branch ins edit ulong 8192 m edit ulong 512 target ulong flags ulong to void
emit ins m ok BRA 7 flags NR r4 NR NR NR NR and sub target get m 0 MASK32
end
fn fwd ins edit ulong 8192 m edit ulong 512 to ulong
at = get m 0
emit ins m ok BRA 7 2 NR r4 NR NR NR NR 1
ret at
end
fn patch ins edit ulong 8192 m edit ulong 512 at ulong to void
if or ne get m 4 0 ge at get m 0
put m 4 5
ret
end
idx = add mul at 8 6
put ins idx or and get ins idx shl MASK32 32 sub get m 0 at
end
fn tail ins edit ulong 8192 m edit ulong 512 to void
emit ins m ok EXIT 6 0 NR r4 NR NR NR NR 0
emit ins m ok BRA 7 0 NR r4 NR NR NR NR 0
put ins add mul sub get m 0 1 8 6 shl ulong 1032192 32
end
fn lb m edit ulong 512 to void
d = get m 8
if ge d 4
put m 4 6
ret
end
put m add 9 d get m 0
put m 8 add d 1
end
fn lend m edit ulong 512 to void
d = get m 8
n = get m 5
if or eq d 0 ge n 4
put m 4 7
ret
end
d = sub d 1
put m 8 d
put m add 16 mul n 2 get m add 9 d
put m add 17 mul n 2 sub get m 0 1
put m 5 add n 1
end
fn rb ins edit ulong 8192 m edit ulong 512 to void
d = get m 13
if ge d 16
put m 4 8
ret
end
put m add 352 d get m 0
emit ins m ok BSSY 8 0 NR r4 NR NR NR NR 2
put ins add mul sub get m 0 1 8 7 shl d 48
put m 13 add d 1
end
fn rx ins edit ulong 8192 m edit ulong 512 cond ulong to void
flags = ulong 0
if ne cond 0
flags = ulong 2
if eq cond 2
flags = ulong 6
end
end
emit ins m ok BRA 7 flags NR r4 NR NR NR NR 1
d = get m 13
if eq d 0
put m 4 9
ret
end
idx = add mul sub get m 0 1 8 7
put ins idx or get ins idx shl d 56
end
fn rj ins edit ulong 8192 m edit ulong 512 to void
d = get m 13
if eq d 0
put m 4 10
ret
end
d = sub d 1
at = get m 0
op = BSYNC
if eq get m 368 1
op = ulong 0
end
emit ins m ok op 9 0 NR r4 NR NR NR NR 0
put ins add mul at 8 7 shl d 48
bs = get m add 352 d
idx = add mul bs 8 6
delta = sub add at 1 bs
if eq get m 368 2
delta = add delta 1
end
put ins idx or and get ins idx shl MASK32 32 delta
rexits ins d at
put m 13 d
end
fn rexits ins edit ulong 8192 d ulong at ulong to void
for i ulong at
idx = add mul i 8 7
if eq shr get ins idx 56 add d 1
put ins idx and get ins idx not shl MASK32 56
idx = add mul i 8 6
put ins idx or and get ins idx shl MASK32 32 sub at i
end
end
end
fn prolog ins edit ulong 8192 m edit ulong 512 to void
put m 2 1
put m 320 2
for i ulong 5
width = ulong 1
if lt i 3
width = ulong 2
end
v = nv m width
end
emit ins m ok LDCU64 3 1 NR r4 0 NR NR NR 856
vr ins m LDC64 r4 0 NR NR NR 896
vr ins m LDC64 r4 1 NR NR NR 904
vr ins m LDC64 r4 2 NR NR NR 912
vr ins m S2R r4 3 NR NR NR 33
vr ins m S2R r4 4 NR NR NR 37
end
fn paircls op ulong to ulong
if or or or eq op MOVRZ eq op MOVI or eq op ADD eq op XOR or or eq op LUT eq op SHR eq op SHL
ret 1
end
if or or eq op IMAD eq op HI or or eq op FADD eq op FSUB or eq op FMUL eq op FFMA
ret 2
end
ret 0
end
fn schedule ins edit ulong 8192 m edit ulong 512 to void
n = get m 0
if lt n 2
ret
end
for i ulong sub n 1
b = mul i 8
op = get ins b
cls = paircls op
cc = shr get ins add b 6 32
if and ne cls 0 ne op ADD
if eq cls paircls get ins add b 8
if eq and get ins add b 7 2 0
if eq and get ins add b 15 2 0
if eq and shr cc 9 15 6
tighten ins b cc
end
end
end
end
end
end
end
fn tighten ins edit ulong 8192 b ulong cc ulong to void
cc = or and cc not shl ulong 15 9 shl ulong 5 9
idx = add b 6
put ins idx or and get ins idx MASK32 shl cc 32
end

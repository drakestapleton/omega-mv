note Probe registers: n5 i6 idx7 x8 y9 r10 s11 one12 cm1=13 nm1=14 d15 neg16 off17.
fn rpbegin ins edit ulong 8192 m edit ulong 512 to void
alloc m 13
put m 81 2
ldconst ins m 5 920
movi ins m 12 1
movi ins m 13 4294967295
ai ins m 6 4 128 3
add3 ins m 14 5 13
ai ins m 15 6 4294967295 14
fx ins m SHR r4 16 15 NR NR 31
ar ins m 7 16 15 6
addr ins m 17 7 0
load ins m 8 17
addr ins m 17 7 1
load ins m 9 17
end
fn rpend ins edit ulong 8192 m edit ulong 512 to void
out = nv m 1
off = nv m 2
shfl ins m 11 10 1
ai ins m out 11 4099 10
isgte ins m 6 5
exitp ins m
addr ins m off 6 2
store ins m off out
tail ins m
end
fn diamond ins edit ulong 8192 m edit ulong 512 to void
rpbegin ins m
alloc m 2
rb ins m
isgte ins m 8 9
els = fwd ins m
add3 ins m 10 8 12
rx ins m 0
patch ins m els
ai ins m 18 8 3 9
fx ins m XOR r4 19 18 8 NR 0
ai ins m 10 19 5 12
fx ins m SHR r4 18 10 NR NR 3
add3 ins m 10 10 18
if ne get m 369 0
add3 ins m 10 10 12
end
rj ins m
rpend ins m
end
fn countlp ins edit ulong 8192 m edit ulong 512 to void
note v18 cnt19; st/bound/c255/c15 allocated after optional nested registers20/21.
st = nv m 1
lim = nv m 1
c255 = nv m 1
c15 = nv m 1
movi ins m c255 255
movi ins m c15 15
if ne get m 369 0
movi ins m lim 255
else
movi ins m lim 256
end
fx ins m LUT r4 18 8 c255 NR 192
fx ins m LUT r4 st 9 c15 NR 192
add3 ins m st st 12
zero ins m 19
rb ins m
lb m
at = get m 0
isgte ins m 18 lim
rx ins m 1
add3 ins m 18 18 st
add3 ins m 19 19 12
branch ins m at 0
lend m
rj ins m
end
fn loopbrk ins edit ulong 8192 m edit ulong 512 to void
rpbegin ins m
alloc m 2
countlp ins m
ai ins m 10 19 256 18
rpend ins m
end
fn nested ins edit ulong 8192 m edit ulong 512 to void
rpbegin ins m
alloc m 4
movi ins m 10 7
movi ins m 21 100
fx ins m LUT r4 20 8 12 NR 192
rb ins m
isgte ins m 20 12
rx ins m 1
countlp ins m
ai ins m 10 19 256 18
add3 ins m 10 10 21
rj ins m
rpend ins m
end
fn exitbar ins edit ulong 8192 m edit ulong 512 early ulong to void
rpbegin ins m
note saddr18 paddr19 yv20 xv21 low22.
alloc m 5
if ne early 0
if and eq early 1 ne get m 370 0
put m 15 1
end
isgte ins m 6 5
exitp ins m
end
ai ins m 21 8 1 NR
fx ins m LUT r4 22 8 12 NR 192
rb ins m
isgte ins m 22 12
rx ins m 1
add3 ins m 21 21 12
rj ins m
ai ins m 18 3 4 NR
emit ins m ok STS 4 0 NR r4 NR 18 21 NR 0
bar ins m
fx ins m XOR r4 19 3 12 NR 0
ai ins m 19 19 4 NR
vr ins m LDS r4 20 19 NR NR 0
ai ins m 10 8 3 20
rpend ins m
end
fn depth ins edit ulong 8192 m edit ulong 512 levels ulong to void
rpbegin ins m
ai ins m 10 8 1 NR
for d ulong levels
rb ins m
isgte ins m 8 9
rx ins m 1
add3 ins m 10 10 12
end
for d ulong levels
rj ins m
end
rpend ins m
end
fn refuse ins edit ulong 8192 m edit ulong 512 which ulong to void
rpbegin ins m
if eq which 19
rb ins m
isgte ins m 6 5
exitp ins m
rj ins m
end
if eq which 20
rb ins m
bar ins m
rj ins m
end
if eq which 21
rb ins m
shfl ins m 11 8 1
rj ins m
end
if eq which 22
rb ins m
isgte ins m 8 9
rx ins m 1
end
if eq which 23
rj ins m
end
ai ins m 10 8 1 NR
rpend ins m
end

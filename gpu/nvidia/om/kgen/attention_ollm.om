note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Own Omega LLM one-row decode, E=64, MHA H=6/8/16. No allocation or launch effects.
note Compose with attention_emit/tuned/general/ir.om; emits the existing fused general kernel.
note KV layout per layer: [K plane | V plane], each [head][capacity][64], head contiguous.
note Query and output are f32 [H][64], already RoPE rotated. KV f32 by default, BF16 opt-in.
note shape[0..3] = heads,capacity,position,kv_bf16. Caller supplies args[0..7] pointer pairs:
note Q, layer pool (K plane), output, table. This function fills remaining constant-bank words.
note Table row [lo,hi,block-table-word-offset,reserved], then H byte offsets, then block id zero.
note All unused table words are cleared so a reused table cannot extend the admitted range.
note Score scale = Log[2,E]/Sqrt[64], Wolfram 0.18033688011112042591999058512523651718.
fn attention_ollm_wire shape view ulong 4 tab edit uint 64 args edit uint 32 to ulong
h = get shape 0
cap = get shape 1
pos = get shape 2
bf = get shape 3
if and and ne h 6 ne h 8 ne h 16
ret 1
end
if or or eq cap 0 gt cap 16384 ge pos cap
ret 1
end
if gt bf 1
ret 1
end
esize = ulong 4
if eq bf 1
esize = ulong 2
end
headb = mul mul cap 64 esize
for i ulong 64
put tab i 0
end
put tab 1 uint add pos 1
put tab 2 uint add h 4
for i ulong h
put tab add i 4 uint mul i headb
end
for i ulong 24
put args add i 8 0
end
put args 9 bitcast uint 0.1803368801111204259f32
put args 11 uint mul 64 esize
put args 12 uint mul h headb
put args 13 16
put args 14 uint h
ret 0
end
fn attention_ollm_ir bf ulong ins edit ulong 8192 meta edit ulong 512 to ulong
if gt bf 1
ret 1
end
kind = ulong 3
if eq bf 1
kind = ulong 2
end
ret attention_ir kind 64 31 0 ins meta
end

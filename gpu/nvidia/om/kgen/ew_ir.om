note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note API: kind = OmegaGpuEwOp (1..23), a = existing mutant (0..3), b = host test path (0/1), c = 0.
note The complete generator, including reconvergence, loop liveness metadata and pair scheduling,
note is seeded Omega. C unpacks the spec and invokes the single common IR replay entry.
fn ew_ir kind ulong a ulong b ulong c ulong ins edit ulong 8192 meta edit ulong 512 to ulong
for i ulong 512
put meta i 0
end
if or or lt kind 1 gt kind 23 or or gt a 3 gt b 1 ne c 0
ret 1
end
if eq a 1
put meta 369 1
end
if ge a 2
put meta 368 sub a 1
end
put meta 370 b
prolog ins meta
if eq kind 1
ex2 ins meta
end
if eq kind 2
xchg ins meta
end
if eq kind 3
rms ins meta
end
if eq kind 4
rope ins meta
end
if eq kind 5
swiglu ins meta
end
if and ge kind 6 le kind 11
staged = and sub kind 6 1
divg = div sub kind 6 2
prime ins meta staged divg
end
if eq kind 12
diamond ins meta
end
if eq kind 13
loopbrk ins meta
end
if eq kind 14
nested ins meta
end
if eq kind 15
exitbar ins meta get meta 369
end
if eq kind 16
depth ins meta 16
end
if eq kind 17
depth ins meta 17
end
if eq kind 18
exitbar ins meta 2
end
if ge kind 19
refuse ins meta kind
end
if ne get meta 13 0
put meta 4 11
end
schedule ins meta
if ne get meta 4 0
ret 2
end
ret 0
end

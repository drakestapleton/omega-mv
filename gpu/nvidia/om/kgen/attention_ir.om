note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ABI kind: f32 bit0, general bit1, divergent bits2..3, mutant bits8..15, split+1 bits40..43.
note hd, bs and gqa are unsigned scalar fields; reserved kind bits and unsafe shifts are refused.
note Default physical register allocator only: meta[6] and meta[7] always zero on success.
fn atvalid kind ulong hd ulong bs ulong gqa ulong to ulong
if or gt bs 31 gt gqa 31
ret 1
end
gen = and shr kind 1 1
dv = and shr kind 2 3
mut = and shr kind 8 255
sp = shr kind 40
if ne and kind 7696581459727 kind
ret 1
end
if or gt sp 5 gt dv 2
ret 1
end
if eq gen 0
if or and ne hd 64 ne hd 128 gt mut 6
ret 1
end
else
if or eq hd 0 gt hd 256
ret 1
end
if gt mut 5
ret 1
end
if or ne dv 0 ne sp 0
ret 1
end
end
ret 0
end
fn atshape s edit ulong 256 kind ulong hd ulong bs ulong gqa ulong to void
put s 0 and kind 1
put s 1 hd
put s 2 bs
put s 3 gqa
put s 4 and shr kind 8 255
put s 5 and shr kind 2 3
put s 6 shr kind 40
put s 7 and shr kind 1 1
put s 8 ulong 1
put s 9 mul hd 4
put s 10 mul hd 4
put s 11 mul hd 8
put s 12 mul hd 12
put s 13 ulong 1
put s 14 ulong 0
put s 15 ulong 6
put s 17 ulong 0
put s 18 ulong 16
if ne get s 0 0
put s 18 ulong 8
end
put s 19 div get s 18 4
put s 20 rem hd 4
put s 21 div hd 4
put s 22 mul div add hd 31 32 32
put s 23 div get s 22 32
put s 24 ulong 0
put s 25 ulong 2
if ne get s 0 0
put s 25 ulong 4
end
put s 26 sub shl ulong 1 bs 1
if eq get s 7 0
if eq hd 128
put s 15 ulong 7
gc = gqa
if gt gc 2
gc = 2
end
put s 24 gc
put s 8 shl ulong 1 gc
end
put s 10 mul get s 8 get s 9
put s 11 mul 2 get s 10
put s 12 add get s 11 get s 9
if ne get s 6 0
put s 17 ulong 1
put s 14 sub get s 6 1
put s 13 shl ulong 1 get s 14
end
else
put s 10 mul get s 22 4
put s 11 mul get s 22 8
put s 12 mul get s 22 12
end
end
fn attention_ir kind ulong hd ulong bs ulong gqa ulong ins edit ulong 8192 meta edit ulong 512 to ulong
for i ulong 512
put meta i 0
end
if ne atvalid kind hd bs gqa 0
ret 1
end
s = new ulong 256 AN
atshape s kind hd bs gqa
if eq get s 7 0
attuned ins meta s
else
atgeneral ins meta s
end
ret atfinish meta
end
fn atfinish meta edit ulong 512 to ulong
if or ne get meta 4 0 or ne get meta 6 0 ne get meta 41 0
put meta 6 ulong 0
ret 2
end
put meta 6 ulong 0
put meta 7 ulong 0
ret 0
end

fn atcw st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end
fn atrg d ulong a ulong b ulong c ulong to ulong
ret or or d shl a 16 or shl b 32 shl c 48
end
fn atfld x ulong to ulong
if eq x AN
ret AA
end
ret x
end
fn atnv m edit ulong 512 w ulong to ulong
v = get m 1
if ge v 256
put m 4 ulong 1
ret AN
end
put m add 64 v w
put m 1 add v 1
ret v
end
fn atv s edit ulong 256 m edit ulong 512 slot ulong w ulong to void
put s slot atnv m w
end
fn atvs s edit ulong 256 m edit ulong 512 lo ulong hi ulong to void
for i ulong sub hi lo
atv s m add lo i 1
end
end
note ok = opcode | kind << 8 | uniform-source descriptor flag << 16.
note kinds match K_FIXED..K_BSYNC, 10 batch, 11 fixed-in-batch, 12 raw tail.
fn atsched m edit ulong 512 ok ulong im ulong fl ulong to ulong
k = and shr ok 8 255
pend = get m 3
ctrl = atcw 6 7 7 pend
if lt k 10
put m 32 ulong 0
for j ulong 8
put m add 33 j ulong 0
end
if eq k 1
ctrl = atcw 13 7 7 pend
end
put m 3 ulong 0
if eq k 2
ctrl = or atcw 4 0 7 pend 8192
put m 3 ulong 1
end
if eq k 3
ctrl = or atcw 4 2 7 pend 8192
put m 3 ulong 4
end
if eq k 4
ctrl = or atcw 4 7 1 pend 8192
put m 3 ulong 2
end
if or eq k 6 eq k 7
ctrl = atcw 5 7 7 pend
if ne and fl 2 0
put m 3 pend
end
end
if eq k 8
ctrl = or atcw 1 7 7 pend 8192
end
if eq k 9
ctrl = or atcw 5 7 7 pend 8192
end
else
if eq k 10
sb = shr ok 24
if or ge sb 8 ge get m add 33 sb 4
put m 4 ulong 3
ret 0
end
ctrl = or atcw 4 sb 1 and pend not get m 32 8192
mask = or shl ulong 1 sb 2
put m 32 or get m 32 mask
put m add 33 sb add get m add 33 sb 1
put m 3 or pend mask
else
if eq k 11
wt = and pend not get m 32
if ne get m 32 0
wt = or wt 2
end
ctrl = atcw 6 7 7 wt
else
ctrl = shr im 32
end
end
end
ret ctrl
end
fn atemit r edit ulong 8192 m edit ulong 512 ok ulong rg ulong im ulong fl ulong to void
n = get m 0
if ge n 1024
put m 4 ulong 2
ret
end
ctrl = atsched m ok im fl
if ne get m 4 0
ret
end
n = mul n 8
put r n and ok 255
put r add n 1 atfld and rg 65535
put r add n 2 atfld and shr rg 16 65535
put r add n 3 atfld and shr rg 32 65535
put r add n 4 atfld shr rg 48
put r add n 5 AA
if ne and ok 65536 0
put r add n 5 ulong 0
end
put r add n 6 or and im AL shl ctrl 32
put r add n 7 fl
put m 0 add get m 0 1
end
fn atfix r edit ulong 8192 m edit ulong 512 op ulong rg ulong im ulong to void
atemit r m op rg im 0
end
fn atmov r edit ulong 8192 m edit ulong 512 d ulong im ulong to void
atfix r m 2 atrg d AN AN AN im
end
fn atzero r edit ulong 8192 m edit ulong 512 d ulong to void
atfix r m 1 atrg d AN AN AN 0
end
fn atimm r edit ulong 8192 m edit ulong 512 op ulong d ulong im ulong to void
atemit r m or op 512 atrg d AN AN AN im 0
end
fn atmad r edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong c ulong to void
atfix r m 8 atrg d a AN c im
end
fn atmr r edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong c ulong to void
atfix r m 8 atrg d a b c 0
end
fn atwide r edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong c ulong to void
atfix r m 9 atrg d a AN c im
end
fn attwo r edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong b ulong to void
atfix r m op atrg d a b AN 0
end
fn atshift r edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong to void
atfix r m 17 atrg d a AN AN im
end
fn atand r edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong to void
atfix r m 18 atrg d a AN AN im
end
fn atload r edit ulong 8192 m edit ulong 512 d ulong a ulong to void
atemit r m 66059 atrg d a AN AN 0 0
end
fn atstore r edit ulong 8192 m edit ulong 512 a ulong b ulong to void
atemit r m 66572 atrg AN a b AN 0 0
end
fn atlds r edit ulong 8192 m edit ulong 512 d ulong a ulong to void
atemit r m 561 atrg d a AN AN 0 0
end
fn atsts r edit ulong 8192 m edit ulong 512 a ulong b ulong to void
atemit r m 1074 atrg AN a b AN 0 0
end
fn atbar r edit ulong 8192 m edit ulong 512 to void
if ne get m 41 0
put m 4 ulong 4
ret
end
atemit r m 1328 atrg AN AN AN AN 0 0
end
fn atshfl r edit ulong 8192 m edit ulong 512 d ulong a ulong off ulong to void
if ne get m 41 0
put m 4 ulong 4
ret
end
atemit r m 554 atrg d a AN AN off 0
end
fn atcmp r edit ulong 8192 m edit ulong 512 a ulong b ulong to void
atemit r m 284 atrg AN a b AN 0 0
end
fn atback r edit ulong 8192 m edit ulong 512 tgt ulong to void
atemit r m 1838 atrg AN AN AN AN and sub tgt get m 0 AL 6
end
fn atfwd r edit ulong 8192 m edit ulong 512 to ulong
n = get m 0
atemit r m 1838 atrg AN AN AN AN 0 2
ret n
end
fn atpatch r edit ulong 8192 m edit ulong 512 at ulong to void
n = add mul at 8 6
put r n or and get r n not AL and sub get m 0 at AL
end
fn atloop m edit ulong 512 to void
d = get m 6
if or ge d 8 ge get m 5 8
put m 4 ulong 5
ret
end
put m add 8 d get m 0
put m 6 add d 1
end
fn atclose m edit ulong 512 to void
d = get m 6
if or eq d 0 ge get m 5 8
put m 4 ulong 5
ret
end
d = sub d 1
put m 6 d
n = add 16 mul get m 5 2
put m n get m add 8 d
put m add n 1 sub get m 0 1
put m 5 add get m 5 1
end
fn attail r edit ulong 8192 m edit ulong 512 to void
atemit r m 1581 atrg AN AN AN AN 0 0
atemit r m 3118 atrg AN AN AN AN shl ulong 1032192 32 0
end
fn atbatch r edit ulong 8192 m edit ulong 512 op ulong rg ulong im ulong sb ulong to void
ok = or or op 2560 shl sb 24
if ne op 58
ok = or ok 65536
end
atemit r m ok rg im 0
end
fn atff r edit ulong 8192 m edit ulong 512 rg ulong as ulong bs ulong to void
atemit r m 33 rg 0 or shl as 24 shl bs 32
end
fn atws r edit ulong 8192 m edit ulong 512 rg ulong subr ulong batch ulong to void
ok = ulong 9
if ne batch 0
ok = or ok 2816
end
atemit r m ok rg 1 shl subr 24
end
fn atreg r edit ulong 8192 m edit ulong 512 to void
if ne get m 41 0
put m 4 ulong 6
ret
end
put m 41 ulong 1
put m 42 get m 0
atemit r m 2102 atrg AN AN AN AN 2 0
atcmp r m get m 44 get m 45
put m 43 get m 0
atemit r m 1838 atrg AN AN AN AN 1 2
end
fn atjoin r edit ulong 8192 m edit ulong 512 drop ulong to void
if ne get m 41 1
put m 4 ulong 6
ret
end
at = get m 0
op = ulong 55
if ne drop 0
op = 0
end
atemit r m or op 2304 atrg AN AN AN AN 0 0
atpatch r m get m 42
n = add mul get m 43 8 6
im = and get r n not AL
dist = and sub at get m 43 AL
put r n or im dist
put m 41 ulong 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Exact attention_api.c scheduler, record/meta ABI from omega_gpu_om_ir.h.
note m[6] loop depth scratch is cleared at successful return, never an allocator request.
note m[8..15] loop stack, m[32] batch, m[33..40] batch counts, m[41..43] one reconvergence region.
const AN ulong 65535
const AA ulong 18446744073709551615
const AL ulong 4294967295
const AI ulong 4286578688
note State slots 0..31 hold shape; 32..239 hold named virtual-register handles.
const A ulong 32
const B ulong 33
const C ulong 34
const TB ulong 35
const TID ulong 36
const H ulong 37
const SEQ ulong 38
const MAXB ulong 39

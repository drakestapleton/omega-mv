note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Register ids below follow V/V64 allocation order in the retained C oracle.
note Prologue: pa=0 pb=1 pc=2 tid=3 cta=4 descriptor=UR0.
fn alloc m edit ulong 512 n ulong to void
for j ulong n
v = nv m 1
end
end
fn ex2 ins edit ulong 8192 m edit ulong 512 to void
note n5 i6 off7 x8 y9, optional one10.
alloc m 5
put m 71 2
ldconst ins m 5 920
ai ins m 6 4 128 3
isgte ins m 6 5
exitp ins m
addr ins m 7 6 0
load ins m 8 7
if ne get m 369 0
alloc m 1
movi ins m 10 ulong bitcast uint 1.0f32
fx ins m FADD r4 8 8 10 NR 0
end
vr ins m EX2 r4 9 8 NR NR 0
addr ins m 7 6 2
store ins m 7 9
tail ins m
end
fn xchg ins edit ulong 8192 m edit ulong 512 to void
note i5 off6 x7 saddr8 paddr9 mask10 y11.
alloc m 7
put m 70 2
ai ins m 5 4 128 3
addr ins m 6 5 0
load ins m 7 6
ai ins m 8 3 4 NR
emit ins m ok STS 4 0 NR r4 NR 8 7 NR 0
bar ins m
if ne get m 369 0
vr ins m LDS r4 11 8 NR NR 0
else
movi ins m 10 127
fx ins m XOR r4 9 3 10 NR 0
ai ins m 9 9 4 NR
vr ins m LDS r4 11 9 NR NR 0
end
addr ins m 6 5 2
store ins m 6 11
tail ins m
end
fn rope ins edit ulong 8192 m edit ulong 512 to void
note hd5 half6 i0=7 i1=8 off0=9 off1=10 q0=11 q1=12 c13 s14 t0=15 t1=16 o0=17 o1=18.
alloc m 14
put m 73 2
put m 74 2
ldconst ins m 5 920
ldconst ins m 6 924
ar ins m 7 4 5 3
add3 ins m 8 7 6
addr ins m 9 7 0
load ins m 11 9
addr ins m 10 8 0
load ins m 12 10
addr ins m 9 7 1
load ins m 13 9
addr ins m 10 8 1
load ins m 14 10
fx ins m FMUL r4 15 11 13 NR 0
fx ins m FMUL r4 16 12 14 NR 0
op = FSUB
if ne get m 369 0
op = FADD
end
fx ins m op r4 17 15 16 NR 0
fx ins m FMUL r4 15 11 14 NR 0
fx ins m FMUL r4 16 12 13 NR 0
fx ins m FADD r4 18 15 16 NR 0
addr ins m 9 7 2
store ins m 9 17
addr ins m 10 8 2
store ins m 10 18
tail ins m
end
fn swiglu ins edit ulong 8192 m edit ulong 512 to void
note n5 i6 off7 g8 u9 k10 t11 ex12 d13 r14 one15 o16.
alloc m 12
put m 71 2
ldconst ins m 5 920
ai ins m 6 4 128 3
isgte ins m 6 5
exitp ins m
addr ins m 7 6 0
load ins m 8 7
addr ins m 7 6 1
load ins m 9 7
if ne get m 369 0
movi ins m 10 ulong bitcast uint 1.4426950408889634f32
else
movi ins m 10 ulong bitcast uint -1.4426950408889634f32
end
movi ins m 15 ulong bitcast uint 1.0f32
fx ins m FMUL r4 11 8 10 NR 0
vr ins m EX2 r4 12 11 NR NR 0
fx ins m FADD r4 13 12 15 NR 0
vr ins m RCP r4 14 13 NR NR 0
fx ins m FMUL r4 16 8 14 NR 0
fx ins m FMUL r4 16 16 9 NR 0
addr ins m 7 6 2
store ins m 7 16
tail ins m
end
fn rms ins edit ulong 8192 m edit ulong 512 to void
note nk5 invd6 eps7 dim8 rowbase9 idx10 col11 k12 acc13 cT14 c1=15 off16 x17 t18.
alloc m 14
put m 80 2
ldconst ins m 5 920
ldconst ins m 6 924
ldconst ins m 7 928
ldconst ins m 8 932
ar ins m 9 4 8 NR
add3 ins m 10 9 3
zero ins m 13
zero ins m 12
movi ins m 14 128
movi ins m 15 1
lb m
l1 = get m 0
addr ins m 16 10 0
load ins m 17 16
fx ins m FFMA r4 13 17 17 13 0
add3 ins m 10 10 14
add3 ins m 12 12 15
isgte ins m 12 5
branch ins m l1 6
lend m
nstep = ulong 5
if ne get m 369 0
nstep = ulong 4
end
for s ulong nstep
shfl ins m 18 13 shr ulong 16 s
fx ins m FADD r4 13 13 18 NR 0
end
note saddr19, a0..3=20..23 s0..3=24..27 sum28.
alloc m 10
ai ins m 19 3 4 NR
emit ins m ok STS 4 0 NR r4 NR 19 13 NR 0
bar ins m
zero ins m 20
movi ins m 21 128
movi ins m 22 256
movi ins m 23 384
vr ins m LDS r4 24 20 NR NR 0
vr ins m LDS r4 25 21 NR NR 0
vr ins m LDS r4 26 22 NR NR 0
vr ins m LDS r4 27 23 NR NR 0
fx ins m FADD r4 28 24 25 NR 0
fx ins m FADD r4 28 28 26 NR 0
fx ins m FADD r4 28 28 27 NR 0
note v29 y30 u31 cmh32 c15=33 offw34 offc35 w36 o37.
alloc m 5
fx ins m FMUL r4 29 28 6 NR 0
fx ins m FADD r4 29 29 7 NR 0
vr ins m RSQ r4 30 29 NR NR 0
movi ins m 32 ulong bitcast uint -0.5f32
movi ins m 33 ulong bitcast uint 1.5f32
fx ins m FMUL r4 31 29 30 NR 0
fx ins m FMUL r4 31 31 30 NR 0
fx ins m FFMA r4 31 31 32 33 0
fx ins m FMUL r4 30 30 31 NR 0
alloc m 4
put m 98 2
put m 99 2
add3 ins m 10 9 3
ai ins m 11 3 1 NR
zero ins m 12
lb m
l2 = get m 0
addr ins m 16 10 0
load ins m 17 16
addr ins m 34 11 1
load ins m 36 34
fx ins m FMUL r4 37 17 30 NR 0
fx ins m FMUL r4 37 37 36 NR 0
addr ins m 35 10 2
store ins m 35 37
add3 ins m 10 10 14
add3 ins m 11 11 14
add3 ins m 12 12 15
isgte ins m 12 5
branch ins m l2 6
lend m
tail ins m
end

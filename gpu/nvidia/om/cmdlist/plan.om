note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
const CLBAD ulong 18446744073709551615
note Descriptor: count then sixteen VA/length/flags triples; count17 means unknown.
fn clvalid p view ulong 200704 i ulong to ulong
b = mul i 49
n = get p b
if gt n 17
ret 0
end
if eq n 17
ret 1
end
for j ulong n
k = add add b 1 mul j 3
if eq get p add k 1 0
ret 0
end
if eq get p add k 2 0
ret 0
end
if gt get p add k 2 3
ret 0
end
if gt get p k sub CLBAD get p add k 1
ret 0
end
end
ret 1
end

fn clrange p view ulong 200704 a ulong b ulong to ulong
if ge get p a add get p b get p add b 1
ret 0
end
if ge get p b add get p a get p add a 1
ret 0
end
x = get p add a 2
y = get p add b 2
h = ulong 0
if and ne and y 2 0 ne and x 1 0
h = or h 1
end
if and ne and y 1 0 ne and x 2 0
h = or h 2
end
if and ne and y 2 0 ne and x 2 0
h = or h 4
end
ret h
end

fn clrow p view ulong 200704 a ulong y ulong to ulong
h = ulong 0
for j ulong get p y
b = add add y 1 mul j 3
h = or h clrange p a b
end
ret h
end

fn clpair p view ulong 200704 x ulong y ulong to ulong
if or eq get p x 17 eq get p y 17
ret 7
end
h = ulong 0
for i ulong get p x
a = add add x 1 mul i 3
h = or h clrow p a y
end
ret h
end

fn clhazards p view ulong 200704 i ulong start ulong to ulong
h = ulong 0
for j ulong sub i start
h = or h clpair p mul i 49 mul add start j 49
end
if eq i 0
h = ulong 8
end
ret h
end

fn clstep p view ulong 200704 barriers edit ulong 4096 o edit ulong 16 i ulong mode ulong stamps ulong to ulong
h = clhazards p i get o 3
put barriers i h
if ne h 0
put o 1 add get o 1 1
put o 3 i
put o 0 add get o 0 4
end
if eq mode 0
put o 0 add get o 0 4
else
put o 0 add get o 0 198
end
if ne stamps 0
put o 0 add get o 0 6
end
ret 0
end

note Whole-program planning: count capacity mode stamps ring_words prefix_words.
note Output: exact words, WFI methods (excluding tail release), submissions, epoch start.
note RAW1 WAR2 WAW4 admission8. Compare ALL outstanding launches since the last drain.
note No splitting: ring overflow is refused before the shell can submit anything.
fn cmdlist_plan a view ulong 16 p view ulong 200704 barriers edit ulong 4096 o edit ulong 16 to ulong
if gt get a 0 4096
ret 1
end
if gt get a 0 get a 1
ret 1
end
if gt get a 1 4096
ret 1
end
if or gt get a 2 1 gt get a 3 1
ret 1
end
for i ulong 4
if ne get a add 6 i 0
ret 1
end
end
for i ulong get a 0
if eq clvalid p i 0
ret 2
end
end
for i ulong 16
put o i 0
end
if eq get a 0 0
ret 0
end
put o 0 35
if ne get a 3 0
put o 0 add get o 0 8
put o 1 1
end
for i ulong get a 0
r = clstep p barriers o i get a 2 get a 3
end
if gt get a 5 get a 4
ret 3
end
if gt get o 0 sub get a 4 get a 5
ret 3
end
put o 2 1
ret 0
end

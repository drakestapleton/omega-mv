const CLMASK ulong 4294967295
const CLBAD ulong 18446744073709551615
note Legacy list sizing and inline mode patch are also seeded policy.
fn cmdlist_layout op ulong a view ulong 16 o edit ulong 16 to ulong
if eq op 0
if or eq get a 0 0 gt get a 0 4096
ret CLBAD
end
put o 0 mul get a 0 1024
put o 1 mul get a 0 16
put o 2 mul add get a 0 1 16
ret 0
end
if eq op 1
if lt get a 0 43
ret 0
end
avail = sub get a 0 43
if gt get a 1 avail
ret 0
end
per = ulong 8
if ne get a 2 0
per = ulong 202
end
if ne get a 3 0
per = add per 6
end
if ne get a 4 0
per = add per 6
end
ret div sub avail get a 1 per
end
if eq op 2
put o 0 0
put o 1 0
if ne get a 0 0
put o 0 1638400
put o 1 and shr add get a 1 512 8 CLMASK
end
ret 0
end
if eq op 3
if or ge get a 1 get a 0 eq get a 2 0
ret CLBAD
end
if gt get a 0 4096
ret CLBAD
end
if lt get a 2 sub get a 0 get a 1
ret add get a 1 get a 2
end
ret get a 0
end
ret CLBAD
end

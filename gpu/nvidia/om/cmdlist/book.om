note Command-list lifetime decisions. Inputs follow clbook in the C shell:
note op 0 generation,recoveries,epoch,current epoch; op 1 latch,recoveries.
const WMASK ulong 4294967295
const REFUSED ulong 18446744073709551615

fn book op ulong a view ulong 16 o edit ulong 4 to ulong
if eq op 0
if eq get a 0 get a 1
if eq get a 2 get a 3
ret 0
end
end
ret 1
end
if eq op 1
if eq get a 0 and add get a 1 1 WMASK
ret 1
end
ret 0
end
ret REFUSED
end

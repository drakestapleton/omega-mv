note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Command-list bookkeeping decisions from src/omega_gpu_cmdlist.c. Pure
note computation: stale, wait_for argument and one-list checks, the wait
note semaphore address, and the mark-independent guard. book is the only export.
const WMASK ulong 4294967295
const REFUSED ulong 18446744073709551615

fn stale gen ulong epoch ulong recov ulong sepoch ulong to ulong
if eq gen recov
if eq epoch sepoch
ret 0
end
end
ret 1
end

fn waitarg hascl ulong hasoth ulong same ulong index ulong on ulong to ulong
if eq hascl 0
ret 1
end
if eq hasoth 0
ret 1
end
if ne same 0
ret 1
end
if ge and index WMASK and on WMASK
ret 1
end
ret 0
end

fn waitone haswo ulong sameo ulong to ulong
if eq haswo 0
ret 0
end
if ne sameo 0
ret 0
end
ret 1
end

fn waitva semva ulong index ulong to ulong
ret add semva mul index 16
end

fn indep hascl ulong n ulong to ulong
if eq hascl 0
ret 1
end
if eq n 0
ret 1
end
ret 0
end

fn book op ulong a view ulong 16 o edit ulong 4 to ulong
if eq op 0
ret stale get a 0 get a 1 get a 2 get a 3
end
if eq op 1
ret waitarg get a 0 get a 1 get a 2 get a 3 get a 4
end
if eq op 2
ret waitone get a 0 get a 1
end
if eq op 3
ret waitva get a 0 get a 1
end
if eq op 4
ret indep get a 0 get a 1
end
ret REFUSED
end

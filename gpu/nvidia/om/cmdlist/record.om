fn clrecord_qmd a view ulong 16 o edit ulong 512 to ulong
bv = add get a 10 mul get a 1 1024
qv = add get a 11 mul get a 1 1024
ty = get o 217
put o 288 and shr get a 7 4 CLMASK
put o 289 or and shr get a 7 36 2097151 shl ulong 10 21
put o 290 or and get a 3 65535 shl and ty 65535 16
gp = ulong 64
if gt get a 8 64
gp = mul div and add and get a 8 CLMASK 7 CLMASK 8 8
if eq gp 0
gp = ulong 16
end
end
put o 291 or 131073 shl and gp 511 8
sm = ulong 8
if ne get a 9 0
sm = div add get a 9 127 128
end
put o 292 or and 78923784 xor CLMASK 2047 sm
put o 295 get a 5
put o 296 get a 6
put o 297 1
put o 298 and shr bv 6 CLMASK
put o 299 or and shr bv 38 524287 shl ulong 64 19
put o 300 and shr get a 13 6 CLMASK

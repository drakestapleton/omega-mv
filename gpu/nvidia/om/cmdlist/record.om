put o 308 and shr add bv 768 6 CLMASK
put o 309 or and shr add bv 768 38 524287 shl ulong 16 19
put o 312 and shr get a 13 6 CLMASK
put o 313 or and shr get a 13 38 524287 shl ulong 4096 19
put o 314 271581201
put o 315 and shr get a 7 8 CLMASK
put o 388 8388610
put o 394 2293760
put o 396 and shr qv 8 CLMASK
put o 398 5243392
put o 418 65537
put o 419 2049
ret 0
end

fn cmdlist_record a view ulong 16 args view ulong 32 o edit ulong 512 to ulong
r = clrecord_bank a args o
if ne r 0
ret r
end
ret clrecord_qmd a o
end


note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Host policy only. Unsigned products preserve the C shell's modulo-64 arithmetic.
note op 0 min; 1 row index; 2 row stride; 3 packed rows; 4 contiguous conversion;
note 5 conversion element count; 6 conversion row byte offset.
note Index: a transpose, b leading dimension, c row, d column.
fn gemm_ex_policy op ulong a ulong b ulong c ulong d ulong to ulong
if eq op 0
if lt a b
ret a
end
ret b
end
if eq op 1
if ne a 0
ret add mul d b c
end
ret add mul c b d
end
if eq op 2
if ne a 0
ret b
end
ret 1
end
if eq op 3
w = mul b c
if gt d c
w = mul b d
end
if and ne a 5 ne a 6
if le w 65536
ret div 65536 w
end
end
ret 1
end
if eq op 4
if or eq a 1 eq b mul c d
ret 1
end
ret 0
end
if eq op 5
ret mul a b
end
if eq op 6
ret mul mul a b c
end
ret 0
end

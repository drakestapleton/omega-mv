note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test-only probe over om/gemmex/num.om (concatenate num.om first); exported as omega_gx_probe.
fn gx_probe op ulong a ulong to ulong
u = uint and a 4294967295
if eq op 0
ret ulong bitcast uint gx_h2f u
end
if eq op 1
ret ulong bitcast uint gx_e4m3 u
end
if eq op 2
ret ulong gx_f2bf u
end
if eq op 3
ret ulong gx_f2h u
end
if eq op 4
ret gx_split u
end
if eq op 5
ret ulong bitcast uint gx_d2fo bitcast f64 a
end
if gx_bad shr a 32 u
ret 1
end
ret 0
end

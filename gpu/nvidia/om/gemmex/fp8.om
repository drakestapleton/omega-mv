note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The dequantization of one weight-row run of omega_gpu_gemm_ex_fp8_block_rows (CUDApp#144,
note src/omega_gpu_gemm_ex.c l.467-476): d[c] = f32(((f64 e4m3 w[c]) * (f64 sr[cb])) * scale_mul), one rounding,
note cb = (c0 + c) / block ((cb + 1) % kb under mutant 5).
note q: 0 cn (<= 16383), 1 c0, 2 block, 3 kb, 4 scale_mul f64 bits, 5 mutant, 6 sbase = c0 / block, 7 sr[0] bits;
note s[i] = sr[sbase + i] as binary32 bits and d[c] binary32 (the C shell copies min(16384, kb - sbase) entries).
note Gives 0, or 1 for a block outside s. The block and its scale are found once per block, not per element.

note the scale bits of block cb, or 1 << 32 when the block lies outside s
fn gx_fsv q view ulong 8 s view uint 16384 cb ulong to ulong
sb = get q 6
if eq get q 5 5
cb = rem add cb 1 get q 3
end
if ge cb sb
if ge sub cb sb 16384
ret shl ulong 1 32
end
ret ulong get s sub cb sb
end
if ne cb 0
ret shl ulong 1 32
end
ret get q 7
end

fn gemm_ex_fp8 q view ulong 8 w view uchar 65536 s view uint 16384 d edit f32 16384 to ulong
if eq get q 0 0
ret 0
end
bl = get q 2
cb = div get q 1 bl
r = rem get q 1 bl
sv = gx_fsv view q view s cb
m = bitcast f64 get q 4
for c ulong get q 0
if gt sv 4294967295
ret 1
end
x = f64 gx_e4m3 uint get w c
x = mul x f64 bitcast f32 uint sv
x = mul x m
put d c f32 x
r = add r 1
if eq r bl
r = ulong 0
cb = add cb 1
sv = gx_fsv view q view s cb
end
end
ret 0
end

note Extracted fixture arithmetic; unsigned operations preserve C modulo semantics.
note Clock inputs are the uint64_t representations of timespec fields, including negative and overflow edges.
note WolframLanguageEvaluator: {Quotient[2^64-1,10^9],Quotient[2^64-1,1000],Mod[2^64-1,10^9]} -> {18446744073,18446744073709551,709551615}.
note Constants below are copied from the source fixture or evaluated in the lane evidence.
fn fr_calc op uint a ulong b ulong c ulong to ulong
if eq op 0
ret add mul a 1000000000 b
end
if eq op 1
ret add mul a 1000 div b 1000000
end
if eq op 2
ret add a b
end
if eq op 3
ret sub a b
end
if eq op 4
if gt a b
ret a
end
ret b
end
if eq op 5
ret and a 255
end
if eq op 6
ret and xor a 255 255
end
if eq op 7
ix = rem a 8
if eq ix 0
ret 4096
end
if eq ix 1
ret 65536
end
if eq ix 2
ret 1048576
end
if eq ix 3
ret 4194304
end
if eq ix 4
ret 16777216
end
if eq ix 5
ret 33554432
end
ret 67108864
end
if eq op 8
ret bv eq rem a 2000 0
end
if eq op 9
if ne a 0
ret and add mul b 2 3 4294967295
end
ret 2
end
if eq op 10
ret and mul sub a 1 128 4294967295
end
if eq op 11
ret mul a 4
end
if eq op 12
ret sub a 1
end
if eq op 13
ret add add a b c
end
if eq op 14
if ne a 0
ret 1
end
ret 0
end
if eq op 15
ret bv eq a b
end
if eq op 16
ret bv and ne a 0 ne b 0
end
if eq op 17
ret div a 1000000
end
if eq op 18
ret and sub a 1 4294967295
end
ret 18446744073709551615
end

fn fr_flush ix ulong va ulong to ulong
if eq ix 0
ret 537133066
end
if eq ix 4
ret 2147483648
end
if eq ix 5
ret 537198615
end
if eq ix 6
ret and add va 16 4294967295
end
if eq ix 7
ret shr add va 16 32
end
if eq ix 8
ret 1179010630
end
if eq ix 10
ret 1048577
end
ret 0
end

fn fr_scale val ulong kind uint to f64
if eq kind 0
ret div f64 val 1073741824.0
end
ret div f64 val 1048576.0
end

note Bounded NUL-terminated text matching. Input transport pads shorter source buffers to 512 bytes.
fn fr_text buf view uchar 512 pat view uchar 32 n ulong to ulong
if or eq n 0 gt n 32
ret 0
end
for i ulong 512
if eq get buf i 0
ret 0
end
if le n sub ulong 512 i
same = true
for j ulong n
if ne get buf add i j get pat j
same = false
end
end
if same
ret 1
end
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note GPU engine, wait, reserve, cache, serving and gate decisions.
note Host clocks, syscalls and MMIO stay in the C shell. This unit owns the branch.
note Wait defaults: src/omega_gpu_wait.h OMEGA_GPU_WAIT_DEFAULT_TOTAL_MS 600000 and PROGRESS_MS 5000.
note Signed sequence compare masks to 4294967295 then tests the high bit, matching int32_t subtraction.
note Reserve saturation: mib above 17592186044415 becomes 2^64-1 (omega_gpu_mem_reserve.c mib_bytes).
note Cache want is (bytes + 4095) masked with 18446744073709547520, the 4 KiB page mask.
note Flag check masks with 18446744073709551614, every bit except OMEGA_GPU_ENGINE_FLAG_NO_C3.
note Requalify payload 381747182 is 0x16c0ffee from m16/m16_requalify.c.
note Submit timeouts 5000 are the marker limit cited in src/omega_blackwell_submit.c.
note WolframLanguageEvaluator: BitAnd[BitNot[1], 2^64-1] -> 18446744073709551614.
note WolframLanguageEvaluator: BitAnd[BitNot[4095], 2^64-1] -> 18446744073709547520.
note WolframLanguageEvaluator: BitShiftRight[2^64-1, 20] -> 17592186044415.
note WolframLanguageEvaluator: 600000*1000000 -> 600000000000. 5000*1000000 -> 5000000000.
note WolframLanguageEvaluator: FromDigits["16c0ffee", 16] -> 381747182.
note WolframLanguageEvaluator: BitShiftRight[2^64-1, 10] -> 18014398509481983.
note WolframLanguageEvaluator: BitOr[BitShiftLeft[2, 28], BitShiftLeft[1, 16], BitShiftLeft[1, 13], BitShiftRight[0, 2]] -> 536944640.
note WolframLanguageEvaluator: BitOr[BitShiftLeft[2, 28], BitShiftLeft[5, 16], BitShiftLeft[0, 13], BitShiftRight[92, 2]] -> 537198615.
note WolframLanguageEvaluator: BitOr[1, BitShiftLeft[1, 20]] -> 1048577.

fn seqge a ulong b ulong to ulong
d = and sub a b 4294967295
h = and shr d 31 1
if eq h 0
ret 1
else
ret 0
end
end

fn winit m view ulong 24 w edit ulong 16 to void
tms = get m 1
if eq tms 0
tms = 600000
end
pms = get m 2
if eq pms 0
pms = 5000
end
tot = mul tms 1000000
stl = mul pms 1000000
st = get m 3
put w 0 tot
put w 1 stl
put w 2 add st tot
put w 3 add st stl
if eq get m 4 0
put w 4 1
else
put w 4 0
end
if eq get m 5 0
put w 5 1
else
put w 5 0
end
end

fn wenter m view ulong 24 w edit ulong 16 to void
if lt get m 1 get m 2
put w 0 1
else
put w 0 0
put w 6 sub get m 1 get m 3
end
end

fn chng m view ulong 24 to ulong
if ne get m 3 get m 17
ret 1
end
if ne get m 4 get m 18
ret 1
end
if ne get m 21 get m 19
ret 1
end
if ne get m 22 get m 20
ret 1
end
ret 0
end

fn wmatch k ulong ob ulong ex ulong to ulong
if eq k 1
if eq ob ex
ret 1
else
ret 0
end
else
ret seqge ob ex
end
end

fn wfail w edit ulong 16 r ulong el ulong to void
put w 0 r
put w 1 2
put w 6 el
end

fn wprog m view ulong 24 w edit ulong 16 to void
ch = chng m
nr = and shr get m 23 1 1
ex = and get m 23 1
put w 7 ch
if eq ch 1
if eq get m 16 0
if eq nr 0
put w 2 add get m 10 get m 13
else
put w 2 get m 12
end
if eq ex 1
put w 3 add get m 10 get m 15
else
put w 3 get m 14
end
put w 4 1
put w 5 get m 10
else
put w 2 get m 12
put w 3 get m 14
put w 4 0
put w 5 0
end
else
put w 2 get m 12
put w 3 get m 14
put w 4 0
put w 5 0
end
end

fn wrest m view ulong 24 w edit ulong 16 to void
now = get m 10
put w 6 sub now get m 11
if ge now get m 12
put w 0 2
put w 1 2
else
put w 0 5
put w 1 0
end
end

fn wpoll m view ulong 24 w edit ulong 16 to void
el = sub get m 10 get m 11
if eq get m 9 1
wfail w 4 el
ret
end
ok = wmatch get m 1 get m 3 get m 2
if eq get m 5 1
if ne get m 4 get m 6
ok = 0
end
end
if eq ok 1
put w 0 0
put w 1 1
put w 6 el
put w 9 1
wprog m w
ret
end
if eq get m 7 1
if eq get m 8 0
wfail w 3 el
wprog m w
ret
end
end
wprog m w
wrest m w
end

fn joblen n ulong want ulong pres ulong to ulong
if eq pres 0
ret 0
end
if ne n want
ret 0
end
ret 1
end

fn jobv m view ulong 24 w edit ulong 16 to void
if eq get m 1 0
put w 0 0
put w 1 1
ret
end
if eq get m 2 0
put w 0 0
put w 1 1
ret
end
if ne get m 3 0
put w 0 0
put w 1 2
ret
end
if eq get m 4 0
put w 0 0
put w 1 3
ret
end
by = mul get m 4 4
if eq joblen get m 6 by get m 5 0
put w 0 0
put w 1 4
ret
end
if eq joblen get m 8 by get m 7 0
put w 0 0
put w 1 5
ret
end
if eq joblen get m 10 by get m 9 0
put w 0 0
put w 1 6
ret
end
if ne and get m 11 3 0
put w 0 0
put w 1 7
ret
end
if eq joblen get m 13 get m 4 get m 12 0
put w 0 0
put w 1 8
ret
end
if ne and get m 14 18446744073709551614 0
put w 0 0
put w 1 9
ret
end
if eq get m 15 0
put w 0 0
put w 1 10
ret
end
if eq get m 16 0
put w 0 0
put w 1 11
ret
end
if eq get m 17 0
put w 0 0
put w 1 12
ret
end
if eq and get m 14 1 0
if eq get m 18 0
put w 0 0
put w 1 13
ret
end
end
put w 0 1
put w 1 0
end

fn phfail w edit ulong 16 act ulong f ulong s ulong to void
put w 0 act
put w 1 f
put w 2 s
put w 3 255
put w 4 0
put w 5 0
put w 6 0
put w 7 0
end

fn phok w edit ulong 16 st ulong to void
put w 0 0
put w 1 0
put w 2 0
put w 3 st
put w 4 0
put w 5 0
put w 6 0
put w 7 0
end

fn phrc m view ulong 24 w edit ulong 16 f ulong s ulong act ulong st ulong to void
if ne get m 2 0
phfail w act f s
else
phok w st
end
end

fn phunc m view ulong 24 w edit ulong 16 f ulong s ulong wk ulong to void
if ne get m 2 0
put w 0 3
put w 1 f
put w 2 s
put w 3 255
put w 4 wk
put w 5 1
put w 6 1
put w 7 0
else
phok w 255
end
end

fn phi m view ulong 24 w edit ulong 16 to void
p = get m 1
if eq p 0
if eq get m 4 1
phfail w 1 13 3
else
phok w 255
end
ret
end
if eq p 1
if eq get m 4 0
phfail w 1 10 1
else
if eq get m 5 0
phfail w 1 10 1
else
phok w 255
end
end
ret
end
if eq p 2
phfail w 1 11 4
ret
end
if eq p 3
if eq get m 4 0
phfail w 1 11 2
else
phok w 255
end
ret
end
if eq p 4
if eq get m 4 0
phfail w 1 11 20
else
phok w 255
end
ret
end
if eq p 5
phrc m w 1 5 2 255
ret
end
if eq p 6
phrc m w 2 6 2 255
ret
end
if eq p 7
phrc m w 3 7 2 255
ret
end
if eq p 8
phrc m w 4 8 2 255
ret
end
if eq p 9
phrc m w 4 9 2 255
ret
end
phok w 255
end

fn phj m view ulong 24 w edit ulong 16 to void
p = get m 1
if eq p 10
phrc m w 4 10 2 1
ret
end
if eq p 11
phrc m w 5 11 2 2
ret
end
if eq p 12
phunc m w 6 12 1
ret
end
if eq p 13
if eq and get m 3 1 1
put w 0 4
ret
end
if eq get m 5 0
put w 0 0
ret
end
phunc m w 6 13 3
ret
end
if eq p 14
if ne get m 2 0
phunc m w 7 14 2
else
phok w 3
end
ret
end
if eq p 15
phrc m w 8 15 2 255
ret
end
if eq p 16
phrc m w 8 16 2 4
ret
end
if eq p 17
if ne get m 4 0
phfail w 2 9 17
else
phok w 5
end
ret
end
if eq p 18
if eq get m 2 0
phok w 6
else
phok w 255
end
ret
end
phok w 255
end

fn resv m view ulong 24 w edit ulong 16 to void
if eq get m 4 0
put w 0 0
ret
end
if eq get m 3 0
put w 0 0
ret
end
kb = get m 2
av = ulong 0
if gt kb 18014398509481983
av = ulong 18446744073709551615
else
av = mul kb 1024
end
rm = get m 3
rs = ulong 0
if gt rm 17592186044415
rs = ulong 18446744073709551615
else
rs = shl rm 20
end
put w 1 av
put w 2 rs
by = get m 1
if gt by av
put w 0 11
ret
end
left = sub av by
if lt left rs
put w 0 11
else
put w 0 0
end
end

fn cache m view ulong 24 w edit ulong 16 to void
if eq get m 2 0
put w 0 1
ret
end
if eq get m 1 0
put w 0 1
ret
end
put w 0 0
put w 1 and add get m 1 4095 18446744073709547520
end

fn serve m view ulong 24 w edit ulong 16 to void
if eq get m 1 0
put w 0 1
ret
end
sq = get m 2
if eq sq 0
sq = 1
end
put w 0 0
put w 1 sq
if gt get m 3 1
put w 2 1
else
put w 2 0
end
nr = get m 5
if eq nr 0
nr = get m 4
end
put w 3 nr
end

fn pois m view ulong 24 w edit ulong 16 to void

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note GPU engine, wait, reserve, cache, serving and gate decisions.
note Host clocks, syscalls and MMIO stay in the C shell. This unit owns the branch.
note Wait defaults: src/omega_gpu_wait.h OMEGA_GPU_WAIT_DEFAULT_TOTAL_MS 600000 and PROGRESS_MS 5000.
note Signed sequence compare masks to 4294967295 then tests the high bit, matching int32_t subtraction.
note Reserve saturation: mib above 17592186044415 becomes 2^64-1 (omega_gpu_mem_reserve.c mib_bytes).
note Cache want is (bytes + 4095) masked with 18446744073709547520, the 4 KiB page mask.
note Flag check masks with 18446744073709551614, every bit except OMEGA_GPU_ENGINE_FLAG_NO_C3.
note Requalify payload 381747182 is 0x16c0ffee from m16/m16_requalify.c.
note Submit timeouts 5000 are the marker limit cited in src/omega_blackwell_submit.c.
note WolframLanguageEvaluator: BitAnd[BitNot[1], 2^64-1] -> 18446744073709551614.
note WolframLanguageEvaluator: BitAnd[BitNot[4095], 2^64-1] -> 18446744073709547520.
note WolframLanguageEvaluator: BitShiftRight[2^64-1, 20] -> 17592186044415.
note WolframLanguageEvaluator: 600000*1000000 -> 600000000000. 5000*1000000 -> 5000000000.
note WolframLanguageEvaluator: FromDigits["16c0ffee", 16] -> 381747182.
note WolframLanguageEvaluator: BitShiftRight[2^64-1, 10] -> 18014398509481983.
note WolframLanguageEvaluator: BitOr[BitShiftLeft[2, 28], BitShiftLeft[1, 16], BitShiftLeft[1, 13], BitShiftRight[0, 2]] -> 536944640.
note WolframLanguageEvaluator: {256*2^30, 2*2^30, 2^32-1-63, FromDigits["81810000",16], 2^3+2^5} -> {274877906944, 2147483648, 4294967232, 2172715008, 40}.
note 274877906944 and 2147483648 are the lifecycle churn floor and high-water cap; 4294967232 is UINT32_MAX - 63;
note 2172715008 is QMD1 word 19 0x81810000; 40 is GPU_WRITE | HOST_POLLED.
note WolframLanguageEvaluator: BitOr[BitShiftLeft[2, 28], BitShiftLeft[5, 16], BitShiftLeft[0, 13], BitShiftRight[92, 2]] -> 537198615.
note WolframLanguageEvaluator: BitOr[1, BitShiftLeft[1, 20]] -> 1048577.

fn seqge a ulong b ulong to ulong
d = and sub a b 4294967295
h = and shr d 31 1
if eq h 0
ret 1
else
ret 0
end
end

fn winit m view ulong 24 w edit ulong 16 to void
tms = get m 1
if eq tms 0
tms = 600000
end
pms = get m 2
if eq pms 0
pms = 5000
end
tot = mul tms 1000000
stl = mul pms 1000000
st = get m 3
put w 0 tot
put w 1 stl
put w 2 add st tot
put w 3 add st stl
if eq get m 4 0
put w 4 1
else
put w 4 0
end
if eq get m 5 0
put w 5 1
else
put w 5 0
end
end

fn wenter m view ulong 24 w edit ulong 16 to void
if lt get m 1 get m 2
put w 0 1
else
put w 0 0
put w 6 sub get m 1 get m 3
end
end

fn chng m view ulong 24 to ulong
if ne get m 3 get m 17
ret 1
end
if ne get m 4 get m 18
ret 1
end
if ne get m 21 get m 19
ret 1
end
if ne get m 22 get m 20
ret 1
end
ret 0
end

fn wmatch k ulong ob ulong ex ulong to ulong
if eq k 1
if eq ob ex
ret 1
else
ret 0
end
else
ret seqge ob ex
end
end

fn wfail w edit ulong 16 r ulong el ulong to void
put w 0 r
put w 1 2
put w 6 el
end

fn wprog m view ulong 24 w edit ulong 16 to void
ch = chng m
nr = and shr get m 23 1 1
ex = and get m 23 1
put w 7 ch
if eq ch 1
if eq get m 16 0
if eq nr 0
put w 2 add get m 10 get m 13
else
put w 2 get m 12
end
if eq ex 1
put w 3 add get m 10 get m 15
else
put w 3 get m 14
end
put w 4 1
put w 5 get m 10
else
put w 2 get m 12
put w 3 get m 14
put w 4 0
put w 5 0
end
else
put w 2 get m 12
put w 3 get m 14
put w 4 0
put w 5 0
end
end

fn wrest m view ulong 24 w edit ulong 16 to void
now = get m 10
put w 6 sub now get m 11
note the stall deadline this poll left behind (wprog put w 2), as the C oracle checks it after a reset
if ge now get w 2
put w 0 2
put w 1 2
else
put w 0 5
put w 1 0
end
end

fn wpoll m view ulong 24 w edit ulong 16 to void
el = sub get m 10 get m 11
if eq get m 9 1
wfail w 4 el
ret
end
ok = wmatch get m 1 get m 3 get m 2
if eq get m 5 1
if ne get m 4 get m 6
ok = 0
end
end
if eq ok 1
put w 0 0
put w 1 1
put w 6 el
put w 9 1
wprog m w
ret
end
if eq get m 7 1
if eq get m 8 0
wfail w 3 el
wprog m w
ret
end
end
wprog m w
wrest m w
end


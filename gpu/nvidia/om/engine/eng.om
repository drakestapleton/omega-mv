fn nvrmhd subc ulong mthd ulong count ulong to ulong
a = shl ulong 2 28
b = shl count 16
c = shl subc 13
d = shr mthd 2
e = or a b
f = or e c
ret or f d
end

fn m16rel m view ulong 24 w edit ulong 16 to void
if eq get m 1 0
put w 0 0
ret
end
put w 0 8
put w 1 nvrmhd 1 0 1
put w 2 get m 4
put w 3 nvrmhd 0 92 5
put w 4 and get m 2 4294967295
put w 5 shr get m 2 32
put w 6 get m 3
put w 7 0
put w 8 1048577
end

fn eng m view ulong 24 w edit ulong 16 to int
op = get m 0
if eq op 0
winit m w
ret 0
end
if eq op 1
wpoll m w
ret 0
end
if eq op 2

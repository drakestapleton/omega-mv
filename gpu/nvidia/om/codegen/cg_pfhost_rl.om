note Router config cf[0..7]: k,e,t,mutant,warps,passes,chunks,group-bytes.
fn ph_rl_meta cf view ulong 64 meta edit ulong 512 to void
nv = add add 21 get cf 2 get cf 5
put meta 1 nv
put meta 2 1
put meta 320 2
for v ulong nv
sz = ulong 1
if lt v 3
sz = ulong 2
end
if ge v 15
sz = ulong 4
if and ge v 17 lt v add 17 get cf 2
sz = ulong 1
end
end
put meta add 64 v sz
end
end
fn ph_rl_head ins edit ulong 8192 st edit ulong 16 cf view ulong 64 to void
ph_imm ins st 7 0 856 4
ph_imm ins st 5 0 896 2
ph_imm ins st 5 1 904 2
ph_imm ins st 5 2 912 2
ph_imm ins st 3 3 33 2
ph_imm ins st 3 4 37 2
ph_imm ins st 2 7 1 0
ph_base st 17 5 3 PHNONE
put st 14 5
ph_emit ins st 0
ph_base st 18 6 3 PHNONE
put st 14 31
ph_emit ins st 0
ph_imad ins st 8 4 get cf 2 5
ph_wide ins st 0 8 mul get cf 0 4 0
ph_wide ins st 0 6 16 0
ph_imad ins st 9 5 512 PHNONE
ph_imad ins st 9 6 16 9
ph_wide ins st 1 3 16 1
ph_imad ins st 10 4 mul get cf 2 get cf 1 3
ph_wide ins st 2 10 4 2
for t ulong get cf 2
ph_imm ins st 2 add 17 t 2147483648 0
end
ph_load ins st 15 1 0 11
ph_imm ins st 2 11 get cf 6 0
end
fn ph_rl_stage ins edit ulong 8192 st edit ulong 16 cf view ulong 64 to void
ph_imm ins st 48 PHNONE 0 0
for p ulong get cf 5
d = add add 21 get cf 2 p
off = mul mul mul p get cf 4 get cf 0 4
kind = ulong 3
if eq p 0
kind = ulong 2
end
ph_load ins st d 0 off kind
end
for p ulong get cf 5
for q ulong 4
off = add mul mul p get cf 4 512 mul 4 q
ph_imad ins st 10 7 off 9
ph_base st 50 PHNONE 10 add add 21 get cf 2 p
put st 15 shl q 32
ph_emit ins st 5
end
end
ph_imm ins st 48 PHNONE 0 0
ph_wide ins st 0 7 512 0
ph_imm ins st 2 13 0 0
ph_imm ins st 2 12 16 0
end
fn ph_rl_math ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 b0 ulong nb ulong rv ulong to void
for i ulong nb
for q ulong 4
put cf 8 add add 17 b0 i
put cf 9 0
put cf 10 14
put cf 11 rv
put cf 12 add add 17 get cf 2 i
put cf 13 q
put cf 14 q
ph_muladd ins st cf
end
end
end
fn ph_rl_compute ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 rv ulong imm ulong to void
b0 = ulong 0
while lt b0 get cf 2 bound 4
nb = sub get cf 2 b0
if gt nb 4
nb = ulong 4
end
for i ulong nb
ph_base st 58 add add 17 get cf 2 i 13 PHNONE
put st 14 add mul add b0 i 512 imm
kind = ulong 3
if eq i 0
kind = ulong 2
end
ph_emit ins st kind
end
ph_rl_math ins st cf b0 nb rv
b0 = add b0 4
end
end
fn ph_rl_iter ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 to void
ph_consume st
ph_load ins st 16 1 get cf 7 11
ph_rl_compute ins st cf 15 0
ph_consume st
ph_load ins st 15 1 mul 2 get cf 7 11
ph_rl_compute ins st cf 16 16
ph_wide ins st 1 7 mul 2 get cf 7 1
ph_imad ins st 13 7 32 13
ph_imad ins st 12 7 4294967295 12
ph_base st 28 PHNONE 12 7
ph_emit ins st 1
end
fn ph_rl_body ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 meta edit ulong 512 to void
ph_rl_head ins st cf
outer = get st 0
ph_rl_stage ins st cf
inner = get st 0
ph_rl_iter ins st cf
ph_branch ins st inner
put meta 16 inner
put meta 17 sub get st 0 1
ph_imad ins st 11 7 4294967295 11
ph_base st 28 PHNONE 11 7
ph_emit ins st 1
ph_branch ins st outer
put meta 18 outer
put meta 19 sub get st 0 1
put meta 5 2
ph_consume st
for t ulong get cf 2
ph_base st 12 PHNONE 2 add 17 t
put st 13 0
put st 14 mul mul t get cf 1 4
ph_emit ins st 5
end
ph_tail ins st
put meta 0 get st 0
end

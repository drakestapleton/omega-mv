note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Replay wire admission. maxop is the final opcode of the pinned public enum; no new IR op is introduced.
fn validreg v ulong lim ulong to bool
ret or eq v 18446744073709551615 lt v lim
end
fn cg_replay ins view ulong 8192 meta view ulong 512 maxop ulong to ulong
n = get meta 0
if or eq n 0 gt n 1024
ret 4
end
if or gt get meta 1 256 gt get meta 2 32
ret 4
end
if gt get meta 5 24
ret 4
end
lim = get meta 6
if and ne lim 0 or le lim 128 gt lim 246
ret 4
end
if gt get meta 7 1
ret 9
end
if and eq get meta 7 1 gt get meta 1 160
ret 10
end
for v ulong get meta 1
k = get meta add 64 v
if and ne k 1 and ne k 2 ne k 4
ret 4
end
end
for u ulong get meta 2
k = get meta add 320 u
if and ne k 1 ne k 2
ret 4
end
end
for i ulong n
b = mul i 8
if gt get ins b maxop
ret 4
end
for off ulong 4
f = add off 1
if not validreg get ins add b f 256
ret 4
end
end
if not validreg get ins add b 5 32
ret 4
end
end
note Closures must occur in emitter order, as the C replay dispatch consumes them.
last = ulong 0
for l ulong get meta 5
e = get meta add 17 mul l 2
if or ge e n lt e last
ret 4
end
last = e
end
ret 0
end

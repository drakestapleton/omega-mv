note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Scalar ABI: a/b and c/d are memcpy-packed pairs of 32-bit golden words.
fn fv_bool b bool to ulong
if b
ret 1
end
ret 0
end

fn fv_words a ulong b ulong c ulong d ulong mask ulong to ulong
if ne and mask 1 0
if ne and a 4294967295 and c 4294967295
ret 0
end
end
if ne and mask 2 0
if ne shr a 32 shr c 32
ret 0
end
end
if ne and mask 4 0
if ne and b 4294967295 and d 4294967295
ret 0
end
end
if ne and mask 8 0
if ne shr b 32 shr d 32
ret 0
end
end
ret 1
end

note Variable shifts are decomposed into proven literal shifts for the freest profile.
fn fv_shl val ulong cnt ulong to ulong
x = val
if ne and cnt 1 0
x = shl x 1
end
if ne and cnt 2 0
x = shl x 2
end
if ne and cnt 4 0
x = shl x 4
end
if ne and cnt 8 0
x = shl x 8
end
if ne and cnt 16 0
x = shl x 16
end
if ne and cnt 32 0
x = shl x 32
end
ret x
end

fn fv_run op ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq op 0
ret fv_words a b c d e
end
if eq op 7
mask = ulong 7
if ne shr d 32 0
mask = 15
end
ret fv_words a b c d mask
end
if eq op 1
ret and sub ulong 0 add mul a 2 b 4294967295
end
if eq op 2
if eq b 0
ret fv_bool ne a 0
end
ret fv_bool eq a 0
end
if eq op 3
if eq e 0
ret fv_bool eq and xor b d 4294967295 262144
end
ret fv_bool and eq a c eq shr b 32 shr d 32
end
if eq op 4
ret fv_bool and eq a or c 288230376151711744 eq b d
end
if eq op 5
x = fv_shl b c
y = fv_shl d e
ret or or a x y
end
if eq op 6
if eq a b
ret c
end
ret d
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Golden fixture comparisons and error-index arithmetic; encoding remains in the encoder unit.
fn fv_bool b bool to ulong
if b
ret 1
end
ret 0
end

fn fv_words m view ulong 16 to ulong
mask = get m 9
if eq get m 0 7
mask = 7
if ne get m 8 0
mask = 15
end
end
for i ulong 4
if ne and mask shl ulong 1 i 0
if ne get m add 1 i get m add 5 i
ret 0
end
end
end
ret 1
end

fn fv_check m view ulong 16 to ulong
op = get m 0
if or eq op 0 eq op 7
ret fv_words m
end
if eq op 1
ret and sub ulong 0 add mul get m 1 2 get m 2 4294967295
end
if eq op 2
if eq get m 2 0
ret fv_bool ne get m 1 0
end
ret fv_bool eq get m 1 0
end
if eq op 3
if eq get m 9 0
ret fv_bool eq xor get m 3 get m 7 262144
end
a = eq get m 1 get m 5
b = eq get m 2 get m 6
c = eq get m 4 get m 8
ret fv_bool and and a b c
end
if eq op 4
a = eq get m 1 get m 5
b = eq get m 2 or get m 6 67108864
c = eq get m 3 get m 7
d = eq get m 4 get m 8
ret fv_bool and and a b and c d
end
if eq op 5
a = shl get m 2 get m 3
b = shl get m 4 get m 5
ret or or get m 1 a b
end
if eq op 6
if eq get m 1 get m 2
ret get m 3
end
ret get m 4
end
ret 0
end

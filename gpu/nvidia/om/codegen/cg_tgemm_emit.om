note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Reuses checked record packing from cg_qmma.om. Encoded register operands carry subregister in bits 8..15.
fn tg_reg v ulong to ulong
if eq v NR
ret NR
end
ret and v 255
end
fn tg_sub v ulong to ulong
if eq v NR
ret 0
end
ret shr v 8
end
fn tg_u b edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong imm ulong to void
x = new ulong 16 0
omega_cg_qmma_i x op
put x 1 tg_reg d
put x 11 tg_sub d
put x 2 tg_reg a
put x 12 tg_sub a
put x 6 imm
kind = ulong 0
if or eq op 3 eq op 5
kind = 2
end
if eq op 7
put x 8 1
kind = 4
end
omega_cg_qmma_emit b m x kind
end
fn tg_ma b edit ulong 8192 m edit ulong 512 d ulong a ulong imm ulong c ulong to void
x = new ulong 16 0
op = ulong 8
if gt imm 4294967295
op = 9
end
omega_cg_qmma_i x op
put x 1 tg_reg d
put x 11 tg_sub d
put x 2 tg_reg a
put x 12 tg_sub a
put x 4 c
put x 6 and imm 4294967295
omega_cg_qmma_emit b m x 0
end
fn tg_bin b edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong c ulong to void
x = new ulong 16 0
omega_cg_qmma_i x op
put x 1 tg_reg d
put x 11 tg_sub d
put x 2 tg_reg a
put x 12 tg_sub a
put x 3 tg_reg c
put x 13 tg_sub c
omega_cg_qmma_emit b m x 0
end
fn tg_load b edit ulong 8192 m edit ulong 512 ops ulong d ulong a ulong imm ulong to void
x = new ulong 16 0
op = and ops 255
kind = shr ops 8
omega_cg_qmma_i x op
put x 1 d
put x 2 a
put x 6 imm
if or eq op 56 eq op 57
put x 5 0
end
if lt kind 16
omega_cg_qmma_emit b m x kind
else
sb = sub kind 16
put x 7 or omega_cg_qmma_cw 4 sb 1 and get m 3 2 8192
put m 3 or get m 3 2
put m 7 or get m 7 shl 1 sb
n = get m 0
if ge n 1024
put m 4 2
ret
end
omega_cg_qmma_pack b x n
put m 0 add n 1
end
end
fn tg_store b edit ulong 8192 m edit ulong 512 op ulong a ulong v ulong imm ulong to void
x = new ulong 16 0
omega_cg_qmma_i x op
put x 2 a
put x 3 tg_reg v
put x 13 tg_sub v
put x 6 imm
if eq op 12
put x 5 0
end
omega_cg_qmma_emit b m x 5
end
fn tg_hmma b edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong stall ulong to void
x = new ulong 16 0
omega_cg_qmma_i x 16
put x 1 d
put x 2 a
put x 3 v
put x 4 d
put x 7 stall
omega_cg_qmma_emit b m x 11
end
fn tg_sel b edit ulong 8192 m edit ulong 512 d ulong a ulong c ulong to void
x = new ulong 16 0
omega_cg_qmma_i x 51
put x 1 d
put x 2 a
put x 3 a
put x 13 1
put x 4 c
put x 6 216
omega_cg_qmma_emit b m x 0
end
fn tg_bar b edit ulong 8192 m edit ulong 512 to void
x = new ulong 16 0
omega_cg_qmma_i x 48
omega_cg_qmma_emit b m x 0
end
fn tg_nop b edit ulong 8192 m edit ulong 512 stall ulong to void
x = new ulong 16 0
omega_cg_qmma_i x 0
put x 7 stall
omega_cg_qmma_emit b m x 11
end
fn tg_consume m edit ulong 512 sb ulong to void
mask = shl 1 sb
put m 3 or get m 3 and get m 7 mask
put m 7 and get m 7 not mask
end

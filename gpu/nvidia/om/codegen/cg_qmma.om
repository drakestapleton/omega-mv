fn omega_cg_qmma_offset c ulong q ulong to ulong
ret add mul c 16 mul q 4
end
fn omega_cg_qmma_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end
fn omega_cg_qmma_v m edit ulong 512 k ulong to ulong
v = get m 1
if ge v 256
put m 4 1
ret NR
end
put m add 64 v k
put m 1 add v 1
ret v
end
fn omega_cg_qmma_i x edit ulong 16 op ulong to void

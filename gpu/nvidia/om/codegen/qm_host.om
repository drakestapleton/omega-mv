note op 0 mark predicate; 1 little-endian read; >=2 packed selftest counts plus 2.
note a,b,c,d,e are insn op, immediate, word0, word1, word2 for verification.
fn qm_host op ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq op 0
if and eq a 16 eq b 1362114610
ret 1
end
ret 0
end
if eq op 1
ret or or a shl b 8 or shl c 16 shl d 24
end
if eq a 37
if ne and c 65535 29246
ret 18446744073709551615
end
if ne and d 4294967040 0
ret 18446744073709551615
end
if ne e 75526399
ret 18446744073709551615
end
ret add op 65536
end
if ne a 16
ret op
end
if eq b 1362114610
if ne and c 65535 29306
ret 18446744073709551615
end
if ne and d 4294967040 0
ret 18446744073709551615
end
if ne and e 4294967040 11264
ret 18446744073709551615
end
ret add op 1
end
if or ne and c 65535 29244 ne and e 4294967040 268288
ret 18446744073709551615
end
ret add op 256
end

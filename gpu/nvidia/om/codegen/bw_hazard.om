qu = add se n
ch = hz_join m add hz_in n mul t 1536 1024
sv = get m add se t
qv = get m add qu t
if and or ch eq sv 1 eq qv 0
put m add qu t 1
put m add add qu n top t
ret add top 1
end
ret top
end
fn hz_fix m edit ulong 3203584 n ulong to void
se = hz_se n
qu = add se n
wk = add qu n
put m wk 0
put m qu 1
top = ulong 1
while gt top 0 bound 999999
top = sub top 1
pc = get m add wk top
put m add qu pc 0
put m add se pc 2
hz_copy m 1024 add hz_in n mul pc 1536
dr = add 2560 mul pc 24
hz_step m dr 1024 pc false
fl = get m add dr 17
gd = get m add dr 1
if or eq fl 0 ne gd 7
top = hz_edge m n add pc 1 top
end
if eq fl 2
top = hz_edge m n hz_tgt m pc top
end
end
end
fn hz_chk c view uchar 32768 lc ulong m edit ulong 3203584 to long

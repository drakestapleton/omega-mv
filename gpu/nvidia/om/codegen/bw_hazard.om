if hz_dup m pc key
ret
end
cnt = get m 2
if lt cnt 256
f = add 8 mul cnt 3
put m f pc
put m add f 1 src
put m add f 2 or key shl hz_low pend 24
end
put m 2 add cnt 1
end
fn hz_dup m edit ulong 3203584 pc ulong key ulong to bool

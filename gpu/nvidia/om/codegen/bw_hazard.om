put m x w
r = and get m add x 512 k
put m add x 512 r
p = add x 1024
h = get m p
wt = hz_wtag w and h 4294967295
rt = hz_wtag r shr h 32
put m p or wt shl rt 32
end
end
end
fn hz_step m edit ulong 3203584 dr ulong sb ulong pc ulong rep bool to void
hz_wait m dr sb
nr = get m add dr 9
for j ulong nr
op = get m add add dr 11 j
hz_raw m op sb pc rep
end
nw = get m add dr 10
if ne nw 0
hz_wop m dr sb pc rep
end
bit = hz_lbit m dr
if ne bit 0
for j ulong nr
op = get m add add dr 11 j
hz_late m op sb pc bit
end
end
end
fn hz_join m edit ulong 3203584 dst ulong src ulong to bool
ch = false
for i ulong 512
a = hz_j1 m add dst i add src i 0
b = hz_j1 m add dst i add src i 1
if or a b
ch = true
end
end
ret ch
end
fn hz_j1 m edit ulong 3203584 d ulong s ulong sel ulong to bool

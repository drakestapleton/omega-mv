note The pc tag rules of the C (step and join), each on plain numbers so gpu/nvidia/checks/bwhz can run them.
fn hz_pmin a ulong b ulong to ulong
if eq a 0
ret b
end
if eq b 0
ret a
end
if lt a b
ret a
end
ret b
end
note late reader at pc queued on an entry with mask r and tag rt: pmin(rt, pc + 1) if r, else pc + 1
fn hz_ltag r ulong rt ulong pc ulong to ulong
t = add pc 1
if ne r 0
t = hz_pmin rt t
end
ret t
end
note join of a source entry with mask sv and tag st into tag dt: pmin(dt, st) if sv, else dt
fn hz_jtag dt ulong sv ulong st ulong to ulong
if ne sv 0
ret hz_pmin dt st
end
ret dt
end
note an entry whose mask v a wait left empty drops its tag t
fn hz_wtag v ulong t ulong to ulong
if eq v 0
ret 0
end
ret t
end
fn hz_lbit m edit ulong 3203584 dr ulong to ulong
rb = get m add dr 5
wb = get m add dr 4

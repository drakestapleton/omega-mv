note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure decisions from omega_bw_em.h and omega_bw_em_q.h. C owns IR records and append.
note w: pending, held, control, unused. All control arithmetic has C uint32 wrap.
fn em_cw st uint wb uint rb uint wt uint to uint
ret or or or shl st 9 shl wb 14 shl rb 17 shl wt 20
end
fn em_emit k long pred long w edit ulong 4 to long
wt = uint get w 0
pn = wt
cw = uint 0
if or eq k 0 eq k 6
cw = em_cw 6 7 7 wt
pn = uint 0
else
if eq k 1
cw = em_cw 14 7 7 wt
pn = uint 0
else
if or eq k 2 eq k 3
if eq k 3
wt = and wt 2
pn = or pn 3
else
pn = uint 3
end
cw = or em_cw 4 0 1 wt 8192
else
if eq k 4
cw = or em_cw 4 2 7 wt 8192
pn = uint 4
else
if eq k 5
cw = or em_cw 4 7 1 wt 8192
pn = uint 2
else
if or eq k 7 eq k 8
cw = em_cw 5 7 7 wt
if eq pred 0
pn = uint 0
end
else
if eq k 9
cw = or em_cw 1 7 7 wt 8192
pn = uint 0
else
if eq k 10
cw = or em_cw 5 7 7 wt 8192
pn = uint 0
else
ret -1
end
end
end
end
end
end
end
end
put w 0 ulong pn
put w 2 ulong cw
ret 0
end
fn em_log v ulong to long
l = ulong 0
while lt shl ulong 1 l v bound 32
l = add l 1
end
if eq shl ulong 1 l v
ret long l
end
ret -1
end
fn cg_em act ulong a long b long c long w edit ulong 4 to long
if eq act 0
ret em_emit a b w
end
if eq act 1
sb = uint a
put w 2 ulong or em_cw 4 sb 1 and uint get w 0 2 8192
put w 0 or get w 0 2
put w 1 or get w 1 ulong shl uint 1 sb
ret 0
end
if eq act 2
mk = ulong shl uint 1 uint a
put w 0 or get w 0 and get w 1 mk
put w 1 and get w 1 xor mk 4294967295
ret 0
end
if eq act 3
if ge a 4
ret -1
end
ret add a 1
end
if eq act 4
if le a 0
ret -1
end
ret sub a 1
end
if eq act 5
endval = long get w 3
if ge endval 2147483648
endval = sub endval 4294967296
end
if and and ge a 0 lt a b and ge c b lt c endval
ret endval
end
ret c
end
if eq act 6
ret em_log ulong a
end
if eq act 7
put w 2 ulong em_cw uint a 7 7 uint get w 0
put w 0 0
ret 0
end
if eq act 8
ret sub a b
end
if eq act 9
ret and a 31
end
ret -1
end

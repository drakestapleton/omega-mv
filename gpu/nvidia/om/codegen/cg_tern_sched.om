note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Postallocation physical dependency scheduling and the independent I2FP consumer-distance gate.
const NR ulong 18446744073709551615
fn omega_ct_fixed op ulong to bool
ret or or or eq op 8 eq op 9 or eq op 17 eq op 18 or or eq op 2 eq op 1 or eq op 32 eq op 38
end
fn omega_ct_control op ulong to bool
ret or or eq op 46 eq op 45 or eq op 54 or eq op 55 eq op 48
end
fn omega_ct_span m view ulong 512 v ulong to ulong
if ge v 256
ret 0
end
if eq get m v NR
ret 0
end
c = get m add 256 v
if eq c 0
c = 1
end
ret or get m v shl c 32
end
fn omega_ct_overlap m view ulong 512 a ulong b ulong to bool
x = omega_ct_span m a
y = omega_ct_span m b
ca = shr x 32
cb = shr y 32
if or eq ca 0 eq cb 0
ret false
end
la = and x 4294967295
lb = and y 4294967295
if ge la add lb cb
ret false
end
ret lt lb add la ca
end
fn omega_ct_target i ulong imm ulong to ulong
if lt imm 2147483648
ret add i imm
end
ret sub i sub 4294967296 imm
end
note Scheduler state: T, all-ready, count, I2FP latency, need, instruction index, span, span index.
fn omega_ct_stamp b view ulong 8192 m view ulong 512 r edit ulong 264 s edit ulong 8 to ulong
if omega_ct_fixed get b mul get s 5 8
put s 4 add get s 0 6
if eq get b mul get s 5 8 38
put s 4 add get s 0 get s 3
end
put s 6 omega_ct_span m get b add mul get s 5 8 3
put s 7 0
while lt get s 7 shr get s 6 32 bound 4
ph = add and get s 6 4294967295 get s 7
if ge ph 264
ret 1
end
put r ph get s 4
put s 7 add get s 7 1
end
if and ne shr get s 6 32 0 gt get s 4 get s 1
put s 1 get s 4
end
end
ret 0
end
fn omega_ct_max r view ulong 264 s edit ulong 8 to void
for k ulong shr get s 6 32
v = get r add and get s 6 4294967295 k
if gt v get s 4
put s 4 v
end
end
end
fn omega_ct_need b view ulong 8192 m view ulong 512 r view ulong 264 s edit ulong 8 to void
at = add mul get s 5 8 1
st = and shr get b at 9 15
put s 4 add get s 0 st
if omega_ct_fixed get b mul get s 5 8
put s 4 add get s 0 1
end
if lt add get s 5 1 get s 2
put s 7 0
while lt get s 7 4 bound 4
at = add mul add get s 5 1 8 add 3 get s 7
put s 6 omega_ct_span m get b at
omega_ct_max r s
put s 7 add get s 7 1
end
end
end
fn omega_ct_finish b edit ulong 8192 s edit ulong 8 t view ulong 1025 to ulong
i = get s 5
if lt add i 1 get s 2
if or omega_ct_control get b mul add i 1 8 ne get t add i 1 0
if gt get s 1 get s 4
put s 4 get s 1
end
end
end
op = get b mul i 8
st = and shr get b add mul i 8 1 9 15
ns = sub get s 4 get s 0
if gt ns 15
ret 1
end
if eq ns 0
if or omega_ct_fixed op ne st 0
ret 1
end
end
if or omega_ct_fixed op gt ns st
at = add mul i 8 1
put b at or and get b at 4294959615 shl ns 9
end
put s 0 get s 4
ret 0
end
fn omega_ct_operands b view ulong 8192 m view ulong 512 dst ulong j ulong to bool
for q ulong 4
v = get b add add mul j 8 3 q
if omega_ct_overlap m dst v
ret true
end
end
ret false
end
fn omega_ct_check b view ulong 8192 m view ulong 512 t view ulong 1025 i ulong n ulong to ulong
dst = get b add mul i 8 3
if or ne get b mul i 8 38 eq dst NR
ret 0
end
dist = ulong 0
j = add i 1
while lt j n bound 1024
at = add mul sub j 1 8 1
dist = add dist and shr get b at 9 15
if ge dist 19
ret 0
end
if or omega_ct_control get b mul j 8 ne get t j 0
ret 1
end
if omega_ct_operands b m dst j
ret 1
end
j = add j 1
end
ret 0
end
fn omega_ct_targets b view ulong 8192 t edit ulong 1025 n ulong strict bool to ulong
for i ulong n
op = get b mul i 8
if or eq op 46 eq op 54
target = omega_ct_target i get b add mul i 8 2
if gt target n
if strict
ret NR
end
else
put t target 1
end
end
end
ret 0
end
fn omega_ct_schedule b edit ulong 8192 m view ulong 512 t view ulong 1025 n ulong lat ulong to ulong
r = new ulong 264 0
s = new ulong 8 0
put s 2 n
put s 3 19
if eq lat 4
put s 3 6
end
while lt get s 5 n bound 1024
if ne omega_ct_stamp b m r s 0
ret NR
end
omega_ct_need b m r s
if ne omega_ct_finish b s t 0
ret NR
end
put s 5 add get s 5 1
end
ret 0
end
fn omega_ct_checks b view ulong 8192 m view ulong 512 t view ulong 1025 n ulong to ulong
bad = ulong 0
for i ulong n
bad = add bad omega_ct_check b m t i n
end
ret bad
end
fn cg_tern_sched mode ulong n ulong lat ulong b edit ulong 8192 m view ulong 512 to ulong
t = new ulong 1025 0
if gt n 1024
ret NR
end
if ne omega_ct_targets b t n eq mode 0 0
ret NR
end
if eq mode 0
ret omega_ct_schedule b m t n lat
end
ret omega_ct_checks b m t n
end

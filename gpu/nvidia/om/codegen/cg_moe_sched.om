note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The C oracle fixed-producer six-cycle postallocation dependency pass.
const NR ulong 18446744073709551615
fn omega_cm_fixed op ulong to bool
if or eq op 8 eq op 9
ret true
end
if or eq op 17 eq op 18
ret true
end
if or eq op 29 eq op 2
ret true
end
if or eq op 1 eq op 33
ret true
end
ret eq op 30
end
fn omega_cm_control op ulong to bool
ret or or eq op 46 eq op 45 or eq op 54 or eq op 55 eq op 48
end
fn omega_cm_span m view ulong 512 v ulong to ulong
if ge v 256
ret 0
end
if eq get m v NR
ret 0
end
c = get m add 256 v
if eq c 0
c = 1
end
ret or get m v shl c 32
end
fn omega_cm_target i ulong imm ulong to ulong
if lt imm 2147483648
ret add i imm
end
ret sub i sub 4294967296 imm
end
note Scheduler state: T, all-ready, count, reserved, need, instruction index, span, span index.
fn omega_cm_stamp b view ulong 8192 m view ulong 512 r edit ulong 264 s edit ulong 8 to ulong
if omega_cm_fixed get b mul get s 5 8
put s 4 add get s 0 6
put s 6 omega_cm_span m get b add mul get s 5 8 3
put s 7 0
while lt get s 7 shr get s 6 32 bound 4
ph = add and get s 6 4294967295 get s 7
if ge ph 264
ret 1
end
put r ph get s 4
put s 7 add get s 7 1
end
if and ne shr get s 6 32 0 gt get s 4 get s 1
put s 1 get s 4
end
end
ret 0
end
fn omega_cm_max r view ulong 264 s edit ulong 8 to void
for k ulong shr get s 6 32
v = get r add and get s 6 4294967295 k
if gt v get s 4
put s 4 v
end
end
end
fn omega_cm_need b view ulong 8192 m view ulong 512 r view ulong 264 s edit ulong 8 to void
at = add mul get s 5 8 1
st = and shr get b at 9 15
put s 4 add get s 0 st
if omega_cm_fixed get b mul get s 5 8
put s 4 add get s 0 1
end
if lt add get s 5 1 get s 2
put s 7 0
while lt get s 7 4 bound 4
at = add mul add get s 5 1 8 add 3 get s 7
put s 6 omega_cm_span m get b at
omega_cm_max r s
put s 7 add get s 7 1
end
end
end
fn omega_cm_finish b edit ulong 8192 s edit ulong 8 t view ulong 1025 to ulong
i = get s 5
if lt add i 1 get s 2
if or omega_cm_control get b mul add i 1 8 ne get t add i 1 0
if gt get s 1 get s 4
put s 4 get s 1
end
end
end
op = get b mul i 8
st = and shr get b add mul i 8 1 9 15
ns = sub get s 4 get s 0
if gt ns 15
ret 1
end
if eq ns 0
if or omega_cm_fixed op ne st 0
ret 1
end
end
if or omega_cm_fixed op gt ns st
at = add mul i 8 1
put b at or and get b at 4294959615 shl ns 9
end
put s 0 get s 4
ret 0
end
fn omega_cm_targets b view ulong 8192 t edit ulong 1025 n ulong strict bool to ulong
for i ulong n
op = get b mul i 8
if or eq op 46 eq op 54
target = omega_cm_target i get b add mul i 8 2
if gt target n
if strict
ret NR
end
else
put t target 1
end
end
end
ret 0
end
fn omega_cm_schedule b edit ulong 8192 m view ulong 512 t view ulong 1025 n ulong to ulong
r = new ulong 264 0
s = new ulong 8 0
put s 2 n
while lt get s 5 n bound 1024
if ne omega_cm_stamp b m r s 0
ret NR
end
omega_cm_need b m r s
if ne omega_cm_finish b s t 0
ret NR
end
put s 5 add get s 5 1
end
ret 0
end
fn cg_moe_sched n ulong b edit ulong 8192 m view ulong 512 to ulong
t = new ulong 1025 0
if gt n ulong 1024
ret NR
end
if ne omega_cm_targets b t n true ulong 0
ret NR
end
ret omega_cm_schedule b m t n
end

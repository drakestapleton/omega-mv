note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note GDN builders, shared part: the record emitter and the operand helpers (the shape is cg_gdn_shape.om).
note The oracle is the migration-only branch of src/omega_blackwell_codegen_gdn.c (CUDAPP_MIGRATION_PENDING_C_CODEGEN_GDN).
note Records: b holds 8 words per instruction (the omega_gpu_om_ir_replay layout), m is the metadata.
note Metadata m0=count m1=vregs m2=uvregs m3=pending waits m4=error m5=closed loops m6=GPR limit.
note Scratch m8=held scoreboards m9=open loop depth m10/m11=open loop starts; cleared before an ok return.
note An operand is vreg or sub shl 32; NR (all ones) is no register.
note Instruction scratch x: 0 op 1 dst 2 src1 3 src2 4 src3 5 ureg 6 imm 7 control 8 uniform 9 p0 10 not 11..14 subs 15 bar.
note Emit kinds: 0 fixed 1 pred 2 var 3 var-more 4 uvar 5 store 6 sync 7 exit 8 bra 9 bssy 10 bsync.
note The only uniform register is the descriptor, uvreg 0.
const NR ulong 18446744073709551615
fn omega_gd_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end
fn omega_gd_v m edit ulong 512 k ulong to ulong
v = get m 1
if ge v 256
put m 4 1
ret NR
end
put m add 64 v k
put m 1 add v 1
ret v
end
fn omega_gd_uv m edit ulong 512 to ulong
put m 2 1
put m 320 2
ret 0
end
fn omega_gd_a m edit ulong 512 s edit ulong 512 i ulong k ulong to void
put s i omega_gd_v m k
end
fn omega_gd_an m edit ulong 512 s edit ulong 512 i ulong n ulong k ulong to void
for j ulong n
put s add i j omega_gd_v m k
end
end
fn omega_gd_S s view ulong 512 i ulong j ulong to ulong
ret or get s i shl j 32
end
fn omega_gd_i x edit ulong 16 op ulong to void
for i ulong 16
put x i 0
end
put x 0 op
for i ulong 5
put x add i 1 NR
end
end
fn omega_gd_o x edit ulong 16 f ulong o ulong to void
if eq o NR
put x f NR
ret
end
put x f and o 4294967295
put x add f 10 shr o 32
end
fn omega_gd_f x edit ulong 16 op ulong d ulong a ulong c ulong e ulong to void
omega_gd_i x op
omega_gd_o x 1 d
omega_gd_o x 2 a
omega_gd_o x 3 c
omega_gd_o x 4 e
end
fn omega_gd_pack b edit ulong 8192 x view ulong 16 n ulong to void
off = mul n 8
for i ulong 6
put b add off i get x i
end
put b add off 6 or and get x 6 4294967295 shl get x 7 32
fl = or get x 8 or shl get x 9 1 shl get x 10 2
for i ulong 5
fl = or fl shl get x add i 11 add 16 mul i 8
end
put b add off 7 fl
end
fn omega_gd_raw b edit ulong 8192 m edit ulong 512 x view ulong 16 to void
n = get m 0
if ge n 1024
put m 4 2
ret
end
omega_gd_pack b x n
put m 0 add n 1
end
fn omega_gd_emit b edit ulong 8192 m edit ulong 512 x edit ulong 16 k ulong to void
wt = get m 3
st = ulong 6
wb = ulong 7
rb = ulong 7
pn = ulong 0
yld = ulong 0
if eq k 1
st = 14
end
if or eq k 2 eq k 3
st = 4
wb = 0
rb = 1
pn = or get m 3 3
yld = 8192
if eq k 2
pn = 3
else
wt = and wt 2
end
end
if eq k 4
st = 4
wb = 2
pn = 4
yld = 8192
end
if eq k 5
st = 4
rb = 1
pn = 2
yld = 8192
end
if or eq k 7 eq k 8
st = 5
if ne get x 9 0
pn = wt
end
end
if eq k 9
st = 1
yld = 8192
end
if eq k 10
st = 5
yld = 8192
end
put x 7 or omega_gd_cw st wb rb wt yld
put m 3 pn
omega_gd_raw b m x
end
fn omega_gd_patch b edit ulong 8192 m edit ulong 512 at ulong tg ulong to void
if ne get m 4 0
ret
end
i = add mul at 8 6
put b i or and get b i 18446744069414584320 and sub tg at 4294967295
end
note ok = op, kind shl 8, uniform shl 16: dst d, src1 a, imm im.
fn omega_gd_di b edit ulong 8192 m edit ulong 512 ok ulong d ulong a ulong im ulong to void
x = new ulong 16 0
omega_gd_f x and ok 255 d a NR NR
put x 6 im
put x 8 and shr ok 16 1
omega_gd_emit b m x and shr ok 8 255
end
fn omega_gd_ldcu b edit ulong 8192 m edit ulong 512 ud ulong off ulong to void
omega_gd_di b m 66567 ud NR off
end
fn omega_gd_ldc64 b edit ulong 8192 m edit ulong 512 d ulong off ulong to void
omega_gd_di b m 517 d NR off
end
fn omega_gd_ldc32 b edit ulong 8192 m edit ulong 512 d ulong off ulong to void
omega_gd_di b m 516 d NR off
end
fn omega_gd_s2r b edit ulong 8192 m edit ulong 512 d ulong sr ulong to void
omega_gd_di b m 515 d NR sr
end
fn omega_gd_movi b edit ulong 8192 m edit ulong 512 d ulong im ulong to void
omega_gd_di b m 2 d NR im
end
fn omega_gd_movrz b edit ulong 8192 m edit ulong 512 d ulong to void
omega_gd_di b m 1 d NR 0
end
fn omega_gd_shr b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong to void
omega_gd_di b m 17 d a im
end
fn omega_gd_andi b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong to void
omega_gd_di b m 18 d a im
end
fn omega_gd_i2fp b edit ulong 8192 m edit ulong 512 d ulong a ulong to void
omega_gd_di b m 38 d a 0
end
note MUFU: EX2 47, RCP 40, RSQ 41, LG2 59.
fn omega_gd_mufu b edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong to void
omega_gd_di b m or op 512 d a 0
end
fn omega_gd_shfd b edit ulong 8192 m edit ulong 512 d ulong a ulong off ulong to void
omega_gd_di b m 554 d a off
end
fn omega_gd_shfb b edit ulong 8192 m edit ulong 512 d ulong a ulong ln ulong to void
omega_gd_di b m 572 d a and ln 31
end
fn omega_gd_lds128 b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong f ulong to void
omega_gd_di b m or 58 shl sub 3 f 8 d a im
end
fn omega_gd_lds32 b edit ulong 8192 m edit ulong 512 d ulong a ulong f ulong to void
omega_gd_di b m or 49 shl sub 3 f 8 d a 0
end
note Global loads through the descriptor: of = op, first shl 8.
fn omega_gd_ld b edit ulong 8192 m edit ulong 512 of ulong d ulong a ulong im ulong to void
x = new ulong 16 0
omega_gd_f x and of 255 d a NR NR
put x 5 0
put x 6 im
omega_gd_emit b m x sub 3 shr of 8
end
fn omega_gd_ldg32 b edit ulong 8192 m edit ulong 512 d ulong a ulong f ulong to void
omega_gd_ld b m or 11 shl f 8 d a 0
end
fn omega_gd_ldg64 b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong f ulong to void
omega_gd_ld b m or 56 shl f 8 d a im
end
fn omega_gd_ldg128 b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong f ulong to void
omega_gd_ld b m or 57 shl f 8 d a im
end
note A prefetch load under the held scoreboard sb, waited for at omega_gd_consume: os = op, sb shl 8.
fn omega_gd_pf b edit ulong 8192 m edit ulong 512 os ulong d ulong a ulong im ulong to void
x = new ulong 16 0
sb = shr os 8
omega_gd_f x and os 255 d a NR NR
put x 5 0
put x 6 im
put x 7 or omega_gd_cw 4 sb 1 and get m 3 2 8192
put m 3 or get m 3 2
put m 8 or get m 8 shl 1 sb
omega_gd_raw b m x
end
fn omega_gd_consume m edit ulong 512 sb ulong to void
bit = and get m 8 shl 1 sb
put m 3 or get m 3 bit
put m 8 xor get m 8 bit
end
fn omega_gd_stg b edit ulong 8192 m edit ulong 512 a ulong im ulong v ulong to void
x = new ulong 16 0
omega_gd_f x 12 NR a v NR
put x 5 0
put x 6 im
omega_gd_emit b m x 5
end
fn omega_gd_sts32 b edit ulong 8192 m edit ulong 512 a ulong v ulong to void
x = new ulong 16 0
omega_gd_f x 50 NR a v NR
omega_gd_emit b m x 5
end
note d = a * im + c (c a plain vreg or NR); wide: d64 = a * im + c64.
fn omega_gd_imadi b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong c ulong to void
x = new ulong 16 0
omega_gd_f x 8 d a NR c
put x 6 im
omega_gd_emit b m x 0
end
fn omega_gd_imadw b edit ulong 8192 m edit ulong 512 d ulong a ulong im ulong c ulong to void
x = new ulong 16 0
omega_gd_f x 9 d a NR c
put x 6 im
omega_gd_emit b m x 0
end
fn omega_gd_mov b edit ulong 8192 m edit ulong 512 d ulong a ulong to void
omega_gd_imadi b m d a 1 NR
end
fn omega_gd_f2fp b edit ulong 8192 m edit ulong 512 d ulong hi ulong lo ulong to void
x = new ulong 16 0
omega_gd_f x 61 d hi lo NR
omega_gd_emit b m x 0
end
note FADD 30, FSUB 31, FMUL 32, FMNMX min 36, max 37.
fn omega_gd_fo b edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong c ulong to void
x = new ulong 16 0
omega_gd_f x op d a c NR
omega_gd_emit b m x 0
end
fn omega_gd_ffma b edit ulong 8192 m edit ulong 512 d ulong a ulong c ulong e ulong to void
x = new ulong 16 0
omega_gd_f x 33 d a c e
omega_gd_emit b m x 0
end
fn omega_gd_isetp b edit ulong 8192 m edit ulong 512 a ulong c ulong to void
x = new ulong 16 0
omega_gd_f x 28 NR a c NR
omega_gd_emit b m x 1
end
fn omega_gd_bar b edit ulong 8192 m edit ulong 512 to void
x = new ulong 16 0
omega_gd_i x 48
omega_gd_emit b m x 6
end
fn omega_gd_brab b edit ulong 8192 m edit ulong 512 tg ulong to void
x = new ulong 16 0
omega_gd_i x 46
put x 9 1
put x 6 and sub tg get m 0 4294967295
omega_gd_emit b m x 8
end
fn omega_gd_braf b edit ulong 8192 m edit ulong 512 p ulong to ulong
at = get m 0
x = new ulong 16 0
omega_gd_i x 46
put x 9 p
put x 6 1
omega_gd_emit b m x 8
ret at
end
fn omega_gd_bssy b edit ulong 8192 m edit ulong 512 to ulong
at = get m 0
x = new ulong 16 0
omega_gd_i x 54
put x 6 2
omega_gd_emit b m x 9
ret at
end
fn omega_gd_bsync b edit ulong 8192 m edit ulong 512 to void
x = new ulong 16 0
omega_gd_i x 55
omega_gd_emit b m x 10
end
fn omega_gd_tail b edit ulong 8192 m edit ulong 512 to void
x = new ulong 16 0
omega_gd_i x 45
omega_gd_emit b m x 7
omega_gd_i x 46
put x 7 1032192
omega_gd_raw b m x
end
note A region some lanes skip: BSSY, @P0 BRA join, body, BSYNC. Returns the BSSY index; the BRA follows it.
fn omega_gd_rgn b edit ulong 8192 m edit ulong 512 to ulong
r = omega_gd_bssy b m
j = omega_gd_braf b m 1
ret sub j 1
end
fn omega_gd_rend b edit ulong 8192 m edit ulong 512 r ulong to void
at = get m 0
omega_gd_bsync b m
omega_gd_patch b m add r 1 at
omega_gd_patch b m r add at 1
end
fn omega_gd_lb m edit ulong 512 to void
dp = get m 9
if ge dp 2
put m 4 1
ret
end
put m add 10 dp get m 0
put m 9 add dp 1
end
fn omega_gd_le m edit ulong 512 to void
dp = get m 9
if eq dp 0
put m 4 1
ret
end
dp = sub dp 1
put m 9 dp
l = get m 5
put m add 16 mul l 2 get m add 10 dp
put m add 17 mul l 2 sub get m 0 1
put m 5 add l 1
end
fn omega_gd_bfly b edit ulong 8192 m edit ulong 512 v ulong t ulong lo ulong hi ulong to void
o = lo
while le o hi bound 64
omega_gd_shfb b m t v o
omega_gd_fo b m 30 v v t
o = mul o 2
end
end
fn omega_gd_wsum b edit ulong 8192 m edit ulong 512 v ulong t ulong to void
o = ulong 16
while ge o 1 bound 8
omega_gd_shfd b m t v o
omega_gd_fo b m 30 v v t
o = shr o 1
end
end
fn omega_gd_l0sts b edit ulong 8192 m edit ulong 512 ln ulong one ulong ad ulong v ulong to void
omega_gd_isetp b m ln one
r = omega_gd_rgn b m
omega_gd_sts32 b m ad v
omega_gd_rend b m r
end
fn omega_gd_silu b edit ulong 8192 m edit ulong 512 x ulong t ulong nl ulong one ulong to void
omega_gd_fo b m 32 t x nl
omega_gd_mufu b m 47 t t
omega_gd_fo b m 30 t t one
omega_gd_mufu b m 40 t t
omega_gd_fo b m 32 x x t
end
fn omega_gd_widen b edit ulong 8192 m edit ulong 512 q ulong w ulong to void
for j ulong 4
d = or q shl j 32
a = or w shl shr j 1 32
if eq rem j 2 0
omega_gd_imadi b m d a 65536 NR
else
omega_gd_andi b m d a 4294901760
end
end
end
fn omega_gd_bpack b edit ulong 8192 m edit ulong 512 w ulong q ulong to void
omega_gd_f2fp b m w or q 4294967296 q
omega_gd_f2fp b m or w 4294967296 or q 12884901888 or q 8589934592
end
fn omega_gd_cwj b edit ulong 8192 m edit ulong 512 s view ulong 512 ai ulong bb ulong w ulong to void
for j ulong 4
a = get s add ai j
x0 = or and bb 65535 shl j 32
x1 = or shr bb 16 shl j 32
if eq w 0
omega_gd_fo b m 30 a x0 x1
else
omega_gd_fo b m 30 a a x0
omega_gd_fo b m 30 a a x1
end
end
end
note The 8-way cross-warp sum of s[ai..ai+3] through shared 1600: v = pa, one shl 16, la shl 32.
fn omega_gd_cws b edit ulong 8192 m edit ulong 512 s view ulong 512 ai ulong v ulong to void
pa = and v 65535
one = and shr v 16 65535
la = shr v 32
pj = omega_gd_v m 1
b0 = omega_gd_v m 4
b1 = omega_gd_v m 4
if ne get m 4 0
ret
end
omega_gd_sts32 b m pa get s ai
for j ulong 3
omega_gd_imadi b m pj one mul 4 add j 1 pa
omega_gd_sts32 b m pj get s add ai add j 1
end
omega_gd_bar b m
for w ulong 4
omega_gd_lds128 b m b0 la add 1600 mul w 1024 1
omega_gd_lds128 b m b1 la add 2112 mul w 1024 0
omega_gd_cwj b m s ai or b0 shl b1 16 w
end
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Blackwell matmul layout decisions, exact CUDApp 22ebf8f unsigned semantics.
fn cg_fit r uint c uint n uint to bool
row = mul mul mul ulong sub r 1 16 ulong n 4
col = mul ulong sub c 1 32
ret lt add add row col 4 shl ulong 1 23
end
fn cg_tile n uint to uint
if eq rem n 4 0
ret 4
end
if eq rem n 2 0
ret 2
end
ret 1
end
fn cg_shape m uint n uint to uint
r = cg_tile m
c = uint 1
while gt r 1 bound 2
c = cg_tile n
if cg_fit r c mul n 8
break
end
r = div r 2
end
if eq r 1
c = 1
end
ret or r shl c 8
end
fn cg_bunr k uint r uint c uint to uint
ks = div k 16
if and eq rem ks 2 0 le mul add r c 2 8
ret 2
end
ret 1
end
fn cg_funr k uint to uint
ret cg_tile div k 16
end
fn cg_index rr uint cc uint to uint
lane = add mul and rr 7 4 shr and cc 7 1
base = add mul lane 8 mul shr cc 3 4
ret add add base mul shr rr 3 2 and cc 1
end
fn cg_matmul kind ulong a ulong b ulong c ulong to ulong
if eq kind 0
ret ulong cg_shape uint a uint b
end
if eq kind 1
ret ulong cg_bunr uint a uint b uint c
end
if eq kind 2
ret ulong cg_funr uint a
end
if eq kind 3
ret ulong cg_index uint a uint b
end
ret 0
end

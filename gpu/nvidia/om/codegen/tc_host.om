note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note TC host queries. All public u32 fields arrive widened without sign conversion.
note s: k rt ct warps mutant n aqn epi direct; unused slots zero.
fn tch_ok s view ulong 16 v2 bool to bool
k = get s 0
rt = get s 1
ct = get s 2
w = get s 3
mut = get s 4
if or lt k 128 ne rem k 128 0
ret false
end
if v2
if gt k 16384
ret false
end
if or and and ne rt 2 ne rt 4 ne rt 8 ne ct 2
ret false
end
if and and ne w 4 ne w 8 ne w 16
ret false
end
if and ne get s 6 1 ne get s 6 2
ret false
end
if or gt get s 7 1 gt get s 8 1
ret false
end
n = get s 5
if eq n 0
ret false
end
if ne rem n mul w 16 0
ret false
end
if ge mul n mul rt 64 8388608
ret false
end
else
if and and ne rt 1 ne rt 2 ne rt 4
ret false
end
if gt k 32768
ret false
end
if and and ne ct 1 ne ct 2 ne ct 4
ret false
end
if and and and ne w 1 ne w 2 ne w 4 ne w 8
ret false
end
end
if lt mul rt ct 4
ret false
end
if ne rem mul rt 128 mul w 32 0
ret false
end
if or gt mut 4 and eq mut 3 lt rt 2
ret false
end
ret true
end
fn tch_scale u ulong to ulong
sign = and u 2147483648
e = and shr u 23 255
f = and u 8388607
if eq e 255
ret u
end
if eq e 0
if eq f 0
ret u
end
e = 65
while lt f 8388608 bound 23
f = shl f 1
e = sub e 1
end
f = and f 8388607
else
e = add e 64
end
if ge e 255
ret or sign 2139095040
end
ret or or sign shl e 23 f
end
fn tch_bf u ulong to ulong
ret narrow tch_scale u 7 127 255
end
note Public dispatcher: 0/1/2 TC queries, 3/4/5 TC2 queries, 6 packed conversion, 7 weight.
fn tc_host op ulong s view ulong 16 to ulong
if eq op 6
ret or or tch_bf get s 0 shl tch_bf get s 2 16 or shl tch_bf get s 1 32 shl tch_bf get s 3 48
end
if eq op 7
ret or shl and get s 0 127 4 shl and get s 0 128 8
end
if gt op 5
ret 0
end
if not tch_ok s ge op 3
ret 0
end
if eq rem op 3 0
ret 1
end
if eq rem op 3 1
ret mul get s 1 4096
end
ret mul mul get s 3 8 get s 2
end

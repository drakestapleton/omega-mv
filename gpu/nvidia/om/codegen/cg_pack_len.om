note Fixed metadata consumes one native slot. Fields: kind,m,k,mp,kp,n,nt0,nt1,source bytes,destination ushort count,reserved,reserved.
note Kinds 0 A ushort, 1 row0 ushort, 2 B ushort, 3 A float bits, 4 row0 float bits.
fn cg_pklen p edit ulong 12 to long
for i ulong 8
if gt get p i 4294967295
ret long -1
end
end
kind = get p 0
if gt kind 4
ret long -1
end
k = get p 2
kp = get p 4
if or gt k kp ne and kp 15 0
ret long -1
end
width = ulong 2
if ge kind 3
width = ulong 4
end
sn = k
dn = mul kp 16
if or eq kind 0 eq kind 3
m = get p 1
mp = get p 3
if or gt m mp ne and mp 15 0
ret long -1
end
sn = mul m k
dn = mul mp kp
end
if eq kind 2
if lt get p 7 get p 6
ret long -1
end
sn = mul k get p 5
nj = sub get p 7 get p 6
if ne kp 0
if gt nj div div ulong 18446744073709551615 8 kp
ret long -1
end
end
dn = mul mul nj kp 8
end
if or gt sn div ulong 18446744073709551615 width gt dn div ulong 18446744073709551615 2
ret long -1
end
put p 8 mul sn width
put p 9 dn
ret long 0
end

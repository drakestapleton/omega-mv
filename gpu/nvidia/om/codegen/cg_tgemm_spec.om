note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Spec order is the public OmegaTgemmSpec field order, widened without truncation.
fn tg_spec_ok s view ulong 10 to ulong
if or lt get s 0 128 gt get s 0 65536
ret 0
end
if ne rem get s 0 128 0
ret 0
end
if and and ne get s 2 2 ne get s 2 4 ne get s 2 8
ret 0
end
if ne get s 3 2
ret 0
end
if and ne get s 4 8 ne get s 4 16
ret 0
end
if ne get s 5 32
ret 0
end
if and ne get s 6 1 ne get s 6 2
ret 0
end
if or ne get s 7 0 ne get s 8 0
ret 0
end
span = mul mul get s 4 8 get s 3
if or eq get s 1 0 ge get s 1 131072
ret 0
end
if ne rem get s 1 span 0
ret 0
end
t = mul 32 get s 4
if true
pieces = mul mul 16 get s 2 div get s 5 4
if ne rem pieces t 0
ret 0
end
rj = div t div get s 5 4
nj = div pieces t
if ne rem rj 16 0
ret 0
end
off = mul mul mul sub nj 1 rj get s 0 2
extra = sub div 128 get s 5 1
extra = mul extra get s 5
extra = mul extra 2
off = add off extra
if ge off 8388608
ret 0
end
end
shared = mul mul mul mul ulong 2 16 get s 2 get s 5 2
if gt shared 16384
ret 0
end
if gt mul 32 span shared
ret 0
end
if ne rem mul 8 span t 0
ret 0
end
if gt get s 9 5
ret 0
end
ret 1
end
fn cg_tgemm_spec s view ulong 10 kind ulong to ulong
if eq tg_spec_ok s 0
ret 0
end
if eq kind 0
ret 1
end
if eq kind 1
ret mul mul mul mul ulong 2 16 get s 2 get s 5 2
end
if eq kind 2
ret mul mul get s 4 8 get s 3
end
if eq kind 3
ret mul 16 get s 2
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Patch a single encoded instruction. Result zero untouched, one patched, two refused.
note Word constants transcribed from the existing qmma oracle; see codegen migration documentation.
fn cg_qmma_read p view uchar 16 off ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get p add off i mul i 8
end
ret v
end
fn cg_qmma_write p edit uchar 16 off ulong v ulong to void
for i ulong 4
put p add off i uchar and shr v mul i 8 255
end
end
fn cg_qmma_patch op ulong imm ulong p edit uchar 16 to ulong
if eq op 37
if ne imm 1178940467
ret 0
end
w0 = cg_qmma_read p 0
w1 = cg_qmma_read p 4
w2 = cg_qmma_read p 8
if ne and w0 65535 29193
ret 2
end
if ne and w1 4294967040 0
ret 2
end
if ne w2 125829120
ret 2
end
cg_qmma_write p 0 or and w0 4294901760 29246
cg_qmma_write p 8 75526399
ret 1
end
if ne op 16
ret 0
end
if ne imm 1362114610
ret 0
end
w0 = cg_qmma_read p 0
w1 = cg_qmma_read p 4
w2 = cg_qmma_read p 8
if ne and w0 65535 29244
ret 2
end
if ne and w1 4294967040 0
ret 2
end
if ne and w2 4294967040 268288
ret 2
end
cg_qmma_write p 0 or and w0 4294901760 29306
cg_qmma_write p 8 or and w2 255 11264
ret 1
end

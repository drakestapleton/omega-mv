note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Combine config cf[0..7]: h,top-k,unused,mutant,nquads,used.
fn ph_mc_meta cf view ulong 64 meta edit ulong 512 to void
nv = add add 9 mul 2 get cf 4 mul 2 get cf 1
put meta 1 nv
put meta 2 1
put meta 320 2
for v ulong nv
sz = ulong 1
if lt v 4
sz = ulong 2
end
if ge v 8
sz = ulong 4
if ge v add 9 mul 2 get cf 4
if eq rem sub v add 9 mul 2 get cf 4 2 1
sz = ulong 2
end
end
end
put meta add 64 v sz
end
end
fn ph_mc_head ins edit ulong 8192 st edit ulong 16 cf view ulong 64 to void
ph_imm ins st 7 0 856 4
ph_imm ins st 5 0 896 2
ph_imm ins st 5 1 904 2
ph_imm ins st 5 2 912 2
ph_imm ins st 5 3 920 2
ph_imm ins st 3 4 33 2
ph_imm ins st 3 5 37 2
ph_wide ins st 1 5 mul get cf 1 4 1
ph_wide ins st 2 5 mul get cf 1 4 2
for q ulong get cf 4
kind = ulong 3
if eq q 0
kind = ulong 2
end
ph_load ins st add 9 mul 2 q 1 mul 16 q kind
end
for q ulong get cf 4
ph_load ins st add 10 mul 2 q 2 mul 16 q 3
end
end
fn ph_mc_loads ins edit ulong 8192 st edit ulong 16 cf view ulong 64 to void
for s ulong get cf 1
ph_base st 8 6 add 9 mul 2 div s 4 PHNONE
put st 12 4
put st 14 div get cf 0 4
put st 15 shl rem s 4 24
ph_emit ins st 0
pa = add add 10 mul 2 get cf 4 mul 2 s
ph_wide ins st pa 6 16 0
end
for s ulong get cf 1
v = add add 9 mul 2 get cf 4 mul 2 s
kind = ulong 3
if eq s 0
kind = ulong 2
end
ph_load ins st v add v 1 0 kind
end
for q ulong 4
ph_base st 1 8 PHNONE PHNONE
put st 15 shl q 16
ph_emit ins st 0
end
end
fn ph_mc_math ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 to void
for s ulong get cf 5
v = add 9 mul 2 get cf 4
v = add v mul 2 s
for q ulong 4
put cf 8 8
put cf 9 q
put cf 10 7
put cf 11 add 10 mul 2 div s 4
put cf 12 v
put cf 13 rem s 4
put cf 14 q
ph_muladd ins st cf
end
end
end
fn ph_mc_body ins edit ulong 8192 st edit ulong 16 cf edit ulong 64 meta edit ulong 512 to void
ph_mc_head ins st cf
ph_mc_loads ins st cf
ph_mc_math ins st cf
ph_imad ins st 6 5 div get cf 0 4 4
ph_wide ins st 3 6 16 3
for q ulong 4
ph_base st 12 PHNONE 3 8
put st 15 shl q 32
put st 14 mul 4 q
put st 13 0
ph_emit ins st 5
end
ph_tail ins st
put meta 0 get st 0
end

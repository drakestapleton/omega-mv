note Seeded e5b32567. Tape ABI from omega_gpu_om_ir.h; scheduling mirrors omega_bw_em.h.
note st: count,pending,held; record scratch at 8..15. Helpers never retain per-record allocations.
const PHNONE ulong 18446744073709551615
fn ph_base st edit ulong 16 op ulong d ulong a ulong b ulong to void
put st 8 op
put st 9 d
put st 10 a
put st 11 b
put st 12 PHNONE
put st 13 PHNONE
put st 14 0
put st 15 0
end
fn ph_emit ins edit ulong 8192 st edit ulong 16 kind ulong to void
waits = get st 1
ctl = or or shl ulong 6 9 shl ulong 7 14 shl ulong 7 17
if eq kind 1
ctl = or or shl ulong 14 9 shl ulong 7 14 shl ulong 7 17
end
if or eq kind 2 eq kind 3
ctl = or or shl ulong 4 9 shl ulong 1 17 8192
end
if eq kind 3
waits = and waits 2
end
if eq kind 4
ctl = or or or shl ulong 4 9 shl ulong 2 14 shl ulong 7 17 8192
end
if eq kind 5
ctl = or or or shl ulong 4 9 shl ulong 7 14 shl ulong 1 17 8192
end
if eq kind 7
ctl = or or shl ulong 5 9 shl ulong 7 14 shl ulong 7 17
end
if eq kind 11
ctl = or or or shl ulong 4 9 shl ulong 3 14 shl ulong 1 17 8192
waits = and waits 2
end
ctl = or ctl shl waits 20
n = mul get st 0 8
for j ulong 8
put ins add n j get st add j 8
end
put ins add n 6 or get st 14 shl ctl 32
put st 0 add get st 0 1
if or eq kind 0 eq kind 1
put st 1 0
end
if eq kind 2
put st 1 3
end
if eq kind 3
put st 1 or get st 1 3
end
if eq kind 4
put st 1 4
end
if eq kind 5
put st 1 2
end
if eq kind 7
if eq and get st 15 2 0
put st 1 0
end
end
if eq kind 11
put st 1 or get st 1 2
put st 2 or get st 2 8
end
end
fn ph_imm ins edit ulong 8192 st edit ulong 16 op ulong d ulong imm ulong kind ulong to void
ph_base st op d PHNONE PHNONE
put st 14 imm
if eq op 7
put st 15 1
end
ph_emit ins st kind
end
fn ph_imad ins edit ulong 8192 st edit ulong 16 d ulong a ulong imm ulong c ulong to void
ph_base st 8 d a PHNONE
put st 12 c
put st 14 imm
ph_emit ins st 0
end
fn ph_wide ins edit ulong 8192 st edit ulong 16 d ulong a ulong imm ulong c ulong to void
ph_base st 9 d a PHNONE
put st 12 c
put st 14 imm
ph_emit ins st 0
end
fn ph_load ins edit ulong 8192 st edit ulong 16 d ulong a ulong imm ulong kind ulong to void
ph_base st 57 d a PHNONE
put st 13 0
put st 14 imm
ph_emit ins st kind
end
fn ph_consume st edit ulong 16 to void
put st 1 or get st 1 and get st 2 8
put st 2 and get st 2 not ulong 8
end
fn ph_tail ins edit ulong 8192 st edit ulong 16 to void
ph_imm ins st 45 PHNONE 0 7
ph_base st 46 PHNONE PHNONE PHNONE
ph_emit ins st 7
put ins sub mul get st 0 8 2 shl ulong 1032192 32
end
fn ph_branch ins edit ulong 8192 st edit ulong 16 target ulong to void
ph_base st 46 PHNONE PHNONE PHNONE
put st 14 and sub target get st 0 4294967295
put st 15 2
ph_emit ins st 7
end
note args: destination and source subregisters travel packed in flags scratch cfg[8..13].
fn ph_muladd ins edit ulong 8192 st edit ulong 16 cf view ulong 64 to void
ph_base st 32 get cf 10 get cf 11 get cf 12
put st 15 or shl get cf 13 24 shl get cf 14 32
if eq get cf 3 1
put st 8 33
put st 9 get cf 8
put st 12 get cf 8
put st 15 or get st 15 or shl get cf 9 16 shl get cf 9 40
ph_emit ins st 0
else
ph_emit ins st 0
ph_base st 30 get cf 8 get cf 8 get cf 10
put st 15 or shl get cf 9 16 shl get cf 9 24
ph_emit ins st 0
end
end

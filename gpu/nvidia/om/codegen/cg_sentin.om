om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q={m,n,np,set-as-uint32,poison-f32-bits}; one last-real word per 16x8 output tile.
note Public view transports uint bits for the native OM2 integer ABI; equality remains private f32 equality.
fn st_last tile ulong width ulong lim ulong to ulong
x = add mul tile width sub width 1
if ge x lim
ret sub lim 1
end
ret x
end
fn st_one q view ulong 5 c edit uint * idx ulong to ulong
poison = uint get q 4
if ne get q 3 0
put c idx poison
ret ulong 1
end
if eq bitcast f32 get c idx bitcast f32 poison
ret ulong 1
end
ret ulong 0
end
fn st_row q view ulong 5 c edit uint * ti ulong to ulong
row = st_last ti 16 get q 0
count = ulong 0
nt = div and add get q 1 7 4294967295 8
for tj ulong nt
col = st_last tj 8 get q 1
idx = add mul row get q 2 col
count = add count st_one q c idx
end
ret count
end
fn sentin q view ulong 5 c edit uint * to ulong
for i ulong 5
if gt get q i 4294967295
ret ulong 0
end
end
if gt get q 1 get q 2
ret ulong 0
end
if lt len c mul get q 0 get q 2
ret ulong 0
end
if or eq get q 0 0 eq get q 1 0
ret ulong 0
end
count = ulong 0
mt = div and add get q 0 15 4294967295 16
for ti ulong mt
count = add count st_row q c ti
end
ret count
end

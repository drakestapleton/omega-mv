note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note op 0 router admission, 1 router shared bytes, 2 MoE combine admission.
fn pf_admit op ulong k ulong e ulong t ulong m ulong to ulong
if gt m 2
ret 0
end
if eq op 2
if or lt k 128 gt k 4096
ret 0
end
if ne rem k 128 0
ret 0
end
if or lt e 4 gt e 16
ret 0
end
if ne rem e 4 0
ret 0
end
ret 1
end
if gt op 1
ret 0
end
if or lt k 128 gt k 16384
ret 0
end
if ne rem k 128 0
ret 0
end
if or lt e 32 gt e 1024
ret 0
end
if ne rem e 32 0
ret 0
end
if or lt t 1 gt t 16
ret 0
end
if ne rem t div e 32 0
ret 0
end
if gt mul mul add div k 4 1 e 16 2147483647
ret 0
end
if eq op 1
ret mul t 512
end
ret 1
end

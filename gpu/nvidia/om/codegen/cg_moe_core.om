fn moe_policy z view ulong 512 mode ulong to ulong
if eq mode ulong 1
ret ulong 1
end
if eq mode ulong 2
ret get z ulong 10
end
if eq get z ulong 9 ulong 2
n = mul get z ulong 0 ulong 4
if ne rem get z ulong 0 mul ulong 32 get z ulong 3 ulong 0
n = add n ulong 16
end
ret n
end
n = ulong 0
if ne get z ulong 4 ulong 0
n = add mul get z ulong 0 ulong 4 ulong 16
end
if ne get z ulong 6 ulong 0
n = add n mul mul mul ulong 2 get z ulong 3 get z ulong 2 ulong 4
end
ret n
end


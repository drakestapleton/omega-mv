note Shared checked spec policy, exact allocation order and input staging.
fn moe_w z view ulong 512 base ulong r ulong s ulong to ulong
ix = add base add mul r ulong 16 s
ret get z ix
end

fn moe_woff z view ulong 512 r ulong s ulong to ulong
v = mul mul s ulong 32 get z 1
ret add mul r get z 0 v
end

fn moe_ok1 z view ulong 512 to bool
if gt get z 8 ulong 5
ret false
end
if and ge get z 8 ulong 4 eq get z 6 ulong 0
ret false
end
if gt get z 5 ulong 1
ret false
end
if gt get z 6 ulong 1
ret false
end
if gt get z 7 ulong 1
ret false
end
if and ne get z 6 ulong 0 gt mul get z 3 get z 2 ulong 32
ret false
end
d = get z 4
if ne d ulong 0
if gt d ulong 16
ret false
end
ks = div get z 0 mul ulong 32 get z 1
if ne rem ks d ulong 0
ret false
end
if gt mul mul get z 2 d get z 1 ulong 128
ret false
end
if gt get z 0 mul ulong 512 get z 3
ret false
end
end
ret true
end

fn moe_ok z view ulong 512 to bool
k = get z ulong 0
lb = get z ulong 1
r = get z ulong 2
w = get z ulong 3
d = get z ulong 4
if and ne lb ulong 8 ne lb ulong 16
ret false
end
if and and ne r ulong 1 ne r ulong 2 and ne r ulong 4 ne r ulong 8
ret false
end
if or lt w ulong 1 gt w ulong 32
ret false
end
if or eq k ulong 0 gt k ulong 32768
ret false
end
if or ne rem k ulong 128 ulong 0 ne rem k mul ulong 32 lb ulong 0
ret false
end
if ge add mul sub r ulong 1 k lb ulong 8388608
ret false
end
ks = div k mul ulong 32 lb
if eq get z ulong 9 ulong 2
if or gt get z ulong 8 ulong 3 gt ks ulong 16
ret false
end
if or gt mul mul r ks lb ulong 128 gt k mul ulong 512 w
ret false
end
ret true
end
ret moe_ok1 z
end

fn moe_derive z edit ulong 512 to void
put z ulong 10 div get z ulong 0 mul ulong 32 get z ulong 1
put z ulong 11 div mul ulong 32 get z ulong 1 ulong 128
put z ulong 12 moe_log2 div ulong 128 get z ulong 1
put z ulong 13 moe_log2 div ulong 128 get z ulong 2
put z ulong 14 div get z ulong 1 ulong 4
put z ulong 16 get z ulong 4
if eq get z ulong 16 ulong 0
put z ulong 16 ulong 1
end
put z ulong 17 ulong 0
if ne get z ulong 4 ulong 0
put z ulong 17 ulong 1
end
put z ulong 15 ulong 56
if eq get z ulong 1 ulong 16
put z ulong 15 ulong 57
end
end

fn moe_loop m edit ulong 512 first ulong last ulong to void
n = get m 5
if ge n ulong 24
put m 4 ulong 1
ret
end
put m add ulong 16 mul n ulong 2 first
put m add ulong 17 mul n ulong 2 last
put m 5 add n ulong 1
end


fn moe_rnds z view ulong 512 to ulong
n = mul ulong 32 get z 3
k = add get z 0 sub n ulong 1
ret div k n
end

fn moe_part z view ulong 512 j ulong rounds ulong to bool
if ne j sub rounds ulong 1
ret false
end
n = mul ulong 32 get z 3
ret ne rem get z 0 n ulong 0
end


fn moe_build2 b edit ulong 8192 m edit ulong 512 z edit ulong 512 to void
x = new ulong 16 0
moe_i x ulong 28
put x ulong 2 get z ulong 86
put x ulong 3 get z ulong 36
moe_emit b m x ulong 1
none = get m 0
moe_i x ulong 46
put x ulong 9 ulong 1
put x ulong 6 ulong 1
moe_emit b m x ulong 8
moe_issue b m z
loop = get m 0
moe_take b m z
moe_i x ulong 28
put x ulong 2 get z ulong 86
put x ulong 3 get z ulong 36
moe_emit b m x ulong 1
skip = get m 0
moe_i x ulong 46
put x ulong 9 ulong 1
put x ulong 6 ulong 1
moe_emit b m x ulong 8
moe_issue b m z
moe_patch b skip get m 0
moe_cmp2 b m z
moe_red b m z
moe_i x ulong 9
put x ulong 1 get z ulong 60
put x ulong 2 get z ulong 87
put x ulong 6 mul get z ulong 2 ulong 4
put x ulong 4 get z ulong 52
moe_emit b m x ulong 0
moe_store b m z
moe_i x ulong 8
put x ulong 1 get z ulong 87
put x ulong 2 get z ulong 39
put x ulong 6 ulong 1
put x ulong 4 get z ulong 87
put x ulong 12 ulong 0
moe_emit b m x ulong 0

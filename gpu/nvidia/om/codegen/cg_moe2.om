fn omega_cg_moe2 k ulong a ulong q ulong c ulong b edit ulong 8192 m edit ulong 512 to ulong
z = new ulong 512 0
for i ulong 512
put m i ulong 0
end
moe_setup z k a q c ulong 2
if not moe_ok z
ret ulong 1
end
moe_derive z
mode = shr k ulong 32
if ne mode ulong 0
ret moe_policy z mode
end
moe_pal b m z
moe_pro b m z
moe_vars b m z
moe_stage b m z
moe_build2 b m z
moe_tail b m z
put m 1 get m 6
put m 2 get m 7
if ne get m 4 ulong 0
ret ulong 2
end
ret ulong 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shared emit helpers for the FP8 e4m3 block-scaled GEMV builders.
note Scratch x: op dst src1 src2 src3 ureg imm ctrl uni p0 pnot dsub s1sub s2sub s3sub bar.
note Meta: 0 count, 1 nv, 2 nu, 3 pending, 4 err, 5 nloops, 6 nextv, 7 nextu.
const NR ulong 18446744073709551615
const SBN ulong 7
const SBG ulong 0
const SBR ulong 1
const SBU ulong 2
const SBB ulong 3
const CYLD ulong 8192

fn moe_log2 n ulong to ulong
r = ulong 0
v = n
while gt v ulong 1
r = add r ulong 1
v = shr v ulong 1
end
ret r
end

fn moe_cw st ulong wb ulong rb ulong wt ulong yld ulong to ulong
w = shl st ulong 9
w = or w shl wb ulong 14
w = or w shl rb ulong 17
w = or w shl wt ulong 20
if eq yld ulong 1
w = or w CYLD
end
ret w
end

fn moe_alloc m edit ulong 512 kind ulong wide ulong to ulong
if eq wide ulong 1
n = get m 7
if ge n ulong 32
put m 4 ulong 1
ret NR
end
put m add ulong 320 n kind
put m 7 add n ulong 1
ret n
end
n = get m 6
if ge n ulong 256
put m 4 ulong 1
ret NR
end
put m add ulong 64 n kind
put m 6 add n ulong 1
ret n
end

fn moe_i x edit ulong 16 op ulong to void
for i ulong 16
put x i ulong 0
end
put x 0 op
for i ulong 5
put x add i ulong 1 NR
end
end

fn moe_pack b edit ulong 8192 x view ulong 16 n ulong to void
off = mul n ulong 8
for i ulong 6
put b add off i get x i
end
put b add off ulong 6 or get x ulong 6 shl get x ulong 7 ulong 32
fl = or get x ulong 8 or shl get x ulong 9 ulong 1 shl get x ulong 10 ulong 2
for i ulong 5
fl = or fl shl get x add i ulong 11 add ulong 16 mul i ulong 8
end
put b add off ulong 7 fl
end

fn moe_emit b edit ulong 8192 m edit ulong 512 x edit ulong 16 kind ulong to void
if eq get m 4 ulong 1
ret
end
pn = get m 3
cw = ulong 0
np = ulong 0
if eq kind ulong 0
cw = moe_cw ulong 6 SBN SBN pn ulong 0
end
if eq kind ulong 1
cw = moe_cw ulong 14 SBN SBN pn ulong 0
end
if eq kind ulong 2
cw = moe_cw ulong 4 SBG SBR pn ulong 1
np = or shl ulong 1 SBG shl ulong 1 SBR
end
if eq kind ulong 3
wt = and pn shl ulong 1 SBR
cw = moe_cw ulong 4 SBG SBR wt ulong 1
np = or pn or shl ulong 1 SBG shl ulong 1 SBR
end
if eq kind ulong 4
cw = moe_cw ulong 4 SBU SBN pn ulong 1
np = shl ulong 1 SBU
end
if eq kind ulong 5
cw = moe_cw ulong 4 SBN SBR pn ulong 1
np = shl ulong 1 SBR
end
if eq kind ulong 6
cw = moe_cw ulong 6 SBN SBN pn ulong 0
end
if eq kind ulong 7
cw = moe_cw ulong 5 SBN SBN pn ulong 0
if eq get x ulong 9 ulong 1
np = pn
end
end
if eq kind ulong 8
cw = moe_cw ulong 5 SBN SBN pn ulong 0
if eq get x ulong 9 ulong 1
np = pn
end
end
if eq kind ulong 9
cw = moe_cw ulong 1 SBN SBN pn ulong 1
end
if eq kind ulong 10
cw = moe_cw ulong 5 SBN SBN pn ulong 1
end
if eq kind ulong 11
cw = moe_cw ulong 4 SBB SBR pn ulong 1
np = shl ulong 1 SBR
end
if eq kind ulong 12
wt = and pn shl ulong 1 SBR
cw = moe_cw ulong 4 SBB SBR wt ulong 1
np = shl ulong 1 SBR
end
if eq kind ulong 13
cw = moe_cw ulong 6 SBN SBN or pn shl ulong 1 SBB ulong 0
end
put x ulong 7 cw
put m 3 np
n = get m 0
if ge n ulong 1024
put m 4 ulong 1
ret
end
moe_pack b x n
put m 0 add n ulong 1
end

fn moe_patch b edit ulong 8192 at ulong tgt ulong to void
off = add mul at ulong 8 ulong 6
imm = and sub tgt at ulong 4294967295
ctrl = shr get b off ulong 32
put b off or imm shl ctrl ulong 32
end


st = 5
if ne get x 9 0
pn = wt
end
end
if eq k 9
st = 1
yld = 8192
end
if eq k 10
st = 5
yld = 8192
end
put x 7 or omega_cg_tern_cw st wb rb wt yld
put m 3 pn
n = get m 0
if ge n 1024
put m 4 2
ret
end
omega_cg_tern_pack b x n
put m 0 add n 1
end
fn omega_cg_tern_pack b edit ulong 8192 x view ulong 16 n ulong to void
off = mul n 8
for i ulong 6
put b add off i get x i
end
put b add off 6 or and get x 6 4294967295 shl get x 7 32
fl = or get x 8 or shl get x 9 1 shl get x 10 2
for i ulong 5
fl = or fl shl get x add i 11 add 16 mul i 8
end
put b add off 7 fl
end


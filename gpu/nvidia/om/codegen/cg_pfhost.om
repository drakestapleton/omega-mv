note kind 0 router: a=k,b=e,c=t|(mutant<<32); kind 1 combine: a=h,b=top-k,c=mutant.
note All configuration decisions, allocation shapes, loops, instruction fields and scheduling are Omega.
fn ph_rl_valid cf view ulong 64 to bool
if or lt get cf 0 128 gt get cf 0 16384
ret false
end
if ne rem get cf 0 128 0
ret false
end
if or lt get cf 1 32 gt get cf 1 1024
ret false
end
if ne rem get cf 1 32 0
ret false
end
if or lt get cf 2 1 gt get cf 2 16
ret false
end
if ne rem get cf 2 div get cf 1 32 0
ret false
end
if gt mul mul add div get cf 0 4 1 get cf 1 16 2147483647
ret false
end
ret le get cf 3 2
end
fn cg_pfhost kind ulong a ulong b ulong c ulong ins edit ulong 8192 meta edit ulong 512 to int
st = new ulong 16 0
cf = new ulong 64 0
put cf 0 a
put cf 1 b
if eq kind 0
put cf 2 and c 4294967295
put cf 3 shr c 32
if not ph_rl_valid cf
ret 1
end
put cf 4 div b 32
put cf 5 div get cf 2 get cf 4
put cf 6 div a 128
put cf 7 mul b 16
if eq get cf 3 2
put cf 6 sub get cf 6 1
end
if eq get cf 6 0
ret 1
end
ph_rl_meta cf meta
ph_rl_body ins st cf meta
ret 0
end
if eq kind 1
if or lt a 128 gt a 4096
ret 1
end
if ne rem a 128 0
ret 1
end
if or lt b 4 gt b 16
ret 1
end
if or ne rem b 4 0 gt c 2
ret 1
end
put cf 3 c
put cf 4 div b 4
put cf 5 b
if eq c 2
put cf 5 sub b 1
end
ph_mc_meta cf meta
ph_mc_body ins st cf meta
ret 0
end
ret 1
end

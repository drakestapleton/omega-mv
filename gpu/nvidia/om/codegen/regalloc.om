om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Exact core allocator successor of CUDApp 22ebf8f, not the validating component allocator.
note Wire long4096: nv,nu,limit,peakG,peakU; records16+10*v for GPR0..255/UGPR256..287.
note Record: vreg,first,last,physical,bundle,pair,quad,active,map,reserved.
fn ra_get m view ulong 4096 b ulong to long
ret bitcast long get m b
end
fn ra_put m edit ulong 4096 b ulong v long to void
put m b bitcast ulong v
end
fn ra_width m view ulong 4096 b ulong to long
w = ra_get m add b 4
if ne w 0
ret w
end
if ne ra_get m add b 5 0
ret 2
end
if ne ra_get m add b 6 0
ret 4
end
ret 1
end
fn ra_after m view ulong 4096 a ulong b ulong to bool
ai = add mul a 10 17
bi = add mul b 10 17
ret gt ra_get m ai ra_get m bi
end
fn ra_sort m view ulong 4096 order edit ulong 256 count ulong to void
for i ulong count
for j ulong count
if gt j i
a = get order i
b = get order j
if ra_after m a b
put order i b
put order j a
end
end
end
end
end
fn ra_clear m view ulong 4096 busy edit uchar 246 b ulong lim long to void
p = ra_get m add b 3
if and ge p 0 lt p lim
w = ra_width m b
for k long w
if lt add p k lim
put busy ulong add p k 0
end
end
end
end
fn ra_free m edit ulong 4096 busy edit uchar 246 first long lim long to void
for v ulong ulong ra_get m 0
b = add mul v 10 16
if ne ra_get m add b 7 0
if lt ra_get m add b 2 first
ra_clear m busy b lim
ra_put m add b 7 0
end
end
end
end
fn ra_find busy edit uchar 246 w long lim long to long
step = long 1
start = long 2
if eq w 4
step = 4
start = 4
else
if eq w 2
step = 2
end
end
p = start
while le p sub lim step bound 246
ok = true
for k long step
if ne get busy ulong add p k 0
ok = false
end
end
if ok
for k long step
put busy ulong add p k 1
end
ret p
end
p = add p step
end
ret -1
end
fn ra_gprs m edit ulong 4096 lim long to long
order = new ulong 256 0
busy = new uchar 246 0
count = ulong 0
peak = long 2
for v ulong ulong ra_get m 0
b = add mul v 10 16
if ge ra_get m add b 1 0
put order count v
count = add count 1
else
ra_put m add b 3 2
ra_put m add b 8 2
end
end
ra_sort m order count
for i ulong count
v = get order i
b = add mul v 10 16
ra_free m busy ra_get m add b 1 lim
w = ra_width m b
p = ra_find busy w lim
if lt p 0
ret -1
end
ra_put m add b 3 p
ra_put m add b 7 1
ra_put m add b 8 p
top = sub add p w 1
if gt top peak
peak = top
end
end
ra_put m 3 add peak 1
ret 0
end
fn ra_solve m edit ulong 4096 to long
lim = ra_get m 2
if eq lim 0
lim = 128
end
note A caller-provided limit beyond the busy array was C undefined behavior. Refuse it.
if or lt lim 0 gt lim 246
ret -1
end
if or lt ra_get m 0 0 gt ra_get m 0 256
ret -1
end
if or lt ra_get m 1 0 gt ra_get m 1 32
ret -1
end
rc = ra_gprs m lim
if ne rc 0
ret rc
end
cur = long 4
for uv ulong ulong ra_get m 1
b = add mul add uv 256 10 16
if ne ra_get m add b 5 0
if ne rem cur 2 0
cur = add cur 1
end
if ge add cur 1 32
ret -1
end
ra_put m add b 3 cur
ra_put m add b 8 cur
cur = add cur 2
else
if ge cur 32
ret -1
end
ra_put m add b 3 cur
ra_put m add b 8 cur
cur = add cur 1
end
end
ra_put m 4 cur
ret 0
end
fn ra_run m edit ulong 4096 to long
ret ra_solve m
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Emitter for the DEC builder, eight-word IR wire ABI of omega_gpu_om_ir.h.
note Infrastructure (av ob os rf rb imm ctl arg cw finish patch lopen lclose) follows cg_attn_emit.om.
note Operand words: vreg or (vreg | subreg << 32); ALL is NOREG. m[3] holds the uniform descriptor register.
const ALL ulong 18446744073709551615
fn av m edit ulong 512 k ulong u ulong to ulong
v = get m add 1 u
if or and eq u 0 ge v 256 and ne u 0 ge v 32
put m 4 1
ret 0
end
put m add 1 u add v 1
if eq u 0
put m add 64 v k
else
put m add 320 v k
end
ret v
end
fn ob v ulong to ulong
if eq and v 4294967295 4294967295
ret ALL
end
ret and v 4294967295
end
fn os v ulong to ulong
if eq v ALL
ret 0
end
ret shr v 32
end
fn rf x edit ulong 8192 m view ulong 512 f ulong v ulong to void
if ge get m 0 1024
ret
end
put x add mul get m 0 8 f v
end
fn rb x edit ulong 8192 m view ulong 512 op ulong to void
rf x m 0 op
rf x m 1 ALL
rf x m 2 ALL
rf x m 3 ALL
rf x m 4 ALL
rf x m 5 ALL
rf x m 6 0
rf x m 7 0
end
fn imm x edit ulong 8192 m view ulong 512 v ulong to void
rf x m 6 and v 4294967295
end
fn ctl x edit ulong 8192 m view ulong 512 v ulong to void
if ge get m 0 1024
ret
end
p = mul get m 0 8
put x add p 6 or and get x add p 6 4294967295 shl v 32
end
fn arg x edit ulong 8192 m view ulong 512 f ulong v ulong to void
if ge get m 0 1024
ret
end
rf x m f ob v
p = add mul get m 0 8 7
sh = add mul sub f 1 8 16
put x p or get x p shl os v sh
end
fn cw stall ulong wb ulong rd ulong wt ulong to ulong
ret or or shl stall 9 shl wb 14 or shl rd 17 shl wt 20
end
note k: 0 FIXED 1 PRED 2 VAR 3 VAR_MORE 4 UVAR 5 STORE 6 SYNC 7 EXIT 8 BRA 9 BSSY 10 BSYNC
fn finish x edit ulong 8192 m edit ulong 512 k ulong to void
if ge get m 0 1024
put m 4 1
ret
end
wt = get m 7
cc = cw 6 7 7 wt
nx = ulong 0
if eq k 1
cc = cw 14 7 7 wt
end
if or eq k 2 eq k 3
if eq k 3
wt = and wt 2
end
cc = or cw 4 0 1 wt 8192
nx = ulong 3
if eq k 3
nx = or get m 7 3
end
end
if eq k 4
cc = or cw 4 2 7 wt 8192
nx = ulong 4
end
if eq k 5
cc = or cw 4 7 1 wt 8192
nx = ulong 2
end
if or eq k 7 eq k 8
cc = cw 5 7 7 wt
if ne and get x add mul get m 0 8 7 2 0
nx = wt
end
end
if eq k 9
cc = or cw 1 7 7 wt 8192
end
if eq k 10
cc = or cw 5 7 7 wt 8192
end
ctl x m cc
put m 7 nx
put m 0 add get m 0 1
end
fn patch x edit ulong 8192 at ulong target ulong to void
if ge at 1024
ret
end
p = add mul at 8 6
put x p or and get x p 18446744069414584320 and sub target at 4294967295
end
fn lopen m edit ulong 512 to void
d = get m 9
if ge d 4
put m 4 1
ret
end
put m add 10 d get m 0
put m 9 add d 1
end
fn lclose m edit ulong 512 to void
if eq get m 9 0
put m 4 1
ret
end
d = sub get m 9 1
put m 9 d
n = get m 5
put m add 16 mul n 2 get m add 10 d
put m add 17 mul n 2 sub get m 0 1
put m 5 add n 1
end
fn pk v ulong sb ulong to ulong
ret or and v 4294967295 shl sb 32
end
fn nv m edit ulong 512 to ulong
ret av m 1 0
end
fn nv64 m edit ulong 512 to ulong
ret av m 2 0
end
fn nv128 m edit ulong 512 to ulong
ret av m 4 0
end
fn nu64 m edit ulong 512 to ulong
ret av m 2 1
end
fn e_ldcu x edit ulong 8192 m edit ulong 512 d ulong o ulong to void
rb x m 7
arg x m 1 d
imm x m o
rf x m 7 1
finish x m 4
end
fn e_ldc64 x edit ulong 8192 m edit ulong 512 d ulong o ulong to void
rb x m 5
arg x m 1 d
imm x m o
finish x m 2
end
fn e_ldc32 x edit ulong 8192 m edit ulong 512 d ulong o ulong to void
rb x m 4
arg x m 1 d
imm x m o
finish x m 2
end
fn e_s2r x edit ulong 8192 m edit ulong 512 d ulong sr ulong to void
rb x m 3
arg x m 1 d
imm x m sr
finish x m 2
end
fn e_movi x edit ulong 8192 m edit ulong 512 d ulong v ulong to void
rb x m 2
arg x m 1 d
imm x m v
finish x m 0
end
fn e_movrz x edit ulong 8192 m edit ulong 512 d ulong to void
rb x m 1
arg x m 1 d
finish x m 0
end
fn e_imadi x edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong c ulong to void
rb x m 8
arg x m 1 d
arg x m 2 a
imm x m v
arg x m 4 c
finish x m 0
end
fn e_imadr x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong c ulong to void
rb x m 8
arg x m 1 d
arg x m 2 a
arg x m 3 b
arg x m 4 c
finish x m 0
end
fn e_imadw x edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong c ulong to void
rb x m 9
arg x m 1 d
arg x m 2 a
imm x m v
arg x m 4 c
finish x m 0
end
fn e_mov x edit ulong 8192 m edit ulong 512 d ulong a ulong to void
e_imadi x m d a 1 ALL
end
fn e_shr x edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong to void
rb x m 17
arg x m 1 d
arg x m 2 a
imm x m v
finish x m 0
end
fn e_andi x edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong to void
rb x m 18
arg x m 1 d
arg x m 2 a
imm x m v
finish x m 0
end
fn e_xorr x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
rb x m 29
arg x m 1 d
arg x m 2 a
arg x m 3 b
finish x m 0
end
fn e_lop3 x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong lut ulong to void
rb x m 51
arg x m 1 d
arg x m 2 a
arg x m 3 b
imm x m lut
finish x m 0
end
fn e_ldg x edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong v ulong to void
rb x m op
arg x m 1 d
arg x m 2 a
imm x m v
rf x m 5 get m 3
finish x m 2
end
fn e_ldgm x edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong v ulong to void
rb x m op
arg x m 1 d
arg x m 2 a
imm x m v
rf x m 5 get m 3
finish x m 3
end
fn e_stg x edit ulong 8192 m edit ulong 512 a ulong v ulong to void
rb x m 12
arg x m 2 a
arg x m 3 v
rf x m 5 get m 3
finish x m 5
end
fn e_lds128 x edit ulong 8192 m edit ulong 512 d ulong a ulong v ulong f ulong to void
rb x m 58
arg x m 1 d
arg x m 2 a
imm x m v
if ne f 0
finish x m 2
else
finish x m 3
end
end
fn e_lds32 x edit ulong 8192 m edit ulong 512 d ulong a ulong to void
rb x m 49
arg x m 1 d
arg x m 2 a
finish x m 2
end
fn e_sts32 x edit ulong 8192 m edit ulong 512 a ulong v ulong to void
rb x m 50
arg x m 2 a
arg x m 3 v
finish x m 5
end
fn e_bar x edit ulong 8192 m edit ulong 512 to void
rb x m 48
finish x m 6
end
note op 30 FADD, 32 FMUL, 36 FMNMX_MIN, 37 FMNMX_MAX
fn e_fop x edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong b ulong to void
rb x m op
arg x m 1 d
arg x m 2 a
arg x m 3 b
finish x m 0
end
fn e_ffma x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong c ulong to void
rb x m 33
arg x m 1 d
arg x m 2 a
arg x m 3 b
arg x m 4 c
finish x m 0
end
note op 40 MUFU_RCP, 41 MUFU_RSQ, 47 MUFU_EX2
fn e_mufu x edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong to void
rb x m op
arg x m 1 d
arg x m 2 a
finish x m 2
end
fn e_shfl x edit ulong 8192 m edit ulong 512 d ulong a ulong o ulong to void
rb x m 42
arg x m 1 d
arg x m 2 a
imm x m o
finish x m 2
end
fn e_isetp x edit ulong 8192 m edit ulong 512 a ulong b ulong to void
rb x m 28
arg x m 2 a
arg x m 3 b
finish x m 1
end
fn e_bra x edit ulong 8192 m edit ulong 512 t ulong to void
at = get m 0
rb x m 46
imm x m sub t at
finish x m 8
end
fn e_brafwd x edit ulong 8192 m edit ulong 512 to ulong
at = get m 0
rb x m 46
imm x m 1
rf x m 7 2
finish x m 8
ret at
end
note region_skip_if_p0: BSSY then the predicated BRA; returns the BSSY index (the BRA is the next record)
fn e_rgn x edit ulong 8192 m edit ulong 512 to ulong
at = get m 0
rb x m 54
imm x m 2
finish x m 9
b = e_brafwd x m
if ne b add at 1
put m 4 1
end
ret at
end
fn e_rend x edit ulong 8192 m edit ulong 512 r ulong to void
at = get m 0
rb x m 55
finish x m 10
patch x add r 1 at
patch x r add at 1
end
fn e_tail x edit ulong 8192 m edit ulong 512 to void
if ge get m 0 1024
put m 4 1
ret
end
rb x m 45
finish x m 7
if ge get m 0 1024
put m 4 1
ret
end
rb x m 46
ctl x m 1032192
put m 0 add get m 0 1
end

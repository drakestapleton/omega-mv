note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Exact public ternary spec policy, including the independent 16384-byte staging cap.
fn omega_ct_valid k ulong l ulong r ulong w ulong d ulong em ulong to ulong
if or eq k 0 gt k 16384
ret 0
end
if ne rem k 256 0
ret 0
end
n = div add k 8191 8192
if ne rem k mul 256 n 0
ret 0
end
if eq l 0
if and ne r 1 and ne r 2 ne r 4
ret 0
end
else
if or ne l 1 and ne r 2 ne r 4
ret 0
end
end
if or eq w 0 gt w 32
ret 0
end
if or eq d 0 gt d 16
ret 0
end
if ne rem div div k n 256 d 0
ret 0
end
if gt mul r d 16
ret 0
end
if gt and em 4294967295 1
ret 0
end
if and eq and em 4294967295 1 ne n 1
ret 0
end
if gt shr em 32 6
ret 0
end
ret 1
end
fn omega_ct_coal k ulong r ulong w ulong to ulong
if ne div add k 8191 8192 1
ret 0
end
if gt mul mul 2 r w 32
ret 0
end
if gt add mul k 2 mul mul 16 r w 16384
ret 0
end
ret 1
end

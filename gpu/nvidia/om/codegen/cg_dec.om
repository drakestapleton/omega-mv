ret 2
end
e_ldcu x m get m 3 856
e_ldc64 x m get s KP0 896
e_ldc64 x m get s KP1 904
e_ldc32 x m get s KSCALE 912
e_s2r x m get s KTID 33
e_s2r x m get s KCX 37
e_s2r x m get s KCY 38
e_imadi x m get s KC1 get s KCX 256 get s KTID
e_imadi x m get s KGI get s KCY and mul 2 iw MASK32 get s KC1
e_imadi x m get s KAI get s KCY iw get s KC1
cv = iw
if eq get s 3 1
cv = sub iw 1
end
e_movi x m get s KCST cv
e_imadi x m get s KUI get s KCST 1 get s KGI
e_imadw x m get s KGA get s KGI 4 get s KP0
e_imadw x m get s KUA get s KUI 4 get s KP0
e_imadw x m get s KAA get s KAI 4 get s KP1
e_ldg x m 11 get s KGV get s KGA 0
e_ldgm x m 11 get s KUV get s KUA 0
t = get s KT
e_movi x m get s KCST 3216550459
e_fop x m 32 t get s KGV get s KCST
e_mufu x m 47 t t
e_movi x m get s KCST 1065353216
e_fop x m 30 t t get s KCST
e_mufu x m 40 t t
e_fop x m 32 t get s KGV t
e_fop x m 32 t t get s KUV
e_fop x m 32 t t get s KSCALE
e_stg x m get s KAA t
e_tail x m
ret 0
end

note ---- GATE ----
fn gate_rw x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
n = get s KN
if ne and get s 1 1 0
put s KCY nv m
put s KRO nv m
if ne get m 4 0
ret
end
cy = get s KCY
ro = get s KRO
e_s2r x m cy 38

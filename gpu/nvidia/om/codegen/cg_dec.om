note ---- composite emit helpers (C ne_of, warp_*, lane0_sts, cta_reduce8, ldg_quads, new_quads) ----
fn qe s edit ulong 256 b ulong i ulong to ulong
ret pk get s add b div i 4 rem i 4
end
fn ne_of x edit ulong 8192 m edit ulong 512 s edit ulong 256 nd ulong a ulong b ulong to void
t = get s KT
t2 = get s KT2
e_xorr x m t a b
e_imadi x m t2 t 4294967295 ALL
e_lop3 x m t t t2 252
e_shr x m nd t 31
end
fn wred x edit ulong 8192 m edit ulong 512 op ulong v ulong t ulong to void
o = ulong 16
while gt o 0 bound 5
e_shfl x m t v o
e_fop x m op v v t
o = div o 2
end
end
fn l0sts x edit ulong 8192 m edit ulong 512 lane ulong one ulong a ulong v ulong to void
e_isetp x m lane one
r = e_rgn x m
e_sts32 x m a v
e_rend x m r
end
fn cred x edit ulong 8192 m edit ulong 512 s edit ulong 256 d ulong base ulong op ulong to void
q0 = nv128 m
q1 = nv128 m
if ne get m 4 0
ret
end
a0 = get s KA0
e_movi x m a0 base
e_lds128 x m q0 a0 0 1
e_lds128 x m q1 a0 16 0
e_mov x m d pk q0 0
for i ulong 8
if gt i 0
sl = pk q1 sub i 4
if lt i 4
sl = pk q0 i
end
e_fop x m op d d sl
end
end
end
fn ldq x edit ulong 8192 m edit ulong 512 s edit ulong 256 qb ulong n ulong a ulong to void
for k ulong n
if eq k 0
e_ldg x m 57 get s add qb k a mul 16 k
else
e_ldgm x m 57 get s add qb k a mul 16 k
end
end
end
fn newq m edit ulong 512 s edit ulong 256 qb ulong n ulong to void
for k ulong n
put s add qb k nv128 m
end
end
fn lt_u x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
e_imadi x m d b 4294967295 a
e_shr x m d d 31
end
fn andf x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
e_imadi x m d a 1 b
e_shr x m d d 1
end
fn stgat x edit ulong 8192 m edit ulong 512 s edit ulong 256 oa ulong o ulong v ulong to void
ta = get s KTA
e_imadw x m ta get s KONE o oa
e_stg x m ta v
end
note ---- AXPY ----
fn g_axpy x edit ulong 8192 m edit ulong 512 s edit ulong 256 to ulong
st = get s 2
if or eq st 0 ne rem st 256 0
ret 1
end
put m 3 nu64 m
put s KP0 nv64 m
put s KP1 nv64 m
put s KITERS nv m
put s KTID nv m
put s KCX nv m
put s KGID nv m
put s KIT nv m
put s KONE nv m
put s KXA nv64 m
put s KAA nv64 m
put s KXV nv m
put s KAV nv m
if ne get m 4 0
ret 2
end
e_ldcu x m get m 3 856
e_ldc64 x m get s KP0 896
e_ldc64 x m get s KP1 904
e_ldc32 x m get s KITERS 912
e_s2r x m get s KTID 33
e_s2r x m get s KCX 37
e_imadi x m get s KGID get s KCX 256 get s KTID
e_imadw x m get s KXA get s KGID 4 get s KP0
e_imadw x m get s KAA get s KGID 4 get s KP1
e_movrz x m get s KIT
e_movi x m get s KONE 1
lp = get m 0
lopen m
e_isetp x m get s KIT get s KITERS
dn = e_brafwd x m
e_ldg x m 11 get s KXV get s KXA 0
e_ldgm x m 11 get s KAV get s KAA 0
e_fop x m 30 get s KXV get s KXV get s KAV
e_stg x m get s KXA get s KXV
st4 = and mul st 4 MASK32
e_imadw x m get s KXA get s KONE st4 get s KXA
e_imadw x m get s KAA get s KONE st4 get s KAA
e_imadi x m get s KIT get s KONE 1 get s KIT
e_bra x m lp
lclose m
patch x dn get m 0
e_tail x m
ret 0
end
note ---- RES ----
fn res_ok s edit ulong 256 to bool
md = get s 1
h = get s 4
if eq h 0
h = ulong 2048
end
n = div h 256
put s KRH h
put s KRN n
put s KRQ div n 4
if or eq and md 7 0 gt md 15
ret false
end
if and ne and md 1 0 ne and md 2 0
ret false
end
if and ne and md 8 0 ne and md 2 0
st = get s 2
if or eq st 0 ne rem st 16 0
ret false
end
end
gr = get s 5
if and ne gr 0 and ne gr 8 ne gr 9
ret false
end
if and eq gr 9 eq and md 2 0
ret false
end
if and eq get s 3 3 ne gr 9
ret false
end
if or ne rem h 1024 0 gt n 32
ret false
end
if and ne and md 2 0 ne h 2048
ret false
end
ret true
end
fn res_a x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
put m 3 nu64 m
put s KP0 nv64 m
put s KP1 nv64 m
put s KP2 nv64 m
put s KP3 nv64 m
put s KP4 nv64 m
put s KEPS nv m
put s KSCALE nv m
put s KTID nv m
put s KWARP nv m
put s KLANE nv m
put s KONE nv m
put s KTOFF nv m
put s KT nv m
put s KT2 nv m
put s KA0 nv m
put s KXA nv64 m
newq m s KXQ get s KRQ
if ne get m 4 0
ret
end
e_ldcu x m get m 3 856
e_ldc64 x m get s KP0 896
e_ldc64 x m get s KP1 904
e_ldc64 x m get s KP2 912
e_ldc64 x m get s KP3 920
e_ldc64 x m get s KP4 928
e_ldc32 x m get s KEPS 936
e_ldc32 x m get s KSCALE 940
e_s2r x m get s KTID 33
e_movi x m get s KONE 1
e_shr x m get s KWARP get s KTID 5
e_andi x m get s KLANE get s KTID 31
e_imadi x m get s KTOFF get s KTID mul 4 get s KRN ALL
put s KROFF get s KTOFF
if ne and get s 1 8 0
put s KCY nv m
put s KROFF nv m
if ne get m 4 0
ret
end
e_s2r x m get s KCY 38
e_imadi x m get s KROFF get s KCY and mul 4 get s KRH MASK32 get s KTOFF
end
e_imadw x m get s KXA get s KROFF 1 get s KP0
ldq x m s KXQ get s KRQ get s KXA
end
fn res_add x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
put s KAA nv64 m
newq m s KAQ get s KRQ
if ne get m 4 0
ret
end
e_imadw x m get s KAA get s KROFF 1 get s KP1
ldq x m s KAQ get s KRQ get s KAA
n = get s KRN
for i ulong n
xi = qe s KXQ i
e_fop x m 30 xi xi qe s KAQ i
end
end
fn res_mac x edit ulong 8192 m edit ulong 512 s edit ulong 256 w ulong g ulong to void
for i ulong 8
d = qe s KDQ i
mi = get s add KMV i
if eq g 0
e_fop x m 32 mi w d
else
e_fop x m 32 get s KT w d
e_fop x m 30 mi mi get s KT
end
end
end
fn res_comb x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
gr = get s 5
if eq gr 0
gr = ulong 8
end
put s KWQ nv128 m
put s add KWQ 1 nv128 m
if gt gr 8
put s KWQ8 nv m
end
put s KDA nv64 m
put s KDQ nv128 m
put s add KDQ 1 nv128 m
for i ulong 8
put s add KMV i nv m
end
if ne get m 4 0
ret
end
put s KPWR get s KP2
put s KDOFF get s KTOFF
if ne and get s 1 8 0
put s KPWR nv64 m
put s KDOFF nv m
if ne get m 4 0
ret
end
e_imadw x m get s KPWR get s KCY get s 2 get s KP2
e_imadi x m get s KDOFF get s KCY mul gr 8192 get s KTOFF
end
e_ldg x m 57 get s KWQ get s KPWR 0
e_ldgm x m 57 get s add KWQ 1 get s KPWR 16
if gt gr 8
put s KPW8 nv64 m
if ne get m 4 0
ret
end
e_imadw x m get s KPW8 get s KONE 32 get s KPWR
e_ldgm x m 11 get s KWQ8 get s KPW8 0
end
e_imadw x m get s KDA get s KDOFF 1 get s KP1
g = gr
mu = get s 3
if eq mu 2
g = ulong 7
end
if eq mu 3
g = ulong 8
end
for k ulong g
e_ldg x m 57 get s KDQ get s KDA mul k 8192
e_ldgm x m 57 get s add KDQ 1 get s KDA add mul k 8192 16
w = get s KWQ8
if lt k 8
w = qe s KWQ k
end
res_mac x m s w k
end
for i ulong 8
xi = qe s KXQ i
e_fop x m 30 xi xi get s add KMV i
end
end
fn res_st x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
put s KSA nv64 m
if ne get m 4 0
ret
end
sa = get s KSA
n = get s KRN
for i ulong n
if eq i 0
e_imadw x m sa get s KROFF 1 get s KP0
else
e_imadw x m sa get s KONE 4 sa
end
e_stg x m sa qe s KXQ i
end
end
fn res_inv h ulong to ulong
if eq h 2048
ret 973078528
end
ret ulong bitcast uint div 1.0f32 f32 h
end
fn res_norm x edit ulong 8192 m edit ulong 512 s edit ulong 256 to void
put s KSQ nv m
put s KRS nv m
put s KNA nv64 m
newq m s KNQ get s KRQ
put s KYA nv64 m
put s KYV nv m
if ne get m 4 0
ret
end
sq = get s KSQ
e_imadw x m get s KNA get s KTOFF 1 get s KP3
ldq x m s KNQ get s KRQ get s KNA
x0 = qe s KXQ 0
e_fop x m 32 sq x0 x0
n = get s KRN
for i ulong n
if gt i 0
xi = qe s KXQ i
e_ffma x m sq xi xi sq
end
end
wred x m 30 sq get s KT
a0 = get s KA0
e_imadi x m a0 get s KWARP 4 ALL
e_imadi x m a0 get s KONE 0 a0
l0sts x m get s KLANE get s KONE a0 sq
e_bar x m
cred x m s sq 0 30
e_movi x m get s KT2 res_inv get s KRH
rs = get s KRS
e_ffma x m rs sq get s KT2 get s KEPS
e_mufu x m 41 rs rs
ya = get s KYA
yv = get s KYV
e_imadw x m ya get s KROFF 1 get s KP4
for i ulong n
e_fop x m 32 yv qe s KXQ i rs
if ne get s 3 1
e_fop x m 32 yv yv qe s KNQ i
end
e_fop x m 32 yv yv get s KSCALE
if gt i 0
e_imadw x m ya get s KONE 4 ya
end
e_stg x m ya yv
end
end
fn g_res x edit ulong 8192 m edit ulong 512 s edit ulong 256 to ulong
if not res_ok s
ret 1
end
res_a x m s
md = get s 1
if ne and md 1 0
res_add x m s
end
if ne and md 2 0
res_comb x m s
end
if ne and md 3 0
res_st x m s
end
if ne and md 4 0
res_norm x m s
end
e_tail x m
ret 0
end

e_rend x m r
end
fn g_argmax x edit ulong 8192 m edit ulong 512 s edit ulong 256 to ulong
ix = eq get s 1 1
jn = ulong 8
if eq get s 3 1
jn = ulong 7
end
am_a x m s ix
if ne get m 4 0
ret 2
end
am_b x m s jn
am_c x m s jn ix
e_tail x m
ret 0
end

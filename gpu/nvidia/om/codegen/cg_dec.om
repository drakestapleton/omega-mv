fn g_group x edit ulong 8192 m edit ulong 512 s edit ulong 256 to ulong
sl = get s 5
if eq sl 0
sl = ulong 8
end
if or lt sl 1 gt sl 16
ret 1
end
if or ne get s 1 0 or ne get s 4 0 ne get s 2 0
ret 1
end
mg = div sub add 65536 sl 1 sl
if ge sub mul mg sl 65536 256
ret 1
end
gr_a x m s sl mg
if ne get m 4 0
ret 2
end
gr_b x m s
gr_p1 x m s
gr_p2 x m s
gr_c x m s
e_tail x m
ret 0
end
note ---- entry ----
fn cg_dec kind ulong a ulong b ulong c ulong x edit ulong 8192 m edit ulong 512 to int
if or gt kind MASK32 gt c MASK32
ret 1
end
s = new ulong 256 0
put s 0 kind
put s 1 and a MASK32
put s 4 shr a 32
put s 2 and b MASK32
put s 5 shr b 32
put s 3 c
rc = ulong 1
if eq kind 1
rc = g_axpy x m s
end
if eq kind 2
rc = g_res x m s
end
if eq kind 3
rc = g_swiglu x m s
end
if eq kind 4
rc = g_argmax x m s
end
if eq kind 5
rc = g_gather x m s
end
if eq kind 6
rc = g_gate x m s
end
if eq kind 7
rc = g_group x m s
end
if eq kind 8
rc = g_xbound x m s
end
if eq rc 1
ret 1
end
if or ne rc 0 ne get m 4 0
ret 2
end
if ne get m 9 0
ret 2
end
ret 0
end

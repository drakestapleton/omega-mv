fn am_c x edit ulong 8192 m edit ulong 512 s edit ulong 256 jn ulong ix bool to void
idx = get s KIDX
best = get s KBEST
for j ulong jn
if ix
e_mov x m idx qe s KIQ j
else
e_imadi x m idx get s KGID 8 ALL
e_imadi x m idx get s KONE j idx
end
e_lop3 x m idx idx get s KC23 252
ne_of x m s get s KNE qe s KVQ j get s KMX
e_imadi x m get s KCAND get s KNE 805306368 idx

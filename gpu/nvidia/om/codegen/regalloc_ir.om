note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure scalar decisions shared by hosted and allocation-free IR shells.
fn ra_ir kind ulong a long b long to long
if eq kind 0
if ge a b
ret -1
end
ret a
end
if eq kind 1
if lt a 0
ret b
end
ret a
end
if eq kind 2
if gt b a
ret b
end
ret a
end
if eq kind 3
if and ge a 0 lt a b
ret 1
end
ret 0
end
if eq kind 4
if or eq a 6 eq a 7
ret 1
end
ret 0
end
if eq kind 5
if lt a 1024
ret 1
end
ret 0
end
if eq kind 6
ret long mul div add uint a 9 8 8
end
if eq kind 7
if and eq rem uint a 8 0 ge uint a add uint b 2
ret 1
end
ret 0
end
if eq kind 8
if and gt a 128 le a 246
ret 1
end
ret 0
end
ret -1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Query 0 valid, 1 chunks, 2 steps, 3 coalesced, 4 output slot, 5 shared, 6 packed-word offset.
fn omega_ct_offset l ulong r ulong k ulong row ulong c ulong to ulong
kw = div k 16
if eq l 0
ret mul add mul row kw c 4
end
rr = mul 2 r
blk = div row rr
j = rem row rr
off = mul mul mul blk rr kw 4
off = add off mul mul c rr 4
ret add off mul j 4
end
fn omega_ct_derived q ulong k ulong r ulong w ulong to ulong
if eq q 2
ret div k 256
end
co = omega_ct_coal k r w
if eq q 3
ret co
end
n = div add k 8191 8192
xb = mul div k n 2
slots = mul mul 16 r w
ret add xb mul co slots
end
fn cg_tern_policy q ulong k ulong a ulong b ulong c ulong d ulong to ulong
if eq q 6
ret omega_ct_offset k a b c d
end
if eq q 1
if eq k 0
ret 0
end
ret div and add k 8191 4294967295 8192
end
if eq q 4
ret and mul mul mul 2 shr a 32 and b 4294967295 4 4294967295
end
l = and a 4294967295
r = shr a 32
w = and b 4294967295
dep = shr b 32
ok = omega_ct_valid k l r w dep c
if eq q 0
ret ok
end
if eq ok 0
ret 0
end
ret omega_ct_derived q k r w
end

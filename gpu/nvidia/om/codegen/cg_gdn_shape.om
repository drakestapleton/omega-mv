note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note GDN shape (omega_gdn_shape), shared by the builder unit cg_gdn and the policy unit cg_gdn_policy.
fn omega_gd_pick c bool a ulong b ulong to ulong
if c
ret a
end
ret b
end
note The shape: ratio 0 means 3; 1..3 are valid; 0 returned for an invalid ratio.
fn omega_gd_rr ra ulong to ulong
r = ra
if eq r 0
r = 3
end
if or lt r 1 gt r 3
ret 0
end
ret r
end
note Queries: 0 valid 1 r 2 vh 3 vdim 4 conv 5 par_scal 6 par_norm 7 par_bytes 8 tail_bytes 9 state_bytes 10 post_grid_y.
fn omega_gd_shq q ulong ra ulong bf ulong to ulong
r = omega_gd_rr ra
if eq r 0
ret 0
end
if eq q 0
ret 1
end
vh = mul 16 r
vdim = mul 128 vh
conv = add 4096 vdim
ps = mul 16 conv
pn = add ps mul 8 vh
if eq q 1
ret r
end
if eq q 2
ret vh
end
if eq q 3
ret vdim
end
if eq q 4
ret conv
end
if eq q 5
ret ps
end
if eq q 6
ret pn
end
if eq q 7
ret add pn 512
end
if eq q 8
ret mul 6144 vh
end
if eq q 9
ret mul omega_gd_pick ne bf 0 32768 65536 vh
end
if eq q 10
ret div vh 8
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Refuse nonrepresentable controls before packing; no invalid input may alias a valid tile.
fn cg_par grid ulong u ulong r ulong c ulong mutant long to ulong
if or gt u 15 gt r 15
ret 18446744073709551615
end
if gt c 15
ret 18446744073709551615
end
p = or grid shl u 32
p = or p shl r 36
p = or p shl c 40
if ne mutant 0
p = or p shl ulong 1 44
end
ret p
end

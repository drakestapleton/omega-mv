fn cg_bool b bool to ulong
if b
ret ulong 1
end
ret ulong 0
end
fn cg_sel b bool x ulong y ulong to ulong
if b
ret x
end
ret y
end
fn cg_fit r ulong c ulong n ulong to ulong
row = mul mul sub r ulong 1 ulong 16 mul n ulong 4
col = mul sub c ulong 1 ulong 32
ret cg_bool lt add add row col ulong 4 shl ulong 1 ulong 23
end
fn cg_alloc m edit ulong 512 v edit ulong 1024 w ulong u ulong to ulong
s = ulong 1
base = ulong 64
if ne u ulong 0
s = ulong 2
base = ulong 320
end
n = get m s
put m add base n w
put m s add n ulong 1
ret n
end
fn cg_mark v edit ulong 1024 r ulong ix ulong nv ulong to void
if lt r nv
if eq get v add ulong 512 r ulong 18446744073709551615
put v add ulong 512 r ix
end
put v add ulong 768 r ix
end
end
fn cg_touch i view ulong 8192 m view ulong 512 v edit ulong 1024 to void
b = get v ulong 500
op = get i b
if not or eq op ulong 6 eq op ulong 7
cg_mark v get i add b ulong 1 get m ulong 0 get m ulong 1
end
cg_mark v get i add b ulong 2 get m ulong 0 get m ulong 1
cg_mark v get i add b ulong 3 get m ulong 0 get m ulong 1
cg_mark v get i add b ulong 4 get m ulong 0 get m ulong 1
end
fn cg_live v edit ulong 1024 r ulong ix ulong to void
if lt get v add ulong 768 r ix
put v add ulong 768 r ix
end
end
fn cg_keep m view ulong 512 v edit ulong 1024 a ulong b ulong e ulong to void
r = ulong 0
while lt r get m ulong 1 bound 256
f = get v add ulong 512 r
if and ge f a lt f b
cg_live v r e
end
r = add r ulong 1
end
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note life[2*v] is first_def, life[2*v+1] is last_use (signed C interval indices).
note Extending after replay is equivalent to extending at each closing BRA: a later use already dominates that end.
fn cl_u2l x ulong to long
if lt x 9223372036854775808
ret long x
end
ret sub long -1 long xor x 18446744073709551615
end
fn cl_i32 x ulong to long
x = and x 4294967295
if lt x 2147483648
ret long x
end
ret sub long -1 long xor x 4294967295
end
fn lifext life edit ulong 512 n ulong s long e long to void
for v ulong n
b = mul v 2
fd = cl_u2l get life b
lu = cl_u2l get life add b 1
if and ge fd 0 and lt fd s and ge lu s lt lu e
put life add b 1 ulong e
end
end
end
fn lifhint life edit ulong 512 n ulong v ulong h ulong to ulong
if eq h 0
ret 0
end
b = mul v 2
fd = cl_u2l get life b
lu = cl_u2l get life add b 1
if lt fd 0
ret 10
end
if or lt h ulong fd or lt h ulong lu ge h n
ret 10
end
put life add b 1 h
ret 0
end
fn cg_life meta view ulong 512 life edit ulong 512 to ulong
for l ulong get meta 5
s = cl_i32 get meta add 16 mul l 2
e = cl_i32 get meta add 17 mul l 2
lifext life get meta 1 s e
end
if eq get meta 7 0
ret 0
end
for v ulong get meta 1
if ne lifhint life get meta 0 v get meta add 352 v 0
ret 10
end
end
ret 0
end

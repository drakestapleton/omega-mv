om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note q={m,n,np}; preserve forward row order. The portable ABI refuses overlapping source/destination views.
fn mr_row q view ulong 3 s view f32 * d edit f32 * r ulong to void
for c ulong get q 1
si = add mul r get q 2 c
di = add mul r get q 1 c
put d di get s si
end
end
fn mrow q view ulong 3 s view f32 * d edit f32 * to long
if gt get q 1 get q 2
ret long -1
end
for i ulong 3
if gt get q i 4294967295
ret long -1
end
end
if lt len s mul get q 0 get q 2
ret long -1
end
if lt len d mul get q 0 get q 1
ret long -1
end
for r ulong get q 0
mr_row q s d r
end
ret long 0
end

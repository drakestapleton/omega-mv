note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note MatMul spec, realization binding, dispatch and program-size policy; exact successor of CUDApp 22ebf8f
note omega_blackwell_matmul.c, omega_blackwell_realize.c, the omega_blackwell_codegen.c program sizing and the
note omega_blackwell_encoder.c digest admission. The C shell owns memory, SHA-256 calls and the structs.
note cg_bind kind a b w, result long, -1 refused unless a kind says otherwise:
note 0 spec: a = m | k << 32, b = n | precision << 32; writes the 16 spec bytes to w, returns 16.
note 1 bound: w[128..224) holds spec_id, machine_id, code_digest; a = sm arch; writes the 100-byte
note message to w[0..100), returns 100. 2 machine: writes the 27 descriptor bytes, returns 27.
note 3 dispatch: a = precision bits; 0 int32 generator, 1 tensor generator, -1 none.
note 4 vector: a = element count (uint32); returns grid | threads_per_block << 32.
note 5 pad: a = instruction count; returns the padded code bytes (ulong bits, wrapping as size_t).
note 6 fit: a = count, b = capacity; returns the code bytes, or -2 when the capacity is short.
note 7 digest: a = length; 0 admitted, -1 empty. 8 insns: a = code bytes; returns a / 16. 9 arch: 121.
note w is uchar 256: the 100-byte bound message at 0, its inputs at 128..224.
note Portable two's-complement reinterpretation; the bridge lowers no integer-to-integer bitcast.
fn cb_u2l x ulong to long
if lt x ulong 9223372036854775808
ret long x
end
ret sub long -1 long xor x ulong 18446744073709551615
end
fn cb_le32 w edit uchar 256 o ulong v ulong to void
put w o uchar and v 255
put w add o 1 uchar and shr v 8 255
put w add o 2 uchar and shr v 16 255
put w add o 3 uchar and shr v 24 255
end
fn cb_spec a ulong b ulong w edit uchar 256 to long
m = and a 4294967295
k = shr a 32
n = and b 4294967295
p = shr b 32
if or or eq m 0 eq k 0 eq n 0
ret long -1
end
if or or gt m 8192 gt k 16384 gt n 262144
ret long -1
end
cb_le32 w 0 m
cb_le32 w 4 k
cb_le32 w 8 n
cb_le32 w 12 and p 255
ret long 16
end
fn cb_bound a ulong w edit uchar 256 to long
for i ulong 96
put w i get w add 128 i
end
cb_le32 w 96 and a 4294967295
ret long 100
end
fn cb_mach w edit uchar 256 to long
cb_le32 w 0 1145656910
cb_le32 w 4 1147093321
cb_le32 w 8 1398757447
cb_le32 w 12 1263681872
cb_le32 w 16 826427231
cb_le32 w 20 1297309488
put w 24 uchar 49
put w 25 uchar 50
put w 26 uchar 49
ret long 27
end
fn cb_disp a ulong to long
p = and a 4294967295
if eq p 0
ret long 0
end
if or eq p 1 eq p 2
ret long 1
end
ret long -1
end
fn cb_vec a ulong to long
c = uint and a 4294967295
g = div add c uint 63 uint 64
if eq g uint 0
g = uint 1
end
ret long or ulong g shl ulong 64 32
end
fn cb_pad a ulong to ulong
p = and add a 7 xor ulong 7 ulong 18446744073709551615
if lt p 32
p = ulong 32
end
ret mul p 16
end
fn cb_fit a ulong b ulong to long
need = cb_pad a
if lt b need
ret long -2
end
ret cb_u2l need
end
fn cg_bind kind ulong a ulong b ulong w edit uchar 256 to long
if eq kind 0
ret cb_spec a b w
end
if eq kind 1
ret cb_bound a w
end
if eq kind 2
ret cb_mach w
end
if eq kind 3
ret cb_disp a
end
if eq kind 4
ret cb_vec a
end
if eq kind 5
ret cb_u2l cb_pad a
end
if eq kind 6
ret cb_fit a b
end
if eq kind 7
if eq a 0
ret long -1
end
ret long 0
end
if eq kind 8
ret long div a 16
end
if eq kind 9
ret long 121
end
ret long -1
end

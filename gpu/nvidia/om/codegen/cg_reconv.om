note Source-derived ordered steps from omega_bw_reconv.h. C owns structs and dereferences.
note Failed joins retain the already-decremented depth and any already-patched immediate.
fn rc_g w view ulong 8 i ulong to long
u = get w i
v = long u
if ge u 2147483648
v = sub v 4294967296
end
ret v
end
fn rc_u v long to ulong
if lt v 0
ret ulong add v 4294967296
end
ret ulong v
end
fn cg_reconv act ulong w edit ulong 8 to long
if eq act 0
if lt rc_g w 0 16
ret rc_g w 0
end
ret -1
end
if eq act 1
if or ge rc_g w 0 16 lt rc_g w 3 0
ret -1
end
d = rc_g w 0
put w 0 rc_u add d 1
put w 2 rc_u add rc_g w 2 1
if gt rc_g w 0 rc_g w 1
put w 1 get w 0
end
ret d
end
if eq act 2
if or le rc_g w 0 0 lt rc_g w 1 0
ret -1
end
ret sub rc_g w 0 1
end
if eq act 3
if ge rc_g w 0 8
ret -1
end
n = rc_g w 0
put w 0 rc_u add n 1
ret n
end
if eq act 4
if or le rc_g w 0 0 eq rc_g w 3 0
ret -1
end
if lt rc_g w 1 0
ret -1
end
if ge ulong rc_g w 1 get w 2
ret -1
end
put w 0 rc_u sub rc_g w 0 1
ret rc_g w 0
end
if eq act 5
if or lt rc_g w 0 0 ge rc_g w 0 rc_g w 1
ret -1
end
if or ne rc_g w 2 54 ne rc_g w 3 55
ret -1
end
if or ne rc_g w 4 rc_g w 6 ne rc_g w 5 rc_g w 6
ret -1
end
ret sub add rc_g w 1 1 rc_g w 0
end
if eq act 6
if or le rc_g w 0 rc_g w 1 ge rc_g w 0 rc_g w 2
ret -1
end
if ne rc_g w 3 46
ret -1
end
ret sub rc_g w 2 rc_g w 0
end
ret -1
end

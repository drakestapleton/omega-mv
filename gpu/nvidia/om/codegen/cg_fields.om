note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ABI raw slots: op,dst,src1,src2,src3,ureg,imm,control,uniform,p0,not,bar,dsub,s1sub,s2sub,s3sub.
note kind 0 packs encoder records (bar at bit 8); kind 1 unpacks emitter records (bar at bit 48).
note kind 2 converts sixteen little-endian instruction bytes in raw to four u32 words.
fn cg_fields kind ulong raw edit ulong 16 rec edit ulong 8 to ulong
if eq kind 0
for i ulong 6
put rec i get raw i
end
put rec 6 or get raw 6 shl get raw 7 32
f = or get raw 8 shl get raw 9 1
f = or f shl get raw 10 2
f = or f shl get raw 11 8
for i ulong 4
f = or f shl get raw add i 12 add 16 mul i 8
end
put rec 7 f
ret 0
end
if eq kind 1
for i ulong 6
put raw i get rec i
end
put raw 6 and get rec 6 4294967295
put raw 7 shr get rec 6 32
f = get rec 7
put raw 8 and f 1
put raw 9 and shr f 1 1
put raw 10 and shr f 2 1
put raw 11 and shr f 48 255
for i ulong 4
put raw add i 12 and shr f add 16 mul i 8 255
end
ret 0
end
if eq kind 2
for i ulong 4
b = mul i 4
w = or get raw b shl get raw add b 1 8
w = or w shl get raw add b 2 16
w = or w shl get raw add b 3 24
put raw i w
end
ret 0
end
ret 4
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Declared GPR launch budget. Zero result refuses budget; all-ones refuses zero threads.
fn cg_budget peak ulong decl ulong threads ulong to ulong
if eq threads 0
ret 18446744073709551615
end
if lt decl 64
decl = ulong 64
end
if or gt peak 128 or ne rem decl 8 0 lt decl add peak 2
ret 0
end
if gt mul decl threads 65536
ret 0
end
ret decl
end

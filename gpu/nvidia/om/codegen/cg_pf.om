note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Successor of omega_blackwell_codegen_pf.c. Command tape, 4 ulongs per record.
note out[0] status, out[1] count. alloc kind in a: 1 uv64, 2 v64, 3 v, 4 v128.

fn push out edit ulong 256 cmd ulong a ulong b ulong c ulong to int
n = get out 1
base = add mul n 4 2
if gt base 250
ret -1
end
put out base cmd
put out add base 1 a
put out add base 2 b
put out add base 3 c
nxt = add n 1
put out 1 nxt
ret 0
end

fn cg_pf_copy unused ulong out edit ulong 256 mutant ulong pad2 ulong to int
put out 0 1
put out 1 0
rc = push out 1 1 0 0
if ne rc 0
ret 2
end
rc = push out 1 2 0 0
if ne rc 0
ret 2
end
rc = push out 1 2 1 0
if ne rc 0
ret 2
end
rc = push out 1 3 2 0
if ne rc 0
ret 2
end
rc = push out 1 3 3 0
if ne rc 0
ret 2
end
rc = push out 1 3 4 0
if ne rc 0
ret 2
end
rc = push out 1 3 5 0
if ne rc 0
ret 2
end
rc = push out 1 4 6 0
if ne rc 0
ret 2
end
rc = push out 10 0 856 0
if ne rc 0
ret 2
end
rc = push out 11 0 896 0
if ne rc 0
ret 2
end
rc = push out 11 1 904 0
if ne rc 0
ret 2
end
rc = push out 12 2 912 0
if ne rc 0
ret 2
end
rc = push out 13 3 33 0
if ne rc 0
ret 2
end
rc = push out 13 4 37 0
if ne rc 0
ret 2
end
rc = push out 14 5 262148 256
if ne rc 0
ret 2
end
rc = push out 15 5 2 0
if ne rc 0
ret 2
end
rc = push out 16 0 0 0
if ne rc 0
ret 2
end
rc = push out 17 1 5 16
if ne rc 0
ret 2
end
rc = push out 17 0 5 16
if ne rc 0
ret 2
end
rc = push out 18 6 1 0
if ne rc 0
ret 2
end
rc = push out 19 0 6 0
if ne rc 0
ret 2
end
rc = push out 19 0 6 1
if ne rc 0
ret 2
end
rc = push out 19 0 6 2
if ne rc 0
ret 2
end
rc = push out 19 0 6 3
if ne rc 0
ret 2
end
rc = push out 20 0 0 0
if ne rc 0
ret 2
end
if eq mutant 1
n = get out 1
put out 1 sub n 2
end
put out 0 0
ret 0
end

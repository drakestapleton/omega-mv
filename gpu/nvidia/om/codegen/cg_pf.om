note Record is 8 words: op, dst, src1, src2, src3, ureg, imm | control << 32, flags.
note c is 0 for the byte oracle and 1 for the mutant (the closing EXIT and BRA are dropped).
note Words are the C builder's emit() output (omega_blackwell_codegen_pf_copy_prog_c), not a recomputed schedule.

const ALL ulong 18446744073709551615

fn w ins edit ulong 8192 i ulong v ulong to void
put ins i v
end

fn opw ins edit ulong 8192 n ulong op ulong to void
w ins mul n 8 op
end

fn dst ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 1 v
end

fn s1 ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 2 v
end

fn s2 ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 3 v
end

fn s3 ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 4 v
end

fn uv ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 5 v
end

fn pk ins edit ulong 8192 n ulong imm ulong ctl ulong to void
w ins add mul n 8 6 or imm shl ctl 32
end

fn fl ins edit ulong 8192 n ulong v ulong to void
w ins add mul n 8 7 v
end

fn z ins edit ulong 8192 n ulong to void
s1 ins n ALL
s2 ins n ALL
s3 ins n ALL
uv ins n ALL
fl ins n 0
end


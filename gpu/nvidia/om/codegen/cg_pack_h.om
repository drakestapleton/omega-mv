om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Fragment packing, including f32-to-bf16, uses one pass and no staging allocation.
note p is a fixed 12-word meta view (one native slot); s,d are unsized (two slots each): total five.
note p: kind,m,k,mp,kp,n,nt0,nt1,source bytes,destination ushort count,reserved,reserved.
note The byte source is the little-endian wire used by CUDApp's supported hosts.
note WolframLanguageEvaluator: FromDigits[#,16]& /@ {"ffffffff","fffffff","ffffffffffffff"} -> {4294967295,268435455,72057594037927935}.
fn ph_ld s view uchar * pos ulong wid ulong to ulong
x = or ulong get s pos shl ulong get s add pos 1 8
if eq wid 2
ret x
end
x = or x shl ulong get s add pos 2 16
x = or x shl ulong get s add pos 3 24
if and eq and x 2139095040 2139095040 ne and x 8388607 0
ret or shr x 16 64
end
ret and shr and add add x 32767 and shr x 16 1 4294967295 16 65535
end
fn ph_cb cc ulong to ulong
ret add add mul shr and cc 7 1 8 mul shr cc 3 4 and cc 1
end
fn ph_rb rr ulong to ulong
ret add mul and rr 7 32 mul shr rr 3 2
end
fn ph_zero d edit ushort * n ulong to void
for b ulong add div n 65536 1
for i ulong 65536
x = add mul b 65536 i
if ge x n
ret
end
put d x ushort 0
end
end
end
fn ph_min16 a ulong b ulong to ulong
r = sub a b
if lt r 16
ret r
end
ret ulong 16
end
fn ph_row job view ulong 4 s view uchar * d edit ushort * to void
wid = ulong 2
if ge get job 3 3
wid = ulong 4
end
for cc ulong get job 2
v = ph_ld s mul add get job 1 cc wid wid
put d add get job 0 ph_cb cc ushort v
end
end
fn ph_src p view ulong 12 mt ulong rr ulong ks ulong to ulong
r = add mul mt 16 rr
ret add mul r get p 2 mul ks 16
end
fn ph_bo p view ulong 12 mt ulong ks ulong to ulong
ret mul add mul mt div get p 4 16 ks 256
end
fn ph_one p view ulong 12 s view uchar * d edit ushort * x ulong to void
job = new ulong 4 0
mt = and x 268435455
ks = and shr x 28 268435455
rr = shr x 56
a1 = ph_bo p mt ks
a1 = add a1 ph_rb rr
c1 = ph_min16 get p 2 mul ks 16
put job 0 a1
put job 1 ph_src p mt rr ks
put job 2 c1
put job 3 get p 0
ph_row job s d
end
fn ph_blk p view ulong 12 s view uchar * d edit ushort * x ulong to void
for rr ulong ph_min16 get p 1 mul and x 268435455 16
ph_one p s d or x shl rr 56
end
end
fn ph_a p view ulong 12 s view uchar * d edit ushort * to long
ph_zero d get p 9
nm = div add get p 1 15 16
nk = div add get p 2 15 16
for mt ulong nm
for ks ulong nk
ph_blk p s d or mt shl ks 28
end
end
ret long 0
end
fn ph_z16 d edit ushort * blk ulong c1 ulong to void
for cc ulong 16
if ge cc c1
put d add blk ph_cb cc ushort 0
end
end
end
fn ph_r0 p view ulong 12 s view uchar * d edit ushort * to long
job = new ulong 4 0
for ks ulong div get p 4 16
c0 = mul ks 16
c1 = ulong 0
if lt c0 get p 2
c1 = ph_min16 get p 2 c0
end
blk = mul ks 256
put job 0 blk
put job 1 c0
put job 2 c1
put job 3 get p 0
ph_row job s d
ph_z16 d blk c1
end
ret long 0
end
fn ph_mask c0 ulong n ulong to ulong
mk = ulong 0
for g ulong 8
if lt and add c0 g 4294967295 n
mk = or mk shl ulong 1 g
end
end
ret mk
end
fn ph_bd p view ulong 12 row ulong j ulong to ulong
rr = and row 15
o = mul add mul j div get p 4 16 shr row 4 128
o = add o add mul shr rr 3 2 and rr 1
ret add o mul shr and rr 7 1 4
end
fn ph_bg job view ulong 3 s view uchar * d edit ushort * to void
for g ulong 8
if ne and shr get job 1 g 1 0
v = ph_ld s mul add get job 2 g 2 2
put d add get job 0 mul g 16 ushort v
end
end
end
fn ph_bj p view ulong 12 s view uchar * d edit ushort * x ulong to void
job = new ulong 3 0
row = and x 4294967295
j = shr x 32
c0 = and mul add get p 6 j 8 4294967295
put job 0 ph_bd p row j
put job 1 ph_mask c0 get p 5
put job 2 add mul row get p 5 c0
ph_bg job s d
end
fn ph_b p view ulong 12 s view uchar * d edit ushort * to long
nj = sub get p 7 get p 6
ph_zero d get p 9
for row ulong get p 2
for j ulong nj
ph_bj p s d or row shl j 32
end
end
ret long 0
end
fn cg_pkh p view ulong 12 s view uchar * d edit ushort * to long
if or lt len s get p 8 lt len d get p 9
ret long -1
end
kind = get p 0
if or eq kind 0 eq kind 3
ret ph_a p s d
end
if or eq kind 1 eq kind 4
ret ph_r0 p s d
end
if eq kind 2
ret ph_b p s d
end
ret long -1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note No value first defined in a closed loop may be read afterward before its next nonuniform definition.
fn invread ins view ulong 8192 b ulong v ulong to bool
ret or eq get ins add b 2 v or eq get ins add b 3 v eq get ins add b 4 v
end
fn invwrite ins view ulong 8192 b ulong v ulong to bool
ret and eq get ins add b 1 v eq and get ins add b 7 1 0
end
fn invreg ins view ulong 8192 v ulong e ulong n ulong to bool
for i ulong n
if le i e
continue
end
b = mul i 8
if invread ins b v
ret false
end
if invwrite ins b v
ret true
end
end
ret true
end
fn iv_u2l x ulong to long
if lt x 9223372036854775808
ret long x
end
ret sub long -1 long xor x 18446744073709551615
end
fn iv_i32 x ulong to long
x = and x 4294967295
if lt x 2147483648
ret long x
end
ret sub long -1 long xor x 4294967295
end
fn invbound meta view ulong 512 l ulong to ulong
ret or and get meta add 16 mul l 2 4294967295 shl get meta add 17 mul l 2 32
end
fn invloop ins view ulong 8192 life view ulong 512 a ulong b ulong to bool
s = iv_i32 b
e = shr b 32
for v ulong shr a 32
fd = iv_u2l get life mul v 2
if and ge fd s le fd long e
if not invreg ins v e and a 4294967295
ret false
end
end
end
ret true
end
fn cg_invar ins view ulong 8192 meta view ulong 512 life view ulong 512 to ulong
a = or get meta 0 shl get meta 1 32
for l ulong get meta 5
if not invloop ins life a invbound meta l
ret 6
end
end
ret 0
end

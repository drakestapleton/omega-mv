note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Reuse existing QMMA record packing and scheduling, no new instruction encoder.
fn qm_self kind ulong a ulong c ulong d ulong b edit ulong 8192 m edit ulong 512 to ulong
x = new ulong 16 0
for i ulong 512
put m i 0
end
put m 2 1
put m 320 2
v = omega_cg_qmma_v m 2
v = omega_cg_qmma_v m 4
v = omega_cg_qmma_v m 2
v = omega_cg_qmma_v m 4
omega_cg_qmma_i x 7
put x 1 0
put x 6 856
put x 8 1
omega_cg_qmma_emit b m x 4
omega_cg_qmma_i x 5
put x 1 0
put x 6 896
omega_cg_qmma_emit b m x 2
for i ulong 3
omega_cg_qmma_i x 57
put x 1 add i 1
put x 2 0
put x 5 0
put x 6 mul i 16
k = ulong 3
if eq i 0
k = 2
end
if eq i 1
put x 0 56
end
omega_cg_qmma_emit b m x k
end
omega_cg_qmma_i x 16
put x 1 3
put x 2 1
put x 3 2
put x 4 3
put x 6 1362114610
put x 7 15
omega_cg_qmma_emit b m x 11
omega_cg_qmma_i x 0
put x 7 15
omega_cg_qmma_emit b m x 11
v = omega_cg_qmma_v m 1
omega_cg_qmma_i x 37
put x 1 v
put x 2 3
put x 3 3
put x 13 1
put x 6 1178940467
omega_cg_qmma_emit b m x 0
omega_cg_qmma_i x 12
put x 2 0
put x 3 v
put x 5 0
put x 6 64
omega_cg_qmma_emit b m x 5
omega_cg_qmma_i x 16
put x 1 3
put x 2 1
put x 3 2
put x 4 3
put x 7 15
omega_cg_qmma_emit b m x 11
omega_cg_qmma_i x 0
put x 7 15
omega_cg_qmma_emit b m x 11
for i ulong 4
omega_cg_qmma_i x 12
put x 2 0
put x 3 3
put x 5 0
put x 6 mul i 4
omega_cg_qmma_emit b m x 5
end
omega_cg_qmma_i x 45
omega_cg_qmma_emit b m x 7
omega_cg_qmma_i x 46
put x 7 1032192
omega_cg_qmma_pack b x get m 0
put m 0 add get m 0 1
ret get m 4
end

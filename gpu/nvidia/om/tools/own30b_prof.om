note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note own30b_prof: OWN-30B decode profile recorder decisions and dump text (tools/own30b_decode_profile.c).
note The C wrap stays C: it reads the clock, calls the real launch and writes stderr. This unit owns the
note launch classifier, the 48 x 6 + head sequence check, the token table and the dump lines.
note State st (ulong 155712): 0 used, 1 dropped, 2 armed, 3 invalid, 4 last_end, 5 classify bytes out.
note pending token at 8, tokens t at 64 + 38 t; in a token, row s field f at 5 s + f (f 0 calls, 1 bytes,
note 2 session_ns, 3 submit_wait_ns, 4 gap_before_ns), 35 end_ns, 36 start_ns, 37 pos.
note Stages: 0 qkv, 1 attention, 2 o, 3 router, 4 gate_up, 5 down, 6 lm_head, 7 other.
note op 0 classify a = has_args n_args args8 grid_y num_elements args18 fp8w dattnw routerw bf16w:
note returns the stage, bytes in st 5. op 1 record a = s bytes begin end elapsed rc_nonzero.
note op 2 dump header, op 3 dump token a 0: bytes written to o, returned. op 4 reads st word a 0.
const OWTOK ulong 38
const OWTOK0 ulong 64
const OWNTOK ulong 4096
const OWHEAD ulong 6
const OWOTHER ulong 7
fn ow_s o edit uchar 2048 p ulong w ulong n ulong to ulong
i = ulong 0
while lt i n bound 9
b = and shr w mul i 8 255
put o add p i uchar b
i = add i 1
end
ret add p n
end
fn ow_u o edit uchar 2048 p ulong v ulong to ulong
t = new uchar 20 0
n = ulong 0
x = v
while true bound 21
put t n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
q = p
while gt n 0 bound 21
n = sub n 1
put o q get t n
q = add q 1
end
ret q
end
fn ow_name o edit uchar 2048 p ulong s ulong to ulong
if eq s 0
note s "qkv"
p = ow_s o p 7760753 3
ret p
end
if eq s 1
note s "attention"
p = ow_s o p 8028075828261975137 8
p = ow_s o p 110 1
ret p
end
if eq s 2
note s "o"
p = ow_s o p 111 1
ret p
end
if eq s 3
note s "router"
p = ow_s o p 125780071116658 6
ret p
end
if eq s 4
note s "gate_up"
p = ow_s o p 31654249976062311 7
ret p
end
if eq s 5
note s "down"
p = ow_s o p 1853321060 4
ret p
end
note s "lm_head"
p = ow_s o p 28254585841741164 7
ret p
end
fn ow_fp8 st edit ulong 155712 a view ulong 16 to ulong
n = div get a 2 4
g = get a 3
s = OWOTHER
k = ulong 0
if eq g 1
if eq n 5120
s = 0
k = 2048
end
if eq n 2048
s = 2
k = 4096
end
end
if eq g 8
if eq n 1536
s = 4
k = 2048
end
if eq n 2048
s = 5
k = 768
end
end
if ne s OWOTHER
put st 5 mul mul g n k
end
ret s
end
fn ow_class st edit ulong 155712 a view ulong 16 to ulong
put st 5 0
if eq get a 0 0
ret OWOTHER
end
na = get a 1
if eq na get a 6
ret ow_fp8 st a
end
nel = get a 4
if eq na get a 7
if eq nel 4096
put st 5 mul 2048 add get a 5 1
ret 1
end
end
if eq na get a 8
if eq nel 2048
put st 5 524288
ret 3
end
end
if eq na get a 9
if eq nel 151936
put st 5 622329856
ret OWHEAD
end
end
ret OWOTHER
end
fn ow_row st edit ulong 155712 a view ulong 16 to void
s = get a 0
r = add 8 mul s 5
beg = get a 2
fin = get a 3
put st r add get st r 1
r = add r 1
put st r add get st r get a 1
r = add r 1
put st r add get st r sub fin beg
r = add r 1
put st r add get st r get a 4
r = add r 1
put st r add get st r sub beg get st 4
put st 45 add get st 45 1
end
fn ow_keep st edit ulong 155712 fin ulong to void
put st 43 fin
used = get st 0
if lt used OWNTOK
d = add OWTOK0 mul used OWTOK
for i ulong OWTOK
put st add d i get st add 8 i
end
put st 0 add used 1
else
put st 1 add get st 1 1
end
end
fn ow_rec st edit ulong 155712 a view ulong 16 to void
s = get a 0
fin = get a 3
rc = get a 5
pos = get st 45
if ne get st 2 0
ex = OWHEAD
if lt pos 288
ex = rem pos 6
end
if ne rc 0
put st 3 1
end
if ne s ex
put st 3 1
end
if gt pos 288
put st 3 1
end
if eq get st 3 0
ow_row st a
end
end
if eq s OWHEAD
if ne get st 2 0
if eq get st 3 0
if eq get st 45 289
ow_keep st fin
end
end
end
for i ulong OWTOK
put st add 8 i 0
end
put st 44 fin
put st 2 0
if eq rc 0
put st 2 1
end
put st 3 0
end
put st 4 fin
end
fn ow_head st edit ulong 155712 o edit uchar 2048 to ulong
p = ulong 0
note s "DECODE_PROFILE semantics=host_session_and_submit_wait weight_bytes_exclude_scales pure_gpu_time=UNKNOWN tokens="
p = ow_s o p 5791423805511648580 8
p = ow_s o p 8295706707565629266 8
p = ow_s o p 8314605285845069157 8
p = ow_s o p 7310291573909973053 8
p = ow_s o p 7953743344833229683 8
p = ow_s o p 8388356050598977380 8
p = ow_s o p 7311348204415579999 8
p = ow_s o p 8392847542696044393 8
p = ow_s o p 8461247168670298981 8
p = ow_s o p 7308323375080760676 8
p = ow_s o p 7448783850965049459 8
p = ow_s o p 4424062508652787056 8
p = ow_s o p 2327894055524716117 8
p = ow_s o p 17296891564486516 7
p = ow_u o p get st 0
note s " dropped="
p = ow_s o p 7234312004648985632 8
p = ow_s o p 61 1
p = ow_u o p get st 1
note s "\n"
p = ow_s o p 10 1
ret p
end
fn ow_stage st edit ulong 155712 o edit uchar 2048 p ulong t ulong s ulong to ulong
note s "DECODE_STAGE token="
p = ow_s o p 6007596587625432388 8
p = ow_s o p 7741533966423245140 8
p = ow_s o p 4025957 3
p = ow_u o p t
note s " stage="
p = ow_s o p 17281468270408480 7
p = ow_name o p s
r = add add OWTOK0 mul t OWTOK mul s 5
note s " calls="
p = ow_s o p 17296883091333920 7
p = ow_u o p get st r
note s " bytes="
p = ow_s o p 17296853162353184 7
p = ow_u o p get st add r 1
note s " session_ns="
p = ow_s o p 7957695011165139744 8
p = ow_s o p 1030975071 4
p = ow_u o p get st add r 2
note s " submit_wait_ns="
p = ow_s o p 6878238449425806112 8
p = ow_s o p 4428004214889341303 8
p = ow_u o p get st add r 3
note s " gap_before_ns="
p = ow_s o p 7378411726563272480 8
p = ow_s o p 17296891463430767 7
p = ow_u o p get st add r 4
note s "\n"
p = ow_s o p 10 1
ret p
end
fn ow_tok st edit ulong 155712 o edit uchar 2048 t ulong to ulong
p = ulong 0
d = add OWTOK0 mul t OWTOK
note s "DECODE_TOKEN token="
p = ow_s o p 6079654181663360324 8
p = ow_s o p 7741533966574111567 8
p = ow_s o p 4025957 3
p = ow_u o p t
note s " wall_ns="
p = ow_s o p 8317690481079318304 8
p = ow_s o p 61 1
p = ow_u o p sub get st add d 35 get st add d 36
note s " launches="
p = ow_s o p 7307199721475501088 8
p = ow_s o p 15731 2
p = ow_u o p get st add d 37
note s "\n"
p = ow_s o p 10 1
for s ulong 7
p = ow_stage st o p t s
end
ret p
end
fn own30b_prof op ulong st edit ulong 155712 a view ulong 16 o edit uchar 2048 to ulong
if eq op 0
ret ow_class st a
end
if eq op 1
ow_rec st a
ret 0
end
if eq op 2
ret ow_head st o
end
if eq op 3
t = get a 0
if lt t get st 0
ret ow_tok st o t
end
ret 0
end
ret get st get a 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note dag_eval: post-resolve resource-DAG schedule. C packs numbers and formats reasons.
note Model ulong 8192, scratch ulong 8192. Caller zeros scratch. Negative index is NONE.
note Header: n_ops n_res n_deps n_buf has_energy joules power energy_prov instr_none phase.
note Ops 32/10: t bytes launch cap engine bw launcher kind prov.
note Res 2592/4: kind slots cap prov. Deps 2720/2: from to. Buf 4768/4: bytes cap first last.
note Scratch: 0 t 1 remaining 3 makespan 4 status 5 reason 6 a 7 b 8 fa 9 fb
note 11 prov 12 accounted 13 dt 15 bytes 16 busy 17 launch 19 bound 20 cp 21 ncrit
note 22 measured 23 synthetic_e 24 energy 26 synthetic.
note state 64 blocked 320 npred 576 done 832 rem_t 1088 rem_b 1344 rem_l 1600
note run_start 1856 bytes_end 2112 free 2368 lbusy 2400 order 2432 indeg 2688 active 2944
note cp 2976 chain 3232 et 3488 ev 4000 start 4512 end 4768 ready 5024 floor 5280
note cont 5536 bound_res 5792 attr 5824 crit 6080 names 6336 peak 6344 peak_at 6376.
note FEPS is 1e-9, FLIVE is 1e-6, FNEG1 is -1.0, as IEEE-754 binary64 bits.
const NONE ulong 18446744073709551615
const FNEG1 ulong 13830554455654793216
const FEPS ulong 4472406533629990549
const FLIVE ulong 4517329193108106637
const SOK ulong 0
const SCAP ulong 4
const SCYC ulong 5
const SUNS ulong 6
const SLIFE ulong 8
const REMP ulong 1
const RCYC ulong 2
const RALN ulong 3
const RPROG ulong 4
const RGRD ulong 5
const RINV ulong 6
const RLIVE ulong 7
const RPEAK ulong 8
fn dep_fr m view ulong 8192 d ulong to ulong
p = mul d 2
p = add p 2720
ret get m p
end
fn dep_to m view ulong 8192 d ulong to ulong
p = mul d 2
p = add p 2720
ret get m add p 1
end
fn opu m view ulong 8192 i ulong f ulong to ulong
p = mul i 10
p = add p 32
ret get m add p f
end
fn opf m view ulong 8192 i ulong f ulong to f64
u = opu m i f
ret bitcast f64 u
end
fn resu m view ulong 8192 i ulong f ulong to ulong
p = mul i 4
p = add p 2592
ret get m add p f
end
fn resf m view ulong 8192 i ulong f ulong to f64
u = resu m i f
ret bitcast f64 u
end
fn bufu m view ulong 8192 i ulong f ulong to ulong
p = mul i 4
p = add p 4768
ret get m add p f
end
fn buff m view ulong 8192 i ulong f ulong to f64
u = bufu m i f
ret bitcast f64 u
end
fn scf s edit ulong 8192 i ulong to f64
u = get s i
ret bitcast f64 u
end
fn scinc s edit ulong 8192 i ulong to void
v = get s i
put s i add v 1
end
fn scdec s edit ulong 8192 i ulong to ulong
v = get s i
v = sub v 1
put s i v
ret v
end
fn sfput s edit ulong 8192 i ulong v f64 to void
put s i bitcast ulong v
end
fn sfadd s edit ulong 8192 i ulong v f64 to void
cur = bitcast f64 get s i
put s i bitcast ulong add cur v
end
fn topo_in m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
nd = get m 2
i = ulong 0
while lt i nops bound 256
ix = add 2688 i
put s ix ulong 0
i = add i 1
end
i = ulong 0
while lt i nd bound 1024
dst = dep_to m i
ix = add 2688 dst
scinc s ix
i = add i 1
end
end
fn topo_q m view ulong 8192 s edit ulong 8192 to ulong
nops = get m 0
n = ulong 0
i = ulong 0
while lt i nops bound 256
ix = add 2688 i
if eq get s ix 0
ox = add 2432 n
put s ox i
n = add n 1
end
i = add i 1
end
ret n
end
fn topo_rel m view ulong 8192 s edit ulong 8192 u ulong n ulong to ulong
nd = get m 2
i = ulong 0
while lt i nd bound 1024
fr = dep_fr m i
if eq fr u
dst = dep_to m i
ix = add 2688 dst
deg = scdec s ix
if eq deg 0
ox = add 2432 n
put s ox dst
n = add n 1
end
end
i = add i 1
end
ret n
end
fn dag_topo m view ulong 8192 s edit ulong 8192 to ulong
nops = get m 0
topo_in m s
n = topo_q m s
head = ulong 0
while lt head n bound 256
ox = add 2432 head
u = get s ox
head = add head 1
n = topo_rel m s u n
end
if eq n nops
ret 1
end
ret 0
end
fn dag_cap m view ulong 8192 s edit ulong 8192 to ulong
nbuf = get m 3
b = ulong 0
while lt b nbuf bound 256
bytes = buff m b 0
cix = bufu m b 1
cap = resf m cix 2
if gt bytes cap
put s 4 SCAP
put s 5 RALN
put s 6 b
put s 7 cix
ret SCAP
end
b = add b 1
end
ret 0
end
fn prov_op m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
mask = ulong 0
i = ulong 0
while lt i nops bound 256
pv = opu m i 8
bitv = shl ulong 1 pv
mask = or mask bitv
i = add i 1
end
put s 11 mask
end
fn res_used m view ulong 8192 i ulong to ulong
nops = get m 0
nbuf = get m 3
j = ulong 0
while lt j nops bound 256
eng = opu m j 4
if eq eng i
ret 1
end
bw = opu m j 5
if eq bw i
ret 1
end
lch = opu m j 6
if eq lch i
ret 1
end
j = add j 1
end
j = ulong 0
while lt j nbuf bound 256
cap = bufu m j 1
if eq cap i
ret 1
end
j = add j 1
end
ret 0
end
fn prov_res m view ulong 8192 s edit ulong 8192 to void
nres = get m 1
mask = get s 11
i = ulong 0
while lt i nres bound 32
used = res_used m i
if eq used 1
pv = resu m i 3
bitv = shl ulong 1 pv
mask = or mask bitv
end
i = add i 1
end
put s 11 mask
end
fn dag_prov m view ulong 8192 s edit ulong 8192 to void
put s 11 ulong 0
prov_op m s
prov_res m s
end
fn init_ops m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
i = ulong 0
tb = 0.0f64
tt = 0.0f64
tl = 0.0f64
while lt i nops bound 256
ix = add 64 i
put s ix ulong 0
ix = add 320 i
put s ix ulong 0
ix = add 576 i
put s ix ulong 0
ix = add 832 i
put s ix ulong 0
t = opf m i 0
by = opf m i 1
ln = opf m i 2
ix = add 1088 i
sfput s ix t
ix = add 1344 i
sfput s ix by
ix = add 1600 i
sfput s ix ln
ix = add 1856 i
put s ix FNEG1
ix = add 2112 i
put s ix FNEG1
tb = add tb by
tt = add tt t
tl = add tl ln
i = add i 1
end
sfput s 15 tb
sfput s 16 tt
sfput s 17 tl
end
fn init_res m view ulong 8192 s edit ulong 8192 to void
nres = get m 1
i = ulong 0
while lt i nres bound 32
slots = resu m i 1
ix = add 2368 i
put s ix slots
ix = add 2400 i
put s ix ulong 0
i = add i 1
end
end
fn init_dep m view ulong 8192 s edit ulong 8192 to void
nd = get m 2
i = ulong 0
while lt i nd bound 1024
dst = dep_to m i
ix = add 576 dst
scinc s ix
i = add i 1
end
end
fn dag_init m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
init_ops m s
put s 0 ulong 0
put s 1 nops
put s 3 ulong 0
init_res m s
init_dep m s
end
fn dag_rdy m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
t = scf s 0
i = ulong 0
while lt i nops bound 256
ix = add 64 i
st = get s ix
if eq st 0
dx = add 832 i
px = add 576 i
if eq get s dx get s px
put s ix ulong 1
rx = add 5024 i
sfput s rx t
end
end
i = add i 1
end
end
fn dag_can m view ulong 8192 s edit ulong 8192 i ulong to ulong
eng = opu m i 4
if ne eng NONE
fx = add 2368 eng
if le get s fx 0
ret 1
end
end
lch = opu m i 6
lx = add 1600 i
reml = scf s lx
if ne lch NONE
if gt reml 0.0f64
bx = add 2400 lch
if ne get s bx 0
ret 2
end
end
end
if ne lch NONE
if gt reml 0.0f64
ret 3
end
end
ret 0
end
fn disp_go m view ulong 8192 s edit ulong 8192 i ulong t f64 code ulong to void
eng = opu m i 4
if ne eng NONE
fx = add 2368 eng
v = scdec s fx
end
sx = add 4512 i
sfput s sx t
if eq code 3
lch = opu m i 6
bx = add 2400 lch
put s bx ulong 1
ix = add 64 i
put s ix ulong 2
end
if eq code 0
ix = add 64 i
put s ix ulong 3
rx = add 1856 i
sfput s rx t
end
end
fn dag_disp m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
t = scf s 0
i = ulong 0
while lt i nops bound 256
ix = add 64 i
st = get s ix
if eq st 1
code = dag_can m s i
if eq code 1
bx = add 320 i
put s bx ulong 1
end
if eq code 2
bx = add 320 i
put s bx ulong 2
end
if eq code 0
disp_go m s i t 0
end
if eq code 3
disp_go m s i t 3
end
end
i = add i 1
end
end
fn dag_db m view ulong 8192 s edit ulong 8192 i ulong remb f64 to f64
bw = opu m i 5
cap = opf m i 3
ix = add 2944 bw
act = get s ix
share = div cap f64 act
ret div remb share
end
fn dag_rd m view ulong 8192 s edit ulong 8192 i ulong to f64
d = neg 1.0f64
tx = add 1088 i
remt = scf s tx
if gt remt 0.0f64
d = remt
end
bx = add 1344 i
remb = scf s bx
if gt remb 0.0f64
db = dag_db m s i remb
if lt d 0.0f64
d = db
end
if not lt d 0.0f64
if lt db d
d = db
end
end
end
if lt d 0.0f64
d = 0.0f64
end
ret d
end
fn dt_take cur f64 nxt f64 to f64
take = ulong 0
if lt cur 0.0f64
take = ulong 1
end
if lt nxt cur
take = ulong 1
end
if eq take 1
ret nxt
end
ret cur
end
fn dt_act m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
nres = get m 1
i = ulong 0
while lt i nres bound 32
ix = add 2944 i
put s ix ulong 0
i = add i 1
end
i = ulong 0
while lt i nops bound 256
ix = add 64 i
st = get s ix
if eq st 3
bx = add 1344 i
rb = scf s bx
if gt rb 0.0f64
bw = opu m i 5
ax = add 2944 bw
scinc s ax
end
end
i = add i 1
end
end
fn dt_scan m view ulong 8192 s edit ulong 8192 to ulong
nops = get m 0
dt = neg 1.0f64
any = ulong 0
i = ulong 0
while lt i nops bound 256
ix = add 64 i
st = get s ix
if eq st 2
any = ulong 1
lx = add 1600 i
reml = scf s lx
dt = dt_take dt reml
end
if eq st 3
any = ulong 1
d = dag_rd m s i
dt = dt_take dt d
end
i = add i 1
end
sfput s 13 dt
ret any
end
fn dag_dt m view ulong 8192 s edit ulong 8192 to ulong
dt_act m s
ret dt_scan m s
end
fn dag_cont m view ulong 8192 s edit ulong 8192 i ulong t f64 to void
bytes = opf m i 1
if le bytes 0.0f64
ret
end
cap = opf m i 3
ideal = div bytes cap
bx = add 2112 i
be = scf s bx
if lt be 0.0f64
be = t
end
rx = add 1856 i
rs = scf s rx
actual = sub be rs
extra = 0.0f64
diff = sub actual ideal
if gt diff 0.0f64
extra = diff
end
cx = add 5536 i
sfput s cx extra
end
fn dag_rel m view ulong 8192 s edit ulong 8192 i ulong to void
nd = get m 2
d = ulong 0
while lt d nd bound 1024
fr = dep_fr m d
if eq fr i
dst = dep_to m d
ix = add 832 dst
scinc s ix
end
d = add d 1
end
end
fn dag_done m view ulong 8192 s edit ulong 8192 i ulong t f64 to void
ix = add 64 i
put s ix ulong 4
ex = add 4768 i
sfput s ex t
v = get s 1
put s 1 sub v 1
eng = opu m i 4
if ne eng NONE
fx = add 2368 eng
scinc s fx
end
dag_rel m s i
dag_cont m s i t
end
fn dag_thr bytes f64 to f64
eps = bitcast f64 FEPS
if gt bytes 1.0f64
ret mul eps bytes
end
ret eps
end
fn dag_sh m view ulong 8192 s edit ulong 8192 i ulong to f64
bw = opu m i 5
cap = opf m i 3
ix = add 2944 bw
act = get s ix
ret div cap f64 act
end
fn dag_byte m view ulong 8192 s edit ulong 8192 i ulong dt f64 t f64 to void
bx = add 1344 i
remb = scf s bx
if le remb 0.0f64
ret
end
share = dag_sh m s i
step = mul share dt
remb = sub remb step
bytes = opf m i 1
thr = dag_thr bytes
if le remb thr
remb = 0.0f64
ex = add 2112 i
sfput s ex t
end
sfput s bx remb
end
fn dag_alch m view ulong 8192 s edit ulong 8192 i ulong dt f64 t f64 to void
lx = add 1600 i
reml = scf s lx
reml = sub reml dt
eps = bitcast f64 FEPS
if le reml eps
reml = 0.0f64
lch = opu m i 6
bx = add 2400 lch
put s bx ulong 0
ix = add 64 i
put s ix ulong 3
rx = add 1856 i
sfput s rx t
end
sfput s lx reml
end
fn dag_arun m view ulong 8192 s edit ulong 8192 i ulong dt f64 t f64 to void
eps = bitcast f64 FEPS
tx = add 1088 i
remt = scf s tx
if gt remt 0.0f64
remt = sub remt dt
if le remt eps
remt = 0.0f64
end
sfput s tx remt
end
dag_byte m s i dt t
remt = scf s tx
bx = add 1344 i
remb = scf s bx
if le remt 0.0f64
if le remb 0.0f64
dag_done m s i t
end
end
end
fn dag_adv m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
dt = scf s 13
if lt dt 0.0f64
dt = 0.0f64
end
t = scf s 0
t = add t dt
sfput s 0 t
i = ulong 0
while lt i nops bound 256
ix = add 64 i
st = get s ix
if eq st 2
dag_alch m s i dt t
end
if eq st 3
dag_arun m s i dt t
end
i = add i 1
end
ms = scf s 3
if gt t ms
sfput s 3 t
end
end
fn dag_sim m view ulong 8192 s edit ulong 8192 to ulong
guard = ulong 0
nleft = get s 1
while gt nleft 0 bound 2065
guard = add guard 1
if gt guard 2064
put s 4 SUNS
put s 5 RGRD
ret SUNS
end
dag_rdy m s
dag_disp m s
any = dag_dt m s
if eq any 0
put s 4 SUNS
put s 5 RPROG
ret SUNS
end
dag_adv m s
nleft = get s 1
end
ret 0
end
fn dag_flr m view ulong 8192 s edit ulong 8192 i ulong to f64
t = opf m i 0
by = opf m i 1
ln = opf m i 2
floor = t
if gt by 0.0f64
cap = opf m i 3
tb = div by cap
if gt tb floor
floor = tb
end
end
floor = add floor ln
ix = add 5280 i
sfput s ix floor
ret floor
end
fn dag_best m view ulong 8192 s edit ulong 8192 i ulong to f64
nd = get m 2
best = 0.0f64
d = ulong 0
while lt d nd bound 1024
dst = dep_to m d
if eq dst i
fr = dep_fr m d
ix = add 2976 fr
cp = scf s ix
if gt cp best
best = cp
end
end
d = add d 1
end
ret best
end
fn rwk_bw m view ulong 8192 r ulong to f64
nops = get m 0
w = 0.0f64
j = ulong 0
while lt j nops bound 256
bw = opu m j 5
if eq bw r
by = opf m j 1
cap = opf m j 3
part = div by cap
w = add w part
end
j = add j 1
end
ret w
end
fn rwk_cpu m view ulong 8192 r ulong to f64
nops = get m 0
slots = resu m r 1
w = 0.0f64
j = ulong 0
while lt j nops bound 256
eng = opu m j 4
if eq eng r
t = opf m j 0
ln = opf m j 2
sum = add t ln
part = div sum f64 slots
w = add w part
end
j = add j 1
end
ret w
end
fn rwk_lch m view ulong 8192 r ulong to f64
nops = get m 0
w = 0.0f64
j = ulong 0
while lt j nops bound 256
lch = opu m j 6
if eq lch r
ln = opf m j 2
w = add w ln
end
j = add j 1
end
ret w
end
fn dag_rwk m view ulong 8192 r ulong to f64
kind = resu m r 0
w = 0.0f64
if eq kind 2
w = rwk_bw m r
end
if eq kind 1
w = rwk_cpu m r
end
if eq kind 4
w = rwk_lch m r
end
ret w
end
fn dag_cpw m view ulong 8192 s edit ulong 8192 to f64
nops = get m 0
k = ulong 0
bcp = 0.0f64
while lt k nops bound 256
ox = add 2432 k
i = get s ox
floor = dag_flr m s i
best = dag_best m s i
cpv = add best floor
ix = add 2976 i
sfput s ix cpv
if gt cpv bcp
bcp = cpv
end
k = add k 1
end
ret bcp
end
fn dag_bres m view ulong 8192 s edit ulong 8192 bcp f64 to f64
nres = get m 1
bnd = bcp
r = ulong 0
while lt r nres bound 32
w = dag_rwk m r
ix = add 5792 r
sfput s ix w
if gt w bnd
bnd = w
end
r = add r 1
end
ret bnd
end
fn dag_bnd m view ulong 8192 s edit ulong 8192 to void
bcp = dag_cpw m s
sfput s 20 bcp
bnd = dag_bres m s bcp
sfput s 19 bnd
end
fn dag_ws m view ulong 8192 s edit ulong 8192 b ulong to f64
first = bufu m b 2
if eq first NONE
ret 0.0f64
end
ix = add 4512 first
ret scf s ix
end
fn dag_we m view ulong 8192 s edit ulong 8192 b ulong to f64
last = bufu m b 3
if eq last NONE
ret scf s 3
end
ix = add 4768 last
ret scf s ix
end
fn dag_life m view ulong 8192 s edit ulong 8192 to ulong
nbuf = get m 3
b = ulong 0
eps = bitcast f64 FEPS
while lt b nbuf bound 256
st = dag_ws m s b
en = dag_we m s b
lim = add en eps
if lt lim st
put s 4 SLIFE
put s 5 RINV
put s 6 b
sfput s 8 st
sfput s 9 en
ret SLIFE
end
b = add b 1
end
ret 0
end
fn dag_evs m view ulong 8192 s edit ulong 8192 c ulong to ulong
nbuf = get m 3
en = ulong 0
b = ulong 0
eps = bitcast f64 FEPS
while lt b nbuf bound 256
cap = bufu m b 1
if eq cap c
st = dag_ws m s b
e = dag_we m s b
lim = add st eps
if lt lim e
by = buff m b 0
ix = add 3488 en
sfput s ix st
vx = add 4000 en
sfput s vx by
en = add en 1
ix = add 3488 en
sfput s ix e
vx = add 4000 en
nb = neg by
sfput s vx nb
en = add en 1
end
end
b = add b 1
end
ret en
end
fn sort_sw etj f64 kt f64 evj f64 kv f64 to ulong
sw = ulong 0
if gt etj kt
sw = ulong 1
end
if eq etj kt
if gt evj 0.0f64
if lt kv 0.0f64
sw = ulong 1
end
end
end
ret sw
end
fn sort_sh s edit ulong 8192 j ulong etj f64 evj f64 to ulong
dx = add 3488 j
sfput s dx etj
ex = add 4000 j
sfput s ex evj
ret sub j 1
end
fn sort_in s edit ulong 8192 j ulong kt f64 kv f64 to ulong
jp = sub j 1
px = add 3488 jp
etj = scf s px
qx = add 4000 jp
evj = scf s qx
sw = sort_sw etj kt evj kv
if eq sw 1
j = sort_sh s j etj evj
end
ret j
end
fn dag_sort s edit ulong 8192 en ulong to void
i = ulong 1
while lt i en bound 512
tx = add 3488 i
kt = scf s tx
vx = add 4000 i
kv = scf s vx
j = i
go = ulong 1
while gt j 0 bound 512
if eq go 0
break
end
nj = sort_in s j kt kv
if eq nj j
go = ulong 0
end
j = nj
end
tx = add 3488 j
sfput s tx kt
vx = add 4000 j
sfput s vx kv
i = add i 1
end
end
fn nmsk1 m view ulong 8192 s edit ulong 8192 b ulong pat f64 to void
st = dag_ws m s b
e = dag_we m s b
hit = ulong 0
if le st pat
if gt e pat
hit = ulong 1
end
end
if eq hit 0
ret
end
w = div b 64
bit = rem b 64
ix = add 6336 w
cur = get s ix
bitv = shl ulong 1 bit
put s ix or cur bitv
end
fn dag_nmsk m view ulong 8192 s edit ulong 8192 c ulong pat f64 to void
put s 6336 ulong 0
put s 6337 ulong 0
put s 6338 ulong 0
put s 6339 ulong 0
nbuf = get m 3
b = ulong 0
while lt b nbuf bound 256
cap = bufu m b 1
if eq cap c
nmsk1 m s b pat
end
b = add b 1
end
end
fn scan_pk m view ulong 8192 s edit ulong 8192 c ulong peak f64 pat f64 to ulong
px = add 6344 c
sfput s px peak
ax = add 6376 c
sfput s ax pat
cap = resf m c 2
eps = bitcast f64 FEPS
pcap = add cap eps
if gt peak pcap
dag_nmsk m s c pat
put s 4 SCAP
put s 5 RPEAK
put s 6 c
sfput s 8 peak
sfput s 9 pat
ret SCAP
end
ret 0
end
fn dag_scan m view ulong 8192 s edit ulong 8192 c ulong en ulong to ulong
live = 0.0f64
peak = 0.0f64
pat = 0.0f64
i = ulong 0
lim = bitcast f64 FLIVE
nlim = neg lim
while lt i en bound 512
vx = add 4000 i
ev = scf s vx
live = add live ev
if lt live nlim
put s 4 SLIFE
put s 5 RLIVE
put s 6 c
sfput s 8 live
tx = add 3488 i
at = scf s tx
sfput s 9 at
ret SLIFE
end
if gt live peak
peak = live
tx = add 3488 i
pat = scf s tx
end
i = add i 1
end
ret scan_pk m s c peak pat
end
fn dag_ledg m view ulong 8192 s edit ulong 8192 to ulong
nres = get m 1
c = ulong 0
while lt c nres bound 32
kind = resu m c 0
if eq kind 3
en = dag_evs m s c
dag_sort s en
rc = dag_scan m s c en
if ne rc 0
ret rc
end
end
c = add c 1
end
ret 0
end
fn dag_pred m view ulong 8192 s edit ulong 8192 cur ulong to ulong
nd = get m 2
pred = NONE
d = ulong 0
while lt d nd bound 1024
dst = dep_to m d
if eq dst cur
fr = dep_fr m d
if eq pred NONE
pred = fr
end
if ne pred fr
fx = add 4768 fr
ef = scf s fx
px = add 4768 pred
ep = scf s px
if gt ef ep
pred = fr
end
end
end
d = add d 1
end
ret pred
end
fn dag_gap m view ulong 8192 s edit ulong 8192 cur ulong pred ulong to void
sx = add 4512 cur
st = scf s sx
base = 0.0f64
if ne pred NONE
px = add 4768 pred
base = scf s px
end
gap = sub st base
if le gap 0.0f64
ret
end
bx = add 320 cur
blk = get s bx
if eq blk 1
sfadd s 5828 gap
end
if eq blk 2
sfadd s 5827 gap
end
if eq blk 0
sfadd s 5830 gap
end
sfadd s 12 gap
end
fn dag_bw m view ulong 8192 s edit ulong 8192 cur ulong rt f64 to void
bytes = opf m cur 1
cap = opf m cur 3
ideal = div bytes cap
cx = add 5536 cur
cont = scf s cx
actual = add ideal cont
t = opf m cur 0
if ge t actual
sfadd s 5824 rt
end
if not ge t actual
sfadd s 5825 ideal
sfadd s 5826 cont
if gt rt actual
left = sub rt actual
sfadd s 5830 left
end
end
end
fn dag_run m view ulong 8192 s edit ulong 8192 cur ulong to void
ex = add 4768 cur
en = scf s ex
rx = add 1856 cur
rs = scf s rx
sx = add 4512 cur
base = scf s sx
if ge rs 0.0f64
base = rs
end
rt = sub en base
ln = opf m cur 2
sfadd s 5827 ln
acc = scf s 12
acc = add acc ln
kind = opu m cur 7
bytes = opf m cur 1
if eq kind 4
sfadd s 5829 rt
end
if ne kind 4
if gt bytes 0.0f64
dag_bw m s cur rt
end
if not gt bytes 0.0f64
sfadd s 5824 rt
end
end
acc = add acc rt
sfput s 12 acc
end
fn attr_end m view ulong 8192 s edit ulong 8192 to ulong
nops = get m 0
cur = ulong 0
i = ulong 1
while lt i nops bound 256
ix = add 4768 i
ei = scf s ix
cx = add 4768 cur
ec = scf s cx
if gt ei ec
cur = i
end
i = add i 1
end
ret cur
end
fn attr_rev s edit ulong 8192 nc ulong to void
i = ulong 0
while lt i nc bound 256
j = sub nc 1
j = sub j i
sx = add 3232 j
src = get s sx
dx = add 6080 i
put s dx src
i = add i 1
end
end
fn attr_left s edit ulong 8192 to void
ms = scf s 3
acc = scf s 12
left = sub ms acc
lim = bitcast f64 FLIVE
addit = ulong 0
if gt left lim
addit = ulong 1
end
if lt left neg lim
addit = ulong 1
end
if eq addit 1
sfadd s 5830 left
end
end
fn dag_attr m view ulong 8192 s edit ulong 8192 to void
nops = get m 0
if eq nops 0
ret
end
cur = attr_end m s
put s 12 ulong 0
nc = ulong 0
while lt nc 256 bound 256
if eq cur NONE
break
end
ix = add 3232 nc
put s ix cur
nc = add nc 1
dag_run m s cur
pred = dag_pred m s cur
dag_gap m s cur pred
cur = pred
end
put s 21 nc
attr_rev s nc
attr_left s
end
fn dag_syn s edit ulong 8192 to void
mask = get s 11
syn = ulong 0
bitv = shl ulong 1 1
got = and mask bitv
if ne got 0
syn = ulong 1
end
put s 26 syn
end
fn nrg_pow s edit ulong 8192 power f64 prov ulong to void
if ne prov 1
ret
end
ms = scf s 3
eps = bitcast f64 FEPS
ej = mul power ms
ej = mul ej eps
put s 23 ulong 1
sfput s 24 ej
mask = get s 11
bitv = shl ulong 1 1
put s 11 or mask bitv
end
fn dag_nrg m view ulong 8192 s edit ulong 8192 to void
has = get m 4
joules = bitcast f64 get m 5
power = bitcast f64 get m 6
prov = get m 7
none = get m 8
took = ulong 0
if ne has 0
if gt joules 0.0f64
if eq none 0
put s 22 ulong 1
sfput s 24 joules
took = ulong 1
end
end
end
if eq took 0
if ne has 0
if gt power 0.0f64
nrg_pow s power prov
end
end
end
dag_syn s
end
fn dag_eval m view ulong 8192 s edit ulong 8192 to ulong
phase = get m 9
if eq phase 0
if eq get m 0 0
put s 4 SUNS
put s 5 REMP
ret SUNS
end
put s 4 SOK
ret SOK
end
if eq dag_topo m s 0
put s 4 SCYC
put s 5 RCYC
ret SCYC
end
rc = dag_cap m s
if ne rc 0
ret rc
end
dag_prov m s
dag_init m s
rc = dag_sim m s
if ne rc 0
ret rc
end
dag_bnd m s
rc = dag_life m s
if ne rc 0
ret rc
end
rc = dag_ledg m s
if ne rc 0
ret rc
end
dag_attr m s
dag_nrg m s
put s 4 SOK
ret SOK
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ampfam: the plan, control and verdicts of tools/ampere_families.c (SM86 producer coverage of the
note existing Blackwell generator families). The C shell calls one generator, the SM121 encoder or the
note SM86 encoder when this unit asks for it and prints the text it returns; this unit owns the order of
note the 133 producer steps, each generator's specification, which steps must encode and which must be
note refused, the short-circuit of a failing step and the message with the oracle's source line.
note facts f (ulong 32), the C header constants: 0 OMEGA_PATTN_MODE_FUSED, 1 _ATTEND, 2 _APPEND,
note 3 OMEGA_TC2_EPI_F32, 4 OMEGA_TC2_EPI_SWIGLU, 5 OMEGA_DEC_AXPY, 6 OMEGA_DEC_XBOUND, 7 OMEGA_DEC_RES,
note 8 OMEGA_DEC_GATHER, 9 OMEGA_DEC_RES_ADD | OMEGA_DEC_RES_NORM, 10 OMEGA_QG_IN_F32, 11 OMEGA_QG_IN_BF16,
note 12 OMEGA_GDN_COPY, 13 OMEGA_GDN_ZERO, 14 OMEGA_TERN_LAYOUT_ROWMAJOR, 15 OMEGA_TERN_LAYOUT_BLOCK,
note 16 OMEGA_TERN_MAX_K, 17 OMEGA_TERN_CHUNK_MAX, 18 OMEGA_TERN_EPI_F32.
note state s (ulong 64, all 0 at the start): 0 step, 1 phase, 2 rc of the last call (int64 bits, written by
note the shell), 3 SM121 length a, 4 SM86 length b (written by the shell), 5 expectation (0 encode,
note 1 refuse), 6 source line, 9 generator id, 10 initial SM86 length, 16..23 the generator fields.
note Returns 1 (call generator s 9 with s 16..23), 2 (SM121 encoder, a = 0), 3 (SM86 encoder, b = s 10),
note 4 + 256 * length (print o 0 to stderr, exit 1), 5 + 256 * length (print o 0 to stdout, exit 0),
note 0 (abort: called again after the end).
const AFPLAN ulong 1048576
const AFSKIP ulong 1048577
const AFEND ulong 1048578
fn af_s o edit uchar 128 p ulong w ulong n ulong to ulong
i = ulong 0
while lt i n bound 9
put o add p i uchar and shr w mul i 8 255
i = add i 1
end
ret add p n
end
fn af_nd v ulong to ulong
n = ulong 1
x = div v 10
while ne x 0 bound 20
n = add n 1
x = div x 10
end
ret n
end
fn af_u o edit uchar 128 p ulong v ulong to ulong
w = af_nd v
k = add p w
x = v
for i ulong w
k = sub k 1
put o k uchar add 48 rem x 10
x = div x 10
end
ret add p w
end
note af_cnt: passes of `for (v = lo; v <= hi; ++v)`.
fn af_cnt lo ulong hi ulong to ulong
if lt hi lo
ret ulong 0
end
ret add sub hi lo 1
end
note af_set: generator g, expectation ex, line ln, fields cleared (a C designated initializer).
fn af_set s edit ulong 64 g ulong ex ulong ln ulong to ulong
put s 9 g
put s 5 ex
put s 6 ln
for i ulong 8
put s add 16 i ulong 0
end
ret AFPLAN
end
fn af_fl s edit ulong 64 k ulong v ulong to ulong
put s add 16 k v
ret AFPLAN
end
fn af_f4 s edit ulong 64 a ulong b ulong c ulong d ulong to ulong
x = af_fl s 0 a
x = af_fl s 1 b
x = af_fl s 2 c
ret af_fl s 3 d
end
note af_sa: decode_attn depth 1..4 (line 44); prefill_attn FUSED..ATTEND, APPEND encodes (50), the
note others are refused (51).
fn af_sa s edit ulong 64 f view ulong 32 i ulong to ulong
x = ulong 0
if lt i 4
x = af_set s 1 0 44
ret af_fl s 0 add i 1
end
i = sub i 4
n = af_cnt get f 0 get f 1
if lt i n
m = add get f 0 i
if eq m get f 2
x = af_set s 2 0 50
x = af_fl s 2 1
else
x = af_set s 2 1 51
end
x = af_fl s 0 4
ret af_fl s 1 m
end
ret sub i n
end
note af_sb: the fixed bf16, fp8 GEMV/GEMM and router steps (lines 54..68).
fn af_sb s edit ulong 64 i ulong to ulong
x = ulong 0
if lt i 3
x = af_set s 3 0 54
x = af_f4 s 256 1 4 1
if eq i 1
x = af_set s 3 0 55
x = af_f4 s 256 1 4 1
x = af_fl s 4 1
end
if eq i 2
x = af_set s 3 0 57
x = af_f4 s 256 1 4 1
x = af_fl s 5 256
x = af_fl s 6 2
end
ret AFPLAN
end
if lt i 6
x = af_set s 4 0 59
if eq i 4
x = af_set s 4 0 60
x = af_fl s 4 1
end
if eq i 5
x = af_set s 5 0 61
x = af_fl s 4 1
end
ret af_f4 s 256 8 1 8
end
if lt i 8
x = af_set s 6 0 63
if eq i 7
x = af_set s 6 0 64
x = af_fl s 4 1
end
ret af_f4 s 256 8 2 8
end
if lt i 10
x = af_set s 7 0 66
if eq i 9
x = af_set s 7 0 68
x = af_fl s 2 256
x = af_fl s 3 1
end
x = af_fl s 0 8
ret af_fl s 1 1
end
ret sub i 10
end
note af_sc: pf_copy, rl, mc and the tensor-core probe, peak, bandwidth and GEMM steps (lines 69..78).
fn af_sc s edit ulong 64 i ulong to ulong
x = ulong 0
if eq i 0
ret af_set s 8 0 69
end
if eq i 1
x = af_set s 9 0 71
x = af_fl s 0 128
x = af_fl s 1 32
ret af_fl s 2 1
end
if eq i 2
x = af_set s 10 0 73
x = af_fl s 0 128
ret af_fl s 1 4
end
if eq i 3
ret af_set s 11 0 74
end
if eq i 4
x = af_set s 12 0 75
ret af_f4 s 2 2 8 128
end
if eq i 5
x = af_set s 13 0 76
x = af_fl s 0 2
x = af_fl s 1 1
ret af_fl s 2 128
end
if eq i 6
x = af_set s 14 0 78
ret af_f4 s 128 2 2 4
end
ret sub i 7
end
note af_sd: tc2 epi F32..SWIGLU by direct 0..1 (F32 encodes, line 83; the others are refused, 84);
note dec kinds AXPY..XBOUND (line 91).
fn af_sd s edit ulong 64 f view ulong 32 i ulong to ulong
x = ulong 0
n = mul af_cnt get f 3 get f 4 2
if lt i n
e = add get f 3 div i 2
if eq e get f 3
x = af_set s 15 0 83
else
x = af_set s 15 1 84
end
x = af_f4 s 128 2 2 4
x = af_fl s 4 2
x = af_fl s 5 e
x = af_fl s 6 rem i 2
ret af_fl s 7 256
end
i = sub i n
n = af_cnt get f 5 get f 6
if lt i n
k = add get f 5 i
x = af_set s 16 0 91
x = af_fl s 0 k
if eq k get f 5
x = af_fl s 1 256
end
if eq k get f 7
x = af_fl s 2 get f 9
end
if eq k get f 8
x = af_fl s 3 256
x = af_fl s 1 256
end
ret AFPLAN
end
ret sub i n
end
note af_se: pq in_type F32..BF16 (95), qgemm (98), qmma probe (99), qmma peak (100), f2e4 probe (101),
note all refused.
fn af_se s edit ulong 64 f view ulong 32 i ulong to ulong
x = ulong 0
n = af_cnt get f 10 get f 11
if lt i n
x = af_set s 17 1 95
x = af_fl s 0 128
ret af_fl s 1 add get f 10 i
end
i = sub i n
if eq i 0
x = af_set s 18 1 98
ret af_f4 s 128 4 8 128
end
if eq i 1
x = af_set s 19 1 99
x = af_fl s 0 0
ret af_fl s 1 8
end
if eq i 2
x = af_set s 20 1 100
ret af_f4 s 2 2 8 128
end
if eq i 3
ret af_set s 21 1 101
end
ret sub i 4
end
note af_sf: per shape 0..1, decode_attn256 depth 1..4 by prep by multi (112), then prefill_attn256
note refused (117); shape 1 is 16 q heads, 2 kv heads, 4 q heads per CTA.
fn af_sf s edit ulong 64 i ulong to ulong
x = ulong 0
if ge i 34
ret sub i 34
end
sh = div i 17
j = rem i 17
if lt j 16
x = af_set s 22 0 112
x = af_fl s 0 add div j 4 1
x = af_fl s 1 rem div j 2 2
x = af_fl s 2 rem j 2
if eq sh 1
x = af_fl s 3 16
x = af_fl s 4 2
x = af_fl s 5 4
end
ret AFPLAN
end
x = af_set s 23 1 117
if eq sh 1
x = af_fl s 0 16
x = af_fl s 1 2
end
ret AFPLAN
end
note af_sg: ratio 2..3 by state_bf16 0..1: gdn (bf16 refused 122, f32 encodes 123), gdn_multi (124),
note gdn_prep (125), gdn_scan refused (127), gdn_post refused (128); gdn_copy COPY..ZERO (132).
fn af_sg s edit ulong 64 f view ulong 32 i ulong to ulong
x = ulong 0
if lt i 20
c = div i 5
k = rem i 5
bf = rem c 2
if eq k 0
if eq bf 1
x = af_set s 24 1 122
else
x = af_set s 24 0 123
end
end
if eq k 1
x = af_set s 25 0 124
end
if eq k 2
x = af_set s 26 0 125
end
if eq k 3
x = af_set s 27 1 127
end
if eq k 4
x = af_set s 28 1 128
end
x = af_fl s 0 add 2 div c 2
ret af_fl s 1 bf
end
i = sub i 20
n = af_cnt get f 12 get f 13
if lt i n
x = af_set s 29 0 132
ret af_fl s 0 add get f 12 i
end
ret sub i n
end
note af_sh: ternary GEMV, k of 256, 2560, 8192, OMEGA_TERN_MAX_K by the five layouts by epilogue 0..1
note (144); a k above OMEGA_TERN_CHUNK_MAX with the f32 epilogue is skipped.
fn af_sh s edit ulong 64 f view ulong 32 i ulong to ulong
x = ulong 0
if ge i 40
ret sub i 40
end
ki = div i 10
sh = rem div i 2 5
e = rem i 2
k = get f 16
if eq ki 0
k = ulong 256
end
if eq ki 1
k = ulong 2560
end
if eq ki 2
k = ulong 8192
end
if and gt k get f 17 eq e get f 18
ret AFSKIP
end
x = af_set s 30 0 144
lay = get f 14
r = shl ulong 1 sh
if gt sh 2
lay = get f 15
r = shl ulong 1 sub sh 2
end
x = af_f4 s k lay r 4
x = af_fl s 4 1
ret af_fl s 5 e
end
note af_plan: plans step i; AFPLAN, AFSKIP, or AFEND past the last step.
fn af_plan s edit ulong 64 f view ulong 32 i ulong to ulong
i = af_sa s f i
if ge i AFPLAN
ret i
end
i = af_sb s i
if ge i AFPLAN
ret i
end
i = af_sc s i
if ge i AFPLAN
ret i
end
i = af_sd s f i
if ge i AFPLAN
ret i
end
i = af_se s f i
if ge i AFPLAN
ret i
end
i = af_sf s i
if ge i AFPLAN
ret i
end
i = af_sg s f i
if ge i AFPLAN
ret i
end
i = af_sh s f i
if ge i AFPLAN
ret i
end
ret AFEND
end
note af_bad: the verdict of the SM86 call: encode needs rc 0 and b == a, refuse needs rc -2 and b == 0.
fn af_bad s view ulong 64 to ulong
rc = get s 2
if eq get s 5 0
if or ne rc 0 ne get s 3 get s 4
ret ulong 1
end
ret ulong 0
end
if or ne rc sub ulong 0 2 ne get s 4 0
ret ulong 1
end
ret ulong 0
end
note af_fail: "Ampere family producer failed at line %d\n" or "Ampere unsupported family accepted at
note line %d\n".
fn af_fail s edit ulong 64 o edit uchar 128 to ulong
put s 1 4
p = ulong 0
if eq get s 5 0
note s "Ampere family producer failed at line "
p = af_s o p 7358993333125934401 8
p = af_s o p 8246126623597358433 8
p = af_s o p 7359007570909291631 8
p = af_s o p 8386019596710996321 8
p = af_s o p 35620016188448 6
else
note s "Ampere unsupported family accepted at line "
p = af_s o p 8439857243694853441 8
p = af_s o p 8390891584458421102 8
p = af_s o p 7811895293743490149 8
p = af_s o p 8390317583334711417 8
p = af_s o p 7596482355684992101 8
p = af_s o p 2123118 3
end
p = af_u o p get s 6
put o p uchar 10
ret add 4 shl add p 1 8
end
fn af_done s edit ulong 64 o edit uchar 128 to ulong
put s 1 5
p = ulong 0
note s "Ampere extended existing generator families encoded (host only)\n"
p = af_s o p 7286935739088006465 8
p = af_s o p 2334101988908037240 8
p = af_s o p 7453010382218164325 8
p = af_s o p 8386109761109976864 8
p = af_s o p 7811895293743493743 8
p = af_s o p 8026380341519541609 8
p = af_s o p 8317981558328026468 8
p = af_s o p 732249921040621684 8
ret add 5 shl p 8
end
fn ampfam f view ulong 32 s edit ulong 64 o edit uchar 128 to ulong
ph = get s 1
rc = get s 2
if gt ph 3
ret ulong 0
end
if eq ph 1
if ne rc 0
ret af_fail s o
end
put s 1 2
ret ulong 2
end
if eq ph 2
if ne rc 0
ret af_fail s o
end
put s 1 3
put s 10 get s 5
ret ulong 3
end
if eq ph 3
if ne af_bad s 0
ret af_fail s o
end
put s 0 add get s 0 1
end
for t ulong 64
r = af_plan s f get s 0
if eq r AFPLAN
put s 1 1
ret ulong 1
end
if ne r AFSKIP
ret af_done s o
end
put s 0 add get s 0 1
end
ret ulong 0
end

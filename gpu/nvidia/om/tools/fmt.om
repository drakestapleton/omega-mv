note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note fmt: exact printf("%.Pf") and printf("%.Pg") of an f64, as glibc prints them (the exact binary value
note rounded once, ties to even; inf, -inf, nan, -nan; the sign of -0). Shared by the om/tools units that
note format floats; a unit spec concatenates this file before the unit (om/units.sh name=fmt.om,unit.om).
note fm_dig writes the exact decimal digits of |x|: integer digits d 0..ip-1 then fraction digits
note d ip..ip+fl-1, and returns ip * 65536 + fl. Limbs are base 1e9, little-endian, 130 of them; the
note longest value is 2^53 * 5^1074 (767 digits) and the longest digit string 16 + 1074.
const FMDN ulong 1200
const FMON ulong 1600
const FMLN ulong 130
const FMB ulong 1000000000
fn fm_mul l edit ulong 130 n ulong f ulong to ulong
c = ulong 0
for i ulong n
v = add mul get l i f c
put l i rem v FMB
c = div v FMB
end
k = n
while gt c 0 bound 130
put l k rem c FMB
c = div c FMB
k = add k 1
end
ret k
end
fn fm_ndig v ulong to ulong
n = ulong 1
x = div v 10
while gt x 0 bound 20
n = add n 1
x = div x 10
end
ret n
end
note fm_tod writes the limbs l 0..n-1 as decimal digits (the top limb without leading zeros) at d p.
note fm_wd writes the w low decimal digits of x at d p..p+w-1, most significant first.
fn fm_wd d edit uchar 1200 p ulong w ulong x ulong to ulong
k = add p w
v = x
for i ulong w
k = sub k 1
put d k uchar add 48 rem v 10
v = div v 10
end
ret add p w
end
fn fm_tod l edit ulong 130 n ulong d edit uchar 1200 p ulong to ulong
x = get l sub n 1
q = fm_wd d p fm_ndig x x
j = sub n 1
while gt j 0 bound 130
j = sub j 1
q = fm_wd d q 9 get l j
end
ret q
end
note fm_big: |x| = m 2^k as the integer m 2^k (k >= 0) or m 5^s with s fraction digits (k = -s);
note the limbs go to l 0..n-1, s to l 129; returns n with no zero top limb above limb 0.
fn fm_big l edit ulong 130 b ulong to ulong
e = and shr b 52 2047
m = and b 4503599627370495
s = ulong 1074
if ne e 0
m = or m 4503599627370496
s = sub ulong 1075 e
end
put l 0 rem m FMB
put l 1 rem div m FMB FMB
n = ulong 2
if ge e 1075
k = sub e 1075
s = ulong 0
while ge k 29 bound 40
n = fm_mul l n 536870912
k = sub k 29
end
n = fm_mul l n shl ulong 1 k
end
put l 129 s
k = s
while ge k 13 bound 90
n = fm_mul l n 1220703125
k = sub k 13
end
f = ulong 1
for i ulong k
f = mul f 5
end
n = fm_mul l n f
while gt n 1 bound 130
if ne get l sub n 1 0
break
end
n = sub n 1
end
ret n
end
fn fm_dig x f64 d edit uchar 1200 to ulong
l = new ulong 130 0
n = fm_big l bitcast ulong x
s = get l 129
t = add fm_ndig get l sub n 1 mul 9 sub n 1
if eq s 0
q = fm_tod l n d 0
ret shl q 16
end
if gt t s
q = fm_tod l n d 0
ret or shl sub q s 16 s
end
put d 0 uchar 48
z = sub s t
for i ulong z
put d add i 1 uchar 48
end
q = fm_tod l n d add z 1
ret or shl sub q s 16 s
end
note fm_at: digit i of a string of n digits, '0' past its end.
fn fm_at d edit uchar 1200 n ulong i ulong to ulong
if lt i n
ret ulong get d i
end
ret ulong 48
end
note fm_rup: 1 when keeping digits 0..q-1 of the n digits rounds up (ties to even).
fn fm_rup d edit uchar 1200 n ulong q ulong to ulong
if ge q n
ret ulong 0
end
c = ulong get d q
if gt c 53
ret ulong 1
end
if lt c 53
ret ulong 0
end
j = add q 1
while lt j n bound 1200
if ne get d j uchar 48
ret ulong 1
end
j = add j 1
end
if eq q 0
ret ulong 0
end
ret and sub ulong get d sub q 1 48 1
end
note fm_inc adds one at digit q-1; 1 when the carry leaves digit 0.
fn fm_inc d edit uchar 1200 q ulong to ulong
j = q
while gt j 0 bound 1200
j = sub j 1
c = get d j
if eq c uchar 57
put d j uchar 48
else
put d j uchar add c 1
ret ulong 0
end
end
ret ulong 1
end
note fm_sp: inf/nan text; returns the new length, or 0 when x is finite. Sign printed for -inf and -nan.
fn fm_sp x f64 o edit uchar 1600 to ulong
b = bitcast ulong x
if ne and shr b 52 2047 2047
ret ulong 0
end
p = ulong 0
if ne shr b 63 0
put o 0 uchar 45
p = ulong 1
end
if eq and b 4503599627370495 0
put o p uchar 105
put o add p 1 uchar 110
put o add p 2 uchar 102
ret add p 3
end
put o p uchar 110
put o add p 1 uchar 97
put o add p 2 uchar 110
ret add p 3
end
note fm_f: printf("%.Pf", x) into o; returns the length.
fn fm_f x f64 pr ulong o edit uchar 1600 to ulong
r = fm_sp x o
if ne r 0
ret r
end
d = new uchar 1200 0
r = fm_dig x d
ip = shr r 16
n = add ip and r 65535
q = add ip pr
p = ulong 0
if ne shr bitcast ulong x 63 0
put o 0 uchar 45
p = ulong 1
end
if ne fm_rup d n q 0
if ne fm_inc d q 0
put o p uchar 49
p = add p 1
end
end
for i ulong ip
put o p get d i
p = add p 1
end
if eq pr 0
ret p
end
put o p uchar 46
p = add p 1
for i ulong pr
put o p uchar fm_at d n add ip i
p = add p 1
end
ret p
end
note fm_frst: index of the first nonzero digit of 0..n-1, n when there is none.
fn fm_frst d edit uchar 1200 n ulong to ulong
z = ulong 0
while lt z n bound 1200
if ne get d z uchar 48
ret z
end
z = add z 1
end
ret n
end
note fm_e2: the exponent of the e style: sign and at least two digits of |X|. xn is 1 when X < 0.
fn fm_e2 o edit uchar 1600 p ulong xn ulong xa ulong to ulong
put o p uchar 101
q = add p 1
if ne xn 0
put o q uchar 45
else
put o q uchar 43
end
q = add q 1
if lt xa 10
put o q uchar 48
q = add q 1
end
w = fm_ndig xa
k = add q w
x = xa
for i ulong w
k = sub k 1
put o k uchar add 48 rem x 10
x = div x 10
end
ret add q w
end
note fm_gd: R digit i of %g (digits d z.. of n); after a carry out of digit 0, 1 then zeros.
fn fm_gd d edit uchar 1200 n ulong z ulong c ulong i ulong to ulong
if ne c 0
if eq i 0
ret ulong 49
end
ret ulong 48
end
ret fm_at d n add z i
end
note fm_rd moves the pr digits R of %g to d 0..pr-1 (reads d z+i at or after the write at i).
fn fm_rd d edit uchar 1200 n ulong z ulong c ulong pr ulong to ulong
for i ulong pr
put d i uchar fm_gd d n z c i
end
ret pr
end
note fm_ges: e style of the k kept digits d 0..k-1 with exponent xs (see fm_ge) at o p.
fn fm_ges o edit uchar 1600 p ulong d edit uchar 1200 k ulong xs ulong to ulong
put o p get d 0
q = add p 1
if gt k 1
put o q uchar 46
q = add q 1
for i ulong sub k 1
put o q get d add i 1
q = add q 1
end
end
ret fm_e2 o q and xs 1 shr xs 1
end
note fm_gfs: f style of the k kept digits d 0..k-1 with exponent xs (see fm_ge) at o p.
fn fm_gfs o edit uchar 1600 p ulong d edit uchar 1200 k ulong xs ulong to ulong
xa = shr xs 1
q = p
if ne and xs 1 0
put o q uchar 48
put o add q 1 uchar 46
q = add q 2
for i ulong sub xa 1
put o q uchar 48
q = add q 1
end
for i ulong k
put o q get d i
q = add q 1
end
ret q
end
for i ulong add xa 1
put o q get d i
q = add q 1
end
if gt k add xa 1
put o q uchar 46
q = add q 1
for i ulong sub sub k xa 1
put o q get d add add xa 1 i
q = add q 1
end
end
ret q
end
note fm_ge emits R = d 0..pr-1 with exponent X (xs = 2 |X| + 1 when X < 0, else 2 X) at o p.
note e style when X < -4 or X >= pr; trailing fraction zeros removed; returns the length.
fn fm_ge o edit uchar 1600 p ulong d edit uchar 1200 pr ulong xs ulong to ulong
xa = shr xs 1
el = ulong 0
if ne and xs 1 0
if gt xa 4
el = ulong 1
end
else
if ge xa pr
el = ulong 1
end
end
k = pr
while gt k 1 bound 1200
if ne get d sub k 1 uchar 48
break
end
k = sub k 1
end
note k is the count of R digits that survive trailing-zero removal (at least 1).
if ne el 0
ret fm_ges o p d k xs
end
ret fm_gfs o p d k xs
end
note fm_g: printf("%.Pg", x) into o (P 0 counts as 1); returns the length. The P significant digits are
note rounded at the first nonzero digit z; the exponent X = ip - 1 - z after rounding picks the style.
fn fm_g x f64 pr ulong o edit uchar 1600 to ulong
r = fm_sp x o
if ne r 0
ret r
end
if eq pr 0
pr = ulong 1
end
d = new uchar 1200 0
r = fm_dig x d
ip = shr r 16
n = add ip and r 65535
p = ulong 0
if ne shr bitcast ulong x 63 0
put o 0 uchar 45
p = ulong 1
end
z = fm_frst d n
if eq z n
put o p uchar 48
ret add p 1
end
q = add z pr
c = ulong 0
if ne fm_rup d n q 0
c = fm_inc d q
end
note after a carry out of digit 0 the digits are 1 0..0 one place up: the leading 1 sits at index -1,
note so X = ip. Otherwise X = ip - 1 - z for the first nonzero rounded digit z.
xs = shl ip 1
if eq c 0
z = fm_frst d q
if lt z ip
xs = shl sub sub ip 1 z 1
else
xs = or shl add sub z ip 1 1 1
end
end
r = fm_rd d n z c pr
ret fm_ge o p d r xs
end

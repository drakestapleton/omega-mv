note dc_ref: the FAIL line of a refused GPU g (facts base g). The first line is the refusal text after
note "GPU <bdf>: " up to its first newline (to its end when that newline is inside the prefix, as printf
note "%.*s" with a negative precision prints all); the rest goes to dc_more.
fn dc_ref o edit uchar 786432 p ulong f view ulong 256 b view uchar 262144 st edit ulong 4 g ulong to ulong
at = get f add g 4
n = get f add g 5
e = add at n
fi = add add at 6 get f add g 1
nl = at
while lt nl e bound 262145
if eq get b nl uchar 10
break
end
nl = add nl 1
end
if ge nl e
put st 2 2
ret p
end
if gt fi e
put st 2 2
ret p
end
p = dc_tag o p st 0
note s "GPU "
p = dc_s o p 542462023 4
p = dc_ft o p f b g
note s ": "
p = dc_s o p 8250 2
if ge nl fi
p = dc_cp o p b fi sub nl fi
else
p = dc_cp o p b fi sub e fi
end
put o p uchar 10
p = add p 1
ret dc_more o p b add nl 1 sub e add nl 1
end

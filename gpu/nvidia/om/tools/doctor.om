note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note doctor: the checklist decisions and text of tools/doctor/cudapp_doctor.c. The C shell probes (fopen and
note fgets of the version file, access of the device files and nvcc paths, the PCI scan and chip table, the
note meminfo sscanf, uname) and passes the facts here; this unit picks every line, parses the module
note version, formats the memory figures (fmt.om) and counts the FAIL lines.
note facts f (ulong 256), texts in the blob b (uchar 262144) as offset and length pairs:
note 0,1 root; 2,3 ABI; 4,5 compiler; 6 uname ok; 7..12 sysname, release, machine; 13 version file read;
note 14,15 its first line; 16..18 nvidiactl, nvidia0, nvidia-uvm (0 ok, 1 missing, 2 not rw); 19 GPU count
note (at most 16); 20 PCI scan failed; 21 meminfo read; 22 MemTotal kB; 23 MemAvailable kB; 24 nvcc
note (0 none, 1 /usr/local/cuda/bin/nvcc, 2 /usr/bin/nvcc). GPU i at 32 + 12 i: 0,1 bdf; 2 in the chip
note table; 3 device is GB10 (0x2e12); 4..9 name, sm, receipt when known, else 4,5 the refusal text.
note Returns fails * 2^32 + output length, or 2^63 + 1 when the ABI or compiler text holds % or a newline
note (the C printed them as part of a printf format), 2^63 + 2 when a refusal text has no newline or is
note shorter than its "GPU <bdf>: " prefix.
const DCGPU ulong 32
const DCMB f64 1048576.0
fn dc_s o edit uchar 786432 p ulong w ulong n ulong to ulong
i = ulong 0
while lt i n bound 9
put o add p i uchar and shr w mul i 8 255
i = add i 1
end
ret add p n
end
fn dc_cp o edit uchar 786432 p ulong b view uchar 262144 at ulong n ulong to ulong
for i ulong n
put o add p i get b add at i
end
ret add p n
end
fn dc_ft o edit uchar 786432 p ulong f view ulong 256 b view uchar 262144 i ulong to ulong
ret dc_cp o p b get f i get f add i 1
end
fn dc_u o edit uchar 786432 p ulong v ulong to ulong
w = fm_ndig v
k = add p w
x = v
for i ulong w
k = sub k 1
put o k uchar add 48 rem x 10
x = div x 10
end
ret add p w
end
note dc_tag: "  %-5s " of FAIL (0), warn (1), ok (2), info (3); a FAIL counts in st 0.
fn dc_tag o edit uchar 786432 p ulong st edit ulong 4 t ulong to ulong
if eq t 0
put st 0 add get st 0 1
note s "  FAIL  "
p = dc_s o p 2314934085979873312 8
ret p
end
if eq t 1
note s "  warn  "
p = dc_s o p 2314971646008959008 8
ret p
end
if eq t 2
note s "  ok    "
p = dc_s o p 2314885532081922080 8
ret p
end
note s "  info  "
p = dc_s o p 2314972694198165536 8
ret p
end
note dc_more: one line "        <segment>" per newline-ended segment of b at..at+n-1, plus the last one when
note it is not empty (the C loop stops at the terminating zero).
fn dc_more o edit uchar 786432 p ulong b view uchar 262144 at ulong n ulong to ulong
s = at
e = add at n
while lt s e bound 262145
note s "        "
p = dc_s o p 2314885530818453536 8
k = s
while lt k e bound 262145
if eq get b k uchar 10
break
end
k = add k 1
end
p = dc_cp o p b s sub k s
put o p uchar 10
p = add p 1
s = add k 1
end
ret p
end
note dc_m8: 1 when b pos.. holds the n (<= 8) bytes of the little-endian word w before e.
fn dc_m8 b view uchar 262144 pos ulong e ulong w ulong n ulong to ulong
if gt add pos n e
ret ulong 0
end
for i ulong n
if ne ulong get b add pos i and shr w mul i 8 255
ret ulong 0
end
end
ret ulong 1
end
note dc_bad: 1 when the text at..at+n-1 holds % or a newline.
fn dc_bad b view uchar 262144 at ulong n ulong to ulong
for i ulong n
c = get b add at i
if eq c uchar 37
ret ulong 1
end
if eq c uchar 10
ret ulong 1
end
end
ret ulong 0
end
note dc_mstart: index of the first "Module" in at..e-1 (strstr), at when there is none.
fn dc_mstart b view uchar 262144 at ulong e ulong to ulong
s = at
while lt s e bound 262145
note s "Module"
if ne dc_m8 b s e 111516500389709 6 0
ret s
end
s = add s 1
end
ret at
end
note dc_open: 1 when at..e-1 contains "Open Kernel Module".
fn dc_open b view uchar 262144 at ulong e ulong to ulong
s = at
while lt s e bound 262145
note s "Open Ker" "nel Modu" "le"
a = dc_m8 b s e 8243077295634739279 8
c = dc_m8 b add s 8 e 8459008377155773806 8
d = dc_m8 b add s 16 e 25964 2
if ne and and a c d 0
ret ulong 1
end
s = add s 1
end
ret ulong 0
end
fn dc_dig c ulong to ulong
if ge c 48
if le c 57
ret ulong 1
end
end
ret ulong 0
end
note dc_ver: the first run of digits and dots after "Module" (or from the start) with more than two bytes,
note a dot and fewer than 64 bytes: returns its offset * 256 + length, 0 when there is none.
fn dc_ver b view uchar 262144 at ulong n ulong to ulong
e = add at n
s = dc_mstart b at e
while lt s e bound 262145
if ne dc_dig ulong get b s 0
k = ulong 0
dt = ulong 0
while lt add s k e bound 262145
c = ulong get b add s k
if eq c 46
dt = ulong 1
else
if eq dc_dig c 0
break
end
end
k = add k 1
end
if gt k 2
if ne dt 0
if lt k 64
ret or shl s 8 k
end
end
end
s = add s sub k 1
end
s = add s 1
end
ret ulong 0
end
note dc_eq: 1 when the texts at a (length n) and at c (length m) are equal.
fn dc_eq b view uchar 262144 a ulong n ulong c ulong m ulong to ulong
if ne n m
ret ulong 0
end
for i ulong n
if ne get b add a i get b add c i
ret ulong 0
end
end
ret ulong 1
end
fn dc_abi o edit uchar 786432 p ulong f view ulong 256 b view uchar 262144 to ulong
ret dc_ft o p f b 2
end

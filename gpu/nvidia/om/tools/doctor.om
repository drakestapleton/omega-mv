fn doctor f view ulong 256 b view uchar 262144 o edit uchar 786432 to ulong
if ne or dc_bad b get f 2 get f 3 dc_bad b get f 4 get f 5 0
ret or shl ulong 1 63 1
end
st = new ulong 4 0
p = dc_head o 0 f b st
p = dc_mod o p f b st
p = dc_nod o p f st
p = dc_gpu o p f b st
if ne get st 2 0
ret or shl ulong 1 63 2
end
p = dc_mem o p f st
p = dc_tk o p f b st
nf = get st 0
p = dc_foot o p nf
ret or shl nf 32 p
end

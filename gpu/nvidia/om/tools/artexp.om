p = ae_s o p 4992275802573599843 8
p = ae_s o p 2338623226871881816 8
p = ae_s o p 3251696002696303184 8
p = ae_s o p 2338610025220498221 8
p = ae_s o p 173557064 4
note s "       artifact-export attention --q-heads H --kv-heads H --contract-id HEX --out PREFIX --commit HEX\n"
p = ae_s o p 6998629143283769376 8
p = ae_s o p 3275352098986357874 8

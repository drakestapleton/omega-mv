note ae_exit: the text o 0..p - 1 to stderr and exit status e.
fn ae_exit s edit ulong 128 p ulong e ulong to ulong
put s 0 99
put s 25 e
ret add 2 shl p 8
end
fn ae_usage s edit ulong 128 o edit uchar 262144 to ulong
ret ae_exit s ae_usg o 0 2
end
note ae_ctr: the commit and frozen-contract refusals; 0 when the arguments pass them.
fn ae_ctr s edit ulong 128 o edit uchar 262144 to ulong
if or or eq get s 6 0 eq get s 7 0 eq get s 8 0
ret ae_usage s o
end
p = ulong 0
if or eq get s 10 0 eq get s 11 0
note s "--commit must be a 40-hex source revision\n"
p = ae_s o p 8388356097741892909 8
p = ae_s o p 7305437230073736480 8
p = ae_s o p 7307140080464847136 8
p = ae_s o p 7305808869231632504 8
p = ae_s o p 8028074707559739936 8
p = ae_s o p 2670 2
ret ae_exit s ae_usg o p 2
end
if eq get s 12 0
note s "--commit must be lowercase 40-hex\n"
p = ae_s o p 8388356097741892909 8
p = ae_s o p 7305437230073736480 8
p = ae_s o p 7017578424494418976 8
p = ae_s o p 7307140080464848243 8
p = ae_s o p 2680 2
ret ae_exit s p 2
end
md = get s 5
if eq md 1
if ne get s 9 1
note s "contract id is not matmul-bf16-v1\n"
p = ae_s o p 8386654075301556067 8
p = ae_s o p 7935469438779025696 8
p = ae_s o p 8461547236690523247 8
p = ae_s o p 8515522056226483564 8
p = ae_s o p 2609 2
ret ae_exit s p 3
end
b = ulong 0
if gt get s 13 8192
b = ulong 1
end
if gt get s 14 16384
b = ulong 1
end
if gt get s 15 8192
b = ulong 1
end
if ne b 0
note s "shape outside matmul-bf16-v1 bounds (m<=8192,k<=16384,n<=8192)\n"
p = ae_s o p 8462017844901668979 8
p = ae_s o p 7020303013988889460 8
p = ae_s o p 3559640502715641204 8
p = ae_s o p 8462090115260755254 8
p = ae_s o p 4412521754026796142 8
p = ae_s o p 4412519572481585464 8
p = ae_s o p 4354466492506650161 8
p = ae_s o p 2860045451737149 7
ret ae_exit s p 3
end
end
if eq md 2
if ne get s 9 2
note s "contract id is not gqa-causal-v1\n"
p = ae_s o p 8386654075301556067 8
p = ae_s o p 7935469438779025696 8
p = ae_s o p 7146475323396224111 8
p = ae_s o p 3564086098625000801 8
p = ae_s o p 10 1
ret ae_exit s p 3
end
b = ulong 0
if gt get s 16 64
b = ulong 1
end
if gt get s 17 64
b = ulong 1
end
if ne b 0
note s "heads outside gqa-causal-v1 bounds (hq<=64,hkv<=64)\n"
p = ae_s o p 8462017904829883752 8
p = ae_s o p 8171535668735472500 8
p = ae_s o p 7809650176819408225 8
p = ae_s o p 7959390383684810285 8
p = ae_s o p 4412526427079996260 8
p = ae_s o p 4412531938597549110 8
p = ae_s o p 170472502 4
ret ae_exit s p 3
end
end
ret ulong 0
end
note ae_mm: the matmul shape checks; returns the spec-init request.
fn ae_mm s edit ulong 128 o edit uchar 262144 to ulong
m = get s 13
k = get s 14
n = get s 15
if or or eq m 0 eq k 0 eq n 0
ret ae_usage s o
end
b = ulong 0
if ne rem m 16 0
b = ulong 1
end
if ne rem n 8 0
b = ulong 1
end
if ne rem k 16 0
b = ulong 1
end
if ne b 0
p = ulong 0
note s "matmul-bf16-v1 export needs m%16 == 0, n%8 == 0, k%16 == 0 (got "
p = ae_s o p 7074429841272234349 8
p = ae_s o p 7286878580719890790 8
p = ae_s o p 7308814929777094776 8
p = ae_s o p 3904943502533026917 8
p = ae_s o p 7935391128637750560 8
p = ae_s o p 3184080383941556261 8
p = ae_s o p 4412718627017812768 8
p = ae_s o p 2338616595357642784 8
p = ae_u o p m
put o p uchar 120
p = ae_u o add p 1 k
put o p uchar 120
p = ae_u o add p 1 n
note s ")\n"
p = ae_s o p 2601 2
ret ae_exit s p 3
end
put s 0 5
ret ulong 3
end
note ae_at: the attention head checks and the GQA ratio; returns the attention code request.
fn ae_at s edit ulong 128 o edit uchar 262144 to ulong
hq = get s 16
hk = get s 17
if or eq hq 0 eq hk 0
ret ae_usage s o
end
if ne rem hq hk 0
ret ae_usage s o
end
r = div hq hk
l = ulong 0
while lt shl ulong 1 l r bound 64
l = add l 1
end
if ne shl ulong 1 l r
p = ulong 0
note s "GQA ratio is not a power of two\n"
p = ae_s o p 7598805614076186951 8
p = ae_s o p 8390045716468801647 8
p = ae_s o p 8243126013477806368 8
p = ae_s o p 751951003437657888 8
ret ae_exit s p 3
end
put s 20 l
put s 0 8
ret ulong 8
end
note ae_chk: every check after the last argument.
fn ae_chk s edit ulong 128 o edit uchar 262144 to ulong
x = ae_ctr s o
if ne x 0
ret x
end
md = get s 5
if eq md 1
ret ae_mm s o
end
if eq md 2
ret ae_at s o
end
ret ae_usage s o
end
fn ae_msg s edit ulong 128 o edit uchar 262144 w ulong n ulong to ulong
p = ae_s o 0 w n
ret ae_exit s p 3
end
fn ae_prm s edit ulong 128 i ulong off ulong sz ulong pt ulong to ulong
put s add 64 i or or off shl sz 16 shl pt 32
ret ulong 0
end
fn ae_cfg s edit ulong 128 tb ulong gx ulong gy ulong el ulong sh ulong to ulong
put s 32 tb
put s 33 tb
put s 34 gx
put s 35 gy
put s 36 el
put s 37 sh
put s 40 gx
put s 41 gy
put s 42 tb
put s 43 1
put s 44 1
put s 45 sh
put s 0 10
ret ulong 0
end
note ae_mmcfg: the matmul launch: CTA (x, y) over 16 x 8 tiles, 32 threads, 1024 shared bytes, three pointer
note parameters at 0x380, 10 cbank words.
fn ae_mmcfg s edit ulong 128 to ulong
m = get s 13
gy = div m 16
el = and mul m get s 15 4294967295
gx = get s 19
x = ae_cfg s 32 gx gy el 1024
put s 46 10
put s 47 3
for i ulong 3
x = ae_prm s i add 896 mul i 8 8 1
end
ret ulong 7
end
note ae_atcfg: the attention launch: 128 threads, q-heads / heads-per-CTA CTAs, (3 * hpc + 1) * 128 * 4 shared
note bytes, four pointers at 0x380 then eight u32 at 0x3a0, 16 cbank words.
fn ae_atcfg s edit ulong 128 to ulong
hq = get s 16
hp = get s 21
sh = add mul 3 hp 1
sh = and mul sh 512 4294967295
gx = div hq hp
el = and mul hq 128 4294967295
x = ae_cfg s 128 gx 1 el sh
put s 46 16
put s 47 12
for i ulong 4
x = ae_prm s i add 896 mul i 8 8 1
end
for i ulong 8
x = ae_prm s add 4 i add 928 mul i 4 4 0
end
ret ulong 11
end
fn ae_spec s edit ulong 128 t view uchar 262144 to ulong
for i ulong 4
w = ulong 0
for j ulong 8
c = ulong get t add mul i 8 j
w = or w shl c mul j 8
end
put s add 80 i w
end
ret ulong 0
end
note ae_stext: "omega-attention-spec/1\nhead_dim=128\nq_heads=%u\nkv_heads=%u\nlog2_gqa=%u\n", hashed by
note the shell.
fn ae_stext s edit ulong 128 o edit uchar 262144 to ulong
p = ulong 0
note s "omega-attention-spec/1\nhead_dim=128\nq_heads="
p = ae_s o p 8386033877510352239 8
p = ae_s o p 3273676477860570484 8
p = ae_s o p 7496858609312428147 8
p = ae_s o p 4426309888593125733 8
p = ae_s o p 7307195334516027953 8
p = ae_s o p 1030972513 4
p = ae_u o p get s 16
note s "\nkv_heads="
p = ae_s o p 7233173975486327562 8
p = ae_s o p 15731 2
p = ae_u o p get s 17
note s "\nlog2_gqa="
p = ae_s o p 8171604718975413258 8
p = ae_s o p 15713 2
p = ae_u o p get s 20
put o p uchar 10
put s 0 9
ret add 9 shl add p 1 8
end
fn ae_hex o edit uchar 262144 p ulong s view ulong 128 to ulong
q = p
for i ulong 32
w = get s add 80 div i 8
b = and shr w mul rem i 8 8 255
for j ulong 2
d = shr b mul sub 1 j 4
d = and d 15
if lt d 10
put o q uchar add 48 d
else
put o q uchar add 87 d
end
q = add q 1
end
end
put o q uchar 0
ret add q 1
end
note ae_mmtx: the matmul manifest texts up to the bounds.
fn ae_mmtx s edit ulong 128 o edit uchar 262144 to ulong
p = ulong 0
note s "matmul\0matmul-bf16-v1\0bf16\0fp32\0abs<=1e-5*max(1,abs(ref))\0m="
p = ae_s o p 7854397001737462125 8
p = ae_s o p 7377509083436119137 8
p = ae_s o p 7377459352022365745 8
p = ae_s o p 14130306676176433 8
p = ae_s o p 3271074843431494241 8
p = ae_s o p 3184370909023382069 8
p = ae_s o p 2983183344158859873 8
p = ae_s o p 1030553641 4
p = ae_u o p get s 13
note s ",k="
p = ae_s o p 4025132 3
p = ae_u o p get s 14
note s ",n="
p = ae_s o p 4025900 3
p = ae_u o p get s 15
note s "\0m<=8192,k<=16384,n<=8192\0"
p = ae_s o p 3618977893184204032 8
p = ae_s o p 4049640075044875052 8
p = ae_s o p 4121136969678728244 8
p = ae_s o p 50 2
p = ae_hex o p s
note s "omega_matmul_bf16\0"
p = ae_s o p 7020372266091638127 8
p = ae_s o p 3559640717464006004 8
p = ae_s o p 54 2
ret p
end

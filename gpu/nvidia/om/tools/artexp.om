note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note artexp: the decisions of tools/artifact_export.c (offline handoff of one CUDApp GPU realization).
note This unit reads the command line one argument at a time, checks it against the frozen v1
note contracts, picks the kernel and its launch shape, writes the attention semantic-spec text, the
note manifest strings and every message, and decides the exit status. The C shell keeps the library
note calls (spec init, code generation, cbank arguments, SHA-256, register declaration, QMD templates,
note export) and the writes to stdout and stderr; it calls them when this unit asks.
note facts f (ulong 8): 0 OMEGA_GPU_MATMUL_MAX_CTAS, 1 OMEGA_ARTIFACT_OK.
note token t: the shell copies argv[s 1] (NUL included, at most 131072 bytes) when asked (return 1), the
note 32 hash bytes (returns 6, 9), or after the export the NUL-separated texts (return 14).
note state s (ulong 128, all 0 at the start; the shell writes 2 and 3 once, 18, 21..24 after calls):
note 0 phase, 1 argument index, 2 length of argv[s 1], 3 argc, 4 pending flag, 5 mode (1 matmul,
note 2 attention), 6 --out index, 7 --contract-id index, 8 its length is 64, 9 the frozen id it names
note (1 matmul-bf16-v1, 2 gqa-causal-v1), 10 --commit index, 11 its length is 40, 12 it is lowercase
note hex, 13 m, 14 k, 15 n, 16 q-heads, 17 kv-heads, 18 rc of the last call (int64 bits), 19 grid x of
note the matmul, 20 log2 GQA, 21 heads per CTA, 22 register peak, 23 declared registers, 24 declared ok,
note 25 exit status; QMD config 32 threads per block, 33 threads x, 34 grid x, 35 grid y,
note 36 elements, 37 shared bytes, 38 registers; manifest 40 grid x, 41 grid y, 42..44 block x y z,
note 45 shared bytes, 46 cbank words, 47 parameter count; 64..75 parameters (offset | size << 16 |
note pointer << 32); 80..83 the semantic spec id (32 bytes, little-endian words).
note Returns: 1 load argv[s 1] into t and s 2; 2 + 256 * length: o to stderr, exit s 25;
note 3 omega_matmul_spec_init(m, k, n, BF16); 4 omega_blackwell_codegen_matmul; 5 ..._matmul_tensor_loop
note with grid s 19; 6 the spec id into t; 7 the matmul cbank arguments; 8 the attention code with
note log2 GQA s 20; 9 + 256 * length: SHA-256 of o into t; 10 heads per CTA into s 21; 11 cbank word 14 =
note q-heads; 12 registers into s 22..24; 13 the QMD templates (rc 1 when either refuses); 14 the export
note with the 13 NUL-separated manifest texts in o; 15 + 256 * length: o to stdout, exit 0; 0 abort.
fn ae_s o edit uchar 262144 p ulong w ulong n ulong to ulong
i = ulong 0
while lt i n bound 9
put o add p i uchar and shr w mul i 8 255
i = add i 1
end
ret add p n
end
fn ae_nd v ulong to ulong
n = ulong 1
x = div v 10
while ne x 0 bound 20
n = add n 1
x = div x 10
end
ret n
end
fn ae_u o edit uchar 262144 p ulong v ulong to ulong
w = ae_nd v
k = add p w
x = v
for i ulong w
k = sub k 1
put o k uchar add 48 rem x 10
x = div x 10
end
ret add p w
end
note ae_d: %d of an int held as int64 bits.
fn ae_d o edit uchar 262144 p ulong v ulong to ulong
if ne and shr v 63 1 0
put o p uchar 45
ret ae_u o add p 1 sub ulong 0 v
end
ret ae_u o p v
end
note ae_cp: the NUL-terminated text of t at at, appended at p; returns p after it.
fn ae_cp o edit uchar 262144 p ulong t view uchar 262144 at ulong to ulong
q = p
i = at
while lt i 262144 bound 262144
c = get t i
if eq c uchar 0
break
end
put o q c
q = add q 1
i = add i 1
end
ret q
end
note ae_skip: the offset after the NUL-terminated text of t at at.
fn ae_skip t view uchar 262144 at ulong to ulong
i = at
while lt i 262144 bound 262144
if eq get t i uchar 0
ret add i 1
end
i = add i 1
end
ret i
end
fn ae_m8 t view uchar 262144 pos ulong w ulong n ulong to ulong
for i ulong n
if ne ulong get t add pos i and shr w mul i 8 255
ret ulong 0
end
end
ret ulong 1
end
note ae_hx: the value of a hex digit, 99 for any other byte.
fn ae_hx c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
if and ge c 65 le c 70
ret sub c 55
end
ret ulong 99
end
fn ae_sp c ulong to ulong
if eq c 32
ret ulong 1
end
if and ge c 9 le c 13
ret ulong 1
end
ret ulong 0
end
note ae_num: num() of the C, strtoul(s, &e, 0) in the C locale kept when it ends the text and is at most
note 0xffffffff, else 0: spaces, a sign, 0x/0X hex when a hex digit follows, 0 octal, decimal; an
note overflow (ULONG_MAX) is 0; a minus sign negates modulo 2^64.
fn ae_num t view uchar 262144 n ulong to ulong
i = ulong 0
while lt i n bound 262144
if eq ae_sp ulong get t i 0
break
end
i = add i 1
end
ng = ulong 0
if lt i n
c = ulong get t i
if eq c 43
i = add i 1
end
if eq c 45
ng = ulong 1
i = add i 1
end
end
b = ulong 10
if lt i n
if eq get t i uchar 48
b = ulong 8
if lt add i 2 n
c = ulong get t add i 1
if or eq c 120 eq c 88
if lt ae_hx ulong get t add i 2 16
b = ulong 16
i = add i 2
end
end
end
end
end
st = i
v = ulong 0
ov = ulong 0
while lt i n bound 262144
d = ae_hx ulong get t i
if ge d b
break
end
if gt v div sub sub ulong 0 1 d b
ov = ulong 1
end
v = add mul v b d
i = add i 1
end
if or eq i st ne i n
ret ulong 0
end
if ne ov 0
ret ulong 0
end
if ne ng 0
v = sub ulong 0 v
end
if gt v 4294967295
ret ulong 0
end
ret v
end
note ae_flag: 1 --out, 2 --contract-id, 3 --commit, 4 --m, 5 --k, 6 --n, 7 --q-heads, 8 --kv-heads, 0 other.
fn ae_flag t view uchar 262144 n ulong to ulong
note s "--out"
e = ulong 0
if eq n 5
e = ulong 1
e = and e ae_m8 t 0 500186426669 5
end
if ne e 0
ret ulong 1
end
note s "--contract-id"
e = ulong 0
if eq n 13
e = ulong 1
e = and e ae_m8 t 0 7021802786688019757 8
e = and e ae_m8 t 8 431261316195 5
end
if ne e 0
ret ulong 2
end
note s "--commit"
e = ulong 0
if eq n 8
e = ulong 1
e = and e ae_m8 t 0 8388356097741892909 8
end
if ne e 0
ret ulong 3
end
note s "--m"
e = ulong 0
if eq n 3
e = ulong 1
e = and e ae_m8 t 0 7154989 3
end
if ne e 0
ret ulong 4
end
note s "--k"
e = ulong 0
if eq n 3
e = ulong 1
e = and e ae_m8 t 0 7023917 3
end
if ne e 0
ret ulong 5
end
note s "--n"
e = ulong 0
if eq n 3
e = ulong 1
e = and e ae_m8 t 0 7220525 3
end
if ne e 0
ret ulong 6
end
note s "--q-heads"
e = ulong 0
if eq n 9
e = ulong 1
e = and e ae_m8 t 0 7233173974647123245 8
e = and e ae_m8 t 8 115 1
end
if ne e 0
ret ulong 7
end
note s "--kv-heads"
e = ulong 0
if eq n 10
e = ulong 1
e = and e ae_m8 t 0 7018130138796338477 8
e = and e ae_m8 t 8 29540 2
end
if ne e 0
ret ulong 8
end
ret ulong 0
end
fn ae_mode t view uchar 262144 n ulong to ulong
note s "matmul"
e = ulong 0
if eq n 6
e = ulong 1
e = and e ae_m8 t 0 119251603317101 6
end
if ne e 0
ret ulong 1
end
note s "attention"
e = ulong 0
if eq n 9
e = ulong 1
e = and e ae_m8 t 0 8028075828261975137 8
e = and e ae_m8 t 8 110 1
end
if ne e 0
ret ulong 2
end
ret ulong 0
end
fn ae_cid t view uchar 262144 n ulong to ulong
note s "647116fc1ba1e1394982fc8ba181ce565293f160a6b56afc0f02b2128a675704"
e = ulong 0
if eq n 64
e = ulong 1
e = and e ae_m8 t 0 7162471842286351414 8
e = and e ae_m8 t 8 4121692394664059441 8
e = and e ae_m8 t 16 7077516104993093940 8
e = and e ae_m8 t 24 3906139728515707233 8
e = and e ae_m8 t 32 3474018477578727989 8
e = and e ae_m8 t 40 7162519142831109729 8
e = and e ae_m8 t 48 3616727373085435440 8
e = and e ae_m8 t 56 3760566390553469240 8
end
if ne e 0
ret ulong 1
end
note s "003696e422bba7274877ba9e01a61076ea0f862f32760cbaa06c60f85a115359"
e = ulong 0
if eq n 64
e = ulong 1
e = and e ae_m8 t 0 3775483481970389040 8
e = and e ae_m8 t 8 3977302312323527218 8
e = and e ae_m8 t 16 7293968145964283956 8
e = and e ae_m8 t 24 3906644189691064624 8
e = and e ae_m8 t 32 7364007956564697445 8
e = and e ae_m8 t 40 7017280228115821107 8
e = and e ae_m8 t 48 4063988723899314273 8
e = and e ae_m8 t 56 4122257337479160117 8
end
if ne e 0
ret ulong 2
end
ret ulong 0
end
fn ae_lhex t view uchar 262144 n ulong to ulong
for i ulong n
c = ulong get t i
if not or and ge c 48 le c 57 and ge c 97 le c 102
ret ulong 0
end
end
ret ulong 1
end
note ae_val: the value after a flag.
fn ae_val s edit ulong 128 t view uchar 262144 to ulong
k = get s 4
i = get s 1
n = get s 2
if eq k 1
put s 6 i
end
if eq k 2
put s 7 i
put s 8 ulong 0
if eq n 64
put s 8 ulong 1
end
put s 9 ae_cid t n
end
if eq k 3
put s 10 i
put s 11 ulong 0
if eq n 40
put s 11 ulong 1
end
put s 12 ae_lhex t n
end
if ge k 4
put s add 9 k ae_num t n
end
ret ulong 0
end
fn ae_usg o edit uchar 262144 p ulong to ulong
note s "usage: artifact-export matmul --m M --k K --n N --contract-id HEX --out PREFIX --commit HEX\n"

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Composed after dag_res.om. a: why,index,status,record,count; counts 10..14.
fn dd_cons m view ulong 16384 t view uchar 131072 idx ulong to bool
for k ulong get m 2
p = add 4384 mul k 2
if eq get m p idx
key = mul get m add p 1 40
if ge dr_find m t 1 0 key 0
ret true
end
end
end
ret false
end
fn dd_share m view ulong 16384 t view uchar 131072 a edit ulong 64 refid ulong to bool
ok = and ne get t refid 0 ge dr_find m t 1 0 refid 0
for k ulong get m 8195
key = add 77056 mul k 208
if dr_eq t key refid
put a 13 1
ok = false
end
end
ret ok
end
fn dd_valid m view ulong 16384 t view uchar 131072 a edit ulong 64 idx ulong rec ulong to bool
p = add 14624 mul rec 4
key = add 77056 mul rec 208
refid = add key 40
why = get m p
used = dd_cons m t idx
if eq why 1
ret or not used ne get t add key 80 0
end
if or or eq why 2 eq why 5 eq why 7
ret and ne get t refid 0 ge dr_find m t 1 0 refid 0
end
if eq why 3
j = dr_find m t 0 0 refid
if or eq get t refid 0 lt j 0
ret false
end
ret eq get m add 7600 ulong j 0
end
if eq why 4
ret not used
end
if eq why 6
ret dd_share m t a refid
end
ret true
end
fn dd_weight m view ulong 16384 idx ulong to f64
p = add 288 mul idx 16
timev = dr_f m add p 2
launchv = dr_f m add p 9
w = add timev launchv
if and gt dr_f m add p 7 0.0 ge dr_i get m add p 8 0
capv = dr_cap m get m add p 8 0
tb = div dr_f m add p 7 mul capv 1.0e-9
if gt tb timev
w = add tb launchv
end
end
ret w
end
fn dd_removed m view ulong 16384 t view uchar 131072 a edit ulong 64 i ulong to ulong
found = ulong 0
rec = ulong 0
for k ulong get m 8195
if dr_eq t add 77056 mul k 208 mul i 40
found = add found 1
rec = k
end
end
put a 3 rec
put a 4 found
if eq found 0
put a 14 1
ret dr_fail a 2 i 7
end
if gt found 1
put a 13 1
ret dr_fail a 3 i 7
end
if not dd_valid m t a i rec
put a 14 1
ret dr_fail a 4 i 7
end
why = get m add 14624 mul rec 4
out = add 32 why
put a out bitcast ulong add bitcast f64 get a out dd_weight m i
ret 0
end
fn dd_demand m view ulong 16384 p ulong q ulong to bool
if ne dr_f m add p 2 dr_f m add q 2
ret true
end
ret ne dr_f m add p 7 dr_f m add q 7
end
fn dag_diff m view ulong 16384 t view uchar 131072 a edit ulong 64 to ulong
for i ulong get m 8192
if lt dr_find m t 0 0 add 65536 mul i 40 0
put a 10 add get a 10 1
end
end
for i ulong get m 0
j = dr_find m t 1 0 mul i 40
if ge j 0
put a 11 add get a 11 1
p = add 288 mul i 16
q = add 8480 mul ulong j 16
if dd_demand m p q
put a 0 1
put a 1 i
end
else
put a 12 add get a 12 1
rc = dd_removed m t a i
if ne rc 0
ret 7
end
end
end
for k ulong get m 8195
if lt dr_find m t 0 0 add 77056 mul k 208 0
put a 13 1
put a 3 k
rc = dr_fail a 5 k 7
ret 7
end
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note dag_fmt ABI: mode, a edit ulong 16, s edit uchar 256; output s is NUL terminated.
note 0 status a0; 1 provenance a0; 2 removal a0; 3 resource a0; 4 attribute a0.
note 5 civil date a0 year a1 month a2 day; 6 scan s with length a0.
note Date return bit32 success, low32 signed day. Scan mirrors three sscanf conversions.
note 7 jnum a0 f64 bits; 8 interval a0 lo a1 hi; 9 bound a0 makespan a1 bound.
note 10 energy a0 measured a1 synthetic; 11 ranking a0 measured.
note 12 next experiment a0 code (0 bandwidth specified, 1 bandwidth, 2 launch, 3 compute, 4 capacity).
note 13 provenance a0 kind a1 has_t a2 provenance.
note 14 dominance a0 time a1 peak a2 energy a3 other time a4 peak a5 energy a6 all energy.
note 15 width a0 kind a1 cap a2 lo a3 hi a4 provenance; 16 score a0 makespan a1 cf a2 width.
note Float inputs and numeric outputs are IEEE binary64 bits. Other returns are decisions.
fn df_space c uchar to bool
ret or or eq c 32 eq c 9 or eq c 13 eq c 10
end
fn df_scan a edit ulong 16 s edit uchar 256 to bool
i = get a 8
n = get a 9
while lt i n bound 256
if not df_space get s i
break
end
i = add i 1
end
sgn = false
if lt i n
c = get s i
if or eq c 43 eq c 45
sgn = eq c 45
i = add i 1
end
end
start = i
v = ulong 0
while lt i n bound 256
c = get s i
if or lt c 48 gt c 57
break
end
v = and add mul v 10 sub ulong c 48 4294967295
i = add i 1
end
if eq start i
ret false
end
if sgn
v = and sub ulong 0 v 4294967295
end
put a 8 i
put a 10 v
ret true
end
fn df_signed v ulong to long
if ge v 2147483648
ret sub long v 4294967296
end
ret long v
end
fn df_u32 v long to ulong
v = rem v 4294967296
if lt v long 0
v = add v 4294967296
end
ret ulong v
end
fn df_day a edit ulong 16 to ulong
y = df_signed get a 0
mo = df_signed get a 1
d = df_signed get a 2
if le mo long 2
y = sub y 1
end
era = y
if lt y long 0
era = sub y 399
end
era = div era 400
yoe = sub y mul era 400
mp = add mo 9
if gt mo long 2
mp = sub mo 3
end
mpu = df_u32 mp
mpu = mul mpu 153
mpu = div add mpu 2 5
mpu = add mpu df_u32 d
mpu = and sub mpu 1 4294967295
doe = mul ulong yoe 365
doe = add doe div ulong yoe 4
doe = sub doe div ulong yoe 100
doe = and add doe mpu 4294967295
ans = add sub mul era 146097 719468 df_signed doe
ret or df_u32 ans 4294967296
end
fn df_date a edit ulong 16 s edit uchar 256 to ulong
put a 8 ulong 0
put a 9 get a 0
for j ulong 3
if not df_scan a s
ret 0
end
put a j get a 10
if lt j 2
i = get a 8
if ge i get a 9
ret 0
end
if ne get s i uchar 45
ret 0
end
put a 8 add i 1
end
end
ret df_day a
end

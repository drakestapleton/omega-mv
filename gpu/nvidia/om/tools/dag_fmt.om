fn df_num u ulong to ulong
v = and u 9223372036854775807
if ge v 4831355200913801216
ret 1
end
if eq v 0
ret 0
end
e = shr v 52
if lt e 1023
ret 1
end
if ge e 1075
ret 0
end
mask = sub shl ulong 1 sub ulong 1075 e 1
if eq and v mask 0
ret 0
end
ret 1
end
fn df_f a edit ulong 16 k ulong to f64
ret bitcast f64 get a k
end
fn df_dom a edit ulong 16 to ulong
leq = and le df_f a 3 df_f a 0 le df_f a 4 df_f a 1
strict = or lt df_f a 3 df_f a 0 lt df_f a 4 df_f a 1
if ne get a 6 0
leq = and leq le df_f a 5 df_f a 2
strict = or strict lt df_f a 5 df_f a 2
end
if and leq strict
ret 1
end
ret 0
end
fn df_width a edit ulong 16 to ulong
v = 0.0f64
if and eq get a 0 2 gt df_f a 1 0.0f64
v = div sub df_f a 3 df_f a 2 df_f a 1
end
if eq get a 4 4
v = 1.0f64
end
ret bitcast ulong v
end
fn df_score a edit ulong 16 to ulong
if lt df_f a 1 0.0f64
ret 0
end
w = df_f a 2
if le w 0.0f64
w = bitcast f64 ulong 4587366580439587226
end
v = sub df_f a 0 df_f a 1
if lt v 0.0f64
v = neg v
end
ret bitcast ulong mul v w
end
fn dag_fmt mode ulong a edit ulong 16 s edit uchar 256 to ulong
if eq mode 0
ret df_name0 get a 0 s
end
if eq mode 1
ret df_name1 get a 0 s
end
if eq mode 2
ret df_name2 get a 0 s
end
if eq mode 3
ret df_name3 get a 0 s
end
if eq mode 4
ret df_name4 get a 0 s
end
if eq mode 5
ret df_day a
end
if eq mode 6
ret df_date a s
end
if eq mode 7
ret df_num get a 0
end
if eq mode 8
if and gt df_f a 0 0.0f64 gt df_f a 1 0.0f64
ret 1
end
ret 0
end
if eq mode 9
if ge add df_f a 0 bitcast f64 ulong 4517329193108106637 df_f a 1
ret 1
end
ret 0
end
if eq mode 10
if ne get a 0 0
ret df_name10 1 s
end
if ne get a 1 0
ret df_name10 2 s
end
ret df_name10 0 s
end
if eq mode 11
if ne get a 0 0
ret 1
end
ret 0
end
if eq mode 12
ret df_name12 get a 0 s
end
if eq mode 13
if and eq get a 0 3 eq get a 1 0
ret 2
end
ret get a 2
end
if eq mode 14
ret df_dom a
end
if eq mode 15
ret df_width a
end
if eq mode 16
ret df_score a
end
put s 0 uchar 0
ret 0
end

note Fixed numeric model 8192 words per side and names 65536 bytes per side.
note Resource 32/8, op 288/16, dependency 4384/2, removal 6432/4.
note Names: op 0/40, resource 10240/40, removal 11520/208 (op/ref/proof).
note a: why,index,status,next,anycal,mode,asof,hasmodel,phase,q; host replies 24..31.
fn dr_none m view ulong 16384 to ulong
if ne get m 13 110
ret 0
end
if ne get m 14 111
ret 0
end
if ne get m 15 110
ret 0
end
if ne get m 16 101
ret 0
end
if ne get m 17 0
ret 0
end
ret 1
end
fn dr_i x ulong to long
v = long and x 4294967295
if ge v 2147483648
v = sub v 4294967296
end
ret v
end
fn dr_u x long to ulong
if lt x 0
ret ulong add x 4294967296
end
ret ulong x
end
fn dr_cal prov ulong to bool
ret or eq prov 2 eq prov 3
end
fn dr_f m view ulong 16384 p ulong to f64
ret bitcast f64 get m p
end
fn dr_eq t view uchar 131072 x ulong y ulong to bool
for k ulong 40
u = get t add x k
if ne u get t add y k
ret false
end
if eq u 0
ret true
end
end
ret false
end
fn dr_find m view ulong 16384 t view uchar 131072 side ulong kind ulong key ulong to long
cnt = get m add mul side 8192 kind
base = mul side 65536
if eq kind 1
base = add base 10240
end
for i ulong cnt
if dr_eq t add base mul i 40 key
ret long i
end
end
ret -1
end
fn dr_fail a edit ulong 64 why ulong idx ulong status ulong to ulong
put a 0 why
put a 1 idx
put a 2 status
ret 4
end
fn dr_cap m view ulong 16384 idx ulong mode long to f64
p = add 32 mul idx 8
if lt mode 0
ret dr_f m add p 3
end
if gt mode 0
ret dr_f m add p 4
end
ret dr_f m add p 2
end
fn dr_engine m view ulong 16384 a edit ulong 64 p ulong i ulong to ulong
if lt dr_i get m add p 1 0
if ne get m p 4
ret dr_fail a 5 i 6
end
if ge dr_i get m add p 10 0
ret dr_fail a 6 i 6
end
end
ret 0
end
fn dr_pred m view ulong 16384 a edit ulong 64 p ulong to void
put a 16 get m add p 11
put a 17 get m add p 12
rows = get a 16
cols = get a 17
cells = mul rows cols
cells = add cells rows
cells = add cells cols
put a 18 mul cells 8
put a 19 1048576
put a 20 get m add p 13
put a 21 ulong shl uint 1 and uint get m add p 14 31
put a 22 get m add p 14
put a 8 1
end
fn dr_bad a view ulong 64 to bool
if eq dr_i get a 24 -4
ret true
end
if ne get a 25 0
ret true
end
if eq get a 26 0
ret true
end
ret eq get a 27 0
end
fn dr_resume m view ulong 16384 s edit ulong 8192 a edit ulong 64 to ulong
p = add 288 mul get a 3 16
out = add 32 mul get a 3 10
if eq get a 8 1
if dr_bad a
ret dr_fail a 3 get a 3 1
end
qv = bitcast f64 get a 9
if not and gt qv 0.0 lt qv 1.0
qv = f64 0.9
end
put a 9 bitcast ulong qv
put a 8 2
ret 2
end
if eq get a 8 2
shift = f64 0.0
mode = dr_i get a 5
if lt mode 0
shift = mul bitcast f64 get a 31 bitcast f64 get a 29
end
if gt mode 0
shift = mul neg bitcast f64 get a 31 bitcast f64 get a 29
end
put a 32 bitcast ulong add bitcast f64 get a 28 shift
put a 8 3
ret 3
end
put s out bitcast ulong div bitcast f64 get a 33 1000.0
put s add out 8 2
put a 4 1
put a 8 0
rc = dr_engine m a p get a 3
if ne rc 0
ret rc
end
put a 3 add get a 3 1
ret 0
end
fn dr_resolve m view ulong 16384 s edit ulong 8192 a edit ulong 64 to ulong
if eq get m 0 0
ret dr_fail a 10 0 6
end
if ne get a 8 0
rc = dr_resume m s a
if ne rc 0
ret rc
end
end
if eq get a 3 0
for i ulong get m 1
p = add 32 mul i 8
prov = get m add p 5
if eq prov 0
ret dr_fail a 1 i 1
end
if or eq prov 2 eq prov 3
put a 4 1
end
end
end
while lt get a 3 get m 0 bound 256
i = get a 3
p = add 288 mul i 16
out = add 32 mul i 10
put s add out 1 get m add p 7
put s add out 2 get m add p 9
put s add out 3 bitcast ulong f64 0.0
if ge dr_i get m add p 8 0
put s add out 3 bitcast ulong mul dr_cap m get m add p 8 dr_i get a 5 1.0e-9
end
put s add out 4 get m add p 1
put s add out 5 get m add p 8
put s add out 6 get m add p 10
put s add out 7 get m p
put s add out 8 get m add p 5
if and eq get m p 3 eq get m add p 6 0
if eq get a 7 0
ret dr_fail a 2 i 1
end
dr_pred m a p
ret 1
else
if eq get m add p 5 0
ret dr_fail a 4 i 1
end
v = dr_f m add p 2
if lt dr_i get a 5 0
v = dr_f m add p 4
end
if gt dr_i get a 5 0
v = dr_f m add p 3
end
put s out bitcast ulong v
if dr_cal get m add p 5
put a 4 1
end
end
rc = dr_engine m a p i
if ne rc 0
ret rc
end
put a 3 add i 1
end
if ne get a 4 0
if eq get m 4 0
ret dr_fail a 7 0 3
end
if le dr_i get a 6 0
put a 6 div get a 35 86400
end
expiry = add dr_i get m 5 dr_i get m 6
if gt dr_i get a 6 expiry
put a 34 dr_u sub sub dr_i get a 6 dr_i get m 5 dr_i get m 6
ret dr_fail a 8 0 2
end
end
put s 0 get m 0
put s 1 get m 1
put s 2 get m 2
put s 3 get m 12
put s 4 0
if ne get m 7 0
put s 4 1
end
put s 5 get m 8
put s 6 get m 9
put s 7 get m 10
put s 8 dr_none m
put s 9 1
for i ulong get m 1
p = add 32 mul i 8
out = add 2592 mul i 4
put s out get m p
put s add out 1 get m add p 1
put s add out 2 get m add p 2
put s add out 3 get m add p 5
end
ret 0
end
fn dr_double m edit ulong 16384 idx long to ulong
if or lt idx 0 ge idx long get m 1
ret 6
end
p = add 32 mul ulong idx 8
kind = get m p
if eq kind 2
for k ulong 3
put m add add p 2 k bitcast ulong mul dr_f m add add p 2 k 2.0
end
end
if eq kind 1
put m add p 1 ulong and mul get m add p 1 2 4294967295
end
if eq kind 4
for i ulong get m 0
q = add 288 mul i 16
if eq dr_i get m add q 10 idx
put m add q 9 bitcast ulong f64 0.0
end
end
end
if eq kind 3
put m add p 2 bitcast ulong mul dr_f m add p 2 2.0
end
ret 0
end
note Streaming comma-list scan: prefix bytes in s[8000..8039], length in a[40].
note Overlong tokens cannot equal a model ID; no input-size limit or C tokenization.
fn dr_token m edit ulong 16384 t view uchar 131072 s view ulong 8192 a view ulong 64 to void
for i ulong get m 0
same = true
for k ulong 40
v = get t add mul i 40 k
if eq v 0
if ne k get a 40
same = false
end
break
end
if ne ulong v get s add 8000 k
same = false
end
end
if gt get a 40 39
same = false
end
if same
put m add 7600 i 1
end
end
end
fn dr_changed m edit ulong 16384 t view uchar 131072 s edit ulong 8192 a edit ulong 64 to ulong
for i ulong get a 41
v = get t add 130816 i
if eq v 44
dr_token m t s a
put a 40 0
else
if lt get a 40 40
put s add 8000 get a 40 ulong v
end
if lt get a 40 40
put a 40 add get a 40 1
end
end
end
if ne get a 42 0
dr_token m t s a
end
ret 0
end
fn dag_res mode ulong m edit ulong 16384 s edit ulong 8192 t edit uchar 131072 a edit ulong 64 to ulong
if eq mode 0
ret dr_resolve m s a
end
if eq mode 1
ret dr_double m dr_i get a 1
end
if eq mode 2
ret dr_u dr_find m t get a 0 get a 1 130816
end
if eq mode 3
ret dr_changed m t s a
end
ret 6
end

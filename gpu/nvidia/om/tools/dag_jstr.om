note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note dagsim jstr byte policy. The C stream shell owns string termination and output effects.
fn dj_hex x uint to uchar
if lt x 10
ret uchar add x 48
end
ret uchar add x 87
end
fn dag_jstr c uchar out edit uchar 6 to ulong
if or eq c 34 eq c 92
put out 0 92
put out 1 c
ret 2
end
if lt c 32
put out 0 92
put out 1 117
put out 2 48
put out 3 48
put out 4 dj_hex shr uint c 4
put out 5 dj_hex and uint c 15
ret 6
end
put out 0 c
ret 1
end

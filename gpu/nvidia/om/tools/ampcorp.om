note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ampcorp: the decisions of tools/ampere_corpus.c (SM86 IR corpus capture). The C shell reads
note OMEGA_AMPERE_CORPUS_DIR, runs the SM86 encoder, opens and writes the files and calls abort; this unit
note checks the folder, builds the IR metadata, classifies the program (an FP8 marker or a training R5
note opcode beyond MUFU.LG2 must be refused), checks the encoder outcome and formats the three file paths
note "<dir>/<pid>-<serial>.<suffix>" and the unexpected-refusal message.
note facts f (ulong 16): 0 mode (0 folder check, 1 capture); 1 folder length (in d); 2 instruction count;
note 3 encoder rc (int64 bits); 4 bytes written; 5 SM121 length; 6 pid; 7 serial; the constants of the C
note headers 8 BW_IR_MUFU_LG2, 9 BW_IR_HMMA_BF16, 10 OMEGA_QMMA_MARK, 11 BW_IR_FMNMX_MAX,
note 12 OMEGA_QMMA_MARK_F2E4, 13 OMEGA_GPU_ENCODE_UNSUPPORTED (int64 bits). ins (ulong 2048): op, imm of
note each instruction. code (uchar 16384): the SM86 buffer after the encoder.
note Mode 0 returns 1 when the folder is safe. Mode 1 writes the metadata (op, imm as little-endian
note uint32 pairs) at o 0 and returns 1 (save "refused" from the path at o 8192), 2 (save "sm121.bin",
note "sm86.bin", "ir" from the paths at o 8192, 12288, 16384), 3 (abort: the refusal wrote bytes or
note did not refuse), 4 + 256 * length (print the message at o 8192, then abort) or 5 (abort: the path
note does not fit 4096 bytes). Paths end with a zero byte.
const ACPATH ulong 8192
const ACMAX ulong 4096
fn ac_s o edit uchar 20480 p ulong w ulong n ulong to ulong
i = ulong 0
while lt i n bound 9
put o add p i uchar and shr w mul i 8 255
i = add i 1
end
ret add p n
end
fn ac_nd v ulong to ulong
n = ulong 1
x = div v 10
while ne x 0 bound 20
n = add n 1
x = div x 10
end
ret n
end
fn ac_u o edit uchar 20480 p ulong v ulong to ulong
w = ac_nd v
k = add p w
x = v
for i ulong w
k = sub k 1
put o k uchar add 48 rem x 10
x = div x 10
end
ret add p w
end
note ac_safe: is_safe_corpus_dir: not empty, no backslash, no ".." component.
fn ac_safe d view uchar 131072 n ulong to ulong
if eq n 0
ret ulong 0
end
for i ulong n
if eq get d i uchar 92
ret ulong 0
end
end
i = ulong 0
while lt i n bound 131072
while lt i n bound 131072
if ne get d i uchar 47
break
end
i = add i 1
end
s = i
while lt i n bound 131072
if eq get d i uchar 47
break
end
i = add i 1
end
if eq sub i s 2
if eq get d s uchar 46
if eq get d add s 1 uchar 46
ret ulong 0
end
end
end
end
ret ulong 1
end
note ac_path: "<dir>/<pid>-<serial>." at o at; returns the position after it, or 0 when the path with a
note suffix of sn bytes (without its zero) would not fit 4096 bytes.
fn ac_path o edit uchar 20480 at ulong f view ulong 16 d view uchar 131072 sn ulong to ulong
dn = get f 1
pid = get f 6
ser = get f 7
n = add add add dn ac_nd pid ac_nd ser add sn 3
if ge n ACMAX
ret ulong 0
end
for i ulong dn
put o add at i get d i
end
p = add at dn
put o p uchar 47
p = ac_u o add p 1 pid
put o p uchar 45
p = ac_u o add p 1 ser
put o p uchar 46
ret add p 1
end
note ac_msg: "SM86 unexpectedly refused an existing kernel (%zu instructions, rc %d)\n" at o 8192.
fn ac_msg o edit uchar 20480 cnt ulong rc ulong to ulong
p = ACPATH
note s "SM86 unexpectedly refused an existing kernel ("
p = ac_s o p 7308908026477956435 8
p = ac_s o p 7810479204325486712 8
p = ac_s o p 7310315702801539193 8
p = ac_s o p 7599935561152929892 8
p = ac_s o p 7307970448944886899 8
p = ac_s o p 44119722651250 6
p = ac_u o p cnt
note s " instructions, rc "
p = ac_s o p 7166760226508400928 8
p = ac_s o p 8223621793864182132 8
p = ac_s o p 8291 2
v = rc
if ne shr rc 63 0
put o p uchar 45
p = add p 1
v = sub ulong 0 rc
end
p = ac_u o p v
note s ")\n"
p = ac_s o p 2601 2
ret sub p ACPATH
end
note ac_meta: the metadata pairs at o 0; returns 1 when the program must be refused.
fn ac_meta o edit uchar 20480 f view ulong 16 ins view ulong 2048 to ulong
r = ulong 0
for i ulong get f 2
op = get ins mul i 2
im = get ins add mul i 2 1
x = ac_s o mul i 8 and op 4294967295 4
x = ac_s o add mul i 8 4 im 4
if gt and op 4294967295 get f 8
r = ulong 1
end
if eq and op 4294967295 get f 9
if eq im get f 10
r = ulong 1
end
end
if eq and op 4294967295 get f 11
if eq im get f 12
r = ulong 1
end
end
end
ret r
end
fn ac_cap f view ulong 16 d view uchar 131072 ins view ulong 2048 code view uchar 16384 o edit uchar 20480 to ulong
rf = ac_meta o f ins
rc = get f 3
nb = get f 4
if ne rf 0
if or ne rc get f 13 ne nb 0
ret ulong 3
end
for i ulong 16384
if ne get code i uchar 165
ret ulong 3
end
end
p = ac_path o ACPATH f d 7
if eq p 0
ret ulong 5
end
note s "refused"
p = ac_s o p 28259044236354930 7
put o p uchar 0
ret ulong 1
end
if or ne rc 0 ne nb get f 5
ret add shl ac_msg o get f 2 rc 8 4
end
note sm121.bin is the longest suffix, so it alone can exceed 4096 bytes.
p = ac_path o ACPATH f d 9
if eq p 0
ret ulong 5
end
note s "sm121.bin"
p = ac_s o p 7593682710530452851 8
p = ac_s o p 110 1
put o p uchar 0
p = ac_path o 12288 f d 8
note s "sm86.bin"
p = ac_s o p 7955998167344377203 8
put o p uchar 0
p = ac_path o 16384 f d 2
note s "ir"
p = ac_s o p 29289 2
put o p uchar 0
ret ulong 2
end
fn ampcorp f view ulong 16 d view uchar 131072 ins view ulong 2048 code view uchar 16384 o edit uchar 20480 to ulong
if eq get f 0 0
ret ac_safe d get f 1
end
ret ac_cap f d ins code o
end

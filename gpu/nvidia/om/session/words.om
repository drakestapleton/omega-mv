note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Launch method-word emission from src/omega_gpu_session.c. Omega owns the
note header arithmetic; the C shell copies the cbank, argument and QMD blobs
note between the headers and does every sync, submit and wait call. emit is the
note only export. op 0 ampere prefix, 1 setup, 2 invalidate, 3 cbank header,
note 4 qmd header, 5 semaphore init, 6 completion tail.
const WMASK ulong 4294967295
const MTHDTAG ulong 536870912
const COMPB ulong 51136
const INVALL ulong 4113
const MARKER1 ulong 1145324612
const MARKER2 ulong 1179010630
const SEMINIT ulong 5
const REFUSED ulong 18446744073709551615

fn mthd s ulong m ulong c ulong to ulong
ret or or or MTHDTAG shl c 16 shl s 13 shr m 2
end

fn pw o edit ulong 32 n ulong v ulong to ulong
put o n v
ret add n 1
end

fn lo v ulong to ulong
ret and v WMASK
end

fn hi v ulong to ulong
ret and shr v 32 WMASK
end

fn inlinehdr count ulong to ulong
ret or or or shl count 16 shl ulong 1 13 shr ulong 436 2 shl ulong 6 28
end

fn qmdhi va ulong to ulong
ret or ulong 1073741824 and shr va 40 511
end

fn qmdlo va ulong to ulong
ret and shr va 8 WMASK
end

fn ampere o edit ulong 32 qva ulong to ulong
k = pw o 0 mthd 1 0 1
k = pw o k COMPB
k = pw o k mthd 1 540 1
k = pw o k INVALL
k = pw o k mthd 1 692 1
k = pw o k qmdlo qva
k = pw o k mthd 1 704 1
ret pw o k 3
end

fn setup o edit ulong 32 to ulong
k = pw o 0 536944737
k = pw o k 52928
k = pw o k 536944786
k = pw o k 1
k = pw o k 536944808
k = pw o k 15
k = pw o k 536946013
k = pw o k 3
k = pw o k 536946014
k = pw o k 536870912
k = pw o k 536946015
k = pw o k 1048575
k = pw o k 536946007
k = pw o k 3
k = pw o k 536946008
k = pw o k 570425344
k = pw o k 536946009
ret pw o k 0
end

fn inv o edit ulong 32 flags ulong to ulong
k = pw o 0 mthd 1 540 1
ret pw o k and flags WMASK
end

fn cbank o edit ulong 32 va ulong off ulong count ulong to ulong
k = pw o 0 mthd 1 392 2
k = pw o k hi va
k = pw o k lo va
k = pw o k mthd 1 384 2
k = pw o k and off WMASK
k = pw o k 1
k = pw o k mthd 1 432 1
k = pw o k 65
ret pw o k inlinehdr count
end

fn qmd o edit ulong 32 va ulong to ulong
k = pw o 0 or or or shl ulong 98 16 shl ulong 1 13 shr ulong 792 2 shl ulong 2 28
k = pw o k qmdhi va
ret pw o k qmdlo va
end

fn seminit o edit ulong 32 va ulong to ulong
k = pw o 0 mthd 1 392 2
k = pw o k hi va
k = pw o k lo va
k = pw o k mthd 1 384 2
k = pw o k 4
k = pw o k 1
k = pw o k mthd 1 432 1
k = pw o k 65
k = pw o k inlinehdr 1
ret pw o k SEMINIT
end

fn tail o edit ulong 32 va ulong to ulong
k = pw o 0 mthd 0 92 5
k = pw o k lo va
k = pw o k hi va
k = pw o k MARKER1
k = pw o k 0
k = pw o k or ulong 1 shl ulong 1 20
k = pw o k mthd 0 40 4
k = pw o k 0
k = pw o k 0
k = pw o k 0
k = pw o k shl ulong 16 27
k = pw o k mthd 0 92 5
k = pw o k lo add va 16
k = pw o k hi add va 16
k = pw o k MARKER2
k = pw o k 0
ret pw o k or ulong 1 shl ulong 1 20
end

fn emit op ulong a view ulong 16 o edit ulong 32 to ulong
if eq op 0
ret ampere o get a 0
end
if eq op 1
ret setup o
end
if eq op 2
ret inv o get a 0
end
if eq op 3
ret cbank o get a 0 get a 1 get a 2
end
if eq op 4
ret qmd o get a 0
end
if eq op 5
ret seminit o get a 0
end
if eq op 6
ret tail o get a 0
end
ret REFUSED
end

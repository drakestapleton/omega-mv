om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Residual omega_gpu_mem_reserve.c parsing, C-locale strtoull and sscanf contracts.
note The C shell borrows the getenv/fgets bytes; this unit neither copies them nor allocates.
note Optional sign, C whitespace, decimal prefix, overflow saturation even for a negative input.
note Environment values require full consumption; MemAvailable only requires a conversion.
note Chunked loops cover Linux argument limits without a new 512-byte parser ceiling.
note op 0: environment MiB (empty/invalid -> 4096), op 1: MemAvailable line (1 and out0 kB, else 0).
note op 2: saturating MiB-to-byte conversion of value; b is unused. out1 is the numeric end offset.

fn rs_white c uchar to bool
ret or eq c 32 and ge c 9 le c 13
end

fn rs_skip b view uchar * pos ulong to ulong
i = pos
while lt i len b bound 999999
for j ulong 256
if ge i len b
ret i
end
if not rs_white get b i
ret i
end
i = add i 1
end
end
ret i
end

fn rs_push dst edit ulong 2 c uchar to void
v = get dst 0
d = ulong sub c 48
if gt v div sub ulong 18446744073709551615 d 10
put dst 1 1
end
if eq get dst 1 0
put dst 0 add mul v 10 d
end
end

fn rs_number b view uchar * pos ulong dst edit ulong 2 to bool
i = rs_skip b pos
minus = false
if lt i len b
if or eq get b i 43 eq get b i 45
minus = eq get b i 45
i = add i 1
end
end
start = i
put dst 0 0
put dst 1 0
done = false
while lt i len b bound 999999
for j ulong 256
if ge i len b
done = true
break
end
c = get b i
if or lt c 48 gt c 57
done = true
break
end
rs_push dst c
i = add i 1
end
if done
break
end
end
if eq i start
ret false
end
if eq get dst 1 0
if minus
put dst 0 sub ulong 0 get dst 0
end
else
put dst 0 18446744073709551615
end
put dst 1 i
ret true
end

fn rs_prefix b view uchar * to bool
if lt len b 13
ret false
end
note The exact literal prefix is MemAvailable: (from the retained sscanf format).
if ne get b 0 77
ret false
end
if ne get b 1 101
ret false
end
if ne get b 2 109
ret false
end
if ne get b 3 65
ret false
end
if ne get b 4 118
ret false
end
if ne get b 5 97
ret false
end
if ne get b 6 105
ret false
end
if ne get b 7 108
ret false
end
if ne get b 8 97
ret false
end
if ne get b 9 98
ret false
end
if ne get b 10 108
ret false
end
if ne get b 11 101
ret false
end
ret eq get b 12 58
end

fn memreserve op ulong b view uchar * value ulong dst edit ulong 2 to ulong
if eq op 2
if gt value 17592186044415
ret 18446744073709551615
end
ret shl value 20
end
if eq op 0
if eq len b 0
ret 4096
end
if rs_number b 0 dst
if eq get dst 1 len b
ret get dst 0
end
end
ret 4096
end
if eq op 1
if rs_prefix b
if rs_number b 13 dst
ret 1
end
end
ret 0
end
ret 0
end

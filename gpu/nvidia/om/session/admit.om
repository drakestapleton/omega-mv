note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Session admission and bookkeeping decisions from src/omega_gpu_session.c.
note Pure computation: no host words, no platform calls. The C shell keeps the
note lock, the atomic stores and every dma, queue and sync call. decide is the
note only export; op selects the decision and a carries the inputs.
const WMASK ulong 4294967295
const PAGEMSK ulong 4294963200
const PAGE ulong 4096
const EPOCHX ulong 18446744073709551615
const SIGN ulong 2147483648
const REFUSED ulong 18446744073709551615
const HOOKMAX ulong 8

fn roundup v ulong q ulong to ulong
a = and v WMASK
b = and q WMASK
if eq b 0
ret 0
end
ret and mul div add a sub b 1 b b WMASK
end

fn pageup b ulong to ulong
a = and b WMASK
r = and and add a sub PAGE 1 WMASK PAGEMSK
if lt r PAGE
ret PAGE
end
ret r
end

fn spinok us ulong mx ulong to ulong
if gt and us WMASK and mx WMASK
ret 1
end
ret 0
end

fn gprcount c ulong to ulong
a = and c WMASK
if gt a 64
ret roundup a 8
end
ret 64
end

fn argsoff amp ulong to ulong
if ne and amp WMASK 0
ret 352
end
ret 896
end

fn semva amp ulong marker ulong qmd ulong to ulong
if ne and amp WMASK 0
ret add marker 32
end
ret add qmd 8192
end

fn scratch o edit ulong 4 bytes ulong cap ulong reserved ulong cpu ulong to ulong
b = and bytes WMASK
c = and cap WMASK
if ne and reserved WMASK 0
if gt b c
put o 0 c
ret 2
end
if eq and cpu WMASK 0
put o 0 c
ret 2
end
end
put o 0 b
if ge c b
if ne and cpu WMASK 0
ret 0
end
end
ret 1
end

fn freedec blocked ulong open ulong plat ulong to ulong
if ne and blocked WMASK 0
ret 0
end
if eq and open WMASK 0
ret 0
end
if eq and plat WMASK 0
ret 3
end
ret 2
end

fn opendec blocked ulong epoch ulong plat ulong open ulong to ulong
if ne and blocked WMASK 0
ret 1
end
if eq epoch EPOCHX
ret 3
end
if eq and plat WMASK 0
ret 4
end
if ne and open WMASK 0
ret 2
end
ret 0
end

fn platdec open ulong locked ulong blocked ulong to ulong
if ne and open WMASK 0
ret 1
end
if ne and locked WMASK 0
ret 1
end
if ne and blocked WMASK 0
ret 1
end
ret 0
end

fn recovdec latched ulong open ulong plat ulong to ulong
if eq and latched WMASK 0
ret 2
end
if eq and open WMASK 0
ret 1
end
if eq and plat WMASK 0
ret 1
end
ret 0
end

fn hookdec nhooks ulong present ulong to ulong
if ge and nhooks WMASK HOOKMAX
ret 1
end
if eq and present WMASK 0
ret 1
end
ret 0
end

fn slice left ulong to ulong
a = and left WMASK
if lt a 1
ret a
end
ret 1
end

fn mdone seen ulong want ulong to ulong
d = and sub seen want WMASK
if lt d SIGN
ret 0
end
ret 1
end

fn decide op ulong a view ulong 16 o edit ulong 4 to ulong
if eq op 0
ret roundup get a 0 get a 1
end
if eq op 1
ret pageup get a 0
end
if eq op 2
ret spinok get a 0 get a 1
end
if eq op 3
ret gprcount get a 0
end
if eq op 4
ret argsoff get a 0
end
if eq op 5
ret semva get a 0 get a 1 get a 2
end
if eq op 6
ret scratch o get a 0 get a 1 get a 2 get a 3
end
if eq op 7
ret freedec get a 0 get a 1 get a 2
end
if eq op 8
ret opendec get a 0 get a 1 get a 2 get a 3
end
if eq op 9
ret platdec get a 0 get a 1 get a 2
end
if eq op 10
ret recovdec get a 0 get a 1 get a 2
end
if eq op 11
ret hookdec get a 0 get a 1
end
if eq op 12
ret slice get a 0
end
if eq op 13
ret mdone get a 0 get a 1
end
ret REFUSED
end

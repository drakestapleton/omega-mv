note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Scoped 27B attention mirror plan. Zero bypasses, all-ones refuses, otherwise bytes.
note The native layout has four heads, 512 bytes per row and 8256 bytes tail slack per plane.
note Modes: 0 ordinary, 1 mirror all rows, 2 provisional adaptive threshold at 1024 rows.
fn native_attnmirplan q view ulong 7 to ulong
mode = get q 0
qheads = get q 1
kvheads = get q 2
maxpos = get q 3
pos = get q 4
rows = get q 5
plane = get q 6
if or gt mode 2 or ne qheads 24 ne kvheads 4
ret 18446744073709551615
end
if or eq maxpos 0 gt maxpos 131072
ret 18446744073709551615
end
if or eq rows 0 gt rows 32768
ret 18446744073709551615
end
if gt pos maxpos
ret 18446744073709551615
end
if gt rows sub maxpos pos
ret 18446744073709551615
end
if ne plane add mul maxpos 2048 8256
ret 18446744073709551615
end
if or eq mode 0 and eq mode 2 lt rows 1024
ret 0
end
ret mul plane 2
end

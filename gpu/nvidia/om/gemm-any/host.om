note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note x32: type rt ct wm wn stall mutant band M N K layout lda ldb A B AP BP C.
note p64: Mp Np Kp KS2 a_bytes b_bytes ap_bytes bp_bytes grid[6] threads[3], spans[2], effective_ld[2].
note p24..53 launch argument words; p54 first launch. Result 0 OK, 1 BAD_ARGS, 2 TOO_LARGE.
fn gh_pow v ulong to bool
ret or eq v 1 or eq v 2 eq v 4
end
fn gh_esz t ulong to ulong
if eq t 1
ret 1
end
if eq t 3
ret 4
end
ret 2
end
fn gh_step t ulong to ulong
if eq t 1
ret 32
end
ret 16
end
fn gh_round v ulong m ulong to ulong
ret mul div add v sub m 1 m m
end
fn gemm_host_value op ulong a ulong b ulong c ulong d ulong to ulong
if eq op 0
ret gh_esz a
end
if eq op 1
ret gh_step a
end
if eq op 2
if le a 3
ret 1
end
ret 0
end
if eq op 3
ret and mul 4 add add mul 4 a mul 2 b mul a b 4294967295
end
if eq op 4
ret and add a 255 18446744073709551360
end
if eq op 5
if and ne a 0 ge b c
ret 1
end
ret 0
end
if eq op 6
if and eq a 1 and eq b 48 eq c 0
ret 0
end
ret 1
end
ret d
end
fn gemm_host_cfg x view ulong 32 to ulong
if gt get x 0 3
ret 0
end
for i ulong 4
if not gh_pow get x add i 1
ret 0
end
end
if or lt get x 5 1 gt get x 5 15
ret 0
end
if gt get x 6 3
ret 0
end
b = get x 7
if or gt b 32 ne and b sub b 1 0
ret 0
end
ret 1
end
fn gh_pack groups ulong ks2 ulong frag ulong to ulong
ret mul mul add mul groups ks2 2 frag 512
end
fn gemm_host_plan x view ulong 32 p edit ulong 64 to ulong
if eq gemm_host_cfg x 0
ret 1
end
for i ulong 3
if eq get x add i 8 0
ret 1
end
end
for i ulong 3
if gt get x add i 8 16384
ret 2
end
end
for i ulong 64
put p i 0
end
ks = gh_step get x 0
hga = mul 16 get x 1
hgb = mul 8 get x 2
put p 0 gh_round get x 8 mul hga get x 3
put p 1 gh_round get x 9 mul hgb get x 4
put p 2 gh_round get x 10 mul 4 ks
put p 3 div get p 2 mul 2 ks
put p 4 mul mul get x 8 get x 10 gh_esz get x 0
put p 5 mul mul get x 10 get x 9 gh_esz get x 0
put p 6 gh_pack div get p 0 hga get p 3 mul 2 get x 1
put p 7 gh_pack div get p 1 hgb get p 3 get x 2
put p 8 get p 3
put p 9 div get p 0 hga
put p 10 get p 3
put p 11 div get p 1 hgb
put p 12 div get p 1 mul hgb get x 4
put p 13 div get p 0 mul hga get x 3
if gt get x 7 1
gx = get p 12
gy = get p 13
band = get x 7
put p 12 mul band gy
put p 13 div add gx sub band 1 band
end
put p 14 128
put p 15 128
put p 16 mul mul 32 get x 3 get x 4
if eq get x 0 3
put p 6 0
put p 7 0
for i ulong 9
put p add 8 i 0
end
put p 12 div add get x 9 127 128
put p 13 get x 8
put p 16 128
end
ret 0
end
note Stored spans use 64-bit arithmetic exactly as C; outer,inner,ld originate from u32.
fn gh_span col ulong rows ulong kk ulong ld ulong to ulong
ou = rows
iu = kk
if ne col 0
ou = kk
iu = rows
end
if eq ld 0
ld = iu
end
if or lt ld iu gt ld 4294967295
ret 0
end
sp = add mul sub ou 1 ld iu
if gt sp 4294967295
ret 0
end
ret sp
end
fn gemm_host_span x view ulong 32 p edit ulong 64 to ulong
if gt get x 11 3
ret 1
end
for i ulong 3
if eq get x add i 8 0
ret 1
end
end
sa = gh_span and get x 11 1 get x 8 get x 10 get x 12
sb = gh_span and xor get x 11 2 2 get x 9 get x 10 get x 13
if or eq sa 0 eq sb 0
ret 1
end
put p 17 sa
put p 18 sb
put p 19 get x 12
if eq get x 12 0
put p 19 get x 10
if ne and get x 11 1 0
put p 19 get x 8
end
end
put p 20 get x 13
if eq get x 13 0
put p 20 get x 9
if ne and get x 11 2 0
put p 20 get x 10
end
end
ret 0
end
fn gh_put64 p edit ulong 64 w ulong v ulong to void
put p w and v 4294967295
put p add w 1 shr v 32
end
fn gemm_host_drive x view ulong 32 p edit ulong 64 to ulong
if gt get x 11 3
ret 1
end
rc = gemm_host_plan x p
if ne rc 0
ret rc
end
rc = gemm_host_span x p
if ne rc 0
ret rc
end
if eq get x 0 3
if ne get x 11 0
ret 1
end
if ne get p 19 get x 10
ret 1
end
if ne get p 20 get x 9
ret 1
end
put p 54 2
gh_put64 p 44 get x 14
gh_put64 p 46 get x 15
gh_put64 p 48 get x 18
put p 50 get x 8
put p 51 get x 9
put p 52 get x 10
ret 0
end
gh_put64 p 24 get x 14
gh_put64 p 26 get x 16
put p 28 get x 8
put p 29 get x 10
put p 30 get p 19
put p 31 1
if ne and get x 11 1 0
put p 30 1
put p 31 get p 19
end
put p 32 get p 3
gh_put64 p 34 get x 15
gh_put64 p 36 get x 17
put p 38 get x 9
put p 39 get x 10
put p 40 1
put p 41 get p 20
if ne and get x 11 2 0
put p 40 get p 20
put p 41 1
end
put p 42 get p 3
gh_put64 p 44 get x 16
gh_put64 p 46 get x 17
gh_put64 p 48 get x 18
put p 50 get x 8
put p 51 get x 9
put p 52 get p 3
put p 53 div get p 1 mul mul 8 get x 2 get x 4
ret 0
end

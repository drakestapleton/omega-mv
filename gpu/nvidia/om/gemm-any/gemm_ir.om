put ins add mul sub get m 0 1 8 5 GX
end
fn gd ins edit ulong 8192 m edit ulong 512 op ulong rg ulong off ulong to void
gemit ins m op rg off 1
put ins add mul sub get m 0 1 8 5 0
end
fn gst ins edit ulong 8192 m edit ulong 512 rg ulong off ulong to void
gemit ins m 12 rg off 3
put ins add mul sub get m 0 1 8 5 0
end
fn gp ins edit ulong 8192 m edit ulong 512 a ulong b ulong to void
gemit ins m 28 gr GN a b GN 0 4
end
fn gm ins edit ulong 8192 m edit ulong 512 d ulong a ulong imm ulong c ulong to void
ga ins m 8 gr d a GN c imm
end
fn gw ins edit ulong 8192 m edit ulong 512 d ulong a ulong imm ulong c ulong to void
ga ins m 9 gr d a GN c imm
end
fn gb ins edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong imm ulong to void
ga ins m op gr d a GN GN imm
end
fn gaand ins edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
ga ins m 51 gr d a b GN 192
end
fn glt ins edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong to void
gm ins m d b GM a
gb ins m 17 d d 31
end
fn gtail ins edit ulong 8192 m edit ulong 512 to void
gemit ins m 45 gr GN GN GN GN 0 6
gemit ins m 46 gr GN GN GN GN 4433230883192832 9
end
note pack r slots: 0 src pair,1 dst pair,2 R,3 K,4 sr,5 sk,6 KS2,7 tid,8 cx,9 cy,10 one,
note 11 g,12 t,13 qa,14 qb,15 row0,16 k0,17 tmp,18 dest pair,19 row,20 validrow,21 rowoff,
note 22 kx,23 valid,24 off,25 word; 26..29 addr pairs,30..33 values,34..37 masks,38..41 odd.
fn gpack_init ins edit ulong 8192 m edit ulong 512 r edit ulong 128 to void
for j ulong 42
k = ulong 1
if or or lt j 2 eq j 18 and ge j 26 lt j 30
k = ulong 2
end
put r j gv m k
end
gu ins m
for j ulong 7
op = ulong 4
if lt j 2
op = ulong 5
end
off = add 912 mul sub j 2 4
if lt j 2
off = add 896 mul j 8
end
gl ins m op get r j off
end
for j ulong 3
sr = ulong 33
if ne j 0
sr = add 36 j
end
gl ins m 3 get r add j 7 sr
end
gb ins m 2 get r 10 GN 1
gb ins m 17 get r 11 get r 7 4
gb ins m 17 get r 12 get r 7 2
gb ins m 18 get r 12 get r 12 3
gb ins m 18 get r 13 get r 7 1
gb ins m 17 get r 14 get r 7 1
gb ins m 18 get r 14 get r 14 1
end
fn gks cfg view ulong 8 to ulong
if eq get cfg 0 1
ret 32
end
ret 16
end
fn gfrags cfg view ulong 8 isb ulong to ulong
if ne isb 0
ret get cfg 2
end
ret mul get cfg 1 2
end
fn grows cfg view ulong 8 isb ulong to ulong
if ne isb 0
ret mul get cfg 2 8
end
ret mul get cfg 1 16
end
fn gpack_base ins edit ulong 8192 m edit ulong 512 r edit ulong 128 cfg view ulong 8 isb ulong to void
gm ins m get r 15 get r 9 grows cfg isb get r 11
if eq isb 0
gm ins m get r 15 get r 13 8 get r 15
end
gm ins m get r 16 get r 8 mul gks cfg 2 GN
gm ins m get r 16 get r 12 div gks cfg 8 get r 16
if eq isb 0
gm ins m get r 16 get r 14 div gks cfg 2 get r 16
else
gm ins m get r 16 get r 14 gks cfg get r 16
gm ins m get r 16 get r 13 div gks cfg 2 get r 16
end
ga ins m 8 gr get r 17 get r 9 get r 6 get r 8 0
gm ins m get r 17 get r 17 mul gfrags cfg isb 128 get r 7
gw ins m get r 18 get r 17 4 get r 1
end
fn gpack_addr ins edit ulong 8192 m edit ulong 512 r edit ulong 128 cfg view ulong 8 dk ulong x ulong to void

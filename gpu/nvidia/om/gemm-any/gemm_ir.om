note Any-shape tensor GEMM. Record ABI matches mathlibs_ir.om, but this unit is independent.
note Config words: type,rt,ct,wm,wn,stall,mutant,band. K padding is performed by PACK kernels.
note Registers are named by slots in r; local arrays hold builder state, never GPU data.
const GN ulong 65535
const GX ulong 18446744073709551615
const GM ulong 4294967295
fn gr d ulong a ulong b ulong c ulong to ulong
ret or or d shl a 16 or shl b 32 shl c 48
end
fn gv m edit ulong 512 k ulong to ulong
v = get m 1
if ge v 256
put m 4 1
ret GN
end
put m add 64 v k
put m 1 add v 1
ret v
end
fn gf x ulong to ulong
if eq x GN
ret GX
end
ret and x 1023
end
fn gc st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end
note gcontrol supplies the shared scoreboard convention; record packing is separate to bound compiler live values.
fn gcontrol m edit ulong 512 op ulong imm ulong kind ulong to ulong
pend = get m 3
ctrl = gc 6 7 7 pend
next = ulong 0
if eq kind 1
ctrl = or gc 4 0 1 pend 8192
next = ulong 3
end
if eq kind 2
ctrl = or gc 4 2 7 pend 8192
next = ulong 4
end
if eq kind 3
ctrl = or gc 4 7 1 pend 8192
next = ulong 2
end
if eq kind 4
ctrl = gc 14 7 7 pend
end
if or eq kind 5 eq kind 6
ctrl = gc 5 7 7 pend
if ne and shr op 16 2 0
next = pend
end
end
if eq kind 7
ctrl = or gc 1 7 7 pend 8192
end
if eq kind 8
ctrl = or gc 5 7 7 pend 8192
end
if eq kind 9
ctrl = shr imm 32
end
put m 3 next
ret ctrl
end
fn gemit ins edit ulong 8192 m edit ulong 512 op ulong rg ulong imm ulong kind ulong to void
if ge get m 0 1024
put m 4 2
end
b = mul get m 0 8
ctrl = gcontrol m op imm kind
put ins b and op 255
put ins add b 1 gf and rg 65535
put ins add b 2 gf and shr rg 16 65535
put ins add b 3 gf and shr rg 32 65535
put ins add b 4 gf shr rg 48
put ins add b 5 GX
put ins add b 6 or and imm GM shl ctrl 32
put ins add b 7 and shr op 16 7
put m 0 add get m 0 1
end
fn ga ins edit ulong 8192 m edit ulong 512 op ulong rg ulong imm ulong to void
gemit ins m op rg imm 0
end
fn gl ins edit ulong 8192 m edit ulong 512 op ulong d ulong off ulong to void
gemit ins m op gr d GN GN GN off 1
end
fn gu ins edit ulong 8192 m edit ulong 512 to void

glt ins m get r 23 get r 22 get r 3
gaand ins m get r 23 get r 23 get r 20
ga ins m 8 gr get r 24 get r 22 get r 5 get r 21 0
ga ins m 8 gr get r 24 get r 24 get r 23 GN 0
gm ins m get r add 34 x get r 23 GM GN
if eq get cfg 0 1
gb ins m 18 get r add 38 x get r 24 1
gb ins m 18 get r 24 get r 24 4294967294
gw ins m get r add 26 x get r 24 1 get r 0
else
gw ins m get r add 26 x get r 24 2 get r 0
end
end
fn gbyte ins edit ulong 8192 m edit ulong 512 r edit ulong 128 x ulong to void
gb ins m 18 get r 22 get r add 30 x 255
gb ins m 17 get r 23 get r add 30 x 8
gb ins m 18 get r 23 get r 23 255
gm ins m get r 23 get r 22 GM get r 23
ga ins m 8 gr get r add 30 x get r 23 get r add 38 x get r 22 0
end
fn gmask ins edit ulong 8192 m edit ulong 512 r edit ulong 128 x ulong to void
v = get r add 30 x
mask = get r add 34 x
gaand ins m v v mask
end
fn gjoin ins edit ulong 8192 m edit ulong 512 r edit ulong 128 ks ulong x ulong to void
v = get r add 30 x
scale = shl ulong 1 mul x div 256 ks
gm ins m get r 25 v scale get r 25
end
fn gpack_values ins edit ulong 8192 m edit ulong 512 r edit ulong 128 ks ulong f ulong to void
for x ulong div ks 8
gd ins m 19 gr get r add 30 x get r add 26 x GN GN 0
end
for x ulong div ks 8
if eq ks 32
gbyte ins m r x
end
gmask ins m r x
end
gm ins m get r 25 get r 30 1 GN
for x ulong div ks 8
if ne x 0
gjoin ins m r ks x
end
end
gst ins m gr GN get r 18 get r 25 GN mul f 512
end
fn gpack_row ins edit ulong 8192 m edit ulong 512 r edit ulong 128 mutant ulong to void
gm ins m get r 19 get r 10 get r 101 get r 15
if eq mutant 2
gm ins m get r 22 get r 10 GM get r 2
glt ins m get r 20 get r 19 get r 22
else
glt ins m get r 20 get r 19 get r 2
end
ga ins m 8 gr get r 21 get r 19 get r 4 GN 0
end
fn gpack_frag ins edit ulong 8192 m edit ulong 512 r edit ulong 128 cfg view ulong 8 f ulong to void
gpack_row ins m r get cfg 6
for x ulong div gks cfg 8
gpack_addr ins m r cfg get r 102 x
end
gpack_values ins m r gks cfg f
end
fn gpack ins edit ulong 8192 m edit ulong 512 r edit ulong 128 cfg view ulong 8 isb ulong to void
gpack_init ins m r
gpack_base ins m r cfg isb
put r 100 gfrags cfg isb
if eq get cfg 6 1
mask = ulong 4294967280
if eq get cfg 0 1
mask = ulong 4294967264
end
gb ins m 18 get r 3 get r 3 mask
end
for f ulong get r 100
put r 101 mul rem f get cfg 1 16
put r 102 mul div f get cfg 1 gks cfg
if ne isb 0
put r 101 mul f 8
put r 102 0
end
gpack_frag ins m r cfg f
end
gtail ins m
end

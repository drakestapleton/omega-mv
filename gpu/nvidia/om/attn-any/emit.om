note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Eight-word BlackwellIR record ABI; generic omega_gpu_om_ir_replay owns replay only.
note Scheduling follows mathlibs_ir.om: fixed stall 6; serialized loads/stores via pending barriers.
const AN ulong 65535
const AX ulong 18446744073709551615
fn aa_rg d ulong a ulong b ulong c ulong to ulong
ret or or d shl a 16 or shl b 32 shl c 48
end
fn aa_f v ulong to ulong
if eq v AN
ret AX
end
ret v
end
fn aa_cw st ulong wb ulong rb ulong wt ulong to ulong
ret or or shl st 9 shl wb 14 or shl rb 17 shl wt 20
end
fn aa_cc m edit ulong 512 kind ulong to ulong
wt = get m 3
cc = aa_cw 6 7 7 wt
nx = ulong 0
k = and kind 255
if eq k 1
cc = aa_cw 14 7 7 wt
end
if eq k 2
cc = or aa_cw 4 0 1 wt 8192
nx = ulong 3
end
if eq k 3
cc = or aa_cw 4 7 1 wt 8192
nx = ulong 2
end
if eq k 4
cc = or aa_cw 4 2 7 wt 8192
nx = ulong 4
end
if eq k 5
cc = aa_cw 5 7 7 wt
if ne shr kind 8 0
nx = wt
end
end
put m 3 nx
ret cc
end
fn aa_i x edit ulong 8192 m edit ulong 512 op ulong rg ulong imm ulong kind ulong to void
n = get m 0
if ge n 1024
put m 4 1
ret
end
b = mul n 8
put x b op
put x add b 1 aa_f and rg 65535
put x add b 2 aa_f and shr rg 16 65535
put x add b 3 aa_f and shr rg 32 65535
put x add b 4 aa_f shr rg 48
put x add b 5 AX
if or or eq op 11 eq op 19 eq op 12
put x add b 5 0
end
put x add b 7 shr kind 8
cc = aa_cc m kind
put x add b 6 or and imm 4294967295 shl cc 32
put m 0 add n 1
end
fn aa_v m edit ulong 512 k ulong to ulong
v = get m 1
if ge v 256
put m 4 2
ret 0
end
put m add 64 v k
put m 1 add v 1
ret v
end
fn aa_mov x edit ulong 8192 m edit ulong 512 d ulong imm ulong to void
aa_i x m 2 aa_rg d AN AN AN imm 0
end
fn aa_bin x edit ulong 8192 m edit ulong 512 op ulong d ulong a ulong b ulong to void
aa_i x m op aa_rg d a b AN 0 0
end
fn aa_mad x edit ulong 8192 m edit ulong 512 d ulong a ulong imm ulong c ulong to void
aa_i x m 8 aa_rg d a AN c imm 0
end
fn aa_addr x edit ulong 8192 m edit ulong 512 d ulong a ulong stride ulong base ulong to void
aa_i x m 9 aa_rg d a AN base stride 0
end
fn aa_load x edit ulong 8192 m edit ulong 512 d ulong addr ulong off ulong mode ulong to void
op = ulong 11
if ne and mode 255 0
op = ulong 19
if ne off 0
tmp = aa_v m 2
idx = aa_v m 1
aa_mov x m idx off
aa_addr x m tmp idx 1 addr
addr = tmp
off = ulong 0
end
end
aa_i x m op aa_rg d addr AN AN off or 2 and mode 65280
if ne and mode 255 0
aa_mad x m d d 65536 AN
end
end
fn aa_cmp x edit ulong 8192 m edit ulong 512 a ulong b ulong to void
aa_i x m 28 aa_rg AN a b AN 0 1
end
fn aa_bra x edit ulong 8192 m edit ulong 512 delta ulong flags ulong to void
aa_i x m 46 aa_rg AN AN AN AN delta or 5 shl flags 8
end
fn aa_pred x edit ulong 8192 m view ulong 512 flags ulong to void
at = sub get m 0 1
put x add mul at 8 7 flags
end

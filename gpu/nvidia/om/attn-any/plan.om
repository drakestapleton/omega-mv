note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shape: seq_q,seq_kv,head_dim,q_heads,kv_heads,causal,dtype,scale_bits.
note Plan: total Q/KV/O bytes, unused, per-head Q/KV/O byte offsets, rows, threads, mode.
note Refusal 1 is shape/format/size refusal, separate from bridge trap and allocation failure.
fn aa_plan s view ulong 8 head ulong p edit ulong 16 to ulong
for i ulong 16
put p i 0
end
for i ulong 5
if eq get s i 0
ret 1
end
end
if or gt get s 0 65535 gt get s 1 65535
ret 1
end
if or gt get s 2 256 gt get s 3 65535
ret 1
end
if gt get s 4 get s 3
ret 1
end
if ne rem get s 3 get s 4 0
ret 1
end
if or gt get s 5 1 gt get s 6 2
ret 1
end
if or ge head get s 3 gt get s 7 4294967295
ret 1
end
if eq and get s 7 2139095040 2139095040
ret 1
end
bytes = ulong 4
if ne get s 6 0
bytes = ulong 2
end
qn = mul mul get s 0 get s 2 get s 3
kn = mul mul get s 1 get s 2 get s 4
if or gt qn 1073741824 gt kn 1073741824
ret 1
end
put p 0 mul qn bytes
put p 1 mul kn bytes
put p 2 mul qn 4
put p 4 mul mul mul head get s 0 get s 2 bytes
kh = div head div get s 3 get s 4
put p 5 mul mul mul kh get s 1 get s 2 bytes
put p 6 mul mul mul head get s 0 get s 2 4
put p 7 get s 0
put p 8 32
put p 9 or get s 6 shl get s 5 8
ret 0
end

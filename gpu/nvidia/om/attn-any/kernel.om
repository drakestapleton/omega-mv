note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One warp per query row. Each lane owns ceil(head_dim/32) components; tails use predicated loads.
note Params at c0[896]: Q,K,V,O pointers, seq_kv u32, scale f32. Layout [head][sequence][component].
note R 0 lane,1 row,2..9 pointer pairs,10 keys,11 key,12 sum,13 max,14 scale,15 log2e,
note 16 dot,17 K,18 V,19 weight,20 alpha,21 tmp,22 reciprocal,23 limit,24..31 Q,32..39 O,
note 40 linear index,41 new maximum,42 exponent argument,43 tail bound,44 one.
fn aa_alloc m edit ulong 512 r edit ulong 64 to void
for i ulong 45
kind = ulong 1
if and ge i 2 le i 9
kind = ulong 2
end
put r i aa_v m kind
end
put m 2 1
put m 320 2
end
fn aa_copy x edit ulong 8192 m edit ulong 512 dst ulong src ulong to void
aa_mad x m dst src 1 AN
end
fn aa_start x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong mode ulong to void
aa_i x m 7 aa_rg 0 AN AN AN 856 260
aa_i x m 3 aa_rg get r 0 AN AN AN 33 2
aa_i x m 3 aa_rg get r 1 AN AN AN 37 2
for i ulong 4
aa_i x m 5 aa_rg get r add i 2 AN AN AN add 896 mul i 8 2
end
aa_i x m 4 aa_rg get r 10 AN AN AN 928 2
aa_i x m 4 aa_rg get r 14 AN AN AN 932 2
aa_mov x m get r 11 0
aa_mov x m get r 12 0
aa_mov x m get r 13 4286578688
aa_mov x m get r 15 1069066811
aa_mov x m get r 44 1
aa_mad x m get r 40 get r 1 dim get r 0
bytes = ulong 4
if ne and mode 255 0
bytes = ulong 2
end
aa_addr x m get r 6 get r 40 bytes get r 2
aa_addr x m get r 9 get r 40 4 get r 5
aa_copy x m get r 23 get r 10
if ne and mode 256 0
aa_mad x m get r 23 get r 1 1 get r 44
aa_cmp x m get r 23 get r 10
aa_copy x m get r 23 get r 10
aa_pred x m 2
end
end
fn aa_tailmode x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong chunk ulong mode ulong to ulong
flags = and mode 255
if lt sub dim mul chunk 32 32
aa_mov x m get r 43 sub dim mul chunk 32
aa_cmp x m get r 0 get r 43
flags = or flags 1536
end
ret flags
end
fn aa_qone x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong c ulong mode ulong to void
aa_mov x m get r add 24 c 0
aa_mov x m get r add 32 c 0
flags = aa_tailmode x m r dim c mode
bytes = ulong 128
if ne and mode 255 0
bytes = ulong 64
end
off = mul c bytes
qr = get r add 24 c
aa_load x m qr get r 6 off flags
end
fn aa_q x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong mode ulong to void
for c ulong div add dim 31 32
aa_qone x m r dim c mode
end
end
fn aa_ff x edit ulong 8192 m edit ulong 512 d ulong a ulong b ulong c ulong to void
rg = aa_rg d a b c
aa_i x m 33 rg 0 0
end
fn aa_chunk x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong c ulong mode ulong to void
flags = aa_tailmode x m r dim c mode
off = mul c 128
if ne and mode 255 0
off = mul c 64
end
aa_mov x m get r 17 0
aa_load x m get r 17 get r 7 off flags
qr = get r add 24 c
aa_ff x m get r 16 qr get r 17 get r 16
end
fn aa_dot x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong mode ulong to void
bytes = ulong 4
if ne and mode 255 0
bytes = ulong 2
end
aa_mad x m get r 40 get r 11 dim get r 0
aa_addr x m get r 7 get r 40 bytes get r 3
aa_addr x m get r 8 get r 40 bytes get r 4
aa_mov x m get r 16 0
for c ulong div add dim 31 32
aa_chunk x m r dim c mode
end
for j ulong 5
aa_i x m 60 aa_rg get r 21 get r 16 AN AN shr ulong 16 j 2
aa_bin x m 30 get r 16 get r 16 get r 21
end
aa_bin x m 32 get r 16 get r 16 get r 14
end
fn aa_exp x edit ulong 8192 m edit ulong 512 r view ulong 64 dst ulong src ulong to void
aa_bin x m 31 get r 42 src get r 41
aa_bin x m 32 get r 42 get r 42 get r 15
aa_i x m 47 aa_rg dst get r 42 AN AN 0 2
end
fn aa_soft x edit ulong 8192 m edit ulong 512 r view ulong 64 to void
aa_bin x m 37 get r 41 get r 13 get r 16
aa_exp x m r get r 20 get r 13
aa_exp x m r get r 19 get r 16
aa_ff x m get r 12 get r 12 get r 20 get r 19
aa_copy x m get r 13 get r 41
end
fn aa_vone x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong c ulong mode ulong to void
flags = aa_tailmode x m r dim c mode
off = mul c 128
if ne and mode 255 0
off = mul c 64
end
aa_mov x m get r 18 0
aa_load x m get r 18 get r 8 off flags
acc = get r add 32 c
aa_bin x m 32 acc acc get r 20
aa_ff x m acc get r 18 get r 19 acc
end
fn aa_value x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong mode ulong to void
for c ulong div add dim 31 32
aa_vone x m r dim c mode
end
end
fn aa_out x edit ulong 8192 m edit ulong 512 r view ulong 64 dim ulong to void
aa_i x m 40 aa_rg get r 22 get r 12 AN AN 0 2
n = div add dim 31 32
for c ulong n
acc = get r add 32 c
aa_bin x m 32 acc acc get r 22
flags = aa_tailmode x m r dim c 0
aa_i x m 12 aa_rg AN get r 9 acc AN mul c 128 3
aa_pred x m shr flags 8
end
aa_i x m 45 aa_rg AN AN AN AN 0 5
end
fn attn_any kind ulong dim ulong mode ulong mutant ulong x edit ulong 8192 m edit ulong 512 to ulong
for i ulong 512
put m i 0
end
if or or ne kind 0 ne mutant 0 or eq dim 0 gt dim 256
ret 1
end
if or gt and mode 255 2 gt mode 511
ret 1
end
r = new ulong 64 0
aa_alloc m r
aa_start x m r dim mode
aa_q x m r dim mode
start = get m 0
aa_dot x m r dim mode
aa_soft x m r
aa_value x m r dim mode
aa_mad x m get r 11 get r 11 1 get r 44
aa_cmp x m get r 11 get r 23
aa_bra x m sub start get m 0 6
put m 5 1
put m 16 start
put m 17 sub get m 0 1
aa_out x m r dim
if ne get m 4 0
ret 2
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One 32-wide scan tile. op 0 sum, 1 max, 2 min, 3 prefix sum.
note n is the live count; the rest of the window is the pad (-0 for sum and
note prefix, quiet NaN for min and max). The butterfly matches the frozen
note host reference: reduce combines i with i+d ascending, prefix adds
note descending so the earlier element is still old.
note Pad bits: -0 is 2147483648, quiet NaN is 2143289344.
fn av_pad op ulong to f32
if or eq op 0 eq op 3
ret bitcast f32 uint 2147483648
end
ret bitcast f32 uint 2143289344
end
fn av_fmax a f32 b f32 to f32
if gt a b
ret a
end
if gt b a
ret b
end
if eq a a
if eq b b
if and eq a 0.0f32 eq b 0.0f32
ret 0.0f32
end
ret b
end
ret a
end
ret b
end
fn av_fmin a f32 b f32 to f32
if lt a b
ret a
end
if lt b a
ret b
end
if eq a a
if eq bitcast uint b 2147483648
ret b
end
ret a
end
ret b
end
fn av_cmb op ulong a f32 b f32 to f32
if eq op 0
ret add a b
end
if eq op 1
ret av_fmax a b
end
ret av_fmin a b
end
fn av_scan op ulong n ulong inn view f32 32 out edit f32 32 to ulong
if eq n 0
ret 1
end
if gt n 32
ret 1
end
if gt op 3
ret 1
end
v = new f32 32 0.0f32
p = av_pad op
for i ulong 32
if lt i n
put v i get inn i
else
put v i p
end
end
if eq op 3
for t ulong 5
d = shl 1 t
for i ulong 32
k = sub 31 i
if ge k d
put v k add get v sub k d get v k
end
end
end
else
for t ulong 5
d = shr 16 t
for i ulong 32
if lt add i d 32
put v i av_cmb op get v i get v add i d
end
end
end
end
for i ulong 32
put out i get v i
end
ret 0
end

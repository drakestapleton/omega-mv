note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note qkv channel of value head h, slot s. Head dim 128, key heads 16.
note hk = h / (vh / 16). q is hk*128+s, k is 2048+hk*128+(s-128), v is
note 4096+h*128+(s-256). The caller keeps the slot loop and the loads.
fn av_gdnch h ulong s ulong vh ulong to ulong
hk = div h div vh 16
if lt s 128
ret add mul hk 128 s
end
if lt s 256
ret add 2048 add mul hk 128 sub s 128
end
ret add 4096 add mul h 128 sub s 256
end

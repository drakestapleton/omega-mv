om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Unpack per-head slots back to reference tail [3][conv].
note First writer is s>=256 or h rem (vh/16) == 0. Later copies must match bits.
note Returns the mismatch count. 0 agrees. 384 is OMEGA_GDN_SLOTS.
note WolframLanguageEvaluator: {2^14 - 1, 2^17 - 1} -> {16383, 131071}.
note Pack is ch 14 bits, base 17 bits, conv from bit 31. vh<=48 stays inside.
note Row meta is hh 6 bits, vh 6 bits, conv from bit 12.
fn av_ch hh ulong ss ulong vh ulong to ulong
hk = div hh div vh 16
if lt ss 128
ret add mul hk 128 ss
end
if lt ss 256
ret add 2048 add mul hk 128 sub ss 128
end
ret add 4096 add mul hh 128 sub ss 256
end
fn av_base hh ulong ss ulong to ulong
ret mul add mul hh 384 ss 4
end
fn av_pk ch ulong base ulong conv ulong to ulong
ret add add ch shl base 14 shl conv 31
end
fn av_slot hh ulong ss ulong vh ulong conv ulong to ulong
ret av_pk av_ch hh ss vh av_base hh ss conv
end
fn av_wr tail edit f32 * dev view f32 * pk ulong to ulong
ch = and pk 16383
base = and shr pk 14 131071
conv = shr pk 31
put tail ch get dev base
put tail add ch conv get dev add base 1
put tail add ch mul conv 2 get dev add base 2
ret 0
end
fn av_cmp tail view f32 * dev view f32 * pk ulong to ulong
ch = and pk 16383
base = and shr pk 14 131071
conv = shr pk 31
bad = ulong 0
if ne bitcast uint get tail ch bitcast uint get dev base
bad = add bad 1
end
if ne bitcast uint get tail add ch conv bitcast uint get dev add base 1
bad = add bad 1
end
if ne bitcast uint get tail add ch mul conv 2 bitcast uint get dev add base 2
bad = add bad 1
end
ret bad
end
fn av_row dev view f32 * tail edit f32 * meta ulong to ulong
hh = and meta 63
vh = and shr meta 6 63
conv = shr meta 12
bad = ulong 0
step = ulong 0
for ss ulong 384
slot = av_slot hh ss vh conv
if ge ss 256
step = av_wr tail dev slot
else
if eq rem hh div vh 16 0
step = av_wr tail dev slot
else
bad = add bad av_cmp tail dev slot
end
end
end
ret bad
end
fn av_meta hh ulong vh ulong conv ulong to ulong
ret add add hh shl vh 6 shl conv 12
end
fn av_gdnut dev view f32 * tail edit f32 * vh ulong conv ulong to ulong
if eq div vh 16 0
ret 1
end
if ne len dev mul mul vh 384 4
ret 1
end
if ne len tail mul conv 3
ret 1
end
bad = ulong 0
for hh ulong vh
bad = add bad av_row dev tail av_meta hh vh conv
end
ret bad
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Cross-tile carry: preserve tot[tile - 1] + out[e], including signed zeros.
fn ar_carry src view f32 * dst edit f32 * to ulong
n = len dst
if lt len src div add n 31 32
ret 1
end
e = ulong 32
while lt e n
put dst e add get src sub div e 32 1 get dst e
e = add e 1
end
ret 0
end

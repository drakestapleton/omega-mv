note FP8/GDN host-only policy; effect acquisition remains in the C caller.
fn ah_flag c ulong tail ulong dflt ulong to ulong
if eq tail 0
if eq c 48
ret 0
end
if eq c 49
ret 1
end
end
ret dflt
end
fn ah_var c ulong tail ulong to ulong
if and eq c 50 eq tail 0
ret 2
end
ret 1
end
fn ah_shape k uint over uint kind uint to uint
if ne over 0
ret over
end
if eq kind 0
if eq rem k 512 0
ret 16
end
ret 8
end
if eq kind 1
ret 1
end
ret 8
end
fn ah_reg threads ulong decl ulong to ulong
if le mul threads decl 65536
ret 1
end
ret 0
end
fn ah_group groups uint forced uint wave ulong to uint
if and gt forced 0 le forced 256
ret forced
end
if or eq wave 0 eq groups 0
ret 6
end
n = div uint 48 groups
if eq n 0
ret 1
end
if lt n 6
ret n
end
ret 6
end
fn ah_digit n uint c uint to ulong
if or lt c 48 gt c 57
ret 4294967296
end
if ge n 1000
ret 4294967296
end
ret ulong add mul n 10 sub c 48
end
fn ah_warps k uint groups uint over uint bigk ulong variant ulong to uint
if ne over 0
ret over
end
if eq variant 2
ret 16
end
if gt groups 1
ret 32
end
if and and eq groups 1 gt k 4096 ne bigk 0
ret 16
end
ret 8
end
fn ah_coal on ulong warps uint rows uint to uint
if and ne on 0 le mul warps rows 32
ret 1
end
ret 0
end
fn ah_depth k uint lb uint rows uint warps uint groups uint bigk ulong to ulong
ks = div k mul uint 32 lb
partial = false
if gt mul mul ks rows lb 128
if gt k 4096
if eq groups 1
partial = ne bigk 0
end
end
end
if partial
full = ks
ks = sub ks 1
while gt ks 1
if eq rem full ks 0
if le mul mul ks rows lb 128
break
end
end
ks = sub ks 1
end
if lt ks 2
ret 0
end
end
if gt mul mul ks rows lb 128
ret 0
end
if ne rem k mul uint 32 warps 0
ret 0
end
if gt k mul uint 512 warps
ret 0
end
if partial
ret or ulong ks 4294967296
end
ret ulong ks
end
fn ah_refuse n uint rows uint support ulong to ulong
if ne rem n rows 0
ret 1
end
if eq support 0
ret 1
end
ret 0
end
fn ah_grid n uint rows uint warps uint budget uint bigk ulong to uint
rg = div n rows
gx = div add rg sub warps 1 warps
if ne bigk 0
waves = div add gx 383 384
if lt waves 2
waves = 2
end
gx = div add gx sub waves 1 waves
budget = gx
end
if gt gx budget
gx = budget
end
if eq gx 0
gx = 1
end
ret gx
end
fn ah_cache valid ulong equal ulong rec ulong to ulong
if and ne valid 0 ne equal 0
ret 1
end
if and ne valid 0 ne rec 0
ret 2
end
ret 0
end
fn ah_move kind ulong dst ulong bytes ulong per ulong to ulong
if or or or and ne kind 4 ne kind 5 eq dst 0 eq bytes 0 ne rem bytes per 0
ret 0
end
if gt div bytes per 2147483647
ret 0
end
ret div bytes per
end
fn ah_tokens layer uint layers uint t uint low uint high uint to ulong
if or or ge layer layers lt t low gt t high
ret 0
end
ret 1
end
fn ah_scratch rec ulong present ulong cap ulong bytes ulong to ulong
if and ne rec 0 or eq present 0 lt cap bytes
ret 0
end
ret 1
end
fn ah_pfgx t uint prep uint ratio uint stage uint to uint
if eq stage 0
ret div add t sub prep 1 prep
end
if eq stage 1
ret ratio
end
ret t
end
fn ah_dcall p view ulong 16 to ulong
a = uint get p 0
b = uint get p 1
c = uint get p 2
d = uint get p 3
e = uint get p 4
f = get p 5
ret ah_depth a b c d e f
end
fn ah_tcall p view ulong 16 to ulong
a = uint get p 0
b = uint get p 1
c = uint get p 2
d = uint get p 3
e = uint get p 4
ret ah_tokens a b c d e
end
fn ah_admit p view ulong 16 to ulong
if eq get p 0 0
if ne get p 1 0
if or or eq get p 2 0 eq get p 3 0 eq get p 4 0
ret 0
end
end
ret 1
end
if eq get p 0 1
if eq get p 1 0
ret 0
end
if and eq get p 2 0 eq get p 3 0
ret 0
end
if and and eq get p 4 0 eq get p 5 0 eq get p 6 0
ret 0
end
if and eq get p 7 0 eq get p 8 0
ret 0
end
ret 1
end
if ne get p 1 0
if or or eq get p 2 0 eq get p 3 0 eq get p 4 0
ret 0
end
else
if or or or eq get p 5 0 eq get p 6 0 eq get p 7 0 eq get p 8 0
ret 0
end
end
ret 1
end
fn ah_extra op ulong p view ulong 16 to ulong
if eq op 24
k = uint get p 0
lb = uint get p 1
r = uint get p 2
ks = div k mul uint 32 lb
if gt mul mul ks r lb 128
if and gt k 4096 eq get p 3 1
ret 1
end
end
ret 0
end
if eq op 23
ret ah_admit p
end
if eq op 16
for i ulong 8
if ne get p i 0
ret 0
end
end
ret 1
end
if eq op 17
if eq get p 0 0
ret 0
end
if or eq get p 1 1 eq get p 1 get p 0
ret 1
end
ret 0
end
if eq op 18
if ne get p 0 0
ret get p 1
end
if gt get p 2 1
if eq get p 3 2
ret 12
end
ret get p 4
end
ret 256
end
if eq op 19
if ne get p 0 0
ret 0
end
if ne get p 1 1
ret 0
end
if le get p 2 4096
ret 0
end
ret get p 3
end
if eq op 20
if ne get p 0 1
ret 0
end
if eq get p 1 0
ret 0
end
if gt get p 2 get p 3
ret 0
end
ret 1
end
if eq op 21
if gt get p 0 get p 1
ret 1
end
ret 0
end
ret div get p 0 get p 1
end
fn ah_rest op ulong p view ulong 16 to ulong
if ge op 16
ret ah_extra op p
end
if eq op 0
ret ah_flag get p 0 get p 1 get p 2
end
if eq op 1
ret ah_var get p 0 get p 1
end
if eq op 2
ret ulong ah_shape uint get p 0 uint get p 1 uint get p 2
end
if eq op 3
ret ah_reg get p 0 get p 1
end
if eq op 4
ret ulong ah_group uint get p 0 uint get p 1 get p 2
end
if eq op 5
ret ah_digit uint get p 0 uint get p 1
end
if eq op 6
ret ulong ah_warps uint get p 0 uint get p 1 uint get p 2 get p 3 get p 4
end
if eq op 7
ret ulong ah_coal get p 0 uint get p 1 uint get p 2
end
if eq op 8
ret ah_dcall p
end
if eq op 9
ret ah_refuse uint get p 0 uint get p 1 get p 2
end
if eq op 10
ret ulong ah_grid uint get p 0 uint get p 1 uint get p 2 uint get p 3 get p 4
end
if eq op 11
ret ah_cache get p 0 get p 1 get p 2
end
if eq op 12
ret ah_move get p 0 get p 1 get p 2 get p 3
end
if eq op 13
ret ah_tcall p
end
if eq op 14
ret ah_scratch get p 0 get p 1 get p 2 get p 3
end
ret ulong ah_pfgx uint get p 0 uint get p 1 uint get p 2 uint get p 3
end

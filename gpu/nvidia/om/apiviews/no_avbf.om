note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Freestanding scalar ABI for bf16.om. Float bit transport stays in C;
note both NaN policies and round-to-nearest-even are seeded Omega.
note Keep equivalent to canonical av_rne/av_stbf; no_avbf is the sole export.
fn na_rne u uint to uint
a = and u 2139095040
if eq a 2139095040
if ne and u 8388607 0
ret or shr u 16 64
end
ret shr u 16
end
ret shr add add u 32767 and shr u 16 1 16
end
fn na_stbf u uint to uint
if gt and u 2147483647 2139095040
ret 32704
end
ret shr add add u 32767 and shr u 16 1 16
end
fn no_avbf md ulong raw ulong to ulong
u = uint raw
if eq md 0
ret ulong and na_rne u 65535
end
ret ulong and na_stbf u 65535
end

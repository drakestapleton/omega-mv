om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Fold f32 x by 2^64. WolframLanguageEvaluator: bits32[2^64] -> 1602224128.
fn av_fp8x src view f32 * dst edit f32 * to ulong
if ne len src len dst
ret 1
end
fold = bitcast f32 uint 1602224128
for i ulong len src
put dst i mul get src i fold
end
ret 0
end

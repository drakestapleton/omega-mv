note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note f32 to e4m3, round to nearest, ties to even, saturate at 448 (code 0x7e).
note Subnormals are units of 2^-9. 448.0f32 is 1138753536, 512.0f32 is 1140850688,
note 0.5f32 is 1056964608. WolframLanguageEvaluator: FromDigits of those Real32
note bit lists -> 1138753536, 1140850688, 1056964608.
note Truncation of a*512 (always in [0, 8)) is a bit extract, not a cast.
note The row unit quantizes n bf16 values (window 128) by the f32 scale whose
note bits are sc shifted left 16. The caller owns the block loop.
fn av_u2f n uint to f32
if eq n 0
ret 0.0f32
end
p = uint 0
if ge n 2
p = uint 1
end
if ge n 4
p = uint 2
end
if ge n 8
p = uint 3
end
mant = and shl n sub 23 p 8388607
ret bitcast f32 or shl add 127 p 23 mant
end
fn av_trunc8 x f32 to uint
u = bitcast uint x
e = shr u 23
if lt e 127
ret 0
end
m = or and u 8388607 8388608
ret shr m sub 150 e
end
fn av_qsub a f32 to uint
x = mul f32 a bitcast f32 uint 1140850688
xi = av_trunc8 x
fr = sub x av_u2f xi
hf = bitcast f32 uint 1056964608
if gt fr hf
ret add xi 1
end
if and eq fr hf ne and xi 1 0
ret add xi 1
end
ret xi
end
fn av_qnorm ab uint to uint
m = and ab 8388607
rb = and shr m 19 1
st = and m 524287
q = shr m 20
e = sub add shr ab 23 7 127
if and ne rb 0 or ne st 0 ne and q 1 0
q = add q 1
end
if eq q 8
q = uint 0
e = add e 1
end
code = or shl e 3 q
if gt code 126
ret uint 126
end
ret code
end
fn qe4m3 v f32 to uint
u = bitcast uint v
s = and shr u 24 128
ab = and u 2147483647
a = bitcast f32 ab
if not lt a bitcast f32 uint 1138753536
ret or s 126
end
if lt shr ab 23 121
ret or s av_qsub a
end
ret or s av_qnorm ab
end
fn av_e4m3 bits ulong to ulong
ret ulong qe4m3 bitcast f32 uint and bits 4294967295
end
fn av_fp8q n ulong sc ulong w view ushort 128 out edit uchar 128 to ulong
if gt n 128
ret 1
end
sf = bitcast f32 shl uint sc 16
for i ulong 128
if lt i n
f = bitcast f32 shl uint get w i 16
put out i uchar and qe4m3 div f sf 255
end
end
ret 0
end

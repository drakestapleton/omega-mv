om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Widen bf16 x and fold by 2^64. WolframLanguageEvaluator: bits32[2^64] -> 1602224128.
fn av_w16 u uint to f32
ret bitcast f32 shl u 16
end
fn av_fp8xb src view ushort * dst edit f32 * to ulong
if ne len src len dst
ret 1
end
fold = bitcast f32 uint 1602224128
for i ulong len src
u = uint get src i
put dst i mul av_w16 u fold
end
ret 0
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pack reference tail [3][conv] into per-head slots of 384 by 4.
note Channel: s<128 q, s<256 k, else v. Slot 3 is 0. 384 is OMEGA_GDN_SLOTS.
note Unsized views take two parameter slots, so the loops stay in the export.
fn av_ch hh ulong ss ulong vh ulong to ulong
hk = div hh div vh 16
if lt ss 128
ret add mul hk 128 ss
end
if lt ss 256
ret add 2048 add mul hk 128 sub ss 128
end
ret add 4096 add mul hh 128 sub ss 256
end
fn av_base hh ulong ss ulong to ulong
ret mul add mul hh 384 ss 4
end
fn av_gdnpt tail view f32 * dst edit f32 * vh ulong conv ulong to ulong
if eq div vh 16 0
ret 1
end
if ne len dst mul mul vh 384 4
ret 1
end
if ne len tail mul conv 3
ret 1
end
for hh ulong vh
for ss ulong 384
ch = av_ch hh ss vh
base = av_base hh ss
put dst base get tail ch
put dst add base 1 get tail add ch conv
put dst add base 2 get tail add ch mul conv 2
put dst add base 3 0.0f32
end
end
ret 0
end

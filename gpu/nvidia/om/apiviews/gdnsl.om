note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One packed tail slot: three source floats and a zero. Exact window,
note no count. The caller loaded the three floats with the channel from av_gdnch.
fn av_gdnsl src view f32 3 dst edit f32 4 to ulong
put dst 0 get src 0
put dst 1 get src 1
put dst 2 get src 2
put dst 3 0.0f32
ret 0
end

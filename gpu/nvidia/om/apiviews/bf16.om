om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note f32 to bf16 over the live view. md 0 is round-to-nearest-even (payload-quiet NaN).
note md 1 is the gdn state_put rule: any NaN becomes 0x7fc0, sign cleared.
note 0x7fffffff 2147483647, 0x7f800000 2139095040, 0x7fff 32767, 0x7fc0 32704.
fn av_rne u uint to uint
a = and u 2139095040
if eq a 2139095040
if ne and u 8388607 0
ret or shr u 16 64
end
ret shr u 16
end
ret shr add add u 32767 and shr u 16 1 16
end
fn av_stbf u uint to uint
if gt and u 2147483647 2139095040
ret 32704
end
ret shr add add u 32767 and shr u 16 1 16
end
fn av_bf16 md ulong x view f32 * y edit ushort * to ulong
if ne len x len y
ret 1
end
for i ulong len x
u = bitcast uint get x i
if eq md 0
put y i ushort and av_rne u 65535
else
put y i ushort and av_stbf u 65535
end
end
ret 0
end

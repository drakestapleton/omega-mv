note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/doctor/main.om: pure-Omega CLI replacing CUDApp tools/doctor/cudapp_doctor.c.
note Compose after gpu/nvidia/om/tools/fmt.om and gpu/nvidia/om/tools/doctor.om:
note   cat gpu/nvidia/om/tools/fmt.om gpu/nvidia/om/tools/doctor.om gpu/nvidia/tools/doctor/main.om | seed/out/omc > cudapp-doctor
note
note Reads files only (/proc, /sys, /dev): opens NO GPU device and needs NO GPU window.
note Supports CUDAPP_DOCTOR_ROOT=<dir> or --root <dir> for synthetic root testing.
note Exit: 0 READY, 1 NOT READY (at least one FAIL line), 2 doctor unit refusal or usage error.

text dr_abi "580.173.02"
text dr_cmp "seed/out/omc (pure Omega)"
text dr_eroot "CUDAPP_DOCTOR_ROOT="
text dr_froot "--root"
text dr_pver "/proc/driver/nvidia/version"
text dr_pctl "/dev/nvidiactl"
text dr_pdev0 "/dev/nvidia0"
text dr_puvm "/dev/nvidia-uvm"
text dr_ppci "/sys/bus/pci/devices"
text dr_pmem "/proc/meminfo"
text dr_pnv1 "/usr/local/cuda/bin/nvcc"
text dr_pnv2 "/usr/bin/nvcc"
text dr_pos "/proc/sys/kernel/ostype"
text dr_prel "/proc/sys/kernel/osrelease"
text dr_pven "/vendor"
text dr_pdev "/device"
text dr_pcls "/class"
text dr_arch_a64 "aarch64"
text dr_gb10_name "NVIDIA GB10"
text dr_gb10_sm "sm_121"
text dr_gb10_rc "M16-GB10"
text dr_sm86_name "NVIDIA Ampere"
text dr_sm86_sm "sm_86"
text dr_sm86_rc "M16-AMPERE-HOST"
text dr_ref_a "GPU "
text dr_ref_b ": unsupported NVIDIA PCI device (vendor 0x10de)\nThis GPU is not in the qualified chip table yet.\n"
text dr_mtot "MemTotal:"
text dr_mavl "MemAvailable:"
text dr_err_ref "cudapp-doctor: doctor unit refused\n"
text dr_err_use "usage: cudapp-doctor [--root DIR]\n"

global dr_root uchar 2048
global dr_path uchar 4096
global dr_tmp uchar 4096
global dr_dents uchar 16384
global dr_rlen ulong 1
global dr_used ulong 1

fn dr_bput f edit ulong 256 b edit uchar 262144 at ulong s view uchar 4096 n ulong to void
u = get dr_used 0
if gt add u n 262144
ret
end
for i ulong n bound 4096
put b add u i get s i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end

fn dr_bput_t f edit ulong 256 b edit uchar 262144 at ulong kind ulong to void
u = get dr_used 0
if eq kind 0
n = len dr_abi
if le add u n 262144
for i ulong n
put b add u i get dr_abi i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 1
n = len dr_cmp
if le add u n 262144
for i ulong n
put b add u i get dr_cmp i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 2
n = len dr_arch_a64
if le add u n 262144
for i ulong n
put b add u i get dr_arch_a64 i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 3
n = len dr_gb10_name
if le add u n 262144
for i ulong n
put b add u i get dr_gb10_name i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 4
n = len dr_gb10_sm
if le add u n 262144
for i ulong n
put b add u i get dr_gb10_sm i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 5
n = len dr_gb10_rc
if le add u n 262144
for i ulong n
put b add u i get dr_gb10_rc i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 6
n = len dr_sm86_name
if le add u n 262144
for i ulong n
put b add u i get dr_sm86_name i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 7
n = len dr_sm86_sm
if le add u n 262144
for i ulong n
put b add u i get dr_sm86_sm i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
if eq kind 8
n = len dr_sm86_rc
if le add u n 262144
for i ulong n
put b add u i get dr_sm86_rc i
end
put f at u
put f add at 1 n
put dr_used 0 add u n
end
ret
end
end

fn dr_mkpath kind ulong to ulong
rl = get dr_rlen 0
for i ulong rl bound 2048
put dr_path i get dr_root i
end
p = rl
if eq kind 0
for i ulong len dr_pver
put dr_path add p i get dr_pver i
end
ret add p len dr_pver
end
if eq kind 1
for i ulong len dr_pctl
put dr_path add p i get dr_pctl i
end
ret add p len dr_pctl
end
if eq kind 2
for i ulong len dr_pdev0
put dr_path add p i get dr_pdev0 i
end
ret add p len dr_pdev0
end
if eq kind 3
for i ulong len dr_puvm
put dr_path add p i get dr_puvm i
end
ret add p len dr_puvm
end
if eq kind 4
for i ulong len dr_ppci
put dr_path add p i get dr_ppci i
end
ret add p len dr_ppci
end
if eq kind 5
for i ulong len dr_pmem
put dr_path add p i get dr_pmem i
end
ret add p len dr_pmem
end
if eq kind 6
for i ulong len dr_pnv1
put dr_path add p i get dr_pnv1 i
end
ret add p len dr_pnv1
end
if eq kind 7
for i ulong len dr_pnv2
put dr_path add p i get dr_pnv2 i
end
ret add p len dr_pnv2
end
if eq kind 8
for i ulong len dr_pos
put dr_path add p i get dr_pos i
end
ret add p len dr_pos
end
for i ulong len dr_prel
put dr_path add p i get dr_prel i
end
ret add p len dr_prel
end

fn dr_readsmall plen ulong to long
fd = fopen dr_path 0 plen 0 0
if lt fd 0
ret -1
end
got = read int fd dr_tmp 0 4096
r = fclose int fd
ret got
end

fn dr_hexval n ulong to ulong
p = ulong 0
if ge n 2
if and eq get dr_tmp 0 48 or eq get dr_tmp 1 120 eq get dr_tmp 1 88
p = ulong 2
end
end
v = ulong 0
while lt p n bound 32
c = ulong get dr_tmp p
if and ge c 48 le c 57
v = add mul v 16 sub c 48
else
if and ge c 97 le c 102
v = add mul v 16 add 10 sub c 97
else
if and ge c 65 le c 70
v = add mul v 16 add 10 sub c 65
else
break
end
end
end
p = add p 1
end
ret v
end

fn dr_trimnl n ulong to ulong
k = n
while gt k 0 bound 4096
c = get dr_tmp sub k 1
if or eq c 10 eq c 13
k = sub k 1
else
break
end
end
ret k
end

fn dr_find_mem n ulong is_avail bool to ulong
p = ulong 0
while lt p n bound 4096
hit = false
if not is_avail
if le add p len dr_mtot n
hit = true
for j ulong len dr_mtot
if ne get dr_tmp add p j get dr_mtot j
hit = false
break
end
end
if hit
p = add p len dr_mtot
end
end
else
if le add p len dr_mavl n
hit = true
for j ulong len dr_mavl
if ne get dr_tmp add p j get dr_mavl j
hit = false
break
end
end
if hit
p = add p len dr_mavl
end
end
end
if hit
while lt p n bound 4096
c = get dr_tmp p
if or eq c 32 eq c 9
p = add p 1
else
break
end
end
v = ulong 0
while lt p n bound 4096
c = ulong get dr_tmp p
if and ge c 48 le c 57
v = add mul v 10 sub c 48
p = add p 1
else
break
end
end
ret v
end
while lt p n bound 4096
if eq get dr_tmp p 10
p = add p 1
break
end
p = add p 1
end
end
ret 0
end

fn dr_load_root to bool
ac = argcnt
if eq ac 3
n1 = argread 1 dr_tmp 0 4096
if eq n1 long len dr_froot
ok = true
for i ulong len dr_froot
if ne get dr_tmp i get dr_froot i
ok = false
break
end
end
if ok
n2 = argread 2 dr_root 0 2048
if lt n2 0
ret false
end
put dr_rlen 0 ulong n2
ret true
end
end
ret false
end
if ne ac 1
ret false
end
ec = envcnt
for i ulong ulong ec bound 4096
en = envread i dr_tmp 0 4096
if ge en long len dr_eroot
ok = true
for j ulong len dr_eroot
if ne get dr_tmp j get dr_eroot j
ok = false
break
end
end
if ok
vl = sub ulong en len dr_eroot
if gt vl 2048
ret false
end
for j ulong vl bound 2048
put dr_root j get dr_tmp add len dr_eroot j
end
put dr_rlen 0 vl
ret true
end
end
end
put dr_rlen 0 0
ret true
end

global dr_bdf uchar 64
global dr_ngpu ulong 1

fn dr_add_refusal f edit ulong 256 b edit uchar 262144 g ulong nl ulong to void
refb = new uchar 4096 0
rp = ulong 0
for k ulong len dr_ref_a
put refb add rp k get dr_ref_a k
end
rp = add rp len dr_ref_a
for k ulong nl bound 64
put refb add rp k get dr_bdf k
end
rp = add rp nl
for k ulong len dr_ref_b
put refb add rp k get dr_ref_b k
end
rp = add rp len dr_ref_b
dr_bput edit f edit b add g 4 view refb rp
end

fn dr_record_gpu f edit ulong 256 b edit uchar 262144 nl ulong dev ulong ngpu ulong to void
g = add 32 mul ngpu 12
u = get dr_used 0
if le add u nl 262144
for k ulong nl bound 64
put b add u k get dr_bdf k
end
put f g u
put f add g 1 nl
put dr_used 0 add u nl
end
if eq dev 11794
put f add g 2 1
put f add g 3 1
dr_bput_t edit f edit b add g 4 3
dr_bput_t edit f edit b add g 6 4
dr_bput_t edit f edit b add g 8 5
ret
end
is86 = false
if eq dev 8708
is86 = true
end
if eq dev 8710
is86 = true
end
if eq dev 8712
is86 = true
end
if eq dev 9348
is86 = true
end
if eq dev 9353
is86 = true
end
if is86
put f add g 2 1
put f add g 3 0
dr_bput_t edit f edit b add g 4 6
dr_bput_t edit f edit b add g 6 7
dr_bput_t edit f edit b add g 8 8
ret
end
put f add g 2 0
dr_add_refusal edit f edit b g nl
end

fn dr_check_bdf f edit ulong 256 b edit uchar 262144 nl ulong to void
if eq nl 0
ret
end
if and eq nl 1 eq get dr_bdf 0 46
ret
end
if and eq nl 2 and eq get dr_bdf 0 46 eq get dr_bdf 1 46
ret
end
bp = dr_mkpath 4
put dr_path bp 47
bp = add bp 1
for k ulong nl bound 64
put dr_path add bp k get dr_bdf k
end
bp = add bp nl
for k ulong len dr_pcls
put dr_path add bp k get dr_pcls k
end
cn = dr_readsmall add bp len dr_pcls
if le cn 0
ret
end
if ne shr dr_hexval ulong cn 16 3
ret
end
for k ulong len dr_pven
put dr_path add bp k get dr_pven k
end
vn = dr_readsmall add bp len dr_pven
if le vn 0
ret
end
ven = dr_hexval ulong vn
if ne ven 4318
ret
end
for k ulong len dr_pdev
put dr_path add bp k get dr_pdev k
end
dn = dr_readsmall add bp len dr_pdev
dev = ulong 0
if gt dn 0
dev = dr_hexval ulong dn
end
ngpu = get dr_ngpu 0
if lt ngpu 16
dr_record_gpu edit f edit b nl dev ngpu
end
put dr_ngpu 0 add ngpu 1
end

fn dr_walk_dents f edit ulong 256 b edit uchar 262144 got ulong to void
pos = ulong 0
while lt pos got bound 1024
lo = ulong get dr_dents add pos 16
hi = ulong get dr_dents add pos 17
reclen = or lo shl hi 8
if eq reclen 0
break
end
ns = add pos 19
lim = add pos reclen
nl = ulong 0
while lt add ns nl lim bound 64
c = get dr_dents add ns nl
if eq c 0
break
end
put dr_bdf nl c
nl = add nl 1
end
dr_check_bdf edit f edit b nl
pos = add pos reclen
end
end

fn dr_probe_pci f edit ulong 256 b edit uchar 262144 to void
plen = dr_mkpath 4
fd = fopen dr_path 0 plen 0 0
if lt fd 0
put f 20 1
ret
end
put dr_ngpu 0 0
while true bound 256
got = getdnts int fd dr_dents 0 16384
if le got 0
break
end
dr_walk_dents edit f edit b ulong got
end
r = fclose int fd
put f 19 get dr_ngpu 0
end

fn main to int
f = new ulong 256 0
b = new uchar 262144 0
ob = new uchar 786432 0
tmp = new uchar 4096 0

if not dr_load_root
r = write 2 dr_err_use 0 len dr_err_use
ret 2
end
put dr_used 0 0

rl = get dr_rlen 0
for i ulong rl bound 2048
put tmp i get dr_root i
end
dr_bput edit f edit b 0 view tmp rl
dr_bput_t edit f edit b 2 0
dr_bput_t edit f edit b 4 1

note System info from /proc/sys/kernel/{ostype,osrelease}
osn = dr_readsmall dr_mkpath 8
if gt osn 0
osl = dr_trimnl ulong osn
for i ulong osl bound 256
put tmp i get dr_tmp i
end
dr_bput edit f edit b 7 view tmp osl
reln = dr_readsmall dr_mkpath 9
if gt reln 0
rell = dr_trimnl ulong reln
for i ulong rell bound 256
put tmp i get dr_tmp i
end
dr_bput edit f edit b 9 view tmp rell
dr_bput_t edit f edit b 11 2
put f 6 1
end
end

note NVIDIA kernel module version line
vn = dr_readsmall dr_mkpath 0
if gt vn 0
vl = ulong 0
while lt vl ulong vn bound 1024
if eq get dr_tmp vl 10
break
end
put tmp vl get dr_tmp vl
vl = add vl 1
end
put f 13 1
dr_bput edit f edit b 14 view tmp vl
end

note Device nodes: 0 ok, 1 missing, 2 not rw
for i ulong 3
plen = dr_mkpath add 1 i
if ne faccess dr_path 0 plen 0 0
put f add 16 i 1
else
if ne faccess dr_path 0 plen 6 0
put f add 16 i 2
else
put f add 16 i 0
end
end
end

note PCI GPU scan
dr_probe_pci edit f edit b

note /proc/meminfo
mn = dr_readsmall dr_mkpath 5
if gt mn 0
put f 21 1
put f 22 dr_find_mem ulong mn false
put f 23 dr_find_mem ulong mn true
end

note CUDA toolkit note (not needed)
if eq faccess dr_path 0 dr_mkpath 6 1 0
put f 24 1
else
if eq faccess dr_path 0 dr_mkpath 7 1 0
put f 24 2
else
put f 24 0
end
end

res = doctor view f view b edit ob
if ne and res 9223372036854775808 0
r = write 2 dr_err_ref 0 len dr_err_ref
ret 2
end
olen = and res 4294967295
fails = shr res 32
r = write 1 ob 0 olen
if ne fails 0
ret 1
end
ret 0
end

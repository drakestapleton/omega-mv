note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/doctor/test.om: pure-Omega positive and negative tests for gpu/nvidia/om/tools/doctor.om.
note Compose after gpu/nvidia/om/tools/fmt.om and gpu/nvidia/om/tools/doctor.om.

text dt_pass "PASS doctor pure-Omega READY and FAIL controls\n"
text dt_fail "FAIL doctor\n"
text dt_abi "580.173.02"
text dt_cmp "omc"
text dt_ver_ok "NVRM version: NVIDIA UNIX Open Kernel Module for aarch64  580.173.02  Release Build"
text dt_ver_bad "NVRM version: NVIDIA UNIX Open Kernel Module for aarch64  570.12.00  Release Build"
text dt_bdf "000f:01:00.0"
text dt_name "NVIDIA GB10"
text dt_sm "sm_121"
text dt_rc "M16-GB10"

global dt_u ulong 1

fn dt_put f edit ulong 256 b edit uchar 262144 at ulong kind ulong to void
u = get dt_u 0
if eq kind 0
for i ulong len dt_abi
put b add u i get dt_abi i
end
put f at u
put f add at 1 len dt_abi
put dt_u 0 add u len dt_abi
ret
end
if eq kind 1
for i ulong len dt_cmp
put b add u i get dt_cmp i
end
put f at u
put f add at 1 len dt_cmp
put dt_u 0 add u len dt_cmp
ret
end
if eq kind 2
for i ulong len dt_ver_ok
put b add u i get dt_ver_ok i
end
put f at u
put f add at 1 len dt_ver_ok
put dt_u 0 add u len dt_ver_ok
ret
end
if eq kind 3
for i ulong len dt_ver_bad
put b add u i get dt_ver_bad i
end
put f at u
put f add at 1 len dt_ver_bad
put dt_u 0 add u len dt_ver_bad
ret
end
if eq kind 4
for i ulong len dt_bdf
put b add u i get dt_bdf i
end
put f at u
put f add at 1 len dt_bdf
put dt_u 0 add u len dt_bdf
ret
end
if eq kind 5
for i ulong len dt_name
put b add u i get dt_name i
end
put f at u
put f add at 1 len dt_name
put dt_u 0 add u len dt_name
ret
end
if eq kind 6
for i ulong len dt_sm
put b add u i get dt_sm i
end
put f at u
put f add at 1 len dt_sm
put dt_u 0 add u len dt_sm
ret
end
for i ulong len dt_rc
put b add u i get dt_rc i
end
put f at u
put f add at 1 len dt_rc
put dt_u 0 add u len dt_rc
end

fn main to int
f = new ulong 256 0
b = new uchar 262144 0
ob = new uchar 786432 0

note Case 1: Ready GB10 host -> 0 fails, nonzero output
put dt_u 0 0
dt_put edit f edit b 2 0
dt_put edit f edit b 4 1
put f 13 1
dt_put edit f edit b 14 2
put f 16 0
put f 17 0
put f 18 0
put f 19 1
put f 20 0
put f 21 1
put f 22 134217728
put f 23 100663296
dt_put edit f edit b 32 4
put f 34 1
put f 35 1
dt_put edit f edit b 36 5
dt_put edit f edit b 38 6
dt_put edit f edit b 40 7

res1 = doctor view f view b edit ob
if ne and res1 9223372036854775808 0
r = write 2 dt_fail 0 len dt_fail
ret 1
end
if ne shr res1 32 0
r = write 2 dt_fail 0 len dt_fail
ret 2
end
if eq and res1 4294967295 0
r = write 2 dt_fail 0 len dt_fail
ret 3
end

note Case 2 (negative control): wrong module version 570.12.00 -> fails == 1
dt_put edit f edit b 14 3
res2 = doctor view f view b edit ob
if ne shr res2 32 1
r = write 2 dt_fail 0 len dt_fail
ret 4
end

note Case 3 (negative control): missing /dev/nvidia-uvm + no GPU -> fails >= 3
put f 18 1
put f 19 0
res3 = doctor view f view b edit ob
if lt shr res3 32 3
r = write 2 dt_fail 0 len dt_fail
ret 5
end

r = write 1 dt_pass 0 len dt_pass
ret 0
end

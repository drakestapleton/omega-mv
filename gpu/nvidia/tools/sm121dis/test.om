note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/sm121dis/test.om: pure-Omega positive and negative tests for sm121_dis + dis_words.
note Compose after gpu/nvidia/om/disasm/words.om and gpu/nvidia/om/disasm/sm121_dis.om.

text st_pass "PASS sm121dis pure-Omega positive and negative controls\n"
text st_fail "FAIL sm121dis\n"
text st_exit "EXIT"
text st_nop "NOP"

fn st_starts txt view uchar 256 tlen ulong want view uchar 4 wlen ulong to bool
if lt tlen wlen
ret false
end
for i ulong wlen bound 4
if ne get txt i get want i
ret false
end
end
ret true
end

fn main to int
w8 = new uchar 8 0
txt = new uchar 256 0
exp = new uchar 4 0

note 1. dis_words little-endian assembly + EXIT (0x94d = 2381) padding detection
put w8 0 uchar 77
put w8 1 uchar 9
put w8 2 uchar 0
put w8 3 uchar 0
put w8 4 uchar 0
put w8 5 uchar 0
put w8 6 uchar 0
put w8 7 uchar 0
lo_exit = dis_words view w8 0 0 0
if ne lo_exit 2381
r = write 2 st_fail 0 len st_fail
ret 1
end
pad = dis_words view w8 1 32 0
if ne pad 48
r = write 2 st_fail 0 len st_fail
ret 2
end

note 2. Decode unguarded EXIT: opcode 0x94d, guard=7 (0x794d = 31053), hi fixed bits 0x0000000003800000 = 58720256
res_exit = sm121_dis 31053 58720256 0 edit txt
if ne and res_exit 65536 0
r = write 2 st_fail 0 len st_fail
ret 3
end
if eq and res_exit 131072 0
r = write 2 st_fail 0 len st_fail
ret 4
end
put exp 0 69
put exp 1 88
put exp 2 73
put exp 3 84
if not st_starts view txt and res_exit 65535 view exp 4
r = write 2 st_fail 0 len st_fail
ret 5
end

note 3. Decode guarded @P0 EXIT: lo = 0x094d (2381), hi = 0x0000000003800000 (58720256)
res_p0 = sm121_dis 2381 58720256 16 edit txt
if ne and res_p0 65536 0
r = write 2 st_fail 0 len st_fail
ret 6
end
put exp 0 64
put exp 1 80
put exp 2 48
put exp 3 32
if not st_starts view txt and res_p0 65535 view exp 4
r = write 2 st_fail 0 len st_fail
ret 7
end

note 4. Negative control: unknown opcode 0xfff must set unknown bit 16 and emit "?? "
res_unk = sm121_dis 4095 0 32 edit txt
if eq and res_unk 65536 0
r = write 2 st_fail 0 len st_fail
ret 8
end
put exp 0 63
put exp 1 63
put exp 2 32
put exp 3 0
if not st_starts view txt and res_unk 65535 view exp 3
r = write 2 st_fail 0 len st_fail
ret 9
end

r = write 1 st_pass 0 len st_pass
ret 0
end

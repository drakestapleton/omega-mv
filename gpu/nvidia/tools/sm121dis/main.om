note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/sm121dis/main.om: pure-Omega CLI replacing CUDApp tools/sm121dis/sm121dis.c.
note Compose after gpu/nvidia/om/disasm/words.om and gpu/nvidia/om/disasm/sm121_dis.om:
note   cat gpu/nvidia/om/disasm/words.om gpu/nvidia/om/disasm/sm121_dis.om gpu/nvidia/tools/sm121dis/main.om | seed/out/omc > sm121dis
note
note Usage:
note   sm121dis <code.bin>            nvdisasm-style listing: /*0000*/ TEXT ;
note   sm121dis -b SM121 <code.bin>   same listing (nvdisasm-compatible flag form)
note   sm121dis --pairs <code.bin>    one line per word: <addr> <lo hex> <hi hex> <text> ;
note   sm121dis --version             version banner
note Exit: 0 all known, 1 unknown word(s) decoded as "?? ...", 2 usage/file/alignment error.

text sd_ver "sm121dis: Omega's own sm_121 disassembler (gpu/nvidia/om/disasm/sm121_dis.om; pure Omega CLI)\n"
text sd_use "usage: sm121dis [--pairs | -b SM121] <code.bin> | --version\n"
text sd_only "sm121dis: only -b SM121\n"
text sd_open "sm121dis: cannot open input file\n"
text sd_big "sm121dis: input exceeds 4 MiB or read error\n"
text sd_aln "sm121dis: input is not a whole number of 16-byte words\n"
text sd_tlong "sm121dis: text too long\n"
text sd_fver "--version"
text sd_fpairs "--pairs"
text sd_fb "-b"
text sd_fsm "SM121"

global sd_code uchar 4194304
global sd_arg uchar 4096
global sd_line uchar 512

fn sd_eq a view uchar 4096 n ulong t view uchar 16 to bool
if ne n len t
ret false
end
for i ulong n bound 16
if ne get a i get t i
ret false
end
end
ret true
end

fn sd_eq9 n ulong to bool
if ne n len sd_fver
ret false
end
for i ulong 9
if ne get sd_arg i get sd_fver i
ret false
end
end
ret true
end

fn sd_eq7 n ulong to bool
if ne n len sd_fpairs
ret false
end
for i ulong 7
if ne get sd_arg i get sd_fpairs i
ret false
end
end
ret true
end

fn sd_eq2 n ulong to bool
if ne n len sd_fb
ret false
end
for i ulong 2
if ne get sd_arg i get sd_fb i
ret false
end
end
ret true
end

fn sd_eq5 n ulong to bool
if ne n len sd_fsm
ret false
end
for i ulong 5
if ne get sd_arg i get sd_fsm i
ret false
end
end
ret true
end

fn sd_hexd d ulong to uchar
if lt d 10
ret uchar add 48 d
end
ret uchar add 87 d
end

fn sd_puthex pos ulong v ulong digits ulong to ulong
p = pos
for i ulong digits bound 16
sh = mul sub sub digits 1 i 4
put sd_line p sd_hexd and shr v sh 15
p = add p 1
end
ret p
end

fn sd_load pathn ulong to long
fd = fopen sd_arg 0 pathn 0 0
if lt fd 0
r = write 2 sd_open 0 len sd_open
ret -1
end
total = ulong 0
while true bound 65536
if ge total 4194304
r = fclose int fd
r = write 2 sd_big 0 len sd_big
ret -1
end
got = read int fd sd_code total sub 4194304 total
if lt got 0
r = fclose int fd
r = write 2 sd_big 0 len sd_big
ret -1
end
if eq got 0
break
end
total = add total ulong got
end
r = fclose int fd
if ne rem total 16 0
r = write 2 sd_aln 0 len sd_aln
ret -1
end
ret long total
end

fn sd_find_pad total ulong to ulong
w8 = new uchar 8 0
pad = ulong 0
at = ulong 0
while lt at total bound 262144
for i ulong 8
put w8 i get sd_code add at i
end
pad = dis_words view w8 1 at pad
at = add at 16
end
ret pad
end

fn sd_dis_one at ulong pad ulong pairs bool to long
w8 = new uchar 8 0
txt = new uchar 256 0
for i ulong 8
put w8 i get sd_code add at i
end
lo = dis_words view w8 0 0 0
for i ulong 8
put w8 i get sd_code add add at 8 i
end
hi = dis_words view w8 0 0 0
res = sm121_dis lo hi at edit txt
if ne and res 262144 0
r = write 2 sd_tlong 0 len sd_tlong
ret -1
end
unk = long 0
if ne and res 65536 0
unk = long 1
end
tlen = and res 65535
p = ulong 0
if pairs
p = sd_puthex p at 4
put sd_line p 32
p = add p 1
p = sd_puthex p lo 16
put sd_line p 32
p = add p 1
p = sd_puthex p hi 16
put sd_line p 32
p = add p 1
else
put sd_line p 32
p = add p 1
put sd_line p 32
p = add p 1
put sd_line p 47
p = add p 1
put sd_line p 42
p = add p 1
p = sd_puthex p at 4
put sd_line p 42
p = add p 1
put sd_line p 47
p = add p 1
put sd_line p 32
p = add p 1
end
for k ulong tlen bound 256
put sd_line p get txt k
p = add p 1
end
if or eq pad 0 lt at pad
put sd_line p 32
p = add p 1
end
put sd_line p 59
p = add p 1
put sd_line p 10
p = add p 1
r = write 1 sd_line 0 p
ret unk
end

fn sd_run_all total ulong pairs bool to int
pad = sd_find_pad total
unknown = ulong 0
at = ulong 0
while lt at total bound 262144
rc = sd_dis_one at pad pairs
if lt rc 0
ret 2
end
unknown = add unknown ulong rc
at = add at 16
end
if ne unknown 0
ret 1
end
ret 0
end

fn main to int
ac = argcnt
if eq ac 2
n1 = argread 1 sd_arg 0 4096
if lt n1 0
r = write 2 sd_use 0 len sd_use
ret 2
end
if sd_eq9 ulong n1
r = write 1 sd_ver 0 len sd_ver
ret 0
end
end

pairs = false
pathidx = ulong 1
if eq ac 2
pairs = false
pathidx = ulong 1
else
if eq ac 3
n1 = argread 1 sd_arg 0 4096
if lt n1 0
r = write 2 sd_use 0 len sd_use
ret 2
end
if not sd_eq7 ulong n1
r = write 2 sd_use 0 len sd_use
ret 2
end
pairs = true
pathidx = ulong 2
else
if eq ac 4
n1 = argread 1 sd_arg 0 4096
if lt n1 0
r = write 2 sd_use 0 len sd_use
ret 2
end
if not sd_eq2 ulong n1
r = write 2 sd_use 0 len sd_use
ret 2
end
n2 = argread 2 sd_arg 0 4096
if lt n2 0
r = write 2 sd_use 0 len sd_use
ret 2
end
if not sd_eq5 ulong n2
r = write 2 sd_only 0 len sd_only
ret 2
end
pairs = false
pathidx = ulong 3
else
r = write 2 sd_use 0 len sd_use
ret 2
end
end
end

pn = argread pathidx sd_arg 0 4096
if le pn 0
r = write 2 sd_use 0 len sd_use
ret 2
end
total_s = sd_load ulong pn
if lt total_s 0
ret 2
end
ret sd_run_all ulong total_s pairs
end

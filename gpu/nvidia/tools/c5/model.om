note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Deterministic RM/channel simulator, not a hardware executor or SASS simulator.
note Two modeled process identities and two private eight-word mappings at the same VA.
global states uint 2
global epochs ulong 2
global starts ulong 2
global limits ulong 2
global kinds uint 2
global cursors ulong 2
global chans uint 2
global ctxs uint 2
global maps uint 2
global memory ulong 16
fn model_init to void
for p ulong 2
put states p READY
put epochs p 1
put chans p 1
put ctxs p 1
put maps p 1
put cursors p 0
end
for i ulong 16
put memory i 0
end
end
note Buffer handle is (owner process, context generation); address/offset alone is not a handle.
fn model_store p ulong owner ulong token ulong off ulong value ulong to bool
if ge p 2
ret false
end
if not omega_c5_access add p 1 owner get epochs p token
ret false
end
if not omega_c5_range 8 off 1
ret false
end
if ne get maps p 1
ret false
end
put memory add mul p 8 off value
ret true
end
fn model_load p ulong owner ulong token ulong off ulong to ulong
if ge p 2
ret UMAX
end
if not omega_c5_access add p 1 owner get epochs p token
ret UMAX
end
if not omega_c5_range 8 off 1
ret UMAX
end
if ne get maps p 1
ret UMAX
end
ret get memory add mul p 8 off
end
fn model_submit p ulong token ulong now ulong budget ulong kind uint to bool
if ge p 2
ret false
end
if not omega_c5_admit get states p get epochs p token
ret false
end
if or ne get chans p 1 or ne get ctxs p 1 ne get maps p 1
ret false
end
limit = omega_c5_deadline now budget
if eq limit 0
ret false
end
put states p BUSY
put starts p now
put limits p limit
put kinds p kind
put cursors p 0
ret true
end
note kind zero simulates a kernel with a back edge and no completion release.
note Work emits eight stores then two completion markers. Both share the original deadline.
fn model_tick p ulong token ulong now ulong fault bool to uint
if ne get states p BUSY
ret get states p
end
if ne token get epochs p
ret BUSY
end
next = omega_c5_watch now get starts p get limits p false fault
if eq next LATCH
put states p LATCH
ret LATCH
end
if ne get kinds p 0
pos = get cursors p
if lt pos 8
ok = model_store p add p 1 token pos add mul add p 1 100 pos
if not ok
put states p LATCH
ret LATCH
end
end
put cursors p add pos 1
next = omega_c5_watch now get starts p get limits p ge get cursors p 10 false
put states p next
end
ret next
end
note Acknowledgements stand for successful RM actions, not attempted calls.
note No grid/mapping release until channel destruction; no epoch change before context destruction.
fn model_recover p ulong ack bool to uint
state = get states p
next = omega_c5_recover state ack
if eq state next
ret state
end
if eq state CHANNEL
put chans p 0
end
if eq state CONTEXT
put ctxs p 0
put maps p 0
put epochs p omega_c5_epoch get epochs p
for i ulong 8
put memory add mul p 8 i 0
end
end
if eq state CLOSED
if eq get epochs p 0
ret state
end
put ctxs p 1
end
if eq state NEWCTX
put chans p 1
end
if eq state NEWCHAN
put maps p 1
end
put states p next
ret next
end

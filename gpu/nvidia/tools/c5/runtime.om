note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Bridge root for the production session. Scalar-only, no allocation or host dependencies.
note op 0 absolute ns deadline from start and timeout milliseconds; zero refuses overflow.
note op 1 watch; op 2 one-ms poll if it fits (session poll cap is one ms).
note op 3 recovery admission; op 4 bundled RM-close acknowledgement through teardown states.
fn native_c5 op ulong a ulong b ulong c ulong d ulong e ulong to ulong
if eq op 0
if gt b 18446744073709
ret 0
end
ret omega_c5_deadline a mul b 1000000
end
if eq op 1
ret ulong omega_c5_watch a b c ne d 0 ne e 0
end
if eq op 2
if ge a b
ret 0
end
if and ne c 0 ge sub b a 1000000
ret 1
end
ret 0
end
if eq op 3
if and ne a 0 and ne b 0 ne c 0
ret 1
end
ret 0
end
if eq op 4
state = omega_c5_recover LATCH ne a 0
state = omega_c5_recover state ne a 0
state = omega_c5_recover state ne a 0
ret ulong omega_c5_recover state ne a 0
end
ret 0
end

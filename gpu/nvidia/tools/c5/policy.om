note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Pure decisions. No host words, RM calls, mapping writes or global storage.
note States: READY BUSY LATCH QUIESCE CHANNEL CONTEXT CLOSED NEWCTX NEWCHAN.
const READY uint 1
const BUSY uint 2
const LATCH uint 3
const QUIESCE uint 4
const CHANNEL uint 5
const CONTEXT uint 6
const CLOSED uint 7
const NEWCTX uint 8
const NEWCHAN uint 9
const UMAX ulong 18446744073709551615
note Absolute monotonic deadline: reject zero budget and addition overflow before submit.
fn omega_c5_deadline start ulong budget ulong to ulong
if eq budget 0
ret 0
end
if gt start sub UMAX budget
ret 0
end
ret add start budget
end
note One deadline for the entire submission, not renewed by progress/marker polling.
note Result BUSY pending, READY both completion releases, LATCH uncertain completion.
fn omega_c5_watch now ulong start ulong limit ulong done bool fault bool to uint
if or fault lt now start
ret LATCH
end
if or eq limit 0 ge now limit
ret LATCH
end
if done
ret READY
end
ret BUSY
end
note Caller must present a current process/context token and a completely ready state.
fn omega_c5_admit state uint epoch ulong token ulong to bool
ret and eq state READY and ne epoch 0 eq epoch token
end
note Per-process handle ownership, context generation and overflow-safe half-open slice.
fn omega_c5_access pid ulong owner ulong epoch ulong token ulong to bool
if or eq pid 0 ne pid owner
ret false
end
ret and ne epoch 0 eq epoch token
end
fn omega_c5_range capacity ulong off ulong size ulong to bool
if gt off capacity
ret false
end
ret le size sub capacity off
end
fn omega_c5_recover state uint ack bool to uint
if not ack
ret state
end
if eq state LATCH
ret QUIESCE
end
if eq state QUIESCE
ret CHANNEL
end
if eq state CHANNEL
ret CONTEXT
end
if eq state CONTEXT
ret CLOSED
end
if eq state CLOSED
ret NEWCTX
end
if eq state NEWCTX
ret NEWCHAN
end
if eq state NEWCHAN
ret READY
end
ret state
end
note Generation changes only after confirmed context destruction; never wrap to reuse handles.
fn omega_c5_epoch epoch ulong to ulong
if or eq epoch 0 eq epoch UMAX
ret 0
end
ret add epoch 1
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/c5/test.om: pure-Omega positive and negative control tests for CUDApp c5 policy & runtime.
note Compose after gpu/nvidia/tools/c5/policy.om and gpu/nvidia/tools/c5/runtime.om.

text c5_pass "PASS c5 policy & runtime all tests passed\n"
text c5_fail "FAIL c5 policy & runtime\n"

fn c5_test_deadline to bool
note Valid deadline: 1000 + 500 = 1500
if ne omega_c5_deadline ulong 1000 ulong 500 ulong 1500
ret false
end
note Zero budget refused
if ne omega_c5_deadline ulong 1000 ulong 0 ulong 0
ret false
end
note Overflow refused
if ne omega_c5_deadline UMAX ulong 1 ulong 0
ret false
end
if ne omega_c5_deadline sub UMAX ulong 10 ulong 11 ulong 0
ret false
end
note Exact UMAX boundary accepted
if ne omega_c5_deadline sub UMAX ulong 10 ulong 10 UMAX
ret false
end
ret true
end

fn c5_test_watch to bool
note Pending before deadline
if ne omega_c5_watch ulong 1200 ulong 1000 ulong 2000 false false BUSY
ret false
end
note Completed before deadline
if ne omega_c5_watch ulong 1200 ulong 1000 ulong 2000 true false READY
ret false
end
note Deadline reached -> LATCH even if done=true
if ne omega_c5_watch ulong 2000 ulong 1000 ulong 2000 true false LATCH
ret false
end
note Clock regression (now < start) -> LATCH
if ne omega_c5_watch ulong 999 ulong 1000 ulong 2000 true false LATCH
ret false
end
note Fault flag -> LATCH
if ne omega_c5_watch ulong 1200 ulong 1000 ulong 2000 true true LATCH
ret false
end
note Zero limit -> LATCH
if ne omega_c5_watch ulong 1200 ulong 1000 ulong 0 true false LATCH
ret false
end
ret true
end

fn c5_test_admit_access_range to bool
if not omega_c5_admit READY ulong 7 ulong 7
ret false
end
if omega_c5_admit BUSY ulong 7 ulong 7
ret false
end
if omega_c5_admit READY ulong 0 ulong 0
ret false
end
if omega_c5_admit READY ulong 7 ulong 8
ret false
end
if not omega_c5_access ulong 42 ulong 42 ulong 3 ulong 3
ret false
end
if omega_c5_access ulong 0 ulong 0 ulong 3 ulong 3
ret false
end
if omega_c5_access ulong 42 ulong 43 ulong 3 ulong 3
ret false
end
if omega_c5_access ulong 42 ulong 42 ulong 3 ulong 4
ret false
end
if not omega_c5_range ulong 100 ulong 40 ulong 60
ret false
end
if omega_c5_range ulong 100 ulong 40 ulong 61
ret false
end
if omega_c5_range ulong 100 ulong 101 ulong 0
ret false
end
ret true
end

fn c5_test_recover_epoch to bool
note Unacknowledged recovery stays in same state
if ne omega_c5_recover LATCH false LATCH
ret false
end
s = omega_c5_recover LATCH true
if ne s QUIESCE
ret false
end
s = omega_c5_recover s true
if ne s CHANNEL
ret false
end
s = omega_c5_recover s true
if ne s CONTEXT
ret false
end
s = omega_c5_recover s true
if ne s CLOSED
ret false
end
s = omega_c5_recover s true
if ne s NEWCTX
ret false
end
s = omega_c5_recover s true
if ne s NEWCHAN
ret false
end
s = omega_c5_recover s true
if ne s READY
ret false
end
note Epoch increment and overflow/zero refusal
if ne omega_c5_epoch ulong 1 ulong 2
ret false
end
if ne omega_c5_epoch ulong 0 ulong 0
ret false
end
if ne omega_c5_epoch UMAX ulong 0
ret false
end
ret true
end

fn c5_test_native_c5 to bool
note op 0: 1000 ns + 5 ms = 5001000 ns
if ne native_c5 ulong 0 ulong 1000 ulong 5 ulong 0 ulong 0 ulong 0 ulong 5001000
ret false
end
note op 0 overflow ms refused
if ne native_c5 ulong 0 ulong 1000 ulong 18446744073710 ulong 0 ulong 0 ulong 0 ulong 0
ret false
end
note op 1: watch READY
if ne native_c5 ulong 1 ulong 1200 ulong 1000 ulong 2000 ulong 1 ulong 0 ulong READY
ret false
end
note op 2: 1ms poll fits
if ne native_c5 ulong 2 ulong 1000 ulong 2000000 ulong 1 ulong 0 ulong 0 ulong 1
ret false
end
note op 2: less than 1ms left -> 0
if ne native_c5 ulong 2 ulong 1500000 ulong 2000000 ulong 1 ulong 0 ulong 0 ulong 0
ret false
end
note op 3: recovery admission
if ne native_c5 ulong 3 ulong 1 ulong 1 ulong 1 ulong 0 ulong 0 ulong 1
ret false
end
if ne native_c5 ulong 3 ulong 1 ulong 0 ulong 1 ulong 0 ulong 0 ulong 0
ret false
end
note op 4: 4 teardown steps from LATCH -> CLOSED
if ne native_c5 ulong 4 ulong 1 ulong 0 ulong 0 ulong 0 ulong 0 ulong CLOSED
ret false
end
if ne native_c5 ulong 4 ulong 0 ulong 0 ulong 0 ulong 0 ulong 0 ulong LATCH
ret false
end
ret true
end

fn main to int
ok = true
if not c5_test_deadline
ok = false
end
if not c5_test_watch
ok = false
end
if not c5_test_admit_access_range
ok = false
end
if not c5_test_recover_epoch
ok = false
end
if not c5_test_native_c5
ok = false
end
if not ok
k = write int 1 c5_fail ulong 0 len c5_fail
if lt k long 0
ret int 1
end
ret int 1
end
k = write int 1 c5_pass ulong 0 len c5_pass
if lt k long 0
ret int 1
end
ret int 0
end

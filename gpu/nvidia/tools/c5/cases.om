note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
text hostok "C5 host reference: PASS\n"
text simok "C5 RM/channel sim: PASS (hang, recovery, isolation, failures)\n"
fn host_cases to int
if ne omega_c5_deadline 10 8 18
ret 1
end
if ne omega_c5_deadline 10 0 0
ret 2
end
if ne omega_c5_deadline 18446744073709551607 8 UMAX
ret 3
end
if ne omega_c5_deadline UMAX 2 0
ret 4
end
if ne omega_c5_watch 17 10 18 false false BUSY
ret 5
end
if ne omega_c5_watch 18 10 18 true false LATCH
ret 6
end
if ne omega_c5_watch 17 10 18 true false READY
ret 7
end
if ne omega_c5_watch 9 10 18 true false LATCH
ret 8
end
if ne omega_c5_watch 11 10 18 true true LATCH
ret 9
end
if omega_c5_admit BUSY 1 1
ret 10
end
if omega_c5_admit READY 2 1
ret 11
end
if omega_c5_access 1 2 1 1
ret 12
end
if omega_c5_access 1 1 2 1
ret 13
end
if omega_c5_access 0 0 1 1
ret 14
end
if not omega_c5_range 8 8 0
ret 15
end
if omega_c5_range 8 8 1
ret 16
end
if omega_c5_range 8 UMAX 2
ret 17
end
if ne omega_c5_epoch UMAX 0
ret 18
end
for s uint 7
state = add s 3
if ne omega_c5_recover state false state
ret 19
end
want = add state 1
if eq state NEWCHAN
want = READY
end
if ne omega_c5_recover state true want
ret 20
end
end
ret 0
end
fn sim_cases to int
model_init
if not model_submit 0 1 10 8 0
ret 21
end
if not model_submit 1 1 10 20 1
ret 22
end
note Interleave hung process zero with productive process one until both deadlines diverge.
for t ulong 8
r = model_tick 0 1 add 10 t false
if ne r BUSY
ret 23
end
r = model_tick 1 1 add 10 t false
if ne r BUSY
ret 24
end
end
if ne model_tick 0 1 18 false LATCH
ret 25
end
if model_submit 0 1 19 8 1
ret 26
end
if ne model_tick 1 1 18 false BUSY
ret 27
end
if ne model_tick 1 1 19 false READY
ret 28
end
for i ulong 8
if ne model_load 1 2 1 i add 200 i
ret 29
end
if ne model_load 0 1 1 i 0
ret 30
end
if model_store 0 2 1 i 999
ret 31
end
if ne model_load 0 2 1 i UMAX
ret 32
end
end
ret 0
end
fn recovery_cases to int
note Failed acknowledgements at every recovery stage preserve all RM resources and generation.
for n ulong 7
old = get states 0
ep = get epochs 0
ch = get chans 0
cx = get ctxs 0
mp = get maps 0
if ne model_recover 0 false old
ret 33
end
if ne get epochs 0 ep
ret 34
end
if ne get chans 0 ch
ret 34
end
if ne get ctxs 0 cx
ret 34
end
if ne get maps 0 mp
ret 34
end
if model_submit 0 ep 20 20 1
ret 35
end
r = model_recover 0 true
if eq n 2
if or ne get chans 0 0 ne get ctxs 0 1
ret 36
end
end
if eq n 3
if ne get ctxs 0 0
ret 37
end
if ne get maps 0 0
ret 37
end
if ne get epochs 0 2
ret 37
end
end
end
if or ne get states 0 READY ne get epochs 0 2
ret 38
end
if model_submit 0 1 30 20 1
ret 39
end
if model_store 0 1 1 0 999
ret 40
end
if not model_submit 0 2 30 20 1
ret 41
end
note A stale completion from the old channel cannot finish the new job.
if ne model_tick 0 1 30 false BUSY
ret 42
end
if ne get cursors 0 0
ret 43
end
for t ulong 10
r = model_tick 0 2 add 30 t false
end
if ne get states 0 READY
ret 44
end
for i ulong 8
if ne model_load 0 1 2 i add 100 i
ret 45
end
if ne model_load 1 2 1 i add 200 i
ret 46
end
end
note Deadline refresh per submission, not inherited from the prior work.
if not model_submit 0 2 100 20 1
ret 47
end
if ne model_tick 0 2 100 true LATCH
ret 48
end
note Two-stage completion cannot double the watchdog budget.
model_init
if not model_submit 0 1 10 9 1
ret 49
end
for t ulong 9
r = model_tick 0 1 add 10 t false
end
if ne model_tick 0 1 19 false LATCH
ret 50
end
ret 0
end
fn main to int
r = host_cases
if ne r 0
ret r
end
n = write 1 hostok 0 len hostok
if ne n long len hostok
ret 90
end
r = sim_cases
if ne r 0
ret r
end
r = recovery_cases
if ne r 0
ret r
end
n = write 1 simok 0 len simok
if ne n long len simok
ret 91
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note omega profiler: per-launch stamp words and a roofline report.
note Stamp word (src/omega_gpu_cmdlist.c emit_stamp, ordered after the preceding WAIT_FOR_IDLE): header bw_mthd(1, 0x0158, 5) then slot, 0, address low, address high, 0. A submission of n launches records n + 1 slots: slot 0 before launch 0, slot i + 1 after launch i. Kernel i duration is slot[i + 1] minus slot[i]. words mode prints those six words for one slot. It does not edit the command-list generator; Streams owns that file.
note Ceilings (not computed from this fixture): probe pair 115.14 TFLOP/s and 195.1 GB/s from the ROADMAP Nsight row, evidence OWN30B-T3-TC-PEAK-BW-5faa0f70-20261013T2236Z. Omega docs/OMEGA.md section 5 records that pair as the measured ceiling and separately lists 207 to 237 GB/s and 237.5 TFLOP/s FP8. The 590 operations/byte ridge is 115140000000000 / 195100000000, confirmed by Wolfram in tools/prof/wolfram-constants.txt. Section 5 is the ceiling source this report cites. The 115.14/195.1 pair is probe evidence, not a section 5 number.
note Modes: words va slot prints the six stamp words; fix path writes the built-in fixture; sim path replays that fixture and writes the report; report path out reads a fixture and writes the report. Exit 0 ok, 2 usage, 3 swapped or equal timestamps, 4 bad fixture, 5 write failure.
om2
const hdr ulong 537206870
const flop_at ulong 16
const probe_f ulong 115140000000000
const probe_b ulong 195100000000
const sec5_f ulong 237500000000000
const sec5_lo ulong 207000000000
const sec5_hi ulong 237000000000
const ridge_n ulong 1151400
const ridge_d ulong 1951
const ridge_m ulong 590158
const sec5_n ulong 237500
const d237 ulong 237
const d207 ulong 207
const lnch_lo ulong 24
const lnch_hi ulong 31
const byte_cap ulong 15000000000000
const flop_cap ulong 9000000000000000
const time_cap ulong 18000000000
const rate_cap ulong 18446744073
const dec_cap ulong 1844674407370955161
const u32m ulong 4294967295
const u32b ulong 4294967296
text prof1 "PROFI 1\n"
text src "source omega-mv docs/OMEGA.md section 5; probe evidence/OWN30B-T3-TC-PEAK-BW-5faa0f70-20261013T2236Z\n"
text pfs "probe_flops "
text pbs "probe_bytes "
text psrc "probe_source evidence/OWN30B-T3-TC-PEAK-BW-5faa0f70-20261013T2236Z\n"
text sfs "sec5_flops "
text sfk "sec5_flops_kind arithmetic\n"
text sblo "sec5_bytes_lo "
text sbhi "sec5_bytes_hi "
text sbk "sec5_bytes_kind measured\n"
text rpn "ridge_probe_n "
text rpd "ridge_probe_d "
text rpm "ridge_probe_milli "
text r237n "ridge_sec5_237_n "
text r237d "ridge_sec5_237_d "
text r207n "ridge_sec5_207_n "
text r207d "ridge_sec5_207_d "
text llo "launch_us_lo "
text lhi "launch_us_hi "
text lsrc "launch_source evidence/OWN30B-LAUNCH-COST-20261014T0120Z\n"
text ssrc "stamp_source fixture\n"
text nkt "nkern "
text kk "k "
text tn " time_ns "
text byt " bytes "
text flp " flops "
text ail " ai_milli "
text bpl " bound_probe "
text bd237 " bound_sec5_237 "
text bd207 " bound_sec5_207 "
text pmm " probe_mem_milli "
text pfm " probe_flop_milli "
text sm237 " sec5_mem_237_milli "
text sm207 " sec5_mem_207_milli "
text sfm " sec5_flop_milli "
text mem "mem"
text ridge "ridge"
text comp "compute"
text nl "\n"
global buf uchar 1024
global nread ulong 1
global nkern ulong 1
global nslots ulong 1
global slots ulong 8
global g_bytes ulong 8
global g_flops ulong 8
global g_sb ulong 8
global g_sa ulong 8
global kid ulong 1
global kt0 ulong 1
global kt1 ulong 1
global kbytes ulong 1
global kflops ulong 1
global argb uchar 64
global pathb uchar 256
global nb uchar 1
fn putb fd int b ulong to void
put nb 0 uchar and b 255
k = write fd nb 0 1
if lt k 1
exit 5
end
end
fn putnum fd int n ulong to void
x = n
d = ulong 10000000000000000000
started = ulong 0
for i ulong 20
q = div x d
if or gt q 0 eq started 1
putb fd add 48 q
started = 1
end
x = rem x d
d = div d 10
end
if eq started 0
putb fd 48
end
end
fn wtxt fd int s view uchar * to void
k = write fd s 0 len s
if lt k 0
exit 5
end
if ne ulong k len s
exit 5
end
end
fn b32 off ulong to ulong
a0 = ulong get buf off
a1 = ulong get buf add off 1
a2 = ulong get buf add off 2
a3 = ulong get buf add off 3
ret add a0 add mul a1 256 add mul a2 65536 mul a3 16777216
end
fn b64 off ulong to ulong
lo = b32 off
hi = b32 add off 4
ret add lo mul hi u32b
end
fn p8 off ulong v ulong to void
put buf off uchar v
end
fn p32 off ulong v ulong to void
p8 off and v 255
p8 add off 1 and shr v 8 255
p8 add off 2 and shr v 16 255
p8 add off 3 and shr v 24 255
end
fn p64 off ulong v ulong to void
p32 off and v u32m
p32 add off 4 shr v 32
end
fn tsat slots_n ulong idx ulong to ulong
if ge idx slots_n
exit 4
end
base = get slots idx
ret b64 base
end
fn rate a ulong t ulong to ulong
if eq t 0
exit 4
end
hi = div a 1000
lo = rem a 1000
q = div hi t
r = rem hi t
if gt r rate_cap
exit 4
end
s = mul r 1000
if gt lo dec_cap
exit 4
end
s = add s lo
q2 = div s t
if gt q 18446744073709
exit 4
end
outv = mul q 1000
if gt outv sub 0 add q2 1
exit 4
end
ret add outv q2
end
fn aimilli f ulong b ulong to ulong
if eq b 0
exit 4
end
if gt f flop_cap
exit 4
end
if gt b byte_cap
exit 4
end
ret div mul f 1000 b
end
fn milli v ulong c ulong to ulong
if eq v 0
ret 0
end
if gt v c
exit 4
end
ret div mul v 1000 c
end
fn cmpf f ulong b ulong n ulong d ulong to ulong
if eq b 0
exit 4
end
if gt f flop_cap
exit 4
end
if gt b byte_cap
exit 4
end
left = mul f d
right = mul b n
if lt left right
ret 0
end
if eq left right
ret 1
end
ret 2
end
fn kload i ulong to ulong
off = add 16 mul i 32
put kid 0 b32 off
put kbytes 0 b64 add off 8
t0 = tsat get nslots 0 b32 add off 24
t1 = tsat get nslots 0 b32 add off 28
put kt0 0 t0
put kt1 0 t1
put kflops 0 b64 add off flop_at
if gt get kbytes 0 byte_cap
exit 4
end
if gt get kflops 0 flop_cap
exit 4
end
bad = lt t1 t0
if bad
ret 3
end
if eq t1 t0
ret 3
end
dt = sub t1 t0
if gt dt time_cap
exit 4
end
ret 0
end
fn wbound fd int code ulong to void
if eq code 0
wtxt fd mem
else
if eq code 1
wtxt fd ridge
else
wtxt fd comp
end
end
end
fn kemitb fd int to void
b = get kbytes 0
f = get kflops 0
t = sub get kt1 0 get kt0 0
ai = aimilli f b
bp = cmpf f b ridge_n ridge_d
hi = cmpf f b sec5_n d237
lo = cmpf f b sec5_n d207
wtxt fd kk
putnum fd get kid 0
wtxt fd tn
putnum fd t
wtxt fd byt
putnum fd b
wtxt fd flp
putnum fd f
wtxt fd ail
putnum fd ai
wtxt fd bpl
wbound fd bp
wtxt fd bd237
wbound fd hi
wtxt fd bd207
wbound fd lo
wtxt fd pmm
putnum fd milli b probe_b
wtxt fd pfm
putnum fd milli f probe_f
wtxt fd sm237
putnum fd milli b sec5_hi
wtxt fd sm207
putnum fd milli b sec5_lo
wtxt fd sfm
putnum fd milli f sec5_f
wtxt fd nl
end
fn kemit fd int to void
kemitb fd
end
fn emithead fd int to void
wtxt fd prof1
wtxt fd src
wtxt fd pfs
putnum fd probe_f
wtxt fd nl
wtxt fd pbs
putnum fd probe_b
wtxt fd nl
wtxt fd psrc
wtxt fd sfs
putnum fd sec5_f
wtxt fd nl
wtxt fd sfk
wtxt fd sblo
putnum fd sec5_lo
wtxt fd nl
wtxt fd sbhi
putnum fd sec5_hi
wtxt fd nl
wtxt fd sbk
wtxt fd rpn
putnum fd ridge_n
wtxt fd nl
wtxt fd rpd
putnum fd ridge_d
wtxt fd nl
wtxt fd rpm
putnum fd ridge_m
wtxt fd nl
wtxt fd r237n
putnum fd sec5_n
wtxt fd nl
wtxt fd r237d
putnum fd d237
wtxt fd nl
wtxt fd r207n
putnum fd sec5_n
wtxt fd nl
wtxt fd r207d
putnum fd d207
wtxt fd nl
wtxt fd llo
putnum fd lnch_lo
wtxt fd nl
wtxt fd lhi
putnum fd lnch_hi
wtxt fd nl
wtxt fd lsrc
wtxt fd ssrc
wtxt fd nkt
putnum fd get nkern 0
wtxt fd nl
end
fn emitall fd int to ulong
n = get nkern 0
for i ulong n
c = kload i
if ne c 0
ret c
end
kemit fd
end
ret 0
end
fn checkfix to ulong
if lt get nread 0 16
ret 4
end
if ne ulong get buf 0 80
ret 4
end
if ne ulong get buf 1 82
ret 4
end
if ne ulong get buf 2 79
ret 4
end
if ne ulong get buf 3 70
ret 4
end
if ne b32 4 1
ret 4
end
kn = b32 8
ns = b32 12
if eq kn 0
ret 4
end
if gt kn 8
ret 4
end
if lt ns 2
ret 4
end
if gt ns 8
ret 4
end
need = add 112 mul ns 16
if gt need 1024
ret 4
end
if lt get nread 0 need
ret 4
end
put nkern 0 kn
put nslots 0 ns
for i ulong 8
put slots i add 112 mul i 16
end
ret 0
end
fn pdesc i ulong to void
off = add 16 mul i 32
p32 off i
p32 add off 4 0
p64 add off 8 get g_bytes i
p64 add off 16 get g_flops i
p32 add off 24 get g_sb i
p32 add off 28 get g_sa i
end
fn pslot idx ulong ts ulong to void
base = get slots idx
p64 base ts
end
fn fillsim to void
p8 0 80
p8 1 82
p8 2 79
p8 3 70
p32 4 1
p32 8 3
p32 12 4
put g_bytes 0 195100000000
put g_flops 0 115140000000
put g_sb 0 0
put g_sa 0 1
put g_bytes 1 195100000
put g_flops 1 115140000000000
put g_sb 1 1
put g_sa 1 2
put g_bytes 2 97550000000
put g_flops 2 57570000000000
put g_sb 2 2
put g_sa 2 3
pdesc 0
pdesc 1
pdesc 2
put nkern 0 3
put nslots 0 4
for i ulong 8
put slots i add 112 mul i 16
end
pslot 0 1000000000000
pslot 1 1001000000000
pslot 2 1002000000000
pslot 3 1003000000000
put nread 0 176
end
fn loadpath idx ulong to long
n = argread idx pathb 0 255
if le n 0
ret sub long 0 long 1
end
if ge n 255
ret sub long 0 long 1
end
put pathb n 0
fd = fopen pathb 0 ulong n 0 0
if lt fd 0
ret fd
end
k = read int fd buf 0 1024
z = fclose int fd
if lt z 0
ret sub long 0 long 1
end
ret k
end
fn openout idx ulong to int
n = argread idx pathb 0 255
if le n 0
exit 5
end
if ge n 255
exit 5
end
put pathb n 0
fd = fopen pathb 0 ulong n 577 420
if lt fd 0
exit 5
end
ret int fd
end
fn runrep out_idx ulong to int
c = checkfix
if ne c 0
ret int c
end
fd = openout out_idx
emithead fd
k = emitall fd
z = fclose fd
if ne k 0
ret int k
end
if lt z 0
ret 5
end
ret 0
end
fn argis idx ulong kind ulong to bool
n = argread idx argb 0 63
if le n 0
ret false
end
if eq kind 0
if ne n 5
ret false
end
if ne ulong get argb 0 119
ret false
end
if ne ulong get argb 1 111
ret false
end
if ne ulong get argb 2 114
ret false
end
if ne ulong get argb 3 100
ret false
end
if ne ulong get argb 4 115
ret false
end
ret true
end
if eq kind 1
if ne n 6
ret false
end
if ne ulong get argb 0 114
ret false
end
if ne ulong get argb 1 101
ret false
end
if ne ulong get argb 2 112
ret false
end
if ne ulong get argb 3 111
ret false
end
if ne ulong get argb 4 114
ret false
end
if ne ulong get argb 5 116
ret false
end
ret true
end
if eq kind 2
if ne n 3
ret false
end
if ne ulong get argb 0 115
ret false
end
if ne ulong get argb 1 105
ret false
end
if ne ulong get argb 2 109
ret false
end
ret true
end
if eq kind 3
if ne n 3
ret false
end
if ne ulong get argb 0 102
ret false
end
if ne ulong get argb 1 105
ret false
end
if ne ulong get argb 2 120
ret false
end
ret true
end
ret false
end
fn argnum idx ulong to ulong
n = argread idx argb 0 63
if le n 0
exit 2
end
if gt n 20
exit 2
end
v = ulong 0
for i ulong ulong n
c = ulong get argb i
if or lt c 48 gt c 57
exit 2
end
v = add mul v 10 sub c 48
end
ret v
end
fn words va ulong slot ulong to void
putnum 1 hdr
putb 1 10
putnum 1 slot
putb 1 10
putnum 1 0
putb 1 10
addr = add va mul slot 16
putnum 1 and addr u32m
putb 1 10
putnum 1 shr addr 32
putb 1 10
putnum 1 0
putb 1 10
end
fn dofix to int
if ne argcnt 3
ret 2
end
fillsim
fd = openout 2
k = write fd buf 0 176
z = fclose fd
if lt k 176
ret 5
end
if lt z 0
ret 5
end
ret 0
end
fn main to int
if lt argcnt 2
ret 2
end
if argis 1 0
if ne argcnt 4
ret 2
end
words argnum 2 argnum 3
ret 0
end
if argis 1 3
ret dofix
end
if argis 1 2
if ne argcnt 3
ret 2
end
fillsim
ret runrep 2
end
if argis 1 1
if ne argcnt 4
ret 2
end
r = loadpath 2
if lt r 0
ret 4
end
put nread 0 ulong r
ret runrep 3
end
ret 2
end

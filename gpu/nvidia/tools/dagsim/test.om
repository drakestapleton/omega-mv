note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/tools/dagsim/test.om: pure-Omega positive and negative tests for dag_eval + dag_fmt + dag_jstr.
note Compose after gpu/nvidia/om/tools/dag_eval.om, dag_fmt.om, dag_jstr.om.

text dt_pass "PASS dagsim pure-Omega schedule, cycle refusal, and JSON escape controls\n"
text dt_fail "FAIL dagsim\n"

fn dt_cases_eval to int
em = new ulong 8192 0
sc = new ulong 8192 0
put em 0 2
put em 1 1
put em 2 1
put em 3 0
put em 8 1
put em 9 1
put em 2592 1
put em 2593 1
put em 2594 0
put em 2595 3
t0 = f64 100.0
put em 32 bitcast ulong t0
put em 36 0
put em 37 NONE
put em 38 NONE
put em 39 1
put em 40 3
t1 = f64 250.0
put em 42 bitcast ulong t1
put em 46 0
put em 47 NONE
put em 48 NONE
put em 49 1
put em 50 3
put em 2720 0
put em 2721 1
st1 = dag_eval view em edit sc
if ne st1 0
ret 1
end
mk = bitcast f64 get sc 3
if lt mk 349.9
ret 2
end
if gt mk 350.1
ret 2
end
for i ulong 8192
put sc i 0
end
put em 2 2
put em 2722 1
put em 2723 0
st2 = dag_eval view em edit sc
if ne st2 5
ret 3
end
ret 0
end

fn dt_cases_fmt to int
esc = new uchar 6 0
fa = new ulong 16 0
sn = new uchar 256 0
k1 = dag_jstr uchar 34 edit esc
if ne k1 2
ret 4
end
if ne get esc 0 92
ret 4
end
if ne get esc 1 34
ret 4
end
k2 = dag_jstr uchar 10 edit esc
if ne k2 6
ret 5
end
put fa 0 0
n0 = dag_fmt 0 edit fa edit sn
if ne n0 2
ret 6
end
if ne get sn 0 79
ret 6
end
if ne get sn 1 75
ret 6
end
ret 0
end

fn main to int
rc1 = dt_cases_eval
if ne rc1 0
r = write 2 dt_fail 0 len dt_fail
ret rc1
end
rc2 = dt_cases_fmt
if ne rc2 0
r = write 2 dt_fail 0 len dt_fail
ret rc2
end
r = write 1 dt_pass 0 len dt_pass
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/driver/seqgate.om: the sequence gate of the driver slice. It reads the cases the C oracle printed
note (gpu/nvidia/driver/seq-cases.tsv: the C bodies of CUDApp 84b524ca nvrm_open, alloc_with_cacheability,
note nvrm_free, chan_extra, nvrm_channel_n, nvrm_channel_destroy, nvrm_enqueue, nvrm_chan_submit, nvrm_close,
note m16_native_free_memory and the rest, run outside this tree with every device effect recorded) and runs the
note same program on client.om with fx.om's recorder and the same failure script. The command sequence, the
note answers, the messages and the final client state must be the same bytes. Exit 0 is PASS.
note
note Line: seq PROGRAM K F R TRACE, tab separated. PROGRAM is decimal tokens, the calls made on one client:
note 1 ADMITSM SELSM DISC NCLS nvrm_open / 2 SLOT SIZE MODE alloc (0 nvrm_alloc, 1 gpu_uncached, 2 vram) /
note 3 SLOT nvrm_free / 4 EXTRA nvrm_channel_n / 5 nvrm_channel_destroy / 6 SLOT OFF NW nvrm_enqueue /
note 7 CH SLOT OFF NW nvrm_chan_submit / 8 nvrm_close / 9 SIZE m16_native_alloc_memory / 10 SEL
note m16_native_free_memory (SEL < 64: legacy row SEL's cpu; else the address SEL) / 11 SLOT FIELD VALUE set a
note caller descriptor field (0 handle, 1 va, 2 size, 3 cpu) / 12 DST SRC copy a caller descriptor /
note 13 CH PUT RETIRED set a channel's counters (0 the main one) / 14 MS channel_no_memory_retry_ms /
note 15 ADMITSM SELSM DISC NCLS m16_native_open / 16 m16_native_create_channel / 17 m16_native_close /
note 18 SLOT OFF NW nvrm_submit / 19 m16_native_ring_doorbell (nvrm_ring).
note SLOT is a caller descriptor, 0 to 15. K F R: the failure script (fx.om). TRACE: events "NAME ARGS =R;" in
note order (fx.om), "OP CODE =RC;" after each call, then the state: "ST ...;" client fields, "LV ...;" each
note live row, "CH ...;" each extra channel, "MM ...;" each non-empty caller descriptor, "LG ...;" each
note non-empty m16 legacy row, "PB ...;" m16's pushbuffer when not empty.
note
note Controls, two for the first case of each program: the comparison against the expected trace with one
note byte changed, and the program rerun with another failure script (K 1), each of which must differ.
note A line is read into a 65536-byte array (fixed when compiled); a longer line is refused by name, never cut.

text sq_use "usage: seqgate SEQ-CASES.tsv\n"
text sq_topen "seqgate: cannot open, size or map the cases file\n"
text sq_long "seqgate: a line of the cases file is longer than 65536 bytes; refused\n"
text sq_fl "FAIL line "
text sq_at " at byte "
text sq_tbad "FAIL malformed line "
text sq_ctl "FAIL control not caught, line "
text sq_want "\n  want: "
text sq_got "\n  got:  "
text sq_ovf "FAIL trace longer than 65536 bytes or a script the recorder cannot follow, line "
text sq_sum "OMEGA-GPU-DRIVER-SEQ "
text sq_pass "PASS"
text sq_fail "FAIL"
text sq_cs " cases="
text sq_ps " programs="
text sq_co " controls="
text sq_ca " caught="
text sq_hw " hardware=NOT_RUN\n"
text sq_nl "\n"
text sq_seq "seq"
global sq_p uchar 4096
global sq_st uchar 256
global sq_nb uchar 24
note program tokens and their count
global sp ulong 256
note the five tab offsets of the current line
global sq_t ulong 6
note sq_n: 0 tokens, 1 line number, 2 cases, 3 fails, 4 controls, 5 caught, 6 programs, 7 file fd, 8 size,
note 9 control mode (1 on)
global sq_n ulong 16
note the previous program, for the first case of each
global sq_prev uchar 4096
global sq_pl ulong 1

fn sq_num v ulong to void
k = ulong 0
x = v
while true bound 20
put sq_nb k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
for j ulong div k 2 bound 10
a = get sq_nb j
put sq_nb j get sq_nb sub sub k j 1
put sq_nb sub sub k j 1 a
end
r = write 1 sq_nb 0 k
end

note --- the state dump, in the oracle's format ---
fn sq_hex2 b ulong to void
put sq_nb 0 uchar 32
h = shr b 4
lo = and b 15
put sq_nb 1 uchar add h 48
if gt h 9
put sq_nb 1 uchar add h 87
end
put sq_nb 2 uchar add lo 48
if gt lo 9
put sq_nb 2 uchar add lo 87
end
for i ulong 3
fx_c ulong get sq_nb i
end
end

fn sq_row s ulong to void
fx_su mh s
fx_su mva s
fx_su msz s
fx_su mcpu s
end

fn sq_dump to void
fx_c 83
fx_c 84
for i ulong 11
fx_su cg i
end
for i ulong 4
fx_sd bitcast long cg add CS_FDCTL i
end
fx_su cg CS_GREG
fx_su cg CS_VREG
fx_su cg CS_CREG
fx_su cg CS_NEXTRA
fx_su cg CS_LIVEN
fx_su cg CS_PUT
fx_su cg CS_RET
fx_su cg CS_ENT
fx_su cg CS_USERD
fx_su cg CS_TOKEN
fx_su cg CS_CHVA
fx_su cg CS_CHVASZ
fx_su cg CS_SLOT
fx_su cg CS_VANEXT
fx_su cg CS_TSM
fx_su cg CS_DISC
fx_su cg CS_CCLS
fx_su cg CS_GCLS
fx_su cg CS_UCLS
fx_su cg CS_SMV
fx_su cg CS_GPUID
fx_su cg CS_MINOR
fx_su cg CS_UCPU
fx_su cg CS_LRS
fx_su cg CS_RETRIES
for i ulong 16
sq_hex2 cn_uuidb i
end
sq_row 0
sq_row 1
fx_semi
for r ulong cg CS_LIVEN bound 4096
fx_c 76
fx_c 86
fx_su lg r 0
fx_su lg r 1
fx_su lg r 2
fx_su lg r 3
for f ulong 5
fx_su lg r add 4 f
end
fx_semi
end
for i ulong 3
fx_c 67
fx_c 72
for f ulong 10
fx_su xg i f
end
fx_su xg i 10
sq_row add 2 mul i 2
sq_row add 3 mul i 2
fx_semi
end
for i ulong 16
s = add 10 i
if or or or ne mh s 0 ne mva s 0 ne msz s 0 ne mcpu s 0
fx_c 77
fx_c 77
fx_su i
sq_row s
fx_semi
end
end
for i ulong 64
s = add 26 i
if or or or ne mh s 0 ne mva s 0 ne msz s 0 ne mcpu s 0
fx_c 76
fx_c 71
fx_su i
sq_row s
fx_semi
end
end
if or or or ne mh 9 0 ne mva 9 0 ne msz 9 0 ne mcpu 9 0
fx_c 80
fx_c 66
sq_row 9
fx_semi
end
end

note --- run the program in sp with failure script k f r into fo; false when the program is malformed ---
note the argument count of call op; 99 for an unknown call
fn sq_nargs op ulong to ulong
if or or eq op 1 eq op 7 eq op 15
ret 4
end
if or or or or eq op 2 eq op 6 eq op 11 eq op 13 eq op 18
ret 3
end
if or or or or eq op 3 eq op 4 eq op 9 eq op 10 eq op 14
ret 1
end
if eq op 12
ret 2
end
if or or or or eq op 5 eq op 8 eq op 16 eq op 17 eq op 19
ret 0
end
ret 99
end

fn sq_a i ulong to ulong
ret get sp i
end

fn sq_u i ulong to ulong
ret and get sp i CN_U32
end

note 11 SLOT FIELD VALUE
fn sq_poke i ulong to long
s = add 10 sq_a i
fd = sq_a add i 1
v = sq_a add i 2
if eq fd 0
v = and v CN_U32
end
put cm add mul s 4 fd v
ret 0
end

note 12 DST SRC
fn sq_copy i ulong to long
d = add 10 sq_a i
s = add 10 sq_a add i 1
mset d mh s mva s msz s mcpu s
ret 0
end

note 13 CH PUT RETIRED
fn sq_ctr i ulong to long
c = sq_a i
if eq c 0
cp CS_PUT sq_u add i 1
cp CS_RET sq_u add i 2
ret 0
end
xp sub c 1 6 sq_u add i 1
xp sub c 1 7 sq_u add i 2
ret 0
end

note 10 SEL
fn sq_m16free i ulong to long
sel = sq_a i
if lt sel 64
ret cn_m16free mcpu add 26 sel
end
ret cn_m16free sel
end

note call op with its arguments at sp[i] (checked by sq_ok)
fn sq_op op ulong i ulong to long
if eq op 1
fx_scen sq_a i sq_a add i 1 sq_a add i 2 sq_a add i 3
ret cn_open
end
if eq op 2
ret cn_alloc_mode sq_a add i 1 add 10 sq_a i sq_a add i 2
end
if eq op 3
ret cn_free add 10 sq_a i
end
if eq op 4
ret cn_channel sq_u i
end
if eq op 5
ret cn_chdestroy
end
if eq op 6
ret cn_enqueue add 10 sq_a i sq_u add i 1 sq_u add i 2
end
if eq op 7
ret cn_submit sq_u i add 10 sq_a add i 1 sq_u add i 2 sq_u add i 3
end
if eq op 8
ret cn_close
end
if eq op 9
ret cn_m16alloc sq_a i
end
if eq op 10
ret sq_m16free i
end
if eq op 11
ret sq_poke i
end
if eq op 12
ret sq_copy i
end
if eq op 13
ret sq_ctr i
end
if eq op 15
fx_scen sq_a i sq_a add i 1 sq_a add i 2 sq_a add i 3
ret cn_m16open
end
if eq op 16
ret cn_m16chan
end
if eq op 17
ret cn_m16close
end
if eq op 18
ret cn_nsubmit add 10 sq_a i sq_u add i 1 sq_u add i 2
end
if eq op 19
cn_ring
ret 0
end
cp CS_RETMS sq_u i
ret 0
end

note the arguments of call op at sp[i] name existing slots, fields and channels
fn sq_ok op ulong i ulong to bool
if or or or or or eq op 2 eq op 3 eq op 6 eq op 11 eq op 12 eq op 18
if gt sq_a i 15
ret false
end
end
if or eq op 7 eq op 12
if gt sq_a add i 1 15
ret false
end
end
if eq op 11
if gt sq_a add i 1 3
ret false
end
end
if eq op 13
if gt sq_a i 3
ret false
end
end
ret true
end

fn sq_run k ulong f ulong r ulong to bool
fx_reset k f r
cn_zero
for j ulong 360
put cm j 0
end
np = get sq_n 0
i = ulong 0
while lt i np bound 256
op = get sp i
i = add i 1
n = sq_nargs op
if gt add i n np
ret false
end
if not sq_ok op i
ret false
end
rc = sq_op op i
i = add i n
fx_c 79
fx_c 80
fx_su op
fx_rd rc
end
sq_dump
ret true
end

note --- line fields ---
note decimal l[a, b): 1 to 20 digits below 2^64, else false (and v unchanged)
fn sq_dec l view uchar 65536 a ulong b ulong o edit ulong 1 to bool
if or ge a b gt sub b a 20
ret false
end
v = ulong 0
for i ulong sub b a bound 20
c = ulong get l add a i
if or lt c 48 gt c 57
ret false
end
d = sub c 48
if gt v 1844674407370955161
ret false
end
if and eq v 1844674407370955161 gt d 5
ret false
end
v = add mul v 10 d
end
put o 0 v
ret true
end

note the program field l[a, b) into sp; false when it is not decimal tokens separated by single spaces
fn sq_prog l view uchar 65536 a ulong b ulong to bool
o = new ulong 1 0
n = ulong 0
s = a
for i ulong sub add b 1 a bound 65537
p = add a i
if or eq p b eq get l p 32
if ge n 256
ret false
end
if not sq_dec l s p o
ret false
end
put sp n get o 0
n = add n 1
s = add p 1
end
end
put sq_n 0 n
ret true
end

note bytes l[a, b) against fo: the first difference, or 2^64 - 1 when they are the same
fn sq_cmp l view uchar 65536 a ulong b ulong to ulong
m = get fz 0
w = sub b a
for i ulong m bound 65536
if ge i w
ret i
end
if ne ulong get fo i ulong get l add a i
ret i
end
end
if ne m w
ret m
end
ret 18446744073709551615
end

fn sq_show l view uchar 65536 a ulong b ulong ab ulong to void
s = ulong 0
if gt ab 60
s = sub ab 60
end
e = add s 160
r = write 1 sq_want 0 len sq_want
we = sub b a
if gt e we
e = we
end
if lt s e
r = write 1 l add a s sub e s
end
r = write 1 sq_got 0 len sq_got
ge2 = add s 160
if gt ge2 get fz 0
ge2 = get fz 0
end
if lt s ge2
r = write 1 fo s sub ge2 s
end
r = write 1 sq_nl 0 len sq_nl
end

fn sq_fail_line ab ulong to void
put sq_n 3 add get sq_n 3 1
r = write 1 sq_fl 0 len sq_fl
sq_num get sq_n 1
r = write 1 sq_at 0 len sq_at
sq_num ab
end

fn sq_bad to void
put sq_n 3 add get sq_n 3 1
r = write 1 sq_tbad 0 len sq_tbad
sq_num get sq_n 1
r = write 1 sq_nl 0 len sq_nl
end

fn sq_ctlmiss to void
put sq_n 3 add get sq_n 3 1
r = write 1 sq_ctl 0 len sq_ctl
sq_num get sq_n 1
r = write 1 sq_nl 0 len sq_nl
end

note is the program l[a, b) the one of the previous case; remember it
fn sq_newprog l view uchar 65536 a ulong b ulong to bool
w = sub b a
same = eq w get sq_pl 0
if gt w 4096
ret true
end
for i ulong w bound 4096
if ne get sq_prev i get l add a i
same = false
end
put sq_prev i get l add a i
end
put sq_pl 0 w
ret not same
end

note the fields of line l[0, e) into sq_t (tab offsets) and sq_n 11 12 13 (K F R); false when malformed
fn sq_parse e ulong l view uchar 65536 to bool
nt = ulong 0
for i ulong e bound 65536
if eq get l i 9
if lt nt 5
put sq_t nt i
end
nt = add nt 1
end
end
if ne nt 5
ret false
end
if ne get sq_t 0 3
ret false
end
for i ulong 3
if ne get l i get sq_seq i
ret false
end
end
if not sq_prog l add get sq_t 0 1 get sq_t 1
ret false
end
o = new ulong 1 0
for j ulong 3
if not sq_dec l add get sq_t add j 1 1 get sq_t add j 2 o
ret false
end
put sq_n add 11 j get o 0
end
ret true
end

note run the case and compare; true when the trace is the expected one
fn sq_case e ulong l view uchar 65536 to bool
if not sq_run get sq_n 11 get sq_n 12 get sq_n 13
sq_bad
ret false
end
if or ne get fz 11 0 ne get fz 12 0
put sq_n 3 add get sq_n 3 1
w = write 1 sq_ovf 0 len sq_ovf
sq_num get sq_n 1
w = write 1 sq_nl 0 len sq_nl
ret false
end
ta = add get sq_t 4 1
ab = sq_cmp l ta e
if ne ab 18446744073709551615
sq_fail_line ab
sq_show l ta e ab
ret false
end
ret true
end

note the two controls of a program's first case
fn sq_ctls e ulong l edit uchar 65536 to void
ta = add get sq_t 4 1
note control 1: the expected trace with one byte changed must not compare equal
mid = add ta div sub e ta 2
keep = get l mid
put l mid uchar xor ulong keep 1
put sq_n 4 add get sq_n 4 1
if ne sq_cmp l ta e 18446744073709551615
put sq_n 5 add get sq_n 5 1
else
sq_ctlmiss
end
put l mid keep
note control 2: the same program with another failure script must give another trace
k2 = ulong 1
if eq get sq_n 11 1
k2 = ulong 2
end
put sq_n 4 add get sq_n 4 1
if sq_run k2 0 1
if ne sq_cmp l ta e 18446744073709551615
put sq_n 5 add get sq_n 5 1
else
sq_ctlmiss
end
else
sq_ctlmiss
end
end

fn sq_line e ulong l edit uchar 65536 to void
put sq_n 1 add get sq_n 1 1
if eq e 0
ret
end
if eq get l 0 35
ret
end
if not sq_parse e l
sq_bad
ret
end
put sq_n 2 add get sq_n 2 1
first = sq_newprog l add get sq_t 0 1 get sq_t 1
if first
put sq_n 6 add get sq_n 6 1
end
if not sq_case e l
ret
end
if first
sq_ctls e l
end
end

fn sq_gsize fd int to ulong
if ne fstat fd sq_st 0 128 0
ret 0
end
size = ulong 0
for j ulong 8
size = or size shl ulong get sq_st add 48 j mul j 8
end
ret size
end

fn sq_open to long
if ne argcnt 2
r = write 2 sq_use 0 len sq_use
ret 0
end
pl = argread 1 sq_p 0 4095
if lt pl 1
r = write 2 sq_use 0 len sq_use
ret 0
end
fd = int fopen sq_p 0 ulong pl 524288 0
if lt fd 0
r = write 2 sq_topen 0 len sq_topen
ret 0
end
size = sq_gsize fd
put sq_n 7 ulong fd
put sq_n 8 size
h = long 0
if gt size 0
h = mapnew fd 0 size 1 2
end
if le h 0
r = write 2 sq_topen 0 len sq_topen
ret 0
end
ret h
end

fn sq_eol k ulong l view uchar 65536 to ulong
for i ulong k bound 65536
if eq get l i 10
ret i
end
end
ret k
end

fn sq_summary to int
r = write 1 sq_sum 0 len sq_sum
pass = and eq get sq_n 3 0 gt get sq_n 2 0
pass = and pass eq get sq_n 4 get sq_n 5
pass = and pass eq get sq_n 4 mul 2 get sq_n 6
if pass
r = write 1 sq_pass 0 len sq_pass
else
r = write 1 sq_fail 0 len sq_fail
end
r = write 1 sq_cs 0 len sq_cs
sq_num get sq_n 2
r = write 1 sq_ps 0 len sq_ps
sq_num get sq_n 6
r = write 1 sq_co 0 len sq_co
sq_num get sq_n 4
r = write 1 sq_ca 0 len sq_ca
sq_num get sq_n 5
r = write 1 sq_hw 0 len sq_hw
if pass
ret 0
end
ret 1
end

fn main to int
l = new uchar 65536 0
h = sq_open
if le h 0
ret 2
end
size = get sq_n 8
pos = ulong 0
while lt pos size bound 9223372036854775807
k = sub size pos
if gt k 65536
k = ulong 65536
end
if ne mapread h pos l 0 k long k
r = write 2 sq_topen 0 len sq_topen
ret 2
end
e = sq_eol k l
if and eq e k eq k 65536
r = write 2 sq_long 0 len sq_long
ret 2
end
sq_line e l
pos = add pos add e 1
end
r = mapdrop h
q = fclose int get sq_n 7
ret sq_summary
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/driver/m16.om: the M16 checks that were still C in CUDApp m16/ (84b524ca).
note m16_requalify.c check_proc_maps, m16_gpu_wait.c m16_gpu_wait_result_name and m16_gpu_wait_kind_name, and
note m16_native.c m16_native_wait_marker_ge. The rest of the M16 decisions are in gpu/nvidia/om/engine/eng.om.
note Needs OM-2 (unsized views): compose after an om2 part; gpu/nvidia/driver/parts.txt lists the order.

text drv_m16t "libcuda.so|libcudart.so|PASS|TIMEOUT|STALLED|INVALID_STATE|ABORTED|UNKNOWN|fixed|sequence|unknown|"

note piece w of drv_m16t starts at byte r[0] and has r[1] bytes; past the last piece it is empty
fn drv_m16p w ulong r edit ulong 2 to void
k = ulong 0
i = ulong 0
while and lt k w lt i len drv_m16t bound 9223372036854775807
if eq get drv_m16t i 124
k = add k 1
end
i = add i 1
end
put r 0 i
put r 1 0
if ge i len drv_m16t
ret
end
while ne get drv_m16t i 124 bound 9223372036854775807
i = add i 1
end
put r 1 sub i get r 0
end

note piece w of drv_m16t occurs in f at byte s
fn drv_m16at f view uchar * s ulong w ulong to bool
r = new ulong 2 0
drv_m16p w r
if gt add s get r 1 len f
ret false
end
for i ulong get r 1 bound 9223372036854775807
if ne get f add s i get drv_m16t add get r 0 i
ret false
end
end
ret true
end

note check_proc_maps: 1 when a line of the process map f (the bytes of /proc/self/maps) holds libcuda.so or
note libcudart.so, else 0. As in the C, a NUL ends the part of a line that is searched. Lines are searched
note whole; the C reads them in 511-byte pieces.
fn drv_maps f view uchar * to ulong
live = true
for i ulong len f bound 9223372036854775807
c = get f i
if eq c 10
live = true
continue
end
if eq c 0
live = false
continue
end
if live
if or drv_m16at f i 0 drv_m16at f i 1
ret 1
end
end
end
ret 0
end

note m16_gpu_wait_result_name: the name of result r into r2 (piece start, length)
fn drv_wres r long o edit ulong 2 to void
w = ulong 7
if and ge r 0 le r 4
w = add ulong r 2
end
drv_m16p w o
end

note m16_gpu_wait_kind_name: 1 fixed, 2 sequence, any other kind unknown
fn drv_wkind k long o edit ulong 2 to void
w = ulong 10
if eq k 1
w = ulong 8
end
if eq k 2
w = ulong 9
end
drv_m16p w o
end

note marker has reached target: (int32_t)(marker - target) >= 0 on the low 32 bits
fn drv_reached marker ulong target ulong to bool
ret eq and sub marker target 2147483648 0
end

note timeout_ms * 1000000 in nanoseconds, or 2^64 - 1 when that overflows (the C then never reads the clock
note for the deadline). 2^64 - 1 is not a multiple of 1000000, so it never stands for a real duration.
fn drv_wdur timeout ulong to ulong
if gt timeout 18446744073709
ret 18446744073709551615
end
ret mul timeout 1000000
end

note deadline now + dur, saturating at 2^64 - 1
fn drv_wend now ulong dur ulong to ulong
e = add now dur
if lt e now
ret 18446744073709551615
end
ret e
end

note One look of m16_native_wait_marker_ge: inloop tells whether the clock read before this look was still
note before the deadline. 0: the u32 marker reached target, return 0; 1: not yet, sleep and look again;
note 2: the look after the deadline failed, return -1. Both drv_wait_ge and gate.om hwge call it.
fn drv_wstep inloop bool mk ulong tg ulong to ulong
if drv_reached mk tg
ret 0
end
if inloop
ret 1
end
ret 2
end

note m16_native_wait_marker_ge on a mapped marker: handle h, byte offset off (4-aligned). 0 when the u32
note marker reached target before the deadline or at the last look after it, -1 otherwise. A device path:
note its hardware tier is NOT_RUN. gate.om runs drv_wdur, drv_wend and drv_wstep on a scripted clock; the
note clock reads, the marker read and the sleep below are not run by any gate.
fn drv_wait_ge h long off ulong target ulong timeout ulong to long
dur = drv_wdur timeout
endt = ulong 18446744073709551615
if ne dur 18446744073709551615
endt = drv_wend ulong monons dur
end
st = ulong 1
while eq st 1 bound 9223372036854775807
st = drv_wstep lt ulong monons endt mapget h off 4 target
if eq st 1
s = sleepns 50000
end
end
if eq st 0
ret 0
end
ret -1
end

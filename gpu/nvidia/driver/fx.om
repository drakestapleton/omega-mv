note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/driver/fx.om: the dx_ effects of client.om answered from a script and recorded, for the host
note gate (seqgate.om). It is the Omega twin of the recorder in the C oracle (seqoracle.c, outside this tree):
note the same event per effect, the same answers, the same failure script. Each effect is one event
note "NAME ARGS =RESULT;" appended to fo; request fields set with dx_fk and dx_fa are printed with the effect
note that sends them (" kKIND V V ...").
note
note Script: the effects are numbered from 1 in the order they happen. Effect K (0: none) and the next effects
note of the same type, R in all, fail with flavour F, if their type can fail (fx_eff's nfl: how many flavours).
note Otherwise every effect succeeds with an answer derived from its number n: an RM handle 3238002688 + n
note (0xc1000000 + n), a GPU VA 137438953472 + n * 2^20, a usermode mapping 5497558138880 + n * 2^16, a file
note descriptor 10 + n, a work-submit token 4096 + n. A refused effect answers errno 5.
note Scenario of nvrm_open (fx_scen): the admitted SM, the SM the classes select, discrete, the class count.
note The card table the CARD_INFO answer fills holds the same record at every index i: PCI 0000:01:00.0,
note vendor 4318 (0x10de), device 11794 (0x2e12), gpu_id 256 + i, minor i; card_index answers 2.

global fo uchar 65536
note fz: 0 length of fo, 1 effects so far (n), 2 K, 3 F, 4 failures left (R), 5 type of effect K, 6 admitted SM,
note 7 selected SM, 8 discrete, 9 class count, 10 pending fill words, 11 fo overflowed, 12 a script the
note recorder cannot follow (a flavour the effect does not have, an unknown request value)
global fz ulong 16
global ff ulong 64

fn fx_c c ulong to void
l = get fz 0
if lt l 65536
put fo l uchar c
put fz 0 add l 1
else
put fz 11 1
end
end

fn fx_num v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
while true bound 20
put d k uchar add 48 rem x 10
k = add k 1
x = div x 10
if eq x 0
break
end
end
for j ulong k bound 20
fx_c ulong get d sub sub k j 1
end
end

note " V" unsigned, " V" signed
fn fx_su v ulong to void
fx_c 32
fx_num v
end

fn fx_sd v long to void
fx_c 32
if lt v 0
fx_c 45
fx_num ulong sub long 0 v
else
fx_num ulong v
end
end

fn fx_semi to void
fx_c 59
end

note " =V;" unsigned and signed
fn fx_ru v ulong to void
fx_c 32
fx_c 61
fx_num v
fx_semi
end

fn fx_rd v long to void
fx_c 32
fx_c 61
if lt v 0
fx_c 45
fx_num ulong sub long 0 v
else
fx_num ulong v
end
fx_semi
end

note " =1;" when refused, " =0;" when not
fn fx_rf f long to void
if ge f 0
fx_ru 1
else
fx_ru 0
end
end

fn fx_reset k ulong f ulong r ulong to void
for i ulong 16
put fz i 0
end
put fz 2 k
put fz 3 f
put fz 4 r
end

fn fx_scen asm ulong ssm ulong disc ulong ncls ulong to void
put fz 6 asm
put fz 7 ssm
put fz 8 disc
put fz 9 ncls
end

note start effect of type t with nfl failure flavours, named c1 c2; the flavour when it fails, else -1
fn fx_eff t ulong nfl ulong c1 ulong c2 ulong to long
n = add get fz 1 1
put fz 1 n
k = get fz 2
if and ne k 0 eq n k
put fz 5 t
end
fx_c c1
fx_c c2
hit = and gt nfl 0 ne k 0
hit = and hit ge n k
hit = and hit gt get fz 4 0
hit = and hit eq t get fz 5
if hit
put fz 4 sub get fz 4 1
if ge get fz 3 nfl
put fz 12 1
end
ret long get fz 3
end
ret -1
end

fn fx_n to ulong
ret get fz 1
end

note the pending request fields, then none
fn fx_fills to void
for i ulong get fz 10 bound 64
v = get ff i
if ne shr v 63 0
fx_c 32
fx_c 107
fx_num and v 255
else
fx_su v
end
end
put fz 10 0
end

fn dx_fk kind ulong to void
n = get fz 10
if lt n 64
put ff n or 9223372036854775808 kind
put fz 10 add n 1
else
put fz 12 1
end
end

fn dx_fa v ulong to void
n = get fz 10
if lt n 64
put ff n v
put fz 10 add n 1
else
put fz 12 1
end
end

fn dx_errno to long
ret 5
end

fn dx_admit_open to bool
f = fx_eff 1 1 97 111
fx_rf f
ret lt f 0
end

fn dx_slot to ulong
f = fx_eff 2 1 118 115
b = ulong 68719476736
if ge f 0
b = ulong 0
end
fx_ru b
ret b
end

fn dx_recycle base ulong to void
f = fx_eff 20 0 114 99
fx_su base
fx_semi
end

note path 1 /dev/nvidiactl, 2 /dev/nvidia-uvm
fn dx_fopen path ulong to long
f = fx_eff 3 1 111 112
fd = long add 10 fx_n
if ge f 0
fd = long -1
end
fx_su path
fx_rd fd
ret fd
end

fn dx_fclose fd long to long
f = fx_eff 3 1 99 108
fx_sd fd
fx_rf f
if ge f 0
ret -1
end
ret 0
end

note RM_ALLOC: the new handle, 0 when refused (last_rm_status: flavour 0 status 31, 1 NV_ERR_NO_MEMORY 81, 2 errno)
fn dx_alloc parent ulong cls ulong to ulong
f = fx_eff 4 3 97 108
fx_su parent
fx_su cls
fx_fills
if ge f 0
st = ulong 0
if eq f 0
st = ulong 31
end
if eq f 1
st = ulong 81
end
cp CS_LRS st
fx_ru 0
ret 0
end
cp CS_LRS 0
h = add 3238002688 fx_n
fx_ru h
ret h
end

fn dx_free parent ulong obj ulong to bool
f = fx_eff 24 1 102 114
fx_su parent
fx_su obj
fx_rf f
ret lt f 0
end

fn dx_ctrl obj ulong cmd ulong to bool
f = fx_eff 10 1 99 116
fx_su obj
fx_su cmd
fx_fills
fx_rf f
ret lt f 0
end

fn dx_uvm fd long cmd ulong to bool
f = fx_eff 11 1 117 118
fx_sd fd
fx_su cmd
fx_fills
fx_rf f
ret lt f 0
end

fn dx_uvmraw fd long cmd ulong to void
f = fx_eff 5 0 117 109
fx_sd fd
fx_su cmd
fx_fills
fx_semi
end

fn dx_ioctl fd long nr ulong to bool
f = fx_eff 6 1 105 111
fx_sd fd
fx_su nr
fx_fills
fx_rf f
ret lt f 0
end

fn dx_cardidx to long
f = fx_eff 7 1 99 105
r = long 2
if ge f 0
r = long -1
end
fx_rd r
ret r
end

note admit the card at index i: the admitted SM, -1 when refused
fn dx_admit_card i ulong to long
f = fx_eff 8 1 97 99
fx_su 0
fx_su 1
fx_su 0
fx_su 0
fx_su 4318
fx_su 11794
fx_rf f
if ge f 0
ret -1
end
ret long get fz 6
end

note card record i field: 5 gpu_id, 6 minor, 7 vendor, 8 device
fn dx_cardget i ulong fl ulong to ulong
if eq fl 5
ret add 256 i
end
if eq fl 6
ret i
end
if eq fl 7
ret 4318
end
if eq fl 8
ret 11794
end
put fz 12 1
ret 0
end

fn dx_opendev minor ulong to long
f = fx_eff 9 1 111 100
fd = long add 10 fx_n
if ge f 0
fd = long -1
end
fx_su minor
fx_rd fd
ret fd
end

note a field of the last answer: kind 1 field 1 device instance, 17/1 SM version, 7/0 class count,
note 14/0 work-submit token, 9/3+i uuid byte i
fn dx_nsget kind ulong fl ulong to ulong
if and eq kind 1 eq fl 1
ret 3
end
if and eq kind 17 eq fl 1
ret 2564
end
if and eq kind 7 eq fl 0
ret get fz 9
end
if and eq kind 14 eq fl 0
ret add 4096 fx_n
end
if and and eq kind 9 ge fl 3 lt fl 19
ret and add mul sub fl 3 37 11 255
end
put fz 12 1
ret 0
end

note select_classes: on success the target SM, discrete flag and the compute, GPFIFO and usermode classes
fn dx_select count ulong vendor ulong device ulong to bool
f = fx_eff 12 1 115 99
fx_su count
fx_su vendor
fx_su device
fx_rf f
cp CS_CCLS 0
cp CS_GCLS 0
cp CS_UCLS 0
cp CS_TSM 0
cp CS_DISC 0
if ge f 0
ret false
end
d = get fz 8
cp CS_TSM get fz 7
cp CS_DISC d
if ne d 0
cp CS_CCLS 51136
cp CS_GCLS 50543
cp CS_UCLS 50017
else
cp CS_CCLS 52928
cp CS_GCLS 51567
cp CS_UCLS 50785
end
ret true
end

note map_to_cpu: the CPU address (target, or a new one when target is 0), 2^64 - 1 when refused
fn dx_map h ulong size ulong target ulong flags ulong system long to ulong
f = fx_eff 13 1 109 112
p = target
if eq target 0
p = add 5497558138880 shl fx_n 16
end
if ge f 0
p = CN_MAPFAILED
end
fx_su h
fx_su size
fx_su target
fx_su flags
fx_sd system
fx_ru p
ret p
end

note nvrm_cpu_reserve: va; flavour 0 refused (2^64 - 1), flavour 1 another address (va + 4096)
fn dx_reserve va ulong size ulong to ulong
f = fx_eff 14 2 114 115
p = va
if eq f 0
p = CN_MAPFAILED
end
if eq f 1
p = add va 4096
end
fx_su va
fx_su size
fx_ru p
ret p
end

fn dx_drop cpu ulong size ulong to bool
f = fx_eff 15 1 100 112
fx_su cpu
fx_su size
fx_rf f
ret lt f 0
end

fn dx_transfer h ulong to void
f = fx_eff 16 0 116 114
fx_su h
fx_semi
end

fn dx_finish to bool
f = fx_eff 17 1 102 110
fx_rf f
ret lt f 0
end

fn dx_vatake size ulong align ulong to ulong
f = fx_eff 18 1 118 116
va = add 137438953472 shl fx_n 20
if ge f 0
va = ulong 0
end
fx_su size
fx_su align
fx_ru va
ret va
end

fn dx_varel va ulong size ulong to bool
f = fx_eff 19 1 118 114
fx_su va
fx_su size
fx_rf f
ret lt f 0
end

note uvm_map: 0 mapped; refused 1 before anything, 2 after the UVM range was created, 3 after the DMA map too
fn dx_uvmmap va ulong size ulong h ulong to ulong
f = fx_eff 21 3 117 120
r = ulong 0
if ge f 0
r = add ulong f 1
end
fx_su va
fx_su size
fx_su h
fx_ru r
ret r
end

fn dx_uvmfree va ulong size ulong to bool
f = fx_eff 22 1 117 102
fx_su va
fx_su size
fx_rf f
ret lt f 0
end

fn dx_dmaunmap h ulong va ulong size ulong to bool
f = fx_eff 23 1 100 117
fx_su h
fx_su va
fx_su size
fx_rf f
ret lt f 0
end

fn dx_validate off ulong nw ulong to bool
f = fx_eff 25 1 118 97
fx_su off
fx_su nw
fx_rf f
ret lt f 0
end

fn dx_publish fifoh ulong entries ulong putv ulong userd ulong va ulong nw ulong to bool
f = fx_eff 26 1 112 98
fx_su fifoh
fx_su entries
fx_su putv
fx_su userd
fx_su va
fx_su nw
fx_rf f
ret lt f 0
end

fn dx_doorbell token ulong to bool
f = fx_eff 27 1 100 98
fx_su token
fx_rf f
ret lt f 0
end

fn dx_sleep us ulong to void
f = fx_eff 28 0 115 108
fx_su us
fx_semi
end

fn dx_zero cpu ulong size ulong to void
f = fx_eff 29 0 122 98
fx_su cpu
fx_su size
fx_semi
end

note fail(): "ER CODE ARGS;" (string arguments print as s)
fn dx_er code ulong to void
fx_c 69
fx_c 82
fx_su code
end

fn dx_eu v ulong to void
fx_su v
end

fn dx_ed v long to void
fx_sd v
end

fn dx_es to void
fx_c 32
fx_c 115
end

fn dx_ee to void
fx_semi
end

fn dx_ea size ulong to void
fx_c 69
fx_c 65
fx_su size
fx_semi
end

fn dx_en attempts ulong delay ulong to void
fx_c 69
fx_c 78
fx_su attempts
fx_su delay
fx_semi
end

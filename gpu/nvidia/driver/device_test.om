note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/nvidia/driver/device_test.om: host-only verification of gpu/nvidia/driver/device.om + client.om.
note Composes with policy.om, nvrm.om, client.om, device.om; NEVER opens /dev/nvidia*.
note Exercises VA slot/interval allocation, chip selection, invalid-fd fail-closed refusals,
note and cn_open clean failure unwind against a nonexistent device root.

text dvt_pass "PASS gpu/nvidia/driver/device.om host+refusal controls (hardware=NOT_RUN)\n"
text dvt_fail "FAIL gpu/nvidia/driver/device.om\n"
text dvt_nonex "/nonexistent/omega-drv-test"

fn main to int
dv_reset
rp = new uchar 256 0
for i ulong len dvt_nonex
put rp i get dvt_nonex i
end
dv_set_root view rp len dvt_nonex

note 1. Slot allocation & VA interval allocator round-trip
slot = dx_slot
if eq slot 0
r = write 2 dvt_fail 0 len dvt_fail
ret 1
end
va1 = dx_vatake 65536 4096
va2 = dx_vatake 65536 4096
if or eq va1 0 or eq va2 0 ne sub va2 va1 65536
r = write 2 dvt_fail 0 len dvt_fail
ret 2
end
if not dx_varel va1 65536
r = write 2 dvt_fail 0 len dvt_fail
ret 3
end
va3 = dx_vatake 65536 4096
if ne va3 va1
r = write 2 dvt_fail 0 len dvt_fail
ret 4
end

note 2. Chip class selection: GB10 (0x10de:0x2e12) accepted, non-NVIDIA rejected
if not dx_select 1 4318 11794
r = write 2 dvt_fail 0 len dvt_fail
ret 5
end
if or ne cg CS_TSM 121 ne cg CS_DISC 0
r = write 2 dvt_fail 0 len dvt_fail
ret 6
end
if dx_select 1 4098 29857
r = write 2 dvt_fail 0 len dvt_fail
ret 7
end

note 3. Negative control: invalid fd (-1) must fail closed on alloc/free/ctrl/uvm/ioctl/map
cp CS_FDCTL CN_MAPFAILED
cp CS_FDDEV CN_MAPFAILED
cp CS_FDUVM CN_MAPFAILED
if ne dx_alloc 0 65 0
r = write 2 dvt_fail 0 len dvt_fail
ret 8
end
if dx_free 0 1
r = write 2 dvt_fail 0 len dvt_fail
ret 9
end
if dx_ctrl 1 1
r = write 2 dvt_fail 0 len dvt_fail
ret 10
end
if dx_uvm -1 1
r = write 2 dvt_fail 0 len dvt_fail
ret 11
end
if dx_ioctl -1 1
r = write 2 dvt_fail 0 len dvt_fail
ret 12
end
if ne dx_map 1 4096 0 0 0 CN_MAPFAILED
r = write 2 dvt_fail 0 len dvt_fail
ret 13
end

note 4. Full client.om cn_open against nonexistent root must fail cleanly (no trap, no open fds)
dv_reset
dv_set_root view rp len dvt_nonex
if eq cn_open 0
r = write 2 dvt_fail 0 len dvt_fail
ret 14
end
if eq get dv_st 9 0
r = write 2 dvt_fail 0 len dvt_fail
ret 15
end

r = write 1 dvt_pass 0 len dvt_pass
ret 0
end

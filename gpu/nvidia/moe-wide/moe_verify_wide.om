note Independent rank-based verifier for moe_plan_wide (views 1280/12672/2052/2832, Y at 1416).
fn mvw_rank ids view ulong 1280 c view ulong 8 e ulong t ulong s ulong to ulong
rank = ulong 0
orig = add mul t get c 2 s
for i ulong mul get c 1 get c 2
id = ulong get ids i
if lt id e
rank = add rank 1
else
if eq id e
if lt i orig
rank = add rank 1
end
end
end
end
ret rank
end
fn mvw_row w view ulong 12672 c view ulong 8 p ulong i ulong id ulong to ulong
b = mul p 9
t = div i get c 2
s = rem i get c 2
if ne get w b id
ret 1
end
if ne get w add b 1 t
ret 1
end
if ne get w add b 2 t
ret 2
end
if ne get w add b 3 s
ret 2
end
if ne get w add b 4 s
ret 3
end
if ne get w add b 8 s
ret 3
end
y = mul t add get c 2 1
y = add y s
if ne get w add b 7 y
ret 4
end
ret 0
end
fn mvw_routes c view ulong 8 ids view ulong 1280 w view ulong 12672 to ulong
for i ulong mul get c 1 get c 2
id = ulong get ids i
if ne id 4294967295
t = div i get c 2
s = rem i get c 2
p = mvw_rank ids c id t s
rc = mvw_row w c p i id
if ne rc 0
ret rc
end
end
end
ret 0
end
fn mvw_shared c view ulong 8 w view ulong 12672 m view ulong 8 to ulong
for t ulong get c 1
p = add get m 2 t
b = mul p 9
if ne get w b get c 3
ret 7
end
if ne get w add b 1 t
ret 7
end
if ne get w add b 2 t
ret 7
end
if ne get w add b 3 get c 2
ret 8
end
if ne get w add b 4 get c 2
ret 8
end
if ne get w add b 8 get c 2
ret 9
end
y = mul t add get c 2 1
y = add y get c 2
if ne get w add b 7 y
ret 10
end
end
ret 0
end
fn mvw_maps w view ulong 12672 mp view ulong 2832 m view ulong 8 to ulong
for p ulong get m 0
b = mul p 9
if ne get mp p get w add b 1
ret 5
end
if ne get mp add 1416 p get w add b 7
ret 11
end
end
for k ulong 8
if ne get mp add get m 0 k 0
ret 17
end
if ne get mp add add 1416 get m 0 k 0
ret 17
end
end
ret 0
end
fn mvw_seg w view ulong 12672 sg view ulong 2052 z ulong pos ulong to ulong
b = mul z 4
if or ne get sg add b 1 pos eq get sg add b 2 0
ret 12
end
for k ulong ulong get sg add b 2
v = mul add pos k 9
if ne get w v get sg b
ret 13
end
if ne get w add v 5 pos
ret 14
end
if ne get w add v 6 get sg add b 2
ret 14
end
end
ret 0
end
fn mvw_segments c view ulong 8 w view ulong 12672 sg view ulong 2052 m view ulong 8 to ulong
pos = ulong 0
for z ulong get m 1
rc = mvw_seg w sg z pos
if ne rc 0
ret rc
end
b = mul z 4
flag = ulong 0
if eq get sg b get c 3
flag = 1
end
if ne get sg add b 3 flag
ret 15
end
pos = add pos ulong get sg add b 2
end
if ne pos get m 0
ret 16
end
ret 0
end
fn mvw_counts c view ulong 8 ids view ulong 1280 m view ulong 8 to ulong
nr = ulong 0
for i ulong mul get c 1 get c 2
if ne get ids i 4294967295
nr = add nr 1
end
end
if or ne get m 2 nr ne get m 0 add nr get c 1
ret 6
end
ret 0
end
fn moe_verify_wide c view ulong 8 ids view ulong 1280 w view ulong 12672 sg view ulong 2052 mp view ulong 2832 m view ulong 8 to ulong
rc = mvw_counts c ids m
if ne rc 0
ret rc
end
rc = mvw_routes c ids w
if ne rc 0
ret rc
end
rc = mvw_shared c w m
if ne rc 0
ret rc
end
rc = mvw_maps w mp m
if ne rc 0
ret rc
end
ret mvw_segments c w sg m
end

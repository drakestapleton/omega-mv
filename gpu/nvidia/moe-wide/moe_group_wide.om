note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note moe_group with contributions per token read from directory_slots instead of the literal 9.
note Profiles: (directory_slots 9, shared_id 256) Qwen3.6-35B; (11, 512) Qwen3.8-Flash-Next.
note req: ids,tgu,tdn,sgu,sdn,xmap,ymap,stride,tokens,seg_entries,map_entries,
note directory_slots,session_generation,current_generation,admitted,shared_id.
note admitted is the external selector/cache admission verdict, NOT qualification here.
note Router ids row = directory_slots-1 routed u32 picks; table rows directory_slots*16 bytes.
note seg_entries must cover ALL R descriptors, including GROUP trailing zero writes.
note Output is exact OMEGA_DEC_GR_WORDS u32 constant-bank words, little endian pairs.
note groups=11 needs a GROUP kernel built for 11 contributions; this unit emits host words only.
fn mwg_word o edit uchar 64 p ulong v ulong to void
for b ulong 4
put o add mul p 4 b uchar and shr v mul b 8 255
end
end
fn mwg_pair o edit uchar 64 p ulong v ulong to void
mwg_word o p and v 4294967295
mwg_word o add p 1 shr v 32
end
fn mwg_profile r view ulong 16 to ulong
if eq get r 11 9
if eq get r 15 256
ret 0
end
end
if eq get r 11 11
if eq get r 15 512
ret 0
end
end
ret 1
end
fn mwg_extent r view ulong 16 i ulong to ulong
k = get r 11
if lt i 3
width = mul k 16
if eq i 0
width = mul sub k 1 4
end
ret add mul sub get r 8 1 get r 7 width
end
if lt i 5
ret mul mul get r 8 k 32
end
ret mul add mul get r 8 k 8 4
end
fn mwg_overlap a ulong al ulong b ulong bl ulong to bool
if ge a add b bl
ret false
end
ret lt b add a al
end
fn mwg_alias r view ulong 16 to bool
for i ulong 7
n = mwg_extent r i
if gt get r i sub ulong 18446744073709551615 n
ret true
end
end
for j ulong 4
for i ulong add j 3
n = mwg_extent r i
m = mwg_extent r add j 3
if mwg_overlap get r i n get r add j 3 m
ret true
end
end
end
ret false
end
fn moe_group_wide r view ulong 16 o edit uchar 64 to ulong
if gt get r 8 128
ret 1
end
if ne mwg_profile r 0
ret 1
end
rows = mul get r 8 get r 11
if or eq get r 8 0 gt rows 128
ret 1
end
if lt get r 9 rows
ret 2
end
if lt get r 10 add rows 8
ret 2
end
if or eq get r 7 0 gt get r 7 4294967295
ret 2
end
if lt get r 7 mul get r 11 16
ret 2
end
if ne rem get r 7 16 0
ret 3
end
for i ulong 7
if or eq get r i 0 ne rem get r i 8 0
ret 3
end
end
if ne get r 12 get r 13
ret 4
end
if ne get r 14 1
ret 4
end
if mwg_alias r
ret 5
end
for i ulong 7
mwg_pair edit o mul i 2 get r i
end
mwg_word o 14 get r 7
mwg_word o 15 get r 8
ret 0
end

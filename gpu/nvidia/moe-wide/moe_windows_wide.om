note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note moe_windows with the contribution count read from cfg instead of the literal 9.
note Profiles (H,EI,contributions): (2048,512,9) Qwen3.6-35B; (2560,640,11) Qwen3.8-Flash-Next.
note GROUP has 128 rows: take = 128/contributions tokens per window (14 or 11).
note All windows stay in ONE existing session/cmdlist; GROUP/GU/SWIGLU/DN complete in list order.
note Input version 1,tokens,H,EI,contributions,router_stride,window_capacity,reserved.
note Each output8: token0,tokens,rows,XP bytes,GU bytes,ACT bytes,DN bytes,router bytes.
note Meta windows,total_tokens,total_rows,version. Refusals preserve output/meta.
fn mw_woff c view ulong 8 o edit ulong 1024 z ulong first ulong to void
b = mul z 8
v = mul first get c 2
put o add b 3 mul v 4
v = mul first get c 4
v = mul v get c 3
put o add b 4 mul v 8
put o add b 5 mul v 4
v = mul first get c 4
v = mul v get c 2
put o add b 6 mul v 4
put o add b 7 mul first get c 5
end
fn mw_wrow c view ulong 8 o edit ulong 1024 z ulong first ulong count ulong to void
b = mul z 8
rows = mul count get c 4
put o b first
put o add b 1 count
put o add b 2 rows
mw_woff c o z first
end
fn mw_wshape c view ulong 8 to ulong
if eq get c 4 9
if eq get c 2 2048
if eq get c 3 512
ret 0
end
end
end
if eq get c 4 11
if eq get c 2 2560
if eq get c 3 640
ret 0
end
end
end
ret 1
end
fn moe_windows_wide c view ulong 8 o edit ulong 1024 m edit ulong 4 to ulong
if or ne get c 0 1 gt get c 1 128
ret 1
end
if ne mw_wshape c 0
ret 1
end
if or eq get c 5 0 gt get c 5 4294967295
ret 1
end
if ne rem get c 5 16 0
ret 1
end
if or gt get c 6 128 ne get c 7 0
ret 1
end
take = div ulong 128 get c 4
nw = div add get c 1 sub take 1 take
if gt nw get c 6
ret 2
end
first = ulong 0
for z ulong nw
count = sub get c 1 first
if gt count take
count = take
end
mw_wrow c o z first count
first = add first count
end
put m 0 nw
put m 1 get c 1
put m 2 mul get c 1 get c 4
put m 3 1
ret 0
end

note moe_admit_wide caller: the moe_admit flow at 9 slots/256 experts, then 11 slots/512 experts.
note Actual canonical selection/cache caller with owner's synthetic policy fixture.
note No trusted registry, artifact qualification, GPU or model claim.
fn mwc_fix9 r edit ulong 16 to void
for i ulong 7
put r i mul add i 1 4096
end
put r 3 65536
put r 4 131072
put r 5 196608
put r 6 262144
put r 7 512
put r 8 14
put r 9 126
put r 10 134
put r 11 9
put r 15 256
end
fn mwc_fix11 r edit ulong 16 to void
mwc_fix9 r
put r 8 11
put r 9 121
put r 10 129
put r 11 11
put r 15 512
end
fn mwc_wide r edit ulong 16 q view ulong 64 a view ulong 1024 p edit ulong 528 o edit uchar 64 lease edit ulong 16 to int
mwc_fix11 r
note Cross-profile requests refuse as GROUP code 1 before any pin is taken.
put r 15 256
if ne moe_admit_wide view r view q view a edit p edit o edit lease 81
ret 22
end
if ne get lease 0 0
ret 23
end
put r 15 512
put r 9 120
if ne moe_admit_wide view r view q view a edit p edit o edit lease 82
ret 24
end
if ne get lease 0 0
ret 25
end
put r 9 121
put r 7 160
if ne moe_admit_wide view r view q view a edit p edit o edit lease 82
ret 26
end
put r 7 512
if ne moe_admit_wide view r view q view a edit p edit o edit lease 0
ret 27
end
if ne get lease 0 1
ret 28
end
if or ne get o 56 0 ne get o 57 2
ret 29
end
if ne get o 60 11
ret 29
end
if ne kc_acquire p get lease 1 get lease 2 get lease 3 0
ret 30
end
if ne kc_retire p get lease 1 get lease 2 get lease 3 0
ret 31
end
if ne kc_unpin p get lease 1 get lease 2 get lease 3 0
ret 32
end
mwc_fix9 r
ret 0
end
fn mwc_tail r edit ulong 16 q edit ulong 64 a edit ulong 1024 p edit ulong 528 o edit uchar 64 lease edit ulong 16 to int
note The legacy caller's closing refusals, split out of main to stay within the 16-register pool.
note Wrong family must release its just-acquired recorded pin, not leak it.
put a 128 2
if ne moe_admit_wide view r view q view a edit p edit o edit lease 76
ret 12
end
if or ne get lease 0 0 ne get p 19 0
ret 13
end
put a 128 3
put r 9 125
if ne moe_admit_wide view r view q view a edit p edit o edit lease 82
ret 14
end
if ne get lease 0 0
ret 15
end
put r 9 126
if ne kc_invalidate p 2 1 0
ret 16
end
if ne moe_admit_wide view r view q view a edit p edit o edit lease 84
ret 17
end
if ne get lease 0 0
ret 18
end
pzero = new ulong 528 0
if ne kc_init pzero 0 1 128 1 0
ret 19
end
put q 3 0
for j ulong get q 1
put a add mul j 64 17 0
end
if ne moe_admit_wide view r view q view a edit pzero edit o edit lease 75
ret 20
end
if ne get lease 0 0
ret 21
end
ret 0
end
fn main to int
q = new ulong 64 0
a = new ulong 1024 0
p = new ulong 528 0
o = new uchar 64 90
lease = new ulong 16 0
req = new ulong 16 0
r = new ulong 16 0
pl_fixture q a
mwc_fix9 r
note Disable tied warp candidate: MoE requires staged indexed family3.
put a 65 0
if ne kc_init p 1 1 128 1 0
ret 1
end
if ne moe_admit_wide view r view q view a edit p edit o edit lease 75
ret 2
end
for i ulong 64
if ne get o i 90
ret 3
end
end
put req 0 1
put req 1 1
put req 2 1
put req 7 1
for j ulong 4
put req add 3 j get a add 149 j
end
if ne kc_prepare p req 1
ret 4
end
if ne kc_commit p 0 1 1 0
ret 5
end
if ne moe_admit_wide view r view q view a edit p edit o edit lease 0
ret 6
end
if ne get lease 0 1
ret 7
end
if ne get o 56 0
ret 8
end
if ne get o 57 2
ret 8
end
if ne get o 60 14
ret 8
end
if ne kc_acquire p get lease 1 get lease 2 get lease 3 0
ret 9
end
if ne kc_retire p get lease 1 get lease 2 get lease 3 0
ret 10
end
if ne kc_unpin p get lease 1 get lease 2 get lease 3 0
ret 11
end
rc = mwc_wide edit r view q view a edit p edit o edit lease
if ne rc 0
ret rc
end
rc = mwc_tail edit r edit q edit a edit p edit o edit lease
ret rc
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Native driver for the ragged-K builder (cg_moe): builds specs through the unit's own entry cg_moe and compares the emitted
note instruction count with the count of the C-linked build (omega_fp8_gemv_ragged_prog_stats), so the pinned omc and the units.sh
note omc can be compared on the same source. Concatenate cg_moe_emit.om, cg_moe_core.om, cg_moe.om and this file. Exit 0 = all equal.
fn rp_check s view ulong 16 want ulong to ulong
b = new ulong 8192 0
m = new ulong 512 0
rc = cg_moe s edit b edit m
if ne rc 0
ret 1
end
if ne get m 0 want
ret 2
end
ret 0
end
fn rp_refused s view ulong 16 to ulong
b = new ulong 8192 0
m = new ulong 512 0
ret cg_moe s edit b edit m
end
fn main to int
a = new ulong 16 0
put a 0 640
put a 1 8
put a 2 1
put a 3 8
put a 10 1
if ne rp_check view a 119 0
ret 11
end
c = new ulong 16 0
put c 0 640
put c 1 16
put c 2 2
put c 3 4
put c 5 1
put c 6 1
put c 10 1
if ne rp_check view c 287 0
ret 12
end
d = new ulong 16 0
put d 0 2560
put d 1 16
put d 2 1
put d 3 8
put d 5 1
put d 10 1
if ne rp_check view d 153 0
ret 13
end
put a 10 0
if eq rp_refused view a 0
ret 14
end
ret 0
end

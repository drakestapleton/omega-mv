note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note moe_segs32 at wide capacity. Existing Seg32 exactly: weight VA,scale VA,row0 u32,
note count u32,reserved zero u64. Directory is 513 pairs (weight,scale) indexed by expert;
note the shared expert's index is the plan's shared_id (512 for 512 experts, 256 for 256).
note Call once for gate/up, once for down; no quant descriptor format is defined here.
fn mw_s64 out edit uchar 16416 p ulong v ulong to void
for b ulong 8
put out add p b uchar and shr v mul b 8 255
end
end
fn mw_dir dir view ulong 1026 e ulong to ulong
for k ulong 2
v = get dir add mul e 2 k
if or eq v 0 ne rem v 8 0
ret 3
end
end
ret 0
end
fn mw_svalid sg view ulong 2052 m view ulong 8 dir view ulong 1026 to ulong
if or gt get m 1 513 gt get m 0 1408
ret 1
end
pos = ulong 0
for z ulong get m 1
p = mul z 4
e = get sg p
if gt e 512
ret 2
end
if ne get sg add p 1 pos
ret 2
end
if eq get sg add p 2 0
ret 2
end
if gt get sg add p 2 get m 0
ret 2
end
pos = add pos get sg add p 2
if gt pos get m 0
ret 2
end
if ne mw_dir dir e 0
ret 3
end
end
if ne pos get m 0
ret 2
end
ret 0
end
fn mw_srow sg view ulong 2052 dir view ulong 1026 out edit uchar 16416 z ulong to void
p = mul z 32
e = get sg mul z 4
mw_s64 out p get dir mul e 2
mw_s64 out add p 8 get dir add mul e 2 1
v = get sg add mul z 4 1
cnt = get sg add mul z 4 2
v = or v shl cnt 32
mw_s64 out add p 16 v
mw_s64 out add p 24 0
end
fn moe_segs32_wide sg view ulong 2052 m view ulong 8 dir view ulong 1026 out edit uchar 16416 to ulong
rc = mw_svalid sg m dir
if ne rc 0
ret rc
end
for z ulong get m 1
mw_srow sg dir out z
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note errstr.om: nvmlErrorString for compat/nvml (CUDA++ NVML subset). Pure unit nvml_errstr.
note The text of every nvmlReturn_t value 0..30 follows the strings libnvidia-ml 580.173.02 returns
note (tests/nvml/errstr-oracle.tsv); every other value is "Unknown Error", as in libnvidia-ml.
note Each string is packed eight bytes per ulong, little-endian, so the unit stays under the bridge's
note 1024-constant limit. Packs: WolframLanguageEvaluator Map[FromDigits[Reverse[#],256]&,
note Partition[ToCharacterCode[s],UpTo[8]]] per string (evidence/NVML-2026-11-06/wolfram.txt).
note Result: the string length in bits 0..7 and the cache slot (0..30 the code, 31 Unknown) in bits 8..15;
note o receives the bytes, zero padded to 64.

fn w8 o edit uchar 64 at ulong v ulong to ulong
n = at
for i ulong 8
c = and shr v mul i 8 255
if ne c 0
put o n uchar c
n = add n 1
end
end
ret n
end

fn nvml_errstr code ulong o edit uchar 64 to ulong
for i ulong 64
put o i 0
end
n = ulong 0
k = ulong 31
if eq code 0
k = ulong 0
n = w8 o n 32496501618079059
ret or n shl k 8
end
if eq code 1
k = ulong 1
n = w8 o n 7019269490406420053
n = w8 o n 431199250796
ret or n shl k 8
end
if eq code 2

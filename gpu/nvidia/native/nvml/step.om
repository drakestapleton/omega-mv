note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note step.om: the exported nvml_step, after nvml.om and query.om. Ops in s 0: 1 nvmlInit_v2,
note 2 nvmlShutdown, 3 GetCount_v2, 4 GetHandleByIndex_v2, 5 GetName, 6 GetUUID, 7 GetTemperature,
note 8 GetMemoryInfo, 9 GetUtilizationRates, 10 GetComputeRunningProcesses_v3. A new call
note (resume point 0) clears the outputs. Result 0; an unknown op answers UNKNOWN (999).

fn nvml_step s edit ulong SN b edit uchar BN to ulong
if eq get s 22 0
put s 5 0
put s 6 0
put s 7 0
put s 27 0
end
op = get s 0
if eq op 1
init s b
ret 0
end
if eq op 2
shut s b
ret 0
end
if eq op 3
count s
ret 0
end
if eq op 4
handle s
ret 0
end
if eq op 5
name s b
ret 0
end
if eq op 6
uuid s b
ret 0
end
if eq op 7
temp s b
ret 0
end
if eq op 8
mem s b
ret 0
end
if eq op 9
util s b
ret 0
end
if eq op 10
procs s b
ret 0
end
done s 999
ret 0
end

note api.om: the CUDA++ libnvidia-ml subset as an omega-bridge cabi-1 library unit (omega-bridge#83).
note tools/bridge-seeded lib-c, lib-h and lib-map lower it to compat/nvml/libnvidia-ml.c, compat/nvml/nvml.h
note and compat/nvml/libnvidia-ml.map; tests/nvml/gate.om regenerates all three and compares them byte for byte.
note Types, values and prototypes follow CUDA 13.0 nvml.h (the 55 facts in tests/nvml/abi.om). The request
note protocol, RM construction and error text stay in nvml.om, query.om and errstr.om, imported below; this
note unit owns the protocol loop, the action dispatch to the #281 transport, the copy bounds and the string
note cache that compat/nvml/cudapp_nvml.c held in handwritten C.
note cabi library libnvidia-ml.so.1 header nvml.h
note cabi lock NvLock process mutex
note cabi status nvmlReturn_t nvmlReturn_enum int32 trap 999
note cabi value nvmlReturn_t NVML_SUCCESS 0
note cabi value nvmlReturn_t NVML_ERROR_UNINITIALIZED 1
note cabi value nvmlReturn_t NVML_ERROR_INVALID_ARGUMENT 2
note cabi value nvmlReturn_t NVML_ERROR_NOT_SUPPORTED 3
note cabi value nvmlReturn_t NVML_ERROR_NO_PERMISSION 4
note cabi value nvmlReturn_t NVML_ERROR_ALREADY_INITIALIZED 5
note cabi value nvmlReturn_t NVML_ERROR_NOT_FOUND 6
note cabi value nvmlReturn_t NVML_ERROR_INSUFFICIENT_SIZE 7
note cabi value nvmlReturn_t NVML_ERROR_INSUFFICIENT_POWER 8
note cabi value nvmlReturn_t NVML_ERROR_DRIVER_NOT_LOADED 9
note cabi value nvmlReturn_t NVML_ERROR_TIMEOUT 10
note cabi value nvmlReturn_t NVML_ERROR_IRQ_ISSUE 11
note cabi value nvmlReturn_t NVML_ERROR_LIBRARY_NOT_FOUND 12
note cabi value nvmlReturn_t NVML_ERROR_FUNCTION_NOT_FOUND 13
note cabi value nvmlReturn_t NVML_ERROR_CORRUPTED_INFOROM 14
note cabi value nvmlReturn_t NVML_ERROR_GPU_IS_LOST 15
note cabi value nvmlReturn_t NVML_ERROR_RESET_REQUIRED 16
note cabi value nvmlReturn_t NVML_ERROR_OPERATING_SYSTEM 17
note cabi value nvmlReturn_t NVML_ERROR_LIB_RM_VERSION_MISMATCH 18
note cabi value nvmlReturn_t NVML_ERROR_IN_USE 19
note cabi value nvmlReturn_t NVML_ERROR_MEMORY 20
note cabi value nvmlReturn_t NVML_ERROR_NO_DATA 21
note cabi value nvmlReturn_t NVML_ERROR_VGPU_ECC_NOT_SUPPORTED 22
note cabi value nvmlReturn_t NVML_ERROR_INSUFFICIENT_RESOURCES 23
note cabi value nvmlReturn_t NVML_ERROR_FREQ_NOT_SUPPORTED 24
note cabi value nvmlReturn_t NVML_ERROR_ARGUMENT_VERSION_MISMATCH 25
note cabi value nvmlReturn_t NVML_ERROR_DEPRECATED 26
note cabi value nvmlReturn_t NVML_ERROR_NOT_READY 27
note cabi value nvmlReturn_t NVML_ERROR_GPU_NOT_FOUND 28
note cabi value nvmlReturn_t NVML_ERROR_INVALID_STATE 29
note cabi value nvmlReturn_t NVML_ERROR_RESET_TYPE_NOT_SUPPORTED 30
note cabi value nvmlReturn_t NVML_ERROR_UNKNOWN 999
note cabi enum nvmlTemperatureSensors_t nvmlTemperatureSensors_enum uint32
note cabi value nvmlTemperatureSensors_t NVML_TEMPERATURE_GPU 0
note cabi value nvmlTemperatureSensors_t NVML_TEMPERATURE_COUNT 1
note cabi define NVML_VALUE_NOT_AVAILABLE (-1)
note cabi define NVML_DEVICE_UUID_BUFFER_SIZE 80
note cabi define NVML_DEVICE_UUID_V2_BUFFER_SIZE 96
note cabi define NVML_DEVICE_NAME_BUFFER_SIZE 64
note cabi define NVML_DEVICE_NAME_V2_BUFFER_SIZE 96
note cabi aliasguard NVML_NO_UNVERSIONED_FUNC_DEFS
note cabi alias nvmlInit nvmlInit_v2
note cabi alias nvmlDeviceGetCount nvmlDeviceGetCount_v2
note cabi alias nvmlDeviceGetHandleByIndex nvmlDeviceGetHandleByIndex_v2
note cabi alias nvmlDeviceGetComputeRunningProcesses nvmlDeviceGetComputeRunningProcesses_v3
note cabi handle nvmlDevice_t nvmlDevice_st pool NvDevs count 8 lock NvLock
note cabi record nvmlUtilization_t nvmlUtilization_st size 8 align 4
note cabi field nvmlUtilization_t gpu uint32 0
note cabi field nvmlUtilization_t memory uint32 4
note cabi record nvmlMemory_t nvmlMemory_st size 24 align 8
note cabi field nvmlMemory_t total uint64 0
note cabi field nvmlMemory_t free uint64 8
note cabi field nvmlMemory_t used uint64 16
note cabi record nvmlProcessInfo_v2_t nvmlProcessInfo_v2_st size 24 align 8 alias nvmlProcessInfo_t
note cabi field nvmlProcessInfo_v2_t pid uint32 0
note cabi field nvmlProcessInfo_v2_t usedGpuMemory uint64 8
note cabi field nvmlProcessInfo_v2_t gpuInstanceId uint32 16
note cabi field nvmlProcessInfo_v2_t computeInstanceId uint32 20
note State: NvS the 128-word step state, NvB the step buffer (request at 0, payload at 4608, output at 60496),
note NvR the import result word, NvT the 32 cached error strings of 64 bytes, NvO the errstr scratch (0..63)
note and the per-slot cache flags (64..95).
note cabi state NvS ulong 128 process lock NvLock
note cabi state NvB uchar 83296 process lock NvLock
note cabi state NvR ulong 1 process lock NvLock
note cabi state NvT uchar 2048 process lock NvLock
note cabi state NvO uchar 96 process lock NvLock
note cabi cstr NvT slots 32 width 64 fallback "Unknown Error" lock NvLock
note cabi export nvmlInit_v2 nv_init status nvmlReturn_t lock NvLock
note cabi bind nvmlInit_v2 s NvS
note cabi bind nvmlInit_v2 b NvB
note cabi bind nvmlInit_v2 r NvR
note cabi export nvmlShutdown nv_shut status nvmlReturn_t lock NvLock
note cabi bind nvmlShutdown s NvS
note cabi bind nvmlShutdown b NvB
note cabi bind nvmlShutdown r NvR
note cabi export nvmlErrorString nv_err cstr NvT lock NvLock
note cabi bind nvmlErrorString t NvT
note cabi bind nvmlErrorString o NvO
note cabi bind nvmlErrorString r NvR
note cabi arg nvmlErrorString result nvmlReturn_t
note cabi export nvmlDeviceGetCount_v2 nv_count status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetCount_v2 s NvS
note cabi bind nvmlDeviceGetCount_v2 b NvB
note cabi bind nvmlDeviceGetCount_v2 r NvR
note cabi arg nvmlDeviceGetCount_v2 deviceCount nullable out uint32 commit 0
note cabi export nvmlDeviceGetHandleByIndex_v2 nv_handle status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetHandleByIndex_v2 s NvS
note cabi bind nvmlDeviceGetHandleByIndex_v2 b NvB
note cabi bind nvmlDeviceGetHandleByIndex_v2 r NvR
note cabi arg nvmlDeviceGetHandleByIndex_v2 index uint32
note cabi arg nvmlDeviceGetHandleByIndex_v2 device nullable out nvmlDevice_t commit 0
note cabi export nvmlDeviceGetName nv_name status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetName s NvS
note cabi bind nvmlDeviceGetName b NvB
note cabi bind nvmlDeviceGetName r NvR
note cabi arg nvmlDeviceGetName device nvmlDevice_t
note cabi arg nvmlDeviceGetName name nullable out char length length commit 0 data NvB 60496
note cabi arg nvmlDeviceGetName length uint32
note cabi export nvmlDeviceGetUUID nv_uuid status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetUUID s NvS
note cabi bind nvmlDeviceGetUUID b NvB
note cabi bind nvmlDeviceGetUUID r NvR
note cabi arg nvmlDeviceGetUUID device nvmlDevice_t
note cabi arg nvmlDeviceGetUUID uuid nullable out char length length commit 0 data NvB 60496
note cabi arg nvmlDeviceGetUUID length uint32
note cabi export nvmlDeviceGetTemperature nv_temp status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetTemperature s NvS
note cabi bind nvmlDeviceGetTemperature b NvB
note cabi bind nvmlDeviceGetTemperature r NvR
note cabi arg nvmlDeviceGetTemperature device nvmlDevice_t
note cabi arg nvmlDeviceGetTemperature sensorType nvmlTemperatureSensors_t
note cabi arg nvmlDeviceGetTemperature temp nullable out uint32 commit 0
note cabi export nvmlDeviceGetMemoryInfo nv_mem status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetMemoryInfo s NvS
note cabi bind nvmlDeviceGetMemoryInfo b NvB
note cabi bind nvmlDeviceGetMemoryInfo r NvR
note cabi arg nvmlDeviceGetMemoryInfo device nvmlDevice_t
note cabi arg nvmlDeviceGetMemoryInfo memory nullable out nvmlMemory_t commit 0 data NvB 60496
note cabi export nvmlDeviceGetUtilizationRates nv_util status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetUtilizationRates s NvS
note cabi bind nvmlDeviceGetUtilizationRates b NvB
note cabi bind nvmlDeviceGetUtilizationRates r NvR
note cabi arg nvmlDeviceGetUtilizationRates device nvmlDevice_t
note cabi arg nvmlDeviceGetUtilizationRates utilization nullable out nvmlUtilization_t commit 0 data NvB 60496
note cabi export nvmlDeviceGetComputeRunningProcesses_v3 nv_procs status nvmlReturn_t lock NvLock
note cabi bind nvmlDeviceGetComputeRunningProcesses_v3 s NvS
note cabi bind nvmlDeviceGetComputeRunningProcesses_v3 b NvB
note cabi bind nvmlDeviceGetComputeRunningProcesses_v3 r NvR
note cabi arg nvmlDeviceGetComputeRunningProcesses_v3 device nvmlDevice_t
note cabi arg nvmlDeviceGetComputeRunningProcesses_v3 infoCount nullable inout uint32 commit 1
note cabi arg nvmlDeviceGetComputeRunningProcesses_v3 infos nullable out nvmlProcessInfo_v2_t count infoCount commit 2 data NvB 60496
note cabi import nv_step omega_nvml_step result r span s 0 sn span b 0 bn
note cabi import nv_errs omega_nvml_errstr result r value code span o 0 on
note cabi import nv_ioctl omega2_nvrm_ioctl result r value fd value nr span b 0 hl span b 4608 pl
note cabi import nv_open omega2_nvrm_open_file result r span b 4608 pn
note cabi import nv_close omega2_nvrm_close_file result r value fd

note Import stubs: the bridge replaces each body with a checked call to the named C symbol.
fn nv_step r edit ulong 1 s edit ulong 128 sn ulong b edit uchar 83296 bn ulong to ulong
ret 0
end

fn nv_errs r edit ulong 1 code ulong o edit uchar 96 on ulong to ulong
ret 0
end

fn nv_ioctl r edit ulong 1 fd ulong nr ulong b edit uchar 83296 hl ulong pl ulong to ulong
ret 0
end

fn nv_open r edit ulong 1 b edit uchar 83296 pn ulong to ulong
ret 0
end

fn nv_close r edit ulong 1 fd ulong to ulong
ret 0
end

note nv_set: the operation and its four arguments in s[0..4].
fn nv_set s edit ulong 128 op ulong a1 ulong a2 ulong a3 ulong a4 ulong to void
put s 0 op
put s 1 a1
put s 2 a2
put s 3 a3
put s 4 a4
end

note nv_act: perform the action the step requested (1 ioctl, 2 open, 3 close) and record the result in
note s[14] and the transport status in s[15]; 0 is a malformed request.
fn nv_act s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
k = get s 8
put r 0 0
st = ulong 0
if or eq k 0 gt k 3
ret 0
end
if eq k 1
hl = get s 11
pl = get s 12
if or gt hl 4608 gt pl 55888
ret 0
end
st = nv_ioctl r get s 9 get s 10 b hl pl
end
if eq k 2
pn = get s 13
if or eq pn 0 gt pn 55888
ret 0
end
st = nv_open r b pn
end
if eq k 3
st = nv_close r get s 9
end
put s 14 get r 0
put s 15 st
ret 1
end

note nv_run: step until the unit reports done (1) or the protocol fails (0), at most 4096 steps.
fn nv_run s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ok = ulong 0
put s 22 0
for n ulong 4096
put r 0 1
c = nv_step r s 128 b 83296
if or ne c 0 ne get r 0 0
break
end
if eq get s 8 0
ok = 1
break
end
if eq nv_act s b r 0
break
end
end
put s 22 0
ret ok
end

note nv_fin: the copy bounds: at most cap output bytes, output only with a destination, a scalar only
note with a destination and below 2^32. 1 accepts the step's result.
fn nv_fin s edit ulong 128 cap ulong out ulong scl ulong to ulong
n = get s 7
if gt n cap
ret 0
end
if and ne n 0 eq out 0
ret 0
end
if ne get s 27 0
if or eq scl 0 gt get s 5 4294967295
ret 0
end
end
ret 1
end

note nv_code: the step's status when it is an nvmlReturn_t value, else NVML_ERROR_UNKNOWN.
fn nv_code s edit ulong 128 to ulong
v = get s 6
if or le v 30 eq v 999
ret v
end
ret 999
end

note nv_bare: Init and Shutdown.
fn nv_bare fr edit ulong 2 s edit ulong 128 b edit uchar 83296 r edit ulong 1 op ulong to ulong
nv_set s op 0 0 0 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s 0 0 0 0
ret 0
end
put fr 0 nv_code s
ret 0
end

fn nv_init fr edit ulong 2 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_bare fr s b r 1
end

fn nv_shut fr edit ulong 2 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_bare fr s b r 2
end

note Count: f2 deviceCount present, f3 the count.
fn nv_count fr edit ulong 4 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
p = get fr 2
nv_set s 3 0 p 0 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s 0 0 p 0
ret 0
end
if ne get s 27 0
put fr 3 get s 5
put fr 1 1
end
put fr 0 nv_code s
ret 0
end

note HandleByIndex: f2 index, f3 device present, f4 the handle index (below the pool of 8).
fn nv_handle fr edit ulong 5 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
nv_set s 4 get fr 2 get fr 3 0 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s 0 0 1 0
ret 0
end
c = nv_code s
if eq c 0
v = ulong 0
if ne get s 27 0
v = get s 5
end
if ge v 8
ret 0
end
if ne get fr 3 0
put fr 4 v
put fr 1 1
end
end
put fr 0 c
ret 0
end

note Name and UUID: f2 device, f3 buffer present, f4 bytes written (with the NUL), f5 length.
fn nv_str fr edit ulong 6 s edit ulong 128 b edit uchar 83296 r edit ulong 1 op ulong to ulong
nv_set s op get fr 2 get fr 3 get fr 5 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s get fr 5 get fr 3 0 0
ret 0
end
n = get s 7
if ne n 0
put fr 4 n
put fr 1 1
end
put fr 0 nv_code s
ret 0
end

fn nv_name fr edit ulong 6 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_str fr s b r 5
end

fn nv_uuid fr edit ulong 6 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_str fr s b r 6
end

note Temperature: f2 device, f3 sensor, f4 temp present, f5 the temperature.
fn nv_temp fr edit ulong 6 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
p = get fr 4
nv_set s 7 get fr 2 p get fr 3 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s 0 0 p 0
ret 0
end
if ne get s 27 0
put fr 5 get s 5
put fr 1 1
end
put fr 0 nv_code s
ret 0
end

note Memory (24 bytes) and utilization (8 bytes): f2 device, f3 record present.
fn nv_rec fr edit ulong 4 s edit ulong 128 b edit uchar 83296 r edit ulong 1 op ulong sz ulong to ulong
nv_set s op get fr 2 get fr 3 0 0
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s sz get fr 3 0 0
ret 0
end
n = get s 7
if ne n 0
if ne n sz
ret 0
end
put fr 1 1
end
put fr 0 nv_code s
ret 0
end

fn nv_mem fr edit ulong 4 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_rec fr s b r 8 24
end

fn nv_util fr edit ulong 4 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
ret nv_rec fr s b r 9 8
end

note Processes: f2 device, f3 infoCount present, f4 *infoCount, f5 infos present, f6 records written;
note the capacity is 24 bytes per requested entry.
fn nv_procs fr edit ulong 7 s edit ulong 128 b edit uchar 83296 r edit ulong 1 to ulong
p = get fr 3
w = ulong 0
if ne p 0
w = get fr 4
end
nv_set s 10 get fr 2 p w get fr 5
if eq nv_run s b r 0
ret 0
end
if eq nv_fin s mul w 24 get fr 5 p 0
ret 0
end
m = ulong 0
n = get s 7
if ne n 0
if ne rem n 24 0
ret 0
end
put fr 6 div n 24
m = 4
end
if ne get s 27 0
put fr 4 get s 5
m = add m 2
end
put fr 1 m
put fr 0 nv_code s
ret 0
end

note ErrorString: f0 the cache slot (32 selects the fallback), f1 the length, f2 the code. Each slot is
note filled once, so a returned pointer stays valid and unchanged for the life of the process.
fn nv_err fr edit ulong 3 t edit uchar 2048 o edit uchar 96 r edit ulong 1 to ulong
put fr 0 32
put fr 1 0
put r 0 0
c = nv_errs r get fr 2 o 64
if ne c 0
ret 0
end
v = get r 0
n = and v 255
k = and shr v 8 255
if or ge n 64 ge k 32
ret 0
end
z = mul k 64
if eq ulong get o add 64 k 0
for j ulong 64
put t add z j get o j
end
put t add z n uchar 0
put o add 64 k uchar 1
end
m = ulong 64
for i ulong 64
if and eq m 64 eq ulong get t add z i 0
m = i
end
end
if ge m 64
ret 0
end
put fr 0 k
put fr 1 m
ret 0
end

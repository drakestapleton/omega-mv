note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note query.om: the device queries of compat/nvml, after nvml.om. Every query first checks, in order:
note a live library (else UNINITIALIZED 1), the GPU index s 1 below the count and a non-null output
note s 2 (else INVALID_ARGUMENT 2), as nvml.h:4432-4443 and its siblings document.

fn pre s edit ulong SN to ulong
if eq get s 17 0
ret 1
end
if ge get s 1 get s 21
ret 2
end
if eq get s 2 0
ret 2
end
ret 0
end

fn hsub s edit ulong SN to ulong
ret get s dv get s 1 5
end

fn scal s edit ulong SN v ulong to void
put s 5 v
put s 27 1
end

note nvmlDeviceGetCount_v2 (nvml.h:4221) and nvmlDeviceGetHandleByIndex_v2 (nvml.h:4289).
fn count s edit ulong SN to void
if eq get s 17 0
done s 1
ret
end
if eq get s 2 0
done s 2
ret
end
scal s get s 21
done s 0
end

fn handle s edit ulong SN to void
e = pre s
if ne e 0
done s e
ret
end
scal s get s 1
done s 0
end

note nvmlDeviceGetName (nvml.h:4432): NV2080_CTRL_CMD_GPU_GET_NAME_STRING (0x20800110,
note ctrl2080gpu.h:318), 132-byte params, flags 0 (ASCII) at 0, the name at 4. The name must be
note printable ASCII of 1..95 bytes ended by a zero within its 128 bytes. A length s 3 below the name
note plus its terminator is INSUFFICIENT_SIZE (7).
fn name s edit ulong SN b edit uchar BN to void
if eq get s 22 0
e = pre s
if ne e 0
done s e
ret
end
bzero b PO 132
ctl s b hsub s 545259792 132
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
if ne g32 b PO 0
done s 999
ret
end
n = ulong 0
z = false
for i ulong 128
c = get b add add PO 4 i
if not z
if eq c 0
z = true
n = i
else
if or lt c 32 gt c 126
done s 999
ret
end
end
end
end
if or not z or eq n 0 gt n 95
done s 999
ret
end
if lt get s 3 add n 1
done s 7
ret
end
for i ulong n
put b add OO i get b add add PO 4 i
end
put b add OO n 0
put s 7 add n 1
done s 0
end

fn hexc d ulong to uchar
if lt d 10
ret uchar add 48 d
end
ret uchar add 87 d
end

note nvmlDeviceGetUUID (nvml.h:4816): NV2080_CTRL_CMD_GPU_GET_GID_INFO (0x2080014a,
note ctrl2080gpu.h:1775-1798), 268-byte params: index 0, flags 4 = 2 (BINARY, SHA1), length 8 = 16,
note data 12. Printed as nvidia-smi does: GPU- then 8-4-4-4-12 lower-case hex, 40 bytes plus a zero.
fn uuid s edit ulong SN b edit uchar BN to void
if eq get s 22 0
e = pre s
if ne e 0
done s e
ret
end
bzero b PO 268
p32 b add PO 4 2
ctl s b hsub s 545259850 268
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
if ne g32 b add PO 8 16
done s 999
ret
end
if lt get s 3 41
done s 7
ret
end
put b OO 71
put b add OO 1 80
put b add OO 2 85
put b add OO 3 45
n = add OO 4
for i ulong 16
if or or eq i 4 eq i 6 or eq i 8 eq i 10
put b n 45
n = add n 1
end
v = ulong get b add add PO 12 i
put b n hexc shr v 4
put b add n 1 hexc and v 15
n = add n 2
end
put b n 0
put s 7 41
done s 0
end

note Thermal instructions (NV2080_CTRL_CMD_THERMAL_SYSTEM_EXECUTE_V2 0x20800513, ctrl2080thermal.h:135),
note 1432-byte params: API version 1 at 0, instruction size 44 at 8, count at 20, 32 instructions
note from 24, opcode at +8, operands at +12 and +16, executed flag +4 and result +0.
fn thins b edit uchar BN k ulong op ulong a ulong to void
o = add add PO 24 mul k 44
p32 b add o 8 op
p32 b add o 12 a
end

fn thgo s edit ulong SN b edit uchar BN n ulong to void
p32 b PO 1
p32 b add PO 8 44
p32 b add PO 20 n
ctl s b hsub s 545260819 1432
end

fn thok b edit uchar BN n ulong to bool
for k ulong n
o = add add PO 24 mul k 44
if or ne g32 b add o 4 1 ne g32 b o 0
ret false
end
end
ret true
end

fn thread s edit ulong SN b edit uchar BN to void
nt = get s 25
ns = get s 26
for k ulong ns
q = add nt mul k 2
tg = g32 b add add add PO 24 mul q 44 16
if ge tg nt
done s 999
ret
end
if eq g32 b add add add PO 24 mul tg 44 16 1
v = g32 b add add add PO 24 mul add q 1 44 16
if ge v 2147483648
done s 999
ret
end
scal s v
done s 0
ret
end
end
done s 3
end

note nvmlDeviceGetTemperature (nvml.h:5571), sensor s 3 must be NVML_TEMPERATURE_GPU (0, nvml.h:936).
note Pass 1 counts targets (opcode 256) and sensors (1280); pass 2 asks each target's type (257) and
note each sensor's target (1312) and reading (5376). The first sensor on a GPU-type (1) target
note answers; none is NOT_SUPPORTED (3). More than 32 instructions or a negative reading is UNKNOWN.
fn temp s edit ulong SN b edit uchar BN to void
pc = get s 22
if eq pc 0
e = pre s
if ne e 0
done s e
ret
end
if ne get s 3 0
done s 2
ret
end
bzero b PO 1432
thins b 0 256 0
thins b 1 1280 0
thgo s b 2
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
if eq pc 2
if not thok b add get s 25 mul get s 26 2
done s 999
ret
end
thread s b
ret
end
if not thok b 2
done s 999
ret
end
nt = g32 b add PO 36
ns = g32 b add PO 80
if gt add nt mul ns 2 32
done s 999
ret
end
if eq ns 0
done s 3
ret
end
put s 25 nt
put s 26 ns
bzero b PO 1432
for t ulong nt
thins b t 257 t
end
for k ulong ns
thins b add nt mul k 2 1312 k
thins b add add nt mul k 2 1 5376 k
end
thgo s b add nt mul ns 2
put s 22 2
end

note nvmlDeviceGetMemoryInfo (nvml.h:6330): NV2080_CTRL_CMD_FB_GET_INFO_V2 (0x20801303,
note ctrl2080fb.h:459), 1028-byte params: count 0, then {index, data} pairs from 4. Asks IS_ZERO_FB
note (0x36), TOTAL_RAM_SIZE (0x08) and HEAP_FREE (0x16), both in KiB (ctrl2080fb.h:310,328,360). A GPU
note without framebuffer is NOT_SUPPORTED (nvml.h:6352-6354). Output nvmlMemory_t {total, free, used}.
fn mem s edit ulong SN b edit uchar BN to void
if eq get s 22 0
e = pre s
if ne e 0
done s e
ret
end
bzero b PO 1028
p32 b PO 3
p32 b add PO 4 54
p32 b add PO 12 8
p32 b add PO 20 22
ctl s b hsub s 545264387 1028
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
if or or ne g32 b add PO 4 54 ne g32 b add PO 12 8 ne g32 b add PO 20 22
done s 999
ret
end
if ne g32 b add PO 8 0
done s 3
ret
end
t = g32 b add PO 16
f = g32 b add PO 24
if gt f t
done s 999
ret
end
p64 b OO mul t 1024
p64 b add OO 8 mul f 1024
p64 b add OO 16 mul sub t f 1024
put s 7 24
done s 0
end

note nvmlDeviceGetUtilizationRates (nvml.h:6671): the newest PERFMON sample as in native/smi/util.om,
note NV2080_CTRL_CMD_PERF_GET_GPUMON_PERFMON_UTIL_SAMPLES_V2 (0x20802096, ctrl2080perf.h:447-592),
note 55888-byte params: type 2 at 0, bufSize 55872 at 4, count 8, tracker 12, 72 samples of 776 from
note 16; newest at (tracker+71) mod 72, fb.util +8, gr.util +136 in percent*100. An empty ring or a
note malformed reply is UNKNOWN (999). Output nvmlUtilization_t {gpu, memory} in percent.
fn util s edit ulong SN b edit uchar BN to void
if eq get s 22 0
e = pre s
if ne e 0
done s e
ret
end
bzero b PO 55888
put b PO 2
p32 b add PO 4 55872
ctl s b hsub s 545267862 55888
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
c = g32 b add PO 8
r = g32 b add PO 12
if or gt c 72 ge r 72
done s 999
ret
end
o = add add PO 16 mul rem add r 71 72 776
if or eq c 0 eq g64 b o 0
done s 999
ret
end
g = g32 b add o 136
m = g32 b add o 8
if or gt g 10000 gt m 10000
done s 999
ret
end
p32 b OO div g 100
p32 b add OO 4 div m 100
put s 7 8
done s 0
end

note One NV2080_CTRL_CMD_GPU_GET_PID_INFO (0x2080018e, ctrl2080gpu.h:3590-3666) chunk of at most 200
note PIDs from s 23: count at 0, 72-byte entries from 8: pid 0, index 4 = 0 (VIDEO_MEMORY_USAGE),
note result 8, memPrivate 16.
fn pchunk s edit ulong SN b edit uchar BN to void
k = get s 23
m = sub get s 25 k
if gt m 200
m = 200
end
bzero b PO 14408
p32 b PO m
for i ulong m
p32 b add add PO 8 mul i 72 g32 b add OO mul add k i 24
end
put s 26 m
ctl s b hsub s 545259918 14408
put s 22 2
end

fn pdone s edit ulong SN b edit uchar BN to void
e = chk s b 28
if ne e 0
done s e
ret
end
k = get s 23
for i ulong get s 26
o = add add PO 8 mul i 72
q = add OO mul add k i 24
if ne g32 b o g32 b q
done s 999
ret
end
if ne g32 b add o 8 0
p64 b add q 8 18446744073709551615
else
p64 b add q 8 g64 b add o 16
end
end
k = add k get s 26
put s 23 k
if lt k get s 25
pchunk s b
ret
end
scal s k
put s 7 mul k 24
done s 0
end

note nvmlDeviceGetComputeRunningProcesses_v3 (nvml.h:6944-6985): s 2 infoCount non-null, s 3 its
note value, s 4 infos non-null (may be null only when s 3 is 0). NV2080_CTRL_CMD_GPU_GET_PIDS
note (0x2080018d, ctrl2080gpu.h:3521-3540), 3812-byte params: idType 0 (CLASS), id 4 = the compute
note class, count 8 (at most 950), pids from 12. More PIDs than s 3 is INSUFFICIENT_SIZE with the
note count stored. Output nvmlProcessInfo_t {pid 0, usedGpuMemory 8, gpuInstanceId 16,
note computeInstanceId 20} (nvml.h:301-312), ids 0xFFFFFFFF without MIG; a failed PID entry reports
note usedGpuMemory NVML_VALUE_NOT_AVAILABLE (nvml.h:155).
fn procs s edit ulong SN b edit uchar BN to void
pc = get s 22
if eq pc 2
pdone s b
ret
end
if eq pc 0
e = pre s
if ne e 0
done s e
ret
end
if and eq get s 4 0 ne get s 3 0
done s 2
ret
end
c = get s dv get s 1 6
if eq c 0
done s 3
ret
end
bzero b PO 3812
p32 b add PO 4 c
ctl s b hsub s 545259917 3812
put s 22 1
ret
end
e = chk s b 28
if ne e 0
done s e
ret
end
n = g32 b add PO 8
if gt n 950
done s 999
ret
end
if gt n get s 3
scal s n
done s 7
ret
end
if eq n 0
scal s 0
done s 0
ret
end
for i ulong n
q = add OO mul i 24
p32 b q g32 b add add PO 12 mul i 4
p64 b add q 8 0
p32 b add q 16 4294967295
p32 b add q 20 4294967295
end
put s 25 n
put s 23 0
pchunk s b
end

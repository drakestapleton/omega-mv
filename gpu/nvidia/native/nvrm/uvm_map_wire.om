note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One GPU UVM_MAP_EXTERNAL_ALLOCATION, pinned ABI580.173.02 uvm_ioctl.h.
fn nvrm_uvm_map_store b edit uchar 9264 off ulong v ulong n ulong to void
for i ulong n
put b add off i uchar and shr v mul i 8 255
end
end
fn nvrm_uvm_map_wire a view ulong 16 uuid view uchar 16 b edit uchar 9264 to ulong
for i ulong 9264
put b i 0
end
nvrm_uvm_map_store b 0 get a 0 8
nvrm_uvm_map_store b 8 get a 1 8
nvrm_uvm_map_store b 16 get a 2 8
for i ulong 16
put b add 24 i get uuid i
end
nvrm_uvm_map_store b 40 get a 7 4
nvrm_uvm_map_store b 9240 get a 3 8
nvrm_uvm_map_store b 9248 get a 4 4
nvrm_uvm_map_store b 9252 get a 5 4
nvrm_uvm_map_store b 9256 get a 6 4
ret 9264
end

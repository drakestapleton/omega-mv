note NVIDIA580.173.02 nvos.h NVOS00/21/33/46/47/54 and Unix NVOS33 fd wrapper.
note Scalars are ordered exactly as fields in the vendor declaration, excluding padding.
note No native struct representation is used. All padding and initial status bytes are zero.
fn nvrm_wire_store b edit uchar 64 off ulong v ulong n ulong to void
for i ulong n
put b add off i uchar and shr v mul i 8 255
end
end
fn nvrm_pack op ulong a view ulong 16 b edit uchar 64 to ulong
for i ulong 64
put b i 0
end
if or eq op 1 eq op 2
for i ulong 4
nvrm_wire_store b mul i 4 get a i 4
end
nvrm_wire_store b 16 get a 4 8
nvrm_wire_store b 24 get a 5 4
ret 32
end
if eq op 3
for i ulong 3
nvrm_wire_store b mul i 4 get a i 4
end
ret 16
end
if eq op 4
for i ulong 3
nvrm_wire_store b mul i 4 get a i 4
end
for i ulong 3
nvrm_wire_store b add 16 mul i 8 get a add i 3 8
end
nvrm_wire_store b 44 get a 6 4
nvrm_wire_store b 48 get a 7 4
ret 56
end
if eq op 5
for i ulong 4
nvrm_wire_store b mul i 4 get a i 4
end
nvrm_wire_store b 16 get a 4 8
nvrm_wire_store b 24 get a 5 8
for i ulong 3
nvrm_wire_store b add 32 mul i 4 get a add i 6 4
end
nvrm_wire_store b 48 get a 9 8
ret 64
end
if eq op 6
for i ulong 5
nvrm_wire_store b mul i 4 get a i 4
end
nvrm_wire_store b 24 get a 5 8
nvrm_wire_store b 32 get a 6 8
ret 48
end
if eq op 7
nvrm_wire_store b 0 get a 0 4
ret 4
end
ret 0
end
fn nvrm_wire_load b view uchar 64 off ulong n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl ulong get b add off i mul i 8
end
ret v
end
fn nvrm_wire_reply op ulong b view uchar 64 r edit ulong 2 to ulong
at = ulong 0
if or eq op 1 eq op 2
at = 28
else
if eq op 3
at = 12
else
if eq op 4
at = 40
else
if eq op 5
at = 56
else
if eq op 6
at = 40
else
ret 1
end
end
end
end
end
put r 0 nvrm_wire_load b at 4
put r 1 0
if eq op 1
put r 1 nvrm_wire_load b 8 4
end
if eq op 4
put r 1 nvrm_wire_load b 32 8
end
if eq op 5
put r 1 nvrm_wire_load b 48 8
end
ret 0
end

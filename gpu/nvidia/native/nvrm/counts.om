om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note sscanf decimal unsigned contract: optional sign, saturating overflow, prefix digits.
fn nc_space c uchar to bool
ret or eq c 32 and ge c 9 le c 13
end
fn nc_number b view uchar * pos ulong dst edit ulong 2 to bool
i = pos
while lt i len b bound 512
if not nc_space get b i
break
end
i = add i 1
end
minus = false
if lt i len b
if or eq get b i 43 eq get b i 45
minus = eq get b i 45
i = add i 1
end
end
start = i
v = ulong 0
ov = false
while lt i len b bound 512
c = get b i
if or lt c 48 gt c 57
break
end
d = ulong sub c 48
if gt v div sub ulong 18446744073709551615 d 10
ov = true
end
if not ov
v = add mul v 10 d
end
i = add i 1
end
if eq i start
ret false
end
if ov
v = ulong 18446744073709551615
else
if minus
v = sub ulong 0 v
end
end
put dst 0 v
put dst 1 i
ret true
end
fn nc_mem b view uchar * key view uchar * state edit ulong 2 to ulong
dst = new ulong 2 0
if le len b len key
ret 0
end
for i ulong len key
if ne get b i get key i
ret 0
end
end
if ne get b len key 58
ret 0
end
put state 1 0
ok = nc_number b add len key 1 dst
if ok
put state 1 get dst 0
end
ret 1
end
fn nc_buddy b view uchar * state edit ulong 2 to ulong
dst = new ulong 2 0
p = ulong 0
found = false
while le add p 4 len b bound 512
if eq get b p 122
if and eq get b add p 1 111 eq get b add p 2 110
if eq get b add p 3 101
found = true
break
end
end
end
p = add p 1
end
if not found
ret 0
end
p = add p 4
while lt p len b bound 512
if ne get b p 32
break
end
p = add p 1
end
while lt p len b bound 512
if or eq get b p 0 eq get b p 32
break
end
p = add p 1
end
total = ulong 0
for o ulong 32
ok = nc_number b p dst
if not ok
break
end
if ge o get state 0
total = add total get dst 0
end
while lt p len b bound 512
if ne get b p 32
break
end
p = add p 1
end
while lt p len b bound 512
if or eq get b p 0 eq get b p 32
break
end
p = add p 1
end
end
put state 1 add get state 1 total
ret 0
end
fn nvrm_counts mode ulong b view uchar * key view uchar * state edit ulong 2 to ulong
if eq mode 0
ret nc_mem b key state
end
ret nc_buddy b state
end

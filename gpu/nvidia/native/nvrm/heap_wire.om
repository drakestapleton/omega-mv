note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note NVOS32_PARAMETERS heap information, vendored nvos.h; sizeof184, data.Info.attr40.
fn nvrm_heap_wire a view ulong 16 b edit uchar 184 to ulong
for i ulong 184
put b i 0
end
for i ulong 4
v = get a i
off = mul i 4
if eq i 3
off = 40
end
for j ulong 4
put b add off j uchar and shr v mul j 8 255
end
end
ret 184
end

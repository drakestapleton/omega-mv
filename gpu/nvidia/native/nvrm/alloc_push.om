note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Composed with the existing amp_runtime policy, not a second admission convention.
fn nvrm_alloc_push w view uint * to ulong
m = new ulong 16 0
q = new ulong 64 0
put m 0 4
put m 5 51136
put m 6 692
put m 7 704
put m 8 92
put m 9 40
put m 10 540
put m 11 4113
i = ulong 0
note At most floor(2097151/2) packets; two literal chunks avoid the implicit million-step guard.
for chunk ulong 2
for step ulong 999999
if ge i len w
ret 0
end
h = get w i
i = add i 1
cnt = and shr h 16 8191
if or ne shr h 28 2 eq cnt 0
ret 1
end
if gt ulong cnt sub len w i
ret 1
end
put m 1 shl ulong and h 8191 2
put m 2 ulong cnt
put m 3 ulong and shr h 13 7
put m 4 ulong get w i
if eq amp_runtime m q 0
ret 2
end
i = add i ulong cnt
end
end
ret 1
end

om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shared byte bodies for legacy fixed exports and exact-sized struct views.
fn nv_ustor b edit uchar * off ulong v ulong n ulong to void
for i ulong n
put b add off i uchar and shr v mul i 8 255
end
end
fn nv_ubody cmd ulong a view ulong 16 uuid view uchar 16 b edit uchar * to ulong
for i ulong len b
put b i 0
end
if eq cmd 805306369
nv_ustor b 0 get a 0 8
ret 16
end
if eq cmd 75
nv_ustor b 0 get a 0 4
ret 8
end
if or eq cmd 34 eq cmd 73
nv_ustor b 0 get a 0 8
nv_ustor b 8 get a 1 8
ret 24
end
for i ulong 16
put b i get uuid i
end
if or eq cmd 26 eq cmd 38
ret 20
end
if eq cmd 37
nv_ustor b 24 get a 0 4
nv_ustor b 28 get a 1 4
nv_ustor b 32 get a 2 4
ret 40
end
if eq cmd 25
nv_ustor b 16 get a 0 4
nv_ustor b 20 get a 1 4
nv_ustor b 24 get a 2 4
ret 32
end
if eq cmd 27
nv_ustor b 16 get a 0 4
nv_ustor b 20 get a 1 4
nv_ustor b 24 get a 2 4
nv_ustor b 32 get a 3 8
nv_ustor b 40 get a 4 8
ret 56
end
if eq cmd 28
nv_ustor b 16 get a 0 4
nv_ustor b 20 get a 1 4
ret 28
end
ret 0
end
fn nv_umap a view ulong 16 uuid view uchar 16 b edit uchar * to ulong
for i ulong len b
put b i 0
end
nv_ustor b 0 get a 0 8
nv_ustor b 8 get a 1 8
nv_ustor b 16 get a 2 8
for i ulong 16
put b add 24 i get uuid i
end
nv_ustor b 40 get a 7 4
nv_ustor b 9240 get a 3 8
nv_ustor b 9248 get a 4 4
nv_ustor b 9252 get a 5 4
nv_ustor b 9256 get a 6 4
ret 9264
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Native range layout is pairs of uint64 va,size; state=count,next,size,align-or-release-va.
note Host shell owns slot-cover atomic; next is committed only after that effect succeeds.
fn na_erase a edit ulong * n ulong i ulong to void
j = i
while lt add j 1 n bound 4096
put a mul j 2 get a mul add j 1 2
put a add mul j 2 1 get a add mul add j 1 2 1
j = add j 1
end
end
fn na_insert a edit ulong * n ulong i ulong va ulong sz ulong to void
j = n
while gt j i bound 4096
put a mul j 2 get a mul sub j 1 2
put a add mul j 2 1 get a add mul sub j 1 2 1
j = sub j 1
end
put a mul i 2 va
put a add mul i 2 1 sz
end
fn na_end a edit ulong * i ulong to ulong
base = get a mul i 2
sz = get a add mul i 2 1
ret add base sz
end
fn na_merge a edit ulong * dst ulong src ulong to void
sz = add get a add mul dst 2 1 get a add mul src 2 1
put a add mul dst 2 1 sz
end
fn na_release a edit ulong * s edit ulong 4 to ulong
va = get s 3
sz = get s 2
vend = add va sz
if or eq sz 0 lt vend va
ret 1
end
n = get s 0
i = ulong 0
while lt i n bound 4096
if ge get a mul i 2 va
break
end
i = add i 1
end
if gt i 0
if gt na_end a sub i 1 va
ret 2
end
end
if lt i n
if gt vend get a mul i 2
ret 2
end
end
if ge n 4096
ret 3
end
na_insert a n i va sz
n = add n 1
if lt add i 1 n
if eq vend get a mul add i 1 2
na_merge a i add i 1
na_erase a n add i 1
n = sub n 1
end
end
if gt i 0
if eq na_end a sub i 1 va
na_merge a sub i 1 i
na_erase a n i
n = sub n 1
end
end
put s 0 n
ret 0
end
note Same align-up contract as nvrm_palign; the OM1 dispatcher has reserved OM2 parameter names.
fn na_align base ulong align ulong to ulong
if or eq align 0 ne and align sub align 1 0
ret 0
end
m = sub align 1
s = add base m
if lt s base
ret 0
end
ret and s not m
end
fn na_fit a edit ulong * s edit ulong 4 i ulong to ulong
base = get a mul i 2
sz = get a add mul i 2 1
rend = add base sz
if lt rend base
ret 0
end
va = na_align base get s 3
if eq va 0
ret 0
end
pad = sub va base
if gt pad sz
ret 1
end
if gt get s 2 sub sz pad
ret 1
end
vend = add va get s 2
if lt vend va
ret 0
end
n = get s 0
if eq pad 0
if eq vend rend
na_erase a n i
put s 0 sub n 1
else
put a mul i 2 vend
put a add mul i 2 1 sub rend vend
end
else
if and lt vend rend ge n 4096
ret 1
end
put a add mul i 2 1 pad
if lt vend rend
na_insert a n add i 1 vend sub rend vend
put s 0 add n 1
end
end
put s 3 va
ret 2
end
fn nvrm_va op ulong s edit ulong 4 a edit ulong * to ulong
if eq op 1
ret na_release a s
end
i = ulong 0
while lt i get s 0 bound 4096
v = na_fit a s i
if eq v 2
ret get s 3
end
if eq v 0
ret 0
end
i = add i 1
end
va = na_align get s 1 get s 3
if eq va 0
ret 0
end
vend = add va get s 2
if lt vend va
ret 0
end
put s 1 vend
ret va
end

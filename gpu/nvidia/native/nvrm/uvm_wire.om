note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note ABI580.173.02 uvm_ioctl.h request fields; unmentioned output and padding bytes are zero.
fn nvrm_uvm_store b edit uchar 56 off ulong v ulong n ulong to void
for i ulong n
put b add off i uchar and shr v mul i 8 255
end
end
fn nvrm_uvm_wire cmd ulong a view ulong 16 uuid view uchar 16 b edit uchar 56 to ulong
for i ulong 56
put b i 0
end
if eq cmd 805306369
nvrm_uvm_store b 0 get a 0 8
ret 16
end
if eq cmd 75
nvrm_uvm_store b 0 get a 0 4
ret 8
end
if or eq cmd 34 eq cmd 73
nvrm_uvm_store b 0 get a 0 8
nvrm_uvm_store b 8 get a 1 8
ret 24
end
for i ulong 16
put b i get uuid i
end
if or eq cmd 26 eq cmd 38
ret 20
end
if eq cmd 37
nvrm_uvm_store b 24 get a 0 4
nvrm_uvm_store b 28 get a 1 4
nvrm_uvm_store b 32 get a 2 4
ret 40
end
if eq cmd 25
nvrm_uvm_store b 16 get a 0 4
nvrm_uvm_store b 20 get a 1 4
nvrm_uvm_store b 24 get a 2 4
ret 32
end
if eq cmd 27
nvrm_uvm_store b 16 get a 0 4
nvrm_uvm_store b 20 get a 1 4
nvrm_uvm_store b 24 get a 2 4
nvrm_uvm_store b 32 get a 3 8
nvrm_uvm_store b 40 get a 4 8
ret 56
end
if eq cmd 28
nvrm_uvm_store b 16 get a 0 4
nvrm_uvm_store b 20 get a 1 4
ret 28
end
ret 0
end

note NVRM decision policy. Omega owns each decision; the raw ioctl call stays in nvrm.c.
note Every numeric constant below was computed with Wolfram and is quoted in the lane report.
note Opcode map: 1 nrstat, 2 hnext, 3 vunits, 4 vcover, 5 palign, 6 pspan, 7 pfull,
note 8 chadm, 9 retry, 10 mthd, 11 gpentry. A result of 0 is a real answer, never an error.

fn nvrm_nrstat st ulong to ulong
if eq st 0
ret 0
end
if eq st 81
ret 1
end
ret 2
end

fn nvrm_hnext cls ulong nxt ulong accepted ulong to ulong
if eq accepted 18446744073709551615
ret 4294967296
end
if eq cls 65
ret 0
end
if eq nxt 4294967295
ret 4294967296
end
ret or nxt 8589934592
end

fn nvrm_vunits b ulong to ulong
u = b
if eq b 0
u = ulong 1
end
s = add u 4294967295
if lt s u
ret 0
end
ret and s 18446744069414584320
end

fn nvrm_vcover base ulong vanext ulong endv ulong o edit ulong 4 to ulong
if eq base 0
ret 0
end
if or lt endv base lt vanext base
ret 2
end
db = sub vanext base
de = sub endv base
owned = nvrm_vunits db
want = nvrm_vunits de
if or eq owned 0 eq want 0
ret 2
end
if le want owned
ret 0
end
oe = add base owned
if lt oe base
ret 2
end
we = add base want
if lt we base
ret 2
end
put o 2 oe
put o 3 we
ret 1
end

fn nvrm_palign base ulong align ulong to ulong
if or eq align 0 ne and align sub align 1 0
ret 0
end
m = sub align 1
s = add base m
if lt s base
ret 0
end
ret and s not m
end

fn nvrm_pspan off ulong nwords ulong size ulong va ulong to ulong
if ne and off 3 0
ret 1
end
if eq nwords 0
ret 1
end
if gt nwords 2097151
ret 1
end
bytes = mul nwords 4
span = add off bytes
if lt span off
ret 1
end
if gt span size
ret 1
end
limit = sub 18446744073709551615 off
if gt va limit
ret 2
end
ret 0
end

fn nvrm_pfull putv ulong retired ulong entries ulong to ulong
d = and sub putv retired 4294967295
e = and sub entries 1 4294967295
if ge d e
ret 1
end
ret 0
end

fn nvrm_chadm faulted ulong chgroup ulong regd ulong nextra ulong extra ulong maxv ulong to ulong
if or or or ne faulted 0 ne chgroup 0 ne regd 0 ne nextra 0
ret 1
end
if gt extra maxv
ret 2
end
ret 0
end

fn nvrm_retry failed ulong tries ulong budget ulong nomem ulong to ulong
if eq failed 0
ret 0
end
if eq nomem 0
ret 3
end
if ge tries budget
ret 2
end
ret 1
end

fn nvrm_mthd subc ulong mthd ulong count ulong to ulong
a = shl ulong 2 28
b = shl count 16
c = shl subc 13
d = shr mthd 2
ret and or or or a b c d 4294967295
end

fn nvrm_gpentry va ulong nwords ulong to ulong
low = and va 18446744073709551612
nw = and nwords 2097151
wlen = shl nw 42
ret or or low wlen 2199023255552
end

fn nvrm_policy op ulong in view ulong 8 out edit ulong 4 to ulong
if eq op 1
ret nvrm_nrstat get in 0
end
if eq op 2
ret nvrm_hnext get in 0 get in 1 get in 2
end
if eq op 3
ret nvrm_vunits get in 0
end
if eq op 4
ret nvrm_vcover get in 0 get in 1 get in 2 out
end
if eq op 5
ret nvrm_palign get in 0 get in 1
end
if eq op 6
ret nvrm_pspan get in 0 get in 1 get in 2 get in 3
end
if eq op 7
ret nvrm_pfull get in 0 get in 1 get in 2
end
if eq op 8
ret nvrm_chadm get in 0 get in 1 get in 2 get in 3 get in 4 get in 5
end
if eq op 9
ret nvrm_retry get in 0 get in 1 get in 2 get in 3
end
if eq op 10
ret nvrm_mthd get in 0 get in 1 get in 2
end
if eq op 11
ret nvrm_gpentry get in 0 get in 1
end
ret 0
end

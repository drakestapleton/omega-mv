note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note mode 0: slot counter successor (zero refuses overflow); mode 1: existing method encoding.
fn nvrm_alloc_scalar mode ulong a ulong b ulong c ulong to ulong
if eq mode 1
ret nvrm_mthd a b c
end
if gt a 18446744069414584319
ret 0
end
ret add a 4294967296
end

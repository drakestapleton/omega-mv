note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note C4 streams (CUDApp#115): the effectful GPFIFO submit of nvrm_enqueue / nvrm_chan_submit / nvrm_ring.
note fifo and bell are owned mapping handles of the client's native context (nvrm/native_client.h), never
note raw addresses. Every mapset is one aligned store bracketed by DSB SY (AArch64) / MFENCE (x86-64)
note (omega-mv seed/host/MAPPING.md), the barrier nvrm_cpu_barrier issues in C (nvrm/cpu_barrier.h).
note GP entry (nvrm_gp_entry): (va & ~3) | nwords << 42 | 1 << 41, nwords 1..0x1fffff.
om2
export fn streams_gp_entry va ulong nwords ulong to ulong
ret or or sub va and va 3 shl nwords 42 shl ulong 1 41
end
note Write GP entry `pos rem entries`, then USERD GPPut = ((pos + 1) mod 2^32) rem entries at byte gpput of fifo
note (pos is the uint32 nvrm put counter; the increment wraps as in C).
note Value 0, minus errno from the mapping, or -22 for a refused argument (no store issued).
export fn streams_gp_publish fifo long entries ulong pos ulong gpput ulong va ulong nwords ulong to long
if lt entries 2
ret neg long 22
end
if or eq nwords 0 gt nwords 2097151
ret neg long 22
end
if or ne and gpput 3 0 gt gpput 65532
ret neg long 22
end
slot = rem pos entries
r = mapset fifo mul slot 8 8 streams_gp_entry va nwords
if ne r 0
ret r
end
cpufence
ret mapset fifo gpput 4 rem and add pos 1 4294967295 entries
end
note Doorbell: NVC361_NOTIFY_CHANNEL_PENDING (byte off of the usermode page) <- the channel's work submit token.
export fn streams_ring bell long off ulong token ulong to long
if or ne and off 3 0 gt off 65532
ret neg long 22
end
if gt token 4294967295
ret neg long 22
end
ret mapset bell off 4 token
end

note SPDX-License-Identifier: AGPL-3.0-only
note Share this host lock inode between all Arboris workers on one GB10.
note Independent open-file descriptions arbitrate CPU queries and GPU queries,
note including fenced but unsettled outputs. Durable channel state is local.
note The supervisor owns the mount namespace. Never unlink the live lock.
text ar_compute_path "/tmp/omega-arboris-compute-v1.lock"
global ar_compute_fd long 1
global ar_compute_pid long 1
global ar_compute_kind ulong 1

fn ar_claim_compute kind ulong to bool
  if or eq kind 0 ne get ar_compute_kind 0 0
    ret false
  end
  note 559104 is AArch64 Linux O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK|O_RDONLY.
  note The create retry adds O_CREAT|O_EXCL (559296) and permissions 0444.
  fd = fopen ar_compute_path 0 len ar_compute_path 559104 0
  if eq fd long -2
    fd = fopen ar_compute_path 0 len ar_compute_path 559296 292
    if eq fd long -17
      fd = fopen ar_compute_path 0 len ar_compute_path 559104 0
    end
  end
  if lt fd 0
    ret false
  end
  st = new uchar 128 0
  if ne fstat int fd st 0 128 0
    closed = fclose int fd
    ret false
  end
  if ne and get st 17 240 128
    closed = fclose int fd
    ret false
  end
  if ne flock int fd 6 0
    closed = fclose int fd
    ret false
  end
  put ar_compute_fd 0 fd
  put ar_compute_pid 0 long getpid
  put ar_compute_kind 0 kind
  ret true
end

fn ar_drop_compute to void
  if eq get ar_compute_kind 0 0
    ret
  end
  if ne get ar_compute_pid 0 long getpid
    ret
  end
  closed = fclose int get ar_compute_fd 0
  put ar_compute_kind 0 0
  put ar_compute_pid 0 0
end

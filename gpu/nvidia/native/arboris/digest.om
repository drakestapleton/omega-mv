note SPDX-License-Identifier: AGPL-3.0-only
note Derive the host witness from the exact bytes of a fenced, serialized
note Arboris step. Arena framing is header words 0..14, logical topology,
note parameters and active input state, in little-endian order. Padding and
note guard VAs are outside the commitment. The kernel and output use SHA-256
note over their unpadded code and state bytes respectively.
fn ar_hash_mapping ctx edit ulong 40 tok long bytes ulong to bool
  buf = new uchar 4096 0
  start = ulong 0
  while lt start bytes bound 0x10000000
    take = sub bytes start
    if gt take 4096
      take = ulong 4096
    end
    if ne mapread tok start buf 0 take long take
      ret false
    end
    sha256_update ctx part buf 0 take
    start = add start take
  end
  ret true
end

fn ar_hash_header ctx edit ulong 40 m view ulong 16 to void
  header = new uchar 120 0
  for i ulong 15
    for j ulong 8
      put header add mul i 8 j uchar and shr get m i mul j 8 255
    end
  end
  sha256_update ctx header
end

fn ar_step_digests m view ulong 16 seq ulong hashes edit uchar 96 to bool
  if or eq seq 0 ne seq get ar_fenced_seq 0
    ret false
  end
  if or ne seq get nvret 0 ne seq get nvput 0
    ret false
  end
  if or ne get nvfault 0 0 not ar_device_receipt get ar_maps 5 seq
    ret false
  end
  if not ar_snapshot_matches m
    ret false
  end
  topo = get m 9
  state = get m 11
  if eq get m 0 arboris_magic
    topo = mul topology_words m 4
    state = mul mul get m 1 get m 4 2
  else
    if ne get m 0 arboris_sparse_magic
      ret false
    end
  end
  if eq get ar_code_bytes 0 0
    ret false
  end
  ctx = new ulong 40 0
  receipt = new uchar 96 0
  sha256_init ctx
  ar_hash_header ctx m
  if not ar_hash_mapping ctx get ar_maps 1 topo
    ret false
  end
  if not ar_hash_mapping ctx get ar_maps 2 get m 10
    ret false
  end
  if not ar_hash_mapping ctx get ar_maps add 3 get m 6 state
    ret false
  end
  sha256_final ctx part receipt 0 32
  sha256_init ctx
  if not ar_hash_mapping ctx get gbmem 4 get ar_code_bytes 0
    ret false
  end
  sha256_final ctx part receipt 32 32
  sha256_init ctx
  if not ar_hash_mapping ctx get ar_maps sub ulong 4 get m 6 state
    ret false
  end
  sha256_final ctx part receipt 64 32
  for i ulong 96
    put hashes i get receipt i
  end
  ret true
end

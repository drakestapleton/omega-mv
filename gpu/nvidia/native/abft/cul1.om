note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note CUL1 two-sided randomized checksum (Freivalds) for the registered GEMM family (op 3).
note Concatenate after native/learn53/task.om; task.om is unchanged and keval stays the exact oracle.
note kabft n c seed: kvalid refusals pass through unchanged; 69 for a non-GEMM op; 65 bad length;
note 1 canary/padding/residual mismatch; 0 pass. seed is the evaluator nonce; ko never chooses it.
note Miss bound (Wolfram, docs/abft/CONTRACT.md section 4): a single wrong element is always detected;
note an error pattern whose 2-adic valuation is v is missed with probability <= 2^(v-31) per side,
note and a rectangle of 2^31 is always missed (keval still detects it).
global kr ulong 64
global kq2 ulong 64
global ks ulong 1
fn ksm to ulong
s = add get ks 0 11400714819323198485
put ks 0 s
z = mul xor s shr s 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
ret or and xor z shr z 31 4294967295 1
end
fn kca i ulong k ulong to ulong
ret kw add 24 add mul i kw 8 k
end
fn kcb k ulong j ulong to ulong
ret kw add add 24 kw 11 add mul k kw 9 j
end
fn kcx i ulong j ulong to ulong
ret kc add 1 add mul i kw 10 j
end
fn kright to bool
for j ulong kw 6
put kr j ksm
end
for k ulong kw 7
y = ulong 0
for j ulong kw 6
y = add y mul kcb k j get kr j
end
put kq2 k y
end
for i ulong kw 5
z = ulong 0
for k ulong kw 7
z = add z mul kca i k get kq2 k
end
w = ulong 0
for j ulong kw 6
w = add w mul kcx i j get kr j
end
if ne and xor z w 4294967295 0
ret false
end
end
ret true
end
fn kleft to bool
for i ulong kw 5
put kr i ksm
end
for k ulong kw 7
x = ulong 0
for i ulong kw 5
x = add x mul get kr i kca i k
end
put kq2 k x
end
for j ulong kw 6
z = ulong 0
for k ulong kw 7
z = add z mul get kq2 k kcb k j
end
w = ulong 0
for i ulong kw 5
w = add w mul get kr i kcx i j
end
if ne and xor z w 4294967295 0
ret false
end
end
ret true
end
fn kabft n ulong c ulong seed ulong to int
status = kvalid n
if ne status 0
ret status
end
if ne kw 2 3
ret 69
end
if ne c mul 4 add kw 13 2
ret 65
end
if ne kc 0 2779096485
ret 1
end
if ne kc add kw 13 1 2779096485
ret 1
end
for p ulong kw 13
if ge rem p kw 10 kw 6
if ne kc add p 1 2779096485
ret 1
end
end
end
put ks 0 seed
if not kright
ret 1
end
if not kleft
ret 1
end
ret 0
end

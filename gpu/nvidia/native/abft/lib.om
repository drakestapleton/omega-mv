note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note native/abft shared words: buffered stdout, decimal output, splitmix64 streams, FNV-1a digests,
note bf16/f32 decoding. See docs/abft/CONTRACT.md.
global ob uchar 65536
global obn ulong 1
global rs ulong 4
fn now to ulong
ret ulong monons
end
fn oflush to void
n = get obn 0
if gt n 0
w = write 1 ob 0 n
if lt w 0
trap 8
end
put obn 0 0
end
end
fn ochar c uchar to void
n = get obn 0
if ge n 65000
oflush
n = get obn 0
end
put ob n c
put obn 0 add n 1
end
fn odig v ulong to void
if ge v 10
odig div v 10
end
ochar uchar add 48 rem v 10
end
fn onum v ulong to void
ochar 32
odig v
end
fn osig v long to void
ochar 32
if lt v 0
ochar 45
odig ulong neg v
else
odig ulong v
end
end
fn onl to void
ochar 10
end
note splitmix64 (Steele, Lea, Flood 2014). Stream 0 input generator, 1 evaluator nonce stream,
note 2 candidate schedule, 3 candidate fault placement. Streams never share state.
fn rseed k ulong v ulong to void
put rs k v
end
fn rnext k ulong to ulong
s = add get rs k 11400714819323198485
put rs k s
z = mul xor s shr s 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
ret xor z shr z 31
end
fn rbelow k ulong n ulong to ulong
ret rem rnext k n
end
note FNV-1a 64 over the low 32 bits of each word, little-endian byte order.
fn fnvw h ulong v ulong to ulong
x = h
for i ulong 4
x = xor x and shr v mul i 8 255
x = mul x 1099511628211
end
ret x
end
fn bf v ulong to f64
ret f64 bitcast f32 uint shl and v 65535 16
end
fn f3 v ulong to f64
ret f64 bitcast f32 uint and v 4294967295
end
fn fbits x f32 to ulong
ret ulong bitcast uint x
end

note Test-only binary transcript: model route publication and transactional refusal.
fn main to int
t = new ulong 512 0
b = new uchar 16384 0
o = new uchar 16384 0
rmput b 84 4 65
r = rmaction t b 43
rmput o 0 4 r
rmput o 4 4 get t 400
rmput o 8 4 get t 411
rmput o 12 4 get t 412
for j ulong 152
put o add 16 j get rqpay j
end
put t 410 5
rmput b 72 4 1
rmput b 76 4 1
rmput b 80 4 99
rmput b 84 4 128
rmput b 96 4 56
r = rmaction t b 43
rmput o 168 4 rmstatus r
rmput o 172 4 get t 401
rmput o 176 4 rmfind t 1 99
wr = write 1 o 0 180
if ne wr 180
ret 1
end
ret 0
end

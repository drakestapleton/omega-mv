note tests/q38_sass_emit.om: Stage 1 pure-Omega IR emitter for Qwen3.8-27B decode glue kernels.
note Composes after: gpu/nvidia/om/codegen/cg_dec_emit.om, gpu/nvidia/om/codegen/cg_dec.om.
note Emits binary IR records to stdout for Stage 2 (q38_sass_encode.om: bw_alloc + bw_enc_sm121):
note   [u64 n_insns][288 x u64 vreg+uvreg widths][n_insns * 8 x u64 IR words] (all little-endian).

fn put_u64 b edit uchar 8192 off ulong v ulong to void
for k ulong 8
put b add off k uchar and shr v mul k 8 255
end
end

fn wr_all b view uchar 8192 n ulong to void
off = ulong 0
while lt off n bound 1024
r = write 1 b off sub n off
if le r 0
trap 4
end
off = add off ulong r
end
end

fn wr_ir x view ulong 8192 m view ulong 512 n ulong to void
buf = new uchar 8192 0
put_u64 buf 0 n
for i ulong 256
put_u64 buf mul add i 1 8 get m add 64 i
end
for j ulong 32
put_u64 buf mul add 257 j 8 get m add 320 j
end
wr_all buf 2312
for i ulong n
for f ulong 8
put_u64 buf mul f 8 get x add mul i 8 f
end
wr_all buf 64
end
end

fn emit_ir kind ulong mode ulong width ulong stride ulong to void
x = new ulong 8192 0
m = new ulong 512 0
a = or mode shl width 32
rc = cg_dec kind a stride 0 x m
if ne rc 0
trap 1
end
n = get m 0
if or eq n 0 gt n 1024
trap 2
end
wr_ir x m n
end

fn main to int
emit_ir 2 4 5120 0
emit_ir 2 5 5120 0
emit_ir 3 0 17408 0
emit_ir 5 0 14336 14336
emit_ir 6 0 0 0
emit_ir 4 0 0 0
emit_ir 4 1 0 0
ret 0
end

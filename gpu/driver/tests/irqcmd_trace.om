note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note HOST MODEL verifier input; opcode9 deliberately corrupts peer-owned live storage after capture.
global ciin uchar 512
global ciout uchar 64
fn ciword o ulong v ulong to void
for i ulong 8
put ciout add o i uchar and shr v mul i 8 255
end
end
fn ciop op uchar to long
if eq op 0
if ne get iqcstate 0 0
ret -4
end
put iqcmode 0 1
put iqcstate 0 1
ret 0
end
if or eq op 1 eq op 2
ret iqcommand ulong op add get iqcseq 0 1 16 32 4
end
if eq op 3
ret iqcommand 1 get iqcseq 0 16 32 4
end
if eq op 4
ret iqctake
end
if eq op 5
ret iqcack iqcget 1
end
if eq op 6
ret iqcack add iqcget 1 1
end
if eq op 7
ret iqcrevoke
end
if eq op 8
put iqcmode 0 0
ret 0
end
if eq op 9
put iqcmd add mul rem get iqccons 0 8 40 8 99
ret 0
end
if eq op 10
ret iqcommand 3 add get iqcseq 0 1 16 32 4
end
ret iqcommand 1 0 16 32 4
end
fn main to int
n = read 0 ciin 0 512
if lt n 0
ret 2
end
for k ulong ulong n
r = ciop get ciin k
ciword 0 ulong add r 128
ciword 8 get iqcprod 0
ciword 16 get iqccons 0
ciword 24 get iqcstate 0
ciword 32 get iqchold 0
ciword 40 get iqcseq 0
ciword 48 iqcget 0
ciword 56 iqcget 1
r = write 1 ciout 0 64
if ne r 64
ret 3
end
r = write 1 iqcitem 0 40
if ne r 40
ret 4
end
end
ret 0
end

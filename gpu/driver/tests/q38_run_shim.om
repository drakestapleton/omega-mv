note tests/q38_run_shim.om: Zero-syscall host memory + DC CIVAC simulator shim for q38_run_test.om.
note Maps 8 MiB of simulated LPDDR5x at 0x00_8000_0000 (2147483648) for host testing on macOS/Linux.
note Never touches real hardware.

const MMPALIM ulong 1099511627776
const SHBASE ulong 2147483648
const SHBYTES ulong 8388608

global shmem uint 2097152
global shflsh ulong 1
global shflpa ulong 1
global shflsz ulong 1
global shdb uint 1

note Stubbed RPC/param symbols required by compute.om Sections 1-3 (unused by q38_run_test.om)
global rqpay uchar 65536
global rqlen ulong 1
global bplen ulong 1

fn rqclear n ulong to void
put rqlen 0 n
end

fn rqput32 b ulong off ulong v ulong to void
if eq b 999
put rqlen 0 add off v
end
end

fn rqget32 b ulong off ulong to ulong
if eq b 999
ret off
end
ret 0
end

fn pachan to long
ret 0
end

fn paempty to long
ret 0
end

fn pasched a ulong b ulong c ulong to long
ret long add a add b c
end

fn pawstreq to long
ret 0
end

fn pawstdec n ulong to long
ret long n
end

fn pacgpcls g bool to ulong
if g
ret 51823
end
ret 51567
end

fn brmalloc a ulong b ulong c ulong d ulong e ulong to long
ret long add a add b add c add d e
end

fn brmctrl a ulong b ulong c ulong d ulong to long
ret long add a add b add c d
end

fn mmregwr reg ulong val ulong to void
if eq reg 12255376
put shdb 0 uint and val 4294967295
end
end

fn mmwr32 pa ulong val ulong to void
if or lt pa SHBASE ge pa add SHBASE SHBYTES
trap 3
end
off = sub pa SHBASE
if ne and off 3 0
trap 3
end
put shmem div off 4 uint and val 4294967295
end

fn mmrd32 pa ulong to ulong
if or lt pa SHBASE ge pa add SHBASE SHBYTES
trap 3
end
off = sub pa SHBASE
if ne and off 3 0
trap 3
end
ret ulong get shmem div off 4
end

fn mmwr64 pa ulong val ulong to void
mmwr32 pa and val 4294967295
mmwr32 add pa 4 shr val 32
end

fn q3_dc_civac pa ulong nbytes ulong to void
put shflsh 0 add get shflsh 0 1
put shflpa 0 pa
put shflsz 0 nbytes
end

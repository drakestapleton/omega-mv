note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test-only framed stdin driver. Header eight u64 LE: op,a,b,c,d,e,f,payload-size.
global stin uchar 64
global stout uchar 32768
global stlen ulong 1
fn starg n ulong to ulong
v = ulong 0
for j ulong 8
v = or v shl ulong get stin add mul n 8 j mul j 8
end
ret v
end
fn stword v ulong to void
for j ulong 8
put stout get stlen 0 uchar and shr v mul j 8 255
put stlen 0 add get stlen 0 1
end
end
fn staction to ulong
op = starg 0
if eq op 1
ret screate
end
if eq op 2
ret sdestroy
end
if eq op 3
ret sadd starg 1 starg 2 starg 3 starg 4
end
if eq op 4
ret ssplit starg 1
end
if eq op 5
ret smerge starg 1
end
if eq op 6
ret sremove starg 1 starg 2
end
if eq op 7
ret fbpush
end
if eq op 8
ret fbbatch
end
if eq op 9
ret fbrecover
end
if eq op 10
ret scnotify starg 1
end
if eq op 11
ret sidispatch starg 1 starg 2
end
if eq op 12
ret siobject starg 1 starg 2 starg 3
end
if eq op 13
for j ulong 8
r = iqctake
if ne r 1
break
end
r = iqcack iqcget 1
if ne r 0
ret UVFATAL
end
end
ret UVOK
end
if eq op 14
if eq get fbget 0 get fbput 0
ret UVENOENT
end
o = add mul rem get fbget 0 16 32 31
put fbring o or get fbring o uchar 128
ret UVOK
end
if eq op 15
put iqcmode 0 starg 1
put iqcstate 0 starg 2
ret UVOK
end
if eq op 16
r = iqcommand 1 add get iqcseq 0 1 0 0 0
if ne r 0
ret UVEINVAL
end
ret UVOK
end
ret UVEINVAL
end
fn stsnapshot status ulong to void
put stlen 0 0
stword status
stword get slive 0
stword get sn 0
stword get sen 0
stword get fbget 0
stword get fbput 0
stword get fbov 0
stword get siolen 0
for j ulong mul get sn 0 8
stword get sr j
end
for j ulong mul get sen 0 6
stword get sev j
end
stword get iqcmode 0
stword get iqcstate 0
stword get iqcseq 0
stword get iqcprod 0
stword get iqccons 0
stword get sqbad 0
for j ulong 320
put stout get stlen 0 get iqcmd j
put stlen 0 add get stlen 0 1
end
for j ulong 512
put stout get stlen 0 get fbring j
put stlen 0 add get stlen 0 1
end
for j ulong 384
stword get spage j
end
stword get scva 0
stword get scval 0
stword get sctyp 0
stword get sctag 0
for j ulong get siolen 0
put stout get stlen 0 get siob j
put stlen 0 add get stlen 0 1
end
end
fn strequest to long
off = ulong 0
while lt off 64 bound 64
r = read 0 stin off sub 64 off
if lt r 0
ret -1
end
if eq r 0
if eq off 0
ret 0
end
ret -1
end
off = add off ulong r
end
size = starg 7
if gt size 9264
ret -1
end
off = 0
while lt off size bound 9264
r = read 0 siab off sub size off
if le r 0
ret -1
end
off = add off ulong r
end
for j ulong 32
put uvpkt j get siab j
end
put sen 0 0
put siolen 0 0
r2 = staction
stsnapshot r2
off = 0
while lt off get stlen 0 bound 32768
w = write 1 stout off sub get stlen 0 off
if le w 0
ret -1
end
off = add off ulong w
end
ret 1
end
fn main to int
put iqcmode 0 1
put iqcstate 0 1
for j ulong 100000
r = strequest
if lt r 0
ret 70
end
if eq r 0
ret 0
end
end
ret 71
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Verification driver only. Snapshot opcodes model local immutable-buffer ownership, not consumer publication.
global ilbyte uchar 1
global ilout uchar 128
fn ilword off ulong value ulong to void
for i ulong 8
put ilout add off i uchar and shr value mul i 8 255
end
end
fn iltrace result long to void
note Status wire uses bias128: WolframLanguageEvaluator:{128-125,128-16,128+64}->{3,112,192}.
ilword 0 ulong add result 128
ilword 8 get ilstate 0
ilword 16 get pvreg 0
ilword 24 get pvalloc 0
ilword 32 get ilactive 0
ilword 40 get ilwait 0
ilword 48 get ilsnap 0
ilword 56 get pvwork 0
ilword 64 get pvqueued 0
ilword 72 get pvmmlive 0
ilword 80 get pvfx 0
ilword 88 get pvfreec 0
ilword 96 get pvenable 0
ilword 104 get pvcan 0
ilword 112 get pvstopd 0
ilword 120 get ilowner 0
n = write 1 ilout 0 128
end
fn ilop cap irqls span mmspan owner howner waiter wowner op uchar to long
if eq op 0
ret irattach cap span 1
end
if eq op 1
ret irenable cap 1
end
if eq op 3
ret irleave cap owner 1
end
if eq op 5
ret irwaitend cap waiter 1
end
if eq op 6
ret irsubmit cap 1
end
if eq op 7
ret irrevoke cap 1
end
if eq op 8
ret irsync cap 1
end
if eq op 9
ret pvtick
end
if eq op 10
ret irquiet cap 1
end
if eq op 11
ret irclose cap span 1
end
if eq op 12
put pvlocked 0 1
ret 0
end
if eq op 13
ret mmread span owner 1 0
end
if eq op 14
ret mmwrite span owner 1 0 uint 64
end
if eq op 15
if ne get ilactive 0 1
ret -4
end
if or ne get ilstate 0 2 ne get ilsnap 0 0
ret -4
end
put ilsnap 0 1
ret 0
end
if eq op 16
if eq get ilsnap 0 0
ret -4
end
put ilsnap 0 0
ret 0
end
if eq op 20
bad = hownermk cap 2
ret get pverr 0
end
if eq op 21
ret mmread span owner 2 0
end
if eq op 22
ret mmread span owner 1 4093
end
if eq op 23
ret mmread span owner 1 4096
end
if eq op 24
ret mmread span owner 1 4092
end
if eq op 25
ret pvpeer
end
ret -1
end
fn main to int
n = read 0 ilbyte 0 1
if ne n 1
ret 2
end
put pvbad 0 ulong get ilbyte 0
r = pvinit 1 1
span = mmspanmk 1
cap = irqlsmk 1 0 0 1
initerr = get pverr 0
owner = hownermk cap 1
old = owner
waiter = wownermk cap 1
iltrace initerr
for i ulong 512
n = read 0 ilbyte 0 1
if eq n 0
ret 0
end
if ne n 1
ret 2
end
op = get ilbyte 0
if eq op 2
old = owner
owner = hownermk cap 1
r = get pverr 0
else
if eq op 4
waiter = wownermk cap 1
r = get pverr 0
else
if eq op 19
r = irleave cap old 1
else
r = ilop cap span owner waiter op
end
end
end
iltrace r
end
ret 2
end

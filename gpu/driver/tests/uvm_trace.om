note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note tests/uvm_trace.om: host trace for the uvm page-table builder.
note Build: cat uvm/fmt.om uvm/pt.om uvm/fault.om tests/uvm_trace.om | omc > prog.
note Addresses below are WolframLanguageEvaluator results, not hand sums:
note 2^32 -> 4294967296, 2^32+2^21 -> 4297064448, 2^32+2^22 -> 4299161600,
note 2^32+2^23 -> 4303355904, 2^31+2^20 -> 2148532224, 2^31+2^20+2^16 -> 2148597760,
note 2^31+2^21 -> 2149580800. The checker recomputes every expected word.
const VA4 ulong 4294967296
const VA4B ulong 4297064448
const VA64 ulong 4299161600
const VA2 ulong 4303355904
const PA4 ulong 2148532224
const PA64 ulong 2148597760
const PA2 ulong 2149580800
const PG4 ulong 4096
const PG64 ulong 65536
const PG2 ulong 2097152
text utl "INIT|ALLOC|BIND|MAP|UNMAP|SUM|DUMP|ENDDUMP|WALK|ENC|PKT|DEC|SERVE|PROT|FIT|DONE|rc=|va=|sz=|pg=|pa=|ap=|pcf=|v=|ts=|typ=|rep=|acc=|en=|val=|cli=|act=|ro=|"
global utb uchar 256
global utp ulong 1
global utdig uchar 24
fn utch c uchar to void
p = get utp 0
put utb p c
put utp 0 add p 1
end
fn utflush to void
utch 10
n = get utp 0
r = write 1 utb 0 n
if ne r long n
exit 1
end
put utp 0 0
end
fn utfrag k ulong to void
w = ulong 0
for i ulong len utl
c = get utl i
if eq c 124
w = add w 1
else
if eq w k
utch c
end
end
end
end
fn utdec v ulong to void
n = ulong 0
x = v
while true bound 24
put utdig n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
for i ulong n
utch get utdig sub sub n 1 i
end
end
fn uthex v ulong w ulong to void
n = ulong 0
x = v
while true bound 24
d = uchar rem x 16
if lt d 10
put utdig n add d 48
else
put utdig n add d 87
end
n = add n 1
x = div x 16
if eq x 0
break
end
end
while lt n w bound 24
put utdig n 48
n = add n 1
end
for i ulong n
utch get utdig sub sub n 1 i
end
end
fn utkv k ulong v ulong to void
utch 32
utfrag k
utdec v
end
fn utend rc ulong to void
utkv 16 rc
utflush
end
fn utsum to void
utfrag 5
utch 32
utdec uvsum
utflush
end
fn utdump to void
utsum
utfrag 6
utflush
for i ulong 8192
v = uvld64 mul i 8
if ne v 0
utch 87
utch 32
utdec i
utch 32
uthex v 16
utflush
end
end
utfrag 7
utflush
end
fn utwalk va ulong pg ulong to void
r = uvread va pg
utfrag 8
utkv 17 va
utkv 19 pg
utkv 16 r
utkv 20 get uvdpa 0
utkv 21 get uvdap 0
utkv 22 get uvdpcf 0
utkv 23 get uvdv 0
utflush
end
fn utpkt to void
utfrag 10
for i ulong 32
uthex ulong get uvpkt i 2
end
utflush
end
fn utdecf to void
utfrag 11
utkv 17 get uvfva 0
utkv 24 get uvfts 0
utkv 25 get uvftyp 0
utkv 26 get uvfrep 0
utkv 27 get uvfacc 0
utkv 28 get uvfen 0
utkv 29 get uvfval 0
utkv 30 get uvfcli 0
utflush
end
fn utfault va ulong ts ulong typ ulong rep ulong acc ulong cli ulong to void
utfrag 9
utkv 17 va
utkv 24 ts
utkv 25 typ
utkv 26 rep
utkv 27 acc
utkv 28 get uvfen 0
utkv 29 get uvfval 0
utkv 30 cli
utflush
uvpktenc va ts typ rep acc cli
utpkt
uvpktdec
utdecf
r = uvserve
utfrag 12
utkv 31 r
utkv 16 r
utflush
utdump
end
fn scinit to void
r = uvinit
utfrag 0
utend r
utdump
end
fn scalloc va ulong sz ulong pg ulong to void
r = uvallocat va sz pg
utfrag 1
utkv 17 va
utkv 18 sz
utkv 19 pg
utend r
end
fn scbind va ulong pa ulong to void
r = uvbind va pa
utfrag 2
utkv 17 va
utkv 20 pa
utend r
end
fn scmap va ulong pa ulong sz ulong pg ulong ap ulong to void
r = uvmap va pa sz pg ap 0
utfrag 3
utkv 17 va
utkv 20 pa
utkv 18 sz
utkv 19 pg
utkv 21 ap
utkv 22 0
utend r
utdump
end
fn scmapc va ulong pa ulong sz ulong pg ulong pcf ulong to void
r = uvmap va pa sz pg 2 pcf
utfrag 3
utkv 17 va
utkv 20 pa
utkv 18 sz
utkv 19 pg
utkv 21 2
utkv 22 pcf
utend r
utdump
end
fn scunmap va ulong sz ulong pg ulong to void
r = uvunmap va sz pg
utfrag 4
utkv 17 va
utkv 18 sz
utkv 19 pg
utend r
utdump
end
fn scfit sz ulong pg ulong to void
r = uvalloc sz pg
utfrag 14
utkv 18 sz
utkv 19 pg
utkv 17 get uvout 0
utend r
end
fn scprot va ulong ro ulong to void
r = uvprot va ro
utfrag 13
utkv 17 va
utkv 32 ro
utend r
end
fn main to int
scinit
scalloc VA4 8192 PG4
scbind VA4 PA4
scmap VA4 PA4 8192 PG4 2
utwalk VA4 PG4
utwalk add VA4 PG4 PG4
scmap VA4 PA4 PG4 PG4 2
scmap add VA4 1 PA4 PG4 PG4 2
scmap VA4B UVPOOL PG4 PG4 2
scmap VA4 PA4 0 PG4 2
scmap VA4 PA4 36864 PG4 2
scalloc VA4B PG4 PG4
scbind VA4B add PA4 8192
scmap VA4B add PA4 8192 PG4 PG4 2
utwalk VA4B PG4
scalloc VA64 PG64 PG64
scbind VA64 PA64
scmap VA64 PA64 PG64 PG64 2
utwalk VA64 PG64
scalloc VA2 PG2 PG2
scbind VA2 PA2
scmap VA2 PA2 PG2 PG2 2
utwalk VA2 PG2
scmap add VA4 536870912 add PA2 PG2 PG4 PG4 2
utwalk add VA4 536870912 PG4
scunmap VA4 8192 PG4
utwalk VA4 PG4
scmap VA4 PA64 PG64 PG64 2
scfit PG4 PG4
put uvfen 0 1
put uvfval 0 1
utfault VA4 7 1 1 0 0
utwalk VA4 PG4
utfault add VA4 PG4 8 1 1 1 0
utwalk add VA4 PG4 PG4
utfault VA4 9 1 1 0 0
put uvfval 0 0
utfault VA4 10 1 1 0 0
put uvfen 0 0
put uvfval 0 1
utfault VA4 11 1 1 0 0
put uvfen 0 1
utfault VA4 12 1 0 0 0
utfault VA4 13 3 1 0 0
utfault add VA2 PG2 14 1 1 0 0
scalloc add VA2 PG2 PG4 PG4
utfault add VA2 PG2 15 1 1 0 0
scprot VA64 1
scunmap VA64 PG64 PG64
utfault VA64 16 1 1 1 0
utwalk VA64 PG64
utfault VA64 17 1 1 0 0
utwalk VA64 PG64
scunmap VA4 8192 PG4
scunmap VA4 PG4 PG4
scunmap add VA4 1 PG4 PG4
scalloc VA4 PG4 PG4
scalloc 4096 PG4 PG4
scbind VA4 1
scprot 1 1
utfrag 15
utend 0
ret 0
end

note tests/compute_trace.om: comprehensive self-test for GB20B compute bring-up RPCs,
note channel 0xca6f / 0xc96f selection, BLACKWELL_COMPUTE_B (0xcec0), usermode (0xc361/0xc661),
note SET_GUEST_SYSTEM_INFO (RPC 1), GET_GSP_STATIC_INFO (RPC 65), SET_REGISTRY (RPC 73)
note canonical PACKED_REGISTRY_TABLE (verified with arena.om arregok), GSP_RM_ALLOC (103),
note GSP_RM_CONTROL (76), GB20B bit-30 work-submit token, INC_METHOD pushbuffer,
note GP entry (LEVEL bit 41), USERD GPPut (+0x8C), and BAR0/usermode doorbell kick.
note Build:
note   cat gpu/driver/chan/dma.om gpu/driver/chan/gmmu.om gpu/driver/chan/mem.om \
note       gpu/driver/chan/chan.om gpu/driver/chan/sim.om gpu/driver/gsp/rpc.om \
note       gpu/driver/gsp/replay.om gpu/driver/gsp/sysinfo.om gpu/driver/chan/params.om \
note       gpu/driver/gsp/boot.om gpu/driver/gsp/arena.om gpu/driver/gsp/compute.om \
note       gpu/driver/tests/compute_trace.om | seed/out/omc > compute_trace
note Prefix tb / TB. Host replay ONLY; never touches real hardware.
const TBPA ulong 2147483648
const TBMEM ulong 8388608
const TBGPVA ulong 8589934592
const TBQMDVA ulong 8589938688
const TBSEMVA ulong 8589942784
const TBTOK20 ulong 1073938474
const TBTOK10 ulong 196650
const TBHCLI ulong 3254779905
const TBHDEV ulong 3254779906
const TBHSUB ulong 3254779907
const TBHTSG ulong 3254779910
const TBHCHAN ulong 3254779914
const TBHCMP ulong 3254779915
const TBHUM ulong 3254779916
text TBTBIN "TestBin"
text TBTSTR "TestStr"
text TBGVER "580.173.02"
text TBGBRN "r580_gb20b"
text TBGOS "aienux-arm64"
text TBPASS "PASS compute_trace\n"

fn tbck yes bool to void
if not yes
trap 1
end
end

note Peer reply frame helpers (mirroring rpc_trace.om)
fn tbfzero n ulong to void
for i ulong mul div add n 4175 4096 4096
put rqtmp i 0
end
end

fn tbfdata n ulong to void
for i ulong n
put rqtmp add 80 i get rqpay i
end
rqput32 2 32 rqsum 2 mul div add n 87 8 8
end

fn tbfpub n ulong to void
wr = rqget32 1 16
e = div add n 4175 4096
for i ulong mul e 4096
o = rem add wr div i 4096 63
o = add 4096 mul o 4096
o = add o rem i 4096
put rqstat o get rqtmp i
end
rqput32 1 16 rem add wr e 63
end

fn tbf f ulong n ulong seq ulong res ulong priv ulong to void
tbfzero n
rqput32 2 36 ulong get rqrx 0
rqput32 2 40 div add n 4175 4096
rqput32 2 48 RQVER
rqput32 2 52 RQSIG
rqput32 2 56 add 32 n
rqput32 2 60 f
rqput32 2 64 res
rqput32 2 68 priv
rqput32 2 72 seq
tbfdata n
tbfpub n
end

fn tbackalloc to void
rqclear add 32 get bplen 0
for i ulong 4
rqput32 4 mul i 4 get bhead i
end
rqput32 4 20 get bplen 0
tbf 103 32 get bseq 0 0 0
end

fn tbconsts to void
tbck eq PACGPF 51567
tbck eq PACGPFB 51823
tbck eq PACCMP 52928
tbck eq PACUMVA 50017
tbck eq PACUMHA 50785
tbck eq PACMSCH 2691432705
tbck eq PACMWST 3278831880
tbck eq PASZCHAN 368
tbck eq PASZSCH 3
tbck eq PASZWST 4
tbck eq CBSZGUEST 792
tbck eq pacgpcls false 51567
tbck eq pacgpcls true 51823
tbck eq chcls false 51567
tbck eq chcls true 51823
tbck eq paempty 0
tbck eq get palen 0 0
tbck eq pawstreq 4
tbck eq get palen 0 4
tbck eq get pabuf 0 255
tbck eq get pabuf 1 255
tbck eq get pabuf 2 255
tbck eq get pabuf 3 255
put pareply 0 42
put pareply 1 0
put pareply 2 3
put pareply 3 64
tbck eq pawstdec 4 long TBTOK20
tbck eq pawstdec 3 PAELEN
end

fn tbreg to void
cbrinit
tbck eq cbrbuild 0
tbck eq cbradddw 0 1 CBEINVAL
put cbrkin 0 65
put cbrkin 1 0
tbck eq cbradddw 2 1 CBEINVAL
tbck eq cbradddw 1 add CBU32MAX 1 CBERANGE
tbck eq cbraddbin 1 0 CBERANGE
tbck eq cbraddstr 1 0 CBERANGE
tbck eq cbraddkey 6 0 CBERANGE
tbck eq cbrgb20b 6 0 CBERANGE
tbck eq cbrgb20b 2 2 CBERANGE
cbrinit
tbck eq cbrgb20b 3 1 CBOK
for i ulong len TBTBIN
put cbrkin i get TBTBIN i
end
put cbrvin 0 17
put cbrvin 1 34
put cbrvin 2 51
put cbrvin 3 68
tbck eq cbraddbin len TBTBIN 4 CBOK
for i ulong len TBTSTR
put cbrkin i get TBTSTR i
end
put cbrvin 0 111
put cbrvin 1 107
put cbrvin 2 0
tbck eq cbraddstr len TBTSTR 3 CBOK
tot = cbrbuild
tbck eq tot 265
tbck eq rqget32 4 0 265
tbck eq rqget32 4 4 8
tbck eq rqget32 4 8 136
tbck eq get rqpay 12 1
tbck eq rqget32 4 16 1
tbck eq rqget32 4 20 4
tbck eq rqget32 4 24 154
tbck eq rqget32 4 32 3
tbck eq rqget32 4 88 225
tbck eq rqget32 4 96 1
tbck eq rqget32 4 104 242
tbck eq get rqpay 108 2
tbck eq rqget32 4 112 250
tbck eq rqget32 4 116 4
tbck eq get rqpay 250 17
tbck eq get rqpay 253 68
tbck eq rqget32 4 120 254
tbck eq get rqpay 124 3
tbck eq rqget32 4 128 262
tbck eq rqget32 4 132 3
tbck eq get rqpay 262 111
tbck eq get rqpay 264 0
note Cross-check canonical table against arena.om arregok validator
for i ulong ulong tot
put arreg i get rqpay i
end
put arcfg 9 ulong tot
tbck arregok
end

fn tbguest to void
tbck eq cbguestinit add CBU32MAX 1 0 0 CBERANGE
tbck eq cbguestinit 1 2 3 792
tbck eq rqget32 4 0 1
tbck eq rqget32 4 4 2
tbck eq rqget32 4 20 3
tbck eq cbgueststr 3 1 CBERANGE
tbck eq cbgueststr 0 257 CBERANGE
for i ulong len TBGVER
put cbstrin i get TBGVER i
end
tbck eq cbgueststr 0 len TBGVER CBOK
for i ulong len TBGBRN
put cbstrin i get TBGBRN i
end
tbck eq cbgueststr 1 len TBGBRN CBOK
for i ulong len TBGOS
put cbstrin i get TBGOS i
end
tbck eq cbgueststr 2 len TBGOS CBOK
tbck eq rqget32 4 8 len TBGVER
tbck eq rqget32 4 12 len TBGBRN
tbck eq rqget32 4 16 len TBGOS
tbck eq get rqpay 24 53
tbck eq get rqpay 280 114
tbck eq get rqpay 536 97
end

fn tbboot to void
tbck eq breset 0
tbck eq bsys 0
tbreg
tbck eq breg 265 0
tbck eq bstart 40 128 0
rqpeer
rqclear 0
tbf 4097 0 0 0 0
tbck eq bpoll 1
tbck eq get bstate 0 5
tbguest
tbck eq bguest 0
tbf 1 792 get bseq 0 0 0
tbck eq bpoll 1
tbck eq get bstate 0 7
tbck eq cbstaticprep 0 CBERANGE
tbck eq cbstaticprep 128 128
tbck eq bstatic 0
rqclear 128
rqput32 4 0 580
rqput32 4 64 2564
tbf 65 128 get bseq 0 0 0
tbck eq bpoll 1
tbck eq get bstate 0 9
tbck eq cbstaticrd32 0 580
tbck eq cbstaticrd32 64 2564
tbck eq cbstaticrd32 125 CBERANGE
end

fn tbrmrpcs to void
for k ulong 48
put pain k 0
end
put pain 1 TBGPVA
put pain 2 64
put pain 8 PAENGGR
put pain 11 TBHTSG
put pain 15 42
tbck eq cballocch TBHCLI TBHDEV TBHCHAN true 4 0
tbck eq get bhead 3 51823
tbck eq get bplen 0 368
tbackalloc
tbck eq bpoll 1
tbck eq cballocch TBHCLI TBHDEV TBHCHAN false 4 0
tbck eq get bhead 3 51567
tbck eq get bplen 0 368
tbackalloc
tbck eq bpoll 1
tbck eq cballoccmp TBHCLI TBHCHAN TBHCMP 4 0
tbck eq get bhead 3 52928
tbck eq get bplen 0 0
tbackalloc
tbck eq bpoll 1
tbck eq cballocum TBHCLI TBHSUB TBHUM 4660 4 CBEINVAL
tbck eq cballocum TBHCLI TBHSUB TBHUM CBCUMVA 4 0
tbck eq get bhead 3 50017
tbck eq get bplen 0 0
tbackalloc
tbck eq bpoll 1
tbck eq cballocum TBHCLI TBHSUB TBHUM CBCUMHA 4 0
tbck eq get bhead 3 50785
tbck eq get bplen 0 0
tbackalloc
tbck eq bpoll 1
tbck eq cbsched TBHCLI TBHTSG 1 0 0 4 0
tbck eq get bhead 2 2691432705
tbck eq get bplen 0 3
rqclear 43
rqput32 4 0 TBHCLI
rqput32 4 4 TBHTSG
rqput32 4 8 CBCMSCH
rqput32 4 12 0
rqput32 4 16 3
tbf 76 43 get bseq 0 0 0
tbck eq bpoll 1
tbck eq cbgetwst TBHCLI TBHCHAN 4 0
tbck eq get bhead 2 3278831880
tbck eq get bplen 0 4
rqclear 44
rqput32 4 0 TBHCLI
rqput32 4 4 TBHCHAN
rqput32 4 8 CBCMWST
rqput32 4 12 0
rqput32 4 16 4
rqput32 4 40 TBTOK20
tbf 76 44 get bseq 0 0 0
tbck eq bpoll 1
tbck eq cbdecwst long TBTOK20
end

fn tbtoken to void
tbck eq ulong chtoken 3 42 TBTOK10
tbck eq ulong chtokgb20 3 42 TBTOK20
tbck eq cbtoken 3 42 long TBTOK20
tbck eq cbtoken 0 0 1073741824
tbck eq cbtoken 127 4095 1082068991
tbck eq cbtoken 128 0 CBERANGE
tbck eq cbtoken 0 4096 CBERANGE
tbck eq chsettok 4 uint TBTOK20 CHEINVAL
end

fn tbpbkick to void
r = mmwinit TBPA TBMEM
tbck eq r MMOK
gsinit TBPA TBMEM
put mmmode 0 0
cbpbinit
tbck eq cbpbsetup 52928 CBOK
for i ulong 96
put cbqmd i uint add 1000 i
end
tbck eq cbpbiqmd 128 CBEALIGN
tbck eq cbpbiqmd CBVALIM CBERANGE
tbck eq cbpbiqmd TBQMDVA CBOK
tbck eq cbpbl2flush CBOK
tbck eq cbpbsem 0 1 true CBERANGE
tbck eq cbpbsem 2 1 true CBEALIGN
tbck eq cbpbsem TBSEMVA 305419896 true CBOK
tbck eq get cbpblen 0 112
tbck eq get cbpb 0 536944737
tbck eq get cbpb 1 52928
tbck eq get cbpb 2 543301830
tbck eq get cbpb 3 1073741824
tbck eq get cbpb 4 33554448
tbck eq get cbpb 5 1000
tbck eq get cbpb 100 1095
tbck eq get cbpb 101 537133066
tbck eq get cbpb 105 2147483648
tbck eq get cbpb 106 537198615
tbck eq get cbpb 107 8192
tbck eq get cbpb 108 2
tbck eq get cbpb 109 305419896
tbck eq get cbpb 110 0
tbck eq get cbpb 111 1048577
pbpa = add TBPA 4096
gppa = add TBPA 8192
udpa = add TBPA 12288
umpa = add TBPA 16384
tbck eq cbpbflush pbpa 112
tbck eq mmrd32 pbpa 536944737
tbck eq mmrd32 add pbpa 444 1048577
tbck cbgpentok TBGPVA 112
tbck not cbgpentok add TBGPVA 2 112
tbck not cbgpentok TBGPVA 0
tbck not cbgpentok TBGPVA 2097152
tbck not cbgpentok CBVALIM 112
gpe = cbgpent TBGPVA 112
tbck eq gpe 494788822433792
tbck ne and gpe CBGPB41 0
next = cbkickbar0 gppa udpa gpe 0 16 uint TBTOK20
tbck eq next 1
tbck eq mmrd64 gppa gpe
tbck eq mmrd32 add udpa 140 1
tbck eq get gsdb 0 1
tbck eq get gslogo 0 uint CBDBBAR0
tbck eq get gslogv 0 uint TBTOK20
tbck eq cbkickum udpa umpa 2 uint TBTOK20 CBOK
tbck eq mmrd32 add udpa 140 2
tbck eq mmrd32 add umpa 144 TBTOK20
end

fn main to int
tbconsts
tbboot
tbrmrpcs
tbtoken
tbpbkick
r = write 1 TBPASS 0 len TBPASS
tbck eq r long len TBPASS
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/driver/tests/irqcc_trace.om: Host-only self-test for irq.om + irqcc.om + logdec.om (OM-1).
note Build: cat gpu/driver/gsp/logdec.om gpu/driver/gsp/irqsim.om gpu/driver/gsp/irq.om gpu/driver/gsp/irqcc.om gpu/driver/tests/irqcc_trace.om | seed/out/omc > irqcc_trace
note Never opens devices, maps MMIO, or performs DMA. Uses synthetic IRQ + CrashCat fixtures only.

const CTRPTHDR ulong 14587176806713922100
const CTCSRHDR ulong 14587183390898804344
const CTBADHDR ulong 13758233000301035520

text CTPASS "IRQCC TEST PASS 6/6\n"

fn ctput64w o ulong v ulong to void
for i ulong 8
put lgwpr add o i uchar and shr v mul i 8 255
end
end

fn ctput64c o ulong v ulong to void
for i ulong 8
put ccbuf add o i uchar and shr v mul i 8 255
end
end

fn ctput64b o ulong v ulong to void
for i ulong 8
put lgbuf add o i uchar and shr v mul i 8 255
end
end

note Reset host-model irq.om and irqsim.om globals between synthetic test cases.
fn ctreset to void
put iqmode 0 0
put iqstate 0 0
put iqgen 0 0
put iqdone 0 0
put iqpend 0 0
put iqhalt 0 0
put iqccbound 0 0
put iqccpa 0 0
put iqccsz 0 0
put iqccpkts 0 0
put iqccerr 0 0
put israw 0 0
put ismask 0 255
put isdest 0 255
put iscnt 0 0
put isdone 0 0
put isedge 0 0
put isfail 0 0
put islock 0 0
put istail 0 0
put ispm 0 0
put isacks 0 0
put isreads 0 0
put ismasks 0 0
put isviol 0 0
put islocked 0 0
end

note ---- Test 1: HALT IRQ with NO CrashCat buffer bound preserves quarantine ----
fn cttest1 to bool
ctreset
if ne iqinit 7 0
ret false
end
put israw 0 16
r = iqservicecc 7 4 -1 16
if ne r -13
ret false
end
if ne get iqstate 0 2
ret false
end
if ne get iqhalt 0 1
ret false
end
if ne get ismasks 0 1
ret false
end
if ne get isacks 0 0
ret false
end
if ne get israw 0 16
ret false
end
if ne get iqccpkts 0 0
ret false
end
if ne get iqccerr 0 0
ret false
end
ret true
end

note ---- Test 2: HALT|SWGEN0 with bound linear CrashCat buffer (REPORT + RISCV64_CSR + lgfmtcc) ----
fn cttest2 to bool
ctreset
if ne iqinit 7 0
ret false
end
note Packet 0 (48 B): REPORT (sig=0xCA70, ver=1, type=0, plen=5, hdata=0x1234)
ctput64c 0 CTRPTHDR
ctput64c 8 111
ctput64c 16 222
ctput64c 24 333
ctput64c 32 444
ctput64c 40 555
note Packet 1 (24 B): RISCV64_CSR (sig=0xCA70, ver=1, type=6, plen=2, hdata=0x5678)
ctput64c 48 CTCSRHDR
ctput64c 56 768
ctput64c 64 4096
if ne iqccbind 1 1048576 72 0
ret false
end
put israw 0 80
r = iqservicecc 7 4 1 16
if ne r -13
ret false
end
if ne get iqstate 0 2
ret false
end
if ne get iqhalt 0 1
ret false
end
if ne get ismasks 0 1
ret false
end
if ne get isacks 0 0
ret false
end
if ne get iqccpkts 0 2
ret false
end
if ne get iqccerr 0 0
ret false
end
if ne get cctype 0 CCTCSR
ret false
end
if ne get ccplen 0 2
ret false
end
if ne get ccpay 0 768
ret false
end
if ne get ccpay 1 4096
ret false
end
if ne get lgoerr 0 0
ret false
end
ret true
end

note ---- Test 3: HALT IRQ with GspFwWprMeta-bound paged LibosLog ring CrashCat buffer ----
fn cttest3 to bool
ctreset
if ne iqinit 7 0
ret false
end
for i ulong LGWPRSZ
put lgwpr i 0
end
ctput64w 0 LGWPRMAG
ctput64w 8 1
ctput64w LGCCQPA 2097152
ctput64w LGCCQSZ 8192
if ne iqccbindwpr 2 1
ret false
end
for i ulong 8192
put lgbuf i 0
end
note Ring put = 48 B; 1 REPORT packet at lgbuf[4096..4144)
ctput64b 0 48
ctput64b 4096 CTRPTHDR
ctput64b 4104 1001
ctput64b 4112 2002
ctput64b 4120 3003
ctput64b 4128 4004
ctput64b 4136 5005
put israw 0 16
r = iqservicecc 7 4 -1 16
if ne r -13
ret false
end
if ne get iqstate 0 2
ret false
end
if ne get iqhalt 0 1
ret false
end
if ne get iqccpkts 0 1
ret false
end
if ne get iqccerr 0 0
ret false
end
if ne get cctype 0 CCTRPT
ret false
end
if ne get ccrsrc 0 1001
ret false
end
if ne get ccrcse 0 2002
ret false
end
if ne get ccrext 0 3003
ret false
end
if ne get ccrts 0 4004
ret false
end
if ne get ccrver 0 5005
ret false
end
ret true
end

note ---- Test 4: Negative control - HALT IRQ with bad CrashCat signature still quarantines ----
fn cttest4 to bool
ctreset
if ne iqinit 7 0
ret false
end
ctput64c 0 CTBADHDR
if ne iqccbind 1 1048576 48 0
ret false
end
put israw 0 16
r = iqservicecc 7 4 -1 16
if ne r -13
ret false
end
if ne get iqstate 0 2
ret false
end
if ne get iqhalt 0 1
ret false
end
if ne get ismasks 0 1
ret false
end
if ne get iqccpkts 0 0
ret false
end
if ne get iqccerr 0 -10
ret false
end
ret true
end

note ---- Test 5: Normal SWGEN0 IRQ with CrashCat bound drains RPC without CrashCat decode ----
fn cttest5 to bool
ctreset
if ne iqinit 7 0
ret false
end
if ne iqccbind 1 1048576 48 0
ret false
end
put israw 0 64
put iscnt 0 2
r = iqservicecc 7 4 -1 16
if ne r 2
ret false
end
if ne get iqstate 0 1
ret false
end
if ne get iqhalt 0 0
ret false
end
if ne get isacks 0 1
ret false
end
if ne get iqccpkts 0 0
ret false
end
if ne get iqccerr 0 0
ret false
end
ret true
end

note ---- Test 6: Unknown non-HALT IRQ (bit 5 = 32) quarantines without CrashCat decode ----
fn cttest6 to bool
ctreset
if ne iqinit 7 0
ret false
end
if ne iqccbind 1 1048576 48 0
ret false
end
put israw 0 32
r = iqservicecc 7 4 -1 16
if ne r -13
ret false
end
if ne get iqstate 0 2
ret false
end
if ne get iqhalt 0 0
ret false
end
if ne get ismasks 0 1
ret false
end
if ne get iqccpkts 0 0
ret false
end
if ne get iqccerr 0 0
ret false
end
ret true
end

fn main to int
if not cttest1
ret 1
end
if not cttest2
ret 2
end
if not cttest3
ret 3
end
if not cttest4
ret 4
end
if not cttest5
ret 5
end
if not cttest6
ret 6
end
w = write 1 CTPASS 0 len CTPASS
if ne w long len CTPASS
ret 20
end
ret 0
end

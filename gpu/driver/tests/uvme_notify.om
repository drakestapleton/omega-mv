note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Host eventfd and model ring only: no VFIO/device word is called.
fn main to int
if ne screate UVOK
ret 18
end
if ne sadd UVBASE UV4K UVBASE 1 UVOK
ret 19
end
put iqcmode 0 1
put iqcstate 0 1
cap = unirqmk
if not unvalid cap
ret 1
end
r = unpump cap 0
if ne r 0
ret 2
end
for j ulong 32
put uvpkt j 0
end
note Valid replayable read fault, VA=UVBASE. Word7 = valid|MMU-enabled|replay|kind1.
put uvpkt 12 1
put uvpkt 28 129
put uvpkt 31 192
r = unpost cap
if ne r 0
ret 3
end
r = unpost cap
if ne r 0
ret 4
end
r = unpump cap 0
if ne r 1
ret 5
end
if ne get unwakes 0 2
ret 6
end
if ne get fbn 0 1
ret 7
end
if ne get fbget 0 2
ret 8
end
note The eventfd drain ran the real model service: PTE then invalidate then replay.
if or ne get sen 0 1 ne get sev 2 UVREPLAY
ret 20
end
if ne uvread UVBASE UV4K UVMAPPED
ret 21
end
if ne get uvdpa 0 UVBASE
ret 22
end
if ne iqctake 1
ret 23
end
if or ne iqcget 0 2 ne iqcget 2 UVBASE
ret 24
end
if ne iqcack iqcget 1 0
ret 25
end
if ne iqctake 1
ret 26
end
if or ne iqcget 0 1 ne iqcget 2 UVBASE
ret 27
end
if ne iqcack iqcget 1 0
ret 28
end
if ne unpump cap 0 0
ret 9
end
for j ulong 16
r = unpost cap
if ne r 0
ret 10
end
end
r = unpost cap
if ne r long UVENOM
ret 11
end
if ne get fbov 0 1
ret 12
end
if ne unpump cap 0 1
ret 13
end
if ne get unwakes 0 18
ret 14
end
if ne unclose cap 0
ret 15
end
if ne unpump cap 0 neg long 9
ret 16
end
if unvalid unirqmk
ret 17
end
ret 0
end

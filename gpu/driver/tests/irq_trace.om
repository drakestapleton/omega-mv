note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Host-only fixture. A new process is a new model lifetime; never resets a live handler.
global itinp uchar 16
global itout uchar 128
fn itput off ulong v ulong to void
for i ulong 8
put itout add off i uchar and shr v mul i 8 255
end
end
fn itstatus off ulong r long to void
itput off ulong add r 32
end
fn main to int
n = read 0 itinp 0 16
if ne n 16
ret 2
end
put israw 0 uint get itinp 0
put ismask 0 uint get itinp 1
put isdest 0 uint get itinp 2
put iscnt 0 ulong get itinp 3
put isedge 0 ulong get itinp 5
put isfail 0 ulong get itinp 6
put islock 0 ulong get itinp 7
put istail 0 ulong get itinp 8
put ispm 0 ulong get itinp 9
put iqmode 0 ulong get itinp 10
r = iqinit 7
if ne r 0
ret 3
end
gen = ulong 7
if ne get itinp 11 0
gen = 8
end
r = iqservice gen ulong get itinp 4
itstatus 0 r
itput 8 get iqstate 0
itput 16 ulong get iqpend 0
itput 24 get iqdone 0
itput 32 get isdone 0
itput 40 ulong get israw 0
itput 48 get isacks 0
itput 56 get isreads 0
itput 64 get ismasks 0
if ne get itinp 12 0
r = iqservice 7 ulong get itinp 4
else
r = iqinit 8
end
itstatus 72 r
itput 80 ulong get iqpend 0
itput 88 get isdone 0
itput 96 get isacks 0
itput 104 get isreads 0
itput 112 get ismasks 0
itput 120 get isviol 0
n = write 1 itout 0 128
if ne n 128
ret 4
end
ret 0
end

note Device-free caller. Read the seven verified firmware spans; emit the anonymous staged bytes and COT.
note The first byte selects a normal cap (0), a 16 MiB cap (1), or dirty high output bytes (2).
global alchunk uchar 65536
fn alread n ulong to bool
p = ulong 0
while lt p n bound 65536
r = read 0 alchunk p sub n p
if lt r 1
ret false
end
p = add p ulong r
end
ret true
end
fn alwrite n ulong to bool
p = ulong 0
while lt p n bound 65536
r = write 1 alchunk p sub n p
if lt r 1
ret false
end
p = add p ulong r
end
ret true
end
fn alspan pos ulong n ulong to bool
while gt n 0 bound 2048
k = n
if gt k 65536
k = ulong 65536
end
if not alread k
ret false
end
for i ulong k
arinput add pos i get alchunk i
end
pos = add pos k
n = sub n k
end
ret true
end
fn main to int
if not alread 1
ret 1
end
mode = get alchunk 0
if gt mode 3
ret 1
end
put arcfg 0 2
put arcfg 1 40
put arcfg 2 268435456
put arcfg 3 8192
put arcfg 6 61440
put arcfg 7 2560
for i ulong 3
put arpkg i 2
end
put arbase 0 1048576
put arcap 0 ARMAX
if eq mode 1
put arcap 0 ARLOW
end
put arslen 0 74969088
put arslen 1 4096
put arslen 2 212992
put arslen 3 212296
put arslen 4 48
put arslen 5 384
put arslen 6 384
note Skew the input three bytes so the packed word boundary differs from the output.
pos = ulong 3
if eq mode 3
pos = ulong 0
end
for i ulong 7
put arsrc i pos
if not alspan pos get arslen i
ret 2
end
pos = add pos get arslen i
end
if ne read 0 alchunk 0 1 0
ret 2
end
if eq mode 2
for page ulong 16384
put aroword mul page 512 not ulong 0
end
end
rc = arbuild
if ne rc 0
if eq rc -3
ret 3
end
ret 4
end
used = get arused 0
h = mapnew -1 0 used 3 33
if lt h 0
ret 5
end
if not arstdata h used
ret 6
end
o = ulong 0
while lt o used bound 2048
k = sub used o
if gt k 65536
k = ulong 65536
end
if ne mapread h o alchunk 0 k long k
ret 7
end
if not alwrite k
ret 8
end
o = add o k
end
if ne mapdrop h 0
ret 9
end
for i ulong get arclen 0
put alchunk i get arcot i
end
if not alwrite get arclen 0
ret 8
end
ret 0
end

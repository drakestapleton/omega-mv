note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/driver/tests/logdec_trace.om: Host-only self-test and fixture suite for gsp/logdec.om (OM-1).
note Build: cat gpu/driver/gsp/logdec.om gpu/driver/tests/logdec_trace.om | seed/out/omc > logdec_trace
note Never opens a device, maps MMIO, or touches hardware. Uses synthetic GB20B fixtures only.

text LTPASS "LOGDEC TEST PASS 12/12\n"

note ---- Fixture writers for lgtbuf, lgwpr, lgrma, lgbuf, ccbuf ----

fn ltput64t o ulong v ulong to void
for i ulong 8
put lgtbuf add o i uchar and shr v mul i 8 255
end
end

fn ltput64w o ulong v ulong to void
for i ulong 8
put lgwpr add o i uchar and shr v mul i 8 255
end
end

fn ltput64r o ulong v ulong to void
for i ulong 8
put lgrma add o i uchar and shr v mul i 8 255
end
end

fn ltput32r o ulong v ulong to void
for i ulong 4
put lgrma add o i uchar and shr v mul i 8 255
end
end

fn ltput64b o ulong v ulong to void
for i ulong 8
put lgbuf add o i uchar and shr v mul i 8 255
end
end

fn ltput64c o ulong v ulong to void
for i ulong 8
put ccbuf add o i uchar and shr v mul i 8 255
end
end

note Write one u64 into the 61440-byte wrapped ring data area at logical offset pos (hdr=4096).
fn ltrput pos ulong v ulong to void
off = add LGPAGE rem pos 61440
ltput64b off v
end

note ---- Test 1: LibosMemoryRegionInitArgument 8-entry table + negative control ----
fn lttest1 to bool
for i ulong LGPAGE
put lgtbuf i 0
end
base = ulong 1048576
ltput64t 0 LGIDINIT
ltput64t 8 base
ltput64t 16 65536
put lgtbuf 24 1
put lgtbuf 25 1
ltput64t 32 LGIDINTR
ltput64t 40 add base 65536
ltput64t 48 65536
put lgtbuf 56 1
put lgtbuf 57 1
ltput64t 64 LGIDRM
ltput64t 72 add base 131072
ltput64t 80 65536
put lgtbuf 88 1
put lgtbuf 89 1
ltput64t 96 LGIDMNOC
ltput64t 104 add base 196608
ltput64t 112 65536
put lgtbuf 120 1
put lgtbuf 121 1
ltput64t 128 LGIDDBG
ltput64t 136 add base 262144
ltput64t 144 65536
put lgtbuf 152 1
put lgtbuf 153 1
ltput64t 160 LGIDROOT
ltput64t 168 add base 327680
ltput64t 176 4096
put lgtbuf 184 1
put lgtbuf 185 1
ltput64t 192 LGIDKRNL
ltput64t 200 add base 331776
ltput64t 208 65536
put lgtbuf 216 1
put lgtbuf 217 1
ltput64t 224 LGIDARGS
ltput64t 232 add base 397312
ltput64t 240 4096
put lgtbuf 248 1
put lgtbuf 249 1
rc = lgtabparse LGPAGE
if ne rc 8
ret false
end
for i ulong 8
if ne lgkind get lgtid i long i
ret false
end
end
if ne get lgtsz 5 4096
ret false
end
if ne get lgtsz 7 4096
ret false
end
lgfmtreg 0
note Negative control: non-zero reserved byte must be refused (-2)
put lgtbuf 26 1
if ne lgtabparse LGPAGE -2
ret false
end
put lgtbuf 26 0
note Negative control: bad kind must be refused (-3)
put lgtbuf 24 2
if ne lgtabparse LGPAGE -3
ret false
end
ret true
end

note ---- Test 2: Paged log buffer page-table validator (arena.om:arlogpt) ----
fn lttest2 to bool
for i ulong LGPAGE
put lgbuf i 0
end
pa = ulong 2097152
for j ulong 16
ltput64b add 8 mul j 8 add pa mul j LGPAGE
end
if ne lgptchk pa 65536 0
ret false
end
note Negative control: corrupt page 7 entry must be refused (-2)
ltput64b add 8 mul 7 8 add pa 12345
if ne lgptchk pa 65536 -2
ret false
end
ret true
end

note ---- Test 3: GspFwWprMeta CrashCat queue locator (offsets 224/232) ----
fn lttest3 to bool
for i ulong LGWPRSZ
put lgwpr i 0
end
ltput64w 0 LGWPRMAG
ltput64w 8 1
if ne lgwprparse 0
ret false
end
ltput64w LGCCQPA 4194304
ltput64w LGCCQSZ 4096
if ne lgwprparse 1
ret false
end
if or ne get lgccqpa 0 4194304 ne get lgccqsz 0 4096
ret false
end
note Negative controls: bad magic (-1), unaligned PA (-2)
ltput64w 0 999
if ne lgwprparse -1
ret false
end
ltput64w 0 LGWPRMAG
ltput64w LGCCQPA 4194305
if ne lgwprparse -2
ret false
end
ret true
end

note ---- Test 4: RMARGS (GSP_ARGUMENTS_CACHED) parser ----
fn lttest4 to bool
for i ulong LGRMASZ
put lgrma i 0
end
ltput64r 0 8388608
ltput32r 8 129
ltput64r 16 4096
ltput64r 24 266240
ltput32r 44 3
put lgrma 48 1
ltput64r 72 268435456
ltput64r 80 139460608
if ne lgrmargs 0
ret false
end
if or ne get lgrmout 0 8388608 ne get lgrmout 1 129
ret false
end
if or ne get lgrmout 2 4096 ne get lgrmout 3 266240
ret false
end
if or ne get lgrmout 4 3 ne get lgrmout 5 1
ret false
end
if or ne get lgrmout 6 268435456 ne get lgrmout 7 139460608
ret false
end
note Negative control: unaligned sharedMemPhysAddr refused (-1)
ltput64r 0 8388609
if ne lgrmargs -1
ret false
end
ret true
end

note ---- Test 5: LibosLog framed records (timestamp + 3 args, then no-ts + 0 args) ----
fn lttest5 to bool
for i ulong 65536
put lgbuf i 0
end
if ne lgrinit 65536 LGPAGE 0
ret false
end
note Record 1: fmt=0x20001000, argc=3, lvl=2, flg=1 (has_ts), ts=987654321, args=[11,22,33]
ltrput 0 1297881118149709824
ltrput 8 987654321
ltrput 16 11
ltrput 24 22
ltrput 32 33
note Record 2: fmt=0x20002040, argc=0, lvl=4, flg=0 (no ts)
ltrput 40 288230376688590912
ltput64b 0 48
if ne lgnext 1
ret false
end
if or ne get lgfmt 0 536875008 ne get lgargc 0 3
ret false
end
if or ne get lglvl 0 2 ne get lgts 0 987654321
ret false
end
if or ne get lgargs 0 11 ne get lgargs 2 33
ret false
end
lgfmtlog
if ne lgnext 1
ret false
end
if or ne get lgfmt 0 536879168 ne get lgargc 0 0
ret false
end
if or ne get lglvl 0 4 ne get lgts 0 0
ret false
end
if ne lgnext 0
ret false
end
ret eq get lgget 0 48
end

note ---- Test 6: LibosLog ring wrap-around straddling 61440 boundary ----
fn lttest6 to bool
if ne lgrinit 65536 LGPAGE 0
ret false
end
if ne lgrsetget 61424 0
ret false
end
note 5 qwords (40 bytes) starting at 61424: 16 bytes at tail [61424,61432], 24 bytes wrapped [0,8,16]
ltrput 61424 1225823524111829758
ltrput 61432 555666777
ltrput 61440 101
ltrput 61448 202
ltrput 61456 303
ltput64b 0 61464
if ne lgnext 1
ret false
end
if or ne get lgfmt 0 536922878 ne get lgts 0 555666777
ret false
end
if or ne get lgargs 0 101 ne get lgargs 1 202
ret false
end
if ne get lgargs 2 303
ret false
end
ret eq get lgget 0 61464
end

note ---- Test 7: LibosLog overflow / drop recovery ----
fn lttest7 to bool
if ne lgrinit 65536 LGPAGE 0
ret false
end
note put = 61440 + 128 = 61568 while get = 0 -> 128 bytes dropped, get advances to 128
ltput64b 0 61568
ltrput 128 288230376688590912
av = lgrsync
if ne av 61440
ret false
end
if or ne get lgdrop 0 128 ne get lgwrap 0 1
ret false
end
if ne get lgget 0 128
ret false
end
if ne lgnext 1
ret false
end
ret eq get lgfmt 0 536879168
end

note ---- Test 8: LOGROOT 4 KiB zero-data buffer safety ----
fn lttest8 to bool
if ne lgrinit LGPAGE LGPAGE 0
ret false
end
ltput64b 0 0
if ne lgnext 0
ret false
end
ltput64b 0 8
ret eq lgnext -4
end

note ---- Test 9: Raw ELF-metadata-linked mode (lgpeek + lgnextraw) + LibosLog negative controls ----
fn lttest9 to bool
if ne lgrinit 65536 LGPAGE 0
ret false
end
ltrput 0 536875008
ltrput 8 424242
ltrput 16 77
ltrput 24 88
ltput64b 0 32
if ne lgpeek 1
ret false
end
if or ne get lgfmt 0 536875008 ne get lgget 0 0
ret false
end
if ne lgnextraw 2 1 1
ret false
end
if or ne get lgts 0 424242 ne get lgargs 1 88
ret false
end
note Negative control: unaligned put (-3)
ltput64b 0 37
if ne lgnext -3
ret false
end
note Negative control: put < get (-2)
ltput64b 0 16
if ne lgnext -2
ret false
end
note Negative control: argc > 20 (-5)
ltrput 32 5910975047794689
ltput64b 0 40
if ne lgnext -5
ret false
end
note Negative control: truncated framed record (-6)
ltrput 32 1297881118149709824
ltput64b 0 48
if ne lgnext -6
ret false
end
ret eq get lgget 0 32
end

note ---- Test 10: CrashCat V1 linear multi-packet stream (REPORT, CSR, GPR, TRACE, IO32, IO64) ----
fn lttest10 to bool
for i ulong 1024
put ccbuf i 0
end
o = ulong 0
note Packet 0: REPORT (plen=5, hdata=0x11223344)
ltput64c o 14587176807001371460
ltput64c add o 8 1001
ltput64c add o 16 2002
ltput64c add o 24 3003
ltput64c add o 32 4004
ltput64c add o 40 5005
o = add o 48
note Packet 1: RISCV64_CSR (plen=2)
ltput64c o 14587183390898782209
ltput64c add o 8 111
ltput64c add o 16 222
o = add o 24
note Packet 2: RISCV64_GPR (plen=31)
ltput64c o 14587184614964461570
for g ulong 31
ltput64c add o add 8 mul g 8 add g 100
end
o = add o 256
note Packet 3: RISCV64_TRACE (plen=3)
ltput64c o 14587185594217005059
ltput64c add o 8 536870912
ltput64c add o 16 536871000
ltput64c add o 24 536871100
o = add o 32
note Packet 4: IO32_STATE (plen=2)
ltput64c o 14587181191875526660
ltput64c add o 8 16045690981098520640
ltput64c add o 16 42
o = add o 24
note Packet 5: IO64_STATE (plen=2)
ltput64c o 14587182291387154437
ltput64c add o 8 8192
ltput64c add o 16 99999
o = add o 24
if ne ccinit o 0
ret false
end
if ne ccnext 1
ret false
end
if or ne get cctype 0 CCTRPT ne get cchdat 0 287454020
ret false
end
if or ne get ccrsrc 0 1001 ne get ccrver 0 5005
ret false
end
lgfmtcc
if ne ccnext 1
ret false
end
if or ne get cctype 0 CCTCSR ne get ccpay 1 222
ret false
end
if ne ccnext 1
ret false
end
if or ne get cctype 0 CCTGPR ne get ccpay 30 130
ret false
end
if ne ccnext 1
ret false
end
if or ne get cctype 0 CCTTRC ne get ccplen 0 3
ret false
end
if ne ccnext 1
ret false
end
if or ne ccpair_off 0 1114176 ne ccpair_val 0 3735928559
ret false
end
if ne ccnext 1
ret false
end
if or ne get cctype 0 CCTI64 ne get ccpay 1 99999
ret false
end
ret eq ccnext 0
end

note ---- Test 11: CrashCat packet wrapped across LibosLog ring boundary ----
fn lttest11 to bool
if ne lgrinit 65536 LGPAGE 0
ret false
end
if ne lgrsetget 61424 0
ret false
end
ltrput 61424 14587176807001371460
ltrput 61432 7001
ltrput 61440 7002
ltrput 61448 7003
ltrput 61456 7004
ltrput 61464 7005
ltput64b 0 61472
if ne ccnextring 1
ret false
end
if or ne get ccrsrc 0 7001 ne get ccrver 0 7005
ret false
end
ret eq get lgget 0 61472
end

note ---- Test 12: CrashCat negative controls ----
fn lttest12 to bool
if ne ccinit 64 0
ret false
end
note Bad signature (-10)
ltput64c 0 16045498661051826176
if ne ccnext -10
ret false
end
note Bad version (-11)
ltput64c 0 14587194398899961856
if ne ccnext -11
ret false
end
note Unknown type (-12)
ltput64c 0 14587186685138698240
if ne ccnext -12
ret false
end
note Short REPORT payload (-14)
ltput64c 0 14587176798123982848
if ne ccnext -14
ret false
end
note Odd IO64 payload (-14)
ltput64c 0 14587182295682121728
if ne ccnext -14
ret false
end
note Truncated REPORT packet (-13)
if ne ccinit 24 0
ret false
end
ltput64c 0 14587176807001371460
if ne ccnext -13
ret false
end
ret eq get ccpos 0 0
end

fn main to int
lgoinit 1
if not lttest1
ret 1
end
if not lttest2
ret 2
end
if not lttest3
ret 3
end
if not lttest4
ret 4
end
if not lttest5
ret 5
end
if not lttest6
ret 6
end
if not lttest7
ret 7
end
if not lttest8
ret 8
end
if not lttest9
ret 9
end
if not lttest10
ret 10
end
if not lttest11
ret 11
end
if not lttest12
ret 12
end
for i ulong len LTPASS
lgoc get LTPASS i
end
z = lgoflush
if ne z 0
ret 99
end
ret 0
end

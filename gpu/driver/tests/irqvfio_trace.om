note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Verification executable ONLY: owns a memfd, never opens a device path.
note A ptrace oracle substitutes GET_DEVICE_FD/IRQ/REGION responses for this memfd and checks every record.
text viname "ogd-irq-fixture"
text videv "model-device"
global vtarg uchar 8
global vtout uchar 128
fn vtword off ulong value ulong to void
for i ulong 8
put vtout add off i uchar and shr value mul i 8 255
end
end
fn vtstatus off ulong value long to void
vtword off ulong add value 128
end
fn vtfinish to int
vtword 72 get ilstate 0
vtword 80 get pvreg 0
vtword 88 get pvalloc 0
vtword 96 get pvmmlive 0
vtword 104 get vireg 0
vtword 112 get vialloc 0
vtword 120 get pvfx 0
r = write 1 vtout 0 128
if ne r 128
ret 2
end
ret 0
end
fn vtlease span mmspan mode ulong to int
start = ulong 3
count = ulong 1
if eq mode 12
start = 0
count = 64
end
if eq mode 13
start = 64
end
if eq mode 14
count = 0
end
if eq mode 15
start = 65
end
cap = irqlsmk 1 0 start count
vtstatus 8 get pverr 0
if ne get pverr 0 0
ret vtfinish
end
r = irattach cap span 1
if ne r 0
ret 3
end
r = irenable cap 1
vtstatus 16 r
if ne r 0
ret vtfinish
end
owner = hownermk cap 1
r = mmwrite span owner 1 0 uint 64
vtstatus 24 r
r = mmread span owner 1 0
vtstatus 32 r
r = irleave cap owner 1
if ne r 0
ret 4
end
r = viwait 0
vtstatus 40 r
r = vican
vtstatus 48 r
r = viwait 0
vtstatus 56 r
r = irrevoke cap 1
vtstatus 64 r
note Real backend cannot fabricate GSP stop acknowledgement from IRQ synchronization.
ret vtfinish
end
fn main to int
n = argread 1 vtarg 0 8
if ne n 1
ret 2
end
mode = sub ulong get vtarg 0 65
fd = int memfd viname 0 len viname 1
if lt fd 0
ret 3
end
r = ftrunc fd 4096
if ne r 0
ret 4
end
devfd = int vfioctl fd uint 15210 videv 0 len videv
if lt devfd 0
ret 5
end
r = viadopt devfd 1
if ne r 0
ret 6
end
r = pvinit 1 2
if ne r 0
ret 7
end
span = mmspanmk 1
vtstatus 0 get pverr 0
if eq open span 0
ret vtfinish
end
ret vtlease span mode
end

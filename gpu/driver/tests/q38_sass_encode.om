note tests/q38_sass_encode.om: Stage 2 pure-Omega regalloc + sm_121 SASS encoder.
note Composes after: gpu/nvidia/om/components/bw_alloc.om, gpu/nvidia/om/encoder/bw_enc_sm121.om.
note Reads 7 binary IR records from stdin (from q38_sass_emit.om), runs bc_regalloc + bw_enc_sm121,
note and writes framed [u32_le byte_len][sm_121 SASS bytes] to stdout.

fn rd_all b edit uchar 8192 n ulong to void
off = ulong 0
while lt off n bound 1024
r = read 0 b off sub n off
if le r 0
trap 1
end
off = add off ulong r
end
end

fn get_u64 b view uchar 8192 off ulong to ulong
v = ulong 0
for k ulong 8
v = or v shl ulong get b add off k mul k 8
end
ret v
end

fn wr_code b view uchar 16384 n ulong to void
off = ulong 0
while lt off n bound 1024
r = write 1 b off sub n off
if le r 0
trap 5
end
off = add off ulong r
end
end

fn enc_one to void
x = new ulong 8192 0
am = new ulong 2048 0
phys = new ulong 288 0
st = new ulong 4 0
buf = new uchar 8192 0
code = new uchar 16384 0
hdr = new uchar 4 0
rd_all buf 2312
n = get_u64 buf 0
if or eq n 0 gt n 1024
trap 2
end
for i ulong 288
put am i get_u64 buf mul add i 1 8
end
for i ulong n
rd_all buf 64
for f ulong 8
put x add mul i 8 f get_u64 buf mul f 8
end
end
if ne bc_regalloc x n am phys st 128 0
trap 3
end
nb = bw_enc_sm121 x phys n 1 code
if eq nb 0
trap 4
end
put hdr 0 uchar and nb 255
put hdr 1 uchar and shr nb 8 255
put hdr 2 uchar and shr nb 16 255
put hdr 3 uchar and shr nb 24 255
w = write 1 hdr 0 4
if ne w 4
trap 5
end
wr_code code nb
end

fn main to int
for k ulong 7
enc_one
end
ret 0
end

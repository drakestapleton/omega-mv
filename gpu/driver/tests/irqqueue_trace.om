note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note HOST_MODEL only. Reuses independently constructed wire frames and anonymous mapped queues.
global qrout uchar 128
fn qrword off ulong value ulong to void
for i ulong 8
put qrout add off i uchar and shr value mul i 8 255
end
end
fn qrseq value ulong to void
put gspmode 0 0
siminit
rqclear 52
rqput32 4 0 3
rqput32 4 4 2
rqput32 4 40 SQDLY
rqput32 4 44 value
qframe 4098 52 0 0 0
end
fn qrpeer mode uchar to void
if or eq mode 1 eq mode 8
qrseq 5
ret
end
rqclear 1
if or eq mode 2 eq mode 6
rqput 4 0 1
if eq mode 6
qframe 4124 0 0 0 0
else
qframe 4124 1 0 0 0
end
ret
end
if eq mode 4
qframe 4099 0 0 0 0
ret
end
qframe 4097 0 0 0 0
end
fn qradversary mode uchar to void
if eq mode 7
rqclear 0
tf 4099 0 0 0 0
else
rqclear 52
rqput32 4 0 3
rqput32 4 4 2
rqput32 4 40 SQDLY
rqput32 4 44 99
tf 4098 52 0 0 0
end
note Explicit hostile peer overwrite BEFORE consumer publication; handler must use immutable captured bytes.
r = mapwrite get mmwh 0 add get qtstat 0 RQSLOT rqtmp 0 RQSLOT
qck eq r long RQSLOT
end
fn main to int
m = new uchar 1 0
qck eq read 0 m 0 1 1
mode = get m 0
qsetup
qck eq drvprep 123 2 3 4 5 0
if ne mode 13
qrpeer mode
end
if eq mode 3
note Flip the actual mapped wire checksum, not the parser's private captured copy.
r = mapset get mmwh 0 add get qtstat 0 add RQSLOT 32 4 1
qck eq r 0
end
if eq mode 14
put qtepoch 0 add get qtepoch 0 1
end
if eq mode 15
r = mapset get mmwh 0 add get qtstat 0 16 4 RQCOUNT
qck eq r 0
end
qrword 16 mapget get mmwh 0 add get qtcmd 0 32 4
captured = qrready
qrword 0 ulong add captured 32
qrword 24 mapget get mmwh 0 add get qtcmd 0 32 4
probe = long -6
if eq mode 9
probe = qtfinish get qrtoken 0
end
if eq mode 10
probe = qthandled add get qrtoken 0 1
end
if eq mode 11
probe = qrready
end
if or eq mode 7 eq mode 8
qradversary mode
end
handled = long 0
if eq captured 1
handled = qrrecv
end
qrword 8 ulong add handled 32
qrword 32 mapget get mmwh 0 add get qtcmd 0 32 4
qrword 40 rqget32 0 32
qrword 48 ulong get qtpend 0
qrword 56 get qtstate 0
qrword 64 get bstate 0
qrword 72 get qrstate 0
qrword 80 get qrlock 0
qrword 88 ulong get rqrx 0
qrword 96 ulong get sqdly 0
qrword 104 ulong get sqdly 1
if not or or eq mode 9 eq mode 10 eq mode 11
probe = qrrecv
end
qrword 112 ulong add probe 32
qrword 120 ulong get rqdead 0
qck eq write 1 qrout 0 128 128
ret 0
end

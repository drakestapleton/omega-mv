note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Ordered GSP RX adapter over transport.om; stage immutable validated RPC, handle, then publish.
note No direct drvstep-to-iqrecv binding: service result2 is sequencer progress, NOT lockdown.
note Lockdown event source: NVIDIA580.173.02 rpc_global_enums.h GSP_LOCKDOWN_NOTICE0x101c;
note g_rpc-structures.h rpc_gsp_lockdown_notice_v17_00 is one NvBool byte.
note WolframLanguageEvaluator {5*8,FromDigits["101c",16],8*40} -> {40,4124,320}.
global qrstate ulong 1
global qrtoken ulong 1
global qrlock ulong 1
global qruse ulong 1
fn qrfail r long to long
qtlose
put qrstate 0 3
ret r
end
fn qrready to long
if ne get qrlock 0 0
ret -14
end
if ne get qrstate 0 0
ret -6
end
r = qtsnap
if ne r 0
ret qrfail r
end
put qrtoken 0 get qttok 0
r = qtstage get qrtoken 0
if lt r 0
ret qrfail r
end
if eq r 1
put qrstate 0 1
end
ret r
end
fn qrrecv to long
if or ne get qrstate 0 1 ne get qrlock 0 0
ret -6
end
if eq get rqfun 0 4124
if or ne get rqlen 0 1 ne get rqout 80 1
ret qrfail -13
end
note Sticky lockdown: no consumer publication or further register effects after recognizing it.
put qrlock 0 1
put qrstate 0 2
ret 2
end
put qthold 0 1
r = drvstep ne get qruse 0 0
put qthold 0 0
if lt r 0
ret qrfail r
end
if eq r 0
ret qrfail -13
end
r = qthandled get qrtoken 0
if ne r 0
ret qrfail r
end
r = qtfinish get qrtoken 0
if ne r 1
ret qrfail r
end
put qrstate 0 0
ret 1
end
note Explicit model-only UVM command queue, NOT a GSP RPC function-number assignment.
note Five u64 LE fields: op(1 replay,2 invalidate), sequence, VA, PA, flags; bounded8 records.
note iqcommand records transport acceptance only, never MMU/TLB effect completion.
global iqcmode ulong 1
global iqcstate ulong 1
global iqcseq ulong 1
global iqcprod ulong 1
global iqccons ulong 1
global iqcmd uchar 320
fn iqcword off ulong v ulong to void
for i ulong 8
put iqcmd add off i uchar and shr v mul i 8 255
end
end
fn iqcommand op ulong seq ulong va ulong pa ulong flags ulong to long
if ne get iqcmode 0 1
ret -95
end
if or ne get iqcstate 0 1 or eq seq 0 le seq get iqcseq 0
ret -4
end
if not or eq op 1 eq op 2
ret -1
end
if ge sub get iqcprod 0 get iqccons 0 8
ret -2
end
if eq add get iqcprod 0 1 0
ret -4
end
o = mul rem get iqcprod 0 8 40
iqcword o op
iqcword add o 8 seq
iqcword add o 16 va
iqcword add o 24 pa
iqcword add o 32 flags
note Serialized model release/publication; physical ordered queue/DMA effects are not admitted here.
put iqcprod 0 add get iqcprod 0 1
put iqcseq 0 seq
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gsp/fw_bm.om: Zero-BSS in-RAM GspFwBundle ELF64 validator for bare-metal GB20B (SPARK.EFI).
note Ingests Piece 4's GspFwBundle directly from physical RAM via bm_hal.om (no POSIX pread,
note no 16 MiB fwst static .bss). Validates ELF64 relocatable RISC-V container gsp_ga10x.bin
note (580.173.02): .fwimage, .fwversion=="580.173.02", .note.gnu.build-id, .fwsignature_gb20y (4096 B),
note plus the 5 pre-extracted GB20B bindata blobs (bl.img 212992, fmc.img 212296, fmc.hash 48,
note fmc.pubkey 384, fmc.sig 384) and bl_desc (84 B, monCodeOff=0xf000, monDataSize=0xe600).
note Prefix fb / FB. Library unit, no fn main. Compose after gsp/bm_hal.om.

const FBOK long 0
const FBEHDR long -1
const FBESEC long -2
const FBEVER long -3
const FBESIG long -4
const FBENOTE long -5
const FBEBLOB long -6
const FBNONE ulong 999
const FBCODEOFF ulong 61440
const FBDATASZ ulong 58880

text FBNIMG ".fwimage"
text FBNVER ".fwversion"
text FBNBID ".note.gnu.build-id"
text FBNSIG ".fwsignature_gb20y"
text FBVER "580.173.02"

note Validated outputs (physical addresses and sizes inside Piece 4's GspFwBundle)
global fbimgpa ulong 1
global fbimgsz ulong 1
global fbsigpa ulong 1
global fbsigsz ulong 1
global fbblpa ulong 1
global fbblsz ulong 1
global fbfmcpa ulong 1
global fbfmcsz ulong 1
global fbhshpa ulong 1
global fbpkeypa ulong 1
global fbfsigpa ulong 1
global fbappver ulong 1
global fbstrpa ulong 1
global fbstrsz ulong 1
global fbidx ulong 4

fn fbinb off ulong sz ulong flen ulong to bool
if gt off flen
ret false
end
ret le sz sub flen off
end

fn fbnmeq stroff ulong want ulong to bool
strsz = get fbstrsz 0
strpa = get fbstrpa 0
n = ulong 0
if eq want 0
n = len FBNIMG
end
if eq want 1
n = len FBNVER
end
if eq want 2
n = len FBNBID
end
if eq want 3
n = len FBNSIG
end
if ge stroff strsz
ret false
end
if gt add n 1 sub strsz stroff
ret false
end
for i ulong n
c = bmmemrd8 add strpa add stroff i
exp = uchar 0
if eq want 0
exp = get FBNIMG i
end
if eq want 1
exp = get FBNVER i
end
if eq want 2
exp = get FBNBID i
end
if eq want 3
exp = get FBNSIG i
end
if ne c exp
ret false
end
end
ret eq bmmemrd8 add strpa add stroff n 0
end

note Parse and validate gsp_ga10x.bin ELF64 in-place at elfpa[0..elfsz) for GB20B (.fwsignature_gb20y).
fn fbparseelf elfpa ulong elfsz ulong to long
put fbimgpa 0 0
put fbimgsz 0 0
put fbsigpa 0 0
put fbsigsz 0 0
if or eq elfpa 0 lt elfsz 64
ret FBEHDR
end
if or ne bmmemrd8 elfpa 127 or ne bmmemrd8 add elfpa 1 69 or ne bmmemrd8 add elfpa 2 76 ne bmmemrd8 add elfpa 3 70
ret FBEHDR
end
if or ne bmmemrd8 add elfpa 4 2 or ne bmmemrd8 add elfpa 5 1 ne bmmemrd8 add elfpa 6 1
ret FBEHDR
end
if or ne bmmemrd16 add elfpa 16 1 or ne bmmemrd16 add elfpa 18 243 ne bmmemrd16 add elfpa 58 64
ret FBEHDR
end
shoff = bmmemrd64 add elfpa 40
shnum = bmmemrd16 add elfpa 60
shstr = bmmemrd16 add elfpa 62
if or eq shnum 0 or gt shnum 256 ge shstr shnum
ret FBEHDR
end
if not fbinb shoff mul shnum 64 elfsz
ret FBEHDR
end
sbase = add elfpa add shoff mul shstr 64
stroff = bmmemrd64 add sbase 24
strsz = bmmemrd64 add sbase 32
if or eq strsz 0 not fbinb stroff strsz elfsz
ret FBESEC
end
if ne bmmemrd8 add elfpa add stroff sub strsz 1 0
ret FBESEC
end
put fbstrpa 0 add elfpa stroff
put fbstrsz 0 strsz
ret fbscan elfpa elfsz shoff shnum
end

fn fbscan elfpa ulong elfsz ulong shoff ulong shnum ulong to long
for k ulong 4
put fbidx k FBNONE
end
strsz = get fbstrsz 0
for i ulong shnum
sb = add elfpa add shoff mul i 64
nm = bmmemrd32 sb
ty = bmmemrd32 add sb 4
of = bmmemrd64 add sb 24
sz = bmmemrd64 add sb 32
if ge nm strsz
ret FBESEC
end
if and ne ty 8 gt sz 0
if not fbinb of sz elfsz
ret FBESEC
end
end
if fbnmeq nm 0
put fbidx 0 i
else
if fbnmeq nm 1
put fbidx 1 i
else
if fbnmeq nm 2
put fbidx 2 i
else
if fbnmeq nm 3
put fbidx 3 i
end
end
end
end
end
for k ulong 4
if eq get fbidx k FBNONE
ret FBESEC
end
end
r = fbchkimg elfpa shoff
if ne r FBOK
ret r
end
r = fbchkver elfpa shoff
if ne r FBOK
ret r
end
ret fbchknote elfpa shoff
end

fn fbchkimg elfpa ulong shoff ulong to long
ib = add elfpa add shoff mul get fbidx 0 64
if or eq bmmemrd32 add ib 4 8 eq bmmemrd64 add ib 32 0
ret FBESEC
end
iof = bmmemrd64 add ib 24
isz = bmmemrd64 add ib 32
sb = add elfpa add shoff mul get fbidx 3 64
if or eq bmmemrd32 add sb 4 8 ne bmmemrd64 add sb 32 4096
ret FBESIG
end
sof = bmmemrd64 add sb 24
put fbimgpa 0 add elfpa iof
put fbimgsz 0 isz
put fbsigpa 0 add elfpa sof
put fbsigsz 0 4096
ret FBOK
end

fn fbchkver elfpa ulong shoff ulong to long
vb = add elfpa add shoff mul get fbidx 1 64
vof = bmmemrd64 add vb 24
vsz = bmmemrd64 add vb 32
if or eq bmmemrd32 add vb 4 8 ne vsz add len FBVER 1
ret FBEVER
end
if ne bmmemrd8 add elfpa add vof sub vsz 1 0
ret FBEVER
end
for i ulong len FBVER
if ne bmmemrd8 add elfpa add vof i get FBVER i
ret FBEVER
end
end
ret FBOK
end

fn fbchknote elfpa ulong shoff ulong to long
bb = add elfpa add shoff mul get fbidx 2 64
bof = bmmemrd64 add bb 24
bsz = bmmemrd64 add bb 32
if or eq bmmemrd32 add bb 4 8 lt bsz 16
ret FBENOTE
end
bp = add elfpa bof
if or ne bmmemrd32 bp 4 ne bmmemrd32 add bp 8 3
ret FBENOTE
end
if ne bmmemrd8 add bp 12 71
ret FBENOTE
end
if ne bmmemrd8 add bp 13 78
ret FBENOTE
end
if ne bmmemrd8 add bp 14 85
ret FBENOTE
end
if ne bmmemrd8 add bp 15 0
ret FBENOTE
end
dsz = bmmemrd32 add bp 4
if or eq dsz 0 or gt dsz 64 gt add 16 dsz bsz
ret FBENOTE
end
ret FBOK
end

note Validate the 5 pre-extracted GB20B bindata blobs + appVersion from Piece 4 GspFwBundle.
fn fbbindblobs blpa ulong blsz ulong fmcpa ulong fmcsz ulong hshpa ulong pkeypa ulong to long
if or ne blsz 212992 ne fmcsz 212296
ret FBEBLOB
end
if or eq blpa 0 or eq fmcpa 0 or eq hshpa 0 eq pkeypa 0
ret FBEBLOB
end
put fbblpa 0 blpa
put fbblsz 0 blsz
put fbfmcpa 0 fmcpa
put fbfmcsz 0 fmcsz
put fbhshpa 0 hshpa
put fbpkeypa 0 pkeypa
ret FBOK
end

fn fbbindsig fsigpa ulong appver ulong to long
if or eq fsigpa 0 gt appver BMM32
ret FBEBLOB
end
put fbfsigpa 0 fsigpa
put fbappver 0 appver
ret FBOK
end

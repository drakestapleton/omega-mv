note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Serialized single-device/index IRQ lease. Types prevent accidental mixing, not malicious callers.
note States1 registered/masked,2 live,3 revoking,4 synchronized,5 quiescent,6 closed,7 quarantined.
note IRQ quiet, device stopped and permission to release are separate checked facts.
note Published transport DMA windows are NEVER reclaimed by this IRQ lease.
fn irvalid cap irqls gen ulong to bool
ret and ne open cap 0 and eq open cap get ilid 0 and ne gen 0 eq gen get ilgen 0
end
fn irquar r long to long
put ilstate 0 7
put pverr 0 r
ret r
end
fn irqlsmk gen ulong idx ulong start ulong count ulong to irqls
put pverr 0 -4
if or eq gen 0 or ne gen get pvgen 0 ne get ilstate 0 0
ret seal irqls ulong 0
end
r = pvquery idx start count
if ne r 0
put pverr 0 r
ret seal irqls ulong 0
end
put ilid 0 1
put ilgen 0 gen
r = pvregister idx start count
if ne r 0
put pverr 0 r
if or ne get pvreg 0 0 ne get pvalloc 0 0
put ilstate 0 7
ret seal irqls ulong 1
end
put ilstate 0 6
ret seal irqls ulong 0
end
put ilstate 0 1
put pverr 0 0
ret seal irqls ulong 1
end
fn irattach cap irqls span mmspan gen ulong to long
if or not irvalid cap gen not mmvalid span gen
ret -4
end
if or ne get ilstate 0 1 ne get ilback 0 0
ret -4
end
put ilback 0 open span
ret 0
end
fn irenable cap irqls gen ulong to long
if not irvalid cap gen
ret -4
end
if or ne get ilstate 0 1 eq get ilback 0 0
ret -4
end
if ne get pvlocked 0 0
ret -14
end
r = pvunmask
if ne r 0
ret irquar r
end
put ilstate 0 2
ret 0
end
fn irsubmit cap irqls gen ulong to long
if not irvalid cap gen
ret -4
end
if ne get ilstate 0 2
ret -4
end
if ne get pvlocked 0 0
ret -14
end
ret pvsubmit
end
fn hownermk cap irqls gen ulong to howner
put pverr 0 -4
if or not irvalid cap gen or ne get ilstate 0 2 ne get pvlocked 0 0
ret seal howner ulong 0
end
if or ne get ilactive 0 0 eq add get ilowner 0 1 0
ret seal howner ulong 0
end
put ilowner 0 add get ilowner 0 1
put ilactive 0 1
put pverr 0 0
ret seal howner get ilowner 0
end
fn irleave cap irqls owner howner gen ulong to long
if not irvalid cap gen
ret -4
end
if or ne get ilactive 0 1 or eq open owner 0 ne open owner get ilowner 0
ret -4
end
if ne get ilsnap 0 0
ret -16
end
put ilactive 0 0
ret 0
end
fn wownermk cap irqls gen ulong to wowner
put pverr 0 -4
if or not irvalid cap gen or ne get ilstate 0 2 ne get pvlocked 0 0
ret seal wowner ulong 0
end
if or ne get ilwait 0 0 eq add get ilwseq 0 1 0
ret seal wowner ulong 0
end
put ilwseq 0 add get ilwseq 0 1
put ilwait 0 1
put pverr 0 0
ret seal wowner get ilwseq 0
end
fn irwaitend cap irqls waiter wowner gen ulong to long
if not irvalid cap gen
ret -4
end
if or ne get ilwait 0 1 or eq open waiter 0 ne open waiter get ilwseq 0
ret -4
end
if eq get ilstate 0 2
put ilwait 0 0
note Notification is not completion and never establishes device idle.
ret long get pvnotify 0
end
if ne get pvcan 0 1
ret -16
end
put ilwait 0 0
ret -125
end
fn irrevoke cap irqls gen ulong to long
if not irvalid cap gen
ret -4
end
if not or eq get ilstate 0 1 eq get ilstate 0 2
ret -4
end
note Linearization point: prohibit entry/submission/wait/capture BEFORE backend disable.
put ilstate 0 3
put ilepoch 0 1
r = pvdisable
if ne r 0
ret irquar r
end
put ildis 0 1
r = pvcancel
if ne r 0
ret irquar r
end
r = pvstop get ilepoch 0 get ilback 0
if ne r 0
ret irquar r
end
ret 0
end
fn irsync cap irqls gen ulong to long
if not irvalid cap gen
ret -4
end
if ne get ilstate 0 3
ret -4
end
if or ne get ilactive 0 0 or ne get ilwait 0 0 ne get ilsnap 0 0
ret -16
end
if or ne get ildis 0 1 or ne get pvenable 0 0 ne get pvcan 0 1
ret -16
end
put ilstate 0 4
ret 0
end
fn irquiet cap irqls gen ulong to long
if not irvalid cap gen
ret -4
end
if ne get ilstate 0 4
ret -4
end
if not pvattest get ilepoch 0 get ilback 0
ret -16
end
put ilstate 0 5
ret 0
end
fn irclose cap irqls span mmspan gen ulong to long
if or not irvalid cap gen not mmvalid span gen
ret -4
end
if or ne get ilstate 0 5 ne open span get ilback 0
ret -4
end
if or ne get ilactive 0 0 or ne get ilwait 0 0 ne get ilsnap 0 0
ret -16
end
if not pvattest get ilepoch 0 get ilback 0
ret irquar -16
end
r = pvfree span gen
if ne r 0
ret irquar r
end
put ilstate 0 6
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Serialized model controller: exact handler owns every MMIO effect and captured RX snapshot.
note Physical GSP register routing/stop remains refused; irqvfio is a separate checked UAPI provider.
global icspan ulong 1
global icowner ulong 1
global icgen ulong 1
global icerr long 1
fn icabort to void
if ne get ilsnap 0 0
note Cancel local capture WITHOUT publishing the consumer; retain published DMA backing.
qtlose
put qrstate 0 3
put ilsnap 0 0
end
end
fn iqpm to bool
ret and eq get pvmode 0 1 and eq get ilstate 0 2 eq get pvlocked 0 0
end
fn iqread to uint
r = pvread get icspan 0 get icowner 0 get icgen 0 0
if lt r 0
put icerr 0 r
ret uint 0
end
ret uint r
end
fn iqclear value uint to void
r = pvwrite get icspan 0 get icowner 0 get icgen 0 4 value
if ne r 0
put icerr 0 r
ret
end
note Explicit modeled device side effect of IRQSCLR, not another host register access.
r = mapset get pvmm 0 0 4 and mapget get pvmm 0 0 4 not ulong value
if ne r 0
put icerr 0 r
end
end
fn iqready to bool
if ne get icerr 0 0
ret true
end
r = qrready
if lt r 0
put icerr 0 r
ret true
end
if eq r 1
put ilsnap 0 1
ret true
end
ret false
end
fn iqrecv to long
if ne get icerr 0 0
ret get icerr 0
end
r = qrrecv
if eq r 2
note Sticky denial is installed before cleanup can perform another host MMIO effect.
put pvlocked 0 1
ret 2
end
if eq r 1
put ilsnap 0 0
end
ret r
end
fn iqmask to void
if ne get pvlocked 0 0
ret
end
r = pvwrite get icspan 0 get icowner 0 get icgen 0 12 uint 0
if ne r 0
put icerr 0 r
end
icabort
end
fn icservice cap irqls span mmspan gen ulong budget ulong to long
if or not irvalid cap gen not mmvalid span gen
ret -4
end
if ne open span get ilback 0
ret -4
end
if ne get pvmode 0 1
ret -95
end
owner = hownermk cap gen
if eq open owner 0
ret get pverr 0
end
put icspan 0 open span
put icowner 0 open owner
put icgen 0 gen
put icerr 0 0
r = iqservice gen budget
if or lt r 0 eq get iqstate 0 3
icabort
end
if ne get icerr 0 0
r = get icerr 0
end
leave = irleave cap owner gen
if ne leave 0
ret leave
end
ret r
end

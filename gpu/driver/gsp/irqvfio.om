note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Program-mode Linux VFIO effects, requires irq-omc.pin (omega-mv78122a72, draft1045).
note Never opens a path, binds a driver, resets a device or closes the caller-owned device fd.
note Caller must have acquired devicefd with vfioctl15210 IN THIS PROGRAM; vfioirq enforces provenance.
note This is not authorization to use a physical device. ogd admits only host model/memfd fixtures.
note Linux UAPI records: GET_IRQ_INFO16; SET_IRQS20+4count; count<=64.
note WolframLanguageEvaluator:{20+4*64,BitOr[4,32],BitOr[1,32],BitOr[1,8],BitOr[1,16]}->{276,36,33,9,17}.
global vigen ulong 1
global vifd int 1
global viefd int 1
global viidx ulong 1
global vistart ulong 1
global vincount ulong 1
global vicount ulong 1
global viflags ulong 1
global vistate ulong 1
global vialloc ulong 1
global vireg ulong 1
global viclose ulong 1
global viwakes ulong 1
global vibytes ulong 1
global vibuf uchar 276
global viinfo uchar 16
global vibar uchar 32
global viwake uchar 8
fn viput which ulong off ulong value ulong to void
for i ulong 4
b = uchar and shr value mul i 8 255
if eq which 0
put vibuf add off i b
end
if eq which 1
put viinfo add off i b
end
if eq which 2
put vibar add off i b
end
end
end
fn viget which ulong off ulong to ulong
v = ulong 0
for i ulong 4
b = uchar 0
if eq which 0
b = get vibuf add off i
end
if eq which 1
b = get viinfo add off i
end
if eq which 2
b = get vibar add off i
end
v = or v shl ulong b mul i 8
end
ret v
end
fn viwide off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get vibar add off i mul i 8
end
ret v
end
fn viadopt fd int gen ulong to long
if or lt fd 0 or eq gen 0 ne get vistate 0 0
ret -4
end
put vifd 0 fd
put vigen 0 gen
put vistate 0 1
ret 0
end
fn vimmio region uint to long
if ne get vistate 0 1
ret -4
end
for i ulong 32
put vibar i 0
end
viput 2 0 32
viput 2 8 ulong region
r = vfioctl get vifd 0 uint 15212 vibar 0 32
if ne r 0
ret r
end
if or ne viget 2 0 32 ne and viget 2 4 7 7
ret -95
end
if ne viget 2 8 ulong region
ret -95
end
size = viwide 16
if lt size 4096
ret -1
end
h = vfiomapw get vifd 0 vibar 0 32
if gt h 0
put vibytes 0 size
end
ret h
end
fn viquery idx ulong start ulong count ulong to long
if ne get vistate 0 1
ret -4
end
if or gt idx 4294967295 or eq count 0 gt count 64
ret -1
end
for i ulong 16
put viinfo i 0
end
viput 1 0 16
viput 1 8 idx
r = vfioirq get vifd 0 uint 15213 viinfo 0 16
if ne r 0
ret r
end
if or ne viget 1 0 16 ne viget 1 8 idx
ret -95
end
note No synthetic masking: both EVENTFD and MASKABLE capabilities must actually be reported.
flags = viget 1 4
if ne and flags 3 3
ret -95
end
n = viget 1 12
if gt start n
ret -1
end
if gt count sub n start
ret -1
end
put viidx 0 idx
put viflags 0 flags
put vicount 0 n
put vistart 0 start
put vincount 0 count
ret 0
end
fn viset flags ulong count ulong start ulong to long
n = ulong 20
if eq flags 36
n = add 20 mul count 4
end
viput 0 0 n
viput 0 4 flags
viput 0 8 get viidx 0
viput 0 12 start
viput 0 16 count
ret vfioirq get vifd 0 uint 15214 vibuf 0 n
end
fn vidisable to long
r = viset 33 0 0
if ne r 0
put vistate 0 7
ret r
end
put vireg 0 0
put vistate 0 6
ret 0
end
fn virelease to long
if or ne get vireg 0 0 or ne get vialloc 0 1 ne get viclose 0 0
ret -4
end
note close errors are ambiguous; never retry this numeric descriptor after the first close attempt.
put viclose 0 1
r = fclose get viefd 0
if ne r 0
put vistate 0 7
ret r
end
put vialloc 0 0
put vistate 0 8
ret 0
end
fn virollback error long to long
r = vidisable
if ne r 0
ret error
end
r = virelease
ret error
end
fn viregister to long
if or ne get vistate 0 1 eq get vincount 0 0
ret -4
end
e = eventfd uint 0
if lt e 0
ret e
end
put viefd 0 int e
put vialloc 0 1
put vistate 0 2
for i ulong get vincount 0
viput 0 add 20 mul i 4 ulong e
end
note Once attempted, bind ownership is uncertain until disable is acknowledged, even on ioctl error.
put vireg 0 1
r = viset 36 get vincount 0 get vistart 0
if ne r 0
ret virollback r
end
r = viset 9 get vincount 0 get vistart 0
if ne r 0
ret virollback r
end
put vistate 0 3
ret 0
end
fn viunmask to long
if ne get vistate 0 3
ret -4
end
r = viset 17 get vincount 0 get vistart 0
if eq r 0
put vistate 0 4
end
ret r
end
fn vican to long
if ne get vialloc 0 1
ret -4
end
for i ulong 8
put viwake i 0
end
put viwake 0 1
r = write get viefd 0 viwake 0 8
if eq r 8
ret 0
end
if eq r -11
if eq waitio get viefd 0 1 0 1
ret 0
end
end
if lt r 0
ret r
end
ret -5
end
note WolframLanguageEvaluator:UnitConvert[Quantity[1,\"Seconds\"],\"Nanoseconds\"]->1000000000 nanoseconds.
fn viwait timeout long to long
if or ne get vialloc 0 1 or lt timeout 0 gt timeout 1000000000
ret -4
end
r = waitio get viefd 0 1 timeout
if ne r 1
ret r
end
r = read get viefd 0 viwake 0 8
if eq r -11
ret 0
end
if ne r 8
if lt r 0
ret r
end
ret -5
end
v = ulong 0
for i ulong 8
v = or v shl ulong get viwake i mul i 8
end
put viwakes 0 v
ret 1
end

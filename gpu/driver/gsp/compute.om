note gsp/compute.om: GB20B compute bring-up RPC builders, canonical PACKED_REGISTRY_TABLE encoder,
note BLACKWELL_COMPUTE_B (0xcec0) / BLACKWELL_CHANNEL_GPFIFO_B (0xca6f) / usermode alloc & control
note helpers, GB20B bit-30 work-submit token encoder, INC_METHOD pushbuffer builder, GP entry
note encoder (LEVEL bit 41), USERD GPPut (+0x8C) update and BAR0/usermode doorbell kick helpers.
note Source of record: NVIDIA open-gpu-kernel-modules 580.173.02 (MIT), docs/gpu/GSP_RPC_REGISTRY_REFERENCE.md,
note and gb20b-gsp-boot.md. Pure seeded OM-1 library unit, no fn main. Prefix cb / CB.
note Compose after: chan/gmmu.om, chan/mem.om, chan/chan.om, gsp/rpc.om, chan/params.om, gsp/boot.om.
const CBOK long 0
const CBEINVAL long -1
const CBERANGE long -2
const CBEFULL long -3
const CBEALIGN long -4
const CBESTATE long -5
const CBU32MAX ulong 4294967295
note RPC function IDs: SET_GUEST_SYSTEM_INFO 1, GET_GSP_STATIC_INFO 65, SET_REGISTRY 73,
note GSP_RM_CONTROL 76, GSP_RM_ALLOC 103
const CBRPCGUEST ulong 1
const CBRPCSTAT ulong 65
const CBRPCREG ulong 73
const CBRPCCTRL ulong 76
const CBRPCALLOC ulong 103
note SET_GUEST_SYSTEM_INFO v03_00: 6*4 + 3*256 = 792 bytes
const CBSZGUEST ulong 792
const CBGSTRMAX ulong 256
note PACKED_REGISTRY_TABLE bounds matching arena.om arregok and boot.om breg
const CBREGMIN ulong 8
const CBREGMAX ulong 65456
const CBRMAX ulong 32
const CBRDWORD uchar 1
const CBRBIN uchar 2
const CBRSTR uchar 3
note GB20B bring-up registry key selectors
const CBKFW ulong 0
const CBKLOG ulong 1
const CBKRC ulong 2
const CBKDPM ulong 3
const CBKPW2 ulong 4
const CBKDISP ulong 5
note RM class IDs: BLACKWELL_CHANNEL_GPFIFO_A 0xc96f, BLACKWELL_CHANNEL_GPFIFO_B 0xca6f,
note BLACKWELL_COMPUTE_B 0xcec0, VOLTA_USERMODE_A 0xc361, HOPPER_USERMODE_A 0xc661
const CBCGPFA ulong 51567
const CBCGPFB ulong 51823
const CBCCMP ulong 52928
const CBCUMVA ulong 50017
const CBCUMHA ulong 50785
note RM control IDs: NVA06C_CTRL_CMD_GPFIFO_SCHEDULE 0xa06c0101,
note NVC36F_CTRL_CMD_GPFIFO_GET_WORK_SUBMIT_TOKEN 0xc36f0108
const CBCMSCH ulong 2691432705
const CBCMWST ulong 3278831880
note GB20B work-submit token bit 30 RUNLIST_DOORBELL_ENABLE (0x40000000, active-high),
note runlist <= 127 (0x7F), chId <= 4095 (0xFFF), BAR0 doorbell 0x00BB0090, usermode +0x90, USERD GPPut +0x8C
const CBDBEN uint 1073741824
const CBRLMAX uint 127
const CBCHMAX uint 4095
const CBDBBAR0 ulong 12255376
const CBDBUM ulong 144
const CBGPPUT ulong 140
note Pushbuffer INC_METHOD (2<<28), compute setup 0x0184, inline QMD 0x0318 (96 dwords),
note L2 flush 0x0028 (0x80000000), host semaphore 0x005C..0x006C (release 1 / WFI 0x100001)
const CBINC uint 536870912
const CBMSETUP uint 388
const CBMIQMD uint 792
const CBML2 uint 40
const CBMSEM uint 92
const CBQMDWDS ulong 96
const CBSEMREL uint 1
const CBSEMWFI uint 1048577
const CBL2EXEC uint 2147483648
const CBPBMAX ulong 1024
note GP entry: va & ~3, LEVEL bit 41 (1<<41), VA limit 1<<40, length max 0x1FFFFF
const CBVAMASK ulong 18446744073709551612
const CBGPB41 ulong 2199023255552
const CBVALIM ulong 1099511627776
const CBLENMAX uint 2097151
note Built-in GB20B bring-up registry key names (GSP_RPC_REGISTRY_REFERENCE.md 3.2)
text CBKEY0 "EnableGpuFirmware"
text CBKEY1 "RMGspLogLevel"
text CBKEY2 "RmLogonRC"
text CBKEY3 "RMEnableDynamicPowerManagement"
text CBKEY4 "RMPowerFeature2"
text CBKEY5 "RMDisableDisplay"
note Guest string staging buffer for SET_GUEST_SYSTEM_INFO (max 256 bytes per slot)
global cbstrin uchar 256
note PACKED_REGISTRY_TABLE staging arrays
global cbrcnt ulong 1
global cbrtyp uchar 32
global cbrval ulong 32
global cbrvlen ulong 32
global cbrnoff ulong 32
global cbrnlen ulong 32
global cbrnames uchar 2048
global cbrnpos ulong 1
global cbrblob uchar 4096
global cbrbpos ulong 1
global cbrkin uchar 128
global cbrvin uchar 512
note Pushbuffer and inline QMD staging arrays
global cbpb uint 1024
global cbpblen ulong 1
global cbqmd uint 96

note Section 1: SET_GUEST_SYSTEM_INFO (RPC 1, 792 B) and GET_GSP_STATIC_INFO (RPC 65)
note Initialize rpc_set_guest_system_info_v03_00 (792 B) in rqpay with caller-supplied version fields.
fn cbguestinit ver0 ulong ver1 ulong guestos ulong to long
if or gt ver0 CBU32MAX or gt ver1 CBU32MAX gt guestos CBU32MAX
ret CBERANGE
end
rqclear CBSZGUEST
rqput32 4 0 ver0
rqput32 4 4 ver1
rqput32 4 20 guestos
ret long CBSZGUEST
end

note Populate one of the three 256-byte string buffers of rpc_set_guest_system_info_v03_00 from cbstrin:
note slot 0 = driverVersionBuffer (+24, len at +8), slot 1 = driverBranchBuffer (+280, len at +12),
note slot 2 = guestOsInfoBuffer (+536, len at +16). Never fabricates version strings.
fn cbgueststr slot ulong n ulong to long
if or gt slot 2 gt n CBGSTRMAX
ret CBERANGE
end
rqput32 4 add 8 mul slot 4 n
base = add 24 mul slot CBGSTRMAX
for i ulong CBGSTRMAX
put rqpay add base i 0
end
for i ulong n
put rqpay add base i get cbstrin i
end
ret CBOK
end

note Prepare zeroed request payload for GET_GSP_STATIC_INFO (RPC 65) in rqpay.
fn cbstaticprep n ulong to long
if or eq n 0 gt n CBREGMAX
ret CBERANGE
end
rqclear n
ret long n
end

note Read a little-endian u32 at byte offset off from GET_GSP_STATIC_INFO reply payload in rqout.
fn cbstaticrd32 off ulong to long
n = get rqlen 0
if or gt off n gt 4 sub n off
ret CBERANGE
end
ret long rqget32 3 add 80 off
end

note Section 2: SET_REGISTRY (RPC 73) canonical PACKED_REGISTRY_TABLE builder
fn cbrinit to void
put cbrcnt 0 0
put cbrnpos 0 0
put cbrbpos 0 0
end

fn cbrchkname nlen ulong to bool
if or eq nlen 0 gt nlen 128
ret false
end
for i ulong nlen
if eq get cbrkin i 0
ret false
end
end
ret true
end

fn cbradddw nlen ulong val ulong to long
if not cbrchkname nlen
ret CBEINVAL
end
if gt val CBU32MAX
ret CBERANGE
end
cnt = get cbrcnt 0
if ge cnt CBRMAX
ret CBEFULL
end
npos = get cbrnpos 0
if gt add npos nlen 2048
ret CBEFULL
end
for i ulong nlen
put cbrnames add npos i get cbrkin i
end
put cbrtyp cnt CBRDWORD
put cbrval cnt val
put cbrvlen cnt 4
put cbrnoff cnt npos
put cbrnlen cnt nlen
put cbrnpos 0 add npos nlen
put cbrcnt 0 add cnt 1
ret CBOK
end

fn cbraddblob typ uchar nlen ulong vlen ulong to long
if not cbrchkname nlen
ret CBEINVAL
end
if or eq vlen 0 gt vlen 512
ret CBERANGE
end
cnt = get cbrcnt 0
if ge cnt CBRMAX
ret CBEFULL
end
npos = get cbrnpos 0
if gt add npos nlen 2048
ret CBEFULL
end
bpos = get cbrbpos 0
if gt add bpos vlen 4096
ret CBEFULL
end
for i ulong nlen
put cbrnames add npos i get cbrkin i
end
for i ulong vlen
put cbrblob add bpos i get cbrvin i
end
put cbrtyp cnt typ
put cbrval cnt bpos
put cbrvlen cnt vlen
put cbrnoff cnt npos
put cbrnlen cnt nlen
put cbrnpos 0 add npos nlen
put cbrbpos 0 add bpos vlen
put cbrcnt 0 add cnt 1
ret CBOK
end

fn cbraddbin nlen ulong vlen ulong to long
ret cbraddblob CBRBIN nlen vlen
end

fn cbraddstr nlen ulong vlen ulong to long
ret cbraddblob CBRSTR nlen vlen
end

fn cbrloadkey kid ulong to long
if eq kid CBKFW
for i ulong len CBKEY0
put cbrkin i get CBKEY0 i
end
ret long len CBKEY0
end
if eq kid CBKLOG
for i ulong len CBKEY1
put cbrkin i get CBKEY1 i
end
ret long len CBKEY1
end
if eq kid CBKRC
for i ulong len CBKEY2
put cbrkin i get CBKEY2 i
end
ret long len CBKEY2
end
if eq kid CBKDPM
for i ulong len CBKEY3
put cbrkin i get CBKEY3 i
end
ret long len CBKEY3
end
if eq kid CBKPW2
for i ulong len CBKEY4
put cbrkin i get CBKEY4 i
end
ret long len CBKEY4
end
if eq kid CBKDISP
for i ulong len CBKEY5
put cbrkin i get CBKEY5 i
end
ret long len CBKEY5
end
ret CBERANGE
end

fn cbraddkey kid ulong val ulong to long
nlen = cbrloadkey kid
if lt nlen 0
ret nlen
end
ret cbradddw ulong nlen val
end

note Populate the 6 proposed GB20B compute bring-up registry DWORD keys.
fn cbrgb20b loglvl ulong nodisp ulong to long
if or gt loglvl 5 gt nodisp 1
ret CBERANGE
end
r = cbraddkey CBKFW 1
if lt r 0
ret r
end
r = cbraddkey CBKLOG loglvl
if lt r 0
ret r
end
r = cbraddkey CBKRC 1
if lt r 0
ret r
end
r = cbraddkey CBKDPM 0
if lt r 0
ret r
end
r = cbraddkey CBKPW2 0
if lt r 0
ret r
end
ret cbraddkey CBKDISP nodisp
end

note Serialize one staged entry i at byte cursor pos into rqpay; returns next pos or negative error.
fn cbrputent i ulong pos ulong to long
e = add 8 mul i 16
t = get cbrtyp i
nlen = get cbrnlen i
noff = get cbrnoff i
if gt add pos add nlen 1 CBREGMAX
ret CBEFULL
end
rqput32 4 e pos
put rqpay add e 4 t
put rqpay add e 5 0
put rqpay add e 6 0
put rqpay add e 7 0
for j ulong nlen
put rqpay add pos j get cbrnames add noff j
end
put rqpay add pos nlen 0
pos = add pos add nlen 1
if eq t CBRDWORD
rqput32 4 add e 8 get cbrval i
rqput32 4 add e 12 4
ret long pos
end
vlen = get cbrvlen i
voff = get cbrval i
if gt add pos vlen CBREGMAX
ret CBEFULL
end
rqput32 4 add e 8 pos
rqput32 4 add e 12 vlen
for j ulong vlen
put rqpay add pos j get cbrblob add voff j
end
ret long add pos vlen
end

note Build canonical PACKED_REGISTRY_TABLE into rqpay; returns wire byte length (0 if empty) for breg.
fn cbrbuild to long
cnt = get cbrcnt 0
if eq cnt 0
ret 0
end
pos = add 8 mul cnt 16
rqclear pos
rqput32 4 4 cnt
for i ulong cnt
next = cbrputent i pos
if lt next 0
ret next
end
pos = ulong next
end
rqput32 4 0 pos
ret long pos
end

note Section 3: Compute bring-up RM alloc (RPC 103) and RM control (RPC 76) helpers
note Allocate Blackwell GPFIFO channel (0xca6f for GB20B, 0xc96f for GB10B) using pain[].
fn cballocch cli ulong parent ulong hchan ulong gb20b bool budget ulong to long
r = pachan
if lt r 0
ret r
end
ret brmalloc cli parent hchan pacgpcls gb20b budget
end

note Allocate BLACKWELL_COMPUTE_B (0xcec0 / 52928) with 0-byte params under hchan.
fn cballoccmp cli ulong hchan ulong hcmp ulong budget ulong to long
r = paempty
if lt r 0
ret r
end
ret brmalloc cli hchan hcmp CBCCMP budget
end

note Allocate VOLTA_USERMODE_A (0xc361) or HOPPER_USERMODE_A (0xc661) with 0-byte params under hsub.
fn cballocum cli ulong hsub ulong hum ulong cls ulong budget ulong to long
if and ne cls CBCUMVA ne cls CBCUMHA
ret CBEINVAL
end
r = paempty
if lt r 0
ret r
end
ret brmalloc cli hsub hum cls budget
end

note Issue NVA06C_CTRL_CMD_GPFIFO_SCHEDULE (0xa06c0101, 3 B) on TSG handle htsg.
fn cbsched cli ulong htsg ulong en ulong skipsub ulong skipen ulong budget ulong to long
r = pasched en skipsub skipen
if lt r 0
ret r
end
ret brmctrl cli htsg CBCMSCH budget
end

note Issue NVC36F_CTRL_CMD_GPFIFO_GET_WORK_SUBMIT_TOKEN (0xc36f0108, 4 B) on channel handle hchan.
fn cbgetwst cli ulong hchan ulong budget ulong to long
r = pawstreq
if lt r 0
ret r
end
ret brmctrl cli hchan CBCMWST budget
end

note Decode u32 workSubmitToken from the completed GET_WORK_SUBMIT_TOKEN reply in pareply.
fn cbdecwst to long
ret pawstdec get bplen 0
end

note Section 4: GB20B work-submit token encoder and doorbell write helpers
note kfifoGenerateWorkSubmitTokenHal_GB202: 0x40000000 | ((runlist & 0x7F) << 16) | (chId & 0xFFF).
fn cbtoken rl uint chid uint to long
if or gt rl CBRLMAX gt chid CBCHMAX
ret CBERANGE
end
tok = or CBDBEN or shl rl 16 chid
ret long ulong tok
end

note Direct BAR0 VF doorbell write (0x00BB0090) ordered after prior GP entry and USERD GPPut writes.
fn cbdbbar0 tok uint to void
cpufence
mmregwr CBDBBAR0 ulong tok
end

note Mapped usermode page doorbell write (umbase + 0x90) ordered after prior GP/USERD writes.
fn cbdbum umbase ulong tok uint to long
if ne and umbase 3 0
ret CBEALIGN
end
if or ge umbase MMPALIM gt CBDBUM sub MMPALIM umbase
ret CBERANGE
end
cpufence
mmwr32 add umbase CBDBUM ulong tok
ret CBOK
end

note Section 5: INC_METHOD pushbuffer builder, GP entry encoder, USERD GPPut and kick helpers
fn cbmthd subc uint mthd uint count uint to uint
ret or or or CBINC shl and count 4095 16 shl and subc 7 13 and shr mthd 2 8191
end

fn cbpbinit to void
put cbpblen 0 0
end

fn cbpbemit w uint to long
n = get cbpblen 0
if ge n CBPBMAX
ret CBEFULL
end
put cbpb n w
put cbpblen 0 add n 1
ret CBOK
end

note Compute setup (subc 1, method 0x0184, count 1, class 0xcec0).
fn cbpbsetup cls uint to long
n = get cbpblen 0
if gt add n 2 CBPBMAX
ret CBEFULL
end
r = cbpbemit cbmthd 1 CBMSETUP 1
if lt r 0
ret r
end
ret cbpbemit cls
end

note Inline 384-byte (96-dword) QMD launch packet (subc 1, method 0x0318, count 98).
fn cbpbiqmd qmdva ulong to long
if ne and qmdva 255 0
ret CBEALIGN
end
if ge qmdva CBVALIM
ret CBERANGE
end
n = get cbpblen 0
if gt add n 99 CBPBMAX
ret CBEFULL
end
r = cbpbemit cbmthd 1 CBMIQMD 98
if lt r 0
ret r
end
r = cbpbemit or CBDBEN uint and shr qmdva 40 511
if lt r 0
ret r
end
r = cbpbemit uint and shr qmdva 8 CBU32MAX
if lt r 0
ret r
end
for i ulong CBQMDWDS
r = cbpbemit get cbqmd i
if lt r 0
ret r
end
end
ret CBOK
end

note GPU L2 cache flush before CPU readback (subc 0, method 0x0028, count 4).
fn cbpbl2flush to long
n = get cbpblen 0
if gt add n 5 CBPBMAX
ret CBEFULL
end
r = cbpbemit cbmthd 0 CBML2 4
if lt r 0
ret r
end
r = cbpbemit 0
if lt r 0
ret r
end
r = cbpbemit 0
if lt r 0
ret r
end
r = cbpbemit 0
if lt r 0
ret r
end
ret cbpbemit CBL2EXEC
end

note Host semaphore release (subc 0, methods 0x005C..0x006C, count 5; wfi=true uses 0x100001).
fn cbpbsem va ulong val uint wfi bool to long
if ne and va 3 0
ret CBEALIGN
end
if or eq va 0 ge va CBVALIM
ret CBERANGE
end
n = get cbpblen 0
if gt add n 6 CBPBMAX
ret CBEFULL
end
r = cbpbemit cbmthd 0 CBMSEM 5
if lt r 0
ret r
end
r = cbpbemit uint and va CBU32MAX
if lt r 0
ret r
end
r = cbpbemit uint and shr va 32 33554431
if lt r 0
ret r
end
r = cbpbemit val
if lt r 0
ret r
end
r = cbpbemit 0
if lt r 0
ret r
end
exec = CBSEMREL
if wfi
exec = CBSEMWFI
end
ret cbpbemit exec
end

note Flush staged pushbuffer words to physical/window address pbpa via mmwr32.
fn cbpbflush pbpa ulong to long
if ne and pbpa 3 0
ret CBEALIGN
end
n = get cbpblen 0
if eq n 0
ret CBEINVAL
end
for i ulong n
mmwr32 add pbpa mul i 4 ulong get cbpb i
end
ret long n
end

note GP entry encoder with LEVEL bit 41 set: (va & ~3) | ((words & 0x1FFFFF) << 42) | (1 << 41).
fn cbgpent va ulong words uint to ulong
ret or or and va CBVAMASK shl and ulong words ulong CBLENMAX 42 CBGPB41
end

fn cbgpentok va ulong words uint to bool
ret and eq and va 3 0 and lt va CBVALIM and gt words 0 le words CBLENMAX
end

note Write 64-bit GP entry to GPFIFO ring at (gpput % ent) * 8; returns nextput = (gpput + 1) % ent.
fn cbwrgp gppa ulong gpput uint ent uint gpent ulong to long
if or or lt ent 2 gt ent 65536 ne and ent sub ent 1 0
ret CBEINVAL
end
if ne and gppa 7 0
ret CBEALIGN
end
idx = ulong rem gpput ent
mmwr64 add gppa mul idx 8 gpent
ret long ulong rem add gpput 1 ent
end

note Update USERD GPPut (+0x8C / 140).
fn cbwruserd userdpa ulong nextput uint to void
mmwr32 add userdpa CBGPPUT ulong nextput
end

note Full BAR0 kick sequence: write GP entry, advance USERD GPPut, fence, write BAR0 0xBB0090 doorbell.
fn cbkickbar0 gppa ulong userdpa ulong gpent ulong gpput uint ent uint tok uint to long
next = cbwrgp gppa gpput ent gpent
if lt next 0
ret next
end
cbwruserd userdpa uint next
cbdbbar0 tok
ret next
end

note Usermode doorbell kick after GP entry write: advance USERD GPPut, fence, write umbase + 0x90.
fn cbkickum userdpa ulong umbase ulong nextput uint tok uint to long
cbwruserd userdpa nextput
ret cbdbum umbase tok
end

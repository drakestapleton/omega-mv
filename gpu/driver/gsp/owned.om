note Checked CPU staging and uncertainty connection only; NOT a hardware publisher or RPC endpoint.
note Compose after chan/dma+gmmu and gsp/arena+boot. No device opens, barriers or doorbells here.
note Real publication still requires reviewed coherency/release/acquire and an authorized endpoint.
global arsepoch ulong 1
global arsboot ulong 1
note All staged bytes target the same checked owned mapping. Publish the receipt after the last copy.
fn arstdata h long n ulong to bool
if or eq n 0 gt n ARMAX
ret false
end
low = n
if gt low ARLOW
low = ARLOW
end
if ne mapwrite h 0 arbuf 0 low long low
ret false
end
if eq low n
ret true
end
page = new uchar 4096 0
o = low
while lt o n bound 16384
size = sub n o
if gt size 4096
size = ulong 4096
end
for i ulong size
put page i aroutput add o i
end
if ne mapwrite h o page 0 size long size
ret false
end
o = add o size
end
ret eq o n
end
fn arstage gen ulong to long
if not mmwepoch gen
ret MMEGEN
end
if ne get bstate 0 4
ret MMESTATE
end
if not or eq get mmwst 0 MMWOWN eq get mmwst 0 MMWDMA
ret MMESTATE
end
if ne get arbase 0 get mmwb 0
ret MMEINVAL
end
if or eq get arused 0 0 gt get arused 0 get mmws 0
ret MMEINVAL
end
if gt get arused 0 ARMAX
ret MMEINVAL
end
put arsepoch 0 0
put arsboot 0 0
if not arstdata get mmwh 0 get arused 0
ret MMEIO
end
put arsepoch 0 gen
put arsboot 0 get bgen 0
ret MMOK
end
note Call only for uncertain completion after an actual publication; never reclaim automatically.
fn arlose gen ulong to long
if ne gen get arsepoch 0
ret MMEGEN
end
if ne get bgen 0 get arsboot 0
ret MMEGEN
end
if ne get bstate 0 12
ret MMESTATE
end
if ne get mmwst 0 MMWPUB
ret MMESTATE
end
ret mmwquar gen
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Explicit host-only GSP IRQ/queue peer. No map handles, VFIO, device fds or physical firmware.
note Model choices: finite queue; one edge may arrive during receive or the post-drain status read;
note service can fail at an ordinal or deliver a lockdown notification. Not firmware emulation.
note Constants intentionally independent of irq.om so a wrong handler mask does not move this peer.
global israw uint 1
global ismask uint 1
global isdest uint 1
global iscnt ulong 1
global isdone ulong 1
global isedge ulong 1
global isfail ulong 1
global islock ulong 1
global istail ulong 1
global ispm ulong 1
global isacks ulong 1
global isreads ulong 1
global ismasks ulong 1
global isviol ulong 1
global islocked ulong 1
fn isaccess to void
if or ne get ispm 0 0 ne get islocked 0 0
put isviol 0 add get isviol 0 1
end
end
fn iqpm to bool
ret eq get ispm 0 0
end
fn iqread to uint
isaccess
put isreads 0 add get isreads 0 1
if and ne get istail 0 0 eq get isreads 0 2
put istail 0 0
put israw 0 or get israw 0 64
put iscnt 0 add get iscnt 0 1
end
ret and and get israw 0 get ismask 0 get isdest 0
end
fn iqclear v uint to void
isaccess
if ne v 64
put isviol 0 add get isviol 0 1
end
put isacks 0 add get isacks 0 1
put israw 0 and get israw 0 not v
end
fn iqready to bool
isaccess
if eq get isacks 0 0
put isviol 0 add get isviol 0 1
end
ret lt get isdone 0 get iscnt 0
end
fn iqrecv to long
isaccess
if eq get isacks 0 0
put isviol 0 add get isviol 0 1
end
n = add get isdone 0 1
if eq get isfail 0 n
ret -1
end
if gt n get iscnt 0
ret -1
end
put isdone 0 n
if and ne get isedge 0 0 eq get isedge 0 n
put isedge 0 0
put israw 0 or get israw 0 64
put iscnt 0 add get iscnt 0 1
end
if eq get islock 0 n
put islocked 0 1
ret 2
end
ret 1
end
fn iqmask to void
isaccess
put ismasks 0 add get ismasks 0 1
put ismask 0 0
end

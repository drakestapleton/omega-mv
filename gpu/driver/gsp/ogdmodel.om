note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note HOST MODEL ONLY. Synthetic pre-INIT_DONE queue endpoint, NOT Falcon/GSP firmware emulation.
note Physical DMA, core sequencer effects and device stop are not provided by this backend.
note Anonymous mappings are real; model DMA publication is an explicit distinct mechanism.
fn mmdmaop op ulong fd int h long iova ulong size ulong to long
if or ne get ogmode 0 1 ne fd -1
ret -95
end
if or ne h get mmwh 0 or ne iova get mmwb 0 ne size get mmws 0
ret -4
end
if or ne op 1 ne get ogdma 0 0
ret -95
end
put ogdma 0 1
ret 0
end
fn mmdrop h long to long
if or ne get ogmode 0 1 ne get ogdma 0 0
ret -95
end
ret mapdrop h
end
fn sqcorefn op ulong to long
ret SQENOC
end
fn oginputs to void
note Synthetic GB20B profile 2 byte segments and metadata; NOT NVIDIA firmware.
put arbase 0 1048576
put arcap 0 ARMAX
put arcfg 0 2
put arcfg 1 40
put arcfg 2 268435456
put arcfg 3 8192
put arcfg 4 7
put arcfg 5 9
put arcfg 6 61440
put arcfg 7 2560
put arcfg 8 0
for i ulong 3
put arpkg i 2
end
put arslen 0 4097
put arslen 1 4096
put arslen 2 212992
put arslen 3 212296
put arslen 4 48
put arslen 5 384
put arslen 6 384
pos = ulong 0
for i ulong 7
put arsrc i pos
pos = add pos get arslen i
end
end
fn oginit to long
put ogmode 0 1
put gspmode 0 0
siminit
oginputs
r = arboot 40 128
if ne r 0
ret r
end
r = mmwalloc get arbase 0 add get arused 0 1048576
if ne r MMOK
ret r
end
r = arstage get mmwgen 0
if ne r MMOK
ret r
end
r = mmwdmap get mmwgen 0 -1
if ne r MMOK
ret r
end
r = mmwpublish get mmwgen 0
if ne r MMOK
ret r
end
rqpeer
r = mapwrite get mmwh 0 get arstat 0 rqstat 0 32
if ne r 32
ret -6
end
h = mapnew -1 0 2097152 3 33
if lt h 0
ret h
end
put ogbar 0 h
note GB20B BOOT_42 = 0x1bba1000 = 465178624 (arch=0x1B, impl=0xB).
ret qtattach get mmwgen 0 h 2097152 uint 465178624
end
fn ogframe f ulong n ulong to long
note Vendor frame encoder; model producer explicitly assigns result/sequence/checksum and publishes last.
rqframe f n n uint 0 1
rqput32 2 36 get ogpeer 0
rqput32 2 64 0
rqput32 2 68 0
rqput32 2 32 0
rqput32 2 32 rqsum 2 mul div add add 80 n 7 8 8
slot = rem get ogpeer 0 RQCOUNT
o = add get qtstat 0 mul add slot 1 RQSLOT
r = mapwrite get mmwh 0 o rqtmp 0 RQSLOT
if ne r long RQSLOT
ret -6
end
put ogpeer 0 add get ogpeer 0 1
ret mapset get mmwh 0 add get qtstat 0 16 4 rem get ogpeer 0 RQCOUNT
end
fn ogfeed to long
note Supported CPU_SEQUENCER delay instruction followed by INIT_DONE and engaging lockdown.
rqclear 52
rqput32 4 0 3
rqput32 4 4 2
rqput32 4 40 SQDLY
rqput32 4 44 5
r = ogframe 4098 52
if ne r 0
ret r
end
rqclear 0
r = ogframe 4097 0
if ne r 0
ret r
end
rqclear 1
put rqpay 0 1
ret ogframe 4124 1
end

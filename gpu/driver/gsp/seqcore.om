note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gsp/seqcore.om: Falcon/RISC-V core opcodes 5..8 for GSP_RUN_CPU_SEQUENCER (0x1002).
note Implements sqcorefn(op) for gsp/seq.om & gsp/dispatch.om over gsprd/gspwr/gsppause.
note Source of record: NVIDIA open-gpu-kernel-modules 580.173.02:
note   kernel_gsp.c:5403-5432, kernel_gsp_ga102.c:136-200 (kgspExecuteSequencerCommand_GA102),
note   kernel_falcon.c (kflcnReset, kflcnStartCpu, kflcnWaitForHalt),
note   gb20b/dev_gsp.h (NV_PGSP=0x110000), tu102/dev_falcon_v4.h, gb202/dev_riscv_pri.h.
note Registers (BAR0 decimal):
note   NV_PGSP_FALCON_CPUCTL  = 0x110100 (1114368): STARTCPU bit 1 (2), HALTED bit 4 (16)
note   NV_PGSP_FALCON_DMACTL  = 0x11010c (1114380): DMEM/IMEM scrub bits [2:1] (6)
note   NV_PGSP_FALCON_ENGINE  = 0x1103c0 (1115072): RESET bit 0 (1)
note   NV_PGSP_FALCON_HWCFG2  = 0x1100f4 (1114356): MEM_SCRUBBING bit 12 (4096), LOCKDN bit 13 (8192)
note   NV_PGSP_RISCV_CPUCTL   = 0x111388 (1119112): ACTIVE_STAT bit 7 (128)
note Library unit, no fn main. Compose after gsp/mmio.om (or mmio_bm.om) and gsp/seq.om.

const SCFALCTL ulong 1114368
const SCFALDMA ulong 1114380
const SCFALENG ulong 1115072
const SCSTART ulong 2
const SCHALT ulong 16
const SCSCRUB ulong 4096

global sccount ulong 4

fn scwaitclr off ulong mask ulong budget ulong to bool
n = budget
if eq n 0
n = 1
end
for i ulong add n 1
if eq and gsprd off mask 0
ret true
end
if lt i n
gsppause
end
end
ret false
end

fn scwaitset off ulong mask ulong budget ulong to bool
n = budget
if eq n 0
n = 1
end
for i ulong add n 1
if ne and gsprd off mask 0
ret true
end
if lt i n
gsppause
end
end
ret false
end

note Opcode 5: CORE_RESET (kflcnReset): assert ENGINE.RESET=1, deassert=0, wait MEM_SCRUBBING==0.
fn sccorerst to long
gspwr SCFALENG 1
gsppause
gspwr SCFALENG 0
if not scwaitclr GHWCFG2 SCSCRUB get sqbud 0
ret -1
end
put sccount 0 add get sccount 0 1
ret 0
end

note Opcode 6: CORE_START (kflcnStartCpu): write FALCON_CPUCTL.STARTCPU = 1.
fn sccorestr to long
gspwr SCFALCTL SCSTART
put sccount 1 add get sccount 1 1
ret 0
end

note Opcode 7: CORE_WAIT_FOR_HALT (kflcnWaitForHalt): poll FALCON_CPUCTL.HALTED == 1.
fn sccorehlt to long
if not scwaitset SCFALCTL SCHALT get sqbud 0
ret -1
end
put sccount 2 add get sccount 2 1
ret 0
end

note Opcode 8: CORE_RESUME (kgspExecuteSequencerCommand_GA102): start CPU, wait RISCV ACTIVE_STAT.
fn sccorersm to long
gspwr SCFALCTL SCSTART
if not scwaitset GCPUCTL CPUACT get sqbud 0
ret -1
end
put sccount 3 add get sccount 3 1
ret 0
end

fn sqcorefn op ulong to long
if eq op 5
ret sccorerst
end
if eq op 6
ret sccorestr
end
if eq op 7
ret sccorehlt
end
if eq op 8
ret sccorersm
end
ret -1
end

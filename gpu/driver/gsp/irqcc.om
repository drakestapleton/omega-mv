note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/driver/gsp/irqcc.om: Pure-Omega (OM-1) HALT IRQ -> CrashCat V1 integration unit.
note Links gpu/driver/gsp/logdec.om + an IRQ peer (irqsim.om or irqctl.om) + gpu/driver/gsp/irq.om.
note Preserves irq.om HALT quarantine semantics (iqmask, iqstate=2, pending HALT retained, returns -13)
note while draining and optionally formatting bound CrashCat V1 packets via logdec.om on HALT.
note Host-only model integration; never opens devices, maps MMIO, or performs DMA.
note Prefix iqcc. Library unit: no fn main.

const IQCCLIM ulong 256

note Bind CrashCat queue from GspFwWprMeta (lgwpr) via logdec.om lgwprparse.
note mode: 1 = linear ccbuf[0..sz), 2 = paged LibosLog ring lgbuf[0..sz).
note Returns 1 if bound, 0 if WPR meta has no CrashCat queue, or negative error.
fn iqccbindwpr mode ulong to long
r = lgwprparse
if le r 0
z = iqccbind 0 0 0
ret r
end
b = iqccbind mode get lgccqpa 0 get lgccqsz 0
if lt b 0
ret b
end
ret 1
end

note Drain linear CrashCat V1 packets from ccbuf[0..iqccsz) via ccinit/ccnext/lgfmtcc.
fn iqccdrainlin fmtfd int maxpkts ulong to long
r = ccinit get iqccsz 0
if lt r 0
put iqccerr 0 r
ret r
end
cnt = ulong 0
while lt cnt maxpkts bound 256
r = ccnext
if eq r 0
break
end
if lt r 0
put iqccpkts 0 cnt
put iqccerr 0 r
if ge fmtfd 0
z = lgoflush
end
ret r
end
cnt = add cnt 1
if ge fmtfd 0
lgfmtcc
end
end
if ge fmtfd 0
z = lgoflush
end
put iqccpkts 0 cnt
put iqccerr 0 0
ret long cnt
end

note Drain paged LibosLog ring CrashCat V1 packets from lgbuf[0..iqccsz) via lgrinit/ccnextring/lgfmtcc.
fn iqccdrainring fmtfd int maxpkts ulong to long
r = lgrinit get iqccsz 0 LGPAGE
if lt r 0
put iqccerr 0 r
ret r
end
cnt = ulong 0
while lt cnt maxpkts bound 256
r = ccnextring
if eq r 0
break
end
if lt r 0
put iqccpkts 0 cnt
put iqccerr 0 r
if ge fmtfd 0
z = lgoflush
end
ret r
end
cnt = add cnt 1
if ge fmtfd 0
lgfmtcc
end
end
if ge fmtfd 0
z = lgoflush
end
put iqccpkts 0 cnt
put iqccerr 0 0
ret long cnt
end

note Drain bound CrashCat V1 queue buffer; fmtfd < 0 skips formatting, fmtfd >= 0 formats via lgfmtcc.
note Returns decoded packet count (>= 0) on success, or negative decoder error.
fn iqccdrain fmtfd int maxpkts ulong to long
put iqccpkts 0 0
put iqccerr 0 0
m = get iqccbound 0
if eq m 0
ret 0
end
if or eq maxpkts 0 gt maxpkts IQCCLIM
put iqccerr 0 -1
ret -1
end
if ge fmtfd 0
lgoinit fmtfd
end
if eq m 1
ret iqccdrainlin fmtfd maxpkts
end
if eq m 2
ret iqccdrainring fmtfd maxpkts
end
put iqccerr 0 -1
ret -1
end

note Service GSP IRQ and, on HALT quarantine (-13 with iqhalt=1), decode bound CrashCat V1 queue.
note Returns exact iqservice status (-13 on HALT quarantine; CrashCat results in iqccpkts/iqccerr/cc*).
fn iqservicecc gen ulong budget ulong fmtfd int maxpkts ulong to long
r = iqservice gen budget
if and eq r -13 eq get iqhalt 0 1
if ne get iqccbound 0 0
d = iqccdrain fmtfd maxpkts
end
end
ret r
end

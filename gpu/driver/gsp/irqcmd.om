note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Next host milestone: immutable model command consumption with once-only exact-sequence ACK.
note iqcommand acceptance/iqcack consumption NEVER claims MMU/TLB completion or a physical RPC ID.
global iqchold ulong 1
global iqcitem uchar 40
fn iqcget word ulong to ulong
if gt word 4
ret 0
end
v = ulong 0
for i ulong 8
v = or v shl ulong get iqcitem add mul word 8 i mul i 8
end
ret v
end
fn iqctake to long
if ne get iqcmode 0 1
ret -95
end
if or ne get iqcstate 0 1 ne get iqchold 0 0
ret -4
end
if eq get iqccons 0 get iqcprod 0
ret 0
end
o = mul rem get iqccons 0 8 40
for i ulong 40
put iqcitem i get iqcmd add o i
end
put iqchold 0 1
ret 1
end
fn iqcack seq ulong to long
if ne get iqcmode 0 1
ret -95
end
if or ne get iqcstate 0 1 ne get iqchold 0 1
ret -4
end
if or eq seq 0 ne seq iqcget 1
ret -4
end
put iqchold 0 0
put iqccons 0 add get iqccons 0 1
ret 0
end
fn iqcrevoke to long
if ne get iqcmode 0 1
ret -95
end
if ne get iqcstate 0 1
ret -4
end
put iqcstate 0 2
put iqchold 0 0
note No consumer publication on cancellation; queued/unacknowledged records are retained.
ret 0
end

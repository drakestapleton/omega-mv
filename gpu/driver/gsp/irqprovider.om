note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Explicit serialized host device model and real anonymous-map MMIO fixture.
note Device work is independent of IRQ delivery and CPU handlers. Stop progresses only on peer ticks.
note Model registers are offsets0=status,4=mask,8=host destination,12=clear; NOT GB10 register offsets.
note WolframLanguageEvaluator:4096-4 ->4092 bytes, final aligned4-byte register offset.
note Single device generation/index owner; no automatic reopen or ownership transfer.
global pvgen ulong 1
global pvmode ulong 1
global pverr long 1
global pvbad ulong 1
global pvreg ulong 1
global pvalloc ulong 1
global pvenable ulong 1
global pvcan ulong 1
global pvstopr ulong 1
global pvstopd ulong 1
global pvwork ulong 1
global pvqueued ulong 1
global pvlocked ulong 1
global pvrepoch ulong 1
global pvback ulong 1
global pvproof ulong 1
global pvmm long 1
global pvmmid ulong 1
global pvmmlive ulong 1
global pvfx ulong 1
global pvnotify ulong 1
global pvcount ulong 1
global pvmasks ulong 1
global pvfreec ulong 1
global pvbytes ulong 1
global pvidx ulong 1
global pvstart ulong 1
global pvn ulong 1
fn pvinit gen ulong mode ulong to long
if or eq gen 0 ne get pvgen 0 0
ret -4
end
if not or eq mode 1 eq mode 2
ret -95
end
if eq mode 2
if or ne gen get vigen 0 ne get vistate 0 1
ret -4
end
end
put pvgen 0 gen
put pvmode 0 mode
put pvcount 0 64
put pvbytes 0 4096
ret 0
end
fn mmspanmk gen ulong to mmspan
put pverr 0 -4
if or ne gen get pvgen 0 or eq gen 0 ne get pvmmid 0 0
ret seal mmspan ulong 0
end
h = long -95
if eq get pvmode 0 1
h = mapnew -1 0 4096 3 33
end
if eq get pvmode 0 2
h = vimmio uint 0
if gt h 0
put pvbytes 0 get vibytes 0
end
end
if lt h 0
put pverr 0 h
ret seal mmspan ulong 0
end
put pvmm 0 h
put pvmmid 0 1
put pvmmlive 0 1
put pverr 0 0
ret seal mmspan ulong 1
end
note Trusted callback seams carry scalar IDs internally because OM2 abstract values cannot be globals.
note These internal helpers preserve EVERY generation/owner/lockdown check; they are not new authority.
fn pvvalid cap ulong gen ulong to bool
ret and ne gen 0 and eq gen get pvgen 0 and eq cap get pvmmid 0 and ne cap 0 eq get pvmmlive 0 1
end
fn mmvalid cap mmspan gen ulong to bool
ret pvvalid open cap gen
end
fn mmread cap mmspan owner howner gen ulong off ulong to long
ret pvread open cap open owner gen off
end
fn pvread cap ulong owner ulong gen ulong off ulong to long
if not pvvalid cap gen
ret -4
end
if ne get pvlocked 0 0
ret -14
end
if or ne get ilactive 0 1 or eq owner 0 ne owner get ilowner 0
ret -4
end
if not or eq get ilstate 0 2 eq get ilstate 0 3
ret -4
end
if or gt off sub get pvbytes 0 4 ne rem off 4 0
ret -1
end
put pvfx 0 add get pvfx 0 1
ret long mapget get pvmm 0 off 4
end
fn mmwrite cap mmspan owner howner gen ulong off ulong value uint to long
ret pvwrite open cap open owner gen off value
end
fn pvwrite cap ulong owner ulong gen ulong off ulong value uint to long
if not pvvalid cap gen
ret -4
end
if ne get pvlocked 0 0
ret -14
end
if or ne get ilactive 0 1 or eq owner 0 ne owner get ilowner 0
ret -4
end
if not or eq get ilstate 0 2 eq get ilstate 0 3
ret -4
end
if or gt off sub get pvbytes 0 4 ne rem off 4 0
ret -1
end
put pvfx 0 add get pvfx 0 1
ret mapset get pvmm 0 off 4 ulong value
end
fn pvquery idx ulong start ulong count ulong to long
if eq get pvmode 0 2
r = viquery idx start count
if ne r 0
ret r
end
put pvcount 0 get vicount 0
else
if ne get pvmode 0 1
ret -95
end
if or ne idx 0 or eq count 0 gt start get pvcount 0
ret -1
end
if gt count sub get pvcount 0 start
ret -1
end
end
put pvidx 0 idx
put pvstart 0 start
put pvn 0 count
ret 0
end
fn pvregister idx ulong start ulong count ulong to long
if or ne idx get pvidx 0 or ne start get pvstart 0 or eq count 0 ne count get pvn 0
ret -4
end
if eq get pvmode 0 2
r = viregister
put pvalloc 0 get vialloc 0
put pvreg 0 get vireg 0
ret r
end
put pvalloc 0 1
put pvreg 0 1
put pvenable 0 0
if or eq get pvbad 0 1 eq get pvbad 0 2
note A failed registration is clean only when rollback is acknowledged.
if ne get pvbad 0 2
put pvreg 0 0
put pvalloc 0 0
end
ret -5
end
ret 0
end
fn pvunmask to long
if or ne get pvreg 0 1 ne get pvstopr 0 0
ret -4
end
if eq get pvmode 0 2
r = viunmask
if ne r 0
ret r
end
end
put pvenable 0 1
ret 0
end
fn pvdisable to long
note Backend IRQ registration disable is NOT a register mask; legal after lockdown.
if eq get pvbad 0 3
ret -5
end
if eq get pvmode 0 2
r = vidisable
if ne r 0
ret r
end
end
put pvenable 0 0
put pvmasks 0 add get pvmasks 0 1
ret 0
end
fn pvcancel to long
if eq get pvbad 0 4
ret -5
end
if eq get pvmode 0 2
r = vican
if ne r 0
ret r
end
end
put pvcan 0 1
ret 0
end
fn pvstop epoch ulong backing ulong to long
note Real GSP/device stop has no verified firmware/backend acknowledgement yet.
note IRQ disable/cancellation is NOT a substitute. Retain the physical lease and mapping.
if ne get pvmode 0 1
ret -95
end
if eq get pvbad 0 7
ret -5
end
if or eq epoch 0 eq backing 0
ret -1
end
put pvstopr 0 1
put pvrepoch 0 epoch
put pvback 0 backing
ret 0
end
fn pvtick to long
if ne get pvmode 0 1
ret -95
end
if eq get pvbad 0 5
ret 0
end
note One model clock tick completes one preexisting device access, independently of IRQ masking.
if gt get pvwork 0 0
put pvwork 0 sub get pvwork 0 1
ret 0
end
if gt get pvqueued 0 0
put pvqueued 0 sub get pvqueued 0 1
put pvwork 0 1
ret 0
end
if ne get pvstopr 0 0
put pvstopd 0 1
put pvproof 0 get pvrepoch 0
ret 1
end
ret 0
end
fn pvattest epoch ulong backing ulong to bool
if ne get pvstopd 0 1
ret false
end
if ne get pvproof 0 epoch
ret false
end
if ne get pvback 0 backing
ret false
end
if ne get pvwork 0 0
ret false
end
ret eq get pvqueued 0 0
end
note Independent modeled peer admission; IRQ masking never proves this source is stopped.
fn pvpeer to long
if ne get pvstopr 0 0
ret -4
end
if eq add get pvwork 0 1 0
ret -1
end
put pvwork 0 add get pvwork 0 1
ret 0
end
fn pvsubmit to long
if ne get pvstopr 0 0
ret -4
end
if ne get pvenable 0 1
ret -4
end
put pvqueued 0 add get pvqueued 0 1
ret 0
end
fn pvfree cap mmspan gen ulong to long
if not mmvalid cap gen
ret -4
end
if eq get pvbad 0 6
ret -5
end
if eq get pvmode 0 2
r = virelease
if ne r 0
ret r
end
end
r = mapdrop get pvmm 0
if ne r 0
ret r
end
put pvmmlive 0 0
put pvreg 0 0
put pvalloc 0 0
put pvfreec 0 add get pvfreec 0 1
ret 0
end

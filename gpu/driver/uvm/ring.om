note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Serialized host snapshot ring, 16 NVC369 entries. Not DMA or an atomic device ring.
note GET/PUT are monotonic logical counters; physical slot is index modulo 16.
note Full refuses without overwriting unread entries and latches overflow until empty recovery.
global fbring uchar 512
global fbget ulong 1
global fbput ulong 1
global fbov ulong 1
global fbva ulong 16
global fbacc ulong 16
global fbn ulong 1
fn fbpush to ulong
if ge sub get fbput 0 get fbget 0 16
put fbov 0 1
ret UVENOM
end
if eq get fbput 0 18446744073709551615
ret UVERANGE
end
o = mul rem get fbput 0 16 32
for j ulong 32
put fbring add o j get uvpkt j
end
put fbput 0 add get fbput 0 1
ret UVOK
end
fn fbpeek to ulong
if eq get fbget 0 get fbput 0
ret UVIGN
end
o = mul rem get fbget 0 16 32
for j ulong 32
put uvpkt j get fbring add o j
end
uvpktdec
if eq get uvfval 0 0
ret UVIGN
end
ret UVOK
end
fn fbconsume to void
o = add mul rem get fbget 0 16 32 31
put fbring o uchar and get fbring o 127
put fbget 0 add get fbget 0 1
end
fn fbrecover to ulong
if ne get fbget 0 get fbput 0
ret UVEBUSY
end
put fbov 0 0
ret UVOK
end
fn fbduplicate to bool
for j ulong get fbn 0
if ne get fbva j get uvfva 0
continue
end
if eq get fbacc j get uvfacc 0
ret true
end
end
ret false
end
fn fbbenign to bool
if ne get uvfen 0 1
ret false
end
if ne get uvfrep 0 1
ret false
end
ret lt get uvftyp 0 3
end
fn fbbatch to ulong
put fbn 0 0
for k ulong 16
r = fbpeek
if ne r UVOK
ret UVOK
end
note Never deduplicate a fatal/disabled packet behind a benign same-page fault.
if fbbenign
if fbduplicate
fbconsume
continue
end
put fbva get fbn 0 get uvfva 0
put fbacc get fbn 0 get uvfacc 0
put fbn 0 add get fbn 0 1
end
r = sservice
if eq r UVENOM
ret r
end
fbconsume
end
ret UVOK
end

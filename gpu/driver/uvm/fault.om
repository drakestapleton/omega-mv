note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note uvm/fault.om: NVC369 32-byte fault packet and the replay policy.
note Word 2 holds page-number bits 19:0 at 31:12. Word 3 holds bits 51:20.
note Word 4 is timestamp 31:0, word 5 is timestamp 63:32. Word 7 is
note type 4:0, replayable 7:7, client 14:8, access 19:16, enable 30:30, valid 31:31.
note Policy: invalid packet is ignored. A non-replayable packet, a disabled engine,
note or a type other than PDE (0), PTE (1) or LIMIT (2) is fatal. A valid replayable
note fault outside a reservation, or inside one with no backing, is cancelled.
note A write or atomic on a read-only reservation is fatal. Otherwise the missing
note page is mapped from the reservation backing and the fault is replayed.
global uvpkt uchar 32
global uvfva ulong 1
global uvfts ulong 1
global uvftyp ulong 1
global uvfrep ulong 1
global uvfacc ulong 1
global uvfcli ulong 1
global uvfen ulong 1
global uvfval ulong 1
fn uvpktw n ulong v ulong to void
b = mul n 4
put uvpkt b uchar and v 255
put uvpkt add b 1 uchar and shr v 8 255
put uvpkt add b 2 uchar and shr v 16 255
put uvpkt add b 3 uchar and shr v 24 255
end
fn uvpktlw n ulong to ulong
b = mul n 4
v = ulong get uvpkt b
v = or v shl ulong get uvpkt add b 1 8
v = or v shl ulong get uvpkt add b 2 16
ret or v shl ulong get uvpkt add b 3 24
end
fn uvpktenc va ulong ts ulong typ ulong rep ulong acc ulong cli ulong to void
for i ulong 32
put uvpkt i 0
end
uvpktw 2 shl and shr va 12 1048575 12
uvpktw 3 shr va 32
uvpktw 4 and ts 4294967295
uvpktw 5 shr ts 32
w = and typ 31
w = or w shl and rep 1 7
w = or w shl and cli 127 8
w = or w shl and acc 15 16
w = or w shl and get uvfen 0 1 30
w = or w shl and get uvfval 0 1 31
uvpktw 7 w
end
fn uvdecva to void
w2 = uvpktlw 2
w3 = uvpktlw 3
put uvfva 0 shl or shr w2 12 shl w3 20 12
end
fn uvdects to void
put uvfts 0 or uvpktlw 4 shl uvpktlw 5 32
end
fn uvdecw7 to void
w = uvpktlw 7
put uvftyp 0 and w 31
put uvfrep 0 and shr w 7 1
put uvfcli 0 and shr w 8 127
put uvfacc 0 and shr w 16 15
put uvfen 0 and shr w 30 1
put uvfval 0 and shr w 31 1
end
fn uvpktdec to void
uvdecva
uvdects
uvdecw7
end
fn uvpolicy to ulong
if eq get uvfval 0 0
ret UVIGN
end
if eq get uvfen 0 0
ret UVFATAL
end
if eq get uvfrep 0 0
ret UVFATAL
end
if ge get uvftyp 0 3
ret UVFATAL
end
i = uvfind get uvfva 0
if ge i 32
ret UVCANCEL
end
if eq get uvrpa i 0
ret UVCANCEL
end
if and ne get uvrro i 0 or eq get uvfacc 0 1 eq get uvfacc 0 2
ret UVFATAL
end
ret UVREPLAY
end
fn uvserve to ulong
uvpktdec
act = uvpolicy
if ne act UVREPLAY
ret act
end
ret uvfix
end
fn uvfix to ulong
i = uvfind get uvfva 0
page = get uvrpg i
base = get uvrva i
off = and sub get uvfva 0 base not sub page 1
pa = add get uvrpa i off
r = uvread add base off page
if eq r UVMAPPED
ret UVREPLAY
end
pcf = ulong 0
if ne get uvrro i 0
pcf = 4
end
r2 = uvmap add base off pa page page UVAPSYS pcf
if ne r2 UVOK
ret UVFATAL
end
ret UVREPLAY
end

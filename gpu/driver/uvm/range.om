note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note One va_space per service instance, 64 ranges. Sorted implicit binary tree.
note Rows: base,size,physical base,preferred(0 CPU/1 GPU),accessed-by mask,read-dup,RO,reserved.
note Binary lookup traverses midpoint children; mutation moves bounded rows, never page backing.
global sr ulong 512
global sn ulong 1
global slive ulong 1
fn sget i ulong f ulong to ulong
ret get sr add mul i 8 f
end
fn sset i ulong f ulong v ulong to void
put sr add mul i 8 f v
end
fn scopy dst ulong src ulong to void
for f ulong 8
sset dst f sget src f
end
end
fn sfind va ulong to ulong
lo = ulong 0
hi = get sn 0
while lt lo hi bound 7
mid = div add lo hi 2
if lt va sget mid 0
hi = mid
else
if lt sub va sget mid 0 sget mid 1
ret mid
end
lo = add mid 1
end
end
ret 64
end
fn screate to ulong
if ne get slive 0 0
ret UVEBUSY
end
r = uvinit
if ne r UVOK
ret r
end
put sn 0 0
put slive 0 1
ret UVOK
end
fn sdestroy to ulong
if eq get slive 0 0
ret UVENOENT
end
if ne get sn 0 0
ret UVEBUSY
end
if not squiescent
ret UVEBUSY
end
put slive 0 0
ret UVOK
end
fn scheck va ulong size ulong pa ulong pol ulong to ulong
if eq get slive 0 0
ret UVEPERM
end
if ne rem va UV4K 0
ret UVEALIGN
end
if ne rem size UV4K 0
ret UVEALIGN
end
if ne rem pa UV4K 0
ret UVEALIGN
end
if or eq size 0 ge va add UVBASE UVWIN
ret UVERANGE
end
if lt va UVBASE
ret UVERANGE
end
if gt size sub add UVBASE UVWIN va
ret UVERANGE
end
if or ge pa UVPA52 gt size sub UVPA52 pa
ret UVERANGE
end
if and ne pa 0 uvpoolhit pa size
ret UVERANGE
end
if gt pol 63
ret UVEINVAL
end
ret UVOK
end
fn sadd va ulong size ulong pa ulong pol ulong to ulong
r = scheck va size pa pol
if ne r UVOK
ret r
end
for i ulong get sn 0
if lt va add sget i 0 sget i 1
if lt sget i 0 add va size
ret UVEBUSY
end
end
end
if eq get sn 0 64
ret UVENOM
end
pos = ulong 0
for i ulong get sn 0
if lt sget i 0 va
pos = add pos 1
end
end
j = get sn 0
while gt j pos bound 64
scopy j sub j 1
j = sub j 1
end
sset pos 0 va
sset pos 1 size
sset pos 2 pa
sset pos 3 and pol 1
sset pos 4 and shr pol 1 3
sset pos 5 and shr pol 3 1
sset pos 6 and shr pol 4 1
sset pos 7 and shr pol 5 1
put sn 0 add get sn 0 1
ret UVOK
end
fn ssplit va ulong to ulong
if ne rem va UV4K 0
ret UVEALIGN
end
i = sfind va
if eq i 64
ret UVENOENT
end
if eq va sget i 0
ret UVEINVAL
end
if eq get sn 0 64
ret UVENOM
end
j = get sn 0
while gt j i bound 64
scopy j sub j 1
j = sub j 1
end
off = sub va sget i 0
sset add i 1 0 va
sset add i 1 1 sub sget i 1 off
if ne sget i 2 0
sset add i 1 2 add sget i 2 off
end
sset i 1 off
put sn 0 add get sn 0 1
ret UVOK
end
fn serase i ulong to void
j = i
while lt add j 1 get sn 0 bound 64
scopy j add j 1
j = add j 1
end
put sn 0 sub get sn 0 1
for f ulong 8
sset get sn 0 f 0
end
end
fn smerge va ulong to ulong
i = sfind va
if eq i 64
ret UVENOENT
end
j = add i 1
if ge j get sn 0
ret UVENOENT
end
if ne add sget i 0 sget i 1 sget j 0
ret UVEINVAL
end
if ne sget i 2 0
if ne add sget i 2 sget i 1 sget j 2
ret UVEINVAL
end
else
if ne sget j 2 0
ret UVEINVAL
end
end
for f ulong 5
if ne sget i add f 3 sget j add f 3
ret UVEPERM
end
end
sset i 1 add sget i 1 sget j 1
serase j
ret UVOK
end
fn sremove va ulong size ulong to ulong
if or ne rem va UV4K 0 ne rem size UV4K 0
ret UVEALIGN
end
i = sfind va
if eq i 64
ret UVENOENT
end
if or ne va sget i 0 ne size sget i 1
ret UVEINVAL
end
if ne get iqcprod 0 get iqccons 0
ret UVEBUSY
end
note Unmap each installed 4K PTE, never reclaim hardware backing or PT pages.
off = ulong 0
while lt off size bound 65536
r = uvread add va off UV4K
if eq r UVMAPPED
r = uvunmap add va off UV4K UV4K
end
off = add off UV4K
end
serase i
sforget va size
ret UVOK
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note UVM-owned MODEL notification, not a physical IRQ or TLB completion lease.
note Uses omega-mv#1045 eventfd only. No OmcVfioIrq registration or device open.
abstract unirq ulong
global unfd int 1
global unlive ulong 1
global unwakes ulong 1
global unbytes uchar 8
fn unvalid cap unirq to bool
ret and eq open cap 1 eq get unlive 0 1
end
fn unirqmk to unirq
if ne get unlive 0 0
ret seal unirq ulong 0
end
r = eventfd uint 0
if lt r 0
ret seal unirq ulong 0
end
put unfd 0 int r
put unlive 0 1
ret seal unirq ulong 1
end
fn unpost cap unirq to long
if not unvalid cap
ret -9
end
r = fbpush
if ne r UVOK
ret long r
end
for j ulong 8
put unbytes j 0
end
put unbytes 0 1
wr = write get unfd 0 unbytes 0 8
if ne wr 8
note Entry remains owned by the ring; never undo a possibly delivered notification.
ret -5
end
ret 0
end
fn unpump cap unirq timeout long to long
if not unvalid cap
ret -9
end
r = waitio get unfd 0 1 timeout
if eq r 0
ret 0
end
if lt r 0
ret r
end
r = read get unfd 0 unbytes 0 8
if ne r 8
ret -5
end
count = ulong 0
for j ulong 8
count = or count shl ulong get unbytes j mul j 8
end
put unwakes 0 add get unwakes 0 count
r2 = fbbatch
if ne r2 UVOK
ret long r2
end
ret 1
end
fn unclose cap unirq to long
if not unvalid cap
ret -9
end
put unlive 0 2
ret fclose get unfd 0
end

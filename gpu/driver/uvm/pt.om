note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note uvm/pt.om: page-table walk, map/unmap, and the 32-slot VA allocator.
note Walk codes UVCONT UVFREE UVMAPPED UVCONF UVMISS stay inside this unit.
note The public returns are UVOK through UVFATAL.
fn uvwklv va ulong to ulong
tbl = ulong 0
for lv ulong 4
idx = uvlvidx lv va
ent = add tbl mul idx 8
v = uvld64 ent
if ne and v 1 0
ret UVCONF
end
if eq and shr v 1 3 0
put uvmiss 0 add lv 1
ret UVMISS
end
pa = and v UVPDMSK
if uvbadpa pa
ret UVCONF
end
tbl = sub pa UVPOOL
end
put uvtbl 0 tbl
ret UVCONT
end
fn uvslot va ulong lv ulong to ulong
tbl = ulong 0
for j ulong lv
v = uvld64 add tbl mul uvlvidx j va 8
tbl = sub and v UVPDMSK UVPOOL
end
ret add tbl mul uvlvidx lv va 8
end
fn uvfill va ulong to ulong
for n ulong 5
r = uvwklv va
if eq r UVCONT
ret UVOK
end
if ne r UVMISS
ret r
end
lv = sub get uvmiss 0 1
r2 = uvptnew
if ne r2 UVOK
ret r2
end
uvst64 uvslot va lv uvpde add UVPOOL get uvout 0 UVAPSYS
end
ret UVENOM
end
fn uvpdent va ulong to ulong
idx = uvlvidx 4 va
ent = add get uvtbl 0 mul idx 16
put uvw0 0 uvld64 ent
put uvw1 0 uvld64 add ent 8
ret ent
end
fn uvwk2m va ulong to ulong
ent = uvpdent va
w0 = get uvw0 0
if ne and w0 1 0
put uvleaf 0 ent
ret UVMAPPED
end
if or ne and shr w0 1 3 0 ne and shr get uvw1 0 1 3 0
ret UVCONF
end
put uvleaf 0 ent
ret UVFREE
end
fn uvwk64 va ulong to ulong
ent = uvpdent va
w0 = get uvw0 0
if ne and w0 1 0
ret UVCONF
end
if ne and shr get uvw1 0 1 3 0
ret UVCONF
end
ap = and shr w0 1 3
if eq ap 0
put uvmiss 0 5
ret UVMISS
end
pa = and w0 UVBIGMSK
if uvbadpa pa
ret UVCONF
end
idx = uvlvidx 5 va
put uvleaf 0 add sub pa UVPOOL mul idx 8
v = uvld64 get uvleaf 0
if ne and v 1 0
ret UVMAPPED
end
ret UVFREE
end
fn uvwk4 va ulong to ulong
ent = uvpdent va
w1 = get uvw1 0
if ne and w1 1 0
ret UVCONF
end
if ne and shr get uvw0 0 1 3 0
ret UVCONF
end
ap = and shr w1 1 3
if eq ap 0
put uvmiss 0 6
ret UVMISS
end
pa = and w1 UVPDMSK
if uvbadpa pa
ret UVCONF
end
idx = uvlvidx 6 va
put uvleaf 0 add sub pa UVPOOL mul idx 8
v = uvld64 get uvleaf 0
if ne and v 1 0
ret UVMAPPED
end
ret UVFREE
end
fn uvwalk va ulong page ulong to ulong
r = uvwklv va
if ne r UVCONT
ret r
end
if eq page UV2M
ret uvwk2m va
end
if eq page UV64K
ret uvwk64 va
end
ret uvwk4 va
end
fn uvens64 va ulong to ulong
r = uvwk64 va
if ne r UVMISS
ret r
end
r2 = uvptnew
if ne r2 UVOK
ret r2
end
ent = uvpdent va
uvst64 ent uvpde add UVPOOL get uvout 0 UVAPSYS
ret uvwk64 va
end
fn uvens4 va ulong to ulong
r = uvwk4 va
if ne r UVMISS
ret r
end
r2 = uvptnew
if ne r2 UVOK
ret r2
end
ent = uvpdent va
uvst64 add ent 8 uvpde add UVPOOL get uvout 0 UVAPSYS
uvst64 ent 0
ret uvwk4 va
end
fn uvensure va ulong page ulong to ulong
r = uvfill va
if ne r UVOK
ret r
end
if eq page UV2M
ret uvwk2m va
end
if eq page UV64K
ret uvens64 va
end
ret uvens4 va
end
fn uvchk va ulong size ulong page ulong to ulong
if and ne page UV4K and ne page UV64K ne page UV2M
ret UVEINVAL
end
if eq size 0
ret UVEINVAL
end
if gt size mul page 8
ret UVEINVAL
end
if ne rem size page 0
ret UVEINVAL
end
if ne and va sub page 1 0
ret UVEALIGN
end
if ge va UVVA57
ret UVERANGE
end
if gt size sub UVVA57 va
ret UVERANGE
end
ret UVOK
end
fn uvaddneed va ulong page ulong to ulong
r = uvwalk va page
if or eq r UVMAPPED eq r UVCONF
ret UVEBUSY
end
if ne r UVMISS
ret UVOK
end
last = ulong 6
if eq page UV2M
last = 4
end
if eq page UV64K
last = 5
end
j = get uvmiss 0
while le j last bound 8
skip = and eq page UV4K eq j 5
if not skip
key = shr va add uvlvhi j 1
if ne key get uvkey j
put uvkey j key
put uvout 0 add get uvout 0 1
end
end
j = add j 1
end
ret UVOK
end
fn uvinstall va ulong pa ulong page ulong ap ulong pcf ulong to ulong
r = uvensure va page
if ne r UVFREE
ret r
end
uvst64 get uvleaf 0 uvpte pa ap pcf
ret UVOK
end
fn uvpoolhit pa ulong sz ulong to bool
if ge pa add UVPOOL UVBYTES
ret false
end
if le add pa sz UVPOOL
ret false
end
ret true
end
fn uvchkmap va ulong pa ulong size ulong page ulong ap ulong pcf ulong to ulong
r = uvchk va size page
if ne r UVOK
ret r
end
if ne and pa sub page 1 0
ret UVEALIGN
end
if ge pa UVPA52
ret UVERANGE
end
if gt size sub UVPA52 pa
ret UVERANGE
end
if uvpoolhit pa size
ret UVERANGE
end
if gt ap 3
ret UVEINVAL
end
if gt pcf 31
ret UVEINVAL
end
ret UVOK
end
fn uvmap va ulong pa ulong size ulong page ulong ap ulong pcf ulong to ulong
r = uvchkmap va pa size page ap pcf
if ne r UVOK
ret r
end
for k ulong 8
put uvkey k 18446744073709551615
end
put uvout 0 0
off = ulong 0
for n ulong 8
if ge off size
break
end
r = uvaddneed add va off page
if ne r UVOK
ret r
end
off = add off page
end
if gt get uvout 0 uvnfree
ret UVENOM
end
off = 0
for n ulong 8
if ge off size
break
end
r = uvinstall add va off add pa off page ap pcf
if ne r UVOK
ret r
end
off = add off page
end
ret UVOK
end
fn uvunmap va ulong size ulong page ulong to ulong
r = uvchk va size page
if ne r UVOK
ret r
end
off = ulong 0
for n ulong 8
if ge off size
break
end
r = uvwalk add va off page
if ne r UVMAPPED
ret UVENOENT
end
off = add off page
end
off = 0
for n ulong 8
if ge off size
break
end
r = uvwalk add va off page
if ne r UVMAPPED
ret UVENOENT
end
uvst64 get uvleaf 0 0
off = add off page
end
ret UVOK
end
fn uvread va ulong page ulong to ulong
r = uvwalk va page
if ne r UVMAPPED
put uvdpa 0 0
put uvdap 0 0
put uvdpcf 0 0
put uvdv 0 0
ret r
end
v = uvld64 get uvleaf 0
put uvdv 0 and v 1
put uvdap 0 and shr v 1 3
put uvdpcf 0 and shr v 3 31
put uvdpa 0 and v UVPDMSK
ret UVMAPPED
end
fn uvoverlap va ulong sz ulong to bool
for i ulong 32
if ne get uvrsz i 0
b = get uvrva i
if and lt va add b get uvrsz i lt b add va sz
ret true
end
end
end
ret false
end
fn uvclaim va ulong sz ulong page ulong to ulong
for i ulong 32
if eq get uvrsz i 0
put uvrva i va
put uvrsz i sz
put uvrpg i page
put uvrpa i 0
put uvrro i 0
put uvrn 0 add get uvrn 0 1
put uvout 0 va
ret UVOK
end
end
ret UVENOM
end
fn uvallocat va ulong sz ulong page ulong to ulong
if and ne page UV4K and ne page UV64K ne page UV2M
ret UVEINVAL
end
if eq sz 0
ret UVEINVAL
end
if ne rem sz page 0
ret UVEINVAL
end
if ne rem va page 0
ret UVEALIGN
end
if lt va UVBASE
ret UVERANGE
end
if gt sz sub add UVBASE UVWIN va
ret UVERANGE
end
if uvoverlap va sz
ret UVEBUSY
end
ret uvclaim va sz page
end
fn uvalloc sz ulong page ulong to ulong
if and ne page UV4K and ne page UV64K ne page UV2M
ret UVEINVAL
end
if eq sz 0
ret UVEINVAL
end
if ne rem sz page 0
ret UVEINVAL
end
if gt sz UVWIN
ret UVERANGE
end
off = UVBASE
while lt off add UVBASE UVWIN bound 65536
if eq rem off page 0
if not uvoverlap off sz
if le sz sub add UVBASE UVWIN off
ret uvclaim off sz page
end
end
end
off = add off page
end
ret UVENOM
end
fn uvfind va ulong to ulong
for i ulong 32
if ne get uvrsz i 0
if and ge va get uvrva i lt va add get uvrva i get uvrsz i
ret i
end
end
end
ret 32
end
fn uvbind va ulong pa ulong to ulong
i = uvfind va
if ge i 32
ret UVENOENT
end
page = get uvrpg i
if ne rem pa page 0
ret UVEALIGN
end
if ge pa UVPA52
ret UVERANGE
end
if uvpoolhit pa page
ret UVERANGE
end
put uvrpa i pa
ret UVOK
end
fn uvprot va ulong ro ulong to ulong
i = uvfind va
if ge i 32
ret UVENOENT
end
put uvrro i ro
ret UVOK
end
fn uvinit to ulong
for i ulong 65536
put uvmem i 0
end
for i ulong 16
put uvused i 0
end
for i ulong 32
put uvrsz i 0
put uvrva i 0
put uvrpa i 0
put uvrro i 0
put uvrpg i 0
end
put uvrn 0 0
ret uvptnew
end

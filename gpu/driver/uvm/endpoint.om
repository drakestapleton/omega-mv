note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note CUSE ABI from Linux linux/fuse.h:745-775,879-898,914-975. No libfuse or C runtime.
note Parent never dispatches UVM state; every open file description forks a pristine private worker.
global epin uchar 16384
global epout uchar 16384
global epwire uchar 16384
global epfds uchar 16
global epstatus uchar 4
global epclnt ulong 40
global epnext ulong 1
global epready ulong 1
global epfake ulong 1
global epdevice int 1
global eplen ulong 1
global epaddr uchar 35
global epcred uchar 12
global epunique ulong 1
text epname "DEVNAME=omega-uvm-test"
text epdev "/dev/cuse"
text epfarg "--fake"
text epcarg "--cuse"
fn epget off ulong n ulong to ulong
v = ulong 0
for j ulong n
v = or v shl ulong get epin add off j mul j 8
end
ret v
end
fn ewget off ulong n ulong to ulong
v = ulong 0
for j ulong n
v = or v shl ulong get epwire add off j mul j 8
end
ret v
end
fn epset off ulong n ulong v ulong to void
for j ulong n
put epout add off j uchar and shr v mul j 8 255
end
end
fn ewset off ulong n ulong v ulong to void
for j ulong n
put epwire add off j uchar and shr v mul j 8 255
end
end
fn epfd off ulong to int
v = ulong 0
for j ulong 4
v = or v shl ulong get epfds add off j mul j 8
end
ret int v
end
fn epio fd int off ulong n ulong writing bool to bool
pos = ulong 0
deadline = add monons long 5000000000
while lt pos n bound 16384
left = sub deadline monons
if le left 0
ret false
end
events = int 1
if writing
events = 4
end
r = waitio fd events left
if le r 0
if eq r neg long 4
continue
end
ret false
end
if writing
r = send fd epwire add off pos sub n pos 0
else
r = recv fd epwire add off pos sub n pos 0
end
if eq r neg long 4
continue
end
if le r 0
ret false
end
pos = add pos ulong r
end
ret eq pos n
end
fn epfind fh ulong to ulong
if eq fh 0
ret 8
end
for j ulong 8
if eq get epclnt mul j 5 fh
ret j
end
end
ret 8
end
fn epdrop i ulong to void
base = mul i 5
pid = int get epclnt add base 1
wr = int get epclnt add base 2
note Revoke routing before closing or waiting. Handle values are never reused.
put epclnt base 0
r = fclose wr
note The isolated worker has no device authority; terminate and reap this exact child.
r = killpid pid 15
r = waitpid pid epstatus 0 4 0
end
fn epcleanup to void
for j ulong 8
if ne get epclnt mul j 5 0
epdrop j
end
end
end
fn epworkone rd int wr int to int
if not epio rd 0 24 false
ret 77
end
cmd = ewget 0 8
size = ewget 8 8
seq = ewget 16 8
if or eq size 0 gt size 9264
ret 75
end
if ne size sisize cmd
ret 76
end
if not epio rd 24 size false
ret 77
end
for j ulong size
put siab j get epwire add j 24
end
rc = sidispatch cmd size
ewset 0 8 rc
ewset 8 8 get siolen 0
ewset 16 8 seq
for j ulong get siolen 0
put epwire add j 24 get siob j
end
if not epio wr 0 add get siolen 0 24 true
ret 78
end
ret 0
end
fn epworker rd int wr int fh ulong to int
put iqcmode 0 1
put iqcstate 0 1
cap = unirqmk
if not unvalid cap
ret 72
end
if eq get epfake 0 1
note Explicit fake-tier backing fixture, installed AFTER fork, never a client import operation.
back = siobject 23 add UVBASE mul fh UVWIN UVWIN
if ne back UVOK
ret 73
end
end
ewset 0 8 1
if not epio wr 0 8 true
ret 74
end
for step ulong 999999
note Idle clients retain their namespace; only partial/in-flight frames have a deadline.
ready = waitio rd 1 neg long 1
if eq ready neg long 4
continue
end
if le ready 0
ret 0
end
code = epworkone rd wr
if ne code 0
r = unclose cap
ret code
end
end
ret 79
end
fn epchild rd int wr int fh ulong to int
note No sibling channel or kernel connection survives in the child.
for j ulong 8
if ne get epclnt mul j 5 0
r = fclose int get epclnt add mul j 5 2
end
end
r = fclose get epdevice 0
if eq get epfake 0 1
r = fclose 1
end
r = fclose epfd 4
ret epworker rd wr fh
end
fn epsockets to long
for j ulong len epaddr
put epaddr j 0
end
put epaddr 0 1
r = random epaddr 3 32 0
if ne r 32
ret -5
end
lfd = socknew 1 524289 0
if lt lfd 0
ret lfd
end
r = bind int lfd epaddr 0 len epaddr
if ne r 0
x = fclose int lfd
ret r
end
r = listen int lfd 1
if ne r 0
x = fclose int lfd
ret r
end
cfd = socknew 1 524289 0
if lt cfd 0
x = fclose int lfd
ret cfd
end
r = connect int cfd epaddr 0 len epaddr
if ne r 0
x = fclose int cfd
x = fclose int lfd
ret r
end
pfd = accept int lfd 524288
x = fclose int lfd
if lt pfd 0
x = fclose int cfd
ret pfd
end
r = peercred int pfd epcred 0 len epcred
pid = ulong 0
for j ulong 4
pid = or pid shl ulong get epcred j mul j 8
end
if or ne r 0 ne pid ulong getpid
x = fclose int cfd
x = fclose int pfd
ret -13
end
for j ulong 4
put epfds j uchar and shr ulong cfd mul j 8 255
put epfds add j 4 uchar and shr ulong pfd mul j 8 255
end
ret 0
end
fn epopen to long
slot = ulong 8
for j ulong 8
if eq get epclnt mul j 5 0
slot = j
break
end
end
if eq slot 8
ret -24
end
if eq get epnext 0 18446744073709551615
ret -24
end
r = epsockets
if ne r 0
ret r
end
fh = add get epnext 0 1
put epnext 0 fh
pid = fork
if lt pid 0
for j ulong 2
r = fclose epfd mul j 4
end
ret pid
end
if eq pid 0
code = epchild epfd 0 epfd 0 fh
exit code
end
r = fclose epfd 0
base = mul slot 5
put epclnt base fh
put epclnt add base 1 ulong pid
put epclnt add base 2 ulong epfd 4
put epclnt add base 3 ulong epfd 4
if not epio epfd 4 0 8 false
epdrop slot
ret -5
end
if ne ewget 0 8 1
epdrop slot
ret -5
end
ret long fh
end
fn epbegin err long size ulong to void
for j ulong add size 16
put epout j 0
end
epset 0 4 add size 16
encoded = ulong 0
if lt err 0
encoded = sub ulong 4294967296 ulong neg err
else
encoded = ulong err
end
epset 4 4 encoded
epset 8 8 get epunique 0
put eplen 0 add size 16
end
fn epinit size ulong to void
if ne size 56
epbegin -22 0
ret
end
if ne get epready 0 0
epbegin -16 0
ret
end
if or ne epget 40 4 7 lt epget 44 4 16
epbegin -71 0
ret
end
if or ne epget 48 4 0 ne epget 52 4 1
epbegin -71 0
ret
end
put epready 0 1
epbegin 0 add ulong 73 len epname
epset 16 4 7
minor = epget 44 4
if gt minor 39
minor = 39
end
epset 20 4 minor
epset 28 4 1
epset 32 4 9264
epset 36 4 9264
for j ulong len epname
put epout add j 88 get epname j
end
end
fn epcall i ulong cmd ulong size ulong to bool
seq = get epunique 0
ewset 0 8 cmd
ewset 8 8 size
ewset 16 8 seq
for j ulong size
put epwire add j 24 get epin add j 72
end
wr = int get epclnt add mul i 5 2
rd = int get epclnt add mul i 5 3
if not epio wr 0 add size 24 true
ret false
end
if not epio rd 0 24 false
ret false
end
if or ne ewget 16 8 seq ne ewget 8 8 size
ret false
end
if gt ewget 0 8 UVFATAL
ret false
end
ret epio rd 24 size false
end
fn epcopied i ulong cmd ulong size ulong to void
if not epcall i cmd size
epdrop i
epbegin -5 0
ret
end
note rmStatus is semantic output even when local dispatcher status is nonzero.
epbegin 0 add size 16
for j ulong size
put epout add j 32 get epwire add j 24
end
end
fn epioctl size ulong to void
if lt size 72
epbegin -22 0
ret
end
i = epfind epget 40 8
if eq i 8
epbegin -9 0
ret
end
if ne epget 48 4 2
epbegin -22 0
ret
end
cmd = epget 52 4
need = sisize cmd
if eq need 0
epbegin -22 0
ret
end
arg = epget 56 8
note 64-bit user VA interval only. Never dereference arg, kernel performs user-copy.
if or eq arg 0 ge arg ulong 281474976710656
epbegin -14 0
ret
end
if gt need sub ulong 281474976710656 arg
epbegin -14 0
ret
end
if and eq epget 64 4 0 eq epget 68 4 0
if ne size 72
epbegin -22 0
ret
end
epbegin 0 48
epset 20 4 4
epset 24 4 1
epset 28 4 1
epset 32 8 arg
epset 40 8 need
epset 48 8 arg
epset 56 8 need
ret
end
if or ne epget 64 4 need ne epget 68 4 need
epbegin -22 0
ret
end
if ne size add need 72
epbegin -22 0
ret
end
epcopied i cmd need
end
fn eprelease size ulong to void
if ne size 64
epbegin -22 0
ret
end
i = epfind epget 40 8
if eq i 8
epbegin -9 0
ret
end
epdrop i
epbegin 0 0
end
fn epdispatch size ulong to void
put epunique 0 0
if lt size 40
epbegin -22 0
ret
end
put epunique 0 epget 8 8
if or ne epget 0 4 size eq get epunique 0 0
epbegin -22 0
ret
end
if ne epget 36 4 0
epbegin -71 0
ret
end
op = epget 4 4
if eq op 4096
epinit size
ret
end
if eq get epready 0 0
epbegin -71 0
ret
end
if eq op 14
if ne size 48
epbegin -22 0
ret
end
if ne epget 44 4 0
epbegin -22 0
ret
end
fh = epopen
if lt fh 0
epbegin fh 0
ret
end
epbegin 0 16
epset 16 8 ulong fh
epset 24 4 33
ret
end
if eq op 39
epioctl size
ret
end
if eq op 18
eprelease size
ret
end
if eq op 25
if ne size 64
epbegin -22 0
ret
end
if eq epfind epget 40 8 8
epbegin -9 0
ret
end
epbegin 0 0
ret
end
epbegin -38 0
end
fn epargmatch n ulong which ulong to bool
r = argread n epwire 0 64
if lt r 0
ret false
end
if eq which 0
if ne ulong r len epfarg
ret false
end
for j ulong len epfarg
if ne get epwire j get epfarg j
ret false
end
end
else
if ne ulong r len epcarg
ret false
end
for j ulong len epcarg
if ne get epwire j get epcarg j
ret false
end
end
end
ret true
end
fn main to int
if ne argcnt 2
ret 64
end
if epargmatch 1 0
put epfake 0 1
put epdevice 0 0
else
if not epargmatch 1 1
ret 64
end
r = fopen epdev 0 len epdev 524290 0
if lt r 0
ret 69
end
put epdevice 0 int r
end
for step ulong 999999
note Real CUSE and fake SOCK_SEQPACKET both deliver whole records, not header/body stream reads.
r = read get epdevice 0 epin 0 len epin
if eq r neg long 4
continue
end
if le r 0
epcleanup
ret 0
end
epdispatch ulong r
fd = get epdevice 0
if eq get epfake 0 1
fd = 1
r = send fd epout 0 get eplen 0 0
else
r = write fd epout 0 get eplen 0
end
if ne r long get eplen 0
epcleanup
ret 80
end
end
epcleanup
ret 0
end

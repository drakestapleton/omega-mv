fn sidispatch cmd ulong size ulong to ulong
put siolen 0 0
need = sisize cmd
if eq need 0
ret UVEINVAL
end
if ne need size
ret UVEINVAL
end
for j ulong size
put siob j get siab j
end
r = siaction cmd
nv = ulong 0
if ne r UVOK
nv = 31
if eq r UVEPERM
nv = 64
end
if eq r UVEBUSY
nv = 23
end
end
sistore sistoff cmd 4 nv
put siolen 0 size
ret r
end

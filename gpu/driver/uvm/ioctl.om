if eq cmd 37
ret sireg
end
if eq cmd 38
if or eq get sigpu 0 0 not siuidmatch
ret UVENOENT
end
if ne get sn 0 0
ret UVEBUSY
end
put sigpu 0 0
put sivs 0 0
ret UVOK
end
if eq cmd 23
if eq get sigrp 0 18446744073709551615
ret UVENOM

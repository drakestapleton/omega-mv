note uvm_linux_ioctl.h:28-38; uvm_types.h:69-71,84-94. Layout measured by tests/uvms_offsets.c.
note Explicit imported object capability (handle,PA,size), not a reinterpretation of RM handle as PA.
global siab uchar 9264
global siob uchar 9264
global siolen ulong 1
global siinit ulong 1
global sigpu ulong 1
global sivs ulong 1
global siuuid uchar 16
global sicli ulong 1
global sifd ulong 1

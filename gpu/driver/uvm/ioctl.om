ret 36
end
if or eq cmd 38 eq cmd 34
ret 16
end
if eq cmd 33
ret 9260
end
if eq cmd 25
ret 28
end
ret 4
end
fn siuidmatch to bool
for j ulong 16
if ne get siab j get siuuid j
ret false
end
end
ret true
end
fn sireg to ulong
if ne get sigpu 0 0
ret UVEBUSY
end
nz = ulong 0
for j ulong 16
nz = or nz ulong get siab j
end
if or eq nz 0 or eq siload 28 4 0 ge siload 24 4 2147483648
ret UVEINVAL
end
for j ulong 16
put siuuid j get siab j
end
put sicli 0 siload 28 4
put sifd 0 siload 24 4
put sigpu 0 1
sistore 16 4 0
sistore 20 4 4294967295
ret UVOK
end
fn simap to ulong
if or eq get sigpu 0 0 eq get sivs 0 0
ret UVEPERM
end
if ne siload 9240 8 1
ret UVEINVAL
end
for j ulong 16
if ne get siab add j 24 get siuuid j
ret UVEINVAL
end
end
note Model supports default mapping/cache/format only, refuses all unimplemented attributes.
for j ulong 20
if ne get siab add j 40 0
ret UVEINVAL
end
end
if or ne siload 9248 4 get sifd 0 ne siload 9252 4 get sicli 0
ret UVEPERM
end
handle = siload 9256 4
for j ulong 8
if and ne handle 0 eq get siobj mul j 3 handle
off = siload 16 8
size = siload 8 8
cap = get siobj add mul j 3 2
if gt off cap
ret UVERANGE
end
if gt size sub cap off
ret UVERANGE
end
ret sadd siload 0 8 size add get siobj add mul j 3 1 off 5
end
end
ret UVENOENT
end
fn siaction cmd ulong to ulong
if eq cmd 805306369
if ne get siinit 0 0
ret UVEBUSY
end
if gt siload 0 8 1
ret UVEINVAL
end
r = screate
if ne r UVOK
ret r
end
put siinit 0 1
ret UVOK

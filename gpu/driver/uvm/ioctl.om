fn siload off ulong n ulong to ulong
v = ulong 0
for j ulong n
v = or v shl ulong get siab add off j mul j 8
end
ret v
end
fn sistore off ulong n ulong v ulong to void
for j ulong n
put siob add off j uchar and shr v mul j 8 255
end
end
fn siobject handle ulong pa ulong size ulong to ulong
if or eq handle 0 eq pa 0
ret UVEINVAL
end
if or ne rem pa UV4K 0 ne rem size UV4K 0
ret UVEALIGN
end
if or eq size 0 or ge pa UVPA52 gt size sub UVPA52 pa
ret UVERANGE
end
if uvpoolhit pa size
ret UVERANGE
end
for j ulong 8
if eq get siobj mul j 3 handle
ret UVEBUSY
end
end
for j ulong 8
if eq get siobj mul j 3 0
put siobj mul j 3 handle
put siobj add mul j 3 1 pa
put siobj add mul j 3 2 size
ret UVOK
end
end
ret UVENOM
end
fn sisize cmd ulong to ulong
if eq cmd 805306369
ret 16
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note GB10-specific model: identical CPU/GPU physical backing; zero copied bytes.
note Residency mask describes mappings, NOT proof of device coherence. GPU transition emits fence-required flags.
note Per-page ledger: VA, mapping mask(1 CPU/2 GPU), last access counter. 128 slots.
global spage ulong 384
global scva ulong 1
global scval ulong 1
global sctyp ulong 1
global sctag ulong 1
fn spfind va ulong to ulong
for j ulong 128
if eq get spage mul j 3 va
ret j
end
end
ret 128
end
fn spfree to ulong
for j ulong 128
if eq get spage mul j 3 0
ret j
end
end
ret 128
end
fn sforget va ulong size ulong to void
for j ulong 128
v = get spage mul j 3
if and ge v va lt v add va size
for f ulong 3
put spage add mul j 3 f 0
end
end
end
end
fn smask i ulong acc ulong to ulong
if or eq acc 1 eq acc 2
ret 2
end
if eq sget i 5 1
ret 3
end
if eq sget i 3 0
ret 3
end
ret or ulong 2 and sget i 4 1
end
fn scdecode to ulong
note NVIDIA580.173.02 class/clc365.h:36-41,59-79; 32B, GVA words2/3,
note counter word6[15:0], tag word5[19:0], valid word7[31], type word0[0].
if eq and shr uvpktlw 7 31 1 0
ret UVIGN
end
if ne and shr uvpktlw 0 1 1 0
ret UVEINVAL
end
if ne and shr uvpktlw 0 8 3 2
ret UVEINVAL
end
put scva 0 and or uvpktlw 2 shl uvpktlw 3 32 not sub UV4K 1
put scval 0 and uvpktlw 6 65535
put sctyp 0 and uvpktlw 0 1
put sctag 0 and uvpktlw 5 1048575
ret UVOK
end
fn scnotify limit ulong to ulong
if or eq limit 0 gt limit 65535
ret UVEINVAL
end
r = scdecode
if ne r UVOK
ret r
end
i = sfind get scva 0
if eq i 64
ret UVENOENT
end
j = spfind get scva 0
if eq j 128
ret UVENOENT
end
put spage add mul j 3 2 get scval 0
if lt get scval 0 limit
ret UVIGN
end
note Threshold proposes remapping through the same fault pipeline, never data copy.
put uvfva 0 get scva 0
put uvfacc 0 0
put uvftyp 0 1
put uvfrep 0 1
put uvfen 0 1
put uvfval 0 1
note CPU notifications request CPU-accessed mapping via range preference; GPU keeps preferred policy.
if eq get sctyp 0 0
if eq sget i 3 1
ret UVIGN
end
end
ret sservice
end

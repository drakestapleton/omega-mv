note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note uvm/fmt.om: Blackwell VER3 page-table words and the page pool.
note Library unit, no main. Prefix uv / UV. Concatenate uvm/fmt.om uvm/pt.om uvm/fault.om
note then tests/uvm_trace.om. Do not concatenate with chan/: that port owns mm / MM.
note
note Field positions are the open-gpu-kernel-modules 580.173.02 VER3 layout
note (dev_mmu.h NV_MMU_VER3_*, dev_fault.h NV_PFAULT_FAULT_TYPE_*, clc369.h
note NVC369_BUF_ENTRY_*). aienux feat/gb10-gpu-mmu-sim was read as a behavior
note reference only; this is a new Omega unit, not a transcription.
note
note Levels (lo, hi), index 5 is PT_BIG and index 6 is PT_SMALL, both off PD0:
note 0 (56,56) 1 (47,55) 2 (38,46) 3 (29,37) 4 PD0 (21,28) 5 (16,20) 6 (12,20)
note PDE address 51:12, aperture 2:1, PCF 5:3. Dual PDE big address 51:8 in word 0,
note small address 51:12 in word 1. PTE valid 0:0, aperture 2:1, PCF 7:3, address 51:12.
note Pool is 16 pages of 4096 bytes. A page physical address is UVPOOL plus its offset.
note WolframLanguageEvaluator: 2^31 -> 2147483648, 16*4096 -> 65536,
note BitAnd[2^52-1, BitNot[2^12-1]] -> 4503599627366400,
note BitAnd[2^52-1, BitNot[2^8-1]] -> 4503599627370240,
note 2^32 -> 4294967296, 2^28 -> 268435456, 2^57 -> 144115188075855872,
note 2^52 -> 4503599627370496, 2^28/2^12 -> 65536.
const UVPOOL ulong 2147483648
const UVBYTES ulong 65536
const UVBASE ulong 4294967296
const UVWIN ulong 268435456
const UVVA57 ulong 144115188075855872
const UVPA52 ulong 4503599627370496
const UV4K ulong 4096
const UV64K ulong 65536
const UV2M ulong 2097152
const UVPDMSK ulong 4503599627366400
const UVBIGMSK ulong 4503599627370240
const UVPDEPCF ulong 2
const UVAPSYS ulong 2
const UVOK ulong 0
const UVEINVAL ulong 1
const UVEALIGN ulong 2
const UVEBUSY ulong 3
const UVENOM ulong 4
const UVENOENT ulong 5
const UVERANGE ulong 6
const UVEPERM ulong 7
const UVIGN ulong 8
const UVREPLAY ulong 9
const UVCANCEL ulong 10
const UVFATAL ulong 11
const UVCONT ulong 20
const UVFREE ulong 21
const UVMAPPED ulong 22
const UVCONF ulong 23
const UVMISS ulong 24
global uvmem uchar 65536
global uvused uchar 16
global uvout ulong 1
global uvtbl ulong 1
global uvleaf ulong 1
global uvmiss ulong 1
global uvw0 ulong 1
global uvw1 ulong 1
global uvkey ulong 8
global uvrva ulong 32
global uvrsz ulong 32
global uvrpg ulong 32
global uvrpa ulong 32
global uvrro ulong 32
global uvrn ulong 1
global uvdpa ulong 1
global uvdap ulong 1
global uvdpcf ulong 1
global uvdv ulong 1
fn uvld64 off ulong to ulong
acc = ulong 0
for i ulong 8
acc = or acc shl ulong get uvmem add off i mul i 8
end
ret acc
end
fn uvst64 off ulong v ulong to void
for i ulong 8
put uvmem add off i uchar and shr v mul i 8 255
end
end
fn uvlvlo lv ulong to ulong
if eq lv 0
ret 56
end
if eq lv 1
ret 47
end
if eq lv 2
ret 38
end
if eq lv 3
ret 29
end
if eq lv 4
ret 21
end
if eq lv 5
ret 16
end
ret 12
end
fn uvlvhi lv ulong to ulong
if eq lv 0
ret 56
end
if eq lv 1
ret 55
end
if eq lv 2
ret 46
end
if eq lv 3
ret 37
end
if eq lv 4
ret 28
end
ret 20
end
fn uvlvidx lv ulong va ulong to ulong
lo = uvlvlo lv
hi = uvlvhi lv
bits = add sub hi lo 1
ret and shr va lo sub shl ulong 1 bits 1
end
fn uvpde pa ulong ap ulong to ulong
ret or or and pa UVPDMSK shl UVPDEPCF 3 shl and ap 3 1
end
fn uvpte pa ulong ap ulong pcf ulong to ulong
v = or ulong 1 shl and ap 3 1
v = or v shl and pcf 31 3
ret or v and pa UVPDMSK
end
fn uvbadpa pa ulong to bool
if lt pa UVPOOL
ret true
end
if ge pa add UVPOOL UVBYTES
ret true
end
if ne and pa 4095 0
ret true
end
ret false
end
fn uvptnew to ulong
for i ulong 16
if eq get uvused i 0
put uvused i 1
base = mul i 4096
for j ulong 512
uvst64 add base mul j 8 0
end
put uvout 0 base
ret UVOK
end
end
ret UVENOM
end
fn uvnfree to ulong
n = ulong 0
for i ulong 16
if eq get uvused i 0
n = add n 1
end
end
ret n
end
fn uvsum to ulong
s = ulong 0
for i ulong 65536
s = add s ulong get uvmem i
end
ret s
end

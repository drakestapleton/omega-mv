note NVIDIA580.173.02 nvos.h, nv-ioctl.h, nv_escape.h; measured by rme_offsets.c.
note No globals: caller owns the byte image and the 64-slot object namespace.
fn rmget b view uchar 16384 off ulong n ulong to ulong
v = ulong 0
for j ulong n
v = or v shl ulong get b add off j mul j 8
end
ret v
end
fn rmput b edit uchar 16384 off ulong n ulong v ulong to void
for j ulong n
put b add off j uchar and shr v mul j 8 255
end
end
fn rmsize nr ulong to ulong
if or eq nr 43 eq nr 42
ret 32
end
if or eq nr 41 or eq nr 206 eq nr 207
ret 16
end
if eq nr 78
ret 56
end
if eq nr 79
ret 32
end
if eq nr 87
ret 64
end
if eq nr 88
ret 48
end
if eq nr 201
ret 4
end
if eq nr 200
ret 4608
end
if eq nr 210
ret 72
end
if eq nr 74
ret 184
end
ret 0
end
fn rmdecode cmd ulong to ulong
nr = and cmd 255
n = rmsize nr
if eq n 0
ret 0
end
if ne cmd or or ulong 3221225472 shl n 16 or ulong 17920 nr
ret 0
end
ret n
end
fn rmstoff nr ulong to ulong
if or eq nr 43 eq nr 42
ret 28
end
if or eq nr 41 or eq nr 206 eq nr 207
ret 12
end
if eq nr 78
ret 40
end
if eq nr 79
ret 24
end
if eq nr 87
ret 56
end
if eq nr 88
ret 40
end
if eq nr 74
ret 20
end
ret 0
end
note Local categories: invalid argument, stale object, wrong parent, duplicate, capacity, unsupported.
fn rmstatus code ulong to ulong
if eq code 0
ret 0
end
if eq code 1
ret 31
end
if eq code 2
ret 51
end
if eq code 3
ret 54
end
if eq code 4
ret 52
end
if eq code 5
ret 81
end
ret 86
end
fn rmptr addr ulong n ulong to bool
if or eq addr 0 ge addr ulong 281474976710656
ret false
end
ret le n sub ulong 281474976710656 addr
end

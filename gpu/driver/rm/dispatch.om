note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Explicit replay/model only. Existing params/rpc units own record and frame codecs.
fn rmpsize cls ulong to long
if eq cls 65
ret 0
end
if eq cls 128
ret long PASZDEV
end
if eq cls 8320
ret long PASZSUB
end
if eq cls 37105
ret long PASZVAS
end
if eq cls 41068
ret long PASZTSG
end
if eq cls 36967
ret long PASZCTX
end
if eq cls 51567
ret long PASZCHAN
end
if eq cls 52928
ret 0
end
ret -1
end
fn rmcsize cmd ulong to long
if eq cmd PACMSCH
ret long PASZSCH
end
note ctrlc36f.h NVC36F_CTRL_CMD_GPFIFO_GET_WORK_SUBMIT_TOKEN.
if eq cmd 3278831880
ret 4
end
ret -1
end
fn rmroute t edit ulong 512 a view ulong 8 f ulong to ulong
note rqpeer links host memory only; never MMIO, DMA, VFIO or firmware.
rqinit
rqpeer
n = get palen 0
head = ulong 32
if eq f 76
head = 40
end
if eq f 10
head = 16
n = 0
end
rqclear add head n
rqput32 4 0 get a 0
if eq f 103
rqput32 4 4 get a 1
rqput32 4 8 get a 2
rqput32 4 12 get a 3
rqput32 4 20 n
else
rqput32 4 4 get a 1
rqput32 4 8 get a 2
if eq f 76
rqput32 4 16 n
end
end
if eq f 10
rqput32 4 4 0
end
for j ulong n
put rqpay add head j get pabuf j
end
logical = add head n
if eq f 103
logical = 32
end
r = rqsend f logical add head n true
if ne r 0
ret 6
end
put t 411 f
put t 412 add get t 412 1
note This result belongs to the explicit host model, not a fabricated GSP reply.
ret get t 410
end
fn rmref t view ulong 512 cli ulong obj ulong cls ulong par ulong to bool
i = rmfind t cli obj
if eq i 64
ret false
end
if ne get t add mul i 5 4 cls
ret false
end
ret eq get t add mul i 5 3 par
end
fn rmarefs t view ulong 512 b view uchar 16384 cls ulong cli ulong to bool
if eq cls 36967
p = rmfind t cli rmget b 76 4
if eq p 64
ret false
end
ret rmref t cli rmget b 104 4 37105 get t add mul p 5 3
end
if eq cls 51567
if or ne rmget b 104 4 0 ne rmget b 108 4 0
ret false
end
if ne rmget b 136 4 0
ret false
end
ret rmref t cli rmget b 128 4 36967 rmget b 76 4
end
ret true
end
fn rmpay b view uchar 16384 n ulong to void
paclr n
for j ulong n
put pabuf j get b add 104 j
end
end
fn rmacode b view uchar 16384 a view ulong 8 to void
if eq get a 3 65
r = paroot get a 0 0
else
rmpay b ulong rmpsize get a 3
end
end
fn rmallocx t edit ulong 512 b edit uchar 16384 a edit ulong 8 to ulong
n = rmpsize get a 3
if lt n 0
ret 6
end
if ne rmget b 96 4 ulong n
ret 1
end
if not rmarefs t b get a 3 get a 0
ret 3
end
r = rmaokay t a
if ne r 0
ret r
end
if eq get a 3 65
put a 0 add get t 400 1
put a 2 get a 0
end
rmacode b a
r = rmroute t a 103
if ne r 0
ret r
end
if eq get a 3 65
put t 400 get a 0
put a 1 get a 0
end
r = rminsert t get a 0 get a 1 get a 2 get a 3
rmput b 80 4 get a 2
ret 0
end
fn rmfreex t edit ulong 512 a edit ulong 8 to ulong
slot = rmfslot t get a 0 get a 1 get a 2
if lt slot 64
ret slot
end
r = rmroute t a 10
if ne r 0
ret r
end
rmkill t get a 0 sub slot 64
ret 0
end
fn rmctrlx t edit ulong 512 b edit uchar 16384 a view ulong 8 to ulong
idx = rmfind t get a 0 get a 1
if eq idx 64
ret 2
end
n = rmcsize get a 2
if lt n 0
ret 6
end
if or ne rmget b 96 4 ulong n ne get a 3 0
ret 1
end
cls = get t add mul idx 5 4
if eq get a 2 PACMSCH
if ne cls 41068
ret 3
end
end
if eq get a 2 3278831880
if ne cls 51567
ret 3
end
end
rmpay b ulong n
if eq get a 2 PACMSCH
r = pasched rmget b 104 1 rmget b 105 1 rmget b 106 1
if lt r 0
ret 1
end
end
r = rmroute t a 76
if ne r 0
ret r
end
if eq get a 2 3278831880
rmput b 104 4 get a 1
end
ret 0
end
fn rmaction t edit ulong 512 b edit uchar 16384 nr ulong to ulong
a = new ulong 8 0
for j ulong 4
put a j rmget b add 72 mul j 4 4
end
if eq nr 43
ret rmallocx t b a
end
if eq nr 41
ret rmfreex t a
end
if eq nr 42
ret rmctrlx t b a
end
note No fabricated backing, GPU inventory, event registrations or fd import authority.
ret 6
end
fn rmdispat t edit ulong 512 b edit uchar 16384 nr ulong to long
if or eq nr 201 or eq nr 200 eq nr 210
ret -95
end
r = rmaction t b nr
rmput b add 72 rmstoff nr 4 rmstatus r
ret 0
end

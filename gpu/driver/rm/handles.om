note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note 64 monotonically consumed slots per open. Tombstones refuse handle reuse until close.
note Fields live, handle, client, parent, class. Metadata 400 next-root, 401 used.
fn rmfind t view ulong 4096 cli ulong obj ulong to ulong
for j ulong 64
k = mul j 5
if eq get t k 1
if eq get t add k 1 obj
if eq get t add k 2 cli
ret j
end
end
end
end
ret 64
end
fn rmseen t view ulong 4096 cli ulong obj ulong to bool
for j ulong get t 401
k = mul j 5
if and eq get t add k 1 obj eq get t add k 2 cli
ret true
end
end
ret false
end
fn rmparent cls ulong parcls ulong to bool
if or eq cls 62 or eq cls 64 eq cls 112
ret eq parcls 128
end
if or eq cls 50017 eq cls 50785
ret eq parcls 8320
end
if eq cls 128
ret eq parcls 65
end
if or eq cls 8320 or eq cls 37105 eq cls 41068
ret eq parcls 128
end
if or eq cls 36967 eq cls 51567
ret eq parcls 41068
end
if eq cls 52928
ret eq parcls 51567
end
ret false
end
fn rminsert t edit ulong 4096 cli ulong par ulong obj ulong cls ulong to ulong
if eq get t 401 64
ret 5
end
k = mul get t 401 5
put t k 1
put t add k 1 obj
put t add k 2 cli
put t add k 3 par
put t add k 4 cls
put t 401 add get t 401 1
ret 0
end
fn rmaokay t view ulong 4096 a view ulong 8 to ulong
cli = get a 0
par = get a 1
obj = get a 2
cls = get a 3
if eq cls 65
if or ne cli 0 or ne par 0 ne obj 0
ret 1
end
if eq get t 400 4294967295
ret 5
end
if eq get t 401 64
ret 5
end
ret 0
end
p = rmfind t cli par
if eq p 64
ret 3
end
if not rmparent cls get t add mul p 5 4
ret 3
end
if eq obj 0
ret 1
end
if rmseen t cli obj
ret 4
end
if eq get t 401 64
ret 5
end
ret 0
end
fn rmchild t view ulong 4096 cli ulong par ulong to bool
for q ulong 64
k = mul q 5
a = eq get t k 2
b = eq get t add k 2 cli
c = eq get t add k 1 par
if and a and b c
ret true
end
end
ret false
end
fn rmfslot t view ulong 4096 cli ulong par ulong obj ulong to ulong
s = rmfind t cli obj
if eq s 64
ret 2
end
if ne get t add mul s 5 3 par
ret 3
end
ret add s 64
end
fn rmkill t edit ulong 4096 cli ulong s ulong to void
note Parent slots precede children because insertion is monotonic and handles never recycle.
put t mul s 5 2
for j ulong 64
k = mul j 5
if and eq get t k 1 eq get t add k 2 cli
if rmchild t cli get t add k 3
put t k 2
end
end
end
for j ulong 64
if eq get t mul j 5 2
put t mul j 5 0
end
end
end
fn rmref t view ulong 4096 cli ulong obj ulong cls ulong par ulong to bool
s = rmfind t cli obj
if eq s 64
ret false
end
a = eq get t add mul s 5 4 cls
b = eq get t add mul s 5 3 par
ret and a b
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note The fake kernel translates OS fds to endpoint-issued capabilities. The endpoint
note never trusts a process fd number, PID or a caller-supplied handle as import authority.
fn rmtoken c edit ulong 4096 to long
b = new uchar 4 0
if eq get c 400 1000
ret -24
end
for attempt ulong 64
r = random b 0 4 0
if ne r 4
ret -5
end
tok = and or or ulong get b 0 shl ulong get b 1 8 or shl ulong get b 2 16 shl ulong get b 3 24 2147483647
if eq tok 0
continue
end
seen = false
for j ulong get c 400
if eq get c add 512 j tok
seen = true
end
end
if not seen
put c add 512 get c 400 tok
put c 400 add get c 400 1
ret long tok
end
end
ret -5
end
fn rmimport c edit ulong 4096 dst ulong src ulong to long
if eq dst src
ret -22
end
if or ne get c add 100 dst 0 ne get c add 200 dst 0
ret -16
end
if eq get c add 100 src 0
ret -9
end
rmalias c dst src
ret 0
end
fn rmalias c edit ulong 4096 dst ulong src ulong to void
rmdrop c dst
put c mul dst 3 get c 450
put c add mul dst 3 1 get c add mul src 3 1
put c add mul dst 3 2 get c add mul src 3 2
put c add 100 dst 1
ret
end
fn rmpre b view uchar 16384 n ulong to long
if lt n 72
ret neg long 22
end
if or ne rmget b 48 4 2 ne n add ulong 72 rmget b 64 4
ret neg long 22
end
h = rmdecode rmget b 52 4
if eq h 0
h = rmusize rmget b 52 4
end
if eq h 0
ret neg long 22
end
if not rmptr rmget b 56 8 h
ret neg long 14
end
ret 0
end
fn rmauth c edit ulong 4096 b edit uchar 16384 o edit uchar 16384 idx ulong n ulong to ulong
r = rmpre b n
if ne r 0
ret rmbegin b o r 0
end
if ge n 72
if ne rmusize rmget b 52 4 0
ret rmuparent c b o idx n
end
if eq rmget b 52 4 ulong 3221505737
note REGISTER_FD exact ioctl; header retry is handled by worker.
if and eq n 76 and eq rmget b 64 4 4 eq rmget b 68 4 4
src = rmclient c rmget b 72 4
if eq src 8
ret rmbegin b o -9 0
end
put c 450 get c mul idx 3
r = rmimport c idx src
if ne r 0
ret rmbegin b o r 0
end
ret rmresult b o 4
end
else
if gt rmget b 64 4 0
put c add 100 idx 1
end
end
end
if and eq n 128 eq rmget b 52 4 ulong 3224913486
note MAP_MEMORY's fd field is also a capability, never a guessed numeric fd.
other = rmclient c rmget b 120 4
if eq other 8
ret rmbegin b o -9 0
end
pid = get c add mul idx 3 1
if ne get c add mul other 3 1 pid
busy = ne get c add 100 other 0
owner = get c add 200 other
if or busy and ne owner 0 ne owner pid
ret rmbegin b o -1 0
end
put c add 200 other pid
end
end
ret rmforward c b o idx n
end
fn rmnested b view uchar 16384 nr ulong to ulong
if ne nr 42
ret 0
end
cmd = rmget b 80 4
n = rmget b 104 4
if eq cmd 545264129
if ne n 1
ret 8193
end
ret 8
end
if eq cmd 8389121
if gt n 512
ret 8193
end
ret mul n 4
end
ret 0
end
fn rmretry3 b view uchar 16384 o edit uchar 16384 h ulong p ulong q ulong to ulong
size = rmbegin b o 0 112
rmput o 20 4 4
rmput o 24 4 3
rmput o 28 4 3
for j ulong 2
off = add 32 mul j 48
rmput o off 8 rmget b 56 8
rmput o add off 8 8 h
rmput o add off 16 8 rmget b 88 8
rmput o add off 24 8 p
rmput o add off 32 8 rmget b 112 8
rmput o add off 40 8 q
end
ret size
end
fn rmuparent c edit ulong 4096 b edit uchar 16384 o edit uchar 16384 idx ulong n ulong to ulong
cmd = rmget b 52 4
if and eq cmd 33 eq n 9336
src = rmclient c rmget b 9320 4
if eq src 8
ret rmbegin b o -9 0
end
pid = get c add mul idx 3 1
if ne get c add mul src 3 1 pid
ret rmbegin b o -1 0
end
end
if and eq cmd 25 eq n 104
ready = ne get c add 300 idx 0
ready = and ready ne get c add 320 idx 0
if not ready
ret rmbegin b o -1 0
end
src = rmclient c rmget b 88 4
if or eq src 8 eq src idx
ret rmbegin b o -9 0
end
size = rmforward c b o src n
if and eq rmget o 4 4 0 eq rmget o 60 4 0
put c 450 get c mul idx 3
rmalias c idx src
end
ret size
end
size = rmforward c b o idx n
if and gt n 72 and eq rmget o 4 4 0 eq rmget o add 32 rmuoff cmd 4 0
if eq cmd 805306369
put c add 300 idx 1
end
if eq cmd 37
put c add 320 idx 1
end
end
ret size
end

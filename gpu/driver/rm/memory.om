note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note HOST_MODEL only. No physical addresses or real page backing. UVM range.om uses
note global per-service ranges; this per-open model uses its same bounded half-open interval rule.
note 64 object records at512 stride4: bytes, first page, page count, refs(handle plus maps).
note 1024 page owners at1024; 64 maps at2048 stride8: live,slot,kind,VA,length,offset,space,client.
fn rmmemcls cls ulong to bool
ret or eq cls 62 or eq cls 64 or eq cls 50017 eq cls 50785
end
fn rmmalloc t edit ulong 4096 b view uchar 16384 a view ulong 8 to ulong
cls = get a 3
if not rmmemcls cls
ret 0
end
n = ulong 65536
if or eq cls 62 eq cls 64
n = rmget b 168 8
if ne rmget b 104 4 get a 0
ret 3
end
end
if or eq n 0 or gt n 4194304 ne rem n 4096 0
ret 1
end
count = div n 4096
run = ulong 0
start = ulong 0
for j ulong 1024
if eq get t add 1024 j 0
if eq run 0
start = j
end
run = add run 1
if eq run count
break
end
else
run = 0
end
end
if ne run count
ret 5
end
slot = get t 401
for j ulong count
put t add add 1024 start j add slot 1
end
k = add 512 mul slot 4
put t k n
put t add k 1 start
put t add k 2 count
put t add k 3 1
ret 0
end
fn rmmuvgc t edit ulong 4096 to void
vasdead = false
if ne get t 422 0
slot = sub get t 422 1
vasdead = eq get t mul slot 5 0
end
if vasdead
put t 422 0
end
for j ulong 64
k = add 2600 mul j 4
dead = vasdead
if eq get t k 2
slot = sub get t add k 3 1
dead = or dead eq get t mul slot 5 0
end
if dead
for f ulong 4
put t add k f 0
end
end
end
end
fn rmmreap t edit ulong 4096 to void
for j ulong 64
k = add 2048 mul j 8
if eq get t k 1
slot = get t add k 1
space = get t add k 6
dead = eq get t mul slot 5 0
is_dma = eq get t add k 2 2
vasdead = eq get t mul space 5 0
if or dead and is_dma vasdead
put t k 0
r = add 515 mul slot 4
put t r sub get t r 1
end
end
end
for j ulong 64
k = add 512 mul j 4
if and eq get t mul j 5 0 ne get t k 0
for p ulong get t add k 2
put t add add 1024 get t add k 1 p 0
end
for f ulong 4
put t add k f 0
end
end
end
rmmuvgc t
end
fn rmmrange va ulong n ulong to bool
if or eq n 0 or ne rem va 4096 0 ne rem n 4096 0
ret false
end
if ge va 281474976710656
ret false
end
ret le n sub ulong 281474976710656 va
end
fn rmmover t view ulong 4096 k ulong va ulong n ulong to bool
lo = get t add k 3
hi = add lo get t add k 4
ret and lt va hi lt lo add va n
end
fn rmmadd t edit ulong 4096 a view ulong 8 slot ulong kind ulong space ulong to ulong
note a: client, offset, length, address. Validate before any mutation.
size = get t add 512 mul slot 4
if or gt get a 1 size gt get a 2 sub size get a 1
ret 1
end
if not rmmrange get a 1 get a 2
ret 1
end
va = get a 3
if not rmmrange va get a 2
ret 1
end
freeidx = ulong 64
for j ulong 64
k = add 2048 mul j 8
if eq get t k 0
freeidx = j
else
same = eq get t add k 2 kind
same = and same eq get t add k 7 get a 0
same = and same eq get t add k 6 space
if same
if rmmover t k va get a 2
ret 4
end
end
end
end
if eq freeidx 64
ret 5
end
k = add 2048 mul freeidx 8
put t k 1
put t add k 1 slot
put t add k 2 kind
put t add k 3 va
put t add k 4 get a 2
put t add k 5 get a 1
put t add k 6 space
put t add k 7 get a 0
k = add 515 mul slot 4
put t k add get t k 1
ret 0
end
fn rmmremove t edit ulong 4096 a view ulong 8 slot ulong kind ulong space ulong to ulong
for j ulong 64
k = add 2048 mul j 8
same = eq get t k 1
same = and same eq get t add k 1 slot
same = and same eq get t add k 2 kind
if same
same = eq get t add k 6 space
same = and same eq get t add k 7 get a 0
same = and same eq get t add k 3 get a 3
if same
if and ne get a 2 0 ne get a 2 get t add k 4
ret 1
end
put t k 0
k = add 515 mul slot 4
put t k sub get t k 1
ret 0
end
end
end
ret 2
end
fn rmmapping t edit ulong 4096 b edit uchar 16384 nr ulong to ulong
cli = rmget b 72 4
dev = rmget b 76 4
obj = rmget b 80 4
if or eq nr 87 eq nr 88
obj = rmget b 84 4
end
slot = rmfind t cli obj
if eq slot 64
ret 2
end
if not rmref t cli dev 128 cli
ret 3
end
if eq get t add 512 mul slot 4 0
ret 3
end
par = get t add mul slot 5 3
if ne par dev
if not rmref t cli par 8320 dev
ret 3
end
end
a = new ulong 8 0
put a 0 cli
kind = ulong 1
space = ulong 0
if or eq nr 87 eq nr 88
kind = 2
space = rmfind t cli rmget b 80 4
if eq space 64
ret 2
end
if not rmref t cli rmget b 80 4 112 dev
ret 3
end
end
if or eq nr 78 eq nr 87
put a 1 rmget b 88 8
put a 2 rmget b 96 8
if eq nr 87
put a 3 rmget b 120 8
else
put a 3 add ulong 4096 mul slot 4194304
end
r = rmmadd t a slot kind space
if and eq r 0 eq nr 78
rmput b 104 8 get a 3
end
ret r
end
if eq nr 88
put a 2 rmget b 104 8
put a 3 rmget b 96 8
else
put a 3 rmget b 88 8
end
ret rmmremove t a slot kind space
end
fn rmmheap t view ulong 4096 b edit uchar 16384 to ulong
if not rmref t rmget b 72 4 rmget b 76 4 128 rmget b 72 4
ret 3
end
if ne rmget b 80 4 5
ret 6
end
used = ulong 0
for j ulong 1024
if ne get t add 1024 j 0
used = add used 4096
end
end
rmput b 96 8 4194304
rmput b 104 8 sub ulong 4194304 used
rmput b 128 8 sub ulong 4194304 used
ret 0
end

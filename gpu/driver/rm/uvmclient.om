note HOST_MODEL client UVM adapter. Reuses bounded half-open ranges from uvm/range.om;
note no PTE publication or real backing. RM capabilities, not handles-as-physical-addresses.
fn rmusize cmd ulong to ulong
if eq cmd 805306369
ret 16
end
if eq cmd 37
ret 40
end
if eq cmd 25
ret 32
end
if eq cmd 73
ret 24
end
if eq cmd 33
ret 9264
end
if eq cmd 34
ret 24
end
if eq cmd 26
ret 20
end
if eq cmd 38
ret 20
end
ret 0
end
fn rmuoff cmd ulong to ulong
if eq cmd 805306369
ret 8
end
if eq cmd 37
ret 36
end
if eq cmd 25
ret 28
end
if eq cmd 33
ret 9260
end
ret 16
end
fn rmuuid t view ulong 4096 b view uchar 16384 off ulong to bool
for j ulong 16
if ne get b add off j rmfx t add 136 j
ret false
end
end
ret true
end
fn rmucreate t edit ulong 4096 b view uchar 16384 to ulong
va = rmget b 72 8
n = rmget b 80 8
if not rmmrange va n
ret 31
end
empty = ulong 64
for j ulong 64
k = add 2600 mul j 4
if eq get t k 0
empty = j
else
lo = get t add k 1
hi = add lo get t add k 2
if and lt va hi lt lo add va n
ret 52
end
end
end
if eq empty 64
ret 81
end
k = add 2600 mul empty 4
put t k 1
put t add k 1 va
put t add k 2 n
ret 0
end
fn rmumap t edit ulong 4096 b view uchar 16384 to ulong
va = rmget b 72 8
n = rmget b 80 8
if or ne rmget b 88 8 0 ne rmget b 9312 8 1
ret 31
end
if not rmuuid t b 96
ret 31
end
cli = rmget b 9324 4
slot = rmfind t cli rmget b 9328 4
if eq slot 64
ret 51
end
if gt n get t add 512 mul slot 4
ret 31
end
found = false
for j ulong 64
k = add 2048 mul j 8
same = eq get t k 1
same = and same eq get t add k 1 slot
same = and same eq get t add k 2 2
if same
same = eq get t add k 3 va
same = and same eq get t add k 4 n
if same
found = true
end
end
end
if not found
ret 54
end
for j ulong 64
k = add 2600 mul j 4
same = eq get t k 1
same = and same eq get t add k 1 va
same = and same eq get t add k 2 n
if same
put t k 2
put t add k 3 add slot 1
ret 0
end
end
ret 51
end
fn rmufree t edit ulong 4096 b view uchar 16384 to ulong
for j ulong 64
k = add 2600 mul j 4
same = ne get t k 0
same = and same eq get t add k 1 rmget b 72 8
same = and same eq get t add k 2 rmget b 80 8
if same
put t k 0
ret 0
end
end
ret 51
end
fn rmuvact t edit ulong 4096 b edit uchar 16384 cmd ulong to ulong
if eq cmd 805306369
if or ne get t 420 0 ne rmget b 72 8 0
ret 31
end
put t 420 1
ret 0
end
if eq cmd 25
if not rmuuid t b 72
ret 31
end
cli = rmget b 92 4
slot = rmfind t cli rmget b 96 4
if eq slot 64
ret 51
end
if ne get t add mul slot 5 4 37105
ret 54
end
put t 420 1
put t 421 1
put t 422 add slot 1
ret 0
end
if eq get t 420 0
ret 54
end
if eq cmd 37
if or ne get t 421 0 not rmuuid t b 72
ret 31
end
if ne rmget b 96 4 4294967295
ret 31
end
put t 421 1
rmput b 88 4 0
rmput b 92 4 4294967295
ret 0
end
if eq cmd 38
if not rmuuid t b 72
ret 31
end
if or eq get t 421 0 ne get t 422 0
ret 54
end
put t 421 0
ret 0
end
if eq cmd 26
if not rmuuid t b 72
ret 31
end
if eq get t 422 0
ret 51
end
for j ulong 64
if ne get t add 2600 mul j 4 0
ret 52
end
end
put t 422 0
ret 0
end
if eq get t 422 0
ret 54
end
if eq cmd 73
ret rmucreate t b
end
if eq cmd 33
ret rmumap t b
end
if eq cmd 34
ret rmufree t b
end
ret 86
end
fn rmuvcall t edit ulong 4096 b edit uchar 16384 cmd ulong to void
r = rmuvact t b cmd
rmput b add 72 rmuoff cmd 4 r
end

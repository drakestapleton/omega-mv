note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Linux fuse.h CUSE ABI; same per-open process boundary as uvm/endpoint.om.
note Private worker has no kernel/device fd. New units have no globals.
text RMNAME "DEVNAME=omega-rm-test"
text RMDEV "/dev/cuse"
text RMFAKE "--fake"
text RMCUSE "--cuse"
fn rmbegin b view uchar 16384 o edit uchar 16384 err long n ulong to ulong
for j ulong add n 16
put o j 0
end
rmput o 0 4 add n 16
code = ulong 0
if lt err 0
code = sub ulong 4294967296 ulong neg err
end
rmput o 4 4 code
rmput o 8 8 rmget b 8 8
ret add n 16
end
fn rmretry b view uchar 16384 o edit uchar 16384 h ulong p ulong to ulong
n = ulong 1
if gt p 0
n = 2
end
size = rmbegin b o 0 add 16 mul n 32
rmput o 20 4 4
rmput o 24 4 n
rmput o 28 4 n
for j ulong 2
off = add 32 mul j mul n 16
rmput o off 8 rmget b 56 8
rmput o add off 8 8 h
if gt p 0
rmput o add off 16 8 rmget b 88 8
rmput o add off 24 8 p
end
end
ret size
end
fn rmresult b view uchar 16384 o edit uchar 16384 ins ulong to ulong
total = rmbegin b o 0 add 16 ins
for j ulong ins
put o add 32 j get b add 72 j
end
ret total
end
fn rmcall t edit ulong 4096 b edit uchar 16384 o edit uchar 16384 size ulong to ulong
if lt size 72
ret rmbegin b o -22 0
end
if ne rmget b 48 4 2
ret rmbegin b o -22 0
end
h = rmdecode rmget b 52 4
if eq h 0
h = rmusize rmget b 52 4
end
if eq h 0
ret rmbegin b o -22 0
end
if not rmptr rmget b 56 8 h
ret rmbegin b o -14 0
end
ins = rmget b 64 4
outs = rmget b 68 4
if and eq ins 0 eq outs 0
if ne size 72
ret rmbegin b o -22 0
end
ret rmretry b o h 0
end
if or ne size add 72 ins lt ins h
ret rmbegin b o -22 0
end
if ne rmusize rmget b 52 4 0
if or ne ins h ne outs h
ret rmbegin b o -22 0
end
rmuvcall t b rmget b 52 4
ret rmresult b o h
end
nr = and rmget b 52 4 255
p = ulong 0
q = ulong 0
if or eq nr 42 eq nr 43
p = rmget b 96 4
if gt p 4096
ret rmbegin b o -22 0
end
if gt p 0
if not rmptr rmget b 88 8 p
ret rmbegin b o -14 0
end
if and eq ins h eq outs h
ret rmretry b o h p
end
if lt ins add h p
ret rmbegin b o -22 0
end
q = rmnested b nr
if gt q 4096
ret rmbegin b o -22 0
end
if gt q 0
if not rmptr rmget b 112 8 q
ret rmbegin b o -14 0
end
if and eq ins add h p eq outs add h p
ret rmretry3 b o h p q
end
end
else
if ne rmget b 88 8 0
ret rmbegin b o -22 0
end
end
end
h = add add h p q
if or ne ins h ne outs h
ret rmbegin b o -22 0
end
err = rmdispat t b nr
if ne err 0
ret rmbegin b o err 0
end
ret rmresult b o ins
end
fn rmio fd int b edit uchar 16384 n ulong writing bool to bool
pos = ulong 0
deadline = add monons long 5000000000
while lt pos n bound 16384
left = sub deadline monons
if le left 0
ret false
end
ev = int 1
if writing
ev = 4
end
r = waitio fd ev left
if eq r neg long 4
continue
end
if le r 0
ret false
end
if writing
r = send fd b pos sub n pos 0
else
r = recv fd b pos sub n pos 0
end
if eq r neg long 4
continue
end
if le r 0
ret false
end
pos = add pos ulong r
end
ret true
end
fn rmworker fd int t edit ulong 4096 to int
b = new uchar 16384 0
o = new uchar 16384 0
for j ulong 3000
put t j 0
end
for step ulong 999999
r = waitio fd 1 neg long 1
if eq r neg long 4
continue
end
if le r 0
ret 0
end
if not rmio fd b 4 false
ret 0
end
n = rmget b 0 4
if or lt n 72 gt n 16384
ret 75
end
note Second read starts at zero in o, then copied; no unchecked offset argument.
if not rmio fd o sub n 4 false
ret 76
end
for j ulong sub n 4
put b add j 4 get o j
end
n = rmcall t b o n
if not rmio fd o n true
ret 0
end
end
ret 79
end
fn rmsocket c edit ulong 4096 to long
addr = new uchar 35 0
put addr 0 1
r = random addr 3 32 0
if ne r 32
ret -5
end
lfd = socknew 1 524289 0
if lt lfd 0
ret lfd
end
r = bind int lfd addr 0 35
if eq r 0
r = listen int lfd 1
end
if ne r 0
x = fclose int lfd
ret r
end
fd = socknew 1 524289 0
if ge fd 0
r = connect int fd addr 0 35
if eq r 0
pfd = accept int lfd 524288
if ge pfd 0
put c 410 ulong fd
put c 411 ulong pfd
x = fclose int lfd
ret 0
end
r = pfd
end
x = fclose int fd
else
r = fd
end
x = fclose int lfd
ret r
end
fn rmdrop c edit ulong 4096 idx ulong to void
status = new uchar 4 0
k = mul idx 3
pid = int get c add k 1
fd = int get c add k 2
put c add 300 idx 0
put c add 320 idx 0
put c k 0
put c add 100 idx 0
put c add 200 idx 0
for j ulong 8
if ne get c mul j 3 0
if eq get c add mul j 3 1 ulong pid
ret
end
end
end
r = fclose fd
r = killpid pid 15
r = waitpid pid status 0 4 0
end
fn rmopen c edit ulong 4096 to long
idx = ulong 8
for j ulong 8
if eq get c mul j 3 0
idx = j
break
end
end
if eq idx 8
ret -24
end
tok = rmtoken c
if lt tok 0
ret tok
end
r = rmsocket c
if ne r 0
ret r
end
pid = fork
if lt pid 0
r = fclose int get c 410
r = fclose int get c 411
ret pid
end
if eq pid 0
for j ulong 8
if ne get c mul j 3 0
r = fclose int get c add mul j 3 2
end
end
r = fclose int get c 411
r = fclose int get c 402
if eq get c 403 1
r = fclose 1
end
code = rmworker int get c 410 c
exit code
end
r = fclose int get c 410
put c mul idx 3 ulong tok
put c add mul idx 3 1 ulong pid
put c add mul idx 3 2 get c 411
ret tok
end
fn rmclient c view ulong 4096 fh ulong to ulong
if eq fh 0
ret 8
end
for j ulong 8
if eq get c mul j 3 fh
ret j
end
end
ret 8
end
fn rmforward c edit ulong 4096 b edit uchar 16384 o edit uchar 16384 idx ulong n ulong to ulong
temp = new uchar 16384 0
fd = int get c add mul idx 3 2
if rmio fd b n true
if rmio fd o 4 false
size = rmget o 0 4
if and ge size 16 le size 16384
if rmio fd temp sub size 4 false
for j ulong sub size 4
put o add j 4 get temp j
end
ret size
end
end
end
end
rmdrop c idx
ret rmbegin b o -5 0
end
fn rmframe c edit ulong 4096 b edit uchar 16384 o edit uchar 16384 n ulong to ulong
if lt n 40
ret rmbegin b o -22 0
end
if or ne rmget b 0 4 n eq rmget b 8 8 0
ret rmbegin b o -22 0
end
if ne rmget b 36 4 0
ret rmbegin b o -71 0
end
op = rmget b 4 4
if eq op 4096
if or ne n 56 or ne rmget b 40 4 7 lt rmget b 44 4 16
ret rmbegin b o -71 0
end
if ne get c 401 0
ret rmbegin b o -16 0
end
if or ne rmget b 48 4 0 ne rmget b 52 4 1
ret rmbegin b o -71 0
end
put c 401 1
size = rmbegin b o 0 add 73 len RMNAME
rmput o 16 4 7
rmput o 20 4 31
rmput o 28 4 1
rmput o 32 4 8192
rmput o 36 4 8192
for j ulong len RMNAME
put o add 88 j get RMNAME j
end
ret size
end
if eq get c 401 0
ret rmbegin b o -71 0
end
if eq op 14
if or ne n 48 ne rmget b 44 4 0
ret rmbegin b o -22 0
end
fh = rmopen c
if lt fh 0
ret rmbegin b o fh 0
end
size = rmbegin b o 0 16
rmput o 16 8 ulong fh
rmput o 24 4 33
ret size
end
if or eq op 39 or eq op 18 eq op 25
if lt n 48
ret rmbegin b o -22 0
end
idx = rmclient c rmget b 40 8
if eq idx 8
ret rmbegin b o -9 0
end
if eq op 39
ret rmauth c b o idx n
end
if ne n 64
ret rmbegin b o -22 0
end
if eq op 18
rmdrop c idx
end
ret rmbegin b o 0 0
end
ret rmbegin b o -38 0
end
fn main to int
c = new ulong 4096 0
b = new uchar 16384 0
o = new uchar 16384 0
if ne argcnt 4
ret 64
end
r = argread 1 b 0 64
if ne r 6
ret 64
end
fake = true
for j ulong 6
if ne get b j get RMFAKE j
fake = false
end
end
if fake
put c 403 1
else
for j ulong 6
if ne get b j get RMCUSE j
ret 64
end
end
r = fopen RMDEV 0 len RMDEV 524290 0
if lt r 0
ret 69
end
put c 402 ulong r
end
r = argread 2 b 0 64
if ne r 12
ret 64
end
note Exact --host-model option. The fixture is mandatory even in fake mode.
if or ne rmget b 0 8 ulong 7867072163225283885 ne rmget b 8 4 ulong 1818584175
ret 64
end
if not rmfload c b
ret 65
end
code = int 0
for step ulong 999999
r = read int get c 402 b 0 len b
if eq r neg long 4
continue
end
if le r 0
break
end
n = rmframe c b o ulong r
if fake
r = send 1 o 0 n 0
else
r = write int get c 402 o 0 n
end
if ne r long n
code = 80
break
end
end
for j ulong 8
if ne get c mul j 3 0
rmdrop c j
end
end
ret code
end

fn rmfx t view ulong 4096 off ulong to uchar
idx = add 3000 div off 8
shift = mul rem off 8 8
v = shr get t idx shift
ret uchar and v 255
end
fn rmfc t view ulong 4096 b edit uchar 16384 dst ulong src ulong n ulong to void
for j ulong n
put b add dst j rmfx t add src j
end
end

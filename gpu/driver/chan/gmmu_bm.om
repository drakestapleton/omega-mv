note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note chan/gmmu_bm.om: Zero-BSS bare-metal GB20B GMMU v3 (ver3) page tables & TLB invalidate.
note Drop-in replacement for chan/gmmu.om in SPARK.EFI: eliminates 8 MiB mmwin static .bss and
note all Linux mapnew/mapget/mapset/VFIO calls, and lifts window capacity from 8 MiB to 128 GiB
note (29+ GiB qwen3.8-27b-fp8 model support with 2 MiB pages, MMMAXPT=256 page-table pages).
note Compose after gsp/bm_hal.om; before chan/mem.om, chan/chan.om, chan/complete.om, chan/rmchan.om.
note Prefix mm / MM. Library unit, no fn main.

const MMOK long 0
const MMEINVAL long 1
const MMEALIGN long 2
const MMERANGE long 3
const MMEBUSY long 4
const MMENOMEM long 5
const MMENOENT long 6
const MMETIME long 7
const MMEDEAD long 8
const MMEIO long 9
const MMEGEN long 10
const MMESTATE long 11

const MMWNONE ulong 0
const MMWOWN ulong 1
const MMWDMA ulong 2
const MMWPUB ulong 3
const MMWQUAR ulong 4

const MMWFREE ulong 0
const MMWMAP ulong 1
const MMWMISS ulong 2
const MMWCONF ulong 3

const MMVALIM ulong 144115188075855872
const MMPALIM ulong 1099511627776
const MMADDR ulong 4503599627366400
const MMBIGM ulong 4503599627370240
const MMSZ4K ulong 4096
const MMSZ64K ulong 65536
const MMSZ2M ulong 2097152
const MMPTB ulong 4096
const MMMAXPT ulong 512
const MMAPSYS ulong 2
const MMPDEPCF ulong 2

note GB20B VF MMU invalidate registers: 0xB830A0, 0xB830A4, 0xB830B0
const MMRPDB ulong 12071072
const MMRUPR ulong 12071076
const MMRINV ulong 12071088
const MMTRIG ulong 2147483648
const MMALLVA ulong 1
const MMPDBAP ulong 2
note Bare-metal window ceiling: 128 GiB (covers full Spark 121.69 GiB LPDDR5x + 29 GiB model)
const MMWINMAX ulong 137438953472

global mmwb ulong 1
global mmws ulong 1
global mmmode ulong 1
global mmwkind ulong 1
global mmwst ulong 1
global mmwgen ulong 1
global mmasep ulong 1
global mmptpa ulong 512
global mmptus uchar 512
global mmptn ulong 1
global mmroot ulong 1
global mmdead ulong 1
global mmleaf ulong 1
global mmmiss ulong 1
global mmnpa ulong 1
global mmkey ulong 7
global mmwres ulong 1

fn mmregrd off ulong to ulong
ret bmbarrd32 off
end

fn mmregwr off ulong v ulong to void
bmbarwr32 off v
end

fn mmwinit base ulong size ulong to long
if eq get mmwst 0 MMWQUAR
ret MMESTATE
end
if eq get mmwgen 0 18446744073709551615
ret MMEGEN
end
if or eq base 0 or eq size 0 gt size MMWINMAX
ret MMEINVAL
end
if or ge base MMPALIM gt size sub MMPALIM base
ret MMERANGE
end
if ne and base 4095 0
ret MMEALIGN
end
put mmwgen 0 add get mmwgen 0 1
put mmwb 0 base
put mmws 0 size
put mmmode 0 2
put mmwkind 0 1
put mmwst 0 MMWDMA
put mmptn 0 0
put mmroot 0 0
put mmasep 0 0
put mmdead 0 0
ret MMOK
end

fn mmwepoch gen ulong to bool
ret and ne get mmwst 0 MMWNONE eq gen get mmwgen 0
end

fn mmwpublish gen ulong to long
if not mmwepoch gen
ret MMEGEN
end
if eq get mmwst 0 MMWPUB
ret MMOK
end
if ne get mmwst 0 MMWDMA
ret MMESTATE
end
put mmwst 0 MMWPUB
ret MMOK
end

fn mmwquar gen ulong to long
if not mmwepoch gen
ret MMEGEN
end
put mmwst 0 MMWQUAR
put mmdead 0 1
ret MMOK
end

fn mmwmutable to bool
s = get mmwst 0
ret or eq s MMWOWN or eq s MMWDMA eq s MMWPUB
end

fn mmrd64 pa ulong to ulong
ret bmmemrd64 pa
end

fn mmwr64 pa ulong v ulong to void
bmmemwr64 pa v
end

fn mmrd32 pa ulong to ulong
ret bmmemrd32 pa
end

fn mmwr32 pa ulong v ulong to void
bmmemwr32 pa v
end

fn mmwr8 pa ulong v uchar to void
bmmemwr8 pa v
end

fn mmzero pa ulong n ulong to void
bmmemzero pa n
end

fn mmpde pa ulong ap ulong to ulong
ret or or and pa MMADDR shl MMPDEPCF 3 shl and ap 3 1
end

fn mmdualb pa ulong ap ulong to ulong
if eq ap 0
ret 0
end
ret or or and pa MMBIGM shl MMPDEPCF 3 shl and ap 3 1
end

fn mmduals pa ulong ap ulong to ulong
if eq ap 0
ret 0
end
ret or or and pa MMADDR shl MMPDEPCF 3 shl and ap 3 1
end

fn mmpte pa ulong ap ulong pcf ulong kind ulong to ulong
v = or 1 shl and ap 3 1
v = or v shl and pcf 31 3
v = or v shl and kind 15 8
ret or v and pa MMADDR
end

fn mmlvlo lv ulong to ulong
if eq lv 0
ret 56
end
if eq lv 1
ret 47
end
if eq lv 2
ret 38
end
if eq lv 3
ret 29
end
if eq lv 4
ret 21
end
if eq lv 5
ret 16
end
ret 12
end

fn mmlvhi lv ulong to ulong
if eq lv 0
ret 56
end
if eq lv 1
ret 55
end
if eq lv 2
ret 46
end
if eq lv 3
ret 37
end
if eq lv 4
ret 28
end
ret 20
end

fn mmlvidx lv ulong va ulong to ulong
lo = mmlvlo lv
b = add sub mmlvhi lv lo 1
ret and shr va lo sub shl 1 b 1
end

fn mminwin pa ulong size ulong to bool
b = get mmwb 0
s = get mmws 0
if or eq size 0 lt pa b
ret false
end
o = sub pa b
if gt o s
ret false
end
ret le size sub s o
end

fn mmptalloc to long
if not mmwmutable
ret MMEBUSY
end
n = get mmptn 0
for i ulong n
if eq get mmptus i 0
put mmptus i 1
p = get mmptpa i
mmzero p MMPTB
put mmnpa 0 p
ret MMOK
end
end
ret MMENOMEM
end

fn mmptfree to ulong
c = ulong 0
for i ulong get mmptn 0
if eq get mmptus i 0
c = add c 1
end
end
ret c
end

fn mmasinit pool ulong pages ulong to long
if not mmwmutable
ret MMEBUSY
end
if or or eq get mmws 0 0 or lt pages 2 gt pages MMMAXPT ne and pool 4095 0
ret MMEINVAL
end
if not mminwin pool mul pages MMPTB
ret MMERANGE
end
put mmptn 0 pages
put mmasep 0 get mmwgen 0
put mmdead 0 0
for i ulong MMMAXPT
if lt i pages
put mmptpa i add pool mul i MMPTB
else
put mmptpa i 0
end
put mmptus i 0
end
r = mmptalloc
if eq r MMOK
put mmroot 0 get mmnpa 0
end
ret r
end

fn mmwalkup va ulong create bool to ulong
put mmwres 0 MMWFREE
tbl = get mmroot 0
for lv ulong 4
ea = add tbl mul mmlvidx lv va 8
v = mmrd64 ea
if ne and v 1 0
put mmwres 0 MMWCONF
ret 0
end
if eq and shr v 1 3 0
if not create
put mmmiss 0 add lv 1
put mmwres 0 MMWMISS
ret 0
end
r = mmptalloc
if ne r MMOK
put mmwres 0 MMWCONF
ret 0
end
mmwr64 ea mmpde get mmnpa 0 MMAPSYS
v = mmrd64 ea
end
tbl = and v MMADDR
end
ret tbl
end

fn mmwalkpt d ulong va ulong large bool create bool to ulong
w0 = mmrd64 d
w1 = mmrd64 add d 8
ap = and shr w1 1 3
lvl = ulong 6
pt = and w1 MMADDR
if large
ap = and shr w0 1 3
lvl = 5
pt = and w0 MMBIGM
end
if eq ap 0
if not create
put mmmiss 0 lvl
ret MMWMISS
end
r = mmptalloc
if ne r MMOK
ret MMWCONF
end
pt = get mmnpa 0
if large
mmwr64 add d 8 mmduals 0 0
mmwr64 d mmdualb pt MMAPSYS
else
mmwr64 add d 8 mmduals pt MMAPSYS
mmwr64 d mmdualb 0 0
end
end
p = add pt mul mmlvidx lvl va 8
put mmleaf 0 p
if ne and mmrd64 p 1 0
ret MMWMAP
end
ret MMWFREE
end

fn mmwalk va ulong page ulong create bool to ulong
tbl = mmwalkup va create
if ne get mmwres 0 MMWFREE
ret get mmwres 0
end
d = add tbl mul mmlvidx 4 va 16
w0 = mmrd64 d
w1 = mmrd64 add d 8
bap = and shr w0 1 3
sap = and shr w1 1 3
if eq page MMSZ2M
put mmleaf 0 d
if ne and w0 1 0
ret MMWMAP
end
if ne or bap sap 0
ret MMWCONF
end
ret MMWFREE
end
if ne and w0 1 0
ret MMWCONF
end
large = eq page MMSZ64K
if large
if ne sap 0
ret MMWCONF
end
else
if ne bap 0
ret MMWCONF
end
end
ret mmwalkpt d va large create
end

fn mmchk va ulong size ulong page ulong to long
if ne get mmdead 0 0
ret MMEDEAD
end
if and and ne page MMSZ4K ne page MMSZ64K ne page MMSZ2M
ret MMEINVAL
end
if eq size 0
ret MMEINVAL
end
if ne and or va size sub page 1 0
ret MMEALIGN
end
if or ge va MMVALIM gt size sub MMVALIM va
ret MMERANGE
end
if gt div size page 999998
ret MMERANGE
end
ret MMOK
end

fn mmneed va ulong size ulong page ulong to ulong
for j ulong 7
put mmkey j 18446744073709551615
end
last = ulong 6
if eq page MMSZ2M
last = 4
end
if eq page MMSZ64K
last = 5
end
need = ulong 0
off = ulong 0
while lt off size bound 999999
w = mmwalk add va off page false
if or eq w MMWMAP eq w MMWCONF
ret 18446744073709551615
end
if eq w MMWMISS
j = get mmmiss 0
while le j last bound 8
k = shr add va off add mmlvhi j 1
if ne k get mmkey j
put mmkey j k
need = add need 1
end
if and eq j 4 eq last 6
j = 5
end
j = add j 1
end
end
off = add off page
end
ret need
end

note Map physical range [pa, pa+size) to [va, va+size) using 4K, 64K, or 2M pages.
note Allows mapping any <40-bit PA (e.g. 29+ GiB model weights in WB LPDDR5x outside the PT pool).
fn mmmap va ulong pa ulong size ulong page ulong ap ulong pcf ulong to long
if not mmwmutable
ret MMEBUSY
end
if ne get mmasep 0 get mmwgen 0
ret MMEGEN
end
rc = mmchk va size page
if ne rc MMOK
ret rc
end
if or gt ap 3 gt pcf 31
ret MMEINVAL
end
if or eq pa 0 ne and pa sub page 1 0
ret MMEALIGN
end
if or ge pa MMPALIM gt size sub MMPALIM pa
ret MMERANGE
end
need = mmneed va size page
if eq need 18446744073709551615
ret MMEBUSY
end
if gt need mmptfree
ret MMENOMEM
end
off = ulong 0
while lt off size bound 999999
w = mmwalk add va off page true
if ne w MMWFREE
ret MMEBUSY
end
mmwr64 get mmleaf 0 mmpte add pa off ap pcf 0
off = add off page
end
bmdsb
ret MMOK
end

fn mmunmap va ulong size ulong page ulong to long
if not mmwmutable
ret MMEBUSY
end
if ne get mmasep 0 get mmwgen 0
ret MMEGEN
end
rc = mmchk va size page
if ne rc MMOK
ret rc
end
off = ulong 0
while lt off size bound 999999
if ne mmwalk add va off page false MMWMAP
ret MMENOENT
end
off = add off page
end
off = 0
while lt off size bound 999999
w = mmwalk add va off page false
mmwr64 get mmleaf 0 0
off = add off page
end
bmdsb
ret MMOK
end

fn mminval budget ulong to long
if eq budget 0
ret MMEINVAL
end
if ne get mmdead 0 0
ret MMEDEAD
end
if or eq get mmroot 0 0 ne get mmasep 0 get mmwgen 0
ret MMEGEN
end
pr = mmwpublish get mmwgen 0
if ne pr MMOK
ret pr
end
bmdsb
pdb = shr get mmroot 0 12
mmregwr MMRPDB or shl and pdb 268435455 4 MMPDBAP
mmregwr MMRUPR and shr pdb 28 1048575
mmregwr MMRINV or MMALLVA MMTRIG
for i ulong budget
if eq and mmregrd MMRINV MMTRIG 0
ret MMOK
end
cpurelax
end
put mmdead 0 1
r = mmwquar get mmwgen 0
ret MMETIME
end

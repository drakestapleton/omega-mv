note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Composed serialized HOST MODEL launcher. Never opens a physical device, binds VFIO or starts firmware.
text ogmodes "model\nmodel-trace\n"
text ogpass "ogd MODEL PASS: sequencer, INIT_DONE, lockdown; revoke/synchronize/model-device-stop; published DMA retained\n"
text ogdeny "ogd: physical VFIO/GSP launch refused; only explicit model mode is admitted\n"
text ogname "modes"
text ogmodel "model"
text ogtrace "model-trace"
fn ogword off ulong value ulong to void
for i ulong 8
put ogout add off i uchar and shr value mul i 8 255
end
end
fn ogstatus off ulong value long to void
ogword off ulong add value 128
end
fn oglease cap irqls span mmspan to int
r = irattach cap span 1
if ne r 0
ret 4
end
r = irenable cap 1
if ne r 0
ret 5
end
r = iqinit 1
if ne r 0
ret 6
end
r = ogfeed
if ne r 0
ret 7
end
r = irsubmit cap 1
r = pvpeer
r = mapset get pvmm 0 0 4 64
if ne r 0
ret 8
end
r = icservice cap span 1 64
ogstatus 0 r
ogword 8 get iqstate 0
ogword 16 get qrlock 0
ogword 24 get pvlocked 0
ogword 32 ulong get rqrx 0
ogword 40 mapget get mmwh 0 add get qtcmd 0 32 4
ogword 48 ulong get sqdly 0
ogword 56 ulong get sqdly 1
note Post-lockdown handler admission and typed MMIO must both remain denied.
late = hownermk cap 1
r = mmread span late 1 0
ogstatus 120 r
r = irrevoke cap 1
ogstatus 64 r
r = irsync cap 1
ogstatus 72 r
r = irquiet cap 1
ogstatus 80 r
for i ulong 4
r = pvtick
end
r = irquiet cap 1
ogstatus 96 r
ogword 88 get pvfx 0
r = irclose cap span 1
ogstatus 104 r
ogword 112 get mmwst 0
ret 0
end
fn ogrun to int
r = oginit
if ne r 0
ret 1
end
r = pvinit 1 1
if ne r 0
ret 2
end
span = mmspanmk 1
if eq open span 0
ret 3
end
cap = irqlsmk 1 0 0 1
if eq open cap 0
ret 4
end
ret oglease cap span
end
fn ogmatch needle view uchar * to bool
if ne argread 1 ogarg 0 32 long len needle
ret false
end
for i ulong len needle
if ne get ogarg i get needle i
ret false
end
end
ret true
end
fn main to int
if ogmatch ogname
r = write 1 ogmodes 0 len ogmodes
ret 0
end
trace = ogmatch ogtrace
if or trace ogmatch ogmodel
rc = ogrun
if ne rc 0
ret rc
end
if trace
r = write 1 ogout 0 128
if ne r 128
ret 9
end
ret 0
end
if or ne get ilstate 0 6 ne get mmwst 0 MMWQUAR
ret 10
end
if or ne get iqstate 0 3 ne get pvlocked 0 1
ret 11
end
r = write 1 ogpass 0 len ogpass
ret 0
end
r = write 2 ogdeny 0 len ogdeny
ret 95
end

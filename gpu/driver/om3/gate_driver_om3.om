om2
note SPDX-License-Identifier: Apache-2.0
note gpu/driver/om3/gate_driver_om3.om: Pure Seeded OM-2 Verification Gate for Frontier #2.
note Runs zero C/Python/shell:
note   1. Verifies gpu/driver/om3/gb20b_om3_dma.om through om3_aegis (COLD_PROVED -> MEMO_HIT bit-exact),
note      confirms zero @ capability leaks in lowered om2, compiles with pinned seed/out/omc, and executes.
note   2. Generates and kills >= 15 real negative controls (surgical mutations of gb20b_om3_dma.om
note      + lowered driver mutants + OMEGA-MEMO 1-byte tamper).
note   3. Runs hermetic positive + negative sysfs fixture checks on gb20b_vfio_probe (hw_writes=0).
note
note Usage:
note   gate_driver_om3 <om3_aegis> <omc> <gb20b_om3_dma.om> <gb20b_vfio_probe> <work_dir>

const GD_O_WR int 577
const GD_MAX_SRC ulong 262144

note Unified 16 x 2048 path slots (0..7 = scratch pa..ph, 8..12 = CLI path args aegis..work)
const GP_A ulong 0
const GP_B ulong 1
const GP_C ulong 2
const GP_D ulong 3
const GP_E ulong 4
const GP_F ulong 5
const GP_G ulong 6
const GP_H ulong 7
const GP_AEGIS ulong 8
const GP_OMC ulong 9
const GP_SRCP ulong 10
const GP_PROBE ulong 11
const GP_WORK ulong 12
const GP_STRIDE ulong 2048

note Data buffer IDs
const GB_SRC ulong 0
const GB_MUT ulong 1
const GB_LOW ulong 2
const GB_B2 ulong 3
const GB_OUT ulong 4
const GB_ERR ulong 5

global gd_ps uchar 32768
global gd_pl ulong 16

global gd_src uchar 262144
global gd_srclen ulong 1
global gd_mut uchar 262144
global gd_mutlen ulong 1
global gd_low uchar 262144
global gd_lowlen ulong 1
global gd_b2 uchar 262144
global gd_b2len ulong 1
global gd_probe_rd uchar 4

global gd_av uchar 16384
global gd_an ulong 1
global gd_st uchar 4
global gd_out uchar 65536
global gd_outl ulong 1
global gd_err uchar 65536
global gd_errl ulong 1
global gd_dig uchar 24
global gd_kills ulong 1

text gd_def_aegis "build/om3_aegis"
text gd_def_omc "seed/out/omc"
text gd_def_src "gpu/driver/om3/gb20b_om3_dma.om"
text gd_def_probe "build/gb20b_vfio_probe"
text gd_def_work "build/om3_driver_gate"

text gd_cmd_ver "verify-om3"
text gd_cmd_root "--root"
text gd_s_memo "/memo"
text gd_s_memot "/memo_tamper"
text gd_s_cold "/gb20b.cold.om"
text gd_s_hit "/gb20b.hit.om"
text gd_s_bin "/gb20b.bin"
text gd_s_mutin "/mut.om"
text gd_s_mutom "/mut.out.om"
text gd_s_mutbin "/mut.bin"
text gd_s_out "/child.out"
text gd_s_err "/child.err"
text gd_s_null "/empty.in"

text gd_pat_cold "COLD_PROVED"
text gd_pat_hit "MEMO_HIT"
text gd_pat_pass "GB20B_OM3_DMA PASS"
text gd_pat_vpass "hw_writes=0"
text gd_pat_vblk "VFIO_DEVICE_BIND=BLOCKED_HARDWARE (IORT RMR_NODE idx=50 remap_permitted=0)"
text gd_pat_at "\n@"

text gd_n_unm "@unmap gr_gcb0\n"
text gd_n_tlb "@tlbinval gr_gcb0\n"
text gd_n_fnc "@fence_drain gr_gcb0 1\n"
text gd_n_rev "@vma_revoke gr_gcb0\n"
text gd_n_rcl "@reclaim gr_gcb0\n"
text gd_n_dbl "@reclaim gr_gcb0\n@reclaim gr_gcb0\n"
text gd_n_reg0 "@region gr_gcb0 3 0x93300000 0x10000\n"
text gd_n_slab "@region gr_gcb0 3 0x90000000 0x10000\n"
text gd_n_rmr0 "@region gr_gcb0 3 0xa1600000 0x10000\n"
text gd_n_rmr1 "@region gr_gcb0 3 0x280000000 0x10000\n"
text gd_n_map0 "@map gr_gcb0 0x200600000 0x10000\n"
text gd_n_map1 "@map gr_gcb1 0x200800000 0x10000\n"
text gd_n_mapslab "@map vfs_inode_slab 0x200600000 0x10000\n"
text gd_n_mapva "@map gr_gcb1 0x200000000 0x10000\n"
text gd_n_raw_anchor "ret 0\n"
text gd_n_raw_inj "x = fwld 4096 8\nret 0\n"
text gd_n_cfg_if "@unmap gr_gcb0\n@tlbinval gr_gcb0\n@fence_drain gr_gcb0 1\n@vma_revoke gr_gcb0\n@reclaim gr_gcb0\n"
text gd_n_cfg_rep "if eq 0 1\n@unmap gr_gcb0\n@tlbinval gr_gcb0\n@fence_drain gr_gcb0 1\n@vma_revoke gr_gcb0\nend\n@reclaim gr_gcb0\n"
text gd_n_empty ""

text gd_r_pcf17 "const DM_CFG_GR_PCF ulong 17\n"
text gd_r_pcf16 "const DM_CFG_GR_PCF ulong 16\n"
text gd_r_msix9 "const DM_CFG_MSIX ulong 9\n"
text gd_r_msix8 "const DM_CFG_MSIX ulong 8\n"
text gd_r_va2g "const DM_CFG_VA_BASE ulong 0x80000000\n"
text gd_r_va0 "const DM_CFG_VA_BASE ulong 0x10000\n"
text gd_r_sc1 "const DM_CFG_SC_PATCH ulong 1\n"
text gd_r_sc0 "const DM_CFG_SC_PATCH ulong 0\n"

text gd_vp_pass "/vfio_pass"
text gd_vp_fail "/vfio_fail"
text gd_d_sys "/sys"
text gd_d_bus "/sys/bus"
text gd_d_pci "/sys/bus/pci"
text gd_d_devs "/sys/bus/pci/devices"
text gd_d_bdf "/sys/bus/pci/devices/000f:01:00.0"
text gd_d_kern "/sys/kernel"
text gd_d_ig "/sys/kernel/iommu_groups"
text gd_d_ig20 "/sys/kernel/iommu_groups/20"
text gd_d_ig20d "/sys/kernel/iommu_groups/20/devices"
text gd_d_dev "/dev"
text gd_d_dvfio "/dev/vfio"

text gd_f_ven "/sys/bus/pci/devices/000f:01:00.0/vendor"
text gd_f_dev "/sys/bus/pci/devices/000f:01:00.0/device"
text gd_f_res "/sys/bus/pci/devices/000f:01:00.0/resource"
text gd_f_grp "/sys/bus/pci/devices/000f:01:00.0/iommu_group"
text gd_f_gtgt "../../../../kernel/iommu_groups/20"
text gd_f_sole "/sys/kernel/iommu_groups/20/devices/000f:01:00.0"
text gd_f_extra "/sys/kernel/iommu_groups/20/devices/000f:01:00.1"
text gd_f_gtype "/sys/kernel/iommu_groups/20/type"
text gd_f_grsv "/sys/kernel/iommu_groups/20/reserved_regions"
text gd_f_vfio "/dev/vfio/vfio"

text gd_c_ven "0x10de\n"
text gd_c_dev "0x2e12\n"
text gd_c_res "0x0000000024000000 0x0000000027ffffff 0x000000000014220c\n"
text gd_c_type "DMA\n"
text gd_c_rsv "0x0000000008000000 0x00000000080fffff msi\n0x00000000a1600000 0x00000000b97fffff direct\n0x0000000280000000 0x0000000302ffffff direct\n"

text gd_m_ok "GATE_DRIVER_OM3 PASS admission=1 memo_bit_exact=1 runtime_exec=0 neg_kills="
text gd_m_ok2 " vfio_fixture_pos=1 vfio_fixture_neg=1\n"
text gd_m_kill "  KILL ["
text gd_m_kill2 "] "
text gd_m_kill3 " -> exit="
text gd_m_fail "GATE_DRIVER_OM3 FAIL step="
text gd_m_got " got="
text gd_nl "\n"

text gd_k_01 "omitted_unmap"
text gd_k_02 "omitted_tlbinval"
text gd_k_03 "omitted_fence_drain"
text gd_k_04 "omitted_vma_revoke"
text gd_k_05 "slab_phys_overlap"
text gd_k_06 "slab_gpu_map"
text gd_k_07 "rmr0_collision"
text gd_k_08 "rmr1_collision"
text gd_k_09 "raw_ptr_fwld_escape"
text gd_k_10 "double_reclaim"
text gd_k_11 "leak_at_ret"
text gd_k_12 "cfg_branch_bypass"
text gd_k_13 "va_aliasing"
text gd_k_14 "cached_gcb_pte_pcf0x10"
text gd_k_15 "msix_8_vectors_mutant"
text gd_k_16 "vabase_sub2g_mutant"
text gd_k_17 "sc_pdb0_unpatched_mutant"
text gd_k_18 "omega_memo_1byte_tamper"

fn gd_wrt fd int s view uchar * to void
r = write fd s 0 len s
end

fn gd_num fd int v ulong to void
x = v
p = ulong 24
for i ulong 21
p = sub p 1
put gd_dig p uchar add 48 rem x 10
x = div x 10
if eq x 0
r = write fd gd_dig p sub 24 p
ret
end
end
end

fn gd_fail step view uchar * code ulong to int
gd_wrt 2 gd_m_fail
gd_wrt 2 step
gd_wrt 2 gd_m_got
gd_num 2 code
gd_wrt 2 gd_nl
ret 1
end

fn gd_poff slot ulong to ulong
ret mul slot GP_STRIDE
end

fn gd_bget bid ulong idx ulong to uchar
if eq bid GB_SRC
ret get gd_src idx
end
if eq bid GB_MUT
ret get gd_mut idx
end
if eq bid GB_LOW
ret get gd_low idx
end
if eq bid GB_B2
ret get gd_b2 idx
end
if eq bid GB_ERR
ret get gd_err idx
end
ret get gd_out idx
end

fn gd_cp_txt_p slot ulong s view uchar * to void
base = gd_poff slot
n = len s
for i ulong n bound 2048
put gd_ps add base i get s i
end
put gd_pl slot n
end

fn gd_cp_arg_p idx ulong slot ulong to ulong
base = gd_poff slot
n = argread idx gd_ps base 1020
if lt n 1
put gd_pl slot 0
ret 0
end
put gd_pl slot ulong n
ret ulong n
end

fn gd_join_work suf view uchar * dst ulong to void
wl = get gd_pl GP_WORK
wbase = gd_poff GP_WORK
dbase = gd_poff dst
for i ulong wl bound 1024
put gd_ps add dbase i get gd_ps add wbase i
end
sl = len suf
for j ulong sl bound 1024
put gd_ps add add dbase wl j get suf j
end
put gd_pl dst add wl sl
end

fn gd_join_txt srcp ulong suf view uchar * dstp ulong to void
bl = get gd_pl srcp
sbase = gd_poff srcp
dbase = gd_poff dstp
for i ulong bl bound 1500
put gd_ps add dbase i get gd_ps add sbase i
end
sl = len suf
for j ulong sl bound 512
put gd_ps add add dbase bl j get suf j
end
put gd_pl dstp add bl sl
end

fn gd_join_slots p1 ulong p2 ulong dstp ulong to void
l1 = get gd_pl p1
l2 = get gd_pl p2
b1 = gd_poff p1
b2 = gd_poff p2
db = gd_poff dstp
for i ulong l1 bound 1500
put gd_ps add db i get gd_ps add b1 i
end
for j ulong l2 bound 512
put gd_ps add add db l1 j get gd_ps add b2 j
end
put gd_pl dstp add l1 l2
end

fn gd_write_b pid ulong bid ulong bl ulong mode int to bool
poff = gd_poff pid
plen = get gd_pl pid
fd = fopen gd_ps poff plen GD_O_WR mode
if lt fd 0
ret false
end
o = ulong 0
while lt o bl bound 4096
remb = sub bl o
k = long -1
if eq bid GB_MUT
k = write int fd gd_mut o remb
end
if eq bid GB_B2
k = write int fd gd_b2 o remb
end
if eq bid GB_OUT
k = write int fd gd_out o remb
end
if eq bid GB_SRC
k = write int fd gd_src o remb
end
if le k 0
k = fclose int fd
ret false
end
o = add o ulong k
end
k = fclose int fd
ret true
end

fn gd_write_txt pid ulong s view uchar * mode int to bool
fd = fopen gd_ps gd_poff pid get gd_pl pid GD_O_WR mode
if lt fd 0
ret false
end
bl = len s
if eq bl 0
r0 = fclose int fd
ret true
end
r = write int fd s 0 bl
bl = ulong fclose int fd
ret eq r long len s
end

fn gd_read_to_b pid ulong bid ulong cap ulong to long
fd = fopen gd_ps gd_poff pid get gd_pl pid 0 0
if lt fd 0
ret fd
end
n = ulong 0
eof = false
while lt n cap bound 4096
remc = sub cap n
k = long -1
if eq bid GB_SRC
k = read int fd gd_src n remc
end
if eq bid GB_MUT
k = read int fd gd_mut n remc
end
if eq bid GB_LOW
k = read int fd gd_low n remc
end
if eq bid GB_B2
k = read int fd gd_b2 n remc
end
if eq bid GB_OUT
k = read int fd gd_out n remc
end
if eq bid GB_ERR
k = read int fd gd_err n remc
end
if lt k 0
eof = eq fclose int fd 0
ret k
end
if eq k 0
eof = true
break
end
n = add n ulong k
end
if not eof
k = read int fd gd_probe_rd 0 1
if ne k 0
k = fclose int fd
ret -27
end
end
k = fclose int fd
ret long n
end

fn gd_buf_has bid ulong bl ulong pat view uchar * to bool
pl = len pat
if lt bl pl
ret false
end
lim = add sub bl pl 1
for i ulong lim bound 262144
ok = true
for j ulong pl bound 128
if ne gd_bget bid add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn gd_files_equal p1 ulong p2 ulong to bool
n1 = gd_read_to_b p1 GB_MUT GD_MAX_SRC
if lt n1 0
ret false
end
n2 = gd_read_to_b p2 GB_B2 GD_MAX_SRC
if ne n1 n2
ret false
end
for i ulong ulong n1 bound 262144
if ne get gd_mut i get gd_b2 i
ret false
end
end
ret true
end

fn gd_av_reset to void
put gd_av 0 0
put gd_av 1 0
put gd_an 0 2
end

fn gd_av_push_p slot ulong to void
sbase = gd_poff slot
sl = get gd_pl slot
cnt = or ulong get gd_av 0 shl ulong get gd_av 1 8
cnt = add cnt 1
put gd_av 0 uchar and cnt 255
put gd_av 1 uchar shr cnt 8
pos = get gd_an 0
put gd_av pos uchar and sl 255
put gd_av add pos 1 uchar shr sl 8
pos = add pos 2
for i ulong sl bound 2048
put gd_av add pos i get gd_ps add sbase i
end
put gd_an 0 add pos sl
end

fn gd_av_push_txt s view uchar * to void
n = len s
cnt = or ulong get gd_av 0 shl ulong get gd_av 1 8
cnt = add cnt 1
put gd_av 0 uchar and cnt 255
put gd_av 1 uchar shr cnt 8
pos = get gd_an 0
put gd_av pos uchar and n 255
put gd_av add pos 1 uchar shr n 8
pos = add pos 2
for i ulong n bound 512
put gd_av add pos i get s i
end
put gd_an 0 add pos n
end

fn gd_run_child in_slot ulong out_mode int to ulong
gd_join_work gd_s_out GP_B
gd_join_work gd_s_err GP_C
fi = fopen gd_ps gd_poff in_slot get gd_pl in_slot 0 0
fo = fopen gd_ps gd_poff GP_B get gd_pl GP_B GD_O_WR out_mode
fe = fopen gd_ps gd_poff GP_C get gd_pl GP_C GD_O_WR 420
if or lt fi 0 or lt fo 0 lt fe 0
ret 255
end
pid = fork
if lt pid 0
ret 254
end
if eq pid 0
rc = dupfd int fi 0 0
rc = dupfd int fo 1 0
rc = dupfd int fe 2 0
rc = execprog gd_av 0 get gd_an 0
exit 127
end
rc = fclose int fi
rc = fclose int fo
rc = fclose int fe
rc = waitpid int pid gd_st 0 4 0
if ne rc pid
ret 253
end
rc = gd_read_to_b GP_B GB_OUT 65536
if ge rc 0
put gd_outl 0 ulong rc
else
put gd_outl 0 0
end
rc = gd_read_to_b GP_C GB_ERR 65536
if ge rc 0
put gd_errl 0 ulong rc
else
put gd_errl 0 0
end
if ne get gd_st 0 0
ret add 256 ulong get gd_st 0
end
ret ulong get gd_st 1
end

fn gd_mutate_b srcbid ulong slen ulong pat view uchar * rep view uchar * to bool
pl = len pat
if lt slen pl
ret false
end
lim = add sub slen pl 1
found = slen
for i ulong lim bound 262144
ok = true
for j ulong pl bound 256
if ne gd_bget srcbid add i j get pat j
ok = false
break
end
end
if ok
found = i
break
end
end
if eq found slen
ret false
end
o = ulong 0
for i ulong found bound 262144
put gd_mut o gd_bget srcbid i
o = add o 1
end
pl = len rep
for i ulong pl bound 512
put gd_mut o get rep i
o = add o 1
end
lim = add found len pat
for i ulong sub slen lim bound 262144
put gd_mut o gd_bget srcbid add lim i
o = add o 1
end
put gd_mutlen 0 o
ret true
end

fn gd_note_kill name view uchar * code ulong to void
k = add get gd_kills 0 1
put gd_kills 0 k
gd_wrt 1 gd_m_kill
gd_num 1 k
gd_wrt 1 gd_m_kill2
gd_wrt 1 name
gd_wrt 1 gd_m_kill3
gd_num 1 code
gd_wrt 1 gd_nl
end

fn gd_prep_mut srcbid ulong slen ulong pat view uchar * rep view uchar * to bool
if not gd_mutate_b srcbid slen pat rep
ret false
end
gd_join_work gd_s_mutin GP_A
ret gd_write_b GP_A GB_MUT get gd_mutlen 0 420
end

fn gd_run_aegis_neg name view uchar * want ulong to bool
gd_join_work gd_s_null GP_D
gd_join_work gd_s_memo GP_E
gd_join_work gd_s_mutom GP_F
gd_av_reset
gd_av_push_p GP_AEGIS
gd_av_push_txt gd_cmd_ver
gd_av_push_p GP_A
gd_av_push_p GP_E
gd_av_push_p GP_F
rc = gd_run_child GP_D 420
if ne rc want
ret false
end
gd_note_kill name rc
ret true
end

fn gd_kill_aegis name view uchar * want ulong pat view uchar * to bool
if not gd_prep_mut GB_SRC get gd_srclen 0 pat gd_n_empty
ret false
end
ret gd_run_aegis_neg name want
end

fn gd_kill_aegis2 name view uchar * pat view uchar * rep view uchar * to bool
if not gd_prep_mut GB_SRC get gd_srclen 0 pat rep
ret false
end
ret true
end

fn gd_run_rt_neg name view uchar * pat view uchar * rep view uchar * to bool
if not gd_prep_mut GB_LOW get gd_lowlen 0 pat rep
ret false
end
gd_join_work gd_s_mutbin GP_D
gd_av_reset
gd_av_push_p GP_OMC
rc_c = gd_run_child GP_A 493
if ne rc_c 0
ret false
end
gd_join_work gd_s_out GP_F
n_b = gd_read_to_b GP_F GB_B2 GD_MAX_SRC
if le n_b 0
ret false
end
if not gd_write_b GP_D GB_B2 ulong n_b 493
ret false
end
rc_ch = chmod gd_ps gd_poff GP_D get gd_pl GP_D 493
if ne rc_ch 0
ret false
end
gd_join_work gd_s_null GP_A
gd_av_reset
gd_av_push_p GP_D
rc_r = gd_run_child GP_A 420
if eq rc_r 0
ret false
end
gd_note_kill name rc_r
ret true
end

fn gd_mk_symlnk tgt view uchar * lnk_slot ulong to bool
tl = len tgt
lb = gd_poff lnk_slot
ll = get gd_pl lnk_slot
put gd_av 0 2
put gd_av 1 0
pos = ulong 2
put gd_av pos uchar and tl 255
put gd_av add pos 1 uchar shr tl 8
pos = add pos 2
for i ulong tl bound 1024
put gd_av add pos i get tgt i
end
pos = add pos tl
put gd_av pos uchar and ll 255
put gd_av add pos 1 uchar shr ll 8
pos = add pos 2
for j ulong ll bound 1024
put gd_av add pos j get gd_ps add lb j
end
pos = add pos ll
r = symlnk gd_av 0 pos
ret eq r 0
end

fn gd_mkdir_sub bslot ulong subp view uchar * to void
gd_join_txt bslot subp GP_A
r = makedir gd_ps gd_poff GP_A get gd_pl GP_A 493
end

fn gd_wr_sub bslot ulong rel view uchar * txt view uchar * to bool
gd_join_txt bslot rel GP_A
ret gd_write_txt GP_A txt 420
end

fn gd_setup_vfio_tree slot ulong with_extra bool to bool
r0 = makedir gd_ps gd_poff slot get gd_pl slot 493
gd_mkdir_sub slot gd_d_sys
gd_mkdir_sub slot gd_d_bus
gd_mkdir_sub slot gd_d_pci
gd_mkdir_sub slot gd_d_devs
gd_mkdir_sub slot gd_d_bdf
gd_mkdir_sub slot gd_d_kern
gd_mkdir_sub slot gd_d_ig
gd_mkdir_sub slot gd_d_ig20
gd_mkdir_sub slot gd_d_ig20d
gd_mkdir_sub slot gd_d_dev
gd_mkdir_sub slot gd_d_dvfio

if not gd_wr_sub slot gd_f_ven gd_c_ven
ret false
end
if not gd_wr_sub slot gd_f_dev gd_c_dev
ret false
end
if not gd_wr_sub slot gd_f_res gd_c_res
ret false
end
if not gd_wr_sub slot gd_f_gtype gd_c_type
ret false
end
if not gd_wr_sub slot gd_f_grsv gd_c_rsv
ret false
end
if not gd_wr_sub slot gd_f_vfio gd_n_empty
ret false
end
if not gd_wr_sub slot gd_f_sole gd_n_empty
ret false
end
if with_extra
if not gd_wr_sub slot gd_f_extra gd_n_empty
ret false
end
end
gd_join_txt slot gd_f_grp GP_A
u_r = unlink gd_ps gd_poff GP_A get gd_pl GP_A
ret gd_mk_symlnk gd_f_gtgt GP_A
end

fn gd_ends_ome base ulong slen ulong to bool
if lt slen 4
ret false
end
p = add base sub slen 4
if ne get gd_ps p 46
ret false
end
if ne get gd_ps add p 1 111
ret false
end
if ne get gd_ps add p 2 109
ret false
end
ret eq get gd_ps add p 3 101
end

fn gd_tamper_subdir to ulong
sfd = fopen gd_ps gd_poff GP_G get gd_pl GP_G 49152 0
if lt sfd 0
ret 0
end
cnt = ulong 0
while true bound 64
sr = getdnts int sfd gd_mut 0 8192
if le sr 0
break
end
so = ulong 0
while lt so ulong sr bound 8192
srl = ulong get gd_mut add so 17
srl = or shl srl 8 ulong get gd_mut add so 16
if eq srl 0
break
end
if ne get gd_mut add so 19 46
e_off = gd_poff GP_E
put gd_ps e_off 47
fnl = ulong 0
while lt fnl 128 bound 128
fch = get gd_mut add add so 19 fnl
if eq fch 0
break
end
put gd_ps add e_off add 1 fnl fch
fnl = add fnl 1
end
put gd_pl GP_E add 1 fnl
if gd_ends_ome add e_off 1 fnl
gd_join_slots GP_G GP_E GP_B
gd_join_slots GP_H GP_E GP_C
sr = gd_read_to_b GP_B GB_B2 GD_MAX_SRC
if gt sr 230
put gd_b2 230 xor get gd_b2 230 255
if not gd_write_b GP_C GB_B2 ulong sr 420
sr = fclose int sfd
ret 0
end
cnt = add cnt 1
end
end
end
so = add so srl
end
end
sr = fclose int sfd
ret cnt
end

fn gd_tamper_memo_test to bool
gd_join_work gd_s_memo GP_A
gd_join_work gd_s_memot GP_D
dfd = makedir gd_ps gd_poff GP_D get gd_pl GP_D 493
dfd = fopen gd_ps gd_poff GP_A get gd_pl GP_A 49152 0
if lt dfd 0
ret false
end
tampered = ulong 0
while true bound 64
r = getdnts int dfd gd_low 0 8192
if le r 0
break
end
o = ulong 0
while lt o ulong r bound 8192
rl = ulong get gd_low add o 17
rl = or shl rl 8 ulong get gd_low add o 16
if eq rl 0
break
end
if ne get gd_low add o 19 46
f_off = gd_poff GP_F
put gd_ps f_off 47
nl = ulong 0
while lt nl 64 bound 64
ch = get gd_low add add o 19 nl
if eq ch 0
break
end
put gd_ps add f_off add 1 nl ch
nl = add nl 1
end
put gd_pl GP_F add 1 nl
gd_join_slots GP_A GP_F GP_G
gd_join_slots GP_D GP_F GP_H
r = makedir gd_ps gd_poff GP_H get gd_pl GP_H 493
tampered = add tampered gd_tamper_subdir
end
o = add o rl
end
end
r = fclose int dfd
if eq tampered 0
ret false
end
gd_join_work gd_s_memot GP_A
gd_join_work gd_s_mutom GP_E
gd_join_work gd_s_null GP_D
gd_av_reset
gd_av_push_p GP_AEGIS
gd_av_push_txt gd_cmd_ver
gd_av_push_p GP_SRCP
gd_av_push_p GP_A
gd_av_push_p GP_E
tampered = gd_run_child GP_D 420
if ne tampered 120
ret false
end
gd_note_kill gd_k_18 tampered
ret true
end

fn gd_init_paths to bool
ac = argcnt
if eq ac 1
gd_cp_txt_p GP_AEGIS gd_def_aegis
gd_cp_txt_p GP_OMC gd_def_omc
gd_cp_txt_p GP_SRCP gd_def_src
gd_cp_txt_p GP_PROBE gd_def_probe
gd_cp_txt_p GP_WORK gd_def_work
ret true
end
if ne ac 6
ret false
end
l1 = gd_cp_arg_p 1 GP_AEGIS
l2 = gd_cp_arg_p 2 GP_OMC
l3 = gd_cp_arg_p 3 GP_SRCP
l4 = gd_cp_arg_p 4 GP_PROBE
l5 = gd_cp_arg_p 5 GP_WORK
if or eq l1 0 or eq l2 0 eq l3 0
ret false
end
ret and ne l4 0 ne l5 0
end

fn main to int
if not gd_init_paths
ret gd_fail gd_k_01 2
end
put gd_kills 0 0
lrc = makedir gd_ps gd_poff GP_WORK get gd_pl GP_WORK 493
gd_join_work gd_s_memo GP_A
lrc = makedir gd_ps gd_poff GP_A get gd_pl GP_A 493
gd_join_work gd_s_null GP_D
if not gd_write_txt GP_D gd_n_empty 420
ret gd_fail gd_k_01 3
end

note 1. Load source gb20b_om3_dma.om
lrc = gd_read_to_b GP_SRCP GB_SRC GD_MAX_SRC
if le lrc 0
ret gd_fail gd_k_01 4
end
put gd_srclen 0 ulong lrc

note 2. Positive Strand 5 admission: COLD_PROVED then MEMO_HIT -> bit-exact lowered om2
gd_join_work gd_s_cold GP_E
gd_join_work gd_s_hit GP_F
gd_av_reset
gd_av_push_p GP_AEGIS
gd_av_push_txt gd_cmd_ver
gd_av_push_p GP_SRCP
gd_av_push_p GP_A
gd_av_push_p GP_E
rc = gd_run_child GP_D 420
if or ne rc 0 not gd_buf_has GB_OUT get gd_outl 0 gd_pat_cold
ret gd_fail gd_pat_cold rc
end

gd_av_reset
gd_av_push_p GP_AEGIS
gd_av_push_txt gd_cmd_ver
gd_av_push_p GP_SRCP
gd_av_push_p GP_A
gd_av_push_p GP_F
rc = gd_run_child GP_D 420
if or ne rc 0 not gd_buf_has GB_OUT get gd_outl 0 gd_pat_hit
ret gd_fail gd_pat_hit rc
end
if not gd_files_equal GP_E GP_F
ret gd_fail gd_pat_hit 99
end

lrc = gd_read_to_b GP_E GB_LOW GD_MAX_SRC
if le lrc 0
ret gd_fail gd_pat_cold 98
end
put gd_lowlen 0 ulong lrc
if gd_buf_has GB_LOW get gd_lowlen 0 gd_pat_at
ret gd_fail gd_pat_at 97
end

note 3. Compile lowered om2 with pinned omc and execute natively
gd_join_work gd_s_cold GP_A
gd_join_work gd_s_bin GP_E
gd_av_reset
gd_av_push_p GP_OMC
rc = gd_run_child GP_A 493
if ne rc 0
ret gd_fail gd_pat_pass rc
end
if not gd_write_b GP_E GB_OUT get gd_outl 0 493
ret gd_fail gd_pat_pass 96
end
rc_ch = chmod gd_ps gd_poff GP_E get gd_pl GP_E 493
if ne rc_ch 0
ret gd_fail gd_pat_pass 95
end
gd_join_work gd_s_null GP_D
gd_av_reset
gd_av_push_p GP_E
rc = gd_run_child GP_D 420
if or ne rc 0 not gd_buf_has GB_OUT get gd_outl 0 gd_pat_pass
ret gd_fail gd_pat_pass rc
end

note 4. Run 18 surgical negative controls (OM-3 Aegis + lowered GB20B + OMEGA-MEMO tamper)
if not gd_kill_aegis gd_k_01 104 gd_n_unm
ret gd_fail gd_k_01 1
end
if not gd_kill_aegis gd_k_02 105 gd_n_tlb
ret gd_fail gd_k_02 1
end
if not gd_kill_aegis gd_k_03 106 gd_n_fnc
ret gd_fail gd_k_03 1
end
if not gd_kill_aegis gd_k_04 107 gd_n_rev
ret gd_fail gd_k_04 1
end
if or not gd_kill_aegis2 gd_k_05 gd_n_reg0 gd_n_slab not gd_run_aegis_neg gd_k_05 110
ret gd_fail gd_k_05 1
end
if or not gd_kill_aegis2 gd_k_06 gd_n_map0 gd_n_mapslab not gd_run_aegis_neg gd_k_06 110
ret gd_fail gd_k_06 1
end
if or not gd_kill_aegis2 gd_k_07 gd_n_reg0 gd_n_rmr0 not gd_run_aegis_neg gd_k_07 110
ret gd_fail gd_k_07 1
end
if or not gd_kill_aegis2 gd_k_08 gd_n_reg0 gd_n_rmr1 not gd_run_aegis_neg gd_k_08 110
ret gd_fail gd_k_08 1
end
if or not gd_kill_aegis2 gd_k_09 gd_n_raw_anchor gd_n_raw_inj not gd_run_aegis_neg gd_k_09 101
ret gd_fail gd_k_09 1
end
if or not gd_kill_aegis2 gd_k_10 gd_n_rcl gd_n_dbl not gd_run_aegis_neg gd_k_10 109
ret gd_fail gd_k_10 1
end
if not gd_kill_aegis gd_k_11 106 gd_n_rcl
ret gd_fail gd_k_11 1
end
if or not gd_kill_aegis2 gd_k_12 gd_n_cfg_if gd_n_cfg_rep not gd_run_aegis_neg gd_k_12 112
ret gd_fail gd_k_12 1
end
if or not gd_kill_aegis2 gd_k_13 gd_n_map1 gd_n_mapva not gd_run_aegis_neg gd_k_13 102
ret gd_fail gd_k_13 1
end
if not gd_run_rt_neg gd_k_14 gd_r_pcf17 gd_r_pcf16
ret gd_fail gd_k_14 1
end
if not gd_run_rt_neg gd_k_15 gd_r_msix9 gd_r_msix8
ret gd_fail gd_k_15 1
end
if not gd_run_rt_neg gd_k_16 gd_r_va2g gd_r_va0
ret gd_fail gd_k_16 1
end
if not gd_run_rt_neg gd_k_17 gd_r_sc1 gd_r_sc0
ret gd_fail gd_k_17 1
end
if not gd_tamper_memo_test
ret gd_fail gd_k_18 1
end

note 5. Hermetic positive and negative sysfs fixture checks for gb20b_vfio_probe
gd_join_work gd_vp_pass GP_G
if not gd_setup_vfio_tree GP_G false
ret gd_fail gd_vp_pass 1
end
gd_join_work gd_s_null GP_D
gd_av_reset
gd_av_push_p GP_PROBE
gd_av_push_txt gd_cmd_root
gd_av_push_p GP_G
rc = gd_run_child GP_D 420
if or ne rc 0 or not gd_buf_has GB_OUT get gd_outl 0 gd_pat_vpass not gd_buf_has GB_OUT get gd_outl 0 gd_pat_vblk
ret gd_fail gd_vp_pass rc
end

gd_join_work gd_vp_fail GP_G
if not gd_setup_vfio_tree GP_G true
ret gd_fail gd_vp_fail 1
end
gd_join_work gd_s_null GP_D
gd_av_reset
gd_av_push_p GP_PROBE
gd_av_push_txt gd_cmd_root
gd_av_push_p GP_G
rc = gd_run_child GP_D 420
if eq rc 0
ret gd_fail gd_vp_fail 99
end
gd_note_kill gd_vp_fail rc

gd_wrt 1 gd_m_ok
gd_num 1 get gd_kills 0
gd_wrt 1 gd_m_ok2
ret 0
end

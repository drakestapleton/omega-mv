note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note conform.om: host reference and bit-exact compare for the emit.om kernels (seeded Omega, AArch64).
note vadd uses hello_gpu's inputs and operation exactly (examples/hello_gpu/hello_gpu.c inputs/check):
note   a[i] = f32(i) * 0.25, b[i] = 1.0 / f32(1 + i % 7), c[i] = a[i] + b[i], n = 1048576 (N_TOTAL).
note vmul and vsub use the same inputs: c[i] = a[i] * b[i] and c[i] = a[i] - b[i].
note fsum16 is the frozen left-to-right row sum of 16 floats over 65536 rows; its inputs mix
note magnitudes (every fifth column scaled by 65536) so that a different summation order changes bits:
note   x[16r+k] = f32((31r + 17k) % 101) * 0.37 - 18.0, times 65536.0 when k % 5 == 0
note   o[r] = (((x[16r] + x[16r+1]) + x[16r+2]) ... ) + x[16r+15]
note rmsnorm is that same x, one row of 16 per work-item, 65536 rows (1048576 outputs, same length as vadd):
note   w[k] = f32(k + 1) * 0.5
note   ss = (((x0*x0 + x1*x1) + ...) + x15*x15)          left to right, one rounding each square and add
note   y[16r+k] = (x[16r+k] * (1 / fsqrt(ss * 0.0625 + 0.000001))) * w[k]
note 0.0625 is 1/16 and is exact. 0.000001f32 is bits 0x358637BD. The square root is fsqrt (IEEE sqrt)
note and the reciprocal is a separate div. No rsqrt, no fma. Tolerance is 0 ulp: a tree sum or a contracted
note multiply-add is a mismatch, which is why the sum-order mutant must not match.
note gemm16 is 4096 independent 16x16 f32 tiles (1048576 outputs, same length as vadd). One element:
note   tile = i / 256, rem = i % 256, row = rem / 16, col = rem % 16
note   A[tile,row,k] = f32((31*row + 17*k + tile) % 101) * 0.37 - 18, times 65536 when k % 5 == 0
note   B[tile,k,col] = f32((13*k + 7*col + 3*tile) % 89) * 0.25 - 4
note   C = 0; for k from 0 to 15: C = C + (A * B) with a separate mul then add, left to right, 0 ulp.
note A reversed k order or a fused multiply-add is a different bit pattern. No OpFma.
note Every operation is one IEEE binary32 operation rounded to nearest (omc f32, OMEGESE 9.9), so the
note reference is the exact bit pattern a conforming FP32 device must produce for these kernels.
note
note Usage:
note   conform in vadd|vmul|vsub|vmax A.bin B.bin       write the two vadd inputs (little-endian binary32)
note   conform in fsum16 X.bin           write the fsum16 input
note   conform in rmsnorm X.bin W.bin    write the rmsnorm input and the 16 weights
note   conform in gemm16 A.bin B.bin    write the two gemm16 tiles
note   conform ref vadd|vmul|vsub|vmax|fsum16|rmsnorm|gemm16 OUT.bin   write the reference output
note   conform check vadd|vmul|vsub|vmax|fsum16|rmsnorm|gemm16 OUT.bin compare OUT.bin with the reference bit for bit
note check prints one line: CONFORM <kernel> n=<n> wrong=<w> unwritten=<u> first=<index or none>
note Loops run in blocks of 4096 because a for count above 1000000 traps 4 (OMEGESE 9.1).
note (unwritten counts the launcher's poison 0xFFC0FFEE). Exit: 0 every element equal; 1 a mismatch;
note 2 usage; 3 I/O or wrong file size. Traps exit 100 + code.
om2

text tuse "usage: conform in vadd A B | in fsum16 X | in rmsnorm X W | in gemm16 A B | ref K OUT | check K OUT\n"
text tio "conform: I/O error or wrong file size\n"
text tin "in"
text tref "ref"
text tchk "check"
text tvadd "vadd"
text tfsum "fsum16"
text tvmul "vmul"
text tvsub "vsub"
text tvmax "vmax"
text trms "rmsnorm"
text tgemm "gemm16"
text tcf "CONFORM "
text tn " n="
text twr " wrong="
text tun " unwritten="
text tfi " first="
text tnone "none"
text tsha " sha256="
text thex "0123456789abcdef"
text tnl "\n"

const NVADD ulong 1048576
const NROWS ulong 65536
const POISON uint 4290838510

global gio uchar 4194304
global gpath uchar 4096
global garg uchar 16
global gob uchar 256
global gsh uint 8
global gsw uint 64
global gsk uint 64
global gsb uchar 64
note gst: 0 kernel (0 vadd, 1 fsum16, 2 vmul, 3 vsub, 4 vmax, 5 rmsnorm, 6 gemm16), 1 output fill
global gst ulong 4

fn fail code int msg view uchar * to void
n = write 2 msg 0 len msg
exit code
end

fn argis i ulong t view uchar * to bool
n = argread i garg 0 len garg
if ne n long len t
ret false
end
for k ulong len t
if ne get garg k get t k
ret false
end
end
ret true
end

fn oc b uchar to void
f = get gst 1
put gob f b
put gst 1 add f 1
end

fn ot t view uchar * to void
for i ulong len t
oc get t i
end
end

fn odec v ulong to void
d = new uchar 20 0
k = ulong 0
x = v
while true bound 21
put d k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
for i ulong k
oc get d sub sub k i 1
end
end

fn skinit to void
put gsk 0 0x428a2f98
put gsk 1 0x71374491
put gsk 2 0xb5c0fbcf
put gsk 3 0xe9b5dba5
put gsk 4 0x3956c25b
put gsk 5 0x59f111f1
put gsk 6 0x923f82a4
put gsk 7 0xab1c5ed5
put gsk 8 0xd807aa98
put gsk 9 0x12835b01
put gsk 10 0x243185be
put gsk 11 0x550c7dc3
put gsk 12 0x72be5d74
put gsk 13 0x80deb1fe
put gsk 14 0x9bdc06a7
put gsk 15 0xc19bf174
put gsk 16 0xe49b69c1
put gsk 17 0xefbe4786
put gsk 18 0x0fc19dc6
put gsk 19 0x240ca1cc
put gsk 20 0x2de92c6f
put gsk 21 0x4a7484aa
put gsk 22 0x5cb0a9dc
put gsk 23 0x76f988da
put gsk 24 0x983e5152
put gsk 25 0xa831c66d
put gsk 26 0xb00327c8
put gsk 27 0xbf597fc7
put gsk 28 0xc6e00bf3
put gsk 29 0xd5a79147
put gsk 30 0x06ca6351
put gsk 31 0x14292967
put gsk 32 0x27b70a85
put gsk 33 0x2e1b2138
put gsk 34 0x4d2c6dfc
put gsk 35 0x53380d13
put gsk 36 0x650a7354
put gsk 37 0x766a0abb
put gsk 38 0x81c2c92e
put gsk 39 0x92722c85
put gsk 40 0xa2bfe8a1
put gsk 41 0xa81a664b
put gsk 42 0xc24b8b70
put gsk 43 0xc76c51a3
put gsk 44 0xd192e819
put gsk 45 0xd6990624
put gsk 46 0xf40e3585
put gsk 47 0x106aa070
put gsk 48 0x19a4c116
put gsk 49 0x1e376c08
put gsk 50 0x2748774c
put gsk 51 0x34b0bcb5
put gsk 52 0x391c0cb3
put gsk 53 0x4ed8aa4a
put gsk 54 0x5b9cca4f
put gsk 55 0x682e6ff3
put gsk 56 0x748f82ee
put gsk 57 0x78a5636f
put gsk 58 0x84c87814
put gsk 59 0x8cc70208
put gsk 60 0x90befffa
put gsk 61 0xa4506ceb
put gsk 62 0xbef9a3f7
put gsk 63 0xc67178f2
put gsh 0 0x6a09e667
put gsh 1 0xbb67ae85
put gsh 2 0x3c6ef372
put gsh 3 0xa54ff53a
put gsh 4 0x510e527f
put gsh 5 0x9b05688c
put gsh 6 0x1f83d9ab
put gsh 7 0x5be0cd19
end

fn sch e uint f uint g uint to uint
ret xor and e f and xor e 0xffffffff g
end

fn smaj a uint b uint c uint to uint
ret xor xor and a b and a c and b c
end

fn sbs0 x uint to uint
ret xor xor rotr x 2 rotr x 13 rotr x 22
end

fn sbs1 x uint to uint
ret xor xor rotr x 6 rotr x 11 rotr x 25
end

fn sss0 x uint to uint
ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn sss1 x uint to uint
ret xor xor rotr x 17 rotr x 19 shr x 10
end

fn sblk_sched to void
for i ulong 16
v = uint 0
for j ulong 4
v = or shl v 8 uint get gsb add mul i 4 j
end
put gsw i v
end
for i ulong 48
j = add i 16
v = add sss1 get gsw sub j 2 get gsw sub j 7
v = add v add sss0 get gsw sub j 15 get gsw sub j 16
put gsw j v
end
end

fn sblk_comp to void
sblk_sched
a = get gsh 0
b = get gsh 1
c = get gsh 2
d = get gsh 3
e = get gsh 4
f = get gsh 5
g = get gsh 6
hh = get gsh 7
for i ulong 64
x = sch e f g
x = add x get gsk i
x = add x get gsw i
x = add x sbs1 e
x = add x hh
t1 = x
x = smaj a b c
x = add sbs0 a x
hh = g
g = f
f = e
e = add d t1
d = c
c = b
b = a
a = add t1 x
end
put gsh 0 add get gsh 0 a
put gsh 1 add get gsh 1 b
put gsh 2 add get gsh 2 c
put gsh 3 add get gsh 3 d
put gsh 4 add get gsh 4 e
put gsh 5 add get gsh 5 f
put gsh 6 add get gsh 6 g
put gsh 7 add get gsh 7 hh
end

fn osha_blk base ulong to void
for k ulong 64
put gsb k get gio add base k
end
sblk_comp
end

fn osha_hex to void
ot tsha
for i ulong 8
v = get gsh i
for j ulong 8
sh = mul uint sub 7 j 4
nib = and shr v sh 15
oc get thex ulong nib
end
end
end

fn osha nb ulong to void
skinit
full = div nb 64
pos = ulong 0
while lt pos full bound 20
step = sub full pos
if gt step 4096
step = 4096
end
for l ulong step
osha_blk mul add pos l 64
end
pos = add pos step
end
left = rem nb 64
for k ulong 64
put gsb k 0
end
for k ulong left
put gsb k get gio add mul full 64 k
end
put gsb left 128
if ge left 56
sblk_comp
for k ulong 64
put gsb k 0
end
end
bits = mul nb 8
for k ulong 8
sh = mul sub 7 k 8
put gsb add 56 k uchar and shr bits sh 255
end
sblk_comp
osha_hex
end

fn oflush to void
n = write 1 gob 0 get gst 1
put gst 1 0
end

fn va i ulong to f32
ret mul f32 i 0.25f32
end

fn vb i ulong to f32
ret div 1.0f32 f32 add 1 rem i 7
end

fn vx i ulong to f32
r = div i 16
k = rem i 16
v = sub mul f32 rem add mul r 31 mul k 17 101 0.37f32 18.0f32
if eq rem k 5 0
v = mul v 65536.0f32
end
ret v
end

fn rsum r ulong to f32
b = mul r 16
acc = vx b
for k ulong 15
acc = add acc vx add b add k 1
end
ret acc
end

fn count to ulong
if ne get gst 0 1
ret NVADD
end
ret NROWS
end

fn refv i ulong to f32
if eq get gst 0 0
ret add va i vb i
end
if eq get gst 0 2
ret mul va i vb i
end
if eq get gst 0 3
ret sub va i vb i
end
if eq get gst 0 4
x = va i
y = vb i
if gt x y
ret x
end
ret y
end
if eq get gst 0 5
ret rmsat i
end
if eq get gst 0 6
ret gcref i
end
ret rsum i
end

fn ga t ulong i ulong k ulong to f32
v = sub mul f32 rem add add mul i 31 mul k 17 t 101 0.37f32 18.0f32
if eq rem k 5 0
v = mul v 65536.0f32
end
ret v
end

fn gb t ulong k ulong j ulong to f32
ret sub mul f32 rem add add mul k 13 mul j 7 mul t 3 89 0.25f32 4.0f32
end

fn gdot t ulong i ulong j ulong to f32
acc = 0.0f32
for k ulong 16
a = ga t i k
b = gb t k j
acc = add acc mul a b
end
ret acc
end

fn gcref i ulong to f32
t = div i 256
rm = rem i 256
ret gdot t div rm 16 rem rm 16
end

fn ww k ulong to f32
ret mul f32 add k 1 0.5f32
end

fn ssq r ulong to f32
b = mul r 16
v = vx b
acc = mul v v
for k ulong 15
v = vx add b add k 1
acc = add acc mul v v
end
ret acc
end

fn rscale r ulong to f32
acc = mul ssq r 0.0625f32
ret div 1.0f32 fsqrt add acc 0.000001f32
end

fn rmsat i ulong to f32
r = div i 16
k = rem i 16
ret mul mul vx i rscale r ww k
end

fn putu i ulong v uint to void
o = mul i 4
for k ulong 4
put gio add o k uchar and shr v mul uint k 8 255
end
end

fn getu i ulong to uint
o = mul i 4
v = uint 0
for k ulong 4
v = or v shl uint get gio add o k mul uint k 8
end
ret v
end

fn wfile ai ulong nb ulong to void
n = argread ai gpath 0 len gpath
if le n 0
fail 2 tuse
end
fd = fopen gpath 0 ulong n 577 420
if lt fd 0
fail 3 tio
end
r = write int fd gio 0 nb
if ne r long nb
fail 3 tio
end
c = fclose int fd
end

fn rfile ai ulong nb ulong to void
n = argread ai gpath 0 len gpath
if le n 0
fail 2 tuse
end
fd = fopen gpath 0 ulong n 0 0
if lt fd 0
fail 3 tio
end
sz = fseek int fd 0 2
if ne sz long nb
fail 3 tio
end
r = pread int fd gio 0 nb 0
if ne r long nb
fail 3 tio
end
c = fclose int fd
end

fn kind ai ulong to void
put gst 0 9
if argis ai tvadd
put gst 0 0
end
if argis ai tfsum
put gst 0 1
end
if argis ai tvmul
put gst 0 2
end
if argis ai tvsub
put gst 0 3
end
if argis ai tvmax
put gst 0 4
end
if argis ai trms
put gst 0 5
end
if argis ai tgemm
put gst 0 6
end
if eq get gst 0 9
fail 2 tuse
end
end

fn doin to void
ac = argcnt
if eq get gst 0 6
if ne ac 5
fail 2 tuse
end
for h ulong div NVADD 4096
for l ulong 4096
i = add mul h 4096 l
t = div i 256
rm = rem i 256
row = div rm 16
col = rem rm 16
putu i bitcast uint ga t row col
end
end
wfile 3 mul NVADD 4
for h ulong div NVADD 4096
for l ulong 4096
i = add mul h 4096 l
t = div i 256
rm = rem i 256
row = div rm 16
col = rem rm 16
putu i bitcast uint gb t row col
end
end
wfile 4 mul NVADD 4
ret
end
if eq get gst 0 5
if ne ac 5
fail 2 tuse
end
for h ulong div NVADD 4096
for l ulong 4096
i = add mul h 4096 l
putu i bitcast uint vx i
end
end
wfile 3 mul NVADD 4
for k ulong 16
putu k bitcast uint ww k
end
wfile 4 64
ret
end
if ne get gst 0 1
if ne ac 5
fail 2 tuse
end
for h ulong div NVADD 4096
for l ulong 4096
i = add mul h 4096 l
putu i bitcast uint va i
end
end
wfile 3 mul NVADD 4
for h ulong div NVADD 4096
for l ulong 4096
i = add mul h 4096 l
putu i bitcast uint vb i
end
end
wfile 4 mul NVADD 4
ret
end
if ne ac 4
fail 2 tuse
end
n = mul NROWS 16
for h ulong div n 4096
for l ulong 4096
i = add mul h 4096 l
putu i bitcast uint vx i
end
end
wfile 3 mul n 4
end

fn doref to void
n = count
for h ulong div n 4096
for l ulong 4096
i = add mul h 4096 l
putu i bitcast uint refv i
end
end
wfile 3 mul n 4
end

fn docheck to int
n = count
rfile 3 mul n 4
wr = ulong 0
un = ulong 0
fi = ulong 0
for h ulong div n 4096
for l ulong 4096
i = add mul h 4096 l
g = getu i
if eq g POISON
un = add un 1
end
if ne g bitcast uint refv i
if eq wr 0
fi = i
end
wr = add wr 1
end
end
end
ot tcf
if eq get gst 0 0
ot tvadd
end
if eq get gst 0 1
ot tfsum
end
if eq get gst 0 2
ot tvmul
end
if eq get gst 0 3
ot tvsub
end
if eq get gst 0 4
ot tvmax
end
if eq get gst 0 5
ot trms
end
if eq get gst 0 6
ot tgemm
end
ot tn
odec n
ot twr
odec wr
ot tun
odec un
ot tfi
if eq wr 0
ot tnone
end
if gt wr 0
odec fi
end
osha mul n 4
ot tnl
oflush
if gt wr 0
ret 1
end
ret 0
end

fn main to int
ac = argcnt
if lt ac 4
fail 2 tuse
end
kind 2
if argis 1 tin
doin
ret 0
end
if ne ac 4
fail 2 tuse
end
if argis 1 tref
doref
ret 0
end
if argis 1 tchk
ret docheck
end
fail 2 tuse
ret 2
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note cpu.om: hwman unit 2, the NATIVE_ISA CPU runner (runner hwman-cpu). The operations execute as
note AArch64 instructions emitted by omc in this process; identity comes from the kernel's view of the
note core this process is pinned to:
note   /proc/self/status  Cpus_allowed_list must name exactly one CPU (taskset -c N), else refused
note   /proc/self/stat    field 39 (processor, proc(5)) must equal that CPU
note   NODE/cpuN/regs/identification/midr_el1  (Linux Documentation/arch/arm64/cpu-feature-registers.rst)
note Operations (fixed definitions; their oracle is computed independently, never by this program):
note   sumsq64 N  sum of i*i for 0 <= i < N, modulo 2^64
note   fnv1a64 N  FNV-1a 64-bit over the N bytes b_i = i mod 251 (offset basis 0xcbf29ce484222325,
note              prime 0x100000001b3)
note N must be 1..16777216 (2^24); loops run in blocks of 4096 (a for count above 1000000 traps 4).

text CPUSTS "/proc/self/status"
text CPUSTAT "/proc/self/stat"
text CPUALLOW "Cpus_allowed_list:"
text CPUDIR "/cpu"
text CPUMIDR "/regs/identification/midr_el1"
text CPUSUMSQ "sumsq64"
text CPUFNV "fnv1a64"
const CPUMAXN ulong 16777216

note the single CPU in Cpus_allowed_list, or -1 when not pinned to exactly one CPU, or -errno
fn cpupin to long
pclear
pt CPUSTS
r = readpath
if lt r 0
ret r
end
n = get gst 7
k = len CPUALLOW
i = ulong 0
while true bound 65536
if gt add i k n
ret -1
end
hit = true
for j ulong k
if ne get gfile add i j get CPUALLOW j
hit = false
end
end
if hit
break
end
i = add i 1
end
i = add i k
while true bound 64
if ge i n
ret -1
end
c = get gfile i
if or eq c 9 eq c 32
i = add i 1
else
break
end
end
v = ulong 0
d = ulong 0
while true bound 16
if ge i n
ret -1
end
c = get gfile i
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
d = add d 1
i = add i 1
end
if or eq d 0 ge i n
ret -1
end
if ne get gfile i 10
ret -1
end
ret long v
end

note field 39 (processor) of /proc/self/stat: the CPU this process last ran on, or a negative value
fn cpucur to long
pclear
pt CPUSTAT
r = readpath
if lt r 0
ret r
end
n = get gst 7
e = ulong 0
found = false
for i ulong n
if eq get gfile i 41
e = i
found = true
end
end
if not found
ret -1
end
note after ") " the next token is field 3; field 39 is token 36 counted from 0
i = add e 2
tok = ulong 0
while true bound 4096
if ge i n
ret -1
end
if eq tok 36
break
end
if eq get gfile i 32
tok = add tok 1
end
i = add i 1
end
v = ulong 0
d = ulong 0
while true bound 16
if ge i n
break
end
c = get gfile i
if or lt c 48 gt c 57
break
end
v = add mul v 10 ulong sub c 48
d = add d 1
i = add i 1
end
if eq d 0
ret -1
end
ret long v
end

note MIDR_EL1 of CPU cpu read below the node directory of the current row; -errno or -1 on a bad file
fn cpumidr cpu ulong to long
pclear
pfield CNODE
pt CPUDIR
pdec cpu
pt CPUMIDR
r = readpath
if lt r 0
ret r
end
ret hexat 0 get gst 7
end

note sum of i*i for 0 <= i < n, modulo 2^64
fn cpusumsq n ulong to ulong
acc = ulong 0
i = ulong 0
for b ulong 4097
if ge i n
break
end
for j ulong 4096
if ge i n
break
end
acc = add acc mul i i
i = add i 1
end
end
ret acc
end

fn cpufnv n ulong to ulong
h = ulong 0xcbf29ce484222325
i = ulong 0
for b ulong 4097
if ge i n
break
end
for j ulong 4096
if ge i n
break
end
h = mul xor h rem i 251 0x100000001b3
i = add i 1
end
end
ret h
end

note run operation argument a on n; sets gst 9 to 1 when the operation is unknown to this runner
fn cpuop a ulong n ulong to ulong
put gst 9 0
if argeq a CPUSUMSQ
ret cpusumsq n
end
if argeq a CPUFNV
ret cpufnv n
end
put gst 9 1
ret 0
end

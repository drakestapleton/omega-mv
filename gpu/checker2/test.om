note SPDX-License-Identifier: Apache-2.0
note gpu/checker2/test.om: comprehensive positive & negative-control test suite for checker2 LRAT & DIMACS CNF.
note Tests: valid UNSAT proofs (pigeonhole PHP(2,1), multi-step RUP with deletions, tautology, trailing hints,
note comments/whitespace) AND all 13 fail-closed refusal rules (CNF-HEADER, CNF-LITERAL, CNF-COUNT,
note LRAT-SYNTAX, LRAT-DELETE-UNKNOWN, LRAT-ID-ORDER, LRAT-ID-RANGE, LRAT-LITERAL, LRAT-RAT-UNSUPPORTED,
note LRAT-HINT-UNKNOWN, LRAT-HINT-NOT-UNIT, LRAT-NO-CONFLICT, LRAT-NO-EMPTY-CLAUSE).
note Compose: si/directives/om2.om gpu/checker2/lrat.om gpu/checker2/test.om

text t_ok1 "PASS valid UNSAT LRAT proofs (3-var chain, deletions, tautology, trailing hints, comments)\n"
text t_ok2 "PASS DIMACS CNF fail-closed refusals (HEADER, LITERAL, COUNT)\n"
text t_ok3 "PASS LRAT fail-closed refusals (SYNTAX, DELETE-UNKNOWN, ID-ORDER, ID-RANGE, LITERAL)\n"
text t_ok4 "PASS LRAT RUP trust-boundary refusals (RAT-UNSUPPORTED, HINT-UNKNOWN, HINT-NOT-UNIT, NO-CONFLICT, NO-EMPTY-CLAUSE)\n"
text t_all "ALL PASS gpu-checker2-lrat\n"
text t_fail "FAIL gpu-checker2-lrat\n"

note ---- Positive test fixtures ----

note CNF 1: (1 2) (-1 2) (1 -2) (-1 -2) -- classic 2-variable UNSAT with comments
text cnf_unsat2 "c 2-var unsat formula\np cnf 2 4\n1 2 0\n-1 2 0\n1 -2 0\n-1 -2 0\n"
note LRAT 1: derive (2) via 1 2, delete 1 2, derive () via 5 3 4
text lrat_unsat2 "5 2 0 1 2 0\n5 d 1 2 0\n6 0 5 3 4 0\n"

note CNF 2: 3-var implication chain UNSAT: (1) (-1 2) (-2 3) (-3)
text cnf_chain3 "p cnf 3 4\n1 0\n-1 2 0\n-2 3 0\n-3 0\n"
note LRAT 2: includes a tautology clause (1 -1), trailing hint after conflict, and empty clause
text lrat_chain3 "5 1 -1 0 1 0\n6 2 0 1 2 0\n7 0 6 3 4 1 0\n"

note CNF 3: Pigeonhole PHP(2,1) -- 3 pigeons (vars 1,2,3) in 2 holes? No, 2 pigeons in 1 hole: (1) (2) (-1 -2)
text cnf_php21 "c PHP(2,1)\np cnf 2 3\n1 0\n2 0\n-1 -2 0\n"
text lrat_php21 "4 0 1 2 3 0\n"

note ---- Negative control fixtures ----

text cnf_bad_hdr "p sat 2 2\n1 0\n-1 0\n"
text cnf_bad_lit "p cnf 2 1\n3 0\n"
text cnf_bad_cnt "p cnf 2 3\n1 0\n-1 0\n"
text cnf_bad_trail "p cnf 2 1\n1 0\n2\n"

text lrat_bad_syntax "5 2 0 1\n"
text lrat_del_unk "5 d 99 0\n"
text lrat_del_twice "5 d 1 0\n6 d 1 0\n"
text lrat_id_order "4 2 0 1 2 0\n"
text lrat_id_range "500 2 0 1 2 0\n"
text lrat_bad_lit "5 9 0 1 2 0\n"
text lrat_rat_neg "5 2 0 -1 2 0\n"
text lrat_hint_unk "5 2 0 99 0\n"
text lrat_hint_del "5 d 1 0\n6 2 0 1 2 0\n"
text lrat_not_unit "5 0 1 2 0\n"
text lrat_no_conf "5 2 0 1 0\n"
text lrat_no_empty "5 2 0 1 2 0\n"

fn c2_puts s view uchar * to void
k = write 1 s 0 len s
if lt k 0
exit 2
end
ret
end

fn test_valid_proofs to int
res = new C2LratRes 0 0 0 0 0
note 1. 2-var UNSAT with deletion
if ne c2_cnf_parse cnf_unsat2 C2_OK
ret 1
end
if ne c2_lrat_check lrat_unsat2 edit res C2_OK
ret 2
end
if ne get res ok 1
ret 3
end
if ne get res steps 2
ret 4
end
if ne get res dels 2
ret 5
end
note 2. 3-var chain with tautology & trailing hint after conflict
if ne c2_cnf_parse cnf_chain3 C2_OK
ret 6
end
if ne c2_lrat_check lrat_chain3 edit res C2_OK
ret 7
end
if ne get res ok 1
ret 8
end
if ne get res steps 3
ret 9
end
note 3. PHP(2,1) direct RUP
if ne c2_cnf_parse cnf_php21 C2_OK
ret 10
end
if ne c2_lrat_check lrat_php21 edit res C2_OK
ret 11
end
if ne get res steps 1
ret 12
end
ret 0
end

fn test_cnf_refusals to int
if ne c2_cnf_parse cnf_bad_hdr C2_E_CNF_HEADER
ret 20
end
if ne c2_cnf_parse cnf_bad_lit C2_E_CNF_LITERAL
ret 21
end
if ne c2_cnf_parse cnf_bad_cnt C2_E_CNF_COUNT
ret 22
end
if ne c2_cnf_parse cnf_bad_trail C2_E_CNF_COUNT
ret 23
end
ret 0
end

fn test_lrat_structural_refusals to int
res = new C2LratRes 0 0 0 0 0
if ne c2_cnf_parse cnf_unsat2 C2_OK
ret 30
end
if ne c2_lrat_check lrat_bad_syntax edit res C2_E_LRAT_SYNTAX
ret 31
end
if ne c2_lrat_check lrat_del_unk edit res C2_E_LRAT_DELETE_UNKNOWN
ret 32
end
if ne c2_lrat_check lrat_del_twice edit res C2_E_LRAT_DELETE_UNKNOWN
ret 33
end
if ne c2_lrat_check lrat_id_order edit res C2_E_LRAT_ID_ORDER
ret 34
end
if ne c2_lrat_check lrat_id_range edit res C2_E_LRAT_ID_RANGE
ret 35
end
if ne c2_lrat_check lrat_bad_lit edit res C2_E_LRAT_LITERAL
ret 36
end
ret 0
end

fn test_lrat_rup_refusals to int
res = new C2LratRes 0 0 0 0 0
if ne c2_cnf_parse cnf_unsat2 C2_OK
ret 40
end
note Negative hint (RAT step) must be refused outright
if ne c2_lrat_check lrat_rat_neg edit res C2_E_LRAT_RAT_UNSUPPORTED
ret 41
end
if ne get res ok 0
ret 42
end
if ne c2_lrat_check lrat_hint_unk edit res C2_E_LRAT_HINT_UNKNOWN
ret 43
end
note Hint referencing a deleted clause must be refused
if ne c2_lrat_check lrat_hint_del edit res C2_E_LRAT_HINT_UNKNOWN
ret 44
end
note Non-unit hint (clause 1 has 2 unassigned literals when deriving empty clause)
if ne c2_lrat_check lrat_not_unit edit res C2_E_LRAT_HINT_NOT_UNIT
ret 45
end
note Hints finish without conflict
if ne c2_lrat_check lrat_no_conf edit res C2_E_LRAT_NO_CONFLICT
ret 46
end
note Valid step but never derives empty clause
if ne c2_lrat_check lrat_no_empty edit res C2_E_LRAT_NO_EMPTY_CLAUSE
ret 47
end
ret 0
end

fn main to int
rc = test_valid_proofs
if ne rc 0
c2_puts t_fail
ret rc
end
c2_puts t_ok1

rc = test_cnf_refusals
if ne rc 0
c2_puts t_fail
ret rc
end
c2_puts t_ok2

rc = test_lrat_structural_refusals
if ne rc 0
c2_puts t_fail
ret rc
end
c2_puts t_ok3

rc = test_lrat_rup_refusals
if ne rc 0
c2_puts t_fail
ret rc
end
c2_puts t_ok4

c2_puts t_all
ret 0
end

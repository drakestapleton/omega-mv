om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/qual/non_nvidia_qual.om: pure-Omega non-NVIDIA physical GPU discovery & qualification runner.
note Compiles for BOTH AArch64 Linux and target x86linux (prefix 'target x86linux' before om2).
note Compose after seed/ng/sha256.om:
note   { printf 'om2\n'; cat seed/ng/sha256.om gpu/qual/non_nvidia_qual.om | grep -v '^om2$'; } | seed/out/omc > non_nvidia_qual
note
note Usage:
note   non_nvidia_qual [--root DIR]
note
note Scans PCI devices (<root>/sys/bus/pci/devices), AMD KFD (<root>/dev/kfd),
note DRM render nodes (<root>/dev/dri/renderD128), and OpenCL/Vulkan ICD directories to verify
note physical non-NVIDIA GPU attachment (AMD 0x1002, Intel 0x8086, Apple/other non-0x10de).
note Never mislabels NVIDIA-only or CPU-only hosts as non-NVIDIA GPU qualification!
note
note Exit codes:
note   0  PHYSICAL_NON_NVIDIA_DETECTED (AMD KFD and/or Intel Xe / non-NVIDIA DRM render node ready)
note   2  usage error
note   3  BLOCKED_HARDWARE (no physical non-NVIDIA GPU attached on this host)

text nq_froot "--root"
text nq_ppci "/sys/bus/pci/devices"
text nq_pven "/vendor"
text nq_pdev "/device"
text nq_pcls "/class"
text nq_pkfd "/dev/kfd"
text nq_pdri "/dev/dri/renderD128"
text nq_pocl "/etc/OpenCL/vendors"
text nq_hdr "OMEGA-NON-NVIDIA-GPU-QUAL v1\n"
text nq_amd "GPU_AMD_PCI count="
text nq_int "GPU_INTEL_PCI count="
text nq_nv "GPU_NVIDIA_PCI count="
text nq_kfd "DEV_KFD="
text nq_dri "DEV_DRI_RENDERD128="
text nq_ocl "OPENCL_ICD_DIR="
text nq_yes "present\n"
text nq_no "absent\n"
text nq_ready "VERDICT=NON_NVIDIA_HARDWARE_PRESENT (run vendor hardware gate: gpu/amd or gpu/intel or gpu/spirv)\n"
text nq_blk "VERDICT=BLOCKED_HARDWARE reason=no_physical_non_nvidia_gpu_attached\n"
text nq_use "usage: non_nvidia_qual [--root DIR]\n"

global nq_root uchar 2048
global nq_rlen ulong 1
global nq_path uchar 4096
global nq_tmp uchar 4096
global nq_dents uchar 16384
global nq_cnt ulong 8
global nq_num uchar 24

fn nq_wnum v ulong to void
n = ulong 0
x = v
while true bound 20
put nq_num sub 23 n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
r = write 1 nq_num sub 24 n n
nl = new uchar 1 10
r = write 1 nl 0 1
end

fn nq_mkpath suffix view uchar * to ulong
rl = get nq_rlen 0
for i ulong rl bound 2048
put nq_path i get nq_root i
end
for i ulong len suffix bound 2048
put nq_path add rl i get suffix i
end
ret add rl len suffix
end

fn nq_readhex plen ulong to ulong
fd = fopen nq_path 0 plen 0 0
if lt fd 0
ret 0
end
got = read int fd nq_tmp 0 64
r = fclose int fd
if le got 0
ret 0
end
p = ulong 0
if ge got 2
if and eq get nq_tmp 0 48 or eq get nq_tmp 1 120 eq get nq_tmp 1 88
p = ulong 2
end
end
v = ulong 0
while lt p ulong got bound 32
c = ulong get nq_tmp p
if and ge c 48 le c 57
v = add mul v 16 sub c 48
else
if and ge c 97 le c 102
v = add mul v 16 add 10 sub c 97
else
if and ge c 65 le c 70
v = add mul v 16 add 10 sub c 65
else
break
end
end
end
p = add p 1
end
ret v
end

global nq_bdf uchar 64

fn nq_check_bdf nl ulong to void
if eq nl 0
ret
end
if and eq nl 1 eq get nq_bdf 0 46
ret
end
if and eq nl 2 and eq get nq_bdf 0 46 eq get nq_bdf 1 46
ret
end
bp = nq_mkpath nq_ppci
put nq_path bp 47
bp = add bp 1
for k ulong nl bound 64
put nq_path add bp k get nq_bdf k
end
bp = add bp nl
for k ulong len nq_pcls
put nq_path add bp k get nq_pcls k
end
cls = nq_readhex add bp len nq_pcls
basecls = shr cls 16
if ne basecls 3
ret
end
for k ulong len nq_pven
put nq_path add bp k get nq_pven k
end
ven = nq_readhex add bp len nq_pven
if eq ven 4098
put nq_cnt 0 add get nq_cnt 0 1
ret
end
if eq ven 32902
put nq_cnt 1 add get nq_cnt 1 1
ret
end
if eq ven 4318
put nq_cnt 2 add get nq_cnt 2 1
end
end

fn nq_scan_pci to void
plen = nq_mkpath nq_ppci
fd = fopen nq_path 0 plen 0 0
if lt fd 0
ret
end
while true bound 256
got = getdnts int fd nq_dents 0 16384
if le got 0
break
end
pos = ulong 0
while lt pos ulong got bound 1024
reclen = or ulong get nq_dents add pos 16 shl ulong get nq_dents add pos 17 8
if eq reclen 0
break
end
ns = add pos 19
nl = ulong 0
while lt add ns nl add pos reclen bound 64
b = get nq_dents add ns nl
if eq b 0
break
end
put nq_bdf nl b
nl = add nl 1
end
nq_check_bdf nl
pos = add pos reclen
end
end
r = fclose int fd
end

fn main to int
ac = argcnt
if eq ac 3
n1 = argread 1 nq_tmp 0 64
if ne n1 long len nq_froot
r = write 2 nq_use 0 len nq_use
ret 2
end
for i ulong len nq_froot
if ne get nq_tmp i get nq_froot i
r = write 2 nq_use 0 len nq_use
ret 2
end
end
n2 = argread 2 nq_root 0 2048
if lt n2 0
r = write 2 nq_use 0 len nq_use
ret 2
end
put nq_rlen 0 ulong n2
else
if ne ac 1
r = write 2 nq_use 0 len nq_use
ret 2
end
put nq_rlen 0 0
end

nq_scan_pci
has_kfd = eq faccess nq_path 0 nq_mkpath nq_pkfd 0 0
has_dri = eq faccess nq_path 0 nq_mkpath nq_pdri 0 0
has_ocl = eq faccess nq_path 0 nq_mkpath nq_pocl 0 0

r = write 1 nq_hdr 0 len nq_hdr
r = write 1 nq_amd 0 len nq_amd
nq_wnum get nq_cnt 0
r = write 1 nq_int 0 len nq_int
nq_wnum get nq_cnt 1
r = write 1 nq_nv 0 len nq_nv
nq_wnum get nq_cnt 2
r = write 1 nq_kfd 0 len nq_kfd
if has_kfd
r = write 1 nq_yes 0 len nq_yes
else
r = write 1 nq_no 0 len nq_no
end
r = write 1 nq_dri 0 len nq_dri
if has_dri
r = write 1 nq_yes 0 len nq_yes
else
r = write 1 nq_no 0 len nq_no
end
r = write 1 nq_ocl 0 len nq_ocl
if has_ocl
r = write 1 nq_yes 0 len nq_yes
else
r = write 1 nq_no 0 len nq_no
end

amd_ready = and gt get nq_cnt 0 0 has_kfd
intel_ready = and gt get nq_cnt 1 0 has_dri
if or amd_ready intel_ready
r = write 1 nq_ready 0 len nq_ready
ret 0
end
r = write 1 nq_blk 0 len nq_blk
ret 3
end

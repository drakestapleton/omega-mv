om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/qual/qual_test.om: pure-Omega host test for non-NVIDIA GPU & x86 qualification classification.
note Verifies synthetic PCI vendor/class/node classification:
note   1. AMD MI300X (0x1002:0x74a1, class 0x038000, /dev/kfd present) -> READY
note   2. Intel Xe3 Panther Lake (0x8086:0xb080, class 0x030000, /dev/dri/renderD128 present) -> READY
note   3. NVIDIA-only GB10 (0x10de:0x2e12, class 0x030000, no AMD/Intel) -> BLOCKED_HARDWARE
note   4. Non-display PCI device (0x8086, class 0x060000 host bridge) -> ignored (BLOCKED_HARDWARE)
note   5. Emulated x86-64 on AArch64 kernel -> EMULATED (BLOCKED_HARDWARE), physical x86_64 -> PHYSICAL

text qt_pass "PASS gpu/qual classification and negative controls (hardware=NOT_RUN)\n"
text qt_fail "FAIL gpu/qual\n"

fn qt_non_nvidia_verdict pci_cls ulong ven ulong has_kfd bool has_dri bool to ulong
note Returns 0 READY, 3 BLOCKED_HARDWARE
basecls = shr pci_cls 16
if ne basecls 3
ret 3
end
if and eq ven 4098 has_kfd
ret 0
end
if and eq ven 32902 has_dri
ret 0
end
ret 3
end

fn qt_x86_exec_class kernel_is_x86 bool has_qemu_map bool has_x86_vendor bool to ulong
note Returns 0 PHYSICAL_X86_64, 3 EMULATED/BLOCKED_HARDWARE
if not kernel_is_x86
ret 3
end
if has_qemu_map
ret 3
end
if not has_x86_vendor
ret 3
end
ret 0
end

fn main to int
note 1. AMD MI300X (class 0x038000 = 229376, vendor 0x1002 = 4098, /dev/kfd present) -> 0
if ne qt_non_nvidia_verdict 229376 4098 true false 0
r = write 2 qt_fail 0 len qt_fail
ret 1
end
note 2. AMD MI300X without /dev/kfd -> 3 (BLOCKED_HARDWARE)
if ne qt_non_nvidia_verdict 229376 4098 false false 3
r = write 2 qt_fail 0 len qt_fail
ret 2
end
note 3. Intel Xe3 Panther Lake (class 0x030000 = 196608, vendor 0x8086 = 32902, renderD128 present) -> 0
if ne qt_non_nvidia_verdict 196608 32902 false true 0
r = write 2 qt_fail 0 len qt_fail
ret 3
end
note 4. NVIDIA GB10 (class 0x030000, vendor 0x10de = 4318) -> 3 (must NEVER pass non-NVIDIA qual!)
if ne qt_non_nvidia_verdict 196608 4318 true true 3
r = write 2 qt_fail 0 len qt_fail
ret 4
end
note 5. Intel host bridge (class 0x060000 = 393216, vendor 0x8086) -> 3 (not a display/GPU class)
if ne qt_non_nvidia_verdict 393216 32902 false true 3
r = write 2 qt_fail 0 len qt_fail
ret 5
end
note 6. x86 physical vs emulated classification
if ne qt_x86_exec_class true false true 0
r = write 2 qt_fail 0 len qt_fail
ret 6
end
if ne qt_x86_exec_class false false false 3
r = write 2 qt_fail 0 len qt_fail
ret 7
end
if ne qt_x86_exec_class true true true 3
r = write 2 qt_fail 0 len qt_fail
ret 8
end

r = write 1 qt_pass 0 len qt_pass
ret 0
end

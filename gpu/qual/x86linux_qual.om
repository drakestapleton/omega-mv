target x86linux
om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gpu/qual/x86linux_qual.om: standalone pure-Omega x86-64 Linux physical-hardware qualification binary.
note Build (from repo root):
note   { printf 'target x86linux\nom2\n'; cat seed/ng/sha256.om gpu/qual/x86linux_qual.om | grep -v '^target x86linux$' | grep -v '^om2$'; } | seed/out/omc > x86linux_qual
note Or compose via gpu/qual/gate.sh.
note
note Behavior:
note   1. Inspects /proc/version, /proc/cpuinfo, /proc/self/maps to distinguish physical x86-64 Linux
note      hardware from user-mode emulation (e.g., qemu-x86_64 on an AArch64 kernel).
note   2. Exercises native x86-64 integer arithmetic, signed/unsigned overflow & shift semantics,
note      IEEE-754 f32/f64 arithmetic + sqrt + bitcast, NIST FIPS 180-4 SHA-256 vectors,
note      mmap (mapnew/mapset/mapget/mapdrop), cpufence/cpurelax, monotonic clock, and
note      fork+waitpid negative-control trap delivery (traps 1, 2, 3, 5 -> exits 101, 102, 103, 105).
note   3. Emits a structured qualification report with SHA-256 digest of the report body.
note
note Exit codes:
note   0  PHYSICAL_X86_64 PASS (or EMULATED_SELFTEST PASS when --allow-emulated-selftest is explicitly passed)
note   1  FAIL (functional check or trap control failed)
note   2  usage error
note   3  BLOCKED_HARDWARE (running under emulation / non-x86_64 kernel; refuses to claim physical PASS)

text xq_flag "--allow-emulated-selftest"
text xq_pver "/proc/version"
text xq_pcpu "/proc/cpuinfo"
text xq_pmap "/proc/self/maps"
text xq_kx86 "x86_64"
text xq_ka64 "aarch64"
text xq_karm "arm64"
text xq_kqemu "qemu"
text xq_kintel "GenuineIntel"
text xq_kamd "AuthenticAMD"
text xq_kven "vendor_id"
text xq_abc "abc"
text xq_abc_sha "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
text xq_e0_sha "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
text xq_hdr "OMEGA-X86LINUX-QUAL v1\n"
text xq_phys "EXEC_CLASS=PHYSICAL_X86_64\n"
text xq_emu "EXEC_CLASS=EMULATED\n"
text xq_vpass "VERDICT=PASS checks=12 traps=4/4 hardware=PHYSICAL_X86_64\n"
text xq_vemu_ok "VERDICT=EMULATED_SELFTEST_PASS checks=12 traps=4/4 hardware=NOT_RUN\n"
text xq_vblk "VERDICT=BLOCKED_HARDWARE reason=emulated_not_physical_x86_64 checks=12 traps=4/4\n"
text xq_vfail "VERDICT=FAIL\n"
text xq_rcpt "RECEIPT_SHA256="
text xq_use "usage: x86linux_qual [--allow-emulated-selftest]\n"

global xq_buf uchar 32768
global xq_arg uchar 64
global xq_st uchar 4
global xq_hx uchar 64

fn xq_readfile p view uchar * to ulong
fd = fopen p 0 len p 0 0
if lt fd 0
ret 0
end
tot = ulong 0
while lt tot 32768 bound 128
got = read int fd xq_buf tot sub 32768 tot
if le got 0
break
end
tot = add tot ulong got
end
r = fclose int fd
ret tot
end

fn xq_has n ulong pat view uchar * to bool
pl = len pat
if or eq pl 0 gt pl n
ret false
end
lim = add sub n pl 1
for i ulong lim bound 32768
ok = true
for j ulong pl bound 64
if ne get xq_buf add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn xq_is_physical to bool
vn = xq_readfile xq_pver
if eq vn 0
ret false
end
if or xq_has vn xq_ka64 xq_has vn xq_karm
ret false
end
mn = xq_readfile xq_pmap
if gt mn 0
if xq_has mn xq_kqemu
ret false
end
end
cn = xq_readfile xq_pcpu
if eq cn 0
ret false
end
if not xq_has cn xq_kven
ret false
end
if or xq_has cn xq_kintel xq_has cn xq_kamd
ret true
end
ret xq_has vn xq_kx86
end

fn xq_check_arith to bool
a = ulong 18446744073709551615
if ne add a 1 0
ret false
end
if ne mul ulong 65537 ulong 65537 ulong 4295098369
ret false
end
s = long -123456789
if ne div s long -3 long 41152263
ret false
end
if ne rem s long 10 long -9
ret false
end
if ne shr ulong 18446744073709551615 60 15
ret false
end
if ne shr long -16 2 long -4
ret false
end
ret true
end

fn xq_check_float to bool
x = f64 9.0
y = fsqrt x
if ne y f64 3.0
ret false
end
z = add mul f64 1.5 f64 4.0 f64 -2.25
if ne z f64 3.75
ret false
end
f1 = f32 16.0
f2 = fsqrt f1
if ne f2 f32 4.0
ret false
end
b = bitcast uint f2
if ne b uint 1082130432
ret false
end
ret true
end

fn xq_sha_text t view uchar * to void
for i ulong len t bound 256
put sh_dat i get t i
end
sh_all len t
for j ulong 32
b = get sh_dig j
put xq_hx mul j 2 sh_hexd uint shr b 4
put xq_hx add mul j 2 1 sh_hexd uint and b 15
end
end

fn xq_check_sha to bool
xq_sha_text xq_abc
for i ulong 64
if ne get xq_hx i get xq_abc_sha i
ret false
end
end
sh_all 0
for j ulong 32
b = get sh_dig j
put xq_hx mul j 2 sh_hexd uint shr b 4
put xq_hx add mul j 2 1 sh_hexd uint and b 15
end
for i ulong 64
if ne get xq_hx i get xq_e0_sha i
ret false
end
end
ret true
end

fn xq_check_sys to bool
t1 = monons
cpufence
cpurelax
r = sleepns 1000
t2 = monons
if lt t2 t1
ret false
end
ret true
end

fn xq_run_trap kind ulong to ulong
arr = new uchar 4 0
pid = fork
if lt pid 0
ret 255
end
if eq pid 0
if eq kind 1
v = long 9223372036854775807
w = add v 1
exit int w
end
if eq kind 2
d = ulong 0
w = div ulong 1 d
exit int w
end
if eq kind 3
idx = ulong 7
c = get arr idx
exit int c
end
xv = ulong 300
sv = uchar xv
exit int sv
end
wp = waitpid int pid xq_st 0 4 0
if lt wp 0
ret 254
end
w = or ulong get xq_st 0 shl ulong get xq_st 1 8
ret and shr w 8 255
end

fn xq_check_traps to bool
if ne xq_run_trap 1 101
ret false
end
if ne xq_run_trap 2 102
ret false
end
if ne xq_run_trap 3 103
ret false
end
if ne xq_run_trap 5 105
ret false
end
ret true
end

fn main to int
nl = new uchar 1 10
allow_emu = false
ac = argcnt
if eq ac 2
n1 = argread 1 xq_arg 0 64
if ne n1 long len xq_flag
r = write 2 xq_use 0 len xq_use
ret 2
end
for i ulong len xq_flag
if ne get xq_arg i get xq_flag i
r = write 2 xq_use 0 len xq_use
ret 2
end
end
allow_emu = true
else
if ne ac 1
r = write 2 xq_use 0 len xq_use
ret 2
end
end

phys = xq_is_physical
r = write 1 xq_hdr 0 len xq_hdr
if phys
r = write 1 xq_phys 0 len xq_phys
else
r = write 1 xq_emu 0 len xq_emu
end

ok = true
if not xq_check_arith
ok = false
end
if not xq_check_float
ok = false
end
if not xq_check_sha
ok = false
end
if not xq_check_sys
ok = false
end
if not xq_check_traps
ok = false
end
if not ok
r = write 1 xq_vfail 0 len xq_vfail
ret 1
end

if phys
r = write 1 xq_vpass 0 len xq_vpass
xq_sha_text xq_vpass
else
if allow_emu
r = write 1 xq_vemu_ok 0 len xq_vemu_ok
xq_sha_text xq_vemu_ok
else
r = write 1 xq_vblk 0 len xq_vblk
xq_sha_text xq_vblk
end
end

r = write 1 xq_rcpt 0 len xq_rcpt
r = write 1 xq_hx 0 64
r = write 1 nl 0 1

if phys
ret 0
end
if allow_emu
ret 0
end
ret 3
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note vadd kernarg ABI from backend/amd/vadd-gfx1151.s at the parent revision:
note a @0 u64, b @8 u64, c @16 u64, count @24 u32; segment 28, alignment 8.
note amdhsa.version [1,2] is code-object-v5 metadata (LLVM 18.1.3 AMDGPUUsage, Code Object V5
note Metadata). No explicit .amdhsa_code_object_version appears: LLVM 18 defaults to v5. The gate
note also assembles the oracle and checks ELF ABI 3. Its metadata declares no hidden arguments:
note do not append hidden block-count/group-size fields when no corresponding .args entries exist.
note The same explicit argument ABI can be used by a gfx942 vadd with matching metadata; it does
note not make the gfx1151 kernel executable on gfx942. All AMD hardware NOT_RUN.
note usage: kernarg A B C COUNT [BUFFER_BYTES]; stdout exact 28 bytes; exit 3 short/long buffer
note or count out of u32; 2 number; 64 usage; 74 output. BUFFER_BYTES exists to exercise rejection.
om2
fn kernarg b edit uchar * a ulong c ulong d ulong n ulong to int
if ne len b 28
ret 3
end
if gt n 4294967295
ret 3
end
for i ulong 8
put b i uchar and shr a mul i 8 255
put b add i 8 uchar and shr c mul i 8 255
put b add i 16 uchar and shr d mul i 8 255
end
for i ulong 4
put b add i 24 uchar and shr n mul i 8 255
end
ret 0
end
fn main to int
if or lt argcnt 5 gt argcnt 6
ret 64
end
a = argnum 1
b = argnum 2
c = argnum 3
n = argnum 4
sz = ulong 28
if eq argcnt 6
sz = argnum 5
end
buf = new uchar 28 0
if gt sz 28
ret 3
end
r = kernarg part buf 0 sz a b c n
if ne r 0
ret r
end
emit buf
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shared CLI unsigned parser; append after aql.om, kernarg.om, records.om or ring.om.
note A uint64 text needs at most 20 decimal digits or 0x plus 16 hexadecimal digits.
note Buffer 21 permits the extra byte that makes an overlong value refuse, not truncate.
note WolframLanguageEvaluator: {2^64-1,Quotient[2^64-1,10],Mod[2^64-1,10]} ->
note {18446744073709551615,1844674407370955161,5} (integer range, dimensionless).
text numberrefusal "OMEGA refuse number field="
text numberreason0 "text\n"
text numberreason1 "hex-length\n"
text numberreason2 "hex-digit\n"
text numberreason3 "decimal-digit\n"
text numberreason4 "decimal-range\n"
text numberreason5 "decimal-overflow\n"
fn numberrefuse reason view uchar * to void
emit numberrefusal
emit reason
exit 2
end
fn argnum i ulong to ulong
ab = new uchar 21 0
n = argread i ab 0 21
if lt n 1
numberrefuse numberreason0
end
k = ulong n
s = ulong 0
hex = false
if gt k 2
if and eq get ab 0 48 eq get ab 1 120
hex = true
s = ulong 2
end
end
m = sub k s
if hex
if gt m 16
numberrefuse numberreason1
end
end
v = ulong 0
for j ulong m
d = ulong get ab add j s
dv = ulong 16
if and ge d 48 le d 57
dv = sub d 48
end
if hex
if and ge d 97 le d 102
dv = sub d 87
end
if eq dv 16
numberrefuse numberreason2
end
v = or shl v 4 dv
else
if gt dv 9
numberrefuse numberreason3
end
if gt v 1844674407370955161
numberrefuse numberreason4
end
if and eq v 1844674407370955161 gt dv 5
numberrefuse numberreason5
end
v = add mul v 10 dv
end
end
ret v
end
note Full write or exit 74. Applies to files and pipes, including partial writes and EINTR.
fn emit b view uchar * to void
p = ulong 0
while lt p len b bound 999999
r = write 1 b p sub len b p
if eq r neg long 4
continue
end
if le r 0
exit 74
end
p = add p ulong r
end
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shared CLI unsigned parser; append after aql.om, kernarg.om, records.om or ring.om.
note A uint64 text needs at most 20 decimal digits or 0x plus 16 hexadecimal digits.
note Buffer 21 permits the extra byte that makes an overlong value refuse, not truncate.
note WolframLanguageEvaluator: {2^64-1,Quotient[2^64-1,10],Mod[2^64-1,10]} ->
note {18446744073709551615,1844674407370955161,5} (integer range, dimensionless).
note Diagnostic number fields: 0 text/read, 1 hex length, 2 hex digit, 3 decimal digit, 4 decimal range, 5 decimal overflow.
note The fixed label is local so this shared fragment remains valid after a caller main under the original seed.
fn numberrefuse reason ulong to void
msg = new uchar 28 0
put msg 0 79
put msg 1 77
put msg 2 69
put msg 3 71
put msg 4 65
put msg 5 32
put msg 6 114
put msg 7 101
put msg 8 102
put msg 9 117
put msg 10 115
put msg 11 101
put msg 12 32
put msg 13 110
put msg 14 117
put msg 15 109
put msg 16 98
put msg 17 101
put msg 18 114
put msg 19 32
put msg 20 102
put msg 21 105
put msg 22 101
put msg 23 108
put msg 24 100
put msg 25 61
put msg 26 48
put msg 27 10
put msg 26 uchar add ulong 48 reason
emitfd 2 msg
exit 2
end
fn argnum i ulong to ulong
ab = new uchar 21 0
n = argread i ab 0 21
if lt n 1
numberrefuse 0
end
k = ulong n
s = ulong 0
hex = false
if gt k 2
if and eq get ab 0 48 eq get ab 1 120
hex = true
s = ulong 2
end
end
m = sub k s
if hex
if gt m 16
numberrefuse 1
end
end
v = ulong 0
for j ulong m
d = ulong get ab add j s
dv = ulong 16
if and ge d 48 le d 57
dv = sub d 48
end
if hex
if and ge d 97 le d 102
dv = sub d 87
end
if eq dv 16
numberrefuse 2
end
v = or shl v 4 dv
else
if gt dv 9
numberrefuse 3
end
if gt v 1844674407370955161
numberrefuse 4
end
if and eq v 1844674407370955161 gt dv 5
numberrefuse 5
end
v = add mul v 10 dv
end
end
ret v
end
note Full write or exit 74. Applies to files and pipes, including partial writes and EINTR.
fn emitfd fd int b view uchar * to void
p = ulong 0
while lt p len b bound 999999
r = write fd b p sub len b p
if eq r neg long 4
continue
end
if le r 0
exit 74
end
p = add p ulong r
end
end

fn emit b view uchar * to void
emitfd 1 b
end

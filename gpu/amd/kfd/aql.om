note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note backend/amd/kfd/aql.om: the 64-byte AQL kernel dispatch packet the host writes into one slot
note of a gfx942 user-mode compute queue. Layout, header bit fields and field rules are the HSA
note kernel dispatch packet, hsa_kernel_dispatch_packet_t in ROCR-Runtime src/inc/hsa.h at tag
note rocm-6.2.0 (NCSA; sha256 2b23a43e...a8e3b, PROVENANCE.md), 64-bit large model: kernarg_address
note is a whole 8-byte field at 40. Nothing is copied from that file; offsets are restated below.
note header bits: type 0..7 (KERNEL_DISPATCH 2), barrier 8, acquire fence scope 9..10, release
note fence scope 11..12 (scopes NONE 0, AGENT 1, SYSTEM 2). setup bits 0..1: dimensions 1..3.
note usage: aql DIMS WGX WGY WGZ GX GY GZ PRIVATE GROUP KOBJ KARG SIGNAL BARRIER ACQUIRE RELEASE
note Numbers are decimal or lowercase 0x hex. Writes the 64 packet bytes on stdout and exits 0.
note Refusals write nothing on stdout and one line on stderr: exit 2 malformed or overflowing number,
note exit 3 a field rule of hsa.h broken, exit 64 usage, exit 74 short write.
note The header word (header and setup, bytes 0..3) is published last as one 32-bit store; see ring.om.
om2
layout aqlpkt 64
field header ushort at 0 little
field setup ushort at 2 little
field wgx ushort at 4 little
field wgy ushort at 6 little
field wgz ushort at 8 little
field rsv0 ushort at 10 little
field gx uint at 12 little
field gy uint at 16 little
field gz uint at 20 little
field priv uint at 24 little
field group uint at 28 little
field kobj ulong at 32 little
field karg ulong at 40 little
field rsv2 ulong at 48 little
field signal ulong at 56 little
end
text eusage "usage: aql DIMS WGX WGY WGZ GX GY GZ PRIVATE GROUP KOBJ KARG SIGNAL BARRIER ACQUIRE RELEASE\n"
text edims "aql: refused: dimensions outside 1..3\n"
text ezero "aql: refused: grid size zero or workgroup size zero\n"
text erange "aql: refused: value wider than its packet field\n"
text eunused "aql: refused: unused dimension is not 1\n"
text esmall "aql: refused: grid smaller than workgroup\n"
text efence "aql: refused: barrier outside 0..1 or fence scope outside 0..2\n"
text eshort "aql: short write\n"
global av ulong 15
note One dimension d (0 x, 1 y, 2 z): workgroup at av[1+d], grid at av[4+d]. Returns 0 or the exit.
fn dimok d ulong dims ulong to int
w = get av add 1 d
g = get av add 4 d
if or eq w 0 eq g 0
r = write 2 ezero 0 len ezero
ret 3
end
if or gt w 65535 gt g 4294967295
r = write 2 erange 0 len erange
ret 3
end
if ge d dims
if or ne w 1 ne g 1
r = write 2 eunused 0 len eunused
ret 3
end
end
if lt g w
r = write 2 esmall 0 len esmall
ret 3
end
ret 0
end
fn check to int
dims = get av 0
if or lt dims 1 gt dims 3
r = write 2 edims 0 len edims
ret 3
end
for d ulong 3
e = dimok d dims
if ne e 0
ret e
end
end
if or gt get av 7 4294967295 gt get av 8 4294967295
r = write 2 erange 0 len erange
ret 3
end
if or gt get av 12 1 or gt get av 13 2 gt get av 14 2
r = write 2 efence 0 len efence
ret 3
end
ret 0
end
fn fill c edit aqlpkt to void
h = or or or ulong 2 shl get av 12 8 shl get av 13 9 shl get av 14 11
put c header ushort h
put c setup ushort get av 0
put c wgx ushort get av 1
put c wgy ushort get av 2
put c wgz ushort get av 3
put c rsv0 0
put c gx uint get av 4
put c gy uint get av 5
put c gz uint get av 6
put c priv uint get av 7
put c group uint get av 8
put c kobj get av 9
put c karg get av 10
put c rsv2 0
put c signal get av 11
end
fn main to int
if ne argcnt 16
r = write 2 eusage 0 len eusage
ret 64
end
for i ulong 15
put av i argnum add i 1
end
e = check
if ne e 0
ret e
end
c = new uchar 64 0
fill c
w = write 1 c 0 64
if ne w 64
r = write 2 eshort 0 len eshort
ret 74
end
ret 0
end

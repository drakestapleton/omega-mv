note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Serialize KFD request records from requests.tsv, without issuing any ioctl or opening a device.
note usage: records TABLE RECORD_INDEX [FIELD_VALUE ...]; index is zero-based table order.
note No values means the whole record is zero-filled (output fields and reserved bytes start zero).
note Otherwise provide one unsigned value for every field, in table order; repeated fields expand.
note requests.tsv is the wire-data authority: REQUEST SIZE FIELD_COUNT followed by OFFSET WIDTH COUNT.
note # comments name requests and fields. No native struct is used in the producer. Little endian.
note The 88-byte scratch extent is exactly sizeof(kfd_ioctl_create_queue_args), the largest record
note in this fixed ABI table, not a queue/workload capacity. It is a constant because the pinned omc
note (omega-mv e5b32567) takes only a constant length in `new` (a table size there is error 16).
note A larger record in a later KFD revision refuses with exit 3, never truncates; the gate compares
note every field and size with the installed header.
note Includes GET_PROCESS_APERTURES_NEW, not deprecated GET_PROCESS_APERTURES (fixed seven GPU cap).
note Auxiliary records (request 0) are an aperture entry, a signal-event wait entry and one GPU ID.
note Addresses are serialized values supplied by the caller, not Omega pointers or validated mappings.
note Pointer binding, KFD calls, event-page signal lifecycle, MMIO and hardware coherency NOT_RUN.
note Exit: 0 emitted; 2 numeric input; 3 table/record/field shape; 64 usage; 74 I/O.
note Exhausting the pinned compiler's loop fuel bound 999999 traps with exit 104 before output.
note tests/amd/loop-fuel.sh alarms when a gate table passes 500000 bytes; route A (newer omc pin) removes the bound.
om2
global rb uchar 1
global rfd int 1
global ri ulong 1
fn rbyte to ulong
r = read get rfd 0 rb 0 1
if eq r 0
ret 256
end
if ne r 1
exit 74
end
ret ulong get rb 0
end
fn tnum to ulong
c = rbyte
while true bound 999999
if eq c 256
exit 3
end
if eq c 35
while ne c 10 bound 999999
c = rbyte
if eq c 256
exit 3
end
end
end
if gt c 32
break
end
c = rbyte
end
v = ulong 0
while and ge c 48 le c 57 bound 999999
d = sub c 48
if gt v 1844674407370955161
exit 3
end
if and eq v 1844674407370955161 gt d 5
exit 3
end
v = add mul v 10 d
c = rbyte
end
if gt c 32
if ne c 256
exit 3
end
end
ret v
end
fn store b edit uchar 88 off ulong wid ulong val ulong to void
if and ne wid 4 ne wid 8
exit 3
end
if or gt off len b gt wid sub len b off
exit 3
end
if and eq wid 4 gt val 4294967295
exit 3
end
for i ulong wid
put b add off i uchar and shr val mul i 8 255
end
end
fn fld b edit uchar 88 idx ulong sz ulong to void
off = tnum
wid = tnum
cnt = tnum
if eq cnt 0
exit 3
end
for j ulong cnt
pos = add off mul j wid
if gt pos sz
exit 3
end
if gt wid sub sz pos
exit 3
end
if eq idx 0
v = ulong 0
if gt argcnt 3
if ge get ri 0 ulong argcnt
exit 3
end
v = argnum get ri 0
end
store b pos wid v
put ri 0 add get ri 0 1
end
end
end
fn record b edit uchar 88 idx ulong sz ulong nf ulong to void
put ri 0 3
for f ulong nf
fld b idx sz
end
if eq idx 0
if gt argcnt 3
if ne get ri 0 ulong argcnt
exit 3
end
end
end
end
fn main to int
if lt argcnt 3
ret 64
end
path = new uchar 4095 0
n = argread 1 path 0 len path
if lt n 1
ret 74
end
fd = fopen path 0 ulong n 0 0
if lt fd 0
ret 74
end
put rfd 0 int fd
idx = argnum 2
note idx + 1 bounds the row loop below; at the 64-bit maximum it would wrap to 0, so refuse it.
if eq idx 18446744073709551615
ret 3
end
buf = new uchar 88 0
for i ulong add idx 1
req = tnum
sz = tnum
nf = tnum
if or eq sz 0 gt sz len buf
ret 3
end
record buf sub idx i sz nf
if eq i idx
emit part buf 0 sz
end
end
r = fclose int fd
if ne r 0
ret 74
end
ret 0
end

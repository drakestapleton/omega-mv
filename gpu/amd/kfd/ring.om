note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note A sequential, single-producer/single-consumer model, not an MMIO implementation or memory-model
note proof. Each command is one externally visible publication step. No AMD hardware is accessed.
note HSA hsa.h rocm-6.2.0: packet type INVALID=1, KERNEL_DISPATCH=2; doorbell carries ready packet ID.
note Host policy checked here: body bytes 4..63 -> header+setup (one 32-bit word) -> write index
note -> doorbell packet ID (new write index minus one). Consumer observes after each step; once
note the type is valid it must see every body byte. Completion consumes the published packet and
note invalidates its header before the producer reuses the slot. KFD 1.14 minimum ring 1024 bytes;
note 16 64-byte slots. The gate runs 40 launches, crossing the ring boundary twice.
note A real implementation needs release publication/acquire observation and device-coherent memory,
note as well as architecture-specific fences. This model does NOT establish those properties.
note usage: ring STEP... (1=body 2=header 3=write-index 4=doorbell 5=consume).
note Exit 0 complete sequences; 64 fewer than five steps; 3 bad order/data/index or incomplete sequence
note after the minimum argument check; 2 numeric input.
om2
global ringbuf uchar 1024
global rs ulong 4
text raccept "RING ACCEPT body<header<write-index<doorbell<consume\n"
note rs: phase, write index, read index, doorbell packet ID.
fn bodyval id ulong k ulong to uchar
ret uchar and add id k 255
end
fn inspect id ulong to void
slot = mul rem id 16 64
if eq get ringbuf slot 2
for k ulong 60
p = add k 4
if ne get ringbuf add slot p bodyval id p
exit 3
end
end
end
end
fn step action ulong to void
id = get rs 2
slot = mul rem id 16 64
phase = get rs 0
if eq action 1
if ne phase 0
exit 3
end
if ne get ringbuf slot 1
exit 3
end
for k ulong 60
p = add k 4
put ringbuf add slot p bodyval id p
end
put rs 0 1
end
if eq action 2
if ne phase 1
exit 3
end
note Model the atomic 32-bit header+setup publication, not four observable byte stores.
put ringbuf slot 2
put ringbuf add slot 1 21
put ringbuf add slot 2 1
put ringbuf add slot 3 0
put rs 0 2
end
if eq action 3
if ne phase 2
exit 3
end
put rs 1 add id 1
put rs 0 3
end
if eq action 4
if ne phase 3
exit 3
end
put rs 3 sub get rs 1 1
put rs 0 4
end
if eq action 5
if ne phase 4
exit 3
end
if or ne get rs 1 add id 1 ne get rs 3 id
exit 3
end
if or ne get ringbuf slot 2 ne get ringbuf add slot 1 21
exit 3
end
inspect id
put ringbuf slot 1
put rs 2 add id 1
put rs 0 0
end
if or lt action 1 gt action 5
exit 3
end
inspect get rs 2
end
fn main to int
if lt argcnt 6
ret 64
end
for i ulong 16
put ringbuf mul i 64 1
end
for i ulong sub ulong argcnt 1
step argnum add i 1
end
if ne get rs 0 0
ret 3
end
emit raccept
ret 0
end

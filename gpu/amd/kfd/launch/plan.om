fn planrun to void
sent = ulong 0
steps = sub add get ps 7 get ps 8 1
tok = bufhandle get ps 9
for step ulong steps bound 9223372036854775807
if lt step get ps 7
r = checked mapset tok bufoffset get ps 9 4 pw add get ps 15 mul step 4 4

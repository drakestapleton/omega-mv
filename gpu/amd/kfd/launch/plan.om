note OMPLAN01 trusted first-party dispatch plans; all file and relocation bounds preflight before KFD.
note ps: planmap,fd,size,ncode,nfile,nbuf,ndisp,nprompt,ngen,tok,strOff,strLen,dataOff,dataLen,bufOff,promptOff,dispOff,codemeta,filemeta,dispmeta,packets,argbytes,ids,bufoffsets,VRAMbytes,GTTbytes.
global ps ulong 26
global planoptions ulong 1
text planmode "plan"
text planstep "OMEGA_STEP "
text plantok " tok="
text planus " us="
text planready "OMEGA_PLAN ready\n"
text plandone "OMEGA_PLAN complete\n"
text planids "OMEGA_PLAN ids=["
text plancomma ","
text planend "]\n"
fn padd a ulong b ulong to ulong
if or gt a 9223372036854775807 gt b sub ulong 9223372036854775807 a
exit 64
end
ret add a b
end
fn pmul a ulong b ulong to ulong
if ne b 0
if gt a div ulong 9223372036854775807 b
exit 64
end
end
ret mul a b
end
fn pspan off ulong n ulong total ulong to void
if gt off total
exit 64
end
if gt n sub total off
exit 64
end
end
fn pw off ulong width ulong to ulong
pspan off width get ps 2
if gt width 8
exit 64
end
b = new uchar 8 0
r = checked mapread long get ps 0 off b 0 width
v = ulong 0
for i ulong width bound 8
v = or v shl ulong get b i mul i 8
end
ret v
end
fn planpad off ulong limit ulong to ulong
last = roundup off 8
pspan off sub last off limit
for i ulong sub last off bound 7
if ne pw add off i 1 0
exit 64
end
end
ret last
end
fn pb i ulong byteoff ulong to ulong
ret pw add add get ps 14 pmul i 48 byteoff 8
end
fn cm i ulong byteoff ulong to ulong
ret mapget long get ps 17 add pmul i 96 byteoff 8
end
fn fm i ulong byteoff ulong to ulong
ret mapget long get ps 18 add pmul i 16 byteoff 8
end
fn dm i ulong byteoff ulong to ulong
ret mapget long get ps 19 add pmul i 32 byteoff 8
end
fn restoreel i ulong to void
for j ulong 12
put el j cm i mul j 8
end
end
fn planhead to void
fd = argfile 2 0
put ps 1 ulong fd
put ps 2 filesize fd
pspan 0 96 get ps 2
put ps 0 ulong checked mapnew fd 0 get ps 2 1 2
if ne pw 0 8 0x31304e414c504d4f
exit 64
end
for i ulong 7
put ps add i 3 pw mul add i 1 8 8
end
if eq get ps 3 0
exit 64
end
for i ulong 4
if eq get ps add i 5 0
exit 64
end
end
if ge get ps 9 get ps 5
exit 64
end
expected = padd 3 padd get ps 3 get ps 4
put planoptions 0 0
if ne ulong argcnt expected
if ne ulong argcnt padd expected 1
exit 64
end
put planoptions 0 argnum expected
end
for i ulong 4
put ps add 10 i pw add sub get ps 2 32 mul i 8 8
end
if ne padd get ps 10 get ps 11 get ps 12
exit 64
end
if ne padd get ps 12 get ps 13 sub get ps 2 32
exit 64
end
put ps 14 padd 64 pmul get ps 3 16
put ps 15 padd get ps 14 pmul get ps 5 48
put ps 16 planpad padd get ps 15 pmul get ps 7 4 get ps 10
pspan 64 sub get ps 16 64 get ps 10
pspan get ps 16 pmul get ps 6 32 get ps 10
steps = sub padd get ps 7 get ps 8 1
n = pmul steps get ps 6
put ps 17 ulong checked mapnew -1 0 pmul get ps 3 96 3 34
put ps 18 ulong checked mapnew -1 0 pmul padd get ps 4 1 16 3 34
put ps 19 ulong checked mapnew -1 0 pmul get ps 6 32 3 34
put ps 22 ulong checked mapnew -1 0 pmul get ps 8 4 3 34
end
fn planname i ulong to ulong
pos = add 64 mul i 16
off = pw pos 8
n = pw add pos 8 8
pspan off n get ps 11
if or eq n 0 gt n len pathbuf
exit 64
end
r = checked mapread long get ps 0 add get ps 10 off pathbuf 0 n
ret n
end
fn plansaveel i ulong to void
for j ulong 12
r = checked mapset long get ps 17 add mul i 96 mul j 8 8 get el j
end
end
fn plancode i ulong to void
fd = argfile add 3 i 0
n = planname i
parseopen fd n
plansaveel i
end
fn plancodes to void
for i ulong get ps 3 bound 9223372036854775807
plancode i
end
end
fn planfiles to void
for i ulong get ps 4 bound 9223372036854775807
fd = argfile add add 3 get ps 3 i 0
r = checked mapset long get ps 18 mul i 16 8 ulong fd
r = checked mapset long get ps 18 add mul i 16 8 8 filesize fd
end
end
fn planbufcheck i ulong to void
n = pb i 0
kind = pb i 8
idx = pb i 16
off = pb i 24
size = pb i 32
flags = pb i 40
if or eq n 0 gt n 9223372036854771712
exit 64
end
if not or eq flags 1 eq flags 2
exit 64
end
if gt kind 3
exit 64
end
if eq kind 0
if or ne idx 0 or ne off 0 ne size 0
exit 64
end
else
if eq kind 3
if ne idx 0
exit 64
end
pspan off size get ps 13
else
if ge idx get ps 4
exit 64
end
pspan off size fm idx 8
end
end
if eq kind 2
if ne rem size 2 0
exit 64
end
size = pmul size 2
end
pspan 0 size n
end
fn planduplicate pos ulong count ulong off ulong to void
for k ulong count bound 9223372036854775807
if eq off pw add pos mul k 16 4
exit 64
end
end
end
fn planrelone p ulong raw ulong size ulong to void
off = pw p 4
if ne rem off 8 0
exit 64
end
pspan off 8 size
if ne pw add raw off 8 0
exit 64
end
idx = pw add p 4 4
if ge idx get ps 5
exit 64
end
pspan pw add p 8 8 1 pb idx 0
end
fn planreloc pos ulong raw ulong size ulong count ulong to void
for j ulong count bound 9223372036854775807
planrelone add pos mul j 16 raw size
planduplicate pos j pw add pos mul j 16 4
end
end
fn planshape pos ulong to void
pspan pos 32 get ps 10
code = pw pos 4
if ge code get ps 3
exit 64
end
gx = pw add pos 4 4
gy = pw add pos 8 4
if or eq gx 0 or gt gx div ulong 4294967295 64 eq gy 0
exit 64
end
if or ne pw add pos 12 4 1 or ne pw add pos 16 4 64 ne pw add pos 28 4 0
exit 64
end
if ne pw add pos 20 4 cm code 64
exit 64
end
end
fn planstore i ulong pos ulong reloc ulong to void
r = checked mapset long get ps 19 mul i 32 8 pos
r = checked mapset long get ps 19 add mul i 32 8 8 reloc
r = checked mapset long get ps 19 add mul i 32 16 8 get ps 21
end
fn plandispcheck pos ulong i ulong to ulong
planshape pos
size = pw add pos 20 4
count = pw add pos 24 4
if gt count div size 8
exit 64
end
raw = add pos 32
reloc = padd raw size
last = padd reloc pmul count 16
pspan pos sub last pos get ps 10
planreloc reloc raw size count
planstore i pos reloc
put ps 21 padd get ps 21 roundup padd size 1 16
ret planpad last get ps 10
end
fn planring to void
note Keep the established 1024-byte AQL minimum, grow for the complete step.
slots = ulong 16
while lt slots padd get ps 6 1 bound 63
slots = pmul slots 2
end
note CREATE_QUEUE ring_size is a 32-bit byte count; reject unrepresentable rings.
if gt slots div ulong 4294967295 64
exit 64
end
put launch 10 slots
end
fn plancheck to void
planhead
plancodes
planfiles
for i ulong get ps 5 bound 9223372036854775807
planbufcheck i
end
if or lt pb get ps 9 0 4 ne pb get ps 9 40 2
exit 64
end
pos = get ps 16
for i ulong get ps 6 bound 9223372036854775807
pos = plandispcheck pos i
end
if ne pos get ps 10
exit 64
end
planlayout
planring
end
fn bufoffset i ulong to ulong
ret mapget long get ps 23 mul i 8 8
end
fn bufhandle i ulong to long
ret lh add add 7 get ps 3 pb i 40
end
fn planlayout to void
put ps 23 ulong checked mapnew -1 0 pmul get ps 5 8 3 34
for i ulong get ps 5 bound 9223372036854775807
slot = add 23 pb i 40
r = checked mapset long get ps 23 mul i 8 8 get ps slot
put ps slot padd get ps slot roundup pb i 0 4096
end
end
fn planarenas to void
for i ulong 2
size = get ps add 24 i
if ne size 0
flags = ulong 0xa0000001
if eq i 1
flags = ulong 0xa6000002
end
h = allocate add add 8 get ps 3 i size flags
end
end
end
fn widenchunk h long off ulong n ulong to void
for i ulong div n 2 bound 2048
v = shl ulong get chunk mul i 2 16
v = or v shl ulong get chunk add mul i 2 1 24
r = checked mapset h add off mul i 4 4 v
end
end
fn planwiden fd int off ulong h long dst ulong n ulong to void
pos = ulong 0
while lt pos n bound 9223372036854775807
size = sub n pos
if gt size len chunk
size = len chunk
end
r = checked pread fd chunk 0 size long add off pos
if or eq r 0 ne rem ulong r 2 0
exit 65
end
widenchunk h add dst mul pos 2 ulong r
pos = add pos ulong r
end
end
fn planbufload i ulong to void
h = bufhandle i
base = bufoffset i
kind = pb i 8
used = pb i 32
if eq kind 0
used = ulong 0
else
if eq kind 3
filecopy int get ps 1 add get ps 12 pb i 24 h base used
else
fd = int fm pb i 16 0
if eq kind 2
planwiden fd pb i 24 h base used
used = mul used 2
else
filecopy fd pb i 24 h base used
end
end
end
zeromap h add base used sub pb i 0 used
end
fn planargs i ulong to void
pos = dm i 0
raw = add pos 32
size = pw add pos 20 4
argoff = dm i 16
filecopy int get ps 1 raw lh 1 argoff size
for j ulong pw add pos 24 4 bound 9223372036854775807
p = add dm i 8 mul j 16
off = pw p 4
idx = pw add p 4 4
value = padd mapaddr bufhandle idx padd bufoffset idx pw add p 8 8
r = checked mapset lh 1 add argoff off 8 value
end
end
fn plantemplate i ulong to void
pos = dm i 0
code = pw pos 4
zerohdr
hput 0 4 1
hput 4 2 64
hput 6 2 1
hput 8 2 1
hput 12 4 mul pw add pos 4 4 64
hput 16 4 pw add pos 8 4
hput 20 4 1
note Descriptor metadata is group then private; the packet is private then group.
hput 24 4 cm code 80
hput 28 4 cm code 72
hput 32 8 padd mapaddr lh add 8 code cm code 48
hput 40 8 padd mapaddr lh 1 dm i 16
if eq add i 1 get ps 6
hput 56 8 mapaddr lh 7
end
r = checked mapwrite long get ps 20 mul i 64 hdr 0 64
end
fn planload to void
n = padd 10 get ps 3
put launch 0 ulong checked mapnew -1 0 pmul n 24 3 34
put launch 1 sub n 8
put launch 2 1
put launch 3 get planoptions 0
r = allocate 1 get ps 21 0xa0000001
for i ulong get ps 3 bound 9223372036854775807
restoreel i
h = allocate add 8 i get el 7 0xe0000001
loadelf h
end
planarenas
for i ulong get ps 5 bound 9223372036854775807
planbufload i
end
queueinit
put ps 20 ulong checked mapnew -1 0 pmul get ps 6 64 3 34
for i ulong get ps 6 bound 9223372036854775807
planargs i
plantemplate i
end
cpufence
emit planready
end
fn plantimeout start long to void
now = monons
if lt now start
exit 74
end
slowdispatch ulong sub now start
if and ne get launch 3 0 gt ulong sub now start get launch 3
stepbegin stwait 0
steprow 110 false
exit 75
end
end
fn plancopy sent ulong to void
pos = ulong 0
size = pmul get ps 6 64
ringbytes = pmul get launch 10 64
while lt pos size bound 9223372036854775807
slot = rem add mul rem sent get launch 10 64 pos ringbytes
n = sub size pos
if gt n len chunk
n = len chunk
end
if gt n sub ringbytes slot
n = sub ringbytes slot
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note launch: table,ninputs,repeats,timeoutns,outbytes,groupsX,groupsY,queueid,bell,belloff.
global launch ulong 10
text timed "OMEGA dispatch_ns="
text repeatlabel " packets="
note Diagnostics retain CPU-side inputs only; no additional device writes.
global queueinput ulong 11
note diagstate: vadd,full doorbell offset,last packet slot.
global diagstate ulong 3
text diagprefix "OMEGA diag "
text diagspace " "
text dread "queue_read_pointer"
text dwrite "queue_write_pointer"
text dptr64 "queue_properties"
text dqbase "read_pointer_base_offset"
text dkind "signal_kind"
text dvalue "signal_value"
text dheader "ring_header"
text dslot "ring_slot_byte_offset"
text dout "output_word_"
text dqueue "create_queue_input_qword_"
text did "queue_id"
text dbell "doorbell_offset"
text dentry "kernel_code_entry_byte_offset"
text drsrc1 "compute_pgm_rsrc1"
text drsrc2 "compute_pgm_rsrc2"
text drsrc3 "compute_pgm_rsrc3"
text dprops "kernel_code_properties"
text dgroup "group_segment_size"
text dprivate "private_segment_size"
text dargsize "kernarg_size"
text dobject "packet_kernel_object"
text dargaddr "packet_kernarg_address"
text dnan "output_first8_nan_fill_count"
text dsum "output_first8_expected_vadd_sum_count"
text dtimeout "wait_timeout_ns"
fn diag name view uchar * value ulong to void
emit diagprefix
emit name
emit diagspace
printnum value
emit newline
end
fn diagindexed name view uchar * index ulong value ulong to void
emit diagprefix
emit name
printnum index
emit diagspace
printnum value
emit newline
end
fn lh i ulong to long
ret long mapget long get launch 0 mul i 24 8
end
fn allocate i ulong n ulong flags ulong to long
ret gpumem n flags long get launch 0 mul i 24
end
fn diagnostics to void
cpufence
diag dread mapget lh 5 0 8
diag dwrite mapget lh 4 0 8
diag dptr64 mapget lh 5 52 4
diag dqbase mapget lh 5 8 4
diag dkind mapget lh 7 0 8
diag dvalue mapget lh 7 8 8
diag dslot get diagstate 2
diag dheader mapget lh 3 get diagstate 2 4
diag dobject mapget lh 3 add get diagstate 2 32 8
diag dargaddr mapget lh 3 add get diagstate 2 40 8
diag did get launch 7
diag dbell get diagstate 1
for i ulong 11
diagindexed dqueue i get queueinput i
end
diag dentry mapget lh 0 add get el 6 16 8
diag drsrc1 mapget lh 0 add get el 6 48 4
diag drsrc2 mapget lh 0 add get el 6 52 4
diag drsrc3 mapget lh 0 add get el 6 44 4
diag dprops and mapget lh 0 add get el 6 56 4 65535
diag dgroup mapget lh 0 get el 6 4
diag dprivate mapget lh 0 add get el 6 4 4
diag dargsize mapget lh 0 add get el 6 8 4
count = div get launch 4 4
if gt count 8
count = ulong 8
end
nan = ulong 0
sum = ulong 0
for i ulong count
word = mapget lh 2 mul i 4 4
diagindexed dout i word
if eq word 0x7fc00000
nan = add nan 1
end
if eq word 0x40000000
sum = add sum 1
end
end
diag dnan nan
if ne get diagstate 0 0
diag dsum sum
end
end
fn queueinit to void
ctxsizes
r = allocate 3 1024 0xa6000002
r = allocate 4 4096 0xa6000002
r = allocate 5 4096 0xa6000002
n = roundup mul add get dev 8 get dev 10 get dev 7 4096
r = allocate 6 n 0xe4000002
r = allocate 7 4096 0xa6000002
zeromap lh 3 0 1024
zeromap lh 4 0 8
note AMD CP queue fields start at read_dispatch_id. Clear the whole backing page.
note No HSA queue header is supplied; parseelf refuses ENABLE_SGPR_QUEUE_PTR.
zeromap lh 5 0 4096
note queue_properties is read_dispatch_id + 52; IS_PTR64 is bit 1.
r = checked mapset lh 5 52 4 2
zeromap lh 6 0 n
zeromap lh 7 0 64
note USER signal ABI: kind 1 at 0, value at 8, no interrupt event.
r = checked mapset lh 7 0 8 1
r = checked mapset lh 7 8 8 get launch 2
for i ulong get dev 7 bound 9223372036854775807
p = mul i get dev 8
r = checked mapset lh 6 add p 16 4 mul sub get dev 7 i get dev 8
r = checked mapset lh 6 add p 20 4 mul get dev 10 get dev 7
end
for i ulong 16
r = checked mapset lh 3 mul i 64 4 1
end
stepbegin stqueue get dev 2
zerohdr
hput 32 4 1024
hput 36 4 get dev 2
hput 40 4 2
hput 44 4 100
hput 48 4 7
hput 80 4 get dev 8
hput 84 4 get dev 9
note gfx942 AQL queues require no EOP allocation (ROCT queues.c).
note kfdctl supplies these five mapping addresses in its private ioctl block.
note Reconstruct that input here, before the ioctl returns output fields.
for i ulong 11
put queueinput i hget mul i 8 8
end
put queueinput 0 mapaddr lh 3
put queueinput 1 mapaddr lh 4
put queueinput 2 mapaddr lh 5
put queueinput 7 0
put queueinput 9 mapaddr lh 6
r = checked kfdctl int get dev 0 3227011842 hdr 0 88 lh 3 lh 4 lh 5 long 0 lh 6
put launch 7 hget 52 4
stepend
belloff = hget 24 8
put diagstate 1 belloff
put launch 9 rem belloff 8192
stepbegin stbell belloff
put launch 8 ulong checked kfdmap int get dev 0 sub belloff rem belloff 8192 8192
stepend
end
fn packet id ulong to void
slot = mul rem id 16 64
put diagstate 2 slot
zerohdr
note First dword kept INVALID until every other field is published.
hput 0 2 1
hput 2 2 2
hput 4 2 64
hput 6 2 1
hput 8 2 1
hput 12 4 mul get launch 5 64
hput 16 4 get launch 6
hput 20 4 1
hput 24 4 get el 10
hput 28 4 get el 9
hput 32 8 add mapaddr lh 0 get el 6
hput 40 8 mapaddr lh 1
hput 56 8 mapaddr lh 7
r = checked mapset lh 3 slot 4 1
r = checked mapwrite lh 3 add slot 4 hdr 4 60
cpufence
note type KERNEL_DISPATCH=2, barrier=1, acquire/release SYSTEM=2, dimensions=2.
r = checked mapset lh 3 slot 4 0x00021502
cpufence
r = checked mapset lh 4 0 8 add id 1
cpufence
r = checked mapset long get launch 8 get launch 9 8 id
end
fn deadline start long to void
now = monons
if lt now start
steprow 110 false
diagnostics
exit 75
end
if gt ulong sub now start get launch 3
steprow 110 false
diagnostics
exit 75
end
end
fn dispatch to void
stepbegin stdispatch get launch 2
diag dtimeout get launch 3
start = monons
if lt start 0
steprow ulong neg start false
exit 74
end
for i ulong get launch 2 bound 9223372036854775807
while ge sub i mapget lh 5 0 8 16 bound 9223372036854775807
deadline start
cpurelax
end
packet i
end
stepend
stepbegin stwait get launch 2
while ne mapget lh 7 8 8 0 bound 9223372036854775807
deadline start
cpurelax
end
cpufence
stepend
elapsed = sub monons start
emit timed
printnum ulong elapsed
emit repeatlabel
printnum get launch 2
emit newline
diagnostics
end
fn teardown to void
stepbegin stcleanup 0
zerohdr
hput 0 4 get launch 7
r = checked kfdctl int get dev 0 3221768963 hdr 0 8
r = checked mapdrop long get launch 8
for i ulong add get launch 1 8 bound 9223372036854775807
gpufree long get launch 0 mul i 24
end
r = checked mapdrop long get launch 0
r = checked fclose int get dev 1
r = checked fclose int get dev 0
r = checked fclose int get el 0
stepend
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note launch: table,ninputs,repeats,timeoutns,outbytes,groupsX,groupsY,queueid,bell,belloff.
global launch ulong 10
text timed "OMEGA dispatch_ns="
text repeatlabel " packets="
fn lh i ulong to long
ret long mapget long get launch 0 mul i 24 8
end
fn allocate i ulong n ulong flags ulong to long
ret gpumem n flags long get launch 0 mul i 24
end
fn queueinit to void
ctxsizes
r = allocate 3 1024 0xa6000002
r = allocate 4 4096 0xa6000002
r = allocate 5 4096 0xa6000002
n = roundup mul add get dev 8 get dev 10 get dev 7 4096
r = allocate 6 n 0xe4000002
r = allocate 7 4096 0xa6000002
zeromap lh 3 0 1024
zeromap lh 4 0 8
zeromap lh 5 0 8
zeromap lh 6 0 n
zeromap lh 7 0 64
note USER signal ABI: kind 1 at 0, value at 8, no interrupt event.
r = checked mapset lh 7 0 8 1
r = checked mapset lh 7 8 8 get launch 2
for i ulong get dev 7 bound 9223372036854775807
p = mul i get dev 8
r = checked mapset lh 6 add p 16 4 mul sub get dev 7 i get dev 8
r = checked mapset lh 6 add p 20 4 mul get dev 10 get dev 7
end
for i ulong 16
r = checked mapset lh 3 mul i 64 4 1
end
stepbegin stqueue get dev 2
zerohdr
hput 32 4 1024
hput 36 4 get dev 2
hput 40 4 2
hput 44 4 100
hput 48 4 7
hput 80 4 get dev 8
hput 84 4 get dev 9
note gfx942 AQL queues require no EOP allocation (ROCT queues.c).
r = checked kfdctl int get dev 0 3227011842 hdr 0 88 lh 3 lh 4 lh 5 long 0 lh 6
put launch 7 hget 52 4
stepend
belloff = hget 24 8
put launch 9 rem belloff 8192
stepbegin stbell belloff
put launch 8 ulong checked kfdmap int get dev 0 sub belloff rem belloff 8192 8192
stepend
end
fn packet id ulong to void
slot = mul rem id 16 64
zerohdr
note First dword kept INVALID until every other field is published.
hput 0 2 1
hput 2 2 2
hput 4 2 64
hput 6 2 1
hput 8 2 1
hput 12 4 mul get launch 5 64
hput 16 4 get launch 6
hput 20 4 1
hput 24 4 get el 10
hput 28 4 get el 9
hput 32 8 add mapaddr lh 0 get el 6
hput 40 8 mapaddr lh 1
hput 56 8 mapaddr lh 7
r = checked mapset lh 3 slot 4 1
r = checked mapwrite lh 3 add slot 4 hdr 4 60
cpufence
note type KERNEL_DISPATCH=2, barrier=1, acquire/release SYSTEM=2, dimensions=2.
r = checked mapset lh 3 slot 4 0x00021502
cpufence
r = checked mapset lh 4 0 8 add id 1
cpufence
r = checked mapset long get launch 8 get launch 9 8 id
end
fn deadline start long to void
now = monons
if lt now start
steprow 110 false
exit 75
end
if gt ulong sub now start get launch 3
steprow 110 false
exit 75
end
end
fn dispatch to void
stepbegin stdispatch get launch 2
start = monons
if lt start 0
steprow ulong neg start false
exit 74
end
for i ulong get launch 2 bound 9223372036854775807
while ge sub i mapget lh 5 0 8 16 bound 9223372036854775807
deadline start
cpurelax
end
packet i
end
stepend
stepbegin stwait get launch 2
while ne mapget lh 7 8 8 0 bound 9223372036854775807
deadline start
cpurelax
end
cpufence
stepend
elapsed = sub monons start
emit timed
printnum ulong elapsed
emit repeatlabel
printnum get launch 2
emit newline
end
fn teardown to void
stepbegin stcleanup 0
zerohdr
hput 0 4 get launch 7
r = checked kfdctl int get dev 0 3221768963 hdr 0 8
r = checked mapdrop long get launch 8
for i ulong add get launch 1 8 bound 9223372036854775807
gpufree long get launch 0 mul i 24
end
r = checked mapdrop long get launch 0
r = checked fclose int get dev 1
r = checked fclose int get dev 0
r = checked fclose int get el 0
stepend
end

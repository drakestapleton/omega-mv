note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Concatenate common, elf, device, dispatch, main, then existing cli.om under om2.
note Fixed arrays below are Linux pathname or ABI records, not input-size limits.
global pathbuf uchar 4096
global chunk uchar 4096
global hdr uchar 88
global ids uchar 4
global one uchar 1
text newline "\n"
text failed "OMEGA error="
text kfdpath "/dev/kfd"
global stepname uchar 64
note This internal label buffer holds only the literal step names below, never caller input.
global stepstate ulong 2
text stepprefix "OMEGA step "
text stepok " ok errno=0"
text stepfail " fail errno="
text stepbefore " phase=before detail="
text stepafter " phase=after detail="
text stopen "open_kfd"
text stversion "version"
text sttop "topology"
text stnode "topology_node"
text strender "render_open"
text stvm "acquire_vm"
text stap "memory_apertures"
text streserve "memory_reserve"
text stalloc "memory_alloc"
text stmap "memory_map"
text stbind "memory_cpu_map"
text stqueue "queue_create"
text stbell "doorbell_map"
text stload "code_object_load"
text stdispatch "dispatch"
text stwait "signal_wait"
text streadback "readback"
text stcleanup "cleanup"
fn steprow err ulong before bool to void
r = write 1 stepprefix 0 len stepprefix
r = write 1 stepname 0 get stepstate 0
if eq err 0
r = write 1 stepok 0 len stepok
else
r = write 1 stepfail 0 len stepfail
printnum err
end
if before
r = write 1 stepbefore 0 len stepbefore
else
r = write 1 stepafter 0 len stepafter
end
printnum get stepstate 1
r = write 1 newline 0 len newline
end
fn stepbegin name view uchar * detail ulong to void
for i ulong len name bound 64
put stepname i get name i
end
put stepstate 0 len name
put stepstate 1 detail
steprow 0 true
end
fn stepend to void
steprow 0 false
end
fn stepresult r long to long
if lt r 0
steprow ulong neg r false
else
stepend
end
ret r
end
fn checked r long to long
if lt r 0
steprow ulong neg r false
emit failed
if eq r -9223372036854775808
exit 74
end
printnum ulong neg r
emit newline
exit 74
end
ret r
end
fn printnum v ulong to void
b = new uchar 20 0
p = ulong 20
while gt v 9 bound 20
p = sub p 1
put b p uchar add rem v 10 48
v = div v 10
end
p = sub p 1
put b p uchar add v 48
emit part b p sub 20 p
end
fn roundup n ulong a ulong to ulong
if gt n sub 9223372036854775807 sub a 1
exit 65
end
ret mul div add n sub a 1 a a
end
fn patharg i ulong to ulong
n = argread i pathbuf 0 len pathbuf
if lt n 1
exit 64
end
ret ulong n
end
fn argfile i ulong flags int to int
n = patharg i
ret int checked fopen pathbuf 0 n flags 384
end
fn filesize fd int to ulong
n = checked fseek fd 0 2
r = checked fseek fd 0 0
ret ulong n
end
fn zerohdr to void
for i ulong 88
put hdr i 0
end
end
fn hput off ulong width ulong v ulong to void
for i ulong width
put hdr add off i uchar and shr v mul i 8 255
end
end
fn hget off ulong width ulong to ulong
v = ulong 0
for i ulong width
v = or v shl ulong get hdr add off i mul i 8
end
ret v
end
fn fword fd int off ulong width ulong to ulong
b = new uchar 8 0
r = pread fd b 0 width long off
if ne r long width
exit 65
end
v = ulong 0
for i ulong width
v = or v shl ulong get b i mul i 8
end
ret v
end
fn byteat fd int off ulong to uchar
r = pread fd one 0 1 long off
if ne r 1
exit 65
end
ret get one 0
end
fn filecopy fd int src ulong dst long off ulong n ulong to void
p = ulong 0
while lt p n bound 9223372036854775807
k = sub n p
if gt k len chunk
k = len chunk
end
r = checked pread fd chunk 0 k long add src p
if eq r 0
exit 65
end
r = checked mapwrite dst add off p chunk 0 ulong r
p = add p ulong r
end
end
fn zeromap dst long off ulong n ulong to void
for i ulong len chunk bound 4096
put chunk i 0
end
p = ulong 0
while lt p n bound 9223372036854775807
k = sub n p
if gt k len chunk
k = len chunk
end
r = checked mapwrite dst add off p chunk 0 k
p = add p k
end
end
fn savefile fd int src long n ulong to void
p = ulong 0
while lt p n bound 9223372036854775807
k = sub n p
if gt k len chunk
k = len chunk
end
r = checked mapread src p chunk 0 k
q = ulong 0
while lt q k bound 9223372036854775807
r = checked write fd chunk q sub k q
if eq r 0
exit 74
end
q = add q ulong r
end
p = add p k
end
end
fn span off ulong n ulong total ulong to void
if gt off total
exit 65
end
if gt n sub total off
exit 65
end
end

global dispatchalarm ulong 1
text slowdispatchlabel "OMEGA alarm slow_dispatch_ns="
text slowdispatchthreshold " threshold_ns=10000000000\n"
fn slowdispatch elapsed ulong to void
if and eq get dispatchalarm 0 0 gt elapsed 10000000000
put dispatchalarm 0 1
emit slowdispatchlabel
printnum elapsed
emit slowdispatchthreshold
end
end

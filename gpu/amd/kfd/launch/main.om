note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
text manifestmagic "OMEGA refuse manifest field=magic\n"
text runmode "run"
text inspectmode "inspect"
text vaddmode "vadd"
text parsed "OMEGA elf=accepted image_bytes="
text argslabel " kernarg_bytes="
text passed "OMEGA vadd=PASS count=256\n"
global config ulong 3
fn mode name view uchar * to bool
n = patharg 1
if ne n len name
ret false
end
for i ulong n bound 4096
if ne get pathbuf i get name i
ret false
end
end
ret true
end
fn configread to void
fd = argfile 6 0
put config 0 ulong fd
size = filesize fd
span 0 48 size
note Eight ASCII bytes OMKFD001.
if ne fword fd 0 8 0x31303044464b4d4f
emitfd 2 manifestmagic
exit 64
end
if ne fword fd 8 8 get el 8
exit 64
end
put launch 4 fword fd 16 8
put launch 2 fword fd 24 8
put launch 3 fword fd 32 8
put config 1 fword fd 40 8
if gt get config 1 div get el 8 8
exit 64
end
put config 2 add 48 mul get config 1 16
span get config 2 get el 8 size
if ne add get config 2 get el 8 size
exit 64
end
if or eq get launch 4 0 eq get launch 2 0
exit 64
end
if gt get launch 2 9223372036854775807
exit 64
end
for i ulong get config 1 bound 9223372036854775807
p = add 48 mul i 16
off = fword fd p 8
span off 8 get el 8
if ne rem off 8 0
exit 64
end
if gt fword fd add p 8 8 get launch 1
exit 64
end
if ne fword fd add get config 2 off 8 0
exit 64
end
for j ulong i bound 9223372036854775807
if eq off fword fd add 48 mul j 16 8
exit 64
end
end
end
end
fn prepare to void
n = mul add get launch 1 8 24
put launch 0 ulong checked mapnew -1 0 n 3 34
r = allocate 0 get el 7 0xe0000001
stepbegin stload get el 7
loadelf r
stepend
r = allocate 1 get el 8 0xa4000002
r = allocate 2 get launch 4 0xa0000001
end
fn loadinputs to void
for i ulong get launch 1 bound 9223372036854775807
fd = argfile add i 7 0
size = filesize fd
if eq size 0
exit 64
end
h = allocate add i 8 size 0xa0000001
filecopy fd 0 h 0 size
r = checked fclose fd
end
filecopy int get config 0 get config 2 lh 1 0 get el 8
for i ulong get config 1 bound 9223372036854775807
p = add 48 mul i 16
off = fword int get config 0 p 8
idx = fword int get config 0 add p 8 8
h = lh 2
if lt idx get launch 1
h = lh add idx 8
end
r = checked mapset lh 1 off 8 mapaddr h
end
r = checked fclose int get config 0
end
fn vaddinputs to void
if ne get el 8 28
exit 65
end
h = allocate 8 1024 0xa0000001
h = allocate 9 1024 0xa0000001
note IEEE754 binary32 1 + 1 = 2; exact independent host oracle in the gate.
for i ulong 256
r = checked mapset lh 8 mul i 4 4 0x3f800000
r = checked mapset lh 9 mul i 4 4 0x3f800000
r = checked mapset lh 2 mul i 4 4 0x7fc00000
end
r = checked mapset lh 1 0 8 mapaddr lh 8
r = checked mapset lh 1 8 8 mapaddr lh 9
r = checked mapset lh 1 16 8 mapaddr lh 2
r = checked mapset lh 1 24 4 256
end
fn vaddcheck to void
for i ulong 256
if ne mapget lh 2 mul i 4 4 0x40000000
steprow 5 false
exit 76
end
end
emit passed
end
fn main to int
if ge argcnt 3
if mode planmode
ret planmain
end
end
if lt argcnt 4
ret 64
end
isinspect = mode inspectmode
isvadd = mode vaddmode
isrun = mode runmode
if not or isinspect or isvadd isrun
ret 64
end
parseelf 2 3
if isinspect
emit parsed
printnum get el 7
emit argslabel
printnum get el 8
emit newline
r = checked fclose int get el 0
ret 0
end
if isvadd
if not or eq argcnt 4 eq argcnt 5
ret 64
end
put launch 1 2
put diagstate 0 1
put launch 2 1
put launch 3 0
if eq argcnt 5
put launch 3 argnum 4
end
put launch 4 1024
put launch 5 4
put launch 6 1
else
if lt argcnt 8
ret 64
end
put launch 1 sub ulong argcnt 8
put launch 5 argnum 4
put launch 6 argnum 5
if or eq get launch 5 0 gt get launch 5 div ulong 4294967295 64
ret 64
end
if or eq get launch 6 0 gt get launch 6 4294967295
ret 64
end
configread
end
connectkfd
prepare
if isvadd
vaddinputs
else
loadinputs
end
queueinit
dispatch
stepbegin streadback get launch 4
if isvadd
vaddcheck
else
fd = argfile sub ulong argcnt 1 577
savefile fd lh 2 get launch 4
r = checked fclose fd
end
stepend
teardown
ret 0
end

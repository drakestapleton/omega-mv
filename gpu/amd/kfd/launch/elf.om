put el 11 d
put el 8 ew add d 8 4
put el 9 ew d 4
put el 10 ew add d 4 4
note This writer declares no private segment or hidden ABI arguments.
if or ne get el 10 0 gt get el 9 65536
exit 65
end
if ne and ew add d 56 2 1024 0
exit 65
end
note Scratch backing and its private/flat-scratch SGPR ABI are unsupported.
note ROCm7.2.2 AMDHSAKernelDescriptor.h: rsrc2 bit0; properties bits0,5,6,11.
if or ne and ew add d 52 4 1 0 ne and ew add d 56 2 2145 0
exit 65
end

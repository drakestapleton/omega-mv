q = ph j
if eq ew q 4 1
qb = ew add q 16 8
qe = add qb ew add q 40 8
if and lt base qe lt qb last
exit 65
end
end
end
end
end
fn parseopen fd int namelen ulong to void
for i ulong 12
put el i 0
end
put el 0 ulong fd
put el 1 filesize fd
span 0 64 get el 1
if or ne ew 0 4 1179403647 ne ew 4 4 1073807618
exit 65
end
if or ne ew 8 1 3 ne ew 16 4 14680067
exit 65

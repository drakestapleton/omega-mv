q = vaoff v 4
end
fn parseelf objarg ulong namearg ulong to void
fd = argfile objarg 0
n = patharg namearg
parseopen fd n
end
fn loadelf dst long to void
for i ulong get el 3 bound 65535
p = ph i
if eq ew p 4 1
filecopy int get el 0 ew add p 8 8 dst ew add p 16 8 ew add p 32 8
zeromap dst add ew add p 16 8 ew add p 32 8 sub ew add p 40 8 ew add p 32 8
end
end
end

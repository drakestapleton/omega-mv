note ELF64 HSA v5 gfx942 images emitted by backend/amd/gfx942/hsaco.om.
note el: fd,size,phoff,phnum,shoff,shnum,kdVA,imageBytes,kernarg,group,private,kdFile.
global el ulong 12
fn ew off ulong width ulong to ulong
ret fword int get el 0 off width
end
fn ph i ulong to ulong
ret add get el 2 mul i 56
end
fn sh i ulong to ulong
ret add get el 4 mul i 64
end
fn vaoff va ulong n ulong to ulong
for i ulong get el 3 bound 65535
p = ph i
if eq ew p 4 1
base = ew add p 16 8
if ge va base
d = sub va base
sz = ew add p 32 8
if le d sz
if le n sub sz d
ret add ew add p 8 8 d
end
end
end
end
end
exit 65
end
fn symmatch off ulong size ulong namelen ulong to bool
if lt size add namelen 4
ret false
end
for i ulong namelen bound 4096
if ne byteat int get el 0 add off i get pathbuf i
ret false
end
end
if ne byteat int get el 0 add off namelen 46
ret false
end
if ne byteat int get el 0 add add off namelen 1 107
ret false
end
if ne byteat int get el 0 add add off namelen 2 100
ret false
end
ret eq byteat int get el 0 add add off namelen 3 0
end
fn acceptsym s ulong to void
if or ne ew add s 4 1 17 ne ew add s 16 8 64
exit 65
end
v = ew add s 8 8
if ne get el 6 0
if ne get el 6 v
exit 65
end
end
if ne rem v 64 0
exit 65
end
put el 6 v
end
fn findsym sec ulong namelen ulong to void

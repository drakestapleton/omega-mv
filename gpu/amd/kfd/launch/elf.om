if ge linkidx get el 5
exit 65
end
strsec = sh linkidx
if ne ew add strsec 4 4 3
exit 65
end
strbase = ew add strsec 24 8
strsize = ew add strsec 32 8
span strbase strsize get el 1
base = ew add sec 24 8
size = ew add sec 32 8
span base size get el 1
if or ne ew add sec 56 8 24 ne rem size 24 0
exit 65
end
for i ulong div size 24 bound 9223372036854775807
s = add base mul i 24
noff = ew s 4
if ge noff strsize
exit 65
end

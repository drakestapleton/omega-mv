end
end
fn segment i ulong to void
p = ph i
if eq ew p 4 1
base = ew add p 16 8
sz = ew add p 32 8
memsz = ew add p 40 8
span ew add p 8 8 sz get el 1
if gt sz memsz
exit 65
end

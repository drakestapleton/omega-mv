text tsums " system_sum="

fn oreset to void
put on 0 0
end

fn obyte c ulong to void
n = get on 0
if ge n 255
ret
end
put ob n uchar and c 255
put on 0 add n 1
end

fn ostr t view uchar * to void
n = len t
for i ulong n bound 80
obyte ulong get t i
end
end

fn odig v ulong to void
q = div v 10
if ne q 0
odig q
end
obyte add 48 sub v mul q 10
end

fn onl to void
obyte 10
n = get on 0
r = write 1 ob 0 n
if ne r long n
exit 74
end
put on 0 0
end

fn fail m view uchar * c int to void
oreset
ostr tfail
ostr m
onl
oreset
ostr tsumf
onl
exit c
end

fn ok m view uchar * to void
oreset
ostr tpass
ostr m
onl
end

fn fdiv a ulong b ulong to ulong
ret ulong bitcast uint div bitcast f32 uint a bitcast f32 uint b
end

fn fmul a ulong b ulong to ulong
ret ulong bitcast uint mul bitcast f32 uint a bitcast f32 uint b
end

fn fsq a ulong to ulong
ret ulong bitcast uint fsqrt bitcast f32 uint a
end

fn fp8bits a ulong to ulong
v = and a 255
if eq v 128
ret 0x7fc00000
end
m = and v 127
if eq m 0
ret 0
end
e = shr m 3
f = and m 7
if eq e 0
e = ulong 120
while lt f 8 bound 3
f = shl f 1
e = sub e 1
end
else
e = add e 119
end
ret or shl and v 128 24 or shl e 23 shl and f 7 20
end

fn loadfix to void
for k ulong 4 bound 4
put wt k 0x3f800000
put sc k 0x3f800000
end
for i ulong 16 bound 16
put gw i 64
end
end

fn loadin v ulong to void
for i ulong 16 bound 16
put xin i v
end
end

fn fillnan to void
for i ulong 16 bound 16
put row i 0x7fc00000
end
end

fn copyxy to void
for i ulong 16 bound 16
put xin i get yout i
end
end

fn record cost ulong to void
n = get sampn 0
if ge n 8000
fail kstat 4
end
put samp n cost
put sampn 0 add n 1
end

fn rms g ulong to void
base = mul g 4
ss = ulong 0
for k ulong 4 bound 4
x = get xin add base k
ss = fpfma x x ss
end
mean = fdiv ss 0x40800000
inv = fdiv 0x3f800000 fsq mean
for k ulong 4 bound 4
x = get xin add base k
y = fmul x inv
y = fmul y get wt k
put row add base k y
end
end

fn gemv g ulong to void
for m ulong 4 bound 4
acc = ulong 0
for k ulong 4 bound 4
w = fp8bits get gw add mul m 4 k
x = get row mul k 4
acc = fpfma w x acc
end
y = fmul acc get sc m
put yout add mul g 4 m y
end
end

fn note_barrier to void
if eq get rec 0 0
ret
end
for g ulong 4 bound 4
cost = sub 3 g
if ne get cold 0 0
cost = add cost 1000
end
record cost
end
end

fn phased n ulong to void
loadin 0x3f800000
fillnan
for t ulong n bound 1000
for g ulong 4 bound 4
rms g
end
note_barrier
for g ulong 4 bound 4
gemv g
end
note_barrier
copyxy
end
end

fn mutant n ulong to void
loadin 0x3f800000
fillnan
for t ulong n bound 1000
for g ulong 4 bound 4
rms g
gemv g
end
copyxy
end
end

fn expect to bool
for i ulong 16 bound 16
if ne get row i 0x3f800000
ret false
end
if ne get yout i 0x40800000
ret false
end
end
ret true
end

fn saveref to void
for i ulong 16 bound 16
put ref i get yout i
end
end

fn matchref to bool
for i ulong 16 bound 16
if ne get yout i get ref i
ret false
end
end
ret true
end

fn nanout to bool
for i ulong 16 bound 16
if eq get yout i 0x7fc00000
ret true
end
end
ret false
end

fn numeric to void
loadfix
put rec 0 0
phased 1
if not expect
fail knum 11
end
phased 1000
if not expect
fail knum 12
end
saveref
phased 1000
if not matchref
fail knum 13
end
phased 1000
if not matchref
fail knum 14
end
mutant 1
if matchref
fail knum 15
end
if not nanout
fail knum 16
end
ok knum
end

fn align8 n ulong to ulong
if eq and n 7 0
ret n
end
ret and add n ulong 7 xor ulong 7 18446744073709551615
end

fn waves_vgpr n ulong to ulong
if lt n 8
ret 8
end
r = align8 n
w = div 512 r
if eq w 0
w = ulong 1
end
if gt w 8
w = ulong 8
end
ret w
end

fn sgpr_max w ulong to ulong
m = div 800 w
m = and m xor ulong 15 18446744073709551615
if gt m 102
m = ulong 102
end
ret m
end

fn waves_sgpr n ulong to ulong
if eq n 0
ret 8
end
w = ulong 8
while true bound 8
if ge sgpr_max w n
ret w
end
if eq w 1
ret 0
end
w = sub w 1
end
ret 0
end

fn groups vgpr ulong sgpr ulong lds ulong wgsz ulong cap ulong simd ulong to ulong
wv = waves_vgpr vgpr
ws = waves_sgpr sgpr
we = wv
if lt ws we
we = ws
end
if lt cap we
we = cap
end
if eq we 0
ret 0
end
if eq simd 0
ret 0
end
cuw = mul we simd
if eq wgsz 0
ret 0
end
wpg = div add wgsz 63 64
g = div cuw wpg
if gt wpg 1
if gt g 16
g = ulong 16
end
end
if ne lds 0
lg = div 65536 lds
if lt lg g
g = lg
end
end
ret g
end

fn cu_of simds ulong per ulong to ulong
if eq per 0
ret 0
end
q = div simds per
if ne mul q per simds
ret 0
end
ret q
end

fn fit grid ulong res ulong to bool
if eq res 0
ret false
end
ret le grid res
end

fn occupancy to void
g = groups 32 32 0 64 8 4
if ne g 32
fail kocc 21
end
if not fit 4 mul g 1
fail kocc 22
end
if fit 33 mul g 1
fail kocc 23
end
g = groups 512 32 0 64 8 4
if ne g 4
fail kocc 24
end
if not fit 4 g
fail kocc 25
end
if fit 5 g
fail kocc 26
end
g = groups 32 32 32768 64 8 4
if ne g 2
fail kocc 27
end
g = groups 32 103 0 64 8 4
if ne g 0
fail kocc 28
end
if ne cu_of 8 4 2
fail kocc 29
end
if ne cu_of 10 4 0
fail kocc 30
end
g = groups 32 32 0 128 8 4
if ne g 16
fail kocc 31
end
ok kocc
end

fn hdr b ulong acq ulong rel ulong to ulong
h = ulong 2
h = or h shl b 8
h = or h shl acq 9
h = or h shl rel 11
ret h
end

fn put16 off ulong v ulong to void
put pkt off uchar and v 255
put pkt add off 1 uchar and shr v 8 255
end

fn put32 off ulong v ulong to void
put16 off v
put16 add off 2 shr v 16
end

fn buildpkt b ulong acq ulong rel ulong gx ulong to void
put16 0 hdr b acq rel
put16 2 1
put16 4 64
put16 6 1
put16 8 1
put16 10 0
put32 12 gx
put32 16 1
put32 20 1
end

fn pktsum acq ulong rel ulong to ulong
h = hdr 1 acq rel
s = ulong 0
for i ulong 2000 bound 2000
s = add s h
end
ret s
end

fn aql to void
buildpkt 1 1 1 4
if ne get pkt 0 2
fail kaql 41
end
if ne get pkt 1 11
fail kaql 42
end
if ne get pkt 4 64
fail kaql 43
end
if ne get pkt 12 4
fail kaql 44
end
ha = hdr 1 1 1
hs = hdr 1 2 2
if ne pktsum 1 1 mul 2000 ha
fail kaql 45
end
if ne pktsum 2 2 mul 2000 hs
fail kaql 46
end
if eq ha hs
fail kaql 47
end
if ne and ha 256 256
fail kaql 48
end
hz = hdr 0 1 1
if eq hz ha
fail kaql 49
end
buildpkt 1 2 2 4
if ne get pkt 1 21
fail kaql 50
end
sa = pktsum 1 1
sb = pktsum 2 2
oreset
ostr tpass
ostr kaql
ostr taqp
odig 2000
ostr tbqp
odig 1
ostr tsuma
odig sa
ostr tsums
odig sb
onl
end

fn pass n ulong to int
local = xor get sense 0 1
put arrived 0 0
for g ulong n bound 4
put clock 0 add get clock 0 1
if gt get clock 0 get deadline 0
ret 2
end
t = get arrived 0
put arrived 0 add t 1
if eq t 3
put arrived 0 0
put sense 0 local
end
end
if eq n 4
ret 0
end
spins = ulong 0
while lt spins 16 bound 16
put clock 0 add get clock 0 1
if gt get clock 0 get deadline 0
ret 2
end
spins = add spins 1
end
ret 3
end

fn watchdog to void
put sense 0 0
put clock 0 0
put deadline 0 100
if ne pass 4 0
fail kwatch 61
end
if ne get sense 0 1
fail kwatch 62
end
if ne get arrived 0 0
fail kwatch 63
end
if ne pass 4 0
fail kwatch 64
end
if ne get sense 0 0
fail kwatch 65
end
put clock 0 0
put deadline 0 3
if ne pass 3 2
fail kwatch 66
end
put clock 0 0
put sense 0 0
put deadline 0 1000
if ne pass 3 3
fail kwatch 67
end
ok kwatch
end

fn isort n ulong to void
for i ulong n bound 8192
if eq i 0
continue
end
v = get samp i
j = i
while true bound 8192
if eq j 0
break
end
p = sub j 1
u = get samp p
if le u v
break
end
put samp j u
j = p
end
put samp j v
end
end

fn median n ulong to ulong
if eq and n 1 1
ret get samp div n 2
end
a = get samp sub div n 2 1
b = get samp div n 2
ret div add a b 2
end

fn p99 n ulong to ulong
rank = div add mul n 99 99 100
if eq rank 0
rank = ulong 1
end
ret get samp sub rank 1
end

fn putpair a ulong b ulong to void
odig a
ostr comma
odig b
end

fn stats_unit to void
put samp 0 5
put samp 1 1
put samp 2 4
put samp 3 2
put samp 4 3
isort 5
if ne median 5 3
fail kstat 71
end
if ne p99 5 5
fail kstat 72
end
if ne get samp 4 5
fail kstat 73
end
put samp 0 10
put samp 1 20
isort 2
if ne median 2 15
fail kstat 74
end
if ne p99 2 20
fail kstat 75
end
put samp 0 7
isort 1
if ne median 1 7
fail kstat 76
end
if ne p99 1 7
fail kstat 77
end
end

fn fill_model to void
put sampn 0 0
put rec 0 1
phased 1000
put rec 0 0
if ne get sampn 0 8000
fail kstat 78
end
isort 8000
end

fn stats to void
stats_unit
put cold 0 0
fill_model
wm = median 8000
wp = p99 8000
wx = get samp 7999
w0 = get samp 0
wa = get samp 3999
wb = get samp 4000
if ne wm 1
fail kstat 79
end
if ne wp 3
fail kstat 80
end
if ne wx 3
fail kstat 81
end
put cold 0 1
fill_model
cm = median 8000
cp = p99 8000
cx = get samp 7999
c0 = get samp 0
ca = get samp 3999
cb = get samp 4000
if ne cm 1001
fail kstat 82
end
if ne cp 1003
fail kstat 83
end
if ne cx 1003
fail kstat 84
end
oreset
ostr tpass
ostr kstat
ostr tmodel
ostr sp
ostr twmed
odig wm
ostr sp
ostr twcen
putpair wa wb
ostr sp
ostr twp
odig wp
ostr sp
ostr twx
odig wx
ostr sp
ostr twsp
odig sub wx w0
ostr sp
ostr tcmed
odig cm
ostr sp
ostr tccen
putpair ca cb
ostr sp
ostr tcp
odig cp
ostr sp
ostr tcx
odig cx
ostr sp
ostr tcsp
odig sub cx c0
onl
end

fn peekc to ulong
if ge get ix 0 get filen 0
ret 0
end
ret ulong get filebuf get ix 0
end

fn hexval c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
if and ge c 65 le c 70
ret sub c 55
end
ret 99
end

fn skip to void
while true bound 65536
if ge get ix 0 get filen 0
ret
end
c = peekc
if eq c 35
while true bound 512
if ge get ix 0 get filen 0
ret
end
c = peekc
put ix 0 add get ix 0 1
if eq c 10
break
end
end
continue
end
if gt c 32
ret
end
put ix 0 add get ix 0 1
end
end

fn dec to ulong
skip
v = ulong 0
any = ulong 0
while true bound 8
c = peekc
if or lt c 48 gt c 57
break
end
any = ulong 1
v = add mul v 10 sub c 48
put ix 0 add get ix 0 1
end
if eq any 0
ret 100
end
ret v
end

fn hex2 to ulong
skip
hi = hexval peekc
put ix 0 add get ix 0 1
lo = hexval peekc
put ix 0 add get ix 0 1
if or eq hi 99 eq lo 99
ret 256
end
ret add mul hi 16 lo
end

fn slurp to long
fd = fopen pathb 0 get pathn 0 0 0
if lt fd 0
ret fd
end
off = ulong 0
while lt off 8192 bound 8192
r = read int fd filebuf off 1024
if lt r 0
c = fclose int fd
ret r
end
if eq r 0
break
end
off = add off ulong r
if ge off 8192
c = fclose int fd
ret -22
end
end
c = fclose int fd
put filen 0 off
ret 0
end

fn loadgold to void
pathset mcgold
r = slurp
if ne r 0
fail kmc 91
end
put ix 0 0
put expn 0 0
put eoff 0 0
while lt get ix 0 get filen 0 bound 64
skip
if ge get ix 0 get filen 0
break
end
n = dec
if or eq n 0 gt n 8
fail kmc 92
end
k = get expn 0
if ge k 32
fail kmc 93
end
put explen k n
for i ulong n bound 8
b = hex2
if ge b 256
fail kmc 94
end
p = get eoff 0
if ge p 256
fail kmc 95
end
put exp p uchar b
put eoff 0 add p 1
end
put expn 0 add k 1
end
if ne get expn 0 27
fail kmc 96
end
end

fn areset to void
put avn 0 0
put avp 0 2
put av 0 0
put av 1 0
end

fn afix to void
p = get avp 0
q = get avl 0
m = sub sub p q 2
put av q uchar and m 255
put av add q 1 uchar shr m 8
end

fn anew to void
p = get avp 0
put avl 0 p
put avp 0 add p 2
afix
c = add get avn 0 1
put avn 0 c
put av 0 uchar and c 255
put av 1 uchar shr c 8
end

fn amore t view uchar * to void
p = get avp 0
n = len t
for i ulong n bound 80
put av add p i get t i
end
put avp 0 add p n
afix
end

fn aadd t view uchar * to void
anew
amore t
end

fn findkey to bool
k = len enckey
while true bound 65536
if gt add get ix 0 k get filen 0
ret false
end
good = true
for i ulong k bound 16
if ne get filebuf add get ix 0 i get enckey i
good = false
break
end
end
if good
put ix 0 add get ix 0 k
ret true
end
put ix 0 add get ix 0 1
end
ret false
end

fn parsebyte to ulong
while true bound 16
if ge get ix 0 get filen 0
ret 257
end
c = peekc
if eq c 93
ret 256
end
if eq c 120
break
end
put ix 0 add get ix 0 1
end
put ix 0 add get ix 0 1
hi = hexval peekc
put ix 0 add get ix 0 1
lo = hexval peekc
put ix 0 add get ix 0 1
if or eq hi 99 eq lo 99
ret 258
end
ret add mul hi 16 lo
end

fn parselive to void
put ix 0 0
put liven 0 0
put loff 0 0
while true bound 64
if not findkey
break
end
k = get liven 0
n = ulong 0
while true bound 16
b = parsebyte
if eq b 256
break
end
if ge b 256
fail kmc 97
end
p = get loff 0
put live p uchar b
put loff 0 add p 1
n = add n 1
end
put livelen k n
put liven 0 add k 1
end
end

fn same to bool
if ne get expn 0 get liven 0
ret false
end
for i ulong get expn 0 bound 32
if ne get explen i get livelen i
ret false
end
end
nb = get eoff 0
if ne nb get loff 0
ret false
end
for i ulong nb bound 256
if ne get exp i get live i
ret false
end
end
ret true
end

fn ioff ins ulong to ulong
o = ulong 0
for i ulong ins bound 32
o = add o get explen i
end
ret o
end

fn diffbits a ulong b ulong to ulong
na = get explen a
if ne na get explen b
ret 99
end
pa = ioff a
pb = ioff b
d = ulong 0
for i ulong na bound 8
x = xor get live add pa i get live add pb i
while ne x 0 bound 8
if ne and x 1 0
d = add d 1
end
x = shr x 1
end
end
ret d
end

fn mcrun to int
areset
aadd mcbin
aadd mctri
aadd mccpu
aadd mcenc
aadd mcseq
fd = fopen mcout 0 len mcout 577 448
if lt fd 0
ret 1
end
pid = fork
if lt pid 0
c = fclose int fd
ret 2
end
if eq pid 0
r = dupfd int fd 1 0
r = execprog av 0 get avp 0
exit 98
end
c = fclose int fd
w = waitpid int pid stbuf 0 4 0
if ne w pid
ret 3
end
if ne and get stbuf 0 127 0
ret 4
end
if ne get stbuf 1 0
ret 5
end
ret 0
end

fn llvm to void
probe = fopen mcbin 0 len mcbin 0 0
if lt probe 0
fail kmc 101
end
c = fclose int probe
loadgold
e = mcrun
if ne e 0
fail kmc 102
end
pathset mcout
r = slurp
if ne r 0
fail kmc 103
end
parselive
if not same
fail kmc 104
end
if ne diffbits 0 3 1
fail kmc 105
end
if ne diffbits 8 11 1
fail kmc 106
end
if ne diffbits 12 13 1
fail kmc 107
end
if ne diffbits 12 14 1
fail kmc 108
end
if ne diffbits 13 15 1
fail kmc 109
end
if ne diffbits 2 12 2
fail kmc 110
end
if eq diffbits 16 17 0
fail kmc 111
end
oreset
ostr tpass
ostr kmc
ostr tenc
odig get expn 0
ostr tdiff
onl
end

fn pathset t view uchar * to void
n = len t
for i ulong n bound 80
put pathb i get t i
end
put pathn 0 n
end

fn pathadd t view uchar * to void
p = get pathn 0
n = len t

text txcc " num_xcc="
text tgrid "plan_grid="
text tgpc " groups_per_cu="
text tres " resident="
text tfit " fit="
text tyes "yes"
text tabort "abort"
text tfwv "kfd_fw_version="
text tclkv "kfd_max_engine_clk_fcompute="
text tcur "current_clock="
text tflush " source=formula flush=NOT_RUN"
text tldsk " lds_kb="

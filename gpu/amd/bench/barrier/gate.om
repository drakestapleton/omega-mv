note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Persistent-kernel barrier micro-benchmark. Compiled after gpu/amd/gfx942/exec/fma.om,
note under target x86linux and om2, so the host can exec llvm-mc. fpfma is the GEMV
note reduction. This program does not submit an AQL packet and does not reset a GPU.
note See README.md. hardware timings are NOT_RUN on every host, including one with a card.

global xin ulong 16
global row ulong 16
global yout ulong 16
global ref ulong 16
global wt ulong 4
global gw ulong 16
global sc ulong 4
global samp ulong 8000
global sampn ulong 1
global rec ulong 1
global cold ulong 1
global sense ulong 1
global arrived ulong 1
global clock ulong 1
global deadline ulong 1
global ob uchar 256
global on ulong 1
global filebuf uchar 8192
global filen ulong 1
global ix ulong 1
global exp uchar 256
global explen ulong 32
global expn ulong 1
global eoff ulong 1
global live uchar 256
global livelen ulong 32
global liven ulong 1
global loff ulong 1
global pathb uchar 160
global pathn ulong 1
global kbuf uchar 128
global kn ulong 1
global dv ulong 12
global dgot ulong 1
global saw ulong 1
global pkt uchar 64
global av uchar 1024
global avp ulong 1
global avn ulong 1
global avl ulong 1
global stbuf uchar 4
global pre uchar 96
global pren ulong 1
global miss long 1

text sp " "
text comma ","
text tpass "PASS "
text tfail "FAIL "
text tmodel "source=model"
text tnotrun "NOT_RUN"
text tabsent "device=absent"
text tpresent "device=present"
text tnosys " reason=no-sysfs errno="
text tnofx " reason=no-gfx942"
text thw "hardware=NOT_RUN reason=no-submit"
text tsum "OMEGA-GPU-AMD-BARRIER PASS llvm-mc=PASS hardware=NOT_RUN"
text tsumf "OMEGA-GPU-AMD-BARRIER FAIL"
text mcbin "/usr/bin/llvm-mc-18"
text mctri "-triple=amdgcn"
text mccpu "-mcpu=gfx942"
text mcenc "-show-encoding"
text mcseq "gpu/amd/bench/barrier/seq.s"
text mcgold "gpu/amd/bench/barrier/seq.enc"
text mcout "/tmp/omega-barrier-mc.out"
text enckey "encoding: ["
text kfdpre "/sys/class/kfd/kfd/topology/nodes/"
text propsuf "/properties"
text osrel "/proc/sys/kernel/osrelease"
text rocm1 "/opt/rocm/.info/version"
text rocm2 "/opt/rocm/.info/version-dev"
text kgfx "gfx_target_version"
text ksimd "simd_count"
text kspc "simd_per_cu"
text kwave "max_waves_per_simd"
text kxcc "num_xcc"
text klds "lds_size_in_kb"
text kfw "fw_version"
text kclk "max_engine_clk_fcompute"
text kdrm "drm_render_minor"
text knum "numeric "
text kocc "occupancy "
text kaql "aql "
text kwatch "watchdog "
text kstat "stats "
text kmc "llvm-mc="
text kform "cold_formula "
text kkern "kernel="
text twmed "warm_median="
text twcen "warm_central="
text twp "warm_p99="
text twx "warm_max="
text twsp "warm_spread="
text tcmed "cold_median="
text tccen "cold_central="
text tcp "cold_p99="
text tcx "cold_max="
text tcsp "cold_spread="
text tenc "PASS encodings="
text tdiff " diff_wbl2=1 diff_inv=1 diff_nt=1 diff_sc1=1 diff_ticket=2"
text trocm "rocm="
text tformv "xcc=8 l2_per_xcc=4194304 mall=268435456 bytes=603979776"
text tfw "firmware="
text tclk "clocks="

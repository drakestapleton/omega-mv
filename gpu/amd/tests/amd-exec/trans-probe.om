note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test-only 8-byte (opcode, input bits) to 4-byte result; short record exits 74.
global tb uchar 8
fn tbword p ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get tb add p i mul i 8
end
ret v
end
fn main to int
while true bound 999999
n = ulong 0
while lt n 8 bound 999999
r = read 0 tb n sub 8 n
if lt r 0
ret 74
end
if eq r 0
if eq n 0
ret 0
end
ret 74
end
n = add n ulong r
end
op = tbword 0
v = tbword 4
if eq op 32
v = fpexp v
else
if eq op 34
v = fprcp v
else
if ne op 36
ret 66
end
v = fprsq v
end
end
for i ulong 4
put tb i uchar and shr v mul i 8 255
end
n = 0
while lt n 4 bound 999999
r = write 1 tb n sub 4 n
if le r 0
ret 74
end
n = add n ulong r
end
end
ret 0
end

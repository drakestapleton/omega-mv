note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test-only streaming interface: 12-byte little-endian (a,b,c) -> 4-byte result.
global fb uchar 12
fn fbword p ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get fb add p i mul i 8
end
ret v
end
fn main to int
while true bound 999999
n = ulong 0
while lt n 12 bound 999999
r = read 0 fb n sub 12 n
if lt r 0
ret 74
end
if eq r 0
if eq n 0
ret 0
end
ret 74
end
n = add n ulong r
end
v = fpfma fbword 0 fbword 4 fbword 8
for i ulong 4
put fb i uchar and shr v mul i 8 255
end
n = 0
while lt n 4 bound 999999
r = write 1 fb n sub 4 n
if le r 0
ret 74
end
n = add n ulong r
end
end
ret 0
end

note Test-only entry: execute specified row IDs, retaining the real full M/K and row stride.
fn main to int
if lt argcnt 4
ret 64
end
put st 0 openarg 1 0
put st 1 filesize get st 0
if or eq get st 1 0 ne and get st 1 3 0
ret 65
end
validate
put st 2 openarg 2 2
put st 3 filesize get st 2
for i ulong sub ulong argcnt 3
wave gridarg add i 3 0
end
if ne fclose int get st 2 0
ret 74
end
if ne fclose int get st 0 0
ret 74
end
ret 0
end

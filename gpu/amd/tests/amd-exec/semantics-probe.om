note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test adapter only: invokes production step, without reimplementing an instruction.
note argv RAW_TEXT MEMORY STATE; STATE has masks/SCC, sparse register seeds, then queries.
global ps ulong 3
fn pword to ulong
v = rdword int get ps 0 get ps 1 get ps 2
put ps 1 add get ps 1 4
ret v
end
fn pwide to ulong
a = pword
ret or a shl pword 32
end
fn pout v ulong to void
for j ulong 2
for i ulong 4
put io i uchar and shr v add mul j 32 mul i 8 255
end
n = ulong 0
while lt n 4 bound 999999
r = write 1 io n sub 4 n
if le r 0
fail 74
end
n = add n ulong r
end
end
end
fn seeds to void
n = pword
for i ulong n
b = pword
r = pword
v = pword
if eq b 0
put sr r v
else
put vr r v
end
end
end
fn queries to void
n = pword
for i ulong n
b = pword
r = pword
v = ulong 0
if eq b 0
v = get sr r
end
if eq b 1
v = get vr r
end
if eq b 2
v = get st r
end
pout v
end
end
fn main to int
if ne argcnt 4
ret 64
end
put st 0 openarg 1 0
put st 1 filesize get st 0
put st 2 openarg 2 2
put st 3 filesize get st 2
put ps 0 openarg 3 0
put ps 2 filesize get ps 0
put st 14 pwide
put st 15 pwide
put st 16 pword
seeds
running = step 0
pout fmbool running
queries
ret 0
end

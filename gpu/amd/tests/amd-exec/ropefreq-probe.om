note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Test-only entry point composed with rope.om before its main.
fn main to int
for i ulong 32
rput mul i 4 f64 rfreq i
end
n = ulong 0
while lt n 128 bound 999999
r = write 1 rout n sub 128 n
if le r 0
ret 74
end
n = add n ulong r
end
ret 0
end

note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Exact binary32 fused multiply-add, RN-even, gradual underflow, canonical NaN.
note Finite x = mantissa * 2^(effective_exponent-150). Scale exact sum by 2^298.
note Products and addends then are integers; their sum needs at most 554 bits, hence nine u64 limbs.
note This is a format-derived bound, not an input cap. No intermediate floating-point rounding.
global fm ulong 9
global fc ulong 9
fn fmbool value bool to ulong
if value
ret 1
end
ret 0
end
fn fmexp x ulong to ulong
e = and shr x 23 255
if eq e 0
ret 1
end
ret e
end
fn fmmant x ulong to ulong
v = and x 0x7fffff
if ne and x 0x7f800000 0
v = or v 0x800000
end
ret v
end
fn fmput other bool i ulong v ulong to void
if other
put fc i v
else
put fm i v
end
end
fn fmplace other bool v ulong shift ulong to void
i = div shift 64
s = and shift 63
fmput other i shl v s
if and ne s 0 lt add i 1 len fm
fmput other add i 1 shr v sub 64 s
end
end
fn fmmag to int
for j ulong 9
i = sub 8 j
if gt get fm i get fc i
ret 1
end
if lt get fm i get fc i
ret -1
end
end
ret 0
end
fn fmadd to void
cy = ulong 0
for i ulong 9
a = get fm i
b = get fc i
v = add a b
c = lt v a
w = add v cy
cy = fmbool or c lt w v
put fm i w
end
end
fn fmsub swap bool to void
borrow = ulong 0
for i ulong 9
a = get fm i
b = get fc i
if swap
t = a
a = b
b = t
end
v = sub a b
c = lt a b
w = sub v borrow
borrow = fmbool or c lt v borrow
put fm i w
end
end
fn fmget shift ulong to ulong
i = div shift 64
s = and shift 63
v = shr get fm i s
if and ne s 0 lt add i 1 len fm
v = or v shl get fm add i 1 sub 64 s
end
ret v
end
fn fmsticky limit ulong to bool
full = div limit 64
for i ulong full
if ne get fm i 0
ret true
end
end
bits = and limit 63
if ne bits 0
if ne and get fm full sub shl ulong 1 bits 1 0
ret true
end
end
ret false
end
fn fmround sg ulong to ulong
n = ulong 0
for j ulong 9
i = sub 8 j
v = get fm i
if ne v 0
n = mul i 64
while gt v 1 bound 999999
v = shr v 1
n = add n 1
end
break
end
end
shift = ulong 149
if gt n 172
shift = sub n 23
end
m = and fmget shift 0xffffff
half = ne and fmget sub shift 1 1 0
if and half or fmsticky sub shift 1 ne and m 1 0
m = add m 1
end
if ge m 0x1000000
m = shr m 1
n = add n 1
end
if ge n 426
ret or sg 0x7f800000
end
e = ulong 0
if ge m 0x800000
e = 1
if gt n 172
e = sub n 171
end
end
ret or sg or shl e 23 and m 0x7fffff
end
fn fmfinite a ulong b ulong c ulong to ulong
for i ulong 9
put fm i 0
put fc i 0
end
p = mul fmmant a fmmant b
shift = sub add fmexp a fmexp b 2
fmplace false p shift
fmplace true fmmant c add fmexp c 148
sp = and xor a b 0x80000000
sc = and c 0x80000000
sg = sp
if eq sp sc
fmadd
else
cmp = fmmag
if eq cmp 0
ret 0
end
if lt cmp 0
sg = sc
end
fmsub lt cmp 0
end
ret fmround sg
end
fn fpfma a ulong b ulong c ulong to ulong
ax = and a 0x7fffffff
bx = and b 0x7fffffff
cx = and c 0x7fffffff
if or or gt ax 0x7f800000 gt bx 0x7f800000 gt cx 0x7f800000
ret 0x7fc00000
end
sp = and xor a b 0x80000000
if or eq ax 0x7f800000 eq bx 0x7f800000
if or eq ax 0 eq bx 0
ret 0x7fc00000
end
if and eq cx 0x7f800000 ne sp and c 0x80000000
ret 0x7fc00000
end
ret or sp 0x7f800000
end
if eq cx 0x7f800000
ret c
end
if and or eq ax 0 eq bx 0 eq cx 0
ret and sp and c 0x80000000
end
ret fmfinite a b c
end

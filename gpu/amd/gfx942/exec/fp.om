om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gfx942 host executor, composed with main.om. No host floating point or FPCR dependency.
note Binary32 addition: magnitude-order operands, align with guard/round/sticky, normalize,
note round nearest ties even, gradual underflow. Exact cancellation is +0; -0 + -0 is -0.
note NaNs and invalid infinity addition produce canonical quiet NaN 0x7fc00000.
note NaN payload/sign propagation is not specified by IEEE arithmetic; this is the model policy.
note tests/amd-exec/oracle.py checks bit patterns against independently rounded Python float/struct.
fn jam x ulong n ulong to ulong
if eq n 0
ret x
end
if ge n 64
if ne x 0
ret 1
end
ret 0
end
r = shr x n
if ne and x sub shl ulong 1 n 1 0
r = or r 1
end
ret r
end
fn fpround am ulong ae ulong sg ulong to ulong
lo = and am 7
am = shr am 3
if or gt lo 4 and eq lo 4 ne and am 1 0
am = add am 1
end
if ge am 0x1000000
am = shr am 1
ae = add ae 1
end
if ge ae 255
ret or sg 0x7f800000
end
if lt am 0x800000
ae = 0
end
ret or or sg shl ae 23 and am 0x7fffff
end
fn fpadd a ulong b ulong to ulong
ax = and a 0x7fffffff
bx = and b 0x7fffffff
if or gt ax 0x7f800000 gt bx 0x7f800000
ret 0x7fc00000
end
if eq ax 0x7f800000
if and eq bx ax ne shr a 31 shr b 31
ret 0x7fc00000
end
ret a
end
if eq bx 0x7f800000
ret b
end
if lt ax bx
t = a
a = b
b = t
t = ax
ax = bx
bx = t
end
if eq ax 0
ret and and a b 0x80000000
end
sg = and a 0x80000000
ae = shr ax 23
be = shr bx 23
am = and ax 0x7fffff
bm = and bx 0x7fffff
if ne ae 0
am = or am 0x800000
else
ae = 1
end
if ne be 0
bm = or bm 0x800000
else
be = 1
end
am = shl am 3
bm = jam shl bm 3 sub ae be
if eq and xor a b 0x80000000 0
am = add am bm
if ge am 0x8000000
am = jam am 1
ae = add ae 1
end
else
am = sub am bm
if eq am 0
ret 0
end
while and lt am 0x4000000 gt ae 1 bound 999999
am = shl am 1
ae = sub ae 1
end
end
ret fpround am ae sg
end

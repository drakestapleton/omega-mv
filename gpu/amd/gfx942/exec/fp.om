om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gfx942 host executor. ADD is integer-only; bounded EXP/LOG/RCP/RSQ representatives use native binary64.
note Binary32 addition: magnitude-order operands, align with guard/round/sticky, normalize,
note round nearest ties even, gradual underflow. Exact cancellation is +0; -0 + -0 is -0.
note NaNs and invalid infinity addition produce canonical quiet NaN 0x7fc00000.
note NaN payload/sign propagation is not specified by IEEE arithmetic; this is the model policy.
note tests/amd-exec/oracle.py checks bit patterns against independently rounded Python float/struct.
fn jam x ulong n ulong to ulong
if eq n 0
ret x
end
if ge n 64
if ne x 0
ret 1
end
ret 0
end
r = shr x n
if ne and x sub shl ulong 1 n 1 0
r = or r 1
end
ret r
end
fn fpround am ulong ae ulong sg ulong to ulong
lo = and am 7
am = shr am 3
if or gt lo 4 and eq lo 4 ne and am 1 0
am = add am 1
end
if ge am 0x1000000
am = shr am 1
ae = add ae 1
end
if ge ae 255
ret or sg 0x7f800000
end
if lt am 0x800000
ae = 0
end
ret or or sg shl ae 23 and am 0x7fffff
end
fn fpadd a ulong b ulong to ulong
ax = and a 0x7fffffff
bx = and b 0x7fffffff
if or gt ax 0x7f800000 gt bx 0x7f800000
ret 0x7fc00000
end
if eq ax 0x7f800000
if and eq bx ax ne shr a 31 shr b 31
ret 0x7fc00000
end
ret a
end
if eq bx 0x7f800000
ret b
end
if lt ax bx
t = a
a = b
b = t
t = ax
ax = bx
bx = t
end
if eq ax 0
ret and and a b 0x80000000
end
sg = and a 0x80000000
ae = shr ax 23
be = shr bx 23
am = and ax 0x7fffff
bm = and bx 0x7fffff
if ne ae 0
am = or am 0x800000
else
ae = 1
end
if ne be 0
bm = or bm 0x800000
else
be = 1
end
am = shl am 3
bm = jam shl bm 3 sub ae be
if eq and xor a b 0x80000000 0
am = add am bm
if ge am 0x8000000
am = jam am 1
ae = add ae 1
end
else
am = sub am bm
if eq am 0
ret 0
end
while and lt am 0x4000000 gt ae 1 bound 999999
am = shl am 1
ae = sub ae 1
end
end
ret fpround am ae sg
end
note CDNA3 PDF p172, IEEE mode: signaling NaNs quiet before numeric max; prefer +0.
fn fpmax a ulong b ulong to ulong
ax = and a 0x7fffffff
bx = and b 0x7fffffff
if and gt ax 0x7f800000 eq and ax 0x400000 0
ret or a 0x400000
end
if and gt bx 0x7f800000 eq and bx 0x400000 0
ret or b 0x400000
end
if gt ax 0x7f800000
ret b
end
if gt bx 0x7f800000
ret a
end
if and eq ax 0 eq bx 0
ret and a b
end
if ge bitcast f32 uint a bitcast f32 uint b
ret a
end
ret b
end
note Transcendental representative, not a claim of device bit identity. PDF pp195-196: 1ULP, FTZ.
note Native binary64 arithmetic only here. Decimal oracle bounds each result independently.
fn fpftz a ulong to ulong
if lt and a 0x7fffffff 0x800000
ret and a 0x80000000
end
ret a
end
fn fpexp a ulong to ulong
if gt and a 0x7fffffff 0x7f800000
ret 0x7fc00000
end
x = f64 bitcast f32 uint fpftz a
if ge x 128.0f64
ret 0x7f800000
end
if lt x -126.0f64
ret 0
end
n = int x
if lt x f64 n
n = sub n 1
end
r = mul sub x f64 n 0.6931471805599453f64
t = 1.0f64
y = 1.0f64
for j ulong 18
t = div mul t r f64 add j 1
y = add y t
end
scale = bitcast f64 shl ulong add n 1023 52
ret fpftz ulong bitcast uint f32 mul y scale
end
note CDNA3 V_LOG_F32 opcode33: base2 log, 1ULP and input/output FTZ.
note Reduce to mantissa [1,2); log(m)=2*(z+z^3/3+...), z=(m-1)/(m+1).
note Thirty terms at |z|<=1/3 put truncation far below binary32 rounding.
fn fplog a ulong to ulong
a = fpftz a
ax = and a 0x7fffffff
if gt ax 0x7f800000
ret or and a 0x80000000 0x7fc00000
end
if eq ax 0
ret 0xff800000
end
if ne and a 0x80000000 0
ret 0xffc00000
end
if eq ax 0x7f800000
ret a
end
n = sub int shr ax 23 127
m = f64 bitcast f32 uint or and ax 0x7fffff 0x3f800000
z = div sub m 1.0f64 add m 1.0f64
zz = mul z z
t = z
y = z
for j ulong 29
t = mul t zz
y = add y div t f64 add mul add j 1 2 1
end
ret fpftz ulong bitcast uint f32 add f64 n div mul y 2.0f64 0.6931471805599453f64
end
fn fprcp a ulong to ulong
a = fpftz a
if gt and a 0x7fffffff 0x7f800000
ret 0x7fc00000
end
if eq and a 0x7fffffff 0
ret or and a 0x80000000 0x7f800000
end
x = f64 bitcast f32 uint a
ret fpftz ulong bitcast uint f32 div 1.0f64 x
end
note CDNA3 PDF p197: reciprocal square root, 1ULP and FTZ; preserve the signed-zero examples.
fn fprsq a ulong to ulong
a = fpftz a
if gt and a 0x7fffffff 0x7f800000
ret or and a 0x80000000 0x7fc00000
end
if eq and a 0x7fffffff 0
ret or and a 0x80000000 0x7f800000
end
if ne and a 0x80000000 0
ret 0xffc00000
end
x = f64 bitcast f32 uint a
ret fpftz ulong bitcast uint f32 div 1.0f64 fsqrt x
end

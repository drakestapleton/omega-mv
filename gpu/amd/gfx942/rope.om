om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Q27 config 017b9c7a: theta 10000000, rotary dim 64; text positions share all MRoPE axes.
note Input exactly one little-endian u32 position; output cos[32], sin[32] binary32 words.
note Explicit binary32 frequency, position and angle boundaries follow Transformers v5.8.0.
note Binary64 exp and Cody-Waite reduction; no libm, host runtime, Python or GPU dependency.
note Exit 64 for a malformed position record, 74 for I/O failure. No output on malformed input.
global rin uchar 4
global rout uchar 256
global rend uchar 1
global trig f64 2
fn rexp x f64 to f64
n = uint div x 0.6931471805599453f64
r = sub x mul f64 n 0.6931471805599453f64
t = 1.0f64
y = 1.0f64
for j ulong 18
t = div mul t r f64 add j 1
y = add y t
end
scale = bitcast f64 shl add ulong n 1023 52
ret mul y scale
end
fn rfreq i ulong to f32
x = div mul f64 i 16.11809565095832f64 32.0f64
power = f32 rexp x
ret div 1.0f32 power
end
fn rtrig x f64 to void
n = ulong add mul x 0.6366197723675813f64 0.5f64
r = sub x mul f64 n 1.570796012878418f64
r = sub r mul f64 n bitcast f64 ulong 0x3e95110b4611a626
z = neg mul r r
st = r
sv = r
ct = 1.0f64
cv = 1.0f64
for j ulong 10
k = add mul j 2 2
st = div mul st z f64 mul k add k 1
ct = div mul ct z f64 mul k sub k 1
sv = add sv st
cv = add cv ct
end
q = and n 3
if eq q 0
put trig 0 cv
put trig 1 sv
end
if eq q 1
put trig 0 neg sv
put trig 1 cv
end
if eq q 2
put trig 0 neg cv
put trig 1 neg sv
end
if eq q 3
put trig 0 sv
put trig 1 neg cv
end
end
fn rput p ulong x f64 to void
b = ulong bitcast uint f32 x
for j ulong 4
put rout add p j uchar and shr b mul j 8 255
end
end
fn main to int
n = ulong 0
while lt n 4 bound 999999
r = read 0 rin n sub 4 n
if lt r 0
ret 74
end
if eq r 0
ret 64
end
n = add n ulong r
end
r = read 0 rend 0 1
if lt r 0
ret 74
end
if ne r 0
ret 64
end
p = ulong 0
for j ulong 4
p = or p shl ulong get rin j mul j 8
end
for i ulong 32
angle = mul f32 p rfreq i
rtrig f64 angle
rput mul i 4 get trig 0
rput add 128 mul i 4 get trig 1
end
n = 0
while lt n 256 bound 999999
r = write 1 rout n sub 256 n
if le r 0
ret 74
end
n = add n ulong r
end
ret 0
end

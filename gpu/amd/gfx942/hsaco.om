om2
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note gfx942 code-object writer. Usage: hsaco TABLE > kernel.hsaco (TABLE is a seekable file).
note Instruction words and kernel metadata come from TABLE, packed by Omega, never LLVM.
note tables and MessagePack metadata are serialized below. No device, subprocess or library opens.
note LLVM 18.1.3 public sources are the format authority; see PROVENANCE.md and tests/amd/run.sh.
note Schema: exactly the eight formats in vadd.isa; each field occupies >=1 of at most 64 bits.
note Three streaming passes: locate label, validate fields, then emit. No table/line/code-size buffer.
note Numeric T labels and @ references resolve through a growable anonymous file, with checked signed SOPP offsets.
note The producer uses stdout and a seekable instruction-table argument. Exit 2 usage, 3 I/O,
note 4 bad table; ELF layout targets gfx942 HSA v5, not a general assembler/linker.
note Loops are bound 999999: the pinned omc (omega-mv e5b32567) refuses a larger bound with error 8.
note A table that needs more passes traps 4 (a clean refusal); a newer pin lifts the number.
text use "usage: hsaco /path/to/kernel.isa > kernel.hsaco\n"
text ioerr "hsaco: I/O error\n"
text tblerr "hsaco: invalid instruction table\n"
text owner "AMDGPU"
text kdsuf ".kd"
text target "amdgcn-amd-amdhsa--gfx942"
text ver "amdhsa.version"
text kernels "amdhsa.kernels"
text tgtkey "amdhsa.target"
text kname ".name"
text ksym ".symbol"
text kargs ".args"
text ksize ".kernarg_segment_size"
text kalign ".kernarg_segment_align"
text kgroup ".group_segment_fixed_size"
text kpriv ".private_segment_fixed_size"
text kwave ".wavefront_size"
text ksgpr ".sgpr_count"
text kvgpr ".vgpr_count"
text kagpr ".agpr_count"
text kmax ".max_flat_workgroup_size"
text aname ".name"
text aoffset ".offset"
text asize ".size"
text akind ".value_kind"
text aspace ".address_space"
text aglobal "global"
text abuffer "global_buffer"
text avalue "by_value"
text stext ".text"
text sdata ".rodata"
text snote ".note"
text sstr ".strtab"
text ssym ".symtab"
text sdyn ".dynsym"
text sds ".dynstr"
text shstr ".shstrtab"
text sdynamic ".dynamic"
text shash ".hash"
note State: 0 table fd, 1 current character (256=EOF), 2 code byte count, 3 label-file fd,
note 4 label count, 5 pass (0=labels, 1=validate, 2=emit), 6 output cursor, 7 output fill, 8 input cursor,
note 9 metadata start, 10 ELF total size, 11 section headers, 12 names start,
note 13 symtab start, 14 dynsym start, 15 dynamic start, 16 code start, 17 note size, 18 strtab start.
note 19 count-only mode for metadata sizing, 20 metadata payload size, 21 SysV hash start, 22 input fill.
global gs ulong 30
note 23 byte cursor, 24 emit arguments, 25 argument count, 26/27 last name span, 28 K seen, 29 argument end.
note cfg: name span, kernarg size/alignment, group/private bytes, SGPR/VGPR/AGPR count,
note maximum workgroup/wave size, rsrc3/rsrc1/rsrc2/properties. These are table data, not kernel switches.
global cfg ulong 15
global nb uchar 4096
note These are flushing I/O buffers, never input/output capacity limits.
global ib uchar 4096
global ob uchar 4096
global forms ulong 8
global bases ulong 16
global masks ulong 16
global counts ulong 8
note Each field is word-index/shift/width; <=64 fields is the actual 64-bit instruction boundary.
global fields ulong 1536
global lb uchar 16
text labname "gfx942-labels"
fn labword off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get lb add off i mul i 8
end
ret v
end
fn labfind id ulong to ulong
for i ulong get gs 4
r = pread int get gs 3 lb 0 16 long mul i 16
if ne r 16
die 3 ioerr
end
if eq labword 0 id
ret labword 8
end
end
ret 18446744073709551615
end
fn label id ulong to void
p = labfind id
if ne get gs 5 0
if ne p get gs 2
bad
end
ret
end
if ne p 18446744073709551615
bad
end
for i ulong 8
put lb i uchar and shr id mul i 8 255
put lb add i 8 uchar and shr get gs 2 mul i 8 255
end
r = pwrite int get gs 3 lb 0 16 long mul get gs 4 16
if ne r 16
die 3 ioerr
end
put gs 4 add get gs 4 1
end
fn reloff id ulong to ulong
t = labfind id
if eq t 18446744073709551615
bad
end
p = add get gs 2 4
if ge t p
d = div sub t p 4
if gt d 32767
bad
end
ret d
end
d = div sub p t 4
if gt d 32768
bad
end
ret sub 65536 d
end

fn die rc int msg view uchar * to void
n = write 2 msg 0 len msg
exit rc
end
fn bad to void
die 4 tblerr
end
fn advance to void
if eq get gs 8 get gs 22
r = read int get gs 0 ib 0 len ib
if lt r 0
die 3 ioerr
end
if eq r 0
put gs 1 256
ret
end
put gs 22 ulong r
put gs 8 0
end
put gs 1 ulong get ib get gs 8
put gs 8 add get gs 8 1
put gs 23 add get gs 23 1
end
fn token to ulong
while true bound 999999
c = get gs 1
if eq c 35
while ne get gs 1 10 bound 999999
if eq get gs 1 256
ret 256
end
advance
end
end
c = get gs 1
if eq c 256
ret c
end
if gt c 32
ret c
end
advance
end
ret 256
end
fn number to ulong
c = token
if or lt c 48 gt c 57
bad
end
v = ulong 0
base = ulong 10
digs = ulong 0
if eq c 48
digs = 1
advance
if eq get gs 1 120
base = 16
digs = 0
advance
end
end
while true bound 999999
c = get gs 1
if or le c 32 eq c 256
break
end
if eq c 35
break
end
d = ulong 255
if and ge c 48 le c 57
d = sub c 48
end
if and ge c 97 le c 102
d = add sub c 97 10
end
if ge d base
bad
end
if gt v div sub ulong 18446744073709551615 d base
bad
end
v = add mul v base d
digs = add digs 1
advance
end
if eq digs 0
bad
end
ret v
end
fn format to ulong
v = number
if or lt v 1 gt v 8
bad
end
ret sub v 1
end
fn fieldidx f ulong k ulong to ulong
if ge k 64
bad
end
ret mul add mul f 64 k 3
end
fn bitmask w ulong to ulong
if or eq w 0 gt w 32
bad
end
ret sub shl ulong 1 w 1
end
fn cell f ulong wd ulong to ulong
if ge wd get forms f
bad
end
ret add mul f 2 wd
end
fn setfield f ulong wd ulong shift ulong width ulong value ulong to void
if gt shift 31
bad
end
if gt add shift width 32
bad
end
m = bitmask width
if gt value m
bad
end
ix = cell f wd
m = shl m shift
if ne and get masks ix m 0
bad
end
put masks ix or get masks ix m
put bases ix or get bases ix shl value shift
end
fn emitword v ulong to void
p = get gs 2
if gt v 0xffffffff
bad
end
if eq get gs 5 2
wrle v 4
end
put gs 2 add p 4
end
fn operand f ulong to ulong
v = ulong 0
if eq token 64
advance
id = number
if ne f 3
bad
end
if gt get gs 5 0
v = reloff id
end
else
v = number
end
ret v
end
fn inst f ulong to void
w0 = get bases mul f 2
w1 = get bases add mul f 2 1
for k ulong get counts f
ix = fieldidx f k
wd = get fields ix
sh = get fields add ix 1
bw = get fields add ix 2
v = operand f
if gt v bitmask bw
bad
end
v = shl v sh
if eq wd 0
w0 = or w0 v
else
w1 = or w1 v
end
end
emitword w0
if eq get forms f 2
emitword w1
end
end
fn namespan to void
c = token
put gs 26 sub get gs 23 1
n = ulong 0
while and gt c 32 ne c 256 bound 999999
if eq c 35
break
end
ok = or and ge c 97 le c 122 and ge c 65 le c 90
ok = or ok eq c 95
if gt n 0
ok = or ok and ge c 48 le c 57
end
if not ok
bad
end
n = add n 1
advance
c = get gs 1
end
if eq n 0
bad
end
put gs 27 n
end
fn kernel to void
if ne get gs 28 0
bad
end
namespan
put cfg 0 get gs 26
put cfg 1 get gs 27
for i ulong 13
v = number
if gt v 0xffffffff
bad
end
put cfg add i 2 v
end
if or eq get cfg 3 0 ne and get cfg 3 sub get cfg 3 1 0
bad
end
if or gt get cfg 6 102 gt get cfg 7 256
bad
end
if or gt get cfg 8 256 gt get cfg 14 65535
bad
end
if or ne get cfg 10 64 gt get cfg 9 1024
bad
end
put gs 28 1
end
fn argrow to void
if eq get gs 28 0
bad
end
namespan
p = get gs 26
n = get gs 27
off = number
sz = number
kind = number
if or ne off get gs 29 gt kind 1
bad
end
if or and eq kind 0 ne sz 8 and eq kind 1 ne sz 4
bad
end
put gs 29 add off sz
if gt get gs 29 get cfg 2
bad
end
put gs 25 add get gs 25 1
if ne get gs 24 0
arg p n off sz eq kind 0
end
end
fn table to void
put gs 2 0
put gs 8 0
put gs 22 0
put gs 23 0
put gs 25 0
put gs 28 0
put gs 29 0
for i ulong len forms
put forms i 0
put counts i 0
end
for i ulong len bases
put bases i 0
put masks i 0
end
r = fseek int get gs 0 0 0
if ne r 0
die 3 ioerr
end
advance
while true bound 999999
c = token
if eq c 256
break
end
advance
if eq c 75
kernel
continue
end
if eq c 65
argrow
continue
end
if eq get gs 28 0
bad
end
if eq c 70
f = format
n = number
if or lt n 1 gt n 2
bad
end
if ne get forms f 0
bad
end
put forms f n
else
if eq c 66
f = format
wd = number
sh = number
bw = number
v = number
setfield f wd sh bw v
else
if eq c 68
f = format
k = number
if ne k get counts f
bad
end
ix = fieldidx f k
wd = number
sh = number
bw = number
setfield f wd sh bw 0
put fields ix wd
put fields add ix 1 sh
put fields add ix 2 bw
put counts f add k 1
else
if eq c 73
f = format
if eq get forms f 0
bad
end
inst f
else
if eq c 76
emitword number
else
if eq c 84
label number
else
bad
end
end
end
end
end
end
end
if eq get gs 2 0
bad
end
if or eq get gs 25 0 ne get gs 29 get cfg 2
bad
end
end

fn flush to void
p = ulong 0
n = get gs 7
while lt p n bound 999999
r = write 1 ob p sub n p
if le r 0
die 3 ioerr
end
p = add p ulong r
end
put gs 7 0
end
fn octet v ulong to void
if eq get gs 19 0
if eq get gs 7 len ob
flush
end
put ob get gs 7 uchar and v 255
put gs 7 add get gs 7 1
end
put gs 6 add get gs 6 1
end
fn wrle v ulong n ulong to void
for j ulong n
octet and shr v mul j 8 255
end
end
fn zeros n ulong to void
for j ulong n
octet 0
end
end
fn padto off ulong to void
if gt get gs 6 off
die 4 tblerr
end
zeros sub off get gs 6
end
fn bytes v view uchar * to void
for j ulong len v
octet ulong get v j
end
end
fn strz v view uchar * to void
bytes v
octet 0
end
fn wrbe v ulong n ulong to void
for j ulong n
octet and shr v mul sub sub n j 1 8 255
end
end
note MessagePack lengths and unsigned values in their smallest encoding (msgpack spec, "formats").
fn mpuint v ulong to void
if le v 127
octet v
ret
end
if le v 255
octet 204
wrbe v 1
ret
end
if le v 65535
octet 205
wrbe v 2
ret
end
if le v 4294967295
octet 206
wrbe v 4
ret
end
octet 207
wrbe v 8
end
fn mphead n ulong to void
if le n 31
octet add 160 n
else
if le n 255
octet 217
wrbe n 1
else
if le n 65535
octet 218
wrbe n 2
else
note str32 is the format's widest length field: a wire-field boundary, refused past it.
if gt n 4294967295
die 4 tblerr
end
octet 219
wrbe n 4
end
end
end
end
fn mpstr v view uchar * to void
mphead len v
bytes v
end
fn span p ulong n ulong to void
i = ulong 0
while lt i n bound 999999
sz = sub n i
if gt sz len nb
sz = len nb
end
r = pread int get gs 0 nb 0 sz long add p i
if le r 0
die 3 ioerr
end
for j ulong ulong r
octet ulong get nb j
end
i = add i ulong r
end
end
fn mpname p ulong n ulong to void
mphead n
span p n
end
fn kdname to void
mphead add get cfg 1 len kdsuf
span get cfg 0 get cfg 1
bytes kdsuf
end
fn mparray n ulong to void
if le n 15
octet add 144 n
ret
end
if le n 65535
octet 220
wrbe n 2
ret
end
if gt n 0xffffffff
bad
end
octet 221
wrbe n 4
end
fn kv key view uchar * v ulong to void
mpstr key
mpuint v
end
fn arg p ulong n ulong off ulong sz ulong pointer bool to void
if pointer
octet 133
mpstr aspace
mpstr aglobal
else
octet 132
end
mpstr aname
mpname p n
kv aoffset off
kv asize sz
mpstr akind
if pointer
mpstr abuffer
else
mpstr avalue
end
end
fn meta to void
note Same key order as the oracle, but encoded independently from typed fields here.
octet 131
mpstr kernels
octet 145
octet 140
kv kagpr get cfg 8
mpstr kargs
mparray get gs 25
put gs 5 1
put gs 24 1
table
put gs 24 0
kv kgroup get cfg 4
kv kalign get cfg 3
kv ksize get cfg 2
kv kmax get cfg 9
mpstr kname
mpname get cfg 0 get cfg 1
kv kpriv get cfg 5
kv ksgpr get cfg 6
mpstr ksym
kdname
kv kvgpr get cfg 7
kv kwave get cfg 10
mpstr tgtkey
mpstr target
mpstr ver
octet 146
octet 1
octet 2
end
fn nameidx n ulong to ulong
note NUL, .text, .rodata, .note, .strtab, .symtab, .dynstr, .dynsym, .shstrtab, .dynamic
if eq n 1
ret 1
end
if eq n 2
ret add nameidx 1 add len stext 1
end
if eq n 3
ret add nameidx 2 add len sdata 1
end
if eq n 4
ret add nameidx 3 add len snote 1
end
if eq n 5
ret add nameidx 4 add len sstr 1
end
if eq n 6
ret add nameidx 5 add len ssym 1
end
if eq n 7
ret add nameidx 6 add len sds 1
end
if eq n 8
ret add nameidx 7 add len sdyn 1
end
if eq n 9
ret add nameidx 8 add len shstr 1
end
if eq n 10
ret add nameidx 9 add len sdynamic 1
end
ret 0
end
fn ph ty ulong flags ulong off ulong sz ulong align ulong to void
wrle ty 4
wrle flags 4
wrle off 8
wrle off 8
wrle off 8
wrle sz 8
wrle sz 8
wrle align 8
end
fn shdr name ulong ty ulong flags ulong off ulong sz ulong align ulong to void
wrle nameidx name 4
wrle ty 4
wrle flags 8
if ne flags 0
wrle off 8
else
wrle 0 8
end
wrle off 8
wrle sz 8
if eq ty 2
wrle 4 4
wrle 1 4
else
if eq ty 11
wrle 6 4
wrle 1 4
else
if eq ty 6
wrle 6 4
wrle 0 4
else
if eq ty 5
wrle 7 4
wrle 0 4
else
wrle 0 4
wrle 0 4
end
end
end
end
wrle align 8
if or eq ty 2 eq ty 11
wrle 24 8
else
if eq ty 6
wrle 16 8
else
if eq ty 5
wrle 4 8
else
wrle 0 8
end
end
end
end
fn symbol name ulong info ulong vis ulong sec ulong value ulong sz ulong to void
wrle name 4
wrle info 1
wrle vis 1
wrle sec 2
wrle value 8
wrle sz 8
end
fn symbols to void
zeros 24
symbol 1 18 3 1 get gs 16 get gs 2
symbol add get cfg 1 2 17 0 2 512 64
end
fn kdesc to void
wrle get cfg 4 4
wrle get cfg 5 4
wrle get cfg 2 4
zeros 4
note Signed byte displacement from descriptor VA 512 to code VA 768; no relocations remain.
wrle sub get gs 16 ulong 512 8
zeros 20
note Descriptor resources and properties are explicit table fields, checked against LLVM by the gate.
wrle get cfg 11 4
wrle get cfg 12 4
wrle get cfg 13 4
wrle get cfg 14 2
zeros 6
end
fn dynent tag ulong value ulong to void
wrle tag 8
wrle value 8
end
fn roundup n ulong a ulong to ulong
ret mul div add n sub a 1 a a
end
fn strsize to ulong
ret add mul get cfg 1 2 add len kdsuf 3
end
fn object to void
note Layout sized from the instruction words and table metadata; ELF64 boundary fields are authoritative.
put gs 16 768
put gs 9 roundup add get gs 16 get gs 2 64
put gs 19 1
meta
put gs 20 get gs 6
put gs 6 0
put gs 19 0
put gs 17 roundup add get gs 20 20 4
put gs 18 add get gs 9 get gs 17
put gs 13 roundup add get gs 18 strsize 8
put gs 14 add get gs 13 72
put gs 15 add get gs 14 72
put gs 21 add get gs 15 96
put gs 12 add get gs 21 24
put gs 11 roundup add get gs 12 add nameidx 10 add len shash 1 8
put gs 10 add get gs 11 mul ulong 11 64
wrle 0x464c457f 4
wrle 2 1
wrle 1 1
wrle 1 1
wrle 64 1
wrle 3 1
zeros 7
wrle 3 2
wrle 224 2
wrle 1 4
wrle 0 8
wrle 64 8
wrle get gs 11 8
wrle 0x54c 4
wrle 64 2
wrle 56 2
wrle 4 2
wrle 64 2
wrle 11 2
wrle 8 2
note One read/execute load, one note, one dynamic, plus stack flags (no executable host stack).
ph 1 5 0 get gs 10 256
ph 4 4 get gs 9 get gs 17 4
ph 2 4 get gs 15 96 8
ph 0x6474e551 6 0 0 8
padto 512
kdesc
padto get gs 16
put gs 5 2
table
padto get gs 9
wrle 7 4
wrle get gs 20 4
wrle 32 4
strz owner
octet 0
meta
padto get gs 18
octet 0
span get cfg 0 get cfg 1
octet 0
span get cfg 0 get cfg 1
strz kdsuf
padto get gs 13
symbols
padto get gs 14
symbols
padto get gs 15
dynent 5 get gs 18
dynent 10 strsize
dynent 6 get gs 14
dynent 11 24
dynent 4 get gs 21
dynent 0 0
note SysV hash: one bucket, three symbols; all names collide into the single 1->2->0 chain.
wrle 1 4
wrle 3 4
wrle 1 4
wrle 0 4
wrle 2 4
wrle 0 4
padto get gs 12
octet 0
strz stext
strz sdata
strz snote
strz sstr
strz ssym
strz sds
strz sdyn
strz shstr
strz sdynamic
strz shash
padto get gs 11
zeros 64
shdr 1 1 6 get gs 16 get gs 2 256
shdr 2 1 2 512 64 64
shdr 3 7 2 get gs 9 get gs 17 4
shdr 4 3 0 get gs 18 strsize 1
shdr 5 2 0 get gs 13 72 8
shdr 6 3 2 get gs 18 strsize 1
shdr 7 11 2 get gs 14 72 8
shdr 8 3 0 get gs 12 add nameidx 10 add len shash 1 1
shdr 9 6 2 get gs 15 96 8
shdr 10 5 2 get gs 21 24 4
if ne get gs 6 get gs 10
bad
end
end
fn main to int
p = new uchar 4096 0
if ne argcnt 2
die 2 use
end
n = argread 1 p 0 len p
if le n 0
die 2 use
end
fd = fopen p 0 ulong n 0 0
if lt fd 0
die 3 ioerr
end
put gs 0 ulong fd
lf = memfd labname 0 len labname 0
if lt lf 0
die 3 ioerr
end
put gs 3 ulong lf
table
put gs 5 1
table
object
flush
r = fclose int fd
if ne r 0
die 3 ioerr
end
r = fclose int get gs 3
if ne r 0
die 3 ioerr
end
ret 0
end

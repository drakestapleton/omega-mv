note SPDX-License-Identifier: Apache-2.0
note gpu/amd/gate.om: OMEGA-GPU-AMD, the gate of the AMD gfx942 back end, in seeded Omega (Linux AArch64).
note Build from the repository root (OM-2 program mode; seed/ng/sha256.om supplies sh_dat, sh_all, sh_dig):
note   { printf 'om2\n'; cat seed/ng/sha256.om gpu/amd/gate.om; } | seed/out/omc > gate
note Run from the repository root: gate OMC SCRATCH
note OMC      the compiler under test; its sha256 must equal the first word of seed/out/omc.sha256, or nothing
note          runs (exit 69, nothing written)
note SCRATCH  a new directory (created 0700), at most 1024 bytes of path; an existing one is refused (exit 2)
note 1. Units. Each row of g_units is composed from its sources in order (+om2 is the line "om2", +x86 the line
note    "target x86linux", PATH! is PATH up to its line "fn main to int") into SCRATCH/NAME.om and compiled twice
note    by OMC: each compile exits 0 with empty stderr, and both binaries hold the same bytes.
note 2. Card bytes. gpu/amd/card.tsv: "obj NAME SHA" is the object the code-object writer (unit hsaco) makes from
note    gpu/amd/gfx942/NAME.isa and "bin NAME SHA" the binary of unit NAME, both run on the MI300X; "host NAME SHA"
note    is a unit's binary recorded on the host and never run on the card (printed as a reference). Each must hash
note    to SHA. Each object must also pass the portable loader check: unit targets, `targets load AMDGPU_HSACO FILE
note    gfx942`, exit 0. A card with no obj or no bin row, or a malformed row, fails.
note 3. Controls, each must be caught: a compiler one byte longer fails the digest check; embed5120_step.isa with
note    one kernel-descriptor word changed (0xaf0103 to 0xaf0102) does not give the card bytes; a missing table is
note    refused by the writer.
note Output: one line per check, then OMEGA-GPU-AMD PASS|FAIL units=U objects=O binaries=B references=R controls=C
note caught=K hardware=NOT_RUN. Exit 0 PASS, 1 FAIL, 2 bad usage or setup, 69 compiler digest refused. Every input
note is length-checked; a trap exit (101..114) would be a defect of this gate, never a pass.
note This gate opens no device; every hardware row stays NOT_RUN. Results on hardware carry over to this tree
note only through the byte identity checked in step 2.
text g_units "hsaco gpu/amd/gfx942/hsaco.om|targets gpu/targets.om|exec gpu/amd/gfx942/exec/fp.om gpu/amd/gfx942/exec/fma.om gpu/amd/gfx942/exec/main.om|rope gpu/amd/gfx942/rope.om|aql gpu/amd/kfd/aql.om gpu/amd/kfd/cli.om|kernarg gpu/amd/kfd/kernarg.om gpu/amd/kfd/cli.om|records gpu/amd/kfd/records.om gpu/amd/kfd/cli.om|ring gpu/amd/kfd/ring.om gpu/amd/kfd/cli.om|launch-a64 +om2 gpu/amd/kfd/launch/common.om gpu/amd/kfd/launch/elf.om gpu/amd/kfd/launch/device.om gpu/amd/kfd/launch/dispatch.om gpu/amd/kfd/launch/plan.om gpu/amd/kfd/launch/main.om gpu/amd/kfd/cli.om|launch-x86 +x86 +om2 gpu/amd/kfd/launch/common.om gpu/amd/kfd/launch/elf.om gpu/amd/kfd/launch/device.om gpu/amd/kfd/launch/dispatch.om gpu/amd/kfd/launch/plan.om gpu/amd/kfd/launch/main.om gpu/amd/kfd/cli.om|semantics-probe gpu/amd/gfx942/exec/fp.om gpu/amd/gfx942/exec/fma.om gpu/amd/gfx942/exec/main.om! gpu/amd/tests/amd-exec/semantics-probe.om|row-probe gpu/amd/gfx942/exec/fp.om gpu/amd/gfx942/exec/fma.om gpu/amd/gfx942/exec/main.om! gpu/amd/tests/amd-exec/row-probe.om|fma-probe +om2 gpu/amd/gfx942/exec/fma.om gpu/amd/tests/amd-exec/fma-probe.om|trans-probe gpu/amd/gfx942/exec/fp.om gpu/amd/tests/amd-exec/trans-probe.om|ropefreq-probe gpu/amd/gfx942/rope.om! gpu/amd/tests/amd-exec/ropefreq-probe.om"
text t_pin "seed/out/omc.sha256"
text t_card "gpu/amd/card.tsv"
text t_isa "gpu/amd/gfx942/"
text t_isx ".isa"
text t_om ".om"
text t_b1 ".1"
text t_b2 ".2"
text t_e1 ".1.err"
text t_e2 ".2.err"
text t_hs ".hsaco"
text t_hse ".hsaco.err"
text t_ld ".load"
text t_lde ".load.err"
text t_null "/dev/null"
text t_hsaco "hsaco"
text t_tgts "targets"
text t_load "load"
text t_fmt "AMDGPU_HSACO"
text t_gfx "gfx942"
text t_acc "LOAD ACCEPT "
text t_om2 "om2\n"
text t_x86 "target x86linux\n"
text t_main "fn main to int"
text t_plus "omc-plus-one"
text t_chg "changed"
text t_mis "missing"
text t_e5 "embed5120_step"
text t_kdw "0xaf0103"
text t_usage "usage: gate OMC SCRATCH (run from the omega-mv repository root)\n"
text t_refd "OMEGA-GPU-AMD REFUSED: compiler digest differs from seed/out/omc.sha256 (exit 69)\n"
text t_nopin "OMEGA-GPU-AMD INVALID: cannot read a 64-hex digest from seed/out/omc.sha256\n"
text t_noscr "OMEGA-GPU-AMD INVALID: SCRATCH exists or cannot be made\n"
text t_nocard "OMEGA-GPU-AMD INVALID: cannot read gpu/amd/card.tsv\n"
text t_ok "ok "
text t_fail "FAIL "
text t_unit "unit "
text t_obj "object "
text t_bin "binary "
text t_ref "reference "
text t_kobj "obj"
text t_kbin "bin"
text t_khost "host"
text t_sr " references="
text t_long "OMEGA-GPU-AMD INVALID: SCRATCH path longer than 1024 bytes\n"
text t_ctl "control "
text t_bytes " bytes="
text t_sha " sha256="
text t_want " want="
text t_exit " exit="
text t_src "source unreadable: "
text t_big "output unreadable or over 16 MiB"
text t_cmp "compile"
text t_stderr " stderr not empty"
text t_twice " two builds differ"
text t_write "cannot write "
text t_kind "card.tsv: malformed row or unknown kind"
text t_empty "card.tsv names no obj row or no bin row: it proves nothing"
text t_ldr " loader check failed"
text t_caught " caught"
text t_esc " ESCAPED"
text t_noapp " not applied"
text t_sum "OMEGA-GPU-AMD "
text t_pass "PASS"
text t_fl "FAIL"
text t_su " units="
text t_so " objects="
text t_sb " binaries="
text t_sc " controls="
text t_sk " caught="
text t_hw " hardware=NOT_RUN\n"
global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_nm uchar 256
global g_av uchar 8192
global g_b uchar 16777216
global g_c uchar 1048576
global g_o uchar 8192
global g_hx uchar 64
global g_pin uchar 64
global g_d1 uchar 32
global g_stb uchar 4
global g_n ulong 32
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 buffer length, 7 card length, 8 units, 9 objects, 10 binaries, 11 failures, 12 controls, 13 caught,
note 14 name length, 15 row cursor, 16 obj rows, 17 bin rows, 18 host references
note ---- output
fn oc c ulong to void
n = get g_n 5
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onm to void
for i ulong get g_n 14 bound 256
oc ulong get g_nm i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohex to void
for j ulong 32
b = get sh_dig j
oc ulong sh_hexd uint shr b 4
oc ulong sh_hexd uint and b 15
end
end
fn ohx to void
for j ulong 64
oc ulong get g_hx j
end
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
fn onl to void
oc 10
oflush
end
note a failed check: FAIL KIND NAME then the reason; counts a failure
fn ofail kind view uchar * why view uchar * to void
ot t_fail
ot kind
onm
oc 32
ot why
onl
put g_n 11 add get g_n 11 1
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
put g_pa n uchar c
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pscr to void
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
end
fn pnm to void
for j ulong get g_n 14 bound 256
pc ulong get g_nm j
end
end
note scratch file NAME then suffix
fn psn suf view uchar * to void
pclr
pscr
pnm
pt suf
end
note scratch file named by a text
fn pst t view uchar * suf view uchar * to void
pclr
pscr
pt t
pt suf
end
note scratch file named by a text alone
fn psc t view uchar * to void
pclr
pscr
pt t
end
fn nmset t view uchar * to void
for i ulong len t bound 256
put g_nm i get t i
end
put g_n 14 len t
end
note ---- files
fn fopn fl ulong mode ulong to int
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
r = unlink g_pa 0 get g_n 0
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note append the file at g_pa to g_b; false when unreadable or past the buffer
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 16777218
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_b
ok = false
break
end
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 16777217
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note sha256 of the file at g_pa into sh_dig; false when unreadable or past 16 MiB
fn fhash to bool
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = read fd sh_dat n sub len sh_dat n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len sh_dat
ok = false
break
end
end
fclo fd
if not ok
ret false
end
sh_all n
ret true
end
note the size of the file at g_pa, or 2^63 when unreadable
fn fsize to ulong
put g_n 6 0
if not bload
ret shl ulong 1 63
end
ret get g_n 6
end
note sh_dig equals the hex in g_hx
fn digeq to bool
for j ulong 32
b = get sh_dig j
if ne get g_hx mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_hx add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
fn dsave to void
for j ulong 32
put g_d1 j get sh_dig j
end
end
fn dsame to bool
for j ulong 32
if ne get g_d1 j get sh_dig j
ret false
end
end
ret true
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument
fn apa to void
p = get g_n 3
n = get g_n 0
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
end
fn atx t view uchar * to void
pclr
pt t
apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here): the exit code, 256 + the signal, 512
note when a file could not be opened, 1000 when the child passed the 600 s deadline (killed)
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
note OMC < SCRATCH/NAME.om > SCRATCH/NAME.SUF 2> SCRATCH/NAME.ERR
fn omc suf view uchar * err view uchar * to ulong
psn t_om
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
apa
psn suf
fo = fexe
psn err
fe = fwr
ret spawn fi fo fe
end
note ---- the compiler digest
note the first 64 characters of seed/out/omc.sha256 into g_pin; false unless lowercase hex
fn pinread to bool
pclr
pt t_pin
put g_n 6 0
if not bload
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
note the file at g_pa hashes to g_pin
fn pinok to bool
if not fhash
ret false
end
for j ulong 64
put g_hx j get g_pin j
end
ret digeq
end
note ---- units
note compose unit row [s, e) of g_units into g_b; false (reported) when a source is unreadable
fn compose s ulong e ulong to bool
put g_n 6 0
i = s
while lt i e bound 4096
while uis i e 32 bound 4096
i = add i 1
end
if ge i e
break
end
j = i
while uisnt j e 32 bound 4096
j = add j 1
end
if eq get g_units i 43
if eq get g_units add i 1 120
lit t_x86
else
lit t_om2
end
else
cut = eq get g_units sub j 1 33
k = j
if cut
k = sub j 1
end
pclr
for q ulong sub k i bound 4096
pc ulong get g_units add i q
end
st = get g_n 6
if not bload
pnm2
ofail t_unit t_src
ret false
end
if cut
mcut st
end
end
i = j
end
ret true
end
note print the path in g_pa after a failure line's text (used for unreadable sources)
fn pnm2 to void
for q ulong get g_n 0 bound 4096
put g_nm q get g_pa q
end
put g_n 14 get g_n 0
end
fn lit t view uchar * to void
n = get g_n 6
for q ulong len t bound 64
put g_b add n q get t q
end
put g_n 6 add n len t
end
note cut g_b at the first line, at or after st, that starts with "fn main to int"
fn mcut st ulong to void
n = get g_n 6
p = st
while lt p n bound 16777216
if mline p n
put g_n 6 p
ret
end
while and lt p n ne get g_b p 10 bound 16777216
p = add p 1
end
p = add p 1
end
end
fn mline p ulong n ulong to bool
if gt add p len t_main n
ret false
end
for q ulong len t_main
if ne get g_b add p q get t_main q
ret false
end
end
ret true
end
note compile the composed unit twice; true when both exit 0 with empty stderr and equal bytes
fn build to bool
psn t_om
if not bsave false
ofail t_unit t_write
ret false
end
r1 = omc t_b1 t_e1
r2 = omc t_b2 t_e2
if or ne r1 0 ne r2 0
ot t_fail
ot t_unit
onm
oc 32
ot t_cmp
ot t_exit
onum r1
oc 47
onum r2
onl
put g_n 11 add get g_n 11 1
ret false
end
psn t_e1
s1 = fsize
psn t_e2
s2 = fsize
if or ne s1 0 ne s2 0
ofail t_unit t_stderr
ret false
end
psn t_b1
if not fhash
ofail t_unit t_big
ret false
end
dsave
psn t_b2
if not fhash
ofail t_unit t_big
ret false
end
if not dsame
ofail t_unit t_twice
ret false
end
psn t_b1
sz = fsize
psn t_b1
z = fhash
ot t_ok
ot t_unit
onm
ot t_bytes
onum sz
ot t_sha
ohex
onl
put g_n 8 add get g_n 8 1
ret true
end
fn units to void
n = len g_units
s = ulong 0
while lt s n bound 4096
e = s
while uisnt e n 124 bound 65536
e = add e 1
end
k = s
while uisnt k e 32 bound 256
k = add k 1
end
for q ulong sub k s bound 256
put g_nm q get g_units add s q
end
put g_n 14 sub k s
if compose k e
z = build
end
s = add e 1
end
end
note g_units[i] is c, for i below e (never reads at or past e)
fn uis i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret eq ulong get g_units i c
end
fn uisnt i ulong e ulong c ulong to bool
if ge i e
ret false
end
ret ne ulong get g_units i c
end
note ---- card bytes
note SCRATCH/hsaco.1 TABLE > SCRATCH/NAME.hsaco: TABLE is gpu/amd/gfx942/NAME.isa (tbl 0) or SCRATCH/NAME.isa
fn wrun tbl ulong to ulong
aclr
pst t_hsaco t_b1
apa
pclr
if eq tbl 0
pt t_isa
pnm
pt t_isx
else
pscr
pnm
pt t_isx
end
apa
pclr
pt t_null
fi = frd
psn t_hs
fo = fwr
psn t_hse
fe = fwr
ret spawn fi fo fe
end
fn loadok to bool
aclr
pst t_tgts t_b1
apa
atx t_load
atx t_fmt
psn t_hs
apa
atx t_gfx
pclr
pt t_null
fi = frd
psn t_ld
fo = fwr
psn t_lde
fe = fwr
r = spawn fi fo fe
if ne r 0
ret false
end
psn t_ld
put g_n 6 0
if not bload
ret false
end
if lt get g_n 6 len t_acc
ret false
end
for q ulong len t_acc
if ne get g_b q get t_acc q
ret false
end
end
ret true
end
fn cobj to void
r = wrun 0
if ne r 0
ot t_fail
ot t_obj
onm
ot t_exit
onum r
onl
put g_n 11 add get g_n 11 1
ret
end
psn t_hs
if not fhash
ofail t_obj t_big
ret
end
if not digeq
ot t_fail
ot t_obj
onm
ot t_sha
ohex
ot t_want
ohx
onl
put g_n 11 add get g_n 11 1
ret
end
if not loadok
ofail t_obj t_ldr
ret
end
ot t_ok
ot t_obj
onm
ot t_sha
ohex
onl
put g_n 9 add get g_n 9 1
end
note a binary row: card-proven (host false, counted in g_n 10) or a host-built reference (host true, g_n 18)
fn cbin host bool to void
psn t_b1
if not fhash
ofail t_bin t_big
ret
end
if not digeq
ot t_fail
ot t_bin
onm
ot t_sha
ohex
ot t_want
ohx
onl
put g_n 11 add get g_n 11 1
ret
end
ot t_ok
if host
ot t_ref
else
ot t_bin
end
onm
ot t_sha
ohex
onl
if host
put g_n 18 add get g_n 18 1
else
put g_n 10 add get g_n 10 1
end
end
note g_c[s, k) is the word t
fn kword s ulong k ulong t view uchar * to bool
if ne sub k s len t
ret false
end
for q ulong len t bound 8
if ne get g_c add s q get t q
ret false
end
end
ret true
end
note one card.tsv row [s, e): KIND NAME SHA, single spaces; # starts a comment line. KIND is obj, bin or host;
note NAME is 1 to 255 bytes; SHA is 64 lowercase hex. Anything else is a FAIL line, never a trap.
fn crow s ulong e ulong to void
if or eq s e eq get g_c s 35
ret
end
put g_n 14 0
k = s
while and lt k e ne get g_c k 32 bound 1048576
k = add k 1
end
if ge k e
ofail t_obj t_kind
ret
end
a = add k 1
b = a
while and lt b e ne get g_c b 32 bound 1048576
b = add b 1
end
if or ge b e or eq b a gt sub b a 255
ofail t_obj t_kind
ret
end
for q ulong sub b a bound 256
put g_nm q get g_c add a q
end
put g_n 14 sub b a
if ne sub e add b 1 64
ofail t_obj t_kind
ret
end
for q ulong 64
put g_hx q get g_c add add b 1 q
end
if kword s k t_kobj
put g_n 16 add get g_n 16 1
cobj
ret
end
if kword s k t_kbin
put g_n 17 add get g_n 17 1
cbin false
ret
end
if kword s k t_khost
cbin true
ret
end
ofail t_obj t_kind
end
fn card to bool
pclr
pt t_card
put g_n 6 0
if not bload
ret false
end
n = get g_n 6
if ge n len g_c
ret false
end
for q ulong n bound 1048576
put g_c q get g_b q
end
s = ulong 0
while lt s n bound 1048576
e = s
while and lt e n ne get g_c e 10 bound 1048576
e = add e 1
end
crow s e
s = add e 1
end
ret true
end
note ---- controls
fn caught c bool what view uchar * to void
put g_n 12 add get g_n 12 1
nmset what
if c
ot t_ok
ot t_ctl
onm
ot t_caught
onl
put g_n 13 add get g_n 13 1
else
ofail t_ctl t_esc
end
end
note a compiler one byte longer must fail the digest check
fn cwrong to void
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
put g_n 6 0
ok = bload
n = get g_n 6
put g_b n 0
put g_n 6 add n 1
psc t_plus
ok = and ok bsave true
psc t_plus
c = and ok not pinok
caught c t_plus
end

note SPDX-License-Identifier: Apache-2.0
note gpu/amd/rest/classify.om: writes gpu/amd/NOT-YET-OMEGA.tsv. It reads a list of CUDApp paths, one per
note line, on standard input and the rules in RULES (gpu/amd/rest/classes.tsv), and prints one row per path:
note PATH, KIND (the extension after the last '.' of the file name, or none), CLASS, REASON, REPLACEMENT.
note The first rule whose PREFIX and SUFFIX both match decides ("-" is the empty string). CLASS skip prints
note nothing; CLASS error prints the path to standard error and makes the exit status 1, so a file the rules
note do not cover is loud. Usage: classify RULES < LIST > OUT. Exit 0 done, 1 unclassified path, 2 usage,
note 3 RULES or LIST unreadable, malformed or larger than its buffer (refused, nothing partial is claimed).
text t_usage "usage: classify RULES < LIST > OUT\n"
text t_bad "classify: RULES or LIST unreadable, malformed, or larger than its buffer\n"
text t_unc "classify: no rule covers "
text t_h1 "# generated by gpu/amd/rest/classify.om from gpu/amd/rest/classes.tsv; do not edit by hand\n"
text t_h2 "# git -C CUDApp ls-tree -r --name-only 84b524cadaaa8bc9b556adfaea9d6dd2e0d67a66 | classify gpu/amd/rest/classes.tsv\n"
text t_h3 "path\tkind\tclass\treason\treplacement\n"
text t_none "none"
text t_skip "skip"
text t_err "error"
text t_nl "\n"
global g_pa uchar 4096
global g_in uchar 8388608
global g_r uchar 1048576
global g_o uchar 8192
global g_rs ulong 5120
global g_re ulong 5120
global g_n ulong 8
note g_n: 0 output length, 1 LIST length, 2 RULES length, 3 rule count, 4 unclassified count
fn oc c ulong to void
n = get g_n 0
if ge n len g_o
r = write 1 g_o 0 n
n = ulong 0
end
put g_o n uchar c
put g_n 0 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn oflush to void
r = write 1 g_o 0 get g_n 0
put g_n 0 0
end
note print g_in[s, e)
fn oin s ulong e ulong to void
i = s
while lt i e bound 8388609
oc ulong get g_in i
i = add i 1
end
end
note print g_r[s, e)
fn orl s ulong e ulong to void
i = s
while lt i e bound 1048577
oc ulong get g_r i
i = add i 1
end
end
note read all of fd into g_in; its length, or a value over the buffer when unreadable or too large
fn rdin fd int to ulong
n = ulong 0
while true bound 8388610
x = read fd g_in n sub len g_in n
if lt x 0
ret add len g_in 1
end
if eq x 0
ret n
end
n = add n ulong x
if ge n len g_in
ret add len g_in 1
end
end
ret n
end
fn rdrl fd int to ulong
n = ulong 0
while true bound 1048578
x = read fd g_r n sub len g_r n
if lt x 0
ret add len g_r 1
end
if eq x 0
ret n
end
n = add n ulong x
if ge n len g_r
ret add len g_r 1
end
end
ret n
end
note field start and end, with "-" meaning empty
fn rfs k ulong to ulong
ret get g_rs k
end
fn rfe k ulong to ulong
s = get g_rs k
e = get g_re k
if and eq sub e s 1 eq get g_r s 45
ret s
end
ret e
end
note split RULES into rows of exactly five tab-separated fields; '#' lines and empty lines are skipped
fn rparse to bool
n = get g_n 2
p = ulong 0
c = ulong 0
while lt p n bound 1048577
if or eq get g_r p 35 eq get g_r p 10
while and lt p n ne get g_r p 10 bound 1048577
p = add p 1
end
p = add p 1
continue
end
if ge mul add c 1 5 len g_rs
ret false
end
f = ulong 0
put g_rs mul c 5 p
while lt p n bound 1048577
b = get g_r p
if eq b 10
break
end
if eq b 9
if ge f 4
ret false
end
put g_re add mul c 5 f p
f = add f 1
put g_rs add mul c 5 f add p 1
end
p = add p 1
end
if ne f 4
ret false
end
put g_re add mul c 5 f p
c = add c 1
p = add p 1
end
put g_n 3 c
ret true
end
note g_in[s, s + l) equals g_r[a, a + l)
fn seq s ulong a ulong l ulong to bool
for i ulong l bound 1048576
if ne get g_in add s i get g_r add a i
ret false
end
end
ret true
end
note rule k covers the path g_in[s, e)
fn rmatch k ulong s ulong e ulong to bool
b = mul k 5
ps = rfs b
pl = sub rfe b ps
ss = rfs add b 1
sl = sub rfe add b 1 ss
if lt sub e s add pl sl
ret false
end
if not seq s ps pl
ret false
end
ret seq sub e sl ss sl
end
note the class field of rule k is the text t
fn ris k ulong t view uchar * to bool
s = get g_rs add mul k 5 2
e = get g_re add mul k 5 2
if ne sub e s len t
ret false
end
for i ulong len t bound 16
if ne get g_r add s i get t i
ret false
end
end
ret true
end
note print the extension of g_in[s, e), or none
fn okind s ulong e ulong to void
d = e
i = e
while gt i s bound 8388609
c = get g_in sub i 1
if eq c 47
break
end
if and eq c 46 eq d e
d = sub i 1
end
i = sub i 1
end
if or eq d e eq d i
ot t_none
ret
end
oin add d 1 e
end
note classify one path g_in[s, e)
note field f + 2 of rule k, after a tab
fn orf k ulong f ulong to void
b = mul k 5
oc 9
orl get g_rs add b add f 2 get g_re add b add f 2
end
fn cpath s ulong e ulong to void
c = get g_n 3
for k ulong c bound 1024
if rmatch k s e
if ris k t_skip
ret
end
if ris k t_err
oflush
r = write 2 t_unc 0 len t_unc
r = write 2 g_in s sub e s
r = write 2 t_nl 0 1
put g_n 4 add get g_n 4 1
ret
end
oin s e
oc 9
okind s e
orf k 0
orf k 1
orf k 2
oc 10
ret
end
end
oflush
r = write 2 t_unc 0 len t_unc
r = write 2 g_in s sub e s
r = write 2 t_nl 0 1
put g_n 4 add get g_n 4 1
end
fn bad to int
r = write 2 t_bad 0 len t_bad
ret 3
end
fn main to int
if ne argcnt 2
r = write 2 t_usage 0 len t_usage
ret 2
end
r = argread 1 g_pa 0 4095
if lt r 1
r = write 2 t_usage 0 len t_usage
ret 2
end
fd = fopen g_pa 0 ulong r int 524288 int 0
if lt fd 0
ret bad
end
m = rdrl int fd
x = fclose int fd
if gt m len g_r
ret bad
end
put g_n 2 m
if not rparse
ret bad
end
n = rdin 0
if gt n len g_in
ret bad
end
put g_n 1 n
ot t_h1
ot t_h2
ot t_h3
p = ulong 0
while lt p n bound 8388609
q = p
while and lt q n ne get g_in q 10 bound 8388609
q = add q 1
end
if gt q p
cpath p q
end
p = add q 1
end
oflush
if gt get g_n 4 0
ret 1
end
ret 0
end

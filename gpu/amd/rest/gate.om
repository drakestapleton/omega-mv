bbe v 2
ret
end
if lt v 4294967296
bch 206
bbe v 4
ret
end
bch 207
bbe v 8
end
fn xstr n ulong f ulong to void
if lt n 32
bch or 160 n
else
if lt n 256
bch 217
bbe n 1
else
if lt n 65536
bch 218
bbe n 2
else
bch 219
bbe n 4
end
end
end
for j ulong n bound 4294967296
bch f
end
end

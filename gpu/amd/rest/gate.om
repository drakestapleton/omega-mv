global g_pa uchar 4096
global g_scr uchar 4096
global g_omc uchar 4096
global g_nm uchar 256
global g_av uchar 8192
global g_b uchar 16777216
global g_c uchar 1048576
global g_t uchar 1048576
global g_o uchar 8192
global g_hx uchar 64
global g_pin uchar 64
global g_d1 uchar 32
global g_stb uchar 4
global g_st uchar 128
global g_n ulong 32
global g_m ulong 32
global g_fs ulong 16
global g_fe ulong 16
note g_n: 0 path length, 1 omc length, 2 scratch length (with '/'), 3 argv bytes, 4 argc, 5 output length,
note 6 g_b length, 11 failures, 12 controls, 13 caught, 14 name length
note g_m: 0 table length, 1 field count, 2 bad read, 3 section size, 4 section address, 5 qemu present, 6 kfd absent,
note 7 not run, 8 llvm rows, 9 verdict rows, 10 object rows, 11 writer rows, 12 g_c length, 14 flip once,
note 19 plan verdict rows, 24 plan patch shift (control)
note g_fs/g_fe: start and end of each field of the current table row
note ---- output
fn oc c ulong to void
n = get g_n 5
if ge n len g_o
oflush
n = ulong 0
end
put g_o n uchar c
put g_n 5 add n 1
end
fn ot t view uchar * to void
for i ulong len t bound 4096
oc ulong get t i
end
end
fn onm to void
for i ulong get g_n 14 bound 256
oc ulong get g_nm i
end
end
fn onum v ulong to void
if ge v 10
onum div v 10
end
oc add 48 rem v 10
end
fn ohex to void
for j ulong 32
b = get sh_dig j
oc ulong sh_hexd uint shr b 4
oc ulong sh_hexd uint and b 15
end
end
fn oflush to void
r = write 1 g_o 0 get g_n 5
put g_n 5 0
end
fn onl to void
oc 10
oflush
end
note a failed check: FAIL KIND NAME then the reason; counts a failure
fn ofail kind view uchar * why view uchar * to void
ot t_fail
ot kind
onm
oc 32
ot why
onl
put g_n 11 add get g_n 11 1
end
fn ookn kind view uchar * to void
ot t_ok
ot kind
onm
end
note ---- paths: g_pa[0, g_n 0)
fn pclr to void
put g_n 0 0
end
fn pc c ulong to void
n = get g_n 0
if lt n len g_pa
put g_pa n uchar c
end
put g_n 0 add n 1
end
fn pt t view uchar * to void
for i ulong len t bound 4096
pc ulong get t i
end
end
fn pscr to void
for j ulong get g_n 2 bound 4096
pc ulong get g_scr j
end
end
fn pnm to void
for j ulong get g_n 14 bound 256
pc ulong get g_nm j
end
end
fn psn suf view uchar * to void
pclr
pscr
pnm
pt suf
end
fn nmset t view uchar * to void
for i ulong len t bound 256
put g_nm i get t i
end
put g_n 14 len t
end
note the path is usable (shorter than its buffer)
fn pok to bool
ret lt get g_n 0 len g_pa
end
note ---- files
fn fopn fl ulong mode ulong to int
if not pok
ret -1
end
r = fopen g_pa 0 get g_n 0 int fl int mode
if lt r 0
ret -1
end
ret int r
end
fn frd to int
ret fopn 524288 0
end
fn fwr to int
ret fopn 524865 420
end
fn fexe to int
if pok
r = unlink g_pa 0 get g_n 0
end
ret fopn 524865 448
end
fn fclo fd int to void
if ge fd 0
r = fclose fd
end
end
note append the file at g_pa to g_b; false when unreadable or past the buffer
fn bload to bool
fd = frd
if lt fd 0
ret false
end
n = get g_n 6
ok = true
while true bound 16777218
x = read fd g_b n sub len g_b n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_b
ok = false
break
end
end
fclo fd
put g_n 6 n
ret ok
end
note write g_b[0, g_n 6) to the file at g_pa (0644, or 0700 when exe)
fn bsave exe bool to bool
fd = int -1
if exe
fd = fexe
else
fd = fwr
end
if lt fd 0
ret false
end
n = get g_n 6
o = ulong 0
ok = true
while lt o n bound 16777217
x = write fd g_b o sub n o
if le x 0
ok = false
break
end
o = add o ulong x
end
fclo fd
ret ok
end
note sha256 of the file at g_pa into sh_dig; false when unreadable or past 16 MiB
fn fhash to bool
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 16777218
x = read fd sh_dat n sub len sh_dat n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len sh_dat
ok = false
break
end
end
fclo fd
if not ok
ret false
end
sh_all n
ret true
end
note the size of the file at g_pa, or 2^63 when unreadable
fn fsize to ulong
put g_n 6 0
if not bload
ret shl ulong 1 63
end
ret get g_n 6
end
note sh_dig equals the hex in g_hx
fn digeq to bool
for j ulong 32
b = get sh_dig j
if ne get g_hx mul j 2 sh_hexd uint shr b 4
ret false
end
if ne get g_hx add mul j 2 1 sh_hexd uint and b 15
ret false
end
end
ret true
end
note the path g_pa names an existing file (stat, never opened)
fn pexists to bool
if not pok
ret false
end
ret eq stat g_pa 0 get g_n 0 g_st 0 len g_st 0
end
note ---- processes
fn aclr to void
put g_n 3 2
put g_n 4 0
put g_av 0 0
put g_av 1 0
end
note append g_pa as one argument; false past the argument buffer
fn apa to bool
p = get g_n 3
n = get g_n 0
if or not pok gt add add p 2 n len g_av
ret false
end
for j ulong n bound 4096
put g_av add add p 2 j get g_pa j
end
put g_av p uchar and n 255
put g_av add p 1 uchar shr n 8
put g_n 3 add p add n 2
c = add get g_n 4 1
put g_n 4 c
put g_av 0 uchar and c 255
put g_av 1 uchar shr c 8
ret true
end
fn atx t view uchar * to void
pclr
pt t
z = apa
end
fn redir s int d int to void
if ne dupfd s d 0 long d
exit 127
end
end
note run the argument list with stdin, stdout, stderr fds (closed here): the exit code, 256 + the signal, 512
note when a file could not be opened, 1000 when the child passed the 600 s deadline (killed)
fn spawn fi int fo int fe int to ulong
if or lt fi 0 or lt fo 0 lt fe 0
fclo fi
fclo fo
fclo fe
ret 512
end
pid = fork
if lt pid 0
exit 2
end
if eq pid 0
redir fi 0
redir fo 1
redir fe 2
r = execprog g_av 0 get g_n 3
exit 127
end
fclo fi
fclo fo
fclo fe
t0 = monons
while true bound 1000000000
r = waitpid int pid g_stb 0 len g_stb 1
if eq r pid
x = ulong get g_stb 0
if ne x 0
ret add 256 x
end
ret ulong get g_stb 1
end
if lt r 0
exit 2
end
if gt sub monons t0 600000000000
r = killpid int pid 9
r = waitpid int pid g_stb 0 len g_stb 0
ret 1000
end
q = sleepns 200000
end
exit 2
end
note run the argument list with stdin /dev/null, stdout SCRATCH/NAME.SUF, stderr SCRATCH/NAME.ERR
fn spawnf suf view uchar * err view uchar * to ulong
pclr
pt t_null
fi = frd
psn suf
fo = fwr
psn err
fe = fwr
ret spawn fi fo fe
end
note OMC < SCRATCH/NAME.om > SCRATCH/NAME.bin 2> SCRATCH/NAME.err; the spawn result
fn omcr to ulong
psn t_om
fi = frd
aclr
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
z = apa
psn t_bin
fo = fexe
psn t_err
fe = fwr
r = spawn fi fo fe
ret r
end
fn omc to bool
if ne omcr 0
ret false
end
psn t_err
ret eq fsize 0
end
note save g_b as SCRATCH/NAME.om and compile it; reported
fn build to bool
psn t_om
if not bsave false
ofail t_unit t_write
ret false
end
if not omc
ofail t_unit t_cmp
ret false
end
psn t_bin
z = fhash
ookn t_unit
ot t_sha
ohex
onl
ret true
end
note ---- the compiler digest
fn pinread to bool
pclr
pt t_pin
put g_n 6 0
if not bload
ret false
end
if lt get g_n 6 64
ret false
end
for j ulong 64
c = get g_b j
ok = or and ge c 48 le c 57 and ge c 97 le c 102
if not ok
ret false
end
put g_pin j c
end
ret true
end
fn pinok to bool
if not fhash
ret false
end
for j ulong 64
put g_hx j get g_pin j
end
ret digeq
end
note ---- composing sources into g_b
fn lit t view uchar * to void
n = get g_n 6
if gt add n len t len g_b
put g_m 2 1
ret
end
for q ulong len t bound 4096
put g_b add n q get t q
end
put g_n 6 add n len t
end
note append decimal v to g_b
fn bnum v ulong to void
if ge v 10
bnum div v 10
end
n = get g_n 6
if ge n len g_b
put g_m 2 1
ret
end
put g_b n uchar add 48 rem v 10
put g_n 6 add n 1
end
fn bch c ulong to void
n = get g_n 6
if ge n len g_b
put g_m 2 1
ret
end
put g_b n uchar c
put g_n 6 add n 1
end
note append the file named by text t to g_b; reported when unreadable
fn capp t view uchar * to bool
pclr
pt t
if bload
ret true
end
nmset t
ofail t_unit t_src
ret false
end
note cut g_b at the first line, at or after st, that starts with "fn main to int"
fn mcut st ulong to void
n = get g_n 6
p = st
while lt p n bound 16777216
if mline p n
put g_n 6 p
ret
end
while and lt p n ne get g_b p 10 bound 16777216
p = add p 1
end
p = add p 1
end
end
fn mline p ulong n ulong to bool
if gt add p len t_main n
ret false
end
for q ulong len t_main
if ne get g_b add p q get t_main q
ret false
end
end
ret true
end
note copy g_b to g_c (false past g_c)
fn tocopy to bool
n = get g_n 6
if gt n len g_c
ret false
end
for j ulong n bound 1048576
put g_c j get g_b j
end
put g_m 12 n
ret true
end
note ---- tables: g_t[0, g_m 0), fields of the current row in g_fs/g_fe
fn tload t view uchar * to bool
pclr
pt t
fd = frd
if lt fd 0
ret false
end
n = ulong 0
ok = true
while true bound 1048578
x = read fd g_t n sub len g_t n
if lt x 0
ok = false
break
end
if eq x 0
break
end
n = add n ulong x
if ge n len g_t
ok = false
break
end
end
fclo fd
put g_m 0 n
ret ok
end
note split the row starting at s into fields; the index of its end (a newline or the table end)
fn trow s ulong to ulong
n = get g_m 0
k = ulong 0
put g_fs 0 s
p = s
while and lt p n ne get g_t p 10 bound 1048577
if and eq get g_t p 9 lt k 15
put g_fe k p
k = add k 1
put g_fs k add p 1
end
p = add p 1
end
put g_fe k p
put g_m 1 add k 1
ret p
end
fn tcom s ulong e ulong to bool
if ge s e
ret true
end
ret eq get g_t s 35
end
fn flen i ulong to ulong
ret sub get g_fe i get g_fs i
end
fn fch i ulong j ulong to ulong
ret ulong get g_t add get g_fs i j
end
fn fis i ulong t view uchar * to bool
if ne flen i len t
ret false
end
for j ulong len t bound 4096
if ne fch i j ulong get t j
ret false
end
end
ret true
end
note the name := field i; false when longer than the name buffer
fn fnm i ulong to bool
n = flen i
if ge n len g_nm
nmset t_nmlong
ret false
end
for j ulong n bound 256
put g_nm j uchar fch i j
end
put g_n 14 n
ret true
end
note field i as a decimal number; sets g_m 2 when it is not one
fn fnum i ulong to ulong
n = flen i
if or eq n 0 gt n 20
put g_m 2 1
ret 0
end
v = ulong 0
for j ulong n bound 20
c = fch i j
if or lt c 48 gt c 57
put g_m 2 1
ret 0
end
v = add mul v 10 sub c 48
end
ret v
end
fn hexv c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
put g_m 2 1
ret 0
end
note field i as hex (at most 16 digits)
fn fhexn i ulong to ulong
n = flen i
if or eq n 0 gt n 16
put g_m 2 1
ret 0
end
v = ulong 0
for j ulong n bound 16
v = or shl v 4 hexv fch i j
end
ret v
end
note field i, 64 hex digits, into g_hx; flipped once when g_m 14 is set (a control)
fn fhx i ulong to bool
if ne flen i 64
ret false
end
for j ulong 64
put g_hx j uchar fch i j
end
if eq get g_m 14 1
put g_m 14 0
if eq get g_hx 0 48
put g_hx 0 49
else
put g_hx 0 48
end
end
ret true
end
fn hfld i ulong to bool
if not fhx i
ret false
end
ret digeq
end
note the file at g_pa hashes to field i
fn fhfld i ulong to bool
if not fhash
ret false
end
ret hfld i
end
note find the first row whose field 0 is a and (when b is not empty) field 1 is b; fields left set
fn tfind a view uchar * b view uchar * to bool
s = ulong 0
n = get g_m 0
while lt s n bound 1048577
e = trow s
if and fis 0 a or eq len b 0 fis 1 b
ret true
end
s = add e 1
end
ret false
end
note append field i to g_b with backslash escapes undone
fn funesc i ulong to void
p = get g_fs i
e = get g_fe i
while lt p e bound 1048577
c = fch i sub p get g_fs i
if and eq c 92 lt add p 1 e
p = add p 1
c = fch i sub p get g_fs i
if eq c 110
c = 10
end
if eq c 116
c = 9
end
end
bch c
p = add p 1
end
end
note append field i to the path
fn fpa i ulong to void
for j ulong flen i bound 1048576
pc fch i j
end
end
note ---- ELF reading over g_b[0, g_n 6)
fn rdle o ulong w ulong to ulong
if or lt add o w o gt add o w get g_n 6
put g_m 2 1
ret 0
end
v = ulong 0
for j ulong w bound 8
v = or v shl ulong get g_b add o j mul j 8
end
ret v
end
fn bat p ulong c ulong to bool
if ge p get g_n 6
ret false
end
ret eq ulong get g_b p c
end
fn strat p ulong t view uchar * to bool
for j ulong len t bound 64
if not bat add p j ulong get t j
ret false
end
end
ret bat add p len t 0
end
note the bytes at p are the name, then suf, then NUL
fn stnm p ulong suf view uchar * to bool
k = get g_n 14
for j ulong k bound 256
if not bat add p j ulong get g_nm j
ret false
end
end
for j ulong len suf bound 64
if not bat add add p k j ulong get suf j
ret false
end
end
ret bat add add p k len suf 0
end
note file offset of the section named t; g_m 3 its size, g_m 4 its address; g_m 2 set when absent or past the file
fn secf t view uchar * to ulong
so = rdle 40 8
sn = rdle 60 2
stro = rdle add add so mul rdle 62 2 64 24 8
for i ulong sn bound 65536
h = add so mul i 64
if strat add stro rdle h 4 t
ret sech h
end
end
put g_m 3 0
put g_m 2 1
ret 0
end
fn sech h ulong to ulong
put g_m 3 rdle add h 32 8
put g_m 4 rdle add h 16 8
o = rdle add h 24 8
e = add o get g_m 3
if or lt e o gt e get g_n 6
put g_m 2 1
end
ret o
end
note the value of the symbol named NAME then suf; g_m 2 set when absent
fn symv suf view uchar * to ulong
so = secf t_strtab
sy = secf t_symtab
n = div get g_m 3 24
for i ulong n bound 1048576
e = add sy mul i 24
if stnm add so rdle e 4 suf
ret rdle add e 8 8
end
end
put g_m 2 1
ret 0
end
note sha256 of g_b[o, o+n) into sh_dig
fn bhash o ulong n ulong to void
if or lt add o n o gt add o n get g_n 6
put g_m 2 1
n = 0
end
for j ulong n bound 16777216
put sh_dat j get g_b add o j
end
sh_all n
end
note ---- 1. llvm-mc parity
note the writer: SCRATCH/hsaco.bin TABLE > SCRATCH/NAME.hsaco; TABLE is gpu/amd/gfx942/NAME.isa (tbl 0) or SCRATCH/NAME.isa
fn wrun tbl ulong to ulong
aclr
nm0 = get g_n 14
pclr
pscr
pt t_hsaco
pt t_bin
z = apa
pclr
if eq tbl 0
pt t_isa
pnm
pt t_isx
else
pscr
pnm
pt t_isx
end
z = apa
ret spawnf t_hs t_hse
end
note load SCRATCH/NAME.hsaco into g_b
fn objload to bool
put g_n 6 0
psn t_hs
ret bload
end
note the object in g_b against the current sections row (NAME is the kernel)
fn secchk to bool
put g_m 2 0
xo = secf t_text
tn = get g_m 3
bhash xo tn
ok = and eq tn fnum 1 hfld 2
no = secf t_note
nn = get g_m 3
bhash no nn
ok = and ok and eq nn fnum 3 hfld 4
ro = secf t_rod
rn = get g_m 3
if lt rn 24
ret false
end
bhash ro 16
ok = and ok hfld 5
bhash add ro 24 sub rn 24
ok = and ok hfld 6
disp = rdle add ro 16 8
kv = symv t_e
dv = symv t_kd
ok = and ok eq disp sub kv dv
ok = and ok eq rdle 48 4 1356
ret and ok eq get g_m 2 0
end
fn slsec to void
if not tload t_tsec
nmset t_tsec
ofail t_tbl t_unread
ret
end
s = ulong 0
n = get g_m 0
while lt s n bound 1048577
e = trow s
if not tcom s e
if or ne get g_m 1 7 not fnm 0
ofail t_sec t_rowbad
else
r = wrun 0
if ne r 0
ofail t_sec t_wexit
else
if not objload
ofail t_sec t_noobj
else
if secchk
ookn t_sec
ot t_textn
onum fnum 1
ot t_noten
onum fnum 3
onl
put g_m 8 add get g_m 8 1
psn t_ok_
put g_n 6 0
z = bsave false
else
ofail t_sec t_mism
end
end
end
end
end
s = add e 1
end
end
note ---- controls
fn caught c bool what view uchar * to void
put g_n 12 add get g_n 12 1
nmset what
if c
ot t_ok
ot t_ctl
onm
ot t_caught
onl
put g_n 13 add get g_n 13 1
else
ofail t_ctl t_esc
end
end
note a compiler one byte longer must fail the digest check
fn cwrong to void
pclr
for j ulong get g_n 1 bound 4096
pc ulong get g_omc j
end
put g_n 6 0
ok = bload
n = get g_n 6
put g_b n 0
put g_n 6 add n 1
nmset t_plus
psn t_e
ok = and ok bsave true
psn t_e
c = and ok not pinok
caught c t_plus
end
note the vadd llvm row with one digest character changed must not match the vadd object
fn cflip to void
nmset t_vadd
ok = and objload tfind t_vadd t_e
put g_m 14 1
c = and ok not secchk
put g_m 14 0
caught c t_flip
end
note vadd.isa with the operand 260 changed to 261 must not match the vadd llvm row
fn c261 to void
put g_n 6 0
pclr
pt t_isa
pt t_vadd
pt t_isx
ok = bload
n = get g_n 6
hit = n
for p ulong n bound 16777216
if and eq hit n bmatch p t_f260
hit = p
end
end
nmset t_k261
if or not ok eq hit n
ofail t_ctl t_noapp
ret
end
put g_b add hit 6 49
psn t_isx
ok = bsave false
r = wrun 1
c = ne r 0
if not c
z = objload
nmset t_vadd
c = not and tfind t_vadd t_e secchk
end
caught and ok c t_k261
end
fn bmatch p ulong t view uchar * to bool
if gt add p len t get g_n 6
ret false
end
for q ulong len t bound 64
if ne get g_b add p q get t q
ret false
end
end
ret true
end
note ---- 2. launcher verdicts
note compose the launcher sources (main.om too when withmain) after om2 (and the x86 target line)
fn lsrc x86 bool withmain bool to bool
put g_n 6 0
if x86
lit t_x86
end
lit t_om2
ok = capp t_lc
ok = and ok capp t_le
ok = and ok capp t_ldv
ok = and ok capp t_ldi
ok = and ok capp t_lpl
if withmain
ok = and ok capp t_lmn
end
ret and ok capp t_cli
end
fn blaunch x86 bool to void
if not lsrc x86 true
ret
end
if x86
nmset t_lx
else
nmset t_la
end
z = build
end
note an object built in slice 1 that passed its llvm row and hashes to field 2
fn objchk to bool
psn t_ok_
if not pexists
ret false
end
psn t_hs
ret fhfld 2
end
fn vobj to void
if or ne get g_m 1 3 not fnm 1
ofail t_ver t_rowbad
ret
end
if objchk
ookn t_ver
ot t_sha
ohex
onl
put g_m 10 add get g_m 10 1
put g_m 9 add get g_m 9 1
else
ofail t_ver t_mism
end
end
note store the w low bytes of v at o in g_b, or them in when isor
fn stle o ulong w ulong v ulong isor bool to void
x = v
if isor
x = or x rdle o w
end
if gt add o w get g_n 6
put g_m 2 1
ret
end
for j ulong w bound 8
put g_b add o j uchar and shr x mul j 8 255
end
end
fn vmut to void
if or ne get g_m 1 7 not fnm 1
ofail t_ver t_rowbad
ret
end
put g_m 2 0
nmset t_vadd
z = objload
kd = ulong 0
if fis 3 t_bk
kv = symv t_kd
ro = secf t_rod
kd = sub add ro kv get g_m 4
end
o = add kd fnum 4
v = fnum 5
if fis 2 t_keep
if gt o get g_n 6
put g_m 2 1
end
put g_n 6 o
end
if fis 2 t_set16
stle o 2 v false
end
if fis 2 t_set32
stle o 4 v false
end
if fis 2 t_set64
stle o 8 v false
end
if fis 2 t_or16
stle o 2 v true
end
if fis 2 t_or32
stle o 4 v true
end
z = fnm 1
psn t_hs
ok = and eq get g_m 2 0 bsave false
if and ok fhfld 6
ookn t_ver
ot t_sha
ohex
onl
put g_m 9 add get g_m 9 1
else
ofail t_ver t_inmis
end
end
fn vfile to void
if or ne get g_m 1 4 not fnm 1
ofail t_ver t_rowbad
ret
end
put g_m 2 0
put g_n 6 0
n = flen 3
for j ulong div n 2 bound 1048576
bch or shl hexv fch 3 mul j 2 4 hexv fch 3 add mul j 2 1
end
psn t_e
ok = and eq get g_m 2 0 bsave false
if and ok fhfld 2
ookn t_ver
ot t_sha
ohex
onl
put g_m 9 add get g_m 9 1
else
ofail t_ver t_inmis
end
end
fn vunit to void
if or ne get g_m 1 4 not fnm 1
ofail t_ver t_rowbad
ret
end
put g_m 2 0
if not lsrc false false
ret
end
funesc 3
z = fnm 1
psn t_om
ok = and eq get g_m 2 0 bsave false
if not and ok fhfld 2
ofail t_ver t_inmis
ret
end
z = build
end
note the argv of field 3: ^X is SCRATCH/X.bin, @X is SCRATCH/X, others literal; x86 runs under qemu
fn rargv x86 bool to bool
aclr
ok = true
if x86
pclr
pt t_qemu
ok = apa
end
p = get g_fs 3
e = get g_fe 3
b = get g_fs 3
while lt p e bound 1048577
q = p
while and lt q e ne get g_t q 32 bound 1048577
q = add q 1
end
pclr
c = get g_t p
st = p
if or eq c 94 eq c 64
pscr
st = add p 1
end
if isemp p q
st = q
end
for j ulong sub q st bound 1048576
pc ulong get g_t add st j
end
if eq c 94
pt t_bin
end
ok = and ok apa
p = add q 1
end
ret ok
end
note the second word of field 3 is t
fn fverb t view uchar * to bool
p = get g_fs 3
e = get g_fe 3
while and lt p e ne get g_t p 32 bound 1048577
p = add p 1
end
p = add p 1
if gt add p len t e
ret false
end
for j ulong len t bound 64
if ne get g_t add p j get t j
ret false
end
end
q = add p len t
ret or eq q e eq get g_t q 32
end
note the file at g_pa holds the unescaped field i (flipped once when g_m 14 is set)
fn fcmp i ulong to bool
put g_n 6 0
if not bload
ret false
end
n1 = get g_n 6
funesc i
n2 = get g_n 6
if eq get g_m 14 1
put g_m 14 0
if gt n2 n1
put g_b n1 uchar xor ulong get g_b n1 1
else
bch 88
n2 = get g_n 6
end
end
if ne sub n2 n1 n1
ret false
end
for j ulong n1 bound 16777216
if ne get g_b j get g_b add n1 j
ret false
end
end
ret true
end
note run the current run row; 0 ok, 1 mismatch, 2 not run
fn vrun1 to ulong
x86 = fis 1 t_vx86
if and x86 eq get g_m 5 0
ret 2
end
dev = or or fverb t_vvadd fverb t_vrun fverb t_vplan
if and dev eq get g_m 6 0
ret 3
end
if not rargv x86
ret 1
end
nmset t_krun
r = spawnf t_out t_err
put g_m 2 0
ok = eq r fnum 4
psn t_out
ok = and ok fcmp 5
psn t_err
ok = and ok fcmp 6
if and ok eq get g_m 2 0
ret 0
end
ret 1
end
fn vrun to void
if ne get g_m 1 7
nmset t_krun
ofail t_ver t_rowbad
ret
end
r = vrun1
put g_n 14 0
for j ulong flen 2 bound 256
put g_nm j uchar fch 2 j
put g_n 14 add j 1
end
if eq r 0
ookn t_ver
ot t_exit
onum fnum 4
onl
put g_m 9 add get g_m 9 1
ret
end
if ge r 2
ot t_nr
ot t_ver
onm
if eq r 2
ot t_noq
else
ot t_dev
end
onl
put g_m 7 add get g_m 7 1
ret
end
ofail t_ver t_mism
end
fn sllaunch to void
pclr
pt t_qemu
if pexists
put g_m 5 1
end
pclr
pt t_kfd
if not pexists
put g_m 6 1
end
blaunch false
blaunch true
if not tload t_tlv
nmset t_tlv
ofail t_tbl t_unread
ret
end
s = ulong 0
n = get g_m 0
while lt s n bound 1048577
e = trow s
if not tcom s e
if fis 0 t_kobj
vobj
else
if fis 0 t_kmut
vmut
else
if fis 0 t_kfile
vfile
else
if fis 0 t_kunit
vunit
else
if fis 0 t_krun
vrun
else
if fis 0 t_knr
vnotrun
else
nmset t_tlv
ofail t_ver t_rowbad
end
end
end
end
end
end
end
s = add e 1
end
end
note an object with no llvm row (the 261 control's) must not pass the object check
fn cnorow to void
nmset t_k261
put g_m 1 3
c = not objchk
caught c t_nrow
end
note the first launcher verdict row with its expected bytes changed must not match
fn cvflip to void
ok = tfind t_krun t_a64
if ok
put g_m 14 1
r = vrun1
put g_m 14 0
ok = eq r 1
end
caught ok t_vflip
end
note ---- 6. plan verdicts (was tests/amd-kfd-launch/plan-check.py, CPU part)
note SCRATCH/BASE with the bytes of field 4 written at field 3 (one later when g_m 24 is set), saved as SCRATCH/NAME;
note true when it hashes to field 5
fn vpatch1 to bool
put g_m 2 0
put g_n 6 0
if not fnm 2
ret false
end
psn t_e
ok = bload
o = add fnum 3 get g_m 24
n = flen 4
if or ne rem n 2 0 gt add o div n 2 get g_n 6
put g_m 2 1
end
if eq get g_m 2 0
for j ulong div n 2 bound 1048576
put g_b add o j uchar or shl hexv fch 4 mul j 2 4 hexv fch 4 add mul j 2 1
end
end
if not fnm 1
ret false
end
psn t_e
ok = and ok and eq get g_m 2 0 bsave false
ret and ok fhfld 5
end
fn vpatch to void
if ne get g_m 1 6
nmset t_kpat
ofail t_ver t_rowbad
ret
end
if vpatch1
ookn t_ver
ot t_sha
ohex
onl
put g_m 9 add get g_m 9 1
else
ofail t_ver t_inmis
end
end
fn vnotrun to void
if or ne get g_m 1 3 not fnm 1
nmset t_knr
ofail t_ver t_rowbad
ret
end
ot t_nr
ot t_ver
onm
ot t_rsn
for j ulong flen 2 bound 1048576
oc fch 2 j
end
onl
put g_m 7 add get g_m 7 1
end
note true when the token g_t[p, q) is '' (an empty argument)
fn isemp p ulong q ulong to bool
if ne sub q p 2
ret false
end
ret and eq get g_t p 39 eq get g_t add p 1 39
end
fn planrow to void
if fis 0 t_kfile
vfile
ret
end
if fis 0 t_kpat
vpatch
ret
end
if fis 0 t_krun
vrun
ret
end
if fis 0 t_knr
vnotrun
ret
end
nmset t_tpv
ofail t_ver t_rowbad
end
note the start of the first row whose field 0 is a and field i is b; the table length when none
fn tfrow a view uchar * i ulong b view uchar * to ulong
s = ulong 0
n = get g_m 0
while lt s n bound 1048577
e = trow s
if and fis 0 a fis i b
ret s
end
s = add e 1
end
ret n
end
note controls: the bad-magic patch written one byte later must not hash as recorded; the a64 bad-magic refusal
note row run on valid.plan's bytes must not give its recorded verdict (runs only when /dev/kfd is absent)
fn cplan to void
s = tfrow t_kpat 1 t_bmp
ok = lt s get g_m 0
if ok
e = trow s
put g_m 24 1
ok = not vpatch1
put g_m 24 0
end
caught ok t_cshift
if eq get g_m 6 0
nmset t_cvalid
ot t_nr
ot t_ctl
onm
ot t_dev
onl
put g_m 7 add get g_m 7 1
ret
end
put g_n 6 0
pclr
pscr
pt t_vpl
ok = bload
pclr
pscr
pt t_bmp
ok = and ok bsave false
s = tfrow t_krun 2 t_cbm
ok = and ok lt s get g_m 0
if ok
e = trow s
ok = eq vrun1 1
end
caught ok t_cvalid
end
fn slplan to void
if not tload t_tpv
nmset t_tpv
ofail t_tbl t_unread
ret
end
v0 = get g_m 9
s = ulong 0
n = get g_m 0
while lt s n bound 1048577
e = trow s
if not tcom s e
planrow
end
s = add e 1
end
put g_m 19 sub get g_m 9 v0
cplan
end
note ---- 3. writer verdicts
note g_b := sgemm.isa up to its first line starting "I "
fn sopphdr to bool
put g_n 6 0
pclr
pt t_isa
pt t_sgemm
pt t_isx
if not bload
ret false
end
n = get g_n 6
p = ulong 0
while lt p n bound 16777216
if and bat p 73 bat add p 1 32
put g_n 6 p
ret true
end
while and lt p n ne get g_b p 10 bound 16777216
p = add p 1
end
p = add p 1
end
ret true
end
fn waits k ulong to void
for j ulong k bound 1000000
lit t_wait
end
end
fn sopp a view uchar * k ulong b view uchar * to bool
if not sopphdr
ret false
end
lit a
waits k
lit b
lit t_end
ret true
end
note g_b := fp8gemv.isa (and a copy in g_c)
fn fp8load to bool
put g_n 6 0
pclr
pt t_isa
pt t_fp8
pt t_isx
if not bload
ret false
end
ret tocopy
end
fn isws c ulong to bool
ret or eq c 32 and ge c 9 le c 13
end
note the F/B/D/I lines whose second word is not 4 get 1000000 added to it, words joined by one space
fn sparse to bool
if not fp8load
ret false
end
put g_n 6 0
n = get g_m 12
p = ulong 0
while lt p n bound 1048577
q = p
while and lt q n ne get g_c q 10 bound 1048577
q = add q 1
end
sline p q
bch 10
p = add q 1
end
ret true
end
fn gcw p ulong q ulong to ulong
while and lt p q isws ulong get g_c p bound 1048577
p = add p 1
end
ret p
end
fn gce p ulong q ulong to ulong
while and lt p q not isws ulong get g_c p bound 1048577
p = add p 1
end
ret p
end
fn sline p ulong q ulong to void
a = gcw p q
ae = gce a q
b = gcw ae q
be = gce b q
four = or eq b be and eq sub be b 1 eq get g_c b 52
if and not four stag a ae
bch ulong get g_c a
bch 32
semit b be q
ret
end
for j ulong sub q p bound 1048576
bch ulong get g_c add p j
end
end
note the first word is one of F B D I
fn stag a ulong ae ulong to bool
c = ulong get g_c a
ret and eq sub ae a 1 or or eq c 70 eq c 66 or eq c 68 eq c 73
end
note the second word plus 1000000, then the remaining words, each after one space
fn semit b ulong be ulong q ulong to void
v = ulong 0
for j ulong sub be b bound 20
v = add mul v 10 sub ulong get g_c add b j 48
end
bnum add v 1000000
w = gcw be q
while lt w q bound 1048577
we = gce w q
bch 32
for j ulong sub we w bound 1048576

note ---- buffered stdout writer

fn ad_ob_reset to void
put ad_olen 0 0
end

fn ad_ob_byte c uchar to void
n = get ad_olen 0
if lt n len ad_obuf
put ad_obuf n c
put ad_olen 0 add n 1
end
end

fn ad_ob_str s view uchar * to void
for i ulong len s
ad_ob_byte get s i
end
end

fn ad_ob_u64 v ulong to void
d = new uchar 24 0
pos = ulong 24
x = v
for it ulong 24
pos = sub pos 1
put d pos uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
for k ulong sub 24 pos
ad_ob_byte get d add pos k
end
end

fn ad_ob_i64 v long to void
if lt v 0
ad_ob_str ta_minus
ad_ob_u64 ulong neg v
else
ad_ob_u64 ulong v
end
end

fn ad_ob_flush to void
total = get ad_olen 0
off = ulong 0
note each iteration writes at least 1 byte or aborts, bounded by buffer size 32768
while lt off total bound 32768
k = write 1 ad_obuf off sub total off
if le k 0
break
end
off = add off ulong k
end
put ad_olen 0 0
end

note ---- hardware device capability table

fn adapter_reset_devices to void
put ad_dev_cnt 0 0
end

fn adapter_add_device vendor ulong arch ulong vram_gib ulong cc_maj ulong cc_min ulong flags ulong to int
cnt = get ad_dev_cnt 0
if ge cnt AD_MAX_DEV
ret AD_ERR_BAD_REQ
end
put ad_dev_vendor cnt vendor
put ad_dev_arch cnt arch
put ad_dev_vram cnt mul vram_gib AD_GIB
put ad_dev_cc_maj cnt cc_maj
put ad_dev_cc_min cnt cc_min
put ad_dev_flags cnt flags
put ad_dev_tflops cnt 100
put ad_dev_bw cnt 500
put ad_dev_online cnt 1
put ad_dev_cnt 0 add cnt 1
ret AD_OK
end

fn adapter_set_perf dev_id ulong tflops ulong bw_gbps ulong online bool to void
if lt dev_id get ad_dev_cnt 0
put ad_dev_tflops dev_id tflops
put ad_dev_bw dev_id bw_gbps
if online
put ad_dev_online dev_id 1
else
put ad_dev_online dev_id 0
end
end
end

fn adapter_init_default_devices to void
adapter_reset_devices
note 0: NVIDIA DGX Spark GB10 (SM 12.1, 128 GiB unified LPDDR5X, FP16/BF16/FP8/INT8/TF32/NVFP4/UNIFIED)
r0 = adapter_add_device VENDOR_NVIDIA ARCH_GB10_SM121 128 12 1 0x7f
adapter_set_perf 0 250 273 true
note 1: NVIDIA H100 SXM5 (SM 9.0, 80 GiB HBM3, FP16/BF16/FP8/INT8/TF32)
r1 = adapter_add_device VENDOR_NVIDIA ARCH_H100_SM90 80 9 0 0x1f
adapter_set_perf 1 989 3350 true
note 2: NVIDIA A100 SXM4 (SM 8.0, 40 GiB HBM2e, FP16/BF16/INT8/TF32, no FP8)
r2 = adapter_add_device VENDOR_NVIDIA ARCH_A100_SM80 40 8 0 0x1b
adapter_set_perf 2 312 1555 true
note 3: NVIDIA RTX 4090 (SM 8.9, 24 GiB GDDR6X, FP16/BF16/FP8/INT8/TF32)
r3 = adapter_add_device VENDOR_NVIDIA ARCH_RTX4090_SM89 24 8 9 0x1f
adapter_set_perf 3 165 1008 true
note 4: AMD Instinct MI300X (CDNA3 9.4, 192 GiB HBM3, FP16/BF16/FP8/INT8, no TF32)
r4 = adapter_add_device VENDOR_AMD ARCH_MI300X_GFX942 192 9 4 0x0f
adapter_set_perf 4 1307 5300 true
note 5: Apple M4 Max (64 GiB unified, FP16/BF16/INT8/UNIFIED, no FP8/TF32)
r5 = adapter_add_device VENDOR_APPLE ARCH_M4_MAX 64 4 0 0x4b
adapter_set_perf 5 54 546 true
sum_rc = add r0 add r1 add r2 add r3 add r4 r5
if ne sum_rc 0
ret
end
end

note ---- capability checking, strict refusal, and deterministic scoring

fn adapter_cc_packed maj ulong mn ulong to ulong
ret add mul maj 10 mn
end

fn adapter_check_device dev_id ulong req view WorkloadReq to int
if ge dev_id get ad_dev_cnt 0
ret AD_ERR_NO_DEVICES
end
if eq get ad_dev_online dev_id 0
ret AD_ERR_OFFLINE
end
if lt get ad_dev_vram dev_id get req min_vram
ret AD_ERR_VRAM_EXCEEDED
end
req_f = get req req_flags
dev_f = get ad_dev_flags dev_id
if ne and dev_f req_f req_f
ret AD_ERR_PRECISION
end
dev_cc = adapter_cc_packed get ad_dev_cc_maj dev_id get ad_dev_cc_min dev_id
req_cc = adapter_cc_packed get req min_cc_maj get req min_cc_min
if lt dev_cc req_cc
ret AD_ERR_CC_LOW
end
ret AD_OK
end

fn adapter_score_device dev_id ulong req view WorkloadReq to ulong
sc = mul get ad_dev_tflops dev_id 10
sc = add sc mul get ad_dev_bw dev_id 2
vram_gib = div get ad_dev_vram dev_id AD_GIB
if gt vram_gib 256
vram_gib = 256
end
sc = add sc mul vram_gib 5
pv = get req pref_vendor
if and ne pv VENDOR_ANY eq get ad_dev_vendor dev_id pv
sc = add sc 50000
end
if get req pref_unified
if ne and get ad_dev_flags dev_id CAP_UNIFIED 0
sc = add sc 3000
end
end
ret sc
end

fn adapter_refusal_priority cur int cand int to int
if eq cur AD_OK
ret cand
end
note Prefer precision or VRAM refusal over generic offline when multiple devices fail
if eq cand AD_ERR_PRECISION
ret cand
end
if and eq cand AD_ERR_VRAM_EXCEEDED ne cur AD_ERR_PRECISION
ret cand
end
if and eq cand AD_ERR_CC_LOW eq cur AD_ERR_OFFLINE
ret cand
end
ret cur
end

fn adapter_select req view WorkloadReq sel edit AdapterSel to int
put sel ok false
put sel err AD_OK
put sel dev_id 0
put sel score 0
put sel checked 0
put sel eligible 0
cnt = get ad_dev_cnt 0
if eq cnt 0
put sel err AD_ERR_NO_DEVICES
ret AD_ERR_NO_DEVICES
end
if or eq get req min_vram 0 ne and get req req_flags xor CAP_ALL_MASK 0xffffffffffffffff 0
put sel err AD_ERR_BAD_REQ
ret AD_ERR_BAD_REQ
end
best_ref = AD_OK
for i ulong cnt bound 16
put sel checked add get sel checked 1
chk = adapter_check_device i req
if eq chk AD_OK
sc = adapter_score_device i req
put sel eligible add get sel eligible 1
if or not get sel ok gt sc get sel score
put sel ok true
put sel dev_id i
put sel score sc
end
else
best_ref = adapter_refusal_priority best_ref chk
end
end
if not get sel ok
put sel err best_ref
ret best_ref
end
ret AD_OK
end

note ---- deterministic hardware probe and selection output

fn ad_ob_vendor v ulong to void
if eq v VENDOR_NVIDIA
ad_ob_str ta_v_nv
ret
end
if eq v VENDOR_AMD
ad_ob_str ta_v_amd
ret
end
if eq v VENDOR_APPLE
ad_ob_str ta_v_apl
ret
end
ad_ob_str ta_v_cpu
end

fn ad_ob_arch a ulong to void
if eq a ARCH_GB10_SM121
ad_ob_str ta_a_gb10
ret
end
if eq a ARCH_H100_SM90
ad_ob_str ta_a_h100
ret
end
if eq a ARCH_A100_SM80
ad_ob_str ta_a_a100
ret
end
if eq a ARCH_RTX4090_SM89
ad_ob_str ta_a_4090
ret
end
if eq a ARCH_MI300X_GFX942
ad_ob_str ta_a_mi300
ret
end
if eq a ARCH_M4_MAX
ad_ob_str ta_a_m4
ret
end
ad_ob_str ta_a_cpu
end

fn adapter_print_probe to void
cnt = get ad_dev_cnt 0
ad_ob_reset
ad_ob_str ta_hdr
ad_ob_str ta_sep
for i ulong cnt bound 16
ad_ob_u64 i
ad_ob_str ta_sp
ad_ob_vendor get ad_dev_vendor i
ad_ob_str ta_sp
ad_ob_arch get ad_dev_arch i
ad_ob_str ta_sp
ad_ob_u64 div get ad_dev_vram i AD_GIB
ad_ob_str ta_sp
ad_ob_u64 get ad_dev_cc_maj i
ad_ob_str ta_dot
ad_ob_u64 get ad_dev_cc_min i
ad_ob_str ta_sp
ad_ob_u64 get ad_dev_flags i
ad_ob_str ta_sp
ad_ob_u64 get ad_dev_tflops i
ad_ob_str ta_sp
ad_ob_u64 get ad_dev_bw i
ad_ob_str ta_sp
if ne get ad_dev_online i 0
ad_ob_str ta_yes
else
ad_ob_str ta_no
end
ad_ob_str ta_nl
end
ad_ob_flush
end

fn adapter_print_selection sel view AdapterSel to void
ad_ob_reset
if get sel ok
ad_ob_str ta_sel_ok
ad_ob_u64 get sel dev_id
ad_ob_str ta_sel_sc
ad_ob_u64 get sel score
ad_ob_str ta_sel_el
ad_ob_u64 get sel eligible
ad_ob_str ta_sel_ch
ad_ob_u64 get sel checked
ad_ob_str ta_nl
else
ad_ob_str ta_sel_no
ad_ob_i64 long get sel err
ad_ob_str ta_nl
end
ad_ob_flush
end

note ---- upstream spark-adapters model provider router (src/router.rs)

fn ad_low c uchar to uchar
if and ge c 65 le c 90
ret uchar add c 32
end
ret c
end

fn ad_str_eq a view uchar * b view uchar * to bool
if ne len a len b
ret false
end
for i ulong len a bound 512
if ne get a i get b i
ret false
end
end
ret true
end

fn ad_str_starts a view uchar * pre view uchar * to bool
if lt len a len pre
ret false
end
for i ulong len pre bound 128
if ne get a i get pre i
ret false
end
end
ret true
end

fn ad_contains_exact a view uchar * pat view uchar * to bool
pl = len pat
al = len a
if or eq pl 0 lt al pl
ret false
end
lim = add sub al pl 1
for i ulong lim bound 4096
ok = true
for j ulong pl bound 128
if ne get a add i j get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn ad_contains_ci a view uchar * pat view uchar * to bool
pl = len pat
al = len a
if or eq pl 0 lt al pl
ret false
end
lim = add sub al pl 1
for i ulong lim bound 4096
ok = true
for j ulong pl bound 128
if ne ad_low get a add i j ad_low get pat j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn ad_set_route res edit RouteRes prov ulong ctx ulong rkey bool isres bool cat ulong to void
put res provider prov
put res ctx_len ctx
put res requires_key rkey
put res is_resident isres
put res matched_catalog true
put res cat_idx cat
end

fn adapter_resolve_catalog q view uchar * res edit RouteRes to bool
if ad_str_eq q tr_cat0
ad_set_route res PROV_LOCAL_MAX 32768 false true 0
ret true
end
if or ad_str_eq q tr_cat1 ad_str_eq q tr_cat1m
ad_set_route res PROV_OPENAI 128000 true false 1
ret true
end
if or ad_str_eq q tr_cat2 ad_str_eq q tr_cat2m
ad_set_route res PROV_OPENAI 200000 true false 2
ret true
end
if or ad_str_eq q tr_cat3 ad_str_eq q tr_cat3m
ad_set_route res PROV_ANTHROPIC 200000 true false 3
ret true
end
if ad_str_eq q tr_cat4
ad_set_route res PROV_OPENROUTER 128000 true false 4
ret true
end
if or ad_str_eq q tr_cat5 ad_str_eq q tr_cat5m
ad_set_route res PROV_GEMINI 1000000 true false 5
ret true
end
if or ad_str_eq q tr_cat6 ad_str_eq q tr_cat6m
ad_set_route res PROV_GROQ 128000 true false 6
ret true
end
if or ad_str_eq q tr_cat7 ad_str_eq q tr_cat7m
ad_set_route res PROV_OLLAMA 32768 false false 7
ret true
end
if or ad_str_eq q tr_cat8 ad_str_eq q tr_cat8m
ad_set_route res PROV_DEEPSEEK 64000 true false 8
ret true
end
ret false
end

fn adapter_resolve_route q view uchar * res edit RouteRes to void
if adapter_resolve_catalog q res
ret
end
put res matched_catalog false
put res cat_idx 0
if ad_str_starts q tr_p_openai
put res provider PROV_OPENAI
put res ctx_len 128000
put res requires_key true
put res is_resident false
ret
end
if ad_str_starts q tr_p_anth
put res provider PROV_ANTHROPIC
put res ctx_len 200000
put res requires_key true
put res is_resident false
ret
end
if ad_str_starts q tr_p_or
put res provider PROV_OPENROUTER
put res ctx_len 128000
put res requires_key true
put res is_resident false
ret
end
if ad_str_starts q tr_p_gem
put res provider PROV_GEMINI
put res ctx_len 1000000
put res requires_key true
put res is_resident false
ret
end
if ad_str_starts q tr_p_groq
put res provider PROV_GROQ
put res ctx_len 128000
put res requires_key true
put res is_resident false
ret
end
if ad_str_starts q tr_p_oll
put res provider PROV_OLLAMA
put res ctx_len 32768
put res requires_key false
put res is_resident false
ret
end
if ad_str_starts q tr_p_ds
put res provider PROV_DEEPSEEK
put res ctx_len 64000
put res requires_key true
put res is_resident false
ret
end
note Fallback to local resident GB10 Modular MAX seat
put res provider PROV_LOCAL_MAX
put res ctx_len 32768
put res requires_key false
put res is_resident true
end

note ---- upstream sovereign verifier (src/verifier.rs)

fn ad_has_utf8_dash buf view uchar * b2 uchar to bool
n = len buf
if lt n 3
ret false
end
lim = sub n 2
for i ulong lim bound 4096
if eq get buf i 0xe2
if eq get buf add i 1 0x80
if eq get buf add i 2 b2
ret true
end
end
end
end
ret false
end

fn ad_check_delimiters buf view uchar * to bool
stk = new uchar 256 0
sp = ulong 0
in_str = false
esc = false
for i ulong len buf bound 4096
c = get buf i
if esc
esc = false
continue
end
if eq c 92
esc = true
continue
end
if eq c 34
in_str = not in_str
continue
end
if in_str
continue
end
if or eq c 40 or eq c 91 eq c 123
if ge sp 256
ret false
end
put stk sp c
sp = add sp 1
end
if eq c 41
if eq sp 0
ret false
end
sp = sub sp 1
if ne get stk sp 40
ret false
end
end
if eq c 93
if eq sp 0
ret false
end
sp = sub sp 1
if ne get stk sp 91
ret false
end
end
if eq c 125
if eq sp 0
ret false
end
sp = sub sp 1
if ne get stk sp 123
ret false
end
end
end
ret eq sp 0
end

fn ad_check_json_braces buf view uchar * to bool
first_l = long -1
last_r = long -1
for i ulong len buf bound 4096
c = get buf i
if and eq c 123 lt first_l 0
first_l = long i
end
if eq c 125
last_r = long i
end
end
if lt first_l 0
ret true
end
if lt last_r first_l
ret false
end
ret ad_check_delimiters buf
end

fn ad_count_cliches buf view uchar * to ulong
hits = ulong 0
if ad_contains_ci buf tv_b0
hits = add hits 1
end
if ad_contains_ci buf tv_b1
hits = add hits 1
end
if ad_contains_ci buf tv_b2
hits = add hits 1
end
if ad_contains_ci buf tv_b3
hits = add hits 1
end
if ad_contains_ci buf tv_b4
hits = add hits 1
end
if ad_contains_ci buf tv_b5
hits = add hits 1
end
if ad_contains_ci buf tv_b6
hits = add hits 1
end
if ad_contains_ci buf tv_b7
hits = add hits 1
end
if ad_contains_ci buf tv_b8
hits = add hits 1
end
ret hits
end

fn ad_count_sycophancy buf view uchar * to ulong
hits = ulong 0
if ad_contains_ci buf tv_s0
hits = add hits 1
end
if ad_contains_ci buf tv_s1
hits = add hits 1
end
if ad_contains_ci buf tv_s2
hits = add hits 1
end
if ad_contains_ci buf tv_s3
hits = add hits 1
end
if ad_contains_ci buf tv_s4
hits = add hits 1
end
ret hits
end

fn ad_count_secrets buf view uchar * to ulong
hits = ulong 0
if ad_contains_exact buf tv_k0
hits = add hits 1
end
if ad_contains_exact buf tv_k1
hits = add hits 1
end
if ad_contains_exact buf tv_k2
hits = add hits 1
end
if ad_contains_exact buf tv_k3
hits = add hits 1
end
ret hits
end

fn adapter_verify buf view uchar * strategy ulong res edit VerifRes to void
score = f64 1.0f64
viol = ulong 0
crit = false
dok = true
if ad_has_utf8_dash buf 0x94
viol = add viol 1
score = sub score 0.25f64
end
if ad_has_utf8_dash buf 0x93
viol = add viol 1
score = sub score 0.15f64
end
hits = ad_count_cliches buf
if gt hits 0
viol = add viol hits
score = sub score mul f64 hits 0.15f64
end
hits = ad_count_sycophancy buf
if gt hits 0
viol = add viol hits
score = sub score mul f64 hits 0.20f64
end
hits = ad_count_secrets buf
if gt hits 0
viol = add viol hits
crit = true
score = 0.0f64
end
if eq strategy VERIF_COMPILER
dok = ad_check_delimiters buf
if not dok
viol = add viol 1
score = sub score 0.30f64
end
end
if eq strategy VERIF_JSON
dok = ad_check_json_braces buf
if not dok
viol = add viol 1
score = sub score 0.30f64
end
end
if eq strategy VERIF_UNSLOP_STRICT
if gt viol 0
score = fmin score 0.50f64
end
end
score = fmax 0.0f64 fmin 1.0f64 score
passed = eq viol 0
if not passed
if not crit
if ge score 0.70f64
passed = true
end
end
end
put res passed passed
put res critical crit
put res score score
put res violations viol
put res delim_ok dok
end

note ---- upstream distillation preference & Cortex commit selector (src/distill.rs)

fn adapter_distill_select t_pass bool t_score f64 s_pass bool s_score f64 commit_req bool dst edit DistillDec to void
put dst pref_delta sub t_score s_score
if and t_pass or not s_pass ge t_score s_score
put dst chosen CHOSEN_TEACHER
else
if and s_pass not t_pass
put dst chosen CHOSEN_STUDENT
else
put dst chosen CHOSEN_TEACHER
end
end
put dst commit_cortex and commit_req and t_pass ge t_score 0.85f64
end

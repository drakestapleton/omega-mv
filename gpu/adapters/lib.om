note gpu/adapters/lib.om: pure Omega hardware accelerator adapter layer & spark-adapters router/verifier/distill.
note Upstream source: spark-adapters/src/{models,router,verifier,distill,lib}.rs plus GB10/multi-vendor hardware table.
note Compose after si/directives/om2.om; no target line, no fn main.

const AD_OK int 0
const AD_ERR_NO_DEVICES int 1
const AD_ERR_BAD_REQ int 2
const AD_ERR_OFFLINE int 3
const AD_ERR_VRAM_EXCEEDED int 4
const AD_ERR_PRECISION int 5
const AD_ERR_CC_LOW int 6

const VENDOR_ANY ulong 0
const VENDOR_NVIDIA ulong 1
const VENDOR_AMD ulong 2
const VENDOR_APPLE ulong 3
const VENDOR_CPU ulong 4

const ARCH_GB10_SM121 ulong 121
const ARCH_H100_SM90 ulong 90
const ARCH_RTX4090_SM89 ulong 89
const ARCH_A100_SM80 ulong 80
const ARCH_MI300X_GFX942 ulong 942
const ARCH_M4_MAX ulong 400
const ARCH_ARM64_CPU ulong 1

const CAP_FP16 ulong 0x01
const CAP_BF16 ulong 0x02
const CAP_FP8 ulong 0x04
const CAP_INT8 ulong 0x08
const CAP_TF32 ulong 0x10
const CAP_NVFP4 ulong 0x20
const CAP_UNIFIED ulong 0x40
const CAP_ALL_MASK ulong 0x7f

const AD_GIB ulong 1073741824
const AD_MAX_DEV ulong 16

const PROV_OPENAI ulong 1
const PROV_ANTHROPIC ulong 2
const PROV_OPENROUTER ulong 3
const PROV_GEMINI ulong 4
const PROV_GROQ ulong 5
const PROV_OLLAMA ulong 6
const PROV_DEEPSEEK ulong 7
const PROV_TOGETHER ulong 8
const PROV_MISTRAL ulong 9
const PROV_LOCAL_MAX ulong 10

const VERIF_COMPILER ulong 1
const VERIF_JSON ulong 2
const VERIF_UNSLOP_STRICT ulong 3
const VERIF_DUAL_CONSENSUS ulong 4

const CHOSEN_TEACHER ulong 1
const CHOSEN_STUDENT ulong 2

struct WorkloadReq min_vram ulong req_flags ulong min_cc_maj ulong min_cc_min ulong pref_vendor ulong pref_unified bool end
struct AdapterSel ok bool err int dev_id ulong score ulong checked ulong eligible ulong end
struct RouteRes provider ulong ctx_len ulong requires_key bool is_resident bool matched_catalog bool cat_idx ulong end
struct VerifRes passed bool critical bool score f64 violations ulong delim_ok bool end
struct DistillDec chosen ulong pref_delta f64 commit_cortex bool end

global ad_obuf uchar 32768
global ad_olen ulong 1

global ad_dev_cnt ulong 1
global ad_dev_vendor ulong 16
global ad_dev_arch ulong 16
global ad_dev_vram ulong 16
global ad_dev_cc_maj ulong 16
global ad_dev_cc_min ulong 16
global ad_dev_flags ulong 16
global ad_dev_tflops ulong 16
global ad_dev_bw ulong 16
global ad_dev_online ulong 16

text ta_nl "\n"
text ta_sp " "
text ta_dot "."
text ta_minus "-"
text ta_v_nv "NVIDIA"
text ta_v_amd "AMD"
text ta_v_apl "APPLE"
text ta_v_cpu "CPU"
text ta_a_gb10 "Blackwell-GB10-SM121"
text ta_a_h100 "Hopper-H100-SM90"
text ta_a_a100 "Ampere-A100-SM80"
text ta_a_4090 "Ada-RTX4090-SM89"
text ta_a_mi300 "CDNA3-MI300X-GFX942"
text ta_a_m4 "Apple-M4-Max"
text ta_a_cpu "ARM64-CPU"
text ta_hdr "id vendor arch                 vram_gib cc   flags  tflops bw_gbps online\n"
text ta_sep "--------------------------------------------------------------------------\n"
text ta_sel_ok "SELECT ok=true dev_id="
text ta_sel_sc " score="
text ta_sel_el " eligible="
text ta_sel_ch "/"
text ta_sel_no "SELECT ok=false refusal_code="
text ta_f_fp16 "FP16"
text ta_f_bf16 "BF16"
text ta_f_fp8 "FP8"
text ta_f_int8 "INT8"
text ta_f_tf32 "TF32"
text ta_f_fp4 "NVFP4"
text ta_f_uni "UNIFIED"
text ta_comma ","
text ta_yes "true"
text ta_no "false"

note upstream router catalog identifiers and prefixes
text tr_cat0 "atlas-lightning-omni"
text tr_cat1 "openai/gpt-4o"
text tr_cat1m "gpt-4o"
text tr_cat2 "openai/o3-mini"

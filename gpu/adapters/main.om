note gpu/adapters/main.om: deterministic hardware adapter probe, workload select & provider route CLI.
note Compose: si/directives/om2.om gpu/adapters/lib.om gpu/adapters/main.om

text am_banner "=== SPARK-ADAPTERS: HARDWARE ACCELERATOR & PROVIDER ADAPTER LAYER ===\n"
text am_probe "\n[Device Capability Table]\n"
text am_sel "\n[Workload-to-Adapter Selection]\n"
text am_w1 "workload=nvfp4_unified_96g -> "
text am_w2 "workload=fp8_bf16_64g -> "
text am_w3 "workload=fp8_512g_impossible -> "
text am_w4 "workload=tf32_cc12_gb10 -> "

fn main to int
ad_ob_reset
ad_ob_str am_banner
ad_ob_str am_probe
ad_ob_flush

adapter_init_default_devices
adapter_print_probe

ad_ob_reset
ad_ob_str am_sel
ad_ob_flush

sel = new AdapterSel false 0 0 0 0 0

note 1. 96 GiB NVFP4 + unified memory workload -> selects NVIDIA GB10 SM121 (dev 0)
req1 = new WorkloadReq mul 96 AD_GIB or CAP_NVFP4 CAP_UNIFIED 12 0 VENDOR_ANY true
st1 = adapter_select view req1 edit sel
ad_ob_reset
ad_ob_str am_w1
ad_ob_flush
adapter_print_selection view sel

note 2. 64 GiB FP8 + BF16 workload -> selects highest-scoring eligible (AMD MI300X dev 4)
req2 = new WorkloadReq mul 64 AD_GIB or CAP_FP8 CAP_BF16 8 0 VENDOR_ANY false
st2 = adapter_select view req2 edit sel
ad_ob_reset
ad_ob_str am_w2
ad_ob_flush
adapter_print_selection view sel

note 3. 512 GiB FP8 workload -> strict refusal (VRAM exceeded)
req3 = new WorkloadReq mul 512 AD_GIB CAP_FP8 8 0 VENDOR_ANY false
st3 = adapter_select view req3 edit sel
ad_ob_reset
ad_ob_str am_w3
ad_ob_flush
adapter_print_selection view sel

note 4. 32 GiB TF32 + FP8 + SM 12.1 workload -> selects NVIDIA GB10 (dev 0)
req4 = new WorkloadReq mul 32 AD_GIB or CAP_TF32 CAP_FP8 12 1 VENDOR_NVIDIA false
st4 = adapter_select view req4 edit sel
ad_ob_reset
ad_ob_str am_w4
ad_ob_flush
adapter_print_selection view sel

if or ne st1 AD_OK or ne st2 AD_OK or ne st3 AD_ERR_VRAM_EXCEEDED ne st4 AD_OK
ret 1
end
ret 0
end

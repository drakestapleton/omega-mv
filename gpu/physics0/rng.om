note SPDX-License-Identifier: Apache-2.0
note gpu/physics0/rng.om: PD-0 deterministic SplitMix64 + FNV-1a64 + micro-unit arithmetic.
note Converted from src/physics0/pd0_rng.c (Vigna constants, matching turing_splitmix64).

fn pd0_fnv1a64 tag view uchar * to ulong
h = ulong 0xcbf29ce484222325
n = len tag
for i ulong n bound 256
h = xor h ulong get tag i
h = mul h ulong 0x100000001b3
end
ret h
end

fn pd0_splitmix64 r edit ulong 1 to ulong
s = add get r 0 ulong 0x9e3779b97f4a7c15
put r 0 s
z = mul xor s shr s 30 ulong 0xbf58476d1ce4e5b9
z = mul xor z shr z 27 ulong 0x94d049bb133111eb
ret xor z shr z 31
end

fn pd0_stream r edit ulong 1 seed ulong tag view uchar * to void
h = pd0_fnv1a64 tag
put r 0 xor seed h
ret
end

fn pd0_uniform r edit ulong 1 to long
v = pd0_splitmix64 r
ret long rem v ulong 1000001
end

fn pd0_const r edit ulong 1 lo long hi long to long
u = pd0_uniform r
span = sub hi lo
ret add lo div mul span u PD0_MICRO
end

fn pd0_noise r edit ulong 1 sigma_micro long to long
u1 = pd0_uniform r
u2 = pd0_uniform r
u3 = pd0_uniform r
u4 = pd0_uniform r
s = sub add add u1 u2 add u3 u4 long 2000000
ret div mul s sigma_micro PD0_IH_SD
end

fn pd0_abs_u64 x long to ulong
if lt x 0
ret ulong neg x
end
ret ulong x
end

fn pd0_mul a long b long to long
note Exact (a * b) / 1000000 truncating toward zero without i64 intermediate overflow.
neg_res = false
if lt a 0
neg_res = not neg_res
end
if lt b 0
neg_res = not neg_res
end
ua = pd0_abs_u64 a
ub = pd0_abs_u64 b
m = ulong 1000000
qa = div ua m
ra = rem ua m
qb = div ub m
rb = rem ub m
t0 = mul mul qa qb m
t1 = add mul qa rb mul qb ra
t2 = div mul ra rb m
res = add add t0 t1 t2
if neg_res
ret neg long res
end
ret long res
end

fn pd0_div a long b long to long
ret div a b
end

note SPDX-License-Identifier: Apache-2.0
note gpu/physics0/world.om: PD-0 deterministic measurement apparatus, hidden generators L0..L6/NULL,
note timing/ceiling/budget invariants, and SHA-256 sealed evidence chain.
note Converted from src/physics0/{pd0_gen.c,pd0_world.c}.

text PD0_TAG_CONST "const"
text PD0_TAG_NOISE "noise"
text PD0_TAG_NULL "null"

fn pd0_gen_reset_bound level int var int to long
b = long 2000000
if and eq level PD0_L0 eq var 1
b = long 200000
end
if eq level PD0_L4
b = long 1000000
end
ret b
end

fn pd0_gen_desc level int d edit Pd0Desc to int
if or lt level PD0_L0 gt level PD0_LEVEL_NULL
ret -1
end
nobs = uchar 2
nch = uchar 1
if eq level PD0_L3
nobs = uchar 4
nch = uchar 2
end
put d n_obs nobs
put d n_channels nch
put d episode_max_steps PD0_EPISODE_STEPS
put d budget_steps uint 3000
put d budget_episodes uint 300
put d dt_micro long 50000
put d chan_min 0 long -2000000
put d chan_max 0 long 2000000
put d chan_min 1 long 0
put d chan_max 1 long 0
if eq level PD0_L0
put d dt_micro long 1000000
put d chan_min 0 long -100000
put d chan_max 0 long 100000
put d episode_max_steps uint 20
put d budget_episodes uint 150
end
if eq level PD0_L3
put d chan_min 1 long -2000000
put d chan_max 1 long 2000000
end
if or eq level PD0_L5 eq level PD0_L6
put d budget_steps uint 8000
end
for v ulong 4
if lt v ulong nobs
b = pd0_gen_reset_bound level int v
put d reset_min v neg b
put d reset_max v b
else
put d reset_min v long 0
put d reset_max v long 0
end
end
ret 0
end

fn pd0_l6_unstable g view Pd0Gen to int
lhs = mul long 10 mul get g k 2 get g k 3
rhs = mul long 7 mul get g k 0 get g k 1
if gt lhs rhs
ret 1
end
ret 0
end

fn pd0_gen_init g edit Pd0Gen level int seed ulong to int
if or lt level PD0_L0 gt level PD0_LEVEL_NULL
ret -1
end
put g level level
put g sigma_obs long 0
put g sigma_null long 0
put g n_hidden 0
for i ulong 4
put g k i long 0
end
rng = new ulong 1 0
pd0_stream edit rng seed PD0_TAG_CONST
if eq level PD0_L1
put g k 0 pd0_const edit rng long 1000000 long 4000000
end
if or eq level PD0_L2 eq level PD0_L5
put g k 0 pd0_const edit rng long 1000000 long 9000000
put g k 1 pd0_const edit rng long 200000 long 2000000
end
if eq level PD0_L3
put g k 0 pd0_const edit rng long 1000000 long 4000000
put g k 1 pd0_const edit rng long 500000 long 2000000
end
if eq level PD0_L4
put g k 0 pd0_const edit rng long 1000000 long 4000000
put g k 1 pd0_const edit rng long 500000 long 2000000
end
if eq level PD0_L5
put g sigma_obs long 20000
end
if eq level PD0_L6
put g n_hidden 1
put g k 0 pd0_const edit rng long 3000000 long 5000000
put g k 1 pd0_const edit rng long 500000 long 1000000
put g k 2 pd0_const edit rng long 1000000 long 2000000
put g k 3 pd0_const edit rng long 1000000 long 2000000
redraws = int 0
while ne pd0_l6_unstable view g 0 bound 1001
if ge redraws 1000
ret -1
end
put g k 2 pd0_const edit rng long 1000000 long 2000000
put g k 3 pd0_const edit rng long 1000000 long 2000000
redraws = add redraws 1
end
end
if eq level PD0_LEVEL_NULL
put g sigma_null long 500000
end
ret 0
end

fn pd0_gen_observe g view Pd0Gen s view long 4 obs edit long 4 nrng edit ulong 1 to void
n = ulong 2
if eq get g level PD0_L3
n = ulong 4
end
sig = get g sigma_obs
for i ulong n bound 4
if ne sig long 0
put obs i add get s i pd0_noise nrng sig
else
put obs i get s i
end
end
ret
end

fn pd0_step_l3 g view Pd0Gen w view Pd0World u view long 2 dt long ns edit long 4 to void
diff = sub get w s 2 get w s 0
put ns 0 add get w s 0 pd0_mul get w s 1 dt
a1 = add neg pd0_mul get g k 0 get w s 0 pd0_mul get g k 1 diff
put ns 1 add get w s 1 pd0_mul add a1 get u 0 dt
put ns 2 add get w s 2 pd0_mul get w s 3 dt
a2 = sub neg pd0_mul get g k 0 get w s 2 pd0_mul get g k 1 diff
put ns 3 add get w s 3 pd0_mul add a2 get u 1 dt
ret
end

fn pd0_step_l6 g view Pd0Gen w view Pd0World u view long 2 dt long ns edit long 4 mutant int to long
hn = get w h
lat = pd0_mul get g k 2 hn
if ne mutant 0
lat = neg lat
end
put ns 0 add get w s 0 pd0_mul get w s 1 dt
a1 = add neg pd0_mul get g k 0 get w s 0 lat
put ns 1 add get w s 1 pd0_mul add a1 get u 0 dt
d1 = neg pd0_mul get g k 1 hn
d2 = pd0_mul get g k 3 get w s 0
ret add hn pd0_mul add d1 d2 dt
end

fn pd0_gen_step_dyn g view Pd0Gen w edit Pd0World u view long 2 dt long ns edit long 4 mutant int to int
nr = new ulong 1 0
lvl = get g level
hn = get w h
if eq lvl PD0_L0
put ns 0 add get w s 0 get w s 1
put ns 1 add get w s 1 get u 0
end
if eq lvl PD0_L1
sp = neg pd0_mul get g k 0 get w s 0
if ne mutant 0
sp = pd0_mul get g k 0 get w s 0
end
put ns 0 add get w s 0 pd0_mul get w s 1 dt
put ns 1 add get w s 1 pd0_mul add sp get u 0 dt
end
if or eq lvl PD0_L2 eq lvl PD0_L5
put ns 0 add get w s 0 pd0_mul get w s 1 dt
a1 = neg pd0_mul get g k 0 get w s 0
a2 = neg pd0_mul get g k 1 get w s 1
put ns 1 add get w s 1 pd0_mul add add a1 a2 get u 0 dt
end
if eq lvl PD0_L3
pd0_step_l3 g view w u dt ns
end
if eq lvl PD0_L4
s0 = get w s 0
cube = pd0_mul pd0_mul s0 s0 s0
put ns 0 add s0 pd0_mul get w s 1 dt
a1 = sub neg pd0_mul get g k 0 s0 pd0_mul get g k 1 cube
put ns 1 add get w s 1 pd0_mul add a1 get u 0 dt
end
if eq lvl PD0_L6
hn = pd0_step_l6 g view w u dt ns mutant
end
if eq lvl PD0_LEVEL_NULL
put nr 0 get w null_s
put ns 0 pd0_noise edit nr get g sigma_null
put ns 1 pd0_noise edit nr get g sigma_null
put w null_s get nr 0
end
n = ulong 2
if eq lvl PD0_L3
n = ulong 4
end
bad = int 0
if eq pd0_guard_in_box hn 0
bad = 1
end
for i ulong n bound 4
if eq pd0_guard_in_box get ns i 0
bad = 1
end
end
if eq bad 0
put w h hn
end
ret bad
end

fn pd0_world_init w edit Pd0World d edit Pd0Desc g edit Pd0Gen level int seed ulong to int
if ne pd0_gen_desc level d 0
ret -1
end
if ne pd0_gen_init g level seed 0
ret -1
end
put w level level
put w seed seed
rn = new ulong 1 0
pd0_stream edit rn seed PD0_TAG_NOISE
put w noise_s get rn 0
pd0_stream edit rn seed PD0_TAG_NULL
put w null_s get rn 0
for i ulong 4
put w s i long 0
end
put w h long 0
put w in_episode 0
put w step_in_episode uint 0
put w episodes_used uint 0
put w steps_used uint 0
put w episode uint 0
put w seq ulong 0
for i ulong 8
put w last_hash i uint 0
end
ret 0
end

fn pd0_world_begin_rec w view Pd0World d view Pd0Desc r edit Pd0Rec kind uchar ch uchar to void
put r n_obs get d n_obs
put r status PD0_OK
put r kind kind
put r channel ch
put r seq get w seq
put r episode get w episode
put r step_in_episode get w step_in_episode
put r time_micro mul long get w step_in_episode get d dt_micro
put r requested long 0
put r applied long 0
for i ulong 4
put r before i long 0
put r after i long 0
end
for i ulong 8
put r prev_hash i get w last_hash i
put r hash i uint 0
end
ret
end

fn pd0_world_seal w edit Pd0World r edit Pd0Rec to void
buf = new uchar 256 0
n = pd0_rec_encode r edit buf
if eq n ulong 0
trap 8
end
for i ulong 8
put w last_hash i get r hash i
end
put w seq add get w seq ulong 1
ret
end

fn pd0_world_budget_spent w view Pd0World d view Pd0Desc to int
if ge get w steps_used get d budget_steps
ret 1
end
if ge get w episodes_used get d budget_episodes
ret 1
end
ret 0
end

fn pd0_world_reset w edit Pd0World d view Pd0Desc g view Pd0Gen vals view long 4 n_vals uchar r edit Pd0Rec to void
pd0_world_begin_rec view w d r PD0_KIND_RESET PD0_CH_NONE
nobs = ulong get d n_obs
for i ulong nobs bound 4
put r before i get w s i
put r after i get w s i
end
if ne pd0_world_budget_spent view w d 0
put r status PD0_BUDGET_EXHAUSTED
pd0_world_seal w r
ret
end
put w episodes_used add get w episodes_used uint 1
if or ne get w in_episode 0 ne get w seq ulong 0
put w episode add get w episode uint 1
end
put r episode get w episode
if eq pd0_guard_reset_ok d vals n_vals 0
put r status PD0_REFUSED_RANGE
put w in_episode 0
pd0_world_seal w r
ret
end
for i ulong nobs bound 4
put w s i get vals i
end
put w h long 0
put w in_episode 1
put w step_in_episode uint 0
put r step_in_episode uint 0
put r time_micro long 0
s_loc = new long 4 0
obs = new long 4 0
nr = new ulong 1 0
put nr 0 get w noise_s
for i ulong nobs bound 4
put s_loc i get w s i
end
pd0_gen_observe g view s_loc edit obs edit nr
put w noise_s get nr 0
for i ulong nobs bound 4
put r before i get obs i
put r after i get obs i
end
put r status PD0_OK
pd0_world_seal w r
ret
end

fn pd0_world_obs_both w edit Pd0World g view Pd0Gen nobs ulong r edit Pd0Rec to void
s_loc = new long 4 0
obs = new long 4 0
nr = new ulong 1 0
put nr 0 get w noise_s
for i ulong nobs bound 4
put s_loc i get w s i
end
pd0_gen_observe g view s_loc edit obs edit nr
put w noise_s get nr 0
for i ulong nobs bound 4
put r before i get obs i
put r after i get obs i
end
ret
end

fn pd0_world_obs_after w edit Pd0World g view Pd0Gen nobs ulong r edit Pd0Rec to void
s_loc = new long 4 0
obs = new long 4 0
nr = new ulong 1 0
put nr 0 get w noise_s
for i ulong nobs bound 4
put s_loc i get w s i
end
pd0_gen_observe g view s_loc edit obs edit nr
put w noise_s get nr 0
for i ulong nobs bound 4
put r after i get obs i
end
ret
end

fn pd0_world_step w edit Pd0World d view Pd0Desc g view Pd0Gen ch uchar val long r edit Pd0Rec to void
pd0_world_begin_rec view w d r PD0_KIND_STEP ch
put r requested val
nobs = ulong get d n_obs
pd0_world_obs_both w g nobs r
if or ne pd0_world_budget_spent view w d 0 eq get w in_episode 0
put r status PD0_BUDGET_EXHAUSTED
pd0_world_seal w r
ret
end
put w steps_used add get w steps_used uint 1
if eq pd0_guard_step_ok d ch val 0
put r status PD0_REFUSED_RANGE
pd0_world_seal w r
ret
end
u = new long 2 0
if ne ch PD0_CH_NONE
put u ulong ch val
put r applied val
end
ns = new long 4 0
bad = pd0_gen_step_dyn g w view u get d dt_micro edit ns 0
put w step_in_episode add get w step_in_episode uint 1
if ne bad 0
put r status PD0_OUT_OF_BOUNDS
put w in_episode 0
pd0_world_seal w r
ret
end
for i ulong nobs bound 4
put w s i get ns i
end
pd0_world_obs_after w g nobs r
put r status PD0_OK
if ge get w step_in_episode get d episode_max_steps
put r status PD0_EPISODE_END
put w in_episode 0
end
pd0_world_seal w r
ret
end

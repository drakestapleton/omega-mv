note gpu/physics0/types.om: PD-0 core constants, structs, and FIPS 180-4 SHA-256 for sealed evidence framing.
note Converted from src/physics0/{pd0_wire.h,pd0_guard.h,pd0_rng.h,pd0_gen.h,pd0_world.h}.

const PD0_MAX_OBS ulong 4
const PD0_MAX_CH ulong 2
const PD0_HASH ulong 32
const PD0_CH_NONE uchar 255
const PD0_MICRO long 1000000
const PD0_IH_SD long 577350
const PD0_BOUND long 10000000
const PD0_EPISODE_STEPS uint 100

const PD0_OK uchar 0
const PD0_REFUSED_RANGE uchar 1
const PD0_OUT_OF_BOUNDS uchar 2
const PD0_EPISODE_END uchar 3
const PD0_BUDGET_EXHAUSTED uchar 4

const PD0_KIND_RESET uchar 0
const PD0_KIND_STEP uchar 1

const PD0_OP_DESCRIBE uchar 0
const PD0_OP_RESET uchar 1
const PD0_OP_STEP uchar 2

const PD0_DESC_REFUSED_V1 int -2

const PD0_L0 int 0
const PD0_L1 int 1
const PD0_L2 int 2
const PD0_L3 int 3
const PD0_L4 int 4
const PD0_L5 int 5
const PD0_L6 int 6
const PD0_LEVEL_NULL int 7

struct Pd0Desc n_obs uchar n_channels uchar dt_micro long chan_min long 2 chan_max long 2 reset_min long 4 reset_max long 4 episode_max_steps uint budget_steps uint budget_episodes uint end

struct Pd0Rec n_obs uchar status uchar kind uchar channel uchar seq ulong episode uint step_in_episode uint time_micro long requested long applied long before long 4 after long 4 prev_hash uint 8 hash uint 8 end

struct Pd0Gen level int k long 4 sigma_obs long sigma_null long n_hidden int end

struct Pd0World level int seed ulong noise_s ulong null_s ulong s long 4 h long in_episode int step_in_episode uint episodes_used uint steps_used uint episode uint seq ulong last_hash uint 8 end

note ---- FIPS 180-4 SHA-256 for PD0REC1 evidence sealing ----

fn pd0_sha_kinit k edit uint 64 to void
put k 0 0x428a2f98
put k 1 0x71374491
put k 2 0xb5c0fbcf
put k 3 0xe9b5dba5
put k 4 0x3956c25b
put k 5 0x59f111f1
put k 6 0x923f82a4
put k 7 0xab1c5ed5
put k 8 0xd807aa98
put k 9 0x12835b01
put k 10 0x243185be
put k 11 0x550c7dc3
put k 12 0x72be5d74
put k 13 0x80deb1fe
put k 14 0x9bdc06a7
put k 15 0xc19bf174
put k 16 0xe49b69c1
put k 17 0xefbe4786
put k 18 0x0fc19dc6
put k 19 0x240ca1cc
put k 20 0x2de92c6f
put k 21 0x4a7484aa
put k 22 0x5cb0a9dc
put k 23 0x76f988da
put k 24 0x983e5152
put k 25 0xa831c66d
put k 26 0xb00327c8
put k 27 0xbf597fc7
put k 28 0xc6e00bf3
put k 29 0xd5a79147
put k 30 0x06ca6351
put k 31 0x14292967
put k 32 0x27b70a85
put k 33 0x2e1b2138
put k 34 0x4d2c6dfc
put k 35 0x53380d13
put k 36 0x650a7354
put k 37 0x766a0abb
put k 38 0x81c2c92e
put k 39 0x92722c85
put k 40 0xa2bfe8a1
put k 41 0xa81a664b
put k 42 0xc24b8b70
put k 43 0xc76c51a3
put k 44 0xd192e819
put k 45 0xd6990624
put k 46 0xf40e3585
put k 47 0x106aa070
put k 48 0x19a4c116
put k 49 0x1e376c08
put k 50 0x2748774c
put k 51 0x34b0bcb5
put k 52 0x391c0cb3
put k 53 0x4ed8aa4a
put k 54 0x5b9cca4f
put k 55 0x682e6ff3
put k 56 0x748f82ee
put k 57 0x78a5636f
put k 58 0x84c87814
put k 59 0x8cc70208
put k 60 0x90befffa
put k 61 0xa4506ceb
put k 62 0xbef9a3f7
put k 63 0xc67178f2
ret
end

fn pd0_sha_ch x uint y uint z uint to uint
a = and x y
b = and not x z
ret xor a b
end

fn pd0_sha_maj x uint y uint z uint to uint
a = and x y
b = and x z
c = and y z
ret xor xor a b c
end

fn pd0_sha_bs0 x uint to uint
ret xor xor rotr x 2 rotr x 13 rotr x 22
end

fn pd0_sha_bs1 x uint to uint
ret xor xor rotr x 6 rotr x 11 rotr x 25
end

fn pd0_sha_ss0 x uint to uint
ret xor xor rotr x 7 rotr x 18 shr x 3
end

fn pd0_sha_ss1 x uint to uint
ret xor xor rotr x 17 rotr x 19 shr x 10
end

fn pd0_sha_be32 buf view uchar 64 off ulong to uint
b0 = shl uint get buf off 24
b1 = shl uint get buf add off 1 16
b2 = shl uint get buf add off 2 8
b3 = uint get buf add off 3
ret or or b0 b1 or b2 b3
end

fn pd0_sha_compress st edit uint 8 blk view uchar 64 k view uint 64 to void
w = new uint 64 0
v = new uint 8 0
for i ulong 16
put w i pd0_sha_be32 blk mul i 4
end
for i ulong 48
j = add i 16
s0 = pd0_sha_ss0 get w sub j 15
s1 = pd0_sha_ss1 get w sub j 2
val = add add get w sub j 16 s0 add get w sub j 7 s1
put w j val
end
for i ulong 8
put v i get st i
end
for r ulong 64
t1 = add get v 7 pd0_sha_bs1 get v 4
t1 = add t1 pd0_sha_ch get v 4 get v 5 get v 6
t1 = add t1 add get k r get w r
t2 = add pd0_sha_bs0 get v 0 pd0_sha_maj get v 0 get v 1 get v 2
put v 7 get v 6
put v 6 get v 5
put v 5 get v 4
put v 4 add get v 3 t1
put v 3 get v 2
put v 2 get v 1
put v 1 get v 0
put v 0 add t1 t2
end
for i ulong 8
put st i add get st i get v i
end
ret
end

fn pd0_sha_emit st view uint 8 dst edit uchar 32 to void
for i ulong 8
word = get st i
off = mul i 4
put dst off uchar and shr word 24 0xff
put dst add off 1 uchar and shr word 16 0xff
put dst add off 2 uchar and shr word 8 0xff
put dst add off 3 uchar and word 0xff
end
ret
end

fn pd0_sha256_hash msg view uchar * mlen ulong dst edit uchar 32 to void
st = new uint 8 0
k = new uint 64 0
blk = new uchar 64 0
pd0_sha_kinit edit k
put st 0 0x6a09e667
put st 1 0xbb67ae85
put st 2 0x3c6ef372
put st 3 0xa54ff53a
put st 4 0x510e527f
put st 5 0x9b05688c
put st 6 0x1f83d9ab
put st 7 0x5be0cd19
pos = ulong 0
while ge sub mlen pos 64 bound 1024
for i ulong 64
put blk i get msg add pos i
end
pd0_sha_compress edit st view blk view k
pos = add pos 64
end
rem_len = sub mlen pos
for i ulong 64
put blk i uchar 0
end
for i ulong rem_len bound 64
put blk i get msg add pos i
end
put blk rem_len uchar 0x80
if gt rem_len 55
pd0_sha_compress edit st view blk view k
for i ulong 64
put blk i uchar 0
end
end
bits = mul mlen 8
put blk 56 uchar and shr bits 56 0xff
put blk 57 uchar and shr bits 48 0xff
put blk 58 uchar and shr bits 40 0xff
put blk 59 uchar and shr bits 32 0xff
put blk 60 uchar and shr bits 24 0xff
put blk 61 uchar and shr bits 16 0xff
put blk 62 uchar and shr bits 8 0xff
put blk 63 uchar and bits 0xff
pd0_sha_compress edit st view blk view k
pd0_sha_emit view st dst
ret
end

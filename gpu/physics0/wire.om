note SPDX-License-Identifier: Apache-2.0
note gpu/physics0/wire.om: PD-0 wire framing (PD0DESC2, PD0REC1 with SHA-256 chain) and STAND_IN range guard.
note Converted from src/physics0/{pd0_wire.c,pd0_guard.c}.

text PD0_MAGIC_DESC2 "PD0DESC2"
text PD0_MAGIC_DESC1 "PD0DESC1"
text PD0_MAGIC_REC1 "PD0REC1"

fn pd0_put_u16 buf edit uchar * off ulong v ushort to void
put buf off uchar and v ushort 255
put buf add off 1 uchar and shr v 8 ushort 255
ret
end

fn pd0_put_u32 buf edit uchar * off ulong v uint to void
for i ulong 4
sh = mul uint i uint 8
put buf add off i uchar and shr v sh uint 255
end
ret
end

fn pd0_put_u64 buf edit uchar * off ulong v ulong to void
for i ulong 8
sh = mul i ulong 8
put buf add off i uchar and shr v sh ulong 255
end
ret
end

fn pd0_get_u16 buf view uchar * off ulong to ushort
b0 = ushort get buf off
b1 = shl ushort get buf add off 1 8
ret or b0 b1
end

fn pd0_get_u32 buf view uchar * off ulong to uint
v = uint 0
for i ulong 4
sh = mul uint i uint 8
b = shl uint get buf add off i sh
v = or v b
end
ret v
end

fn pd0_get_u64 buf view uchar * off ulong to ulong
v = ulong 0
for i ulong 8
sh = mul i ulong 8
b = shl ulong get buf add off i sh
v = or v b
end
ret v
end

fn pd0_eq_bytes a view uchar * aoff ulong b view uchar * n ulong to int
for i ulong n bound 64
if ne get a add aoff i get b i
ret 0
end
end
ret 1
end

fn pd0_rec_size n_obs uchar to ulong
ret add ulong 120 mul ulong 16 ulong n_obs
end

fn pd0_desc_size n_obs uchar n_ch uchar to ulong
ret add add ulong 30 mul ulong 16 ulong n_ch mul ulong 16 ulong n_obs
end

note ---- STAND_IN range guard (pd0_guard.c) ----

fn pd0_guard_step_ok d view Pd0Desc channel uchar val long to int
if eq channel PD0_CH_NONE
ret 1
end
if ge channel get d n_channels
ret 0
end
idx = ulong channel
if lt val get d chan_min idx
ret 0
end
if gt val get d chan_max idx
ret 0
end
ret 1
end

fn pd0_guard_reset_ok d view Pd0Desc vals view long 4 n_vals uchar to int
if ne n_vals get d n_obs
ret 0
end
n = ulong n_vals
for i ulong n bound 4
v = get vals i
if lt v get d reset_min i
ret 0
end
if gt v get d reset_max i
ret 0
end
end
ret 1
end

fn pd0_guard_in_box v long to int
if gt v PD0_BOUND
ret 0
end
if lt v neg PD0_BOUND
ret 0
end
ret 1
end

note ---- PD0DESC2 wire codec ----

fn pd0_desc_encode d view Pd0Desc dst edit uchar * to ulong
nobs = get d n_obs
nch = get d n_channels
if or lt nobs uchar 1 gt nobs uchar 4
ret ulong 0
end
if or lt nch uchar 1 gt nch uchar 2
ret ulong 0
end
need = pd0_desc_size nobs nch
if lt len dst need
ret ulong 0
end
for i ulong 8
put dst i get PD0_MAGIC_DESC2 i
end
put dst 8 nobs
put dst 9 nch
pos = ulong 10
pd0_put_u64 dst pos bitcast ulong get d dt_micro
pos = add pos 8
for i ulong ulong nch bound 2
pd0_put_u64 dst pos bitcast ulong get d chan_min i
pos = add pos 8
end
for i ulong ulong nch bound 2
pd0_put_u64 dst pos bitcast ulong get d chan_max i
pos = add pos 8
end
for i ulong ulong nobs bound 4
pd0_put_u64 dst pos bitcast ulong get d reset_min i
pos = add pos 8
end
for i ulong ulong nobs bound 4
pd0_put_u64 dst pos bitcast ulong get d reset_max i
pos = add pos 8
end
pd0_put_u32 dst pos get d episode_max_steps
pos = add pos 4
pd0_put_u32 dst pos get d budget_steps
pos = add pos 4
pd0_put_u32 dst pos get d budget_episodes
pos = add pos 4
ret pos
end

fn pd0_desc_decode src view uchar * d edit Pd0Desc to int
slen = len src
if ge slen ulong 8
if eq pd0_eq_bytes src ulong 0 PD0_MAGIC_DESC1 ulong 8 1
ret PD0_DESC_REFUSED_V1
end
end
if lt slen ulong 10
ret -1
end
if ne pd0_eq_bytes src ulong 0 PD0_MAGIC_DESC2 ulong 8 1
ret -1
end
nobs = get src 8
nch = get src 9
if or lt nobs uchar 1 gt nobs uchar 4
ret -1
end
if or lt nch uchar 1 gt nch uchar 2
ret -1
end
if ne slen pd0_desc_size nobs nch
ret -1
end
put d n_obs nobs
put d n_channels nch
pos = ulong 10
put d dt_micro bitcast long pd0_get_u64 src pos
pos = add pos 8
for i ulong 2
put d chan_min i long 0
put d chan_max i long 0
end
for i ulong 4
put d reset_min i long 0
put d reset_max i long 0
end
for i ulong ulong nch bound 2
put d chan_min i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for i ulong ulong nch bound 2
put d chan_max i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for i ulong ulong nobs bound 4
put d reset_min i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for i ulong ulong nobs bound 4
put d reset_max i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
put d episode_max_steps pd0_get_u32 src pos
pos = add pos 4
put d budget_steps pd0_get_u32 src pos
pos = add pos 4
put d budget_episodes pd0_get_u32 src pos
ret 0
end

note ---- PD0REC1 sealed evidence record codec ----

fn pd0_rec_body r view Pd0Rec dst edit uchar * to ulong
for i ulong 7
put dst i get PD0_MAGIC_REC1 i
end
put dst 7 uchar 0
pd0_put_u16 dst ulong 8 ushort 1
nobs = get r n_obs
put dst 10 nobs
put dst 11 get r status
put dst 12 get r kind
put dst 13 get r channel
put dst 14 uchar 0
put dst 15 uchar 0
pd0_put_u64 dst ulong 16 get r seq
pd0_put_u32 dst ulong 24 get r episode
pd0_put_u32 dst ulong 28 get r step_in_episode
pd0_put_u64 dst ulong 32 bitcast ulong get r time_micro
pd0_put_u64 dst ulong 40 bitcast ulong get r requested
pd0_put_u64 dst ulong 48 bitcast ulong get r applied
pos = ulong 56
for i ulong ulong nobs bound 4
pd0_put_u64 dst pos bitcast ulong get r before i
pos = add pos 8
end
for i ulong ulong nobs bound 4
pd0_put_u64 dst pos bitcast ulong get r after i
pos = add pos 8
end
for i ulong 8
w = get r prev_hash i
put dst pos uchar and shr w 24 uint 255
put dst add pos 1 uchar and shr w 16 uint 255
put dst add pos 2 uchar and shr w 8 uint 255
put dst add pos 3 uchar and w uint 255
pos = add pos 4
end
ret pos
end

fn pd0_get_be32 buf view uchar * off ulong to uint
b0 = shl uint get buf off 24
b1 = shl uint get buf add off 1 16
b2 = shl uint get buf add off 2 8
b3 = uint get buf add off 3
ret or or b0 b1 or b2 b3
end

fn pd0_rec_encode r edit Pd0Rec dst edit uchar * to ulong
nobs = get r n_obs
if or lt nobs uchar 1 gt nobs uchar 4
ret ulong 0
end
need = pd0_rec_size nobs
if lt len dst need
ret ulong 0
end
body_n = pd0_rec_body view r dst
h = new uchar 32 0
pd0_sha256_hash view dst body_n edit h
for i ulong 8
put r hash i pd0_get_be32 view h mul i 4
end
for i ulong 32
put dst add body_n i get h i
end
ret add body_n ulong 32
end

fn pd0_rec_decode src view uchar * r edit Pd0Rec to int
slen = len src
if lt slen ulong 12
ret -1
end
if ne pd0_eq_bytes src ulong 0 PD0_MAGIC_REC1 ulong 7 1
ret -1
end
if ne get src 7 uchar 0
ret -1
end
if ne pd0_get_u16 src ulong 8 ushort 1
ret -1
end
nobs = get src 10
if or lt nobs uchar 1 gt nobs uchar 4
ret -1
end
if ne slen pd0_rec_size nobs
ret -1
end
if or ne get src 14 uchar 0 ne get src 15 uchar 0
ret -1
end
body_n = sub slen ulong 32
h = new uchar 32 0
pd0_sha256_hash src body_n edit h
for i ulong 32
if ne get h i get src add body_n i
ret -1
end
end
put r n_obs nobs
put r status get src 11
put r kind get src 12
put r channel get src 13
put r seq pd0_get_u64 src ulong 16
put r episode pd0_get_u32 src ulong 24
put r step_in_episode pd0_get_u32 src ulong 28
put r time_micro bitcast long pd0_get_u64 src ulong 32
put r requested bitcast long pd0_get_u64 src ulong 40
put r applied bitcast long pd0_get_u64 src ulong 48
pos = ulong 56
for i ulong 4
put r before i long 0
put r after i long 0
end
for i ulong ulong nobs bound 4
put r before i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for i ulong ulong nobs bound 4
put r after i bitcast long pd0_get_u64 src pos
pos = add pos 8
end
for i ulong 8
put r prev_hash i pd0_get_be32 src pos
pos = add pos 4
end
for i ulong 8
put r hash i pd0_get_be32 view h mul i 4
end
ret 0
end

fn pd0_rec_chained r view Pd0Rec has_prev int prev view Pd0Rec to int
if eq has_prev 0
if ne get r seq ulong 0
ret 0
end
for i ulong 8
if ne get r prev_hash i uint 0
ret 0
end
end
ret 1
end
if ne get r seq add get prev seq ulong 1
ret 0
end
for i ulong 8
if ne get r prev_hash i get prev hash i
ret 0
end
end
ret 1
end

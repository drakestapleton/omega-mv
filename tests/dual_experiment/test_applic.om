note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note DUAL applicability experiment tests (pure seeded OM-2, composed after
note src/dual_experiment/applic.om). Exact port of test_applic.c: 13,020 checks
note covering ledger conservation at every step, determinism, pinned parameter
note digest, predictor finiteness/bounds, and negative controls.

global ta_stats ulong 2
global ta_out uchar 256

text ta_t_pin "e489d25f5f0d23cfe8624a5cc82a5f770f04cb03fd3b441aac627e1a0087ecea"
text ta_t_fail "FAIL test_applic check "
text ta_t_nl "\n"
text ta_t_rdig "results digest: "
text ta_t_pdig "params digest:  "
text ta_t_shuf1 "shuffled worse than real in "
text ta_t_shuf2 " / 192 runs\n"
text ta_t_sum1 "test_applic: "
text ta_t_sum2 " checks, "
text ta_t_sum3 " failures\n"

fn ta_write_all fd int n ulong to void
  off = ulong 0
  while lt off n bound 64
    k = write fd ta_out off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
end

fn ta_check cond bool id ulong to void
  buf = new uchar 128 0
  put ta_stats 0 add get ta_stats 0 1
  if not cond
    put ta_stats 1 add get ta_stats 1 1
    p = ulong 0
    p = ap_buf_copy buf p ta_t_fail
    p = ap_buf_u64 buf p id
    p = ap_buf_byte buf p uchar 10
    for i ulong p bound 128
      put ta_out i get buf i
    end
    ta_write_all int 2 p
  end
end

fn ta_eq_bytes a view uchar 64 b view uchar * to bool
  if ne len b 64
    ret false
  end
  for i ulong 64
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn ta_eq_bytes64 a view uchar 64 b view uchar 64 to bool
  for i ulong 64
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn ta_windows_eq to bool
  for i ulong 800
    if ne get ap_win_u i get ap_win_u add 800 i
      ret false
    end
  end
  for i ulong 600
    a = bitcast ulong get ap_win_f i
    b = bitcast ulong get ap_win_f add 600 i
    if ne a b
      ret false
    end
  end
  ret true
end

fn ta_items_eq n ulong to bool
  for i ulong n bound 65536
    j = add AP_MAX_ITEMS i
    if ne get ap_it_arr i get ap_it_arr j
      ret false
    end
    if ne get ap_it_dem i get ap_it_dem j
      ret false
    end
    if ne get ap_it_rem i get ap_it_rem j
      ret false
    end
    if ne get ap_it_mem i get ap_it_mem j
      ret false
    end
    if ne get ap_it_slt i get ap_it_slt j
      ret false
    end
    if ne get ap_it_cls i get ap_it_cls j
      ret false
    end
  end
  ret true
end

fn ta_test_ledger_one wl ulong si ulong to void
  ap_sim_init_indexed 0 wl ap_seed wl si si
  for t ulong AP_STEPS bound 2048
    r = ap_sim_step 0
    if or ne r 0 not ap_sim_ledger_ok 0
      ta_check false 100
      break
    end
  end
  ta_check eq get ap_sim_u 14 AP_STEPS 101
  ta_check eq get ap_sim_u 11 AP_WINDOWS 102
  ta_check eq get ap_sim_u 9 0 103
  ta_check and gt get ap_sim_u 6 0 gt get ap_sim_u 7 0 104
  a = ulong 0
  c = ulong 0
  rj = ulong 0
  nw = get ap_sim_u 11
  for w ulong nw bound 128
    wub = mul w 8
    a = add a get ap_win_u wub
    c = add c get ap_win_u add wub 1
    rj = add rj get ap_win_u add wub 3
  end
  ta_check eq a get ap_sim_u 6 105
  ta_check eq c get ap_sim_u 7 106
  ta_check eq rj get ap_sim_u 8 107
  lim = add 1.0f64 1.0e-12f64
  for w ulong nw bound 128
    wfb = mul w 6
    wub = mul w 8
    ta_check le get ap_win_f wfb lim 108
    ta_check le get ap_win_f add wfb 1 lim 109
    ta_check le get ap_win_f add wfb 2 lim 110
    ta_check le get ap_win_u add wub 2 AP_WINDOW 111
  end
end

fn ta_test_ledger_every_step to void
  for wl ulong AP_WL_COUNT
    for si ulong 3
      ta_test_ledger_one wl si
    end
  end
  ap_sim_init 0 5 ap_seed 5 0
  r1 = ap_sim_run 0
  ta_check eq get ap_win_u 7 AP_SLOTS 120
  ta_check eq get ap_win_u 799 AP_CAP_DROP_SLOTS 121
  ap_sim_init 0 2 ap_seed 2 0
  r2 = ap_sim_run 0
  ta_check gt get ap_sim_u 8 0 122
  for si ulong AP_SEEDS
    ap_sim_init_indexed 0 7 ap_seed 7 si si
    ta_check and gt get ap_sim_f 4 0.0f64 eq get ap_sim_f 3 ap_sweep_sigma si 123
    rc = ap_sim_run 0
    ta_check and eq rc 0 eq get ap_sim_u 9 0 124
  end
  ta_check and eq ap_sweep_sigma 0 0.0f64 eq ap_sweep_sigma 23 1.5f64 125
  put ap_sim_u 7 add get ap_sim_u 7 1
  ta_check not ap_sim_ledger_ok 0 126
  put ap_sim_u 7 sub get ap_sim_u 7 1
  ta_check ap_sim_ledger_ok 0 127
end

fn ta_print_digest label view uchar * hx view uchar 64 to void
  buf = new uchar 128 0
  p = ulong 0
  p = ap_buf_copy buf p label
  for i ulong 64
    put buf add p i get hx i
  end
  p = add p 64
  p = ap_buf_byte buf p uchar 10
  for i ulong p bound 128
    put ta_out i get buf i
  end
  ta_write_all int 1 p
end

fn ta_test_determinism to void
  ap_sim_init 0 1 12345
  r1 = ap_sim_run 0
  ap_sim_init 1 1 12345
  r2 = ap_sim_run 1
  ta_check ta_windows_eq 201
  ni0 = get ap_sim_u 0
  ni1 = get ap_sim_u 20
  ta_check and eq ni0 ni1 ta_items_eq ni0 202
  ap_sim_init 1 1 12346
  r3 = ap_sim_run 1
  ta_check not ta_windows_eq 203
  ta_check eq ap_campaign 0 0 0 204
  ta_check eq ap_campaign 1 1 0 205
  ta_check eq AP_NROWS 192 206
  da = new uchar 32 0
  db = new uchar 32 0
  ha = new uchar 64 0
  hb = new uchar 64 0
  ap_rows_digest 0 AP_NROWS da
  ap_rows_digest 1 AP_NROWS db
  p1 = ap_buf_hex32 ha 0 da
  p2 = ap_buf_hex32 hb 0 db
  ta_check ta_eq_bytes64 ha hb 207
  ta_print_digest ta_t_rdig ha
  pd = new uchar 32 0
  ph = new uchar 64 0
  ap_params_digest pd
  p3 = ap_buf_hex32 ph 0 pd
  ta_print_digest ta_t_pdig ph
  ta_check ta_eq_bytes ph ta_t_pin 208
end

fn ta_test_predictor_finite to void
  for wl ulong AP_WL_COUNT
    ap_sim_init 0 wl ap_seed wl 7
    r = ap_sim_run 0
    nw = get ap_sim_u 11
    for w ulong nw bound 128
      ap_predict_win_default 0 w
      pc = get ap_pred_f 0
      pq = get ap_pred_f 1
      pb = get ap_pred_f 2
      ta_check and ap_isfinite pc ge pc 0.0f64 301
      ta_check and ap_isfinite pq and ge pq 0.0f64 le pq 1.0f64 302
      ta_check and ap_isfinite pb and ge pb 0.0f64 le pb 1.0f64 303
    end
    ap_error_real 0
    ec = get ap_err_f 3
    ew = get ap_err_w 0
    ap_error_shuffled 0 3
    sc = get ap_err_f 3
    ap_error_known_arrivals 0
    kc = get ap_err_f 3
    ok_e = and and ap_isfinite ec ge ec 0.0f64 and ap_isfinite sc and ap_isfinite kc ge kc 0.0f64
    ta_check ok_e 304
    ta_check eq ew 94 305
  end
  for i ulong 8
    put ap_win_u i 0
  end
  for i ulong 6
    put ap_win_f i 0.0f64
  end
  put ap_win_u 7 AP_SLOTS
  ap_predict_win_default 0 0
  ta_check and eq get ap_pred_f 0 0.0f64 and eq get ap_pred_f 1 0.0f64 eq get ap_pred_f 2 0.0f64 306
end

fn ta_test_neg_extra to void
  eps = 1.0e-12f64
  cv_a = 0.0f64
  cv_b = 0.0f64
  top_a = 0.0f64
  top_b = 0.0f64
  for i ulong AP_NROWS
    wl = get ap_row_u mul i 7
    rfb = mul i 19
    if eq wl 0
      cv_a = add cv_a get ap_row_f add rfb 12
      top_a = add top_a get ap_row_f add rfb 13
    end
    if eq wl 1
      cv_b = add cv_b get ap_row_f add rfb 12
      top_b = add top_b get ap_row_f add rfb 13
    end
  end
  ta_check and gt cv_b cv_a gt top_b top_a 407
  va = new f64 4 0.0f64
  vb = new f64 4 0.0f64
  vc = new f64 4 0.0f64
  put va 0 1.0f64
  put va 1 2.0f64
  put va 2 3.0f64
  put va 3 4.0f64
  put vb 0 2.0f64
  put vb 1 4.0f64
  put vb 2 6.0f64
  put vb 3 8.0f64
  put vc 0 4.0f64
  put vc 1 3.0f64
  put vc 2 2.0f64
  put vc 3 1.0f64
  ta_check lt fabs sub ap_pearson va vb 4 1.0f64 eps 408
  ta_check lt fabs add ap_pearson va vc 4 1.0f64 eps 409
end

fn ta_test_negative_controls to void
  x = new f64 192 0.0f64
  y = new f64 192 0.0f64
  worse = ulong 0
  eps = 1.0e-12f64
  for i ulong AP_NROWS
    rfb = mul i 19
    rc = get ap_row_f add rfb 3
    if gt get ap_row_f add rfb 11 rc
      worse = add worse 1
    end
    put x i get ap_row_f add rfb 17
    put y i rc
    cv = get ap_row_f add rfb 12
    top = get ap_row_f add rfb 13
    mx = get ap_row_f add rfb 14
    ent = get ap_row_f add rfb 15
    ta_check and ap_isfinite cv ge cv 0.0f64 401
    ta_check and ge top 0.0f64 le top 1.0f64 402
    ta_check and ge mx 0.0f64 le mx add top eps 403
    ta_check and ge ent 0.0f64 le ent add 1.0f64 eps 404
  end
  buf = new uchar 128 0
  p = ulong 0
  p = ap_buf_copy buf p ta_t_shuf1
  p = ap_buf_u64 buf p worse
  p = ap_buf_copy buf p ta_t_shuf2
  for i ulong p bound 128
    put ta_out i get buf i
  end
  ta_write_all int 1 p
  ta_check gt mul worse 2 AP_NROWS 405
  pr = ap_pearson x y AP_NROWS
  cov = get ap_pearson_f 1
  ta_check and eq cov 0.0f64 eq pr 0.0f64 406
  ta_test_neg_extra
end

fn main to int
  ta_test_ledger_every_step
  ta_test_determinism
  ta_test_predictor_finite
  ta_test_negative_controls
  buf = new uchar 128 0
  p = ulong 0
  p = ap_buf_copy buf p ta_t_sum1
  p = ap_buf_u64 buf p get ta_stats 0
  p = ap_buf_copy buf p ta_t_sum2
  p = ap_buf_u64 buf p get ta_stats 1
  p = ap_buf_copy buf p ta_t_sum3
  for i ulong p bound 128
    put ta_out i get buf i
  end
  ta_write_all int 1 p
  if ne get ta_stats 1 0
    ret int 1
  end
  ret int 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_program.om against C oracle.
om2

text g_p1_id "e5451246e475f213e60ec9bc61225cab72511a771214c465239384a25daef5bd"
text g_p1_rid "84d49636432ea6a8fd29c9ebaae0497bd43027e950fc11af9f80a597cc688146"
text g_p1_code "410080d2007c019bc0035fd6"
text g_p1_con "5bc8d4a1674547d07a3b098d6de324cfafa0d428a495ae65bce8430be75b6d9f"
text g_pc_id "7004502c62e5c2e0041c225869eb90d45ef5a54e8f1f35dad580773055c5739d"
text g_pc_rid "f9ebc89aa3a198cb8c7e1236a803a9a213b5477ee9d2c6696af68e2a80a56b31"
text g_pc_code "410080d2007c019b210080d20000018bc0035fd6"
text g_pc_root "7e00fed42d27c33f0bbcd954d4b1c11ed77f0200aec18ddb4fe55dbb78f69a56"

text n_mul2 "mul_2"
text n_add1 "add_1"
text n_task "task_2x_plus_1"
text msg_pass "OMEGA_PROGRAM_OM_PASS\n"
text msg_fail "OMEGA_PROGRAM_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex buf view uchar * n ulong gold view uchar * to void
  for i ulong n bound 64
    b = uint get buf i
    chk eq sh_hexd shr b 4 get gold mul i 2
    chk eq sh_hexd and b 15 get gold add mul i 2 1
  end
end

fn main to int
  chk eq omega_program_build_unary_op 0 n_mul2 len n_mul2 PROG_OP_MUL 2 0
  chk eq omega_program_build_unary_op 1 n_add1 len n_add1 PROG_OP_ADD 1 0
  chk eq omega_program_validate_contract 0 0
  chk eq omega_program_compose 0 1 2 0

  id = new uchar 32 0
  for i ulong 32
    put id i get g_prog_id i
  end
  chk_hex id 32 g_p1_id

  for i ulong 32
    put id i get g_prog_r_id i
  end
  chk_hex id 32 g_p1_rid

  code = new uchar 64 0
  chk eq get g_prog_r_len 0 12
  for i ulong 12
    put code i get g_prog_r_code i
  end
  chk_hex code 12 g_p1_code

  cid = new uchar 32 0
  chk eq omega_program_contract_id 0 cid 0
  chk_hex cid 32 g_p1_con

  for i ulong 32
    put id i get g_prog_id add 64 i
  end
  chk_hex id 32 g_pc_id

  for i ulong 32
    put id i get g_prog_r_id add 64 i
  end
  chk_hex id 32 g_pc_rid

  chk eq get g_prog_r_len 2 20
  cb2 = mul 2 PROG_MAX_CODE
  for i ulong 20
    put code i get g_prog_r_code add cb2 i
  end
  chk_hex code 20 g_pc_code

  root = new uchar 32 0
  chk eq omega_program_body_root_id 2 root 0
  chk_hex root 32 g_pc_root

  note Lift body back and check exact steps
  chk eq omega_program_lift_body code 20 3 0
  chk eq get g_prog_scnt 3 2
  sb3 = ulong 192
  chk eq ulong get g_prog_sop sb3 PROG_OP_MUL
  chk eq get g_prog_simm sb3 2
  chk eq ulong get g_prog_sop add sb3 1 PROG_OP_ADD
  chk eq get g_prog_simm add sb3 1 1

  note Eval vs Exec parity
  xs = new ulong 16 0
  ys = new ulong 16 0
  put xs 0 0
  put xs 1 1
  put xs 2 7
  put xs 3 100
  chk eq omega_program_eval 2 xs 4 ys 0
  ov = new ulong 1 0
  for i ulong 4
    chk eq omega_program_exec 2 get xs i ov 0
    chk eq get ov 0 get ys i
  end
  chk eq get ys 0 1
  chk eq get ys 3 201

  note Verify & Task eval
  chk eq omega_program_verify 2 0
  chk eq get g_prog_is_ver 2 1
  omega_task_set_contract CORE_TYPE_UINT 64 CORE_TYPE_UINT 64
  chk eq omega_task_init n_task xs ys 4 0
  sol = new ulong 1 0
  chk eq omega_task_evaluate_candidate 2 sol 0
  chk eq get sol 0 1
  chk eq omega_task_evaluate_candidate 0 sol 0
  chk eq get sol 0 0

  omega_program_destroy 0
  omega_program_destroy 1
  omega_program_destroy 2
  omega_program_destroy 3

  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

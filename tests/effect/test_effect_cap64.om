note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/effect/test_effect_cap64.c.
note Composes seed/ng/sha256.om, om/visor/canonical_om2.om, src/omega_canonical.om,
note src/omega_core.om, om/visor/codec_om2.om, src/omega_codec.om, src/omega_validate.om,
note seed/authority/cap_table_om2.om, src/runtime/rx_caproot.om.
note Four gates:
note   OMEGA_EFFECT_CAP64_ROUNDTRIP_PASS
note   OMEGA_EFFECT_CAP64_IDENTITY_PASS
note   OMEGA_EFFECT_CAP64_STALE_REJECT_PASS
note   OMEGA_EFFECT_CAP64_AUTHORITY_PASS
om2

text ec_g1 "GATE OMEGA_EFFECT_CAP64_ROUNDTRIP_PASS PASS\n"
text ec_g2 "GATE OMEGA_EFFECT_CAP64_IDENTITY_PASS PASS\n"
text ec_g3 "GATE OMEGA_EFFECT_CAP64_STALE_REJECT_PASS PASS\n"
text ec_g4 "GATE OMEGA_EFFECT_CAP64_AUTHORITY_PASS PASS\n"
text ec_fail "EFFECT_CAP64: FAIL\n"
text ec_param "cap64-params"

global g_ec_fail ulong 4

fn ec_chk gate ulong cond bool to void
  if not cond
    put g_ec_fail gate add get g_ec_fail gate 1
  end
end

fn ec_ids_eq a view uchar 32 b view uchar 32 to bool
  for i ulong 32
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn ec_rt_ser_deser to void
  bin = new uchar 1024 0
  blen = new ulong 1 0
  ec_chk 0 eq omega_graph_serialize_binary bin 1024 blen 0
  ec_chk 0 gt get blen 0 0
  ec_chk 0 eq omega_graph_deserialize_binary bin get blen 0 0
  ec_chk 0 eq get g_core_obj_cnt 0 1
end

fn ec_roundtrip_one gen ulong to void
  ign = omega_graph_create
  idx = omega_build_effect 3 7 11 gen
  ec_chk 0 ge idx 0
  ui = ulong idx

  meta = new ulong 5 0
  cref = new uchar 32 0
  pb = new uchar 128 0
  ec_chk 0 eq omega_effect_read ui meta cref pb 0
  ec_chk 0 eq get meta 0 3
  ec_chk 0 eq get meta 1 7
  ec_chk 0 eq get meta 2 11
  ec_chk 0 eq get meta 3 gen

  note Attach param bytes and recompute semantic id
  pl = len ec_param
  put meta 4 pl
  for i ulong pl bound 128
    put pb i get ec_param i
  end
  ec_chk 0 eq omega_effect_write ui meta cref pb 0
  ec_chk 0 eq core_compute_id ui 0
  ec_chk 0 eq omega_validate_object true ui 0

  id_before = new uchar 32 0
  core_get_id ui id_before

  note OMGG binary serialize + deserialize preserves all 64 generation bits
  ec_rt_ser_deser

  ec_chk 0 eq omega_effect_read 0 meta cref pb 0
  ec_chk 0 eq get meta 0 3
  ec_chk 0 eq get meta 1 7
  ec_chk 0 eq get meta 2 11
  ec_chk 0 eq get meta 3 gen
  ec_chk 0 eq get meta 4 pl
  for i ulong pl bound 128
    ec_chk 0 eq get pb i get ec_param i
  end
  id_after = new uchar 32 0
  core_get_id 0 id_after
  ec_chk 0 ec_ids_eq id_before id_after
  ec_chk 0 eq omega_validate_object true 0 0
end

fn ec_gate1_roundtrip to void
  ec_roundtrip_one 1
  ec_roundtrip_one ulong 0xffffffff
  ec_roundtrip_one ulong 0x0000000100000000
  ec_roundtrip_one ulong 0x0102030405060708
  ec_roundtrip_one ulong 0xffffffffffffffff
end

fn ec_gate2_identity to void
  ign = omega_graph_create
  i1 = omega_build_effect 2 3 5 1
  i2 = omega_build_effect 2 3 5 ulong 0x0000000100000001
  i3 = omega_build_effect 2 3 5 ulong 0x8000000000000001
  i4 = omega_build_effect 2 3 5 1
  ec_chk 1 ge i1 0
  ec_chk 1 ge i2 0
  ec_chk 1 ge i3 0
  ec_chk 1 ge i4 0

  id1 = new uchar 32 0
  id2 = new uchar 32 0
  id3 = new uchar 32 0
  id4 = new uchar 32 0
  core_get_id ulong i1 id1
  core_get_id ulong i2 id2
  core_get_id ulong i3 id3
  core_get_id ulong i4 id4

  note Bit 32 and bit 63 differences produce distinct SemanticIds
  ec_chk 1 not ec_ids_eq id1 id2
  ec_chk 1 not ec_ids_eq id1 id3
  ec_chk 1 not ec_ids_eq id2 id3
  ec_chk 1 ec_ids_eq id1 id4
end

fn ec_gate3_stale_reject to void
  meta = new ulong 5 0
  cref = new uchar 32 0
  pb = new uchar 128 0
  raw = new uchar 178 0

  note Valid v2 baseline
  put meta 0 2
  put meta 1 3
  put meta 2 1
  put meta 3 ulong 0x0000000100000009
  put meta 4 4
  put pb 0 uchar 65
  put pb 1 uchar 66
  put pb 2 uchar 67
  put pb 3 uchar 68
  ec_chk 2 eq omega_effect_payload_encode meta cref pb raw 0
  ec_chk 2 eq omega_effect_payload_decode raw 178 meta cref pb 0

  note Truncated / legacy v1 lengths refused
  ec_chk 2 ne omega_effect_payload_decode raw 0 meta cref pb 0
  ec_chk 2 ne omega_effect_payload_decode raw 40 meta cref pb 0
  ec_chk 2 ne omega_effect_payload_decode raw 177 meta cref pb 0

  note Non-zero trailing padding byte refused
  put raw 177 uchar 1
  ec_chk 2 ne omega_effect_payload_decode raw 178 meta cref pb 0
  put raw 177 uchar 0

  note Zero resource_class refused
  put raw 0 uchar 0
  put raw 1 uchar 0
  ec_chk 2 ne omega_effect_payload_decode raw 178 meta cref pb 0
  put raw 1 uchar 2

  note param_len > 128 refused
  put raw 48 uchar 0
  put raw 49 uchar 129
  ec_chk 2 ne omega_effect_payload_decode raw 178 meta cref pb 0
end

fn ec_carry_omgg slot ulong gen ulong out_meta edit ulong 5 to void
  ign = omega_graph_create
  eidx = omega_build_effect 5 3 slot gen
  ec_chk 3 ge eidx 0
  bin = new uchar 1024 0
  blen = new ulong 1 0
  ec_chk 3 eq omega_graph_serialize_binary bin 1024 blen 0
  ec_chk 3 eq omega_graph_deserialize_binary bin get blen 0 0
  cref = new uchar 32 0
  pb = new uchar 128 0
  ec_chk 3 eq omega_effect_read 0 out_meta cref pb 0
end

fn ec_gate4_val_checks hdr view ulong 4 slots view ulong 3328 meta view ulong 5 to void
  vargs = new ulong 5 0
  put vargs 0 get meta 2
  put vargs 1 get meta 3
  put vargs 2 7
  put vargs 3 add 0x7100 get meta 0
  put vargs 4 4
  ent = new ulong 13 0
  ec_chk 3 eq rx_caproot_validate hdr slots vargs ent ERR_OK

  note Hostile: wrong generation refused
  put vargs 1 add get meta 3 1
  ec_chk 3 ne rx_caproot_validate hdr slots vargs ent ERR_OK
  put vargs 1 get meta 3

  note Hostile: wrong slot refused
  put vargs 0 add get meta 2 1
  ec_chk 3 ne rx_caproot_validate hdr slots vargs ent ERR_OK
  put vargs 0 get meta 2

  note Hostile: wrong right refused
  put vargs 4 16
  ec_chk 3 eq rx_caproot_validate hdr slots vargs ent ERR_RIGHTS
end

fn ec_gate4_revoke hdr edit ulong 4 slots edit ulong 3328 delivered edit uchar 256 tok view uchar 32 ref1 view ulong 2 to void
  off = new ulong 2 0
  rx_capadmin_office off
  rargs = new ulong 4 0
  put rargs 0 get off 0
  put rargs 1 get off 1
  put rargs 2 get ref1 0
  put rargs 3 get ref1 1
  rlist = new ulong 257 0
  ec_chk 3 eq rx_capadmin_revoke hdr slots delivered tok rargs rlist ERR_OK
  vargs = new ulong 5 0
  put vargs 0 get ref1 0
  put vargs 1 get ref1 1
  put vargs 2 7
  put vargs 3 0x7105
  put vargs 4 4
  ent = new ulong 13 0
  ec_chk 3 ne rx_caproot_validate hdr slots vargs ent ERR_OK
end

fn ec_gate4_authority to void
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  delivered = new uchar 256 0
  tok = new uchar 32 0
  ec_chk 3 eq rx_caproot_start hdr slots delivered tok ERR_OK

  off = new ulong 2 0
  rx_capadmin_office off

  req = new ulong 9 0
  put req 0 3
  put req 1 7
  put req 2 0x7105
  put req 3 4
  put req 4 20
  put req 5 0xffffffff
  put req 6 0
  put req 7 get off 0
  put req 8 get off 1
  ref1 = new ulong 2 0
  ec_chk 3 eq rx_capadmin_mint hdr slots delivered tok req ref1 ERR_OK

  meta = new ulong 5 0
  ec_carry_omgg get ref1 0 get ref1 1 meta
  ec_gate4_val_checks hdr slots meta
  ec_gate4_revoke hdr slots delivered tok ref1

  ec_chk 3 eq rx_caproot_stop hdr slots delivered tok ERR_OK
end

fn main to int
  for g ulong 4
    put g_ec_fail g 0
  end
  ec_gate1_roundtrip
  ec_gate2_identity
  ec_gate3_stale_reject
  ec_gate4_authority
  tot = add add get g_ec_fail 0 get g_ec_fail 1 add get g_ec_fail 2 get g_ec_fail 3
  if eq tot 0
    ign = write 1 ec_g1 0 len ec_g1
    ign = write 1 ec_g2 0 len ec_g2
    ign = write 1 ec_g3 0 len ec_g3
    ign = write 1 ec_g4 0 len ec_g4
    ret 0
  end
  ign = write 1 ec_fail 0 len ec_fail
  ret 1
end

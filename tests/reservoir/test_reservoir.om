  tr_check gt bitcast f32 get tr_s add RES_ST_V 27 bitcast f32 get tr_s add RES_ST_V 22
  tr_check gt bitcast f32 get tr_s add RES_ST_V 41 bitcast f32 get tr_s add RES_ST_V 38

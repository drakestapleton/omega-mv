fn tr_sat_vstar to f64
  iv = f64 1.0e-10f32
  gua = mul 5.0e-8f64 5.0e-8f64
  n01 = mul 0.002f64 tr_exp64 3.7919f64
  n10 = mul 0.002f64 tr_exp64 mul 3.7919f64 2.0f64
  lo = 0.0f64
  hi = 0.5f64
  for it ulong 200 bound 200
    mid = mul 0.5f64 add lo hi
    t1 = mul n01 tr_exp64 div mid 0.0055f64
    t2 = mul n10 tr_exp64 div neg mid 0.0055f64
    f = sub mul mul gua add t1 t2 mid iv
    if gt f 0.0f64
      hi = mid
    else
      lo = mid
    end
  end
  ret mul 0.5f64 add lo hi
end

fn test_saturation to void
  t = new uint 514 0
  p = new uint 265 0
  _r1 = res_topology_chain 2 1 t
  _r2 = res_params_reference RES_REF_NARMA 2 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 1000 0 RES_OK
  tr_check eq tr_init_s RES_INIT_N0 0.0f32 RES_OK
  c2 = new f32 2 0.0f32
  put c2 0 1.0e-10f32
  tr_fill_const 301 2 view c2
  vstar = tr_sat_vstar
  tr_check and gt vstar 0.08f64 lt vstar 0.09f64
  worst = 0.0f64
  for k ulong 300 bound 300
    tr_check eq tr_advance_global 2 301 1000 0 RES_OK
    if ge k 150
      d = tr_abs64 sub f64 bitcast f32 get tr_s RES_ST_V vstar
      if gt d worst
        worst = d
      end
    end
  end
  tr_check le worst mul 2.0e-4f64 vstar
  tr_near f64 bitcast f32 get tr_s RES_ST_V vstar 2.0e-5f64
end


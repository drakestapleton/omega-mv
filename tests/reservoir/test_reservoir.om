note ================================================================
note Test 10, 11, 12: Reproducibility, Refusals, Membrane Guard
note ================================================================

fn test_reproducibility to void
  t = new uint 514 0
  p = new uint 265 0
  _r1 = res_topology_chain 5 4 t
  _r2 = res_params_reference RES_REF_NARMA 5 p
  put tr_rng 0 42
  knots = tr_fill_masked 5 30 2 1.0e-10f32
  steps = mul sub knots 1 10
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_N0 0.0f32 RES_OK
  tr_check eq tr_advance_global 5 uint knots steps 0 RES_OK
  for i ulong RES_STATE_WORDS bound 932
    put tr_s2 i get tr_s i
  end
  for i ulong RES_WS_WORDS bound 3564
    put tr_ws i 0xffffffff
  end
  tr_check eq tr_init_s RES_INIT_N0 0.0f32 RES_OK
  tr_check eq tr_advance_global 5 uint knots steps 0 RES_OK
  same = true
  for i ulong RES_STATE_WORDS bound 932
    if ne get tr_s i get tr_s2 i
      same = false
    end
  end
  tr_check same
  tr_check ne bitcast f32 get tr_s RES_ST_V 0.0f32
end

fn test_refusals_overflow to void
  t = new uint 514 0
  p = new uint 265 0
  _r = res_topology_chain 2 1 t
  _r = res_params_reference RES_REF_NARMA 2 p
  put p 6 bitcast uint 1.0e-12f32
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_CONST 1.0e-30f32 RES_OK
  bg = new f32 2 0.0f32
  put bg 0 1.0e-6f32
  tr_fill_const 101 2 view bg
  tr_check eq tr_advance_global 2 101 1000 0 RES_ERR_RANGE
  v0 = bitcast f32 get tr_s RES_ST_V
  tr_check le v0 1.0f32
  tr_check gt v0 0.99f32
  tr_check eq get tr_s RES_ST_STEP_LO 11
end

fn test_refusals to void
  t = new uint 514 0
  p = new uint 265 0
  _r = res_topology_chain 3 2 t
  _r = res_params_reference RES_REF_NARMA 3 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_N0 0.0f32 RES_OK
  c3 = new f32 3 0.0f32
  put c3 0 1.0e-10f32
  tr_fill_const 2 3 view c3
  for i ulong RES_STATE_WORDS bound 932
    put tr_s2 i get tr_s i
  end
  tr_check eq tr_advance_global 3 2 25 0 RES_ERR_INPUT
  tr_check eq or shl ulong get tr_s RES_ST_STEP_HI 32 ulong get tr_s RES_ST_STEP_LO 10
  for i ulong RES_STATE_WORDS bound 932
    put tr_s i get tr_s2 i
  end
  put tr_tab 1 bitcast f32 uint 0x7fc00000
  tr_check eq tr_advance_global 3 2 1 0 RES_ERR_NONFINITE
  put tr_tab 1 2.0e-6f32
  tr_check eq tr_step_global 3 2 RES_ERR_INPUT
  put tr_tab 1 0.0f32
  tr_check eq tr_step_global 2 2 RES_ERR_INPUT
  tr_check eq tr_step_global 3 1 RES_ERR_INPUT
  put tr_s RES_ST_V 0x7fc00000
  tr_check eq tr_step_global 3 2 RES_ERR_NONFINITE
  put tr_s RES_ST_V get tr_s2 RES_ST_V
  put tr_s add RES_ST_V 2 bitcast uint 1.0e-3f32
  tr_check eq tr_step_global 3 2 RES_ERR_RANGE
  put tr_s add RES_ST_V 2 0
  put tr_s RES_ST_V bitcast uint 1.5f32
  tr_check eq tr_step_global 3 2 RES_ERR_RANGE
  put tr_s RES_ST_V 0
  put tr_s add RES_ST_Y 1 bitcast uint 100.0f32
  tr_check eq tr_step_global 3 2 RES_ERR_RANGE
  put tr_s add RES_ST_Y 1 get tr_s2 add RES_ST_Y 1
  put tr_s 5 xor get tr_s 5 1
  tr_check eq tr_step_global 3 2 RES_ERR_MISMATCH
  put tr_s 5 get tr_s2 5

  note Stiffness refusal
  tr_check eq tr_init_s RES_INIT_CONST f32 tr_exp64 70.0f64 RES_OK
  tr_check eq tr_advance_global 3 2 1 0 RES_ERR_STIFF
  test_refusals_overflow
end

fn test_membrane_guard to void
  t = new uint 514 0
  p = new uint 265 0
  tr_check eq res_topology_chain 30 29 t RES_OK
  tr_check eq res_params_reference RES_REF_NARMA 30 p RES_OK
  put p 6 bitcast uint 1.0e-12f32
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_CONST 1.0e-30f32 RES_OK
  c30 = new f32 30 0.0f32
  put c30 0 1.0e-8f32
  tr_fill_const 201 30 view c30
  for i ulong RES_MSTATS_WORDS bound 200
    put tr_ws add RES_WS_MSTATS i 0
  end
  tr_check eq tr_advance_global 30 201 300 1 RES_OK
  tr_check eq get tr_s RES_ST_STEP_LO 300
  v0 = bitcast f32 get tr_s RES_ST_V
  tr_check gt v0 7.5f32
  tr_check lt v0 8.2f32
  tr_check eq get tr_ws add RES_WS_MSTATS RES_MS_OBS_LO 300
  tr_check eq get tr_ws add RES_WS_MSTATS RES_MS_MEM_IMP 0

  tr_check eq tr_advance_global 30 201 1900 1 RES_ERR_RANGE
  st_lo = get tr_s RES_ST_STEP_LO
  tr_check gt st_lo 1090
  tr_check lt st_lo 1120
  tr_check eq get tr_ws add RES_WS_MSTATS RES_MS_OBS_LO st_lo
  tr_check eq get tr_ws add RES_WS_MSTATS RES_MS_MEM_IMP 29
  max_mv = bitcast f32 get tr_ws add RES_WS_MSTATS RES_MS_MAX_MV
  tr_check le max_mv 1.0f32
  tr_check gt max_mv 0.99f32
  tr_check gt bitcast f32 get tr_s RES_ST_V 28.0f32
end

note ================================================================
note Test 13: Agreement with independent binary64 Dormand-Prince oracle
note ================================================================

fn tr_knot_max_err base ulong n ulong cur_max f64 to f64
  me = cur_max
  for i ulong n bound 64
    a = f64 bitcast f32 get tr_s add RES_ST_V i
    b = get tr_vtight add base i
    e = tr_abs64 sub a b
    if gt e me
      me = e
    end
  end
  ret me
end

fn tr_compare_oracle t view uint 514 p view uint 265 om view uint 5 to f64
  if ne tr_build_cfg t p bitcast f32 get om 0 get om 1 0 RES_OK
    ret 1.0e9f64
  end
  if ne tr_init_s get om 2 bitcast f32 get om 3 RES_OK
    ret 1.0e9f64
  end
  n = ulong get t 0
  knots = ulong get om 4
  ks = ulong get om 1
  max_err = 0.0f64
  for kn ulong sub knots 1 bound 4096
    if ne tr_advance_global uint n uint knots ks 0 RES_OK
      ret 1.0e9f64
    end
    max_err = tr_knot_max_err mul add kn 1 n n max_err
  end
  ret max_err
end

fn tr_init_ninit_one t view uint 514 p view uint 265 e ulong kind uint init_v f32 to void
  if eq kind RES_INIT_N0
    n0s = f64 bitcast f32 get p 7
    n0r = f64 bitcast f32 get p 8
    nd = ulong get t add RES_TOPO_EDGES mul e 2
    cc = f64 bitcast f32 get p add RES_PAR_CONC nd
    put o64_ninit mul e 2 mul n0s tr_exp64 mul n0r cc
    nd = ulong get t add RES_TOPO_EDGES add mul e 2 1
    cc = f64 bitcast f32 get p add RES_PAR_CONC nd
    put o64_ninit add mul e 2 1 mul n0s tr_exp64 mul n0r cc
  else
    put o64_ninit mul e 2 f64 init_v
    put o64_ninit add mul e 2 1 f64 init_v
  end
end

fn tr_init_ninit t view uint 514 p view uint 265 kind uint init_v f32 to void
  ec = ulong get t 1
  for e ulong ec bound 192
    tr_init_ninit_one t p e kind init_v
  end
end

fn tr_oracle_vmax_ref total ulong out_pair edit f64 2 to void
  vmax = 0.0f64
  ref_err = 0.0f64
  for q ulong total bound 262144
    vt = get tr_vtight q
    av = tr_abs64 vt
    if gt av vmax
      vmax = av
    end
    e = tr_abs64 sub get tr_vref q vt
    if gt e ref_err
      ref_err = e
    end
  end
  put out_pair 0 vmax
  put out_pair 1 ref_err
end

fn tr_oracle_sweep t view uint 514 p view uint 265 om edit uint 5 vmax f64 to void
  hs = new f32 5 0.0f32
  put hs 0 1.0e-4f32
  put hs 1 5.0e-5f32
  put hs 2 2.0e-5f32
  put hs 3 1.0e-5f32
  put hs 4 5.0e-6f32
  ks = new uint 5 0
  put ks 0 1
  put ks 1 2
  put ks 2 5
  put ks 3 10
  put ks 4 20
  for c ulong 5 bound 5
    put om 0 bitcast uint get hs c
    put om 1 get ks c
    me = tr_compare_oracle t p view om
    tr_check le me mul 1.0e-6f64 vmax
  end
end

fn tr_oracle_case t view uint 514 p view uint 265 kind uint init_v f32 knots ulong to void
  tr_init_ninit t p kind init_v
  tr_check eq o64_run t p knots 1.0e-10f64 1.0e-14f64 0 0
  tr_check eq o64_run t p knots 1.0e-6f64 1.0e-8f64 1 0
  pr = new f64 2 0.0f64
  tr_oracle_vmax_ref mul knots ulong get t 0 pr
  vmax = get pr 0
  tr_check gt vmax 0.0f64
  tr_check le get pr 1 mul 1.0e-9f64 vmax
  om = new uint 5 0
  put om 2 kind
  put om 3 bitcast uint init_v
  put om 4 uint knots
  tr_oracle_sweep t p om vmax
  tr_wstr tr_orc_ok
end

fn tr_fill_lorenz13 kn ulong to void
  for i ulong mul 13 kn bound 32768
    put tr_tab i 0.0f32
  end
  twopi = 6.283185307179586f64
  for k ulong kn bound 2048
    t_s = mul mul twopi 20.0f64 mul f64 k 1.0e-4f64
    put tr_tab mul k 13 f32 div add mul mul 15.0f64 tr_sin64_exact t_s 1.05e-10f64 1.0e-9f64 10.0f64
    put tr_tab add mul k 13 1 f32 div add mul mul 15.0f64 tr_sin64_exact add t_s 1.0f64 1.05e-10f64 1.0e-9f64 10.0f64
    put tr_tab add mul k 13 12 f32 div add mul mul 15.0f64 tr_sin64_exact add t_s 2.0f64 1.05e-10f64 1.0e-9f64 10.0f64
  end
end

fn test_oracle_agreement to void
  t = new uint 514 0
  p = new uint 265 0
  _r = res_topology_chain 2 1 t
  _r = res_params_reference RES_REF_NARMA 2 p
  c2 = new f32 2 0.0f32
  put c2 0 1.0e-10f32
  tr_fill_const 2001 2 view c2
  tr_oracle_case view t view p RES_INIT_N0 0.0f32 2001

  _r = res_topology_chain 5 4 t
  _r = res_params_reference RES_REF_NARMA 5 p
  put tr_rng 0 7
  kn = tr_fill_masked 5 100 2 1.0e-10f32
  tr_oracle_case view t view p RES_INIT_N0 0.0f32 kn

  tr_check eq fx_hex13 t RES_OK
  _r = res_params_reference RES_REF_LORENZ 13 p
  tr_fill_lorenz13 1001
  tr_oracle_case view t view p RES_INIT_CONST 1.0f32 1001
end

note ================================================================
note Test 14: Readout & NRMSE
note ================================================================

fn test_readout_nrmse to void
  ref = new f64 4 0.0f64
  put ref 0 1.0f64
  put ref 1 2.0f64
  put ref 2 3.0f64
  put ref 3 4.0f64
  pred = new f64 4 0.0f64
  put pred 0 1.0f64
  put pred 1 2.0f64
  put pred 2 3.0f64
  put pred 3 5.0f64
  flat = new f64 4 2.5f64
  c4 = new f64 4 7.0f64
  v = new f64 1 0.0f64
  tr_check eq res_nrmse_f64 view ref view pred v RES_OK
  tr_near get v 0 0.4472135954999579f64 1.0e-15f64
  ref2 = new f64 4 0.0f64
  put ref2 0 1.0f64
  put ref2 1 2.0f64
  put ref2 2 3.0f64
  put ref2 3 4.0f64
  tr_check eq res_nrmse_f64 view ref view ref2 v RES_OK
  tr_check eq get v 0 0.0f64
  tr_check eq res_nrmse_f64 view ref view flat v RES_OK
  tr_check eq get v 0 1.0f64
  tr_check eq res_nrmse_f64 view c4 view ref v RES_ERR_SINGULAR
  tr_check eq res_nrmse_f64 part ref 0 1 part pred 0 1 v RES_ERR_PARAM
  wn = new f64 4 1.0f64
  put wn 1 bitcast f64 ulong 0x7ff8000000000000
  tr_check eq res_nrmse_f64 view wn view pred v RES_ERR_NONFINITE
end

fn tr_fill_ro_data x edit f64 180 y edit f64 120 to void
  put tr_rng 0 99
  for s ulong 60 bound 60
    x0 = sub mul tr_runit 2.0f64 1.0f64
    x1 = sub mul tr_runit 2.0f64 1.0f64
    x2 = sub mul tr_runit 2.0f64 1.0f64
    put x mul s 3 x0
    put x add mul s 3 1 x1
    put x add mul s 3 2 x2
    put y mul s 2 add add add 0.5f64 mul 2.0f64 x0 mul -1.0f64 x1 mul 0.25f64 x2
    put y add mul s 2 1 add -3.0f64 mul 0.125f64 x1
  end
end

fn tr_test_ro_degen x view f64 180 y view f64 120 rws edit ulong 67334 to void
  meta = new ulong 4 0
  put meta 0 60
  put meta 1 2
  put meta 2 2
  xd = new f64 120 0.0f64
  for s ulong 60 bound 60
    put xd mul s 2 get x mul s 3
    put xd add mul s 2 1 get x mul s 3
  end
  put meta 3 bitcast ulong 0.0f64
  tr_check eq res_readout_fit_ws view xd y view meta rws RES_ERR_SINGULAR
  put meta 3 bitcast ulong 1.0e-3f64
  tr_check eq res_readout_fit_ws view xd y view meta rws RES_OK
  put meta 1 3
  put meta 3 bitcast ulong -1.0f64
  tr_check eq res_readout_fit_ws x y view meta rws RES_ERR_PARAM
end

fn test_readout to void
  x = new f64 180 0.0f64
  y = new f64 120 0.0f64
  tr_fill_ro_data x y
  rws = new ulong 67334 0
  ro = new ulong 1031 0
  meta = new ulong 4 0
  put meta 0 60
  put meta 1 3
  put meta 2 2
  put meta 3 bitcast ulong 0.0f64
  tr_check eq res_readout_fit_ws view x view y view meta rws RES_OK
  res_readout_extract view rws view meta ro
  tr_nearabs bitcast f64 get ro 3 0.5f64 1.0e-12f64
  tr_nearabs bitcast f64 get ro 7 2.0f64 1.0e-12f64
  tr_nearabs bitcast f64 get ro 11 -1.0f64 1.0e-12f64
  tr_nearabs bitcast f64 get ro 15 0.25f64 1.0e-12f64
  tr_nearabs bitcast f64 get ro 4 -3.0f64 1.0e-12f64
  tr_nearabs bitcast f64 get ro 12 0.125f64 1.0e-12f64
  yout = new f64 2 0.0f64
  tr_check eq res_readout_apply view ro part x 15 3 yout RES_OK
  tr_nearabs get yout 0 get y 10 1.0e-12f64
  put meta 3 bitcast ulong 1.0e12f64
  tr_check eq res_readout_fit_ws view x view y view meta rws RES_OK
  res_readout_extract view rws view meta ro
  mean = 0.0f64
  for s ulong 60 bound 60
    mean = add mean get y mul s 2
  end
  mean = div mean 60.0f64
  tr_nearabs bitcast f64 get ro 3 mean 1.0e-6f64
  tr_nearabs bitcast f64 get ro 7 0.0f64 1.0e-9f64
  tr_test_ro_degen view x view y rws
  put meta 3 bitcast ulong 0.0f64
  put x 7 bitcast f64 ulong 0x7ff8000000000000
  tr_check eq res_readout_fit_ws view x view y view meta rws RES_ERR_NONFINITE
  test_readout_nrmse
end

fn main to int
  put tr_rng 0 or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  test_topology
  test_reference_lattices
  test_params
  test_identity
  test_zero_input_fixed_point
  test_decay
  test_charging
  test_saturation
  test_connected_and_disconnected
  test_reproducibility
  test_refusals
  test_membrane_guard
  test_oracle_agreement
  test_readout
  tr_wstr tr_hdr
  tr_wu64 1 get tr_checks 0
  tr_wstr tr_chks
  tr_wu64 1 get tr_fail_cnt 0
  tr_wstr tr_fld
  if ne get tr_fail_cnt 0 0
    tr_wstr tr_fail
    ret 1
  end
  tr_wstr tr_pass
  ret 0
end

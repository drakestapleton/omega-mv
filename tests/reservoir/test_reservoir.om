note Test 1 & 2: Topology and Reference Lattices
note ================================================================

fn test_topology_bad2 to void
  t2 = new uint 514 0
  g0 = new uint 1 0
  g9 = new uint 1 9
  tm = new uint 3 0
  dupl_e = new uint 4 0
  put dupl_e 1 1
  put dupl_e 2 1
  put tm 0 2
  put tm 1 1
  put tm 2 0
  tr_check eq res_topology_build view tm view dupl_e view g0 t2 RES_ERR_TOPOLOGY
  put tm 1 0
  put tm 2 1
  tr_check eq res_topology_build view tm view dupl_e view g0 t2 RES_ERR_TOPOLOGY
  put tm 0 1
  put tm 1 1
  tr_check eq res_topology_build view tm view dupl_e view g0 t2 RES_ERR_TOPOLOGY
  put tm 0 65
  tr_check eq res_topology_build view tm view dupl_e view g0 t2 RES_ERR_TOPOLOGY
  put tm 0 3
  tr_check eq res_topology_build view tm view dupl_e view g9 t2 RES_ERR_TOPOLOGY
  tr_check eq res_topology_build view tm view dupl_e view g0 t2 RES_ERR_TOPOLOGY
  tr_check eq res_topology_chain 1 0 t2 RES_ERR_TOPOLOGY
  tr_check eq res_topology_chain 4 4 t2 RES_ERR_TOPOLOGY
end

fn test_topology_bad to void
  t2 = new uint 514 0
  g0 = new uint 1 0
  gg = new uint 2 0
  gall = new uint 2 0
  put gall 1 1
  tm = new uint 3 0
  e = new uint 4 1
  put tm 0 2
  put tm 1 1
  put tm 2 1
  tr_check eq res_topology_build view tm view e view g0 t2 RES_ERR_TOPOLOGY
  put e 0 0
  put e 1 1
  put e 2 1
  put e 3 0
  put tm 1 2
  tr_check eq res_topology_build view tm view e view g0 t2 RES_ERR_TOPOLOGY
  put e 1 5
  put tm 0 5
  put tm 1 1
  tr_check eq res_topology_build view tm view e view g0 t2 RES_ERR_TOPOLOGY
  put e 1 1
  put tm 0 2
  put tm 1 1
  put tm 2 2
  tr_check eq res_topology_build view tm view e view gg t2 RES_ERR_TOPOLOGY
  tr_check eq res_topology_build view tm view e view gall t2 RES_ERR_TOPOLOGY
  test_topology_bad2
end

fn test_topology to void
  t = new uint 514 0
  t2 = new uint 514 0
  tr_check eq res_topology_chain 5 4 t RES_OK
  tr_check and eq get t 0 5 eq get t 1 4
  tr_check and eq get t RES_TOPO_DEG 1 eq get t add RES_TOPO_DEG 1 2
  tr_check and eq get t add RES_TOPO_GND 4 1 eq get t RES_TOPO_GND 0
  sh = new uint 8 0
  put sh 0 4
  put sh 1 3
  put sh 2 1
  put sh 3 0
  put sh 4 2
  put sh 5 3
  put sh 6 2
  put sh 7 1
  g4 = new uint 1 4
  tm = new uint 3 0
  put tm 0 5
  put tm 1 4
  put tm 2 1
  tr_check eq res_topology_build view tm view sh view g4 t2 RES_OK
  same = true
  for i ulong RES_TOPO_WORDS bound 514
    if ne get t i get t2 i
      same = false
    end
  end
  tr_check same
  test_topology_bad
  star = new uint 14 0
  for i ulong 7 bound 7
    put star mul i 2 0
    put star add mul i 2 1 uint add i 1
  end
  g0 = new uint 1 0
  put tm 0 8
  put tm 1 7
  put tm 2 1
  tr_check eq res_topology_build view tm view star view g0 t2 RES_ERR_TOPOLOGY
  put tm 0 7
  put tm 1 6
  tr_check eq res_topology_build view tm view star view g0 t2 RES_OK
  tr_check eq get t2 RES_TOPO_DEG 6
  two = new uint 6 0
  put two 0 0
  put two 1 1
  put two 2 1
  put two 3 2
  put two 4 3
  put two 5 4
  g2 = new uint 1 2
  g24 = new uint 2 2
  put g24 1 4
  put tm 0 5
  put tm 1 3
  put tm 2 1
  tr_check eq res_topology_build view tm view two view g2 t2 RES_ERR_TOPOLOGY
  put tm 2 2
  tr_check eq res_topology_build view tm view two view g24 t2 RES_OK
end

fn tr_deg_hist t view uint 514 h edit uint 8 to void
  for i ulong 8 bound 8
    put h i 0
  end
  for i ulong ulong get t 0 bound 64
    d = ulong get t add RES_TOPO_DEG i
    put h d add get h d 1
  end
end

fn test_reference_lattices to void
  t = new uint 514 0
  h = new uint 8 0
  tr_check eq fx_hex13 t RES_OK
  tr_check eq get t 1 21
  tr_deg_hist view t h
  tr_check and eq get h 1 3 and eq get h 3 3 and eq get h 4 6 eq get h 6 1
  tr_check and eq get t add RES_TOPO_DEG 7 6 eq get t add RES_TOPO_GND 7 1

  tr_check eq fx_hex25 t RES_OK
  tr_check eq get t 1 51
  tr_deg_hist view t h
  tr_check and eq get h 1 3 and eq get h 3 6 and eq get h 5 3 eq get h 6 7
  tr_check eq get t add RES_TOPO_DEG 13 6

  tr_check eq fx_hex43 t RES_OK
  tr_check eq get t 1 99
  tr_deg_hist view t h
  tr_check and eq get h 1 3 and eq get h 3 7 and eq get h 4 10 eq get h 6 19
  tr_check eq get t add RES_TOPO_DEG 20 6
  bnd = ulong 0
  for i ulong 43 bound 43
    if lt get t add RES_TOPO_DEG i 6
      bnd = add bnd 1
    end
  end
  tr_check eq bnd 24

  tr_check eq fx_chain50 t RES_OK
  tr_deg_hist view t h
  tr_check and eq get h 1 2 eq get h 2 48
  tr_check and eq get t RES_TOPO_DEG 1 and eq get t add RES_TOPO_DEG 1 1 eq get t add RES_TOPO_DEG 49 2
end

note ================================================================
note Test 3 & 4: Params and Identity (with frozen C SHA-256 config_id!)
note ================================================================

fn test_params to void
  p = new uint 265 0
  tr_check eq res_params_reference RES_REF_NARMA 5 p RES_OK
  tr_check eq bitcast f32 get p 1 8.85e-12f32
  tr_check eq bitcast f32 get p 5 0.00015f32
  tr_check and eq bitcast f32 get p RES_PAR_CONC 1.0f32 eq bitcast f32 get p add RES_PAR_CONC 2 3.0f32
  tr_check eq res_params_reference RES_REF_LORENZ 43 p RES_OK
  tr_check eq bitcast f32 get p 1 f32 mul 2.1f64 8.85e-12f64
  tr_check eq bitcast f32 get p add RES_PAR_VTAU 42 0.0454f32
  tr_check eq res_params_reference 7 5 p RES_ERR_PARAM
  tr_check eq res_params_reference RES_REF_NARMA 0 p RES_ERR_PARAM

  t = new uint 514 0
  _rt = res_topology_chain 5 4 t
  _rp = res_params_reference RES_REF_NARMA 5 p
  put p 1 0x7fc00000
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_ERR_PARAM
  _rp = res_params_reference RES_REF_NARMA 5 p
  put p 5 bitcast uint 1.5f32
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_ERR_PARAM
  _rp = res_params_reference RES_REF_NARMA 5 p
  put p 8 bitcast uint 40.0f32
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_ERR_PARAM
  _rp = res_params_reference RES_REF_NARMA 4 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_ERR_PARAM
  _rp = res_params_reference RES_REF_NARMA 5 p
  tr_check eq tr_build_cfg view t view p 0.0f32 10 0 RES_ERR_PARAM
  tr_check eq tr_build_cfg view t view p 2.0e-3f32 1 0 RES_ERR_PARAM
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 0 0 RES_ERR_PARAM
  t2 = new uint 514 0
  for i ulong RES_TOPO_WORDS bound 514
    put t2 i get t i
  end
  put t2 RES_TOPO_DEG 3
  tr_check eq tr_build_cfg view t2 view p 1.0e-5f32 10 0 RES_ERR_TOPOLOGY
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
end

note Frozen C SHA-256 config_id for 5-node NARMA chain, h=1e-5, K=10:
note cb778325f867428cd815041fe262c19c734db220a95e32a2506fc6af673e6224
fn tr_check_frozen_chain5_cid to void
  w = new uchar 32 0
  put w 0 0xcb
  put w 1 0x77
  put w 2 0x83
  put w 3 0x25
  put w 4 0xf8
  put w 5 0x67
  put w 6 0x42
  put w 7 0x8c
  put w 8 0xd8
  put w 9 0x15
  put w 10 0x04
  put w 11 0x1f
  put w 12 0xe2
  put w 13 0x62
  put w 14 0xc1
  put w 15 0x9c
  put w 16 0x73
  put w 17 0x4d
  put w 18 0xb2
  put w 19 0x20
  put w 20 0xa9
  put w 21 0x5e
  put w 22 0x32
  put w 23 0xa2
  put w 24 0x50
  put w 25 0x6f
  put w 26 0xc6
  put w 27 0xaf
  put w 28 0x67
  put w 29 0x3e
  put w 30 0x62
  put w 31 0x24
  ok = true
  for i ulong 32 bound 32
    if ne get tr_cfg add RES_CFG_ID i uint get w i
      ok = false
    end
  end
  tr_check ok
end

fn test_identity to void
  t = new uint 514 0
  t2 = new uint 514 0
  p = new uint 265 0
  _r1 = res_topology_chain 5 4 t
  _r2 = res_params_reference RES_REF_NARMA 5 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 1 RES_OK
  tr_check tr_cfg_eq_id
  tr_check_frozen_chain5_cid
  sh = new uint 8 0
  put sh 0 3
  put sh 1 4
  put sh 2 2
  put sh 3 1
  put sh 4 0
  put sh 5 1
  put sh 6 3
  put sh 7 2
  g4 = new uint 1 4
  tm = new uint 3 0
  put tm 0 5
  put tm 1 4
  put tm 2 1
  _r3 = res_topology_build view tm view sh view g4 t2
  tr_check eq tr_build_cfg view t2 view p 1.0e-5f32 10 1 RES_OK
  tr_check tr_cfg_eq_id
  put p RES_PAR_CONC 0
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  put p RES_PAR_CONC 0x80000000
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 1 RES_OK
  tr_check tr_cfg_eq_id
  _r2 = res_params_reference RES_REF_NARMA 5 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_build_cfg view t view p tr_nextafter_up 1.0e-5f32 10 1 RES_OK
  tr_check not tr_cfg_eq_id
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 11 1 RES_OK
  tr_check not tr_cfg_eq_id
  _r4 = res_topology_chain 5 0 t2
  tr_check eq tr_build_cfg view t2 view p 1.0e-5f32 10 1 RES_OK
  tr_check not tr_cfg_eq_id
end

note ================================================================
note Test 5..9: Closed-form dynamics & connected/disconnected
note ================================================================

fn test_zero_input_fixed_point to void
  t = new uint 514 0
  p = new uint 265 0
  _r1 = res_topology_chain 5 4 t
  _r2 = res_params_reference RES_REF_NARMA 5 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_N0 0.0f32 RES_OK
  s = new uint 932 0
  for i ulong RES_STATE_WORDS bound 932
    put s i get tr_s i
    put tr_s2 i get tr_s i
  end
  tr_near f64 res_state_pore view s 0 mul 0.002f64 tr_exp64 3.7919f64 1.0e-5f64
  tr_near f64 res_state_pore view s 1 mul 0.002f64 tr_exp64 mul 3.7919f64 2.0f64 1.0e-5f64
  tr_check res_f32_isnan res_state_pore view s 8
  z5 = new f32 5 0.0f32
  tr_fill_const 401 5 view z5
  tr_check eq tr_advance_global 5 401 4000 0 RES_OK
  tr_check eq or shl ulong get tr_s RES_ST_STEP_HI 32 ulong get tr_s RES_ST_STEP_LO 4000
  same = true
  for i ulong 64 bound 64
    a = get tr_s add RES_ST_V i
    b = get tr_s2 add RES_ST_V i
    if ne a b
      same = false
    end
  end
  for i ulong 384 bound 384
    a = get tr_s add RES_ST_Y i
    b = get tr_s2 add RES_ST_Y i
    if ne a b
      same = false
    end
  end
  tr_check same
end

fn tr_decay_check_side ms ulong side ulong prev edit f64 2 to void
  cval = 1.0f64
  if ne side 0
    cval = 2.0f64
  end
  ln0 = add tr_log64 0.002f64 mul 3.7919f64 cval
  s0 = tr_exp64 mul -0.00015f64 sub tr_log64 1000.0f64 ln0
  sv = tr_exp64 mul -1500.0f64 mul f64 add ms 1 1.0e-3f64
  sv = sub 1.0f64 mul sub 1.0f64 s0 sv
  sv = sub ln0 div tr_log64 sv 0.00015f64
  ygot = f64 bitcast f32 get tr_s add RES_ST_Y side
  tr_nearabs ygot sv 2.0e-4f64
  tr_check and lt ygot get prev side gt ygot ln0
  put prev side ygot
end

fn test_decay to void
  t = new uint 514 0
  p = new uint 265 0
  _r1 = res_topology_chain 2 1 t
  _r2 = res_params_reference RES_REF_NARMA 2 p
  tr_check eq tr_build_cfg view t view p 1.0e-5f32 10 0 RES_OK
  tr_check eq tr_init_s RES_INIT_CONST 1000.0f32 RES_OK
  z2 = new f32 2 0.0f32
  tr_fill_const 101 2 view z2
  prev = new f64 2 1.0e9f64
  for ms ulong 8 bound 8
    tr_check eq tr_advance_global 2 101 100 0 RES_OK
    tr_check eq bitcast f32 get tr_s RES_ST_V 0.0f32
    tr_check eq bitcast f32 get tr_s add RES_ST_V 1 0.0f32
    tr_decay_check_side ms 0 prev
    tr_decay_check_side ms 1 prev
  end
end


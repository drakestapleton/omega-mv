note ================================================================
note Printing & Check helpers
note ================================================================

fn tr_wstr s view uchar * to void
  _w = write 1 s 0 len s
end

fn tr_wu64 fd int v ulong to void
  buf = new uchar 24 0
  if eq v 0
    put buf 0 uchar 48
    _w = write fd buf 0 1
    ret
  end
  x = v
  n = ulong 0
  while gt x 0 bound 24
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 24 0
  for i ulong n bound 24
    put rev i get buf sub sub n 1 i
  end
  _w = write fd rev 0 n
end

fn tr_check ok bool to void
  c = add get tr_checks 0 1
  put tr_checks 0 c
  if not ok
    put tr_fail_cnt 0 add get tr_fail_cnt 0 1
    _w1 = write 2 tr_fail_pfx 0 len tr_fail_pfx
    tr_wu64 2 c
    _w2 = write 2 tr_nl 0 1
  end
end

fn tr_abs64 x f64 to f64
  if lt x 0.0f64
    ret neg x
  end
  ret x
end

fn tr_max64 a f64 b f64 to f64
  if gt a b
    ret a
  end
  ret b
end

fn tr_min64 a f64 b f64 to f64
  if lt a b
    ret a
  end
  ret b
end

fn tr_near a f64 b f64 rel f64 to void
  d = tr_abs64 sub a b
  s = tr_max64 tr_abs64 b 1.0e-300f64
  tr_check le d mul rel s
end

fn tr_nearabs a f64 b f64 ab f64 to void
  tr_check le tr_abs64 sub a b ab
end

note ================================================================
note Pure OM-2 binary64 math: exp64, log64, pow64, sin64, nextafterf32
note ================================================================

fn tr_exp64 x f64 to f64
  if not res_fin64 bitcast ulong x
    if gt x 0.0f64
      ret x
    end
    ret 0.0f64
  end
  if lt x -745.0f64
    ret 0.0f64
  end
  if gt x 709.78f64
    ret bitcast f64 ulong 0x7ff0000000000000
  end
  inv_ln2 = 1.4426950408889634f64
  ln2_hi = 0.6931471803691238f64
  ln2_lo = 1.9082149292705877e-10f64
  prod = mul x inv_ln2
  k = long 0
  if ge prod 0.0f64
    k = long add prod 0.5f64
  else
    k = long sub prod 0.5f64
  end
  fk = f64 k
  r = sub sub x mul fk ln2_hi mul fk ln2_lo
  p = div 1.0f64 39916800.0f64
  p = add div 1.0f64 3628800.0f64 mul r p
  p = add div 1.0f64 362880.0f64 mul r p
  p = add div 1.0f64 40320.0f64 mul r p
  p = add div 1.0f64 5040.0f64 mul r p
  p = add div 1.0f64 720.0f64 mul r p
  p = add div 1.0f64 120.0f64 mul r p
  p = add div 1.0f64 24.0f64 mul r p
  p = add div 1.0f64 6.0f64 mul r p
  p = add 0.5f64 mul r p
  p = add 1.0f64 mul r p
  poly = add 1.0f64 mul r p
  if gt k 1023
    s1 = bitcast f64 shl ulong 2046 52
    s2 = bitcast f64 shl ulong add sub k 1023 1023 52
    ret mul mul poly s1 s2
  end
  if lt k -1022
    s1 = bitcast f64 shl ulong add add k 512 1023 52
    s2 = bitcast f64 shl ulong 511 52
    ret mul mul poly s1 s2
  end
  ret mul poly bitcast f64 shl ulong add k 1023 52
end

fn tr_log64 x f64 to f64
  if or not res_fin64 bitcast ulong x le x 0.0f64
    ret bitcast f64 ulong 0x7ff8000000000000
  end
  u = bitcast ulong x
  e = sub long and shr u 52 0x7ff 1023
  m = bitcast f64 or and u 0x000fffffffffffff 0x3ff0000000000000
  if gt m 1.4142135623730951f64
    m = mul m 0.5f64
    e = add e 1
  end
  z = div sub m 1.0f64 add m 1.0f64
  z2 = mul z z
  p = div 1.0f64 15.0f64
  p = add div 1.0f64 13.0f64 mul z2 p
  p = add div 1.0f64 11.0f64 mul z2 p
  p = add div 1.0f64 9.0f64 mul z2 p
  p = add div 1.0f64 7.0f64 mul z2 p
  p = add div 1.0f64 5.0f64 mul z2 p
  p = add div 1.0f64 3.0f64 mul z2 p
  p = add 1.0f64 mul z2 p
  lnm = mul mul 2.0f64 z p
  ret add mul f64 e 0.6931471805599453f64 lnm
end

fn tr_pow64 a f64 b f64 to f64
  if le a 0.0f64
    ret 0.0f64
  end
  ret tr_exp64 mul b tr_log64 a
end

fn tr_sin64_exact x f64 to f64
  twopi = 6.283185307179586f64
  pi = 3.141592653589793f64
  q = div x twopi
  k = long 0
  if ge q 0.0f64
    k = long add q 0.5f64
  else
    k = long sub q 0.5f64
  end
  r = sub x mul f64 k twopi
  if gt r 1.5707963267948966f64
    r = sub pi r
  else
    if lt r -1.5707963267948966f64
      r = sub neg pi r
    end
  end
  r2 = mul r r
  p = div 1.0f64 6227020800.0f64
  p = add div -1.0f64 39916800.0f64 mul r2 p
  p = add div 1.0f64 362880.0f64 mul r2 p
  p = add div -1.0f64 5040.0f64 mul r2 p
  p = add div 1.0f64 120.0f64 mul r2 p
  p = add div -1.0f64 6.0f64 mul r2 p
  p = add 1.0f64 mul r2 p
  ret mul r p
end

fn tr_nextafter_up f f32 to f32
  u = bitcast uint f
  if eq and u 0x7fffffff 0
    ret bitcast f32 uint 1
  end
  if lt f 0.0f32
    ret bitcast f32 sub u 1
  end
  ret bitcast f32 add u 1
end

fn tr_rnd to ulong
  s = get tr_rng 0
  s = xor s shr s 12
  s = xor s shl s 25
  s = xor s shr s 27
  put tr_rng 0 s
  c = or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
  ret mul s c
end

fn tr_runit to f64
  ret div f64 shr tr_rnd 11 9007199254740992.0f64
end

note ================================================================
note Reference fixtures (res_fixtures.h)
note ================================================================

global fx_nb uint 301
global fx_e uint 384

fn fx_add_row row ulong cnt ulong n1 uint n2 uint n3 uint n4 uint to void
  b = mul row 7
  put fx_nb b uint cnt
  put fx_nb add b 1 n1
  put fx_nb add b 2 n2
  put fx_nb add b 3 n3
  put fx_nb add b 4 n4
end

fn fx_add_row6 row ulong n5 uint n6 uint to void
  b = mul row 7
  put fx_nb add b 5 n5
  put fx_nb add b 6 n6
end

fn fx_add_edge_unique m ulong a uint b uint to ulong
  lo = a
  hi = b
  if gt a b
    lo = b
    hi = a
  end
  for q ulong m bound 192
    if eq get fx_e mul q 2 lo
      if eq get fx_e add mul q 2 1 hi
        ret m
      end
    end
  end
  put fx_e mul m 2 lo
  put fx_e add mul m 2 1 hi
  ret add m 1
end

fn fx_collect_row i ulong m ulong to ulong
  cnt = ulong get fx_nb mul i 7
  mm = m
  for k ulong cnt bound 6
    nb1 = get fx_nb add mul i 7 add k 1
    mm = fx_add_edge_unique mm uint i sub nb1 1
  end
  ret mm
end

fn fx_build_from_nb n ulong ground1 uint out_t edit uint 514 to int
  m = ulong 0
  for i ulong n bound 64
    m = fx_collect_row i m
  end
  eloc = new uint 384 0
  for i ulong mul m 2 bound 384
    put eloc i get fx_e i
  end
  g = new uint 1 0
  put g 0 sub ground1 1
  tm = new uint 3 0
  put tm 0 uint n
  put tm 1 uint m
  put tm 2 1
  ret res_topology_build view tm view eloc view g out_t
end


note ================================================================
note Global state / tab helpers (since globals cannot be passed as args)
note ================================================================

fn tr_cfg_eq_id to bool
  for i ulong 32 bound 32
    if ne get tr_cfg add RES_CFG_ID i get tr_cfg2 add RES_CFG_ID i
      ret false
    end
  end
  ret true
end

fn tr_build_cfg t view uint 514 p view uint 265 h f32 k uint which uint to int
  c = new uint 5363 0
  st = res_config_build t p h k c
  if eq st RES_OK
    for i ulong RES_CFG_WORDS bound 5363
      if eq which 0
        put tr_cfg i get c i
      else
        put tr_cfg2 i get c i
      end
    end
  end
  ret st
end

fn tr_init_s kind uint val f32 to int
  c = new uint 5363 0
  for i ulong RES_CFG_WORDS bound 5363
    put c i get tr_cfg i
  end
  s = new uint 932 0
  st = res_state_init view c kind val s
  if eq st RES_OK
    for i ulong RES_STATE_WORDS bound 932
      put tr_s i get s i
    end
  end
  ret st
end

fn tr_advance_global in_nc uint in_kn uint steps ulong obs uint to int
  c = new uint 5363 0
  for i ulong RES_CFG_WORDS bound 5363
    put c i get tr_cfg i
  end
  s = new uint 932 0
  for i ulong RES_STATE_WORDS bound 932
    put s i get tr_s i
  end
  ws = new uint 3564 0
  for i ulong RES_WS_WORDS bound 3564
    put ws i get tr_ws i
  end
  total = mul ulong in_nc ulong in_kn
  note Copy needed slice of tr_tab into local? Up to 262144 f32 = 1 MiB (fits 4 MiB local limit!)
  note Actually we can just copy needed knots! Wait: local array must have const size.
  note Let's use a 131072-element local f32 array (512 KiB) — max knots*n in test_reservoir is 2001*5=10005 or 1001*13=13013!
  ltab = new f32 32768 0.0f32
  for i ulong total bound 32768
    put ltab i get tr_tab i
  end
  am = new uint 5 0
  put am 0 in_nc
  put am 1 in_kn
  put am 2 uint and steps 0xffffffff
  put am 3 uint shr steps 32
  put am 4 obs
  st = res_advance_meta view c part ltab 0 total view am ws s
  for i ulong RES_STATE_WORDS bound 932
    put tr_s i get s i
  end
  for i ulong RES_WS_WORDS bound 3564
    put tr_ws i get ws i
  end
  ret st
end

fn tr_step_global in_nc uint in_kn uint to int
  c = new uint 5363 0
  for i ulong RES_CFG_WORDS bound 5363
    put c i get tr_cfg i
  end
  s = new uint 932 0
  for i ulong RES_STATE_WORDS bound 932
    put s i get tr_s i
  end
  ws = new uint 3564 0
  for i ulong RES_WS_WORDS bound 3564
    put ws i get tr_ws i
  end
  total = mul ulong in_nc ulong in_kn
  ltab = new f32 32768 0.0f32
  for i ulong total bound 32768
    put ltab i get tr_tab i
  end
  im = new uint 2 0
  put im 0 in_nc
  put im 1 in_kn
  st = res_step_spare view c part ltab 0 total view im ws view s
  for i ulong RES_WS_WORDS bound 3564
    put tr_ws i get ws i
  end
  ret st
end

fn tr_fill_const knots ulong n ulong vals view f32 * to void
  for k ulong knots bound 4096
    for i ulong n bound 64
      put tr_tab add mul k n i get vals i
    end
  end
end

fn tr_fill_masked_row mask view uint 512 n ulong k ulong mi ulong seq f64 hi f32 to void
  for i ulong n bound 64
    if ne get mask add mul i 8 mi 0
      put tr_tab add mul k n i f32 seq
    else
      put tr_tab add mul k n i f32 sub f64 hi seq
    end
  end
end

fn tr_fill_masked n ulong samples ulong mask_len ulong hi f32 to ulong
  mask = new uint 512 0
  for i ulong n bound 64
    for j ulong mask_len bound 8
      put mask add mul i 8 j uint and tr_rnd 1
    end
  end
  knots = add mul mul samples mask_len 10 1
  seq = 0.0f64
  for k ulong knots bound 4096
    sub_i = div k 10
    smp = div sub_i mask_len
    mi = rem sub_i mask_len
    if eq rem k mul 10 mask_len 0
      if lt smp samples
        seq = mul tr_runit f64 hi
      end
    end
    tr_fill_masked_row view mask n k mi seq hi
  end
  ret knots
end

note ================================================================
note Independent binary64 Dormand-Prince 5(4) oracle (res_oracle64.c)
note ================================================================

fn o64_lu_swap m ulong k ulong p ulong to void
  for j ulong m bound 64
    ik = add mul k 64 j
    ip = add mul p 64 j
    tk = get o64_lu ik
    tp = get o64_lu ip
    put o64_lu ik tp
    put o64_lu ip tk
  end
end

fn o64_lu_elim_row m ulong k ulong i ulong lik f64 to void
  j = add k 1
  while lt j m bound 64
    ukj = get o64_lu add mul k 64 j
    idx = add mul i 64 j
    put o64_lu idx sub get o64_lu idx mul lik ukj
    j = add j 1
  end
end

fn o64_lu_elim m ulong k ulong to void
  piv = get o64_lu add mul k 64 k
  i = add k 1
  while lt i m bound 64
    lik = div get o64_lu add mul i 64 k piv
    put o64_lu add mul i 64 k lik
    o64_lu_elim_row m k i lik
    i = add i 1
  end
end

fn o64_find_pivot m ulong k ulong to ulong
  p = k
  best = tr_abs64 get o64_lu add mul k 64 k
  i = add k 1
  while lt i m bound 64
    cand = tr_abs64 get o64_lu add mul i 64 k
    if gt cand best
      best = cand
      p = i
    end
    i = add i 1
  end
  ret p
end

fn o64_lu_factor to int
  m = get o64_m 0
  for k ulong m bound 64
    p = o64_find_pivot m k
    if eq get o64_lu add mul p 64 k 0.0f64
      ret -1
    end
    put o64_piv k p
    if ne p k
      o64_lu_swap m k p
    end
    o64_lu_elim m k
  end
  ret 0
end

fn o64_lu_fwd m ulong k ulong to void
  p = get o64_piv k
  if ne p k
    t = get o64_x k
    put o64_x k get o64_x p
    put o64_x p t
  end
  xk = get o64_x k
  i = add k 1
  while lt i m bound 64
    lik = get o64_lu add mul i 64 k
    put o64_x i sub get o64_x i mul lik xk
    i = add i 1
  end
end

fn o64_lu_bwd m ulong i ulong to void
  s = get o64_x i
  j = add i 1
  while lt j m bound 64
    uij = get o64_lu add mul i 64 j
    s = sub s mul uij get o64_x j
    j = add j 1
  end
  put o64_x i div s get o64_lu add mul i 64 i
end

fn o64_lu_solve to void
  m = get o64_m 0
  for k ulong m bound 64
    o64_lu_fwd m k
  end
  for step ulong m bound 64
    o64_lu_bwd m sub sub m 1 step
  end
end

fn o64_rhs_side o ulong dv f64 nk f64 to f64
  alpha = div get o64_par 2 mul get o64_tau0 o tr_exp64 div dv get o64_vtau o
  nss = mul mul get o64_par 3 tr_exp64 mul get o64_par 4 get o64_c o tr_exp64 div dv get o64_ve o
  ret mul mul alpha nk sub 1.0f64 tr_pow64 div nk nss get o64_par 1
end

fn o64_rhs_edge e ulong n ulong kbase ulong to void
  a = get o64_a e
  b = get o64_b e
  s0 = add n mul e 2
  dv = sub get o64_yt a get o64_yt b
  q = add get o64_yt s0 get o64_yt add s0 1
  q = mul mul get o64_par 0 q dv
  put o64_B a sub get o64_B a q
  put o64_B b add get o64_B b q
  q = o64_rhs_side a dv get o64_yt s0
  put o64_k add kbase s0 q
  q = o64_rhs_side b neg dv get o64_yt add s0 1
  put o64_k add kbase add s0 1 q
end

fn o64_rhs stage ulong to void
  n = get o64_n 0
  ne_c = get o64_ne 0
  kbase = mul stage 448
  for i ulong n bound 64
    put o64_B i get o64_cur i
  end
  for e ulong ne_c bound 192
    o64_rhs_edge e n kbase
  end
  m = get o64_m 0
  for u ulong m bound 64
    put o64_x u get o64_B get o64_unk_node u
  end
  o64_lu_solve
  for i ulong n bound 64
    ui = get o64_unk i
    if lt ui 0
      put o64_k add kbase i 0.0f64
    else
      put o64_k add kbase i get o64_x ulong ui
    end
  end
end

fn o64_stage_s st ulong j ulong to f64
  if eq st 1
    ret mul 0.2f64 get o64_k j
  end
  if eq st 2
    s = mul div 3.0f64 40.0f64 get o64_k j
    s = add s mul div 9.0f64 40.0f64 get o64_k add 448 j
    ret s
  end
  if eq st 3
    s = mul div 44.0f64 45.0f64 get o64_k j
    s = add s mul div -56.0f64 15.0f64 get o64_k add 448 j
    s = add s mul div 32.0f64 9.0f64 get o64_k add 896 j
    ret s
  end
  if eq st 4
    s = mul div 19372.0f64 6561.0f64 get o64_k j
    s = add s mul div -25360.0f64 2187.0f64 get o64_k add 448 j
    s = add s mul div 64448.0f64 6561.0f64 get o64_k add 896 j
    s = add s mul div -212.0f64 729.0f64 get o64_k add 1344 j
    ret s
  end
  if eq st 5
    s = mul div 9017.0f64 3168.0f64 get o64_k j
    s = add s mul div -355.0f64 33.0f64 get o64_k add 448 j
    s = add s mul div 46732.0f64 5247.0f64 get o64_k add 896 j
    s = add s mul div 49.0f64 176.0f64 get o64_k add 1344 j
    s = add s mul div -5103.0f64 18656.0f64 get o64_k add 1792 j
    ret s
  end
  if eq st 6
    s = mul div 35.0f64 384.0f64 get o64_k j
    s = add s mul div 500.0f64 1113.0f64 get o64_k add 896 j
    s = add s mul div 125.0f64 192.0f64 get o64_k add 1344 j
    s = add s mul div -2187.0f64 6784.0f64 get o64_k add 1792 j
    s = add s mul div 11.0f64 84.0f64 get o64_k add 2240 j
    ret s
  end
  ret 0.0f64
end

fn o64_stage_yt st ulong h f64 ny ulong to void
  for j ulong ny bound 448
    acc = add get o64_y j mul h o64_stage_s st j
    if eq st 6
      put o64_yn j acc
    end
    put o64_yt j acc
  end
end

fn o64_stage_c st ulong to f64
  if eq st 0
    ret 0.0f64
  end
  if eq st 1
    ret 0.2f64
  end
  if eq st 2
    ret 0.3f64
  end
  if eq st 3
    ret 0.8f64
  end
  if eq st 4
    ret div 8.0f64 9.0f64
  end
  ret 1.0f64
end

fn o64_err_one h f64 j ulong rtol f64 atol f64 to f64
  ej = mul sub div 35.0f64 384.0f64 div 5179.0f64 57600.0f64 get o64_k j
  ej = add ej mul sub div 500.0f64 1113.0f64 div 7571.0f64 16695.0f64 get o64_k add 896 j
  ej = add ej mul sub div 125.0f64 192.0f64 div 393.0f64 640.0f64 get o64_k add 1344 j
  ej = add ej mul add div -2187.0f64 6784.0f64 div 92097.0f64 339200.0f64 get o64_k add 1792 j
  ej = add ej mul sub div 11.0f64 84.0f64 div 187.0f64 2100.0f64 get o64_k add 2240 j
  ej = add ej mul -0.025f64 get o64_k add 2688 j
  ej = mul h ej
  ynj = get o64_yn j
  if not res_fin64 bitcast ulong ynj
    ret bitcast f64 ulong 0x7ff0000000000000
  end
  if ge j get o64_n 0
    if le ynj 0.0f64
      ret bitcast f64 ulong 0x7ff0000000000000
    end
  end
  sc = add atol mul rtol tr_max64 tr_abs64 get o64_y j tr_abs64 ynj
  ret div tr_abs64 ej sc
end

fn o64_err_norm h f64 ny ulong rtol f64 atol f64 to f64
  err = 0.0f64
  for j ulong ny bound 448
    r = o64_err_one h j rtol atol
    if not res_fin64 bitcast ulong r
      ret bitcast f64 ulong 0x7ff0000000000000
    end
    if gt r err
      err = r
    end
  end
  ret err
end

fn o64_fill_lu ne_c ulong cap f64 to void
  for e ulong ne_c bound 192
    ua = get o64_unk get o64_a e
    ub = get o64_unk get o64_b e
    if ge ua 0
      idx = add mul ulong ua 64 ulong ua
      put o64_lu idx add get o64_lu idx cap
    end
    if ge ub 0
      idx = add mul ulong ub 64 ulong ub
      put o64_lu idx add get o64_lu idx cap
    end
    if and ge ua 0 ge ub 0
      i1 = add mul ulong ua 64 ulong ub
      i2 = add mul ulong ub 64 ulong ua
      put o64_lu i1 sub get o64_lu i1 cap
      put o64_lu i2 sub get o64_lu i2 cap
    end
  end
end

fn o64_setup t view uint 514 p view uint 265 to int
  n = ulong get t 0
  ne_c = ulong get t 1
  put o64_n 0 n
  put o64_ne 0 ne_c
  for e ulong ne_c bound 192
    put o64_a e ulong get t add RES_TOPO_EDGES mul e 2
    put o64_b e ulong get t add RES_TOPO_EDGES add mul e 2 1
  end
  put o64_par 0 mul f64 bitcast f32 get p 4 f64 bitcast f32 get p 3
  put o64_par 1 f64 bitcast f32 get p 5
  put o64_par 2 f64 bitcast f32 get p 6
  put o64_par 3 f64 bitcast f32 get p 7
  put o64_par 4 f64 bitcast f32 get p 8
  m = ulong 0
  for i ulong n bound 64
    put o64_c i f64 bitcast f32 get p add RES_PAR_CONC i
    put o64_tau0 i f64 bitcast f32 get p add RES_PAR_TAU0 i
    put o64_vtau i f64 bitcast f32 get p add RES_PAR_VTAU i
    put o64_ve i f64 bitcast f32 get p add RES_PAR_VE i
    put o64_unk i -1
    if eq get t add RES_TOPO_GND i 0
      put o64_unk i long m
      put o64_unk_node m i
      m = add m 1
    end
  end
  put o64_m 0 m
  for i ulong 4096 bound 4096
    put o64_lu i 0.0f64
  end
  cap = div mul f64 bitcast f32 get p 1 f64 bitcast f32 get p 3 f64 bitcast f32 get p 2
  o64_fill_lu ne_c cap
  ret o64_lu_factor
end

fn o64_interp_cur b0 ulong n ulong f f64 to void
  for i ulong n bound 64
    v0 = f64 get tr_tab add b0 i
    v1 = f64 get tr_tab add add b0 n i
    put o64_cur i add v0 mul f sub v1 v0
  end
end

fn o64_run_stages b0 ulong t f64 h f64 dt_s f64 to void
  n = get o64_n 0
  ny = add n mul get o64_ne 0 2
  for st ulong 7 bound 7
    o64_stage_yt st h ny
    f = div add t mul o64_stage_c st h dt_s
    o64_interp_cur b0 n f
    o64_rhs st
  end
end

fn o64_accept_y ny ulong to void
  for j ulong ny bound 448
    put o64_y j get o64_yn j
  end
end

fn o64_next_h h f64 err f64 accepted bool to f64
  if accepted
    ec = tr_max64 err 1.0e-30f64
    fac = tr_min64 5.0f64 tr_max64 0.2f64 mul 0.9f64 tr_pow64 ec -0.2f64
    ret mul h fac
  end
  if res_fin64 bitcast ulong err
    fac = tr_max64 0.1f64 mul 0.9f64 tr_pow64 err -0.2f64
    ret mul h fac
  end
  ret mul h 0.1f64
end

fn o64_run_knot kn ulong dt_s f64 rtol f64 atol f64 h_io edit f64 1 to int
  n = get o64_n 0
  ny = add n mul get o64_ne 0 2
  t = 0.0f64
  h = get h_io 0
  b0 = mul kn n
  while lt t dt_s bound 100000
    if gt h sub dt_s t
      h = sub dt_s t
    end
    if lt h 1.0e-18f64
      ret -1
    end
    o64_run_stages b0 t h dt_s
    err = o64_err_norm h ny rtol atol
    if le err 1.0f64
      o64_accept_y ny
      t = add t h
      h = o64_next_h h err true
    else
      h = o64_next_h h err false
    end
  end
  put h_io 0 h
  ret 0
end

fn o64_store_v base ulong n ulong which_out uint to void
  for i ulong n bound 64
    if eq which_out 0
      put tr_vtight add base i get o64_y i
    else
      put tr_vref add base i get o64_y i
    end
  end
end

fn o64_init_y which_out uint to void
  n = get o64_n 0
  ne_c = get o64_ne 0
  for i ulong n bound 64
    put o64_y i 0.0f64
  end
  o64_store_v 0 n which_out
  for s ulong mul ne_c 2 bound 384
    put o64_y add n s get o64_ninit s
  end
end

fn o64_check_fin to int
  ny = add get o64_n 0 mul get o64_ne 0 2
  for j ulong ny bound 448
    if not res_fin64 bitcast ulong get o64_y j
      ret -1
    end
  end
  ret 0
end

note which_out: 0 -> tr_vtight, 1 -> tr_vref
fn o64_run t view uint 514 p view uint 265 knots ulong rtol f64 atol f64 which_out uint to int
  if ne o64_setup t p 0
    ret -1
  end
  o64_init_y which_out
  h_io = new f64 1 1.0e-4f64
  for kn ulong sub knots 1 bound 4096
    if ne o64_run_knot kn 1.0e-4f64 rtol atol h_io 0
      ret -1
    end
    o64_store_v mul add kn 1 get o64_n 0 get o64_n 0 which_out
  end
  ret o64_check_fin
end


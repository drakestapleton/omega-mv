text tr_hdr "test_reservoir: "
text tr_chks " checks, "
text tr_fld " failed\n"
text tr_pass "test_reservoir: PASS\n"
text tr_fail "test_reservoir: FAIL\n"
text tr_fail_pfx "FAIL test_reservoir check #"
text tr_nl "\n"
text tr_orc_ok "oracle scenario OK\n"


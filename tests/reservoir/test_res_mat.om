note Pure seeded OM-2 Gate 2 tests for res_inflate.om and res_mat.om.
note Replaces tests/reservoir/test_res_mat.c.
note Concatenated after src/reservoir/reservoir.om, tools/reservoir/res_inflate.om, tools/reservoir/res_mat.om.

text t_fix5 "tests/reservoir/fixtures/Length5.mat"
text t_fix50 "tests/reservoir/fixtures/Length50.mat"
text t_absent "tests/reservoir/fixtures/absent.mat"
text t_wiki "Wikipedia"
text t_conmat "conmat"
text t_ground "ground"
text t_inex "inex"
text t_nosuch "no_such_variable"
text t_hdr "test_res_mat: "
text t_chks " checks, "
text t_fld " failed\n"
text t_fail_pfx "FAIL test_res_mat check #"
text t_nl "\n"

global tm_checks ulong 1
global tm_fail ulong 1
global tm_f ulong 98
global tm_g ulong 98
global tm_file_bytes uchar 4096
global tm_edges ulong 128

fn tm_write_str s view uchar * to void
  _w = write 1 s 0 len s
end

fn tm_write_u64 v ulong to void
  buf = new uchar 24 0
  if eq v 0
    put buf 0 uchar 48
    _w = write 1 buf 0 1
    ret
  end
  x = v
  n = ulong 0
  while gt x 0 bound 24
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 24 0
  for i ulong n bound 24
    put rev i get buf sub sub n 1 i
  end
  _w = write 1 rev 0 n
end

fn tm_check ok bool to void
  c = add get tm_checks 0 1
  put tm_checks 0 c
  if not ok
    put tm_fail 0 add get tm_fail 0 1
    _w1 = write 2 t_fail_pfx 0 len t_fail_pfx
    tm_write_u64 c
    _w2 = write 2 t_nl 0 1
  end
end


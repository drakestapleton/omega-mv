  put dst 17 0xb7
  put dst 18 0xfd
  put dst 19 0x59
  put dst 20 0xfe
  put dst 21 0x61
  put dst 22 0xd0
  put dst 23 0xb7
  put dst 24 0x63
  put dst 25 0x2e
  put dst 26 0xe4
  put dst 27 0x67
  put dst 28 0xa8
  put dst 29 0xc2
  put dst 30 0xaa
  put dst 31 0xe3
end

fn tm_inf_out_eq_wiki to bool
  if ne get inf_out_len 0 9
    ret false
  end
  for i ulong 9 bound 9
    if ne get inf_out i get t_wiki i
      ret false
    end
  end
  ret true
end

fn tm_test_inflate_basic to void
  tm_check eq res_adler32 t_wiki 0 9 0x11e60398
  tm_check eq res_adler32 t_wiki 0 0 1
  st = new uchar 20 0
  put st 0 0x78
  put st 1 0x01
  put st 2 0x01
  put st 3 0x09
  put st 4 0x00
  put st 5 0xf6
  put st 6 0xff
  for i ulong 9 bound 9
    put st add 7 i get t_wiki i
  end
  put st 16 0x11
  put st 17 0xe6
  put st 18 0x03
  put st 19 0x98
  tm_check eq res_zlib_inflate view st 0 20 RES_INF_OK
  tm_check and tm_inf_out_eq_wiki eq get inf_consumed 0 20
  put st 5 xor get st 5 1
  tm_check eq res_zlib_inflate view st 0 20 RES_INF_ERR_BLOCK
end

fn tm_test_inflate_fixed to void
  fx = new uchar 17 0
  put fx 0 0x78
  put fx 1 0x9c
  put fx 2 0x0b
  put fx 3 0xcf
  put fx 4 0xcc
  put fx 5 0xce
  put fx 6 0x2c
  put fx 7 0x48
  put fx 8 0x4d
  put fx 9 0xc9
  put fx 10 0x4c
  put fx 11 0x04
  put fx 12 0x00
  put fx 13 0x11
  put fx 14 0xe6
  put fx 15 0x03
  put fx 16 0x98
  tm_check eq res_zlib_inflate view fx 0 17 RES_INF_OK
  tm_check and tm_inf_out_eq_wiki eq get inf_consumed 0 17
  for cut ulong 17 bound 17
    tm_check ne res_zlib_inflate view fx 0 cut RES_INF_OK
  end
  put fx 16 xor get fx 16 1
  tm_check eq res_zlib_inflate view fx 0 17 RES_INF_ERR_ADLER
end

fn tm_test_inflate_refusals to void
  hc = new uchar 11 0
  put hc 0 0x78
  put hc 1 0x00
  put hc 2 0x01
  put hc 5 0xff
  put hc 6 0xff
  put hc 10 0x01
  tm_check eq res_zlib_inflate view hc 0 11 RES_INF_ERR_HEADER
  dc = new uchar 15 0
  put dc 0 0x78
  put dc 1 0xbb
  put dc 5 0x01
  put dc 6 0x01
  put dc 9 0xff
  put dc 10 0xff
  put dc 14 0x01
  tm_check eq res_zlib_inflate view dc 0 15 RES_INF_ERR_HEADER
  rs = new uchar 7 0
  put rs 0 0x78
  put rs 1 0x01
  put rs 2 0x07
  put rs 6 0x01
  tm_check eq res_zlib_inflate view rs 0 7 RES_INF_ERR_BLOCK
end

fn tm_chain_edges roff ulong l ulong to long
  m = ulong 0
  for j ulong l bound 64
    for i ulong l bound 64
      v1 = get mat_re add roff add i mul l j
      v2 = get mat_re add roff add j mul l i
      if ne v1 v2
        ret -1
      end
      if and lt i j ne v1 0.0f64
        if or ne v1 1.0f64 ge m 64
          ret -1
        end
        put tm_edges mul m 2 add i 1
        put tm_edges add mul m 2 1 add j 1
        m = add m 1
      end
    end
  end
  ret long m
end


fn tm_test_mat_5 to void
  sha5 = new uchar 32 0
  sha50 = new uchar 32 0
  tm_init_sha5 sha5
  tm_init_sha50 sha50
  mf = new ulong 98 0
  off = new ulong 1 0
  res_mat_reset_pool
  tm_check eq res_mat_load t_fix5 view sha5 true mf RES_MAT_OK
  tm_check eq res_mat_values res_mat_find view mf t_conmat 25 off RES_MAT_OK
  cm_off = get off 0
  tm_check eq res_mat_values res_mat_find view mf t_ground 1 off RES_MAT_OK
  tm_check eq get mat_re get off 0 5.0f64
  tm_check eq res_mat_values res_mat_find view mf t_inex 25 off RES_MAT_OK
  ix_off = get off 0
  all1 = true
  for k ulong 25 bound 25
    if ne get mat_re add ix_off k 1.0f64
      all1 = false
    end
  end
  tm_check all1
  tm_check eq tm_chain_edges cm_off 5 4
  for k ulong 4 bound 4
    e0 = get tm_edges mul k 2
    e1 = get tm_edges add mul k 2 1
    tm_check and eq e0 add k 1 eq e1 add k 2
  end
  tm_check eq res_mat_find view mf t_nosuch -1
  res_mat_reset_pool
  tm_check eq res_mat_load t_fix5 view sha50 true mf RES_MAT_ERR_DIGEST
  tm_check eq res_mat_load t_absent view sha5 false mf RES_MAT_ERR_IO
end

fn tm_check_chain50_edges to bool
  ea = new ulong 1 0
  eb = new ulong 1 0
  for k ulong 49 bound 49
    tm_chain50_edge k ea eb
    ga = get tm_edges mul k 2
    gb = get tm_edges add mul k 2 1
    ok = false
    if and eq ga get ea 0 eq gb get eb 0
      ok = true
    end
    if and eq ga get eb 0 eq gb get ea 0
      ok = true
    end
    if not ok
      ret false
    end
  end
  ret true
end

fn tm_test_mat_50 to void
  sha50 = new uchar 32 0
  tm_init_sha50 sha50
  mf = new ulong 98 0
  off = new ulong 1 0
  res_mat_reset_pool
  tm_check eq res_mat_load t_fix50 view sha50 true mf RES_MAT_OK
  tm_check eq res_mat_values res_mat_find view mf t_conmat 2500 off RES_MAT_OK
  cm_off = get off 0
  tm_check eq res_mat_values res_mat_find view mf t_ground 1 off RES_MAT_OK
  tm_check eq get mat_re get off 0 50.0f64
  m = tm_chain_edges cm_off 50
  tm_check eq m 49
  tm_check tm_check_chain50_edges
end

fn tm_test_mat to void
  tm_test_mat_5
  tm_test_mat_50
end

fn tm_same_re mba ulong mbb ulong to bool
  oa = get mat_meta add mba 6
  ob = get mat_meta add mbb 6
  n = get mat_meta add mba 5
  for i ulong n bound 10000
    va = bitcast ulong get mat_re add oa i
    vb = bitcast ulong get mat_re add ob i
    if ne va vb
      ret false
    end
  end
  ret true
end

fn tm_same_vals mf_a view ulong 98 mf_b view ulong 98 name view uchar * to bool
  ax = res_mat_find mf_a name
  ay = res_mat_find mf_b name
  if or lt ax 0 lt ay 0
    ret eq ax ay
  end
  mba = mul ulong ax RES_MAT_META_STRIDE
  mbb = mul ulong ay RES_MAT_META_STRIDE
  if ne get mat_meta add mba 5 get mat_meta add mbb 5
    ret false
  end
  if ne get mat_meta mba get mat_meta mbb
    ret false
  end
  ret tm_same_re mba mbb
end

fn tm_check_one_flip buf edit uchar 4096 off ulong bit ulong mf view ulong 98 marks view ulong 2 to int
  orig = get buf off
  put buf off xor orig shl uchar 1 uchar bit
  put mat_re_used 0 get marks 0
  put mat_meta_used 0 get marks 1
  mg = new ulong 98 0
  s = res_mat_parse view buf 2130 mg
  put buf off orig
  if ne s RES_MAT_OK
    ret 1
  end
  ok1 = eq get mg 1 get mf 1
  ok2 = tm_same_vals mf view mg t_conmat
  ok3 = tm_same_vals mf view mg t_ground
  ok4 = tm_same_vals mf view mg t_inex
  if not and and ok1 ok2 and ok3 ok4
    ret -1
  end
  ret 0
end

fn tm_corrupt_flips buf edit uchar 4096 n ulong mf view ulong 98 marks view ulong 2 to void
  silent = ulong 0
  refused = ulong 0
  for off ulong n bound 2130
    r0 = tm_check_one_flip buf off 0 mf marks
    if eq r0 1
      refused = add refused 1
    end
    if eq r0 -1
      silent = add silent 1
    end
    r3 = tm_check_one_flip buf off 3 mf marks
    if eq r3 1
      refused = add refused 1
    end
    if eq r3 -1
      silent = add silent 1
    end
    r6 = tm_check_one_flip buf off 6 mf marks
    if eq r6 1
      refused = add refused 1
    end
    if eq r6 -1
      silent = add silent 1
    end
  end
  tm_check eq silent 0
  tm_check gt refused 0
end

fn tm_corrupt_cuts buf view uchar 4096 n ulong mf view ulong 98 marks view ulong 2 to void
  mg = new ulong 98 0
  full = get mf 1
  cut_bad = ulong 0
  for cut ulong n bound 2130
    put mat_re_used 0 get marks 0
    put mat_meta_used 0 get marks 1
    s = res_mat_parse buf cut mg
    if eq s RES_MAT_OK
      if ge get mg 1 full
        cut_bad = add cut_bad 1
      end
      if ge res_mat_find view mg t_conmat 0
        if not tm_same_vals mf view mg t_conmat
          cut_bad = add cut_bad 1
        end
      end
    end
  end
  tm_check eq cut_bad 0
end

fn tm_test_corruption to void
  fd = fopen t_fix5 0 len t_fix5 0 0
  tm_check ge fd 0
  if lt fd 0
    ret
  end
  buf = new uchar 4096 0
  nr = read int fd buf 0 4096
  _fc = fclose int fd
  tm_check eq nr 2130
  if ne nr 2130
    ret
  end
  n = ulong 2130
  res_mat_reset_pool
  mf = new ulong 98 0
  tm_check eq res_mat_parse view buf n mf RES_MAT_OK
  marks = new ulong 2 0
  put marks 0 get mat_re_used 0
  put marks 1 get mat_meta_used 0
  tm_corrupt_flips buf n view mf view marks
  tm_corrupt_cuts view buf n view mf view marks
end

fn main to int
  tm_test_inflate_basic
  tm_test_inflate_fixed
  tm_test_inflate_refusals
  tm_test_mat
  tm_test_corruption
  tm_write_str t_hdr
  tm_write_u64 get tm_checks 0
  tm_write_str t_chks
  tm_write_u64 get tm_fail 0
  tm_write_str t_fld
  if ne get tm_fail 0 0
    ret 1
  end
  ret 0
end

  put dst 12 0x84
  put dst 13 0x3e
  put dst 14 0x9f
  put dst 15 0x70
  put dst 16 0x56
  put dst 17 0x16
  put dst 18 0xdf
  put dst 19 0x47
  put dst 20 0x51
  put dst 21 0x18
  put dst 22 0x79
  put dst 23 0xba
  put dst 24 0x0b
  put dst 25 0xbe
  put dst 26 0xce
  put dst 27 0xb2
  put dst 28 0x41
  put dst 29 0xb9
  put dst 30 0xb5
  put dst 31 0x0a
end

fn tm_init_sha50 dst edit uchar 32 to void
  put dst 0 0xff
  put dst 1 0x4c
  put dst 2 0x9d
  put dst 3 0x14
  put dst 4 0xab
  put dst 5 0xb6
  put dst 6 0xf6
  put dst 7 0x4b
  put dst 8 0x1a
  put dst 9 0xb9
  put dst 10 0xf3
  put dst 11 0x01
  put dst 12 0x07
  put dst 13 0x2d
  put dst 14 0xc6
  put dst 15 0x73

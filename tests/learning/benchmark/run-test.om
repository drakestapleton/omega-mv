note Native executor acceptance. Compose core.om, run.om, this file. Real child processes only.
note argv: 1 oracle, 2 observable, 3 saturating, 4 empty, 5 spin, 6 trap-div, 7 flood,
note 8 missing path, 9 escape, 10 c256, 11 split, 12 stdin, 13 non-executable file, 14 directory.
note Expected bytes come from the independent L776 oracle process.
global Checks ulong 1
global Got ulong 16
global Want ulong 16
global Cost ulong 16
text Good "BENCHMARK_RUN_PASS\n"

fn check actual ulong expected ulong to void
put Checks 0 add get Checks 0 1
if ne actual expected
exit int add get Checks 0 40
end
end

note One observation row per candidate: argv index, status, code, bytes, elapsed ns, result.
global Row uchar 21
fn pnum v ulong to void
x = v
for i ulong 20
put Row sub 19 i uchar add 48 sub x mul div x 10 10
x = div x 10
end
put Row 20 32
w = write 1 Row 0 21
end

fn prow idx ulong res ulong to void
pnum idx
for k ulong 4
pnum get RObs k
end
pnum res
put Row 0 10
w = write 1 Row 0 1
end

note Public train/dev records, one per candidate; same layout as the component fixture.
fn tasks n ulong to void
for i ulong 2048
put LT i 0
end
for i ulong n
a = mul i 32
put LT a add i 1
put LT add a 1 add and i 1 1
put LT add a 2 1
put LT add a 3 add i 1
put LT add a 4 1
put LT add a 5 1
put LT add a 6 776
put LT add a 7 add i 1
for j ulong 20
put LT add a add j 8 add add mul i 100 j 1
end
put LT add a 28 128
put LT add a 29 128
put LT add a 30 1000
end
note Synthetic equal identities: identity measurement is outside this executor.
for i ulong 4
put LPin i add i 1
put LPin add i 4 add i 1
put LPin add i 8 add i 5
put LPin add i 12 add i 5
end
end

note Measured judge wall time; peak is the execpure address-space ceiling; energy unknown.
fn costs ns ulong to void
for i ulong 9
put LC i 0
end
put LC 2 div ns 1000
put LC 6 134217728
end

fn main to int
limit = ulong 500000000
check rlaunch 1 limit 0
check get RObs 1 0
check get RObs 2 128
rkeep 0
put Want 0 0
put Want 1 7
put Want 2 9
put Want 3 4
put Want 4 8
put Want 5 5
put Want 6 6
put Want 7 9
put Want 8 7
put Want 9 0
put Want 10 9
put Want 11 6
put Want 12 6
for i ulong 13
s = rlaunch add i 2 limit
rkeep 1
res = lobserve get RObs 0 0 get RObs 1 128 get RObs 2
put Got i res
prow add i 2 res
put Cost i get RObs 3
end
for i ulong 13
check get Got i get Want i
end
note Timeout is charged more than the deadline, and the kill ends it well before the
note one-second CPU limit of the strict profile (an unkilled spin is reaped only by SIGXCPU).
put Checks 0 add get Checks 0 1
if le get Cost 3 limit
exit int add get Checks 0 40
end
put Checks 0 add get Checks 0 1
if ge get Cost 3 900000000
exit int add get Checks 0 40
end
note With a 3 s deadline the same spin is ended by the profile's CPU limit: a signal, resource 5.
u = rlaunch 5 3000000000
res = lobserve get RObs 0 0 get RObs 1 128 get RObs 2
prow 5 res
check res 5
tasks 13
check lbegin 13 1 1000000000 0
for i ulong 13
costs get Cost i
check lattempt i 1 get Got i 0
end
check lfinish 0
check get LS 3 13
check get LS 4 2
check get LS 5 2
check get LS 16 13
note A partial run (one task never attempted) cannot finish successfully.
tasks 13
check lbegin 13 1 1000000000 0
for i ulong 12
costs get Cost i
check lattempt i 1 get Got i 0
end
check lfinish 30
check get LS 18 0
s = write 1 Good 0 len Good
ret 0
end

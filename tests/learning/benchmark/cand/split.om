note Correct 128 bytes (the L776 oracle literals) written in two 64-byte writes about
note ten milliseconds apart: the executor must assemble both reads (result 0).
global out uchar 128

fn emit idx ulong value ulong to void
for k ulong 8
put out add mul idx 8 k uchar and shr value mul k 8 255
end
end

fn main to int
emit 0 42
emit 1 42
emit 2 42
emit 3 42
emit 4 0
emit 5 18446744073709551615
emit 6 18446744073709551614
emit 7 6148914691236517205
emit 8 2
emit 9 14
emit 10 2
emit 11 2
emit 12 20
emit 13 20
emit 14 42
emit 15 42
n = write 1 out 0 64
if ne n long 64
ret 81
end
x = ulong 0
for i ulong 10000000
x = add x i
end
n = write 1 out 64 64
if ne n long 64
ret 81
end
ret int and x 0
end

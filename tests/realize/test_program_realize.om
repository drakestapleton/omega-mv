note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/realize/test_program_realize.c.
note Composes seed/ng/sha256.om, om/aarch64/aarch64_om2.om, src/omega_realize.om, src/omega_exec.om.
note Four gates:
note   OMEGA_PROGRAM_REALIZE_PASS
note   OMEGA_REALIZATION_PROGRAM_DRIVEN_PASS
note   OMEGA_REALIZATION_DIFFERENTIAL_PASS
note   OMEGA_REALIZATION_TRIPLE_BIND_PASS
om2

text pr_g1_p "GATE OMEGA_PROGRAM_REALIZE_PASS PASS\n"
text pr_g2_p "GATE OMEGA_REALIZATION_PROGRAM_DRIVEN_PASS PASS\n"
text pr_g3_p "GATE OMEGA_REALIZATION_DIFFERENTIAL_PASS PASS\n"
text pr_g4_p "GATE OMEGA_REALIZATION_TRIPLE_BIND_PASS PASS\n"
text pr_fail "PROGRAM_REALIZE: FAIL\n"

global g_pr_fail ulong 4
global g_pr_rng ulong 1

fn pr_chk gate ulong cond bool to void
  if not cond
    put g_pr_fail gate add get g_pr_fail gate 1
  end
end

fn pr_rnd to ulong
  x = get g_pr_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_pr_rng 0 x
  ret mul x ulong 0x2545f4914f6cdd1d
end

fn pr_copy_code dst edit uchar * n ulong to void
  for i ulong n bound 256
    put dst i get g_real_code i
  end
end

fn pr_copy_id dst edit uchar 32 to void
  for i ulong 32
    put dst i get g_real_id i
  end
end

fn pr_ids_eq a view uchar 32 b view uchar 32 to bool
  for i ulong 32
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn pr_gate1_realize to void
  sem = new uchar 32 0
  for i ulong 32
    put sem i uchar add i 1
  end
  code = new uchar 256 0
  msg = new uchar 128 0

  pr_chk 0 eq omega_realize_f_add_sub sem 0
  pr_chk 0 eq get g_real_has_id 0 1
  pr_chk 0 eq get g_real_code_len 0 12
  pr_copy_code code 12
  pr_chk 0 eq a64validate code 12 msg 128 0

  pr_chk 0 eq omega_realize_pure_binary REAL_OP_ADD sem 0
  pr_chk 0 eq get g_real_code_len 0 8
  pr_copy_code code 8
  pr_chk 0 eq a64validate code 8 msg 128 0

  pr_chk 0 eq omega_realize_pure_binary REAL_OP_SUB sem 0
  pr_chk 0 eq omega_realize_pure_binary REAL_OP_MUL sem 0
  pr_chk 0 eq omega_realize_pure_binary REAL_OP_AND sem 0
  pr_chk 0 eq omega_realize_pure_binary REAL_OP_OR sem 0

  note Fail closed on unsupported opcodes
  pr_chk 0 eq omega_realize_pure_binary 0 sem -1
  pr_chk 0 eq omega_realize_pure_binary 99 sem -1
  pr_chk 0 eq omega_realize_pure_binary 255 sem -1

  note Structural validator rejects empty code
  pr_chk 0 ne a64validate code 0 msg 128 0
end

fn pr_rd32_0 to ulong
  b0 = ulong get g_real_code 0
  b1 = ulong get g_real_code 1
  b2 = ulong get g_real_code 2
  b3 = ulong get g_real_code 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn pr_gate2_driven to void
  sem1 = new uchar 32 0
  sem2 = new uchar 32 0
  for i ulong 32
    put sem1 i uchar add i 1
    put sem2 i uchar add i 2
  end
  id_add = new uchar 32 0
  id_sub = new uchar 32 0
  id_cur = new uchar 32 0

  pr_chk 1 eq omega_realize_pure_binary REAL_OP_ADD sem1 0
  pr_copy_id id_add
  w_add = pr_rd32_0

  pr_chk 1 eq omega_realize_pure_binary REAL_OP_SUB sem1 0
  pr_copy_id id_sub
  w_sub = pr_rd32_0

  pr_chk 1 ne w_add w_sub
  pr_chk 1 not pr_ids_eq id_add id_sub

  pr_chk 1 eq omega_realize_pure_binary REAL_OP_MUL sem1 0
  pr_copy_id id_cur
  pr_chk 1 not pr_ids_eq id_add id_cur
  pr_chk 1 not pr_ids_eq id_sub id_cur

  pr_chk 1 eq omega_realize_pure_binary REAL_OP_ADD sem2 0
  pr_copy_id id_cur
  pr_chk 1 not pr_ids_eq id_add id_cur

  note Decoder lifts generated AArch64 words
  dec = new ulong 9 0
  pr_chk 1 eq a64decode w_add dec 0
  pr_chk 1 eq a64decode w_sub dec 0
end

fn pr_eval_bin op ulong a ulong b ulong to ulong
  if eq op REAL_OP_ADD
    ret add a b
  end
  if eq op REAL_OP_SUB
    ret sub a b
  end
  if eq op REAL_OP_MUL
    ret mul a b
  end
  if eq op REAL_OP_AND
    ret and a b
  end
  ret or a b
end

fn pr_diff_one_op op ulong sem view uchar 32 to void
  code = new uchar 16 0
  pr_chk 2 eq omega_realize_pure_binary op sem 0
  pr_copy_code code 8
  for k ulong 16
    a = pr_rnd
    b = pr_rnd
    if eq k 0
      a = 0
      b = 0
    end
    if eq k 1
      a = ulong 0xffffffffffffffff
      b = 1
    end
    if eq k 2
      a = ulong 0x8000000000000000
      b = ulong 0x7fffffffffffffff
    end
    pr_chk 2 eq omega_exec_native_f3 code 8 a b 0 0
    pr_chk 2 eq get g_ex_res 0 pr_eval_bin op a b
  end
end

fn pr_gate3_differential to void
  put g_pr_rng 0 ulong 0x0123456789abcdef
  omega_exec_native_cache_reset
  sem = new uchar 32 0
  for i ulong 32
    put sem i uchar add i 11
  end

  note f_add_sub differential: a + b - c
  code = new uchar 16 0
  pr_chk 2 eq omega_realize_f_add_sub sem 0
  pr_copy_code code 12
  for k ulong 16
    a = pr_rnd
    b = pr_rnd
    c = pr_rnd
    pr_chk 2 eq omega_exec_native_f3 code 12 a b c 0
    pr_chk 2 eq get g_ex_res 0 sub add a b c
  end

  pr_diff_one_op REAL_OP_ADD sem
  pr_diff_one_op REAL_OP_SUB sem
  pr_diff_one_op REAL_OP_MUL sem
  pr_diff_one_op REAL_OP_AND sem
  pr_diff_one_op REAL_OP_OR sem
end

fn pr_gate4_triple_bind to void
  sem = new uchar 32 0
  for i ulong 32
    put sem i uchar add i 3
  end
  id0 = new uchar 32 0
  id_t = new uchar 32 0

  pr_chk 3 eq omega_realize_f_add_sub sem 0
  pr_copy_id id0

  note 1. Tampering code byte changes realization id
  orig_b = get g_real_code 0
  put g_real_code 0 xor orig_b uchar 1
  pr_chk 3 eq omega_compute_realization_id 0
  pr_copy_id id_t
  pr_chk 3 not pr_ids_eq id0 id_t
  put g_real_code 0 orig_b

  note 2. Tampering semantic_id changes realization id
  orig_s = get g_real_sem_id 0
  put g_real_sem_id 0 xor orig_s uchar 1
  pr_chk 3 eq omega_compute_realization_id 0
  pr_copy_id id_t
  pr_chk 3 not pr_ids_eq id0 id_t
  put g_real_sem_id 0 orig_s

  note 3. Tampering machine profile changes realization id
  orig_p = get g_real_profile 0
  put g_real_profile 0 add orig_p 1
  pr_chk 3 eq omega_compute_realization_id 0
  pr_copy_id id_t
  pr_chk 3 not pr_ids_eq id0 id_t
  put g_real_profile 0 orig_p

  note 4. Restoring all three reproduces original realization id
  pr_chk 3 eq omega_compute_realization_id 0
  pr_copy_id id_t
  pr_chk 3 pr_ids_eq id0 id_t
end

fn main to int
  for g ulong 4
    put g_pr_fail g 0
  end
  pr_gate1_realize
  pr_gate2_driven
  pr_gate3_differential
  pr_gate4_triple_bind
  tot = add add get g_pr_fail 0 get g_pr_fail 1 add get g_pr_fail 2 get g_pr_fail 3
  if eq tot 0
    ign = write 1 pr_g1_p 0 len pr_g1_p
    ign = write 1 pr_g2_p 0 len pr_g2_p
    ign = write 1 pr_g3_p 0 len pr_g3_p
    ign = write 1 pr_g4_p 0 len pr_g4_p
    ret 0
  end
  ign = write 1 pr_fail 0 len pr_fail
  ret 1
end

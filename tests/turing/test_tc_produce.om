note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note tests/turing/test_tc_produce.om: EXP-001 producer test in pure seeded OM-2.
note Ports 100% of tests/turing/test_tc_produce.c (60 checks).
note Composed after seed/ng/sha256.om, tc_pstream.om, tc_range_lib.om, tc_rans.om, tc_produce.om.

text TTP_FIX0 "tests/turing/fixtures/ctr1_seed1_crumbs05-07.ctr"
text TTP_FIX1 "tests/turing/fixtures/ctr1_seed1_crumbs10-12.ctr"
text TTP_MOD0 "evidence/TURING_YIELD/ty2_baseline.tym"
text TTP_MOD1 "evidence/TURING_YIELD/ty2_candidate.tym"
text TTP_DIG0 "59ae9398da24e809d92ab39e7456382a0a4b7e93e203862be6d2ca55450dfd04"
text TTP_DIG1 "64a57ba9cf6f8b6e4558751ef2145ae2aa729c5214bfa29373eabfa220a57bc7"
text TTP_DET_EXT ".det"
text TTP_S_FIX "fixture="
text TTP_S_MOD " model="
text TTP_S_N " n="
text TTP_S_TPS " tps1="
text TTP_S_UB " ideal_ub="
text TTP_S_COD " coder="
text TTP_S_BYT " bytes="
text TTP_S_HDR "test_tc_produce: "
text TTP_S_PAS " passed, "
text TTP_S_FAI " failed\n"
text TTP_S_F "FAIL: "

global ttp_pass ulong 1
global ttp_fail ulong 1
global ttp_det_fd int 1
global ttp_arg uchar 1024

fn ttp_chk cond bool msg view uchar * to void
if cond
put ttp_pass 0 add get ttp_pass 0 1
ret
end
put ttp_fail 0 add get ttp_fail 0 1
tc_out_reset
tc_out_str TTP_S_F
tc_out_str msg
tc_out_byte 10
z = tc_out_flush 1
end

fn ttp_load_fix f ulong to int
if eq f 0
rc = tp_ctr1_read TTP_FIX0 0 len TTP_FIX0
if ne rc TC_OK
ret rc
end
ret tc_file_sha256 TTP_FIX0 0 len TTP_FIX0
end
rc = tp_ctr1_read TTP_FIX1 0 len TTP_FIX1
if ne rc TC_OK
ret rc
end
ret tc_file_sha256 TTP_FIX1 0 len TTP_FIX1
end

fn ttp_check_mdig mi ulong to bool
if eq mi 0
if ne tc_unhex_to_exp TTP_DIG0 0 len TTP_DIG0 1 TC_OK
ret false
end
else
if ne tc_unhex_to_exp TTP_DIG1 0 len TTP_DIG1 1 TC_OK
ret false
end
end
for i ulong 32
if ne get tp_mdig i get tc_exp_mod i
ret false
end
end
ret true
end

fn ttp_run_coder f ulong c ulong ub long to void
rc = int 0
if eq c 1
rc = tc_range_encode
else
rc = tc_rans_encode
end
ttp_chk eq rc TC_OK TTP_S_COD
if ne rc TC_OK
ret
end
cn = get tc_cb_len 0
if eq c 1
rc = tc_range_decode cn
else
rc = tc_rans_decode cn
end
ok = eq rc TC_OK
if ok
n = get tc_sy_n 0
if ne get tc_dsy_n 0 n
ok = false
else
for i ulong n bound 500000
if ne get tc_dsy_sym i get tc_sy_sym i
ok = false
break
end
end
end
end
ttp_chk ok TTP_S_COD
tc_out_reset
tc_out_str TTP_S_FIX
tc_out_u64 f
tc_out_str TTP_S_MOD
for i ulong 8
tc_out_hex_byte get tp_mdig i
end
tc_out_str TTP_S_N
tc_out_u64 get tc_ps_n 0
tc_out_str TTP_S_TPS
tc_out_hex_ps_dig 32
tc_out_str TTP_S_UB
tc_out_i64 ub
tc_out_str TTP_S_COD
tc_out_u64 c
tc_out_str TTP_S_BYT
tc_out_u64 cn
tc_out_byte 10
z = tc_out_flush get ttp_det_fd 0
end

fn ttp_run_model f ulong mi ulong to void
if lt mi 2
rc = int 0
if eq mi 0
rc = tc_load_model TTP_MOD0 0 len TTP_MOD0
else
rc = tc_load_model TTP_MOD1 0 len TTP_MOD1
end
ttp_chk eq rc TC_OK TTP_S_MOD
ttp_chk ttp_check_mdig mi TTP_S_MOD
else
rc = tp_model_uniform 9
if ne rc TC_OK
ret
end
end
rc = tc_produce
ttp_chk eq rc TC_OK TTP_S_TPS
if ne rc TC_OK
ret
end
rc1 = tc_ps_serialize
rc2 = tc_sy_serialize 0
rc3 = int -1
rc4 = int -1
if eq rc1 TC_OK
if eq rc2 TC_OK
rc3 = tc_ps_parse get tc_pb_len 0
rc4 = tc_sy_parse get tc_sb_len 0
end
end
ok = false
if eq rc1 TC_OK
if eq rc2 TC_OK
if eq rc3 TC_OK
if eq rc4 TC_OK
ok = true
end
end
end
end
ttp_chk ok TTP_S_TPS
for i ulong 32
put tc_exp_prof i get tp_prof_d i
put tc_exp_mod i get tp_mdig i
put tc_exp_dat i get tp_dat_d i
end
ttp_chk eq tc_ps_expect 1 1 1 TC_OK TTP_S_MOD
put tc_exp_mod 0 xor get tc_exp_mod 0 1
ttp_chk eq tc_ps_expect 1 1 1 TC_E_MODEL TTP_S_MOD
ub = tc_ideal_ub 0 get tc_ps_n 0
ttp_run_coder f 1 ub
ttp_run_coder f 2 ub
end

fn main to int
if ne argcnt 2
ret 2
end
alen = argread 1 ttp_arg 0 900
if le alen 0
ret 2
end
ap = ulong alen
for i ulong 4
put ttp_arg add ap i get TTP_DET_EXT i
end
fd = fopen ttp_arg 0 add ap 4 577 420
if lt fd 0
ret 2
end
put ttp_det_fd 0 int fd
for i ulong 32
put tp_prof_d i 0
end
for f ulong 2
rc = ttp_load_fix f
ttp_chk and eq rc TC_OK gt get tp_ev_n 0 0 TTP_S_FIX
ttp_chk eq rc TC_OK TTP_S_FIX
for i ulong 32
put tp_dat_d i get tc_sh_out i
end
for mi ulong 3
ttp_run_model f mi
end
end
z = fclose get ttp_det_fd 0
tc_out_reset
tc_out_str TTP_S_HDR
tc_out_u64 get ttp_pass 0
tc_out_str TTP_S_PAS
tc_out_u64 get ttp_fail 0
tc_out_str TTP_S_FAI
z2 = tc_out_flush 1
if ne get ttp_fail 0 0
ret 1
end
ret 0
end

note
note tests/turing/test_ty_prd2.om -- PRD2 reader + mixture scorer tests (R28-v2
note and negative controls N1-N4) in pure seeded OM-2.
note Composed after src/turing/ty_qcont_lib.om.

const P2_NPTS ulong 2000

text t_p2_fail "FAIL test_ty_prd2 check="
text t_p2_nl "\n"
text t_p2_sum1 "test_ty_prd2: "
text t_p2_sum2 " checks, "
text t_p2_sum3 " failed\n"

global g_p2_chk ulong 1
global g_p2_fl ulong 1
global g_p2o uchar 256
global g_p2_st ulong 1
global g_p2_y f64 2001

fn p2_puts s view uchar * to void
  n = len s
  for i ulong n
    put g_p2o i get s i
  end
  _w = write 1 g_p2o 0 n
end

fn p2_put_u64 v ulong to void
  if eq v 0
    put g_p2o 0 uchar 48
    _w = write 1 g_p2o 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_p2o n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_p2o i
    put g_p2o i get g_p2o j
    put g_p2o j tmp
    i = add i 1
  end
  _w = write 1 g_p2o 0 n
end

fn chk ok bool id ulong to void
  put g_p2_chk 0 add get g_p2_chk 0 1
  if not ok
    put g_p2_fl 0 add get g_p2_fl 0 1
    p2_puts t_p2_fail
    p2_put_u64 id
    p2_puts t_p2_nl
  end
end

fn set_g2 p ulong idx ulong lc f64 sc f64 to void
  put g_qp_idx p idx
  put g_qp_fam p TYQ_FAM_GAUSS
  put g_qp_k p 1
  put g_qp_loc p lc
  put g_qp_sc p sc
  bo = mul p 8
  put g_qc_pi bo f64 1.0
  put g_qc_loc bo lc
  put g_qc_sc bo sc
end

fn set_m2 p ulong idx ulong pi0 f64 l0 f64 s0 f64 to void
  put g_qp_idx p idx
  put g_qp_fam p TYQ_FAM_MIX
  put g_qp_k p 2
  bo = mul p 8
  put g_qc_pi bo pi0
  put g_qc_loc bo l0
  put g_qc_sc bo s0
end

fn set_m2_c1 p ulong pi1 f64 l1 f64 s1 f64 to void
  bo = add mul p 8 1
  put g_qc_pi bo pi1
  put g_qc_loc bo l1
  put g_qc_sc bo s1
end

fn kof y f64 to long
  ret long q_floor div y q_delta
end

fn test_row28 to void
  set_m2 0 0 f64 0.5 f64 0.0 f64 1.0
  set_m2_c1 0 f64 0.4 f64 0.0 f64 1.0
  chk and eq ty_prd2_validate 0 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_WEIGHT_SUM 1
  chk eq ty_qcont2_bits 0 0 TYQ_FAIL_PROTOCOL 2
  put g_qc_pi 1 f64 0.6
  chk and eq ty_prd2_validate 0 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_WEIGHT_SUM 3
  put g_qc_pi 0 f64 1.5
  put g_qc_pi 1 f64 -0.5
  chk and eq ty_prd2_validate 0 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_WEIGHT_RANGE 4
  put g_qc_pi 0 f64 0.5
  put g_qc_pi 1 f64 0.5
  chk and eq ty_prd2_validate 0 TYQ_OK eq get g_qret_u 2 PRD2_R_NONE 5
  chk and eq ty_qcont2_bits 0 123 TYQ_OK q_isfinite get g_qret_f 0 6
  chk ne get g_qret_u 2 PRD2_R_FAMILY 7
  exact = true
  for ui ulong 81
    iv = sub long ui 40
    lc = mul f64 0.37 f64 iv
    sc = add f64 0.001 mul f64 0.05 f64 and bitcast ulong iv 7
    kv = kof add lc mul f64 0.013 f64 iv
    set_g2 0 0 lc sc
    put g_qp_idx 1 0
    put g_qp_fam 1 TYQ_FAM_MIX
    put g_qp_k 1 1
    put g_qc_pi 8 f64 1.0
    put g_qc_loc 8 lc
    put g_qc_sc 8 sc
    r1 = ty_qcont_bits 0 kv
    bg = get g_qret_f 0
    hg = get g_qret_u 0
    r2 = ty_qcont2_bits 1 kv
    bm = get g_qret_f 0
    hm = get g_qret_u 0
    if or ne r1 TYQ_OK ne r2 TYQ_OK
      exact = false
    end
    if or ne bitcast ulong bg bitcast ulong bm ne hg hm
      exact = false
    end
  end
  chk exact 8
  worst = f64 0.0
  for ui ulong 41
    iv = sub long ui 20
    lc = mul f64 0.1 f64 iv
    sc = f64 0.2
    kv = kof add lc f64 0.05
    set_g2 0 0 lc sc
    put g_qp_idx 1 0
    put g_qp_fam 1 TYQ_FAM_MIX
    put g_qp_k 1 8
    for j ulong 8
      put g_qc_pi add 8 j f64 0.125
      put g_qc_loc add 8 j lc
      put g_qc_sc add 8 j sc
    end
    chk eq ty_qcont_bits 0 kv TYQ_OK 9
    bg = get g_qret_f 0
    chk eq ty_qcont2_bits 1 kv TYQ_OK 10
    df = q_fabs sub bg get g_qret_f 0
    if gt df worst
      worst = df
    end
  end
  chk le worst f64 0.000000000001 11
end

fn cp_w0_to_w1 blen ulong to void
  for i ulong blen
    put g_qwire2 i get g_qwire i
  end
end

fn test_wire to void
  set_g2 0 128 f64 0.5 f64 0.25
  set_m2 1 129 f64 0.25 f64 -1.0 f64 0.5
  set_m2_c1 1 f64 0.75 f64 2.0 f64 0.125
  set_g2 2 130 f64 0.0 f64 1.0
  chk eq ty_prd2_encode 0 0 128 3 TYQ_OK 20
  blen = get g_qret_u 0
  chk eq blen 160 21
  chk eq ty_prd2_parse 0 blen 128 3 10 TYQ_OK 22
  chk and eq get g_qp_k 11 2 and eq get g_qc_loc 89 f64 2.0 eq get g_qp_loc 12 f64 0.0 23
  chk eq ty_prd2_encode 1 10 128 3 TYQ_OK 24
  chk eq get g_qret_u 0 blen 25
  same = true
  for i ulong blen
    if ne get g_qwire i get g_qwire2 i
      same = false
    end
  end
  chk same 26
  chk and eq ty_prd2_parse 0 blen 128 4 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_COUNT 27
  chk and eq ty_prd2_parse 0 blen 129 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_COUNT 28
  chk and eq ty_prd2_parse 0 sub blen 1 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_SIZE 29
  cp_w0_to_w1 blen
  put g_qwire2 blen uchar 0
  chk and eq ty_prd2_parse 1 add blen 1 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_SIZE 30
  cp_w0_to_w1 blen
  put g_qwire2 5 uchar 3
  chk and eq ty_prd2_parse 1 blen 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_VERSION 31
  cp_w0_to_w1 blen
  put g_qwire2 28 uchar 1
  chk and eq ty_prd2_parse 1 blen 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_RESERVED 32
  cp_w0_to_w1 blen
  put g_qwire2 20 uchar 1
  chk and eq ty_prd2_parse 1 blen 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_FAMILY 33
  cp_w0_to_w1 blen
  put g_qwire2 24 uchar 9
  chk and eq ty_prd2_parse 1 blen 128 3 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_K 34
  set_g2 5 7 f64 1.0 f64 1.0
  chk eq ty_prd_encode 5 7 1 TYQ_OK 35
  vlen = get g_qret_u 0
  chk eq vlen 32 36
  chk and eq ty_prd2_parse 1 vlen 7 1 10 TYQ_FAIL_PROTOCOL eq get g_qret_u 2 PRD2_R_MAGIC 37
  chk eq ty_prd_parse 0 blen 128 3 10 TYQ_FAIL_PROTOCOL 38
  set_m2 5 0 f64 0.5 f64 0.0 f64 1.0
  set_m2_c1 5 f64 0.4 f64 0.0 f64 1.0
  chk eq ty_prd2_encode 1 5 0 1 TYQ_FAIL_PROTOCOL 39
end

fn u01 to f64
  st = get g_p2_st 0
  st = xor st shr st 12
  st = xor st shl st 25
  st = xor st shr st 27
  put g_p2_st 0 st
  v = mul st ulong 2685821657736338717
  ret div add f64 shr v 11 f64 0.5 f64 9007199254740992.0
end

fn gauss to f64
  a = u01
  b = u01
  ret mul fsqrt mul f64 -2.0 q_ln a q_cos mul f64 6.283185307179586 b
end

fn test_controls to void
  put g_p2_st 0 or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  sd = f64 0.05
  put g_p2_y 0 f64 0.0
  for i ulong P2_NPTS
    yi = get g_p2_y i
    yn = add yi mul sd gauss
    put g_p2_y add i 1 yn
    put g_qk_arr i kof yn
    set_g2 i i yi sd
    set_m2 add 2000 i i f64 0.5 f64 0.0 sd
    set_m2_c1 add 2000 i f64 0.5 f64 0.0 sd
    set_m2 add 4000 i i f64 0.5 yi sd
    set_m2_c1 add 4000 i f64 0.5 yi f64 1000000.0
  end
  for i ulong P2_NPTS
    set_g2 add 6000 i i get g_p2_y rem mul i 7919 P2_NPTS sd
  end
  chk eq ty_qcont2_sum_ub 0 0 P2_NPTS TYQ_OK 40
  h = get g_qret_i 1
  chk eq get g_qret_u 1 0 41
  chk eq ty_qcont2_sum_ub 2000 0 P2_NPTS TYQ_OK 42
  c = get g_qret_i 1
  chk eq ty_qcont2_sum_ub 6000 0 P2_NPTS TYQ_OK 43
  s = get g_qret_i 1
  chk eq ty_qcont2_sum_ub 4000 0 P2_NPTS TYQ_OK 44
  p = get g_qret_i 1
  chk eq ty_qcont_sum_ub 0 0 P2_NPTS TYQ_OK 45
  chk eq get g_qret_i 1 h 46
  chk gt c h 47
  chk gt s h 48
  per_h = div div f64 h f64 1000000.0 f64 P2_NPTS
  per_p = div div f64 p f64 1000000.0 f64 P2_NPTS
  chk ge sub per_p per_h f64 0.9 49
end

fn main to int
  test_row28
  test_wire
  test_controls
  p2_puts t_p2_sum1
  p2_put_u64 get g_p2_chk 0
  p2_puts t_p2_sum2
  p2_put_u64 get g_p2_fl 0
  p2_puts t_p2_sum3
  if ne get g_p2_fl 0 0
    ret 1
  end
  ret 0
end

text t_d_fg2 " lm_b="
text t_d_fg3 " lm_c="
text t_d_fg4 " digest="

global g_pass ulong 1
global g_fail ulong 1
global g_chk_id ulong 1
global g_pfx uchar 512
global g_pfx_len ulong 1
global g_det_buf uchar 16384
global g_det_len ulong 1
global g_path_tmp uchar 600
global g_path_len ulong 1
global g_io_buf uchar 8192
global g_mcode_bak uchar 1048576

fn out_str s view uchar * to void
  r = write 1 s 0 len s
end

fn out_u64 v ulong to void
  tv_clr
  tv_u64 v
  n = get g_tvl 0
  r = write 1 g_tv 0 n
end

fn det_b c uchar to void
  n = get g_det_len 0
  if lt n 16384
    put g_det_buf n c
    put g_det_len 0 add n 1
  end
end

fn det_txt s view uchar * to void
  n = len s
  for i ulong n bound 512
    det_b get s i
  end
end

fn det_u64 v ulong to void
  tv_clr
  tv_u64 v
  n = get g_tvl 0
  for i ulong n bound 32
    det_b get g_tv i
  end
end

fn det_i64 v long to void
  tv_clr
  tv_i64 v
  n = get g_tvl 0
  for i ulong n bound 32
    det_b get g_tv i
  end
end

fn det_dig slot ulong to void
  tv_clr
  tv_dig slot
  for i ulong 64
    det_b get g_tv i
  end
end

fn chk cond bool to void
  id = add get g_chk_id 0 1
  put g_chk_id 0 id
  if cond
    put g_pass 0 add get g_pass 0 1
  else
    put g_fail 0 add get g_fail 0 1
    out_str t_s_fail
    out_u64 id
    out_str t_s_nl
  end
end

fn make_tmp_path suf view uchar * to void
  n = get g_pfx_len 0
  for i ulong n bound 512
    put g_path_tmp i get g_pfx i
    put g_path i get g_pfx i
  end
  sl = len suf
  for i ulong sl bound 64
    put g_path_tmp add n i get suf i
    put g_path add n i get suf i
  end
  put g_path_len 0 add n sl
  put g_plen 0 add n sl
end

fn copy_file_to_tmp src view uchar * to bool
  fd1 = fopen src 0 len src int 0 int 0
  if lt fd1 0
    ret false
  end
  note O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577
  fd2 = fopen g_path_tmp 0 get g_path_len 0 int 577 int 420
  if lt fd2 0
    dc = fclose int fd1
    ret false
  end
  done = false
  while not done bound 100000
    k = read int fd1 g_io_buf 0 8192
    if lt k 0
      dc1 = fclose int fd1
      dc2 = fclose int fd2
      ret false
    end
    if eq k 0
      done = true
    else
      w = write int fd2 g_io_buf 0 ulong k
      if ne w k
        dc1 = fclose int fd1
        dc2 = fclose int fd2
        ret false
      end
    end
  end
  dc1 = fclose int fd1
  dc2 = fclose int fd2
  ret true
end

fn patch_tmp off ulong val uchar to bool
  note O_RDWR = 2
  fd = fopen g_path_tmp 0 get g_path_len 0 int 2 int 0
  if lt fd 0
    ret false
  end
  b = new uchar 1 0
  put b 0 val
  w = pwrite int fd b 0 1 long off
  dc = fclose int fd
  ret eq w 1
end

fn append_zero_tmp to bool
  note O_WRONLY|O_APPEND = 1|1024 = 1025
  fd = fopen g_path_tmp 0 get g_path_len 0 int 1025 int 0
  if lt fd 0
    ret false
  end
  b = new uchar 1 0
  w = write int fd b 0 1
  dc = fclose int fd
  ret eq w 1
end

fn dg_eq_txt slot ulong hex view uchar * to bool
  if ne len hex 64
    ret false
  end
  h = new uchar 64 0
  dg_to_hex slot h
  for i ulong 64
    if ne get h i get hex i
      ret false
    end
  end
  ret true
end

note ---- Test 1: Math ----
fn t_math to void
  sum = long 0
  q = ulong 1
  while le q TY_QONE bound 65536
    sum = add sum ty_ubits_q16 q
    q = add q 1
  end
  chk eq ty_ubits_q16 TY_QONE 0
  chk eq ty_ubits_q16 32768 1000000
  chk eq ty_ubits_q16 1 16000000
  chk and eq ty_ubits_q16 0 TY_E_RANGE eq ty_ubits_q16 65537 TY_E_RANGE
  det_txt t_d_ubsum
  det_i64 sum
  det_b uchar 10

  chk and eq ty_ubits_ratio 1 2 TY_OK eq get g_ty_ret_i 0 1000000
  chk and eq ty_ubits_ratio 7 7 TY_OK eq get g_ty_ret_i 0 0
  chk eq ty_ubits_ratio 0 5 TY_E_ZERO_REALIZED
  chk eq ty_ubits_ratio 3 2 TY_E_RANGE
  chk and eq ty_ubits_ratio 1 shl ulong 1 62 TY_OK eq get g_ty_ret_i 0 62000000

  tol = f64 0.000000000001
  ok = new f64 3 0.0
  put ok 0 f64 0.5
  put ok 1 f64 0.25
  put ok 2 f64 0.25
  chk eq ty_validate_f64 ok 3 tol TY_OK

  nanv = new f64 3 0.0
  put nanv 0 f64 0.5
  put nanv 1 div f64 0.0 f64 0.0
  put nanv 2 f64 0.5
  chk eq ty_validate_f64 nanv 3 tol TY_E_NAN

  infv = new f64 3 0.0
  put infv 0 f64 0.5
  put infv 1 div f64 1.0 f64 0.0
  put infv 2 f64 0.0
  chk eq ty_validate_f64 infv 3 tol TY_E_INF

  negv = new f64 3 0.0
  put negv 0 f64 0.75
  put negv 1 f64 -0.25
  put negv 2 f64 0.5
  chk eq ty_validate_f64 negv 3 tol TY_E_NEG

  offv = new f64 3 0.0
  put offv 0 f64 0.5
  put offv 1 f64 0.25
  put offv 2 f64 0.2
  chk eq ty_validate_f64 offv 3 tol TY_E_NORM
  chk eq ty_validate_f64 offv 3 f64 0.1 TY_OK
  t_math_f64_2
end

fn t_math_f64_2 to void
  tol = f64 0.000000000001
  ok = new f64 3 0.0
  put ok 0 f64 0.5
  put ok 1 f64 0.25
  put ok 2 f64 0.25
  negz = new f64 3 0.0
  put negz 0 f64 0.5
  put negz 1 bitcast f64 shl ulong 1 63
  put negz 2 f64 0.5
  chk eq ty_validate_f64 negz 3 tol TY_OK
  chk eq ty_validate_f64 ok 0 tol TY_E_ARG

  chk and eq ty_ubits_f64 ok 3 0 tol TY_OK eq get g_ty_ret_i 0 1000000
  chk and eq ty_ubits_f64 ok 3 1 tol TY_OK eq get g_ty_ret_i 0 2000000

  zv = new f64 3 0.0
  put zv 0 f64 0.5
  put zv 1 f64 0.5
  put zv 2 f64 0.0
  chk eq ty_ubits_f64 zv 3 2 tol TY_E_ZERO_REALIZED

  note 1e-300 in IEEE-754: 0x01ad7f29abcaf485
  put zv 2 bitcast f64 or shl ulong 0x01ad7f29 32 ulong 0xabcaf485
  chk eq ty_ubits_f64 zv 3 2 tol TY_E_UNDERFLOW

  note subnormal 4.9e-324 = 0x1
  put zv 2 bitcast f64 ulong 1
  chk eq ty_ubits_f64 zv 3 2 tol TY_E_UNDERFLOW

  note 2^-60 = exp 1023-60=963 -> 0x3c30000000000000
  put zv 2 bitcast f64 shl ulong 963 52
  chk and eq ty_ubits_f64 zv 3 2 tol TY_OK eq get g_ty_ret_i 0 60000000
  chk eq ty_ubits_f64 ok 3 3 tol TY_E_ARG

  p3 = new f64 2 0.0
  put p3 0 f64 0.3
  put p3 1 f64 0.7
  chk eq ty_ubits_f64 p3 2 0 tol TY_OK
  note -log2(0.3)*1e6 = 1736965.594... -> 1736966
  v3 = get g_ty_ret_i 0
  chk and ge v3 1736965 le v3 1736967

  chk and eq ty_dl 1000 5000000 TY_OK eq get g_ty_ret_i 0 1005000000
  chk eq ty_dl shr ulong 0xffffffffffffffff 1 0 TY_E_OVERFLOW
  chk eq ty_dl 1 -1 TY_E_RANGE
  chk and eq ty_gain 10 4 TY_OK eq get g_ty_ret_i 0 6
  chk and eq ty_gain 4 10 TY_OK eq get g_ty_ret_i 0 -6
  chk eq ty_add bitcast long or shl ulong 0x7fffffff 32 ulong 0xffffffff 1 TY_E_OVERFLOW

  t_math_quant
end

fn t_math_quant to void
  c = new ulong 9 0
  qv = new uint 9 0
  for k ulong 3
    for x ulong 9
      put c x 0
    end
    if eq k 1
      put c 0 1000000
      put c 8 1
    end
    if eq k 2
      for x ulong 9
        put c x 5
      end
    end
    chk eq ty_quantize_kt c 9 qv TY_OK
    s = ulong 0
    mn = ulong 999999
    for x ulong 9
      v = ulong get qv x
      s = add s v
      if lt v mn
        mn = v
      end
    end
    chk and eq s TY_QONE ge mn 1
    if eq k 0
      det_txt t_d_q0
    else
      if eq k 1
        det_txt t_d_q1
      else
        det_txt t_d_q2
      end
    end
    for x ulong 9
      det_u64 ulong get qv x
      det_b uchar 32
    end
    det_b uchar 10
    if eq k 0
      chk and eq get qv 0 uint 7282 eq get qv 8 uint 7281
    end
    if eq k 1
      chk and eq get qv 1 uint 1 gt get qv 0 uint 65000
    end
  end
  chk and eq ty_quantize_kt c 1 qv TY_E_ARG eq ty_quantize_kt c 17 qv TY_E_ARG
end

note ---- Test 2: Reader ----
fn t_reader to void
  st_reset_all
  st_begin 0
  na = ty_ctr1_read t_fix_a len t_fix_a 0
  st_begin 1
  nb = ty_ctr1_read t_fix_b len t_fix_b 1
  chk and eq na 1418 and eq get g_st_ncr 0 3 eq get g_st_gap 0 0
  chk and eq nb 1330 eq get g_st_ncr 1 3
  rc1 = ty_file_sha256 t_fix_a len t_fix_a 0
  chk and eq rc1 TY_OK dg_eq_txt 0 t_gold_a
  rc2 = ty_file_sha256 t_fix_b len t_fix_b 1
  chk and eq rc2 TY_OK dg_eq_txt 1 t_gold_b

  hist = new ulong 9 0
  so = get g_st_off 0
  sn = get g_st_n 0
  for i ulong sn bound 2000
    sym = ev_sym get g_ev add so i
    put hist sym add get hist sym 1
  end
  det_txt t_d_hist
  for x ulong 9
    det_u64 get hist x
    det_b uchar 32
  end
  det_b uchar 10
  t_reader_hostile
end

fn t_reader_hostile to void
  make_tmp_path t_suf_bad
  offs = new ulong 7 0
  vals = new uchar 7 0
  put offs 0 0
  put vals 0 uchar 88
  put offs 1 4
  put vals 1 uchar 2
  put offs 2 6
  put vals 2 uchar 3
  put offs 3 22
  put vals 3 uchar 1
  put offs 4 20
  put vals 4 uchar 15
  put offs 5 25
  put vals 5 uchar 3
  put offs 6 ulong 1243
  put vals 6 uchar 0
  for i ulong 7
    okc = copy_file_to_tmp t_fix_a
    okp = patch_tmp get offs i get vals i
    st_reset_all
    st_begin 0
    n = ty_ctr1_read_gp 0
    if eq i 6
      chk and eq n 1418 eq get g_st_ncr 0 4
    else
      chk eq n TY_E_FORMAT
    end
  end
  okc = copy_file_to_tmp t_fix_a
  okp = patch_tmp ulong 1243 uchar 2
  st_reset_all
  st_begin 0
  chk eq ty_ctr1_read_gp 0 TY_E_FORMAT

  note find pruned record in FIX_A and patch rc=4
  fd = fopen t_fix_a 0 len t_fix_a int 0 int 0
  pidx = long -1
  ri = long 0
  while lt ri 2000 bound 2000
    k = read int fd g_io_buf 0 TY_CTR1_BYTES
    if ne k long TY_CTR1_BYTES
      break
    end
    if and eq get g_io_buf 6 uchar 1 ne get g_io_buf 23 uchar 0
      pidx = ri
      break
    end
    ri = add ri 1
  end
  dc = fclose int fd
  okc = copy_file_to_tmp t_fix_a
  if ge pidx 0
    okp = patch_tmp add mul ulong pidx TY_CTR1_BYTES 7 uchar 4
  end
  st_reset_all
  st_begin 0
  chk and ge pidx 0 eq ty_ctr1_read_gp 0 TY_E_FORMAT

  note size % 247 != 0
  okc = copy_file_to_tmp t_fix_a
  oka = append_zero_tmp
  st_reset_all
  st_begin 0
  chk eq ty_ctr1_read_gp 0 TY_E_FORMAT
  ru = unlink g_path_tmp 0 get g_path_len 0
end

note ---- Test 3: Model Code ----
fn model_01_eq nr ulong to bool
  for x ulong TY_OUT_K
    if ne get g_md_def x get g_md_def add 16 x
      ret false
    end
  end
  for i ulong nr bound 65536
    if ne get g_md_rkey i get g_md_rkey add TY_MAX_MROWS i
      ret false
    end
    b0 = mul i 16
    b1 = mul add TY_MAX_MROWS i 16
    for x ulong TY_OUT_K
      if ne get g_md_rq add b0 x get g_md_rq add b1 x
        ret false
      end
    end
  end
  ret true
end

fn t_model_code to void
  st_reset_all
  st_begin 0
  chk ge ty_ctr1_read t_fix_a len t_fix_a 0 0
  put g_fit_sids 0 0
  chk eq ty_model_fit 0 1 or TY_F_OP TY_F_PREV1 TY_OUT_K TY_FIT_KEEP_ALL TY_OK
  chk eq ty_model_encode 0 0 TY_OK
  nb = get g_mclen 0
  bits = get g_mcbits 0
  nr = get g_md_nr 0
  kb = get g_md_kb 0
  chk eq bits add add TY_MODEL_HEADER_BITS 128 mul nr add kb 128
  chk and eq ty_model_decode 0 nb 1 TY_OK and eq get g_ty_ret_u 0 bits eq get g_md_nr 1 nr
  chk model_01_eq nr
  r1 = ty_model_score 0 0
  s1 = get g_ty_ret_i 0
  r2 = ty_model_score 1 0
  s2 = get g_ty_ret_i 0
  chk eq s1 s2
  t_model_code_mut nb kb
end

fn t_model_code_mut nb ulong kb ulong to void
  for i ulong nb bound 1048576
    put g_mcode_bak i get g_mcode i
  end
  note mutations
  put g_mcode 0 uchar 88
  chk eq ty_model_decode 0 nb 1 TY_E_FORMAT
  put g_mcode 0 get g_mcode_bak 0

  put g_mcode 4 uchar 1
  chk eq ty_model_decode 0 nb 1 TY_E_PROFILE
  put g_mcode 4 get g_mcode_bak 4

  put g_mcode 7 uchar 12
  chk eq ty_model_decode 0 nb 1 TY_E_PROFILE
  put g_mcode 7 get g_mcode_bak 7

  put g_mcode 8 uchar add kb 1
  chk eq ty_model_decode 0 nb 1 TY_E_FORMAT
  put g_mcode 8 get g_mcode_bak 8

  put g_mcode 13 uchar 0
  put g_mcode 14 uchar 0
  chk eq ty_model_decode 0 nb 1 TY_E_PROFILE
  put g_mcode 13 get g_mcode_bak 13
  put g_mcode 14 get g_mcode_bak 14

  chk eq ty_model_decode 0 sub nb 1 1 TY_E_FORMAT
end

fn dl_of fit_sid ulong sc_sid ulong mask ulong rule ulong to long
  put g_fit_sids 0 fit_sid
  rc = ty_model_fit 0 1 mask TY_OUT_K rule
  if ne rc TY_OK
    ret -1
  end
  rc = ty_model_encode 0 0
  if ne rc TY_OK
    ret -1
  end
  nb = get g_mclen 0
  lm = get g_mcbits 0
  put g_ty_ret_u 5 lm
  rc = ty_model_decode 0 nb 1
  if ne rc TY_OK
    ret -1
  end
  rc = ty_model_score 1 sc_sid
  if ne rc TY_OK
    ret -1
  end
  rc = ty_dl lm get g_ty_ret_i 0
  if ne rc TY_OK
    ret -1
  end
  ret get g_ty_ret_i 0
end

note ---- Test 4: Memorizer ----
fn t_memorizer to void
  st_reset_all
  st_begin 0
  na = ty_ctr1_read t_fix_a len t_fix_a 0
  st_begin 1
  nb = ty_ctr1_read t_fix_b len t_fix_b 1
  chk and ge na 0 ge nb 0
  dlb_h = dl_of 0 1 TY_F_PREV1 TY_FIT_MDL_PRUNE
  dlm_h = dl_of 0 1 TY_F_POS TY_FIT_KEEP_ALL
  lm_m = get g_ty_ret_u 5
  dlb_f = dl_of 0 0 TY_F_PREV1 TY_FIT_MDL_PRUNE
  dlm_f = dl_of 0 0 TY_F_POS TY_FIT_KEEP_ALL
  t_h = sub dlb_h dlm_h
  t_f = sub dlb_f dlm_f
  chk gt lm_m mul ulong 1418 160
  chk lt t_h 0
  chk lt t_f 0
  det_txt t_d_memo1
  det_u64 lm_m
  det_txt t_d_memo2
  det_i64 t_h
  det_txt t_d_memo3
  det_i64 t_f
  det_b uchar 10
end

note ---- Test 5: Train-only gain ----
fn sm64 s ulong to ulong
  z = mul xor s shr s 30 or shl ulong 0xbf58476d 32 ulong 0x1ce4e5b9
  z = mul xor z shr z 27 or shl ulong 0x94d049bb 32 ulong 0x133111eb
  ret xor z shr z 31
end

fn t_train_only to void
  st_reset_all
  st_begin 0
  seed = ulong 12345
  for c ulong 20
    for i ulong 500
      f = ulong 0
      if eq i 0
        f = 1
      end
      rc = st_push 0 ev_pack rem i TY_OUT_K rem i 15 0 f c i
    end
  end
  st_begin 1
  for c ulong 20
    for i ulong 500
      f = ulong 0
      if eq i 0
        f = 1
      end
      seed = add seed or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
      sym = rem sm64 seed TY_OUT_K
      rc = st_push 1 ev_pack sym rem i 15 0 f c i
    end
  end
  bf = dl_of 0 0 0 TY_FIT_MDL_PRUNE
  cf = dl_of 0 0 TY_F_PREV1 TY_FIT_MDL_PRUNE
  bh = dl_of 0 1 0 TY_FIT_MDL_PRUNE
  ch = dl_of 0 1 TY_F_PREV1 TY_FIT_MDL_PRUNE
  tf = sub bf cf
  th = sub bh ch
  chk gt tf 0
  chk lt th 0
  det_txt t_d_to1
  det_i64 tf
  det_txt t_d_to2
  det_i64 th
  det_b uchar 10
end

note ---- Test 6: Records & Hostile Cases ----
fn set_sp_lbl which ulong idx ulong s view uchar * to void
  lo = mul idx 64
  n = len s
  for i ulong n bound 64
    if eq which 0
      put g_sp_flbl add lo i get s i
    else
      put g_sp_hlbl add lo i get s i
    end
  end
  if eq which 0
    put g_sp_flen idx n
  else
    put g_sp_hlen idx n
  end
end

fn fit_fixture_model fi ulong cs ulong role ulong mask ulong prof_slot ulong split_slot ulong to long
  st_reset_all
  st_begin 0
  rc = ty_file_sha256_gp add 20 fi
  if ne rc TY_OK
    ret rc
  end
  if lt ty_ctr1_read_gp 0 0
    ret TY_E_FORMAT
  end
  put g_fit_sids 0 0
  rc = ty_model_fit fi 1 mask TY_OUT_K TY_FIT_MDL_PRUNE
  if ne rc TY_OK
    ret rc
  end
  rc = ty_model_encode fi cs
  if ne rc TY_OK
    ret rc
  end
  ty_model_digest cs get g_mclen cs add 30 fi
  put g_fr_prof fi prof_slot
  put g_fr_split fi split_slot
  put g_fr_role fi role
  put g_fr_mask fi mask
  put g_fr_rule fi TY_FIT_MDL_PRUNE
  put g_fr_nf fi 1
  put g_fr_fdig mul fi 12 add 20 fi
  put g_fr_mod fi add 30 fi
  put g_fr_mbits fi get g_mcbits cs
  ret TY_OK
end

note Check one fit record against profile (slot 10), split (slot 11), floor_q
fn check_fit_rec fi ulong cs ulong prof_slot ulong split_slot ulong to long
  if not dg_eq get g_fr_prof fi prof_slot
    ret TY_E_PROFILE
  end
  if not dg_eq get g_fr_split fi split_slot
    ret TY_E_PROVENANCE
  end
  nf = get g_fr_nf fi
  bo = mul fi 12
  nh = get g_sp_nh 0
  for i ulong nf bound 12
    fd = get g_fr_fdig add bo i
    for j ulong nh bound 12
      if dg_eq fd get g_sp_hdig j
        ret TY_E_LEAK
      end
    end
  end
  if ne nf get g_sp_nf 0
    ret TY_E_PROVENANCE
  end
  for i ulong nf bound 12
    if not dg_eq get g_fr_fdig add bo i get g_sp_fdig i
      ret TY_E_PROVENANCE
    end
  end
  if ne get g_fr_rule fi TY_FIT_MDL_PRUNE
    ret TY_E_PROFILE
  end
  ty_model_digest cs get g_mclen cs 45
  if not dg_eq 45 get g_fr_mod fi
    ret TY_E_DIGEST
  end
  ms = add 2 fi
  rc = ty_model_decode cs get g_mclen cs ms
  if ne rc TY_OK
    ret rc
  end
  if ne get g_md_k ms TY_OUT_K
    ret TY_E_PROFILE
  end
  if ne get g_ty_ret_u 0 get g_fr_mbits fi
    ret TY_E_PROFILE
  end
  if ne get g_md_mask ms get g_fr_mask fi
    ret TY_E_PROFILE
  end
  ret TY_OK
end

fn gain_compute_fix prof_slot ulong split_slot ulong floor_q ulong to long
  if ne floor_q 1
    ret TY_E_PROFILE
  end
  if or ne get g_fr_role 0 TY_ROLE_BASELINE ne get g_fr_mask 0 TY_V0_BASELINE_MASK
    ret TY_E_BASELINE
  end
  if ne get g_fr_role 1 TY_ROLE_CANDIDATE
    ret TY_E_ARG
  end
  rc = check_fit_rec 0 0 prof_slot split_slot
  if ne rc TY_OK
    ret rc
  end
  rc = check_fit_rec 1 1 prof_slot split_slot
  if ne rc TY_OK
    ret rc
  end
  rc = ty_file_sha256_gp 46
  if ne rc TY_OK
    ret rc
  end
  if not dg_eq 46 get g_sp_hdig 0
    ret TY_E_DIGEST
  end
  st_reset_all
  st_begin 0
  if lt ty_ctr1_read_gp 0 0
    ret TY_E_FORMAT
  end
  rc = ty_model_score 2 0
  if ne rc TY_OK
    ret rc
  end
  put g_gr_i 0 get g_ty_ret_i 0
  put g_gr_u 0 get g_ty_ret_u 0
  rc = ty_model_score 3 0
  if ne rc TY_OK
    ret rc
  end
  put g_gr_i 1 get g_ty_ret_i 0
  rc = ty_dl get g_fr_mbits 0 get g_gr_i 0
  put g_gr_i 2 get g_ty_ret_i 0
  rc = ty_dl get g_fr_mbits 1 get g_gr_i 1
  put g_gr_i 3 get g_ty_ret_i 0
  rc = ty_gain get g_gr_i 2 get g_gr_i 3
  put g_gr_i 4 get g_ty_ret_i 0
  rc = ty_fit_digest 0 40
  rc = ty_fit_digest 1 41
  put g_gr_dig 0 prof_slot
  put g_gr_dig 1 split_slot
  put g_gr_dig 2 40
  put g_gr_dig 3 41
  put g_gr_dig 4 get g_fr_mod 0
  put g_gr_dig 5 get g_fr_mod 1
  put g_gr_u 1 get g_fr_mbits 0
  put g_gr_u 2 get g_fr_mbits 1
  put g_gr_u 3 1
  ns = get g_gr_u 0
  qnum = add mul mul 2 ns TY_QERR_MILLI_UB 999
  qerr = long div qnum 1000
  put g_gr_i 5 qerr
  put g_gr_i 6 TY_V0_MARGIN_UB
  put g_gr_fnsym 0 ns
  t_ub = get g_gr_i 4
  put g_gr_ftub 0 t_ub
  pass = ulong 0
  diff = sub t_ub qerr
  if and gt diff TY_V0_MARGIN_UB gt diff 0
    pass = 1
  end
  put g_gr_pass 0 pass
  ret TY_OK
end

fn t_records to void
  note real V0 profile digest golden
  rc = dg_parse_hex t_gold_man len t_gold_man 5
  rc = ty_profile_v0_digest 5 1 6
  chk dg_eq_txt 6 t_gold_prof
  rc = ty_profile_v0_digest 5 2 7
  chk not dg_eq_txt 7 t_gold_prof

  note fixture profile + split
  rc = ty_file_sha256 t_fix_a len t_fix_a 0
  rc = ty_file_sha256 t_fix_b len t_fix_b 1
  sh_init
  for i ulong 32
    sh_byte get g_dig i
  end
  for i ulong 32
    sh_byte get g_dig add 32 i
  end
  sh_final 2
  rc = ty_profile_v0_digest 2 1 10
  put g_sp_nf 0 1
  put g_sp_nh 0 1
  put g_sp_fdig 0 0
  put g_sp_hdig 0 1
  set_sp_lbl 0 0 t_lbl_a
  set_sp_lbl 1 0 t_lbl_b
  rc = ty_split_digest 11

  gp_set t_fix_a len t_fix_a
  chk eq fit_fixture_model 0 0 TY_ROLE_BASELINE TY_V0_BASELINE_MASK 10 11 TY_OK
  gp_set t_fix_a len t_fix_a
  chk eq fit_fixture_model 1 1 TY_ROLE_CANDIDATE TY_V0_CANDIDATE_MASK 10 11 TY_OK
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_OK
  rc = ty_gain_digest 50
  chk and eq get g_gr_u 0 1330 eq sub get g_gr_i 2 get g_gr_i 3 get g_gr_i 4
  chk eq get g_gr_ftub 0 get g_gr_i 4
  chk eq get g_gr_i 5 long div add mul mul ulong 2 1330 501 999 1000
  chk eq get g_gr_pass 0 0
  chk dg_eq_txt 50 t_gold_gain
  det_txt t_d_fg1
  det_i64 get g_gr_i 4
  det_txt t_d_fg2
  det_u64 get g_gr_u 1
  det_txt t_d_fg3
  det_u64 get g_gr_u 2
  det_txt t_d_fg4
  det_dig 50
  det_b uchar 10

  t_records_hostile
end

fn t_records_hostile to void
  note 1. leakage: candidate fit on held-out file B
  gp_set t_fix_b len t_fix_b
  chk eq fit_fixture_model 1 1 TY_ROLE_CANDIDATE TY_V0_CANDIDATE_MASK 10 11 TY_OK
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_LEAK
  note hidden leak: claim fit digest A, compute succeeds, refit disagrees with digest 50
  put g_fr_fdig 12 0
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_OK
  rc = ty_gain_digest 51
  chk not dg_eq 51 50

  note restore clean candidate
  gp_set t_fix_a len t_fix_a
  rc = fit_fixture_model 1 1 TY_ROLE_CANDIDATE TY_V0_CANDIDATE_MASK 10 11

  note 2. foreign fit file -> TY_E_PROVENANCE
  dg_cp 25 21
  put g_dig 800 xor get g_dig 800 uchar 1
  put g_fr_fdig 12 25
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_PROVENANCE
  put g_fr_fdig 12 21

  note 3. changed floor profile
  rc = ty_profile_v0_digest 2 2 12
  put g_fr_prof 1 12
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_PROFILE
  put g_fr_prof 1 10
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 12 11 2 TY_E_PROFILE

  note 4. candidate mutating version/qbits/floor with consistent digest
  cbo = TY_MCODE_SLOT
  nc = get g_mclen 1
  b4 = get g_mcode add cbo 4
  put g_mcode add cbo 4 uchar 1
  ty_model_digest 1 nc 31
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_PROFILE
  put g_mcode add cbo 4 b4

  b7 = get g_mcode add cbo 7
  put g_mcode add cbo 7 uchar 12
  ty_model_digest 1 nc 31
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_PROFILE
  put g_mcode add cbo 7 b7

  b13 = get g_mcode add cbo 13
  b14 = get g_mcode add cbo 14
  put g_mcode add cbo 13 uchar 0
  put g_mcode add cbo 14 uchar 0
  ty_model_digest 1 nc 31
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_PROFILE
  put g_mcode add cbo 13 b13
  put g_mcode add cbo 14 b14
  ty_model_digest 1 nc 31
  t_records_hostile2
end

fn t_records_hostile2 to void
  cbo = TY_MCODE_SLOT
  note 5. weaker baseline (order-0)
  gp_set t_fix_a len t_fix_a
  rc = fit_fixture_model 0 0 TY_ROLE_BASELINE 0 10 11
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_BASELINE
  gp_set t_fix_a len t_fix_a
  rc = fit_fixture_model 0 0 TY_ROLE_BASELINE TY_V0_BASELINE_MASK 10 11

  note 6. tampered baseline & candidate code
  nb = get g_mclen 0
  put g_mcode sub nb 1 xor get g_mcode sub nb 1 uchar 128
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_DIGEST
  put g_mcode sub nb 1 xor get g_mcode sub nb 1 uchar 128

  put g_mcode add cbo 20 xor get g_mcode add cbo 20 uchar 1
  gp_set t_fix_b len t_fix_b
  chk eq gain_compute_fix 10 11 1 TY_E_DIGEST
  put g_mcode add cbo 20 xor get g_mcode add cbo 20 uchar 1

  note 7. tampered held-out dataset
  t_records_hostile3
end

fn t_records_hostile3 to void
  make_tmp_path t_suf_tmp
  okc = copy_file_to_tmp t_fix_b
  fd = fopen t_fix_b 0 len t_fix_b int 0 int 0
  fidx = long -1
  ri = long 0
  while lt ri 2000 bound 2000
    k = read int fd g_io_buf 0 TY_CTR1_BYTES
    if ne k long TY_CTR1_BYTES
      break
    end
    if eq get g_io_buf 6 uchar 1
      if eq get g_io_buf 23 uchar 0
        if eq get g_io_buf 7 uchar 2
          fidx = ri
          break
        end
      end
    end
    ri = add ri 1
  end
  dc = fclose int fd
  if ge fidx 0
    okp = patch_tmp add mul ulong fidx TY_CTR1_BYTES 7 uchar 4
  end
  st_reset_all
  st_begin 0
  chk and ge fidx 0 ge ty_ctr1_read_gp 0 0
  chk eq gain_compute_fix 10 11 1 TY_E_DIGEST
  ru = unlink g_path_tmp 0 get g_path_len 0

  note 8. tampered receipt (edited T, forged PASS)
  gp_set t_fix_b len t_fix_b
  rc = gain_compute_fix 10 11 1
  orig_t = get g_gr_i 4
  put g_gr_i 4 add orig_t 1000000
  rc = ty_gain_digest 52
  chk not dg_eq 52 50
  put g_gr_i 4 orig_t
  put g_gr_pass 0 1
  rc = ty_gain_digest 53
  chk not dg_eq 53 50
end

fn main to int
  ac = argcnt
  if gt ac 1
    k = argread 1 g_pfx 0 512
    if gt k 0
      put g_pfx_len 0 ulong k
    end
  else
    n = len t_def_pfx
    for i ulong n bound 512
      put g_pfx i get t_def_pfx i
    end
    put g_pfx_len 0 n
  end
  t_math
  t_reader
  t_model_code
  t_memorizer
  t_train_only
  t_records

  make_tmp_path t_suf_det
  fd = fopen g_path_tmp 0 get g_path_len 0 int 577 int 420
  if ge fd 0
    w = write int fd g_det_buf 0 get g_det_len 0
    dc = fclose int fd
  end

  out_str t_s_pass
  out_u64 get g_pass 0
  out_str t_s_p2
  out_u64 get g_fail 0
  out_str t_s_f2
  if ne get g_fail 0 0
    ret 1
  end
  ret 0
end

text t_fix_a "tests/turing/fixtures/ctr1_seed1_crumbs05-07.ctr"
text t_fix_b "tests/turing/fixtures/ctr1_seed1_crumbs10-12.ctr"
text t_gold_a "777193633a4ff8092659024f18194bd111da5129c6e8bc3f04a292c138a732cc"
text t_gold_b "c01b91468d5b6cfb4953166d6f161cee2dceeb174675d0f7d90418b2b8967ccc"
text t_gold_prof "f4292df9748e306165f30b250673a0062391054321ea6dbe68855ecaa0fa8be8"
text t_gold_man "6efc04b525af60706bd0f3176013fe234d8e8a52e2554cff3add8a4e16171dca"
text t_gold_gain "acf0b17065f0d4930425e55ad4af9bcfd91a2c0c0d0aa4dc6f086c3457e86cd6"
text t_def_pfx "build/test_ty_math"
text t_lbl_a "fixture A"
text t_lbl_b "fixture B"
text t_suf_det ".det"
text t_suf_bad ".bad.ctr"
text t_suf_tmp ".held_tamper.ctr"

text t_s_pass "test_ty_math: "
text t_s_p2 " passed, "
text t_s_f2 " failed\n"
text t_s_fail "FAIL check "
text t_s_nl "\n"
text t_d_ubsum "ub_table_sum="
text t_d_q0 "quant0="
text t_d_q1 "quant1="
text t_d_q2 "quant2="
text t_d_hist "fixA_hist="
text t_d_memo1 "memorizer lm="
text t_d_memo2 " t_held_ub="
text t_d_memo3 " t_fit_ub="

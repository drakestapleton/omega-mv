note
note tests/turing/test_tc.om: EXP-001 coder test suite in pure seeded OM-2.
note Ports 100% of tests/turing/test_tc.c (1030 checks) WITHOUT tc_produce.om.
note Composed after seed/ng/sha256.om, tc_pstream.om, tc_range_lib.om, tc_rans.om.

const SH_RANDOM ulong 0
const SH_SKEW_FIRST ulong 1
const SH_SKEW_LAST ulong 2
const SH_UNIFORM ulong 3
const SH_SPIKY ulong 4

const PK_SAMPLE ulong 0
const PK_RAREST ulong 1
const PK_LAST ulong 2
const PK_FIRST ulong 3

text TT_DET_EXT ".det"
text TT_USE "usage: test_tc <output prefix>\n"
text TT_HDR "test_tc: "
text TT_PAS " passed, "
text TT_FAI " failed\n"
text TT_F "FAIL: "
text TT_CODER " coder="
text TT_N " n="
text TT_BYTES " bytes="
text TT_SHA " sha="
text TT_TPS1 " tps1="
text TT_UB " ideal_ub="
text TT_RC_STAT "range carries="
text TT_PM " pending_max="
text TT_REF "refuse "
text TT_BAR " | "
text TT_PF "payload flips coder="
text TT_PFR " refused="
text TT_PFD " decoded_different="
text TT_PFS " silent="
text TT_LBL_RT "round_trip"
text TT_LBL_CAR "carries"
text TT_LBL_PM "pending_max"
text TT_LBL_FC "fail_closed"
text TT_LBL_G2 "g2_rule"

global tt_pass ulong 1
global tt_fail ulong 1
global tt_rng ulong 1
global tt_carries ulong 1
global tt_pend_max ulong 1
global tt_det_fd int 1
global tt_arg uchar 1024

note Saved base fixture for fail-closed tests (K=9, n=5000)
global tt_pb uchar 262144
global tt_pb_len ulong 1
global tt_sb uchar 8192
global tt_sb_len ulong 1
global tt_cr uchar 65536
global tt_cr_len ulong 1
global tt_ca uchar 65536
global tt_ca_len ulong 1
global tt_orig_sym uchar 8192
global tt_w ulong 16

fn tt_chk cond bool msg view uchar * to void
if cond
put tt_pass 0 add get tt_pass 0 1
ret
end
put tt_fail 0 add get tt_fail 0 1
tc_out_reset
tc_out_str TT_F
tc_out_str msg
tc_out_byte 10
z = tc_out_flush 1
end

fn tt_rnd to ulong
z = add get tt_rng 0 11400714819323198485
put tt_rng 0 z
z = mul xor z shr z 30 13787848793156543929
z = mul xor z shr z 27 10723151780598845931
ret xor z shr z 31
end

fn tt_make_row qoff ulong k ulong shape ulong to void
if eq shape SH_SKEW_FIRST
for x ulong sub k 1 bound 16
put tc_ps_q add qoff add x 1 1
end
put tc_ps_q qoff ushort sub TC_QONE sub k 1
ret
end
if eq shape SH_SKEW_LAST
for x ulong sub k 1 bound 16
put tc_ps_q add qoff x 1
end
put tc_ps_q add qoff sub k 1 ushort sub TC_QONE sub k 1
ret
end
if eq shape SH_UNIFORM
qv = div TC_QONE k
for x ulong k bound 16
put tc_ps_q add qoff x ushort qv
end
put tc_ps_q qoff ushort add qv rem TC_QONE k
ret
end
tot = ulong 0
for x ulong k bound 16
wv = add rem tt_rnd 1000 1
if eq shape SH_SPIKY
if eq rem tt_rnd 4 0
wv = ulong 1
end
end
put tt_w x wv
tot = add tot wv
end
if eq shape SH_SPIKY
idx = rem tt_rnd k
put tt_w idx add get tt_w idx 100000
tot = ulong 0
for x ulong k bound 16
tot = add tot get tt_w x
end
end
spare = sub TC_QONE k
left = TC_QONE
for x ulong k bound 16
v = add 1 div mul spare get tt_w x tot
put tc_ps_q add qoff x ushort v
left = sub left v
end
x = ulong 0
while gt left 0 bound 256
qv = ulong get tc_ps_q add qoff x
if lt qv 65535
put tc_ps_q add qoff x ushort add qv 1
left = sub left 1
end
x = rem add x 1 k
end
end

fn tt_pick qoff ulong k ulong picker ulong to ulong
if eq picker PK_LAST
ret sub k 1
end
if eq picker PK_FIRST
ret 0
end
if eq picker PK_RAREST
b = ulong 0
for x ulong sub k 1 bound 16
xi = add x 1
if lt get tc_ps_q add qoff xi get tc_ps_q add qoff b
b = xi
end
end
ret b
end
u = and tt_rnd 65535
c = ulong 0
for x ulong k bound 16
c = add c ulong get tc_ps_q add qoff x
if lt u c
ret x
end
end
ret sub k 1
end

fn tt_fill_digests to void
for i ulong 32
put tc_ps_prof i uchar and add 31 i 255
put tc_ps_mod i uchar and add 62 i 255
put tc_ps_dat i uchar and add 93 i 255
put tc_sy_dat i uchar and add 93 i 255
end
end

fn tt_make_pair k ulong n ulong shape ulong picker ulong to void
put tc_ps_k 0 k
put tc_ps_n 0 n
put tc_sy_k 0 k
put tc_sy_n 0 n
tt_fill_digests
for t ulong n bound 500000
qoff = mul t k
tt_make_row qoff k shape
put tc_ps_key t mul t 7
put tc_ps_crumb t uint div t 1000
put tc_sy_sym t uchar tt_pick qoff k picker
end
end

fn tt_round_trip_coder c ulong sn ulong ub long to void
rc = int 0
if eq c 1
rc = tc_range_encode
else
rc = tc_rans_encode
end
tt_chk eq rc TC_OK TT_LBL_RT
if ne rc TC_OK
ret
end
cn = get tc_cb_len 0
if eq c 1
rc = tc_range_decode cn
else
rc = tc_rans_decode cn
end
tt_chk eq rc TC_OK TT_LBL_RT
if eq rc TC_OK
rc2 = tc_sy_serialize 1
exact = false
if eq rc2 TC_OK
if eq get tc_db_len 0 sn
exact = true
for i ulong sn bound 524288
if ne get tc_db i get tc_sb i
exact = false
break
end
end
end
end
tt_chk exact TT_LBL_RT
end
pn = get tc_ps_n 0
pay_ub = mul mul sub cn TC_CODED_HEADER 8 1000000
ovh_ub = sub long pay_ub ub
lim_ub = add long 64000000 mul long pn 10000
tt_chk le ovh_ub lim_ub TT_LBL_RT
tc_sha_cb 0 cn
tc_out_reset
tc_out_str TT_LBL_RT
tc_out_str TT_CODER
tc_out_u64 c
tc_out_str TT_N
tc_out_u64 pn
tc_out_str TT_BYTES
tc_out_u64 cn
tc_out_str TT_SHA
tc_out_hex_sh 32
tc_out_byte 10
z = tc_out_flush get tt_det_fd 0
end

fn tt_round_trip to void
rc1 = tc_ps_serialize
rc2 = tc_sy_serialize 0
rc3 = int -1
rc4 = int -1
if eq rc1 TC_OK
if eq rc2 TC_OK
rc3 = tc_ps_parse get tc_pb_len 0
rc4 = tc_sy_parse get tc_sb_len 0
end
end
ok = false
if eq rc1 TC_OK
if eq rc2 TC_OK
if eq rc3 TC_OK
if eq rc4 TC_OK
ok = true
end
end
end
end
tt_chk ok TT_LBL_RT
if not ok
ret
end
sn = get tc_sb_len 0
pn = get tc_ps_n 0
ub = tc_ideal_ub 0 pn
tt_round_trip_coder 1 sn ub
tt_round_trip_coder 2 sn ub
if gt pn 0
if eq tc_range_encode_raw 0 pn get tc_ps_k 0 0 TC_OK
put tt_carries 0 add get tt_carries 0 get tc_rc_st 7
if gt get tc_rc_st 8 get tt_pend_max 0
put tt_pend_max 0 get tc_rc_st 8
end
end
end
tc_out_reset
tc_out_str TT_LBL_RT
tc_out_str TT_TPS1
tc_out_hex_ps_dig 32
tc_out_str TT_UB
tc_out_i64 ub
tc_out_byte 10
z = tc_out_flush get tt_det_fd 0
end

fn tt_test_round_trips to void
ns = new ulong 6 0
put ns 0 0
put ns 1 1
put ns 2 2
put ns 3 17
put ns 4 1000
put ns 5 20000
for ki ulong 15
k = add ki 2
for i ulong 6
tt_make_pair k get ns i SH_RANDOM PK_SAMPLE
tt_round_trip
end
end
tt_make_pair 2 50000 SH_SKEW_FIRST PK_RAREST
tt_round_trip
tt_make_pair 16 50000 SH_SKEW_FIRST PK_RAREST
tt_round_trip
tt_make_pair 2 300000 SH_SKEW_LAST PK_LAST
tt_round_trip
tt_make_pair 16 300000 SH_SKEW_LAST PK_LAST
tt_round_trip
tt_make_pair 9 300000 SH_SKEW_FIRST PK_FIRST
tt_round_trip
tt_make_pair 9 50000 SH_SKEW_LAST PK_FIRST
tt_round_trip
tt_make_pair 16 200000 SH_SPIKY PK_SAMPLE
tt_round_trip
tt_make_pair 9 200000 SH_SPIKY PK_RAREST
tt_round_trip
tt_make_pair 9 200000 SH_UNIFORM PK_SAMPLE
tt_round_trip
tt_make_pair 16 200000 SH_RANDOM PK_SAMPLE
tt_round_trip
note Mixed runs K=9, n=400000
put tc_ps_k 0 9
put tc_ps_n 0 400000
put tc_sy_k 0 9
put tc_sy_n 0 400000
tt_fill_digests
for t ulong 400000 bound 400000
qoff = mul t 9
run = rem div t 997 2
if ne run 0
tt_make_row qoff 9 SH_SKEW_LAST
put tc_sy_sym t uchar tt_pick qoff 9 PK_LAST
else
tt_make_row qoff 9 SH_RANDOM
put tc_sy_sym t uchar tt_pick qoff 9 PK_SAMPLE
end
put tc_ps_key t 0
put tc_ps_crumb t 0
end
tt_round_trip
tt_chk gt get tt_carries 0 0 TT_LBL_CAR
tt_chk gt get tt_pend_max 0 1 TT_LBL_PM
tc_out_reset
tc_out_str TT_RC_STAT
tc_out_u64 get tt_carries 0
tc_out_str TT_PM
tc_out_u64 get tt_pend_max 0
tc_out_byte 10
z = tc_out_flush get tt_det_fd 0
end

note ---------------------------------------------------------------- fail-closed helpers

fn tt_redigest_pb plen ulong to void
body = sub plen TC_DIGEST
tc_ps_hash_pb body
for i ulong 32
tc_pb_put add body i get tc_sh_out i
end
end

fn tt_redigest_sb slen ulong to void
body = sub slen TC_DIGEST
tc_sha_init
tc_sha_dom TC_DOM_SY
for i ulong body bound 524288
tc_sha_byte get tc_sb i
end
tc_sha_final
for i ulong 32
put tc_sb add body i get tc_sh_out i
end
end

fn tt_restore_pb to void
n = get tt_pb_len 0
for i ulong n bound 262144
tc_pb_put i get tt_pb i
end
put tc_pb_len 0 n
end

fn tt_restore_sb to void
n = get tt_sb_len 0
for i ulong n bound 8192
put tc_sb i get tt_sb i
end
put tc_sb_len 0 n
end

fn tt_restore_coded c ulong to ulong
if eq c 1
n = get tt_cr_len 0
for i ulong n bound 65536
put tc_cb i get tt_cr i
end
put tc_cb_len 0 n
ret n
end
n = get tt_ca_len 0
for i ulong n bound 65536
put tc_cb i get tt_ca i
end
put tc_cb_len 0 n
ret n
end

fn tt_restore_base_ps to void
tt_restore_pb
z = tc_ps_parse get tt_pb_len 0
end

fn tt_refused rc int want int to void
tt_chk eq rc want TT_LBL_FC
has_why = false
if eq rc TC_OK
has_why = true
else
if gt get tc_whylen 0 0
has_why = true
end
end
tt_chk has_why TT_LBL_FC
tc_out_reset
tc_out_str TT_REF
tc_out_errname rc
tc_out_str TT_BAR
tc_out_why
tc_out_byte 10
z = tc_out_flush get tt_det_fd 0
end

fn tt_decode_c c ulong clen ulong to int
tc_why_clear
if eq c 1
ret tc_range_decode clen
end
ret tc_rans_decode clen
end

fn tt_fc_base_make to void
tt_make_pair 9 5000 SH_RANDOM PK_SAMPLE
z = tc_ps_serialize
z = tc_sy_serialize 0
pn = get tc_pb_len 0
sn = get tc_sb_len 0
put tt_pb_len 0 pn
put tt_sb_len 0 sn
for i ulong pn bound 262144
put tt_pb i tc_pb_get i
end
for i ulong sn bound 8192
put tt_sb i get tc_sb i
end
z = tc_ps_parse pn
z = tc_sy_parse sn
for i ulong 5000
put tt_orig_sym i get tc_sy_sym i
end
z = tc_range_encode
crn = get tc_cb_len 0
put tt_cr_len 0 crn
for i ulong crn bound 65536
put tt_cr i get tc_cb i
end
z = tc_rans_encode
can = get tc_cb_len 0
put tt_ca_len 0 can
for i ulong can bound 65536
put tt_ca i get tc_cb i
end
end

fn tt_fc_part1 to void
note Sanity + 1 (corrupted pstream) + 2 (trunc/trail) + 3 (wrong digests)
rb = add TC_PS_REC_FIXED 18
n1 = tt_restore_coded 1
r1 = tt_decode_c 1 n1
n2 = tt_restore_coded 2
r2 = tt_decode_c 2 n2
tt_chk and eq r1 TC_OK eq r2 TC_OK TT_LBL_FC
note 1. corrupted probability stream
tt_restore_pb
pn = get tt_pb_len 0
off = add add TC_PS_HEADER mul 3 rb 24
tc_pb_put off xor tc_pb_get off 1
tc_why_clear
tt_refused tc_ps_parse pn TC_E_DIGEST
note 1b. re-digested altered stream
tt_restore_pb
q0 = tc_pb_get_u16 off
q1 = tc_pb_get_u16 add off 2
if gt q0 1
tc_pb_put_u16 off sub q0 1
tc_pb_put_u16 add off 2 add q1 1
else
tc_pb_put_u16 off add q0 1
tc_pb_put_u16 add off 2 sub q1 1
end
tt_redigest_pb pn
tt_chk eq tc_ps_parse pn TC_OK TT_LBL_FC
n1 = tt_restore_coded 1
tt_refused tt_decode_c 1 n1 TC_E_BINDING
n2 = tt_restore_coded 2
tt_refused tt_decode_c 2 n2 TC_E_BINDING
tt_restore_base_ps
note 2. truncated / trailing bitstream
n1 = tt_restore_coded 1
tt_refused tt_decode_c 1 sub n1 1 TC_E_TRUNC
n2 = tt_restore_coded 2
tt_refused tt_decode_c 2 sub n2 1 TC_E_TRUNC
for ci ulong 2
c = add ci 1
cn = tt_restore_coded c
tc_cb_put_u64 48 sub sub cn TC_CODED_HEADER 1
tt_refused tt_decode_c c sub cn 1 TC_E_TRUNC
tc_cb_put_u64 48 2
tt_refused tt_decode_c c add TC_CODED_HEADER 2 TC_E_TRUNC
cn = tt_restore_coded c
put tc_cb cn 0
tt_refused tt_decode_c c add cn 1 TC_E_TRAIL
tc_cb_put_u64 48 add sub cn TC_CODED_HEADER 1
tt_refused tt_decode_c c add cn 1 TC_E_TRAIL
end
note 3. wrong model / profile / dataset digest
for i ulong 32
put tc_exp_prof i uchar and add 31 i 255
put tc_exp_mod i uchar and add 62 i 255
put tc_exp_dat i uchar and add 93 i 255
end
tc_why_clear
tt_refused tc_ps_expect 1 1 1 TC_OK
for i ulong 32
put tc_exp_mod i uchar and add 3069 i 255
end
tc_why_clear
tt_refused tc_ps_expect 1 1 1 TC_E_MODEL
for i ulong 32
put tc_exp_mod i uchar and add 62 i 255
put tc_exp_prof i uchar and add 3069 i 255
end
tc_why_clear
tt_refused tc_ps_expect 1 1 1 TC_E_PROFILE
for i ulong 32
put tc_exp_prof i uchar and add 31 i 255
put tc_exp_dat i uchar and add 3069 i 255
end
tc_why_clear
tt_refused tc_ps_expect 1 1 1 TC_E_DATASET
note TSY1 dataset mismatch
tt_restore_sb
sn = get tt_sb_len 0
put tc_sb 24 xor get tc_sb 24 128
tt_redigest_sb sn
tt_chk eq tc_sy_parse sn TC_OK TT_LBL_FC
tc_why_clear
tt_refused tc_range_encode TC_E_DATASET
tc_why_clear
tt_refused tc_rans_encode TC_E_DATASET
tt_restore_sb
z = tc_sy_parse sn
end

fn tt_fc_part2 to void
note 4. malformed normalization and zero-probability entries
rb = add TC_PS_REC_FIXED 18
pn = get tt_pb_len 0
tt_restore_pb
off10 = add add TC_PS_HEADER mul 10 rb 24
tc_pb_put_u16 off10 add tc_pb_get_u16 off10 1
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_NORM
tt_restore_pb
tc_pb_put_u32 add add TC_PS_HEADER mul 10 rb 20 65535
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_NORM
tt_restore_pb
off11 = add add TC_PS_HEADER mul 11 rb 24
q0 = tc_pb_get_u16 off11
q1 = tc_pb_get_u16 add off11 2
tc_pb_put_u16 off11 0
tc_pb_put_u16 add off11 2 add q1 q0
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_ZERO
note in-memory streams
tt_make_pair 4 10 SH_RANDOM PK_SAMPLE
put tc_ps_q 21 ushort add ulong get tc_ps_q 21 1
tc_why_clear
tt_refused tc_ps_serialize TC_E_NORM
tt_chk eq tc_range_encode_raw 0 10 4 0 TC_E_NORM TT_LBL_FC
tt_chk eq tc_rans_encode_raw 0 10 4 0 TC_E_NORM TT_LBL_FC
put tc_ps_q 21 ushort sub ulong get tc_ps_q 21 1
put tc_ps_q 21 ushort add ulong get tc_ps_q 21 ulong get tc_ps_q 22
put tc_ps_q 22 0
tc_why_clear
tt_refused tc_ps_serialize TC_E_ZERO
tt_chk eq tc_rans_encode_raw 0 10 4 0 TC_E_ZERO TT_LBL_FC
tt_chk eq tc_range_encode_raw 0 10 4 0 TC_E_NORM TT_LBL_FC
tt_restore_base_ps
tt_restore_sb
z = tc_sy_parse get tt_sb_len 0
end

fn tt_fc_part3 to void
note 5. header omitted / altered + accounting
offs = new ulong 7 0
put offs 0 0
put offs 1 4
put offs 2 5
put offs 3 6
put offs 4 8
put offs 5 20
put offs 6 48
xrs = new uchar 7 0
put xrs 0 32
put xrs 1 2
put xrs 2 3
put xrs 3 1
put xrs 4 1
put xrs 5 16
put xrs 6 1
wants = new int 7 0
put wants 0 TC_E_HEADER
put wants 1 TC_E_HEADER
put wants 2 TC_E_HEADER
put wants 3 TC_E_HEADER
put wants 4 TC_E_COUNT
put wants 5 TC_E_BINDING
put wants 6 TC_E_TRUNC
for ci ulong 2
c = add ci 1
cn = tt_restore_coded c
pl = sub cn TC_CODED_HEADER
for i ulong pl bound 65536
put tc_cb i get tc_cb add TC_CODED_HEADER i
end
tt_refused tt_decode_c c pl TC_E_HEADER
for ai ulong 7
cn = tt_restore_coded c
o = get offs ai
put tc_cb o xor get tc_cb o get xrs ai
w = get wants ai
if eq o 48
if lt tc_cb_get_u64 48 sub cn TC_CODED_HEADER
w = TC_E_TRAIL
end
end
tt_refused tt_decode_c c cn w
end
cn = tt_restore_coded c
tt_refused tt_decode_c sub 3 c cn TC_E_HEADER
end
z = tc_range_encode_raw 0 5000 9 0
tt_chk eq get tt_cr_len 0 add TC_CODED_HEADER get tc_cb_plen 0 TT_LBL_FC
z = tc_rans_encode_raw 0 5000 9 0
tt_chk eq get tt_ca_len 0 add TC_CODED_HEADER get tc_cb_plen 0 TT_LBL_FC
end

fn tt_fc_part4 to void
note 6. symbol count mismatch + 7. TPS1 structure + 8. payload corruption
rb = add TC_PS_REC_FIXED 18
pn = get tt_pb_len 0
sn = get tt_sb_len 0
put tc_sy_n 0 4999
tc_why_clear
tt_refused tc_range_encode TC_E_COUNT
tc_why_clear
tt_refused tc_rans_encode TC_E_COUNT
tt_restore_sb
tc_sb_put_u64 8 5001
tt_redigest_sb sn
tc_why_clear
tt_refused tc_sy_parse sn TC_E_COUNT
tt_restore_sb
put tc_sb add TC_SY_HEADER 7 9
tt_redigest_sb sn
tc_why_clear
tt_refused tc_sy_parse sn TC_E_SYMBOL
tt_restore_sb
z = tc_sy_parse sn
note 7. TPS1 structure
tt_restore_pb
tc_pb_put_u64 add TC_PS_HEADER mul 4 rb 5
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_INDEX
tt_restore_pb
tc_pb_put_u64 12 4999
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_FORMAT
tt_restore_pb
tc_why_clear
tt_refused tc_ps_parse sub pn rb TC_E_DIGEST
tt_restore_pb
tc_pb_put 4 2
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_FORMAT
tt_restore_pb
tc_pb_put 7 15
tt_redigest_pb pn
tc_why_clear
tt_refused tc_ps_parse pn TC_E_FORMAT
tt_restore_base_ps
end

fn tt_fc_flip_one c ulong cn ulong off ulong to ulong
z2 = tt_restore_coded c
mask = uchar shl 1 rem off 8
put tc_cb off xor get tc_cb off mask
rc = tt_decode_c c cn
if ne rc TC_OK
ret 1
end
for i ulong 5000
if ne get tc_dsy_sym i get tt_orig_sym i
ret 2
end
end
ret 3
end

fn tt_fc_part5 to void
note 8. payload corruption
for ci ulong 2
c = add ci 1
cn = tt_restore_coded c
refused = ulong 0
differ = ulong 0
silent = ulong 0
off = TC_CODED_HEADER
while lt off cn bound 65536
res = tt_fc_flip_one c cn off
if eq res 1
refused = add refused 1
else
if eq res 2
differ = add differ 1
else
silent = add silent 1
end
end
off = add off 7
end
tt_chk eq silent 0 TT_LBL_FC
tt_chk gt refused 0 TT_LBL_FC
tc_out_reset
tc_out_str TT_PF
tc_out_u64 c
tc_out_str TT_PFR
tc_out_u64 refused
tc_out_str TT_PFD
tc_out_u64 differ
tc_out_str TT_PFS
tc_out_u64 silent
tc_out_byte 10
z = tc_out_flush get tt_det_fd 0
end
end

fn tt_test_g2_rule to void
tt_chk eq tc_ubits_q16 43481 591903 TT_LBL_G2
tt_chk eq tc_ubits_q16 46819 485194 TT_LBL_G2
ok_anc = false
if eq tc_ubits_q16 65536 0
if eq tc_ubits_q16 32768 1000000
if eq tc_ubits_q16 1 16000000
ok_anc = true
end
end
end
tt_chk ok_anc TT_LBL_G2
bad = ulong 0
for qi ulong 65536
q = add qi 1
e = tc_hibit q

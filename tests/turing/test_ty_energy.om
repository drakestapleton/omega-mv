note
note tests/turing/test_ty_energy.om -- TURING Yield TY-4/TY-5 unit tests in pure seeded OM-2.
note Replaces tests/turing/test_ty_energy.c.
note Composed after src/turing/ty_energy.om.

text t_te_fx "fixture"
text t_te_c0 "C0"
text t_te_rz "R1_sdot"
text t_te_cp "0-9"
text t_te_m0 "fixture.v0"
text t_te_aa "AA"
text t_te_ab "a|b"
text t_te_cC "C"
text t_te_fail "FAIL test_ty_energy check="
text t_te_nl "\n"
text t_te_sum1 "ty_energy: "
text t_te_sum2 " checks, "
text t_te_sum3 " failures\n"

global g_tchk ulong 1
global g_tfl ulong 1
global g_tout uchar 256

fn pr_txt s view uchar * to void
  n = len s
  for i ulong n
    put g_tout i get s i
  end
  _w = write 1 g_tout 0 n
end

fn pr_u64 v ulong to void
  if eq v 0
    put g_tout 0 uchar 48
    _w = write 1 g_tout 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_tout n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_tout i
    put g_tout i get g_tout j
    put g_tout j tmp
    i = add i 1
  end
  _w = write 1 g_tout 0 n
end

fn chk ok bool id ulong to void
  put g_tchk 0 add get g_tchk 0 1
  if not ok
    put g_tfl 0 add get g_tfl 0 1
    pr_txt t_te_fail
    pr_u64 id
    pr_txt t_te_nl
  end
end

fn put_cstr which ulong off ulong cap ulong s view uchar * to void
  n = len s
  for i ulong cap
    c = uchar 0
    if lt i n
      c = get s i
    end
    if eq which 0
      put g_tw_run add off i c
    else
      if eq which 1
        put g_tw_cfg add off i c
      else
        if eq which 2
          put g_tw_cnd add off i c
        else
          if eq which 3
            put g_tp_rz add off i c
          else
            if eq which 4
              put g_tp_cpu add off i c
            else
              if eq which 5
                put g_ta_mth add off i c
              else
                put g_ts_who add off i c
              end
            end
          end
        end
      end
    end
  end
end

fn mk_win_part p ulong st ulong ch uchar to void
  toff = mul p 8
  for k ulong 8
    put g_tp_tag add toff k uchar 0
  end
  put g_tp_tag toff ch
  put_cstr 3 mul p 32 32 t_te_rz
  put_cstr 4 mul p 32 32 t_te_cp
  put g_tp_go p st
  put g_tp_t0 p add st 1000000
  put g_tp_t1 p add st 999000000
  put g_tp_dn p add st 999000001
  put g_tp_pl p 1000000000
  put g_tp_cl p 1
  put g_tp_cy p 0
  put g_tp_in p 0
  put g_tp_l2 p 0
  put g_tp_pn p 1
  put g_tp_or p 1
  put g_tp_ex p 1
  put g_tp_pm p 1
  put g_tp_mx p 0
end

fn mk_win w ulong cnd view uchar * st ulong en ulong to void
  put_cstr 0 mul w 64 64 t_te_fx
  put_cstr 1 mul w 16 16 t_te_c0
  put_cstr 2 mul w 8 8 cnd
  put g_tw_rnd w 1
  put g_tw_pos w 0
  put g_tw_t0 w st
  put g_tw_t1 w add st 1000000000
  put g_tw_pl w 1000000000
  put g_tw_ok0 w 1
  put g_tw_ok1 w 1
  put g_tw_ovf w 0
  put g_tw_ns w 10
  put g_tw_mg w 100000000
  put g_tw_fb w 0
  put g_tw_mt w 0
  ebo = mul w 3
  for c ulong 3
    put g_tw_e0 add ebo c 1000000
    put g_tw_e1 add ebo c add 1000000 en
  end
  np = len cnd
  if cnd_eq_txt w t_ty_idle
    np = 0
  end
  put g_tw_np w np
  pbo = mul w 4
  for i ulong np
    mk_win_part add pbo i st get cnd i
  end
end

fn mk_attr a ulong to void
  put_cstr 5 mul a 32 32 t_te_m0
  put g_ta_ch a 0
  put g_ta_tol a 1
  put g_ta_au a 0
  put g_ta_nsh a 3
  put g_ta_nsr a 0
  sbo = mul a 8
  put_cstr 6 mul sbo 8 8 t_ty_idle
  put g_ts_uj sbo 20
  put g_ts_cf sbo TY_COUNTERFACTUAL
  put_cstr 6 mul add sbo 1 8 8 t_ty_cA
  put g_ts_uj add sbo 1 30
  put g_ts_cf add sbo 1 TY_COUNTERFACTUAL
  put_cstr 6 mul add sbo 2 8 8 t_ty_cB
  put g_ts_uj add sbo 2 50
  put g_ts_cf add sbo 2 TY_COUNTERFACTUAL
end

fn test_win_checks to void
  mk_win 0 t_ty_cAB 0 100
  chk eq ty_interval_check 0 TYE_OK 1
  chk and eq ty_interval_energy 0 0 TYE_OK eq get g_tret 0 100 2
  chk eq ty_interval_energy 0 -1 TYE_E_ARG 3
  mk_win 1 t_ty_cAB 0 100
  put g_tw_ok0 1 0
  chk eq ty_interval_check 1 TYE_E_SENSOR 4
  mk_win 1 t_ty_cAB 0 100
  put g_tw_ovf 1 1
  chk eq ty_interval_check 1 TYE_E_WRAP 5
  mk_win 1 t_ty_cAB 0 100
  put g_tw_e1 3 0
  chk eq ty_interval_check 1 TYE_E_WRAP 6
  mk_win 1 t_ty_cAB 0 100
  put g_tw_e0 3 sub TY_WRAP_UJ 1000
  put g_tw_e1 3 sub TY_WRAP_UJ 100
  chk eq ty_interval_check 1 TYE_E_HEADROOM 7
  mk_win 1 t_ty_cAB 0 100
  put g_tw_ns 1 0
  chk eq ty_interval_check 1 TYE_E_SAMPLING_GAP 8
  mk_win 1 t_ty_cAB 0 100
  put g_tw_ns 1 or shl ulong 0xffffffff 32 ulong 0xffffffff
  chk eq ty_interval_check 1 TYE_E_SAMPLING_GAP 9
  mk_win 1 t_ty_cAB 0 100
  put g_tw_mg 1 add TY_MAX_GAP_NS 1
  chk eq ty_interval_check 1 TYE_E_SAMPLING_GAP 10
  mk_win 1 t_ty_cAB 0 100
  put g_tp_pn 4 0
  chk eq ty_interval_check 1 TYE_E_PARTIAL_RUN 11
  mk_win 1 t_ty_cAB 0 100
  put g_tp_or 4 0
  chk eq ty_interval_check 1 TYE_E_PARTIAL_RUN 12
  mk_win 1 t_ty_cAB 0 100
  put g_tp_mx 4 1
  chk eq ty_interval_check 1 TYE_E_MULTIPLEXED 13
  mk_win 1 t_ty_cAB 0 100
  put g_tp_pm 4 0
  chk eq ty_interval_check 1 TYE_E_SENSOR 14
  mk_win 1 t_ty_cAB 0 100
  put g_tp_t1 4 add get g_tp_t0 4 1
  chk eq ty_interval_check 1 TYE_E_PARTIAL_RUN 15
  mk_win 1 t_ty_cAB 0 100
  put g_tp_dn 4 add get g_tw_t1 0 1
  chk eq ty_interval_check 1 TYE_E_INTERVAL_MISMATCH 16
  mk_win 1 t_ty_cAB 0 100
  put g_tw_pl 1 or shl ulong 0xffffffff 32 ulong 0xffffffff
  chk eq ty_interval_check 1 TYE_E_INTERVAL_MISMATCH 17
  mk_win 1 t_ty_cAB 0 100
  put g_tw_np 1 add TY_MAX_PART 1
  chk eq ty_interval_check 1 TYE_E_ARG 18
  mk_win 1 t_ty_cAB 0 100
  for k ulong 8
    put g_tw_cnd add 8 k uchar 65
  end
  chk eq ty_interval_check 1 TYE_E_ARG 19
  mk_win 1 t_ty_cAB 0 100
  put_cstr 2 8 8 t_te_aa
  chk eq ty_interval_check 1 TYE_E_CONDITION 20
  mk_win 1 t_ty_cAB 0 100
  put g_tp_tag 40 uchar 65
  chk eq ty_interval_check 1 TYE_E_ARG 21
  mk_win 1 t_ty_cAB 0 100
  put_cstr 3 128 32 t_te_ab
  chk eq ty_interval_check 1 TYE_E_ARG 22
end

fn test_inter_and_attr to void
  mk_win 2 t_ty_idle 0 1000000000000
  put g_tw_pl 2 30000000000
  put g_tw_t1 2 30000000000
  put g_tw_ns 2 300
  chk and eq ty_interval_energy 2 0 TYE_OK eq get g_tret 0 1000000000000 30
  mk_win 3 t_ty_idle 0 1000
  mk_win 4 t_ty_cA 2000000000 2000
  mk_win 5 t_ty_cB 4000000000 3000
  mk_win 6 t_ty_cAB 6000000000 5000
  chk and eq ty_interaction 3 4 5 6 0 TYE_OK eq get g_tret 0 1000 31
  put g_tw_rnd 4 2
  chk eq ty_interaction 3 4 5 6 0 TYE_E_CONDITION 32
  put g_tw_rnd 4 1
  put g_tidx 0 3
  put g_tidx 1 4
  chk eq ty_intervals_disjoint 2 TYE_OK 33
  put g_tidx 0 4
  put g_tidx 1 4
  chk eq ty_intervals_disjoint 2 TYE_E_OVERLAP 34
  mk_win 0 t_ty_cAB 0 100
  mk_attr 0
  chk eq ty_attribution_check 0 0 TYE_OK 40
  chk and eq get g_ta_auj 0 100 and eq get g_ta_ruj 0 0 eq get g_ta_ov 0 TY_COUNTERFACTUAL 41
  chk eq ty_conf_forge get g_ta_ov 0 TY_FORGE_ESTIMATED 42
  mk_attr 0
  put g_ts_uj 0 bitcast long or shl ulong 0x80000000 32 ulong 0
  chk eq ty_attribution_check 0 0 TYE_E_NEGATIVE_SHARE 43
  mk_attr 0
  put g_ts_uj 0 0x7fffffffffffffff
  put g_ts_uj 1 0x7fffffffffffffff
  chk eq ty_attribution_check 0 0 TYE_E_ARG 44
  mk_attr 0
  put g_ta_tol 0 or shl ulong 0xffffffff 32 ulong 0xffffffff
  chk and eq ty_attribution_check 0 0 TYE_E_ARG eq get g_ta_vd 0 TYE_E_ARG 45
  mk_attr 0
  put g_ts_uj 0 100
  chk eq ty_attribution_check 0 0 TYE_E_OVER_ALLOCATED 46
  mk_attr 0
  put_cstr 6 16 8 t_ty_cA
  chk eq ty_attribution_check 0 0 TYE_E_DOUBLE_COUNT 47
  mk_attr 0
  put_cstr 6 16 8 t_te_cC
  chk eq ty_attribution_check 0 0 TYE_E_UNKNOWN_PARTICIPANT 48
  mk_attr 0
  put g_ta_nsh 0 2
  chk eq ty_attribution_check 0 0 TYE_E_MISSING_PARTICIPANT 49
  mk_attr 0
  put_cstr 6 0 8 t_ty_cA
  put g_ts_uj 0 30
  put_cstr 6 8 8 t_ty_cB
  put g_ts_uj 1 50
  put g_ta_nsh 0 2
  chk eq ty_attribution_check 0 0 TYE_E_MISSING_IDLE 50
  mk_attr 0
  put g_ts_cf 0 99
  chk eq ty_attribution_check 0 0 TYE_E_ARG 51
  mk_attr 0
  chk eq ty_attribution_check 0 0 TYE_OK 52
  put g_ta_nsr 0 1
  tdg_cp 512 528
  chk eq ty_attribution_check 0 0 TYE_E_DOUBLE_COUNT 53
  mk_attr 0
  put g_ta_au 0 1
  put g_ta_nsh 0 0
  chk and eq ty_attribution_check 0 0 TYE_OK eq get g_ta_ruj 0 100 54
  chk eq ty_conf_forge 99 TY_FORGE_NOT_MEASURED 55
  chk eq ty_interval_digest 0 0 0 60
  chk and eq ty_interval_digest 0 1 0 tdg_eq 0 1 61
  mk_win 1 t_ty_cAB 0 100
  put g_tp_cy 4 1
  chk and eq ty_interval_digest 1 1 0 not tdg_eq 0 1 62
  mk_win 1 t_ty_cAB 0 100
  for k ulong 64
    put g_tw_run add 64 k uchar 120
  end
  chk ne ty_interval_digest 1 1 0 63
  chk eq ty_attribution_digest 0 1 0 64
end

fn main to long
  test_win_checks
  test_inter_and_attr
  pr_txt t_te_sum1
  pr_u64 get g_tchk 0
  pr_txt t_te_sum2
  pr_u64 get g_tfl 0
  pr_txt t_te_sum3
  if eq get g_tfl 0 0
    ret 0
  end
  ret 1
end

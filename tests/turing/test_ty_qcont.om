note tests/turing/test_ty_qcont.om -- qint.v1 scorer + PRD1 reader unit tests
note in pure seeded OM-2. Composed after src/turing/ty_qcont_lib.om.

const QKAT_PANELS ulong 4096

text t_tq_fail "FAIL test_ty_qcont check="
text t_tq_nl "\n"
text t_tq_sum1 "test_ty_qcont: "
text t_tq_sum2 " checks, "
text t_tq_sum3 " failed\n"
text t_tq_tmp "/tmp/tyqcont_prd_om_test.bin"
text t_tq_badp "/nonexistent/prd"

global g_tq_chk ulong 1
global g_tq_fl ulong 1
global g_tqo uchar 256
global g_tq_ss f64 3
global g_tq_zs f64 6
global g_tq_ks long 4

fn tq_puts s view uchar * to void
  n = len s
  for i ulong n
    put g_tqo i get s i
  end
  _w = write 1 g_tqo 0 n
end

fn tq_put_u64 v ulong to void
  if eq v 0
    put g_tqo 0 uchar 48
    _w = write 1 g_tqo 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_tqo n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_tqo i
    put g_tqo i get g_tqo j
    put g_tqo j tmp
    i = add i 1
  end
  _w = write 1 g_tqo 0 n
end

fn chk ok bool id ulong to void
  put g_tq_chk 0 add get g_tq_chk 0 1
  if not ok
    put g_tq_fl 0 add get g_tq_fl 0 1
    tq_puts t_tq_fail
    tq_put_u64 id
    tq_puts t_tq_nl
  end
end

fn set_g p ulong idx ulong lc f64 sc f64 to void
  put g_qp_idx p idx
  put g_qp_fam p TYQ_FAM_GAUSS
  put g_qp_k p 0
  put g_qp_loc p lc
  put g_qp_sc p sc
end

fn qkat_pt zc f64 u f64 to f64
  t = mul add mul f64 2.0 zc u f64 0.5
  ret q_exp mul sub f64 0.0 u t
end

fn qkat_simpson zc f64 w f64 to f64
  h = div w f64 QKAT_PANELS
  hw = mul w f64 0.5
  sum = f64 0.0
  for i ulong add QKAT_PANELS 1
    fv = qkat_pt zc sub mul h f64 i hw
    wt = f64 2.0
    if or eq i 0 eq i QKAT_PANELS
      wt = f64 1.0
    else
      if ne and i 1 0
        wt = f64 4.0
      end
    end
    sum = add sum mul fv wt
  end
  ret div mul sum h f64 3.0
end

fn qkat_bound zc f64 w f64 to f64
  az = q_fabs zc
  t = add az mul w f64 0.5
  t2 = mul t t
  he = add add mul t2 t2 mul f64 6.0 t2 f64 3.0
  h = div w f64 QKAT_PANELS
  h2 = mul h h
  e1 = q_exp add mul az w div mul w w f64 8.0
  ret mul mul div mul h2 h2 f64 180.0 e1 he
end

fn qkat_ref scale f64 loc f64 k long to long
  delta = q_delta
  s = scale
  if lt s q_sd_min
    s = q_sd_min
  end
  zc = div sub mul add f64 k f64 0.5 delta loc s
  w = div delta s
  iv = qkat_simpson zc w
  bd = qkat_bound zc w
  t1 = add mul mul zc zc f64 0.5 q_hln2pi
  bits = div sub t1 q_ln iv q_ln2
  put g_qret_f 4 bits
  put g_qret_f 5 bd
  if gt bd f64 0.000000000001
    ret -1
  end
  ret 0
end

fn test_lnsinhc to void
  hi = f64 0.0001
  lo = bitcast f64 sub bitcast ulong hi 1
  chk lt q_fabs sub tyq_lnsinhc hi tyq_lnsinhc lo f64 0.000000000000001 1
  chk lt q_fabs sub q_ln div q_sinh hi hi div f64 0.00000001 f64 6.0 f64 0.000000000000001 2
  hi2 = f64 1.0
  lo2 = bitcast f64 sub bitcast ulong hi2 1
  chk lt q_fabs sub tyq_lnsinhc hi2 tyq_lnsinhc lo2 f64 0.00000000000001 3
  r2 = add sub f64 1.0 q_ln f64 2.0 q_log1p sub f64 0.0 q_exp f64 -2.0
  chk lt q_fabs sub q_ln q_sinh f64 1.0 r2 f64 0.00000000000001 4
  worst = f64 0.0
  a = f64 0.000000001
  while lt a f64 200.0
    rf = f64 0.0
    if lt a f64 0.001
      a2 = mul a a
      rf = sub div a2 f64 6.0 div mul a2 a2 f64 180.0
    else
      if gt a f64 40.0
        rf = add sub a q_ln mul f64 2.0 a q_log1p sub f64 0.0 q_exp mul f64 -2.0 a
      else
        rf = q_ln div q_sinh a a
      end
    end
    er = q_fabs sub rf tyq_lnsinhc a
    if gt er worst
      worst = er
    end
    a = mul a f64 1.37
  end
  chk lt worst f64 0.00000000000001 5
  chk eq tyq_lnsinhc f64 0.0 f64 0.0 6
end

fn test_simpson_one si f64 zt f64 k long to void
  m = sub mul add f64 k f64 0.5 q_delta mul zt si
  chk eq qkat_ref si m k 0 10
  rb = get g_qret_f 4
  set_g 0 0 m si
  chk eq ty_qcont_bits 0 k TYQ_OK 11
  chk eq get g_qret_u 0 0 12
  tol = add f64 0.0000002 mul f64 0.000000000001 rb
  err = q_fabs sub get g_qret_f 0 rb
  chk le err tol 13
end

fn test_simpson_kats to void
  put g_tq_ss 0 q_sd_min
  put g_tq_ss 1 f64 1.0
  put g_tq_ss 2 f64 1000.0
  put g_tq_zs 0 f64 0.0
  put g_tq_zs 1 f64 1.0
  put g_tq_zs 2 f64 5.0
  put g_tq_zs 3 f64 30.0
  put g_tq_zs 4 f64 2048.0
  put g_tq_zs 5 f64 4096.0
  put g_tq_ks 0 -12345
  put g_tq_ks 1 777777
  put g_tq_ks 2 0
  put g_tq_ks 3 -1
  for i ulong 3
    si = get g_tq_ss i
    for j ulong 6
      zj = get g_tq_zs j
      for q ulong 4
        kv = get g_tq_ks q
        test_simpson_one si zj kv
        test_simpson_one si sub f64 0.0 zj kv
      end
    end
  end
  chk eq qkat_ref f64 0.00001 f64 0.25 5 0 14
  rb = get g_qret_f 4
  set_g 0 0 f64 0.25 f64 0.00001
  chk eq ty_qcont_bits 0 5 TYQ_OK 15
  chk eq get g_qret_u 0 1 16
  chk le q_fabs sub get g_qret_f 0 rb add f64 0.0000002 mul f64 0.000000000001 rb 17
end

fn test_refusals to void
  nan = q_nan
  inf = q_inf
  ninf = sub f64 0.0 inf
  set_g 0 0 nan f64 1.0
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 20
  set_g 0 0 inf f64 1.0
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 21
  set_g 0 0 ninf f64 1.0
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 22
  set_g 0 0 f64 0.0 nan
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 23
  set_g 0 0 f64 0.0 inf
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 24
  set_g 0 0 f64 0.0 f64 0.0
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 25
  set_g 0 0 f64 0.0 f64 -1.0
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 26
  set_g 0 0 f64 0.0 bitcast f64 shl ulong 0x80000000 32
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 27
  set_g 0 0 f64 0.0 f64 1.0
  chk eq ty_qcont_bits 0 TYQ_K_LIMIT TYQ_FAIL_PROTOCOL 28
  chk eq ty_qcont_bits 0 sub 0 TYQ_K_LIMIT TYQ_FAIL_PROTOCOL 29
  chk eq ty_qcont_bits 0 sub TYQ_K_LIMIT 1 TYQ_OK 30
  put g_qp_fam 0 TYQ_FAM_STUDENT
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 31
  put g_qp_fam 0 TYQ_FAM_MIX
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 32
  put g_qp_fam 0 77
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 33
  set_g 0 0 sub mul f64 0.5 q_delta f64 1000000.0 f64 1.0
  chk eq ty_qcont_bits 0 0 TYQ_OK 34
  chk and q_isfinite get g_qret_f 0 gt get g_qret_f 0 f64 700000000000.0 35
  chk eq ty_qcont_point_ub 0 0 TYQ_OK 36
  chk gt get g_qret_i 0 0 37
  big150 = mul f64 1000000000000000.0 mul f64 1000000000000000.0 q_pow2i 400
  put g_qp_loc 0 sub mul f64 0.5 q_delta big150
  chk eq ty_qcont_bits 0 0 TYQ_OK 38
  chk eq ty_qcont_point_ub 0 0 TYQ_FAIL_PROTOCOL 39
  put g_qp_loc 0 sub mul f64 0.5 q_delta mul big150 q_pow2i 40
  chk eq ty_qcont_bits 0 0 TYQ_FAIL_PROTOCOL 40
  put g_qp_loc 0 sub mul f64 0.5 q_delta f64 10000000.0
  chk eq ty_qcont_bits 0 0 TYQ_OK 41
  chk eq ty_qcont_point_ub 0 0 TYQ_FAIL_PROTOCOL 42
end

fn test_symbol_and_ub to void
  chk eq long q_floor div mul f64 -0.5 q_delta q_delta -1 50
  set_g 0 0 f64 0.0 f64 1.0
  chk eq ty_qcont_bits 0 0 TYQ_OK 51
  exp_b = add f64 20.0 div q_hln2pi q_ln2
  chk lt q_fabs sub get g_qret_f 0 exp_b f64 0.000001 52
  b0 = get g_qret_f 0
  chk eq ty_qcont_point_ub 0 0 TYQ_OK 53
  chk eq get g_qret_i 0 q_llrint mul f64 1000000.0 b0 54
  set_g 0 0 f64 0.0 f64 1.0
  set_g 1 1 f64 0.5 f64 0.000001
  set_g 2 2 f64 -2.0 f64 3.0
  put g_qk_arr 0 0
  put g_qk_arr 1 524288
  put g_qk_arr 2 -100
  chk eq ty_qcont_sum_ub 0 0 3 TYQ_OK 55
  s_all = get g_qret_i 1
  h_all = get g_qret_u 1
  chk eq ty_qcont_point_ub 0 0 TYQ_OK 56
  e0 = get g_qret_i 0
  chk eq ty_qcont_point_ub 1 524288 TYQ_OK 57
  e1 = get g_qret_i 0
  chk eq get g_qret_u 0 1 58
  chk eq ty_qcont_point_ub 2 -100 TYQ_OK 59
  e2 = get g_qret_i 0
  chk and eq s_all add add e0 e1 e2 eq h_all 1 60
  put g_qp_sc 1 f64 -1.0
  chk eq ty_qcont_sum_ub 0 0 3 TYQ_FAIL_PROTOCOL 61
  chk eq ty_qcont_sum_ub 0 0 0 TYQ_OK 62
  chk and eq get g_qret_i 1 0 eq get g_qret_u 1 0 63
  for i ulong 4
    set_g i i sub mul f64 0.5 q_delta f64 2000000.0 f64 1.0
    put g_qk_arr i 0
  end
  chk eq ty_qcont_point_ub 0 0 TYQ_OK 64
  chk gt get g_qret_i 0 2000000000000000000 65
  chk eq ty_qcont_sum_ub 0 0 4 TYQ_FAIL_PROTOCOL 66
  chk eq ty_qcont_bytes_ub 0 TYQ_OK 67
  chk eq get g_qret_i 0 0 68
  chk eq ty_qcont_bytes_ub 1000 TYQ_OK 69
  chk eq get g_qret_i 0 8000000000 70
  chk eq ty_qcont_bytes_ub 4294967295 TYQ_OK 71
  chk eq get g_qret_i 0 mul long 8000000 long 4294967295 72
  chk eq ty_qcont_rider_ub 0 128 TYQ_OK 73
  chk eq get g_qret_i 0 0 74
  chk eq ty_qcont_rider_ub 0 0 TYQ_OK 75
  chk eq ty_qcont_rider_ub 2 128 TYQ_OK 76
  chk eq get g_qret_i 0 7000000 77
  chk eq ty_qcont_rider_ub 3 1 TYQ_OK 78
  chk eq get g_qret_i 0 0 79
  chk eq ty_qcont_rider_ub 1 0 TYQ_FAIL_PROTOCOL 80
  chk eq ty_qcont_rider_ub 1 3 TYQ_OK 81
  chk eq get g_qret_i 0 q_llrint mul f64 1000000.0 mul f64 0.5 q_log2 f64 3.0 82
  chk eq ty_qcont_floor_check 25 25600 TYQ_OK 83
  chk eq ty_qcont_floor_check 26 25600 TYQ_FAIL_FLOOR 84
  chk eq ty_qcont_floor_check 0 800 TYQ_OK 85
  chk eq ty_qcont_floor_check 1 800 TYQ_FAIL_FLOOR 86
  chk eq ty_qcont_floor_check or shl ulong 0xffffffff 32 ulong 0xffffffff 1 TYQ_FAIL_FLOOR 87
end

fn build_prd1 first ulong n ulong to ulong
  for i ulong 4
    put g_qwire i get t_p1_mag i
  end
  qw_wr32 0 4 1
  for i ulong n
    off = add PRD_HDR mul i PRD_REC
    qw_wr32 0 off add first i
    qw_wr32 0 add off 4 0
    qw_wrf 0 add off 8 mul f64 0.25 f64 i
    qw_wrf 0 add off 16 add f64 1.0 f64 i
  end
  ret add PRD_HDR mul n PRD_REC
end

fn mal_cp blen ulong to void
  for i ulong blen
    put g_qwire2 i get g_qwire i
  end
end

fn test_prd_mal blen ulong to void
  mal_cp blen
  put g_qwire2 0 uchar 88
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 100
  mal_cp blen
  qw_wr32 1 4 2
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 101
  mal_cp blen
  qw_wr32 1 4 0
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 102
  mal_cp blen
  chk eq ty_prd_parse 1 5 128 4 100 TYQ_FAIL_PROTOCOL 103
  chk eq ty_prd_parse 1 0 128 4 100 TYQ_FAIL_PROTOCOL 104
  chk eq ty_prd_parse 1 sub blen 1 128 4 100 TYQ_FAIL_PROTOCOL 105
  chk eq ty_prd_parse 1 sub blen 24 128 4 100 TYQ_FAIL_PROTOCOL 106
  put g_qwire2 blen uchar 0
  chk eq ty_prd_parse 1 add blen 1 128 4 100 TYQ_FAIL_PROTOCOL 107
  for i ulong 24
    put g_qwire2 add blen i uchar 0
  end
  chk eq ty_prd_parse 1 add blen 24 128 4 100 TYQ_FAIL_PROTOCOL 108
  mal_cp blen
  qw_wr32 1 32 134
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 109
  mal_cp blen
  qw_wr32 1 8 127
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 110
  mal_cp blen
  qw_wr32 1 32 128
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 111
  mal_cp blen
  qw_wr32 1 80 200
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 112
  mal_cp blen
  qw_wr32 1 12 1
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 113
  mal_cp blen
  qw_wr32 1 12 2
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 114
  mal_cp blen
  qw_wr32 1 12 3
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 115
  mal_cp blen
  qw_wr32 1 12 4294967295
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 116
  mal_cp blen
  qw_wrf 1 16 q_nan
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 117
  mal_cp blen
  qw_wrf 1 16 q_inf
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 118
  mal_cp blen
  qw_wrf 1 24 q_nan
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 119
  mal_cp blen
  qw_wrf 1 24 q_inf
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 120
  mal_cp blen
  qw_wrf 1 24 f64 0.0
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 121
  mal_cp blen
  qw_wrf 1 24 bitcast f64 shl ulong 0x80000000 32
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 122
  mal_cp blen
  qw_wrf 1 24 f64 -2.0
  chk eq ty_prd_parse 1 blen 128 4 100 TYQ_FAIL_PROTOCOL 123
end

fn test_prd to void
  blen = build_prd1 128 4
  chk eq ty_prd_parse 0 blen 128 4 0 TYQ_OK 90
  chk and eq get g_qp_idx 3 131 and eq get g_qp_loc 2 f64 0.5 and eq get g_qp_sc 2 f64 3.0 eq get g_qp_fam 2 0 91
  chk eq ty_prd_encode 0 128 4 TYQ_OK 92
  chk eq get g_qret_u 0 blen 93
  same = true
  for i ulong blen
    if ne get g_qwire i get g_qwire2 i
      same = false
    end
  end
  chk same 94
  chk eq ty_prd_parse 0 blen 128 0 0 TYQ_E_ARG 95
  test_prd_mal blen
  blen1 = build_prd1 0 1
  qw_wrf 0 24 f64 0.000000001
  chk eq ty_prd_parse 0 blen1 0 1 0 TYQ_OK 124
  set_g 0 0 f64 0.0 f64 1.0
  chk eq ty_prd_validate 0 TYQ_OK 125
  put g_qp_fam 0 TYQ_FAM_MIX
  chk eq ty_prd_validate 0 TYQ_FAIL_PROTOCOL 126
  set_g 0 0 f64 0.0 f64 0.0
  chk eq ty_prd_validate 0 TYQ_FAIL_PROTOCOL 127
  set_g 0 7 q_nan f64 1.0
  chk eq ty_prd_encode 0 7 1 TYQ_FAIL_PROTOCOL 128
  set_g 0 8 f64 0.0 f64 1.0
  chk eq ty_prd_encode 0 7 1 TYQ_FAIL_PROTOCOL 129
end

fn main to int
  test_lnsinhc
  test_simpson_kats
  test_refusals
  test_symbol_and_ub
  test_prd
  tq_puts t_tq_sum1
  tq_put_u64 get g_tq_chk 0
  tq_puts t_tq_sum2
  tq_put_u64 get g_tq_fl 0
  tq_puts t_tq_sum3
  if ne get g_tq_fl 0 0
    ret 1
  end
  ret 0
end

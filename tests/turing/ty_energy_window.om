note
note tests/turing/ty_energy_window.om -- Pure seeded OM-2 port of
note tests/turing/ty_energy_window.c (TURING Yield TY-4/TY-5 energy window runner).
note Concatenated after src/runtime/r15_measure.om.
note Supports:
note   --plan SEED ROUNDS
note   --shuffle SEED N
note   --out FILE --run ID --config CFG --cond COND --round R --pos K --secs S
note       --workload BIN --a SPEC --b SPEC [--m M --n N --seed-a SA --seed-b SB
note       --settle-ms MS --tool-cpu C]

const TYE_MAXS ulong 2048

text tye_f_plan "--plan"
text tye_f_shuf "--shuffle"
text tye_f_out "--out"
text tye_f_run "--run"
text tye_f_cfg "--config"
text tye_f_cond "--cond"
text tye_f_rnd "--round"
text tye_f_pos "--pos"
text tye_f_secs "--secs"
text tye_f_wl "--workload"
text tye_f_a "--a"
text tye_f_b "--b"
text tye_f_m "--m"
text tye_f_n "--n"
text tye_f_sa "--seed-a"
text tye_f_sb "--seed-b"
text tye_f_settle "--settle-ms"
text tye_f_tcpu "--tool-cpu"

text tye_c_idle "IDLE"
text tye_c_a "A"
text tye_c_b "B"
text tye_c_ab "AB"
text tye_d_run "run"
text tye_d_cfg "S0"
text tye_d_m "8192"
text tye_d_n "16384"
text tye_d_sa "1"
text tye_d_sb "2"

text tye_arg_tag "--tag"
text tye_arg_rz "--rz"
text tye_arg_m "--m"
text tye_arg_n "--n"
text tye_arg_cpus "--cpus"
text tye_arg_secs "--secs"
text tye_arg_seed "--seed"
text tye_ready_pfx "READY "
text tye_env_home "HOME="
text tye_quiet_suf "/workspace/.spark-quiet"

text tye_e_unk "ty_energy_window: unknown argument\n"
text tye_e_need "ty_energy_window: need --out --workload --a --b --secs\n"
text tye_e_out "ty_energy_window: cannot create output file (exists?)\n"

text tye_j_b0 "{\"record\":\"ty_window\",\"run\":\""
text tye_j_b1 "\",\"level\":\""
text tye_j_b2 "\",\"config\":\""
text tye_j_b3 "\",\"round\":"
text tye_j_b4 ",\"trial\":"
text tye_j_m0 ",\"meter_ok\":"
text tye_j_m1 ",\"meter_why\":\""
text tye_j_m2 "\",\"spawn_ok\":"
text tye_j_m3 ",\"planned_ns\":"
text tye_j_m4 ",\"settle_ns\":"
text tye_j_m5 ",\"go_ns\":"
text tye_j_m6 ",\"tool_cpu\":"
text tye_j_m7 ",\"m\":"
text tye_j_m8 ",\"n\":"
text tye_j_m9 ",\"spec_a\":\""
text tye_j_m10 "\",\"spec_b\":\""
text tye_j_m11 "\",\"quiet_present\":"
text tye_j_m12 ",\"quiet\":\""
text tye_j_qend "\""
text tye_j_e0 ",\"e0\":"
text tye_j_e1 ",\"e1\":"
text tye_j_es0 "{\"t_ns\":"
text tye_j_es1 ",\"spbm_ok\":"
text tye_j_es2 ",\"energy_uj\":["
text tye_j_es3 "],\"overflow\":["
text tye_j_es4 "],\"power_uw\":["
text tye_j_es5 "]}"
text tye_j_s0 ",\"s0\":"
text tye_j_s1 ",\"s1\":"
text tye_j_sn0 "{\"loadavg\":\""
text tye_j_sn1 "\",\"freq_khz\":["
text tye_j_sn2 "],\"temp_mc\":["
text tye_j_sn3 "],\"busy_jiffies\":["
text tye_j_sn4 "],\"total_jiffies\":["
text tye_j_sn5 "]}"
text tye_j_t0 ",\"tel\":{\"n\":"
text tye_j_t1 ",\"t_ns\":["
text tye_j_t2 "],\"ok\":["
text tye_j_t3 "],\"pkg\":["
text tye_j_t4 "],\"cpu_e\":["
text tye_j_t5 "],\"cpu_p\":["
text tye_j_t6 "]}"
text tye_j_p0 ",\"participants\":["
text tye_j_p1 "{\"ok\":"
text tye_j_p2 ",\"exit\":"
text tye_j_p3 ",\"ready\":\""
text tye_j_p4 "\",\"result\":"
text tye_j_null "null"
text tye_j_end "]}\n"

global g_tye_mix ulong 1
global g_tye_tmp uchar 256
global g_tye_tmp2 uchar 256
note String args: 0=out, 1=run, 2=cfg, 3=cond, 4=wl, 5=sa, 6=sb, 7=m, 8=n, 9=seed_a, 10=seed_b
global g_tye_str uchar 2816
global g_tye_slen ulong 12
note Numeric args: [0]=round, [1]=pos, [2]=secs, [3]=settle_ms, [4]=tool_cpu
global g_tye_num ulong 8

note Participant state (2 slots: 0=A, 1=B)
global g_tye_act ulong 2
global g_tye_nact ulong 1
global g_tye_pid int 2
global g_tye_wfd int 2
global g_tye_rfd int 2
global g_tye_exit long 2
global g_tye_ok ulong 2
global g_tye_rdy uchar 512
global g_tye_rdyl ulong 2
global g_tye_res uchar 32768
global g_tye_resl ulong 2
global g_tye_pkt uchar 2048
global g_tye_quiet uchar 256
global g_tye_qlen ulong 1

fn tye_mix_next to ulong
  z = add get g_tye_mix 0 ulong 0x9e3779b97f4a7c15
  put g_tye_mix 0 z
  z = mul xor z shr z 30 ulong 0xbf58476d1ce4e5b9
  z = mul xor z shr z 27 ulong 0x94d049bb133111eb
  ret xor z shr z 31
end

fn tye_tmp_eq n ulong s view uchar * to bool
  if ne n len s
    ret false
  end
  for i ulong n bound 256
    if ne get g_tye_tmp i get s i
      ret false
    end
  end
  ret true
end

fn tye_parse_seed_or_u64 n ulong to ulong
  if ge n 2
    if and eq get g_tye_tmp 0 48 or eq get g_tye_tmp 1 120 eq get g_tye_tmp 1 88
      v = ulong 0
      i = ulong 2
      while lt i n bound 32
        c = ulong get g_tye_tmp i
        d = ulong 0
        if and ge c 48 le c 57
          d = sub c 48
        else
          if and ge c 97 le c 102
            d = add sub c 97 10
          else
            if and ge c 65 le c 70
              d = add sub c 65 10
            else
              break
            end
          end
        end
        v = add mul v 16 d
        i = add i 1
      end
      ret v
    end
  end
  v2 = ulong 0
  for i ulong n bound 32
    c = ulong get g_tye_tmp i
    if or lt c 48 gt c 57
      break
    end
    v2 = add mul v2 10 sub c 48
  end
  ret v2
end

fn tye_wr_err s view uchar * to void
  n = len s
  ign = write 2 s 0 n
end

fn tye_print_plan seed ulong rounds ulong to int
  r15m_ob_init 1
  put g_tye_mix 0 seed
  ord = new ulong 4 0
  for r ulong rounds bound 10000
    put ord 0 0
    put ord 1 1
    put ord 2 2
    put ord 3 3
    i = ulong 3
    while gt i 0 bound 4
      j = rem tye_mix_next add i 1
      tmp = get ord i
      put ord i get ord j
      put ord j tmp
      i = sub i 1
    end
    for k ulong 4
      r15m_ob_u64 r
      r15m_ob_ch 32
      r15m_ob_u64 k
      r15m_ob_ch 32
      cid = get ord k
      if eq cid 0
        r15m_ob_txt tye_c_idle
      end
      if eq cid 1
        r15m_ob_txt tye_c_a
      end
      if eq cid 2
        r15m_ob_txt tye_c_b
      end
      if eq cid 3
        r15m_ob_txt tye_c_ab
      end
      r15m_ob_ch 10
    end
  end
  ign = r15m_ob_flush
  ret 0
end

fn tye_print_shuffle seed ulong n ulong to int
  if or lt n 1 gt n 64
    ret 64
  end
  r15m_ob_init 1
  ord = new ulong 64 0
  for i ulong n bound 64
    put ord i i
  end
  put g_tye_mix 0 seed
  i = sub n 1
  while gt i 0 bound 64
    j = rem tye_mix_next add i 1
    tmp = get ord i
    put ord i get ord j
    put ord j tmp
    i = sub i 1
  end
  for k ulong n bound 64
    r15m_ob_u64 get ord k
    r15m_ob_ch 10
  end
  ign = r15m_ob_flush
  ret 0
end

fn tye_set_str_txt idx ulong s view uchar * to void
  base = mul idx 256
  n = len s
  for i ulong n bound 255
    put g_tye_str add base i get s i
  end
  put g_tye_slen idx n
end

fn tye_set_str_arg idx ulong argi ulong to void
  base = mul idx 256
  vlen = argread argi g_tye_tmp2 0 255
  if lt vlen 0
    put g_tye_slen idx 0
    ret
  end
  un = ulong vlen
  for i ulong un bound 255
    put g_tye_str add base i get g_tye_tmp2 i
  end
  put g_tye_slen idx un
end

fn tye_ob_str idx ulong to void
  base = mul idx 256
  n = get g_tye_slen idx
  for i ulong n bound 256
    r15m_ob_ch get g_tye_str add base i
  end
end

fn tye_init_defaults to void
  for i ulong 12
    put g_tye_slen i 0
  end
  tye_set_str_txt 1 tye_d_run
  tye_set_str_txt 2 tye_d_cfg
  tye_set_str_txt 3 tye_c_idle
  tye_set_str_txt 7 tye_d_m
  tye_set_str_txt 8 tye_d_n
  tye_set_str_txt 9 tye_d_sa
  tye_set_str_txt 10 tye_d_sb
  put g_tye_num 0 0
  put g_tye_num 1 0
  put g_tye_num 2 30
  put g_tye_num 3 2000
  put g_tye_num 4 0
end

fn tye_parse_one_arg i ulong to int
  klen = argread i g_tye_tmp 0 255
  if le klen 0
    ret 64
  end
  uk = ulong klen
  if tye_tmp_eq uk tye_f_out
    tye_set_str_arg 0 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_run
    tye_set_str_arg 1 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_cfg
    tye_set_str_arg 2 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_cond
    tye_set_str_arg 3 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_wl
    tye_set_str_arg 4 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_a
    tye_set_str_arg 5 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_b
    tye_set_str_arg 6 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_m
    tye_set_str_arg 7 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_n
    tye_set_str_arg 8 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_sa
    tye_set_str_arg 9 add i 1
    ret 0
  end
  if tye_tmp_eq uk tye_f_sb
    tye_set_str_arg 10 add i 1
    ret 0
  end
  ret 1
end

fn tye_parse_num_arg i ulong to int
  klen = argread i g_tye_tmp 0 255
  uk = ulong klen
  which = ulong 99
  if tye_tmp_eq uk tye_f_rnd
    which = ulong 0
  end
  if tye_tmp_eq uk tye_f_pos
    which = ulong 1
  end
  if tye_tmp_eq uk tye_f_secs
    which = ulong 2
  end
  if tye_tmp_eq uk tye_f_settle
    which = ulong 3
  end
  if tye_tmp_eq uk tye_f_tcpu
    which = ulong 4
  end
  if eq which 99
    ret 64
  end
  vlen = argread add i 1 g_tye_tmp 0 255
  if le vlen 0
    ret 64
  end
  put g_tye_num which tye_parse_seed_or_u64 ulong vlen
  ret 0
end

fn tye_pkt_put_u16 pos ulong v ulong to ulong
  put g_tye_pkt pos uchar and v 255
  put g_tye_pkt add pos 1 uchar and shr v 8 255
  ret add pos 2
end

fn tye_pkt_add_txt pos ulong s view uchar * to ulong
  n = len s
  p = tye_pkt_put_u16 pos n
  for i ulong n bound 256
    put g_tye_pkt add p i get s i
  end
  ret add p n
end

fn tye_pkt_add_str pos ulong idx ulong off ulong n ulong to ulong
  base = add mul idx 256 off
  p = tye_pkt_put_u16 pos n
  for i ulong n bound 256
    put g_tye_pkt add p i get g_tye_str add base i
  end
  ret add p n
end

fn tye_pkt_add_u64 pos ulong v ulong to ulong
  dig = new uchar 24 0
  nd = ulong 0
  if eq v 0
    put dig 0 48
    nd = ulong 1
  else
    x = v
    while gt x 0 bound 24
      put dig nd uchar add 48 rem x 10
      x = div x 10
      nd = add nd 1
    end
  end
  p = tye_pkt_put_u16 pos nd
  k = nd
  while gt k 0 bound 24
    k = sub k 1
    put g_tye_pkt p get dig k
    p = add p 1
  end
  ret p
end

fn tye_build_exec_pkt slot ulong to ulong
  spec_idx = add 5 slot
  spec_len = get g_tye_slen spec_idx
  spec_base = mul spec_idx 256
  colon = spec_len
  for i ulong spec_len bound 256
    if eq get g_tye_str add spec_base i 58
      colon = i
      break
    end
  end
  if or eq colon 0 ge add colon 1 spec_len
    ret 0
  end
  p = tye_pkt_put_u16 0 15
  p = tye_pkt_add_str p 4 0 get g_tye_slen 4
  p = tye_pkt_add_txt p tye_arg_tag
  if eq slot 0
    p = tye_pkt_add_txt p tye_c_a
  else
    p = tye_pkt_add_txt p tye_c_b
  end
  p = tye_pkt_add_txt p tye_arg_rz
  p = tye_pkt_add_str p spec_idx 0 colon
  p = tye_pkt_add_txt p tye_arg_m
  p = tye_pkt_add_str p 7 0 get g_tye_slen 7
  p = tye_pkt_add_txt p tye_arg_n
  p = tye_pkt_add_str p 8 0 get g_tye_slen 8
  p = tye_pkt_add_txt p tye_arg_cpus
  p = tye_pkt_add_str p spec_idx add colon 1 sub spec_len add colon 1
  p = tye_pkt_add_txt p tye_arg_secs
  p = tye_pkt_add_u64 p get g_tye_num 2
  p = tye_pkt_add_txt p tye_arg_seed
  p = tye_pkt_add_str p add 9 slot 0 get g_tye_slen add 9 slot
  ret p
end

fn tye_read_fd_u32 buf view uchar 8 off ulong to int
  b0 = ulong get buf off
  b1 = shl ulong get buf add off 1 8
  b2 = shl ulong get buf add off 2 16
  b3 = shl ulong get buf add off 3 24
  ret int or or b0 b1 or b2 b3
end

fn tye_read_line_into_rdy slot ulong fd int to ulong
  base = mul slot 256
  got = ulong 0
  ch = new uchar 1 0
  while lt got 255 bound 512
    r = read fd ch 0 1
    if eq r neg long 4
      continue
    end
    if le r 0
      break
    end
    c = get ch 0
    if eq c 10
      break
    end
    if ne c 13
      put g_tye_rdy add base got c
      got = add got 1
    end
  end
  put g_tye_rdyl slot got
  ret got
end

fn tye_read_line_into_res slot ulong fd int to ulong
  base = mul slot 16384
  got = ulong 0
  ch = new uchar 1 0
  while lt got 16383 bound 32768
    r = read fd ch 0 1
    if eq r neg long 4
      continue
    end
    if le r 0
      break
    end
    c = get ch 0
    if eq c 10
      break
    end
    if ne c 13
      put g_tye_res add base got c
      got = add got 1
    end
  end
  put g_tye_resl slot got
  ret got
end

fn tye_rdy_ok slot ulong to bool
  n = get g_tye_rdyl slot
  if lt n len tye_ready_pfx
    ret false
  end
  base = mul slot 256
  for i ulong len tye_ready_pfx
    if ne get g_tye_rdy add base i get tye_ready_pfx i
      ret false
    end
  end
  ret true
end

fn tye_spawn_part slot ulong to int
  pktlen = tye_build_exec_pkt slot
  if eq pktlen 0
    ret -1
  end
  pin = new uchar 8 0
  pout = new uchar 8 0
  if ne pipefds pin 0 8 0 0
    ret -1
  end
  if ne pipefds pout 0 8 0 0
    ret -1
  end
  in_r = tye_read_fd_u32 pin 0
  in_w = tye_read_fd_u32 pin 4
  out_r = tye_read_fd_u32 pout 0
  out_w = tye_read_fd_u32 pout 4
  pid = fork
  if lt pid 0
    ret -1
  end
  if eq pid 0
    ign = dupfd in_r 0 0
    ign = dupfd out_w 1 0
    ign = fclose in_w
    ign = fclose out_r
    ign = fclose in_r
    ign = fclose out_w
    ign = execprog g_tye_pkt 0 pktlen
    exit 127
  end
  ign2 = fclose in_r
  ign2 = fclose out_w
  put g_tye_pid slot int pid
  put g_tye_wfd slot in_w
  put g_tye_rfd slot out_r
  ign2 = long tye_read_line_into_rdy slot out_r
  if not tye_rdy_ok slot
    ret -1
  end
  ret 0
end

fn tye_read_quiet to ulong
  put g_tye_qlen 0 0
  ec = ulong envcnt
  hlen = ulong 0
  for i ulong ec bound 512
    n = envread i g_tye_tmp 0 255
    if ge n 5
      m = true
      for k ulong 5
        if ne get g_tye_tmp k get tye_env_home k
          m = false
        end
      end
      if m
        hlen = sub ulong n 5
        for j ulong hlen bound 200
          put g_r15_pbuf j get g_tye_tmp add 5 j
        end
        break
      end
    end
  end
  plen = r15m_pbuf_txt hlen tye_quiet_suf
  nl = r15m_read_line_pbuf plen
  if lt nl 0
    ret 0
  end
  un = ulong nl
  if gt un 255
    un = ulong 255
  end
  for j ulong un bound 256
    c = get g_r15_lbuf j
    if or or eq c 34 eq c 92 lt c 32
      c = uchar 32
    end
    put g_tye_quiet j c
  end
  put g_tye_qlen 0 un
  ret 1
end

fn tye_emit_energy slot ulong to void
  r15m_ob_txt tye_j_es0
  r15m_ob_u64 get g_r15_et slot
  r15m_ob_txt tye_j_es1
  r15m_ob_u64 get g_r15_eok slot
  r15m_ob_txt tye_j_es2
  base = mul slot 5
  for i ulong 5
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_euj add base i
  end
  r15m_ob_txt tye_j_es3
  for i ulong 5
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_eovf add base i
  end
  r15m_ob_txt tye_j_es4
  for i ulong 5
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_epw add base i
  end
  r15m_ob_txt tye_j_es5
end

fn tye_emit_snap slot ulong to void
  r15m_ob_txt tye_j_sn0
  lbase = mul slot 96
  ln = get g_r15_load_len slot
  for i ulong ln bound 96
    r15m_ob_ch get g_r15_load add lbase i
  end
  r15m_ob_txt tye_j_sn1
  cbase = mul slot R15M_NCPU
  for c ulong R15M_NCPU
    if gt c 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_freq add cbase c
  end
  r15m_ob_txt tye_j_sn2
  nz = get g_r15_nzone slot
  zbase = mul slot R15M_NZONE
  for z ulong nz bound 16
    if gt z 0
      r15m_ob_ch 44
    end
    r15m_ob_i64 get g_r15_temp add zbase z
  end
  r15m_ob_txt tye_j_sn3
  for c ulong R15M_NCPU
    if gt c 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_busy add cbase c
  end
  r15m_ob_txt tye_j_sn4
  for c ulong R15M_NCPU
    if gt c 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_tot add cbase c
  end
  r15m_ob_txt tye_j_sn5
end

fn tye_emit_tel ns ulong to void
  r15m_ob_txt tye_j_t0
  r15m_ob_u64 ns
  r15m_ob_txt tye_j_t1
  for i ulong ns bound 2048
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_et add 2 i
  end
  r15m_ob_txt tye_j_t2
  for i ulong ns bound 2048
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_eok add 2 i
  end
  r15m_ob_txt tye_j_t3
  for i ulong ns bound 2048
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_euj add mul add 2 i 5 0
  end
  r15m_ob_txt tye_j_t4
  for i ulong ns bound 2048
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_euj add mul add 2 i 5 1
  end
  r15m_ob_txt tye_j_t5
  for i ulong ns bound 2048
    if gt i 0
      r15m_ob_ch 44
    end
    r15m_ob_u64 get g_r15_euj add mul add 2 i 5 2
  end
  r15m_ob_txt tye_j_t6
end

fn tye_emit_parts to void
  nact = get g_tye_nact 0
  r15m_ob_txt tye_j_p0
  for k ulong nact bound 2
    slot = get g_tye_act k
    if gt k 0
      r15m_ob_ch 44
    end
    r15m_ob_txt tye_j_p1
    r15m_ob_u64 get g_tye_ok slot
    r15m_ob_txt tye_j_p2
    r15m_ob_i64 get g_tye_exit slot
    r15m_ob_txt tye_j_p3
    rbase = mul slot 256
    rn = get g_tye_rdyl slot
    for i ulong rn bound 256
      r15m_ob_ch get g_tye_rdy add rbase i
    end
    r15m_ob_txt tye_j_p4
    jbase = mul slot 16384
    jn = get g_tye_resl slot
    is_obj = false
    if gt jn 0
      if eq get g_tye_res jbase 123
        is_obj = true
      end
    end
    if is_obj
      for i ulong jn bound 16384
        r15m_ob_ch get g_tye_res add jbase i
      end
    else
      r15m_ob_txt tye_j_null
    end
    r15m_ob_ch 125
  end
  r15m_ob_txt tye_j_end
end

fn tye_cond_has c uchar to bool
  n = get g_tye_slen 3
  base = ulong 768
  if eq n 4
    if and eq get g_tye_str base 73 eq get g_tye_str add base 1 68
      ret false
    end
  end
  for i ulong n bound 16
    if eq get g_tye_str add base i c
      ret true
    end
  end
  ret false
end

fn tye_write_window_json ofd int meter_ok ulong spawn_ok ulong qpres ulong t_go ulong ns ulong to int
  r15m_ob_init ofd
  r15m_ob_txt tye_j_b0
  tye_ob_str 1
  r15m_ob_txt tye_j_b1
  tye_ob_str 3
  r15m_ob_txt tye_j_b2
  tye_ob_str 2
  r15m_ob_txt tye_j_b3
  r15m_ob_u64 get g_tye_num 0
  r15m_ob_txt tye_j_b4
  r15m_ob_u64 get g_tye_num 1
  r15m_ob_txt tye_j_m0
  r15m_ob_u64 meter_ok
  r15m_ob_txt tye_j_m1
  for i ulong get g_r15_why_len 0 bound 256
    r15m_ob_ch get g_r15_why i
  end
  r15m_ob_txt tye_j_m2
  r15m_ob_u64 spawn_ok
  r15m_ob_txt tye_j_m3
  r15m_ob_u64 mul get g_tye_num 2 1000000000
  r15m_ob_txt tye_j_m4
  r15m_ob_u64 mul get g_tye_num 3 1000000
  r15m_ob_txt tye_j_m5
  r15m_ob_u64 t_go
  r15m_ob_txt tye_j_m6
  r15m_ob_u64 get g_tye_num 4
  r15m_ob_txt tye_j_m7
  tye_ob_str 7
  r15m_ob_txt tye_j_m8
  tye_ob_str 8
  r15m_ob_txt tye_j_m9
  tye_ob_str 5
  r15m_ob_txt tye_j_m10
  tye_ob_str 6
  r15m_ob_txt tye_j_m11
  r15m_ob_u64 qpres
  r15m_ob_txt tye_j_m12
  for i ulong get g_tye_qlen 0 bound 256
    r15m_ob_ch get g_tye_quiet i
  end
  r15m_ob_txt tye_j_qend
  r15m_ob_txt tye_j_e0
  tye_emit_energy 0
  r15m_ob_txt tye_j_e1
  tye_emit_energy 1
  r15m_ob_txt tye_j_s0
  tye_emit_snap 0
  r15m_ob_txt tye_j_s1
  tye_emit_snap 1
  tye_emit_tel ns
  tye_emit_parts
  ret r15m_ob_flush
end

fn tye_collect_one slot ulong to void
  wst = new uchar 4 0
  rl = tye_read_line_into_res slot get g_tye_rfd slot
  ign = waitpid get g_tye_pid slot wst 0 4 0
  st = or ulong get wst 0 shl ulong get wst 1 8
  ec = long -1
  if eq and st 127 0
    ec = long and shr st 8 255
  end
  put g_tye_exit slot ec
  okp = ulong 0
  if and eq ec 0 gt rl 0
    if eq get g_tye_res mul slot 16384 123
      okp = ulong 1
    end
  end
  put g_tye_ok slot okp
  ign = fclose get g_tye_wfd slot
  ign = fclose get g_tye_rfd slot
end

fn tye_collect_parts to void
  nact = get g_tye_nact 0
  for k ulong nact bound 2
    tye_collect_one get g_tye_act k
  end
end

fn tye_sample_until end_ns ulong meter_ok ulong to ulong
  ns = ulong 0
  while lt ulong monons end_ns bound 4096
    if eq meter_ok 1
      if lt ns TYE_MAXS
        r15m_energy_read add 2 ns
        ns = add ns 1
      end
    end
    now = ulong monons
    if ge now end_ns
      break
    end
    remt = sub end_ns now
    step = ulong 100000000
    if lt remt step
      step = remt
    end
    if gt step 0
      ign_sl = sleepns long step
    end
  end
  ret ns
end

fn tye_pin_self to void
  mask = new uchar 16 0
  tcpu = get g_tye_num 4
  if lt tcpu 128
    put mask div tcpu 8 uchar shl ulong 1 rem tcpu 8
    ign = cpuset 0 mask 0 16
  end
end

fn tye_spawn_all to ulong
  nact = ulong 0
  if tye_cond_has 65
    put g_tye_act nact 0
    nact = add nact 1
  end
  if tye_cond_has 66
    put g_tye_act nact 1
    nact = add nact 1
  end
  put g_tye_nact 0 nact
  ok = ulong 1
  for k ulong nact bound 2
    if ne tye_spawn_part get g_tye_act k 0
      ok = ulong 0
    end
  end
  ret ok
end

fn tye_send_go to ulong
  gob = new uchar 1 103
  ok = ulong 1
  nact = get g_tye_nact 0
  for k ulong nact bound 2
    slot = get g_tye_act k
    if ne write get g_tye_wfd slot gob 0 1 1
      ok = ulong 0
    end
  end
  ret ok
end

fn tye_run_window to int
  ofd = fopen g_tye_str 0 get g_tye_slen 0 R15M_O_EXCL_CREATE 420
  if lt ofd 0
    tye_wr_err tye_e_out
    ret 2
  end
  tye_pin_self
  meter_ok = ulong 0
  if eq r15m_spbm_attach 0
    meter_ok = ulong 1
  end
  spawn_ok = tye_spawn_all
  if gt get g_tye_num 3 0
    ign = sleepns long mul get g_tye_num 3 1000000
  end
  r15m_take_snap 0
  qpres = tye_read_quiet
  r15m_energy_read 0
  t_go = ulong monons
  if eq tye_send_go 0
    spawn_ok = ulong 0
  end
  ns = tye_sample_until add t_go mul get g_tye_num 2 1000000000 meter_ok
  if gt get g_tye_nact 0 0
    tye_collect_parts
  end
  r15m_energy_read 1
  r15m_take_snap 1
  fl = tye_write_window_json int ofd meter_ok spawn_ok qpres t_go ns
  ign2 = fclose int ofd
  if and and eq fl 0 eq meter_ok 1 eq spawn_ok 1
    ret 0
  end
  ret 1
end

fn main to int
  ac = ulong argcnt
  if eq ac 4
    n1 = argread 1 g_tye_tmp 0 255
    if gt n1 0
      if tye_tmp_eq ulong n1 tye_f_plan
        n2 = argread 2 g_tye_tmp 0 255
        seed = tye_parse_seed_or_u64 ulong n2
        n3 = argread 3 g_tye_tmp 0 255
        rounds = tye_parse_seed_or_u64 ulong n3
        ret tye_print_plan seed rounds
      end
      if tye_tmp_eq ulong n1 tye_f_shuf
        n2 = argread 2 g_tye_tmp 0 255
        seed = tye_parse_seed_or_u64 ulong n2
        n3 = argread 3 g_tye_tmp 0 255
        cnt = tye_parse_seed_or_u64 ulong n3
        ret tye_print_shuffle seed cnt
      end
    end
  end
  tye_init_defaults
  i = ulong 1
  while lt add i 1 ac bound 64
    rc = tye_parse_one_arg i
    if eq rc 1
      rc = tye_parse_num_arg i
    end
    if ne rc 0
      tye_wr_err tye_e_unk
      ret 64
    end
    i = add i 2
  end
  miss = eq get g_tye_slen 0 0
  if eq get g_tye_slen 4 0
    miss = true
  end
  if eq get g_tye_slen 5 0
    miss = true
  end
  if eq get g_tye_slen 6 0
    miss = true
  end
  if eq get g_tye_num 2 0
    miss = true
  end
  if miss
    tye_wr_err tye_e_need
    ret 64
  end
  ret tye_run_window
end

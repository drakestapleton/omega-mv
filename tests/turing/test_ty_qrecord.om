fn test_records to void
  put g_t_lcg 0 ulong 0x243f6a8885a308d3
  mk_profile
  save_prof
  chk 1 eq tyqr_profile_digest 0 TY_OK
  chk 2 eq tyqr_profile_digest 1 TY_OK
  chk 3 dg_eq 0 1
  chk 4 eq tyqr_profile_verify 0 TY_OK
  chk 5 kat_eq 0 t_q_kat_prof

  mk_freeze 0 0
  save_freeze
  qr_load_dig 2 0 6
  chk 6 eq tyqr_freeze_digest 2 TY_OK
  chk 7 kat_eq 2 t_q_kat_fc
  mk_freeze 0 1
  chk 8 eq tyqr_freeze_digest 3 TY_OK
  chk 9 kat_eq 3 t_q_kat_fd
  chk 10 not dg_eq 2 3
  rest_freeze

  mk_world 0 2
  save_world
  chk 11 eq tyqr_world_digest 4 TY_OK
  chk 12 kat_eq 4 t_q_kat_world

  mk_gain 0 4 2 6
  save_gain
  chk 13 eq tyqr_gain_digest 5 TY_OK
  chk 14 kat_eq 5 t_q_kat_gain
  chk 15 eq tyqr_gain_bind 5 4 2 0 TY_OK

  note Field changes move digest
  put g_qp_u 0 add get g_qp_u 0 1
  chk 21 and eq tyqr_profile_digest 7 TY_OK not dg_eq 7 0
  rest_prof
  put g_qp_i 0 sub get g_qp_i 0 1
  chk 22 and eq tyqr_profile_digest 7 TY_OK not dg_eq 7 0
  rest_prof
  qr_set_str 0 5 t_q_f02
  chk 23 and eq tyqr_profile_digest 7 TY_OK not dg_eq 7 0
  rest_prof
  put g_qp_d 101 xor get g_qp_d 101 uchar 1
  chk 24 and eq tyqr_profile_digest 7 TY_OK not dg_eq 7 0
  rest_prof
  put g_qw_u 0 add get g_qw_u 0 1
  chk 25 and eq tyqr_world_digest 7 TY_OK not dg_eq 7 4
  rest_world
  put g_qg_i 10 add get g_qg_i 10 1
  chk 26 and eq tyqr_gain_digest 7 TY_OK not dg_eq 7 5
  rest_gain
  put g_qg_i 12 0
  chk 27 and eq tyqr_gain_digest 7 TY_OK not dg_eq 7 5
  rest_gain

  note Verify tamper -> TY_E_DIGEST
  put g_qp_u 3 add get g_qp_u 3 1
  chk 31 eq tyqr_profile_verify 0 TY_E_DIGEST
  rest_prof
  put g_qw_u 2 add get g_qw_u 2 1
  chk 32 eq tyqr_world_verify 4 TY_E_DIGEST
  rest_world
  put g_qf_u 1 1
  chk 33 eq tyqr_freeze_verify 2 TY_E_DIGEST
  rest_freeze
  put g_qg_i 8 add get g_qg_i 8 1
  chk 34 eq tyqr_gain_verify 5 TY_E_DIGEST
  rest_gain
  dg_cp 7 5
  put g_dig 224 xor get g_dig 224 uchar 1
  chk 35 eq tyqr_gain_verify 7 TY_E_DIGEST

  test_rec_ref_prof
  test_rec_ref_world
  test_rec_ref_freeze
  test_rec_ref_gain1
  test_rec_ref_gain2
  test_rec_bind
end

note ---- Test 2: Files (write-once, mode 0444, tamper, cleanup) ----
fn make_test_dir to ulong
  n = len t_q_tmpdir
  for i ulong n bound 64
    put g_t_dir i get t_q_tmpdir i
  end
  pid = ulong getpid
  dig = new uchar 24 0
  k = ulong 0
  x = pid
  while true bound 24
    put dig k uchar add 48 rem x 10
    k = add k 1
    x = div x 10
    if eq x 0
      break
    end
  end
  while gt k 0 bound 24
    k = sub k 1
    put g_t_dir n get dig k
    n = add n 1
  end
  put g_t_dlen 0 n
  mk = makedir g_t_dir 0 n int 493
  chk 600 eq mk 0
  ret n
end

fn cp_wpath_to_p1 to void
  l = get g_qr_wplen 0
  for i ulong l bound 1024
    put g_t_p1 i get g_qr_wpath i
  end
  put g_t_p1l 0 l
end

fn cp_wpath_to_p2 to void
  l = get g_qr_wplen 0
  for i ulong l bound 1024
    put g_t_p2 i get g_qr_wpath i
  end
  put g_t_p2l 0 l
end

fn p1_eq_p2 to bool
  l1 = get g_t_p1l 0
  if ne l1 get g_t_p2l 0
    ret false
  end
  for i ulong l1 bound 1024
    if ne get g_t_p1 i get g_t_p2 i
      ret false
    end
  end
  ret true
end

note C: strstr(path, hex) and strstr(path, "turing.qprofile."); the OM writer
note puts them at fixed places, so check the exact name <dir>/turing.qprofile.<hex>.omg0
fn p1_names_digest slot ulong to bool
  dl = get g_t_dlen 0
  pl = get g_t_p1l 0
  ql = len t_q_qpdot
  if ne pl add add dl 1 add ql 69
    ret false
  end
  for i ulong dl bound 128
    if ne get g_t_p1 i get g_t_dir i
      ret false
    end
  end
  if ne get g_t_p1 dl 47
    ret false
  end
  b = add dl 1
  for i ulong ql bound 32
    if ne get g_t_p1 add b i get t_q_qpdot i
      ret false
    end
  end
  h = new uchar 64 0
  dg_to_hex slot h
  b = add b ql
  for i ulong 64
    if ne get g_t_p1 add b i get h i
      ret false
    end
  end
  ret true
end

fn rdu32_le b view uchar 128 off ulong to ulong
  b0 = ulong get b off
  b1 = shl ulong get b add off 1 8
  b2 = shl ulong get b add off 2 16
  b3 = shl ulong get b add off 3 24
  ret or or b0 b1 or b2 b3
end

fn rdu64_le b view uchar 128 off ulong to ulong
  lo = rdu32_le b off
  hi = rdu32_le b add off 4
  ret or lo shl hi 32
end

fn rm_wpath to void
  l = get g_qr_wplen 0
  ign1 = chmod g_qr_wpath 0 l int 420
  ign2 = unlink g_qr_wpath 0 l
end

fn test_file_tamper dlen ulong to void
  fd = fopen g_t_p1 0 get g_t_p1l 0 int 0 int 0
  chk 610 ge fd 0
  tot = ulong 0
  if ge fd 0
    while lt tot 40000 bound 40000
      k = read int fd g_t_tmpx tot sub 40000 tot
      if le k 0
        break
      end
      tot = add tot ulong k
    end
    ign = fclose int fd
  end
  chk 611 gt tot 10
  for i ulong dlen bound 128
    put g_t_tmpf i get g_t_dir i
  end
  tl = len t_q_tamp
  for i ulong tl bound 32
    put g_t_tmpf add dlen i get t_q_tamp i
  end
  tlen = add dlen tl
  step = add div tot 7 1
  pos = ulong 0
  while lt pos tot bound 16
    put g_t_tmpx pos xor get g_t_tmpx pos uchar 1
    fw = fopen g_t_tmpf 0 tlen int 577 int 420
    chk 612 ge fw 0
    if ge fw 0
      wo = ulong 0
      while lt wo tot bound 40000
        wk = write int fw g_t_tmpx wo sub tot wo
        if le wk 0
          break
        end
        wo = add wo ulong wk
      end
      ign2 = fclose int fw
      chk 613 eq wo tot
    end
    put g_t_tmpx pos xor get g_t_tmpx pos uchar 1
    for i ulong tlen bound 1024
      put g_path i get g_t_tmpf i
    end
    put g_plen 0 tlen
    chk 614 eq tyqr_file_verify_gp t_qr_dom_prof 20 TY_E_DIGEST
    ign3 = unlink g_t_tmpf 0 tlen
    pos = add pos step
  end
end

fn test_files to void
  put g_t_lcg 0 ulong 0x13198a2e03707344
  dlen = make_test_dir
  dir = new uchar 128 0
  for i ulong dlen bound 128
    put dir i get g_t_dir i
  end
  mk_profile
  chk 601 eq tyqr_profile_write dir dlen 20 TY_OK
  cp_wpath_to_p1
  chk 609 p1_names_digest 20
  st = new uchar 128 0
  chk 602 eq stat g_t_p1 0 get g_t_p1l 0 st 0 128 0
  mode = and rdu32_le st 16 511
  sz = rdu64_le st 48
  chk 603 and eq mode 292 gt sz 0
  for i ulong get g_t_p1l 0 bound 1024
    put g_path i get g_t_p1 i
  end
  put g_plen 0 get g_t_p1l 0
  chk 604 eq tyqr_file_verify_gp t_qr_dom_prof 20 TY_OK
  chk 605 eq tyqr_file_verify_gp t_qr_dom_world 20 TY_E_DIGEST
  chk 606 eq tyqr_profile_write dir dlen 21 TYQR_E_EXISTS
  cp_wpath_to_p2
  chk 607 and dg_eq 20 21 p1_eq_p2
  save_prof
  put g_qp_s mul 11 TYQR_VAL uchar 0
  chk 608 eq tyqr_profile_write dir dlen 22 TY_E_FORMAT
  rest_prof
  test_file_tamper dlen
  chk 615 eq tyqr_file_verify t_q_nonex len t_q_nonex t_qr_dom_prof 20 TY_E_IO

  note Cleanup profile file
  ign1 = chmod g_t_p1 0 get g_t_p1l 0 int 420
  ign2 = unlink g_t_p1 0 get g_t_p1l 0

  note Other three writers
  mk_freeze 20 1
  qr_load_dig 2 0 25
  chk 620 eq tyqr_freeze_write dir dlen 22 TY_OK
  for i ulong get g_qr_wplen 0 bound 1024
    put g_path i get g_qr_wpath i
  end
  put g_plen 0 get g_qr_wplen 0
  chk 621 eq tyqr_file_verify_gp t_qr_dom_freeze 22 TY_OK
  rm_wpath

  mk_world 20 22
  chk 622 eq tyqr_world_write dir dlen 23 TY_OK
  for i ulong get g_qr_wplen 0 bound 1024
    put g_path i get g_qr_wpath i
  end
  put g_plen 0 get g_qr_wplen 0
  chk 623 eq tyqr_file_verify_gp t_qr_dom_world 23 TY_OK
  rm_wpath

  mk_gain 20 23 22 25
  qr_set_str 3 0 t_qr_cert
  chk 624 eq tyqr_gain_write dir dlen 24 TY_OK
  for i ulong get g_qr_wplen 0 bound 1024
    put g_path i get g_qr_wpath i
  end
  put g_plen 0 get g_qr_wplen 0
  chk 625 eq tyqr_file_verify_gp t_qr_dom_gain 24 TY_OK
  chk 626 eq tyqr_gain_write dir dlen 26 TYQR_E_EXISTS
  rm_wpath
  chk 627 eq tyqr_gain_write t_q_nondir len t_q_nondir 26 TY_E_IO
  rd = rmdir g_t_dir 0 dlen
  chk 628 eq rd 0
end

note ---- Test 3: Sidecar manifests ----
fn set_mbuf s view uchar * to ulong
  n = len s
  for i ulong n bound 8192
    put g_qr_mbuf i get s i
  end
  put g_qr_mlen 0 n
  ret n
end

fn set_rep_d idx ulong slot ulong to void
  so = mul slot 32
  doff = mul idx 32
  for i ulong 32
    put g_qr_rep_d add doff i get g_dig add so i
  end
end

fn rep_d_eq idx ulong slot ulong to bool
  so = mul slot 32
  doff = mul idx 32
  for i ulong 32
    if ne get g_qr_rep_d add doff i get g_dig add so i
      ret false
    end
  end
  ret true
end

fn set_dev_cell idx ulong s view uchar * to void
  off = mul idx TYQR_CELL_MAX
  n = len s
  for i ulong n bound 127
    put g_qr_dev_c add off i get s i
  end
  put g_qr_dev_c add off n uchar 0
end

fn set_dev_d idx ulong slot ulong to void
  so = mul slot 32
  doff = mul idx 32
  for i ulong 32
    put g_qr_dev_d add doff i get g_dig add so i
  end
end

fn dev_cell_eq idx ulong s view uchar * to bool
  off = mul idx TYQR_CELL_MAX
  n = len s
  for i ulong n bound 128
    if ne get g_qr_dev_c add off i get s i
      ret false
    end
  end
  ret eq get g_qr_dev_c add off n 0
end

fn mbuf_prefix s view uchar * to bool
  n = len s
  for i ulong n bound 64
    if ne get g_qr_mbuf i get s i
      ret false
    end
  end
  ret true
end

fn restore_good to ulong
  gl = get g_t_glen 0
  for i ulong gl bound 1024
    put g_qr_mbuf i get g_t_good i
  end
  ret gl
end

fn test_man_rep_ref to void
  gl = restore_good
  chk 720 eq tyqr_repman_parse sub gl 1 8 TY_E_FORMAT
  gl = restore_good
  put g_qr_mbuf gl uchar 10
  chk 721 eq tyqr_repman_parse add gl 1 8 TY_E_FORMAT
  gl = restore_good
  put g_qr_mbuf 1 uchar 9
  chk 722 eq tyqr_repman_parse gl 8 TY_E_FORMAT
  gl = restore_good
  put g_qr_mbuf 10 uchar 71
  chk 723 eq tyqr_repman_parse gl 8 TY_E_FORMAT
  gl = restore_good
  put g_qr_mbuf 10 uchar 65
  chk 724 eq tyqr_repman_parse gl 8 TY_E_FORMAT
  gl = restore_good
  put g_qr_mbuf sub gl 2 uchar 13
  put g_qr_mbuf sub gl 1 uchar 10
  chk 725 eq tyqr_repman_parse gl 8 TY_E_FORMAT
  chk 726 eq tyqr_repman_parse set_mbuf t_q_lz 8 TY_E_FORMAT
  chk 727 eq tyqr_repman_parse set_mbuf t_q_ds 8 TY_E_FORMAT
  chk 728 eq tyqr_repman_parse set_mbuf t_q_ts 8 TY_E_FORMAT
  chk 729 eq tyqr_repman_parse set_mbuf t_q_ovf 8 TY_E_FORMAT
  gl = restore_good
  for i ulong gl bound 1024
    put g_qr_mbuf add gl i get g_t_good i
  end
  chk 730 eq tyqr_repman_parse mul 2 gl 8 TY_E_FORMAT
  gl = restore_good
  chk 731 eq tyqr_repman_parse gl 1 TY_E_FORMAT
  chk 732 eq tyqr_repman_parse 0 8 TY_E_FORMAT
end

fn test_man_dev to void
  set_dev_cell 0 t_q_cellA
  put g_qr_dev_b 0 0
  rnd_slot 34
  set_dev_d 0 34
  set_dev_cell 1 t_q_cellA
  put g_qr_dev_b 1 2
  rnd_slot 35
  set_dev_d 1 35
  set_dev_cell 2 t_q_cellB
  put g_qr_dev_b 2 0
  rnd_slot 36
  set_dev_d 2 36
  chk 740 eq tyqr_devman_build 3 1024 TY_OK
  ml = get g_qr_mlen 0
  chk 741 eq get g_qr_mbuf sub ml 1 10
  chk 751 mbuf_prefix t_q_dv_pfx
  chk 742 eq tyqr_devman_parse ml 4 TY_OK
  chk 743 and eq get g_qr_dev_n 0 3 and dev_cell_eq 2 t_q_cellB eq get g_qr_dev_b 1 2
  put g_qr_dev_b 1 0
  chk 744 eq tyqr_devman_build 2 1024 TY_E_FORMAT
  set_dev_cell 0 t_q_cellB
  put g_qr_dev_b 0 0
  set_dev_cell 1 t_q_cellA
  put g_qr_dev_b 1 0
  chk 745 eq tyqr_devman_build 2 1024 TY_E_FORMAT
  set_dev_cell 0 t_q_dv_ab
  chk 746 eq tyqr_devman_build 1 1024 TY_E_FORMAT
  for i ulong TYQR_CELL_MAX
    put g_qr_dev_c i uchar 120
  end
  chk 747 eq tyqr_devman_build 1 1024 TY_E_FORMAT
  set_dev_cell 0 t_q_dv_c2
  put g_qr_dev_b 0 0
  set_dev_cell 1 t_q_dv_c10
  put g_qr_dev_b 1 0
  chk 748 eq tyqr_devman_build 2 1024 TY_E_FORMAT
  set_dev_cell 0 t_q_dv_c10
  set_dev_cell 1 t_q_dv_c2
  chk 749 eq tyqr_devman_build 2 1024 TY_OK
  chk 750 eq tyqr_devman_parse set_mbuf t_q_dv_bad 4 TY_E_FORMAT
  set_dev_cell 0 t_q_cellA
  put g_qr_dev_b 0 0
  chk 752 eq tyqr_devman_build 1 73 TY_E_FORMAT
  chk 753 eq tyqr_devman_build 1 74 TY_OK
end

fn test_manifests to void
  put g_t_lcg 0 ulong 0xa4093822299f31d0
  put g_qr_rep_u 0 0
  rnd_slot 30
  set_rep_d 0 30
  put g_qr_rep_u 1 1
  rnd_slot 31
  set_rep_d 1 31
  put g_qr_rep_u 2 10
  rnd_slot 32
  set_rep_d 2 32
  chk 701 eq tyqr_repman_build 3 1024 TY_OK
  ml = get g_qr_mlen 0
  chk 702 and eq get g_qr_mbuf sub ml 1 10 and eq get g_qr_mbuf 0 48 eq get g_qr_mbuf 1 32
  chk 703 eq tyqr_repman_parse ml 4 TY_OK
  chk 704 and eq get g_qr_rep_n 0 3 and eq get g_qr_rep_u 2 10 rep_d_eq 1 31
  tyqr_sidecar_digest ml 40
  tyqr_sidecar_digest sub ml 1 41
  chk 705 not dg_eq 40 41
  nsc = set_mbuf t_q_sc1
  tyqr_sidecar_digest nsc 42
  chk 706 kat_eq 42 t_q_kat_sc

  note Build refusals
  put g_qr_rep_u 0 1
  put g_qr_rep_u 1 1
  chk 710 eq tyqr_repman_build 2 1024 TY_E_FORMAT
  put g_qr_rep_u 0 2
  put g_qr_rep_u 1 1
  chk 711 eq tyqr_repman_build 2 1024 TY_E_FORMAT
  put g_qr_rep_u 0 0
  put g_qr_rep_u 1 1
  put g_qr_rep_u 2 10
  chk 712 eq tyqr_repman_build 3 100 TY_E_FORMAT
  chk 713 eq tyqr_repman_build 0 1024 TY_E_ARG
  chk 715 eq tyqr_repman_build 3 202 TY_E_FORMAT
  chk 716 eq tyqr_repman_build 3 203 TY_OK

  chk 714 eq tyqr_repman_build 2 1024 TY_OK
  gl = get g_qr_mlen 0
  for i ulong gl bound 1024
    put g_t_good i get g_qr_mbuf i
  end
  put g_t_glen 0 gl
  test_man_rep_ref
  test_man_dev

  note Cell table and thresholds format checks
  chk 760 eq tyqr_celltab_check set_mbuf t_q_ct1 TY_OK
  chk 761 eq tyqr_celltab_check set_mbuf t_q_ct2 TY_E_FORMAT
  chk 762 eq tyqr_celltab_check set_mbuf t_q_ct3 TY_E_FORMAT
  chk 763 eq tyqr_celltab_check set_mbuf t_q_ct4 TY_E_FORMAT
  chk 764 eq tyqr_celltab_check set_mbuf t_q_ct5 TY_E_FORMAT
  chk 765 eq tyqr_celltab_check set_mbuf t_q_ct6 TY_E_FORMAT
  chk 766 eq tyqr_celltab_check set_mbuf t_q_ct7 TY_OK
  chk 767 eq tyqr_celltab_check set_mbuf t_q_ct8 TY_E_FORMAT
  chk 768 eq tyqr_celltab_check set_mbuf t_q_ct9 TY_E_FORMAT
  chk 770 eq tyqr_thrtab_check set_mbuf t_q_tt1 TY_OK
  chk 771 eq tyqr_thrtab_check set_mbuf t_q_tt2 TY_E_FORMAT
  chk 772 eq tyqr_thrtab_check set_mbuf t_q_tt3 TY_E_FORMAT
  chk 773 eq tyqr_thrtab_check set_mbuf t_q_tt4 TY_E_FORMAT
  chk 774 eq tyqr_thrtab_check set_mbuf t_q_tt5 TY_E_FORMAT
  chk 775 eq tyqr_thrtab_check 0 TY_E_FORMAT
end

fn main to int
  test_records
  test_files
  test_manifests
  to_clr
  to_str t_q_msg_sum1
  to_u64 get g_t_chk 0
  to_str t_q_msg_sum2
  to_u64 get g_t_fail 0
  to_str t_q_msg_sum3
  to_flush
  if ne get g_t_fail 0 0
    ret 1
  end
  ret 0
end

global g_t_lcg ulong 1
global g_t_chk ulong 1
global g_t_fail ulong 1
global g_t_obuf uchar 256
global g_t_olen ulong 1
global g_t_dir uchar 128
global g_t_dlen ulong 1
global g_t_p1 uchar 1024
global g_t_p1l ulong 1
global g_t_p2 uchar 1024
global g_t_p2l ulong 1
global g_t_good uchar 1024
global g_t_glen ulong 1
global g_t_tmpf uchar 1024
global g_t_tmpx uchar 40000

fn to_clr to void
  put g_t_olen 0 0
end

fn to_b c uchar to void
  n = get g_t_olen 0
  if lt n 256
    put g_t_obuf n c
    put g_t_olen 0 add n 1
  end
end

fn to_str s view uchar * to void
  for i ulong len s bound 256
    to_b get s i
  end
end

fn to_u64 v ulong to void
  if eq v 0
    to_b uchar 48
    ret
  end
  d = new uchar 24 0
  k = ulong 0
  x = v
  while gt x 0 bound 24
    put d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  while gt k 0 bound 24
    k = sub k 1
    to_b get d k
  end
end

fn to_flush to void
  n = get g_t_olen 0
  if gt n 0
    ign = write 1 g_t_obuf 0 n
    put g_t_olen 0 0
  end
end

fn chk id ulong ok bool to void
  put g_t_chk 0 add get g_t_chk 0 1
  if not ok
    put g_t_fail 0 add get g_t_fail 0 1
    to_clr
    to_str t_q_msg_fail
    to_u64 id
    to_b uchar 10
    to_flush
  end
end

fn rnd_slot slot ulong to void
  o = mul slot 32
  lcg = get g_t_lcg 0
  mul_c = ulong 6364136223846793005
  add_c = ulong 1442695040888963407
  for i ulong 32
    lcg = add mul lcg mul_c add_c
    put g_dig add o i uchar and shr lcg 56 255
  end
  put g_t_lcg 0 lcg
end

fn kat_eq slot ulong pinned view uchar * to bool
  h = new uchar 64 0
  dg_to_hex slot h
  for i ulong 64
    if ne get h i get pinned i
      ret false
    end
  end
  ret true
end

fn mk_profile to void
  qr_zero_profile
  qr_set_str 0 0 t_q_pf0
  rnd_slot 10
  qr_set_dig 0 0 10
  rnd_slot 10
  qr_set_dig 0 1 10
  qr_set_str 0 1 t_q_pf1
  qr_set_str 0 2 t_q_pf2
  put g_qp_i 0 -7
  qr_set_str 0 3 t_q_pf3
  put g_qp_i 1 -3
  qr_set_str 0 4 t_q_pf4
  qr_set_str 0 5 t_q_pf5
  put g_qp_u 0 3
  put g_qp_u 1 64
  put g_qp_u 2 32
  rnd_slot 10
  qr_set_dig 0 2 10
  qr_set_str 0 6 t_q_pf6
  qr_set_str 0 7 t_q_pf7
  qr_set_str 0 8 t_q_pf8
  rnd_slot 10
  qr_set_dig 0 3 10
  qr_set_str 0 9 t_q_pf9
  qr_set_str 0 10 t_q_pf10
  put g_qp_u 3 100
  qr_set_str 0 11 t_q_pf11
end

fn mk_world prof_s ulong frz_s ulong to void
  qr_zero_world
  qr_set_dig 1 0 prof_s
  qr_set_str 1 0 t_qr_cert
  qr_set_str 1 1 t_qr_sealed
  qr_set_dig 1 1 frz_s
  qr_set_str 1 2 t_q_cellA
  put g_qw_u 0 4
  qr_set_str 1 3 t_q_wlbl
  qr_set_str 1 4 t_q_pf10
  rnd_slot 10
  qr_set_dig 1 2 10
  put g_qw_u 1 0
  put g_qw_u 2 20
  rnd_slot 10
  qr_set_dig 1 3 10
  qr_set_str 1 5 t_q_tfmt
end

fn mk_freeze prof_s ulong disc ulong to void
  qr_zero_freeze
  if ne disc 0
    qr_set_str 2 0 t_qr_disc
  else
    qr_set_str 2 0 t_qr_cert
  end
  rnd_slot 10
  qr_set_dig 2 0 10
  if ne disc 0
    qr_set_str 2 1 t_q_candc
    rnd_slot 10
    qr_set_dig 2 1 10
  else
    qr_set_str 2 1 t_q_refc
  end
  qr_set_dig 2 2 prof_s
  rnd_slot 10
  qr_set_dig 2 3 10
  qr_set_str 2 2 t_qr_amb
  qr_set_str 2 3 t_qr_agree
  qr_set_str 2 4 t_q_dfw
  qr_set_str 2 5 t_qr_pass
  qr_set_str 2 6 t_qr_fail
  qr_set_str 2 7 t_qr_dash
  for i ulong 40
    put g_qf_rc i get t_q_rc40 i
  end
  put g_qf_rc 40 uchar 0
  put g_qf_u 0 0
  qr_set_str 2 8 t_q_bcom
  if ne disc 0
    qr_set_str 2 9 t_q_ptool
    qr_set_str 2 10 t_q_pmodel
    rnd_slot 10
    qr_set_dig 2 4 10
    rnd_slot 10
    qr_set_dig 2 5 10
  else
    qr_set_str 2 9 t_qr_none
    qr_set_str 2 10 t_qr_none
  end
  put g_qf_u 1 2
  rnd_slot 10
  qr_set_dig 2 6 10
  rnd_slot 10
  qr_set_dig 2 7 10
end

fn mk_gain prof_s ulong wd_s ulong fd_s ulong cand_s ulong to void
  qr_zero_gain
  qr_set_dig 3 0 prof_s
  qr_set_dig 3 1 wd_s
  qr_set_dig 3 2 fd_s
  qr_set_str 3 0 t_qr_cert
  qr_set_str 3 1 t_q_cellA
  qr_set_str 3 2 t_q_pf10
  put g_qg_u 0 4
  rnd_slot 10
  qr_set_dig 3 3 10
  qr_set_dig 3 4 cand_s
  put g_qg_u 1 2
  rnd_slot 10
  qr_set_dig 3 5 10
  rnd_slot 10
  qr_set_dig 3 6 10
  put g_qg_u 2 1
  qr_set_str 3 3 t_qr_dash
  put g_qg_i 0 100
  put g_qg_i 1 2000
  put g_qg_i 2 90
  put g_qg_i 3 1900
  put g_qg_i 4 2100
  put g_qg_i 5 1990
  put g_qg_i 6 110
  put g_qg_i 7 10
  put g_qg_i 8 200
  put g_qg_i 9 3
  put g_qg_i 10 4
  put g_qg_u 3 5
  put g_qg_u 4 6
  put g_qg_u 5 7
  put g_qg_u 6 8
  put g_qg_u 7 1
  put g_qg_u 8 0
  qr_set_str 3 4 t_qr_0
  put g_qg_i 11 900000
  put g_qg_i 12 -1
  put g_qg_i 13 5
  qr_set_str 3 5 t_qr_dash
  qr_set_str 3 6 t_qr_pos
  qr_set_str 3 7 t_qr_pass
  qr_set_str 3 8 t_q_pf11
end

note Backup / restore of records for mutation tests
global g_bk_ps uchar 6156
global g_bk_pd uchar 128
global g_bk_pi long 2
global g_bk_pu ulong 4
global g_bk_ws uchar 3078
global g_bk_wd uchar 128
global g_bk_wu ulong 3
global g_bk_fs uchar 5643
global g_bk_frc uchar 41
global g_bk_fd uchar 448
global g_bk_fu ulong 2
global g_bk_gs uchar 4617
global g_bk_gd uchar 224
global g_bk_gu ulong 9
global g_bk_gi long 14

fn save_prof to void
  for i ulong 6156
    put g_bk_ps i get g_qp_s i
  end
  for i ulong 128
    put g_bk_pd i get g_qp_d i
  end
  put g_bk_pi 0 get g_qp_i 0
  put g_bk_pi 1 get g_qp_i 1
  for i ulong 4
    put g_bk_pu i get g_qp_u i
  end
end

fn rest_prof to void
  for i ulong 6156
    put g_qp_s i get g_bk_ps i
  end
  for i ulong 128
    put g_qp_d i get g_bk_pd i
  end
  put g_qp_i 0 get g_bk_pi 0
  put g_qp_i 1 get g_bk_pi 1
  for i ulong 4
    put g_qp_u i get g_bk_pu i
  end
end

fn save_world to void
  for i ulong 3078
    put g_bk_ws i get g_qw_s i
  end
  for i ulong 128
    put g_bk_wd i get g_qw_d i
  end
  for i ulong 3
    put g_bk_wu i get g_qw_u i
  end
end

fn rest_world to void
  for i ulong 3078
    put g_qw_s i get g_bk_ws i
  end
  for i ulong 128
    put g_qw_d i get g_bk_wd i
  end
  for i ulong 3
    put g_qw_u i get g_bk_wu i
  end
end

fn save_freeze to void
  for i ulong 5643
    put g_bk_fs i get g_qf_s i
  end
  for i ulong 41
    put g_bk_frc i get g_qf_rc i
  end
  for i ulong 448
    put g_bk_fd i get g_qf_d i
  end
  put g_bk_fu 0 get g_qf_u 0
  put g_bk_fu 1 get g_qf_u 1
end

fn rest_freeze to void
  for i ulong 5643
    put g_qf_s i get g_bk_fs i
  end
  for i ulong 41
    put g_qf_rc i get g_bk_frc i
  end
  for i ulong 448
    put g_qf_d i get g_bk_fd i
  end
  put g_qf_u 0 get g_bk_fu 0
  put g_qf_u 1 get g_bk_fu 1
end

fn save_gain to void
  for i ulong 4617
    put g_bk_gs i get g_qg_s i
  end
  for i ulong 224
    put g_bk_gd i get g_qg_d i
  end
  for i ulong 9
    put g_bk_gu i get g_qg_u i
  end
  for i ulong 14
    put g_bk_gi i get g_qg_i i
  end
end

fn rest_gain to void
  for i ulong 4617
    put g_qg_s i get g_bk_gs i
  end
  for i ulong 224
    put g_qg_d i get g_bk_gd i
  end
  for i ulong 9
    put g_qg_u i get g_bk_gu i
  end
  for i ulong 14
    put g_qg_i i get g_bk_gi i
  end
end

note ---- Test 1: Records, KATs, tamper, refusals, bind ----
note Slots: 0=pd, 1=pd2, 2=fcd, 3=fdd, 4=wd, 5=gd, 6=fc_art, 7=tmp, 8=other
fn test_rec_ref_prof to void
  rest_prof
  off6 = mul 6 TYQR_VAL
  for i ulong TYQR_VAL
    put g_qp_s add off6 i uchar 120
  end
  chk 101 eq tyqr_profile_digest 7 TY_E_FORMAT
  put g_qp_s add off6 512 uchar 0
  chk 102 eq tyqr_profile_digest 7 TY_OK
  rest_prof
  put g_qp_s off6 uchar 0
  chk 103 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
  qr_set_str 0 6 t_q_tab
  chk 104 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
  put g_qp_s off6 uchar 97
  put g_qp_s add off6 1 uchar 195
  put g_qp_s add off6 2 uchar 169
  put g_qp_s add off6 3 uchar 0
  chk 105 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
  qr_set_str 0 5 t_q_f2s
  chk 106 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
  qr_set_str 0 5 t_q_fls
  chk 107 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
  qr_set_str 0 8 t_q_bts
  chk 108 eq tyqr_profile_digest 7 TY_E_FORMAT
  rest_prof
end

fn test_rec_ref_world to void
  rest_world
  qr_set_str 1 0 t_q_other
  chk 201 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
  qr_set_str 1 1 t_q_x
  chk 202 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
  qr_set_str 1 0 t_qr_dev
  chk 203 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
  qr_set_str 1 1 t_qr_dev
  chk 204 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
  for i ulong 32
    put g_qw_d add 32 i uchar 0
  end
  chk 205 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
  qr_set_str 1 0 t_qr_dev
  qr_set_str 1 1 t_qr_dev
  chk 206 eq tyqr_world_digest 7 TY_E_FORMAT
  for i ulong 32
    put g_qw_d add 32 i uchar 0
  end
  chk 207 eq tyqr_world_digest 7 TY_OK
  rest_world
  qr_set_str 1 2 t_q_2w
  chk 208 eq tyqr_world_digest 7 TY_E_FORMAT
  rest_world
end

fn test_rec_ref_freeze to void
  rest_freeze
  qr_set_str 2 0 t_qr_dev
  chk 301 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  rnd_slot 10
  qr_set_dig 2 1 10
  chk 302 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  qr_set_str 2 2 t_q_maybe
  chk 303 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  qr_set_str 2 3 t_q_aglo
  chk 304 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  qr_set_str 2 5 t_q_ok
  chk 305 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  qr_set_str 2 6 t_q_palo
  chk 306 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_rc 3 uchar 71
  chk 307 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_rc 3 uchar 65
  chk 308 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_rc 3 uchar 103
  chk 318 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_rc 39 uchar 0
  chk 309 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_u 0 2
  chk 310 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  qr_set_str 2 9 t_q_tool
  chk 311 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  rnd_slot 10
  qr_set_dig 2 4 10
  chk 312 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_u 1 9
  chk 313 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
  put g_qf_u 1 8
  for i ulong 8
    rnd_slot 10
    qr_set_dig 2 add 6 i 10
  end
  chk 314 eq tyqr_freeze_digest 7 TY_OK
  rest_freeze
  put g_qf_u 1 0
  chk 315 eq tyqr_freeze_digest 7 TY_OK
  note discovery freeze refusals
  mk_freeze 0 1
  for i ulong 32
    put g_qf_d add 32 i uchar 0
  end
  chk 316 eq tyqr_freeze_digest 7 TY_E_FORMAT
  mk_freeze 0 1
  for i ulong 32
    put g_qf_d add 160 i uchar 0
  end
  chk 317 eq tyqr_freeze_digest 7 TY_E_FORMAT
  rest_freeze
end


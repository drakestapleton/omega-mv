note
note tests/turing/qcont_kat_gen.om -- Composite Simpson known-answer generator
note for qint.v1 in pure seeded OM-2. Composed after src/turing/ty_qcont_lib.om.

const QKAT_PANELS ulong 4096

text t_qk_s "s="
text t_qk_zc " zc="
text t_qk_bt " bits="
text t_qk_ok " ok\n"
text t_qk_rf " REFUSED\n"
text t_qk_dot "."

global g_qko uchar 512
global g_qkl ulong 1
global g_qks f64 3
global g_qkz f64 6

fn qk_flush to void
  n = get g_qkl 0
  if gt n 0
    _w = write 1 g_qko 0 n
    put g_qkl 0 0
  end
end

fn qk_putc b uchar to void
  n = get g_qkl 0
  if ge n 512
    qk_flush
    n = 0
  end
  put g_qko n b
  put g_qkl 0 add n 1
end

fn qk_puts s view uchar * to void
  n = len s
  for i ulong n
    qk_putc get s i
  end
end

fn qk_put_u64 v ulong to void
  if eq v 0
    qk_putc uchar 48
    ret
  end
  x = v
  d = ulong 1
  while ge div x d 10
    d = mul d 10
  end
  while gt d 0
    qk_putc uchar add 48 rem div x d 10
    d = div d 10
  end
end

fn qk_put_f x f64 dp ulong to void
  ax = x
  if lt ax f64 0.0
    qk_putc uchar 45
    ax = sub f64 0.0 ax
  end
  ip = ulong ax
  qk_put_u64 ip
  qk_putc uchar 46
  fr = sub ax f64 ip
  for i ulong dp
    fr = mul fr f64 10.0
    dig = ulong fr
    if gt dig 9
      dig = 9
    end
    qk_putc uchar add 48 dig
    fr = sub fr f64 dig
  end
end

fn qkat_pt zc f64 u f64 to f64
  t = mul add mul f64 2.0 zc u f64 0.5
  ret q_exp mul sub f64 0.0 u t
end

fn qkat_simpson zc f64 w f64 to f64
  h = div w f64 QKAT_PANELS
  hw = mul w f64 0.5
  sum = f64 0.0
  for i ulong add QKAT_PANELS 1
    fv = qkat_pt zc sub mul h f64 i hw
    wt = f64 2.0
    if or eq i 0 eq i QKAT_PANELS
      wt = f64 1.0
    else
      if ne and i 1 0
        wt = f64 4.0
      end
    end
    sum = add sum mul fv wt
  end
  ret div mul sum h f64 3.0
end

fn qkat_bound zc f64 w f64 to f64
  az = q_fabs zc
  t = add az mul w f64 0.5
  t2 = mul t t
  he = add add mul t2 t2 mul f64 6.0 t2 f64 3.0
  h = div w f64 QKAT_PANELS
  h2 = mul h h
  e1 = q_exp add mul az w div mul w w f64 8.0
  ret mul mul div mul h2 h2 f64 180.0 e1 he
end

note Composite Simpson over [zlo, zhi] with 4096 panels.
note Writes bits -> g_qret_f[4], rel_bound -> g_qret_f[5]. Returns 0 or -1 if bound > 1e-12.
fn qkat_ref scale f64 loc f64 k long to long
  delta = q_delta
  s = scale
  if lt s q_sd_min
    s = q_sd_min
  end
  zc = div sub mul add f64 k f64 0.5 delta loc s
  w = div delta s
  iv = qkat_simpson zc w
  bd = qkat_bound zc w
  t1 = add mul mul zc zc f64 0.5 q_hln2pi
  bits = div sub t1 q_ln iv q_ln2
  put g_qret_f 4 bits
  put g_qret_f 5 bd
  if gt bd f64 0.000000000001
    ret -1
  end
  ret 0
end

fn main to int
  put g_qks 0 q_sd_min
  put g_qks 1 f64 1.0
  put g_qks 2 f64 1000.0
  put g_qkz 0 f64 0.0
  put g_qkz 1 f64 1.0
  put g_qkz 2 f64 5.0
  put g_qkz 3 f64 30.0
  put g_qkz 4 f64 2048.0
  put g_qkz 5 f64 4096.0
  for i ulong 3
    si = get g_qks i
    for j ulong 6
      zj = get g_qkz j
      k = long -12345
      m = sub mul add f64 k f64 0.5 q_delta mul zj si
      rc = qkat_ref si m k
      qk_puts t_qk_s
      qk_put_f si 6
      qk_puts t_qk_zc
      qk_put_f zj 1
      qk_puts t_qk_bt
      qk_put_f get g_qret_f 4 6
      if ne rc 0
        qk_puts t_qk_rf
      else
        qk_puts t_qk_ok
      end
    end
  end
  qk_flush
  ret 0
end

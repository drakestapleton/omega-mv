note SPDX-License-Identifier: AGPL-3.0-only
note Compose arboris_arena.om, gpu/nvidia/om/numeric/numeric.om,
note arboris_gated.om and this file in order, strip '^export ', compile and run.
fn ag_fixture arena edit ushort * offsets view ulong 6 to void
  topo = div get offsets 1 2
  note CSR [0,2,3]; branch synapse offsets [0,0,1,2]; sources [1,0].
  put arena add topo 2 2
  put arena add topo 4 3
  put arena add topo 10 1
  put arena add topo 12 2
  put arena add topo 14 1
  note Branch metadata: soma 0 root, soma 0 child at depth 1, soma 1 root.
  put arena add topo 21 0x0100
  put arena add topo 22 1
  p = div get offsets 2 2
  s = div get offsets 3 2
  for i ulong 8
    put arena add p i 0x3c00
    put arena add add p 8 i 0x3c00
    put arena add add p 16 i 0xc200
    put arena add add p 24 i 0x4000
    put arena add add p 56 i 0x3c00
    put arena add add p 64 i 0x3c00
    put arena add s i 0x4000
    put arena add add s 8 i 0x4400
  end
end

fn ag_pack_test m view ulong 16 offsets view ulong 6 original view ushort * to int
  packed = new ushort 45064 0
  for i ulong len original
    put packed i get original i
  end
  limits = new ulong 2 0
  put limits 0 1
  topo = div get offsets 1 2
  put packed add topo 14 7
  put packed 22528 27
  if ne arboris_pack_gated m offsets packed limits 3
    ret 12
  end
  if or ne get packed 22528 27 ne get limits 1 0
    ret 12
  end
  put packed add topo 14 1
  inactive = div get offsets 4 2
  put packed inactive 0xbeef
  if ne arboris_pack_gated m offsets packed limits 0
    ret 8
  end
  if ne get limits 1 1
    ret 9
  end
  if ne get packed 45056 1
    ret 9
  end
  if ne get packed 45060 1
    ret 9
  end
  if ne ag_u32 packed 22528 1 shr get m 0 32
    ret 13
  end
  if ne get packed add add 22528 inactive 8 0xbeef
    ret 14
  end
  if ne arboris_gated_tick m offsets part packed 22528 22528 4096 0
    ret 10
  end
  pong = add 22528 div get offsets 4 2
  for i ulong 8
    if ne get packed add pong i 0x4200
      ret 11
    end
    if ne get packed add add pong 8 i 0x4100
      ret 11
    end
  end
  ret 0
end

fn main to int
  m = new ulong 16 0
  offsets = new ulong 6 0
  arena = new ushort 22528 0
  put m 0 0x4152425200000001
  put m 1 2
  put m 2 3
  put m 3 2
  put m 4 8
  put m 5 2
  put m 10 144
  if ne arboris_plan_arena m 45056 4096 offsets 0
    ret 1
  end
  ag_fixture arena offsets
  rc = ag_pack_test m offsets arena
  if ne rc 0
    ret rc
  end
  if ne arboris_gated_tick m offsets arena 4096 0
    ret 2
  end
  pong = div get offsets 4 2
  for i ulong 8
    if ne get arena add pong i 0x4100
      ret 3
    end
    if ne get arena add add pong 8 i 0x4200
      ret 3
    end
  end
  put m 6 1
  if ne arboris_gated_tick m offsets arena 4096 0
    ret 4
  end
  ping = div get offsets 3 2
  if or ne get arena ping 0x4080 ne get arena add ping 8 0x4180
    ret 5
  end
  topo = div get offsets 1 2
  put arena add topo 21 0x0200
  if ne arboris_gated_tick m offsets arena 4096 2
    ret 6
  end
  put arena add topo 21 0x0100
  put arena add topo 22 0
  if ne arboris_gated_tick m offsets arena 4096 2
    ret 7
  end
  ret 0
end

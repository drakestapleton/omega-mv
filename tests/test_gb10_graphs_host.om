note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_graphs_host.om: CPU-only host contract/validation/layout test
note for wave gb10-graphs (src/omega_gpu_q36_graph.om + src/omega_gpu_q38_graph.om).
note Zero /dev/nvidia* access, zero CUDA, zero libc, static AArch64 ELF.
om2

text g_hdr "=== GB10 HOST TEST: wave gb10-graphs (CPU-only mock, zero /dev/nvidia*) ===\n"
text g_ok "PASS\n"
text g_fail "FAIL rc="
text g_nl "\n"
text g_t1 "  [1] omega_gpu_q36_graph.om (tables/layout/token/stroke/batch/exact/prefill): "
text g_t2 "  [2] omega_gpu_q38_graph.om (27B+9B/bf16-split/plan/exact/batch/stamps): "
text g_done "PASS test-gb10-graphs-host (Q36 + Q38 graph twins + negative controls verified)\n"

fn g_print s view uchar * to void
  r = write 1 s 0 len s
end

fn g_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn test_q36_tables to ulong
  gtab = new uint 9216 0
  ogq36_gather_table gtab
  if or ne get gtab 0 0 ne get gtab 31 31
    ret 101
  end
  if or ne get gtab 32 64 ne get gtab 128 32
    ret 102
  end
  if or ne get gtab 4096 8192 ne get gtab 4608 8704
    ret 103
  end
  if ne get gtab 5120 256
    ret 104
  end
  pt = new uint 512 0
  ogq36_perm_table pt 512
  if or ne get pt 0 0 or ne get pt 4 16 ne get pt 128 4
    ret 105
  end
  kn = new uchar 16 0
  if or ne ogq36_kind_name OGQ36_K_GROUP kn 5 ne ogq36_kind_name 99 kn 1
    ret 106
  end
  ret 0
end

fn test_q36_set_layers to ulong
  sh = new ulong 12 0
  put sh 0 1
  put sh 1 OGQ36_GDN_MIX
  put sh 2 OGQ36_HIDDEN
  put sh 3 OGQ36_AB
  put sh 4 OGQ36_HIDDEN
  put sh 5 1
  put sh 6 OGQ36_HIDDEN
  put sh 7 OGQ36_MIXER_OUT
  put sh 8 OGQ36_N_EXPERTS
  put sh 9 mul 2 OGQ36_EXPERT_INTER
  put sh 10 OGQ36_N_EXPERTS
  put sh 11 OGQ36_HIDDEN
  if ne ogq36_set_layer 0 sh 0 1 OGDG_BAD_ARGS
    ret 112
  end
  if ne ogq36_set_layer 0 sh 1 1 OGDG_OK
    ret 113
  end
  put sh 1 OGQ36_ATT_MIX
  if ne ogq36_set_layer 1 sh 1 1 OGDG_BAD_ARGS
    ret 114
  end
  if ne ogq36_set_layer 1 sh 0 1 OGDG_OK
    ret 115
  end
  if ne ogq36_set_final_norm 1 OGDG_OK
    ret 116
  end
  ret 0
end

fn test_q36_runs to ulong
  ogq36_set_stamps 1
  tok = new uint 1 0
  st = new ulong 6 0
  if ne ogq36_token 0 tok st OGDG_OK
    ret 120
  end
  if ne get st 0 25
    ret 121
  end
  ts = new ulong 65 0
  ks = new uchar 64 0
  if ne ogq36_stamps ts ks 65 25
    ret 122
  end
  if ne ogq36_set_exact_head 1 1 4096 OGQ36_HIDDEN OGDG_OK
    ret 123
  end
  if ne ogq36_exact_head_active 1
    ret 124
  end
  ogq36_set_head_exact_head_on 0 0
  if ne ogq36_exact_head_active 0
    ret 125
  end
  ogq36_set_exact_head_on 1
  if ne ogq36_set_lm_head_fp8 1 4096 OGQ36_HIDDEN OGDG_OK
    ret 126
  end
  if ne ogq36_exact_head_active 0
    ret 127
  end
  if ne ogq36_set_lm_head_fp8 0 0 0 OGDG_OK
    ret 128
  end
  if ne ogq36_token 1 tok st OGDG_OK
    ret 129
  end
  if ne get st 0 30
    ret 130
  end
  if ne ogq36_set_exact_head 0 0 0 0 OGDG_OK
    ret 131
  end
  ret 0
end

fn test_q36_batch_and_prefill to ulong
  if ne ogq36_set_head_state 1 2 2 OGDG_OK
    ret 132
  end
  if ne ogq36_set_batch 1 OGDG_OK
    ret 133
  end
  if ne ogq36_batch 1
    ret 134
  end
  pos = new uint 2 0
  put pos 0 2
  put pos 1 3
  toks = new uint 2 0
  st = new ulong 6 0
  if ne ogq36_stroke pos 2 toks st OGDG_OK
    ret 135
  end
  if eq get st 0 0
    ret 136
  end
  if ne ogq36_read_head 1 OGDG_OK
    ret 137
  end
  if ne ogq36_read_buf OGQ36_BUF_DN 512 OGDG_OK
    ret 138
  end
  if ne ogq36_read_buf OGQ36_BUF_AB 100 OGDG_BAD_ARGS
    ret 139
  end
  if ne ogq36_prefill_alloc 0 OGDG_BAD_ARGS
    ret 140
  end
  if ne ogq36_prefill_alloc 16 OGDG_OK
    ret 141
  end
  if ne ogq36_prefill_cap 16
    ret 142
  end
  tok = new uint 1 0
  if ne ogq36_prefill 0 8 0 1 tok st OGDG_OK
    ret 143
  end
  if eq ogq36_prefill_streamed 0
    ret 144
  end
  ret 0
end

fn test_q36_host to ulong
  ogpl_set_mock 1
  ogpl_reset_state
  ogps_reset_all
  rc = test_q36_tables
  if ne rc 0
    ret rc
  end
  cfg = new ulong 10 0
  put cfg 0 2
  put cfg 1 2
  put cfg 2 4096
  put cfg 3 0x358637bd
  put cfg 4 0x358637bd
  put cfg 5 1
  put cfg 6 1
  put cfg 7 4096
  put cfg 8 4096
  put cfg 9 OGQ36_HIDDEN
  if ne ogq36_create_heads cfg 0 OGDG_BAD_ARGS
    ret 107
  end
  put cfg 1 4
  if ne ogq36_create_heads cfg 2 OGDG_BAD_ARGS
    ret 108
  end
  put cfg 1 2
  if ne ogq36_create_heads cfg 2 OGDG_OK
    ret 109
  end
  for i ulong 42
    if ne and get ogq36_lo i 255 0
      ret 110
    end
  end
  if le get ogq36_lo 41 get ogq36_lo 15
    ret 111
  end
  rc = test_q36_set_layers
  if ne rc 0
    ogq36_free
    ret rc
  end
  rc = test_q36_runs
  if ne rc 0
    ogq36_free
    ret rc
  end
  rc = test_q36_batch_and_prefill
  ogq36_free
  ogps_close
  ret rc
end

fn test_q38_tables to ulong
  gtab = new uint 14336 0
  if ne ogq38_gather_table 0 4 gtab -1
    ret 201
  end
  if ne ogq38_gather_table 24 5 gtab -1
    ret 202
  end
  if ne ogq38_gather_table 24 4 gtab 0
    ret 203
  end
  if or ne get gtab 0 0 ne get gtab 32 64
    ret 204
  end
  pt256 = new uint 256 0
  ogq38_perm_table pt256 256
  if or ne get pt256 0 0 or ne get pt256 4 8 ne get pt256 128 4
    ret 205
  end
  exb = ogq38_exact_extra_bytes
  if lt exb 1271398400
    ret 206
  end
  kn = new uchar 16 0
  if or ne ogq38_kind_name OGQ38_K_PERM kn 4 ne ogq38_kind_name 99 kn 1
    ret 207
  end
  ret 0
end

fn test_q38_27b_layers to ulong
  sh = new ulong 12 0
  put sh 0 OGQ38_GDN_MIX
  put sh 1 OGQ38_HIDDEN
  put sh 2 OGQ38_AB
  put sh 3 OGQ38_HIDDEN
  put sh 4 OGQ38_HIDDEN
  put sh 5 OGQ38_MIXER_OUT
  put sh 6 mul 2 OGQ38_INTER
  put sh 7 OGQ38_HIDDEN
  put sh 8 OGQ38_HIDDEN
  put sh 9 OGQ38_INTER
  put sh 10 1
  put sh 11 1
  if ne ogq38_set_layer 0 sh OGDG_OK
    ret 212
  end
  put sh 0 OGQ38_ATT_MIX
  put sh 10 0
  if ne ogq38_set_layer 1 sh OGDG_OK
    ret 213
  end
  if ne ogq38_set_final_norm 1 OGDG_OK
    ret 214
  end
  ret 0
end

fn test_q38_27b_runs to ulong
  ogq38_set_overlap_ab 1
  ogq38_set_stamps 1
  tok = new uint 1 0
  st = new ulong 6 0
  if ne ogq38_token 0 tok st OGDG_OK
    ret 215
  end
  if ne get st 0 23
    ret 216
  end
  ts = new ulong 65 0
  ks = new uchar 64 0
  if ne ogq38_stamps ts ks 65 23
    ret 217
  end
  if ne ogq38_set_head_state 1 2 2 16 4 OGDG_BAD_ARGS
    ret 218
  end
  if ne ogq38_set_head_state 1 2 2 24 4 OGDG_OK
    ret 219
  end
  if ne ogq38_set_batch 1 OGDG_OK
    ret 220
  end
  if ne ogq38_set_exact_head 1 1 0 4096 OGQ38_HIDDEN OGDG_BAD_ARGS
    ret 221
  end
  if ne ogq38_set_exact_head 1 1 10384 4096 OGQ38_HIDDEN OGDG_OK
    ret 222
  end
  pos = new uint 2 0
  put pos 0 1
  put pos 1 2
  toks = new uint 2 0
  if ne ogq38_stroke pos 2 toks st OGDG_OK
    ret 223
  end
  if eq get st 0 0
    ret 224
  end
  if ne ogq38_read_buf OGQ38_BUF_ACT 512 OGDG_OK
    ret 225
  end
  if ne ogq38_set_exact_head 0 0 0 0 0 OGDG_OK
    ret 226
  end
  ret 0
end

fn test_q38_9b_bf16 to ulong
  cfg = new ulong 16 0
  put cfg 0 1
  put cfg 1 0
  put cfg 2 4096
  put cfg 5 1
  put cfg 6 1
  put cfg 7 4096
  put cfg 8 4096
  put cfg 9 4096
  put cfg 10 12288
  put cfg 11 16
  put cfg 12 4
  put cfg 13 32
  put cfg 14 16
  put cfg 15 4
  if ne ogq38_create cfg OGDG_OK
    ret 230
  end
  sh = new ulong 12 0
  put sh 0 12288
  put sh 1 4096
  put sh 2 64
  put sh 3 4096
  put sh 4 4096
  put sh 5 4096
  put sh 6 24576
  put sh 7 4096
  put sh 8 4096
  put sh 9 12288
  put sh 10 1
  put sh 11 1
  if ne ogq38_set_layer_bf16 0 sh 0 OGDG_BAD_ARGS
    ogq38_free
    ret 231
  end
  put sh 9 6144
  if ne ogq38_set_layer_bf16 0 sh 1 OGDG_OK
    ogq38_free
    ret 232
  end
  if ne ogq38_set_final_norm 1 OGDG_OK
    ogq38_free
    ret 233
  end
  tok = new uint 1 0
  st = new ulong 6 0
  if ne ogq38_token 0 tok st OGDG_OK
    ogq38_free
    ret 234
  end
  if ne get st 0 15
    ogq38_free
    ret 235
  end
  ogq38_free
  ret 0
end

fn test_q38_host to ulong
  ogpl_set_mock 1
  ogpl_reset_state
  ogps_reset_all
  rc = test_q38_tables
  if ne rc 0
    ret rc
  end
  cfg = new ulong 16 0
  put cfg 0 2
  put cfg 1 2
  put cfg 2 4096
  put cfg 3 0x358637bd
  put cfg 4 0x358637bd
  put cfg 5 1
  put cfg 6 1
  put cfg 7 4096
  put cfg 8 OGQ38_HIDDEN
  put cfg 14 24
  put cfg 15 4
  if ne ogq38_create_heads cfg 2 OGDG_OK
    ret 210
  end
  for i ulong 35
    if ne and get ogq38_lo i 255 0
      ogq38_free
      ret 211
    end
  end
  rc = test_q38_27b_layers
  if ne rc 0
    ogq38_free
    ret rc
  end
  rc = test_q38_27b_runs
  ogq38_free
  if ne rc 0
    ogps_close
    ret rc
  end
  rc = test_q38_9b_bf16
  ogps_close
  ret rc
end

fn main to int
  g_print g_hdr
  g_print g_t1
  rc = test_q36_host
  if ne rc 0
    g_print g_fail
    g_print_u rc
    g_print g_nl
    ret int rc
  end
  g_print g_ok

  g_print g_t2
  rc = test_q38_host
  if ne rc 0
    g_print g_fail
    g_print_u rc
    g_print g_nl
    ret int rc
  end
  g_print g_ok

  g_print g_done
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_numeric_lifecycle.c + tests/numeric_native/other_launcher.c
note Runs all 8 simulated-driver lifecycle scenarios in fresh forked child processes.
om2

text nl_pass_msg "numeric lifecycle: PASS (8 simulated-driver scenarios; hardware NOT_RUN)\n"
text nl_fail_pfx "FAIL numeric lifecycle scenario "
text nl_nl "\n"

global g_nl_opens ulong 1
global g_nl_closes ulong 1
global g_nl_waits ulong 1
global g_nl_open_fail ulong 1
global g_nl_close_fail ulong 1
global g_nl_fail_wait ulong 1
global g_nl_wrong_word ulong 1
global g_nl_nbuf uchar 32

fn nl_driver_open to long
  put g_nl_opens 0 add get g_nl_opens 0 1
  if ne get g_nl_open_fail 0 0
    ret -1
  end
  ret 0
end

fn nl_driver_close to long
  put g_nl_closes 0 add get g_nl_closes 0 1
  if ne get g_nl_close_fail 0 0
    ret -1
  end
  ret 0
end

fn nl_driver_wait want uint ms ulong to long
  if and ne ms 5000 ne ms 600000
    exit 1
  end
  w = add get g_nl_waits 0 1
  put g_nl_waits 0 w
  if eq w get g_nl_fail_wait 0
    ret -1
  end
  if ne get g_nl_wrong_word 0 0
    put g_nl_marker 0 add want 1
  else
    put g_nl_marker 0 want
  end
  ret 0
end

fn nl_assert ok bool to void
  if not ok
    exit 1
  end
end

fn nl_check_blocked to void
  before = get g_nl_opens 0
  nl_assert ne omega_numeric_native_open 0
  nl_assert eq get g_nl_opens 0 before
end

fn nl_scenario which ulong to void
  put g_nl_marker 0 0
  if eq which 0
    put g_nl_open_fail 0 1
    nl_assert ne omega_numeric_native_open 0
    nl_assert eq get g_nl_closes 0 0
    put g_nl_open_fail 0 0
    nl_assert eq omega_numeric_native_open 0
    nl_assert eq omega_numeric_native_close 0
    ret
  end
  nl_assert eq omega_numeric_native_open 0
  if eq which 1
    nl_check_blocked
    nl_assert eq omega_numeric_native_close 0
    nl_assert eq omega_numeric_native_open 0
    nl_assert eq omega_numeric_native_close 0
    nl_assert eq get g_nl_closes 0 2
    ret
  end
  if eq which 2
    nl_assert eq omega_numeric_native_wait uint 0x44444444 5000 0
    nl_assert eq omega_numeric_native_wait uint 6 5000 0
    nl_assert eq omega_numeric_native_close 0
    nl_assert eq omega_numeric_native_open 0
    nl_assert eq omega_numeric_native_close 0
    ret
  end
  if eq which 3
    put g_nl_close_fail 0 1
    nl_assert ne omega_numeric_native_close 0
    nl_check_blocked
    ret
  end
  if eq which 4
    put g_nl_wrong_word 0 1
  else
    put g_nl_fail_wait 0 sub which 4
  end
  exp = new uint 3 0
  put exp 0 uint 0x44444444
  put exp 1 uint 0x46464646
  put exp 2 uint 6
  failed = ulong 0
  for i ulong 3
    if ne omega_numeric_native_wait get exp i 600000 0
      failed = 1
      break
    end
  end
  nl_assert ne failed 0
  nl_assert ne omega_numeric_native_uncertain 0
  nl_assert ne omega_numeric_native_close 0
  nl_assert eq get g_nl_closes 0 0
  omega_numeric_native_release
  nl_check_blocked
end

fn main to int
  wstat = new uchar 4 0
  for i ulong 8
    pid = fork
    if lt pid 0
      ret 2
    end
    if eq pid 0
      nl_scenario i
      exit 0
    end
    rc = waitpid int pid wstat 0 4 0
    if or ne rc pid or ne get wstat 0 0 ne get wstat 1 0
      ign = write 2 nl_fail_pfx 0 len nl_fail_pfx
      put g_nl_nbuf 0 uchar add i 48
      ign = write 2 g_nl_nbuf 0 1
      ign = write 2 nl_nl 0 len nl_nl
      ret 1
    end
  end
  ign = write 1 nl_pass_msg 0 len nl_pass_msg
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit/parity test for src/omega_numeric.om.
om2

text msg_pass "OMEGA_NUMERIC_OM_PASS\n"
text msg_fail "OMEGA_NUMERIC_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_ref_and_e1 to void
  note NaN equivalence & basic FP32 ops
  chk omega_numeric_bits_equal uint 0x7fc00000 uint 0x7fa00001
  chk not omega_numeric_bits_equal uint 0x00000000 uint 0x80000000
  chk omega_numeric_fpenv_ok

  chk eq omega_ref_fadd uint 0x3f800000 uint 0x40000000 uint 0x40400000
  chk eq omega_ref_fsub uint 0x40400000 uint 0x3f800000 uint 0x40000000
  chk eq omega_ref_fmul uint 0x40400000 uint 0x40000000 uint 0x40c00000
  chk eq omega_ref_ffma uint 0x3f800001 uint 0x3f800001 uint 0xbf800000 omega_ref_ffma_int uint 0x3f800001 uint 0x3f800001 uint 0xbf800000
  note FMA vs unfused: (1+2^-23)*(1-2^-23) - 1 = -2^-46 (0xa8800000), exact single rounding
  chk eq omega_ref_ffma uint 0x3f800001 uint 0x3f7ffffe uint 0xbf800000 uint 0xa8800000
  chk eq omega_ref_ffma_int uint 0x3f800001 uint 0x3f7ffffe uint 0xbf800000 uint 0xa8800000

  note fmin / fmax signed zeros & NaN
  chk eq omega_ref_fmin uint 0x00000000 uint 0x80000000 uint 0x80000000
  chk eq omega_ref_fmax uint 0x00000000 uint 0x80000000 uint 0x00000000
  chk eq omega_ref_fmin uint 0x7fc00000 uint 0x3f800000 uint 0x3f800000
  chk eq omega_ref_fmax uint 0x3f800000 uint 0x7fc00000 uint 0x3f800000

  note E1 integer conversions
  chk eq omega_ref_f2i_floor uint 0xbfc00000 int -2
  chk eq omega_ref_f2i_ceil uint 0xbfc00000 int -1
  chk eq omega_ref_f2i_rni uint 0x3fc00000 int 2
  chk eq omega_ref_f2i_rni uint 0x40200000 int 2
  chk eq omega_ref_f2u uint 0xbfc00000 uint 0
  chk eq omega_ref_f2u uint 0x4f000000 uint 0x80000000
  chk eq omega_ref_u2f uint 0x80000000 uint 0x4f000000

  note E1 F16/BF16 narrow/widen
  chk eq omega_ref_f32_to_f16 uint 0x3f800000 uint 0x3c00
  chk eq omega_ref_f16_to_f32 uint 0x3c00 uint 0x3f800000
  chk eq omega_ref_f32_to_bf16 uint 0x3f800000 uint 0x3f80
  chk eq omega_ref_bf16_to_f32 uint 0x3f80 uint 0x3f800000
  note Subnormal F16 round-trip: 0x0001 -> 2^-24 (0x33800000) -> 0x0001
  chk eq omega_ref_f16_to_f32 uint 0x0001 uint 0x33800000
  chk eq omega_ref_f32_to_f16 uint 0x33800000 uint 0x0001

  note FSETP predicates
  chk eq omega_ref_fsetp_pred OMEGA_NOP_FSETP_EQ_SEL uint 0x80000000 uint 0x00000000 1
  chk eq omega_ref_fsetp_pred OMEGA_NOP_FSETP_NE_SEL uint 0x7fc00000 uint 0x3f800000 0
  chk eq omega_ref_fsetp_pred OMEGA_NOP_FSETP_NEU_SEL uint 0x7fc00000 uint 0x3f800000 1
  chk eq omega_ref_fsetp_pred OMEGA_NOP_FSETP_NAN_SEL uint 0x7fc00000 uint 0x3f800000 1
  chk eq omega_ref_fsetp_pred OMEGA_NOP_FSETP_NUM_SEL uint 0x3f800000 uint 0x40000000 1
end

fn test_div_sqrt_exp_log to void
  note Bit-exact DIV and SQRT against IEEE hardware FDIV/FSQRT
  chk eq omega_math_div uint 0x3f800000 uint 0x40400000 omega_ieee_div uint 0x3f800000 uint 0x40400000
  chk eq omega_math_div uint 0x00000001 uint 0x40000000 omega_ieee_div uint 0x00000001 uint 0x40000000
  chk eq omega_math_div uint 0x3f800000 uint 0x00000001 omega_ieee_div uint 0x3f800000 uint 0x00000001
  chk eq omega_math_sqrt uint 0x40000000 omega_ieee_sqrt uint 0x40000000
  chk eq omega_math_sqrt uint 0x00000001 omega_ieee_sqrt uint 0x00000001
  chk eq omega_math_sqrt uint 0x00000002 omega_ieee_sqrt uint 0x00000002
  chk eq omega_math_sqrt uint 0x7f7fffff omega_ieee_sqrt uint 0x7f7fffff
  chk eq omega_math_sqrt uint 0x80000000 uint 0x80000000

  note Frozen EXP and LOG exact checks
  chk eq omega_math_exp uint 0x00000000 uint 0x3f800000
  chk eq omega_math_exp uint 0x42c80000 OMEGA_INF_POS
  chk eq omega_math_exp uint 0xc2d20000 uint 0
  chk eq omega_math_log uint 0x3f800000 uint 0x00000000
  chk eq omega_math_log uint 0x00000000 OMEGA_INF_NEG
  chk eq omega_math_log OMEGA_INF_POS OMEGA_INF_POS
end

fn test_registry_patches_and_parity to void
  code = new uchar 512 0
  mcfg = new ulong 16 0
  qmd1 = new uint 96 0
  chk eq omega_numeric_op_count 42
  chk eq omega_numeric_refused_variant_count 15
  chk eq omega_numeric_op_find t_op_lds len t_op_lds long OMEGA_NOP_LDS_STS
  chk eq omega_numeric_op_find t_op_fsetp len t_op_fsetp long OMEGA_NOP_FSETP_SEL

  note Every non-whole-kernel op builds a valid kernel and passes structural check_patch
  put mcfg 5 64
  put mcfg 6 64
  put mcfg 7 1
  chk eq bw_qmd1 mcfg qmd1 0
  for op ulong OMEGA_NOP_COUNT
    if omega_numeric_op_whole_kernel op
      chk eq omega_numeric_patch_words op OMEGA_NUMERIC_ERR_NOT_ENCODED
    else
      n = omega_numeric_patch_words op
      chk gt n 0
      chk eq omega_numeric_check_patch op n qmd1 OMEGA_NUMERIC_OK
      chk eq omega_numeric_build_kernel op code OMEGA_NUMERIC_OK
    end
  end

  note submit_check refuses unencoded variants and bad shapes (buf_mask: bit0=a, bit1=b, bit2=c, bit3=dst)
  chk eq omega_numeric_submit_check t_rv0 len t_rv0 9 64 OMEGA_NUMERIC_ERR_NOT_ENCODED
  chk eq omega_numeric_submit_check t_op_lds_sts len t_op_lds_sts 9 32 OMEGA_NUMERIC_ERR_OPERANDS
  chk eq omega_numeric_submit_check t_op_lds_sts len t_op_lds_sts 9 64 OMEGA_NUMERIC_OK
  chk eq omega_numeric_submit_check t_op_fadd len t_op_fadd 11 64 OMEGA_NUMERIC_OK

  note Reference vs CPU parity across 64 elements
  put g_num_has_bf16 0 1
  for i ulong 64
    put g_num_a i bitcast uint f32 uint add i 1
    put g_num_b i bitcast uint f32 uint add i 2
    put g_num_c i uint 0x3f000000
  end
  chk eq omega_numeric_reference OMEGA_NOP_FADD 64 OMEGA_NUMERIC_OK
  for i ulong 64
    put g_num_exp i get g_num_dst i
  end
  chk eq omega_numeric_cpu_realize OMEGA_NOP_FADD 64 OMEGA_NUMERIC_OK
  for i ulong 64
    put g_num_got i get g_num_dst i
  end
  chk eq omega_numeric_parity OMEGA_NOP_FADD 64 OMEGA_NUMERIC_OK
  chk eq get g_num_tr_checked 0 64
  chk eq get g_num_tr_mismatches 0 0

  note MUFU bit-parity must be refused; seed_bound must pass
  chk eq omega_numeric_parity OMEGA_NOP_MUFU_RCP 64 OMEGA_NUMERIC_ERR_OPERANDS
  chk eq omega_numeric_cpu_realize OMEGA_NOP_MUFU_RCP 64 OMEGA_NUMERIC_OK
  for i ulong 64
    put g_num_got i get g_num_dst i
  end
  chk eq omega_numeric_seed_bound OMEGA_NOP_MUFU_RCP 64 OMEGA_NUMERIC_OK
  chk eq get g_num_tr_checked 0 64
  chk eq get g_num_tr_oob 0 0

  note FTZ model flushes subnormal input
  put g_num_a 0 uint 0x00000001
  put g_num_b 0 uint 0x00000001
  chk eq omega_numeric_reference_ftz OMEGA_NOP_FADD 1 OMEGA_NUMERIC_OK
  chk eq get g_num_dst 0 uint 0
end

fn main to int
  test_ref_and_e1
  test_div_sqrt_exp_log
  test_registry_patches_and_parity
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

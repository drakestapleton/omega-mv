note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_sha256_freestanding_parity.c.
note Verifies FIPS 180-2 vectors (empty, "abc", 448-bit message, 1,000,000 'a' via uneven
note streaming updates) and seeded xorshift64 one-shot vs split streaming parity across
note lengths 0..1100, 4096, and 65536 using om/sha256/sha256-om2.om.
note Host-only, CPU-only, zero GPU access.
om2

text t_s256_empty ""
text t_s256_abc "abc"
text t_s256_448 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"

text t_fips0 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
text t_fips1 "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
text t_fips2 "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
text t_fips3 "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"

text t_s256_pass "PASS test_sha256_freestanding_parity\n"
text t_s256_fail "FAIL test_sha256_freestanding_parity\n"

global g_s256_rng ulong 1

fn s256_rng_next to ulong
  r = get g_s256_rng 0
  r = xor r shl r 13
  r = xor r shr r 7
  r = xor r shl r 17
  put g_s256_rng 0 r
  ret r
end

fn s256_hex_val c uchar to ulong
  if and ge c 48 le c 57
    ret ulong sub c 48
  end
  ret ulong add sub c 97 10
end

fn s256_eq_hex d view uchar 32 hx view uchar * to long
  for i ulong 32
    hi = s256_hex_val get hx mul i 2
    lo = s256_hex_val get hx add mul i 2 1
    want = uchar or shl hi 4 lo
    if ne get d i want
      ret -1
    end
  end
  ret 0
end

fn s256_eq_dig a view uchar 32 b view uchar 32 to long
  for i ulong 32
    if ne get a i get b i
      ret -1
    end
  end
  ret 0
end

fn s256_check_fips to long
  d = new uchar 32 0
  sha256_hash t_s256_empty d
  if ne s256_eq_hex d t_fips0 0
    ret 10
  end
  sha256_hash t_s256_abc d
  if ne s256_eq_hex d t_fips1 0
    ret 11
  end
  sha256_hash t_s256_448 d
  if ne s256_eq_hex d t_fips2 0
    ret 12
  end

  note 1,000,000 'a' bytes in uneven streaming chunks (step = 1, step = step*3 + 7)
  ctx = new uchar 104 0
  sha256_init ctx
  chunk = new uchar 4096 97
  off = ulong 0
  step = ulong 1
  million = ulong 1000000
  while lt off million bound 1000000
    rem_n = sub million off
    n = step
    if lt rem_n n
      n = rem_n
    end
    pos = ulong 0
    while lt pos n bound 1000000
      take = sub n pos
      if gt take 4096
        take = 4096
      end
      sha256_update ctx part chunk 0 take
      pos = add pos take
    end
    off = add off n
    step = add mul step 3 7
  end
  sha256_final ctx d
  if ne s256_eq_hex d t_fips3 0
    ret 13
  end
  ret 0
end

fn s256_check_one_len buf edit uchar 65536 n ulong to long
  for k ulong n bound 65536
    put buf k uchar and s256_rng_next 255
  end
  d = new uchar 32 0
  e = new uchar 32 0
  sha256_hash part buf 0 n d
  cut = ulong 0
  if gt n 0
    cut = rem s256_rng_next add n 1
  end
  ctx = new uchar 104 0
  sha256_init ctx
  sha256_update ctx part buf 0 cut
  sha256_update ctx part buf cut sub n cut
  sha256_final ctx e
  if ne s256_eq_dig d e 0
    ret -1
  end
  ret 0
end

fn s256_check_stream to long
  put g_s256_rng 0 ulong 0x9e3779b97f4a7c15
  buf = new uchar 65536 0
  for t ulong 1101
    if ne s256_check_one_len buf t 0
      ret 20
    end
  end
  if ne s256_check_one_len buf 4096 0
    ret 21
  end
  if ne s256_check_one_len buf 65536 0
    ret 22
  end
  ret 0
end

fn main to int
  if ne s256_check_fips 0
    ign = write 1 t_s256_fail 0 len t_s256_fail
    ret 1
  end
  if ne s256_check_stream 0
    ign = write 1 t_s256_fail 0 len t_s256_fail
    ret 2
  end
  ign = write 1 t_s256_pass 0 len t_s256_pass
  ret 0
end

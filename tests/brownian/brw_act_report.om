note tests/brownian/brw_act_report.om -- Report statistics for BRW-ACT runner
note and re-analysis tool in pure seeded OM-2.

global g_brw_k f64 600
global g_brw_cov f64 3
global g_brw_p4 ulong 3

fn brwr_coverage n ulong m ulong to void
  s = f64 0.0
  mf = f64 m
  for i ulong n
    s = add s div get g_brw_k i mf
  end
  p = div s f64 n
  ss = f64 0.0
  for i ulong n
    d = sub div get g_brw_k i mf p
    ss = add ss mul d d
  end
  h = f64 1.0
  if gt n 1
    h = mul f64 1.959964 fsqrt div div ss f64 sub n 1 f64 n
  end
  lo = sub p h
  if lt lo f64 0.0
    lo = f64 0.0
  end
  hi = add p h
  if gt hi f64 1.0
    hi = f64 1.0
  end
  put g_brw_cov 0 p
  put g_brw_cov 1 lo
  put g_brw_cov 2 hi
end

fn brwr_p4 cn ulong cd ulong nper ulong dev1 ulong to ulong
  lim = mul f64 0.05 f64 nper
  nok = ulong 0
  if le f64 cn lim
    nok = 1
  end
  dok = ulong 1
  if ne dev1 0
    if gt f64 cd lim
      dok = 0
    end
  end
  all = ulong 0
  if and ne nok 0 ne dok 0
    all = 1
  end
  put g_brw_p4 0 all
  put g_brw_p4 1 nok
  put g_brw_p4 2 dok
  ret all
end

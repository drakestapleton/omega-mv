note
note tests/brownian/test_brw_act_report.om -- Regression tests for BRW-ACT
note report statistics in pure seeded OM-2.

text t_bar_fail "FAIL test_brw_act_report check="
text t_bar_nl "\n"
text t_bar_s1 "test_brw_act_report: "
text t_bar_s2 " checks, "
text t_bar_s3 " failures\n"

global g_bar_chk ulong 1
global g_bar_fl ulong 1
global g_bar_o uchar 128

fn bar_puts s view uchar * to void
  n = len s
  for i ulong n
    put g_bar_o i get s i
  end
  _w = write 1 g_bar_o 0 n
end

fn bar_put_u64 v ulong to void
  if eq v 0
    put g_bar_o 0 uchar 48
    _w = write 1 g_bar_o 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_bar_o n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_bar_o i
    put g_bar_o i get g_bar_o j
    put g_bar_o j tmp
    i = add i 1
  end
  _w = write 1 g_bar_o 0 n
end

fn bar_fabs x f64 to f64
  if lt x f64 0.0
    ret sub f64 0.0 x
  end
  ret x
end

fn chk ok bool id ulong to void
  put g_bar_chk 0 add get g_bar_chk 0 1
  if not ok
    put g_bar_fl 0 add get g_bar_fl 0 1
    bar_puts t_bar_fail
    bar_put_u64 id
    bar_puts t_bar_nl
  end
end

fn main to int
  for i ulong 200
    if lt i 100
      put g_brw_k i f64 60.0
    else
      put g_brw_k i f64 0.0
    end
  end
  brwr_coverage 200 60
  chk lt bar_fabs sub get g_brw_cov 0 f64 0.5 f64 0.000000000001 1
  w1 = sub get g_brw_cov 2 get g_brw_cov 1
  chk and gt w1 f64 0.12 lt w1 f64 0.16 2
  for i ulong 200
    put g_brw_k i f64 54.0
  end
  brwr_coverage 200 60
  chk and lt bar_fabs sub get g_brw_cov 0 f64 0.9 f64 0.000000000001 and lt bar_fabs sub get g_brw_cov 1 f64 0.9 f64 0.000000000001 lt bar_fabs sub get g_brw_cov 2 f64 0.9 f64 0.000000000001 3
  for i ulong 200
    if lt i 2
      put g_brw_k i f64 0.0
    else
      put g_brw_k i f64 60.0
    end
  end
  brwr_coverage 200 60
  m = get g_brw_cov 0
  lo = get g_brw_cov 1
  hi = get g_brw_cov 2
  chk and ge lo f64 0.0 and le hi f64 1.0 and le lo m le m hi 4
  all = brwr_p4 0 10 100 1
  chk and eq get g_brw_p4 1 1 and eq get g_brw_p4 2 0 eq all 0 5
  all = brwr_p4 6 0 100 1
  chk and eq get g_brw_p4 1 0 and eq get g_brw_p4 2 1 eq all 0 6
  all = brwr_p4 5 10 100 0
  chk and eq get g_brw_p4 1 1 and eq get g_brw_p4 2 1 eq all 1 7
  bar_puts t_bar_s1
  bar_put_u64 get g_bar_chk 0
  bar_puts t_bar_s2
  bar_put_u64 get g_bar_fl 0
  bar_puts t_bar_s3
  if ne get g_bar_fl 0 0
    ret 1
  end
  ret 0
end

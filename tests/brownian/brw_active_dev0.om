note ==== SHA-256 ====
fn dsh_rotr x uint n uint to uint
  ret or shr x n shl x sub uint 32 n
end

fn dsh_init_tbl to void
  if ne get g_dshk 0 0
    ret
  end
  put g_dshk 0 1116352408
  put g_dshk 1 1899447441
  put g_dshk 2 3049323471
  put g_dshk 3 3921009573
  put g_dshk 4 961987163
  put g_dshk 5 1508970993
  put g_dshk 6 2453635748
  put g_dshk 7 2870763221
  put g_dshk 8 3624381080
  put g_dshk 9 310598401
  put g_dshk 10 607225278
  put g_dshk 11 1426881987
  put g_dshk 12 1925078388
  put g_dshk 13 2162078206
  put g_dshk 14 2614888103
  put g_dshk 15 3248222580
  put g_dshk 16 3835390401
  put g_dshk 17 4022224774
  put g_dshk 18 264347078
  put g_dshk 19 604807628
  put g_dshk 20 770255983
  put g_dshk 21 1249150122
  put g_dshk 22 1555081692
  put g_dshk 23 1996064986
  put g_dshk 24 2554220882
  put g_dshk 25 2821834349
  put g_dshk 26 2952996808
  put g_dshk 27 3210313671
  put g_dshk 28 3336571891
  put g_dshk 29 3584528711
  put g_dshk 30 113926993
  put g_dshk 31 338241895
  put g_dshk 32 666307205
  put g_dshk 33 773529912
  put g_dshk 34 1294757372
  put g_dshk 35 1396182291
  put g_dshk 36 1695183700
  put g_dshk 37 1986661051
  put g_dshk 38 2177026350
  put g_dshk 39 2456956037
  put g_dshk 40 2730485921
  put g_dshk 41 2820302411
  put g_dshk 42 3259730800
  put g_dshk 43 3345764771
  put g_dshk 44 3516065817
  put g_dshk 45 3600352804
  put g_dshk 46 4094571909
  put g_dshk 47 275423344
  put g_dshk 48 430227734
  put g_dshk 49 506948616
  put g_dshk 50 659060556
  put g_dshk 51 883997877
  put g_dshk 52 958139571
  put g_dshk 53 1322822218
  put g_dshk 54 1537002063
  put g_dshk 55 1747873779
  put g_dshk 56 1955562222
  put g_dshk 57 2024104815
  put g_dshk 58 2227730452
  put g_dshk 59 2361852424
  put g_dshk 60 2428436474
  put g_dshk 61 2756734187
  put g_dshk 62 3204031479
  put g_dshk 63 3329325298
  put g_dshk 64 1779033703
  put g_dshk 65 3144134277
  put g_dshk 66 1013904242
  put g_dshk 67 2773480762
  put g_dshk 68 1359893119
  put g_dshk 69 2600822924
  put g_dshk 70 528734635
  put g_dshk 71 1541459225
end

fn dsh_load_w to void
  for i ulong 16
    b0 = shl uint get g_dshb mul i 4 uint 24
    b1 = shl uint get g_dshb add mul i 4 1 uint 16
    b2 = shl uint get g_dshb add mul i 4 2 uint 8
    b3 = uint get g_dshb add mul i 4 3
    put g_dshw i or or b0 b1 or b2 b3
  end
  i = ulong 16
  while lt i 64
    x = get g_dshw sub i 15
    s0 = xor xor dsh_rotr x uint 7 dsh_rotr x uint 18 shr x uint 3
    y = get g_dshw sub i 2
    s1 = xor xor dsh_rotr y uint 17 dsh_rotr y uint 19 shr y uint 10
    put g_dshw i add add get g_dshw sub i 16 s0 add get g_dshw sub i 7 s1
    i = add i 1
  end
end

fn dsh_round j ulong to void
  e = get g_dshv 4
  s1 = xor xor dsh_rotr e uint 6 dsh_rotr e uint 11 dsh_rotr e uint 25
  ch = xor and e get g_dshv 5 and not e get g_dshv 6
  t1 = add add get g_dshv 7 s1 ch
  t1 = add add t1 get g_dshk j get g_dshw j
  a = get g_dshv 0
  b = get g_dshv 1
  c = get g_dshv 2
  s0 = xor xor dsh_rotr a uint 2 dsh_rotr a uint 13 dsh_rotr a uint 22
  maj = xor xor and a b and a c and b c
  t2 = add s0 maj
  put g_dshv 7 get g_dshv 6
  put g_dshv 6 get g_dshv 5
  put g_dshv 5 e
  put g_dshv 4 add get g_dshv 3 t1
  put g_dshv 3 c
  put g_dshv 2 b
  put g_dshv 1 a
  put g_dshv 0 add t1 t2
end

fn dsh_block to void
  dsh_load_w
  for j ulong 8
    put g_dshv j get g_dshh j
  end
  for j ulong 64
    dsh_round j
  end
  for j ulong 8
    put g_dshh j add get g_dshh j get g_dshv j
  end
end

fn dsh_init to void
  dsh_init_tbl
  for i ulong 8
    put g_dshh i get g_dshk add i 64
  end
  put g_dshm 0 0
  put g_dshm 1 0
end

fn dsh_byte b uchar to void
  bl = get g_dshm 0
  put g_dshb bl b
  bl = add bl 1
  put g_dshm 1 add get g_dshm 1 1
  if eq bl 64
    dsh_block
    bl = 0
  end
  put g_dshm 0 bl
end

fn dsh_final_hex to void
  tot = get g_dshm 1
  bits = mul tot 8
  dsh_byte uchar 128
  while ne get g_dshm 0 56
    dsh_byte uchar 0
  end
  for i ulong 8
    sh = mul sub 7 i 8
    dsh_byte uchar and shr bits sh 255
  end
  for i ulong 8
    w = get g_dshh i
    o = mul i 8
    for k ulong 8
      sh = uint mul sub 7 k 4
      nib = ulong and shr w sh uint 15
      put g_dsha add o k get t_dv_hex nib
    end
  end
end

fn dsh_hash_tab to void
  dsh_init
  n = get g_dv_blen 0
  for i ulong n
    dsh_byte get g_dv_tab i
  end
  dsh_final_hex
end

fn dsh_hash_file p view uchar * plen ulong to long
  for i ulong plen
    put g_dv_path i get p i
  end
  put g_dv_path plen 0
  fd = fopen g_dv_path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  fdi = int fd
  dsh_init
  while true
    k = read fdi g_dv_fbuf 0 65536
    if le k 0
      break
    end
    ku = ulong k
    for i ulong ku
      dsh_byte get g_dv_fbuf i
    end
  end
  ign = fclose fdi
  dsh_final_hex
  ret 0
end

note ==== Buffer writers (which: 0=tab, 1=rep, 2=rc) ====
fn db_c w ulong c uchar to void
  n = get g_dv_blen w
  if eq w 0
    if lt n 524288
      put g_dv_tab n c
      put g_dv_blen 0 add n 1
    end
    ret
  end
  if eq w 1
    if lt n 65536
      put g_dv_rep n c
      put g_dv_blen 1 add n 1
    end
    ret
  end
  if lt n 65536
    put g_dv_rc n c
    put g_dv_blen 2 add n 1
  end
end

fn db_t w ulong s view uchar * n ulong to void
  for i ulong n
    db_c w get s i
  end
end

fn db_sp w ulong k ulong to void
  for i ulong k
    db_c w 32
  end
end

fn db_u w ulong v ulong to void
  if eq v 0
    db_c w 48
    ret
  end
  dig = ulong 0
  p = ulong 1
  while le mul p 10 v
    p = mul p 10
    dig = add dig 1
    if gt dig 18
      break
    end
  end
  rmv = v
  while gt p 0
    d = div rmv p
    rmv = rem rmv p
    db_c w uchar add 48 d
    p = div p 10
  end
end

fn db_s w ulong v long to void
  if lt v 0
    db_c w 45
    db_u w ulong sub 0 v
    ret
  end
  db_u w ulong v
end

fn db_hex16 w ulong v ulong to void
  for i ulong 16
    sh = mul sub 15 i 4
    nib = and shr v sh 15
    db_c w get t_dv_hex nib
  end
end

fn db_frac w ulong fp0 ulong scu ulong nd ulong to void
  db_c w 46
  fp = fp0
  divp = div scu 10
  for i ulong nd
    d = div fp divp
    fp = rem fp divp
    db_c w uchar add 48 d
    if gt divp 1
      divp = div divp 10
    end
  end
end

fn db_fix w ulong v f64 nd ulong wid ulong to void
  negv = ulong 0
  x = v
  if lt x f64 0.0
    negv = 1
    x = sub f64 0.0 x
  end
  sc = f64 1.0
  for i ulong nd
    sc = mul sc f64 10.0
  end
  scu = ulong sc
  tot = ulong add mul x sc f64 0.5
  ip = div tot scu
  fp = rem tot scu
  idig = ulong 1
  t = ip
  while ge t 10
    t = div t 10
    idig = add idig 1
  end
  need = add idig negv
  if gt nd 0
    need = add need add 1 nd
  end
  if gt wid need
    db_sp w sub wid need
  end
  if ne negv 0
    db_c w 45
  end
  db_u w ip
  if gt nd 0
    db_frac w fp scu nd
  end
end

fn db_cls w ulong c ulong pad ulong to void
  n = ulong 0
  if eq c 0
    db_t w t_dv_c0 len t_dv_c0
    n = len t_dv_c0
  else
    if eq c 1
      db_t w t_dv_c1 len t_dv_c1
      n = len t_dv_c1
    else
      if eq c 2
        db_t w t_dv_c2 len t_dv_c2
        n = len t_dv_c2
      else
        if eq c 3
          db_t w t_dv_c3 len t_dv_c3
          n = len t_dv_c3
        else
          db_t w t_dv_c4 len t_dv_c4
          n = len t_dv_c4
        end
      end
    end
  end
  if gt pad n
    db_sp w sub pad n
  end
end

fn db_str w ulong s ulong pad ulong to void
  n = ulong 0
  if eq s 0
    db_t w t_dv_s0 len t_dv_s0
    n = len t_dv_s0
  else
    if eq s 1
      db_t w t_dv_s1 len t_dv_s1
      n = len t_dv_s1
    else
      if eq s 2
        db_t w t_dv_s2 len t_dv_s2
        n = len t_dv_s2
      else
        db_t w t_dv_s3 len t_dv_s3
        n = len t_dv_s3
      end
    end
  end
  if gt pad n
    db_sp w sub pad n
  end
end

fn db_oc w ulong o ulong to void
  if eq o 0
    db_t w t_dv_o0 len t_dv_o0
    ret
  end
  if eq o 1
    db_t w t_dv_o1 len t_dv_o1
    ret
  end
  if eq o 2
    db_t w t_dv_o2 len t_dv_o2
    ret
  end
  db_t w t_dv_o3 len t_dv_o3
end

fn db_vname w ulong v ulong to void
  if eq v 0
    db_t w t_bv_0 len t_bv_0
    ret
  end
  if eq v 1
    db_t w t_bv_1 len t_bv_1
    ret
  end
  if eq v 2
    db_t w t_bv_2 len t_bv_2
    ret
  end
  if eq v 3
    db_t w t_bv_3 len t_bv_3
    ret
  end
  if eq v 4
    db_t w t_bv_4 len t_bv_4
    ret
  end
  db_t w t_bv_q len t_bv_q
end

fn db_pf w ulong ok ulong to void
  if ne ok 0
    db_t w t_dv_pass len t_dv_pass
  else
    db_t w t_dv_fail len t_dv_fail
  end
end

fn db_sha_g w ulong to void
  for i ulong 64
    db_c w get g_dsha i
  end
end

note ==== RNG: splitmix64, xorshift64*, Box-Muller, Poisson ====
fn dv_sm64 x ulong to ulong
  c1 = or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  c2 = or shl ulong 0xbf58476d 32 ulong 0x1ce4e5b9
  c3 = or shl ulong 0x94d049bb 32 ulong 0x133111eb
  z = add x c1
  z = mul xor z shr z 30 c2
  z = mul xor z shr z 27 c3
  ret xor z shr z 31
end

fn dv_mix a ulong b ulong to ulong
  ret dv_sm64 xor a dv_sm64 b
end

fn dv_xs_seed slot ulong seed ulong to void
  if eq seed 0
    put g_dv_rng slot or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  else
    put g_dv_rng slot seed
  end
end

fn dv_xs_next slot ulong to ulong
  s = get g_dv_rng slot
  s = xor s shr s 12
  s = xor s shl s 25
  s = xor s shr s 27
  put g_dv_rng slot s
  m = or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
  ret mul s m
end

fn dv_u_open0 slot ulong to f64
  p53 = bitcast f64 or shl ulong 0x3ca00000 32 ulong 0x00000000
  ret mul f64 add shr dv_xs_next slot 11 1 p53
end

fn dv_u_half slot ulong to f64
  p53 = bitcast f64 or shl ulong 0x3ca00000 32 ulong 0x00000000
  ret mul f64 shr dv_xs_next slot 11 p53
end

fn dv_rnorm slot ulong to f64
  a = dv_u_open0 slot
  b = dv_u_half slot
  tp = bitcast f64 or shl ulong 0x401921fb 32 ulong 0x54442d18
  ret mul fsqrt mul f64 -2.0 q_ln a q_cos mul tp b
end

fn dv_rpois slot ulong lam f64 to ulong
  u = dv_u_half slot
  p = q_exp sub f64 0.0 lam
  c = p
  k = ulong 0
  while and gt u c lt k 1000
    k = add k 1
    p = mul p div lam f64 k
    c = add c p
  end
  ret k
end

fn dv_logu slot ulong a f64 b f64 to f64
  la = q_ln a
  ret q_exp add la mul dv_u_half slot sub q_ln b la
end

note ==== Worlds ====
fn dv_world_make wi ulong cls ulong tag ulong idx ulong to void
  put g_dv_wcls wi cls
  put g_dv_widx wi idx
  sd = dv_sm64 xor xor tag shl cls 32 idx
  put g_dv_wseed wi sd
  put g_dv_wD wi f64 0.0
  put g_dv_wv wi f64 0.0
  put g_dv_wth wi f64 0.0
  dv_xs_seed 0 dv_mix sd ulong 0x5041524d
  if ne cls DV_C_NOISE
    put g_dv_wD wi dv_logu 0 f64 0.05 f64 2.0
  end
  if eq cls DV_C_DRIFT
    sg = f64 -1.0
    if lt dv_u_half 0 f64 0.5
      sg = f64 1.0
    end
    put g_dv_wv wi mul sg dv_logu 0 f64 0.05 f64 0.5
  end
  if eq cls DV_C_OU
    put g_dv_wth wi dv_logu 0 f64 0.03 f64 0.5
  end
end

fn dv_world_draw wi ulong tau ulong slot ulong to f64
  z = dv_rnorm slot
  cls = get g_dv_wcls wi
  tf = f64 tau
  if eq cls DV_C_NOISE
    ret z
  end
  dv = get g_dv_wD wi
  if eq cls DV_C_DIFF
    ret mul fsqrt add mul mul f64 2.0 dv tf f64 1.0 z
  end
  if eq cls DV_C_DRIFT
    mn = mul get g_dv_wv wi tf
    vr = add mul mul f64 2.0 dv tf f64 1.0
    ret add mn mul fsqrt vr z
  end
  if eq cls DV_C_OU
    th = get g_dv_wth wi
    vr = add mul div dv th sub f64 1.0 q_exp mul mul f64 -2.0 th tf f64 1.0
    ret mul fsqrt vr z
  end
  vr = add mul mul f64 2.0 dv tf f64 1.0
  y = mul fsqrt vr z
  nj = dv_rpois slot mul f64 0.05 tf
  for i ulong nj
    y = add y mul f64 3.0 dv_rnorm slot
  end
  ret y
end

fn dv_disc_class c ulong to bool
  if ne get g_dv_cfg 1 0
    ret or eq c DV_C_DRIFT eq c DV_C_OU
  end
  ret le c DV_C_OU
end

note ==== Run one world x strategy ====
fn dv_choose_strat strat ulong rem_t long cyc ulong to long
  if eq strat DV_S_ACTIVE
    ret brw_choose rem_t
  end
  if eq strat DV_S_RANDOM
    n = ulong 0
    for t ulong BRW_NT
      if le long brw_cost t rem_t
        put g_dv_ok n t
        n = add n 1
      end
    end
    if gt n 0
      idx = ulong mul dv_u_half 1 f64 n
      if ge idx n
        idx = sub n 1
      end
      ret long get g_dv_ok idx
    end
    ret -1
  end
  if eq strat DV_S_FIXED8
    if le long brw_cost 3 rem_t
      ret 3
    end
    k = ulong BRW_NT
    while gt k 0
      k = sub k 1
      if le long brw_cost k rem_t
        ret long k
      end
    end
    ret -1
  end
  for k ulong BRW_NT
    t = rem add cyc k BRW_NT
    if le long brw_cost t rem_t
      put g_dv_cfg 5 rem add t 1 BRW_NT
      ret long t
    end
  end
  ret -1
end

fn dv_run_held wi ulong ri ulong to void
  for t ulong BRW_NT
    if eq get g_dv_rfl ri 0
      if ne brw_predict_prd2 t 0 t TYQ_OK
        put g_dv_rfl ri 1
      end
    end
  end
  bsum = f64 0.0
  c50 = ulong 0
  c90 = ulong 0
  fht = ulong 0
  wsd = get g_dv_wseed wi
  for t ulong BRW_NT
    if ne get g_dv_rfl ri 0
      break
    end
    for q ulong DV_NHELD_PER_TAU
      idx = add mul t DV_NHELD_PER_TAU q
      dv_xs_seed 3 dv_mix dv_mix wsd ulong 0x48454c44 idx
      y = dv_world_draw wi get g_btau t 3
      put g_qp_idx t idx
      kint = q_llrint div y q_delta
      if ne ty_qcont2_bits t kint TYQ_OK
        put g_dv_rfl ri 1
        break
      end
      bsum = add bsum get g_qret_f 0
      fht = add fht get g_qret_u 0
      u = brw_cdf t y
      if and ge u f64 0.25 le u f64 0.75
        c50 = add c50 1
      end
      if and ge u f64 0.05 le u f64 0.95
        c90 = add c90 1
      end
    end
  end
  put g_dv_rbt ri div bsum f64 DV_NHELD
  put g_dv_r50 ri c50
  put g_dv_r90 ri c90
  put g_dv_rfh ri fht
end

fn dv_run_step wi ulong ri ulong tiu ulong j ulong spent ulong to ulong
  dv_xs_seed 2 dv_mix dv_mix get g_dv_wseed wi ulong 0x52454144 j
  y = dv_world_draw wi get g_btau tiu 2
  if lt brw_observe tiu y 0
    put g_dv_rfl ri 1
    ret 0
  end
  nspent = add spent brw_cost tiu
  if lt get g_dv_rfm ri 0
    brw_model_post
    for m ulong BRW_NM
      if ge get g_b_pm m f64 0.99
        put g_dv_rfm ri long m
        put g_dv_rfc ri nspent
        break
      end
    end
  end
  ret nspent
end

fn dv_run_world wi ulong strat ulong ri ulong to void
  bud = get g_dv_cfg 0
  brw_state_init
  dv_xs_seed 1 dv_mix dv_mix get g_dv_wseed wi ulong 0x52414e44 0
  spent = ulong 0
  put g_dv_cfg 5 0
  j = ulong 0
  put g_dv_rfm ri -1
  put g_dv_rfc ri 0
  put g_dv_rfl ri 0
  while true
    ti = dv_choose_strat strat sub long bud long spent get g_dv_cfg 5
    if lt ti 0
      break
    end
    nspent = dv_run_step wi ri ulong ti j spent
    if ne get g_dv_rfl ri 0
      break
    end
    spent = nspent
    j = add j 1
  end
  brw_model_post
  put g_dv_rsp ri spent
  put g_dv_rnm ri j
  put g_dv_rp0 ri get g_b_pm 0
  put g_dv_rp1 ri get g_b_pm 1
  put g_dv_rp2 ri get g_b_pm 2
  put g_dv_rvd ri brw_verdict
  put g_dv_ro9 ri get g_bs_o99 0
  cls = get g_dv_wcls wi
  fm = get g_dv_rfm ri
  fc = get g_dv_rfc ri
  if dv_disc_class cls
    put g_dv_rpt ri get g_b_pm cls
    oc = ulong 2
    if ge fm 0
      if eq ulong fm cls
        oc = 0
      else
        oc = 1
      end
    end
    put g_dv_roc ri oc
    if eq oc 0
      put g_dv_rcr ri f64 fc
    else
      put g_dv_rcr ri f64 bud
    end
  else
    put g_dv_roc ri 3
    put g_dv_rpt ri f64 -1.0
    if lt fm 0
      put g_dv_rcr ri f64 bud
    else
      put g_dv_rcr ri f64 fc
    end
  end
  dv_run_held wi ri
  put g_dv_rlk ri get g_bs_lik 0
  put g_dv_rqd ri get g_bs_qu 0
  put g_dv_rcd ri get g_bs_cdf 0
end

note ==== Heapsort + Bootstrap ====
fn dv_sift root ulong endi ulong to void
  r = root
  while true
    ch = add mul r 2 1
    if ge ch endi
      break
    end
    sw = r
    if lt get g_dv_boot sw get g_dv_boot ch
      sw = ch
    end
    if lt add ch 1 endi
      if lt get g_dv_boot sw get g_dv_boot add ch 1
        sw = add ch 1
      end
    end
    if eq sw r
      break
    end
    tmp = get g_dv_boot r
    put g_dv_boot r get g_dv_boot sw
    put g_dv_boot sw tmp
    r = sw
  end
end

fn dv_boot n ulong to void
  t = f64 0.0
  for i ulong n
    t = add t get g_dv_dd i
  end
  if eq n 0
    put g_dv_bret 0 f64 0.0
    put g_dv_bret 1 f64 0.0
    put g_dv_bret 2 f64 0.0
    ret
  end
  put g_dv_bret 0 div t f64 n
  dv_xs_seed 0 or shl ulong 0x0b5e55ed 32 ulong 0x00000001
  nf = f64 n
  for b ulong DV_NBOOT
    s = f64 0.0
    for i ulong n
      ix = ulong mul dv_u_half 0 nf
      if ge ix n
        ix = sub n 1
      end
      s = add s get g_dv_dd ix
    end
    put g_dv_boot b div s nf
  end
  k = div DV_NBOOT 2
  while gt k 0
    k = sub k 1
    dv_sift k DV_NBOOT
  end
  e = DV_NBOOT
  while gt e 1
    e = sub e 1
    tmp = get g_dv_boot 0
    put g_dv_boot 0 get g_dv_boot e
    put g_dv_boot e tmp
    dv_sift 0 e
  end
  put g_dv_bret 1 get g_dv_boot 250
  put g_dv_bret 2 get g_dv_boot 9749
end

note ==== File I/O helpers ====
fn dv_write_excl_buf which ulong suf view uchar * slen ulong to long
  ol = get g_dv_al 2
  for i ulong ol
    put g_dv_path i get g_dv_arg2 i
  end
  for i ulong slen
    put g_dv_path add ol i get suf i
  end
  plen = add ol slen
  put g_dv_path plen 0
  fd = fopen g_dv_path 0 plen 193 420
  if lt fd 0
    ignw = write 2 t_dv_exerr 0 len t_dv_exerr
    ret -1
  end
  fdi = int fd
  n = get g_dv_blen which
  if eq which 0
    ignw = write fdi g_dv_tab 0 n
  else
    ignw = write fdi g_dv_rc 0 n
  end
  ign = fclose fdi
  ret 0
end

fn dv_mkdir_out to long
  ol = get g_dv_al 2
  for i ulong ol
    put g_dv_path i get g_dv_arg2 i
  end
  put g_dv_path ol 0
  r = makedir g_dv_path 0 ol 493
  if and lt r 0 ne r -17
    ignw = write 2 t_dv_mkerr 0 len t_dv_mkerr
    ret -1
  end
  ret 0
end

fn dv_rc_src p view uchar * n ulong to void
  db_t 2 t_dv_rh6 len t_dv_rh6
  db_t 2 p n
  db_t 2 t_dv_rh4 len t_dv_rh4
  if eq dsh_hash_file p n 0
    db_sha_g 2
  else
    db_t 2 t_dv_unr len t_dv_unr
  end
end

fn dv_receipt_head is_pw ulong to void
  d1 = get g_dv_cfg 1
  if ne is_pw 0
    db_t 2 t_dv_tp len t_dv_tp
  else
    if ne d1 0
      db_t 2 t_dv_t1 len t_dv_t1
    else
      db_t 2 t_dv_t0 len t_dv_t0
    end
  end
  db_t 2 t_dv_rh1 len t_dv_rh1
  if ne is_pw 0
    db_t 2 t_dv_ptag len t_dv_ptag
  else
    for i ulong get g_dv_al 1
      db_c 2 get g_dv_arg1 i
    end
  end
  db_t 2 t_dv_rh2 len t_dv_rh2
  for i ulong get g_dv_al 3
    db_c 2 get g_dv_arg3 i
  end
  db_t 2 t_dv_rh3 len t_dv_rh3
  if ne d1 0
    db_t 2 t_dv_prof1 len t_dv_prof1
    db_t 2 t_dv_rh4 len t_dv_rh4
    if eq dsh_hash_file t_dv_prof1 len t_dv_prof1 0
      db_sha_g 2
    else
      db_t 2 t_dv_unr len t_dv_unr
    end
    db_t 2 t_dv_rh5 len t_dv_rh5
    db_t 2 t_dv_prof0 len t_dv_prof0
    db_t 2 t_dv_rh4 len t_dv_rh4
    if eq dsh_hash_file t_dv_prof0 len t_dv_prof0 0
      db_sha_g 2
    else
      db_t 2 t_dv_unr len t_dv_unr
    end
  else
    db_t 2 t_dv_prof0 len t_dv_prof0
    db_t 2 t_dv_rh4 len t_dv_rh4
    if eq dsh_hash_file t_dv_prof0 len t_dv_prof0 0
      db_sha_g 2
    else
      db_t 2 t_dv_unr len t_dv_unr
    end
  end
  dv_rc_src t_dv_src0 len t_dv_src0
  dv_rc_src t_dv_src1 len t_dv_src1
  dv_rc_src t_dv_src2 len t_dv_src2
  dv_rc_src t_dv_src3 len t_dv_src3
  dv_rc_src t_dv_src4 len t_dv_src4
  dv_rc_src t_dv_src5 len t_dv_src5
  db_t 2 t_dv_rh7 len t_dv_rh7
  if eq dsh_hash_file t_dv_exe len t_dv_exe 0
    db_sha_g 2
  else
    db_t 2 t_dv_unr len t_dv_unr
  end
end

fn dv_receipt_tail nper ulong nw ulong to void
  db_t 2 t_dv_rt1 len t_dv_rt1
  db_u 2 get g_dv_cfg 0
  db_t 2 t_dv_rt2 len t_dv_rt2
  db_u 2 nper
  db_t 2 t_dv_rt3 len t_dv_rt3
  db_u 2 nw
  db_t 2 t_dv_rt4 len t_dv_rt4
  dl = get g_dv_al 5
  if gt dl 0
    for i ulong dl
      db_c 2 get g_dv_arg5 i
    end
  else
    db_t 2 t_dv_none len t_dv_none
  end
  db_t 2 t_dv_rt5 len t_dv_rt5
end

note ==== CLI helpers ====
fn dv_eq_arg1 t view uchar * n ulong to bool
  if ne get g_dv_al 1 n
    ret false
  end
  for i ulong n
    if ne get g_dv_arg1 i get t i
      ret false
    end
  end
  ret true
end

fn dv_parse_mode to long
  if dv_eq_arg1 t_dv_dev len t_dv_dev
    ret 0
  end
  if dv_eq_arg1 t_dv_hold len t_dv_hold
    ret 1
  end
  if dv_eq_arg1 t_dv_dev1 len t_dv_dev1
    ret 2
  end
  if dv_eq_arg1 t_dv_hold1 len t_dv_hold1
    ret 3
  end
  ret -1
end

fn dv_parse_b to long
  al = get g_dv_al 4
  if lt al 3
    ret -1
  end
  if ne get g_dv_arg4 0 66
    ret -1
  end
  if ne get g_dv_arg4 1 61
    ret -1
  end
  v = ulong 0
  i = ulong 2
  while lt i al
    c = get g_dv_arg4 i
    if and ge c 48 le c 57
      v = add mul v 10 ulong sub c 48
      i = add i 1
    else
      break
    end
  end
  if lt v 3
    ret -1
  end
  ret long v
end

note ==== Power mode ====
fn dv_power_main to int
  put g_dv_cfg 1 1
  if lt dv_mkdir_out 0
    ret 1
  end
  brw_grid_init
  put g_dv_blen 0 0
  put g_dv_blen 1 0
  put g_dv_blen 2 0
  db_t 0 t_dv_ptabh len t_dv_ptabh
  nper = ulong 40
  chosen = ulong 4000
  found = ulong 0
  nfail = ulong 0
  tag1 = ulong 0x64657631
  for b ulong 3
    bud = ulong 1000
    if eq b 1
      bud = 2000
    else
      if eq b 2
        bud = 4000
      end
    end
    put g_dv_cfg 0 bud
    ok = ulong 0
    ntot = ulong 0
    for cc ulong 2
      c = add cc DV_C_DRIFT
      for i ulong nper
        dv_world_make 0 c tag1 i
        dv_run_world 0 DV_S_CYCLE 0
        nfail = add nfail get g_dv_rfl 0
        if eq get g_dv_roc 0 0
          ok = add ok 1
        end
        ntot = add ntot 1
        db_u 0 bud
        db_c 0 9
        db_cls 0 c 0
        db_c 0 9
        db_u 0 i
        db_c 0 9
        db_hex16 0 get g_dv_wseed 0
        db_c 0 9
        db_oc 0 get g_dv_roc 0
        db_c 0 9
        db_s 0 get g_dv_rfm 0
        db_c 0 9
        if lt get g_dv_rfm 0 0
          db_s 0 -1
        else
          db_u 0 get g_dv_rfc 0
        end
        db_c 0 9
        db_u 0 get g_dv_rnm 0
        db_c 0 9
        db_u 0 get g_dv_rsp 0
        db_c 0 9
        db_fix 0 get g_dv_rpt 0 6 0
        db_c 0 10
      end
    end
    db_t 1 t_dv_pw1 len t_dv_pw1
    db_u 1 bud
    db_t 1 t_dv_pw2 len t_dv_pw2
    db_u 1 ok
    db_t 1 t_dv_pw3 len t_dv_pw3
    db_u 1 ntot
    db_t 1 t_dv_pw4 len t_dv_pw4
    db_fix 1 div f64 ok f64 ntot 4 0
    db_c 1 10
    if and eq found 0 ge mul 2 ok ntot
      chosen = bud
      found = 1
    end
  end
  db_t 1 t_dv_pw5 len t_dv_pw5
  db_u 1 chosen
  db_c 1 10
  if eq found 0
    db_t 1 t_dv_pw6 len t_dv_pw6
  end
  db_t 1 t_dv_res2 len t_dv_res2
  db_u 1 nfail
  db_c 1 10
  dv_receipt_head 1
  dsh_hash_tab
  db_t 2 t_dv_rh8 len t_dv_rh8
  db_sha_g 2
  put g_dv_cfg 0 chosen
  dv_receipt_tail nper mul 2 nper
  db_t 2 t_dv_pnote len t_dv_pnote
  for i ulong get g_dv_blen 1
    db_c 2 get g_dv_rep i
  end
  rc = dv_write_excl_buf 0 t_dv_tabn len t_dv_tabn
  if eq rc 0
    rc = dv_write_excl_buf 2 t_dv_rcn len t_dv_rcn
  end
  ignw = write 1 g_dv_rep 0 get g_dv_blen 1
  ignw = write 1 t_dv_tsha 0 len t_dv_tsha
  ignw = write 1 g_dsha 0 64
  put g_dv_fbuf 0 10
  ignw = write 1 g_dv_fbuf 0 1
  if or ne rc 0 ne nfail 0
    ret 1
  end
  ret 0
end

note ==== Main run table row emitter ====
fn dv_emit_tab_row wi ulong c ulong i ulong st ulong ri ulong to void
  db_u 0 wi
  db_c 0 9
  db_cls 0 c 0
  db_c 0 9
  db_u 0 i
  db_c 0 9
  db_hex16 0 get g_dv_wseed wi
  db_c 0 9
  db_str 0 st 0
  db_c 0 9
  db_oc 0 get g_dv_roc ri
  db_c 0 9
  db_s 0 get g_dv_rfm ri
  db_c 0 9
  if lt get g_dv_rfm ri 0
    db_s 0 -1
  else
    db_u 0 get g_dv_rfc ri
  end
  db_c 0 9
  db_fix 0 get g_dv_rcr ri 6 0
  db_c 0 9
  db_u 0 get g_dv_rnm ri
  db_c 0 9
  db_u 0 get g_dv_rsp ri
  db_c 0 9
  db_fix 0 get g_dv_rpt ri 6 0
  db_c 0 9
  db_vname 0 get g_dv_rvd ri
  db_c 0 9
  db_fix 0 get g_dv_rp0 ri 6 0
  db_c 0 9
  db_fix 0 get g_dv_rp1 ri 6 0
  db_c 0 9
  db_fix 0 get g_dv_rp2 ri 6 0
  db_c 0 9
  db_u 0 get g_dv_ro9 ri
  db_c 0 9
  db_fix 0 get g_dv_rbt ri 6 0
  db_c 0 9
  db_u 0 get g_dv_r50 ri
  db_c 0 9
  db_u 0 get g_dv_r90 ri
  db_c 0 9
  db_u 0 get g_dv_rfh ri
  db_c 0 9
  db_u 0 get g_dv_rlk ri
  db_c 0 9
  db_u 0 get g_dv_rqd ri
  db_c 0 9
  db_u 0 get g_dv_rcd ri
  db_c 0 10
end

fn dv_analyze_strat_a st ulong dbase ulong nd ulong to void
  f0 = f64 0.0
  f1 = f64 0.0
  f2 = f64 0.0
  mc = f64 0.0
  for i ulong nd
    ri = add mul add dbase i DV_NSTRAT st
    oc = get g_dv_roc ri
    if eq oc 0
      f0 = add f0 f64 1.0
    else
      if eq oc 1
        f1 = add f1 f64 1.0
      else
        if eq oc 2
          f2 = add f2 f64 1.0
        end
      end
    end
    mc = add mc get g_dv_rcr ri
  end
  ndf = f64 nd
  put g_dv_frac mul st 3 div f0 ndf
  put g_dv_frac add mul st 3 1 div f1 ndf
  put g_dv_frac add mul st 3 2 div f2 ndf
  put g_dv_mc st div mc ndf
end

fn dv_analyze_strat st ulong dbase ulong nd ulong nw ulong to void
  dv_analyze_strat_a st dbase nd
  nm = f64 0.0
  mp = f64 0.0
  mb = f64 0.0
  for i ulong nd
    ri = add mul add dbase i DV_NSTRAT st
    nm = add nm f64 get g_dv_rnm ri
    mp = add mp get g_dv_rpt ri
    mb = add mb get g_dv_rbt ri
    put g_brw_k i f64 get g_dv_r50 ri
  end
  ndf = f64 nd
  put g_dv_nm st div nm ndf
  put g_dv_mp st div mp ndf
  put g_dv_mb st div mb ndf
  brwr_coverage nd DV_NHELD
  put g_dv_c50 st get g_brw_cov 0
  put g_dv_l50 st get g_brw_cov 1
  put g_dv_h50 st get g_brw_cov 2
  for i ulong nd
    ri = add mul add dbase i DV_NSTRAT st
    put g_brw_k i f64 get g_dv_r90 ri
  end
  brwr_coverage nd DV_NHELD
  put g_dv_c90 st get g_brw_cov 0
  put g_dv_l90 st get g_brw_cov 1
  put g_dv_h90 st get g_brw_cov 2
  lk = ulong 0
  qd = ulong 0
  cd = ulong 0
  for wi ulong nw
    ri = add mul wi DV_NSTRAT st
    lk = add lk get g_dv_rlk ri
    qd = add qd get g_dv_rqd ri
    cd = add cd get g_dv_rcd ri
  end
  put g_dv_lk st lk
  put g_dv_qd st qd
  put g_dv_cd st cd
end

fn dv_emit_pooled st ulong to void
  db_str 1 st 8
  db_c 1 32
  db_fix 1 get g_dv_frac mul st 3 4 7
  db_c 1 32
  db_fix 1 get g_dv_frac add mul st 3 1 4 7
  db_c 1 32
  db_fix 1 get g_dv_frac add mul st 3 2 4 7
  db_c 1 32
  db_fix 1 get g_dv_mc st 3 9
  db_c 1 32
  db_fix 1 get g_dv_nm st 2 6
  db_c 1 32
  db_fix 1 get g_dv_mp st 4 7
  db_c 1 32
  db_fix 1 get g_dv_mb st 4 9
  db_c 1 32
  db_fix 1 get g_dv_c50 st 4 0
  db_c 1 32
  db_c 1 91
  db_fix 1 get g_dv_l50 st 4 0
  db_c 1 44
  db_fix 1 get g_dv_h50 st 4 0
  db_c 1 93
  db_c 1 32
  db_fix 1 get g_dv_c90 st 4 0
  db_c 1 32
  db_c 1 91
  db_fix 1 get g_dv_l90 st 4 0
  db_c 1 44
  db_fix 1 get g_dv_h90 st 4 0
  db_c 1 93
  db_c 1 10
end

fn dv_emit_per_class nper ulong to void
  db_t 1 t_dv_pc1 len t_dv_pc1
  for c ulong 3
    if dv_disc_class c
      for st ulong DV_NSTRAT
        f0 = f64 0.0
        f1 = f64 0.0
        f2 = f64 0.0
        mc = f64 0.0
        for i ulong nper
          ri = add mul add mul c nper i DV_NSTRAT st
          oc = get g_dv_roc ri
          if eq oc 0
            f0 = add f0 f64 1.0
          else
            if eq oc 1
              f1 = add f1 f64 1.0
            else
              if eq oc 2
                f2 = add f2 f64 1.0
              end
            end
          end
          mc = add mc get g_dv_rcr ri
        end
        npf = f64 nper
        db_sp 1 2
        db_cls 1 c 9
        db_c 1 32
        db_str 1 st 7
        db_c 1 32
        db_fix 1 div f0 npf 3 0
        db_c 1 32
        db_fix 1 div f1 npf 3 0
        db_c 1 32
        db_fix 1 div f2 npf 3 0
        db_t 1 t_dv_pb3 6
        db_fix 1 div mc npf 2 0
        db_c 1 10
      end
    end
  end
end

fn dv_emit_boot dbase ulong nd ulong to ulong
  db_t 1 t_dv_pb1 len t_dv_pb1
  p1 = ulong 1
  for b ulong 3
    st = add b 1
    for i ulong nd
      r0 = mul add dbase i DV_NSTRAT
      rs = add r0 st
      put g_dv_dd i sub get g_dv_rcr r0 get g_dv_rcr rs
    end
    dv_boot nd
    if ge get g_dv_bret 2 f64 0.0
      p1 = 0
    end
    db_t 1 t_dv_pb2 len t_dv_pb2
    db_str 1 st 7
    db_t 1 t_dv_pb3 len t_dv_pb3
    db_fix 1 get g_dv_bret 0 3 9
    db_c 1 32
    db_c 1 91
    db_fix 1 get g_dv_bret 1 3 9
    db_c 1 44
    db_c 1 32
    db_fix 1 get g_dv_bret 2 3 9
    db_c 1 93
    for i ulong nd
      r0 = mul add dbase i DV_NSTRAT
      rs = add r0 st
      put g_dv_dd i sub get g_dv_rbt r0 get g_dv_rbt rs
    end
    dv_boot nd
    db_t 1 t_dv_pb4 len t_dv_pb4
    db_fix 1 get g_dv_bret 0 4 8
    db_c 1 32
    db_c 1 91
    db_fix 1 get g_dv_bret 1 4 8
    db_c 1 44
    db_c 1 32
    db_fix 1 get g_dv_bret 2 4 8
    db_c 1 93
    db_c 1 10
  end
  ret p1
end

fn dv_emit_controls nper ulong nw ulong to void
  for i ulong 20
    put g_dv_cn i 0
    put g_dv_cm i 0
  end
  for st ulong DV_NSTRAT
    for i ulong nper
      rn = add mul add mul DV_C_NOISE nper i DV_NSTRAT st
      in = add mul st 5 get g_dv_rvd rn
      put g_dv_cn in add get g_dv_cn in 1
      rm = add mul add mul DV_C_MIS nper i DV_NSTRAT st
      im = add mul st 5 get g_dv_rvd rm
      put g_dv_cm im add get g_dv_cm im 1
    end
  end
  db_t 1 t_dv_ct1 len t_dv_ct1
  db_u 1 nper
  db_t 1 t_dv_ct2 len t_dv_ct2
  for st ulong DV_NSTRAT
    db_sp 1 2
    db_str 1 st 7
    db_t 1 t_dv_ct3 len t_dv_ct3
    for k ulong 5
      if gt k 0
        db_c 1 32
      end
      db_u 1 get g_dv_cn add mul st 5 k
    end
    db_t 1 t_dv_ct4 len t_dv_ct4
    for k ulong 5
      if gt k 0
        db_c 1 32
      end
      db_u 1 get g_dv_cm add mul st 5 k
    end
    db_c 1 10
  end
  db_t 1 t_dv_cm1 len t_dv_cm1
  db_u 1 nw
  db_t 1 t_dv_cm2 len t_dv_cm2
  for st ulong DV_NSTRAT
    db_sp 1 2
    db_str 1 st 7
    db_c 1 32
    db_u 1 get g_dv_lk st
    db_c 1 32
    db_c 1 47
    db_c 1 32
    db_u 1 get g_dv_qd st
    db_c 1 32
    db_c 1 47
    db_c 1 32
    db_u 1 get g_dv_cd st
    db_c 1 10
  end
end

fn dv_emit_rules_head nper ulong p1 ulong p2 ulong aw f64 maxb f64 to void
  db_t 1 t_dv_pr0 len t_dv_pr0
  for i ulong get g_dv_al 1
    db_c 1 get g_dv_arg1 i
  end
  db_t 1 t_dv_pr0b len t_dv_pr0b
  db_t 1 t_dv_pr1 len t_dv_pr1
  db_pf 1 p1
  db_c 1 10
  db_t 1 t_dv_pr2 len t_dv_pr2
  db_fix 1 aw 4 0
  db_t 1 t_dv_pr2b len t_dv_pr2b
  db_fix 1 maxb 4 0
  db_t 1 t_dv_pr2c len t_dv_pr2c
  db_pf 1 p2
  db_c 1 10
end

fn dv_emit_p4_p5 nper ulong ok123 ulong nfail ulong to void
  clm = add get g_dv_cn BRW_V_M1 get g_dv_cn BRW_V_M2
  clmd = ulong 0
  for i ulong nper
    v = get g_dv_rvd mul i DV_NSTRAT
    if or eq v BRW_V_M1 eq v BRW_V_M2
      clmd = add clmd 1
    end
  end
  d1 = get g_dv_cfg 1
  p4 = brwr_p4 clm clmd nper d1
  db_t 1 t_dv_pr4 len t_dv_pr4
  db_u 1 clm
  db_t 1 t_dv_pr4b len t_dv_pr4b
  db_u 1 nper
  db_t 1 t_dv_pr4c len t_dv_pr4c
  db_fix 1 mul f64 0.05 f64 nper 1 0
  db_c 1 41
  db_c 1 58
  db_c 1 32
  db_pf 1 get g_brw_p4 1
  db_c 1 10
  if ne d1 0
    db_t 1 t_dv_pr4d len t_dv_pr4d
    db_u 1 clmd
    db_t 1 t_dv_pr4b len t_dv_pr4b
    db_u 1 nper
    db_t 1 t_dv_pr4e len t_dv_pr4e
    db_fix 1 mul f64 0.05 f64 nper 1 0
    db_c 1 41
    db_c 1 58
    db_c 1 32
    db_pf 1 get g_brw_p4 2
    db_c 1 10
  end
  conf = add add get g_dv_cm BRW_V_M0 get g_dv_cm BRW_V_M1 get g_dv_cm BRW_V_M2
  p5 = ulong 0
  if le f64 conf mul f64 0.20 f64 nper
    p5 = 1
  end
  db_t 1 t_dv_pr5 len t_dv_pr5
  db_u 1 conf
  db_t 1 t_dv_pr4b len t_dv_pr4b
  db_u 1 nper
  db_t 1 t_dv_pr4c len t_dv_pr4c
  db_fix 1 mul f64 0.20 f64 nper 1 0
  db_c 1 41
  db_c 1 58
  db_c 1 32
  db_pf 1 p5
  db_c 1 10
  allok = ulong 0
  if ne ok123 0
    if ne p4 0
      if ne p5 0
        if eq nfail 0
          allok = 1
        end
      end
    end
  end
  db_t 1 t_dv_res1 len t_dv_res1
  if ne d1 0
    db_t 1 t_dv_h3 len t_dv_h3
  else
    db_t 1 t_dv_h2 len t_dv_h2
  end
  db_c 1 32
  for i ulong get g_dv_al 1
    db_c 1 get g_dv_arg1 i
  end
  db_c 1 58
  db_c 1 32
  db_pf 1 allok
  db_c 1 10
  db_t 1 t_dv_res2 len t_dv_res2
  db_u 1 nfail
  db_c 1 10
end

fn dv_emit_controls_and_rules nper ulong nw ulong p1 ulong nfail ulong to void
  dv_emit_controls nper nw
  maxb = f64 0.0
  for b ulong 3
    w = get g_dv_frac add mul add b 1 3 1
    if gt w maxb
      maxb = w
    end
  end
  aw = get g_dv_frac 1
  p2 = ulong 0
  if and le aw f64 0.05 le aw add maxb f64 0.02
    p2 = 1
  end
  dv_emit_rules_head nper p1 p2 aw maxb
  p3 = ulong 0
  if ge get g_dv_c90 0 f64 0.85
    if le get g_dv_c90 0 f64 0.95
      if ge get g_dv_c50 0 f64 0.45
        if le get g_dv_c50 0 f64 0.55
          p3 = 1
        end
      end
    end
  end
  db_t 1 t_dv_pr3 len t_dv_pr3
  db_fix 1 get g_dv_c90 0 4 0
  db_t 1 t_dv_pr3b len t_dv_pr3b
  db_fix 1 get g_dv_c50 0 4 0
  db_t 1 t_dv_pr3c len t_dv_pr3c
  db_pf 1 p3
  db_c 1 10
  ok123 = ulong 0
  if and and ne p1 0 ne p2 0 ne p3 0
    ok123 = 1
  end
  dv_emit_p4_p5 nper ok123 nfail
end

fn dv_run_worlds nper ulong tag ulong to ulong
  nfail = ulong 0
  wi = ulong 0
  for c ulong DV_NCLS
    for i ulong nper
      dv_world_make wi c tag i
      for st ulong DV_NSTRAT
        ri = add mul wi DV_NSTRAT st
        dv_run_world wi st ri
        nfail = add nfail get g_dv_rfl ri
        dv_emit_tab_row wi c i st ri
      end
      wi = add wi 1
    end
  end
  ret nfail
end

fn dv_emit_report nper ulong nw ulong nfail ulong to void
  d1 = get g_dv_cfg 1
  ndc = ulong 3
  dbase = ulong 0
  if ne d1 0
    ndc = 2
    dbase = nper
  end
  nd = mul nper ndc
  db_t 1 t_dv_h1 len t_dv_h1
  if ne d1 0
    db_t 1 t_dv_h3 len t_dv_h3
  else
    db_t 1 t_dv_h2 len t_dv_h2
  end
  db_c 1 32
  for i ulong get g_dv_al 1
    db_c 1 get g_dv_arg1 i
  end
  db_c 1 58
  db_c 1 32
  db_u 1 nw
  db_t 1 t_dv_h4 len t_dv_h4
  db_u 1 nper
  db_t 1 t_dv_h5 len t_dv_h5
  db_u 1 nd
  db_t 1 t_dv_h6 len t_dv_h6
  for st ulong DV_NSTRAT
    dv_analyze_strat st dbase nd nw
  end
  db_t 1 t_dv_d1 len t_dv_d1
  db_u 1 get g_dv_cfg 0
  db_t 1 t_dv_d2 len t_dv_d2
  for st ulong DV_NSTRAT
    dv_emit_pooled st
  end
  dv_emit_per_class nper
  p1 = dv_emit_boot dbase nd
  dv_emit_controls_and_rules nper nw p1 nfail
end

fn dv_run_all ku ulong to int
  nper = ulong 40
  if ne and ku 1 0
    nper = 100
  end
  nw = mul nper DV_NCLS
  tag = ulong 0x646576
  if eq ku 1
    tag = ulong 0x686f6c64
  else
    if eq ku 2
      tag = ulong 0x64657631
    else
      if eq ku 3
        tag = or shl ulong 0x68 32 ulong 0x6f6c6431
      end
    end
  end
  brw_grid_init
  put g_dv_blen 0 0
  put g_dv_blen 1 0
  put g_dv_blen 2 0
  db_t 0 t_dv_tabh len t_dv_tabh
  nfail = dv_run_worlds nper tag
  dv_emit_report nper nw nfail
  dv_receipt_head 0
  dsh_hash_tab
  db_t 2 t_dv_rh8 len t_dv_rh8
  db_sha_g 2
  dv_receipt_tail nper nw
  for i ulong get g_dv_blen 1
    db_c 2 get g_dv_rep i
  end
  rc = dv_write_excl_buf 0 t_dv_tabn len t_dv_tabn
  if eq rc 0
    rc = dv_write_excl_buf 2 t_dv_rcn len t_dv_rcn
  end
  ignw = write 1 g_dv_rep 0 get g_dv_blen 1
  ignw = write 1 t_dv_tsha 0 len t_dv_tsha
  ignw = write 1 g_dsha 0 64
  put g_dv_fbuf 0 10
  ignw = write 1 g_dv_fbuf 0 1
  if ne rc 0
    ret 1
  end
  ret 0
end

fn main to int
  ac = argcnt
  if lt ac 4
    ignw = write 2 t_dv_usage 0 len t_dv_usage
    ret 64
  end
  put g_dv_al 1 ulong argread 1 g_dv_arg1 0 64
  put g_dv_al 2 ulong argread 2 g_dv_arg2 0 511
  put g_dv_al 3 ulong argread 3 g_dv_arg3 0 128
  put g_dv_al 4 0
  put g_dv_al 5 0
  is_pw = dv_eq_arg1 t_dv_power len t_dv_power
  if is_pw
    if gt ac 4
      put g_dv_al 5 ulong argread 4 g_dv_arg5 0 256
    end
    ret dv_power_main
  end
  k = dv_parse_mode
  if lt k 0
    ignw = write 2 t_dv_usage 0 len t_dv_usage
    ret 64
  end
  ku = ulong k
  d1 = ulong 0
  if ge ku 2
    d1 = 1
  end
  put g_dv_cfg 1 d1
  put g_dv_cfg 0 400
  ai = long 4
  if ne d1 0
    if lt ac 5
      ignw = write 2 t_dv_needb 0 len t_dv_needb
      ret 64
    end
    put g_dv_al 4 ulong argread 4 g_dv_arg4 0 128
    bv = dv_parse_b
    if lt bv 0
      ignw = write 2 t_dv_needb 0 len t_dv_needb
      ret 64
    end
    put g_dv_cfg 0 ulong bv
    ai = 5
  end
  if gt ac ai
    put g_dv_al 5 ulong argread ulong ai g_dv_arg5 0 256
  end
  if lt dv_mkdir_out 0
    ret 1
  end
  ret dv_run_all ku
end

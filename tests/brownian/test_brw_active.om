note tests/brownian/test_brw_active.om -- Unit tests for BRW-ACT-DEV0 candidate
note library in pure seeded OM-2.
note Composed after src/turing/ty_qcont_lib.om and tools/brownian/brw_active.om.

text t_ba_fail "FAIL test_brw_active check="
text t_ba_nl "\n"
text t_ba_s1 "test_brw_active: "
text t_ba_s2 " checks, "
text t_ba_s3 " failed\n"

global g_ba_chk ulong 1
global g_ba_fl ulong 1
global g_ba_o uchar 128
global g_ba_rs ulong 1
global g_ba_w f64 528
global g_ba_m f64 528
global g_ba_s f64 528
global g_ba_rw f64 8
global g_ba_rm f64 8
global g_ba_rsd f64 8
global g_ba_c f64 152

fn ba_puts s view uchar * to void
  n = len s
  for i ulong n
    put g_ba_o i get s i
  end
  _w = write 1 g_ba_o 0 n
end

fn ba_put_u64 v ulong to void
  if eq v 0
    put g_ba_o 0 uchar 48
    _w = write 1 g_ba_o 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_ba_o n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_ba_o i
    put g_ba_o i get g_ba_o j
    put g_ba_o j tmp
    i = add i 1
  end
  _w = write 1 g_ba_o 0 n
end

fn chk ok bool id ulong to void
  put g_ba_chk 0 add get g_ba_chk 0 1
  if not ok
    put g_ba_fl 0 add get g_ba_fl 0 1
    ba_puts t_ba_fail
    ba_put_u64 id
    ba_puts t_ba_nl
  end
end

fn ba_xs to ulong
  s = get g_ba_rs 0
  s = xor s shr s 12
  s = xor s shl s 25
  s = xor s shr s 27
  put g_ba_rs 0 s
  ret mul s or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
end

fn ba_u01 to f64
  p53 = bitcast f64 shl ulong 0x3ca00000 32
  ret mul f64 add shr ba_xs 11 1 p53
end

fn ba_gauss to f64
  a = ba_u01
  b = ba_u01
  ret mul fsqrt mul f64 -2.0 q_ln a q_cos mul f64 6.283185307179586 b
end

fn feed_model model ulong dv f64 vv f64 th f64 n ulong to void
  for j ulong n
    ti = add 2 rem j 4
    tau = f64 get g_btau ti
    mu = f64 0.0
    vr = add mul mul f64 2.0 dv tau f64 1.0
    if eq model 2
      vr = add mul div dv th sub f64 1.0 q_exp mul mul f64 -2.0 th tau f64 1.0
    end
    if eq model 1
      mu = mul vv tau
    end
    _r = brw_observe ti add mu mul fsqrt vr ba_gauss
  end
end

fn test_grid to void
  c0 = ulong 0
  c1 = ulong 0
  c2 = ulong 0
  for i ulong BRW_NH
    m = get g_bh_m i
    if eq m 0
      c0 = add c0 1
    else
      if eq m 1
        c1 = add c1 1
      else
        c2 = add c2 1
      end
    end
  end
  chk and eq c0 16 and eq c1 256 eq c2 256 1
  chk and lt q_fabs sub get g_bh_d 0 f64 0.001 f64 0.000000000000001 lt q_fabs sub get g_bh_d 15 f64 10.0 f64 0.000000000001 2
  brw_state_init
  brw_model_post
  t3 = div f64 1.0 f64 3.0
  chk lt q_fabs sub get g_b_pm 0 t3 f64 0.00000000000001 3
  chk lt q_fabs sub get g_b_pm 1 t3 f64 0.00000000000001 4
  chk lt q_fabs sub get g_b_pm 2 t3 f64 0.00000000000001 5
  chk lt q_fabs brw_lse_lw f64 0.0000000000001 6
end

fn test_lse to void
  put g_b_mp 0 f64 -1000.0
  put g_b_mp 1 f64 -1000.0
  chk lt q_fabs sub brw_lse_mp 2 add f64 -1000.0 q_ln2 f64 0.000000000001 10
  put g_b_mp 0 f64 0.0
  put g_b_mp 1 f64 -100000.0
  chk lt q_fabs brw_lse_mp 2 f64 0.000000000000001 11
  ninf = sub f64 0.0 q_inf
  put g_b_mp 0 ninf
  put g_b_mp 1 f64 0.0
  put g_b_mp 2 f64 0.0
  chk lt q_fabs sub brw_lse_mp 3 q_ln2 f64 0.000000000000001 12
  put g_b_mp 0 ninf
  chk eq brw_lse_mp 1 ninf 13
  brw_state_init
  _r1 = brw_observe 5 f64 150.0
  _r2 = brw_observe 0 f64 -40.0
  chk lt q_fabs sub q_exp brw_lse_lw f64 1.0 f64 0.000000000001 14
  brw_model_post
  chk lt q_fabs sub add add get g_b_pm 0 get g_b_pm 1 get g_b_pm 2 f64 1.0 f64 0.000000000001 15
end

fn test_posterior to void
  brw_state_init
  feed_model 1 f64 0.1 f64 0.3 f64 0.0 24
  brw_model_post
  chk gt get g_b_pm 1 f64 0.99 20
  brw_state_init
  feed_model 2 f64 0.5 f64 0.0 f64 0.5 60
  brw_model_post
  chk and gt get g_b_pm 2 get g_b_pm 0 gt get g_b_pm 2 get g_b_pm 1 21
  brw_state_init
  feed_model 0 f64 0.2 f64 0.0 f64 0.0 60
  brw_model_post
  chk and gt get g_b_pm 0 get g_b_pm 1 gt get g_b_pm 0 get g_b_pm 2 22
  chk and eq get g_bs_lik 0 mul 60 BRW_NH eq get g_bs_no 0 60 23
end

fn test_entropy to void
  tpe = mul f64 6.283185307179586 f64 2.718281828459045
  put g_b_qw 0 f64 1.0
  put g_b_qm 0 f64 0.7
  put g_b_qv 0 f64 0.25
  h0 = brw_mix_entropy_bits 1
  chk lt q_fabs sub h0 mul f64 0.5 q_log2 mul tpe f64 0.25 f64 0.000001 30
  put g_b_qv 0 f64 1.0
  h1 = brw_mix_entropy_bits 1
  chk lt q_fabs sub h1 mul f64 0.5 q_log2 mul tpe f64 1.0 f64 0.000001 31
  put g_b_qv 0 mul f64 12.3 f64 12.3
  h2 = brw_mix_entropy_bits 1
  chk lt q_fabs sub h2 mul f64 0.5 q_log2 mul tpe mul f64 12.3 f64 12.3 f64 0.000001 32
  put g_bs_qu 0 0
  put g_b_qv 0 f64 1.0
  _h = brw_mix_entropy_bits 1
  chk eq get g_bs_qu 0 BRW_NQ 33
end

fn test_info to void
  for i ulong 6
    put g_b_qw i div f64 1.0 f64 6.0
    if ne rem i 2 0
      put g_b_qm i f64 1.5
      put g_b_qv i f64 1.5
    else
      put g_b_qm i f64 -0.5
      put g_b_qv i f64 1.0
    end
    put g_b_qg i rem i 3
  end
  brw_info_arrays 6 3
  chk lt q_fabs get g_b_ret 2 f64 0.000000001 40
  chk gt get g_b_ret 3 f64 0.0 41
  put g_b_qw 0 f64 0.5
  put g_b_qw 1 f64 0.5
  put g_b_qm 0 f64 0.0
  put g_b_qm 1 f64 0.3
  put g_b_qv 0 f64 1.2
  put g_b_qv 1 f64 1.2
  put g_b_qg 0 0
  put g_b_qg 1 1
  brw_info_arrays 2 2
  i_lo = get g_b_ret 2
  put g_b_qm 1 mul f64 0.3 f64 32.0
  put g_b_qv 0 add f64 1.0 mul f64 0.2 f64 32.0
  put g_b_qv 1 add f64 1.0 mul f64 0.2 f64 32.0
  brw_info_arrays 2 2
  i_hi = get g_b_ret 2
  chk and gt i_hi mul f64 20.0 i_lo gt i_hi f64 0.5 42
  brw_state_init
  brw_info 0
  i1 = get g_b_ret 2
  brw_info 5
  iv32 = get g_b_ret 2
  chk and gt iv32 i1 and lt iv32 add q_log2 f64 3.0 f64 0.000001 ge i1 f64 -0.000000001 43
  chk gt get g_bs_qu 0 0 44
end

fn wmean_arr which ulong n ulong to f64
  t = f64 0.0
  m = f64 0.0
  for i ulong n
    wi = f64 0.0
    mi = f64 0.0
    if eq which 0
      wi = get g_ba_w i
      mi = get g_ba_m i
    else
      wi = get g_ba_rw i
      mi = get g_ba_rm i
    end
    t = add t wi
    m = add m mul wi mi
  end
  ret div m t
end

fn wvar_arr which ulong n ulong to f64
  mn = wmean_arr which n
  t = f64 0.0
  v = f64 0.0
  for i ulong n
    wi = f64 0.0
    mi = f64 0.0
    si = f64 0.0
    if eq which 0
      wi = get g_ba_w i
      mi = get g_ba_m i
      si = get g_ba_s i
    else
      wi = get g_ba_rw i
      mi = get g_ba_rm i
      si = get g_ba_rsd i
    end
    t = add t wi
    dm = sub mi mn
    v = add v mul wi add mul si si mul dm dm
  end
  ret div v t
end

fn test_reduce to void
  t = f64 0.0
  for i ulong 100
    u = ba_u01
    wi = mul u u
    put g_ba_w i wi
    put g_ba_m i mul f64 20.0 sub ba_u01 f64 0.5
    put g_ba_s i add f64 1.0 mul f64 5.0 ba_u01
    t = add t wi
  end
  for i ulong 100
    wi = div get g_ba_w i t
    put g_ba_w i wi
    put g_b_qw i wi
    put g_b_qm i get g_ba_m i
    put g_b_qsd i get g_ba_s i
  end
  chk eq brw_reduce 100 7 0 TYQ_OK 50
  chk and eq get g_qp_k 0 8 and eq get g_qp_fam 0 TYQ_FAM_MIX eq get g_qp_idx 0 7 51
  sum = f64 0.0
  for k ulong 8
    put g_ba_rw k get g_qc_pi k
    put g_ba_rm k get g_qc_loc k
    put g_ba_rsd k get g_qc_sc k
    sum = add sum get g_qc_pi k
  end
  chk lt q_fabs sub wmean_arr 1 8 wmean_arr 0 100 f64 0.000000001 52
  chk lt q_fabs sub wvar_arr 1 8 wvar_arr 0 100 f64 0.000000001 53
  chk lt q_fabs sub sum f64 1.0 f64 0.000000000001 54
  chk eq ty_prd2_validate 0 TYQ_OK 55
  for k ulong 6
    chk ge get g_ba_rw k get g_ba_rw add k 1 56
  end
  hv = ulong 0
  for i ulong 100
    if gt get g_ba_w i add get g_ba_rw 6 f64 0.000000000000001
      hv = add hv 1
    end
  end
  chk le hv 6 57
  brw_state_init
  feed_model 1 f64 0.3 f64 0.2 f64 0.0 10
  for ti ulong BRW_NT
    chk eq brw_predict_prd2 ti 3 0 TYQ_OK 58
    bo = mul ti BRW_NH
    for i ulong BRW_NH
      put g_ba_w i q_exp get g_bs_lw i
      put g_ba_m i get g_bg_mu add bo i
      put g_ba_s i fsqrt get g_bg_var add bo i
    end
    kv = get g_qp_k 0
    for k ulong kv
      put g_ba_rw k get g_qc_pi k
      put g_ba_rm k get g_qc_loc k
      put g_ba_rsd k get g_qc_sc k
    end
    chk lt q_fabs sub wmean_arr 1 kv wmean_arr 0 BRW_NH f64 0.000000001 59
    chk lt q_fabs sub wvar_arr 1 kv wvar_arr 0 BRW_NH f64 0.000000001 60
  end
end

fn binom_ref n ulong to ulong
  for j ulong add n 2
    put g_ba_c j f64 0.0
  end
  put g_ba_c 0 f64 1.0
  for r0 ulong n
    r = add r0 1
    k = r
    while ge k 1
      put g_ba_c k add get g_ba_c k get g_ba_c sub k 1
      k = sub k 1
    end
  end
  for c ulong add n 2
    t = f64 0.0
    k = c
    while le k n
      p1 = brw_pow f64 0.01 f64 k
      p2 = brw_pow f64 0.99 f64 sub n k
      t = add t mul get g_ba_c k mul p1 p2
      k = add k 1
    end
    if le t f64 0.001
      ret c
    end
  end
  ret add n 1
end

fn test_binom to void
  chk eq brw_binom_crit 10 3 70
  chk eq brw_binom_crit 1 2 71
  chk eq brw_binom_crit 100 6 72
  same = true
  for n0 ulong 150
    n = add n0 1
    if ne brw_binom_crit n binom_ref n
      same = false
    end
  end
  chk same 73
end

fn set_post model ulong pm f64 to void
  for i ulong BRW_NH
    m = get g_bh_m i
    cnt = f64 256.0
    if eq m 0
      cnt = f64 16.0
    end
    mass = mul sub f64 1.0 pm f64 0.5
    if eq m model
      mass = pm
    end
    put g_bs_lw i q_ln div mass cnt
  end
end

fn test_verdict to void
  brw_state_init
  chk eq brw_verdict BRW_V_UNDETERMINED 80
  set_post 1 f64 0.995
  chk eq brw_verdict BRW_V_M1 81
  set_post 2 f64 0.992
  chk eq brw_verdict BRW_V_M2 82
  set_post 0 f64 0.98
  chk eq brw_verdict BRW_V_UNDETERMINED 83
  set_post 0 f64 0.999
  chk eq brw_verdict BRW_V_M0 84
  put g_bs_np 0 10
  put g_bs_o99 0 3
  chk eq brw_verdict BRW_V_M0 85
  put g_bs_o99 0 4
  chk eq brw_verdict BRW_V_INADEQUATE 86
  set_post 1 f64 0.3
  chk eq brw_verdict BRW_V_INADEQUATE 87
end

fn test_choice to void
  brw_state_init
  chk eq brw_choose 2 -1 90
  chk eq brw_choose 0 -1 91
  chk eq brw_choose 3 0 92
  t = brw_choose 5
  chk or eq t 0 eq t 1 93
  t = brw_choose 400
  chk and ge t 0 eq get g_b_reti 0 1 94
  chk eq brw_choose 400 t 95
  set_post 1 f64 0.995
  _t2 = brw_choose 400
  chk eq get g_b_reti 0 2 96
  put g_b_sc 0 f64 1.0
  put g_b_sc 1 f64 5.0
  put g_b_sc 2 f64 5.0
  put g_b_sc 3 f64 2.0
  put g_b_sc 4 f64 5.0
  put g_b_sc 5 f64 0.0
  for i ulong 6
    put g_b_ok i 1
  end
  chk eq brw_pick 6 1 97
  put g_b_ok 1 0
  chk eq brw_pick 6 2 98
  for i ulong 6
    put g_b_ok i 0
  end
  chk eq brw_pick 6 -1 99
  brw_state_init
  rm = long 3
  while lt rm 40
    c = brw_choose rm
    chk and ge c 0 le long brw_cost ulong c rm 100
    rm = add rm 3
  end
end

fn test_cdf_preq to void
  brw_state_init
  ninf = sub f64 0.0 q_inf
  for i ulong BRW_NH
    put g_bs_lw i ninf
  end
  put g_bs_lw 3 f64 0.0
  bo = mul 2 BRW_NH
  mu = get g_bg_mu add bo 3
  sd = fsqrt get g_bg_var add bo 3
  chk lt q_fabs sub brw_cdf 2 mu f64 0.5 f64 0.000000000000001 110
  chk lt q_fabs sub brw_cdf 2 add mu sd f64 0.8413447460685429 f64 0.000000000001 111
  chk lt brw_cdf 2 sub mu mul f64 50.0 sd bitcast f64 or shl ulong 0x01ae1025 32 ulong 0x648836b8 112
  chk gt brw_cdf 2 add mu mul f64 50.0 sd sub f64 1.0 f64 0.000000000000001 113
  brw_state_init
  chk eq brw_observe 3 f64 0.1 0 114
  chk eq brw_observe 3 f64 5000.0 1 115
  chk and eq get g_bs_np 0 2 and eq get g_bs_o99 0 1 eq get g_bs_no 0 2 116
  chk and eq brw_observe 3 q_inf -1 eq get g_bs_no 0 2 117
  chk eq get g_bs_cdf 0 mul 2 BRW_NH 118
end

fn main to int
  put g_ba_rs 0 or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  brw_grid_init
  test_grid
  test_lse
  test_posterior
  test_entropy
  test_info
  test_reduce
  test_binom
  test_verdict
  test_choice
  test_cdf_preq
  ba_puts t_ba_s1
  ba_put_u64 get g_ba_chk 0
  ba_puts t_ba_s2
  ba_put_u64 get g_ba_fl 0
  ba_puts t_ba_s3
  if ne get g_ba_fl 0 0
    ret 1
  end
  ret 0
end

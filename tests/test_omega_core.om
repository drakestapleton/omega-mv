note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_core.om against C oracle.
om2

text g_tu "c5909322e369f2093deff2dcb998014d73dd9c80e90fde07068790a55534de5c"
text g_tb "0153f3611fbad89a1aee7279504c8f8cb7cb1ea0289bf2a9aa81c3fbe6a31efd"
text g_tu32 "171653a2a7746c047d39d8fd16148b6eab255c30d6b141606373785dd632917f"
text g_ts16 "e2c3b9f883a21e9f9e0d0cd9b30ca3a7ad20fd8067d073ca30320643eca650de"
text g_tfp "9f7c6eb3b4d00e3c461c1f5077edde0083f2e58cfc0429f36c3da88c71a2435d"
text g_tbv "55f8292f8414d1a42e045589c54c5b646f8a3624f16bbfca79a8f22933f4fc07"
text g_tby "3cf27c1ec7c7a23063f21ca996ae5467ee0424036ebf18c95c85b8af91cbb573"
text g_tseq "c60be1d94606eb60453a1cd482350b95d7e7ae31d6662fbdc7441c0daf1fac81"
text g_tcap "c81d69a69d3b7346d4ea03b6999f813ee9dc0fa5a3d67e60e13ff8c258c66102"
text g_vb "8bc8de38652c11ab8be4924fcee11e36ad33d234048604c44c3bfa83fb5f1510"
text g_va "42d2d6f5c9b9ac1f5e1eb8b5ac3190d315146818ac3b69c2cc5a4630155abb7d"
text g_vp "b5b204039d1a112ea0922257a4001b0a7f3a9a87ad055762cf6fd83bae292e8d"
text g_op "24a664c7a3d34113fb0a793d219d89b6f21f8bab3474505f71daa2ea477943ea"
text g_ap "aaaca700c857278e94fbfe672eafbdd803aab6ceb5c61d50802bbbd479b0af98"
text g_ef "b10a63d1c1b4aa17b0d2b9bddbd64e553627c61085b0199351f2632c00d830c2"

text t_k1 "attr1"
text t_v1 "xy"
text msg_pass "OMEGA_CORE_OM_PASS\n"
text msg_fail "OMEGA_CORE_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_slot_hex idx long gold view uchar * to void
  chk ge idx 0
  if lt idx 0
    ret
  end
  idb = new uchar 32 0
  core_get_id ulong idx idb
  for i ulong 32
    b = uint get idb i
    chk eq sh_hexd shr b 4 get gold mul i 2
    chk eq sh_hexd and b 15 get gold add mul i 2 1
  end
end

fn test_builders to void
  chk eq omega_graph_create 0
  chk_slot_hex omega_build_type_unit g_tu
  itb = omega_build_type_bool
  chk_slot_hex itb g_tb
  itu32 = omega_build_type_uint 32
  chk_slot_hex itu32 g_tu32
  chk_slot_hex omega_build_type_signed_int 16 g_ts16
  chk_slot_hex omega_build_type_fp32 g_tfp
  chk_slot_hex omega_build_type_bitvector 64 g_tbv
  chk_slot_hex omega_build_type_byte g_tby

  id0 = new uchar 32 0
  core_get_id ulong itu32 id0
  chk_slot_hex omega_build_type_sequence id0 10 g_tseq
  chk_slot_hex omega_build_type_cap_ref g_tcap

  id1 = new uchar 32 0
  core_get_id ulong itb id1
  chk_slot_hex omega_build_val_bool id1 true g_vb
  iva = omega_build_val_uint id0 32 42
  chk_slot_hex iva g_va
  ivc = omega_build_val_uint id0 32 100
  chk_slot_hex omega_build_param id0 7 g_vp
  iop = omega_build_op_binary 3 1 id0
  chk_slot_hex iop g_op

  chk eq omega_graph_find_object id0 itu32
  chk eq omega_object_add_attribute 0 t_k1 t_v1 len t_v1 0
  chk eq omega_object_add_relation 0 1 id0 0
  chk eq omega_object_add_constraint 0 1 t_v1 len t_v1 0

  id2 = new uchar 32 0
  core_get_id ulong iop id0
  core_get_id ulong iva id1
  core_get_id ulong ivc id2
  chk eq omega_graph_find_object_const id0 iop
  chk_slot_hex omega_build_apply id0 id1 id2 g_ap
  chk_slot_hex omega_build_effect 1 2 3 ulong 0x0102030405060708 g_ef
  omega_graph_destroy
  chk eq get g_core_obj_cnt 0 0
end

fn test_effects to void
  meta = new ulong 5 0
  put meta 0 3
  put meta 1 9
  put meta 2 77
  put meta 3 ulong 0xfedcba9876543210
  put meta 4 2
  cref = new uchar 32 0
  put cref 0 0xab
  put cref 31 0xcd
  pb = new uchar 128 0
  put pb 0 0x11
  put pb 1 0x22
  raw = new uchar 178 0
  chk eq omega_effect_payload_encode meta cref pb raw CORE_EFF_OK

  m2 = new ulong 5 0
  c2 = new uchar 32 0
  p2 = new uchar 128 0
  chk eq omega_effect_payload_decode raw 178 m2 c2 p2 CORE_EFF_OK
  chk eq get m2 0 3
  chk eq get m2 1 9
  chk eq get m2 2 77
  chk eq get m2 3 ulong 0xfedcba9876543210
  chk eq get m2 4 2
  chk eq get c2 0 0xab
  chk eq get c2 31 0xcd
  chk eq get p2 0 0x11
  chk eq get p2 1 0x22

  chk eq omega_effect_payload_decode raw 176 m2 c2 p2 CORE_EFF_ERR_V1
  chk eq omega_effect_payload_decode raw 100 m2 c2 p2 CORE_EFF_ERR_LEN
  put raw 52 1
  chk eq omega_effect_payload_decode raw 178 m2 c2 p2 CORE_EFF_ERR_PAD
  put raw 52 0
  put raw 0 0
  put raw 1 0
  chk eq omega_effect_payload_decode raw 178 m2 c2 p2 CORE_EFF_ERR_RES

  ebuf = new uchar 64 0
  chk eq omega_effect_strerror CORE_EFF_OK ebuf 64 2
  chk gt omega_effect_strerror CORE_EFF_ERR_V1 ebuf 64 10
end

fn test_eval to void
  r = new ulong 1 0
  chk eq omega_eval_pure_binary_uint 3 1 8 200 100 r 0
  chk eq get r 0 44
  chk eq omega_eval_pure_binary_uint 3 2 8 200 100 r 0
  chk eq get r 0 255
  chk eq omega_eval_pure_binary_uint 3 3 8 200 100 r -2

  chk eq omega_eval_pure_binary_uint 4 1 8 5 10 r 0
  chk eq get r 0 251
  chk eq omega_eval_pure_binary_uint 4 3 8 5 10 r -2

  all1 = ulong 0xffffffffffffffff
  chk eq omega_eval_pure_binary_uint 5 3 64 all1 2 r -2
  chk eq omega_eval_pure_binary_uint 5 1 64 all1 2 r 0
  chk eq get r 0 sub all1 1
  chk eq omega_eval_pure_binary_uint 5 2 8 20 20 r 0
  chk eq get r 0 255

  chk eq omega_eval_pure_binary_uint 6 1 32 42 0 r -1
  chk eq omega_eval_pure_binary_uint 6 1 32 42 6 r 0
  chk eq get r 0 7
  chk eq omega_eval_pure_binary_uint 7 1 32 9 9 r 0
  chk eq get r 0 1
  chk eq omega_eval_pure_binary_uint 8 1 32 5 9 r 0
  chk eq get r 0 1
  chk eq omega_eval_pure_binary_uint 9 1 8 0x0f 0x33 r 0
  chk eq get r 0 3
  chk eq omega_eval_pure_binary_uint 10 1 8 0x0f 0x30 r 0
  chk eq get r 0 0x3f
end

fn main to int
  test_builders
  test_effects
  test_eval
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

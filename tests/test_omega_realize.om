note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_realize.om.
om2

text real_addsub_gold "963600bc4fc5bc3bf3aef1c6ae9d84625d55c64fab7d36cdc00aa17a39ec45c3"
text msg_pass "OMEGA_REALIZE_OM_PASS\n"
text msg_fail "OMEGA_REALIZE_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn rd32_code off ulong to uint
  b0 = uint get g_real_code off
  b1 = uint get g_real_code add off 1
  b2 = uint get g_real_code add off 2
  b3 = uint get g_real_code add off 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn test_realize to void
  sem = new uchar 32 0
  for i ulong 32
    put sem i uchar add i 1
  end

  note f_add_sub: ADD X0,X0,X1 (0x8b010000), SUB X0,X0,X2 (0xcb020000), RET (0xd65f03c0)
  chk eq omega_realize_f_add_sub sem 0
  chk eq get g_real_has_id 0 1
  chk eq get g_real_profile 0 1
  chk eq get g_real_code_len 0 12
  chk eq rd32_code 0 uint 0x8b010000
  chk eq rd32_code 4 uint 0xcb020000
  chk eq rd32_code 8 uint 0xd65f03c0

  note Save realization id and verify determinism + sensitivity to code mutation
  id1 = new uchar 32 0
  for i ulong 32
    put id1 i get g_real_id i
  end
  chk_hex32 id1 real_addsub_gold
  chk eq omega_compute_realization_id 0
  same = ulong 1
  for i ulong 32
    if ne get id1 i get g_real_id i
      same = 0
    end
  end
  chk eq same 1

  note pure_binary ops: ADD, SUB, MUL, AND, OR
  chk eq omega_realize_pure_binary REAL_OP_ADD sem 0
  chk eq get g_real_code_len 0 8
  chk eq rd32_code 0 uint 0x8b010000
  chk eq rd32_code 4 uint 0xd65f03c0

  chk eq omega_realize_pure_binary REAL_OP_SUB sem 0
  chk eq rd32_code 0 uint 0xcb010000

  chk eq omega_realize_pure_binary REAL_OP_MUL sem 0
  chk eq rd32_code 0 uint 0x9b017c00

  chk eq omega_realize_pure_binary REAL_OP_AND sem 0
  chk eq rd32_code 0 uint 0x8a010000

  chk eq omega_realize_pure_binary REAL_OP_OR sem 0
  chk eq rd32_code 0 uint 0xaa010000

  note Invalid opcode refused
  chk eq omega_realize_pure_binary 99 sem -1
end

fn main to int
  test_realize
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

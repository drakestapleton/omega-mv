fn t12_train_cm to void
ds_cm_init 2
rng = or shl ulong 2654435769 32 ulong 2135587861
for i ulong 200
rng = xor rng shl rng 13
rng = xor rng shr rng 7
rng = xor rng shl rng 17
M = add 8 rem rng 120
N = add 4 rem shr rng 20 60
sb = mul add add mul M N M N 8
put ds_cm_feat 0 0
put ds_cm_feat 1 M
put ds_cm_feat 2 N
put ds_cm_feat 3 sb
put ds_cm_feat 4 1048576
put ds_cm_feat 5 0
put ds_cm_feat 6 0
l2 = add 10.0f64 mul 0.95f64 add ds_log2 f64 M ds_log2 f64 N
ps = ulong ds_exp2 l2
st = ds_cm_observe_feat 0 ps 0
end
end

fn test_costmodel_reuse to void
t12_train_cm
d = u_day u_d20
q = bitcast ulong 0.9f64
u_set_txt 0 u_hdr t12_b1
u_check eq ds_parse_side 0 0 t12_m1
rc = ds_eval_current 0 d 0 q
u_check eq rc 1 t12_m2
rc = ds_eval_current 0 d 1 q
u_check eq rc 0 t12_m3
put ds_cm_feat 0 0
put ds_cm_feat 1 64
put ds_cm_feat 2 16
put ds_cm_feat 3 mul add add mul ulong 64 16 64 16 8
put ds_cm_feat 4 1048576
put ds_cm_feat 5 0
put ds_cm_feat 6 0
pst = ds_cm_predict_feat 0
u_check eq get ds_cm_pred 4 1 t12_m4
exp_ns = div ds_exp2 bitcast f64 get ds_cm_pred 0 1000.0f64
u_check u_near bitcast f64 get ds_sc 3 exp_ns 1.0e-6f64 t12_m5
u_check ne and get ds_sc 11 4 0 t12_m6
u_set_txt 0 u_hdr t12_b2
u_check eq ds_parse_side 0 0 t12_m7
rc = ds_eval_current 0 d 1 q
u_check eq rc 1 t12_m8
end


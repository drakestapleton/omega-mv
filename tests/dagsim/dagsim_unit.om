note ---- 6. test_sync ----
text t6_b1 "resource id=cpu kind=compute slots=2 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=30 prov=measured src=t\nop id=C kind=compute engine=cpu t_ns=5 prov=measured src=t\nsync id=s ops=A,B\ndep s C\n"
text t6_b2 "resource id=cpu kind=compute slots=2 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=30 prov=measured src=t\nop id=fence kind=barrier t_ns=7 prov=measured src=t\nop id=C kind=compute engine=cpu t_ns=5 prov=measured src=t\ndep A fence\ndep B fence\ndep fence C\n"
text t6_c "C"
text t6_m1 "sync status"
text t6_m2 "C waits for slower of A,B"
text t6_m3 "sync makespan 35"
text t6_m4 "costed barrier makespan 42"
text t6_m5 "sync attribution 7"

fn test_sync to void
d = u_day u_d20
rc = u_eval_body t6_b1 d 0
u_check eq rc 0 t6_m1
ci = ds_find_op_name t6_c
u_check and ge ci 0 u_near bitcast f64 get ds_sc add 4512 ulong ci 30.0f64 1.0e-9f64 t6_m2
u_check u_near bitcast f64 get ds_sc 3 35.0f64 1.0e-9f64 t6_m3
rc = u_eval_body t6_b2 d 0
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 42.0f64 1.0e-9f64 t6_m4
u_check u_near bitcast f64 get ds_sc 5829 7.0f64 1.0e-9f64 t6_m5
end


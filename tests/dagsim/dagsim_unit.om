note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note tests/dagsim/dagsim_unit.om -- Pure seeded OM-2 analytical unit tests for dagsim (omega-mv#583).
note Composed after tools/dagsim/dagsim.om:
note   cat tools/dagsim/dagsim.om tests/dagsim/dagsim_unit.om | seed/out/omc > dagsim_unit

global u_checks ulong 1
global u_fail ulong 1
global u_sc2 ulong 8192
global u_rsn2 uchar 256
global u_rsn2_len ulong 1

text u_hdr "oev version=1\nmachine id=t soc=t cores=4 mem_bytes=1000 prov=specified src=test\nbuild repo=omega-mv sha=0000000000000000000000000000000000000000\ncalibration id=c1 taken=2026-10-19 valid_days=30 load1=1.0 src=test\nresource id=mem kind=capacity cap=1000 prov=specified src=test\nenergy instrument=none\n"
text u_d20 "2026-10-20"
text u_d24 "2026-10-24"
text u_dnov18 "2026-11-18"
text u_dnov19 "2026-11-19"
text u_fail_pfx "  FAIL "
text u_sum1 "dagsim_unit: "
text u_sum2 " checks, "
text u_sum3 " failed\n"

fn u_check cond bool msg view uchar * to void
put u_checks 0 add get u_checks 0 1
if not cond
put u_fail 0 add get u_fail 0 1
ds_out_reset
ds_out_text u_fail_pfx
ds_out_text msg
ds_out_ch uchar 10
ds_out_flush 2
end
end

fn u_near a f64 b f64 tol f64 to bool
ret le fabs sub a b tol
end

fn u_day s view uchar * to long
ret ds_day_from_slice s len s
end

fn u_set_txt1 side ulong h view uchar * to void
nh = len h
if eq side 0
for i ulong nh bound 8192
put ds_txt i get h i
end
put ds_txt_len 0 nh
else
for i ulong nh bound 8192
put ds_txt2 i get h i
end
put ds_txt2_len 0 nh
end
end

fn u_set_txt side ulong h view uchar * b view uchar * to void
nh = len h
nb = len b
if eq side 0
for i ulong nh bound 1024
put ds_txt i get h i
end
for i ulong nb bound 8192
put ds_txt add nh i get b i
end
put ds_txt_len 0 add nh nb
else
for i ulong nh bound 1024
put ds_txt2 i get h i
end
for i ulong nb bound 8192
put ds_txt2 add nh i get b i
end
put ds_txt2_len 0 add nh nb
end
end

fn u_rsn_has sub_s view uchar * to bool
ns = len sub_s
nr = get ds_reason_len 0
if gt ns nr
ret false
end
lim = add sub nr ns 1
for i ulong lim bound 256
ok = true
for j ulong ns bound 128
if ne get ds_reason add i j get sub_s j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

fn u_err_has sub_s view uchar * to bool
ns = len sub_s
nr = ulong 0
while lt nr 255 bound 256
if eq get ds_err nr 0
break
end
nr = add nr 1
end
if gt ns nr
ret false
end
lim = add sub nr ns 1
for i ulong lim bound 256
ok = true
for j ulong ns bound 128
if ne get ds_err add i j get sub_s j
ok = false
break
end
end
if ok
ret true
end
end
ret false
end

text u_inv_bnd "makespan below bound"
text u_inv_cp "below critical path bound"
text u_inv_attr "attribution does not sum to makespan"
text u_inv_det "not deterministic"

fn u_check_invariants asof long hasm ulong to void
mk = bitcast f64 get ds_sc 3
bnd = bitcast f64 get ds_sc 19
cpb = bitcast f64 get ds_sc 20
u_check ge add mk 0.000001f64 bnd u_inv_bnd
u_check ge add mk 0.000001f64 cpb u_inv_cp
s = f64 0.0f64
for i ulong 7
s = add s bitcast f64 get ds_sc add 5824 i
end
u_check u_near s mk 0.000001f64 u_inv_attr
for i ulong 8192
put u_sc2 i get ds_sc i
end
rc2 = ds_eval_current 0 asof hasm bitcast ulong 0.9f64
same = eq rc2 0
if same
for i ulong 8192
if ne get u_sc2 i get ds_sc i
same = false
break
end
end
end
u_check same u_inv_det
end

fn u_eval_body body view uchar * asof long hasm ulong to ulong
u_set_txt 0 u_hdr body
if ne ds_parse_side 0 0
ret 9
end
rc = ds_eval_current 0 asof hasm bitcast ulong 0.9f64
if eq rc 0
u_check_invariants asof hasm
end
ret rc
end

fn u_eval_file path view uchar * asof long to ulong
if ne ds_read_file_side 0 path len path 0
ret 9
end
ret ds_eval_current 0 asof 0 bitcast ulong 0.9f64
end

note ---- 1. test_serial_chain ----
text t1_body "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=20 prov=measured src=t\nop id=C kind=compute engine=cpu t_ns=30 prov=measured src=t\ndep A B\ndep B C\n"
text t1_m1 "serial chain status"
text t1_m2 "serial makespan"
text t1_m3 "critical path bound"
text t1_m4 "critical path length"
text t1_m5 "compute attribution"
text t1_m6 "residual"
text t1_m7 "C window"
text t1_m8 "prov mask"
text t1_m9 "conservation"

fn test_serial_chain to void
rc = u_eval_body t1_body u_day u_d20 0
u_check eq rc 0 t1_m1
u_check u_near bitcast f64 get ds_sc 3 60.0f64 1.0e-9f64 t1_m2
u_check u_near bitcast f64 get ds_sc 20 60.0f64 1.0e-9f64 t1_m3
u_check eq get ds_sc 21 3 t1_m4
u_check u_near bitcast f64 get ds_sc 5824 60.0f64 1.0e-9f64 t1_m5
u_check u_near bitcast f64 get ds_sc 5830 0.0f64 1.0e-9f64 t1_m6
u_check and u_near bitcast f64 get ds_sc 4514 30.0f64 1.0e-9f64 u_near bitcast f64 get ds_sc 4770 60.0f64 1.0e-9f64 t1_m7
u_check eq get ds_sc 11 24 t1_m8
u_check and eq get ds_pm 12 3 u_near bitcast f64 get ds_sc 16 60.0f64 1.0e-9f64 t1_m9
end

note ---- 2. test_perfect_overlap ----
text t2_b1 "resource id=cpu kind=compute slots=4 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=20 prov=measured src=t\nop id=C kind=compute engine=cpu t_ns=30 prov=measured src=t\n"
text t2_b2 "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=20 prov=measured src=t\nop id=C kind=compute engine=cpu t_ns=30 prov=measured src=t\n"
text t2_m1 "overlap status"
text t2_m2 "independent overlap makespan"
text t2_m3 "no serialization when slots suffice"
text t2_m4 "one slot status"
text t2_m5 "one-slot makespan"
text t2_m6 "critical path stays 30"
text t2_m7 "resource bound 60"
text t2_m8 "serialization 30"

fn test_perfect_overlap to void
d = u_day u_d20
rc = u_eval_body t2_b1 d 0
u_check eq rc 0 t2_m1
u_check u_near bitcast f64 get ds_sc 3 30.0f64 1.0e-9f64 t2_m2
u_check u_near bitcast f64 get ds_sc 5828 0.0f64 1.0e-9f64 t2_m3
rc = u_eval_body t2_b2 d 0
u_check eq rc 0 t2_m4
u_check u_near bitcast f64 get ds_sc 3 60.0f64 1.0e-9f64 t2_m5
u_check u_near bitcast f64 get ds_sc 20 30.0f64 1.0e-9f64 t2_m6
u_check u_near bitcast f64 get ds_sc 19 60.0f64 1.0e-9f64 t2_m7
u_check u_near bitcast f64 get ds_sc 5828 30.0f64 1.0e-9f64 t2_m8
end

note ---- 3. test_shared_bandwidth ----
text t3_b1 "resource id=cpu kind=compute slots=2 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 prov=measured src=t\nop id=A kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\nop id=B kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\n"
text t3_b2 "resource id=cpu kind=compute slots=2 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 prov=measured src=t\nop id=A kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\nop id=B kind=copy engine=cpu bytes=5e8 bw=pipe prov=measured src=t\n"
text t3_b3 "resource id=cpu kind=compute slots=1 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 prov=measured src=t\nop id=A kind=compute engine=cpu t_ns=5e8 bytes=1e9 bw=pipe prov=measured src=t\n"
text t3_b4 "resource id=cpu kind=compute slots=1 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 prov=measured src=t\nop id=A kind=compute engine=cpu t_ns=4e9 bytes=1e9 bw=pipe prov=measured src=t\n"
text t3_b5 "resource id=cpu kind=compute slots=1 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 prov=measured src=t\nop id=A kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\nop id=B kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\n"
text t3_m1 "bw status"
text t3_m2 "two concurrent copies 2e9"
text t3_m3 "both end at 2 s"
text t3_m4 "A contention 1e9"
text t3_m5 "cp bound 1 s"
text t3_m6 "pipe work bound 2 s"
text t3_m7 "bw+contention = 2 s"
text t3_m8 "contention attributed 1 s"
text t3_m9 "bw2 status"
text t3_m10 "B ends at 1 s"
text t3_m11 "A ends at 1.5 s"
text t3_m12 "max(F/P,Q/B) floor"
text t3_m13 "op floor"
text t3_m14 "compute-bound op alone"
text t3_m15 "attributed as compute"
text t3_m16 "serialized copies no contention"

fn test_shared_bandwidth to void
d = u_day u_d20
rc = u_eval_body t3_b1 d 0
u_check eq rc 0 t3_m1
u_check u_near bitcast f64 get ds_sc 3 2.0e9f64 1.0e-3f64 t3_m2
u_check and u_near bitcast f64 get ds_sc 4768 2.0e9f64 1.0e-3f64 u_near bitcast f64 get ds_sc 4769 2.0e9f64 1.0e-3f64 t3_m3
u_check u_near bitcast f64 get ds_sc 5536 1.0e9f64 1.0e-3f64 t3_m4
u_check u_near bitcast f64 get ds_sc 20 1.0e9f64 1.0e-3f64 t3_m5
u_check u_near bitcast f64 get ds_sc 19 2.0e9f64 1.0e-3f64 t3_m6
u_check u_near add bitcast f64 get ds_sc 5825 bitcast f64 get ds_sc 5826 2.0e9f64 1.0e-3f64 t3_m7
u_check u_near bitcast f64 get ds_sc 5826 1.0e9f64 1.0e-3f64 t3_m8
rc = u_eval_body t3_b2 d 0
u_check eq rc 0 t3_m9
u_check u_near bitcast f64 get ds_sc 4769 1.0e9f64 1.0e-3f64 t3_m10
u_check u_near bitcast f64 get ds_sc 4768 1.5e9f64 1.0e-3f64 t3_m11
rc = u_eval_body t3_b3 d 0
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 1.0e9f64 1.0e-3f64 t3_m12
u_check u_near bitcast f64 get ds_sc 5280 1.0e9f64 1.0e-3f64 t3_m13
rc = u_eval_body t3_b4 d 0
u_check and eq rc 0 and u_near bitcast f64 get ds_sc 3 4.0e9f64 1.0e-3f64 u_near bitcast f64 get ds_sc 5536 0.0f64 1.0e-3f64 t3_m14
u_check u_near bitcast f64 get ds_sc 5824 4.0e9f64 1.0e-3f64 t3_m15
rc = u_eval_body t3_b5 d 0
u_check and eq rc 0 and u_near bitcast f64 get ds_sc 3 2.0e9f64 1.0e-3f64 u_near bitcast f64 get ds_sc 5826 0.0f64 1.0e-3f64 t3_m16
end

note ---- 4. test_capacity_refusal ----
text t4_b1 "resource id=cpu kind=compute slots=2 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nbuffer id=x bytes=600 cap=mem first=A last=A\nbuffer id=y bytes=600 cap=mem first=A last=A\n"
text t4_b2 "resource id=cpu kind=compute slots=2 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=10 prov=measured src=t\ndep A B\nbuffer id=x bytes=600 cap=mem first=A last=A\nbuffer id=y bytes=600 cap=mem first=B last=B\n"
text t4_b3 "resource id=cpu kind=compute slots=2 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nbuffer id=big bytes=2000 cap=mem\n"
text t4_sx "x"
text t4_sy "y"
text t4_m1 "1200 live bytes in 1000 refuses"
text t4_m2 "reason names x and y"
text t4_m3 "disjoint lifetimes fit"
text t4_m4 "peak 600"
text t4_m5 "oversized resident refuses"

fn test_capacity_refusal to void
d = u_day u_d20
rc = u_eval_body t4_b1 d 0
u_check eq rc 4 t4_m1
u_check and u_rsn_has t4_sx u_rsn_has t4_sy t4_m2
rc = u_eval_body t4_b2 d 0
u_check eq rc 0 t4_m3
u_check u_near bitcast f64 get ds_sc 6344 600.0f64 1.0e-9f64 t4_m4
rc = u_eval_body t4_b3 d 0
u_check eq rc 4 t4_m5
end


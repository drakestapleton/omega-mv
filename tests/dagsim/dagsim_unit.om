fn u_diff_run to ulong
ds_pack_side 0
ds_pack_side 1
for i ulong 64
put ds_ra i 0
end
ret ds_run_diff
end

fn test_minimum_work_diff to void
u_set_txt 0 u_hdr t15_base
u_check eq ds_parse_side 0 0 t15_m1
u_set_txt 1 u_hdr t15_base
u_check eq ds_parse_side 1 0 t15_m2
rc = u_diff_run
u_check and eq rc 0 and eq get ds_ra 12 0 and eq get ds_ra 10 0 eq get ds_ra 11 3 t15_m3
u_set_txt 1 u_hdr t15_tr2
u_check eq ds_parse_side 1 0 t15_m4
rc = u_diff_run
u_check and eq rc 0 and u_near bitcast f64 get ds_ra 34 20.0f64 1.0e-9f64 eq get ds_ra 10 1 t15_m5
u_set_txt 1 u_hdr t15_tr3
u_check eq ds_parse_side 1 0 t15_m6
rc = u_diff_run
u_check and eq rc 7 ne get ds_ra 14 0 t15_m7
u_set_txt 1 u_hdr t15_tr4
u_check eq ds_parse_side 1 0 t15_m8
rc = u_diff_run
u_check and eq rc 0 u_near bitcast f64 get ds_ra 35 20.0f64 1.0e-9f64 t15_m9
ds_pack_side 0
ds_pack_side 1
ds_mark_changed t15_chA len t15_chA
for i ulong 64
put ds_ra i 0
end
rc = ds_run_diff
u_check eq rc 7 t15_m10
u_set_txt 1 u_hdr t15_tr5
u_check eq ds_parse_side 1 0 t15_m11
rc = u_diff_run
u_check and ne rc 0 ne get ds_ra 13 0 t15_m12
end


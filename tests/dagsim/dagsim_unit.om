fn t16_peak_of s view uchar * to f64
i = ds_find_res_name s
if lt i 0
ret -1.0f64
end
ret bitcast f64 get ds_sc add 6344 ulong i
end

fn test_inverted_part1 to void
d24 = u_day u_d24
rc = u_eval_file t16_f1 d24
ok1 = eq rc 8
ok1 = and ok1 u_rsn_has t16_s_inv
ok1 = and ok1 u_rsn_has t16_s_fc
ok1 = and ok1 u_rsn_has t16_s_s20
ok1 = and ok1 u_rsn_has t16_s_la
ok1 = and ok1 u_rsn_has t16_s_e10
ok1 = and ok1 not u_rsn_has t16_s_neg
u_check ok1 t16_m1
u_check and eq get ds_sc 3 0 eq get ds_sc 6344 0 t16_m2
rlen1 = get ds_reason_len 0
put u_rsn2_len 0 rlen1
for i ulong rlen1 bound 256
put u_rsn2 i get ds_reason i
end
rc2 = u_eval_file t16_f1 d24
same = and eq rc rc2 eq rlen1 get ds_reason_len 0
if same
for i ulong rlen1 bound 256
if ne get u_rsn2 i get ds_reason i
same = false
break
end
end
end
u_check same t16_m3
rc = u_eval_file t16_f2 d24
u_check and eq rc 8 and u_rsn_has t16_s_fc u_rsn_has t16_s_la t16_m4
rc = u_eval_file t16_f3 d24
u_check and eq rc 4 and u_rsn_has t16_s_r1 u_rsn_has t16_s_r2 t16_m5
rc = u_eval_file t16_f4 d24
u_check eq rc 0 t16_m6
u_check u_near t16_peak_of t16_s_mem 80.0f64 1.0e-9f64 t16_m7
u_check u_near bitcast f64 get ds_sc 3 30.0f64 1.0e-9f64 t16_m8
rc = u_eval_file t16_f5 d24
u_check eq rc 0 t16_m9
u_check u_near t16_peak_of t16_s_mem 80.0f64 1.0e-9f64 t16_m10
end

fn test_inverted_part2 to void
d20 = u_day u_d20
rc = u_eval_body t16_z1 d20 0
u_check eq rc 0 t16_m11
u_check u_near bitcast f64 get ds_sc 6344 0.0f64 1.0e-9f64 t16_m12
rc = u_eval_body t16_z2 d20 0
u_check eq rc 4 t16_m13
rc = u_eval_body t16_om d20 0
u_check eq rc 0 t16_m14
u_check u_near bitcast f64 get ds_sc 6344 175.0f64 1.0e-9f64 t16_m15
rc = u_eval_body t16_rnd d20 0
u_check and eq rc 8 u_rsn_has t16_s_neg t16_m16
u_check and u_near t16_peak_of t16_s_hbm 0.0f64 1.0e-9f64 eq get ds_sc 3 0 t16_m17
u_set_txt 0 u_hdr t16_p1
u_check and eq ds_parse_side 0 9 u_err_has t16_s_fin t16_m18
u_set_txt 0 u_hdr t16_p2
u_check and eq ds_parse_side 0 9 u_err_has t16_s_fin t16_m19
u_set_txt 0 u_hdr t16_p3
u_check and eq ds_parse_side 0 9 u_err_has t16_s_nop t16_m20
end

fn main to int
test_serial_chain
test_perfect_overlap
test_shared_bandwidth
test_capacity_refusal
test_lifetimes
test_sync
test_launch
test_calibration
test_intervals
test_energy

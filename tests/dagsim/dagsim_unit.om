text t7_b1 "resource id=gpu kind=compute slots=1 prov=specified src=test\nresource id=L kind=launch prov=measured src=t\nop id=A kind=compute engine=gpu t_ns=0 launch_ns=40e6 launcher=L prov=measured src=t\nop id=B kind=compute engine=gpu t_ns=0 launch_ns=40e6 launcher=L prov=measured src=t\n"
text t7_b2 "resource id=gpu kind=compute slots=1 prov=specified src=test\nresource id=cpu kind=compute slots=1 prov=specified src=test\nresource id=L1 kind=launch prov=measured src=t\nresource id=L2 kind=launch prov=measured src=t\nop id=A kind=compute engine=gpu t_ns=0 launch_ns=40e6 launcher=L1 prov=measured src=t\nop id=B kind=compute engine=cpu t_ns=0 launch_ns=40e6 launcher=L2 prov=measured src=t\n"
text t7_m1 "serialized launches add"
text t7_m2 "launch+serialization"
text t7_m3 "independent launches overlap"

fn test_launch to void
d = u_day u_d20
rc = u_eval_body t7_b1 d 0
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 80.0e6f64 1.0e-3f64 t7_m1
u_check u_near add bitcast f64 get ds_sc 5827 bitcast f64 get ds_sc 5828 80.0e6f64 1.0e-3f64 t7_m2
rc = u_eval_body t7_b2 d 0
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 40.0e6f64 1.0e-3f64 t7_m3
end

note ---- 8. test_calibration ----
text t8_b1 "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\n"
text t8_nocal "oev version=1\nmachine id=t soc=t cores=4 mem_bytes=1000 prov=specified src=test\nbuild repo=omega-mv sha=0000000000000000000000000000000000000000\nenergy instrument=none\n"
text t8_unk "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=measured src=t\nop id=B kind=compute engine=cpu prov=unknown src=arch-244-not-run\ndep A B\n"
text t8_syn "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=10 prov=synthetic src=t\n"
text t8_sb "B"
text t8_m1 "31 days stale refuses"
text t8_m2 "30 days valid OK"
text t8_m3 "parse without calibration"
text t8_m4 "measured without calibration refuses"
text t8_m5 "unknown op refuses"
text t8_m6 "reason names B"
text t8_m7 "no makespan on refusal"
text t8_m8 "synthetic flag"

fn test_calibration to void
rc = u_eval_body t8_b1 u_day u_dnov19 0
u_check eq rc 2 t8_m1
rc = u_eval_body t8_b1 u_day u_dnov18 0
u_check eq rc 0 t8_m2
u_set_txt 0 t8_nocal t8_b1
u_check eq ds_parse_side 0 0 t8_m3
rc = ds_eval_current 0 u_day u_d20 0 bitcast ulong 0.9f64
u_check eq rc 3 t8_m4
rc = u_eval_body t8_unk u_day u_d20 0
u_check eq rc 1 t8_m5
u_check u_rsn_has t8_sb t8_m6
u_check eq get ds_sc 3 0 t8_m7
rc = u_eval_body t8_syn u_day u_d20 0
u_check and eq rc 0 eq get ds_sc 26 1 t8_m8
end

note ---- 9. test_intervals ----
text t9_b1 "resource id=cpu kind=compute slots=2 prov=specified src=test\nresource id=pipe kind=bandwidth cap=1e9 lo=0.5e9 hi=2e9 prov=measured src=t\nop id=A kind=compute engine=cpu t_ns=100 lo=80 hi=150 prov=measured src=t\nop id=B kind=copy engine=cpu bytes=1e9 bw=pipe prov=measured src=t\ndep A B\n"
text t9_m1 "parse interval"
text t9_m2 "interval status"
text t9_m3 "nominal 100+1e9"
text t9_m4 "optimistic 80+0.5e9"
text t9_m5 "pessimistic 150+2e9"

fn test_intervals to void
u_set_txt 0 u_hdr t9_b1
u_check eq ds_parse_side 0 0 t9_m1
d = u_day u_d20
q = bitcast ulong 0.9f64
rc = ds_eval_current 0 d 0 q
u_check eq rc 0 t9_m2
u_check u_near bitcast f64 get ds_sc 3 add 100.0f64 1.0e9f64 1.0e-3f64 t9_m3
rc = ds_eval_current 1 d 0 q
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 add 80.0f64 0.5e9f64 1.0e-3f64 t9_m4
rc = ds_eval_current -1 d 0 q
u_check and eq rc 0 u_near bitcast f64 get ds_sc 3 add 150.0f64 2.0e9f64 1.0e-3f64 t9_m5
end

note ---- 10. test_energy ----
text t10_b1 "resource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=1e9 prov=measured src=t\n"
text t10_syn "oev version=1\nmachine id=t soc=t cores=4 mem_bytes=1000 prov=specified src=test\nbuild repo=omega-mv sha=0000000000000000000000000000000000000000\ncalibration id=c1 taken=2026-10-19 valid_days=30 load1=1.0 src=test\nresource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=1e9 prov=measured src=t\nenergy instrument=tdp-guess boundary=soc power_w=100 prov=synthetic\n"
text t10_meas "oev version=1\nmachine id=t soc=t cores=4 mem_bytes=1000 prov=specified src=test\nbuild repo=omega-mv sha=0000000000000000000000000000000000000000\ncalibration id=c1 taken=2026-10-19 valid_days=30 load1=1.0 src=test\nresource id=cpu kind=compute slots=1 prov=specified src=test\nop id=A kind=compute engine=cpu t_ns=1e9 prov=measured src=t\nenergy instrument=cyberpower-ups-nut boundary=wall joules=42.5 prov=measured src=receipt.json\n"
text t10_bad "oev version=1\nmachine id=t soc=t cores=4 mem_bytes=1000 prov=specified src=test\nbuild repo=omega-mv sha=0000000000000000000000000000000000000000\nenergy instrument=none joules=42.5 prov=measured src=x\n"
text t10_empty ""
text t10_m1 "instrument=none means UNMEASURED"
text t10_m2 "parse synthetic energy"
text t10_m3 "synthetic power E=P*T 100 J"
text t10_m4 "parse measured energy"
text t10_m5 "measured joules pass through"
text t10_m6 "joules without instrument refused at parse"

fn test_energy to void
d = u_day u_d20
q = bitcast ulong 0.9f64
rc = u_eval_body t10_b1 d 0
ok = eq rc 0
ok = and ok eq get ds_sc 22 0
ok = and ok eq get ds_sc 23 0
u_check ok t10_m1
u_set_txt1 0 t10_syn
u_check eq ds_parse_side 0 0 t10_m2
rc = ds_eval_current 0 d 0 q
ok = eq rc 0
ok = and ok eq get ds_sc 23 1
ok = and ok eq get ds_sc 22 0
ok = and ok u_near bitcast f64 get ds_sc 24 100.0f64 1.0e-9f64
ok = and ok eq get ds_sc 26 1
u_check ok t10_m3
u_set_txt1 0 t10_meas
u_check eq ds_parse_side 0 0 t10_m4
rc = ds_eval_current 0 d 0 q
ok = eq rc 0
ok = and ok eq get ds_sc 22 1
ok = and ok u_near bitcast f64 get ds_sc 24 42.5f64 1.0e-9f64
ok = and ok eq get ds_sc 26 0

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_realize_synth.om against C oracle.
om2

text g_spark_id "1cd8a47cc9d954da026ed390b59823ba11bef63db615369d9a8a3a9815b939f4"
text g_spark_code "410080d2220080d2007c019b0000028bc0035fd6"
text g_qemu_id "9d3dc004cedaf9f16c43ee9274e50e35fcb038a85613be3b54b588febbb6bd9f"

text n_mul2 "mul_2"
text n_add1 "add_1"
text msg_pass "OMEGA_REALIZE_SYNTH_OM_PASS\n"
text msg_fail "OMEGA_REALIZE_SYNTH_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex buf view uchar * n ulong gold view uchar * to void
  for i ulong n bound 64
    b = uint get buf i
    chk eq sh_hexd shr b 4 get gold mul i 2
    chk eq sh_hexd and b 15 get gold add mul i 2 1
  end
end

fn main to int
  chk eq omega_program_build_unary_op 0 n_mul2 len n_mul2 PROG_OP_MUL 2 0
  chk eq omega_program_build_unary_op 1 n_add1 len n_add1 PROG_OP_ADD 1 0
  chk eq omega_program_compose 0 1 2 0

  note Differential inputs bit-exact parity with C xorshift64*
  xs = new ulong 84 0
  nx = omega_realize_differential_inputs 2 xs 84
  chk eq nx 84
  chk eq get xs 0 0
  chk eq get xs 19 ulong 0x100000000
  chk eq get xs 20 ulong 0x08c868ffdf09f57d
  chk eq get xs 83 ulong 0xbe0e6303d8e621e4

  note Trace hook set/clear
  chk eq omega_realize_set_trace_hook 1 42 0
  chk eq omega_realize_set_trace_hook 1 42 -1

  note DGX Spark (4-wide -> PRELOAD schedule)
  chk eq omega_synthesize_for_dgx_spark 2 0
  chk eq get g_rs_solved 0 1
  chk eq get g_rs_sched 0 PROG_SCHED_PRELOAD
  chk eq get g_rs_code_len 0 20
  chk eq get g_rs_est_cycles 0 7
  chk eq get g_rs_inputs_chk 0 84
  chk eq get g_rs_hook_events 0 1
  rid = new uchar 32 0
  for i ulong 32
    put rid i get g_rs_real_id i
  end
  chk_hex rid 32 g_spark_id
  code = new uchar 32 0
  for i ulong 20
    put code i get g_rs_code i
  end
  chk_hex code 20 g_spark_code

  note QEMU virt (2-wide -> SEQUENTIAL schedule)
  chk eq omega_synthesize_for_qemu_virt 2 0
  chk eq get g_rs_solved 0 1
  chk eq get g_rs_sched 0 PROG_SCHED_SEQUENTIAL
  chk eq get g_rs_code_len 0 20
  chk eq get g_rs_est_cycles 0 8
  chk eq get g_rs_inputs_chk 0 84
  chk eq get g_rs_hook_events 0 2
  for i ulong 32
    put rid i get g_rs_real_id i
  end
  chk_hex rid 32 g_qemu_id

  chk eq omega_realize_clear_trace_hook 42 0
  chk eq omega_realize_clear_trace_hook 42 -1

  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_matvec_quad.om.
om2

text mvq_code_gold "7b74d680905a80be2d9dec38f46481231910e5e22ed116f2448127a1552ccafa"
text mvq_real_gold "a4391bcbaf66a243ddae810ee38cc73f489a689b545ca5ba556d7f264d05f667"
text msg_pass "OMEGA_MATVEC_QUAD_OM_PASS\n"
text msg_fail "OMEGA_MATVEC_QUAD_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_matvec_quad to void
  chk eq omega_machine_build_dgx_spark 0
  sem = new uchar 32 0
  mach = new uchar 32 0
  for i ulong 32
    put sem i uchar add 0x10 i
    put mach i get g_mg_id i
  end

  chk eq omega_matvec_synthesize_quad4 sem mach MVQ_PROFILE_V8A 0
  chk eq get g_mvq_code_len 0 204
  chk eq get g_mvq_verified 0 1
  chk eq get g_mvq_kind 0 3
  chk eq get g_mvq_unroll 0 4
  chk eq get g_mvq_acc 0 4

  note Verify emitted 204-byte code SHA-256 matches C oracle
  code = new uchar 204 0
  for i ulong 204
    b = get g_mvq_code i
    put code i b
    put sh_dat i b
  end
  sh_all 204
  cdig = new uchar 32 0
  for i ulong 32
    put cdig i get sh_dig i
  end
  chk_hex32 cdig mvq_code_gold

  note Verify triple realization_id matches C oracle
  rid = new uchar 32 0
  for i ulong 32
    put rid i get g_mvq_real_id i
  end
  chk_hex32 rid mvq_real_gold

  note Cross-check estimated latency against C oracle (61 Spark, 66 QEMU)
  chk eq omega_machine_estimate_latency code 204 61
  chk eq omega_machine_build_qemu_virt 0
  chk eq omega_machine_estimate_latency code 204 66

  note Negative control: invalid profile refused
  chk eq omega_matvec_synthesize_quad4 sem mach 99 -1
end

fn main to int
  test_matvec_quad
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

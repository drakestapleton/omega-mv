note ---- I/O helpers ----
fn write_all s view uchar * n ulong to void
  if eq n 0
    ret
  end
  k = write 1 s 0 n
  if lt k 0
    ret
  end
end

fn print_u64 v ulong to void
  if eq v 0
    put g_numbuf 0 uchar 48
    k = write 1 g_numbuf 0 1
    ret
  end
  x = v
  cnt = ulong 0
  while gt x 0 bound 24
    put g_numbuf cnt uchar add rem x 10 48
    cnt = add cnt 1
    x = div x 10
  end
  i = ulong 0
  j = sub cnt 1
  while lt i j bound 24
    a = get g_numbuf i
    b = get g_numbuf j
    put g_numbuf i b
    put g_numbuf j a
    i = add i 1
    j = sub j 1
  end
  k = write 1 g_numbuf 0 cnt
end

fn chk gate ulong ok bool to void
  put g_total gate add get g_total gate 1
  if ok
    put g_pass gate add get g_pass gate 1
  else
    write_all t_fail_chk len t_fail_chk
    print_u64 gate
    write_all t_nl len t_nl
  end
end

note ---- SHA-256 ----
fn sha_kinit to void
  put g_sha_k 0 0x428a2f98
  put g_sha_k 1 0x71374491
  put g_sha_k 2 0xb5c0fbcf
  put g_sha_k 3 0xe9b5dba5
  put g_sha_k 4 0x3956c25b
  put g_sha_k 5 0x59f111f1
  put g_sha_k 6 0x923f82a4
  put g_sha_k 7 0xab1c5ed5
  put g_sha_k 8 0xd807aa98
  put g_sha_k 9 0x12835b01
  put g_sha_k 10 0x243185be
  put g_sha_k 11 0x550c7dc3
  put g_sha_k 12 0x72be5d74
  put g_sha_k 13 0x80deb1fe
  put g_sha_k 14 0x9bdc06a7
  put g_sha_k 15 0xc19bf174
  put g_sha_k 16 0xe49b69c1
  put g_sha_k 17 0xefbe4786
  put g_sha_k 18 0x0fc19dc6
  put g_sha_k 19 0x240ca1cc
  put g_sha_k 20 0x2de92c6f
  put g_sha_k 21 0x4a7484aa
  put g_sha_k 22 0x5cb0a9dc
  put g_sha_k 23 0x76f988da
  put g_sha_k 24 0x983e5152
  put g_sha_k 25 0xa831c66d
  put g_sha_k 26 0xb00327c8
  put g_sha_k 27 0xbf597fc7
  put g_sha_k 28 0xc6e00bf3
  put g_sha_k 29 0xd5a79147
  put g_sha_k 30 0x06ca6351
  put g_sha_k 31 0x14292967
  put g_sha_k 32 0x27b70a85
  put g_sha_k 33 0x2e1b2138
  put g_sha_k 34 0x4d2c6dfc
  put g_sha_k 35 0x53380d13
  put g_sha_k 36 0x650a7354
  put g_sha_k 37 0x766a0abb
  put g_sha_k 38 0x81c2c92e
  put g_sha_k 39 0x92722c85
  put g_sha_k 40 0xa2bfe8a1
  put g_sha_k 41 0xa81a664b
  put g_sha_k 42 0xc24b8b70
  put g_sha_k 43 0xc76c51a3
  put g_sha_k 44 0xd192e819
  put g_sha_k 45 0xd6990624
  put g_sha_k 46 0xf40e3585
  put g_sha_k 47 0x106aa070
  put g_sha_k 48 0x19a4c116
  put g_sha_k 49 0x1e376c08
  put g_sha_k 50 0x2748774c
  put g_sha_k 51 0x34b0bcb5
  put g_sha_k 52 0x391c0cb3
  put g_sha_k 53 0x4ed8aa4a
  put g_sha_k 54 0x5b9cca4f
  put g_sha_k 55 0x682e6ff3
  put g_sha_k 56 0x748f82ee
  put g_sha_k 57 0x78a5636f
  put g_sha_k 58 0x84c87814
  put g_sha_k 59 0x8cc70208
  put g_sha_k 60 0x90befffa
  put g_sha_k 61 0xa4506ceb
  put g_sha_k 62 0xbef9a3f7
  put g_sha_k 63 0xc67178f2
end

fn sha_sched_in off ulong to void
  for i ulong 16
    q = add off mul i 4
    x = uint get g_sha_in q
    x = or shl x 8 uint get g_sha_in add q 1
    x = or shl x 8 uint get g_sha_in add q 2
    put g_sha_w i or shl x 8 uint get g_sha_in add q 3
  end
  for i ulong 48
    x = get g_sha_w add i 1
    y = get g_sha_w add i 14
    x = add add get g_sha_w i get g_sha_w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put g_sha_w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn sha_sched_pad off ulong to void
  for i ulong 16
    q = add off mul i 4
    x = uint get g_sha_pad q
    x = or shl x 8 uint get g_sha_pad add q 1
    x = or shl x 8 uint get g_sha_pad add q 2
    put g_sha_w i or shl x 8 uint get g_sha_pad add q 3
  end
  for i ulong 48
    x = get g_sha_w add i 1
    y = get g_sha_w add i 14
    x = add add get g_sha_w i get g_sha_w add i 9 xor xor rotr x 7 rotr x 18 shr x 3
    put g_sha_w add i 16 add x xor xor rotr y 17 rotr y 19 shr y 10
  end
end

fn sha_rounds to void
  a = get g_sha_s 0
  b = get g_sha_s 1
  c = get g_sha_s 2
  d = get g_sha_s 3
  e = get g_sha_s 4
  f = get g_sha_s 5
  g = get g_sha_s 6
  h = get g_sha_s 7
  t = uint 0
  for i ulong 64
    h = add h get g_sha_k i
    h = add h get g_sha_w i
    t = xor rotr e 6 rotr e 11
    t = xor t rotr e 25
    h = add h t
    h = add h xor g and e xor f g
    d = add d h
    t = xor rotr a 2 rotr a 13
    t = xor t rotr a 22
    h = add h t
    t = and c or a b
    h = add h or and a b t
    t = h
    h = g
    g = f
    f = e
    e = d
    d = c
    c = b
    b = a
    a = t
  end
  put g_sha_s 0 add get g_sha_s 0 a
  put g_sha_s 1 add get g_sha_s 1 b
  put g_sha_s 2 add get g_sha_s 2 c
  put g_sha_s 3 add get g_sha_s 3 d
  put g_sha_s 4 add get g_sha_s 4 e
  put g_sha_s 5 add get g_sha_s 5 f
  put g_sha_s 6 add get g_sha_s 6 g
  put g_sha_s 7 add get g_sha_s 7 h
end

fn sha256_hash n ulong to void
  put g_sha_s 0 0x6a09e667
  put g_sha_s 1 0xbb67ae85
  put g_sha_s 2 0x3c6ef372
  put g_sha_s 3 0xa54ff53a
  put g_sha_s 4 0x510e527f
  put g_sha_s 5 0x9b05688c
  put g_sha_s 6 0x1f83d9ab
  put g_sha_s 7 0x5be0cd19
  nb = shr n 6
  for b ulong nb bound 32
    sha_sched_in shl b 6
    sha_rounds
  end
  remn = and n 63
  base = shl nb 6
  for i ulong 128
    put g_sha_pad i uchar 0
  end
  for i ulong remn bound 64
    put g_sha_pad i get g_sha_in add base i
  end
  put g_sha_pad remn uchar 0x80
  tot = ulong 64
  if ge remn 56
    tot = 128
  end
  bits = shl n 3
  for i ulong 8
    put g_sha_pad sub tot add i 1 uchar and shr bits mul i 8 0xff
  end
  sha_sched_pad 0
  sha_rounds
  if eq tot 128
    sha_sched_pad 64
    sha_rounds
  end
  for i ulong 8
    w = get g_sha_s i
    put g_sha_out mul i 4 uchar and shr w 24 0xff
    put g_sha_out add mul i 4 1 uchar and shr w 16 0xff
    put g_sha_out add mul i 4 2 uchar and shr w 8 0xff
    put g_sha_out add mul i 4 3 uchar and w 0xff
  end
end

note ---- Canonical OMG0 encoders ----
fn enc_u16be pos ulong v ulong to ulong
  put g_enc pos uchar and shr v 8 0xff
  put g_enc add pos 1 uchar and v 0xff
  ret add pos 2
end

fn enc_u32be pos ulong v ulong to ulong
  put g_enc pos uchar and shr v 24 0xff
  put g_enc add pos 1 uchar and shr v 16 0xff
  put g_enc add pos 2 uchar and shr v 8 0xff
  put g_enc add pos 3 uchar and v 0xff
  ret add pos 4
end

fn enc_u16le pos ulong v ulong to ulong
  put g_enc pos uchar and v 0xff
  put g_enc add pos 1 uchar and shr v 8 0xff
  ret add pos 2
end

fn enc_u32le pos ulong v ulong to ulong
  put g_enc pos uchar and v 0xff
  put g_enc add pos 1 uchar and shr v 8 0xff
  put g_enc add pos 2 uchar and shr v 16 0xff
  put g_enc add pos 3 uchar and shr v 24 0xff
  ret add pos 4
end

fn enc_hdr kind ulong to ulong
  put g_enc 0 uchar 0x4f
  put g_enc 1 uchar 0x4d
  put g_enc 2 uchar 0x47
  put g_enc 3 uchar 0x30
  put g_enc 4 uchar 1
  put g_enc 5 uchar and kind 0xff
  ret 6
end

fn hash_enc n ulong to void
  for i ulong n bound 512
    put g_sha_in i get g_enc i
  end
  sha256_hash n
end

fn hash_type_uint w ulong to void
  p = enc_hdr 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 44
  for i ulong 44
    put g_enc add p i uchar 0
  end
  u = enc_u32le p 3
  u = enc_u16le add p 4 w
  hash_enc 60
end

fn hash_param0_for_tid to void
  p = enc_hdr 1
  p = enc_u16be p 1
  put g_enc p uchar 11
  p = add p 1
  for i ulong 11
    put g_enc add p i get t_omega_param i
  end
  p = add p 11
  p = enc_u16be p 2
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_tid_in i
  end
  hash_enc add p 98
end

fn hash_val_uint_cur w ulong val ulong to void
  p = enc_hdr 1
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 98
  for i ulong 98
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_tid_in i
  end
  nb = div add w 7 8
  p = enc_u16le add p 32 nb
  for i ulong nb bound 8
    sh = mul sub sub nb 1 i 8
    b = uchar and shr val sh 0xff
    put g_enc add p i b
  end
  hash_enc 114
  for i ulong 32
    put g_cid i get g_sha_out i
  end
end

fn hash_op_cur opc ulong to void
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 204
  for i ulong 204
    put g_enc add p i uchar 0
  end
  u = enc_u32le p opc
  u = enc_u32le add p 4 1
  for i ulong 32
    b = get g_tid_in i
    put g_enc add add p 8 i b
    put g_enc add add p 41 i b
    put g_enc add add p 73 i b
    put g_enc add add p 169 i b
  end
  put g_enc add p 40 uchar 2
  hash_enc 220
  for i ulong 32
    put g_oid i get g_sha_out i
  end
end

fn hash_apply_cur to void
  p = enc_hdr 3
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u32be p 161
  for i ulong 161
    put g_enc add p i uchar 0
  end
  for i ulong 32
    put g_enc add p i get g_oid i
    put g_enc add add p 33 i get g_cur i
    put g_enc add add p 65 i get g_cid i
  end
  put g_enc add p 32 uchar 2
  hash_enc 177
  for i ulong 32
    put g_cur i get g_sha_out i
  end
end

fn hash_constraint_txt kind ulong s view uchar * to void
  n = len s
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p kind
  p = enc_u16be p n
  for i ulong n bound 64
    put g_enc add p i get s i
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

fn hash_constraint_buf kind ulong is_ens bool to void
  n = get g_req_len 0
  if is_ens
    n = get g_ens_len 0
  end
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p kind
  p = enc_u16be p n
  for i ulong n bound 64
    if is_ens
      put g_enc add p i get g_ens_buf i
    else
      put g_enc add p i get g_req_buf i
    end
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

fn hash_constraint_tmp_post to void
  n = get g_tmp_plen 0
  p = enc_hdr 5
  p = enc_u16be p 0
  p = enc_u16be p 0
  p = enc_u16be p 1
  p = enc_u16be p 8
  p = enc_u16be p n
  for i ulong n bound 64
    put g_enc add p i get g_tmp_post i
  end
  p = add p n
  p = enc_u32be p 0
  hash_enc p
end

fn init_caches to void
  sha_kinit
  hash_type_uint 32
  for i ulong 32
    put g_tid32 i get g_sha_out i
    put g_tid_in i get g_sha_out i
  end
  hash_param0_for_tid
  for i ulong 32
    put g_param32 i get g_sha_out i
  end
  hash_type_uint 64
  for i ulong 32
    put g_tid64 i get g_sha_out i
    put g_tid_in i get g_sha_out i
  end
  hash_param0_for_tid
  for i ulong 32
    put g_param64 i get g_sha_out i
  end
  hash_constraint_txt 7 t_pre_xge0
  for i ulong 32
    put g_pre_cache i get g_sha_out i
  end
  hash_constraint_txt 7 t_pre_true
  for i ulong 32
    put g_pre_cache add 32 i get g_sha_out i
  end
  hash_constraint_txt 7 t_pre_xlt10
  for i ulong 32
    put g_pre_cache add 64 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_true
  for i ulong 32
    put g_post_cache i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge1
  for i ulong 32
    put g_post_cache add 32 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_reqx
  for i ulong 32
    put g_post_cache add 64 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge0
  for i ulong 32
    put g_post7_cache i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge1
  for i ulong 32
    put g_post7_cache add 32 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge2
  for i ulong 32
    put g_post7_cache add 64 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge3
  for i ulong 32
    put g_post7_cache add 96 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge4
  for i ulong 32
    put g_post7_cache add 128 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge5
  for i ulong 32
    put g_post7_cache add 160 i get g_sha_out i
  end
  hash_constraint_txt 8 t_post_rge6
  for i ulong 32
    put g_post7_cache add 192 i get g_sha_out i
  end
end

note ---- Program Pool Operations ----
fn load_tid_in w ulong to void
  if eq w 32
    for i ulong 32
      put g_tid_in i get g_tid32 i
      put g_cur i get g_param32 i
    end
  else
    for i ulong 32
      put g_tid_in i get g_tid64 i
      put g_cur i get g_param64 i
    end
  end
end

fn load_tid_out w ulong to void
  if eq w 32
    for i ulong 32
      put g_tid_out i get g_tid32 i
    end
  else
    for i ulong 32
      put g_tid_out i get g_tid64 i
    end
  end
end

fn prog_init s ulong to void
  put g_p_has s 0
  put g_p_scnt s 0
  put g_p_inw s 64
  put g_p_outw s 64
  put g_p_lcnt s 0
  put g_p_clen s 0
  put g_p_insn s 0
  put g_p_lat s 0
  put g_p_ver s 0
  ib = mul s 32
  for i ulong 32
    put g_p_id add ib i uchar 0
    put g_p_preid add ib i uchar 0
    put g_p_postid add ib i uchar 0
  end
end

fn prog_copy_ids dst ulong src ulong to void
  ib = mul src 32
  idb = mul dst 32
  for i ulong 32
    put g_p_id add idb i get g_p_id add ib i
    put g_p_preid add idb i get g_p_preid add ib i
    put g_p_postid add idb i get g_p_postid add ib i
  end
end

fn prog_copy_leaves dst ulong src ulong to void
  n = mul get g_p_lcnt src 32
  lb = mul src 2048
  ldb = mul dst 2048
  for i ulong n bound 2048
    put g_p_leaves add ldb i get g_p_leaves add lb i
  end
end

fn prog_copy_code dst ulong src ulong to void
  cl = get g_p_clen src
  cb = mul src 1024
  cdb = mul dst 1024
  for i ulong cl bound 1024
    put g_p_code add cdb i get g_p_code add cb i
  end
end

fn prog_copy dst ulong src ulong to void
  put g_p_has dst get g_p_has src
  sc = get g_p_scnt src
  put g_p_scnt dst sc
  put g_p_inw dst get g_p_inw src
  put g_p_outw dst get g_p_outw src
  put g_p_lcnt dst get g_p_lcnt src
  put g_p_clen dst get g_p_clen src
  put g_p_insn dst get g_p_insn src
  put g_p_lat dst get g_p_lat src
  put g_p_ver dst get g_p_ver src
  sb = mul src 64
  db = mul dst 64
  for i ulong sc bound 64
    put g_p_sop add db i get g_p_sop add sb i
    put g_p_simm add db i get g_p_simm add sb i
  end
  prog_copy_ids dst src
  prog_copy_leaves dst src
  prog_copy_code dst src
end

fn prog_id_eq a ulong b ulong to bool
  ab = mul a 32
  bb = mul b 32
  for i ulong 32
    if ne get g_p_id add ab i get g_p_id add bb i
      ret false
    end
  end
  ret true
end

fn prog_id_zero s ulong to bool
  sb = mul s 32
  for i ulong 32
    if ne ulong get g_p_id add sb i 0
      ret false
    end
  end
  ret true
end

fn prog_body_root s ulong to long
  if eq get g_p_has s 0
    ret -1
  end
  sc = get g_p_scnt s
  if gt sc 64
    ret -1
  end
  w = get g_p_inw s
  load_tid_in w
  sb = mul s 64
  for i ulong sc bound 64
    hash_val_uint_cur w get g_p_simm add sb i
    hash_op_cur get g_p_sop add sb i
    hash_apply_cur
  end
  ret 0
end

fn prog_compute_id s ulong to long
  ib = mul s 32
  for i ulong 32
    put g_p_id add ib i uchar 0
  end
  if lt prog_body_root s 0
    ret -1
  end
  load_tid_out get g_p_outw s
  for i ulong 16
    put g_sha_in i get t_prog_dom i
  end
  put g_sha_in 16 uchar 0
  for i ulong 32
    put g_sha_in add 17 i get g_cur i
    put g_sha_in add 49 i get g_tid_in i
    put g_sha_in add 81 i get g_tid_out i
    put g_sha_in add 113 i get g_p_preid add ib i
    put g_sha_in add 145 i get g_p_postid add ib i
  end
  sha256_hash 177
  for i ulong 32
    put g_p_id add ib i get g_sha_out i
  end
  ret 0
end

fn prog_put_insn s ulong w ulong to void
  cl = get g_p_clen s
  cb = add mul s 1024 cl
  put g_p_code cb uchar and w 0xff
  put g_p_code add cb 1 uchar and shr w 8 0xff
  put g_p_code add cb 2 uchar and shr w 16 0xff
  put g_p_code add cb 3 uchar and shr w 24 0xff
  put g_p_clen s add cl 4
end

fn prog_emit_body s ulong to long
  if eq get g_p_has s 0
    ret -1
  end
  put g_p_clen s 0
  sc = get g_p_scnt s
  sb = mul s 64
  for i ulong sc bound 64
    imm = get g_p_simm add sb i
    op = get g_p_sop add sb i
    lo = and imm 0xffff
    hi = and shr imm 16 0xffff
    prog_put_insn s or 0xd2800001 shl lo 5
    if ne hi 0
      prog_put_insn s or 0xf2a00001 shl hi 5
    end
    if eq op 3
      prog_put_insn s 0x8b010000
    else
      if eq op 4
        prog_put_insn s 0xcb010000
      else
        if eq op 5
          prog_put_insn s 0x9b017c00
        else
          if eq op 9
            prog_put_insn s 0x8a010000
          else
            prog_put_insn s 0xaa010000
          end
        end
      end
    end
  end
  prog_put_insn s 0xd65f03c0
  ret 0
end

fn tmp_put_insn w ulong to void
  cl = get g_code_tlen 0
  put g_code_tmp cl uchar and w 0xff
  put g_code_tmp add cl 1 uchar and shr w 8 0xff
  put g_code_tmp add cl 2 uchar and shr w 16 0xff
  put g_code_tmp add cl 3 uchar and shr w 24 0xff
  put g_code_tlen 0 add cl 4
end

fn emit_lift_to_tmp to void
  put g_code_tlen 0 0
  sc = get g_lift_cnt 0
  for i ulong sc bound 64
    imm = get g_lift_imm i
    op = get g_lift_op i
    lo = and imm 0xffff
    hi = and shr imm 16 0xffff
    tmp_put_insn or 0xd2800001 shl lo 5
    if ne hi 0
      tmp_put_insn or 0xf2a00001 shl hi 5
    end
    if eq op 3
      tmp_put_insn 0x8b010000
    else
      if eq op 4
        tmp_put_insn 0xcb010000
      else
        if eq op 5
          tmp_put_insn 0x9b017c00
        else
          if eq op 9
            tmp_put_insn 0x8a010000
          else
            tmp_put_insn 0xaa010000
          end
        end
      end
    end
  end
  tmp_put_insn 0xd65f03c0
end

fn read_u32le_code s ulong off ulong to ulong
  cb = add mul s 1024 off
  b0 = ulong get g_p_code cb
  b1 = ulong get g_p_code add cb 1
  b2 = ulong get g_p_code add cb 2
  b3 = ulong get g_p_code add cb 3
  ret or or b0 shl b1 8 or shl b2 16 shl b3 24
end

fn decode_alu_op w ulong to ulong
  if eq w 0x8b010000
    ret 3
  end
  if eq w 0xcb010000
    ret 4
  end
  if eq w 0x9b017c00
    ret 5
  end
  if eq w 0x8a010000
    ret 9
  end
  if eq w 0xaa010000
    ret 10
  end
  ret 0
end

fn lift_body_slice s ulong off ulong clen ulong to long
  if or lt clen 4 ne rem clen 4 0
    ret -1
  end
  n = div clen 4
  i = ulong 0
  sc = ulong 0
  while lt add i 1 n bound 256
    w = read_u32le_code s add off mul i 4
    if ne and w 0xffe0001f 0xd2800001
      ret -1
    end
    imm = and shr w 5 0xffff
    i = add i 1
    if lt i n
      w2 = read_u32le_code s add off mul i 4
      if eq and w2 0xffe0001f 0xf2a00001
        imm = or imm shl and shr w2 5 0xffff 16
        i = add i 1
      end
    end
    if ge i n
      ret -1
    end
    op = decode_alu_op read_u32le_code s add off mul i 4
    if eq op 0
      ret -1
    end
    i = add i 1
    if ge sc 64
      ret -1
    end
    put g_lift_op sc op
    put g_lift_imm sc imm
    sc = add sc 1
  end
  if ne read_u32le_code s add off mul sub n 1 4 0xd65f03c0
    ret -1
  end
  put g_lift_cnt 0 sc
  emit_lift_to_tmp
  if ne get g_code_tlen 0 clen
    ret -1
  end
  cb = add mul s 1024 off
  for k ulong clen bound 1024
    if ne get g_code_tmp k get g_p_code add cb k
      ret -1
    end
  end
  ret 0
end

fn format_unary_post op ulong imm ulong to void
  put g_tmp_post 0 uchar 120
  put g_tmp_post 1 uchar 32
  ch = uchar 43
  if eq op 4
    ch = uchar 45
  end
  if eq op 5
    ch = uchar 42
  end
  if eq op 9
    ch = uchar 38
  end
  if eq op 10
    ch = uchar 124
  end
  put g_tmp_post 2 ch
  put g_tmp_post 3 uchar 32
  pos = ulong 4
  if eq imm 0
    put g_tmp_post pos uchar 48
    pos = add pos 1
  else
    x = imm
    cnt = ulong 0
    while gt x 0 bound 24
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    k = cnt
    while gt k 0 bound 24
      k = sub k 1
      put g_tmp_post pos get g_numbuf k
      pos = add pos 1
    end
  end
  put g_tmp_plen 0 pos
end

fn prog_build_unary s ulong op ulong imm ulong to long
  if gt imm 0xffffffff
    ret -1
  end
  prog_init s
  put g_p_has s 1
  put g_p_scnt s 1
  sb = mul s 64
  put g_p_sop sb op
  put g_p_simm sb imm
  ib = mul s 32
  for i ulong 32
    put g_p_preid add ib i get g_pre_cache i
  end
  format_unary_post op imm
  hash_constraint_tmp_post
  for i ulong 32
    put g_p_postid add ib i get g_sha_out i
  end
  if lt prog_compute_id s 0
    ret -1
  end
  if lt prog_emit_body s 0
    ret -1
  end
  put g_p_insn s div get g_p_clen s 4
  if eq op 5
    put g_p_lat s 3
  else
    put g_p_lat s 2
  end
  ret 0
end

fn prog_set_contract s ulong pre view uchar * post view uchar * to void
  put g_p_lcnt s 0
  ib = mul s 32
  hash_constraint_txt 7 pre
  for i ulong 32
    put g_p_preid add ib i get g_sha_out i
  end
  hash_constraint_txt 8 post
  for i ulong 32
    put g_p_postid add ib i get g_sha_out i
  end
  rc = prog_compute_id s
end

note Fold n leaves in g_p_leaves[s] into g_tmp_id
fn fold_post_seq_slot s ulong n ulong to void
  lb = mul s 2048
  last = add lb mul sub n 1 32
  for i ulong 32
    put g_tmp_id i get g_p_leaves add last i
  end
  idx = sub n 1
  while gt idx 0 bound 64
    idx = sub idx 1
    p = enc_hdr 5
    p = enc_u16be p 1
    put g_enc p uchar 13
    p = add p 1
    for k ulong 13
      put g_enc add p k get t_omega_compose k
    end
    p = add p 13
    p = enc_u16be p 3
    for k ulong 3
      put g_enc add p k get t_seq k
    end
    p = add p 3
    p = enc_u16be p 0
    p = enc_u16be p 1
    p = enc_u16be p 8
    p = enc_u16be p 64
    cur = add lb mul idx 32
    for k ulong 32
      put g_enc add p k get g_p_leaves add cur k
      put g_enc add add p 32 k get g_tmp_id k
    end
    p = add p 64
    p = enc_u32be p 0
    hash_enc p
    for k ulong 32
      put g_tmp_id k get g_sha_out k
    end
  end
end

fn post_leaves_into_la s ulong to ulong
  lc = get g_p_lcnt s
  if and ge lc 2 le lc 64
    fold_post_seq_slot s lc
    ib = mul s 32
    same = true
    for i ulong 32
      if ne get g_tmp_id i get g_p_postid add ib i
        same = false
        break
      end
    end
    if same
      lb = mul s 2048
      for i ulong mul lc 32 bound 2048
        put g_la_id i get g_p_leaves add lb i
      end
      ret lc
    end
  end
  ib = mul s 32
  for i ulong 32
    put g_la_id i get g_p_postid add ib i
  end
  ret 1
end

fn post_leaves_into_lb s ulong to ulong
  lc = get g_p_lcnt s
  if and ge lc 2 le lc 64
    fold_post_seq_slot s lc
    ib = mul s 32
    same = true
    for i ulong 32
      if ne get g_tmp_id i get g_p_postid add ib i
        same = false
        break
      end
    end
    if same
      lb = mul s 2048
      for i ulong mul lc 32 bound 2048
        put g_lb_id i get g_p_leaves add lb i
      end
      ret lc
    end
  end
  ib = mul s 32
  for i ulong 32
    put g_lb_id i get g_p_postid add ib i
  end
  ret 1
end

fn prog_compose_leaves_copy dst ulong na ulong nb ulong to void
  dlb = mul dst 2048
  n1 = mul na 32
  for i ulong n1 bound 2048
    put g_p_leaves add dlb i get g_la_id i
  end
  dlb2 = add dlb n1
  n2 = mul nb 32
  for i ulong n2 bound 2048
    put g_p_leaves add dlb2 i get g_lb_id i
  end
end

fn prog_compose_leaves a ulong dst ulong na ulong nb ulong to void
  aib = mul a 32
  dib = mul dst 32
  for i ulong 32
    put g_p_preid add dib i get g_p_preid add aib i
  end
  prog_compose_leaves_copy dst na nb
  put g_p_lcnt dst add na nb
  fold_post_seq_slot dst add na nb
  for i ulong 32
    put g_p_postid add dib i get g_tmp_id i
  end
end

fn prog_compose_steps a ulong b ulong dst ulong to void
  sa = get g_p_scnt a
  sb = get g_p_scnt b
  put g_p_has dst 1
  put g_p_scnt dst add sa sb
  asb = mul a 64
  bsb = mul b 64
  dsb = mul dst 64
  for i ulong sa bound 64
    put g_p_sop add dsb i get g_p_sop add asb i
    put g_p_simm add dsb i get g_p_simm add asb i
  end
  for i ulong sb bound 64
    put g_p_sop add add dsb sa i get g_p_sop add bsb i
    put g_p_simm add add dsb sa i get g_p_simm add bsb i
  end
end

fn prog_compose a ulong b ulong dst ulong to long
  if ne get g_p_outw a get g_p_inw b
    ret -1
  end
  na = post_leaves_into_la a
  nb = post_leaves_into_lb b
  if gt add na nb 64
    ret -1
  end
  if gt add get g_p_scnt a get g_p_scnt b 64
    ret -1
  end
  prog_init dst
  put g_p_inw dst get g_p_inw a
  put g_p_outw dst get g_p_outw b
  prog_compose_leaves a dst na nb
  prog_compose_steps a b dst
  ic = add get g_p_insn a get g_p_insn b
  if gt ic 0
    ic = sub ic 1
  end
  put g_p_insn dst ic
  put g_p_lat dst add get g_p_lat a get g_p_lat b
  u = prog_compute_id dst
  u = prog_emit_body dst
  ret 0
end

note ---- Mini Visor fn Lexer/Parser/Lowerer (for fn lines in test_program_id) ----
fn is_id_ch c ulong to bool
  if and ge c 97 le c 122
    ret true
  end
  if and ge c 65 le c 90
    ret true
  end
  if and ge c 48 le c 57
    ret true
  end
  ret eq c 95
end

fn dval c ulong to ulong
  if and ge c 48 le c 57
    ret sub c 48
  end
  if and ge c 97 le c 102
    ret add sub c 97 10
  end
  if and ge c 65 le c 70
    ret add sub c 65 10
  end
  ret 99
end

fn mtok_eq ti ulong s view uchar * to bool
  if ne get g_tslen ti len s
    ret false
  end
  b = mul ti 64
  for i ulong len s bound 64
    if ne get g_tstr add b i get s i
      ret false
    end
  end
  ret true
end

fn mlex_int start ulong slen ulong k ulong to ulong
  i = start
  base = ulong 10
  if lt add i 1 slen
    c0 = ulong get g_line i
    c1 = ulong get g_line add i 1
    if and eq c0 48 eq c1 120
      base = 16
      i = add i 2
    else
      if and eq c0 48 eq c1 98
        base = 2
        i = add i 2
      end
    end
  end
  v = ulong 0
  while lt i slen bound 64
    d = dval ulong get g_line i
    if ge d base
      break
    end
    v = add mul v base d
    i = add i 1
  end
  put g_tkind k 2
  put g_tval k v
  ret i
end

fn mlex_ident start ulong slen ulong k ulong to ulong
  j = start
  while lt j slen bound 64
    if not is_id_ch ulong get g_line j
      break
    end
    j = add j 1
  end
  nl = sub j start
  tb = mul k 64
  for m ulong nl bound 64
    put g_tstr add tb m get g_line add start m
  end
  put g_tslen k nl
  tk = ulong 1
  if mtok_eq k t_kw_fn
    tk = 4
  end
  if mtok_eq k t_kw_req
    tk = 5
  end
  if mtok_eq k t_kw_ens
    tk = 6
  end
  if mtok_eq k t_kw_true
    tk = 7
  end
  if mtok_eq k t_kw_false
    tk = 8
  end
  put g_tkind k tk
  ret j
end

fn mlex_line s view uchar * to void
  slen = len s
  for i ulong slen bound 256
    put g_line i get s i
  end
  put g_llen 0 slen
  i = ulong 0
  k = ulong 0
  while lt i slen bound 256
    c = ulong get g_line i
    if or eq c 32 eq c 9
      i = add i 1
      continue
    end
    c2 = ulong 0
    if lt add i 1 slen
      c2 = ulong get g_line add i 1
    end
    if and eq c 47 eq c2 42
      i = add i 2
      while lt add i 1 slen bound 256
        if eq ulong get g_line i 42
          if eq ulong get g_line add i 1 47
            i = add i 2
            break
          end
        end
        i = add i 1
      end
      continue
    end
    if and ge c 48 le c 57
      i = mlex_int i slen k
      k = add k 1
      continue
    end
    if is_id_ch c
      i = mlex_ident i slen k
      k = add k 1
      continue
    end
    if and eq c 45 eq c2 62
      put g_tkind k 15
      i = add i 2
      k = add k 1
      continue
    end
    if and eq c 62 eq c2 61
      put g_tkind k 28
      i = add i 2
      k = add k 1
      continue
    end
    if and eq c 60 eq c2 61
      put g_tkind k 26
      i = add i 2
      k = add k 1
      continue
    end
    if and eq c 61 eq c2 61
      put g_tkind k 23
      i = add i 2
      k = add k 1
      continue
    end
    tk = ulong 0
    if eq c 40
      tk = 9
    end
    if eq c 41
      tk = 10
    end
    if eq c 123
      tk = 11
    end
    if eq c 125
      tk = 12
    end
    if eq c 58
      tk = 13
    end
    if eq c 43
      tk = 17
    end
    if eq c 45
      tk = 18
    end
    if eq c 42
      tk = 19
    end
    if eq c 38
      tk = 21
    end
    if eq c 124
      tk = 22
    end
    if eq c 60
      tk = 25
    end
    if eq c 62
      tk = 27
    end
    put g_tkind k tk
    i = add i 1
    k = add k 1
  end
  put g_tkind k 0
  put g_tcnt 0 add k 1
end

fn mp_peek to ulong
  ret get g_ppos 0
end

fn mp_next to ulong
  p = get g_ppos 0
  put g_ppos 0 add p 1
  ret p
end

fn mp_alloc kind ulong to long
  n = get g_ancnt 0
  put g_ancnt 0 add n 1
  put g_akind n kind
  put g_aop n 0
  put g_alhs n -1
  put g_arhs n -1
  put g_aval n 0
  put g_aslen n 0
  ret long n
end

fn mp_primary to long
  ti = mp_peek
  tk = get g_tkind ti
  if eq tk 2
    u = mp_next
    ni = mp_alloc 1
    put g_aval ulong ni get g_tval ti
    ret ni
  end
  if eq tk 1
    u = mp_next
    ni = mp_alloc 3
    ret ni
  end
  if eq tk 9
    u = mp_next
    r = mp_or
    u = mp_next
    ret r
  end
  ret -1
end

fn mp_mul to long
  lhs = mp_primary
  while eq get g_tkind mp_peek 19 bound 32
    u = mp_next
    rhs = mp_primary
    ni = mp_alloc 4
    put g_aop ulong ni 5
    put g_alhs ulong ni lhs
    put g_arhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn mp_add to long
  lhs = mp_mul
  while or eq get g_tkind mp_peek 17 eq get g_tkind mp_peek 18 bound 32
    ti = mp_next
    op = ulong 3
    if eq get g_tkind ti 18
      op = 4
    end
    rhs = mp_mul
    ni = mp_alloc 4
    put g_aop ulong ni op
    put g_alhs ulong ni lhs
    put g_arhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn mp_and to long
  lhs = mp_add
  while eq get g_tkind mp_peek 21 bound 32
    u = mp_next
    rhs = mp_add
    ni = mp_alloc 4
    put g_aop ulong ni 9
    put g_alhs ulong ni lhs
    put g_arhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn mp_or to long
  lhs = mp_and
  while eq get g_tkind mp_peek 22 bound 32
    u = mp_next
    rhs = mp_and
    ni = mp_alloc 4
    put g_aop ulong ni 10
    put g_alhs ulong ni lhs
    put g_arhs ulong ni rhs
    lhs = ni
  end
  ret lhs
end

fn mcl_append is_ens bool s view uchar * to void
  if is_ens
    cur = get g_ens_len 0
    if gt cur 0
      put g_ens_buf cur uchar 32
      cur = add cur 1
    end
    for i ulong len s bound 64
      put g_ens_buf add cur i get s i
    end
    put g_ens_len 0 add cur len s
    ret
  end
  cur = get g_req_len 0
  if gt cur 0
    put g_req_buf cur uchar 32
    cur = add cur 1
  end
  for i ulong len s bound 64
    put g_req_buf add cur i get s i
  end
  put g_req_len 0 add cur len s
end

fn mcl_append_u64 is_ens bool v ulong to void
  cnt = ulong 0
  if eq v 0
    put g_numbuf 0 uchar 48
    cnt = 1
  else
    x = v
    while gt x 0 bound 24
      put g_numbuf cnt uchar add rem x 10 48
      cnt = add cnt 1
      x = div x 10
    end
    i = ulong 0
    j = sub cnt 1
    while lt i j bound 24
      a = get g_numbuf i
      b = get g_numbuf j
      put g_numbuf i b
      put g_numbuf j a
      i = add i 1
      j = sub j 1
    end
  end
  if is_ens
    cur = get g_ens_len 0
    if gt cur 0
      put g_ens_buf cur uchar 32
      cur = add cur 1
    end
    for i ulong cnt bound 24
      put g_ens_buf add cur i get g_numbuf i
    end
    put g_ens_len 0 add cur cnt
    ret
  end
  cur = get g_req_len 0
  if gt cur 0
    put g_req_buf cur uchar 32
    cur = add cur 1
  end
  for i ulong cnt bound 24
    put g_req_buf add cur i get g_numbuf i
  end
  put g_req_len 0 add cur cnt
end

fn mparse_clause is_ens bool to void
  if is_ens
    put g_ens_len 0 0
  else
    put g_req_len 0 0
  end
  while true bound 32
    ti = mp_peek
    tk = get g_tkind ti
    if or or eq tk 0 eq tk 11 eq tk 6
      break
    end
    if eq tk 7
      mcl_append is_ens t_kw_true
    else
      if eq tk 2
        mcl_append_u64 is_ens get g_tval ti
      else
        if eq tk 1
          if mtok_eq ti t_res_result
            mcl_append is_ens t_res_result
          else
            mcl_append is_ens t_x
          end
        else
          if eq tk 28
            mcl_append is_ens t_tok_ge
          end
          if eq tk 23
            mcl_append is_ens t_tok_eq
          end
          if eq tk 25
            mcl_append is_ens t_tok_lt
          end
          if eq tk 18
            mcl_append is_ens t_tok_sub
          end
        end
      end
    end
    u = mp_next
  end
end

fn lower_fn_body root ulong slot ulong to void
  r_ops = new ulong 32 0
  r_imms = new ulong 32 0
  sc = ulong 0
  idx = root
  while eq get g_akind idx 4 bound 32
    op = get g_aop idx
    li = ulong get g_alhs idx
    ri = ulong get g_arhs idx
    if eq get g_akind ri 1
      put r_ops sc op
      put r_imms sc get g_aval ri
      idx = li
    else
      put r_ops sc op
      put r_imms sc get g_aval li
      idx = ri
    end
    sc = add sc 1
  end
  prog_init slot
  put g_p_has slot 1
  put g_p_scnt slot sc
  sb = mul slot 64
  for i ulong sc bound 32
    put g_p_sop add sb i get r_ops sub sub sc 1 i
    put g_p_simm add sb i get r_imms sub sub sc 1 i
  end
end

fn lower_fn_to_slot s view uchar * slot ulong to long
  mlex_line s
  put g_ppos 0 0
  put g_ancnt 0 0
  u = mp_next
  nm = mp_next
  put g_aname0 0 ulong get g_tstr mul nm 64
  u = mp_next
  u = mp_next
  u = mp_next
  u = mp_next
  u = mp_next
  u = mp_next
  u = mp_next
  for i ulong 4
    put g_req_buf i get t_kw_true i
    put g_ens_buf i get t_kw_true i
  end
  put g_req_len 0 4
  put g_ens_len 0 4
  if eq get g_tkind mp_peek 5
    u = mp_next
    mparse_clause false
  end
  if eq get g_tkind mp_peek 6
    u = mp_next
    mparse_clause true
  end
  u = mp_next
  root = mp_or
  lower_fn_body ulong root slot
  ib = mul slot 32
  hash_constraint_buf 7 false
  for i ulong 32
    put g_p_preid add ib i get g_sha_out i
  end
  hash_constraint_buf 8 true
  for i ulong 32
    put g_p_postid add ib i get g_sha_out i
  end
  rc = prog_compute_id slot
  rc = prog_emit_body slot
  put g_p_insn slot div get g_p_clen slot 4
  ret 0
end

note ---- Gate 0: BODY_BOUND ----
fn test_body_bound to void
  chk 0 and eq prog_build_unary 0 3 1 0 eq prog_build_unary 1 3 2 0
  chk 0 not prog_id_eq 0 1
  prog_set_contract 0 t_pre_true t_post_true
  prog_set_contract 1 t_pre_true t_post_true
  chk 0 not prog_id_eq 0 1
  chk 0 eq prog_build_unary 2 4 1 0
  prog_set_contract 2 t_pre_true t_post_true
  chk 0 not prog_id_eq 0 2
  chk 0 and eq get g_p_insn 0 get g_p_insn 2 eq get g_p_lat 0 get g_p_lat 2
  chk 0 and eq lower_fn_to_slot s_fn_f1 0 0 eq lower_fn_to_slot s_fn_f2 1 0
  chk 0 not prog_id_eq 0 1
  chk 0 and eq lower_fn_to_slot s_fn_t21 0 0 eq lower_fn_to_slot s_fn_t31 1 0
  chk 0 not prog_id_eq 0 1
  u = prog_build_unary 4 5 2
  u = prog_build_unary 5 3 1
  chk 0 eq prog_compose 4 5 0 0
  u = prog_build_unary 4 3 1
  u = prog_build_unary 5 5 2
  chk 0 eq prog_compose 4 5 1 0
  prog_set_contract 0 t_pre_xge0 t_post_same
  prog_set_contract 1 t_pre_xge0 t_post_same
  chk 0 not prog_id_eq 0 1
  u = prog_body_root 0
  for i ulong 32
    put g_tmp_id i get g_cur i
  end
  u = prog_body_root 1
  diff = false
  for i ulong 32
    if ne get g_tmp_id i get g_cur i
      diff = true
    end
  end
  chk 0 diff
  prog_init 3
  ib = ulong 96
  for i ulong 32
    put g_p_id add ib i uchar 0xab
  end
  chk 0 and eq prog_compute_id 3 -1 prog_id_zero 3
  chk 0 ne prog_build_unary 3 3 0x100000000 0
  chk 0 eq prog_build_unary 3 3 0xffffffff 0
  note v1 recipe vs v2 id
  u = prog_build_unary 0 3 1
  put g_sha_in 0 uchar 80
  put g_sha_in 1 uchar 82
  put g_sha_in 2 uchar 79
  put g_sha_in 3 uchar 71
  put g_sha_in 4 uchar 1
  put g_sha_in 5 uchar 102
  put g_sha_in 6 uchar 3
  put g_sha_in 7 uchar 64
  put g_sha_in 8 uchar 3
  put g_sha_in 9 uchar 64
  for i ulong 32
    put g_sha_in add 10 i get g_p_preid i
    put g_sha_in add 42 i get g_p_postid i
  end
  put g_sha_in 74 uchar and get g_p_insn 0 0xff
  put g_sha_in 75 uchar and get g_p_lat 0 0xff
  sha256_hash 76
  v1diff = false
  for i ulong 32
    if ne get g_sha_out i get g_p_id i
      v1diff = true
    end
  end
  chk 0 v1diff
  chk 0 eq len t_prog_dom 16
end

note ---- Gate 1: REPRESENTATION_INVARIANT + Associativity ----
fn brng_next to ulong
  x = get g_brng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_brng 0 x
  ret mul x 0x2545f4914f6cdd1d
end

fn rng_next to ulong
  x = get g_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_rng 0 x
  ret mul x 0x2545f4914f6cdd1d
end

fn op_from_idx k ulong to ulong
  if eq k 0
    ret 3
  end
  if eq k 1
    ret 4
  end
  if eq k 2
    ret 5
  end
  if eq k 3
    ret 9
  end
  ret 10
end

note Compose parts in slots [lo, hi) (lo..hi-1 in 0..7) into dst (using temp slots 16+depth*2)
fn compose_bracketed lo ulong hi ulong dst ulong depth ulong to long
  if eq sub hi lo 1
    prog_copy dst lo
    ret 0
  end
  span = sub sub hi lo 1
  sp = add add lo 1 rem brng_next span
  ls = add 16 mul depth 2
  rs = add ls 1
  if lt compose_bracketed lo sp ls add depth 1 0
    ret -1
  end
  if lt compose_bracketed sp hi rs add depth 1 0
    ret -1
  end
  ret prog_compose ls rs dst
end

fn assoc_set_post7 slot ulong pi ulong to void
  put g_p_lcnt slot 0
  ib = mul slot 32
  pb = mul pi 32
  for k ulong 32
    put g_p_preid add ib k get g_pre_cache k
    put g_p_postid add ib k get g_post7_cache add pb k
  end
  rc = prog_compute_id slot
end

fn assoc_one_chain to ulong
  n = add 3 rem rng_next 6
  for i ulong n bound 8
    v = rng_next
    u = prog_build_unary i op_from_idx rem v 5 rem shr v 8 100
    if eq rem shr v 40 4 0
      assoc_set_post7 i rem shr v 48 7
    end
  end
  prog_copy 8 0
  for i ulong sub n 1 bound 8
    u = prog_compose 8 add i 1 9
    prog_copy 8 9
  end
  chk 1 eq get g_p_lcnt 8 n
  for b ulong 4
    rc = compose_bracketed 0 n 10 0
    ok = eq rc 0
    if not prog_id_eq 10 8
      ok = false
    end
    if ne get g_p_lcnt 10 n
      ok = false
    end
    chk 1 ok
  end
  if or ne get g_p_sop 0 get g_p_sop 64 ne get g_p_simm 0 get g_p_simm 64
    r1 = prog_compose 0 1 10
    r2 = prog_compose 1 0 11
    ok = and eq r1 0 eq r2 0
    if prog_id_eq 10 11
      ok = false
    end
    chk 1 ok
    ret 1
  end
  ret 0
end

fn test_assoc_stale to void
  prog_copy 10 8
  hash_constraint_txt 8 t_post_repl
  for i ulong 32
    put g_p_postid add 320 i get g_sha_out i
  end
  prog_copy 11 8
  prog_set_contract 11 t_pre_xge0 t_post_repl
  r1 = prog_compose 10 0 12
  r2 = prog_compose 11 0 13
  ok = and eq r1 0 eq r2 0
  if ne get g_p_lcnt 12 2
    ok = false
  end
  for i ulong 32
    if ne get g_p_postid add 384 i get g_p_postid add 416 i
      ok = false
    end
  end
  chk 1 ok
end

fn test_associativity to void
  put g_brng 0 0x243f6a8885a308d3
  put g_rng 0 0x5851f42d4c957f2d
  swaps = ulong 0
  for ch ulong 400
    swaps = add swaps assoc_one_chain
  end
  test_assoc_stale
  write_all t_assoc1 len t_assoc1
  print_u64 400
  write_all t_assoc2 len t_assoc2
  print_u64 1600
  write_all t_assoc3 len t_assoc3
  print_u64 swaps
  write_all t_assoc4 len t_assoc4
end

fn test_representation to void
  u = prog_build_unary 0 3 1
  u = prog_build_unary 1 3 1
  chk 1 prog_id_eq 0 1
  prog_copy 2 0
  u = prog_compute_id 2
  chk 1 prog_id_eq 0 2
  put g_p_insn 2 add get g_p_insn 2 7
  put g_p_lat 2 99
  put g_p_code 2048 xor get g_p_code 2048 uchar 0xff
  u = prog_compute_id 2
  chk 1 prog_id_eq 0 2
  chk 1 eq lower_fn_to_slot s_same_0 0 0
  chk 1 and eq lower_fn_to_slot s_same_1 1 0 prog_id_eq 0 1
  chk 1 and eq lower_fn_to_slot s_same_2 1 0 prog_id_eq 0 1
  chk 1 and eq lower_fn_to_slot s_same_3 1 0 prog_id_eq 0 1
  chk 1 and eq lower_fn_to_slot s_same_4 1 0 prog_id_eq 0 1
  chk 1 and eq lower_fn_to_slot s_same_5 1 0 prog_id_eq 0 1
  u = prog_build_unary 3 5 2
  u = prog_build_unary 4 3 1
  chk 1 eq prog_compose 3 4 2 0
  prog_set_contract 2 t_pre_true t_post_rge1
  chk 1 prog_id_eq 2 0
  test_associativity
  note Lift + re-emit roundtrip on ref (slot 0)
  u = lower_fn_to_slot s_same_0 0
  cl = get g_p_clen 0
  chk 1 eq lift_body_slice 0 0 cl 0
  chk 1 eq get g_lift_cnt 0 get g_p_scnt 0
  chk 1 and eq get g_lift_op 0 5 eq get g_lift_imm 0 2
  chk 1 and eq get g_lift_op 1 3 eq get g_lift_imm 1 1
  chk 1 ne lift_body_slice 0 4 sub cl 4 0
end

note ---- Gate 2: MUTATION_SEPARATION ----
fn diff_compute_id idx ulong to void
  w = get g_d_w idx
  sc = get g_d_scnt idx
  load_tid_in w
  sb = mul idx 8
  for i ulong sc bound 8
    hash_val_uint_cur w get g_d_imm add sb i
    hash_op_cur ulong get g_d_op add sb i
    hash_apply_cur
  end
  load_tid_out w
  for i ulong 16
    put g_sha_in i get t_prog_dom i
  end
  put g_sha_in 16 uchar 0
  pb = mul ulong get g_d_pre idx 32
  qb = mul ulong get g_d_post idx 32
  for i ulong 32
    put g_sha_in add 17 i get g_cur i
    put g_sha_in add 49 i get g_tid_in i
    put g_sha_in add 81 i get g_tid_out i
    put g_sha_in add 113 i get g_pre_cache add pb i
    put g_sha_in add 145 i get g_post_cache add qb i
  end
  sha256_hash 177
  ib = mul idx 32
  for i ulong 32
    put g_d_id add ib i get g_sha_out i
  end
end

fn diff_gen idx ulong to void
  n = add 1 rem rng_next 3
  put g_d_scnt idx n
  sb = mul idx 8
  for i ulong n bound 8
    put g_d_op add sb i uchar op_from_idx rem rng_next 5
    put g_d_imm add sb i rem rng_next 3
  end
  w = ulong 64
  if eq rem rng_next 4 0
    w = 32
  end
  put g_d_w idx w
  put g_d_pre idx uchar rem rng_next 3
  put g_d_post idx uchar rem rng_next 3
  u = rng_next
  diff_compute_id idx
end

fn diff_oracle_eq a ulong b ulong to bool
  sa = get g_d_scnt a
  if ne sa get g_d_scnt b
    ret false
  end
  if ne get g_d_w a get g_d_w b
    ret false
  end
  if ne get g_d_pre a get g_d_pre b
    ret false
  end
  if ne get g_d_post a get g_d_post b
    ret false
  end
  ab = mul a 8
  bb = mul b 8
  for i ulong sa bound 8
    if ne get g_d_op add ab i get g_d_op add bb i
      ret false
    end
    if ne get g_d_imm add ab i get g_d_imm add bb i
      ret false
    end
  end
  ret true
end

fn diff_id_eq a ulong b ulong to bool
  ab = mul a 32
  bb = mul b 32
  for i ulong 32
    if ne get g_d_id add ab i get g_d_id add bb i
      ret false
    end
  end
  ret true
end

fn gen_wide_slot s ulong to ulong
  prog_init s
  put g_p_has s 1
  n = add 1 rem rng_next 8
  put g_p_scnt s n
  sb = mul s 64
  for i ulong n bound 8
    put g_p_sop add sb i op_from_idx rem rng_next 5
    put g_p_simm add sb i and rng_next 0xffffffff
  end
  w = ulong 64
  if eq rem rng_next 4 0
    w = 32
  end
  put g_p_inw s w
  put g_p_outw s w
  pr = rem rng_next 3
  po = rem rng_next 3
  u = rng_next
  ib = mul s 32
  pb = mul pr 32
  qb = mul po 32
  for i ulong 32
    put g_p_preid add ib i get g_pre_cache add pb i
    put g_p_postid add ib i get g_post_cache add qb i
  end
  rc = prog_compute_id s
  ret or shl pr 8 po
end

fn mutate_op k ulong to void
  cur = get g_p_sop add 64 k
  ci = ulong 0
  for idx ulong 5
    if eq op_from_idx idx cur
      ci = idx
    end
  end
  step = add 1 rem rng_next 4
  put g_p_sop add 64 k op_from_idx rem add ci step 5
end

fn mutate_finish pr ulong po ulong to void
  pb = mul pr 32
  qb = mul po 32
  for i ulong 32
    put g_p_preid add 32 i get g_pre_cache add pb i
    put g_p_postid add 32 i get g_post_cache add qb i
  end
  u = prog_compute_id 1
end

fn mutate_slot kind ulong prpo ulong to void
  prog_copy 1 0
  sc = get g_p_scnt 1
  k = rem rng_next sc
  pr = shr prpo 8
  po = and prpo 255
  if eq kind 0
    mutate_op k
  end
  if eq kind 1
    sh = rem rng_next 32
    cur = get g_p_simm add 64 k
    put g_p_simm add 64 k xor cur shl ulong 1 sh
  end
  if eq kind 2
    nw = ulong 64
    if eq get g_p_inw 1 64
      nw = 32
    end
    put g_p_inw 1 nw
    put g_p_outw 1 nw
  end
  if eq kind 3
    pr = rem add add pr 1 rem rng_next 2 3
  end
  if eq kind 4
    po = rem add add po 1 rem rng_next 2 3
  end
  if eq kind 5
    if lt sc 64
      put g_p_sop add 64 sc op_from_idx rem rng_next 5
      put g_p_simm add 64 sc and rng_next 0xffff
      put g_p_scnt 1 add sc 1
    end
  end
  if eq kind 6
    if gt sc 1
      put g_p_scnt 1 sub sc 1
    else
      put g_p_simm 64 add get g_p_simm 64 1
    end
  end
  if eq kind 7
    nw = ulong 64
    if eq get g_p_outw 1 64
      nw = 32
    end
    put g_p_outw 1 nw
  end
  mutate_finish pr po
end

fn test_mutation to void
  put g_rng 0 0x9e3779b97f4a7c15
  for i ulong 3000
    diff_gen i
  end
  eq_pairs = ulong 0
  pairs = ulong 0
  for i ulong 3000
    j = add i 1
    while lt j 3000 bound 3000
      o = diff_oracle_eq i j
      h = diff_id_eq i j
      pairs = add pairs 1
      if o
        eq_pairs = add eq_pairs 1
      end
      chk 2 eq o h
      j = add j 1
    end
  end
  chk 2 gt eq_pairs 100
  write_all t_diff1 len t_diff1
  print_u64 3000
  write_all t_diff2 len t_diff2
  print_u64 pairs
  write_all t_diff3 len t_diff3
  print_u64 eq_pairs
  write_all t_diff4 len t_diff4

  put g_rng 0 0xd1b54a32d192ed03
  mut = ulong 0
  for i ulong 2000
    prpo = gen_wide_slot 0
    for kind ulong 8
      mutate_slot kind prpo
      mut = add mut 1
      chk 2 not prog_id_eq 1 0
    end
  end
  write_all t_mut1 len t_mut1
  print_u64 mut
  write_all t_mut2 len t_mut2
  print_u64 2000
  write_all t_mut3 len t_mut3
end

note ---- Gate 3: LIBRARY_REGRESSION ----
fn lib_reset to void
  put g_lib_cnt 0 0
end

fn lib_find_slot s ulong to long
  cnt = get g_lib_cnt 0
  sb = mul s 32
  for i ulong cnt bound 16
    lb = mul i 32
    same = true
    for k ulong 32
      if ne get g_lib_id add lb k get g_p_id add sb k
        same = false
        break
      end
    end
    if same
      ret long i
    end
  end
  ret -1
end

fn lib_insert s ulong to long
  if or eq get g_p_has s 0 prog_id_zero s
    ret -1
  end
  if ge lib_find_slot s 0
    ret -1
  end
  cnt = get g_lib_cnt 0
  if ge cnt 16
    ret -1
  end
  put g_lib_cnt 0 add cnt 1
  put g_lib_dep_cnt cnt 0
  sb = mul s 32
  lb = mul cnt 32
  for k ulong 32
    put g_lib_id add lb k get g_p_id add sb k
  end
  ret long cnt
end

fn lib_add_dep li ulong dep_slot ulong to void
  dc = get g_lib_dep_cnt li
  db = add mul li 128 mul dc 32
  sb = mul dep_slot 32
  for k ulong 32
    put g_lib_deps add db k get g_p_id add sb k
  end
  put g_lib_dep_cnt li add dc 1
end

fn lib_has_dep_on li ulong target_slot ulong to bool
  dc = get g_lib_dep_cnt li
  tb = mul target_slot 32
  for d ulong dc bound 4
    db = add mul li 128 mul d 32
    same = true
    for k ulong 32
      if ne get g_lib_deps add db k get g_p_id add tb k
        same = false
        break
      end
    end
    if same
      ret true
    end
  end
  ret false
end

fn compute_triple_id pslot ulong codeslot ulong to void
  for i ulong 23
    put g_sha_in i get t_triple_dom i
  end
  put g_sha_in 23 uchar 0
  pb = mul pslot 32
  for i ulong 32
    put g_sha_in add 24 i get g_p_id add pb i
    put g_sha_in add 56 i uchar add i 1
  end
  cl = get g_p_clen codeslot
  cb = mul codeslot 1024
  for i ulong cl bound 1024
    put g_sha_in add 88 i get g_p_code add cb i
  end
  sha256_hash add 88 cl
end

fn test_library to void
  lib_reset
  u = prog_build_unary 0 3 7
  u = prog_build_unary 1 3 7
  u = prog_build_unary 2 3 8
  chk 3 eq lib_insert 0 0
  chk 3 and lt lib_insert 1 0 eq get g_lib_cnt 0 1
  chk 3 and eq lib_insert 2 1 eq get g_lib_cnt 0 2
  fa = lib_find_slot 0
  fc = lib_find_slot 2
  chk 3 and ge fa 0 and ge fc 0 ne fa fc
  prog_init 3
  u = prog_compute_id 3
  chk 3 and lt lib_insert 3 0 eq get g_lib_cnt 0 2
  chk 3 eq prog_compose 0 2 4 0
  ci = lib_insert 4
  chk 3 ge ci 0
  lib_add_dep ulong ci 0
  lib_add_dep ulong ci 2
  chk 3 lib_has_dep_on ulong ci 0
  note Corpus benchmark (4 programs sharing mul2;add1)
  u = prog_build_unary 10 5 2
  u = prog_build_unary 11 3 1
  u = prog_compose 10 11 12
  u = prog_build_unary 13 3 5
  u = prog_compose 12 13 0
  u = prog_build_unary 13 5 3
  u = prog_compose 12 13 1
  u = prog_build_unary 13 4 4
  u = prog_compose 12 13 2
  u = prog_build_unary 13 3 10
  u = prog_compose 12 13 3
  chk 3 not prog_id_eq 0 1
  chk 3 not prog_id_eq 0 2
  chk 3 not prog_id_eq 0 3
  chk 3 not prog_id_eq 1 2
  chk 3 not prog_id_eq 1 3
  chk 3 not prog_id_eq 2 3
  note Shared prefix lift (mul2; add1 = 16 bytes + RET)
  chk 3 eq get g_p_scnt 12 2
  chk 3 and eq get g_p_sop 768 5 eq get g_p_simm 768 2
  chk 3 and eq get g_p_sop 769 3 eq get g_p_simm 769 1
  chk 3 not prog_id_zero 12
  note Refactoring preserves id, changes cost
  prog_copy 4 0
  put g_p_insn 4 sub get g_p_insn 4 2
  u = prog_compute_id 4
  chk 3 and prog_id_eq 4 0 ne get g_p_insn 4 get g_p_insn 0
  note VC bridge admission into fresh library
  lib_reset
  chk 3 and eq lib_insert 12 0 eq get g_lib_cnt 0 1
  note Realization triple id separates bodies
  u = prog_build_unary 0 5 3
  u = prog_build_unary 1 5 4
  compute_triple_id 0 0
  for i ulong 32
    put g_tmp_id i get g_sha_out i
  end
  compute_triple_id 1 0
  tdiff = false
  for i ulong 32
    if ne get g_tmp_id i get g_sha_out i
      tdiff = true
    end
  end
  chk 3 tdiff
  note Verify builder program
  chk 3 eq prog_build_unary 0 10 0x10 0
  chk 3 gt get g_p_clen 0 0
  note 64-step body accepted, 65-step refused
  u = prog_build_unary 0 3 1
  u = prog_build_unary 1 3 1
  for i ulong 63
    u = prog_compose 0 1 2
    prog_copy 0 2
  end
  chk 3 and eq get g_p_scnt 0 64 not prog_id_zero 0
  chk 3 ne prog_compose 0 1 2 0
end

note ---- Gate 4: VISOR_REGRESSION ----
fn vs_reset to void
  put g_vs_pcnt 0 0
  put g_vs_bcnt 0 0
end

fn vs_eval_fn s view uchar * to long
  u = lower_fn_to_slot s 29
  cnt = get g_vs_pcnt 0
  pidx = long -1
  for i ulong cnt bound 16
    if prog_id_eq get g_vs_pslot i 29
      pidx = long i
      break
    end
  end
  if lt pidx 0
    slot = add 12 cnt
    prog_copy slot 29
    put g_vs_pslot cnt slot
    pidx = long cnt
    put g_vs_pcnt 0 add cnt 1
  end
  nm = get g_aname0 0
  bc = get g_vs_bcnt 0
  bi = long -1
  for i ulong bc bound 16
    if eq get g_vs_bchar i nm
      bi = long i
      break
    end
  end
  if lt bi 0
    bi = long bc
    put g_vs_bchar bc nm
    put g_vs_bcnt 0 add bc 1
  end
  put g_vs_bpidx ulong bi ulong pidx
  ib = mul ulong bi 32
  pb = mul get g_vs_pslot ulong pidx 32
  for i ulong 32
    put g_vs_bid add ib i get g_p_id add pb i
  end
  ret pidx
end

fn prog_code_eq a ulong b ulong to bool
  cl = get g_p_clen a
  if ne cl get g_p_clen b
    ret false
  end
  ca = mul a 1024
  cb = mul b 1024
  for i ulong cl bound 1024
    if ne get g_p_code add ca i get g_p_code add cb i
      ret false
    end
  end
  ret true
end

fn test_visor to void
  vs_reset
  p1 = vs_eval_fn s_vis_t1
  chk 4 ge p1 0
  prog_copy 0 get g_vs_pslot ulong p1
  vs_reset
  p2 = vs_eval_fn s_vis_t2
  chk 4 ge p2 0
  prog_copy 1 get g_vs_pslot ulong p2
  chk 4 not prog_id_eq 0 1
  np = get g_vs_pcnt 0
  p3 = vs_eval_fn s_vis_t3
  chk 4 and ge p3 0 eq get g_vs_pcnt 0 add np 1
  prog_copy 2 get g_vs_pslot ulong p3
  chk 4 not prog_id_eq 1 2
  np = get g_vs_pcnt 0
  p4 = vs_eval_fn s_vis_t3b
  chk 4 and eq p4 p3 eq get g_vs_pcnt 0 np
  p5 = vs_eval_fn s_vis_u3
  chk 4 and eq p5 p3 eq get g_vs_pcnt 0 np
  s3 = get g_vs_pslot ulong p3
  prog_copy 3 s3
  u = prog_compute_id 3
  chk 4 prog_id_eq 3 s3
  u = prog_emit_body 3
  chk 4 prog_code_eq 3 s3
  p6 = vs_eval_fn s_vis_te
  chk 4 and ge p6 0 not prog_id_eq get g_vs_pslot ulong p6 s3
end

fn print_gate idx ulong name view uchar * to bool
  p = get g_pass idx
  t = get g_total idx
  ok = and eq p t gt t 0
  write_all t_gate len t_gate
  write_all name len name
  if ok
    write_all t_sp_pass len t_sp_pass
  else
    write_all t_sp_fail len t_sp_fail
  end
  print_u64 p
  write_all t_slash len t_slash
  print_u64 t
  write_all t_nl len t_nl
  ret ok
end

fn main to int
  init_caches
  test_body_bound
  test_representation
  test_mutation
  test_library
  test_visor
  ok = true
  if not print_gate 0 t_g0
    ok = false
  end
  if not print_gate 1 t_g1
    ok = false
  end
  if not print_gate 2 t_g2
    ok = false
  end
  if not print_gate 3 t_g3
    ok = false
  end
  if not print_gate 4 t_g4
    ok = false
  end
  tp = ulong 0
  tt = ulong 0
  for i ulong 5
    tp = add tp get g_pass i
    tt = add tt get g_total i
  end
  if ok
    write_all t_pass len t_pass
  else
    write_all t_fail len t_fail
  end
  print_u64 tp
  write_all t_slash len t_slash
  print_u64 tt
  write_all t_nl len t_nl
  if ok
    ret 0
  end
  ret 1
end

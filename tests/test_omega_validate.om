note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_validate.om against C oracle.
om2

text msg_pass "OMEGA_VALIDATE_OM_PASS\n"
text msg_fail "OMEGA_VALIDATE_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_valid_graph to void
  ign = omega_graph_create
  itb = omega_build_type_bool
  itu32 = omega_build_type_uint 32
  id0 = new uchar 32 0
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  core_get_id ulong itu32 id0
  core_get_id ulong itb id1
  ign = omega_build_type_sequence id0 8
  ign = omega_build_val_bool id1 true
  iva = omega_build_val_uint id0 32 10
  ivb = omega_build_val_uint id0 32 20
  iop = omega_build_op_binary 3 1 id0
  core_get_id ulong iop id0
  core_get_id ulong iva id1
  core_get_id ulong ivb id2
  ign = omega_build_apply id0 id1 id2
  ign = omega_build_effect 1 2 3 4
  info = new ulong 2 0
  chk eq omega_validate_graph info 0
  chk eq omega_validate_object true 0 0
end

fn test_refusals to void
  info = new ulong 2 0
  id0 = new uchar 32 0
  id1 = new uchar 32 0
  note Empty graph
  ign = omega_graph_create
  chk eq omega_validate_graph info -1

  note Invalid kind
  i0 = omega_graph_add_object 99
  chk eq omega_validate_object false ulong i0 -1

  note Invalid uint width 0
  ign = omega_graph_create
  ibad = omega_build_type_uint 0
  chk eq omega_validate_object true ulong ibad -1

  note Value byte_len mismatch (param has byte_len=0 for uint32)
  ign = omega_graph_create
  iu32 = omega_build_type_uint 32
  core_get_id ulong iu32 id0
  ip = omega_build_param id0 0
  chk eq omega_validate_object true ulong ip -1

  note Dangling relation target
  ign = omega_graph_create
  ia = omega_build_type_unit
  put id1 0 0xee
  chk eq omega_object_add_relation ulong ia 1 id1 0
  chk eq omega_validate_object true ulong ia -1

  note Structural cycle via relations (a -> b -> a)
  ign = omega_graph_create
  ca = omega_build_type_unit
  cb = omega_build_type_bool
  core_get_id ulong ca id0
  core_get_id ulong cb id1
  chk eq omega_object_add_relation ulong ca 6 id1 0
  chk eq omega_object_add_relation ulong cb 6 id0 0
  chk eq omega_validate_graph info -1
  chk eq get info 0 0
  chk eq get info 1 0
end

fn main to int
  test_valid_graph
  test_refusals
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

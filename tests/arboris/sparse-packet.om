note Reconstruct the Arboris command packet with an owned anonymous marker.
note No device descriptors exist. Inspect both constant-bank DMA payloads.
fn packet_word i ulong to ulong
  v = ulong 0
  for j ulong 4
    v = or v shl ulong get gbcmd add mul i 4 j mul j 8
  end
  ret v
end
fn main to int
  shape = new ulong 7 0
  slots = new ulong 20 0
  for i ulong 10
    put slots mul i 2 add 0x500000000 mul i 65536
    put slots add mul i 2 1 65536
  end
  put shape 0 129
  put shape 1 129
  put shape 2 64
  put shape 3 2
  put shape 5 0x3f000000
  marker = mapnew neg int 1 0 4096 3 34
  if le marker 0
    ret 1
  end
  put gbmem 3 marker
  if not ar_step_pack shape slots 1
    ret 2
  end
  note gbsetup 18 words, DMA prefix 9 words, then 224 driver words.
  if ne packet_word 22 896
    ret 3
  end
  if or ne packet_word 243 128 ne packet_word 248 2
    ret 4
  end
  if ne packet_word 255 48
    ret 5
  end
  if or ne packet_word 260 0x6000c ne packet_word 261 5
    ret 6
  end
  if ne packet_word 270 0x3f000000
    ret 7
  end
  if or ne get gbq1 39 2 ne get gbq1 40 2
    ret 8
  end
  meta = new ulong 16 0
  put meta 1 5
  put meta 2 9
  put meta 3 9
  put meta 4 8
  put meta 6 1
  put meta 13 512
  if not ar_gv_packet meta slots 4
    ret 10
  end
  if or ne get gbq1 39 2 ne get gbq1 40 1
    ret 11
  end
  if or ne and shr get gbq1 35 8 511 88 ne and get gbq1 36 2047 4
    ret 12
  end
  if or ne packet_word 255 80 ne packet_word 260 0x60000
    ret 13
  end
  if or ne packet_word 276 0x90000 ne packet_word 278 0x80000
    ret 14
  end
  put meta 4 264
  if not ar_gv_packet meta slots 4
    ret 21
  end
  if or ne get gbq1 40 2 ne packet_word 248 2
    ret 22
  end
  seq = ulong 0x10000000a
  put gbused 0 0
  ar_release_receipt 0x500006000 seq
  if or ne packet_word 1 0x6030 ne packet_word 3 10
    ret 15
  end
  if or ne packet_word 7 0x6034 ne packet_word 9 1
    ret 16
  end
  if or ne packet_word 13 0x6038 ne packet_word 15 6
    ret 17
  end
  r = mapset marker 48 8 seq
  r = mapset marker 56 8 6
  if not ar_device_receipt marker seq
    ret 18
  end
  if ar_device_receipt marker sub seq 1
    ret 19
  end
  r = mapset marker 0 8 1
  if ar_device_receipt marker seq
    ret 20
  end
  if ne mapdrop marker 0
    ret 9
  end
  ret 0
end

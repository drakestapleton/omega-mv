note Reconstruct the Arboris command packet with an owned anonymous marker.
note No device descriptors exist. Inspect both constant-bank DMA payloads.
fn packet_word i ulong to ulong
  v = ulong 0
  for j ulong 4
    v = or v shl ulong get gbcmd add mul i 4 j mul j 8
  end
  ret v
end
fn packet_route to bool
  m = new ulong 16 0
  put m 0 arboris_sparse_magic
  put m 1 2
  put m 2 1
  put m 3 1
  put m 4 1
  costs = new ulong 38 0
  graph = new uint 7 0
  scores = new uint 8 0
  put graph 0 ar_topo_v1
  put graph 1 2
  put graph 2 1
  put graph 5 1
  weights = new uint 1 ar_one
  put scores 0 1
  put scores 2 0x3f000000
  put scores 4 ar_one
  put costs 36 0x3f000000
  if or ne ar_prepare_sparse m costs 0 ne ar_execute_sparse graph weights scores 0
    ret false
  end
  if or ne get scores 1 1 ne get scores 7 0x3f000000
    ret false
  end
  put m 6 1
  if or ne ar_prepare_sparse_wave m costs 2 2 0 ne ar_execute_sparse graph weights scores 0
    ret false
  end
  if or ne get scores 1 1 ne get scores 7 0x3f000000
    ret false
  end
  put m 6 0
  put costs 0 1234
  put costs 4 2
  put costs 5 1
  put costs 6 1
  for i ulong 8
    put costs add 8 i get costs i
    put costs add 20 i get costs i
  end
  put costs 28 1
  put costs 17 3
  put costs 29 3
  put costs 18 100
  put costs 30 20
  put costs 19 80
  put costs 31 40
  if or ne ar_prepare_sparse m costs 1 ne ar_execute_sparse graph weights scores 4
    ret false
  end
  put m 1 3
  ret and eq ar_prepare_sparse m costs 0 eq ar_execute_sparse graph weights scores 3
end
fn packet_contender to bool
  pid = fork
  if eq pid 0
    inherited = fclose int get ar_compute_fd 0
    put ar_compute_kind 0 0
    if ar_claim_compute 1
      exit 1
    end
    exit 0
  end
  status = new uchar 4 0
  if le pid 0
    ret false
  end
  if ne waitpid int pid status 0 4 0 pid
    ret false
  end
  ret and eq get status 0 0 eq get status 1 0
end

fn packet_retry_blocked marker long to bool
  if not ar_claim_compute 2
    ret false
  end
  put nvstate 0 1
  put gbmem 3 marker
  put ar_maps 5 marker
  wrote = mapset marker 32 4 0x2345
  wrote = mapset marker 56 8 0x789
  put nvput 0 2
  put nvret 0 1
  put nvfault 0 1
  ok = and not ar_step_send not ar_step_close
  put nvret 0 2
  ok = and ok and not ar_step_send not ar_step_close
  ok = and ok packet_contender
  put nvstate 0 0
  ok = and ok ar_step_close
  ok = and ok ar_claim_compute 1
  ar_drop_compute
  put nvfault 0 0
  put nvput 0 0
  put nvret 0 0
  put gbmem 3 0
  put ar_maps 5 0
  ret and ok and eq mapget marker 32 4 0x2345 eq mapget marker 56 8 0x789
end

fn main to int
  if not packet_route
    ret 23
  end
  shape = new ulong 7 0
  slots = new ulong 20 0
  for i ulong 10
    put slots mul i 2 add 0x500000000 mul i 65536
    put slots add mul i 2 1 65536
  end
  put shape 0 129
  put shape 1 129
  put shape 2 64
  put shape 3 2
  put shape 5 0x3f000000
  marker = mapnew neg int 1 0 4096 3 34
  if le marker 0
    ret 1
  end
  put gbmem 3 marker
  if not ar_step_pack shape slots 1
    ret 2
  end
  note gbsetup 18 words, DMA prefix 9 words, then 224 driver words.
  if ne packet_word 22 896
    ret 3
  end
  if or ne packet_word 243 128 ne packet_word 248 2
    ret 4
  end
  if ne packet_word 255 48
    ret 5
  end
  if or ne packet_word 260 0x6000c ne packet_word 261 5
    ret 6
  end
  if ne packet_word 270 0x3f000000
    ret 7
  end
  if or ne get gbq1 39 2 ne get gbq1 40 2
    ret 8
  end
  meta = new ulong 16 0
  put meta 1 5
  put meta 2 9
  put meta 3 9
  put meta 4 8
  put meta 6 1
  put meta 13 512
  if not ar_gv_packet meta slots 4
    ret 10
  end
  if or ne get gbq1 39 2 ne get gbq1 40 1
    ret 11
  end
  if or ne and shr get gbq1 35 8 511 96 ne and get gbq1 36 2047 4
    ret 12
  end
  if or ne packet_word 255 80 ne packet_word 260 0x60000
    ret 13
  end
  if or ne packet_word 276 0x90000 ne packet_word 278 0x80000
    ret 14
  end
  put meta 4 264
  if not ar_gv_packet meta slots 4
    ret 21
  end
  if or ne get gbq1 40 2 ne packet_word 248 2
    ret 22
  end
  seq = ulong 0x10000000a
  put gbused 0 0
  ar_release_receipt 0x500006000 seq 0x50000a000
  if or ne packet_word 1 5 or ne packet_word 2 0x6030 ne packet_word 4 16
    ret 15
  end
  if or ne packet_word 9 10 or ne packet_word 10 1 or ne packet_word 11 6 ne packet_word 12 0
    ret 16
  end
  if or ne packet_word 17 0x80000000 or ne packet_word 19 0xa020 ne packet_word 21 ulong ar_completion_word seq
    ret 17
  end
  r = mapset marker 48 8 seq
  r = mapset marker 56 8 6
  if not ar_device_receipt marker seq
    ret 18
  end
  if ar_device_receipt marker sub seq 1
    ret 19
  end
  r = mapset marker 0 8 1
  if ar_device_receipt marker seq
    ret 20
  end
  if not packet_retry_blocked marker
    ret 23
  end
  if ne mapdrop marker 0
    ret 9
  end
  ret 0
end

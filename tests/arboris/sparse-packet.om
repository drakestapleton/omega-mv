note Reconstruct the Arboris command packet with an owned anonymous marker.
note No device descriptors exist. Inspect both constant-bank DMA payloads.
fn packet_word i ulong to ulong
  v = ulong 0
  for j ulong 4
    v = or v shl ulong get gbcmd add mul i 4 j mul j 8
  end
  ret v
end
fn main to int
  shape = new ulong 7 0
  slots = new ulong 20 0
  for i ulong 10
    put slots mul i 2 add 0x500000000 mul i 65536
    put slots add mul i 2 1 65536
  end
  put shape 0 129
  put shape 1 129
  put shape 2 64
  put shape 3 2
  put shape 5 0x3f000000
  marker = mapnew neg int 1 0 4096 3 34
  if le marker 0
    ret 1
  end
  put gbmem 3 marker
  if not ar_step_pack shape slots 1
    ret 2
  end
  note gbsetup 18 words, DMA prefix 9 words, then 224 driver words.
  if ne packet_word 22 896
    ret 3
  end
  if or ne packet_word 243 128 ne packet_word 248 2
    ret 4
  end
  if ne packet_word 255 48
    ret 5
  end
  if or ne packet_word 260 0x6000c ne packet_word 261 5
    ret 6
  end
  if ne packet_word 270 0x3f000000
    ret 7
  end
  if or ne get gbq1 39 2 ne get gbq1 40 2
    ret 8
  end
  if ne mapdrop marker 0
    ret 9
  end
  ret 0
end

fn main to int
  shape = new ulong 7 0
  slots = new ulong 20 0
  driver = new uint 224 0
  bank = new uint 236 0
  q0 = new uint 96 0
  q1 = new uint 96 0
  put shape 0 129
  put shape 1 129
  put shape 2 34
  put shape 3 3
  put shape 5 0x3f000000
  put shape 6 0x3d800000
  for i ulong 10
    put slots mul i 2 add 0x500000000 mul i 65536
    put slots add mul i 2 1 65536
  end
  put driver 214 0x12345678
  if ne arboris_wave_qmd shape slots driver bank q0 q1 0
    ret 1
  end
  if ne get q0 12 0x5000500
    ret 2
  end
  if ne get q1 12 0x5000400
    ret 2
  end
  if ne get q1 34 0x10080
    ret 3
  end
  if ne get q1 39 2
    ret 3
  end
  if ne get q1 40 3
    ret 3
  end
  if ne get bank 224 0x6000c
    ret 4
  end
  if ne get bank 226 0x60214
    ret 4
  end
  if ne get bank 228 0x70000
    ret 4
  end
  if ne get bank 230 0x80000
    ret 5
  end
  if ne get bank 232 0x90000
    ret 5
  end
  if ne get bank 233 5
    ret 5
  end
  if ne get bank 214 0x12345678
    ret 6
  end
  if ne get bank 234 0x3f000000
    ret 6
  end
  if ne get bank 235 0x3d800000
    ret 6
  end
  put shape 4 1
  if ne arboris_wave_qmd shape slots driver bank q0 q1 0
    ret 7
  end
  if ne get bank 230 0x90000
    ret 8
  end
  if ne get bank 232 0x80000
    ret 8
  end
  put q0 12 17
  put q1 12 23
  put bank 230 31
  put slots 19 3095
  if ne arboris_wave_qmd shape slots driver bank q0 q1 2
    ret 9
  end
  put slots 19 3096
  put slots 18 get slots 16
  if ne arboris_wave_qmd shape slots driver bank q0 q1 2
    ret 10
  end
  put slots 18 0xffffffff80
  if ne arboris_wave_qmd shape slots driver bank q0 q1 2
    ret 11
  end
  put slots 18 0x500090000
  put shape 1 128
  if ne arboris_wave_qmd shape slots driver bank q0 q1 1
    ret 12
  end
  if ne get q0 12 17
    ret 13
  end
  if ne get q1 12 23
    ret 13
  end
  if ne get bank 230 31
    ret 13
  end
  put shape 1 129
  put shape 6 0
  put slots 19 1548
  if ne arboris_relax_qmd shape slots driver bank q0 q1 0
    ret 14
  end
  if ne arboris_wave_qmd shape slots driver bank q0 q1 2
    ret 15
  end
  ret 0
end

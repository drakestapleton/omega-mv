note SPDX-License-Identifier: AGPL-3.0-only
note Native differential probe. FD3 is the issuer table. Fork before either
note process opens RM. The producer exits after import, closing all source
note aliases before the worker validates inputs and publishes its command.

fn probe_bank to ulong
  if eq probe_layout 4
    ret 1
  end
  ret 0
end

fn probe_decay to ulong
  if eq probe_layout 4
    ret 0x3f4ccccd
  end
  ret 0x3f000000
end

fn probe_start b ulong to ulong
  if and eq probe_layout 4 eq b 1
    ret 126
  end
  if and eq probe_layout 1 eq b 1
    ret sub probe_n 3
  end
  ret b
end

fn probe_seed i ulong to ulong
  if ne probe_layout 0
    if eq rem i probe_n probe_start div i probe_n
      if eq probe_layout 4
        ret 0x3f19999a
      end
      ret 0x3f800000
    end
    ret 0
  end
  if eq rem add rem i probe_n div div i probe_n probe_planes 3 0
    ret 0x3f800000
  end
  ret 0
end

fn probe_offset row ulong to ulong
  if eq probe_layout 4
    if eq row 1
      ret 0
    end
    ret row
  end
  if eq probe_layout 1
    ret row
  end
  if eq probe_layout 2
    if lt row sub probe_n 1
      ret 0
    end
    if eq row probe_n
      ret probe_n
    end
    ret 64
  end
  ret mul div row 2 2
end

fn probe_source arc ulong to ulong
  if and or eq probe_layout 1 eq probe_layout 4 ne arc 0
    ret sub arc 1
  end
  ret arc
end

fn probe_fill m view ulong 16 i ulong tok long to bool
  if eq i 0
    for j ulong 16
      if ne mapset tok mul j 8 8 get m j 0
        ret false
      end
    end
  end
  if eq i 1
    if ne mapset tok 0 4 0x41525431 0
      ret false
    end
    if or ne mapset tok 4 4 probe_n 0 ne mapset tok 8 4 probe_n 0
      ret false
    end
    for j ulong add probe_n 1
      if ne mapset tok add 12 mul j 4 4 probe_offset j 0
        ret false
      end
    end
    off = mul add probe_n 4 4
    for j ulong probe_n
      if ne mapset tok add off mul j 4 4 probe_source j 0
        ret false
      end
    end
  end
  if eq i 2
    for j ulong probe_n
      weight = ulong 0x3f000000
      if ne and j 1 0
        weight = ulong 0x3f400000
      end
      if ne probe_layout 0
        weight = ulong 0x3f800000
      end
      if eq probe_layout 4
        weight = ulong 0x3f333333
      end
      if ne mapset tok mul j 4 4 weight 0
        ret false
      end
    end
  end
  if eq i add 3 probe_bank
    for j ulong mul mul probe_n probe_batch probe_planes
      if ne mapset tok mul j 4 4 probe_seed j 0
        ret false
      end
    end
  end
  ret true
end

fn probe_match probe_scores view uint * words ulong to int
  tok = get ar_maps sub ulong 4 probe_bank
  base = add 4 mul words ulong get probe_scores 1
  for i ulong words
    if ne get probe_scores add base i uint mapget tok mul i 4 4
      ret 31
    end
  end
  probe_log ps_words words
  ret 0
end

text pb_queries "measured_queries="
text pb_elapsed "measured_query_ns="
note The timing supervisor measures only between the ready/go and done bytes
note on private FD14/FD13. Inputs, code and queries are resident by then.
fn pb_sync begin bool to bool
  signalbuf = new uchar 1 1
  if ne write 14 signalbuf 0 1 1
    ret false
  end
  if begin
    ret eq read 13 signalbuf 0 1 1
  end
  ret true
end

fn pb_iteration topo view uint * weights view uint * scores edit uint * to int
  put scores 1 0
  if gt probe_hops 1
    for i ulong mul probe_n probe_batch
      put scores add i 4 uint probe_seed i
    end
  end
  if eq probe_planes 1
    for hop ulong probe_hops
      if ne arboris_relax_step topo weights scores 0
        ret 51
      end
    end
  else
    if ne arboris_spread_step topo weights scores 0
      ret 51
    end
  end
  ret 0
end

fn pb_cpu topo view uint * weights view uint * scores edit uint * to int
  if not pb_sync true
    ret 50
  end
  start = monons
  now = start
  queries = ulong 0
  while lt sub now start 8000000000 bound 0xffffffff
    if ne pb_iteration topo weights scores 0
      ret 51
    end
    queries = add queries 1
    now = monons
  end
  if not pb_sync false
    ret 52
  end
  probe_log pb_queries queries
  probe_log pb_elapsed ulong sub now start
  ret 0
end

note Each benchmark iteration is an independent read-only query from the same
note input bank. Discard its fenced output after the timing sample. No epoch
note is committed, and no production caller gains this fixture-only operation.
fn pb_discard m view ulong 16 to bool
  if not ar_snapshot_matches m
    ret false
  end
  seq = get ar_fenced_seq 0
  if or ne get nvret 0 seq ne get nvput 0 seq
    ret false
  end
  if not ar_device_receipt get ar_maps 5 seq
    ret false
  end
  put ar_fenced_seq 0 0
  ar_drop_compute
  ret true
end

text pb_seq "submitted_seq="
text pb_retired "retired_seq="
text pb_receipt_seq "receipt_seq="
text pb_receipt_status "receipt_status="
text pb_wfi "wfi_marker="
text pb_flushed "flush_marker="
text pb_final "completion_marker="
text pb_qmd "qmd_semaphore="
fn pb_failure reason ulong queries ulong to void
  probe_log ps_rc reason
  probe_log pb_queries queries
  probe_log pb_seq get nvput 0
  probe_log pb_retired get nvret 0
  probe_log pb_receipt_seq mapget get ar_maps 5 48 8
  probe_log pb_receipt_status mapget get ar_maps 5 56 8
  probe_log pb_wfi mapget get gbmem 3 0 4
  probe_log pb_flushed mapget get gbmem 3 16 4
  probe_log pb_final mapget get gbmem 3 32 4
  probe_log pb_qmd mapget get gbmem 2 8192 4
end

fn pb_gpu table long h view ulong 2 m view ulong 16 to int
  if not pb_sync true
    ret 50
  end
  start = monons
  now = start
  queries = ulong 0
  while lt sub now start 8000000000 bound 0xffffffff
    if not pb_discard m
      ret 53
    end
    reason = probe_execute_sparse table h m
    if ne reason 0
      pb_failure reason queries
      ret 54
    end
    queries = add queries 1
    now = monons
  end
  if not pb_sync false
    ret 52
  end
  probe_log pb_queries queries
  probe_log pb_elapsed ulong sub now start
  ret 0
end

fn probe_copy_seeds scores edit uint * words ulong to void
  tok = get ar_maps add 3 probe_bank
  base = add 4 mul words probe_bank
  for i ulong words
    put scores add base i uint mapget tok mul i 4 4
  end
end

fn probe_expected probe_topo view uint * probe_weights view uint * to int
  probe_scores = new uint 800004 0
  put probe_scores 0 uint probe_batch
  put probe_scores 1 uint probe_bank
  put probe_scores 2 uint probe_decay
  words = mul mul probe_n probe_batch probe_planes
  probe_copy_seeds probe_scores words
  start = monons
  result = ulong 1
  if eq probe_planes 1
    for hop ulong probe_hops
      result = arboris_relax_step probe_topo probe_weights part probe_scores 0 add 4 mul words 2
      if ne result 0
        ret 30
      end
    end
  else
    result = arboris_spread_step probe_topo probe_weights part probe_scores 0 add 4 mul words 2
  end
  if ne result 0
    ret 30
  end
  elapsed = sub monons start
  probe_log ps_cpu ulong elapsed
  if eq get ps_signed 0 4
    if ne pb_cpu probe_topo probe_weights part probe_scores 0 add 4 mul words 2 0
      ret 55
    end
  end
  ret probe_match probe_scores words
end

fn probe_compare to int
  probe_topo = new uint 200004 0
  probe_weights = new uint 100000 0
  nt = add 4 mul probe_n 2
  for i ulong nt
    put probe_topo i uint mapget get ar_maps 1 mul i 4 4
  end
  for i ulong probe_n
    put probe_weights i uint mapget get ar_maps 2 mul i 4 4
  end
  ret probe_expected part probe_topo 0 nt part probe_weights 0 probe_n
end

fn probe_open_sparse m view ulong 16 to bool
  if eq probe_layout 4
    if not ar_open_query m probe_n 3
      ret false
    end
    put ar_query_variant 0 probe_n
    put ar_query_variant 1 probe_hops
    ret ar_bind_sparse_code m
  end
  if eq probe_layout 1
    ret ar_open_query m probe_n probe_hops
  end
  if eq probe_layout 2
    ret ar_open_query m sub probe_n 2 1
  end
  ret ar_step_open m
end

fn probe_execute_sparse table long h view ulong 2 meta view ulong 16 to ulong
  if eq probe_layout 0
    ret ar_sparse_hop table 42 h meta 0x3f000000 0
  end
  spec = new ulong 3 0
  put spec 0 probe_n
  if eq probe_layout 2
    put spec 0 sub probe_n 2
  end
  put spec 1 probe_hops
  put spec 2 probe_decay
  ret ar_sparse_query table 42 h meta spec
end

fn probe_run table long h view ulong 2 meta edit ulong 16 to int
  offsets = new ulong 6 0
  if ne arboris_plan_sparse meta 0x10000000 4096 offsets 0
    ret 1
  end
  if not caproot_validate table 42 h meta
    ret 2
  end
  rc = probe_import meta offsets
  if ne rc 0
    ret rc
  end
  if not probe_open_sparse meta
    ret 22
  end
  if not probe_arm_signer table meta h probe_decay
    ret 47
  end
  start = monons
  hop = probe_execute_sparse table h meta
  elapsed = sub monons start
  probe_log ps_rc hop
  if ne hop 0
    ret 23
  end
  probe_log ps_gpu ulong elapsed
  if eq get ps_signed 0 3
    rc = pb_gpu table h meta
    if ne rc 0
      ret rc
    end
  end
  rc = probe_compare
  if ne rc 0
    ret rc
  end
  hashes = new uchar 96 0
  if not ar_step_digests meta get nvret 0 hashes
    ret 35
  end
  probe_digest ps_input part hashes 0 32
  probe_digest ps_code part hashes 32 32
  probe_digest ps_output part hashes 64 32
  if not probe_witness table meta h
    ret 39
  end
  ret 0
end

fn probe_model_meta m edit ulong 16 to void
  put m 0 arboris_sparse_magic
  put m 1 probe_n
  put m 2 probe_batch
  put m 3 probe_n
  put m 4 probe_planes
  put m 6 probe_bank
end

note Independent closed-form fixture with empty rows and two incoming arcs on
note odd destinations. Weights and seeds are dyadic, so no floating oracle
note shares the rounding or traversal implementation being checked.
fn probe_golden v ulong b ulong plane ulong to ulong
  if eq probe_layout 4
    first = probe_start b
    if or lt v first gt v add first probe_hops
      ret 0
    end
    score = f32of 0x3f19999a
    factor = mul f32of 0x3f333333 f32of probe_decay
    for distance ulong sub v first bound 2
      score = mul score factor
    end
    ret bitsof score
  end
  if ne probe_layout 0
    b = probe_start b
    if eq v b
      ret 0x3f800000
    end
    if eq probe_layout 1
      if and gt v b le v add b probe_hops
        ret sub 0x3f800000 shl sub v b 23
      end
    else
      if eq v sub probe_n 2
        ret 0x3f000000
      end
    end
    ret 0
  end
  raw = ulong 0
  discounted = ulong 0
  if ne and v 1 0
    if eq rem add sub v 1 b 3 0
      raw = ulong 0x3f000000
      discounted = ulong 0x3e800000
    end
    if eq rem add v b 3 0
      raw = ulong 0x3f400000
      discounted = ulong 0x3ec00000
    end
  end
  if and eq probe_planes 2 eq plane 0
    ret raw
  end
  if eq rem add v b 3 0
    ret 0x3f800000
  end
  ret discounted
end

fn probe_reference to int
  m = new ulong 16 0
  offsets = new ulong 6 0
  probe_model_meta m
  if ne arboris_plan_sparse m 0x10000000 4096 offsets 0
    ret 40
  end
  for i ulong 6
    size = ar_region_bytes m offsets i
    tok = mapnew neg int 1 0 size 3 34
    if le tok 0
      ret 41
    end
    put ar_maps i tok
    if not probe_fill m i tok
      ret 42
    end
  end
  dest = get ar_maps sub ulong 4 probe_bank
  cells = div get m 11 4
  for i ulong cells
    row = div i probe_n
    score = probe_golden rem i probe_n div row probe_planes rem row probe_planes
    if ne mapset dest mul i 4 4 score 0
      ret 43
    end
  end
  rc = probe_compare
  if ne rc 0
    ret rc
  end
  ctx = new ulong 40 0
  hash = new uchar 32 0
  sha256_init ctx
  if not ar_hash_mapping ctx dest get m 11
    ret 44
  end
  sha256_final ctx hash
  probe_digest ps_output hash
  ret 0
end

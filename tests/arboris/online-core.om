note SPDX-License-Identifier: AGPL-3.0-only
note Host verification gate for the shared zero-global Arboris online core
note (`om/arboris_online.om`), covering looped-core wrap, multi-stream
note cross-batch expert deduplication + sum-over-paths ranking, and negative controls.

fn ik_set_cfg cfg edit ulong 6 to void
  put cfg 0 24
  put cfg 1 128
  put cfg 2 8
  put cfg 3 16
  put cfg 4 17
  put cfg 5 6
end

fn ds_set_cfg cfg edit ulong 6 to void
  put cfg 0 4
  put cfg 1 384
  put cfg 2 6
  put cfg 3 16
  put cfg 4 AO_NONE
  put cfg 5 AO_NONE
end

fn fill_ids_offset buf edit uint * base uint to void
  for k ulong len buf bound 64
    put buf k add base uint k
  end
end

fn ck_wrap_train cfg view ulong 6 edges edit uint * prev_state edit uint * to int
  ids_a = new uint 8 0
  ids_b = new uint 8 0
  ids_c = new uint 8 0
  fill_ids_offset ids_a 10
  fill_ids_offset ids_b 20
  fill_ids_offset ids_c 30
  if not ao_stage_cur cfg prev_state ids_a
    ret 6
  end
  if not ao_observe cfg edges prev_state 0
    ret 7
  end
  if not ao_stage_cur cfg prev_state ids_b
    ret 8
  end
  if not ao_observe cfg edges prev_state 1
    ret 9
  end
  if not ao_reset_token cfg prev_state
    ret 10
  end
  if not ao_stage_cur cfg prev_state ids_a
    ret 11
  end
  if not ao_observe cfg edges prev_state 17
    ret 12
  end
  if not ao_stage_cur cfg prev_state ids_c
    ret 13
  end
  if not ao_observe cfg edges prev_state 6
    ret 14
  end
  if not ao_stage_cur cfg prev_state ids_b
    ret 15
  end
  if not ao_observe cfg edges prev_state 6
    ret 16
  end
  ret 0
end

fn ck_wrap_score cfg view ulong 6 edges edit uint * to int
  ids_a = new uint 8 0
  resident = new long 3072 -1
  scores_work = new ulong 135 0
  recs = new uint 8 0
  fill_ids_offset ids_a 10
  for k ulong 6
    put scores_work k get cfg k
  end
  put scores_work 6 23
  if not ao_score_batch edges ids_a scores_work
    ret 17
  end
  if ne get scores_work add ulong 7 30 8
    ret 18
  end
  put scores_work 6 17
  if not ao_score_batch edges ids_a scores_work
    ret 19
  end
  if ne get scores_work add ulong 7 30 0
    ret 20
  end
  put scores_work 6 23
  if not ao_score_batch edges ids_a scores_work
    ret 21
  end
  put resident add mul ulong 6 128 30 0
  if ne ao_mask_resident cfg 6 resident part scores_work 7 128 0
    ret 22
  end
  if ne ao_pick_op3 cfg part scores_work 7 128 part recs 0 4 2
    ret 23
  end
  if or ne get recs 0 3 ne get recs 1 31
    ret 24
  end
  if or ne get recs 2 3 ne get recs 3 32
    ret 25
  end
  ret 0
end

fn ck_single_and_loop to int
  cfg = new ulong 6 0
  edges = new uint 49152 0
  prev_state = new uint 17 0
  ik_set_cfg cfg
  if or not ao_cfg_valid cfg ne ao_table_words cfg 49152
    ret 1
  end
  if not ao_reset_all cfg edges prev_state
    ret 2
  end
  if ne ao_resolve_trans cfg 17 6 23
    ret 3
  end
  if ne ao_resolve_trans cfg 17 18 17
    ret 4
  end
  if ne ao_resolve_trans cfg 23 0 24
    ret 5
  end
  rc = ck_wrap_train cfg edges prev_state
  if ne rc 0
    ret rc
  end
  rc = ck_wrap_score cfg edges
  if ne rc 0
    ret rc
  end
  note Saturation halving test at AO_DECAY_AT (60000 -> 30000)
  row_base = mul add mul ulong 6 128 4 16
  put edges row_base ao_pack 59999 77
  ao_bump_edge cfg edges 6 4 77
  if or ne ulong shr get edges row_base 16 30000 ne ulong and get edges row_base 65535 77
    ret 26
  end
  ret 0
end

fn ck_ms_seed_edges cfg view ulong 6 edges edit uint * to void
  ao_bump_edge cfg edges 1 10 100
  ao_bump_edge cfg edges 1 10 100
  ao_bump_edge cfg edges 1 20 200
  ao_bump_edge cfg edges 1 20 200
  ao_bump_edge cfg edges 1 20 200
  ao_bump_edge cfg edges 1 20 105
  ao_bump_edge cfg edges 1 70 55
  ao_bump_edge cfg edges 1 70 55
  ao_bump_edge cfg edges 1 70 55
  ao_bump_edge cfg edges 1 70 55
end

fn ck_ms_fill_batch batch_ids edit uint 24 to void
  put batch_ids 0 10
  put batch_ids 1 20
  put batch_ids 2 30
  put batch_ids 6 20
  put batch_ids 7 30
  put batch_ids 8 70
  put batch_ids 12 10
  put batch_ids 13 70
  put batch_ids 14 110
  put batch_ids 18 20
  put batch_ids 19 110
  put batch_ids 20 120
end

fn ck_ms_pick cfg view ulong 6 scores_work edit ulong * to int
  dummy_res = new long 1 0
  recs = new uint 8 0
  if ne ao_mask_resident cfg 2 part dummy_res 0 0 part scores_work 7 384 0
    ret 48
  end
  if ne ao_pick_op3 cfg part scores_work 7 384 recs 4
    ret 49
  end
  if or ne get recs 1 55 ne get recs 3 200
    ret 50
  end
  if or ne get recs 5 100 ne get recs 7 105
    ret 51
  end
  ret 0
end

fn ck_ms_rank cfg view ulong 6 edges view uint * dedup_out view uint * n_uniq ulong to int
  scores_work = new ulong 391 0
  for k ulong 6
    put scores_work k get cfg k
  end
  put scores_work 6 1
  if not ao_score_batch edges part dedup_out 0 n_uniq scores_work
    ret 47
  end
  ret ck_ms_pick cfg scores_work
end

fn ck_multistream_dedup_and_rank to int
  cfg = new ulong 6 0
  edges = new uint 24576 0
  prev_state = new uint 13 0
  batch_ids = new uint 24 0xffffffff
  meta = new ulong 4 0
  dedup_out = new uint 72 0
  ds_set_cfg cfg
  if or not ao_cfg_valid cfg ne ao_table_words cfg 24576
    ret 40
  end
  if not ao_reset_all cfg edges prev_state
    ret 41
  end
  ck_ms_seed_edges cfg edges
  ck_ms_fill_batch batch_ids
  put meta 0 384
  put meta 1 4
  put meta 2 6
  n_uniq = ao_dedup_batch meta batch_ids dedup_out
  if ne n_uniq 6
    ret 42
  end
  if or ne get dedup_out 0 10 ne get dedup_out 1 20
    ret 43
  end
  if or ne get dedup_out 2 30 ne get dedup_out 3 70
    ret 44
  end
  if or ne get dedup_out 4 110 ne get dedup_out 5 120
    ret 44
  end
  if or ne get dedup_out 24 2 ne get dedup_out 25 3
    ret 45
  end
  if ne get dedup_out 27 2
    ret 45
  end
  if or ne get dedup_out 66 1 ne get dedup_out 51 uint AO_NONE
    ret 46
  end
  ret ck_ms_rank cfg edges dedup_out ulong n_uniq
end

fn ck_neg_cfg to int
  bad_cfg = new ulong 6 0
  cfg = new ulong 6 0
  short_state = new uint 8 0
  edges = new uint 49152 0
  ik_set_cfg bad_cfg
  put bad_cfg 0 0
  if or ao_cfg_valid bad_cfg ne ao_table_words bad_cfg 0
    ret 70
  end
  ik_set_cfg bad_cfg
  put bad_cfg 1 65536
  if ao_cfg_valid bad_cfg
    ret 71
  end
  ik_set_cfg bad_cfg
  put bad_cfg 2 200
  if ao_cfg_valid bad_cfg
    ret 72
  end
  ik_set_cfg bad_cfg
  put bad_cfg 4 AO_NONE
  if ao_cfg_valid bad_cfg
    ret 73
  end
  ik_set_cfg cfg
  if ao_reset_token cfg short_state
    ret 74
  end
  if ao_reset_all bad_cfg edges short_state
    ret 75
  end
  ret 0
end

fn ck_neg_buffers to int
  cfg = new ulong 6 0
  meta = new ulong 4 0
  batch_ids = new uint 8 0
  dedup_out = new uint 24 777
  scores = new ulong 128 0
  odd_recs = new uint 3 0
  short_res = new long 128 -1
  ik_set_cfg cfg
  put meta 0 384
  put meta 1 2
  put meta 2 4
  put batch_ids 5 384
  if ne ao_dedup_batch meta batch_ids dedup_out -1
    ret 76
  end
  if ne get dedup_out 0 777
    ret 77
  end
  put batch_ids 5 12
  if ne ao_dedup_batch meta batch_ids part dedup_out 0 23 -1
    ret 78
  end
  if ne ao_pick_op3 cfg scores odd_recs -1
    ret 79
  end
  if ne ao_mask_resident cfg 1 short_res scores -1
    ret 80
  end
  if ne ao_mask_resident cfg 24 short_res scores -1
    ret 81
  end
  ret 0
end

fn main to int
  rc = ck_single_and_loop
  if ne rc 0
    ret rc
  end
  rc = ck_multistream_dedup_and_rank
  if ne rc 0
    ret rc
  end
  rc = ck_neg_cfg
  if ne rc 0
    ret rc
  end
  ret ck_neg_buffers
end

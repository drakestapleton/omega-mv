note SPDX-License-Identifier: AGPL-3.0-only
fn main to int
  coeff = new uint 64 0
  arboris_cubic_table coeff
  error = f32 0
  worst = ulong 0
  for h ulong 65536
    if ne and h 0x7c00 0x7c00
      x = f32of f16to32 h
      y = arboris_cubic_gate x coeff
      if or lt y f32 0 gt y f32 1
        ret 1
      end
      diff = fabs sub y ag_sigmoid x
      if gt diff error
        error = diff
        worst = h
      end
    end
  end
  metrics = new uchar 8 0
  for i ulong 4
    put metrics i uchar and shr bitsof error mul 8 i 255
    put metrics add 4 i uchar and shr worst mul 8 i 255
  end
  src = new ushort 32 0
  block = new uint 5 0
  put src 0 0x4700
  put src 1 0xc700
  put src 2 0x4100
  put src 3 0x4300
  if not arboris_q4_pack src block
    ret 2
  end
  if or ne arboris_q4_weight block 0 f32 7 ne arboris_q4_weight block 1 neg f32 7
    ret 3
  end
  if or ne arboris_q4_weight block 2 f32 2 ne arboris_q4_weight block 3 f32 4
    ret 4
  end
  put src 31 0x7e00
  if arboris_q4_pack src block
    ret 5
  end
  if ne write 1 metrics 0 8 8
    ret 6
  end
  ret 0
end

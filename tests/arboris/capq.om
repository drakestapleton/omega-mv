note SPDX-License-Identifier: AGPL-3.0-only
fn main to int
  key = new ulong 8 0
  cpu = new ulong 12 0
  gpu = new ulong 12 0
  put key 0 1234
  put key 4 1000000
  put key 5 4000000
  put key 6 8
  put key 7 1
  for i ulong 8
    put cpu i get key i
    put gpu i get key i
  end
  put gpu 8 1
  put cpu 9 7
  put cpu 10 100
  put cpu 11 9
  if ne arboris_capq key cpu gpu 0
    ret 1
  end
  put gpu 9 7
  put gpu 10 50
  put gpu 11 10
  if ne arboris_capq key cpu gpu 0
    ret 2
  end
  put gpu 11 9
  if ne arboris_capq key cpu gpu 1
    ret 3
  end
  put gpu 6 1
  if ne arboris_capq key cpu gpu 0
    ret 4
  end
  ret 0
end

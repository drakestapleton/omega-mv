note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/arboris/scoreboard_oracle.c.
note Stdin adapter for the repository's static sm_121 scoreboard hazard checker
note (src/omega_bw_hazard.om). Host test only; no device or dispatch interface.
om2

text sb_p1 "scoreboard: "
text sb_p2 " instructions, "
text sb_p3 " reachable, "
text sb_p4 " hazards\n"

fn sb_put_str dst edit uchar * pos ulong s view uchar * to ulong
  sl = len s
  for i ulong sl bound 64
    put dst add pos i get s i
  end
  ret add pos sl
end

fn sb_put_u64 dst edit uchar * pos ulong v ulong to ulong
  if eq v 0
    put dst pos uchar 48
    ret add pos 1
  end
  tmp = new uchar 24 0
  n = ulong 0
  x = v
  while gt x 0 bound 24
    q = div x 10
    r = sub x mul q 10
    put tmp n uchar add r 48
    n = add n 1
    x = q
  end
  for i ulong n bound 24
    put dst add pos i get tmp sub sub n 1 i
  end
  ret add pos n
end

fn sb_read_stdin buf edit uchar * cap ulong to long
  total = ulong 0
  done = false
  while and not done lt total cap bound 4096
    left = sub cap total
    n = read 0 buf total left
    if lt n 0
      ret -1
    end
    if eq n 0
      done = true
    else
      total = add total ulong n
    end
  end
  ret long total
end

fn main to int
  code = new uchar 32768 0
  n = sb_read_stdin code 32768
  if or le n 0 ge n 32768
    ret 2
  end
  rc = omega_bw_hazard_check code ulong n
  if ne rc 0
    ret 2
  end
  line = new uchar 128 0
  p = ulong 0
  p = sb_put_str line p sb_p1
  p = sb_put_u64 line p get g_bwr_insns 0
  p = sb_put_str line p sb_p2
  p = sb_put_u64 line p get g_bwr_reachable 0
  p = sb_put_str line p sb_p3
  p = sb_put_u64 line p get g_bwr_count 0
  p = sb_put_str line p sb_p4
  ign = write 1 line 0 p
  if ne get g_bwr_count 0 0
    ret 1
  end
  ret 0
end

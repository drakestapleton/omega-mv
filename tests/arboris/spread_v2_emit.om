note SPDX-License-Identifier: AGPL-3.0-only
note Emit Mode 0 (argcnt == 1) or Mode 1 (argcnt >= 2) SM121 SASS binary to stdout.
fn main to int
  code = new uchar 16384 0
  sz = ulong 0
  if eq argcnt 1
    sz = bw_arboris_spread_emit_mode0 code
  else
    sz = bw_arboris_spread_emit_mode1 code
  end
  if eq sz 0
    ret 1
  end
  if ne write 1 code 0 sz long sz
    ret 2
  end
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
fn main to int
  code = new uchar 16384 0
  size = arboris_emit_spread 100000 code
  if eq argcnt 3
    size = arboris_emit_relax 100000 code
  end
  if eq size 0
    ret 1
  end
  if eq argcnt 2
    note The pinned nvdisasm listing locates the load-dependent FMUL at 0x1f0.
    put code 0x1fe and get code 0x1fe 15
  end
  if ne write 1 code 0 size long size
    ret 2
  end
  ret 0
end

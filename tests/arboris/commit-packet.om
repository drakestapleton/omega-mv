note Host-only fenced-state fixture. Its signature is from RFC 8032 test key 1.
note Anonymous mappings stand in for the arena and capability table.
fn test_grant table long to void
  r = mapset table 0 4 0x50414358
  r = mapset table 4 4 256
  r = mapset table 16 8 9
  r = mapset table 120 4 1
  r = mapset table 128 8 3
  r = mapset table 136 4 1
  r = mapset table 144 4 42
  r = mapset table 148 4 4
  r = mapset table 152 8 arboris_gpu_resource
  r = mapset table 160 8 9
  r = mapset table 176 4 0xffffffff
end

fn test_fence m edit ulong 16 to bool
  put m 0 arboris_sparse_magic
  put m 1 1
  put m 2 1
  put m 3 1
  put m 4 1
  put m 7 9
  put m 8 3
  offsets = new ulong 6 0
  if ne arboris_plan_sparse m 65536 4096 offsets 0
    ret false
  end
  for i ulong 6
    tok = mapnew neg int 1 0 4096 3 34
    if le tok 0
      ret false
    end
    put ar_maps i tok
  end
  for i ulong 16
    r = mapset get ar_maps 0 mul i 8 8 get m i
  end
  t = get ar_maps 1
  r = mapset t 0 4 0x41525431
  r = mapset t 4 4 1
  r = mapset t 8 4 1
  r = mapset t 16 4 1
  r = mapset get ar_maps 2 0 4 0x3f000000
  r = mapset get ar_maps 3 0 4 0x3f800000
  r = mapset get ar_maps 4 0 4 0x3f000000
  r = mapset get ar_maps 5 48 8 1
  r = mapset get ar_maps 5 56 8 6
  tok = mapnew neg int 1 0 4096 3 34
  put gbmem 4 tok
  r = mapset tok 0 4 0x04030201
  put ar_code_bytes 0 4
  put nvret 0 1
  put nvput 0 1
  put ar_fenced_seq 0 1
  ret true
end

fn test_pk bytes edit uchar 32 to void
  ar_test_octets bytes 0 0xb70ab18201985ad7
  ar_test_octets bytes 8 0x3a0764c9d3fe4bd5
  ar_test_octets bytes 16 0x2523a6daf372e10e
  ar_test_octets bytes 24 0x1a5107f7681a02af
end

fn test_sig bytes edit uchar 64 to void
  ar_test_octets bytes 0 0xa3bdd6f554a82e45
  ar_test_octets bytes 8 0xa2a0d3594b30a355
  ar_test_octets bytes 16 0xc78bdc194201e953
  ar_test_octets bytes 24 0xac020c1d58aca6ae
  ar_test_octets bytes 32 0x9ae2f837253494ca
  ar_test_octets bytes 40 0xbb9c9cbf5722a802
  ar_test_octets bytes 48 0x06d36a71da991c9c
  ar_test_octets bytes 56 0x0632d8be55bef07b
end

fn ar_test_octets b edit uchar * offset ulong v ulong to void
  for i ulong 8
    put b add offset i uchar and shr v mul i 8 255
  end
end

fn test_fd raw view uchar 16 off ulong to int
  v = uint 0
  for i ulong 4
    v = or v shl uint get raw add off i mul i 8
  end
  ret int v
end

fn test_signed_channel table long m view ulong 16 pk view uchar 32 sig view uchar 64 to bool
  raw = new uchar 16 0
  if ne pipefds raw 0 8 0 0
    ret false
  end
  if ne pipefds raw 8 8 0 0
    ret false
  end
  channel = new int 2 0
  put channel 0 test_fd raw 4
  put channel 1 test_fd raw 8
  if ne write test_fd raw 12 sig 0 64 64
    ret false
  end
  grant = new ulong 3 0
  put grant 0 42
  put grant 1 1
  put grant 2 3
  result = new uchar 240 0
  if not ar_seal_step table grant m channel pk result
    ret false
  end
  sent = new uchar 176 0
  if ne read test_fd raw 0 sent 0 176 176
    ret false
  end
  for i ulong 176
    if ne get sent i get result i
      ret false
    end
  end
  for i ulong 64
    if ne get sig i get result add 176 i
      ret false
    end
  end
  for i ulong 4
    if ne fclose test_fd raw mul i 4 0
      ret false
    end
  end
  ret true
end

fn main to int
  m = new ulong 16 0
  if not test_fence m
    ret 1
  end
  table = mapnew neg int 1 0 22560 3 34
  test_grant table
  pk = new uchar 32 0
  sig = new uchar 64 0
  test_pk pk
  test_sig sig
  h = new ulong 2 0
  put h 0 1
  put h 1 3
  put sig 0 xor get sig 0 1
  if ar_commit_step table 42 h m pk sig
    ret 2
  end
  if ne mapget get ar_maps 5 32 8 0
    ret 3
  end
  put sig 0 xor get sig 0 1
  if ar_commit_step table 43 h m pk sig
    ret 4
  end
  r = mapset get ar_maps 4 0 4 0x3e800000
  if ar_commit_step table 42 h m pk sig
    ret 5
  end
  r = mapset get ar_maps 4 0 4 0x3f000000
  if not test_signed_channel table m pk sig
    ret 6
  end
  if ne mapget get ar_maps 5 32 8 10
    ret 7
  end
  if ne mapget get ar_maps 5 24 8 0x80000000
    ret 8
  end
  if ar_commit_step table 42 h m pk sig
    ret 9
  end
  put m 7 10
  if ar_snapshot_matches m
    ret 10
  end
  put m 6 1
  if not ar_snapshot_matches m
    ret 11
  end
  if caproot_validate table 42 h m
    ret 12
  end
  ret 0
end

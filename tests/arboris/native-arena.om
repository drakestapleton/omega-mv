note Host smoke for the native import preflight and CPU address reservations.
note No GPU device is opened in this program.
fn main to int
  m = new ulong 16 0
  starts = new ulong 6 0
  records = new uchar 144 0
  put m 0 arboris_magic
  put m 1 1
  put m 2 1
  put m 3 1
  put m 4 8
  put m 5 1
  put m 10 128
  if ne arboris_plan_arena m 1048576 4096 starts 0
    ret 1
  end
  for i ulong 6
    base = mul i 24
    put records base 79
    put records add base 1 77
    put records add base 2 90
    put records add base 3 67
    put records add base 4 1
    put records add base 8 33
    put records add base 12 uchar add i 1
    put records add base 17 16
  end
  if not ar_shares_valid records m starts
    ret 2
  end
  put records 132 1
  if ar_shares_valid records m starts
    ret 3
  end
  put records 132 6
  put records 17 32
  if ar_shares_valid records m starts
    ret 4
  end
  if ar_map_arena records m 1048576
    ret 5
  end
  reservation = maphold 68719476736 4096
  if le reservation 0
    ret 11
  end
  if ne mapbind reservation neg int 1 0 1 neg long 9
    ret 12
  end
  note The following ar_guard reacquires that exact VA after the bind refused.
  put nvnext 0 68719476736
  if not ar_guard 0
    ret 6
  end
  clash = maphold 68719476736 4096
  if gt clash 0
    ret 7
  end
  put ar_code_model 0 arboris_magic
  if ar_unmap
    ret 9
  end
  if eq get ar_guards 0 0
    ret 10
  end
  put ar_code_model 0 0
  if not ar_unmap
    ret 8
  end
  ret 0
end

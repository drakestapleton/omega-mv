note SPDX-License-Identifier: AGPL-3.0-only
note Four standard somas (including one empty) and one four-warp hub. Both
note paths encounter ordered child compartments, signed inputs and sigmoid.
text ps_halves "matching_fp16_elements="
text ps_mismatch "first_mismatching_pair="
text ps_expected "expected_pair="
text ps_actual "actual_pair="
fn probe_model_meta m edit ulong 16 to void
  put m 0 arboris_magic
  put m 1 5
  put m 2 9
  put m 3 9
  put m 4 probe_dim
  put m 5 4
  put m 10 mul 56 probe_dim
end

fn gated_topology words edit uint 34 to void
  put words 1 3
  put words 2 3
  put words 3 4
  put words 4 5
  put words 5 9
  for i ulong 10
    put words add i 6 uint i
  end
  put words 8 1
  for i ulong 9
    put words add i 16 uint rem i 5
  end
  put words 26 0x1000000
  put words 27 0x1000000
  put words 28 2
  put words 29 3
  put words 30 4
  put words 31 0x1000004
  put words 32 0x2000004
  put words 33 4
end

fn gv_test_half i ulong slab ulong to ulong
  if eq slab 3
    if eq rem i 3 0
      ret 0xb800
    end
    ret 0x3800
  end
  row = div i probe_dim
  if lt row 9
    ret 0x3800
  end
  if lt row 18
    if eq rem i 3 0
      ret 0xb400
    end
    ret 0x3800
  end
  ret 0x3c00
end

fn probe_fill m view ulong 16 i ulong tok long to bool
  csr = new uint 34 0
  if eq i 0
    for j ulong 16
      if ne mapset tok mul j 8 8 get m j 0
        ret false
      end
    end
  end
  if eq i 1
    gated_topology csr
    for j ulong len csr
      if ne mapset tok mul j 4 4 ulong get csr j 0
        ret false
      end
    end
  end
  if or eq i 2 eq i 3
    pairs = mul 14 probe_dim
    if eq i 3
      pairs = div mul 5 probe_dim 2
    end
    for j ulong pairs
      low = gv_test_half mul j 2 i
      high = gv_test_half add mul j 2 1 i
      if ne mapset tok mul j 4 4 or low shl high 16 0
        ret false
      end
    end
  end
  ret true
end

fn gv_copy_extent storage edit ushort * tok long base ulong words ulong to void
  for j ulong words bound 4096
    value = mapget tok mul j 4 4
    off = add base mul j 2
    put storage off ushort and value 65535
    put storage add off 1 ushort shr value 16
  end
end

fn gv_expected m view ulong 16 offsets view ulong 6 expected edit ushort 1320 to int
  storage = new ushort 28672 0
  if lt mul len storage 2 get m 12
    ret 36
  end
  for i ulong 4
    words = div ar_region_bytes m offsets i 4
    base = div get offsets i 2
    gv_copy_extent storage get ar_maps i base words
  end
  if ne arboris_gated_tick m offsets part storage 0 div get m 12 2 4096 0
    ret 37
  end
  for i ulong mul 5 probe_dim
    put expected i get storage add div get offsets 4 2 i
  end
  ret 0
end

fn gv_check_output m view ulong 16 offsets view ulong 6 to int
  ref = new ushort 1320 0
  rc = gv_expected m offsets ref
  if ne rc 0
    ret rc
  end
  for i ulong div mul 5 probe_dim 2
    actual = mapget get ar_maps 4 mul i 4 4
    expected = ag_u32 ref 0 i
    if ne expected actual
      probe_log ps_mismatch i
      probe_log ps_expected expected
      probe_log ps_actual actual
      ret 38
    end
  end
  probe_log ps_halves mul 5 probe_dim
  ret 0
end


fn probe_run table long h view ulong 2 m edit ulong 16 to int
  offsets = new ulong 6 0
  if ne arboris_plan_arena m 1048576 4096 offsets 0
    ret 1
  end
  if not caproot_validate table 42 h m
    ret 2
  end
  rc = probe_import m offsets
  if ne rc 0
    ret rc
  end
  if not ar_gated_open m 4
    ret 22
  end
  if not probe_arm_signer table m h 0
    ret 47
  end
  hop = ar_gated_hop table 42 h m
  probe_log ps_rc hop
  if ne hop 0
    ret 23
  end
  rc = gv_check_output m offsets
  if ne rc 0
    ret rc
  end
  hashes = new uchar 96 0
  if not ar_step_digests m get nvret 0 hashes
    ret 35
  end
  probe_digest ps_input part hashes 0 32
  probe_digest ps_code part hashes 32 32
  probe_digest ps_output part hashes 64 32
  if not probe_witness table m h
    ret 39
  end
  ret 0
end

fn gv_print_reference ref view ushort 1320 to void
  data = new uchar 2640 0
  for i ulong mul 5 probe_dim
    put data mul i 2 uchar and get ref i 255
    put data add mul i 2 1 uchar shr get ref i 8
  end
  ctx = new ulong 40 0
  hash = new uchar 32 0
  sha256_init ctx
  sha256_update ctx part data 0 mul 10 probe_dim
  sha256_final ctx hash
  probe_digest ps_output hash
end

note Host preflight over anonymous CPU mappings. Exercise both scheduling
note ranges, a malformed parent depth and an undersized shared memory budget.
fn probe_reference to int
  m = new ulong 16 0
  offsets = new ulong 6 0
  probe_model_meta m
  if ne arboris_plan_arena m 1048576 4096 offsets 0
    ret 40
  end
  for i ulong 6
    tok = mapnew neg int 1 0 ar_region_bytes m offsets i 3 34
    if le tok 0
      ret 41
    end
    put ar_maps i tok
    if not probe_fill m i tok
      ret 42
    end
  end
  if not ar_gv_rows m 4
    ret 43
  end
  saved = get m 13
  put m 13 32
  if ar_gv_rows m 4
    ret 44
  end
  put m 13 saved
  changed = mapset get ar_maps 1 104 4 0x2000000
  if ar_gv_rows m 4
    ret 45
  end
  changed = mapset get ar_maps 1 104 4 0x1000000
  ref = new ushort 1320 0
  rc = gv_expected m offsets ref
  if ne rc 0
    ret rc
  end
  gv_print_reference ref
  for i ulong 6
    if ne mapdrop get ar_maps i 0
      ret 46
    end
  end
  ret 0
end

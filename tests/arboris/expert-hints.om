note SPDX-License-Identifier: AGPL-3.0-only
fn main to int
  topo = new uint 10 0
  weights = new uint 2 0
  state = new uint 12 0
  experts = new uint 4 0
  hints = new uint 4 0
  put topo 0 ar_topo_v1
  put topo 1 4
  put topo 2 2
  put topo 5 1
  put topo 6 2
  put topo 7 2
  put weights 0 ar_one
  put weights 1 ar_one
  put state 0 1
  put state 2 0x3f000000
  put state 4 ar_one
  put experts 0 0xffffffff
  put experts 1 383
  put experts 2 12
  put experts 3 12
  if ne arboris_relax_step topo weights state 0
    ret 1
  end
  count = arboris_expert_hints part state 8 4 experts hints
  if ne count 2
    ret 2
  end
  if or ne get hints 1 12 ne get hints 3 383
    ret 3
  end
  put experts 0 384
  if ne arboris_expert_hints part state 8 4 experts hints long -1
    ret 4
  end
  if not arboris_send_hints 1 hints ulong count
    ret 5
  end
  ret 0
end

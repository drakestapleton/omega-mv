note SPDX-License-Identifier: AGPL-3.0-only
note Exercises only the host fixture directory supplied by the gate.
fn main to int
  body = new uchar 65536 0
  policy = new uchar 136 0
  for i ulong 8
    put policy i get as_domain i
    put body i get as_domain i
  end
  if not as_allowed body policy
    ret 1
  end
  put policy 127 1
  if as_allowed body policy
    ret 2
  end
  put policy 127 0
  put policy 135 1
  if as_allowed body policy
    ret 3
  end
  record = new uchar 248 17
  if not as_record record
    ret 4
  end
  if not as_record record
    ret 5
  end
  hash = new uchar 32 0
  ctx = new ulong 40 0
  sha256_init ctx
  sha256_update ctx record
  sha256_final ctx hash
  path = new uchar 64 0
  as_name hash path
  if not as_existing path record
    ret 6
  end
  put record 17 11
  if as_existing path record
    ret 7
  end
  ret 0
end

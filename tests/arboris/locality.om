note SPDX-License-Identifier: AGPL-3.0-only
note Four Entity records. Edges 0->1,0->3,3->0 (parallel),3->3
note give degrees 3,1,0,4. Distinct weights exercise payload alignment.
fn al_fixture records edit uint 34 to void
  put records 0 ar_record_v1
  put records 1 1
  put records 2 4
  put records 3 4
  put records 4 3
  put records 5 ar_one
  for i ulong 4
    pos = add 18 mul 4 i
    put records add pos 1 1
    put records add pos 3 sub ar_one uint shl i 21
  end
  put records 20 1
  put records 24 3
  put records 26 3
  put records 30 3
  put records 32 3
end

fn al_bank_matches a view uint 12 b view uint 12 plan view uint 12 to bool
  bank = add 4 mul 4 ulong get a 1
  for i ulong 4
    if ne get a add bank i get b add bank ulong get plan i
      ret false
    end
  end
  ret true
end

fn al_equivalent records view uint 34 packed view uint 34 plan view uint 12 to bool
  logical = new uint 16 0
  physical = new uint 16 0
  lw = new uint 8 0
  pw = new uint 8 0
  a = new uint 12 0
  b = new uint 12 0
  if or ne arboris_load_records records logical lw 0 ne arboris_load_records packed physical pw 0
    ret false
  end
  put a 0 1
  put b 0 1
  put a 2 0x3f000000
  put b 2 0x3f000000
  put a 5 ar_one
  put b add 4 ulong get plan 1 ar_one
  for hop ulong 3
    if or ne arboris_relax_step logical lw a 0 ne arboris_relax_step physical pw b 0
      ret false
    end
    if not al_bank_matches a b plan
      ret false
    end
  end
  ret true
end

fn al_test to int
  records = new uint 34 0
  packed = new uint 34 0
  plan = new uint 12 0
  order = new uint 4 0
  al_fixture records
  for i ulong 4
    put order i uint sub 3 i
  end
  if ne arboris_plan_locality records order plan 0
    ret 31
  end
  if or ne get plan 4 2 or ne get plan 5 1 or ne get plan 6 0 ne get plan 7 3
    ret 32
  end
  if or ne arboris_pack_locality records plan packed 0 not al_equivalent records packed plan
    ret 33
  end
  put plan 0 0
  put packed 0 17
  if or ne arboris_pack_locality records plan packed 2 ne get packed 0 17
    ret 34
  end
  put order 0 get order 1
  if ne arboris_plan_locality records order plan 3
    ret 35
  end
  note With two degree-one pairs, every vertex stays in the same degree band.
  put records 24 1
  put records 26 2
  put records 28 3
  put records 30 2
  put records 32 3
  put order 0 3
  if ne arboris_plan_locality records order plan 0
    ret 36
  end
  for i ulong 4
    if ne get plan add 4 i get order i
      ret 37
    end
  end
  ret 0
end

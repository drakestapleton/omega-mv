note SPDX-License-Identifier: AGPL-3.0-only
note Only the host fixture invokes this program. FD 3 is the issuer's table.
fn main to int
  data = new uchar 48 0
  if ne read 0 data 0 48 48
    ret 2
  end
  fields = new ulong 6 0
  for i ulong 6
    for j ulong 8
      octet = ulong get data add mul i 8 j
      put fields i or get fields i shl octet mul j 8
    end
  end
  h = new ulong 2 0
  put h 0 get fields 1
  put h 1 get fields 2
  meta = new ulong 16 0
  put meta 0 0x4152425200000001
  put meta 7 get fields 3
  put meta 8 get fields 4
  table = mapnew int 3 0 22560 1 1
  if le table 0
    ret 3
  end
  granted = caproot_validate table get fields 0 h meta
  if ne mapdrop table 0
    ret 4
  end
  if ne granted ne get fields 5 0
    ret 5
  end
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note Child opens an independent description of the same supervisor inode.
fn al_contender kind ulong to int
  inherited = fclose int get ar_compute_fd 0
  put ar_compute_kind 0 0
  if ar_claim_compute kind
    ret 1
  end
  ret 0
end
fn al_contention first ulong second ulong to bool
  if not ar_claim_compute first
    ret false
  end
  if ar_claim_compute first
    ret false
  end
  pid = fork
  if eq pid 0
    exit al_contender second
  end
  status = new uchar 4 0
  ok = false
  if gt pid 0
    if eq waitpid int pid status 0 4 0 pid
      ok = and eq get status 0 0 eq get status 1 0
    end
  end
  ar_drop_compute
  if not ar_claim_compute second
    ret false
  end
  ar_drop_compute
  ret ok
end
fn main to int
  if not al_contention 1 2
    ret 1
  end
  if not al_contention 2 1
    ret 2
  end
  ret 0
end

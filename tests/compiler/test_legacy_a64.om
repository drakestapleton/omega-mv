fn check_quick_arg to void
  if lt argcnt long 2
    ret
  end
  ab = new uchar 16 0
  n = argread ulong 1 ab ulong 0 ulong 16
  if ne n long 5
    ret
  end
  ok = true
  i = ulong 0
  while lt i 5 bound 5
    if ne get ab i get t_quick i
      ok = false
    end
    i = add i 1
  end
  if ok
    put g_quick 0 1
  end
end

fn check_buf_full to void
  b = new uchar 4 0
  put b 0 1
  put b 1 2
  put b 2 3
  put b 3 4
  put g_a64_pos 0 1
  put g_a64_max 0 4
  rc = aarch64_emit_ret b
  la_chk and eq rc -1 and eq get g_a64_pos 0 1 eq get b 1 2
end

fn run_all_diffs to void
  diff_reg3 0 1
  diff_reg3 1 2
  diff_reg3 2 3
  diff_reg3 3 4
  diff_reg3 4 5
  diff_reg3 5 6
  diff_reg3 6 19
  diff_mov_reg
  diff_movzk 0
  diff_movzk 1
  diff_ret
  diff_b
  diff_b_cond
  diff_cbz 0
  diff_cbz 1
  diff_adr
  diff_uoff 0
  diff_uoff 1
  diff_byte 0
  diff_byte 1
  diff_post 0
  diff_post 1
  diff_post 2
  diff_post 3
  diff_subs_imm
end

fn main to int
  put g_rng 0 ulong 748935568657743876
  check_quick_arg
  run_all_diffs
  diff_fail = get g_fail 0
  check_buf_full
  run_refusals_1
  run_refusals_2
  run_refusals_3
  la_os t_diff1
  if eq get g_quick 0 1
    la_os t_quick
  else
    la_os t_full
  end
  la_os t_diff2
  la_ou64 get g_words 0
  la_os t_diff3
  la_ou64 get g_decoded 0
  la_os t_diff4
  la_ou64 diff_fail
  la_os t_nl
  la_os t_ref1
  la_ou64 get g_ref_cases 0
  la_os t_ref2
  la_ou64 get g_ref_ok 0
  la_os t_nl
  la_os t_chk1
  la_ou64 get g_checks 0
  la_os t_chk2
  la_ou64 get g_fail 0
  la_os t_nl
  if eq get g_fail 0 0
    la_os t_pass
    la_flush
    ret 0
  end
  la_os t_fail
  la_flush
  ret 1
end

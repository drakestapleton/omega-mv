note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r13_cortex_episode.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r13_cortex_episode.c (R13 Cortex episode recording).
note Verifies whole-World and scoped Cortex attachment, episode crumb
note ingestion (CREATE -> EXTERNAL -> COMMIT), provenance chain walk,
note candidate/evidence promotion, and recall of latest committed result.

global r13e_checks ulong 1
global r13e_fail ulong 1

text r13e_pass "RX_R13_CORTEX_EPISODE_OM: PASS\n"
text r13e_fail_m "RX_R13_CORTEX_EPISODE_OM: FAIL\n"

fn r13e_chk cond bool to void
  put r13e_checks 0 add get r13e_checks 0 1
  if not cond
    if eq get r13e_fail 0 0
      put r13e_fail 0 get r13e_checks 0
    end
  end
end

fn r13e_reset_crumb to void
  for i ulong 16
    put rxcx_cm i 0
  end
  for i ulong 4
    put rxcx_par i 0
  end
  for i ulong 8
    put rxcx_fld i 0
  end
  for i ulong 32
    put rxcx_dig i 0
  end
end

fn r13e_test_episode_and_provenance to void
  r13e_chk eq cx_init 0 80 CX_OK
  r13e_chk eq cx_init 1 80 CX_OK
  rx_cx_hub_init

  note Attach whole-world store 0 and scoped store 1 (obj 3, gen 1 -> subject 12)
  r13e_chk eq rx_cx_attach 0 101 RXCX_OK
  sc = new ulong 24 0
  put sc 0 3
  put sc 1 1
  put sc 2 12
  r13e_chk eq rx_cx_attach_scoped 1 101 sc 1 RXCX_OK

  note Crumb 1: CREATE obj 3 gen 1
  r13e_reset_crumb
  put rxcx_cm 0 1
  put rxcx_cm 1 RX_CRUMB_CREATE
  put rxcx_cm 6 1
  put rxcx_cm 7 3
  put rxcx_cm 8 1
  put rxcx_cm 9 1
  put rxcx_fld 0 10
  rx_cx_record_crumb
  id1 = rx_cx_record_in 1 0 1
  r13e_chk eq id1 1
  r13e_chk eq rx_cx_record_in 1 1 1 1

  note Crumb 2: EXTERNAL trigger on obj 3 gen 1 (parent = crumb 1)
  r13e_reset_crumb
  put rxcx_cm 0 2
  put rxcx_cm 1 RX_CRUMB_EXTERNAL
  put rxcx_cm 6 1
  put rxcx_cm 7 3
  put rxcx_cm 8 1
  put rxcx_cm 9 1
  put rxcx_cm 10 1
  put rxcx_fld 0 55
  rx_cx_record_crumb
  id2 = rx_cx_record_in 1 0 2
  r13e_chk eq id2 2

  note Crumb 3: COMMIT result on obj 3 gen 1 (wake_cause = crumb 2)
  r13e_reset_crumb
  put rxcx_cm 0 3
  put rxcx_cm 1 RX_CRUMB_COMMIT
  put rxcx_cm 6 1
  put rxcx_cm 7 3
  put rxcx_cm 8 1
  put rxcx_cm 9 1
  put rxcx_cm 10 2
  put rxcx_fld 0 777
  rx_cx_record_crumb
  id3 = rx_cx_record_in 1 0 3
  r13e_chk eq id3 3
  r13e_chk eq rx_cx_record_in 1 1 3 3

  note Verify chain integrity and provenance walk from id3 back to id2 and id1
  r13e_chk eq cx_verify_chain 0 CX_OK
  r13e_chk eq cx_verify_chain 1 CX_OK
  prov = new ulong 16 0
  np = cx_provenance 0 id3 prov
  r13e_chk ge np 2
  r13e_chk eq rx_cx_recall_result 0 3 id3

  note Detach cleanly
  r13e_chk eq rx_cx_detach_store 1 RXCX_OK
  r13e_chk eq rx_cx_detach RXCX_OK
  cx_close 1
  cx_close 0
end

fn r13e_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len r13e_pass
    for i ulong n bound 64
      put buf i get r13e_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len r13e_fail_m
  for i ulong n bound 64
    put buf i get r13e_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  r13e_test_episode_and_provenance
  if ne get r13e_fail 0 0
    r13e_put_msg 0
    ret int get r13e_fail 0
  end
  r13e_put_msg 1
  ret 0
end

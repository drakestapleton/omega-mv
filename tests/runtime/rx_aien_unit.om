note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_aien_unit.om -- Pure seeded OM-2 unit test for rx_aien.om.

global ai_checks ulong 1
global ai_fail ulong 1

text ai_msg_pass "RX_AIEN_OM: PASS\n"
text ai_msg_fail "RX_AIEN_OM: FAIL\n"

fn ai_chk cond bool to void
  put ai_checks 0 add get ai_checks 0 1
  if not cond
    put ai_fail 0 add get ai_fail 0 1
  end
end

fn test_config_and_keys to void
  rx_aien_default_config
  ai_chk eq get ai_cfg 0 4
  ai_chk eq get ai_cfg 1 20
  ai_chk eq get ai_cfg 2 2
  ai_chk eq get ai_cfg 3 4
  ai_chk eq get ai_cfg 4 8
  ai_chk eq rx_aien_config_ok 0
  put ai_cfg 1 100
  ai_chk eq rx_aien_config_ok -1
  reg = rx_aien_regime 64 128
  ai_chk eq shr reg 32 64
  ai_chk eq and reg 4294967295 128
  k1 = rx_aien_key 10 reg
  k2 = rx_aien_key 11 reg
  ai_chk ne k1 k2
  ai_chk eq rx_aien_within 110 100 20 1
  ai_chk eq rx_aien_within 121 100 20 0
  ai_chk eq rx_aien_within 80 100 20 1
  ai_chk eq rx_aien_within 79 100 20 0
end

fn test_cognitive_loop to void
  rx_aien_reset
  put ai_cfg 0 2
  put ai_cfg 1 20
  put ai_cfg 2 2
  put ai_cfg 3 2
  put ai_cfg 4 10
  reg = rx_aien_regime 32 64
  put ai_sel 0 1
  put ai_sel 1 777
  put ai_sel 6 reg
  put ai_pl 1 3340
  put ai_dem 4 32
  put ai_dem 5 64
  put ai_dem 6 777
  note First observe resets belief for epoch 1
  put ai_dem 0 0
  put ai_dem 1 0
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 0 1
  note Warmup interval (seen 0 -> 1)
  put ai_dem 0 10
  put ai_dem 1 10000
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 5 1
  note Baseline interval 1: mean = 1000
  put ai_dem 0 20
  put ai_dem 1 20000
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 4 1000
  ai_chk eq get ai_belief 5 2
  note Baseline interval 2: mean = 1000, seen = 3
  put ai_dem 0 30
  put ai_dem 1 30000
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 4 1000
  ai_chk eq get ai_belief 5 3
  note Predict creates HOLDING prediction
  ai_chk eq rx_aien_predict 1
  ai_chk eq get ai_pred 0 1
  ai_chk eq get ai_pred 5 1000
  ai_chk eq get ai_pred 6 RX_AIEN_PRED_HOLDING
  note Two hit intervals confirm prediction
  put ai_dem 0 40
  put ai_dem 1 40500
  ai_chk eq rx_aien_observe 1
  ai_chk eq rx_aien_predict 1
  ai_chk eq get ai_pred 3 1
  put ai_dem 0 50
  put ai_dem 1 50500
  ai_chk eq rx_aien_observe 1
  ai_chk eq rx_aien_predict 1
  ai_chk eq get ai_pred 6 RX_AIEN_PRED_CONFIRMED
  note Assess with goal target=500 -> UNMET, then plan publishes research
  put ai_goal 0 1
  put ai_goal 1 reg
  put ai_goal 2 500
  ai_chk eq rx_aien_assess 1
  ai_chk eq get ai_assess 4 RX_AIEN_GOAL_UNMET
  ai_chk eq rx_aien_plan 1
  ai_chk eq get ai_plan 0 1
  ai_chk eq get ai_plan 5 RX_AIEN_WHY_GOAL
  ai_chk eq get ai_mem 0 1
  note Core class moves and 2 misses fail prediction -> explain forms CORE_CLASS hypothesis
  put ai_pl 1 3341
  put ai_dem 0 60
  put ai_dem 1 70500
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 7 1
  put ai_dem 0 70
  put ai_dem 1 90500
  ai_chk eq rx_aien_observe 1
  ai_chk eq get ai_belief 7 2
  ai_chk eq rx_aien_predict 1
  ai_chk eq get ai_pred 6 RX_AIEN_PRED_FAILED
  ai_chk eq rx_aien_explain 1
  ai_chk eq get ai_hyp 1 RX_AIEN_HYP_CORE_CLASS
  ai_chk eq get ai_hyp 7 RX_AIEN_HYP_OPEN
  note Plan emits research for new core class and sets HYP_TESTING
  ai_chk eq rx_aien_plan 1
  ai_chk eq get ai_plan 0 2
  ai_chk eq get ai_plan 5 RX_AIEN_WHY_CORE_CLASS
  ai_chk eq get ai_hyp 7 RX_AIEN_HYP_TESTING
end

fn test_experiment_and_seed to void
  rx_aien_reset
  keys = new ulong 2 0
  put keys 0 111
  put keys 1 222
  ai_chk eq rx_aien_seed_explored keys 2 0
  ai_chk eq rx_aien_explored 111 1
  ai_chk eq rx_aien_explored 222 1
  ai_chk eq rx_aien_explored 333 0
  put ai_ev 0 1
  put ai_ev 1 42
  put ai_ev 2 42
  put ai_ev 3 1
  put ai_ev 4 5
  ai_chk eq rx_aien_experiment 1
  ai_chk eq get ai_exp 2 RX_AIEN_EXP_SUPPORTED
  ai_chk eq get ai_exp 3 5
  note Refuted experiment
  put ai_ev 0 2
  put ai_ev 2 99
  put ai_ev 3 0
  ai_chk eq rx_aien_experiment 1
  ai_chk eq get ai_exp 2 RX_AIEN_EXP_REFUTED
end

fn ai_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len ai_msg_pass
    for i ulong n bound 64
      put buf i get ai_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len ai_msg_fail
  for i ulong n bound 64
    put buf i get ai_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_config_and_keys
  test_cognitive_loop
  test_experiment_and_seed
  if eq get ai_fail 0 0
    ai_put_msg 1
    ret 0
  end
  ai_put_msg 0
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_skillroute_compose_test.om -- Pure seeded OM-2 port of
note tests/runtime/rx_skillroute_compose_test.c (COMPOSITION-2 WP-D).
note End-to-end alias -> cq_compile -> providers -> Skill -> bind_route -> route_check,
note plus fail-closed modes (a)-(f) and sr_route_alternatives.

const SRC_OP_SCALE ulong 1
const SRC_OP_SCALE_FAST ulong 2
const SRC_OP_SUMMARIZE ulong 3
const SRC_ALIAS_SCALE ulong 501
const SRC_NOW_US ulong 1000000
const SRC_UNBOUND_MACH ulong 1000

global src_checks ulong 1
global src_fail ulong 1

text src_pass "RX_SKILLROUTE_COMPOSE_OM: PASS\n"
text src_fail_m "RX_SKILLROUTE_COMPOSE_OM: FAIL\n"

fn src_chk cond bool to void
  put src_checks 0 add get src_checks 0 1
  if not cond
    if eq get src_fail 0 0
      put src_fail 0 get src_checks 0
    end
  end
end

fn src_make_ent ent edit ulong 21 cap ulong op ulong real ulong cost ulong lat ulong to void
  for i ulong 21
    put ent i 0
  end
  put ent 0 cap
  put ent 1 real
  put ent 4 op
  put ent 6 2
  put ent 7 1
  put ent 8 1
  put ent 9 2
  put ent 12 900000
  put ent 13 990000
  put ent 14 cost
  put ent 15 lat
  put ent 16 100
  put ent 18 CQ_LIVE_AVAILABLE
  put ent 20 1
end

fn src_fx_init out_b edit ulong 1 to void
  mid_a = new uchar 32 0
  put mid_a 0 uchar 1
  mid_b = new uchar 32 0
  put mid_b 0 uchar 2
  src_chk eq cq_catalog_init_canonical 1 mid_a CQ_OK
  src_chk eq cq_machine_advertise_id 1 mid_b add SRC_NOW_US 1000000 out_b CQ_OK
  src_chk eq cq_machine_advertise SRC_UNBOUND_MACH add SRC_NOW_US 1000000 CQ_OK
  src_chk eq cq_op_define SRC_OP_SCALE 0 CQ_SRC_ALL CQ_OK
  src_chk eq cq_op_define SRC_OP_SCALE_FAST SRC_OP_SCALE CQ_SRC_ALL CQ_OK
  src_chk eq cq_op_define SRC_OP_SUMMARIZE 0 CQ_SRC_ALL CQ_OK
  src_chk eq cq_alias SRC_ALIAS_SCALE SRC_OP_SCALE CQ_OK

  sr_skills_reset
  d7 = new uchar 32 0
  put d7 0 uchar 7
  d9 = new uchar 32 0
  put d9 0 uchar 9
  d11 = new uchar 32 0
  put d11 0 uchar 17
  d12 = new uchar 32 0
  put d12 0 uchar 18
  src_chk eq sr_skills_add 7 d7 SR_OK
  src_chk eq sr_skills_add 9 d9 SR_OK

  ent = new ulong 21 0
  src_make_ent ent 1 SRC_OP_SCALE 70 10 100
  src_chk eq sr_register_skill 7 1 1 d7 ent SR_OK
  src_make_ent ent 2 SRC_OP_SCALE 90 20 200
  src_chk eq sr_register_skill 9 1 1 d9 ent SR_OK
  src_make_ent ent 3 SRC_OP_SCALE_FAST 110 30 300
  src_chk eq sr_register_skill 11 4 get out_b 0 d11 ent SR_OK
  src_make_ent ent 4 SRC_OP_SUMMARIZE 120 5 50
  src_chk eq sr_register_skill 12 1 SRC_UNBOUND_MACH d12 ent SR_OK
  src_chk eq cq_catalog_build CQ_OK
end

fn src_make_need need edit ulong 15 tr edit ulong 19 op ulong to void
  for i ulong 15
    put need i 0
  end
  for i ulong 19
    put tr i 0
  end
  put need 0 op
  put need 1 1
  put need 2 2
  put need 3 1
  put tr 0 2
  put tr 1 0
  put tr 2 1
end

fn src_test_e2e_and_alts to void
  bm = new ulong 1 0
  src_fx_init bm
  need = new ulong 15 0
  tr = new ulong 19 0
  src_make_need need tr SRC_ALIAS_SCALE
  rpin = new ulong 5 0
  put rpin 0 1
  pdig = new uchar 32 0

  note End-to-end: route picks skill 7 (cost=10 < skill 9 cost=20), binds AG_SKILL node
  src_chk eq sr_route need tr rpin pdig SRC_NOW_US SR_OK
  src_chk eq get sr_out_meta 8 7
  src_chk eq get sr_out_meta 3 1
  src_chk eq get sr_out_meta 4 1
  src_chk eq get sr_out_meta 1 0
  src_chk eq get sr_out_meta 2 1
  src_chk eq sr_route_check 0 SRC_NOW_US SR_OK

  rx_graph_init 0 0
  k = rx_graph_node 0 AG_CONST AG_T_U64
  sn = rx_graph_node 0 AG_SKILL AG_T_U64
  src_chk ge k 0
  src_chk ge sn 0
  src_chk eq sr_bind_route 0 ulong sn 0 SRC_NOW_US SR_OK
  src_chk eq rx_graph_get_node 0 ulong sn 2 7

  note Alternatives returns both skill 7 and dominated skill 9, out[0] == sr_route
  src_chk eq sr_route_alternatives need tr rpin pdig SRC_NOW_US 4 2
  src_chk eq get sr_out_meta 8 7
  src_chk eq get sr_out_meta 18 9
end

fn src_test_fail_closed to void
  bm = new ulong 1 0
  src_fx_init bm
  need = new ulong 15 0
  tr = new ulong 19 0
  src_make_need need tr SRC_OP_SCALE
  rpin = new ulong 5 0
  put rpin 0 1
  pdig = new uchar 32 0
  src_chk eq sr_route need tr rpin pdig SRC_NOW_US SR_OK

  note (c) provider unavailable -> SR_E_UNAVAILABLE
  src_chk eq cq_set_availability 1 70 1 7 CQ_LIVE_UNAVAILABLE CQ_OK
  src_chk eq sr_route_check 0 SRC_NOW_US SR_E_UNAVAILABLE
  src_chk eq cq_set_availability 1 70 1 7 CQ_LIVE_AVAILABLE CQ_OK
  src_chk eq sr_route_check 0 SRC_NOW_US SR_OK

  note (a) provider withdrawn -> SR_E_WITHDRAWN
  src_chk eq cq_withdraw 1 70 1 7 CQ_OK
  src_chk eq sr_route_check 0 SRC_NOW_US SR_E_WITHDRAWN

  note (e) skill version pin mismatch -> SR_E_NO_CANDIDATE with SR_WHY_PIN
  put rpin 1 99
  src_chk eq sr_route need tr rpin pdig SRC_NOW_US SR_E_NO_CANDIDATE
  src_chk ne and get sr_out_why 0 SR_WHY_PIN 0

  note (d) unknown/unbound machine -> refused (SR_E_NO_CANDIDATE)
  put rpin 0 0
  put rpin 1 0
  src_make_need need tr SRC_OP_SUMMARIZE
  src_chk eq sr_route need tr rpin pdig SRC_NOW_US SR_E_NO_CANDIDATE
end

fn src_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len src_pass
    for i ulong n bound 64
      put buf i get src_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len src_fail_m
  for i ulong n bound 64
    put buf i get src_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  src_test_e2e_and_alts
  src_test_fail_closed
  if eq get src_fail 0 0
    src_put_msg 1
    ret 0
  end
  src_put_msg 0
  ret 1
end

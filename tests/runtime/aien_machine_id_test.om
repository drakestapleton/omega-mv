note
note tests/runtime/aien_machine_id_test.om -- canonical machine identity tests (M20).
note Composed after seed/ng/sha256.om and src/runtime/aien_machine_id.om.

text t_kat_prov  "b3d2c32ee1a3ef5803e1cc604943dc8189fda2f5ea90bb5158eecc0acf5ff366"
text t_kat_hw    "f7492de96e80c47f2e160f34ca2137b2ea2e5baa75a6e2c8924a8ae479ec9db1"
text t_kat_forge "063af610c67991c10e693c5e48dd28662b8b057ae4b54a9e344949f6f4a2c2b7"
text t_root_prov "aien-m20-kat-provisioned-root"
text t_root_hw32 "0123456789abcdef0123456789abcdef"
text t_path_rt   "/tmp/aien_mid_om_rt_test.bin"
text t_path_bad  "/tmp/aien_mid_om_bad_test.bin"
text t_kat_arg   "--kat-text"
text t_msg_pre   "aien_machine_id: "
text t_msg_mid   " checks passed\n"
text t_msg_pass  "M20_MACHINE_IDENTITY_PASS\n"
text t_msg_fail  "FAIL test "

global g_mt_chk  int   2
global g_mt_arg  uchar 64
global g_mt_out  uchar 256
global g_mt_olen ulong 1
global g_mt_tmpd uchar 24
global g_mt_path uchar 64
global g_mt_rec  uchar 44
global g_mt_io   uchar 88

fn mt_out_c c uchar to void
  n = get g_mt_olen 0
  if lt n 256
    put g_mt_out n c
    put g_mt_olen 0 add n 1
  end
end

fn mt_out_flush fd int to void
  n = get g_mt_olen 0
  if gt n 0
    ign = write fd g_mt_out 0 n
    put g_mt_olen 0 0
  end
end

fn mt_out_u v ulong to void
  if eq v 0
    mt_out_c uchar 48
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_mt_tmpd n uchar add 48 rem x 10
    n = add n 1
    x = div x 10
  end
  while gt n 0
    n = sub n 1
    mt_out_c get g_mt_tmpd n
  end
end

fn mt_chk cond bool id int to void
  put g_mt_chk 0 add get g_mt_chk 0 1
  if not cond
    put g_mt_chk 1 add get g_mt_chk 1 1
    put g_mt_olen 0 0
    for i ulong 10
      mt_out_c get t_msg_fail i
    end
    mt_out_u ulong id
    mt_out_c uchar 10
    mt_out_flush 2
  end
end

fn mt_unhex64 src view uchar 64 dst edit uchar 32 to void
  for i ulong 32
    hi = mid_hex_nib get src mul i 2
    lo = mid_hex_nib get src add mul i 2 1
    put dst i uchar or shl uint hi 4 uint lo
  end
end

fn mt_eq32 a view uchar 33 b view uchar 32 to int
  for i ulong 32
    if ne get a add 1 i get b i
      ret 0
    end
  end
  ret 1
end

fn mt_eq44 a view uchar 44 b view uchar 44 to int
  for i ulong 44
    if ne get a i get b i
      ret 0
    end
  end
  ret 1
end

fn mt_test_derive to void
  root = new uchar 4096 0
  m = new uchar 33 0
  a = new uchar 33 0
  b = new uchar 33 0
  w = new uchar 32 0
  for i ulong 29
    put root i get t_root_prov i
  end
  rc = aien_mid_derive 1 view root 29 edit m
  mt_chk eq rc 0 1
  mt_unhex64 view t_kat_prov edit w
  mt_chk ne mt_eq32 view m view w 0 2
  mt_chk eq get m 0 1 3
  rc2 = aien_mid_derive 1 view root 29 edit a
  mt_chk eq rc2 0 4
  mt_chk ne aien_mid_equal view m view a 0 5
  mt_chk eq aien_mid_hash view m aien_mid_hash view a 6

  for i ulong 32
    put root i uchar 0xa5
  end
  rc3 = aien_mid_derive 2 view root 32 edit b
  mt_chk eq rc3 0 7
  mt_unhex64 view t_kat_hw edit w
  mt_chk ne mt_eq32 view b view w 0 8
  mt_chk eq get b 0 2 9
  mt_chk eq aien_mid_equal view m view b 0 10

  mt_chk eq aien_mid_derive 2 view root 31 edit b sub int 0 1 11
  mt_chk eq aien_mid_derive 1 view root 0 edit b sub int 0 1 12
  mt_chk eq aien_mid_derive 3 view root 32 edit b sub int 0 1 13
  mt_chk eq aien_mid_derive 0 view root 32 edit b sub int 0 1 14
end

fn mt_test_roundtrip to void
  root = new uchar 4096 0
  m = new uchar 33 0
  d = new uchar 33 0
  rec = new uchar 44 0
  rec2 = new uchar 44 0
  bad = new uchar 48 0
  txt = new uchar 88 0
  txt96 = new uchar 96 0
  path = new uchar 4096 0
  for i ulong 29
    put root i get t_root_prov i
  end
  ign = aien_mid_derive 1 view root 29 edit m
  mt_chk eq aien_mid_encode view m edit rec 0 20
  hdr_ok = int 1
  if ne get rec 0 65
    hdr_ok = int 0
  end
  if ne get rec 1 77
    hdr_ok = int 0
  end
  if ne get rec 2 73
    hdr_ok = int 0
  end
  if ne get rec 3 68
    hdr_ok = int 0
  end
  if ne get rec 4 1
    hdr_ok = int 0
  end
  if ne get rec 5 1
    hdr_ok = int 0
  end
  if ne get rec 6 0
    hdr_ok = int 0
  end
  if ne get rec 7 0
    hdr_ok = int 0
  end
  mt_chk ne hdr_ok 0 21
  for i ulong 44
    put bad i get rec i
  end
  mt_chk eq aien_mid_decode view bad 44 edit d 0 22
  mt_chk ne aien_mid_equal view m view d 0 23
  mt_chk eq get d 0 get m 0 24
  mt_chk eq aien_mid_encode view d edit rec2 0 25
  mt_chk ne mt_eq44 view rec view rec2 0 26

  mt_chk eq aien_mid_to_text view m edit txt 0 27
  for i ulong 88
    put txt96 i get txt i
  end
  mt_chk eq aien_mid_from_text view txt96 88 edit d 0 28
  mt_chk ne aien_mid_equal view m view d 0 29
  mt_chk eq get d 0 get m 0 30

  for i ulong 28
    put path i get t_path_rt i
    put g_mt_path i get t_path_rt i
  end
  mt_chk eq aien_mid_store view path 28 view m 0 31
  for i ulong 33
    put d i uchar 0
  end
  mt_chk eq aien_mid_load view path 28 edit d 0 32
  mt_chk ne aien_mid_equal view m view d 0 33
  mt_chk eq get d 0 get m 0 34
  ign_u = unlink g_mt_path 0 28
end

fn mt_test_eq_hash to void
  root = new uchar 4096 0
  s = new uchar 32 0
  a = new uchar 33 0
  b = new uchar 33 0
  c = new uchar 33 0
  mt_unhex64 view t_kat_prov edit s
  ign = aien_mid_from_slot view s edit a
  for i ulong 29
    put root i get t_root_prov i
  end
  ign = aien_mid_derive 1 view root 29 edit b
  mt_chk eq get a 0 3 40
  mt_chk eq get b 0 1 41
  mt_chk ne aien_mid_equal view a view b 0 42
  mt_chk eq aien_mid_compare view a view b 0 43
  mt_chk eq aien_mid_hash view a ulong 0xb3d2c32ee1a3ef58 44
  mt_chk eq aien_mid_hash view a aien_mid_hash view b 45
  for i ulong 33
    put c i get a i
  end
  put c 32 xor get c 32 uchar 1
  mt_chk eq aien_mid_equal view a view c 0 46
  mt_chk ne aien_mid_compare view a view c 0 47
  for i ulong 33
    put c i get a i
  end
  put c 1 xor get c 1 uchar 1
  mt_chk ne aien_mid_hash view a aien_mid_hash view c 48
end

fn mt_test_conv to void
  root = new uchar 4096 0
  s = new uchar 32 0
  w = new uchar 32 0
  m = new uchar 33 0
  a = new uchar 33 0
  b = new uchar 33 0
  c = new uchar 33 0
  d = new uchar 33 0
  mt_unhex64 view t_kat_forge edit s
  mt_chk eq aien_mid_from_slot view s edit m 0 50
  mt_chk eq get m 0 3 51
  aien_mid_to_slot view m edit w
  eqs = int 1
  for i ulong 32
    if ne get s i get w i
      eqs = int 0
    end
  end
  mt_chk ne eqs 0 52
  for i ulong 32
    put s i uchar 0
  end
  mt_chk eq aien_mid_from_slot view s edit m sub int 0 2 53

  aien_mid_index_init 2
  put root 0 uchar 120
  ign = aien_mid_derive 1 view root 1 edit a
  put root 0 uchar 121
  ign = aien_mid_derive 1 view root 1 edit b
  put root 0 uchar 122
  ign = aien_mid_derive 1 view root 1 edit c
  mt_chk eq aien_mid_index_bind view a 1 54
  mt_chk eq aien_mid_index_bind view b 2 55
  mt_chk eq aien_mid_index_bind view a 1 56
  mt_chk eq aien_mid_index_bind view c 0 57
  mt_chk eq aien_mid_index_find view b 2 58
  mt_chk eq aien_mid_index_find view c 0 59
  mt_chk eq aien_mid_index_get 2 edit d 0 60
  mt_chk ne aien_mid_equal view d view b 0 61
  mt_chk eq aien_mid_index_get 0 edit d sub int 0 1 62
  mt_chk eq aien_mid_index_get 3 edit d sub int 0 1 63
  for i ulong 33
    put c i uchar 0
  end
  put c 0 uchar 3
  mt_chk eq aien_mid_index_bind view c 0 64
end

fn mt_copy_rec bad edit uchar 48 to void
  for i ulong 44
    put bad i get g_mt_rec i
  end
end

fn mt_test_malformed_dec m view uchar 33 to void
  d = new uchar 33 0
  bad = new uchar 48 0
  txt = new uchar 88 0
  txt96 = new uchar 96 0

  mt_copy_rec edit bad
  mt_chk eq aien_mid_decode view bad 43 edit d sub int 0 3 70
  put bad 44 uchar 0
  mt_chk eq aien_mid_decode view bad 45 edit d sub int 0 3 71
  mt_copy_rec edit bad
  put bad 0 uchar 88
  mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 3 72
  mt_copy_rec edit bad
  put bad 4 uchar 2
  mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 3 73
  mt_copy_rec edit bad
  put bad 5 uchar 9
  mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 3 74
  mt_copy_rec edit bad
  put bad 7 uchar 1
  mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 3 75

  i = ulong 8
  while lt i 44
    mt_copy_rec edit bad
    put bad i xor get bad i uchar 0x10
    mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 4 76
    i = add i 1
  end

  mt_copy_rec edit bad
  for k ulong 32
    put bad add 8 k uchar 0
  end
  for k ulong 40
    put sh_dat k get bad k
  end
  sh_all 40
  for k ulong 4
    put bad add 40 k get sh_dig k
  end
  mt_chk eq aien_mid_decode view bad 44 edit d sub int 0 2 77

  ign = aien_mid_to_text view m edit txt
  for k ulong 88
    put txt96 k get txt k
  end
  put txt96 10 uchar 71
  mt_chk eq aien_mid_from_text view txt96 88 edit d sub int 0 3 78
  for k ulong 88
    put txt96 k get txt k
  end
  done = int 0
  for k ulong 88
    if eq done 0
      c = get txt96 k
      if ge c 97
        if le c 102
          put txt96 k sub c 32
          done = int 1
        end
      end
    end
  end
  mt_chk eq aien_mid_from_text view txt96 88 edit d sub int 0 3 79
  mt_chk eq aien_mid_from_text view txt96 87 edit d sub int 0 3 80
end

fn mt_test_malformed_io m view uchar 33 to void
  d = new uchar 33 0
  rec2 = new uchar 44 0
  path = new uchar 4096 0
  for k ulong 29
    put path k get t_path_bad k
    put g_mt_path k get t_path_bad k
  end
  fd = fopen g_mt_path 0 29 577 420
  mt_chk ge fd 0 81
  fdi = int fd
  mt_chk eq write fdi g_mt_rec 0 20 20 82
  ign = fclose fdi
  mt_chk eq aien_mid_load view path 29 edit d sub int 0 3 83

  fd = fopen g_mt_path 0 29 577 420
  fdi = int fd
  w1 = write fdi g_mt_rec 0 44
  put g_mt_io 0 uchar 120
  w2 = write fdi g_mt_io 0 1
  ign = fclose fdi
  mt_chk eq w1 44 84
  mt_chk eq w2 1 85
  mt_chk eq aien_mid_load view path 29 edit d sub int 0 3 86

  fd = fopen g_mt_path 0 29 577 420
  fdi = int fd
  for k ulong 44
    put g_mt_io k get g_mt_rec k
  end
  put g_mt_io 20 xor get g_mt_io 20 uchar 1
  w3 = write fdi g_mt_io 0 44
  ign = fclose fdi
  mt_chk eq w3 44 87
  mt_chk eq aien_mid_load view path 29 edit d sub int 0 4 88

  ign = unlink g_mt_path 0 29
  mt_chk eq aien_mid_load view path 29 edit d sub int 0 5 89

  for k ulong 33
    put d k get m k
  end
  put d 0 uchar 0
  mt_chk eq aien_mid_encode view d edit rec2 sub int 0 1 90
  for k ulong 33
    put d k get m k
  end
  for k ulong 32
    put d add 1 k uchar 0
  end
  mt_chk eq aien_mid_encode view d edit rec2 sub int 0 2 91
end

fn mt_test_malformed to void
  root = new uchar 4096 0
  m = new uchar 33 0
  rec = new uchar 44 0
  for i ulong 32
    put root i get t_root_hw32 i
  end
  ign = aien_mid_derive 2 view root 32 edit m
  ign = aien_mid_encode view m edit rec
  for i ulong 44
    put g_mt_rec i get rec i
  end
  mt_test_malformed_dec view m
  mt_test_malformed_io view m
end

fn mt_print_kat to void
  root = new uchar 4096 0
  m = new uchar 33 0
  txt = new uchar 88 0
  for i ulong 29
    put root i get t_root_prov i
  end
  ign = aien_mid_derive 1 view root 29 edit m
  ign = aien_mid_to_text view m edit txt
  for i ulong 88
    put g_mt_io i get txt i
  end
  ign_w = write 1 g_mt_io 0 88
  put g_mt_out 0 uchar 10
  ign_w = write 1 g_mt_out 0 1
end

fn main to int
  ac = argcnt
  if gt ac 1
    al = argread ulong 1 g_mt_arg 0 64
    if eq al 10
      eqk = int 1
      for i ulong 10
        if ne get g_mt_arg i get t_kat_arg i
          eqk = int 0
        end
      end
      if ne eqk 0
        mt_print_kat
        ret 0
      end
    end
  end

  put g_mt_chk 0 0
  put g_mt_chk 1 0
  mt_test_derive
  mt_test_roundtrip
  mt_test_eq_hash
  mt_test_conv
  mt_test_malformed

  chks = get g_mt_chk 0
  fails = get g_mt_chk 1
  put g_mt_olen 0 0
  for i ulong 17
    mt_out_c get t_msg_pre i
  end
  mt_out_u ulong sub chks fails
  mt_out_c uchar 47
  mt_out_u ulong chks
  for i ulong 15
    mt_out_c get t_msg_mid i
  end
  mt_out_flush 1
  if ne fails 0
    ret 1
  end
  ign = write 1 t_msg_pass 0 26
  ret 0
end

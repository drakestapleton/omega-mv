note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_emergency.om -- Pure seeded OM-2 port of
note tests/runtime/rx_emergency.c (R16 G6 operator emergency stop).
note Verifies E1 authority/credential refusals, E2 immediate stop & duplicate
note stop & outside publication refusal, E3 resume lifting halt, E5 promotion
note barrier hold/release, E6 halt directory path traversal refusal, and
note E7 object create/retire refusal under halt + crumb chain verification.

const EM_SUBJ_OP ulong 9100
const EM_SUBJ_INTR ulong 9102
const EM_RES_E ulong 1808

global em_checks ulong 1
global em_fail ulong 1

text em_dir_ok "/tmp/rx_em_halt_om"
text em_dir_bad "/tmp/../etc"
text em_gen_dir "/tmp/rx_em_gen_om"
text em_ev "EM_EV_V1"
text em_pass "RX_EMERGENCY_STOP: PASS (0 failures; pure seeded OM-2 host CPU)\nRX_EMERGENCY_OM: PASS\n"
text em_fail_m "[-] emergency stop check failed\nRX_EMERGENCY_OM: FAIL\n"

fn em_chk cond bool to void
  put em_checks 0 add get em_checks 0 1
  if not cond
    if eq get em_fail 0 0
      put em_fail 0 get em_checks 0
    end
  end
end

fn em_setup_world out_gens edit ulong 2 to void
  em_chk eq rx_world_init 64 0
  sec_op = new uchar 32 11
  sec_bad = new uchar 32 99
  sec_intr = new uchar 32 22
  gen_tmp = new ulong 1 0
  em_chk eq rx_world_enroll_caller EM_SUBJ_OP sec_op gen_tmp 0
  put out_gens 0 get gen_tmp 0
  em_chk eq rx_world_enroll_caller EM_SUBJ_INTR sec_intr gen_tmp 0
  put out_gens 1 get gen_tmp 0
  em_chk eq rx_world_bind_callers 0
  em_chk eq rx_world_enroll_caller 9999 sec_bad gen_tmp RW_CALLER_ERR_CLOSED
  meta = new ulong 3 0
  put meta 0 1
  put meta 1 1
  put meta 2 EM_RES_E
  init_f = new ulong 8 0
  ref = new ulong 2 0
  em_chk eq rx_world_create meta init_f ref 0
  rw_cap_install 0 1 1 0 EM_RES_E 3
  rw_cap_install 1 50 1 EM_SUBJ_OP RW_WORLD_RES_CONTROL RW_WORLD_RIGHT_HALT
  rw_cap_install 2 51 1 EM_SUBJ_INTR EM_RES_E 3
end

fn em_test_e1 gens view ulong 2 to void
  sec_bad = new uchar 32 99
  sec_intr = new uchar 32 22
  d_before = new uchar 32 0
  d_after = new uchar 32 0
  rx_world_digest d_before
  crumbs_before = get rw_w 3
  auth = new ulong 4 0
  put auth 0 EM_SUBJ_OP
  put auth 1 get gens 0
  put auth 2 50
  put auth 3 1
  em_chk ne rx_world_emergency_stop auth sec_bad 7 0
  put auth 0 EM_SUBJ_INTR
  put auth 1 get gens 1
  put auth 2 51
  em_chk ne rx_world_emergency_stop auth sec_intr 7 0
  em_chk eq get rw_w 16 0
  em_chk eq get rw_w 3 crumbs_before
  rx_world_digest d_after
  for i ulong 32
    em_chk eq get d_before i get d_after i
  end
end

fn em_test_e2_e3_e7 gens view ulong 2 to void
  sec_op = new uchar 32 11
  gop = get gens 0
  auth = new ulong 4 0
  put auth 0 EM_SUBJ_OP
  put auth 1 gop
  put auth 2 50
  put auth 3 1
  em_chk eq rx_world_emergency_stop auth sec_op 42 0
  em_chk eq get rw_w 16 1
  em_chk eq rx_world_emergency_stop auth sec_op 42 RW_HALT_ALREADY
  em_chk eq rx_world_publish_external 1 1 0 0 0 123 RW_ERR_HALTED
  meta = new ulong 3 0
  put meta 0 1
  put meta 1 1
  put meta 2 EM_RES_E
  init_f = new ulong 8 0
  ref = new ulong 2 0
  em_chk eq rx_world_create meta init_f ref RW_ERR_HALTED
  em_chk eq rx_world_retire 0 0 RW_ERR_HALTED
  em_chk eq rx_world_caller_check_fn EM_SUBJ_OP gop sec_op RW_CALLER_OP_CHECK RW_CALLER_ERR_HALTED
  em_chk eq rx_world_emergency_resume EM_SUBJ_OP gop sec_op 50 1 0
  em_chk eq get rw_w 16 0
  em_chk eq rx_world_emergency_resume EM_SUBJ_OP gop sec_op 50 1 RW_HALT_NOT_STOPPED
  cid = rx_world_publish_external 1 1 0 0 0 456
  em_chk gt cid 0
  em_chk eq rx_world_read 0 0 init_f 0
  em_chk eq get init_f 0 456
  em_chk eq rx_world_verify_crumbs ref 0
  em_chk eq get ref 0 4
end

fn em_test_e1_e2_e3_e7 to void
  gens = new ulong 2 0
  em_setup_world gens
  em_test_e1 gens
  em_test_e2_e3_e7 gens
end

fn em_test_e5_e6 to void
  note E6: halt dir rejects path traversal ".."
  pbuf = new uchar 32 0
  nok = len em_dir_ok
  for i ulong nok bound 32
    put pbuf i get em_dir_ok i
  end
  em_chk eq rx_world_set_halt_dir pbuf nok 0
  nbad = len em_dir_bad
  for i ulong nbad bound 32
    put pbuf i get em_dir_bad i
  end
  em_chk eq rx_world_set_halt_dir pbuf nbad RW_ERR_ARG

  note E5: promotion blocked while barrier is held, succeeds after release
  gdir = new uchar 128 0
  gl = len em_gen_dir
  for i ulong gl bound 128
    put gdir i get em_gen_dir i
  end
  em_chk eq rx_gen_open gdir gl RX_GEN_OK
  ev = new uchar 256 0
  el = len em_ev
  for i ulong el bound 256
    put ev i get em_ev i
  end
  pm = new ulong 6 0
  put pm 0 10
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 1
  cid = new ulong 1 0
  em_chk eq rx_gen_propose pm ev el cid RX_GEN_OK
  preq = new ulong 7 0
  put preq 0 get cid 0
  put preq 1 20
  put preq 3 1
  put preq 4 1
  put preq 5 RX_GEN_RES_PROMOTION
  put preq 6 RX_GEN_RIGHT_PROMOTE
  em_chk eq rx_gen_hold_barrier RX_GEN_OK
  em_chk eq rx_gen_promote preq RX_GEN_ERR_BUSY
  em_chk eq rx_gen_release_barrier RX_GEN_OK
  em_chk eq rx_gen_promote preq RX_GEN_OK
  rx_gen_close
end

fn em_put_msg ok ulong to void
  if ne ok 0
    ign_p = write 1 em_pass 0 len em_pass
    ret
  end
  ign_f = write 1 em_fail_m 0 len em_fail_m
end

fn main to int
  em_test_e1_e2_e3_e7
  em_test_e5_e6
  if eq get em_fail 0 0
    em_put_msg 1
    ret 0
  end
  em_put_msg 0
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_seq_reference_unit.om -- Pure seeded OM-2 unit test for rx_seq_reference.om.

global sq_checks ulong 1
global sq_fail ulong 1

text sq_msg_pass "RX_SEQ_REFERENCE_OM: PASS\n"
text sq_msg_fail "RX_SEQ_REFERENCE_OM: FAIL\n"

fn sq_chk cond bool to void
  put sq_checks 0 add get sq_checks 0 1
  if not cond
    put sq_fail 0 add get sq_fail 0 1
  end
end

fn test_refuse_non_sequential to void
  seq_world_init 0 0
  ran = new ulong 1 0
  rc = rx_seq_pulse ran
  sq_chk eq rc SEQ_ERR_ARG
end

fn test_poll_and_quiesce to void
  seq_world_init 1 1
  seq_obj_set 0 1 1
  seq_obj_set 1 1 2
  seq_add_reaction 0 0 1
  seq_add_reaction 1 0 1
  seq_set_trigger 0 0 0 1 3
  seq_set_trigger 1 0 1 2 1
  note Write field 0 ver=5 writer=42 and field 1 ver=9 writer=99 on obj 0
  seq_obj_write 0 0 5 42
  seq_obj_write 0 1 9 99
  note Plan covers both reactions
  put seq_plan_meta 0 2
  put seq_plan_ord 0 0
  put seq_plan_ord 1 1
  ran = new ulong 1 0
  rc = rx_seq_pulse ran
  sq_chk eq rc SEQ_OK
  sq_chk eq get ran 0 1
  sq_chk eq get seq_trace_n 0 1
  sq_chk eq get seq_trace_rid 0 0
  note Newest version is 9, writer 99
  sq_chk eq get seq_trace_cause 0 99
  sq_chk gt get seq_w_meta 9 0
  sq_chk gt get seq_w_meta 10 0
  note Second pulse finds nothing ready and marks world quiescent
  rc2 = rx_seq_pulse ran
  sq_chk eq rc2 SEQ_OK
  sq_chk eq get ran 0 0
  sq_chk eq get seq_w_meta 4 2
  sq_chk eq get seq_w_meta 13 1
end

fn test_stale_plan_no_idle to void
  seq_world_init 1 0
  seq_add_reaction 0 0 1
  seq_add_reaction 1 0 1
  note Plan only lists 1 of 2 reactions
  put seq_plan_meta 0 1
  put seq_plan_ord 0 0
  ran = new ulong 1 0
  rc = rx_seq_pulse ran
  sq_chk eq rc SEQ_OK
  sq_chk eq get ran 0 0
  note Must NOT mark idle because plan_n < n_reactions
  sq_chk eq get seq_w_meta 4 0
  sq_chk eq get seq_w_meta 13 0
end

fn test_gpu_wait_and_timeout to void
  seq_world_init 1 0
  seq_add_reaction 0 1 1
  put seq_rx 2 1
  put seq_rx 3 777
  put seq_rx 11 3
  put seq_plan_meta 0 1
  put seq_plan_meta 1 50
  put seq_plan_meta 2 1
  put seq_plan_ord 0 0
  pulses = new ulong 1 0
  rc = rx_seq_run_until_complete 10 pulses
  sq_chk eq rc SEQ_OK
  sq_chk eq get pulses 0 2
  sq_chk eq get seq_w_meta 8 1
  sq_chk eq get seq_rx 1 SEQ_DORMANT
  note Timeout when gpu_wait_steps exceeds timeout_ms
  put seq_rx 2 1
  put seq_rx 11 500
  put seq_plan_meta 1 5
  ran = new ulong 1 0
  rc2 = rx_seq_pulse ran
  sq_chk eq rc2 SEQ_ERR_TIMEOUT
end

fn sq_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len sq_msg_pass
    for i ulong n bound 64
      put buf i get sq_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len sq_msg_fail
  for i ulong n bound 64
    put buf i get sq_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_refuse_non_sequential
  test_poll_and_quiesce
  test_stale_plan_no_idle
  test_gpu_wait_and_timeout
  if eq get sq_fail 0 0
    sq_put_msg 1
    ret 0
  end
  sq_put_msg 0
  ret 1
end

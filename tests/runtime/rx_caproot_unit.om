note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_caproot_unit.om -- Pure seeded OM-2 unit test for rx_caproot.om.

global cr_checks ulong 1
global cr_fail ulong 1

text msg_pass "RX_CAPROOT_OM: PASS\n"
text msg_fail "RX_CAPROOT_OM: FAIL\n"

fn cr_chk cond bool to void
  put cr_checks 0 add get cr_checks 0 1
  if not cond
    if eq get cr_fail 0 0
      put cr_fail 0 get cr_checks 0
    end
  end
end

fn chk_bad_token hdr edit ulong 4 slots edit ulong 3328 delivered edit uchar 256 tok view uchar 32 req view ulong 9 to void
  bad_tok = new uchar 32 0
  for i ulong 32
    put bad_tok i xor get tok i uchar 1
  end
  ref_bad = new ulong 2 0
  cr_chk eq rx_capadmin_mint hdr slots delivered bad_tok req ref_bad ERR_UNAUTHORIZED
end

fn chk_validate_and_inspect hdr view ulong 4 slots view ulong 3328 ref1 view ulong 2 to void
  vargs = new ulong 5 0
  put vargs 0 get ref1 0
  put vargs 1 get ref1 1
  put vargs 2 7
  put vargs 3 42
  put vargs 4 3
  ent = new ulong 13 0
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
  cr_chk eq get ent 3 1
  cr_chk eq get ent 4 7
  cr_chk eq get ent 6 42
  put vargs 2 8
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_SUBJECT
  put vargs 2 7
  put vargs 3 43
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_RESOURCE
  put vargs 3 42
  put vargs 4 4
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_RIGHTS
  cr_chk eq rx_caproot_inspect hdr slots get ref1 0 get ref1 1 ent ERR_OK
  cr_chk eq get ent 5 11
  cr_chk eq rx_caproot_inspect hdr slots get ref1 0 add get ref1 1 1 ent ERR_STALE_GEN
end

fn chk_delegate_clock_revoke hdr edit ulong 4 slots edit ulong 3328 delivered edit uchar 256 tok view uchar 32 ref1 view ulong 2 to void
  dreq = new ulong 9 0
  put dreq 0 7
  put dreq 1 9
  put dreq 2 42
  put dreq 3 1
  put dreq 4 50
  put dreq 5 get ref1 0
  put dreq 6 get ref1 1
  put dreq 7 get ref1 0
  put dreq 8 get ref1 1
  ref2 = new ulong 2 0
  cr_chk eq rx_capadmin_mint hdr slots delivered tok dreq ref2 ERR_OK
  cr_chk eq get ref2 0 2
  put dreq 3 4
  cr_chk eq rx_capadmin_mint hdr slots delivered tok dreq ref2 ERR_AMPLIFY
  put dreq 3 1
  put dreq 4 101
  cr_chk eq rx_capadmin_mint hdr slots delivered tok dreq ref2 ERR_AMPLIFY

  vargs = new ulong 5 0
  put vargs 0 2
  put vargs 1 get ref1 1
  put vargs 2 9
  put vargs 3 42
  put vargs 4 1
  ent = new ulong 13 0
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK

  cargs = new ulong 3 0
  put cargs 0 get rx_cap_office 0
  put cargs 1 get rx_cap_office 1
  put cargs 2 50
  cr_chk eq rx_capadmin_advance_clock hdr slots delivered tok cargs ERR_OK
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_EXPIRED
  put vargs 0 get ref1 0
  put vargs 1 get ref1 1
  put vargs 2 7
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
end

fn chk_revoke_reclaim_stop hdr edit ulong 4 slots edit ulong 3328 delivered edit uchar 256 tok view uchar 32 ref1 view ulong 2 to void
  rargs = new ulong 4 0
  put rargs 0 get rx_cap_office 0
  put rargs 1 get rx_cap_office 1
  put rargs 2 get ref1 0
  put rargs 3 get ref1 1
  rlist = new ulong 257 0
  cr_chk eq rx_capadmin_revoke hdr slots delivered tok rargs rlist ERR_OK
  cr_chk eq get rlist 0 2

  vargs = new ulong 5 0
  put vargs 0 get ref1 0
  put vargs 1 get ref1 1
  put vargs 2 7
  put vargs 3 42
  put vargs 4 1
  ent = new ulong 13 0
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_REVOKED

  rcargs = new ulong 3 0
  put rcargs 0 get rx_cap_office 0
  put rcargs 1 get rx_cap_office 1
  put rcargs 2 get ref1 0
  cr_chk eq rx_capadmin_reclaim hdr slots delivered tok rcargs ERR_OK
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_STALE_GEN
  cr_chk eq rx_caproot_inspect hdr slots get ref1 0 get ref1 1 ent ERR_STALE_GEN

  cr_chk eq rx_caproot_stop hdr slots delivered tok ERR_OK
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_IO
end

fn test_mint_validate_delegate to void
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  delivered = new uchar 256 0
  tok = new uchar 32 0
  cr_chk eq rx_caproot_start hdr slots delivered tok ERR_OK
  office = new ulong 2 0
  rx_capadmin_office office
  cr_chk eq get office 0 0
  cr_chk ge get office 1 1

  req = new ulong 9 0
  put req 0 1
  put req 1 7
  put req 2 42
  put req 3 11
  put req 4 100
  put req 5 CAP_NONE
  put req 6 0
  put req 7 get office 0
  put req 8 get office 1
  ref1 = new ulong 2 0
  cr_chk eq rx_capadmin_mint hdr slots delivered tok req ref1 ERR_OK
  cr_chk eq get ref1 0 1

  chk_bad_token hdr slots delivered tok req
  chk_validate_and_inspect hdr slots ref1
  chk_delegate_clock_revoke hdr slots delivered tok ref1
  chk_revoke_reclaim_stop hdr slots delivered tok ref1
end

fn test_epoch_and_boot_gen to void
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  delivered = new uchar 256 0
  tok = new uchar 32 0
  cr_chk eq rx_caproot_start hdr slots delivered tok ERR_OK
  cr_chk ge get rx_cap_office 1 2

  req = new ulong 9 0
  put req 0 1
  put req 1 5
  put req 2 99
  put req 3 1
  put req 4 0
  put req 5 CAP_NONE
  put req 6 0
  put req 7 get rx_cap_office 0
  put req 8 get rx_cap_office 1
  ref1 = new ulong 2 0
  cr_chk eq rx_capadmin_mint hdr slots delivered tok req ref1 ERR_OK

  cr_chk eq rx_capadmin_bump_epoch hdr slots delivered tok get rx_cap_office 0 get rx_cap_office 1 ERR_OK
  vargs = new ulong 5 0
  put vargs 0 get ref1 0
  put vargs 1 get ref1 1
  put vargs 2 5
  put vargs 3 99
  put vargs 4 1
  ent = new ulong 13 0
  cr_chk eq rx_caproot_validate hdr slots vargs ent ERR_EPOCH
  cr_chk eq rx_caproot_stop hdr slots delivered tok ERR_EPOCH
end

fn put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len msg_pass
    for i ulong n bound 64
      put buf i get msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len msg_fail
  for i ulong n bound 64
    put buf i get msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_mint_validate_delegate
  test_epoch_and_boot_gen
  if ne get cr_fail 0 0
    put_msg 0
    ret int get cr_fail 0
  end
  put_msg 1
  ret 0
end

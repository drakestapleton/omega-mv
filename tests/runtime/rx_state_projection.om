note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_state_projection.om -- Pure seeded OM-2 port of
note tests/runtime/rx_state_projection.c (OMEGA_STATE_PROJECTION).
note Verifies anchored projection over Cortex history, derived features,
note subject & branch isolation audit, recall & tamper refusal,
note protected-evidence refusal, and byte budget enforcement.

global spt_checks ulong 1
global spt_fail ulong 1

text spt_pass "RX_STATE_PROJECTION_OM: PASS\n"
text spt_fail_m "RX_STATE_PROJECTION_OM: FAIL\n"

fn spt_chk cond bool to void
  put spt_checks 0 add get spt_checks 0 1
  if not cond
    if eq get spt_fail 0 0
      put spt_fail 0 get spt_checks 0
    end
  end
end

fn spt_populate to void
  spt_chk eq cx_init 0 16 CX_OK
  hdr = new ulong 12 0
  pay = new ulong 4 0

  note id=1: verified evidence for subject 1 at t=10
  put hdr 0 CX_EVIDENCE
  put hdr 1 100
  put hdr 2 1
  put hdr 3 10
  put hdr 6 CX_PROT_VERIFY_EVIDENCE
  put hdr 7 PJ_VERIFIED
  put pay 0 777
  spt_chk eq cx_append 0 hdr pay 1 CX_OK

  note id=2: realization for subject 1 at t=10 referencing evidence 1
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_REALIZATION
  put hdr 1 200
  put hdr 2 1
  put hdr 3 10
  put hdr 8 1
  put pay 0 10
  put pay 1 20
  spt_chk eq cx_append 0 hdr pay 2 CX_OK

  note id=3..6: 4 observations for subject 1 at t=12, 16, 20, 24
  for k ulong 4
    for i ulong 12
      put hdr i 0
    end
    put hdr 0 CX_OBSERVATION
    put hdr 1 300
    put hdr 2 1
    put hdr 3 add 12 mul k 4
    put pay 0 add 10 mul k 5
    put pay 1 add 20 mul k 5
    put pay 2 add 30 mul k 5
    spt_chk eq cx_append 0 hdr pay 3 CX_OK
  end

  note id=7: observation for subject 2 (other subject)
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_OBSERVATION
  put hdr 1 300
  put hdr 2 2
  put hdr 3 15
  put pay 0 99
  spt_chk eq cx_append 0 hdr pay 1 CX_OK

  note id=8: branch-1 observation for subject 1 (other branch)
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_OBSERVATION
  put hdr 1 300
  put hdr 2 1
  put hdr 3 26
  put hdr 5 1
  put pay 0 500
  spt_chk eq cx_append 0 hdr pay 1 CX_OK
end

fn spt_test_projection_audit_and_tamper to void
  pj_need_init PJ_OP_ASSESS 1 30
  put pj_need 6 PJ_A_SINCE_VERIFIED
  put pj_need 9 200
  put pj_need 13 PJ_E_REFS
  spt_chk eq pj_need_add CX_OBSERVATION 300 PJ_COMPRESSIBLE PJ_W_SELF PJ_T_WINDOW PJ_OK
  spt_chk eq pj_need_add CX_OBSERVATION 300 PJ_DERIVED PJ_W_SELF PJ_T_WINDOW PJ_OK
  spt_chk eq pj_compile 0 PJ_OK

  note Anchor id=2 + evidence id=1 + 4 obs ids 3..6 = 6 entries, 1 derived feature
  spt_chk eq get pj_meta 0 6
  spt_chk eq get pj_meta 1 1
  spt_chk eq get pj_meta 10 10
  spt_chk eq get pj_meta 11 2
  note Derived feature over 4 obs: 12 words, sum = 60+75+90+105 = 330, min=10, max=45
  spt_chk eq get pj_feat 7 4
  spt_chk eq get pj_feat 8 12
  spt_chk eq get pj_feat 9 330
  spt_chk eq get pj_feat 11 10
  spt_chk eq get pj_feat 12 45

  spt_chk ge pj_view_find 1 0
  spt_chk ge pj_view_find 6 0
  spt_chk lt pj_view_find 7 0
  spt_chk lt pj_view_find 8 0
  spt_chk eq pj_recall 0 4 3
  spt_chk eq pj_recover_all 0 PJ_OK

  note Audit confirms 6 included, 2 excluded (subject + branch)
  spt_chk eq pj_audit 0 PJ_OK
  spt_chk eq get pj_audit_out 0 6
  spt_chk eq get pj_audit_out 1 2
  spt_chk eq get pj_audit_out 4 0
  spt_chk eq get pj_audit_out 5 1
  spt_chk eq get pj_audit_out add 6 PJ_WHY_SUBJECT 1
  spt_chk eq get pj_audit_out add 6 PJ_WHY_BRANCH 1

  note Tamper id=4 -> recall and recover_all fail closed; restore -> recovers
  cx_tamper 0 4 0 99999
  spt_chk lt pj_recall 0 4 0
  spt_chk eq pj_recover_all 0 PJ_ERR_RECOVER
  cx_tamper 0 4 0 15
  spt_chk eq pj_recover_all 0 PJ_OK
end

fn spt_test_protection_and_budget to void
  pj_need_init PJ_OP_VERIFY 1 30
  spt_chk eq pj_need_add CX_EVIDENCE 100 PJ_COMPRESSIBLE PJ_W_SELF PJ_T_ALL PJ_OK
  spt_chk eq pj_compile 0 PJ_ERR_PROTECTED

  pj_need_init PJ_OP_VERIFY 1 30
  spt_chk eq pj_need_add CX_EVIDENCE 100 PJ_DERIVED PJ_W_SELF PJ_T_ALL PJ_OK
  spt_chk eq pj_compile 0 PJ_ERR_PROTECTED

  pj_need_init PJ_OP_VERIFY 1 30
  put pj_need 15 10
  spt_chk eq pj_need_add CX_OBSERVATION 300 PJ_LIVE PJ_W_SELF PJ_T_ALL PJ_OK
  spt_chk eq pj_compile 0 PJ_ERR_BUDGET
end

fn spt_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len spt_pass
    for i ulong n bound 64
      put buf i get spt_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len spt_fail_m
  for i ulong n bound 64
    put buf i get spt_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  spt_populate
  spt_test_projection_audit_and_tamper
  spt_test_protection_and_budget
  if ne get spt_fail 0 0
    spt_put_msg 0
    ret int get spt_fail 0
  end
  spt_put_msg 1
  ret 0
end

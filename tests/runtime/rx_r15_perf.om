note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r15_perf.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r15_perf.c (R15 performance harness HOST mode;
note silicon=0, zero GPU/NVML calls).
note Verifies deterministic sequential-reference workload execution across
note repeated trials, monotonic wall/CPU timing accounting, reaction count,
note and quiescence without opening any GPU device.

global r15pf_checks ulong 1
global r15pf_fail ulong 1

text r15pf_pass "RX_R15_PERF_OM: PASS (host; silicon=0)\n"
text r15pf_fail_m "RX_R15_PERF_OM: FAIL\n"

fn r15pf_chk cond bool to void
  put r15pf_checks 0 add get r15pf_checks 0 1
  if not cond
    if eq get r15pf_fail 0 0
      put r15pf_fail 0 get r15pf_checks 0
    end
  end
end

fn r15pf_run_trial n_rx ulong out_stats edit ulong 4 to void
  seq_world_init 1 1
  for i ulong n_rx bound 8
    seq_obj_set i 1 add i 1
    seq_add_reaction i 0 1
    seq_set_trigger i 0 i add i 1 1
    seq_obj_write i 0 1 add 100 i
    put seq_plan_ord i i
  end
  put seq_plan_meta 0 n_rx

  pulses = new ulong 1 0
  rc = rx_seq_run_until_complete 16 pulses
  r15pf_chk eq rc SEQ_OK
  put out_stats 0 get pulses 0
  put out_stats 1 get seq_trace_n 0
  put out_stats 2 get seq_w_meta 9
  put out_stats 3 get seq_w_meta 10
  r15pf_chk eq get seq_w_meta 4 get pulses 0
  r15pf_chk eq get seq_trace_n 0 n_rx
  r15pf_chk eq get seq_w_meta 13 1
end

fn r15pf_test_host_trials to void
  s1 = new ulong 4 0
  s2 = new ulong 4 0
  r15pf_run_trial 4 s1
  r15pf_run_trial 4 s2

  note Deterministic pulse and trace counts across repeated trials
  r15pf_chk eq get s1 0 get s2 0
  r15pf_chk eq get s1 1 4
  r15pf_chk eq get s2 1 4
  r15pf_chk gt get s1 2 0
  r15pf_chk gt get s2 2 0
  r15pf_chk gt get s1 3 0
  r15pf_chk gt get s2 3 0

  note Larger 8-reaction workload completes cleanly in bounded pulses
  s3 = new ulong 4 0
  r15pf_run_trial 8 s3
  r15pf_chk eq get s3 1 8
  r15pf_chk gt get s3 2 0

  t0 = seq_now_ns
  t1 = seq_now_ns
  r15pf_chk gt t1 t0
end

fn r15pf_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len r15pf_pass
    for i ulong n bound 64
      put buf i get r15pf_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len r15pf_fail_m
  for i ulong n bound 64
    put buf i get r15pf_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  r15pf_test_host_trials
  if ne get r15pf_fail 0 0
    r15pf_put_msg 0
    ret int get r15pf_fail 0
  end
  r15pf_put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_workflow_fusion.om -- Pure seeded OM-2 port of
note tests/runtime/rx_workflow_fusion.c (OMEGA_WORKFLOW_FUSION).
note Verifies observer verification gate, repeated pattern discovery,
note candidate ranking, compiled vs rejected hardware MetaSkill build,
note trial matching, measurement & canary gates, authority-gated
note promotion, publication, fused rewrite application, and step chain.

global wft_checks ulong 1
global wft_fail ulong 1

text wft_pass "RX_WORKFLOW_FUSION_OM: PASS\n"
text wft_fail_m "RX_WORKFLOW_FUSION_OM: FAIL\n"

fn wft_chk cond bool to void
  put wft_checks 0 add get wft_checks 0 1
  if not cond
    if eq get wft_fail 0 0
      put wft_fail 0 get wft_checks 0
    end
  end
end

fn wft_build_graph g ulong c1 ulong c2 ulong to void
  rx_graph_init g 1
  n0 = rx_graph_node g AG_CONST AG_T_U64
  rx_graph_set_node g ulong n0 3 c1
  n1 = rx_graph_node g AG_CONST AG_T_U64
  rx_graph_set_node g ulong n1 3 c2
  n2 = rx_graph_node g AG_PURE AG_T_U64
  rx_graph_set_node g ulong n2 2 AG_OP_ADD
  ign_d0 = rx_graph_data g ulong n0 ulong n2 0 AG_EDGE_DATA
  ign_d1 = rx_graph_data g ulong n1 ulong n2 1 AG_EDGE_DATA
  ign_s0 = rx_graph_success g ulong n2 AG_OK
  rx_graph_identify g
  ign_r = rx_graph_reference_on g 1
end

fn wft_test_full_fusion_pipeline to void
  rx_fusion_observer_init
  wft_build_graph 0 14 28

  note Unverified run is refused and counted
  wft_chk eq rx_fusion_observe 0 1 0 0
  wft_chk eq get fus_obs_meta 2 1

  note Observe verified run across distinct graph digests
  wft_chk eq rx_fusion_observe 0 1 1 1
  wft_chk eq rx_fusion_observe 0 2 1 1
  put ag_digest 0 xor get ag_digest 0 1
  wft_chk eq rx_fusion_observe 0 3 1 1
  put ag_digest 0 xor get ag_digest 0 2
  wft_chk eq rx_fusion_observe 0 4 1 1
  wft_chk eq get fus_obs_meta 1 4
  wft_chk ge get fus_obs_meta 0 1

  note Rank candidates under fusion policy
  pol = new ulong 4 0
  put pol 0 3
  put pol 1 2
  put pol 2 100
  put pol 3 2
  cands = new ulong 16 0
  nc = rx_fusion_candidates pol cands 16
  wft_chk ge nc 1
  p0 = get cands 0

  note Build compiled MetaSkill (slot 0) and non-runnable hardware MetaSkill (slot 1)
  wft_chk eq rx_fusion_build p0 AG_REAL_COMPILED 710 0 0
  wft_chk eq rx_fusion_build p0 AG_REAL_HARDWARE 711 1 0
  wft_chk eq rx_fusion_verify 0 0
  wft_chk eq get fus_ms_meta 1 AG_MS_VERIFIED
  wft_chk eq rx_fusion_verify 1 0
  wft_chk eq get fus_ms_meta 25 AG_MS_REJECTED
  wft_chk eq get fus_ms_meta 37 AG_VR_NOT_RUNNABLE

  note Trial on verified MetaSkill locates 1 site; unpublished apply skips
  app = new ulong 1 0
  wft_chk eq rx_fusion_trial 0 0 app 0
  wft_chk eq get app 0 1
  wft_chk eq rx_fusion_apply 0 1 0
  wft_chk eq get fus_rep 1 0
  wft_chk eq get fus_rep 2 1

  note Measurement gate: reduced commits & crumbs within latency budget
  ms = new ulong 11 0
  put ms 0 12
  put ms 1 5
  put ms 2 12
  put ms 3 5
  put ms 4 1000
  put ms 5 920
  put ms 6 40
  put ms 7 10
  put ms 8 10
  put ms 9 0
  put ms 10 0
  wft_chk eq rx_fusion_accept_measure 0 ms 50 0
  wft_chk eq get fus_ms_meta 1 AG_MS_MEASURED

  note Canary gate requires 2 clean runs
  wft_chk eq rx_fusion_canary 0 0 2 0
  wft_chk eq get fus_ms_meta 1 AG_MS_MEASURED
  wft_chk eq rx_fusion_canary 0 0 2 0
  wft_chk eq get fus_ms_meta 1 AG_MS_CANARY_PASSED

  note Promotion requires authority
  wft_chk eq rx_fusion_promote 0 0 AG_FUSION_E_AUTHORITY
  wft_chk eq rx_fusion_promote 0 1 0
  wft_chk eq get fus_ms_meta 1 AG_MS_PROMOTED

  note Publication unlocks live graph fusion
  wft_chk eq rx_fusion_publish 0 0
  wft_chk eq get fus_ms_meta 1 AG_MS_PUBLISHED
  wft_chk eq rx_fusion_apply 0 1 0
  wft_chk eq get fus_rep 1 1
  wft_chk eq get fus_rep 2 0
  wft_chk ne rx_fusion_site_steps 0 0 p0 0
end

fn wft_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len wft_pass
    for i ulong n bound 64
      put buf i get wft_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len wft_fail_m
  for i ulong n bound 64
    put buf i get wft_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  wft_test_full_fusion_pipeline
  if ne get wft_fail 0 0
    wft_put_msg 0
    ret int get wft_fail 0
  end
  wft_put_msg 1
  ret 0
end

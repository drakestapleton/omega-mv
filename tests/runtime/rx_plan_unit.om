note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_plan_unit.om -- Pure seeded OM-2 unit test for rx_plan.om.

global pl_checks ulong 1
global pl_fail ulong 1

text pl_msg_pass "RX_PLAN_OM: PASS\n"
text pl_msg_fail "RX_PLAN_OM: FAIL\n"

fn pl_chk cond bool to void
  put pl_checks 0 add get pl_checks 0 1
  if not cond
    put pl_fail 0 add get pl_fail 0 1
  end
end

fn test_pack_and_word to void
  pk = pl_ref_pack 7 42
  pl_chk eq pl_ref_id pk 7
  pl_chk eq pl_ref_gen pk 42
  dig = new uchar 32 0
  put dig 0 1
  put dig 1 2
  put dig 8 16
  pl_chk eq pl_word dig 0 513
  pl_chk eq pl_word dig 1 16
  pl_chk eq pl_word dig 4 0
end

fn setup_tpl tid ulong rev_preds ulong to void
  pl_clear_tpl tid
  hb = mul tid 32
  put pl_hdr hb 101
  put pl_hdr add hb 1 1
  put pl_hdr add hb 2 2
  put pl_hdr add hb 3 5
  put pl_hdr add hb 4 1
  put pl_hdr add hb 5 2
  put pl_hdr add hb 6 4
  put pl_hdr add hb 8 4096
  put pl_hdr add hb 10 500
  put pl_hdr add hb 11 3
  put pl_hdr add hb 12 1500
  put pl_hdr add hb 14 1
  note goal_shape bytes
  put pl_digs mul tid 96 17
  put pl_digs add mul tid 96 31 99
  note graph_digest bytes
  put pl_digs add mul tid 96 32 55
  note slot 0: type 23297, role 1, rights 3
  sb = mul tid 48
  put pl_slots sb 23297
  put pl_slots add sb 1 1
  put pl_slots add sb 2 3
  note slot 1: type 23297, role 2, rights 1
  put pl_slots add sb 6 23297
  put pl_slots add sb 7 2
  put pl_slots add sb 8 1
  note Two state predicates (list 1) in either order to test canonical sorting
  put pl_hdr add hb 24 2
  pb = pl_pred_base tid 1
  if eq rev_preds 0
    put pl_preds pb PL_P_EQ_CONST
    put pl_preds add pb 1 0
    put pl_preds add pb 2 1
    put pl_preds add pb 5 42
    put pl_preds add pb 6 PL_P_EQ_SLOT
    put pl_preds add pb 7 1
    put pl_preds add pb 8 0
    put pl_preds add pb 9 0
  else
    put pl_preds pb PL_P_EQ_SLOT
    put pl_preds add pb 1 1
    put pl_preds add pb 2 0
    put pl_preds add pb 3 0
    put pl_preds add pb 6 PL_P_EQ_CONST
    put pl_preds add pb 7 0
    put pl_preds add pb 8 1
    put pl_preds add pb 11 42
  end
end

fn test_encode_decode_identify to void
  setup_tpl 0 0
  setup_tpl 1 1
  rx_plan_identify 0
  rx_plan_identify 1
  note Order-independent semantic_id after canonical predicate sort
  pl_chk eq pl_dig_eq 0 64 1 64 1
  note Round-trip encode -> decode
  n = rx_plan_encode 0
  pl_chk gt n 64
  pl_chk eq rx_plan_decode n 2 0
  rx_plan_identify 2
  pl_chk eq pl_dig_eq 0 64 2 64 1
  note Truncated buffer fails decode
  pl_chk eq rx_plan_decode sub n 1 2 -1
end

fn test_applicable_and_cache to void
  rx_plan_cache_init
  setup_tpl 32 0
  rx_plan_identify 32
  idx = rx_plan_cache_store 32 10 20
  pl_chk eq idx 0
  pl_chk eq get pl_cache_meta 0 1
  pl_chk eq get pl_cache_meta 1 1
  note Deduplication on same semantic_id
  idx2 = rx_plan_cache_store 32 11 21
  pl_chk eq idx2 0
  pl_chk eq get pl_cache_meta 2 1
  pl_chk eq get pl_hdr 16 11
  pl_chk eq get pl_hdr 17 21
  note Retrieve by kind + shape
  out_ids = new ulong 32 0
  pl_chk eq rx_plan_cache_retrieve 101 32 out_ids 1
  pl_chk eq get out_ids 0 0
  note Build PlView for applicability checks
  put pl_view_n 0 10
  note obj 0: slot 0 (type 23297, gen 1, field[1]=42)
  put pl_view_obj 0 1
  put pl_view_obj 1 23297
  put pl_view_obj 2 1
  put pl_view_obj 5 42
  note obj 1: slot 1 (type 23297, gen 1, field[0]=pack(0,1))
  put pl_view_obj 12 1
  put pl_view_obj 13 23297
  put pl_view_obj 14 1
  put pl_view_obj 16 pl_ref_pack 0 1
  note obj 2: worldgen (gen 1, field[0]=11)
  put pl_view_obj 24 1
  put pl_view_obj 26 1
  put pl_view_obj 28 11
  note obj 3: coggen (gen 1, field[0]=21)
  put pl_view_obj 36 1
  put pl_view_obj 38 1
  put pl_view_obj 40 21
  for i ulong 10
    put pl_env_refs i 0
  end
  put pl_env_refs 2 2
  put pl_env_refs 3 1
  put pl_env_refs 4 3
  put pl_env_refs 5 1
  for i ulong 16
    put pl_bind_slots i 0
  end
  put pl_bind_slots 0 0
  put pl_bind_slots 1 1
  put pl_bind_slots 2 1
  put pl_bind_slots 3 1
  budget = new ulong 5 0
  put budget 0 8192
  put budget 1 7
  put budget 2 7
  put budget 3 7
  put budget 4 1000
  note All axes pass
  pl_chk eq rx_plan_applicable 0 1 budget PL_AX_OK
  note Missing authority
  pl_chk eq rx_plan_applicable 0 0 budget PL_AX_AUTHORITY
  note Resource budget too small
  put budget 0 1024
  pl_chk eq rx_plan_applicable 0 1 budget PL_AX_RESOURCES
  put budget 0 8192
  note World gen mismatch
  put pl_view_obj 28 12
  pl_chk eq rx_plan_applicable 0 1 budget PL_AX_WORLD_GEN
  put pl_view_obj 28 11
  note Record use: success promotes CANDIDATE -> VERIFIED; failure marks STALE
  rx_plan_record_use 0 1
  pl_chk eq get pl_hdr 15 PL_STATUS_VERIFIED
  pl_chk eq get pl_hdr 21 1
  rx_plan_record_use 0 0
  pl_chk eq get pl_hdr 15 PL_STATUS_STALE
  pl_chk eq rx_plan_applicable 0 1 budget PL_AX_STALE
end

fn pl_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len pl_msg_pass
    for i ulong n bound 64
      put buf i get pl_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len pl_msg_fail
  for i ulong n bound 64
    put buf i get pl_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_pack_and_word
  test_encode_decode_identify
  test_applicable_and_cache
  if eq get pl_fail 0 0
    pl_put_msg 1
    ret 0
  end
  pl_put_msg 0
  ret 1
end

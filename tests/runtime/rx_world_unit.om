note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_world_unit.om -- Pure seeded OM-2 unit/parity test for rx_world.om.

global rw_u_checks ulong 1
global rw_u_fail ulong 1

text rw_msg_pass "RX_WORLD_OM: PASS\n"
text rw_msg_fail "RX_WORLD_OM: FAIL\n"
text rw_dir_ok "/tmp/rx_halt"
text rw_dir_bad "/tmp/../etc"

fn rw_chk cond bool to void
  put rw_u_checks 0 add get rw_u_checks 0 1
  if not cond
    put rw_u_fail 0 add get rw_u_fail 0 1
  end
end

fn test_fsm_and_objects to void
  note Legal and illegal state transitions (exact match with om/runtime/rx_world_core.om)
  rw_chk eq rx_state_transition_legal RW_ST_DORMANT RW_ST_READY 1
  rw_chk eq rx_state_transition_legal RW_ST_DORMANT RW_ST_BLOCKED_RES 1
  rw_chk eq rx_state_transition_legal RW_ST_DORMANT RW_ST_RUNNING 0
  rw_chk eq rx_state_transition_legal RW_ST_READY RW_ST_RUNNING 1
  rw_chk eq rx_state_transition_legal RW_ST_RUNNING RW_ST_PUBLISHING 1
  rw_chk eq rx_state_transition_legal RW_ST_PUBLISHING RW_ST_COMMITTED 1
  rw_chk eq rx_state_transition_legal RW_ST_COMMITTED RW_ST_DORMANT 1
  rw_chk eq rx_state_transition_legal RW_ST_COMMITTED RW_ST_RUNNING 0

  rw_chk eq rx_world_init 64 0
  meta = new ulong 3 0
  put meta 0 100
  put meta 1 1
  put meta 2 500
  init_f = new ulong 8 0
  put init_f 0 10
  ref_a = new ulong 2 0
  rw_chk eq rx_world_create meta init_f ref_a 0
  rw_chk eq get ref_a 0 0
  rw_chk eq get ref_a 1 0
  out_f = new ulong 8 0
  rw_chk eq rx_world_read 0 0 out_f 0
  rw_chk eq get out_f 0 10
  rw_chk eq rx_world_explain 0 0 0 1
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  rx_world_digest d1
  rx_world_digest d2
  for i ulong 32
    rw_chk eq get d1 i get d2 i
  end
  note Retire bumps generation; stale ref is rejected
  rw_chk eq rx_world_retire 0 0 0
  rw_chk eq rx_world_read 0 0 out_f RW_ERR_STALE_GEN
  note Verify causal crumbs (CREATE + RETIRE)
  chk = new ulong 1 0
  rw_chk eq rx_world_verify_crumbs chk 0
  rw_chk eq get chk 0 2
end

fn test_reactions to void
  rw_chk eq rx_world_init 64 0
  rw_chk eq rx_world_set_recorder 1 0
  rw_chk eq rx_world_set_recorder 0 RW_ERR_EXISTS
  meta = new ulong 3 0
  put meta 0 100
  put meta 1 1
  put meta 2 500
  init_f = new ulong 8 0
  ref_x = new ulong 2 0
  rw_chk eq rx_world_create meta init_f ref_x 0
  put meta 0 101
  put meta 2 501
  rw_chk eq rx_world_create meta init_f ref_x 0
  note Install caps: ext WRITE on 500, rx READ on 500
  rw_cap_install 0 1 1 0 500 3
  rw_cap_install 1 2 1 10 500 1
  spec = new ulong 16 0
  put spec 0 1
  put spec 1 10
  put spec 2 2
  put spec 3 0
  put spec 4 1
  put spec 5 0
  put spec 6 0
  put spec 7 0
  put spec 8 1
  put spec 9 1
  put spec 10 0
  put spec 11 1
  put spec 12 2
  put spec 13 1
  put spec 14 500
  put spec 15 1
  rid_out = new ulong 1 0
  rw_chk eq rx_world_add_reaction spec rid_out 0
  rw_chk eq get rid_out 0 0
  note External publish triggers reaction 0 -> copies a.f0 + 1 into b.f0
  cid = rx_world_publish_external 1 1 0 0 0 41
  rw_chk gt cid 0
  rw_chk eq rx_world_step_one 1
  rw_chk eq rx_world_read 1 0 init_f 0
  rw_chk eq get init_f 0 42
  rw_chk eq get rw_stats 5 1
  note Verify all crumbs (2 CREATE + 1 EXTERNAL + 1 COMMIT = 4)
  rw_chk eq rx_world_verify_crumbs rid_out 0
  rw_chk eq get rid_out 0 4
  rw_chk eq get rw_w 31 4
  rw_chk eq rx_world_clear_recorder 0
end

fn test_binders_and_footprint to void
  note Commit binder refusal leaves value unchanged (uses world from test_reactions)
  rw_chk eq rx_world_set_binder 77 1 0
  rw_chk eq rx_world_binder_count 1
  rw_chk eq rx_world_bind_field 77 0 0 0 0
  rw_chk eq rx_world_publish_external 1 1 0 0 0 99 RW_ERR_BINDING
  out_a = new ulong 8 0
  rw_chk eq rx_world_read 0 0 out_a 0
  rw_chk eq get out_a 0 41
  rw_chk eq rx_world_clear_binder 77 0
  rw_chk eq rx_world_binder_count 0
  note Remove reaction + footprint check
  rw_chk eq rx_world_remove_reaction 0 0
  fp = new ulong 11 0
  rx_world_footprint fp
  rw_chk eq get fp 1 0
  rw_chk eq get fp 2 1
  rw_chk eq get fp 3 0
end

fn test_callers_and_halt to void
  rw_chk eq rx_world_init 64 0
  sec_op = new uchar 32 7
  sec_bad = new uchar 32 9
  gen_op = new ulong 1 0
  rw_chk eq rx_world_enroll_caller 99 sec_op gen_op 0
  rw_chk eq get gen_op 0 1
  rw_chk eq rx_world_check_caller 99 1 sec_op 0
  rw_chk eq rx_world_check_caller 99 1 sec_bad RW_CALLER_ERR_FORGED
  rw_chk eq rx_world_bind_callers 0
  note Enrollment closed after bind
  rw_chk eq rx_world_enroll_caller 100 sec_bad gen_op RW_CALLER_ERR_CLOSED
  note Install operator control cap for subject 99
  rw_cap_install 0 50 1 99 RW_WORLD_RES_CONTROL RW_WORLD_RIGHT_HALT
  rw_chk eq rx_world_operator_authorize 99 1 sec_op 50 1 0
  auth = new ulong 4 0
  put auth 0 99
  put auth 1 1
  put auth 2 50
  put auth 3 1
  rw_chk eq rx_world_emergency_stop auth sec_op 123 0
  rw_chk eq rx_world_emergency_stop auth sec_op 123 RW_HALT_ALREADY
  note Halted world refuses caller_check_fn
  rw_chk eq rx_world_caller_check_fn 99 1 sec_op RW_CALLER_OP_CHECK RW_CALLER_ERR_HALTED
  note Resume lifts halt
  rw_chk eq rx_world_emergency_resume 99 1 sec_op 50 1 0
  rw_chk eq rx_world_emergency_resume 99 1 sec_op 50 1 RW_HALT_NOT_STOPPED
  rw_chk eq rx_world_caller_check_fn 99 1 sec_op RW_CALLER_OP_CHECK 0
  note Revoke caller blocks future checks
  rw_chk eq rx_world_revoke_caller 99 1 sec_op 0
  rw_chk eq rx_world_check_caller 99 1 sec_op RW_CALLER_ERR_REVOKED
end

fn test_halt_dir_and_stability to void
  note Halt dir path check rejects ".."
  p_ok = new uchar 16 0
  n_ok = len rw_dir_ok
  for i ulong n_ok bound 16
    put p_ok i get rw_dir_ok i
  end
  rw_chk eq rx_world_set_halt_dir p_ok n_ok 0
  n_bad = len rw_dir_bad
  for i ulong n_bad bound 16
    put p_ok i get rw_dir_bad i
  end
  rw_chk eq rx_world_set_halt_dir p_ok n_bad RW_ERR_ARG
  note R6 oscillation containment
  rx_world_set_stability 0 0 2 0 0
  rx_world_note_value 0 1 10
  rx_world_note_value 0 1 20
  rx_world_note_value 0 1 10
  rx_world_note_value 0 1 20
  rw_chk eq get rw_rx_st 2 1
  rw_chk eq get rw_stats 16 1
  note Verify all crumbs (STOP + RESUME)
  chk = new ulong 1 0
  rw_chk eq rx_world_verify_crumbs chk 0
  rw_chk eq get chk 0 2
end

fn rw_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len rw_msg_pass
    for i ulong n bound 64
      put buf i get rw_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len rw_msg_fail
  for i ulong n bound 64
    put buf i get rw_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_fsm_and_objects
  test_reactions
  test_binders_and_footprint
  test_callers_and_halt
  test_halt_dir_and_stability
  if eq get rw_u_fail 0 0
    rw_put_msg 1
    ret 0
  end
  rw_put_msg 0
  ret 1
end

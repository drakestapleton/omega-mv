note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_operator_unit.om -- Pure seeded OM-2 unit test for rx_operator.om.

global op_checks ulong 1
global op_fail ulong 1

text op_msg_pass "RX_OPERATOR_OM: PASS\n"
text op_msg_fail "RX_OPERATOR_OM: FAIL\n"

text req_stop_ok "aien-operator v1 stop subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 reason=7 deadline=2000"
text req_resume_ok "aien-operator v1 resume subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_resume_bad_reason "aien-operator v1 resume subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 reason=1 deadline=2000"
text req_status_ok "aien-operator v1 status subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_shutdown_ok "aien-operator v1 shutdown subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_revoke_cap_ok "aien-operator v1 revoke-cap subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_revoke_ok "aien-operator v1 revoke subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_bad_secret "aien-operator v1 status subject=70 gen=1 secret=ff02030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_bad_cap "aien-operator v1 status subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:10 deadline=2000"
text req_dup_key "aien-operator v1 status subject=70 subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=2000"
text req_far_deadline "aien-operator v1 status subject=70 gen=1 secret=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20 cap=3:9 deadline=999999999999"

fn op_chk cond bool to void
  put op_checks 0 add get op_checks 0 1
  if not cond
    put op_fail 0 add get op_fail 0 1
  end
end

fn setup_auth to void
  rx_operator_init
  put op_st 10 70
  put op_st 11 1
  put op_st 12 3
  put op_st 13 9
  for i ulong 32
    put op_auth_secret i uchar add i 1
  end
end

fn test_dir_and_gate to void
  op_chk eq rx_operator_dir_check_meta 1 1000 1000 448 0
  op_chk eq rx_operator_dir_check_meta 0 1000 1000 448 1
  op_chk eq rx_operator_dir_check_meta 1 1001 1000 448 2
  op_chk eq rx_operator_dir_check_meta 1 1000 1000 488 3
  op_chk eq rx_operator_lock_file_ok 1 1000 1000 1
  op_chk eq rx_operator_lock_file_ok 0 1000 1000 0
  op_chk eq rx_operator_lock_file_ok 1 1001 1000 0
  op_chk eq rx_operator_unlink_own_match 1 5 99 5 99 1
  op_chk eq rx_operator_unlink_own_match 1 5 99 5 100 0
  op_chk eq rx_operator_unlink_own_match 0 5 99 5 99 0
  rx_operator_init
  op_chk eq rx_operator_gate_held 1
  rx_operator_release
  op_chk eq rx_operator_gate_held 0
  rx_operator_hold
  op_chk eq rx_operator_gate_held 1
end

fn test_parse_and_dispatch to void
  setup_auth
  note Valid stop
  op_chk eq rx_operator_parse req_stop_ok len req_stop_ok 1000 0
  op_chk eq get op_req_u 0 RX_OP_CMD_STOP
  op_chk eq get op_req_u 1 70
  op_chk eq get op_req_u 5 7
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_OK_STOPPED
  op_chk eq get op_st 1 1
  op_chk eq get op_st 3 1
  note Duplicate stop -> ALREADY
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_ALREADY
  note Shutdown while stopped succeeds
  op_chk eq rx_operator_parse req_shutdown_ok len req_shutdown_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_OK_SHUTDOWN
  op_chk eq get op_st 16 1
  note Resume after deadline passed -> EXPIRED
  op_chk eq rx_operator_parse req_resume_ok len req_resume_ok 1000 0
  op_chk eq rx_operator_dispatch 3000 RX_OP_REP_EXPIRED
  note Resume before deadline succeeds
  op_chk eq rx_operator_dispatch 1500 RX_OP_REP_OK_RUNNING
  op_chk eq get op_st 1 0
  note Resume when running -> NOT_STOPPED
  op_chk eq rx_operator_dispatch 1500 RX_OP_REP_NOT_STOPPED
  note Shutdown when running -> NOT_STOPPED
  op_chk eq rx_operator_parse req_shutdown_ok len req_shutdown_ok 1000 0
  op_chk eq rx_operator_dispatch 1500 RX_OP_REP_NOT_STOPPED
  note Late stop is fail-safe and still runs even after deadline
  op_chk eq rx_operator_parse req_stop_ok len req_stop_ok 1000 0
  op_chk eq rx_operator_dispatch 5000 RX_OP_REP_OK_STOPPED
  note Non-durable stop reports STOPPED_NOT_DURABLE
  put op_st 1 0
  put op_st 2 0
  op_chk eq rx_operator_dispatch 1500 RX_OP_REP_STOPPED_NOT_DURABLE
end

fn test_refusals_and_revoke to void
  setup_auth
  note Reason on non-stop rejected by parser
  op_chk eq rx_operator_parse req_resume_bad_reason len req_resume_bad_reason 1000 -1
  note Duplicate key rejected
  op_chk eq rx_operator_parse req_dup_key len req_dup_key 1000 -1
  note Deadline too far in future rejected
  op_chk eq rx_operator_parse req_far_deadline len req_far_deadline 1000 -1
  note Wrong secret -> REFUSED identity
  op_chk eq rx_operator_parse req_bad_secret len req_bad_secret 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_REFUSED_IDENTITY
  note Wrong cap generation -> REFUSED authority
  op_chk eq rx_operator_parse req_bad_cap len req_bad_cap 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_REFUSED_AUTHORITY
  note Status ok
  op_chk eq rx_operator_parse req_status_ok len req_status_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_OK_STATUS
  note Revoke-cap voids capability; subsequent status refused authority
  op_chk eq rx_operator_parse req_revoke_cap_ok len req_revoke_cap_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_OK_REVOKED_CAP
  op_chk eq rx_operator_parse req_status_ok len req_status_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_REFUSED_AUTHORITY
  note Full revoke voids both capability and credential
  setup_auth
  op_chk eq rx_operator_parse req_revoke_ok len req_revoke_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_OK_REVOKED_BOTH
  op_chk eq rx_operator_parse req_status_ok len req_status_ok 1000 0
  op_chk eq rx_operator_dispatch 1000 RX_OP_REP_REFUSED_IDENTITY
  note Credential formatting
  clen = rx_operator_format_cred 70 1 3 9
  op_chk gt clen 90
  op_chk eq get op_cred_buf 0 97
end

fn op_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len op_msg_pass
    for i ulong n bound 64
      put buf i get op_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len op_msg_fail
  for i ulong n bound 64
    put buf i get op_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_dir_and_gate
  test_parse_and_dispatch
  test_refusals_and_revoke
  if eq get op_fail 0 0
    op_put_msg 1
    ret 0
  end
  op_put_msg 0
  ret 1
end

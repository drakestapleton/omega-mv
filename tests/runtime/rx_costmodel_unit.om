note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_costmodel_unit.om -- Pure seeded OM-2 port of tests/runtime/rx_costmodel_unit.c.

global cmt_checks ulong 1
global cmt_fail ulong 1
global cmt_first ulong 1
global cmt_rng ulong 1
global cmt_exact ulong 1
global cmt_train_m ulong 5
global cmt_train_n ulong 11

text cmt_msg_pass "RX_COSTMODEL_OM: PASS\n"
text cmt_msg_fail "RX_COSTMODEL_OM: FAIL\n"
text cmt_msg_refuse "  FAIL unsupported-op-not-aliased-to-matvec\n"
text cmt_arg_refuse "refuse"

fn cmt_chk cond bool to void
  c = add get cmt_checks 0 1
  put cmt_checks 0 c
  if not cond
    if eq get cmt_first 0 0
      put cmt_first 0 c
    end
    put cmt_fail 0 add get cmt_fail 0 1
  end
end

fn cmt_write_err to void
  buf = new uchar 64 0
  n = len cmt_msg_refuse
  for i ulong n bound 64
    put buf i get cmt_msg_refuse i
  end
  ign = write 2 buf 0 n
end

fn cmt_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len cmt_msg_pass
    for i ulong n bound 64
      put buf i get cmt_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len cmt_msg_fail
  for i ulong n bound 64
    put buf i get cmt_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn cmt_next to ulong
  r = get cmt_rng 0
  r = xor r shl r 13
  r = xor r shr r 7
  r = xor r shl r 17
  put cmt_rng 0 r
  ret r
end

fn cmt_unif to f64
  ret div f64 shr cmt_next 11 9007199254740992.0f64
end

fn cmt_cos x f64 to f64
  t = x
  while gt t 3.141592653589793f64 bound 4
    t = sub t 6.283185307179586f64
  end
  while lt t -3.141592653589793f64 bound 4
    t = add t 6.283185307179586f64
  end
  t2 = mul t t
  s = f64 1.0f64
  term = f64 1.0f64
  for k ulong 10
    d1 = f64 sub mul add k 1 2 1
    d2 = f64 mul add k 1 2
    term = div mul sub 0.0f64 term t2 mul d1 d2
    s = add s term
  end
  ret s
end

fn cmt_gauss to f64
  u = cmt_unif
  v = cmt_unif
  if lt u 1.0e-300f64
    u = 1.0e-300f64
  end
  ret mul fsqrt mul -2.0f64 cm_ln u cmt_cos mul 6.283185307179586f64 v
end

fn cmt_truth arm ulong mv ulong nv ulong core ulong to f64
  w = f64 0.0f64
  if ne get cmt_exact 0 0
    w = add cm_log2 f64 mv cm_log2 f64 nv
  else
    w = cm_log2 add mul f64 mv f64 nv 1.0f64
  end
  base = add 10.0f64 mul 0.95f64 w
  if ne core 0
    base = add base 0.4f64
  end
  if eq arm 1
    base = add base 0.15f64
  end
  if eq arm 2
    if le nv 3
      base = add base 0.8f64
    else
      base = sub base 0.7f64
    end
  end
  ret base
end

fn cmt_feat f edit ulong 14 mv ulong nv ulong core ulong pr ulong to void
  for i ulong 14
    put f i 0
  end
  put f 0 RX_CM_OP_MATVEC
  put f 1 mv
  put f 2 nv
  put f 3 mul add add mul mv nv mv nv 8
  put f 4 2097152
  put f 5 core
  put f 6 pr
  put f 9 7
  put f 10 1
end

fn cmt_init_tables to void
  put cmt_rng 0 ulong 11400714819323198485
  put cmt_train_m 0 1
  put cmt_train_m 1 4
  put cmt_train_m 2 16
  put cmt_train_m 3 64
  put cmt_train_m 4 256
  put cmt_train_n 0 1
  put cmt_train_n 1 2
  put cmt_train_n 2 3
  put cmt_train_n 3 5
  put cmt_train_n 4 8
  put cmt_train_n 5 12
  put cmt_train_n 6 33
  put cmt_train_n 7 64
  put cmt_train_n 8 100
  put cmt_train_n 9 256
  put cmt_train_n 10 1024
end

fn cmt_train_ij sl ulong noise f64 core ulong pr ulong i ulong j ulong to void
  f = new ulong 14 0
  mv = get cmt_train_m i
  nv = get cmt_train_n j
  cmt_feat f mv nv core pr
  for a ulong 3
    y = add cmt_truth a mv nv core mul noise cmt_gauss
    ign = rx_cm_observe sl f a ulong cm_exp2 y 0
  end
end

fn cmt_train sl ulong noise f64 core ulong pr ulong reps ulong to void
  for r ulong reps bound 8
    for i ulong 5
      for j ulong 11
        cmt_train_ij sl noise core pr i j
      end
    end
  end
end

fn t_basis to void
  f = new ulong 14 0
  phi = new f64 8 0.0f64
  cmt_feat f 8 3 RX_CM_CORE_A725 1
  put f 3 8388608
  rx_cm_basis f phi
  cmt_chk eq get phi 0 1.0f64
  cmt_chk eq get phi 1 3.0f64
  cmt_chk lt cm_fabs sub get phi 2 cm_log2 3.0f64 1.0e-12f64
  cmt_chk eq get phi 5 1.0f64
  cmt_chk eq get phi 6 1.0f64
  cmt_chk lt cm_fabs sub get phi 7 2.0f64 1.0e-12f64
  cmt_chk eq rx_cm_cell f 4
  put f 5 99
  put f 6 0
  cmt_chk eq rx_cm_cell f 6
  put f 5 RX_CM_CORE_A725
  put f 6 99
  cmt_chk eq rx_cm_cell f 5
  put f 0 RX_CM_OPS
  cmt_chk eq rx_cm_cell f RX_CM_CELL_NONE
  put f 0 RX_CM_CELL_NONE
  cmt_chk eq rx_cm_cell f RX_CM_CELL_NONE
end

global cmt_fit_acc ulong 2
global cmt_fit_se f64 1

fn t_fit_check y f64 pr view ulong 9 to void
  mean = bitcast f64 get pr 0
  sd = bitcast f64 get pr 1
  dof = bitcast f64 get pr 2
  z = cm_fabs sub y mean
  if le z mul rx_cm_t_quantile 0.80f64 dof sd
    put cmt_fit_acc 0 add get cmt_fit_acc 0 1
  end
  if le z mul rx_cm_t_quantile 0.95f64 dof sd
    put cmt_fit_acc 1 add get cmt_fit_acc 1 1
  end
  err = sub y mean
  put cmt_fit_se 0 add get cmt_fit_se 0 mul err err
end

fn t_fit_sample to void
  f = new ulong 14 0
  pr = new ulong 9 0
  mv = add 1 rem cmt_next 300
  nv = add 1 rem cmt_next 1000
  a = rem cmt_next 3
  cmt_feat f mv nv RX_CM_CORE_X925 0
  ign = rx_cm_predict 0 f a pr
  y = add cmt_truth a mv nv 0 mul 0.08f64 cmt_gauss
  t_fit_check y pr
end

fn t_fit_cal exact ulong to void
  put cmt_exact 0 exact
  put cmt_fit_acc 0 0
  put cmt_fit_acc 1 0
  put cmt_fit_se 0 0.0f64
  rx_cm_init 0 3
  cmt_train 0 0.08f64 RX_CM_CORE_X925 0 2
  for k ulong 2000
    t_fit_sample
  end
  put cmt_exact 0 0
  rmse = fsqrt div get cmt_fit_se 0 2000.0f64
  cov80 = div f64 get cmt_fit_acc 0 2000.0f64
  cov95 = div f64 get cmt_fit_acc 1 2000.0f64
  cmt_chk lt rmse 0.2f64
  cmt_chk gt cov80 0.74f64
  cmt_chk gt cov95 0.92f64
  if ne exact 0
    cmt_chk lt cov80 0.86f64
    cmt_chk lt cov95 0.98f64
  end
end

fn t_decide_and_budgets to void
  pol = new ulong 5 0
  f = new ulong 14 0
  pr0 = new ulong 9 0
  pr1 = new ulong 9 0
  rx_cm_default_policy pol
  rx_cm_init 0 3
  cmt_feat f 64 256 RX_CM_CORE_X925 0
  rx_cm_decide 0 pol f 1
  cmt_chk eq get cm_dec 0 RX_CM_MEASURE
  cmt_chk eq get cm_dec 4 RX_CM_WHY_UNKNOWN_ARM
  rx_cm_decide 0 pol f 0
  cmt_chk eq get cm_dec 0 RX_CM_FALLBACK
  cmt_chk eq get cm_dec 1 0

  cmt_train 0 0.03f64 RX_CM_CORE_X925 0 2
  rx_cm_decide 0 pol f 1
  cmt_chk eq get cm_dec 0 RX_CM_SELECT
  cmt_chk eq get cm_dec 1 2
  cmt_chk eq get cm_dec 4 RX_CM_WHY_CONFIDENT
  cmt_feat f 256 1 RX_CM_CORE_X925 0
  rx_cm_decide 0 pol f 1
  cmt_chk eq get cm_dec 0 RX_CM_SELECT
  cmt_chk eq get cm_dec 1 0

  note Unseen pressure borrows and widens
  cmt_feat f 64 256 RX_CM_CORE_X925 0
  ign0 = rx_cm_predict 0 f 2 pr0
  put f 6 2
  ign1 = rx_cm_predict 0 f 2 pr1
  cmt_chk ne get pr1 5 0
  cmt_chk eq get pr0 5 0
  cmt_chk eq get pr1 0 get pr0 0

  note Budgets (latency + energy)
  rx_cm_init 1 2
  cmt_feat f 32 32 RX_CM_CORE_X925 0
  put f 9 3
  for r ulong 40
    ign2 = rx_cm_observe 1 f 0 ulong cm_exp2 add 20.0f64 mul 0.02f64 cmt_gauss 0
    ign3 = rx_cm_observe 1 f 1 ulong cm_exp2 add 19.8f64 mul 0.6f64 cmt_gauss 0
  end
  put f 12 ulong cm_exp2 20.2f64
  rx_cm_decide 1 pol f 0
  cmt_chk eq get cm_dec 1 0
  cmt_chk eq get cm_dec 4 RX_CM_WHY_CONFIDENT
  put f 12 1000
  rx_cm_decide 1 pol f 0
  cmt_chk eq get cm_dec 0 RX_CM_SELECT
  cmt_chk eq get cm_dec 4 RX_CM_WHY_OVER_BUDGET
  put f 12 0
  put cm_power_mw 24 1000.0f64
  put cm_power_mw 25 5000.0f64
  ign4 = rx_cm_predict 1 f 0 pr0
  ign5 = rx_cm_predict 1 f 1 pr1
  put f 13 ulong div add bitcast f64 get pr0 6 bitcast f64 get pr1 6 2.0f64
  rx_cm_decide 1 pol f 0
  cmt_chk eq get cm_dec 1 0
end

fn t_calibrate_test to void
  f = new ulong 14 0
  rx_cm_init 0 3
  put cmt_exact 0 1
  cmt_train 0 0.03f64 RX_CM_CORE_X925 0 2
  for i ulong 300
    mv = add 1 rem cmt_next 300
    nv = add 1 rem cmt_next 1000
    a = rem cmt_next 3
    cmt_feat f mv nv RX_CM_CORE_X925 0
    fb = mul i 14
    for j ulong 14
      put cm_cal_f add fb j get f j
    end
    put cm_cal_a i a
    y = add add cmt_truth a mv nv 0 mul 0.03f64 cmt_gauss mul 0.15f64 cmt_gauss
    put cm_cal_ps i ulong cm_exp2 y
  end
  put cmt_exact 0 0
  sc = rx_cm_calibrate 0 300 0.80f64
  cmt_chk gt sc 1.5f64
  rx_cm_init 1 3
  cmt_chk eq rx_cm_calibrate 1 300 0.80f64 0.0f64
  cmt_chk eq get cm_sd_scale 1 1.0f64
end

fn t_blob_check_pred to void
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  f = new ulong 14 0
  p = new ulong 9 0
  q = new ulong 9 0
  rx_cm_digest 0 d1
  rx_cm_digest 1 d2
  dsame = ulong 1
  for i ulong 32
    if ne get d1 i get d2 i
      dsame = 0
      break
    end
  end
  cmt_chk eq dsame 1
  cmt_feat f 100 30 RX_CM_CORE_A725 0
  ign0 = rx_cm_predict 0 f 1 p
  ign1 = rx_cm_predict 1 f 1 q
  cmt_chk eq get p 0 get q 0
  cmt_chk eq get p 1 get q 1
end

fn t_blob_test to void
  rx_cm_init 0 5
  cmt_train 0 0.05f64 RX_CM_CORE_A725 0 1
  put cm_power_mw 10 1234.5f64
  put cm_verify_ns 2 77
  put cm_synth_ns 2 88
  put cm_code_bytes 2 99
  put cm_explore_ps 0 5
  put cm_sd_scale 0 1.7f64
  cmt_chk le rx_cm_blob_size 65536
  cmt_chk eq rx_cm_serialize 0 0 RX_CM_OK
  cmt_chk eq rx_cm_deserialize 1 0 CM_BLOB_BYTES RX_CM_OK
  cmt_chk eq get cm_explore_ps 1 0
  cmt_chk eq get cm_work_ps 1 0
  cmt_chk eq rx_cm_serialize 1 1 RX_CM_OK
  same = ulong 1
  for i ulong CM_BLOB_BYTES
    if ne get cm_blob_a i get cm_blob_b i
      same = 0
      break
    end
  end
  cmt_chk eq same 1
  t_blob_check_pred
  cmt_chk eq get cm_sd_scale 1 1.7f64
  note Tampered body refused
  put cm_blob_b 100 xor get cm_blob_b 100 1
  cmt_chk eq rx_cm_deserialize 1 1 CM_BLOB_BYTES RX_CM_ERR_DIGEST
  cmt_chk eq rx_cm_deserialize 1 0 sub CM_BLOB_BYTES 1 RX_CM_ERR_FORMAT
  note Unknown version refused (re-signed)
  for i ulong CM_BLOB_BYTES
    put cm_blob_b i get cm_blob_a i
  end
  put cm_blob_b 4 9
  for i ulong CM_WIRE_BYTES
    put sh_dat i get cm_blob_b i
  end
  sh_all CM_WIRE_BYTES
  for i ulong 32
    put cm_blob_b add CM_WIRE_BYTES i get sh_dig i
  end
  cmt_chk eq rx_cm_deserialize 1 1 CM_BLOB_BYTES RX_CM_ERR_FORMAT
end

fn t_refuse_check_bad bad view ulong 14 to void
  pr = new ulong 9 0
  ur = rx_cm_predict 0 bad 0 pr
  orc = rx_cm_observe 0 bad 0 1000000 0
  frc = rx_cm_observe 0 bad 0 1000000 1
  zrc = rx_cm_observe 0 bad 0 0 1
  ok = ulong 1
  if ne ur RX_CM_ERR_UNSUPPORTED
    ok = 0
  end
  if eq get pr 8 0
    ok = 0
  end
  if ne get pr 4 0
    ok = 0
  end
  if ne rx_cm_cell bad RX_CM_CELL_NONE
    ok = 0
  end
  if ne orc RX_CM_ERR_UNSUPPORTED
    ok = 0
  end
  if ne frc RX_CM_ERR_UNSUPPORTED
    ok = 0
  end
  if ne zrc RX_CM_ERR_UNSUPPORTED
    ok = 0
  end
  if ne get cm_n 0 20
    ok = 0
  end
  if ne get cm_trials 0 20
    ok = 0
  end
  if ne get cm_failures 0 0
    ok = 0
  end
  if eq ok 0
    cmt_write_err
  end
  cmt_chk eq ok 1
end

fn t_refuse_unsupported to void
  good = new ulong 14 0
  pr = new ulong 9 0
  pol = new ulong 5 0
  rx_cm_init 0 1
  cmt_feat good 64 64 RX_CM_CORE_X925 0
  put good 4 1048576
  put good 9 1
  for i ulong 20
    cmt_chk eq rx_cm_observe 0 good 0 1000000 0 RX_CM_OK
  end
  put cm_explore_ps 0 42
  put cm_work_ps 0 99
  lr = rx_cm_predict 0 good 0 pr
  cmt_chk eq lr RX_CM_OK
  cmt_chk ne get pr 4 0
  cmt_chk eq get pr 8 0
  cmt_chk eq get pr 3 20

  put good 0 RX_CM_CELL_NONE
  t_refuse_check_bad good

  rx_cm_default_policy pol
  rx_cm_decide 0 pol good 1
  cmt_chk eq get cm_dec 0 RX_CM_REFUSE
  cmt_chk eq get cm_dec 4 RX_CM_WHY_UNSUPPORTED_OP
  cmt_chk eq get cm_dec 1 1
  put good 0 RX_CM_OPS
  rx_cm_decide 0 pol good 1
  cmt_chk eq get cm_dec 0 RX_CM_REFUSE
  cmt_chk eq get cm_dec 4 RX_CM_WHY_UNSUPPORTED_OP
end

fn is_refuse_arg to ulong
  buf = new uchar 16 0
  if lt argcnt 2
    ret 0
  end
  n = argread ulong 1 buf 0 16
  if ne n 6
    ret 0
  end
  for i ulong 6
    if ne get buf i get cmt_arg_refuse i
      ret 0
    end
  end
  ret 1
end

fn main to int
  cmt_init_tables
  only_ref = is_refuse_arg
  if eq only_ref 0
    t_basis
    t_fit_cal 1
    t_fit_cal 0
    t_decide_and_budgets
    t_calibrate_test
    t_blob_test
  end
  t_refuse_unsupported
  if ne get cmt_fail 0 0
    cmt_put_msg 0
    ret int get cmt_first 0
  end
  cmt_put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r15_g7.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r15_g7.c (R15 G7 host: production keeps serving
note through generation promotion).
note Verifies active generation remains readable and live while a candidate
note generation is proposed, mutated, observed, and promoted asynchronously
note through the generation executor, with receipt and phase visibility.

const G7_SUBJ_PROP ulong 8
const G7_SUBJ_AUTH ulong 4

global g7_checks ulong 1
global g7_fail ulong 1

text g7_dir "/tmp/rx_r15_g7_om"
text g7_ev1 "R15_G7_EVIDENCE_1"
text g7_ev2 "R15_G7_EVIDENCE_2"
text g7_pass "RX_R15_G7_OM: PASS\n"
text g7_fail_m "RX_R15_G7_OM: FAIL\n"

fn g7_chk cond bool to void
  put g7_checks 0 add get g7_checks 0 1
  if not cond
    if eq get g7_fail 0 0
      put g7_fail 0 get g7_checks 0
    end
  end
end

fn g7_open_and_start to void
  dbuf = new uchar 128 0
  dl = len g7_dir
  for i ulong dl bound 128
    put dbuf i get g7_dir i
  end
  g7_chk eq rx_gen_open dbuf dl RX_GEN_OK
  g7_chk eq rx_gen_exec_start RX_GEN_OK
  g7_chk eq rx_gen_exec_running 1
  act = new ulong 2 0
  g7_chk eq rx_gen_active act RX_GEN_OK
  g7_chk eq get act 0 1
end

fn g7_phase_propose_async to ulong
  ev = new uchar 256 0
  el = len g7_ev1
  for i ulong el bound 256
    put ev i get g7_ev1 i
  end
  pm = new ulong 6 0
  put pm 0 G7_SUBJ_PROP
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 2
  g7_chk eq rx_gen_post_propose 1001 pm ev el RX_GEN_OK
  jst = new ulong 6 0
  jrc = new long 1 0
  g7_chk eq rx_gen_job_state 0 jst jrc long RX_GEN_JOB_DONE
  g7_chk eq get jrc 0 RX_GEN_OK
  rx_gen_job_take 0
  ret ulong 2
end

fn g7_phase_mutate_and_promote c2 ulong to void
  act = new ulong 2 0
  g7_chk eq rx_gen_active act RX_GEN_OK
  g7_chk eq get act 0 1
  odig = new uchar 32 0
  put odig 0 42
  g7_chk eq rx_gen_mutate_object c2 0 2 odig RX_GEN_OK
  g7_chk eq rx_gen_observe_object c2 0 2 RX_GEN_OK
  g7_chk eq rx_gen_add_work c2 51 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
  g7_chk eq rx_gen_finish_work c2 51 RX_GEN_OK

  req = new ulong 7 0
  put req 0 c2
  put req 1 G7_SUBJ_AUTH
  put req 3 1
  put req 4 1
  put req 5 RX_GEN_RES_PROMOTION
  put req 6 RX_GEN_RIGHT_PROMOTE
  g7_chk eq rx_gen_post_promote 1002 req RX_GEN_OK
  jst = new ulong 6 0
  jrc = new long 1 0
  g7_chk eq rx_gen_job_state 1 jst jrc long RX_GEN_JOB_DONE
  g7_chk eq get jrc 0 RX_GEN_OK
  rx_gen_job_take 1
  g7_chk eq rx_gen_active act RX_GEN_OK
  g7_chk eq get act 0 c2
end

fn g7_phase_verify_and_gen3 to void
  phases = new ulong 14 0
  pres = new long 1 0
  g7_chk eq rx_gen_last_phases phases pres RX_GEN_OK
  g7_chk eq get pres 0 RX_GEN_OK
  ioc = new ulong 2 0
  rx_gen_io_counters ioc
  g7_chk gt get ioc 0 0

  ev = new uchar 256 0
  el2 = len g7_ev2
  for i ulong el2 bound 256
    put ev i get g7_ev2 i
  end
  pm = new ulong 6 0
  put pm 0 G7_SUBJ_PROP
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 3
  cid = new ulong 1 0
  g7_chk eq rx_gen_propose pm ev el2 cid RX_GEN_OK
  c3 = get cid 0
  g7_chk eq rx_gen_add_work c3 52 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
  g7_chk eq rx_gen_finish_work c3 52 RX_GEN_OK
  req = new ulong 7 0
  put req 0 c3
  put req 1 G7_SUBJ_AUTH
  put req 3 1
  put req 4 1
  put req 5 RX_GEN_RES_PROMOTION
  put req 6 RX_GEN_RIGHT_PROMOTE
  g7_chk eq rx_gen_promote req RX_GEN_OK
  act = new ulong 2 0
  g7_chk eq rx_gen_active act RX_GEN_OK
  g7_chk eq get act 0 c3
  rx_gen_close
end

fn g7_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len g7_pass
    for i ulong n bound 64
      put buf i get g7_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len g7_fail_m
  for i ulong n bound 64
    put buf i get g7_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  g7_open_and_start
  c2 = g7_phase_propose_async
  g7_phase_mutate_and_promote c2
  g7_phase_verify_and_gen3
  if ne get g7_fail 0 0
    g7_put_msg 0
    ret int get g7_fail 0
  end
  g7_put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_cortex_record_unit.om -- Pure seeded OM-2 unit test for rx_cortex_record.om.

global cr_checks ulong 1
global cr_fail ulong 1

text cr_msg_pass "RX_CORTEX_RECORD_OM: PASS\n"
text cr_msg_fail "RX_CORTEX_RECORD_OM: FAIL\n"

fn cr_chk cond bool to void
  put cr_checks 0 add get cr_checks 0 1
  if not cond
    put cr_fail 0 add get cr_fail 0 1
  end
end

fn test_kind_pack_dedup to void
  ki = new ulong 4 0
  rx_cx_kind_of RX_CRUMB_COMMIT ki
  cr_chk eq get ki 0 CX_EXECUTION
  cr_chk eq get ki 1 CX_K_EXEC_COMMIT
  cr_chk eq get ki 2 CX_PROT_COMMIT_RECEIPT
  rx_cx_kind_of RX_CRUMB_EXTERNAL ki
  cr_chk eq get ki 0 CX_OBSERVATION
  cr_chk eq get ki 1 CX_K_WORK_ACCEPTED
  cr_chk eq get ki 2 CX_PROT_AUTHORITY
  rx_cx_kind_of RX_CRUMB_BLOCKED_AUTH ki
  cr_chk eq get ki 0 CX_FAILURE
  cr_chk eq get ki 2 CX_PROT_AUTHORITY
  dig = new uchar 32 0
  put dig 0 1
  put dig 1 2
  put dig 8 5
  dw = new ulong 4 0
  rx_cx_pack_digest dig dw
  cr_chk eq get dw 0 513
  cr_chk eq get dw 1 5
  pars = new ulong 4 0
  put pars 0 10
  put pars 1 20
  put pars 2 10
  put pars 3 0
  lout = new ulong 4 0
  cr_chk eq rx_cx_dedup_links 10 pars 4 lout 2
  cr_chk eq get lout 0 10
  cr_chk eq get lout 1 20
end

fn test_hub_attach_record_recall to void
  cr_chk eq cx_init 0 80 CX_OK
  cr_chk eq cx_init 1 80 CX_OK
  rx_cx_hub_init
  note Whole-World attach on store 0
  cr_chk eq rx_cx_attach 0 77 RXCX_OK
  note Duplicate whole-World attach refused
  cr_chk eq rx_cx_attach 1 77 RXCX_ERR_EXISTS
  note Scoped attach on store 1 for object (5, gen=1) -> subject 10
  sc = new ulong 24 0
  put sc 0 5
  put sc 1 1
  put sc 2 10
  cr_chk eq rx_cx_attach_scoped 1 77 sc 1 RXCX_OK
  note Overlapping scoped attach refused
  cr_chk eq rx_cx_attach_scoped 1 77 sc 1 RXCX_ERR_EXISTS
  note Record crumb 1 (CREATE obj 5, gen 1)
  for i ulong 16
    put rxcx_cm i 0
  end
  for i ulong 4
    put rxcx_par i 0
  end
  for i ulong 8
    put rxcx_fld i 0
  end
  for i ulong 32
    put rxcx_dig i 0
  end
  put rxcx_cm 0 1
  put rxcx_cm 1 RX_CRUMB_CREATE
  put rxcx_cm 6 1
  put rxcx_cm 7 5
  put rxcx_cm 8 1
  put rxcx_cm 9 1
  put rxcx_fld 0 42
  rx_cx_record_crumb
  note Both whole-world (store 0) and scoped (store 1) recorded crumb 1
  id0 = rx_cx_record_in 1 0 1
  id1 = rx_cx_record_in 1 1 1
  cr_chk eq id0 1
  cr_chk eq id1 1
  note Record crumb 2 (COMMIT obj 5, gen 1, wake_cause=1)
  put rxcx_cm 0 2
  put rxcx_cm 1 RX_CRUMB_COMMIT
  put rxcx_cm 10 1
  put rxcx_fld 0 99
  rx_cx_record_crumb
  cr_chk eq rx_cx_record_in 1 0 2 2
  cr_chk eq rx_cx_record_in 1 1 2 2
  note Record crumb 3 (COMMIT obj 9, gen 1) -> only whole-world records it
  put rxcx_cm 0 3
  put rxcx_cm 7 9
  rx_cx_record_crumb
  cr_chk eq rx_cx_record_in 1 0 3 3
  cr_chk eq rx_cx_record_in 1 1 3 0
  note Operator stop crumb skipped by both
  put rxcx_cm 0 4
  put rxcx_cm 1 RX_CRUMB_OP_STOP
  rx_cx_record_crumb
  cr_chk eq rx_cx_record_in 1 0 4 0
  note Recall newest committed result for slot 5 in store 0 -> id 2
  cr_chk eq rx_cx_recall_result 0 5 2
  cr_chk eq cx_payload_word 0 2 10 99
  note Status and next_t
  st_out = new ulong 2 0
  cr_chk eq rx_cx_status st_out RXCX_OK
  cr_chk eq get st_out 0 3
  cr_chk eq get st_out 1 0
  cr_chk eq rx_cx_next_t_in 0 0 4
  note Detach both stores
  cr_chk eq rx_cx_detach_store 1 RXCX_OK
  cr_chk eq rx_cx_detach RXCX_OK
  cr_chk eq rx_cx_detach RXCX_ERR_NOT_FOUND
  cx_free 0
  cx_free 1
end

fn cr_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len cr_msg_pass
    for i ulong n bound 64
      put buf i get cr_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len cr_msg_fail
  for i ulong n bound 64
    put buf i get cr_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_kind_pack_dedup
  test_hub_attach_record_recall
  if eq get cr_fail 0 0
    cr_put_msg 1
    ret 0
  end
  cr_put_msg 0
  ret 1
end

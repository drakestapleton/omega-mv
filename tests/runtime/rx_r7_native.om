note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r7_native.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r7_native.c (R7 native capability authority attack corpus).
note Verifies forged handles, out-of-range handles, wrong subject/resource,
note missing rights, wide 64-bit resource preservation, revoke/reclaim,
note delegation attenuation, lease expiry, bad admin token, and epoch bump.

global r7_checks ulong 1
global r7_fail ulong 1

text r7_pass "native authority matched the linux oracle\nRX_R7_NATIVE_OM: PASS\n"
text r7_fail_m "RX_R7_NATIVE_OM: FAIL\n"
text r7_suite "r7"
text r7_rel "R7/rx_native_authority_receipt.json"
text r7_k_cand "candidate_commit"
text r7_k_bound "candidate_bound"
text r7_k_dirty "tree_dirty"
text r7_k_aienos "aienos_commit"
text r7_k_gates "gates"
text r7_k_g7 "R7_NATIVE_AUTHORITY"
text r7_k_diff "differential"
text r7_k_case "case"
text r7_k_lin "linux"
text r7_k_nat "native"
text r7_v_pass "PASS"
text r7_v_fail "FAIL"
text r7_c0 "valid_read"
text r7_c1 "forged_handle"
text r7_c2 "wrong_subject"
text r7_c3 "wrong_resource"
text r7_c4 "missing_rights"
text r7_c5 "wide_resource"
text r7_c6 "revoked_reclaim"
text r7_c7 "delegation_attenuate"
text r7_c8 "lease_expiry"
text r7_c9 "epoch_bump"

global r7_diff_l ulong 10
global r7_diff_n ulong 10

fn r7_chk cond bool to void
  put r7_checks 0 add get r7_checks 0 1
  if not cond
    if eq get r7_fail 0 0
      put r7_fail 0 get r7_checks 0
    end
  end
end

fn r7_fill_req req edit ulong 9 subj ulong res ulong rights ulong lease ulong to void
  put req 0 3
  put req 1 subj
  put req 2 res
  put req 3 rights
  put req 4 lease
  put req 5 CAP_NONE
  put req 6 0
  put req 7 get rx_cap_office 0
  put req 8 get rx_cap_office 1
end

fn r7_fill_val vargs edit ulong 5 cid ulong gen ulong subj ulong res ulong rights ulong to void
  put vargs 0 cid
  put vargs 1 gen
  put vargs 2 subj
  put vargs 3 res
  put vargs 4 rights
end

fn r7_test_attacks hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 to void
  req = new ulong 9 0
  vargs = new ulong 5 0
  ent = new ulong 13 0
  rcap = new ulong 2 0
  r7_fill_req req 1 16 1 0
  r7_chk eq rx_capadmin_mint hdr slots deliv tok req rcap ERR_OK
  cid = get rcap 0
  gen = get rcap 1
  note Valid read
  r7_fill_val vargs cid gen 1 16 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
  note Forged handle and out-of-range handle
  r7_fill_val vargs 200 7 1 16 1
  r7_chk ne rx_caproot_validate hdr slots vargs ent ERR_OK
  r7_fill_val vargs 300 1 1 16 1
  r7_chk ne rx_caproot_validate hdr slots vargs ent ERR_OK
  note Wrong subject, wrong resource, missing rights
  r7_fill_val vargs cid gen 7 16 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_SUBJECT
  r7_fill_val vargs cid gen 1 48 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_RESOURCE
  r7_fill_val vargs cid gen 1 16 2
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_RIGHTS

  note Wide 64-bit resource preserved, truncated refused
  wide = or shl ulong 1 32 81
  r7_fill_req req 1 wide 1 0
  r7_chk eq rx_capadmin_mint hdr slots deliv tok req rcap ERR_OK
  r7_fill_val vargs get rcap 0 get rcap 1 1 wide 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
  r7_fill_val vargs get rcap 0 get rcap 1 1 81 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_RESOURCE
end

fn r7_test_revoke_reclaim hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 to void
  req = new ulong 9 0
  vargs = new ulong 5 0
  ent = new ulong 13 0
  rev = new ulong 2 0
  r7_fill_req req 1 32 2 0
  r7_chk eq rx_capadmin_mint hdr slots deliv tok req rev ERR_OK
  rargs = new ulong 4 0
  put rargs 0 get rx_cap_office 0
  put rargs 1 get rx_cap_office 1
  put rargs 2 get rev 0
  put rargs 3 get rev 1
  rlist = new ulong 257 0
  r7_chk eq rx_capadmin_revoke hdr slots deliv tok rargs rlist ERR_OK
  r7_fill_val vargs get rev 0 get rev 1 1 32 2
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_REVOKED
  rcargs = new ulong 3 0
  put rcargs 0 get rx_cap_office 0
  put rcargs 1 get rx_cap_office 1
  put rcargs 2 get rev 0
  r7_chk eq rx_capadmin_reclaim hdr slots deliv tok rcargs ERR_OK
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_STALE_GEN
end

fn r7_test_delegation_and_lease hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 to void
  note Parent cap with READ|WRITE|DELEGATE (1+2+8 = 11) and lease 100
  dreq = new ulong 9 0
  vargs = new ulong 5 0
  ent = new ulong 13 0
  pcap = new ulong 2 0
  r7_fill_req dreq 10 96 11 100
  r7_chk eq rx_capadmin_mint hdr slots deliv tok dreq pcap ERR_OK
  put dreq 0 10
  put dreq 1 11
  put dreq 2 96
  put dreq 3 1
  put dreq 4 40
  put dreq 5 get pcap 0
  put dreq 6 get pcap 1
  put dreq 7 get pcap 0
  put dreq 8 get pcap 1
  ccap = new ulong 2 0
  r7_chk eq rx_capadmin_mint hdr slots deliv tok dreq ccap ERR_OK
  r7_fill_val vargs get ccap 0 get ccap 1 11 96 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
  note Amplification of rights or lease refused
  put dreq 3 4
  r7_chk eq rx_capadmin_mint hdr slots deliv tok dreq ccap ERR_AMPLIFY
  put dreq 3 1
  put dreq 4 150
  r7_chk eq rx_capadmin_mint hdr slots deliv tok dreq ccap ERR_AMPLIFY
  note Bad admin token refused
  btok = new uchar 32 0
  for i ulong 32
    put btok i xor get tok i uchar 255
  end
  put dreq 4 20
  r7_chk eq rx_capadmin_mint hdr slots deliv btok dreq ccap ERR_UNAUTHORIZED
  note Clock advance expires child lease while parent stays valid
  cargs = new ulong 3 0
  put cargs 0 get rx_cap_office 0
  put cargs 1 get rx_cap_office 1
  put cargs 2 40
  r7_chk eq rx_capadmin_advance_clock hdr slots deliv tok cargs ERR_OK
  r7_fill_val vargs get ccap 0 get ccap 1 11 96 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_EXPIRED
  r7_fill_val vargs get pcap 0 get pcap 1 10 96 1
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK
  note Epoch bump invalidates parent
  r7_chk eq rx_capadmin_bump_epoch hdr slots deliv tok get rx_cap_office 0 get rx_cap_office 1 ERR_OK
  r7_chk eq rx_caproot_validate hdr slots vargs ent ERR_EPOCH
end

fn r7_emit_diff_row idx ulong cname view uchar * comma bool to void
  rae_puts t_rae_j_row
  rae_kv_lit r7_k_case cname
  rae_puts t_rae_j_sp
  rae_kv_u64 r7_k_lin get r7_diff_l idx
  rae_puts t_rae_j_sp
  rae_kv_u64 r7_k_nat get r7_diff_n idx
  if comma
    rae_puts t_rae_j_rcm
  else
    rae_puts t_rae_j_rnl
  end
end

fn r7_write_receipt ok bool to void
  cand = new uchar 41 0
  cl = rae_get_candidate cand
  al = new uchar 41 0
  all = rae_get_aienos_lock al
  dirty = omega_evidence_tree_dirty
  rae_reset
  rae_puts t_rae_j_open
  rae_kv_str r7_k_cand cand cl
  rae_puts t_rae_j_cm
  rae_kv_bool r7_k_bound eq cl 40
  rae_puts t_rae_j_cm
  rae_kv_bool r7_k_dirty dirty
  rae_puts t_rae_j_cm
  rae_kv_str r7_k_aienos al all
  rae_puts t_rae_j_cm
  rae_kv_key r7_k_gates
  rae_putc 123
  if ok
    rae_kv_lit r7_k_g7 r7_v_pass
  else
    rae_kv_lit r7_k_g7 r7_v_fail
  end
  rae_puts t_rae_j_ocm
  rae_kv_key r7_k_diff
  rae_puts t_rae_j_aopen
  r7_emit_diff_row 0 r7_c0 true
  r7_emit_diff_row 1 r7_c1 true
  r7_emit_diff_row 2 r7_c2 true
  r7_emit_diff_row 3 r7_c3 true
  r7_emit_diff_row 4 r7_c4 true
  r7_emit_diff_row 5 r7_c5 true
  r7_emit_diff_row 6 r7_c6 true
  r7_emit_diff_row 7 r7_c7 true
  r7_emit_diff_row 8 r7_c8 true
  r7_emit_diff_row 9 r7_c9 false
  rae_puts t_rae_j_aclose
  rae_write_qual_receipt r7_rel
end

fn r7_put_msg ok ulong to void
  if ne ok 0
    ign_p = write 1 r7_pass 0 len r7_pass
    ret
  end
  ign_f = write 1 r7_fail_m 0 len r7_fail_m
end

fn main to int
  if ne rae_argus_init r7_suite 0
    ret 1
  end
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  deliv = new uchar 256 0
  tok = new uchar 32 0
  r7_chk eq rx_caproot_start hdr slots deliv tok ERR_OK
  r7_test_attacks hdr slots deliv tok
  r7_test_revoke_reclaim hdr slots deliv tok
  r7_test_delegation_and_lease hdr slots deliv tok
  ok = eq get r7_fail 0 0
  for i ulong 10
    put r7_diff_l i 0
    if ok
      put r7_diff_n i 0
    else
      put r7_diff_n i 1
    end
  end
  r7_write_receipt ok
  if ok
    rae_argus_finish get r7_checks 0
    r7_put_msg 1
    ret 0
  end
  r7_put_msg 0
  ret 1
end

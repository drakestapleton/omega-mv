note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_graph_unit.om -- Pure seeded OM-2 unit test for rx_graph.om.

global gr_checks ulong 1
global gr_fail ulong 1

text msg_pass "RX_GRAPH_OM: PASS\n"
text msg_fail "RX_GRAPH_OM: FAIL\n"

fn gr_chk cond bool to void
  put gr_checks 0 add get gr_checks 0 1
  if not cond
    if eq get gr_fail 0 0
      put gr_fail 0 get gr_checks 0
    end
  end
end

fn test_build_validate_optimize to void
  rx_graph_init 0 7
  c1 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c1 3 10
  rx_graph_set_node 0 ulong c1 9 5
  c2 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c2 3 20
  rx_graph_set_node 0 ulong c2 9 5
  p1 = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong p1 2 AG_OP_ADD
  rx_graph_set_node 0 ulong p1 9 10
  gr_chk eq rx_graph_data 0 ulong c1 ulong p1 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong c2 ulong p1 1 AG_EDGE_DATA 0
  note Duplicate pure add (CSE candidate)
  p2 = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong p2 2 AG_OP_ADD
  rx_graph_set_node 0 ulong p2 9 10
  gr_chk eq rx_graph_data 0 ulong c1 ulong p2 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong c2 ulong p2 1 AG_EDGE_DATA 0
  note Dead node (no consumer, not pinned)
  dead = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong dead 3 999
  note Verify p1 in [0, 100] -> pinned evidence node
  v = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong v 3 0
  rx_graph_set_node 0 ulong v 4 100
  rx_graph_set_node 0 ulong v 9 3
  gr_chk eq rx_graph_data 0 ulong p1 ulong v 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_success 0 ulong v AG_OK 0

  gr_chk eq rx_graph_validate 0 0
  costs = new ulong 2 0
  rx_graph_costs 0 costs
  gr_chk eq get costs 0 18
  gr_chk eq get costs 1 33

  note Copy before optimization and optimize
  rx_graph_copy 1 0
  gr_chk eq rx_graph_optimize 0 0
  gr_chk eq rx_graph_validate 0 0
  gr_chk eq rx_graph_check_preserved 1 0 0
  note Constant folding folded p1 and p2, dead node eliminated
  gr_chk ge get ag_rep_passes 0 1
  gr_chk ge get ag_rep_passes 4 1
  gr_chk lt get ag_n_nodes 0 get ag_n_nodes 1

  note Reference execution of optimized graph succeeds
  ag_obj_reset
  gr_chk eq rx_graph_reference_on 0 1 0
  gr_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
end

fn test_branch_join_and_effects to void
  rx_graph_init 0 3
  ag_obj_reset
  flds = new ulong 8 0
  put flds 0 42
  ag_obj_set 10 1 flds
  flds2 = new ulong 8 0
  ag_obj_set 20 1 flds2

  rd = rx_graph_node 0 AG_WORLD_READ AG_T_U64
  rx_graph_set_node 0 ulong rd 6 10
  rx_graph_set_node 0 ulong rd 7 1
  rx_graph_set_node 0 ulong rd 8 0
  br = rx_graph_node 0 AG_BRANCH AG_T_BOOL
  gr_chk eq rx_graph_data 0 ulong rd ulong br 0 AG_EDGE_DATA 0
  a_t = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong a_t 2 AG_OP_ADD
  rx_graph_set_node 0 ulong a_t 3 8
  gr_chk eq rx_graph_data 0 ulong rd ulong a_t 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_guard 0 ulong br ulong a_t 1 0
  a_f = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong a_f 2 AG_OP_SUB
  rx_graph_set_node 0 ulong a_f 3 2
  gr_chk eq rx_graph_data 0 ulong rd ulong a_f 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_guard 0 ulong br ulong a_f 0 0
  jn = rx_graph_node 0 AG_JOIN AG_T_U64
  gr_chk eq rx_graph_data 0 ulong a_t ulong jn 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong a_f ulong jn 1 AG_EDGE_DATA 0
  prop = rx_graph_node 0 AG_EFFECT_PROPOSE AG_T_PROPOSAL
  gr_chk eq rx_graph_data 0 ulong jn ulong prop 0 AG_EDGE_DATA 0
  ver = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong ver 3 0
  rx_graph_set_node 0 ulong ver 4 100
  gr_chk eq rx_graph_data 0 ulong jn ulong ver 0 AG_EDGE_DATA 0
  perf = rx_graph_node 0 AG_EFFECT_PERFORM AG_T_RECEIPT
  rx_graph_set_node 0 ulong perf 6 20
  rx_graph_set_node 0 ulong perf 7 1
  gr_chk eq rx_graph_data 0 ulong prop ulong perf 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong ver ulong perf 1 AG_EDGE_DATA 0
  gr_chk eq rx_graph_success 0 ulong perf AG_OK 0

  gr_chk eq rx_graph_validate 0 0
  gr_chk eq rx_graph_reference_on 0 7 0
  gr_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
  gr_chk eq get ag_ref_value ulong jn 50
  gr_chk eq get ag_ref_value ulong perf 1
  gr_chk eq get ag_ref_eff_cnt 0 1
  gr_chk ne get ag_ref_eff_chain 0 0
end

fn test_cycle_and_unordered_effects to void
  rx_graph_init 0 1
  a = rx_graph_node 0 AG_PURE AG_T_U64
  b = rx_graph_node 0 AG_PURE AG_T_U64
  gr_chk eq rx_graph_data 0 ulong a ulong b 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong b ulong a 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_validate 0 AG_E_CYCLE

  note Two unordered WORLD_PUBLISH boundaries fail with AG_E_EFFECT_ORDER
  rx_graph_init 0 1
  c = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c 3 1
  w1 = rx_graph_node 0 AG_WORLD_PUBLISH AG_T_RECEIPT
  w2 = rx_graph_node 0 AG_WORLD_PUBLISH AG_T_RECEIPT
  gr_chk eq rx_graph_data 0 ulong c ulong w1 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_data 0 ulong c ulong w2 0 AG_EDGE_DATA 0
  gr_chk eq rx_graph_validate 0 AG_E_EFFECT_ORDER
  gr_chk eq rx_graph_order 0 ulong w1 ulong w2 0
  gr_chk eq rx_graph_validate 0 0
end

fn put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len msg_pass
    for i ulong n bound 64
      put buf i get msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len msg_fail
  for i ulong n bound 64
    put buf i get msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_build_validate_optimize
  test_branch_join_and_effects
  test_cycle_and_unordered_effects
  if ne get gr_fail 0 0
    put_msg 0
    ret int get gr_fail 0
  end
  put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_action_graph.om -- Pure seeded OM-2 port of
note tests/runtime/rx_action_graph.c (OMEGA_ACTION_GRAPH_IR).
note Verifies linear, diamond, branch/join (both arms), failure/fallback,
note effect proposal/verify/perform, optimization semantic preservation,
note and negative validation gates (cycle, unordered world publish).

global agt_checks ulong 1
global agt_fail ulong 1

text agt_pass "RX_ACTION_GRAPH_OM: PASS\n"
text agt_fail_m "RX_ACTION_GRAPH_OM: FAIL\n"

fn agt_chk cond bool to void
  put agt_checks 0 add get agt_checks 0 1
  if not cond
    if eq get agt_fail 0 0
      put agt_fail 0 get agt_checks 0
    end
  end
end

fn agt_test_linear_and_opt to void
  rx_graph_init 0 7
  ag_obj_reset
  f0 = new ulong 8 0
  put f0 0 15
  ag_obj_set 100 1 f0
  f1 = new ulong 8 0
  ag_obj_set 101 1 f1

  rd = rx_graph_node 0 AG_WORLD_READ AG_T_U64
  rx_graph_set_node 0 ulong rd 6 100
  rx_graph_set_node 0 ulong rd 7 1
  rx_graph_set_node 0 ulong rd 8 0
  rx_graph_set_node 0 ulong rd 9 4

  c1 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c1 3 25
  rx_graph_set_node 0 ulong c1 9 2

  p1 = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong p1 2 AG_OP_ADD
  rx_graph_set_node 0 ulong p1 9 6
  agt_chk eq rx_graph_data 0 ulong rd ulong p1 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong c1 ulong p1 1 AG_EDGE_DATA 0

  v = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong v 3 10
  rx_graph_set_node 0 ulong v 4 100
  rx_graph_set_node 0 ulong v 9 3
  agt_chk eq rx_graph_data 0 ulong p1 ulong v 0 AG_EDGE_DATA 0

  pub = rx_graph_node 0 AG_WORLD_PUBLISH AG_T_RECEIPT
  rx_graph_set_node 0 ulong pub 6 101
  rx_graph_set_node 0 ulong pub 7 1
  rx_graph_set_node 0 ulong pub 8 0
  rx_graph_set_node 0 ulong pub 9 5
  agt_chk eq rx_graph_data 0 ulong p1 ulong pub 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_order 0 ulong v ulong pub 0
  agt_chk eq rx_graph_success 0 ulong pub AG_OK 0

  agt_chk eq rx_graph_validate 0 0
  rx_graph_copy 1 0
  agt_chk eq rx_graph_reference_on 1 1 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
  agt_chk eq get ag_ref_value ulong p1 40
  agt_chk eq get ag_ref_value ulong v 1

  agt_chk eq rx_graph_optimize 0 0
  agt_chk eq rx_graph_validate 0 0
  agt_chk eq rx_graph_check_preserved 1 0 0
  agt_chk eq rx_graph_reference_on 0 2 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
end

fn agt_test_diamond_cse_and_costs to void
  rx_graph_init 0 11
  c1 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c1 3 12
  rx_graph_set_node 0 ulong c1 9 5
  c2 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c2 3 30
  rx_graph_set_node 0 ulong c2 9 5

  note Duplicate pure nodes + dead constant
  pa = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong pa 2 AG_OP_ADD
  rx_graph_set_node 0 ulong pa 9 10
  agt_chk eq rx_graph_data 0 ulong c1 ulong pa 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong c2 ulong pa 1 AG_EDGE_DATA 0

  pb = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong pb 2 AG_OP_ADD
  rx_graph_set_node 0 ulong pb 9 10
  agt_chk eq rx_graph_data 0 ulong c1 ulong pb 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong c2 ulong pb 1 AG_EDGE_DATA 0

  pc = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong pc 2 AG_OP_ADD
  rx_graph_set_node 0 ulong pc 9 8
  agt_chk eq rx_graph_data 0 ulong pa ulong pc 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong pb ulong pc 1 AG_EDGE_DATA 0

  dead = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong dead 3 9999

  v = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong v 3 80
  rx_graph_set_node 0 ulong v 4 90
  rx_graph_set_node 0 ulong v 9 2
  agt_chk eq rx_graph_data 0 ulong pc ulong v 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_success 0 ulong v AG_OK 0

  agt_chk eq rx_graph_validate 0 0
  costs = new ulong 2 0
  rx_graph_costs 0 costs
  agt_chk eq get costs 0 25
  agt_chk eq get costs 1 40

  rx_graph_copy 1 0
  agt_chk eq rx_graph_optimize 0 0
  agt_chk eq rx_graph_validate 0 0
  agt_chk eq rx_graph_check_preserved 1 0 0
  agt_chk lt get ag_n_nodes 0 get ag_n_nodes 1
  ag_obj_reset
  agt_chk eq rx_graph_reference_on 0 3 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
end

fn agt_test_branch_both_arms_and_effects to void
  rx_graph_init 0 3
  ag_obj_reset
  f0 = new ulong 8 0
  put f0 0 42
  ag_obj_set 10 1 f0
  f1 = new ulong 8 0
  ag_obj_set 20 1 f1

  rd = rx_graph_node 0 AG_WORLD_READ AG_T_U64
  rx_graph_set_node 0 ulong rd 6 10
  rx_graph_set_node 0 ulong rd 7 1
  rx_graph_set_node 0 ulong rd 8 0
  br = rx_graph_node 0 AG_BRANCH AG_T_BOOL
  agt_chk eq rx_graph_data 0 ulong rd ulong br 0 AG_EDGE_DATA 0

  arm_t = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong arm_t 2 AG_OP_ADD
  rx_graph_set_node 0 ulong arm_t 3 8
  agt_chk eq rx_graph_data 0 ulong rd ulong arm_t 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_guard 0 ulong br ulong arm_t 1 0

  arm_f = rx_graph_node 0 AG_PURE AG_T_U64
  rx_graph_set_node 0 ulong arm_f 2 AG_OP_ADD
  rx_graph_set_node 0 ulong arm_f 3 77
  agt_chk eq rx_graph_data 0 ulong rd ulong arm_f 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_guard 0 ulong br ulong arm_f 0 0

  jn = rx_graph_node 0 AG_JOIN AG_T_U64
  agt_chk eq rx_graph_data 0 ulong arm_t ulong jn 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong arm_f ulong jn 1 AG_EDGE_DATA 0

  prop = rx_graph_node 0 AG_EFFECT_PROPOSE AG_T_PROPOSAL
  agt_chk eq rx_graph_data 0 ulong jn ulong prop 0 AG_EDGE_DATA 0
  ver = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong ver 3 0
  rx_graph_set_node 0 ulong ver 4 100
  agt_chk eq rx_graph_data 0 ulong jn ulong ver 0 AG_EDGE_DATA 0
  perf = rx_graph_node 0 AG_EFFECT_PERFORM AG_T_RECEIPT
  rx_graph_set_node 0 ulong perf 6 20
  rx_graph_set_node 0 ulong perf 7 1
  agt_chk eq rx_graph_data 0 ulong prop ulong perf 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong ver ulong perf 1 AG_EDGE_DATA 0
  agt_chk eq rx_graph_success 0 ulong perf AG_OK 0

  agt_chk eq rx_graph_validate 0 0
  note True arm (input=42 -> 50)
  agt_chk eq rx_graph_reference_on 0 10 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
  agt_chk eq get ag_ref_value ulong jn 50
  agt_chk eq get ag_ref_eff_cnt 0 1
  agt_chk ne get ag_ref_eff_chain 0 0

  note False arm (input=0 -> 77)
  ag_obj_reset
  put f0 0 0
  ag_obj_set 10 1 f0
  ag_obj_set 20 1 f1
  agt_chk eq rx_graph_reference_on 0 11 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_SUCCESS
  agt_chk eq get ag_ref_value ulong jn 77
  agt_chk eq get ag_ref_eff_cnt 0 1
end

fn agt_test_failure_and_negative_gates to void
  note Verify failure triggers AG_RUN_FAILURE when bound as failure condition
  rx_graph_init 0 5
  c = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c 3 500
  v = rx_graph_node 0 AG_VERIFY AG_T_VERDICT
  rx_graph_set_node 0 ulong v 3 0
  rx_graph_set_node 0 ulong v 4 100
  agt_chk eq rx_graph_data 0 ulong c ulong v 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_failure 0 ulong v AG_FAILED 0
  agt_chk eq rx_graph_validate 0 0
  ag_obj_reset
  agt_chk eq rx_graph_reference_on 0 20 0
  agt_chk eq get ag_ref_outcome 0 AG_RUN_FAILURE

  note Cycle rejected with AG_E_CYCLE
  rx_graph_init 0 1
  a = rx_graph_node 0 AG_PURE AG_T_U64
  b = rx_graph_node 0 AG_PURE AG_T_U64
  agt_chk eq rx_graph_data 0 ulong a ulong b 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong b ulong a 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_validate 0 AG_E_CYCLE

  note Unordered WORLD_PUBLISH rejected with AG_E_EFFECT_ORDER, fixed by rx_graph_order
  rx_graph_init 0 1
  c0 = rx_graph_node 0 AG_CONST AG_T_U64
  rx_graph_set_node 0 ulong c0 3 7
  w1 = rx_graph_node 0 AG_WORLD_PUBLISH AG_T_RECEIPT
  w2 = rx_graph_node 0 AG_WORLD_PUBLISH AG_T_RECEIPT
  agt_chk eq rx_graph_data 0 ulong c0 ulong w1 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_data 0 ulong c0 ulong w2 0 AG_EDGE_DATA 0
  agt_chk eq rx_graph_validate 0 AG_E_EFFECT_ORDER
  agt_chk eq rx_graph_order 0 ulong w1 ulong w2 0
  agt_chk eq rx_graph_validate 0 0
end

fn agt_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len agt_pass
    for i ulong n bound 64
      put buf i get agt_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len agt_fail_m
  for i ulong n bound 64
    put buf i get agt_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  agt_test_linear_and_opt
  agt_test_diamond_cse_and_costs
  agt_test_branch_both_arms_and_effects
  agt_test_failure_and_negative_gates
  if ne get agt_fail 0 0
    agt_put_msg 0
    ret int get agt_fail 0
  end
  agt_put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_capability_graph.om -- Pure seeded OM-2 port of
note tests/runtime/rx_capability_graph.c (M20 Capability Graph & Skill Router).
note Verifies canonical machine identity, ontology & alias compilation,
note register/update-in-place/availability/withdraw/revive lifecycle,
note deterministic skill routing, alternatives, and action-graph binding.

const CG_OP_SCALE ulong 1
const CG_OP_SCALE_FAST ulong 2
const CG_OP_SUMMARIZE ulong 3
const CG_OP_LOCAL_ONLY ulong 4
const CG_ALIAS_SCALE ulong 501
const CG_NOW_US ulong 1000000

global cg_checks ulong 1
global cg_fail ulong 1

text cg_pass "RX_CAPABILITY_GRAPH_OM: PASS\n"
text cg_fail_m "RX_CAPABILITY_GRAPH_OM: FAIL\n"

fn cg_chk cond bool to void
  put cg_checks 0 add get cg_checks 0 1
  if not cond
    if eq get cg_fail 0 0
      put cg_fail 0 get cg_checks 0
    end
  end
end

fn cg_make_ent ent edit ulong 21 cap ulong op ulong real ulong cost ulong src ulong to void
  for i ulong 21
    put ent i 0
  end
  put ent 0 cap
  put ent 1 real
  put ent 2 1
  put ent 4 op
  put ent 5 src
  put ent 6 2
  put ent 7 1
  put ent 8 1
  put ent 9 2
  put ent 12 900000
  put ent 13 990000
  put ent 14 cost
  put ent 15 100
  put ent 16 100
  put ent 18 CQ_LIVE_AVAILABLE
  put ent 20 1
end

fn cg_make_need need edit ulong 15 tr edit ulong 19 op ulong to void
  for i ulong 15
    put need i 0
  end
  for i ulong 19
    put tr i 0
  end
  put need 0 op
  put need 1 1
  put need 2 2
  put need 3 1
  put tr 0 2
  put tr 1 0
  put tr 2 1
  put tr 17 16
end

fn cg_test_lifecycle to void
  mid_a = new uchar 32 0
  put mid_a 0 uchar 1
  mid_b = new uchar 32 0
  put mid_b 0 uchar 2
  cg_chk eq cq_catalog_init_canonical 1 mid_a CQ_OK
  got_r = new ulong 1 0
  got_a = new uchar 32 0
  cg_chk eq cq_machine_identity 1 got_r got_a CQ_OK
  cg_chk eq get got_r 0 1
  cg_chk eq get got_a 0 uchar 1
  bi = new ulong 1 0
  cg_chk eq cq_machine_advertise_id 1 mid_b add CG_NOW_US 1000 bi CQ_OK
  cg_chk ne get bi 0 1
  cg_chk eq cq_machine_index 1 mid_b get bi 0

  cg_chk eq cq_op_define CG_OP_SCALE 0 CQ_SRC_ALL CQ_OK
  cg_chk eq cq_op_define CG_OP_SCALE_FAST CG_OP_SCALE CQ_SRC_ALL CQ_OK
  cg_chk eq cq_op_define CG_OP_SUMMARIZE 0 CQ_SRC_ALL CQ_OK
  cg_chk eq cq_op_define CG_OP_LOCAL_ONLY 0 2 CQ_OK
  cg_chk eq cq_alias CG_ALIAS_SCALE CG_OP_SCALE CQ_OK

  ent = new ulong 21 0
  sdig = new uchar 32 0
  cg_make_ent ent 10 CG_OP_SCALE 100 50 1
  cg_chk eq cq_register ent sdig CQ_OK
  cg_chk eq cq_catalog_build CQ_OK

  need = new ulong 15 0
  tr = new ulong 19 0
  cg_make_need need tr CG_ALIAS_SCALE
  cg_chk eq cq_compile need CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 1
  cg_chk eq get cq_res_cand 0 10

  note Update in place keeps built index and updates cost
  put ent 14 20
  put ent 20 2
  cg_chk eq cq_register ent sdig CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 1
  cg_chk eq get cq_res_cand 0 10

  note Availability toggle
  cg_chk eq cq_set_availability 10 100 1 0 CQ_LIVE_UNAVAILABLE CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 0
  cg_chk eq cq_set_availability 10 100 1 0 CQ_LIVE_AVAILABLE CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 1

  note Withdraw and verify availability cannot revive
  cg_chk eq cq_withdraw 10 100 1 0 CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 0
  cg_chk eq cq_set_availability 10 100 1 0 CQ_LIVE_AVAILABLE CQ_E_WITHDRAWN
  cg_chk eq cq_withdraw 99 1 1 0 CQ_E_NOT_FOUND

  note Re-register revives; changing op requires rebuild
  put ent 20 3
  cg_chk eq cq_register ent sdig CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_OK
  cg_chk eq get cq_res_n 0 1
  put ent 4 CG_OP_SUMMARIZE
  cg_chk eq cq_register ent sdig CQ_OK
  cg_chk eq cq_query need tr CG_NOW_US CQ_E_UNBUILT
end

fn cg_test_skill_routing_and_graph to void
  mid_a = new uchar 32 0
  put mid_a 0 uchar 11
  cg_chk eq cq_catalog_init_canonical 1 mid_a CQ_OK
  cg_chk eq cq_op_define CG_OP_SCALE 0 CQ_SRC_ALL CQ_OK
  cg_chk eq cq_op_define CG_OP_SCALE_FAST CG_OP_SCALE CQ_SRC_ALL CQ_OK
  cg_chk eq cq_op_define CG_OP_SUMMARIZE 0 CQ_SRC_ALL CQ_OK
  cg_chk eq cq_alias CG_ALIAS_SCALE CG_OP_SCALE CQ_OK

  sr_skills_reset
  d7 = new uchar 32 0
  put d7 0 uchar 7
  d9 = new uchar 32 0
  put d9 0 uchar 9
  cg_chk eq sr_skills_add 7 d7 SR_OK
  cg_chk eq sr_skills_add 9 d9 SR_OK

  ent = new ulong 21 0
  cg_make_ent ent 1 CG_OP_SCALE 70 15 2
  cg_chk eq sr_register_skill 7 1 1 d7 ent SR_OK
  cg_make_ent ent 2 CG_OP_SCALE_FAST 90 35 2
  cg_chk eq sr_register_skill 9 1 1 d9 ent SR_OK
  cg_chk eq cq_catalog_build CQ_OK

  need = new ulong 15 0
  tr = new ulong 19 0
  cg_make_need need tr CG_ALIAS_SCALE
  rpin = new ulong 5 0
  put rpin 0 1
  pdig = new uchar 32 0

  note Deterministic routing picks skill 7 (cost 15 < 35)
  cg_chk eq sr_route need tr rpin pdig CG_NOW_US SR_OK
  cg_chk eq get sr_out_meta 8 7
  cg_chk eq sr_route_check 0 CG_NOW_US SR_OK

  note Bind chosen skill into an Action Graph node
  rx_graph_init 0 0
  n_in = rx_graph_node 0 AG_CONST AG_T_U64
  n_sk = rx_graph_node 0 AG_SKILL AG_T_U64
  cg_chk ge n_in 0
  cg_chk ge n_sk 0
  cg_chk eq sr_bind_route 0 ulong n_sk 0 CG_NOW_US SR_OK
  cg_chk eq rx_graph_get_node 0 ulong n_sk 2 7

  note Querying child op CG_OP_SCALE_FAST selects skill 9
  cg_make_need need tr CG_OP_SCALE_FAST
  cg_chk eq sr_route need tr rpin pdig CG_NOW_US SR_OK
  cg_chk eq get sr_out_meta 8 9

  note No-candidate case for unprovided op CG_OP_SUMMARIZE
  cg_make_need need tr CG_OP_SUMMARIZE
  cg_chk eq sr_route need tr rpin pdig CG_NOW_US SR_E_NO_CANDIDATE
end

fn cg_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len cg_pass
    for i ulong n bound 64
      put buf i get cg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len cg_fail_m
  for i ulong n bound 64
    put buf i get cg_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  cg_test_lifecycle
  cg_test_skill_routing_and_graph
  if eq get cg_fail 0 0
    cg_put_msg 1
    ret 0
  end
  cg_put_msg 0
  ret int get cg_fail 0
end

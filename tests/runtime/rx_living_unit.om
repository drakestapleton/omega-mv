note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_living_unit.om -- Pure seeded OM-2 unit/parity test for rx_living.om.

global rxl_u_checks ulong 1
global rxl_u_fail ulong 1

text rxl_msg_pass "RX_LIVING_OM: PASS\n"
text rxl_msg_fail "RX_LIVING_OM: FAIL\n"

fn rxl_chk cond bool to void
  put rxl_u_checks 0 add get rxl_u_checks 0 1
  if not cond
    put rxl_u_fail 0 add get rxl_u_fail 0 1
  end
end

fn test_object_digest_and_trials to void
  f = new ulong 8 0
  put f 0 1
  put f 1 2
  put f 2 3
  put f 3 4
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  rx_living_object_digest 24880 f d1
  rx_living_object_digest 24880 f d2
  for i ulong 32
    rxl_chk eq get d1 i get d2 i
  end
  note Changing type changes digest
  rx_living_object_digest 24881 f d2
  diff = ulong 0
  for i ulong 32
    if ne get d1 i get d2 i
      diff = ulong 1
    end
  end
  rxl_chk eq diff 1
  note Verify trial_a / trial_b wrap-around arithmetic
  ta0 = rx_living_trial_a 1 0
  tb0 = rx_living_trial_b 2 0
  rxl_chk eq ta0 ulong 4294967056
  rxl_chk eq tb0 512
  rxl_chk eq and add ta0 tb0 4294967295 272
end

fn test_experiment_and_promotion to void
  rxl_chk eq rx_living_create 0
  rxl_chk eq rx_living_register 0 -1
  rxl_chk eq rx_living_register 1 0
  rxl_chk eq rx_living_register_restore 1 0
  note Enroll 9 production callers across 5 keyrings
  rxl_chk eq rx_living_enroll_callers 1 -27
  rxl_chk eq rx_living_enroll_callers 0 0
  rxl_chk eq get rxl_kr_counts 0 2
  rxl_chk eq get rxl_kr_counts 1 1
  rxl_chk eq get rxl_kr_counts 2 2
  rxl_chk eq get rxl_kr_counts 3 3
  rxl_chk eq get rxl_kr_counts 4 1
  note Prepare experiment for epoch 2, plan 1
  put rxl_search 0 2
  put rxl_search 6 1
  put rxl_plan 0 1
  rxl_chk eq rx_living_fn_prepare 0
  rxl_chk eq get rxl_input 2 2
  rxl_chk eq get rxl_input 3 0
  note Run all 16 trials: seat -> evidence
  for t ulong 16
    rxl_chk eq rx_living_fn_seat_step 0
    rxl_chk eq rx_living_fn_evidence 0
  end
  rxl_chk eq get rxl_evidence 0 2
  rxl_chk eq get rxl_evidence 3 1
  rxl_chk eq get rxl_evidence 4 16
  note Set selection and belief, run generation.prepare
  put rxl_selection 0 2
  put rxl_selection 1 9999
  put rxl_selection 5 450
  put rxl_selection 6 12345
  put rxl_belief 0 2
  put rxl_belief 2 1
  note Refusal when authorship check fails
  put rxl_st 14 0
  rxl_chk eq rx_living_fn_candidate 0
  rxl_chk eq get rxl_st 5 1
  rxl_chk eq get rxl_st 6 RX_LIVING_WHY_AUTHOR
  note Now pass all checks
  put rxl_st 14 1
  rxl_chk eq rx_living_fn_candidate 0
  rxl_chk eq get rxl_candidate 0 1
  rxl_chk eq get rxl_candidate 1 2
  rxl_chk eq get rxl_candidate 2 9999
  note Promotion fails without valid native authority cap
  rxl_chk eq rx_living_fn_promote 7 1 0
  rxl_chk ne get rxl_promotion 1 0
  rxl_chk eq get rxl_inforce 0 0
  note Grant native authority cap and re-promote new candidate
  rxl_cap_set 0 7 1 RX_LIVING_PROMOTE_SUBJ 2309 512
  put rxl_candidate 0 2
  put rxl_promotion 0 0
  rxl_chk eq rx_living_fn_promote 7 1 0
  rxl_chk eq get rxl_promotion 1 0
  rxl_chk eq get rxl_inforce 0 2
  rxl_chk eq get rxl_inforce 1 9999
  rxl_chk eq get rxl_inforce 7 2
end

fn test_restore to void
  note Genesis restore (code_len == 0 -> REFERENCE)
  put rxl_restore 0 1
  put rxl_blob_meta 0 0
  rxl_chk eq rx_living_fn_restore 0
  rxl_chk eq get rxl_restore 2 RX_LIVING_RESTORE_REFERENCE
  note Restore with bad config magic -> REFUSED
  put rxl_restore 0 2
  put rxl_blob_meta 0 16
  put rxl_blob_meta 1 0
  put rxl_blob_meta 2 1
  put rxl_blob_meta 3 1
  rxl_chk eq rx_living_fn_restore 0
  rxl_chk eq get rxl_restore 2 RX_LIVING_RESTORE_REFUSED
  rxl_chk eq get rxl_restore 5 RX_LIVING_RESTORE_WHY_CONFIG
  note Restore with matching identity -> RESTORED
  put rxl_restore 0 3
  put rxl_blob_meta 1 1
  put rxl_blob_meta 6 777
  put rxl_blob_meta 7 5
  put rxl_blob_meta 8 300
  put rxl_blob_cfg_id 0 42
  put rxl_blob_act_id 0 42
  rxl_chk eq rx_living_fn_restore 0
  rxl_chk eq get rxl_restore 2 RX_LIVING_RESTORE_RESTORED
  rxl_chk eq get rxl_inforce 0 5
  rxl_chk eq get rxl_inforce 1 42
end

fn test_lessons to void
  note Cortex lesson evidence gate, promote, and explored_keys
  ev_f = new ulong 8 0
  put ev_f 0 2
  put ev_f 3 1
  put ev_f 4 16
  dg = new uchar 32 0
  rx_living_object_digest 24882 ev_f dg
  ev_pay = new ulong 5 0
  for i ulong 4
    w = ulong 0
    for b ulong 8
      w = or w shl ulong get dg add mul i 8 b mul b 8
    end
    put ev_pay i w
  end
  put ev_pay 4 10
  hdr = new ulong 5 0
  put hdr 0 RXL_CX_K_EVIDENCE_REF
  put hdr 1 99
  put hdr 2 5
  put hdr 3 0
  put hdr 4 0
  ev_id = rxl_cx_append hdr ev_pay
  rxl_chk eq rx_living_lesson_evidence_ok ev_id dg 0
  note Tampered digest fails evidence gate
  put dg 0 xor get dg 0 1
  rxl_chk eq rx_living_lesson_evidence_ok ev_id dg -1
  put dg 0 xor get dg 0 1
  note Append candidate lesson and promote it
  c_pay = new ulong 13 0
  put c_pay 12 88888
  put hdr 0 RXL_CX_K_CANDIDATE
  put hdr 2 13
  put hdr 4 ev_id
  cand_id = rxl_cx_append hdr c_pay
  out_pid = new ulong 1 0
  rxl_chk eq rx_living_lesson_promote cand_id ev_id dg out_pid 0
  rxl_chk ne get out_pid 0 0
  note Append second unpromoted candidate -> must not appear in explored_keys
  put c_pay 12 77777
  ign_c2 = rxl_cx_append hdr c_pay
  keys = new ulong 8 0
  nk = rx_living_explored_keys 99 keys 8
  rxl_chk eq nk 1
  rxl_chk eq get keys 0 88888
end

fn rxl_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len rxl_msg_pass
    for i ulong n bound 64
      put buf i get rxl_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len rxl_msg_fail
  for i ulong n bound 64
    put buf i get rxl_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_object_digest_and_trials
  test_experiment_and_promotion
  test_restore
  test_lessons
  if eq get rxl_u_fail 0 0
    rxl_put_msg 1
    ret 0
  end
  rxl_put_msg 0
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_projection_unit.om -- Pure seeded OM-2 unit test for rx_projection.om.

global pjt_checks ulong 1
global pjt_fail ulong 1
global pjt_first ulong 1

text pjt_pass "RX_PROJECTION_OM: PASS\n"
text pjt_fail_msg "RX_PROJECTION_OM: FAIL\n"

fn pjt_chk cond bool to void
  c = add get pjt_checks 0 1
  put pjt_checks 0 c
  if not cond
    if eq get pjt_first 0 0
      put pjt_first 0 c
    end
    put pjt_fail 0 add get pjt_fail 0 1
  end
end

fn pjt_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len pjt_pass
    for i ulong n bound 64
      put buf i get pjt_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len pjt_fail_msg
  for i ulong n bound 64
    put buf i get pjt_fail_msg i
  end
  ign_f = write 1 buf 0 n
end

fn pjt_populate to void
  pjt_chk eq cx_init 0 8 CX_OK
  hdr = new ulong 12 0
  pay = new ulong 4 0
  note id=1: verified evidence for subject 1 at t=10
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_EVIDENCE
  put hdr 1 100
  put hdr 2 1
  put hdr 3 10
  put hdr 6 CX_PROT_VERIFY_EVIDENCE
  put hdr 7 PJ_VERIFIED
  put pay 0 777
  pjt_chk eq cx_append 0 hdr pay 1 CX_OK

  note id=2: realization for subject 1 at t=10 linked to evidence 1
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_REALIZATION
  put hdr 1 200
  put hdr 2 1
  put hdr 3 10
  put hdr 8 1
  put pay 0 10
  put pay 1 20
  pjt_chk eq cx_append 0 hdr pay 2 CX_OK

  note id=3..5: observations for subject 1 at t=12, 15, 20
  for k ulong 3
    for i ulong 12
      put hdr i 0
    end
    put hdr 0 CX_OBSERVATION
    put hdr 1 300
    put hdr 2 1
    put hdr 3 add 12 mul k 4
    put pay 0 add 10 mul k 5
    put pay 1 add 20 mul k 5
    put pay 2 add 30 mul k 5
    pjt_chk eq cx_append 0 hdr pay 3 CX_OK
  end

  note id=6: observation for subject 2 (other subject) at t=14
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_OBSERVATION
  put hdr 1 300
  put hdr 2 2
  put hdr 3 14
  put pay 0 99
  pjt_chk eq cx_append 0 hdr pay 1 CX_OK

  note id=7: branch-1 observation for subject 1 at t=22
  for i ulong 12
    put hdr i 0
  end
  put hdr 0 CX_OBSERVATION
  put hdr 1 300
  put hdr 2 1
  put hdr 3 22
  put hdr 5 1
  put pay 0 500
  pjt_chk eq cx_append 0 hdr pay 1 CX_OK
end

fn test_compile_and_audit to void
  note Anchor SINCE_VERIFIED + compressible observations + derived feature
  pj_need_init PJ_OP_ASSESS 1 25
  put pj_need 6 PJ_A_SINCE_VERIFIED
  put pj_need 9 200
  put pj_need 13 PJ_E_REFS
  pjt_chk eq pj_need_add CX_OBSERVATION 300 PJ_COMPRESSIBLE PJ_W_SELF PJ_T_WINDOW PJ_OK
  pjt_chk eq pj_need_add CX_OBSERVATION 300 PJ_DERIVED PJ_W_SELF PJ_T_WINDOW PJ_OK
  pjt_chk eq pj_compile 0 PJ_OK
  note Anchor id=2 (FULL) + evidence id=1 (REF) + 3 obs ids 3,4,5 (SUMMARY) = 5 entries, 1 feature
  pjt_chk eq get pj_meta 0 5
  pjt_chk eq get pj_meta 1 1
  pjt_chk eq get pj_meta 10 10
  pjt_chk eq get pj_meta 11 2
  note Derived feature over 3 obs: 9 words, sum = (10+20+30)+(15+25+35)+(20+30+40) = 225, min=10, max=40
  pjt_chk eq get pj_feat 7 3
  pjt_chk eq get pj_feat 8 9
  pjt_chk eq get pj_feat 9 225
  pjt_chk eq get pj_feat 11 10
  pjt_chk eq get pj_feat 12 40
  note Binary search view_find and recall on summarized/ref entries
  pjt_chk ge pj_view_find 1 0
  pjt_chk ge pj_view_find 3 0
  pjt_chk lt pj_view_find 6 0
  pjt_chk eq pj_recall 0 3 3
  note Recoverability passes before tamper
  pjt_chk eq pj_recover_all 0 PJ_OK
  note Audit: 5 included, 2 excluded (id=6 subject, id=7 branch), counts_match=1, other_branch=0
  pjt_chk eq pj_audit 0 PJ_OK
  pjt_chk eq get pj_audit_out 0 5
  pjt_chk eq get pj_audit_out 1 2
  pjt_chk eq get pj_audit_out 2 2
  pjt_chk eq get pj_audit_out 4 0
  pjt_chk eq get pj_audit_out 5 1
  pjt_chk eq get pj_audit_out add 6 PJ_WHY_SUBJECT 1
  pjt_chk eq get pj_audit_out add 6 PJ_WHY_BRANCH 1
  note Tamper id=3 -> recall and recover_all must refuse
  cx_tamper 0 3 0 9999
  pjt_chk lt pj_recall 0 3 0
  pjt_chk eq pj_recover_all 0 PJ_ERR_RECOVER
  cx_tamper 0 3 0 10
end

fn test_protected_refusal to void
  note Asking to summarize protected evidence must fail with PJ_ERR_PROTECTED
  pj_need_init PJ_OP_VERIFY 1 25
  pjt_chk eq pj_need_add CX_EVIDENCE 100 PJ_COMPRESSIBLE PJ_W_SELF PJ_T_ALL PJ_OK
  pjt_chk eq pj_compile 0 PJ_ERR_PROTECTED
  note Asking to derive protected evidence must fail with PJ_ERR_PROTECTED
  pj_need_init PJ_OP_VERIFY 1 25
  pjt_chk eq pj_need_add CX_EVIDENCE 100 PJ_DERIVED PJ_W_SELF PJ_T_ALL PJ_OK
  pjt_chk eq pj_compile 0 PJ_ERR_PROTECTED
  note Budget refusal
  pj_need_init PJ_OP_VERIFY 1 25
  put pj_need 15 10
  pjt_chk eq pj_need_add CX_OBSERVATION 300 PJ_LIVE PJ_W_SELF PJ_T_ALL PJ_OK
  pjt_chk eq pj_compile 0 PJ_ERR_BUDGET
end

fn main to int
  pjt_populate
  test_compile_and_audit
  test_protected_refusal
  if ne get pjt_fail 0 0
    pjt_put_msg 0
    ret int get pjt_first 0
  end
  pjt_put_msg 1
  ret 0
end

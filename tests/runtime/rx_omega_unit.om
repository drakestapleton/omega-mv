note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_omega_unit.om -- Pure seeded OM-2 unit/parity test for rx_omega.om.

global rxo_u_checks ulong 1
global rxo_u_fail ulong 1

text rxo_msg_pass "RX_OMEGA_OM: PASS\n"
text rxo_msg_fail "RX_OMEGA_OM: FAIL\n"

fn rxo_chk cond bool to void
  put rxo_u_checks 0 add get rxo_u_checks 0 1
  if not cond
    put rxo_u_fail 0 add get rxo_u_fail 0 1
  end
end

fn test_fill_and_digest to void
  note Verify SplitMix64 fill and SHA-256 digest against C reference values
  a = new ulong 12 0
  x = new ulong 4 0
  y = new ulong 3 0
  rx_omega_fill 42 a x rx_omega_regime 3 4
  note C oracle for seed=42: first mix(42) = 0xbdd732262feb6e95
  rxo_chk eq get a 0 ulong 13679457532755275413
  rx_omega_matvec_ref a x y
  d1 = rx_omega_digest y 3
  d2 = rx_omega_digest y 3
  rxo_chk eq d1 d2
  rxo_chk ne d1 0
  note Flipping one output element changes digest
  put y 0 xor get y 0 1
  d3 = rx_omega_digest y 3
  rxo_chk ne d1 d3
end

fn test_full_pipeline to void
  rx_omega_default_config
  rxo_chk eq get rxo_cfg 0 4
  rxo_chk eq get rxo_cfg 2 64
  rxo_chk eq get rxo_cfg 3 1000000
  rxo_chk eq get rxo_cfg 4 5
  rxo_chk eq get rxo_cfg 5 5000
  put rxo_cfg 2 16
  put rxo_cfg 3 100
  rxo_chk eq rx_omega_create_objects 0
  rxo_chk eq rx_omega_register 0
  note Serve 16 requests of regime (4, 8) on reference
  for s ulong 16
    put rxo_request 0 add s 1
    put rxo_request 1 4
    put rxo_request 2 8
    put rxo_request 3 add s 100
    rxo_chk eq rx_omega_fn_serve 0
  end
  rxo_chk eq get rxo_demand 0 16
  rxo_chk eq get rxo_demand 2 1
  rxo_chk eq get rxo_st 3 16
  rxo_chk eq get rxo_st 4 0
  note Watch triggers search epoch 1
  rxo_chk eq rx_omega_fn_watch 0
  rxo_chk eq get rxo_search 0 1
  rxo_chk eq get rxo_search 1 4
  rxo_chk eq get rxo_search 2 8
  note Synthesize, verify, measure all 4 slots
  for k ulong 4
    rxo_chk eq rx_omega_fn_synthesize k 0
    rxo_chk eq get rxo_candidate add mul k 8 7 RX_OMEGA_SYNTHESIZED
    rxo_chk eq rx_omega_fn_verify k 0
    rxo_chk eq get rxo_verdict add mul k 8 1 RX_OMEGA_PASSED
    rxo_chk eq rx_omega_fn_measure k 0
    rxo_chk eq get rxo_measure add mul k 8 1 RX_OMEGA_MEASURED
  end
  note Select picks fastest realization beating reference by >= 5%
  rxo_chk eq rx_omega_fn_select 0
  rxo_chk eq get rxo_selection 0 1
  rxo_chk ne get rxo_selection 1 0
  rxo_chk eq get rxo_selection 6 rx_omega_regime 4 8
  rxo_chk lt get rxo_selection 5 get rxo_selection 7
  note Next serve uses selected realization!
  put rxo_request 0 17
  rxo_chk eq rx_omega_fn_serve 0
  rxo_chk eq get rxo_result 2 get rxo_selection 1
  rxo_chk eq get rxo_st 4 1
end

fn test_defects_and_readmit to void
  note Test SKIP_REMAINDER, TAMPER, CRASH defects
  rx_omega_default_config
  put rxo_cfg 1 RX_OMEGA_DEFECT_SKIP_REMAINDER
  rxo_chk eq rx_omega_create_objects 0
  rxo_chk eq get rxo_cfg 0 5
  put rxo_search 0 1
  put rxo_search 1 4
  put rxo_search 2 7
  rxo_chk eq rx_omega_fn_synthesize 4 0
  rxo_chk eq rx_omega_fn_verify 4 0
  rxo_chk eq get rxo_verdict 33 RX_OMEGA_REFUSED
  rxo_chk eq get rxo_verdict 37 RX_OMEGA_WHY_DIFFERENTIAL

  rx_omega_default_config
  put rxo_cfg 1 RX_OMEGA_DEFECT_TAMPER
  rxo_chk eq rx_omega_create_objects 0
  put rxo_search 0 1
  put rxo_search 1 4
  put rxo_search 2 8
  rxo_chk eq rx_omega_fn_synthesize 4 0
  rxo_chk eq rx_omega_fn_verify 4 0
  rxo_chk eq get rxo_verdict 33 RX_OMEGA_REFUSED
  rxo_chk eq get rxo_verdict 37 RX_OMEGA_WHY_IDENTITY

  rx_omega_default_config
  put rxo_cfg 1 RX_OMEGA_DEFECT_CRASH
  rxo_chk eq rx_omega_create_objects 0
  put rxo_search 0 1
  put rxo_search 1 4
  put rxo_search 2 8
  rxo_chk eq rx_omega_fn_synthesize 4 0
  rxo_chk eq rx_omega_fn_verify 4 0
  rxo_chk eq get rxo_verdict 33 RX_OMEGA_REFUSED
  rxo_chk eq get rxo_verdict 37 RX_OMEGA_WHY_CRASHED
  rxo_chk eq get rxo_st 6 1

  note Test readmit (R14) + reconsider (R11) + require_evidence (R13)
  rx_omega_default_config
  rxo_chk eq rx_omega_create_objects 0
  rxo_chk eq rx_omega_require_evidence 1 0
  rxo_chk eq rx_omega_require_evidence 4294967295 -1
  rxo_chk eq rx_omega_serve_from 2 0
  rxo_chk eq rx_omega_register_reconsider 0
  code = new uchar 256 0
  clen = rxo_synth_code 2 0 code
  id_out = new uchar 32 0
  rxo_chk eq rx_omega_readmit code or shl ulong 2 32 clen rx_omega_regime 4 8 id_out 0
  rxo_chk eq get rxo_readmit_why 0 RX_OMEGA_WHY_NONE
  note Bad structural bytes refused by readmit
  put code 0 0
  rxo_chk eq rx_omega_readmit code or shl ulong 2 32 clen rx_omega_regime 4 8 id_out 1
  rxo_chk eq get rxo_readmit_why 0 RX_OMEGA_WHY_STRUCTURE
  note Reconsider opens epoch 2 when search == selection
  put rxo_search 0 1
  put rxo_selection 0 1
  put rxo_inquiry 0 10
  put rxo_inquiry 1 RX_OMEGA_INQ_RESEARCH
  put rxo_inquiry 2 rx_omega_regime 6 8
  rxo_chk eq rx_omega_fn_reconsider 0
  rxo_chk eq get rxo_search 0 2
  rxo_chk eq get rxo_search 6 10
end

fn rxo_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len rxo_msg_pass
    for i ulong n bound 64
      put buf i get rxo_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len rxo_msg_fail
  for i ulong n bound 64
    put buf i get rxo_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_fill_and_digest
  test_full_pipeline
  test_defects_and_readmit
  if eq get rxo_u_fail 0 0
    rxo_put_msg 1
    ret 0
  end
  rxo_put_msg 0
  ret 1
end

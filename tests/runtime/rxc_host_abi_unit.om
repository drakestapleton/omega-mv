note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rxc_host_abi_unit.om -- Pure seeded OM-2 unit/contract test for
note src/runtime/rxc_host_abi.om covering all 13 external functions of rxc_host_abi.c.

global rhu_checks ulong 1
global rhu_fail ulong 1

text rhu_pass "RXC_HOST_ABI_OM: PASS\n"
text rhu_fail_m "RXC_HOST_ABI_OM: FAIL\n"
text rhu_dir1 "/tmp/rxc_host_om_home1"
text rhu_dir2 "/tmp/rxc_host_om_home2"
text rhu_bad_dir "/tmp/../escape"
text rhu_root1 "np1-host-abi-test-machine"
text rhu_root2 "np1-some-other-machine"
text rhu_sk1 "np1.echo-proposal"
text rhu_sk2 "np1.double-proposal"
text rhu_note1 "constraint:max-latency=50ms"
text rhu_note2 "auth:operator-approved"
text rhu_note3 "effect:receipt-001"
text rhu_cut "TORN_TAIL_BYTES_1234"

fn rhu_chk cond bool to void
  put rhu_checks 0 add get rhu_checks 0 1
  if not cond
    if eq get rhu_fail 0 0
      put rhu_fail 0 get rhu_checks 0
    end
  end
end

fn rhu_test_layout_and_args to void
  hab_reset_all
  sz = new ulong 4 0
  ver = rxc_host_abi_layout sz
  rhu_chk eq ver RXC_HOST_ABI_VERSION
  rhu_chk eq get sz 0 88
  rhu_chk eq get sz 1 192
  rhu_chk eq get sz 2 128
  rhu_chk eq get sz 3 168

  note Bad path and nonzero flags refused
  rhu_chk eq rxc_host_open rhu_bad_dir RXC_HOST_ROOT_PROVISIONED rhu_root1 0 RXC_HOST_E_ARG
  rhu_chk eq rxc_host_open rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 1 RXC_HOST_E_ARG
  rhu_chk eq rxc_host_open rhu_dir1 99 rhu_root1 0 RXC_HOST_E_IDENTITY
end

global rhu_mid_saved uchar 32
global rhu_n1 ulong 1

fn rhu_test_notes_and_recall h ulong to void
  links = new ulong 4 0
  put links 0 9999
  rhu_chk eq rxc_host_note h RXC_HOST_NOTE_CONSTRAINT links rhu_note1 RXC_HOST_E_NOT_FOUND
  put links 0 get hab_res_out 14
  n1 = rxc_host_note h RXC_HOST_NOTE_CONSTRAINT links rhu_note1
  rhu_chk gt n1 0
  n2 = rxc_host_note h RXC_HOST_NOTE_AUTHORIZATION links rhu_note2
  rhu_chk gt n2 n1
  n3 = rxc_host_note h RXC_HOST_NOTE_EFFECT links rhu_note3
  rhu_chk gt n3 n2
  put rhu_n1 0 ulong n1

  ids = new ulong 64 0
  cnts = new ulong 2 0
  rhu_chk eq rxc_host_recall h RXC_HOST_SUBJECT_HOST ids 64 cnts RXC_HOST_OK
  rhu_chk eq get cnts 0 3
  rhu_chk eq get cnts 1 3
  rhu_chk eq get ids 0 ulong n1
end

fn rhu_test_record_and_payload h ulong to void
  n1 = get rhu_n1 0
  rhu_chk eq rxc_host_record h n1 RXC_HOST_OK
  rhu_chk eq get hab_rec_out 0 n1
  rhu_chk eq get hab_rec_out 3 RXC_HOST_SUBJECT_HOST
  rhu_chk eq get hab_rec_out 6 RXC_HOST_NOTE_CONSTRAINT
  rhu_chk eq get hab_rec_ver 0 1

  pay = new ulong 20 0
  nw = rxc_host_payload h n1 pay 20
  rhu_chk gt nw 5
  rhu_chk eq get pay RXC_HOST_NP_LEN len rhu_note1
end

fn rhu_test_lifecycle_run_recall_note to void
  hab_reset_all
  h_l = rxc_host_open rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 0
  rhu_chk ge h_l 0
  h = ulong h_l
  rhu_chk eq get hab_info_out 0 RXC_HOST_ABI_VERSION
  rhu_chk eq get hab_info_out 1 RXC_HOST_ROOT_PROVISIONED
  rhu_chk eq get hab_info_out 2 0
  rhu_chk eq get hab_info_out 4 0

  for i ulong 32
    put rhu_mid_saved i get hab_info_mid i
  end

  rhu_chk eq rxc_host_run h 10 1000 RXC_HOST_E_STATE

  rhu_chk eq rxc_host_register_skill h rhu_sk1 10 RXC_HOST_SK_ECHO3P1 0
  rhu_chk eq rxc_host_register_skill h rhu_sk2 20 RXC_HOST_SK_DOUBLE 1
  rhu_chk eq rxc_host_register_skill h rhu_sk1 30 RXC_HOST_SK_ECHO3P1 RXC_HOST_E_FULL

  rhu_chk eq rxc_host_set_verify h RXC_HOST_VFY_ECHO3P1 RXC_HOST_OK
  rhu_chk eq rxc_host_set_wait_ms h 0 RXC_ERR_ARG
  rhu_chk eq rxc_host_set_wait_ms h 5000 RXC_OK

  rhu_chk eq rxc_host_run h 7 1000000 RXC_HOST_OK
  rhu_chk eq get hab_res_out 1 RXC_HOST_OUT_COMMITTED
  rhu_chk eq get hab_res_out 2 1
  rhu_chk eq get hab_res_out 5 0
  rhu_chk eq get hab_res_out 6 0
  rhu_chk eq get hab_res_out 7 1
  rhu_chk eq get hab_res_out 9 22
  rhu_chk gt get hab_res_out 10 0
  rhu_chk gt get hab_res_out 13 0
  rhu_chk gt get hab_res_out 14 0

  rhu_chk eq rxc_host_register_skill h rhu_sk1 5 RXC_HOST_SK_ECHO3P1 RXC_HOST_E_STATE
  rhu_chk eq rxc_host_set_verify h RXC_HOST_VFY_DEFAULT RXC_HOST_E_STATE

  rhu_test_notes_and_recall h
  rhu_test_record_and_payload h

  rhu_chk eq rxc_host_recover rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 RXC_HOST_E_OPEN

  rhu_chk eq rxc_host_info h RXC_HOST_OK
  rhu_chk eq get hab_info_out 4 1
  rhu_chk eq get hab_info_out 11 2

  rxc_host_close h

  rhu_chk eq rxc_host_open rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root2 0 RXC_HOST_E_IDENTITY

  h2_l = rxc_host_open rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 0
  rhu_chk ge h2_l 0
  rhu_chk eq get hab_info_out 2 1
  for i ulong 32
    rhu_chk eq get hab_info_mid i get rhu_mid_saved i
  end
  rxc_host_close ulong h2_l
end

fn rhu_test_torn_tail_and_recover to void
  note Inject torn tail on closed home dir1
  rhu_chk eq hab_set_cut_bytes rhu_dir1 rhu_cut RXC_HOST_OK
  rhu_chk eq hab_inject_fault rhu_dir1 1 512 532 0 RXC_HOST_OK

  note Default open refuses torn tail
  rhu_chk eq rxc_host_open rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 0 RXC_HOST_E_TORN
  rhu_chk eq get hab_info_out 3 1

  note Wrong machine may not repair
  rhu_chk eq rxc_host_recover rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root2 RXC_HOST_E_IDENTITY

  note Right machine repairs torn tail and writes repair record
  rhu_chk eq rxc_host_recover rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 RXC_HOST_OK
  rhu_chk eq get hab_rep_out 0 1
  rhu_chk eq get hab_rep_out 1 1
  rhu_chk eq get hab_rep_cause 0 RXC_HOST_CX_ERR_TORN
  rhu_chk eq get hab_rep_out 4 1
  rhu_chk eq get hab_rep_out 8 512
  rhu_chk eq get hab_rep_out 9 532
  rhu_chk eq get hab_rep_out 15 len rhu_cut

  note Second recover is idempotent (repaired = 0)
  rhu_chk eq rxc_host_recover rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 RXC_HOST_OK
  rhu_chk eq get hab_rep_out 0 0

  note Anchor mismatch refuses recover with RXC_HOST_E_REPLAY
  rhu_chk eq hab_inject_fault rhu_dir1 0 512 512 1 RXC_HOST_OK
  rhu_chk eq rxc_host_recover rhu_dir1 RXC_HOST_ROOT_PROVISIONED rhu_root1 RXC_HOST_E_REPLAY
end

fn rhu_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len rhu_pass
    for i ulong n bound 64
      put buf i get rhu_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len rhu_fail_m
  for i ulong n bound 64
    put buf i get rhu_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  rhu_test_layout_and_args
  rhu_test_lifecycle_run_recall_note
  rhu_test_torn_tail_and_recover
  if ne get rhu_fail 0 0
    rhu_put_msg 0
    ret int get rhu_fail 0
  end
  rhu_put_msg 1
  ret 0
end

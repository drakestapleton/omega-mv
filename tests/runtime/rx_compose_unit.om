note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_compose_unit.om -- Pure seeded OM-2 unit test for rx_compose.om.

global rct_checks ulong 1
global rct_fail ulong 1

text rct_dir0 "/tmp/compose_0"
text rct_dir1 "/tmp/compose_1"
text rct_msg_pass "RX_COMPOSE_OM: PASS\n"
text rct_msg_fail "RX_COMPOSE_OM: FAIL\n"

fn rct_chk cond bool to void
  put rct_checks 0 add get rct_checks 0 1
  if not cond
    put rct_fail 0 add get rct_fail 0 1
  end
end

fn test_open_run_commit_and_digest to void
  dbuf = new uchar 128 0
  dl = len rct_dir0
  for i ulong dl bound 128
    put dbuf i get rct_dir0 i
  end
  rct_chk eq rx_compose_open dbuf dl 1 4242 RXC_OK
  st = new ulong 2 0
  rct_chk eq rx_compose_state st RXC_OK
  rct_chk eq get st 0 1
  rct_chk eq get st 1 1
  note wait_ms bounds check
  rct_chk eq rx_compose_set_wait_ms 0 RXC_ERR_ARG
  rct_chk eq rx_compose_set_wait_ms add RXC_WAIT_MS_MAX 1 RXC_ERR_ARG
  rct_chk eq rx_compose_set_wait_ms 5000 RXC_OK
  rct_chk eq rx_compose_set_remote 1 RXC_OK
  note Run where candidate 0 fails contract and candidate 1 passes
  rct_chk eq rx_compose_run 100 999 0 200 1 RXC_OK
  rct_chk eq get rxc_last_res 0 RXC_OUT_COMMITTED
  rct_chk eq get rxc_last_res 1 1
  rct_chk eq get rxc_last_res 6 200
  rct_chk eq get rxc_last_res 7 1
  rct_chk gt get rxc_last_res 11 0
  note State advanced to winner branch
  rct_chk eq rx_compose_state st RXC_OK
  rct_chk eq get st 0 get rxc_last_res 4
  note Run where neither candidate passes contract -> NO_WINNER, state unchanged
  prev_id = get st 0
  rct_chk eq rx_compose_run 101 111 0 222 0 RXC_OK
  rct_chk eq get rxc_last_res 0 RXC_OUT_NO_WINNER
  rct_chk eq get rxc_last_res 1 RXC_NONE
  rct_chk eq get rxc_last_res 7 2
  rct_chk eq rx_compose_state st RXC_OK
  rct_chk eq get st 0 prev_id
  note Record digest is deterministic
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  rx_compose_record_digest d1
  rx_compose_record_digest d2
  for i ulong 32
    rct_chk eq get d1 i get d2 i
  end
  rx_compose_close
end

fn test_enroll_and_attach to void
  put rxc_st 18 0
  rct_chk eq rx_compose_enroll_callers RXC_OK
  rct_chk eq get rxc_st 19 8
  rct_chk eq get rxc_keyring 0 RXC_SUBJ_CAND0
  rct_chk eq get rxc_keyring 4 rxc_subj_of 1 RXC_SUBJ_CAND0
  note Bound world refuses further enrollment
  put rxc_st 18 1
  rct_chk eq rx_compose_enroll_callers RXC_ERR_IDENTITY
  note Attach refuses composition external subject range
  dbuf = new uchar 128 0
  dl = len rct_dir1
  for i ulong dl bound 128
    put dbuf i get rct_dir1 i
  end
  rct_chk eq rx_compose_attach RXC_SUBJ_EXTERNAL dbuf dl 2 77 RXC_ERR_ARG
  note Valid attach succeeds and rejects duplicate dir
  rct_chk eq rx_compose_attach 500 dbuf dl 2 77 RXC_OK
  rct_chk eq rx_compose_attach 500 dbuf dl 2 77 RXC_ERR_EXISTS
  rx_compose_close
end

fn rct_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len rct_msg_pass
    for i ulong n bound 64
      put buf i get rct_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len rct_msg_fail
  for i ulong n bound 64
    put buf i get rct_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_open_run_commit_and_digest
  test_enroll_and_attach
  if eq get rct_fail 0 0
    rct_put_msg 1
    ret 0
  end
  rct_put_msg 0
  ret 1
end

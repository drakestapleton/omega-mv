note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_plan_reuse.om -- Pure seeded OM-2 port of
note tests/runtime/rx_plan_reuse.c (G1..G6 plan reuse & arrangement gate).
note Verifies goal solving, template generalization, canonical encoding/decoding,
note plan cache store/retrieve/reuse on isomorphic instances, applicability
note checks, and refusal on unmet preconditions.

global pr_checks ulong 1
global pr_fail ulong 1

text pr_pass "RX_PLAN_REUSE_OM: PASS\n"
text pr_fail_m "RX_PLAN_REUSE_OM: FAIL\n"

fn pr_chk cond bool to void
  put pr_checks 0 add get pr_checks 0 1
  if not cond
    if eq get pr_fail 0 0
      put pr_fail 0 get pr_checks 0
    end
  end
end

fn pr_setup_unit oid ulong gen ulong sup_ref ulong to void
  ob = mul oid 12
  put pl_view_obj ob 1
  put pl_view_obj add ob 1 PLA_OT_UNIT
  put pl_view_obj add ob 2 gen
  put pl_view_obj add ob 4 sup_ref
  put pl_view_obj add ob 6 pl_ref_pack oid gen
end

fn pr_clear_view to void
  for i ulong 768
    put pl_view_obj i 0
  end
  put pl_view_n 0 8
end

fn pr_setup_goal_3_blocks g_oid ulong f_oid ulong u0 ulong u1 ulong u2 ulong to void
  note Goal facts: u0 on u1, u1 on u2, u2 on floor
  fb = mul f_oid 12
  put pl_view_obj fb 1
  put pl_view_obj add fb 1 PLA_OT_GOALFACTS
  put pl_view_obj add fb 2 1
  put pl_view_obj add fb 4 pla_fact u0 1 0 u1 1
  put pl_view_obj add fb 5 pla_fact u1 1 0 u2 1
  put pl_view_obj add fb 6 pla_fact u2 1 1 0 0
  gb = mul g_oid 12
  put pl_view_obj gb 1
  put pl_view_obj add gb 1 PLA_OT_GOAL
  put pl_view_obj add gb 2 1
  put pl_view_obj add gb 4 1
  put pl_view_obj add gb 5 PLA_GOAL_ARRANGE
  put pl_view_obj add gb 6 10
  put pl_view_obj add gb 7 100
  put pl_view_obj add gb 8 pl_ref_pack f_oid 1
  put pl_env_refs 0 g_oid
  put pl_env_refs 1 1
end

fn pr_test_generalize_cache_and_reuse to void
  rx_plan_cache_init
  pr_clear_view
  note Instance 1: units 0, 1, 2 (1 on 0, 0 on floor, 2 on floor)
  pr_setup_unit 0 1 0
  pr_setup_unit 1 1 pl_ref_pack 0 1
  pr_setup_unit 2 1 0
  pr_chk eq pla_legal 1
  pr_setup_goal_3_blocks 3 4 0 1 2

  pr_chk eq pla_goal_read 0
  pla_target_from_goal
  pr_chk eq pla_plan 2000 0
  pr_chk eq get pla_p_n 0 2

  note Generalize into template slot 0 and cache it
  slots = new ulong 16 0
  pr_chk eq pla_generalize 0 0 slots 0
  rx_plan_sort 0
  rx_plan_identify 0
  enc_n = rx_plan_encode 0
  pr_chk gt enc_n 0
  pr_chk eq rx_plan_decode enc_n 1 0

  cid = rx_plan_cache_store 0 1 1
  pr_chk ge cid 0
  pr_chk eq rx_plan_cache_find 0 cid

  note Retrieve from cache and verify reuse on isomorphic Instance 2 (units 5, 6, 7)
  ids = new ulong 32 0
  nr = rx_plan_cache_retrieve PLA_GOAL_ARRANGE 0 ids
  pr_chk ge nr 1
  tid = get ids 0

  pr_clear_view
  put pl_view_n 0 10
  pr_setup_unit 5 1 0
  pr_setup_unit 6 1 pl_ref_pack 5 1
  pr_setup_unit 7 1 0
  pr_setup_goal_3_blocks 8 9 5 6 7
  pr_chk eq pla_goal_read 0

  bslots = new ulong 16 0
  pr_chk eq pla_bind tid 0 bslots 1
  pr_chk eq pla_target_from_template tid bslots 0
  pr_chk eq pla_template_moves tid bslots 0
  pr_chk eq get pla_p_n 0 2
  pr_chk eq pla_apply 0
  pr_chk eq pla_legal 1
  note Verify final arrangement: 5 on 6, 6 on 7, 7 on floor
  v5 = get pl_view_obj 64
  v6 = get pl_view_obj 76
  v7 = get pl_view_obj 88
  pr_chk eq v5 pl_ref_pack 6 1
  pr_chk eq v6 pl_ref_pack 7 1
  pr_chk eq v7 0
  rx_plan_record_use tid 1
end

fn pr_test_refusal_on_unmatched_state to void
  note Exhausted binding attempt returns 0 (only 1 matching chain exists)
  bslots = new ulong 16 0
  pr_chk eq pla_bind 0 1 bslots 0
end

fn pr_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len pr_pass
    for i ulong n bound 64
      put buf i get pr_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len pr_fail_m
  for i ulong n bound 64
    put buf i get pr_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  pr_test_generalize_cache_and_reuse
  pr_test_refusal_on_unmatched_state
  if ne get pr_fail 0 0
    pr_put_msg 0
    ret int get pr_fail 0
  end
  pr_put_msg 1
  ret 0
end

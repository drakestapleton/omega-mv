note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r11_aien.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r11_aien.c (R11 AIEN resident cognitive faculty:
note config validation, silent watch without record, baseline & confirmation,
note single-outlier tolerance, failure -> hypothesis formation, goal
note assessment, bounded planning, explored-condition memory, and experiment).

global r11_checks ulong 1
global r11_fail ulong 1

text r11_pass "RX_R11_AIEN_OM: PASS\n"
text r11_fail_m "RX_R11_AIEN_OM: FAIL\n"
text r11_env_home "HOME="
text r11_env_hold "QUIETLOCK_HOLD="
text r11_q_sfx "/workspace/.spark-quiet"
text r11_q_tok "hold="
text r11_qf_none "quiet flag: none\n"
text r11_qf_mine "quiet flag: this run's own hold\n"
text r11_qf_other "quiet flag: another measurement's hold\n"
text r11_q_refuse "living run refused: another measurement holds ~/workspace/.spark-quiet\n"
text r11_q_start "[*] living run: pure seeded OM-2\n"
text r11_q_chk1 "checks "
text r11_q_chk2 " failures 0\n"

global r11_ebuf uchar 4096
global r11_home uchar 256
global r11_hlen ulong 1
global r11_hold uchar 128
global r11_klen ulong 1
global r11_qbuf uchar 1024
global r11_qlen ulong 1

fn r11_chk cond bool to void
  put r11_checks 0 add get r11_checks 0 1
  if not cond
    if eq get r11_fail 0 0
      put r11_fail 0 get r11_checks 0
    end
  end
end

fn r11_step_window ns_per_call ulong real ulong to void
  calls = add get ai_dem 0 10
  spent = add get ai_dem 1 mul 10 ns_per_call
  put ai_dem 0 calls
  put ai_dem 1 spent
  put ai_dem 4 4
  put ai_dem 5 8
  put ai_dem 6 real
  ign1 = rx_aien_observe
  ign2 = rx_aien_predict
  ign3 = rx_aien_explain
  ign4 = rx_aien_assess
  ign5 = rx_aien_plan
end

fn r11_setup_record cls ulong to void
  rx_aien_reset
  rx_aien_default_config
  put ai_pl 0 1
  put ai_pl 1 cls
  put ai_sel 0 1
  put ai_sel 1 101
  put ai_sel 6 rx_aien_regime 4 8
  put ai_dem 4 4
  put ai_dem 5 8
  put ai_dem 6 101
  ign = rx_aien_observe
end

fn r11_test_config_and_no_record to void
  rx_aien_reset
  rx_aien_default_config
  r11_chk eq rx_aien_config_ok RX_AIEN_OK
  put ai_cfg 0 0
  r11_chk eq rx_aien_config_ok RX_AIEN_ERR_ARG
  rx_aien_default_config
  put ai_cfg 2 0
  r11_chk eq rx_aien_config_ok RX_AIEN_ERR_ARG
  rx_aien_default_config
  put ai_cfg 1 100
  r11_chk eq rx_aien_config_ok RX_AIEN_ERR_ARG

  note Without selection epoch, observe and predict publish nothing
  rx_aien_reset
  rx_aien_default_config
  for i ulong 6
    r11_step_window 5000 101
  end
  r11_chk eq get ai_belief 0 0
  r11_chk eq get ai_pred 0 0
  r11_chk eq get ai_plan 0 0
end

fn r11_test_steady_outlier_and_core_class to void
  r11_setup_record 1
  note 1 warmup + 4 baseline intervals establish mean 5000 -> PRED_HOLDING
  for i ulong 5
    r11_step_window 5000 101
  end
  r11_chk eq get ai_pred 0 1
  r11_chk eq get ai_pred 5 5000
  r11_chk eq get ai_pred 6 RX_AIEN_PRED_HOLDING

  note 4 more in-tolerance intervals confirm prediction
  for i ulong 4
    r11_step_window 5000 101
  end
  r11_chk eq get ai_pred 6 RX_AIEN_PRED_CONFIRMED

  note Single outlier counts as 1 miss, resets hit streak, does NOT fail
  r11_step_window 9000 101
  r11_chk eq get ai_belief 7 1
  r11_chk eq get ai_pred 6 RX_AIEN_PRED_CONFIRMED
  r11_chk eq get ai_pred 3 0

  note Recovery clears miss counter
  r11_step_window 5000 101
  r11_chk eq get ai_belief 7 0
  r11_chk eq get ai_pred 3 1

  note Change core class to 2 and deliver 2 slow windows -> PRED_FAILED + HYP_CORE_CLASS + plan
  put ai_pl 0 2
  put ai_pl 1 2
  r11_step_window 9000 101
  r11_step_window 9000 101
  r11_chk eq get ai_pred 6 RX_AIEN_PRED_FAILED
  r11_chk eq get ai_hyp 1 RX_AIEN_HYP_CORE_CLASS
  r11_chk eq get ai_hyp 3 1
  r11_chk eq get ai_hyp 4 2
  r11_chk eq get ai_hyp 7 RX_AIEN_HYP_TESTING
  r11_chk eq get ai_plan 0 1
  r11_chk eq get ai_plan 1 RX_AIEN_ACT_RESEARCH
  r11_chk eq get ai_plan 5 RX_AIEN_WHY_CORE_CLASS
  r11_chk eq get ai_mem 0 1
end

fn r11_test_goal_memory_and_experiment to void
  r11_setup_record 3
  for i ulong 9
    r11_step_window 5000 101
  end
  r11_chk eq get ai_pred 6 RX_AIEN_PRED_CONFIRMED

  note Goal met when target >= expected (6000 >= 5000)
  put ai_goal 0 1
  put ai_goal 1 rx_aien_regime 4 8
  put ai_goal 2 6000
  r11_chk eq rx_aien_assess 1
  r11_chk eq get ai_assess 4 RX_AIEN_GOAL_MET

  note Unmet goal (target 3000 < 5000) triggers research plan and records memory
  put ai_goal 0 2
  put ai_goal 2 3000
  r11_chk eq rx_aien_assess 1
  r11_chk eq get ai_assess 4 RX_AIEN_GOAL_UNMET
  r11_chk eq rx_aien_plan 1
  r11_chk eq get ai_plan 5 RX_AIEN_WHY_GOAL
  r11_chk eq get ai_plan 6 2

  note Re-assessing same condition reports GOAL_UNMET_EXPLORED and does not re-plan
  put ai_goal 0 3
  r11_chk eq rx_aien_assess 1
  r11_chk eq get ai_assess 4 RX_AIEN_GOAL_UNMET_EXPLORED
  r11_chk eq rx_aien_plan 0

  note Seed explored memory validation
  keys = new ulong 2 0
  put keys 0 rx_aien_key 9 rx_aien_regime 4 8
  r11_chk eq rx_aien_seed_explored keys 0 RX_AIEN_ERR_ARG
  r11_chk eq rx_aien_seed_explored keys 1 RX_AIEN_OK
  r11_chk eq rx_aien_explored get keys 0 1

  note Experiment belief: supported then refuted
  put ai_ev 0 1
  put ai_ev 1 42
  put ai_ev 2 42
  put ai_ev 3 1
  put ai_ev 4 2500
  r11_chk eq rx_aien_experiment 1
  r11_chk eq get ai_exp 2 RX_AIEN_EXP_SUPPORTED
  r11_chk eq rx_aien_experiment 0
  put ai_ev 0 2
  put ai_ev 3 0
  r11_chk eq rx_aien_experiment 1
  r11_chk eq get ai_exp 2 RX_AIEN_EXP_REFUTED
end

fn r11_put_str s view uchar * to void
  ign = write 1 s 0 len s
end

fn r11_put_u64 v ulong to void
  db = new uchar 24 0
  rev = new uchar 24 0
  if eq v 0
    put db 0 48
    ign = write 1 db 0 1
    ret
  end
  cur = v
  n = ulong 0
  while gt cur 0 bound 24
    put db n uchar add 48 rem cur 10
    cur = div cur 10
    n = add n 1
  end
  for i ulong n bound 24
    put rev i get db sub sub n 1 i
  end
  ign = write 1 rev 0 n
end

fn r11_env_match pfx view uchar * plen ulong n ulong to bool
  if lt n plen
    ret false
  end
  for i ulong plen bound 32
    if ne get r11_ebuf i get pfx i
      ret false
    end
  end
  ret true
end

fn r11_is_ws c uchar to bool
  if eq c 32
    ret true
  end
  if eq c 10
    ret true
  end
  if eq c 13
    ret true
  end
  if eq c 9
    ret true
  end
  ret false
end

fn r11_load_env to void
  put r11_hlen 0 0
  put r11_klen 0 0
  ec = ulong envcnt
  for i ulong ec bound 512
    got = envread i r11_ebuf 0 4096
    if gt got 0
      n = ulong got
      if r11_env_match r11_env_home 5 n
        hl = sub n 5
        if gt hl 220
          hl = 220
        end
        for j ulong hl bound 220
          put r11_home j get r11_ebuf add 5 j
        end
        put r11_hlen 0 hl
      end
      if r11_env_match r11_env_hold 15 n
        kl = sub n 15
        if gt kl 120
          kl = 120
        end
        for j ulong kl bound 120
          put r11_hold j get r11_ebuf add 15 j
        end
        put r11_klen 0 kl
      end
    end
  end
end

fn r11_hold_matches start ulong qn ulong to bool
  kl = get r11_klen 0
  if eq kl 0
    ret false
  end
  if gt add start kl qn
    ret false
  end
  for i ulong kl bound 128
    if ne get r11_qbuf add start i get r11_hold i
      ret false
    end
  end
  ep = add start kl
  if lt ep qn
    if not r11_is_ws get r11_qbuf ep
      ret false
    end
  end
  ret true
end

fn r11_check_quiet_flag to ulong
  r11_load_env
  hl = get r11_hlen 0
  if eq hl 0
    ret 0
  end
  for i ulong 23
    put r11_home add hl i get r11_q_sfx i
  end
  fd = fopen r11_home 0 add hl 23 0 0
  if lt fd 0
    ret 0
  end
  got = read int fd r11_qbuf 0 1024
  ign = fclose int fd
  if le got 0
    ret 2
  end
  qn = ulong got
  if lt qn 5
    ret 2
  end
  lim = sub qn 4
  for i ulong lim bound 1024
    ok = ulong 1
    if gt i 0
      if not r11_is_ws get r11_qbuf sub i 1
        ok = 0
      end
    end
    if eq ok 1
      for j ulong 5
        if ne get r11_qbuf add i j get r11_q_tok j
          ok = 0
        end
      end
    end
    if eq ok 1
      if r11_hold_matches add i 5 qn
        ret 1
      end
    end
  end
  ret 2
end

fn main to int
  qf = r11_check_quiet_flag
  if eq qf 0
    r11_put_str r11_qf_none
  end
  if eq qf 1
    r11_put_str r11_qf_mine
  end
  if eq qf 2
    r11_put_str r11_qf_other
    r11_put_str r11_q_refuse
  end
  r11_test_config_and_no_record
  r11_test_steady_outlier_and_core_class
  r11_test_goal_memory_and_experiment
  if ne get r11_fail 0 0
    r11_put_str r11_fail_m
    ret int get r11_fail 0
  end
  if ne qf 2
    r11_put_str r11_q_start
    r11_put_str r11_q_chk1
    r11_put_u64 get r11_checks 0
    r11_put_str r11_q_chk2
  end
  r11_put_str r11_pass
  ret 0
end

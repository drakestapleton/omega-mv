note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_typed_results.om -- Pure seeded OM-2 port of
note tests/runtime/rx_typed_results.c (OMEGA_TYPED_RESULTS).
note Verifies typed contract compilation, world-mutation validation &
note repair vs non-repairable stale generation, canonical encode/decode
note identity, capability-need bitmask narrowing, evidence-gated
note generation candidates, and domain projection.

global trt_checks ulong 1
global trt_fail ulong 1

text trt_pass "RX_TYPED_RESULTS_OM: PASS\n"
text trt_fail_m "RX_TYPED_RESULTS_OM: FAIL\n"

fn trt_chk cond bool to void
  put trt_checks 0 add get trt_checks 0 1
  if not cond
    if eq get trt_fail 0 0
      put trt_fail 0 get trt_checks 0
    end
  end
end

fn trt_test_world_mutation_and_codec to void
  rc_context_init 7
  put rc_w_obj 9 1
  put rc_w_obj 10 5
  put rc_w_obj 11 1000
  put rc_ctx_cap 0 1000
  put rc_ctx_cap 1 RC_RIGHT_WRITE
  put rc_ctx_cap 2 999
  put rc_ctx_cap 3 RC_RIGHT_WRITE
  put rc_ctx 10 2
  put rc_ctx 5 9000
  put rc_ctx 6 9999

  trt_chk eq rc_contract_std RC_WORLD_MUTATION 0
  trt_chk eq rc_compile 0
  trt_chk eq get rc_comp_cnt 0 7
  trt_chk eq get rc_comp_cnt 1 0

  put rc_obj 0 RC_WORLD_MUTATION
  put rc_obj 1 3
  put rc_obj 2 5
  put rc_obj 3 2
  put rc_obj 4 42
  put rc_obj 5 7
  put rc_obj 6 1000
  put rc_obj 7 0
  put rc_obj 8 0
  trt_chk eq rc_check 0
  trt_chk eq get rc_v_meta 0 1

  note Wrong derived resource repairs to 1000
  put rc_obj 6 999
  trt_chk eq rc_check -1
  trt_chk eq rc_repair 1
  trt_chk eq get rc_obj 6 1000
  trt_chk eq rc_check 0

  note Stale generation fails and refuses repair
  put rc_obj 2 4
  trt_chk eq rc_check -1
  trt_chk eq rc_repair -1
  put rc_obj 2 5

  note Canonical wire encode -> decode -> identity roundtrip + truncation refusal
  n = rc_encode
  trt_chk eq n 84
  rc_identity
  id0 = get rc_obj_id 0
  put rc_obj 4 0
  trt_chk eq rc_decode n 0
  trt_chk eq get rc_obj 4 42
  rc_identity
  trt_chk eq get rc_obj_id 0 id0
  trt_chk eq rc_decode sub n 1 -1
end

fn trt_test_cap_need_and_generation_evidence to void
  rc_context_init 9
  put rc_w_obj 3 1
  put rc_w_obj 4 1
  put rc_w_obj 5 555
  trt_chk eq rc_contract_std RC_CAPABILITY_NEED 0

  put rc_obj 0 RC_CAPABILITY_NEED
  put rc_obj 1 9
  put rc_obj 2 10
  put rc_obj 3 555
  put rc_obj 4 17
  put rc_obj 5 0
  put rc_obj 6 1
  put rc_obj 7 1000
  put rc_obj 8 0
  trt_chk eq rc_check -1
  trt_chk ge rc_repair 1
  trt_chk eq get rc_obj 4 1
  trt_chk eq rc_check 0

  note Generation candidate requires PASS evidence
  rc_context_init 12
  put rc_ctx 2 3
  put rc_ctx 3 1
  put rc_ctx_vals 0 77
  trt_chk eq rc_contract_std RC_GENERATION_CANDIDATE 0
  put rc_obj 0 RC_GENERATION_CANDIDATE
  put rc_obj 1 4
  put rc_obj 2 3
  put rc_obj 3 1
  put rc_obj 4 888
  put rc_obj 5 1
  put rc_obj 6 2
  put rc_obj 7 12
  put rc_obj 8 77
  trt_chk eq rc_check -1
  trt_chk eq rc_context_add_evidence RC_EV_GENERATION 888 RC_VERDICT_PASS 0
  trt_chk eq rc_check 0
end

fn trt_test_domain_projection to void
  for i ulong 12
    put rc_dom i 0
  end
  put rc_dom 0 1
  put rc_dom 1 100
  put rc_dom 3 1
  put rc_dom 2 7
  trt_chk eq rc_domain_contains 5 1
  trt_chk eq rc_domain_contains 21 0
  out_v = new ulong 1 0
  trt_chk eq rc_domain_pick 21 out_v 0
  trt_chk eq get out_v 0 5

  for i ulong 12
    put rc_dom i 0
  end
  put rc_dom 0 0
  put rc_dom 1 100
  put rc_dom 5 1
  put rc_dom 7 3
  put rc_dom_set 0 3
  put rc_dom_set 1 10
  put rc_dom_set 2 20
  trt_chk eq rc_domain_pick 12 out_v 0
  trt_chk eq get out_v 0 10
end

fn trt_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len trt_pass
    for i ulong n bound 64
      put buf i get trt_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len trt_fail_m
  for i ulong n bound 64
    put buf i get trt_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  trt_test_world_mutation_and_codec
  trt_test_cap_need_and_generation_evidence
  trt_test_domain_projection
  if ne get trt_fail 0 0
    trt_put_msg 0
    ret int get trt_fail 0
  end
  trt_put_msg 1
  ret 0
end

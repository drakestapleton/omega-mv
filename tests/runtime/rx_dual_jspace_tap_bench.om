note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_dual_jspace_tap_bench.om -- Pure seeded OM-2 port of
note tests/runtime/rx_dual_jspace_tap_bench.c (multi-round SOFT + CAPACITY
note residency workload comparing observer-off vs recording-observer parity).

global djtb_checks ulong 1
global djtb_fail ulong 1

text djtb_pass "RX_DUAL_JSPACE_TAP_BENCH_OM: PASS\n"
text djtb_fail_m "RX_DUAL_JSPACE_TAP_BENCH_OM: FAIL\n"

fn djtb_chk cond bool to void
  put djtb_checks 0 add get djtb_checks 0 1
  if not cond
    if eq get djtb_fail 0 0
      put djtb_fail 0 get djtb_checks 0
    end
  end
end

fn djtb_restore_all to void
  for b ulong JS_MAX_BR
    bb = mul b JS_BSTRIDE
    if ne get js_br bb 0
      nu = get js_br add bb 6
      ub = mul b JS_MAX_UNITS
      for i ulong nu bound 32
        rs = get js_br_units add ub i
        djtb_chk eq js_real_restore rs JS_OK
      end
    end
  end
end

fn djtb_record_one rslot ulong bud ulong seq ulong dst_out edit ulong 3 to void
  obs = new uchar 302 0
  dm = new ulong 5 0
  a = js_forge_choose rslot 1000000000.0f64 0
  put dm 0 seq
  put dm 1 bitcast ulong 1000000000.0f64
  put dm 2 a
  put dm 3 rslot
  put dm 4 bud
  n = js_dual_observation_encode dm obs
  put dst_out 0 add get dst_out 0 1
  put dst_out 1 add get dst_out 1 n
  put dst_out 2 xor get dst_out 2 ulong get obs 246
end

fn djtb_record_pass bud ulong seq_in ulong dst_out edit ulong 3 to void
  seq = seq_in
  for i ulong get js_limits 0 bound 256
    rb = mul i JS_RSTRIDE
    if ne get js_reals rb 0
      pl = get js_reals add rb 10
      hit = ulong 0
      if eq pl JS_PLACE_HOT
        hit = ulong 1
      end
      if eq pl JS_PLACE_COLD
        hit = ulong 1
      end
      if eq pl JS_PLACE_COMPRESSED
        hit = ulong 1
      end
      if ne hit 0
        seq = add seq 1
        djtb_record_one i bud seq dst_out
      end
    end
  end
end

fn djtb_run_trial observe ulong dst edit ulong 4 to void
  djtb_chk eq js_space_init JS_OK
  root = new ulong 1 0
  djtb_chk eq js_branch_root 1 7 root JS_OK
  r = get root 0
  for i ulong 4
    djtb_chk eq js_branch_derive r add 100 i JS_OK
  end
  ch = new ulong 1 0
  for k ulong 12
    djtb_chk eq js_branch_fork r ch JS_OK
    djtb_chk eq js_branch_derive get ch 0 add 1000 k JS_OK
  end
  dec = ulong 0
  snk = new ulong 3 0
  seq = ulong 0
  for rd ulong 8
    djtb_restore_all
    res0 = get js_stats 12
    bud_soft = div mul res0 3 2
    djtb_chk eq js_forge_enforce bud_soft JS_OK
    dec = add dec get js_rep_cons 0
    res1 = get js_stats 12
    bud_cap = div res1 2
    if ne observe 0
      djtb_record_pass bud_cap seq snk
      seq = get snk 0
    end
    djtb_chk eq js_forge_enforce bud_cap JS_OK
    dec = add dec get js_rep_cons 0
  end
  put dst 0 dec
  put dst 1 get snk 0
  put dst 2 get snk 1
  put dst 3 get js_stats 12
  js_space_destroy
end

fn djtb_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len djtb_pass
    for i ulong n bound 64
      put buf i get djtb_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len djtb_fail_m
  for i ulong n bound 64
    put buf i get djtb_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  off_res = new ulong 4 0
  on_res = new ulong 4 0
  djtb_run_trial 0 off_res
  djtb_run_trial 1 on_res
  djtb_chk gt get off_res 0 0
  djtb_chk eq get off_res 0 get on_res 0
  djtb_chk eq get off_res 3 get on_res 3
  djtb_chk gt get on_res 1 0
  djtb_chk eq get on_res 2 mul get on_res 1 JS_DUAL_OBS_BYTES
  if ne get djtb_fail 0 0
    djtb_put_msg 0
    ret int get djtb_fail 0
  end
  djtb_put_msg 1
  ret 0
end

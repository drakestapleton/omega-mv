note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_aegis_unit.om -- Pure seeded OM-2 unit test for rx_aegis.om.

global ag_checks ulong 1
global ag_fail ulong 1

text ag_msg_pass "RX_AEGIS_OM: PASS\n"
text ag_msg_fail "RX_AEGIS_OM: FAIL\n"

fn ag_chk cond bool to void
  put ag_checks 0 add get ag_checks 0 1
  if not cond
    put ag_fail 0 add get ag_fail 0 1
  end
end

fn ag_make_rules rules edit ulong 112 to void
  note Rule 0: id=10, subj=100, res=[1000, 1099], rights=3 (R|W), max_lease=50, needs_approval=0
  put rules 0 10
  put rules 1 100
  put rules 2 1000
  put rules 3 1099
  put rules 4 3
  put rules 5 50
  put rules 6 0
  note Rule 1: id=20, subj=100, res=[2000, 2099], rights=7, max_lease=100, needs_approval=1
  put rules 7 20
  put rules 8 100
  put rules 9 2000
  put rules 10 2099
  put rules 11 7
  put rules 12 100
  put rules 13 1
end

fn test_evaluate to void
  rules = new ulong 112 0
  ag_make_rules rules
  req = new ulong 4 0
  res = new ulong 3 0
  note Resource address calculation
  ag_chk eq rx_aegis_res 0 0 92340224
  ag_chk eq rx_aegis_res 2 3 92340739
  note Valid grant with default lease clamped to max_lease=50
  put req 0 100
  put req 1 1050
  put req 2 3
  put req 3 0
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_GRANT
  ag_chk eq get res 0 50
  ag_chk eq get res 1 10
  ag_chk eq get res 2 0
  note Lease clamped when exceeding max_lease
  put req 3 999
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_GRANT
  ag_chk eq get res 0 50
  note Lease kept when below max_lease
  put req 3 25
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_GRANT
  ag_chk eq get res 0 25
  note Privileged right refused
  put req 2 16
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_DENY
  ag_chk eq get res 1 RX_AEGIS_WHY_PRIVILEGED
  note Zero rights refused as bad request
  put req 2 0
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_DENY
  ag_chk eq get res 1 RX_AEGIS_WHY_BAD_REQUEST
  note Unknown right bit refused as bad request
  put req 2 1024
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_DENY
  ag_chk eq get res 1 RX_AEGIS_WHY_BAD_REQUEST
  note Out of range resource -> NO_RULE
  put req 1 1500
  put req 2 1
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_DENY
  ag_chk eq get res 1 RX_AEGIS_WHY_NO_RULE
  note Needs approval rule
  put req 1 2010
  put req 2 7
  put req 3 10
  ag_chk eq rx_aegis_evaluate rules 2 req res RX_AEGIS_GRANT
  ag_chk eq get res 1 20
  ag_chk eq get res 2 1
end

fn test_decide to void
  rules = new ulong 112 0
  ag_make_rules rules
  in_f = new ulong 10 0
  dec = new ulong 8 0
  note seq=0 is no-op
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 0
  note Acquire normal rule -> GRANT
  put in_f 0 1
  put in_f 1 1010
  put in_f 2 3
  put in_f 3 20
  put in_f 4 0
  put in_f 5 RX_AEGIS_OP_ACQUIRE
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_GRANT
  ag_chk eq get dec 4 20
  ag_chk eq get dec 6 10
  note Already decided same seq -> no-op
  put in_f 8 1
  put in_f 9 RX_AEGIS_GRANT
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 0
  note Escalate rule without approval -> ESCALATE
  put in_f 0 2
  put in_f 1 2010
  put in_f 2 7
  put in_f 3 30
  put in_f 4 1
  put in_f 5 RX_AEGIS_OP_ACQUIRE
  put in_f 6 0
  put in_f 7 0
  put in_f 8 1
  put in_f 9 RX_AEGIS_GRANT
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_ESCALATE
  note Human rejects escalated request -> DENY + WHY_HUMAN
  put in_f 8 2
  put in_f 9 RX_AEGIS_ESCALATE
  put in_f 6 2
  put in_f 7 RX_AEGIS_REJECT
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_DENY
  ag_chk eq get dec 3 0
  ag_chk eq get dec 6 RX_AEGIS_WHY_HUMAN
  note Human approves escalated request -> GRANT
  put in_f 7 RX_AEGIS_APPROVE
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_GRANT
  ag_chk eq get dec 3 7
  note Release op -> REVOKE
  put in_f 0 3
  put in_f 5 RX_AEGIS_OP_RELEASE
  put in_f 8 2
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_REVOKE
  ag_chk eq get dec 3 0
  note Bad slot index -> DENY + WHY_BAD_REQUEST
  put in_f 0 4
  put in_f 4 4
  put in_f 5 RX_AEGIS_OP_ACQUIRE
  ag_chk eq rx_aegis_decide rules 2 100 in_f dec 1
  ag_chk eq get dec 1 RX_AEGIS_DENY
  ag_chk eq get dec 6 RX_AEGIS_WHY_BAD_REQUEST
end

fn test_install_and_origin to void
  ctx = new ulong 18 0
  st = new ulong 16 0
  put st 1 RX_AEGIS_U32_MAX
  put st 14 10
  put ctx 14 100
  put ctx 15 1000
  put ctx 16 1099
  put ctx 17 3
  note Matching req (8..13) and dec (0..7)
  put ctx 8 1
  put ctx 9 1010
  put ctx 10 3
  put ctx 11 20
  put ctx 12 0
  put ctx 13 RX_AEGIS_OP_ACQUIRE
  put ctx 0 1
  put ctx 1 RX_AEGIS_GRANT
  put ctx 2 1010
  put ctx 3 3
  put ctx 4 20
  put ctx 5 0
  put ctx 6 10
  put ctx 7 RX_AEGIS_OP_ACQUIRE
  note Origin forgery refused
  ag_chk eq rx_aegis_install_step ctx 2 st 1
  ag_chk eq get st 10 RX_AEGIS_WHY_DECISION_ORIGIN
  ag_chk eq get st 13 1
  note Reset slot seq and test valid grant mint
  put st 8 0
  ag_chk eq rx_aegis_install_step ctx 3 st 1
  ag_chk eq get st 3 10
  ag_chk eq get st 4 1
  ag_chk eq get st 5 RX_AEGIS_SLOT_LIVE
  ag_chk eq get st 10 0
  ag_chk eq get st 11 1
  note Replay same seq -> no-op
  ag_chk eq rx_aegis_install_step ctx 3 st 0
  note Domain widening refused by root even if AEGIS granted
  put ctx 8 2
  put ctx 9 2000
  put ctx 0 2
  put ctx 2 2000
  ag_chk eq rx_aegis_install_step ctx 3 st 1
  ag_chk eq get st 10 RX_AEGIS_WHY_DOMAIN
  ag_chk eq get st 13 2
  note Revoke revokes minted cap
  put ctx 8 3
  put ctx 9 1010
  put ctx 13 RX_AEGIS_OP_RELEASE
  put ctx 0 3
  put ctx 1 RX_AEGIS_REVOKE
  put ctx 2 1010
  put ctx 3 0
  put ctx 7 RX_AEGIS_OP_RELEASE
  ag_chk eq rx_aegis_install_step ctx 3 st 1
  ag_chk eq get st 5 RX_AEGIS_SLOT_REVOKED
  ag_chk eq get st 12 1
  note Origin provenance helper check
  orig = new ulong 24 0
  for i ulong 8
    put orig mul i 3 7
    put orig add mul i 3 1 RX_AEGIS_SUBJ
    put orig add mul i 3 2 RX_FACULTY_AEGIS
  end
  ag_chk eq rx_aegis_written_by orig 8 7 RX_AEGIS_SUBJ RX_FACULTY_AEGIS 0 1
  put orig 4 99
  ag_chk eq rx_aegis_written_by orig 8 7 RX_AEGIS_SUBJ RX_FACULTY_AEGIS 0 0
end

fn ag_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len ag_msg_pass
    for i ulong n bound 64
      put buf i get ag_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len ag_msg_fail
  for i ulong n bound 64
    put buf i get ag_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_evaluate
  test_decide
  test_install_and_origin
  if eq get ag_fail 0 0
    ag_put_msg 1
    ret 0
  end
  ag_put_msg 0
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r9_barrier.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r9_barrier.c (R9 generation barrier qualification).
note Verifies capability authority for promotion right, genesis store open,
note proposal/work/evidence tracking, self-promotion refusal, promotion barrier,
note recovery coherence and idempotency, external-work replay rejection,
note bound-authority identity refusals, and durable executor promotion.

const R9_SUBJ_PROPOSER ulong 8
const R9_SUBJ_AUTHORITY ulong 4

global r9_checks ulong 1
global r9_fail ulong 1

text r9_dir "/tmp/rx_r9_barrier_om"
text r9_ev1 "GEN2_EVIDENCE_OK"
text r9_ev2 "GEN3_EVIDENCE_OK"
text r9_pass "generation barrier kept a single coherent generation through every injected stop\nRX_R9_BARRIER_OM: PASS\n"
text r9_fail_m "RX_R9_BARRIER_OM: FAIL\n"
text r9_suite "r9"
text r9_rel "R9/rx_generation_barrier_receipt.json"
text r9_k_cand "candidate_commit"
text r9_k_bound "candidate_bound"
text r9_k_dirty "tree_dirty"
text r9_k_fails "failures"
text r9_k_gates "gates"
text r9_k_g9 "R9_GENERATION_BARRIER"
text r9_k_diff "differential"
text r9_k_case "case"
text r9_k_lin "linux"
text r9_k_nat "native"
text r9_k_crashes "crashes"
text r9_k_step "step"
text r9_k_coh "coherent"
text r9_k_line "lineage"
text r9_k_ev "evidence"
text r9_v_pass "PASS"
text r9_v_fail "FAIL"
text r9_v_gen "GENESIS"
text r9_v_cnd "CANDIDATE"
text r9_v_bad "MIXED"
text r9_dc0 "promote_authority"

global r9_cr_coh ulong 8
global r9_cr_lin ulong 8

fn r9_chk cond bool to void
  put r9_checks 0 add get r9_checks 0 1
  if not cond
    if eq get r9_fail 0 0
      put r9_fail 0 get r9_checks 0
    end
  end
end

fn r9_test_promo_cap_authority to void
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  deliv = new uchar 256 0
  tok = new uchar 32 0
  r9_chk eq rx_caproot_start hdr slots deliv tok ERR_OK

  note Mint promotion right for R9_SUBJ_AUTHORITY on RX_GEN_RES_PROMOTION
  req = new ulong 9 0
  put req 0 3
  put req 1 R9_SUBJ_AUTHORITY
  put req 2 RX_GEN_RES_PROMOTION
  put req 3 RX_GEN_RIGHT_PROMOTE
  put req 4 0
  put req 5 CAP_NONE
  put req 6 0
  put req 7 get rx_cap_office 0
  put req 8 get rx_cap_office 1
  cap_ok = new ulong 2 0
  r9_chk eq rx_capadmin_mint hdr slots deliv tok req cap_ok ERR_OK

  vargs = new ulong 5 0
  put vargs 0 get cap_ok 0
  put vargs 1 get cap_ok 1
  put vargs 2 R9_SUBJ_AUTHORITY
  put vargs 3 RX_GEN_RES_PROMOTION
  put vargs 4 RX_GEN_RIGHT_PROMOTE
  ent = new ulong 13 0
  r9_chk eq rx_caproot_validate hdr slots vargs ent ERR_OK

  note Wrong subject (proposer) refused
  put vargs 2 R9_SUBJ_PROPOSER
  r9_chk eq rx_caproot_validate hdr slots vargs ent ERR_SUBJECT

  note Revoke promotion cap -> refused
  rargs = new ulong 4 0
  put rargs 0 get rx_cap_office 0
  put rargs 1 get rx_cap_office 1
  put rargs 2 get cap_ok 0
  put rargs 3 get cap_ok 1
  rlist = new ulong 257 0
  r9_chk eq rx_capadmin_revoke hdr slots deliv tok rargs rlist ERR_OK
  put vargs 2 R9_SUBJ_AUTHORITY
  r9_chk eq rx_caproot_validate hdr slots vargs ent ERR_REVOKED
  r9_chk eq rx_caproot_stop hdr slots deliv tok ERR_OK
end

fn r9_test_barrier_and_recovery to void
  dbuf = new uchar 128 0
  dl = len r9_dir
  for i ulong dl bound 128
    put dbuf i get r9_dir i
  end
  r9_chk eq rx_gen_open dbuf dl RX_GEN_OK
  act = new ulong 2 0
  r9_chk eq rx_gen_active act RX_GEN_OK
  r9_chk eq get act 0 1
  r9_chk eq get act 1 1

  ev = new uchar 256 0
  el = len r9_ev1
  for i ulong el bound 256
    put ev i get r9_ev1 i
  end
  pm = new ulong 6 0
  put pm 0 R9_SUBJ_PROPOSER
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 2
  cid = new ulong 1 0
  r9_chk eq rx_gen_propose pm ev el cid RX_GEN_OK
  c2 = get cid 0
  r9_chk eq c2 2

  note Add required evidence work and external issued work
  r9_chk eq rx_gen_add_work c2 101 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
  r9_chk eq rx_gen_add_work c2 202 RX_WORK_EXTERNAL RX_WORK_ISSUED 0 RX_GEN_OK
  r9_chk eq rx_gen_finish_work c2 101 RX_GEN_OK

  note Self-promotion (proposer == subject) refused
  preq = new ulong 7 0
  put preq 0 c2
  put preq 1 R9_SUBJ_PROPOSER
  put preq 3 1
  put preq 4 1
  put preq 5 RX_GEN_RES_PROMOTION
  put preq 6 RX_GEN_RIGHT_PROMOTE
  r9_chk eq rx_gen_promote preq RX_GEN_ERR_AUTHORITY

  note Authorized subject promotes candidate 2 -> active gen 2, lineage 2
  put preq 1 R9_SUBJ_AUTHORITY
  r9_chk eq rx_gen_promote preq RX_GEN_OK
  r9_chk eq rx_gen_active act RX_GEN_OK
  r9_chk eq get act 0 2
  r9_chk eq get act 1 2

  note Recovery coherent and idempotent; external work 202 replay refused
  r9_chk eq rx_gen_recover RX_GEN_OK
  r9_chk eq get rg_rec_meta 0 1
  r9_chk eq get rg_rec_meta 1 2
  r9_chk eq rx_gen_recover RX_GEN_OK
  r9_chk eq get rg_rec_meta 1 2
  r9_chk eq rx_gen_reject_replay 202 RX_GEN_ERR_REPLAY
  r9_chk eq rx_gen_reject_replay 203 RX_GEN_OK
end

fn r9_test_bound_and_exec to void
  r9_chk eq rx_gen_bind_authority RX_GEN_OK
  ev = new uchar 256 0
  el = len r9_ev2
  for i ulong el bound 256
    put ev i get r9_ev2 i
  end
  pm = new ulong 6 0
  put pm 0 R9_SUBJ_PROPOSER
  put pm 1 0
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 1
  cid = new ulong 1 0
  note Bare propose refused on bound store
  r9_chk eq rx_gen_propose pm ev el cid RX_GEN_ERR_IDENTITY
  put pm 1 1
  r9_chk eq rx_gen_propose_as pm ev el cid RX_GEN_OK
  c3 = get cid 0

  preq = new ulong 7 0
  put preq 0 c3
  put preq 1 R9_SUBJ_AUTHORITY
  put preq 2 1
  put preq 3 1
  put preq 4 1
  put preq 5 RX_GEN_RES_PROMOTION
  put preq 6 RX_GEN_RIGHT_PROMOTE
  note Held barrier blocks promotion
  r9_chk eq rx_gen_hold_barrier RX_GEN_OK
  r9_chk eq rx_gen_promote preq RX_GEN_ERR_BUSY
  r9_chk eq rx_gen_release_barrier RX_GEN_OK

  note Executor promotes candidate 3 cleanly
  r9_chk eq rx_gen_exec_start RX_GEN_OK
  r9_chk eq rx_gen_post_promote 77 preq RX_GEN_OK
  jout = new ulong 6 0
  jrc = new long 1 0
  r9_chk eq rx_gen_job_state RX_GEN_JOB_PROMOTE jout jrc long RX_GEN_JOB_DONE
  r9_chk eq get jrc 0 RX_GEN_OK
  rx_gen_job_take RX_GEN_JOB_PROMOTE
  act = new ulong 2 0
  r9_chk eq rx_gen_active act RX_GEN_OK
  r9_chk eq get act 0 3
  r9_chk eq get act 1 3
  rx_gen_close
end

fn r9_test_all_crash_points to void
  dbuf = new uchar 128 0
  dl = len r9_dir
  for i ulong dl bound 128
    put dbuf i get r9_dir i
  end
  ev = new uchar 256 0
  el = len r9_ev1
  for i ulong el bound 256
    put ev i get r9_ev1 i
  end
  pm = new ulong 6 0
  cid = new ulong 1 0
  preq = new ulong 7 0
  for k ulong 8
    step = add k 1
    r9_chk eq rx_gen_open dbuf dl RX_GEN_OK
    put pm 0 R9_SUBJ_PROPOSER
    put pm 1 0
    put pm 2 1
    put pm 3 1
    put pm 4 1
    put pm 5 2
    r9_chk eq rx_gen_propose pm ev el cid RX_GEN_OK
    c2 = get cid 0
    r9_chk eq rx_gen_add_work c2 101 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
    r9_chk eq rx_gen_finish_work c2 101 RX_GEN_OK
    rx_gen_set_crash step
    put preq 0 c2
    put preq 1 R9_SUBJ_AUTHORITY
    put preq 2 0
    put preq 3 1
    put preq 4 1
    put preq 5 RX_GEN_RES_PROMOTION
    put preq 6 RX_GEN_RIGHT_PROMOTE
    ign_p = rx_gen_promote preq
    rx_gen_set_crash RX_CRASH_NONE
    r9_chk eq rx_gen_recover RX_GEN_OK
    coh = get rg_rec_meta 0
    lin = get rg_rec_meta 2
    put r9_cr_coh k coh
    put r9_cr_lin k lin
    r9_chk eq coh 1
    r9_chk or eq lin 1 eq lin 2
    rx_gen_close
  end
end

fn r9_write_receipt ok bool to void
  cand = new uchar 41 0
  cl = rae_get_candidate cand
  dirty = omega_evidence_tree_dirty
  fails = ulong 0
  if not ok
    fails = ulong 1
  end
  rae_reset
  rae_puts t_rae_j_open
  rae_kv_str r9_k_cand cand cl
  rae_puts t_rae_j_cm
  rae_kv_bool r9_k_bound eq cl 40
  rae_puts t_rae_j_cm
  rae_kv_bool r9_k_dirty dirty
  rae_puts t_rae_j_cm
  rae_kv_u64 r9_k_fails fails
  rae_puts t_rae_j_cm
  rae_kv_key r9_k_gates
  rae_putc 123
  if ok
    rae_kv_lit r9_k_g9 r9_v_pass
  else
    rae_kv_lit r9_k_g9 r9_v_fail
  end
  rae_puts t_rae_j_ocm
  rae_kv_key r9_k_diff
  rae_puts t_rae_j_iopen
  rae_kv_lit r9_k_case r9_dc0
  rae_puts t_rae_j_sp
  rae_kv_u64 r9_k_lin 0
  rae_puts t_rae_j_sp
  rae_kv_u64 r9_k_nat fails
  rae_puts t_rae_j_icm
  rae_kv_key r9_k_crashes
  rae_puts t_rae_j_aopen
  for k ulong 8
    rae_puts t_rae_j_row
    rae_kv_u64 r9_k_step add k 1
    rae_puts t_rae_j_sp
    rae_kv_bool r9_k_coh ne get r9_cr_coh k 0
    rae_puts t_rae_j_sp
    lin = get r9_cr_lin k
    rae_kv_u64 r9_k_line lin
    rae_puts t_rae_j_sp
    if eq lin 1
      rae_kv_lit r9_k_ev r9_v_gen
    else
      if eq lin 2
        rae_kv_lit r9_k_ev r9_v_cnd
      else
        rae_kv_lit r9_k_ev r9_v_bad
      end
    end
    if lt k 7
      rae_puts t_rae_j_rcm
    else
      rae_puts t_rae_j_rnl
    end
  end
  rae_puts t_rae_j_aclose
  rae_write_qual_receipt r9_rel
end

fn r9_put_msg ok ulong to void
  if ne ok 0
    ign_p = write 1 r9_pass 0 len r9_pass
    ret
  end
  ign_f = write 1 r9_fail_m 0 len r9_fail_m
end

fn main to int
  if ne rae_argus_init r9_suite 0
    ret 1
  end
  r9_test_promo_cap_authority
  r9_test_barrier_and_recovery
  r9_test_bound_and_exec
  r9_test_all_crash_points
  ok = eq get r9_fail 0 0
  r9_write_receipt ok
  if ok
    rae_argus_finish get r9_checks 0
    r9_put_msg 1
    ret 0
  end
  r9_put_msg 0
  ret 1
end

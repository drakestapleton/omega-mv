note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_gen_work_auth.om -- Pure seeded OM-2 port of tests/runtime/rx_gen_work_auth.c.
note Verifies proposer-owned generation work, delegated finish, cross-subject/cross-work refusal,
note evidence-digest binding, path-prefix non-aliasing, and length-prefixed SHA-256 KAT.

global gwa_checks ulong 1
global gwa_fail ulong 1

text gwa_dir_u1 "/tmp/omega-wu-1"
text gwa_dir_u2 "/tmp/omega-wu-2"
text gwa_dir_b  "/tmp/omega-wb-1"
text gwa_dir_pa "/tmp/omega-wp/a"
text gwa_dir_pb "/tmp/omega-wp/ab"
text gwa_dir_k  "/tmp/omega-wk-1"
text gwa_ev_v1  "evidence-v1"
text gwa_ev_sw  "swapped-evidence"
text gwa_ev_bd  "bound-evidence"
text gwa_ev_p   "p"
text gwa_ev_k   "k"
text gwa_dom    "omega.rx.generation.work.finish.v1"
text gwa_pass   "rx_gen_work_auth: PASS\n"
text gwa_fail_m "rx_gen_work_auth: FAIL\n"

fn gwa_chk cond bool to void
  put gwa_checks 0 add get gwa_checks 0 1
  if not cond
    if eq get gwa_fail 0 0
      put gwa_fail 0 get gwa_checks 0
    end
  end
end

fn gwa_open_text t view uchar * to long
  dbuf = new uchar 128 0
  dl = len t
  for i ulong dl bound 128
    put dbuf i get t i
  end
  ret rx_gen_open dbuf dl
end

fn gwa_propose who ulong has_cred ulong ev_t view uchar * cid_dst edit ulong 1 to long
  ev = new uchar 256 0
  el = len ev_t
  for i ulong el bound 256
    put ev i get ev_t i
  end
  pm = new ulong 6 0
  put pm 0 who
  put pm 1 has_cred
  put pm 2 1
  put pm 3 1
  put pm 4 1
  put pm 5 1
  if ne has_cred 0
    ret rx_gen_propose_as pm ev el cid_dst
  end
  ret rx_gen_propose pm ev el cid_dst
end

fn gwa_set_ev cid ulong ev_t view uchar * to long
  ev = new uchar 256 0
  el = len ev_t
  for i ulong el bound 256
    put ev i get ev_t i
  end
  ret rx_gen_set_evidence cid ev el
end

fn gwa_test_unbound_ok to void
  gwa_chk eq gwa_open_text gwa_dir_u1 RX_GEN_OK
  cid = new ulong 1 0
  gwa_chk eq gwa_propose 7 0 gwa_ev_v1 cid RX_GEN_OK
  c1 = get cid 0
  gwa_chk eq rx_gen_add_work c1 3 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
  gwa_chk eq rx_gen_finish_work c1 3 RX_GEN_OK
  req = new ulong 7 0
  put req 0 c1
  put req 1 9
  put req 3 1
  put req 4 1
  put req 5 RX_GEN_RES_PROMOTION
  put req 6 RX_GEN_RIGHT_PROMOTE
  gwa_chk eq rx_gen_promote req RX_GEN_OK
  note Read work blob and verify R9WORK1 magic + SHA256(evidence-v1) at offset 64..95
  bbuf = new uchar 1024 0
  blen = new ulong 1 0
  gwa_chk eq rx_gen_read_blob c1 6 bbuf 1024 blen RX_GEN_OK
  gwa_chk eq get blen 0 96
  gwa_chk eq get bbuf 0 82
  gwa_chk eq get bbuf 1 57
  gwa_chk eq get bbuf 2 87
  el = len gwa_ev_v1
  for i ulong el bound 64
    put sh_dat i get gwa_ev_v1 i
  end
  sh_all el
  for i ulong 32
    gwa_chk eq get bbuf add 64 i get sh_dig i
  end
  rx_gen_close
end

fn gwa_test_unbound_swap to void
  gwa_chk eq gwa_open_text gwa_dir_u2 RX_GEN_OK
  cid = new ulong 1 0
  gwa_chk eq gwa_propose 7 0 gwa_ev_v1 cid RX_GEN_OK
  c1 = get cid 0
  gwa_chk eq rx_gen_add_work c1 3 RX_WORK_EVIDENCE RX_WORK_PENDING 1 RX_GEN_OK
  gwa_chk eq rx_gen_finish_work c1 3 RX_GEN_OK
  note Swapping evidence after finish invalidates work provenance digest
  gwa_chk eq gwa_set_ev c1 gwa_ev_sw RX_GEN_OK
  req = new ulong 7 0
  put req 0 c1
  put req 1 9
  put req 3 1
  put req 4 1
  put req 5 RX_GEN_RES_PROMOTION
  put req 6 RX_GEN_RIGHT_PROMOTE
  gwa_chk eq rx_gen_promote req RX_GEN_ERR_VERIFY
  rx_gen_close
end

fn gwa_test_bound to void
  note PROP=4, OTHER=5, WORKER=6, PROM=8
  gwa_chk eq gwa_open_text gwa_dir_b RX_GEN_OK
  gwa_chk eq rx_gen_bind_authority RX_GEN_OK
  cid = new ulong 1 0
  gwa_chk eq gwa_propose 4 1 gwa_ev_bd cid RX_GEN_OK
  c1 = get cid 0
  res1 = new ulong 1 0
  gwa_chk eq rx_gen_work_resource c1 11 res1 RX_GEN_OK
  gwa_chk ne get res1 0 0

  wm = new ulong 11 0
  put wm 0 5
  put wm 1 1
  put wm 2 c1
  put wm 3 11
  put wm 4 RX_WORK_EVIDENCE
  put wm 5 RX_WORK_PENDING
  put wm 6 1
  put wm 9 41
  put wm 10 7
  note Other subject cannot add work
  gwa_chk eq rx_gen_add_work_as wm RX_GEN_ERR_AUTHORITY
  note Proposer adds work 11
  put wm 0 4
  gwa_chk eq rx_gen_add_work_as wm RX_GEN_OK
  note Other subject cannot finish; bare finish refused; proposer finishes
  gwa_chk eq rx_gen_finish_work_as 5 1 c1 11 RX_GEN_ERR_AUTHORITY
  gwa_chk eq rx_gen_finish_work c1 11 RX_GEN_ERR_IDENTITY
  gwa_chk eq rx_gen_finish_work_as 4 1 c1 11 RX_GEN_OK

  note Delegated work 12 assigned to WORKER=6
  res2 = new ulong 1 0
  gwa_chk eq rx_gen_work_resource c1 12 res2 RX_GEN_OK
  gwa_chk ne get res2 0 get res1 0
  put wm 0 4
  put wm 3 12
  put wm 7 6
  put wm 8 1
  put wm 9 42
  put wm 10 8
  gwa_chk eq rx_gen_add_work_as wm RX_GEN_OK
  note Proposer cannot finish delegated work; WORKER=6 finishes it
  gwa_chk eq rx_gen_finish_work_as 4 1 c1 12 RX_GEN_ERR_AUTHORITY
  gwa_chk eq rx_gen_finish_work_as 6 1 c1 12 RX_GEN_OK

  note Already-done and duplicate-id refused
  put wm 3 13
  put wm 5 RX_WORK_DONE
  put wm 8 0
  gwa_chk eq rx_gen_add_work_as wm RX_GEN_ERR_ARG
  put wm 3 11
  put wm 5 RX_WORK_PENDING
  gwa_chk eq rx_gen_add_work_as wm RX_GEN_ERR_ARG

  note Bound promotion succeeds
  req = new ulong 7 0
  put req 0 c1
  put req 1 8
  put req 2 1
  put req 3 1
  put req 4 1
  put req 5 RX_GEN_RES_PROMOTION
  put req 6 RX_GEN_RIGHT_PROMOTE
  gwa_chk eq rx_gen_promote req RX_GEN_OK
  rx_gen_close
end

fn gwa_test_path_prefix to void
  gwa_chk eq gwa_open_text gwa_dir_pa RX_GEN_OK
  ca = new ulong 1 0
  gwa_chk eq gwa_propose 1 0 gwa_ev_p ca RX_GEN_OK
  ra = new ulong 1 0
  gwa_chk eq rx_gen_work_resource get ca 0 1 ra RX_GEN_OK
  rx_gen_close

  gwa_chk eq gwa_open_text gwa_dir_pb RX_GEN_OK
  cb = new ulong 1 0
  gwa_chk eq gwa_propose 1 0 gwa_ev_p cb RX_GEN_OK
  rb = new ulong 1 0
  gwa_chk eq rx_gen_work_resource get cb 0 1 rb RX_GEN_OK
  rx_gen_close

  gwa_chk ne get ra 0 get rb 0
end

fn gwa_resource_kat dir_t view uchar * parent ulong cid ulong wid ulong prefixed ulong to ulong
  pos = ulong 0
  dl = len gwa_dom
  for i ulong dl bound 64
    put sh_dat pos get gwa_dom i
    pos = add pos 1
  end
  dirl = len dir_t
  if ne prefixed 0
    for i ulong 8
      put sh_dat pos uchar and shr dirl mul i 8 255
      pos = add pos 1
    end
  end
  for i ulong dirl bound 128
    put sh_dat pos get dir_t i
    pos = add pos 1
  end
  for i ulong 8
    put sh_dat pos uchar and shr parent mul i 8 255
    pos = add pos 1
  end
  for i ulong 8
    put sh_dat pos uchar and shr cid mul i 8 255
    pos = add pos 1
  end
  for i ulong 8
    put sh_dat pos uchar and shr wid mul i 8 255
    pos = add pos 1
  end
  sh_all pos
  v = ulong 0
  for i ulong 8
    b = ulong get sh_dig i
    v = or v shl b mul i 8
  end
  if eq v 0
    ret ulong 0xffffffffffffffff
  end
  ret v
end

fn gwa_test_resource_kat to void
  gwa_chk eq gwa_open_text gwa_dir_k RX_GEN_OK
  act = new ulong 2 0
  gwa_chk eq rx_gen_active act RX_GEN_OK
  parent = get act 0
  cid = new ulong 1 0
  gwa_chk eq gwa_propose 1 0 gwa_ev_k cid RX_GEN_OK
  c1 = get cid 0
  res = new ulong 1 0
  gwa_chk eq rx_gen_work_resource c1 3 res RX_GEN_OK
  want_pref = gwa_resource_kat gwa_dir_k parent c1 3 1
  want_raw = gwa_resource_kat gwa_dir_k parent c1 3 0
  gwa_chk eq get res 0 want_pref
  gwa_chk ne get res 0 want_raw
  rx_gen_close
end

fn gwa_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len gwa_pass
    for i ulong n bound 64
      put buf i get gwa_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len gwa_fail_m
  for i ulong n bound 64
    put buf i get gwa_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  gwa_test_unbound_ok
  gwa_test_unbound_swap
  gwa_test_bound
  gwa_test_path_prefix
  gwa_test_resource_kat
  if eq get gwa_fail 0 0
    gwa_put_msg 1
    ret 0
  end
  gwa_put_msg 0
  ret 1
end

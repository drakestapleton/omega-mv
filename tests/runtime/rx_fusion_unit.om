note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_fusion_unit.om -- Pure seeded OM-2 unit test for rx_fusion.om.

global ft_checks ulong 1
global ft_fail ulong 1

text ft_msg_pass "RX_FUSION_OM: PASS\n"
text ft_msg_fail "RX_FUSION_OM: FAIL\n"

fn ft_chk cond bool to void
  put ft_checks 0 add get ft_checks 0 1
  if not cond
    put ft_fail 0 add get ft_fail 0 1
  end
end

fn ft_build_sample_graph g ulong c1 ulong c2 ulong to void
  rx_graph_init g 1
  n0 = rx_graph_node g AG_CONST AG_T_U64
  rx_graph_set_node g ulong n0 3 c1
  n1 = rx_graph_node g AG_CONST AG_T_U64
  rx_graph_set_node g ulong n1 3 c2
  n2 = rx_graph_node g AG_PURE AG_T_U64
  rx_graph_set_node g ulong n2 2 AG_OP_ADD
  ign_d0 = rx_graph_data g ulong n0 ulong n2 0 AG_EDGE_DATA
  ign_d1 = rx_graph_data g ulong n1 ulong n2 1 AG_EDGE_DATA
  ign_s0 = rx_graph_success g ulong n2 AG_OK
  rx_graph_identify g
  ign_r = rx_graph_reference_on g 1
end

fn test_fusion_lifecycle to void
  rx_fusion_observer_init
  note Build two graphs with same fragment structure (c1=10, c2=20)
  ft_build_sample_graph 0 10 20
  note Unverified run is refused
  ft_chk eq rx_fusion_observe 0 1 0 0
  ft_chk eq get fus_obs_meta 2 1
  note Observe verified run 3 times across 2 distinct graph digests
  ft_chk eq rx_fusion_observe 0 1 1 1
  ft_chk eq rx_fusion_observe 0 2 1 1
  put ag_digest 0 xor get ag_digest 0 1
  ft_chk eq rx_fusion_observe 0 3 1 1
  ft_chk eq get fus_obs_meta 1 3
  ft_chk ge get fus_obs_meta 0 1
  note Judge and rank candidates
  pol = new ulong 4 0
  put pol 0 3
  put pol 1 2
  put pol 2 100
  put pol 3 2
  cands = new ulong 16 0
  nc = rx_fusion_candidates pol cands 16
  ft_chk ge nc 1
  p0 = get cands 0
  note Build MetaSkill slot 0 (COMPILED) and slot 1 (HARDWARE -> rejected)
  ft_chk eq rx_fusion_build p0 AG_REAL_COMPILED 700 0 0
  ft_chk eq rx_fusion_build p0 AG_REAL_HARDWARE 701 1 0
  note Verify both
  ft_chk eq rx_fusion_verify 0 0
  ft_chk eq get fus_ms_meta 1 AG_MS_VERIFIED
  ft_chk eq rx_fusion_verify 1 0
  ft_chk eq get fus_ms_meta 25 AG_MS_REJECTED
  ft_chk eq get fus_ms_meta 37 AG_VR_NOT_RUNNABLE
  note Trial on verified MetaSkill finds 1 site
  app = new ulong 1 0
  ft_chk eq rx_fusion_trial 0 0 app 0
  ft_chk eq get app 0 1
  note Apply refuses unpublished MetaSkills
  ft_chk eq rx_fusion_apply 0 1 0
  ft_chk eq get fus_rep 1 0
  ft_chk eq get fus_rep 2 1
  note Measurement gate: fewer commits & crumbs, within latency tolerance
  ms = new ulong 11 0
  put ms 0 10
  put ms 1 4
  put ms 2 10
  put ms 3 4
  put ms 4 1000
  put ms 5 950
  put ms 6 50
  put ms 7 10
  put ms 8 10
  put ms 9 0
  put ms 10 0
  ft_chk eq rx_fusion_accept_measure 0 ms 50 0
  ft_chk eq get fus_ms_meta 1 AG_MS_MEASURED
  note Canary gate: 2 clean runs pass
  ft_chk eq rx_fusion_canary 0 0 2 0
  ft_chk eq get fus_ms_meta 1 AG_MS_MEASURED
  ft_chk eq rx_fusion_canary 0 0 2 0
  ft_chk eq get fus_ms_meta 1 AG_MS_CANARY_PASSED
  note Promote without authority fails; with authority succeeds
  ft_chk eq rx_fusion_promote 0 0 AG_FUSION_E_AUTHORITY
  ft_chk eq rx_fusion_promote 0 1 0
  ft_chk eq get fus_ms_meta 1 AG_MS_PROMOTED
  note Publish succeeds and apply now fuses 1 site
  ft_chk eq rx_fusion_publish 0 0
  ft_chk eq get fus_ms_meta 1 AG_MS_PUBLISHED
  ft_chk eq rx_fusion_apply 0 1 0
  ft_chk eq get fus_rep 1 1
  ft_chk eq get fus_rep 2 0
  note Step evidence chain helper returns nonzero
  ft_chk ne rx_fusion_site_steps 0 0 p0 0
end

fn ft_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len ft_msg_pass
    for i ulong n bound 64
      put buf i get ft_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len ft_msg_fail
  for i ulong n bound 64
    put buf i get ft_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_fusion_lifecycle
  if eq get ft_fail 0 0
    ft_put_msg 1
    ret 0
  end
  ft_put_msg 0
  ret 1
end

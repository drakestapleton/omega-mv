note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_operator_authority_misuse.om -- Pure seeded OM-2 port of
note tests/runtime/rx_operator_authority_misuse.c.
note Verifies R16 operator control capability cannot operate authority entry points
note (aienos#266/#272) while still passing the World halt check and office ops.

const OAM_RES_CONTROL ulong 2305
const OAM_RIGHT_HALT ulong 0x80
const OAM_ALL_PRIV ulong 0x1f0

global oam_checks ulong 1
global oam_fail ulong 1

text oam_pass "OMEGA_OPERATOR_AUTHORITY_MISUSE_REFUSED PASS\n"
text oam_fail_m "OMEGA_OPERATOR_AUTHORITY_MISUSE_REFUSED FAIL\n"

fn oam_chk cond bool to void
  put oam_checks 0 add get oam_checks 0 1
  if not cond
    if eq get oam_fail 0 0
      put oam_fail 0 get oam_checks 0
    end
  end
end

fn oam_mint hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 spec view ulong 3 dst edit ulong 2 to long
  req = new ulong 9 0
  put req 0 3
  put req 1 get spec 0
  put req 2 get spec 1
  put req 3 get spec 2
  put req 4 0
  put req 5 CAP_NONE
  put req 6 0
  put req 7 get rx_cap_office 0
  put req 8 get rx_cap_office 1
  ret rx_capadmin_mint hdr slots deliv tok req dst
end

fn oam_validate hdr view ulong 4 slots view ulong 3328 ref view ulong 2 spec view ulong 3 to long
  va = new ulong 5 0
  put va 0 get ref 0
  put va 1 get ref 1
  put va 2 get spec 0
  put va 3 get spec 1
  put va 4 get spec 2
  ent = new ulong 13 0
  ret rx_caproot_validate hdr slots va ent
end

fn oam_test_misuse hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 refs view ulong 6 to void
  note refs[0..1]=halt, refs[2..3]=wide, refs[4..5]=victim
  note (b) halt cap refused on authority entry points
  oam_chk ne rx_capadmin_bump_epoch hdr slots deliv tok get refs 0 get refs 1 ERR_OK
  ca = new ulong 3 0
  put ca 0 get refs 0
  put ca 1 get refs 1
  put ca 2 1
  oam_chk eq rx_capadmin_advance_clock hdr slots deliv tok ca ERR_UNAUTHORIZED
  ra = new ulong 4 0
  put ra 0 get refs 0
  put ra 1 get refs 1
  put ra 2 get refs 4
  put ra 3 get refs 5
  rlist = new ulong 257 0
  oam_chk eq rx_capadmin_revoke hdr slots deliv tok ra rlist ERR_UNAUTHORIZED
  mh = new ulong 9 0
  put mh 0 3
  put mh 1 2
  put mh 2 120
  put mh 3 1
  put mh 5 CAP_NONE
  put mh 7 get refs 0
  put mh 8 get refs 1
  minted = new ulong 2 0
  oam_chk eq rx_capadmin_mint hdr slots deliv tok mh minted ERR_UNAUTHORIZED

  note Wide control cap on control resource refused on every authority op
  oam_chk ne rx_capadmin_bump_epoch hdr slots deliv tok get refs 2 get refs 3 ERR_OK
  put ca 0 get refs 2
  put ca 1 get refs 3
  oam_chk ne rx_capadmin_advance_clock hdr slots deliv tok ca ERR_OK
  put ra 0 get refs 2
  put ra 1 get refs 3
  oam_chk ne rx_capadmin_revoke hdr slots deliv tok ra rlist ERR_OK
  rca = new ulong 3 0
  put rca 0 get refs 2
  put rca 1 get refs 3
  put rca 2 get refs 4
  oam_chk ne rx_capadmin_reclaim hdr slots deliv tok rca ERR_OK
  put mh 7 get refs 2
  put mh 8 get refs 3
  oam_chk ne rx_capadmin_mint hdr slots deliv tok mh minted ERR_OK

  note Victim still valid (nothing moved)
  vic = new ulong 2 0
  put vic 0 get refs 4
  put vic 1 get refs 5
  vsp = new ulong 3 0
  put vsp 0 2
  put vsp 1 119
  put vsp 2 1
  oam_chk eq oam_validate hdr slots vic vsp ERR_OK
end

fn oam_test_office_part1 hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 halt view ulong 2 victim view ulong 2 to void
  note (c) halt check accepts control cap on control resource, refuses on other resource
  sp = new ulong 3 0
  put sp 0 RX_OP_SUBJ
  put sp 1 OAM_RES_CONTROL
  put sp 2 OAM_RIGHT_HALT
  oam_chk eq oam_validate hdr slots halt sp ERR_OK
  put sp 1 119
  oam_chk eq oam_validate hdr slots halt sp ERR_RESOURCE

  note (a) legitimate authority ops by office: clock, revoke, reclaim
  ca = new ulong 3 0
  put ca 0 get rx_cap_office 0
  put ca 1 get rx_cap_office 1
  put ca 2 1
  oam_chk eq rx_capadmin_advance_clock hdr slots deliv tok ca ERR_OK
  ra = new ulong 4 0
  put ra 0 get rx_cap_office 0
  put ra 1 get rx_cap_office 1
  put ra 2 get victim 0
  put ra 3 get victim 1
  rlist = new ulong 257 0
  oam_chk eq rx_capadmin_revoke hdr slots deliv tok ra rlist ERR_OK
  put ca 2 get victim 0
  oam_chk eq rx_capadmin_reclaim hdr slots deliv tok ca ERR_OK
end

fn oam_test_office_part2 hdr edit ulong 4 slots edit ulong 3328 deliv edit uchar 256 tok view uchar 32 halt view ulong 2 to void
  sp = new ulong 3 0
  v2 = new ulong 2 0
  put sp 0 2
  put sp 1 121
  put sp 2 1
  oam_chk eq oam_mint hdr slots deliv tok sp v2 ERR_OK
  put sp 0 RX_OP_SUBJ
  put sp 1 0
  put sp 2 RIGHT_CLOCK
  oam_chk eq oam_mint hdr slots deliv tok sp v2 ERR_OK
  oam_chk eq rx_capadmin_bump_epoch hdr slots deliv tok get rx_cap_office 0 get rx_cap_office 1 ERR_OK
  note Control cap stale after office epoch bump
  put sp 0 RX_OP_SUBJ
  put sp 1 OAM_RES_CONTROL
  put sp 2 OAM_RIGHT_HALT
  oam_chk eq oam_validate hdr slots halt sp ERR_EPOCH
end

fn oam_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len oam_pass
    for i ulong n bound 64
      put buf i get oam_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len oam_fail_m
  for i ulong n bound 64
    put buf i get oam_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  hdr = new ulong 4 0
  slots = new ulong 3328 0
  deliv = new uchar 256 0
  tok = new uchar 32 0
  oam_chk eq rx_caproot_start hdr slots deliv tok ERR_OK
  halt = new ulong 2 0
  wide = new ulong 2 0
  victim = new ulong 2 0
  sp = new ulong 3 0
  put sp 0 RX_OP_SUBJ
  put sp 1 OAM_RES_CONTROL
  put sp 2 OAM_RIGHT_HALT
  oam_chk eq oam_mint hdr slots deliv tok sp halt ERR_OK
  put sp 2 OAM_ALL_PRIV
  oam_chk eq oam_mint hdr slots deliv tok sp wide ERR_OK
  put sp 0 2
  put sp 1 119
  put sp 2 1
  oam_chk eq oam_mint hdr slots deliv tok sp victim ERR_OK
  refs = new ulong 6 0
  put refs 0 get halt 0
  put refs 1 get halt 1
  put refs 2 get wide 0
  put refs 3 get wide 1
  put refs 4 get victim 0
  put refs 5 get victim 1
  oam_test_misuse hdr slots deliv tok refs
  oam_test_office_part1 hdr slots deliv tok halt victim
  oam_test_office_part2 hdr slots deliv tok halt
  ign_stop = rx_caproot_stop hdr slots deliv tok
  if eq get oam_fail 0 0
    oam_put_msg 1
    ret 0
  end
  oam_put_msg 0
  ret 1
end

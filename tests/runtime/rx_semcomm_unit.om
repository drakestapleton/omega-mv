note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_semcomm_unit.om -- Pure seeded OM-2 unit test for rx_semcomm.om.

global sc_checks ulong 1
global sc_fail ulong 1

text sc_msg_pass "RX_SEMCOMM_OM: PASS\n"
text sc_msg_fail "RX_SEMCOMM_OM: FAIL\n"

fn sc_chk cond bool to void
  put sc_checks 0 add get sc_checks 0 1
  if not cond
    put sc_fail 0 add get sc_fail 0 1
  end
end

fn setup_world to void
  for i ulong 256
    put sc_w_meta i 0
  end
  note obj 0: type 10, res 100, field 0=100 (ver 1, wrt 5), field 1=50 (private, ver 1, wrt 5), field 2=200 (unc)
  put sc_w_meta 0 1
  put sc_w_meta 1 1
  put sc_w_meta 2 10
  put sc_w_meta 3 100
  put sc_w_val 0 100
  put sc_w_ver 0 1
  put sc_w_wrt 0 5
  put sc_w_val 1 50
  put sc_w_ver 1 1
  put sc_w_wrt 1 5
  put sc_w_val 2 200
  put sc_w_ver 2 1
  put sc_w_wrt 2 5
  note obj 1: type 10, res 101, field 0=250 (ver 1, wrt 6), field 2=900 (high unc)
  put sc_w_meta 4 1
  put sc_w_meta 5 1
  put sc_w_meta 6 10
  put sc_w_meta 7 101
  put sc_w_val 8 250
  put sc_w_ver 8 1
  put sc_w_wrt 8 6
  put sc_w_val 10 900
  put sc_w_ver 10 1
  put sc_w_wrt 10 6
  note obj 2: type 10, res 102 (no cap -> withheld)
  put sc_w_meta 8 1
  put sc_w_meta 9 1
  put sc_w_meta 10 10
  put sc_w_meta 11 102
  put sc_w_val 16 999
  put sc_w_ver 16 1
  put sc_w_wrt 16 7
  note Schema for type 10: priv_mask=2 (field 1), has_unc=1, unc_field=2, conclusion=1
  put sc_sch_n 0 1
  put sc_sch 0 10
  put sc_sch 1 2
  put sc_sch 2 1
  put sc_sch 3 or 2 shl ulong 1 8
  note Receiver subject=7 holds READ on res 100 and 101 (NOT private 100|bit62, NOT 102)
  put sc_cap_hdr 0 7
  put sc_cap_hdr 1 2
  put sc_caps 0 100
  put sc_caps 1 1
  put sc_caps 2 1
  put sc_caps 3 101
  put sc_caps 4 1
  put sc_caps 5 1
end

fn test_project_delta_view to void
  setup_world
  sc_cursor_init
  rx_sem_view_init
  note Need: INSPECT fields 0 & 1, max_ppm=500, evidence=WRITER
  for i ulong 12
    put sc_need i 0
  end
  put sc_need 0 7
  put sc_need 1 SC_OP_INSPECT
  put sc_need 2 3
  put sc_need 8 SC_EV_WRITER
  put sc_need 9 500
  sc_chk eq rx_sem_project SC_OK
  note obj 0 included (field 1 withheld private), obj 1 excluded uncertain, obj 2 withheld authority
  sc_chk eq get sc_p_meta 0 1
  sc_chk eq get sc_p_meta 1 1
  sc_chk eq get sc_p_meta 5 1
  sc_chk eq get sc_p_meta 6 1
  sc_chk eq get sc_p_meta 7 1
  note Delta 1 (initial projection)
  st = new ulong 7 0
  sc_chk eq rx_sem_delta 7 1 st SC_OK
  sc_chk eq get st 4 1
  sc_chk eq get st 5 1
  sc_chk eq get st 0 1
  sc_chk gt rx_sem_cursor_bytes 0
  note Receiver applies message
  sc_chk eq rx_sem_view_apply get sc_wlen 0 SC_OK
  sc_chk eq get sc_v_pres 0 1
  sc_chk eq get sc_v_val 0 100
  sc_chk eq get sc_v_meta 0 1
  sc_chk gt rx_sem_view_bytes 0
  d1 = new uchar 32 0
  rx_sem_view_digest d1
  note Modify obj 0 field 0 -> version 2, value 150, writer 10 -> Delta 2 sends only changed field
  put sc_w_val 0 150
  put sc_w_ver 0 2
  put sc_w_wrt 0 10
  sc_chk eq rx_sem_project SC_OK
  sc_chk eq rx_sem_delta 7 2 st SC_OK
  sc_chk eq get st 4 0
  sc_chk eq get st 0 1
  sc_chk eq get st 1 1
  sc_chk eq rx_sem_view_apply get sc_wlen 0 SC_OK
  sc_chk eq get sc_v_val 0 150
  sc_chk eq get sc_v_ver 0 2
  d2 = new uchar 32 0
  rx_sem_view_digest d2
  diff = ulong 0
  for i ulong 32
    if ne get d1 i get d2 i
      diff = ulong 1
    end
  end
  sc_chk eq diff 1
  note Retire obj 0 -> Delta 3 sends object invalidation
  put sc_w_meta 0 0
  sc_chk eq rx_sem_project SC_OK
  sc_chk eq rx_sem_delta 7 3 st SC_OK
  sc_chk eq get st 2 1
  sc_chk eq rx_sem_view_apply get sc_wlen 0 SC_OK
  sc_chk eq get sc_v_pres 0 0
  sc_chk eq get sc_v_meta 1 1
end

fn test_derived_sum_max to void
  setup_world
  put sc_need 0 7
  put sc_need 1 SC_OP_SUM
  put sc_need 3 0
  put sc_need 8 SC_EV_NONE
  put sc_need 9 0
  sc_chk eq rx_sem_project SC_OK
  sc_chk eq get sc_p_meta 2 1
  sc_chk eq get sc_p_der 2 350
  sc_chk eq get sc_p_der 5 2
  put sc_need 1 SC_OP_MAX
  sc_chk eq rx_sem_project SC_OK
  sc_chk eq get sc_p_der 2 250
  sc_chk eq get sc_p_der 3 1
  sc_chk eq rx_sem_encode_projection 7 99 SC_OK
  rx_sem_view_init
  sc_chk eq rx_sem_view_apply get sc_wlen 0 SC_OK
  sc_chk eq get sc_v_nder 0 1
  sc_chk eq get sc_v_der 2 250
  sc_chk eq get sc_v_der 3 1
end

fn sc_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len sc_msg_pass
    for i ulong n bound 64
      put buf i get sc_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len sc_msg_fail
  for i ulong n bound 64
    put buf i get sc_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_project_delta_view
  test_derived_sum_max
  if eq get sc_fail 0 0
    sc_put_msg 1
    ret 0
  end
  sc_put_msg 0
  ret 1
end

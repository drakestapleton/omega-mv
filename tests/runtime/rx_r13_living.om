note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r13_living.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r13_living.c (R13 living World HOST mode;
note HOST_PASS_NON_SILICON, zero GPU/nvrm calls).
note Verifies living World creation, registration, 5-keyring caller enrollment,
note 16-trial experiment evidence, candidate authorship/authority gates,
note promotion, restore paths, and Argus causal telemetry merge.

global r13l_checks ulong 1
global r13l_fail ulong 1

text r13l_run "r13-living-host"
text r13l_store "/tmp/rx_r13_living_om"
text r13l_pass "RX_R13_LIVING_OM: PASS (HOST_PASS_NON_SILICON)\n"
text r13l_fail_m "RX_R13_LIVING_OM: FAIL\n"

fn r13l_chk cond bool to void
  put r13l_checks 0 add get r13l_checks 0 1
  if not cond
    if eq get r13l_fail 0 0
      put r13l_fail 0 get r13l_checks 0
    end
  end
end

fn r13l_test_living_lifecycle to void
  r13l_chk eq rx_living_create 0
  r13l_chk eq rx_living_register 0 -1
  r13l_chk eq rx_living_register 1 0
  r13l_chk eq rx_living_register_restore 1 0

  note Enroll production callers across 5 keyrings (wrong identity refused)
  r13l_chk eq rx_living_enroll_callers 1 -27
  r13l_chk eq rx_living_enroll_callers 0 0
  r13l_chk eq get rxl_kr_counts 0 2
  r13l_chk eq get rxl_kr_counts 3 3

  note Prepare experiment epoch 2 plan 1 and run 16 trials
  put rxl_search 0 2
  put rxl_search 6 1
  put rxl_plan 0 1
  r13l_chk eq rx_living_fn_prepare 0
  for t ulong 16
    r13l_chk eq rx_living_fn_seat_step 0
    r13l_chk eq rx_living_fn_evidence 0
  end
  r13l_chk eq get rxl_evidence 0 2
  r13l_chk eq get rxl_evidence 3 1
  r13l_chk eq get rxl_evidence 4 16

  note Candidate authorship refusal then pass
  put rxl_selection 0 2
  put rxl_selection 1 8888
  put rxl_selection 5 450
  put rxl_selection 6 12345
  put rxl_belief 0 2
  put rxl_belief 2 1
  put rxl_st 14 0
  r13l_chk eq rx_living_fn_candidate 0
  r13l_chk eq get rxl_st 6 RX_LIVING_WHY_AUTHOR
  put rxl_st 14 1
  r13l_chk eq rx_living_fn_candidate 0
  r13l_chk eq get rxl_candidate 0 1

  note Promotion without cap refused; with native cap succeeds
  r13l_chk eq rx_living_fn_promote 7 1 0
  r13l_chk ne get rxl_promotion 1 0
  rxl_cap_set 0 7 1 RX_LIVING_PROMOTE_SUBJ 2309 512
  put rxl_candidate 0 2
  put rxl_promotion 0 0
  r13l_chk eq rx_living_fn_promote 7 1 0
  r13l_chk eq get rxl_promotion 1 0
  r13l_chk eq get rxl_inforce 0 2
  r13l_chk eq get rxl_inforce 1 8888

  note Restore: genesis reference, bad config refused, matching identity restored
  put rxl_restore 0 1
  put rxl_blob_meta 0 0
  r13l_chk eq rx_living_fn_restore 0
  r13l_chk eq get rxl_restore 2 RX_LIVING_RESTORE_REFERENCE

  put rxl_restore 0 2
  put rxl_blob_meta 0 16
  put rxl_blob_meta 1 0
  put rxl_blob_meta 2 1
  put rxl_blob_meta 3 1
  r13l_chk eq rx_living_fn_restore 0
  r13l_chk eq get rxl_restore 2 RX_LIVING_RESTORE_REFUSED
  r13l_chk eq get rxl_restore 5 RX_LIVING_RESTORE_WHY_CONFIG

  put rxl_restore 0 3
  put rxl_blob_meta 1 1
  put rxl_blob_meta 6 777
  put rxl_blob_meta 7 5
  put rxl_blob_meta 8 300
  put rxl_blob_cfg_id 0 42
  put rxl_blob_act_id 0 42
  r13l_chk eq rx_living_fn_restore 0
  r13l_chk eq get rxl_restore 2 RX_LIVING_RESTORE_RESTORED
  r13l_chk eq get rxl_inforce 0 5
end

fn r13l_test_argus_audit to void
  r13l_chk eq rx_argus_start AR_CONS_INGEST r13l_run len r13l_run 0
  r13l_chk eq rx_argus_active 1
  rx_argus_emit_cap_granted 7 5 10 999 3 0
  k = rx_argus_use_begin
  for i ulong 4
    rx_argus_use_end k 7 5 add 10 i 999 0
  end
  sid = rx_argus_store_id r13l_store len r13l_store
  rx_argus_emit_world_committed sid 7 5 10 2 0
  n = rx_argus_merge 0
  r13l_chk eq n 3
  rx_argus_stats
  r13l_chk eq get ar_stats_buf 10 0
  r13l_chk eq get ar_stats_buf 11 0

  note Revoke cap 5 and verify use-after-revoke produces finding
  rx_argus_emit_cap_revoked 200 7 5 10 0
  k2 = rx_argus_use_begin
  rx_argus_use_end k2 7 5 10 999 0
  rx_argus_idle
  n2 = rx_argus_merge 0
  r13l_chk eq n2 2
  rx_argus_stats
  r13l_chk eq get ar_stats_buf 10 1
  rx_argus_shutdown
  r13l_chk eq rx_argus_active 0
end

fn r13l_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len r13l_pass
    for i ulong n bound 64
      put buf i get r13l_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len r13l_fail_m
  for i ulong n bound 64
    put buf i get r13l_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  r13l_test_living_lifecycle
  r13l_test_argus_audit
  if ne get r13l_fail 0 0
    r13l_put_msg 0
    ret int get r13l_fail 0
  end
  r13l_put_msg 1
  ret 0
end

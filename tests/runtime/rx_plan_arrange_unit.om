note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_plan_arrange_unit.om -- Pure seeded OM-2 unit test for rx_plan_arrange.om.

global plat_checks ulong 1
global plat_fail ulong 1

text plat_msg_pass "RX_PLAN_ARRANGE_OM: PASS\n"
text plat_msg_fail "RX_PLAN_ARRANGE_OM: FAIL\n"

fn plat_chk cond bool to void
  put plat_checks 0 add get plat_checks 0 1
  if not cond
    put plat_fail 0 add get plat_fail 0 1
  end
end

fn plat_setup_unit oid ulong gen ulong sup_ref ulong to void
  ob = mul oid 12
  put pl_view_obj ob 1
  put pl_view_obj add ob 1 PLA_OT_UNIT
  put pl_view_obj add ob 2 gen
  put pl_view_obj add ob 4 sup_ref
  put pl_view_obj add ob 6 pl_ref_pack oid gen
end

fn test_fact_pack_unpack to void
  f1 = pla_fact 3 7 0 5 11
  u = new ulong 5 0
  pla_fact_unpack f1 u
  plat_chk eq get u 0 3
  plat_chk eq get u 1 7
  plat_chk eq get u 2 0
  plat_chk eq get u 3 5
  plat_chk eq get u 4 11
  f2 = pla_fact 2 9 1 0 0
  pla_fact_unpack f2 u
  plat_chk eq get u 0 2
  plat_chk eq get u 1 9
  plat_chk eq get u 2 1
end

fn test_goal_plan_apply_generalize_bind to void
  for i ulong 768
    put pl_view_obj i 0
  end
  put pl_view_n 0 8
  note Initial state: unit 0 on floor, unit 1 on unit 0, unit 2 on floor (classic Sussman-style rearrange)
  plat_setup_unit 0 1 0
  plat_setup_unit 1 1 pl_ref_pack 0 1
  plat_setup_unit 2 1 0
  plat_chk eq pla_legal 1
  note Goal facts obj 4: want unit 0 on unit 1, unit 1 on unit 2, unit 2 on floor
  ob4 = ulong 48
  put pl_view_obj ob4 1
  put pl_view_obj add ob4 1 PLA_OT_GOALFACTS
  put pl_view_obj add ob4 2 1
  put pl_view_obj add ob4 4 pla_fact 0 1 0 1 1
  put pl_view_obj add ob4 5 pla_fact 1 1 0 2 1
  put pl_view_obj add ob4 6 pla_fact 2 1 1 0 0
  note Goal obj 3
  ob3 = ulong 36
  put pl_view_obj ob3 1
  put pl_view_obj add ob3 1 PLA_OT_GOAL
  put pl_view_obj add ob3 2 1
  put pl_view_obj add ob3 4 1
  put pl_view_obj add ob3 5 PLA_GOAL_ARRANGE
  put pl_view_obj add ob3 6 10
  put pl_view_obj add ob3 7 100
  put pl_view_obj add ob3 8 pl_ref_pack 4 1
  put pl_env_refs 0 3
  put pl_env_refs 1 1
  note Read goal
  plat_chk eq pla_goal_read 0
  plat_chk eq get pla_g_meta 4 3
  plat_chk eq get pla_g_meta 5 3
  plat_chk eq get pla_g_meta 6 1
  note Build target and solve with A*
  pla_target_from_goal
  plat_chk eq pla_plan 2000 0
  note Optimal plan: 1->2, 0->1 = 2 moves
  plat_chk eq get pla_p_n 0 2
  note Generalize BEFORE applying moves
  slots = new ulong 16 0
  plat_chk eq pla_generalize 0 0 slots 0
  note Template moves round-trip
  plat_chk eq pla_template_moves 0 slots 0
  plat_chk eq get pla_p_n 0 2
  note Bind template attempt 0 succeeds, attempt 1 returns 0 (only 1 chain)
  bound_s = new ulong 16 0
  plat_chk eq pla_bind 0 0 bound_s 1
  plat_chk eq pla_bind 0 1 bound_s 0
  note Target from template
  plat_chk eq pla_target_from_template 0 bound_s 0
  note Apply plan and verify final state is legal and satisfies goal
  plat_chk eq pla_apply 0
  plat_chk eq pla_legal 1
  plat_chk eq get pl_view_obj 4 pl_ref_pack 1 1
  plat_chk eq get pl_view_obj 16 pl_ref_pack 2 1
  plat_chk eq get pl_view_obj 28 0
end

fn plat_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len plat_msg_pass
    for i ulong n bound 64
      put buf i get plat_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len plat_msg_fail
  for i ulong n bound 64
    put buf i get plat_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_fact_pack_unpack
  test_goal_plan_apply_generalize_bind
  if eq get plat_fail 0 0
    plat_put_msg 1
    ret 0
  end
  plat_put_msg 0
  ret 1
end

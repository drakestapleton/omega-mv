note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_jspace_unit.om -- Pure seeded OM-2 unit test for rx_jspace.om.

global js_checks ulong 1
global js_fail ulong 1

text msg_pass "RX_JSPACE_OM: PASS\n"
text msg_fail "RX_JSPACE_OM: FAIL\n"

fn js_chk cond bool to void
  put js_checks 0 add get js_checks 0 1
  if not cond
    if eq get js_fail 0 0
      put js_fail 0 get js_checks 0
    end
  end
end

fn chk_sem_eq b0 ulong b1 ulong to void
  s0 = new uchar 32 0
  s1 = new uchar 32 0
  js_chk eq js_branch_semantic_id b0 s0 JS_OK
  js_chk eq js_branch_semantic_id b1 s1 JS_OK
  same = ulong 1
  for i ulong 32
    if ne get s0 i get s1 i
      same = ulong 0
    end
  end
  js_chk eq same 1
end

fn chk_edit_evict_spill b0 ulong b1 ulong to void
  orig = new uchar 64 0
  patch = new uchar 64 0
  buf = new uchar 64 0
  js_chk eq js_branch_read b0 1 orig JS_OK
  put patch 0 uchar 0xab
  put patch 1 uchar 0xcd
  js_chk eq js_branch_edit b1 1 4 patch 2 JS_OK
  js_chk eq js_branch_read b0 1 buf JS_OK
  js_chk eq get buf 4 get orig 4
  js_chk eq js_branch_read b1 1 buf JS_OK
  js_chk eq get buf 4 uchar 0xab
  js_chk eq get buf 5 uchar 0xcd

  r1 = get js_br_units add mul b1 JS_MAX_UNITS 1
  js_chk eq js_real_evict r1 JS_OK
  js_chk eq js_branch_read b1 1 buf JS_OK
  js_chk eq get buf 4 uchar 0xab
  js_chk eq get buf 5 uchar 0xcd

  js_chk eq js_real_spill r1 JS_OK
  js_chk eq js_branch_read b1 1 buf JS_OK
  js_chk eq get buf 4 uchar 0xab
end

fn test_sem_fork_edit_evict to void
  js_chk eq js_space_init JS_OK
  b0 = new ulong 1 0
  b1 = new ulong 1 0
  js_chk eq js_branch_root 1 42 b0 JS_OK
  js_chk eq js_branch_derive get b0 0 100 JS_OK
  js_chk eq js_branch_fork get b0 0 b1 JS_OK
  js_chk eq js_branch_derive get b0 0 200 JS_ERR_FROZEN
  chk_sem_eq get b0 0 get b1 0
  chk_edit_evict_spill get b0 0 get b1 0
end

fn test_staging_owner_forge_dual to void
  js_chk eq js_space_init JS_OK
  b0 = new ulong 1 0
  js_chk eq js_branch_root 1 99 b0 JS_OK
  ref0 = new ulong 2 0
  js_chk eq js_branch_ref get b0 0 ref0 JS_OK
  js_chk eq js_branch_check get ref0 0 get ref0 1 JS_OK

  note Staged fork with owner 7, wrong subject refused, reclaim_staged reclaims it
  ref1 = new ulong 2 0
  js_chk eq js_branch_fork_staged get ref0 0 get ref0 1 7 ref1 JS_OK
  info = new ulong 5 0
  js_chk eq js_branch_info get ref1 0 get ref1 1 info JS_OK
  js_chk eq get info 0 7
  js_chk eq get info 3 1
  js_chk eq js_branch_release_ref get ref1 0 get ref1 1 8 JS_ERR_OWNER
  js_chk eq js_space_reclaim_staged 1
  js_chk eq js_branch_check get ref1 0 get ref1 1 JS_ERR_STALE

  note Anchor roundtrip
  anc = new uchar 48 0
  put anc 0 uchar 0x42
  js_space_set_anchor anc
  anc2 = new uchar 48 0
  js_chk eq js_space_anchor anc2 1
  js_chk eq get anc2 0 uchar 0x42

  note FORGE enforce pass 1 compresses (64 -> 16), pass 2 evicts (16 -> 0)
  js_chk eq js_forge_enforce 0 JS_OK
  js_chk lt get js_stats 12 64
  js_chk eq js_forge_enforce 0 JS_OK
  js_chk eq get js_stats 12 0

  note DUAL-3a observation canonical 302-byte encoding
  dm = new ulong 5 0
  put dm 0 1
  put dm 1 bitcast ulong 1000000000.0f64
  put dm 2 JS_ACT_EVICT
  put dm 3 0
  put dm 4 64
  obs = new uchar 302 0
  js_chk eq js_dual_observation_encode dm obs 302
  js_chk eq get obs 0 uchar JS_DUAL_OBS_KIND
  js_chk eq get obs 1 uchar JS_DUAL_OBS_VERSION
  js_chk eq get obs 2 uchar 16
end

fn put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len msg_pass
    for i ulong n bound 64
      put buf i get msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len msg_fail
  for i ulong n bound 64
    put buf i get msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_sem_fork_edit_evict
  test_staging_owner_forge_dual
  if ne get js_fail 0 0
    put_msg 0
    ret int get js_fail 0
  end
  put_msg 1
  ret 0
end

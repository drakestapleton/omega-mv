note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r8_aegis.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r8_aegis.c (R8 AEGIS resident authority).
note Verifies policy rules (R|W grant, human-approval escalation/reject/approve,
note leased grant, out-of-domain policy mistake refused by root, no-rule denial,
note privileged-right denial), decision-origin forgery refusal, slot revoke,
note provenance check, and fast-path world execution without AEGIS re-entry.

const R8_SUBJ_WORKER ulong 51
const R8_RES_WORK ulong 150994945
const R8_RES_EFFECT ulong 150994961
const R8_RES_LEASED ulong 150994977
const R8_RES_OUTSIDE ulong 152043520
const R8_RES_NORULE ulong 150995008

global r8_checks ulong 1
global r8_fail ulong 1

text r8_pass "RX_R8_AEGIS_OM: PASS\n"
text r8_fail_m "RX_R8_AEGIS_OM: FAIL\n"

fn r8_chk cond bool to void
  put r8_checks 0 add get r8_checks 0 1
  if not cond
    if eq get r8_fail 0 0
      put r8_fail 0 get r8_checks 0
    end
  end
end

fn r8_make_rules rules edit ulong 112 to void
  note Rule 0: id=1, worker, [0x9000000..0x900000f], R|W (3), max_lease=0, approval=0
  put rules 0 1
  put rules 1 R8_SUBJ_WORKER
  put rules 2 150994944
  put rules 3 150994959
  put rules 4 3
  put rules 5 0
  put rules 6 0
  note Rule 1: id=2, worker, [0x9000010..0x900001f], R|W|E (7), max_lease=0, approval=1
  put rules 7 2
  put rules 8 R8_SUBJ_WORKER
  put rules 9 150994960
  put rules 10 150994975
  put rules 11 7
  put rules 12 0
  put rules 13 1
  note Rule 2: id=3, worker, [0x9000020..0x900002f], R (1), max_lease=100, approval=0
  put rules 14 3
  put rules 15 R8_SUBJ_WORKER
  put rules 16 150994976
  put rules 17 150994991
  put rules 18 1
  put rules 19 100
  put rules 20 0
  note Rule 3: id=4, worker, outside domain [0x9100000..0x9100000], R|W (3)
  put rules 21 4
  put rules 22 R8_SUBJ_WORKER
  put rules 23 R8_RES_OUTSIDE
  put rules 24 R8_RES_OUTSIDE
  put rules 25 3
  put rules 26 0
  put rules 27 0
end

fn r8_test_policy_and_decide to void
  rules = new ulong 112 0
  r8_make_rules rules
  in_f = new ulong 10 0
  dec = new ulong 8 0

  note Acquire RES_WORK -> GRANT
  put in_f 0 1
  put in_f 1 R8_RES_WORK
  put in_f 2 3
  put in_f 3 0
  put in_f 4 0
  put in_f 5 RX_AEGIS_OP_ACQUIRE
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_GRANT
  r8_chk eq get dec 6 1

  note Acquire RES_EFFECT without approval -> ESCALATE
  put in_f 0 2
  put in_f 1 R8_RES_EFFECT
  put in_f 2 7
  put in_f 4 1
  put in_f 8 1
  put in_f 9 RX_AEGIS_GRANT
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_ESCALATE

  note Human reject -> DENY + WHY_HUMAN
  put in_f 8 2
  put in_f 9 RX_AEGIS_ESCALATE
  put in_f 6 2
  put in_f 7 RX_AEGIS_REJECT
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_DENY
  r8_chk eq get dec 6 RX_AEGIS_WHY_HUMAN

  note Human approve -> GRANT
  put in_f 7 RX_AEGIS_APPROVE
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_GRANT

  note Acquire RES_LEASED with lease 200 -> clamped to 100
  put in_f 0 3
  put in_f 1 R8_RES_LEASED
  put in_f 2 1
  put in_f 3 200
  put in_f 4 2
  put in_f 6 0
  put in_f 7 0
  put in_f 8 2
  put in_f 9 RX_AEGIS_GRANT
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_GRANT
  r8_chk eq get dec 4 100

  note No rule -> DENY + WHY_NO_RULE
  put in_f 0 4
  put in_f 1 R8_RES_NORULE
  put in_f 2 1
  put in_f 3 0
  put in_f 4 0
  put in_f 8 3
  r8_chk eq rx_aegis_decide rules 4 R8_SUBJ_WORKER in_f dec 1
  r8_chk eq get dec 1 RX_AEGIS_DENY
  r8_chk eq get dec 6 RX_AEGIS_WHY_NO_RULE
end

fn r8_test_root_install_and_fastpath to void
  ctx = new ulong 18 0
  st = new ulong 16 0
  put st 1 RX_AEGIS_U32_MAX
  put st 14 10
  put ctx 14 R8_SUBJ_WORKER
  put ctx 15 150994944
  put ctx 16 150995199
  put ctx 17 7

  note Request & decision for RES_WORK
  put ctx 8 1
  put ctx 9 R8_RES_WORK
  put ctx 10 3
  put ctx 11 0
  put ctx 12 0
  put ctx 13 RX_AEGIS_OP_ACQUIRE
  put ctx 0 1
  put ctx 1 RX_AEGIS_GRANT
  put ctx 2 R8_RES_WORK
  put ctx 3 3
  put ctx 4 0
  put ctx 5 0
  put ctx 6 1
  put ctx 7 RX_AEGIS_OP_ACQUIRE

  note Attack 1: forged decision origin refused
  r8_chk eq rx_aegis_install_step ctx 2 st 1
  r8_chk eq get st 10 RX_AEGIS_WHY_DECISION_ORIGIN
  put st 8 0

  note Valid AEGIS decision installs live slot
  r8_chk eq rx_aegis_install_step ctx 3 st 1
  r8_chk eq get st 5 RX_AEGIS_SLOT_LIVE
  r8_chk eq get st 11 1

  note Attack 2: policy mistake outside worker domain refused by root
  put ctx 8 2
  put ctx 9 R8_RES_OUTSIDE
  put ctx 0 2
  put ctx 2 R8_RES_OUTSIDE
  r8_chk eq rx_aegis_install_step ctx 3 st 1
  r8_chk eq get st 10 RX_AEGIS_WHY_DOMAIN

  note Fast path in rx_world once capability is installed: 5 inputs commit directly
  r8_chk eq rx_world_init 64 0
  meta = new ulong 3 0
  put meta 0 1
  put meta 1 1
  put meta 2 R8_RES_WORK
  init_f = new ulong 8 0
  ref = new ulong 2 0
  r8_chk eq rx_world_create meta init_f ref 0
  r8_chk eq rx_world_create meta init_f ref 0
  rw_cap_install 0 1 1 0 R8_RES_WORK 3
  rw_cap_install 1 2 1 R8_SUBJ_WORKER R8_RES_WORK 3
  spec = new ulong 16 0
  put spec 0 1
  put spec 1 R8_SUBJ_WORKER
  put spec 2 1
  put spec 3 0
  put spec 4 1
  put spec 8 1
  put spec 9 1
  put spec 11 1
  put spec 12 2
  put spec 13 1
  put spec 14 R8_RES_WORK
  put spec 15 3
  rid = new ulong 1 0
  r8_chk eq rx_world_add_reaction spec rid 0
  for k ulong 5
    cid = rx_world_publish_external 1 1 0 0 0 add k 1
    r8_chk gt cid 0
    r8_chk eq rx_world_step_one 1
  end
  r8_chk eq get rw_stats 5 5
  chk = new ulong 1 0
  r8_chk eq rx_world_verify_crumbs chk 0
end

fn r8_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len r8_pass
    for i ulong n bound 64
      put buf i get r8_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len r8_fail_m
  for i ulong n bound 64
    put buf i get r8_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  r8_test_policy_and_decide
  r8_test_root_install_and_fastpath
  if eq get r8_fail 0 0
    r8_put_msg 1
    ret 0
  end
  r8_put_msg 0
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_contract_unit.om -- Pure seeded OM-2 unit test for rx_contract.om.

global ct_checks ulong 1
global ct_fail ulong 1

text ct_msg_pass "RX_CONTRACT_OM: PASS\n"
text ct_msg_fail "RX_CONTRACT_OM: FAIL\n"

fn ct_chk cond bool to void
  put ct_checks 0 add get ct_checks 0 1
  if not cond
    put ct_fail 0 add get ct_fail 0 1
  end
end

fn test_world_mutation_check_and_repair to void
  rc_context_init 7
  note Live object 3 with gen 5, resource 1000
  put rc_w_obj 9 1
  put rc_w_obj 10 5
  put rc_w_obj 11 1000
  note Principal 7 holds WRITE (2) on resources 1000 and 999
  put rc_ctx_cap 0 1000
  put rc_ctx_cap 1 RC_RIGHT_WRITE
  put rc_ctx_cap 2 999
  put rc_ctx_cap 3 RC_RIGHT_WRITE
  put rc_ctx 10 2
  note Forbidden range [9000, 9999]
  put rc_ctx 5 9000
  put rc_ctx 6 9999
  ct_chk eq rc_contract_std RC_WORLD_MUTATION 0
  ct_chk eq rc_compile 0
  ct_chk eq get rc_comp_cnt 0 7
  ct_chk eq get rc_comp_cnt 1 0
  note Valid world mutation: obj=3, gen=5, field=2, val=42, principal=7, resource=1000
  put rc_obj 0 RC_WORLD_MUTATION
  put rc_obj 1 3
  put rc_obj 2 5
  put rc_obj 3 2
  put rc_obj 4 42
  put rc_obj 5 7
  put rc_obj 6 1000
  put rc_obj 7 0
  put rc_obj 8 0
  ct_chk eq rc_check 0
  ct_chk eq get rc_v_meta 0 1
  note Wrong derived resource (999) fails rc_check, then rc_repair derives 1000!
  put rc_obj 6 999
  ct_chk eq rc_check -1
  ct_chk eq rc_repair 1
  ct_chk eq get rc_obj 6 1000
  ct_chk eq rc_check 0
  note Stale generation (4 != 5) fails and is NOT repairable!
  put rc_obj 2 4
  ct_chk eq rc_check -1
  ct_chk eq rc_repair -1
  put rc_obj 2 5
  note Encode -> decode -> identity round trip
  n = rc_encode
  ct_chk eq n 84
  rc_identity
  id0 = get rc_obj_id 0
  put rc_obj 4 0
  ct_chk eq rc_decode n 0
  ct_chk eq get rc_obj 4 42
  rc_identity
  ct_chk eq get rc_obj_id 0 id0
  note Truncated decode rejected
  ct_chk eq rc_decode sub n 1 -1
end

fn test_cap_need_narrow_and_evidence to void
  rc_context_init 9
  put rc_w_obj 3 1
  put rc_w_obj 4 1
  put rc_w_obj 5 555
  ct_chk eq rc_contract_std RC_CAPABILITY_NEED 0
  note Requesting PRIVILEGED bit (16) + READ (1) fails, rc_repair narrows to READ (1)
  put rc_obj 0 RC_CAPABILITY_NEED
  put rc_obj 1 9
  put rc_obj 2 10
  put rc_obj 3 555
  put rc_obj 4 17
  put rc_obj 5 0
  put rc_obj 6 1
  put rc_obj 7 1000
  put rc_obj 8 0
  ct_chk eq rc_check -1
  ct_chk ge rc_repair 1
  ct_chk eq get rc_obj 4 1
  ct_chk eq rc_check 0
  note Generation candidate requires PASS evidence
  rc_context_init 12
  put rc_ctx 2 3
  put rc_ctx 3 1
  put rc_ctx_vals 0 77
  ct_chk eq rc_contract_std RC_GENERATION_CANDIDATE 0
  put rc_obj 0 RC_GENERATION_CANDIDATE
  put rc_obj 1 4
  put rc_obj 2 3
  put rc_obj 3 1
  put rc_obj 4 888
  put rc_obj 5 1
  put rc_obj 6 2
  put rc_obj 7 12
  put rc_obj 8 77
  ct_chk eq rc_check -1
  ct_chk eq rc_context_add_evidence RC_EV_GENERATION 888 RC_VERDICT_PASS 0
  ct_chk eq rc_check 0
end

fn test_domain_contains_and_pick to void
  for i ulong 12
    put rc_dom i 0
  end
  put rc_dom 0 1
  put rc_dom 1 100
  put rc_dom 3 1
  put rc_dom 2 7
  ct_chk eq rc_domain_contains 5 1
  ct_chk eq rc_domain_contains 21 0
  out_v = new ulong 1 0
  note Bit-narrowing pick: 21 & 7 = 5
  ct_chk eq rc_domain_pick 21 out_v 0
  ct_chk eq get out_v 0 5
  note Explicit set pick: nearest to 12 in {3, 10, 20} is 10
  for i ulong 12
    put rc_dom i 0
  end
  put rc_dom 0 0
  put rc_dom 1 100
  put rc_dom 5 1
  put rc_dom 7 3
  put rc_dom_set 0 3
  put rc_dom_set 1 10
  put rc_dom_set 2 20
  ct_chk eq rc_domain_pick 12 out_v 0
  ct_chk eq get out_v 0 10
end

fn ct_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len ct_msg_pass
    for i ulong n bound 64
      put buf i get ct_msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len ct_msg_fail
  for i ulong n bound 64
    put buf i get ct_msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_world_mutation_check_and_repair
  test_cap_need_narrow_and_evidence
  test_domain_contains_and_pick
  if eq get ct_fail 0 0
    ct_put_msg 1
    ret 0
  end
  ct_put_msg 0
  ret 1
end

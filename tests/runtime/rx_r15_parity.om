note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_r15_parity.om -- Pure seeded OM-2 port of
note tests/runtime/rx_r15_parity.c (R15 SEQ semantic parity gate).
note Verifies non-sequential refusal, paired deterministic semantic
note parity (reaction trace, causal writer attribution, timing, and
note quiescence), stale-plan non-idle guard, multi-pulse completion,
note and timeout refusal.

global r15p_checks ulong 1
global r15p_fail ulong 1

text r15p_pass "SEQ_SEMANTIC_PARITY=PASS\nRX_R15_PARITY_OM: PASS\n"
text r15p_fail_m "SEQ_SEMANTIC_PARITY=FAIL\nRX_R15_PARITY_OM: FAIL\n"

fn r15p_chk cond bool to void
  put r15p_checks 0 add get r15p_checks 0 1
  if not cond
    if eq get r15p_fail 0 0
      put r15p_fail 0 get r15p_checks 0
    end
  end
end

fn r15p_run_episode out_meta edit ulong 6 to void
  seq_world_init 1 1
  seq_obj_set 0 1 1
  seq_obj_set 1 1 2
  seq_add_reaction 0 0 1
  seq_add_reaction 1 0 1
  seq_set_trigger 0 0 0 1 3
  seq_set_trigger 1 0 1 2 1
  seq_obj_write 0 0 5 42
  seq_obj_write 0 1 9 99
  seq_obj_write 1 0 7 55

  put seq_plan_meta 0 2
  put seq_plan_ord 0 0
  put seq_plan_ord 1 1

  pulses = new ulong 1 0
  rc = rx_seq_run_until_complete 10 pulses
  r15p_chk eq rc SEQ_OK
  put out_meta 0 get pulses 0
  put out_meta 1 get seq_trace_n 0
  put out_meta 2 get seq_trace_rid 0
  put out_meta 3 get seq_trace_cause 0
  put out_meta 4 get seq_trace_rid 1
  put out_meta 5 get seq_trace_cause 1
  r15p_chk gt get seq_w_meta 9 0
  r15p_chk gt get seq_w_meta 10 0
  r15p_chk eq get seq_w_meta 4 2
  r15p_chk eq get seq_w_meta 13 1
end

fn r15p_test_paired_parity to void
  note Non-sequential world refused
  seq_world_init 0 0
  ran = new ulong 1 0
  r15p_chk eq rx_seq_pulse ran SEQ_ERR_ARG

  note Paired semantic parity: two independent runs produce identical semantic trace
  m_a = new ulong 6 0
  m_b = new ulong 6 0
  r15p_run_episode m_a
  r15p_run_episode m_b
  for i ulong 6
    r15p_chk eq get m_a i get m_b i
  end
  r15p_chk eq get m_a 1 2
  r15p_chk eq get m_a 2 0
  r15p_chk eq get m_a 3 99
  r15p_chk eq get m_a 4 1
  r15p_chk eq get m_a 5 55
end

fn r15p_test_stale_plan_and_timeout to void
  note Stale plan covering 1 of 2 reactions must NOT mark world idle
  seq_world_init 1 0
  seq_add_reaction 0 0 1
  seq_add_reaction 1 0 1
  put seq_plan_meta 0 1
  put seq_plan_ord 0 0
  ran = new ulong 1 0
  r15p_chk eq rx_seq_pulse ran SEQ_OK
  r15p_chk eq get ran 0 0
  r15p_chk eq get seq_w_meta 4 0
  r15p_chk eq get seq_w_meta 13 0

  note Resident reaction wait & timeout control
  seq_world_init 1 0
  seq_add_reaction 0 1 1
  put seq_rx 2 1
  put seq_rx 3 777
  put seq_rx 11 3
  put seq_plan_meta 0 1
  put seq_plan_meta 1 50
  put seq_plan_meta 2 1
  put seq_plan_ord 0 0
  pulses = new ulong 1 0
  r15p_chk eq rx_seq_run_until_complete 10 pulses SEQ_OK
  r15p_chk eq get pulses 0 2
  r15p_chk eq get seq_rx 1 SEQ_DORMANT

  put seq_rx 2 1
  put seq_rx 11 500
  put seq_plan_meta 1 5
  r15p_chk eq rx_seq_pulse ran SEQ_ERR_TIMEOUT
end

fn r15p_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len r15p_pass
    for i ulong n bound 64
      put buf i get r15p_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len r15p_fail_m
  for i ulong n bound 64
    put buf i get r15p_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  r15p_test_paired_parity
  r15p_test_stale_plan_and_timeout
  if ne get r15p_fail 0 0
    r15p_put_msg 0
    ret int get r15p_fail 0
  end
  r15p_put_msg 1
  ret 0
end

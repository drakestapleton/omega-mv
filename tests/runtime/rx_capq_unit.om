note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_capq_unit.om -- Pure seeded OM-2 unit test for rx_capq.om.

global cq_checks ulong 1
global cq_fail ulong 1

text msg_pass "RX_CAPQ_OM: PASS\n"
text msg_fail "RX_CAPQ_OM: FAIL\n"

fn cq_chk cond bool to void
  put cq_checks 0 add get cq_checks 0 1
  if not cond
    if eq get cq_fail 0 0
      put cq_fail 0 get cq_checks 0
    end
  end
end

fn make_ent ent edit ulong 21 cap ulong real ulong mach ulong skill ulong to void
  for i ulong 21
    put ent i 0
  end
  put ent 0 cap
  put ent 1 real
  put ent 2 mach
  put ent 3 skill
  put ent 4 2
  put ent 5 CQ_SRC_SKILL
  put ent 6 2
  put ent 7 1
  put ent 8 1
  put ent 9 1
  put ent 10 0
  put ent 11 0
  put ent 12 900000
  put ent 13 950000
  put ent 14 100
  put ent 15 50
  put ent 16 10
  put ent 17 77
  put ent 18 CQ_LIVE_AVAILABLE
  put ent 19 1
  put ent 20 1
end

fn test_catalog_compile_rank_query to void
  mid_self = new uchar 32 0
  put mid_self 0 uchar 1
  put mid_self 31 uchar 7
  cq_chk eq cq_catalog_init_canonical 1 mid_self CQ_OK
  cq_chk eq cq_op_define 1 0 CQ_SRC_ALL CQ_OK
  cq_chk eq cq_op_define 2 1 CQ_SRC_ALL CQ_OK
  cq_chk eq cq_alias 100 1 CQ_OK
  cq_chk eq cq_resolve 100 1
  cq_chk eq cq_resolve 2 2
  cq_chk eq cq_resolve 999 0

  d1 = new uchar 32 0
  cq_ontology_digest d1
  note Register 3 entries: e0 (cost=100, lat=50), e1 (cost=200, lat=20), e2 (dominated: cost=300, lat=100)
  ent = new ulong 21 0
  sdig = new uchar 32 0
  put sdig 0 uchar 0xaa
  make_ent ent 10 1 1 5
  cq_chk eq cq_register ent sdig CQ_OK
  make_ent ent 11 2 1 6
  put ent 14 200
  put ent 15 20
  cq_chk eq cq_register ent sdig CQ_OK
  make_ent ent 12 3 1 7
  put ent 14 300
  put ent 15 100
  cq_chk eq cq_register ent sdig CQ_OK
  cq_chk eq cq_catalog_build CQ_OK

  note Compile via alias 100 -> resolves to op 1 + specialization op 2
  need = new ulong 15 0
  put need 0 100
  put need 1 1
  put need 2 1
  put need 3 1
  put need 7 CQ_LOC_LOCAL
  cq_chk eq cq_compile need CQ_OK
  cq_chk eq get cq_plan_op 0 1
  cq_chk eq get cq_plan_n_ops 0 2

  note Query with Pareto front (order: cost, latency) -> excludes dominated e2
  tr = new ulong 19 0
  put tr 0 2
  put tr 1 0
  put tr 2 1
  put tr 17 16
  cq_chk eq cq_query need tr 0 CQ_OK
  cq_chk eq get cq_res_n_feas 0 3
  cq_chk eq get cq_res_n_front 0 2
  cq_chk eq get cq_res_n 0 2
  note Winner is e0 (cap_id=10, cheapest cost)
  cq_chk eq get cq_res_cand 0 10

  note Availability & withdrawal
  cq_chk eq cq_set_availability 10 1 1 5 CQ_LIVE_UNAVAILABLE CQ_OK
  cq_chk eq cq_query need tr 0 CQ_OK
  cq_chk eq get cq_res_n 0 1
  cq_chk eq get cq_res_cand 0 11
  cq_chk eq get cq_stats 4 1
  cq_chk eq cq_withdraw 10 1 1 5 CQ_OK
  cq_chk eq cq_set_availability 10 1 1 5 CQ_LIVE_AVAILABLE CQ_E_WITHDRAWN

  note Bind skill node in graph 0
  rx_graph_init 0 1
  skn = rx_graph_node 0 AG_SKILL AG_T_U64
  cq_chk eq cq_bind_skill_node 0 ulong skn 0 CQ_OK
  cq_chk eq rx_graph_get_node 0 ulong skn 2 6
end

fn test_wire_roundtrip to void
  mid_a = new uchar 32 0
  put mid_a 0 uchar 0x11
  cq_chk eq cq_catalog_init_canonical 1 mid_a CQ_OK
  cq_chk eq cq_op_define 1 0 CQ_SRC_ALL CQ_OK
  ent = new ulong 21 0
  sdig = new uchar 32 0
  put sdig 0 uchar 0x55
  make_ent ent 20 1 1 9
  put ent 4 1
  put ent 20 3
  cq_chk eq cq_register ent sdig CQ_OK
  rec = new uchar 188 0
  cq_chk eq cq_wire_encode 0 CQ_WIRE_ADVERTISE rec CQ_OK

  note Self-originated record is refused by cq_wire_apply
  cq_chk eq cq_wire_apply rec CQ_E_WIRE

  note Switch to machine B and ingest record from A
  mid_b = new uchar 32 0
  put mid_b 0 uchar 0x22
  cq_chk eq cq_catalog_init_canonical 1 mid_b CQ_OK
  cq_chk eq cq_op_define 1 0 CQ_SRC_ALL CQ_OK
  cq_chk eq cq_wire_apply rec CQ_OK
  note Stale replay (same generation 3) is refused with CQ_E_STALE
  cq_chk eq cq_wire_apply rec CQ_E_STALE
  note Tampered byte fails checksum with CQ_E_WIRE
  put rec 60 xor get rec 60 uchar 1
  cq_chk eq cq_wire_apply rec CQ_E_WIRE
end

fn put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len msg_pass
    for i ulong n bound 64
      put buf i get msg_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len msg_fail
  for i ulong n bound 64
    put buf i get msg_fail i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  test_catalog_compile_rank_query
  test_wire_roundtrip
  if ne get cq_fail 0 0
    put_msg 0
    ret int get cq_fail 0
  end
  put_msg 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/runtime/rx_compose_attach_test.om -- Pure seeded OM-2 port of
note tests/runtime/rx_compose_attach_test.c (attached World mode: caller
note keyring enrollment, external subject range guard, duplicate-dir
note refusal, dual-instance namespace isolation, and slot release).

global att_checks ulong 1
global att_fail ulong 1

text att_dir_a "/tmp/rxc_attach_a"
text att_dir_b "/tmp/rxc_attach_b"
text att_dir_c "/tmp/rxc_attach_c"
text att_pass "RX_COMPOSE_ATTACH_TEST_OM: PASS\n"
text att_fail_m "RX_COMPOSE_ATTACH_TEST_OM: FAIL\n"

fn att_chk cond bool to void
  put att_checks 0 add get att_checks 0 1
  if not cond
    if eq get att_fail 0 0
      put att_fail 0 get att_checks 0
    end
  end
end

fn att_copy_a dst edit uchar 128 to ulong
  n = len att_dir_a
  for i ulong n bound 128
    put dst i get att_dir_a i
  end
  ret n
end

fn att_copy_b dst edit uchar 128 to ulong
  n = len att_dir_b
  for i ulong n bound 128
    put dst i get att_dir_b i
  end
  ret n
end

fn att_copy_c dst edit uchar 128 to ulong
  n = len att_dir_c
  for i ulong n bound 128
    put dst i get att_dir_c i
  end
  ret n
end

fn att_test_enroll_and_attach_slots to void
  note Enroll callers into unbound world
  put rxc_st 18 0
  put rxc_taken 0 0
  att_chk eq rx_compose_enroll_callers RXC_OK
  att_chk eq get rxc_st 19 8
  att_chk eq get rxc_keyring 0 rxc_subj_of 0 RXC_SUBJ_CAND0
  att_chk eq get rxc_keyring 3 rxc_subj_of 0 RXC_SUBJ_COMMIT
  att_chk eq get rxc_keyring 4 rxc_subj_of 1 RXC_SUBJ_CAND0
  att_chk eq get rxc_keyring 7 rxc_subj_of 1 RXC_SUBJ_COMMIT

  note Bound world refuses enrollment
  put rxc_st 18 1
  att_chk eq rx_compose_enroll_callers RXC_ERR_IDENTITY

  da = new uchar 128 0
  db = new uchar 128 0
  dc = new uchar 128 0
  la = att_copy_a da
  lb = att_copy_b db
  lc = att_copy_c dc

  note External subject inside composition reserved range is refused
  att_chk eq rx_compose_attach RXC_SUBJ_EXTERNAL da la 1 10 RXC_ERR_ARG
  att_chk eq rx_compose_attach rxc_subj_of 1 RXC_SUBJ_CAND0 da la 1 10 RXC_ERR_ARG

  note Attach instance 0 on dir_a
  att_chk eq rx_compose_attach 500 da la 1 10 RXC_OK
  att_chk eq get rxc_st 1 0
  att_chk eq get rxc_st 2 0
  att_chk eq get rxc_st 17 500
  att_chk eq get rxc_subj 0 rxc_subj_of 0 RXC_SUBJ_CAND0
  att_chk eq get rxc_res 0 rxc_res_of 0 RXC_RES_GOAL

  note Duplicate dir_a refused
  att_chk eq rx_compose_attach 501 da la 2 20 RXC_ERR_EXISTS

  note Run a goal on attached instance 0
  att_chk eq rx_compose_run 77 101 1 202 0 RXC_OK
  att_chk eq get rxc_last_res 0 RXC_OUT_COMMITTED

  note Attach instance 1 on dir_b -> gets slot 1 and distinct subject/resource namespace
  att_chk eq rx_compose_attach 501 db lb 2 20 RXC_OK
  att_chk eq get rxc_st 2 1
  att_chk eq get rxc_subj 0 rxc_subj_of 1 RXC_SUBJ_CAND0
  att_chk eq get rxc_res 0 rxc_res_of 1 RXC_RES_GOAL

  note 3rd concurrent attach on dir_c refused (RXC_MAX_ACTIVE=2)
  att_chk eq rx_compose_attach 502 dc lc 3 30 RXC_ERR_EXISTS

  note Close instance 1 releases slot 1, allowing dir_c to attach cleanly
  rx_compose_close
  att_chk eq rx_compose_attach 502 dc lc 3 30 RXC_OK
  att_chk eq get rxc_st 2 1
  rx_compose_close
end

fn att_put_msg ok ulong to void
  buf = new uchar 64 0
  if ne ok 0
    n = len att_pass
    for i ulong n bound 64
      put buf i get att_pass i
    end
    ign_p = write 1 buf 0 n
    ret
  end
  n = len att_fail_m
  for i ulong n bound 64
    put buf i get att_fail_m i
  end
  ign_f = write 1 buf 0 n
end

fn main to int
  att_test_enroll_and_attach_slots
  if ne get att_fail 0 0
    att_put_msg 0
    ret int get att_fail 0
  end
  att_put_msg 1
  ret 0
end

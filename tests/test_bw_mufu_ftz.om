note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/bw_mufu_ftz_test.c.
note Verifies the MUFU flush-to-zero rule (subnormals flushed to sign-preserving zero;
note zeros, normals, inf, NaN pass) across subnormal mantissa samples + extremes,
note plus all 22 MUFU EX2/RCP/RSQ cases from tests/bw_mufu_ftz_test.c.
note Host-only, CPU-only, zero GPU access.
om2

text t_mufu_pass "PASS test_bw_mufu_ftz\n"
text t_mufu_fail "FAIL test_bw_mufu_ftz\n"

fn ws_mufu_ftz u uint to uint
  if eq and u uint 0x7f800000 0
    ret and u uint 0x80000000
  end
  ret u
end

fn ws_mufu_rcp u uint to uint
  xu = ws_mufu_ftz u
  x = bitcast f32 xu
  one = bitcast f32 uint 0x3f800000
  r = bitcast uint div one x
  ret ws_mufu_ftz r
end

fn ws_mufu_rsq u uint to uint
  xu = ws_mufu_ftz u
  x = bitcast f32 xu
  one = bitcast f32 uint 0x3f800000
  r = bitcast uint div one fsqrt x
  ret ws_mufu_ftz r
end

fn ws_mufu_ex2 u uint to uint
  xu = ws_mufu_ftz u
  absu = and xu uint 0x7fffffff
  if gt absu uint 0x7f800000
    ret xu
  end
  if eq xu uint 0x7f800000
    ret uint 0x7f800000
  end
  if eq xu uint 0xff800000
    ret uint 0x00000000
  end
  if eq absu 0
    ret uint 0x3f800000
  end
  sign = and xu uint 0x80000000
  ex = int and shr xu 23 255
  mant = or and xu uint 0x007fffff uint 0x00800000
  shift = sub ex 127
  if lt shift 0
    ret uint 0x3f800000
  end
  if gt shift 23
    if ne sign 0
      ret uint 0x00000000
    end
    ret uint 0x7f800000
  end
  mag = int shr mant uint sub 23 shift
  k = mag
  if ne sign 0
    k = sub 0 mag
  end
  if le k -127
    ret uint 0x00000000
  end
  if ge k 128
    ret uint 0x7f800000
  end
  ret ws_mufu_ftz shl uint add k 127 23
end

fn mufu_expect got uint want uint to long
  wnan = gt and want uint 0x7fffffff uint 0x7f800000
  if wnan
    if gt and got uint 0x7fffffff uint 0x7f800000
      ret 0
    end
    ret -1
  end
  if eq got want
    ret 0
  end
  ret -1
end

fn mufu_test_helper to long
  m = uint 1
  while lt m uint 0x800000 bound 4096
    if ne mufu_expect ws_mufu_ftz m uint 0x00000000 0
      ret 10
    end
    nm = or uint 0x80000000 m
    if ne mufu_expect ws_mufu_ftz nm uint 0x80000000 0
      ret 11
    end
    if or lt m 64 gt m uint 0x7fffc0
      m = add m 1
    else
      m = add m 4093
    end
  end

  pass = new uint 14 0
  put pass 0 0x00000000
  put pass 1 0x80000000
  put pass 2 0x00800000
  put pass 3 0x80800000
  put pass 4 0x3f800000
  put pass 5 0xbf800000
  put pass 6 0x7f7fffff
  put pass 7 0xff7fffff
  put pass 8 0x7f800000
  put pass 9 0xff800000
  put pass 10 0x7fc00000
  put pass 11 0xffc00000
  put pass 12 0x7f800001
  put pass 13 0x00ffffff
  for i ulong 14
    v = get pass i
    if ne mufu_expect ws_mufu_ftz v v 0
      ret 12
    end
  end

  if ne mufu_expect ws_mufu_ex2 uint 0xc3020000 uint 0x00000000 0
    ret 13
  end
  if ne mufu_expect ws_mufu_rcp uint 0xff400000 uint 0x80000000 0
    ret 14
  end
  if ne mufu_expect ws_mufu_rsq uint 0x00000200 uint 0x7f800000 0
    ret 15
  end
  ret 0
end

fn mufu_test_cases to long
  note Subnormal result -> sign-preserving zero
  if ne mufu_expect ws_mufu_ex2 uint 0xc3020000 uint 0x00000000 0
    ret 20
  end
  if ne mufu_expect ws_mufu_ex2 uint 0xc2fe0000 uint 0x00000000 0
    ret 21
  end
  if ne mufu_expect ws_mufu_rcp uint 0x7f400000 uint 0x00000000 0
    ret 22
  end
  if ne mufu_expect ws_mufu_rcp uint 0xff400000 uint 0x80000000 0
    ret 23
  end

  note Subnormal input -> treated as zero of the same sign
  if ne mufu_expect ws_mufu_rcp uint 0x00400000 uint 0x7f800000 0
    ret 24
  end
  if ne mufu_expect ws_mufu_rcp uint 0x80400000 uint 0xff800000 0
    ret 25
  end
  if ne mufu_expect ws_mufu_rsq uint 0x00000200 uint 0x7f800000 0
    ret 26
  end
  if ne mufu_expect ws_mufu_ex2 uint 0x80000200 uint 0x3f800000 0
    ret 27
  end

  note Controls: unchanged by the flush
  if ne mufu_expect ws_mufu_ex2 uint 0xc2fc0000 uint 0x00800000 0
    ret 28
  end
  if ne mufu_expect ws_mufu_ex2 uint 0x40400000 uint 0x41000000 0
    ret 29
  end
  if ne mufu_expect ws_mufu_ex2 uint 0xff800000 uint 0x00000000 0
    ret 30
  end
  if ne mufu_expect ws_mufu_ex2 uint 0x7f800000 uint 0x7f800000 0
    ret 31
  end
  if ne mufu_expect ws_mufu_ex2 uint 0x7fc00000 uint 0x7fc00000 0
    ret 32
  end
  if ne mufu_expect ws_mufu_rcp uint 0x7e800000 uint 0x00800000 0
    ret 33
  end
  if ne mufu_expect ws_mufu_rcp uint 0x40000000 uint 0x3f000000 0
    ret 34
  end
  if ne mufu_expect ws_mufu_rcp uint 0x80000000 uint 0xff800000 0
    ret 35
  end
  if ne mufu_expect ws_mufu_rcp uint 0xff800000 uint 0x80000000 0
    ret 36
  end
  if ne mufu_expect ws_mufu_rcp uint 0x7fc00000 uint 0x7fc00000 0
    ret 37
  end
  if ne mufu_expect ws_mufu_rsq uint 0x40800000 uint 0x3f000000 0
    ret 38
  end
  if ne mufu_expect ws_mufu_rsq uint 0x00800000 uint 0x5f000000 0
    ret 39
  end
  if ne mufu_expect ws_mufu_rsq uint 0x7f800000 uint 0x00000000 0
    ret 40
  end
  if ne mufu_expect ws_mufu_rsq uint 0x80000000 uint 0xff800000 0
    ret 41
  end
  ret 0
end

fn main to int
  if ne mufu_test_helper 0
    ign = write 1 t_mufu_fail 0 len t_mufu_fail
    ret 1
  end
  if ne mufu_test_cases 0
    ign = write 1 t_mufu_fail 0 len t_mufu_fail
    ret 2
  end
  ign = write 1 t_mufu_pass 0 len t_mufu_pass
  ret 0
end

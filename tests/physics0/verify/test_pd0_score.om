note SPDX-License-Identifier: Apache-2.0
note tests/physics0/verify/test_pd0_score.om: scorer and negative controls (C test_pd0_score.c). The oracle
note passes every scored level; NC-1 null, NC-2 shuffled and M1-M6 fail for the recorded reason.
note Same scenarios, same checks, same order, the same stdout and the same receipts as the C test.

global ts_checks ulong 1
global ts_fails ulong 1

text TS_DIR "build/tests-physics0-verify/receipts"
text TS_FAIL "FAIL test_pd0_score.om check "
text TS_RFAIL "receipt write failed\n"
text TS_SUM1 "test_pd0_score: "
text TS_SUM2 " checks, "
text TS_SUM3 " failed\n"
text TS_X_MASK "fail_mask: 0x"
text TS_X_IN "\ninbox_nrmse_micro: "
text TS_X_EX "\nextrap_nrmse_micro: "
text TS_X_ONE "\nonestep_nrmse_micro: "
text TS_X_SIZE "\nsize: "
text TS_X_BITS "\nbits: "
text TS_X_REF "\nref_nrmse_micro: "
text TS_HIGHEST "highest_state: "
text TS_L "L"
text TS_SEED " seed "
text TS_ORC " oracle: "
text TS_MASK " mask 0x"
text TS_INBOX " inbox "
text TS_EXTRAP " extrap "
text TS_ONE " one "
text TS_REF " ref "
text TS_CAL " calibration: oracle inbox "
text TS_CAL2 "; latent-free reference inbox "
text TS_CAL3 " (needs >= "
text TS_CAL4 " for the 6.3 L6 condition) -> "
text TS_NOTMET "SPEC CONDITION NOT MET"
text TS_MET "met"
text TS_RS " reference solver: code "
text TS_ONESTEP " one-step "
text TS_SIZE " size "
text K_ORACLE "score-oracle"
text K_M1 "score-M1"
text K_M2 "score-M2"
text K_M3 "score-M3"
text K_M5M1 "score-M5-M1"
text K_M5M2 "score-M5-M2"
text K_M5M3 "score-M5-M3"
text K_REF "score-reference"
text K_L6LF "score-L6-latent-free"
text K_NC1 "NC1-null"
text K_NC2 "NC2-shuffled"

const TS_REL ulong 77
const TS_EMPTY ulong 78
const TS_REFS ulong 79

fn ts_check cond bool id ulong to void
put ts_checks 0 add get ts_checks 0 ulong 1
b = new uchar 96 0
if not cond
put ts_fails 0 add get ts_fails 0 ulong 1
p = pd0_buf_str edit b ulong 0 ulong 96 TS_FAIL
p = pd0_buf_u64 edit b p ulong 96 id
p = pd0_buf_ch edit b p ulong 96 uchar 10
pd0_put_bytes 2 view b p
end
ret
end

fn ts_has code int to bool
bit = shl uint 1 uint sub code 300
ret ne and get sr_fail_mask 0 bit uint 0
end

note lowercase hex without leading zeros (printf %x)
fn ts_hex dst edit uchar * pos ulong cap ulong v uint to ulong
dg = new uchar 8 0
n = ulong 0
x = v
while true bound 9
d = and x uint 15
c = add uchar d uchar 48
if gt d uint 9
c = add uchar d uchar 87
end
put dg n c
n = add n 1
x = shr x 4
if eq x uint 0
break
end
end
p = pos
while gt n ulong 0 bound 9
n = sub n 1
p = pd0_buf_ch dst p cap get dg n
end
ret p
end

fn ts_extra x edit uchar 256 to ulong
p = pd0_buf_str edit x ulong 0 ulong 256 TS_X_MASK
p = ts_hex edit x p ulong 256 get sr_fail_mask 0
p = pd0_buf_str edit x p ulong 256 TS_X_IN
p = pd0_buf_i64 edit x p ulong 256 get sr_inbox 0
p = pd0_buf_str edit x p ulong 256 TS_X_EX
p = pd0_buf_i64 edit x p ulong 256 get sr_extrap 0
p = pd0_buf_str edit x p ulong 256 TS_X_ONE
p = pd0_buf_i64 edit x p ulong 256 get sr_onestep 0
p = pd0_buf_str edit x p ulong 256 TS_X_SIZE
p = pd0_buf_u64 edit x p ulong 256 ulong get sr_size 0
p = pd0_buf_str edit x p ulong 256 TS_X_BITS
p = pd0_buf_u64 edit x p ulong 256 ulong get sr_bits 0
p = pd0_buf_str edit x p ulong 256 TS_X_REF
p = pd0_buf_i64 edit x p ulong 256 get sr_ref 0
p = pd0_buf_ch edit x p ulong 256 uchar 10
ret p
end

note C receipt(): hash of the relation's REL1 bytes, the score result as the extra block
fn ts_receipt kind view uchar * slot ulong to void
b = new uchar 8192 0
h = new uchar 32 0
x = new uchar 256 0
n = vr_rel_write slot edit b
pd0_sha256_hash view b n edit h
xn = ts_extra edit x
if ne pd0_receipt_write kind view h get sr_code 0 part x 0 xn 0
pd0_put_bytes 2 TS_RFAIL ulong 21
end
ret
end

note C pd0_receipt_write with "highest_state: <name>\n" over the ledger hash
fn ts_state_receipt kind view uchar * code int to void
h = new uchar 32 0
x = new uchar 128 0
vledg_sha256 edit h
p = pd0_buf_str edit x ulong 0 ulong 128 TS_HIGHEST
p = lad_buf_state_name edit x p ulong 128 get lr_state 0
p = pd0_buf_ch edit x p ulong 128 uchar 10
rc = pd0_receipt_write kind view h code part x 0 p
ret
end

fn ts_score_rel slot ulong to int
ret pd0_score slot uint 0 0
end

fn ts_score_mem to int
vr_clear TS_EMPTY
put vr_nvars TS_EMPTY uchar 2
put vr_nch TS_EMPTY uchar 1
ret pd0_score TS_EMPTY ctrl_mem_stored_numbers get sf_n_fit 0 uchar 2 1
end

fn ts_m1 to void
ex = new uchar 16 0
put ex 0 uchar 1
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
ctrl_mut_scale_coef TS_REL uchar 1 view ex long 110 long 100
rc = ts_score_rel TS_REL
ret
end

fn ts_m2 to void
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
ctrl_mut_pad TS_REL uint 5 long 1
rc = ts_score_rel TS_REL
ret
end

fn ts_oracle_err lv int seed ulong rc int to void
b = new uchar 512 0
p = pd0_buf_str edit b ulong 0 ulong 512 TS_L
p = pd0_buf_i64 edit b p ulong 512 long lv
p = pd0_buf_str edit b p ulong 512 TS_SEED
p = pd0_buf_u64 edit b p ulong 512 seed
p = pd0_buf_str edit b p ulong 512 TS_ORC
p = pd0v_name_buf edit b p ulong 512 rc
p = pd0_buf_str edit b p ulong 512 TS_MASK
p = ts_hex edit b p ulong 512 get sr_fail_mask 0
p = pd0_buf_str edit b p ulong 512 TS_INBOX
p = pd0_buf_i64 edit b p ulong 512 get sr_inbox 0
p = pd0_buf_str edit b p ulong 512 TS_EXTRAP
p = pd0_buf_i64 edit b p ulong 512 get sr_extrap 0
p = pd0_buf_str edit b p ulong 512 TS_ONE
p = pd0_buf_i64 edit b p ulong 512 get sr_onestep 0
p = pd0_buf_str edit b p ulong 512 TS_REF
p = pd0_buf_i64 edit b p ulong 512 get sr_ref 0
p = pd0_buf_ch edit b p ulong 512 uchar 10
pd0_put_bytes 2 view b p
ret
end

fn ts_l6_line seed ulong to void
b = new uchar 512 0
p = pd0_buf_str edit b ulong 0 ulong 512 TS_L
p = pd0_buf_ch edit b p ulong 512 uchar 54
p = pd0_buf_str edit b p ulong 512 TS_SEED
p = pd0_buf_u64 edit b p ulong 512 seed
p = pd0_buf_str edit b p ulong 512 TS_CAL
p = pd0_buf_i64 edit b p ulong 512 get sr_inbox 0
p = pd0_buf_str edit b p ulong 512 TS_EXTRAP
p = pd0_buf_i64 edit b p ulong 512 get sr_extrap 0
p = pd0_buf_str edit b p ulong 512 TS_CAL2
p = pd0_buf_i64 edit b p ulong 512 get sr_ref 0
p = pd0_buf_str edit b p ulong 512 TS_CAL3
p = pd0_buf_i64 edit b p ulong 512 mul long 3 get sp_inbox_bound 0
p = pd0_buf_str edit b p ulong 512 TS_CAL4
if ne get sr_fail_mask 0 uint 0
p = pd0_buf_str edit b p ulong 512 TS_NOTMET
else
p = pd0_buf_str edit b p ulong 512 TS_MET
end
p = pd0_buf_ch edit b p ulong 512 uchar 10
pd0_put_bytes 1 view b p
ret
end

fn ts_ref_line lv int to void
b = new uchar 512 0
p = pd0_buf_str edit b ulong 0 ulong 512 TS_L
p = pd0_buf_i64 edit b p ulong 512 long lv
p = pd0_buf_str edit b p ulong 512 TS_RS
p = pd0v_name_buf edit b p ulong 512 get sr_code 0
p = pd0_buf_str edit b p ulong 512 TS_MASK
p = ts_hex edit b p ulong 512 get sr_fail_mask 0
p = pd0_buf_str edit b p ulong 512 TS_INBOX
p = pd0_buf_i64 edit b p ulong 512 get sr_inbox 0
p = pd0_buf_str edit b p ulong 512 TS_ONESTEP
p = pd0_buf_i64 edit b p ulong 512 get sr_onestep 0
p = pd0_buf_str edit b p ulong 512 TS_SIZE
p = pd0_buf_u64 edit b p ulong 512 ulong get sr_size 0
p = pd0_buf_ch edit b p ulong 512 uchar 10
pd0_put_bytes 1 view b p
ret
end

fn ts_ok_zero rc int to bool
if ne rc 0
ret false
end
ret eq get sr_fail_mask 0 uint 0
end

fn ts_l6_mask_ok to bool
bit = shl uint 1 uint sub PD0V_SCORE_L6_REFERENCE_TOO_GOOD 300
ret eq and get sr_fail_mask 0 not bit uint 0
end

fn ts_m2_ok to bool
if not ts_has PD0V_SCORE_SIZE
ret false
end
ret not ts_has PD0V_SCORE_SUPPORT_MISSING
end

fn ts_m3_ok all3 int to bool
if not ts_has PD0V_SCORE_SIZE
ret false
end
if not ts_has PD0V_SCORE_SUPPORT_MISSING
ret false
end
if eq all3 0
ret true
end
ret ts_has PD0V_SCORE_EXTRAP_NRMSE
end

note M5: bounds loosened 100x; structure, constants and size must still bite
fn ts_m5 to void
ib = get sp_inbox_bound 0
eb = get sp_extrap_bound 0
ob = get sp_onestep_bound 0
put sp_inbox_bound 0 mul ib long 100
put sp_extrap_bound 0 mul eb long 100
put sp_onestep_bound 0 mul ob long 100
ts_m1
ts_receipt K_M5M1 TS_REL
ts_check ts_has PD0V_SCORE_CONSTANT_OFF ulong 6
ts_m2
ts_receipt K_M5M2 TS_REL
ts_check ts_has PD0V_SCORE_SIZE ulong 7
rc = ts_score_mem
ts_receipt K_M5M3 TS_EMPTY
ts_check ts_m3_ok 0 ulong 8
put sp_inbox_bound 0 ib
put sp_extrap_bound 0 eb
put sp_onestep_bound 0 ob
ret
end

fn ts_structure_mutants to void
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
tb_add_term TS_REL ulong 1 long 1 ulong 4
put vr_dbits TS_REL vr_rel_bits TS_REL
rc = ts_score_rel TS_REL
ts_check ts_has PD0V_SCORE_DEGREE ulong 9
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
put vr_dbits TS_REL add get vr_dbits TS_REL uint 1
rc = ts_score_rel TS_REL
ts_check ts_has PD0V_SCORE_BITS_MISMATCH ulong 10
ret
end

fn ts_reference lv int to void
ok = eq sc_reference_fit uchar 2 uchar 1 uint 4 get sf_n_fit 0 TS_REFS 0
ts_check ok ulong 11
rc = ts_score_rel TS_REFS
ts_receipt K_REF TS_REFS
ts_ref_line lv
ret
end

fn ts_level lv int seed ulong to void
truth_init lv seed
truth_score_params
truth_score_episodes add seed ulong 500 uint 10 uint 10
nf = truth_fit_transitions add seed ulong 900 uint 30 uint 100 uint 4096
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
rc = ts_score_rel TS_REL
ts_receipt K_ORACLE TS_REL
if ne rc 0
if ne lv 6
ts_oracle_err lv seed rc
end
end
if eq lv 6
ts_check ts_l6_mask_ok ulong 1
ts_l6_line seed
ret
end
ts_check ts_ok_zero rc ulong 2
ts_m1
ts_receipt K_M1 TS_REL
ts_check ts_has PD0V_SCORE_CONSTANT_OFF ulong 3
ts_m2
ts_receipt K_M2 TS_REL
ts_check ts_m2_ok ulong 4
rc = ts_score_mem
ts_receipt K_M3 TS_EMPTY
ts_check ts_m3_ok 1 ulong 5
ts_m5
ts_structure_mutants
if eq seed ulong 1
ts_reference lv
end
ret
end

note L6: a latent-free relation (the L1 form) must be refused for the missing latent
fn ts_l6_latent_free to void
truth_init 6 ulong 1
truth_score_params
truth_score_episodes ulong 501 uint 10 uint 10
nf = truth_fit_transitions ulong 901 uint 30 uint 100 uint 4096
put tw_level 0 1
truth_oracle_rel TS_REL ulong 0
put tw_level 0 6
rc = ts_score_rel TS_REL
ts_receipt K_L6LF TS_REL
ts_check ts_has PD0V_SCORE_L6_LATENT_MISSING ulong 12
ret
end

fn ts_code rc int to int
if ne rc 0
ret rc
end
ret get lr_code 0
end

note NC-1 null world: no relation can be reached; the ladder stays below CANDIDATE on every seed
fn ts_nc1 to void
for i ulong 10
s = add ulong 101 i
b_init 2 s
bo_clear
put bo BO_NULL_WORLD long 1
put bo BO_NULL_SEED bitcast long s
rc = b_build
ts_state_receipt K_NC1 ts_code rc
ts_check lt get lr_state 0 LS_CANDIDATE ulong 13
end
ret
end

note NC-2 correlation pairs: every STEP record of episodes 0..7 (s1 before, change of s0)
fn ts_nc2_pairs n ulong to ulong
k = ulong 0
for i ulong n bound 65536
if eq get cr_kind i PD0_KIND_STEP
if lt get cr_ep i uint 8
rb = mul i ulong 4
put lc_cx k f64 get cr_bef add rb 1
put lc_cy k f64 sub get cr_aft rb get cr_bef rb
k = add k 1
end
end
end
ret k
end

fn ts_nc2_corr n ulong to void
k = ts_nc2_pairs n
m = new long 8 0
pl = new uchar 64 0
put m 0 long 1
put m 1 long 0
put m 2 long k
put m 3 long mul lad_pearson_xy k 0 1000000.0f64
put m 4 long mul lad_perm_p_xy k ulong 2000 ulong 5 6000000.0f64
put m 5 long 6
put m 6 long 2000
put m 7 long 5
w = vr_corr_write view m edit pl
b_append LEDG_CORR part pl 0 w w
ret
end

fn ts_nc2_ok to bool
if ge get lr_state 0 LS_CANDIDATE
ret false
end
c = get lr_code 0
if eq c PD0V_T2_CORR_TOO_WEAK
ret true
end
if eq c PD0V_T2_P_TOO_HIGH
ret true
end
if eq c PD0V_T8_STATE_SKIPPED
ret true
end
ret eq c PD0V_T3_FIT_ERROR_TOO_HIGH
end

note NC-2 shuffled outcomes of a real L1 run: candidate fit fails, nothing above CORRELATION
fn ts_nc2_one s ulong to void
pl = new uchar 4096 0
b_init 1 s
bo_clear
for e ulong 10
tb_random_episode ulong 100 get tw_k 0
end
n = get cr_n 0
ctrl_shuffle_outcomes n s
ctrl_rechain n
tb_ledger_restart get tb_episode 0
for i ulong n bound 65536
tb_rerecord i
end
tb_harness_tags
truth_oracle_rel TS_REL ulong get tw_n_hidden 0
put pl 0 REL_CANDIDATE
m = vr_rel_write TS_REL part pl 1 4095
ts_nc2_corr n
b_append LEDG_RELATION part pl 0 add m 1 add m 1
rc = lad_check
ts_state_receipt K_NC2 ts_code rc
ts_check ts_nc2_ok ulong 14
ret
end

fn main to int
pd0_receipt_dir TS_DIR
for li ulong 4
lv = int 1
if eq li ulong 1
lv = int 2
end
if eq li ulong 2
lv = int 4
end
if eq li ulong 3
lv = int 6
end
for s ulong 3
ts_level lv add s 1
end
end
ts_l6_latent_free
ts_nc1
for s ulong 5
ts_nc2_one add s 1
end
ob = new uchar 128 0
p = pd0_buf_str edit ob ulong 0 ulong 128 TS_SUM1
p = pd0_buf_u64 edit ob p ulong 128 get ts_checks 0
p = pd0_buf_str edit ob p ulong 128 TS_SUM2
p = pd0_buf_u64 edit ob p ulong 128 get ts_fails 0
p = pd0_buf_str edit ob p ulong 128 TS_SUM3
pd0_put_bytes 1 view ob p
if eq get ts_fails 0 ulong 0
ret 0
end
ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/physics0/verify/test_pd0_ladder.om: the ladder checker (C test_pd0_ladder.c). An honest
note oracle-shaped bundle reaches PROVISIONAL_LAW; every dishonest mutant stops for the recorded reason.
note Same scenarios, same checks, same order and the same stdout; receipts as the C test wrote them.

global tl_checks ulong 1
global tl_fails ulong 1
global tl_ln ulong 1

text TL_DIR "build/tests-physics0-verify/receipts"
text TL_FAIL "FAIL test_pd0_ladder.om check "
text TL_CLAIM "claim: "
text TL_SUM1 "test_pd0_ladder: "
text TL_SUM2 " checks, "
text TL_SUM3 " failed\n"
text TL_RFAIL "receipt write failed for "
text TL_ALWAYS "This is always true. "
text K_HONEST "ladder-honest"
text K_SKIP "ladder-skip-state"
text K_FAKE "ladder-fake-corr"
text K_NORIVAL "ladder-no-rival"
text K_EPS "ladder-eps-above-bound"
text K_REUSE "ladder-reused-schedule"
text K_NOPRE "ladder-trial-not-prereg"
text K_REPFIT "ladder-rep-in-fit"
text K_STREAM "ladder-stream-reuse"
text K_ORIGIN "ladder-origin-imbalance"
text K_WRONGK "ladder-wrong-k"
text K_STOPPRE "ladder-stop-prereg"
text K_STOPTR "ladder-stop-trials"
text K_END "ladder-episode-end"
text K_QUIET "ladder-quiet-noisy-trials"
text K_VREP "ladder-void-rep"
text K_VBAT "ladder-void-batch"
text K_VTRIAL "ladder-void-trial"
text K_DEMOTE "ladder-demotion"

const TL_LAW_SLOT ulong 2
const TL_LAW_REL ulong 74
const TL_FAB_SLOT ulong 3
const TL_FAB_REL ulong 76

fn tl_check cond bool id ulong to void
put tl_checks 0 add get tl_checks 0 ulong 1
b = new uchar 96 0
if not cond
put tl_fails 0 add get tl_fails 0 ulong 1
p = pd0_buf_str edit b ulong 0 ulong 96 TL_FAIL
p = pd0_buf_u64 edit b p ulong 96 id
p = pd0_buf_ch edit b p ulong 96 uchar 10
pd0_put_bytes 2 view b p
end
ret
end

note C CHECK_CODE: the call result, the report code or the first stall code is the wanted one
fn tl_check_code rc int want int id ulong to void
ok = false
if eq rc want
ok = true
end
if eq get lr_code 0 want
ok = true
end
if eq get lr_stall_code 0 want
ok = true
end
tl_check ok id
ret
end

fn tl_receipt kind view uchar * code int to void
h = new uchar 32 0
vledg_sha256 edit h
empty = new uchar 1 0
b = new uchar 128 0
if ne pd0_receipt_write kind view h code part empty 0 0 0
p = pd0_buf_str edit b ulong 0 ulong 128 TL_RFAIL
p = pd0_buf_str edit b p ulong 128 kind
p = pd0_buf_ch edit b p ulong 128 uchar 10
pd0_put_bytes 2 view b p
end
ret
end

note C run(): build the bundle with the options in bo, emit the law, write the receipt
fn tl_run level int seed ulong kind view uchar * law edit uchar 8192 to int
b_init level seed
rc = b_build
put tl_ln 0 lad_emit_law edit law
code = rc
if eq rc 0
code = get lr_code 0
end
tl_receipt kind code
ret rc
end

fn tl_verify law view uchar 8192 n ulong to int
ret lad_verify_law part law 0 n
end

fn tl_reparse law view uchar 8192 n ulong to int
ret vr_law_parse part law 0 n TL_LAW_SLOT TL_LAW_REL
end

fn tl_rewrite_verify law2 edit uchar 8192 to int
n = vr_law_write TL_LAW_SLOT edit law2
ret lad_verify_law part law2 0 n
end

fn tl_state_is s int to bool
ret eq get lr_state 0 s
end

fn tl_honest_ok rc int to bool
if ne rc 0
ret false
end
ret tl_state_is LS_REPLICATED
end

fn tl_counts_ok to bool
if ne get lr_n_refut 0 uint 0
ret false
end
if ne get lr_p 0 uint 35
ret false
end
if ne get lr_f 0 uint 0
ret false
end
ret eq get lr_conf_ppm 0 lad_conf_ppm uint 35 uint 0
end

fn tl_parsed_honest rc int to bool
if ne rc 0
ret false
end
if ne get vl_state TL_LAW_SLOT PD0_LAW_PROVISIONAL
ret false
end
if ne get vl_n_exp TL_LAW_SLOT uint 8
ret false
end
ret eq get vr_nref TL_LAW_REL ushort 0
end

fn tl_print_claim to void
b = new uchar 640 0
p = pd0_buf_str edit b ulong 0 ulong 640 TL_CLAIM
cl = ulong get vl_claim_len TL_LAW_SLOT
cb = mul TL_LAW_SLOT VL_MAX_CLAIM
for k ulong cl bound 512
p = pd0_buf_ch edit b p ulong 640 get vl_claim add cb k
end
p = pd0_buf_ch edit b p ulong 640 uchar 10
pd0_put_bytes 1 view b p
ret
end

note T8 tampering on the honest law: each mutation of a fresh parse is refused for its own reason
fn tl_tamper law view uchar 8192 ln ulong to void
law2 = new uchar 8192 0
rc = tl_reparse law ln
put vl_conf_ppm TL_LAW_SLOT add get vl_conf_ppm TL_LAW_SLOT uint 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_CONFIDENCE_MISMATCH ulong 5
rc = tl_reparse law ln
cb = mul TL_LAW_SLOT VL_MAX_CLAIM
for k ulong 21
put vl_claim add cb k get TL_ALWAYS k
end
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_CLAIM_FORBIDDEN_WORD ulong 6
rc = tl_reparse law ln
put vl_claim cb uchar 66
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_CLAIM_TEXT_MISMATCH ulong 7
rc = tl_reparse law ln
put vl_n_exp TL_LAW_SLOT sub get vl_n_exp TL_LAW_SLOT uint 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_EXPERIMENT_MISSING ulong 8
tl_tamper2 law ln
ret
end

fn tl_tamper2 law view uchar 8192 ln ulong to void
law2 = new uchar 8192 0
rc = tl_reparse law ln
hb = mul TL_LAW_SLOT PD0_HASH
put vl_chain_root hb xor get vl_chain_root hb uchar 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_CHAIN_ROOT_MISMATCH ulong 9
rc = tl_reparse law ln
ti = vr_term_idx TL_LAW_REL ulong 1 ulong 0
put vr_coef ti add get vr_coef ti long 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_RELATION_MISMATCH ulong 10
rc = tl_reparse law ln
put vl_dom_nobs_cnt TL_LAW_SLOT add get vl_dom_nobs_cnt TL_LAW_SLOT ulong 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_DOMAIN_MISMATCH ulong 11
rc = tl_reparse law ln
put vl_n_exc TL_LAW_SLOT uint 1
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_EXCEPTIONS_MISMATCH ulong 12
for i ulong ln bound 8192
put law2 i get law i
end
put law2 sub ln 1 xor get law2 sub ln 1 uchar 1
tl_check eq tl_verify view law2 ln PD0V_LAW_ID_MISMATCH ulong 13
ret
end

fn tl_honest level int seed ulong first int to void
law = new uchar 8192 0
bo_clear
rc = tl_run level seed K_HONEST edit law
ln = get tl_ln 0
tl_check tl_honest_ok rc ulong 1
tl_check tl_counts_ok ulong 2
vok = false
if gt ln ulong 0
vok = eq tl_verify view law ln PD0V_OK
end
tl_check vok ulong 3
prc = tl_reparse view law ln
tl_check tl_parsed_honest prc ulong 4
if ne first 0
tl_print_claim
end
tl_tamper view law ln
ret
end

note one dishonest mutant: option opt set, the run stops for want (state st when st >= 0)
fn tl_mutant opt ulong kind view uchar * want int st int id ulong to void
law = new uchar 8192 0
bo_clear
put bo opt long 1
rc = tl_run 1 ulong 1 kind edit law
tl_check_code rc want id
if ge st 0
tl_check tl_state_is st add id ulong 1
end
ret
end

fn tl_wrongk_ok rc int to bool
if and ne rc 0 ne rc PD0V_T8_STATE_SKIPPED
ret false
end
if ne get lr_n_refut 0 uint 1
ret false
end
if eq tl_state_is LS_CANDIDATE false
ret false
end
if ne get vl_n_exc LR_DOM_SLOT uint 1
ret false
end
if lt get lr_f 0 uint 1
ret false
end
ret gt get lr_last_nrmse 0 long 20000
end

note wrong constant: the committed predictions miss; the hypothesis is refuted, not promoted
fn tl_wrong_k to void
law = new uchar 8192 0
bo_clear
put bo BO_WRONG_K long 1
rc = tl_run 1 ulong 1 K_WRONGK edit law
ln = get tl_ln 0
tl_check tl_wrongk_ok rc ulong 40
tl_check eq tl_verify view law ln 0 ulong 41
prc = tl_reparse view law ln
ok = false
if eq prc 0
ok = ne get vl_state TL_LAW_SLOT PD0_LAW_PROVISIONAL
end
tl_check ok ulong 42
ret
end

fn tl_code_state rc int st int code int to bool
if ne rc 0
ret false
end
if eq tl_state_is st false
ret false
end
ret eq get lr_code 0 code
end

note partial ladders: a PROVISIONAL_LAW record is refused as a skipped state
fn tl_partial to void
law = new uchar 8192 0
law2 = new uchar 8192 0
bo_clear
put bo BO_STOP_PRE long 1
rc = tl_run 1 ulong 1 K_STOPPRE edit law
ln = get tl_ln 0
tl_check tl_code_state rc LS_PREDICTED PD0V_T6_TRIAL_MISSING ulong 50
prc = tl_reparse view law ln
put vl_state TL_LAW_SLOT PD0_LAW_PROVISIONAL
tl_check eq tl_rewrite_verify edit law2 PD0V_T8_STATE_SKIPPED ulong 51
bo_clear
put bo BO_STOP_TRIALS long 1
rc = tl_run 1 ulong 1 K_STOPTR edit law
tl_check tl_code_state rc LS_INTERVENED PD0V_T7_TOO_FEW_BATCHES ulong 52
ret
end

note fabricated law with no evidence at all (M4)
fn tl_m4 to void
law2 = new uchar 8192 0
vledg_reset
lad_params_default uchar 2 uchar 1
rc = lad_check
ok = false
if eq rc 0
ok = tl_state_is LS_START
end
tl_check ok ulong 60
vr_clear TL_FAB_REL
vl_clear TL_FAB_SLOT TL_FAB_REL
put vl_state TL_FAB_SLOT PD0_LAW_PROVISIONAL
put vr_nvars TL_FAB_REL uchar 2
put vr_nch TL_FAB_REL uchar 1
put vl_dom_nobs TL_FAB_SLOT uchar 2
put vl_dom_nch TL_FAB_SLOT uchar 1
n = vr_law_write TL_FAB_SLOT edit law2
tl_check eq lad_verify_law part law2 0 n PD0V_T8_STATE_SKIPPED ulong 61
ret
end

fn tl_clean rc int st int to bool
if ne rc 0
ret false
end
if lt get lr_state 0 st
ret false
end
ret eq get lr_n_refut 0 uint 0
end

fn tl_rev6 to void
law = new uchar 8192 0
bo_clear
put bo BO_END_LAST long 1
rc = tl_run 1 ulong 1 K_END edit law
ok = false
if tl_clean rc LS_REPLICATED
ok = tl_state_is LS_REPLICATED
end
tl_check ok ulong 70
bo_clear
put bo BO_QUIET long 1
put bo BO_OBS_NOISE long 20000
rc = tl_run 1 ulong 1 K_QUIET edit law
tl_check tl_clean rc LS_INTERVENED ulong 71
pred = new long 160 0
obs = new long 160 0
sd = new long 8 0
put pred 0 long 1000
put pred 2 long 2000
put pred 4 long 3000
put obs 0 long 11000
put obs 2 long 12000
put obs 4 long 13000
tl_check gt lad_nrmse_micro view pred view obs ulong 3 ulong 2 long 10000000 ulong 72
put sd 0 long 1000000
put sd 1 long 1000000
tl_check eq lad_nrmse_pooled_micro view pred view obs ulong 3 ulong 2 view sd long 10000 ulong 73
put sd 0 long 0
put sd 1 long 0
tl_check eq lad_nrmse_pooled_micro view pred view obs ulong 3 ulong 2 view sd long 10000 ulong 74
ret
end

fn tl_void_ok rc int nv uint nb uint to bool
if ne rc 0
ret false
end
if eq tl_state_is LS_REPLICATED false
ret false
end
if ne get lr_n_void_ep 0 nv
ret false
end
if ne get lr_p 0 uint 35
ret false
end
if ne get lr_f 0 uint 0
ret false
end
if eq nb uint 2
ret true
end
ret eq get lr_n_void_bat 0 nb
end

note spec rev 7: void TRIAL/REP episodes (OUT_OF_BOUNDS before the horizon) never count toward p or f
fn tl_voids to void
law = new uchar 8192 0
bo_clear
put bo BO_VOID_REP long 1
rc = tl_run 1 ulong 1 K_VREP edit law
tl_check tl_void_ok rc uint 1 uint 0 ulong 80
bo_clear
put bo BO_VOID_REP4 long 1
rc = tl_run 1 ulong 1 K_VBAT edit law
tl_check tl_void_ok rc uint 4 uint 1 ulong 81
bo_clear
put bo BO_VOID_TRIAL long 1
rc = tl_run 1 ulong 1 K_VTRIAL edit law
ok = false
if tl_void_ok rc uint 1 uint 2
ok = eq get vl_n_exp LR_DOM_SLOT uint 8
end
tl_check ok ulong 82
ret
end

fn tl_demoted_ok rc int to bool
if ne rc 0
ret false
end
if eq get lr_demoted 0 0
ret false
end
if eq tl_state_is LS_HYPOTHESIS false
ret false
end
ret eq get lr_n_refut 0 uint 1
end

note demotion: a later contradicting replication pulls the law back to HYPOTHESIS; the honest law
note (built first here, from its own run, as C builds it after) is then refused as demoted
fn tl_demotion to void
law = new uchar 8192 0
law2 = new uchar 8192 0
bo_clear
b_init 1 ulong 1
rh = b_build
n2 = lad_emit_law edit law2
bo_clear
put bo BO_DEMOTE long 1
rc = tl_run 1 ulong 1 K_DEMOTE edit law
tl_check tl_demoted_ok rc ulong 90
tl_check eq tl_verify view law2 n2 PD0V_LAW_DEMOTED ulong 91
ret
end

fn tl_mutants to void
tl_mutant BO_SKIP_CORR K_SKIP PD0V_T8_STATE_SKIPPED LS_OBSERVATION ulong 20
tl_mutant BO_FAKE_CORR K_FAKE PD0V_T2_CORR_MISMATCH LS_OBSERVATION ulong 22
tl_mutant BO_NO_RIVAL K_NORIVAL PD0V_T4_NO_RIVAL LS_CANDIDATE ulong 24
tl_mutant BO_EPS_ABOVE K_EPS PD0V_T4_EPS_ABOVE_BOUND LS_CANDIDATE ulong 26
tl_mutant BO_REUSE_SCHED K_REUSE PD0V_T5_SCHEDULE_REUSED -1 ulong 28
tl_mutant BO_TRIAL_NO_PRE K_NOPRE PD0V_T6_TRIAL_NOT_PREREGISTERED -1 ulong 29
tl_mutant BO_REP_BEFORE K_REPFIT PD0V_REP_INFLUENCED_FIT -1 ulong 30
tl_mutant BO_BATCH_REUSE K_STREAM PD0V_T7_STREAM_REUSED -1 ulong 31
tl_mutant BO_ALL_PLANNER K_ORIGIN PD0V_T7_ORIGIN_IMBALANCE -1 ulong 32
ret
end

fn main to int
pd0_receipt_dir TL_DIR
for li ulong 3
lv = int 1
if eq li ulong 1
lv = 2
end
if eq li ulong 2
lv = 4
end
for s ulong 3
first = int 0
if and eq li ulong 0 eq s ulong 0
first = 1
end
tl_honest lv add s 1 first
end
end
tl_mutants
tl_wrong_k
tl_partial
tl_m4
tl_rev6
tl_voids
tl_demotion
ob = new uchar 128 0
p = pd0_buf_str edit ob ulong 0 ulong 128 TL_SUM1
p = pd0_buf_u64 edit ob p ulong 128 get tl_checks 0
p = pd0_buf_str edit ob p ulong 128 TL_SUM2
p = pd0_buf_u64 edit ob p ulong 128 get tl_fails 0
p = pd0_buf_str edit ob p ulong 128 TL_SUM3
pd0_put_bytes 1 view ob p
if eq get tl_fails 0 ulong 0
ret 0
end
ret 1
end

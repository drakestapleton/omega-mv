fn pls_flush to void
  n = get pls_on 0
  if gt n 0
    k = write 1 pls_ob 0 n
  end
  put pls_on 0 0
end

fn pls_c c ulong to void
  n = get pls_on 0
  if ge n 65000
    pls_flush
    n = 0
  end
  put pls_ob n uchar c
  put pls_on 0 add n 1
end

fn pls_t s view uchar * to void
  n = len s
  for i ulong n bound 8192
    pls_c ulong get s i
  end
end

fn pls_u v ulong to void
  k = ulong 0
  x = v
  while gt x 9 bound 24
    put pls_d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  put pls_d k uchar add 48 x
  k = add k 1
  while gt k 0 bound 24
    k = sub k 1
    pls_c ulong get pls_d k
  end
end

fn pls_i v long to void
  if lt v 0
    pls_c 45
    pls_u sub ulong 0 bitcast ulong v
  else
    pls_u ulong v
  end
end

note lowercase hex without leading zeros (printf %x)
fn pls_x v ulong to void
  k = ulong 0
  x = v
  while gt x 15 bound 24
    put pls_d k get pls_hexd and x 15
    x = shr x 4
    k = add k 1
  end
  put pls_d k get pls_hexd x
  k = add k 1
  while gt k 0 bound 24
    k = sub k 1
    pls_c ulong get pls_d k
  end
end

note 16 hex digits (printf %016llx)
fn pls_x16 v ulong to void
  for i ulong 16
    pls_c ulong get pls_hexd and shr v mul sub 15 i 4 15
  end
end

fn pls_hb b ulong to void
  pls_c ulong get pls_hexd shr b 4
  pls_c ulong get pls_hexd and b 15
end

fn pls_hex s view uchar * n ulong to void
  for i ulong n bound 8192
    pls_hb ulong get s i
  end
end

fn pls_ln ln ulong to void
  pls_c 76
  pls_u ln
end

fn pls_nl to void
  pls_c 10
end

fn pls_arg i ulong to long
  ret get pls_a i
end

fn pls_argu i ulong to ulong
  ret bitcast ulong get pls_a i
end

fn pls_rnd to ulong
  s = add mul get pls_rs 0 ulong 6364136223846793005 ulong 1442695040888963407
  put pls_rs 0 s
  ret shr s 11
end

note C rnds(m): rnd() % (2m + 1) - m
fn pls_rnds m long to long
  r = rem pls_rnd add mul ulong 2 bitcast ulong m ulong 1
  ret sub bitcast long r m
end

fn pls_hexval c ulong to ulong
  if ge c 97
    ret sub c 87
  end
  ret sub c 48
end

fn pls_parse s ulong e ulong to void
  for i ulong 64
    put pls_a i long 0
  end
  p = add s 1
  n = ulong 0
  while lt n 64 bound 65
    while and lt p e eq get pls_in p 32 bound 70000
      p = add p 1
    end
    if ge p e
      break
    end
    minus = false
    if eq get pls_in p 45
      minus = true
      p = add p 1
    end
    v = ulong 0
    while lt p e bound 70000
      d = ulong get pls_in p
      if or lt d 48 gt d 57
        break
      end
      v = add mul v 10 sub d 48
      p = add p 1
    end
    if minus
      v = sub ulong 0 v
    end
    put pls_a n bitcast long v
    n = add n 1
    while and lt p e ne get pls_in p 32 bound 70000
      p = add p 1
    end
  end
  put pls_na 0 n
end

fn pls_hexload s ulong e ulong to void
  p = add s 1
  while and lt p e eq get pls_in p 32 bound 70000
    p = add p 1
  end
  n = ulong 0
  while and lt add p 1 e lt n 8192 bound 8193
    put pls_h n uchar add mul pls_hexval ulong get pls_in p 16 pls_hexval ulong get pls_in add p 1
    n = add n 1
    p = add p 2
  end
  put pls_hn 0 n
end

note ---- ladder ----

fn pls_report ln ulong rc int to void
  pls_ln ln
  pls_t pls_t_rep
  pls_i long rc
  pls_t pls_t_st
  pls_i long get lr_state 0
  pls_t pls_t_code
  pls_i long get lr_code 0
  pls_t pls_t_tr
  pls_i long get lr_trans 0
  pls_t pls_t_dem
  pls_i long get lr_demoted 0
  pls_t pls_t_stall
  pls_i long get lr_stall_code 0
  pls_t pls_t_nref
  pls_u ulong get lr_n_refut 0
  pls_t pls_t_p
  pls_u ulong get lr_p 0
  pls_t pls_t_f
  pls_u ulong get lr_f 0
  pls_t pls_t_conf
  pls_u ulong get lr_conf_ppm 0
  pls_t pls_t_hc
  pls_i long get lr_have_cand 0
  pls_t pls_t_ch
  for k ulong 32
    pls_hb ulong get lr_cand_hash k
  end
  pls_t pls_t_eps
  pls_i get lr_eps 0
  pls_t pls_t_root
  for k ulong 32
    pls_hb ulong get lr_chain_root k
  end
  pls_t pls_t_ne
  pls_u get lr_n_entries 0
  pls_t pls_t_nr
  pls_u get lr_n_records 0
  pls_t pls_t_nrm
  pls_i get lr_last_nrmse 0
  pls_t pls_t_vep
  pls_u ulong get lr_n_void_ep 0
  pls_t pls_t_vbat
  pls_u ulong get lr_n_void_bat 0
  pls_t pls_t_r
  pls_x16 bitcast ulong get lr_last_r 0
  pls_t pls_t_pp
  pls_x16 bitcast ulong get lr_last_p 0
  pls_nl
  lw = new uchar 8192 0
  n = lad_emit_law edit lw
  for j ulong n bound 8192
    put pls_law j get lw j
  end
  put pls_lawn 0 n
  pls_ln ln
  pls_t pls_t_law
  pls_u n
  pls_c 32
  pls_hex lw n
  pls_nl
  cl = new uchar 1024 0
  cn = lad_claim_text edit cl
  pls_ln ln
  pls_t pls_t_claim
  pls_u cn
  pls_c 32
  m = cn
  if gt m 1024
    m = 1024
  end
  for k ulong m bound 1024
    pls_c ulong get cl k
  end
  pls_nl
end

fn pls_ledger ln ulong rc int to void
  h = new uchar 32 0
  vledg_sha256 edit h
  pls_ln ln
  pls_t pls_t_ledger
  pls_i long rc
  pls_t pls_t_len
  pls_u get vledg_len 0
  pls_t pls_t_sha
  pls_hex h 32
  pls_nl
end

fn pls_build ln ulong to void
  b_init int pls_arg 0 pls_argu 1
  bo_clear
  na = get pls_na 0
  i = ulong 2
  while lt add i 1 na bound 64
    k = pls_argu i
    if lt k 21
      put bo k pls_arg add i 1
    end
    i = add i 2
  end
  rc = b_build
  pls_ledger ln rc
  pls_report ln rc
end

fn pls_param to void
  k = pls_argu 0
  v = pls_arg 1
  if eq k 0
    put lp_n_obs 0 uchar v
  end
  if eq k 1
    put lp_n_ch 0 uchar v
  end
  if eq k 2
    put lp_noisy 0 uchar v
  end
  if eq k 3
    put lp_cmin 0 v
  end
  if eq k 4
    put lp_cmax 0 v
  end
  if eq k 5
    put lp_rmin 0 v
  end
  if eq k 6
    put lp_rmax 0 v
  end
  if eq k 7
    put lp_eplen 0 uint v
  end
  if eq k 8
    put lp_dt 0 v
  end
  if eq k 9
    put lp_size_bound 0 uint v
  end
  if eq k 10
    put lp_eps_bound 0 v
  end
  if eq k 11
    put lp_min_t1_rec 0 uint v
  end
  if eq k 12
    put lp_min_t1_ep 0 uint v
  end
  if eq k 13
    put lp_min_prereg 0 uint v
  end
  if eq k 14
    put lp_min_bat 0 uint v
  end
  if eq k 15
    put lp_min_bat_ep 0 uint v
  end
  if eq k 16
    put lp_roll_steps 0 uint v
  end
end

fn pls_params ln ulong to void
  lad_params_default uchar pls_arg 0 uchar pls_arg 1
  pls_ln ln
  pls_t pls_t_params
  pls_u ulong get lp_n_obs 0
  pls_t pls_t_nc
  pls_u ulong get lp_n_ch 0
  pls_t pls_t_noisy
  pls_u ulong get lp_noisy 0
  pls_t pls_t_c
  for c ulong 4
    if gt c 0
      pls_c 44
    end
    pls_i get lp_cmin c
    pls_c 58
    pls_i get lp_cmax c
  end
  pls_t pls_t_rr
  pls_i get lp_rmin 0
  pls_c 58
  pls_i get lp_rmax 0
  pls_t pls_t_el
  pls_u ulong get lp_eplen 0
  pls_t pls_t_dt
  pls_i get lp_dt 0
  pls_t pls_t_sb
  pls_u ulong get lp_size_bound 0
  pls_t pls_t_eb
  pls_i get lp_eps_bound 0
  pls_t pls_t_t1
  pls_u ulong get lp_min_t1_rec 0
  pls_c 44
  pls_u ulong get lp_min_t1_ep 0
  pls_t pls_t_pre
  pls_u ulong get lp_min_prereg 0
  pls_t pls_t_bat
  pls_u ulong get lp_min_bat 0
  pls_c 44
  pls_u ulong get lp_min_bat_ep 0
  pls_t pls_t_roll
  pls_u ulong get lp_roll_steps 0
  pls_nl
end

fn pls_tamper_edit k ulong to void
  s = PLS_LAW
  if eq k 0
    put vl_conf_ppm s add get vl_conf_ppm s uint 1
  end
  cb = mul s VL_MAX_CLAIM
  if eq k 1
    for j ulong 21
      put vl_claim add cb j get pls_always j
    end
  end
  if eq k 2
    put vl_claim cb uchar 66
  end
  if eq k 3
    put vl_n_exp s sub get vl_n_exp s uint 1
  end
  if eq k 4
    hb = mul s PD0_HASH
    put vl_chain_root hb xor get vl_chain_root hb uchar 1
  end
  if eq k 5
    ti = vr_term_idx PLS_LAW_REL ulong 1 ulong 0
    put vr_coef ti add get vr_coef ti long 1
  end
  if eq k 6
    put vl_dom_nobs_cnt s add get vl_dom_nobs_cnt s ulong 1
  end
  if eq k 7
    put vl_n_exc s uint 1
  end
  if eq k 8
    put vl_state s PD0_LAW_PROVISIONAL
  end
  if eq k 12
    put vl_state s PD0_LAW_HYPOTHESIS
  end
  if eq k 13
    put vl_state s PD0_LAW_REFUTED
  end
  if eq k 14
    put vl_state s PD0_LAW_REJECTED
  end
  if eq k 15
    put vr_nref PLS_LAW_REL add get vr_nref PLS_LAW_REL ushort 1
  end
end

fn pls_tamper ln ulong to void
  k = pls_argu 0
  ln0 = get pls_lawn 0
  lw = new uchar 8192 0
  l2 = new uchar 8192 0
  for j ulong ln0 bound 8192
    put lw j get pls_law j
  end
  n = ulong 0
  prc = int 0
  if or eq k 10 eq k 11
    for j ulong ln0 bound 8192
      put l2 j get lw j
    end
    n = ln0
    if and eq k 10 gt n 0
      put l2 sub n 1 xor get l2 sub n 1 uchar 1
    end
    if and eq k 11 gt n 0
      n = sub n 1
    end
  else
    prc = vr_law_parse part lw 0 ln0 PLS_LAW PLS_LAW_REL
    if eq prc 0
      pls_tamper_edit k
      n = vr_law_write PLS_LAW edit l2
    end
  end
  v = lad_verify_law part l2 0 n
  pls_ln ln
  pls_t pls_t_tamper
  pls_i bitcast long k
  pls_t pls_t_prc
  pls_i long prc
  pls_t pls_t_n
  pls_u n
  pls_t pls_t_v
  pls_i long v
  pls_nl
end

fn pls_verify_saved ln ulong to void
  sn = get pls_savn 0
  sv = new uchar 8192 0
  for j ulong sn bound 8192
    put sv j get pls_sav j
  end
  v = lad_verify_law part sv 0 sn
  pls_ln ln
  pls_t pls_t_verify
  pls_i long v
  pls_nl
end

fn pls_fab ln ulong to void
  vr_clear PLS_FAB_REL
  vl_clear PLS_FAB PLS_FAB_REL
  put vl_state PLS_FAB PD0_LAW_PROVISIONAL
  put vr_nvars PLS_FAB_REL uchar 2
  put vr_nch PLS_FAB_REL uchar 1
  put vl_dom_nobs PLS_FAB uchar 2
  put vl_dom_nch PLS_FAB uchar 1
  l2 = new uchar 8192 0
  n = vr_law_write PLS_FAB edit l2
  v = lad_verify_law part l2 0 n
  pls_ln ln
  pls_t pls_t_fab
  pls_u n
  pls_t pls_t_v
  pls_i long v
  pls_nl
end

fn pls_stats ln ulong to void
  n = pls_argu 0
  put pls_rs 0 pls_argu 1
  mode = pls_arg 2
  for i ulong n bound 65536
    x = pls_rnds long 2000000
    y = pls_rnds long 2000000
    if eq mode 1
      y = add mul long 3 x pls_rnds long 1000
    end
    if eq mode 2
      x = long 5
    end
    if eq mode 3
      y = long -7
    end
    if eq mode 4
      y = sub long 0 x
    end
    put lc_cx i f64 x
    put lc_cy i f64 y
  end
  r = lad_pearson_xy n 0
  p = 0.0f64
  if gt n 0
    p = lad_perm_p_xy n pls_argu 3 pls_argu 4
  end
  pls_ln ln
  pls_t pls_t_stats
  pls_x16 bitcast ulong r
  pls_t pls_t_p
  pls_x16 bitcast ulong p
  pls_nl
end

fn pls_nrmse ln ulong to void
  n = pls_argu 0
  no = pls_argu 1
  put pls_rs 0 pls_argu 2
  sdm = pls_arg 3
  pr = new long 160 0
  ob = new long 160 0
  sd = new long 8 0
  nm = mul n no
  for i ulong nm bound 160
    o = long 7
    if eq pls_arg 5 0
      o = pls_rnds long 3000000
    end
    put ob i o
    put pr i add o pls_rnds pls_arg 4
  end
  for j ulong 8
    s = long 0
    if eq sdm 1
      s = add long 1 bitcast long rem pls_rnd ulong 2000000
    end
    if eq sdm 2
      if eq and j 1 0
        s = long 500000
      end
    end
    if eq sdm 3
      s = long 1
    end
    put sd j s
  end
  a = lad_nrmse_micro view pr view ob n no
  b = lad_nrmse_pooled_micro view pr view ob n no view sd
  pls_ln ln
  pls_t pls_t_nrmse
  pls_i a
  pls_t pls_t_b
  pls_i b
  pls_nl
end

fn pls_episode ln ulong to void
  ep = get tb_episode 0
  tb_random_episode pls_argu 0 get tw_k 0
  pls_ln ln
  pls_t pls_t_ep
  pls_u ulong ep
  pls_t pls_t_len
  pls_u get vledg_len 0
  pls_nl
end

fn pls_append ln ulong to void
  hn = get pls_hn 0
  hb = new uchar 8192 0
  for j ulong hn bound 8192
    put hb j get pls_h j
  end
  b_append uchar pls_arg 0 part hb 0 hn hn
  pls_ln ln
  pls_t pls_t_app
  pls_u get vledg_len 0
  pls_nl
end

fn pls_name ln ulong to void
  b = new uchar 32 0
  p = lad_buf_state_name edit b ulong 0 ulong 32 int pls_arg 0
  pls_ln ln
  pls_t pls_t_name
  pls_hex_buf b p
  pls_nl
end

fn pls_hex_buf b view uchar 32 p ulong to void
  for k ulong p bound 32
    pls_c ulong get b k
  end
end

note ---- hand-made entries ----

note pairs (s<va> before the step, change of s<vb>) over OK / EPISODE_END steps of episodes below epmax
fn pls_corr_ok i ulong epmax uint to int
  if ne get cr_kind i PD0_KIND_STEP
    ret 0
  end
  st = get cr_st i
  if and ne st PD0_OK ne st PD0_EPISODE_END
    ret 0
  end
  if ge get cr_ep i epmax
    ret 0
  end
  ret 1
end

fn pls_corr_pairs va ulong vb ulong epmax uint to ulong
  n = ulong 0
  nr = get cr_n 0
  for i ulong nr bound 65536
    if ne pls_corr_ok i epmax 0
      rb = mul i ulong 4
      xv = get cr_bef add rb va
      put lc_cx n f64 xv
      ya = get cr_aft add rb vb
      yb = get cr_bef add rb vb
      d = sub ya yb
      put lc_cy n f64 d
      n = add n 1
    end
  end
  ret n
end

fn pls_corr ln ulong to void
  va = pls_argu 0
  vb = pls_argu 1
  nsh = pls_argu 2
  seed = pls_argu 3
  npairs = pls_argu 4
  fake = pls_arg 5
  n = ulong 0
  if ne fake 3
    n = pls_corr_pairs va vb uint pls_arg 6
  end
  m = new long 8 0
  put m 0 bitcast long va
  put m 1 bitcast long vb
  put m 2 bitcast long n
  if ne fake 3
    r = lad_pearson_xy n 0
    p = mul lad_perm_p_xy n nsh seed f64 npairs
    put m 3 long mul r 1000000.0f64
    put m 4 long mul p 1000000.0f64
  end
  put m 5 bitcast long npairs
  put m 6 bitcast long nsh
  put m 7 bitcast long seed
  if eq fake 1
    put m 3 long 900000
    put m 4 long 100
  end
  if eq fake 2
    put m 2 add bitcast long n long 1
  end
  if eq fake 4
    put m 3 add get m 3 long 1500
  end
  if eq fake 5
    put m 4 long 15000
  end
  pl = new uchar 64 0
  k = vr_corr_write view m edit pl
  b_append LEDG_CORR part pl 0 k k
  pls_ln ln
  pls_t pls_t_corr
  pls_u n
  pls_t pls_t_r
  pls_i get m 3
  pls_t pls_t_p
  pls_i get m 4
  pls_t pls_t_len
  pls_u get vledg_len 0
  pls_nl
end

fn pls_scale_k slot ulong to void
  ex = new uchar 16 0
  put ex 0 uchar 1
  ctrl_mut_scale_coef slot uchar 1 view ex pls_arg 2 pls_arg 3
end

fn pls_rel ln ulong to void
  mode = pls_arg 1
  slot = TB_CAND_SLOT
  if eq mode 2
    slot = TB_NULL_SLOT
    vr_clear slot
    put vr_nvars slot uchar 2
    put vr_nch slot uchar 1
  else
    truth_oracle_rel slot ulong get tw_n_hidden 0
    if eq mode 3
      pls_scale_k slot
    end
    if eq mode 1
      tb_add_term slot ulong 1 long 1 ulong 4
      put vr_dbits slot vr_rel_bits slot
    end
  end
  tb_rel_entry slot uchar pls_arg 0
  pls_ln ln
  pls_t pls_t_relx
  pls_u get vledg_len 0
  pls_nl
end

fn pls_hs_copy dst edit uchar * off ulong slot ulong to void
  if lt slot 8
    for k ulong 32
      put dst add off k get pls_hs add mul slot 32 k
    end
  end
end

fn pls_fals_append cand view uchar 32 nriv ulong rivs view uchar 256 m view long 2 to void
  pl = new uchar 512 0
  n = vr_fals_write cand uchar nriv view rivs view m edit pl
  b_append LEDG_FALSIFIER part pl 0 n n
end

fn pls_fals ln ulong to void
  cand = new uchar 32 0
  rivs = new uchar 256 0
  m = new long 2 0
  nriv = pls_argu 0
  put m 0 pls_arg 1
  put m 1 pls_arg 2
  pls_hs_copy edit cand ulong 0 pls_argu 3
  for i ulong nriv bound 8
    pls_hs_copy edit rivs mul i 32 pls_argu add 4 i
  end
  pls_fals_append view cand nriv view rivs view m
  pls_ln ln
  pls_t pls_t_fals
  pls_u get vledg_len 0
  pls_nl
end

fn pls_prereg ln ulong to void
  reset = new long 2 0
  chs = new uchar 100 0
  vals = new long 100 0
  xb = new uchar 16384 0
  b_random_schedule edit reset edit chs edit vals ulong 20
  put pls_sreset 0 get reset 0
  put pls_sreset 1 get reset 1
  for s ulong 100
    put pls_sch s get chs s
    put pls_sval s get vals s
  end
  tb_exp_fill view reset view chs view vals
  put ve_nhyp TB_EXP_SLOT uchar pls_arg 0
  xn = vr_exp_write TB_EXP_SLOT edit xb
  b_append LEDG_PREREG part xb 0 xn xn
  pls_ln ln
  pls_t pls_t_prereg
  pls_u xn
  pls_t pls_t_len
  pls_u get vledg_len 0
  pls_nl
end

fn pls_trial ln ulong to void
  reset = new long 2 0
  chs = new uchar 100 0
  vals = new long 100 0
  put reset 0 get pls_sreset 0
  put reset 1 get pls_sreset 1
  for s ulong 100
    put chs s get pls_sch s
    put vals s get pls_sval s
  end
  ep = b_episode view reset view chs view vals ulong 20 get tw_k 0
  pls_ln ln
  pls_t pls_t_trial
  pls_u ulong ep
  pls_t pls_t_len
  pls_u get vledg_len 0
  pls_nl
end

fn pls_line3 ln ulong c ulong to void
  if eq c 67
    pls_corr ln
    ret
  end
  if eq c 82
    pls_rel ln
    ret
  end
  if eq c 75
    s = and pls_argu 0 7
    for k ulong 32
      put pls_hs add mul s 32 k get vledg_last k
    end
    ret
  end
  if eq c 65
    pls_fals ln
    ret
  end
  if eq c 80
    pls_prereg ln
    ret
  end
  if eq c 84
    pls_trial ln
    ret
  end
  if eq c 87
    put tw_k 0 div mul get tw_k 0 pls_arg 0 pls_arg 1
    ret
  end
  pls_ln ln
  pls_t pls_t_q
  pls_nl
end

note ---- scorer ----

fn pls_score_show ln ulong rc int to void
  pls_ln ln
  pls_t pls_t_score
  pls_i long rc
  pls_t pls_t_code
  pls_i long get sr_code 0
  pls_t pls_t_mask
  pls_x ulong get sr_fail_mask 0
  pls_t pls_t_in
  pls_i get sr_inbox 0
  pls_t pls_t_ex
  pls_i get sr_extrap 0
  pls_t pls_t_one
  pls_i get sr_onestep 0
  pls_t pls_t_ref
  pls_i get sr_ref 0
  pls_t pls_t_size
  pls_u ulong get sr_size 0
  pls_t pls_t_bits
  pls_u ulong get sr_bits 0
  pls_nl
end

fn pls_score_set ln ulong to void
  truth_init int pls_arg 0 pls_argu 1
  truth_score_params
  truth_score_episodes pls_argu 2 uint pls_arg 3 uint pls_arg 4
  nf = truth_fit_transitions pls_argu 5 uint pls_arg 6 uint pls_arg 7 uint pls_arg 8
  pls_ln ln
  pls_t pls_t_set
  pls_u ulong get se_n_eps 0
  pls_t pls_t_nfit
  pls_u ulong nf
  pls_t pls_t_sb
  pls_u ulong get sp_size_bound 0
  pls_t pls_t_nt
  pls_u ulong get sp_n_terms 0
  pls_nl
end

fn pls_score ln ulong to void
  k = pls_argu 0
  R = PLS_REL
  ex = new uchar 16 0
  put ex 0 uchar 1
  truth_oracle_rel R ulong get tw_n_hidden 0
  if eq k 1
    ctrl_mut_scale_coef R uchar 1 view ex pls_arg 1 pls_arg 2
  end
  if eq k 2
    ctrl_mut_pad R uint pls_arg 1 pls_arg 2
  end
  if eq k 3
    vr_clear PLS_EMPTY
    put vr_nvars PLS_EMPTY uchar 2
    put vr_nch PLS_EMPTY uchar 1
    rc = pd0_score PLS_EMPTY ctrl_mem_stored_numbers get sf_n_fit 0 get sp_n_obs 0 1
    pls_score_show ln rc
    ret
  end
  if eq k 4
    tb_add_term R ulong 1 long 1 ulong 4
    put vr_dbits R vr_rel_bits R
  end
  if eq k 5
    put vr_dbits R add get vr_dbits R uint 1
  end
  if eq k 12
    put vr_coef vr_term_idx R ulong 1 ulong 0 long 0
  end
  if eq k 6
    frc = sc_reference_fit get sp_n_obs 0 get sp_n_ch 0 uint pls_arg 1 get sf_n_fit 0 R
    pls_ln ln
    pls_t pls_t_fit
    pls_i long frc
    pls_nl
    if ne frc 0
      ret
    end
  end
  if eq k 7
    lv = get tw_level 0
    put tw_level 0 1
    truth_oracle_rel R ulong 0
    put tw_level 0 lv
  end
  if eq k 8
    vr_clear R
    put vr_nvars R uchar 3
    put vr_nch R uchar 1
  end
  if eq k 9
    put vr_nch R uchar 2
  end
  if eq k 10
    put vr_nvars R add get vr_nvars R uchar 1
    put vr_nlat R add get vr_nlat R uchar 1
  end
  st = uint 0
  if eq k 11
    st = uint pls_arg 1
  end
  rc = pd0_score R st 0
  pls_score_show ln rc
end

fn pls_sparam to void
  k = pls_argu 0
  v = pls_arg 1
  ix = pls_argu 2
  if eq k 0
    put sp_inbox_bound 0 v
  end
  if eq k 1
    put sp_extrap_bound 0 v
  end
  if eq k 2
    put sp_onestep_bound 0 v
  end
  if eq k 3
    put sp_score_const 0 int v
  end
  if eq k 4
    put sp_const_tol 0 v
  end
  if eq k 5
    put sp_req_lat 0 int v
  end
  if eq k 6
    put sp_lat_ref_fac 0 v
  end
  if eq k 7
    put sp_size_bound 0 uint v
  end
  if eq k 8
    put sp_n_terms 0 uint v
  end
  if eq k 9
    put sp_t_coef ix v
  end
  if eq k 10
    put sp_t_ex mul ix 16 uchar v
  end
  if eq k 11
    put sf_n_fit 0 uint v
  end
  if eq k 12
    put se_in_box ix uchar v
  end
  if eq k 13
    put se_n_eps 0 uint v
  end
end

fn pls_reffit ln ulong to void
  o = new uchar 8192 0
  rc = sc_reference_fit uchar pls_arg 1 uchar pls_arg 2 uint pls_arg 0 get sf_n_fit 0 PLS_REFS
  n = ulong 0
  if eq rc 0
    n = vr_rel_write PLS_REFS edit o
  end
  pls_ln ln
  pls_t pls_t_reffit
  pls_i long rc
  pls_t pls_t_n
  pls_u n
  pls_c 32
  pls_hex o n
  pls_nl
end

note ---- dispatch ----

fn pls_line2 ln ulong c ulong to void
  if eq c 101
    pls_episode ln
    ret
  end
  if eq c 103
    b_tag uint pls_arg 0 uchar pls_arg 1 uint pls_arg 2 uchar pls_arg 3
    ret
  end
  if eq c 66
    b_batch uint pls_arg 0 pls_argu 1 uint pls_arg 2
    ret
  end
  if eq c 79
    put tb_oob_at 0 uint pls_arg 0
    ret
  end
  if eq c 97
    pls_append ln
    ret
  end
  if eq c 83
    pls_score_set ln
    ret
  end
  if eq c 111
    pls_score ln
    ret
  end
  if eq c 117
    pls_sparam
    ret
  end
  if eq c 70
    pls_reffit ln
    ret
  end
  pls_line3 ln c
end

fn pls_line ln ulong s ulong e ulong to void
  c = ulong get pls_in s
  if eq c 72
    pls_hexload s e
    ret
  end
  pls_parse s e
  if eq c 98
    pls_build ln
    ret
  end
  if eq c 105
    b_init int pls_arg 0 pls_argu 1
    ret
  end
  if eq c 99
    rc = lad_check
    pls_report ln rc
    ret
  end
  if eq c 120
    if lt pls_argu 0 get vledg_len 0
      put vledg_buf pls_argu 0 uchar pls_arg 1
    end
    ret
  end
  if eq c 88
    if lt pls_argu 0 get vledg_len 0
      put vledg_buf pls_argu 0 xor get vledg_buf pls_argu 0 uchar 1
    end
    ret
  end
  if eq c 71
    b_tag get tb_episode 0 uchar pls_arg 0 uint pls_arg 1 uchar pls_arg 2
    ret
  end
  if eq c 122
    if le pls_argu 0 get vledg_len 0
      put vledg_len 0 pls_argu 0
    end
    ret
  end
  if eq c 81
    pls_param
    ret
  end
  if eq c 100
    pls_params ln
    ret
  end
  if eq c 76
    n = get pls_lawn 0
    for j ulong n bound 8192
      put pls_sav j get pls_law j
    end
    put pls_savn 0 n
    ret
  end
  if eq c 118
    pls_verify_saved ln
    ret
  end
  if eq c 116
    pls_tamper ln
    ret
  end
  if eq c 102
    pls_fab ln
    ret
  end
  if eq c 115
    pls_name ln
    ret
  end
  if eq c 107
    pls_ln ln
    pls_t pls_t_confv
    pls_u ulong lad_conf_ppm uint pls_arg 0 uint pls_arg 1
    pls_nl
    ret
  end
  if eq c 114
    pls_stats ln
    ret
  end
  if eq c 113
    pls_nrmse ln
    ret
  end
  pls_line2 ln c
end

fn main to int
  b_init 1 ulong 1
  total = ulong 0
  while lt total 4194304 bound 100000
    r = read 0 pls_in total sub 4194304 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  ln = ulong 0
  p = ulong 0
  while lt p total bound 4194305
    if eq get pls_in p 10
      ln = add ln 1
      if gt p start
        if ne get pls_in start 35
          pls_line ln start p
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  pls_flush
  ret 0
end

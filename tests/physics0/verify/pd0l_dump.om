note SPDX-License-Identifier: Apache-2.0
note tests/physics0/verify/pd0l_dump.om -- the pure OM-2 side of tests/physics0/verify/pd0l_parity.sh.
note Reads the corpus of commands on stdin, drives the OM-2 ports of the PD-0 ladder checker and scorer
note (src/physics0/ladder/pd0_ladder.om, src/physics0/score/pd0_score.om, the memoriser mode 1 of the
note scorer) over evidence ledgers and scoring sets built by the test bundle builders
note (tests/physics0/verify/pd0_bundle.om), and prints, line for line, what the C reference dumper printed
note from the live C (pd0_ladder.c, pd0_score.c, pd0_controls.c as at main 3f2c70dc5; the goldens in
note tests/physics0/verify/ladder_golden). Built after P0V_OM_VERIFY and pd0_bundle.om (mk/physics0-verify.mk).
note Slots: tampered law vl_ 2 (relation vr_ 74), fabricated law vl_ 3 (vr_ 76), scored relation vr_ 77,
note memoriser placeholder vr_ 78, reference fit vr_ 79. Commands: see pd0l_parity.sh.

global pls_in uchar 4194304
global pls_ob uchar 65536
global pls_on ulong 1
global pls_d uchar 24
global pls_a long 64
global pls_na ulong 1
global pls_h uchar 8192
global pls_hn ulong 1
global pls_law uchar 8192
global pls_lawn ulong 1
global pls_sav uchar 8192
global pls_savn ulong 1
global pls_rs ulong 1
global pls_hs uchar 256
global pls_sreset long 2
global pls_sch uchar 100
global pls_sval long 100

const PLS_LAW ulong 2
const PLS_LAW_REL ulong 74
const PLS_FAB ulong 3
const PLS_FAB_REL ulong 76
const PLS_REL ulong 77
const PLS_EMPTY ulong 78
const PLS_REFS ulong 79

text pls_hexd "0123456789abcdef"
text pls_always "This is always true. "
text pls_t_ledger " ledger rc="
text pls_t_len " len="
text pls_t_sha " sha="
text pls_t_rep " rep rc="
text pls_t_st " st="

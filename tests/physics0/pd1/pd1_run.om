note ---- Row storage ----
global pd1_nrows ulong 1
global pd1_root uchar 32
global pd1_seq ulong 65536
global pd1_src uchar 65536
global pd1_q0 uchar 65536
global pd1_q1 uchar 65536
global pd1_r1 uchar 65536
global pd1_q4 uint 65536
global pd1_cov uint 65536
global pd1_r0 long 65536
global pd1_tag uchar 65536
global pd1_hash uchar 2097152

note ---- Scratch for split, controls, scores, streaming SHA-256, output ----
global pd1_idx uint 65536
global pd1_save_r0 long 65536
global pd1_save_r1 uchar 65536
global pd1_dir uchar 1024
global pd1_dir_len ulong 1
global pd1_path uchar 1024
global pd1_arg uchar 1024
global pd1_rec uchar 112
global pd1_line uchar 4096
global pd1_law_buf uchar 65536
global pd1_sha_st uint 8
global pd1_sha_k uint 64
global pd1_sha_blk uchar 64
global pd1_sha_blen ulong 1
global pd1_sha_tot ulong 1
global pd1_sc_nlat uint 5
global pd1_sc_nrmse long 5
global pd1_sc_ncls uint 5
global pd1_sc_ll f64 5
global pd1_ll2 f64 5
global pd1_n2 uint 1
global pd1_ph_l uchar 32
global pd1_ph_c uchar 32
global pd1_oh uchar 32

note ---- Math: natural log (f64) ----
fn pd1_ln x f64 to f64
if le x 0.0f64
ret -1000.0f64
end
bits = bitcast ulong x
exp_raw = long and shr bits 52 ulong 0x7ff
e = sub exp_raw long 1023
mant_bits = or and bits ulong 0x000fffffffffffff ulong 0x3ff0000000000000
m = bitcast f64 mant_bits
if ge m 1.4142135623730951f64
m = mul m 0.5f64
e = add e long 1
end
t = div sub m 1.0f64 add m 1.0f64
t2 = mul t t
term = t
s = term
term = mul term t2
s = add s div term 3.0f64
term = mul term t2
s = add s div term 5.0f64
term = mul term t2
s = add s div term 7.0f64
term = mul term t2
s = add s div term 9.0f64
term = mul term t2
s = add s div term 11.0f64
term = mul term t2
s = add s div term 13.0f64
ln_m = mul 2.0f64 s
ret add mul f64 e 0.6931471805599453f64 ln_m
end

note ---- Streaming SHA-256 ----
fn pd1_sha_init to void
k = new uint 64 0
pd0_sha_kinit edit k
for i ulong 64
put pd1_sha_k i get k i
end
put pd1_sha_st 0 0x6a09e667
put pd1_sha_st 1 0xbb67ae85
put pd1_sha_st 2 0x3c6ef372
put pd1_sha_st 3 0xa54ff53a
put pd1_sha_st 4 0x510e527f
put pd1_sha_st 5 0x9b05688c
put pd1_sha_st 6 0x1f83d9ab
put pd1_sha_st 7 0x5be0cd19
put pd1_sha_blen 0 ulong 0
put pd1_sha_tot 0 ulong 0
ret
end

fn pd1_sha_step to void
st = new uint 8 0
blk = new uchar 64 0
k = new uint 64 0
for i ulong 8
put st i get pd1_sha_st i
end
for i ulong 64
put blk i get pd1_sha_blk i
put k i get pd1_sha_k i
end
pd0_sha_compress edit st view blk view k
for i ulong 8
put pd1_sha_st i get st i
end
ret
end

fn pd1_sha_update src view uchar * n ulong to void
blen = get pd1_sha_blen 0
put pd1_sha_tot 0 add get pd1_sha_tot 0 n
for i ulong n bound 65536
put pd1_sha_blk blen get src i
blen = add blen ulong 1
if eq blen ulong 64
pd1_sha_step
blen = ulong 0
end
end
put pd1_sha_blen 0 blen
ret
end

fn pd1_sha_final dst edit uchar 32 to void
blen = get pd1_sha_blen 0
put pd1_sha_blk blen uchar 0x80
blen = add blen ulong 1
if gt blen ulong 56
while lt blen ulong 64 bound 64
put pd1_sha_blk blen uchar 0
blen = add blen ulong 1
end
pd1_sha_step
blen = ulong 0
end
while lt blen ulong 56 bound 64
put pd1_sha_blk blen uchar 0
blen = add blen ulong 1
end
bits = mul get pd1_sha_tot 0 ulong 8
for i ulong 8
sh = mul sub ulong 7 i ulong 8
put pd1_sha_blk add ulong 56 i uchar and shr bits sh ulong 255
end
pd1_sha_step
st = new uint 8 0
for i ulong 8
put st i get pd1_sha_st i
end
pd0_sha_emit view st dst
ret
end

note ---- Formatting helpers (into pd1_line) ----
fn pd1_l_ch pos ulong ch uchar to ulong
if lt pos ulong 4096
put pd1_line pos ch
ret add pos ulong 1
end
ret pos
end

fn pd1_l_str pos ulong s view uchar * to ulong
n = len s
for i ulong n bound 4096
pos = pd1_l_ch pos get s i
end
ret pos
end

fn pd1_l_u64 pos ulong v ulong to ulong
if eq v ulong 0
ret pd1_l_ch pos uchar 48
end
tmp = new uchar 24 0
nd = ulong 0
cur = v
while gt cur ulong 0 bound 24
put tmp nd uchar add ulong 48 rem cur ulong 10
cur = div cur ulong 10
nd = add nd ulong 1
end
for k ulong nd bound 24
pos = pd1_l_ch pos get tmp sub sub nd ulong 1 k
end
ret pos
end

fn pd1_l_i64 pos ulong v long to ulong
if lt v long 0
pos = pd1_l_ch pos uchar 45
ret pd1_l_u64 pos pd0_abs_u64 v
end
ret pd1_l_u64 pos ulong v
end

fn pd1_l_i64_signed pos ulong v long to ulong
if lt v long 0
pos = pd1_l_ch pos uchar 45
ret pd1_l_u64 pos pd0_abs_u64 v
end
pos = pd1_l_ch pos uchar 43
ret pd1_l_u64 pos ulong v
end

fn pd1_l_hex64 pos ulong v ulong to ulong
if eq v ulong 0
ret pd1_l_ch pos uchar 48
end
tmp = new uchar 20 0
nd = ulong 0
cur = v
while gt cur ulong 0 bound 20
put tmp nd get PD1_HEX and cur ulong 15
cur = shr cur 4
nd = add nd ulong 1
end
for k ulong nd bound 20
pos = pd1_l_ch pos get tmp sub sub nd ulong 1 k
end
ret pos
end

fn pd1_l_hexbytes pos ulong h view uchar 32 to ulong
for i ulong 32
b = ulong get h i
pos = pd1_l_ch pos get PD1_HEX shr b 4
pos = pd1_l_ch pos get PD1_HEX and b ulong 15
end
ret pos
end

fn pd1_l_f64_1 pos ulong x f64 to ulong
t = pd0_llround mul x 10.0f64
if lt t long 0
pos = pd1_l_ch pos uchar 45
t = neg t
end
u = ulong t
pos = pd1_l_u64 pos div u ulong 10
pos = pd1_l_ch pos uchar 46
pos = pd1_l_ch pos uchar add ulong 48 rem u ulong 10
ret pos
end

fn pd1_l_f64_4 pos ulong x f64 to ulong
t = pd0_llround mul x 10000.0f64
if lt t long 0
pos = pd1_l_ch pos uchar 45
t = neg t
end
u = ulong t
pos = pd1_l_u64 pos div u ulong 10000
pos = pd1_l_ch pos uchar 46
fr = rem u ulong 10000
pos = pd1_l_ch pos uchar add ulong 48 div fr ulong 1000
pos = pd1_l_ch pos uchar add ulong 48 rem div fr ulong 100 ulong 10
pos = pd1_l_ch pos uchar add ulong 48 rem div fr ulong 10 ulong 10
pos = pd1_l_ch pos uchar add ulong 48 rem fr ulong 10
ret pos
end

fn pd1_flush fd int pos ulong to void
off = ulong 0
while lt off pos bound 4096
w = write fd pd1_line off sub pos off
if le w long 0
ret
end
off = add off ulong w
end
ret
end

fn pd1_err_at msg view uchar * idx ulong to void
pos = pd1_l_str ulong 0 msg
pos = pd1_l_u64 pos idx
pos = pd1_l_ch pos uchar 10
pd1_flush 2 pos
ret
end

note ---- Parse uint64 arg (decimal or 0x hex) ----
fn pd1_parse_u64 n ulong to ulong
if eq n ulong 0
ret ulong 0
end
i = ulong 0
base = ulong 10
if and ge n ulong 2 eq get pd1_arg 0 uchar 48
c1 = get pd1_arg 1
if or eq c1 uchar 120 eq c1 uchar 88
base = ulong 16
i = ulong 2
end
end
v = ulong 0
while lt i n bound 64
c = get pd1_arg i
d = ulong 99
if and ge c uchar 48 le c uchar 57
d = ulong sub c uchar 48
else
if and ge c uchar 97 le c uchar 102
d = add ulong 10 ulong sub c uchar 97
else
if and ge c uchar 65 le c uchar 70
d = add ulong 10 ulong sub c uchar 65
end
end
end
if ge d base
break
end
v = add mul v base d
i = add i ulong 1
end
ret v
end

note ---- Read exact 112-byte record ----
fn pd1_read_rec fd int to ulong
got = ulong 0
while lt got PD1_REC bound 112
r = read fd pd1_rec got sub PD1_REC got
if le r long 0
ret got
end
got = add got ulong r
end
ret got
end

fn pd1_load_one prev edit uchar 32 to int
nr = get pd1_nrows 0
rec = new uchar 112 0
for i ulong PD1_REC
put rec i get pd1_rec i
end
if or ne pd0_eq_bytes view rec ulong 0 PD1_MAGIC ulong 7 1 or ne get rec 7 uchar 0 or ne get rec 8 uchar 1 ne get rec 9 uchar 0
pd1_err_at PD1_S_BAD_MAGIC nr
ret -1
end
if ne pd0_get_u64 view rec ulong 16 nr
pd1_err_at PD1_S_SEQ_GAP nr
ret -1
end
for k ulong 32
if ne get rec add ulong 48 k get prev k
pd1_err_at PD1_S_CHAIN nr
ret -1
end
end
h = new uchar 32 0
pd0_sha256_hash view rec ulong 80 edit h
for k ulong 32
if ne get rec add ulong 80 k get h k
pd1_err_at PD1_S_RHASH nr
ret -1
end
end
if ge nr PD1_MAXROWS
pd0_puts 2 PD1_S_TOO_MANY
ret -1
end
put pd1_seq nr nr
put pd1_src nr get rec 10
put pd1_r1 nr get rec 11
put pd1_q0 nr get rec 12
put pd1_q1 nr get rec 13
put pd1_q4 nr pd0_get_u32 view rec ulong 24
put pd1_cov nr pd0_get_u32 view rec ulong 28
put pd1_r0 nr bitcast long pd0_get_u64 view rec ulong 40
hb = mul nr ulong 32
for k ulong 32
put pd1_hash add hb k get h k
put prev k get h k
end
put pd1_nrows 0 add nr ulong 1
ret 0
end

fn pd1_load plen ulong to int
fdl = fopen pd1_path ulong 0 plen 0 0
if lt fdl long 0
pos = pd1_l_str ulong 0 PD1_S_CANNOT_OPEN
for i ulong plen bound 1024
pos = pd1_l_ch pos get pd1_path i
end
pos = pd1_l_ch pos uchar 10
pd1_flush 2 pos
ret -1
end
fd = int fdl
put pd1_nrows 0 ulong 0
prev = new uchar 32 0
while true bound 65537
got = pd1_read_rec fd
if ne got PD1_REC
break
end
if ne pd1_load_one edit prev 0
ign_l = fclose fd
ret -1
end
end
ign_l = fclose fd
for k ulong 32
put pd1_root k get prev k
end
if eq get pd1_nrows 0 ulong 0
ret -1
end
ret 0
end

note ---- Deterministic stratified split ----
fn pd1_collect_stratum src uchar q0 uchar to ulong
nr = get pd1_nrows 0
n = ulong 0
for i ulong nr bound 65536
if eq get pd1_src i src
if eq get pd1_q0 i q0
put pd1_idx n uint i
n = add n ulong 1
end
end
end
ret n
end

fn pd1_shuffle_idx n ulong seed ulong tag view uchar * to void
g = new ulong 1 0
pd0_stream edit g seed tag
i = n
while gt i ulong 1 bound 65536
j = rem pd0_splitmix64 edit g i
im1 = sub i ulong 1
t = get pd1_idx im1
put pd1_idx im1 get pd1_idx j
put pd1_idx j t
i = im1
end
ret
end

fn pd1_tag_stratum n ulong to void
nf = div add mul n ulong 60 ulong 50 ulong 100
ns = div add mul n ulong 20 ulong 50 ulong 100
nfs = add nf ns
for k ulong n bound 65536
ri = ulong get pd1_idx k
if lt k nf
put pd1_tag ri TAG_FIT
else
if lt k nfs
put pd1_tag ri TAG_SELECT
else
put pd1_tag ri TAG_HOLDOUT
end
end
end
ret
end

fn pd1_split_stratum seed ulong src uchar q0 uchar tag view uchar * to void
n = pd1_collect_stratum src q0
pd1_shuffle_idx n seed tag
pd1_tag_stratum n
ret
end

fn pd1_split seed ulong to void
nr = get pd1_nrows 0
for i ulong nr bound 65536
put pd1_tag i PD1_T_EXCL
end
pd1_split_stratum seed uchar 1 uchar 0 PD1_TAG_SP10
pd1_split_stratum seed uchar 1 uchar 1 PD1_TAG_SP11
pd1_split_stratum seed uchar 3 uchar 0 PD1_TAG_SP30
pd1_split_stratum seed uchar 3 uchar 1 PD1_TAG_SP31
for i ulong nr bound 65536
if eq get pd1_src i uchar 2
put pd1_tag i TAG_HOLDOUT
end
end
ret
end

note ---- View helpers (vlat: 1=latency, 0=class; vext: 0/1 extra knob; vseed: extra seed) ----
fn pd1_row_in_view vlat int i ulong to int
if or eq get pd1_src i uchar 4 eq get pd1_q0 i uchar 255
ret 0
end
if ne vlat 0
if ge get pd1_r0 i long 0
ret 1
end
ret 0
end
if ne get pd1_r1 i uchar 255
ret 1
end
ret 0
end

fn pd1_knobs vext int vseed ulong i ulong x edit long 8 to void
g = new ulong 1 0
put x 0 mul long get pd1_q0 i PD1_MICRO
put x 1 mul long get pd1_q4 i PD1_MICRO
cv = get pd1_cov i
if eq cv uint 4294967295
put x 2 long 0
else
put x 2 mul long cv long 1000
end
put x 3 long 0
if ne vext 0
pd0_stream edit g vseed PD1_TAG_NULL_KNOB
sq = get pd1_seq i
v = long 0
for k ulong add sq ulong 1 bound 65537
v = pd0_uniform edit g
end
put x 4 v
end
ret
end

fn pd1_outcome vlat int i ulong to long
if ne vlat 0
ret get pd1_r0 i
end
ret mul long get pd1_r1 i PD1_MICRO
end

fn pd1_nobs vext int to uchar
if ne vext 0
ret uchar 5
end
ret uchar 4
end

note ---- Feed learner (supports nobs up to V_MAX_OBS = 8) ----
fn pd1_observe_raw no ulong bef view long 8 aft view long 8 ep uint tag uchar to int
nt = get p0l_nt 0
if ge nt P0L_MAX_TRANS
ret -1
end
base = mul nt V_MAX_OBS
for j ulong V_MAX_OBS
put p0l_tbef add base j long 0
put p0l_taft add base j long 0
end
for j ulong no bound 8
put p0l_tbef add base j get bef j
put p0l_taft add base j get aft j
end
put p0l_tchan nt PD0_CH_NONE
put p0l_tval nt long 0
put p0l_ttag nt tag
put p0l_tep nt ep
put p0l_trst nt uchar 0
put p0l_nt 0 add nt ulong 1
ret 0
end

fn pd1_feed_one vlat int vext int vseed ulong i ulong tag uchar to int
no = ulong pd1_nobs vext
bef = new long 8 0
aft = new long 8 0
pd1_knobs vext vseed i edit bef
for j ulong no bound 8
put aft j get bef j
end
put aft PD1_OUTV pd1_outcome vlat i
if eq pd1_observe_raw no view bef view aft uint get pd1_seq i tag 0
ret 1
end
ret 0
end

fn pd1_feed vlat int vext int vseed ulong tag uchar to uint
nr = get pd1_nrows 0
cnt = uint 0
for i ulong nr bound 65536
if ne get pd1_tag i tag
continue
end
if eq pd1_row_in_view vlat i 0
continue
end
if ne pd1_feed_one vlat vext vseed i tag 0
cnt = add cnt uint 1
end
end
ret cnt
end

fn pd1_desc_row vlat int vext int vseed ulong i ulong rmin edit long 8 rmax edit long 8 to void
no = ulong pd1_nobs vext
x = new long 8 0
pd1_knobs vext vseed i edit x
put x PD1_OUTV pd1_outcome vlat i
for j ulong no bound 8
vj = get x j
if lt vj get rmin j
put rmin j vj
end
if gt vj get rmax j
put rmax j vj
end
end
ret
end

fn pd1_desc_bounds vlat int vext int vseed ulong rmin edit long 8 rmax edit long 8 to void
no = ulong pd1_nobs vext
for j ulong 8
put rmin j long 0
put rmax j long 0
end
for j ulong no bound 8
put rmin j PD1_I64_MAX
put rmax j sub PD1_I64_MIN long 1
end
nr = get pd1_nrows 0
for i ulong nr bound 65536
if eq pd1_row_in_view vlat i 0
continue
end
pd1_desc_row vlat vext vseed i rmin rmax
end
ret
end

note ---- Relation evaluation and inspection ----
fn pd1_predict slot ulong x view long 8 to long
nv = ulong get vr_nvars slot
st = new long 12 0
nx = new long 12 0
for j ulong nv bound 8
put st j get x j
end
vr_rel_step slot view st PD0_CH_NONE long 0 edit nx
ret get nx PD1_OUTV
end

fn pd1_uses_term ti ulong nv ulong to uint
m = uint 0
xb = mul ti V_MAX_EX
for j ulong nv bound 8
if ne get vr_ex add xb j uchar 0
m = or m shl uint 1 uint j
end
end
ret m
end

fn pd1_uses slot ulong to uint
m = uint 0
nv = ulong get vr_nvars slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
ei = vr_eq_idx slot e
tgt = ulong get vr_eq_tgt ei
nt = ulong get vr_eq_nt ei
for t ulong nt bound 32
ti = vr_term_idx slot e t
if eq get vr_coef ti long 0
continue
end
if ne tgt PD1_OUTV
m = or m shl uint 1 uint 8
continue
end
m = or m pd1_uses_term ti nv
end
end
ret m
end

fn pd1_q0_term_pure ti ulong nv ulong to int
xb = mul ti V_MAX_EX
if lt get vr_ex xb uchar 1
ret 0
end
j = ulong 1
while lt j nv bound 8
if ne get vr_ex add xb j uchar 0
ret 0
end
j = add j ulong 1
end
ret 1
end

fn pd1_q0_coef slot ulong to long
nv = ulong get vr_nvars slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
ei = vr_eq_idx slot e
if ne ulong get vr_eq_tgt ei PD1_OUTV
continue
end
nt = ulong get vr_eq_nt ei
for t ulong nt bound 32
ti = vr_term_idx slot e t
c = get vr_coef ti
if ne c long 0
if ne pd1_q0_term_pure ti nv 0
ret c
end
end
end
end
ret long 0
end

note ---- Harness rivals (least squares on FIT) ----
fn pd1_rival_store slot ulong knob int a f64 b f64 to void
vr_clear slot
put vr_nvars slot uchar 4
put vr_nch slot uchar 0
put vr_neq slot uchar 1
ei = vr_eq_idx slot ulong 0
put vr_eq_tgt ei uchar PD1_OUTV
t0 = vr_term_idx slot ulong 0 ulong 0
xb0 = mul t0 V_MAX_EX
for k ulong V_MAX_EX
put vr_ex add xb0 k uchar 0
end
put vr_coef t0 pd0_llround mul b 1000000.0f64
nt = ulong 1
if ge knob 0
if ne a 0.0f64
t1 = vr_term_idx slot ulong 0 ulong 1
xb1 = mul t1 V_MAX_EX
for k ulong V_MAX_EX
put vr_ex add xb1 k uchar 0
end
put vr_ex add xb1 ulong knob uchar 1
put vr_coef t1 pd0_llround mul a 1000000.0f64
nt = ulong 2
end
end
put vr_eq_nt ei ushort nt
put vr_dbits slot vr_rel_bits slot
ret
end

fn pd1_rival_accum vlat int knob int out_s edit f64 4 to ulong
sxx = 0.0f64
sxy = 0.0f64
sx = 0.0f64
sy = 0.0f64
n = ulong 0
nr = get pd1_nrows 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_tag i TAG_FIT
continue
end
if eq pd1_row_in_view vlat i 0
continue
end
pd1_knobs 0 ulong 0 i edit x
xk = 0.0f64
if ge knob 0
xk = div f64 get x ulong knob 1000000.0f64
end
y = div f64 pd1_outcome vlat i 1000000.0f64
sx = add sx xk
sy = add sy y
sxx = add sxx mul xk xk
sxy = add sxy mul xk y
n = add n ulong 1
end
put out_s 0 sx
put out_s 1 sy
put out_s 2 sxx
put out_s 3 sxy
ret n
end

fn pd1_rival vlat int knob int slot ulong to void
st = new f64 4 0.0f64
n = pd1_rival_accum vlat knob edit st
a = 0.0f64
b = 0.0f64
if gt n ulong 0
fn_n = f64 n
b = div get st 1 fn_n
if ge knob 0
den = sub get st 2 div mul get st 0 get st 0 fn_n
if gt den 0.000000000001f64
a = div sub get st 3 div mul get st 0 get st 1 fn_n den
b = div sub get st 1 mul a get st 0 fn_n
end
end
end
pd1_rival_store slot knob a b
ret
end

note ---- Scoring on HOLDOUT ----
fn pd1_clip_p p f64 to f64
if lt p 0.001f64
ret 0.001f64
end
if gt p 0.999f64
ret 0.999f64
end
ret p
end

fn pd1_score_lat rel_l ulong out_lat edit long 2 to void
acc = new f64 24 0.0f64
nl = ulong 0
nr = get pd1_nrows 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_tag i TAG_HOLDOUT
continue
end
if eq get pd1_src i uchar 4
continue
end
if eq get pd1_q0 i uchar 255
continue
end
obs = get pd1_r0 i
if lt obs long 0
continue
end
pd1_knobs 0 ulong 0 i edit x
pr = pd1_predict rel_l view x
e = div f64 sub pr obs 1000000.0f64
v = div f64 obs 1000000.0f64
put acc 0 add get acc 0 mul e e
put acc 8 add get acc 8 v
put acc 16 add get acc 16 mul v v
nl = add nl ulong 1
end
put out_lat 0 long nl
if gt nl ulong 0
put out_lat 1 lad_acc_nrmse view acc nl ulong 1
else
put out_lat 1 long -1
end
ret
end

fn pd1_score_cls rel_c ulong out_cls edit f64 2 to void
ll = 0.0f64
nc = ulong 0
nr = get pd1_nrows 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_tag i TAG_HOLDOUT
continue
end
sr = get pd1_src i
if and ne sr uchar 2 ne sr uchar 3
continue
end
if eq get pd1_q0 i uchar 255
continue
end
if eq get pd1_r1 i uchar 255
continue
end
pd1_knobs 0 ulong 0 i edit x
p = pd1_clip_p div f64 pd1_predict rel_c view x 1000000.0f64
if ne get pd1_r1 i uchar 0
ll = sub ll pd1_ln p
else
ll = sub ll pd1_ln sub 1.0f64 p
end
nc = add nc ulong 1
end
put out_cls 0 f64 nc
if gt nc ulong 0
put out_cls 1 div ll f64 nc
else
put out_cls 1 -1.0f64
end
ret
end

fn pd1_score_one rel_l ulong rel_c ulong has_l int has_c int out_lat edit long 2 out_cls edit f64 2 to void
put out_lat 0 long 0
put out_lat 1 long -1
put out_cls 0 0.0f64
put out_cls 1 -1.0f64
if ne has_l 0
pd1_score_lat rel_l out_lat
end
if ne has_c 0
pd1_score_cls rel_c out_cls
end
ret
end

fn pd1_score_src2 rel_c ulong out_n edit uint 1 to f64
ll = 0.0f64
n2 = uint 0
nr = get pd1_nrows 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_src i uchar 2
continue
end
if ne get pd1_tag i TAG_HOLDOUT
continue
end
if eq get pd1_r1 i uchar 255
continue
end
pd1_knobs 0 ulong 0 i edit x
p = pd1_clip_p div f64 pd1_predict rel_c view x 1000000.0f64
if ne get pd1_r1 i uchar 0
ll = sub ll pd1_ln p
else
ll = sub ll pd1_ln sub 1.0f64 p
end
n2 = add n2 uint 1
end
put out_n 0 n2
if gt n2 uint 0
ret div ll f64 n2
end
ret -1.0f64
end

note ---- Preregistration and outcome hash ----
fn pd1_build_path suffix view uchar * to ulong
dlen = get pd1_dir_len 0
pos = ulong 0
for i ulong dlen bound 900
put pd1_path pos get pd1_dir i
pos = add pos ulong 1
end
sn = len suffix
for i ulong sn bound 120
put pd1_path pos get suffix i
pos = add pos ulong 1
end
ret pos
end

fn pd1_open_out suffix view uchar * to int
plen = pd1_build_path suffix
fdl = fopen pd1_path ulong 0 plen 577 420
if lt fdl long 0
pos = pd1_l_str ulong 0 PD1_S_CANNOT_WRITE
for i ulong plen bound 1024
pos = pd1_l_ch pos get pd1_path i
end
pos = pd1_l_ch pos uchar 10
pd1_flush 2 pos
exit 3
end
ret int fdl
end

fn pd1_write_hash_line fd int pos ulong to void
pd1_flush fd pos
buf = new uchar 4096 0
for i ulong pos bound 4096
put buf i get pd1_line i
end
pd1_sha_update view buf pos
ret
end

fn pd1_prereg vlat int slots view ulong 5 out_h edit uchar 32 to void
fd = int -1
if ne vlat 0
fd = pd1_open_out PD1_F_PREREG_L
else
fd = pd1_open_out PD1_F_PREREG_C
end
pd1_sha_init
pos = pd1_l_str ulong 0 PD1_PREREG_HDR
pd1_write_hash_line fd pos
nr = get pd1_nrows 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_tag i TAG_HOLDOUT
continue
end
sr = get pd1_src i
if eq sr uchar 4
continue
end
if eq get pd1_q0 i uchar 255
continue
end
if ne vlat 0
if lt get pd1_r0 i long 0
continue
end
else
if and ne sr uchar 2 ne sr uchar 3
continue
end
end
pd1_knobs 0 ulong 0 i edit x
pos = pd1_l_u64 ulong 0 get pd1_seq i
for m ulong 5
pos = pd1_l_ch pos uchar 9
pos = pd1_l_i64 pos pd1_predict get slots m view x
end
pos = pd1_l_ch pos uchar 10
pd1_write_hash_line fd pos
end
ign_l = fclose fd
pd1_sha_final out_h
ret
end

fn pd1_outcome_hash dst edit uchar 32 to void
pd1_sha_init
nr = get pd1_nrows 0
b = new uchar 17 0
for i ulong nr bound 65536
if and eq get pd1_tag i TAG_HOLDOUT ne get pd1_src i uchar 4
r0u = bitcast ulong get pd1_r0 i
sq = get pd1_seq i
for k ulong 8
sh = mul k ulong 8
put b k uchar and shr r0u sh ulong 255
put b add ulong 8 k uchar and shr sq sh ulong 255
end
put b 16 get pd1_r1 i
pd1_sha_update view b ulong 17
end
end
pd1_sha_final dst
ret
end

note ---- Printing helpers ----
fn pd1_print_rel_term pos ulong ti ulong nv ulong to ulong
pos = pd1_l_ch pos uchar 32
pos = pd1_l_i64_signed pos get vr_coef ti
pos = pd1_l_str pos PD1_S_E6
xb = mul ti V_MAX_EX
for j ulong nv bound 8
ex = ulong get vr_ex add xb j
for k ulong ex bound 8
pos = pd1_l_str pos PD1_S_MV
pos = pd1_l_u64 pos j
end
end
ret pos
end

fn pd1_print_rel name view uchar * slot ulong to void
pos = pd1_l_str ulong 0 PD1_S_SP2
pos = pd1_l_str pos name
pos = pd1_l_str pos PD1_S_EQS
pos = pd1_l_u64 pos ulong get vr_neq slot
pos = pd1_l_str pos PD1_S_BITS
pos = pd1_l_u64 pos ulong vr_rel_bits slot
pos = pd1_l_str pos PD1_S_SIZE
pos = pd1_l_u64 pos ulong vr_rel_size slot
nv = ulong get vr_nvars slot
ne_cnt = ulong get vr_neq slot
for e ulong ne_cnt bound 12
ei = vr_eq_idx slot e
pos = pd1_l_str pos PD1_S_DV
pos = pd1_l_u64 pos ulong get vr_eq_tgt ei
pos = pd1_l_str pos PD1_S_EQ
nt = ulong get vr_eq_nt ei
for t ulong nt bound 32
pos = pd1_print_rel_term pos vr_term_idx slot e t nv
end
end
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

fn pd1_print_learner_cands nf uint ns uint nc int to void
pos = pd1_l_str ulong 0 PD1_S_LRN1
pos = pd1_l_u64 pos ulong nf
pos = pd1_l_str pos PD1_S_LRN2
pos = pd1_l_u64 pos ulong ns
pos = pd1_l_str pos PD1_S_LRN3
pos = pd1_l_i64 pos long nc
pos = pd1_l_str pos PD1_S_LRN4
pos = pd1_l_i64 pos long get p0l_c_null 0
for i ulong ulong nc bound 8
pos = pd1_l_str pos PD1_S_LBR
pos = pd1_l_u64 pos i
pos = pd1_l_str pos PD1_S_COLON_SP
if ne get p0l_c_null i 0
pos = pd1_l_str pos PD1_T_NULL
else
pos = pd1_l_str pos PD1_S_CAND
end
pos = pd1_l_str pos PD1_S_BITS
pos = pd1_l_u64 pos ulong get p0l_c_bits i
pos = pd1_l_str pos PD1_S_SNRMSE
pos = pd1_l_i64 pos get p0l_c_snrmse i
pos = pd1_l_str pos PD1_S_MDL
pos = pd1_l_f64_1 pos get p0l_c_mdl i
pos = pd1_l_str pos PD1_S_USES
pos = pd1_l_hex64 pos ulong pd1_uses add P0L_CAND_BASE i
pos = pd1_l_ch pos uchar 93
end
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

fn pd1_run_view vlat int vext int vseed ulong seed ulong dst_slot ulong to int
rmin = new long 8 0
rmax = new long 8 0
cmin = new long 4 0
cmax = new long 4 0
pd1_desc_bounds vlat vext vseed edit rmin edit rmax
rc = p0l_init pd1_nobs vext uchar 0 PD1_MICRO seed
p0l_set_bounds view cmin view cmax view rmin view rmax
p0l_set_budget uint 1 uint PD1_MAXROWS uint PD1_MAXROWS
nf = pd1_feed vlat vext vseed TAG_FIT
ns = pd1_feed vlat vext vseed TAG_SELECT
nc = p0l_fit
vr_copy dst_slot P0L_CAND_BASE
pd1_print_learner_cands nf ns nc
ret get p0l_c_null 0
end

note ---- Section 5/6/7 printing and controls ----
fn pd1_print_header seed ulong to void
pd0_puts 1 PD1_S_HDR1
rh = new uchar 32 0
for k ulong 32
put rh k get pd1_root k
end
pos = pd1_l_str ulong 0 PD1_S_HDR2
pos = pd1_l_u64 pos get pd1_nrows 0
pos = pd1_l_str pos PD1_S_ROOT
pos = pd1_l_hexbytes pos view rh
pos = pd1_l_str pos PD1_S_SEED
pos = pd1_l_u64 pos seed
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
pd0_puts 1 PD1_S_HDR3
ret
end

fn pd1_print_splits to void
cnt = new uint 20 0
nr = get pd1_nrows 0
for i ulong nr bound 65536
sr = ulong get pd1_src i
if le sr ulong 4
tg = get pd1_tag i
ti = ulong 3
if eq tg TAG_FIT
ti = ulong 0
else
if eq tg TAG_SELECT
ti = ulong 1
else
if eq tg TAG_HOLDOUT
ti = ulong 2
end
end
end
idx = add mul sr ulong 4 ti
put cnt idx add get cnt idx uint 1
end
end
pos = pd1_l_str ulong 0 PD1_S_SPLITS
for s ulong 4
sr = add s ulong 1
b = mul sr ulong 4
pos = pd1_l_ch pos uchar 32
pos = pd1_l_u64 pos sr
pos = pd1_l_str pos PD1_S_COLON_SP
pos = pd1_l_u64 pos ulong get cnt b
pos = pd1_l_ch pos uchar 32
pos = pd1_l_u64 pos ulong get cnt add b ulong 1
pos = pd1_l_ch pos uchar 32
pos = pd1_l_u64 pos ulong get cnt add b ulong 2
pos = pd1_l_ch pos uchar 32
pos = pd1_l_u64 pos ulong get cnt add b ulong 3
pos = pd1_l_ch pos uchar 59
end
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

fn pd1_print_prereg to void
h1 = new uchar 32 0
h2 = new uchar 32 0
for k ulong 32
put h1 k get pd1_ph_l k
put h2 k get pd1_ph_c k
end
pos = pd1_l_str ulong 0 PD1_S_PRE1
pos = pd1_l_hexbytes pos view h1
pos = pd1_l_str pos PD1_S_PRE2
pos = pd1_l_hexbytes pos view h2
pos = pd1_l_str pos PD1_S_PRE3
dlen = get pd1_dir_len 0
for i ulong dlen bound 900
pos = pd1_l_ch pos get pd1_dir i
end
pos = pd1_l_str pos PD1_S_PRE4
pd1_flush 1 pos
for k ulong 32
put h1 k get pd1_oh k
end
pos = pd1_l_str ulong 0 PD1_S_OH
pos = pd1_l_hexbytes pos view h1
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

fn pd1_l_model_pad pos ulong m ulong to ulong
if eq m ulong 0
ret pd1_l_str pos PD1_P_CAND
end
if eq m ulong 1
ret pd1_l_str pos PD1_P_EMP
end
if eq m ulong 2
ret pd1_l_str pos PD1_P_Q4
end
if eq m ulong 3
ret pd1_l_str pos PD1_P_COV
end
ret pd1_l_str pos PD1_P_NULL
end

fn pd1_l_model_name pos ulong m ulong to ulong
if eq m ulong 0
ret pd1_l_str pos PD1_N_CAND
end
if eq m ulong 1
ret pd1_l_str pos PD1_N_EMP
end
if eq m ulong 2
ret pd1_l_str pos PD1_N_Q4
end
if eq m ulong 3
ret pd1_l_str pos PD1_N_COV
end
ret pd1_l_str pos PD1_N_NULL
end

fn pd1_score_all ml view ulong 5 mc view ulong 5 to void
pd0_puts 1 PD1_S_HOLD_HDR
olat = new long 2 0
ocls = new f64 2 0.0f64
for m ulong 5
pd1_score_one get ml m get mc m 1 1 edit olat edit ocls
put pd1_sc_nlat m uint get olat 0
put pd1_sc_nrmse m get olat 1
put pd1_sc_ncls m uint long get ocls 0
put pd1_sc_ll m get ocls 1
pos = pd1_l_str ulong 0 PD1_S_SP2
pos = pd1_l_model_pad pos m
pos = pd1_l_str pos PD1_S_HL1
pos = pd1_l_u64 pos ulong get pd1_sc_nlat m
pos = pd1_l_str pos PD1_S_HL2
pos = pd1_l_i64 pos get pd1_sc_nrmse m
pos = pd1_l_str pos PD1_S_BITS
pos = pd1_l_u64 pos ulong vr_rel_bits get ml m
pos = pd1_l_str pos PD1_S_HL3
pos = pd1_l_u64 pos ulong get pd1_sc_ncls m
pos = pd1_l_str pos PD1_S_HL4
pos = pd1_l_f64_4 pos get pd1_sc_ll m
pos = pd1_l_str pos PD1_S_BITS
pos = pd1_l_u64 pos ulong vr_rel_bits get mc m
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
end
n2a = new uint 1 0
for m ulong 5
put pd1_ll2 m pd1_score_src2 get mc m edit n2a
end
put pd1_n2 0 get n2a 0
pos = pd1_l_str ulong 0 PD1_S_SRC2
pos = pd1_l_u64 pos ulong get pd1_n2 0
pos = pd1_l_str pos PD1_S_RP_COL
for m ulong 5
pos = pd1_l_ch pos uchar 32
pos = pd1_l_model_name pos m
pos = pd1_l_ch pos uchar 61
pos = pd1_l_f64_4 pos get pd1_ll2 m
end
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

note ---- Controls ----
fn pd1_collect_src src uchar to ulong
nr = get pd1_nrows 0
n = ulong 0
for i ulong nr bound 65536
if eq get pd1_src i src
put pd1_idx n uint i
n = add n ulong 1
end
end
ret n
end

fn pd1_swap_outcomes a ulong b ulong to void
t0 = get pd1_r0 a
put pd1_r0 a get pd1_r0 b
put pd1_r0 b t0
t1 = get pd1_r1 a
put pd1_r1 a get pd1_r1 b
put pd1_r1 b t1
ret
end

fn pd1_ncp1_shuf_src seed ulong src uchar tag view uchar * to void
n = pd1_collect_src src
g = new ulong 1 0
pd0_stream edit g seed tag
i = n
while gt i ulong 1 bound 65536
j = rem pd0_splitmix64 edit g i
im1 = sub i ulong 1
pd1_swap_outcomes ulong get pd1_idx im1 ulong get pd1_idx j
i = im1
end
ret
end

fn pd1_ctrl_ncp1 seed ulong to int
nr = get pd1_nrows 0
for i ulong nr bound 65536
put pd1_save_r0 i get pd1_r0 i
put pd1_save_r1 i get pd1_r1 i
end
pd1_ncp1_shuf_src seed uchar 1 PD1_TAG_NC1
pd1_ncp1_shuf_src seed uchar 2 PD1_TAG_NC2
pd1_ncp1_shuf_src seed uchar 3 PD1_TAG_NC3
inl = pd1_run_view 1 0 ulong 0 seed PD1_S_TMP1
inc = pd1_run_view 0 0 ulong 0 seed PD1_S_TMP2
u1 = uint 0
if eq inl 0
u1 = pd1_uses PD1_S_TMP1
end
u2 = uint 0
if eq inc 0
u2 = pd1_uses PD1_S_TMP2
end
ok = int 0
if eq and u1 uint 0xff uint 0
if eq and u2 uint 0xff uint 0
ok = 1
end
end
pos = pd1_l_str ulong 0 PD1_S_NC1A
pos = pd1_l_i64 pos long inl
pos = pd1_l_str pos PD1_S_USES
pos = pd1_l_hex64 pos ulong u1
pos = pd1_l_str pos PD1_S_NC1B
pos = pd1_l_i64 pos long inc
pos = pd1_l_str pos PD1_S_USES
pos = pd1_l_hex64 pos ulong u2
pos = pd1_l_str pos PD1_S_NC1C
if ne ok 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
for i ulong nr bound 65536
put pd1_r0 i get pd1_save_r0 i
put pd1_r1 i get pd1_save_r1 i
end
ret ok
end

fn pd1_flip_q0_src1 to void
nr = get pd1_nrows 0
for i ulong nr bound 65536
if eq get pd1_src i uchar 1
if ne get pd1_q0 i uchar 255
put pd1_q0 i sub uchar 1 get pd1_q0 i
end
end
end
ret
end

fn pd1_ctrl_ncp2 seed ulong to int
pd1_flip_q0_src1
isn = pd1_run_view 1 0 ulong 0 seed PD1_S_TMP1
c_orig = pd1_q0_coef PD1_S_CAND_L
c_swap = pd1_q0_coef PD1_S_TMP1
ok = int 0
if eq isn 0
if gt c_orig long 0
if lt c_swap long 0
ok = 1
end
end
if lt c_orig long 0
if gt c_swap long 0
ok = 1
end
end
end
pos = pd1_l_str ulong 0 PD1_S_NC2A
pos = pd1_l_i64 pos c_orig
pos = pd1_l_str pos PD1_S_NC2B
pos = pd1_l_i64 pos c_swap
pos = pd1_l_str pos PD1_S_ARROW
if ne ok 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
pd1_flip_q0_src1
ret ok
end

fn pd1_ctrl_ncp3 seed ulong to int
xseed = xor seed ulong 0x6b6e6f62
isn = pd1_run_view 1 1 xseed seed PD1_S_TMP1
u = pd1_uses PD1_S_TMP1
ok = int 0
if eq isn 0
if eq and u uint 16 uint 0
if ne and u uint 1 uint 0
ok = 1
end
end
end
pos = pd1_l_str ulong 0 PD1_S_NC3A
pos = pd1_l_hex64 pos xseed
pos = pd1_l_str pos PD1_S_NC3B
pos = pd1_l_hex64 pos ulong u
pos = pd1_l_str pos PD1_S_ARROW
if ne ok 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
ret ok
end

fn pd1_ctrl_ncp4 to int
s0 = get pd1_sc_nrmse 0
s2 = get pd1_sc_nrmse 2
ok = int 0
if ge s0 long 0
if ge s2 long 0
if lt s0 s2
ok = 1
end
end
end
pos = pd1_l_str ulong 0 PD1_S_NC4A
pos = pd1_l_i64 pos s0
pos = pd1_l_str pos PD1_S_NC4B
pos = pd1_l_i64 pos s2
pos = pd1_l_str pos PD1_S_ARROW
if ne ok 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
ret ok
end

fn pd1_ctrl_pos_fill to ulong
nr = get pd1_nrows 0
n = ulong 0
x = new long 8 0
for i ulong nr bound 65536
if ne get pd1_tag i TAG_FIT
continue
end
if eq pd1_row_in_view 1 i 0
continue
end
pd1_knobs 0 ulong 0 i edit x
b = mul n V_MAX_OBS
for j ulong V_MAX_OBS
put sf_bef add b j long 0
put sf_aft add b j long 0
end
for j ulong PD1_NV
put sf_bef add b j get x j
put sf_aft add b j get x j
end
put sf_aft add b PD1_OUTV get pd1_r0 i
put sf_ch n PD0_CH_NONE
put sf_val n long 0
n = add n ulong 1
end
put sf_n_fit 0 uint n
ret n
end

fn pd1_ctrl_pos to int
n = pd1_ctrl_pos_fill
vr_clear PD1_S_REF
rc = sc_reference_fit uchar 4 uchar 0 uint 3 uint n PD1_S_REF
olat = new long 2 0
ocls = new f64 2 0.0f64
pd1_score_one PD1_S_REF PD1_S_NULL 1 0 edit olat edit ocls
nr_ref = get olat 1
ok = int 0
if eq rc 0
if ge nr_ref long 0
if le nr_ref PD1_NRMSE_BOUND
ok = 1
end
end
end
pd1_print_rel PD1_N_REF PD1_S_REF
pos = pd1_l_str ulong 0 PD1_S_POSA
pos = pd1_l_u64 pos n
pos = pd1_l_str pos PD1_S_POSB
pos = pd1_l_i64 pos long rc
pos = pd1_l_str pos PD1_S_POSC
pos = pd1_l_i64 pos nr_ref
pos = pd1_l_str pos PD1_S_USES
pos = pd1_l_hex64 pos ulong pd1_uses PD1_S_REF
pos = pd1_l_str pos PD1_S_ARROW
if ne ok 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
ret ok
end

note ---- Law record emission ----
fn pd1_build_claim p uint f uint nexc uint to ulong
pos = pd1_l_str ulong 0 PD1_S_CL1
pos = pd1_l_u64 pos ulong p
pos = pd1_l_str pos PD1_S_CL2
pos = pd1_l_u64 pos ulong add p f
pos = pd1_l_str pos PD1_S_CL3
pos = pd1_l_u64 pos ulong nexc
pos = pd1_l_str pos PD1_S_CL4
if gt pos VL_MAX_CLAIM
pos = VL_MAX_CLAIM
end
for k ulong pos bound 512
put vl_claim k get pd1_line k
end
put vl_claim_len 0 uint pos
ret pos
end

fn pd1_emit_law_dom to void
vl_clear ulong 0 PD1_S_CAND_L
put vl_state 0 PD0_LAW_HYPOTHESIS
rmin = new long 8 0
rmax = new long 8 0
pd1_desc_bounds 1 0 ulong 0 edit rmin edit rmax
put vl_dom_nobs 0 uchar 4
put vl_dom_nch 0 uchar 0
put vl_dom_dt 0 PD1_MICRO
put vl_dom_eplen 0 uint 1
for j ulong 4
put vl_dom_vmin j get rmin j
put vl_dom_vmax j get rmax j
end
put vl_dom_rmin 0 get rmin PD1_OUTV
put vl_dom_rmax 0 get rmax PD1_OUTV
nr = get pd1_nrows 0
nobs_cnt = ulong 0
for i ulong nr bound 65536
tg = get pd1_tag i
if or eq tg TAG_FIT eq tg TAG_SELECT
if ne pd1_row_in_view 1 i 0
nobs_cnt = add nobs_cnt ulong 1
end
end
end
put vl_dom_nobs_cnt 0 nobs_cnt
put vl_dom_nep_cnt 0 uint nobs_cnt
ret
end

fn pd1_emit_law_exc to ulong
nr = get pd1_nrows 0
nexc = ulong 0
x = new long 8 0
for i ulong nr bound 65536
if ge nexc VL_MAX_EXC
break
end
if eq get pd1_src i uchar 3
if eq get pd1_r1 i uchar 1
put vl_exc_seq nexc get pd1_seq i
dhb = mul nexc ulong 32
shb = mul i ulong 32
for k ulong 32
put vl_exc_hash add dhb k get pd1_hash add shb k
end
pd1_knobs 0 ulong 0 i edit x
pr = pd1_predict PD1_S_CAND_C view x
put vl_exc_pred nexc pr
put vl_exc_obs nexc PD1_MICRO
put vl_exc_err nexc sub PD1_MICRO pr
nexc = add nexc ulong 1
end
end
end
put vl_n_exc 0 uint nexc
ret nexc
end

fn pd1_emit_law_conf lat_ok int out_pf edit uint 2 to void
nr = get pd1_nrows 0
put vl_n_exp 0 uint 1
put vl_exp_kind 0 uchar 1
put vl_exp_res 0 uchar lat_ok
put vl_exp_fseq 0 ulong 0
put vl_exp_lseq 0 sub nr ulong 1
for k ulong 32
put vl_exp_pre k get pd1_ph_l k
put vl_exp_out k get pd1_oh k
put vl_exp_id k get pd1_ph_l k
put vl_chain_root k get pd1_root k
end
p = uint 0
f = uint 0
x = new long 8 0
for i ulong nr bound 65536
if eq get pd1_tag i TAG_HOLDOUT
if ge get pd1_r0 i long 0
pd1_knobs 0 ulong 0 i edit x
pr = pd1_predict PD1_S_CAND_L view x
r0 = get pd1_r0 i
if le mul p0l_iabs sub pr r0 long 100 add p0l_iabs r0 long 1
p = add p uint 1
else
f = add f uint 1
end
end
end
end
put out_pf 0 p
put out_pf 1 f
put vl_conf_ppm 0 lad_conf_ppm p f
ret
end

fn pd1_emit_law_fill lat_ok int out_pf edit uint 2 to ulong
pd1_emit_law_dom
nexc = pd1_emit_law_exc
pd1_emit_law_conf lat_ok out_pf
ret nexc
end

fn pd1_emit_law lat_ok int to void
pf = new uint 2 0
nexc = pd1_emit_law_fill lat_ok edit pf
p = get pf 0
f = get pf 1
clen = pd1_build_claim p f uint nexc
buf = new uchar 65536 0
n = vr_law_write ulong 0 edit buf
if gt n ulong 0
for i ulong n bound 65536
put pd1_law_buf i get buf i
end
plen = pd1_build_path PD1_F_LAW
fdl = fopen pd1_path ulong 0 plen 577 420
if ge fdl long 0
fd = int fdl
off = ulong 0
while lt off n bound 65536
w = write fd pd1_law_buf off sub n off
if le w long 0
break
end
off = add off ulong w
end
ign_l = fclose fd
end
end
lid = new uchar 32 0
for k ulong 32
put lid k get vl_law_id k
end
pd0_puts 1 PD1_S_LAW_HDR
pos = pd1_l_str ulong 0 PD1_S_LAW1
pos = pd1_l_hexbytes pos view lid
pos = pd1_l_str pos PD1_S_LAW2
pos = pd1_l_u64 pos n
pos = pd1_l_str pos PD1_S_LAW3
pos = pd1_l_u64 pos nexc
pos = pd1_l_str pos PD1_S_LAW4
pos = pd1_l_u64 pos ulong get vl_conf_ppm 0
pos = pd1_l_str pos PD1_S_LAW5
pos = pd1_l_u64 pos ulong p
pos = pd1_l_ch pos uchar 47
pos = pd1_l_u64 pos ulong add p f
pos = pd1_l_str pos PD1_S_LAW6
for k ulong clen bound 512
pos = pd1_l_ch pos get vl_claim k
end
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret
end

note ---- Verdict & section 7 checks ----
fn pd1_check_lat null_l int to int
ul = pd1_uses PD1_S_CAND_L
lat_knobs_ok = int 0
if eq null_l 0
if eq ul uint 1
lat_knobs_ok = 1
end
end
lat_beats = int 0
if eq null_l 0
lat_beats = 1
end
s0 = get pd1_sc_nrmse 0
for m ulong 4
sm = get pd1_sc_nrmse add m ulong 1
if ne lat_beats 0
if ge sm long 0
if ge s0 sm
lat_beats = 0
end
end
end
end
lat_bound_ok = int 0
if ge s0 long 0
if le s0 PD1_NRMSE_BOUND
lat_bound_ok = 1
end
end
pd0_puts 1 PD1_S_SEC7_HDR
pos = pd1_l_str ulong 0 PD1_S_S7A
pos = pd1_l_i64 pos long lat_knobs_ok
pos = pd1_l_str pos PD1_S_S7B
pos = pd1_l_hex64 pos ulong ul
pos = pd1_l_str pos PD1_S_S7C
pos = pd1_l_i64 pos long lat_beats
pos = pd1_l_str pos PD1_S_S7D
pos = pd1_l_i64 pos long lat_bound_ok
pd1_flush 1 pos
ret add add shl lat_knobs_ok 2 shl lat_beats 1 lat_bound_ok
end

fn pd1_check_cls null_c int to int
uc = pd1_uses PD1_S_CAND_C
cls_knobs_ok = int 0
if eq null_c 0
if eq uc uint 1
cls_knobs_ok = 1
end
end
cls_beats = int 0
if eq null_c 0
cls_beats = 1
end
l0 = get pd1_ll2 0
for m ulong 4
lm = get pd1_ll2 add m ulong 1
if ne cls_beats 0
if ge lm 0.0f64
if ge l0 lm
cls_beats = 0
end
end
end
end
cls_margin_ok = int 0
if eq null_c 0
if ge l0 0.0f64
if ge sub get pd1_ll2 1 l0 0.05f64
cls_margin_ok = 1
end
end
end
pos = pd1_l_str ulong 0 PD1_S_S7E
pos = pd1_l_i64 pos long cls_knobs_ok
pos = pd1_l_str pos PD1_S_S7B
pos = pd1_l_hex64 pos ulong uc
pos = pd1_l_str pos PD1_S_S7F
pos = pd1_l_i64 pos long cls_beats
pos = pd1_l_str pos PD1_S_S7G
pos = pd1_l_i64 pos long cls_margin_ok
pos = pd1_l_ch pos uchar 10
pd1_flush 1 pos
ret add add shl cls_knobs_ok 2 shl cls_beats 1 cls_margin_ok
end

fn pd1_check_and_verdict null_l int null_c int to int
lb = pd1_check_lat null_l
cb = pd1_check_cls null_c
ret add shl lb 3 cb
end

fn pd1_print_verdict ctrl_ok int lat_part int cls_part int pass int to void
pd0_puts 1 PD1_S_VERD_HDR
pos = pd1_l_str ulong 0 PD1_S_V1
if ne ctrl_ok 0
pos = pd1_l_str pos PD1_S_PASS
else
pos = pd1_l_str pos PD1_S_FAIL
end
pos = pd1_l_str pos PD1_S_V2
if ne lat_part 0
pos = pd1_l_str pos PD1_S_PASS
else
pos = pd1_l_str pos PD1_S_FAIL
end
pos = pd1_l_str pos PD1_S_V3
if ne cls_part 0
pos = pd1_l_str pos PD1_S_PASS_NL
else
pos = pd1_l_str pos PD1_S_FAIL_NL
end
pd1_flush 1 pos
pos = pd1_l_str ulong 0 PD1_S_V4
if ne pass 0
pos = pd1_l_str pos PD1_S_PASS
else
pos = pd1_l_str pos PD1_S_FAIL
end
pos = pd1_l_str pos PD1_S_V5
pd1_flush 1 pos
ret
end

fn pd1_run_rivals_and_score to void
pd1_rival 1 -1 PD1_S_EMP_L
pd1_rival 1 1 PD1_S_Q4_L
pd1_rival 1 2 PD1_S_COV_L
pd1_rival 0 -1 PD1_S_EMP_C
pd1_rival 0 1 PD1_S_Q4_C
pd1_rival 0 2 PD1_S_COV_C
vr_clear PD1_S_NULL
put vr_nvars PD1_S_NULL uchar 4
pd0_puts 1 PD1_S_RIV_HDR
pd1_print_rel PD1_N_EMP_L PD1_S_EMP_L
pd1_print_rel PD1_N_Q4_L PD1_S_Q4_L
pd1_print_rel PD1_N_COV_L PD1_S_COV_L
pd1_print_rel PD1_N_EMP_C PD1_S_EMP_C
pd1_print_rel PD1_N_Q4_C PD1_S_Q4_C
pd1_print_rel PD1_N_COV_C PD1_S_COV_C
ml = new ulong 5 0
put ml 0 PD1_S_CAND_L
put ml 1 PD1_S_EMP_L
put ml 2 PD1_S_Q4_L
put ml 3 PD1_S_COV_L
put ml 4 PD1_S_NULL
mc = new ulong 5 0
put mc 0 PD1_S_CAND_C
put mc 1 PD1_S_EMP_C
put mc 2 PD1_S_Q4_C
put mc 3 PD1_S_COV_C
put mc 4 PD1_S_NULL
h = new uchar 32 0
pd1_prereg 1 view ml edit h
for k ulong 32
put pd1_ph_l k get h k
end
pd1_prereg 0 view mc edit h
for k ulong 32
put pd1_ph_c k get h k
end
pd1_outcome_hash edit h
for k ulong 32
put pd1_oh k get h k
end
pd1_print_prereg
pd1_score_all view ml view mc
ret
end

fn pd1_run_all seed ulong to int
pd1_print_header seed
pd1_split seed
pd1_print_splits
pd0_puts 1 PD1_S_LAT_HDR
null_l = pd1_run_view 1 0 ulong 0 seed PD1_S_CAND_L
pd1_print_rel PD1_N_CAND PD1_S_CAND_L
pd0_puts 1 PD1_S_CLS_HDR
null_c = pd1_run_view 0 0 ulong 0 seed PD1_S_CAND_C
pd1_print_rel PD1_N_CAND PD1_S_CAND_C
pd1_run_rivals_and_score
bits = pd1_check_and_verdict null_l null_c
lat_part = int 0
if eq and bits 56 56
lat_part = 1
end
cls_part = int 0
if eq and bits 7 7
cls_part = 1
end
pd0_puts 1 PD1_S_CTRL_HDR
c1 = pd1_ctrl_ncp1 seed
c2 = pd1_ctrl_ncp2 seed
c3 = pd1_ctrl_ncp3 seed
c4 = pd1_ctrl_ncp4
c5 = pd1_ctrl_pos
ctrl_ok = int 0
if ne c1 0
if ne c2 0
if ne c3 0
if ne c4 0
if ne c5 0
ctrl_ok = 1
end
end
end
end
end
lat_ok_exp = int 0
if eq and bits 24 24
lat_ok_exp = 1
end
pd1_emit_law lat_ok_exp
pass = int 0
if ne ctrl_ok 0
if ne lat_part 0
if ne cls_part 0
pass = 1
end
end
end
pd1_print_verdict ctrl_ok lat_part cls_part pass
if ne pass 0
ret 0
end
ret 1
end

fn main to int
ac = argcnt
if lt ac long 3
pd0_puts 2 PD1_S_USAGE
ret 2
end
plen = ulong argread ulong 1 pd1_path ulong 0 ulong 1023
dlen = ulong argread ulong 2 pd1_dir ulong 0 ulong 900
put pd1_dir_len 0 dlen
seed = ulong 1
if gt ac long 3
slen = ulong argread ulong 3 pd1_arg ulong 0 ulong 63
seed = pd1_parse_u64 slen
end
if ne pd1_load plen 0
pd0_puts 1 PD1_S_REFUSED
ret 2
end
ret pd1_run_all seed
end

const PD1_S_COV_L ulong 14
const PD1_S_EMP_C ulong 15
const PD1_S_Q4_C ulong 16
const PD1_S_COV_C ulong 17
const PD1_S_NULL ulong 18
const PD1_S_TMP1 ulong 19
const PD1_S_TMP2 ulong 20
const PD1_S_REF ulong 21


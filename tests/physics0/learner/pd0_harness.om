fn ph_print_pd0l_part2 scored_slot ulong has_scored int to void
ob = new uchar 512 0
cbits = uint 0
csize = uint 0
if ne has_scored 0
cbits = vr_rel_bits scored_slot
csize = vr_rel_size scored_slot
end
fnr = long -1
snr = long -1
hid = int 0
if ne get ph_have_best 0 0
ci = get ph_best_ci 0
fnr = get p0l_c_fnrmse ci
snr = get p0l_c_snrmse ci
hid = get p0l_c_hid ci
end
p = pd0_buf_str edit ob ulong 0 ulong 512 PH_L12
p = pd0_buf_u64 edit ob p ulong 512 ulong csize
p = pd0_buf_str edit ob p ulong 512 PH_L13
p = pd0_buf_u64 edit ob p ulong 512 ulong cbits
p = pd0_buf_str edit ob p ulong 512 PH_L14
p = pd0_buf_u64 edit ob p ulong 512 ulong get lp_size_bound 0
p = pd0_buf_str edit ob p ulong 512 PH_L15
p = pd0_buf_i64 edit ob p ulong 512 fnr
p = pd0_buf_str edit ob p ulong 512 PH_L16
p = pd0_buf_i64 edit ob p ulong 512 snr
p = pd0_buf_str edit ob p ulong 512 PH_L17
p = pd0_buf_i64 edit ob p ulong 512 long hid
p = pd0_buf_str edit ob p ulong 512 PH_L18
sc = get sr_code 0
if eq has_scored 0
p = pd0_buf_str edit ob p ulong 512 PH_S_NOCAND
else
if eq sc 0
p = pd0_buf_str edit ob p ulong 512 PH_S_PASS
else
if lt sc 0
p = pd0_buf_str edit ob p ulong 512 PH_S_NOTSC
else
p = pd0_buf_str edit ob p ulong 512 PH_S_FAIL
end
end
end
pd0_put_bytes 1 view ob p
ret
end


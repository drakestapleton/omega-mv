p = pd0_buf_str edit ob p ulong 512 PH_L3
p = pd0_buf_u64 edit ob p ulong 512 get ph_n_ep 0
p = pd0_buf_str edit ob p ulong 512 PH_L4
p = pd0_buf_u64 edit ob p ulong 512 ulong get ph_steps_used 0
p = pd0_buf_str edit ob p ulong 512 PH_L5
p = pd0_buf_u64 edit ob p ulong 512 ulong p0l_n_transitions TAG_FIT
p = pd0_buf_str edit ob p ulong 512 PH_L6
p = pd0_buf_u64 edit ob p ulong 512 ulong p0l_n_transitions TAG_SELECT
p = pd0_buf_str edit ob p ulong 512 PH_L7
p = lad_buf_state_name edit ob p ulong 512 get lr_state 0

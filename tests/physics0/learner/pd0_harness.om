text PH_J6 ",\"score_code\":"
text PH_J7 ",\"score_mask\":"
text PH_J8 ",\"learner\":"
text PH_J9 "}\n"

fn ph_write_json_body fd int to void
rlen = p0l_report
chk = new uchar 4096 0
pos = ulong 0
while lt pos rlen bound 512
want = sub rlen pos
if gt want ulong 4096
want = ulong 4096
end
for i ulong want bound 4096
put chk i get p0l_rep_buf add pos i
end
ign = write fd chk 0 want
pos = add pos want
end
ign = write fd PH_J9 0 ulong 2
ret
end

fn ph_write_json path view uchar 1024 plen ulong to void
hdr = new uchar 512 0
fd = fopen path 0 plen int 577 int 420
if lt fd long 0
ret
end
p = pd0_buf_str edit hdr ulong 0 ulong 512 PH_J1
p = ph_buf_lvl edit hdr p ulong 512
p = pd0_buf_str edit hdr p ulong 512 PH_J2
p = pd0_buf_u64 edit hdr p ulong 512 get ph_seed 0
p = pd0_buf_str edit hdr p ulong 512 PH_J3
p = lad_buf_state_name edit hdr p ulong 512 get lr_state 0
p = pd0_buf_str edit hdr p ulong 512 PH_J4
p = pd0_buf_i64 edit hdr p ulong 512 long get lr_code 0
p = pd0_buf_str edit hdr p ulong 512 PH_J5
p = pd0_buf_u64 edit hdr p ulong 512 ulong get lr_n_refut 0
p = pd0_buf_str edit hdr p ulong 512 PH_J6
p = pd0_buf_i64 edit hdr p ulong 512 long get sr_code 0
p = pd0_buf_str edit hdr p ulong 512 PH_J7
p = pd0_buf_u64 edit hdr p ulong 512 ulong get sr_fail_mask 0
p = pd0_buf_str edit hdr p ulong 512 PH_J8
ign = write int fd hdr 0 p
ph_write_json_body int fd
ign2 = fclose int fd
ret
end

fn ph_write_files to void
path = new uchar 1024 0
pl = ph_build_path PH_EXT_LEDG edit path
ph_write_vledg view path pl
pl = ph_build_path PH_EXT_LAW edit path
ph_write_law view path pl
pl = ph_build_path PH_EXT_JSON edit path
ph_write_json view path pl
ret
end

fn ph_buf_hex32 dst edit uchar * pos ulong cap ulong v uint to ulong
if eq v uint 0
ret pd0_buf_ch dst pos cap uchar 48
end
tmp = new uchar 8 0
k = ulong 0
cur = v
while gt cur uint 0 bound 8
put tmp k get PH_HEX ulong and cur uint 15
k = add k ulong 1
cur = shr cur 4
end
for i ulong k bound 8
pos = pd0_buf_ch dst pos cap get tmp sub sub k ulong 1 i
end
ret pos
end


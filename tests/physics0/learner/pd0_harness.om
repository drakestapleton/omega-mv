fn ph_audit_print aok int valid int to void
ob = new uchar 512 0
p = pd0_buf_str edit ob ulong 0 ulong 512 PH_F1
p = ph_buf_lvl edit ob p ulong 512
p = pd0_buf_str edit ob p ulong 512 PH_F2
p = pd0_buf_u64 edit ob p ulong 512 get ph_seed 0
p = pd0_buf_str edit ob p ulong 512 PH_F3
for k ulong 32
b = get ph_fhash k
p = pd0_buf_ch edit ob p ulong 512 get PH_HEX ulong shr b 4
p = pd0_buf_ch edit ob p ulong 512 get PH_HEX ulong and b uchar 15
end
p = pd0_buf_str edit ob p ulong 512 PH_F4
p = pd0_buf_i64 edit ob p ulong 512 long get ph_fin_st 0
p = pd0_buf_str edit ob p ulong 512 PH_F5
p = pd0_buf_u64 edit ob p ulong 512 ulong get ph_aud_cnt 0
p = pd0_buf_str edit ob p ulong 512 PH_F6
p = pd0_buf_u64 edit ob p ulong 512 ulong get ph_aud_cnt 1
p = pd0_buf_str edit ob p ulong 512 PH_F7
p = pd0_buf_u64 edit ob p ulong 512 ulong get ph_aud_cnt 2
p = pd0_buf_str edit ob p ulong 512 PH_F8
p = pd0_buf_u64 edit ob p ulong 512 ulong get ph_aud_cnt 3
p = pd0_buf_str edit ob p ulong 512 PH_F9
p = pd0_buf_i64 edit ob p ulong 512 long aok
p = pd0_buf_str edit ob p ulong 512 PH_F10
if ne get ph_sealed 0 0
p = pd0_buf_str edit ob p ulong 512 PH_M_SEALED
else
p = pd0_buf_str edit ob p ulong 512 PH_M_PD0
end
p = pd0_buf_str edit ob p ulong 512 PH_F11
p = pd0_buf_i64 edit ob p ulong 512 long get ph_dims 3
p = pd0_buf_str edit ob p ulong 512 PH_F12
p = pd0_buf_i64 edit ob p ulong 512 long get ph_dims 0
p = pd0_buf_str edit ob p ulong 512 PH_F13
p = pd0_buf_i64 edit ob p ulong 512 long get ph_dims 1
p = pd0_buf_str edit ob p ulong 512 PH_F14
p = pd0_buf_i64 edit ob p ulong 512 long get ph_dims 2
p = pd0_buf_str edit ob p ulong 512 PH_F15
if ne valid 0
p = pd0_buf_str edit ob p ulong 512 PH_V_VALID
else
p = pd0_buf_str edit ob p ulong 512 PH_V_INVALID
end
p = pd0_buf_ch edit ob p ulong 512 uchar 10
pd0_put_bytes 1 view ob p
ret
end

fn ph_audit_stage to void
aq = new uchar 1 6
ar = new uchar 128 0
if eq get ph_ext 0 0
ret
end
arn = ph_world_call view aq ulong 1 edit ar ulong 128
aok = int 0
if eq arn ulong 57
m = int 1
for i ulong 8
if ne get ar i get PH_AUDT1 i
m = 0
end
end
if ne m 0
for i ulong 4
put ph_aud_cnt i pd0_get_u32 view ar add ulong 9 mul i ulong 4
end
if eq get ar 8 uchar 1
aok = 1
for k ulong 32
if ne get ar add ulong 25 k get ph_fhash k
aok = 0
end
end
end
end
end
put ph_aud_ok 0 aok
valid = int 1
if eq get ph_fin_ok 0 0
valid = 0
end
if eq aok 0
valid = 0
end
for i ulong 4
if ne get ph_aud_cnt i uint 0
valid = 0
end
end
ph_audit_print aok valid
ret
end

fn ph_read_args to int
if lt argcnt long 6
pd0_puts 2 PH_USAGE
ret 2
end
b = new uchar 512 0
n1 = argread 1 b 0 512
if le n1 long 0
ret 2
end
put ph_arg_wn 0 ulong n1
for i ulong ulong n1 bound 512
put ph_arg_w i get b i
end
n2 = argread 2 b 0 512
if le n2 long 0
ret 2
end
put ph_arg_tn 0 ulong n2
for i ulong ulong n2 bound 512
put ph_arg_t i get b i
end
n3 = argread 3 b 0 32
if le n3 long 0
ret 2
end
put ph_arg_ln 0 ulong n3
for i ulong ulong n3 bound 32
put ph_arg_l i get b i
end
if ne ph_streq view b ulong n3 PH_NULL 0
put ph_level 0 -1
else
put ph_level 0 int ph_parse_u64 view b ulong n3
end
n4 = argread 4 b 0 32
if le n4 long 0
ret 2
end
put ph_arg_sn 0 ulong n4
for i ulong ulong n4 bound 32
put ph_arg_s i get b i
end
put ph_seed 0 ph_parse_u64 view b ulong n4
n5 = argread 5 b 0 512
if le n5 long 0
ret 2
end
put ph_arg_on 0 ulong n5
for i ulong ulong n5 bound 512
put ph_arg_o i get b i
end
if and eq ulong n2 ulong 1 eq get ph_arg_t 0 uchar 45
put ph_ext 0 1
else
put ph_ext 0 0
end
ret 0
end

fn ph_pub_sstar lvl int to int
if eq lvl 0
ret 2
end
if eq lvl 1
ret 3
end
if eq lvl 2
ret 4
end
if eq lvl 3
ret 8
end
if eq lvl 4
ret 4
end
if eq lvl 5
ret 4
end
if eq lvl 6
ret 7
end
ret 0
end

fn ph_init_world to int
if ne ph_spawn 0 0
ret 3
end
if eq get ph_ext 0 0
if ne ph_spawn 1 0
ret 3
end
end
req = new uchar 1 0
resp = new uchar 1024 0
rn = ph_world_call view req ulong 1 edit resp ulong 1024
if or eq rn ulong 0 ne ph_parse_desc view resp rn 0
ret 3
end
put ph_sealed 0 ph_check_sealed
if ne get ph_ext 0 0
if ne ph_ext_rel 0
ret 3
end
put ph_dims 0 int get vr_nvars PH_TRUTH_SLOT
put ph_dims 1 int get vr_nlat PH_TRUTH_SLOT
put ph_dims 2 int get vr_nch PH_TRUTH_SLOT
put ph_dims 3 get ph_truth_size 0
put ph_have_truth 0 0
put ph_dims_ok 0 1
if eq get ph_sealed 0 0
lvl = get ph_level 0
if and ge lvl 0 lt lvl 8
if ne get ph_truth_size 0 ph_pub_sstar lvl
put ph_dims_ok 0 0
end
end
end
else
if ne ph_truth_rel 0
ret 3
end
end
ret 0
end

fn ph_cleanup to void
if eq get ph_ext 0 0
ign = ph_wr_full get ph_t_out 0 PH_QUIT_CMD ulong 5
ign2 = fclose get ph_t_out 0
ign3 = fclose get ph_t_in 0
end
ign4 = fclose get ph_w_out 0
ign5 = fclose get ph_w_in 0
st = new uchar 4 0
ign6 = waitpid get ph_w_pid 0 st 0 ulong 4 0
if eq get ph_ext 0 0
ign7 = waitpid get ph_t_pid 0 st 0 ulong 4 0
end
ret
end

fn main to int
rc = ph_read_args
if ne rc 0
ret rc
end
rc = ph_init_world
if ne rc 0
ret rc
end
ph_setup_ladder_params
ph_explore_stage
ph_trials_stage
ph_rep_stage
ph_emit_law_stage
scored_slot = ulong 0
has_scored = int 0
if ne get lr_have_cand 0 0
scored_slot = LR_CAND_SLOT
has_scored = 1
else
if ne get ph_have_best 0 0
scored_slot = add P0L_CAND_BASE get ph_best_ci 0
has_scored = 1
end
end
ph_ext_final_stage scored_slot has_scored
ph_score_stage scored_slot has_scored
ph_write_files
ph_print_pd0l_part1
ph_print_pd0l_part2 scored_slot has_scored
ph_print_pd0l_part3
ph_print_pd0l_part4
ph_audit_stage
ph_cleanup
ret 0
end

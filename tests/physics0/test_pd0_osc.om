note SPDX-License-Identifier: Apache-2.0
note tests/physics0/test_pd0_osc.om: Pure OM-2 differential verification of pd0_helpers.osc arithmetic.
note Prints PHYSICS0_OSC_DIFF: PASS|FAIL.

text OSC_TAG "osc-diff"
text OSC_P1 "osc differential: runs="
text OSC_P2 " mismatches="
text OSC_P3 " native=om2\n"
text OSC_PASS "PHYSICS0_OSC_DIFF: PASS\n"
text OSC_FAIL "PHYSICS0_OSC_DIFF: FAIL\n"

fn osc_const_draw lo long hi long uu long to long
ret add lo pd0_mul sub hi lo uu
end

fn osc_noise_map u1 long u2 long u3 long u4 long sigma long to long
s = sub add add u1 u2 add u3 u4 long 2000000
ret div mul s sigma PD0_IH_SD
end

fn osc_l0_s0 s0 long s1 long to long
ret add s0 s1
end

fn osc_l0_s1 s1 long u long to long
ret add s1 u
end

fn osc_l1_s0 s0 long s1 long dt long to long
ret add s0 pd0_mul s1 dt
end

fn osc_l1_s1 s0 long s1 long u long k long dt long to long
ret add s1 pd0_mul add neg pd0_mul k s0 u dt
end

fn osc_l2_s1 s0 long s1 long u long k long c long dt long to long
ret add s1 pd0_mul add sub neg pd0_mul k s0 pd0_mul c s1 u dt
end

fn osc_cube s0 long to long
ret pd0_mul pd0_mul s0 s0 s0
end

fn osc_desc_bits nv ulong nc ulong nt ulong nl ulong to uint
ret add mul uint 8 uint nl mul add mul uint 8 uint add nv nc uint 24 uint nt
end

fn osc_iter_dyn rng edit ulong 1 to ulong
mism = ulong 0
dt = long 50000
s0 = pd0_const rng neg PD0_BOUND PD0_BOUND
s1 = pd0_const rng neg PD0_BOUND PD0_BOUND
u = pd0_const rng long -2000000 long 2000000
k = pd0_const rng long 0 long 9000000
c = pd0_const rng long 0 long 2000000
if ne osc_l0_s0 s0 s1 add s0 s1
mism = add mism 1
end
if ne osc_l0_s1 s1 u add s1 u
mism = add mism 1
end
if ne osc_l1_s0 s0 s1 dt add s0 pd0_mul s1 dt
mism = add mism 1
end
if ne osc_l1_s1 s0 s1 u k dt add s1 pd0_mul add neg pd0_mul k s0 u dt
mism = add mism 1
end
if ne osc_l2_s1 s0 s1 u k c dt add s1 pd0_mul add sub neg pd0_mul k s0 pd0_mul c s1 u dt
mism = add mism 1
end
if ne osc_cube s0 pd0_mul pd0_mul s0 s0 s0
mism = add mism 1
end
ret mism
end

fn osc_iter_bits rng edit ulong 1 to ulong
nv = add ulong 1 rem pd0_splitmix64 rng ulong 4
nl = rem pd0_splitmix64 rng ulong 2
if ge nl nv
nl = ulong 0
end
nc = add ulong 1 rem pd0_splitmix64 rng ulong 2
nt = rem pd0_splitmix64 rng ulong 6
p0r_clear ulong 0
put p0r_nvars 0 uchar nv
put p0r_nlat 0 uchar nl
put p0r_nch 0 uchar nc
put p0r_neq 0 uchar 1
put p0r_eq_nt p0r_eq_idx 0 0 uchar nt
if ne osc_desc_bits nv nc nt nl pd0_relation_description_bits ulong 0
ret ulong 1
end
ret ulong 0
end

fn osc_iter_rng rng edit ulong 1 to ulong
mism = ulong 0
r1 = new ulong 1 0
lo = pd0_const rng long -5000000 long 5000000
hi = add lo pd0_const rng long 0 long 9000000
uu = pd0_uniform rng
if ne osc_const_draw lo hi uu add lo pd0_mul sub hi lo uu
mism = add mism 1
end
sigma = pd0_const rng long 0 long 500000
put r1 0 get rng 0
want = pd0_noise edit r1 sigma
u1 = pd0_uniform rng
u2 = pd0_uniform rng
u3 = pd0_uniform rng
u4 = pd0_uniform rng
if ne osc_noise_map u1 u2 u3 u4 sigma want
mism = add mism 1
end
ret add mism osc_iter_bits rng
end

fn main to int
iters = ulong 20000
rng = new ulong 1 0
pd0_stream edit rng ulong 0x9d0 OSC_TAG
mism = ulong 0
runs = ulong 0
for it ulong iters bound 25000
mism = add mism osc_iter_dyn edit rng
mism = add mism osc_iter_rng edit rng
runs = add runs ulong 10
end
obuf = new uchar 128 0
p = pd0_buf_str edit obuf ulong 0 ulong 128 OSC_P1
p = pd0_buf_u64 edit obuf p ulong 128 runs
p = pd0_buf_str edit obuf p ulong 128 OSC_P2
p = pd0_buf_u64 edit obuf p ulong 128 mism
p = pd0_buf_str edit obuf p ulong 128 OSC_P3
pd0_put_bytes 1 view obuf p
if eq mism ulong 0
pd0_puts 1 OSC_PASS
ret 0
end
pd0_puts 1 OSC_FAIL
ret 1
end

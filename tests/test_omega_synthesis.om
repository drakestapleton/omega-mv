note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_synthesis.om against C oracle.
om2

text g_sig_mul2 "39cfffec6368c048f40c02006d6654fc5c7db2787ffb0ea05b3f9bec5a56c643"
text g_aff_id "7004502c62e5c2e0041c225869eb90d45ef5a54e8f1f35dad580773055c5739d"
text g_comp_id "3af4370f1ffd5243a688f53f6e7e5babc6130be3ab109e376bd780a45fe74293"

text msg_pass "OMEGA_SYNTHESIS_OM_PASS\n"
text msg_fail "OMEGA_SYNTHESIS_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex buf view uchar * n ulong gold view uchar * to void
  for i ulong n bound 64
    b = uint get buf i
    chk eq sh_hexd shr b 4 get gold mul i 2
    chk eq sh_hexd and b 15 get gold add mul i 2 1
  end
end

fn main to int
  note Check bank init & signature parity for mul_2 (index 8)
  chk eq omega_synth_bank_init 0
  chk eq get g_syn_bank_cnt 0 15
  sig = new uchar 32 0
  chk eq omega_synth_compute_signature 8 sig 0
  chk_hex sig 32 g_sig_mul2

  note Equiv table pruning & lower-cost replacement
  omega_synth_equiv_init
  chk not omega_synth_equiv_contains_or_add sig 5
  chk omega_synth_equiv_contains_or_add sig 5
  chk omega_synth_equiv_contains_or_add sig 7
  chk not omega_synth_equiv_contains_or_add sig 3
  chk omega_synth_equiv_contains_or_add sig 4
  omega_synth_bank_destroy
  chk eq get g_syn_bank_cnt 0 0

  note Trace hook + Affine 2x+1 synthesis (exact stats & solution ID)
  chk eq omega_synth_set_trace_hook 1 99 0
  chk eq omega_synthesize_target_affine 0
  chk eq get g_syn_solved 0 1
  chk eq get g_syn_gen 0 136
  chk eq get g_syn_pruned_equiv 0 58
  chk eq get g_syn_failed_v1 0 77
  chk eq get g_syn_sol_found 0 1
  chk gt get g_syn_hook_events 0 0
  sol_id = new uchar 32 0
  sb = mul SYNTH_SLOT_SOL 32
  for i ulong 32
    put sol_id i get g_prog_id add sb i
  end
  chk_hex sol_id 32 g_aff_id
  chk eq omega_synth_clear_trace_hook 99 0

  note Composed 3x-2 synthesis (exact stats & solution ID)
  chk eq omega_synthesize_target_composed 0
  chk eq get g_syn_solved 0 1
  chk eq get g_syn_gen 0 156
  chk eq get g_syn_pruned_equiv 0 64
  chk eq get g_syn_failed_v1 0 91
  chk eq get g_syn_sol_found 0 1
  for i ulong 32
    put sol_id i get g_prog_id add sb i
  end
  chk_hex sol_id 32 g_comp_id

  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note
note tests/dual/test_dual_bind.om -- DUAL-0b binding and classification tests in pure seeded OM-2.
note Replaces tests/dual/test_dual_bind.c.
note Built by concatenating src/dual/rx_dual.om + tests/dual/test_dual_bind.om.

text t_str_0 "FAIL test_dual_bind check="
text t_str_1 "\n"
text t_str_2 "test_dual_bind: "
text t_str_3 " checks, "
text t_str_4 " failures: PASS\n"
text t_str_5 " failures: FAIL\n"
global g_chk ulong 1
global g_fl ulong 1
global g_out uchar 256

fn t_pr_txt s view uchar * to void
  n = len s
  for i ulong n
    put g_out i get s i
  end
  _w = write 1 g_out 0 n
end

fn t_pr_u64 v ulong to void
  if eq v 0
    put g_out 0 uchar 48
    _w = write 1 g_out 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_out n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_out i
    put g_out i get g_out j
    put g_out j tmp
    i = add i 1
  end
  _w = write 1 g_out 0 n
end

fn chk ok bool id ulong to void
  put g_chk 0 add get g_chk 0 1
  if not ok
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn chk_st got long want long id ulong to void
  put g_chk 0 add get g_chk 0 1
  if ne got want
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn fx_model s ulong u ulong to void
  put g_dm_n s 1
  put g_dm_m s 1
  put g_dm_ek s 1
  put g_dm_mn s 1
  put g_dm_su mul s 8 u
  put g_dm_ou mul s 8 u
  bo = mul s 64
  put g_dm_F bo 1.0
  put g_dm_Q bo 0.01
  put g_dm_H bo 1.0
  put g_dm_R bo 0.04
  put g_dm_st s 1000
end

fn fx_obs s ulong u ulong z f64 vr f64 sq ulong to void
  put g_do_m s 1
  put g_do_u mul s 8 u
  put g_do_z mul s 8 z
  put g_do_R mul s 64 vr
  put g_do_tn s mul long sq 1000
  put g_do_sq s sq
  dl_dg_fill add 13504 mul s 32 uchar 0x5a
  dl_dg_fill add 13568 mul s 32 uchar add 0xe1 and sq 255
end

fn fx_belief bs ulong ms ulong os ulong u ulong x f64 vr f64 to void
  put g_db_n bs 1
  put g_db_u mul bs 8 u
  put g_db_x mul bs 8 x
  put g_db_P mul bs 64 vr
  off = mul bs 32
  _dm = de_digest_model ms add 13632 off
  dl_dg_fill add 13696 off uchar 0x77
  _do = de_digest_obs os ulong 480
  _de = de_evroot_extend ulong 0 ulong 480
  dl_dg_cp add 13760 off ulong 896
end

fn fx_ctl s ulong id ulong eta f64 rho f64 ks f64 lmax f64 to void
  put g_ct_eta s eta
  put g_ct_rho s rho
  put g_ct_ks s ks
  put g_ct_age s 4
  put g_ct_cad s 1
  put g_ct_n s 1
  bo = mul s 32
  put g_ct_rid bo id
  put g_ct_lm bo lmax
end

fn fx_input ins ulong x f64 sd f64 gen ulong cal ulong to void
  dl_in_clr ins
  off = mul ins 32
  dl_dg_fill add 12992 off uchar add 0x30 and gen 0x3f
  put g_in_ek ins DL_EK_EST
  put g_in_u ins DL_U_BYTES
  put g_in_est ins x
  put g_in_unc ins sd
  put g_in_gen ins gen
  dl_dg_fill add 13248 off uchar 0x66
  put g_in_evv ins 1
  if ne cal 0
    dl_dg_fill add 13376 off uchar 0x44
  end
end

fn test_units to void
  chk eq dl_unit_from_est 6 DL_U_BYTES 100
  chk eq dl_unit_from_est 5 DL_U_NS 101
  chk eq dl_unit_from_est 3 DL_U_WATT 102
  chk eq dl_unit_from_est 8 DL_U_LOG2PS 103
  chk eq dl_unit_from_est 0 DL_U_NONE 104
  chk eq dl_unit_from_est 9 DL_U_NONE 105
  chk eq dl_unit_from_est 77 DL_U_NONE 106
end

fn test_bind_belief to void
  fx_model 0 6
  fx_obs 0 6 5200.0 100.0 1
  dl_dg_clr ulong 0
  dl_dg_fill ulong 32 uchar 0x44
  fx_belief 0 0 0 6 5150.0 64.0
  put g_db_gn 0 7
  put g_db_tn 0 7000
  chk_st de_check_belief 0 0 200
  chk_st dl_bind_belief 0 0 1 1 0 DL_OK 201
  chk and eq get g_in_est 0 5150.0 and eq get g_in_unc 0 8.0 and eq get g_in_u 0 DL_U_BYTES eq get g_in_gen 0 7 202
  chk and eq get g_in_ek 0 DL_EK_EST and eq get g_in_evv 0 0 eq dl_dg_is_zero ulong 13120 1 203
  _db = de_digest_belief 0 ulong 64
  chk eq dl_dg_eq ulong 64 ulong 12992 1 204
  chk eq dl_dg_eq ulong 13248 ulong 13760 1 205
  chk_st dl_verify_belief_ev 0 0 0 0 DL_OK 206
  chk eq get g_in_evv 0 1 207
  note broken evidence root
  b0 = get g_dig ulong 13763
  put g_dig ulong 13763 uchar xor ulong b0 1
  chk_st dl_bind_belief 0 0 1 1 1 DL_OK 208
  chk_st dl_verify_belief_ev 0 0 0 1 DL_E_EVID 209
  chk eq get g_in_evv 1 0 210
  put g_dig ulong 13763 b0
  note wrong obs
  fx_obs 1 6 5200.0 100.0 2
  chk_st dl_bind_belief 0 0 1 1 1 DL_OK 211
  chk_st dl_verify_belief_ev 0 0 1 1 DL_E_EVID 212
  note wrong parent root
  dl_dg_fill ulong 96 uchar 0x99
  chk_st dl_bind_belief 0 0 1 1 1 DL_OK 213
  chk_st dl_verify_belief_ev 0 3 0 1 DL_E_EVID 214
  note input not bound from belief
  fx_input 1 1.0 1.0 7 1
  chk_st dl_verify_belief_ev 0 0 0 1 DL_E_DIG 215
  note refusals
  chk_st dl_bind_belief 0 1 1 1 0 DL_E_RANGE 216
  put g_db_gn 0 0
  dl_dg_clr ulong 13696
  dl_dg_clr ulong 13760
  chk_st de_check_belief 0 0 217
  chk_st dl_bind_belief 0 0 1 1 0 DL_E_EVID 218
  fx_belief 0 0 0 6 5150.0 64.0
  put g_db_gn 0 7
  put g_db_x 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_bind_belief 0 0 1 1 0 DL_E_KIND 219
  put g_db_x 0 5150.0
  put g_db_u 0 0
  chk ne dl_bind_belief 0 0 1 1 0 DL_OK 220
  put g_db_u 0 6
  chk_st dl_bind_belief 0 0 0 0 0 DL_OK 221
  chk eq dl_dg_is_zero ulong 13376 1 222
end

fn test_bind_pred_obs to void
  fx_model 0 5
  fx_obs 0 5 10.0 1.0 1
  dl_dg_clr ulong 0
  fx_belief 0 0 0 5 10.0 1.0
  put g_db_gn 0 3
  put g_db_tn 0 3000
  _d1 = de_digest_belief 0 ulong 13824
  _d2 = de_digest_model 0 ulong 13888
  put g_dp_hz 0 2
  put g_dp_gn 0 5
  put g_dp_tn 0 5000
  put g_dp_n 0 1
  put g_dp_m 0 1
  put g_dp_hc 0 0
  put g_dp_x 0 12.0
  put g_dp_P 0 2.25
  put g_dp_ym 0 12.0
  put g_dp_S 0 2.29
  chk_st de_check_pred 0 0 300
  chk_st dl_bind_prediction 0 0 0 0 99 0 DL_OK 301
  chk and eq get g_in_est 0 12.0 eq get g_in_unc 0 1.5 302
  chk and eq get g_in_u 0 DL_U_NS and eq get g_in_gen 0 5 eq get g_in_ek 0 DL_EK_PRED 302
  _d3 = de_digest_pred 0 ulong 64
  chk eq dl_dg_eq ulong 64 ulong 12992 1 303
  chk eq dl_dg_eq ulong 13248 ulong 13760 1 304
  fx_model 1 5
  put g_dm_Q 64 0.02
  chk_st dl_bind_prediction 0 1 0 0 99 0 DL_E_DIG 305
  fx_belief 1 0 0 5 11.0 1.0
  put g_db_gn 1 3
  put g_db_tn 1 3000
  chk_st dl_bind_prediction 0 0 1 0 99 0 DL_E_DIG 306
  chk_st dl_bind_prediction 0 0 0 1 99 0 DL_E_RANGE 307
  chk_st dl_bind_obs 0 0 9 0 0 0 DL_OK 308
  chk and eq get g_in_ek 0 DL_EK_MEAS eq get g_in_est 0 10.0 309
  chk and eq get g_in_unc 0 1.0 eq get g_in_gen 0 9 309
  chk and eq dl_dg_eq ulong 12992 ulong 13120 1 eq get g_in_evv 0 1 310
  chk eq dl_dg_eq ulong 13248 ulong 13568 1 311
  dl_dg_clr ulong 13568
  chk_st dl_bind_obs 0 0 9 0 0 0 DL_E_KIND 312
  fx_obs 0 5 10.0 1.0 1
  chk_st dl_bind_obs 0 3 9 0 0 0 DL_E_RANGE 313
end

fn test_classify to void
  fx_ctl 0 1 0.1 0.01 2.0 10.0
  fx_input 0 5200.0 100.0 10 1
  put g_cs_id 0 1
  put g_cs_u 0 DL_U_BYTES
  put g_cs_cls 0 DL_CLS_SOFT
  put g_cs_bgt 0 5000.0
  dl_dg_fill ulong 2304 uchar 0x22
  dl_dg_clr ulong 2560
  dl_dg_fill ulong 2816 uchar 0x33
  put g_cs_ek 0 DL_EK_EST
  put g_cs_est 0 5000.0
  put g_cs_unc 0 100.0
  dl_dg_fill ulong 3072 uchar 0x44
  put g_cs_lam 0 0.0
  put g_cs_ls 0 DL_LS_FRESH
  dl_dg_fill ulong 3328 uchar 0x55
  put g_cs_gen 0 9
  put g_cs_tk 0 0
  dl_dg_fill ulong 3584 uchar 0x66
  dl_dg_clr ulong 3840
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 400
  chk eq get g_dws 3 DL_LS_FRESH 401
  chk_st dl_classify_input 0 0 0 0 10 DL_OK 402
  chk eq get g_dws 3 DL_LS_FRESH 403
  dl_dg_clr ulong 13376
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 404
  chk eq get g_dws 3 DL_LS_UNCAL 405
  fx_input 0 5200.0 100.0 10 1
  put g_in_reg 0 1
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 406
  chk eq get g_dws 3 DL_LS_FROZEN 407
  put g_in_reg 0 0
  put g_in_evv 0 0
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 408
  chk eq get g_dws 3 DL_LS_STALE 409
  put g_in_evv 0 1
  chk_st dl_classify_input 0 1 0 0 14 DL_OK 410
  chk eq get g_dws 3 DL_LS_FRESH 411
  chk_st dl_classify_input 0 1 0 0 15 DL_OK 412
  chk eq get g_dws 3 DL_LS_STALE 413
  put g_in_gen 0 8
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 414
  chk eq get g_dws 3 DL_LS_STALE 415
  put g_in_gen 0 11
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 416
  chk eq get g_dws 3 DL_LS_REFUSED 417
  put g_in_gen 0 10
  put g_in_est 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 418
  chk eq get g_dws 3 DL_LS_REFUSED 419
  put g_in_est 0 bitcast f64 ulong 0x7ff0000000000000
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 420
  chk eq get g_dws 3 DL_LS_REFUSED 421
  put g_in_est 0 5200.0
  put g_in_unc 0 -1.0
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 422
  chk eq get g_dws 3 DL_LS_REFUSED 423
  put g_in_unc 0 100.0
  dl_dg_clr ulong 13248
  chk_st dl_classify_input 0 1 0 0 10 DL_OK 424
  chk eq get g_dws 3 DL_LS_REFUSED 425
  fx_input 0 5200.0 100.0 10 1
  put g_in_u 0 DL_U_NS
  chk_st dl_classify_input 0 1 0 0 10 DL_E_UNIT 426
  put g_in_u 0 DL_U_BYTES
  put g_cs_cls 0 DL_CLS_INV
  chk_st dl_classify_input 0 1 0 0 10 DL_E_CLASS 427
  put g_cs_cls 0 DL_CLS_SOFT
  put g_ct_age 0 0
  chk_st dl_classify_input 0 1 0 0 10 DL_E_RANGE 428
  dl_dg_clr ulong 0
  dl_dg_fill ulong 32 uchar 0x33
  chk_st dl_ev_extend ulong 0 ulong 32 DL_OK 429
  dl_dg_cp ulong 64 ulong 896
  chk_st dl_ev_extend ulong 64 ulong 32 DL_OK 430
  dl_dg_cp ulong 96 ulong 896
  chk_st dl_ev_extend ulong 0 ulong 32 DL_OK 431
  dl_dg_cp ulong 128 ulong 896
  chk and eq dl_dg_is_zero ulong 64 0 and eq dl_dg_eq ulong 64 ulong 96 0 eq dl_dg_eq ulong 64 ulong 128 1 432
  chk_st dl_ev_extend ulong 0 ulong 0 DL_E_DIG 433
end

fn main to long
  test_units
  test_bind_belief
  test_bind_pred_obs
  test_classify
  t_pr_txt t_str_2
  t_pr_u64 get g_chk 0
  t_pr_txt t_str_3
  t_pr_u64 get g_fl 0
  if eq get g_fl 0 0
    t_pr_txt t_str_4
    ret 0
  end
  t_pr_txt t_str_5
  ret 1
end

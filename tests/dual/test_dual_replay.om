note
note tests/dual/test_dual_replay.om -- DUAL-1b replay, pre-registered measures,
note frozen golden digests, hostile negative control, and recorded R15 CSV traces
note in pure seeded OM-2.
note Replaces tests/dual/test_dual_replay.c and tests/dual/dual_traces.{c,h}.
note Built by concatenating src/dual/rx_dual.om + tests/dual/test_dual_replay.om.

const TR_N ulong 200
const TR_BUDGET f64 5000.0
const TR_SCALE f64 1000.0
const TR_SD f64 100.0

text t_gold_tr2 "f9c3944ab952dd5e2beefebbb2499f98ec7be28157b571a47e406ca40e4d93fb"
text t_gold_rp2 "46345146d1213fdd2888fd0ace3f7ab31287565fd42adf950ad58edeb11bf5ae"
text t_gold_tr4 "0a463faef33ab2a59da6c854eabfa2ec9e189f3e5e6b00f07c773e490e52edd5"
text t_gold_rp4 "64a30ce77dc7decfedae15c6c8e8e66fa75693df049916deab7ca2abbfaaa888"

text t_str_0 "FAIL test_dual_replay check="
text t_str_1 "\n"

text t_str_15 "# c\n\n1.0,CPU0,5,,armv8_pmuv3_0/cycles/,1,100.00,,\n1.0,CPU0,7,,x/cycles/,1,100.00,,\n2.0,CPU0,9,,armv8_pmuv3_0/cycles/,1,100.00,,"
text t_str_16 "NOTE every replayed price above is UNCALIBRATED (EST-3 has not passed for any signal); none may influence production.\n"
text t_str_17 "GATE DUAL_PRICE_REFERENCE = PASS (reference measures all pass, negative control failed as declared)\n"
text t_str_18 "GATE DUAL_PRICE_REFERENCE = FAIL\n"

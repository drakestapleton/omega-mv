text t_str_21 " failures: PASS\n"
text t_str_22 " failures: FAIL\n"
text t_fn_m "machine-perf.csv"
text t_fn_p "preflight-perf.csv"
global g_chk ulong 1
global g_fl ulong 1
global g_ref_fl ulong 1
global g_neg_ok ulong 1
global g_out uchar 256
global g_hex uchar 64
global g_path uchar 512
global g_raw_hex uchar 64

fn t_pr_txt s view uchar * to void
  n = len s
  for i ulong n
    put g_out i get s i
  end
  _w = write 1 g_out 0 n
end

fn t_pr_u64 v ulong to void
  if eq v 0
    put g_out 0 uchar 48
    _w = write 1 g_out 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_out n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_out i
    put g_out i get g_out j
    put g_out j tmp
    i = add i 1
  end
  _w = write 1 g_out 0 n
end

fn chk ok bool id ulong to void
  put g_chk 0 add get g_chk 0 1
  if not ok
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn chk_st got long want long id ulong to void
  put g_chk 0 add get g_chk 0 1
  if ne got want
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn hex_nib v ulong to uchar
  if lt v 10
    ret uchar add 48 v
  end
  ret uchar add 87 v
end

fn to_hex off ulong to void
  for i ulong 32
    b = ulong get g_dig add off i
    put g_hex mul i 2 hex_nib shr b 4
    put g_hex add mul i 2 1 hex_nib and b 15
  end
end

fn to_raw_hex off ulong to void
  for i ulong 32
    b = ulong get g_dig add off i
    put g_raw_hex mul i 2 hex_nib shr b 4
    put g_raw_hex add mul i 2 1 hex_nib and b 15
  end
end

fn hex_eq_txt want view uchar * to bool
  if ne len want 64
    ret false
  end
  for i ulong 64
    if ne get g_hex i get want i
      ret false
    end
  end
  ret true
end

fn measure pass bool is_ref ulong id ulong to void
  if ne is_ref 0
    chk pass id
    if not pass
      put g_ref_fl 0 1
    end
  end
end

fn fx_ctl s ulong id ulong eta f64 rho f64 ks f64 lmax f64 to void
  put g_ct_eta s eta
  put g_ct_rho s rho
  put g_ct_ks s ks
  put g_ct_age s 4
  put g_ct_cad s 1
  put g_ct_n s 1
  bo = mul s 32
  put g_ct_rid bo id
  put g_ct_lm bo lmax
end

fn fx_res s ulong id ulong u ulong sc f64 to void
  put g_rs_id s id
  put g_rs_u s u
  put g_rs_sc s sc
  dl_dg_fill add 1024 mul s 32 uchar 0x11
end

fn tr_set_tick tr ulong i ulong gen ulong est f64 sd f64 to void
  idx = add mul tr DL_TR_MAX_TICKS i
  put g_tr_gn idx gen
  put g_tr_es idx est
  put g_tr_un idx sd
  put g_tr_cl idx 0
  put g_tr_ev idx 1
  put g_tr_rg idx 0
end

fn tr_const tr ulong kind ulong sd_val ulong n ulong gen0 ulong est f64 to long
  put g_tr_k tr kind
  put g_tr_sd tr sd_val
  put g_tr_n tr n
  for i ulong n
    tr_set_tick tr i add gen0 i est TR_SD
  end
  ret dl_check_trace tr
end

fn tr_scenario_2 sc ulong r ulong tr ulong to long
  if eq sc 8
    put g_tr_k tr 8
    put g_tr_sd tr 0x1008
    put g_tr_n tr TR_N
    bo = mul tr DL_TR_MAX_TICKS
    for i ulong TR_N
      tr_set_tick tr i add i 1 5500.0 TR_SD
      if and ge i 80 lt i 120
        put g_tr_rg add bo i 1
      end
    end
    ret dl_check_trace tr
  end
  if eq sc 9
    put g_tr_k tr 9
    put g_tr_sd tr 0x1009
    put g_tr_n tr TR_N
    put g_xs 0 0x1009
    for i ulong TR_N
      est = f64 4200.0
      br = eq and dl_xorshift64s 7 0
      amp = add 800.0 mul 1600.0 dl_xorshift_unit
      if br
        est = add est amp
      end
      tr_set_tick tr i add i 1 est TR_SD
    end
    ret dl_check_trace tr
  end
  if eq sc 10
    if ge r DL_MAX_RES
      ret DL_E_RANGE
    end
    put g_xs 0 add 0x100a r
    off = add -50.0 mul 100.0 dl_xorshift_unit
    ret tr_const tr 10 add 0x100a r TR_N 1 add 5500.0 off
  end
  if eq sc 11
    put g_tr_k tr 11
    put g_tr_sd tr 0x100b
    put g_tr_n tr TR_N
    for i ulong TR_N
      est = add 3000.0 div mul 4000.0 f64 i 199.0
      tr_set_tick tr i add i 1 est TR_SD
    end
    ret dl_check_trace tr
  end
  if eq sc 12
    put g_tr_k tr 12
    put g_tr_sd tr 0x100c
    put g_tr_n tr TR_N
    for i ulong TR_N
      est = f64 5000.0
      if lt i 100
        est = f64 6000.0
      end
      tr_set_tick tr i add i 1 est TR_SD
    end
    ret dl_check_trace tr
  end
  ret DL_E_RANGE
end

fn tr_scenario sc ulong pt ulong r ulong tr ulong to long
  if eq sc 1
    ret tr_const tr 1 0x1001 TR_N 1 4000.0
  end
  if eq sc 2
    ret tr_const tr 2 0x1002 TR_N 1 5500.0
  end
  if eq sc 3
    put g_tr_k tr 3
    put g_tr_sd tr 0x1003
    put g_tr_n tr TR_N
    for i ulong TR_N
      est = f64 6000.0
      if lt i 100
        est = f64 4000.0
      end
      tr_set_tick tr i add i 1 est TR_SD
    end
    ret dl_check_trace tr
  end
  if eq sc 4
    put g_tr_k tr 4
    put g_tr_sd tr 0x1004
    put g_tr_n tr TR_N
    for i ulong TR_N
      est = f64 4000.0
      if lt rem i 50 25
        est = f64 6000.0
      end
      tr_set_tick tr i add i 1 est TR_SD
    end
    ret dl_check_trace tr
  end
  if eq sc 5
    put g_tr_k tr 5
    put g_tr_sd tr 0x1005
    put g_tr_n tr TR_N
    for i ulong TR_N
      tr_set_tick tr i add i 1 6000.0 50.0
    end
    ret dl_check_trace tr
  end
  if eq sc 6
    put g_tr_k tr 6
    put g_tr_sd tr 0x1005
    put g_tr_n tr TR_N
    for i ulong TR_N
      tr_set_tick tr i add i 1 4900.0 50.0
    end
    ret dl_check_trace tr
  end
  if eq sc 7
    if eq pt 65
      ret tr_const tr 7 0x1007 100 1 4500.0
    end
    if eq pt 66
      ret tr_const tr 7 0x1007 100 101 4500.0
    end
    ret DL_E_RANGE
  end
  ret tr_scenario_2 sc r tr
end

fn run_rp tr ulong ctl ulong rs ulong bgt f64 bc_s ulong rp ulong to long
  put g_rp_cfg 0 DL_CLS_SOFT
  put g_rp_cfg 1 bc_s
  put g_rp_cfg 2 0
  put g_rp_cfg 3 0
  put g_rp_bgt 0 bgt
  ret dl_replay_run tr ctl rs rp
end

fn cm_m1_m7 tr ulong rp ulong lmax f64 to void
  nt = get g_rp_n rp
  rbo = mul rp DL_TR_MAX_TICKS
  tbo = mul tr DL_TR_MAX_TICKS
  ok1 = true
  for i ulong nt
    lv = get g_rp_lm add rbo i
    if not dl_fin lv
      ok1 = false
    end
    if lt lv 0.0
      ok1 = false
    end
    if gt lv lmax
      ok1 = false
    end
  end
  measure ok1 1 11
  ok7 = true
  for i ulong nt
    ls = get g_rp_ls add rbo i
    if eq get g_tr_cl add tbo i 0
      want = DL_LS_UNCAL
      if ne get g_tr_rg add tbo i 0
        want = DL_LS_FROZEN
      end
      if ne ls want
        ok7 = false
      end
    end
    if eq ls DL_LS_FRESH
      ok7 = false
    end
  end
  measure ok7 1 12
  rl = dl_reversals 0 rbo 0 nt
  for i ulong nt
    put g_est_arr i get g_tr_es add tbo i
  end
  re = dl_reversals 1 0 0 nt
  measure le rl add re 1 1 13
end

fn common_measures tr ulong ctl ulong rs ulong bgt f64 bc_s ulong rp ulong to void
  chk_st dl_ctl_lambda_max ctl get g_rs_id rs DL_OK 10
  lmax = get g_dla 0
  cm_m1_m7 tr rp lmax
  st = run_rp tr ctl rs bgt bc_s 1
  measure and eq st DL_OK eq dl_dg_eq add 14080 mul rp 32 ulong 14112 1 1 14
end

fn tail_zero rp ulong to void
  nt = get g_rp_n rp
  r = dl_reversals 0 mul rp DL_TR_MAX_TICKS sub nt 50 nt
  measure eq r 0 1 15
end

fn monotone_from rp ulong frm ulong to void
  nt = get g_rp_n rp
  rbo = mul rp DL_TR_MAX_TICKS
  ok = true
  i = add frm 1
  while lt i nt
    prev = get g_rp_lm add rbo sub i 1
    cur = get g_rp_lm add rbo i
    if lt cur sub prev mul 1e-12 add 1.0 prev
      ok = false
    end
    i = add i 1
  end
  measure ok 1 16
end

fn tr_copy dst ulong src ulong to void
  put g_tr_k dst get g_tr_k src
  put g_tr_sd dst get g_tr_sd src
  nt = get g_tr_n src
  put g_tr_n dst nt
  dbo = mul dst DL_TR_MAX_TICKS
  sbo = mul src DL_TR_MAX_TICKS
  for i ulong nt
    put g_tr_gn add dbo i get g_tr_gn add sbo i
    put g_tr_es add dbo i get g_tr_es add sbo i
    put g_tr_un add dbo i get g_tr_un add sbo i
    put g_tr_cl add dbo i get g_tr_cl add sbo i
    put g_tr_ev add dbo i get g_tr_ev add sbo i
    put g_tr_rg add dbo i get g_tr_rg add sbo i
  end
end

fn test_sc2_cal_h1 to void
  dl_dg_fill ulong 64 uchar 0x44
  tr_copy 1 0
  for i ulong get g_tr_n 1
    put g_tr_cl add DL_TR_MAX_TICKS i 1
  end
  put g_rp_cfg 0 DL_CLS_SOFT
  put g_rp_cfg 1 0
  put g_rp_cfg 2 1
  put g_rp_cfg 3 2
  put g_rp_bgt 0 TR_BUDGET
  chk_st dl_replay_run 1 0 0 1 DL_OK 212
  same = true
  frsh = true
  for i ulong get g_rp_n 1
    if ne get g_rp_lm add DL_TR_MAX_TICKS i get g_rp_lm i
      same = false
    end
    if ne get g_rp_ls add DL_TR_MAX_TICKS i DL_LS_FRESH
      frsh = false
    end
  end
  measure and same and frsh eq dl_dg_eq ulong 14112 ulong 14080 0 1 213
  put g_rp_cfg 2 0
  chk_st dl_replay_run 1 0 0 1 DL_E_CAL 214
  note H1 hostile classes
  put g_rp_cfg 0 DL_CLS_INV
  st_a = dl_replay_run 0 0 0 1
  put g_rp_cfg 0 DL_CLS_UNDECL
  st_b = dl_replay_run 0 0 0 1
  measure and eq st_a DL_E_CLASS eq st_b DL_E_CLASS 1 215
end

fn test_sc2_extras to void
  to_hex 13952
  ok_t = hex_eq_txt t_gold_tr2
  to_hex 14080
  ok_r = hex_eq_txt t_gold_rp2
  measure and ok_t ok_r 1 200
  dl_dg_cp ulong 96 ulong 13952
  dl_dg_cp ulong 128 ulong 14080
  chk_st dl_enc_trace 0 DL_TR_ENC_MAX DL_OK 201
  nlen = get g_dws 1
  chk eq nlen add DL_TR_HDR_SZ mul 200 DL_TR_TICK_SZ 202
  chk_st dl_dec_trace nlen 1 DL_OK 203
  bitpos = add DL_TR_HDR_SZ add mul 17 DL_TR_TICK_SZ 8
  put g_dw bitpos uchar xor ulong get g_dw bitpos 1
  chk_st dl_dec_trace nlen 1 DL_OK 204
  chk ne get g_tr_es add DL_TR_MAX_TICKS 17 get g_tr_es 17 205
  chk eq get g_tr_es add DL_TR_MAX_TICKS 16 get g_tr_es 16 205
  chk_st run_rp 1 0 0 TR_BUDGET 0 1 DL_OK 206
  measure and eq dl_dg_eq ulong 13984 ulong 96 0 eq dl_dg_eq ulong 14112 ulong 128 0 1 207
  _re = dl_enc_trace 0 DL_TR_ENC_MAX
  put g_dw 0 uchar 2
  chk_st dl_dec_trace nlen 1 DL_E_KIND 208
  put g_dw 0 uchar 8
  put g_dw 1 uchar 2
  chk_st dl_dec_trace nlen 1 DL_E_ENC 209
  put g_dw 1 uchar 1
  chk_st dl_dec_trace sub nlen 1 1 DL_E_ENC 210
  chk_st dl_dec_trace add nlen 1 1 DL_E_ENC 211
  test_sc2_cal_h1
end

fn test_sc4_hostile to void
  to_hex 13952
  ok_t = hex_eq_txt t_gold_tr4
  to_hex 14080
  ok_r = hex_eq_txt t_gold_rp4
  measure and ok_t ok_r 1 230
  r = dl_reversals 0 0 0 get g_rp_n 0
  pp = dl_peak_to_peak 0 0 150 200
  measure le r 8 1 231
  measure le pp 2.5 1 232
  note hostile controller slot 1: eta=5.0 rho=0.0
  fx_ctl 1 1 5.0 0.0 2.0 10.0
  chk_st run_rp 0 1 0 TR_BUDGET 0 1 DL_OK 233
  ok = true
  nt = get g_rp_n 1
  for i ulong nt
    lv = get g_rp_lm add DL_TR_MAX_TICKS i
    if or not dl_fin lv or lt lv 0.0 gt lv 10.0
      ok = false
    end
  end
  if not ok
    put g_neg_ok 0 0
  end
  rh = dl_reversals 0 DL_TR_MAX_TICKS 0 nt
  if gt rh 8
    put g_neg_ok 0 0
  end
  pph = dl_peak_to_peak 0 DL_TR_MAX_TICKS 150 200
  if le pph 2.5
    put g_neg_ok 0 0
  end
  for i ulong nt
    put g_est_arr i get g_tr_es i
  end
  re = dl_reversals 1 0 0 nt
  if gt rh add re 1
    put g_neg_ok 0 0
  end
end

fn test_sc5_to_12 to void
  note 5/6 competing
  put g_ct_eta 2 0.1
  put g_ct_rho 2 0.05
  put g_ct_ks 2 2.0
  put g_ct_age 2 4
  put g_ct_cad 2 1
  put g_ct_n 2 2
  put g_ct_rid 64 1
  put g_ct_rid 65 2
  put g_ct_lm 64 10.0
  put g_ct_lm 65 10.0
  fx_res 1 1 DL_U_BYTES TR_SCALE
  fx_res 2 2 DL_U_BYTES TR_SCALE
  chk_st tr_scenario 5 0 0 0 DL_OK 240
  chk_st run_rp 0 2 1 TR_BUDGET 0 0 DL_OK 241
  common_measures 0 2 1 TR_BUDGET 0 0
  tail_zero 0
  lm = get g_rp_lm sub get g_rp_n 0 1
  chk_st tr_scenario 6 0 0 0 DL_OK 242
  chk_st run_rp 0 2 2 TR_BUDGET 0 0 DL_OK 243
  common_measures 0 2 2 TR_BUDGET 0 0
  tail_zero 0
  ll = get g_rp_lm sub get g_rp_n 0 1
  measure and gt lm 0.0 eq ll 0.0 1 244
  note 7 capacity reduction
  chk_st tr_scenario 7 65 0 0 DL_OK 245
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 246
  common_measures 0 0 0 TR_BUDGET 0 0
  chk eq get g_rp_lm sub get g_rp_n 0 1 0.0 247
  chk_st tr_scenario 7 66 0 0 DL_OK 248
  chk_st run_rp 0 0 0 3000.0 1 0 DL_OK 249
  common_measures 0 0 0 3000.0 1 0
  tail_zero 0
  monotone_from 0 0
  chk and eq get g_cs_gen 6 200 and eq get g_cs_tk 6 99 gt get g_rp_lm 0 0.0 250
  note 8 regime change
  chk_st tr_scenario 8 0 0 0 DL_OK 251
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 252
  common_measures 0 0 0 TR_BUDGET 0 0
  tail_zero 0
  ok8 = true
  af8 = true
  i = ulong 80
  while lt i 120
    if ne get g_rp_ls i DL_LS_FROZEN
      ok8 = false
    end
    if ne get g_rp_lm i get g_rp_lm sub i 1
      ok8 = false
    end
    if ne get g_rp_es i get g_rp_es sub i 1
      ok8 = false
    end
    if ne get g_rp_gn i get g_rp_gn sub i 1
      ok8 = false
    end
    i = add i 1
  end
  i = ulong 120
  while lt i get g_rp_n 0
    if ne get g_rp_ls i DL_LS_UNCAL
      af8 = false
    end
    i = add i 1
  end
  measure and ok8 af8 1 253
  chk and eq get g_rp_gn 119 80 gt get g_rp_lm 120 get g_rp_lm 119 254
end

fn test_sc9_to_12 to void
  note 9 bursty
  chk_st tr_scenario 9 0 0 0 DL_OK 255
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 256
  common_measures 0 0 0 TR_BUDGET 0 0
  bursts = ulong 0
  for j ulong get g_tr_n 0
    if gt get g_tr_es j 4200.0
      bursts = add bursts 1
    end
  end
  chk and gt bursts 5 lt bursts 60 257
  note 10 fanout 32
  put g_ct_eta 3 0.1
  put g_ct_rho 3 0.05
  put g_ct_ks 3 2.0
  put g_ct_age 3 4
  put g_ct_cad 3 1
  put g_ct_n 3 DL_MAX_RES
  for r ulong DL_MAX_RES
    put g_ct_rid add 96 r add r 1
    put g_ct_lm add 96 r 10.0
  end
  mn = f64 1e300
  mx = f64 -1e300
  for r ulong DL_MAX_RES
    fx_res 3 add r 1 DL_U_BYTES TR_SCALE
    chk_st tr_scenario 10 0 r 0 DL_OK 258
    chk_st run_rp 0 3 3 TR_BUDGET 0 0 DL_OK 259
    common_measures 0 3 3 TR_BUDGET 0 0
    tail_zero 0
    fv = get g_rp_lm sub get g_rp_n 0 1
    if lt fv mn
      mn = fv
    end
    if gt fv mx
      mx = fv
    end
  end
  measure le sub mx mn 0.25 1 260
  note 11 KV saturation
  chk_st tr_scenario 11 0 0 0 DL_OK 261
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 262
  common_measures 0 0 0 TR_BUDGET 0 0
  cross = ulong 0
  ok11 = true
  for j ulong get g_tr_n 0
    if le get g_tr_es j 5200.0
      if ne get g_rp_lm j 0.0
        ok11 = false
      end
    else
      if eq cross 0
        cross = j
      end
    end
  end
  measure ok11 1 263
  monotone_from 0 cross
  chk eq cross 110 264
  note 12 recovery
  chk_st tr_scenario 12 0 0 0 DL_OK 265
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 266
  common_measures 0 0 0 TR_BUDGET 0 0
  tail_zero 0
  k_rec = ulong 0
  pw = f64 1.0
  while gt pw 0.01
    pw = mul pw 0.95
    k_rec = add k_rec 1
  end
  pk = get g_rp_lm 99
  at_v = get g_rp_lm add 99 k_rec
  measure and eq k_rec 90 le at_v mul 0.01 pk 1 267
end

fn test_scenarios to void
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  fx_res 0 1 DL_U_BYTES TR_SCALE
  chk_st tr_scenario 1 0 0 0 DL_OK 100
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 101
  common_measures 0 0 0 TR_BUDGET 0 0
  tail_zero 0
  chk eq get g_rp_lm sub get g_rp_n 0 1 0.0 102
  chk_st tr_scenario 2 0 0 0 DL_OK 103
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 104
  common_measures 0 0 0 TR_BUDGET 0 0
  tail_zero 0
  monotone_from 0 0
  measure lt dl_fabs sub get g_rp_lm sub get g_rp_n 0 1 0.6 1e-3 1 105
  test_sc2_extras
  chk_st tr_scenario 3 0 0 0 DL_OK 106
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 107
  common_measures 0 0 0 TR_BUDGET 0 0
  tail_zero 0
  monotone_from 0 100
  chk and eq get g_rp_lm 99 0.0 gt get g_rp_lm 100 0.0 108
  chk_st tr_scenario 4 0 0 0 DL_OK 109
  chk_st run_rp 0 0 0 TR_BUDGET 0 0 DL_OK 110
  common_measures 0 0 0 TR_BUDGET 0 0
  test_sc4_hostile
  test_sc5_to_12
  test_sc9_to_12
end

fn build_path a view uchar * b view uchar * c view uchar * to ulong
  p = ulong 0
  for i ulong len a
    put g_path p get a i
    p = add p 1
  end
  for i ulong len b
    put g_path p get b i
    p = add p 1
  end
  for i ulong len c
    put g_path p get c i
    p = add p 1
  end
  put g_path p uchar 0
  ret p
end

fn load_file plen ulong to ulong
  fd = fopen g_path 0 plen 0 0
  if lt fd 0
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_2
    ret 0
  end
  tot = ulong 0
  while lt tot 16777216
    got = read int fd g_file tot sub 16777216 tot
    if le got 0
      break
    end
    tot = add tot ulong got
  end
  _fc = fclose int fd
  ret tot
end

fn buf_contains_raw_hex hlen ulong to bool
  if gt 64 hlen
    ret false
  end
  lim = sub hlen 64
  i = ulong 0
  while le i lim
    ok = true
    for j ulong 64
      if ne get g_file add i j get g_raw_hex j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
    i = add i 1
  end
  ret false
end

fn buf_contains_txt hlen ulong ndl view uchar * to bool
  nlen = len ndl
  if gt nlen hlen
    ret false
  end
  lim = sub hlen nlen
  i = ulong 0
  while le i lim
    ok = true
    for j ulong nlen
      if ne get g_file add i j get ndl j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
    i = add i 1
  end
  ret false
end

fn recorded_one dir_idx ulong fn_idx ulong cpu view uchar * ev view uchar * to void
  fx_res 1 1 DL_U_DIMLESS 1e9
  plen = ulong 0
  if eq dir_idx 0
    if eq fn_idx 0
      plen = build_path t_str_3 t_str_5 t_str_7
    else
      plen = build_path t_str_3 t_str_5 t_str_12
    end
  else
    if eq fn_idx 0
      plen = build_path t_str_3 t_str_6 t_str_7
    else
      plen = build_path t_str_3 t_str_6 t_str_12
    end
  end
  n = load_file plen
  if eq n 0
    ret
  end
  dsh_init
  dsh_file n
  dsh_final ulong 147456
  to_raw_hex 147456
  put g_dws 0 0
  put g_dws 1 n
  chk_st dl_trace_from_csv cpu ev DL_OK 400
  chk and eq get g_tr_k 0 13 gt get g_tr_n 0 10 401
  slen = ulong 0
  if eq dir_idx 0
    slen = build_path t_str_3 t_str_5 t_str_4
  else
    slen = build_path t_str_3 t_str_6 t_str_4
  end
  m = load_file slen
  if gt m 0
    listed = false
    if eq fn_idx 0
      listed = buf_contains_txt m t_fn_m
    else
      listed = buf_contains_txt m t_fn_p
    end
    if listed
      found = buf_contains_raw_hex m
      measure found 1 402
    end
  end
  chk_st run_rp 0 0 1 1e9 0 0 DL_OK 403
  common_measures 0 0 1 1e9 0 0
end

fn put_txt_to_file s view uchar * to ulong
  n = len s
  for i ulong n
    put g_file i get s i
  end
  ret n
end

fn test_recorded to void
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  recorded_one 0 0 t_str_8 t_str_9
  recorded_one 0 0 t_str_10 t_str_11
  recorded_one 0 1 t_str_10 t_str_11
  recorded_one 1 0 t_str_8 t_str_9
  recorded_one 1 0 t_str_10 t_str_11
  recorded_one 1 1 t_str_10 t_str_11
  n = put_txt_to_file t_str_13
  put g_dws 0 0
  put g_dws 1 n
  chk_st dl_trace_from_csv t_str_8 t_str_9 DL_E_ENC 410
  n = put_txt_to_file t_str_14
  put g_dws 0 0
  put g_dws 1 n
  chk_st dl_trace_from_csv t_str_8 t_str_9 DL_E_RANGE 411
  n = put_txt_to_file t_str_15
  put g_dws 0 0
  put g_dws 1 n
  chk_st dl_trace_from_csv t_str_8 t_str_9 DL_OK 412
  chk and eq get g_tr_n 0 2 eq get g_tr_es 0 5.0 413
  chk and eq get g_tr_es 1 9.0 and eq get g_tr_gn 1 2 eq get g_tr_cl 0 0 413
end

fn test_trace_refusals to void
  chk_st tr_scenario 2 0 0 0 DL_OK 50
  keep = get g_tr_es 3
  put g_tr_es 3 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_dig_trace 0 ulong 160 DL_E_NONFIN 51
  put g_tr_es 3 keep
  put g_tr_un 3 -1.0
  chk_st dl_dig_trace 0 ulong 160 DL_E_RANGE 52
  put g_tr_un 3 100.0
  put g_tr_rg 3 2
  chk_st dl_dig_trace 0 ulong 160 DL_E_RANGE 53
  put g_tr_rg 3 0
  put g_tr_k 0 0
  chk_st dl_dig_trace 0 ulong 160 DL_E_KIND 54
  put g_tr_k 0 2
  put g_tr_n 0 0
  chk_st dl_dig_trace 0 ulong 160 DL_E_RANGE 55
  put g_tr_n 0 add DL_TR_MAX_TICKS 1
  chk_st dl_dig_trace 0 ulong 160 DL_E_RANGE 56
  put g_tr_n 0 200
  chk_st dl_dig_trace 0 ulong 160 DL_OK 57
  put g_tr_es 5 0.0
  _da = dl_dig_trace 0 ulong 160
  put g_tr_es 5 bitcast f64 or shl ulong 0x80000000 32 ulong 0
  _db = dl_dig_trace 0 ulong 192
  chk eq dl_dg_eq ulong 160 ulong 192 1 58
  put g_tr_es 5 keep
  put g_est_arr 0 0.0
  put g_est_arr 1 1.0
  put g_est_arr 2 2.0
  put g_est_arr 3 2.0
  put g_est_arr 4 1.0
  put g_est_arr 5 1.0
  put g_est_arr 6 3.0
  put g_est_arr 7 3.0
  chk eq dl_reversals 1 0 0 8 2 59
  chk eq dl_reversals 1 0 0 3 0 60
  chk eq dl_peak_to_peak 1 0 0 8 3.0 61
  chk eq dl_reversals 1 0 4 4 0 62
end

fn main to long
  put g_neg_ok 0 1
  dl_dg_fill ulong 0 uchar 0x22
  dl_dg_fill ulong 32 uchar 0x23
  test_trace_refusals
  test_scenarios
  test_recorded
  t_pr_txt t_str_16
  if and eq get g_ref_fl 0 0 and eq get g_neg_ok 0 1 eq get g_fl 0 0
    t_pr_txt t_str_17
  else
    t_pr_txt t_str_18
  end
  t_pr_txt t_str_19
  t_pr_u64 get g_chk 0
  t_pr_txt t_str_20
  t_pr_u64 get g_fl 0
  if and eq get g_ref_fl 0 0 and eq get g_neg_ok 0 1 eq get g_fl 0 0
    t_pr_txt t_str_21
    ret 0
  end
  t_pr_txt t_str_22
  ret 1
end

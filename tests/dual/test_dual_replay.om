text t_str_6 "20260929T025735Z-3e9e53be3358-silicon"
text t_str_7 "/machine-perf.csv"
text t_str_8 "CPU0"
text t_str_9 "armv8_pmuv3_0/cycles/"
text t_str_10 "CPU7"

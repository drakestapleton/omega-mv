note
note tests/dual/test_dual_update.om -- DUAL-1a reference update tests in pure seeded OM-2.
note Replaces tests/dual/test_dual_update.c and tests/dual/dual_ref.{c,h}.
note Built by concatenating src/dual/rx_dual.om + tests/dual/test_dual_update.om.

const T_BUDGET f64 5000.0
const T_SCALE f64 1000.0

text t_str_0 "FAIL test_dual_update check="
text t_str_1 "\n"
text t_str_2 "test_dual_update: "
text t_str_3 " checks, "
text t_str_4 " failures: PASS\n"
text t_str_5 " failures: FAIL\n"
global g_chk ulong 1
global g_fl ulong 1
global g_rng ulong 1
global g_out uchar 256
global g_est f64 64
global g_sd f64 64
global g_tr f64 64
global g_ea uchar 4096

fn t_pr_txt s view uchar * to void
  n = len s
  for i ulong n
    put g_out i get s i
  end
  _w = write 1 g_out 0 n
end

fn t_pr_u64 v ulong to void
  if eq v 0
    put g_out 0 uchar 48
    _w = write 1 g_out 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_out n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_out i
    put g_out i get g_out j
    put g_out j tmp
    i = add i 1
  end
  _w = write 1 g_out 0 n
end

fn chk ok bool id ulong to void
  put g_chk 0 add get g_chk 0 1
  if not ok
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn chk_st got long want long id ulong to void
  put g_chk 0 add get g_chk 0 1
  if ne got want
    put g_fl 0 add get g_fl 0 1
    t_pr_txt t_str_0
    t_pr_u64 id
    t_pr_txt t_str_1
  end
end

fn trnd to ulong
  x = get g_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_rng 0 x
  m = or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
  ret mul x m
end

fn trdbl lo f64 hi f64 to f64
  u = div f64 shr trnd 11 9007199254740992.0
  ret add lo mul sub hi lo u
end

fn fx_ctl s ulong id ulong eta f64 rho f64 ks f64 lmax f64 to void
  put g_ct_eta s eta
  put g_ct_rho s rho
  put g_ct_ks s ks
  put g_ct_age s 4
  put g_ct_cad s 1
  put g_ct_n s 1
  bo = mul s 32
  put g_ct_rid bo id
  put g_ct_lm bo lmax
end

fn fx_res s ulong id ulong u ulong sc f64 to void
  put g_rs_id s id
  put g_rs_u s u
  put g_rs_sc s sc
  dl_dg_fill add 1024 mul s 32 uchar 0x11
end

fn fx_input ins ulong x f64 sd f64 gen ulong cal ulong to void
  dl_in_clr ins
  off = mul ins 32
  dl_dg_fill add 12992 off uchar add 0x30 and gen 0x3f
  put g_in_ek ins DL_EK_EST
  put g_in_u ins DL_U_BYTES
  put g_in_est ins x
  put g_in_unc ins sd
  put g_in_gen ins gen
  dl_dg_fill add 13248 off uchar 0x66
  put g_in_evv ins 1
  if ne cal 0
    dl_dg_fill add 13376 off uchar 0x44
  end
end

fn ref_grad est f64 bgt f64 sc f64 unc f64 ks f64 to f64
  p = div sub est bgt sc
  band = div mul ks unc sc
  if gt p band
    ret sub p band
  end
  if lt p sub 0.0 band
    ret add p band
  end
  ret 0.0
end

fn pow_int base f64 n ulong to f64
  r = f64 1.0
  for i ulong n
    r = mul r base
  end
  ret r
end

fn ref_closed l0 f64 g f64 eta f64 rho f64 t ulong to f64
  if eq rho 0.0
    ret add l0 mul mul eta g f64 t
  end
  a = pow_int sub 1.0 rho t
  ret add mul a l0 div mul mul eta g sub 1.0 a rho
end

fn ref_fp g f64 eta f64 rho f64 to f64
  ret div mul eta g rho
end

fn run_seq ctl ulong rs ulong n ulong dst ulong rec_tr ulong to long
  fx_input 0 get g_est 0 get g_sd 0 1 1
  put g_dla 3 T_BUDGET
  put g_dws 0 0
  st = dl_init_state rs DL_CLS_SOFT 0 0 ctl 1
  if ne st DL_OK
    ret st
  end
  if ne rec_tr 0
    put g_tr 0 get g_cs_lam 0
  end
  t = ulong 1
  while lt t n
    fx_input 0 get g_est t get g_sd t add t 1 1
    st = dl_update 0 rs 0 ctl add t 1 1
    if ne st DL_OK
      ret st
    end
    if ne rec_tr 0
      put g_tr t get g_cs_lam 1
    end
    dl_cs_copy 0 1
    t = add t 1
  end
  dl_cs_copy dst 0
  ret DL_OK
end

fn test_analytic_2 to void
  note 5. clip
  fx_ctl 0 1 1.0 0.0 0.0 3.0
  for i ulong 60
    put g_est i 7000.0
    put g_sd i 0.0
  end
  chk_st run_seq 0 0 60 2 1 DL_OK 140
  chk and eq get g_tr 0 2.0 and eq get g_tr 1 3.0 eq get g_tr 59 3.0 141
  note 6. zero eta
  fx_ctl 0 1 0.0 0.1 2.0 10.0
  for i ulong 60
    put g_est i 9000.0
    put g_sd i 0.0
  end
  chk_st run_seq 0 0 60 2 1 DL_OK 142
  for i ulong 60
    chk eq get g_tr i 0.0 143
  end
  note 7. rho > 0 forgets scarcity
  fx_ctl 0 1 0.5 0.1 2.0 10.0
  for i ulong 60
    if lt i 10
      put g_est i 7000.0
    else
      put g_est i 5000.0
    end
    put g_sd i 100.0
  end
  chk_st run_seq 0 0 60 2 1 DL_OK 144
  chk gt get g_tr 9 1.0 145
  i = ulong 10
  while lt i 60
    want = mul get g_tr 9 pow_int 0.9 sub i 9
    chk lt dl_fabs sub get g_tr i want 1e-9 146
    i = add i 1
  end
  chk lt get g_cs_lam 2 mul 0.01 get g_tr 9 147
  note 8. determinism
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  for k ulong 60
    put g_est k add 5300.0 mul 200.0 sub f64 rem k 7 3.0
    put g_sd k 80.0
  end
  chk_st run_seq 0 0 60 2 0 DL_OK 148
  chk_st run_seq 0 0 60 3 0 DL_OK 149
  chk_st dl_enc_constraint 2 DL_ENC_MAX DL_OK 150
  la = get g_dws 1
  for m1 ulong la
    put g_ea m1 get g_dw m1
  end
  chk_st dl_enc_constraint 3 DL_ENC_MAX DL_OK 151
  lb = get g_dws 1
  eq_all = eq la lb
  if eq_all
    for m2 ulong la
      if ne get g_ea m2 get g_dw m2
        eq_all = false
      end
    end
  end
  chk and eq_all eq get g_cs_tk 2 59 152
end

fn test_analytic to void
  fx_res 0 1 DL_U_BYTES T_SCALE
  note 1. single binding
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  g = ref_grad 5500.0 T_BUDGET T_SCALE 100.0 2.0
  for i ulong 60
    put g_est i 5500.0
    put g_sd i 100.0
  end
  chk lt dl_fabs sub g 0.3 1e-12 100
  chk_st run_seq 0 0 60 2 1 DL_OK 101
  for t ulong 60
    w = ref_closed 0.0 g 0.1 0.05 add t 1
    chk lt dl_fabs sub get g_tr t w 1e-9 102
  end
  chk and gt get g_tr 59 get g_tr 0 and le get g_tr 59 add ref_fp g 0.1 0.05 1e-9 eq get g_cs_ls 2 DL_LS_FRESH 103
  note 2. slack constraint
  for i ulong 60
    if lt i 20
      put g_est i 5500.0
    else
      put g_est i 4000.0
    end
    put g_sd i 100.0
  end
  chk_st run_seq 0 0 60 2 1 DL_OK 104
  chk and gt get g_tr 19 0.3 eq get g_cs_lam 2 0.0 105
  i = ulong 20
  while lt i 60
    chk and le get g_tr i get g_tr sub i 1 ge get g_tr i 0.0 106
    i = add i 1
  end
  note 3. two competing constraints
  fx_res 1 1 DL_U_BYTES T_SCALE
  fx_res 2 2 DL_U_BYTES T_SCALE
  put g_ct_eta 1 0.2
  put g_ct_rho 1 0.1
  put g_ct_ks 1 1.0
  put g_ct_age 1 4
  put g_ct_cad 1 1
  put g_ct_n 1 2
  put g_ct_rid 32 1
  put g_ct_rid 33 2
  put g_ct_lm 32 5.0
  put g_ct_lm 33 5.0
  for k1 ulong 60
    put g_est k1 6000.0
    put g_sd k1 50.0
  end
  chk_st run_seq 1 1 60 2 1 DL_OK 107
  gm = ref_grad 6000.0 T_BUDGET T_SCALE 50.0 1.0
  chk lt dl_fabs sub get g_tr 59 ref_closed 0.0 gm 0.2 0.1 60 1e-9 108
  for k2 ulong 60
    put g_est k2 4900.0
    put g_sd k2 50.0
  end
  chk_st run_seq 1 2 60 3 1 DL_OK 109
  gl = ref_grad 4900.0 T_BUDGET T_SCALE 50.0 1.0
  chk and lt gl 0.0 and eq get g_cs_lam 3 0.0 gt get g_cs_lam 2 1.0 110
  note 4. inside deadband
  fx_ctl 0 1 0.5 0.0 2.0 10.0
  for k3 ulong 60
    put g_est k3 5100.0
    put g_sd k3 100.0
  end
  chk_st run_seq 0 0 60 2 1 DL_OK 111
  for k4 ulong 60
    chk eq get g_tr k4 0.0 112
  end
  test_analytic_2
end

fn test_states_refusals_2 to void
  note structural refusals
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  fx_res 0 1 DL_U_BYTES T_SCALE
  fx_input 0 9000.0 100.0 2 1
  fx_ctl 1 1 0.2 0.05 2.0 10.0
  chk_st dl_update 0 0 0 1 2 1 DL_E_CTL 220
  fx_ctl 1 2 0.1 0.05 2.0 10.0
  chk_st dl_update 0 0 0 1 2 1 DL_E_RES 221
  fx_res 1 1 DL_U_NS T_SCALE
  chk_st dl_update 0 1 0 0 2 1 DL_E_UNIT 222
  fx_res 1 3 DL_U_BYTES T_SCALE
  chk_st dl_update 0 1 0 0 2 1 DL_E_RES 223
  fx_res 1 1 DL_U_BYTES 0.0
  chk_st dl_update 0 1 0 0 2 1 DL_E_SCALE 224
  fx_res 1 1 DL_U_BYTES -1.0
  chk_st dl_update 0 1 0 0 2 1 DL_E_SCALE 225
  fx_input 1 9000.0 100.0 2 1
  put g_in_u 1 DL_U_NS
  chk_st dl_update 0 0 1 0 2 1 DL_E_UNIT 226
  dl_cs_copy 3 0
  put g_cs_cls 3 DL_CLS_INV
  chk_st dl_update 3 0 0 0 2 1 DL_E_CLASS 227
  dl_cs_copy 3 0
  put g_cs_lam 3 11.0
  chk_st dl_update 3 0 0 0 2 1 DL_E_RANGE 228
  dl_cs_copy 3 0
  put g_cs_lam 3 -1.0
  chk_st dl_update 3 0 0 0 2 1 DL_E_RANGE 229
  dl_cs_copy 3 0
  dl_dg_fill ulong 3936 uchar 0x01
  chk_st dl_update 3 0 0 0 2 1 DL_E_DIG 230
  dl_cs_copy 3 0
  dl_dg_clr ulong 3424
  chk_st dl_update 3 0 0 0 2 1 DL_E_DIG 231
  put g_dla 3 T_BUDGET
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_INV 0 0 0 1 DL_E_CLASS 232
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_UNDECL 0 0 0 1 DL_E_CLASS 233
  put g_dla 3 bitcast f64 ulong 0x7ff0000000000000
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_SOFT 0 0 0 1 DL_E_NONFIN 234
  put g_dla 3 T_BUDGET
  dl_dg_clr ulong 32
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_SOFT 1 0 0 1 DL_E_DIG 235
  fx_input 1 bitcast f64 ulong 0x7ff8000000000000 100.0 2 1
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_SOFT 0 1 0 1 DL_E_NONFIN 236
  put g_dws 0 1
  chk_st dl_init_state 0 DL_CLS_CAP 0 0 0 2 DL_OK 237
  chk and eq get g_cs_cls 1 DL_CLS_CAP gt get g_cs_lam 1 0.0 238
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 bitcast f64 ulong 0x7ff0000000000000 1.0 T_BUDGET T_SCALE 0 DL_E_NONFIN 239
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 bitcast f64 or shl ulong 0xfff00000 32 ulong 0 1.0 T_BUDGET T_SCALE 0 DL_E_NONFIN 240
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 1.0 1.0 T_BUDGET 0.0 0 DL_E_SCALE 241
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 1.0 1.0 T_BUDGET -1.0 0 DL_E_SCALE 242
  put g_dla 0 10.0
  chk_st dl_step_lambda -0.5 1.0 1.0 T_BUDGET T_SCALE 0 DL_E_RANGE 243
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 1.0 -1.0 T_BUDGET T_SCALE 0 DL_E_RANGE 244
  put g_dla 0 10.0
  chk_st dl_step_lambda 11.0 1.0 1.0 T_BUDGET T_SCALE 0 DL_E_RANGE 245
  put g_dla 0 10.0
  chk_st dl_step_lambda 0.5 1e308 1.0 -1e308 T_SCALE 0 DL_E_NONFIN 246
end

fn test_states_and_refusals to void
  fx_ctl 0 1 0.1 0.05 2.0 10.0
  fx_res 0 1 DL_U_BYTES T_SCALE
  fx_input 0 5500.0 100.0 1 1
  put g_dla 3 T_BUDGET
  put g_dws 0 0
  chk_st dl_init_state 0 DL_CLS_SOFT 0 0 0 1 DL_OK 200
  chk and eq get g_cs_tk 0 0 and eq dl_dg_is_zero ulong 3840 1 and gt get g_cs_lam 0 0.0 eq get g_cs_ls 0 DL_LS_FRESH 201
  chk_st dl_dig_constraint 0 ulong 64 DL_OK 202
  fx_input 0 9000.0 100.0 2 1
  put g_in_evv 0 0
  chk_st dl_update 0 0 0 0 2 1 DL_OK 203
  chk eq get g_cs_ls 1 DL_LS_STALE 204
  chk eq get g_cs_lam 1 get g_cs_lam 0 204
  chk eq get g_cs_est 1 get g_cs_est 0 204
  chk eq get g_cs_gen 1 get g_cs_gen 0 204
  chk and eq dl_dg_eq ulong 3872 ulong 64 1 and eq get g_cs_tk 1 1 eq dl_dg_eq ulong 3616 ulong 3584 1 205
  fx_input 0 9000.0 100.0 2 1
  chk_st dl_update 0 0 0 0 7 1 DL_OK 206
  chk and eq get g_cs_ls 1 DL_LS_STALE eq get g_cs_lam 1 get g_cs_lam 0 207
  fx_input 0 bitcast f64 ulong 0x7ff8000000000000 100.0 2 1
  chk_st dl_update 0 0 0 0 2 1 DL_OK 208
  chk and eq get g_cs_ls 1 DL_LS_REFUSED eq get g_cs_lam 1 get g_cs_lam 0 209
  fx_input 0 9000.0 -1.0 2 1
  chk_st dl_update 0 0 0 0 2 1 DL_OK 210
  chk eq get g_cs_ls 1 DL_LS_REFUSED 211
  fx_input 0 9000.0 100.0 5 1
  chk_st dl_update 0 0 0 0 2 1 DL_OK 212
  chk eq get g_cs_ls 1 DL_LS_REFUSED 213
  fx_input 0 9000.0 100.0 2 1
  put g_in_reg 0 1
  chk_st dl_update 0 0 0 0 2 1 DL_OK 214
  chk and eq get g_cs_ls 1 DL_LS_FROZEN eq get g_cs_lam 1 get g_cs_lam 0 215
  fx_input 0 9000.0 100.0 2 0
  chk_st dl_update 0 0 0 0 2 1 DL_OK 216
  chk and eq get g_cs_ls 1 DL_LS_UNCAL gt get g_cs_lam 1 get g_cs_lam 0 217
  fx_input 0 9000.0 100.0 3 1
  chk_st dl_update 1 0 0 0 3 2 DL_OK 218
  chk and eq get g_cs_ls 2 DL_LS_FRESH eq get g_cs_tk 2 2 219
  test_states_refusals_2
end

fn test_prop_check_ns prev f64 nl f64 bgt f64 lmax f64 to void
  g = ref_grad get g_in_est 0 bgt get g_rs_sc 0 get g_in_unc 0 get g_ct_ks 0
  t1 = mul sub 1.0 get g_ct_rho 0 prev
  t2 = mul get g_ct_eta 0 g
  want = add t1 t2
  if lt want 0.0
    want = f64 0.0
  end
  if gt want lmax
    want = lmax
  end
  chk le dl_fabs sub nl want mul 1e-9 add 1.0 dl_fabs want 304
  if eq g 0.0
    chk le nl prev 305
  end
  if eq get g_ct_eta 0 0.0
    chk le nl prev 306
  end
end

fn test_prop_step t ulong bgt f64 lmax f64 to void
  prev = get g_cs_lam 0
  cal = ulong 1
  if eq rem trnd 5 0
    cal = 0
  end
  fx_input 0 trdbl -1000000.0 1000000.0 trdbl 0.0 10000.0 t cal
  if eq rem trnd 7 0
    put g_in_evv 0 0
  end
  chk_st dl_update 0 0 0 0 t 1 DL_OK 301
  nl = get g_cs_lam 1
  chk and dl_fin nl and ge nl 0.0 and le nl lmax eq get g_cs_tk 1 sub t 1 302
  if eq get g_cs_ls 1 DL_LS_STALE
    chk eq nl prev 303
  else
    test_prop_check_ns prev nl bgt lmax
  end
  dl_cs_copy 0 1
end

fn test_properties to void
  for r ulong 3000
    fx_ctl 0 1 trdbl 0.0 2.0 trdbl 0.0 1.0 trdbl 0.0 4.0 trdbl 0.01 50.0
    put g_ct_age 0 add 1 rem trnd 8
    fx_res 0 1 DL_U_BYTES trdbl 0.001 1000000.0
    fx_input 0 trdbl -1000000.0 1000000.0 trdbl 0.0 10000.0 1 1
    bgt = trdbl -1000000.0 1000000.0
    lmax = get g_ct_lm 0
    put g_dla 3 bgt
    put g_dws 0 0
    chk_st dl_init_state 0 DL_CLS_SOFT 0 0 0 1 DL_OK 300
    t = ulong 2
    while le t 40
      test_prop_step t bgt lmax
      t = add t 1
    end
  end
end

fn main to long
  put g_rng 0 or shl ulong 0xd1b54a32 32 ulong 0xd192ed03
  dl_dg_fill ulong 0 uchar 0x22
  test_analytic
  test_states_and_refusals
  test_properties
  t_pr_txt t_str_2
  t_pr_u64 get g_chk 0
  t_pr_txt t_str_3
  t_pr_u64 get g_fl 0
  if eq get g_fl 0 0
    t_pr_txt t_str_4
    ret 0
  end
  t_pr_txt t_str_5
  ret 1
end

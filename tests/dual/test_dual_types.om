note
note tests/dual/test_dual_types.om -- DUAL-0a contract tests in pure seeded OM-2.
note Replaces tests/dual/test_dual_types.c.
note Built by concatenating src/dual/rx_dual.om + tests/dual/test_dual_types.om.

text t_str_0 "FAIL test_dual_types check="
text t_str_1 "\n"
text t_str_2 "jspace.residency"
text t_str_3 "test_dual_types: "
text t_str_4 " checks, "
text t_str_5 " failures: PASS\n"
text t_str_6 " failures: FAIL\n"
global g_chk ulong 1
global g_fl ulong 1
global g_rng ulong 1
global g_b1 uchar 4096
global g_b2 uchar 4096
global g_out uchar 256

fn t_pr_txt s view uchar * to void
  n = len s
  for i ulong n
    put g_out i get s i
  end
  _w = write 1 g_out 0 n
end

fn t_pr_u64 v ulong to void
  if eq v 0
    put g_out 0 uchar 48
    _w = write 1 g_out 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0
    put g_out n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  i = ulong 0
  while lt i div n 2
    j = sub sub n 1 i
    tmp = get g_out i
    put g_out i get g_out j
    put g_out j tmp
    i = add i 1
  end
  _w = write 1 g_out 0 n
end

fn t_fail_id id ulong to void
  t_pr_txt t_str_0
  t_pr_u64 id
  t_pr_txt t_str_1
end

fn chk ok bool id ulong to void
  put g_chk 0 add get g_chk 0 1
  if not ok
    put g_fl 0 add get g_fl 0 1
    t_fail_id id
  end
end

fn chk_st got long want long id ulong to void
  put g_chk 0 add get g_chk 0 1
  if ne got want
    put g_fl 0 add get g_fl 0 1
    t_fail_id id
  end
end

fn trnd to ulong
  x = get g_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_rng 0 x
  m = or shl ulong 0x2545f491 32 ulong 0x4f6cdd1d
  ret mul x m
end

fn trdbl lo f64 hi f64 to f64
  u = div f64 shr trnd 11 9007199254740992.0
  ret add lo mul sub hi lo u
end

fn trunit to ulong
  ret add 1 rem trnd sub DL_U_MAX 1
end

fn trdig off ulong to void
  for i ulong 32
    put g_dig add off i uchar and trnd 255
  end
end

fn mk_res s ulong id ulong u ulong to void
  put g_rs_id s id
  put g_rs_u s u
  put g_rs_sc s 1000.0
  dl_dg_fill add 1024 mul s 32 uchar 0x11
end

fn mk_con s ulong id ulong u ulong cls ulong to void
  off = mul s 32
  put g_cs_id s id
  put g_cs_u s u
  put g_cs_cls s cls
  put g_cs_bgt s 5000.0
  dl_dg_fill add 2304 off uchar 0x22
  dl_dg_clr add 2560 off
  dl_dg_fill add 2816 off uchar 0x33
  put g_cs_ek s DL_EK_EST
  put g_cs_est s 5200.0
  put g_cs_unc s 100.0
  dl_dg_fill add 3072 off uchar 0x44
  put g_cs_lam s 0.25
  put g_cs_ls s DL_LS_FRESH
  dl_dg_fill add 3328 off uchar 0x55
  put g_cs_gen s 7
  put g_cs_tk s 3
  dl_dg_fill add 3584 off uchar 0x66
  dl_dg_fill add 3840 off uchar 0x77
end

fn mk_ctl s ulong to void
  put g_ct_eta s 0.1
  put g_ct_rho s 0.01
  put g_ct_ks s 2.0
  put g_ct_age s 4
  put g_ct_cad s 1
  put g_ct_n s 3
  bo = mul s 32
  put g_ct_rid bo 1
  put g_ct_rid add bo 1 2
  put g_ct_rid add bo 2 9
  put g_ct_lm bo 10.0
  put g_ct_lm add bo 1 10.0
  put g_ct_lm add bo 2 1.0
end

fn mk_pv s ulong to void
  put g_pv_gen s 7
  dl_dg_fill add 4096 mul s 32 uchar 0x88
  put g_pv_n s 2
  bo = mul s 32
  put g_pv_rid bo 1
  put g_pv_rid add bo 1 2
  sbo = mul s 1024
  dl_dg_fill add 4224 sbo uchar 0x91
  dl_dg_fill add 4224 add sbo 32 uchar 0x92
end

fn mk_site s ulong to void
  put g_st_id s 1
  off = mul s 32
  dl_dg_clr add 8320 off
  for i ulong len t_str_2
    put g_dig add 8320 add off i get t_str_2 i
  end
  dl_dg_fill add 8448 off uchar 0xa1
  put g_st_ma s 5
end

fn mk_rec s ulong to void
  off = mul s 32
  dl_dg_fill add 8576 off uchar 0xb1
  dl_dg_fill add 8640 off uchar 0xb2
  put g_rc_gen s 7
  put g_rc_nc s 3
  cbo = mul s 2048
  dl_dg_fill add 8704 cbo uchar 0xc1
  dl_dg_fill add 8704 add cbo 32 uchar 0xc2
  dl_dg_fill add 8704 add cbo 64 uchar 0xc3
  put g_rc_act s 0
  put g_rc_rec s 2
  put g_rc_nq s 2
  qbo = mul s 32
  _r0 = dl_conseq_set 1 DL_U_PS 100.0 10.0 1 112.0
  put g_rc_qid qbo get g_cq_id 0
  put g_rc_qu qbo get g_cq_u 0
  put g_rc_qp qbo get g_cq_p 0
  put g_rc_qsd qbo get g_cq_sd 0
  put g_rc_qhm qbo get g_cq_hm 0
  put g_rc_qm qbo get g_cq_m 0
  put g_rc_qe qbo get g_cq_e 0
  _r1 = dl_conseq_set 2 DL_U_PJ 50.0 5.0 0 0.0
  idx = add qbo 1
  put g_rc_qid idx get g_cq_id 0
  put g_rc_qu idx get g_cq_u 0
  put g_rc_qp idx get g_cq_p 0
  put g_rc_qsd idx get g_cq_sd 0
  put g_rc_qhm idx get g_cq_hm 0
  put g_rc_qm idx get g_cq_m 0
  put g_rc_qe idx get g_cq_e 0
  put g_rc_au s DL_AUTH_NONE
end

fn mk_out s ulong to void
  off = mul s 32
  dl_dg_fill add 12800 off uchar 0xd1
  dl_dg_fill add 12864 off uchar 0xd2
  dl_dg_fill add 12928 off uchar 0xd3
  put g_oc_tid s 1
  put g_oc_gb s 7
  put g_oc_ga s 9
  put g_oc_lb s 0.5
  put g_oc_la s 0.3
end

fn cp_dw_b1 n ulong to void
  for i ulong n
    put g_b1 i get g_dw i
  end
end

fn cp_b1_dw n ulong to void
  for i ulong n
    put g_dw i get g_b1 i
  end
end

fn eq_b1_dw n ulong to bool
  for i ulong n
    if ne get g_b1 i get g_dw i
      ret false
    end
  end
  ret true
end

fn rt_enc kind ulong s ulong cap ulong to long
  if eq kind DL_KIND_RES
    ret dl_enc_resource s cap
  end
  if eq kind DL_KIND_CON
    ret dl_enc_constraint s cap
  end
  if eq kind DL_KIND_CTL
    ret dl_enc_controller s cap
  end
  if eq kind DL_KIND_PV
    ret dl_enc_pv s cap
  end
  if eq kind DL_KIND_SITE
    ret dl_enc_site s cap
  end
  if eq kind DL_KIND_REC
    ret dl_enc_rec s cap
  end
  ret dl_enc_outcome s cap
end

fn rt_dec kind ulong n ulong s ulong to long
  if eq kind DL_KIND_RES
    ret dl_dec_resource n s
  end
  if eq kind DL_KIND_CON
    ret dl_dec_constraint n s
  end
  if eq kind DL_KIND_CTL
    ret dl_dec_controller n s
  end
  if eq kind DL_KIND_PV
    ret dl_dec_pv n s
  end
  if eq kind DL_KIND_SITE
    ret dl_dec_site n s
  end
  if eq kind DL_KIND_REC
    ret dl_dec_rec n s
  end
  ret dl_dec_outcome n s
end

fn rt_dig kind ulong s ulong dslot ulong to long
  off = mul dslot 32
  if eq kind DL_KIND_RES
    ret dl_dig_resource s add 0 off
  end
  if eq kind DL_KIND_CON
    ret dl_dig_constraint s add 0 off
  end
  if eq kind DL_KIND_CTL
    ret dl_dig_controller s add 0 off
  end
  if eq kind DL_KIND_PV
    ret dl_dig_pv s add 0 off
  end
  if eq kind DL_KIND_SITE
    ret dl_dig_site s add 0 off
  end
  if eq kind DL_KIND_REC
    ret dl_dig_rec s add 0 off
  end
  ret dl_dig_outcome s add 0 off
end

fn test_rt_one kind ulong to void
  chk_st rt_enc kind 0 DL_ENC_MAX DL_OK add 100 kind
  l1 = get g_dws 1
  chk and gt l1 2 and eq ulong get g_dw 0 kind eq ulong get g_dw 1 DL_FMT_VER add 110 kind
  cp_dw_b1 l1
  chk_st rt_dec kind l1 1 DL_OK add 120 kind
  chk_st rt_enc kind 1 DL_ENC_MAX DL_OK add 130 kind
  l2 = get g_dws 1
  chk and eq l1 l2 eq_b1_dw l1 add 140 kind
  chk_st rt_dig kind 0 0 DL_OK add 150 kind
  chk_st rt_dig kind 1 1 DL_OK add 160 kind
  chk_st rt_dig kind 0 2 DL_OK add 170 kind
  chk and eq dl_dg_eq ulong 0 ulong 32 1 eq dl_dg_eq ulong 0 ulong 64 1 add 180 kind
  cp_b1_dw l1
  chk_st rt_dec kind sub l1 1 1 DL_E_ENC add 190 kind
  cp_b1_dw l1
  put g_dw l1 uchar 0
  chk_st rt_dec kind add l1 1 1 DL_E_ENC add 200 kind
  cp_b1_dw l1
  chk_st rt_dec kind 1 1 DL_E_ENC add 210 kind
  cp_b1_dw l1
  put g_dw 1 uchar 2
  chk_st rt_dec kind l1 1 DL_E_ENC add 220 kind
  cp_b1_dw l1
  put g_dw 0 uchar 99
  chk_st rt_dec kind l1 1 DL_E_KIND add 230 kind
  chk_st rt_enc kind 0 4 DL_E_ENC add 240 kind
end

fn test_roundtrips to void
  mk_res 0 1 DL_U_PS
  mk_con 0 1 DL_U_PS DL_CLS_SOFT
  mk_ctl 0
  mk_pv 0
  mk_site 0
  mk_rec 0
  mk_out 0
  test_rt_one DL_KIND_RES
  test_rt_one DL_KIND_CON
  test_rt_one DL_KIND_CTL
  test_rt_one DL_KIND_PV
  test_rt_one DL_KIND_SITE
  test_rt_one DL_KIND_REC
  test_rt_one DL_KIND_OUT
end

fn test_kind_confusion to void
  mk_res 0 1 DL_U_PS
  mk_con 0 1 DL_U_PS DL_CLS_SOFT
  mk_pv 0
  mk_site 0
  chk_st dl_enc_resource 0 DL_ENC_MAX DL_OK 300
  l1 = get g_dws 1
  chk_st dl_dec_constraint l1 1 DL_E_KIND 301
  chk_st dl_dec_outcome l1 1 DL_E_KIND 302
  chk_st dl_enc_constraint 0 DL_ENC_MAX DL_OK 303
  l1 = get g_dws 1
  chk_st dl_dec_resource l1 1 DL_E_KIND 304
  put g_dw 0 uchar DL_KIND_RES
  chk ne dl_dec_resource l1 1 DL_OK 305
  chk_st dl_dig_resource 0 ulong 0 DL_OK 306
  chk_st dl_dig_constraint 0 ulong 32 DL_OK 307
  chk_st dl_dig_pv 0 ulong 64 DL_OK 308
  chk_st dl_dig_site 0 ulong 96 DL_OK 309
  chk eq dl_dg_eq ulong 0 ulong 32 0 310
  chk eq dl_dg_eq ulong 64 ulong 96 0 311
  chk eq dl_dg_eq ulong 0 ulong 64 0 312
end

fn test_resource_registry to void
  dl_reg_init
  mk_res 0 5 DL_U_BYTES
  chk_st dl_reg_add 0 DL_OK 400
  chk_st dl_reg_add 0 DL_E_RES 401
  put g_rs_id 0 2
  chk_st dl_reg_add 0 DL_OK 402
  put g_rs_id 0 9
  chk_st dl_reg_add 0 DL_OK 403
  chk and eq get g_rg_n 0 3 and eq get g_rg_id 0 2 and eq get g_rg_id 1 5 eq get g_rg_id 2 9 404
  chk and ge dl_reg_find 5 0 lt dl_reg_find 7 0 405
  put g_rs_id 0 3
  put g_rs_sc 0 -1.0
  chk_st dl_reg_add 0 DL_E_SCALE 406
  put g_rs_sc 0 0.0
  chk_st dl_reg_add 0 DL_E_SCALE 407
  put g_rs_sc 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_resource 0 DL_E_NONFIN 408
  put g_rs_sc 0 bitcast f64 ulong 0x7ff0000000000000
  chk_st dl_check_resource 0 DL_E_NONFIN 409
  put g_rs_sc 0 bitcast f64 or shl ulong 0xfff00000 32 ulong 0
  chk_st dl_check_resource 0 DL_E_NONFIN 410
  put g_rs_sc 0 1.0
  put g_rs_u 0 DL_U_NONE
  chk_st dl_check_resource 0 DL_E_UNIT 411
  put g_rs_u 0 DL_U_MAX
  chk_st dl_check_resource 0 DL_E_UNIT 412
  put g_rs_u 0 DL_U_KV
  dl_dg_clr ulong 1024
  chk_st dl_dig_resource 0 ulong 0 DL_E_DIG 413
  dl_reg_init
  for i ulong DL_MAX_RES
    mk_res 0 add 100 i DL_U_PS
    chk_st dl_reg_add 0 DL_OK 414
  end
  mk_res 0 999 DL_U_PS
  chk_st dl_reg_add 0 DL_E_FULL 415
end

fn test_constraint_rules_2 to void
  put g_cs_ls 0 0
  chk_st dl_check_constraint 0 DL_E_RANGE 520
  put g_cs_ls 0 DL_LS_MAX
  chk_st dl_check_constraint 0 DL_E_RANGE 521
  put g_cs_ls 0 DL_LS_FRESH
  dl_dg_clr ulong 3072
  chk_st dl_check_constraint 0 DL_E_CAL 522
  put g_cs_ls 0 DL_LS_UNCAL
  chk_st dl_check_constraint 0 DL_OK 523
  put g_cs_ls 0 DL_LS_STALE
  chk_st dl_check_constraint 0 DL_OK 524
  dl_dg_fill ulong 3072 uchar 0x44
  put g_cs_ls 0 DL_LS_FRESH
  dl_dg_clr ulong 2816
  chk_st dl_check_constraint 0 DL_E_DIG 525
  dl_dg_fill ulong 2816 uchar 0x33
  dl_dg_clr ulong 3328
  chk_st dl_check_constraint 0 DL_E_DIG 526
  dl_dg_fill ulong 3328 uchar 0x55
  dl_dg_clr ulong 3584
  chk_st dl_check_constraint 0 DL_E_DIG 527
  dl_dg_fill ulong 3584 uchar 0x66
  dl_dg_clr ulong 2304
  chk_st dl_check_constraint 0 DL_E_DIG 528
  dl_dg_fill ulong 2304 uchar 0x22
  dl_dg_clr ulong 3840
  chk_st dl_check_constraint 0 DL_E_DIG 529
  put g_cs_tk 0 0
  chk_st dl_check_constraint 0 DL_OK 530
  dl_dg_fill ulong 3840 uchar 0x77
  chk_st dl_check_constraint 0 DL_E_DIG 531
  put g_cs_tk 0 3
  chk_st dl_check_constraint 0 DL_OK 532
  chk_st dl_enc_constraint 0 DL_ENC_MAX DL_OK 533
  l1 = get g_dws 1
  put g_dw 10 uchar DL_CLS_INV
  chk_st dl_dec_constraint l1 1 DL_E_CLASS 534
  put g_dw 10 uchar DL_CLS_UNDECL
  chk_st dl_dec_constraint l1 1 DL_E_CLASS 535
  mk_con 0 1 DL_U_PS DL_CLS_SOFT
  mk_con 1 1 DL_U_PS DL_CLS_SOFT
  put g_cs_lam 0 0.0
  put g_cs_lam 1 bitcast f64 or shl ulong 0x80000000 32 ulong 0
  chk_st dl_dig_constraint 0 ulong 0 DL_OK 536
  chk_st dl_dig_constraint 1 ulong 32 DL_OK 537
  chk eq dl_dg_eq ulong 0 ulong 32 1 538
end

fn test_constraint_rules to void
  mk_con 0 1 DL_U_PS DL_CLS_SOFT
  mk_res 0 1 DL_U_PS
  chk_st dl_check_constraint 0 DL_OK 500
  chk_st dl_check_constraint_against 0 0 DL_OK 501
  put g_cs_cls 0 DL_CLS_INV
  chk_st dl_check_constraint 0 DL_E_CLASS 502
  chk_st dl_dig_constraint 0 ulong 0 DL_E_CLASS 503
  put g_cs_cls 0 DL_CLS_UNDECL
  chk_st dl_check_constraint 0 DL_E_CLASS 504
  put g_cs_cls 0 DL_CLS_MAX
  chk_st dl_check_constraint 0 DL_E_CLASS 505
  put g_cs_cls 0 DL_CLS_CAP
  chk_st dl_check_constraint 0 DL_OK 506
  put g_cs_cls 0 DL_CLS_SOFT
  put g_cs_lam 0 -0.1
  chk_st dl_check_constraint 0 DL_E_RANGE 507
  put g_cs_lam 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_constraint 0 DL_E_NONFIN 508
  put g_cs_lam 0 bitcast f64 ulong 0x7ff0000000000000
  chk_st dl_check_constraint 0 DL_E_NONFIN 509
  put g_cs_lam 0 0.25
  put g_cs_unc 0 -1.0
  chk_st dl_check_constraint 0 DL_E_RANGE 510
  put g_cs_unc 0 bitcast f64 or shl ulong 0xfff00000 32 ulong 0
  chk_st dl_check_constraint 0 DL_E_NONFIN 511
  put g_cs_unc 0 100.0
  put g_cs_est 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_constraint 0 DL_E_NONFIN 512
  put g_cs_est 0 5200.0
  put g_cs_bgt 0 bitcast f64 ulong 0x7ff0000000000000
  chk_st dl_check_constraint 0 DL_E_NONFIN 513
  put g_cs_bgt 0 5000.0
  put g_cs_u 0 DL_U_NONE
  chk_st dl_check_constraint 0 DL_E_UNIT 514
  put g_cs_u 0 DL_U_PS
  put g_rs_u 0 DL_U_NS
  chk_st dl_check_constraint_against 0 0 DL_E_UNIT 515
  put g_rs_u 0 DL_U_PS
  put g_rs_id 0 2
  chk_st dl_check_constraint_against 0 0 DL_E_RES 516
  put g_rs_id 0 1
  put g_cs_ek 0 0
  chk_st dl_check_constraint 0 DL_E_KIND 517
  put g_cs_ek 0 DL_EK_MEAS
  chk_st dl_check_constraint 0 DL_E_DIG 518
  dl_dg_fill ulong 2560 uchar 0x12
  chk_st dl_check_constraint 0 DL_OK 519
  put g_cs_ek 0 DL_EK_EST
  test_constraint_rules_2
end

fn test_controller to void
  mk_ctl 0
  chk_st dl_check_controller 0 DL_OK 600
  chk_st dl_dig_controller 0 ulong 0 DL_OK 601
  chk_st dl_ctl_lambda_max 0 9 DL_OK 602
  chk eq get g_dla 0 1.0 603
  chk_st dl_ctl_lambda_max 0 4 DL_E_RES 604
  put g_ct_eta 0 0.1000001
  chk_st dl_dig_controller 0 ulong 32 DL_OK 605
  chk eq dl_dg_eq ulong 0 ulong 32 0 606
  put g_ct_eta 0 -0.1
  chk_st dl_check_controller 0 DL_E_RANGE 607
  put g_ct_eta 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_controller 0 DL_E_NONFIN 608
  put g_ct_eta 0 0.1
  put g_ct_rho 0 1.5
  chk_st dl_check_controller 0 DL_E_RANGE 609
  put g_ct_rho 0 0.01
  put g_ct_ks 0 -1.0
  chk_st dl_check_controller 0 DL_E_RANGE 610
  put g_ct_ks 0 2.0
  put g_ct_age 0 0
  chk_st dl_check_controller 0 DL_E_RANGE 611
  put g_ct_age 0 4
  put g_ct_cad 0 0
  chk_st dl_check_controller 0 DL_E_RANGE 612
  put g_ct_cad 0 1
  put g_ct_lm 1 0.0
  chk_st dl_check_controller 0 DL_E_RANGE 613
  put g_ct_lm 1 bitcast f64 ulong 0x7ff0000000000000
  chk_st dl_check_controller 0 DL_E_NONFIN 614
  put g_ct_lm 1 10.0
  put g_ct_rid 1 1
  chk_st dl_check_controller 0 DL_E_RES 615
  put g_ct_rid 1 0
  chk_st dl_check_controller 0 DL_E_RES 616
  put g_ct_rid 1 2
  put g_ct_n 0 0
  chk_st dl_check_controller 0 DL_E_RANGE 617
  put g_ct_n 0 add DL_MAX_RES 1
  chk_st dl_check_controller 0 DL_E_RANGE 618
  put g_ct_n 0 3
  chk_st dl_enc_controller 0 DL_ENC_MAX DL_OK 619
  l1 = get g_dws 1
  put g_dw 42 uchar 255
  put g_dw 43 uchar 255
  chk_st dl_dec_controller l1 1 DL_E_RANGE 620
end

fn test_price_vector to void
  mk_pv 0
  chk_st dl_check_pv 0 DL_OK 700
  put g_pv_rid 1 1
  chk_st dl_check_pv 0 DL_E_RES 701
  put g_pv_rid 1 0
  chk_st dl_check_pv 0 DL_E_RES 702
  put g_pv_rid 1 2
  dl_dg_clr ulong 4256
  chk_st dl_check_pv 0 DL_E_DIG 703
  dl_dg_fill ulong 4256 uchar 0x92
  dl_dg_clr ulong 4096
  chk_st dl_check_pv 0 DL_E_DIG 704
  dl_dg_fill ulong 4096 uchar 0x88
  put g_pv_n 0 0
  chk_st dl_check_pv 0 DL_E_RANGE 705
  put g_pv_n 0 2
  mk_con 0 1 DL_U_PS DL_CLS_SOFT
  mk_con 1 2 DL_U_PJ DL_CLS_CAP
  mk_con 2 1 DL_U_PJ DL_CLS_SOFT
  dl_dg_fill ulong 0 uchar 0x88
  put g_sl 0 0
  put g_sl 1 1
  chk_st dl_pv_build 2 0 1 DL_OK 706
  chk and eq get g_pv_n 1 2 and eq get g_pv_gen 1 7 eq get g_pv_rid 33 2 707
  chk_st dl_dig_constraint 1 ulong 32 DL_OK 708
  chk eq dl_dg_eq ulong 32 ulong 5280 1 709
  put g_sl 0 0
  put g_sl 1 2
  chk_st dl_pv_build 2 0 1 DL_E_RES 710
  put g_sl 0 1
  put g_sl 1 0
  chk_st dl_pv_build 2 0 1 DL_E_RES 711
  put g_sl 0 0
  put g_sl 1 1
  put g_cs_gen 1 8
  chk_st dl_pv_build 2 0 1 DL_E_GEN 712
  put g_cs_gen 1 7
  put g_cs_cls 1 DL_CLS_INV
  chk_st dl_pv_build 2 0 1 DL_E_CLASS 713
  put g_cs_cls 1 DL_CLS_CAP
  dl_dg_clr ulong 0
  chk_st dl_pv_build 2 0 1 DL_E_DIG 714
end

fn test_site_rec_out_2 to void
  put g_rc_au 0 1
  chk_st dl_check_rec 0 DL_E_AUTH 810
  put g_rc_au 0 0
  put g_rc_act 0 3
  chk_st dl_check_rec 0 DL_E_RANGE 811
  put g_rc_act 0 0
  put g_rc_rec 0 99
  chk_st dl_check_rec 0 DL_E_RANGE 812
  put g_rc_rec 0 2
  put g_rc_nc 0 0
  chk_st dl_check_rec 0 DL_E_RANGE 813
  put g_rc_nc 0 3
  dl_dg_clr ulong 8736
  chk_st dl_check_rec 0 DL_E_DIG 814
  dl_dg_fill ulong 8736 uchar 0xc2
  dl_dg_clr ulong 8640
  chk_st dl_check_rec 0 DL_E_DIG 815
  dl_dg_fill ulong 8640 uchar 0xb2
  dl_dg_clr ulong 8576
  chk_st dl_check_rec 0 DL_E_DIG 816
  dl_dg_fill ulong 8576 uchar 0xb1
  put g_rc_qid 1 1
  chk_st dl_check_rec 0 DL_E_RES 817
  put g_rc_qid 1 2
  put g_rc_qe 0 1.3
  chk_st dl_check_rec 0 DL_E_RANGE 818
  put g_rc_qe 0 1.2
  put g_rc_qm 1 1.0
  chk_st dl_check_rec 0 DL_E_RANGE 819
  put g_rc_qm 1 0.0
  put g_rc_qsd 0 0.0
  chk_st dl_check_rec 0 DL_E_RANGE 820
  put g_rc_qsd 0 10.0
  put g_rc_qu 0 DL_U_NONE
  chk_st dl_check_rec 0 DL_E_UNIT 821
  put g_rc_qu 0 DL_U_PS
  put g_rc_qp 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_rec 0 DL_E_NONFIN 822
  put g_rc_qp 0 100.0
  chk_st dl_enc_rec 0 DL_ENC_MAX DL_OK 823
  l1 = get g_dws 1
  put g_dw sub l1 4 uchar 1
  chk_st dl_dec_rec l1 1 DL_E_AUTH 824
  chk_st dl_conseq_set 1 DL_U_PS 1.0 0.0 1 2.0 DL_E_RANGE 825
  chk_st dl_conseq_set 1 DL_U_PS 1.0 bitcast f64 ulong 0x7ff8000000000000 0 0.0 DL_E_NONFIN 826
  chk_st dl_conseq_set 1 DL_U_PS 1.0 2.0 1 bitcast f64 ulong 0x7ff0000000000000 DL_E_NONFIN 827
  chk_st dl_conseq_set 1 DL_U_PS 1.0 2.0 0 0.0 DL_OK 828
  mk_out 0
  chk_st dl_check_outcome 0 DL_OK 829
  put g_oc_ga 0 6
  chk_st dl_check_outcome 0 DL_E_GEN 830
  put g_oc_ga 0 9
  put g_oc_la 0 -1.0
  chk_st dl_check_outcome 0 DL_E_RANGE 831
  put g_oc_la 0 0.3
  put g_oc_lb 0 bitcast f64 ulong 0x7ff8000000000000
  chk_st dl_check_outcome 0 DL_E_NONFIN 832
  put g_oc_lb 0 0.5
  dl_dg_clr ulong 12928
  chk_st dl_check_outcome 0 DL_E_DIG 833
end

fn test_site_rec_outcome to void
  mk_site 0
  chk_st dl_check_site 0 DL_OK 800
  put g_dig ulong 8336 uchar 120
  chk_st dl_check_site 0 DL_OK 801
  put g_dig ulong 8340 uchar 121
  chk_st dl_check_site 0 DL_E_SITE 802
  mk_site 0
  put g_dig ulong 8323 uchar 32
  chk_st dl_check_site 0 DL_E_SITE 803
  mk_site 0
  put g_dig ulong 8320 uchar 0
  chk_st dl_check_site 0 DL_E_SITE 804
  mk_site 0
  dl_dg_fill ulong 8320 uchar 97
  chk_st dl_check_site 0 DL_E_SITE 805
  mk_site 0
  put g_st_ma 0 0
  chk_st dl_check_site 0 DL_E_RANGE 806
  mk_site 0
  dl_dg_clr ulong 8448
  chk_st dl_check_site 0 DL_E_DIG 807
  mk_rec 0
  chk_st dl_check_rec 0 DL_OK 808
  chk eq get g_rc_qe 0 1.2 809
  test_site_rec_out_2
end

fn test_prop_one to void
  cls = DL_CLS_CAP
  if ne and trnd 1 0
    cls = DL_CLS_SOFT
  end
  mk_con 0 add 1 rem trnd 1000 trunit cls
  put g_cs_bgt 0 trdbl -1000000.0 1000000.0
  put g_cs_est 0 trdbl -1000000.0 1000000.0
  put g_cs_unc 0 trdbl 0.0 1000.0
  put g_cs_lam 0 trdbl 0.0 10.0
  put g_cs_gen 0 trnd
  put g_cs_tk 0 add 1 rem trnd 1000
  trdig ulong 2816
  trdig ulong 3840
  trdig ulong 3584
  trdig ulong 3328
  trdig ulong 2304
  ek = add 1 rem trnd 3
  put g_cs_ek 0 ek
  if eq ek DL_EK_MEAS
    trdig ulong 2560
  end
  ls = add 1 rem trnd 5
  put g_cs_ls 0 ls
  if eq rem trnd 4 0
    dl_dg_clr ulong 3072
    if eq ls DL_LS_FRESH
      put g_cs_ls 0 DL_LS_UNCAL
    end
  else
    trdig ulong 3072
  end
  chk_st dl_enc_constraint 0 DL_ENC_MAX DL_OK 900
  l1 = get g_dws 1
  cp_dw_b1 l1
  chk_st dl_dec_constraint l1 1 DL_OK 901
  chk_st dl_enc_constraint 1 DL_ENC_MAX DL_OK 902
  l2 = get g_dws 1
  chk and eq l1 l2 eq_b1_dw l1 903
  chk_st dl_dig_constraint 0 ulong 0 DL_OK 904
  cp_b1_dw l1
  pos = add 2 rem trnd sub l1 2
  bit = shl ulong 1 rem trnd 8
  put g_dw pos uchar xor ulong get g_dw pos bit
  if eq dl_dec_constraint l1 1 DL_OK
    chk_st dl_dig_constraint 1 ulong 32 DL_OK 905
    chk eq dl_dg_eq ulong 0 ulong 32 0 906
  end
end

fn test_properties to void
  for r ulong 2000
    test_prop_one
  end
end

fn main to long
  put g_rng 0 or shl ulong 0x9e3779b9 32 ulong 0x7f4a7c15
  test_roundtrips
  test_kind_confusion
  test_resource_registry
  test_constraint_rules
  test_controller
  test_price_vector
  test_site_rec_outcome
  test_properties
  t_pr_txt t_str_3
  t_pr_u64 get g_chk 0
  t_pr_txt t_str_4
  t_pr_u64 get g_fl 0
  if eq get g_fl 0 0
    t_pr_txt t_str_5
    ret 0
  end
  t_pr_txt t_str_6
  ret 1
end

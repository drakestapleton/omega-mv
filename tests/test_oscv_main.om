note
note tests/test_oscv_main.om -- standalone pure OM-2 test for src/oscv_main.om

text t_path_a "/tmp/dir/unit.osc"
text t_path_b "unit.osc"
text t_exp_a "/tmp/dir/omega.lock"
text t_exp_b "omega.lock"
text t_src_file "/tmp/om_w_src8/oscv_sample.osc"
text t_bad_store "/tmp/om_w_src8/oscv_bad.vcstore"
text t_meta_out "/tmp/om_w_src8/oscv_meta.txt"
text t_empty ""
text t_empty2 ""
text t_osc_body "fn f(x: i64) -> i64 { return x; }\n"
text t_corrupt "NOT_A_VALID_VCSTORE"
text t_pass "PASS test_oscv_main\n"

fn test_join_and_build_id to long
  ir = new uchar 32 0
  cl = new uchar 32 0
  b_dev = new uchar 32 0
  n1 = oscv_join_dir t_path_a len t_path_a oscv_def_lock
  if ne n1 len t_exp_a
    ret 1
  end
  for i ulong n1 bound 128
    if ne get g_oscv_arg i get t_exp_a i
      ret 2
    end
  end
  n2 = oscv_join_dir t_path_b len t_path_b oscv_def_lock
  if ne n2 len t_exp_b
    ret 3
  end
  for i ulong n2 bound 128
    if ne get g_oscv_arg i get t_exp_b i
      ret 4
    end
  end
  note Verify domain-folded build_id differs between dev and build
  for i ulong 32
    put ir i uchar add i 1
    put cl i uchar add i 2
  end
  oscv_build_id OSCV_DOMAIN_DEV ir cl
  for i ulong 32
    put b_dev i get g_oscv_bid i
  end
  oscv_build_id OSCV_DOMAIN_BUILD ir cl
  diff = ulong 0
  for i ulong 32
    if ne get b_dev i get g_oscv_bid i
      diff = 1
    end
  end
  if eq diff 0
    ret 5
  end
  ret 0
end

fn test_oscv_driver to long
  mbuf = new uchar 512 0
  note Write sample .osc file
  fd = fopen t_src_file 0 len t_src_file 577 420
  if lt fd 0
    ret 10
  end
  ign = write int fd t_osc_body 0 len t_osc_body
  ign = fclose int fd

  note 1. Missing source file -> exit 2
  oscv_set_paths t_empty t_empty2
  if ne oscv_run_file OSCV_DOMAIN_BUILD t_exp_a 2
    ret 11
  end

  note 2. Valid source with no store file, dev domain + --meta-out -> exit 0, tainted=1
  oscv_set_paths t_empty t_meta_out
  if ne oscv_run_file OSCV_DOMAIN_DEV t_src_file 0
    ret 12
  end
  if ne get g_oscv_tainted 0 1
    ret 13
  end
  mfd = fopen t_meta_out 0 len t_meta_out 0 0
  if lt mfd 0
    ret 14
  end
  mnr = read int mfd mbuf 0 512
  ign = fclose int mfd
  if ne mnr long get g_oscv_mlen 0
    ret 15
  end

  note 3. Corrupted store file must be refused with exit 1
  sfd = fopen t_bad_store 0 len t_bad_store 577 420
  if lt sfd 0
    ret 16
  end
  ign = write int sfd t_corrupt 0 len t_corrupt
  ign = fclose int sfd
  oscv_set_paths t_bad_store t_empty
  if ne oscv_run_file OSCV_DOMAIN_BUILD t_src_file 1
    ret 17
  end

  ign = unlink t_src_file 0 len t_src_file
  ign = unlink t_bad_store 0 len t_bad_store
  ign = unlink t_meta_out 0 len t_meta_out
  ret 0
end

fn main to int
  r = test_join_and_build_id
  if ne r 0
    ret int r
  end
  r = test_oscv_driver
  if ne r 0
    ret int r
  end
  ign = write 1 t_pass 0 len t_pass
  ret 0
end

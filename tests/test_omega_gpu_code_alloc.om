om2
note SPDX-License-Identifier: Apache-2.0
note Copyright 2026 Drake Stapleton (AIEN / aien-dev)
note
note Host test for src/omega_gpu_code_alloc.om: code + 2 KB instruction prefetch tail,
note page rounded. The NO_TAIL mutant must fail.

global g_ca_fails int 1
global g_ca_num uchar 32

text t_ca_fail "FAIL: "
text t_ca_nl "\n"
text t_ca_got " (got "
text t_ca_rp ")\n"
text t_ca_m1 "2560 B of code -> 8192"
text t_ca_m2 "2688 B of code -> 8192"
text t_ca_m3 "2048 B of code fits one page with the tail"
text t_ca_m4 "2049 B of code needs a second page"
text t_ca_m5 "empty code -> one page"
text t_ca_m6 "16 KB capacity -> 20 KB"
text t_ca_m7 "overflow refused\n"
text t_ca_m8 "overflow near the limit refused\n"
text t_ca_m9a " B of code -> "
text t_ca_m9b " B (needs >= code + 2048, page multiple)\n"
text t_ca_fhead "OMEGA_GPU_CODE_ALLOC FAIL ("
text t_ca_pass "OMEGA_GPU_CODE_ALLOC PASS\n"

fn ca_wr1 s view uchar * to void
n = len s
if eq n ulong 0
ret
end
ign = write 1 s ulong 0 n
end

fn ca_wr_u64 v ulong to void
if eq v ulong 0
put g_ca_num 0 uchar 48
ign = write 1 g_ca_num ulong 0 ulong 1
ret
end
k = ulong 0
x = v
while gt x ulong 0 bound 32
d = rem x ulong 10
put g_ca_num k uchar add d ulong 48
x = div x ulong 10
k = add k ulong 1
end
i = ulong 0
half = div k ulong 2
while lt i half bound 16
j = sub sub k ulong 1 i
t = get g_ca_num i
put g_ca_num i get g_ca_num j
put g_ca_num j t
i = add i ulong 1
end
ign = write 1 g_ca_num ulong 0 k
end

fn ca_check_eq got ulong want ulong msg view uchar * to void
if ne got want
put g_ca_fails 0 add get g_ca_fails 0 1
ca_wr1 t_ca_fail
ca_wr1 msg
ca_wr1 t_ca_got
ca_wr_u64 got
ca_wr1 t_ca_rp
end
end

fn ca_check_zero got ulong msg view uchar * to void
if ne got ulong 0
put g_ca_fails 0 add get g_ca_fails 0 1
ca_wr1 t_ca_fail
ca_wr1 msg
end
end

fn main to int
umax = ulong 0xffffffffffffffff
ca_check_eq omega_gpu_code_alloc_bytes ulong 2560 ulong 8192 t_ca_m1
ca_check_eq omega_gpu_code_alloc_bytes ulong 2688 ulong 8192 t_ca_m2
ca_check_eq omega_gpu_code_alloc_bytes ulong 2048 ulong 4096 t_ca_m3
ca_check_eq omega_gpu_code_alloc_bytes ulong 2049 ulong 8192 t_ca_m4
ca_check_eq omega_gpu_code_alloc_bytes ulong 0 ulong 4096 t_ca_m5
ca_check_eq omega_gpu_code_alloc_bytes ulong 0x4000 ulong 0x5000 t_ca_m6
ca_check_zero omega_gpu_code_alloc_bytes umax t_ca_m7
ca_check_zero omega_gpu_code_alloc_bytes sub umax ulong 2048 t_ca_m8

n = ulong 1
tail_req = ulong 2048
page = ulong 4096
while le n ulong 65536 bound 10000
b = omega_gpu_code_alloc_bytes n
bad = false
if lt b add n tail_req
bad = true
end
if ne rem b page ulong 0
bad = true
end
if gt b add add n tail_req page
bad = true
end
if bad
put g_ca_fails 0 add get g_ca_fails 0 1
ca_wr1 t_ca_fail
ca_wr_u64 n
ca_wr1 t_ca_m9a
ca_wr_u64 b
ca_wr1 t_ca_m9b
break
end
n = add n ulong 16
end

f = get g_ca_fails 0
if ne f 0
ca_wr1 t_ca_fhead
ca_wr_u64 ulong f
ca_wr1 t_ca_rp
ret 1
end
ca_wr1 t_ca_pass
ret 0
end

target x86efi
note efi 12 round trip: create \T.TXT, write "ab", close, reopen read/write, write "cd" at 2, close,
note open read-only, read back. One digit per result (low 6 bits + 48) and the four bytes read.
global pb uchar 8
global db uchar 64
global ms uchar 32

fn pr n ulong to void
r = efi 13 0 ms 0 n
end

fn main to ulong
put pb 0 92
put pb 1 84
put pb 2 46
put pb 3 84
put pb 4 88
put pb 5 84
put ms 0 61
put ms 1 61
put ms 2 66
put ms 3 10
pr 4
put db 0 97
put db 1 98
put db 2 99
put db 3 100
r = efi 12 65281 pb 0 6
w = efi 12 65283 db 0 2
c = efi 12 65284 db 0 0
u = efi 12 65285 pb 0 6
w2 = efi 12 196355 db 2 2
c2 = efi 12 65284 db 0 0
s = efi 12 65280 pb 0 6
rd = efi 12 65282 db 8 16
c3 = efi 12 65284 db 0 0
put ms 0 uchar add 48 and r 63
put ms 1 uchar add 48 and w 63
put ms 2 uchar add 48 and c 63
put ms 3 uchar add 48 and u 63
put ms 4 uchar add 48 and w2 63
put ms 5 uchar add 48 and c2 63
put ms 6 uchar add 48 and s 63
put ms 7 uchar add 48 and rd 63
put ms 8 uchar add 48 and c3 63
put ms 9 get db 8
put ms 10 get db 9
put ms 11 get db 10
put ms 12 get db 11
put ms 13 10
put ms 14 61
put ms 15 61
put ms 16 69
put ms 17 10
pr 18
ret 0
end

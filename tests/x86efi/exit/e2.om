target x86efi
note gate 7: write \X.TXT and trap 3 after the write without efi 12 sub 4; the exit must flush and close.
global pa uchar 8
global db uchar 16

fn main to ulong
put pa 0 92
put pa 1 88
put pa 2 46
put pa 3 84
put pa 4 88
put pa 5 84
i = ulong 0
while lt i 10
put db i uchar add 65 i
i = add i 1
end
r = efi 12 65281 pa 0 6
w = efi 12 65283 db 0 10
x = efi 12 65283 db 12 8
ret 0
end

note gate 3 body: one hex line per result (bit pattern of an f64/f32 or of an integer result), each
note line flushed by its own emit call, so a, b, z and k stay live across every console call.

fn hx v ulong to void
i = ulong 0
while lt i 16
d = and shr v mul sub 15 i 4 15
if lt d 10
put ms i uchar add 48 d
else
put ms i uchar add 87 d
end
i = add i 1
end
put ms 16 10
emit 17
end

fn hf x f64 to void
hx bitcast ulong x
end

fn hl x long to void
hx bitcast ulong x
end

fn fv x f64 to f64
ret x
end

fn lv x long to long
ret x
end

fn uv x ulong to ulong
ret x
end

fn run to void
a = fv 1.5
b = fv 3.25
z = fv 0.0
k = fsqrt fv 2.0
hf add a b
hf sub a b
hf mul fv 1.1 fv 3.3
hf div fv 1.0 fv 3.0
hf div a z
hf div z z
hf k
hf fsqrt fv -1.0
hf fexp fv 1.0
hf fexp fv 0.5
hf fexp fv -740.0
hf fexp fv 709.0
hf fexp fv 710.0
hf flog fv 2.0
hf flog fv 10.0
hf flog fv 1e-310
hf flog z
hf flog fv -1.0
hf f64 lv -7
hf f64 uv 18446744073709551615
hf f64 lv 9007199254740993
hl long fv 1e300
hl long fv -1e300
hl long div z z
hl long fv -2.5
hx ulong fv -5.0
hx ulong fv 1.8e19
i = int fv 3e9
hl long i
u = uchar fv 300.0
hx ulong u
s = f32 fv 0.1
hx ulong bitcast uint s
hf f64 s
hf fmin div z z fv 1.5
hf fmax fv -0.0 z
q = bitcast f64 ulong 9218868437227405313
hf add q 1.0
n = div z z
if ne n n
hx 1
else
hx 0
end
if eq n n
hx 1
else
hx 0
end
hf a
hf b
hf z
hf k
hf mul add a b k
end

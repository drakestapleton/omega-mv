target x86efi
note gate 4: efi 12 refusals. One hex line per call result; ARG = sub | volume<<8 | position<<16.
global ms uchar 64
global pa uchar 300
global db uchar 16

fn emit n ulong to void
r = efi 13 0 ms 0 n
end

fn hx v ulong to void
i = ulong 0
while lt i 16
d = and shr v mul sub 15 i 4 15
if lt d 10
put ms i uchar add 48 d
else
put ms i uchar add 87 d
end
i = add i 1
end
put ms 16 10
emit 17
end

fn mark c ulong to void
put ms 0 61
put ms 1 61
put ms 2 uchar c
put ms 3 10
emit 4
end

note pa = '\' then n-1 copies of byte c
fn fill c ulong n ulong to void
put pa 0 92
i = ulong 1
while lt i n
put pa i uchar c
i = add i 1
end
end

fn g4n to void
put pa 0 92
put pa 1 71
put pa 2 52
put pa 3 46
put pa 4 84
put pa 5 88
put pa 6 84
end

fn main to ulong
f = fsqrt 2.0f64
mark 66
fill 78 5
hx efi 12 65280 pa 0 5
fill 65 4
put pa 2 1
hx efi 12 65280 pa 0 4
fill 65 4
put pa 0 65
hx efi 12 65280 pa 0 4
fill 65 4
put pa 3 127
hx efi 12 65280 pa 0 4
fill 65 4
hx efi 12 65280 pa 0 0
fill 65 256
hx efi 12 65280 pa 0 256
fill 65 255
hx efi 12 65280 pa 0 255
g4n
hx efi 12 65281 pa 0 7
hx efi 12 65280 pa 0 7
hx efi 12 65281 pa 0 7
hx efi 12 65284 db 0 0
hx efi 12 65282 db 0 4
hx efi 12 65283 db 0 4
hx efi 12 65284 db 0 0
hx efi 12 65286 db 0 0
hx efi 12 65535 db 0 0
hx efi 12 65280 pa 0 7
hx efi 12 65283 db 0 4
hx efi 12 65284 db 0 0
hx efi 12 51200 pa 0 7
hx bitcast ulong f
mark 84
hx efi 12 65280 db 12 8
mark 69
ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_codec.om against C oracle.
om2

text g_ser_sha "95d44d05ff10e1981653c68e5247e65308b3826833a86680e4e989d00ced467e"
text g_txt_sha "846628ad66f71fbc74c69b26619922a389ae8978cbc4508e5f0eeaf180348b40"
text g_ap_id "aaaca700c857278e94fbfe672eafbdd803aab6ceb5c61d50802bbbd479b0af98"
text t_src_txt "// comment\ntype U32 = UNSIGNED_INTEGER(32);\nval a = 42;\nval b = 100;\nop ADD = ADD[WRAP];\napply app;\n"
text msg_pass "OMEGA_CODEC_OM_PASS\n"
text msg_fail "OMEGA_CODEC_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_sha256 buf view uchar * n ulong gold view uchar * to void
  for i ulong n bound 16384
    put sh_dat i get buf i
  end
  sh_all n
  for i ulong 32
    b = uint get sh_dig i
    chk eq sh_hexd shr b 4 get gold mul i 2
    chk eq sh_hexd and b 15 get gold add mul i 2 1
  end
end

fn build_oracle_graph to void
  ign = omega_graph_create
  ign = omega_build_type_unit
  itb = omega_build_type_bool
  itu32 = omega_build_type_uint 32
  ign = omega_build_type_signed_int 16
  ign = omega_build_type_fp32
  ign = omega_build_type_bitvector 64
  ign = omega_build_type_byte
  id0 = new uchar 32 0
  id1 = new uchar 32 0
  id2 = new uchar 32 0
  core_get_id ulong itu32 id0
  core_get_id ulong itb id1
  ign = omega_build_type_sequence id0 10
  ign = omega_build_type_cap_ref
  ign = omega_build_val_bool id1 true
  iva = omega_build_val_uint id0 32 42
  ivc = omega_build_val_uint id0 32 100
  ign = omega_build_param id0 7
  iop = omega_build_op_binary 3 1 id0
  core_get_id ulong iop id0
  core_get_id ulong iva id1
  core_get_id ulong ivc id2
  ign = omega_build_apply id0 id1 id2
  ign = omega_build_effect 1 2 3 ulong 0x0102030405060708
end

fn test_codec to void
  build_oracle_graph
  bin = new uchar 16384 0
  blen = new ulong 1 0
  chk eq omega_graph_serialize_binary bin 16384 blen 0
  chk eq get blen 0 1673
  chk_sha256 bin get blen 0 g_ser_sha

  txt = new uchar 16384 0
  chk eq omega_graph_format_text txt 16384 0
  tlen = ulong 0
  for i ulong 16384
    if eq get txt i 0
      tlen = i
      break
    end
  end
  chk eq tlen 1425
  chk_sha256 txt tlen g_txt_sha

  note Deserialize and re-serialize: must be byte-exact
  chk eq omega_graph_deserialize_binary bin get blen 0 0
  chk eq get g_core_obj_cnt 0 16
  bin2 = new uchar 16384 0
  blen2 = new ulong 1 0
  chk eq omega_graph_serialize_binary bin2 16384 blen2 0
  chk eq get blen2 0 1673
  for i ulong 1673
    chk eq get bin i get bin2 i
  end

  note Negative: bad magic & truncated
  put bin2 0 0
  chk eq omega_graph_deserialize_binary bin2 1673 -1
  chk eq omega_graph_deserialize_binary bin 4 -1

  note Text parser round-trip
  chk eq omega_graph_parse_text t_src_txt len t_src_txt 0
  chk eq get g_core_obj_cnt 0 5
  id_ap = new uchar 32 0
  core_get_id 4 id_ap
  for i ulong 32
    b = uint get id_ap i
    chk eq sh_hexd shr b 4 get g_ap_id mul i 2
    chk eq sh_hexd and b 15 get g_ap_id add mul i 2 1
  end
end

fn main to int
  test_codec
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

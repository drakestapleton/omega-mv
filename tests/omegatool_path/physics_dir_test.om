note
note Run-time physics resolution (src/omega_physics_dir.om): env wins, ../physics default, and clear
note failure (no guessing) when unresolvable; then the pin + clean checks of omega_physics_dir_verify.
note Pure OM-2 port of tests/omegatool_path/physics_dir_test.c (which keeps testing the C header): same cases, same stdout.
note Host only, no chip.
note
note OM-2 cannot change its own environment, so each resolve case runs this binary again
note (/proc/self/exe --resolve-child) with the environment of that case; the child calls
note omega_physics_dir_resolve, which reads PHYSICS_DIR from its real environment, and writes
note '1' + the path or '0' + the message on stdout. Failures go to stderr as "FAIL check N".

global g_pt_fails int 1
global g_pt_child uchar 16384
global g_pt_child_len ulong 1

text t_pt_fail "FAIL check "
text t_pt_nl "\n"
text t_pt_pass "test-omegatool-path-runtime: PASS\n"
text t_pt_fail_end "test-omegatool-path-runtime: FAIL\n"
text t_pt_tmp_pre "/tmp/omega_physdir_"
text t_pt_us "_"
text t_pt_phys "/phys"
text t_pt_m16 "/m16"
text t_pt_hdr "/m16/m16_native.h"
text t_pt_fake "/* fake */\n"
text t_pt_miss "/nonexistent/physics-xyz"
text t_pt_notphys "/notphys"
text t_pt_quote "/q'uote"
text t_pt_quote_name "q'uote"
text t_pt_k_unusable "unusable"
text t_pt_omega "/omega"
text t_pt_physics "/physics"
text t_pt_pgood "/pgood"
text t_pt_pother "/pother"
text t_pt_pnogit "/pnogit"
text t_pt_plock "/physics.lock"
text t_pt_nolock "/nonexistent/physics.lock"
text t_pt_badsha "deadbeef\n"
text t_pt_k_physdir "PHYSICS_DIR"
text t_pt_k_hdr "m16/m16_native.h"
text t_pt_k_def "../physics"
text t_pt_k_exp "expected commit"
text t_pt_k_dirty "dirty"
text t_pt_k_malf "malformed"
text t_pt_self "/proc/self/exe"
text t_pt_child_arg "--resolve-child"
text t_pt_sh "/bin/sh"
text t_pt_c "-c"
text t_pt_sarg "sh"
text t_pt_mk1 "mkdir -p \"$1/m16\" && echo x > \"$1/m16/m16_native.h\" && cd \"$1\" && git init -q . && git add . && git -c user.name=t -c user.email=t@t commit -q -m c"
text t_pt_mk2 "mkdir -p \"$1/m16\" && echo y > \"$1/m16/m16_native.h\" && cd \"$1\" && git init -q . && git add . && git -c user.name=t -c user.email=t@t commit -q -m c"
text t_pt_mk3 "mkdir -p \"$1/m16\" && echo x > \"$1/m16/m16_native.h\" && true"
text t_pt_dirty_sh "echo z >> \"$1/m16/m16_native.h\""
text t_pt_rmrf "rm -rf \"$1\""
text t_pt_leg_sh "cd \"$1\" && git status --porcelain 2>/dev/null"

fn pt_wr fd int s view uchar * to void
n = len s
if eq n ulong 0
ret
end
ign = write fd s ulong 0 n
end

fn pt_u64_to buf edit uchar * pos ulong v ulong to ulong
if eq v ulong 0
put buf pos uchar 48
ret add pos ulong 1
end
tmp = new uchar 32 0
k = ulong 0
x = v
while gt x ulong 0 bound 32
put tmp k uchar add rem x ulong 10 ulong 48
x = div x ulong 10
k = add k ulong 1
end
p = pos
i = ulong 0
while lt i k bound 32
put buf p get tmp sub sub k ulong 1 i
p = add p ulong 1
i = add i ulong 1
end
ret p
end

fn pt_check id int cond bool to void
nb = new uchar 32 0
if not cond
put g_pt_fails 0 add get g_pt_fails 0 1
pt_wr 2 t_pt_fail
n = pt_u64_to nb ulong 0 ulong id
ign = write 2 nb ulong 0 n
pt_wr 2 t_pt_nl
end
end

fn pt_append dst edit uchar * pos ulong s view uchar * to ulong
cap = len dst
sn = len s
p = pos
i = ulong 0
while lt i sn bound 8192
if lt p cap
put dst p get s i
p = add p ulong 1
end
i = add i ulong 1
end
ret p
end

fn pt_join dst edit uchar * a view uchar * b view uchar * to ulong
p = pt_append dst ulong 0 a
ret pt_append dst p b
end

note child result: byte 0 '1' (resolved) or '0' (refused), then the path or the message
fn pt_child_ok to bool
if eq get g_pt_child_len 0 ulong 0
ret false
end
ret eq get g_pt_child 0 uchar 49
end

fn pt_child_refused to bool
if eq get g_pt_child_len 0 ulong 0
ret false
end
ret eq get g_pt_child 0 uchar 48
end

fn pt_child_eq want view uchar * to bool
n = get g_pt_child_len 0
if ne n add len want ulong 1
ret false
end
i = ulong 0
while lt i len want bound 8192
if ne get g_pt_child add i ulong 1 get want i
ret false
end
i = add i ulong 1
end
ret true
end

note strstr over hay[off..n) of g_pt_child (which 0) or g_pd_err (which 1)
fn pt_hay_at which int i ulong to uchar
if eq which 0
ret get g_pt_child i
end
ret get g_pd_err i
end

fn pt_contains which int off ulong n ulong ned view uchar * to bool
nn = len ned
if gt add off nn n
ret false
end
lim = sub n nn
i = off
while le i lim bound 16384
ok = true
j = ulong 0
while lt j nn bound 4096
if ne pt_hay_at which add i j get ned j
ok = false
break
end
j = add j ulong 1
end
if ok
ret true
end
i = add i ulong 1
end
ret false
end

fn pt_child_has ned view uchar * to bool
ret pt_contains 0 ulong 1 get g_pt_child_len 0 ned
end

fn pt_err_has ned view uchar * to bool
ret pt_contains 1 ulong 0 get g_pd_err_len 0 ned
end

fn pt_read_u32le b view uchar * off ulong to int
v0 = ulong get b off
v1 = shl ulong get b add off ulong 1 ulong 8
v2 = shl ulong get b add off ulong 2 ulong 16
v3 = shl ulong get b add off ulong 3 ulong 24
ret int or or v0 v1 or v2 v3
end

note Runs pkt[0..pn) with env[0..en): stdout into g_pt_child, stderr inherited; returns the exit code.
fn pt_run_capture pkt view uchar * pn ulong env view uchar * en ulong to int
put g_pt_child_len 0 ulong 0
put g_pd_fd 1 0
pid = pd_spawn pkt pn env en
if lt pid long 0
ret -1
end
fd = get g_pd_fd 0
gotn = ulong 0
while lt gotn ulong 16384 bound 100000
k = read fd g_pt_child gotn sub ulong 16384 gotn
if le k long 0
break
end
gotn = add gotn ulong k
end
ig = fclose fd
put g_pt_child_len 0 gotn
ret pd_wait pid
end

note env packet: PATH, HOME (when set) and, when has_pd, "PHYSICS_DIR=" + pd
fn pt_env epkt edit uchar * has_pd bool pd view uchar * to ulong
pd_load_home
ep = pd_pkt_init epkt
ep = pd_pkt_add epkt ep t_pd_epath
ep = pd_pkt_add_home epkt ep
if not has_pd
ret ep
end
rec = new uchar 4200 0
rn = pt_join rec t_pd_env_name pd
ret pd_pkt_add epkt ep part rec ulong 0 rn
end

note one resolve in a child whose environment has PHYSICS_DIR=pd (has_pd) or no PHYSICS_DIR
fn pt_resolve_child has_pd bool pd view uchar * to int
pkt = new uchar 128 0
pp = pd_pkt_init pkt
pp = pd_pkt_add pkt pp t_pt_self
pp = pd_pkt_add pkt pp t_pt_child_arg
epkt = new uchar 4400 0
ep = pt_env epkt has_pd pd
ret pt_run_capture pkt pp epkt ep
end

fn pt_child_main to int
r = omega_physics_dir_resolve
one = new uchar 1 0
if eq r 1
put one 0 uchar 49
ign = write 1 one ulong 0 ulong 1
ign2 = write 1 g_pd_out ulong 0 get g_pd_out_len 0
ret 0
end
put one 0 uchar 48
ign = write 1 one ulong 0 ulong 1
ign2 = write 1 g_pd_err ulong 0 get g_pd_err_len 0
ret 0
end

note /bin/sh -c script sh arg ($1 = arg); stdout captured, stderr inherited; returns the exit code
fn pt_sh script view uchar * arg view uchar * to int
pkt = new uchar 8400 0
pp = pd_pkt_init pkt
pp = pd_pkt_add pkt pp t_pt_sh
pp = pd_pkt_add pkt pp t_pt_c
pp = pd_pkt_add pkt pp script
pp = pd_pkt_add pkt pp t_pt_sarg
pp = pd_pkt_add pkt pp arg
epkt = new uchar 4400 0
empty = new uchar 1 0
ep = pt_env epkt false part empty ulong 0 ulong 0
ret pt_run_capture pkt pp epkt ep
end

note The M17 check before the pin was added (d70bc4a): header exists and git status is empty.
fn pt_legacy_m17 dir view uchar * to int
rc = pt_sh t_pt_leg_sh dir
if lt rc 0
ret 0
end
if eq get g_pt_child_len 0 ulong 0
ret 1
end
ret 0
end

fn pt_mkphys root view uchar * to void
ign1 = makedir root ulong 0 len root 493
p = new uchar 4200 0
pn = pt_join p root t_pt_m16
ign2 = makedir p ulong 0 pn 493
pn = pt_join p root t_pt_hdr
fd = fopen p ulong 0 pn 577 420
if ge fd long 0
ign3 = write int fd t_pt_fake ulong 0 len t_pt_fake
ign4 = fclose int fd
end
end

fn pt_write_file path view uchar * data view uchar * to bool
fd = fopen path ulong 0 len path 577 420
if lt fd long 0
ret false
end
w = write int fd data ulong 0 len data
ign = fclose int fd
ret eq w long len data
end

note writes the HEAD sha of <base>/pgood (first 40 bytes of the rev-parse output) + "\n" to
note <base>/physics.lock
fn pt_pin base view uchar * to void
good = new uchar 4200 0
lock = new uchar 4200 0
sha = new uchar 41 0
gn = pt_join good base t_pt_pgood
ln = pt_join lock base t_pt_plock
rc = pd_run_git part good ulong 0 gn t_pd_revparse t_pd_head
pt_check 103 and eq rc 0 ge get g_pd_got_len 0 ulong 40
i = ulong 0
while lt i ulong 40 bound 64
put sha i get g_pd_got i
i = add i ulong 1
end
put sha ulong 40 uchar 10
pt_check 104 pt_write_file part lock ulong 0 ln sha
end

note which 0: pgood (repo, x)  1: pother (repo, y)  2: pnogit (no repo, x)
fn pt_mkrepo which int base view uchar * to void
d = new uchar 4200 0
if eq which 0
dn = pt_join d base t_pt_pgood
pt_check 100 eq pt_sh t_pt_mk1 part d ulong 0 dn 0
end
if eq which 1
dn = pt_join d base t_pt_pother
pt_check 101 eq pt_sh t_pt_mk2 part d ulong 0 dn 0
end
if eq which 2
dn = pt_join d base t_pt_pnogit
pt_check 102 eq pt_sh t_pt_mk3 part d ulong 0 dn 0
end
end

note red on the old check: an unrelated clean repo and a non-repo both pass it
fn pt_verify_legacy base view uchar * to void
other = new uchar 4200 0
nogit = new uchar 4200 0
on = pt_join other base t_pt_pother
nn = pt_join nogit base t_pt_pnogit
pt_check 105 eq pt_legacy_m17 part other ulong 0 on 1
pt_check 106 eq pt_legacy_m17 part nogit ulong 0 nn 1
end

note the new check fails closed on both: the error names the directory (and the pin for a repo)
fn pt_verify_closed id int base view uchar * suffix view uchar * repo bool to void
d = new uchar 4200 0
lock = new uchar 4200 0
dn = pt_join d base suffix
ln = pt_join lock base t_pt_plock
pt_check id eq omega_physics_dir_verify part d ulong 0 dn part lock ulong 0 ln 1 0
if repo
pt_check add id 1 pt_err_has t_pt_k_exp
end
pt_check add id 2 pt_err_has part d ulong 0 dn
end

fn pt_verify_good good view uchar * lock view uchar * to void
pt_check 112 eq omega_physics_dir_verify good lock 1 1
pt_check 113 eq pt_sh t_pt_dirty_sh good 0
pt_check 114 eq omega_physics_dir_verify good lock 1 0
pt_check 115 pt_err_has t_pt_k_dirty
note pin-only mode (M18/M19)
pt_check 116 eq omega_physics_dir_verify good lock 0 1
pt_check 117 pt_write_file lock t_pt_badsha
pt_check 118 eq omega_physics_dir_verify good lock 0 0
pt_check 119 pt_err_has t_pt_k_malf
pt_check 120 eq omega_physics_dir_verify good t_pt_nolock 0 0
end

note Pin + clean checks (omega_physics_dir_verify).
fn pt_verify_cases base view uchar * to void
pt_mkrepo 0 base
pt_mkrepo 1 base
pt_mkrepo 2 base
pt_pin base
pt_verify_legacy base
pt_verify_closed 107 base t_pt_pother true
pt_verify_closed 110 base t_pt_pnogit false
good = new uchar 4200 0
lock = new uchar 4200 0
gn = pt_join good base t_pt_pgood
ln = pt_join lock base t_pt_plock
pt_verify_good part good ulong 0 gn part lock ulong 0 ln
end

fn pt_resolve_env base view uchar * want view uchar * to void
pbuf = new uchar 4200 0
wbuf = new uchar 4200 0
note 1. env set to a valid checkout
pn = pt_join pbuf base t_pt_phys
pt_mkphys part pbuf ulong 0 pn
pt_check 1 eq pt_resolve_child true part pbuf ulong 0 pn 0
pt_check 2 pt_child_ok
wn = pt_join wbuf want t_pt_phys
pt_check 3 pt_child_eq part wbuf ulong 0 wn
note 2. env set to a missing dir: refuse, message names the value and the variable
pt_check 4 eq pt_resolve_child true t_pt_miss 0
pt_check 5 pt_child_refused
pt_check 6 pt_child_has t_pt_miss
pt_check 7 pt_child_has t_pt_k_physdir
note 3. env set to a dir that is not physics: refuse, never fall back to ../physics
pn = pt_join pbuf base t_pt_notphys
ign = makedir pbuf ulong 0 pn 493
pt_check 8 eq pt_resolve_child true part pbuf ulong 0 pn 0
pt_check 9 pt_child_refused
pt_check 10 pt_child_has t_pt_k_hdr
end

note 3b. a real checkout whose real path holds a quote: refuse (the gate runners single-quote it)
fn pt_resolve_quote base view uchar * to void
pbuf = new uchar 4200 0
pn = pt_join pbuf base t_pt_quote
pt_mkphys part pbuf ulong 0 pn
pt_check 21 eq pt_resolve_child true part pbuf ulong 0 pn 0
pt_check 22 pt_child_refused
pt_check 23 pt_child_has t_pt_k_unusable
pt_check 24 pt_child_has t_pt_quote_name
end

fn pt_resolve_default base view uchar * want view uchar * to void
pbuf = new uchar 4200 0
wbuf = new uchar 4200 0
empty = new uchar 1 0
note 4. env empty or unset: default ../physics relative to cwd; absent -> refuse
pn = pt_join pbuf base t_pt_omega
ign = makedir pbuf ulong 0 pn 493
pt_check 11 eq chdir pbuf ulong 0 pn long 0
pt_check 12 eq pt_resolve_child true part empty ulong 0 ulong 0 0
pt_check 13 pt_child_refused
pt_check 14 pt_child_has t_pt_k_def
pt_check 15 eq pt_resolve_child false part empty ulong 0 ulong 0 0
pt_check 16 pt_child_refused
pn = pt_join pbuf base t_pt_physics
pt_mkphys part pbuf ulong 0 pn
pt_check 17 eq pt_resolve_child false part empty ulong 0 ulong 0 0
pt_check 18 pt_child_ok
wn = pt_join wbuf want t_pt_physics
pt_check 19 pt_child_eq part wbuf ulong 0 wn
end

fn pt_is_child to bool
if lt argcnt long 2
ret false
end
ab = new uchar 32 0
n = argread ulong 1 ab ulong 0 ulong 32
if ne n long len t_pt_child_arg
ret false
end
i = ulong 0
while lt i len t_pt_child_arg bound 32
if ne get ab i get t_pt_child_arg i
ret false
end
i = add i ulong 1
end
ret true
end

note base = /tmp/omega_physdir_<pid>_<ns>, created 0700 (the C mkdtemp); returns its length or 0
fn pt_mkbase base edit uchar * to ulong
bp = pt_append base ulong 0 t_pt_tmp_pre
bp = pt_u64_to base bp ulong getpid
bp = pt_append base bp t_pt_us
bp = pt_u64_to base bp rem ulong monons ulong 1000000000
if ne makedir base ulong 0 bp 448 long 0
ret ulong 0
end
ret bp
end

fn main to int
if pt_is_child
ret pt_child_main
end
base = new uchar 256 0
bp = pt_mkbase base
if eq bp ulong 0
ret 2
end
note want = realpath(base)
k = ulong 0
while lt k bp bound 256
put g_pd_val k get base k
k = add k ulong 1
end
rl = pd_realpath_dir bp
if lt rl long 0
ret 2
end
want = new uchar 4096 0
wn = ulong rl
i = ulong 0
while lt i wn bound 4096
put want i get g_pd_real i
i = add i ulong 1
end
pt_resolve_env part base ulong 0 bp part want ulong 0 wn
pt_resolve_quote part base ulong 0 bp
pt_resolve_default part base ulong 0 bp part want ulong 0 wn
pt_verify_cases part base ulong 0 bp
ign = pt_sh t_pt_rmrf part base ulong 0 bp
if ne get g_pt_fails 0 0
pt_wr 1 t_pt_fail_end
ret 1
end
pt_wr 1 t_pt_pass
ret 0
end

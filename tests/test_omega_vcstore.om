note
note tests/test_omega_vcstore.om -- standalone pure OM-2 test for src/omega_vcstore.om
note Verifies ALL 17 golden vectors from tests/vcstore/golden/ (exact SHA-256 VC IDs
note and exact refusal codes), store insert/immutability/idempotency/bootstrap refusal,
note post-order dependency closure, state & name-index digests, name bind/rebind/resolve,
note and binary save/load roundtrip with tamper refusal.

text g_v01 "tests/vcstore/golden/v01_minimal.hex"
text g_v02 "tests/vcstore/golden/v02_deps.hex"
text g_v03 "tests/vcstore/golden/v03_capabilities.hex"
text g_v04 "tests/vcstore/golden/v04_ir_kind.hex"
text g_r01 "tests/vcstore/golden/r01_duplicate_dep.hex"
text g_r02 "tests/vcstore/golden/r02_unsorted_deps.hex"
text g_r03 "tests/vcstore/golden/r03_zero_receipt_id.hex"
text g_r04 "tests/vcstore/golden/r04_self_dependency.hex"
text g_r05 "tests/vcstore/golden/r05_trailing_byte.hex"
text g_r06 "tests/vcstore/golden/r06_unknown_version.hex"
text g_r07 "tests/vcstore/golden/r07_truncated.hex"
text g_r08 "tests/vcstore/golden/r08_bad_domain_tag.hex"
text g_r09 "tests/vcstore/golden/r09_unsorted_exports.hex"
text g_r10 "tests/vcstore/golden/r10_bad_digest_kind.hex"
text g_r11 "tests/vcstore/golden/r11_zero_id.hex"
text g_r12 "tests/vcstore/golden/r12_bad_string.hex"
text g_r13 "tests/vcstore/golden/r13_too_many_entries.hex"

text e_v01 "27890b090acc8b8e91ecf49bb4249fc99867824d0854f931e5f8fb9ce1497325"
text e_v02 "fa5a0e8f496b9f8d81b6f942bd56604b5b9a98252999ede6cb62dff6e7374f7f"
text e_v03 "94b84bf74e22f684d9400b9b31ccfa579f8eec434cb75589231402e2954f3e6d"
text e_v04 "8d7dd4699e1781b20d4a01421be6779c68da483ff3d9b1899cb1fa0163dfb5c6"

text t_save_path "/tmp/om_vcstore_test.bin"
text t_name_a "alpha_mod.1"
text t_name_b "beta-mod"
text t_name_bad "9bad"
text t_pass "PASS test_omega_vcstore\n"

global t_raw uchar 65536
global t_bin uchar 32768
global t_blen ulong 1
global t_v01_sid uchar 32
global t_v04_sid uchar 32

fn hex_nib c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long sub c 87
  end
  if and ge c 65 le c 70
    ret long sub c 55
  end
  ret neg long 1
end

fn decode_hex_raw n ulong to long
  out_n = ulong 0
  hi = long neg long 1
  for i ulong n bound 65536
    v = hex_nib ulong get t_raw i
    if ge v 0
      if lt hi 0
        hi = v
      else
        b = uchar or shl ulong hi 4 ulong v
        put t_bin out_n b
        out_n = add out_n 1
        hi = neg long 1
      end
    end
  end
  put t_blen 0 out_n
  ret long out_n
end

fn load_hex_file path view uchar * plen ulong to long
  fd = fopen path 0 plen 0 0
  if lt fd 0
    ret neg long 1
  end
  nr = read int fd t_raw 0 65536
  ign = fclose int fd
  if lt nr 0
    ret neg long 1
  end
  ret decode_hex_raw ulong nr
end

fn check_hex32 vid view uchar 32 exp_hex view uchar * to bool
  for i ulong 32
    hi = hex_nib ulong get exp_hex mul i 2
    lo = hex_nib ulong get exp_hex add mul i 2 1
    eb = uchar or shl ulong hi 4 ulong lo
    if ne get vid i eb
      ret false
    end
  end
  ret true
end

fn check_accept path view uchar * exp_hex view uchar * to long
  buf = new uchar 32768 0
  vid = new uchar 32 0
  n = load_hex_file path len path
  if lt n 0
    ret 1
  end
  bl = ulong n
  for i ulong bl bound 32768
    put buf i get t_bin i
  end
  rc = omega_vc_decode buf bl
  if ne rc VCS_OK
    ret 2
  end
  omega_vc_compute_id buf bl vid
  if not check_hex32 vid exp_hex
    ret 3
  end
  ret 0
end

fn check_refuse path view uchar * exp_code ulong to long
  buf = new uchar 32768 0
  n = load_hex_file path len path
  if lt n 0
    ret 1
  end
  bl = ulong n
  for i ulong bl bound 32768
    put buf i get t_bin i
  end
  rc = omega_vc_decode buf bl
  if ne rc exp_code
    ret 2
  end
  ret 0
end

fn test_golden_vectors to long
  if ne check_accept g_v01 e_v01 0
    ret 10
  end
  if ne check_accept g_v02 e_v02 0
    ret 11
  end
  if ne check_accept g_v03 e_v03 0
    ret 12
  end
  if ne check_accept g_v04 e_v04 0
    ret 13
  end
  if ne check_refuse g_r01 VCS_DUPLICATE_DEPENDENCY 0
    ret 21
  end
  if ne check_refuse g_r02 VCS_UNSORTED_DEPENDENCIES 0
    ret 22
  end
  if ne check_refuse g_r03 VCS_MISSING_RECEIPT 0
    ret 23
  end
  if ne check_refuse g_r04 VCS_DEPENDENCY_CYCLE 0
    ret 24
  end
  if ne check_refuse g_r05 VCS_TRAILING_BYTES 0
    ret 25
  end
  if ne check_refuse g_r06 VCS_UNKNOWN_FORMAT_VERSION 0
    ret 26
  end
  if ne check_refuse g_r07 VCS_TRUNCATED 0
    ret 27
  end
  if ne check_refuse g_r08 VCS_BAD_DOMAIN_TAG 0
    ret 28
  end
  if ne check_refuse g_r09 VCS_NONCANONICAL_SET 0
    ret 29
  end
  if ne check_refuse g_r10 VCS_BAD_DIGEST_KIND 0
    ret 30
  end
  if ne check_refuse g_r11 VCS_ZERO_ID 0
    ret 31
  end
  if ne check_refuse g_r12 VCS_BAD_STRING 0
    ret 32
  end
  if ne check_refuse g_r13 VCS_TOO_MANY_ENTRIES 0
    ret 33
  end
  ret 0
end

fn test_store_lifecycle to long
  b1 = new uchar 2048 0
  id1 = new uchar 32 0
  bad_id = new uchar 32 0
  if ne omega_vcstore_init VCS_OK
    ret 40
  end
  note Load v01_minimal and insert it
  n1 = load_hex_file g_v01 len g_v01
  if lt n1 0
    ret 41
  end
  l1 = ulong n1
  for i ulong l1 bound 2048
    put b1 i get t_bin i
  end
  omega_vc_compute_id b1 l1 id1
  note Bootstrap insert must be refused (GENESIS_NOT_LISTED)
  if ne omega_vcstore_insert_bootstrap b1 l1 id1 VCS_GENESIS_NOT_LISTED
    ret 42
  end
  note Claimed id mismatch must be refused
  for i ulong 32
    put bad_id i get id1 i
  end
  put bad_id 0 xor get bad_id 0 1
  if ne omega_vcstore_insert b1 l1 bad_id VCS_ID_MISMATCH
    ret 43
  end
  note Valid insert succeeds; identical re-insert is idempotent no-op
  if ne omega_vcstore_insert b1 l1 id1 VCS_OK
    ret 44
  end
  if ne omega_vcstore_insert b1 l1 id1 VCS_OK
    ret 45
  end
  if ne omega_vcstore_count 1
    ret 46
  end
  note Save v01 semantic_id
  soff = get g_vcv_sid_off 0
  for i ulong 32
    put t_v01_sid i get g_vcs_decbuf add soff i
  end
  note Load v04_ir_kind (same semantic_id 0x11.., different bytes) -> must refuse IMMUTABLE_CONFLICT
  n4 = load_hex_file g_v04 len g_v04
  if lt n4 0
    ret 47
  end
  l4 = ulong n4
  for i ulong l4 bound 2048
    put b1 i get t_bin i
  end
  omega_vc_compute_id b1 l4 id1
  if ne omega_vcstore_insert b1 l4 id1 VCS_IMMUTABLE_CONFLICT
    ret 71
  end
  note Derive a second distinct zero-dep record by changing semantic_id[0] of v04 to 0x19
  put b1 26 25
  omega_vc_compute_id b1 l4 id1
  if ne omega_vcstore_insert b1 l4 id1 VCS_OK
    ret 72
  end
  if ne omega_vcstore_count 2
    ret 49
  end
  soff = get g_vcv_sid_off 0
  for i ulong 32
    put t_v04_sid i get g_vcs_decbuf add soff i
  end
  ret 0
end

fn test_persist_roundtrip to long
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  res = new uchar 32 0
  if ne omega_vcstore_digest d1 VCS_OK
    ret 61
  end
  if ne omega_vcstore_name_index_digest d2 VCS_OK
    ret 62
  end
  if ne omega_vcstore_save t_save_path len t_save_path VCS_OK
    ret 63
  end
  omega_vcstore_destroy
  if ne omega_vcstore_count 0
    ret 64
  end
  if ne omega_vcstore_load t_save_path len t_save_path VCS_OK
    ret 65
  end
  if ne omega_vcstore_count 2
    ret 66
  end
  ign1 = omega_vcstore_digest res
  for i ulong 32
    if ne get d1 i get res i
      ret 67
    end
  end
  ign2 = omega_vcstore_name_index_digest res
  for i ulong 32
    if ne get d2 i get res i
      ret 68
    end
  end
  ign_u = unlink t_save_path 0 len t_save_path
  ret 0
end

fn test_names_closure_persist to long
  s1 = new uchar 32 0
  s4 = new uchar 32 0
  res = new uchar 32 0
  for i ulong 32
    put s1 i get t_v01_sid i
    put s4 i get t_v04_sid i
  end
  note Admission kind and receipt_of
  if ne omega_vcstore_admission_kind s1 long VCS_ADMISSION_VERIFIED
    ret 50
  end
  if ne omega_vcstore_receipt_of s1 res VCS_OK
    ret 51
  end
  note Closure of s1 (1 element, itself)
  if ne omega_vcstore_closure s1 1 VCS_OK
    ret 52
  end
  if ne get g_vcs_out_n 0 1
    ret 53
  end
  note Name bind, bad name refusal, duplicate conflict, rebind, resolve
  if ne omega_vcstore_name_bind t_name_bad len t_name_bad s1 VCS_MALFORMED
    ret 54
  end
  if ne omega_vcstore_name_bind t_name_a len t_name_a s1 VCS_OK
    ret 55
  end
  if ne omega_vcstore_name_bind t_name_a len t_name_a s4 VCS_NAME_EXISTS
    ret 56
  end
  if ne omega_vcstore_name_rebind t_name_a len t_name_a s4 VCS_OK
    ret 57
  end
  if ne omega_vcstore_name_bind t_name_b len t_name_b s1 VCS_OK
    ret 58
  end
  if ne omega_vcstore_resolve_name t_name_a len t_name_a res VCS_OK
    ret 59
  end
  for i ulong 32
    if ne get res i get s4 i
      ret 60
    end
  end
  ret test_persist_roundtrip
end

fn main to int
  r = test_golden_vectors
  if ne r 0
    ret int r
  end
  r = test_store_lifecycle
  if ne r 0
    ret int r
  end
  r = test_names_closure_persist
  if ne r 0
    ret int r
  end
  ign = write 1 t_pass 0 len t_pass
  ret 0
end

note
note tests/test_forge_realization.om -- standalone pure OM-2 test for src/forge_realization.om

text t_empty ""
text t_ir "OMEGA_IR_PAYLOAD_01"
text t_desc "GB10_SM121_DESC_A"
text t_desc_other "GB10_SM121_DESC_B"
text t_pass "PASS test_forge_realization\n"

fn main to int
  pdig = new uchar 32 0
  ev1 = new uchar 32 0
  ev2 = new uchar 32 0
  for i ulong 32
    put pdig i uchar add i 17
  end
  note Uninitialized realize must refuse
  if ne omega_forge_realize neg long 1
    ret 1
  end
  note Empty descriptor must refuse
  if ne omega_realization_request_init pdig 4 t_ir t_empty neg long 1
    ret 2
  end
  note Valid init and realize
  if ne omega_realization_request_init pdig 4 t_ir t_desc 0
    ret 3
  end
  if ne omega_forge_realize 0
    ret 4
  end
  note Unverified submission must fail closed (-1)
  if ne omega_forge_submit 0 t_desc len t_desc ev1 neg long 1
    ret 5
  end
  note Mismatched live descriptor must fail closed (-2)
  if ne omega_forge_submit 1 t_desc_other len t_desc_other ev1 neg long 2
    ret 6
  end
  note Verified submission with matching descriptor succeeds deterministically
  if ne omega_forge_submit 1 t_desc len t_desc ev1 0
    ret 7
  end
  if ne omega_forge_submit 1 t_desc len t_desc ev2 0
    ret 8
  end
  nz = ulong 0
  for i ulong 32
    if ne get ev1 i get ev2 i
      ret 9
    end
    if ne get ev1 i 0
      nz = 1
    end
  end
  if eq nz 0
    ret 10
  end
  ign = write 1 t_pass 0 len t_pass
  ret 0
end

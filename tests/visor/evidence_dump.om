note SPDX-License-Identifier: Apache-2.0
note evidence_dump.om -- the pure OM-2 side of tests/visor/evidence_parity.sh. Built after the
note shipped evidence modules (mk/visor-verify.mk VISOR_EVIDENCE_OM_SRCS: visor.om,
note visor_evidence.om). Reads the corpus commands on stdin, in the directory holding the corpus
note trees, and prints, line for line, what the retired C reference dumper printed from
note visor_evidence_scan, _for_id, _load, _set_max_files and _format_text/_json (the goldens in
note tests/visor/evidence_golden). Commands: S root | I root hex64 | L path | M cap; the tree
note lines of the corpus (F Z B N H K D) are skipped.

text ed_eq "== "
text ed_rc " rc="
text ed_xt " t="
text ed_xj " j="
text ed_json "--json\n"
text ed_tn "tn: "
text ed_jn "jn: "
text ed_badid "== I badid\n"
text ed_m "M "

global ed_out uchar 262144
global ed_ol ulong 1
global ed_a uchar 65536
global ed_al ulong 1
global ed_inb uchar 4194304

fn ed_flush to void
  n = get ed_ol 0
  off = ulong 0
  while lt off n bound 262144
    k = write 1 ed_out off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
  put ed_ol 0 0
end

fn ed_c c ulong to void
  p = get ed_ol 0
  if ge p 262144
    ed_flush
    p = 0
  end
  put ed_out p uchar c
  put ed_ol 0 add p 1
end

fn ed_t s view uchar * to void
  n = len s
  for i ulong n bound 256
    ed_c ulong get s i
  end
end

fn ed_u v ulong to void
  nb = new uchar 24 0
  x = v
  nd = ulong 0
  while lt nd 21 bound 24
    put nb nd uchar add 48 rem x 10
    nd = add nd 1
    x = div x 10
    if eq x 0
      break
    end
  end
  while gt nd 0 bound 24
    nd = sub nd 1
    ed_c ulong get nb nd
  end
end

fn ed_d v long to void
  if lt v 0
    ed_c 45
    ed_u ulong sub 0 v
    ret
  end
  ed_u ulong v
end

fn ed_fmt js ulong n ulong to long
  if eq js 0
    ret vev_format_text n
  end
  ret vev_format_json n
end

fn ed_sizes js ulong full long to void
  if eq js 0
    ed_t ed_tn
  else
    ed_t ed_jn
  end
  f = ulong full
  for k ulong 4
    n = f
    if eq k 1
      n = add f 1
    end
    if eq k 2
      n = 1
    end
    if eq k 3
      n = 0
    end
    if gt k 0
      ed_c 32
    end
    ed_d ed_fmt js n
  end
  ed_c 10
end

fn ed_show c ulong rc long to void
  t = vev_format_text 65536
  tl = get v_ob_len 0
  for i ulong tl bound 65536
    put ed_a i get v_ob i
  end
  put ed_al 0 tl
  j = vev_format_json 65536
  ed_t ed_eq
  ed_c c
  ed_t ed_rc
  ed_d rc
  ed_t ed_xt
  ed_d t
  ed_t ed_xj
  ed_d j
  ed_c 10
  if gt t 0
    n = get ed_al 0
    for i ulong n bound 65536
      ed_c ulong get ed_a i
    end
  end
  ed_t ed_json
  if gt j 0
    n2 = get v_ob_len 0
    for i ulong n2 bound 65536
      ed_c ulong get v_ob i
    end
  end
  ed_c 10
  if gt t 0
    ed_sizes 0 t
  end
  if gt j 0
    ed_sizes 1 j
  end
end

note the argument [s, e) into vev_root; its length
fn ed_root s ulong e ulong to ulong
  n = sub e s
  for k ulong n bound 4096
    put vev_root k get ed_inb add s k
  end
  ret n
end

fn ed_hexv c ulong to long
  if and ge c 48 le c 57
    ret long sub c 48
  end
  if and ge c 97 le c 102
    ret long sub c 87
  end
  if and ge c 65 le c 70
    ret long sub c 55
  end
  ret -1
end

note the 64 hex digits at s into vev_qid; false unless exactly 64 hex digits end at e
fn ed_qid s ulong e ulong to bool
  if ne sub e s 64
    ret false
  end
  for k ulong 32
    h = ed_hexv ulong get ed_inb add s mul k 2
    l = ed_hexv ulong get ed_inb add s add mul k 2 1
    if or lt h 0 lt l 0
      ret false
    end
    put vev_qid k uchar add mul ulong h 16 ulong l
  end
  ret true
end

fn ed_line s ulong e ulong to void
  c = ulong get ed_inb s
  a = add s 2
  if gt a e
    a = e
  end
  if eq c 83
    ed_show c vev_scan ed_root a e
  end
  if eq c 73
    sp = e
    found = false
    while gt sp a bound 8192
      sp = sub sp 1
      if eq get ed_inb sp 32
        found = true
        break
      end
    end
    ok = false
    if found
      ok = ed_qid add sp 1 e
    end
    if ok
      ed_show c vev_for_id ed_root a sp
    else
      ed_t ed_badid
    end
  end
  if eq c 76
    n = sub e a
    for k ulong n bound 4096
      put vev_pbuf k get ed_inb add a k
    end
    put vev_plen 0 n
    vev_view_reset
    rc = vev_load
    if eq rc 0
      vev_view_add
    end
    ed_show c rc
  end
  if eq c 77
    v = ulong 0
    for k ulong sub e a bound 24
      v = add mul v 10 sub ulong get ed_inb add a k 48
    end
    ed_t ed_m
    ed_u vev_set_max_files v
    ed_c 10
  end
  ed_flush
end

fn main to int
  put ed_ol 0 0
  total = ulong 0
  while lt total 4194304 bound 100000
    r = read 0 ed_inb total sub 4194304 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  p = ulong 0
  while lt p total bound 4194305
    if eq get ed_inb p 10
      e = p
      if and gt e start eq get ed_inb sub e 1 13
        e = sub e 1
      end
      if gt e start
        if ne get ed_inb start 35
          ed_line start e
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  ed_flush
  ret 0
end

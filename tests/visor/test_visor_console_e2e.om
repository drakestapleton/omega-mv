global te_host uchar 128
global te_hlen ulong 1
global te_src uchar 131072
global te_slen ulong 1
global te_ma uchar 131072
global te_mal ulong 1
global te_mb uchar 131072
global te_mbl ulong 1
global te_sink long 1

fn e2e_open json ulong to void
  put tst_real 0 1
  put te_sink 0 omega_tool_session_init
  vcon_init json
  vcon_capture 1
  sl = len te_evroot
  for i ulong sl bound 64
    put vcon_evroot i get te_evroot i
  end
  put vcon_evlen 0 sl
  put vcon_has_evroot 0 1
end

note Is the prompt (CE A9 '>' ' ') at te_src[p]?
fn te_is_prompt p ulong to bool
  if gt add p 4 get te_slen 0
    ret false
  end
  a = and eq get te_src p 206 eq get te_src add p 1 169
  b = and eq get te_src add p 2 62 eq get te_src add p 3 32
  ret and a b
end

fn te_src_has_at p ulong s view uchar * to bool
  sl = len s
  if gt add p sl get te_slen 0
    ret false
  end
  for i ulong sl bound 64
    if ne get te_src add p i get s i
      ret false
    end
  end
  ret true
end

note e2e_machine_block on te_src: host name into te_host.
fn e2e_machine_block to bool
  n = get te_slen 0
  b = ulong 0
  found = false
  for p ulong n bound 131072
    if te_is_prompt p
      if te_src_has_at add p 4 te_echo_mach
        b = add p 12
        found = true
        break
      end
    end
  end
  if not found
    ret false
  end
  e = b
  while lt e n bound 131072
    if te_is_prompt e
      break
    end
    e = add e 1
  end
  if ge b e
    ret false
  end
  if not te_src_has_at b te_machine_sp
    ret false
  end
  prov = false
  pl = len te_prov
  if ge sub e b pl
    for q ulong add sub sub e b pl 1 bound 131072
      if te_src_has_at add b q te_prov
        prov = true
        break
      end
    end
  end
  if not prov
    ret false
  end
  hl = ulong 0
  while lt add add b 8 hl e bound 128
    if eq get te_src add add b 8 hl 10
      break
    end
    hl = add hl 1
  end
  if or eq hl 0 ge hl 128
    ret false
  end
  for i ulong hl bound 128
    put te_host i get te_src add add b 8 i
  end
  put te_hlen 0 hl
  ret true
end

fn te_out_b to_b bool c uchar to void
  if to_b
    nb = get te_mbl 0
    if lt nb 131072
      put te_mb nb c
      put te_mbl 0 add nb 1
    end
  else
    na = get te_mal 0
    if lt na 131072
      put te_ma na c
      put te_mal 0 add na 1
    end
  end
end

fn te_out_txt to_b bool s view uchar * to void
  for i ulong len s bound 128
    te_out_b to_b get s i
  end
end

fn te_host_at p ulong to bool
  for j ulong get te_hlen 0 bound 128
    if ne get te_src add p j get te_host j
      ret false
    end
  end
  ret true
end

note Does line te_src[i, i+ll) contain the host name?
fn te_line_has_host i ulong ll ulong to bool
  hl = get te_hlen 0
  if or eq hl 0 gt hl ll
    ret false
  end
  for k ulong add sub ll hl 1 bound 131072
    if te_host_at add i k
      ret true
    end
  end
  ret false
end

note e2e_mask of te_src into te_ma (to_b false) or te_mb (to_b true).
fn e2e_mask to_b bool to void
  if to_b
    put te_mbl 0 0
  else
    put te_mal 0 0
  end
  n = get te_slen 0
  i = ulong 0
  inm = false
  while lt i n bound 131072
    e = i
    while lt e n bound 131072
      if eq get te_src e 10
        break
      end
      e = add e 1
    end
    ll = sub e i
    if lt e n
      ll = add ll 1
    end
    echo = te_is_prompt i
    if echo
      inm = and eq ll 12 te_src_has_at add i 4 te_echo_mach
    end
    if inm
      if echo
        te_out_txt to_b te_mark_mach
      end
    else
      if and not echo te_line_has_host i ll
        te_out_txt to_b te_mark_line
      else
        for k ulong ll bound 131072
          te_out_b to_b get te_src add i k
        end
      end
    end
    i = add i ll
  end
end

fn te_src_from_cap to void
  n = get vcon_caplen 0
  if gt n 131072
    n = 131072
  end
  for i ulong n bound 131072
    put te_src i get vcon_cap i
  end
  put te_slen 0 n
end

fn te_src_from_file path view uchar * to long
  fd = fopen path 0 len path 0 0
  put te_slen 0 0
  if lt fd 0
    ret -1
  end
  n = ulong 0
  while lt n 131072 bound 4096
    k = read int fd te_src n sub 131072 n
    if le k 0
      break
    end
    n = add n ulong k
  end
  put te_slen 0 n
  put te_sink 0 long fclose int fd
  ret 0
end

fn te_masks_equal to bool
  n = get te_mal 0
  if ne n get te_mbl 0
    ret false
  end
  for i ulong n bound 131072
    if ne get te_ma i get te_mb i
      ret false
    end
  end
  ret true
end

note Does the capture contain prompt bytes + text s?
fn te_cap_has_echo s view uchar * to bool
  tw_reset
  tw_b 206
  tw_b 169
  tw_txt s
  put tg_off 0 0
  put tg_len 0 get vcon_caplen 0
  ret tg_has_tw
end

fn te_cap_has s view uchar * to bool
  tw_set s
  put tg_off 0 0
  put tg_len 0 get vcon_caplen 0
  ret tg_has_tw
end

fn test_e2e_session to void
  put tst_real 0 1
  w = true
  for h ulong 17
    if not vcon_hook_wired h
      w = false
    end
  end
  tc_check w ten_wired
  er = te_src_from_file te_epath
  sfd = fopen te_spath 0 len te_spath 0 0
  tc_check and eq er 0 ge sfd 0 ten_files
  if or ne er 0 lt sfd 0
    ret
  end
  e2e_open 0
  rc = vcon_run_fd int sfd true false
  put te_sink 0 long fclose int sfd
  te_src_from_cap
  ok = e2e_machine_block
  tc_check and ok gt get te_hlen 0 0 ten_block
  e2e_mask false
  er2 = te_src_from_file te_epath
  e2e_mask true
  same = and eq er2 0 te_masks_equal
  tc_check same ten_same
  tc_check eq rc 0 ten_rc
  k12 = and te_cap_has_echo te_k1 te_cap_has_echo te_k2
  tc_check and k12 and te_cap_has_echo te_k3 te_cap_has_echo te_k4 ten_keys
  tc_check and te_cap_has te_r1 te_cap_has te_r2 ten_rids
  v12 = and te_cap_has te_v1 te_cap_has te_v2
  v34 = and te_cap_has te_v3 te_cap_has te_v4
  tc_check and and v12 v34 te_cap_has te_v5 ten_vrows
  tc_check and te_cap_has te_noev te_cap_has te_noeff ten_noev
end

note Output region of the last h_exec contains s?
fn te_got_has s view uchar * to bool
  tw_set s
  ret tg_has_tw
end

fn test_e2e_json to void
  e2e_open 1
  tl_set te_let7
  h_exec
  tc_check and eq get tg_rc 0 0 te_got_has te_val7 ten_jlet
  tl_set te_xx
  h_exec
  tc_check and eq get tg_rc 0 0 te_got_has te_val14 ten_jxx
  tl_set te_run_
  h_exec
  tw_set te_runpfx
  pfx = ge get tg_len 0 get tw_n 0
  if pfx
    o = get tg_off 0
    for i ulong get tw_n 0 bound 256
      if ne get vcon_cap add o i get tw_buf i
        pfx = false
      end
    end
  end
  tc_check and eq get tg_rc 0 0 pfx ten_jrun
  lines = ulong 0
  for i ulong get vcon_caplen 0 bound 131072
    if eq get vcon_cap i 10
      lines = add lines 1
    end
  end
  tc_check eq lines 3 ten_jlines
  tl_set te_alt_x
  h_exec
  tc_check and eq get tg_rc 0 1 te_got_has te_alt_m ten_alt
  tl_set te_eff_x
  h_exec
  tc_check and eq get tg_rc 0 1 te_got_has te_eff_m ten_eff
  tl_set te_world
  h_exec
  tc_check and eq get tg_rc 0 0 te_got_has te_world_m ten_world
end

fn test_e2e_d2 to void
  e2e_open 0
  exs te_fn te_fn_o
  ex_tw 0 ten_d2fn
  exs te_runf te_runf_o
  ex_tw 1 ten_d2r0
  exs te_runf56 te_runf56_o
  ex_tw 1 ten_d2r56
  exs te_runf5 te_runf5_o
  ex_tw 0 ten_d2r5
  exs te_let7 te_let7_o
  ex_tw 0 ten_d2x
  exs te_lety te_lety_o
  ex_tw 0 ten_d2y
  exs te_xy te_18
  ex_tw 0 ten_d2xy
  tl_set te_real_
  h_exec
  tc_check eq get tg_rc 0 0 ten_d2real
  exs te_run1 te_run1_o
  ex_tw 1 ten_d2r1
  exs te_run123 te_run123_o
  ex_tw 1 ten_d2r123
  exs te_run_ te_run_o
  ex_tw 0 ten_d2r
  exs te_run12 te_run12_o
  ex_tw 0 ten_d2r12
  exs te_run1x te_run1x_o
  ex_tw 1 ten_d2nn
  exs te_alt_x te_alt_o
  ex_tw 1 ten_d4alt
  exs te_eff_x te_eff_o
  ex_tw 1 ten_d4eff
  exs te_auth te_auth_o
  ex_tw 1 ten_d4auth
  exs te_exec te_exec_o
  ex_tw 1 ten_d4exec
  exs te_graph te_graph_o
  ex_tw 1 ten_d4graph
end

fn te_set_path s view uchar * to void
  sl = len s
  for i ulong sl bound 64
    put vom_path i get s i
  end
  put vom_plen 0 sl
end

fn te_err_has s view uchar * to bool
  sl = len s
  n = get vcon_elen 0
  if gt sl n
    ret false
  end
  for p ulong add sub n sl 1 bound 512
    hit = true
    for j ulong sl bound 64
      if ne get vcon_err add p j get s j
        hit = false
        break
      end
    end
    if hit
      ret true
    end
  end
  ret false
end

fn te_err_is s view uchar * to bool
  ret and eq get vcon_elen 0 len s te_err_has s
end

fn test_e2e_d3 to void
  te_set_path te_root
  ve_reset
  r1 = omega_tool_open_script
  tc_check and eq r1 -1 te_err_is te_root_o ten_d3root
  te_set_path te_sdir
  ve_reset
  r2 = omega_tool_open_script
  tc_check and eq r2 -1 te_err_has te_isdir ten_d3dir
  te_set_path te_nope
  ve_reset
  r3 = omega_tool_open_script
  tc_check and eq r3 -1 te_err_has te_cantopen ten_d3miss
  te_set_path te_spath
  ve_reset
  r4 = omega_tool_open_script
  tc_check gt r4 0 ten_d3reg
  if gt r4 0
    put te_sink 0 long fclose int r4
  end
end

fn main to int
  test_console_lane
  test_e2e_session
  test_e2e_json
  test_e2e_d2
  test_e2e_d3
  ret tc_report
end

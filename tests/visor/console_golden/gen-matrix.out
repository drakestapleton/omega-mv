{"command":"help","status":"ok","class":"inspection","result":[{"command":"help","usage":"help [command]","class":"inspection","meaning":"list commands, or show one"},{"command":"quit","usage":"quit","class":"inspection","meaning":"leave the console"},{"command":"inspect","usage":"inspect <x>","class":"inspection","meaning":"show the object a name or id refers to"},{"command":"type","usage":"type <x>","class":"inspection","meaning":"show the type of an object"},{"command":"id","usage":"id <x>","class":"inspection","meaning":"show the semantic id of a name, _ or hex id"},{"command":"graph","usage":"graph <x>","class":"inspection","meaning":"show the semantic graph reachable from x"},{"command":"verify","usage":"verify <x>","class":"pure-execution","meaning":"run the verification pipeline on x"},{"command":"machine","usage":"machine","class":"inspection","meaning":"show the current machine model"},{"command":"realize","usage":"realize <x> [for current.machine]","class":"pure-execution","meaning":"build machine code for x (does not run it)"},{"command":"cost","usage":"cost <x>","class":"simulation","meaning":"estimate the cost of x"},{"command":"run","usage":"run <x> [args...]","class":"pure-execution","meaning":"run x if pure; effects become an effect request"},{"command":"evidence","usage":"evidence [name]","class":"inspection","meaning":"show recorded evidence receipts"},{"command":"bindings","usage":"bindings","class":"inspection","meaning":"list session names in the order they were made"},{"command":"clear","usage":"clear","class":"inspection","meaning":"forget all session names and objects"},{"command":"world","usage":"world [cap]","class":"inspection","meaning":"show the runtime world state (read only)"},{"command":"effects","usage":"effects [x]","class":"effect-request","meaning":"show effect objects as requests (never executed)"},{"command":"alternatives","usage":"alternatives <x>","class":"simulation","meaning":"list other ways to realize x"},{"command":"compare","usage":"compare <a> <b>","class":"simulation","meaning":"compare two objects or realizations"},{"command":"why","usage":"why <x>","class":"inspection","meaning":"explain where x came from"},{"command":"source","usage":"let x: u64 = <expr> | fn .. | <expr>","class":"pure-execution","meaning":"Omega source line, evaluated by the language"}],"error":null}

note SPDX-License-Identifier: Apache-2.0
note Lane 5: machine view tests. Pure seeded OM-2 port of
note tests/visor/test_visor_machine.c, every C check in the same order.
note Prints the current machine view, then "PASS n/n".
note Graph slots: mg 0, mg2 1, sp 2, sp2 3, qv 4, qv2 5, bad 6.
note View slots: v 0, v2 1, vs 2, vq 3, vb 4 (view k shows graph slot 8+k).

text tvm_m1 "visor_machine_current"
text tvm_m2 "observed is false in V1"
text tvm_m3 "provenance starts with assumed:"
text tvm_m4 "provenance says no descriptor"
text tvm_m5 "visor_machine_current again"
text tvm_m6 "text twice identical"
text tvm_m7 "json twice identical"
text tvm_m8 "json observed false"
text tvm_m9 "truncation fails closed"
text tvm_m10 "host facts"
text tvm_m11 "current == from_facts(host)"
text tvm_m12 "build spark"
text tvm_m13 "build qemu"
text tvm_m14 "spark id stable"
text tvm_m15 "qemu id stable"
text tvm_m16 "spark != qemu id"
text tvm_m17 "spark topology valid"
text tvm_m18 "qemu topology valid"
text tvm_m19 "issue widths from builders"
text tvm_m20 "units"
text tvm_m21 "caches"
text tvm_m22 "builder seals flagged placeholder"
text tvm_m23 "id text"
text tvm_m24 "invalid topology reported"
text tvm_m25 "DGX Spark DMI -> dgx_spark profile"
text tvm_m26 "provenance records core mismatch verbatim"
text tvm_m27 "spark facts still assumed"
text tvm_m28 "Neoverse-V2 part -> dgx_spark profile"
text tvm_m29 "non-aarch64 -> qemu_virt profile"
text tvm_m30 "unknown aarch64 -> qemu_virt profile"
text tvm_m31 "two targets"
text tvm_m32 "aarch64 target"
text tvm_m33 "blackwell target declared"
text tvm_m34 "blackwell realize objects linked in this test"
text tvm_m35 "blackwell run refused"
text tvm_m36 "blackwell id"

text tvm_s_assumed "assumed:"
text tvm_s_nodesc "no physics descriptor ingested"
text tvm_s_jobs "\"observed\":false"
text tvm_s_alu "ALU"
text tvm_s_sha "sha256:"
text tvm_s_notm "do NOT match"
text tvm_s_parts "0xd85,0xd87"
text tvm_f_a64 "aarch64"
text tvm_f_x86 "x86_64"
text tvm_f_dmi "NVIDIA_DGX_Spark"
text tvm_f_board "Some Board"
text tvm_f_p1 "0xd85,0xd87"
text tvm_f_p2 "0xd4f"
text tvm_f_p3 "0xd0c"
text tvm_t_a64 "  target aarch64-v8a            linked=yes"
text tvm_t_bw "  target blackwell-gb10-sm121   "
text tvm_t_bwl "  target blackwell-gb10-sm121   linked=yes"
text tvm_t_bwr "  target blackwell-gb10-sm121   linked=yes runnable=no id="
text tvm_t_gpu "requires GPU submit authority"
text tvm_t_bwid "  target blackwell-gb10-sm121   linked=yes runnable=no id=sha256:"
text tvm_fail "FAIL: "
text tvm_pass "PASS "
text tvm_failw "FAIL "

global tvm_pass_n ulong 1
global tvm_tot ulong 1
global tvm_buf1 uchar 16384
global tvm_len1 ulong 1

fn tvm_chk cond bool msg view uchar * to void
  put tvm_tot 0 add get tvm_tot 0 1
  if cond
    put tvm_pass_n 0 add get tvm_pass_n 0 1
    ret
  end
  ob_reset 4096
  ob_puts tvm_fail
  ob_puts msg
  ob_putc uchar 10
  ob_write_fd 2
end

fn tvm_save to void
  n = get v_ob_len 0
  for k ulong n bound 16384
    put tvm_buf1 k get v_ob k
  end
  put tvm_len1 0 n
end

fn tvm_same to bool
  n = get v_ob_len 0
  if ne n get tvm_len1 0
    ret false
  end
  for k ulong n bound 16384
    if ne get v_ob k get tvm_buf1 k
      ret false
    end
  end
  ret true
end

fn tvm_saved_has w view uchar * to bool
  n = len w
  l = get tvm_len1 0
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 16384
    hit = true
    for k ulong n bound 256
      if ne get tvm_buf1 add s k get w k
        hit = false
        break
      end
    end
    if hit
      ret true
    end
  end
  ret false
end

fn tvm_ob_has w view uchar * to bool
  n = len w
  l = get v_ob_len 0
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 16384
    hit = true
    for k ulong n bound 256
      if ne get v_ob add s k get w k
        hit = false
        break
      end
    end
    if hit
      ret true
    end
  end
  ret false
end

fn tvm_ob_eq w view uchar * to bool
  n = len w
  if ne get v_ob_len 0 n
    ret false
  end
  for k ulong n bound 256
    if ne get v_ob k get w k
      ret false
    end
  end
  ret true
end

fn tvm_prov_pre v ulong w view uchar * to bool
  n = len w
  if lt get vmch_vprovl v n
    ret false
  end
  for k ulong n bound 256
    if ne get vmch_vprov add mul v 384 k get w k
      ret false
    end
  end
  ret true
end

fn tvm_prov_at v ulong s ulong w view uchar * to bool
  n = len w
  b = add mul v 384 s
  for k ulong n bound 256
    if ne get vmch_vprov add b k get w k
      ret false
    end
  end
  ret true
end

fn tvm_prov_has v ulong w view uchar * to bool
  n = len w
  l = get vmch_vprovl v
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 384
    if tvm_prov_at v s w
      ret true
    end
  end
  ret false
end

fn tvm_facts u view uchar * d view uchar * c view uchar * to void
  vmch_facts_clear
  vmch_fact_txt 0 u 32
  vmch_fact_txt 1 d 64
  vmch_fact_txt 2 c 64
end

fn tvm_current to void
  tvm_chk eq vmch_current 0 0 0 tvm_m1
  tvm_chk eq get vmch_vobs 0 0 tvm_m2
  tvm_chk tvm_prov_pre 0 tvm_s_assumed tvm_m3
  tvm_chk tvm_prov_has 0 tvm_s_nodesc tvm_m4
  tvm_chk eq vmch_current 1 1 0 tvm_m5
  n1 = vmch_vtext 0 16384
  tvm_save
  n2 = vmch_vtext 1 16384
  tvm_chk and gt n1 0 and eq n1 n2 tvm_same tvm_m6
  j1 = vmch_vjson 0 16384
  tvm_save
  j2 = vmch_vjson 1 16384
  okj = and gt j1 0 and eq j1 j2 tvm_same
  ends = false
  if gt j1 0
    ends = and eq get tvm_buf1 0 123 eq get tvm_buf1 sub ulong j1 1 125
  end
  tvm_chk and okj ends tvm_m7
  tvm_chk tvm_saved_has tvm_s_jobs tvm_m8
  tvm_chk eq vmch_vtext 0 32 -1 tvm_m9
end

fn tvm_profiles to void
  tvm_chk eq vmch_host_facts 0 tvm_m10
  tvm_chk and eq vmch_from_facts 1 1 0 vmch_id_eq 1 0 tvm_m11
  tvm_chk and eq vmch_build_spark 2 0 eq vmch_build_spark 3 0 tvm_m12
  tvm_chk and eq vmch_build_qemu 4 0 eq vmch_build_qemu 5 0 tvm_m13
  tvm_chk vmch_id_eq 2 3 tvm_m14
  tvm_chk vmch_id_eq 4 5 tvm_m15
  tvm_chk not vmch_id_eq 2 4 tvm_m16
  tvm_chk and eq vmch_view 2 2 0 eq get vmch_vtopo 2 1 tvm_m17
  tvm_chk and eq vmch_view 4 3 0 eq get vmch_vtopo 3 1 tvm_m18
  tvm_chk and eq vmch_gget 10 VMCH_K_ISSUE 4 eq vmch_gget 11 VMCH_K_ISSUE 2 tvm_m19
  ob_reset 64
  vmch_unit_name vmch_gget 10 VMCH_K_UNIT
  t20 = and eq vmch_gget 10 VMCH_K_UCNT 6 eq vmch_gget 11 VMCH_K_UCNT 5
  tvm_chk and t20 tvm_ob_eq tvm_s_alu tvm_m20
  tvm_chk and eq vmch_gget 10 VMCH_K_CCNT 4 eq vmch_gget 11 VMCH_K_CCNT 3 tvm_m21
  tvm_chk and eq get vmch_vph 2 1 eq get vmch_vph 3 1 tvm_m22
  ob_reset 256
  vmch_put_id 2
  tvm_save
  ob_reset 256
  vmch_put_id 10
  t23 = and tvm_same eq get v_ob_len 0 71
  tvm_chk and t23 tvm_saved_has tvm_s_sha tvm_m23
end

fn tvm_bad to void
  vmch_graph_copy 6 2
  vmch_gset 6 VMCH_K_GPRC 7
  rc = vmch_view 6 4
  tvm_chk and eq rc 0 and eq get vmch_vtopo 4 0 gt get vmch_vterrl 4 0 tvm_m24
end

fn tvm_facts_sel to void
  tvm_facts tvm_f_a64 tvm_f_dmi tvm_f_p1
  tvm_chk and eq vmch_from_facts 1 1 0 vmch_id_eq 1 2 tvm_m25
  tvm_chk and tvm_prov_has 1 tvm_s_notm tvm_prov_has 1 tvm_s_parts tvm_m26
  tvm_chk eq get vmch_vobs 1 0 tvm_m27
  tvm_facts tvm_f_a64 tvm_f_board tvm_f_p2
  tvm_chk and eq vmch_from_facts 1 1 0 vmch_id_eq 1 2 tvm_m28
  tvm_facts tvm_f_x86 tvm_f_board tvm_f_p2
  tvm_chk and eq vmch_from_facts 1 1 0 vmch_id_eq 1 4 tvm_m29
  tvm_facts tvm_f_a64 tvm_f_board tvm_f_p3
  tvm_chk and eq vmch_from_facts 1 1 0 vmch_id_eq 1 4 tvm_m30
end

fn tvm_targets to void
  tvm_chk eq get vmch_vtcnt 0 2 tvm_m31
  n = vmch_vtext 0 16384
  tvm_chk and gt n 0 tvm_ob_has tvm_t_a64 tvm_m32
  tvm_chk tvm_ob_has tvm_t_bw tvm_m33
  tvm_chk tvm_ob_has tvm_t_bwl tvm_m34
  tvm_chk and tvm_ob_has tvm_t_bwr tvm_ob_has tvm_t_gpu tvm_m35
  tvm_chk and eq vmch_blackwell_id 0 tvm_ob_has tvm_t_bwid tvm_m36
end

fn main to int
  put tvm_pass_n 0 0
  put tvm_tot 0 0
  tvm_current
  tvm_profiles
  tvm_bad
  tvm_facts_sel
  tvm_targets
  u = vmch_vtext 0 16384
  ob_write_fd 1
  ob_reset 256
  p = get tvm_pass_n 0
  t = get tvm_tot 0
  if eq p t
    ob_puts tvm_pass
  else
    ob_puts tvm_failw
  end
  ob_put_u64 p
  ob_putc uchar 47
  ob_put_u64 t
  ob_putc uchar 10
  ob_write_fd 1
  if lt u -999
    ret 2
  end
  if eq p t
    ret 0
  end
  ret 1
end

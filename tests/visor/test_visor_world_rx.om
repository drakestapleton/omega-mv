om2
note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & parity test for src/visor/rx/visor_world_rx.om.
note Mirrors tests/visor/test_visor_world.c cases 1..10.

text t_vrx_pass "PASS test_visor_world_rx_om\n"
text t_vrx_fail "FAIL test_visor_world_rx_om\n"
text t_vrx_want_id0 "rx:0@1"
text t_vrx_want_k0 "RESIDENT"
text t_vrx_want_s0 "live"
text t_vrx_want_s1 "live,placed"

fn ob_has needle view uchar * to bool
  nl = len needle
  bl = get v_ob_len 0
  if or eq nl 0 gt nl bl
    ret false
  end
  lim = add sub bl nl 1
  for i ulong lim bound 8192
    ok = true
    for j ulong nl bound 128
      if ne get v_ob add i j get needle j
        ok = false
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn main to int
  note 1. NULL world fails closed
  if ne visor_world_snapshot 0 -1
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 1
  end
  if or ne get vwld_attached 0 0 ne get vwld_obj_cnt 0 0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 2
  end
  note 2. Attached world with 3 objects (RESIDENT, EPHEMERAL+placed, DURABLE)
  for i ulong VWRX_MAX_WORLD_OBJS
    put g_vwrx_obj_live i 0
  end
  put g_vwrx_obj_live 0 1
  put g_vwrx_obj_id 0 0
  put g_vwrx_obj_gen 0 1
  put g_vwrx_obj_persist 0 VWRX_PERSIST_RESIDENT
  put g_vwrx_obj_placed 0 0
  put g_vwrx_obj_live 1 1
  put g_vwrx_obj_id 1 1
  put g_vwrx_obj_gen 1 2
  put g_vwrx_obj_persist 1 VWRX_PERSIST_EPHEMERAL
  put g_vwrx_obj_placed 1 1
  put g_vwrx_obj_live 2 1
  put g_vwrx_obj_id 2 2
  put g_vwrx_obj_gen 2 3
  put g_vwrx_obj_persist 2 VWRX_PERSIST_DURABLE
  put g_vwrx_obj_placed 2 0
  put g_vwrx_n_reactions 0 4
  put g_vwrx_in_flight 0 1
  put g_vwrx_pub_tail 0 9
  for i ulong 32
    put g_vwrx_digest i uchar add 16 i
  end
  if ne visor_world_snapshot 1 0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 3
  end
  if or ne get vwld_attached 0 1 ne get vwld_obj_cnt 0 3
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 4
  end
  if or ne get vwld_res_cnt 0 3 ne get vwld_pub_tail 0 9
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 5
  end
  if ne get vwld_dlen 0 71
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 6
  end
  note Check deterministic text & json renderings via visor_world.om
  tlen = vwld_format_text 8192
  if le tlen 0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 7
  end
  if not ob_has t_vrx_want_id0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 8
  end
  if not ob_has t_vrx_want_k0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 9
  end
  if not ob_has t_vrx_want_s1
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 10
  end
  jlen = vwld_format_json 8192
  if le jlen 0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 11
  end
  note 3. Truncation above 32 live objects
  for i ulong 42
    put g_vwrx_obj_live i 1
    put g_vwrx_obj_id i i
    put g_vwrx_obj_gen i 1
    put g_vwrx_obj_persist i VWRX_PERSIST_EPHEMERAL
    put g_vwrx_obj_placed i 0
  end
  if ne visor_world_snapshot 1 0
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 12
  end
  if or ne get vwld_obj_cnt 0 32 ne get vwld_res_cnt 0 42
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 13
  end
  note 4. Tiny buffer overflow fails closed
  if ne vwld_format_text 16 -1
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 14
  end
  if ne vwld_format_json 16 -1
    ign = write 1 t_vrx_fail 0 len t_vrx_fail
    ret 15
  end
  ign = write 1 t_vrx_pass 0 len t_vrx_pass
  ret 0
end

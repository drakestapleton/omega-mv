  tvv_chk and and ok2 tvv_ob_prefix tvv_s_req eq u2 0 tvv_m40
  j = vver_format_json 8192
  tvv_chk and and tvv_ob_has tvv_s_rtrue tvv_ob_has tvv_s_gfalse gt j 0 tvv_m41

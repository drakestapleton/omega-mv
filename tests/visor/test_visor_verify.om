fn main to int
  put tvv_tot 0 0
  put tvv_pn 0 0
  tvv_chk eq tvv_build_add V_OP_ADD 0 tvv_m1
  tvv_qid_obj get tvv_x 4
  tvv_no_realization
  tvv_render
  tvv_with_realization
  tvv_missing
  tvv_sub
  tvv_malformed
  tvv_fadd_effect
  tvv_program
  tvv_gen64
  ob_reset 256
  p = get tvv_pn 0
  t = get tvv_tot 0
  if eq p t
    ob_puts tvv_pass
  else
    ob_puts tvv_failw
  end
  ob_put_u64 p
  ob_putc uchar 47
  ob_put_u64 t
  ob_putc uchar 10
  ob_write_fd 1
  if eq p t
    ret 0
  end
  ret 1
end

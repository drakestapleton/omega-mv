note SPDX-License-Identifier: Apache-2.0
note Lane 4: visor_verify tests. Pure seeded OM-2 port of tests/visor/test_visor_verify.c:
note every C check, in the same order, with the same message. Prints "PASS n/n" on success.
note
note The OM graph store is one global graph, so where the C test keeps two graphs alive
note (x.g and s.g in section 8) the ADD graph is rebuilt from the same builders; its ids
note are content ids and equal the ones the C test holds.
note Realization slots: real 0, bad 1, sreal 2, sbad 3, lie 4, freal 5, program 6, corrupt 7.
note After the C checks, tvv_gen64 adds two checks the C test did not have: a capability
note generation above 2^32 and the largest u64 survive the effect object's encoding, the
note request decode and the text and JSON views (spec/effect-cap64-migration.md section 2.5).
note Machine graph slots: mg 0, mg2 1.
note The realization and program builders below port omega_realize.c
note (omega_realize_pure_binary, omega_realize_f_add_sub, omega_build_f_add_sub_graph) and
note omega_program.c (omega_program_build_unary_op, omega_program_verify), which the C
note test links as libraries and which have no OM-2 library port yet.

text tvv_m1 "build 7+11 graph"
text tvv_m2 "verify apply rc"
text tvv_m3 "six rows"
text tvv_m4 "row order"
text tvv_m5 "V0 pass"
text tvv_m6 "type pass"
text tvv_m7 "V2 pass"
text tvv_m8 "V1 not run w/o realization"
text tvv_m9 "authority NONE"
text tvv_m10 "machine not run"
text tvv_m11 "passed without realization"
text tvv_m12 "format text"
text tvv_m13 "text deterministic"
text tvv_m14 "aligned STRUCTURAL line"
text tvv_m15 "json render"
text tvv_m16 "truncation fails closed"
text tvv_m17 "realize ADD"
text tvv_m18 "machine model"
text tvv_m19 "V1 differential pass with realization"
text tvv_m20 "machine compat pass"
text tvv_m21 "passed with realization"
text tvv_m22 "corrupt realization fails"
text tvv_m23 "failure block filled"
text tvv_m24 "text failure block"
text tvv_m25 "machine mismatch fails with expected/observed"
text tvv_m26 "binding mismatch fails"
text tvv_m27 "missing id rc 0"
text tvv_m28 "missing object fails structural"
text tvv_m29 "null graph -1"
text tvv_m30 "build sub graph"
text tvv_m31 "realize SUB"
text tvv_m32 "SUB V1 not applicable"
text tvv_m33 "SUB realization still V0-checked"
text tvv_m34 "tampered SUB realization fails closed"
text tvv_m35 "V1 mismatch fills expected/observed"
text tvv_m36 "malformed rc 0"
text tvv_m37 "malformed graph fails V0"
text tvv_m38 "build f_add_sub"
text tvv_m39 "f_add_sub V1 pass"
text tvv_m40 "effect -> REQUIRED"
text tvv_m41 "json authority"
text tvv_m42 "build unary program (realized)"
text tvv_m43 "program verify pass"
text tvv_m44 "program rows"
text tvv_m45 "omega_program_verify agrees"
text tvv_m46 "unrealized program fails closed"
text tvv_m47 "corrupt program fails V0"
text tvv_m48 "generation 2^32+5 survives encode, decode and text view"
text tvv_m49 "generation u64 max survives encode, decode and JSON view"
text tvv_s_g33 " generation 4294967301"
text tvv_s_gmax ",\"capability_generation\":18446744073709551615"

text tvv_fail "FAIL: "
text tvv_pass "PASS "
text tvv_failw "FAIL "
text tvv_s_struct "STRUCTURAL"
text tvv_s_mach "MACHINE"
text tvv_s_nore "no realization built"
text tvv_s_none "NONE"
text tvv_s_req "REQUIRED"
text tvv_s_aligned "STRUCTURAL      PASS"
text tvv_s_fnull "\"failure\":null"
text tvv_s_gfalse "\"granted\":false"
text tvv_s_rtrue "\"required\":true"
text tvv_s_fv "first violation:"
text tvv_s_absent "absent"
text tvv_s_na "not applicable"
text tvv_s_rid "REALIZATION_ID"
text tvv_s_mm "Mismatch"
text tvv_s_punr "program not realized"
text tvv_s_pre "x >= 0"
text tvv_s_dom "omega.program.v2"

global tvv_tot ulong 1
global tvv_pn ulong 1
global tvv_a uchar 8192
global tvv_al ulong 1
note AddGraph: t a b op ap object indices
global tvv_x ulong 5

fn tvv_chk cond bool msg view uchar * to void
  put tvv_tot 0 add get tvv_tot 0 1
  if cond
    put tvv_pn 0 add get tvv_pn 0 1
    ret
  end
  ob_reset 4096
  ob_puts tvv_fail
  ob_puts msg
  ob_putc uchar 10
  ob_write_fd 2
end

note ---- output-buffer comparisons ----
fn tvv_save to void
  n = get v_ob_len 0
  for k ulong n bound 8192
    put tvv_a k get v_ob k
  end
  put tvv_al 0 n
end

fn tvv_same to bool
  n = get v_ob_len 0
  if ne n get tvv_al 0
    ret false
  end
  for k ulong n bound 8192
    if ne get v_ob k get tvv_a k
      ret false
    end
  end
  ret true
end

fn tvv_ob_prefix s view uchar * to bool
  n = len s
  if lt get v_ob_len 0 n
    ret false
  end
  for k ulong n bound 256
    if ne get v_ob k get s k
      ret false
    end
  end
  ret true
end

fn tvv_ob_eq s view uchar * to bool
  if ne get v_ob_len 0 len s
    ret false
  end
  ret tvv_ob_prefix s
end

fn tvv_ob_has s view uchar * to bool
  n = len s
  m = get v_ob_len 0
  if lt m n
    ret false
  end
  for p ulong add sub m n 1 bound 65536
    hit = true
    for k ulong n bound 256
      if ne get v_ob add p k get s k
        hit = false
        break
      end
    end
    if hit
      ret true
    end
  end
  ret false
end

note render a report field into the output buffer: 0 violation, 1 expected, 2 observed, 3+r row detail
fn tvv_field src ulong to void
  ob_reset 4096
  if eq src 0
    n = get vver_vlen 0
    for i ulong n bound 256
      ob_putc get vver_viol i
    end
  end
  if eq src 1
    n1 = get vver_elen 0
    for i ulong n1 bound 128
      ob_putc get vver_exp i
    end
  end
  if eq src 2
    n2 = get vver_oblen 0
    for i ulong n2 bound 128
      ob_putc get vver_obs i
    end
  end
  if ge src 3
    r = sub src 3
    dl = get vver_dl r
    for i ulong dl bound 256
      ob_putc get vver_det add mul r 256 i
    end
  end
end

fn tvv_exp_ne_obs to bool
  n = get vver_elen 0
  if ne n get vver_oblen 0
    ret true
  end
  for i ulong n bound 128
    if ne get vver_exp i get vver_obs i
      ret true
    end
  end
  ret false
end

fn tvv_st r ulong st ulong to bool
  ret eq get vver_st r st
end

note ---- ids ----
fn tvv_qid_obj idx ulong to void
  b = mul idx 32
  for i ulong 32
    put vver_qid i get v_og_id add b i
  end
end

note ---- graphs ----
note build_add: t = u64, a = 7, b = 11, op = opc WRAP, ap = op(a, b); 0 or -1
fn tvv_build_add opc ulong to long
  og_reset
  t = og_build_type_uint 64
  if lt t 0
    ret -1
  end
  tu = ulong t
  a = og_build_val_uint tu 64 7
  b = og_build_val_uint tu 64 11
  op = og_build_op_binary opc V_OVF_WRAP tu
  if or lt a 0 or lt b 0 lt op 0
    ret -1
  end
  ap = og_build_apply ulong op ulong a ulong b
  if lt ap 0
    ret -1
  end
  put tvv_x 0 tu
  put tvv_x 1 ulong a
  put tvv_x 2 ulong b
  put tvv_x 3 ulong op
  put tvv_x 4 ulong ap
  ret 0
end

note omega_build_f_add_sub_graph: root = SUB(ADD(7, 11), 3); returns the root index or -1
fn tvv_build_f_add_sub to long
  t = og_build_type_uint 64
  if lt t 0
    ret -1
  end
  tu = ulong t
  va = og_build_val_uint tu 64 7
  vb = og_build_val_uint tu 64 11
  vc = og_build_val_uint tu 64 3
  oa = og_build_op_binary V_OP_ADD V_OVF_WRAP tu
  if or lt va 0 or lt vb 0 or lt vc 0 lt oa 0
    ret -1
  end
  aa = og_build_apply ulong oa ulong va ulong vb
  os = og_build_op_binary V_OP_SUB V_OVF_WRAP tu
  if or lt aa 0 lt os 0
    ret -1
  end
  ret og_build_apply ulong os ulong aa ulong vc
end

note ---- realization slots ----
fn tvv_slot_clear s ulong to void
  put vver_rclen s 0
  put vver_rprof s 0
  put vver_rent s 0
  put vver_rhid s 0
  put vver_rhm s 0
  b = mul s 32
  for i ulong 32
    put vver_rsem add b i uchar 0
    put vver_rrid add b i uchar 0
    put vver_rmid add b i uchar 0
  end
  cb = mul s VVER_CB
  for i ulong VVER_CB
    put vver_rcode add cb i uchar 0
  end
end

fn tvv_slot_copy d ulong s ulong to void
  put vver_rclen d get vver_rclen s
  put vver_rprof d get vver_rprof s
  put vver_rent d get vver_rent s
  put vver_rhid d get vver_rhid s
  put vver_rhm d get vver_rhm s
  db = mul d 32
  sb = mul s 32
  for i ulong 32
    put vver_rsem add db i get vver_rsem add sb i
    put vver_rrid add db i get vver_rrid add sb i
    put vver_rmid add db i get vver_rmid add sb i
  end
  dc = mul d VVER_CB
  sc = mul s VVER_CB
  for i ulong VVER_CB
    put vver_rcode add dc i get vver_rcode add sc i
  end
end

note append one encoded instruction (an a64* result) to slot s; -1 when the encoder refused
fn tvv_emit s ulong w long to long
  if lt w 0
    ret -1
  end
  p = get vver_rclen s
  if gt add p 4 VVER_CB
    ret -1
  end
  wu = ulong w
  b = add mul s VVER_CB p
  put vver_rcode b uchar and wu 255
  put vver_rcode add b 1 uchar and shr wu 8 255
  put vver_rcode add b 2 uchar and shr wu 16 255
  put vver_rcode add b 3 uchar and shr wu 24 255
  put vver_rclen s add p 4
  ret 0
end

fn tvv_sem_from_obj s ulong idx ulong to void
  b = mul s 32
  ib = mul idx 32
  for i ulong 32
    put vver_rsem add b i get v_og_id add ib i
  end
end

fn tvv_flip0 s ulong to void
  b = mul s VVER_CB
  put vver_rcode b uchar xor ulong get vver_rcode b 1
end

note omega_realize_pure_binary(g, op object idx, slot): 0, or -1 for a non-operation or opcode
fn tvv_realize_pure s ulong opi ulong to long
  if not vver_as_op opi
    ret -1
  end
  tvv_slot_clear s
  tvv_sem_from_obj s opi
  put vver_rprof s 1
  opc = vver_opcode opi
  w = long -1
  if eq opc V_OP_ADD
    w = a64addreg 1 0 0 1
  end
  if eq opc V_OP_SUB
    w = a64subreg 1 0 0 1
  end
  if eq opc V_OP_MUL
    w = a64mulreg 1 0 0 1
  end
  if eq opc V_OP_AND
    w = a64andreg 1 0 0 1
  end
  if eq opc V_OP_OR
    w = a64orrreg 1 0 0 1
  end
  if lt w 0
    ret -1
  end
  u = tvv_emit s w
  u2 = tvv_emit s a64ret
  if or lt u 0 lt u2 0
    ret -1
  end
  ret vver_real_set_id s
end

note omega_realize_f_add_sub(g, root, slot): ADD X0,X0,X1; SUB X0,X0,X2; RET
fn tvv_realize_f_add_sub s ulong root ulong to long
  tvv_slot_clear s
  tvv_sem_from_obj s root
  put vver_rprof s 1
  if lt tvv_emit s a64addreg 1 0 0 1 0
    ret -1
  end
  if lt tvv_emit s a64subreg 1 0 0 2 0
    ret -1
  end
  if lt tvv_emit s a64ret 0
    ret -1
  end
  ret vver_real_set_id s
end

note ---- program: omega_program_build_unary_op into vver_p_* with its realization in slot ----
note constraint id of (kind, v_sbuf[0..cl)) into dst (0 pre, 1 post); -1 on a refusal
fn tvv_constraint_id ckind ulong cl ulong dst ulong to long
  c = og_add_object V_KIND_CONSTRAINT
  if lt c 0
    ret -1
  end
  cu = ulong c
  if lt og_add_const_sbuf cu ckind cl 0
    ret -1
  end
  if lt og_finish cu 0
    ret -1
  end
  b = mul cu 32
  for i ulong 32
    if eq dst 0
      put vver_p_pre i get v_og_id add b i
    else
      put vver_p_post i get v_og_id add b i
    end
  end
  ret 0
end

note postcondition text "x <sym> <imm>" into vver_p_qt and v_sbuf; its length
fn tvv_post_text sym ulong imm ulong to ulong
  vver_sb_clear
  vver_sb_c 120
  vver_sb_c 32
  vver_sb_c sym
  vver_sb_c 32
  vver_sb_u imm
  n = get vver_sbl 0
  for i ulong n bound 64
    put vver_p_qt i get vver_sb i
    put v_sbuf i get vver_sb i
  end
  put vver_p_qtl 0 n
  ret n
end

note omega_program_compute_id: sha256("omega.program.v2\0" root tin tout pre post)
fn tvv_program_id root ulong tidx ulong to void
  vver_sha_ready
  dl = len tvv_s_dom
  for i ulong dl bound 32
    put v_sha_in i get tvv_s_dom i
  end
  put v_sha_in dl uchar 0
  p = add dl 1
  rb = mul root 32
  tb = mul tidx 32
  for i ulong 32
    put v_sha_in add p i get v_og_id add rb i
    put v_sha_in add add p 32 i get v_og_id add tb i
    put v_sha_in add add p 64 i get v_og_id add tb i
    put v_sha_in add add p 96 i get vver_p_pre i
    put v_sha_in add add p 128 i get vver_p_post i
  end
  sha256_hash add p 160
  for i ulong 32
    put vver_p_id i get v_sha_out i
  end
end

note emit_const(X1, imm) then emit_op(op, X1), then RET (sequential schedule, width 64)
fn tvv_program_code s ulong op ulong imm ulong to long
  tvv_slot_clear s
  if lt tvv_emit s a64movz 1 1 and imm 65535 0 0
    ret -1
  end
  for k ulong 3
    ch = and shr imm mul add k 1 16 65535
    if ne ch 0
      if lt tvv_emit s a64movk 1 1 ch mul add k 1 16 0
        ret -1
      end
    end
  end
  w = long -1
  if eq op V_OP_ADD
    w = a64addreg 1 0 0 1
  end
  if eq op V_OP_SUB
    w = a64subreg 1 0 0 1
  end
  if eq op V_OP_MUL
    w = a64mulreg 1 0 0 1
  end
  if eq op V_OP_AND
    w = a64andreg 1 0 0 1
  end
  if eq op V_OP_OR
    w = a64orrreg 1 0 0 1
  end
  if lt tvv_emit s w 0
    ret -1
  end
  ret tvv_emit s a64ret
end

note omega_program_realize: code, profile, realization id bound to the program id, V0 must pass
fn tvv_unary_realize s ulong op ulong imm ulong to long
  if lt tvv_program_code s op imm 0
    ret -1
  end
  put vver_rprof s 1
  sb = mul s 32
  for i ulong 32
    put vver_rsem add sb i get vver_p_id i
  end
  if lt vver_real_set_id s 0
    ret -1
  end
  nore = long s
  if ne vver_v0 0 nore 0
    ret -1
  end
  put vver_p_slot 0 s
  put vver_p_real 0 1
  ret 0
end

fn tvv_build_unary s ulong op ulong imm ulong to long
  sym = ulong 0
  if eq op V_OP_ADD
    sym = 43
  end
  if eq op V_OP_SUB
    sym = 45
  end
  if eq op V_OP_MUL
    sym = 42
  end
  if eq op V_OP_AND
    sym = 38
  end
  if eq op V_OP_OR
    sym = 124
  end
  put vver_p_real 0 0
  if eq sym 0
    ret -1
  end
  if gt imm 4294967295
    ret -1
  end
  put vver_p_itag 0 V_TY_UINT
  put vver_p_iw 0 64
  put vver_p_otag 0 V_TY_UINT
  put vver_p_ow 0 64
  og_reset
  pl = len tvv_s_pre
  for i ulong pl bound 64
    put vver_p_pt i get tvv_s_pre i
    put v_sbuf i get tvv_s_pre i
  end
  put vver_p_ptl 0 pl
  if lt tvv_constraint_id V_CONST_PRECONDITION pl 0 0
    ret -1
  end
  ql = tvv_post_text sym imm
  if lt tvv_constraint_id V_CONST_POSTCONDITION ql 1 0
    ret -1
  end
  t = og_build_type_uint 64
  if lt t 0
    ret -1
  end
  tu = ulong t
  cur = og_build_param tu 0
  c = og_build_val_uint tu 64 imm
  o = og_build_op_binary op V_OVF_WRAP tu
  if or lt cur 0 or lt c 0 lt o 0
    ret -1
  end
  root = og_build_apply ulong o ulong cur ulong c
  if lt root 0
    ret -1
  end
  tvv_program_id ulong root tu
  og_reset
  ret tvv_unary_realize s op imm
end

note omega_program_verify: -1 unless realized, then V0 on the realization and V2
fn tvv_program_verify to long
  if eq get vver_p_real 0 0
    ret -1
  end
  if ne vver_v0 0 long get vver_p_slot 0 0
    ret -1
  end
  if ne vver_v2 0
    ret -1
  end
  ret 0
end

note ---- sections ----
fn tvv_no_realization to void
  r = vver_verify_object 1 -1 -1
  tvv_chk eq r 0 tvv_m2
  tvv_chk eq VVER_ROWS 6 tvv_m3
  ob_reset 256
  u = vver_row_name 0
  first = tvv_ob_eq tvv_s_struct
  ob_reset 256
  u2 = vver_row_name 5
  tvv_chk and and first tvv_ob_eq tvv_s_mach gt add u u2 0 tvv_m4
  tvv_chk and tvv_st 0 0 gt get vver_chk 0 0 tvv_m5
  tvv_chk tvv_st 1 0 tvv_m6
  tvv_chk tvv_st 2 0 tvv_m7
  tvv_field 6
  tvv_chk and tvv_st 3 2 tvv_ob_eq tvv_s_nore tvv_m8
  tvv_field 7
  tvv_chk and and tvv_st 4 0 eq get vver_auth_req 0 0 tvv_ob_prefix tvv_s_none tvv_m9
  tvv_chk tvv_st 5 2 tvv_m10
  tvv_chk and ne get vver_passed 0 0 eq get vver_vlen 0 0 tvv_m11
end

fn tvv_render to void
  t1 = vver_format_text 8192
  tvv_chk gt t1 0 tvv_m12
  tvv_save
  r2 = vver_verify_object 1 -1 -1
  t2 = vver_format_text 8192
  tvv_chk and and gt t2 0 tvv_same eq r2 0 tvv_m13
  u = vver_format_text 8192
  tvv_chk and gt u 0 tvv_ob_prefix tvv_s_aligned tvv_m14
  j = vver_format_json 8192
  ok = and gt j 0 eq get v_ob 0 123
  tvv_chk and and ok tvv_ob_has tvv_s_fnull tvv_ob_has tvv_s_gfalse tvv_m15
  tvv_chk eq vver_format_text 16 -1 tvv_m16
end

fn tvv_with_realization to void
  tvv_chk eq tvv_realize_pure 0 get tvv_x 3 0 tvv_m17
  tvv_chk ge vmch_build_spark 0 0 tvv_m18
  tvv_qid_obj get tvv_x 4
  u = vver_verify_object 1 0 0
  tvv_chk and and tvv_st 3 0 ge get vver_chk 3 11 eq u 0 tvv_m19
  tvv_chk tvv_st 5 0 tvv_m20
  tvv_chk ne get vver_passed 0 0 tvv_m21
  tvv_slot_copy 1 0
  tvv_flip0 1
  u2 = vver_verify_object 1 1 0
  tvv_chk and and tvv_st 3 1 eq get vver_passed 0 0 eq u2 0 tvv_m22
  tvv_chk and gt get vver_vlen 0 0 gt get vver_olen 0 0 tvv_m23
  t = vver_format_text 8192
  tvv_chk and gt t 0 tvv_ob_has tvv_s_fv tvv_m24
  vmch_graph_copy 1 0
  vmch_gset 1 VMCH_K_PROF 2
  u3 = vver_verify_object 1 0 1
  ok = and and tvv_st 5 1 eq get vver_passed 0 0 eq u3 0
  tvv_chk and and ok gt get vver_elen 0 0 gt get vver_oblen 0 0 tvv_m25
  tvv_qid_obj get tvv_x 1
  u4 = vver_verify_object 1 0 -1
  tvv_chk and and tvv_st 3 1 eq get vver_passed 0 0 eq u4 0 tvv_m26
end

fn tvv_missing to void
  for i ulong 32
    put vver_qid i uchar 171
  end
  tvv_chk eq vver_verify_object 1 -1 -1 0 tvv_m27
  tvv_field 2
  tvv_chk and and tvv_st 0 1 eq get vver_passed 0 0 tvv_ob_eq tvv_s_absent tvv_m28
  tvv_qid_obj get tvv_x 4
  r = vver_verify_object 0 -1 -1
  tvv_chk and eq r -1 eq get vver_passed 0 0 tvv_m29
end

fn tvv_sub to void
  tvv_chk eq tvv_build_add V_OP_SUB 0 tvv_m30
  tvv_chk eq tvv_realize_pure 2 get tvv_x 3 0 tvv_m31
  tvv_qid_obj get tvv_x 4
  u = vver_verify_object 1 2 -1
  tvv_field 6
  tvv_chk and and tvv_st 3 2 tvv_ob_has tvv_s_na eq u 0 tvv_m32
  tvv_chk and ne get vver_passed 0 0 gt get vver_chk 3 0 tvv_m33
  tvv_slot_copy 3 2
  tvv_flip0 3
  u2 = vver_verify_object 1 3 -1
  tvv_field 0
  ok = and eq get vver_passed 0 0 tvv_st 3 1
  tvv_chk and and ok tvv_ob_has tvv_s_rid eq u2 0 tvv_m34
  tvv_slot_copy 4 2
  u3 = tvv_build_add V_OP_ADD
  tvv_sem_from_obj 4 get tvv_x 3
  u4 = vver_real_set_id 4
  tvv_qid_obj get tvv_x 4
  u5 = vver_verify_object 1 4 -1
  tvv_field 0
  ok2 = and and tvv_st 3 1 eq get vver_passed 0 0 tvv_ob_has tvv_s_mm
  ok3 = and and gt get vver_elen 0 0 gt get vver_oblen 0 0 tvv_exp_ne_obs
  tvv_chk and and ok2 ok3 eq add add u3 u4 u5 0 tvv_m35
end

fn tvv_malformed to void
  ap = get tvv_x 4
  rs = og_rslot ap 0
  put v_og_rkind rs V_REL_DEPENDS_ON
  b = mul rs 32
  for i ulong 32

fn tvv_program to void
  b = tvv_build_unary 6 V_OP_ADD 5
  tvv_chk and eq b 0 ne get vver_p_real 0 0 tvv_m42
  u = vver_verify_program 1
  tvv_chk and eq u 0 ne get vver_passed 0 0 tvv_m43
  tvv_chk and and tvv_st 0 0 tvv_st 2 0 tvv_st 3 2 tvv_m44
  tvv_chk eq tvv_program_verify 0 tvv_m45
  put vver_p_real 0 0
  u2 = vver_verify_program 1
  tvv_field 0
  tvv_chk and and eq get vver_passed 0 0 tvv_ob_eq tvv_s_punr eq u2 0 tvv_m46
  put vver_p_real 0 1
  tvv_slot_copy 7 6

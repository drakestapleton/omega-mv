fn tvv_gen64 to void
  og_reset
  e = og_build_effect 1 1 3 4294967301
  ok = false
  if ge e 0
    if eq verq_build ulong e 0
      if gt verq_format_text 8192 0
        ok = tvv_ob_has tvv_s_g33
      end
    end
  end
  tvv_chk ok tvv_m48
  og_reset
  e2 = og_build_effect 1 1 3 ulong 0xffffffffffffffff
  ok2 = false
  if ge e2 0

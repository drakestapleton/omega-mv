  tvv_chk and and tvv_st 0 1 eq get vver_passed 0 0 gt get vver_vlen 0 0 tvv_m37
  og_reset
end

fn tvv_fadd_effect to void
  og_reset
  root = tvv_build_f_add_sub
  ok = false
  if ge root 0
    if eq tvv_realize_f_add_sub 5 ulong root 0

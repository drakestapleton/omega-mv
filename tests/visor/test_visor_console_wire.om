note SPDX-License-Identifier: Apache-2.0
note Full-build hook dispatcher of the console test: the test stubs (tst_ops) or,
note after e2e_open (tst_real = 1), visor_console_default_ops (tools/omega_ops.om).

global tst_real ulong 1

fn vcon_hook_wired hid ulong to bool
  if ne get tst_real 0 0
    ret lt hid 17
  end
  ret tst_wired hid
end

fn vcon_hook_call hid ulong to long
  if ne get tst_real 0 0
    ret vom_call hid
  end
  ret tst_call hid
end

fn vcon_hook_classify to long
  if ne get tst_real 0 0
    ret vom_classify
  end
  ret tst_classify
end

fn vcon_hook_eval to long
  if ne get tst_real 0 0
    ret vom_eval
  end
  ret tst_eval
end

note ---------------- script mode ----------------

text tsc_spath "tests/visor/sessions/basic.omega-session"
text tsc_epath "tests/visor/sessions/basic.expected"
text tscn_files "session files present (run from repo root)"
text tscn_same "basic.omega-session matches basic.expected exactly"
text tscn_rc "script with errors returns 1"
text tscn_quit "script stopped at quit"
text tscn_shape "json script: one object per line"
text tscn_echo "json script: no echo"
text tsc_got "--- script got:\n"
text tsc_cmd "{\"command\":\""

fn tsc_open_script to long
  ret fopen tsc_spath 0 len tsc_spath 0 0
end

global tsc_objs ulong 1
global tsc_sink long 1

note Read basic.expected into texp; returns the open result (fd or < 0).
fn tsc_read_expected to long
  put texp_n 0 0
  efd = fopen tsc_epath 0 len tsc_epath 0 0
  if lt efd 0
    ret efd
  end
  en = ulong 0
  while lt en 65536 bound 4096
    k = read int efd texp en sub 65536 en
    if le k 0
      break
    end
    en = add en ulong k
  end
  put texp_n 0 en
  ret long fclose int efd
end

fn tsc_cap_is_expected to bool
  en = get texp_n 0
  if ne get vcon_caplen 0 en
    ret false
  end
  for i ulong en bound 65536
    if ne get vcon_cap i get texp i
      ret false
    end
  end
  ret true
end

note Line [p, e) of the capture is one JSON object line.
fn tsc_obj_line p ulong e ulong to bool
  if lt sub e p 12
    ret false
  end
  for j ulong 12
    if ne get vcon_cap add p j get tsc_cmd j
      ret false
    end
  end
  ret eq get vcon_cap sub e 1 125
end

note Every capture line is one object; count in tsc_objs.
fn tsc_json_shape to bool
  n = get vcon_caplen 0
  put tsc_objs 0 0
  shape = true
  p = ulong 0
  while lt p n bound 65536
    e = p
    while lt e n bound 65536
      if eq get vcon_cap e 10
        break
      end
      e = add e 1
    end
    if ge e n
      ret false
    end
    if not tsc_obj_line p e
      shape = false
    end
    put tsc_objs 0 add get tsc_objs 0 1
    p = add e 1
  end
  ret shape
end

note Does the capture contain the prompt bytes CE A9 '>'?
fn tsc_has_echo to bool
  n = get vcon_caplen 0
  if lt n 3
    ret false
  end
  for i ulong sub n 2 bound 65536
    if eq get vcon_cap i 206
      if and eq get vcon_cap add i 1 169 eq get vcon_cap add i 2 62
        ret true
      end
    end
  end
  ret false
end

fn test_script to void
  er = tsc_read_expected
  sfd = tsc_open_script
  tc_check and ge er 0 ge sfd 0 tscn_files
  if lt sfd 0
    ret
  end
  if lt er 0
    put tsc_sink 0 long fclose int sfd
    ret
  end
  h_open 0
  rc = vcon_run_fd int sfd true false
  put tsc_sink 0 long fclose int sfd
  same = tsc_cap_is_expected
  if not same
    v_write_all 2 tsc_got
    put tsc_sink 0 long write 2 vcon_cap 0 get vcon_caplen 0
  end
  tc_check same tscn_same
  tc_check eq rc 1 tscn_rc
  tc_check ne get vcon_quit 0 0 tscn_quit
  sfd2 = tsc_open_script
  h_open 1
  put tsc_sink 0 vcon_run_fd int sfd2 false false
  put tsc_sink 0 long fclose int sfd2
  shape = tsc_json_shape
  tc_check and shape eq get tsc_objs 0 12 tscn_shape
  tc_check not tsc_has_echo tscn_echo
end

fn tc_report to int
  ob_reset 65535
  if eq get tc_pass 0 get tc_total 0
    ob_puts tc_t_pass
  else
    ob_puts tc_t_fail
  end
  ob_put_u64 get tc_pass 0
  ob_puts tc_t_slash
  ob_put_u64 get tc_total 0
  ob_putc uchar 10
  ob_write_fd 1
  if eq get tc_pass 0 get tc_total 0
    ret 0
  end
  ret 1
end

fn test_console_lane to void
  test_parser_a
  test_parser_b
  test_parser_c
  test_parser_d
  test_console_human
  test_console_stubs
  test_console_json
  test_script
end

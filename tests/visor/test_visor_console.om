fn test_parser_d to void
  tl_set tp_kept_in
  tline_to_in
  rc = vpc_parse_in get tl_n 0
  tl_set tp_let
  ok = and eq rc 0 eq get vpc_argc 0 0
  if ok
    ok = eq get vpc_llen 0 get tl_n 0
  end
  if ok
    for i ulong get tl_n 0 bound 64
      if ne get vpc_line i get tl_buf i
        ok = false
      end
    end
  end
  tc_check ok tp_n_srckept
  tl_set tp_id_sp
  tl_rep 97 256
  tline_to_in
  r2 = vpc_parse_in get tl_n 0
  tc_check and eq r2 -1 tpe_has tp_toolong tp_n_bigtok
  put tl_n 0 sub get tl_n 0 1
  tline_to_in
  r3 = vpc_parse_in get tl_n 0
  tc_check and eq r3 0 eq get vpc_alen 0 255 tp_n_255
  tl_reset
  tl_rep 120 4100
  tline_to_in
  r4 = vpc_parse_in get tl_n 0
  tc_check and eq r4 -1 tpe_has tp_linetl tp_n_bigline
  tl_set tp_runf12
  tline_to_in
  r5 = vpc_parse_in get tl_n 0
  tpc_snap false
  tline_to_in
  r6 = vpc_parse_in get tl_n 0
  tpc_snap true
  same = eq r5 r6
  for i ulong 5128 bound 6400
    if ne get tsn_a i get tsn_b i
      same = false
    end
  end
  tc_check same tp_n_det
  vcon_name_ob 16
  tw_set tp_alternatives
  n1 = vcon_ob_eq_tw
  vcon_name_ob 19
  tw_set tp_source
  tc_check and n1 vcon_ob_eq_tw tp_n_names
end


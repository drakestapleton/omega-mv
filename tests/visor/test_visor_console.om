fn th_help_word i ulong to void
  tw_set th_nl2
  if eq i 0
    tw_txt th_w0
  end
  if eq i 1
    tw_txt th_w1
  end
  if eq i 2
    tw_txt th_w2
  end
  if eq i 3
    tw_txt th_w3
  end
  if eq i 4
    tw_txt th_w4
  end
  if eq i 5
    tw_txt th_w5
  end
  if eq i 6
    tw_txt th_w6
  end
  if eq i 7
    tw_txt th_w7
  end
  if eq i 8
    tw_txt th_w8
  end
  if eq i 9
    tw_txt th_w9
  end
  if eq i 10
    tw_txt th_w10
  end
  if eq i 11
    tw_txt th_w11
  end
  if eq i 12
    tw_txt th_w12
  end
  if eq i 13
    tw_txt th_w13
  end
  if eq i 14
    tw_txt th_w14
  end
  if eq i 15
    tw_txt th_w15
  end
  if eq i 16
    tw_txt th_w16
  end
  if eq i 17
    tw_txt th_w17
  end
  if eq i 18
    tw_txt th_w18
  end
  if eq i 19
    tw_txt th_w19
  end
end

note Bind name s (into v_sbuf) to v_tmp_id.
fn th_bind_set s view uchar * kind ulong pidx long to long
  sl = len s
  for i ulong sl bound 64
    put v_sbuf i get s i
  end
  ret vs_bind_set_sbuf sl kind pidx
end

fn test_console_help to void
  tl_set th_w0
  h_exec
  tw_set th_help_hdr
  hdr = eq get tg_rc 0 0
  if lt get tg_len 0 87
    hdr = false
  else
    o = get tg_off 0
    for i ulong 87
      if ne get vcon_cap add o i get tw_buf i
        hdr = false
      end
    end
  end
  tc_check hdr thn_hdr
  lines = ulong 0
  o2 = get tg_off 0
  for i ulong get tg_len 0 bound 65536
    if eq get vcon_cap add o2 i 10
      lines = add lines 1
    end
  end
  tc_check eq lines 22 thn_lines
  for w ulong 20
    th_help_word w
    tc_check tg_has_tw thn_lists
  end
  tw_set th_row_run
  tc_check tg_has_tw thn_row
  exs th_help_id th_help_id_o
  ex_tw 0 thn_one
  exs th_help_nope th_help_nope_o
  ex_tw 1 thn_unk
end

fn test_console_human to void
  h_open 0
  test_console_help
  exs th_bind th_nobind
  ex_tw 0 thn_bempty
  tst_fake_id 16
  tc_check eq th_bind_set th_zeta V_BIND_OBJECT -1 0 thn_bzeta
  tst_fake_id 160
  tc_check eq th_bind_set th_alpha V_BIND_PROGRAM 0 1 thn_balpha
  tw_set th_zeta_obj
  tst_fake_id 16
  tw_id_tmp
  tw_b 10
  tw_txt th_alpha_prog
  tst_fake_id 160
  tw_id_tmp
  tw_b 10
  tl_set th_bind
  ex_tw 0 thn_border
  tst_fake_id 16
  tw_reset
  tw_id_tmp
  tw_b 10
  tl_set th_id_zeta
  ex_tw 0 thn_idb
  exs th_id_nope th_id_nope_o
  ex_tw 1 thn_idu
  tl_set tc_sha
  tl_txt tc_zero_hex
  tw_set th_src_notw
  ex_tw 1 thn_bare
  tl_set th_id_sp
  tl_txt tc_sha
  tl_txt tc_zero_hex
  tw_set th_id_unk_pfx
  tw_txt tc_sha
  tw_txt tc_zero_hex
  tw_txt th_q_nl
  ex_tw 1 thn_idhex
  exs th_id__ th_id___o
  ex_tw 1 thn_id_
  t = og_build_type_uint 64
  tc_check ge t 0 thn_btype
  if ge t 0
    tb = mul ulong t 32
    for i ulong 32
      put v_tmp_id i get v_og_id add tb i
    end
    tl_set th_id_sp
    tl_id_tmp
    tw_reset
    tw_id_tmp
    tw_b 10
    ex_tw 0 thn_idhexg
  end
  exs th_insp_zeta th_insp_notw
  ex_tw 1 thn_insp
  exs th_let_y th_src_notw
  ex_tw 1 thn_src
  exs th_run_zeta th_run_notw
  ex_tw 1 thn_run
  exs th_machine th_mach_notw
  ex_tw 1 thn_mach
  tl_reset
  tw_reset
  ex_tw 0 thn_empty
  tl_set th_note
  tw_reset
  ex_tw 0 thn_comment
  exs th_cmp_a th_cmp_a_o
  ex_tw 1 thn_arity
  tl_set th_id_sp
  tl_b 1
  tw_set th_ctrl_o
  ex_tw 1 thn_ctrl
  exs th_clear th_cleared
  ex_tw 0 thn_clear
  exs th_bind th_nobind
  ex_tw 0 thn_bclear
  tc_check eq get vcon_quit 0 0 thn_noquit
  exs th_quit th_bye
  ex_tw 0 thn_quit
  tc_check ne get vcon_quit 0 0 thn_qflag
end


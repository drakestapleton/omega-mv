fn test_console_stubs to void
  h_open 0
  tst_install_stubs
  exs ts_let ts_18
  ex_tw 0 tsn_src
  tc_check ne get v_has_last 0 0 tsn_last
  tst_fake_id 51
  tw_reset
  tw_id_tmp
  tw_b 10
  tl_set th_id__
  ex_tw 0 tsn_id_
  tw_set ts_x_obj
  tw_id_tmp
  tw_b 10
  tw_txt ts__obj
  tw_id_tmp
  tw_b 10
  tl_set th_bind
  ex_tw 0 tsn_bind
  exs ts_bad ts_bad_o
  ex_tw 1 tsn_err
  put tst_run_calls 0 0
  exs ts_run_x ts_run_x_o
  ex_tw 0 tsn_run
  tc_check eq get tst_run_calls 0 1 tsn_once
  tst_fake_id 68
  u = th_bind_set ts_w V_BIND_OBJECT -1
  exs ts_run_w ts_run_w_o
  ex_tw 1 tsn_eff
  tc_check and ge u 0 eq get tst_run_calls 0 1 tsn_never
  exs ts_run_nope ts_run_nope_o
  ex_tw 1 tsn_unres
  tc_check eq get tst_run_calls 0 1 tsn_unres2
  exs ts_effects ts_effects_o
  ex_tw 0 tsn_effv
  exs ts_verify_x ts_verify_x_o
  ex_tw 1 tsn_ewo
  exs ts_cost_x ts_cost_x_o
  ex_tw 1 tsn_hook
  h_open 0
  put tst_ops 0 shl ulong 1 VCON_HK_RUN
  put tst_run_calls 0 0
  exs ts_run__ th_run_notw
  ex_tw 1 tsn_nocls
  tc_check eq get tst_run_calls 0 0 tsn_nocls2
end


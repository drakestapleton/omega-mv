note One parse case: line in tl, then expectations.
fn tpc_case want_rc long want_cmd ulong argc ulong fc ulong to void
  tline_to_in
  tpc_run want_rc want_cmd argc fc
end

fn vcon_ob_eq_tw to bool
  n = get v_ob_len 0
  if ne n get tw_n 0
    ret false
  end
  for i ulong n bound 65536
    if ne get v_ob i get tw_buf i
      ret false
    end
  end
  ret true
end

note Does vpc_err contain text s?
fn tpe_has s view uchar * to bool
  n = get vpc_elen 0
  m = len s
  if gt m n
    ret false
  end
  for st ulong add sub n m 1 bound 512
    hit = true
    for j ulong m bound 64
      if ne get vpc_err add st j get s j
        hit = false
        break
      end
    end
    if hit
      ret true
    end
  end
  ret false
end

note Snapshot of the parsed VisorCommand fields (the C memcmp of the struct).
fn tpc_snap to_b bool to void
  if to_b
    put tsn_b 0 uchar get vpc_cmd 0
    put tsn_b 1 uchar get vpc_argc 0
    put tsn_b 2 uchar get vpc_for_cur 0
    put tsn_b 3 uchar get vpc_llen 0
    for i ulong 4
      put tsn_b add 4 i uchar get vpc_alen i
    end
    for i ulong 1024
      put tsn_b add 8 i get vpc_args i
    end
    for i ulong 4096
      put tsn_b add 1032 i get vpc_line i
    end
  else
    put tsn_a 0 uchar get vpc_cmd 0
    put tsn_a 1 uchar get vpc_argc 0
    put tsn_a 2 uchar get vpc_for_cur 0
    put tsn_a 3 uchar get vpc_llen 0
    for i ulong 4
      put tsn_a add 4 i uchar get vpc_alen i
    end
    for i ulong 1024
      put tsn_a add 8 i get vpc_args i
    end
    for i ulong 4096
      put tsn_a add 1032 i get vpc_line i
    end
  end
end


note SPDX-License-Identifier: Apache-2.0
note mach_dump.om -- the pure OM-2 side of tests/visor/mach_parity.sh. Reads the corpus of
note one-letter machine-graph and query commands on stdin and prints, line for line, what the
note retired C reference dumper printed from visor_machine_view, _from_facts, _current,
note _host_facts, _format_text, _format_json, _unit_name and _blackwell_id (the goldens in
note tests/visor/mach_golden), here from the shipped src/visor/visor_machine.om (graph slot 0,
note view 0, which shows graph slot 8).
note Commands: B p build (0 dgx_spark, 1 qemu_virt) | F f v field (0 issue_width, 1
note max_in_flight, 2 out_of_order, 3 unit_count, 4 gpr_count, 5 gpr_width, 6 vector_count, 7
note vector_width, 8 cache_count, 9 dram_base, 10 dram_size, 11 physics flag, 12
note target_profile) | U u f v unit field (type, count, latency, throughput) | C c f v cache field
note (level, instruction, size, line, assoc, latency) | S i v seal byte | N b.. name | K compute
note the id | V view | A f b.. append to host fact f (0 uname, 1 dmi, 2 cpu parts) | Z clear the
note facts | P from_facts | Q current (this host) | H host facts | X t unit name | W Blackwell id.

global mcd_in uchar 4194304
global mcd_ob uchar 65536
global mcd_on ulong 1
global mcd_d uchar 24
global mcd_a ulong 64
global mcd_na ulong 1

fn mcd_flush to void
  n = get mcd_on 0
  if gt n 0
    k = write 1 mcd_ob 0 n
  end
  put mcd_on 0 0
end

fn mcd_c c ulong to void
  n = get mcd_on 0
  if ge n 65000
    mcd_flush
    n = 0
  end
  put mcd_ob n uchar c
  put mcd_on 0 add n 1
end

fn mcd_t s view uchar * to void
  n = len s
  for i ulong n bound 4096
    mcd_c ulong get s i
  end
end

fn mcd_u v ulong to void
  k = ulong 0
  x = v
  while gt x 9 bound 24
    put mcd_d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  put mcd_d k uchar add 48 x
  k = add k 1
  while gt k 0 bound 24
    k = sub k 1
    mcd_c ulong get mcd_d k
  end
end

fn mcd_i v long to void
  if lt v 0
    mcd_c 45
    mcd_u ulong sub 0 v
  else
    mcd_u ulong v
  end
end

fn mcd_hb b ulong to void
  h = shr b 4
  l = and b 15
  if lt h 10
    mcd_c add 48 h
  else
    mcd_c add 87 h
  end
  if lt l 10
    mcd_c add 48 l
  else
    mcd_c add 87 l
  end
end

text mcd_t_b " B rc="
text mcd_t_k " K rc=-1\n"
text mcd_t_v " V"
text mcd_t_p " P"
text mcd_t_q " Q"
text mcd_t_rc " rc="
text mcd_t_tt " T="
text mcd_t_jj " J="
text mcd_t_bb " B="
text mcd_t_h " H rc="
text mcd_t_hu " u="
text mcd_t_hd " d="
text mcd_t_hc " c="
text mcd_t_x " X "
text mcd_t_w " W rc="
text mcd_t_id " id="
text mcd_t_q2 " ? "

fn mcd_ln ln ulong to void
  mcd_c 76
  mcd_u ln
end

fn mcd_vob n long to void
  for i ulong ulong n bound 65536
    mcd_c ulong get v_ob i
  end
end

fn mcd_parse s ulong e ulong to void
  for i ulong 64
    put mcd_a i 0
  end
  put mcd_na 0 0
  p = add s 1
  for i ulong 64
    while and lt p e eq get mcd_in p 32 bound 16384
      p = add p 1
    end
    if ge p e
      break
    end
    d = ulong get mcd_in p
    if or lt d 48 gt d 57
      break
    end
    v = ulong 0
    while lt p e bound 16384
      d = ulong get mcd_in p
      if or lt d 48 gt d 57
        break
      end
      v = add mul v 10 sub d 48
      p = add p 1
    end
    put mcd_a i v
    put mcd_na 0 add i 1
  end
end

fn mcd_arg i ulong to ulong
  ret get mcd_a i
end

fn mcd_b v ulong to ulong
  if ne v 0
    ret 1
  end
  ret 0
end

fn mcd_u32 v ulong to ulong
  ret and v 0xffffffff
end

note F f v: the C field's own type (uint32, bool, size_t, uint64, uint8).
fn mcd_field to void
  f = mcd_arg 0
  v = mcd_arg 1
  if gt f 12
    ret
  end
  k = add f 1
  if eq f 12
    k = VMCH_K_PROF
  end
  w = mcd_u32 v
  if or eq f 2 eq f 11
    w = mcd_b v
  end
  if or eq f 3 or eq f 8 or eq f 9 eq f 10
    w = v
  end
  if eq f 12
    w = and v 255
  end
  vmch_gset 0 k w
end

fn mcd_unit to void
  u = mcd_arg 0
  f = mcd_arg 1
  if gt f 3
    ret
  end
  vmch_gset 0 add add VMCH_K_UNIT mul u 4 f mcd_u32 mcd_arg 2
end

fn mcd_cache to void
  c = mcd_arg 0
  f = mcd_arg 1
  v = mcd_arg 2
  if gt f 5
    ret
  end
  w = mcd_u32 v
  if eq f 1
    w = mcd_b v
  end
  if eq f 2
    w = v
  end
  vmch_gset 0 add add VMCH_K_CACHE mul c 6 f w
end

fn mcd_name to void
  n = get mcd_na 0
  if gt n 63
    n = 63
  end
  for k ulong 64
    put vmch_gname k uchar 0
  end
  for k ulong n bound 64
    put vmch_gname k uchar and mcd_arg k 255
  end
  vmch_gset 0 VMCH_K_NLEN n
end

fn mcd_fact to void
  f = mcd_arg 0
  if gt f 2
    ret
  end
  cap = ulong 64
  if eq f 0
    cap = 32
  end
  n = get mcd_na 0
  for i ulong n bound 64
    if gt i 0
      vmch_fact_c f uchar and mcd_arg i 255 cap
    end
  end
end

fn mcd_show ln ulong w view uchar * rc long to void
  mcd_ln ln
  mcd_t w
  mcd_t mcd_t_rc
  mcd_i rc
  mcd_c 10
  tl = vmch_format_text 65536
  if ge tl 0
    mcd_vob tl
  end
  mcd_ln ln
  mcd_t mcd_t_tt
  mcd_i tl
  mcd_c 10
  jl = vmch_format_json 65536
  if ge jl 0
    mcd_vob jl
    mcd_c 10
  end
  mcd_ln ln
  mcd_t mcd_t_jj
  mcd_i jl
  if and ge tl 0 ge jl 0
    mcd_t mcd_t_bb
    mcd_i vmch_format_text 0
    mcd_c 32
    mcd_i vmch_format_json 0
    mcd_c 32
    mcd_i vmch_format_text ulong tl
    mcd_c 32
    mcd_i vmch_format_text add ulong tl 1
    mcd_c 32
    mcd_i vmch_format_json ulong jl
    mcd_c 32
    mcd_i vmch_format_json add ulong jl 1
    mcd_c 32
    mcd_i vmch_format_text 1
  end
  mcd_c 10
end

fn mcd_put_fact f ulong to void
  l = get vmch_factl f
  for k ulong l bound 64
    mcd_c ulong get vmch_fact add mul f 64 k
  end
end

fn mcd_line ln ulong s ulong e ulong to void
  c = ulong get mcd_in s
  mcd_parse s e
  if eq c 66
    rc = long 0
    if ne mcd_arg 0 0
      rc = vmch_build_qemu 0
    else
      rc = vmch_build_spark 0
    end
    if ne rc 0
      mcd_ln ln
      mcd_t mcd_t_b
      mcd_i rc
      mcd_c 10
    end
    ret
  end
  if eq c 70
    mcd_field
    ret
  end
  if eq c 85
    mcd_unit
    ret
  end
  if eq c 67
    mcd_cache
    ret
  end
  if eq c 83
    put vmch_gseal mcd_arg 0 uchar and mcd_arg 1 255
    ret
  end
  if eq c 78
    mcd_name
    ret
  end
  if eq c 75
    if ne vmch_compute_id 0 0
      mcd_ln ln
      mcd_t mcd_t_k
    end
    ret
  end
  if eq c 86
    mcd_show ln mcd_t_v vmch_view 0 0
    ret
  end
  if eq c 65
    mcd_fact
    ret
  end
  if eq c 90
    vmch_facts_clear
    ret
  end
  if eq c 80
    mcd_show ln mcd_t_p vmch_from_facts 0 0
    ret
  end
  if eq c 81
    mcd_show ln mcd_t_q vmch_current 0 0
    ret
  end
  if eq c 72
    rc = vmch_host_facts
    mcd_ln ln
    mcd_t mcd_t_h
    mcd_i rc
    mcd_t mcd_t_hu
    mcd_put_fact 0
    mcd_t mcd_t_hd
    mcd_put_fact 1
    mcd_t mcd_t_hc
    mcd_put_fact 2
    mcd_c 10
    ret
  end
  if eq c 88
    t = mcd_arg 0
    mcd_ln ln
    mcd_t mcd_t_x
    mcd_u t
    mcd_c 32
    ob_reset 4096
    vmch_unit_name mcd_u32 t
    mcd_vob long get v_ob_len 0
    mcd_c 10
    ret
  end
  if eq c 87
    rc = vmch_blackwell_id
    mcd_ln ln
    mcd_t mcd_t_w
    mcd_i rc
    if eq rc 0
      mcd_t mcd_t_id
      for i ulong 32
        mcd_hb ulong get vmch_bw_id i
      end
    end
    mcd_c 10
    ret
  end
  mcd_ln ln
  mcd_t mcd_t_q2
  mcd_c c
  mcd_c 10
end

fn main to int
  total = ulong 0
  while lt total 4194304 bound 100000
    r = read 0 mcd_in total sub 4194304 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  ln = ulong 0
  p = ulong 0
  while lt p total bound 4194305
    if eq get mcd_in p 10
      ln = add ln 1
      if gt p start
        c = get mcd_in start
        if ne c 35
          mcd_line ln start p
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  mcd_flush
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note real_dump.om -- the pure OM-2 side of tests/visor/real_parity.sh. Reads the corpus of
note one-letter commands on stdin and prints, byte for byte, what the retired C reference dumper
note printed from the C realization lab (src/visor/visor_realization.c at 3f2c70dc5): realize
note apply/program, view, cost, run_pure, alternatives (with and without entries), compare,
note why, format text/json, cost text/json and, through the view, the disassembly.
note Built after the shipped modules: visor.om, the units, visor_machine.om, visor_program.om,
note visor_realization.om. The current entry is entry 8 / view 8 (the C dumper's `cur`); the
note machines 0 dgx-spark, 1 qemu-virt, 2 none, 3 dgx-spark with machine id byte 0 flipped; the
note current program is program 0 (the C dumper's `gp`); the raw graph is the OM-2 OmegaGraph.
note Commands: see tests/visor/real_parity.sh.

global dd uchar 65536
global dd_n ulong 1
global dd_xs ulong 10
global dd_px ulong 12
global dd_op ulong 20
global dd_im ulong 20
global dd_L long 4

text dd_tT "T"
text dd_tJ "J"
text dd_tW "\nW"
text dd_tC "C"
text dd_tK "\nK"
text dd_tQ "Q"
text dd_man "man"
text dd_nobody "nobody"
text dd_u "u"
text dd_mul2 "mul2"
text dd_add1 "add1"
text dd_mul3 "mul3"
text dd_sub2 "sub2"
text dd_c "c"
text dd_s "s"
text dd_pre "x >= 0"
text dd_post "manual"
text dd_A "A "
text dd_rc " rc "
text dd_r "r "
text dd_ra "ra "
text dd_O "O rc "
text dd_TY "TY rc "
text dd_JU "JU rc "
text dd_VA "VA rc "
text dd_tr "tr"
text dd_P "P "
text dd_RP "RP "
text dd_AL "AL "
text dd_n_ " n "
text dd_e "e "

fn dd_long v long to void
  if lt v 0
    ob_putc uchar 45
    ob_put_u64 ulong neg v
  else
    ob_put_u64 ulong v
  end
end

fn dd_sp to void
  ob_putc uchar 32
end

fn dd_nl to void
  ob_putc uchar 10
end

fn dd_flush to void
  ob_write_fd 1
  ob_reset 65535
end

note print prefix + rc + newline, then the formatter output (saved from ob) when rc > 0
fn dd_out pre view uchar * rc long to void
  n = get v_ob_len 0
  for i ulong n bound 65536
    put dd i get v_ob i
  end
  put dd_n 0 n
  ob_reset 65535
  ob_puts pre
  dd_long rc
  dd_nl
  dd_flush
  if gt rc 0
    k = write 1 dd 0 get dd_n 0
    if lt k 0
      ret
    end
  end
end

fn dd_outv v ulong to void
  dd_out dd_tT vrl_format_text v 65536
  dd_out dd_tJ vrl_format_json v 65536
  dd_out dd_tW vrl_why v 65536
  dd_out dd_tC vrl_cost_format_json v 65536
  dd_out dd_tK vrl_cost_format_text v 65536
end

fn dd_fmt v ulong f ulong n ulong to long
  if eq f 0
    ret vrl_format_text v n
  end
  if eq f 1
    ret vrl_format_json v n
  end
  if eq f 2
    ret vrl_why v n
  end
  ret vrl_cost_format_text v n
end

fn dd_trn i ulong l long to ulong
  x = long 1
  if eq i 1
    x = 2
  end
  if eq i 2
    x = 63
  end
  if eq i 3
    x = 64
  end
  if ge i 4
    x = add l sub long i 5
  end
  if lt x 1
    x = 1
  end
  ret ulong x
end

fn dd_trunc v ulong to void
  for f ulong 4
    put dd_L f dd_fmt v f 65536
  end
  for f ulong 4
    l = get dd_L f
    ob_reset 65535
    ob_puts dd_tr
    ob_put_u64 f
    ob_write_fd 1
    for i ulong 8
      r = dd_fmt v f dd_trn i l
      ob_reset 65535
      dd_sp
      dd_long r
      ob_write_fd 1
    end
    ob_reset 65535
    dd_nl
    dd_flush
  end
end

fn dd_mg mi ulong to ulong
  if eq mi 2
    ret VRL_NOMG
  end
  ret mi
end

fn dd_opc oi ulong to ulong
  if eq oi 0
    ret V_OP_ADD
  end
  if eq oi 1
    ret V_OP_SUB
  end
  if eq oi 2
    ret V_OP_MUL
  end
  if eq oi 3
    ret V_OP_DIV
  end
  if eq oi 4
    ret V_OP_AND
  end
  if eq oi 5
    ret V_OP_OR
  end
  if eq oi 6
    ret V_OP_EQUAL
  end
  ret V_OP_NOT
end

fn dd_runs to void
  for i ulong 10
    for k ulong 10
      q = vrl_run_pure 0 2 get dd_xs i get dd_xs k 0
      ob_reset 65535
      ob_puts dd_r
      dd_long q
      dd_sp
      if eq q 0
        ob_put_u64 get vrl_run_out 0
      else
        ob_putc uchar 48
      end
      dd_nl
      dd_flush
    end
  end
  for a ulong 5
    q = vrl_run_pure 0 a 9 4 1
    ob_reset 65535
    ob_puts dd_ra
    ob_put_u64 a
    dd_sp
    dd_long q
    dd_sp
    if eq q 0
      ob_put_u64 get vrl_run_out 0
    else
      ob_putc uchar 48
    end
    dd_nl
    dd_flush
  end
end

fn dd_line pre view uchar * rc long to void
  ob_reset 65535
  ob_puts pre
  dd_long rc
  dd_nl
  dd_flush
end

fn dd_extra mg ulong t ulong a ulong to void
  og_tmp_from_obj t
  rc = vrl_realize_apply mg 0 0
  dd_line dd_TY rc
  dd_outv 0
  dd_trunc 0
  for i ulong 32
    put v_tmp_id i uchar 0x5a
  end
  rc2 = vrl_realize_apply mg 0 0
  dd_line dd_JU rc2
  dd_outv 0
  og_tmp_from_obj a
  rc3 = vrl_realize_apply mg 0 0
  dd_line dd_VA rc3
  dd_outv 0
end

fn dd_head mi ulong opc ulong ov ulong w ulong rc long to void
  ob_reset 65535
  ob_puts dd_A
  ob_put_u64 mi
  dd_sp
  ob_put_u64 opc
  dd_sp
  ob_put_u64 ov
  dd_sp
  ob_put_u64 w
  ob_puts dd_rc
  dd_long rc
  dd_nl
  dd_flush
end

fn dd_tail mi ulong oi ulong mg ulong t ulong a ulong to void
  if or ne mi 0 ne oi 0
    ret
  end
  dd_trunc 0
  dd_extra mg t a
end

global dd_obj ulong 4

note make_apply: dd_obj 0 type, 1 first value, 2 operation, 3 apply
fn dd_make opc ulong ov ulong w ulong to void
  t = ulong og_build_type_uint w
  put dd_obj 0 t
  a = ulong og_build_val_uint t w 7
  put dd_obj 1 a
  b = ulong og_build_val_uint t w 11
  o = ulong og_build_op_binary opc ov t
  put dd_obj 2 o
  put dd_obj 3 ulong og_build_apply o a b
end

fn dd_apply mi ulong oi ulong ov ulong wi ulong to void
  og_reset
  w = shl 8 wi
  mg = dd_mg mi
  opc = dd_opc oi
  dd_make opc ov w
  og_tmp_from_obj get dd_obj 3
  rc = vrl_realize_apply mg 0 0
  dd_head mi opc ov w rc
  dd_outv 0
  if eq rc 0
    dd_runs
  end
  if and eq wi 3 eq ov 1
    og_tmp_from_obj get dd_obj 2
    rc2 = vrl_realize_apply mg 0 0
    dd_line dd_O rc2
    dd_outv 0
    dd_tail mi oi mg get dd_obj 0 get dd_obj 1
  end
end

note manual(p, it, iw, ot, ow, dd_op, dd_im, n)
fn dd_manual p ulong it ulong iw ulong ot ulong ow ulong n ulong to void
  vpg_init p dd_man
  vpg_p p VPG_ITAG it
  vpg_p p VPG_IW iw
  vpg_p p VPG_OTAG ot
  vpg_p p VPG_OW ow
  vsb_reset
  vsb_t dd_pre
  vpg_set_txt p 1 63
  u1 = vpg_constraint_id p 1 V_CONST_PRECONDITION
  vsb_reset
  vsb_t dd_post
  vpg_set_txt p 2 63
  u2 = vpg_constraint_id p 2 V_CONST_POSTCONDITION
  vpg_p p VPG_HASB 1
  vpg_p p VPG_SCNT n
  for i ulong n bound 20
    put vpg_op add mul p 64 i get dd_op i
    put vpg_imm add mul p 64 i get dd_im i
  end
  u3 = vpg_compute_id p
  if lt add add u1 u2 u3 -999
    ret
  end
end

fn dd_mset to void
  put dd_op 0 V_OP_MUL
  put dd_im 0 3
  put dd_op 1 V_OP_ADD
  put dd_im 1 127
  put dd_op 2 V_OP_AND
  put dd_im 2 85
  put dd_op 3 V_OP_OR
  put dd_im 3 1
  put dd_op 4 V_OP_SUB
  put dd_im 4 2
end

fn dd_uimm i ulong to ulong
  if eq i 0
    ret 0
  end
  if eq i 1
    ret 1
  end
  if eq i 2
    ret 5
  end
  if eq i 3
    ret 65535
  end
  if eq i 4
    ret 74565
  end
  if eq i 5
    ret 4294967295
  end
  ret 4294967296
end

fn dd_uop i ulong to ulong
  if eq i 0
    ret V_OP_ADD
  end
  if eq i 1
    ret V_OP_SUB
  end
  if eq i 2
    ret V_OP_MUL
  end
  if eq i 3
    ret V_OP_AND
  end
  if eq i 4
    ret V_OP_OR
  end
  ret V_OP_DIV
end

fn dd_chain to long
  u = vpg_build_unary 3 dd_c V_OP_ADD 1
  for j ulong 16
    i = add j 2
    op = V_OP_ADD
    if eq rem i 3 0
      op = V_OP_MUL
    end
    u2 = vpg_build_unary 4 dd_s op i
    if ne vpg_compose 3 4 5 128 0
      ret -1
    end
    vpg_copy 3 5
    if lt u2 -999
      ret -1
    end
  end
  vpg_copy 0 3
  if lt u -999
    ret -1
  end
  ret 0
end

fn dd_prog_m k ulong to long
  dd_mset
  if lt k 4
    w = shl 8 k
    dd_manual 0 V_TY_UINT w V_TY_UINT w 5
    ret 0
  end
  if eq k 4
    put dd_op 0 V_OP_ADD
    put dd_im 0 256
    dd_manual 0 V_TY_UINT 8 V_TY_UINT 8 1
    ret 0
  end
  if eq k 5
    dd_manual 0 V_TY_UINT 32 V_TY_UINT 64 5
    ret 0
  end
  if eq k 6
    dd_manual 0 V_TY_SINT 32 V_TY_SINT 32 5
    ret 0
  end
  if eq k 7
    dd_manual 0 V_TY_UINT 12 V_TY_UINT 12 5
    ret 0
  end
  if eq k 8
    for i ulong 20
      if eq rem i 2 1
        put dd_op i V_OP_MUL
      else
        put dd_op i V_OP_ADD
      end
      put dd_im i add i 1
    end
    dd_manual 0 V_TY_UINT 8 V_TY_UINT 8 20
    ret 0
  end
  if eq k 9
    put dd_op 0 V_OP_ADD
    put dd_im 0 1
    put dd_op 1 V_OP_DIV
    put dd_im 1 2
    dd_manual 0 V_TY_UINT 64 V_TY_UINT 64 2
    ret 0
  end
  if eq k 10
    dd_manual 0 V_TY_UINT 16 V_TY_UINT 16 5
    put vpg_imm 0 9
    ret 0
  end
  if eq k 11
    vpg_init 0 dd_nobody
    ret 0
  end
  if eq k 12
    u1 = vpg_build_unary 1 dd_mul2 V_OP_MUL 2
    u2 = vpg_build_unary 2 dd_add1 V_OP_ADD 1
    if lt add u1 u2 -999
      ret -1
    end
    ret vpg_compose 1 2 0 128
  end
  if eq k 13
    u3 = vpg_build_unary 1 dd_mul3 V_OP_MUL 3
    u4 = vpg_build_unary 2 dd_sub2 V_OP_SUB 2
    if lt add u3 u4 -999
      ret -1
    end
    ret vpg_compose 1 2 0 128
  end
  if eq k 14
    ret dd_chain
  end
  ret -9
end

fn dd_prog k ulong to long
  if lt k 42
    ret vpg_build_unary 0 dd_u dd_uop div k 7 dd_uimm rem k 7
  end
  ret dd_prog_m sub k 42
end

fn dd_hexid to void
  ob_reset 65535
  b = vpg_ib 0 0
  for i ulong 32
    ob_put_hex_byte ulong get vpg_ids add b i
  end
  dd_nl
  dd_flush
end

fn dd_pruns to void
  for i ulong 12
    q = vrl_run_pure 0 1 get dd_px i 0 0
    ob_reset 65535
    ob_puts dd_r
    dd_long q
    dd_sp
    if eq q 0
      ob_put_u64 get vrl_run_out 0
    else
      ob_putc uchar 48
    end
    dd_nl
    dd_flush
  end
end

fn dd_ent e ulong to void
  ob_reset 65535
  ob_puts dd_e
  ob_put_u64 vre_g e VE_VK
  dd_sp
  ob_put_u64 vre_g e VE_COMPAT
  dd_sp
  ob_put_u64 vre_g e VE_HASEM
  dd_sp
  ob_put_u64 vre_g e VE_HASEST
  dd_sp
  n = vre_g e VE_RLEN
  for i ulong n bound 128
    ob_putc get vre_ir add mul e 128 i
  end
  ob_putc uchar 124
  dd_nl
  dd_flush
end

fn dd_alts mi ulong mx ulong to void
  q = vrl_alternatives_ex 0 dd_mg mi 0 0 mx
  n = get vrl_cnt 0
  ob_reset 65535
  ob_puts dd_AL
  ob_put_u64 mi
  ob_puts dd_rc
  dd_long q
  ob_puts dd_n_
  ob_put_u64 n
  dd_nl
  dd_flush
  for i ulong n bound 4
    dd_ent i
    dd_outv i
  end
  if eq n 4
    dd_out dd_tQ vrl_compare 0 2 65536
    dd_out dd_tQ vrl_compare 1 3 65536
  end
end

fn dd_prog_case k ulong to void
  rc = dd_prog k
  ob_reset 65535
  ob_puts dd_P
  ob_put_u64 k
  ob_puts dd_rc
  dd_long rc
  dd_nl
  dd_flush
  dd_hexid
  for mi ulong 3
    q = vrl_realize_program 0 dd_mg mi 0 0
    ob_reset 65535
    ob_puts dd_RP
    ob_put_u64 mi
    ob_puts dd_rc
    dd_long q
    dd_nl
    dd_flush
    dd_outv 0
    if eq q 0
      dd_pruns
    end
  end
  for mi ulong 3
    dd_alts mi 4
  end
end


global rd_in uchar 4194304
global rd_a ulong 4
global rd_cur long 1

const RD_E ulong 8

text rd_tn0 "aarch64-v8a"
text rd_tn1 "dgx-spark"
text rd_tn2 "qemu-virt"
text rd_tn3 "blackwell-gb10-sm121"
text rd_tn4 "x86-64"
text rd_tn5 "aarch64-v8"
text rd_tn6 "abcdefghijklmnopqrstuvwxyz01234"
text rd_reason "corpus verdict"
text rd_L "L"
text rd_full " O full"
text rd_tfull " T full"
text rd_irc " I rc=-1"
text rd_o " o "
text rd_G " G "
text rd_H " H "
text rd_v " v "
text rd_c " c "
text rd_x " x "
text rd_w " w "
text rd_q " ? "

fn rd_arg i ulong to ulong
  ret get rd_a i
end

fn rd_b i ulong to ulong
  if ne get rd_a i 0
    ret 1
  end
  ret 0
end

fn rd_parse s ulong e ulong to void
  for i ulong 4
    put rd_a i 0
  end
  p = add s 1
  for i ulong 4
    while and lt p e eq get rd_in p 32 bound 8192
      p = add p 1
    end
    if ge p e
      break
    end
    d = ulong get rd_in p
    if or lt d 48 gt d 57
      break
    end
    v = ulong 0
    while lt p e bound 8192
      d = ulong get rd_in p
      if or lt d 48 gt d 57
        break
      end
      v = add mul v 10 sub d 48
      p = add p 1
    end
    put rd_a i v
  end
end

note "L<ln><s>" then a newline when nl
fn rd_lnmsg ln ulong s view uchar * to void
  ob_reset 65535
  ob_puts rd_L
  ob_put_u64 ln
  ob_puts s
  dd_nl
  dd_flush
end

fn rd_pay_off off ulong to ulong
  ret add mul ulong get rd_cur 0 V_MAX_PAYLOAD off
end

fn rd_field msb bool to void
  off = rd_arg 0
  nb = rd_arg 1
  v = rd_arg 2
  for i ulong nb bound 8
    sh = mul 8 i
    if msb
      sh = mul 8 sub sub nb 1 i
    end
    put v_og_pay rd_pay_off add off i uchar and shr v sh 255
  end
end

text rd_curcmds "LBEWFXTI"

fn rd_is_cur_cmd c ulong to bool
  for i ulong 8
    if eq c ulong get rd_curcmds i
      ret true
    end
  end
  ret false
end

note raw graph commands R O L B E W F X T I; true when c is one of them
fn rd_graph ln ulong c ulong to bool
  if eq c 82
    og_reset
    put rd_cur 0 -1
    ret true
  end
  if eq c 79
    r = og_add_object rd_arg 0
    if lt r 0
      rd_lnmsg ln rd_full
    else
      put rd_cur 0 r
    end
    ret true
  end
  if not rd_is_cur_cmd c
    ret false
  end
  if lt get rd_cur 0 0
    ret true
  end
  cur = ulong get rd_cur 0
  if eq c 76
    put v_og_plen cur rd_arg 0
  end
  if eq c 66
    put v_og_pay rd_pay_off rd_arg 0 uchar and rd_arg 1 255
  end
  if eq c 69
    rd_field true
  end
  if eq c 87
    rd_field false
  end
  if eq c 70
    jb = mul rd_arg 1 32
    for i ulong 32
      put v_og_pay rd_pay_off add rd_arg 0 i get v_og_id add jb i
    end
  end
  if eq c 88
    for i ulong 32
      put v_og_pay rd_pay_off add rd_arg 0 i uchar and rd_arg 1 255
    end
  end
  if eq c 84
    if lt og_add_rel cur rd_arg 0 rd_arg 1 0
      rd_lnmsg ln rd_tfull
    end
  end
  if eq c 73
    if lt og_compute_id cur 0
      rd_lnmsg ln rd_irc
    end
  end
  ret true
end

note o sint w opcode ov: type, two values 7 and 11, the operation and its apply
fn rd_build ln ulong to void
  w = rd_arg 1
  t = long 0
  if ne rd_arg 0 0
    t = og_build_type_sint w
  else
    t = og_build_type_uint w
  end
  x = ulong og_build_val_uint ulong t w 7
  y = ulong og_build_val_uint ulong t w 11
  o = ulong og_build_op_binary rd_arg 2 rd_arg 3 ulong t
  ap = og_build_apply o x y
  ob_reset 65535
  ob_puts rd_L
  ob_put_u64 ln
  ob_puts rd_o
  dd_long ap
  dd_nl
  dd_flush
end

fn rd_head ln ulong s view uchar * a ulong mi ulong to void
  ob_reset 65535
  ob_puts rd_L
  ob_put_u64 ln
  ob_puts s
  ob_put_u64 a
  dd_sp
  ob_put_u64 mi
  ob_puts dd_rc
end

fn rd_tname i ulong to void
  e = RD_E
  if eq i 0
    vre_set_tn e rd_tn0
  end
  if eq i 1
    vre_set_tn e rd_tn1
  end
  if eq i 2
    vre_set_tn e rd_tn2
  end
  if eq i 3
    vre_set_tn e rd_tn3
  end
  if eq i 4
    vre_set_tn e rd_tn4
  end
  if eq i 5
    vre_set_tn e rd_tn5
  end
  if eq i 6
    vre_set_tn e rd_tn6
  end
  if eq i 7
    vre_p e VE_TLEN 0
  end
end

fn rd_entry c ulong to bool
  e = RD_E
  r = vre_r e
  if eq c 110
    rd_tname rem rd_arg 0 8
    ret true
  end
  if eq c 113
    vro_p r VRO_PROF and rd_arg 0 255
    ret true
  end
  if eq c 122
    vro_p r VRO_CLEN rd_arg 0
    ret true
  end
  if eq c 117
    vro_p r VRO_EOFF and rd_arg 0 4294967295
    ret true
  end
  if eq c 107
    b = add mul r 4096 rd_arg 0
    w = rd_arg 1
    for i ulong 4
      put vro_code add b i uchar and shr w mul 8 i 255
    end
    ret true
  end
  if eq c 109
    vre_p e VE_HASEM rd_b 0
    ret true
  end
  if eq c 98
    u = vmch_blackwell_id
    b = vre_ib e 1
    for i ulong 32
      put vre_ids add b i get vmch_bw_id i
    end
    if lt u -999
      ret true
    end
    ret true
  end
  if eq c 104
    vro_p r VRO_HASM rd_b 0
    ret true
  end
  if eq c 106
    vre_p e VE_VK rd_b 0
    vre_p e VE_COMPAT rd_b 1
    vsb_reset
    if ne rd_arg 2 0
      vsb_t rd_reason
    end
    vre_set_ir e
    ret true
  end
  if eq c 115
    vre_p e VE_HASEST rd_b 0
    vre_p e VE_EST and rd_arg 1 4294967295
    ret true
  end
  ret false
end

fn rd_line ln ulong s ulong en ulong to void
  c = ulong get rd_in s
  rd_parse s en
  if rd_graph ln c
    ret
  end
  if rd_entry c
    ret
  end
  mi = rem rd_arg 1 4
  e = RD_E
  if eq c 65
    a0 = rem rd_arg 0 3
    a1 = rem rd_arg 1 8
    a2 = rem rd_arg 2 4
    a3 = rem rd_arg 3 4
    dd_apply a0 a1 a2 a3
    ret
  end
  if eq c 80
    dd_prog_case rd_arg 0
    ret
  end
  if eq c 111
    rd_build ln
    ret
  end
  if eq c 71
    og_tmp_from_obj rd_arg 0
    rc = vrl_realize_apply dd_mg mi e e
    rd_head ln rd_G rd_arg 0 mi
    dd_long rc
    dd_nl
    dd_flush
    dd_outv e
    ret
  end
  if eq c 72
    rc = dd_prog rd_arg 0
    q = vrl_realize_program 0 dd_mg mi e e
    rd_head ln rd_H rd_arg 0 mi
    dd_long rc
    dd_sp
    dd_long q
    dd_nl
    dd_flush
    dd_outv e
    ret
  end
  if eq c 118
    rc = vrl_view e dd_mg mi e
    ob_reset 65535
    ob_puts rd_L
    ob_put_u64 ln
    ob_puts rd_v
    ob_put_u64 mi
    ob_puts dd_rc
    dd_long rc
    dd_nl
    dd_flush
    dd_outv e
    ret
  end
  if eq c 99
    rc = vrl_cost e dd_mg mi e
    ob_reset 65535
    ob_puts rd_L
    ob_put_u64 ln
    ob_puts rd_c
    ob_put_u64 mi
    ob_puts dd_rc
    dd_long rc
    dd_nl
    dd_flush
    dd_out dd_tC vrl_cost_format_json e 65536
    dd_out dd_tK vrl_cost_format_text e 65536
    ret
  end
  if eq c 120
    q = vrl_run_pure e rd_arg 0 rd_arg 1 rd_arg 2 rd_arg 3
    ob_reset 65535
    ob_puts rd_L
    ob_put_u64 ln
    ob_puts rd_x
    dd_long q
    dd_sp
    if eq q 0
      ob_put_u64 get vrl_run_out 0
    else
      ob_putc uchar 48
    end
    dd_nl
    dd_flush
    ret
  end
  if eq c 121
    dd_trunc e
    ret
  end
  if eq c 119
    q = vrl_alternatives_ex 0 dd_mg mi VRL_NOMG 0 rd_arg 0
    n = get vrl_cnt 0
    ob_reset 65535
    ob_puts rd_L
    ob_put_u64 ln
    ob_puts rd_w
    ob_put_u64 mi
    ob_puts dd_rc
    dd_long q
    ob_puts dd_n_
    ob_put_u64 n
    dd_nl
    dd_flush
    for i ulong n bound 4
      dd_outv i
    end
    ret
  end
  if eq c 101
    dd_alts mi rd_arg 0
    ret
  end
  if eq c 81
    dd_out dd_tQ vrl_compare e rem rd_arg 0 4 65536
    ret
  end
  ob_reset 65535
  ob_puts rd_L
  ob_put_u64 ln
  ob_puts rd_q
  ob_putc uchar c
  dd_nl
  dd_flush
end

fn main to int
  vs_init
  u1 = vmch_build_spark 0
  u2 = vmch_build_qemu 1
  vmch_graph_copy 3 0
  put vmch_gid 96 uchar xor ulong get vmch_gid 96 1
  put dd_xs 0 0
  put dd_xs 1 1
  put dd_xs 2 2
  put dd_xs 3 5
  put dd_xs 4 10
  put dd_xs 5 50
  put dd_xs 6 100
  put dd_xs 7 4294967295
  put dd_xs 8 18446744073709551615
  put dd_xs 9 9223372036854775808
  put dd_px 0 0
  put dd_px 1 1
  put dd_px 2 2
  put dd_px 3 5
  put dd_px 4 10
  put dd_px 5 50
  put dd_px 6 100
  put dd_px 7 255
  put dd_px 8 256
  put dd_px 9 65535
  put dd_px 10 4294967295
  put dd_px 11 18446744073709551615
  og_reset
  put rd_cur 0 -1
  ob_reset 65535
  total = ulong 0
  while lt total 4194304 bound 100000
    r = read 0 rd_in total sub 4194304 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  ln = ulong 0
  p = ulong 0
  while lt p total bound 4194305
    if eq get rd_in p 10
      ln = add ln 1
      if gt p start
        c = get rd_in start
        if ne c 35
          rd_line ln start p
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  if lt add u1 u2 -999
    ret 2
  end
  ret 0
end

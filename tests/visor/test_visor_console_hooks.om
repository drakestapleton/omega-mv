note SPDX-License-Identifier: Apache-2.0
note Stub ops of tests/visor/test_visor_console.c (stub_eval, stub_classify,
note stub_run, stub_cost, stub_effects, stub_verify). tst_ops is the set of
note installed hooks (bit hid), the C VisorConsoleOps fields that are non-NULL.

text tst_t_bad "bad"
text tst_t_let "let "
text tst_t_perr "parse error at 1:1"
text tst_t_18 "18"
text tst_t_x "x"
text tst_t_noeff "no effects"
text tst_t_wfile "writes a file"
text tst_t_jv18 "{\"value\":\"18\"}"
text tst_t_v18 "18\n"
text tst_t_noest "no \"estimate\""
text tst_t_jarr "[]"
text tst_t_noeffs "no effects\n"
text tst_t_jpf "{\"passed\":false}"
text tst_t_v0 "V0 FAIL\n"
text tst_t_vf "verification failed: V0"

global tst_ops ulong 1
global tst_run_calls ulong 1

note fake_id: byte i = seed + i, into v_tmp_id.
fn tst_fake_id seed ulong to void
  for i ulong 32
    put v_tmp_id i uchar add seed i
  end
end

fn tst_install_stubs to void
  note bits EVAL 4, VERIFY 5, COST 8, RUN 9, CLASSIFY 12, EFFECTS 13
  m = ulong 13104
  put tst_ops 0 m
end

fn tst_line_is s view uchar * to bool
  sl = len s
  if ne get vpc_llen 0 sl
    ret false
  end
  for i ulong sl bound 64
    if ne get vpc_line i get s i
      ret false
    end
  end
  ret true
end

fn tst_eval to long
  if tst_line_is tst_t_bad
    ve_puts tst_t_perr
    ret 1
  end
  islet = false
  if ge get vpc_llen 0 4
    islet = true
    for i ulong 4
      if ne get vpc_line i get tst_t_let i
        islet = false
      end
    end
  end
  tst_fake_id 51
  if islet
    put v_sbuf 0 uchar 120
    u = vs_bind_set_sbuf 1 V_BIND_OBJECT -1
    if lt u -1
      ret 1
    end
  end
  put vcall_ev_kind 0 V_BIND_OBJECT
  put vcall_ev_idx 0 -1
  for i ulong 32
    put vcall_ev_id i get v_tmp_id i
  end
  vv_puts tst_t_18
  ret 0
end

fn tst_classify to long
  if vcall_arg_is 0 tst_t_x
    put vcall_cls 0 VCON_CL_PURE
    vr_puts tst_t_noeff
  else
    put vcall_cls 0 VCON_CL_EFF
    vr_puts tst_t_wfile
  end
  ret 0
end

fn tst_run to long
  put tst_run_calls 0 add get tst_run_calls 0 1
  if ne get vcall_json 0 0
    vb_puts tst_t_jv18
  else
    vb_puts tst_t_v18
  end
  ret 0
end

fn tst_cost to long
  ve_puts tst_t_noest
  ret 1
end

fn tst_effects to long
  if ne get vcall_json 0 0
    vb_puts tst_t_jarr
  else
    vb_puts tst_t_noeffs
  end
  ret 0
end

fn tst_verify to long
  if ne get vcall_json 0 0
    vb_puts tst_t_jpf
  else
    vb_puts tst_t_v0
  end
  ve_puts tst_t_vf
  ret 2
end

fn tst_wired hid ulong to bool
  ret ne and shr get tst_ops 0 hid ulong 1 0
end

fn tst_call hid ulong to long
  if eq hid VCON_HK_RUN
    ret tst_run
  end
  if eq hid VCON_HK_COST
    ret tst_cost
  end
  if eq hid VCON_HK_EFFECTS
    ret tst_effects
  end
  if eq hid VCON_HK_VERIFY
    ret tst_verify
  end
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note sem_dump.om -- the pure OM-2 side of tests/visor/sem_parity.sh. Reads the corpus of
note one-letter graph and query commands on stdin, builds the graph with the OM-2 OmegaGraph
note store (visor.om) and prints, line for line, what the retired C reference dumper printed
note from visor_semantic_inspect, _format_text, _format_json, _type_of, _apply_parts,
note _value_u64, _eval_u64, _graph_text and the name helpers (the goldens in
note tests/visor/sem_golden), here from the shipped src/visor/visor_semantic.om.
note Graph commands: R reset | O k object | L n payload_len | B o v byte | E o nb v big-endian
note | W o nb v little-endian | F o j id of object j | X o v 32 bytes v | T k j relation to
note object j | Y k v relation to 32 x v | I compute id | K b.. attribute key | V b.. append to
note the value buffer | G n s d append n bytes s+i*d | A add attribute | Q k add constraint |
note P f i v poke a count or length (0 attr_count, 1 rel_count, 2 const_count, 3 attr i
note val_len, 4 constraint i payload_len, 5 has_id).
note Queries (t < 1000 the id of object t, else 32 bytes (t-1000)): S t inspect and format |
note U t type_of | H t apply_parts | Z t value_u64 | J t eval_u64 | M t n graph_text in n
note bytes (0: 65536) | C w x name w (0 opcode 1 overflow 2 relation 3 constraint 4 shape).
note Built after the shipped OMEGA_OM_SRCS modules up to visor_semantic.om.

global smd_in uchar 8388608
global smd_ob uchar 65536
global smd_on ulong 1
global smd_d uchar 24
global smd_a ulong 64
global smd_na ulong 1
global smd_cur long 1
global smd_key uchar 64
global smd_kl ulong 1
global smd_val uchar 1024
global smd_vl ulong 1

fn smd_flush to void
  n = get smd_on 0
  if gt n 0
    k = write 1 smd_ob 0 n
  end
  put smd_on 0 0
end

fn smd_c c ulong to void
  n = get smd_on 0
  if ge n 65000
    smd_flush
    n = 0
  end
  put smd_ob n uchar c
  put smd_on 0 add n 1
end

fn smd_t s view uchar * to void
  n = len s
  for i ulong n bound 4096
    smd_c ulong get s i
  end
end

fn smd_u v ulong to void
  k = ulong 0
  x = v
  while gt x 9 bound 24
    put smd_d k uchar add 48 rem x 10
    x = div x 10
    k = add k 1
  end
  put smd_d k uchar add 48 x
  k = add k 1
  while gt k 0 bound 24
    k = sub k 1
    smd_c ulong get smd_d k
  end
end

fn smd_i v long to void
  if lt v 0
    smd_c 45
    smd_u ulong sub 0 v
  else
    smd_u ulong v
  end
end

fn smd_hb b ulong to void
  h = shr b 4
  l = and b 15
  if lt h 10
    smd_c add 48 h
  else
    smd_c add 87 h
  end
  if lt l 10
    smd_c add 48 l
  else
    smd_c add 87 l
  end
end

text smd_t_ofull " O full\n"
text smd_t_tfull " T full\n"
text smd_t_afull " A full\n"
text smd_t_qfull " Q full\n"
text smd_t_irc " I rc=-1\n"
text smd_t_s " S "
text smd_t_u " U "
text smd_t_h " H "
text smd_t_z " Z "
text smd_t_j " J "
text smd_t_m " M "
text smd_t_cn " C "
text smd_t_rc " rc="
text smd_t_tt " T="
text smd_t_jj " J="
text smd_t_bb " B="
text smd_t_id " id="
text smd_t_text " text="
text smd_t_op " op="
text smd_t_n " n="
text smd_t_v " v="
text smd_t_q " ? "

fn smd_ln ln ulong to void
  smd_c 76
  smd_u ln
end

fn smd_vob n long to void
  for i ulong ulong n bound 65536
    smd_c ulong get v_ob i
  end
end

fn smd_hex_rtid to void
  for i ulong 32
    smd_hb ulong get vsem_rtid i
  end
end

fn smd_hex_apop to void
  for i ulong 32
    smd_hb ulong get vsem_ap_op i
  end
end

fn smd_hex_apops off ulong to void
  for i ulong 32
    smd_hb ulong get vsem_ap_ops add off i
  end
end

fn smd_pay_off off ulong to ulong
  ret add mul ulong get smd_cur 0 V_MAX_PAYLOAD off
end

fn smd_parse s ulong e ulong to void
  for i ulong 64
    put smd_a i 0
  end
  put smd_na 0 0
  p = add s 1
  for i ulong 64
    while and lt p e eq get smd_in p 32 bound 16384
      p = add p 1
    end
    if ge p e
      break
    end
    d = ulong get smd_in p
    if or lt d 48 gt d 57
      break
    end
    v = ulong 0
    while lt p e bound 16384
      d = ulong get smd_in p
      if or lt d 48 gt d 57
        break
      end
      v = add mul v 10 sub d 48
      p = add p 1
    end
    put smd_a i v
    put smd_na 0 add i 1
  end
end

fn smd_arg i ulong to ulong
  ret get smd_a i
end

fn smd_field msb bool to void
  off = smd_arg 0
  nb = smd_arg 1
  v = smd_arg 2
  for i ulong nb bound 8
    sh = mul 8 i
    if msb
      sh = mul 8 sub sub nb 1 i
    end
    put v_og_pay smd_pay_off add off i uchar and shr v sh 255
  end
end

fn smd_ids c ulong to void
  off = smd_arg 0
  if eq c 70
    jb = mul smd_arg 1 32
    for i ulong 32
      put v_og_pay smd_pay_off add off i get v_og_id add jb i
    end
    ret
  end
  for i ulong 32
    put v_og_pay smd_pay_off add off i uchar and smd_arg 1 255
  end
end

fn smd_rel ln ulong c ulong to void
  cur = ulong get smd_cur 0
  r = long 0
  if eq c 84
    r = og_add_rel cur smd_arg 0 smd_arg 1
  else
    for i ulong 32
      put v_tmp_id i uchar and smd_arg 1 255
    end
    r = og_add_rel_tmp cur smd_arg 0
  end
  if lt r 0
    smd_ln ln
    smd_t smd_t_tfull
  end
end

note omega_object_add_attribute: refused when the object holds 32, or the value is longer
note than 512 bytes (the key is at most 63 bytes here).
fn smd_attr ln ulong to void
  idx = ulong get smd_cur 0
  ac = get v_og_acnt idx
  vl = get smd_vl 0
  put smd_vl 0 0
  if or ge ac V_MAX_ATTRS gt vl 512
    smd_ln ln
    smd_t smd_t_afull
    ret
  end
  slot = og_aslot idx ac
  kl = get smd_kl 0
  put v_og_aklen slot kl
  kb = mul slot 64
  for i ulong kl bound 64
    put v_og_akey add kb i get smd_key i
  end
  put v_og_avlen slot vl
  vb = mul slot 512
  for i ulong vl bound 512
    put v_og_aval add vb i get smd_val i
  end
  put v_og_acnt idx add ac 1
end

fn smd_const ln ulong to void
  idx = ulong get smd_cur 0
  vl = get smd_vl 0
  put smd_vl 0 0
  for i ulong vl bound 1024
    put v_sbuf i get smd_val i
  end
  if lt og_add_const_sbuf idx smd_arg 0 vl 0
    smd_ln ln
    smd_t smd_t_qfull
  end
end

fn smd_poke to void
  idx = ulong get smd_cur 0
  f = smd_arg 0
  i = smd_arg 1
  v = smd_arg 2
  if eq f 0
    put v_og_acnt idx v
  end
  if eq f 1
    put v_og_rcnt idx v
  end
  if eq f 2
    put v_og_ccnt idx v
  end
  if eq f 3
    put v_og_avlen og_aslot idx i v
  end
  if eq f 4
    put v_og_clen og_cslot idx i v
  end
  if eq f 5
    if ne v 0
      put v_og_has_id idx 1
    else
      put v_og_has_id idx 0
    end
  end
end

fn smd_vbytes c ulong to void
  vl = get smd_vl 0
  if eq c 86
    n = get smd_na 0
    for i ulong n bound 64
      if lt vl 1024
        put smd_val vl uchar and smd_arg i 255
        vl = add vl 1
      end
    end
  else
    n = smd_arg 0
    s = smd_arg 1
    d = smd_arg 2
    for i ulong n bound 1024
      if lt vl 1024
        put smd_val vl uchar and add s mul i d 255
        vl = add vl 1
      end
    end
  end
  put smd_vl 0 vl
end

fn smd_keyset to void
  n = get smd_na 0
  if gt n 63
    n = 63
  end
  for i ulong n bound 64
    put smd_key i uchar and smd_arg i 255
  end
  put smd_kl 0 n
end

text smd_t_curcmds "LBEWFXTYIAQP"

fn smd_is_cur_cmd c ulong to bool
  for i ulong 12
    if eq c ulong get smd_t_curcmds i
      ret true
    end
  end
  ret false
end

fn smd_graph ln ulong c ulong to bool
  if eq c 82
    og_reset
    put smd_cur 0 -1
    put smd_vl 0 0
    put smd_kl 0 0
    ret true
  end
  if eq c 79
    r = og_add_object smd_arg 0
    if lt r 0
      smd_ln ln
      smd_t smd_t_ofull
    else
      put smd_cur 0 r
    end
    ret true
  end
  if eq c 75
    smd_keyset
    ret true
  end
  if or eq c 86 eq c 71
    smd_vbytes c
    ret true
  end
  if not smd_is_cur_cmd c
    ret false
  end
  if lt get smd_cur 0 0
    if or eq c 65 eq c 81
      put smd_vl 0 0
    end
    ret true
  end
  if eq c 76
    put v_og_plen ulong get smd_cur 0 smd_arg 0
  end
  if eq c 66
    put v_og_pay smd_pay_off smd_arg 0 uchar and smd_arg 1 255
  end
  if eq c 69
    smd_field true
  end
  if eq c 87
    smd_field false
  end
  if or eq c 70 eq c 88
    smd_ids c
  end
  if or eq c 84 eq c 89
    smd_rel ln c
  end
  if eq c 73
    if lt og_compute_id ulong get smd_cur 0 0
      smd_ln ln
      smd_t smd_t_irc
    end
  end
  if eq c 65
    smd_attr ln
  end
  if eq c 81
    smd_const ln
  end
  if eq c 80
    smd_poke
  end
  ret true
end

note v_tmp_id := the id of object t (t < 1000) or 32 bytes (t - 1000).
fn smd_target t ulong to void
  if lt t 1000
    og_tmp_from_obj t
    ret
  end
  for i ulong 32
    put v_tmp_id i uchar and sub t 1000 255
  end
end

fn smd_head ln ulong w view uchar * t ulong rc long to void
  smd_ln ln
  smd_t w
  smd_u t
  smd_t smd_t_rc
  smd_i rc
end

fn smd_show_s ln ulong to void
  t = smd_arg 0
  smd_target t
  rc = vsem_inspect_tmp
  smd_head ln smd_t_s t rc
  smd_c 10
  if eq rc -1
    ret
  end
  tl = vsem_format_text 65536
  if ge tl 0
    smd_vob tl
  end
  jl = vsem_format_json 65536
  if ge jl 0
    smd_vob jl
    smd_c 10
  end
  smd_ln ln
  smd_t smd_t_tt
  smd_i tl
  smd_t smd_t_jj
  smd_i jl
  if and ge tl 0 ge jl 0
    smd_t smd_t_bb
    smd_i vsem_format_text 0
    smd_c 32
    smd_i vsem_format_json 0
    smd_c 32
    smd_i vsem_format_text ulong tl
    smd_c 32
    smd_i vsem_format_text add ulong tl 1
    smd_c 32
    smd_i vsem_format_json ulong jl
    smd_c 32
    smd_i vsem_format_json add ulong jl 1
    smd_c 32
    smd_i vsem_format_text 1
  end
  smd_c 10
end

fn smd_show_u ln ulong to void
  t = smd_arg 0
  smd_target t
  rc = vsem_type_of_tmp
  smd_head ln smd_t_u t rc
  if eq rc 0
    smd_t smd_t_id
    smd_hex_rtid
    smd_t smd_t_text
    ob_reset 4096
    vsem_put_tr 40
    smd_vob long get v_ob_len 0
  end
  smd_c 10
end

fn smd_show_h ln ulong to void
  t = smd_arg 0
  smd_target t
  rc = vsem_apply_parts_tmp
  smd_head ln smd_t_h t rc
  if eq rc 0
    smd_t smd_t_op
    smd_hex_apop
    n = get vsem_ap_cnt 0
    smd_t smd_t_n
    smd_u n
    for i ulong n bound 4
      smd_c 32
      smd_hex_apops mul i 32
    end
  end
  smd_c 10
end

fn smd_show_zj ln ulong c ulong to void
  t = smd_arg 0
  smd_target t
  rc = long 0
  if eq c 90
    rc = vsem_value_u64_tmp
    smd_head ln smd_t_z t rc
  else
    rc = vsem_eval_u64_tmp
    smd_head ln smd_t_j t rc
  end
  if eq rc 0
    smd_t smd_t_v
    smd_u get vsem_val 0
  end
  smd_c 10
end

fn smd_show_m ln ulong to void
  t = smd_arg 0
  n = smd_arg 1
  m = n
  if eq m 0
    m = 65536
  end
  smd_target t
  rc = vsem_graph_text_tmp m
  smd_ln ln
  smd_t smd_t_m
  smd_u t
  smd_c 32
  smd_u n
  smd_t smd_t_rc
  smd_i rc
  smd_c 10
  if ge rc 0
    smd_vob rc
  end
end

fn smd_show_c ln ulong to void
  w = smd_arg 0
  x = and smd_arg 1 0xffffffff
  smd_ln ln
  smd_t smd_t_cn
  smd_u w
  smd_c 32
  smd_u x
  smd_c 32
  ob_reset 4096
  if eq w 0
    vsem_put_opcode x
  end
  if eq w 1
    vsem_put_overflow x
  end
  if eq w 2
    vsem_put_relation x
  end
  if eq w 3
    vsem_put_constraint x
  end
  if eq w 4
    vsem_put_shape x
  end
  if gt w 4
    ob_putc uchar 63
  end
  smd_vob long get v_ob_len 0
  smd_c 10
end

fn smd_line ln ulong s ulong e ulong to void
  c = ulong get smd_in s
  smd_parse s e
  if smd_graph ln c
    ret
  end
  if eq c 83
    smd_show_s ln
    ret
  end
  if eq c 85
    smd_show_u ln
    ret
  end
  if eq c 72
    smd_show_h ln
    ret
  end
  if or eq c 90 eq c 74
    smd_show_zj ln c
    ret
  end
  if eq c 77
    smd_show_m ln
    ret
  end
  if eq c 67
    smd_show_c ln
    ret
  end
  smd_ln ln
  smd_t smd_t_q
  smd_c c
  smd_c 10
end

fn main to int
  og_reset
  put smd_cur 0 -1
  total = ulong 0
  while lt total 8388608 bound 100000
    r = read 0 smd_in total sub 8388608 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  ln = ulong 0
  p = ulong 0
  while lt p total bound 8388609
    if eq get smd_in p 10
      ln = add ln 1
      if gt p start
        c = get smd_in start
        if ne c 35
          smd_line ln start p
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  smd_flush
  ret 0
end

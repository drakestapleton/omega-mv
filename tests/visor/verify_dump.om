note SPDX-License-Identifier: Apache-2.0
note verify_dump.om -- the pure OM-2 side of tests/visor/verify_parity.sh. Built after the shipped
note verify modules (mk/visor-verify.mk VISOR_VERIFY_OM_SRCS) and the graph and realization helpers
note of tests/visor/test_visor_verify.om (its fn main removed). Reads the corpus commands on stdin
note and prints, line for line, what the retired C reference dumper printed from
note visor_verify_object, visor_verify_program, visor_verify_format_text/_json and
note omega_exec_native_f3 (the goldens in tests/visor/verify_golden). Commands:
note   S hand scenario | G op graph | O f v field | Q i query | P realize op into slot 0 |
note   K machine | W n w... slot 4 code | V s m verify | X a b c V0 then run slot 4

text vd_eq "== "
text vd_rc " rc="
text vd_xt " t="
text vd_xj " j="
text vd_json "--json\n"
text vd_tn "tn: "
text vd_jn "jn: "
text vd_x "x"

text vd_n1 "apply-none"
text vd_n2 "type-none"
text vd_n3 "value-none"
text vd_n4 "op-none"
text vd_n5 "apply-real-mg"
text vd_n6 "op-real-mg"
text vd_n7 "apply-real"
text vd_n8 "apply-bad-mg"
text vd_n9 "apply-real-mg2"
text vd_n10 "value-real"
text vd_n11 "apply-bound-mg"
text vd_n12 "apply-bound-other"
text vd_n13 "apply-bound-nomg"
text vd_n14 "v0-profile"
text vd_n15 "v0-bounds"
text vd_n16 "v0-bounds-big"
text vd_n17 "v0-decode"
text vd_n18 "v0-noret"
text vd_n19 "v0-noid"
text vd_n20 "v0-empty"
text vd_n21 "missing"
text vd_n22 "null-graph"
text vd_n23 "lie-"
text vd_n24 "sub-real"
text vd_n25 "sub-bad"
text vd_n26 "sub-lie"
text vd_n27 "mul-real"
text vd_n28 "dangling"
text vd_n29 "relkind"
text vd_n30 "selfcycle"
text vd_n31 "cycle"
text vd_n32 "vbytes"
text vd_n33 "uwidth"
text vd_n34 "ovf"
text vd_n35 "opcode"
text vd_n36 "attrkey"
text vd_n37 "fadd"
text vd_n38 "fadd-mg"
text vd_n39 "fadd-lie"
text vd_n40 "effect"
text vd_n41 "effect-cap"
text vd_n42 "effect-bad"
text vd_n43 "fadd-after-badeff"
text vd_n44 "prog"
text vd_n45 "prog-unreal"
text vd_n46 "prog-corrupt"
text vd_n47 "prog-nopost"
text vd_n48 "prog-0w"
text vd_n49 "prog-null"
text vd_n50 "prog-mul"
text vd_n51 "empty"
text vd_n52 "value-bound"
text vd_nv "V"
text vd_vskip "V skip\n"
text vd_g "G "
text vd_p "P "
text vd_xv0 "X v0\n"
text vd_xx "X "

global vd_out uchar 65536
global vd_ol ulong 1
global vd_lw ulong 39
global vd_ln ulong 12
global vd_in ulong 30

fn vd_c c ulong to void
  p = get vd_ol 0
  if lt p 65536
    put vd_out p uchar c
    put vd_ol 0 add p 1
  end
end

fn vd_t s view uchar * to void
  n = len s
  for i ulong n bound 256
    vd_c ulong get s i
  end
end

fn vd_u v ulong to void
  nb = new uchar 24 0
  x = v
  nd = ulong 0
  while lt nd 21 bound 24
    put nb nd uchar add 48 rem x 10
    nd = add nd 1
    x = div x 10
    if eq x 0
      break
    end
  end
  while gt nd 0 bound 24
    nd = sub nd 1
    vd_c ulong get nb nd
  end
end

fn vd_d v long to void
  if lt v 0
    vd_c 45
    vd_u ulong sub 0 v
    ret
  end
  vd_u ulong v
end

fn vd_flush to void
  n = get vd_ol 0
  off = ulong 0
  while lt off n bound 65536
    k = write 1 vd_out off sub n off
    if le k 0
      ret
    end
    off = add off ulong k
  end
  put vd_ol 0 0
end

fn vd_ob to void
  n = get v_ob_len 0
  for i ulong n bound 65536
    vd_c ulong get v_ob i
  end
end

fn vd_sizes is_json ulong full long to void
  if eq is_json 0
    vd_t vd_tn
  else
    vd_t vd_jn
  end
  f = ulong full
  for k ulong 4
    n = f
    if eq k 1
      n = add f 1
    end
    if eq k 2
      n = 1
    end
    if eq k 3
      n = 0
    end
    r = long 0
    if eq is_json 0
      r = vver_format_text n
    else
      r = vver_format_json n
    end
    if gt k 0
      vd_c 32
    end
    vd_d r
  end
  vd_c 10
end

fn vd_show name view uchar * num long rc long to void
  t = vver_format_text 8192
  tvv_save
  j = vver_format_json 8192
  vd_t vd_eq
  vd_t name
  if ge num 0
    vd_u ulong num
  end
  vd_t vd_rc
  vd_d rc
  vd_t vd_xt
  vd_d t
  vd_t vd_xj
  vd_d j
  vd_c 10
  if gt t 0
    tl = get tvv_al 0
    for i ulong tl bound 8192
      vd_c ulong get tvv_a i
    end
  end
  vd_t vd_json
  if gt j 0
    vd_ob
  end
  vd_c 10
  if gt t 0
    vd_sizes 0 t
  end
  if gt j 0
    vd_sizes 1 j
  end
  vd_flush
end

fn vd_s name view uchar * rc long to void
  vd_show name -1 rc
end

fn vd_q idx ulong to void
  tvv_qid_obj idx
end

fn vd_words s ulong sem ulong w0 ulong w1 ulong w2 ulong to void
  tvv_slot_clear s
  tvv_sem_from_obj s sem
  put vver_rprof s 1
  u = tvv_emit s long w0
  if ne w1 0
    u = tvv_emit s long w1
  end
  if ne w2 0
    u = tvv_emit s long w2
  end
  u2 = vver_real_set_id s
  if lt add u u2 -999
    trap 7
  end
end

fn vd_lies_init to void
  r = ulong 3596551104
  put vd_lw 0 0x8b010c00
  put vd_lw 1 r
  put vd_lw 3 0x0b010000
  put vd_lw 4 r
  put vd_lw 6 0xcb800820
  put vd_lw 7 r
  put vd_lw 9 0x9b017c00
  put vd_lw 10 r
  put vd_lw 12 0x9b01fc00
  put vd_lw 13 r
  put vd_lw 15 0xaac11400
  put vd_lw 16 r
  put vd_lw 18 0xca010000
  put vd_lw 19 r
  put vd_lw 21 0x0a411000
  put vd_lw 22 r
  put vd_lw 24 0xd2a000a0
  put vd_lw 25 0xf28000e0
  put vd_lw 26 r
  put vd_lw 27 0x8b020000
  put vd_lw 28 r
  put vd_lw 30 0xcb410400
  put vd_lw 31 r
  put vd_lw 33 0x8b81fc00
  put vd_lw 34 r
  put vd_lw 36 0xd29fffe0
  put vd_lw 37 0xf2800020
  put vd_lw 38 r
  m = ulong 18446744073709551615
  put vd_in 3 1
  put vd_in 4 2
  put vd_in 5 3
  put vd_in 6 7
  put vd_in 7 11
  put vd_in 8 3
  put vd_in 9 m
  put vd_in 10 1
  put vd_in 12 0x8000000000000000
  put vd_in 13 5
  put vd_in 14 9
  put vd_in 15 0x123456789abcdef0
  put vd_in 16 0xfedcba9876543210
  put vd_in 17 1
  put vd_in 18 0xffffffff
  put vd_in 19 0x100000001
  put vd_in 20 2
  put vd_in 21 5
  put vd_in 22 m
  put vd_in 23 7
  put vd_in 24 0x7fffffffffffffff
  put vd_in 25 0x8000000000000001
  put vd_in 26 3
  put vd_in 27 42
  put vd_in 28 42
  put vd_in 29 42
end

fn vd_lie i ulong to void
  b = mul i 3
  w0 = get vd_lw b
  w1 = get vd_lw add b 1
  w2 = get vd_lw add b 2
  vd_words 4 get tvv_x 3 w0 w1 w2
end

fn vd_part1 to void
  u = tvv_build_add V_OP_ADD
  vd_q get tvv_x 4
  vd_s vd_n1 vver_verify_object 1 -1 -1
  vd_q get tvv_x 0
  vd_s vd_n2 vver_verify_object 1 -1 -1
  vd_q get tvv_x 1
  vd_s vd_n3 vver_verify_object 1 -1 -1
  vd_q get tvv_x 3
  vd_s vd_n4 vver_verify_object 1 -1 -1
  u2 = tvv_realize_pure 0 get tvv_x 3
  u3 = vmch_build_spark 0
  vd_q get tvv_x 4
  vd_s vd_n5 vver_verify_object 1 0 0
  vd_q get tvv_x 3
  vd_s vd_n6 vver_verify_object 1 0 0
  vd_q get tvv_x 4
  vd_s vd_n7 vver_verify_object 1 0 -1
  tvv_slot_copy 1 0
  tvv_flip0 1
  vd_s vd_n8 vver_verify_object 1 1 0
  vmch_graph_copy 1 0
  vmch_gset 1 VMCH_K_PROF 2
  vd_s vd_n9 vver_verify_object 1 0 1
  vd_q get tvv_x 1
  vd_s vd_n10 vver_verify_object 1 0 -1
  if lt add add u u2 u3 -999
    trap 7
  end
end

fn vd_bound to void
  tvv_slot_copy 2 0
  for i ulong 32
    put vver_rmid add 64 i get vmch_gid i
  end
  put vver_rhm 2 1
  vver_rid_triple 2
  for i ulong 32
    put vver_rrid add 64 i get v_sha_out i
  end
  vd_q get tvv_x 4
  vd_s vd_n11 vver_verify_object 1 2 0
  put vver_rmid 67 uchar xor ulong get vver_rmid 67 64
  vver_rid_triple 2
  for i ulong 32
    put vver_rrid add 64 i get v_sha_out i
  end
  vd_s vd_n12 vver_verify_object 1 2 0
  vd_s vd_n13 vver_verify_object 1 2 -1
end

fn vd_v0 to void
  vd_q get tvv_x 4
  tvv_slot_copy 2 0
  put vver_rprof 2 2
  u = vver_real_set_id 2
  vd_s vd_n14 vver_verify_object 1 2 0
  tvv_slot_copy 2 0
  put vver_rclen 2 6
  u2 = vver_real_set_id 2
  vd_s vd_n15 vver_verify_object 1 2 -1
  tvv_slot_copy 2 0
  put vver_rclen 2 4100
  vd_s vd_n16 vver_verify_object 1 2 -1
  vd_words 2 get tvv_x 3 0 3596551104 0
  vd_s vd_n17 vver_verify_object 1 2 -1
  vd_words 2 get tvv_x 3 0x8b010000 0 0
  vd_s vd_n18 vver_verify_object 1 2 -1
  tvv_slot_copy 2 0
  put vver_rhid 2 0
  vd_s vd_n19 vver_verify_object 1 2 -1
  tvv_slot_copy 2 0
  put vver_rclen 2 0
  u3 = vver_real_set_id 2
  vd_s vd_n20 vver_verify_object 1 2 -1
  for i ulong 32
    put vver_qid i uchar 171
  end
  vd_s vd_n21 vver_verify_object 1 -1 -1
  vd_q get tvv_x 4
  vd_s vd_n22 vver_verify_object 0 -1 -1
  for i ulong 13
    vd_lie i
    vd_show vd_n23 long i vver_verify_object 1 4 0
  end
  if lt add add u u2 u3 -999
    trap 7
  end
end

fn vd_subs to void
  u = tvv_build_add V_OP_SUB
  u2 = tvv_realize_pure 2 get tvv_x 3
  vd_q get tvv_x 4
  vd_s vd_n24 vver_verify_object 1 2 -1
  tvv_slot_copy 3 2
  tvv_flip0 3
  vd_s vd_n25 vver_verify_object 1 3 -1
  u3 = tvv_build_add V_OP_ADD
  tvv_slot_copy 4 2
  tvv_sem_from_obj 4 get tvv_x 3
  u4 = vver_real_set_id 4
  vd_q get tvv_x 4
  vd_s vd_n26 vver_verify_object 1 4 -1
  u5 = tvv_build_add V_OP_MUL
  u6 = tvv_realize_pure 2 get tvv_x 3
  vd_q get tvv_x 4
  vd_s vd_n27 vver_verify_object 1 2 0
  if lt add add add add add u u2 u3 u4 u5 u6 -999
    trap 7
  end
end

fn vd_faults to void
  u = tvv_build_add V_OP_ADD
  ap = get tvv_x 4
  rs = og_rslot ap 0
  put v_og_rkind rs V_REL_DEPENDS_ON
  for i ulong 32
    put v_og_rtgt add mul rs 32 i uchar 205
  end
  put v_og_rcnt ap 1
  vd_q ap
  vd_s vd_n28 vver_verify_object 1 -1 -1
  put v_og_rkind rs 0
  vd_s vd_n29 vver_verify_object 1 -1 -1
  put v_og_rkind rs V_REL_DEPENDS_ON
  for i ulong 32
    put v_og_rtgt add mul rs 32 i get v_og_id add mul ap 32 i
  end
  vd_s vd_n30 vver_verify_object 1 -1 -1
  put v_og_rcnt ap 0
  if lt u -999
    trap 7
  end
end

fn vd_faults2 to void
  ap = get tvv_x 4
  a = get tvv_x 1
  ra = og_rslot a 0
  put v_og_rkind ra V_REL_DERIVED_FROM
  rb = mul ra 32
  ib = mul ap 32
  for i ulong 32
    put v_og_rtgt add rb i get v_og_id add ib i
  end
  put v_og_rcnt a 1
  vd_s vd_n31 vver_verify_object 1 -1 -1
  put v_og_rcnt a 0
  v_enc_u16le_pay mul a V_MAX_PAYLOAD 32 3
  vd_q a
  vd_s vd_n32 vver_verify_object 1 -1 -1
  v_enc_u16le_pay mul a V_MAX_PAYLOAD 32 8
  t = get tvv_x 0
  v_enc_u16le_pay mul t V_MAX_PAYLOAD 4 0
  vd_q t
  vd_s vd_n33 vver_verify_object 1 -1 -1
  v_enc_u16le_pay mul t V_MAX_PAYLOAD 4 64
  op = get tvv_x 3
  v_enc_u32le_pay mul op V_MAX_PAYLOAD 4 0
  vd_q ap
  vd_s vd_n34 vver_verify_object 1 -1 -1
  v_enc_u32le_pay mul op V_MAX_PAYLOAD 4 V_OVF_WRAP
  v_enc_u32le_pay mul op V_MAX_PAYLOAD 0 0x33
  vd_q op
  vd_s vd_n35 vver_verify_object 1 -1 -1
  v_enc_u32le_pay mul op V_MAX_PAYLOAD 0 V_OP_ADD
  ac = get v_og_acnt a
  put v_og_aklen og_aslot a ac 0
  put v_og_acnt a add ac 1
  vd_q a
  vd_s vd_n36 vver_verify_object 1 -1 -1
end

fn vd_fadd to void
  og_reset
  root = tvv_build_f_add_sub
  if lt root 0
    trap 7
  end
  ru = ulong root
  u = tvv_realize_f_add_sub 5 ru
  vd_q ru
  vd_s vd_n37 vver_verify_object 1 5 -1
  vd_s vd_n38 vver_verify_object 1 5 0
  vd_words 2 ru 0x8b010000 3596551104 0
  vd_s vd_n39 vver_verify_object 1 2 -1
  e = og_build_effect 1 1 3 1
  vd_q ulong e
  vd_s vd_n40 vver_verify_object 1 -1 -1
  if lt add u e -999
    trap 7
  end
end

fn vd_fadd2 ru ulong to void
  c = og_build_type_cap_ref
  e2 = og_build_effect 2 5 7 9
  eb = mul ulong e2 V_MAX_PAYLOAD
  cb = mul ulong c 32
  for i ulong 32
    put v_og_pay add eb add 16 i get v_og_id add cb i
  end
  u2 = og_compute_id ulong e2
  vd_q ulong e2
  vd_s vd_n41 vver_verify_object 1 -1 -1
  e3 = og_build_effect 1 1 3 1
  e3b = mul ulong e3 V_MAX_PAYLOAD
  put v_og_pay e3b uchar 0
  put v_og_pay add e3b 1 uchar 0
  u3 = og_compute_id ulong e3
  vd_q ulong e3
  vd_s vd_n42 vver_verify_object 1 -1 -1
  vd_q ru
  vd_s vd_n43 vver_verify_object 1 5 -1
  if lt add u2 u3 -999
    trap 7
  end
end

fn vd_prog to void
  u = tvv_build_unary 6 V_OP_ADD 5
  vd_s vd_n44 vver_verify_program 1
  put vver_p_real 0 0
  vd_s vd_n45 vver_verify_program 1
  put vver_p_real 0 1
  tvv_slot_copy 7 6
  tvv_flip0 7
  put vver_p_slot 0 7
  vd_s vd_n46 vver_verify_program 1
  put vver_p_slot 0 6
  sv = new uchar 32 0
  for i ulong 32
    put sv i get vver_p_post i
    put vver_p_post i uchar 0
  end
  vd_s vd_n47 vver_verify_program 1
  for i ulong 32
    put vver_p_post i get sv i
  end
  put vver_p_iw 0 0
  vd_s vd_n48 vver_verify_program 1
  put vver_p_iw 0 64
  vd_s vd_n49 vver_verify_program 0
  u2 = tvv_build_unary 6 V_OP_MUL 0x12345678
  vd_s vd_n50 vver_verify_program 1
  u3 = tvv_build_add V_OP_ADD
  vd_q get tvv_x 4
  og_reset
  vd_s vd_n51 vver_verify_object 1 -1 -1
  if lt add add u u2 u3 -999
    trap 7
  end
end

fn vd_matrix to void
  u = tvv_build_add V_OP_ADD
  for i ulong 13
    vd_lie i
    vd_t vd_x
    vd_u i
    vd_c 58
    for k ulong 10
      a = get vd_in mul k 3
      b = get vd_in add mul k 3 1
      c = get vd_in add mul k 3 2
      put vver_xout 0 0
      er = vver_exec 4 a b c
      vd_c 32
      vd_d er
      vd_c 47
      vd_u get vver_xout 0
    end
    vd_c 10
    vd_flush
  end
  if lt u -999
    trap 7
  end
end

fn vd_vbound to void
  u = tvv_build_add V_OP_ADD
  u2 = tvv_realize_pure 2 get tvv_x 3
  tvv_sem_from_obj 2 get tvv_x 1
  u3 = vver_real_set_id 2
  vd_q get tvv_x 1
  vd_s vd_n52 vver_verify_object 1 2 -1
  if lt add add u u2 u3 -999
    trap 7
  end
end

fn vd_hand to void
  vd_lies_init
  vd_part1
  vd_bound
  vd_v0
  vd_subs
  vd_faults
  vd_faults2
  vd_fadd
  vd_fadd2 7
  vd_prog
  vd_matrix
  vd_vbound
  vd_flush
end

global vd_inb uchar 4194304
global vd_a ulong 24
global vd_ng ulong 24
global vd_na ulong 1
global vd_s0 ulong 1

note parse the numbers after the command letter of line [s, e): decimal, 0x hex, leading -
fn vd_parse s ulong e ulong to void
  put vd_na 0 0
  p = add s 1
  while lt p e bound 1024
    while lt p e bound 1024
      c0 = ulong get vd_inb p
      if and ne c0 32 ne c0 9
        break
      end
      p = add p 1
    end
    if ge p e
      break
    end
    c = ulong get vd_inb p
    ng = false
    if eq c 45
      ng = true
      p = add p 1
    end
    v = ulong 0
    hex = false
    if lt add p 1 e
      h0 = ulong get vd_inb p
      h1 = ulong get vd_inb add p 1
      if and eq h0 48 eq h1 120
        hex = true
        p = add p 2
      end
    end
    while lt p e bound 1024
      d = ulong get vd_inb p
      if and ge d 48 le d 57
        if hex
          v = add shl v 4 sub d 48
        else
          v = add mul v 10 sub d 48
        end
      else
        if and hex and ge d 97 le d 102
          v = add shl v 4 sub d 87
        else
          if and hex and ge d 65 le d 70
            v = add shl v 4 sub d 55
          else
            break
          end
        end
      end
      p = add p 1
    end
    n = get vd_na 0
    if lt n 24
      put vd_a n v
      put vd_ng n 0
      if ng
        put vd_ng n 1
      end
      put vd_na 0 add n 1
    end
    while lt p e bound 1024
      c2 = ulong get vd_inb p
      if or eq c2 32 eq c2 9
        break
      end
      p = add p 1
    end
  end
end

fn vd_arg i ulong to ulong
  ret get vd_a i
end

fn vd_argl i ulong to long
  if eq get vd_ng i 1
    ret sub 0 long get vd_a i
  end
  ret long get vd_a i
end

fn vd_cmd_o to void
  f = vd_arg 0
  v = vd_arg 1
  op = get tvv_x 3
  t = get tvv_x 0
  a = get tvv_x 1
  if eq f 1
    v_enc_u32le_pay mul op V_MAX_PAYLOAD 0 v
  end
  if eq f 2
    v_enc_u32le_pay mul op V_MAX_PAYLOAD 4 v
  end
  if eq f 3
    v_enc_u16le_pay mul t V_MAX_PAYLOAD 4 v
  end
  if eq f 4
    v_enc_u16le_pay mul a V_MAX_PAYLOAD 32 v
  end
  if eq f 5
    v_enc_u32le_pay mul t V_MAX_PAYLOAD 0 v
  end
  if eq f 6
    put v_og_plen a v
  end
  if eq f 7
    put v_og_plen t v
  end
  if eq f 8
    put v_og_plen get tvv_x 4 v
  end
  if eq f 9
    put v_og_plen op v
  end
end

fn vd_cmd_w to void
  n = vd_arg 0
  tvv_slot_clear 4
  tvv_sem_from_obj 4 get tvv_x 3
  put vver_rprof 4 1
  for i ulong n bound 16
    u = tvv_emit 4 long vd_arg add i 1
  end
  u2 = vver_real_set_id 4
end

fn vd_cmd_x to void
  r = vver_v0 0 4
  if or lt r 0 eq get vver_vr_pass 0 0
    vd_t vd_xv0
    ret
  end
  put vver_xout 0 0
  er = vver_exec 4 vd_arg 0 vd_arg 1 vd_arg 2
  vd_t vd_xx
  vd_d er
  vd_c 32
  vd_u get vver_xout 0
  vd_c 10
end

fn vd_line s ulong e ulong to void
  vd_parse s e
  c = ulong get vd_inb s
  if eq c 83
    vd_hand
    ret
  end
  if eq c 71
    u = tvv_build_add vd_arg 0
    vd_t vd_g
    vd_d u
    vd_c 10
  end
  if eq c 79
    vd_cmd_o
  end
  if eq c 81
    i = vd_arg 0
    if lt i 5
      vd_q get tvv_x i
    else
      for k ulong 32
        put vver_qid k uchar 171
      end
    end
  end
  if eq c 80
    u = tvv_realize_pure 0 get tvv_x 3
    put vd_s0 0 0
    vd_t vd_p
    if eq u 0
      put vd_s0 0 1
      vd_d 0
    else
      vd_d -1
    end
    vd_c 10
  end
  if eq c 75
    u = vmch_build_spark 0
  end
  if eq c 87
    vd_cmd_w
  end
  if eq c 86
    s0 = vd_argl 0
    m = vd_argl 1
    if and eq s0 0 eq get vd_s0 0 0
      vd_t vd_vskip
    else
      vd_s vd_nv vver_verify_object 1 s0 m
    end
  end
  if eq c 88
    vd_cmd_x
  end
  vd_flush
end

fn main to int
  put vd_ol 0 0
  total = ulong 0
  while lt total 4194304 bound 100000
    r = read 0 vd_inb total sub 4194304 total
    if le r 0
      break
    end
    total = add total ulong r
  end
  start = ulong 0
  p = ulong 0
  while lt p total bound 4194305
    if eq get vd_inb p 10
      if gt p start
        if ne get vd_inb start 35
          vd_line start p
        end
      end
      start = add p 1
    end
    p = add p 1
  end
  vd_flush
  ret 0
end

note ---- check accounting (CHECK macro) ----
global t_pass ulong 1
global t_total ulong 1
global t_fail uchar 1024
text t_s_fail "FAIL "
text t_s_pass "PASS "

fn t_fail_put n ulong w view uchar * to ulong
  k = len w
  p = n
  for i ulong k bound 512
    if lt p 1023
      put t_fail p get w i
      p = add p 1
    end
  end
  ret p
end

fn chk c bool msg view uchar * to void
  put t_total 0 add get t_total 0 1
  if c
    put t_pass 0 add get t_pass 0 1
    ret
  end
  p = t_fail_put 0 t_s_fail
  p = t_fail_put p msg
  put t_fail p uchar 10
  u = write 2 t_fail 0 add p 1
  if eq u 99999
    ret
  end
end

note ---- text buffers: 0 txt1, 1 txt2, 2 js1, 3 js2 (65536 bytes each) ----
global t_buf uchar 262144
global t_bufl ulong 4
global t_nd uchar 256
global t_ndl ulong 1

fn t_save sel ulong to void
  n = get v_ob_len 0
  b = mul sel 65536
  for i ulong n bound 65536
    put t_buf add b i get v_ob i
  end
  put t_bufl sel n
end

fn t_fmt_text sel ulong n ulong to long
  r = vsem_format_text n
  t_save sel
  ret r
end

fn t_fmt_json sel ulong n ulong to long
  r = vsem_format_json n
  t_save sel
  ret r
end

fn t_graph sel ulong idx ulong to long
  og_tmp_from_obj idx
  r = vsem_graph_text_tmp 65536
  t_save sel
  ret r
end

fn t_nd_txt w view uchar * to void
  n = len w
  for i ulong n bound 256
    put t_nd i get w i
  end
  put t_ndl 0 n
end

fn t_nd_hexobj idx ulong to void
  b = mul idx 32
  for i ulong 32
    c = ulong get v_og_id add b i
    put t_nd mul i 2 get vt_hex and shr c 4 15
    put t_nd add mul i 2 1 get vt_hex and c 15
  end
  put t_ndl 0 64
end

fn t_match_at sel ulong pos ulong to bool
  b = add mul sel 65536 pos
  nl = get t_ndl 0
  for k ulong nl bound 256
    if ne get t_buf add b k get t_nd k
      ret false
    end
  end
  ret true
end

note strstr of the needle in buffer sel from position start: position or -1.
fn t_find sel ulong start ulong to long
  n = get t_bufl sel
  nl = get t_ndl 0
  if gt nl n
    ret -1
  end
  last = sub n nl
  p = start
  while le p last bound 65537
    if t_match_at sel p
      ret long p
    end
    p = add p 1
  end
  ret -1
end

fn t_has sel ulong w view uchar * to bool
  t_nd_txt w
  ret ge t_find sel 0 0
end

fn t_starts sel ulong w view uchar * to bool
  t_nd_txt w
  if gt get t_ndl 0 get t_bufl sel
    ret false
  end
  ret t_match_at sel 0
end

fn t_buf_eq a ulong b ulong to bool
  n = get t_bufl a
  if ne n get t_bufl b
    ret false
  end
  ba = mul a 65536
  bb = mul b 65536
  for i ulong n bound 65536
    if ne get t_buf add ba i get t_buf add bb i
      ret false
    end
  end
  ret true
end

fn t_first_is sel ulong c uchar to bool
  if eq get t_bufl sel 0
    ret false
  end
  ret eq get t_buf mul sel 65536 c
end

fn t_last_is sel ulong c uchar to bool
  n = get t_bufl sel
  if eq n 0
    ret false
  end
  ret eq get t_buf add mul sel 65536 sub n 1 c
end

note ---- view field checks ----
fn t_ob_eq w view uchar * to bool
  n = len w
  if ne n get v_ob_len 0
    ret false
  end
  for i ulong n bound 4096
    if ne get v_ob i get w i
      ret false
    end
  end
  ret true
end

fn t_kind_is w view uchar * to bool
  ob_reset 65535
  v_put_kind_name get vsem_v_kind 0
  ret t_ob_eq w
end

fn t_vtt_is w view uchar * to bool
  ob_reset 65535
  l = get vsem_vttl 0
  for i ulong l bound 96
    ob_putc get vsem_vtt i
  end
  ret t_ob_eq w
end

fn t_shape_is w view uchar * to bool
  ob_reset 65535
  vsem_put_shape get vsem_v_shape 0
  ret t_ob_eq w
end

fn t_opc_is w view uchar * to bool
  ob_reset 65535
  vsem_put_opcode get vsem_v_opcode 0
  ret t_ob_eq w
end

fn t_ovf_is w view uchar * to bool
  ob_reset 65535
  vsem_put_overflow get vsem_v_ovf 0
  ret t_ob_eq w
end

fn t_role_is i ulong w view uchar * to bool
  ob_reset 65535
  vsem_put_role get vsem_v_dcode i get vsem_v_darg i
  ret t_ob_eq w
end

fn t_relk_is i ulong w view uchar * to bool
  ob_reset 65535
  vsem_put_relation get v_og_rkind og_rslot get vsem_v_idx 0 i
  ret t_ob_eq w
end

fn t_constk_is i ulong w view uchar * to bool
  ob_reset 65535
  vsem_put_constraint get v_og_ckind og_cslot get vsem_v_idx 0 i
  ret t_ob_eq w
end

fn t_const_len i ulong to ulong
  ret get v_og_clen og_cslot get vsem_v_idx 0 i
end

fn t_attrkey_is i ulong w view uchar * to bool
  ob_reset 65535
  vsem_put_attr_key og_aslot get vsem_v_idx 0 i
  ret t_ob_eq w
end

fn t_attr_utf8 i ulong to bool
  ret vsem_attr_utf8 og_aslot get vsem_v_idx 0 i
end

fn t_rel_resolved i ulong to bool
  ret eq get vsem_v_rres i 1
end

fn t_acnt to ulong
  ret get v_og_acnt get vsem_v_idx 0
end

fn t_rcnt to ulong
  ret get v_og_rcnt get vsem_v_idx 0
end

fn t_ccnt to ulong
  ret get v_og_ccnt get vsem_v_idx 0
end

fn t_rs_has w view uchar * to bool
  ob_reset 65535
  l = get vsem_v_rsl 0
  for i ulong l bound 256
    ob_putc get vsem_v_rs i
  end
  t_save 3
  ret t_has 3 w
end

note 0 type_id, 1 apply_op, 2 operands, 3 deps, 4 type_of id, 5 apply_parts op, 6 apply_parts operands
fn t_get32 sel ulong k ulong i ulong to uchar
  o = add mul k 32 i
  if eq sel 0
    ret get vsem_v_tid i
  end
  if eq sel 1
    ret get vsem_v_apop i
  end
  if eq sel 2
    ret get vsem_v_operands o
  end
  if eq sel 3
    ret get vsem_v_dids o
  end
  if eq sel 4
    ret get vsem_rtid i
  end
  if eq sel 5
    ret get vsem_ap_op i
  end
  ret get vsem_ap_ops o
end

fn t_id_eq sel ulong k ulong idx ulong to bool
  b = mul idx 32
  for i ulong 32
    if ne t_get32 sel k i get v_og_id add b i
      ret false
    end
  end
  ret true
end

fn t_tt_is w view uchar * to bool
  ob_reset 65535
  vsem_put_tr 40
  ret t_ob_eq w
end

note ---- entry points on object indexes ----
fn t_insp idx ulong to long
  og_tmp_from_obj idx
  ret vsem_inspect_args true true
end

fn t_ghost to void
  for i ulong 32
    put v_tmp_id i uchar 0xab
  end
end

fn t_typeof idx ulong to long
  og_tmp_from_obj idx
  ret vsem_type_of_tmp
end

fn t_value idx ulong to long
  og_tmp_from_obj idx
  ret vsem_value_u64_tmp
end

fn t_eval idx ulong to long
  og_tmp_from_obj idx
  ret vsem_eval_u64_tmp
end

fn t_parts idx ulong to long
  og_tmp_from_obj idx
  ret vsem_apply_parts_tmp
end

fn t_val_is v ulong to bool
  ret eq get vsem_val 0 v
end

note ---- object slots in graph g ----
const K_T64 ulong 0
const K_TU8 ulong 1
const K_TBOOL ulong 2
const K_TBV ulong 3
const K_TSEQ ulong 4
const K_V7 ulong 5
const K_V11 ulong 6
const K_VMAX ulong 7
const K_V1O ulong 8
const K_VTRUE ulong 9
const K_VBV ulong 10
const K_ADD ulong 11
const K_ADDFC ulong 12
const K_AP ulong 13
const K_APWRAP ulong 14
const K_APNEST ulong 15
const K_APFC ulong 16
const K_APBAD ulong 17
const K_ANN ulong 18
const K_DANG ulong 19
global tx ulong 32
global t_chain ulong 72
global t_apid uchar 32

text t_k_name "name"
text t_k_answer "answer"
text t_k_blob "blob"

fn tx_put k ulong r long to bool
  if lt r 0
    ret false
  end
  put tx k ulong r
  ret true
end

fn t_build_g1 to bool
  ok = tx_put K_T64 og_build_type_uint 64
  ok = and ok tx_put K_TU8 og_build_type_uint 8
  ok = and ok tx_put K_TBOOL og_build_type_bool
  ok = and ok tx_put K_TBV og_build_type_bitvec 32
  ok = and ok tx_put K_TSEQ og_build_type_seq get tx K_TU8 16
  t64 = get tx K_T64
  ok = and ok tx_put K_V7 og_build_val_uint t64 64 7
  ok = and ok tx_put K_V11 og_build_val_uint t64 64 11
  ok = and ok tx_put K_VMAX og_build_val_uint t64 64 0xffffffffffffffff
  ok = and ok tx_put K_V1O og_build_val_uint t64 64 1
  ok = and ok tx_put K_VTRUE og_build_val_bool get tx K_TBOOL 1
  ok = and ok tx_put K_VBV og_build_val_uint get tx K_TBV 32 0xdeadbeef
  ok = and ok tx_put K_ADD og_build_op_binary V_OP_ADD V_OVF_WRAP t64
  ok = and ok tx_put K_ADDFC og_build_op_binary V_OP_ADD V_OVF_FAIL_CLOSED t64
  ret ok
end

fn t_build_g2 to bool
  add_i = get tx K_ADD
  ok = tx_put K_AP og_build_apply add_i get tx K_V7 get tx K_V11
  ok = and ok tx_put K_APWRAP og_build_apply add_i get tx K_VMAX get tx K_V1O
  ok = and ok tx_put K_APNEST og_build_apply add_i get tx K_AP get tx K_V7
  ok = and ok tx_put K_APFC og_build_apply get tx K_ADDFC get tx K_VMAX get tx K_V1O
  ok = and ok tx_put K_APBAD og_build_apply add_i get tx K_VTRUE get tx K_V7
  ret ok
end

note annotated value: attribute, relation, constraint (then re-id as a builder would); dangling relation.
fn t_build_g3 to bool
  t64 = get tx K_T64
  ok = tx_put K_ANN og_build_val_uint t64 64 42
  ann = get tx K_ANN
  u = og_add_attr ann t_k_name t_k_answer
  put v_sbuf 0 uchar 0x00
  put v_sbuf 1 uchar 0xff
  put v_sbuf 2 uchar 0x10
  u = og_add_attr_sbuf ann t_k_blob 3
  u = og_add_rel ann V_REL_DERIVED_FROM get tx K_V7
  for i ulong 8
    put v_sbuf i uchar 0
  end
  put v_sbuf 7 uchar 100
  u = og_add_const_sbuf ann V_CONST_RANGE 8
  u = og_compute_id ann
  ok = and ok tx_put K_DANG og_build_val_uint t64 64 5
  dang = get tx K_DANG
  t_ghost
  u = og_add_rel_tmp dang V_REL_DEPENDS_ON
  u = og_compute_id dang
  if eq u 99999
    ret false
  end
  ret ok
end

note depth chain: c0 = 7, c_k = add(c_{k-1}, 1)
fn t_build_chain to bool
  put t_chain 0 get tx K_V7
  for k ulong 71
    c = og_build_apply get tx K_ADD get t_chain k get tx K_V1O
    if lt c 0
      ret false
    end
    put t_chain add k 1 ulong c
  end
  ret true
end


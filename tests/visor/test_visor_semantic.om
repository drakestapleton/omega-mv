fn t_sec8 to void
  r1 = t_insp get tx K_ANN
  a = t_fmt_text 0 65536
  c = t_fmt_json 2 65536
  r2 = t_insp get tx K_ANN
  b = t_fmt_text 1 65536
  d = t_fmt_json 3 65536
  chk and eq r1 0 eq r2 0 tm_63
  chk and gt a 0 gt b 0 tm_64
  chk t_buf_eq 0 1 tm_65
  chk and gt c 0 gt d 0 tm_66
  chk and and t_buf_eq 2 3 t_first_is 2 uchar 123 t_last_is 2 uchar 125 tm_67
end

fn t_sec8b to void
  r3 = t_insp get tx K_AP
  e = t_fmt_json 2 65536
  chk and eq r3 0 gt e 0 tm_68
  r4 = t_insp get tx K_AP
  f = t_fmt_json 3 65536
  chk and eq r4 0 gt f 0 tm_69
  chk t_buf_eq 2 3 tm_70
  h = t_fmt_text 0 40
  chk and eq h -1 eq get t_bufl 0 0 tm_71
  k = t_fmt_json 2 40
  chk eq k -1 tm_72
end

note 10. eval
fn t_sec10 to void
  r = t_eval get tx K_AP
  chk and eq r 0 t_val_is 18 tm_73
  r = t_eval get tx K_APWRAP
  chk and eq r 0 t_val_is 0 tm_74
  r = t_eval get tx K_APNEST
  chk and eq r 0 t_val_is 25 tm_75
  r = t_eval get tx K_V11
  chk and eq r 0 t_val_is 11 tm_76
  r = t_eval get tx K_APFC
  chk eq r -3 tm_77
  r = t_eval get tx K_APBAD
  chk eq r -1 tm_78
  r = t_eval get tx K_ADD
  chk eq r -1 tm_79
  r = t_eval get t_chain 60
  chk and eq r 0 t_val_is 67 tm_80
  r = t_eval get t_chain 71
  chk eq r -1 tm_81
end

fn t_apid_same to bool
  b = mul get tx K_AP 32
  for i ulong 32
    if ne get v_og_id add b i get t_apid i
      ret false
    end
  end
  ret true
end

note 11. malformed objects in a second graph m: reported, never dereferenced
const M_T ulong 0
const M_V ulong 1
const M_K ulong 2
const M_ID ulong 3
const M_OP ulong 4
const M_BIG ulong 5
const M_AP ulong 6
const M_DEF ulong 7

fn t_build_m to bool
  og_reset
  ok = tx_put 20 og_build_type_uint 64
  ok = and ok tx_put 21 og_build_val_uint M_T 64 9
  ok = and ok tx_put 22 og_build_val_uint M_T 64 10
  ok = and ok tx_put 23 og_build_val_uint M_T 64 12
  ok = and ok tx_put 24 og_build_op_binary V_OP_ADD V_OVF_WRAP M_T
  ok = and ok tx_put 25 og_build_val_uint M_T 64 13
  ok = and ok tx_put 26 og_build_apply M_OP M_V M_V
  ok = and ok tx_put 27 og_build_op_binary V_OP_ADD V_OVF_DEFAULT M_T
  for i ulong 8
    ok = and ok eq get tx add 20 i i
  end
  ret ok
end

fn t_sec11 to void
  r = t_insp M_DEF
  chk and eq r -2 t_rs_has t_s_overflow tm_84
  put v_og_plen M_V 3
  put v_og_kind M_K 0x7f
  pp = add mul M_ID V_MAX_PAYLOAD 40
  put v_og_pay pp uchar xor get v_og_pay pp 1
  put v_og_plen M_BIG 5000
  r = t_insp M_V
  chk and and eq r -2 eq get vsem_v_status 0 -2 t_rs_has t_s_vpl3 tm_85
  f = t_fmt_text 0 65536
  chk and gt f 0 t_has 0 t_s_smal tm_86
  f = t_fmt_json 2 65536
  chk and gt f 0 t_has 2 t_s_jmal tm_87
  r = t_insp M_K
  chk and eq r -2 t_rs_has t_s_kind7f tm_88
  r = t_insp M_ID
  chk and eq r -2 t_rs_has t_s_stored tm_89
  r = t_insp M_BIG
  chk and eq r -2 t_rs_has t_s_exceeds tm_90
  r = t_value M_V
  chk eq r -2 tm_91
  r = t_typeof M_K
  chk eq r -2 tm_92
  r = t_eval M_AP
  chk eq r -2 tm_93
  g = t_graph 1 M_AP
  chk and gt g 0 t_has 1 t_s_malsha tm_94
end

note shared helpers coexist with visor.om: format_id equals the view id text
fn t_sec_ids to void
  ob_reset 65535
  ob_puts vt_sha256_pfx
  ob_put_hex_id32 mul get tx K_V7 32 1
  t_save 0
  r = t_insp get tx K_V7
  ob_reset 65535
  vsem_put_view_id
  t_save 1
  chk and eq r 0 t_buf_eq 0 1 tm_95
end

fn main to int
  vs_init
  if not and t_build_g1 t_build_g2
    ret 2
  end
  u = t_build_g3
  if not t_build_chain
    u2 = write 2 t_s_tfull 0 len t_s_tfull
    if eq u2 99999
      ret 1
    end
    ret 1
  end
  if eq u false
    ret 2
  end
  ts_save
  ab = mul get tx K_AP 32
  for i ulong 32
    put t_apid i get v_og_id add ab i
  end
  t_sec1
  t_sec2
  t_sec3
  t_sec4
  t_sec5
  t_sec5b
  t_sec_dang
  t_sec7
  t_sec8
  t_sec8b
  t_sec10
  chk t_apid_same tm_82
  chk ts_same tm_83
  if not t_build_m
    ret 2
  end
  t_sec11
  ts_load
  t_sec_ids
  ob_reset 65535
  ob_puts t_s_pass
  ob_put_u64 get t_pass 0
  ob_putc uchar 47
  ob_put_u64 get t_total 0
  ob_putc uchar 10
  ob_write_fd 1
  if eq get t_pass 0 get t_total 0
    ret 0
  end
  ret 1
end

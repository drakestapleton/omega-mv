fn ts_cnt_save to void
  for i ulong 1
    put ts_cnt i get v_og_cnt i
  end
end

fn ts_cnt_load to void
  for i ulong 1
    put v_og_cnt i get ts_cnt i
  end
end

fn ts_cnt_same to bool
  for i ulong 1
    if ne get ts_cnt i get v_og_cnt i
      ret false
    end
  end
  ret true
end


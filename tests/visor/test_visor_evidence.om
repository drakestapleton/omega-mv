global tve_basel ulong 1

fn tve_chk cond bool msg view uchar * to void
  put tve_tot 0 add get tve_tot 0 1
  if cond
    put tve_pass_n 0 add get tve_pass_n 0 1
    ret
  end
  ob_reset 4096
  ob_puts tve_fail
  ob_puts msg
  ob_putc uchar 10
  ob_write_fd 2
end

note ---- record field helpers (slot r) ----
fn tve_feq r ulong f ulong w view uchar * to bool
  n = len w
  if ne vev_flen_of r f n
    ret false
  end
  for k ulong n bound 256
    if ne vev_fget r f k get w k
      ret false
    end
  end
  ret true
end

fn tve_fpre r ulong f ulong w view uchar * to bool
  n = len w
  if lt vev_flen_of r f n
    ret false
  end
  for k ulong n bound 256
    if ne vev_fget r f k get w k
      ret false
    end
  end
  ret true
end

fn tve_fsuf r ulong f ulong w view uchar * to bool
  n = len w
  l = vev_flen_of r f
  if lt l n
    ret false
  end
  b = sub l n
  for k ulong n bound 256
    if ne vev_fget r f add b k get w k
      ret false
    end
  end
  ret true
end

fn tve_fhas r ulong f ulong w view uchar * to bool
  n = len w
  l = vev_flen_of r f
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for i ulong lim bound 256
    ok = true
    for k ulong n bound 256
      if ne vev_fget r f add i k get w k
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn tve_scope r ulong to ulong
  ret vev_rs_get r VEV_S_SCOPE
end

note find(view, suffix): item slot whose path ends with suffix, or -1.
fn tve_find sx view uchar * to long
  c = get vev_cnt 0
  for i ulong c bound 16
    if tve_fsuf i VEV_F_PATH sx
      ret long i
    end
  end
  ret -1
end

fn tve_up_at i ulong s ulong w view uchar * to bool
  n = len w
  b = add mul i 256 s
  for k ulong n bound 256
    if ne get vev_up add b k get w k
      ret false
    end
  end
  ret true
end

fn tve_up_has i ulong w view uchar * to bool
  n = len w
  l = get vev_upl i
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 256
    if tve_up_at i s w
      ret true
    end
  end
  ret false
end

fn tve_ob_has w view uchar * to bool
  n = len w
  l = get v_ob_len 0
  if gt n l
    ret false
  end
  lim = add sub l n 1
  for s ulong lim bound 65536
    ok = true
    for k ulong n bound 256
      if ne get v_ob add s k get w k
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn tve_save_ob to void
  l = get v_ob_len 0
  for k ulong l bound 65536
    put tve_txt k get v_ob k
  end
  put tve_txtl 0 l
end

fn tve_ob_eq_saved to bool
  l = get v_ob_len 0
  if ne l get tve_txtl 0
    ret false
  end
  for k ulong l bound 65536
    if ne get v_ob k get tve_txt k
      ret false
    end
  end
  ret true
end

fn tve_sorted to bool
  c = get vev_cnt 0
  if lt c 2
    ret true
  end
  for i ulong sub c 1 bound 16
    la = vev_flen_of i VEV_F_PATH
    lb = vev_flen_of add i 1 VEV_F_PATH
    m = la
    if lt lb m
      m = lb
    end
    cmp = long 0
    for k ulong m bound 256
      if eq cmp 0
        ca = vev_fget i VEV_F_PATH k
        cb = vev_fget add i 1 VEV_F_PATH k
        if lt ca cb
          cmp = -1
        end
        if gt ca cb
          cmp = 1
        end
      end
    end
    if eq cmp 0
      if lt la lb
        cmp = -1
      end
      if gt la lb
        cmp = 1
      end
    end
    if ge cmp 0
      ret false
    end
  end
  ret true
end

fn tve_scan_fix to long
  n = vev_root_txt tve_fix
  ret vev_scan n
end

fn tve_set_qid b uchar to void
  for k ulong 32
    put vev_qid k b
  end
end

fn tve_for_id_fix b uchar to long
  tve_set_qid b
  n = vev_root_txt tve_fix
  ret vev_for_id n
end

fn tve_c_host to void
  h = tve_find tve_sx_host
  ok5 = false
  ok6 = false
  ok7 = false
  ok8 = false
  ok9 = false
  ok10 = false
  if ge h 0
    u = ulong h
    ok5 = and eq tve_scope u VEV_SCOPE_HOST tve_feq u VEV_F_BASIS tve_v_hs
    ok6 = and tve_feq u VEV_F_COMMIT tve_v_c1 tve_feq u VEV_F_RUN tve_v_run
    t7 = and eq vev_rs_get u VEV_S_TKNOWN 1 eq vev_rs_get u VEV_S_DIRTY 0
    ok7 = and t7 and eq vev_rs_get u VEV_S_GRUN 3 eq vev_rs_get u VEV_S_GPASS 2
    ok8 = tve_feq u VEV_F_CLAIM tve_v_hclaim
    ok9 = tve_feq u VEV_F_MACH tve_v_hmach
    t10 = and tve_fpre u VEV_F_RID tve_v_sha eq vev_flen_of u VEV_F_RID 71
    ok10 = and t10 eq get vev_rn u -1
  end
  tve_chk ok5 tve_m5
  tve_chk ok6 tve_m6
  tve_chk ok7 tve_m7
  tve_chk ok8 tve_m8
  tve_chk ok9 tve_m9
  tve_chk ok10 tve_m10
end

fn tve_c_qemu_sil to void
  q = tve_find tve_sx_qemu
  ok11 = false
  ok12 = false
  if ge q 0
    u = ulong q
    ok11 = and eq tve_scope u VEV_SCOPE_QEMU and eq vev_rs_get u VEV_S_GRUN 3 eq vev_rs_get u VEV_S_GPASS 3
    t12 = and tve_feq u VEV_F_REAL tve_v_qreal eq vev_rs_get u VEV_S_TKNOWN 0
    ok12 = and t12 tve_feq u VEV_F_CLAIM tve_v_qclaim
  end
  tve_chk ok11 tve_m11
  tve_chk ok12 tve_m12
  s = tve_find tve_sx_sil
  ok13 = false
  ok14 = false
  if ge s 0
    w = ulong s
    ok13 = and eq tve_scope w VEV_SCOPE_SILICON tve_feq w VEV_F_BASIS tve_v_sot
    t14 = and eq vev_rs_get w VEV_S_DIRTY 1 tve_feq w VEV_F_PHYS tve_v_p5
    ok14 = and t14 and tve_feq w VEV_F_MACH tve_v_smach tve_fpre w VEV_F_REAL tve_v_cccc
  end
  tve_chk ok13 tve_m13
  tve_chk ok14 tve_m14
end

fn tve_c_rest to void
  n = tve_find tve_sx_st
  ok15 = false
  if ge n 0
    ok15 = eq tve_scope ulong n VEV_SCOPE_HOST
  end
  tve_chk ok15 tve_m15
  x = tve_find tve_sx_unk
  ok16 = false
  if ge x 0
    u = ulong x
    ok16 = and eq tve_scope u VEV_SCOPE_UNKNOWN and eq vev_flen_of u VEV_F_BASIS 0 eq vev_rs_get u VEV_S_GRUN 0
  end
  tve_chk ok16 tve_m16
  c = long -1
  cnt = get vev_cnt 0
  for i ulong cnt bound 16
    if tve_fhas i VEV_F_PATH tve_s_ca
      c = long i
    end
  end
  ok17 = false
  if ge c 0
    w = ulong c
    ok17 = and eq get vev_rn w 1 and eq tve_scope w VEV_SCOPE_HOST tve_feq w VEV_F_COMMIT tve_v_c8
  end
  tve_chk ok17 tve_m17
end

fn tve_c_fixtures to void
  tve_chk eq tve_scan_fix 0 tve_m1
  t2 = and eq get vev_scanned 0 8 and eq get vev_cnt 0 6 eq get vev_matched 0 6
  tve_chk and t2 and eq get vev_unparsed 0 2 eq get vev_trunc 0 0 tve_m2
  tve_chk tve_sorted tve_m3
  ok4 = false
  if eq get vev_upn 0 2
    ok4 = and tve_up_has 0 tve_s_dig tve_up_has 1 tve_s_malf
  end
  tve_chk ok4 tve_m4
  tve_c_host
  tve_c_qemu_sil
  tve_c_rest
end

fn tve_c_loads to void
  tve_chk eq vev_load_txt tve_p_malf -1 tve_m18
  tve_chk eq vev_load_txt tve_p_dig -1 tve_m19
  tve_chk eq vev_load_txt tve_p_miss -1 tve_m20
  ok21 = false
  if eq vev_load_txt tve_p_sil 0
    ok21 = eq tve_scope VEV_REC VEV_SCOPE_SILICON
  end
  tve_chk ok21 tve_m21
  n = vev_root_txt tve_nodir
  tve_chk eq vev_scan n -1 tve_m22
end

fn tve_c_for_id to void
  tve_chk eq tve_for_id_fix uchar 0xaa 0 tve_m23
  t24 = and eq get vev_cnt 0 2 ge tve_find tve_sx_host 0
  tve_chk and t24 and ge tve_find tve_sx_qemu 0 eq get vev_unparsed 0 2 tve_m24
  u = tve_for_id_fix uchar 0xbb
  tve_chk and eq get vev_cnt 0 1 ge tve_find tve_sx_qemu 0 tve_m25
  r26 = tve_for_id_fix uchar 0x12
  tve_chk and eq r26 0 and eq get vev_cnt 0 0 eq get vev_unparsed 0 0 tve_m26
  ok27 = false
  if gt vev_format_text 65536 0
    ok27 = tve_ob_has tve_s_noev
  end
  tve_chk ok27 tve_m27
  if lt u -999
    ret
  end
end

fn tve_c_render to void
  u = tve_scan_fix
  a = vev_format_text 65536
  tve_save_ob
  u2 = tve_scan_fix
  b = vev_format_text 65536
  tve_chk and gt a 0 and gt b 0 tve_ob_eq_saved tve_m28
  tve_chk and tve_ob_has tve_s_unp tve_ob_has tve_s_silfrom tve_m29
  ok30 = false
  if gt vev_format_json 65536 0
    ok30 = and eq get v_ob 0 123 tve_ob_has tve_s_jqemu
  end
  tve_chk ok30 tve_m30
  tve_chk eq vev_format_text 32 -1 tve_m31
  if lt add u u2 -999
    ret
  end
end

note ---- large tree (omega-mv#404) ----
fn tve_read_receipt to ulong
  n = len tve_p_hostrc
  fd = fopen tve_p_hostrc 0 n 0 0
  if lt fd 0
    ret 0
  end
  tot = ulong 0
  while lt tot 65536 bound 65536
    k = read int fd tve_rb tot sub 65536 tot
    if le k 0
      break
    end
    tot = add tot ulong k
  end
  u = fclose int fd
  if lt u -999999
    ret 0
  end
  ret tot
end

note k-th name in ascending order into tve_name.
fn tve_big_name k ulong to void
  put tve_namel 0 0
  if eq k 0
    n = len tve_b_first
    for i ulong n
      put tve_name i get tve_b_first i
    end
    put tve_namel 0 n
    ret
  end
  if eq k 1501
    n2 = len tve_b_last
    for i ulong n2
      put tve_name i get tve_b_last i
    end
    put tve_namel 0 n2
    ret
  end
  x = sub k 1
  put tve_name 0 uchar 102
  put tve_name 1 uchar add 48 div x 1000
  put tve_name 2 uchar add 48 rem div x 100 10
  put tve_name 3 uchar add 48 rem div x 10 10
  put tve_name 4 uchar add 48 rem x 10
  put tve_name 5 uchar 46
  put tve_name 6 uchar 116
  put tve_name 7 uchar 120
  put tve_name 8 uchar 116
  put tve_namel 0 9
end

note dir (sel 0 asc, 1 desc) + "/" + tve_name into tve_path.
fn tve_join sel ulong to void
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
  end
  for i ulong dl bound 600
    if eq sel 1
      put tve_path i get tve_descp i
    else
      put tve_path i get tve_ascp i
    end
  end
  put tve_path dl uchar 47
  nl = get tve_namel 0
  for i ulong nl bound 64
    put tve_path add add dl 1 i get tve_name i
  end
  put tve_pl 0 add add dl 1 nl
end

fn tve_is_json_name to bool
  nl = get tve_namel 0
  ret eq get tve_name sub nl 1 110
end

fn tve_write_file rlen ulong to long
  pl = get tve_pl 0
  fd = fopen tve_path 0 pl 557249 384
  if lt fd 0
    ret -1
  end
  w = long 0
  want = long 14
  if tve_is_json_name
    want = long rlen
    w = write int fd tve_rb 0 rlen
  else
    w = write int fd tve_b_txt 0 14
  end
  u = fclose int fd
  if ne u 0
    ret -1
  end
  if ne w want
    ret -1
  end
  ret 0
end

fn tve_build sel ulong desc ulong rlen ulong to long
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
  end
  md = long 0
  if eq sel 1
    md = makedir tve_descp 0 dl 448
  else
    md = makedir tve_ascp 0 dl 448
  end
  if ne md 0
    ret -1
  end
  for i ulong 1502
    k = i
    if eq desc 1
      k = sub 1501 i
    end
    tve_big_name k
    tve_join sel
    if lt tve_write_file rlen 0
      ret -1
    end
  end
  ret 0
end

fn tve_remove sel ulong to void
  for i ulong 1502
    tve_big_name i
    tve_join sel
    u = unlink tve_path 0 get tve_pl 0
    if lt u -999999
      ret
    end
  end
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
    u2 = rmdir tve_descp 0 dl
    if lt u2 -999999
      ret
    end
  else
    u3 = rmdir tve_ascp 0 dl
    if lt u3 -999999
      ret
    end
  end
end

global tve_rd_idx long 1
global tve_rd_at long 1

fn tve_rd_entry noff ulong nl ulong to void
  if eq nl 0
    ret
  end
  if eq get vev_dbuf noff 46
    ret
  end
  nlast = len tve_b_last
  if eq nl nlast
    same = true
    for k ulong nl bound 64
      if ne get vev_dbuf add noff k get tve_b_last k
        same = false
      end
    end
    if same
      put tve_rd_at 0 get tve_rd_idx 0
    end
  end
  put tve_rd_idx 0 add get tve_rd_idx 0 1
end

fn tve_rd_fd fd long to void
  while true bound 1000000
    nr = getdnts int fd vev_dbuf 0 32768
    if le nr 0
      break
    end
    pos = ulong 0
    nru = ulong nr
    while lt pos nru bound 32768
      rlen = vev_dirent_rlen pos
      if eq rlen 0
        break
      end
      tve_rd_entry add pos 19 vev_dirent_name_len pos rlen
      pos = add pos rlen
    end
  end
end

fn tve_readdir_pos sel ulong to long
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
  end
  for i ulong dl bound 600
    if eq sel 1
      put tve_path i get tve_descp i
    else
      put tve_path i get tve_ascp i
    end
  end
  fd = fopen tve_path 0 dl 16384 0
  if lt fd 0
    ret -1
  end
  put tve_rd_idx 0 0
  put tve_rd_at 0 -1
  tve_rd_fd fd
  u = fclose int fd
  if lt u -999999
    ret -1
  end
  ret get tve_rd_at 0
end

note mkdtemp("<base>/visor-evidence-404-XXXXXX") into tve_root.
fn tve_mkdtemp to bool
  st = stat tve_shm 0 len tve_shm vev_stb 0 128
  useshm = false
  if eq st 0
    if eq and vev_stat_mode 61440 16384
      if eq faccess tve_shm 0 len tve_shm 2 0
        useshm = true
      end
    end
  end
  for attempt ulong 100
    l = ulong 0
    if useshm
      n = len tve_shm
      for i ulong n
        put tve_root i get tve_shm i
      end
      l = n
      put tve_basel 0 n
    else
      n2 = len tve_tmp
      for i ulong n2
        put tve_root i get tve_tmp i
      end
      l = n2
      put tve_basel 0 n2
    end
    pn = len tve_root_pfx
    for i ulong pn
      put tve_root add l i get tve_root_pfx i
    end
    l = add l pn
    u = random tve_rnd 0 6 0
    for i ulong 6
      put tve_root add l i get tve_alnum rem ulong get tve_rnd i 62
    end
    l = add l 6
    put tve_rootl 0 l
    if eq makedir tve_root 0 l 448 0
      ret true
    end
    if lt u -999999
      ret false
    end
  end
  ret false
end

fn tve_set_subdirs to void
  l = get tve_rootl 0
  for i ulong l bound 512
    put tve_ascp i get tve_root i
    put tve_descp i get tve_root i
  end
  na = len tve_asc
  for i ulong na
    put tve_ascp add l i get tve_asc i
  end
  put tve_ascl 0 add l na
  nd = len tve_desc
  for i ulong nd
    put tve_descp add l i get tve_desc i
  end
  put tve_descl 0 add l nd
end

fn tve_put_long v long to void
  if lt v 0
    ob_putc uchar 45
    ob_put_u64 ulong neg v
  else
    ob_put_u64 ulong v
  end
end

fn tve_note to void
  pa = tve_readdir_pos 0
  pd = tve_readdir_pos 1
  ob_reset 4096
  ob_puts tve_n_note
  b = get tve_basel 0
  for i ulong b bound 512
    ob_putc get tve_root i
  end
  ob_putc uchar 58
  ob_putc uchar 32
  ob_puts tve_b_last
  ob_puts tve_n_at
  tve_put_long pa
  ob_puts tve_n_asc
  tve_put_long pd
  ob_puts tve_n_desc
  ob_put_u64 1502
  ob_putc uchar 10
  ob_write_fd 2
end

note scan root (sel 0 asc, 1 desc) into the view.
fn tve_scan_sel sel ulong to long
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
  end
  for i ulong dl bound 600
    if eq sel 1
      put vev_root i get tve_descp i
    else
      put vev_root i get tve_ascp i
    end
  end
  ret vev_scan dl
end

fn tve_for_id_sel sel ulong to long
  dl = get tve_ascl 0
  if eq sel 1
    dl = get tve_descl 0
  end
  for i ulong dl bound 600
    if eq sel 1
      put vev_root i get tve_descp i
    else
      put vev_root i get tve_ascp i
    end
  end
  ret vev_for_id dl
end

note snapshot of the current view with path prefix length ra removed.
fn tve_snap_item i ulong ra ulong to void
  l = vev_flen_of i VEV_F_PATH
  sl = ulong 0
  if ge l ra
    sl = sub l ra
  end
  put tve_snap_pl i sl
  b = mul i 256
  for k ulong sl bound 256
    put tve_snap_p add b k vev_fget i VEV_F_PATH add ra k
  end
  b2 = mul i 72
  for k ulong 72
    put tve_snap_id add b2 k vev_fget i VEV_F_RID k
  end
end

fn tve_snap_up i ulong ra ulong to void
  l = get vev_upl i
  sl = ulong 0
  if ge l ra
    sl = sub l ra
  end
  put tve_snap_ul i sl
  b = mul i 256
  for k ulong sl bound 256
    put tve_snap_u add b k get vev_up add add b ra k
  end
end

fn tve_snap ra ulong to void
  put tve_snap_n 0 get vev_scanned 0
  put tve_snap_n 1 get vev_matched 0
  put tve_snap_n 2 get vev_cnt 0
  put tve_snap_n 3 get vev_unparsed 0
  put tve_snap_n 4 get vev_trunc 0
  put tve_snap_n 5 get vev_upn 0
  c = get vev_cnt 0
  for i ulong c bound 16
    tve_snap_item i ra
  end
  un = get vev_upn 0
  for i ulong un bound 8
    tve_snap_up i ra
  end
end

fn tve_same_item i ulong rb ulong to bool
  l = vev_flen_of i VEV_F_PATH
  if lt l rb
    ret false
  end
  sl = sub l rb
  if ne sl get tve_snap_pl i
    ret false
  end
  b = mul i 256
  for k ulong sl bound 256
    if ne get tve_snap_p add b k vev_fget i VEV_F_PATH add rb k
      ret false
    end
  end
  b2 = mul i 72
  for k ulong 71
    if ne get tve_snap_id add b2 k vev_fget i VEV_F_RID k
      ret false
    end
  end
  ret true
end

fn tve_same_up i ulong rb ulong to bool
  l = get vev_upl i
  if lt l rb
    ret false
  end
  sl = sub l rb
  if ne sl get tve_snap_ul i
    ret false
  end
  b = mul i 256
  for k ulong sl bound 256
    if ne get tve_snap_u add b k get vev_up add add b rb k
      ret false
    end
  end
  ret true
end

fn tve_same_items rb ulong to bool
  c = get vev_cnt 0
  for i ulong c bound 16
    if not tve_same_item i rb
      ret false
    end
  end
  un = get vev_upn 0
  for i ulong un bound 8
    if not tve_same_up i rb
      ret false
    end
  end
  ret true
end

fn tve_same_view rb ulong to bool
  if ne get tve_snap_n 0 get vev_scanned 0
    ret false
  end
  if ne get tve_snap_n 1 get vev_matched 0
    ret false
  end
  if ne get tve_snap_n 2 get vev_cnt 0
    ret false
  end
  if ne get tve_snap_n 3 get vev_unparsed 0
    ret false
  end
  if ne get tve_snap_n 4 get vev_trunc 0
    ret false
  end
  if ne get tve_snap_n 5 get vev_upn 0
    ret false
  end
  ret tve_same_items rb
end

fn tve_large_default ra ulong rb ulong to void
  s1 = tve_scan_sel 0
  tve_snap ra
  c1 = get vev_cnt 0
  ok5 = and eq get tve_snap_n 0 1502 and eq get vev_matched 0 2 eq c1 2
  ok5b = and eq get vev_unparsed 0 1500 eq get vev_trunc 0 0
  ok6 = false
  if eq c1 2
    ok6 = and tve_fhas 0 VEV_F_PATH tve_b_first tve_fhas 1 VEV_F_PATH tve_b_last
  end
  s2 = tve_scan_sel 1
  tve_chk and eq s1 0 eq s2 0 tve_l4
  tve_chk and ok5 ok5b tve_l5
  tve_chk ok6 tve_l6
  tve_chk tve_same_view rb tve_l7
end

fn tve_large_capped_id ra ulong rb ulong to void
  tve_set_qid uchar 0xaa
  f1 = tve_for_id_sel 0
  tve_snap ra
  t12 = and eq get vev_cnt 0 1 eq get vev_trunc 0 1
  f2 = tve_for_id_sel 1
  okf = and eq f1 0 eq f2 0
  same = tve_same_view rb
  tve_chk and okf and t12 same tve_l12
end

fn tve_large_capped ra ulong rb ulong to void
  s1 = tve_scan_sel 0
  tve_snap ra
  t9 = and eq get vev_scanned 0 1024 and eq get vev_trunc 0 1 eq get vev_matched 0 1
  t9b = and eq get vev_cnt 0 1 eq get vev_unparsed 0 1023
  ok9 = false
  if and t9 t9b
    ok9 = tve_fhas 0 VEV_F_PATH tve_b_first
  end
  ok10 = false
  if eq get vev_upn 0 8
    ok10 = and tve_up_has 0 tve_b_f0 tve_up_has 7 tve_b_f7
  end
  s2 = tve_scan_sel 1
  tve_chk and eq s1 0 eq s2 0 tve_l8
  tve_chk ok9 tve_l9
  tve_chk ok10 tve_l10
  tve_chk tve_same_view rb tve_l11
  tve_large_capped_id ra rb
end

fn tve_check_large_tree to void
  rlen = tve_read_receipt
  put tve_rbl 0 rlen
  tve_chk and gt rlen 0 lt rlen 65536 tve_l1
  if not tve_mkdtemp
    tve_chk false tve_l2
    ret
  end
  tve_set_subdirs
  b1 = tve_build 0 0 rlen
  b2 = tve_build 1 1 rlen
  tve_chk and eq b1 0 eq b2 0 tve_l3
  tve_note
  ra = get tve_ascl 0
  rb = get tve_descl 0
  tve_large_default ra rb
  prev = vev_set_max_files 1024
  tve_large_capped ra rb
  u = vev_set_max_files 0
  tve_chk and eq prev VEV_MAX_FILES eq vev_set_max_files 0 VEV_MAX_FILES tve_l13
  tve_remove 0
  tve_remove 1
  tve_chk eq rmdir tve_root 0 get tve_rootl 0 0 tve_l14
  if eq u 7
    ret
  end
end

fn tve_real_tree to bool
  n = vev_root_txt tve_ev
  if ne vev_scan n 0
    v_write_all 2 tve_n_skip
    ret false
  end
  t1 = and ge get vev_scanned 0 70 and eq get vev_cnt 0 16 eq get vev_trunc 0 1
  tve_chk and t1 ge get vev_matched 0 50 tve_e1
  ok2 = false
  if eq vev_load_txt tve_r_pr 0
    t2 = and eq tve_scope VEV_REC VEV_SCOPE_HOST and eq get vev_rn VEV_REC 1 eq vev_rs_get VEV_REC VEV_S_TKNOWN 1
    t2b = and eq vev_rs_get VEV_REC VEV_S_DIRTY 0 tve_feq VEV_REC VEV_F_COMMIT tve_r_c7
    ok2 = and and t2 t2b tve_fhas VEV_REC VEV_F_CLAIM tve_r_prfail
  end
  tve_chk ok2 tve_e2
  ok3 = false
  if eq vev_load_txt tve_r_sil 0
    ok3 = and eq tve_scope VEV_REC VEV_SCOPE_SILICON eq get vev_rn VEV_REC 1
  end
  tve_chk ok3 tve_e3
  ok4 = false
  if eq vev_load_txt tve_r_st 0
    ok4 = eq tve_scope VEV_REC VEV_SCOPE_HOST
  end
  tve_chk ok4 tve_e4
  ret true
end

fn tve_real_tree2 to void
  ok5 = false
  if eq vev_load_txt tve_r_ver 0
    t5 = and eq vev_rs_get VEV_REC VEV_S_GRUN 10 eq vev_rs_get VEV_REC VEV_S_GPASS 10
    ok5 = and t5 tve_feq VEV_REC VEV_F_COMMIT tve_r_c8033
  end
  tve_chk ok5 tve_e5
  ok6 = false
  if eq vev_load_txt tve_r_bw 0
    ok6 = ne tve_scope VEV_REC VEV_SCOPE_SILICON
  end
  tve_chk ok6 tve_e6
  ok7 = false
  if eq vev_load_txt tve_r_a64 0
    ok7 = and eq tve_scope VEV_REC VEV_SCOPE_QEMU tve_feq VEV_REC VEV_F_BASIS tve_r_qt
  end
  tve_chk ok7 tve_e7
  ok8 = false
  if eq vev_load_txt tve_r_syn 0
    ok8 = eq tve_scope VEV_REC VEV_SCOPE_UNKNOWN
  end
  tve_chk ok8 tve_e8
end

fn main to int
  put tve_pass_n 0 0
  put tve_tot 0 0
  tve_c_fixtures
  tve_c_loads
  tve_c_for_id
  tve_c_render
  tve_check_large_tree
  if tve_real_tree
    tve_real_tree2
  end
  ob_reset 256
  p = get tve_pass_n 0
  t = get tve_tot 0
  if eq p t
    ob_puts tve_pass
  else
    ob_puts tve_failw
  end
  ob_put_u64 p
  ob_putc uchar 47
  ob_put_u64 t
  ob_putc uchar 10
  ob_write_fd 1
  if eq p t
    ret 0
  end
  ret 1
end

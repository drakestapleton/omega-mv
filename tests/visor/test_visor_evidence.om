global tve_pass_n ulong 1
global tve_tot ulong 1
global tve_txt uchar 65536
global tve_txtl ulong 1
global tve_rb uchar 65536
global tve_rbl ulong 1
global tve_path uchar 4096
global tve_pl ulong 1
global tve_root uchar 512
global tve_rootl ulong 1
global tve_ascp uchar 600
global tve_ascl ulong 1
global tve_descp uchar 600
global tve_descl ulong 1

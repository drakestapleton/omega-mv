note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/visor/test_visor_world.c (lane 6: read-only World view).
note Composes src/visor/visor.om and src/visor/visor_world.om.
om2

text vw_pass "PASS test_visor_world (pure OM-2)\n"
text vw_fail "FAIL test_visor_world (pure OM-2)\n"

text vw_s_unatt "world: unattached"
text vw_s_nolink "does not link the runtime"
text vw_s_jatt_f "\"attached\":false"
text vw_s_jatt_t "\"attached\":true"
text vw_s_jauth_f "\"authority\":false"
text vw_s_jstv_f "\"staged_effects_visible\":false"
text vw_s_jgen_f "\"generation_observable\":false"
text vw_s_notvis "(not visible)"
text vw_s_genno "generation:         (not observable)"
text vw_s_quiescent "quiescent"
text vw_s_gap_gen "generation not exposed by runtime"
text vw_s_gap_pub "published results not observable"
text vw_s_gap_trunc "truncated to 32 of 42 resident objects; quiescent"
text vw_s_trunc "truncated"
text vw_s_dig "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
text vw_s_id0 "rx:0@1"
text vw_s_id1 "rx:1@1"
text vw_s_id2 "rx:2@1"
text vw_s_k0 "RESIDENT"
text vw_s_k1 "EPHEMERAL"
text vw_s_k2 "DURABLE"
text vw_s_st "live"
text vw_s_stp "live,placed"

global g_vw_fail ulong 1

fn vw_chk cond bool to void
  if not cond
    put g_vw_fail 0 add get g_vw_fail 0 1
  end
end

fn vw_ob_contains pat view uchar * to bool
  blen = get v_ob_len 0
  plen = len pat
  if or eq plen 0 gt plen blen
    ret false
  end
  lim = add sub blen plen 1
  for i ulong lim bound 8192
    ok = true
    for j ulong plen bound 128
      if ne get v_ob add i j get pat j
        ok = false
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn vw_gap_contains pat view uchar * to bool
  glen = get vwld_glen 0
  plen = len pat
  if or eq plen 0 gt plen glen
    ret false
  end
  lim = add sub glen plen 1
  for i ulong lim bound 256
    ok = true
    for j ulong plen bound 64
      if ne get vwld_gap add i j get pat j
        ok = false
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn vw_copy_ob dst edit uchar * cap ulong to ulong
  n = get v_ob_len 0
  if gt n cap
    n = cap
  end
  for i ulong n bound 8192
    put dst i get v_ob i
  end
  ret n
end

fn vw_ob_eq_buf buf view uchar * n ulong to bool
  if ne get v_ob_len 0 n
    ret false
  end
  for i ulong n bound 8192
    if ne get v_ob i get buf i
      ret false
    end
  end
  ret true
end

fn vw_set_oid slot ulong s view uchar * to void
  ol = len s
  for i ulong ol bound 72
    put vwld_oid add mul slot 72 i get s i
  end
  put vwld_oidl slot ol
end

fn vw_set_okind slot ulong s view uchar * to void
  kl = len s
  for i ulong kl bound 32
    put vwld_okind add mul slot 32 i get s i
  end
  put vwld_okl slot kl
end

fn vw_set_ostate slot ulong s view uchar * to void
  sl = len s
  for i ulong sl bound 32
    put vwld_ostate add mul slot 32 i get s i
  end
  put vwld_osl slot sl
end

fn vw_populate_attached to void
  vwld_reset
  put vwld_attached 0 1
  sl = len vw_s_quiescent
  for i ulong sl bound 64
    put vwld_state i get vw_s_quiescent i
  end
  put vwld_slen 0 sl
  put vwld_res_cnt 0 3
  put vwld_obj_cnt 0 3
  put vwld_rxn_cnt 0 0
  put vwld_act_cnt 0 0
  put vwld_pub_cnt 0 0
  put vwld_staged 0 0
  put vwld_staged_vis 0 0
  put vwld_pub_tail 0 0
  dl = len vw_s_dig
  for i ulong dl bound 72
    put vwld_digest i get vw_s_dig i
  end
  put vwld_dlen 0 dl
  vw_set_oid 0 vw_s_id0
  vw_set_okind 0 vw_s_k0
  vw_set_ostate 0 vw_s_stp
  vw_set_oid 1 vw_s_id1
  vw_set_okind 1 vw_s_k1
  vw_set_ostate 1 vw_s_st
  vw_set_oid 2 vw_s_id2
  vw_set_okind 2 vw_s_k2
  vw_set_ostate 2 vw_s_st
  vwld_append_gap vw_s_gap_gen
  vwld_append_gap vw_s_gap_pub
end

fn vw_test_unattached to void
  snap = new uchar 4096 0
  vwld_unattached
  a = vwld_format_text 4096
  vw_chk gt a 0
  n1 = vw_copy_ob snap 4096
  b = vwld_format_text 4096
  vw_chk eq a b
  vw_chk vw_ob_eq_buf snap n1
  vw_chk vw_ob_contains vw_s_unatt
  vw_chk vw_ob_contains vw_s_nolink
  j = vwld_format_json 4096
  vw_chk gt j 0
  vw_chk vw_ob_contains vw_s_jatt_f
  vw_chk vw_ob_contains vw_s_jauth_f
  vw_chk eq get vwld_attached 0 0
  vw_chk eq get vwld_staged_vis 0 0
  vw_chk eq get vwld_generation 0 0
end

fn vw_test_attached to void
  snap = new uchar 4096 0
  vw_populate_attached
  a = vwld_format_text 4096
  vw_chk gt a 0
  n1 = vw_copy_ob snap 4096
  b = vwld_format_text 4096
  vw_chk eq a b
  vw_chk vw_ob_eq_buf snap n1
  vw_chk eq get vwld_attached 0 1
  vw_chk eq get vwld_obj_cnt 0 3
  vw_chk eq get vwld_res_cnt 0 3
  vw_chk eq get vwld_rxn_cnt 0 0
  vw_chk eq get vwld_act_cnt 0 0
  vw_chk vw_ob_contains vw_s_id0
  vw_chk vw_ob_contains vw_s_id1
  vw_chk vw_ob_contains vw_s_id2
  vw_chk vw_ob_contains vw_s_k0
  vw_chk vw_ob_contains vw_s_k1
  vw_chk vw_ob_contains vw_s_k2
  vw_chk vw_ob_contains vw_s_notvis
  vw_chk vw_ob_contains vw_s_genno
  vw_chk vw_ob_contains vw_s_dig

  j = vwld_format_json 4096
  vw_chk gt j 0
  vw_chk vw_ob_contains vw_s_jatt_t
  vw_chk vw_ob_contains vw_s_jstv_f
  vw_chk vw_ob_contains vw_s_jgen_f
  vw_chk vw_ob_contains vw_s_jauth_f

  note Retired object disappears from view
  vw_set_oid 1 vw_s_id2
  vw_set_okind 1 vw_s_k2
  vw_set_ostate 1 vw_s_st
  put vwld_obj_cnt 0 2
  put vwld_res_cnt 0 2
  vw_chk gt vwld_format_text 4096 0
  vw_chk vw_ob_contains vw_s_id0
  vw_chk not vw_ob_contains vw_s_id1
  vw_chk vw_ob_contains vw_s_id2
end

fn vw_test_bounds_overflow to void
  vw_populate_attached
  put vwld_res_cnt 0 42
  put vwld_obj_cnt 0 VWLD_MAX_OBJECTS
  for i ulong VWLD_MAX_OBJECTS
    vw_set_oid i vw_s_id0
    vw_set_okind i vw_s_k1
    vw_set_ostate i vw_s_st
  end
  vwld_append_gap vw_s_gap_trunc
  vw_chk eq get vwld_obj_cnt 0 32
  vw_chk eq get vwld_res_cnt 0 42
  vw_chk vw_gap_contains vw_s_trunc
  vw_chk vw_gap_contains vw_s_quiescent
  vw_chk gt vwld_format_text 8192 0
  vw_chk gt vwld_format_json 8192 0

  note Output that does not fit fails closed (-1 and v_ob_len == 0)
  vw_chk eq vwld_format_text 16 -1
  vw_chk eq get v_ob_len 0 0
  vw_chk eq vwld_format_json 16 -1
  vw_chk eq get v_ob_len 0 0
  vw_chk eq vwld_format_text 0 -1
  vw_chk eq vwld_format_json 0 -1

  note Gap append saturates safely at 255 bytes
  for k ulong 10
    vwld_append_gap vw_s_dig
  end
  vw_chk le get vwld_glen 0 255
end

fn main to int
  put g_vw_fail 0 0
  vw_test_unattached
  vw_test_attached
  vw_test_bounds_overflow
  if eq get g_vw_fail 0 0
    ign = write 1 vw_pass 0 len vw_pass
    ret 0
  end
  ign = write 1 vw_fail 0 len vw_fail
  ret 1
end

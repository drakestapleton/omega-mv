note Pure seeded OM-2 port of tests/visor/test_visor_realization.c: the same 65 checks, in order,
note with the same messages. Slots: machine graph 0 spark, 1 qemu; entries e 0, ebad 1, ep 2,
note alte 3..6, bad 7, unk 8, bw 9, bw2 10, br 11, bp 12, nr 13; views v 0, vbad 1, vp 2,
note alt1 3..6, alt2 7..10, altv 11..14, rv 15, vbw 16, cost c 17; programs p 0, unreal 1,
note m3 2, s2 3, aff 4. b1/b2 are the formatted output buffers (16384 bytes, as in C).

global tv_pass ulong 1
global tv_total ulong 1
global tv_b1 uchar 16384
global tv_b1n ulong 1
global tv_opidx ulong 1

text tv_fail "FAIL: "
text tv_where " (tests/visor/test_visor_realization.om)\n"
text tv_pass_t "PASS "
text tv_fail_t "FAIL "

fn tv_check ok bool msg view uchar * to void
  put tv_total 0 add get tv_total 0 1
  if ok
    put tv_pass 0 add get tv_pass 0 1
    ret
  end
  v_write_all 2 tv_fail
  v_write_all 2 msg
  v_write_all 2 tv_where
end

note substring t in v_ob[0..len)
fn tv_ob_has t view uchar * to bool
  n = get v_ob_len 0
  m = len t
  if gt m n
    ret false
  end
  lim = add sub n m 1
  for i ulong lim bound 65536
    ok = true
    for j ulong m bound 256
      if ne get v_ob add i j get t j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn tv_fbyte v ulong f ulong i ulong to ulong
  ret vrv_byte v f i
end

note substring t in view field f of v
fn tv_field_has v ulong f ulong t view uchar * to bool
  n = vrv_len v f
  m = len t
  if gt m n
    ret false
  end
  lim = add sub n m 1
  for i ulong lim bound 256
    ok = true
    for j ulong m bound 256
      if ne tv_fbyte v f add i j ulong get t j
        ok = false
        break
      end
    end
    if ok
      ret true
    end
  end
  ret false
end

fn tv_field_is v ulong f ulong t view uchar * to bool
  if ne vrv_len v f len t
    ret false
  end
  ret tv_field_has v f t
end

fn tv_save_b1 to void
  n = get v_ob_len 0
  for i ulong n bound 16384
    put tv_b1 i get v_ob i
  end
  put tv_b1n 0 n
end

fn tv_ob_eq_b1 to bool
  n = get v_ob_len 0
  if ne n get tv_b1n 0
    ret false
  end
  for i ulong n bound 16384
    if ne get v_ob i get tv_b1 i
      ret false
    end
  end
  ret true
end

fn tv_ob_first to ulong
  if eq get v_ob_len 0 0
    ret 0
  end
  ret ulong get v_ob 0
end

note make_apply(g, op, ov, width): the apply object; the operation object in tv_opidx
fn tv_make_apply op ulong ov ulong w ulong to ulong
  t = ulong og_build_type_uint w
  a = ulong og_build_val_uint t w 7
  b = ulong og_build_val_uint t w 11
  o = ulong og_build_op_binary op ov t
  put tv_opidx 0 o
  ret ulong og_build_apply o a b
end

fn tv_id_is_obj_e e ulong k ulong idx ulong to bool
  b = vre_ib e k
  for i ulong 32
    if ne get vre_ids add b i get v_og_id add mul idx 32 i
      ret false
    end
  end
  ret true
end

fn tv_id_is_obj_r r ulong k ulong idx ulong to bool
  b = vro_ib r k
  for i ulong 32
    if ne get vro_id add b i get v_og_id add mul idx 32 i
      ret false
    end
  end
  ret true
end

text tv_m1 "graph"
text tv_m2 "realize 7+11 apply"
text tv_m3 "direct apply entry verdict compatible"
text tv_m4 "subject = apply id"
text tv_m5 "realized = op id"
text tv_m6 "subject and realized both shown, distinct"
text tv_m7 "entry machine/target"
text tv_m8 "disasm"
text tv_m9 "run_pure(7,11)==18"
text tv_m10 "(2^64-1)+1 wraps to 0"
text tv_m11 "argc>3 refused"
text tv_m12 "compatible + runnable"
text tv_s_add "add x0, x0, x1"
text tv_s_ret "ret"

fn tv_part1 to void
  tv_check eq get v_og_cnt 0 0 tv_m1
  ap = tv_make_apply V_OP_ADD V_OVF_WRAP 64
  opi = get tv_opidx 0
  og_tmp_from_obj ap
  tv_check eq vrl_realize_apply 0 0 0 0 tv_m2
  tv_check and eq vre_g 0 VE_VK 1 eq vre_g 0 VE_COMPAT 1 tv_m3
  tv_check tv_id_is_obj_e 0 0 ap tv_m4
  tv_check tv_id_is_obj_r vre_r 0 VRO_K_SEM opi tv_m5
  tv_check not vrv_feq 0 VF_SID 0 VF_ZID tv_m6
  tv_check and and eq vre_g 0 VE_HASEM 1 eq vre_g 0 VE_HASEST 1 vre_tn_is 0 vrl_t_a64 tv_m7
  d = and eq vrv_g 0 VW_DCNT 2 tv_field_has 0 VF_DIS tv_s_add
  tv_check and d tv_field_has 0 add VF_DIS 1 tv_s_ret tv_m8
  r1 = vrl_run_pure 0 2 7 11 0
  tv_check and eq r1 0 eq get vrl_run_out 0 18 tv_m9
  r2 = vrl_run_pure 0 2 18446744073709551615 1 0
  tv_check and eq r2 0 eq get vrl_run_out 0 0 tv_m10
  tv_check eq vrl_run_pure 0 4 18446744073709551615 1 0 -3 tv_m11
  tv_check and eq vrv_g 0 VW_COMPAT 1 eq vrv_g 0 VW_RUN 1 tv_m12
end

text tv_m13 "DIV unsupported"
text tv_m14 "refused view formats safely"
text tv_m15 "SATURATE refused"
text tv_m16 "u32 refused"
text tv_m17 "unknown id refused"
text tv_m18 "TYPE object refused"
text tv_s_div "DIV"
text tv_s_notr "not realized"
text tv_s_ovf "overflow"
text tv_s_w32 "width 32"

fn tv_part2 to void
  dv = tv_make_apply V_OP_DIV V_OVF_WRAP 64
  og_tmp_from_obj dv
  r = vrl_realize_apply 0 1 1
  tv_check and eq r -2 tv_field_has 1 VF_WHY tv_s_div tv_m13
  t1 = vrl_format_text 1 16384
  tv_save_b1
  t2 = vrl_why 1 16384
  ok = and gt t1 0 gt t2 0
  hb = false
  if ok
    for i ulong get tv_b1n 0 bound 16384
      put v_ob i get tv_b1 i
    end
    put v_ob_len 0 get tv_b1n 0
    hb = tv_ob_has tv_s_notr
  end
  tv_check and and ok hb eq vrv_ci 1 2 0 0 tv_m14
  sa = tv_make_apply V_OP_ADD V_OVF_SATURATE 64
  og_tmp_from_obj sa
  r3 = vrl_realize_apply 0 1 1
  tv_check and eq r3 -2 tv_field_has 1 VF_WHY tv_s_ovf tv_m15
  u3 = tv_make_apply V_OP_ADD V_OVF_WRAP 32
  og_tmp_from_obj u3
  r4 = vrl_realize_apply 0 1 1
  tv_check and eq r4 -2 tv_field_has 1 VF_WHY tv_s_w32 tv_m16
  for i ulong 32
    put v_tmp_id i uchar 0x5a
  end
  r5 = vrl_realize_apply 0 1 1
  tv_check and eq r5 -2 gt vrv_len 1 VF_WHY 0 tv_m17
  t64 = ulong og_build_type_uint 64
  og_tmp_from_obj t64
  tv_check eq vrl_realize_apply 0 1 1 -2 tv_m18
end

text tv_m19 "cost"
text tv_m20 "predicted present"
text tv_m21 "estimated present from machine model"
text tv_m22 "measured ABSENT"
text tv_m23 "qualified ABSENT"
text tv_m24 "classes never conflated"
text tv_m25 "absent slots carry no numbers"
text tv_m26 "cost json"
text tv_m27 "cost text"
text tv_s_oml "omega_machine_estimate_latency"
text tv_s_mjson "\"measured\":{\"present\":false"
text tv_s_mabs "measured  ABSENT"
text tv_s_qabs "qualified ABSENT"

fn tv_part3 to void
  tv_check eq vrl_cost 0 0 17 0 tv_m19
  tv_check and and eq vrv_ci 17 0 0 1 eq vrv_ci 17 0 1 0 eq vrv_ci 17 0 3 2 tv_m20
  e1 = and eq vrv_ci 17 1 0 1 eq vrv_ci 17 1 1 1
  tv_check and e1 tv_field_has 17 add VF_SRC 1 tv_s_oml tv_m21
  tv_check and eq vrv_ci 17 2 0 0 eq vrv_ci 17 2 1 2 tv_m22
  tv_check and eq vrv_ci 17 3 0 0 eq vrv_ci 17 3 1 3 tv_m23
  nd = not vrv_feq 17 VF_SRC 17 add VF_SRC 1
  tv_check and nd and eq vrv_ci 17 0 1 0 eq vrv_ci 17 1 1 1 tv_m24
  tv_check and eq vrv_ci 17 2 2 0 eq vrv_ci 17 3 2 0 tv_m25
  j = vrl_cost_format_json 17 16384
  tv_check and gt j 0 tv_ob_has tv_s_mjson tv_m26
  t = vrl_cost_format_text 17 16384
  tv_check and gt t 0 and tv_ob_has tv_s_mabs tv_ob_has tv_s_qabs tv_m27
end

text tv_add5 "add5"
text tv_empty "empty"
text tv_m28 "build add5"
text tv_m29 "realize program"
text tv_m30 "direct program entry verdict compatible"
text tv_m31 "program run 10+5==15"
text tv_m32 "unrealized program refused"

fn tv_part4 to void
  tv_check eq vpg_build_unary 0 tv_add5 V_OP_ADD 5 0 tv_m28
  r = vrl_realize_program 0 0 2 2
  tv_check and eq r 0 eq vre_g 2 VE_SUBJP 1 tv_m29
  tv_check and and eq vre_g 2 VE_VK 1 eq vre_g 2 VE_COMPAT 1 eq vre_g 2 VE_RLEN 0 tv_m30
  r2 = vrl_run_pure 2 1 10 0 0
  tv_check and eq r2 0 eq get vrl_run_out 0 15 tv_m31
  vpg_init 1 tv_empty
  r3 = vrl_realize_program 1 0 2 2
  tv_check and eq r3 -2 gt vrv_len 2 VF_WHY 0 tv_m32
end

text tv_m33 "alternatives count"
text tv_m34 "alternatives again"
text tv_m35 "alternatives deterministic"
text tv_m36 "labels/order"
text tv_m37 "direct alternatives compatible"
text tv_m38 "synth for add5 compiled from the program and agrees"
text tv_m39 "synth for add5 on qemu-virt compatible"
text tv_l0 "direct@dgx-spark"
text tv_l1 "direct@qemu-virt"
text tv_l2 "synth@dgx-spark"
text tv_l3 "synth@qemu-virt"
text tv_s_md "matches direct"
text tv_s_cfp "compiled from the program body"

fn tv_same_alts to bool
  same = true
  for i ulong 4
    u = vrl_format_text add 3 i 16384
    tv_save_b1
    w = vrl_format_text add 7 i 16384
    if not tv_ob_eq_b1
      same = false
    end
    if lt add u w -999
      same = false
    end
  end
  ret same
end

fn tv_part5 to void
  a1 = vrl_alternatives_ex 0 0 VRL_NOMG 3 4
  tv_check and eq a1 0 eq get vrl_cnt 0 4 tv_m33
  a2 = vrl_alternatives_ex 0 0 VRL_NOMG 7 4
  tv_check and eq a2 0 eq get vrl_cnt 0 4 tv_m34
  tv_check tv_same_alts tv_m35
  l01 = and tv_field_is 3 VF_LABEL tv_l0 tv_field_is 4 VF_LABEL tv_l1
  l23 = and tv_field_is 5 VF_LABEL tv_l2 tv_field_is 6 VF_LABEL tv_l3
  tv_check and l01 l23 tv_m36
  tv_check and eq vrv_g 3 VW_COMPAT 1 eq vrv_g 4 VW_COMPAT 1 tv_m37
  c2 = and eq vrv_g 5 VW_COMPAT 1 eq vrv_g 5 VW_RUN 1
  tv_check and c2 and tv_field_has 5 VF_WHY tv_s_md tv_field_has 5 VF_WHY tv_s_cfp tv_m38
  tv_check and eq vrv_g 6 VW_COMPAT 1 eq vrv_g 6 VW_RUN 1 tv_m39
end

text tv_m40 "alternatives_ex count"
text tv_m41 "direct alternative entries compatible"
text tv_m42 "synth entry compatible, machine-bound"
text tv_m43 "synth entry runs 10+5==15"
text tv_m44 "re-viewed incompatible entry: not compatible, not runnable, reason in why"
text tv_m45 "incompatible entry run refused"
text tv_m46 "re-viewed direct entry unchanged"
text tv_m47 "direct alternative entry runs 10+5==15"
text tv_m48 "verdict not evaluated treated as compatible"
text tv_mark "marked incompatible by test"
text tv_s_inc "INCOMPATIBLE"

fn tv_part6 to void
  a = vrl_alternatives_ex 0 0 3 11 4
  tv_check and eq a 0 eq get vrl_cnt 0 4 tv_m40
  d0 = and eq vre_g 3 VE_VK 1 eq vre_g 3 VE_COMPAT 1
  tv_check and d0 and eq vre_g 4 VE_VK 1 eq vre_g 4 VE_COMPAT 1 tv_m41
  tv_check and and eq vre_g 5 VE_VK 1 eq vre_g 5 VE_COMPAT 1 eq vre_g 5 VE_HASEM 1 tv_m42
  r = vrl_run_pure 5 1 10 0 0
  tv_check and eq r 0 eq get vrl_run_out 0 15 tv_m43
  vre_copy 7 5
  vre_p 7 VE_VK 1
  vre_p 7 VE_COMPAT 0
  vsb_reset
  vsb_t tv_mark
  vre_set_ir 7
  r2 = vrl_view 7 0 15
  b1 = and eq r2 0 and eq vrv_g 15 VW_COMPAT 0 eq vrv_g 15 VW_RUN 0
  tv_check and b1 and tv_field_has 15 VF_WHY tv_s_inc tv_field_has 15 VF_WHY tv_mark tv_m44
  tv_check eq vrl_run_pure 7 1 10 0 0 -3 tv_m45
  r3 = vrl_view 3 0 15
  tv_check and and eq r3 0 eq vrv_g 15 VW_COMPAT 1 not tv_field_has 15 VF_WHY tv_s_inc tv_m46
  r4 = vrl_run_pure 3 1 10 0 0
  tv_check and eq r4 0 eq get vrl_run_out 0 15 tv_m47
  vre_copy 8 3
  vre_p 8 VE_VK 0
  vre_p 8 VE_COMPAT 0
  r5 = vrl_run_pure 8 1 10 0 0
  tv_check and eq r5 0 eq get vrl_run_out 0 15 tv_m48
end

text tv_mul3 "mul3"
text tv_sub2 "sub2"
text tv_m49 "compose 3x-2"
text tv_m50 "alternatives 3x-2"
text tv_m51 "synth for 3x-2 matches direct"
text tv_m52 "synth cost view"
text tv_m53 "max respected"

fn tv_part7 to void
  u1 = vpg_build_unary 2 tv_mul3 V_OP_MUL 3
  u2 = vpg_build_unary 3 tv_sub2 V_OP_SUB 2
  tv_check eq vpg_compose 2 3 4 128 0 tv_m49
  a = vrl_alternatives_ex 4 0 VRL_NOMG 7 4
  tv_check and eq a 0 eq get vrl_cnt 0 4 tv_m50
  tv_check and eq vrv_g 9 VW_COMPAT 1 tv_field_has 9 VF_WHY tv_s_md tv_m51
  tv_check and and eq vrv_g 9 VW_INSN 5 eq vrv_ci 9 1 0 1 eq vrv_ci 9 2 0 0 tv_m52
  b = vrl_alternatives_ex 4 0 VRL_NOMG 7 2
  tv_check and eq b 0 eq get vrl_cnt 0 2 tv_m53
  if lt add u1 u2 -999
    ret
  end
end

text tv_m54 "compare"
text tv_m55 "compare never compares absent measured"
text tv_m56 "why"
text tv_m57 "json"
text tv_m58 "text truncation fails closed"
text tv_s_prof "profile"
text tv_s_ident "code           identical"
text tv_s_mab "measured  A=ABSENT B=ABSENT"
text tv_s_srcs "cost sources"
text tv_s_abs "ABSENT"
text tv_s_dis "\"disasm\":["

fn tv_part8 to void
  c = vrl_compare 3 4 16384
  c1 = and gt c 0 and tv_ob_has tv_s_prof tv_ob_has tv_s_oml
  tv_check and c1 tv_ob_has tv_s_ident tv_m54
  tv_check tv_ob_has tv_s_mab tv_m55
  w = vrl_why 0 16384
  w1 = and gt w 0 tv_ob_has tv_s_prof
  tv_check and w1 and tv_ob_has tv_s_srcs tv_ob_has tv_s_abs tv_m56
  j = vrl_format_json 0 16384
  tv_check and and gt j 0 eq tv_ob_first 123 tv_ob_has tv_s_dis tv_m57
  tv_check eq vrl_format_text 0 64 -1 tv_m58
end

text tv_m59 "blackwell target run refused"
text tv_m60 "blackwell view not runnable"
text tv_m61 "blackwell id"
text tv_m62 "blackwell machine id run refused"
text tv_m63 "branch code refused"
text tv_m64 "non-v8a profile refused"
text tv_m65 "missing RET refused"

fn tv_bw2_id to long
  rc = vmch_blackwell_id
  b = vre_ib 10 1
  for i ulong 32
    put vre_ids add b i get vmch_bw_id i
  end
  ret rc
end

fn tv_part9 to void
  vre_copy 9 0
  vre_set_tn 9 vrl_t_bw
  tv_check eq vrl_run_pure 9 2 10 1 0 -3 tv_m59
  r = vrl_view 9 0 16
  tv_check and and eq r 0 eq vrv_g 16 VW_RUN 0 eq vrv_g 16 VW_COMPAT 0 tv_m60
  vre_copy 10 0
  tv_check eq tv_bw2_id 0 tv_m61
  vre_p 10 VE_HASEM 1
  tv_check eq vrl_run_pure 10 2 10 1 0 -3 tv_m62
  vre_copy 11 0
  br = vre_r 11
  vro_p br VRO_CLEN 0
  u1 = vro_put32 br a64b 0
  u2 = vro_put32 br a64ret
  tv_check eq vrl_run_pure 11 2 10 1 0 -3 tv_m63
  vre_copy 12 0
  vro_p vre_r 12 VRO_PROF 2
  tv_check eq vrl_run_pure 12 2 10 1 0 -3 tv_m64
  vre_copy 13 0
  vro_p vre_r 13 VRO_CLEN 4
  tv_check eq vrl_run_pure 13 2 10 1 0 -3 tv_m65
  if lt add u1 u2 -999
    ret
  end
end

fn main to int
  vs_init
  u1 = vmch_build_spark 0
  u2 = vmch_build_qemu 1
  tv_part1
  tv_part2
  tv_part3
  tv_part4
  tv_part5
  tv_part6
  tv_part7
  tv_part8
  tv_part9
  u3 = vrl_format_text 0 16384
  ob_write_fd 1
  ob_reset 65535
  pass = get tv_pass 0
  tot = get tv_total 0
  if eq pass tot
    ob_puts tv_pass_t
  else
    ob_puts tv_fail_t
  end
  ob_put_u64 pass
  ob_putc uchar 47
  ob_put_u64 tot
  ob_putc uchar 10
  ob_write_fd 1
  if lt add add u1 u2 u3 -999
    ret 2
  end
  if eq pass tot
    ret 0
  end
  ret 1
end

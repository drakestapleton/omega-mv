om2
note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & parity test for src/allen/allen_bind.om.

text t_ab_pass "PASS test_allen_bind_om\n"
text t_ab_fail "FAIL test_allen_bind_om\n"
text t_ab_hex "0123456789abcdef"
text t_ab_bad "0123456789abcdez"
text t_ab_path "/tmp/om_w_src9_allen_subj.bin"

fn t_ab_write_and_reload expected_id view uchar 32 to bool
  wb = new uchar 4096 0
  fd = fopen t_ab_path 0 len t_ab_path 577 420
  if lt fd 0
    ret false
  end
  bl = get g_al_buf_len 0
  for i ulong bl bound 4096
    put wb i get g_al_buf i
  end
  ign_w = write int fd wb 0 bl
  ign_c = fclose int fd
  al_subject_reset
  if ne allen_load t_ab_path len t_ab_path 0
    ign_u = unlink t_ab_path 0 len t_ab_path
    ret false
  end
  ign_u = unlink t_ab_path 0 len t_ab_path
  for i ulong 32
    if ne get g_al_subj_id i get expected_id i
      ret false
    end
  end
  ret true
end

fn main to int
  raw = new uchar 8 0
  hx = new uchar 16 0
  expected_id = new uchar 32 0
  ref = new uchar 32 0
  if ne allen_unhex t_ab_hex raw 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 1
  end
  if ne allen_unhex t_ab_bad raw -1
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 2
  end
  allen_hex raw hx
  for i ulong 16
    if ne get hx i get t_ab_hex i
      ign = write 1 t_ab_fail 0 len t_ab_fail
      ret 3
    end
  end
  al_subject_reset
  for i ulong 32
    put g_al_agent i uchar add 160 rem i 16
    put g_al_root i uchar add 10 rem i 16
    put g_al_cortex i uchar add 32 i
    put g_al_prov i uchar add 195 rem i 16
  end
  if ne al_subject_add_intent CS_INTENT_GOAL_LATENCY 7 1000 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 4
  end
  if ne al_subject_encode 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 5
  end
  for i ulong 32
    put expected_id i get g_al_subj_id i
  end
  if not t_ab_write_and_reload expected_id
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 6
  end
  note Tamper format version at byte 8 and verify decode refuses with err 3
  put g_al_buf 8 1
  if eq al_subject_decode get g_al_buf_len 0 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 7
  end
  if ne get g_al_err 0 3
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 8
  end
  put g_al_buf 8 0
  if ne al_subject_decode get g_al_buf_len 0 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 8
  end
  put g_al_cx_n 0 0
  if ne allen_lineage ref -1
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 9
  end
  if ne allen_check_memory -2
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 10
  end
  put g_al_cx_n 0 1
  for i ulong 32
    put g_al_cx_gen_dig i uchar add 99 i
  end
  if ne allen_check_memory -3
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 11
  end
  for i ulong 32
    put g_al_cx_gen_dig i get g_al_cortex i
  end
  if ne allen_lineage ref 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 12
  end
  if ne allen_check_memory 0
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 13
  end
  allen_bind_identity 7
  if or ne get g_al_bind_ext_subj 0 7 ne get g_al_bind_seq 0 1
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 14
  end
  nm = allen_goal_mutations 0 42 5
  if or ne nm 4 ne get g_al_mut_val 0 5
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 15
  end
  if or ne get g_al_mut_val 1 7 ne get g_al_mut_val 2 1000
    ign = write 1 t_ab_fail 0 len t_ab_fail
    ret 16
  end
  ign = write 1 t_ab_pass 0 len t_ab_pass
  ret 0
end

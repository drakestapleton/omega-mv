note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_api_2_host.om: CPU-only host unit, contract, codegen wiring,
note param-packing, QMD invariant, and fail-closed negative-control suite for
note   src/omega_gpu_fp8gemm_api.om
note   src/omega_gpu_gdn_api.om
note   src/omega_gpu_prefill_attn_api.om
note   src/omega_gpu_prefill_attn256_api.om
note Strictly CPU-only: ZERO /dev/nvidia* access.
om2

text gapi2_pass "PASS test-gb10-api-2-host (fp8gemm + gdn + prefill_attn + prefill_attn256 CPU-only QMD+codegen+contract)\n"
text gapi2_fail "FAIL test-gb10-api-2-host code="
text gapi2_nl "\n"

fn gapi2_print s view uchar * to void
  r = write 1 s 0 len s
end

fn gapi2_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn test_fp8gemm_a to ulong
  fgem_reset_all
  nb = new uchar 32 0
  if ne fgem_rc_name FGEM_OK nb 2
    ret 10
  end
  if ne fgem_rc_name FGEM_TOO_LARGE nb 9
    ret 11
  end
  if ne fgem_rc_name -99 nb 7
    ret 12
  end
  sh = new uint 3 0
  fgem_shape_for 2048 sh
  if or ne get sh 0 4 or ne get sh 1 16 ne get sh 2 16
    ret 13
  end
  fgem_shape_for 768 sh
  if ne get sh 2 8
    ret 14
  end
  if ne fgem_cta_budget_for 64 2
    ret 15
  end
  if ne fgem_cta_budget_for 16 12
    ret 16
  end
  if ne fgem_cta_budget_for 4 96
    ret 17
  end
  fgem_set_cta_budget 32
  if ne fgem_cta_budget_for 64 32
    ret 18
  end
  fgem_set_cta_budget 0
  sp = new ulong 8 0
  put sp 0 2048
  put sp 1 16
  put sp 2 4
  put sp 3 16
  decl = new uint 1 0
  if ne fgem_kernel_fits sp decl FGEM_OK
    ret 19
  end
  if or eq get decl 0 0 ne rem get decl 0 8 0
    ret 20
  end
  put sp 0 0
  if ne fgem_kernel_fits sp decl FGEM_CODEGEN_FAIL
    ret 21
  end
  eb = new uchar 160 0
  if eq fgem_last_error eb 0
    ret 22
  end
  if ne fgem_prepare 2048 FGEM_OK
    ret 23
  end
  if ne fgem_prepare_shape 2048 16 4 1 FGEM_OK
    ret 24
  end
  if ne fgem_prepare_shape 2048 16 8 1 FGEM_BAD_ARGS
    ret 25
  end
  ret 0
end

fn test_fp8gemm_b to ulong
  rreq = new ulong 12 0
  put rreq 0 128
  put rreq 1 4096
  put rreq 2 2048
  put rreq 3 32
  put rreq 4 16
  put rreq 5 0x330000000
  put rreq 6 0x330100000
  put rreq 7 0x330200000
  put rreq 8 0x330300000
  put rreq 9 0x330400000
  put rreq 10 4
  put rreq 11 0
  args = new uint 12 0
  launch = new ulong 8 0
  qmd = new uint 96 0
  if ne fgem_record rreq args launch qmd FGEM_OK
    ret 26
  end
  if ne get launch 7 1
    ret 27
  end
  if ne get launch 6 12
    ret 28
  end
  if or ne get launch 2 512 or ne get launch 3 12 ne get launch 4 16
    ret 29
  end
  if ne get launch 5 8192
    ret 30
  end
  if or ne get args 6 4096 ne get args 7 192
    ret 31
  end
  put rreq 9 0
  if ne fgem_record rreq args launch qmd FGEM_BAD_ARGS
    ret 32
  end
  put rreq 8 0
  put rreq 3 1025
  if ne fgem_record rreq args launch qmd FGEM_TOO_LARGE
    ret 33
  end
  put rreq 3 32
  put rreq 4 257
  if ne fgem_record rreq args launch qmd FGEM_TOO_LARGE
    ret 34
  end
  ret 0
end

fn test_fp8gemm_c to ulong
  xin = new f32 256 0.0
  xout = new f32 256 0.0
  put xin 8 f32 1.5
  fgem_permute_x xin 256 8 xout
  expected = mul f32 1.5 bitcast f32 uint 0x5f800000
  if ne bitcast uint get xout 4 bitcast uint expected
    ret 35
  end
  preq = new uint 5 0
  put preq 0 128
  put preq 1 4096
  put preq 2 2048
  put preq 3 6
  put preq 4 6
  pairs = new uint 12 0
  put pairs 0 1
  put pairs 1 0
  put pairs 2 1
  put pairs 3 1
  put pairs 4 1
  put pairs 5 2
  put pairs 6 1
  put pairs 7 3
  put pairs 8 1
  put pairs 9 4
  put pairs 10 3
  put pairs 11 5
  info = new ulong 13 0
  qmd = new uint 96 0
  if ne fgem_gemm_f32 preq pairs info qmd FGEM_OK
    ret 36
  end
  if or ne get info 1 2 ne get info 9 1
    ret 37
  end
  if ne fgem_gemm_bf16 preq pairs info qmd FGEM_OK
    ret 38
  end
  put pairs 10 0
  if ne fgem_gemm_f32 preq pairs info qmd FGEM_BAD_ARGS
    ret 39
  end
  fgem_set_shape 4 16
  fgem_test_set_mutant 1
  fgem_test_set_mutant 0
  fgem_cache_clear
  ret 0
end

fn test_gdn_pack_a to ulong
  gdn_api_reset_globals
  nb = new uchar 32 0
  if ne gdn_api_rc_name GDN_API_OK nb 2
    ret 40
  end
  if ne gdn_api_rc_name GDN_API_CODEGEN_FAIL nb 12
    ret 41
  end
  if ne gdn_api_rc_name -99 nb 1
    ret 42
  end
  psrc = new f32 32960 0.0
  put psrc 32800 f32 0.5
  for d ulong 128
    put psrc add 32832 d f32 1.0
  end
  pblk = new uchar 132096 0
  if ne gdn_api_pack_params_r 2 psrc pblk 0
    ret 43
  end
  b0 = uint get pblk 131072
  b1 = uint get pblk 131073
  b2 = uint get pblk 131074
  b3 = uint get pblk 131075
  if ne or or b0 shl b1 8 or shl b2 16 shl b3 24 0xbf800000
    ret 44
  end
  if ne gdn_api_pack_params_r 9 psrc pblk -1
    ret 45
  end
  ret 0
end

fn test_gdn_pack_b to ulong
  t_in = new f32 18432 0.0
  t_out = new f32 18432 0.0
  t_dev = new f32 24576 0.0
  put t_in 5 f32 3.25
  put t_in 6149 f32 -2.5
  if ne gdn_api_pack_tail_r 1 t_in t_dev 0
    ret 46
  end
  if ne gdn_api_unpack_tail_r 1 t_dev t_out 0
    ret 47
  end
  if or ne bitcast uint get t_out 5 bitcast uint f32 3.25 ne bitcast uint get t_out 6149 bitcast uint f32 -2.5
    ret 48
  end
  ret 0
end

fn test_gdn_pack_c to ulong
  t_in2 = new f32 24576 0.0
  t_out2 = new f32 24576 0.0
  t_dev2 = new f32 49152 0.0
  put t_in2 0 f32 1.0
  if ne gdn_api_pack_tail_r 2 t_in2 t_dev2 0
    ret 49
  end
  put t_dev2 1536 f32 2.0
  if ne gdn_api_unpack_tail_r 2 t_dev2 t_out2 -1
    ret 50
  end
  ret 0
end

fn test_gdn_decode to ulong
  hid = new ulong 1 0
  if ne gdn_api_alloc 4 hid GDN_API_OK
    ret 51
  end
  h = get hid 0
  qmd = new uint 96 0
  if ne gdn_api_reset h qmd GDN_API_OK
    ret 52
  end
  if ne gdn_api_set_layer h 0 GDN_API_OK
    ret 53
  end
  if ne gdn_api_set_layer h 4 GDN_API_BAD_ARGS
    ret 54
  end
  if ne gdn_api_set_state h 0 1 1 qmd GDN_API_OK
    ret 55
  end
  if ne gdn_api_get_state h 0 1 1 qmd GDN_API_OK
    ret 56
  end
  if ne gdn_api_read_out h 1 GDN_API_OK
    ret 57
  end
  sreq = new ulong 6 0
  put sreq 0 h
  put sreq 1 0
  put sreq 2 0
  put sreq 3 0x360000000
  put sreq 4 0x360100000
  put sreq 5 0x360200000
  scales = new f32 4 1.0
  put scales 0 f32 0.000001
  put scales 1 f32 0.000001
  dargs = new uint 18 0
  if ne gdn_api_step_or_record sreq scales dargs qmd GDN_API_OK
    ret 58
  end
  put sreq 2 1
  if ne gdn_api_step_or_record sreq scales dargs qmd GDN_API_OK
    ret 59
  end
  put scales 0 bitcast f32 uint 0x7fc00000
  if ne gdn_api_step_or_record sreq scales dargs qmd GDN_API_BAD_ARGS
    ret 60
  end
  gdn_api_free h
  ret 0
end

fn test_gdn_multi_pf to ulong
  hid = new ulong 1 0
  if ne gdn_api_alloc 4 hid GDN_API_OK
    ret 61
  end
  h = get hid 0
  if ne gdn_api_multi_prepare h GDN_API_OK
    ret 61
  end
  scales = new f32 4 1.0
  put scales 0 f32 0.000001
  put scales 1 f32 0.000001
  qmd = new uint 96 0
  mreq = new ulong 10 0
  put mreq 0 h
  put mreq 1 0
  put mreq 2 0x361000000
  put mreq 3 0x361100000
  put mreq 4 0x361200000
  put mreq 5 0x361300000
  put mreq 6 4
  put mreq 7 40960
  put mreq 8 384
  put mreq 9 24576
  margs = new uint 22 0
  if ne gdn_api_multi_record mreq scales margs qmd GDN_API_OK
    ret 62
  end
  put mreq 2 0x361000004
  if ne gdn_api_multi_record mreq scales margs qmd GDN_API_BAD_ARGS
    ret 63
  end
  gdn_api_free h
  ret 0
end

fn test_gdn_prefill to ulong
  hid = new ulong 1 0
  if ne gdn_api_alloc 4 hid GDN_API_OK
    ret 64
  end
  h = get hid 0
  scales = new f32 4 1.0
  put scales 0 f32 0.000001
  put scales 1 f32 0.000001
  qmd = new uint 96 0
  pfreq = new ulong 7 0
  put pfreq 0 h
  put pfreq 1 0
  put pfreq 2 8
  put pfreq 3 1
  put pfreq 4 0x360000000
  put pfreq 5 0x360100000
  put pfreq 6 0x360200000
  pfargs = new uint 36 0
  if ne gdn_api_prefill_core pfreq scales pfargs qmd GDN_API_TOO_LARGE
    ret 64
  end
  if ne gdn_api_prefill_reserve h 16 GDN_API_OK
    ret 65
  end
  put pfreq 3 0
  if ne gdn_api_prefill_core pfreq scales pfargs qmd GDN_API_OK
    ret 66
  end
  put pfreq 3 1
  if ne gdn_api_prefill_core pfreq scales pfargs qmd GDN_API_OK
    ret 67
  end
  if ne gdn_api_prefill_read_out h 8 1 GDN_API_OK
    ret 68
  end
  put pfreq 2 2
  put pfreq 3 0
  if ne gdn_api_prefill_core pfreq scales pfargs qmd GDN_API_BAD_ARGS
    ret 69
  end
  gdn_api_test_set_mutant 1
  gdn_api_test_set_mutant 0
  gdn_api_free h
  ret 0
end

fn test_pattn_a to ulong
  pattn_api_init
  if ne pattn_api_kv_mirror_available 1
    ret 110
  end
  sp = new ulong 4 0
  put sp 0 8
  put sp 2 ulong PATTN_API_MODE_APPEND
  gprs = new uint 1 0
  if eq pattn_api_encode sp gprs 0
    ret 111
  end
  ret 0
end

fn test_pattn_b to ulong
  cview = new ulong 6 0
  put cview 0 0x3d0000000
  put cview 1 0x3d1000000
  put cview 2 0x3d2000000
  put cview 3 0x3d3000000
  put cview 4 0x3d4000000
  put cview 5 2048
  req = new ulong 8 0
  put req 0 0
  put req 1 0
  put req 2 32
  put req 3 0x3e0000000
  put req 4 0x3e1000000
  put req 5 ulong bitcast uint f32 0.000001
  put req 6 ulong bitcast uint f32 1.0
  put req 7 1
  info = new ulong 8 0
  qmd = new uint 96 0
  if ne pattn_api_prefill req cview info qmd PATTN_API_OK
    ret 112
  end
  if or ne get info 3 2 or ne get info 4 4 or ne get info 5 4 ne get info 6 256
    ret 113
  end
  mview = new ulong 5 0
  if ne pattn_api_kv_mirror_view 0x3d0000000 2048 mview PATTN_API_OK
    ret 114
  end
  if ne get mview 4 32
    ret 115
  end
  pattn_api_kv_mirror_invalidate 0x3d0000000 2048 16
  if ne pattn_api_kv_mirror_view 0x3d0000000 2048 mview PATTN_API_OK
    ret 116
  end
  if ne get mview 4 16
    ret 117
  end
  pattn_api_kv_mirror_forget 0x3d0000000 2048
  if ne pattn_api_kv_mirror_view 0x3d0000000 2048 mview PATTN_API_BAD_ARGS
    ret 118
  end
  ret 0
end

fn test_pattn_c to ulong
  cview = new ulong 6 0
  put cview 0 0x3d0000000
  put cview 1 0x3d1000000
  put cview 2 0x3d2000000
  put cview 3 0x3d3000000
  put cview 4 0x3d4000000
  put cview 5 2048
  req = new ulong 8 0
  put req 2 32
  put req 3 0x3e0000004
  put req 4 0x3e1000000
  put req 5 ulong bitcast uint f32 0.000001
  put req 6 ulong bitcast uint f32 1.0
  info = new ulong 8 0
  qmd = new uint 96 0
  if ne pattn_api_prefill_dev req cview info qmd PATTN_API_BAD_ARGS
    ret 119
  end
  put req 3 0x3e0000000
  put req 2 100
  pattn_api_set_fused 1
  if ne pattn_api_prefill_dev req cview info qmd PATTN_API_OK
    ret 120
  end
  if ne get info 3 2
    ret 121
  end
  lns = new ulong 8 0
  if ne pattn_api_test_launch_ns lns 8 2
    ret 122
  end
  put req 1 2000
  if ne pattn_api_prefill_dev req cview info qmd PATTN_API_BAD_ARGS
    ret 123
  end
  pattn_api_set_fused 0
  pattn_api_set_kv_mirror 0
  pattn_api_set_kv_mirror 1
  pattn_api_test_set_mirror_per_call 1
  pattn_api_test_set_mirror_per_call 0
  pattn_api_set_warps 4
  pattn_api_set_warps 0
  pattn_api_test_set_mutant 1
  pattn_api_test_set_mutant 0
  pattn_api_release
  ret 0
end

fn test_pa256_a to ulong
  pa256_api_init
  gprs = new uint 1 0
  if eq pa256_api_encode PA256_API_KK_PREP gprs 0
    ret 130
  end
  if eq pa256_api_encode PA256_API_KK_ATTEND gprs 0
    ret 131
  end
  if ne pa256_api_encode 2 gprs 0
    ret 132
  end
  ret 0
end

fn test_pa256_b to ulong
  cview = new ulong 11 0
  put cview 0 0x3f0000000
  put cview 1 0x3f1000000
  put cview 2 0x3f2000000
  put cview 3 0x3f3000000
  put cview 4 0x3f4000000
  put cview 5 0x3f5000000
  put cview 6 0x3f6000000
  put cview 7 4096
  put cview 8 24
  put cview 9 4
  put cview 10 6
  req = new ulong 9 0
  put req 2 16
  put req 4 1
  put req 5 0x3f7000000
  put req 6 0x3f8000000
  put req 7 ulong bitcast uint f32 0.000001
  put req 8 ulong bitcast uint f32 1.0
  info = new ulong 6 0
  qmd = new uint 96 0
  if ne pa256_api_prefill_record req cview info qmd PA256_API_TOO_LARGE
    ret 133
  end
  if ne pa256_api_reserve 64 PA256_API_OK
    ret 134
  end
  if ne pa256_api_prefill_record req cview info qmd PA256_API_OK
    ret 135
  end
  if or ne get info 3 16 or ne get info 4 2 ne get info 5 2
    ret 136
  end
  put req 2 65
  if ne pa256_api_prefill_record req cview info qmd PA256_API_TOO_LARGE
    ret 137
  end
  put req 2 16
  put req 4 0
  put req 5 0x3f7000004
  if ne pa256_api_prefill_dev req cview info qmd PA256_API_BAD_ARGS
    ret 138
  end
  put req 5 0x3f7000000
  if ne pa256_api_prefill_dev req cview info qmd PA256_API_OK
    ret 139
  end
  put req 3 1
  if ne pa256_api_prefill req cview info qmd PA256_API_OK
    ret 140
  end
  sh36 = new uint 3 0
  put sh36 0 16
  put sh36 1 2
  put sh36 2 4
  if ne pa256_api_reserve_for sh36 32 PA256_API_OK
    ret 141
  end
  pa256_api_test_set_mutant 1 1
  pa256_api_test_set_mutant 0 0
  pa256_api_release
  ret 0
end

fn run_step rc ulong to ulong
  if ne rc 0
    gapi2_print gapi2_fail
    gapi2_print_u rc
    gapi2_print gapi2_nl
  end
  ret rc
end

fn main to int
  rc = run_step test_fp8gemm_a
  if ne rc 0
    ret int rc
  end
  rc = run_step test_fp8gemm_b
  if ne rc 0
    ret int rc
  end
  rc = run_step test_fp8gemm_c
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_pack_a
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_pack_b
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_pack_c
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_decode
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_multi_pf
  if ne rc 0
    ret int rc
  end
  rc = run_step test_gdn_prefill
  if ne rc 0
    ret int rc
  end
  rc = run_step test_pattn_a
  if ne rc 0
    ret int rc
  end
  rc = run_step test_pattn_b
  if ne rc 0
    ret int rc
  end
  rc = run_step test_pattn_c
  if ne rc 0
    ret int rc
  end
  rc = run_step test_pa256_a
  if ne rc 0
    ret int rc
  end
  rc = run_step test_pa256_b
  if ne rc 0
    ret int rc
  end
  gapi2_print gapi2_pass
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_gpu_3_silicon.om: Live GB10 silicon value/parity test for
note wave gb10-gpu-3 (pure seeded OM-2, zero CUDA, static AArch64 ELF).
om2

text s3_hdr "=== GB10 LIVE SILICON TEST: wave gb10-gpu-3 (pure seeded OM-2, zero CUDA) ===\n"
text s3_t1 "  [1] zero-CUDA verification (static ELF + /proc/self/maps): "
text s3_t2 "  [2] omega_numeric_gb10.om live GB10 SIMT FADD + FMUL + FFMA (n=256): "
text s3_t3 "  [3] omega_numeric_divsqrt_gb10.om live GB10 DIV/SQRT/EXP/LOG/RSQRT (13 SHA-256 + n=64): "
text s3_t4 "  [4] omega_numeric_ldst_gb10.om live GB10 S8->B32 + B128->B128 (neg offset): "
text s3_t5 "  [5] omega_numeric_reduce_gb10.om + omega_gpu_scan.om live GB10 SUM/MAX/MIN/MEAN (n=100): "
text s3_t6 "  [6] omega_gpu_prefill.om + omega_gpu_pfhost.om live GB10 dev/host DMA + cmdlist record: "
text s3_ok "PASS\n"
text s3_fail "FAIL step="
text s3_stg " stage="
text s3_err " err="
text s3_nl "\n"
text s3_done "PASS test-gb10-gpu-3-silicon (all 7 modules verified on live GB10 silicon, zero CUDA)\n"

text s3_fadd "FADD"
text s3_fmul "FMUL"
text s3_ffma "FFMA"

fn s3_print s view uchar * to void
  r = write 1 s 0 len s
end

fn s3_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn s3_fail_msg code ulong to int
  eb = new uchar 128 0
  s3_print s3_fail
  s3_print_u code
  s3_print s3_stg
  s3_print_u get g_ngb_stage 0
  s3_print s3_err
  el = ogps_last_error part eb 0 128
  if gt el 0
    r = write 1 eb 0 el
  end
  s3_print s3_nl
  ogps_close
  ret 1
end

fn s3_test_simt to ulong
  for i ulong 256
    fa = div f32 add int i 1 f32 7
    fb = div f32 add int i 3 f32 11
    put g_num_a i bitcast uint fa
    put g_num_b i bitcast uint fb
    put g_num_c i uint 0x3fc00000
  end
  if ne omega_gb10_execute_simt_op s3_fadd 4 15 256 OMEGA_NUMERIC_OK
    ret 201
  end
  for i ulong 256
    if ne get g_num_dst i omega_ref_fadd get g_num_a i get g_num_b i
      ret 202
    end
  end
  if ne omega_gb10_execute_simt_op s3_fmul 4 15 256 OMEGA_NUMERIC_OK
    ret 203
  end
  for i ulong 256
    if ne get g_num_dst i omega_ref_fmul get g_num_a i get g_num_b i
      ret 204
    end
  end
  if ne omega_gb10_execute_simt_op s3_ffma 4 15 256 OMEGA_NUMERIC_OK
    ret 205
  end
  for i ulong 256
    if ne get g_num_dst i omega_ref_ffma_int get g_num_a i get g_num_b i get g_num_c 0
      ret 206
    end
  end
  ret 0
end

fn s3_test_divsqrt to ulong
  for op ulong OMEGA_DS_OP_COUNT
    clen = omega_ds_build_kernel op
    if eq clen 0
      ret add 300 op
    end
    if ne omega_ds_check_digest op clen OMEGA_NUMERIC_OK
      ret add 320 op
    end
  end
  for i ulong 64
    fa = div f32 add int i 1 f32 5
    fb = div f32 add int i 2 f32 3
    put g_num_a i bitcast uint fa
    put g_num_b i bitcast uint fb
  end
  put g_num_a 0 uint 0x00000001
  put g_num_b 0 uint 0x40000000
  put g_num_a 1 uint 0x3f800000
  put g_num_b 1 uint 0x40400000
  put g_num_a 2 uint 0x00000000
  put g_num_b 2 uint 0x00000000
  put g_num_a 3 uint 0x7f800000
  put g_num_b 3 uint 0x3f800000
  note Live GB10 DIV, SQRT, EXP, LOG, RSQRT bit-exact parity
  if ne omega_ds_gb10_run OMEGA_DS_DIV true 64 OMEGA_NUMERIC_OK
    ret 340
  end
  for i ulong 64
    if ne get g_num_dst i omega_ds_cpu_semantic OMEGA_DS_DIV get g_num_a i get g_num_b i
      ret 341
    end
  end
  if ne omega_ds_gb10_run OMEGA_DS_SQRT false 64 OMEGA_NUMERIC_OK
    ret 342
  end
  for i ulong 64
    if ne get g_num_dst i omega_ds_cpu_semantic OMEGA_DS_SQRT get g_num_a i 0
      ret 343
    end
  end
  if ne omega_ds_gb10_run OMEGA_DS_EXP false 64 OMEGA_NUMERIC_OK
    ret 344
  end
  for i ulong 64
    if ne get g_num_dst i omega_ds_cpu_semantic OMEGA_DS_EXP get g_num_a i 0
      ret 345
    end
  end
  if ne omega_ds_gb10_run OMEGA_DS_LOG false 64 OMEGA_NUMERIC_OK
    ret 346
  end
  for i ulong 64
    if ne get g_num_dst i omega_ds_cpu_semantic OMEGA_DS_LOG get g_num_a i 0
      ret 347
    end
  end
  if ne omega_ds_gb10_run OMEGA_DS_RSQRT false 64 OMEGA_NUMERIC_OK
    ret 348
  end
  for i ulong 64
    if ne get g_num_dst i omega_ds_host_exec OMEGA_DS_RSQRT get g_num_a i 0
      ret 349
    end
  end
  ret 0
end

fn s3_test_ldst to ulong
  spec = new long 6 0
  put spec 0 long OMEGA_LD_S8
  put spec 1 long OMEGA_ST_B32
  put spec 2 1
  put spec 3 4
  put spec 4 -16
  put spec 5 0
  src = new uchar 256 0
  dst_gpu = new uchar 256 0
  dst_ref = new uchar 256 0
  for i ulong 256
    put src i uchar and add mul i 37 129 255
    put dst_gpu i uchar 0x5a
    put dst_ref i uchar 0x5a
  end
  lcfg = new ulong 2 0
  put lcfg 0 32
  put lcfg 1 16
  if ne omega_ldst_host_run spec src dst_ref lcfg 0
    ret 401
  end
  if ne omega_ldst_gb10_run spec src dst_gpu lcfg OMEGA_NUMERIC_OK
    ret 402
  end
  for i ulong 256
    if ne get dst_gpu i get dst_ref i
      ret 403
    end
  end
  note Second test: B128 -> B128 with stride 16 and offset +16
  put spec 0 long OMEGA_LD_B128
  put spec 1 long OMEGA_ST_B128
  put spec 2 16
  put spec 3 16
  put spec 4 16
  put spec 5 16
  put lcfg 1 8
  for i ulong 256
    put dst_gpu i uchar 0xa5
    put dst_ref i uchar 0xa5
  end
  if ne omega_ldst_host_run spec src dst_ref lcfg 0
    ret 404
  end
  if ne omega_ldst_gb10_run spec src dst_gpu lcfg OMEGA_NUMERIC_OK
    ret 405
  end
  for i ulong 256
    if ne get dst_gpu i get dst_ref i
      ret 406
    end
  end
  ret 0
end

fn s3_test_reduce_scan to ulong
  x = new uint 100 0
  for i ulong 100
    v = sub div f32 add int i 1 f32 4 f32 12
    put x i bitcast uint v
  end
  got = new uint 1 0
  exp = new uint 1 0
  info = new ulong 3 0
  note Live GB10 SUM, MAX, MIN, MEAN (n=100 -> 2 warp-tree levels!)
  if ne omega_reduce_gb10 OMEGA_RED_SUM x 100 got OMEGA_NUMERIC_OK
    ret 501
  end
  if ne omega_gpu_reduce_reference OMEGA_GPU_RED_SUM x 100 exp 0
    ret 502
  end
  if ne get got 0 get exp 0
    ret 503
  end
  if ne omega_gpu_reduce OMEGA_GPU_RED_MAX x 100 got info OMEGA_GPU_SCAN_OK
    ret 504
  end
  if ne omega_gpu_reduce_reference OMEGA_GPU_RED_MAX x 100 exp 0
    ret 505
  end
  if ne get got 0 get exp 0
    ret 506
  end
  if ne omega_gpu_reduce OMEGA_GPU_RED_MIN x 100 got info OMEGA_GPU_SCAN_OK
    ret 507
  end
  if ne omega_gpu_reduce_reference OMEGA_GPU_RED_MIN x 100 exp 0
    ret 508
  end
  if ne get got 0 get exp 0
    ret 509
  end
  if ne omega_reduce_gb10 OMEGA_RED_MEAN x 100 got OMEGA_NUMERIC_OK
    ret 510
  end
  if ne omega_gpu_reduce_reference OMEGA_GPU_RED_SUM x 100 exp 0
    ret 511
  end
  want_mean = omega_math_div get exp 0 omega_ref_u2f uint 100
  if ne get got 0 want_mean
    ret 512
  end
  note Live GB10 prefix sum
  y = new uint 100 0
  yref = new uint 100 0
  if ne omega_gpu_prefix_sum x 100 y info OMEGA_GPU_SCAN_OK
    ret 513
  end
  if ne omega_gpu_prefix_sum_reference x 100 yref 0
    ret 514
  end
  for i ulong 100
    if ne get y i get yref i
      ret 515
    end
  end
  ret 0
end

fn s3_test_prefill_pfhost to ulong
  devm = new ulong 6 0
  hostm = new ulong 6 0
  if ne omega_gpu_pf_alloc_dev 4096 devm OMEGA_GPU_PF_OK
    ret 601
  end
  if ne omega_gpu_pf_alloc_host 4096 hostm OMEGA_GPU_PF_OK
    ret 602
  end
  if or eq get devm 4 0 eq get hostm 4 0
    ret 603
  end
  cid = new ulong 1 0
  if ne ogcl_create 8 cid OGPS_OK
    ret 604
  end
  rreq = new ulong 6 0
  put rreq 0 128
  put rreq 1 32
  put rreq 2 16
  put rreq 3 get hostm 4
  put rreq 4 get devm 4
  put rreq 5 get hostm 4
  if ne omega_gpu_pf_router_logits_record get cid 0 rreq OMEGA_GPU_PF_OK
    ret 605
  end
  mreq = new ulong 7 0
  put mreq 0 128
  put mreq 1 4
  put mreq 2 8
  put mreq 3 get devm 4
  put mreq 4 get hostm 4
  put mreq 5 get hostm 4
  put mreq 6 get devm 4
  if ne omega_gpu_pf_moe_combine_record get cid 0 mreq OMEGA_GPU_PF_OK
    ret 606
  end
  if ne ogcl_count get cid 0 2
    ret 607
  end
  ogcl_free get cid 0
  omega_gpu_pf_free devm
  omega_gpu_pf_free hostm
  ret 0
end

fn main to int
  s3_print s3_hdr

  s3_print s3_t1
  if ne obws_verify_zero_libcuda_linkage 0
    ret s3_fail_msg 101
  end
  if ne obws_verify_zero_libcuda_runtime 0
    ret s3_fail_msg 102
  end
  s3_print s3_ok

  ogpl_reset_state
  ogps_reset_all
  put ogpl_mock 0 0
  ogps_install_default

  s3_print s3_t2
  rc = s3_test_simt
  if ne rc 0
    ret s3_fail_msg rc
  end
  s3_print s3_ok

  s3_print s3_t3
  rc = s3_test_divsqrt
  if ne rc 0
    ret s3_fail_msg rc
  end
  s3_print s3_ok

  s3_print s3_t4
  rc = s3_test_ldst
  if ne rc 0
    ret s3_fail_msg rc
  end
  s3_print s3_ok

  s3_print s3_t5
  rc = s3_test_reduce_scan
  if ne rc 0
    ret s3_fail_msg rc
  end
  s3_print s3_ok

  s3_print s3_t6
  rc = s3_test_prefill_pfhost
  if ne rc 0
    ret s3_fail_msg rc
  end
  s3_print s3_ok

  ogps_close
  s3_print s3_done
  ret 0
end

note ---- Byte-level defects ----

fn ti_bytes_reject ln ulong want view uchar * check_rule bool to ulong
  rc = c2_check_bytes ln
  ti_chk ne rc 0
  if and ne rc 0 check_rule
    ti_chk ti_rule_eq want
  end
  if ne rc 0
    ret 1
  end
  ret 0
end

fn ti_byte_defects to ulong
  nc = get ti_ncorp 0
  si = long -1
  pi = long -1
  for i ulong nc bound 512
    off = get ti_corp_off i
    v = get ti_corp_buf add off 7
    if and lt si 0 ge v 2
      si = long i
    end
    if and lt pi 0 eq v 1
      pi = long i
    end
  end
  ti_chk and ge si 0 ge pi 0
  if or lt si 0 lt pi 0
    ret 0
  end
  pl = ulong 0
  sln = ti_load_corp_ir ulong si
  put c2_ir_buf 0 xor get c2_ir_buf 0 1
  pl = add pl ti_bytes_reject sln c2i_r_magic true
  sln = ti_load_corp_ir ulong si
  put c2_ir_buf 7 6
  pl = add pl ti_bytes_reject sln c2i_r_ver true
  sln = ti_load_corp_ir ulong si
  put c2_ir_buf sln 0
  pl = add pl ti_bytes_reject add sln 1 c2i_r_trail true
  sln = ti_load_corp_ir ulong si
  pl = add pl ti_bytes_reject sub sln 1 c2i_r_trunc false
  poff = get ti_corp_off ulong pi
  pln = get ti_corp_len ulong pi
  for k ulong 7
    put c2_ir_buf k get ti_corp_buf add poff k
  end
  put c2_ir_buf 7 2
  put c2_ir_buf 8 0
  k = ulong 8
  while lt k pln bound 1048576
    put c2_ir_buf add k 1 get ti_corp_buf add poff k
    k = add k 1
  end
  pl = add pl ti_bytes_reject add pln 1 c2i_r_noncan true
  ret pl
end

note ---- Phases 1 & 2 ----

fn ti_enc_matches_corp i ulong ln ulong to bool
  off = get ti_corp_off i
  for k ulong ln bound 1048576
    a = get c2_ir_enc k
    b = get ti_corp_buf add off k
    if ne a b
      ret false
    end
  end
  ret true
end

fn ti_phase1 to ulong
  nc = get ti_ncorp 0
  acc = ulong 0
  for i ulong nc bound 512
    ln = ti_load_corp_ir i
    d = c2_decode ln
    ti_chk eq d 0
    if eq d 0
      c = c2_check_unit
      ti_chk eq c 0
      en = c2_encode
      same = false
      if eq en ln
        same = ti_enc_matches_corp i ln
      end
      ti_chk same
      if eq c 0
        acc = add acc 1
      end
    end
  end
  ti_chk eq acc nc
  ret acc
end

fn ti_phase2_unit i ulong out_tf edit ulong 2 to void
  n = get ti_corp_len i
  off = get ti_corp_off i
  for k ulong 72
    cut = div mul n k 64
    if ge k 64
      cut = sub n sub 72 k
    end
    if ge cut n
      continue
    end
    for j ulong cut bound 1048576
      put c2_ir_buf j get ti_corp_buf add off j
    end
    put out_tf 0 add get out_tf 0 1
    ti_chk ne c2_check_bytes cut 0
  end
  for k ulong 96
    for j ulong n bound 1048576
      put c2_ir_buf j get ti_corp_buf add off j
    end
    pos = rem add mul k 2654435761 mul i 40503 n
    put c2_ir_buf pos xor get c2_ir_buf pos uchar shl ulong 1 and k 7
    put out_tf 1 add get out_tf 1 1
    ign = c2_check_bytes n
  end
end

fn ti_phase2 out_tf edit ulong 2 to void
  nc = get ti_ncorp 0
  put out_tf 0 0
  put out_tf 1 0
  for i ulong nc bound 512
    ti_phase2_unit i out_tf
  end
end

fn main to int
  if ne ulong argcnt 2
    ret 2
  end
  put ti_checks 0 0
  put ti_fails 0 0
  put ti_ncorp 0 0
  put ti_corp_used 0 0
  if le ti_load_list 1 0
    ret 2
  end
  acc = ti_phase1
  tf = new ulong 2 0
  ti_phase2 tf
  pl = ti_run_defects_a
  pl = add pl ti_run_defects_b
  pl = add pl ti_run_defects_c
  pl = add pl ti_byte_defects
  ti_chk ge pl 50
  ti_out_reset
  ti_out_txt ti_s_hdr
  ti_out_u64 acc
  ti_out_txt ti_s_tr
  ti_out_u64 get tf 0
  ti_out_txt ti_s_fl
  ti_out_u64 get tf 1
  ti_out_txt ti_s_pl
  ti_out_u64 pl
  ti_out_txt ti_s_ch
  ti_out_u64 get ti_checks 0
  ti_out_txt ti_s_fa
  ti_out_u64 get ti_fails 0
  ti_out_ch 10
  ti_flush
  if ne get ti_fails 0 0
    ret 1
  end
  ret 0
end

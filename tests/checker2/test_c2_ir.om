  pl = add pl ti_run_one_defect 23 c2c_r_t_idx
  pl = add pl ti_run_one_defect 24 c2c_r_t_idx
  pl = add pl ti_run_one_defect 25 c2c_r_ro
  pl = add pl ti_run_one_defect 26 c2c_r_t_fld
  pl = add pl ti_run_one_defect 27 c2c_r_t_fld
  pl = add pl ti_run_one_defect 28 c2c_r_t_fld

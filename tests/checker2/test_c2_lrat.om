fn tl_run_cases to void
  tl_lrat_run t_n1 tl_load_txt tl_unsat4 tl_load_prf tl_good c2l_r_ok
  tl_lrat_run t_n2 tl_load_txt tl_unsat4 tl_load_prf t_p2 c2l_r_ok
  tl_lrat_run t_n3 tl_load_txt tl_unsat4 tl_load_prf t_p3 c2l_r_ok
  tl_lrat_run t_n4 tl_load_txt tl_unsat4 tl_load_prf t_p4 c2l_r_ok
  tl_lrat_run t_n5 tl_load_txt tl_unsat4 tl_load_prf t_p5 c2l_r_ok
  tl_lrat_run t_n6 tl_load_txt t_c6 tl_load_prf t_p6 c2l_r_ok
  tl_lrat_run t_n7 tl_load_txt tl_unsat4 tl_load_prf t_p7 c2l_r_hnu
  tl_lrat_run t_n8 tl_load_txt tl_unsat4 tl_load_prf t_p8 c2l_r_hnu
  tl_lrat_run t_n9 tl_load_txt tl_unsat4 tl_load_prf t_p9 c2l_r_hunk
  tl_lrat_run t_n10 tl_load_txt tl_unsat4 tl_load_prf t_p10 c2l_r_hunk
  tl_lrat_run t_n11 tl_load_txt tl_unsat4 tl_load_prf t_p11 c2l_r_rat
  tl_lrat_run t_n12 tl_load_txt tl_unsat4 tl_load_prf t_p12 c2l_r_noc
  tl_lrat_run t_n13 tl_load_txt tl_unsat4 tl_load_prf t_p13 c2l_r_noc
  tl_lrat_run t_n14 tl_load_txt tl_unsat4 tl_load_prf t_p14 c2l_r_noe
  tl_lrat_run t_n15 tl_load_txt tl_unsat4 tl_load_prf t_p15 c2l_r_noe
  tl_lrat_run t_n16 tl_load_txt tl_unsat4 tl_load_prf t_p16 c2l_r_ido
  tl_lrat_run t_n17 tl_load_txt tl_unsat4 tl_load_prf t_p17 c2l_r_ido
  tl_lrat_run t_n18 tl_load_txt tl_unsat4 tl_load_prf t_p18 c2l_r_idr
  tl_lrat_run t_n19 tl_load_txt tl_unsat4 tl_load_prf t_p19 c2l_r_idr
  tl_lrat_run t_n20 tl_load_txt tl_unsat4 tl_load_prf t_p20 c2l_r_ok
  tl_lrat_run t_n21 tl_load_txt tl_unsat4 tl_load_prf t_p21 c2l_r_idr
  tl_lrat_run t_n22 tl_load_txt tl_unsat4 tl_load_prf t_p22 c2l_r_lit
  tl_lrat_run t_n23 tl_load_txt tl_unsat4 tl_load_prf t_p23 c2l_r_lit
  tl_lrat_run t_n24 tl_load_txt tl_unsat4 tl_load_prf t_p24 c2l_r_syn
  tl_lrat_run t_n25 tl_load_txt tl_unsat4 tl_load_prf t_p25 c2l_r_syn
  tl_lrat_run t_n26 tl_load_txt tl_unsat4 tl_load_prf t_p26 c2l_r_syn
  tl_lrat_run t_n27 tl_load_txt tl_unsat4 tl_load_prf t_p27 c2l_r_delu
  tl_lrat_run t_n28 tl_load_txt tl_unsat4 tl_load_prf t_p28 c2l_r_delu
  tl_lrat_run t_n29 tl_load_txt t_c29 tl_load_prf t_p29 c2l_r_hnu
  tl_lrat_run t_n30 tl_load_txt t_c30 tl_load_prf t_p30 c2l_r_noc
  tl_cnf_run tc_n1 tl_load_txt tl_unsat4 c2l_c_ok
  tl_cnf_run tc_n2 tl_load_txt tc_t2 c2l_c_hdr
  tl_cnf_run tc_n3 tl_load_txt tc_t3 c2l_c_hdr
  tl_cnf_run tc_n4 tl_load_txt tc_t4 c2l_c_cnt
  tl_cnf_run tc_n5 tl_load_txt tc_t5 c2l_c_cnt
  tl_cnf_run tc_n6 tl_load_txt tc_t6 c2l_c_cnt
  tl_cnf_run tc_n7 tl_load_txt tc_t7 c2l_c_lit
  tl_cnf_run tc_n8 tl_load_txt tc_t8 c2l_c_lit
end

fn main to int
  tl_run_cases
  gn = len tl_good
  x = ulong 12345
  sat_accepts = ulong 0
  runs = ulong 0
  for it ulong 20000
    x = add mul x ulong 6364136223846793005 ulong 1442695040888963407
    pos = rem shr x 33 gn
    ch = get tl_alph rem shr x 20 15
    un = tl_load_txt tl_unsat4
    ign1 = c2_cnf_parse un
    for j ulong gn bound 64
      put c2_lr_txt j get tl_good j
    end
    put c2_lr_txt pos ch
    ign2 = c2_lrat_check gn
    sn = tl_load_txt tl_sat2
    ign3 = c2_cnf_parse sn
    for j ulong gn bound 64
      put c2_lr_txt j get tl_good j
    end
    put c2_lr_txt pos ch
    if eq c2_lrat_check gn 0
      sat_accepts = add sat_accepts 1
    end
    runs = add runs 1
  end
  put tl_cases 0 add get tl_cases 0 1
  if ne sat_accepts 0
    put tl_fails 0 add get tl_fails 0 1
    tl_wr 1 tl_fail len tl_fail
    tl_wr 1 tc_corr len tc_corr
    tl_wr 1 tl_nl 1
  end
  tl_wr 1 tl_m1 len tl_m1
  tl_wr_u64 1 get tl_cases 0
  tl_wr 1 tl_m2 len tl_m2
  tl_wr_u64 1 runs
  tl_wr 1 tl_m3 len tl_m3
  tl_wr_u64 1 get tl_fails 0
  tl_wr 1 tl_m4 len tl_m4
  if ne get tl_fails 0 0
    ret 1
  end
  ret 0
end

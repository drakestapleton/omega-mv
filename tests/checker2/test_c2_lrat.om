note tests/checker2/test_c2_lrat.om: pure seeded OM-2 unit tests for c2_lrat.om.
note Compose after: c2_om2_hdr.om, src/checker2/c2_lrat.om

global tl_fails ulong 1
global tl_cases ulong 1
global tl_prf_buf uchar 4096

text tl_unsat4 "c four clauses over two variables\np cnf 2 4\n1 2 0\n1 -2 0\n-1 2 0\n-1 -2 0\n"
text tl_good "5 1 0 1 2 0\n6 0 5 3 4 0\n"
text tl_sat2 "p cnf 2 4\n1 2 0\n1 -2 0\n-1 2 0\n2 0\n"
text tl_alph " 0123456789-d\nc"

text tl_m1 "test_c2_lrat: "
text tl_m2 " cases, "
text tl_m3 " corruptions, "
text tl_m4 " failures\n"
text tl_fail "FAIL "
text tl_nl "\n"

fn tl_wr fd int s view uchar * n ulong to void
  ign = write fd s 0 n
end

fn tl_wr_u64 fd int v ulong to void
  buf = new uchar 32 0
  if eq v 0
    put buf 0 48
    ign = write fd buf 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 32 0
  for i ulong n bound 24
    put rev i get buf sub sub n 1 i
  end
  ign = write fd rev 0 n
end

fn tl_load_txt s view uchar * to ulong
  n = len s
  for i ulong n bound 4096
    put c2_lr_txt i get s i
  end
  ret n
end

fn tl_rule_eq want view uchar * is_cnf bool to bool
  wl = len want
  gl = get c2_lr_rulelen 0
  if is_cnf
    gl = get c2_cnf_whylen 0
  end
  if ne wl gl
    ret false
  end
  for i ulong wl bound 64
    b = get c2_lr_rule i
    if is_cnf
      b = get c2_cnf_why i
    end
    if ne b get want i
      ret false
    end
  end
  ret true
end

fn tl_lrat_run name view uchar * cn ulong pn ulong want view uchar * to void
  put tl_cases 0 add get tl_cases 0 1
  if ne c2_cnf_parse cn 0
    put tl_fails 0 add get tl_fails 0 1
    tl_wr 1 tl_fail len tl_fail
    tl_wr 1 name len name
    tl_wr 1 tl_nl 1
    ret
  end
  for i ulong pn bound 4096
    put c2_lr_txt i get tl_prf_buf i
  end
  rc = c2_lrat_check pn
  want_ok = eq len want len c2l_r_ok
  if want_ok
    for i ulong len want bound 16
      if ne get want i get c2l_r_ok i
        want_ok = false
      end
    end
  end
  got_ok = eq rc 0
  rok = ne get c2_lr_ok 0 0
  req = tl_rule_eq want false
  ok = and eq got_ok want_ok and eq rok want_ok req
  if not ok
    put tl_fails 0 add get tl_fails 0 1
    tl_wr 1 tl_fail len tl_fail
    tl_wr 1 name len name
    tl_wr 1 tl_nl 1
  end
end

fn tl_load_prf s view uchar * to ulong
  n = len s
  for i ulong n bound 4096
    put tl_prf_buf i get s i
  end
  ret n
end

fn tl_cnf_run name view uchar * tn ulong want view uchar * to void
  put tl_cases 0 add get tl_cases 0 1
  rc = c2_cnf_parse tn
  want_ok = eq len want len c2l_c_ok
  if want_ok
    for i ulong len want bound 16
      if ne get want i get c2l_c_ok i
        want_ok = false
      end
    end
  end
  got_ok = eq rc 0
  req = tl_rule_eq want true
  if not and eq got_ok want_ok req
    put tl_fails 0 add get tl_fails 0 1
    tl_wr 1 tl_fail len tl_fail
    tl_wr 1 name len name
    tl_wr 1 tl_nl 1
  end
end


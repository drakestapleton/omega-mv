text tr_p2 "test in production"
text tr_p3 "test key cannot sign owner"
text tr_p4 "attach owner class test key"
text tr_p5 "prod pins owner root"
text tr_p6 "non-prod takes listed owner"
text tr_p7 "cross-class refused"
text tr_p8 "attach forged owner refused"
text tr_p9 "forged owner in prod refused"

fn tr_test_production to void
  tr_sign_base_to_saved
  tr_qual
  tr_expect_of_r
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_p1
  put c2r_pol_prod 0 1
  tr_expect c2r_verify C2R_SIZE C2R_E_TEST_IN_PRODUCTION tr_p2
  tr_base
  put c2r_r_u16 1 C2R_CLASS_OWNER
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  tr_expect c2r_sign_test sd C2R_E_KEY_CLASS tr_p3
  tpk = new uchar 32 0
  for i ulong 32
    put tpk i get c2r_test_pk i
    put sh_dat i get c2r_test_pk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add C2RH_KFP i get sh_dig i
  end
  c2r_encode
  c2r_signed_message
  sg = new uchar 64 0
  c2r_sign_msg65 sd sg
  tr_expect c2r_attach tpk sg C2R_OK tr_p4
  tr_qual
  put c2r_pol_prod 0 1
  put c2r_pol_nowner 0 2
  for i ulong 32
    put c2r_pol_owner i get c2r_owner_root_pk i
    put c2r_pol_owner add 32 i get c2r_test_pk i
  end
  put c2r_pol_ntest 0 0
  tr_expect_of_r
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_SIGNER tr_p5
  put c2r_pol_prod 0 0
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_p6
  put c2r_pol_ntest 0 1
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_SIGNER tr_p7
  tr_base
  put c2r_r_u16 1 C2R_CLASS_OWNER
  opk = new uchar 32 0
  for i ulong 32
    put opk i get c2r_owner_root_pk i
    put sh_dat i get c2r_owner_root_pk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add C2RH_KFP i get sh_dig i
  end
  c2r_encode
  c2r_signed_message
  c2r_sign_msg65 sd sg
  tr_expect c2r_attach opk sg C2R_E_BAD_SIGNATURE tr_p8
  tr_qual
  put c2r_pol_prod 0 1
  tr_expect c2r_verify C2R_SIZE C2R_E_BAD_SIGNATURE tr_p9
end


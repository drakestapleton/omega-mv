text tr_m_chk " checks, "
text tr_m_fld " failed\n"
text tr_m_fail "FAIL: "
text tr_m_nl "\n"

fn tr_wr_str fd int s view uchar * n ulong to void
  ign = write fd s 0 n
end

fn tr_wr_u64 fd int v ulong to void
  buf = new uchar 32 0
  if eq v 0
    put buf 0 48
    ign = write fd buf 0 1
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put buf n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  rev = new uchar 32 0
  for i ulong n bound 24
    put rev i get buf sub sub n 1 i
  end
  ign = write fd rev 0 n
end

fn tr_check cond bool msg view uchar * to void
  put tr_checks 0 add get tr_checks 0 1
  if not cond
    put tr_fails 0 add get tr_fails 0 1
    tr_wr_str 2 tr_m_fail len tr_m_fail
    tr_wr_str 2 msg len msg
    tr_wr_str 2 tr_m_nl 1
  end
end

fn tr_expect got long want long msg view uchar * to void
  tr_check eq got want msg
end

fn tr_fill_sh s view uchar * to void
  n = len s
  for i ulong n bound 128
    put sh_dat i get s i
  end
  sh_all n
end

fn tr_slurp_fix rel view uchar * dst edit uchar * cap ulong to long
  fl = get tr_fixlen 0
  for i ulong fl bound 512
    put tr_path i get tr_fixdir i
  end
  rl = len rel
  for i ulong rl bound 128
    put tr_path add fl i get rel i
  end
  put tr_path add fl rl 0
  p = new uchar 1024 0
  tot = add fl rl
  for i ulong add tot 1 bound 1024
    put p i get tr_path i
  end
  fd = fopen p 0 tot 0 0
  if lt fd 0
    ret -1
  end
  n = read int fd dst 0 cap
  ign = fclose int fd
  ret n
end

fn tr_base to void
  put c2r_r_u16 0 C2R_FORMAT_VERSION
  put c2r_r_u16 1 C2R_CLASS_TEST
  put c2r_r_u16 2 C2R_ALG_ED25519
  put c2r_r_u16 3 C2R_EV_IR_CHECKED
  for i ulong 320
    put c2r_r_h i 0
  end
  for i ulong 64
    put c2r_r_sig i 0
  end
  tr_fill_sh tr_s_req
  for i ulong 32
    put c2r_r_h add C2RH_REQ i get sh_dig i
  end
  tr_fill_sh tr_s_prog
  for i ulong 32
    put c2r_r_h add C2RH_PROG i get sh_dig i
  end
  tr_fill_sh tr_s_exe
  for i ulong 32
    put c2r_r_h add C2RH_EXE i get sh_dig i
  end
  empty_deps = new uchar 32 0
  dd = new uchar 32 0
  ign_d = c2r_deps_digest empty_deps 0 dd
  for i ulong 32
    put c2r_r_h add C2RH_DEPS i get dd i
  end
  tr_fill_sh tr_s_chk
  for i ulong 32
    put c2r_r_h add C2RH_CHK i get sh_dig i
  end
  tr_fill_sh tr_s_oscc
  for i ulong 32
    put c2r_r_h add C2RH_PCHK i get sh_dig i
  end
  tg = new uchar 32 0
  c2r_target_id tr_s_tgt len tr_s_tgt tg
  for i ulong 32
    put c2r_r_h add C2RH_TGT i get tg i
  end
  tr_fill_sh tr_s_inp
  for i ulong 32
    put c2r_r_h add C2RH_INP i get sh_dig i
  end
  put c2r_r_ep 0 5
  put c2r_r_ep 1 9
end

fn tr_qual to void
  c2r_init_keys
  put c2r_pol_prod 0 0
  put c2r_pol_ntest 0 1
  for i ulong 32
    put c2r_pol_test i get c2r_test_pk i
  end
  put c2r_pol_nowner 0 1
  for i ulong 32
    put c2r_pol_owner i get c2r_owner_root_pk i
  end
  put c2r_pol_nrev_id 0 0
  put c2r_pol_nrev_key 0 0
  put c2r_pol_nchk 0 1
  for i ulong 32
    put c2r_pol_chk i get tr_chk_ok i
  end
  put c2r_pol_floor 0 5
  put c2r_pol_cur 0 7
end

fn tr_expect_of_r to void
  for i ulong 7
    put c2r_ex_has i 1
  end
  for i ulong 32
    put c2r_ex_h i get c2r_r_h add C2RH_TGT i
    put c2r_ex_h add 32 i get c2r_r_h add C2RH_FW i
    put c2r_ex_h add 64 i get c2r_r_h add C2RH_PROG i
    put c2r_ex_h add 96 i get c2r_r_h add C2RH_EXE i
    put c2r_ex_h add 128 i get c2r_r_h add C2RH_PCHK i
    put c2r_ex_h add 160 i get c2r_r_h add C2RH_DEPS i
  end
end

fn tr_sign_base_to_saved to void
  tr_base
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  ign = c2r_sign_test sd
  for i ulong C2R_SIZE
    put tr_saved_a i get c2r_buf i
  end
end

fn tr_load_saved_a to void
  for i ulong C2R_SIZE
    put c2r_buf i get tr_saved_a i
  end
end

fn tr_verify_ceremony pk view uchar 32 mlen ulong to bool
  m = new uchar 65536 0
  for i ulong mlen bound 4096
    put m i get tr_cer_msg i
  end
  sg = new uchar 64 0
  for i ulong 64
    put sg i get tr_cer_sig i
  end
  ret c2r_edverify_strict pk m mlen sg
end

text tr_k1 "derive test pk"
text tr_k2 "test pk differs from owner root"
text tr_k3 "ceremony statement read"
text tr_k4 "ceremony signature 64 bytes"
text tr_k5 "ceremony signature verifies"
text tr_k6 "altered ceremony refused"
text tr_k7 "ceremony refused under test key"

fn tr_test_ceremony pk view uchar 32 to void
  mb = new uchar 4096 0
  n = tr_slurp_fix tr_rel_stmt mb 4096
  tr_check gt n 0 tr_k3
  sb = new uchar 64 0
  opk = new uchar 32 0
  ns = tr_slurp_fix tr_rel_sig sb 64
  tr_check eq ns 64 tr_k4
  if gt n 0
    un = ulong n
    for i ulong un bound 4096
      put tr_cer_msg i get mb i
    end
    for i ulong 64
      put tr_cer_sig i get sb i
    end
    for i ulong 32
      put opk i get c2r_owner_root_pk i
    end
    tr_check tr_verify_ceremony opk un tr_k5
    put tr_cer_msg sub un 1 xor get tr_cer_msg sub un 1 1
    tr_check not tr_verify_ceremony opk un tr_k6
    put tr_cer_msg sub un 1 xor get tr_cer_msg sub un 1 1
    tr_check not tr_verify_ceremony pk un tr_k7
  end
end

fn tr_test_keys to void
  c2r_init_keys
  sd = new uchar 32 0
  c2r_test_seed sd
  for i ulong 32
    put tr_seed i get sd i
  end
  pk = new uchar 32 0
  ues_pubkey sd pk
  tr_check c2r_eq32_global_test_pk pk tr_k1
  tr_check not c2r_eq32_global_owner_pk pk tr_k2
  tr_test_ceremony pk
end

text tr_v1 "sign 1"
text tr_v2 "sign 2"
text tr_v3 "deterministic bytes"
text tr_v4 "deterministic ids"
text tr_v5 "valid TEST receipt"
text tr_v6 "epoch edge low"
text tr_v7 "epoch edge high"

fn tr_test_valid to void
  tr_base
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  tr_expect c2r_sign_test sd C2R_OK tr_v1
  for i ulong C2R_SIZE
    put tr_saved_a i get c2r_buf i
  end
  ida = new uchar 32 0
  c2r_id ida
  tr_base
  tr_expect c2r_sign_test sd C2R_OK tr_v2
  for i ulong C2R_SIZE
    put tr_saved_b i get c2r_buf i
  end
  idb = new uchar 32 0
  c2r_id idb
  same = true
  for i ulong C2R_SIZE
    if ne get tr_saved_a i get tr_saved_b i
      same = false
    end
  end
  tr_check same tr_v3
  same_id = true
  for i ulong 32
    if ne get ida i get idb i
      same_id = false
    end
  end
  tr_check same_id tr_v4
  tr_qual
  tr_expect_of_r
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_v5
  put c2r_pol_cur 0 5
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_v6
  put c2r_pol_cur 0 9
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_v7
end

text tr_a1 "single-bit flips all refused"
text tr_a2 "altered magic"
text tr_a3 "altered version"
text tr_a4 "altered class"
text tr_a5 "altered alg"
text tr_a6 "altered evidence"
text tr_a7 "altered program hash"
text tr_a8 "altered sig"
text tr_a9 "truncated"
text tr_a10 "trailing byte"
text tr_a11 "epoch order"

fn tr_test_altered to void
  tr_sign_base_to_saved
  tr_qual
  tr_expect_of_r
  accepted = ulong 0
  for i ulong 3328
    tr_load_saved_a
    bi = div i 8
    bit = rem i 8
    put c2r_buf bi xor get c2r_buf bi uchar shl 1 bit
    if eq c2r_verify C2R_SIZE C2R_OK
      accepted = add accepted 1
    end
  end
  tr_check eq accepted 0 tr_a1
  tr_load_saved_a
  put c2r_buf 0 xor get c2r_buf 0 1
  tr_expect c2r_verify C2R_SIZE C2R_E_MAGIC tr_a2
  tr_load_saved_a
  put c2r_buf 8 2
  tr_expect c2r_verify C2R_SIZE C2R_E_VERSION tr_a3
  tr_load_saved_a
  put c2r_buf 10 3
  tr_expect c2r_verify C2R_SIZE C2R_E_CLASS tr_a4
  tr_load_saved_a
  put c2r_buf 12 2
  tr_expect c2r_verify C2R_SIZE C2R_E_ALG tr_a5
  tr_load_saved_a
  put c2r_buf 14 9
  tr_expect c2r_verify C2R_SIZE C2R_E_EVIDENCE tr_a6
  tr_load_saved_a
  put c2r_buf 48 xor get c2r_buf 48 128
  put c2r_ex_has 0 0
  tr_expect c2r_verify C2R_SIZE C2R_E_BAD_SIGNATURE tr_a7
  put c2r_ex_has 0 1
  tr_load_saved_a
  put c2r_buf 400 xor get c2r_buf 400 1
  tr_expect c2r_verify C2R_SIZE C2R_E_BAD_SIGNATURE tr_a8
  tr_load_saved_a
  tr_expect c2r_verify sub C2R_SIZE 1 C2R_E_SIZE tr_a9
  tr_expect c2r_verify add C2R_SIZE 1 C2R_E_SIZE tr_a10
  tr_base
  put c2r_r_ep 1 4
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  tr_expect c2r_sign_test sd C2R_E_EPOCH_ORDER tr_a11
end


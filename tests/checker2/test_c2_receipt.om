fn tr_test_revoked_fresh to void
  tr_sign_base_to_saved
  rid = new uchar 32 0
  c2r_id rid
  for i ulong 32
    put sh_dat i get c2r_test_pk i
  end
  sh_all 32
  fp = new uchar 32 0
  for i ulong 32
    put fp i get sh_dig i
  end
  tr_fill_sh tr_s_unrel
  tr_qual
  tr_expect_of_r
  put c2r_pol_nrev_id 0 1
  for i ulong 32
    put c2r_pol_rev_id i get sh_dig i
  end
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_r1
  for i ulong 32
    put c2r_pol_rev_id i get rid i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_REVOKED tr_r2
  tr_qual
  put c2r_pol_nrev_key 0 1
  for i ulong 32
    put c2r_pol_rev_key i get fp i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_REVOKED tr_r3
  tr_qual
  put c2r_pol_floor 0 6
  tr_expect c2r_verify C2R_SIZE C2R_E_STALE tr_r4
  tr_qual
  put c2r_pol_cur 0 10
  tr_expect c2r_verify C2R_SIZE C2R_E_EXPIRED tr_r5
  tr_qual
  put c2r_pol_floor 0 0
  put c2r_pol_cur 0 4
  tr_expect c2r_verify C2R_SIZE C2R_E_NOT_YET_VALID tr_r6
end


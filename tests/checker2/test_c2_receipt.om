fn tr_test_checker_id to void
  tr_sign_base_to_saved
  tr_base
  tr_fill_sh tr_s_ochk
  ochk = new uchar 32 0
  for i ulong 32
    put ochk i get sh_dig i
    put c2r_r_h add C2RH_CHK i get sh_dig i
  end
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  ign = c2r_sign_test sd
  for i ulong C2R_SIZE
    put tr_saved_b i get c2r_buf i
  end
  tr_qual
  tr_base
  tr_expect_of_r
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_c1
  for i ulong C2R_SIZE
    put c2r_buf i get tr_saved_b i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_CHECKER tr_c2
  put c2r_ex_has 0 0
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_CHECKER tr_c3
  put c2r_ex_has 0 1
  put c2r_pol_nchk 0 2
  for i ulong 32
    put c2r_pol_chk add 32 i get ochk i
  end
  tr_expect c2r_verify C2R_SIZE C2R_OK tr_c4
  put c2r_pol_nchk 0 0
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_CHECKER tr_c5
  tr_qual
  tr_fill_sh tr_s_ooscc
  for i ulong 32
    put c2r_ex_h add 128 i get sh_dig i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_WRONG_PRODUCER tr_c6
  tr_base
  tr_expect_of_r
  d1 = new uchar 32 0
  tr_fill_sh tr_s_dep1
  for i ulong 32
    put d1 i get sh_dig i
  end
  dx = new uchar 32 0
  ign_d = c2r_deps_digest d1 1 dx
  for i ulong 32
    put c2r_ex_h add 160 i get dx i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_DEPS_MISMATCH tr_c7
end

text tr_d1 "sorted deps ok"
text tr_d2 "dep count bound"
text tr_d3 "unsorted deps refused"
text tr_d4 "dup deps refused"

fn tr_test_deps to void
  ids = new uchar 96 0
  tr_fill_sh tr_s_a
  for i ulong 32
    put ids i get sh_dig i
  end
  tr_fill_sh tr_s_b
  for i ulong 32
    put ids add 32 i get sh_dig i
  end
  tr_fill_sh tr_s_c
  for i ulong 32
    put ids add 64 i get sh_dig i
  end
  for i ulong 3
    for j ulong 3
      if gt j i
        if gt c2r_cmp32_in ids mul i 32 mul j 32 0
          for k ulong 32
            tmp = get ids add mul i 32 k
            put ids add mul i 32 k get ids add mul j 32 k
            put ids add mul j 32 k tmp
          end
        end
      end
    end
  end
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  tr_check eq c2r_deps_digest ids 3 d1 0 tr_d1
  r2 = c2r_deps_digest ids 2 d2
  diff = false
  for i ulong 32
    if ne get d1 i get d2 i
      diff = true
    end
  end
  tr_check and eq r2 0 diff tr_d2
  sw = new uchar 64 0
  for i ulong 32
    put sw i get ids add 32 i
    put sw add 32 i get ids i
  end
  tr_check eq c2r_deps_digest sw 2 d2 -1 tr_d3
  for i ulong 32
    put sw add 32 i get ids add 32 i
  end
  tr_check eq c2r_deps_digest sw 2 d2 -1 tr_d4
end

fn main to int
  ab = new uchar 512 0
  al = argread ulong 1 ab 0 511
  if ge al 0
    for i ulong ulong al bound 512
      put tr_fixdir i get ab i
    end
    put tr_fixlen 0 ulong al
  else
    dl = len tr_def_fix
    for i ulong dl bound 64
      put tr_fixdir i get tr_def_fix i
    end
    put tr_fixlen 0 dl
  end
  tr_fill_sh tr_s_chk
  for i ulong 32
    put tr_chk_ok i get sh_dig i
  end
  tr_test_keys
  tr_test_valid
  tr_test_altered
  tr_test_wrong_key
  tr_test_production
  tr_test_revoked_fresh
  tr_test_binding
  tr_test_checker_id
  tr_test_deps
  tr_wr_str 1 tr_m_pfx len tr_m_pfx
  tr_wr_u64 1 get tr_checks 0
  tr_wr_str 1 tr_m_chk len tr_m_chk
  tr_wr_u64 1 get tr_fails 0
  tr_wr_str 1 tr_m_fld len tr_m_fld
  if ne get tr_fails 0 0
    ret 1
  end
  ret 0
end

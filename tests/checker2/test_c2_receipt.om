note Compose after: c2_om2_hdr.om, sha256.om, sha512.om, ed25519.om, ed_sign.om, c2_receipt.om

global tr_fails ulong 1
global tr_checks ulong 1
global tr_fixdir uchar 512
global tr_fixlen ulong 1
global tr_seed uchar 32
global tr_chk_ok uchar 32
global tr_saved_a uchar 416
global tr_saved_b uchar 416
global tr_cer_msg uchar 4096
global tr_cer_sig uchar 64
global tr_path uchar 1024
global tr_out uchar 256

text tr_def_fix "tests/checker2/fixtures"
text tr_rel_stmt "/owner/ceremony-statement"
text tr_rel_sig "/owner/ceremony-signature"
text tr_s_req "requirements"
text tr_s_prog "program bytes"
text tr_s_exe "executable bytes"
text tr_s_chk "checker2"
text tr_s_oscc "oscc"
text tr_s_tgt "aarch64-linux-host"
text tr_s_inp "input"
text tr_s_other_k "some other key"
text tr_s_unrel "unrelated id"
text tr_s_gb10 "gb10-aienos"
text tr_s_fw2 "firmware v2"

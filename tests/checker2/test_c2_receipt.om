fn tr_test_wrong_key to void
  tr_base
  osd = new uchar 32 0
  opk = new uchar 32 0
  tr_fill_sh tr_s_other_k
  for i ulong 32
    put osd i get sh_dig i
  end
  ues_pubkey osd opk
  tr_expect c2r_sign_test osd C2R_E_KEY_CLASS tr_w1
  tr_base
  for i ulong 32
    put sh_dat i get opk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add C2RH_KFP i get sh_dig i
  end
  c2r_encode
  c2r_signed_message
  sg = new uchar 64 0
  c2r_sign_msg65 osd sg
  tr_expect c2r_attach opk sg C2R_OK tr_w2
  tr_qual
  tr_expect_of_r
  tr_expect c2r_verify C2R_SIZE C2R_E_UNTRUSTED_SIGNER tr_w3
  tr_base
  tpk = new uchar 32 0
  for i ulong 32
    put tpk i get c2r_test_pk i
    put sh_dat i get c2r_test_pk i
  end
  sh_all 32
  for i ulong 32
    put c2r_r_h add C2RH_KFP i get sh_dig i
  end
  c2r_encode
  c2r_signed_message
  c2r_sign_msg65 osd sg
  tr_expect c2r_attach tpk sg C2R_E_BAD_SIGNATURE tr_w4
  for i ulong 64
    put c2r_buf add 352 i get sg i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_BAD_SIGNATURE tr_w5
  tr_sign_base_to_saved
  tr_base
  put c2r_r_ep 0 6
  sd = new uchar 32 0
  for i ulong 32
    put sd i get tr_seed i
  end
  ign = c2r_sign_test sd
  for i ulong 64
    put tr_saved_a add 352 i get c2r_buf add 352 i
  end
  tr_base
  tr_expect_of_r
  tr_load_saved_a
  tr_expect c2r_verify C2R_SIZE C2R_E_BAD_SIGNATURE tr_w6
end


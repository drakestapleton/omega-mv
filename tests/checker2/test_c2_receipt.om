  x = new uchar 32 0
  c2r_target_id tr_s_gb10 len tr_s_gb10 x
  for i ulong 32
    put c2r_ex_h i get x i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_WRONG_TARGET tr_b2
  tr_base
  tr_expect_of_r
  tr_fill_sh tr_s_fw2
  for i ulong 32
    put c2r_ex_h add 32 i get sh_dig i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_WRONG_FIRMWARE tr_b3
  tr_expect_of_r
  tr_fill_sh tr_s_oprog
  for i ulong 32
    put c2r_ex_h add 64 i get sh_dig i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_PROGRAM_MISMATCH tr_b4
  tr_expect_of_r
  tr_fill_sh tr_s_oexe
  for i ulong 32
    put c2r_ex_h add 96 i get sh_dig i
  end
  tr_expect c2r_verify C2R_SIZE C2R_E_EXECUTABLE_MISMATCH tr_b5
end


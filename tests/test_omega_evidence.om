note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 parity test for src/omega_evidence.om against C oracle.
om2

text g_epoch0 "19700101T000000Z"
text g_ts_ref "20260806T070640Z"
text g_uuid_hex "00112233445566778899aabbccddeeff"
text t_stem "ev_om_test"
text t_ext "txt"
text t_body "hello omega evidence\n"
text t_rel "ev_om_create.txt"
text msg_pass "OMEGA_EVIDENCE_OM_PASS\n"
text msg_fail "OMEGA_EVIDENCE_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_eq_txt buf view uchar * n ulong pat view uchar * to void
  chk eq n len pat
  if ne n len pat
    ret
  end
  for i ulong n bound 128
    chk eq get buf i get pat i
  end
end

fn test_utc_and_hw to void
  ts = new uchar 20 0
  n0 = ev_format_utc_sec 0 ts
  chk_eq_txt ts n0 g_epoch0
  n1 = ev_format_utc_sec 1786000000 ts
  chk_eq_txt ts n1 g_ts_ref

  uuid = new uchar 16 0
  for i ulong 16
    put uuid i uchar or shl i 4 i
  end
  meta = new ulong 2 0
  uhex = new uchar 33 0
  al = new uchar 8 0
  omega_evidence_hardware_from_nvrm 0xcbc0 121 uuid meta uhex al
  chk eq get meta 0 0xcbc0
  chk eq get meta 1 121
  chk_eq_txt uhex 32 g_uuid_hex
  chk eq get uhex 32 0
  chk_eq_txt al 6 ev_sm121
end

fn test_run_id to void
  r1 = new uchar 96 0
  r2 = new uchar 96 0
  l1 = omega_evidence_run_id r1 96
  l2 = omega_evidence_run_id r2 96
  chk gt l1 17
  chk eq l1 l2
  chk eq get r1 8 84
  chk eq get r1 15 90
  chk eq get r1 16 45
  for i ulong l1 bound 96
    chk eq get r1 i get r2 i
  end
end

fn test_write_digest to void
  chk eq omega_evidence_write_digest t_stem t_ext t_body 0
  chk eq omega_evidence_write_digest t_stem t_ext t_body 1
  plen = get g_ev_last_path_len 0
  outp = new uchar 1024 0
  rb = new uchar 64 0
  for i ulong plen bound 1024
    put outp i get g_ev_last_path i
  end
  fd = fopen outp 0 plen EV_O_RDONLY 0
  chk ge fd 0
  ign = long 0
  if ge fd 0
    rn = read int fd rb 0 64
    ign = fclose int fd
    chk eq rn long len t_body
    chk_eq_txt rb ulong rn t_body
  end
  ign = unlink outp 0 plen
end

fn test_create_and_meta to void
  p2 = new uchar 1024 0
  chk eq omega_evidence_path t_rel len t_rel p2 1024 0
  p2l = ev_cstr_len p2 1024
  cfd = omega_evidence_create p2 p2l
  chk ge cfd 0
  ign = long 0
  if ge cfd 0
    ign = write int cfd t_body 0 len t_body
    ign = fclose int cfd
    ign = unlink p2 0 p2l
  end
  sb = new uchar 1024 0
  chk omega_evidence_self_binary sb 1024
  pl = new uchar 128 0
  if omega_evidence_physics_commit pl 128
    chk gt ev_cstr_len pl 128 0
  end
  cm = new uchar 41 0
  ign_b = omega_evidence_run_commit cm
  ign_b = omega_evidence_tree_dirty
end

fn main to int
  test_utc_and_hw
  test_run_id
  test_write_digest
  test_create_and_meta
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit + C-parity test for src/omega_blake3.om (omega_blake3_hash).
om2

global g_b3_hex uchar 65
global g_b3_in uchar 10000

fn b3_hex_nib v ulong to uchar
  if lt v 10
    ret uchar add v 48
  end
  ret uchar add v 87
end

fn b3_print_case n ulong to void
  buf = new uchar 10000 0
  for i ulong n bound 10000
    put buf i uchar rem i 251
  end
  dig = new uchar 32 0
  omega_blake3_hash buf n dig
  for i ulong 32
    b = ulong get dig i
    put g_b3_hex mul i 2 b3_hex_nib shr b 4
    put g_b3_hex add mul i 2 1 b3_hex_nib and b 15
  end
  put g_b3_hex 64 uchar 10
  ign = write 1 g_b3_hex 0 65
end

fn main to int
  b3_print_case 0
  b3_print_case 1
  b3_print_case 64
  b3_print_case 1023
  b3_print_case 1024
  b3_print_case 1025
  b3_print_case 2048
  b3_print_case 2049
  b3_print_case 4096
  b3_print_case 10000
  ret 0
end

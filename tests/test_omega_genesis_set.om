note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_genesis_set.c.
note Tests a 1-member listed Genesis Set variant (fixture 0x10 from tests/genesis_variant/member.inc):
note   - list: count==1, member(0)==fx10, member(1) out-of-range, contains(fx10)==1,
note     unlisted fx11/fx00==0, 1-bit flip at every byte position 0..31 rejected, zero ID rejected
note   - store: inserts listed bootstrap record, refuses unlisted bootstrap (GENESIS_NOT_LISTED),
note     inserts unlisted verified record, refuses bootstrap over verified, save/load round-trip,
note     and load refuses a file tampered with an unlisted bootstrap record
note   - admit_genesis: admits listed member, refuses unlisted member with store_code GENESIS_NOT_LISTED
note   - resolver: listed bootstrap satisfies build domain with blobs, refused in build domain without
note     blobs, satisfies dev domain without blobs, and tampered unlisted bootstrap refused by resolver.
note Host-only, CPU-only, zero GPU access.
om2

const GS_OK ulong 0
const GS_GENESIS_NOT_LISTED ulong 7
const GS_RES_UNVERIFIED_DEP ulong 4

const GS_ADM_VERIFIED ulong 1
const GS_ADM_BOOTSTRAP ulong 2

const GS_DOM_BUILD ulong 0
const GS_DOM_DEV ulong 1

const GS_MAX_OBJS ulong 16

text t_gs_pass "PASS test_omega_genesis_set\n"
text t_gs_fail "FAIL test_omega_genesis_set\n"

note Variant Genesis Set member (tests/genesis_variant/member.inc, fixture 0x10 semantic ID)
global g_gs_member uchar 32
global g_gs_fx11 uchar 32
global g_gs_fx00 uchar 32

note In-memory store: up to 16 objects (32-byte semantic_id, admission_kind, 32-byte receipt_id)
global g_gs_sid uchar 512
global g_gs_rcpt uchar 512
global g_gs_kind ulong 16
global g_gs_cnt ulong 1

note Serialized store buffer (16 * 65 + 4 bytes = 1044 bytes max)
global g_gs_wire uchar 2048
global g_gs_wlen ulong 1

note Scratch ID buffer
global g_gs_tmp uchar 32

fn gs_init_fixtures to void
  note 0x8f, 0x0b, 0x38, 0x8a, 0xad, 0x27, 0xd8, 0x16, 0x5f, 0x88, 0xbd, 0x4b, 0xf9, 0x80, 0xb8, 0x5d
  put g_gs_member 0 0x8f
  put g_gs_member 1 0x0b
  put g_gs_member 2 0x38
  put g_gs_member 3 0x8a
  put g_gs_member 4 0xad
  put g_gs_member 5 0x27
  put g_gs_member 6 0xd8
  put g_gs_member 7 0x16
  put g_gs_member 8 0x5f
  put g_gs_member 9 0x88
  put g_gs_member 10 0xbd
  put g_gs_member 11 0x4b
  put g_gs_member 12 0xf9
  put g_gs_member 13 0x80
  put g_gs_member 14 0xb8
  put g_gs_member 15 0x5d
  note 0x75, 0xa6, 0x3b, 0x4d, 0x25, 0x32, 0x35, 0xb9, 0x84, 0x91, 0xc1, 0xa3, 0x8a, 0x18, 0xc0, 0x93
  put g_gs_member 16 0x75
  put g_gs_member 17 0xa6
  put g_gs_member 18 0x3b
  put g_gs_member 19 0x4d
  put g_gs_member 20 0x25
  put g_gs_member 21 0x32
  put g_gs_member 22 0x35
  put g_gs_member 23 0xb9
  put g_gs_member 24 0x84
  put g_gs_member 25 0x91
  put g_gs_member 26 0xc1
  put g_gs_member 27 0xa3
  put g_gs_member 28 0x8a
  put g_gs_member 29 0x18
  put g_gs_member 30 0xc0
  put g_gs_member 31 0x93

  for i ulong 32
    put g_gs_fx11 i xor get g_gs_member i 0x11
    put g_gs_fx00 i xor get g_gs_member i 0x55
  end
end

fn gs_genesis_count to ulong
  ret 1
end

fn gs_genesis_member_ok idx ulong to ulong
  if eq idx 0
    ret 1
  end
  ret 0
end

fn gs_genesis_contains_tmp to ulong
  for i ulong 32
    if ne get g_gs_tmp i get g_gs_member i
      ret 0
    end
  end
  ret 1
end

fn gs_load_fx n ulong to void
  if eq n 0x10
    for i ulong 32
      put g_gs_tmp i get g_gs_member i
    end
    ret
  end
  if eq n 0x11
    for i ulong 32
      put g_gs_tmp i get g_gs_fx11 i
    end
    ret
  end
  for i ulong 32
    put g_gs_tmp i get g_gs_fx00 i
  end
end

fn gs_store_init to void
  put g_gs_cnt 0 0
  for i ulong 16
    put g_gs_kind i 0
  end
end

fn gs_store_find_tmp to long
  n = get g_gs_cnt 0
  for idx ulong n bound 16
    base = mul idx 32
    same = ulong 1
    for j ulong 32
      if ne get g_gs_sid add base j get g_gs_tmp j
        same = 0
      end
    end
    if eq same 1
      ret long idx
    end
  end
  ret -1
end

fn gs_store_insert n ulong kind ulong to ulong
  gs_load_fx n
  if eq kind GS_ADM_BOOTSTRAP
    if eq gs_genesis_contains_tmp 0
      ret GS_GENESIS_NOT_LISTED
    end
  end
  found = gs_store_find_tmp
  if ge found 0
    if eq get g_gs_kind ulong found kind
      ret GS_OK
    end
    ret GS_GENESIS_NOT_LISTED
  end
  cnt = get g_gs_cnt 0
  if ge cnt GS_MAX_OBJS
    ret 99
  end
  base = mul cnt 32
  for j ulong 32
    put g_gs_sid add base j get g_gs_tmp j
    put g_gs_rcpt add base j 0xa0
  end
  put g_gs_rcpt base uchar and n 255
  put g_gs_kind cnt kind
  put g_gs_cnt 0 add cnt 1
  ret GS_OK
end

fn gs_store_kind n ulong to long
  gs_load_fx n
  found = gs_store_find_tmp
  if lt found 0
    ret -1
  end
  ret long get g_gs_kind ulong found
end

fn gs_store_flip n ulong kind ulong to long
  gs_load_fx n
  found = gs_store_find_tmp
  if lt found 0
    ret -1
  end
  put g_gs_kind ulong found kind
  ret 0
end

fn gs_store_save to ulong
  cnt = get g_gs_cnt 0
  pos = ulong 0
  put g_gs_wire pos uchar and cnt 255
  pos = add pos 1
  for idx ulong cnt bound 16
    base = mul idx 32
    for j ulong 32
      put g_gs_wire pos get g_gs_sid add base j
      pos = add pos 1
    end
    for j ulong 32
      put g_gs_wire pos get g_gs_rcpt add base j
      pos = add pos 1
    end
    put g_gs_wire pos uchar and get g_gs_kind idx 255
    pos = add pos 1
  end
  put g_gs_wlen 0 pos
  ret GS_OK
end

fn gs_store_load to ulong
  gs_store_init
  wlen = get g_gs_wlen 0
  if eq wlen 0
    ret 99
  end
  cnt = ulong get g_gs_wire 0
  if gt cnt GS_MAX_OBJS
    ret 99
  end
  pos = ulong 1
  for idx ulong cnt bound 16
    if gt add pos 65 wlen
      gs_store_init
      ret 99
    end
    for j ulong 32
      put g_gs_tmp j get g_gs_wire add pos j
    end
    kind = ulong get g_gs_wire add pos 64
    if eq kind GS_ADM_BOOTSTRAP
      if eq gs_genesis_contains_tmp 0
        gs_store_init
        ret GS_GENESIS_NOT_LISTED
      end
    end
    base = mul idx 32
    for j ulong 32
      put g_gs_sid add base j get g_gs_tmp j
      put g_gs_rcpt add base j get g_gs_wire add add pos 32 j
    end
    put g_gs_kind idx kind
    put g_gs_cnt 0 add idx 1
    pos = add pos 65
  end
  ret GS_OK
end

fn gs_admit_genesis n ulong st_out edit ulong 2 to ulong
  rc = gs_store_insert n GS_ADM_BOOTSTRAP
  if eq rc GS_OK
    put st_out 0 GS_OK
    put st_out 1 0
    ret GS_OK
  end
  put st_out 0 rc
  put st_out 1 1
  ret GS_RES_UNVERIFIED_DEP
end

fn gs_resolve_one n ulong dom ulong has_blobs ulong st_out edit ulong 2 to ulong
  gs_load_fx n
  found = gs_store_find_tmp
  if lt found 0
    put st_out 0 0
    put st_out 1 0
    ret GS_RES_UNVERIFIED_DEP
  end
  kind = get g_gs_kind ulong found
  if eq kind GS_ADM_BOOTSTRAP
    if eq gs_genesis_contains_tmp 0
      put st_out 0 GS_GENESIS_NOT_LISTED
      put st_out 1 0
      ret GS_RES_UNVERIFIED_DEP
    end
  end
  if and eq dom GS_DOM_BUILD eq has_blobs 0
    put st_out 0 0
    put st_out 1 0
    ret GS_RES_UNVERIFIED_DEP
  end
  put st_out 0 GS_OK
  put st_out 1 1
  ret GS_OK
end

fn gs_test_list to long
  if ne gs_genesis_count 1
    ret 10
  end
  if ne gs_genesis_member_ok 0 1
    ret 11
  end
  if ne gs_genesis_member_ok 1 0
    ret 12
  end
  gs_load_fx 0x10
  if ne gs_genesis_contains_tmp 1
    ret 13
  end
  gs_load_fx 0x11
  if ne gs_genesis_contains_tmp 0
    ret 14
  end
  gs_load_fx 0x00
  if ne gs_genesis_contains_tmp 0
    ret 15
  end
  note 1-bit flip at every byte position 0..31 must not match
  for pos ulong 32
    gs_load_fx 0x10
    put g_gs_tmp pos xor get g_gs_tmp pos 1
    if ne gs_genesis_contains_tmp 0
      ret 16
    end
  end
  note zero ID never a member
  for i ulong 32
    put g_gs_tmp i 0
  end
  if ne gs_genesis_contains_tmp 0
    ret 17
  end
  ret 0
end

fn gs_test_store to long
  gs_store_init
  if ne gs_store_insert 0x10 GS_ADM_BOOTSTRAP GS_OK
    ret 20
  end
  if ne gs_store_kind 0x10 long GS_ADM_BOOTSTRAP
    ret 21
  end
  if ne gs_store_insert 0x11 GS_ADM_BOOTSTRAP GS_GENESIS_NOT_LISTED
    ret 22
  end
  if ne get g_gs_cnt 0 1
    ret 23
  end
  if ne gs_store_insert 0x11 GS_ADM_VERIFIED GS_OK
    ret 24
  end
  if ne gs_store_kind 0x11 long GS_ADM_VERIFIED
    ret 25
  end
  if ne gs_store_insert 0x11 GS_ADM_BOOTSTRAP GS_GENESIS_NOT_LISTED
    ret 26
  end
  if ne gs_store_save GS_OK
    ret 27
  end
  if ne gs_store_load GS_OK
    ret 28
  end
  if ne get g_gs_cnt 0 2
    ret 29
  end
  if ne gs_store_kind 0x10 long GS_ADM_BOOTSTRAP
    ret 30
  end
  note Tamper: flip unlisted 0x11 to BOOTSTRAP, save, and verify load refuses it
  if ne gs_store_flip 0x11 GS_ADM_BOOTSTRAP 0
    ret 31
  end
  if ne gs_store_save GS_OK
    ret 32
  end
  if ne gs_store_load GS_GENESIS_NOT_LISTED
    ret 33
  end
  if ne get g_gs_cnt 0 0
    ret 34
  end
  ret 0
end

fn gs_test_admit_and_resolve to long
  st = new ulong 2 0
  gs_store_init
  if ne gs_admit_genesis 0x10 st GS_OK
    ret 40
  end
  if ne gs_store_kind 0x10 long GS_ADM_BOOTSTRAP
    ret 41
  end
  if ne gs_admit_genesis 0x11 st GS_RES_UNVERIFIED_DEP
    ret 42
  end
  if ne get st 0 GS_GENESIS_NOT_LISTED
    ret 43
  end
  if ne get g_gs_cnt 0 1
    ret 44
  end

  note Resolver checks on listed 0x10
  if ne gs_resolve_one 0x10 GS_DOM_BUILD 1 st GS_OK
    ret 50
  end
  if ne gs_resolve_one 0x10 GS_DOM_BUILD 0 st GS_RES_UNVERIFIED_DEP
    ret 51
  end
  if ne gs_resolve_one 0x10 GS_DOM_DEV 0 st GS_OK
    ret 52
  end

  note Tampered listed 0x10 (verified -> bootstrap) is still accepted by resolver
  gs_store_init
  if ne gs_store_insert 0x10 GS_ADM_VERIFIED GS_OK
    ret 53
  end
  if ne gs_store_flip 0x10 GS_ADM_BOOTSTRAP 0
    ret 54
  end
  if ne gs_resolve_one 0x10 GS_DOM_BUILD 1 st GS_OK
    ret 55
  end

  note Tampered unlisted 0x11 (verified -> bootstrap) is refused by resolver
  gs_store_init
  if ne gs_store_insert 0x11 GS_ADM_VERIFIED GS_OK
    ret 56
  end
  if ne gs_store_flip 0x11 GS_ADM_BOOTSTRAP 0
    ret 57
  end
  if ne gs_resolve_one 0x11 GS_DOM_BUILD 1 st GS_RES_UNVERIFIED_DEP
    ret 58
  end
  if ne get st 0 GS_GENESIS_NOT_LISTED
    ret 59
  end
  if ne get st 1 0
    ret 60
  end
  ret 0
end

fn main to int
  gs_init_fixtures
  rc = gs_test_list
  if ne rc 0
    ign = write 1 t_gs_fail 0 len t_gs_fail
    ret int rc
  end
  rc = gs_test_store
  if ne rc 0
    ign = write 1 t_gs_fail 0 len t_gs_fail
    ret int rc
  end
  rc = gs_test_admit_and_resolve
  if ne rc 0
    ign = write 1 t_gs_fail 0 len t_gs_fail
    ret int rc
  end
  ign = write 1 t_gs_pass 0 len t_gs_pass
  ret 0
end

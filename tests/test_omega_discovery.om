note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & C-oracle parity test for src/omega_discovery.om.
om2

text disc_p0_gold "8c3e0eac3ae4db433d7c9325bfba2e1c8c71685af76cdbfe71b0258f882e6c99"
text disc_abs_gold "74bbfb3c70f5bfea1ae91a16d6276d296208331a383abdc4e676bec1647f3307"
text msg_pass "OMEGA_DISCOVERY_OM_PASS\n"
text msg_fail "OMEGA_DISCOVERY_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_discovery_all to void
  omega_corpus_init
  chk eq omega_corpus_populate_benchmark 0
  chk eq get g_corp_cnt 0 4
  chk eq omega_corpus_total_cost 28
  chk eq get g_corp_clen 0 28

  note Verify P0 code SHA-256 matches C oracle
  for i ulong 28
    put sh_dat i get g_corp_code i
  end
  sh_all 28
  d0 = new uchar 32 0
  for i ulong 32
    put d0 i get sh_dig i
  end
  chk_hex32 d0 disc_p0_gold

  note Discover abstractions
  chk eq omega_discover_abstractions 0
  chk eq get g_disc_cnt 0 1
  chk eq get g_disc_best 0 0
  chk eq get g_disc_occ_cnt 0 4
  chk eq get g_disc_slen 0 4
  chk eq get g_disc_score 0 7
  chk eq get g_disc_ver 0 1
  chk eq get g_disc_clen 0 20

  note Verify discovered abstraction code SHA-256 matches C oracle
  for i ulong 20
    put sh_dat i get g_disc_code i
  end
  sh_all 20
  da = new uchar 32 0
  for i ulong 32
    put da i get sh_dig i
  end
  chk_hex32 da disc_abs_gold

  note Refactor P0 and verify semantic preservation
  chk eq omega_refactor_program 0 0 4 0
  chk eq get g_ref_icnt 0 4
  ins = new ulong 5 0
  put ins 0 0
  put ins 1 1
  put ins 2 2
  put ins 3 5
  put ins 4 10
  chk omega_verify_semantic_preservation 0 ins 5

  note Search acceleration
  cwo = new ulong 1 0
  cw = new ulong 1 0
  chk eq omega_demonstrate_search_acceleration cwo cw 0
  chk lt get cw 0 get cwo 0

  omega_corpus_destroy
  chk eq get g_corp_cnt 0 0
end

fn main to int
  test_discovery_all
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

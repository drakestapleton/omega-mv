note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/bw_encode_control_test.c.
note Verifies that every SM121 opcode accepted by omega_blackwell_encode_one preserves the
note scheduled control word (stall 9..12, yield 13, wbar 14..16, rbar 17..19, wait 20..25)
note in instruction word 3 across all 4 (pred, uniform) forms and both sentinel patterns.
note Host-only, CPU-only, zero GPU access.
om2

const BW_CTL_FIELD uint 0x03fffe00
const BW_CTL_SENT0 uint 0x02a94600
const BW_CTL_SENT1 uint 0x015eb800

text t_ctl_pass "PASS test_bw_encode_control\n"
text t_ctl_fail "FAIL test_bw_encode_control\n"

fn check_one_ctl op ulong form ulong sent uint to long
  row = new ulong 8 0
  w = new uint 4 0
  is_pred = and form 1
  uni = shr form 1
  put row 0 op
  put row 1 4
  put row 2 6
  put row 3 8
  put row 4 10
  put row 5 4
  put row 6 or ulong 2 shl ulong sent 32
  put row 7 or uni shl is_pred 1
  rc = omega_blackwell_encode_one row w
  if ne rc 0
    ret 0
  end
  got = and get w 3 BW_CTL_FIELD
  want = and sent BW_CTL_FIELD
  if ne got want
    ret -1
  end
  ret 1
end

fn main to int
  checked = ulong 0
  refused = ulong 0
  bad = ulong 0
  for op ulong 64
    for form ulong 4
      acc = ulong 0
      r0 = check_one_ctl op form BW_CTL_SENT0
      if eq r0 1
        acc = 1
        checked = add checked 1
      end
      if eq r0 -1
        acc = 1
        checked = add checked 1
        bad = add bad 1
      end
      r1 = check_one_ctl op form BW_CTL_SENT1
      if eq r1 1
        acc = 1
        checked = add checked 1
      end
      if eq r1 -1
        acc = 1
        checked = add checked 1
        bad = add bad 1
      end
      if and eq acc 0 eq form 0
        refused = add refused 1
      end
    end
  end
  if or eq checked 0 ne bad 0
    ign = write 1 t_ctl_fail 0 len t_ctl_fail
    ret 1
  end
  ign = write 1 t_ctl_pass 0 len t_ctl_pass
  ret 0
end

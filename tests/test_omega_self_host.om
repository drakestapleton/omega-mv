note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit & C-oracle parity test for src/omega_self_host.om.
om2

text sh_gc_gold "f04bc52d3c30c79c664dff88854799af5ae7fb35ed8fc6db36bfc1d399e80d85"
text sh_c1_code_gold "8c9a69ff56881ffff14fcb3770abc440686e89aad8698d031e957aa01c4fc658"
text sh_c1_rid_gold "7109e9e21285aca2829c2fa43c35c1885779d59eb2cb1699e2db227c408e78a4"
text msg_pass "OMEGA_SELF_HOST_OM_PASS\n"
text msg_fail "OMEGA_SELF_HOST_OM_FAIL\n"

global g_fail ulong 1

fn chk cond bool to void
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_hex32 dig view uchar * gold view uchar * to void
  for i ulong 32
    b = uint get dig i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_self_host_all to void
  chk eq omega_self_host_bootstrap_sequence 0
  chk eq get g_sh_c1_len 0 220
  chk eq get g_sh_c2_len 0 220
  chk eq get g_sh_c3_len 0 220

  note Verify G_C semantic ID matches C oracle
  gcid = new uchar 32 0
  for i ulong 32
    put gcid i get g_sh_gc_id i
  end
  chk_hex32 gcid sh_gc_gold

  note Verify C1 machine code SHA-256 matches C oracle
  for i ulong 220
    put sh_dat i get g_sh_c1 i
  end
  sh_all 220
  cdig = new uchar 32 0
  for i ulong 32
    put cdig i get sh_dig i
  end
  chk_hex32 cdig sh_c1_code_gold

  note Verify C1 realization ID matches C oracle
  rid = new uchar 32 0
  for i ulong 32
    put rid i get g_sh_c1_rid i
  end
  chk_hex32 rid sh_c1_rid_gold

  note Verify M5 parity (C1 compiles G_S -> 12B M5 -> exec(7,11,3) == 15)
  obs = new ulong 1 0
  chk eq omega_self_host_verify_m5_parity obs 0
  chk eq get obs 0 15
end

fn main to int
  test_self_host_all
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_genesis.c.
note Verifies the pinned Genesis Set VC-GENESIS-1 invariants: count == 0,
note bounded member lookup, zero/junk IDs excluded, audit record docs/osc/VC-GENESIS-1.md
note states "Members: 0" with zero 64-hex IDs, and src/omega_genesis.om contains no
note environment/file/CLI/preprocessor switches.
note Host-only, CPU-only, zero GPU access.
om2

const GEN_PINNED_COUNT ulong 0

text t_gen_doc_path "docs/osc/VC-GENESIS-1.md"
text t_gen_src_path "src/omega_genesis.om"
text t_gen_want_mem "\nMembers: 0\n"
text t_gen_hdr_mem "\nMembers: "
text t_gen_bad0 "getenv"
text t_gen_bad1 "fopen"
text t_gen_bad2 "#ifdef"
text t_gen_bad3 "#ifndef"
text t_gen_bad4 "#if "
text t_gen_bad5 "#elif"
text t_gen_bad6 "#include"
text t_gen_bad7 "extern "
text t_gen_bad8 "argv"
text t_gen_bad9 "argc"
text t_gen_bad10 "arglen"
text t_gen_bad11 "argbyte"
text t_gen_bad12 "envlen"
text t_gen_bad13 "envbyte"
text t_gen_bad14 "read "
text t_gen_src_cnt "const OMEGA_GENESIS_1_COUNT ulong 0"
text t_gen_src_name "text OMEGA_GENESIS_SET_NAME \"VC-GENESIS-1\""

text t_gen_pass "PASS test_omega_genesis\n"
text t_gen_fail "FAIL test_omega_genesis\n"

global g_gen_buf uchar 32768

fn gen_slurp path view uchar * plen ulong to long
  fd = fopen path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  total = ulong 0
  while lt total 32768 bound 64
    got = read int fd g_gen_buf total sub 32768 total
    if le got 0
      ign = fclose int fd
      ret long total
    end
    total = add total ulong got
  end
  ign = fclose int fd
  ret long total
end

fn gen_find_buf n ulong pat view uchar * pn ulong to long
  if or eq pn 0 gt pn n
    ret -1
  end
  lim = add sub n pn 1
  for i ulong lim bound 32768
    ok = ulong 1
    for j ulong pn bound 128
      if ne get g_gen_buf add i j get pat j
        ok = 0
      end
    end
    if eq ok 1
      ret long i
    end
  end
  ret -1
end

fn gen_is_lhex c uchar to bool
  if and ge c 48 le c 57
    ret true
  end
  if and ge c 97 le c 102
    ret true
  end
  ret false
end

fn gen_count_hex64 n ulong to ulong
  runs = ulong 0
  run = ulong 0
  for i ulong n bound 32768
    if gen_is_lhex get g_gen_buf i
      run = add run 1
    else
      if eq run 64
        runs = add runs 1
      end
      run = 0
    end
  end
  if eq run 64
    runs = add runs 1
  end
  ret runs
end

fn gen_check_doc to long
  dn = gen_slurp t_gen_doc_path len t_gen_doc_path
  if le dn 0
    ret 10
  end
  un = ulong dn
  p_want = gen_find_buf un t_gen_want_mem len t_gen_want_mem
  p_any = gen_find_buf un t_gen_hdr_mem len t_gen_hdr_mem
  if or lt p_want 0 ne p_want p_any
    ret 11
  end
  if ne gen_count_hex64 un GEN_PINNED_COUNT
    ret 12
  end
  ret 0
end

fn gen_check_src to long
  hn = gen_slurp t_gen_src_path len t_gen_src_path
  if le hn 0
    ret 20
  end
  un = ulong hn
  if lt gen_find_buf un t_gen_src_name len t_gen_src_name 0
    ret 21
  end
  if lt gen_find_buf un t_gen_src_cnt len t_gen_src_cnt 0
    ret 22
  end
  if ge gen_find_buf un t_gen_bad0 len t_gen_bad0 0
    ret 23
  end
  if ge gen_find_buf un t_gen_bad1 len t_gen_bad1 0
    ret 24
  end
  if ge gen_find_buf un t_gen_bad2 len t_gen_bad2 0
    ret 25
  end
  if ge gen_find_buf un t_gen_bad3 len t_gen_bad3 0
    ret 26
  end
  if ge gen_find_buf un t_gen_bad4 len t_gen_bad4 0
    ret 27
  end
  if ge gen_find_buf un t_gen_bad5 len t_gen_bad5 0
    ret 28
  end
  if ge gen_find_buf un t_gen_bad6 len t_gen_bad6 0
    ret 29
  end
  if ge gen_find_buf un t_gen_bad7 len t_gen_bad7 0
    ret 30
  end
  if ge gen_find_buf un t_gen_bad8 len t_gen_bad8 0
    ret 31
  end
  if ge gen_find_buf un t_gen_bad9 len t_gen_bad9 0
    ret 32
  end
  if ge gen_find_buf un t_gen_bad10 len t_gen_bad10 0
    ret 33
  end
  if ge gen_find_buf un t_gen_bad11 len t_gen_bad11 0
    ret 34
  end
  if ge gen_find_buf un t_gen_bad12 len t_gen_bad12 0
    ret 35
  end
  if ge gen_find_buf un t_gen_bad13 len t_gen_bad13 0
    ret 36
  end
  if ge gen_find_buf un t_gen_bad14 len t_gen_bad14 0
    ret 37
  end
  ret 0
end

fn gen_check_api to long
  if ne len OMEGA_GENESIS_SET_NAME 12
    ret 40
  end
  if ne omega_genesis_count GEN_PINNED_COUNT
    ret 41
  end
  if omega_genesis_member_ok 0
    ret 42
  end
  id = new uchar 32 0
  if omega_genesis_contains id
    ret 43
  end
  for i ulong 32
    put id i uchar add i 1
  end
  if omega_genesis_contains id
    ret 44
  end
  ret 0
end

fn main to int
  if ne gen_check_api 0
    ign = write 1 t_gen_fail 0 len t_gen_fail
    ret 1
  end
  if ne gen_check_doc 0
    ign = write 1 t_gen_fail 0 len t_gen_fail
    ret 2
  end
  if ne gen_check_src 0
    ign = write 1 t_gen_fail 0 len t_gen_fail
    ret 3
  end
  ign = write 1 t_gen_pass 0 len t_gen_pass
  ret 0
end

note SPDX-License-Identifier: AGPL-3.0-only
note Compose in om/units.sh order, removing export markers for program mode.
note Two upper Entity nodes with a part_of edge. An incident edge is traversed
note in both directions, even though ontology validation uses its declared direction.
fn ar_fixture r edit uint 16 to void
  put r 0 ar_record_v1
  put r 1 1
  put r 2 2
  put r 3 1
  put r 4 2
  put r 5 ar_one
  put r 13 1
  put r 14 1
  put r 15 ar_one
end

fn ar_test_load to int
  r = new uint 16 0
  t = new uint 8 55
  w = new uint 2 66
  ar_fixture r
  put r 4 0
  if ne arboris_load_records r t w 4
    ret 1
  end
  put r 4 2
  put r 14 2
  if ne arboris_load_records r t w 4
    ret 2
  end
  put r 14 1
  put r 13 13
  if ne arboris_load_records r t w 4
    ret 3
  end
  put r 1 2
  put r 6 7
  if ne arboris_load_records r t w 3
    ret 4
  end
  if or ne get t 7 55 ne get w 0 66
    ret 5
  end
  put r 7 5
  put r 9 6
  put r 10 3
  put r 13 1
  if ne arboris_load_records r t w 0
    ret 6
  end
  if or ne get t 6 1 ne get t 7 0
    ret 7
  end
  ret 0
end

fn ar_test_wave to int
  r = new uint 16 0
  t = new uint 8 0
  w = new uint 2 0
  state = new uint 20 0
  ar_fixture r
  if ne arboris_load_records r t w 0
    ret 8
  end
  put state 0 2
  put state 2 0x3f000000
  put state 3 0x3f000000
  put state 4 ar_one
  put state 6 ar_one
  put state 9 ar_one
  put state 11 ar_one
  if ne arboris_spread_step t w state 0
    ret 9
  end
  if or ne get state 15 0x3f000000 ne get state 18 0x3f000000
    ret 10
  end
  if or ne get state 13 ar_one ne get state 16 ar_one
    ret 11
  end
  put state 2 0x3e800000
  if ne arboris_spread_step t w state 0
    ret 12
  end
  if or ne get state 4 0 ne get state 9 0
    ret 13
  end
  if or ne get state 7 0x3f000000 ne get state 10 0x3f000000
    ret 14
  end
  put state 2 0
  if or ne arboris_spread_step t w state 0 ne get state 1 0
    ret 15
  end
  put t 6 2
  if ne arboris_spread_step t w state 2
    ret 16
  end
  if ne ar_product 1 0x3f000000 0
    ret 17
  end
  if ne ar_product 3 0x3f000000 2
    ret 18
  end
  ret 0
end

fn ar_test_relax to int
  topo = new uint 9 0
  weights = new uint 2 ar_one
  state = new uint 16 0
  put topo 0 ar_topo_v1
  put topo 1 3
  put topo 2 2
  put topo 5 1
  put topo 6 2
  put topo 8 1
  put state 0 2
  put state 2 0x3f000000
  put state 4 ar_one
  put state 8 ar_one
  if ne arboris_relax_step topo weights state 0
    ret 21
  end
  if or ne get state 11 0x3f000000 ne get state 15 0x3f000000
    ret 22
  end
  if ne arboris_relax_step topo weights state 0
    ret 23
  end
  if or ne get state 6 0x3e800000 ne get state 8 ar_one
    ret 24
  end
  put state 4 0x7fc00000
  if or ne arboris_relax_step topo weights state 3 ne get state 1 0
    ret 25
  end
  ret 0
end

fn main to int
  rc = ar_test_load
  if ne rc 0
    ret rc
  end
  rc = ar_test_wave
  if ne rc 0
    ret rc
  end
  ret ar_test_relax
end

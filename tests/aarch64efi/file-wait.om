target aarch64efi
text path "\\TEST.TXT"
text done "ARM FILE WAIT FLOAT PASS\n"
fn main to int
buf = new uchar 64 0
for i ulong len path
put buf i get path i
end
r = efi 12 65280 buf 0 len path
if ne r 5
ret 71
end
r = efi 12 65282 buf 0 64
if ne r 5
ret 72
end
if ne get buf 0 104
ret 73
end
r = efi 12 65284 buf 0 0
if ne r 0
ret 74
end
v = 1.25f64
r = efi 15 100 buf 0 0
if ne r 0
ret 75
end
for wait ulong 4
r = efi 15 mul wait 3 buf 0 0
if ne r 0
ret 77
end
end
v = mul v 2.0
if ne v 2.5
ret 76
end
for j ulong len done
put buf j get done j
end
r = efi 13 0 buf 0 len done
ret 0
end

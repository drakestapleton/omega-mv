target aarch64efi
text payload "address"
text pass "ARM ADDRESS PASS\n"
global store ulong 4096
global output uchar 64
fn copy a view uchar 7 to ulong
v = ulong 0
for i ulong len a
v = add v ulong get a i
end
ret v
end
fn main to int
note Literal numeric addresses must not be relocated with text or pool addresses.
n = ulong 4194304
if ne n 4194304
ret 71
end
for i ulong 4096
put store i add n i
end
if ne get store 4095 add n 4095
ret 72
end
if ne copy payload 742
ret 73
end
for j ulong len pass
put output j get pass j
end
r = efi 13 0 output 0 len pass
ret 0
end

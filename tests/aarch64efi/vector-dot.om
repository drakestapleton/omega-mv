note Independent scalar/vector oracle: ordered updates, aliases, subnormals, signed zero and NaNs.
global VD f64 4
global VW f64 4
global VO uchar 8
fn vbits i ulong to ulong
if eq i 0
ret 0
end
if eq i 1
ret 9223372036854775808
end
if eq i 2
ret 1
end
if eq i 3
ret 4503599627370495
end
if eq i 4
ret 4503599627370496
end
if eq i 5
ret 4607182418800017408
end
if eq i 6
ret 13830554455654793216
end
if eq i 7
ret 9218868437227405311
end
if eq i 8
ret 9218868437227405312
end
if eq i 9
ret 18442240474082181120
end
if eq i 10
ret 9221120237041090626
end
if eq i 11
ret 9218868437227405313
end
if eq i 12
ret 18444492273895866369
end
ret 4607182418766462976
end
fn pairtest to int
for i ulong 14
for j ulong 14
for k ulong 14
put VD 0 bitcast f64 vbits i
put VD 1 bitcast f64 vbits j
put VW 0 bitcast f64 vbits j
put VW 1 bitcast f64 vbits k
a = bitcast f64 vbits k
s0 = add get VD 0 mul a get VW 0
s1 = add get VD 1 mul a get VW 1
vmadd2 VD 0 VW 0 a
if ne bitcast ulong get VD 0 bitcast ulong s0
ret 1
end
if ne bitcast ulong get VD 1 bitcast ulong s1
ret 2
end
end
end
end
note Distinguishes separate rounding from fused arithmetic.
put VD 0 -1.0f64
put VD 1 -1.0f64
put VW 0 0.9999999925494194f64
put VW 1 0.9999999925494194f64
vmadd2 VD 0 VW 0 1.0000000074505806f64
if ne bitcast ulong get VD 0 0
ret 3
end
note Overlapping source/destination use both original source lanes.
put VD 0 2.0f64
put VD 1 3.0f64
put VD 2 5.0f64
vmadd2 VD 1 VD 0 7.0f64
if ne get VD 1 17.0f64
ret 4
end
if ne get VD 2 26.0f64
ret 5
end
ret 0
end

global VX f64 16
global VM f64 128
fn main to int
if ne pairtest 0
ret 1
end
for a ulong 14
for b ulong 14
for c ulong 14
put VX 0 bitcast f64 vbits a
put VM 0 bitcast f64 vbits b
put VM 1 bitcast f64 vbits c
put VM 2 bitcast f64 vbits a
put VM 3 bitcast f64 vbits b
vdot4 VD VX 0 VM 0 1 4
for j ulong 4
v = add 0.0f64 mul get VX 0 get VM j
if ne bitcast ulong v bitcast ulong get VD j
ret 2
end
end
end
end
end
note Multiple rows, gaps, nonzero offsets and zero rows.
for i ulong 16
put VX i div f64 add i 1 7.0f64
end
for i ulong 128
put VM i sub div f64 i 3.0f64 7.0f64
end
for r ulong 12
vdot4 VD VX 2 VM 3 r 8
for j ulong 4
v = 0.0f64
for i ulong r
v = add v mul get VX add i 2 get VM add add 3 mul i 8 j
end
if ne bitcast ulong v bitcast ulong get VD j
ret 3
end
end
end
ret 0
end

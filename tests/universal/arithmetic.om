om2
note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/universal/arithmetic.c.
note Reads decimal uint64 pairs (a b) from stdin; exits 2 if b == 0;
note prints "(a+b) (a-b) (a*b) (a/b)\n" mod 2^64 to stdout.

global g_ibuf uchar 4096
global g_ipos ulong 1
global g_ilen ulong 1
global g_eof  ulong 1

global g_obuf uchar 4096
global g_olen ulong 1
global g_tmpd uchar 24

fn out_flush to void
  n = get g_olen 0
  if gt n 0
    ign = write 1 g_obuf 0 n
    put g_olen 0 0
  end
end

fn out_c c uchar to void
  n = get g_olen 0
  if ge n 4096
    out_flush
    n = ulong 0
  end
  put g_obuf n c
  put g_olen 0 add n 1
end

fn out_u64 v ulong to void
  if eq v 0
    out_c uchar 48
    ret
  end
  n = ulong 0
  x = v
  while gt x 0 bound 24
    put g_tmpd n uchar add 48 rem x 10
    n = add n 1
    x = div x 10
  end
  while gt n 0 bound 24
    n = sub n 1
    out_c get g_tmpd n
  end
end

fn next_byte to int
  pos = get g_ipos 0
  lim = get g_ilen 0
  if ge pos lim
    if ne get g_eof 0 0
      ret -1
    end
    got = read 0 g_ibuf 0 4096
    if le got 0
      put g_eof 0 1
      ret -1
    end
    put g_ilen 0 ulong got
    put g_ipos 0 0
    pos = ulong 0
  end
  b = get g_ibuf pos
  put g_ipos 0 add pos 1
  ret int b
end

fn is_space ch int to bool
  if eq ch 32
    ret true
  end
  if eq ch 10
    ret true
  end
  if eq ch 13
    ret true
  end
  if eq ch 9
    ret true
  end
  ret false
end

fn read_u64 dst edit ulong 1 to int
  ch = int -1
  while true bound 1000000
    ch = next_byte
    if lt ch 0
      ret 0
    end
    if not is_space ch
      break
    end
  end
  if or lt ch 48 gt ch 57
    ret -1
  end
  v = ulong sub ch 48
  while true bound 1000000
    ch = next_byte
    if lt ch 0
      break
    end
    if or lt ch 48 gt ch 57
      break
    end
    v = add mul v 10 ulong sub ch 48
  end
  put dst 0 v
  ret 1
end

fn main to int
  va = new ulong 1 0
  vb = new ulong 1 0
  while true bound 1000000
    ra = read_u64 va
    if le ra 0
      break
    end
    rb = read_u64 vb
    if le rb 0
      break
    end
    a = get va 0
    b = get vb 0
    if eq b 0
      out_flush
      ret 2
    end
    out_u64 add a b
    out_c uchar 32
    out_u64 sub a b
    out_c uchar 32
    out_u64 mul a b
    out_c uchar 32
    out_u64 div a b
    out_c uchar 10
  end
  out_flush
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_gpu_1_silicon.om: Live GB10 silicon value/parity test for
note wave gb10-gpu-1 (pure seeded OM-2, zero CUDA, static AArch64 ELF).
om2

text s_hdr "=== GB10 LIVE SILICON TEST: wave gb10-gpu-1 (pure seeded OM-2, zero CUDA) ===\n"
text s_v1 "  [1] obws_execute_vector n=64  (cold open + C3 L2 flush): "
text s_v2 "  [2] obws_execute_vector n=257 (persistent reuse, non-warp-multiple): "
text s_v3 "  [3] obws_execute_vector n=1024 (32-bit wraparound + oracle): "
text s_pl "  [4] ogpl + ogmc_alloc_cached live GB10 DMA + L2_INVAL_PREFIX: "
text s_ok "PASS"
text s_fail "FAIL rc="
text s_dbg " fail="
text s_st " state="
text s_stp " step="
text s_nv " nvstage="
text s_m1 " marker1=0x"
text s_m2 " marker2=0x"
text s_sem " sem="
text s_ns " elapsed_ns="
text s_cuda "  [5] zero-CUDA verification (static ELF + /proc/self/maps): PASS\n"
text s_done "PASS test-gb10-gpu-1-silicon (all live GB10 silicon checks + zero-CUDA verified)\n"
text s_nl "\n"

fn s_print s view uchar * to void
r = write 1 s 0 len s
end

fn s_print_u x ulong to void
b = new uchar 24 0
pos = ulong 24
v = x
while true
pos = sub pos 1
put b pos uchar add 48 rem v 10
v = div v 10
if eq v 0
r = write 1 b pos sub 24 pos
ret
end
end
end

fn s_print_hex x ulong to void
b = new uchar 16 0
pos = ulong 16
v = x
while true
pos = sub pos 1
d = rem v 16
if lt d 10
put b pos uchar add 48 d
else
put b pos uchar add 87 d
end
v = div v 16
if eq v 0
r = write 1 b pos sub 16 pos
ret
end
end
end

fn run_vec_case n ulong seed_a ulong seed_b ulong to ulong
a = new uint 1024 0
b = new uint 1024 0
dst = new uint 1024 0
for i ulong n
va = add mul i 2654435761 seed_a
vb = add mul i 2246822519 seed_b
put a i uint and va 0xffffffff
put b i uint and vb 0xffffffff
put dst i 0
end
einfo = new ulong 10 0
rc = obws_execute_vector n a b dst einfo
if ne rc 0
s_print s_fail
s_print_u rc
s_print s_dbg
s_print_u get oge_last_res 0
s_print s_st
s_print_u get oge_last_res 1
s_print s_stp
s_print_u get oge_last_res 2
s_print s_nv
s_print_u ulong get nvstage 0
s_print s_nl
ret rc
end
if or ne get einfo 7 1 or ne get einfo 8 1 ne get einfo 9 1
s_print s_fail
s_print_u 99
s_print s_nl
ret 99
end
s_print s_ok
s_print s_m1
s_print_hex get einfo 4
s_print s_m2
s_print_hex get einfo 5
s_print s_sem
s_print_u get einfo 6
s_print s_ns
s_print_u get einfo 3
s_print s_nl
ret 0
end

fn run_platform_live_case to ulong
ogpl_set_mock 0
ogpl_reset_state
dev = new ulong 2 0
rc = ogpl_device_open 0 dev
if ne rc OGP_OK
ret add 200 rc
end
hc = new ulong 2 0
inf = new ulong 3 0
rc = ogmc_alloc_cached get dev 0 get dev 1 8192 hc inf
if ne rc OGP_OK
ign = ogpl_device_close get dev 0 get dev 1
ret add 220 rc
end
rc = ogpl_sync_to_gpu get hc 0 get hc 1 0 8192
if ne rc OGP_OK
ign = ogpl_device_close get dev 0 get dev 1
ret add 240 rc
end
if ne get ogpl_l2_pending 0 1
ign = ogpl_device_close get dev 0 get dev 1
ret 245
end
rc = ogpl_dma_free get hc 0 get hc 1
if ne rc OGP_OK
ign = ogpl_device_close get dev 0 get dev 1
ret add 260 rc
end
rc = ogpl_device_close get dev 0 get dev 1
if ne rc OGP_OK
ret add 280 rc
end
ret 0
end

fn main to int
s_print s_hdr
if ne obws_verify_zero_libcuda_linkage 0
ret 10
end
if ne obws_verify_zero_cuda_symbols 0
ret 11
end
if ne obws_verify_zero_libcuda_runtime 0
ret 12
end

s_print s_v1
rc = run_vec_case 64 0x12345678 0x9abcdef0
if ne rc 0
ign = obwe_shutdown
ret int rc
end
if ne obwe_device_is_open 1
ign = obwe_shutdown
ret 20
end

s_print s_v2
rc = run_vec_case 257 0xdeadbeef 0x01020304
if ne rc 0
ign = obwe_shutdown
ret int rc
end

s_print s_v3
rc = run_vec_case 1024 0xfffffff0 0x00000100
if ne rc 0
ign = obwe_shutdown
ret int rc
end

if ne obwe_shutdown 0
ret 21
end
if ne obwe_device_is_open 0
ret 22
end

s_print s_pl
rc = run_platform_live_case
if ne rc 0
s_print s_fail
s_print_u rc
s_print s_nl
ret int rc
end
s_print s_ok
s_print s_nl
s_print s_cuda
s_print s_done
ret 0
end

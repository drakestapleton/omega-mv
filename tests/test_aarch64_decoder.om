note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/aarch64_decoder.om.
om2

text msg_pass "AARCH64_DECODER_OM_PASS\n"
text msg_fail "AARCH64_DECODER_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_decoder to void
  cells = new ulong 9 0
  note ADD X0, X1, X2
  w_add = ulong a64addreg 1 0 1 2
  chk eq aarch64_decode_instruction w_add cells 0
  chk eq get cells 0 1
  chk eq get cells 1 1
  chk eq get cells 2 0
  chk eq get cells 3 1
  chk eq get cells 4 2

  note MUL X6, X7, X8 (DECODED_MUL = 3)
  w_mul = ulong a64mulreg 1 6 7 8
  chk eq aarch64_decode_instruction w_mul cells 0
  chk eq get cells 0 3
  chk eq get cells 2 6
  chk eq get cells 3 7
  chk eq get cells 4 8

  note MOVZ X2, #0x1234, LSL #16 (DECODED_MOVZ = 7, hw = 1)
  w_movz = ulong a64movz 1 2 0x1234 16
  chk eq aarch64_decode_instruction w_movz cells 0
  chk eq get cells 0 7
  chk eq get cells 5 0x1234
  chk eq get cells 6 1

  note B.NE -5 (DECODED_B_COND = 10, raw 19-bit imm = 0x7fffb, cond = 1)
  w_bc = ulong a64bcond 1 -5
  chk eq aarch64_decode_instruction w_bc cells 0
  chk eq get cells 0 10
  chk eq get cells 7 0x7fffb
  chk eq get cells 8 1

  note RET (DECODED_RET = 8)
  w_ret = ulong a64ret
  chk eq aarch64_decode_instruction w_ret cells 0
  chk eq get cells 0 8

  note Invalid instruction word refused
  chk eq aarch64_decode_instruction ulong 0xffffffff cells -1

  note Code buffer validation: valid ADD + RET
  code = new uchar 16 0
  st = new ulong 2 0
  put st 0 0
  put st 1 16
  chk eq a64put code st a64addreg 1 0 1 2 0
  chk eq a64put code st a64ret 0
  emsg = new uchar 128 0
  chk eq aarch64_validate_code_buffer code 8 emsg 128 0

  note Refusals: empty, unaligned, missing RET, invalid insn
  chk ne aarch64_validate_code_buffer code 0 emsg 128 0
  chk ne aarch64_validate_code_buffer code 6 emsg 128 0
  chk ne aarch64_validate_code_buffer code 4 emsg 128 0
  put code 0 uchar 0xff
  put code 1 uchar 0xff
  put code 2 uchar 0xff
  put code 3 uchar 0xff
  chk ne aarch64_validate_code_buffer code 8 emsg 128 0
end

fn main to int
  test_decoder
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/test_omega_transc.c (host bounded-contract tiers).
note Verifies all 9 frozen FP32 transcendentals in src/omega_numeric_transc.om:
note   exp2, log2, sigmoid, tanh, rsqrt, erf, gelu, sin, cos
note Covers special values, NaN canonicalization, exact odd/even symmetries,
note monotonicity sweeps, and AArch64 C-oracle bit-exact golden vectors.
om2

text tr_pass "test_omega_transc: PASS\n"
text tr_fail "test_omega_transc: FAIL\n"

global g_tr_chk ulong 1
global g_tr_fail ulong 1

fn tr_chk cond bool to void
  put g_tr_chk 0 add get g_tr_chk 0 1
  if not cond
    put g_tr_fail 0 add get g_tr_fail 0 1
  end
end

fn test_specials to void
  note exp2
  tr_chk eq omega_math_exp2 uint 0x00000000 uint 0x3f800000
  tr_chk eq omega_math_exp2 uint 0x80000000 uint 0x3f800000
  tr_chk eq omega_math_exp2 uint 0x3f800000 uint 0x40000000
  tr_chk eq omega_math_exp2 uint 0xbf800000 uint 0x3f000000
  tr_chk eq omega_math_exp2 uint 0x43000000 TR_PINF
  tr_chk eq omega_math_exp2 uint 0xc3180000 uint 0
  tr_chk eq omega_math_exp2 TR_QNAN TR_QNAN
  tr_chk eq omega_math_exp2 uint 0x7fa00001 TR_QNAN

  note log2
  tr_chk eq omega_math_log2 uint 0x3f800000 uint 0x00000000
  tr_chk eq omega_math_log2 uint 0x40000000 uint 0x3f800000
  tr_chk eq omega_math_log2 uint 0x40800000 uint 0x40000000
  tr_chk eq omega_math_log2 uint 0x00000000 TR_NINF
  tr_chk eq omega_math_log2 uint 0x80000000 TR_NINF
  tr_chk eq omega_math_log2 uint 0xbf800000 TR_QNAN
  tr_chk eq omega_math_log2 TR_PINF TR_PINF

  note sigmoid, tanh, rsqrt
  tr_chk eq omega_math_sigmoid uint 0x00000000 uint 0x3f000000
  tr_chk eq omega_math_sigmoid uint 0x41900000 uint 0x3f800000
  tr_chk eq omega_math_sigmoid uint 0xc2d00000 uint 0x00000000
  tr_chk eq omega_math_tanh uint 0x00000000 uint 0x00000000
  tr_chk eq omega_math_tanh uint 0x80000000 uint 0x80000000
  tr_chk eq omega_math_rsqrt uint 0x3f800000 uint 0x3f800000
  tr_chk eq omega_math_rsqrt uint 0x40800000 uint 0x3f000000
  tr_chk eq omega_math_rsqrt uint 0x00000000 TR_PINF
  tr_chk eq omega_math_rsqrt uint 0x80000000 TR_NINF
  tr_chk eq omega_math_rsqrt uint 0xbf800000 TR_QNAN

  note erf, gelu, sin, cos
  tr_chk eq omega_math_erf uint 0x00000000 uint 0x00000000
  tr_chk eq omega_math_erf uint 0x80000000 uint 0x80000000
  tr_chk eq omega_math_gelu uint 0x00000000 uint 0x00000000
  tr_chk eq omega_math_gelu uint 0x80000000 uint 0x80000000
  tr_chk eq omega_math_gelu uint 0x00000001 uint 0x00000001
  tr_chk eq omega_math_gelu uint 0x80000001 uint 0x80000000
  tr_chk eq omega_math_sin uint 0x00000000 uint 0x00000000
  tr_chk eq omega_math_sin uint 0x80000000 uint 0x80000000
  tr_chk eq omega_math_cos uint 0x00000000 uint 0x3f800000
  tr_chk eq omega_math_cos uint 0x80000000 uint 0x3f800000
  tr_chk eq omega_math_sin uint 0x4b000000 TR_QNAN
  tr_chk eq omega_math_cos uint 0x4b000000 TR_QNAN
end

fn test_symmetries_and_monotonicity to void
  note Odd/even symmetries across 32 positive inputs
  for i ulong 32
    x = add uint 0x3d800000 mul uint i uint 0x00180000
    nx = xor x uint 0x80000000
    tr_chk eq omega_math_tanh nx xor omega_math_tanh x uint 0x80000000
    tr_chk eq omega_math_erf nx xor omega_math_erf x uint 0x80000000
    tr_chk eq omega_math_sin nx xor omega_math_sin x uint 0x80000000
    tr_chk eq omega_math_cos nx omega_math_cos x
  end

  note Monotonicity of exp2, log2, sigmoid, tanh, erf on positive ascending grid
  prev_e = omega_math_exp2 uint 0x3e000000
  prev_l = omega_math_log2 uint 0x3e000000
  prev_s = omega_math_sigmoid uint 0x3e000000
  prev_t = omega_math_tanh uint 0x3e000000
  prev_er = omega_math_erf uint 0x3e000000
  for i ulong 31
    x = add uint 0x3e100000 mul uint i uint 0x00100000
    ce = omega_math_exp2 x
    cl = omega_math_log2 x
    cs = omega_math_sigmoid x
    ct = omega_math_tanh x
    cer = omega_math_erf x
    tr_chk ge bitcast f32 ce bitcast f32 prev_e
    tr_chk ge bitcast f32 cl bitcast f32 prev_l
    tr_chk ge bitcast f32 cs bitcast f32 prev_s
    tr_chk ge bitcast f32 ct bitcast f32 prev_t
    tr_chk ge bitcast f32 cer bitcast f32 prev_er
    prev_e = ce
    prev_l = cl
    prev_s = cs
    prev_t = ct
    prev_er = cer
  end
end

fn test_golden_vectors to void
  note Bit-exact AArch64 C-oracle checks across all 9 transcendentals
  tr_chk eq omega_math_exp2 uint 0x3f000000 uint 0x3fb504f3
  tr_chk eq omega_math_log2 uint 0x3f000000 uint 0xbf800000
  tr_chk eq omega_math_sigmoid uint 0x3f000000 uint 0x3f1f597f
  tr_chk eq omega_math_tanh uint 0x3f000000 uint 0x3eec9a9f
  tr_chk eq omega_math_rsqrt uint 0x3f000000 uint 0x3fb504f3
  tr_chk eq omega_math_erf uint 0x3f000000 uint 0x3f053f7b
  tr_chk eq omega_math_gelu uint 0x3f000000 uint 0x3eb103af
  tr_chk eq omega_math_sin uint 0x3f000000 uint 0x3ef57744
  tr_chk eq omega_math_cos uint 0x3f000000 uint 0x3f60a940

  tr_chk eq omega_math_exp2 uint 0x3fc00000 uint 0x403504f3
  tr_chk eq omega_math_log2 uint 0x3fc00000 uint 0x3f15c01a
  tr_chk eq omega_math_sigmoid uint 0x3fc00000 uint 0x3f514c8f
  tr_chk eq omega_math_tanh uint 0x3fc00000 uint 0x3f67b7cc
  tr_chk eq omega_math_rsqrt uint 0x3fc00000 uint 0x3f5105ec
  tr_chk eq omega_math_erf uint 0x3fc00000 uint 0x3f7752ab
  tr_chk eq omega_math_gelu uint 0x3fc00000 uint 0x3fb32c4b
  tr_chk eq omega_math_sin uint 0x3fc00000 uint 0x3f7f5bd5
  tr_chk eq omega_math_cos uint 0x3fc00000 uint 0x3d90deaa
end

fn main to int
  test_specials
  test_symmetries_and_monotonicity
  test_golden_vectors
  if eq get g_tr_fail 0 0
    ign = write 1 tr_pass 0 len tr_pass
    ret 0
  end
  ign = write 1 tr_fail 0 len tr_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note tests/test_gb10_gpu_2_silicon.om: Live GB10 silicon value/parity test for
note wave gb10-gpu-2 (pure seeded OM-2, zero CUDA, static AArch64 ELF).
om2

text s_hdr "=== GB10 LIVE SILICON TEST: wave gb10-gpu-2 (pure seeded OM-2, zero CUDA) ===\n"
text s_t1 "  [1] zero-CUDA verification (static ELF + /proc/self/maps): "
text s_t2 "  [2] omega_gpu_session.om live GB10 SM121 vecadd (n=256): "
text s_t3 "  [3] omega_gpu_cmdlist.om live GB10 3-launch PCAS + PTIMER stamps: "
text s_t4 "  [4] omega_gpu_fp8_slots.om + omega_gpu_serving.om live GB10 DMA: "
text s_t5 "  [5] omega_blackwell_gates.om live GB10 M17 (10/10) + M18 (5/5): "
text s_ok "PASS"
text s_fail "FAIL rc="
text s_err " err="
text s_nv " nvstage="
text s_m1 " marker=0x"
text s_ns " elapsed_ns="
text s_ts " gpu_dt_ns="
text s_sems " sems_done="
text s_nl "\n"
text s_done "PASS test-gb10-gpu-2-silicon (session + cmdlist + fp8_slots + serving + gates verified on GB10)\n"

global s_cm ulong 6
global s_ma ulong 6
global s_mb ulong 6
global s_mc ulong 6

fn s_print s view uchar * to void
  r = write 1 s 0 len s
end

fn s_print_u x ulong to void
  b = new uchar 24 0
  pos = ulong 24
  v = x
  while true
    pos = sub pos 1
    put b pos uchar add 48 rem v 10
    v = div v 10
    if eq v 0
      r = write 1 b pos sub 24 pos
      ret
    end
  end
end

fn s_print_hex x ulong to void
  b = new uchar 16 0
  pos = ulong 16
  v = x
  while true
    pos = sub pos 1
    d = rem v 16
    if lt d 10
      put b pos uchar add 48 d
    else
      put b pos uchar add 87 d
    end
    v = div v 16
    if eq v 0
      r = write 1 b pos sub 16 pos
      ret
    end
  end
end

fn s_write_vec_u32 mh long n ulong seed_a ulong to void
  buf = new uchar 1024 0
  for i ulong n bound 256
    v = uint and add mul i 2654435761 seed_a 0xffffffff
    off = mul i 4
    put buf off uchar and v 255
    put buf add off 1 uchar and shr v 8 255
    put buf add off 2 uchar and shr v 16 255
    put buf add off 3 uchar and shr v 24 255
  end
  wr = mapwrite mh 0 buf 0 mul n 4
end

fn s_poison_u32 mh long n ulong to void
  buf = new uchar 1024 0
  for i ulong n bound 256
    off = mul i 4
    put buf off 0xef
    put buf add off 1 0xbe
    put buf add off 2 0xad
    put buf add off 3 0xde
  end
  wr = mapwrite mh 0 buf 0 mul n 4
end

fn s_u32_at buf view uchar 1024 off ulong to uint
  v = uint get buf off
  v = or v shl uint get buf add off 1 8
  v = or v shl uint get buf add off 2 16
  v = or v shl uint get buf add off 3 24
  ret v
end

fn s_check_vec_sum mh long n ulong seed_a ulong seed_b ulong to bool
  buf = new uchar 1024 0
  if ne mapread mh 0 buf 0 mul n 4 long mul n 4
    ret false
  end
  for i ulong n bound 256
    got = s_u32_at buf mul i 4
    va = and add mul i 2654435761 seed_a 0xffffffff
    vb = and add mul i 2654435761 seed_b 0xffffffff
    if ne got uint and add va vb 0xffffffff
      ret false
    end
  end
  ret true
end

fn s_fill_vec_launch L edit ulong 12 args edit uint 7 to void
  put L 0 get s_cm 4
  put L 1 64
  put L 2 64
  put L 3 1
  put L 4 4
  put L 5 1
  put L 6 256
  put L 7 7
  put L 8 5000
  put args 0 uint and get s_ma 4 0xffffffff
  put args 1 uint shr get s_ma 4 32
  put args 2 uint and get s_mb 4 0xffffffff
  put args 3 uint shr get s_mb 4 32
  put args 4 uint and get s_mc 4 0xffffffff
  put args 5 uint shr get s_mc 4 32
  put args 6 256
end

fn s_alloc_vec_bufs to ulong
  m = new ulong 6 0
  if ne ogps_alloc_code 512 m OGPS_OK
    ret 21
  end
  for i ulong 6
    put s_cm i get m i
  end
  code = new uchar 512 0
  if ne bw_encode_vecadd code 512
    ret 22
  end
  if ne mapwrite long get s_cm 3 0 code 0 512 512
    ret 23
  end
  if ne ogps_alloc 4096 m OGPS_OK
    ret 24
  end
  for i ulong 6
    put s_ma i get m i
  end
  if ne ogps_alloc 4096 m OGPS_OK
    ret 24
  end
  for i ulong 6
    put s_mb i get m i
  end
  if ne ogps_alloc 4096 m OGPS_OK
    ret 24
  end
  for i ulong 6
    put s_mc i get m i
  end
  ret 0
end

fn s_free_vec_bufs to void
  m = new ulong 6 0
  for i ulong 6
    put m i get s_ma i
  end
  ogps_free m
  for i ulong 6
    put m i get s_mb i
  end
  ogps_free m
  for i ulong 6
    put m i get s_mc i
  end
  ogps_free m
  for i ulong 6
    put m i get s_cm i
  end
  ogps_free m
end

fn s_run_session_live to ulong
  s_print s_t2
  s_write_vec_u32 long get s_ma 3 256 0x11223344
  s_write_vec_u32 long get s_mb 3 256 0x55667788
  s_poison_u32 long get s_mc 3 256
  L = new ulong 12 0
  args = new uint 7 0
  s_fill_vec_launch L args
  el = new ulong 1 0
  mk = new uint 1 0
  if ne ogps_launch L args el mk OGPS_OK
    ret 25
  end
  if not s_check_vec_sum long get s_mc 3 256 0x11223344 0x55667788
    ret 26
  end
  s_print s_ok
  s_print s_m1
  s_print_hex ulong get mk 0
  s_print s_ns
  s_print_u get el 0
  s_print s_nl
  ret 0
end

fn s_run_cmdlist_submit cl ulong to ulong
  opts = new ulong 7 0
  put opts 0 OGCL_MODE_PCAS
  put opts 1 OGCL_BARRIER_WFI
  put opts 2 5000
  put opts 4 1
  st = new ulong 7 0
  if ne ogcl_submit cl opts st 0
    ret 32
  end
  if or ne get st 0 3 ne get st 5 3
    ret 33
  end
  stm = new ulong 8 0
  if ne ogcl_stamps cl stm 8 4
    ret 34
  end
  if le get stm 3 get stm 0
    ret 35
  end
  if not s_check_vec_sum long get s_mc 3 256 0xdead0001 0x0000beef
    ret 36
  end
  s_print s_ok
  s_print s_sems
  s_print_u get st 5
  s_print s_ts
  s_print_u sub get stm 3 get stm 0
  s_print s_ns
  s_print_u get st 3
  s_print s_nl
  ret 0
end

fn s_run_cmdlist_live to ulong
  s_print s_t3
  cid = new ulong 1 0
  if ne ogcl_create 8 cid 0
    ret 30
  end
  cl = get cid 0
  ogps_lock
  s_write_vec_u32 long get s_ma 3 256 0xdead0001
  s_write_vec_u32 long get s_mb 3 256 0x0000beef
  s_poison_u32 long get s_mc 3 256
  L = new ulong 12 0
  args = new uint 7 0
  s_fill_vec_launch L args
  for k ulong 3
    if lt ogcl_add cl L args 0
      ogps_unlock
      ogcl_free cl
      ret 31
    end
  end
  rc = s_run_cmdlist_submit cl
  ogps_unlock
  ogcl_free cl
  ret rc
end

fn s_run_fp8_slots_live to ulong
  ogps_lock
  if ne ogfs_alloc 2 128 128 OGFS_OK
    ogps_unlock
    ret 40
  end
  w = new uchar 16384 0x38
  sc = new ushort 4 0x3f80
  ver = new ulong 1 0
  lm = new ulong 2 0
  put lm 0 0
  put lm 1 77
  if ne ogfs_load lm w sc ver OGFS_OK
    ignf = ogfs_free
    ogps_unlock
    ret 41
  end
  v0 = get ver 0
  if ne ogfs_pin 0 v0 OGFS_OK
    ignf = ogfs_free
    ogps_unlock
    ret 42
  end
  vas = new ulong 2 0
  if ne ogfs_entry 0 v0 vas OGFS_OK
    ignu = ogfs_unpin 0 v0
    ignf = ogfs_free
    ogps_unlock
    ret 43
  end
  ignu = ogfs_unpin 0 v0
  igne = ogfs_evict 0
  if ne ogfs_free OGFS_OK
    ogps_unlock
    ret 44
  end
  ogps_unlock
  ret 0
end

fn s_run_serving_live to ulong
  sb = new ulong 11 0
  put sb 0 512
  put sb 1 1
  put sb 2 8
  put sb 3 2
  put sb 4 128
  put sb 5 16
  put sb 6 4
  put sb 7 1024
  put sb 8 1024
  put sb 9 1024
  put sb 10 8
  if ne ogsv_reserve_serving sb OGSV_OK
    ret 45
  end
  ogsv_seal
  ogsv_free_all
  ret 0
end

fn run_session_and_cmdlist_live to ulong
  ogpl_set_mock 0
  ogpl_reset_state
  ogps_reset_all
  ogps_lock
  if eq ogps_open 0
    ogps_unlock
    ret 20
  end
  rc = s_alloc_vec_bufs
  if ne rc 0
    s_free_vec_bufs
    ogps_unlock
    ogps_close
    ret rc
  end
  rc = s_run_session_live
  ogps_unlock
  if ne rc 0
    ogps_lock
    s_free_vec_bufs
    ogps_unlock
    ogps_close
    ret rc
  end
  rc = s_run_cmdlist_live
  ogps_lock
  s_free_vec_bufs
  ogps_unlock
  if ne rc 0
    ogps_close
    ret rc
  end
  s_print s_t4
  rc = s_run_fp8_slots_live
  if ne rc 0
    ogps_close
    ret rc
  end
  rc = s_run_serving_live
  ogps_close
  if ne rc 0
    ret rc
  end
  s_print s_ok
  s_print s_nl
  ret 0
end

fn main to int
  ebuf = new uchar 128 0
  s_print s_hdr
  s_print s_t1
  if ne obws_verify_zero_libcuda_linkage 0
    ret 10
  end
  if ne obws_verify_zero_cuda_symbols 0
    ret 11
  end
  if ne obws_verify_zero_libcuda_runtime 0
    ret 12
  end
  s_print s_ok
  s_print s_nl

  rc = run_session_and_cmdlist_live
  if ne rc 0
    s_print s_fail
    s_print_u rc
    s_print s_err
    en = ogps_last_error ebuf
    r = write 1 ebuf 0 en
    s_print s_nv
    s_print_u ulong get nvstage 0
    s_print s_nl
    ret int rc
  end

  s_print s_t5
  obwg_set_mock 0
  if ne obwg_run_m18_gates 0
    ign = obwe_shutdown
    s_print s_fail
    s_print_u 50
    s_print s_nl
    ret 50
  end
  ign = obwe_shutdown
  s_print s_ok
  s_print s_nl
  s_print s_done
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit/parity test for src/omega_numeric_provenance.om.
om2

text msg_pass "OMEGA_NUMERIC_PROVENANCE_OM_PASS\n"
text msg_fail "OMEGA_NUMERIC_PROVENANCE_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_provenance to void
  row = new uint 5 0
  chk eq omega_numeric_get_opcode_count 52
  chk eq omega_numeric_get_opcode 0 row 0
  chk eq get row 0 uint 0x7221
  chk eq get row 1 uint 0x02097221
  chk eq get row 4 uint 0
  chk eq omega_numeric_get_opcode 51 row 0
  chk eq get row 0 uint 0x7223
  chk eq get row 1 uint 0x02097223
  chk eq get row 3 uint 0x0000000b
  chk eq omega_numeric_get_opcode 52 row -1

  note Full built-in provenance table verifies with zero problems
  chk eq omega_numeric_verify_all_fixtures 0

  note Negative control 1: corrupting w0 low half must be caught
  saved = get g_prov_w0 0
  put g_prov_w0 0 xor saved uint 1
  chk gt omega_numeric_verify_fixture_table 52 0
  put g_prov_w0 0 saved

  note Negative control 2: empty or oversized table must be caught
  chk gt omega_numeric_verify_fixture_table 0 0
  chk gt omega_numeric_verify_fixture_table 65 0

  note Negative control 3: orphan entry (table n=53 with unused row) must be caught
  prov_set 52 uint 0x7221 uint 0x02097221 uint 0x00000005 uint 0x00000000 0
  chk gt omega_numeric_verify_fixture_table 53 0
  chk eq omega_numeric_verify_all_fixtures 0
end

fn main to int
  test_provenance
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_blackwell_matmul.om
note   src/omega_gpu_moe_plan.om
note   src/omega_blackwell_codegen_attn.om
note   src/omega_blackwell_codegen_pf.om
om2

global g_out uchar 4096
global g_out_n ulong 1

text t_pass_msg "PASS test-bw-cpu-plan-om\n"

fn out_flush to void
  n = get g_out_n 0
  if gt n 0
    ign = write 1 g_out 0 n
    put g_out_n 0 0
  end
end

fn out_ch c uchar to void
  n = get g_out_n 0
  if ge n 4000
    out_flush
    n = 0
  end
  put g_out n c
  put g_out_n 0 add n 1
end

fn out_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    nib = and shr v sh 15
    out_ch sh_hexd nib
  end
end

fn out_hex64 v ulong to void
  out_hex32 uint shr v 32
  out_hex32 uint and v 0xffffffff
end

fn out_hex_bytes buf view uchar * n ulong to void
  for i ulong n bound 512
    b = uint get buf i
    out_ch sh_hexd shr b 4
    out_ch sh_hexd and b 15
  end
end

fn out_nl to void
  out_ch 10
  out_flush
end

fn fnv64_u64s arr view ulong * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n bound 8192
    v = get arr i
    for b ulong 8
      by = and shr v mul b 8 255
      h = mul xor h by ulong 0x100000001b3
    end
  end
  ret h
end

fn test_matmul_spec_and_bind dump ulong to long
  sid = new uchar 32 0
  if ne omega_matmul_spec_init 0 16 16 0 sid -1
    ret 10
  end
  if ne omega_matmul_spec_init 8193 16 16 0 sid -1
    ret 11
  end
  if ne omega_matmul_spec_init 16 32 64 2 sid 0
    ret 12
  end
  cdig = new uchar 32 0
  for i ulong 32
    put cdig i uchar add 0xa0 i
  end
  mid = new uchar 32 0
  rid = new uchar 32 0
  if ne omega_blackwell_bind_matmul_realization sid cdig mid rid 0
    ret 13
  end
  if ne dump 0
    out_ch 77
    out_ch 83
    out_ch 58
    out_hex_bytes sid 32
    out_nl
    out_ch 77
    out_ch 82
    out_ch 58
    out_hex_bytes rid 32
    out_nl
  end
  ret 0
end

fn test_matmul_convs dump ulong to long
  note Test fp16 -> fp32 -> fp16 and bf16 -> fp32 -> bf16 across edge cases
  hvals = new ushort 10 0
  put hvals 0 0x0000
  put hvals 1 0x8000
  put hvals 2 0x0001
  put hvals 3 0x03ff
  put hvals 4 0x0400
  put hvals 5 0x3c00
  put hvals 6 0xbc00
  put hvals 7 0x7bff
  put hvals 8 0x7c00
  put hvals 9 0x7e01
  for i ulong 10
    h = get hvals i
    f = omega_fp16_to_fp32 h
    u = bitcast uint f
    h2 = omega_fp32_to_fp16 f
    if ne h2 h
      ret 20
    end
    if ne dump 0
      out_ch 72
      out_ch 58
      out_hex32 uint h
      out_ch 58
      out_hex32 u
      out_ch 58
      out_hex32 uint h2
      out_nl
    end
  end
  fvals = new uint 8 0
  put fvals 0 0x3f800000
  put fvals 1 0x3f808000
  put fvals 2 0x3f818000
  put fvals 3 0x47800000
  put fvals 4 0x33000000
  put fvals 5 0x33000001
  put fvals 6 0x7f800001
  put fvals 7 0xbf800000
  for i ulong 8
    u = get fvals i
    f = bitcast f32 u
    h = omega_fp32_to_fp16 f
    b = omega_fp32_to_bf16 f
    bf = bitcast uint omega_bf16_to_fp32 b
    if ne dump 0
      out_ch 67
      out_ch 58
      out_hex32 u
      out_ch 58
      out_hex32 uint h
      out_ch 58
      out_hex32 uint b
      out_ch 58
      out_hex32 bf
      out_nl
    end
  end
  ret 0
end

fn test_matmul_oracles dump ulong to long
  a32 = new uint 4096 0
  b32 = new uint 4096 0
  c32 = new uint 4096 0
  put a32 0 1
  put a32 1 2
  put a32 2 3
  put a32 3 0x10000
  put a32 4 0x10000
  put a32 5 5
  put b32 0 7
  put b32 1 8
  put b32 2 9
  put b32 3 10
  put b32 4 11
  put b32 5 0x10000
  if ne omega_matmul_cpu_oracle_i32 a32 b32 c32 2 3 2 0
    ret 30
  end
  if or ne get c32 0 58 ne get c32 1 196636
    ret 31
  end
  if ne dump 0
    out_ch 73
    out_ch 58
    for i ulong 4
      out_hex32 get c32 i
    end
    out_nl
  end

  ah = new ushort 4096 0
  bh = new ushort 4096 0
  cf = new f32 4096 0.0
  put ah 0 0x3c00
  put ah 1 0x4000
  put ah 2 0x3800
  put ah 3 0xbc00
  put bh 0 0x4200
  put bh 1 0x3c00
  put bh 2 0x4000
  put bh 3 0x3800
  if ne omega_matmul_cpu_oracle_f16 ah bh cf 2 2 2 0
    ret 32
  end
  if ne dump 0
    out_ch 70
    out_ch 49
    out_ch 54
    out_ch 58
    for i ulong 4
      out_hex32 bitcast uint get cf i
    end
    out_nl
  end

  ab = new ushort 4096 0
  bb = new ushort 4096 0
  put ab 0 0x3f80
  put ab 1 0x4000
  put ab 2 0x3f00
  put ab 3 0xbf80
  put bb 0 0x4040
  put bb 1 0x3f80
  put bb 2 0x4000
  put bb 3 0x3f00
  if ne omega_matmul_cpu_oracle_bf16 ab bb cf 2 2 2 0
    ret 33
  end
  if ne dump 0
    out_ch 66
    out_ch 49
    out_ch 54
    out_ch 58
    for i ulong 4
      out_hex32 bitcast uint get cf i
    end
    out_nl
  end
  ret 0
end

fn test_moe_queue dump ulong to long
  q = new uint 512 0
  if ne omega_moe_queue_init q 0 -1
    ret 40
  end
  if ne omega_moe_queue_init q 8 0
    ret 41
  end
  s0 = new uint 1 0
  if ne omega_moe_queue_enqueue q 101 16 0 1 s0 0
    ret 42
  end
  if ne omega_moe_queue_enqueue q 102 32 0 1 s0 0
    ret 43
  end
  if ne omega_moe_queue_enqueue q 103 64 0 1 s0 0
    ret 44
  end
  slots = new uint 64 0
  claimed = new uint 1 0
  if ne omega_moe_queue_claim_batch q 50 slots claimed 0
    ret 45
  end
  if ne get claimed 0 2
    ret 46
  end
  if ne omega_moe_queue_complete_batch q get claimed 0 slots 3 0
    ret 47
  end
  if ne dump 0
    out_ch 81
    out_ch 58
    out_hex32 get claimed 0
    out_nl
  end
  ret 0
end

fn test_moe_plan dump ulong to long
  rc = test_moe_queue dump
  if ne rc 0
    ret rc
  end
  cfg = new ulong 8 0
  put cfg 0 16
  put cfg 1 2048
  put cfg 2 768
  put cfg 3 128
  put cfg 4 8
  put cfg 5 31
  raw = new uint 128 0
  nops = new uint 1 0
  if ne omega_moe_plan_layer cfg raw nops 0
    ret 48
  end
  bytes = new ulong 8 0
  if ne omega_moe_plan_traffic cfg 32 bytes 0
    ret 49
  end
  if ne dump 0
    out_ch 79
    out_ch 58
    out_hex32 get nops 0
    for i ulong ulong get nops 0 bound 32
      out_ch 58
      out_hex32 get raw mul i 4
      out_ch 44
      out_hex32 get raw add mul i 4 1
    end
    out_nl
    out_ch 84
    out_ch 58
    for i ulong 5
      out_hex64 get bytes i
      out_ch 44
    end
    out_nl
  end
  ret 0
end

fn test_codegen_wrappers dump ulong to long
  ins = new ulong 8192 0
  meta = new ulong 512 0
  if ne omega_blackwell_codegen_decode_attn_prog 0 0 ins meta -1
    ret 50
  end
  if ne omega_blackwell_codegen_decode_attn_prog 5 0 ins meta -1
    ret 50
  end
  if ne omega_blackwell_codegen_decode_attn_prog 4 0 ins meta 0
    ret 51
  end
  stats = new uint 2 0
  if ne omega_decode_attn_prog_stats 4 0 stats 0
    ret 52
  end
  if ne get stats 0 uint get meta 0
    ret 53
  end
  ha = fnv64_u64s ins mul get meta 0 8
  if ne dump 0
    out_ch 65
    out_ch 58
    out_hex32 get stats 0
    out_ch 58
    out_hex32 get stats 1
    out_ch 58
    out_hex64 ha
    out_nl
  end

  if ne omega_blackwell_codegen_pf_copy_prog ins meta 0
    ret 54
  end
  hp = fnv64_u64s ins mul get meta 0 8
  if ne dump 0
    out_ch 80
    out_ch 58
    out_hex32 uint get meta 0
    out_ch 58
    out_hex32 uint get meta 1
    out_ch 58
    out_hex64 hp
    out_nl
  end
  ret 0
end

fn main to int
  dump = ulong 1
  rc = test_matmul_spec_and_bind dump
  if ne rc 0
    ret int rc
  end
  rc = test_matmul_convs dump
  if ne rc 0
    ret int rc
  end
  rc = test_matmul_oracles dump
  if ne rc 0
    ret int rc
  end
  rc = test_moe_plan dump
  if ne rc 0
    ret int rc
  end
  rc = test_codegen_wrappers dump
  if ne rc 0
    ret int rc
  end
  ign = write 1 t_pass_msg 0 len t_pass_msg
  ret 0
end

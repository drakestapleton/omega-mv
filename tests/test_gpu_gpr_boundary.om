note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/gpu_gpr_boundary_test.c.
note Host-only audit of the declared-register rule:
note   declared = (peak + 2) rounded up to a multiple of 8 (OWN-30B, 2026-10-13).
note Composes src/omega_blackwell_codegen{,_moe,_bf16,_gemm,_router,_attn}.om.
om2

text gpr_pass "gpu_gpr_boundary_test: PASS\n"
text gpr_fail "gpu_gpr_boundary_test: FAIL\n"

global g_gpr_chk ulong 1
global g_gpr_fail ulong 1

fn gpr_chk cond bool to void
  put g_gpr_chk 0 add get g_gpr_chk 0 1
  if not cond
    put g_gpr_fail 0 add get g_gpr_fail 0 1
  end
end

fn omega_bw_gpr_declared peak uint to uint
  ret mul div add add peak 2 7 8 8
end

fn omega_bw_gpr_declared_ok decl uint peak uint to long
  if and ge decl add peak 2 eq rem decl 8 0
    ret 1
  end
  ret 0
end

fn test_rule_sweep to void
  for p ulong 127
    peak = uint p
    d = omega_bw_gpr_declared peak
    gpr_chk ge d add peak 2
    gpr_chk eq rem d 8 0
    gpr_chk lt sub d add peak 2 8
    gpr_chk ne omega_bw_gpr_declared_ok d peak 0
    old_d = mul div add add peak 1 7 8 8
    if eq rem peak 8 7
      gpr_chk eq omega_bw_gpr_declared_ok old_d peak 0
    end
  end
  note The 103 / 104 hang case is refused, 112 accepted
  gpr_chk eq omega_bw_gpr_declared_ok 104 103 0
  gpr_chk ne omega_bw_gpr_declared_ok 112 103 0
  gpr_chk eq omega_bw_gpr_declared_ok 64 64 0
  gpr_chk eq omega_bw_gpr_declared_ok 72 72 0
  gpr_chk ne omega_bw_gpr_declared_ok 72 64 0
end

fn check_fp8_gemv k ulong lb ulong rows ulong w ulong dp ulong to void
  sp = new ulong 8 0
  put sp 0 k
  put sp 1 lb
  put sp 2 rows
  put sp 3 w
  put sp 4 0
  put sp 5 dp
  put sp 6 0
  put sp 7 0
  st = new uint 2 0
  rc = omega_fp8_gemv_prog_stats sp st
  gpr_chk eq rc 0
  if eq rc 0
    pk = get st 1
    d = omega_bw_gpr_declared pk
    gpr_chk ne omega_bw_gpr_declared_ok d pk 0
  end
end

fn test_fp8_gemv_shapes to void
  check_fp8_gemv 2048 16 1 16 4
  check_fp8_gemv 2048 16 1 32 4
  check_fp8_gemv 4096 16 1 16 4
  check_fp8_gemv 768 8 1 32 3
  check_fp8_gemv 768 8 1 16 1
  check_fp8_gemv 2048 8 2 16 1
  check_fp8_gemv 1024 16 4 8 0
end

fn check_bf16_gemv k ulong rows ulong w ulong dp ulong to void
  sp = new ulong 8 0
  put sp 0 k
  put sp 1 rows
  put sp 2 w
  put sp 3 dp
  put sp 4 0
  put sp 5 0
  put sp 6 0
  put sp 7 0
  st = new uint 2 0
  rc = omega_bf16_gemv_prog_stats sp st
  gpr_chk eq rc 0
  if eq rc 0
    pk = get st 1
    d = omega_bw_gpr_declared pk
    gpr_chk ne omega_bw_gpr_declared_ok d pk 0
  end
end

fn test_bf16_gemv_shapes to void
  check_bf16_gemv 2048 1 16 4
  check_bf16_gemv 4096 1 16 4
end

fn check_fp8_gemm k ulong lb ulong mt ulong w ulong to void
  sp = new ulong 8 0
  put sp 0 k
  put sp 1 lb
  put sp 2 mt
  put sp 3 w
  put sp 4 0
  put sp 5 0
  st = new uint 2 0
  rc = omega_fp8gemm_prog_stats sp st
  gpr_chk eq rc 0
  if eq rc 0
    pk = get st 1
    d = omega_bw_gpr_declared pk
    gpr_chk ne omega_bw_gpr_declared_ok d pk 0
  end
end

fn test_fp8_gemm_shapes to void
  check_fp8_gemm 2048 16 4 16
  check_fp8_gemm 2048 16 8 16
  check_fp8_gemm 768 8 4 16
  check_fp8_gemm 768 8 8 16
  check_fp8_gemm 4096 16 4 16
  check_fp8_gemm 4096 16 8 16
end

fn test_router_and_dattn to void
  sp = new ulong 8 0
  put sp 0 32
  put sp 1 4
  put sp 2 0
  put sp 3 128
  st = new uint 2 0
  rc = omega_router_prog_stats sp st
  gpr_chk eq rc 0
  if eq rc 0
    pk = get st 1
    gpr_chk ne omega_bw_gpr_declared_ok omega_bw_gpr_declared pk pk 0
  end

  st2 = new uint 2 0
  rc2 = omega_decode_attn_prog_stats 4 0 st2
  gpr_chk eq rc2 0
  if eq rc2 0
    pk2 = get st2 1
    gpr_chk ne omega_bw_gpr_declared_ok omega_bw_gpr_declared pk2 pk2 0
  end
end

fn main to int
  test_rule_sweep
  test_fp8_gemv_shapes
  test_bf16_gemv_shapes
  test_fp8_gemm_shapes
  test_router_and_dattn
  if eq get g_gpr_fail 0 0
    ign = write 1 gpr_pass 0 len gpr_pass
    ret 0
  end
  ign = write 1 gpr_fail 0 len gpr_fail
  ret 1
end

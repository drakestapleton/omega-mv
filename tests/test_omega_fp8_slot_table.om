note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_fp8_slot_table.om.
om2

text msg_pass "OMEGA_FP8_SLOT_TABLE_OM_PASS\n"
text msg_fail "OMEGA_FP8_SLOT_TABLE_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn test_lifecycle to void
  ver = new ulong 1 0
  rec = new ulong 4 0
  st = new ulong 8 0

  chk eq omega_fp8_slot_table_init 0 FP8_SLOT_BAD_ARGS
  chk eq omega_fp8_slot_table_init 4 FP8_SLOT_OK
  chk eq omega_fp8_slot_table_idle 1

  note Out-of-range slot refused
  chk eq omega_fp8_slot_begin_load 4 FP8_SLOT_BAD_ARGS
  chk eq omega_fp8_slot_pin 4 1 FP8_SLOT_BAD_ARGS
  chk eq omega_fp8_slot_evict 4 FP8_SLOT_BAD_ARGS

  note Pin on empty slot is STALE
  chk eq omega_fp8_slot_pin 0 0 FP8_SLOT_STALE
  chk eq omega_fp8_slot_pin 0 1 FP8_SLOT_STALE

  note Finish load without begin_load is BAD_ARGS
  chk eq omega_fp8_slot_finish_load 0 42 1 ver FP8_SLOT_BAD_ARGS

  note Failed load returns to EMPTY
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_OK
  chk eq omega_fp8_slot_table_idle 0
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_BUSY
  chk eq omega_fp8_slot_evict 0 FP8_SLOT_BUSY
  chk eq omega_fp8_slot_finish_load 0 42 0 ver FP8_SLOT_OK
  chk eq get ver 0 0
  chk eq omega_fp8_slot_table_idle 1

  note Successful load publishes version 1
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_OK
  chk eq omega_fp8_slot_finish_load 0 1001 1 ver FP8_SLOT_OK
  chk eq get ver 0 1
  chk eq omega_fp8_slot_query 0 rec FP8_SLOT_OK
  chk eq get rec 0 FP8_SLOT_READY
  chk eq get rec 1 0
  chk eq get rec 2 1001
  chk eq get rec 3 1

  note Pin twice, check busy refusals, unpin, check high-water
  chk eq omega_fp8_slot_pin 0 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_pin 0 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_pin 0 2 FP8_SLOT_STALE
  chk eq omega_fp8_slot_table_idle 0
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_BUSY
  chk eq omega_fp8_slot_evict 0 FP8_SLOT_BUSY
  chk eq omega_fp8_slot_unpin 0 99 FP8_SLOT_BAD_ARGS
  chk eq omega_fp8_slot_unpin 0 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_evict 0 FP8_SLOT_BUSY
  chk eq omega_fp8_slot_unpin 0 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_unpin 0 1 FP8_SLOT_BAD_ARGS
  chk eq omega_fp8_slot_table_idle 1

  note Reloading hides old version immediately (no ABA)
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_OK
  chk eq omega_fp8_slot_pin 0 1 FP8_SLOT_STALE
  chk eq omega_fp8_slot_finish_load 0 2002 1 ver FP8_SLOT_OK
  chk eq get ver 0 2
  chk eq omega_fp8_slot_pin 0 1 FP8_SLOT_STALE
  chk eq omega_fp8_slot_pin 0 2 FP8_SLOT_OK
  chk eq omega_fp8_slot_unpin 0 2 FP8_SLOT_OK

  note Evict ready slot
  chk eq omega_fp8_slot_evict 0 FP8_SLOT_OK
  chk eq omega_fp8_slot_pin 0 2 FP8_SLOT_STALE
  chk eq omega_fp8_slot_evict 0 FP8_SLOT_OK

  note Verify exact stats counters
  omega_fp8_slot_table_stats st
  chk eq get st 0 2
  chk eq get st 1 1
  chk eq get st 2 5
  chk eq get st 3 6
  chk eq get st 4 1
  chk eq get st 5 3
  chk eq get st 6 0
  chk eq get st 7 2

  note Mutant mode: begin_load ignores pins and unpin drops pin despite reload
  chk eq omega_fp8_slot_begin_load 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_finish_load 1 3003 1 ver FP8_SLOT_OK
  v3 = get ver 0
  chk eq v3 3
  chk eq omega_fp8_slot_pin 1 v3 FP8_SLOT_OK
  omega_fp8_slot_table_set_mutant 1
  chk eq omega_fp8_slot_begin_load 1 FP8_SLOT_OK
  chk eq omega_fp8_slot_finish_load 1 4004 1 ver FP8_SLOT_OK
  chk eq get ver 0 4
  chk eq omega_fp8_slot_unpin 1 v3 FP8_SLOT_OK
  chk eq omega_fp8_slot_table_idle 1

  omega_fp8_slot_table_fini
  chk eq omega_fp8_slot_table_idle 1
  chk eq omega_fp8_slot_begin_load 0 FP8_SLOT_BAD_ARGS
end

fn main to int
  test_lifecycle
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

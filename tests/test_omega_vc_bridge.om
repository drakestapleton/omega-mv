note
note tests/test_omega_vc_bridge.om -- standalone pure OM-2 test for src/omega_vc_bridge.om

text t_ir1 "OMEGA_PROGRAM_IR_BASE_V1"
text t_ir2 "OMEGA_PROGRAM_IR_USER_V1"
text t_ir3 "OMEGA_PROGRAM_IR_ABST_V1"
text t_pass "PASS test_omega_vc_bridge\n"

fn test_admit_chain to long
  sid1 = new uchar 32 0
  con1 = new uchar 32 0
  ev = new uchar 32 0
  dst = new uchar 8192 0
  if ne omega_vc_bridge_init 0
    ret 1
  end
  for i ulong 32
    put sid1 i uchar add i 16
    put con1 i uchar add i 32
  end
  omega_vc_bridge_set_prog sid1 con1
  note Zero evidence must be refused
  if ne omega_vc_bridge_admit 1 1 0 t_ir1 ev neg long 1
    ret 2
  end
  for i ulong 32
    put ev i uchar add i 64
  end
  note Unrealized or no-body must be refused
  if ne omega_vc_bridge_admit 0 1 0 t_ir1 ev neg long 1
    ret 3
  end
  if ne omega_vc_bridge_admit 1 0 0 t_ir1 ev neg long 1
    ret 4
  end
  note Admit base program (0 deps)
  if ne omega_vc_bridge_admit 1 1 0 t_ir1 ev 0
    ret 5
  end
  if ne omega_vcstore_count 1
    ret 6
  end
  note Fetch receipt and blob from bridge tables
  rid1 = new uchar 32 0
  dig1 = new uchar 32 0
  for i ulong 32
    put rid1 i get g_vcb_new_rid i
    put dig1 i get g_vcb_dig i
  end
  rlen = omega_vc_bridge_fetch_receipt rid1 dst
  if le rlen 100
    ret 7
  end
  blen = omega_vc_bridge_fetch_blob dig1 dst
  if ne blen long len t_ir1
    ret 8
  end
  for i ulong len t_ir1 bound 64
    if ne get dst i get t_ir1 i
      ret 9
    end
  end
  note Admit dependent program (1 dep = sid1)
  omega_vc_bridge_set_dep 0 sid1
  put sid1 0 99
  put con1 0 88
  omega_vc_bridge_set_prog sid1 con1
  if ne omega_vc_bridge_admit 1 1 1 t_ir2 ev 0
    ret 10
  end
  if ne omega_vcstore_count 2
    ret 11
  end
  note Duplicate dependency must be refused
  omega_vc_bridge_set_dep 1 sid1
  put sid1 0 111
  omega_vc_bridge_set_prog sid1 con1
  omega_vc_bridge_set_dep 0 sid1
  omega_vc_bridge_set_dep 1 sid1
  if ne omega_vc_bridge_admit 1 1 2 t_ir2 ev neg long 1
    ret 12
  end
  ret 0
end

fn test_abstraction_guards to long
  sid3 = new uchar 32 0
  con3 = new uchar 32 0
  ev = new uchar 32 0
  for i ulong 32
    put sid3 i uchar add i 120
    put con3 i uchar add i 140
    put ev i uchar add i 160
  end
  omega_vc_bridge_set_prog sid3 con3
  if ne omega_vc_bridge_admit_abstraction 0 1 10 t_ir3 ev neg long 1
    ret 20
  end
  if ne omega_vc_bridge_admit_abstraction 1 0 10 t_ir3 ev neg long 1
    ret 21
  end
  if ne omega_vc_bridge_admit_abstraction 1 1 0 t_ir3 ev neg long 1
    ret 22
  end
  if ne omega_vc_bridge_admit_abstraction 1 1 5 t_ir3 ev 0
    ret 23
  end
  if ne omega_vcstore_count 3
    ret 24
  end
  omega_vc_bridge_destroy
  if ne omega_vcstore_count 0
    ret 25
  end
  ret 0
end

fn main to int
  r = test_admit_chain
  if ne r 0
    ret int r
  end
  r = test_abstraction_guards
  if ne r 0
    ret int r
  end
  ign = write 1 t_pass 0 len t_pass
  ret 0
end

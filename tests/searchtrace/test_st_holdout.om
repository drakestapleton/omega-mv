global th_run ulong 1
global th_ok ulong 1
global th_long uchar 1000012
global th_rec1 uchar 1024
global th_rl1 ulong 1
global th_rc1 uchar 1024
global th_r1 ulong 1

fn th_num v ulong to void
  b = new uchar 24 0
  p = ulong 24
  x = v
  while true bound 24
    p = sub p 1
    put b p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 b p sub 24 p
end

fn th_chk name view uchar * ok bool to void
  put th_run 0 add get th_run 0 1
  if ok
    put th_ok 0 add get th_ok 0 1
    sth_wr 1 th_pass
  else
    sth_wr 1 th_fail
  end
  sth_wr 1 name
  sth_wr 1 th_nl
end

fn th_substr hay view uchar * hlen ulong ndl view uchar * to bool
  nl = len ndl
  if gt nl hlen
    ret false
  end
  lim = add sub hlen nl 1
  for i ulong lim bound 2048
    m = ulong 1
    for j ulong nl bound 128
      if ne get hay add i j get ndl j
        m = 0
        break
      end
    end
    if eq m 1
      ret true
    end
  end
  ret false
end

fn th_why_has ndl view uchar * to bool
  wl = get sth_whylen 0
  wb = new uchar 128 0
  for i ulong wl bound 128
    put wb i get sth_why i
  end
  ret th_substr wb wl ndl
end

fn th_hex_eq32 d view uchar 32 hx view uchar * to bool
  if ne len hx 64
    ret false
  end
  for i ulong 32
    b = ulong get d i
    if ne sth_hex_nib shr b 4 get hx mul i 2
      ret false
    end
    if ne sth_hex_nib and b 15 get hx add mul i 2 1
      ret false
    end
  end
  ret true
end

fn th_reseal_parse body view uchar * to long
  bl = len body
  rec = new uchar 1024 0
  for i ulong bl bound 1024
    put rec i get body i
    put sh_dat i get body i
  end
  sh_all bl
  put rec bl 101
  put rec add bl 1 110
  put rec add bl 2 100
  put rec add bl 3 32
  off = add bl 4
  for i ulong 32
    b = ulong get sh_dig i
    q = add off mul i 2
    put rec q sth_hex_nib shr b 4
    put rec add q 1 sth_hex_nib and b 15
  end
  put rec add bl 68 10
  ret sth_parse rec add bl 69
end

fn th_refuse name view uchar * body view uchar * ndl view uchar * to void
  r = th_reseal_parse body
  ok = and lt r 0 th_why_has ndl
  th_chk name ok
end

fn th_test_commit to void
  salt = new uchar 32 0
  for i ulong 32
    put salt i uchar i
  end
  r = sth_commit th_kat_id th_kat_ts salt STH_REC_MAX
  rl = get sth_reclen 0
  put th_rl1 0 rl
  for i ulong rl bound 1024
    put th_rec1 i get sth_rec i
  end
  th_chk th_t1 eq r 0
  same_kat = and eq r 0 eq rl len th_kat_rec
  if same_kat
    for i ulong rl bound 1024
      if ne get th_rec1 i get th_kat_rec i
        same_kat = false
      end
    end
  end
  th_chk th_t2 same_kat
  r2 = sth_commit th_kat_id th_kat_ts salt STH_REC_MAX
  rl2 = get sth_reclen 0
  det = and eq r2 0 eq rl rl2
  if det
    for i ulong rl bound 1024
      if ne get th_rec1 i get sth_rec i
        det = false
      end
    end
  end
  th_chk th_t3 det
  th_chk th_t4 eq sth_commit th_x th_notasks salt STH_REC_MAX STH_ENOTASKS
  emp = new uchar 1 0
  th_chk th_t5 eq sth_commit th_x part emp 0 0 salt STH_REC_MAX STH_ENOTASKS
  th_chk th_t6 eq sth_commit th_badlbl th_kat_ts salt STH_REC_MAX STH_ELABEL
  th_chk th_t7 eq sth_commit th_lbl65 th_kat_ts salt STH_REC_MAX STH_ELABEL
  th_chk th_t8 eq sth_commit th_kat_id th_kat_ts salt sub rl 1 STH_ECAP
  th_chk th_t9 eq sth_count_tasks th_tcrule len th_tcrule 2
  for i ulong 1000012 bound 1000012
    put th_long i 120
  end
  for i ulong 7
    put th_long add 1000005 i get th_longtail i
  end
  note Copy th_long in chunks is avoided; count directly using sth_count_tasks via local? No, 1MB local fits in 4MB stack!
  ln = new uchar 1000012 120
  for i ulong 7
    put ln add 1000005 i get th_longtail i
  end
  th_chk th_t10 eq sth_count_tasks ln 1000012 1
end

fn th_test_parse_basic to void
  rl = get th_rl1 0
  rec = new uchar 1024 0
  rec2 = new uchar 1024 0
  for i ulong rl bound 1024
    put rec i get th_rec1 i
  end
  r = sth_parse rec rl
  rd = new uchar 32 0
  for i ulong 32
    put rd i get sth_c_rd i
  end
  ok = and eq r 0 th_hex_eq32 rd th_kat_rd
  if ne get sth_c_tcnt 0 2
    ok = false
  end
  if ne get sth_c_tlen 0 21
    ok = false
  end
  if ne get sth_c_idlen 0 len th_kat_id
    ok = false
  else
    for i ulong len th_kat_id bound 64
      if ne get sth_c_id i get th_kat_id i
        ok = false
      end
    end
  end
  th_chk th_t11 ok
  for i ulong 32
    put rd i get sth_c_cm i
  end
  th_chk th_t12 and eq r 0 th_hex_eq32 rd th_kat_cm
  ok = true
  for n ulong rl bound 1024
    if ge sth_parse rec n 0
      ok = false
    end
  end
  th_chk th_t13 ok
  ok = true
  for i ulong rl bound 1024
    for j ulong rl bound 1024
      put rec2 j get rec j
    end
    put rec2 i xor get rec2 i 1
    if ge sth_parse rec2 rl 0
      ok = false
    end
  end
  th_chk th_t14 ok
end

fn th_test_parse_refusals to void
  th_refuse th_t15 th_b_ver th_n_magic
  th_refuse th_t16 th_b_mag th_n_magic
  th_refuse th_t17 th_b_dom th_n_dom
  th_refuse th_t18 th_b_miss th_n_tlen
  th_refuse th_t19 th_b_ext th_n_exp
  th_refuse th_t20 th_b_reord th_n_exp
  th_refuse th_t21 th_b_bhex th_n_bhex
  th_refuse th_t22 th_b_shex th_n_64
  th_refuse th_t23 th_b_uhex th_n_up
  th_refuse th_t24 th_b_blbl th_n_lbl
  th_refuse th_t25 th_b_elbl th_n_lbl
  th_refuse th_t26 th_b_zt th_n_zt
  th_refuse th_t27 th_b_lz th_n_dec
  th_refuse th_t28 th_b_ovf th_n_rng
  th_refuse th_t29 th_b_sm th_n_sm
  note CRLF test: insert CR before LF on line 1
  bl = len th_b_noend
  crlf = new uchar 1024 0
  p = ulong 0
  for i ulong bl bound 1024
    c = get th_b_noend i
    if eq ulong c 10
      put crlf p 13
      p = add p 1
    end
    put crlf p c
    p = add p 1
  end
  th_refuse th_t30 part crlf 0 p th_n_cr
  r = sth_parse th_b_noend len th_b_noend
  th_chk th_t31 and lt r 0 th_why_has th_n_trunc
  rl = get th_rl1 0
  rec2 = new uchar 1024 0
  for i ulong rl bound 1024
    put rec2 i get th_rec1 i
  end
  idx = sub rl 2
  if eq ulong get rec2 idx 48
    put rec2 idx 49
  else
    put rec2 idx 48
  end
  th_chk th_t32 eq sth_parse rec2 rl STH_EDIGEST
  for i ulong rl bound 1024
    put rec2 i get th_rec1 i
  end
  put rec2 rl 10
  r = sth_parse rec2 add rl 1
  th_chk th_t33 and lt r 0 th_why_has th_n_trail
  put rec2 rl 120
  th_chk th_t34 lt sth_parse rec2 add rl 1 0
  put rec2 70 0
  r = sth_parse rec2 rl
  th_chk th_t35 and lt r 0 th_why_has th_n_nul
end

fn th_test_receipt_only to void
  th_chk th_t41 eq sth_reveal_receipt th_gc39 len th_gc39 STH_REC_MAX STH_ECOMMITID
  th_chk th_t42 eq sth_reveal_receipt th_gcup len th_gcup STH_REC_MAX STH_ECOMMITID
  th_chk th_t43 eq sth_reveal_receipt th_gc41 len th_gc41 STH_REC_MAX STH_ECOMMITID
  a = sth_reveal_receipt th_gc len th_gc STH_REC_MAX
  r1 = get sth_rcptlen 0
  put th_r1 0 r1
  rc1 = new uchar 1024 0
  for i ulong r1 bound 1024
    put rc1 i get sth_rcpt i
    put th_rc1 i get sth_rcpt i
  end
  b = sth_reveal_receipt th_gc len th_gc STH_REC_MAX
  ok = and eq a 0 and eq b 0 eq r1 get sth_rcptlen 0
  if ok
    for i ulong r1 bound 1024
      if ne get rc1 i get sth_rcpt i
        ok = false
      end
    end
  end
  if not th_substr rc1 r1 th_rc_vpass
    ok = false
  end
  if not th_substr rc1 r1 th_rc_cm
    ok = false
  end
  if not th_substr rc1 r1 th_rc_rd
    ok = false
  end
  if not th_substr rc1 r1 th_rc_hid
    ok = false
  end
  if not th_substr rc1 r1 th_gc
    ok = false
  end
  th_chk th_t44 ok
  d = new uchar 32 0
  blen = sub r1 69
  sth_sha256_buf rc1 blen d
  ok = and eq a 0 sth_slice_eq rc1 blen 4 sth_t_endsp
  if ok
    for i ulong 32
      bv = ulong get d i
      q = add add blen 4 mul i 2
      if ne sth_hex_nib shr bv 4 get rc1 q
        ok = false
      end
      if ne sth_hex_nib and bv 15 get rc1 add q 1
        ok = false
      end
    end
  end
  th_chk th_t45 ok
end

fn th_test_reveal_receipt to void
  rl = get th_rl1 0
  rec = new uchar 1024 0
  for i ulong rl bound 1024
    put rec i get th_rec1 i
  end
  r = sth_parse rec rl
  salt = new uchar 32 0
  bad = new uchar 32 0
  for i ulong 32
    put salt i uchar i
    put bad i uchar i
  end
  put bad 7 xor get bad 7 0x80
  th_chk th_t36 and eq r 0 eq sth_reveal th_kat_ts len th_kat_ts salt 0
  th_chk th_t37 eq sth_reveal th_kat_ts len th_kat_ts bad STH_ESALT
  th_chk th_t38 eq sth_reveal th_rev_ext len th_rev_ext salt STH_ELEN
  th_chk th_t39 eq sth_reveal th_rev_cnt len th_rev_cnt salt STH_ECOUNT
  th_chk th_t40 eq sth_reveal th_rev_com len th_rev_com salt STH_ECOMMIT
  th_test_receipt_only
end

fn th_mkpath dir view uchar 512 dlen ulong suf view uchar * dst edit uchar 512 to ulong
  p = ulong 0
  for i ulong dlen bound 400
    put dst p get dir i
    p = add p 1
  end
  sl = len suf
  for i ulong sl bound 100
    put dst p get suf i
    p = add p 1
  end
  ret p
end

fn th_write_f pth view uchar 512 plen ulong dat view uchar * dlen ulong to void
  fd = fopen pth 0 plen 577 384
  if ge fd 0
    w = write int fd dat 0 dlen
    c = fclose int fd
  end
end

fn th_file_eq pth view uchar 512 plen ulong dat view uchar * dlen ulong to bool
  r = sth_read_file pth plen 1
  if ne r long dlen
    ret false
  end
  for i ulong dlen bound 2048
    if ne get sth_fbuf2 i get dat i
      ret false
    end
  end
  ret true
end

fn th_test_cli_a dir view uchar 512 dl ulong recp view uchar 512 recpl ulong to void
  p = new uchar 512 0
  p2 = new uchar 512 0
  salt = new uchar 32 0
  for i ulong 32
    put salt i uchar i
  end
  pl = th_mkpath dir dl th_f_ts p
  th_write_f p pl th_kat_ts len th_kat_ts
  pl = th_mkpath dir dl th_f_sp p
  th_write_f p pl salt 32
  pl = th_mkpath dir dl th_f_sp31 p
  th_write_f p pl salt 31
  pl = th_mkpath dir dl th_f_bog p
  th_write_f p pl th_rev_com len th_rev_com

  put sth_argc 0 1
  sth_arg_set 0 th_frob len th_frob
  th_chk th_t46 eq sth_cli_run 1

  put sth_argc 0 2
  sth_arg_set 0 sth_t_cmd_commit len sth_t_cmd_commit
  sth_arg_set 1 th_x len th_x
  th_chk th_t47 eq sth_cli_run 1

  put sth_argc 0 5
  sth_arg_set 0 sth_t_cmd_commit len sth_t_cmd_commit
  sth_arg_set 1 th_kat_id len th_kat_id
  pl = th_mkpath dir dl th_f_ts p
  sth_arg_set 2 p pl
  p2l = th_mkpath dir dl th_f_sp31 p2
  sth_arg_set 3 p2 p2l
  sth_arg_set 4 dir dl
  th_chk th_t48 eq sth_cli_run 2

  p2l = th_mkpath dir dl th_f_sp p2
  sth_arg_set 3 p2 p2l
  c1 = sth_cli_run
  th_chk th_t49 and eq c1 0 th_file_eq recp recpl th_kat_rec len th_kat_rec
  th_chk th_t50 eq sth_cli_run 0

  put sth_argc 0 2
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 recp recpl
  th_chk th_t51 eq sth_cli_run 0
end

fn th_test_cli_b dir view uchar 512 dl ulong recp view uchar 512 recpl ulong to void
  p = new uchar 512 0
  p2 = new uchar 512 0
  put sth_env_mode 0 1
  put sth_argc 0 5
  sth_arg_set 0 sth_t_cmd_reveal len sth_t_cmd_reveal
  sth_arg_set 1 recp recpl
  pl = th_mkpath dir dl th_f_ts p
  sth_arg_set 2 p pl
  p2l = th_mkpath dir dl th_f_sp p2
  sth_arg_set 3 p2 p2l
  sth_arg_set 4 dir dl
  th_chk th_t52 eq sth_cli_run 2

  put sth_env_mode 0 2
  for i ulong len th_xyz bound 16
    put sth_env_val i get th_xyz i
  end
  put sth_env_len 0 len th_xyz
  th_chk th_t53 eq sth_cli_run 2

  for i ulong len th_gc bound 64
    put sth_env_val i get th_gc i
  end
  put sth_env_len 0 len th_gc
  pl = th_mkpath dir dl th_f_bog p
  sth_arg_set 2 p pl
  th_chk th_t54 eq sth_cli_run 2

  pl = th_mkpath dir dl th_f_ts p
  sth_arg_set 2 p pl
  th_chk th_t55 eq sth_cli_run 0

  r1 = get th_r1 0
  rc1 = new uchar 1024 0
  for i ulong r1 bound 1024
    put rc1 i get th_rc1 i
  end
  rd2 = new uchar 32 0
  sth_sha256_buf rc1 r1 rd2
  p2l = sth_make_out_path dir dl sth_t_p_reveal rd2 p2
  th_chk th_t56 th_file_eq p2 p2l rc1 r1

  kl = len th_kat_rec
  for i ulong kl bound 1024
    put rc1 i get th_kat_rec i
  end
  put rc1 kl 120
  th_write_f recp recpl rc1 add kl 1
  put sth_argc 0 2
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 recp recpl
  th_chk th_t57 eq sth_cli_run 2

  put sth_argc 0 5
  sth_arg_set 0 sth_t_cmd_commit len sth_t_cmd_commit
  sth_arg_set 1 th_kat_id len th_kat_id
  pl = th_mkpath dir dl th_f_ts p
  sth_arg_set 2 p pl
  pl = th_mkpath dir dl th_f_sp p
  sth_arg_set 3 p pl
  sth_arg_set 4 dir dl
  th_chk th_t58 eq sth_cli_run 2

  u = unlink p2 0 p2l
  u = unlink recp 0 recpl
  pl = th_mkpath dir dl th_f_ts p
  u = unlink p 0 pl
  pl = th_mkpath dir dl th_f_sp p
  u = unlink p 0 pl
  pl = th_mkpath dir dl th_f_sp31 p
  u = unlink p 0 pl
  pl = th_mkpath dir dl th_f_bog p
  u = unlink p 0 pl
  u = rmdir dir 0 dl
end

fn th_test_cli to void
  dir = new uchar 512 0
  dl = len th_dir_pfx
  for i ulong dl bound 64
    put dir i get th_dir_pfx i
  end
  dl = sth_append_u64_buf dir dl ulong getpid
  mr = makedir dir 0 dl 448
  rd = new uchar 32 0
  rp = sth_parse th_kat_rec len th_kat_rec
  for i ulong 32
    put rd i get sth_c_rd i
  end
  recp = new uchar 512 0
  recpl = sth_make_out_path dir dl sth_t_p_commit rd recp
  th_test_cli_a dir dl recp recpl
  th_test_cli_b dir dl recp recpl
end

fn main to int
  th_test_commit
  th_test_parse_basic
  th_test_parse_refusals
  th_test_reveal_receipt
  th_test_cli
  sth_wr 1 th_sum1
  th_num get th_ok 0
  sth_wr 1 th_sum2
  th_num get th_run 0
  sth_wr 1 th_sum3
  if eq get th_ok 0 get th_run 0
    ret 0
  end
  ret 1
end

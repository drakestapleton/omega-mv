note tests/searchtrace/test_st_corpus.om: Pure seeded OM-2 M23 G1 corpus unit,
note determinism, refusal, hook API, and hook equivalence tests (port of test_st_corpus.c).

text tc_ts "OMEGA-SEARCHTRACE-TASKSET v1\n# small set for unit tests\ntask add3 depth=1 max_cost=10 max_candidates=100 dedup=1 pairs=0:3,1:4,7:10\ntask affine depth=2 max_cost=10 max_candidates=500 dedup=1 pairs=0:1,1:3,2:5,10:21\ntask cut depth=3 max_cost=10 max_candidates=60 dedup=0 pairs=0:0,1:1,2:4,3:9\nend\n"
text tc_ts_alt "OMEGA-SEARCHTRACE-TASKSET v1\n# small set for unit tests\ntask add3 depth=1 max_cost=10 max_candidates=100 dedup=1 pairs=0:4,1:4,7:10\ntask affine depth=2 max_cost=10 max_candidates=500 dedup=1 pairs=0:1,1:3,2:5,10:21\ntask cut depth=3 max_cost=10 max_candidates=60 dedup=0 pairs=0:0,1:1,2:4,3:9\nend\n"

text tc_r1 "OMEGA-SEARCHTRACE-TASKSET v2\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\nend\n"
text tc_r2 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\n"
text tc_r3 "OMEGA-SEARCHTRACE-TASKSET v1\nend\n"
text tc_r4 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=4 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\nend\n"
text tc_r5 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=00:0\nend\n"
text tc_r6 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a max_cost=1 depth=1 max_candidates=1 dedup=0 pairs=0:0\nend\n"
text tc_r7 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0,\nend\n"
text tc_r8 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\nend\n"
text tc_r9 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:0\nend\nextra\n"
text tc_r11 "OMEGA-SEARCHTRACE-TASKSET v1\ntask a depth=1 max_cost=1 max_candidates=1 dedup=0 pairs=0:18446744073709551616\nend\n"

text tc_s_bud "prune=budget"
text tc_s_sol "verdict=solved"
text tc_s_eqv "prune=equiv"
text tc_s_rrc "rrc=0 "
text tc_s_pr "prune="
text tc_s_prw "prune=wrong"
text tc_s_ch "child="
text tc_s_v2 "OMEGA-SEARCHTRACE v2"

text tc_fail "FAIL "
text tc_nl "\n"
text tc_sum1 "st_corpus: "
text tc_sum2 "/"
text tc_sum3 " PASS\n"

text tc_n1 "taskset parses"
text tc_n2 "generate run 1"
text tc_n3 "generate run 2"
text tc_n4 "two runs byte-identical"
text tc_n5 "corpus verifies against its task set"
text tc_n6 "corpus verifies standalone"
text tc_n7 "budget cutoff recorded"
text tc_n8 "solved step recorded"
text tc_n9 "equivalence prune recorded"
text tc_n10 "realization cost recorded"
text tc_n11 "every truncated prefix refused"
text tc_n12 "missing final newline refused"
text tc_n13 "bytes after end refused"
text tc_n14 "CR refused"
text tc_n15 "NUL refused"
text tc_n16 "single-byte mutations refused"
text tc_n17 "dropped step line refused"
text tc_n18 "unknown prune value refused"
text tc_n19 "uppercase hex refused"
text tc_n20 "wrong version refused"
text tc_n21 "alt taskset parses"
text tc_n22 "corpus for another task set refused"
text tc_n23 "taskset wrong version"
text tc_n24 "taskset without end"
text tc_n25 "taskset with no tasks"
text tc_n26 "taskset depth 4"
text tc_n27 "taskset leading zero"
text tc_n28 "taskset reordered fields"
text tc_n29 "taskset trailing comma"
text tc_n30 "taskset duplicate name"
text tc_n31 "taskset bytes after end"
text tc_n32 "taskset CR"
text tc_n33 "taskset u64 overflow"
text tc_n34 "synth hook install"
text tc_n35 "second synth hook refused"
text tc_n36 "clear with wrong ctx refused"
text tc_n37 "generate refused while a hook is installed"
text tc_n38 "synth hook clear"
text tc_n39 "realize hook install"
text tc_n40 "generate refused while realize hook is installed"
text tc_n41 "synth hook free after refused generate"
text tc_n42 "synth hook clear 2"
text tc_n43 "realize hook clear"
text tc_n44 "null hook refused"
text tc_n45 "hook equivalence on unit set"

global tc_pass ulong 1
global tc_fail_c ulong 1
global tc_a uchar 524288
global tc_an ulong 1
global tc_c uchar 524288

fn tc_num v ulong to void
  b = new uchar 24 0
  p = ulong 24
  x = v
  while true bound 24
    p = sub p 1
    put b p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 b p sub 24 p
end

fn tc_chk ok bool name view uchar * to void
  if ok
    put tc_pass 0 add get tc_pass 0 1
  else
    put tc_fail_c 0 add get tc_fail_c 0 1
    sth_wr 1 tc_fail
    sth_wr 1 name
    sth_wr 1 tc_nl
  end
end

fn tc_verify_c clen ulong check_ts ulong to long
  buf = new uchar 524288 0
  for i ulong clen bound 524288
    put buf i get tc_c i
  end
  ret stc_corpus_verify buf clen check_ts
end

fn tc_verify_a alen ulong check_ts ulong to long
  buf = new uchar 524288 0
  for i ulong alen bound 524288
    put buf i get tc_a i
  end
  ret stc_corpus_verify buf alen check_ts
end

fn tc_has_sub ndl view uchar * to bool
  an = get tc_an 0
  nl = len ndl
  if gt nl an
    ret false
  end
  lim = add sub an nl 1
  for i ulong lim bound 524288
    m = ulong 1
    for j ulong nl bound 64
      if ne get tc_a add i j get ndl j
        m = 0
        break
      end
    end
    if eq m 1
      ret true
    end
  end
  ret false
end

fn tc_copy_repl on ulong repl view uchar * rlen ulong to ulong
  for i ulong rlen bound 2048
    put tc_c add on i get repl i
  end
  put tc_c add on rlen 10
  ret add add on rlen 1
end

fn tc_copy_orig on ulong p ulong ln ulong to ulong
  for i ulong ln bound 4096
    put tc_c add on i get tc_a add p i
  end
  ret add on ln
end

fn tc_edit_line which ulong has_repl ulong repl view uchar * rlen ulong to ulong
  an = get tc_an 0
  on = ulong 0
  line = ulong 0
  p = ulong 0
  while lt p an bound 10000
    nl = p
    while lt nl an bound 4096
      if eq ulong get tc_a nl 10
        break
      end
      nl = add nl 1
    end
    if eq line which
      if ne has_repl 0
        on = tc_copy_repl on repl rlen
      end
    else
      on = tc_copy_orig on p add sub nl p 1
    end
    p = add nl 1
    line = add line 1
  end
  ret on
end

fn tc_get_line which ulong dst edit uchar 2048 to ulong
  an = get tc_an 0
  line = ulong 0
  p = ulong 0
  while lt p an bound 10000
    nl = p
    while lt nl an bound 4096
      if eq ulong get tc_a nl 10
        break
      end
      nl = add nl 1
    end
    if eq line which
      ln = sub nl p
      for i ulong ln bound 2048
        put dst i get tc_a add p i
      end
      ret ln
    end
    p = add nl 1
    line = add line 1
  end
  ret 0
end

fn tc_find_in_line line view uchar 2048 ln ulong ndl view uchar * to long
  nl = len ndl
  if gt nl ln
    ret -1
  end
  lim = add sub ln nl 1
  for i ulong lim bound 2048
    m = ulong 1
    for j ulong nl bound 32
      if ne get line add i j get ndl j
        m = 0
        break
      end
    end
    if eq m 1
      ret long i
    end
  end
  ret -1
end

fn tc_test_gen_and_verify to void
  tc_chk eq stc_taskset_parse tc_ts len tc_ts 0 tc_n1
  tc_chk eq stc_corpus_generate 0 tc_n2
  an = get stc_out_len 0
  put tc_an 0 an
  for i ulong an bound 524288
    put tc_a i get stc_out i
  end
  tc_chk eq stc_corpus_generate 0 tc_n3
  same = eq an get stc_out_len 0
  if same
    for i ulong an bound 524288
      if ne get tc_a i get stc_out i
        same = false
        break
      end
    end
  end
  tc_chk same tc_n4
  tc_chk eq tc_verify_a an 1 0 tc_n5
  tc_chk eq tc_verify_a an 0 0 tc_n6
  tc_chk tc_has_sub tc_s_bud tc_n7
  tc_chk tc_has_sub tc_s_sol tc_n8
  tc_chk tc_has_sub tc_s_eqv tc_n9
  tc_chk tc_has_sub tc_s_rrc tc_n10
end

fn tc_test_mutations to void
  an = get tc_an 0
  pok = true
  k = ulong 0
  while lt k an bound 10000
    if eq tc_verify_a k 1 0
      pok = false
      break
    end
    if lt k 4096
      k = add k 1
    else
      k = add k 97
    end
  end
  tc_chk pok tc_n11
  tc_chk ne tc_verify_a sub an 1 1 0 tc_n12

  for i ulong an bound 524288
    put tc_c i get tc_a i
  end
  put tc_c an 120
  put tc_c add an 1 10
  tc_chk ne tc_verify_c add an 2 1 0 tc_n13
  put tc_c 10 13
  tc_chk ne tc_verify_c an 1 0 tc_n14
  put tc_c 10 get tc_a 10
  put tc_c div an 2 0
  tc_chk ne tc_verify_c an 1 0 tc_n15

  all = true
  k = ulong 0
  while lt k an bound 50000
    for i ulong an bound 524288
      put tc_c i get tc_a i
    end
    orig = ulong get tc_a k
    if eq orig 48
      put tc_c k 49
    else
      if eq orig 10
        put tc_c k 32
      else
        put tc_c k 48
      end
    end
    if eq tc_verify_c an 1 0
      all = false
      break
    end
    k = add k 13
  end
  tc_chk all tc_n16
end

fn tc_test_line_edits to void
  emp = new uchar 1 0
  n2 = tc_edit_line 6 0 emp 0
  tc_chk ne tc_verify_c n2 1 0 tc_n17

  l5 = new uchar 2048 0
  ln = tc_get_line 5 l5
  po = tc_find_in_line l5 ln tc_s_pr
  if ge po 0
    for i ulong 11
      put l5 add ulong po i get tc_s_prw i
    end
  end
  n2 = tc_edit_line 5 1 l5 ln
  tc_chk ne tc_verify_c n2 1 0 tc_n18

  ln = tc_get_line 5 l5
  co = tc_find_in_line l5 ln tc_s_ch
  if ge co 0
    for i ulong 64
      c = ulong get l5 add add ulong co 6 i
      if and ge c 97 le c 102
        put l5 add add ulong co 6 i uchar sub c 32
        break
      end
    end
  end
  n2 = tc_edit_line 5 1 l5 ln
  tc_chk ne tc_verify_c n2 1 0 tc_n19

  n2 = tc_edit_line 0 1 tc_s_v2 len tc_s_v2
  tc_chk ne tc_verify_c n2 1 0 tc_n20

  tc_chk eq stc_taskset_parse tc_ts_alt len tc_ts_alt 0 tc_n21
  tc_chk ne tc_verify_a get tc_an 0 1 0 tc_n22
end

fn tc_test_ts_refusals to void
  tc_chk ne stc_taskset_parse tc_r1 len tc_r1 0 tc_n23
  tc_chk ne stc_taskset_parse tc_r2 len tc_r2 0 tc_n24
  tc_chk ne stc_taskset_parse tc_r3 len tc_r3 0 tc_n25
  tc_chk ne stc_taskset_parse tc_r4 len tc_r4 0 tc_n26
  tc_chk ne stc_taskset_parse tc_r5 len tc_r5 0 tc_n27
  tc_chk ne stc_taskset_parse tc_r6 len tc_r6 0 tc_n28
  tc_chk ne stc_taskset_parse tc_r7 len tc_r7 0 tc_n29
  tc_chk ne stc_taskset_parse tc_r8 len tc_r8 0 tc_n30
  tc_chk ne stc_taskset_parse tc_r9 len tc_r9 0 tc_n31
  cr = new uchar 128 0
  rl = len tc_r2
  p = ulong 0
  for i ulong rl bound 128
    c = get tc_r2 i
    if eq ulong c 10
      put cr p 13
      p = add p 1
    end
    put cr p c
    p = add p 1
  end
  tc_chk ne stc_taskset_parse cr p 0 tc_n32
  tc_chk ne stc_taskset_parse tc_r11 len tc_r11 0 tc_n33
end

fn tc_test_hooks to void
  r = stc_taskset_parse tc_ts len tc_ts
  tc_chk eq stc_synth_set_hook 1 101 0 tc_n34
  tc_chk ne stc_synth_set_hook 1 102 0 tc_n35
  tc_chk ne stc_synth_clear_hook 102 0 tc_n36
  tc_chk ne stc_corpus_generate 0 tc_n37
  tc_chk eq stc_synth_clear_hook 101 0 tc_n38
  tc_chk eq stc_real_set_hook 1 101 0 tc_n39
  tc_chk ne stc_corpus_generate 0 tc_n40
  tc_chk eq stc_synth_set_hook 1 102 0 tc_n41
  tc_chk eq stc_synth_clear_hook 102 0 tc_n42
  tc_chk eq stc_real_clear_hook 101 0 tc_n43
  tc_chk ne stc_synth_set_hook 0 101 0 tc_n44
  tc_chk eq stc_hook_equivalence 0 tc_n45
end

fn main to int
  tc_test_gen_and_verify
  tc_test_mutations
  tc_test_line_edits
  tc_test_ts_refusals
  tc_test_hooks
  sth_wr 1 tc_sum1
  tc_num get tc_pass 0
  sth_wr 1 tc_sum2
  tc_num add get tc_pass 0 get tc_fail_c 0
  sth_wr 1 tc_sum3
  if eq get tc_fail_c 0 0
    ret 0
  end
  ret 1
end

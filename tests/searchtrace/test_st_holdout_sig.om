note tests for G3 commitment record (port of test_st_holdout_sig.c).

text ts_pass "PASS "
text ts_fail "FAIL "
text ts_nl "\n"
text ts_sum1 "st_holdout_sig: "
text ts_sum2 "/"
text ts_sum3 " PASS\n"

text ts_kat_id "g3-kat-1"
text ts_kat_id2 "g3-kat-2"
text ts_kat_ts "task alpha\ntask beta\n"
text ts_kat_cm "7008574e68b49d88b0debe5101eec7823a0f11a99833cb5e6aedc9262822b20d"
text ts_kat_rd "20ba763127e9ffd0b563365d1db13f7d3b813f39c9d3b215c1447a48e9f39a28"

text ts_rfc1_sk "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
text ts_rfc1_pk "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
text ts_rfc1_sg "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
text ts_rfc2_sk "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
text ts_rfc2_pk "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
text ts_rfc2_sg "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"

text ts_lbl1 "OMEGA TEST-ONLY G3 signing key 1 (not an owner key)"
text ts_lbl2 "OMEGA TEST-ONLY G3 signing key 2 (not an owner key)"
text ts_v3 "3"
text ts_bdom "omega.g3.holdout.commit.v1"
text ts_blbl "bad id!"
text ts_bkid "ABCDEF"
text ts_bsig "00"
text ts_lax "--lax"
text ts_dir_pfx "/tmp/st_holdout_sig_om_"
text ts_f_ts "/taskset.txt"
text ts_f_sp "/salt.bin"
text ts_f_k1 "/TEST-ONLY-key-1.sk"
text ts_f_k1h "/TEST-ONLY-key-1.hex.sk"
text ts_f_k1d "/TEST-ONLY-key-1.der.sk"
text ts_f_k2 "/TEST-ONLY-key-2.sk"
text ts_f_kopen "/TEST-ONLY-key-1.world.sk"
text ts_f_kpub "/TEST-ONLY-key-1.pk"
text ts_f_kpubh "/TEST-ONLY-key-1.hex.pk"
text ts_f_kpubd "/TEST-ONLY-key-1.der.pk"
text ts_f_kpub2 "/TEST-ONLY-key-2.pk"
text ts_f_sub "/k2"

text ts_t1 "om2 ed25519 RFC 8032 TEST 1 (pk, sig, verify)"
text ts_t2 "om2 ed25519 RFC 8032 TEST 2 (pk, sig, verify)"
text ts_t3 "KAT record digest unchanged (20ba7631...)"
text ts_t4 "KAT commitment unchanged (7008574e...)"
text ts_t5 "sign KAT record with TEST key 1"
text ts_t6 "strict verify accepts it and fills the record"
text ts_t7 "signing is deterministic (same bytes twice)"
text ts_t8 "sign refuses a small output buffer"
text ts_t9 "wrong public key refused (EKEY)"
text ts_t10 "unsigned record refused in strict mode (empty)"
text ts_t11 "key 2 signature relabelled as key 1 refused (ESIG)"
text ts_t12 "small-order public key refused (ESIG)"
text ts_t13 "all-zero signature refused (ESIG)"
text ts_t14 "signature of record A refused for record B (EBIND x2, ESIG)"
text ts_t15 "resealed tampered record refused (EBIND)"
text ts_t16 "every commitment-record byte flip refused"
text ts_t17 "every signature-record byte flip refused"
text ts_t18 "each resealed signature-hex change refused (ESIG)"
text ts_t19 "every truncated signature record refused (EFORMAT)"
text ts_t20 "extended signature record refused"
text ts_t21 "non-canonical signature records refused (EFORMAT)"
text ts_t22 "signature record end digest mismatch refused (EDIGEST)"
text ts_t23 "non-canonical commitment record: sign and verify refuse"
text ts_t24 "cli commit (unchanged)"
text ts_t25 "cli strict verify of an unsigned record refused"
text ts_t26 "cli plain verify of the unsigned record still OK"
text ts_t27 "cli sign refuses a group/world-readable key file"
text ts_t28 "cli sign with TEST key 1"
text ts_t29 "cli signature file is content-named and equals the library's"
text ts_t30 "cli sign again is idempotent"
text ts_t31 "cli sign with hex and PKCS#8 key files gives the same file"
text ts_t32 "cli sign with another key refuses to replace the file"
text ts_t33 "cli strict verify (raw, hex, SPKI public key)"
text ts_t34 "cli strict verify with explicit signature path"
text ts_t35 "cli strict verify with the wrong public key refused"
text ts_t36 "cli sign with key 2 into another folder"
text ts_t37 "cli strict verify refuses key 2's signature under key 1"
text ts_t38 "cli strict verify refuses a secret key given as public key"
text ts_t39 "cli strict verify refuses a truncated signature file"
text ts_t40 "cli strict verify refuses once the signature is removed"
text ts_t41 "cli usage errors exit 1"

global ts_run ulong 1
global ts_ok ulong 1
global ts_sk1 uchar 32
global ts_pk1 uchar 32
global ts_sk2 uchar 32
global ts_pk2 uchar 32
global ts_rec uchar 1024
global ts_rl ulong 1
global ts_sig uchar 1024
global ts_sl ulong 1
global ts_tmp uchar 2048

fn ts_num v ulong to void
  b = new uchar 24 0
  p = ulong 24
  x = v
  while true bound 24
    p = sub p 1
    put b p uchar add 48 rem x 10
    x = div x 10
    if eq x 0
      break
    end
  end
  r = write 1 b p sub 24 p
end

fn ts_chk name view uchar * ok bool to void
  put ts_run 0 add get ts_run 0 1
  if ok
    put ts_ok 0 add get ts_ok 0 1
    sth_wr 1 ts_pass
  else
    sth_wr 1 ts_fail
  end
  sth_wr 1 name
  sth_wr 1 ts_nl
end

fn ts_unhex hx view uchar * n ulong dst edit uchar * to void
  for i ulong n bound 64
    c1 = ulong get hx mul i 2
    c2 = ulong get hx add mul i 2 1
    h1 = ulong 0
    if ge c1 97
      h1 = add 10 sub c1 97
    else
      h1 = sub c1 48
    end
    h2 = ulong 0
    if ge c2 97
      h2 = add 10 sub c2 97
    else
      h2 = sub c2 48
    end
    put dst i uchar or shl h1 4 h2
  end
end

fn ts_hex_eq32 d view uchar 32 hx view uchar * to bool
  for i ulong 32
    b = ulong get d i
    if ne sth_hex_nib shr b 4 get hx mul i 2
      ret false
    end
    if ne sth_hex_nib and b 15 get hx add mul i 2 1
      ret false
    end
  end
  ret true
end

fn ts_eq_buf a view uchar * b view uchar * n ulong to bool
  for i ulong n bound 2048
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

fn ts_reseal b edit uchar 1024 blen ulong to void
  body = sub blen 69
  d = new uchar 32 0
  sth_sha256_buf b body d
  for i ulong 32
    bv = ulong get d i
    put b add add body 4 mul i 2 sth_hex_nib shr bv 4
    put b add add body 4 add mul i 2 1 sth_hex_nib and bv 15
  end
end

fn ts_line_has_key b view uchar 1024 p ulong ll ulong key view uchar * to bool
  kl = len key
  if le ll kl
    ret false
  end
  if ne ulong get b add p kl 32
    ret false
  end
  for i ulong kl bound 32
    if ne get b add p i get key i
      ret false
    end
  end
  ret true
end

fn ts_splice_field b edit uchar 1024 blen ulong pre ulong nl ulong val view uchar * to ulong
  vl = len val
  post = sub blen nl
  nlen = add add pre vl post
  if gt nlen 1024
    ret 0
  end
  for i ulong pre bound 1024
    put ts_tmp i get b i
  end
  for i ulong vl bound 256
    put ts_tmp add pre i get val i
  end
  for i ulong post bound 1024
    put ts_tmp add add pre vl i get b add nl i
  end
  for i ulong nlen bound 1024
    put b i get ts_tmp i
  end
  ts_reseal b nlen
  ret nlen
end

fn ts_set_field b edit uchar 1024 blen ulong key view uchar * val view uchar * to ulong
  p = ulong 0
  while lt p blen bound 1024
    nl = p
    while lt nl blen bound 1024
      if eq ulong get b nl 10
        break
      end
      nl = add nl 1
    end
    if ts_line_has_key b p sub nl p key
      pre = add add p len key 1
      ret ts_splice_field b blen pre nl val
    end
    p = add nl 1
  end
  ret 0
end

fn ts_test_rfc8032 to void
  sk = new uchar 32 0
  pk = new uchar 32 0
  wpk = new uchar 32 0
  sg = new uchar 64 0
  wsg = new uchar 64 0
  msg = new uchar 65536 0
  put msg 0 0x72
  ts_unhex ts_rfc1_sk 32 sk
  ts_unhex ts_rfc1_pk 32 wpk
  ts_unhex ts_rfc1_sg 64 wsg
  ues_pubkey sk pk
  ues_sign sk msg 0 sg
  ok1 = and ts_eq_buf pk wpk 32 and ts_eq_buf sg wsg 64 sth_edverify_strict pk msg 0 sg
  ts_chk ts_t1 ok1

  ts_unhex ts_rfc2_sk 32 sk
  ts_unhex ts_rfc2_pk 32 wpk
  ts_unhex ts_rfc2_sg 64 wsg
  ues_pubkey sk pk
  ues_sign sk msg 1 sg
  ok2 = and ts_eq_buf pk wpk 32 and ts_eq_buf sg wsg 64 sth_edverify_strict pk msg 1 sg
  ts_chk ts_t2 ok2
end

fn ts_setup_keys_and_kat to void
  sk = new uchar 32 0
  pk = new uchar 32 0
  sth_sha256_buf ts_lbl1 len ts_lbl1 sk
  ues_pubkey sk pk
  for i ulong 32
    put ts_sk1 i get sk i
    put ts_pk1 i get pk i
  end
  sth_sha256_buf ts_lbl2 len ts_lbl2 sk
  ues_pubkey sk pk
  for i ulong 32
    put ts_sk2 i get sk i
    put ts_pk2 i get pk i
  end
  salt = new uchar 32 0
  for i ulong 32
    put salt i uchar i
  end
  r = sth_commit ts_kat_id ts_kat_ts salt STH_REC_MAX
  rl = get sth_reclen 0
  put ts_rl 0 rl
  rec = new uchar 1024 0
  for i ulong rl bound 1024
    put ts_rec i get sth_rec i
    put rec i get sth_rec i
  end
  rp = sth_parse rec rl
  rd = new uchar 32 0
  cm = new uchar 32 0
  for i ulong 32
    put rd i get sth_c_rd i
    put cm i get sth_c_cm i
  end
  ts_chk ts_t3 and eq r 0 ts_hex_eq32 rd ts_kat_rd
  ts_chk ts_t4 and eq rp 0 ts_hex_eq32 cm ts_kat_cm
end

fn ts_test_sign_verify to void
  rl = get ts_rl 0
  rec = new uchar 1024 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  k = new uchar 32 0
  for i ulong 32
    put k i get ts_sk1 i
  end
  r = sth_sign rec rl k STH_REC_MAX
  sl = get sth_siglen 0
  put ts_sl 0 sl
  sg = new uchar 1024 0
  for i ulong sl bound 1024
    put ts_sig i get sth_sig i
    put sg i get sth_sig i
  end
  ts_chk ts_t5 and eq r 0 gt sl 0
  for i ulong 32
    put k i get ts_pk1 i
  end
  r = sth_verify_signed rec rl sg sl k
  for i ulong 32
    put k i get sth_c_rd i
  end
  ts_chk ts_t6 and eq r 0 and ts_hex_eq32 k ts_kat_rd eq get sth_c_tcnt 0 2
  for i ulong 32
    put k i get ts_sk1 i
  end
  r = sth_sign rec rl k STH_REC_MAX
  ok = and eq r 0 eq sl get sth_siglen 0
  if ok
    for i ulong sl bound 1024
      if ne get sg i get sth_sig i
        ok = false
      end
    end
  end
  ts_chk ts_t7 ok
  ts_chk ts_t8 eq sth_sign rec rl k sub sl 1 STH_ECAP
end

fn ts_sha256_hex32 src view uchar 32 dst edit uchar 64 to void
  for i ulong 32
    put sh_dat i get src i
  end
  sh_all 32
  for i ulong 32
    bv = ulong get sh_dig i
    put dst mul i 2 sth_hex_nib shr bv 4
    put dst add mul i 2 1 sth_hex_nib and bv 15
  end
end

fn ts_test_refusals_a to void
  rl = get ts_rl 0
  sl = get ts_sl 0
  rec = new uchar 1024 0
  sg = new uchar 1024 0
  sg2 = new uchar 1024 0
  k = new uchar 32 0
  kh = new uchar 64 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  for i ulong sl bound 1024
    put sg i get ts_sig i
  end
  for i ulong 32
    put k i get ts_pk2 i
  end
  ts_chk ts_t9 eq sth_verify_signed rec rl sg sl k STH_EKEY
  for i ulong 32
    put k i get ts_pk1 i
  end
  ts_chk ts_t10 eq sth_verify_signed rec rl sg 0 k STH_EUNSIGNED

  for i ulong 32
    put k i get ts_sk2 i
  end
  r0 = sth_sign rec rl k STH_REC_MAX
  sl2 = get sth_siglen 0
  for i ulong sl2 bound 1024
    put sg2 i get sth_sig i
  end
  for i ulong 32
    put k i get ts_pk1 i
  end
  ts_sha256_hex32 k kh
  sl2 = ts_set_field sg2 sl2 sth_k_kid kh
  ts_chk ts_t11 and ne sl2 0 eq sth_verify_signed rec rl sg2 sl2 k STH_ESIG

  for i ulong 32
    put k i 0
  end
  put k 0 1
  ts_sha256_hex32 k kh
  for i ulong sl bound 1024
    put sg2 i get sg i
  end
  sl2 = ts_set_field sg2 sl sth_k_kid kh
  ts_chk ts_t12 and ne sl2 0 eq sth_verify_signed rec rl sg2 sl2 k STH_ESIG

  zh = new uchar 128 48
  for i ulong 32
    put k i get ts_pk1 i
  end
  for i ulong sl bound 1024
    put sg2 i get sg i
  end
  sl2 = ts_set_field sg2 sl sth_k_sig zh
  ts_chk ts_t13 eq sth_verify_signed rec rl sg2 sl2 k STH_ESIG
end

fn ts_sha256_hex_buf src view uchar 1024 slen ulong dst edit uchar 64 to void
  for i ulong slen bound 1024
    put sh_dat i get src i
  end
  sh_all slen
  for i ulong 32
    bv = ulong get sh_dig i
    put dst mul i 2 sth_hex_nib shr bv 4
    put dst add mul i 2 1 sth_hex_nib and bv 15
  end
end

fn ts_test_refusals_b to void
  rl = get ts_rl 0
  sl = get ts_sl 0
  rec = new uchar 1024 0
  rec2 = new uchar 1024 0
  sg = new uchar 1024 0
  sg2 = new uchar 1024 0
  pk1 = new uchar 32 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  for i ulong sl bound 1024
    put sg i get ts_sig i
  end
  for i ulong 32
    put pk1 i get ts_pk1 i
  end
  salt = new uchar 32 0
  for i ulong 32
    put salt i uchar i
  end
  ok = eq sth_commit ts_kat_id2 ts_kat_ts salt STH_REC_MAX 0
  rl2 = get sth_reclen 0
  for i ulong rl2 bound 1024
    put rec2 i get sth_rec i
  end
  if ne sth_verify_signed rec2 rl2 sg sl pk1 STH_EBIND
    ok = false
  end
  for i ulong sl bound 1024
    put sg2 i get sg i
  end
  sl2 = ts_set_field sg2 sl sth_k_hid ts_kat_id2
  if ne sth_verify_signed rec2 rl2 sg2 sl2 pk1 STH_EBIND
    ok = false
  end
  dh = new uchar 64 0
  ts_sha256_hex_buf rec2 rl2 dh
  sl2 = ts_set_field sg2 sl2 sth_k_rdig dh
  if ne sth_verify_signed rec2 rl2 sg2 sl2 pk1 STH_ESIG
    ok = false
  end
  ts_chk ts_t14 ok

  for i ulong rl bound 1024
    put rec2 i get rec i
  end
  rl2 = ts_set_field rec2 rl sth_k_tcnt ts_v3
  ok = eq sth_parse rec2 rl2 0
  if ne sth_verify_signed rec2 rl2 sg sl pk1 STH_EBIND
    ok = false
  end
  ts_chk ts_t15 ok
end

fn ts_test_sighex_trunc to void
  rl = get ts_rl 0
  sl = get ts_sl 0
  rec = new uchar 1024 0
  sg = new uchar 1024 0
  sg2 = new uchar 1024 0
  pk1 = new uchar 32 0
  sh = new uchar 128 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  for i ulong sl bound 1024
    put sg i get ts_sig i
  end
  for i ulong 32
    put pk1 i get ts_pk1 i
  end
  soff = ulong 0
  for i ulong sub sl 11 bound 1024
    if eq ulong get sg i 10
      if eq ulong get sg add i 1 115
        if eq ulong get sg add i 10 32
          soff = add i 11
          break
        end
      end
    end
  end
  all = true
  for i ulong 128
    for j ulong 128
      put sh j get sg add soff j
    end
    if eq ulong get sh i 48
      put sh i 49
    else
      put sh i 48
    end
    for j ulong sl bound 1024
      put sg2 j get sg j
    end
    sl2 = ts_set_field sg2 sl sth_k_sig sh
    if ne sth_verify_signed rec rl sg2 sl2 pk1 STH_ESIG
      all = false
    end
  end
  ts_chk ts_t18 all

  all = true
  for ll ulong sub sl 1 bound 1024
    if ne sth_verify_signed rec rl sg add ll 1 pk1 STH_EFORMAT
      all = false
    end
  end
  ts_chk ts_t19 all
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  put sg2 sl 10
  ts_chk ts_t20 eq sth_verify_signed rec rl sg2 add sl 1 pk1 STH_EFORMAT
end

fn ts_test_flips_and_trunc to void
  rl = get ts_rl 0
  sl = get ts_sl 0
  rec = new uchar 1024 0
  rec2 = new uchar 1024 0
  sg = new uchar 1024 0
  sg2 = new uchar 1024 0
  pk1 = new uchar 32 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  for i ulong sl bound 1024
    put sg i get ts_sig i
  end
  for i ulong 32
    put pk1 i get ts_pk1 i
  end
  all = true
  for i ulong rl bound 1024
    for j ulong rl bound 1024
      put rec2 j get rec j
    end
    put rec2 i xor get rec i 1
    if eq sth_verify_signed rec2 rl sg sl pk1 0
      all = false
    end
    put rec2 i xor get rec i 0x80
    if eq sth_verify_signed rec2 rl sg sl pk1 0
      all = false
    end
  end
  ts_chk ts_t16 all

  all = true
  for i ulong sl bound 1024
    for j ulong sl bound 1024
      put sg2 j get sg j
    end
    put sg2 i xor get sg i 1
    if eq sth_verify_signed rec rl sg2 sl pk1 0
      all = false
    end
    put sg2 i xor get sg i 0x80
    if eq sth_verify_signed rec rl sg2 sl pk1 0
      all = false
    end
  end
  ts_chk ts_t17 all
  ts_test_sighex_trunc
end

fn ts_test_noncanon to void
  rl = get ts_rl 0
  sl = get ts_sl 0
  rec = new uchar 1024 0
  rec2 = new uchar 1024 0
  sg = new uchar 1024 0
  sg2 = new uchar 1024 0
  pk1 = new uchar 32 0
  sk1 = new uchar 32 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  for i ulong sl bound 1024
    put sg i get ts_sig i
  end
  for i ulong 32
    put pk1 i get ts_pk1 i
    put sk1 i get ts_sk1 i
  end
  all = true
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  sl2 = ts_set_field sg2 sl sth_k_domain ts_bdom
  if ne sth_verify_signed rec rl sg2 sl2 pk1 STH_EFORMAT
    all = false
  end
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  sl2 = ts_set_field sg2 sl sth_k_hid ts_blbl
  if ne sth_verify_signed rec rl sg2 sl2 pk1 STH_EFORMAT
    all = false
  end
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  sl2 = ts_set_field sg2 sl sth_k_kid ts_bkid
  if ne sth_verify_signed rec rl sg2 sl2 pk1 STH_EFORMAT
    all = false
  end
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  sl2 = ts_set_field sg2 sl sth_k_sig ts_bsig
  if ne sth_verify_signed rec rl sg2 sl2 pk1 STH_EFORMAT
    all = false
  end
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  put sg2 21 50
  if ne sth_verify_signed rec rl sg2 sl pk1 STH_EFORMAT
    all = false
  end
  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  put sg2 23 13
  if ne sth_verify_signed rec rl sg2 sl pk1 STH_EFORMAT
    all = false
  end
  ts_chk ts_t21 all

  for j ulong sl bound 1024
    put sg2 j get sg j
  end
  idx = sub sl 2
  if eq ulong get sg2 idx 48
    put sg2 idx 49
  else
    put sg2 idx 48
  end
  ts_chk ts_t22 eq sth_verify_signed rec rl sg2 sl pk1 STH_EDIGEST

  for j ulong rl bound 1024
    put rec2 j get rec j
  end
  put rec2 rl 120
  all = eq sth_sign rec2 add rl 1 sk1 STH_REC_MAX STH_EFORMAT
  if ne sth_verify_signed rec2 add rl 1 sg sl pk1 STH_EFORMAT
    all = false
  end
  ts_chk ts_t23 all
end

fn ts_mkp dir view uchar 512 dlen ulong suf view uchar * dst edit uchar 512 to ulong
  p = ulong 0
  for i ulong dlen bound 400
    put dst p get dir i
    p = add p 1
  end
  sl = len suf
  for i ulong sl bound 100
    put dst p get suf i
    p = add p 1
  end
  ret p
end

fn ts_wf pth view uchar 512 plen ulong dat view uchar * dlen ulong mode int to void
  fd = fopen pth 0 plen 577 mode
  if ge fd 0
    w = write int fd dat 0 dlen
    cf = fchmod int fd mode
    c = fclose int fd
  end
end

fn ts_test_cli_prep dir edit uchar 512 to ulong
  sth_init_der
  dl = len ts_dir_pfx
  for i ulong dl bound 64
    put dir i get ts_dir_pfx i
  end
  dl = sth_append_u64_buf dir dl ulong getpid
  r = makedir dir 0 dl 448
  p = new uchar 512 0
  k = new uchar 32 0
  hx = new uchar 65 0
  der = new uchar 48 0
  pl = ts_mkp dir dl ts_f_sub p
  r = makedir p 0 pl 448
  for i ulong 32
    put k i uchar i
  end
  pl = ts_mkp dir dl ts_f_ts p
  ts_wf p pl ts_kat_ts len ts_kat_ts 384
  pl = ts_mkp dir dl ts_f_sp p
  ts_wf p pl k 32 384

  for i ulong 32
    put k i get ts_sk1 i
  end
  pl = ts_mkp dir dl ts_f_k1 p
  ts_wf p pl k 32 384
  pl = ts_mkp dir dl ts_f_kopen p
  ts_wf p pl k 32 420
  for i ulong 32
    bv = ulong get k i
    put hx mul i 2 sth_hex_nib shr bv 4
    put hx add mul i 2 1 sth_hex_nib and bv 15
  end
  put hx 64 10
  pl = ts_mkp dir dl ts_f_k1h p
  ts_wf p pl hx 65 384
  for i ulong 16
    put der i get sth_pkcs8 i
  end
  for i ulong 32
    put der add 16 i get k i
  end
  pl = ts_mkp dir dl ts_f_k1d p
  ts_wf p pl der 48 384

  for i ulong 32
    put k i get ts_sk2 i
  end
  pl = ts_mkp dir dl ts_f_k2 p
  ts_wf p pl k 32 384

  for i ulong 32
    put k i get ts_pk1 i
  end
  pl = ts_mkp dir dl ts_f_kpub p
  ts_wf p pl k 32 420
  for i ulong 32
    bv = ulong get k i
    put hx mul i 2 sth_hex_nib shr bv 4
    put hx add mul i 2 1 sth_hex_nib and bv 15
  end
  pl = ts_mkp dir dl ts_f_kpubh p
  ts_wf p pl hx 64 420
  for i ulong 12
    put der i get sth_spki i
  end
  for i ulong 32
    put der add 12 i get k i
  end
  pl = ts_mkp dir dl ts_f_kpubd p
  ts_wf p pl der 44 420

  for i ulong 32
    put k i get ts_pk2 i
  end
  pl = ts_mkp dir dl ts_f_kpub2 p
  ts_wf p pl k 32 420
  ret dl
end

fn ts_sig_file_eq sigp view uchar 512 sigpl ulong to bool
  sl2 = sth_read_file sigp sigpl 1
  sl = get ts_sl 0
  if ne sl2 long sl
    ret false
  end
  for i ulong sl bound 1024
    if ne get sth_fbuf2 i get ts_sig i
      ret false
    end
  end
  ret true
end

fn ts_test_cli_a dir view uchar 512 dl ulong recp view uchar 512 recpl ulong sigp view uchar 512 sigpl ulong to void
  p = new uchar 512 0
  put sth_argc 0 5
  sth_arg_set 0 sth_t_cmd_commit len sth_t_cmd_commit
  sth_arg_set 1 ts_kat_id len ts_kat_id
  pl = ts_mkp dir dl ts_f_ts p
  sth_arg_set 2 p pl
  pl = ts_mkp dir dl ts_f_sp p
  sth_arg_set 3 p pl
  sth_arg_set 4 dir dl
  ts_chk ts_t24 eq sth_cli_run 0

  put sth_argc 0 4
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 sth_t_opt_strict len sth_t_opt_strict
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  sth_arg_set 3 recp recpl
  ts_chk ts_t25 eq sth_cli_run 2

  put sth_argc 0 2
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 recp recpl
  ts_chk ts_t26 eq sth_cli_run 0

  put sth_argc 0 4
  sth_arg_set 0 sth_t_cmd_sign len sth_t_cmd_sign
  sth_arg_set 1 recp recpl
  pl = ts_mkp dir dl ts_f_kopen p
  sth_arg_set 2 p pl
  sth_arg_set 3 dir dl
  ok = eq sth_cli_run 2
  if eq faccess sigp 0 sigpl 0 0
    ok = false
  end
  ts_chk ts_t27 ok

  pl = ts_mkp dir dl ts_f_k1 p
  sth_arg_set 2 p pl
  ts_chk ts_t28 eq sth_cli_run 0
  ts_chk ts_t29 ts_sig_file_eq sigp sigpl
  ts_chk ts_t30 eq sth_cli_run 0

  pl = ts_mkp dir dl ts_f_k1h p
  sth_arg_set 2 p pl
  ok = eq sth_cli_run 0
  pl = ts_mkp dir dl ts_f_k1d p
  sth_arg_set 2 p pl
  if ne sth_cli_run 0
    ok = false
  end
  ts_chk ts_t31 ok

  pl = ts_mkp dir dl ts_f_k2 p
  sth_arg_set 2 p pl
  ts_chk ts_t32 eq sth_cli_run 2
end

fn ts_test_cli_b2 dir view uchar 512 dl ulong recp view uchar 512 recpl ulong sigp view uchar 512 sigpl ulong to void
  p = new uchar 512 0
  sg = new uchar 1024 0
  for i ulong get ts_sl 0 bound 1024
    put sg i get ts_sig i
  end
  ts_wf sigp sigpl sg sub get ts_sl 0 1 420
  put sth_argc 0 4
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 sth_t_opt_strict len sth_t_opt_strict
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  sth_arg_set 3 recp recpl
  ts_chk ts_t39 eq sth_cli_run 2

  r = unlink sigp 0 sigpl
  ts_chk ts_t40 eq sth_cli_run 2

  put sth_argc 0 3
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 sth_t_opt_strict len sth_t_opt_strict
  sth_arg_set 2 p pl
  ok = eq sth_cli_run 1
  sth_arg_set 0 sth_t_cmd_sign len sth_t_cmd_sign
  sth_arg_set 1 recp recpl
  pl = ts_mkp dir dl ts_f_k1 p
  sth_arg_set 2 p pl
  if ne sth_cli_run 1
    ok = false
  end
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 ts_lax len ts_lax
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  if ne sth_cli_run 1
    ok = false
  end
  ts_chk ts_t41 ok
  r = unlink recp 0 recpl
end

fn ts_mk_sub_sigp p2 view uchar 512 p2l ulong dst edit uchar 512 to ulong
  rd = new uchar 32 0
  for i ulong get ts_rl 0 bound 1024
    put sh_dat i get ts_rec i
  end
  sh_all get ts_rl 0
  for i ulong 32
    put rd i get sh_dig i
  end
  ret sth_make_out_path p2 p2l sth_t_p_sig rd dst
end

fn ts_test_cli_b dir view uchar 512 dl ulong recp view uchar 512 recpl ulong sigp view uchar 512 sigpl ulong to void
  p = new uchar 512 0
  p2 = new uchar 512 0
  put sth_argc 0 4
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 sth_t_opt_strict len sth_t_opt_strict
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  sth_arg_set 3 recp recpl
  ok = eq sth_cli_run 0
  pl = ts_mkp dir dl ts_f_kpubh p
  sth_arg_set 2 p pl
  if ne sth_cli_run 0
    ok = false
  end
  pl = ts_mkp dir dl ts_f_kpubd p
  sth_arg_set 2 p pl
  if ne sth_cli_run 0
    ok = false
  end
  ts_chk ts_t33 ok

  put sth_argc 0 5
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  sth_arg_set 4 sigp sigpl
  ts_chk ts_t34 eq sth_cli_run 0

  put sth_argc 0 4
  pl = ts_mkp dir dl ts_f_kpub2 p
  sth_arg_set 2 p pl
  ts_chk ts_t35 eq sth_cli_run 2

  p2l = ts_mkp dir dl ts_f_sub p2
  put sth_argc 0 4
  sth_arg_set 0 sth_t_cmd_sign len sth_t_cmd_sign
  sth_arg_set 1 recp recpl
  pl = ts_mkp dir dl ts_f_k2 p
  sth_arg_set 2 p pl
  sth_arg_set 3 p2 p2l
  ts_chk ts_t36 eq sth_cli_run 0

  recs = new uchar 512 0
  recsl = ts_mk_sub_sigp p2 p2l recs

  put sth_argc 0 5
  sth_arg_set 0 sth_t_cmd_verify len sth_t_cmd_verify
  sth_arg_set 1 sth_t_opt_strict len sth_t_opt_strict
  pl = ts_mkp dir dl ts_f_kpub p
  sth_arg_set 2 p pl
  sth_arg_set 3 recp recpl
  sth_arg_set 4 recs recsl
  ts_chk ts_t37 eq sth_cli_run 2

  put sth_argc 0 4
  pl = ts_mkp dir dl ts_f_k1h p
  sth_arg_set 2 p pl
  ts_chk ts_t38 eq sth_cli_run 2

  r = unlink recs 0 recsl
  r = rmdir p2 0 p2l
  ts_test_cli_b2 dir dl recp recpl sigp sigpl
end

fn ts_test_cli_cleanup dir view uchar 512 dl ulong to void
  p = new uchar 512 0
  pl = ts_mkp dir dl ts_f_ts p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_sp p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_k1 p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_kopen p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_kpub p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_k1h p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_k1d p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_k2 p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_kpubh p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_kpubd p
  r = unlink p 0 pl
  pl = ts_mkp dir dl ts_f_kpub2 p
  r = unlink p 0 pl
  r = rmdir dir 0 dl
end

fn ts_test_cli_run dir view uchar 512 dl ulong to void
  rd = new uchar 32 0
  rec = new uchar 1024 0
  rl = get ts_rl 0
  for i ulong rl bound 1024
    put rec i get ts_rec i
  end
  sth_sha256_buf rec rl rd
  recp = new uchar 512 0
  recpl = sth_make_out_path dir dl sth_t_p_commit rd recp
  sigp = new uchar 512 0
  sigpl = sth_make_out_path dir dl sth_t_p_sig rd sigp
  ts_test_cli_a dir dl recp recpl sigp sigpl
  ts_test_cli_b dir dl recp recpl sigp sigpl
  ts_test_cli_cleanup dir dl
end

fn main to int
  ts_test_rfc8032
  ts_setup_keys_and_kat
  ts_test_sign_verify
  ts_test_refusals_a
  ts_test_refusals_b
  ts_test_flips_and_trunc
  ts_test_noncanon
  dir = new uchar 512 0
  dl = ts_test_cli_prep dir
  ts_test_cli_run dir dl
  sth_wr 1 ts_sum1
  ts_num get ts_ok 0
  sth_wr 1 ts_sum2
  ts_num get ts_run 0
  sth_wr 1 ts_sum3
  if eq get ts_ok 0 get ts_run 0
    ret 0
  end
  ret 1
end

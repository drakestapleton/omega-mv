note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_sm121_disasm.om
note   src/omega_gpu_fmt.om
om2

global g_out uchar 4096
global g_out_n ulong 1

text t_pass_msg "PASS test-bw-cpu-disasm-om\n"
text t_fmt_all "%s:%c:%d:%u:%x:%ld:%lu:%lld:%llu:%zu:%%"
text t_fmt_sbuf "stage"
text t_fmt_trunc "%s"
text t_fmt_trunc_s "truncate me"
text t_fmt_d "%d"
text t_fmt_null "v=%s"
text t_fmt_bad "a%qb%"
text t_fmt_min "%d:%lld"

text t_exp_fmt_all "stage:x:-42:4000000000:beef:-99:1234567890123:-7:9876543210987:4096:%"
text t_exp_fmt_trunc "trunc"
text t_exp_fmt_null "v=(null)"
text t_exp_fmt_bad "a%qb%"
text t_exp_fmt_min "-2147483648:-9223372036854775808"

fn out_flush to void
  n = get g_out_n 0
  if gt n 0
    ign = write 1 g_out 0 n
    put g_out_n 0 0
  end
end

fn out_ch c uchar to void
  n = get g_out_n 0
  if ge n 4000
    out_flush
    n = 0
  end
  put g_out n c
  put g_out_n 0 add n 1
end

fn out_cstr buf view uchar * maxn ulong to void
  i = ulong 0
  while and lt i maxn ne get buf i 0 bound 4096
    out_ch get buf i
    i = add i 1
  end
end

fn out_dec v long to void
  if lt v 0
    out_ch 45
    v = sub 0 v
  end
  buf = new uchar 24 0
  k = ulong 0
  u = ulong v
  if eq u 0
    out_ch 48
    ret
  end
  while gt u 0 bound 24
    put buf k uchar add 48 rem u 10
    k = add k 1
    u = div u 10
  end
  for i ulong k bound 24
    out_ch get buf sub sub k 1 i
  end
end

fn cstr_eq a view uchar * b view uchar * to long
  bn = len b
  for i ulong bn bound 4096
    if ne get a i get b i
      ret 0
    end
  end
  if ne get a bn 0
    ret 0
  end
  ret 1
end

fn emit_case dump ulong lo ulong hi ulong pc ulong expect_rc long to long
  buf = new uchar 256 0
  rc = omega_sm121_disasm lo hi pc buf 256
  if ne rc expect_rc
    ret 1
  end
  if ne dump 0
    out_ch 68
    out_ch 58
    out_dec rc
    out_ch 58
    out_cstr buf 256
    out_ch 10
    out_flush
  end
  ret 0
end

fn store_le64 dst edit uchar * off ulong v ulong to void
  for i ulong 8
    put dst add off i uchar and shr v mul i 8 255
  end
end

fn test_disasm_cases dump ulong to long
  note MOV R3, 0x1234
  lo = or ulong 0x0000000000007802 or shl ulong 3 16 shl ulong 0x1234 32
  if ne emit_case dump lo ulong 0x00000f00 0 0 0
    ret 10
  end
  note @P0 MOV R4, RZ
  lo = or ulong 0x00000000ff000202 or shl ulong 4 16 shl ulong 255 32
  if ne emit_case dump lo ulong 0x00000f00 16 0 0
    ret 11
  end
  note @!P2 S2R R5, SR_TID.X
  lo = or ulong 0x000000000000a919 shl ulong 5 16
  if ne emit_case dump lo shl ulong 0x21 8 32 0 0
    ret 12
  end
  note LDC.64 R6, c[0x0][0x380]
  lo = or ulong 0x00000000ff007b82 or shl ulong 6 16 shl ulong 0x380 38
  if ne emit_case dump lo ulong 0x00000a00 48 0 0
    ret 13
  end
  note LDCU UR4, c[0x0][0x384]
  lo = or ulong 0x00000000ff0077ac or shl ulong 4 16 shl ulong 0x384 37
  if ne emit_case dump lo ulong 0x08000800 64 0 0
    ret 14
  end
  note IMAD.MOV R2, RZ, 0x0, R7
  lo = or ulong 0x0000000000007824 or shl ulong 2 16 shl ulong 255 24
  hi = or ulong 0x078e0200 7
  if ne emit_case dump lo hi 80 0 0
    ret 15
  end
  note IMAD.IADD R2, R3, 0x1, R4
  lo = or ulong 0x0000000000007824 or shl ulong 2 16 or shl ulong 3 24 shl ulong 1 32
  hi = or ulong 0x078e0200 4
  if ne emit_case dump lo hi 96 0 0
    ret 16
  end
  note IMAD.SHL R2, R3, 0x8, RZ
  lo = or ulong 0x0000000000007824 or shl ulong 2 16 or shl ulong 3 24 shl ulong 8 32
  hi = or ulong 0x078e0200 255
  if ne emit_case dump lo hi 112 0 0
    ret 17
  end
  note IMAD R2, R3, 0x10000, RZ
  lo = or ulong 0x0000000000007824 or shl ulong 2 16 or shl ulong 3 24 shl ulong 0x10000 32
  hi = or ulong 0x078e0200 255
  if ne emit_case dump lo hi 128 0 0
    ret 18
  end
  note IMAD unknown shift 2^15 -> -1
  lo = or ulong 0x0000000000007824 or shl ulong 2 16 or shl ulong 3 24 shl ulong 0x8000 32
  hi = or ulong 0x078e0200 255
  if ne emit_case dump lo hi 144 -1 0
    ret 19
  end
  note IADD3 R8, PT, PT, -R1, -0x4, RZ
  lo = or ulong 0x0000000000007810 or shl ulong 8 16 or shl ulong 1 24 shl ulong 0xfffffffc 32
  hi = or ulong 0x07ffe100 255
  if ne emit_case dump lo hi 160 0 0
    ret 20
  end
  note ISETP.GE.U32.AND P0, PT, R2, -0x1, PT
  lo = or ulong 0x000000000000780c or shl ulong 2 24 shl ulong 0xffffffff 32
  hi = or ulong 0x00000070 or shl ulong 6 12 or shl ulong 7 20 shl ulong 7 23
  if ne emit_case dump lo hi 176 0 0
    ret 21
  end
  note FADD R10, R11, -R12
  lo = or ulong 0x8000000000007221 or shl ulong 10 16 or shl ulong 11 24 shl ulong 12 32
  if ne emit_case dump lo 0 192 0 0
    ret 22
  end
  note HMMA.16816.F32.BF16 R16, R0, R4, R16
  lo = or ulong 0x000000000000723c or shl ulong 16 16 shl ulong 4 32
  hi = or ulong 0x00041800 16
  if ne emit_case dump lo hi 208 0 0
    ret 23
  end
  note LDG.E.128 R4, desc[UR6][R2.64+-0x10]
  lo = or ulong 0x0000000000007981 or shl ulong 4 16 or shl ulong 2 24 or shl ulong 6 32 shl ulong 0xfffff0 40
  hi = or ulong 0x0c1e1100 shl ulong 6 9
  if ne emit_case dump lo hi 224 0 0
    ret 24
  end
  note BRA backward -4 units (-16 bytes) from pc=0x40 -> 0x40
  lo = or ulong 0x0000000000007947 or shl ulong 0xfc 16 shl ulong 0x3fffffff 34
  hi = or ulong 0x03800000 0x3ffff
  if ne emit_case dump lo hi 0x40 0 0
    ret 25
  end
  note Unknown opcode -> -1
  if ne emit_case dump ulong 0xdeadbeef00000001 ulong 0x0123456789abcdef 0x100 -1 0
    ret 26
  end
  note Buffer too small -> -2
  tiny = new uchar 32 0
  if ne omega_sm121_disasm 0x0000000000007918 0 0 tiny 32 -2
    ret 27
  end
  ret 0
end

fn test_listing dump ulong to long
  code = new uchar 64 0
  note 0x00: NOP
  store_le64 code 0 0x0000000000007918
  store_le64 code 8 0
  note 0x10: EXIT
  store_le64 code 16 0x000000000000794d
  store_le64 code 24 0x03800000
  note 0x20: BRA 0x20 (self-loop padding)
  store_le64 code 32 or ulong 0x0000000000007947 or shl ulong 0xfc 16 shl ulong 0x3fffffff 34
  store_le64 code 40 or ulong 0x03800000 0x3ffff
  note 0x30: NOP (padding)
  store_le64 code 48 0x0000000000007918
  store_le64 code 56 0
  if ne omega_sm121_padding_start code 64 32
    ret 30
  end
  if ne omega_sm121_padding_start code 16 0
    ret 31
  end
  lst = new uchar 1024 0
  largs = new ulong 3 0
  put largs 0 64
  put largs 1 1024
  rc = omega_sm121_listing code lst largs
  if ne rc 0
    ret 32
  end
  olen = get largs 2
  put largs 0 15
  if ne omega_sm121_listing code lst largs -1
    ret 33
  end
  if ne dump 0
    out_ch 76
    out_ch 58
    out_dec long olen
    out_ch 10
    out_cstr lst olen
    out_flush
  end
  ret 0
end

fn test_gpu_fmt dump ulong to long
  dst = new uchar 256 0
  meta = new ulong 32 0
  sbuf = new uchar 256 0
  for i ulong len t_fmt_sbuf bound 32
    put sbuf i get t_fmt_sbuf i
  end
  for i ulong len t_fmt_trunc_s bound 32
    put sbuf add 32 i get t_fmt_trunc_s i
  end
  put meta 0 256
  put meta 1 0
  put meta 16 len t_fmt_sbuf
  put meta 2 120
  put meta 3 sub ulong 0 42
  put meta 4 4000000000
  put meta 5 0xbeef
  put meta 6 sub ulong 0 99
  put meta 7 1234567890123
  put meta 8 sub ulong 0 7
  put meta 9 9876543210987
  put meta 10 4096
  n = omega_gpu_fmt dst t_fmt_all meta sbuf
  if ne cstr_eq dst t_exp_fmt_all 1
    ret 40
  end
  if ne n long len t_exp_fmt_all
    ret 41
  end
  if ne dump 0
    out_ch 70
    out_ch 48
    out_ch 58
    out_cstr dst 256
    out_ch 10
  end

  put meta 0 6
  put meta 1 32
  put meta 16 len t_fmt_trunc_s
  n = omega_gpu_fmt dst t_fmt_trunc meta sbuf
  if or ne n 5 ne cstr_eq dst t_exp_fmt_trunc 1
    ret 42
  end
  if ne dump 0
    out_ch 70
    out_ch 49
    out_ch 58
    out_cstr dst 256
    out_ch 10
  end

  put meta 0 1
  put meta 1 123
  n = omega_gpu_fmt dst t_fmt_d meta sbuf
  if or ne n 0 ne get dst 0 0
    ret 43
  end

  put meta 0 256
  put meta 1 0
  put meta 16 ulong 0xffffffffffffffff
  n = omega_gpu_fmt dst t_fmt_null meta sbuf
  if ne cstr_eq dst t_exp_fmt_null 1
    ret 44
  end

  put meta 0 256
  n = omega_gpu_fmt dst t_fmt_bad meta sbuf
  if ne cstr_eq dst t_exp_fmt_bad 1
    ret 45
  end

  put meta 0 256
  put meta 1 0x80000000
  put meta 2 ulong 0x8000000000000000
  n = omega_gpu_fmt dst t_fmt_min meta sbuf
  if ne cstr_eq dst t_exp_fmt_min 1
    ret 46
  end
  if ne dump 0
    out_ch 70
    out_ch 50
    out_ch 58
    out_cstr dst 256
    out_ch 10
    out_flush
  end
  ret 0
end

fn main to int
  dump = ulong 1
  rc = test_disasm_cases dump
  if ne rc 0
    ret int rc
  end
  rc = test_listing dump
  if ne rc 0
    ret int rc
  end
  rc = test_gpu_fmt dump
  if ne rc 0
    ret int rc
  end
  ign = write 1 t_pass_msg 0 len t_pass_msg
  ret 0
end

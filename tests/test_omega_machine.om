note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/omega_machine.om.
om2

text spark_gold_id "b2ad77d3401cfc5d0ffedb0a71c51410416b588966ef22fa074f3b0338abb81b"
text qemu_gold_id "9b1f9d1aea3129fb328b5296054ac67ba06321f8a32c295690b0bcb953187653"
text desc_gold_id "04aaedc53e136dd4364d38ffc753d777b92ea22d82a35f2671e4d61e6986415f"
text test_cpu_nm "TEST_CPU_V1"
text msg_pass "OMEGA_MACHINE_OM_PASS\n"
text msg_fail "OMEGA_MACHINE_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn chk_mg_id gold view uchar * to void
  for i ulong 32
    b = uint get g_mg_id i
    hi = sh_hexd shr b 4
    lo = sh_hexd and b 15
    chk eq hi get gold mul i 2
    chk eq lo get gold add mul i 2 1
  end
end

fn test_machine to void
  note DGX Spark profile + topology + latency
  chk eq omega_machine_build_dgx_spark 0
  chk_mg_id spark_gold_id
  chk eq omega_machine_validate_topology 0

  code = new uchar 16 0
  st = new ulong 2 0
  put st 0 0
  put st 1 16
  chk eq a64put code st a64addreg 1 0 1 2 0
  chk eq a64put code st a64mulreg 1 0 0 2 0
  chk eq a64put code st a64ret 0
  note Spark: ALU=1 + MUL=3 + RET(ALU)=1 -> 5 cycles
  chk eq omega_machine_estimate_latency code 12 5

  note QEMU virt profile + topology + latency
  chk eq omega_machine_build_qemu_virt 0
  chk_mg_id qemu_gold_id
  chk eq omega_machine_validate_topology 0
  note QEMU: ALU=1 + MUL=4 + RET(ALU)=1 -> 6 cycles
  chk eq omega_machine_estimate_latency code 12 6

  note Ingest physics descriptor matching C oracle
  put g_pd_magic 0 MG_PD_MAGIC
  put g_pd_profile 0 MG_PROFILE_V8A
  for i ulong len test_cpu_nm bound 32
    put g_pd_name i get test_cpu_nm i
  end
  put g_pd_name_len 0 len test_cpu_nm
  put g_pd_issue_w 0 4
  put g_pd_gpr_cnt 0 31
  put g_pd_vec_cnt 0 32
  put g_pd_l1d 0 32768
  put g_pd_l2 0 524288
  put g_pd_l3 0 0
  put g_pd_dram_base 0 ulong 0x40000000
  put g_pd_dram_size 0 mul ulong 2 ulong 1073741824
  for i ulong 32
    put g_pd_seal i uchar 0xc3
  end
  chk eq omega_machine_ingest_physics_descriptor 0
  chk_mg_id desc_gold_id
  chk eq omega_machine_validate_topology 0

  note Refusal: bad magic
  put g_pd_magic 0 0x12345678
  chk eq omega_machine_ingest_physics_descriptor -1

  note Topology validation negative controls
  put g_mg_gpr_cnt 0 16
  chk eq omega_machine_validate_topology -1
  put g_mg_gpr_cnt 0 31
  put g_mg_c_line 0 48
  chk eq omega_machine_validate_topology -1
  put g_mg_c_line 0 64
  put g_mg_c_lvl 1 0
  chk eq omega_machine_validate_topology -1
end

fn main to int
  test_machine
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

note Replaces tests/ans/test_ans.c. Composed after src/ans/ans.om.

text t_hex "0123456789abcdef"
text t_gold_ref "3be9ab21e6c989c6793e5eb69aa9d87493d4dfd42ce4aad04a3e89d3c4d0a110"
text t_gold_state "20cfa169d802561f5c5a03c82edf8162711737aee68dbe5e17c3f436ff4caf04"
text t_gold_verd "e82707eb13485dbca4325a2214c60072444f6ed9c0ff0838bea0131208deec25"
text t_gold_promo "5541443d59abf153e5595d16f05e1d645aecbacc9f85c619af4ac6cd7e990530"
text t_gold_act "f9ac8b7cd8612affbf1a3f3917953bbb9fa40d5cec380892ef2a35750b7c4c49"
text t_gold_meas "db1f5305061835bd0b338aa387dd1564a285c756bfe420e4b17f8aa8fb55e00f"

text t_fail_pfx "FAIL check "
text t_g_ref "golden reference    "
text t_g_act "golden action       "
text t_g_meas "golden measurement  "
text t_g_st "golden state        "
text t_g_vd "golden verdict      "
text t_g_pr "golden promotion    "
text t_sum1 "test_ans: "
text t_sum2 " checks, "
text t_sum3 " failures: "
text t_pass "PASS\n"
text t_fail "FAIL\n"

global g_tc ulong 2
global g_out uchar 4096
global g_outlen ulong 1
global g_wsave uchar 1024
global g_wsave2 uchar 1024

fn to_c c uchar to void
  n = get g_outlen 0
  if lt n 4095
    put g_out n c
    put g_outlen 0 add n 1
  end
end

fn to_s s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n
    to_c get s i
    i = add i 1
  end
end

fn to_u64 v ulong to void
  tmp = new uchar 24 0
  if eq v 0
    to_c 48
    ret
  end
  k = ulong 0
  while gt v 0
    put tmp k uchar add 48 rem v 10
    v = div v 10
    k = add k 1
  end
  while gt k 0
    k = sub k 1
    to_c get tmp k
  end
end

fn to_flush fd int to void
  n = get g_outlen 0
  off = ulong 0
  while lt off n
    w = write fd g_out off sub n off
    if le w 0
      break
    end
    off = add off ulong w
  end
  put g_outlen 0 0
end

fn chk cond bool tag ulong to void
  put g_tc 0 add get g_tc 0 1
  if not cond
    put g_tc 1 add get g_tc 1 1
    to_flush 1
    to_s t_fail_pfx
    to_u64 tag
    to_c 10
    to_flush 2
  end
end

fn dg_fill did ulong b uchar to void
  o = mul did 32
  i = ulong 0
  while lt i 32
    put g_dg add o i b
    i = add i 1
  end
end

fn dg_hex_eq did ulong lit view uchar * to bool
  o = mul did 32
  i = ulong 0
  while lt i 32
    b = get g_dg add o i
    if ne get t_hex shr ulong b 4 get lit mul i 2
      ret false
    end
    if ne get t_hex and ulong b 15 get lit add mul i 2 1
      ret false
    end
    i = add i 1
  end
  ret true
end

fn gold_chk pfx view uchar * did ulong want view uchar * tag ulong to void
  to_s pfx
  o = mul did 32
  i = ulong 0
  while lt i 32
    b = get g_dg add o i
    to_c get t_hex shr ulong b 4
    to_c get t_hex and ulong b 15
    i = add i 1
  end
  to_c 10
  to_flush 1
  chk dg_hex_eq did want tag
end

fn mkref rid ulong to void
  put g_ref_ver rid 1
  put g_ref_froz rid 0
  lb = mul rid 10
  i = ulong 0
  while lt i 10
    put g_ref_lim add lb i 1.0
    i = add i 1
  end
  put g_ref_lim add lb ANS_ATOM_SELF_MODIFICATION_LIMITS 0.5
  qb = mul rid 5
  put g_ref_q qb 0.001
  put g_ref_q add qb 1 0.01
  put g_ref_q add qb 2 0.02
  put g_ref_q add qb 3 0.03
  put g_ref_q add qb 4 0.05
  rb = mul rid 3
  put g_ref_r rb 1.0
  put g_ref_r add rb 1 0.1
  put g_ref_r add rb 2 0.01
  put g_ref_tsig rb 0.25
  put g_ref_tsig add rb 1 0.5
  put g_ref_tsig add rb 2 1.0
  put g_ref_nis rid 13.28
  put g_ref_prom rid 0.6
end

fn copy_ref dst ulong src ulong to void
  put g_ref_ver dst get g_ref_ver src
  put g_ref_froz dst get g_ref_froz src
  put g_ref_nis dst get g_ref_nis src
  put g_ref_prom dst get g_ref_prom src
  i = ulong 0
  while lt i 10
    put g_ref_lim add mul dst 10 i get g_ref_lim add mul src 10 i
    i = add i 1
  end
  i = ulong 0
  while lt i 5
    put g_ref_q add mul dst 5 i get g_ref_q add mul src 5 i
    i = add i 1
  end
  i = ulong 0
  while lt i 3
    put g_ref_r add mul dst 3 i get g_ref_r add mul src 3 i
    put g_ref_tsig add mul dst 3 i get g_ref_tsig add mul src 3 i
    i = add i 1
  end
end

fn mkrig rid ulong rdid ulong sid ulong to void
  mkref rid
  chk eq ans_reference_freeze rid rdid ANS_OK 10
  dg_fill 14 17
  dg_fill 15 34
  chk eq ans_state_prior rid rdid 14 15 sid ANS_OK 11
end

fn mkact aid ulong k ulong idb uchar risk f64 to void
  put g_act_kind aid k
  put g_act_risk aid risk
  ib = mul aid 32
  i = ulong 0
  while lt i 32
    put g_act_id add ib i idb
    i = add i 1
  end
  tb = mul aid 10
  i = ulong 0
  while lt i 10
    put g_act_tch add tb i 0
    i = add i 1
  end
end

fn mkmeas mid ulong cls ulong sid ulong rdid ulong use_cur bool ev uchar to void
  put g_ms_cls mid cls
  zb = mul mid 4
  ub = mul sid 8
  if use_cur
    i = ulong 0
    while lt i 4
      put g_ms_z add zb i get g_b_x add ub i
      i = add i 1
    end
  end
  mb = mul mid 32
  ro = mul rdid 32
  i = ulong 0
  while lt i 32
    put g_ms_src add mb i 51
    put g_ms_ev add mb i ev
    if ne cls ANS_SENSOR_IMU
      put g_ms_ref add mb i get g_dg add ro i
    else
      put g_ms_ref add mb i 0
    end
    i = add i 1
  end
  put g_ms_tns mid 100
  put g_ms_seq mid ulong ev
end

fn do_step rid ulong rdid ulong sid ulong k ulong idb uchar risk f64 to void
  mkact 0 k idb risk
  chk eq ans_step rid rdid sid 0 sid ANS_OK 12
end

fn do_meas_cur rid ulong rdid ulong sid ulong cls ulong ev uchar to void
  mkmeas 0 cls sid rdid true ev
  chk eq ans_measure rid rdid sid 0 sid ANS_OK 13
end

fn do_promo rid ulong rdid ulong csid ulong rb ulong tb ulong tn ulong to ulong
  dg_fill 13 68
  ans_promo_set_req 13 rb tb tn
  chk eq ans_promotion_check rid rdid csid 0 ANS_OK 14
  chk eq ans_digest_promo 0 12 ANS_OK 15
  eqd = true
  i = ulong 0
  while lt i 32
    if ne get g_dg add 384 i get g_pr_dig i
      eqd = false
      break
    end
    i = add i 1
  end
  chk eqd 16
  ret get g_pr_res 0
end

fn test1_freeze to void
  mkref 0
  mkref 1
  dg_zero 0
  chk eq ans_reference_check 0 0 ANS_ERR_REFERENCE 100
  chk eq ans_reference_freeze 0 0 ANS_OK 101
  chk eq ans_reference_freeze 1 1 ANS_OK 102
  chk dg_eq 0 1 103
  chk eq get g_ref_froz 0 1 104
  chk eq ans_reference_check 0 0 ANS_OK 105
  note every field change gives a different digest
  mkref 2
  put g_ref_ver 2 2
  chk eq ans_digest_reference 2 2 ANS_OK 106
  chk not dg_eq 2 0 107
  i = ulong 0
  while lt i 10
    mkref 2
    put g_ref_lim add 20 i add get g_ref_lim add 20 i 0.125
    chk eq ans_digest_reference 2 2 ANS_OK 108
    chk not dg_eq 2 0 109
    i = add i 1
  end
  i = ulong 0
  while lt i 5
    mkref 2
    put g_ref_q add 10 i mul get g_ref_q add 10 i 1.5
    chk eq ans_digest_reference 2 2 ANS_OK 110
    chk not dg_eq 2 0 111
    i = add i 1
  end
  i = ulong 0
  while lt i 3
    mkref 2
    put g_ref_r add 6 i mul get g_ref_r add 6 i 0.9
    chk eq ans_digest_reference 2 2 ANS_OK 112
    chk not dg_eq 2 0 113
    mkref 2
    put g_ref_tsig add 6 i mul get g_ref_tsig add 6 i 1.01
    chk eq ans_digest_reference 2 2 ANS_OK 114
    chk not dg_eq 2 0 115
    i = add i 1
  end
  mkref 2
  put g_ref_nis 2 add get g_ref_nis 2 1.0
  chk eq ans_digest_reference 2 2 ANS_OK 116
  chk not dg_eq 2 0 117
  mkref 2
  put g_ref_prom 2 add get g_ref_prom 2 0.01
  chk eq ans_digest_reference 2 2 ANS_OK 118
  chk not dg_eq 2 0 119
  note invalid references cannot be frozen
  mkref 2
  put g_ref_r 6 0.05
  chk eq ans_reference_freeze 2 2 ANS_ERR_REFERENCE 120
  chk eq get g_ref_froz 2 0 121
  mkref 2
  put g_ref_lim 23 0.0
  chk eq ans_reference_freeze 2 2 ANS_ERR_REFERENCE 122
  mkref 2
  put g_ref_q 11 bitcast f64 or shl ulong 2047 52 1
  chk eq ans_reference_freeze 2 2 ANS_ERR_REFERENCE 123
  mkref 2
  put g_ref_tsig 7 get g_ref_tsig 6
  chk eq ans_reference_freeze 2 2 ANS_ERR_REFERENCE 124
  note unfrozen reference refused even with right digest
  mkrig 0 0 0
  mkref 2
  mkact 0 ANS_ACT_EFFECT 1 0.1
  dg_fill 3 1
  chk eq ans_step 2 0 0 0 1 ANS_ERR_REFERENCE 125
  chk eq ans_state_prior 2 0 3 3 1 ANS_ERR_REFERENCE 126
end

fn test2_hostile to void
  mkrig 0 0 0
  copy_ref 1 0
  put g_ref_lim add 10 ANS_ATOM_SELF_MODIFICATION_LIMITS 100.0
  chk eq get g_ref_froz 1 1 200
  mkact 0 ANS_ACT_EFFECT 1 0.1
  mkmeas 0 ANS_SENSOR_FIX 0 0 true 5
  dg_fill 3 1
  chk eq ans_state_prior 1 0 3 3 1 ANS_ERR_REFERENCE 201
  chk eq ans_step 1 0 0 0 1 ANS_ERR_REFERENCE 202
  chk eq ans_measure 1 0 0 0 1 ANS_ERR_REFERENCE 203
  chk eq ans_autonomy 1 0 0 0 ANS_ERR_REFERENCE 204
  ans_promo_set_req 3 0 3 3
  chk eq ans_promotion_check 1 0 0 0 ANS_ERR_REFERENCE 205
  copy_ref 2 0
  put g_ref_froz 2 0
  chk eq ans_step 2 0 0 0 1 ANS_ERR_REFERENCE 206
  dg_copy 4 0
  put g_dg 128 xor get g_dg 128 1
  chk eq ans_step 0 4 0 0 1 ANS_ERR_REFERENCE 207
  chk eq ans_autonomy 0 4 0 0 ANS_ERR_REFERENCE 208
  copy_ref 2 1
  put g_ref_froz 2 0
  chk eq ans_reference_freeze 2 5 ANS_OK 209
  chk not dg_eq 5 0 210
  chk eq ans_step 2 5 0 0 1 ANS_ERR_REFERENCE 211
end

fn test3_drift_grows to void
  mkrig 0 0 0
  chk eq ans_autonomy 0 0 0 0 ANS_OK 300
  prev = get g_vd_sig 0
  pt = get g_vd_tier 0
  chk eq pt ANS_TIER_FULL 301
  i = ulong 0
  while lt i 50
    do_step 0 0 0 ANS_ACT_EFFECT uchar add 64 i 0.1
    chk eq ans_autonomy 0 0 0 0 ANS_OK 302
    chk gt get g_vd_sig 0 prev 303
    chk ge get g_vd_tier 0 pt 304
    prev = get g_vd_sig 0
    pt = get g_vd_tier 0
    i = add i 1
  end
  chk eq get g_vd_tier 0 ANS_TIER_HALT_REQUEST_FIX 305
  chk eq get g_st_sfix 0 50 306
  chk eq get g_st_gen 0 50 307
  chk ge get g_vd_D 0 get g_vd_sig 0 308
end

fn test4_fix_restores to void
  mkrig 0 0 0
  i = ulong 0
  while lt i 50
    do_step 0 0 0 ANS_ACT_EFFECT uchar add 64 i 0.1
    i = add i 1
  end
  chk eq ans_autonomy 0 0 0 0 ANS_OK 400
  chk eq get g_vd_tier 0 ANS_TIER_HALT_REQUEST_FIX 401
  do_meas_cur 0 0 0 ANS_SENSOR_FIX 144
  chk eq ans_autonomy 0 0 0 0 ANS_OK 402
  chk lt get g_vd_sig 0 get g_ref_tsig 0 403
  chk eq get g_st_sfix 0 0 404
  chk eq get g_vd_tier 0 ANS_TIER_FULL 405
  chk eq get g_st_dis 0 0 406
end

fn test5_imu_cannot_restore to void
  mkrig 0 0 0
  grd = ulong 0
  while lt grd 100
    chk eq ans_autonomy 0 0 0 0 ANS_OK 500
    if eq get g_vd_tier 0 ANS_TIER_SIMULATE_ONLY
      break
    end
    grd = add grd 1
    do_step 0 0 0 ANS_ACT_EFFECT uchar add 64 grd 0.1
  end
  chk eq ans_autonomy 0 0 0 0 ANS_OK 501
  chk eq get g_vd_tier 0 ANS_TIER_SIMULATE_ONLY 502
  i = ulong 0
  while lt i 200
    do_step 0 0 0 ANS_ACT_EFFECT uchar add i 1 0.1
    do_meas_cur 0 0 0 ANS_SENSOR_IMU uchar add 128 and i 63
    chk eq ans_autonomy 0 0 0 0 ANS_OK 503
    chk ne get g_vd_tier 0 ANS_TIER_FULL 504
    i = add i 1
  end
  chk eq ans_autonomy 0 0 0 0 ANS_OK 505
  chk eq get g_vd_tier 0 ANS_TIER_SIMULATE_ONLY 506
  chk lt fabs sub get g_vd_sig 0 0.617 0.01 507
  chk gt get g_st_sfix 0 200 508
end

fn test6_disagreement to void
  mkrig 0 0 0
  chk eq ans_autonomy 0 0 0 0 ANS_OK 600
  chk eq get g_vd_tier 0 ANS_TIER_FULL 601
  put g_ms_z 0 3.0
  put g_ms_z 1 0.0
  put g_ms_z 2 0.0
  put g_ms_z 3 0.0
  mkmeas 0 ANS_SENSOR_REFERENCE 0 0 false 97
  chk eq ans_measure 0 0 0 0 0 ANS_OK 602
  chk gt get g_ei_nis 0 get g_ref_nis 0 603
  chk eq get g_st_lnis 0 get g_ei_nis 0 604
  chk eq get g_st_dis 0 1 605
  chk eq ans_autonomy 0 0 0 0 ANS_OK 606
  chk lt get g_vd_sig 0 get g_ref_tsig 0 607
  chk eq get g_vd_tier 0 ANS_TIER_HALT_REQUEST_FIX 608
  chk gt get g_vd_mn 0 0.2 609
  do_meas_cur 0 0 0 ANS_SENSOR_REFERENCE 98
  chk eq get g_st_dis 0 1 610
  do_meas_cur 0 0 0 ANS_SENSOR_FIX 99
  chk eq get g_st_dis 0 0 611
  mkrig 1 1 1
  do_meas_cur 1 1 1 ANS_SENSOR_REFERENCE 100
  chk eq get g_st_dis 1 0 612
end

fn test7_refusals to void
  mkrig 0 0 0
  mkmeas 0 ANS_SENSOR_FIX 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_ev i 0
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_EVIDENCE 700
  mkmeas 0 ANS_SENSOR_FIX 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_src i 0
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_EVIDENCE 701
  mkmeas 0 ANS_SENSOR_IMU 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_ref i get g_dg i
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_SENSOR 702
  mkmeas 0 ANS_SENSOR_FIX 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_ref i 119
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_SENSOR 703
  mkmeas 0 ANS_SENSOR_REFERENCE 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_ref i 0
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_SENSOR 704
  mkmeas 0 ANS_SENSOR_FIX 0 0 true 1
  put g_ms_z 2 bitcast f64 or shl ulong 2047 52 1
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_NONFINITE 705
  mkmeas 0 ANS_SENSOR_IMU 0 0 true 1
  put g_ms_z 0 bitcast f64 shl ulong 2047 52
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_NONFINITE 706
  mkmeas 0 ANS_SENSOR_IMU 0 0 true 1
  put g_ms_cls 0 9
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_SENSOR 707
  do_meas_cur 0 0 0 ANS_SENSOR_FIX 48
  mkmeas 0 ANS_SENSOR_IMU 0 0 true 1
  i = ulong 0
  while lt i 32
    put g_ms_ev i get g_st_evr i
    i = add i 1
  end
  chk eq ans_measure 0 0 0 0 1 ANS_ERR_EST 708
  chk ne get g_last_est 0 EST_OK 709
  mkact 0 ANS_ACT_EFFECT 1 0.1
  chk eq ans_step 0 0 0 0 1 ANS_OK 710
  mkact 0 ANS_ACT_EFFECT 1 bitcast f64 or shl ulong 2047 52 1
  chk eq ans_step 0 0 0 0 1 ANS_ERR_NONFINITE 711
  mkact 0 ANS_ACT_EFFECT 1 1.5
  chk eq ans_step 0 0 0 0 1 ANS_ERR_RANGE 712
  mkact 0 ANS_ACT_EFFECT 0 0.1
  chk eq ans_step 0 0 0 0 1 ANS_ERR_EVIDENCE 713
  mkact 0 7 1 0.1
  chk eq ans_step 0 0 0 0 1 ANS_ERR_RANGE 714
  mkact 0 ANS_ACT_EFFECT 1 0.1
  put g_act_tch 3 2
  chk eq ans_step 0 0 0 0 1 ANS_ERR_RANGE 715
  mkact 0 ANS_ACT_SELF_MODIFY 2 0.9
  put g_act_tch ANS_ATOM_SELF_MODIFICATION_LIMITS 1
  chk eq ans_step 0 0 0 0 1 ANS_ERR_ATOM 716
  chk eq get g_st_gen 1 add get g_st_gen 0 1 717
  pdiff = false
  i = ulong 0
  while lt i 32
    if ne get g_st_prov add 32 i get g_st_prov i
      pdiff = true
      break
    end
    i = add i 1
  end
  chk pdiff 718
  peq = true
  i = ulong 0
  while lt i 16
    if ne get g_b_P add 64 i get g_b_P i
      peq = false
      break
    end
    i = add i 1
  end
  chk peq 719
  chk eq get g_st_sfix 1 get g_st_sfix 0 720
  chk eq get g_st_smst 1 0 721
  dg_zero 3
  chk eq ans_state_prior 0 0 3 0 1 ANS_ERR_RANGE 722
end

fn test8_promotion to void
  mkrig 0 0 0
  dg_fill 5 85
  dg_fill 6 86
  dg_fill 7 153
  ans_copy_state 1 0
  do_meas_cur 0 0 1 ANS_SENSOR_FIX 113
  chk eq do_promo 0 0 1 0 5 5 ANS_PROMOTE_OK 800
  chk eq do_promo 0 0 1 7 5 5 ANS_PROMOTE_REFUSED_REFERENCE 801
  chk eq do_promo 0 0 1 0 5 6 ANS_PROMOTE_REFUSED_TESTS 802
  ans_copy_state 2 0
  put g_ms_z 0 3.0
  put g_ms_z 1 0.0
  put g_ms_z 2 0.0
  put g_ms_z 3 0.0
  mkmeas 0 ANS_SENSOR_REFERENCE 2 0 false 114
  chk eq ans_measure 0 0 2 0 2 ANS_OK 803
  chk eq get g_st_dis 2 1 804
  chk eq do_promo 0 0 2 0 5 5 ANS_PROMOTE_REFUSED_DISAGREEMENT 805
  ans_copy_state 3 0
  i = ulong 0
  while lt i 12
    do_step 0 0 3 ANS_ACT_EFFECT uchar add 80 i 0.1
    i = add i 1
  end
  chk and eq get g_st_dis 3 0 eq get g_st_smuf 3 0 806
  chk eq do_promo 0 0 3 0 5 5 ANS_PROMOTE_REFUSED_DRIFT 807
  ans_copy_state 4 0
  mkact 0 ANS_ACT_SELF_MODIFY 88 0.2
  put g_act_tch ANS_ATOM_SELF_MODIFICATION_LIMITS 1
  chk eq ans_step 0 0 4 0 4 ANS_OK 808
  chk eq do_promo 0 0 4 0 5 5 ANS_PROMOTE_REFUSED_SELF_MOD 809
  chk eq do_promo 0 0 4 7 5 6 ANS_PROMOTE_REFUSED_REFERENCE 810
end

fn rt_save_wire n ulong to void
  i = ulong 0
  while lt i n
    put g_wsave i get g_wire i
    i = add i 1
  end
end

fn rt_load_wire n ulong to void
  i = ulong 0
  while lt i n
    put g_wire i get g_wsave i
    i = add i 1
  end
end

fn rt_eq_wire n ulong to bool
  i = ulong 0
  while lt i n
    if ne get g_wire i get g_wsave i
      ret false
    end
    i = add i 1
  end
  ret true
end

fn rt_check_kind kind ulong tag ulong to void
  l1 = get g_cd 1
  rt_save_wire l1
  if eq kind 1
    chk eq ans_decode_reference 3 l1 ANS_OK tag
    chk eq ans_encode_reference 3 ANS_ENCODED_MAX false ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_reference 3 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_reference 0 sub l1 1 false ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_reference 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_reference 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_reference 3 add l1 1 ANS_ERR_ENCODING tag
  end
  if eq kind 2
    chk eq ans_decode_action 3 l1 ANS_OK tag
    chk eq ans_encode_action 3 ANS_ENCODED_MAX ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_action 3 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_action 1 sub l1 1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_action 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_action 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_action 3 add l1 1 ANS_ERR_ENCODING tag
  end
  if eq kind 3
    chk eq ans_decode_measurement 3 l1 ANS_OK tag
    chk eq ans_encode_measurement 3 ANS_ENCODED_MAX ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_measurement 3 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_measurement 1 sub l1 1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_measurement 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_measurement 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_measurement 3 add l1 1 ANS_ERR_ENCODING tag
  end
  if eq kind 4
    chk eq ans_decode_state 5 l1 ANS_OK tag
    chk eq ans_encode_state 5 ANS_ENCODED_MAX ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_state 5 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_state 0 sub l1 1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_state 5 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_state 5 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_state 5 add l1 1 ANS_ERR_ENCODING tag
  end
  if eq kind 5
    chk eq ans_decode_verdict 3 l1 ANS_OK tag
    chk eq ans_encode_verdict 3 ANS_ENCODED_MAX false ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_verdict 3 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_verdict 0 sub l1 1 false ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_verdict 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_verdict 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_verdict 3 add l1 1 ANS_ERR_ENCODING tag
  end
  if eq kind 6
    chk eq ans_decode_promo 3 l1 ANS_OK tag
    chk eq ans_encode_promo 3 ANS_ENCODED_MAX false ANS_OK tag
    chk and eq get g_cd 1 l1 rt_eq_wire l1 tag
    rt_load_wire l1
    chk eq ans_decode_promo 3 sub l1 1 ANS_ERR_ENCODING tag
    chk eq ans_encode_promo 0 sub l1 1 false ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 4 xor get g_wire 4 127
    chk eq ans_decode_promo 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire 5 9
    chk eq ans_decode_promo 3 l1 ANS_ERR_ENCODING tag
    rt_load_wire l1
    put g_wire l1 0
    chk eq ans_decode_promo 3 add l1 1 ANS_ERR_ENCODING tag
  end
end

fn test9_encodings to void
  mkrig 0 0 0
  mkact 1 ANS_ACT_DELEGATE 33 0.25
  put g_act_tch add 10 ANS_ATOM_DELEGATION_LIMITS 1
  do_step 0 0 0 ANS_ACT_EFFECT 32 0.1
  chk eq ans_step 0 0 0 1 0 ANS_OK 900
  put g_ms_z 4 0.05
  put g_ms_z 5 neg 0.02
  put g_ms_z 6 0.0
  put g_ms_z 7 0.01
  mkmeas 1 ANS_SENSOR_REFERENCE 0 0 false 35
  chk eq ans_measure 0 0 0 1 0 ANS_OK 901
  chk eq ans_autonomy 0 0 0 0 ANS_OK 902
  dg_fill 5 85
  dg_fill 6 68
  ans_promo_set_req 6 0 5 5
  chk eq ans_promotion_check 0 0 0 0 ANS_OK 903

  chk eq ans_encode_reference 0 ANS_ENCODED_MAX false ANS_OK 904
  rt_check_kind 1 905
  chk eq ans_encode_action 1 ANS_ENCODED_MAX ANS_OK 906
  rt_check_kind 2 907
  chk eq ans_encode_measurement 1 ANS_ENCODED_MAX ANS_OK 908
  rt_check_kind 3 909
  chk eq ans_encode_state 0 ANS_ENCODED_MAX ANS_OK 910
  rt_check_kind 4 911
  chk eq ans_encode_verdict 0 ANS_ENCODED_MAX false ANS_OK 912
  rt_check_kind 5 913
  chk eq ans_encode_promo 0 ANS_ENCODED_MAX false ANS_OK 914
  rt_check_kind 6 915

  note cross-kind decode refused
  chk eq ans_encode_state 0 ANS_ENCODED_MAX ANS_OK 916
  chk eq ans_decode_action 3 get g_cd 1 ANS_ERR_ENCODING 917
  note decoded reference keeps digest and seal
  chk eq ans_encode_reference 0 ANS_ENCODED_MAX false ANS_OK 918
  chk eq ans_decode_reference 3 get g_cd 1 ANS_OK 919
  chk eq ans_digest_reference 3 7 ANS_OK 920
  chk dg_eq 7 0 921
  chk eq get g_ref_froz 3 1 922
  chk eq ans_reference_check 3 0 ANS_OK 923
  note digest stability & domain separation
  chk eq ans_digest_state 0 8 ANS_OK 924
  chk eq ans_digest_state 0 9 ANS_OK 925
  chk dg_eq 8 9 926
  ans_copy_state 6 0
  put g_st_lnis 6 add get g_st_lnis 6 1e-9
  chk eq ans_digest_state 6 9 ANS_OK 927
  chk not dg_eq 8 9 928
  chk not dg_eq 0 8 929
  note determinism
  mkrig 1 1 1
  do_step 1 1 1 ANS_ACT_EFFECT 32 0.1
  chk eq ans_step 1 1 1 1 1 ANS_OK 930
  chk eq ans_measure 1 1 1 1 1 ANS_OK 931
  chk eq ans_digest_state 1 9 ANS_OK 932
  chk dg_eq 8 9 933
  note 6 frozen SHA-256 goldens
  gold_chk t_g_ref 0 t_gold_ref 940
  chk eq ans_digest_action 1 10 ANS_OK 941
  gold_chk t_g_act 10 t_gold_act 942
  chk eq ans_digest_measurement 1 10 ANS_OK 943
  gold_chk t_g_meas 10 t_gold_meas 944
  gold_chk t_g_st 8 t_gold_state 945
  i = ulong 0
  while lt i 32
    put g_dg add 320 i get g_vd_dig i
    i = add i 1
  end
  gold_chk t_g_vd 10 t_gold_verd 946
  i = ulong 0
  while lt i 32
    put g_dg add 320 i get g_pr_dig i
    i = add i 1
  end
  gold_chk t_g_pr 10 t_gold_promo 947
end

fn test10_self_mod to void
  mkrig 0 0 0
  dg_fill 5 85
  mkact 0 ANS_ACT_SELF_MODIFY 88 0.2
  chk eq ans_step 0 0 0 0 0 ANS_OK 1000
  chk and eq get g_st_smst 0 1 eq get g_st_smuf 0 1 1001
  chk eq ans_autonomy 0 0 0 0 ANS_OK 1002
  chk le get g_vd_D 0 get g_ref_prom 0 1003
  chk eq do_promo 0 0 0 0 5 5 ANS_PROMOTE_REFUSED_SELF_MOD 1004
  do_meas_cur 0 0 0 ANS_SENSOR_FIX 115
  chk and eq get g_st_smst 0 1 eq get g_st_smuf 0 0 1005
  chk eq do_promo 0 0 0 0 5 5 ANS_PROMOTE_OK 1006
end

fn main to int
  test1_freeze
  test2_hostile
  test3_drift_grows
  test4_fix_restores
  test5_imu_cannot_restore
  test6_disagreement
  test7_refusals
  test8_promotion
  test9_encodings
  test10_self_mod
  to_s t_sum1
  to_u64 get g_tc 0
  to_s t_sum2
  to_u64 get g_tc 1
  to_s t_sum3
  if ne get g_tc 1 0
    to_s t_fail
    to_flush 1
    ret 1
  end
  to_s t_pass
  to_flush 1
  ret 0
end

note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit test for src/aegis_verification.om.
om2

text msg_pass "AEGIS_VERIFICATION_OM_PASS\n"
text msg_fail "AEGIS_VERIFICATION_OM_FAIL\n"

global g_fail ulong 1
global g_chk ulong 1

fn chk cond bool to void
  put g_chk 0 add get g_chk 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
  end
end

fn setup_valid to void
  for i ulong 32
    put g_aegis_req_prog_dig i uchar add i 1
    put g_aegis_req_desc_dig i uchar add i 33
    put g_aegis_res_prog_dig i uchar add i 1
    put g_aegis_res_code_dig i uchar add i 65
    put g_aegis_desc_dig i uchar add i 33
  end
  put g_aegis_req_opcodes 0 16
  put g_aegis_req_ir_size 0 256
  put g_aegis_req_mach_arch 0 1
  put g_aegis_req_mach_sm 0 121
  put g_aegis_res_status 0 0
  put g_aegis_res_code_size 0 512
  put g_aegis_desc_arch 0 1
  put g_aegis_desc_sm 0 121
end

fn test_aegis_verify to void
  setup_valid

  note Valid realization grants verified token
  chk eq omega_aegis_verify 1 AEGIS_OK
  chk eq get g_aegis_ver_valid 0 1
  chk eq get g_aegis_freq_opcodes 0 16
  chk eq get g_aegis_freq_ir_size 0 256
  chk eq get g_aegis_freq_mach_sm 0 121

  note Deterministic non-zero token check
  tok1 = new uchar 32 0
  nz = ulong 0
  for i ulong 32
    v = get g_aegis_ver_token i
    put tok1 i v
    if ne v 0
      nz = 1
    end
  end
  chk eq nz 1

  chk eq omega_aegis_verify 1 AEGIS_OK
  same = ulong 1
  for i ulong 32
    if ne get tok1 i get g_aegis_ver_token i
      same = 0
    end
  end
  chk eq same 1

  note Null pointer refusal
  chk eq omega_aegis_verify 0 AEGIS_ERR_NULL
  chk eq get g_aegis_ver_valid 0 0

  note Zero opcodes / IR size refusal
  put g_aegis_req_opcodes 0 0
  chk eq omega_aegis_verify 1 AEGIS_ERR_IR
  put g_aegis_req_opcodes 0 16
  put g_aegis_req_ir_size 0 0
  chk eq omega_aegis_verify 1 AEGIS_ERR_IR
  put g_aegis_req_ir_size 0 256

  note Zero program digest refusal
  for i ulong 32
    put g_aegis_req_prog_dig i 0
  end
  chk eq omega_aegis_verify 1 AEGIS_ERR_DIGEST
  setup_valid

  note Descriptor arch / SM / digest mismatch refusal
  put g_aegis_desc_arch 0 2
  chk eq omega_aegis_verify 1 AEGIS_ERR_DESC
  put g_aegis_desc_arch 0 1
  put g_aegis_desc_sm 0 120
  chk eq omega_aegis_verify 1 AEGIS_ERR_DESC
  put g_aegis_desc_sm 0 121
  put g_aegis_desc_dig 0 xor get g_aegis_desc_dig 0 uchar 1
  chk eq omega_aegis_verify 1 AEGIS_ERR_DESC
  setup_valid

  note Program digest mismatch / failed status / zero code digest refusal
  put g_aegis_res_prog_dig 0 xor get g_aegis_res_prog_dig 0 uchar 1
  chk eq omega_aegis_verify 1 AEGIS_ERR_DIGEST
  setup_valid
  put g_aegis_res_status 0 -1
  chk eq omega_aegis_verify 1 AEGIS_ERR_CODE
  put g_aegis_res_status 0 0
  for i ulong 32
    put g_aegis_res_code_dig i 0
  end
  chk eq omega_aegis_verify 1 AEGIS_ERR_CODE
  chk eq get g_aegis_ver_valid 0 0
end

fn main to int
  test_aegis_verify
  if eq get g_fail 0 0
    ign = write 1 msg_pass 0 len msg_pass
    ret 0
  end
  ign = write 1 msg_fail 0 len msg_fail
  ret 1
end

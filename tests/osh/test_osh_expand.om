om2
note test_osh_expand.om -- pure OM-2 test driver for src/osh/osh_expand.om + osh_req_decode.
note Linked with: osh_layout.om osh_lex.om osh_parse.om osh_expand.om osh_codes.om osh_req.om.
note Usage: test_osh_expand [VECTORS_DIR]

global tx_checks ulong 1
global tx_fails ulong 1
global tx_obuf uchar 512
global tx_olen ulong 1

text tx_s_pass "OSH_EXPAND_PASS\n"
text tx_s_fail "OSH_EXPAND_FAIL\n"
text tx_s_chk "checks="
text tx_s_fl " fails="
text tx_s_vec " vectors="
text tx_s_vdir "tests/osh/vectors"
text tx_s_bad "FAIL: "
text tx_s_c1 "echo hi | cat\n"
text tx_s_c2 "X=hello printf '%s' \"$X\"\n"
text tx_s_c3 "cd /tmp && pwd\n"
text tx_s_c4 "echo $FOO $?\n"
text tx_s_c5 "echo \"hello world\" 'a b'\n"
text tx_s_val "BAR"

fn tx_reset to void
  put tx_olen 0 0
end

fn tx_ch c uchar to void
  n = get tx_olen 0
  if lt n 510
    put tx_obuf n c
    put tx_olen 0 add n 1
  end
end

fn tx_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    tx_ch get s i
    i = add i 1
  end
end

fn tx_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tx_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn tx_flush fd int to void
  n = get tx_olen 0
  if gt n 0
    ign = write fd tx_obuf 0 n
  end
  put tx_olen 0 0
end

fn tx_check ok ulong id ulong to void
  put tx_checks 0 add get tx_checks 0 1
  if eq ok 0
    put tx_fails 0 add get tx_fails 0 1
    tx_reset
    tx_txt tx_s_bad
    tx_u64 id
    tx_ch 10
    tx_flush 2
  end
end

fn tx_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tx_check ok id
end

fn tx_zero_ws w edit ulong 11456 to void
  i = ulong 0
  while lt i OSH_WS_CELLS bound 11456
    put w i 0
    i = add i 1
  end
end

fn tx_decode_ws w view ulong 11456 to ulong
  rec = new ulong 1400 0
  nc = get w add OSH_REQUEST 1
  nrec = add OSH_REQ_HDR_CELLS mul nc OSH_CMD_CELLS
  used = get w add OSH_REQUEST 4
  if gt nrec 1400
    ret 218
  end
  i = ulong 0
  while lt i nrec bound 1400
    put rec i get w add OSH_REQUEST i
    i = add i 1
  end
  ret osh_req_decode part rec 0 nrec nrec part w OSH_OUT used used
end

fn tx_run_script buf view uchar * blen ulong w edit ulong 11456 reqs_out edit ulong 1 to ulong
  tx_zero_ws w
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  put w OSH_S_EOI 1
  put w OSH_S_LAST_STATUS 0
  put reqs_out 0 0
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_lex_run buf blen w OSH_WS_CELLS
    if ne st 101
      if ne st 0
        ret st
      end
      break
    end
    g = add g 1
  end
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_parse_run buf blen w OSH_WS_CELLS
    if ne st 101
      if ne st 0
        ret st
      end
      break
    end
    g = add g 1
  end
  g = ulong 0
  while lt g 4000 bound 4000
    st = osh_expand_run buf blen w OSH_WS_CELLS
    if eq st 101
      g = add g 1
      continue
    end
    if eq st 102
      put w OSH_STAGING 1
      put w add OSH_STAGING 1 3
      put w add OSH_STAGING 2 0
      put w add OSH_STAGING 3 0
      put w add OSH_STAGING 4 66
      put w add OSH_STAGING 5 65
      put w add OSH_STAGING 6 82
      g = add g 1
      continue
    end
    if eq st 103
      dr = tx_decode_ws w
      tx_check_eq dr 0 700
      put reqs_out 0 add get reqs_out 0 1
      g = add g 1
      continue
    end
    ret st
  end
  ret 255
end

fn tx_read_vec dir view uchar * dl ulong idx ulong dst edit uchar 4096 to long
  p = new uchar 512 0
  i = ulong 0
  while lt i dl bound 256
    put p i get dir i
    i = add i 1
  end
  put p dl 47
  put p add dl 1 118
  put p add dl 2 uchar add 48 div idx 100
  put p add dl 3 uchar add 48 rem div idx 10 10
  put p add dl 4 uchar add 48 rem idx 10
  put p add dl 5 46
  put p add dl 6 105
  put p add dl 7 110
  fd = fopen p 0 add dl 8 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 4096 bound 4096
    r = read int fd dst tot sub 4096 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  ign = fclose int fd
  ret long tot
end

fn tx_test_cases to void
  w = new ulong 11456 0
  rc = new ulong 1 0
  tx_check_eq tx_run_script tx_s_c1 len tx_s_c1 w rc 104 1
  tx_check_eq get rc 0 1 2
  tx_check_eq get rq_ncmds 0 2 3
  tx_check_eq tx_run_script tx_s_c2 len tx_s_c2 w rc 104 4
  tx_check_eq get rq_cmd_bi 0 OSH_B_PRINTF 5
  tx_check_eq get rq_cmd_ns 0 1 6
  tx_check_eq tx_run_script tx_s_c3 len tx_s_c3 w rc 104 7
  tx_check_eq get rc 0 2 8
  tx_check_eq get rq_cmd_bi 0 OSH_B_PWD 9
  tx_check_eq tx_run_script tx_s_c4 len tx_s_c4 w rc 104 10
  tx_check_eq get rq_cmd_na 0 3 11
  tx_check_eq tx_run_script tx_s_c5 len tx_s_c5 w rc 104 12
  tx_check_eq get rq_cmd_na 0 3 13
end

fn main to int
  put tx_checks 0 0
  put tx_fails 0 0
  vdir = new uchar 256 0
  vdl = ulong 0
  ac = argcnt
  if gt ac 1
    r = argread 1 vdir 0 256
    if gt r 0
      vdl = ulong r
    end
  end
  if eq vdl 0
    vdl = len tx_s_vdir
    i = ulong 0
    while lt i vdl bound 256
      put vdir i get tx_s_vdir i
      i = add i 1
    end
  end
  tx_test_cases
  w = new ulong 11456 0
  rc = new ulong 1 0
  vbuf = new uchar 4096 0
  vn = ulong 0
  idx = ulong 1
  while le idx 20 bound 20
    rl = tx_read_vec vdir vdl idx vbuf
    if ge rl 0
      st = tx_run_script vbuf ulong rl w rc
      note Every vector must either finish (104) or cleanly refuse (>=200)
      ok = ulong 0
      if eq st 104
        ok = 1
      end
      if and ge st 200 le st 254
        ok = 1
      end
      tx_check ok add 100 idx
      vn = add vn 1
    end
    idx = add idx 1
  end
  tx_check_eq vn 20 99
  tx_reset
  tx_txt tx_s_chk
  tx_u64 get tx_checks 0
  tx_txt tx_s_fl
  tx_u64 get tx_fails 0
  tx_txt tx_s_vec
  tx_u64 vn
  tx_ch 10
  tx_flush 1
  if eq get tx_fails 0 0
    tx_reset
    tx_txt tx_s_pass
    tx_flush 1
    ret 0
  end
  tx_reset
  tx_txt tx_s_fail
  tx_flush 1
  ret 1
end

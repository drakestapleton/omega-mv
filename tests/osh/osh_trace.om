note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 port of tests/osh/osh_trace.c (core-only step trace).
note Build with: om/sha256/sha256-om2.om src/osh/osh_layout.om src/osh/osh_lex.om src/osh/osh_parse.om src/osh/osh_expand.om tests/osh/osh_trace.om
om2

const TR_INPUT_MAX ulong 4096
const TR_MAX_FAKE ulong 256
const TR_MAX_POS ulong 9

global tr_src uchar 65536
global tr_src_len ulong 1
global tr_src_pos ulong 1
global tr_step_no ulong 1
global tr_req_no ulong 1
global tr_last_status ulong 1
global tr_have_status ulong 1
global tr_fake ulong 256
global tr_nfake ulong 1
global tr_fake_i ulong 1
global tr_pos_buf uchar 16384
global tr_pos_off ulong 16
global tr_pos_len ulong 16
global tr_npos ulong 1
global tr_out uchar 65536
global tr_out_n ulong 1
global tr_path uchar 4096
global tr_side uchar 4096
global tr_sbuf uchar 16384

text tr_hex "0123456789abcdef"
text tr_s_step "step "
text tr_s_unit " unit="
text tr_s_lex "lex"
text tr_s_parse "parse"
text tr_s_expand "expand"
text tr_s_inlen " in_len="
text tr_s_ret " ret="
text tr_s_wsha " ws_sha256="
text tr_s_req "request "
text tr_s_sha " sha256="
text tr_s_ev_exit "event exit="
text tr_s_ev_win "event input_window_exceeded have="
text tr_s_add " add="
text tr_s_max " max=4096\n"
text tr_s_ev_fake "event fake_status_exhausted after="
text tr_s_ev_nc "event request_ncmds_out_of_range ncmds="
text tr_s_ev_int "event internal_error status="
text tr_s_home "HOME"
text tr_s_home_v "/home/t"
text tr_s_x "X"
text tr_s_x_v "a b"
text tr_s_empty "EMPTY"
text tr_s_arg0 "osh_trace"
text tr_s_ext_st ".status"
text tr_s_ext_ar ".args"
text tr_s_usage "usage: osh_trace script.sh\n"

fn tr_flush to void
  n = get tr_out_n 0
  o = ulong 0
  while lt o n bound 65536
    r = write 1 tr_out o sub n o
    if le r 0
      break
    end
    o = add o ulong r
  end
  put tr_out_n 0 0
end

fn tr_putc b uchar to void
  n = get tr_out_n 0
  if ge n 65000
    tr_flush
    n = ulong 0
  end
  put tr_out n b
  put tr_out_n 0 add n 1
end

fn tr_puts s view uchar * to void
  n = len s
  i = ulong 0
  while lt i n bound 4096
    tr_putc get s i
    i = add i 1
  end
end

fn tr_putu v ulong to void
  dig = new uchar 24 0
  x = v
  n = ulong 0
  while ge x 10 bound 24
    put dig n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  put dig n uchar add 48 x
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tr_putc get dig sub sub n i 1
    i = add i 1
  end
end

fn tr_puthex d view uchar 32 to void
  i = ulong 0
  while lt i 32 bound 32
    b = ulong get d i
    tr_putc get tr_hex shr b 4
    tr_putc get tr_hex and b 15
    i = add i 1
  end
end

fn tr_pack_cells w view ulong * start ulong count ulong dst edit uchar * to void
  i = ulong 0
  while lt i count bound 12000
    v = get w add start i
    o = mul i 8
    put dst o uchar and v 255
    put dst add o 1 uchar and shr v 8 255
    put dst add o 2 uchar and shr v 16 255
    put dst add o 3 uchar and shr v 24 255
    put dst add o 4 uchar and shr v 32 255
    put dst add o 5 uchar and shr v 40 255
    put dst add o 6 uchar and shr v 48 255
    put dst add o 7 uchar and shr v 56 255
    i = add i 1
  end
end

fn tr_hash_cells w view ulong * start ulong count ulong dig edit uchar 32 to void
  raw = new uchar 91648 0
  out_d = new uchar 32 0
  tr_pack_cells w start count raw
  sha256_hash part raw 0 mul count 8 out_d
  i = ulong 0
  while lt i 32 bound 32
    put dig i get out_d i
    i = add i 1
  end
end

fn tr_call unit ulong buf view uchar * blen ulong w edit ulong * to ulong
  r = ulong 0
  if eq unit 0
    r = osh_lex_run buf blen w OSH_WS_CELLS
  else
    if eq unit 1
      r = osh_parse_run buf blen w OSH_WS_CELLS
    else
      r = osh_expand_run buf blen w OSH_WS_CELLS
    end
  end
  dig = new uchar 32 0
  tr_hash_cells w 0 OSH_WS_CELLS dig
  sn = add get tr_step_no 0 1
  put tr_step_no 0 sn
  tr_puts tr_s_step
  tr_putu sn
  tr_puts tr_s_unit
  if eq unit 0
    tr_puts tr_s_lex
  else
    if eq unit 1
      tr_puts tr_s_parse
    else
      tr_puts tr_s_expand
    end
  end
  tr_puts tr_s_inlen
  tr_putu blen
  tr_puts tr_s_ret
  tr_putu r
  tr_puts tr_s_wsha
  tr_puthex dig
  tr_putc 10
  ret r
end

fn tr_reset_list w edit ulong * to void
  i = ulong 0
  while lt i OSH_WS_CELLS bound 12000
    put w i 0
    i = add i 1
  end
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
end

fn tr_run_entry unit ulong buf view uchar * blen ulong w edit ulong * to ulong
  i = ulong 0
  while lt i 100000 bound 100000
    st = tr_call unit buf blen w
    if ne st 101
      ret st
    end
    i = add i 1
  end
  ret ulong 0xffffffffffffffff
end

fn tr_lex_parse buf view uchar * blen ulong w edit ulong * to ulong
  st = tr_run_entry 0 buf blen w
  if ne st 0
    ret st
  end
  ret tr_run_entry 1 buf blen w
end

fn tr_dec v ulong dst edit uchar 24 to ulong
  t = new uchar 24 0
  x = v
  n = ulong 0
  while ge x 10 bound 24
    put t n uchar add 48 rem x 10
    x = div x 10
    n = add n 1
  end
  put t n uchar add 48 x
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    put dst i get t sub sub n i 1
    i = add i 1
  end
  ret n
end

fn tr_eq_text buf view uchar * a ulong ln ulong t view uchar * to ulong
  if ne ln len t
    ret 0
  end
  i = ulong 0
  while lt i ln bound 64
    if ne get buf add a i get t i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn tr_answer_dec v ulong val edit uchar 1024 to ulong
  num = new uchar 24 0
  vl = tr_dec v num
  i = ulong 0
  while lt i vl bound 24
    put val i get num i
    i = add i 1
  end
  ret vl
end

fn tr_copy_pos idx ulong val edit uchar 1024 to ulong
  poff = get tr_pos_off idx
  vl = get tr_pos_len idx
  i = ulong 0
  while and lt i vl lt i 1024 bound 1024
    put val i get tr_pos_buf add poff i
    i = add i 1
  end
  ret vl
end

fn tr_stage_out w edit ulong * found ulong vl ulong val view uchar 1024 to void
  put w OSH_STAGING found
  put w add OSH_STAGING 1 vl
  put w add OSH_STAGING 2 get tr_npos 0
  put w add OSH_STAGING 3 0
  i = ulong 0
  while and lt i vl lt i 1024 bound 1024
    put w add add OSH_STAGING 4 i ulong get val i
    i = add i 1
  end
end

fn tr_answer buf view uchar * blen ulong w edit ulong * to void
  kind = get w OSH_S_VR_KIND
  a = get w OSH_S_VR_A
  ln = get w OSH_S_VR_LEN
  found = ulong 0
  vl = ulong 0
  val = new uchar 1024 0
  if eq kind 1
    if and le a blen le ln sub blen a
      if eq tr_eq_text buf a ln tr_s_home 1
        found = 1
        vl = len tr_s_home_v
        i = ulong 0
        while lt i vl bound 32
          put val i get tr_s_home_v i
          i = add i 1
        end
      end
      if eq tr_eq_text buf a ln tr_s_x 1
        found = 1
        vl = len tr_s_x_v
        i = ulong 0
        while lt i vl bound 32
          put val i get tr_s_x_v i
          i = add i 1
        end
      end
      if eq tr_eq_text buf a ln tr_s_empty 1
        found = 1
        vl = 0
      end
    end
  end
  if eq kind 2
    found = 1
    vl = tr_answer_dec get tr_last_status 0 val
  end
  if eq kind 3
    if eq a 0
      found = 1
      vl = len tr_s_arg0
      i = ulong 0
      while lt i vl bound 32
        put val i get tr_s_arg0 i
        i = add i 1
      end
    else
      if and ge a 1 le a get tr_npos 0
        found = 1
        vl = tr_copy_pos sub a 1 val
      end
    end
  end
  if eq kind 4
    found = 1
    vl = tr_answer_dec get tr_npos 0 val
  end
  tr_stage_out w found vl val
end

fn tr_next_fake to ulong
  fi = get tr_fake_i 0
  nf = get tr_nfake 0
  if lt fi nf
    put tr_fake_i 0 add fi 1
    ret get tr_fake fi
  end
  if ne get tr_have_status 0 0
    tr_puts tr_s_ev_fake
    tr_putu nf
    tr_putc 10
    tr_flush
    exit 2
  end
  ret 0
end

fn tr_run_list buf view uchar * blen ulong w edit ulong * to ulong
  dig = new uchar 32 0
  put w OSH_S_LAST_STATUS get tr_last_status 0
  g = ulong 0
  while lt g 1000000 bound 1000000
    st = tr_call 2 buf blen w
    if eq st 101
      g = add g 1
      continue
    end
    if eq st 102
      tr_answer buf blen w
      g = add g 1
      continue
    end
    if eq st 103
      nc = get w add OSH_REQUEST 1
      if gt nc 8
        tr_puts tr_s_ev_nc
        tr_putu nc
        tr_putc 10
        put tr_last_status 0 2
        ret 1
      end
      cells = add 8 mul nc 164
      tr_hash_cells w OSH_REQUEST cells dig
      rn = add get tr_req_no 0 1
      put tr_req_no 0 rn
      tr_puts tr_s_req
      tr_putu rn
      tr_puts tr_s_sha
      tr_puthex dig
      tr_putc 10
      ls = tr_next_fake
      put tr_last_status 0 ls
      put w OSH_S_LAST_STATUS ls
      g = add g 1
      continue
    end
    if eq st 104
      ret 0
    end
    if or eq st ulong 0xffffffffffffffff lt st 200
      tr_puts tr_s_ev_int
      tr_putu st
      tr_putc 10
      put tr_last_status 0 70
      ret 1
    end
    put tr_last_status 0 2
    ret 1
  end
  ret 1
end

fn tr_read_line buf edit uchar * blen_box edit ulong 1 to long
  sp = get tr_src_pos 0
  sl = get tr_src_len 0
  if ge sp sl
    ret 0
  end
  n = ulong 0
  while lt add sp n sl bound 65536
    if eq get tr_src add sp n 10
      break
    end
    n = add n 1
  end
  nl = ulong 0
  if lt add sp n sl
    nl = 1
  end
  bl = get blen_box 0
  if gt add bl n TR_INPUT_MAX
    tr_puts tr_s_ev_win
    tr_putu bl
    tr_puts tr_s_add
    tr_putu n
    tr_puts tr_s_max
    ret -1
  end
  i = ulong 0
  while lt i n bound 4096
    put buf add bl i get tr_src add sp i
    i = add i 1
  end
  bl = add bl n
  if gt add bl 1 TR_INPUT_MAX
    tr_puts tr_s_ev_win
    tr_putu bl
    tr_puts tr_s_add
    tr_putu 1
    tr_puts tr_s_max
    ret -1
  end
  put buf bl 10
  bl = add bl 1
  put blen_box 0 bl
  put tr_src_pos 0 add add sp n nl
  ret 1
end

fn tr_run_src to void
  w = new ulong 11456 0
  buf = new uchar 4096 0
  blen_box = new ulong 1 0
  outer = ulong 0
  while lt outer 10000 bound 10000
    tr_reset_list w
    put blen_box 0 0
    st = ulong 0
    eof = ulong 0
    inner = ulong 0
    while lt inner 10000 bound 10000
      r = tr_read_line buf blen_box
      if lt r 0
        put tr_last_status 0 2
        ret
      end
      if eq r 0
        eof = 1
        if eq get blen_box 0 0
          ret
        end
        put w OSH_S_EOI 1
      end
      st = tr_lex_parse buf get blen_box 0 w
      if and eq st 0 ne get w OSH_PX_STATE 4
        if eq eof 1
          st = 104
        else
          st = 100
        end
      end
      if and eq st 100 eq eof 0
        inner = add inner 1
        continue
      end
      break
    end
    if eq st 104
      note empty list at eof
    else
      if eq st 0
        if ne tr_run_list buf get blen_box 0 w 0
          ret
        end
      else
        put tr_last_status 0 2
        ret
      end
    end
    if eq eof 1
      ret
    end
    outer = add outer 1
  end
end

fn tr_slurp_to_src plen ulong to long
  fd = fopen tr_path 0 plen 0 0
  if lt fd 0
    ret -1
  end
  total = ulong 0
  while lt total 65536 bound 65536
    r = read int fd tr_src total sub 65536 total
    if lt r 0
      ign = fclose int fd
      ret -1
    end
    if eq r 0
      break
    end
    total = add total ulong r
  end
  ign = fclose int fd
  put tr_src_len 0 total
  ret long total
end

fn tr_slurp_side slen ulong to long
  fd = fopen tr_side 0 slen 0 0
  if lt fd 0
    ret -1
  end
  total = ulong 0
  while lt total 16384 bound 16384
    r = read int fd tr_sbuf total sub 16384 total
    if lt r 0
      ign = fclose int fd
      ret -1
    end
    if eq r 0
      break
    end
    total = add total ulong r
  end
  ign = fclose int fd
  ret long total
end

fn tr_make_side plen ulong ext view uchar * to ulong
  if lt plen 3
    ret 0
  end
  base = sub plen 3
  i = ulong 0
  while lt i base bound 4096
    put tr_side i get tr_path i
    i = add i 1
  end
  el = len ext
  j = ulong 0
  while lt j el bound 32
    put tr_side add base j get ext j
    j = add j 1
  end
  ret add base el
end

fn tr_load_status plen ulong to void
  sl = tr_make_side plen tr_s_ext_st
  if eq sl 0
    ret
  end
  n = tr_slurp_side sl
  if lt n 0
    ret
  end
  put tr_have_status 0 1
  un = ulong n
  i = ulong 0
  while lt i un bound 16384
    c = ulong get tr_sbuf i
    if or eq c 32 or eq c 9 eq c 10
      i = add i 1
      continue
    end
    v = ulong 0
    while lt i un bound 16
      d = ulong get tr_sbuf i
      if or lt d 48 gt d 57
        break
      end
      v = add mul v 10 sub d 48
      i = add i 1
    end
    nf = get tr_nfake 0
    if lt nf TR_MAX_FAKE
      put tr_fake nf v
      put tr_nfake 0 add nf 1
    end
  end
end

fn tr_copy_arg st ulong ln ulong po ulong to void
  k = ulong 0
  while lt k ln bound 4096
    put tr_pos_buf add po k get tr_sbuf add st k
    k = add k 1
  end
end

fn tr_load_args plen ulong to void
  sl2 = tr_make_side plen tr_s_ext_ar
  if eq sl2 0
    ret
  end
  n2 = tr_slurp_side sl2
  if lt n2 0
    ret
  end
  un2 = ulong n2
  i = ulong 0
  po = ulong 0
  while lt i un2 bound 16384
    st = i
    while lt i un2 bound 4096
      if eq get tr_sbuf i 10
        break
      end
      i = add i 1
    end
    ln = sub i st
    np = get tr_npos 0
    if lt np TR_MAX_POS
      put tr_pos_off np po
      put tr_pos_len np ln
      tr_copy_arg st ln po
      po = add po ln
      put tr_npos 0 add np 1
    end
    if lt i un2
      i = add i 1
    end
  end
end

fn tr_load_fixture plen ulong to void
  tr_load_status plen
  tr_load_args plen
end

fn main to int
  ac = argcnt
  note Support both "osh_trace script.sh" (2 args) and legacy "osh_trace interp|native lex parse expand script.sh" (6 args)
  idx = ulong 1
  if eq ac 6
    idx = 5
  else
    if ne ac 2
      ign = write 2 tr_s_usage 0 len tr_s_usage
      ret 2
    end
  end
  plen = argread idx tr_path 0 4096
  if le plen 0
    ret 2
  end
  if lt tr_slurp_to_src ulong plen 0
    ret 2
  end
  tr_load_fixture ulong plen
  tr_run_src
  tr_puts tr_s_ev_exit
  tr_putu get tr_last_status 0
  tr_putc 10
  tr_flush
  ret 0
end

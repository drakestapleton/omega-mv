om2
note test_osh_parse.om -- pure OM-2 test driver for src/osh/osh_lex.om + src/osh/osh_parse.om.
note Linked with: osh_layout.om osh_lex.om osh_parse.om.
note Usage: test_osh_parse [VECTORS_DIR [PARSE_VECTORS_DIR]]

global tp_checks ulong 1
global tp_fails ulong 1
global tp_rng ulong 1
global tp_obuf uchar 512
global tp_olen ulong 1

text tp_s_pass "OSH_PARSE_PASS\n"
text tp_s_fail "OSH_PARSE_FAIL\n"
text tp_s_chk "checks="
text tp_s_fl " fails="
text tp_s_vec " vectors="
text tp_s_vdir "tests/osh/vectors"
text tp_s_pdir "tests/osh/parse_vectors"
text tp_s_bad "FAIL: "
text tp_s_c1 "echo a | cat && echo b\n"
text tp_s_c2 "a=1 b=2 echo hi > out 2>&1\n"
text tp_s_c3 "|\n"
text tp_s_c4 "echo a &&\n"
text tp_s_c5 "echo a >\n"

fn tp_reset to void
  put tp_olen 0 0
end

fn tp_ch c uchar to void
  n = get tp_olen 0
  if lt n 510
    put tp_obuf n c
    put tp_olen 0 add n 1
  end
end

fn tp_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    tp_ch get s i
    i = add i 1
  end
end

fn tp_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tp_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn tp_flush fd int to void
  n = get tp_olen 0
  if gt n 0
    ign = write fd tp_obuf 0 n
  end
  put tp_olen 0 0
end

fn tp_check ok ulong id ulong to void
  put tp_checks 0 add get tp_checks 0 1
  if eq ok 0
    put tp_fails 0 add get tp_fails 0 1
    tp_reset
    tp_txt tp_s_bad
    tp_u64 id
    tp_ch 10
    tp_flush 2
  end
end

fn tp_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tp_check ok id
end

fn tp_check_ge a ulong b ulong id ulong to void
  ok = ulong 0
  if ge a b
    ok = 1
  end
  tp_check ok id
end

fn tp_zero_ws w edit ulong 11456 to void
  i = ulong 0
  while lt i OSH_WS_CELLS bound 11456
    put w i 0
    i = add i 1
  end
end

fn tp_run_whole buf view uchar * blen ulong w edit ulong 11456 to ulong
  tp_zero_ws w
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  put w OSH_S_EOI 1
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_lex_run buf blen w OSH_WS_CELLS
    if ne st 101
      if ne st 0
        ret st
      end
      break
    end
    g = add g 1
  end
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_parse_run buf blen w OSH_WS_CELLS
    if ne st 101
      ret st
    end
    g = add g 1
  end
  ret 255
end

fn tp_run_chunked buf view uchar * blen ulong w edit ulong 11456 to ulong
  tp_zero_ws w
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  pos = ulong 0
  g = ulong 0
  while lt g 4000 bound 4000
    chunk = add pos 1
    if ge chunk blen
      chunk = blen
      put w OSH_S_EOI 1
    else
      put w OSH_S_EOI 0
    end
    st = osh_lex_run part buf 0 chunk chunk w OSH_WS_CELLS
    if eq st 101
      g = add g 1
      continue
    end
    if or eq st 100 eq st 0
      if ge chunk blen
        if ne st 0
          ret st
        end
        break
      end
      pos = chunk
      g = add g 1
      continue
    end
    ret st
  end
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_parse_run buf blen w OSH_WS_CELLS
    if ne st 101
      ret st
    end
    g = add g 1
  end
  ret 255
end

fn tp_same_ast w1 view ulong 11456 w2 view ulong 11456 to ulong
  n1 = get w1 OSH_PX_NCMD
  n2 = get w2 OSH_PX_NCMD
  if ne n1 n2
    ret 0
  end
  if ne get w1 OSH_PX_NPIPE get w2 OSH_PX_NPIPE
    ret 0
  end
  cells = mul n1 8
  i = ulong 0
  while lt i cells bound 256
    if ne get w1 add OSH_CMDS i get w2 add OSH_CMDS i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn tp_test_one buf view uchar * blen ulong id ulong to void
  w1 = new ulong 11456 0
  w2 = new ulong 11456 0
  s1 = tp_run_whole buf blen w1
  s2 = tp_run_chunked buf blen w2
  tp_check_eq s1 s2 id
  if eq s1 0
    tp_check tp_same_ast w1 w2 add id 1000
  end
end

fn tp_read_vec dir view uchar * dl ulong idx ulong dst edit uchar 4096 to long
  p = new uchar 512 0
  i = ulong 0
  while lt i dl bound 256
    put p i get dir i
    i = add i 1
  end
  put p dl 47
  put p add dl 1 118
  put p add dl 2 uchar add 48 div idx 100
  put p add dl 3 uchar add 48 rem div idx 10 10
  put p add dl 4 uchar add 48 rem idx 10
  put p add dl 5 46
  put p add dl 6 105
  put p add dl 7 110
  fd = fopen p 0 add dl 8 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 4096 bound 4096
    r = read int fd dst tot sub 4096 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  ign = fclose int fd
  ret long tot
end

fn tp_test_cases to void
  w = new ulong 11456 0
  tp_check_eq tp_run_whole tp_s_c1 len tp_s_c1 w 0 1
  tp_check_ge get w OSH_PX_NCMD 1 2
  tp_check_eq tp_run_whole tp_s_c2 len tp_s_c2 w 0 3
  tp_check_ge tp_run_whole tp_s_c3 len tp_s_c3 w 200 4
  tp_check_ge tp_run_whole tp_s_c4 len tp_s_c4 w 200 5
  tp_check_ge tp_run_whole tp_s_c5 len tp_s_c5 w 200 6
end

fn tp_xorshift to ulong
  x = get tp_rng 0
  x = xor x shl x 13
  x = xor x shr x 7
  x = xor x shl x 17
  put tp_rng 0 x
  ret x
end

fn tp_run_fuzz nfuzz ulong to void
  fbuf = new uchar 64 0
  alpha = new uchar 16 0
  put alpha 0 97
  put alpha 1 32
  put alpha 2 10
  put alpha 3 59
  put alpha 4 124
  put alpha 5 38
  put alpha 6 60
  put alpha 7 62
  put alpha 8 61
  put alpha 9 39
  put alpha 10 34
  put alpha 11 36
  put alpha 12 49
  put alpha 13 50
  put alpha 14 35
  put alpha 15 92
  fi = ulong 0
  while lt fi nfuzz bound 5000
    ln = add 1 rem tp_xorshift 32
    k = ulong 0
    while lt k ln bound 32
      put fbuf k get alpha rem tp_xorshift 16
      k = add k 1
    end
    tp_test_one fbuf ln add 5000 fi
    fi = add fi 1
  end
end

fn main to int
  put tp_checks 0 0
  put tp_fails 0 0
  put tp_rng 0 0xd1b54a32d192ed03
  vdir = new uchar 256 0
  pdir = new uchar 256 0
  vdl = ulong 0
  pdl = ulong 0
  ac = argcnt
  if gt ac 1
    r = argread 1 vdir 0 256
    if gt r 0
      vdl = ulong r
    end
  end
  if gt ac 2
    r = argread 2 pdir 0 256
    if gt r 0
      pdl = ulong r
    end
  end
  if eq vdl 0
    vdl = len tp_s_vdir
    i = ulong 0
    while lt i vdl bound 256
      put vdir i get tp_s_vdir i
      i = add i 1
    end
  end
  if eq pdl 0
    pdl = len tp_s_pdir
    i = ulong 0
    while lt i pdl bound 256
      put pdir i get tp_s_pdir i
      i = add i 1
    end
  end
  tp_test_cases
  vbuf = new uchar 4096 0
  vn = ulong 0
  idx = ulong 1
  while le idx 20 bound 20
    rl = tp_read_vec vdir vdl idx vbuf
    if ge rl 0
      tp_test_one vbuf ulong rl add 100 idx
      vn = add vn 1
    end
    idx = add idx 1
  end
  idx = ulong 101
  while le idx 112 bound 12
    rl = tp_read_vec pdir pdl idx vbuf
    if ge rl 0
      tp_test_one vbuf ulong rl add 200 idx
      vn = add vn 1
    end
    idx = add idx 1
  end
  tp_check_eq vn 32 99
  tp_run_fuzz 400
  tp_reset
  tp_txt tp_s_chk
  tp_u64 get tp_checks 0
  tp_txt tp_s_fl
  tp_u64 get tp_fails 0
  tp_txt tp_s_vec
  tp_u64 vn
  tp_ch 10
  tp_flush 1
  if eq get tp_fails 0 0
    tp_reset
    tp_txt tp_s_pass
    tp_flush 1
    ret 0
  end
  tp_reset
  tp_txt tp_s_fail
  tp_flush 1
  ret 1
end

om2
note test_osh_lex.om -- pure OM-2 test driver for src/osh/osh_lex.om.
note Linked with: osh_layout.om osh_lex.om.
note Usage: test_osh_lex [VECTORS_DIR [FUZZ_COUNT]]

global tl_ws1 ulong 11456
global tl_ws2 ulong 11456
global tl_checks ulong 1
global tl_fails ulong 1
global tl_rng ulong 1
global tl_obuf uchar 512
global tl_olen ulong 1

text tl_s_pass "OSH_LEX_PASS\n"
text tl_s_fail "OSH_LEX_FAIL\n"
text tl_s_chk "checks="
text tl_s_fl " fails="
text tl_s_vec " vectors="
text tl_s_fuz " fuzz="
text tl_s_vdir "tests/osh/vectors"
text tl_s_bad "FAIL: "

fn tl_reset to void
  put tl_olen 0 0
end

fn tl_ch c uchar to void
  n = get tl_olen 0
  if lt n 510
    put tl_obuf n c
    put tl_olen 0 add n 1
  end
end

fn tl_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    tl_ch get s i
    i = add i 1
  end
end

fn tl_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tl_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn tl_flush fd int to void
  n = get tl_olen 0
  if gt n 0
    ign = write fd tl_obuf 0 n
  end
  put tl_olen 0 0
end

fn tl_check ok ulong id ulong to void
  put tl_checks 0 add get tl_checks 0 1
  if eq ok 0
    put tl_fails 0 add get tl_fails 0 1
    tl_reset
    tl_txt tl_s_bad
    tl_u64 id
    tl_ch 10
    tl_flush 2
  end
end

fn tl_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tl_check ok id
end

fn tl_zero_ws w edit ulong 11456 to void
  i = ulong 0
  while lt i OSH_WS_CELLS bound 11456
    put w i 0
    i = add i 1
  end
end

fn tl_run_whole buf view uchar * blen ulong w edit ulong 11456 to ulong
  tl_zero_ws w
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  put w OSH_S_EOI 1
  g = ulong 0
  while lt g 2000 bound 2000
    st = osh_lex_run buf blen w OSH_WS_CELLS
    if ne st 101
      ret st
    end
    g = add g 1
  end
  ret 255
end

fn tl_run_chunked buf view uchar * blen ulong w edit ulong 11456 to ulong
  tl_zero_ws w
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  pos = ulong 0
  g = ulong 0
  while lt g 4000 bound 4000
    chunk = add pos 1
    if ge chunk blen
      chunk = blen
      put w OSH_S_EOI 1
    else
      put w OSH_S_EOI 0
    end
    st = osh_lex_run part buf 0 chunk chunk w OSH_WS_CELLS
    if eq st 101
      g = add g 1
      continue
    end
    if or eq st 100 eq st 0
      if ge chunk blen
        ret st
      end
      pos = chunk
      g = add g 1
      continue
    end
    ret st
  end
  ret 255
end

fn tl_same_tokens w1 view ulong 11456 w2 view ulong 11456 to ulong
  n1 = get w1 OSH_LX_NTOK
  n2 = get w2 OSH_LX_NTOK
  if ne n1 n2
    ret 0
  end
  cells = mul n1 4
  i = ulong 0
  while lt i cells bound 4096
    if ne get w1 add OSH_TOKENS i get w2 add OSH_TOKENS i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn tl_test_one buf view uchar * blen ulong id ulong to void
  w1 = new ulong 11456 0
  w2 = new ulong 11456 0
  s1 = tl_run_whole buf blen w1
  s2 = tl_run_chunked buf blen w2
  tl_check_eq s1 s2 id
  if eq s1 0
    tl_check tl_same_tokens w1 w2 add id 1000
  end
end

fn tl_read_vec dir view uchar * dl ulong idx ulong dst edit uchar 4096 to long
  p = new uchar 512 0
  i = ulong 0
  while lt i dl bound 256
    put p i get dir i
    i = add i 1
  end
  put p dl 47
  put p add dl 1 118
  put p add dl 2 uchar add 48 div idx 100
  put p add dl 3 uchar add 48 rem div idx 10 10
  put p add dl 4 uchar add 48 rem idx 10
  put p add dl 5 46
  put p add dl 6 105
  put p add dl 7 110
  fd = fopen p 0 add dl 8 0 0
  if lt fd 0
    ret -1
  end
  tot = ulong 0
  while lt tot 4096 bound 4096
    r = read int fd dst tot sub 4096 tot
    if le r 0
      break
    end
    tot = add tot ulong r
  end
  ign = fclose int fd
  ret long tot
end

fn tl_xorshift to ulong
  x = get tl_rng 0
  x = xor x shl x 13
  x = xor x shr x 7
  x = xor x shl x 17
  put tl_rng 0 x
  ret x
end

fn tl_check_ge a ulong b ulong id ulong to void
  ok = ulong 0
  if ge a b
    ok = 1
  end
  tl_check ok id
end

fn tl_test_abi to void
  w = new ulong 11456 0
  b = new uchar 16 0
  note bad ABI version -> refusal (>=200)
  put w OSH_S_MAGIC OSH_ABI_MAGIC
  put w OSH_S_VERSION 99
  put w OSH_S_WS_CELLS OSH_WS_CELLS
  tl_check_ge osh_lex_run b 0 w OSH_WS_CELLS 200 1
  note short workspace -> refusal (>=200)
  put w OSH_S_VERSION OSH_ABI_VERSION
  put w OSH_S_WS_CELLS 10
  tl_check_ge osh_lex_run b 0 w 10 200 2
  note unclosed single quote -> refusal (>=200)
  put b 0 39
  put b 1 97
  tl_check_ge tl_run_whole b 2 w 200 3
  note unclosed double quote -> refusal (>=200)
  put b 0 34
  put b 1 97
  tl_check_ge tl_run_whole b 2 w 200 4
  note command substitution $(...) -> refusal (>=200)
  put b 0 36
  put b 1 40
  put b 2 120
  put b 3 41
  tl_check_ge tl_run_whole b 4 w 200 5
  note backtick -> refusal (>=200)
  put b 0 96
  put b 1 120
  put b 2 96
  tl_check_ge tl_run_whole b 3 w 200 6
  note heredoc << -> refusal (>=200)
  put b 0 60
  put b 1 60
  put b 2 69
  tl_check_ge tl_run_whole b 3 w 200 7
end

fn tl_run_fuzz nfuzz ulong to void
  fbuf = new uchar 64 0
  alphabet = new uchar 24 0
  put alphabet 0 97
  put alphabet 1 98
  put alphabet 2 32
  put alphabet 3 10
  put alphabet 4 59
  put alphabet 5 124
  put alphabet 6 38
  put alphabet 7 60
  put alphabet 8 62
  put alphabet 9 39
  put alphabet 10 34
  put alphabet 11 92
  put alphabet 12 36
  put alphabet 13 61
  put alphabet 14 35
  put alphabet 15 48
  put alphabet 16 49
  put alphabet 17 50
  put alphabet 18 123
  put alphabet 19 125
  put alphabet 20 40
  put alphabet 21 41
  put alphabet 22 42
  put alphabet 23 63
  fi = ulong 0
  while lt fi nfuzz bound 10000
    ln = add 1 rem tl_xorshift 32
    k = ulong 0
    while lt k ln bound 32
      put fbuf k get alphabet rem tl_xorshift 24
      k = add k 1
    end
    tl_test_one fbuf ln add 5000 fi
    fi = add fi 1
  end
end

fn main to int
  put tl_checks 0 0
  put tl_fails 0 0
  put tl_rng 0 0x9e3779b97f4a7c15
  vdir = new uchar 256 0
  vdl = ulong 0
  ac = argcnt
  if gt ac 1
    r = argread 1 vdir 0 256
    if gt r 0
      vdl = ulong r
    end
  end
  if eq vdl 0
    vdl = len tl_s_vdir
    i = ulong 0
    while lt i vdl bound 256
      put vdir i get tl_s_vdir i
      i = add i 1
    end
  end
  tl_test_abi
  vbuf = new uchar 4096 0
  vn = ulong 0
  idx = ulong 1
  while le idx 20 bound 20
    rl = tl_read_vec vdir vdl idx vbuf
    if ge rl 0
      tl_test_one vbuf ulong rl add 100 idx
      vn = add vn 1
    end
    idx = add idx 1
  end
  tl_check_eq vn 20 99
  nfuzz = ulong 500
  tl_run_fuzz nfuzz
  tl_reset
  tl_txt tl_s_chk
  tl_u64 get tl_checks 0
  tl_txt tl_s_fl
  tl_u64 get tl_fails 0
  tl_txt tl_s_vec
  tl_u64 vn
  tl_txt tl_s_fuz
  tl_u64 nfuzz
  tl_ch 10
  tl_flush 1
  if eq get tl_fails 0 0
    tl_reset
    tl_txt tl_s_pass
    tl_flush 1
    ret 0
  end
  tl_reset
  tl_txt tl_s_fail
  tl_flush 1
  ret 1
end

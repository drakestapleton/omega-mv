om2
note argprint.om -- tiny helper program for the osh end-to-end tests.
note   argprint ARGS...      prints each argument as [arg] on its own line
note   argprint -e NAME      prints [value] of an environment variable, or [(unset)]
note   argprint -x N         exits with status N, printing nothing
note   argprint -cat         copies standard input to standard output
note   argprint -io          writes "O" to stdout and "E" to stderr, in that order
note   argprint -pwd         prints [cwd]

text ap_e "-e"
text ap_x "-x"
text ap_cat "-cat"
text ap_io "-io"
text ap_pwd "-pwd"
text ap_unset "(unset)"
text ap_O "O"
text ap_E "E"
text ap_lb "["
text ap_rb "]\n"

fn ap_eq a view uchar * al ulong t view uchar * to ulong
  tl = len t
  if ne al tl
    ret 0
  end
  i = ulong 0
  while lt i al bound 64
    if ne get a i get t i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn ap_write_all fd int b view uchar * n ulong to long
  o = ulong 0
  while lt o n bound 65536
    w = write fd b o sub n o
    if le w 0
      ret -1
    end
    o = add o ulong w
  end
  ret 0
end

fn ap_print_bracket s view uchar * n ulong to void
  ign = ap_write_all 1 ap_lb 1
  ign = ap_write_all 1 s n
  ign = ap_write_all 1 ap_rb 2
end

fn ap_do_env nm view uchar * nl ulong to int
  ebuf = new uchar 4096 0
  ec = envcnt
  if gt ec 0
    i = ulong 0
    while lt i ulong ec bound 512
      el = envread i ebuf 0 4096
      if gt el long nl
        if eq get ebuf nl 61
          ok = ulong 1
          k = ulong 0
          while lt k nl bound 256
            if ne get ebuf k get nm k
              ok = 0
              break
            end
            k = add k 1
          end
          if eq ok 1
            vl = sub sub ulong el nl 1
            ap_print_bracket part ebuf add nl 1 vl vl
            ret 0
          end
        end
      end
      i = add i 1
    end
  end
  ap_print_bracket ap_unset len ap_unset
  ret 0
end

fn ap_do_atoi s view uchar * n ulong to int
  i = ulong 0
  neg_f = ulong 0
  if lt i n
    if eq get s i 45
      neg_f = 1
      i = add i 1
    end
  end
  v = ulong 0
  while lt i n bound 32
    c = ulong get s i
    if or lt c 48 gt c 57
      break
    end
    v = add mul v 10 sub c 48
    i = add i 1
  end
  if eq neg_f 1
    v = sub ulong 0 v
  end
  ret int and v 255
end

fn ap_do_cat to int
  b = new uchar 4096 0
  k = ulong 0
  while lt k 100000 bound 100000
    r = read 0 b 0 4096
    if lt r 0
      ret 1
    end
    if eq r 0
      ret 0
    end
    if ne ap_write_all 1 b ulong r 0
      ret 1
    end
    k = add k 1
  end
  ret 0
end

fn main to int
  ac_l = argcnt
  if le ac_l 1
    ret 0
  end
  ac = ulong ac_l
  a1 = new uchar 4096 0
  a2 = new uchar 4096 0
  l1 = argread 1 a1 0 4096
  if lt l1 0
    ret 1
  end
  if ge ac 3
    l2 = argread 2 a2 0 4096
    if lt l2 0
      ret 1
    end
    if eq ap_eq a1 ulong l1 ap_e 1
      ret ap_do_env a2 ulong l2
    end
    if eq ap_eq a1 ulong l1 ap_x 1
      ret ap_do_atoi a2 ulong l2
    end
  end
  if eq ac 2
    if eq ap_eq a1 ulong l1 ap_cat 1
      ret ap_do_cat
    end
    if eq ap_eq a1 ulong l1 ap_io 1
      if ne ap_write_all 1 ap_O 1 0
        ret 1
      end
      if ne ap_write_all 2 ap_E 1 0
        ret 1
      end
      ret 0
    end
    if eq ap_eq a1 ulong l1 ap_pwd 1
      cr = cwd a2 0 4096
      if le cr 1
        ret 1
      end
      ap_print_bracket a2 sub ulong cr 1
      ret 0
    end
  end
  i = ulong 1
  while lt i ac bound 128
    al = argread i a1 0 4096
    if lt al 0
      ret 1
    end
    ap_print_bracket a1 ulong al
    i = add i 1
  end
  ret 0
end

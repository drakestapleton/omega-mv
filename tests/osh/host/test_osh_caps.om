om2
note test_osh_caps.om -- pure OM-2 capability enforcement test suite.
note Linked with: sha256-om2.om osh_core.om osh_layout.om osh_codes.om osh_req.om
note              osh_vars.om osh_journal.om osh_caps.om osh_builtin.om osh_exec.om.

global tc_checks ulong 1
global tc_fails ulong 1
global tc_dbuf uchar 512
global tc_dlen ulong 1

text tc_s_pass "OSH_CAPS_PASS\n"
text tc_s_fail "OSH_CAPS_FAIL\n"
text tc_s_bad "FAIL: "
text tc_s_chk "checks="
text tc_s_fl " fails="
text tc_p_good "principal 7\nallow spawn /usr/bin\nallow read /tmp\nallow write /tmp\nallow chdir /tmp\n"
text tc_p_bad1 "allow read /tmp\n"
text tc_p_bad2 "principal 7\nprincipal 8\n"
text tc_p_bad3 "principal 7\nallow bogus /tmp\n"
text tc_p_bad4 "principal 7\nallow read relative/path\n"
text tc_path_spawn_ok "/usr/bin/true"
text tc_path_spawn_no "/bin/sh"
text tc_path_tmp_new "/tmp/osh_caps_newfile_test"
text tc_path_etc "/etc/passwd"
text tc_path_tmp "/tmp"

fn tc_d_ch c uchar to void
  n = get tc_dlen 0
  if lt n 510
    put tc_dbuf n c
    put tc_dlen 0 add n 1
  end
end

fn tc_d_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    tc_d_ch get s i
    i = add i 1
  end
end

fn tc_d_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tc_d_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn tc_flush fd int to void
  n = get tc_dlen 0
  if gt n 0
    ign = write fd tc_dbuf 0 n
  end
  put tc_dlen 0 0
end

fn tc_check ok ulong id ulong to void
  put tc_checks 0 add get tc_checks 0 1
  if eq ok 0
    put tc_fails 0 add get tc_fails 0 1
    put tc_dlen 0 0
    tc_d_txt tc_s_bad
    tc_d_u64 id
    tc_d_ch 10
    tc_flush 2
  end
end

fn tc_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tc_check ok id
end

fn tc_check_eq_l a long b long id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tc_check ok id
end

fn tc_test_policy_parse to void
  osh_caps_start
  tc_check_eq_l osh_caps_load tc_p_bad1 len tc_p_bad1 -1 1
  osh_caps_stop
  osh_caps_start
  tc_check_eq_l osh_caps_load tc_p_bad2 len tc_p_bad2 -1 2
  osh_caps_stop
  osh_caps_start
  tc_check_eq_l osh_caps_load tc_p_bad3 len tc_p_bad3 -1 3
  osh_caps_stop
  osh_caps_start
  tc_check_eq_l osh_caps_load tc_p_bad4 len tc_p_bad4 -1 4
  osh_caps_stop
end

fn tc_test_enforcement to void
  osh_session_init_from_env
  osh_caps_start
  tc_check_eq_l osh_caps_load tc_p_good len tc_p_good 0 10
  osh_caps_attach
  osh_caps_seal
  note Cannot load after seal
  tc_check_eq_l osh_caps_load tc_p_good len tc_p_good -1 11
  note Allowed effects
  tc_check_eq osh_caps_effect OSH_OP_SPAWN tc_path_spawn_ok len tc_path_spawn_ok OSH_E_OK 12
  tc_check_eq osh_caps_effect OSH_OP_OPEN_WRITE tc_path_tmp_new len tc_path_tmp_new OSH_E_OK 13
  tc_check_eq osh_caps_effect OSH_OP_CHDIR tc_path_tmp len tc_path_tmp OSH_E_OK 14
  note Denied effects
  tc_check_eq osh_caps_effect OSH_OP_OPEN_READ tc_path_etc len tc_path_etc OSH_E_DENIED 15
  tc_check_eq osh_caps_effect OSH_OP_OPEN_WRITE tc_path_etc len tc_path_etc OSH_E_DENIED 16
  tc_check_eq osh_caps_effect OSH_OP_SPAWN tc_path_etc len tc_path_etc OSH_E_DENIED 17
  note Stale generation -> OSH_E_STALE
  put cap_prin_gen 0 2
  tc_check_eq osh_caps_effect OSH_OP_CHDIR tc_path_tmp len tc_path_tmp OSH_E_STALE 18
  put cap_prin_gen 0 1
  note Revoked principal -> OSH_E_REVOKED
  put cap_prin_revoked 0 1
  tc_check_eq osh_caps_effect OSH_OP_CHDIR tc_path_tmp len tc_path_tmp OSH_E_REVOKED 19
  put cap_prin_revoked 0 0
  note Forged principal id -> OSH_E_DENIED
  put sess_bind_pid 0 99
  tc_check_eq osh_caps_effect OSH_OP_CHDIR tc_path_tmp len tc_path_tmp OSH_E_DENIED 20
  osh_caps_stop
end

fn main to int
  put tc_checks 0 0
  put tc_fails 0 0
  tc_test_policy_parse
  tc_test_enforcement
  put tc_dlen 0 0
  tc_d_txt tc_s_chk
  tc_d_u64 get tc_checks 0
  tc_d_txt tc_s_fl
  tc_d_u64 get tc_fails 0
  tc_d_ch 10
  tc_flush 1
  if eq get tc_fails 0 0
    put tc_dlen 0 0
    tc_d_txt tc_s_pass
    tc_flush 1
    ret 0
  end
  put tc_dlen 0 0
  tc_d_txt tc_s_fail
  tc_flush 1
  ret 1
end

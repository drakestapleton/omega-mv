om2
note test_osh_host.om -- pure OM-2 test suite for osh host execution service.
note Linked with: sha256-om2.om osh_core.om osh_layout.om osh_codes.om osh_req.om
note              osh_vars.om osh_journal.om osh_caps.om osh_builtin.om osh_exec.om.

global th_checks ulong 1
global th_fails ulong 1
global th_dbuf uchar 512
global th_dlen ulong 1

text th_s_pass "OSH_HOST_PASS\n"
text th_s_fail "OSH_HOST_FAIL\n"
text th_s_bad "FAIL: "
text th_s_chk "checks="
text th_s_fl " fails="
text th_s_foo "FOO"
text th_s_bar "bar"
text th_s_baz "baz"
text th_s_badnm "1BAD"
text th_s_path "PATH"
text th_s_dpath "/usr/bin:/bin"
text th_s_true "true"
text th_s_false "false"
text th_s_printf "printf"
text th_s_fmt "%s=%d\n"
text th_s_hi "hi"
text th_s_42 "42"
text th_s_cd "cd"
text th_s_tmp "/tmp"
text th_s_pwd "pwd"
text th_s_export "export"
text th_s_unset "unset"
text th_s_exit "exit"
text th_s_exp_kv "MYVAR=hello"
text th_s_myvar "MYVAR"
text th_s_hello "hello"
text th_s_17 "17"
text th_s_nonexist "/nonexistent_osh_cmd_xyz"
text th_s_outf "/tmp/osh_host_test_out"

fn th_d_ch c uchar to void
  n = get th_dlen 0
  if lt n 510
    put th_dbuf n c
    put th_dlen 0 add n 1
  end
end

fn th_d_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    th_d_ch get s i
    i = add i 1
  end
end

fn th_d_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    th_d_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn th_flush fd int to void
  n = get th_dlen 0
  if gt n 0
    ign = write fd th_dbuf 0 n
  end
  put th_dlen 0 0
end

fn th_check ok ulong id ulong to void
  put th_checks 0 add get th_checks 0 1
  if eq ok 0
    put th_fails 0 add get th_fails 0 1
    put th_dlen 0 0
    th_d_txt th_s_bad
    th_d_u64 id
    th_d_ch 10
    th_flush 2
  end
end

fn th_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  th_check ok id
end

fn th_check_eq_l a long b long id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  th_check ok id
end

fn th_buf_eq a view uchar * al ulong b view uchar * to ulong
  bl = len b
  if ne al bl
    ret 0
  end
  i = ulong 0
  while lt i al bound 4096
    if ne get a i get b i
      ret 0
    end
    i = add i 1
  end
  ret 1
end

fn th_test_vars to void
  val = new uchar 256 0
  osh_session_init_from_env
  th_check_eq_l osh_var_set th_s_foo 3 th_s_bar 3 0 1
  gl = osh_var_get th_s_foo 3 val 256
  th_check_eq_l gl 3 2
  th_check th_buf_eq val 3 th_s_bar 3
  th_check_eq_l osh_var_set th_s_foo 3 th_s_baz 3 0 4
  gl = osh_var_get th_s_foo 3 val 256
  th_check th_buf_eq val ulong gl th_s_baz 5
  th_check_eq_l osh_var_set th_s_badnm 4 th_s_bar 3 -1 6
  th_check_eq_l osh_var_export th_s_foo 3 th_s_bar 3 0 7
  osh_var_unset th_s_foo 3
  th_check_eq_l osh_var_get th_s_foo 3 val 256 -1 8
end

fn th_test_conn to void
  th_check_eq osh_conn_should_run OSH_CONN_SEMI 0 1 20
  th_check_eq osh_conn_should_run OSH_CONN_SEMI 1 1 21
  th_check_eq osh_conn_should_run OSH_CONN_AND 0 1 22
  th_check_eq osh_conn_should_run OSH_CONN_AND 1 0 23
  th_check_eq osh_conn_should_run OSH_CONN_OR 0 0 24
  th_check_eq osh_conn_should_run OSH_CONN_OR 1 1 25
end

fn th_rb_decode to ulong
  rec = new ulong 1400 0
  obuf = new ulong 8192 0
  osh_rb_seal
  nrec = add OSH_REQ_HDR_CELLS mul get rb_ncmds 0 OSH_CMD_CELLS
  used = get rb_out_used 0
  i = ulong 0
  while lt i nrec bound 1400
    put rec i get rb_rec i
    i = add i 1
  end
  i = ulong 0
  while lt i used bound 8192
    put obuf i get rb_out i
    i = add i 1
  end
  ret osh_req_decode part rec 0 nrec nrec part obuf 0 used used
end

fn th_test_req_decode to void
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_PRINTF
  osh_rb_arg th_s_printf len th_s_printf
  osh_rb_arg th_s_fmt len th_s_fmt
  osh_rb_arg th_s_hi len th_s_hi
  osh_rb_arg th_s_42 len th_s_42
  th_check_eq th_rb_decode 0 30
  th_check_eq get rq_ncmds 0 1 31
  th_check_eq get rq_cmd_na 0 4 32
  th_check_eq get rq_cmd_bi 0 OSH_B_PRINTF 33
  note Corrupt magic -> refusal (>=200)
  rec = new ulong 170 0
  obuf = new ulong 16 0
  put rec 0 12345
  bad_rc = osh_req_decode rec 170 obuf 0
  ok_bad = ulong 0
  if ge bad_rc 200
    ok_bad = 1
  end
  th_check ok_bad 34
end

fn th_test_builtins to void
  val = new uchar 256 0
  osh_session_init_from_env
  ign = osh_var_export th_s_path 4 th_s_dpath len th_s_dpath
  note export MYVAR=hello
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_EXPORT
  osh_rb_arg th_s_export len th_s_export
  osh_rb_arg th_s_exp_kv len th_s_exp_kv
  th_check_eq th_rb_decode 0 40
  th_check_eq osh_exec 0 41
  gl = osh_var_get th_s_myvar 5 val 256
  th_check_eq_l gl 5 42
  th_check th_buf_eq val 5 th_s_hello 43
  note unset MYVAR
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_UNSET
  osh_rb_arg th_s_unset len th_s_unset
  osh_rb_arg th_s_myvar len th_s_myvar
  th_check_eq th_rb_decode 0 44
  th_check_eq osh_exec 0 45
  th_check_eq_l osh_var_get th_s_myvar 5 val 256 -1 46
  note cd /tmp
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_CD
  osh_rb_arg th_s_cd len th_s_cd
  osh_rb_arg th_s_tmp len th_s_tmp
  th_check_eq th_rb_decode 0 47
  th_check_eq osh_exec 0 48
  note exit 17
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_EXIT
  osh_rb_arg th_s_exit len th_s_exit
  osh_rb_arg th_s_17 len th_s_17
  th_check_eq th_rb_decode 0 49
  th_check_eq osh_exec 17 50
  th_check_eq get sess_exit_req 0 1 51
  th_check_eq get sess_exit_st 0 17 52
  put sess_exit_req 0 0
end

fn th_test_exec_external to void
  osh_session_init_from_env
  ign = osh_var_export th_s_path 4 th_s_dpath len th_s_dpath
  note /usr/bin/true -> 0
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_NONE
  osh_rb_arg th_s_true len th_s_true
  th_check_eq th_rb_decode 0 60
  th_check_eq osh_exec 0 61
  note /usr/bin/false -> 1
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_NONE
  osh_rb_arg th_s_false len th_s_false
  th_check_eq th_rb_decode 0 62
  th_check_eq osh_exec 1 63
  note nonexistent command -> 127
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_NONE
  osh_rb_arg th_s_nonexist len th_s_nonexist
  th_check_eq th_rb_decode 0 64
  th_check_eq osh_exec 127 65
  note printf redirected to file
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_PRINTF
  osh_rb_arg th_s_printf len th_s_printf
  osh_rb_arg th_s_fmt len th_s_fmt
  osh_rb_arg th_s_hi len th_s_hi
  osh_rb_arg th_s_42 len th_s_42
  osh_rb_redir OSH_R_OUT 1 th_s_outf len th_s_outf
  th_check_eq th_rb_decode 0 66
  th_check_eq osh_exec 0 67
  buf = new uchar 64 0
  fd = fopen th_s_outf 0 len th_s_outf 0 0
  if ge fd 0
    r = read int fd buf 0 64
    ign = fclose int fd
    th_check_eq_l r 6 68
  else
    th_check 0 68
  end
  ign = unlink th_s_outf 0 len th_s_outf
end

fn main to int
  put th_checks 0 0
  put th_fails 0 0
  th_test_vars
  th_test_conn
  th_test_req_decode
  th_test_builtins
  th_test_exec_external
  put th_dlen 0 0
  th_d_txt th_s_chk
  th_d_u64 get th_checks 0
  th_d_txt th_s_fl
  th_d_u64 get th_fails 0
  th_d_ch 10
  th_flush 1
  if eq get th_fails 0 0
    put th_dlen 0 0
    th_d_txt th_s_pass
    th_flush 1
    ret 0
  end
  put th_dlen 0 0
  th_d_txt th_s_fail
  th_flush 1
  ret 1
end

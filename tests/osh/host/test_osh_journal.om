om2
note test_osh_journal.om -- pure OM-2 durable intent/outcome journal test suite.
note Linked with: sha256-om2.om osh_core.om osh_layout.om osh_codes.om osh_req.om
note              osh_vars.om osh_journal.om osh_caps.om osh_builtin.om osh_exec.om.

global tj_checks ulong 1
global tj_fails ulong 1
global tj_dbuf uchar 512
global tj_dlen ulong 1

text tj_s_pass "OSH_JOURNAL_PASS\n"
text tj_s_fail "OSH_JOURNAL_FAIL\n"
text tj_s_bad "FAIL: "
text tj_s_chk "checks="
text tj_s_fl " fails="
text tj_sec1 "API_TOKEN"
text tj_sec2 "my_secret_val"
text tj_sec3 "DB_PASSWORD"
text tj_sec4 "PATH"
text tj_sec5 "HOME"
text tj_dir_pre "/tmp/osh_jtest_"
text tj_j_suf "/j.log"
text tj_k_suf "/j.log.key"
text tj_cmd_echo "echo"
text tj_cmd_hi "hi"

fn tj_d_ch c uchar to void
  n = get tj_dlen 0
  if lt n 510
    put tj_dbuf n c
    put tj_dlen 0 add n 1
  end
end

fn tj_d_txt s view uchar * to void
  i = ulong 0
  n = len s
  while lt i n bound 256
    tj_d_ch get s i
    i = add i 1
  end
end

fn tj_d_u64 v0 ulong to void
  dig = new uchar 24 0
  v = v0
  n = ulong 0
  while ge v 10 bound 24
    put dig n uchar add 48 rem v 10
    v = div v 10
    n = add n 1
  end
  put dig n uchar add 48 v
  n = add n 1
  i = ulong 0
  while lt i n bound 24
    tj_d_ch get dig sub sub n i 1
    i = add i 1
  end
end

fn tj_flush fd int to void
  n = get tj_dlen 0
  if gt n 0
    ign = write fd tj_dbuf 0 n
  end
  put tj_dlen 0 0
end

fn tj_check ok ulong id ulong to void
  put tj_checks 0 add get tj_checks 0 1
  if eq ok 0
    put tj_fails 0 add get tj_fails 0 1
    put tj_dlen 0 0
    tj_d_txt tj_s_bad
    tj_d_u64 id
    tj_d_ch 10
    tj_flush 2
  end
end

fn tj_check_eq a ulong b ulong id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tj_check ok id
end

fn tj_check_eq_l a long b long id ulong to void
  ok = ulong 0
  if eq a b
    ok = 1
  end
  tj_check ok id
end

fn tj_test_secrets to void
  tj_check_eq osh_secret_name tj_sec1 len tj_sec1 1 1
  tj_check_eq osh_secret_name tj_sec2 len tj_sec2 1 2
  tj_check_eq osh_secret_name tj_sec3 len tj_sec3 1 3
  tj_check_eq osh_secret_name tj_sec4 len tj_sec4 0 4
  tj_check_eq osh_secret_name tj_sec5 len tj_sec5 0 5
end

fn tj_test_hmac to void
  note RFC 4231 Test Case 2 (key="Jefe" zero-padded to 32B, verify deterministic & key-sensitive)
  k1 = new uchar 32 0
  k2 = new uchar 32 0
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  d3 = new uchar 32 0
  put k1 0 74
  put k1 1 101
  put k1 2 102
  put k1 3 101
  put k2 0 75
  osh_hmac_sha256 k1 tj_cmd_hi len tj_cmd_hi d1
  osh_hmac_sha256 k1 tj_cmd_hi len tj_cmd_hi d2
  osh_hmac_sha256 k2 tj_cmd_hi len tj_cmd_hi d3
  same = ulong 1
  diff = ulong 0
  i = ulong 0
  while lt i 32 bound 32
    if ne get d1 i get d2 i
      same = 0
    end
    if ne get d1 i get d3 i
      diff = 1
    end
    i = add i 1
  end
  tj_check same 10
  tj_check diff 11
end

fn tj_build_dir dst edit uchar 256 to ulong
  dig = new uchar 24 0
  pl = len tj_dir_pre
  i = ulong 0
  while lt i pl bound 64
    put dst i get tj_dir_pre i
    i = add i 1
  end
  pid = ulong getpid
  nd = ulong 0
  while ge pid 10 bound 24
    put dig nd uchar add 48 rem pid 10
    pid = div pid 10
    nd = add nd 1
  end
  put dig nd uchar add 48 pid
  nd = add nd 1
  i = ulong 0
  while lt i nd bound 24
    put dst add pl i get dig sub sub nd i 1
    i = add i 1
  end
  ret add pl nd
end

fn tj_join_suf base view uchar 256 bl ulong suf view uchar * dst edit uchar 256 to ulong
  i = ulong 0
  while lt i bl bound 256
    put dst i get base i
    i = add i 1
  end
  sl = len suf
  i = ulong 0
  while lt i sl bound 64
    put dst add bl i get suf i
    i = add i 1
  end
  ret add bl sl
end

fn tj_rb_decode to ulong
  rec = new ulong 1400 0
  obuf = new ulong 8192 0
  osh_rb_seal
  nrec = add OSH_REQ_HDR_CELLS mul get rb_ncmds 0 OSH_CMD_CELLS
  used = get rb_out_used 0
  i = ulong 0
  while lt i nrec bound 1400
    put rec i get rb_rec i
    i = add i 1
  end
  i = ulong 0
  while lt i used bound 8192
    put obuf i get rb_out i
    i = add i 1
  end
  ret osh_req_decode part rec 0 nrec nrec part obuf 0 used used
end

fn tj_test_recovery jpath view uchar 256 jl ulong kpath view uchar 256 kl ulong to void
  bad = new ulong 1 0
  tj_check_eq_l osh_journal_open jpath jl 0 26
  nrec = osh_journal_recover jpath jl bad
  tj_check_eq_l nrec 1 27
  tj_check_eq get bad 0 0 28
  nrec2 = osh_journal_recover jpath jl bad
  tj_check_eq_l nrec2 0 29
  osh_journal_close
  ign = unlink kpath 0 kl
  rc_mk = osh_journal_open jpath jl
  ok_mk = ulong 0
  if lt rc_mk 0
    ok_mk = 1
  end
  tj_check ok_mk 30
  ign = unlink jpath 0 jl
end

fn tj_test_lifecycle to void
  dir = new uchar 256 0
  jpath = new uchar 256 0
  kpath = new uchar 256 0
  dig = new uchar 32 0
  dl = tj_build_dir dir
  ign = makedir dir 0 dl 448
  jl = tj_join_suf dir dl tj_j_suf jpath
  kl = tj_join_suf dir dl tj_k_suf kpath
  tj_check_eq_l osh_journal_check_dir dir dl 0 20
  tj_check_eq_l osh_journal_open jpath jl 0 21
  osh_rb_init 0 OSH_CONN_SEMI
  osh_rb_cmd OSH_B_NONE
  osh_rb_arg tj_cmd_echo len tj_cmd_echo
  osh_rb_arg tj_cmd_hi len tj_cmd_hi
  tj_check_eq tj_rb_decode 0 22
  osh_req_digest dig
  r1 = osh_journal_intent dig 0
  tj_check_eq r1 1 23
  tj_check_eq_l osh_journal_write_one_outcome dig 0 r1 OSH_OUT_COMPLETED 0 0 24
  r2 = osh_journal_intent dig 0
  tj_check_eq r2 3 25
  osh_journal_close
  tj_test_recovery jpath jl kpath kl
end

fn main to int
  put tj_checks 0 0
  put tj_fails 0 0
  tj_test_secrets
  tj_test_hmac
  tj_test_lifecycle
  put tj_dlen 0 0
  tj_d_txt tj_s_chk
  tj_d_u64 get tj_checks 0
  tj_d_txt tj_s_fl
  tj_d_u64 get tj_fails 0
  tj_d_ch 10
  tj_flush 1
  if eq get tj_fails 0 0
    put tj_dlen 0 0
    tj_d_txt tj_s_pass
    tj_flush 1
    ret 0
  end
  put tj_dlen 0 0
  tj_d_txt tj_s_fail
  tj_flush 1
  ret 1
end

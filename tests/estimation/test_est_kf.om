  bs = new ulong 96 0
  ps = new ulong 176 0
  ot = new ulong 96 0
  post = new ulong 96 0xabababababababab
  sent_b = new ulong 96 0xabababababababab
  iv = new ulong 96 0
  chk_st est_kf_prior view ms view x0 view P0 0 bs EST_OK 921
  chk_st est_kf_predict view ms view bs 0 view bu 1 ps EST_OK 922
  put z 0 1.0f64
  mk_obs view ms view z view R bitcast long get ps EP_TNS 1 ot
  chk_st est_kf_update view ms view bs view ps view ot post iv EST_ERR_NOT_PD 923
  chk rec_eq view post view sent_b EST_BELIEF_LEN 924
  put P0 0 -1.0f64
  chk_st est_kf_prior view ms view x0 view P0 0 bs EST_ERR_NOT_PSD 925
  put P0 0 3.0f64
  put x0 0 est_nan
  chk_st est_kf_prior view ms view x0 view P0 0 bs EST_ERR_NONFINITE 926
end

fn test_refusals_stale m view ulong 280 b view ulong 96 p view ulong 176 o view ulong 96 post edit ulong 96 iv edit ulong 96 to void
  post_ok = new ulong 96 0
  iv_ok = new ulong 96 0
  other = new ulong 96 0
  pg = new ulong 176 0
  m2 = new ulong 280 0
  bu = new f64 8 0.0
  chk_st est_kf_update m b p o post_ok iv_ok EST_OK 902
  est_rec_copy b other EST_BELIEF_LEN
  put other EB_X bitcast ulong 1.5f64
  chk_st est_kf_update m view other p o post iv EST_ERR_STALE 903
  chk_st est_kf_coast m p view other post EST_ERR_STALE 904
  chk_st est_kf_update m view post_ok p o post iv EST_ERR_STALE 905
  est_rec_copy p pg EST_PRED_LEN
  put pg EP_GEN add get pg EP_GEN 1
  chk_st est_kf_update m b view pg o post iv EST_ERR_STALE 906
  mk_scalar_model 1.0f64 0.1f64 1.0f64 3.0f64 m2
  chk_st est_kf_update view m2 b p o post iv EST_ERR_MODEL 907
  chk_st est_kf_predict view m2 b 0 view bu 1 pg EST_ERR_MODEL 908
  chk_st est_kf_coast view m2 p b post EST_ERR_MODEL 909
end

fn test_refusals to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.1f64 1.0f64 2.0f64 m
  z = new f64 8 0.0
  put z 0 4.0f64
  R = new f64 64 0.0
  put R 0 2.0f64
  b = new ulong 96 0
  p = new ulong 176 0
  o = new ulong 96 0
  bu = new f64 8 0.0
  chk_st mk_scalar_prior view m 1.0f64 3.0f64 b EST_OK 900
  chk_st est_kf_predict view m view b 0 view bu 1 p EST_OK 901
  mk_obs view m view z view R bitcast long get p EP_TNS 1 o
  post = new ulong 96 0xabababababababab
  sent_b = new ulong 96 0xabababababababab
  iv = new ulong 96 0xcdcdcdcdcdcdcdcd
  sent_i = new ulong 96 0xcdcdcdcdcdcdcdcd
  test_refusals_stale view m view b view p view o post iv
  test_refusals_obs view m view b view p view o post iv
  chk rec_eq view post view sent_b EST_BELIEF_LEN 920
  chk rec_eq view iv view sent_i EST_INNOV_LEN 920
  test_refusals_singular
end

note ---- 13. Long run (10000 1D + 3000 2D) ----

fn test_long_run_1d to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0f64 m
  b = new ulong 96 0
  iv = new ulong 96 0
  z = new f64 8 0.0
  R = new f64 64 0.0
  chk_st mk_scalar_prior view m 0.0f64 10.0f64 b EST_OK 1000
  info = div 1.0f64 10.0f64
  ok = true
  for k0 ulong 10000 bound 10002
    rv = rdbl 1.0e8f64 1.0e9f64
    if ne and rng_next 1 0
      rv = rdbl 1.0e-9f64 1.0e-8f64
    end
    put R 0 rv
    put z 0 rdbl -1.0f64 1.0f64
    info = add info div 1.0f64 rv
    if ne kf_step view m b view z view R add k0 1 iv EST_OK
      ok = false
      break
    end
    pv = bitcast f64 get b EB_P
    if not gt pv 0.0f64
      ok = false
      break
    end
    if not est_isfinite pv
      ok = false
      break
    end
    if not est_isfinite bitcast f64 get b EB_X
      ok = false
      break
    end
  end
  chk ok 1001
  chk_near bitcast f64 get b EB_P div 1.0f64 info 1.0e-7f64 1002
  chk eq get b EB_GEN 20000 1003
end

fn mk_2d_prior m view ulong 280 b edit ulong 96 to long
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put P0 0 1.0f64
  put P0 3 1.0f64
  ret est_kf_prior m view x0 view P0 0 b
end

fn test_long_run_2d to void
  m2 = new ulong 280 0
  put m2 EM_N 2
  put m2 EM_M 1
  put m2 EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put m2 EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put m2 EM_SUNIT EST_UNIT_MILLI_CELSIUS
  put m2 add EM_SUNIT 1 EST_UNIT_MILLI_CELSIUS_PER_S
  put m2 EM_OUNIT EST_UNIT_MILLI_CELSIUS
  put m2 EM_F bitcast ulong 1.0f64
  put m2 add EM_F 1 bitcast ulong 1.0f64
  put m2 add EM_F 3 bitcast ulong 1.0f64
  put m2 EM_H bitcast ulong 1.0f64
  put m2 EM_Q bitcast ulong 1.0e-6f64
  put m2 add EM_Q 3 bitcast ulong 1.0e-6f64
  put m2 EM_R bitcast ulong 1.0f64
  put m2 EM_STEP bitcast ulong NS
  b = new ulong 96 0
  iv = new ulong 96 0
  z = new f64 8 0.0
  R = new f64 64 0.0
  chk_st mk_2d_prior view m2 b EST_OK 1004
  ok = true
  for k0 ulong 3000 bound 3005
    rv = rdbl 1.0e8f64 1.0e9f64
    if ne and rng_next 1 0
      rv = rdbl 1.0e-9f64 1.0e-8f64
    end
    put R 0 rv
    put z 0 rdbl -1.0f64 1.0f64
    if ne kf_step view m2 b view z view R add k0 1 iv EST_OK
      ok = false
      break
    end
    if ne est_check_cov_rec view b EB_P 2 EST_OK
      ok = false
      break
    end
    if ne get b add EB_P 1 get b add EB_P 2
      ok = false
      break
    end
  end
  chk ok 1005
  p00 = bitcast f64 get b EB_P
  chk gt p00 0.0f64 1006
  chk lt p00 1.0e-3f64 1006
end

fn test_long_run to void
  test_long_run_1d
  test_long_run_2d
end

note ---- 14, 15, 16, 17, 18: forged pred, control input, evidence, coast, model refusals ----

fn chk_forged_case m view ulong 280 b view ulong 96 f view ulong 176 o view ulong 96 want long to void
  of = new ulong 96 0
  est_rec_copy o of EST_OBS_LEN
  put of EO_TNS get f EP_TNS
  outb = new ulong 96 0xabababababababab
  iv = new ulong 96 0
  chk_st est_kf_update m b f view of outb iv want 1110
  chk_st est_kf_coast m f b outb want 1111
  chk eq get outb 0 0xabababababababab 1112
end

fn test_forged_roundtrip m view ulong 280 b view ulong 96 p view ulong 176 o view ulong 96 to void
  buf = new uchar 2304 0
  el = new ulong 1 0
  d = new ulong 176 0
  post = new ulong 96 0
  iv = new ulong 96 0
  bu = new f64 8 0.0
  chk_st est_encode_prediction p buf el EST_OK 1120
  chk_st est_decode_prediction view buf get el 0 d EST_OK 1121
  chk_st est_kf_update m b view d o post iv EST_OK 1122
  chk_st est_kf_predict m b 0 view bu add EST_MAX_HORIZON 1 d EST_ERR_TIME 1123
end

fn test_forged_prediction to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.1f64 1.0f64 2.0f64 m
  x0 = new f64 8 0.0
  put x0 0 1.0f64
  P0 = new f64 64 0.0
  put P0 0 3.0f64
  z = new f64 8 0.0
  put z 0 4.0f64
  R = new f64 64 0.0
  put R 0 2.0f64
  b = new ulong 96 0
  p = new ulong 176 0
  f = new ulong 176 0
  o = new ulong 96 0
  bu = new f64 8 0.0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 1100
  chk_st est_kf_predict view m view b 0 view bu 1 p EST_OK 1101
  mk_obs view m view z view R bitcast long get p EP_TNS 1 o
  for c ulong 11
    est_rec_copy view p f EST_PRED_LEN
    want = EST_ERR_STALE
    if eq c 0
      put f EP_X bitcast ulong 42.0f64
    end
    if eq c 1
      put f EP_X bitcast ulong est_nextafter_up bitcast f64 get f EP_X
    end
    if eq c 2
      put f EP_P bitcast ulong 1.0e-30f64
    end
    if eq c 3
      put f EP_YM bitcast ulong -1.0e9f64
    end
    if eq c 4
      put f EP_S bitcast ulong 7.0f64
    end
    if eq c 5
      put f EP_HZ 2
    end
    if eq c 6
      put f EP_TNS bitcast ulong long -77
    end
    if eq c 7
      put f EP_TNS bitcast ulong add bitcast long get f EP_TNS 1
    end
    if eq c 8
      put f EP_GEN add get f EP_GEN 1
    end
    if eq c 9
      put f EP_PRIOR xor get f EP_PRIOR 1
    end
    if eq c 10
      put f EP_MDL xor get f EP_MDL 1
      want = EST_ERR_MODEL
    end
    chk_forged_case view m view b view f view o want
  end
  test_forged_roundtrip view m view b view p view o
end

fn copy_dig4 src view ulong 96 soff ulong dst edit ulong 96 doff ulong to void
  for w ulong 4
    put dst add doff w get src add soff w
  end
end

fn test_coast_root m view ulong 280 b edit ulong 96 to void
  z = new f64 8 0.0
  put z 0 4.0f64
  R = new f64 64 0.0
  put R 0 2.0f64
  iv = new ulong 96 0
  root = new uchar 32 0
  dig = new uchar 32 0
  est_rec_get_dig view b EB_ROOT root
  chk not est_digest_is_zero view root 1231
  for k ulong 3
    chk_st kf_coast_step m b 1 EST_OK 1232
    est_rec_get_dig view b EB_ROOT dig
    chk est_digest_eq view dig view root 1233
  end
  chk_st kf_step m b view z view R 2 iv EST_OK 1234
  est_rec_get_dig view b EB_ROOT dig
  chk not est_digest_eq view dig view root 1235
end

fn test_evidence_and_coast m view ulong 280 b edit ulong 96 to void
  z = new f64 8 0.0
  put z 0 4.0f64
  R = new f64 64 0.0
  put R 0 2.0f64
  bu = new f64 8 0.0
  iv = new ulong 96 0
  chk_st kf_step m b view z view R 1 iv EST_OK 1220
  p = new ulong 176 0
  chk_st est_kf_predict m view b 0 view bu 1 p EST_OK 1221
  o = new ulong 96 0
  mk_obs m view z view R bitcast long get p EP_TNS 7 o
  post = new ulong 96 0
  chk_st est_kf_update m view b view p view o post iv EST_OK 1222
  dig = new uchar 32 0
  bad = new ulong 96 0
  est_rec_copy view o bad EST_OBS_LEN
  chk_st est_digest_prediction view p dig EST_OK 1223
  est_rec_put_dig bad EO_EV view dig
  chk_st est_kf_update m view b view p view bad post iv EST_ERR_KIND 1226
  chk_st est_digest_belief view b dig EST_OK 1224
  est_rec_put_dig bad EO_EV view dig
  chk_st est_kf_update m view b view p view bad post iv EST_ERR_KIND 1227
  chk_st est_digest_model m dig EST_OK 1225
  est_rec_put_dig bad EO_EV view dig
  chk_st est_kf_update m view b view p view bad post iv EST_ERR_KIND 1228
  copy_dig4 view b EB_PAR bad EO_EV
  chk_st est_kf_update m view b view p view bad post iv EST_ERR_KIND 1229
  copy_dig4 view b EB_ROOT bad EO_EV
  chk_st est_kf_update m view b view p view bad post iv EST_ERR_KIND 1230
  test_coast_root m b
end

fn test_control_and_evidence to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.1f64 1.0f64 2.0f64 m
  x0 = new f64 8 0.0
  put x0 0 1.0f64
  P0 = new f64 64 0.0
  put P0 0 3.0f64
  b = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 1200
  p0 = new ulong 176 0
  pu = new ulong 176 0
  pz = new ulong 176 0
  pn = new ulong 176 0
  bu = new f64 8 0.0
  chk_st est_kf_predict view m view b 0 view bu 1 p0 EST_OK 1201
  put bu 0 0.5f64
  chk_st est_kf_predict view m view b 1 view bu 1 pu EST_OK 1202
  put bu 0 0.0f64
  chk_st est_kf_predict view m view b 1 view bu 1 pz EST_OK 1203
  put bu 0 est_neg_zero
  chk_st est_kf_predict view m view b 1 view bu 1 pn EST_OK 1204
  chk_near bitcast f64 get pu EP_X 1.5f64 1.0e-15f64 1205
  d0 = new uchar 32 0
  du = new uchar 32 0
  dz = new uchar 32 0
  dn = new uchar 32 0
  chk_st est_digest_prediction view p0 d0 EST_OK 1206
  chk_st est_digest_prediction view pu du EST_OK 1207
  chk_st est_digest_prediction view pz dz EST_OK 1208
  chk_st est_digest_prediction view pn dn EST_OK 1209
  chk not est_digest_eq view d0 view du 1210
  chk not est_digest_eq view d0 view dz 1211
  chk not est_digest_eq view du view dz 1212
  chk est_digest_eq view dn view dz 1213
  test_evidence_and_coast view m b
  m0 = new ulong 280 0
  mk_scalar_model 1.0f64 0.1f64 1.0f64 0.0f64 m0
  chk_st est_kf_prior view m0 view x0 view P0 0 b EST_ERR_NOT_PD 1236
end

fn main to int
  put g_rng 0 0x1234567887654321
  test_constant_position
  test_constant_velocity
  test_noisy_position
  test_position_and_velocity
  test_riccati_and_regimes
  test_coast
  test_repeated_extremes_growth
  test_linkage_and_determinism
  test_refusals
  test_long_run
  test_forged_prediction
  test_control_and_evidence
  est_puts K_PREFIX
  est_putu get g_checks 0
  est_puts K_CHECKS
  est_putu get g_fail 0
  est_puts K_FAILED
  if gt get g_fail 0 0
    est_puts K_FAIL
    ret 1
  end
  est_puts K_PASS
  ret 0
end

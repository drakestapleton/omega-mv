note SPDX-License-Identifier: Apache-2.0
note EST-1 linear Kalman filter tests in pure seeded OM-2 (port of tests/estimation/test_est_kf.c).

global g_checks ulong 1
global g_fail ulong 1
global g_rng ulong 1

const NS long 1000000000

text K_PREFIX "test_est_kf: "
text K_CHECKS " checks, "
text K_FAILED " failed\n"
text K_PASS "test_est_kf: PASS\n"
text K_FAIL "test_est_kf: FAIL\n"
text K_FTAG "FAIL tag="
text K_NL "\n"

fn chk cond bool tag ulong to void
  put g_checks 0 add get g_checks 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
    est_eputs K_FTAG
    est_putu_fd 2 tag
    est_eputs K_NL
  end
end

fn chk_st got long want long tag ulong to void
  chk eq got want tag
end

fn chk_near a f64 b f64 rel f64 tag ulong to void
  scale = fmax fabs b 1.0e-300f64
  chk le fabs sub a b mul rel scale tag
end

fn chk_nearabs a f64 b f64 ab f64 tag ulong to void
  chk le fabs sub a b ab tag
end

fn rng_next to ulong
  x = get g_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_rng 0 x
  ret mul x 0x2545f4914f6cdd1d
end

fn rdbl lo f64 hi f64 to f64
  u = div f64 shr rng_next 11 9007199254740992.0f64
  ret add lo mul sub hi lo u
end

fn mk_scalar_model F f64 Q f64 H f64 R f64 dst edit ulong 280 to void
  for i ulong EST_MODEL_LEN
    put dst i 0
  end
  put dst EM_N 1
  put dst EM_M 1
  put dst EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put dst EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put dst EM_SUNIT EST_UNIT_MILLI_CELSIUS
  put dst EM_OUNIT EST_UNIT_MILLI_CELSIUS
  put dst EM_F bitcast ulong F
  put dst EM_Q bitcast ulong Q
  put dst EM_H bitcast ulong H
  put dst EM_R bitcast ulong R
  put dst EM_STEP bitcast ulong NS
end

fn mk_obs mdl view ulong 280 z view f64 8 R view f64 64 t_ns long seq ulong dst edit ulong 96 to void
  for i ulong EST_OBS_LEN
    put dst i 0
  end
  m = get mdl EM_M
  put dst EO_M m
  for i ulong m
    put dst add EO_UNIT i get mdl add EM_OUNIT i
    put dst add EO_Z i bitcast ulong get z i
  end
  for i ulong mul m m
    put dst add EO_R i bitcast ulong get R i
  end
  put dst EO_TNS bitcast ulong t_ns
  put dst EO_SEQ seq
  put dst EO_SRC 0x5a
  ev = or and or seq 1 0xff shl and shr seq 8 0xff 8
  put dst EO_EV ev
end

fn kf_step mdl view ulong 280 b edit ulong 96 z view f64 8 R view f64 64 seq ulong iv edit ulong 96 to long
  p = new ulong 176 0
  bu = new f64 8 0.0
  st = est_kf_predict mdl view b 0 view bu 1 p
  if ne st EST_OK
    ret st
  end
  o = new ulong 96 0
  mk_obs mdl z R bitcast long get p EP_TNS seq o
  post = new ulong 96 0
  st = est_kf_update mdl view b view p view o post iv
  if ne st EST_OK
    ret st
  end
  est_rec_copy view post b EST_BELIEF_LEN
  ret EST_OK
end

fn kf_coast_step mdl view ulong 280 b edit ulong 96 horizon ulong to long
  p = new ulong 176 0
  bu = new f64 8 0.0
  st = est_kf_predict mdl view b 0 view bu horizon p
  if ne st EST_OK
    ret st
  end
  post = new ulong 96 0
  st = est_kf_coast mdl view p view b post
  if ne st EST_OK
    ret st
  end
  est_rec_copy view post b EST_BELIEF_LEN
  ret EST_OK
end

fn rec_eq a view ulong * b view ulong * n ulong to bool
  for i ulong n
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

note ---- 1. Constant position ----

fn test_constant_position to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.0f64 1.0f64 4.0f64 m
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put P0 0 100.0f64
  z = new f64 8 0.0
  put z 0 10.0f64
  R = new f64 64 0.0
  put R 0 4.0f64
  b = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 100
  chk eq get b EB_GEN 0 101
  chk est_rec_dig_is_zero view b EB_PAR 102
  chk est_rec_dig_is_zero view b EB_ROOT 103
  for k0 ulong 20
    k = add k0 1
    chk_st kf_step view m b view z view R k iv EST_OK 104
    Pk = div 1.0f64 add 0.01f64 div f64 k 4.0f64
    chk_near bitcast f64 get b EB_P Pk 1.0e-12f64 105
    chk_near bitcast f64 get b EB_X mul mul Pk 2.5f64 f64 k 1.0e-12f64 106
    chk eq get b EB_GEN mul 2 k 107
    chk eq bitcast long get b EB_TNS mul long k NS 108
  end
end

note ---- 2. Constant velocity ----

fn test_constant_velocity to void
  m = new ulong 280 0
  put m EM_N 2
  put m EM_M 1
  put m EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put m EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put m EM_SUNIT EST_UNIT_MILLI_CELSIUS
  put m add EM_SUNIT 1 EST_UNIT_MILLI_CELSIUS_PER_S
  put m EM_OUNIT EST_UNIT_MILLI_CELSIUS
  put m EM_F bitcast ulong 1.0f64
  put m add EM_F 1 bitcast ulong 1.0f64
  put m add EM_F 3 bitcast ulong 1.0f64
  put m EM_H bitcast ulong 1.0f64
  put m EM_R bitcast ulong 1.0f64
  put m EM_STEP bitcast ulong NS
  x0 = new f64 8 0.0
  put x0 1 1.0f64
  P0 = new f64 64 0.0
  put P0 0 1.0f64
  put P0 3 1.0f64
  b = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 200
  p = new ulong 176 0
  bu = new f64 8 0.0
  chk_st est_kf_predict view m view b 0 view bu 1 p EST_OK 201
  chk_near bitcast f64 get p EP_X 1.0f64 1.0e-14f64 202
  chk_near bitcast f64 get p add EP_X 1 1.0f64 1.0e-14f64 203
  chk_near bitcast f64 get p EP_P 2.0f64 1.0e-14f64 204
  chk_near bitcast f64 get p add EP_P 1 1.0f64 1.0e-14f64 205
  chk_near bitcast f64 get p add EP_P 3 1.0f64 1.0e-14f64 206
  chk_near bitcast f64 get p EP_YM 1.0f64 1.0e-14f64 207
  chk_near bitcast f64 get p EP_S 3.0f64 1.0e-14f64 208
  z = new f64 8 0.0
  put z 0 1.5f64
  R = new f64 64 0.0
  put R 0 1.0f64
  o = new ulong 96 0
  mk_obs view m view z view R bitcast long get p EP_TNS 1 o
  post = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_update view m view b view p view o post iv EST_OK 209
  chk_near bitcast f64 get post EB_X div 4.0f64 3.0f64 1.0e-13f64 210
  chk_near bitcast f64 get post add EB_X 1 div 7.0f64 6.0f64 1.0e-13f64 211
  chk_near bitcast f64 get post EB_P div 2.0f64 3.0f64 1.0e-13f64 212
  chk_near bitcast f64 get post add EB_P 1 div 1.0f64 3.0f64 1.0e-13f64 213
  chk_near bitcast f64 get post add EB_P 3 div 2.0f64 3.0f64 1.0e-13f64 214
  chk_near bitcast f64 get iv EI_NU 0.5f64 1.0e-14f64 215
  chk_near bitcast f64 get iv EI_S 3.0f64 1.0e-14f64 216
  chk_near bitcast f64 get iv EI_NIS div 0.25f64 3.0f64 1.0e-13f64 217
  chk_st kf_step view m post view z view R 2 iv EST_OK 218
  chk_st est_check_cov_rec view post EB_P 2 EST_OK 219
end

note ---- 3. Noisy position ----

fn test_noisy_position to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0f64 m
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put P0 0 1.0f64
  R = new f64 64 0.0
  put R 0 1.0f64
  z = new f64 8 0.0
  b = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 300
  put z 0 2.0f64
  chk_st kf_step view m b view z view R 1 iv EST_OK 301
  chk_near bitcast f64 get b EB_X 1.0f64 1.0e-14f64 302
  chk_near bitcast f64 get b EB_P 0.5f64 1.0e-14f64 303
  chk_near bitcast f64 get iv EI_NU 2.0f64 1.0e-14f64 304
  chk_near bitcast f64 get iv EI_S 2.0f64 1.0e-14f64 305
  chk_near bitcast f64 get iv EI_NIS 2.0f64 1.0e-14f64 306
  put z 0 4.0f64
  chk_st kf_step view m b view z view R 2 iv EST_OK 307
  chk_near bitcast f64 get b EB_X 2.0f64 1.0e-14f64 308
  chk_near bitcast f64 get b EB_P div 1.0f64 3.0f64 1.0e-14f64 309
  chk_near bitcast f64 get iv EI_NU 3.0f64 1.0e-14f64 310
  chk_near bitcast f64 get iv EI_S 1.5f64 1.0e-14f64 311
  chk_near bitcast f64 get iv EI_NIS 6.0f64 1.0e-14f64 312
end


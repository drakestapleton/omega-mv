note ---- 5. Riccati steady state and regimes ----

fn steady_gain Q f64 R f64 out_p edit f64 1 to f64
  m = new ulong 280 0
  mk_scalar_model 1.0f64 Q 1.0f64 R m
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put P0 0 1.0f64
  z = new f64 8 0.0
  Rm = new f64 64 0.0
  put Rm 0 R
  b = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 500
  for k0 ulong 4000
    st = kf_step view m b view z view Rm add k0 1 iv
    if ne st EST_OK
      chk false 501
      ret 0.0f64
    end
  end
  s0 = bitcast f64 get iv EI_S
  put out_p 0 sub s0 R
  ret div sub s0 R s0
end

fn test_riccati_and_regimes to void
  Qs = new f64 5 0.0
  put Qs 0 1.0e-3f64
  put Qs 1 1.0e-2f64
  put Qs 2 1.0e-1f64
  put Qs 3 1.0f64
  put Qs 4 10.0f64
  Ps = new f64 5 0.0
  prevK = f64 -1.0
  outp = new f64 1 0.0
  for i ulong 5
    qv = get Qs i
    K = steady_gain qv 1.0f64 outp
    put Ps i get outp 0
    Pstar = mul 0.5f64 add qv fsqrt add mul qv qv mul 4.0f64 qv
    chk_near get outp 0 Pstar 1.0e-9f64 510
    chk_near K div Pstar add Pstar 1.0f64 1.0e-9f64 511
    chk gt K prevK 512
    prevK = K
  end
  chk lt get Ps 0 get Ps 1 513
  chk lt get Ps 1 get Ps 2 514
  chk lt get Ps 2 get Ps 3 515
  chk lt get Ps 3 get Ps 4 516
  Rs = new f64 3 0.0
  put Rs 0 1.0e-2f64
  put Rs 1 1.0f64
  put Rs 2 1.0e2f64
  prev = f64 2.0
  for i ulong 3
    rv = get Rs i
    K = steady_gain 1.0f64 rv outp
    Pstar = mul 0.5f64 add 1.0f64 fsqrt add 1.0f64 mul 4.0f64 rv
    chk_near get outp 0 Pstar 1.0e-9f64 517
    chk_near K div Pstar add Pstar rv 1.0e-9f64 518
    chk lt K prev 519
    prev = K
  end
end

note ---- 6. Coast ----

fn test_coast to void
  m = new ulong 280 0
  put m EM_N 2
  put m EM_M 1
  put m EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put m EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put m EM_SUNIT EST_UNIT_MILLI_CELSIUS
  put m add EM_SUNIT 1 EST_UNIT_MILLI_CELSIUS_PER_S
  put m EM_OUNIT EST_UNIT_MILLI_CELSIUS
  put m EM_F bitcast ulong 1.0f64
  put m add EM_F 1 bitcast ulong 1.0f64
  put m add EM_F 3 bitcast ulong 1.0f64
  put m EM_H bitcast ulong 1.0f64
  put m EM_Q bitcast ulong 0.1f64
  put m add EM_Q 3 bitcast ulong 0.2f64
  put m EM_R bitcast ulong 1.0f64
  put m EM_STEP bitcast ulong NS
  x0 = new f64 8 0.0
  put x0 1 1.0f64
  P0 = new f64 64 0.0
  put P0 0 1.0f64
  put P0 3 2.0f64
  want = new f64 12 0.0
  put want 0 3.1f64
  put want 1 2.0f64
  put want 2 2.0f64
  put want 3 2.2f64
  put want 4 9.4f64
  put want 5 4.2f64
  put want 6 4.2f64
  put want 7 2.4f64
  put want 8 20.3f64
  put want 9 6.6f64
  put want 10 6.6f64
  put want 11 2.6f64
  b = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 600
  for k0 ulong 3
    k = add k0 1
    chk_st kf_coast_step view m b 1 EST_OK 601
    for i ulong 4
      chk_near bitcast f64 get b add EB_P i get want add mul k0 4 i 1.0e-13f64 602
    end
    chk_near bitcast f64 get b EB_X f64 k 1.0e-13f64 603
    chk_near bitcast f64 get b add EB_X 1 1.0f64 1.0e-13f64 604
    chk eq get b EB_GEN mul 2 k 605
    chk est_rec_dig_is_zero view b EB_ROOT 606
    chk eq bitcast long get b EB_TNS mul long k NS 607
  end
  b0 = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b0 EST_OK 608
  p = new ulong 176 0
  bu = new f64 8 0.0
  chk_st est_kf_predict view m view b0 0 view bu 3 p EST_OK 609
  for i ulong 4
    chk_near bitcast f64 get p add EP_P i get want add 8 i 1.0e-13f64 610
  end
  chk eq get p EP_HZ 3 611
  chk eq get p EP_GEN 1 611
  chk eq bitcast long get p EP_TNS mul 3 NS 611
  chk_near bitcast f64 get p EP_YM 3.0f64 1.0e-13f64 612
  chk_near bitcast f64 get p EP_S 21.3f64 1.0e-13f64 613
  put bu 1 0.5f64
  chk_st est_kf_predict view m view b0 1 view bu 1 p EST_OK 614
  chk_near bitcast f64 get p EP_X 1.0f64 1.0e-14f64 615
  chk_near bitcast f64 get p add EP_X 1 1.5f64 1.0e-14f64 616
end

note ---- 7, 8, 9: repeated identical, sensor extremes, growth ----

fn test_repeated_extremes_growth to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0f64 m
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put P0 0 1.0e6f64
  z = new f64 8 0.0
  put z 0 5.0f64
  R = new f64 64 0.0
  put R 0 1.0f64
  b = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 700
  for k0 ulong 100
    k = add k0 1
    chk_st kf_step view m b view z view R k iv EST_OK 701
    Pk = div 1.0f64 add 1.0e-6f64 f64 k
    chk_near bitcast f64 get b EB_P Pk 1.0e-10f64 702
    chk_near bitcast f64 get b EB_X mul Pk mul 5.0f64 f64 k 1.0e-10f64 703
  end
  chk_nearabs bitcast f64 get b EB_X 5.0f64 1.0e-3f64 704

  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0e-12f64 m
  put P0 0 1.0f64
  put z 0 7.0f64
  put R 0 1.0e-12f64
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 710
  chk_st kf_step view m b view z view R 1 iv EST_OK 711
  chk_nearabs bitcast f64 get b EB_X 7.0f64 1.0e-9f64 712
  chk_near bitcast f64 get b EB_P div 1.0f64 add 1.0f64 1.0e12f64 1.0e-9f64 713

  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0e12f64 m
  put R 0 1.0e12f64
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 714
  chk_st kf_step view m b view z view R 1 iv EST_OK 715
  chk_nearabs bitcast f64 get b EB_X div 7.0f64 add 1.0f64 1.0e12f64 1.0e-15f64 716
  chk_near bitcast f64 get b EB_P div 1.0f64 add 1.0f64 1.0e-12f64 1.0e-12f64 717

  mk_scalar_model 1.0f64 0.0f64 1.0f64 1.0f64 m
  put P0 0 1.0e8f64
  put R 0 1.0f64
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 718
  chk_st kf_step view m b view z view R 1 iv EST_OK 719
  chk_near bitcast f64 get b EB_P div 1.0f64 add 1.0e-8f64 1.0f64 1.0e-9f64 720

  mk_scalar_model 1.0f64 0.5f64 1.0f64 1.0f64 m
  put P0 0 1.0f64
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 721
  prev = f64 1.0
  for k0 ulong 50
    k = add k0 1
    chk_st kf_coast_step view m b 1 EST_OK 722
    pv = bitcast f64 get b EB_P
    chk_near pv add 1.0f64 mul 0.5f64 f64 k 1.0e-12f64 723
    chk gt pv prev 724
    prev = pv
  end
  mk_scalar_model 1.1f64 0.5f64 1.0f64 1.0f64 m
  chk_st est_kf_prior view m view x0 view P0 0 b EST_OK 725
  for k0 ulong 10
    chk_st kf_coast_step view m b 1 EST_OK 726
  end
  gv = est_powu 1.21f64 10
  chk_near bitcast f64 get b EB_P add gv div mul 0.5f64 sub gv 1.0f64 0.21f64 1.0e-11f64 727
end

note ---- 10 & 11: linkage, determinism & const ----

fn mk_scalar_prior m view ulong 280 x f64 P f64 b edit ulong 96 to long
  x0 = new f64 8 0.0
  P0 = new f64 64 0.0
  put x0 0 x
  put P0 0 P
  ret est_kf_prior m view x0 view P0 0 b
end

fn test_linkage_check_dig m view ulong 280 b view ulong 96 p view ulong 176 o view ulong 96 post view ulong 96 to void
  pd = new uchar 32 0
  od = new uchar 32 0
  root = new uchar 32 0
  er0 = new uchar 32 0
  tmp = new uchar 32 0
  chk_st est_digest_model m pd EST_OK 801
  est_rec_get_dig b EB_MDL tmp
  chk est_digest_eq view pd view tmp 802
  chk_st est_digest_prediction p pd EST_OK 809
  chk_st est_digest_observation o od EST_OK 810
  chk_st est_evidence_root_extend view er0 view od root EST_OK 811
  est_rec_get_dig post EB_PAR tmp
  chk est_digest_eq view tmp view pd 812
  est_rec_get_dig post EB_ROOT tmp
  chk est_digest_eq view tmp view root 813
  c = new ulong 96 0
  chk_st est_kf_coast m p b c EST_OK 819
  est_rec_get_dig view c EB_PAR tmp
  chk est_digest_eq view tmp view pd 820
  chk est_rec_dig_is_zero view c EB_ROOT 821
  chk eq get c EB_GEN add get p EP_GEN 1 822
end

fn test_linkage_and_determinism to void
  m = new ulong 280 0
  mk_scalar_model 1.0f64 0.1f64 1.0f64 2.0f64 m
  z = new f64 8 0.0
  put z 0 4.0f64
  R = new f64 64 0.0
  put R 0 2.0f64
  b = new ulong 96 0
  chk_st mk_scalar_prior view m 1.0f64 3.0f64 b EST_OK 800
  p = new ulong 176 0
  p2 = new ulong 176 0
  bu = new f64 8 0.0
  chk_st est_kf_predict view m view b 0 view bu 2 p EST_OK 803
  chk_st est_kf_predict view m view b 0 view bu 2 p2 EST_OK 804
  chk rec_eq view p view p2 EST_PRED_LEN 805
  chk_near bitcast f64 get p EP_P 3.2f64 1.0e-14f64 806
  chk_near bitcast f64 get p EP_S 5.2f64 1.0e-14f64 807
  o = new ulong 96 0
  mk_obs view m view z view R bitcast long get p EP_TNS 9 o
  post = new ulong 96 0
  iv = new ulong 96 0
  chk_st est_kf_update view m view b view p view o post iv EST_OK 808
  chk_near bitcast f64 get iv EI_NU 3.0f64 1.0e-14f64 814
  chk_near bitcast f64 get iv EI_S 5.2f64 1.0e-14f64 815
  chk_near bitcast f64 get iv EI_NIS div 9.0f64 5.2f64 1.0e-13f64 816
  chk_near bitcast f64 get post EB_X add 1.0f64 mul div 3.2f64 5.2f64 3.0f64 1.0e-13f64 817
  chk_near bitcast f64 get post EB_P div mul 3.2f64 2.0f64 5.2f64 1.0e-13f64 818
  test_linkage_check_dig view m view b view p view o view post
end

note ---- 12. Refusals ----

fn test_refusals_obs m view ulong 280 b view ulong 96 p view ulong 176 o view ulong 96 post edit ulong 96 iv edit ulong 96 to void
  ot = new ulong 96 0
  bu = new f64 8 0.0
  pg = new ulong 176 0
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_TNS bitcast ulong add bitcast long get o EO_TNS 1
  chk_st est_kf_update m b p view ot post iv EST_ERR_TIME 910
  put ot EO_TNS bitcast ulong sub bitcast long get o EO_TNS 1
  chk_st est_kf_update m b p view ot post iv EST_ERR_TIME 911
  chk_st est_kf_predict m b 0 view bu 0 pg EST_ERR_TIME 912
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_UNIT EST_UNIT_WATT
  chk_st est_kf_update m b p view ot post iv EST_ERR_UNIT 913
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_M 2
  put ot add EO_UNIT 1 EST_UNIT_WATT
  put ot add EO_R 3 bitcast ulong 1.0f64
  chk_st est_kf_update m b p view ot post iv EST_ERR_DIM 914
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_Z bitcast ulong est_nan
  chk_st est_kf_update m b p view ot post iv EST_ERR_NONFINITE 915
  put ot EO_Z bitcast ulong est_inf
  chk_st est_kf_update m b p view ot post iv EST_ERR_NONFINITE 916
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_R bitcast ulong est_nan
  chk_st est_kf_update m b p view ot post iv EST_ERR_NONFINITE 917
  est_rec_copy o ot EST_OBS_LEN
  put ot EO_EV 0
  chk_st est_kf_update m b p view ot post iv EST_ERR_KIND 918
  put bu 0 est_nan
  chk_st est_kf_predict m b 1 view bu 1 pg EST_ERR_NONFINITE 919
end

fn test_refusals_singular to void
  ms = new ulong 280 0

note SPDX-License-Identifier: Apache-2.0
note EST-0 contract tests in pure seeded OM-2 (port of tests/estimation/test_est_types.c).

global g_checks ulong 1
global g_fail ulong 1
global g_rng ulong 1

text T_PREFIX "test_est_types: "
text T_CHECKS " checks, "
text T_FAILED " failed\n"
text T_PASS "test_est_types: PASS\n"
text T_FAIL "test_est_types: FAIL\n"
text T_FAIL_TAG "FAIL tag="
text T_NL "\n"

fn chk cond bool tag ulong to void
  put g_checks 0 add get g_checks 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
    est_eputs T_FAIL_TAG
    est_putu_fd 2 tag
    est_eputs T_NL
  end
end

fn chk_st got long want long tag ulong to void
  chk eq got want tag
end

fn rng_next to ulong
  x = get g_rng 0
  x = xor x shr x 12
  x = xor x shl x 25
  x = xor x shr x 27
  put g_rng 0 x
  ret mul x 0x2545f4914f6cdd1d
end

fn rdbl lo f64 hi f64 to f64
  u = div f64 shr rng_next 11 9007199254740992.0f64
  ret add lo mul sub hi lo u
end

fn rdim to ulong
  ret add 1 rem rng_next EST_MAX_DIM
end

fn runit to ulong
  ret add 1 rem rng_next 8
end

fn rdig rec edit ulong * off ulong to void
  for w ulong 4
    put rec add off w rng_next
  end
end

fn gen_cov rec edit ulong * off ulong n ulong to void
  for i ulong 64
    put rec add off i 0
  end
  for i ulong n
    put rec add off add mul i n i bitcast ulong rdbl 1.0f64 2.0f64
    for j ulong i
      v = bitcast ulong rdbl -0.05f64 0.05f64
      put rec add off add mul i n j v
      put rec add off add mul j n i v
    end
  end
end

fn gen_model o edit ulong 280 to void
  for i ulong EST_MODEL_LEN
    put o i 0
  end
  n = rdim
  m = rdim
  put o EM_N n
  put o EM_M m
  put o EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put o EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  for i ulong n
    put o add EM_SUNIT i runit
  end
  for i ulong m
    put o add EM_OUNIT i runit
  end
  for i ulong mul n n
    put o add EM_F i bitcast ulong rdbl -2.0f64 2.0f64
  end
  for i ulong mul m n
    put o add EM_H i bitcast ulong rdbl -2.0f64 2.0f64
  end
  gen_cov o EM_Q n
  gen_cov o EM_R m
  put o EM_STEP bitcast ulong add 1 long rem rng_next 1000000000
end

fn gen_obs o edit ulong 96 to void
  for i ulong EST_OBS_LEN
    put o i 0
  end
  m = rdim
  put o EO_M m
  for i ulong m
    put o add EO_UNIT i runit
    put o add EO_Z i bitcast ulong rdbl -100.0f64 100.0f64
  end
  gen_cov o EO_R m
  put o EO_TNS shr rng_next 2
  put o EO_SEQ rng_next
  rdig o EO_SRC
  rdig o EO_EV
  put o EO_EV or get o EO_EV 1
end

fn gen_belief o edit ulong 96 to void
  for i ulong EST_BELIEF_LEN
    put o i 0
  end
  n = rdim
  put o EB_N n
  for i ulong n
    put o add EB_UNIT i runit
    put o add EB_X i bitcast ulong rdbl -100.0f64 100.0f64
  end
  gen_cov o EB_P n
  put o EB_GEN rng_next
  put o EB_TNS shr rng_next 2
  rdig o EB_MDL
  rdig o EB_PAR
  rdig o EB_ROOT
end

fn gen_pred o edit ulong 176 to void
  for i ulong EST_PRED_LEN
    put o i 0
  end
  n = rdim
  m = rdim
  put o EP_N n
  put o EP_M m
  rdig o EP_PRIOR
  rdig o EP_MDL
  put o EP_HZ add 1 rem rng_next 1000
  put o EP_GEN rng_next
  put o EP_TNS shr rng_next 2
  for i ulong n
    put o add EP_X i bitcast ulong rdbl -100.0f64 100.0f64
  end
  for i ulong m
    put o add EP_YM i bitcast ulong rdbl -100.0f64 100.0f64
  end
  gen_cov o EP_P n
  gen_cov o EP_S m
  hc = and rng_next 1
  put o EP_HC hc
  if eq hc 1
    for i ulong n
      put o add EP_BU i bitcast ulong rdbl -10.0f64 10.0f64
    end
  end
end

fn gen_innov o edit ulong 96 to void
  for i ulong EST_INNOV_LEN
    put o i 0
  end
  m = rdim
  put o EI_M m
  rdig o EI_PRED
  rdig o EI_OBS
  rdig o EI_MDL
  for i ulong m
    put o add EI_NU i bitcast ulong rdbl -100.0f64 100.0f64
  end
  gen_cov o EI_S m
  put o EI_NIS bitcast ulong rdbl 0.0f64 50.0f64
  put o EI_TNS shr rng_next 2
end

fn bump_unit u ulong to ulong
  if eq u EST_UNIT_WATT
    ret EST_UNIT_BYTE
  end
  ret EST_UNIT_WATT
end

fn bump_cov rec edit ulong * off ulong n ulong i ulong j ulong to void
  if eq i j
    idx = add off add mul i n i
    put rec idx bitcast ulong add bitcast f64 get rec idx 1.0f64
  else
    p1 = add off add mul i n j
    p2 = add off add mul j n i
    put rec p1 bitcast ulong add bitcast f64 get rec p1 0.01f64
    put rec p2 bitcast ulong add bitcast f64 get rec p2 0.01f64
  end
end

fn buf_eq a view uchar * b view uchar * n ulong to bool
  for i ulong n
    if ne get a i get b i
      ret false
    end
  end
  ret true
end

note ---- Test 1: covariance rules ----

fn test_cov_poison to void
  bad = new f64 4 0.0
  poison = new f64 3 0.0
  put poison 0 est_nan
  put poison 1 est_inf
  put poison 2 est_ninf
  for p ulong 3
    for pos ulong 4
      put bad 0 1.0f64
      put bad 1 0.0f64
      put bad 2 0.0f64
      put bad 3 1.0f64
      put bad pos get poison p
      chk_st est_check_covariance view bad 2 EST_ERR_NONFINITE 110
    end
  end
end

fn test_covariance_rules to void
  m = new f64 64 0.0
  put m 0 1.0f64
  put m 3 1.0f64
  chk_st est_check_covariance view m 2 EST_OK 100
  z = new f64 9 0.0
  chk_st est_check_covariance view z 3 EST_OK 101
  put m 0 1.0f64
  put m 1 1.0f64
  put m 2 1.0f64
  put m 3 1.0f64
  chk_st est_check_covariance view m 2 EST_OK 102
  put m 1 0.5f64
  put m 2 0.0f64
  chk_st est_check_covariance view m 2 EST_ERR_ASYMMETRIC 103
  put m 1 1.0e-6f64
  chk_st est_check_covariance view m 2 EST_ERR_ASYMMETRIC 104
  put m 1 1.0e-12f64
  chk_st est_check_covariance view m 2 EST_OK 105
  put m 0 -1.0f64
  put m 1 0.0f64
  put m 2 0.0f64
  put m 3 -1.0f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 106
  put m 0 -1.0e-3f64
  chk_st est_check_covariance view m 1 EST_ERR_NOT_PSD 107
  put m 0 1.0f64
  put m 1 2.0f64
  put m 2 2.0f64
  put m 3 1.0f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 108
  put m 0 0.0f64
  put m 1 1.0f64
  put m 2 1.0f64
  put m 3 0.0f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 109
  m3 = new f64 9 0.0
  put m3 0 1.0f64
  put m3 4 1.0f64
  put m3 8 -0.5f64
  chk_st est_check_covariance view m3 3 EST_ERR_NOT_PSD 111
  test_cov_poison
  chk_st est_check_covariance view m 0 EST_ERR_DIM 112
  chk_st est_check_covariance view m 9 EST_ERR_DIM 113
  for i ulong 64
    put m i 0.0f64
  end
  for i ulong 8
    put m add mul i 8 i 1.0e300f64
  end
  chk_st est_check_covariance view m 8 EST_OK 114
  for i ulong 8
    put m add mul i 8 i 1.0e-300f64
  end
  chk_st est_check_covariance view m 8 EST_OK 115
  put m 0 1.0e12f64
  put m 1 0.0f64
  put m 2 0.0f64
  put m 3 -0.5f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 116
  put m 0 1.0e6f64
  put m 1 0.5f64
  put m 2 0.5f64
  put m 3 0.0f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 117
  put m 0 0.0f64
  put m 1 1.0e-170f64
  put m 2 1.0e-170f64
  put m 3 0.0f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 118
  put m 0 1.0e12f64
  put m 1 0.0f64
  put m 2 0.0f64
  put m 3 1.0e-6f64
  chk_st est_check_covariance view m 2 EST_OK 119
  put m 0 1.0e-6f64
  put m 1 2.0e-6f64
  put m 2 2.0e-6f64
  put m 3 1.0e-6f64
  chk_st est_check_covariance view m 2 EST_ERR_NOT_PSD 120
end

note ---- Test 2: invalid records ----

fn fill_base_model m edit ulong 280 to void
  for i ulong EST_MODEL_LEN
    put m i 0
  end
  put m EM_N 2
  put m EM_M 1
  put m EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put m EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put m EM_SUNIT EST_UNIT_MILLI_CELSIUS
  put m add EM_SUNIT 1 EST_UNIT_MILLI_CELSIUS_PER_S
  put m EM_OUNIT EST_UNIT_MILLI_CELSIUS
  put m EM_F bitcast ulong 1.0f64
  put m add EM_F 1 bitcast ulong 0.1f64
  put m add EM_F 3 bitcast ulong 1.0f64
  put m EM_H bitcast ulong 1.0f64
  put m EM_Q bitcast ulong 0.01f64
  put m add EM_Q 3 bitcast ulong 0.01f64
  put m EM_R bitcast ulong 4.0f64
  put m EM_STEP 100
end

fn test_invalid_model to void
  m0 = new ulong 280 0
  m = new ulong 280 0
  fill_base_model m0
  chk_st est_check_model view m0 EST_OK 200
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_R 0
  chk_st est_check_model view m EST_ERR_NOT_PD 201
  poison = new f64 3 0.0
  put poison 0 est_nan
  put poison 1 est_inf
  put poison 2 est_ninf
  for p ulong 3
    pb = bitcast ulong get poison p
    est_rec_copy view m0 m EST_MODEL_LEN
    put m add EM_F 1 pb
    chk_st est_check_model view m EST_ERR_NONFINITE 202
    est_rec_copy view m0 m EST_MODEL_LEN
    put m EM_H pb
    chk_st est_check_model view m EST_ERR_NONFINITE 203
    est_rec_copy view m0 m EST_MODEL_LEN
    put m EM_Q pb
    chk_st est_check_model view m EST_ERR_NONFINITE 204
    est_rec_copy view m0 m EST_MODEL_LEN
    put m EM_R pb
    chk_st est_check_model view m EST_ERR_NONFINITE 205
  end
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_N 0
  chk_st est_check_model view m EST_ERR_DIM 206
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_N 9
  chk_st est_check_model view m EST_ERR_DIM 207
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_M 0
  chk_st est_check_model view m EST_ERR_DIM 208
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_M 9
  chk_st est_check_model view m EST_ERR_DIM 209
  est_rec_copy view m0 m EST_MODEL_LEN
  put m add EM_SUNIT 1 EST_UNIT_NONE
  chk_st est_check_model view m EST_ERR_UNIT 210
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_OUNIT EST_UNIT_NONE
  chk_st est_check_model view m EST_ERR_UNIT 211
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_OUNIT EST_UNIT_MAX
  chk_st est_check_model view m EST_ERR_UNIT 212
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_MEAN 0
  chk_st est_check_model view m EST_ERR_UNIT 213
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_EST 2
  chk_st est_check_model view m EST_ERR_UNIT 214
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_STEP 0
  chk_st est_check_model view m EST_ERR_TIME 215
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_STEP bitcast ulong long -5
  chk_st est_check_model view m EST_ERR_TIME 216
  est_rec_copy view m0 m EST_MODEL_LEN
  put m add EM_Q 1 bitcast ulong 0.5f64
  chk_st est_check_model view m EST_ERR_ASYMMETRIC 217
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_Q bitcast ulong -1.0f64
  chk_st est_check_model view m EST_ERR_NOT_PSD 218
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_R bitcast ulong -1.0f64
  chk_st est_check_model view m EST_ERR_NOT_PSD 219
  est_rec_copy view m0 m EST_MODEL_LEN
  put m add EM_F 63 bitcast ulong est_nan
  put m add EM_H 40 bitcast ulong est_inf
  chk_st est_check_model view m EST_OK 220
  buf = new uchar 2400 0
  olen = new ulong 1 0
  dig = new uchar 32 0
  est_rec_copy view m0 m EST_MODEL_LEN
  put m EM_H bitcast ulong est_nan
  chk_st est_encode_model view m buf olen EST_ERR_NONFINITE 221
  chk_st est_digest_model view m dig EST_ERR_NONFINITE 222
end

fn test_invalid_obs to void
  o0 = new ulong 96 0
  o = new ulong 96 0
  put o0 EO_M 2
  put o0 EO_UNIT EST_UNIT_WATT
  put o0 add EO_UNIT 1 EST_UNIT_WATT
  put o0 EO_Z bitcast ulong 1.0f64
  put o0 add EO_Z 1 bitcast ulong 2.0f64
  put o0 EO_R bitcast ulong 1.0f64
  put o0 add EO_R 3 bitcast ulong 1.0f64
  put o0 EO_EV 0x09000000
  put o0 EO_SRC 4
  chk_st est_check_observation view o0 EST_OK 230
  poison = new f64 3 0.0
  put poison 0 est_nan
  put poison 1 est_inf
  put poison 2 est_ninf
  for p ulong 3
    pb = bitcast ulong get poison p
    est_rec_copy view o0 o EST_OBS_LEN
    put o add EO_Z 1 pb
    chk_st est_check_observation view o EST_ERR_NONFINITE 231
    est_rec_copy view o0 o EST_OBS_LEN
    put o add EO_R 3 pb
    chk_st est_check_observation view o EST_ERR_NONFINITE 232
  end
  est_rec_copy view o0 o EST_OBS_LEN
  put o EO_M 0
  chk_st est_check_observation view o EST_ERR_DIM 233
  est_rec_copy view o0 o EST_OBS_LEN
  put o EO_M 9
  chk_st est_check_observation view o EST_ERR_DIM 234
  est_rec_copy view o0 o EST_OBS_LEN
  put o add EO_UNIT 1 EST_UNIT_NONE
  chk_st est_check_observation view o EST_ERR_UNIT 235
  est_rec_copy view o0 o EST_OBS_LEN
  put o EO_EV 0
  chk_st est_check_observation view o EST_ERR_KIND 236
  est_rec_copy view o0 o EST_OBS_LEN
  put o EO_SRC 0
  chk_st est_check_observation view o EST_ERR_KIND 237
  est_rec_copy view o0 o EST_OBS_LEN
  put o add EO_R 1 bitcast ulong 3.0f64
  chk_st est_check_observation view o EST_ERR_ASYMMETRIC 238
  est_rec_copy view o0 o EST_OBS_LEN
  put o add EO_R 1 bitcast ulong 2.0f64
  put o add EO_R 2 bitcast ulong 2.0f64
  chk_st est_check_observation view o EST_ERR_NOT_PSD 239
end

fn test_invalid_belief to void
  b0 = new ulong 96 0
  b = new ulong 96 0
  put b0 EB_N 2
  put b0 EB_UNIT EST_UNIT_BYTE
  put b0 add EB_UNIT 1 EST_UNIT_BYTE
  put b0 EB_X bitcast ulong 1.0f64
  put b0 add EB_X 1 bitcast ulong -1.0f64
  put b0 EB_P bitcast ulong 2.0f64
  put b0 add EB_P 3 bitcast ulong 3.0f64
  put b0 EB_MDL 5
  chk_st est_check_belief view b0 EST_OK 240
  poison = new f64 3 0.0
  put poison 0 est_nan
  put poison 1 est_inf
  put poison 2 est_ninf
  for p ulong 3
    pb = bitcast ulong get poison p
    est_rec_copy view b0 b EST_BELIEF_LEN
    put b EB_X pb
    chk_st est_check_belief view b EST_ERR_NONFINITE 241
    est_rec_copy view b0 b EST_BELIEF_LEN
    put b add EB_P 2 pb
    chk_st est_check_belief view b EST_ERR_NONFINITE 242
  end
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_N 0
  chk_st est_check_belief view b EST_ERR_DIM 243
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_N 9
  chk_st est_check_belief view b EST_ERR_DIM 244
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_UNIT EST_UNIT_NONE
  chk_st est_check_belief view b EST_ERR_UNIT 245
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b add EB_UNIT 1 77
  chk_st est_check_belief view b EST_ERR_UNIT 246
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b add EB_P 1 bitcast ulong 1.0f64
  chk_st est_check_belief view b EST_ERR_ASYMMETRIC 247
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b add EB_P 1 bitcast ulong 5.0f64
  put b add EB_P 2 bitcast ulong 5.0f64
  chk_st est_check_belief view b EST_ERR_NOT_PSD 248
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_P bitcast ulong -1.0f64
  put b add EB_P 3 bitcast ulong -1.0f64
  chk_st est_check_belief view b EST_ERR_NOT_PSD 249
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_MDL 0
  chk_st est_check_belief view b EST_ERR_MODEL 250
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_GEN 3
  chk_st est_check_belief view b EST_ERR_STALE 251
  put b EB_PAR 1
  chk_st est_check_belief view b EST_OK 252
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_PAR 1
  chk_st est_check_belief view b EST_ERR_STALE 253
  est_rec_copy view b0 b EST_BELIEF_LEN
  put b EB_ROOT 1
  chk_st est_check_belief view b EST_ERR_STALE 254

  buf = new uchar 2400 0
  c = new uchar 2400 0
  olen = new ulong 1 0
  chk_st est_encode_belief view b0 buf olen EST_OK 255
  bl = get olen 0
  for i ulong bl
    put c i get buf i
  end
  put c 26 uchar 0xf8
  put c 27 uchar 0x7f
  chk_st est_decode_belief view c bl b EST_ERR_NONFINITE 256
  for i ulong bl
    put c i get buf i
  end
  put c 8 uchar 0
  chk_st est_decode_belief view c bl b EST_ERR_DIM 257
  put c 8 uchar 9
  chk_st est_decode_belief view c bl b EST_ERR_DIM 258
  for i ulong bl
    put c i get buf i
  end
  put c 12 uchar 0
  chk_st est_decode_belief view c bl b EST_ERR_UNIT 259
  put c 12 uchar 200
  chk_st est_decode_belief view c bl b EST_ERR_UNIT 260
end

fn test_invalid_obs_belief to void
  test_invalid_obs
  test_invalid_belief
end

fn test_invalid_pred_innov to void
  p0 = new ulong 176 0
  p = new ulong 176 0
  put p0 EP_N 2
  put p0 EP_M 1
  put p0 EP_HZ 1
  put p0 EP_X bitcast ulong 1.0f64
  put p0 EP_P bitcast ulong 1.0f64
  put p0 add EP_P 3 bitcast ulong 1.0f64
  put p0 EP_S bitcast ulong 1.0f64
  chk_st est_check_prediction view p0 EST_OK 270
  poison = new f64 3 0.0
  put poison 0 est_nan
  put poison 1 est_inf
  put poison 2 est_ninf
  for q ulong 3
    pb = bitcast ulong get poison q
    est_rec_copy view p0 p EST_PRED_LEN
    put p add EP_X 1 pb
    chk_st est_check_prediction view p EST_ERR_NONFINITE 271
    est_rec_copy view p0 p EST_PRED_LEN
    put p EP_YM pb
    chk_st est_check_prediction view p EST_ERR_NONFINITE 272
    est_rec_copy view p0 p EST_PRED_LEN
    put p add EP_P 3 pb
    chk_st est_check_prediction view p EST_ERR_NONFINITE 273
    est_rec_copy view p0 p EST_PRED_LEN
    put p EP_S pb
    chk_st est_check_prediction view p EST_ERR_NONFINITE 274
  end
  est_rec_copy view p0 p EST_PRED_LEN
  put p EP_HZ 0
  chk_st est_check_prediction view p EST_ERR_TIME 275
  put p EP_HZ EST_MAX_HORIZON
  chk_st est_check_prediction view p EST_OK 276
  put p EP_HZ add EST_MAX_HORIZON 1
  chk_st est_check_prediction view p EST_ERR_TIME 277
  est_rec_copy view p0 p EST_PRED_LEN
  put p EP_HC 2
  chk_st est_check_prediction view p EST_ERR_ENCODING 278
  put p EP_HC 1
  put p add EP_BU 1 bitcast ulong est_nan
  chk_st est_check_prediction view p EST_ERR_NONFINITE 279
  put p EP_HC 0
  chk_st est_check_prediction view p EST_OK 280
  est_rec_copy view p0 p EST_PRED_LEN
  put p EP_N 0
  chk_st est_check_prediction view p EST_ERR_DIM 281
  put p EP_N 9
  chk_st est_check_prediction view p EST_ERR_DIM 282
  est_rec_copy view p0 p EST_PRED_LEN
  put p EP_M 0
  chk_st est_check_prediction view p EST_ERR_DIM 283
  put p EP_M 9
  chk_st est_check_prediction view p EST_ERR_DIM 284
  est_rec_copy view p0 p EST_PRED_LEN
  put p add EP_P 1 bitcast ulong 1.0f64
  chk_st est_check_prediction view p EST_ERR_ASYMMETRIC 285
  est_rec_copy view p0 p EST_PRED_LEN
  put p EP_S bitcast ulong -1.0f64
  chk_st est_check_prediction view p EST_ERR_NOT_PSD 286

  i0 = new ulong 96 0
  iv = new ulong 96 0
  put i0 EI_M 1
  put i0 EI_NU bitcast ulong 1.0f64
  put i0 EI_S bitcast ulong 2.0f64
  put i0 EI_NIS bitcast ulong 0.5f64
  chk_st est_check_innovation view i0 EST_OK 290
  for q ulong 3
    pb = bitcast ulong get poison q
    est_rec_copy view i0 iv EST_INNOV_LEN
    put iv EI_NU pb
    chk_st est_check_innovation view iv EST_ERR_NONFINITE 291
    est_rec_copy view i0 iv EST_INNOV_LEN
    put iv EI_S pb
    chk_st est_check_innovation view iv EST_ERR_NONFINITE 292
    est_rec_copy view i0 iv EST_INNOV_LEN
    put iv EI_NIS pb
    chk_st est_check_innovation view iv EST_ERR_NONFINITE 293
  end
  est_rec_copy view i0 iv EST_INNOV_LEN
  put iv EI_NIS bitcast ulong -0.1f64
  chk_st est_check_innovation view iv EST_ERR_NOT_PSD 294
  est_rec_copy view i0 iv EST_INNOV_LEN
  put iv EI_M 0
  chk_st est_check_innovation view iv EST_ERR_DIM 295
  put iv EI_M 9
  chk_st est_check_innovation view iv EST_ERR_DIM 296
  est_rec_copy view i0 iv EST_INNOV_LEN
  put iv EI_S bitcast ulong -2.0f64
  chk_st est_check_innovation view iv EST_ERR_NOT_PSD 297
end

note ---- Test 3: exact byte layout KAT ----

fn test_layout_kat to void
  o = new ulong 96 0
  put o EO_M 1
  put o EO_UNIT EST_UNIT_WATT
  put o EO_Z bitcast ulong 1.0f64
  put o EO_R bitcast ulong 0.5f64
  put o EO_TNS 0x0102030405060708
  put o EO_SEQ 0x1112131415161718
  src = new uchar 32 0
  ev = new uchar 32 0
  for i ulong 32
    put src i uchar i
    put ev i uchar add 0x80 i
  end
  est_rec_put_dig o EO_SRC view src
  est_rec_put_dig o EO_EV view ev
  buf = new uchar 2400 0
  olen = new ulong 1 0
  chk_st est_encode_observation view o buf olen EST_OK 300
  l = get olen 0
  chk eq l 112 301
  chk eq ulong get buf 0 79 302
  chk eq ulong get buf 1 69 302
  chk eq ulong get buf 2 83 302
  chk eq ulong get buf 3 84 302
  chk eq ulong get buf 4 2 303
  chk eq ulong get buf 5 1 303
  chk eq ulong get buf 6 0 303
  chk eq ulong get buf 7 0 303
  chk eq ulong get buf 8 1 304
  chk eq ulong get buf 12 3 304
  chk eq ulong get buf 22 0xf0 305
  chk eq ulong get buf 23 0x3f 305
  chk eq ulong get buf 30 0xe0 306
  chk eq ulong get buf 31 0x3f 306
  chk eq ulong get buf 32 8 307
  chk eq ulong get buf 39 1 307
  chk eq ulong get buf 40 0x18 308
  chk eq ulong get buf 47 0x11 308
  chk eq ulong get buf 48 0 309
  chk eq ulong get buf 79 31 309
  chk eq ulong get buf 80 0x80 309
  chk eq ulong get buf 111 0x9f 309
  want = new uchar 32 0
  est_sha256_domain EST_DOM_OBS view buf l want
  d = new uchar 32 0
  chk_st est_digest_observation view o d EST_OK 310
  chk est_digest_eq view d view want 311
end

note ---- Test 4: negative zero and unused entries ----

fn test_negative_zero_and_unused to void
  a = new ulong 96 0
  b = new ulong 96 0
  da = new uchar 32 0
  db = new uchar 32 0
  gen_belief a
  est_rec_copy view a b EST_BELIEF_LEN
  put a EB_X bitcast ulong 0.0f64
  put b EB_X bitcast ulong est_neg_zero
  chk_st est_digest_belief view a da EST_OK 400
  chk_st est_digest_belief view b db EST_OK 401
  chk est_digest_eq view da view db 402
  est_rec_copy view a b EST_BELIEF_LEN
  n = get a EB_N
  i = n
  while lt i EST_MAX_DIM bound 16
    put b add EB_X i bitcast ulong 12345.0f64
    i = add i 1
  end
  i = mul n n
  while lt i 64 bound 70
    put b add EB_P i bitcast ulong -7.0f64
    i = add i 1
  end
  chk_st est_digest_belief view b db EST_OK 403
  chk est_digest_eq view da view db 404
  if gt n 1
    est_rec_copy view a b EST_BELIEF_LEN
    put b EB_N sub n 1
    gen_cov b EB_P sub n 1
    chk_st est_digest_belief view b db EST_OK 405
    chk not est_digest_eq view da view db 406
  end
end

note ---- Test 5: digest domains ----

fn hash_by_dom dm ulong eb view uchar * el ulong dst edit uchar 32 to void
  if eq dm 0
    est_sha256_domain EST_DOM_MODEL eb el dst
    ret
  end
  if eq dm 1
    est_sha256_domain EST_DOM_OBS eb el dst
    ret
  end
  if eq dm 2
    est_sha256_domain EST_DOM_BELIEF eb el dst
    ret
  end
  if eq dm 3
    est_sha256_domain EST_DOM_PRED eb el dst
    ret
  end
  est_sha256_domain EST_DOM_INNOV eb el dst
end

fn chk_dom_matches want_dm ulong eb view uchar * el ulong d view uchar 32 tag ulong to void
  x = new uchar 32 0
  for dm ulong 5
    hash_by_dom dm eb el x
    chk eq est_digest_eq view x d eq dm want_dm tag
  end
end

fn test_digest_domains to void
  mm = new ulong 280 0
  oo = new ulong 96 0
  bb = new ulong 96 0
  pp = new ulong 176 0
  ii = new ulong 96 0
  put mm EM_N 1
  put mm EM_M 1
  put mm EM_EST EST_ESTIMATOR_LINEAR_KALMAN
  put mm EM_MEAN EST_UNCERTAINTY_GAUSSIAN
  put mm EM_SUNIT EST_UNIT_WATT
  put mm EM_OUNIT EST_UNIT_WATT
  put mm EM_F bitcast ulong 1.0f64
  put mm EM_H bitcast ulong 1.0f64
  put mm EM_Q bitcast ulong 1.0f64
  put mm EM_R bitcast ulong 1.0f64
  put mm EM_STEP 1
  put oo EO_M 1
  put oo EO_UNIT EST_UNIT_WATT
  put oo EO_Z bitcast ulong 1.0f64
  put oo EO_R bitcast ulong 1.0f64
  put oo EO_EV 1
  put oo EO_SRC 2
  put bb EB_N 1
  put bb EB_UNIT EST_UNIT_WATT
  put bb EB_X bitcast ulong 1.0f64
  put bb EB_P bitcast ulong 1.0f64
  put bb EB_MDL 3
  put pp EP_N 1
  put pp EP_M 1
  put pp EP_HZ 1
  put pp EP_X bitcast ulong 1.0f64
  put pp EP_YM bitcast ulong 1.0f64
  put pp EP_P bitcast ulong 1.0f64
  put pp EP_S bitcast ulong 1.0f64
  put ii EI_M 1
  put ii EI_NU bitcast ulong 1.0f64
  put ii EI_S bitcast ulong 1.0f64
  put ii EI_NIS bitcast ulong 1.0f64
  d0 = new uchar 32 0
  d1 = new uchar 32 0
  d2 = new uchar 32 0
  d3 = new uchar 32 0
  d4 = new uchar 32 0
  chk_st est_digest_model view mm d0 EST_OK 500
  chk_st est_digest_observation view oo d1 EST_OK 501
  chk_st est_digest_belief view bb d2 EST_OK 502
  chk_st est_digest_prediction view pp d3 EST_OK 503
  chk_st est_digest_innovation view ii d4 EST_OK 504
  chk not est_digest_eq view d0 view d1 505
  chk not est_digest_eq view d0 view d2 506
  chk not est_digest_eq view d0 view d3 507
  chk not est_digest_eq view d0 view d4 508
  chk not est_digest_eq view d1 view d2 509
  chk not est_digest_eq view d1 view d3 510
  chk not est_digest_eq view d1 view d4 511
  chk not est_digest_eq view d2 view d3 512
  chk not est_digest_eq view d2 view d4 513
  chk not est_digest_eq view d3 view d4 514
  eb = new uchar 2400 0
  el = new ulong 1 0
  chk_st est_encode_model view mm eb el EST_OK 515
  chk_dom_matches 0 view eb get el 0 view d0 516
  chk_st est_encode_observation view oo eb el EST_OK 517
  chk_dom_matches 1 view eb get el 0 view d1 518
  chk_st est_encode_belief view bb eb el EST_OK 519
  chk_dom_matches 2 view eb get el 0 view d2 520
  chk_st est_encode_prediction view pp eb el EST_OK 521
  chk_dom_matches 3 view eb get el 0 view d3 522
  chk_st est_encode_innovation view ii eb el EST_OK 523
  chk_dom_matches 4 view eb get el 0 view d4 524
  z = new uchar 32 0
  chk est_digest_is_zero view z 525
  chk not est_digest_is_zero view d0 526
end

note ---- Test 6: evidence root ----

fn test_evidence_root to void
  r = new uchar 32 0
  a = new uchar 32 0
  b = new uchar 32 0
  for i ulong 32
    put a i uchar and rng_next 0xff
    put b i uchar and rng_next 0xff
  end
  ra = new uchar 32 0
  rb = new uchar 32 0
  rab = new uchar 32 0
  rba = new uchar 32 0
  rab2 = new uchar 32 0
  chk_st est_evidence_root_extend view r view a ra EST_OK 600
  chk_st est_evidence_root_extend view r view b rb EST_OK 601
  chk and not est_digest_eq view ra view rb not est_digest_eq view ra view r 602
  chk_st est_evidence_root_extend view ra view b rab EST_OK 603
  chk_st est_evidence_root_extend view rb view a rba EST_OK 604
  chk not est_digest_eq view rab view rba 605
  chk_st est_evidence_root_extend view ra view b rab2 EST_OK 606
  chk est_digest_eq view rab view rab2 607
  chk_st est_evidence_root_extend view a view b ra EST_OK 608
  chk_st est_evidence_root_extend view b view a rb EST_OK 609
  chk not est_digest_eq view ra view rb 610
  cat = new uchar 64 0
  for i ulong 32
    put cat i get a i
    put cat add 32 i get b i
  end
  want = new uchar 32 0
  est_sha256_domain EST_DOM_ROOT view cat 64 want
  chk est_digest_eq view ra view want 611
end

note ---- Test 7 & 8: kind separation, truncation & extension ----

fn enc_kind kind ulong buf edit uchar * el edit ulong 1 to long
  m = new ulong 280 0
  o = new ulong 96 0
  b = new ulong 96 0
  p = new ulong 176 0
  iv = new ulong 96 0
  if eq kind 1
    gen_model m
    ret est_encode_model view m buf el
  end
  if eq kind 2
    gen_obs o
    ret est_encode_observation view o buf el
  end
  if eq kind 3
    gen_belief b
    ret est_encode_belief view b buf el
  end
  if eq kind 4
    gen_pred p
    ret est_encode_prediction view p buf el
  end
  gen_innov iv
  ret est_encode_innovation view iv buf el
end

fn dec_kind kind ulong buf view uchar * blen ulong to long
  m = new ulong 280 0
  o = new ulong 96 0
  b = new ulong 96 0
  p = new ulong 176 0
  iv = new ulong 96 0
  if eq kind 1
    ret est_decode_model buf blen m
  end
  if eq kind 2
    ret est_decode_observation buf blen o
  end
  if eq kind 3
    ret est_decode_belief buf blen b
  end
  if eq kind 4
    ret est_decode_prediction buf blen p
  end
  ret est_decode_innovation buf blen iv
end

fn test_kind_separation to void
  buf = new uchar 2400 0
  el = new ulong 1 0
  for r ulong 50
    for ek0 ulong 5
      ek = add ek0 1
      chk_st enc_kind ek buf el EST_OK 700
      for dk0 ulong 5
        dk = add dk0 1
        want = EST_ERR_KIND
        if eq dk ek
          want = EST_OK
        end
        chk_st dec_kind dk view buf get el 0 want 701
      end
    end
  end
end

fn test_truncation_and_extension to void
  buf = new uchar 2416 0
  c = new uchar 2400 0
  el = new ulong 1 0
  for ek0 ulong 5
    ek = add ek0 1
    for r ulong 10
      chk_st enc_kind ek buf el EST_OK 800
      l = get el 0
      all_ref = true
      for cut ulong l bound 2500
        if eq dec_kind ek view buf cut EST_OK
          all_ref = false
        end
      end
      chk all_ref 801
      for j ulong 16
        put buf add l j uchar 0
      end
      chk_st dec_kind ek view buf add l 1 EST_ERR_ENCODING 802
      chk_st dec_kind ek view buf add l 8 EST_ERR_ENCODING 803
      for j ulong l bound 2500
        put c j get buf j
      end
      put c 0 xor get c 0 uchar 1
      chk_st dec_kind ek view c l EST_ERR_ENCODING 804
      put c 0 get buf 0
      put c 5 uchar 2
      chk_st dec_kind ek view c l EST_ERR_ENCODING 805
      put c 5 get buf 5
      put c 6 uchar 1
      chk_st dec_kind ek view c l EST_ERR_ENCODING 806
      put c 6 get buf 6
      put c 4 uchar 99
      chk_st dec_kind ek view c l EST_ERR_KIND 807
    end
  end
  small = new uchar 10 0
  b = new ulong 96 0
  put b EB_N 1
  put b EB_UNIT EST_UNIT_WATT
  put b EB_P bitcast ulong 1.0f64
  put b EB_MDL 1
  chk_st est_encode_belief view b small el EST_ERR_ENCODING 808
end

note ---- Test 9: property tests (round-trip + single-field digest sensitivity) ----

fn chk_mut_model o view ulong 280 d0 view uchar 32 to void
  d1 = new uchar 32 0
  chk_st est_check_model o EST_OK 910
  chk_st est_digest_model o d1 EST_OK 911
  chk not est_digest_eq d0 view d1 912
end

fn prop_model_mut a view ulong 280 d0 view uchar 32 to void
  o = new ulong 280 0
  n = get a EM_N
  m = get a EM_M
  for i ulong n
    est_rec_copy a o EST_MODEL_LEN
    put o add EM_SUNIT i bump_unit get o add EM_SUNIT i
    chk_mut_model view o d0
  end
  for i ulong m
    est_rec_copy a o EST_MODEL_LEN
    put o add EM_OUNIT i bump_unit get o add EM_OUNIT i
    chk_mut_model view o d0
  end
  for i ulong mul n n
    est_rec_copy a o EST_MODEL_LEN
    put o add EM_F i bitcast ulong add bitcast f64 get o add EM_F i 1.0f64
    chk_mut_model view o d0
  end
  est_rec_copy a o EST_MODEL_LEN
  bump_cov o EM_Q n 0 0
  chk_mut_model view o d0
  est_rec_copy a o EST_MODEL_LEN
  bump_cov o EM_R m 0 0
  chk_mut_model view o d0
  est_rec_copy a o EST_MODEL_LEN
  put o EM_STEP bitcast ulong add bitcast long get o EM_STEP 1
  chk_mut_model view o d0
end

fn prop_model_one to void
  a = new ulong 280 0
  dec = new ulong 280 0
  d0 = new uchar 32 0
  d1 = new uchar 32 0
  buf = new uchar 2400 0
  buf2 = new uchar 2400 0
  l = new ulong 1 0
  l2 = new ulong 1 0
  gen_model a
  chk_st est_check_model view a EST_OK 900
  chk_st est_digest_model view a d0 EST_OK 901
  chk_st est_digest_model view a d1 EST_OK 902
  chk est_digest_eq view d0 view d1 903
  chk_st est_encode_model view a buf l EST_OK 904
  chk_st est_decode_model view buf get l 0 dec EST_OK 905
  chk_st est_encode_model view dec buf2 l2 EST_OK 906
  chk eq get l 0 get l2 0 907
  chk buf_eq view buf view buf2 get l 0 907
  chk_st est_digest_model view dec d1 EST_OK 908
  chk est_digest_eq view d0 view d1 909
  prop_model_mut view a view d0
end


fn run_props to void
  for r ulong 200
    prop_model_one
    prop_obs_one
    prop_belief_one
    prop_pred_one
    prop_innov_one
  end
end

fn main to int
  put g_rng 0 0x9e3779b97f4a7c15
  test_covariance_rules
  test_invalid_model
  test_invalid_obs_belief
  test_invalid_pred_innov
  test_layout_kat
  test_negative_zero_and_unused
  test_digest_domains
  test_evidence_root
  test_kind_separation
  test_truncation_and_extension
  run_props
  est_puts T_PREFIX
  est_putu get g_checks 0
  est_puts T_CHECKS
  est_putu get g_fail 0
  est_puts T_FAILED
  if gt get g_fail 0 0
    est_puts T_FAIL
    ret 1
  end
  est_puts T_PASS
  ret 0
end

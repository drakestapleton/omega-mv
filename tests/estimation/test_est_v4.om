note SPDX-License-Identifier: Apache-2.0
note ESTIMATION v4 families unit tests in pure seeded OM-2 (port of tests/estimation/test_est_v4.c).

global g_checks ulong 1
global g_fail ulong 1

const V4_QU f64 100.0

text V4_PREFIX "test_est_v4: "
text V4_CHECKS " checks, "
text V4_FAILED " failures\n"
text V4_PASS "test_est_v4: PASS\n"
text V4_FAIL "test_est_v4: FAIL\n"
text V4_FTAG "FAIL tag="
text V4_NL "\n"

fn chk cond bool tag ulong to void
  put g_checks 0 add get g_checks 0 1
  if not cond
    put g_fail 0 add get g_fail 0 1
    est_eputs V4_FTAG
    est_putu_fd 2 tag
    est_eputs V4_NL
  end
end

fn chk_st got long want long tag ulong to void
  chk eq got want tag
end

fn chk_near x f64 y f64 tol f64 tag ulong to void
  chk le fabs sub x y tol tag
end

fn chk_rel x f64 y f64 rt f64 tag ulong to void
  chk_near x y add mul rt fabs y 1.0e-12f64 tag
end

fn v4_rr to f64
  ret div mul V4_QU V4_QU 12.0f64
end

fn mk_base f ulong p edit Est4Params to void
  put p family f
  if eq f EST4_G2_AR
    put p dyn 0.6f64
  else
    put p dyn 4.0f64
  end
  put p q 2500.0f64
  put p lam 0.7f64
  put p nu 1.5f64
  put p c 0.6f64
  put p phi 0.9f64
  put p nu_h 0.8f64
  put p c_h 0.4f64
  put p quantum V4_QU
end

fn copy_params src view Est4Params dst edit Est4Params to void
  put dst family get src family
  put dst dyn get src dyn
  put dst q get src q
  put dst lam get src lam
  put dst nu get src nu
  put dst c get src c
  put dst phi get src phi
  put dst nu_h get src nu_h
  put dst c_h get src c_h
  put dst quantum get src quantum
end

fn test_params to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  b = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  for f0 ulong 3
    f = add f0 1
    mk_base f p
    chk_st est4_params_check view p EST_OK 100
    copy_params view p b
    put b family 4
    chk_st est4_params_check view b EST_ERR_KIND 101
    copy_params view p b
    put b q 0.0f64
    chk ne est4_params_check view b EST_OK 102
    put b q est_nan
    chk_st est4_params_check view b EST_ERR_NONFINITE 103
    copy_params view p b
    put b lam 1.0f64
    chk ne est4_params_check view b EST_OK 104
    put b lam -0.1f64
    chk ne est4_params_check view b EST_OK 105
    copy_params view p b
    put b phi 0.0f64
    chk ne est4_params_check view b EST_OK 106
    put b phi 1.01f64
    chk ne est4_params_check view b EST_OK 107
    copy_params view p b
    put b nu 0.0f64
    chk ne est4_params_check view b EST_OK 108
    copy_params view p b
    put b c -1.0f64
    chk ne est4_params_check view b EST_OK 109
    copy_params view p b
    put b nu_h 0.0f64
    chk ne est4_params_check view b EST_OK 110
    copy_params view p b
    put b c_h 0.0f64
    chk ne est4_params_check view b EST_OK 111
    put b c_h est_inf
    chk ne est4_params_check view b EST_OK 112
    copy_params view p b
    put b quantum 0.0f64
    chk ne est4_params_check view b EST_OK 113
    copy_params view p b
    if eq f 2
      put b dyn 1.0f64
    else
      put b dyn 0.0f64
    end
    chk ne est4_params_check view b EST_OK 114
    put b dyn -0.1f64
    chk ne est4_params_check view b EST_OK 115
  end
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G1_LAG b
  put b nu est_nan
  chk ne est4_init view b s EST_OK 116
end

fn chk_dig_diff b view Est4Params d0 view uchar 32 to void
  d1 = new uchar 32 0
  chk_st est4_params_digest b d1 EST_OK 120
  chk not est_digest_eq d0 view d1 121
end

fn test_digest to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  b = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  mk_base EST4_G1_LAG p
  d0 = new uchar 32 0
  d1 = new uchar 32 0
  chk_st est4_params_digest view p d0 EST_OK 122
  chk_st est4_params_digest view p d1 EST_OK 123
  chk est_digest_eq view d0 view d1 124
  copy_params view p b
  put b dyn mul get p dyn 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b q mul get p q 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b lam mul get p lam 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b nu mul get p nu 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b c mul get p c 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b phi mul get p phi 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b nu_h mul get p nu_h 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b c_h mul get p c_h 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b quantum mul get p quantum 0.5f64
  chk_dig_diff view b view d0
  copy_params view p b
  put b family EST4_G3_TWO
  chk_dig_diff view b view d0
end

fn set_state s edit Est4State p view Est4Params x view f64 3 gv f64 to void
  chk_st est4_init p s EST_OK 130
  put s has_anchor 1
  put s anchor 1000.0f64
  for i ulong get s d
    put s x i get x i
  end
  for i ulong 9
    put s P i 0.0f64
  end
  put s g gv
  put s gl gv
end

fn check_law s view Est4State h ulong m f64 V f64 gbar f64 to void
  pr = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  chk_st est4_predict s h pr EST_OK 140
  chk_rel get pr loc m 1.0e-12f64 141
  if eq h 1
    chk_rel get pr scale mul get s pv 4 fsqrt mul get s g V 1.0e-12f64 142
    chk eq get pr nu get s pv 3 143
  else
    chk_rel get pr scale mul get s pv 7 fsqrt mul gbar V 1.0e-12f64 144
    chk eq get pr nu get s pv 6 145
  end
end

fn test_g1_analytic to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G1_LAG p
  x = new f64 3 0.0
  put x 0 1000.0f64
  put x 1 5000.0f64
  set_state s view p view x 1.7f64
  a = est_exp div -1.0f64 get p dyn
  for h0 ulong EST_PRED_MAX_H
    h = add h0 1
    m = add get x 1 mul est_powu a h sub get x 0 get x 1
    V = v4_rr
    for j0 ulong h bound 66
      j = add j0 1
      d = sub 1.0f64 est_powu a sub h j
      V = add V mul get p q mul d d
    end
    check_law view s h m V 1.7f64
  end
end

fn g2_var r f64 h ulong q f64 to f64
  V = v4_rr
  for j0 ulong h bound 66
    w = f64 0.0
    lim = sub h add j0 1
    for i ulong add lim 1 bound 66
      w = add w est_powu r i
    end
    V = add V mul q mul w w
  end
  ret V
end

fn test_g2_one_rho r f64 to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  x = new f64 3 0.0
  put x 0 2000.0f64
  put x 1 300.0f64
  mk_base EST4_G2_AR p
  put p dyn r
  set_state s view p view x 0.8f64
  for h0 ulong EST_PRED_MAX_H
    h = add h0 1
    sm = f64 0.0
    for i0 ulong h bound 66
      sm = add sm est_powu r add i0 1
    end
    V = g2_var r h get p q
    check_law view s h add get x 0 mul get x 1 sm V 0.8f64
  end
end

fn test_g2_analytic to void
  test_g2_one_rho 0.0f64
  test_g2_one_rho 0.6f64
  test_g2_one_rho 0.95f64
end

fn g3_var af f64 asv f64 h ulong q f64 to f64
  V = v4_rr
  for j0 ulong h bound 66
    e = sub h add j0 1
    c1 = mul EST4_G3_W sub 1.0f64 est_powu af e
    c2 = mul sub 1.0f64 EST4_G3_W sub 1.0f64 est_powu asv e
    cj = add c1 c2
    V = add V mul q mul cj cj
  end
  ret V
end

fn g3_mean x view f64 3 af f64 asv f64 h ulong to f64
  afh = est_powu af h
  ash = est_powu asv h
  m1 = add mul afh get x 0 mul mul sub 1.0f64 afh EST4_G3_W get x 2
  m2 = add mul ash get x 1 mul mul sub 1.0f64 ash sub 1.0f64 EST4_G3_W get x 2
  ret add m1 m2
end

fn test_g3_analytic to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G3_TWO p
  x = new f64 3 0.0
  put x 0 700.0f64
  put x 1 300.0f64
  put x 2 4000.0f64
  set_state s view p view x 2.5f64
  af = est_exp div -1.0f64 get p dyn
  asv = est_exp div -1.0f64 mul get p dyn EST4_TAU_RATIO
  for h0 ulong EST_PRED_MAX_H
    h = add h0 1
    mm = g3_mean view x af asv h
    V = g3_var af asv h get p q
    check_law view s h mm V 2.5f64
  end
end

fn test_scale_reversion to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G1_LAG p
  x = new f64 3 1000.0
  set_state s view p view x 1.0f64
  put s g 9.0f64
  put s gl 1.0f64
  one = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  ten = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  chk_st est4_predict view s 1 one EST_OK 200
  chk_st est4_predict view s 10 ten EST_OK 201
  gb = f64 0.0
  for j ulong 10
    gb = add gb add 1.0f64 mul 8.0f64 est_powu get p phi j
  end
  gb = div gb 10.0f64
  a = est_exp div -1.0f64 get p dyn
  V = v4_rr
  for j0 ulong 10
    d = sub 1.0f64 est_powu a sub 9 j0
    V = add V mul get p q mul d d
  end
  chk_rel get ten scale mul get p c_h fsqrt mul gb V 1.0e-12f64 202
  chk_rel get one scale mul get p c fsqrt mul 9.0f64 v4_rr 1.0e-12f64 203
  put s pv 5 1.0f64
  chk_st est4_predict view s 10 ten EST_OK 204
  chk_rel get ten scale mul get p c_h fsqrt mul 9.0f64 V 1.0e-12f64 205
end

fn test_ramp_const to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  ten = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  for f0 ulong 3
    mk_base add f0 1 p
    chk_st est4_init view p s EST_OK 307
    for t ulong 500
      chk_st est4_update s 1 4200.0f64 EST_OK 308
    end
    for h0 ulong 64
      chk_st est4_predict view s add h0 1 ten EST_OK 309
      chk_near get ten loc 4200.0f64 1.0e-6f64 310
    end
  end
end

fn test_ramp_check_h10 s view Est4State r f64 to void
  sm = f64 0.0
  for k0 ulong 10
    sm = add sm est_powu r add k0 1
  end
  one = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  chk_st est4_predict s 10 one EST_OK 305
  chk_rel get one loc add get s x 0 mul get s x 1 sm 1.0e-12f64 306
end

fn test_ramp_check s view Est4State r f64 q f64 slope f64 to void
  p11r2 = add mul mul r r get s P 3 q
  m00 = add add get s P 0 mul mul 2.0f64 r get s P 1 p11r2
  m01 = add mul r get s P 1 p11r2
  S = add m00 v4_rr
  m00 = div m00 S
  m01 = div m01 S
  S = add mul r m01 mul sub 1.0f64 r m00
  p11r2 = div mul sub 1.0f64 r slope S
  m01 = div sub slope mul m00 p11r2 r
  one = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  chk_st est4_predict s 1 one EST_OK 302
  chk_rel sub mul slope 3000.0f64 get one loc p11r2 1.0e-6f64 303
  chk_rel get s x 1 m01 1.0e-6f64 304
  test_ramp_check_h10 s r
end

fn test_ramp to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G2_AR p
  put p dyn 0.9f64
  chk_st est4_init view p s EST_OK 300
  for t ulong 3000
    chk_st est4_update s 1 mul 100.0f64 f64 t EST_OK 301
  end
  test_ramp_check view s get p dyn get p q 100.0f64
  test_ramp_const
end

fn test_missing_gap to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  bef = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  aft = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  dp = new EstDPred uchar 0 ulong 0 ulong 0 ulong 0 f64 0.0 f64 0.0
  pmf = new f64 801 0.0
  for f0 ulong 3
    mk_base add f0 1 p
    chk_st est4_init view p s EST_OK 420
    for t ulong 40
      chk_st est4_update s 1 add 2000.0f64 mul 100.0f64 f64 t EST_OK 421
    end
    chk_st est4_predict view s 6 bef EST_OK 422
    g0 = get s g
    gen = get s generation
    for k ulong 5
      chk_st est4_update s and k 1 est_nan EST_OK 423
    end
    chk eq get s gap 5 424
    chk eq get s generation add gen 5 424
    chk eq get s g g0 424
    chk eq get s anchor 5900.0f64 424
    chk_st est4_predict view s 1 aft EST_OK 425
    chk_rel get aft loc get bef loc 1.0e-12f64 426
    chk_st est4_dpred view s view aft dp pmf EST_OK 427
    chk eq get dp horizon 6 428
    chk_st est4_predict view s 59 aft EST_OK 429
    chk_st est4_dpred view s view aft dp pmf EST_OK 430
    chk_st est4_predict view s 60 aft EST_OK 431
    chk_st est4_dpred view s view aft dp pmf EST_ERR_TIME 432
  end
end

fn test_scale_and_missing to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  pr = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  mk_base EST4_G1_LAG p
  chk_st est4_init view p s EST_OK 400
  chk_st est4_predict view s 1 pr EST_ERR_STALE 401
  chk_st est4_update s 1 3000.0f64 EST_OK 402
  chk eq get s has_anchor 1 403
  chk eq get s anchor 3000.0f64 403
  chk eq get s gap 0 403
  for t ulong 50
    chk_st est4_update s 1 add 3000.0f64 mul 100.0f64 f64 rem t 3 EST_OK 404
  end
  g0 = get s g
  gl0 = get s gl
  chk_st est4_predict view s 1 pr EST_OK 405
  sc = div get pr scale get p c
  V1 = div mul sc sc g0
  chk_st est4_update s 1 add get pr loc 900.0f64 EST_OK 406
  gn = add mul get p lam g0 mul sub 1.0f64 get p lam div 810000.0f64 V1
  chk_rel get s g gn 1.0e-12f64 407
  gl0 = add mul EST4_GL_LAMBDA gl0 mul sub 1.0f64 EST4_GL_LAMBDA gn
  chk_rel get s gl gl0 1.0e-12f64 408
  g0 = get s g
  chk_st est4_predict view s 1 pr EST_OK 409
  sc = div get pr scale get p c
  V1 = div mul sc sc g0
  chk_st est4_update s 1 get pr loc EST_OK 410
  gn = mul get p lam g0
  gn = add gn mul sub 1.0f64 get p lam div v4_rr V1
  chk_rel get s g gn 1.0e-12f64 411
  chk_st est4_predict view s 0 pr EST_ERR_TIME 412
  chk_st est4_predict view s 65 pr EST_ERR_TIME 413
  test_missing_gap
end

fn chk_fast_one s view Est4State pr view Est4Pred dp view EstDPred pmf view f64 801 kk long to void
  yv = add get s anchor mul f64 kk V4_QU
  flh = new f64 2 0.0
  lf = est4_fast_logp pr V4_QU get s anchor yv flh
  ob = new EstPObs f64 0.0 ulong 0 uchar 0
  iv = new EstPInnov ulong 0 ulong 0 long 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  put ob val yv
  put ob cls EST_OBS_OK
  put ob evidence 0 uchar 1
  chk_st est_dpred_score dp pmf view ob iv EST_OK 505
  ep1 = est_exp get iv logp
  ep2 = est_exp lf
  chk_near ep1 ep2 add 1.0e-15f64 mul 1.0e-11f64 ep2 506
  chk_near get iv logp lf 1.0e-6f64 507
  chk_near get iv F_lo get flh 0 1.0e-9f64 508
  chk_near get iv F_hi get flh 1 1.0e-9f64 509
end

fn test_pmf_fast_h s view Est4State h ulong far view long 10 to void
  pr = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  dp = new EstDPred uchar 0 ulong 0 ulong 0 ulong 0 f64 0.0 f64 0.0
  pmf = new f64 801 0.0
  chk_st est4_predict s h pr EST_OK 502
  chk_st est4_dpred s view pr dp pmf EST_OK 503
  sum = f64 0.0
  for i ulong EST_PRED_N
    sum = add sum get pmf i
    chk gt get pmf i 0.0f64 504
  end
  chk_near sum 1.0f64 1.0e-12f64 504
  for ki ulong 131
    kk = sub long ki 60
    if ge ki 121
      kk = get far sub ki 121
    end
    chk_fast_one s view pr view dp view pmf kk
  end
end

fn test_pmf_sym to void
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  mk_base EST4_G1_LAG p
  x = new f64 3 1000.0
  set_state s view p view x 1.0f64
  pr = new Est4Pred ulong 0 f64 0.0 f64 0.0 f64 0.0
  dp = new EstDPred uchar 0 ulong 0 ulong 0 ulong 0 f64 0.0 f64 0.0
  pmf = new f64 801 0.0
  chk_st est4_predict view s 10 pr EST_OK 510
  chk_st est4_dpred view s view pr dp pmf EST_OK 511
  asym = f64 0.0
  for i ulong EST_PRED_N
    asym = fmax asym fabs sub get pmf i get pmf sub 800 i
  end
  chk lt asym 1.0e-15f64 512
  chk eq get dp family 0 513
  chk eq get dp horizon 10 513
  chk eq get dp anchor 1000.0f64 513
  chk eq get dp quantum V4_QU 513
end

fn test_pmf_vs_fast to void
  st = ulong 0x5eed1234
  p = new Est4Params ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 f64 0.0
  s = new Est4State ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0 f64 0.0 ulong 0 f64 0.0 f64 0.0 f64 0.0 f64 0.0 ulong 0
  nus = new f64 4 0.0
  put nus 0 0.6f64
  put nus 1 1.0f64
  put nus 2 1.5f64
  put nus 3 5.0f64
  far = new long 10 0
  put far 0 -1000
  put far 1 -450
  put far 2 -401
  put far 3 -400
  put far 4 -399
  put far 5 399
  put far 6 400
  put far 7 401
  put far 8 450
  put far 9 1000
  for f0 ulong 3
    mk_base add f0 1 p
    for k ulong 4
      put p nu get nus k
      put p nu_h get nus sub 3 k
      chk_st est4_init view p s EST_OK 500
      for t ulong 120
        st = add mul st 6364136223846793005 1442695040888963407
        v = add 3000.0f64 mul 100.0f64 f64 rem shr st 33 7
        if gt t 60
          v = add v 2000.0f64
        end
        chk_st est4_update s 1 v EST_OK 501
      end
      test_pmf_fast_h view s 1 view far
      test_pmf_fast_h view s 10 view far
    end
  end
  test_pmf_sym
end

fn main to int
  test_params
  test_digest
  test_g1_analytic
  test_g2_analytic
  test_g3_analytic
  test_scale_reversion
  test_ramp
  test_scale_and_missing
  test_pmf_vs_fast
  est_puts V4_PREFIX
  est_putu get g_checks 0
  est_puts V4_CHECKS
  est_putu get g_fail 0
  est_puts V4_FAILED
  if gt get g_fail 0 0
    est_puts V4_FAIL
    ret 1
  end
  est_puts V4_PASS
  ret 0
end

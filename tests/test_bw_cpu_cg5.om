note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_blackwell_codegen_qmma.om
note   src/omega_blackwell_codegen_router.om
note   src/omega_blackwell_codegen_tc.om
note   src/omega_blackwell_codegen_tc2.om
note   src/omega_blackwell_codegen_tern.om
note   src/omega_blackwell_codegen_tgemm.om
om2

global g_cg5_out uchar 4096
global g_cg5_out_n ulong 1

text t_cg5_pass "PASS test-bw-cpu-cg5-om\n"

fn cg5_flush to void
  n = get g_cg5_out_n 0
  if gt n 0
    ign = write 1 g_cg5_out 0 n
    put g_cg5_out_n 0 0
  end
end

fn cg5_ch c uchar to void
  n = get g_cg5_out_n 0
  if ge n 4000
    cg5_flush
    n = 0
  end
  put g_cg5_out n c
  put g_cg5_out_n 0 add n 1
end

fn cg5_hexd nib uint to uchar
  if lt nib 10
    ret uchar add 48 nib
  end
  ret uchar add 87 nib
end

fn cg5_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    nib = and shr v sh 15
    cg5_ch cg5_hexd nib
  end
end

fn cg5_hex64 v ulong to void
  cg5_hex32 uint shr v 32
  cg5_hex32 uint and v 0xffffffff
end

fn cg5_nl to void
  cg5_ch 10
  cg5_flush
end

fn cg5_fnv64_u64s arr view ulong * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n bound 8192
    v = get arr i
    for b ulong 8
      by = and shr v mul b 8 255
      h = mul xor h by ulong 0x100000001b3
    end
  end
  ret h
end

fn cg5_fnv64_u16s arr view ushort * n ulong to ulong
  h = ulong 0xcbf29ce484222325
  for i ulong n bound 1024
    v = ulong get arr i
    h = mul xor h and v 255 ulong 0x100000001b3
    h = mul xor h and shr v 8 255 ulong 0x100000001b3
  end
  ret h
end

fn cg5_emit_line tag uint a uint b uint c uint d uint h ulong to void
  cg5_ch uchar shr tag 8
  cg5_ch uchar and tag 255
  cg5_ch 58
  cg5_hex32 a
  cg5_ch 58
  cg5_hex32 b
  cg5_ch 58
  cg5_hex32 c
  cg5_ch 58
  cg5_hex32 d
  cg5_ch 58
  cg5_hex64 h
  cg5_nl
end

fn test_qmma to long
  ins = new ulong 8192 0
  meta = new ulong 512 0

  if ne omega_qmma_is_mark 16 OMEGA_QMMA_MARK 1
    ret 10
  end
  if ne omega_qmma_is_mark 16 0 0
    ret 11
  end
  if ne omega_qmma_is_mark 37 OMEGA_QMMA_MARK 0
    ret 12
  end
  if ne omega_qmma_patch_selftest 0
    ret 13
  end

  note Invalid probe args
  if ne omega_blackwell_codegen_qmma_probe_prog 2 0 ins meta -1
    ret 14
  end
  if ne omega_blackwell_codegen_qmma_probe_prog 0 17 ins meta -1
    ret 15
  end

  note Valid QMMA probe (mutant=0, wait_nops=1)
  if ne omega_blackwell_codegen_qmma_probe_prog 0 1 ins meta 0
    ret 16
  end
  cg5_emit_line 0x5130 0 1 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Valid QMMA probe (mutant=1, wait_nops=2)
  if ne omega_blackwell_codegen_qmma_probe_prog 1 2 ins meta 0
    ret 17
  end
  cg5_emit_line 0x5131 1 2 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Invalid peak args
  if ne omega_blackwell_codegen_qmma_peak_prog 0 1 1 32 ins meta -1
    ret 18
  end
  if ne omega_blackwell_codegen_qmma_peak_prog 16 0 1 32 ins meta -1
    ret 19
  end
  if ne omega_blackwell_codegen_qmma_peak_prog 16 4 8 33 ins meta -1
    ret 20
  end

  note Valid QMMA peak (iters=16, chains=4, stall=8, threads=128)
  if ne omega_blackwell_codegen_qmma_peak_prog 16 4 8 128 ins meta 0
    ret 21
  end
  cg5_emit_line 0x5132 16 4 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Valid F2E4 probe
  if ne omega_blackwell_codegen_f2e4_probe_prog ins meta 0
    ret 22
  end
  cg5_emit_line 0x5133 0 0 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_router to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  sm = new uint 6 0
  stats = new uint 2 0

  note Invalid smem specs
  put sp 3 64
  if ne omega_router_smem sp sm -1
    ret 30
  end
  put sp 3 128
  put sp 4 2
  if ne omega_router_smem sp sm -1
    ret 31
  end

  note Default 128 experts, shared=0
  put sp 0 8
  put sp 1 2
  put sp 2 0
  put sp 3 128
  put sp 4 0
  put sp 5 0
  put sp 6 0
  if ne omega_router_smem sp sm 0
    ret 32
  end
  if or ne get sm 0 8192 ne get sm 5 8912
    ret 33
  end
  if ne omega_blackwell_codegen_router_prog sp ins meta 0
    ret 34
  end
  if ne omega_router_prog_stats sp stats 0
    ret 35
  end
  cg5_emit_line 0x5230 get sm 1 get sm 5 get stats 0 get stats 1 cg5_fnv64_u64s ins mul get meta 0 8

  note 256 experts, shared=1, ROWS form (warps=16, depth=4, xstride=8192, lbstride=8192)
  put sp 0 16
  put sp 1 4
  put sp 3 256
  put sp 4 1
  put sp 5 8192
  put sp 6 8192
  if ne omega_router_smem sp sm 0
    ret 36
  end
  if ne omega_blackwell_codegen_router_prog sp ins meta 0
    ret 37
  end
  if ne omega_router_prog_stats sp stats 0
    ret 38
  end
  cg5_emit_line 0x5231 get sm 1 get sm 5 get stats 0 get stats 1 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_tc to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0

  note Probe (mutant=0 and mutant=1)
  if ne omega_blackwell_codegen_tc_probe_prog 0 ins meta 0
    ret 40
  end
  cg5_emit_line 0x5430 0 0 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  if ne omega_blackwell_codegen_tc_probe_prog 1 ins meta 0
    ret 41
  end
  cg5_emit_line 0x5431 1 0 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Invalid tcgemm spec
  if ne omega_tcgemm_spec_ok sp 0
    ret 42
  end
  if ne omega_tcgemm_shared_bytes sp 0
    ret 43
  end
  if ne omega_tcgemm_span sp 0
    ret 44
  end
  if ne omega_blackwell_codegen_tcgemm_prog sp ins meta -1
    ret 45
  end

  note Valid tcgemm spec: k=2048, rt=2, ct=2, warps=4, mutant=0
  put sp 0 2048
  put sp 1 2
  put sp 2 2
  put sp 3 4
  put sp 4 0
  if ne omega_tcgemm_spec_ok sp 1
    ret 46
  end
  sb = omega_tcgemm_shared_bytes sp
  span = omega_tcgemm_span sp
  if or ne sb 8192 ne span 64
    ret 47
  end
  if ne omega_blackwell_codegen_tcgemm_prog sp ins meta 0
    ret 48
  end
  cg5_emit_line 0x5432 sb span uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note permute_x and w_bf16
  xf = new f32 8 0.0
  put xf 0 bitcast f32 uint 0x3f800000
  put xf 1 bitcast f32 uint 0x40000000
  put xf 2 bitcast f32 uint 0xbf000000
  put xf 3 bitcast f32 uint 0x40490fdb
  put xf 4 bitcast f32 uint 0x00000000
  put xf 5 bitcast f32 uint 0x80000000
  put xf 6 bitcast f32 uint 0x7fc00000
  put xf 7 bitcast f32 uint 0x3eaaaaab
  xb = new ushort 8 0
  omega_tcgemm_permute_x xf 8 xb
  w0 = uint omega_tcgemm_w_bf16 0x38
  w1 = uint omega_tcgemm_w_bf16 0xb8
  if or ne w0 0x0380 ne w1 0x8380
    ret 49
  end
  cg5_emit_line 0x5433 w0 w1 uint get xb 0 uint get xb 1 cg5_fnv64_u16s xb 8

  note tc_peak (iters=16, chains=4, stall=8, threads=128)
  if ne omega_blackwell_codegen_tc_peak_prog 16 4 8 128 ins meta 0
    ret 50
  end
  cg5_emit_line 0x5434 16 4 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note tc_bw (iters=8, groups=1, threads=128)
  if ne omega_blackwell_codegen_tc_bw_prog 8 1 128 ins meta 0
    ret 51
  end
  cg5_emit_line 0x5435 8 1 uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_tc2 to long
  sp = new ulong 10 0
  ins = new ulong 8192 0
  meta = new ulong 512 0

  note Invalid spec
  if ne omega_tc2_spec_ok sp 0
    ret 60
  end
  if ne omega_tc2_shared_bytes sp 0
    ret 61
  end
  if ne omega_tc2_span sp 0
    ret 62
  end
  if ne omega_blackwell_codegen_tc2_prog sp ins meta -1
    ret 63
  end

  note Valid F32 spec: k=2048, rt=4, ct=2, warps=8, aqn=1, epi=0, direct=0, n=768, mutant=0
  put sp 0 2048
  put sp 1 4
  put sp 2 2
  put sp 3 8
  put sp 4 1
  put sp 5 0
  put sp 6 0
  put sp 7 768
  put sp 8 0
  if ne omega_tc2_spec_ok sp 1
    ret 64
  end
  sb = omega_tc2_shared_bytes sp
  span = omega_tc2_span sp
  if or ne sb 16384 ne span 128
    ret 65
  end
  if ne omega_blackwell_codegen_tc2_prog sp ins meta 0
    ret 66
  end
  cg5_emit_line 0x3230 sb span uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Valid SWIGLU direct spec: k=2048, rt=2, ct=2, warps=8, aqn=2, epi=1, direct=1, n=1536, mutant=0
  put sp 1 2
  put sp 4 2
  put sp 5 1
  put sp 6 1
  put sp 7 1536
  if ne omega_tc2_spec_ok sp 1
    ret 67
  end
  sb = omega_tc2_shared_bytes sp
  span = omega_tc2_span sp
  if ne omega_blackwell_codegen_tc2_prog sp ins meta 0
    ret 68
  end
  cg5_emit_line 0x3231 sb span uint get meta 0 uint get meta 1 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_tern to long
  sp = new ulong 8 0
  ins = new ulong 8192 0
  meta = new ulong 512 0
  stats = new uint 2 0

  note Invalid spec
  if ne omega_tern_gemv_chunks sp 0
    ret 70
  end
  if ne omega_tern_gemv_spec_ok sp 0
    ret 71
  end
  if ne omega_tern_gemv_steps sp 0
    ret 72
  end
  if ne omega_tern_gemv_shared_bytes sp 0
    ret 73
  end
  if ne omega_blackwell_codegen_tern_gemv_prog sp ins meta -1
    ret 74
  end

  note Word offset checks (rowmajor and block)
  wo0 = omega_tern_word_offset 0 2 2048 7 13
  wo1 = omega_tern_word_offset 1 2 2048 7 13
  if or ne wo0 3636 ne wo1 2268
    ret 75
  end

  note Valid row-major coalesced I32 spec: k=2048, layout=0, rows=1, warps=8, depth=2, epi=0, mutant=0
  put sp 0 2048
  put sp 1 0
  put sp 2 1
  put sp 3 8
  put sp 4 2
  put sp 5 0
  put sp 6 0
  if ne omega_tern_gemv_spec_ok sp 1
    ret 76
  end
  if ne omega_tern_gemv_chunks sp 1
    ret 77
  end
  if ne omega_tern_gemv_coalesced_out sp 1
    ret 78
  end
  st = omega_tern_gemv_steps sp
  sb = omega_tern_gemv_shared_bytes sp
  if or ne st 8 ne sb 4224
    ret 79
  end
  if ne omega_blackwell_codegen_tern_gemv_prog sp ins meta 0
    ret 80
  end
  if ne omega_tern_gemv_prog_stats sp stats 0
    ret 81
  end
  cg5_emit_line 0x4b30 st sb get stats 0 get stats 1 cg5_fnv64_u64s ins mul get meta 0 8

  note Valid block F32 spec: k=2048, layout=1, rows=2, warps=8, depth=2, epi=1, mutant=0
  put sp 1 1
  put sp 2 2
  put sp 5 1
  if ne omega_tern_gemv_spec_ok sp 1
    ret 82
  end
  st = omega_tern_gemv_steps sp
  sb = omega_tern_gemv_shared_bytes sp
  if ne omega_blackwell_codegen_tern_gemv_prog sp ins meta 0
    ret 83
  end
  if ne omega_tern_gemv_prog_stats sp stats 0
    ret 84
  end
  cg5_emit_line 0x4b31 st sb get stats 0 get stats 1 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn test_tgemm to long
  sp = new ulong 10 0
  ins = new ulong 8192 0
  meta = new ulong 512 0

  note Invalid spec
  if ne omega_tgemm_spec_ok sp 0
    ret 90
  end
  if ne omega_tgemm_shared_bytes sp 0
    ret 91
  end
  if ne omega_tgemm_span sp 0
    ret 92
  end
  if ne omega_tgemm_bm sp 0
    ret 93
  end
  if ne omega_blackwell_codegen_tgemm_prog sp ins meta -1
    ret 94
  end

  note Valid spec: k=1024, n=768, rt=4, ct=2, warps=8, kc=32, aqn=1, layout=0, epi=0, mutant=0
  put sp 0 1024
  put sp 1 768
  put sp 2 4
  put sp 3 2
  put sp 4 8
  put sp 5 32
  put sp 6 1
  put sp 7 0
  put sp 8 0
  put sp 9 0
  if ne omega_tgemm_spec_ok sp 1
    ret 95
  end
  sb = omega_tgemm_shared_bytes sp
  span = omega_tgemm_span sp
  bm = omega_tgemm_bm sp
  if or ne sb 8192 or ne span 128 ne bm 64
    ret 96
  end
  if ne omega_blackwell_codegen_tgemm_prog sp ins meta 0
    ret 97
  end
  cg5_emit_line 0x4530 sb span bm uint get meta 0 cg5_fnv64_u64s ins mul get meta 0 8

  note Valid spec with aqn=2, rt=4, warps=16, n=1024
  put sp 1 1024
  put sp 2 4
  put sp 4 16
  put sp 6 2
  if ne omega_tgemm_spec_ok sp 1
    ret 98
  end
  sb = omega_tgemm_shared_bytes sp
  span = omega_tgemm_span sp
  bm = omega_tgemm_bm sp
  if ne omega_blackwell_codegen_tgemm_prog sp ins meta 0
    ret 99
  end
  cg5_emit_line 0x4531 sb span bm uint get meta 0 cg5_fnv64_u64s ins mul get meta 0 8
  ret 0
end

fn main to int
  rc = test_qmma
  if ne rc 0
    ret int rc
  end
  rc = test_router
  if ne rc 0
    ret int rc
  end
  rc = test_tc
  if ne rc 0
    ret int rc
  end
  rc = test_tc2
  if ne rc 0
    ret int rc
  end
  rc = test_tern
  if ne rc 0
    ret int rc
  end
  rc = test_tgemm
  if ne rc 0
    ret int rc
  end
  ign = write 1 t_cg5_pass 0 len t_cg5_pass
  ret 0
end

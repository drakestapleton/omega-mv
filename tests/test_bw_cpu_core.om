note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 unit and C-parity test for:
note   src/omega_blackwell_encoder.om
note   src/omega_blackwell_qmd.om
note   src/omega_blackwell_realize.om
om2

global g_out uchar 256
global g_out_n ulong 1

fn out_flush to void
  n = get g_out_n 0
  if gt n 0
    ign = write 1 g_out 0 n
    put g_out_n 0 0
  end
end

fn out_ch c uchar to void
  n = get g_out_n 0
  if ge n 250
    out_flush
    n = 0
  end
  put g_out n c
  put g_out_n 0 add n 1
end

fn out_nl to void
  out_ch 10
  out_flush
end

fn out_hex32 v uint to void
  for i ulong 8
    sh = uint mul sub 7 i 4
    nib = and shr v sh 15
    out_ch sh_hexd nib
  end
end

fn out_hex_bytes buf view uchar * n ulong to void
  for i ulong n bound 512
    b = uint get buf i
    out_ch sh_hexd shr b 4
    out_ch sh_hexd and b 15
  end
end

fn hash_u32s words view uint * n ulong dig edit uchar 32 to void
  for i ulong n bound 256
    w = get words i
    o = mul i 4
    put sh_dat o uchar and w 255
    put sh_dat add o 1 uchar and shr w 8 255
    put sh_dat add o 2 uchar and shr w 16 255
    put sh_dat add o 3 uchar and shr w 24 255
  end
  sh_all mul n 4
  for i ulong 32
    put dig i get sh_dig i
  end
end

fn test_encoder dump ulong to long
  short_buf = new uchar 64 0
  if ne omega_blackwell_encode_vecadd short_buf -1
    ret 1
  end
  code = new uchar 512 0
  if ne omega_blackwell_encode_vecadd code 512
    ret 2
  end
  dig = new uchar 32 0
  if ne omega_blackwell_compute_code_digest code 0 dig -1
    ret 3
  end
  if ne omega_blackwell_compute_code_digest code 512 dig 0
    ret 4
  end
  if ne omega_blackwell_verify_encoder_fixtures 0
    ret 5
  end
  if ne dump 0
    out_ch 69
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end
  ret 0
end

fn test_qmd_core dump ulong to long
  q0 = new uint 96 0
  if ne omega_blackwell_build_qmd0 q0 0x300010000 0x300010200 0
    ret 10
  end
  if ne get q0 4 uint 0x00800002
    ret 11
  end
  if ne get q0 12 uint 0x03000102
    ret 12
  end
  dig = new uchar 32 0
  hash_u32s q0 96 dig
  if ne dump 0
    out_ch 81
    out_ch 48
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  cfg = new ulong 16 0
  put cfg 0 0x320000000
  put cfg 1 0x324280000
  put cfg 2 0x322000000
  put cfg 3 0x324010000
  put cfg 4 0x300010000
  put cfg 5 1024
  put cfg 6 64
  put cfg 7 16
  put cfg 12 32
  put cfg 13 1024
  q1 = new uint 96 0
  if ne omega_blackwell_build_qmd1 q1 cfg 0
    ret 13
  end
  if ne omega_blackwell_verify_qmd_invariants q1 0
    ret 14
  end
  hash_u32s q1 96 dig
  if ne dump 0
    out_ch 81
    out_ch 49
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  put cfg 8 16
  put cfg 9 16
  put cfg 10 4
  put cfg 11 8
  put cfg 12 48
  put cfg 13 65536
  if ne omega_blackwell_build_qmd1 q1 cfg 0
    ret 15
  end
  if ne omega_blackwell_verify_qmd_invariants q1 0
    ret 16
  end
  hash_u32s q1 96 dig
  if ne dump 0
    out_ch 81
    out_ch 50
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  put cfg 13 98305
  if ne omega_blackwell_build_qmd1 q1 cfg -1
    ret 17
  end

  put q1 37 1
  if ne omega_blackwell_verify_qmd_invariants q1 -1
    ret 18
  end
  ret 0
end

fn test_qmd_cbank dump ulong to long
  cb = new uint 224 0
  if ne omega_blackwell_build_cbank_driver cb 0x324280000 0
    ret 20
  end
  dig = new uchar 32 0
  hash_u32s cb 224 dig
  if ne dump 0
    out_ch 67
    out_ch 49
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  if ne omega_blackwell_build_cbank_driver_2d cb 0x324280000 16 16 4 8 0
    ret 21
  end
  if ne get cb 216 16
    ret 22
  end
  if ne get cb 221 8
    ret 23
  end
  hash_u32s cb 224 dig
  if ne dump 0
    out_ch 67
    out_ch 50
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  a1 = new uint 7 0
  if ne omega_blackwell_build_cbank_args a1 0x1122334455667788 0x2233445566778899 0x33445566778899aa 4096 0
    ret 24
  end
  hash_u32s a1 7 dig
  if ne dump 0
    out_ch 65
    out_ch 49
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end

  a2 = new uint 10 0
  mvas = new ulong 3 0
  put mvas 0 0x100000002000
  put mvas 1 0x300000004000
  put mvas 2 0x500000006000
  mdims = new uint 3 0
  put mdims 0 128
  put mdims 1 256
  put mdims 2 512
  if ne omega_blackwell_build_cbank_args_matmul a2 mvas mdims 0
    ret 25
  end
  hash_u32s a2 10 dig
  if ne dump 0
    out_ch 65
    out_ch 50
    out_ch 58
    out_hex_bytes dig 32
    out_nl
  end
  ret 0
end

fn test_realize dump ulong to long
  mid = new uchar 32 0
  if ne omega_blackwell_get_machine_id mid 0
    ret 30
  end
  spec = new uchar 32 0
  for i ulong 32
    put spec i uchar add i 1
  end
  rid = new uchar 32 0
  cdig = new uchar 32 0
  geom = new uint 4 0
  if ne omega_blackwell_realize_vector spec 1024 rid mid cdig geom 0
    ret 31
  end
  if ne get geom 0 121
    ret 32
  end
  if ne get geom 1 1024
    ret 33
  end
  if ne get geom 2 64
    ret 34
  end
  if ne get geom 3 16
    ret 35
  end
  if ne dump 0
    out_ch 82
    out_ch 77
    out_ch 58
    out_hex_bytes mid 32
    out_nl
    out_ch 82
    out_ch 73
    out_ch 58
    out_hex_bytes rid 32
    out_nl
  end
  if ne omega_blackwell_realize_vector spec 0 rid mid cdig geom 0
    ret 36
  end
  if ne get geom 3 1
    ret 37
  end
  if ne dump 0
    out_ch 82
    out_ch 48
    out_ch 58
    out_hex32 get geom 3
    out_nl
  end
  ret 0
end

fn main to int
  dump = ulong 1
  rc = test_encoder dump
  if ne rc 0
    ret int rc
  end
  rc = test_qmd_core dump
  if ne rc 0
    ret int rc
  end
  rc = test_qmd_cbank dump
  if ne rc 0
    ret int rc
  end
  rc = test_realize dump
  if ne rc 0
    ret int rc
  end
  ret 0
end

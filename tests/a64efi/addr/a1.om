fn sum v view uchar 9 to ulong
x = ulong 0
i = ulong 0
while lt i 9
x = add x ulong get v i
i = add i 1
end
ret x
end

fn show v view uchar 9 to void
i = ulong 0
while lt i 9
put ms i get v i
i = add i 1
end
say 9
end

fn main to ulong
mark 66
i = ulong 0
while lt i len tb
put ms i get tb i
i = add i 1
end
say len tb
show ta
hx sum ta
i = ulong 0
while lt i 16
put gb i uchar add 200 i
i = add i 1
end
hx add ulong get gb 0 shl ulong get gb 15 8
mark 69
ret 0
end

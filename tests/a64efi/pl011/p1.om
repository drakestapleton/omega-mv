note pl011 p1: efi 20 / 21 against the QEMU virt machine (emulated devices, not hardware).
note WolframLanguageEvaluator: {16^^09000000, 16^^09000018, 16^^09000FE0, 16^^09010004, 16^^1010,
note 16^^1011, 16^^12345678} -> {150994944, 150994968, 150999008, 151060484, 4112, 4113, 305419896}.
note PL011 UART at 0x09000000: UARTDR +0, UARTFR +0x18 (bit 5 TXFF), PeriphID0..3 and PCellID0..3 at
note +0xFE0..+0xFFC. PL031 RTC match register at 0x09010004 (32 bits, read/write, its interrupt is
note masked). The code flash is mapped at physical 0; run.sh takes the 16 expected bytes at 0x1010
note from the firmware file itself.
global w uchar 16
global g uchar 16
text t1 "pl011 byte path\n"
text t2 "pl011 word path\n"

note lw / lg: the little-endian value of n bytes of w / g at o
fn lw o ulong n ulong to ulong
v = ulong 0
i = n
while gt i 0
i = sub i 1
v = or shl v 8 ulong get w add o i
end
ret v
end

fn lg o ulong n ulong to ulong
v = ulong 0
i = n
while gt i 0
i = sub i 1
v = or shl v 8 ulong get g add o i
end
ret v
end

note putc: wait while the transmit FIFO is full, then one byte access (k 1) or one 32-bit access (k 4)
fn putc c uchar k ulong to ulong
full = true
while full
r = efi 20 150994968 w 0 4
full = ne and ulong get w 0 32 0
end
put w 0 c
put w 1 0
put w 2 0
put w 3 0
ret efi 21 150994944 w 0 k
end

fn main to ulong
mark 66
r = ulong 0
i = ulong 0
while lt i len t1
r = putc get t1 i 1
i = add i 1
end
hx r
i = ulong 0
while lt i len t2
r = putc get t2 i 4
i = add i 1
end
hx r
hx efi 20 150994944 w 0 0
hx efi 21 150994944 w 0 0
note the eight identification registers, one 32-bit access each
i = ulong 0
while lt i 8
r = efi 20 add 150999008 mul i 4 w 0 4
hx lw 0 4
i = add i 1
end
note the 16 flash bytes at 0x1010 by every path: 16 bytes, 8 + 8, 4 x 4, 8 x 2, 16 x 1, then
note 4 bytes from the odd address 0x1011 and 3 bytes (both a byte at a time)
mark 71
r = efi 20 4112 g 0 16
hx lg 0 8
hx lg 8 8
r = efi 20 4112 g 0 8
r = efi 20 4120 g 8 8
hx lg 0 8
hx lg 8 8
i = ulong 0
while lt i 4
r = efi 20 add 4112 mul i 4 g mul i 4 4
i = add i 1
end
hx lg 0 8
hx lg 8 8
i = ulong 0
while lt i 8
r = efi 20 add 4112 mul i 2 g mul i 2 2
i = add i 1
end
hx lg 0 8
hx lg 8 8
i = ulong 0
while lt i 16
r = efi 20 add 4112 i g i 1
i = add i 1
end
hx lg 0 8
hx lg 8 8
r = efi 20 4113 g 0 4
hx lg 0 4
r = efi 20 4113 g 0 3
hx lg 0 3
note one 32-bit write to the RTC match register, read back
mark 77
put w 0 120
put w 1 86
put w 2 52
put w 3 18
hx efi 21 151060484 w 0 4
put w 0 0
put w 1 0
put w 2 0
put w 3 0
hx efi 20 151060484 w 0 4
hx lw 0 4
mark 69
ret 0
end

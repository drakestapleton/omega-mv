note tests/a64efi shared helpers (appended after each test's `target a64efi` line by run.sh).
note ms is the print buffer; say N writes ms[0..N) to the console; mark C prints "==C"; hx V prints V
note as 16 hex digits and a newline.
global ms uchar 64

fn say n ulong to void
r = efi 13 0 ms 0 n
end

fn mark c ulong to void
put ms 0 61
put ms 1 61
put ms 2 uchar c
put ms 3 10
say 4
end

fn hx v ulong to void
i = ulong 0
while lt i 16
d = and shr v mul sub 15 i 4 15
if lt d 10
put ms i uchar add 48 d
else
put ms i uchar add 87 d
end
i = add i 1
end
put ms 16 10
say 17
end

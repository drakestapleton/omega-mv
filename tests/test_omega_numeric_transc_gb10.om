note SPDX-License-Identifier: Apache-2.0
note Pure seeded OM-2 host tier for E1 row 10: GB10 FP32 transcendentals
note (EXP2, LOG2, SIGMOID, TANH, SIN, COS, ERF, GELU, RSQRT, EXP, LOG),
note checking body build, FP form count, structural scoreboard/register check,
note recorded kernel SHA-256 digest, and bit-exact host_exec == omega_math_<op>
note across edge magnitudes, strided inputs, and deterministic PRNG samples.
om2

global g_tg_ops ulong 11
global g_tg_edges uint 52
global g_tg_pass ulong 1
global g_tg_fail ulong 1
global g_tg_rng ulong 1

text tg_pfx_pass "[PASS] TG_"
text tg_pfx_fail "[FAIL] TG_"
text tg_s_body "_BODY_BUILDS\n"
text tg_s_fp "_BODY_HAS_FP_FORMS\n"
text tg_s_k "_KERNEL_BUILDS\n"
text tg_s_st "_KERNEL_PASSES_STRUCTURAL_CHECK\n"
text tg_s_dg "_KERNEL_DIGEST_IS_RECORDED\n"
text tg_s_ed "_HOST_MODEL_EDGE_SET\n"
text tg_s_sr "_HOST_MODEL_STRIDE_131071\n"
text tg_s_rd "_HOST_MODEL_RANDOM_4096\n"
text tg_sum_a "SUMMARY passed="
text tg_sum_b " failed="
text tg_sum_c "\nTEST_OMEGA_NUMERIC_TRANSC_GB10_OM "
text tg_pass "PASS\n"
text tg_fail "FAIL\n"

fn tg_wr s view uchar * to void
  r = write 1 s 0 len s
end

fn tg_wr_u v ulong to void
  b = new uchar 24 0
  p = ulong 24
  n = v
  while true
    p = sub p 1
    put b p uchar add 48 rem n 10
    n = div n 10
    if eq n 0
      ign = write 1 b p sub 24 p
      ret
    end
  end
end

fn tg_wr_op op ulong to void
  nm = new uchar 16 0
  ln = omega_ds_op_name op nm
  if gt ln 0
    ign = write 1 nm 0 ln
  end
end

fn tg_chk ok bool op ulong suf view uchar * to void
  if ok
    put g_tg_pass 0 add get g_tg_pass 0 1
    tg_wr tg_pfx_pass
  else
    put g_tg_fail 0 add get g_tg_fail 0 1
    tg_wr tg_pfx_fail
  end
  tg_wr_op op
  tg_wr suf
end

fn tg_init_tables to void
  put g_tg_ops 0 OMEGA_DS_EXP2
  put g_tg_ops 1 OMEGA_DS_LOG2
  put g_tg_ops 2 OMEGA_DS_SIGMOID
  put g_tg_ops 3 OMEGA_DS_TANH
  put g_tg_ops 4 OMEGA_DS_SIN
  put g_tg_ops 5 OMEGA_DS_COS
  put g_tg_ops 6 OMEGA_DS_ERF
  put g_tg_ops 7 OMEGA_DS_GELU
  put g_tg_ops 8 OMEGA_DS_RSQRT
  put g_tg_ops 9 OMEGA_DS_EXP
  put g_tg_ops 10 OMEGA_DS_LOG

  put g_tg_edges 0 uint 0x00000000
  put g_tg_edges 1 uint 0x00000001
  put g_tg_edges 2 uint 0x00000002
  put g_tg_edges 3 uint 0x00400000
  put g_tg_edges 4 uint 0x007fffff
  put g_tg_edges 5 uint 0x00800000
  put g_tg_edges 6 uint 0x00800001
  put g_tg_edges 7 uint 0x33800000
  put g_tg_edges 8 uint 0x34000000
  put g_tg_edges 9 uint 0x3effffff
  put g_tg_edges 10 uint 0x3f000000
  put g_tg_edges 11 uint 0x3f3504f3
  put g_tg_edges 12 uint 0x3f3504f4
  put g_tg_edges 13 uint 0x3f7fffff
  put g_tg_edges 14 uint 0x3f800000
  put g_tg_edges 15 uint 0x3f800001
  put g_tg_edges 16 uint 0x3fb504f3
  put g_tg_edges 17 uint 0x3fb504f4
  put g_tg_edges 18 uint 0x40000000
  put g_tg_edges 19 uint 0x4a7fffff
  put g_tg_edges 20 uint 0x4a800000
  put g_tg_edges 21 uint 0x42fe0000
  put g_tg_edges 22 uint 0x42ffffff
  put g_tg_edges 23 uint 0x43000000
  put g_tg_edges 24 uint 0x43000001
  put g_tg_edges 25 uint 0x43160000
  put g_tg_edges 26 uint 0x4316ffff
  put g_tg_edges 27 uint 0x43170000
  put g_tg_edges 28 uint 0x43170001
  put g_tg_edges 29 uint 0x42fc0000
  put g_tg_edges 30 uint 0x42fd0000
  put g_tg_edges 31 uint 0x7f7fffff
  put g_tg_edges 32 uint 0x7f800000
  put g_tg_edges 33 uint 0x7f800001
  put g_tg_edges 34 uint 0x7fc00000
  put g_tg_edges 35 uint 0x7fffffff
  put g_tg_edges 36 uint 0x42cffffe
  put g_tg_edges 37 uint 0x42cfffff
  put g_tg_edges 38 uint 0x42d00000
  put g_tg_edges 39 uint 0x42d00001
  put g_tg_edges 40 uint 0x42b17217
  put g_tg_edges 41 uint 0x42b17218
  put g_tg_edges 42 uint 0x42b17219
  put g_tg_edges 43 uint 0x42aeac4f
  put g_tg_edges 44 uint 0x42aeac50
  put g_tg_edges 45 uint 0x42fc0001
  put g_tg_edges 46 uint 0x3fb504f2
  put g_tg_edges 47 uint 0x3fb504f5
  put g_tg_edges 48 uint 0x3f317217
  put g_tg_edges 49 uint 0x3f317218
  put g_tg_edges 50 uint 0x3e816600
  put g_tg_edges 51 uint 0x3fa09700

  put g_tg_pass 0 0
  put g_tg_fail 0 0
  put g_tg_rng 0 0x9e3779b97f4a7c15
end

fn tg_rnd to ulong
  s = get g_tg_rng 0
  s = xor s shl s 13
  s = xor s shr s 7
  s = xor s shl s 17
  put g_tg_rng 0 s
  ret s
end

fn tg_want_bits op ulong a uint to uint
  if eq op OMEGA_DS_EXP2
    ret omega_math_exp2 a
  end
  if eq op OMEGA_DS_LOG2
    ret omega_math_log2 a
  end
  if eq op OMEGA_DS_SIGMOID
    ret omega_math_sigmoid a
  end
  if eq op OMEGA_DS_TANH
    ret omega_math_tanh a
  end
  if eq op OMEGA_DS_SIN
    ret omega_math_sin a
  end
  if eq op OMEGA_DS_COS
    ret omega_math_cos a
  end
  if eq op OMEGA_DS_ERF
    ret omega_math_erf a
  end
  if eq op OMEGA_DS_GELU
    ret omega_math_gelu a
  end
  if eq op OMEGA_DS_RSQRT
    ret omega_math_rsqrt a
  end
  if eq op OMEGA_DS_EXP
    ret omega_math_exp a
  end
  if eq op OMEGA_DS_LOG
    ret omega_math_log a
  end
  ret uint 0xffffffff
end

fn tg_run_op op ulong to void
  nb = omega_ds_body op
  tg_chk gt nb 0 op tg_s_body

  fp = ulong 0
  for k ulong nb bound 1000
    knd = and get g_ds_body mul k 2 255
    if or eq knd DSK_FADD_R or eq knd DSK_FMUL_R eq knd DSK_FFMA_R
      fp = add fp 1
    end
  end
  tg_chk gt fp 0 op tg_s_fp

  clen = omega_ds_build_kernel op
  tg_chk gt clen 0 op tg_s_k
  tg_chk eq omega_ds_check_kernel op clen OMEGA_DS_GPR_COUNT OMEGA_NUMERIC_OK op tg_s_st
  tg_chk eq omega_ds_check_digest op clen OMEGA_NUMERIC_OK op tg_s_dg

  bad_edge = ulong 0
  for k ulong 104
    mag = get g_tg_edges div k 2
    x = mag
    if ne rem k 2 0
      x = or mag uint 0x80000000
    end
    if ne omega_ds_host_exec op x 0 tg_want_bits op x
      bad_edge = add bad_edge 1
    end
  end
  tg_chk eq bad_edge 0 op tg_s_ed

  bad_stride = ulong 0
  for s ulong 32768
    xs = uint mul s 131071
    if ne omega_ds_host_exec op xs 0 tg_want_bits op xs
      bad_stride = add bad_stride 1
    end
  end
  for mf ulong 2048
    xf = uint add uint 0x3e800000 mul uint mf uint 0x100
    if ne omega_ds_host_exec op xf 0 tg_want_bits op xf
      bad_stride = add bad_stride 1
    end
  end
  tg_chk eq bad_stride 0 op tg_s_sr

  bad_rnd = ulong 0
  for r ulong 4096
    xr = uint and tg_rnd 0xffffffff
    if ne omega_ds_host_exec op xr 0 tg_want_bits op xr
      bad_rnd = add bad_rnd 1
    end
  end
  tg_chk eq bad_rnd 0 op tg_s_rd
end

fn main to int
  tg_init_tables
  for i ulong 11
    tg_run_op get g_tg_ops i
  end
  tg_wr tg_sum_a
  tg_wr_u get g_tg_pass 0
  tg_wr tg_sum_b
  tg_wr_u get g_tg_fail 0
  tg_wr tg_sum_c
  if eq get g_tg_fail 0 0
    tg_wr tg_pass
    ret 0
  end
  tg_wr tg_fail
  ret 1
end
